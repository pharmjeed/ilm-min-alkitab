{"schema":1,"kind":"names-chunk","version":"names-b52c0b18ade7","names":[{"id":145,"name":"على كل شيء قدير","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: عَلَى كُلِّ شَيْءٍ قَدِيرٌ / قَدِيرًا — | المواضع: 35\nخصوصية: أكثرُ صيغةِ قدرةٍ تكرارًا في القرآن — تُختم بها آياتُ الملك، وبراهينُ البعث (إحياء الأرض)، ومواطنُ العفو في الضعف، ووعودُ ما لم يُتصور بعد. وبها افتُتحت سورة الملك وخُتمت آل عمران.\n\nالمعنى:\n- على كل شيء قدير: التامُّ القدرة على كل ممكن، لا يعجزه شيءٌ ولا يمتنع عليه مراد — قدرةٌ لا يحدّها موضوعٌ ولا زمن.","teaches":"الحقائق التي كشفتها المواضع الخمسة والثلاثون:\n1. البديل مضمون بالقدرة: و﴿نَأْتِ بِخَيْرٍ مِنْهَا أَوْ مِثْلِهَا﴾ (البقرة 106).\n2. العفو في زمن الضعف انتظارٌ لأمر قادر لا استسلام (البقرة 109).\n3. المصائب تُراجع في النفس أولًا: و﴿هُوَ مِنْ عِنْدِ أَنْفُسِكُمْ﴾ (آل عمران 165).\n4. إحياء الأرض برهانٌ متجدد على البعث (الحج 6، الروم 50، فصلت 39).\n5. لم يعيَ بخلق السماوات والأرض — فلا يعجزه إحياء الموتى (الأحقاف 33).\n6. الساعة و﴿كَلَمْحِ الْبَصَرِ أَوْ هُوَ أَقْرَبُ﴾ (النحل 77).\n7. ما عجزتَ عنه قد يكون محفوظًا لك: و﴿قَدْ أَحَاطَ اللَّهُ بِهَا﴾ (الفتح 21).\n8. القدرة على المغفرة تُقدَّم على القدرة على العذاب (البقرة 284).","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- عند انهيار خطةٍ أو ضياع فرصة: البديل مضمون.\n- عند العفو وأنت ضعيف.\n- بعد كل انتكاسة: ما جاء من عند أنفسنا؟\n- عند رؤية الأرض تحيا بعد موتها.\n- عند تقلب المناصب والدول.\n- عند خشية انطفاء نورك.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. و﴿رَبَّنَا أَتْمِمْ لَنَا نُورَنَا وَاغْفِرْ لَنَا إِنَّكَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — التحريم 8.\n2. دعاء مالك الملك: و﴿قُلِ اللَّهُمَّ مَالِكَ الْمُلْكِ... بِيَدِكَ الْخَيْرُ إِنَّكَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — آل عمران 26.\n3. عند الضر: و﴿فَلَا كَاشِفَ لَهُ إِلَّا هُوَ﴾ — الأنعام 17.\n4. المداومة على سورة الملك كل ليلة.\n5. سؤال إحياء القلب كما تُحيا الأرض — فصلت 39.","summary":"قدرةٌ لا يحدّها موضوع: البديلُ مضمون لما نُسخ، والفرجُ ممكنٌ حيث انتهت قدرتك، وإحياءُ الأرض كل عامٍ برهانٌ يتجدد — و﴿رَبَّنَا أَتْمِمْ لَنَا نُورَنَا... إِنَّكَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾.","verses":[{"i":1,"of":35,"s":2,"surah":"البقرة","a":20,"text":"يَكَادُ الْبَرْقُ يَخْطَفُ أَبْصَارَهُمْ كُلَّمَا أَضَاءَ لَهُمْ مَشَوْا فِيهِ وَإِذَا أَظْلَمَ عَلَيْهِمْ قَامُوا وَلَوْ شَاءَ اللَّهُ لَذَهَبَ بِسَمْعِهِمْ وَأَبْصَارِهِمْ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":19,"text":"أَوْ كَصَيِّبٍ مِنَ السَّمَاءِ فِيهِ ظُلُمَاتٌ وَرَعْدٌ وَبَرْقٌ يَجْعَلُونَ أَصَابِعَهُمْ فِي آذَانِهِمْ مِنَ الصَّوَاعِقِ حَذَرَ الْمَوْتِ وَاللَّهُ مُحِيطٌ بِالْكَافِرِينَ"},"next":{"a":21,"text":"يَا أَيُّهَا النَّاسُ اعْبُدُوا رَبَّكُمُ الَّذِي خَلَقَكُمْ وَالَّذِينَ مِنْ قَبْلِكُمْ لَعَلَّكُمْ تَتَّقُونَ"},"context":"في مثل المنافقين كأصحاب الصيّب: ﴿يَكَادُ الْبَرْقُ يَخْطَفُ أَبْصَارَهُمْ كُلَّمَا أَضَاءَ لَهُمْ مَشَوْا فِيهِ وَإِذَا أَظْلَمَ عَلَيْهِمْ قَامُوا وَلَوْ شَاءَ اللَّهُ لَذَهَبَ بِسَمْعِهِمْ وَأَبْصَارِهِمْ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾.","reason":"مشيَ الحرباءِ مع الضوء ووقوفُه في الظلمة صورةُ المتردد — ثم التنبيه: لو شاء لذهب بسمعهم وأبصارهم؛ فإبقاءُ حواسّهم مع تلاعبهم مهلةٌ من قادر، لا عجزًا عن أخذها.","adds":"حواسّك التي تعصي بها باقيةٌ بإذنه — ولو شاء لذهب بها: فاستعملها فيما يُبقيها."},{"i":2,"of":35,"s":2,"surah":"البقرة","a":106,"text":"مَا نَنْسَخْ مِنْ آيَةٍ أَوْ نُنْسِهَا نَأْتِ بِخَيْرٍ مِنْهَا أَوْ مِثْلِهَا أَلَمْ تَعْلَمْ أَنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":105,"text":"مَا يَوَدُّ الَّذِينَ كَفَرُوا مِنْ أَهْلِ الْكِتَابِ وَلَا الْمُشْرِكِينَ أَنْ يُنَزَّلَ عَلَيْكُمْ مِنْ خَيْرٍ مِنْ رَبِّكُمْ وَاللَّهُ يَخْتَصُّ بِرَحْمَتِهِ مَنْ يَشَاءُ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ"},"next":{"a":107,"text":"أَلَمْ تَعْلَمْ أَنَّ اللَّهَ لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا لَكُمْ مِنْ دُونِ اللَّهِ مِنْ وَلِيٍّ وَلَا نَصِيرٍ"},"reason":"النسخُ تصرّفٌ في التشريع لا تراجعٌ عنه — والقدرةُ ضمانةُ البديل: ﴿نَأْتِ بِخَيْرٍ مِنْهَا أَوْ مِثْلِهَا﴾؛ فمن يملك القدرة يملك التبديل بأفضل، ولا يُنسخ حكمٌ إلى أضعف.","adds":"قاعدةٌ تصلح لحياتك: ما نُسخ من خطتك يأتي بديلُه خيرًا أو مثلَه — عند قادرٍ على كل شيء."},{"i":3,"of":35,"s":2,"surah":"البقرة","a":109,"text":"وَدَّ كَثِيرٌ مِنْ أَهْلِ الْكِتَابِ لَوْ يَرُدُّونَكُمْ مِنْ بَعْدِ إِيمَانِكُمْ كُفَّارًا حَسَدًا مِنْ عِنْدِ أَنْفُسِهِمْ مِنْ بَعْدِ مَا تَبَيَّنَ لَهُمُ الْحَقُّ فَاعْفُوا وَاصْفَحُوا حَتَّى يَأْتِيَ اللَّهُ بِأَمْرِهِ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":108,"text":"أَمْ تُرِيدُونَ أَنْ تَسْأَلُوا رَسُولَكُمْ كَمَا سُئِلَ مُوسَى مِنْ قَبْلُ وَمَنْ يَتَبَدَّلِ الْكُفْرَ بِالْإِيمَانِ فَقَدْ ضَلَّ سَوَاءَ السَّبِيلِ"},"next":{"a":110,"text":"وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ وَمَا تُقَدِّمُوا لِأَنْفُسِكُمْ مِنْ خَيْرٍ تَجِدُوهُ عِنْدَ اللَّهِ إِنَّ اللَّهَ بِمَا تَعْمَلُونَ بَصِيرٌ"},"context":"﴿وَدَّ كَثِيرٌ مِنْ أَهْلِ الْكِتَابِ لَوْ يَرُدُّونَكُمْ مِنْ بَعْدِ إِيمَانِكُمْ كُفَّارًا حَسَدًا مِنْ عِنْدِ أَنْفُسِهِمْ... فَاعْفُوا وَاصْفَحُوا حَتَّى يَأْتِيَ اللَّهُ بِأَمْرِهِ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾.","reason":"أُمروا بالعفو والصفح في مرحلة الضعف — مع وعدٍ: ﴿حَتَّى يَأْتِيَ اللَّهُ بِأَمْرِهِ﴾؛ والقدرةُ ضمانةُ أن العفو ليس استسلامًا أبديًّا بل انتظارٌ لأمرٍ سيأتي من قادر.","adds":"العفو في زمن الضعف موقفُ قوةٍ لا عجز — لأن صاحبه ينتظر أمر قادرٍ على كل شيء."},{"i":4,"of":35,"s":2,"surah":"البقرة","a":148,"text":"وَلِكُلٍّ وِجْهَةٌ هُوَ مُوَلِّيهَا فَاسْتَبِقُوا الْخَيْرَاتِ أَيْنَ مَا تَكُونُوا يَأْتِ بِكُمُ اللَّهُ جَمِيعًا إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":147,"text":"الْحَقُّ مِنْ رَبِّكَ فَلَا تَكُونَنَّ مِنَ الْمُمْتَرِينَ"},"next":{"a":149,"text":"وَمِنْ حَيْثُ خَرَجْتَ فَوَلِّ وَجْهَكَ شَطْرَ الْمَسْجِدِ الْحَرَامِ وَإِنَّهُ لَلْحَقُّ مِنْ رَبِّكَ وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ"},"reason":"بعد جدل القبلة: لكلٍّ وجهة — والمهمُّ الاستباق إلى الخيرات؛ والقدرةُ ضمانةُ الجمع: ﴿أَيْنَ مَا تَكُونُوا يَأْتِ بِكُمُ اللَّهُ جَمِيعًا﴾ — فلا يفوته أحدٌ في أي مكان.","adds":"لا تُشغلك الخلافات الشكلية عن السباق: ﴿فَاسْتَبِقُوا الْخَيْرَاتِ﴾ — والجمعُ آتٍ."},{"i":5,"of":35,"s":2,"surah":"البقرة","a":259,"text":"أَوْ كَالَّذِي مَرَّ عَلَى قَرْيَةٍ وَهِيَ خَاوِيَةٌ عَلَى عُرُوشِهَا قَالَ أَنَّى يُحْيِي هَذِهِ اللَّهُ بَعْدَ مَوْتِهَا فَأَمَاتَهُ اللَّهُ مِائَةَ عَامٍ ثُمَّ بَعَثَهُ قَالَ كَمْ لَبِثْتَ قَالَ لَبِثْتُ يَوْمًا أَوْ بَعْضَ يَوْمٍ قَالَ بَلْ لَبِثْتَ مِائَةَ عَامٍ فَانْظُرْ إِلَى طَعَامِكَ وَشَرَابِكَ لَمْ يَتَسَنَّهْ وَانْظُرْ إِلَى حِمَارِكَ وَلِنَجْعَلَكَ آيَةً لِلنَّاسِ وَانْظُرْ إِلَى الْعِظَامِ كَيْفَ نُنْشِزُهَا ثُمَّ نَكْسُوهَا لَحْمًا فَلَمَّا تَبَيَّنَ لَهُ قَالَ أَعْلَمُ أَنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":258,"text":"أَلَمْ تَرَ إِلَى الَّذِي حَاجَّ إِبْرَاهِيمَ فِي رَبِّهِ أَنْ آتَاهُ اللَّهُ الْمُلْكَ إِذْ قَالَ إِبْرَاهِيمُ رَبِّيَ الَّذِي يُحْيِي وَيُمِيتُ قَالَ أَنَا أُحْيِي وَأُمِيتُ قَالَ إِبْرَاهِيمُ فَإِنَّ اللَّهَ يَأْتِي بِالشَّمْسِ مِنَ الْمَشْرِقِ فَأْتِ بِهَا مِنَ الْمَغْرِبِ فَبُهِتَ الَّذِي كَفَرَ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ"},"next":{"a":260,"text":"وَإِذْ قَالَ إِبْرَاهِيمُ رَبِّ أَرِنِي كَيْفَ تُحْيِي الْمَوْتَى قَالَ أَوَلَمْ تُؤْمِنْ قَالَ بَلَى وَلَكِنْ لِيَطْمَئِنَّ قَلْبِي قَالَ فَخُذْ أَرْبَعَةً مِنَ الطَّيْرِ فَصُرْهُنَّ إِلَيْكَ ثُمَّ اجْعَلْ عَلَى كُلِّ جَبَلٍ مِنْهُنَّ جُزْءًا ثُمَّ ادْعُهُنَّ يَأْتِينَكَ سَعْيًا وَاعْلَمْ أَنَّ اللَّهَ عَزِيزٌ حَكِيمٌ"},"context":"قصة الذي مرّ على القرية الخاوية: ﴿قَالَ أَنَّى يُحْيِي هَذِهِ اللَّهُ بَعْدَ مَوْتِهَا فَأَمَاتَهُ اللَّهُ مِائَةَ عَامٍ ثُمَّ بَعَثَهُ... وَانْظُرْ إِلَى الْعِظَامِ كَيْفَ نُنْشِزُهَا ثُمَّ نَكْسُوهَا لَحْمًا فَلَمَّا تَبَيَّنَ لَهُ قَالَ أَعْلَمُ أَنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾.","reason":"سؤالُ استبعادٍ أُجيب بتجربةٍ شخصية: مات مئة عام وبُعث، وطعامُه لم يتسنّه وحمارُه أُعيد أمام عينيه — فانتقل من ﴿أَنَّى﴾ إلى ﴿أَعْلَمُ﴾؛ فالعلمُ اليقيني جاء بالمشاهدة لا بالجدل.","adds":"من استبعد قدرةً فقد يُعلَّم بتجربةٍ في نفسه — فتأدب في استبعادك."},{"i":6,"of":35,"s":2,"surah":"البقرة","a":284,"text":"لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَإِنْ تُبْدُوا مَا فِي أَنْفُسِكُمْ أَوْ تُخْفُوهُ يُحَاسِبْكُمْ بِهِ اللَّهُ فَيَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":283,"text":"وَإِنْ كُنْتُمْ عَلَى سَفَرٍ وَلَمْ تَجِدُوا كَاتِبًا فَرِهَانٌ مَقْبُوضَةٌ فَإِنْ أَمِنَ بَعْضُكُمْ بَعْضًا فَلْيُؤَدِّ الَّذِي اؤْتُمِنَ أَمَانَتَهُ وَلْيَتَّقِ اللَّهَ رَبَّهُ وَلَا تَكْتُمُوا الشَّهَادَةَ وَمَنْ يَكْتُمْهَا فَإِنَّهُ آثِمٌ قَلْبُهُ وَاللَّهُ بِمَا تَعْمَلُونَ عَلِيمٌ"},"next":{"a":285,"text":"آمَنَ الرَّسُولُ بِمَا أُنْزِلَ إِلَيْهِ مِنْ رَبِّهِ وَالْمُؤْمِنُونَ كُلٌّ آمَنَ بِاللَّهِ وَمَلَائِكَتِهِ وَكُتُبِهِ وَرُسُلِهِ لَا نُفَرِّقُ بَيْنَ أَحَدٍ مِنْ رُسُلِهِ وَقَالُوا سَمِعْنَا وَأَطَعْنَا غُفْرَانَكَ رَبَّنَا وَإِلَيْكَ الْمَصِيرُ"},"context":"﴿وَإِنْ تُبْدُوا مَا فِي أَنْفُسِكُمْ أَوْ تُخْفُوهُ يُحَاسِبْكُمْ بِهِ اللَّهُ فَيَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — قبل خاتمة البقرة.","reason":"آيةٌ شقّت على الصحابة حتى نزلت بعدها ﴿لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا﴾ (صحيح مسلم 125) — والقدرةُ هنا قدرةُ المغفرة كما هي قدرةُ العذاب: ﴿فَيَغْفِرُ لِمَنْ يَشَاءُ﴾ سبقت ﴿وَيُعَذِّبُ﴾.","adds":"قدرتُه على المغفرة ذُكرت قبل قدرته على العذاب — فقدّم الرجاء كما قدّمه.","dorar":[{"id":"y4sV2OZk","label":"صحيح مسلم 125"},{"id":"GeK7oo2d","label":"تفسير القرآن العظيم 1/503"},{"id":"CT5USTwM","label":"تخريج صحيح ابن حبان 5069"}]},{"i":7,"of":35,"s":3,"surah":"آل عمران","a":26,"text":"قُلِ اللَّهُمَّ مَالِكَ الْمُلْكِ تُؤْتِي الْمُلْكَ مَنْ تَشَاءُ وَتَنْزِعُ الْمُلْكَ مِمَّنْ تَشَاءُ وَتُعِزُّ مَنْ تَشَاءُ وَتُذِلُّ مَنْ تَشَاءُ بِيَدِكَ الْخَيْرُ إِنَّكَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":25,"text":"فَكَيْفَ إِذَا جَمَعْنَاهُمْ لِيَوْمٍ لَا رَيْبَ فِيهِ وَوُفِّيَتْ كُلُّ نَفْسٍ مَا كَسَبَتْ وَهُمْ لَا يُظْلَمُونَ"},"next":{"a":27,"text":"تُولِجُ اللَّيْلَ فِي النَّهَارِ وَتُولِجُ النَّهَارَ فِي اللَّيْلِ وَتُخْرِجُ الْحَيَّ مِنَ الْمَيِّتِ وَتُخْرِجُ الْمَيِّتَ مِنَ الْحَيِّ وَتَرْزُقُ مَنْ تَشَاءُ بِغَيْرِ حِسَابٍ"},"reason":"أربعُ تصرفاتٍ متقابلة — إيتاءٌ ونزعٌ وإعزازٌ وإذلال — ثم قيدٌ لافت: ﴿بِيَدِكَ الْخَيْرُ﴾: لم يقل «والشر» — فالخيرُ وحده منسوبٌ إليه؛ والقدرةُ خاتمةُ الآية وضمانتُها.","adds":"في تقلبات المناصب والدول: ﴿تُؤْتِي الْمُلْكَ مَنْ تَشَاءُ وَتَنْزِعُ الْمُلْكَ مِمَّنْ تَشَاءُ﴾ — لا أحد يبقى."},{"i":8,"of":35,"s":3,"surah":"آل عمران","a":29,"text":"قُلْ إِنْ تُخْفُوا مَا فِي صُدُورِكُمْ أَوْ تُبْدُوهُ يَعْلَمْهُ اللَّهُ وَيَعْلَمُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":28,"text":"لَا يَتَّخِذِ الْمُؤْمِنُونَ الْكَافِرِينَ أَوْلِيَاءَ مِنْ دُونِ الْمُؤْمِنِينَ وَمَنْ يَفْعَلْ ذَلِكَ فَلَيْسَ مِنَ اللَّهِ فِي شَيْءٍ إِلَّا أَنْ تَتَّقُوا مِنْهُمْ تُقَاةً وَيُحَذِّرُكُمُ اللَّهُ نَفْسَهُ وَإِلَى اللَّهِ الْمَصِيرُ"},"next":{"a":30,"text":"يَوْمَ تَجِدُ كُلُّ نَفْسٍ مَا عَمِلَتْ مِنْ خَيْرٍ مُحْضَرًا وَمَا عَمِلَتْ مِنْ سُوءٍ تَوَدُّ لَوْ أَنَّ بَيْنَهَا وَبَيْنَهُ أَمَدًا بَعِيدًا وَيُحَذِّرُكُمُ اللَّهُ نَفْسَهُ وَاللَّهُ رَءُوفٌ بِالْعِبَادِ"},"reason":"قُرن العلمُ بما في الصدور بالقدرة على كل شيء: علمٌ يكشف وقدرةٌ تجازي — فالعلمُ بلا قدرةٍ لا يُخيف، والقدرةُ بلا علمٍ عمياء؛ واجتماعُهما يستوجب المراقبة.","adds":"العلم والقدرة معًا هما ما يجعل المراقبة جدّية: يعلم ويقدر."},{"i":9,"of":35,"s":3,"surah":"آل عمران","a":165,"text":"أَوَلَمَّا أَصَابَتْكُمْ مُصِيبَةٌ قَدْ أَصَبْتُمْ مِثْلَيْهَا قُلْتُمْ أَنَّى هَذَا قُلْ هُوَ مِنْ عِنْدِ أَنْفُسِكُمْ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":164,"text":"لَقَدْ مَنَّ اللَّهُ عَلَى الْمُؤْمِنِينَ إِذْ بَعَثَ فِيهِمْ رَسُولًا مِنْ أَنْفُسِهِمْ يَتْلُو عَلَيْهِمْ آيَاتِهِ وَيُزَكِّيهِمْ وَيُعَلِّمُهُمُ الْكِتَابَ وَالْحِكْمَةَ وَإِنْ كَانُوا مِنْ قَبْلُ لَفِي ضَلَالٍ مُبِينٍ"},"next":{"a":166,"text":"وَمَا أَصَابَكُمْ يَوْمَ الْتَقَى الْجَمْعَانِ فَبِإِذْنِ اللَّهِ وَلِيَعْلَمَ الْمُؤْمِنِينَ"},"context":"بعد أُحد: ﴿أَوَلَمَّا أَصَابَتْكُمْ مُصِيبَةٌ قَدْ أَصَبْتُمْ مِثْلَيْهَا قُلْتُمْ أَنَّى هَذَا قُلْ هُوَ مِنْ عِنْدِ أَنْفُسِكُمْ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾.","reason":"جوابٌ صادم للسؤال ﴿أَنَّى هَذَا﴾: ﴿مِنْ عِنْدِ أَنْفُسِكُمْ﴾ — مراجعةٌ ذاتية لا اتهامٌ للقدر؛ والقدرةُ تعني أنه كان قادرًا على منع المصيبة لكنها جاءت بأسبابٍ منكم لحكمة.","adds":"أول سؤالٍ بعد كل انتكاسة: ما الذي جاء من عند أنفسنا؟ — لا: لماذا فعل الله بنا هذا؟"},{"i":10,"of":35,"s":3,"surah":"آل عمران","a":189,"text":"وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":188,"text":"لَا تَحْسَبَنَّ الَّذِينَ يَفْرَحُونَ بِمَا أَتَوْا وَيُحِبُّونَ أَنْ يُحْمَدُوا بِمَا لَمْ يَفْعَلُوا فَلَا تَحْسَبَنَّهُمْ بِمَفَازَةٍ مِنَ الْعَذَابِ وَلَهُمْ عَذَابٌ أَلِيمٌ"},"next":{"a":190,"text":"إِنَّ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ وَاخْتِلَافِ اللَّيْلِ وَالنَّهَارِ لَآيَاتٍ لِأُولِي الْأَلْبَابِ"},"context":"﴿وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — بعد وعيد الذين يفرحون بما أتوا ويحبون أن يُحمدوا بما لم يفعلوا، وقبل آيات التفكر: ﴿إِنَّ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ وَاخْتِلَافِ اللَّيْلِ وَالنَّهَارِ لَآيَاتٍ لِأُولِي الْأَلْبَابِ﴾.","reason":"جاءت بعد وعيد ﴿فَلَا تَحْسَبَنَّهُمْ بِمَفَازَةٍ مِنَ الْعَذَابِ﴾: فمن له ملك السماوات والأرض وهو على كل شيءٍ قدير لا مفازة منه. ثم فتحت الآيةُ بعدها بابَ التفكر في خلق السماوات والأرض لأولي الألباب؛ فمن تفكّر وقال ﴿رَبَّنَا مَا خَلَقْتَ هَذَا بَاطِلًا﴾ أدرك أن مالك هذا الخلق قادرٌ على كل شيء — بما فيه إنجاز وعده لك.","adds":"التفكر في الكون طريقٌ إلى اليقين بالقدرة — وهو ما فعله أولو الألباب في الآيات التي تليها."},{"i":11,"of":35,"s":5,"surah":"المائدة","a":17,"text":"لَقَدْ كَفَرَ الَّذِينَ قَالُوا إِنَّ اللَّهَ هُوَ الْمَسِيحُ ابْنُ مَرْيَمَ قُلْ فَمَنْ يَمْلِكُ مِنَ اللَّهِ شَيْئًا إِنْ أَرَادَ أَنْ يُهْلِكَ الْمَسِيحَ ابْنَ مَرْيَمَ وَأُمَّهُ وَمَنْ فِي الْأَرْضِ جَمِيعًا وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا يَخْلُقُ مَا يَشَاءُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":16,"text":"يَهْدِي بِهِ اللَّهُ مَنِ اتَّبَعَ رِضْوَانَهُ سُبُلَ السَّلَامِ وَيُخْرِجُهُمْ مِنَ الظُّلُمَاتِ إِلَى النُّورِ بِإِذْنِهِ وَيَهْدِيهِمْ إِلَى صِرَاطٍ مُسْتَقِيمٍ"},"next":{"a":18,"text":"وَقَالَتِ الْيَهُودُ وَالنَّصَارَى نَحْنُ أَبْنَاءُ اللَّهِ وَأَحِبَّاؤُهُ قُلْ فَلِمَ يُعَذِّبُكُمْ بِذُنُوبِكُمْ بَلْ أَنْتُمْ بَشَرٌ مِمَّنْ خَلَقَ يَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَإِلَيْهِ الْمَصِيرُ"},"context":"﴿لَقَدْ كَفَرَ الَّذِينَ قَالُوا إِنَّ اللَّهَ هُوَ الْمَسِيحُ ابْنُ مَرْيَمَ قُلْ فَمَنْ يَمْلِكُ مِنَ اللَّهِ شَيْئًا إِنْ أَرَادَ أَنْ يُهْلِكَ الْمَسِيحَ ابْنَ مَرْيَمَ وَأُمَّهُ وَمَنْ فِي الْأَرْضِ جَمِيعًا وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ... وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾.","reason":"حجةٌ قاطعة على بشرية المسيح: من كان قابلًا للإهلاك لا يكون إلهًا — والقدرةُ على إهلاك الجميع تفرزُ الخالقَ من المخلوق؛ فقابليةُ الفناء برهانُ العبودية.","adds":"معيارٌ فاصل: كلُّ من يقبل الفناء عبدٌ — وقدرة الله على كل شيء تفرز العابد من المعبود."},{"i":12,"of":35,"s":5,"surah":"المائدة","a":19,"text":"يَا أَهْلَ الْكِتَابِ قَدْ جَاءَكُمْ رَسُولُنَا يُبَيِّنُ لَكُمْ عَلَى فَتْرَةٍ مِنَ الرُّسُلِ أَنْ تَقُولُوا مَا جَاءَنَا مِنْ بَشِيرٍ وَلَا نَذِيرٍ فَقَدْ جَاءَكُمْ بَشِيرٌ وَنَذِيرٌ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":18,"text":"وَقَالَتِ الْيَهُودُ وَالنَّصَارَى نَحْنُ أَبْنَاءُ اللَّهِ وَأَحِبَّاؤُهُ قُلْ فَلِمَ يُعَذِّبُكُمْ بِذُنُوبِكُمْ بَلْ أَنْتُمْ بَشَرٌ مِمَّنْ خَلَقَ يَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَإِلَيْهِ الْمَصِيرُ"},"next":{"a":20,"text":"وَإِذْ قَالَ مُوسَى لِقَوْمِهِ يَا قَوْمِ اذْكُرُوا نِعْمَةَ اللَّهِ عَلَيْكُمْ إِذْ جَعَلَ فِيكُمْ أَنْبِيَاءَ وَجَعَلَكُمْ مُلُوكًا وَآتَاكُمْ مَا لَمْ يُؤْتِ أَحَدًا مِنَ الْعَالَمِينَ"},"reason":"بعثةٌ على فترة انقطاعٍ من الرسل — لقطع عذر ﴿مَا جَاءَنَا مِنْ بَشِيرٍ﴾؛ والقدرةُ ضمانةُ إتمام البعثة وحفظها: قادرٌ على إرسال رسولٍ بعد فترةٍ طويلة وعلى إقامة حجته.","adds":"العذر بعدم بلوغ الرسالة انقطع: ﴿فَقَدْ جَاءَكُمْ بَشِيرٌ وَنَذِيرٌ﴾ — فالحجة قائمة."},{"i":13,"of":35,"s":5,"surah":"المائدة","a":40,"text":"أَلَمْ تَعْلَمْ أَنَّ اللَّهَ لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ يُعَذِّبُ مَنْ يَشَاءُ وَيَغْفِرُ لِمَنْ يَشَاءُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":39,"text":"فَمَنْ تَابَ مِنْ بَعْدِ ظُلْمِهِ وَأَصْلَحَ فَإِنَّ اللَّهَ يَتُوبُ عَلَيْهِ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ"},"next":{"a":41,"text":"يَا أَيُّهَا الرَّسُولُ لَا يَحْزُنْكَ الَّذِينَ يُسَارِعُونَ فِي الْكُفْرِ مِنَ الَّذِينَ قَالُوا آمَنَّا بِأَفْوَاهِهِمْ وَلَمْ تُؤْمِنْ قُلُوبُهُمْ وَمِنَ الَّذِينَ هَادُوا سَمَّاعُونَ لِلْكَذِبِ سَمَّاعُونَ لِقَوْمٍ آخَرِينَ لَمْ يَأْتُوكَ يُحَرِّفُونَ الْكَلِمَ مِنْ بَعْدِ مَوَاضِعِهِ يَقُولُونَ إِنْ أُوتِيتُمْ هَذَا فَخُذُوهُ وَإِنْ لَمْ تُؤْتَوْهُ فَاحْذَرُوا وَمَنْ يُرِدِ اللَّهُ فِتْنَتَهُ فَلَنْ تَمْلِكَ لَهُ مِنَ اللَّهِ شَيْئًا أُولَئِكَ الَّذِينَ لَمْ يُرِدِ اللَّهُ أَنْ يُطَهِّرَ قُلُوبَهُمْ لَهُمْ فِي الدُّنْيَا خِزْيٌ وَلَهُمْ فِي الْآخِرَةِ عَذَابٌ عَظِيمٌ"},"context":"﴿أَلَمْ تَعْلَمْ أَنَّ اللَّهَ لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ يُعَذِّبُ مَنْ يَشَاءُ وَيَغْفِرُ لِمَنْ يَشَاءُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — بعد آية السرقة والتوبة.","reason":"جاءت بعد ﴿فَمَنْ تَابَ مِنْ بَعْدِ ظُلْمِهِ وَأَصْلَحَ﴾: فالمالكُ يعذّب ويغفر بمشيئته — والقدرةُ تعني أن التوبة مقبولةٌ ولو بعد إقامة الحد؛ فلا ملفَّ مغلقًا عند قادرٍ على كل شيء.","adds":"لا قضيةَ منتهية عند من يقدر على كل شيء: تاب بعد ظلمه؟ الباب مفتوح."},{"i":14,"of":35,"s":5,"surah":"المائدة","a":120,"text":"لِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا فِيهِنَّ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":119,"text":"قَالَ اللَّهُ هَذَا يَوْمُ يَنْفَعُ الصَّادِقِينَ صِدْقُهُمْ لَهُمْ جَنَّاتٌ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا أَبَدًا رَضِيَ اللَّهُ عَنْهُمْ وَرَضُوا عَنْهُ ذَلِكَ الْفَوْزُ الْعَظِيمُ"},"context":"خاتمة المائدة: ﴿لِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا فِيهِنَّ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — بعد شهادة عيسى وقول الله ﴿هَذَا يَوْمُ يَنْفَعُ الصَّادِقِينَ صِدْقُهُمْ﴾.","reason":"خُتمت السورة بالملك الشامل والقدرة المطلقة بعد أعظم مشهدٍ لتبرؤ عيسى: فالخاتمةُ تضع كل دعاوى الشركاء في حجمها — الملكُ لله وحده وما فيهن، والقدرةُ على كل شيء.","adds":"خواتيم السور تحسم مضامينها: بعد نفي إلهية المسيح جاء إعلان الملك والقدرة."},{"i":15,"of":35,"s":6,"surah":"الأنعام","a":17,"text":"وَإِنْ يَمْسَسْكَ اللَّهُ بِضُرٍّ فَلَا كَاشِفَ لَهُ إِلَّا هُوَ وَإِنْ يَمْسَسْكَ بِخَيْرٍ فَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":16,"text":"مَنْ يُصْرَفْ عَنْهُ يَوْمَئِذٍ فَقَدْ رَحِمَهُ وَذَلِكَ الْفَوْزُ الْمُبِينُ"},"next":{"a":18,"text":"وَهُوَ الْقَاهِرُ فَوْقَ عِبَادِهِ وَهُوَ الْحَكِيمُ الْخَبِيرُ"},"reason":"مقابلةٌ دقيقة: في الضر ﴿فَلَا كَاشِفَ لَهُ إِلَّا هُوَ﴾ — حصرٌ في الكشف؛ وفي الخير ﴿فَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — إطلاقٌ في العطاء: فالضرُّ لا يرفعه غيره، والخيرُ لا يحدّه شيء.","adds":"عند المرض والضيق: لا كاشف إلا هو — وعند الرجاء: قدرتُه لا سقف لها."},{"i":16,"of":35,"s":8,"surah":"الأنفال","a":41,"text":"وَاعْلَمُوا أَنَّمَا غَنِمْتُمْ مِنْ شَيْءٍ فَأَنَّ لِلَّهِ خُمُسَهُ وَلِلرَّسُولِ وَلِذِي الْقُرْبَى وَالْيَتَامَى وَالْمَسَاكِينِ وَابْنِ السَّبِيلِ إِنْ كُنْتُمْ آمَنْتُمْ بِاللَّهِ وَمَا أَنْزَلْنَا عَلَى عَبْدِنَا يَوْمَ الْفُرْقَانِ يَوْمَ الْتَقَى الْجَمْعَانِ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":40,"text":"وَإِنْ تَوَلَّوْا فَاعْلَمُوا أَنَّ اللَّهَ مَوْلَاكُمْ نِعْمَ الْمَوْلَى وَنِعْمَ النَّصِيرُ"},"next":{"a":42,"text":"إِذْ أَنْتُمْ بِالْعُدْوَةِ الدُّنْيَا وَهُمْ بِالْعُدْوَةِ الْقُصْوَى وَالرَّكْبُ أَسْفَلَ مِنْكُمْ وَلَوْ تَوَاعَدْتُمْ لَاخْتَلَفْتُمْ فِي الْمِيعَادِ وَلَكِنْ لِيَقْضِيَ اللَّهُ أَمْرًا كَانَ مَفْعُولًا لِيَهْلِكَ مَنْ هَلَكَ عَنْ بَيِّنَةٍ وَيَحْيَى مَنْ حَيَّ عَنْ بَيِّنَةٍ وَإِنَّ اللَّهَ لَسَمِيعٌ عَلِيمٌ"},"context":"آية الأنفال والخمس: ﴿وَاعْلَمُوا أَنَّمَا غَنِمْتُمْ مِنْ شَيْءٍ فَأَنَّ لِلَّهِ خُمُسَهُ وَلِلرَّسُولِ... إِنْ كُنْتُمْ آمَنْتُمْ بِاللَّهِ وَمَا أَنْزَلْنَا عَلَى عَبْدِنَا يَوْمَ الْفُرْقَانِ يَوْمَ الْتَقَى الْجَمْعَانِ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾.","reason":"رُبط تشريعُ الخمس بذكرى بدر «يوم الفرقان» — والقدرةُ ضمانةُ من نصرهم يومها: فالذي أعطاكم الغنيمة بقدرته هو الذي يشرّع في توزيعها؛ فلا تُنازع في قسمة من أعطاك.","adds":"من أعطاك بقدرته له حقُّ التشريع في عطائه — فلا تنازع في قسمة الغنيمة."},{"i":17,"of":35,"s":9,"surah":"التوبة","a":39,"text":"إِلَّا تَنْفِرُوا يُعَذِّبْكُمْ عَذَابًا أَلِيمًا وَيَسْتَبْدِلْ قَوْمًا غَيْرَكُمْ وَلَا تَضُرُّوهُ شَيْئًا وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":38,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا مَا لَكُمْ إِذَا قِيلَ لَكُمُ انْفِرُوا فِي سَبِيلِ اللَّهِ اثَّاقَلْتُمْ إِلَى الْأَرْضِ أَرَضِيتُمْ بِالْحَيَاةِ الدُّنْيَا مِنَ الْآخِرَةِ فَمَا مَتَاعُ الْحَيَاةِ الدُّنْيَا فِي الْآخِرَةِ إِلَّا قَلِيلٌ"},"next":{"a":40,"text":"إِلَّا تَنْصُرُوهُ فَقَدْ نَصَرَهُ اللَّهُ إِذْ أَخْرَجَهُ الَّذِينَ كَفَرُوا ثَانِيَ اثْنَيْنِ إِذْ هُمَا فِي الْغَارِ إِذْ يَقُولُ لِصَاحِبِهِ لَا تَحْزَنْ إِنَّ اللَّهَ مَعَنَا فَأَنْزَلَ اللَّهُ سَكِينَتَهُ عَلَيْهِ وَأَيَّدَهُ بِجُنُودٍ لَمْ تَرَوْهَا وَجَعَلَ كَلِمَةَ الَّذِينَ كَفَرُوا السُّفْلَى وَكَلِمَةُ اللَّهِ هِيَ الْعُلْيَا وَاللَّهُ عَزِيزٌ حَكِيمٌ"},"reason":"تهديدٌ بالاستبدال — والقدرةُ ضمانتُه: قادرٌ على إنشاء قومٍ آخرين؛ فتخلّفُك لا يعطّل المشروع ولا يضره شيئًا، بل يُخرجك أنت من القافلة.","adds":"مشروع الله لا يتوقف على أحد: ﴿وَلَا تَضُرُّوهُ شَيْئًا﴾ — الخسارة كلها في جهةٍ واحدة."},{"i":18,"of":35,"s":11,"surah":"هود","a":4,"text":"إِلَى اللَّهِ مَرْجِعُكُمْ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":3,"text":"وَأَنِ اسْتَغْفِرُوا رَبَّكُمْ ثُمَّ تُوبُوا إِلَيْهِ يُمَتِّعْكُمْ مَتَاعًا حَسَنًا إِلَى أَجَلٍ مُسَمًّى وَيُؤْتِ كُلَّ ذِي فَضْلٍ فَضْلَهُ وَإِنْ تَوَلَّوْا فَإِنِّي أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ كَبِيرٍ"},"next":{"a":5,"text":"أَلَا إِنَّهُمْ يَثْنُونَ صُدُورَهُمْ لِيَسْتَخْفُوا مِنْهُ أَلَا حِينَ يَسْتَغْشُونَ ثِيَابَهُمْ يَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِنُونَ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ"},"context":"مطلع سورة هود: كتابٌ يأمر بعبادة الله وحده، ثم بالاستغفار والتوبة: ﴿وَأَنِ اسْتَغْفِرُوا رَبَّكُمْ ثُمَّ تُوبُوا إِلَيْهِ...﴾ ثم: ﴿إِلَى اللَّهِ مَرْجِعُكُمْ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾.","reason":"قُرن المرجعُ بالقدرة: فالرجوعُ إليه ليس احتمالًا بل حتميةٌ مضمونةٌ بقدرةٍ على كل شيء — ومن قدر على كل شيء قدر على جمعكم بعد تفرّقكم ترابًا.","adds":"حتميةُ المرجع مبنيةٌ على القدرة: ﴿إِلَى اللَّهِ مَرْجِعُكُمْ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾."},{"i":19,"of":35,"s":16,"surah":"النحل","a":77,"text":"وَلِلَّهِ غَيْبُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا أَمْرُ السَّاعَةِ إِلَّا كَلَمْحِ الْبَصَرِ أَوْ هُوَ أَقْرَبُ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":76,"text":"وَضَرَبَ اللَّهُ مَثَلًا رَجُلَيْنِ أَحَدُهُمَا أَبْكَمُ لَا يَقْدِرُ عَلَى شَيْءٍ وَهُوَ كَلٌّ عَلَى مَوْلَاهُ أَيْنَمَا يُوَجِّهْهُ لَا يَأْتِ بِخَيْرٍ هَلْ يَسْتَوِي هُوَ وَمَنْ يَأْمُرُ بِالْعَدْلِ وَهُوَ عَلَى صِرَاطٍ مُسْتَقِيمٍ"},"next":{"a":78,"text":"وَاللَّهُ أَخْرَجَكُمْ مِنْ بُطُونِ أُمَّهَاتِكُمْ لَا تَعْلَمُونَ شَيْئًا وَجَعَلَ لَكُمُ السَّمْعَ وَالْأَبْصَارَ وَالْأَفْئِدَةَ لَعَلَّكُمْ تَشْكُرُونَ"},"reason":"تشبيهٌ يحسم الجدل في هول الساعة: ﴿كَلَمْحِ الْبَصَرِ أَوْ هُوَ أَقْرَبُ﴾ — فالحدثُ الأعظم يقع في أسرع من لمحة؛ والقدرةُ تفسّر السرعة: من يقدر على كل شيء لا يحتاج زمنًا للتنفيذ.","adds":"الحدث الأعظم في تاريخ الوجود يقع في أسرع من لمحة بصر — فلا تحسبه بعيدًا."},{"i":20,"of":35,"s":22,"surah":"الحج","a":6,"text":"ذَلِكَ بِأَنَّ اللَّهَ هُوَ الْحَقُّ وَأَنَّهُ يُحْيِي الْمَوْتَى وَأَنَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":5,"text":"يَا أَيُّهَا النَّاسُ إِنْ كُنْتُمْ فِي رَيْبٍ مِنَ الْبَعْثِ فَإِنَّا خَلَقْنَاكُمْ مِنْ تُرَابٍ ثُمَّ مِنْ نُطْفَةٍ ثُمَّ مِنْ عَلَقَةٍ ثُمَّ مِنْ مُضْغَةٍ مُخَلَّقَةٍ وَغَيْرِ مُخَلَّقَةٍ لِنُبَيِّنَ لَكُمْ وَنُقِرُّ فِي الْأَرْحَامِ مَا نَشَاءُ إِلَى أَجَلٍ مُسَمًّى ثُمَّ نُخْرِجُكُمْ طِفْلًا ثُمَّ لِتَبْلُغُوا أَشُدَّكُمْ وَمِنْكُمْ مَنْ يُتَوَفَّى وَمِنْكُمْ مَنْ يُرَدُّ إِلَى أَرْذَلِ الْعُمُرِ لِكَيْلَا يَعْلَمَ مِنْ بَعْدِ عِلْمٍ شَيْئًا وَتَرَى الْأَرْضَ هَامِدَةً فَإِذَا أَنْزَلْنَا عَلَيْهَا الْمَاءَ اهْتَزَّتْ وَرَبَتْ وَأَنْبَتَتْ مِنْ كُلِّ زَوْجٍ بَهِيجٍ"},"next":{"a":7,"text":"وَأَنَّ السَّاعَةَ آتِيَةٌ لَا رَيْبَ فِيهَا وَأَنَّ اللَّهَ يَبْعَثُ مَنْ فِي الْقُبُورِ"},"context":"﴿ذَلِكَ بِأَنَّ اللَّهَ هُوَ الْحَقُّ وَأَنَّهُ يُحْيِي الْمَوْتَى وَأَنَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — بعد آية الأرض الهامدة.","reason":"ثلاثُ حقائق يبرهن عليها إحياءُ الأرض: أنه الحق، ويحيي الموتى، وعلى كل شيء قدير — فمشهدٌ واحد يثمر ثلاث عقائد؛ والربيعُ برهانٌ متجدد كل عام.","adds":"كل ربيعٍ تشهده يقرر لك ثلاث حقائق — فلا تمرّ بالخضرة دون أن تقرأها."},{"i":21,"of":35,"s":24,"surah":"النور","a":45,"text":"وَاللَّهُ خَلَقَ كُلَّ دَابَّةٍ مِنْ مَاءٍ فَمِنْهُمْ مَنْ يَمْشِي عَلَى بَطْنِهِ وَمِنْهُمْ مَنْ يَمْشِي عَلَى رِجْلَيْنِ وَمِنْهُمْ مَنْ يَمْشِي عَلَى أَرْبَعٍ يَخْلُقُ اللَّهُ مَا يَشَاءُ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":44,"text":"يُقَلِّبُ اللَّهُ اللَّيْلَ وَالنَّهَارَ إِنَّ فِي ذَلِكَ لَعِبْرَةً لِأُولِي الْأَبْصَارِ"},"next":{"a":46,"text":"لَقَدْ أَنْزَلْنَا آيَاتٍ مُبَيِّنَاتٍ وَاللَّهُ يَهْدِي مَنْ يَشَاءُ إِلَى صِرَاطٍ مُسْتَقِيمٍ"},"reason":"من أصلٍ واحد — الماء — ثلاثةُ أنماطٍ للحركة: زحفٌ ومشيٌ على قدمين وعلى أربع؛ فالتنوعُ الهائل من مادةٍ واحدة أظهرُ برهانٍ على القدرة: ﴿يَخْلُقُ اللَّهُ مَا يَشَاءُ﴾.","adds":"وحدةُ المادة مع هذا التنوع الهائل: أعظمُ ما يبهر دارسي الأحياء اليوم — وهو برهان الآية."},{"i":22,"of":35,"s":29,"surah":"العنكبوت","a":20,"text":"قُلْ سِيرُوا فِي الْأَرْضِ فَانْظُرُوا كَيْفَ بَدَأَ الْخَلْقَ ثُمَّ اللَّهُ يُنْشِئُ النَّشْأَةَ الْآخِرَةَ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":19,"text":"أَوَلَمْ يَرَوْا كَيْفَ يُبْدِئُ اللَّهُ الْخَلْقَ ثُمَّ يُعِيدُهُ إِنَّ ذَلِكَ عَلَى اللَّهِ يَسِيرٌ"},"next":{"a":21,"text":"يُعَذِّبُ مَنْ يَشَاءُ وَيَرْحَمُ مَنْ يَشَاءُ وَإِلَيْهِ تُقْلَبُونَ"},"reason":"أمرٌ بالسير والنظر في بدء الخلق — بحثٌ ميداني في الأرض — ثم القياس إلى النشأة الآخرة؛ فالقرآنُ يدعو إلى دراسة أصل الحياة ليُستدل بها على الإعادة: منهجٌ استدلالي لا تسليمٌ مجرد.","adds":"دعوةٌ قرآنية صريحة لدراسة بدايات الخلق: ﴿سِيرُوا فِي الْأَرْضِ فَانْظُرُوا كَيْفَ بَدَأَ الْخَلْقَ﴾."},{"i":23,"of":35,"s":30,"surah":"الروم","a":50,"text":"فَانْظُرْ إِلَى آثَارِ رَحْمَتِ اللَّهِ كَيْفَ يُحْيِي الْأَرْضَ بَعْدَ مَوْتِهَا إِنَّ ذَلِكَ لَمُحْيِي الْمَوْتَى وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":49,"text":"وَإِنْ كَانُوا مِنْ قَبْلِ أَنْ يُنَزَّلَ عَلَيْهِمْ مِنْ قَبْلِهِ لَمُبْلِسِينَ"},"next":{"a":51,"text":"وَلَئِنْ أَرْسَلْنَا رِيحًا فَرَأَوْهُ مُصْفَرًّا لَظَلُّوا مِنْ بَعْدِهِ يَكْفُرُونَ"},"reason":"سُمّي المطرُ والخضرةُ «آثار رحمة» — لا مجرد ظاهرةٍ مناخية؛ والنظرُ فيها مأمورٌ به: فالتأملُ في الربيع عبادةٌ توصل إلى اليقين بالبعث عند قادرٍ على كل شيء.","adds":"في المرة القادمة التي ترى فيها أرضًا خضراء بعد جدب: أنت تنظر إلى «آثار رحمة الله»."},{"i":24,"of":35,"s":33,"surah":"الأحزاب","a":27,"text":"وَأَوْرَثَكُمْ أَرْضَهُمْ وَدِيَارَهُمْ وَأَمْوَالَهُمْ وَأَرْضًا لَمْ تَطَئُوهَا وَكَانَ اللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرًا","prev":{"a":26,"text":"وَأَنْزَلَ الَّذِينَ ظَاهَرُوهُمْ مِنْ أَهْلِ الْكِتَابِ مِنْ صَيَاصِيهِمْ وَقَذَفَ فِي قُلُوبِهِمُ الرُّعْبَ فَرِيقًا تَقْتُلُونَ وَتَأْسِرُونَ فَرِيقًا"},"next":{"a":28,"text":"يَا أَيُّهَا النَّبِيُّ قُلْ لِأَزْوَاجِكَ إِنْ كُنْتُنَّ تُرِدْنَ الْحَيَاةَ الدُّنْيَا وَزِينَتَهَا فَتَعَالَيْنَ أُمَتِّعْكُنَّ وَأُسَرِّحْكُنَّ سَرَاحًا جَمِيلًا"},"context":"في الأحزاب وبني قريظة: ﴿وَأَوْرَثَكُمْ أَرْضَهُمْ وَدِيَارَهُمْ وَأَمْوَالَهُمْ وَأَرْضًا لَمْ تَطَئُوهَا وَكَانَ اللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرًا﴾.","reason":"أورثهم أرض قريظة وديارهم وأموالهم، ثم ضمّ إليها ﴿وَأَرْضًا لَمْ تَطَئُوهَا﴾ — أرضًا لم توطأ بعد؛ فالقدرةُ ضمانةُ فتوحاتٍ مستقبلية لم تُتصور بعد: قيل لقومٍ خرجوا لتوّهم من حصار الأحزاب إنكم ستورثون أرضًا لم تطؤوها، فوقع.","adds":"وعدُ الله يتجاوز حدود خيالك: قيل لقومٍ خرجوا لتوّهم من الحصار عن أرضٍ لم يطؤوها بعد."},{"i":25,"of":35,"s":35,"surah":"فاطر","a":1,"text":"الْحَمْدُ لِلَّهِ فَاطِرِ السَّمَاوَاتِ وَالْأَرْضِ جَاعِلِ الْمَلَائِكَةِ رُسُلًا أُولِي أَجْنِحَةٍ مَثْنَى وَثُلَاثَ وَرُبَاعَ يَزِيدُ فِي الْخَلْقِ مَا يَشَاءُ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","next":{"a":2,"text":"مَا يَفْتَحِ اللَّهُ لِلنَّاسِ مِنْ رَحْمَةٍ فَلَا مُمْسِكَ لَهَا وَمَا يُمْسِكْ فَلَا مُرْسِلَ لَهُ مِنْ بَعْدِهِ وَهُوَ الْعَزِيزُ الْحَكِيمُ"},"reason":"جملةٌ مفتوحة: و﴿يَزِيدُ فِي الْخَلْقِ مَا يَشَاءُ﴾ — بابُ الخلق لم يُغلق؛ والقدرةُ ضمانتُها: فلا يُحصر الوجود فيما تعرفه من مخلوقاتٍ وصفات.","adds":"لا تحصر إمكان الله في المعلوم لك: ﴿يَزِيدُ فِي الْخَلْقِ مَا يَشَاءُ﴾."},{"i":26,"of":35,"s":41,"surah":"فصلت","a":39,"text":"وَمِنْ آيَاتِهِ أَنَّكَ تَرَى الْأَرْضَ خَاشِعَةً فَإِذَا أَنْزَلْنَا عَلَيْهَا الْمَاءَ اهْتَزَّتْ وَرَبَتْ إِنَّ الَّذِي أَحْيَاهَا لَمُحْيِي الْمَوْتَى إِنَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":38,"text":"فَإِنِ اسْتَكْبَرُوا فَالَّذِينَ عِنْدَ رَبِّكَ يُسَبِّحُونَ لَهُ بِاللَّيْلِ وَالنَّهَارِ وَهُمْ لَا يَسْأَمُونَ"},"next":{"a":40,"text":"إِنَّ الَّذِينَ يُلْحِدُونَ فِي آيَاتِنَا لَا يَخْفَوْنَ عَلَيْنَا أَفَمَنْ يُلْقَى فِي النَّارِ خَيْرٌ أَمْ مَنْ يَأْتِي آمِنًا يَوْمَ الْقِيَامَةِ اعْمَلُوا مَا شِئْتُمْ إِنَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ"},"reason":"وُصفت الأرض قبل المطر بـ«خاشعة» — ذليلةً هامدة — ثم ﴿اهْتَزَّتْ وَرَبَتْ﴾: حركةٌ وانتفاخٌ بالحياة؛ فالقياسُ صريح: محيي الأرض محيي الموتى، والضمانةُ القدرة.","adds":"وصفُ القلب القاسي كوصف الأرض: «خاشعة» تحتاج ماءً — واسأل محييَ الأرض أن يحييه."},{"i":27,"of":35,"s":42,"surah":"الشورى","a":9,"text":"أَمِ اتَّخَذُوا مِنْ دُونِهِ أَوْلِيَاءَ فَاللَّهُ هُوَ الْوَلِيُّ وَهُوَ يُحْيِي الْمَوْتَى وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":8,"text":"وَلَوْ شَاءَ اللَّهُ لَجَعَلَهُمْ أُمَّةً وَاحِدَةً وَلَكِنْ يُدْخِلُ مَنْ يَشَاءُ فِي رَحْمَتِهِ وَالظَّالِمُونَ مَا لَهُمْ مِنْ وَلِيٍّ وَلَا نَصِيرٍ"},"next":{"a":10,"text":"وَمَا اخْتَلَفْتُمْ فِيهِ مِنْ شَيْءٍ فَحُكْمُهُ إِلَى اللَّهِ ذَلِكُمُ اللَّهُ رَبِّي عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ أُنِيبُ"},"reason":"معيارُ الولي في وصفين: يحيي الموتى وعلى كل شيء قدير — فمن لا يقدر على إحياء نفسه كيف يُتخذ وليًّا؟ فالقدرةُ شرطُ الولاية، والحصرُ بضمير الفصل: ﴿فَاللَّهُ هُوَ الْوَلِيُّ﴾.","adds":"اختبر كل وليٍّ بسؤالين: أيحيي الموتى؟ أعلى كل شيءٍ قدير؟ — تسقط كل الدعاوى."},{"i":28,"of":35,"s":46,"surah":"الأحقاف","a":33,"text":"أَوَلَمْ يَرَوْا أَنَّ اللَّهَ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ وَلَمْ يَعْيَ بِخَلْقِهِنَّ بِقَادِرٍ عَلَى أَنْ يُحْيِيَ الْمَوْتَى بَلَى إِنَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":32,"text":"وَمَنْ لَا يُجِبْ دَاعِيَ اللَّهِ فَلَيْسَ بِمُعْجِزٍ فِي الْأَرْضِ وَلَيْسَ لَهُ مِنْ دُونِهِ أَوْلِيَاءُ أُولَئِكَ فِي ضَلَالٍ مُبِينٍ"},"next":{"a":34,"text":"وَيَوْمَ يُعْرَضُ الَّذِينَ كَفَرُوا عَلَى النَّارِ أَلَيْسَ هَذَا بِالْحَقِّ قَالُوا بَلَى وَرَبِّنَا قَالَ فَذُوقُوا الْعَذَابَ بِمَا كُنْتُمْ تَكْفُرُونَ"},"reason":"نفيُ الإعياء صريحًا: ﴿وَلَمْ يَعْيَ بِخَلْقِهِنَّ﴾ — لم يتعب من خلق السماوات والأرض؛ فالقياسُ من باب الأولى: من لم يعيَ بالأعظم لا يعجزه الأصغر. ثم الجواب المؤكد: ﴿بَلَى﴾.","adds":"نفيُ التعب عن الله ردٌّ على ما نُسب إليه في كتبٍ أخرى — والقرآن يصرّح: و﴿لَمْ يَعْيَ﴾."},{"i":29,"of":35,"s":48,"surah":"الفتح","a":21,"text":"وَأُخْرَى لَمْ تَقْدِرُوا عَلَيْهَا قَدْ أَحَاطَ اللَّهُ بِهَا وَكَانَ اللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرًا","prev":{"a":20,"text":"وَعَدَكُمُ اللَّهُ مَغَانِمَ كَثِيرَةً تَأْخُذُونَهَا فَعَجَّلَ لَكُمْ هَذِهِ وَكَفَّ أَيْدِيَ النَّاسِ عَنْكُمْ وَلِتَكُونَ آيَةً لِلْمُؤْمِنِينَ وَيَهْدِيَكُمْ صِرَاطًا مُسْتَقِيمًا"},"next":{"a":22,"text":"وَلَوْ قَاتَلَكُمُ الَّذِينَ كَفَرُوا لَوَلَّوُا الْأَدْبَارَ ثُمَّ لَا يَجِدُونَ وَلِيًّا وَلَا نَصِيرًا"},"context":"في الحديبية: و﴿وَأُخْرَى لَمْ تَقْدِرُوا عَلَيْهَا قَدْ أَحَاطَ اللَّهُ بِهَا وَكَانَ اللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرًا﴾.","reason":"مغانمُ لم تقدروا عليها أحاط الله بها — أي حفظها لكم وهي خارج قدرتكم؛ فالقدرةُ الإلهية تعمل حيث تنتهي قدرتك: ما عجزتَ عنه قد يكون محفوظًا لك في وقته.","adds":"ما عجزتَ عنه لم يخرج من دائرة العطاء: و﴿قَدْ أَحَاطَ اللَّهُ بِهَا﴾ — محفوظٌ لوقته."},{"i":30,"of":35,"s":57,"surah":"الحديد","a":2,"text":"لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ يُحْيِي وَيُمِيتُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":1,"text":"سَبَّحَ لِلَّهِ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ وَهُوَ الْعَزِيزُ الْحَكِيمُ"},"next":{"a":3,"text":"هُوَ الْأَوَّلُ وَالْآخِرُ وَالظَّاهِرُ وَالْبَاطِنُ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ"},"context":"﴿لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ يُحْيِي وَيُمِيتُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — فاتحة الحديد.","reason":"جُمع الملكُ والإحياءُ والإماتةُ والقدرة في آيةٍ واحدة صدر السورة: فالسورةُ التي ستأمر بالإنفاق والسبق تفتتح بأن المال والأرواح كلها ملكُه — فالإنفاقُ من ملكه لا من ملكك.","adds":"قبل أن تُدعى للإنفاق ذُكّرت بمالك المال: و﴿لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ﴾."},{"i":31,"of":35,"s":59,"surah":"الحشر","a":6,"text":"وَمَا أَفَاءَ اللَّهُ عَلَى رَسُولِهِ مِنْهُمْ فَمَا أَوْجَفْتُمْ عَلَيْهِ مِنْ خَيْلٍ وَلَا رِكَابٍ وَلَكِنَّ اللَّهَ يُسَلِّطُ رُسُلَهُ عَلَى مَنْ يَشَاءُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":5,"text":"مَا قَطَعْتُمْ مِنْ لِينَةٍ أَوْ تَرَكْتُمُوهَا قَائِمَةً عَلَى أُصُولِهَا فَبِإِذْنِ اللَّهِ وَلِيُخْزِيَ الْفَاسِقِينَ"},"next":{"a":7,"text":"مَا أَفَاءَ اللَّهُ عَلَى رَسُولِهِ مِنْ أَهْلِ الْقُرَى فَلِلَّهِ وَلِلرَّسُولِ وَلِذِي الْقُرْبَى وَالْيَتَامَى وَالْمَسَاكِينِ وَابْنِ السَّبِيلِ كَيْ لَا يَكُونَ دُولَةً بَيْنَ الْأَغْنِيَاءِ مِنْكُمْ وَمَا آتَاكُمُ الرَّسُولُ فَخُذُوهُ وَمَا نَهَاكُمْ عَنْهُ فَانْتَهُوا وَاتَّقُوا اللَّهَ إِنَّ اللَّهَ شَدِيدُ الْعِقَابِ"},"context":"في فيء بني النضير: ﴿وَمَا أَفَاءَ اللَّهُ عَلَى رَسُولِهِ مِنْهُمْ فَمَا أَوْجَفْتُمْ عَلَيْهِ مِنْ خَيْلٍ وَلَا رِكَابٍ وَلَكِنَّ اللَّهَ يُسَلِّطُ رُسُلَهُ عَلَى مَنْ يَشَاءُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾.","reason":"مالٌ جاء بلا قتالٍ ولا إيجاف خيل — فنُسب إلى القدرة لا إلى الجهد: و﴿يُسَلِّطُ رُسُلَهُ عَلَى مَنْ يَشَاءُ﴾؛ ولذلك اختصّ بحكمٍ مختلف عن الغنيمة.","adds":"بعض ما يأتيك لا جهدَ لك فيه — فلا تنسبه لذكائك: و﴿فَمَا أَوْجَفْتُمْ عَلَيْهِ مِنْ خَيْلٍ وَلَا رِكَابٍ﴾."},{"i":32,"of":35,"s":64,"surah":"التغابن","a":1,"text":"يُسَبِّحُ لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","next":{"a":2,"text":"هُوَ الَّذِي خَلَقَكُمْ فَمِنْكُمْ كَافِرٌ وَمِنْكُمْ مُؤْمِنٌ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ"},"context":"﴿يُسَبِّحُ لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — فاتحة التغابن.","reason":"ثلاثيةٌ في صدر السورة: الملك والحمد والقدرة — مع تسبيح الكون؛ فالسورةُ التي ستتحدث عن فتنة الأهل والمال تفتتح بأن الملك له والحمد له والقدرة له.","adds":"اجمع الثلاثة في ذكرك: ﴿لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — ملكٌ وحمدٌ وقدرة، مع تسبيح ما في السماوات والأرض."},{"i":33,"of":35,"s":65,"surah":"الطلاق","a":12,"text":"اللَّهُ الَّذِي خَلَقَ سَبْعَ سَمَاوَاتٍ وَمِنَ الْأَرْضِ مِثْلَهُنَّ يَتَنَزَّلُ الْأَمْرُ بَيْنَهُنَّ لِتَعْلَمُوا أَنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ وَأَنَّ اللَّهَ قَدْ أَحَاطَ بِكُلِّ شَيْءٍ عِلْمًا","prev":{"a":11,"text":"رَسُولًا يَتْلُو عَلَيْكُمْ آيَاتِ اللَّهِ مُبَيِّنَاتٍ لِيُخْرِجَ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ مِنَ الظُّلُمَاتِ إِلَى النُّورِ وَمَنْ يُؤْمِنْ بِاللَّهِ وَيَعْمَلْ صَالِحًا يُدْخِلْهُ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا أَبَدًا قَدْ أَحْسَنَ اللَّهُ لَهُ رِزْقًا"},"context":"﴿اللَّهُ الَّذِي خَلَقَ سَبْعَ سَمَاوَاتٍ وَمِنَ الْأَرْضِ مِثْلَهُنَّ يَتَنَزَّلُ الْأَمْرُ بَيْنَهُنَّ لِتَعْلَمُوا أَنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ وَأَنَّ اللَّهَ قَدْ أَحَاطَ بِكُلِّ شَيْءٍ عِلْمًا﴾ — خاتمة الطلاق.","reason":"صُرّحت الغايةُ من عرض خلق السماوات والأرض: و﴿لِتَعْلَمُوا﴾ — فالتفكرُ الكوني مقصودُه معرفةُ القدرة والعلم؛ وموضعُها خاتمةَ سورة الطلاق: فمن ضاق بأزمةٍ أسرية يُذكَّر بسعة القدرة.","adds":"عجيبٌ موضعها: خاتمةُ سورة الطلاق — فمن انهار عالمُه الصغير يُذكَّر بمن يملك سبع سماوات."},{"i":34,"of":35,"s":66,"surah":"التحريم","a":8,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا تُوبُوا إِلَى اللَّهِ تَوْبَةً نَصُوحًا عَسَى رَبُّكُمْ أَنْ يُكَفِّرَ عَنْكُمْ سَيِّئَاتِكُمْ وَيُدْخِلَكُمْ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ يَوْمَ لَا يُخْزِي اللَّهُ النَّبِيَّ وَالَّذِينَ آمَنُوا مَعَهُ نُورُهُمْ يَسْعَى بَيْنَ أَيْدِيهِمْ وَبِأَيْمَانِهِمْ يَقُولُونَ رَبَّنَا أَتْمِمْ لَنَا نُورَنَا وَاغْفِرْ لَنَا إِنَّكَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":7,"text":"يَا أَيُّهَا الَّذِينَ كَفَرُوا لَا تَعْتَذِرُوا الْيَوْمَ إِنَّمَا تُجْزَوْنَ مَا كُنْتُمْ تَعْمَلُونَ"},"next":{"a":9,"text":"يَا أَيُّهَا النَّبِيُّ جَاهِدِ الْكُفَّارَ وَالْمُنَافِقِينَ وَاغْلُظْ عَلَيْهِمْ وَمَأْوَاهُمْ جَهَنَّمُ وَبِئْسَ الْمَصِيرُ"},"context":"﴿يَا أَيُّهَا الَّذِينَ آمَنُوا تُوبُوا إِلَى اللَّهِ تَوْبَةً نَصُوحًا... يَوْمَ لَا يُخْزِي اللَّهُ النَّبِيَّ وَالَّذِينَ آمَنُوا مَعَهُ نُورُهُمْ يَسْعَى بَيْنَ أَيْدِيهِمْ... رَبَّنَا أَتْمِمْ لَنَا نُورَنَا وَاغْفِرْ لَنَا إِنَّكَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾.","reason":"دعاءٌ في أحرج لحظة: نورٌ يسعى ويُخشى انطفاؤه — فيُسأل إتمامُه بالقدرة: و﴿إِنَّكَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾؛ فطلبُ تمام النور معلَّقٌ على القدرة لا على العمل وحده.","adds":"احفظ الدعاء: و﴿رَبَّنَا أَتْمِمْ لَنَا نُورَنَا وَاغْفِرْ لَنَا إِنَّكَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — لحظةَ يُخشى انطفاء النور."},{"i":35,"of":35,"s":67,"surah":"الملك","a":1,"text":"تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","next":{"a":2,"text":"الَّذِي خَلَقَ الْمَوْتَ وَالْحَيَاةَ لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ عَمَلًا وَهُوَ الْعَزِيزُ الْغَفُورُ"},"context":"﴿تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — فاتحة الملك.","reason":"افتُتحت سورةُ الملك ببركةٍ وملكٍ وقدرة — ثم الغاية: ﴿لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ عَمَلًا﴾؛ فالقدرةُ التي تخلق الموت والحياة هي التي تحاسب على الإحسان.","adds":"الملك والقدرة كلاهما في يده: فما في يدك منهما عارية، وما تُحاسب عليه هو إحسانك فيه."}],"hadiths":[{"i":1,"of":25,"text":"«كان النَّبيُّ صلَّى اللهُ عليه وسلَّم إذا قَفَلَ مِنَ الحَجِّ أوِ العُمرةِ -ولا أعلَمُه إلَّا قال: الغَزوِ- يقولُ كُلَّما أوفى على ثَنيَّةٍ أو فدفَدٍ: كَبَّرَ ثَلاثًا، ثُمَّ قال: لا إلَهَ إلَّا اللهُ، وحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كُلِّ شيءٍ قديرٌ، آيِبونَ تائِبونَ عابِدونَ ساجِدونَ لرَبِّنا حامِدونَ، صَدَقَ اللهُ وعدَه، ونَصَرَ عَبدَه، وهَزَمَ الأحزابَ وحدَه. قال صالِحٌ: فقُلتُ له: ألَم يَقُلْ عبدُ اللهِ: إن شاءَ اللهُ؟ قال: لا.»","narrator":"عبدالله بن عمر","source":"صحيح البخاري (2995)","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/HMdMiBID","nameForm":"على كُلِّ شيءٍ قديرٌ","scene":"قال ابن عمر: كان النبي ﷺ إذا قفل من الحج أو العمرة أو الغزو يقول كلما أوفى على ثنية أو فدفد: كبّر ثلاثًا ثم قال: «لا إله إلا الله وحده لا شريك له، له الملك وله الحمد، وهو على كل شيء قدير، آيبون تائبون عابدون ساجدون لربنا حامدون، صدق الله وعده ونصر عبده وهزم الأحزاب وحده».","reason":"ذكر القفول يقر بالقدرة الشاملة ثم يذكر إنجازها: صدق الوعد ونصر العبد وهزيمة الأحزاب؛ فالقدرة التي هزمت الأحزاب هي التي ردت المسافر سالمًا، والاسم في ذكر العودة يربط السلامة بالقدرة.","adds":"ذكر العودة من السفر يقر بالقدرة التي هزمت الأحزاب."},{"i":2,"of":25,"text":"قال جابرٌ رضيَ اللهُ تعالَى عنهُ : إنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّم مكث [ بالمدينةِ ] تسعَ سنين لم يحجَّ . ثم أذَّنَ في الناسِ في العاشرةِ : أنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّم حاجٌّ [ هذا العامَ ] . فقدم المدينةَ بشرٌ كثيرٌ ( وفي روايةٍ : فلم يبق أحدٌ يقدرُ أن يأتيَ راكبًا أو راجلًا إلا قَدِمَ ) [ فتدارك الناسُ ليخرجوا معهُ ] كلُّهم يلتمسُ أن يَأْتَمَّ برسولِ اللهِ صلَّى اللهُ عليهِ وسلَّم ويعملَ مثلَ عملِه . [ وقال جابرٌ رضيَ اللهُ عنهُ : سمعتُ – قال الراوي : أحسبُه رُفِعَ إلى النبيِّ صلَّى اللهُ عليهِ وسلَّم ، ( وفي روايةٍ قال : خطَبَنا رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم ) فقال : مَهِلُّ أهلِ المدينةِ من ذي الحليفةِ ، و [ مَهِلُّ أهلِ ] الطريقِ الآخرِ الجحفةُ ، ومَهِلُّ أهلِ العراقِ من ذاتِ عرقٍ ومَهِلُّ أهلِ نجدٍ من قرنٍ ، ومَهِلُّ أهلِ اليمنِ من يلملمَ ] . [ قال فخرج رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم ] [ لخمسٍ بَقَيْنَ من ذي القعدةِ أو أربعٍ ] . [ وساق هديًا ] . فخرجنا معه [ معنا النساءُ والولدانُ ] . حتى أتينا ذا الحليفَةَ فولدتْ أسماءُ بنتُ عميسٍ محمدَ بنَ أبي بكرٍ . فأرسلت إلى رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّم : كيف أصنعُ ؟ [ ف ] قال : اغتَسِلي واستثفري بثوبٍ وأحْرِمي . فصلى رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم في المسجدِ [ وهو صامتٌ ] . ثم ركب القصواءَ حتى إذا استوت به ناقتُه على البيداءِ [ أهلَّ بالحجِّ ( وفي روايةٍ : أفرد الحجَّ ) هو وأصحابُه ] . [ قال جابرٌ ] : فنظرتُ إلى مَدِّ بصري [ من ] بين يديهِ من راكبٍ وماشٍ ، وعن يمينِه مثلَ ذلك ، وعن يسارِه مثلَ ذلك ، ومن خلفِه مثلَ ذلك ، ورسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم بين أَظْهُرِنا وعليه ينزلُ القرآنُ ، وهو يعرفُ تأويلَه ، وما عمل بهِ من شيٍء عمِلْنا به . فأَهَلَّ بالتوحيدِ : لبيكَ اللهمَّ لبيكَ ، لبيكَ لا شريكَ لك لبيكَ ، إنَّ الحمدَ والنعمةَ لك والمُلْكُ ، لا شريكَ لك . وأهلُ الناسِ بهذا الذي يُهِلُّونَ به ، ( وفي روايةٍ : ولبَّى الناسُ [ والناسُ يزيدون ] [ لبيكَ ذا المعارجِ لبيكَ ذا الفواصلِ ] فلم يَرُدَّ رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم عليهم شيئًا منه . ولزم رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم تلبِيَتَه . قال جابرٌ : [ ونحنُ نقولُ [ لبيكَ اللهمَّ ] لبيكَ بالحجِّ ] [ نصرخُ صراخًا ] لسنا ننوي إلا الحجَّ [ مفردًا ] [ لا نخلطُه بعمرةٍ ] ( وفي روايةٍ : لسنا نعرفُ العمرةَ ) وفي أخرى : أَهْلَلْنَا أصحابَ النبيِّ صلَّى اللهُ عليهِ وسلَّم بالحجِّ خالصًا ليس معهُ غيرُه ، خالصًا وحدَه ) [ قال : وأقبلت عائشةُ بعمرةٍ حتى إذا كانت ب ( ( سَرَفَ ) ) عركتْ ] . حتى إذا أتينا البيتَ معَهُ [ صُبْحَ رابعةٍ مضتْ من ذي الحجةِ ] ( وفي روايةٍ : دخلنا مكةَ عند ارتفاعِ الضحى ) فأتى النبيُّ صلَّى اللهُ عليهِ وسلَّم بابَ المسجدِ فأناخ راحلتَه ثم دخل المسجدَ ، ف ) استلمَ الركنَ ( وفي روايةٍ : الحجرَ الأسودَ ) [ ثم مضى عن يمينِه ] . فرَمَلَ [ حتى عاد إليهِ ] ثلاثًا ، ومشى أربعًا [ على هينتِه ] . ثم نفذ إلى مقامِ إبراهيمَ عليه السلامُ فقرأ ( وَاتَّخِذُوْا مِنْ مَقَامِ إِبْرَاهِيمَ مُصَلَّى ) ، [ ورفع صوتَه يُسْمِعُ الناسَ ] . فجعل المقامَ بينَه وبين البيتِ . [ فصلى ركعتينِ ] . [ قال ] : فكان يقرأُ في الركعتينِ : ( قُلْ هُوَ اللهُ أَحَدٌ ) و ( قُلْ يَا أَيُّهَا الْكَافِرُونَ ) ( وفي روايةٍ : قُلْ يَا أَيُّهَا الْكَافِرُونَ و قُلْ هُوَ اللهُ أَحَدٌ ) . [ ثم ذهب إلى زمزمَ فشرب منها ، وصبَّ على رأسِه ] . ثم رجع إلى الركنِ فاستلمَه . ثم خرج من البابِ ( وفي روايةٍ : بابِ الصفا ) إلى الصفا . فلما دنا من الصفا قرأ : ( إِنَّ الصَّفَا وَالْمَرْوَةَ مِنْ شَعَائِرِ اللَّهِ ) أبدأُ ( وفي روايةٍ : نبدأُ ) بما بدأ اللهُ به ، فبدأَ بالصفا فرقى عليهِ حتى رأى البيتَ . فاستقبل القِبلةَ فوحَّدَ اللهَ وكبَّرَه [ ثلاثًا ] و [ حمدَه ] وقال : لا إلهَ إلا اللهُ وحدَه لا شريكَ لهُ ، له المُلْكُ وله الحمدُ [ يُحْيِي ويُمِيتُ ] ، وهو على كلِّ شيٍء قديرٌ ، لا إلهَ إلا اللهُ وحدَه [ لا شريكَ له ] ، أنجزَ وعدَه ، ونصر عبدَه ، وهزم الأحزابَ وحدَه ، ثم دعا بين ذلك ، وقال مثلَ هذا ثلاثَ مراتٍ . ثم نزل [ ماشيًا ] إلى المروةِ ، حتى إذا انصبَّتْ قدماهُ في بطنِ الوادي سعى ، حتى إذا صعَدْنا [ يعني ] [ الشِّقَّ الآخرَ ] مشى حتى أتى المروةَ [ فرقى عليها حتى نظرَ إلى البيتِ ] ففعل على المروةِ كما فعل على الصفا . حتى إذا كان آخرَ طوافِه ( وفي روايةٍ : كان السابعَ ) على المروةِ فقال : [ يا أيها الناسُ ] لو أني استقبلتُ من أمري ما استدبرتُ لم أَسُقِ الهَدْيَ و [ ل ] جعلتُها عمرةً ، فمن كان منكم معَهُ هَدْيٌ فليُحِلَّ وليجعَلْها عمرةً ، ( وفي روايةٍ : فقال : أحِلُّوا من إحرامِكم ، فطوفوا بالبيتِ ، وبين الصفا والمروةِ وقصرُوا ، وأقيموا حلالًا . حتى إذا كان يومَ الترويةِ فأهِلُّوا بالحجِّ واجعلوا التي قدِمْتُمْ بها متعةً ) . فقام سراقةُ بنُ مالكِ بنُ جعشمٍ ( وهو في أسفلِ المروةَ ) فقال : يا رسولَ اللهِ [ أرأيتَ عُمْرَتَنا ( وفي لفظٍ : مُتْعَتَنا ) هذه ] [أ]لعامِنا هذا أم لأبدِ [ الأبدِ ] ؟ [ قال ] فشبَّك رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم أصابعَه واحدةً في أخرى وقال : دخلتِ العمرةُ في الحجِّ [ إلى يومِ القيامةِ ] لا بل لأبدِ الأبدِ ، [ لا بل لأبدِ الأبدِ ] ، [ ثلاثَ مراتٍ ] . [ قال : يا رسولَ اللهِ بيِّنْ لنا دِينَنا كأنَّا خُلِقْنا الآن ، فيما العملُ اليومَ ؟ أفيما جفَّت به الأقلامُ وجرَتْ به المقاديرُ أفيما نستقبلُ ؟ قال : لا بل فيما جفَّتْ به الأقلامُ وجرَتْ به المقاديرُ . قال : ففيم العملُ [ إذن ] ؟ قال : اعملوا فكلٌّ مُيَسَّرٌ ] ، ( لِمَا خُلِقَ له ] . ( قال جابرٌ : فأُمِرْنَا إذا حَلَلْنَا أن نُهْدِيَ ، ويجتمعُ النفرُ منا في الهديةِ ] [ كلُّ سبعةٍ منا في بدنةٍ ] [ فمن لم يكن معَه هديٌ ، فليصم ثلاثةَ أيامٍ وسبعةً إذا رجع إلى أهلِه ] . [ قال : فقلنا : حَلَّ ماذا ؟ قال : الحِلُّ كلُّه ] . [ قال : فكبُرَ ذلك علينا ، وضاقت به صدُورُنا ] . [ قال : فخرجنا إلى البطحاءِ ، قال : فجعل الرجلُ يقول : عهدي بأهلي اليومَ ] . [ قال : فتذاكَرْنا بيننا فقلنا : خرجنا حُجَّاجًا لا نُرِيدُ إلا الحجَّ ، ولا ننوي غيرَه ، حتى إذا لم يكن بيننا وبين عرفةَ إلا أربعٌ ] ( وفي روايةٍ : خمسَ [ ليالٍ ] أمرنا أن نُفْضِي إلى نسائِنا فنأتيَ عرفةَ تقطرُ مذاكيرُنا المنيَّ [ من النساءِ ] ، قال : يقولُ جابرٌ بيدِه ، ( قال الرواي ) : كأني أنظرُ إلى قولِه بيدِه يُحرِّكُها ، [ قالوا : كيف نجعلُها متعةً وقد سمَّيْنا الحجَّ ؟ ] . قال : [ فبلغ ذلك النبيَّ صلَّى اللهُ عليهِ وسلَّم فما ندري أشيٌء بلغَه من السماءِ . أم شيءٌ بلغَه من قِبَلِ السماءِ ] . [ فقام ] [ فخطب الناسَ فحمد اللهَ وأثنى عليهِ ] فقال : [ أباللهِ تُعلموني أيها الناسُ ! ؟ ] قد علمتُم أني أتقاكُم للهِ وأصدَقُكم وأبرُّكم ، [ افعلوا ما آمُرُكم به فإني ] لولا هَدْيِي لحللتُ لكم كما تُحِلُّونَ [ ولكن لا يحلُّ مني حرامٌ حتى يبلغَ الهَدْيُ مَحِلَّهُ ] ولو استقبلتُ من أمري ما استدبرتُ لم أَسُقِ الهَدْيَ ، فحُلُّوا ] . [ قال : فواقعنا النساءَ وتطيَّبْنَا بالطِّيبِ ولبسنا ثيابَنا ] [ وسمِعْنا وأطعنا ] . فحلَّ الناسُ كلُّهم وقصَّرُوا إلا النبيَّ صلَّى اللهُ عليهِ وسلَّم ومن كان معه هديٌ ] . [ قال : وليس مع أحدٍ منهم هديٌ غيرَ النبيِّ صلَّى اللهُ عليهِ وسلَّم وطلحةَ ] . وقدم علي [ من سعايَتِه ] من اليمنِ ببدنِ النبيِّ ص . فوجد فاطمةَ رضيَ اللهُ عنها ممن حلَّ : [ ترجَّلَتْ ] ولبست ثيابًا صبيغًا واكتحلتْ ، فأنكرَ ذلك عليها ، [ وقال : من أمرَكِ بهذا ؟ ! ] ، فقالت أبي أمرَنِي بهذا . قال : فكان عليٌّ يقول بالعراقِ : فذهبتُ إلى رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّم محرشًا على فاطمةَ للذي صنعتْ مستفتيًا لرسولِ اللهِ صلَّى اللهُ عليهِ وسلَّم فيما ذكرتُ عنه ، فأخبرتُه أني أنكرتُ ذلك عليها [ فقالت : أبي أمرَني بهذا ] فقال : صدقتْ ، صدقتْ ، [ صدقتْ ] [ أنا أمرتُها به ] . قال جابرٌ : وقال لعليٍّ : ماذا قلتَ حين فُرِضَ الحجُّ ؟ قال قلتُ : اللهمَّ إني أُهِلُّ بما    أهلَّ به رسولُ اللهِ ص . قال : فإنَّ معيَ الهديَ فلا تحلُّ ، [ وامكث حرامًا كما أنت ] . قال : فكان جماعةُ الهديِ الذي قدم به عليٌّ من اليمنِ ، والذي أتى به النبيُّ صلَّى اللهُ عليهِ وسلَّم [ من المدينةِ ] مائةَ [ بدنةٍ ] . قال : فحلَّ الناسُ كلُّهم وقصرُوا ، إلا النبيَّ صلَّى اللهُ عليهِ وسلَّم ومن كان معه هديٌ . فلما كان يومُ الترويةِ [ وجعلنا مكةَ بظهرٍ ] توجهوا إلى مِنى فأهِلُّوا بالحجِّ [ من البطحاءِ ] . [ قال : ثم دخل رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم على عائشةَ رضيَ اللهُ عنها فوجدها تبكي فقال : ما شأنُكِ ؟ قالت : شأني أني قد حِضْتُ ، وقد حلَّ الناسُ ولم أحلُلْ ، ولم أَطُفْ بالبيتِ ، والناسُ يذهبون إلى الحجِّ الآن ، فقال : إنَّ هذا أمرٌ كتبَه اللهُ على بناتِ آدمَ ، فاغتسلي ثم أهِلِّي بالحجِّ [ ثم حُجِّي واصنعي ما يصنعُ الحاجُّ غيرَ أن لا تطوفي بالبيتِ ولا تصلي ] ففعلتْ ] . ( وفي روايةٍ : فنسكتِ المناسكَ كلَّها غيرَ أنها لم تَطُفْ بالبيتِ ) وركب رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم وصلى بها ( يعني مِنَى ، وفي روايةٍ : بنا ) الظهرَ والعصرَ والمغربِ والعشاءِ والفجرِ . ثم مكث قليلًا حتى طلعتِ الشمسُ وأمر بقُبَّةٍ [ له ] من شعرٍ تُضْرَبُ له بنَمِرَةَ . فسار رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم ولا تشكُّ قريشٌ إلا أنَّهُ واقفٌ عند المشعرِ الحرامِ [ بالمزدلفةِ ] [ ويكونُ منزلُه ثم ] كما كانت قريشٌ تصنعُ في الجاهليةِ – فأجاز رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم حتى أتى عرفةَ فوجد القُبَّةَ قد ضُرِبَتْ له بنَمِرَةَ ، فنزل بها . حتى إذا زاغتِ الشمسُ أمر بالقصواءِ فرُحِّلَتْ له ، ف [ ركب حتى ] أتى بطنَ الوادي . فخطب الناسَ وقال : إنَّ دماءَكم وأموالَكم حرامٌ عليكم ، كحُرْمَةِ يومِكم هذا ، في شهرِكم هذا ، في بلدِكم هذا ، ألا [ و ] [ إنَّ ] كلَّ شيٍء من أمرِ الجاهليةِ تحت قدمي [ هاتين ] موضوعٌ ، ودماءُ الجاهليةِ موضوعةٌ ، وإنَّ أولَ دمٍ أضعُ من دمائِنا دمَ ابنِ ربيعةَ بنِ الحارثِ [ ابنِ عبدِ المطلبِ ] – كان مسترضعًا في بني سعدٍ فقتَلَتْه هذيلٌ - . وربا الجاهليةِ موضوعٌ ، وأولُ ربًا أضعُ رِبَانَا : ربا العباسِ بنِ عبدِ المطلبِ فإنَّهُ موضوعٌ كلُّه فاتّقوا اللهَ في النساءِ ، فإنكم أخذتموهنَّ بأمانِ [ ة ] اللهِ واستحللتُم فروجهنَّ بكلمةِ اللهِ و [ إنَّ ] لكم عليهنَّ أن لا يُوطِئْنَ فُرُشَكُمْ أحدًا تكرهونَه ، فإن فعلْنَ ذلك فاضربوهنَّ ضربًا غيرَ مبرِّحٍ ولهنَّ عليكم رزقُهُنَّ وكسوتُهُنَّ بالمعروفِ ، و [ إني ] قد تركتُ فيكم ما لن تضلُّوا بعدُ إن اعتصمتُم به كتابَ اللهِ وأنتم تسألون ( وفي لفظٍ مسؤولونَ ) عني ، فما أنتم قائلون ؟ قالوا : نشهدُ أنك قد بلَّغْتَ [ رسالاتِ ربكَ ] وأدَّيْتَ ، ونصحتَ [ لأُمَّتِكَ ، وقضيتَ الذي عليك ] فقال بأصبعِه السبابةِ يرفعُها إلى السماءِ ويُنْكِتُها إلى الناسِ : اللهمَّ اشهد ، اللهمَّ اشهدْ . ثم أذَّنَ [ بلالٌ ] [ بنداءٍ واحدٍ ] ، ثم أقام فصلى الظهرَ ، ثم أقام فصلى العصرَ ، ولم يُصَلِّ بينهما شيئًا ، ثم ركب رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم [ القصواءَ ] حتى أتى الموقفَ فجعل بطنَ ناقتِه القصواءَ إلى الصخراتِ ، وجعل حبلَ المشاةِ بين يديهِ ، واستقبلَ القِبلةَ . فلم يزل واقفًا حتى غربتِ الشمسُ وذهبت الصُّفرةُ قليلًا حتى غاب القرصُ . [ وقال : وقفتُ ههنا وعرفةُ كلُّها موقفٌ ] . وأردف أسامةَ [ ابنَ زيدٍ ] خلفَه . ودفع رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم ( وفي روايةٍ : أفاض وعليه السكينةُ : ) وقد شنق للقصواءِ الزمامَ ، حتى إنَّ رأسَها ليُصيبُ مورِكَ رَحْلَه ويقول بيدِه اليمنى [ هكذا : وأشار بباطنِ كفِّهِ إلى السماءِ ] أيها الناسُ السكينةُ السكينةُ . كلما أتى حبلًا من الحبالِ أرخى لها قليلًا حتى تصعدَ حتى أتى المزدلفةَ فصلى بها [ فجمع بين ] المغربِ والعشاءِ ، بأذانٍ واحدٍ وإقامتينِ . ولم يُسَبِّحْ بينهما شيئًا . ثم اضطجع رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم حتى طلع الفجرُ وصلى الفجرَ حين تبيَّنَ له الفجرُ ، بأذانٍ وإقامةٍ . ثم ركب القصواءَ حتى أتى المشعرَ الحرامَ [ فرقى عليه ] . فاستقبلَ القِبلةَ ، فدعاه ( وفي لفظٍ : فحمد اللهَ ) وكبَّرَه وهلَّلَه ووحَّدَه . فلم يزل واقفًا حتى أسفرَ جدًّا . ( وقال : وقفتُ ههنا ، والمزدلفةُ كلُّها موقفٌ ) . فدفع [ من جمعٍ ] قبل أن تطلعَ الشمسُ [ وعليه السكينةُ ] . وأردف الفضلَ بنَ عباسٍ – وكان رجلًا حسنَ الشعرِ أبيضَ وسيمًا - ، فلما دفع رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم مرَّتْ به ظُعُنٌ تَجْرِينَ ، فطفق الفضلُ ينظرُ إليهنَّ ، فوضع رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم يدَه على وجهِ الفضلِ ، فحوَّلَ الفضلُ وجهَه إلى الشِّقِّ الآخرِ ، فحوَّلَ رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم يدَه من الشقِّ الآخرِ على وجهِ الفضلِ ، يصرفُ وجهَه من الشقِّ الآخرِ ينظرُ ! حتى أتى بطنَ مُحَسِّرٍ ، فحرك قليلًا [ وقال : عليكم السكينةَ ] . ثم سلك الطريقَ الوسطى التي تخرجُ [ ك ] على الجمرةِ الكبرى [ حتى أتى الجمرةَ التي ] عند الشجرةِ ، فرماها [ ضُحًى ] بسبعِ حصياتٍ ، يُكبِّرُ مع كلِّ حصاةٍ منها ، مثل حصى الخذفِ [ ف ] رمى من بطنِ الوادي [ وهو على راحلتِه [ وهو ] يقول : لِتَأْخُذوا مناسِكَكم ، فإني لا أدري لعلِّي لا أحجُّ بعد حجَّتي هذه ] . [ قال : ورمى بعدَ يومِ النحرِ [ في سائرِ أيامِ التشريقِ ] إذا زالتِ الشمسُ ] . [ ولقيَه سراقةُ وهو يرمي جمرةَ العقبةِ ، فقال : يا رسولَ اللهِ ، ألنا هذه خاصةً ؟ قال : لا ، بل لأبدٍ ] . ثم انصرف إلى المنحرِ فنحر ثلاثًا وستين [ بدنةً ] بيدِه ، ثم أعطى عليًّا فنحر ما غَبَرَ [ يقول : ما بقيَ ] ، وأشرَكَه في هدْيِهِ . ثم أمر من كلِّ بدنةٍ ببضعةٍ فجُعِلَتْ في قِدْرٍ فطُبِخَتْ فأكلا من لحمِها ، وشربا من مَرَقِها . ( وفي روايةٍ قال : نحر رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم عن نسائِه بقرةً ) . ( وفي أخرى قال : فنحرنا البعيرَ ( وفي أخرى : نحر البعيرَ ) عن سبعةٍ ، والبقرةَ عن سبعةٍ ) ( وفي روايةٍ خامسةٍ عنه قال : فاشتركنا في الجزورِ سبعةً ، فقال له رجلٌ : أرأيتَ البقرةَ أيُشْتَرَكُ فيها ؟ فقال ما هيَ إلا من البُدْنِ ) ( وفي روايةٍ : قال جابرٌ : كنا لا نأكلُ من البُدْنِ إلا ثلاثَ مِنًى ، فأرخص لنا رسولُ اللهِ ص ، قال : كُلُوا وتزوَّدُوا ) . قال : فأكلنا وتزوَّدْنا ] ، [ حتى بَلَغْنَا بها المدينةَ ] ( وفي روايةٍ : نحر رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم [ فحلق ] ، وجلس [ بمنى يومَ النحرِ ] للناسِ ، فما سُئِلَ [ يومئذٍ ] عن شيٍء [ قُدِّمَ قبلَ شيٍء ] إلا قال : لا حرجَ ، لا حرجَ . حتى جاءَه رجلٌ فقال : حلقتُ قبلَ أن أنحرَ ؟ قال : لا حرجَ . ثم جاء آخرُ فقال : حلقتُ قبل أن أرمي ؟ قال : لا حرجَ . [ ثم جاءَه آخرُ فقال : طُفْتُ قبل أن أرمي ؟ قال لا حرج ] . [ قال آخرُ : طُفْتُ قبل أن أذبحَ ، قال : اذبح ولا حرجَ ] . [ ثم جاءَه آخرُ فقال : إني نحرتُ قبل أن أرميَ ؟ قال : [ ارْمِ و ] لا حرج ] . ثم قال نبيُّ اللهِ ص : قد نحرتُ ههنا ، ومِنَى كلُّها منحرٌ . [ وكلُّ فِجاجِ مكةَ طريقٌ ومنحرٌ ] . [ فانحروا من رِحالِكُم ] . [ وقال جابرٌ رضيَ اللهُ عنه : خَطَبَنا صلَّى اللهُ عليهِ وسلَّم يومَ النحرِ فقال : أيُّ يومٍ أعظمُ حُرْمةً ؟ فقالوا : يومُنا هذا ، قال : فأيُّ شهرٍ أعظمُ حُرْمَةً ؟ قالوا : شهرُنا هذا ، قال : أيُّ بلدٍ أعظمُ حُرْمَةً ؟ قالوا بلدُنا هذا ، قال : فإنَّ دماءَكم وأموالَكم عليكم حرامٌ كحُرْمَةِ يومكم هذا في بلدِكم هذا في شهرِكم هذا ، هل بلَّغْتُ ؟ قالوا : نعم . قال : اللهمَّ اشهدْ ] . ثم ركب رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم فأفاض إلى البيتِ [ فطافوا ولم يطوفوا بين الصفا والمروةِ ] . فصلى بمكةَ الظهرَ . فأتى بني عبدِ المطلبِ [ وهم ] يسقون على زمزمَ فقال : انزعوا بني عبدِ المطلبِ ، فلولا أن يَغْلِبَكُمُ الناسُ على سِقَايَتِكُمْ لنزعتُ معكم ، فناولوهُ دَلْوًا فشرب منهُ . [ وقال جابرٌ رضيَ اللهُ عنهُ : وإنَّ عائشةَ حاضت فنسكتِ المناسكَ كلَّها غيرَ أنها لم تَطُفْ بالبيتِ ] . [ قال : حتى إذا طهرت طافت بالكعبةِ والصفا والمروةِ ، ثم قال : قد حللتِ من حجِّكِ وعمرتِكِ جميعًا ] ، [ قالت : يا رسولَ اللهِ أتنطلقون بحجٍّ وعمرةٍ وأنطلقُ بحجٍّ ؟ ] [ قال : إنَّ لكِ مثلَ ما لهم ] . [ فقالت : إني أجدُ في نفسي أني لم أَطُفْ بالبيتِ حتى حججتُ ] . [ قال : وكان رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم رجلًا سهلًا إذا هويَتِ الشيءَ تابعَها عليه ] [ قال : فاذهب بها يا عبدَ الرحمنِ فأَعْمِرْها من التنعيمِ [ فاعتمرت بعد الحجِّ ] [ ثم أقبلت ] وذلك ليلةَ الحصبةِ ] . [ وقال جابرٌ : طاف رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم بالبيتِ في حجةِ الوداعِ على راحلتِه يستلمُ الحجرَ بمحجَنِه لأن يراهُ الناسُ ، وليُشْرِفَ ، وليسألوهُ ، فإنَّ الناسَ غشُوهُ ] . [ وقال : رفعت امرأةٌ صبيًّا لها إلى رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّم فقالت يا رسولَ اللهِ ألهذا حجٌّ ؟ قال : نعم ، ولكِ أجرٌ ]","narrator":"جابر بن عبدالله","source":"حجة النبي 45","grade":"صحيح","judgment":"مدار رواية جابر على سبعة من ثقات أصحابه الأكابر، و الأصل الذي اعتمدنا عليه إنما هو من صحيح مسلم","url":"https://dorar.net/h/6XJIqDXb","nameForm":"على كُلِّ شيءٍ قديرٌ","scene":"يحكي جابر حجة الوداع: أذّن النبي ﷺ في الناس أنه حاج فقدم بشر كثير، وفي وصف الحجة أنه لما وقف على الصفا قال: «لا إله إلا الله وحده لا شريك له، له الملك وله الحمد، وهو على كل شيء قدير، لا إله إلا الله وحده، أنجز وعده ونصر عبده وهزم الأحزاب وحده» ثلاثًا ودعا بين ذلك.","reason":"على الصفا في أعظم حجة قال النبي ﷺ ذكر القدرة ثلاثًا ودعا بين ذلك؛ فالاسم في نسك الصفا يُقرن بإنجاز الوعد، والمكان الذي سعت فيه هاجر يُذكر فيه القدير الذي أنجز وعده.","adds":"على الصفا يُقر بالقدرة ثلاثًا ويُدعى بين ذلك."},{"i":3,"of":25,"text":"كان ابنُ الزُّبَيرِ يقولُ في دُبُرِ كُلِّ صَلاةٍ حينَ يُسَلِّمُ: لا إلَهَ إلَّا اللهُ وحدَه لا شَريكَ له، له المُلكُ ولَه الحَمدُ وهو على كُلِّ شيءٍ قديرٌ، لا حَولَ ولا قوَّةَ إلَّا باللَّهِ، لا إلَهَ إلَّا اللهُ، ولا نَعبُدُ إلَّا إيَّاه، له النِّعمةُ ولَه الفَضلُ، ولَه الثَّناءُ الحَسَنُ، لا إلَهَ إلَّا اللهُ مُخلِصينَ له الدِّينَ ولو كَرِهَ الكافِرونَ، وقال: كان رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يُهَلِّلُ بهِنَّ دُبُرَ كُلِّ صَلاةٍ. [وفي روايةٍ]: أنَّ عَبدَ اللهِ بنَ الزُّبَيرِ كان يُهَلِّلُ دُبُرَ كُلِّ صَلاةٍ... بمِثلِ حَديثِ ابنِ نُمَيرٍ، وقال في آخِرِه: ثُمَّ يقولُ ابنُ الزُّبَيرِ: كان رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يُهَلِّلُ بهِنَّ دُبُرَ كُلِّ صَلاةٍ. وفي روايةٍ: سَمِعتُ عَبدَ اللهِ بنَ الزُّبَيرِ يَخطُبُ على هذا المِنبَرِ وهو يقولُ: كان رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ إذا سَلَّمَ في دُبُرِ الصَّلاةِ أوِ الصَّلَواتِ، فذَكَرَ بمِثلِ حَديثِ هِشامِ بنِ عُروةَ. وفي روايةٍ: أنَّه سَمِعَ عَبدَ اللهِ بنَ الزُّبَيرِ، وهو يقولُ في إثرِ الصَّلاةِ إذا سَلَّمَ: بمِثلِ حَديثِهما، وقال في آخِرِه: وكان يَذكُرُ ذلك عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم.","narrator":"عبدالله بن الزبير","source":"صحيح مسلم 594","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/zq8ilghZ","nameForm":"على كُلِّ شيءٍ قديرٌ","scene":"ابن الزبير يقول دبر كل صلاة حين يسلّم: «لا إله إلا الله وحده لا شريك له، له الملك وله الحمد، وهو على كل شيء قدير، لا حول ولا قوة إلا بالله…»، ويقول: كان رسول الله ﷺ يهلّل بهن دبر كل صلاة.","reason":"ختام الصلاة تهليلٌ فيه الاسم: بعد أن أدّى العبد ما يقدر عليه يُقرّ بأن القدرة كلها لله، وأن لا حول ولا قوة إلا به.","adds":"تهليلٌ دبر كل صلاة يُقرّ فيه العبد بالقدرة الكاملة."},{"i":4,"of":25,"text":"كانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم إذا أمسى قال: أمسَينا وأمسى المُلكُ للَّهِ، والحَمدُ للَّهِ، لا إلَهَ إلَّا اللهُ وحدَه لا شَريكَ له، اللَّهمَّ إنِّي أسألُكَ مِن خَيرِ هذه اللَّيلةِ، وخَيرِ ما فيها، وأعوذُ بكَ مِن شَرِّها، وشَرِّ ما فيها، اللَّهمَّ إنِّي أعوذُ بكَ مِنَ الكَسَلِ، والهَرَمِ، وسوءِ الكِبَرِ، وفِتنةِ الدُّنيا وعَذابِ القَبرِ. قال الحَسَنُ بنُ عُبَيدِ اللهِ: وزادَني فيه زُبَيدٌ، عن إبراهيمَ بنِ سُوَيدٍ، عن عبدِ الرَّحمَنِ بنِ يَزيدَ، عن عبدِ اللهِ، رَفَعَه، أنَّه قال: لا إلَهَ إلَّا اللهُ وحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ وهو على كُلِّ شيءٍ قديرٌ.","narrator":"عبدالله بن مسعود","source":"صحيح مسلم 2723","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/eIXz2I3h","nameForm":"على كُلِّ شيءٍ قديرٌ","scene":"ابن مسعود: كان النبي ﷺ إذا أمسى قال: «أمسينا وأمسى الملك لله، والحمد لله، لا إله إلا الله وحده لا شريك له، اللهم إني أسألك من خير هذه الليلة وخير ما فيها، وأعوذ بك من شرها وشر ما فيها…»، وفي رواية زبيد زيادة: «له الملك وله الحمد وهو على كل شيء قدير».","reason":"أول المساء والصباح: الملك لله وهو على كل شيء قدير — فالليلة القادمة بقدرته يُسأل خيرها ويُستعاذ من شرها.","adds":"يعطي الاسم ذكر الصباح والمساء."},{"i":5,"of":25,"text":"مَن قال: لا إلَهَ إلَّا اللهُ وحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كُلِّ شيءٍ قديرٌ، في يَومٍ مِائةَ مَرَّةٍ؛ كانَت له عَدلَ عَشرِ رِقابٍ، وكُتِبَت له مِائةُ حَسَنةٍ، ومُحيَت عنه مِائةُ سَيِّئةٍ، وكانَت له حِرزًا مِنَ الشَّيطانِ يَومَه ذلك حتَّى يُمسيَ، ولم يَأتِ أحَدٌ أفضَلَ ممَّا جاءَ به، إلَّا أحَدٌ عَمِلَ أكثَرَ مِن ذلك، ومَن قال: سُبحانَ اللهِ وبحَمدِه في يَومٍ مِائةَ مَرَّةٍ، حُطَّت خَطاياه ولو كانَت مِثلَ زَبَدِ البَحرِ.","narrator":"أبو هريرة","source":"صحيح مسلم 2691","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/nO8HQkLK","nameForm":"على كُلِّ شيءٍ قديرٌ","scene":"أبو هريرة: «من قال: لا إله إلا الله وحده لا شريك له، له الملك وله الحمد، وهو على كل شيء قدير — في يومٍ مائة مرة كانت له عدل عشر رقاب وكُتبت له مائة حسنة ومُحيت عنه مائة سيئة وكانت له حرزًا من الشيطان يومه ذلك حتى يمسي».","reason":"التهليل المختوم بالاسم يعدل عتق الرقاب: الإقرار بالقدرة الكاملة فيه عتقٌ للعبد من عبودية غير الله.","adds":"مائة مرة في اليوم تعدل عشر رقاب، وحرزٌ من الشيطان حتى المساء."},{"i":6,"of":25,"text":"مَن قال إذا أصبَحَ: لا إلهَ إلَّا اللهُ وَحْدَه، لا شريكَ له، له المُلكُ، وله الحَمدُ، وهو على كُلِّ شَيءٍ قَديرٌ، كان له عَدلُ رَقَبةٍ من وَلَدِ إسماعيلَ، وكُتِبَ له عَشرُ حَسَناتٍ، وحُطَّ عنه عَشرُ سيِّئاتٍ، ورُفِعَ له عَشرُ دَرَجاتٍ، وكان في حِرزٍ من الشَّيطانِ حتى يُمسيَ، وإنْ قالها إذا أمْسى كان له مِثلُ ذلك حتى يُصبِحَ.\nقال في حديثِ حمَّادٍ: فرأى رَجُلٌ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فيما يَرى النَّائمُ، فقال: يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، إنَّ أبا عيَّاشٍ يُحدِّثُ عنكَ بكذا وكذا، قال: صَدَقَ أبو عيَّاشٍ.","narrator":"أبو عائش أو أبو عياش الزرقي","source":"تخريج سنن أبي داود 5077","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/kU8TzYBO","nameForm":"على كُلِّ شَيءٍ قَديرٌ","scene":"أبو عياش: «من قال إذا أصبح: لا إله إلا الله وحده لا شريك له، له الملك وله الحمد، وهو على كل شيء قدير، كان له عدل رقبة من ولد إسماعيل، وكُتب له عشر حسنات، وحُطّ عنه عشر سيئات، وكان في حرز من الشيطان حتى يمسي، وإن قالها إذا أمسى كان له مثل ذلك حتى يصبح».","reason":"ذكر الصباح والمساء بالاسم حرزٌ من الشيطان: من أقرّ بالقدرة صباحًا حُفظ بها إلى المساء.","adds":"يعطي الاسم وردًا صباحيًّا محددًا."},{"i":7,"of":25,"text":"«من دخل السُّوقَ، فقال: لا إلهَ إلَّا اللهُ وَحْدَه لا شَريكَ له، له المُلْكُ وله الحَمْدُ يُحْيي ويُميتُ وهو حَيٌّ لا يموتُ، بيَدِه الخَيرُ، وهو على كُلِّ شَيءٍ قديرٌ) كَتَبَ اللهُ له ألْفَ ألْفِ حَسَنةٍ، ورَفَع له ألْفَ ألْفِ دَرَجةٍ -أو قال: وبنى له بيتًا في الجنَّةِ- قال: فقَدِمْتُ خُراسانَ فأَتَيتُ قُتَيبةَ بنَ مُسلِمٍ فقُلْتُ: أتيتُك بهَدِيَّةٍ، فحَدَّثْتُه الحديثَ، قال: فكان قُتَيبةُ يركَبُ في مَوكِبِه حتَّى يأتيَ السُّوقَ فيَقولَها، ثُمَّ ينصَرِفُ».","narrator":"عمر بن الخطاب","source":"الأحاديث المختارة 187","grade":"صحيح","judgment":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","url":"https://dorar.net/h/43hdhB2a","nameForm":"على كُلِّ شَيءٍ قديرٌ","scene":"عمر: «من دخل السوق فقال: لا إله إلا الله وحده لا شريك له، له الملك وله الحمد، يحيي ويميت وهو حي لا يموت، بيده الخير وهو على كل شيء قدير — كتب الله له ألف ألف حسنة، ورفع له ألف ألف درجة» أو قال: وبنى له بيتًا في الجنة.","reason":"السوق موضع الغفلة والحرص، فيُذكر فيه من بيده الخير وهو على كل شيء قدير — ذكرٌ في موضع النسيان يُضاعف.","adds":"يعطي الاسم ذكر دخول السوق."},{"i":8,"of":25,"text":"ما من مسلمٍ يقِفُ عشيَّةَ عرفةَ بالموْقفِ فيستقبِلُ القِبلةَ بوجهِه ثمَّ يقولُ لا إلهَ إلَّا اللهُ وحدَه لا شريكَ له له الملكُ وله الحمدُ يُحيي ويُميتُ وهو على كلِّ شيءٍ قديرٌ مائةَ مرَّةٍ ثمَّ يقرأُ {قُلْ هُوَ اللهُ أَحَدٌ} مائةَ مرَّةٍ ثمَّ يقولُ اللَّهمَّ صلِّ على محمَّدٍ وعلى آلِ محمَّدٍ كما صلَّيتَ على إبراهيمَ وعلى آلِ إبراهيمَ إنَّك حميدٌ مجيدٌ وعلينا معهم مائةَ مرَّةٍ إلَّا قال اللهُ تعالّى يا ملائكتي ما جزاءُ عبدي هذا سبَّحني وهلَّلني وكبَّرني وعظَّمني وعرَفني وأثنَى عليَّ وصلَّى على نبيِّي اشهَدوا ملائكتي أنِّي قد غفرتُ له وشفَّعتُه في نفسِه ولو سألني عبدي هذا لشفَّعتُه في أهلِ الموقفِ","narrator":"جابر بن عبدالله","source":"الترغيب والترهيب 2/197","grade":"صحيح","judgment":"[إسناده صحيح أو حسن أو ما قاربهما]","url":"https://dorar.net/h/ZnKbDkQh","nameForm":"على كلِّ شيءٍ قديرٌ","scene":"جابر: «ما من مسلم يقف عشية عرفة بالموقف فيستقبل القبلة بوجهه ثم يقول: لا إله إلا الله وحده لا شريك له، له الملك وله الحمد، يحيي ويميت، وهو على كل شيء قدير مائة مرة»، ثم يقرأ الإخلاص مائة ويصلي على النبي ﷺ مائة، فيقول الله: «اشهدوا ملائكتي أني قد غفرت له وشفعته في نفسه».","reason":"عشية عرفة يُبدأ الذكر بالتهليل المختوم بالاسم مائة مرة: إقرارٌ بأن الذي يحيي ويميت على كل شيء قدير، ثم يُجاب الواقف بالمغفرة والتشفيع.","adds":"التهليل المختوم بالاسم مائة مرة أول ذكر عشية عرفة."},{"i":9,"of":25,"text":"مَن تَعارَّ مِن اللَّيلِ فقال حِينَ يَستيقظُ: لا إلهَ إلَّا اللهُ وحْدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كلِّ شيءٍ قديرٌ، سُبحانَ اللهِ، والحمدُ للهِ، ولا إلهَ إلَّا اللهُ، واللهُ أكبرُ، ولا حولَ ولا قُوَّةَ إلَّا باللهِ العَليِّ العَظيمِ، ثمَّ دعا: ربِّ اغفِرْ لي؛ غُفِرَ له -قال الوَليدُ أحدُ رُواتِه: أو قال: دعا؛ استُجيبَ له-، فإنْ قامَ فتوضَّأ ثُمَّ صلَّى؛ قُبِلتْ صلاتُه.","narrator":"عبادة بن الصامت","source":"ما تمس إليه الحاجة 131","grade":"صحيح","url":"https://dorar.net/h/EgFiW0iu","nameForm":"على كلِّ شيءٍ قديرٌ","scene":"عبادة: «من تعارّ من الليل فقال: لا إله إلا الله وحده لا شريك له، له الملك وله الحمد، وهو على كل شيء قدير… ثم دعا غُفر له».","reason":"اليقظة في الليل تُبدأ بالإقرار بالقدرة: الذي أيقظك قادر على ما تسأله.","adds":"يعطي الاسم ذكر التعارّ."},{"i":10,"of":25,"text":"زَعمَتْ أنَّ فاطمةَ، جاءتْ إلى نبيِّ اللهِ تَشتَكي إليه الخِدمةَ، فقالَت: يا رسولَ اللهِ، واللهِ لقد مَجِلتْ يدايَ من الرَّحى، أطحَنُ مرَّةً، وأعجِنُ مرَّةً، فقالَ لها رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ: إنْ يَرزُقْكِ اللهُ شيئًا يأتِكِ، وسأدُلُّكِ على خيرٍ من ذلكَ؛ إذا لَزِمتِ مَضجَعَكِ، فسَبِّحي اللهَ ثَلاثًا وثلاثينَ، وكَبِّري ثَلاثًا وثلاثينَ، واحمَدي أربَعًا وثلاثينَ، فذلك مِئةٌ، فهو خيرٌ لكِ من الخادِمِ، وإذا صَلَّيتِ صَلاةَ الصُّبحِ، فقولي: لا إلهَ إلَّا اللهُ وحدَهُ لا شَريكَ له، له المُلكُ وله الحَمدُ، يُحيي ويُميتُ، بيَدِه الخَيرُ، وهو على كلِّ شيءٍ قديرٌ. عَشْرَ مرَّاتٍ بعدَ صلاةِ الصُّبحِ، وعَشْرَ مرَّاتٍ بعدَ صَلاةِ المَغرِبِ؛ فإنَّ كلَّ واحدةٍ منهنَّ تُكتَبُ عَشْرَ حَسَناتٍ، وتَحُطُّ عَشْرَ سيِّئاتٍ، وكلُّ واحدةٍ منهنَّ كعِتقِ رَقبةٍ مِن وَلدِ إسماعيلَ، ولا يَحِلُّ لذَنبٍ كُسِبَ ذلكَ اليومَ أنْ يُدرِكَه إلَّا أنْ يَكونَ الشِّركُ، لا إلهَ إلَّا اللهُ وحدَهُ لا شريكَ له، وهو حَرَسُكِ، ما بينَ أنْ تَقوليهِ غُدْوةً إلى أنْ تَقوليه عَشيَّةً، من كلِّ شَيطانٍ، ومن كلِّ سُوءٍ.","narrator":"أم سلمة أم المؤمنين","source":"تخريج المسند لشعيب 26551","grade":"صحيح","judgment":"طلب فاطمة رضي الله عنها الخادم، وما دلها عليه صلَّى اللهُ عليهِ وسلَّمَ من الذكر إذا لزمت مضجعها. صحيح لغيره","url":"https://dorar.net/h/k3YBql5B","nameForm":"على كلِّ شيءٍ قديرٌ","scene":"فاطمة تشتكي إلى النبي ﷺ الخدمة وقد مجلت يداها من الرحى، فيدلّها على خيرٍ من الخادم: تسبيحٌ وتكبيرٌ وتحميدٌ إذا لزمت مضجعها، وتهليلٌ عشرًا بعد الصبح وعشرًا بعد المغرب: «لا إله إلا الله وحده لا شريك له، له الملك وله الحمد، يحيي ويميت، بيده الخير، وهو على كل شيء قدير».","reason":"ضعف الجسد يُعالج بذكر القدرة: من شكت الخدمة والتعب أُعطيت الإقرار بالقادر على كل شيء — وهو حرسٌ لها من كل شيطانٍ وسوء — بدل الخادم.","adds":"يُري الاسم في تهليلٍ علّمه النبي ﷺ فاطمة عشرًا بعد الصبح وعشرًا بعد المغرب."},{"i":11,"of":25,"text":"حلَفتُ باللَّاتِ والعُزَّى فقالَ لي أصحابي بئسَ ما قلتَ قلتَ هُجْرًا فأتيتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وعلى آلِهِ وسلَّمَ فذَكرتُ ذلكَ لهُ فقالَ قل لا إلهَ إلَّا اللَّهُ وحدَهُ لا شريكَ لهُ لهُ الملكُ ولهُ الحمدُ وهوَ على كلِّ شيءٍ قديرٌ وانفُث عن يسارِكَ ثلاثًا وتعوَّذْ باللَّهِ منَ الشَّيطانِ ثمَّ لا تعُدْ","narrator":"سعد بن أبي وقاص","source":"الصحيح المسند 369","grade":"صحيح","url":"https://dorar.net/h/zWxhTtwh","nameForm":"على كلِّ شيءٍ قديرٌ","scene":"سعد: حلفت باللات والعزى فقال أصحابي: بئس ما قلت. فأتيت النبي ﷺ فقال: «قل: لا إله إلا الله وحده لا شريك له، له الملك وله الحمد، وهو على كل شيء قدير، واتفل عن يسارك ثلاثًا وتعوذ بالله من الشيطان ولا تعد».","reason":"كفارة الحلف بالأصنام التهليل المختوم بالاسم: يُمحى ذكر الصنم بذكر القادر على كل شيء.","adds":"يعطي الاسم كفارة سبق اللسان بالشرك."},{"i":12,"of":25,"text":"أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ عَلَّمَه وأَمَرَه أنْ يَتعاهدَ أهلَه في كُلِّ صباحٍ: لبَّيكَ اللَّهُمَّ لبَّيكَ، لبَّيكَ وسَعديْكَ، والخيرُ في يَديْكَ ومنكَ وإليكَ، اللَّهُمَّ ما قُلتُ مِن قَولٍ، أوْ حَلَفتُ مِن حَلِفٍ، أوْ نَذرْتُ مِن نَذْرٍ فمَشيئتُكَ بيْنَ يديْ ذلك كُلِّهِ، ما شئتَ كان، وما لمْ تَشأْ لا يكُنْ، ولا حَولَ ولا قُوَّةَ إلَّا بكَ، إنَّكَ على كُلِّ شيءٍ قديرٌ، اللَّهُمَّ ما صلَّيتُ مِن صلاةٍ فعلى مَنْ صلَّيتَ، وما لَعنتُ مِن لَعنٍ فعلى مَنْ لَعنتَ، أنتَ وَليِّي في الدُّنيا والآخِرةِ، تَوفَّني مسلمًا، وأَلحِقني بالصَّالحينَ، اللَّهُمَّ إنِّي أَسألُكَ الرِّضا بعدَ القضاءِ، وبَرْدَ العَيشِ بعدَ الموتِ، ولَذَّةَ النَّظرِ إلى وَجهِكَ، وشوقًا إلى لقائكَ في غيرِ ضرَّاءَ مُضِرَّةٍ ولا فِتنةٍ مُضلَّةٍ، وأَعوذُ بكَ أنْ أَظلِمَ أوْ أُظلَمَ، أوْ أَعتدِيَ أوْ يُعتدَى عَلَيَّ، أوْ أَكسِبَ خطيئةً أوْ ذنبًا لا تَغفِرُه، اللَّهُمَّ فاطِرَ السَّمواتِ والأرضِ، عالِمَ الغيبِ والشَّهادةِ ذا الجلالِ والإكرامِ، فإنِّي أَعهدُ إليكَ في هذه الحياةِ الدُّنيا، وأُشهِدُكَ، وكفى بكَ شَهيدًا أنِّي أَشهدُ أنْ لا إلَهَ إلَّا أنتَ، وحْدَكَ لا شريكَ لكَ، لكَ المُلكُ، ولكَ الحمدُ، وأنتَ على كُلِّ شيءٍ قديرٌ، وأَشهدُ أنَّ مُحمَّدًا عَبدُكَ ورسولُكَ، وأَشهدُ أنَّ وَعدَكَ حقٌّ ولقاءَكَ حقٌّ، والسَّاعةَ آتيةٌ لا رَيبَ فيها، وأنَّكَ تَبعثُ مَن في القُبورِ، وأنَّكَ إنْ تَكِلْني إلى نفسي؛ تَكِلْني إلى ضَعفٍ وعَورةٍ وذَنبٍ وخطيئةٍ، وإنِّي لا أَثِقُ إلَّا برحمتِكَ، فاغفرْ لي ذنوبي كُلَّها؛ إنَّه لا يَغفِرُ الذُّنوبَ إلَّا أنتَ، وتُبْ عَلَيَّ؛ إنَّكَ أنتَ التَّوابُ الرَّحيمُ.","narrator":"زيد بن ثابت","source":"المستدرك على الصحيحين 1924","grade":"صحيح","judgment":"صحيح الإسناد","url":"https://dorar.net/h/nn7o6HNi","nameForm":"على كُلِّ شيءٍ قديرٌ ؛ على كُلِّ شيءٍ قديرٌ","scene":"عهد زيد بن ثابت: «…أشهد أن لا إله إلا أنت وحدك لا شريك لك، لك الملك ولك الحمد، وأنت على كل شيء قدير، وأشهد أن محمدًا عبدك ورسولك».","reason":"العهد الصباحي يُشهد فيه بالاسم.","adds":"يعطي الاسم في عهد الصباح."},{"i":13,"of":25,"text":"لَمَّا نَزَلَت على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم {للَّهِ ما في السَّماواتِ وما في الأرضِ وإن تُبدوا ما في أنفُسِكُم أو تُخفوه يُحاسِبكُم به اللهُ فيَغفِرُ لمَن يَشاءُ ويُعَذِّبُ مَن يَشاءُ والله على كُلِّ شيءٍ قديرٌ} [البقرة: 284]، قال: فاشتَدَّ ذلك على أصحابِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فأتَوا رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم ثُمَّ بَرَكوا على الرُّكَبِ، فقالوا: أي رَسولَ اللهِ، كُلِّفنا مِنَ الأعمالِ ما نُطيقُ، الصَّلاةَ والصِّيامَ والجِهادَ والصَّدَقةَ، وقد أُنزِلَت عليك هذه الآيةُ ولا نُطيقُها، قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أتُريدونَ أن تَقولوا كما قال أهلُ الكِتابَينِ مِن قَبلِكُم: سَمِعنا وعَصَينا؟ بَل قولوا: سَمِعنا وأطَعنا غُفرانَك رَبَّنا وإلَيك المَصيرُ، قالوا: سَمِعنا وأطَعنا غُفرانَك رَبَّنا وإلَيك المَصيرُ، فلَمَّا اقتَرَأها القَومُ ذَلَّت بها ألسِنَتُهم، فأنزَلَ اللهُ في إثرِها: {آمَنَ الرَّسولُ بما أُنزِلَ إليه مِن رَبِّه والمُؤمِنونَ كُلٌّ آمَنَ باللهِ ومَلائِكَتِه وكُتُبِه ورُسُلِه لا نُفَرِّقُ بينَ أحَدٍ مِن رُسُلِه وقالوا سَمِعنا وأطَعنا غُفرانَك رَبَّنا وإلَيك المَصيرُ} [البقرة: 285]، فلَمَّا فعَلوا ذلك نَسَخَها اللهُ تَعالى، فأنزَلَ اللهُ عزَّ وجلَّ: {لا يُكَلِّفُ اللهُ نَفسًا إلَّا وُسعَها لها ما كَسَبَت وعليها ما اكتَسَبَت رَبَّنا لا تُؤاخِذنا إن نَسينا أو أخطَأنا} [البقرة: 286] قال: نَعَم {رَبَّنا ولا تَحمِل علينا إصرًا كما حَمَلتَه على الذينَ مِن قَبلِنا} قال: نَعَم {رَبَّنا ولا تُحَمِّلنا ما لا طاقةَ لنا بهِ} قال: نَعَم {واعفُ عَنَّا واغفِرْ لنا وارحَمنا أنتَ مَولانا فانصُرنا على القَومِ الكافِرينَ} قال: نَعَم.","narrator":"أبو هريرة","source":"صحيح مسلم 125","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/y4sV2OZk","nameForm":"على كُلِّ شيءٍ قديرٌ","scene":"مسلم: لما نزلت ﴿وَإِن تُبْدُوا مَا فِي أَنفُسِكُمْ أَوْ تُخْفُوهُ يُحَاسِبْكُم بِهِ اللَّهُ… وَاللَّهُ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ﴾ اشتد ذلك على الصحابة فبركوا على الركب وقالوا: كُلّفنا من الأعمال ما نطيق، وقد أُنزلت هذه الآية ولا نطيقها. فقال: «بل قولوا: سمعنا وأطعنا»، فنزلت ﴿لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا﴾.","reason":"آية المحاسبة على ما في النفس تُختم بالقدرة فبرك الصحابة: القادر على كل شيء يقدر على محاسبة الخواطر — فقالوا: سمعنا وأطعنا، فنسخها الله رحمة.","adds":"يُري هيبة الاسم في قلوب الصحابة."},{"i":14,"of":25,"text":"عَنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم، أنَّه كان يَدعو بهذا الدُّعاءِ: اللَّهمَّ اغفِرْ لي خَطيئَتي وجَهلي، وإسرافي في أمري، وما أنتَ أعلَمُ به مِنِّي، اللَّهمَّ اغفِرْ لي جِدِّي وهَزلي، وخَطَئي وعَمدي، وكُلُّ ذلك عِندي، اللَّهمَّ اغفِرْ لي ما قدَّمتُ وما أخَّرتُ، وما أسرَرتُ وما أعلَنتُ، وما أنتَ أعلَمُ به مِنِّي، أنتَ المُقدِّمُ وأنتَ المُؤَخِّرُ، وأنتَ على كُلِّ شيءٍ قديرٌ.","narrator":"أبو موسى الأشعري","source":"صحيح مسلم 2719","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/s2oMwkzs","nameForm":"على كُلِّ شيءٍ قديرٌ","scene":"أبو موسى: كان النبي ﷺ يدعو: «اللهم اغفر لي خطيئتي وجهلي وإسرافي في أمري وما أنت أعلم به مني… اللهم اغفر لي ما قدمت وما أخرت وما أسررت وما أعلنت، أنت المقدم وأنت المؤخر، وأنت على كل شيء قدير».","reason":"خاتمة دعاء المغفرة الجامع: القدرة على مغفرة كل ما قُدّم وأُخّر.","adds":"يعطي الاسم في دعاء المغفرة الشامل."},{"i":15,"of":25,"text":"شَكا النَّاسُ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ قُحوطَ المَطَرِ، فأمَرَ بمِنبَرٍ فوُضِعَ له في المُصَلَّى، ووَعَدَ النَّاسَ يَومًا يَخرُجون فيه، قالتْ عائشةُ: فخَرَج رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ حين بَدَا حاجِبُ الشَّمسِ، فقَعَد على المِنبَرِ فكَبَّرَ وحَمِدَ اللهَ، ثمَّ قالَ: إنَّكُم شَكَوتُم جَدْبَ دِيارِكُم، واستِئخارَ المَطَرِ عنْ إبَّانِ زَمانِه عنكم، وقد أمَرَكُمُ اللهُ أن تَدعُوه، ووَعَدَكُم أن يَستَجيبَ لَكُم، ثمَّ قالَ: {الْحَمْدُ للهِ رَبِّ الْعَالَمِينَ (2) الرَّحْمَنِ الرَّحِيمِ (3) مَالِكِ يَوْمِ الدِّينِ} [الفاتحة: 2-4]، لا إلَهَ إلَّا اللهُ يَفعَلُ ما يُريدُ، اللَّهُمَّ أنت اللهُ لا إلَهَ إلَّا أنتَ الغَنيُّ ونحن الفُقَراءُ، أنزِلْ عَلَينا الغَيثَ، واجعَلْ ما أنزَلْتَ لنا قُوَّةً وبَلاغًا إلى حينٍ، ثمَّ رَفَع يَدَيه، فلم يَزَلْ في الرَّفعِ حتَّى بَدَا بَياضُ إبِطَيهِ، ثمَّ حَوَّلَ إلى النَّاسِ ظَهرَه، وقَلَب -أو: حَوَّلَ- رِداءَه وهو رافِعٌ يَدَيه، ثمَّ أقبَلَ على النَّاسِ، ونَزَل فصَلَّى رَكعَتَينِ، فأنشَأَ اللهُ سَحابًا فرَعَدَت وبَرَقَت، ثمَّ أمطَرَت بإذنِ اللهِ، فلم يَأتِ مَسجِدَه حتَّى سالَتِ السُّيولُ، فلمَّا رَأى سُرعَتَهُم إلى الكِنِّ ضَحِكَ حتَّى بَدَت نَواجِذُه، فقالَ: أشهَدُ أنَّ اللهَ على كلِّ شَيءٍ قَديرٌ، وأنِّي عَبدُ اللهِ ورَسولُه.","narrator":"عائشة","source":"المستدرك على الصحيحين 1242","grade":"صحيح","judgment":"صحيح على شرط الشيخين","url":"https://dorar.net/h/5R0Ahct2","nameForm":"على كلِّ شَيءٍ قَديرٌ","scene":"الاستسقاء: دعا النبي ﷺ فرعدت وبرقت وأمطرت حتى سالت السيول، فلما رأى سرعة الناس إلى الكنّ ضحك حتى بدت نواجذه وقال: «أشهد أن الله على كل شيء قدير، وأني عبد الله ورسوله».","reason":"الشهادة بالاسم عند رؤية أثره: مطرٌ بعد جدبٍ في المجلس نفسه — فيشهد النبي ﷺ ضاحكًا بالقدرة.","adds":"الاسم شهادةٌ عند رؤية المطر بعد الجدب."},{"i":16,"of":25,"text":"سمِعتُ عُمَرَ بنَ الخطَّابِ يَقولُ لعليٍّ والعبَّاسِ: هل تَعلَمانِ أنَّ رسولَ اللهِ صَلَّى اللهُ عليه وسلَّمَ قال: لا نُورَثُ، ما ترَكْنا صَدَقةٌ؟ فقالا: نَعم. قال: فإنَّ اللهَ عزَّ وجلَّ خَصَّ رسولَهُ صَلَّى اللهُ عليه وسلَّمَ بخاصَّةٍ لم يَخُصَّ بها أحدًا مِنَ النَّاسِ، فقالَ: {وَمَا أَفَاءَ اللَّهُ عَلَى رَسُولِهِ مِنْهُمْ فَمَا أَوْجَفْتُمْ عَلَيْهِ مِنْ خَيْلٍ وَلَا رِكَابٍ وَلَكِنَّ اللَّهَ يُسَلِّطُ رُسُلَهُ عَلَى مَنْ يَشَاءُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ} [الحشر: 6]، فكانَ اللهُ عزَّ وجلَّ أفاءَ على رسولِهِ بَني النَّضيرِ، فواللهِ ما استَأثَرَ بها عليكم، ولا أخَذَها دونَكم، فكان صَلَّى اللهُ عليه وسلَّمَ يَأخُذُ منها نَفَقةَ بَيتِهِ، أو نَفَقَتهُ ونَفَقةَ أهلِهِ سَنةً، ويَجعَلُ ما بَقيَ أُسوةَ المالِ، ثم أقبَلَ على أولئك الرَّهطِ -يَعْني عُثمانَ، وعَبدَ الرَّحمنِ بنَ عَوفٍ، والزُّبَيرَ بنَ العَوَّامِ، وسَعدَ بنَ أبي وَقَّاصٍ رضِيَ اللهُ عنهم- فقال: أنشُدُكم باللهِ الذي بإذنِهِ تَقومُ السَّماءُ والأرضُ، هل تَعلَمونَ ذلك؟ قالوا: نَعم.","narrator":"عمر بن الخطاب","source":"تخريج مشكل الآثار 4351","grade":"صحيح","judgment":"إسناده صحيح على شرط الشيخين","url":"https://dorar.net/h/xcAFDzOp","nameForm":"عَلَى كُلِّ شَيْءٍ قَدِيرٌ","scene":"عمر لعلي والعباس: إن الله أفاء على رسوله بني النضير ﴿وَلَٰكِنَّ اللَّهَ يُسَلِّطُ رُسُلَهُ عَلَىٰ مَن يَشَاءُ وَاللَّهُ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ﴾ — فوالله ما استأثر بها.","reason":"الفيء بلا قتال: قدرة الله سلّطت رسوله بلا خيل ولا ركاب.","adds":"يقرن الاسم بفيء النضير."},{"i":17,"of":25,"text":"إذا أَوى أَحدُكُم إلى فِراشِه ابتدَرَهُ ملَكٌ وشَيطانٌ، يقولُ الشَّيطانُ: افتحْ بِشرٍّ، ويقولُ الملَكُ: افتحْ بخيرٍ، فإنْ ذَكَرَ اللهَ ذَهَبَ الشَّيطانُ وباتَ الملَكُ يَكلَؤهُ، وإذا استَيقَظَ ابتدَرَهُ ملَكٌ وشَيطانٌ، يقولُ الشَّيطانُ: افتحْ بِشرٍّ، ويقولُ الملَكُ: افتحْ بخيرٍ، فإنْ قالَ: الحمدُ للهِ الَّذي ردَّ إليَّ نَفسي بعدَ موتِها ولمْ يُمِتْها في نَومِها، الحمدُ للهِ الَّذي يُمسِكُ السَّماءَ أنْ تَقَعَ على الأرضِ إلَّا بإذنِهِ، إنَّ اللهَ بالنَّاسِ لرَؤوفٌ رَحيمٌ، الحمدُ للهِ الَّذي يُحيِي المَوْتى وهو على كُلِّ شيءٍ قديرٌ؛ فإنْ خَرَّ مِن دابَّةٍ ماتَ شهيدًا، وإنْ قامَ فصَلَّى صَلَّى في الفضائلِ.","narrator":"جابر","source":"المستدرك على الصحيحين 2037","grade":"صحيح","judgment":"صحيح على شرط مسلم","url":"https://dorar.net/h/IGFuJdDk","nameForm":"على كُلِّ شيءٍ قديرٌ","scene":"ذكر الاستيقاظ: «…الحمد لله الذي يحيي الموتى وهو على كل شيء قدير».","reason":"الاستيقاظ إحياءٌ بعد موتة النوم: فيُحمد القادر على الإحياء.","adds":"يعطي الاسم في ذكر اليقظة."},{"i":18,"of":25,"text":"عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهُما، قالَ: جاءَهُ رَجلٌ فقالَ له: يا أبا عبَّاسٍ، إنَّ في نَفسي مِنَ القرآنِ شيءٌ. قالَ: وما هو؟ فقالَ: شكٌّ، قالَ: وَيْحكَ هل سألتَ أحدًا غيري؟ فقالَ: لا، قالَ: هاتِ، قالَ: أَسمَعُ اللهَ يقولُ: {وَكَانَ اللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرًا} [الأحزاب: 27] كان هذا أمرًا قد كان. وقالَ: {فَلَا أَنْسَابَ بَيْنَهُمْ يَوْمَئِذٍ وَلَا يَتَسَاءَلُونَ} [المؤمنون: 101]، وقالَ في آيةٍ أخرى: {وَأَقْبَلَ بَعْضُهُمْ عَلَى بَعْضٍ يَتَسَاءَلُونَ} [الصافات: 27]، ثُمَّ ذَكَرَ أشياءَ فقالَ ابنُ عبَّاسٍ: أمَّا قولُهُ تَعالَى: {وَكَانَ اللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرًا} [الأحزاب: 27]، فإنَّه لمْ يَزلْ ولا يزالُ هو الأوَّلُ والآخرُ والظَّاهرُ والباطنُ، وأمَّا قولُهُ تَعالَى: {فَلَا أَنْسَابَ بَيْنَهُمْ يَوْمَئِذٍ وَلَا يَتَسَاءَلُونَ} [المؤمنون: 101] فهذا في النَّفخةِ الأولى حين لا يَبقى على الأرضِ شيءٌ، فلا أنسابَ بيْنَهم يومئذٍ ولا يَتساءلونَ، وأمَّا قولُهُ تَعالَى: {فَأَقْبَلَ بَعْضُهُمْ عَلَى بَعْضٍ يَتَسَاءَلُونَ} [الصافات: 50]، فإنَّهم لمَّا دخلوا الجنَّةَ أَقْبَلَ بعضُهُم على بعْضٍ يَتساءلونَ.","narrator":"سعيد بن جبير","source":"المستدرك على الصحيحين 3535","grade":"صحيح","judgment":"صحيح الإسناد","url":"https://dorar.net/h/ZbKMrswe","nameForm":"عَلَى كُلِّ شَيْءٍ قَدِيرًا ؛ عَلَى كُلِّ شَيْءٍ قَدِيرًا","scene":"سأل رجلٌ ابن عباس عن شكٍّ في نفسه من القرآن: أسمع الله يقول ﴿وَكَانَ اللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرًا﴾ كأن هذا أمرٌ قد كان! فقال ابن عباس: «فإنه لم يزل ولا يزال هو الأول والآخر والظاهر والباطن».","reason":"«كان» لا تعني الانقطاع: قدرته لم تزل.","adds":"يُصحّح فهم صيغة «كان» في الاسم."},{"i":19,"of":25,"text":"«قالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ لمُعاذِ بنِ جَبَلٍ: ألَا أُعَلِّمُك دُعاءً تَدْعو به، لو كانَ عليك مِثلُ جَبَلٍ دَيْنًا لأدَّاه اللهُ عنك؟ قُلْ يا مَعاذُ: اللَّهُمَّ مالِكَ المُلْكِ، تُؤْتي المُلْكَ مَن تَشاءُ، وتَنزِعُ المُلْكَ مِمَّن تَشاءُ، وتُعِزُّ مَن تَشاءُ، وتُذِلُّ مَن تَشاءُ، بيَدِك الخَيْرُ إنَّك على كلِّ شيءٍ قَديرٌ، رَحْمانُ الدُّنْيا والآخِرةِ ورَحيمُهما، تُعْطيهما مَن تَشاءُ، وتَمنَعُ مِنهما مَن تَشاءُ، ارْحَمْني رَحْمةً تُغْنيني بها عن رَحْمةِ مَن سِواك».\nقالَ الطَّبَرانِيُّ: لم يَرْوِه عن الزُّهْرِيِّ إلَّا يونُسُ، ولا عنه إلَّا وَهْبُ اللهِ.","narrator":"أنس بن مالك","source":"الأحاديث المختارة 2633","grade":"صحيح","judgment":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","url":"https://dorar.net/h/harp7m5M","nameForm":"على كلِّ شيءٍ قَديرٌ","scene":"دعاء معاذ للدين: «…تعز من تشاء وتذل من تشاء، بيدك الخير، إنك على كل شيء قدير».","reason":"قضاء دين كالجبل يُسند إلى القادر على كل شيء.","adds":"يعطي الاسم في دعاء الدين."},{"i":20,"of":25,"text":"كان رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ وأصحابُهُ يَعْفُونَ عن المُشْرِكِينَ وأَهْل الكِتَاب كما أمرَهُمْ اللهُ ويَصْبِرُونَ على الأَذَى قال اللهُ  فَاعْفُوا وَاصْفَحُوا حَتَّى يَأْتِيَ اللَّهُ بِأَمْرِهِ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ  وكان رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يَتَأولُ مِنَ العَفوِ ما أمرَهُ اللهُ بهِ حتى أَذِنَ اللهُ فيهِمْ بقتلٍ فَقتلَ اللهُ بهِ مَنْ قُتِلَ من صَنادِيدِ قريشٍ","narrator":"أسامة بن زيد","source":"تفسير القرآن العظيم 1/221","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/8BwJjUjn","nameForm":"عَلَى كُلِّ شَيْءٍ قَدِيرٌ","scene":"أسامة: كان النبي ﷺ وأصحابه يعفون عن المشركين وأهل الكتاب كما أمرهم الله ﴿فَاعْفُوا وَاصْفَحُوا حَتَّىٰ يَأْتِيَ اللَّهُ بِأَمْرِهِ إِنَّ اللَّهَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ﴾ حتى أذن الله في قتالهم.","reason":"العفو المؤقت بانتظار أمر الله: القادر على كل شيء يأتي بأمره في وقته، فيُعفى ريثما يأتي.","adds":"يربط الاسم بمرحلة العفو."},{"i":21,"of":25,"text":"اللهمَّ أنت ربِّي لا إلهَ إلَّا أنتَ عليك توكلتُ وأنت ربُّ العرشِ العظيمِ ، ما شاء اللهُ كان وما لم يشأْ لم يكنْ ولا حولَ ولا قوةَ إلَّا باللهِ أعلمُ أنَّ اللهَ على كلِّ شيءٍ قديرٌ وأنَّ اللهَ قد أحاط بكلِّ شيءٍ علمًا وأحصَى كلَّ شيءٍ عددًا ، اللهمَّ إني أعوذُ بك من شرِّ نفسي ومن شرِّ الشيطانِ وشَرَكِه ، ومن شرِّ كلِّ دابةٍ أنتَ آخِذٌ بناصيتِها إنَّ ربِّي على صِراطٍ مستقيمٍ","narrator":"-","source":"سفر السعادة 310","grade":"صحيح","url":"https://dorar.net/h/fSnNLIIt","nameForm":"على كلِّ شيءٍ قديرٌ","scene":"«اللهم أنت ربي لا إله إلا أنت عليك توكلت وأنت رب العرش العظيم، ما شاء الله كان وما لم يشأ لم يكن، ولا حول ولا قوة إلا بالله، أعلم أن الله على كل شيء قدير وأن الله قد أحاط بكل شيء علمًا…».","reason":"«أعلم أن الله على كل شيء قدير» — إقرار علمي في دعاء التوكل.","adds":"صيغة توكل بالاسم."},{"i":22,"of":25,"text":"كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّم إذا خرَج لسفرٍ قال اللهمَّ بلاغًا يُبَلِّغُ خيرًا مغفِرةً منك ورِضوانًا بيدِك الخيرُ إنَّك على كلِّ شيءٍ قديرٌ اللهمَّ أنت الصاحِبُ في السَّفرِ والخليفةُ في الأهلِ اللهمَّ هوِّنْ علينا السَّفرَ واطْوِ لنا الأرضَ اللهمَّ أعوذُ بك مِن وَعْثاءِ السَّفرِ وكآبةِ المُنْقَلَبِ","narrator":"البراء بن عازب","source":"مجمع الزوائد 10/133","grade":"صحيح","judgment":"رجاله رجال الصحيح غير فطر بن خليفة وهو ثقة","url":"https://dorar.net/h/o8siNHne","nameForm":"على كلِّ شيءٍ قديرٌ","scene":"البراء: كان النبي ﷺ إذا خرج لسفر قال: «اللهم بلاغًا يبلغ خيرًا مغفرةً منك ورضوانًا، بيدك الخير إنك على كل شيء قدير، اللهم أنت الصاحب في السفر والخليفة في الأهل…».","reason":"السفر يُفتتح بالقدرة: الصاحب في السفر والخليفة في الأهل قادرٌ على الحالين.","adds":"يعطي الاسم دعاء السفر."},{"i":23,"of":25,"text":"عن حُذيفةَ رَضِيَ اللهُ عنه قال: بينما أنا أصَلِّي سَمِعتُ متكَلِّمًا يقولُ: اللَّهُمَّ لك الحَمدُ كُلُّه، ولك المُلْكُ كُلُّه، وبيَدِك الخَيرُ كُلُّه، وإليك يُرجَعُ الأمرُ كُلُّه؛ علانيتُه وسِرُّه، أهلٌ أن تُحمَدَ أبدًا، إنَّك على كُلِّ شَيءٍ قَديرٌ، اللَّهُمَّ اغفِرْ لي جميعَ ما مضى مِن ذُنوبي، واعصِمْني فيما بَقِيَ من عُمُرِي، وارزُقْني عَمَلًا زاكِيًا ترضى به عنِّي، قال: فأتيتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم فذكَرْتُ ذلك له، فقال: ذاك مَلَكٌ أتاك يُعَلِّمُك كيف تحمَدُ رَبَّك","narrator":"حذيفة بن اليمان","source":"الفتوحات الربانية 5/16","grade":"حسن","judgment":"رجاله موثقون إلا الفدكي يعني المبهم الراوي عن حذيفة","url":"https://dorar.net/h/InvVAJvR","nameForm":"على كُلِّ شَيءٍ قَديرٌ","scene":"حذيفة: سمعت متكلمًا يقول في صلاته: «اللهم لك الحمد كله ولك الملك كله وبيدك الخير كله وإليك يرجع الأمر كله، أهلٌ أن تُحمد أبدًا، إنك على كل شيء قدير، اللهم اغفر لي جميع ما مضى من ذنوبي واعصمني فيما بقي…» فأخبر النبي ﷺ فقال: ذاك ملك.","reason":"دعاءٌ سمعه حذيفة من ملك: كل الحمد والملك والخير له، والقدرة على كل شيء — فالملائكة تدعو بالاسم.","adds":"يُري الاسم في دعاء ملك."},{"i":24,"of":25,"text":"أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ كانَ يعلِّمُها فيقولُ قولي حينَ تصبحينَ سبحانَ اللَّهِ وبحمدِه لا قوَّةَ إلَّا باللَّهِ ما شاءَ اللَّهُ كانَ وما لم يشأ لم يَكن أعلمُ أنَّ اللَّهَ على كلِّ شيءٍ قديرٌ وأنَّ اللَّهَ قد أحاطَ بِكلِّ شيءٍ علمًا فإنَّهُ من قالَها حينَ يصبِحُ حُفِظَ حتَّى يمسيَ ومن قالَها حينَ يمسي حُفِظَ حتَّى يصبِحَ","narrator":"بعض بنات النبي","source":"هداية الرواة 2/471","grade":"حسن","judgment":"[حسن كما قال في المقدمة]","url":"https://dorar.net/h/FkUIziSy","nameForm":"على كلِّ شيءٍ قديرٌ","scene":"إحدى بنات النبي ﷺ: كان يعلّمها: «قولي حين تصبحين: سبحان الله وبحمده، لا قوة إلا بالله، ما شاء الله كان وما لم يشأ لم يكن، أعلم أن الله على كل شيء قدير وأن الله قد أحاط بكل شيء علمًا — من قالها حين يصبح حُفظ حتى يمسي».","reason":"ورد الحفظ اليومي للبنت: علمٌ بالقدرة والإحاطة يحفظ يومها.","adds":"يعطي الاسم ورد بنت النبي ﷺ."},{"i":25,"of":25,"text":"في القُرآنِ سورةٌ ثَلاثونَ آيةً شَفَعَت لصاحِبها حتَّى غُفِرَ له: {تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ} [الملك: 1]","narrator":"أبو هرَيرةَ","source":"إثبات عذاب القبر 151","grade":"حسن","judgment":"إسناده حسن","url":"https://dorar.net/h/s35vV9vI","nameForm":"عَلَى كُلِّ شَيْءٍ قَدِيرٌ","scene":"سورة الملك: «ثلاثون آية شفعت لصاحبها حتى غُفر له: ﴿تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ﴾».","reason":"مطلع السورة الشافعة: الملك والقدرة.","adds":"يربط الاسم بسورة الملك."}],"sunnah":{"card":"الصيغة: عَلَى كُلِّ شَيْءٍ قَدِيرٌ — مركّبة\nفي السنة: 25 شاهدًا (56 رواية)\nخصوصية الورود في السنة: خاتمة التهليل النبوي «لا إله إلا الله وحده لا شريك له، له الملك وله الحمد، وهو على كل شيء قدير» — يُقال مائةً فيعدل عشر رقاب، وعشرًا صباحًا ومساءً، ودبر كل صلاة، وعند القفول من السفر، وفي دخول السوق، وعشية عرفة، وعند التعارّ، وفي «أصبحنا وأصبح الملك لله»؛ وخاتمة دعاء «أنت المقدم وأنت المؤخر»؛ وشهادة النبي ﷺ حين أمطرت: «أشهد أن الله على كل شيء قدير»؛ ودعاء معاذ للدين، والسفر، ودعاء فاطمة، وفي آية البقرة التي بركوا لها على الركب.\nالمعنى المختصر: تام القدرة على كل ممكن، لا يعجزه شيء.","teaches":"1. أن الإقرار بقدرته يعدل عتق الرقاب ويمحو الخطايا كزبد البحر.\n2. أنه يُذكر في كل موضع: الصباح والمساء ودبر الصلاة والسوق وعرفة والسفر والنوم.\n3. أن الشهادة به تُقال عند رؤية أثره: المطر.\n4. أن القادر على كل شيء يحاسب الخواطر ثم يرحم فلا يكلف إلا الوسع.","whenRecall":"- دبر كل صلاة.\n- صباحًا ومساءً عشرًا.\n- في اليوم مائة.\n- عند دخول السوق.\n- عشية عرفة.\n- عند القفول من السفر وعند الخروج له.\n- عند رؤية المطر.","whenPray":"عند الشعور بـ:\n1. العجز.\n2. ثقل الدين.\n3. الضعف في الجسد.\nعند طلب:\n1. عتق الرقاب بالتهليل.\n2. الحرز من الشيطان.\n3. المغفرة لما قدمت وأخرت.\nعند الرغبة في:\n1. أن تختم ذكرك كما ختمه النبي ﷺ.","duaItems":"1. «لا إله إلا الله وحده لا شريك له، له الملك وله الحمد، وهو على كل شيء قدير» — مائة في اليوم (صحيح مسلم 2691)، دبر كل صلاة (صحيح مسلم 594، 597)، عشرًا صباحًا (تخريج سنن أبي داود 5077)، عشية عرفة (السلسلة الصحيحة 1503)، عند القفول (صحيح البخاري 2995).\n2. دخول السوق: «…يحيي ويميت وهو حي لا يموت بيده الخير وهو على كل شيء قدير» — الأحاديث المختارة 187.\n3. المساء: «أمسينا وأمسى الملك لله…» — صحيح مسلم 2723.\n4. دعاء المغفرة: «…أنت المقدم وأنت المؤخر وأنت على كل شيء قدير» — صحيح مسلم 2719.\n5. السفر: «اللهم بلاغًا يبلغ خيرًا… بيدك الخير إنك على كل شيء قدير» — مجمع الزوائد 10/133.","summary":"«على كل شيء قدير» في السنة خاتمة التهليل النبوي في كل موضع — مائةً تعدل عشر رقاب، ودبر كل صلاة، وفي السوق وعرفة والسفر — وشهادة النبي ﷺ ضاحكًا حين أمطرت: «أشهد أن الله على كل شيء قدير»."},"situations":[{"situationId":1,"verses":[{"i":2,"strength":"direct","headline":"انغلاق طريقٍ أو خطةٍ كنت تعتمد عليها","bridge":"انسدّ ما كنت تعتمد عليه؟ ضمانة البديل في الاسم: ﴿نَأْتِ بِخَيْرٍ مِنْهَا أَوْ مِثْلِهَا أَلَمْ تَعْلَمْ أَنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — من يقدر على كل شيء لا يُغلق بابًا إلا وعنده بديل."},{"i":24,"strength":"direct","headline":"الخروج من كربٍ شديد دون رؤية سعةٍ بعده","bridge":"خرجتَ لتوّك من كربٍ شديد ولا ترى بعده سعة؟ قيل لقومٍ خرجوا لتوّهم من حصار الأحزاب: ﴿وَأَوْرَثَكُمْ أَرْضَهُمْ وَدِيَارَهُمْ وَأَمْوَالَهُمْ وَأَرْضًا لَمْ تَطَئُوهَا وَكَانَ اللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرًا﴾ — أرضٌ لم توطأ بعد وُعدوا بها فوقع؛ فوعد القدير يتجاوز حدود كربك وخيالك."}],"hadiths":[]},{"situationId":5,"verses":[{"i":15,"strength":"direct","headline":"مرضٌ ملحّ عجز الخلق عن كشفه","bridge":"مرضٌ يلحّ عليك ولا يكشفه أحد؟ ﴿وَإِنْ يَمْسَسْكَ اللَّهُ بِضُرٍّ فَلَا كَاشِفَ لَهُ إِلَّا هُوَ وَإِنْ يَمْسَسْكَ بِخَيْرٍ فَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — في الضر حصر: لا كاشف إلا هو، وفي الخير إطلاق: قدرته بلا سقف؛ فاطلب الكشف ممن انحصر فيه، وارجُ العافية ممن لا حدّ لقدرته."}],"hadiths":[]},{"situationId":10,"verses":[{"i":7,"strength":"direct","headline":"القلق من تقلبات المناصب والأرزاق والدول","bridge":"تخاف تقلبات المناصب والدول والأرزاق؟ ﴿قُلِ اللَّهُمَّ مَالِكَ الْمُلْكِ تُؤْتِي الْمُلْكَ مَنْ تَشَاءُ وَتَنْزِعُ الْمُلْكَ مِمَّنْ تَشَاءُ وَتُعِزُّ مَنْ تَشَاءُ وَتُذِلُّ مَنْ تَشَاءُ بِيَدِكَ الْخَيْرُ إِنَّكَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — أربع تصرفات متقابلة والقدرة ضمانتها، والخير وحده منسوبٌ إلى يده؛ فما يأتيك من تقلبٍ خيرٌ مقدَّر."},{"i":29,"strength":"direct","headline":"العجز عن أمرٍ تخاف أن يفوتك","bridge":"عجزتَ عن شيءٍ وتخاف أن يفوتك؟ ﴿وَأُخْرَى لَمْ تَقْدِرُوا عَلَيْهَا قَدْ أَحَاطَ اللَّهُ بِهَا وَكَانَ اللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرًا﴾ — القدرة الإلهية تعمل حيث تنتهي قدرتك؛ ما عجزتَ عنه لم يخرج من دائرة العطاء، بل محفوظٌ لوقته."},{"i":33,"strength":"direct","headline":"الخوف مما بعد تغيّرٍ كبيرٍ في حياتك","bridge":"تخاف مما بعد التغيير الكبير في حياتك؟ الغاية من عرض خلق السماوات والأرض في خاتمة سورة الطلاق: ﴿لِتَعْلَمُوا أَنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ وَأَنَّ اللَّهَ قَدْ أَحَاطَ بِكُلِّ شَيْءٍ عِلْمًا﴾ — قدرةٌ تسع غدك، وعلمٌ أحاط به."}],"hadiths":[{"i":21,"strength":"direct","headline":"القلق من المستقبل وطلب صيغةٍ جامعة للتوكل","bridge":"تريد صيغة توكلٍ تُقال في كل خوف؟ «اللهم أنت ربي لا إله إلا أنت عليك توكلت وأنت رب العرش العظيم، ما شاء الله كان وما لم يشأ لم يكن، ولا حول ولا قوة إلا بالله، أعلم أن الله على كل شيء قدير وأن الله قد أحاط بكل شيء علمًا» — إقرار علمي بالقدرة في دعاء التوكل."}]},{"situationId":18,"verses":[],"hadiths":[{"i":14,"strength":"direct","headline":"طلب مغفرةٍ جامعة لما علمت وما جهلت من ذنوبك","bridge":"تريد دعاء مغفرةٍ يشمل ما تعرف وما لا تعرف؟ كان النبي ﷺ يدعو: «اللهم اغفر لي خطيئتي وجهلي وإسرافي في أمري وما أنت أعلم به مني… اللهم اغفر لي ما قدمت وما أخرت وما أسررت وما أعلنت، أنت المقدم وأنت المؤخر، وأنت على كل شيء قدير» — خاتمة دعاء المغفرة الجامع: القدرة على مغفرة كل ما قُدّم وأُخّر."}]},{"situationId":19,"verses":[{"i":13,"strength":"direct","headline":"الشعور بالسقوط الأبدي بعد عقوبةٍ أو فضيحة","bridge":"أُقيم عليك حدٌّ أو فُضحت فظننت ملفك مغلقًا؟ بعد ﴿فَمَنْ تَابَ مِنْ بَعْدِ ظُلْمِهِ وَأَصْلَحَ﴾ جاء: ﴿أَلَمْ تَعْلَمْ أَنَّ اللَّهَ لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ يُعَذِّبُ مَنْ يَشَاءُ وَيَغْفِرُ لِمَنْ يَشَاءُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — لا قضية منتهية عند من يقدر على كل شيء؛ تبتَ بعد ظلمك؟ الباب مفتوح."}],"hadiths":[]},{"situationId":26,"verses":[{"i":6,"strength":"direct","headline":"الخوف من المحاسبة على خواطر النفس","bridge":"شقّت عليك فكرة أن تُحاسب على ما في نفسك؟ نزلت آيةٌ شقّت على الصحابة: ﴿وَإِنْ تُبْدُوا مَا فِي أَنْفُسِكُمْ أَوْ تُخْفُوهُ يُحَاسِبْكُمْ بِهِ اللَّهُ فَيَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ ثم نزل بعدها لا يكلف الله نفسًا إلا وسعها — قدرته على المغفرة ذُكرت قبل قدرته على العذاب، فقدّم الرجاء كما قدّمه."}],"hadiths":[{"i":13,"strength":"direct","headline":"الخوف من المحاسبة على خواطر النفس","bridge":"تخاف الحساب على خواطرك؟ لما نزلت آية ﴿أَوْ تُخْفُوهُ يُحَاسِبْكُم بِهِ اللَّهُ… وَاللَّهُ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ﴾ برك الصحابة على الركب فقالوا: سمعنا وأطعنا — فنزلت: لا يكلف الله نفسًا إلا وسعها."}]},{"situationId":30,"verses":[{"i":3,"strength":"direct","headline":"العجز عن ردّ كيد من يكيد لك وأنت ضعيف","bridge":"تريد أن تردّ على من يكيد لك وأنت في ضعف؟ أُمر المؤمنون في مرحلة الضعف: ﴿فَاعْفُوا وَاصْفَحُوا حَتَّى يَأْتِيَ اللَّهُ بِأَمْرِهِ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — العفو في زمن الضعف موقفُ قوةٍ لا عجز، لأن صاحبه ينتظر أمر قادرٍ على كل شيء؛ فإن قدرتَ فاعفُ كما عفوتَ وأنت لا تقدر."}],"hadiths":[]},{"situationId":40,"verses":[],"hadiths":[{"i":19,"strength":"direct","headline":"دَينٌ عظيم كالجبل يبدو قضاؤه مستحيلًا","bridge":"عليك دينٌ كالجبل؟ قال ﷺ لمعاذ: «ألا أعلمك دعاءً تدعو به لو كان عليك مثل جبلٍ دينًا لأدّاه الله عنك؟ قل يا معاذ: اللهم مالك الملك تؤتي الملك من تشاء… بيدك الخير إنك على كل شيء قدير، رحمن الدنيا والآخرة ورحيمهما… ارحمني رحمة تغنيني بها عن رحمة من سواك» — قضاء الدين يُسند إلى القادر على كل شيء."}]},{"situationId":43,"verses":[{"i":30,"strength":"direct","headline":"التردد في الإنفاق وكأن المال ملكك","bridge":"تتردد في الإنفاق كأن المال مالك؟ افتُتحت سورة الإنفاق: ﴿لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ يُحْيِي وَيُمِيتُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ ثم أُمرت بالإنفاق مما جعلك مستخلفًا فيه — قبل أن تُدعى للإنفاق ذُكّرت بمالك المال؛ فالإنفاق ردٌّ لأمانةٍ لا تنازل عن ملك."}],"hadiths":[]},{"situationId":47,"verses":[{"i":16,"strength":"direct","headline":"التنازع في قسمة مالٍ أعطاكه الله","bridge":"تنازع في قسمة مالٍ أعطاكه الله؟ رُبط تشريع الخمس بذكرى بدر: ﴿وَاعْلَمُوا أَنَّمَا غَنِمْتُمْ مِنْ شَيْءٍ فَأَنَّ لِلَّهِ خُمُسَهُ... وَمَا أَنْزَلْنَا عَلَى عَبْدِنَا يَوْمَ الْفُرْقَانِ... وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — الذي أعطاكم الغنيمة بقدرته هو الذي يشرّع في توزيعها؛ فمن أعطاك بقدرته له حق التشريع في عطائه."}],"hadiths":[]},{"situationId":61,"verses":[],"hadiths":[{"i":11,"strength":"direct","headline":"سبق اللسان بحلفٍ بغير الله أو كلمة شرك","bridge":"سبق لسانك بحلفٍ بغير الله؟ قال النبي ﷺ لمن حلف باللات والعزى: «قل لا إلهَ إلَّا اللَّهُ وحدَهُ لا شريكَ لهُ لهُ الملكُ ولهُ الحمدُ وهوَ على كلِّ شيءٍ قديرٌ» — يُمحى ذكر ما لا يملك شيئًا بذكر القادر على كل شيء."}]},{"situationId":66,"verses":[],"hadiths":[{"i":16,"strength":"direct","headline":"تولّي مالٍ عامٍّ تُسأل عنه","bridge":"بيدك مالٌ عام تُسأل عنه؟ عمر لعلي والعباس: إن الله أفاء على رسوله بني النضير ﴿وَلَكِنَّ اللَّهَ يُسَلِّطُ رُسُلَهُ عَلَى مَنْ يَشَاءُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ فوالله ما استأثر بها — الفيء بلا قتال جاء بقدرة الله، ومن أُوتيه لم يستأثر به؛ فذاك ميزان المال العام."}]},{"situationId":70,"verses":[],"hadiths":[{"i":20,"strength":"direct","headline":"أذى المعتدين وأنت مأمورٌ بالعفو والصبر","bridge":"تؤذى ولا تملك ردًّا؟ أسامة: كان النبي ﷺ وأصحابه يعفون عن المشركين وأهل الكتاب كما أمرهم الله ﴿فَاعْفُوا وَاصْفَحُوا حَتَّى يَأْتِيَ اللَّهُ بِأَمْرِهِ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ حتى أذن الله — العفو المؤقت بانتظار أمر القادر؛ فاصبر ريثما يأتي أمره."}]},{"situationId":86,"verses":[{"i":8,"strength":"direct","headline":"ظنّ أن ما تخفيه في صدرك خارج الحساب","bridge":"تظن أن ما تخفيه في صدرك خارج الحساب؟ ﴿قُلْ إِنْ تُخْفُوا مَا فِي صُدُورِكُمْ أَوْ تُبْدُوهُ يَعْلَمْهُ اللَّهُ وَيَعْلَمُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — علمٌ يكشف وقدرةٌ تجازي: العلم بلا قدرة لا يُخيف والقدرة بلا علم عمياء؛ واجتماعهما هو ما يجعل مراقبة الخلوة جدّية."}],"hadiths":[]},{"situationId":87,"verses":[{"i":26,"strength":"direct","headline":"قلبٌ هامدٌ قاسٍ يحتاج إلى الإحياء","bridge":"قلبك هامدٌ كأرضٍ لم يأتها ماء؟ وُصفت الأرض قبل المطر بـ«خاشعة»: ﴿وَمِنْ آيَاتِهِ أَنَّكَ تَرَى الْأَرْضَ خَاشِعَةً فَإِذَا أَنْزَلْنَا عَلَيْهَا الْمَاءَ اهْتَزَّتْ وَرَبَتْ إِنَّ الَّذِي أَحْيَاهَا لَمُحْيِي الْمَوْتَى إِنَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — وصف القلب القاسي كوصف الأرض: خاشعة تحتاج ماءً؛ فاسأل محيي الأرض أن يحييه."}],"hadiths":[]},{"situationId":94,"verses":[{"i":27,"strength":"direct","headline":"تعلّق القلب بمن لا يقدر على نفعك","bridge":"اتخذت وليًّا لا يقدر على شيء؟ معيار الولي في وصفين: ﴿أَمِ اتَّخَذُوا مِنْ دُونِهِ أَوْلِيَاءَ فَاللَّهُ هُوَ الْوَلِيُّ وَهُوَ يُحْيِي الْمَوْتَى وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — من لا يقدر على إحياء نفسه كيف يُتخذ وليًّا؟ فاختبر كل وليٍّ بسؤالين: أيحيي الموتى؟ أعلى كل شيء قدير؟ تسقط كل الدعاوى."}],"hadiths":[]},{"situationId":99,"verses":[{"i":11,"strength":"direct","headline":"طلب معيار فاصل يفرز العابد من المعبود","bridge":"تريد معيارًا فاصلًا يفرز العابد من المعبود؟ ﴿قُلْ فَمَنْ يَمْلِكُ مِنَ اللَّهِ شَيْئًا إِنْ أَرَادَ أَنْ يُهْلِكَ الْمَسِيحَ ابْنَ مَرْيَمَ وَأُمَّهُ وَمَنْ فِي الْأَرْضِ جَمِيعًا... وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — من كان قابلًا للإهلاك لا يكون إلهًا؛ فقابلية الفناء برهان العبودية، وكل من يقبل الفناء عبد."},{"i":14,"strength":"direct","headline":"دعاوى الشركاء تُعظَّم وتحتاج أن توضع في حجمها","bridge":"تريد أن تضع دعاوى الشركاء في حجمها؟ خُتمت المائدة بعد تبرؤ عيسى: ﴿لِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا فِيهِنَّ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — الملك له وحده وما فيهن، والقدرة على كل شيء؛ فخواتيم السور تحسم مضامينها: بعد نفي إلهية المسيح جاء إعلان الملك والقدرة."}],"hadiths":[]},{"situationId":102,"verses":[],"hadiths":[{"i":10,"strength":"direct","headline":"التعب من أعباء الخدمة وضعف الجسد عنها","bridge":"ضعفٌ وتعبٌ في جسدك؟ شكت فاطمة الخدمة حتى مجلت يداها، فدلّها النبي ﷺ على خيرٍ من الخادم، ومنه تهليلٌ عشرًا بعد الصبح وعشرًا بعد المغرب: «لا إله إلا الله وحده لا شريك له… وهو على كل شيء قدير» — القدرة بدل الخادم."}]},{"situationId":105,"verses":[],"hadiths":[{"i":18,"strength":"direct","headline":"الوسواس والشك في فهم ألفاظ القرآن عن صفات الله","bridge":"أشكل عليك لفظ «كان» في صفات الله؟ جاء رجلٌ ابن عباس فقال: إن في نفسي من القرآن شكًّا؛ أسمع الله يقول ﴿وَكَانَ اللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرًا﴾ كأن هذا أمرٌ قد كان، فقال ابن عباس: «فإنه لم يزل ولا يزال» — «كان» لا تعني الانقطاع: قدرته لم تزل؛ فصحّح فهم الصيغة يذهب الوسواس."}]},{"situationId":108,"verses":[{"i":9,"strength":"direct","headline":"مصيبةٌ تسأل عن سببها وتكاد تتهم فيها القدر","bridge":"أصابتك مصيبة وتسأل: أنّى هذا؟ جواب أُحد صادم: ﴿قُلْ هُوَ مِنْ عِنْدِ أَنْفُسِكُمْ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — كان قادرًا على منعها لكنها جاءت بأسبابٍ منكم لحكمة؛ فأول سؤالٍ بعد كل انتكاسة: ما الذي جاء من عند أنفسنا؟ لا: لماذا فعل الله بنا هذا؟"}],"hadiths":[]},{"situationId":109,"verses":[{"i":5,"strength":"direct","headline":"استبعاد البعث وإعادة الحياة بعد الموت","bridge":"تستبعد إعادة الحياة بعد الموت؟ رجلٌ مرّ على قريةٍ خاوية فقال ﴿أَنَّى يُحْيِي هَذِهِ اللَّهُ بَعْدَ مَوْتِهَا﴾ فأُميت مئة عام ثم بُعث ورأى عظام حماره تُنشز وتُكسى لحمًا، فانتقل من ﴿أَنَّى﴾ إلى ﴿أَعْلَمُ أَنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — العلم اليقيني جاء بالمشاهدة؛ فتأدب في استبعادك."},{"i":19,"strength":"direct","headline":"استبعاد قيام الساعة لعظم أمرها","bridge":"تحسب الساعة بعيدةً لأنها أمرٌ عظيم؟ ﴿وَمَا أَمْرُ السَّاعَةِ إِلَّا كَلَمْحِ الْبَصَرِ أَوْ هُوَ أَقْرَبُ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — من يقدر على كل شيء لا يحتاج زمنًا للتنفيذ؛ فالحدث الأعظم في تاريخ الوجود يقع في أسرع من لمحة، فلا تحسبه بعيدًا."},{"i":20,"strength":"direct","headline":"الريب في البعث وطلب برهانٍ متجدد عليه","bridge":"تريد برهانًا متجددًا على البعث؟ كل ربيعٍ يقرر لك ثلاث حقائق: ﴿ذَلِكَ بِأَنَّ اللَّهَ هُوَ الْحَقُّ وَأَنَّهُ يُحْيِي الْمَوْتَى وَأَنَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — بعد آية الأرض الهامدة تهتز وتربو؛ فلا تمرّ بالخضرة دون أن تقرأها."},{"i":28,"strength":"direct","headline":"استعظام البعث ودعوى أنه فوق القدرة","bridge":"يقال لك إن البعث فوق القدرة؟ ﴿أَوَلَمْ يَرَوْا أَنَّ اللَّهَ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ وَلَمْ يَعْيَ بِخَلْقِهِنَّ بِقَادِرٍ عَلَى أَنْ يُحْيِيَ الْمَوْتَى بَلَى إِنَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — من لم يعيَ بالأعظم لا يعجزه الأصغر، والجواب المؤكد: بلى."}],"hadiths":[]},{"situationId":110,"verses":[{"i":18,"strength":"direct","headline":"طلب اليقين بالبعث والرجوع إلى الله","bridge":"تريد أن يرسخ يقينك بالرجوع؟ ﴿إِلَى اللَّهِ مَرْجِعُكُمْ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — الرجوع إليه ليس احتمالًا بل حتميةٌ مضمونة بقدرةٍ على كل شيء؛ ومن قدر على كل شيء قدر على جمعكم بعد تفرّقكم ترابًا."}],"hadiths":[]},{"situationId":115,"verses":[{"i":34,"strength":"direct","headline":"الخوف من سوء الخاتمة وانطفاء نور الإيمان","bridge":"تخاف أن ينطفئ نورك قبل أن تصل؟ احفظ دعاء أحرج لحظة: ﴿رَبَّنَا أَتْمِمْ لَنَا نُورَنَا وَاغْفِرْ لَنَا إِنَّكَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — طلب تمام النور معلّق على القدرة لا على استحقاقك، فاسأل الإتمام من القدير على كل شيء."}],"hadiths":[]},{"situationId":130,"verses":[{"i":12,"strength":"direct","headline":"اعتذار المدعوين بأنه لم يبلغهم شيء","bridge":"يعتذر من تدعوهم بأنه لم يبلغهم شيء؟ ﴿قَدْ جَاءَكُمْ رَسُولُنَا يُبَيِّنُ لَكُمْ عَلَى فَتْرَةٍ مِنَ الرُّسُلِ أَنْ تَقُولُوا مَا جَاءَنَا مِنْ بَشِيرٍ وَلَا نَذِيرٍ فَقَدْ جَاءَكُمْ بَشِيرٌ وَنَذِيرٌ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — العذر بعدم بلوغ الرسالة انقطع، والقدرة ضمانة إتمام البعثة وحفظها؛ فبلّغ وقد قامت الحجة."}],"hadiths":[]},{"situationId":138,"verses":[{"i":17,"strength":"direct","headline":"ظنّ أن عمل الخير يتوقف عليك وحدك","bridge":"تظن أن مشروع الخير يتوقف عليك؟ ﴿إِلَّا تَنْفِرُوا يُعَذِّبْكُمْ عَذَابًا أَلِيمًا وَيَسْتَبْدِلْ قَوْمًا غَيْرَكُمْ وَلَا تَضُرُّوهُ شَيْئًا وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — تخلّفك لا يعطّل المشروع ولا يضره شيئًا بل يُخرجك من القافلة؛ فالخسارة كلها في جهة واحدة، ولا موضع للمنّ بعملٍ يُستبدل صاحبه."}],"hadiths":[]},{"situationId":142,"verses":[{"i":4,"strength":"direct","headline":"الانشغال بالخلافات الشكلية عن المسابقة إلى الخير","bridge":"شغلتك خلافاتٌ شكلية عن العمل؟ بعد جدل القبلة: ﴿وَلِكُلٍّ وِجْهَةٌ هُوَ مُوَلِّيهَا فَاسْتَبِقُوا الْخَيْرَاتِ أَيْنَ مَا تَكُونُوا يَأْتِ بِكُمُ اللَّهُ جَمِيعًا إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — لا تُشغلك الخلافات عن السباق؛ فإذا احترت بين أقوالٍ فاعمل بما ترجّح واستبق إلى الخير، والقدير يجمع الجميع."}],"hadiths":[]},{"situationId":145,"verses":[{"i":1,"strength":"direct","headline":"استعمال الحواس الموهوبة في معصية واهبها","bridge":"تعصي بحواسٍّ وهبها الله لك؟ في مثل المنافقين: ﴿وَلَوْ شَاءَ اللَّهُ لَذَهَبَ بِسَمْعِهِمْ وَأَبْصَارِهِمْ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — إبقاء حواسهم مع تلاعبهم مهلةٌ من قادرٍ لا عجزٌ عنهم؛ فحواسك التي تعصي بها باقيةٌ بإذنه، ولو شاء لذهب بها، فاستعملها فيما يُبقيها."}],"hadiths":[]},{"situationId":146,"verses":[{"i":31,"strength":"direct","headline":"خيرٌ جاءك بلا جهدٍ والميل إلى نسبته لنفسك","bridge":"جاءك مالٌ أو خيرٌ بلا جهدٍ منك؟ ﴿وَمَا أَفَاءَ اللَّهُ عَلَى رَسُولِهِ مِنْهُمْ فَمَا أَوْجَفْتُمْ عَلَيْهِ مِنْ خَيْلٍ وَلَا رِكَابٍ وَلَكِنَّ اللَّهَ يُسَلِّطُ رُسُلَهُ عَلَى مَنْ يَشَاءُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — مالٌ نُسب إلى القدرة لا إلى الجهد؛ فبعض ما يأتيك لا جهد لك فيه، فلا تنسبه لذكائك واشكر."}],"hadiths":[]},{"situationId":147,"verses":[],"hadiths":[{"i":15,"strength":"direct","headline":"رؤية الفرج ينزل بعد طول جدبٍ وانتظار","bridge":"طال جدبك؟ في الاستسقاء أمطرت في المجلس نفسه حتى سالت السيول، فضحك النبي ﷺ وقال: «أشهد أن الله على كل شيء قدير» — اشهد بها عند أثرها."}]},{"situationId":154,"verses":[{"i":32,"strength":"direct","headline":"طلب ذكرٍ جامعٍ بعد الصلاة","bridge":"تريد ذكرًا جامعًا بعد صلاتك؟ ﴿يُسَبِّحُ لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — ثلاثية الملك والحمد والقدرة؛ فاجمعها في ذكرك كما جمعتها الآية."}],"hadiths":[{"i":3,"strength":"direct","headline":"ختام الصلاة والإقرار بأن القدرة كلها لله","bridge":"دبر كل صلاة؟ كان النبي ﷺ يهلّل بهن: «لا إله إلا الله وحده لا شريك له، له الملك وله الحمد، وهو على كل شيء قدير، لا حول ولا قوة إلا بالله» — بعد أن أديت ما تقدر عليه، أقرّ بأن القدرة كلها لله."}]},{"situationId":156,"verses":[],"hadiths":[{"i":4,"strength":"direct","headline":"دخول المساء وطلب خير الليلة والاستعاذة من شرها","bridge":"تمسي؟ كان النبي ﷺ إذا أمسى قال: «أمسينا وأمسى الملك لله، والحمد لله، لا إله إلا الله وحده لا شريك له، له الملك وله الحمد وهو على كل شيء قدير، اللهم إني أسألك من خير هذه الليلة وخير ما فيها، وأعوذ بك من شرها وشر ما فيها» — الليلة القادمة بقدرته يُسأل خيرها ويُستعاذ من شرها."},{"i":5,"strength":"direct","headline":"البحث عن وردٍ يومي عظيم الأجر حافظٍ من الشيطان","bridge":"وردك؟ «من قال: لا إله إلا الله وحده لا شريك له له الملك وله الحمد وهو على كل شيء قدير — في يوم مائة مرة كانت له عدل عشر رقاب… وحرزًا من الشيطان يومه حتى يمسي»."},{"i":6,"strength":"direct","headline":"دخول الصباح وطلب الحرز من الشيطان حتى المساء","bridge":"تريد حرزًا صباحيًّا محددًا؟ «من قال إذا أصبح: لا إله إلا الله وحده لا شريك له، له الملك وله الحمد، وهو على كل شيء قدير، كان له عدل رقبة من ولد إسماعيل، وكُتب له عشر حسنات، وكان في حرز من الشيطان حتى يمسي» — من أقرّ بالقدرة صباحًا حُفظ بها إلى المساء."},{"i":12,"strength":"direct","headline":"تجديد الشهادة بالتوحيد والقدرة كل صباح","bridge":"تريد عهدًا تجدده كل صباح؟ علّم النبي ﷺ زيد بن ثابت وأمره أن يتعاهد أهله كل صباح: «لبيك اللهم لبيك… أشهد أن لا إله إلا أنت وحدك لا شريك لك، لك الملك ولك الحمد، وأنت على كل شيء قدير، وأشهد أن محمدًا عبدك ورسولك» — عهد الصباح يُشهد فيه بالاسم."},{"i":24,"strength":"direct","headline":"طلب الحفظ في يومك من الصباح إلى المساء","bridge":"تريد ورد حفظٍ ليومك؟ علّم النبي ﷺ إحدى بناته: «قولي حين تصبحين: سبحان الله وبحمده، لا قوة إلا بالله، ما شاء الله كان وما لم يشأ لم يكن، أعلم أن الله على كل شيء قدير وأن الله قد أحاط بكل شيء علمًا — من قالها حين يصبح حُفظ حتى يمسي» — علمٌ بالقدرة والإحاطة يحفظ يومك."}]},{"situationId":157,"verses":[{"i":35,"strength":"direct","headline":"ختم اليوم بورد النوم وتسليم الأمر لله","bridge":"تختم يومك بسورة الملك؟ افتُتحت ببركةٍ وملكٍ وقدرة: ﴿تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ ثم الغاية: ﴿لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ عَمَلًا﴾ — فاقرأها وأنت تسلّم الملك كله لصاحبه قبل أن تنام."}],"hadiths":[{"i":9,"strength":"direct","headline":"يقظة الليل وحاجةٌ تريد أن تسألها ربك","bridge":"تعارّيتَ من الليل؟ «من تعارّ من الليل فقال حين يستيقظ: لا إله إلا الله وحده لا شريك له، له الملك وله الحمد، وهو على كل شيء قدير، سبحان الله والحمد لله ولا إله إلا الله والله أكبر ولا حول ولا قوة إلا بالله، ثم دعا غُفر له» — الذي أيقظك قادر على ما تسأله."},{"i":17,"strength":"direct","headline":"الاستيقاظ من النوم كأنه إحياءٌ بعد موت","bridge":"استيقظت من نومك؟ «وإذا استيقظ ابتدره ملك وشيطان… فإن قال: الحمد لله الذي رد إلي نفسي بعد موتها ولم يمتها في نومها… الحمد لله الذي يحيي الموتى وهو على كل شيء قدير» — الاستيقاظ إحياءٌ بعد موتة النوم؛ فاحمد القادر على الإحياء أول ما تفتح عينيك."}]},{"situationId":159,"verses":[],"hadiths":[{"i":7,"strength":"direct","headline":"دخول السوق وغلبة الغفلة والحرص على الدنيا","bridge":"تدخل السوق؟ قل: «لا إله إلا الله وحده لا شريك له له الملك وله الحمد يحيي ويميت وهو حي لا يموت بيده الخير وهو على كل شيء قدير» — ألف ألف حسنة."}]},{"situationId":160,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"العودة من سفرٍ سالمًا وشكر من ردّك","bridge":"تعود من سفر سالمًا؟ كان النبي ﷺ إذا قفل يقول على كل ثنية: «لا إله إلا الله وحده لا شريك له، له الملك وله الحمد، وهو على كل شيء قدير، آيبون تائبون عابدون ساجدون لربنا حامدون، صدق الله وعده ونصر عبده وهزم الأحزاب وحده» — القدرة التي هزمت الأحزاب ردتك سالمًا؛ فقلها على كل مرتفع."},{"i":22,"strength":"direct","headline":"الخروج للسفر وترك الأهل وراءك","bridge":"تخرج لسفر؟ البراء: كان النبي ﷺ إذا خرج لسفر قال: «اللهم بلاغًا يبلغ خيرًا مغفرةً منك ورضوانًا، بيدك الخير إنك على كل شيء قدير، اللهم أنت الصاحب في السفر والخليفة في الأهل» — السفر يُفتتح بالقدرة: الصاحب في السفر والخليفة في الأهل قادرٌ على الحالين."}]},{"situationId":165,"verses":[],"hadiths":[{"i":23,"strength":"direct","headline":"طلب دعاءٍ جامعٍ للحمد والمغفرة والعصمة","bridge":"تريد دعاءً سمعه الصحابة من ملك؟ حذيفة: سمعت متكلمًا يقول في صلاته: «اللهم لك الحمد كله ولك الملك كله وبيدك الخير كله وإليك يرجع الأمر كله، أهلٌ أن تُحمد أبدًا، إنك على كل شيء قدير، اللهم اغفر لي جميع ما مضى من ذنوبي واعصمني فيما بقي» — فقال ﷺ: ذاك ملك؛ فادعُ بما تدعو به الملائكة."}]},{"situationId":166,"verses":[],"hadiths":[{"i":2,"strength":"direct","headline":"الوقوف على الصفا والدعاء في أثناء النسك","bridge":"تقف على الصفا؟ في حجة الوداع وقف النبي ﷺ على الصفا فقال ثلاثًا: «لا إله إلا الله وحده لا شريك له، له الملك وله الحمد، وهو على كل شيء قدير، أنجز وعده ونصر عبده وهزم الأحزاب وحده» ودعا بين ذلك — الصفا موضع الإقرار بالقدرة والدعاء؛ فقلها ثلاثًا وادعُ بينها."},{"i":8,"strength":"direct","headline":"الحيرة فيما يُذكر به عند الوقوف بعرفة","bridge":"تقف بعرفة ولا تدري بم تذكر؟ «ما من مسلم يقف عشية عرفة بالموقف فيستقبل القبلة بوجهه ثم يقول: لا إله إلا الله وحده لا شريك له، له الملك وله الحمد، يحيي ويميت، وهو على كل شيء قدير مائة مرة» ثم الإخلاص والصلاة على النبي ﷺ — فيقول الله: «اشهدوا ملائكتي أني قد غفرت له»."}]},{"situationId":174,"verses":[{"i":25,"strength":"direct","headline":"حصر إمكان الخلق فيما تعرفه من مخلوقات","bridge":"تحصر الوجود فيما تعرفه من مخلوقات؟ ﴿الْحَمْدُ لِلَّهِ فَاطِرِ السَّمَاوَاتِ وَالْأَرْضِ جَاعِلِ الْمَلَائِكَةِ رُسُلًا أُولِي أَجْنِحَةٍ مَثْنَى وَثُلَاثَ وَرُبَاعَ يَزِيدُ فِي الْخَلْقِ مَا يَشَاءُ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — باب الخلق لم يُغلق؛ فلا تحصر إمكان الله في المعلوم لك، ويزيد في الخلق ما يشاء."}],"hadiths":[]},{"situationId":175,"verses":[{"i":10,"strength":"direct","headline":"التفكر في خلق السماوات والأرض طلبًا لليقين","bridge":"تتفكر في خلق السماوات والأرض؟ ابدأ من حيث بدأ السياق: ﴿وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ ثم بعدها مباشرة تفكّر أولي الألباب وقولهم: ﴿رَبَّنَا مَا خَلَقْتَ هَذَا بَاطِلًا﴾ — التفكر في الكون طريقٌ إلى اليقين بالقدرة، وهو ما فعله أولو الألباب."},{"i":21,"strength":"direct","headline":"الانبهار بتنوّع الأحياء من أصلٍ واحد","bridge":"يبهرك تنوع الأحياء؟ ﴿وَاللَّهُ خَلَقَ كُلَّ دَابَّةٍ مِنْ مَاءٍ فَمِنْهُمْ مَنْ يَمْشِي عَلَى بَطْنِهِ وَمِنْهُمْ مَنْ يَمْشِي عَلَى رِجْلَيْنِ وَمِنْهُمْ مَنْ يَمْشِي عَلَى أَرْبَعٍ يَخْلُقُ اللَّهُ مَا يَشَاءُ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — من مادةٍ واحدة تنوعٌ هائل؛ فوحدة المادة مع هذا التنوع أعظم ما يبهر دارسي الأحياء، وهو برهان الآية."},{"i":22,"strength":"direct","headline":"دراسة أصل الحياة وبدايات الخلق بحثًا واستدلالًا","bridge":"تدرس أصل الحياة وتظنه بعيدًا عن الدين؟ دعوةٌ قرآنية صريحة: ﴿قُلْ سِيرُوا فِي الْأَرْضِ فَانْظُرُوا كَيْفَ بَدَأَ الْخَلْقَ ثُمَّ اللَّهُ يُنْشِئُ النَّشْأَةَ الْآخِرَةَ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — بحثٌ ميداني في بدايات الخلق ليُستدل به على الإعادة؛ فالقرآن يدعو إلى دراسة أصل الحياة منهجًا استدلاليًّا لا تسليمًا مجردًا."}],"hadiths":[]},{"situationId":176,"verses":[{"i":23,"strength":"direct","headline":"رؤية الخضرة والربيع بعد الجدب","bridge":"رأيت أرضًا خضراء بعد جدب؟ أنت تنظر إلى «آثار رحمة الله»: ﴿فَانْظُرْ إِلَى آثَارِ رَحْمَتِ اللَّهِ كَيْفَ يُحْيِي الْأَرْضَ بَعْدَ مَوْتِهَا إِنَّ ذَلِكَ لَمُحْيِي الْمَوْتَى وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — النظر فيها مأمورٌ به، والتأمل في الربيع عبادةٌ توصل إلى اليقين بالبعث."}],"hadiths":[]},{"situationId":191,"verses":[],"hadiths":[{"i":25,"strength":"direct","headline":"البحث عن سورةٍ تشفع لك حتى يُغفر لك","bridge":"تريد سورةً تشفع لك؟ «في القرآن سورة ثلاثون آية شفعت لصاحبها حتى غُفر له: ﴿تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾» — مطلع السورة الشافعة: الملك والقدرة؛ فداوم على الملك."}]}]},{"id":146,"name":"الله العزيز العليم غافر الذنب وقابل التوب شديد العقاب ذي الطول","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: اللَّهِ الْعَزِيزِ الْعَلِيمِ * غَافِرِ الذَّنْبِ وَقَابِلِ التَّوْبِ شَدِيدِ الْعِقَابِ ذِي الطَّوْلِ — مركّبة ممتدة | المواضع: 2 (غافر: 2-3)\nخصوصية: أطولُ نسقٍ متتابع من الأسماء في فواتح السور — ستُّ صفاتٍ في آيتين، وبها سُمّيت السورة «غافر».\n\nالمعنى:\n- العزيز العليم: الغالب المحيط علمًا.\n- غافر الذنب: الساتر الماحي.\n- قابل التوب: الذي يقبل الرجوع.\n- شديد العقاب: لمن أصرّ.\n- ذو الطول: صاحب الفضل والسعة والغنى.","teaches":"الحقائق التي كشفها الموضعان:\n1. الترتيب رحمة: مغفرةٌ فقبولٌ ثم شدةٌ ثم فضل.\n2. الكتاب محميٌّ بعزةٍ وعلم في وجه كل طاغية.\n3. «ذو الطول»: الفضل والسعة — ختامٌ يفتح باب الرجاء.","whenRecall":"لحظات الاستحضار — مشتقة من موضعيه:\n- عند اختلال ميزانك بين الخوف والرجاء.\n- عند مواجهة طغيانٍ يستهدف الدين.","whenPray":"بنود الدعاء — مشتقة من سياق الموضعين:\n1. التوسل بالصفات الأربع مجتمعة — غافر 3.\n2. سؤال المغفرة وقبول التوبة والاستعاذة من شدة العقاب.\n3. من السنة: «اللَّهُمَّ إِنِّي أَعُوذُ بِرِضَاكَ مِنْ سَخَطِكَ» — رواه مسلم.","summary":"أدقُّ عرضٍ مختصر لمن تعبد: ﴿غَافِرِ الذَّنْبِ وَقَابِلِ التَّوْبِ شَدِيدِ الْعِقَابِ ذِي الطَّوْلِ﴾ — شدةٌ محفوفةٌ بمغفرتين وفضل.","verses":[{"i":1,"of":1,"s":40,"surah":"غافر","a":2,"last":3,"text":"تَنْزِيلُ الْكِتَابِ مِنَ اللَّهِ الْعَزِيزِ الْعَلِيمِ غَافِرِ الذَّنْبِ وَقَابِلِ التَّوْبِ شَدِيدِ الْعِقَابِ ذِي الطَّوْلِ لَا إِلَهَ إِلَّا هُوَ إِلَيْهِ الْمَصِيرُ","prev":{"a":1,"text":"حم"},"next":{"a":4,"text":"مَا يُجَادِلُ فِي آيَاتِ اللَّهِ إِلَّا الَّذِينَ كَفَرُوا فَلَا يَغْرُرْكَ تَقَلُّبُهُمْ فِي الْبِلَادِ"},"context":"﴿حم * تَنْزِيلُ الْكِتَابِ مِنَ اللَّهِ الْعَزِيزِ الْعَلِيمِ﴾ — مطلع سورةٍ تحكي أعنف صراعٍ بين الحق والطغيان.","reason":"قُدّمت العزةُ والعلم على بقية الصفات لأنهما ضمانةُ الكتاب في وجه فرعون وأمثاله: عزيزٌ يحمي كتابه ورسوله، عليمٌ بما يبيّته المتآمرون. فالسورةُ التي تحكي كيد فرعون تفتتح بمن لا يُغلب ولا يُخدع.","adds":"افتتاح السورة يحدد نتيجتها: كتابٌ من عزيزٍ عليم لا يُهزم حاملُه مهما بلغ خصمه."}],"hadiths":[],"situations":[{"situationId":22,"verses":[{"i":1,"strength":"direct","headline":"التأرجح بين الخوف من العقاب ورجاء المغفرة","bridge":"تريد صورة الله المتوازنة في آية؟ احفظ فاتحة غافر: ﴿غَافِرِ الذَّنْبِ وَقَابِلِ التَّوْبِ شَدِيدِ الْعِقَابِ ذِي الطَّوْلِ لَا إِلَهَ إِلَّا هُوَ إِلَيْهِ الْمَصِيرُ﴾ — غفرانٌ للذنب وقبولٌ للتوبة، ثم شدة عقابٍ لمن أبى، ثم فضلٌ وسعة: أُحيطت الشدة بين مغفرتين وفضل؛ فلا تقنط ولا تأمن، و﴿إِلَيْهِ الْمَصِيرُ﴾."}],"hadiths":[]}]},{"id":147,"name":"العزيز المقتدر","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: عَزِيزٍ مُقْتَدِرٍ — مركّبة | المواضع: 1 (القمر: 42)\nخصوصية: وُصف به «الأخذ» نفسه: ﴿أَخْذَ عَزِيزٍ مُقْتَدِرٍ﴾ — فهو اسمُ صفة الأخذ لا صفة الآخذ فقط.\n\nالمعنى:\n- العزيز: الغالب الذي لا يُفلَت منه.\n- المقتدر: البالغُ تمام القدرة.","teaches":"الحقائق التي كشفها الموضع:\n1. الأخذ على قدر الجريمة: تكذيبٌ شامل فأخذٌ شامل.\n2. لا إفلات من عزيزٍ ولا إعجاز لمقتدر.\n3. القرآن مُيسّر للذكر — والسؤال المتكرر: ﴿فَهَلْ مِنْ مُدَّكِرٍ﴾.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند قراءة مصارع الأمم.\n- عند ظنّ الطغاة أنهم بمنأى عن الحساب.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. الاستعاذة من أخذ العزيز المقتدر — القمر 42.\n2. سؤال أن تكون من المدّكرين: ﴿فَهَلْ مِنْ مُدَّكِرٍ﴾.\n3. تدبر سورة القمر والاتعاظ بمصارع المكذبين.","summary":"لم يقل «أخذناهم» فحسب بل ﴿أَخْذَ عَزِيزٍ مُقْتَدِرٍ﴾ — أخذٌ لا إفلات منه ولا إعجاز: ﴿فَهَلْ مِنْ مُدَّكِرٍ﴾؟","verses":[{"i":1,"of":1,"s":54,"surah":"القمر","a":42,"text":"كَذَّبُوا بِآيَاتِنَا كُلِّهَا فَأَخَذْنَاهُمْ أَخْذَ عَزِيزٍ مُقْتَدِرٍ","prev":{"a":41,"text":"وَلَقَدْ جَاءَ آلَ فِرْعَوْنَ النُّذُرُ"},"next":{"a":43,"text":"أَكُفَّارُكُمْ خَيْرٌ مِنْ أُولَئِكُمْ أَمْ لَكُمْ بَرَاءَةٌ فِي الزُّبُرِ"},"context":"بعد مصرع قوم لوط في سورة القمر يُختم عرض المصارع بآل فرعون: ﴿وَلَقَدْ جَاءَ آلَ فِرْعَوْنَ النُّذُرُ * كَذَّبُوا بِآيَاتِنَا كُلِّهَا فَأَخَذْنَاهُمْ أَخْذَ عَزِيزٍ مُقْتَدِرٍ﴾.","reason":"﴿كَذَّبُوا بِآيَاتِنَا كُلِّهَا﴾ — تكذيبٌ شامل بعد آياتٍ متتابعة، فكان الأخذُ على قدره: ﴿أَخْذَ عَزِيزٍ مُقْتَدِرٍ﴾ — لا أخذَ غضبٍ عابر بل أخذَ من لا يُفلت منه ولا يُعجَز. فوصفُ الأخذ يناسب حجم الجريمة.","adds":"بعد المصرع سؤالُ الاتعاظ: ﴿أَكُفَّارُكُمْ خَيْرٌ مِنْ أُولَئِكُمْ أَمْ لَكُمْ بَرَاءَةٌ فِي الزُّبُرِ﴾ — فمن كذّب بالآيات كلها لم يكن بمنجاةٍ من أخذ العزيز المقتدر."}],"hadiths":[],"situations":[{"situationId":28,"verses":[{"i":1,"strength":"direct","headline":"ظلمٌ من قويٍّ لا تقدر على دفعه","bridge":"ظُلمتَ من قويٍّ لا تقدر عليه؟ آل فرعون كانوا أقوى من ظُلم بهم قوم، ثم ﴿فَأَخَذْنَاهُمْ أَخْذَ عَزِيزٍ مُقْتَدِرٍ﴾ — عزيزٌ لا يُمنع من ظالم، مقتدرٌ لا يعجزه؛ فالذي ظلمك مهما قوي لا يخرج عن أخذ العزيز المقتدر."}],"hadiths":[]}]},{"id":148,"name":"الله رب العرش","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: اللَّهِ رَبِّ الْعَرْشِ — مضافة | المواضع: 1 (الأنبياء: 22)\nخصوصية: جاء عقب أشهر برهانٍ عقلي على التوحيد: برهان التمانع.\n\nالمعنى:\n- رب العرش: مالكُ العرش الأعظم ومدبّرُه — وهو أعلى المخلوقات وسقفُها.","teaches":"الحقائق التي كشفها الموضع:\n1. برهان التمانع: التعدد يستلزم الفساد، والانتظام يبرهن الوحدانية.\n2. ملكُ العرش يستلزم انفراد التدبير.\n3. جواب الأوصاف الباطلة: التسبيح.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند التفكر في انتظام الكون.\n- عند مواجهة شبهةٍ في التوحيد.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. التسبيح عند سماع الباطل: ﴿فَسُبْحَانَ اللَّهِ رَبِّ الْعَرْشِ عَمَّا يَصِفُونَ﴾ — الأنبياء 22.\n2. التوسل برب العرش في الكرب — كما في دعاء الكرب المتفق عليه.","summary":"انتظامُ الكون برهانُ وحدانية مدبّره: ﴿لَوْ كَانَ فِيهِمَا آلِهَةٌ إِلَّا اللَّهُ لَفَسَدَتَا﴾ — فسبحان الله رب العرش عما يصفون.","verses":[{"i":1,"of":1,"s":21,"surah":"الأنبياء","a":22,"text":"لَوْ كَانَ فِيهِمَا آلِهَةٌ إِلَّا اللَّهُ لَفَسَدَتَا فَسُبْحَانَ اللَّهِ رَبِّ الْعَرْشِ عَمَّا يَصِفُونَ","prev":{"a":21,"text":"أَمِ اتَّخَذُوا آلِهَةً مِنَ الْأَرْضِ هُمْ يُنْشِرُونَ"},"next":{"a":23,"text":"لَا يُسْأَلُ عَمَّا يَفْعَلُ وَهُمْ يُسْأَلُونَ"},"reason":"برهانُ التمانع: تعدّدُ الآلهة يستلزم تعارضَ الإرادات فالفساد — والكونُ منتظم، فالإلهُ واحد. ثم التنزيه بوصف الربوبية للعرش: فالذي يملك أعلى المخلوقات لا يُشارَك في تدبير ما دونها.","adds":"انتظامُ الكون دليلٌ يوميٌّ على وحدانية مدبّره: لو تعددت الإرادات لاختلّ النظام — فكل شروقٍ منتظم برهانُ توحيد."}],"hadiths":[],"situations":[{"situationId":106,"verses":[{"i":1,"strength":"direct","headline":"شبهاتٌ في تعدد الآلهة أو القوى المدبّرة للكون","bridge":"شبهةٌ في تعدد الآلهة أو القوى المدبّرة؟ برهان التمانع في آية: ﴿لَوْ كَانَ فِيهِمَا آلِهَةٌ إِلَّا اللَّهُ لَفَسَدَتَا فَسُبْحَانَ اللَّهِ رَبِّ الْعَرْشِ عَمَّا يَصِفُونَ﴾ — تعدد الآلهة يستلزم تعارض الإرادات فالفساد، والكون منتظم فالإله واحد؛ حجةٌ تحملها في جملة."}],"hadiths":[]}]},{"id":149,"name":"على كل شيء رقيب","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: عَلَى كُلِّ شَيْءٍ رَقِيبًا — | المواضع: 1 (الأحزاب: 52)\nخصوصية: جاء في أخصّ شؤون بيت النبوة — ما يدل أن الرقابة تصل إلى أدق الخواطر في أخصّ العلاقات.\n\nالمعنى:\n- الرقيب: الحافظ المراقب الذي لا يغيب عنه شيء — رقابةُ حفظٍ وإحصاء.","teaches":"الحقائق التي كشفها الموضع:\n1. الرقابة تبلغ الخواطر لا الأفعال فقط.\n2. الوفاء لمن ضحّت: قُيّد النبي ﷺ مكافأةً لأزواجه.\n3. أخصّ شؤون البيوت داخلة في دائرة الرقابة.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند نظرةٍ أو خاطرٍ عابر.\n- عند الوفاء لمن وقف معك في ضيقك.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. سؤال حفظ القلب والبصر: ﴿قُلْ لِلْمُؤْمِنِينَ يَغُضُّوا مِنْ أَبْصَارِهِمْ﴾.\n2. استحضار الرقيب عند الخلوات.\n3. الوفاء لأهل البيت والزوجة كما وفّى النبي ﷺ.","summary":"رقابةٌ تسبق الفعل إلى الخاطر: ﴿وَلَوْ أَعْجَبَكَ حُسْنُهُنَّ... وَكَانَ اللَّهُ عَلَى كُلِّ شَيْءٍ رَقِيبًا﴾.","verses":[{"i":1,"of":1,"s":33,"surah":"الأحزاب","a":52,"text":"لَا يَحِلُّ لَكَ النِّسَاءُ مِنْ بَعْدُ وَلَا أَنْ تَبَدَّلَ بِهِنَّ مِنْ أَزْوَاجٍ وَلَوْ أَعْجَبَكَ حُسْنُهُنَّ إِلَّا مَا مَلَكَتْ يَمِينُكَ وَكَانَ اللَّهُ عَلَى كُلِّ شَيْءٍ رَقِيبًا","prev":{"a":51,"text":"تُرْجِي مَنْ تَشَاءُ مِنْهُنَّ وَتُؤْوِي إِلَيْكَ مَنْ تَشَاءُ وَمَنِ ابْتَغَيْتَ مِمَّنْ عَزَلْتَ فَلَا جُنَاحَ عَلَيْكَ ذَلِكَ أَدْنَى أَنْ تَقَرَّ أَعْيُنُهُنَّ وَلَا يَحْزَنَّ وَيَرْضَيْنَ بِمَا آتَيْتَهُنَّ كُلُّهُنَّ وَاللَّهُ يَعْلَمُ مَا فِي قُلُوبِكُمْ وَكَانَ اللَّهُ عَلِيمًا حَلِيمًا"},"next":{"a":53,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَدْخُلُوا بُيُوتَ النَّبِيِّ إِلَّا أَنْ يُؤْذَنَ لَكُمْ إِلَى طَعَامٍ غَيْرَ نَاظِرِينَ إِنَاهُ وَلَكِنْ إِذَا دُعِيتُمْ فَادْخُلُوا فَإِذَا طَعِمْتُمْ فَانْتَشِرُوا وَلَا مُسْتَأْنِسِينَ لِحَدِيثٍ إِنَّ ذَلِكُمْ كَانَ يُؤْذِي النَّبِيَّ فَيَسْتَحْيِي مِنْكُمْ وَاللَّهُ لَا يَسْتَحْيِي مِنَ الْحَقِّ وَإِذَا سَأَلْتُمُوهُنَّ مَتَاعًا فَاسْأَلُوهُنَّ مِنْ وَرَاءِ حِجَابٍ ذَلِكُمْ أَطْهَرُ لِقُلُوبِكُمْ وَقُلُوبِهِنَّ وَمَا كَانَ لَكُمْ أَنْ تُؤْذُوا رَسُولَ اللَّهِ وَلَا أَنْ تَنْكِحُوا أَزْوَاجَهُ مِنْ بَعْدِهِ أَبَدًا إِنَّ ذَلِكُمْ كَانَ عِنْدَ اللَّهِ عَظِيمًا"},"reason":"قيدٌ خاص بالنبي ﷺ مكافأةً لأزواجه اللاتي اخترن الله ورسوله — و﴿وَلَوْ أَعْجَبَكَ حُسْنُهُنَّ﴾ يمسّ الميل القلبي نفسه، فناسبه «الرقيب»: رقابةٌ تصل إلى الإعجاب الخاطر قبل الفعل.","adds":"الرقابة تسبق الفعل إلى الخاطر: ﴿وَلَوْ أَعْجَبَكَ حُسْنُهُنَّ﴾ — فاحفظ قلبك كما تحفظ جوارحك."}],"hadiths":[],"situations":[{"situationId":74,"verses":[{"i":1,"strength":"direct","headline":"خاطر إعجابٍ بمحرّمٍ تستهين به","bridge":"خاطرُ إعجابٍ تظن أنه لا يُحصى؟ الآية قيّدت أشرف الخلق ﴿وَلَوْ أَعْجَبَكَ حُسْنُهُنَّ﴾ وختمت بالرقيب على كل شيء — فما تراه أصغر من أن يُرصد مرصود؛ والرقيب لا يستثني الخواطر."}],"hadiths":[]}]},{"id":150,"name":"الغفور الودود ذو العرش المجيد فعال لما يريد","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: الْغَفُورُ الْوَدُودُ * ذُو الْعَرْشِ الْمَجِيدُ * فَعَّالٌ لِمَا يُرِيدُ — نسق متتابع | المواضع: 3 (البروج: 14-16)\nخصوصية: أسماءٌ متتابعة في ختام قصة أصحاب الأخدود — بعد أشد مشهد تعذيبٍ في القرآن.\n\nالمعنى:\n- الغفور الودود: يغفر ويحب.\n- ذو العرش المجيد: صاحب العرش، الماجد ذو الشرف والكرم.\n- فعال لما يريد: نافذُ الإرادة بلا معقّب.","teaches":"الحقائق التي كشفتها المواضع:\n1. البطش بالظالمين لا ينفي الود بالمبتلين.\n2. المجد لصاحب العرش لا لمن يستعرض في حفرة.\n3. عدم النجاة الظاهرة إرادةٌ نافذة لحكمة — والفوز الكبير محفوظ.","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- عند ابتلاءٍ لا ترى فيه نجاةً ظاهرة.\n- عند استعراض الظالمين لقوتهم.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. سؤال الود مع المغفرة: «اللهم اجعلني ممن تحب».\n2. سؤال الفوز الكبير الموعود لأهل الأخدود — البروج 11.\n3. التسليم لنفاذ إرادته فيما لا تفهم.","summary":"بعد أشد مشهد تعذيبٍ في القرآن جاءت الأسماء: ﴿الْغَفُورُ الْوَدُودُ * ذُو الْعَرْشِ الْمَجِيدُ * فَعَّالٌ لِمَا يُرِيدُ﴾ — بطشٌ بالظالم، وودٌّ بالمبتلى، وإرادةٌ نافذة لحكمة.","verses":[{"i":1,"of":1,"s":85,"surah":"البروج","a":14,"last":16,"text":"وَهُوَ الْغَفُورُ الْوَدُودُ ذُو الْعَرْشِ الْمَجِيدُ فَعَّالٌ لِمَا يُرِيدُ","prev":{"a":13,"text":"إِنَّهُ هُوَ يُبْدِئُ وَيُعِيدُ"},"next":{"a":17,"text":"هَلْ أَتَاكَ حَدِيثُ الْجُنُودِ"},"context":"بعد ﴿إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ * إِنَّهُ هُوَ يُبْدِئُ وَيُعِيدُ﴾: ﴿وَهُوَ الْغَفُورُ الْوَدُودُ﴾.","reason":"عقب ذكر البطش الشديد مباشرةً جاء الغفور الودود: فالباطشُ بالطغاة هو الغفورُ الودود لمن رجع — والودُّ هنا لافت: بعد مشهدٍ حُرق فيه المؤمنون، يذكّرهم بأنه «ودود» يحبهم؛ فأجرُهم محبةٌ لا مجرد تعويض.","adds":"أشدُّ ما يُطمئن المبتلى: أن الذي ابتلاه «ودود» — يحبه؛ فالبلاء لا ينفي الود."}],"hadiths":[],"situations":[{"situationId":35,"verses":[{"i":1,"strength":"direct","headline":"ابتلاءٌ في الدين يوهمك انقطاع محبة الله","bridge":"تُعذَّب لأجل دينك؟ الآية جاءت بعد مشهدٍ حُرق فيه المؤمنون، وذكّرتهم بأنه ﴿الْغَفُورُ الْوَدُودُ﴾ — يحبهم؛ أشدّ ما يُطمئن المبتلى أن الذي ابتلاه ودودٌ يحبه، فالأذى الذي تناله لا ينقص من ودّه لك."}],"hadiths":[]}]},{"id":151,"name":"العزيز الوهاب","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: الْعَزِيزِ الْوَهَّابِ — مركّبة | المواضع: 1 (ص: 9)\nخصوصية: جاء في سياق تعجّبهم من نزول الذكر على محمد ﷺ دونهم — أي في سياق الحسد على العطاء.\n\nالمعنى:\n- العزيز: الغالب الذي لا يُنازَع في عطائه.\n- الوهاب: كثير الهبة — يعطي بلا مقابلٍ ولا سببٍ من الموهوب له.","teaches":"الحقائق التي كشفها الموضع:\n1. الاعتراض على قسمة الله ادعاءُ ملكيةٍ للخزائن.\n2. الهبة بلا مقابل: «وهّاب» صيغة مبالغة.\n3. الاصطفاء لا يخضع لمعايير الناس.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند حسد نعمةٍ عند غيرك.\n- عند طلب هبةٍ لا سبب لك فيها (ولد، علم، فرصة).","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. دعاء سليمان: ﴿رَبِّ اغْفِرْ لِي وَهَبْ لِي مُلْكًا لَا يَنْبَغِي لِأَحَدٍ مِنْ بَعْدِي إِنَّكَ أَنْتَ الْوَهَّابُ﴾ — ص 35.\n2. دعاء الراسخين: ﴿وَهَبْ لَنَا مِنْ لَدُنْكَ رَحْمَةً إِنَّكَ أَنْتَ الْوَهَّابُ﴾ — آل عمران 8.\n3. طرد الحسد بتذكر أن الخزائن ليست بيدك ولا بيدهم.","summary":"من اعترض على قسمة الله يُسأل: ﴿أَمْ عِنْدَهُمْ خَزَائِنُ رَحْمَةِ رَبِّكَ الْعَزِيزِ الْوَهَّابِ﴾؟ — الخزائن ليست بيدك، لكنك تملك أن تسأل الوهّاب.","verses":[{"i":1,"of":1,"s":38,"surah":"ص","a":9,"text":"أَمْ عِنْدَهُمْ خَزَائِنُ رَحْمَةِ رَبِّكَ الْعَزِيزِ الْوَهَّابِ","prev":{"a":8,"text":"أَأُنْزِلَ عَلَيْهِ الذِّكْرُ مِنْ بَيْنِنَا بَلْ هُمْ فِي شَكٍّ مِنْ ذِكْرِي بَلْ لَمَّا يَذُوقُوا عَذَابِ"},"next":{"a":10,"text":"أَمْ لَهُمْ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا فَلْيَرْتَقُوا فِي الْأَسْبَابِ"},"context":"﴿أَمْ عِنْدَهُمْ خَزَائِنُ رَحْمَةِ رَبِّكَ الْعَزِيزِ الْوَهَّابِ﴾ — ردًّا على قولهم ﴿أَأُنْزِلَ عَلَيْهِ الذِّكْرُ مِنْ بَيْنِنَا﴾.","reason":"استفهامٌ إنكاري يفضح دعواهم: أيملكون خزائن الرحمة حتى يوزعوا النبوة؟ — والخزائن لعزيزٍ وهاب: عزيزٌ لا يُملى عليه، وهّابٌ يهب لمن يشاء بلا استحقاق. فاعتراضُهم على توزيع ما لا يملكون.","adds":"من اعترض على قسمة الله فليسأل نفسه: ﴿أَمْ عِنْدَهُمْ خَزَائِنُ رَحْمَةِ رَبِّكَ﴾؟"}],"hadiths":[],"situations":[{"situationId":84,"verses":[{"i":1,"strength":"direct","headline":"الاعتراض في النفس على قسمة الله بين الناس","bridge":"تنظر إلى ما عند غيرك وتعترض في نفسك على القسمة؟ سؤالٌ إنكاري يفضح كل اعتراض: ﴿أَمْ عِنْدَهُمْ خَزَائِنُ رَحْمَةِ رَبِّكَ الْعَزِيزِ الْوَهَّابِ﴾ — الخزائن لعزيزٍ لا يُملى عليه، وهّابٍ يهب لمن يشاء بلا استحقاق؛ فمن اعترض على القسمة فليسأل نفسه: أعندي الخزائن؟"}],"hadiths":[]}]},{"id":152,"name":"رب العرش العظيم","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: رَبُّ الْعَرْشِ الْعَظِيمِ — مضافة | المواضع: 3 (التوبة: 129 — المؤمنون: 86 — النمل: 26)\nخصوصية: خاتمة سورة التوبة — آخرِ ما نزل — وفيها آيةُ الحسبنة التي هي مفزع كل مكفيّ.\n\nالمعنى:\n- رب العرش العظيم: مالكُ أعظم المخلوقات ومدبّرُه — فما دونه أهون.","teaches":"الحقائق التي كشفتها المواضع:\n1. الحسبنة برب العرش تكفي إعراض الخلق كلهم.\n2. الإقرار بالربوبية حجةٌ تُلزم بالتقوى.\n3. عروش الملوك تصغر أمام ربوبية العرش العظيم.","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- عند إعراض الناس عنك أو خذلانهم.\n- عند الكرب — فالصيغة في دعاء الكرب.\n- عند رؤية عروش السلطة والمال.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. ﴿حَسْبِيَ اللَّهُ لَا إِلَهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ﴾ — سبعًا صباحًا ومساءً (أثر أبي الدرداء).\n2. دعاء الكرب المتفق عليه: «لَا إِلَهَ إِلَّا اللَّهُ رَبُّ الْعَرْشِ الْعَظِيمِ».\n3. سجود التلاوة عند النمل 26.","summary":"إن تولّى عنك الناس فلديك خاتمة التوبة: ﴿حَسْبِيَ اللَّهُ لَا إِلَهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ﴾.","verses":[{"i":1,"of":2,"s":9,"surah":"التوبة","a":129,"text":"فَإِنْ تَوَلَّوْا فَقُلْ حَسْبِيَ اللَّهُ لَا إِلَهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ","prev":{"a":128,"text":"لَقَدْ جَاءَكُمْ رَسُولٌ مِنْ أَنْفُسِكُمْ عَزِيزٌ عَلَيْهِ مَا عَنِتُّمْ حَرِيصٌ عَلَيْكُمْ بِالْمُؤْمِنِينَ رَءُوفٌ رَحِيمٌ"},"context":"خاتمة التوبة: ﴿فَإِنْ تَوَلَّوْا فَقُلْ حَسْبِيَ اللَّهُ لَا إِلَهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ﴾.","reason":"الشرطُ ﴿فَإِنْ تَوَلَّوْا﴾ — إعراضُ الناس — والجوابُ حسبنةٌ مبنيةٌ على ثلاث: توحيدٍ، وتوكل، وربوبيةٍ للعرش العظيم؛ فمن كان حسبُه ربَّ العرش لم يضره إعراض الأرض كلها.","adds":"زادُ ساعة الإعراض: إذا تولّى الناس فقل ﴿حَسْبِيَ اللَّهُ﴾ — فمن كان حسبُه ربَّ العرش العظيم كفاه عن الأرض كلها."},{"i":2,"of":2,"s":27,"surah":"النمل","a":26,"text":"اللَّهُ لَا إِلَهَ إِلَّا هُوَ رَبُّ الْعَرْشِ الْعَظِيمِ","prev":{"a":25,"text":"أَلَّا يَسْجُدُوا لِلَّهِ الَّذِي يُخْرِجُ الْخَبْءَ فِي السَّمَاوَاتِ وَالْأَرْضِ وَيَعْلَمُ مَا تُخْفُونَ وَمَا تُعْلِنُونَ"},"next":{"a":27,"text":"قَالَ سَنَنْظُرُ أَصَدَقْتَ أَمْ كُنْتَ مِنَ الْكَاذِبِينَ"},"context":"في قصة الهدهد وسبأ، بعد ذكر سجودهم للشمس: ﴿اللَّهُ لَا إِلَهَ إِلَّا هُوَ رَبُّ الْعَرْشِ الْعَظِيمِ﴾.","reason":"قابلَ عرشَ بلقيس العظيم — الذي ذُكر في السياق — بعرش الرحمن: لها عرشٌ عظيم، ولله ربوبيةُ العرش العظيم حقًّا؛ فالمقابلةُ تضع مُلك الملوك في حجمه. وهي آيةُ سجدةٍ في القرآن.","adds":"في السياق نفسه عرشان: عرشُ ملكةٍ عظيم، وعرشُ الرحمن — والفرق يوضع أمام عينيك مباشرة."}],"hadiths":[{"i":1,"of":7,"text":"أنَّ نَبيَّ اللهِ صلَّى اللهُ عليه وسلَّم كان يقولُ عِندَ الكَربِ: لا إلَهَ إلَّا اللهُ العَظيمُ الحَليمُ، لا إلَهَ إلَّا اللهُ رَبُّ العَرشِ العَظيمِ، لا إلَهَ إلَّا اللهُ رَبُّ السَّمَواتِ ورَبُّ الأرضِ ورَبُّ العَرشِ الكَريمِ. وفي روايةٍ: أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم كان يَدعو بهنَّ ويقولُهنَّ عِندَ الكَربِ، فذَكَرَ بمِثلِ حَديثِ مُعاذِ بنِ هِشامٍ، عن أبيه، عن قَتادةَ، غيرَ أنَّه قال: رَبُّ السَّمَواتِ والأرضِ. وفي روايةٍ: أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم كانَ إذا حَزَبَه أمرٌ، قال: فذَكَرَ بمِثلِ حَديثِ مُعاذٍ، عن أبيه. وزادَ معهُنَّ: لا إلَهَ إلَّا اللهُ رَبُّ العَرشِ الكَريمِ.","narrator":"عبدالله بن عباس","source":"صحيح مسلم 2730","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/9gq6zyAJ","nameForm":"رَبُّ العَرشِ العَظيمِ","scene":"ابن عباس: كان النبي ﷺ يقول عند الكرب: «لا إله إلا الله العظيم الحليم، لا إله إلا الله رب العرش العظيم، لا إله إلا الله رب السماوات ورب الأرض ورب العرش الكريم» (مسلم).","reason":"الكرب يُقابل بثلاث تهليلات، الثانية بهذا الاسم: المكروب يُذكَّر بأن ربّ أعظم المخلوقات ربُّ كربه الصغير. والعرش يُذكر في الكرب لأن الفرج ينزل من فوقه.","adds":"الاسم في وسط دعاء الكرب النبوي."},{"i":2,"of":7,"text":"كانَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ إذا عادَ المريضَ جَلَسَ عندَ رأسِهِ، ثمَّ قال سَبْعَ مَرَّاتٍ: أسأَلُ اللهَ العظيمَ رَبَّ العَرْشِ العَظيمِ أنْ يَشْفِيَكَ. فإنْ كانَ في أجَلِهِ تَأخيرٌ عُوفِيَ مِن وَجَعِه ذلكَ.","narrator":"عبدالله بن عباس","source":"المستدرك على الصحيحين 7694","grade":"صحيح","judgment":"صحيح على شرط الشيخين","url":"https://dorar.net/h/PAAcaYu9","nameForm":"رَبَّ العَرْشِ العَظيمِ","scene":"ابن عباس: كان النبي ﷺ إذا عاد المريض جلس عند رأسه ثم قال سبع مرات: «أسأل الله العظيم رب العرش العظيم أن يشفيك»، فإن كان في أجله تأخير عوفي من وجعه ذلك.","reason":"الشفاء يُسأل من ربّ العرش العظيم سبعًا: المرض يُسند إلى أعلى ربوبية لأن الجسد أضعف المخلوقات والعرش أعظمها.","adds":"يعطي الاسم رقية العيادة السبعية."},{"i":3,"of":7,"text":"«بُعثَ إلى أبو بَكْرٍ الصِّدِّيقُ مقتلَ أَهْلِ اليمامةِ فإذا عُمرُ بنُ الخطَّابِ عندَهُ فقالَ: إنَّ عمرَ بنَ الخطَّابِ قد أتاني فقالَ: إنَّ القتلَ قد استحرَّ بقرَّاءِ القرآنِ يومَ اليمامةِ، وإنِّي لأَخشى أن يستَحرَّ القتلُ بالقرَّاءِ في المواطنِ كُلِّها فيذهَبَ قرآنٌ كثيرٌ، وإنِّي أرى أن تَأمرَ بجمعِ القرآنِ، قالَ أبو بَكْرٍ لعمرَ: كيفَ أفعلُ شيئًا لم يفعَلهُ رسولُ اللَّهِ؟ فقالَ عمرُ: هوَ واللَّهِ خيرٌ، فلم يزَلْ يراجعُني في ذلِكَ حتَّى شَرحَ اللَّهُ صَدري للَّذي شرحَ لَهُ صدرَ عمرَ، ورأَيتُ فيهِ الَّذي رأى، قالَ زيدٌ: قالَ أبو بَكْرٍ: إنَّكَ شابٌّ عاقلٌ لا نتَّهمُكَ، قد كنتَ تَكْتبُ لرسولِ اللَّهِ الوحيَ فتتبَّعِ القرآنَ، قالَ: فواللَّهِ لو كلَّفوني نقلَ جَبلٍ منَ الجبالِ ما كانَ أثقلَ عليَّ من ذلِكَ، قلتُ: كيفَ تفعَلونَ شيئًا لم يفعَلهُ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ؟ قالَ أبو بَكْرٍ: هوَ واللَّهِ خيرٌ، فلم يزَل يراجعُني في ذلِكَ أبو بَكْرٍ وعمرُ حتَّى شرحَ اللَّهُ صدري للَّذي شرحَ لَهُ صدرَهُما: صدرَ أبي بَكْرٍ وعمرَ فتتبَّعتُ القرآنَ أجمعُهُ منَ الرِّقاعِ والعُسبِ واللِّخافِ يعني الحِجارةَ والرِّقاقَ وصدورِ الرِّجالِ، فوجدتُ آخرَ سورةِ براءةٌ معَ خُزَيْمةَ بنِ ثابتٍ  لَقَدْ جَاءَكُمْ رَسُولٌ مِنْ أَنْفُسِكُمْ عَزِيزٌ عَلَيْهِ مَا عَنِتُّمْ حَرِيصٌ عَلَيْكُمْ بِالْمُؤْمِنِينَ رَءُوفٌ رَحِيمٌ فَإِنْ تَوَلَّوْا فَقُلْ حَسْبِيَ اللَّهُ لَا إِلَهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَهُوَ رَبُّ الْعَرْشِ الْعَظِيم»","narrator":"زيد بن ثابت","source":"صحيح الترمذي (3103)","grade":"صحيح","url":"https://dorar.net/h/VnYTbQjb","nameForm":"رَبُّ الْعَرْشِ الْعَظِيم","scene":"يحكي زيد بن ثابت: بعث إلي أبو بكر مقتل أهل اليمامة وعنده عمر، فقال: إن عمر أتاني فقال: إن القتل قد استحر بقراء القرآن يوم اليمامة وأخشى أن يذهب قرآن كثير، فأرى أن تأمر بجمع القرآن، فتتبعت القرآن أجمعه من الرقاع والعسب وصدور الرجال، حتى وجدت آخر سورة براءة مع خزيمة الأنصاري لم أجدها مع غيره: ﴿لَقَدْ جَاءَكُمْ رَسُولٌ مِنْ أَنْفُسِكُمْ﴾ حتى خاتمة براءة ﴿وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ﴾.","reason":"آخر ما جُمع من سورة براءة آية فيها الاسم، وجدها زيد مع رجل واحد؛ فالاسم في آية كادت تفوت الجمع، وحفظها حين استحر القتل بالقراء من حفظ الله لكتابه.","adds":"خاتمة براءة برب العرش العظيم آخر ما وُجد في جمع القرآن."},{"i":4,"of":7,"text":"«أنَّهم جَمَعوا القُرآنَ في مَصاحِفَ في خِلافةِ أبي بَكْرٍ، فكانَ رِجالٌ يَكتُبونَ ويُمْلي عليهم أُبَيُّ بنُ كَعْبٍ، فلمَّا انْتَهَوا إلى هذه الآيةِ مِن سورةِ بَراءَة: {ثُمَّ انْصَرَفُوا صَرَفَ اللَّهُ قُلُوبَهُمْ بِأَنَّهُمْ قَوْمٌ لَا يَفْقَهُونَ} فظَنُّوا أنَّ هذا آخِرُ ما أُنزِلَ مِن القُرآنِ، فقالَ لهم أُبَيُّ بنُ كَعْبٍ: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قد أَقْرَأَني بَعْدَها آيتَينِ: {لَقَدْ جَاءَكُمْ رَسُولٌ مِنْ أَنْفُسِكُمْ عَزِيزٌ عَلَيْهِ مَا عَنِتُّمْ حَرِيصٌ عَلَيْكُمْ بِالْمُؤْمِنِينَ رَءُوفٌ رَحِيمٌ * فَإِنْ تَوَلَّوْا فَقُلْ حَسْبِيَ اللَّهُ لا إِلَهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ}.\nقالَ: فهذا آخِرُ ما نَزَلَ مِن القُرآنِ، قالَ: فخَتَمَ الأمْرَ بما فَتَحَ به: لا إلهَ إلَّا اللهُ. يَقولُ اللهُ: {وَمَا أَرْسَلْنَا مِنْ قَبْلِكَ مِنْ رَسُولٍ إِلَّا نُوحِي إِلَيْهِ أَنَّهُ لَا إِلَهَ إِلَّا أَنَا فَاعْبُدُونِ}».","narrator":"أبي بن كعب","source":"الأحاديث المختارة 1156","grade":"صحيح","judgment":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","url":"https://dorar.net/h/0myII3Js","nameForm":"رَبُّ الْعَرْشِ الْعَظِيم","scene":"لما جمعوا القرآن في خلافة أبي بكر كان رجال يكتبون ويملي عليهم أبي بن كعب، فلما انتهوا إلى ﴿ثُمَّ انْصَرَفُوا صَرَفَ اللَّهُ قُلُوبَهُمْ﴾ ظنوا أن هذا آخر ما أُنزل، فقال أبي: إن النبي ﷺ أقرأني بعدها آيتين: ﴿لَقَدْ جَاءَكُمْ رَسُولٌ مِنْ أَنْفُسِكُمْ﴾ إلى ﴿فَإِنْ تَوَلَّوْا فَقُلْ حَسْبِيَ اللَّهُ لَا إِلَهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ﴾، وقال: هذا آخر ما أُنزل من القرآن.","reason":"آخر ما نزل من القرآن عند أبي آية الحسبنة المختومة برب العرش العظيم؛ فالوحي خُتم بكلمة للداعية إذا تولى الناس: حسبي الله ورب العرش العظيم، والاسم آخر ما تلقاه أبي من النبي ﷺ.","adds":"آخر ما أُنزل: حسبي الله وهو رب العرش العظيم."},{"i":5,"of":7,"text":"«تحصَّنتُ بالذي لا إلهَ إلَّا هو إلهي وإلهُ كلِّ شيءٍ واعتصمتُ بربِّي وبربِّ كلِّ شيءٍ وتوكلتُ على الحيِّ الذي لا يموتُ واستدفعتُ الشرَّ بلا حولَ ولا قوةَ إلَّا باللهِ ، حسبيَ اللهُ ونعمَ الوكيلُ ، حسبيَ الربُّ من العبادِ ، حسبيَ الخالقُ من المخلوقِ ، حسبيَ الرزاقُ من المرزوقِ ، حسبيَ الذي هو حسبي ، حسبيَ الذي بيدهِ ملكوتُ كلِّ شيءٍ ، وهو يجيرُ ولا يجارُ عليه ، حسبيَ اللهُ وكفَى ، سمِع اللهُ لمن دعا ، ليس وراءَ اللهِ مَرمَى ، حسبيَ اللهُ لا إلهَ إلَّا هو عليه توكلتُ وهو ربُّ العرشِ العظيمِ»","narrator":"-","source":"سفر السعادة (310)","grade":"صحيح","url":"https://dorar.net/h/kUN6OVoQ","nameForm":"ربُّ العرشِ العظيمِ","scene":"من دعاء التحصن المأثور: «تحصنت بالذي لا إله إلا هو إلهي وإله كل شيء، واعتصمت بربي ورب كل شيء، وتوكلت على الحي الذي لا يموت، واستدفعت الشر بلا حول ولا قوة إلا بالله، حسبي الله ونعم الوكيل، حسبي الرب من العباد، حسبي الخالق من المخلوق، حسبي الرزاق من المرزوق، حسبي الذي بيده ملكوت كل شيء وهو يجير ولا يجار عليه، حسبي الله وكفى، حسبي الله لا إله إلا هو عليه توكلت وهو رب العرش العظيم».","reason":"سلسلة الحسب تنتهي بالاسم: حسبي الله عليه توكلت وهو رب العرش العظيم؛ فبعد أن يُكفى العبد الرب من العباد والخالق من المخلوق يختم بمن يملك أعلى ما خُلق، فلا يبقى شيء فوق متوكَّله.","adds":"خاتمة سلسلة الحسبنة رب العرش العظيم: لا شيء فوق المتوكَّل عليه."},{"i":6,"of":7,"text":"اللهمَّ أنت ربِّي لا إلهَ إلَّا أنتَ عليك توكلتُ وأنت ربُّ العرشِ العظيمِ ، ما شاء اللهُ كان وما لم يشأْ لم يكنْ ولا حولَ ولا قوةَ إلَّا باللهِ أعلمُ أنَّ اللهَ على كلِّ شيءٍ قديرٌ وأنَّ اللهَ قد أحاط بكلِّ شيءٍ علمًا وأحصَى كلَّ شيءٍ عددًا ، اللهمَّ إني أعوذُ بك من شرِّ نفسي ومن شرِّ الشيطانِ وشَرَكِه ، ومن شرِّ كلِّ دابةٍ أنتَ آخِذٌ بناصيتِها إنَّ ربِّي على صِراطٍ مستقيمٍ","narrator":"-","source":"سفر السعادة 310","grade":"صحيح","url":"https://dorar.net/h/fSnNLIIt","nameForm":"ربُّ العرشِ العظيمِ","scene":"من الدعاء المأثور: «اللهم أنت ربي لا إله إلا أنت عليك توكلت وأنت رب العرش العظيم، ما شاء الله كان وما لم يشأ لم يكن، ولا حول ولا قوة إلا بالله، أعلم أن الله على كل شيء قدير وأن الله قد أحاط بكل شيء علمًا وأحصى كل شيء عددًا، اللهم إني أعوذ بك من شر نفسي ومن شر الشيطان وشركه ومن شر كل دابة أنت آخذ بناصيتها إن ربي على صراط مستقيم».","reason":"التوكل في الدعاء يبدأ برب العرش العظيم ثم يقر بالمشيئة والقدرة والإحاطة ثم يستعيذ؛ فمن توكل على رب العرش انتظم له بعدها كل إقرار وكل استعاذة، والاسم أول الدعاء وأساسه.","adds":"التوكل على رب العرش العظيم أساس دعاء التحصن من شر النفس والشيطان."},{"i":7,"of":7,"text":"مَن قال في كلِّ يومٍ حينَ يُصبِحُ وحينَ يُمْسي: حَسبيَ اللهُ لا إلهَ إلَّا هو، عليه تَوكَّلْتُ، وهو ربُّ العَرشِ العَظيمِ، سَبعَ مراتٍ، كَفاه اللهُ ما أهَمَّه من أمرِ الدُّنيا والآخِرةِ.","narrator":"أبو الدرداء","source":"تخريج زاد المعاد 2/342","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/Ftqgc7p2","nameForm":"ربُّ العَرشِ العَظيمِ","scene":"أبو الدرداء: «من قال في كل يوم حين يصبح وحين يمسي: حسبي الله لا إله إلا هو عليه توكلت وهو رب العرش العظيم، سبع مرات، كفاه الله ما أهمه من أمر الدنيا والآخرة».","reason":"كلماتٌ تُقال سبعًا صباحًا ومساءً فيكفي الله قائلها ما أهمّه من أمر الدنيا والآخرة — الاسم في ذكرٍ يومي معدود.","adds":"وردٌ يومي معدود: سبعٌ صباحًا ومساءً يكفي الله بها ما أهمّ."}],"sunnah":{"card":"الصيغة: رَبُّ الْعَرْشِ الْعَظِيمِ — مركّبة\nفي السنة: 5 شواهد (21 رواية)\nخصوصية الورود في السنة: اسمُ الكرب: «لا إله إلا الله رب العرش العظيم» في دعاء الكرب النبوي (مسلم)، وعيادة المريض سبعًا «أسأل الله العظيم رب العرش العظيم أن يشفيك»، وآخر ما نزل من القرآن ﴿حَسْبِيَ اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ﴾ التي وُجدت مع خزيمة عند جمع القرآن، وذكر الصباح والمساء سبعًا «كفاه الله ما أهمه».\nالمعنى المختصر: مالك العرش الذي هو أعظم المخلوقات ومدبّره.","teaches":"1. أنه يُذكر في الكرب لأن الفرج ينزل من فوق العرش.\n2. أنه يشفي المريض بسؤاله سبعًا.\n3. أن آخر ما نزل من القرآن ختم به.\n4. أن من قال آيته سبعًا كُفي ما أهمه.","whenRecall":"- عند الكرب: التهليلات الثلاث.\n- عند رأس المريض: سبعًا.\n- صباحًا ومساءً: حسبي الله سبعًا.\n- حين يُعرض عنك الناس: «فإن تولوا فقل حسبي الله».","whenPray":"عند الشعور بـ:\n1. الكرب.\n2. الهم من أمر الدنيا والآخرة.\n3. إعراض الناس.\nعند طلب:\n1. الشفاء لمريض.\n2. الكفاية من كل همّ.\nعند الرغبة في:\n1. ورد الكفاية سبعًا.","duaItems":"1. دعاء الكرب — صحيح مسلم 2730.\n2. عيادة المريض سبعًا — المستدرك 7694.\n3. «حسبي الله لا إله إلا هو عليه توكلت وهو رب العرش العظيم» سبعًا صباحًا ومساءً — تخريج زاد المعاد 2/342 (إسناده صحيح).","summary":"«رب العرش العظيم» في السنة اسم الكرب والعيادة والكفاية: تهليلٌ في الكرب، وسبعٌ عند رأس المريض، وسبعٌ صباحًا ومساءً «كفاه الله ما أهمه» — وآخر ما نزل من القرآن."},"situations":[{"situationId":1,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"الكرب الشديد وانتظار الفرج من فوق","bridge":"أطبق عليك الأمر؟ دعاء الكرب النبوي: «لا إله إلا الله العظيم الحليم، لا إله إلا الله رب العرش العظيم، لا إله إلا الله رب السماوات ورب الأرض ورب العرش الكريم»."}]},{"situationId":2,"verses":[],"hadiths":[{"i":7,"strength":"direct","headline":"همومٌ من أمر الدنيا والآخرة لا تعرف وجهها","bridge":"همٌّ لا تعرف وجهه؟ قل سبعًا صباحًا ومساءً: «حسبي الله لا إله إلا هو عليه توكلت وهو رب العرش العظيم» — كفاك الله ما أهمك من أمر الدنيا والآخرة."}]},{"situationId":5,"verses":[],"hadiths":[{"i":2,"strength":"direct","headline":"عيادة مريضٍ والدعاء له بالشفاء","bridge":"تعود مريضًا؟ سبعًا: «أسأل الله العظيم رب العرش العظيم أن يشفيك»."}]},{"situationId":6,"verses":[{"i":1,"strength":"direct","headline":"إعراض الناس كلهم عنك وانقطاع السند","bridge":"أعرض عنك الناس كلهم؟ ﴿فَإِنْ تَوَلَّوْا فَقُلْ حَسْبِيَ اللَّهُ لَا إِلَهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ﴾ — الشرط إعراض الناس، والجواب حسبنةٌ على ثلاث: توحيدٍ وتوكلٍ وربوبيةٍ للعرش العظيم؛ فمن كان حسبه ربَّ العرش لم يضره إعراض الأرض كلها."}],"hadiths":[]},{"situationId":75,"verses":[],"hadiths":[{"i":6,"strength":"direct","headline":"التحصّن من شر النفس ووسوسة الشيطان بالتوكل","bridge":"تخاف من شر نفسك والشيطان؟ ابدأ كما بدأ الدعاء المأثور: «اللهم أنت ربي لا إله إلا أنت عليك توكلت وأنت رب العرش العظيم… اللهم إني أعوذ بك من شر نفسي ومن شر الشيطان وشركه» — التوكل على رب العرش أولًا ثم الاستعاذة؛ فمن تعلق بالعرش لم يبلغه وسواس."}]},{"situationId":91,"verses":[{"i":2,"strength":"direct","headline":"الانبهار بعروش الملوك وزخارف ملكهم","bridge":"تبهرك عروش الملوك؟ في السياق نفسه عرشان: عرش بلقيس الذي وصفه الهدهد بالعظيم، ثم ﴿اللَّهُ لَا إِلَهَ إِلَّا هُوَ رَبُّ الْعَرْشِ الْعَظِيمِ﴾ وهي آية سجدة — المقابلة تضع ملك الملوك في حجمه؛ فالفرق موضوعٌ أمام عينيك مباشرة."}],"hadiths":[]},{"situationId":102,"verses":[],"hadiths":[{"i":5,"strength":"direct","headline":"البحث عن كفايةٍ تامة لا يبقى فوقها سند","bridge":"تريد صيغة تحصن تجمع كل الحسب؟ «تحصنت بالذي لا إله إلا هو… حسبي الرب من العباد، حسبي الخالق من المخلوق… حسبي الله لا إله إلا هو عليه توكلت وهو رب العرش العظيم» — سلسلة الحسبنة تُختم بمن يملك العرش؛ فاجعلها في وردك."}]},{"situationId":130,"verses":[],"hadiths":[{"i":4,"strength":"direct","headline":"إعراض المدعوّين بعد بذل الجهد في دعوتهم","bridge":"بذلت ولا ترى استجابة؟ قال أبي بن كعب عن آخر ما أُنزل من القرآن: ﴿فَإِنْ تَوَلَّوْا فَقُلْ حَسْبِيَ اللَّهُ لَا إِلَهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ﴾ — خُتم الوحي بكلمة للداعية حين يُعرض عنه؛ فقلها حين يتولون."}]},{"situationId":191,"verses":[],"hadiths":[{"i":3,"strength":"direct","headline":"التأمل في حفظ الله لكتابه من الضياع","bridge":"تريد أن ترى كيف حُفظ الاسم في المصحف؟ لما استحر القتل بالقراء يوم اليمامة جمع زيد القرآن، ووجد آخر براءة ﴿لَقَدْ جَاءَكُمْ رَسُولٌ مِنْ أَنْفُسِكُمْ﴾ إلى ﴿وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ﴾ مع خزيمة وحده — آية الاسم كادت تفوت الجمع فحفظها الله برجل واحد؛ فتلك قصة وصولها إليك."}]}]},{"id":153,"name":"على كل شيء شهيد","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: عَلَى كُلِّ شَيْءٍ شَهِيدٌ / شَهِيدًا — | المواضع: 8\nخصوصية: يجيء حيث تغيب الشهود: عقودٌ بلا وثائق، وحقوقٌ داخل البيوت، وأعمالٌ نسيها أصحابها، وجرائمُ شهدها الطغاة بأنفسهم.\n\nالمعنى:\n- الشهيد: الحاضر المطّلع الذي لا يغيب عنه شيء، ويشهد يوم القيامة بما رأى.","teaches":"الحقائق التي كشفتها المواضع:\n1. ﴿أَحْصَاهُ اللَّهُ وَنَسُوهُ﴾ — نسيانك لا يمحو السجل.\n2. العقود بلا شهود لها شاهدٌ لا يغيب.\n3. مشاهدة الظلم والرضا به مسجَّلة (البروج 7-9).\n4. آيات الآفاق والأنفس برهانٌ متجدد (فصلت 53).\n5. مسؤوليتك تنتهي بحياتك: شهادة عيسى (المائدة 117).","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- عند اتفاقٍ بلا وثيقة.\n- عند رؤية ظلمٍ ومشاهدته دون إنكار.\n- عند نسيان ذنبٍ قديم.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. الاستغفار مما نسيت: «وَأَسْتَغْفِرُكَ لِمَا لَا أَعْلَمُ» — من دعاء الشرك المأثور.\n2. الوفاء بالعقود غير الموثقة — النساء 33.\n3. إنكار الظلم ولو بالقلب لئلا تُسجّل شاهدًا راضيًا.","summary":"﴿أَحْصَاهُ اللَّهُ وَنَسُوهُ﴾ — ما نسيتَه محفوظٌ عند شهيدٍ لا يغيب: فأوفِ بما عقدت في الخفاء، واستغفر لما لا تذكر.","verses":[{"i":1,"of":8,"s":4,"surah":"النساء","a":33,"text":"وَلِكُلٍّ جَعَلْنَا مَوَالِيَ مِمَّا تَرَكَ الْوَالِدَانِ وَالْأَقْرَبُونَ وَالَّذِينَ عَقَدَتْ أَيْمَانُكُمْ فَآتُوهُمْ نَصِيبَهُمْ إِنَّ اللَّهَ كَانَ عَلَى كُلِّ شَيْءٍ شَهِيدًا","prev":{"a":32,"text":"وَلَا تَتَمَنَّوْا مَا فَضَّلَ اللَّهُ بِهِ بَعْضَكُمْ عَلَى بَعْضٍ لِلرِّجَالِ نَصِيبٌ مِمَّا اكْتَسَبُوا وَلِلنِّسَاءِ نَصِيبٌ مِمَّا اكْتَسَبْنَ وَاسْأَلُوا اللَّهَ مِنْ فَضْلِهِ إِنَّ اللَّهَ كَانَ بِكُلِّ شَيْءٍ عَلِيمًا"},"next":{"a":34,"text":"الرِّجَالُ قَوَّامُونَ عَلَى النِّسَاءِ بِمَا فَضَّلَ اللَّهُ بَعْضَهُمْ عَلَى بَعْضٍ وَبِمَا أَنْفَقُوا مِنْ أَمْوَالِهِمْ فَالصَّالِحَاتُ قَانِتَاتٌ حَافِظَاتٌ لِلْغَيْبِ بِمَا حَفِظَ اللَّهُ وَاللَّاتِي تَخَافُونَ نُشُوزَهُنَّ فَعِظُوهُنَّ وَاهْجُرُوهُنَّ فِي الْمَضَاجِعِ وَاضْرِبُوهُنَّ فَإِنْ أَطَعْنَكُمْ فَلَا تَبْغُوا عَلَيْهِنَّ سَبِيلًا إِنَّ اللَّهَ كَانَ عَلِيًّا كَبِيرًا"},"reason":"حقوقُ الموالي والمعاقدين قد تضيع لأنها بلا وثائق — فخُتمت بالشهيد: شهيدٌ على العقود التي لا يشهدها أحد، وعلى الأنصبة التي تُبخس في الخفاء.","adds":"كل اتفاقٍ عقدته بلا ورقٍ ولا شاهد له شاهدٌ لا يغيب — فأوفِ بما عقدت."},{"i":2,"of":8,"s":5,"surah":"المائدة","a":117,"text":"مَا قُلْتُ لَهُمْ إِلَّا مَا أَمَرْتَنِي بِهِ أَنِ اعْبُدُوا اللَّهَ رَبِّي وَرَبَّكُمْ وَكُنْتُ عَلَيْهِمْ شَهِيدًا مَا دُمْتُ فِيهِمْ فَلَمَّا تَوَفَّيْتَنِي كُنْتَ أَنْتَ الرَّقِيبَ عَلَيْهِمْ وَأَنْتَ عَلَى كُلِّ شَيْءٍ شَهِيدٌ","prev":{"a":116,"text":"وَإِذْ قَالَ اللَّهُ يَا عِيسَى ابْنَ مَرْيَمَ أَأَنْتَ قُلْتَ لِلنَّاسِ اتَّخِذُونِي وَأُمِّيَ إِلَهَيْنِ مِنْ دُونِ اللَّهِ قَالَ سُبْحَانَكَ مَا يَكُونُ لِي أَنْ أَقُولَ مَا لَيْسَ لِي بِحَقٍّ إِنْ كُنْتُ قُلْتُهُ فَقَدْ عَلِمْتَهُ تَعْلَمُ مَا فِي نَفْسِي وَلَا أَعْلَمُ مَا فِي نَفْسِكَ إِنَّكَ أَنْتَ عَلَّامُ الْغُيُوبِ"},"next":{"a":118,"text":"إِنْ تُعَذِّبْهُمْ فَإِنَّهُمْ عِبَادُكَ وَإِنْ تَغْفِرْ لَهُمْ فَإِنَّكَ أَنْتَ الْعَزِيزُ الْحَكِيمُ"},"context":"عيسى يوم القيامة: ﴿مَا قُلْتُ لَهُمْ إِلَّا مَا أَمَرْتَنِي بِهِ أَنِ اعْبُدُوا اللَّهَ رَبِّي وَرَبَّكُمْ وَكُنْتُ عَلَيْهِمْ شَهِيدًا مَا دُمْتُ فِيهِمْ فَلَمَّا تَوَفَّيْتَنِي كُنْتَ أَنْتَ الرَّقِيبَ عَلَيْهِمْ وَأَنْتَ عَلَى كُلِّ شَيْءٍ شَهِيدٌ﴾.","reason":"تبرأ عيسى مما نُسب إليه بعد رفعه، وحدّد مسؤوليته زمنيًّا: شهيدٌ عليهم ما دام فيهم فقط — ثم الشهادة لله؛ فالمعلّم مسؤولٌ عن حياته لا عمّا حُرّف بعده.","adds":"لست مسؤولًا عمّا يُنسب إليك بعد رحيلك — بل عمّا قلتَه وأنت بينهم: فأحكم بيانك في حياتك."},{"i":3,"of":8,"s":22,"surah":"الحج","a":17,"text":"إِنَّ الَّذِينَ آمَنُوا وَالَّذِينَ هَادُوا وَالصَّابِئِينَ وَالنَّصَارَى وَالْمَجُوسَ وَالَّذِينَ أَشْرَكُوا إِنَّ اللَّهَ يَفْصِلُ بَيْنَهُمْ يَوْمَ الْقِيَامَةِ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ شَهِيدٌ","prev":{"a":16,"text":"وَكَذَلِكَ أَنْزَلْنَاهُ آيَاتٍ بَيِّنَاتٍ وَأَنَّ اللَّهَ يَهْدِي مَنْ يُرِيدُ"},"next":{"a":18,"text":"أَلَمْ تَرَ أَنَّ اللَّهَ يَسْجُدُ لَهُ مَنْ فِي السَّمَاوَاتِ وَمَنْ فِي الْأَرْضِ وَالشَّمْسُ وَالْقَمَرُ وَالنُّجُومُ وَالْجِبَالُ وَالشَّجَرُ وَالدَّوَابُّ وَكَثِيرٌ مِنَ النَّاسِ وَكَثِيرٌ حَقَّ عَلَيْهِ الْعَذَابُ وَمَنْ يُهِنِ اللَّهُ فَمَا لَهُ مِنْ مُكْرِمٍ إِنَّ اللَّهَ يَفْعَلُ مَا يَشَاءُ"},"reason":"عُدّت المللُ الستُّ ثم أُحيل الفصلُ بينها إلى يوم القيامة — والشهيد هو الفاصل: شهد كل ملةٍ وما فعلت وما اعتقدت، فقضاؤه عن شهادةٍ لا عن رواية.","adds":"الجدال بين الملل لا يُحسم اليوم بالكلام — يُحسم غدًا بشهادة من شهد الجميع."},{"i":4,"of":8,"s":33,"surah":"الأحزاب","a":55,"text":"لَا جُنَاحَ عَلَيْهِنَّ فِي آبَائِهِنَّ وَلَا أَبْنَائِهِنَّ وَلَا إِخْوَانِهِنَّ وَلَا أَبْنَاءِ إِخْوَانِهِنَّ وَلَا أَبْنَاءِ أَخَوَاتِهِنَّ وَلَا نِسَائِهِنَّ وَلَا مَا مَلَكَتْ أَيْمَانُهُنَّ وَاتَّقِينَ اللَّهَ إِنَّ اللَّهَ كَانَ عَلَى كُلِّ شَيْءٍ شَهِيدًا","prev":{"a":54,"text":"إِنْ تُبْدُوا شَيْئًا أَوْ تُخْفُوهُ فَإِنَّ اللَّهَ كَانَ بِكُلِّ شَيْءٍ عَلِيمًا"},"next":{"a":56,"text":"إِنَّ اللَّهَ وَمَلَائِكَتَهُ يُصَلُّونَ عَلَى النَّبِيِّ يَا أَيُّهَا الَّذِينَ آمَنُوا صَلُّوا عَلَيْهِ وَسَلِّمُوا تَسْلِيمًا"},"context":"في محارم النساء ومن يجوز أن يرين: ﴿وَاتَّقِينَ اللَّهَ إِنَّ اللَّهَ كَانَ عَلَى كُلِّ شَيْءٍ شَهِيدًا﴾.","reason":"أحكامُ الحجاب والمحارم تُطبَّق داخل البيوت حيث لا رقيب — فخُتمت بالتقوى والشهادة: الرقيبُ الوحيد في هذه المساحة هو الشهيد على كل شيء.","adds":"العفة داخل البيوت لا يحرسها قانون — يحرسها إيمانٌ بشهيدٍ على كل شيء."},{"i":5,"of":8,"s":34,"surah":"سبأ","a":47,"text":"قُلْ مَا سَأَلْتُكُمْ مِنْ أَجْرٍ فَهُوَ لَكُمْ إِنْ أَجْرِيَ إِلَّا عَلَى اللَّهِ وَهُوَ عَلَى كُلِّ شَيْءٍ شَهِيدٌ","prev":{"a":46,"text":"قُلْ إِنَّمَا أَعِظُكُمْ بِوَاحِدَةٍ أَنْ تَقُومُوا لِلَّهِ مَثْنَى وَفُرَادَى ثُمَّ تَتَفَكَّرُوا مَا بِصَاحِبِكُمْ مِنْ جِنَّةٍ إِنْ هُوَ إِلَّا نَذِيرٌ لَكُمْ بَيْنَ يَدَيْ عَذَابٍ شَدِيدٍ"},"next":{"a":48,"text":"قُلْ إِنَّ رَبِّي يَقْذِفُ بِالْحَقِّ عَلَّامُ الْغُيُوبِ"},"reason":"تبرؤٌ من كل مقابلٍ دنيوي للدعوة — والشهيدُ هو الضامن: شهيدٌ على أنه لم يأخذ أجرًا، وشهيدٌ على أجره المدّخر عنده. فمن لا يأخذ أجرًا من الناس أجرُه على شهيدٍ لا ينسى.","adds":"استقلالُ الداعية عن أجور الناس شرط صدقه — وأجره محفوظ عند شهيد."},{"i":6,"of":8,"s":41,"surah":"فصلت","a":53,"text":"سَنُرِيهِمْ آيَاتِنَا فِي الْآفَاقِ وَفِي أَنْفُسِهِمْ حَتَّى يَتَبَيَّنَ لَهُمْ أَنَّهُ الْحَقُّ أَوَلَمْ يَكْفِ بِرَبِّكَ أَنَّهُ عَلَى كُلِّ شَيْءٍ شَهِيدٌ","prev":{"a":52,"text":"قُلْ أَرَأَيْتُمْ إِنْ كَانَ مِنْ عِنْدِ اللَّهِ ثُمَّ كَفَرْتُمْ بِهِ مَنْ أَضَلُّ مِمَّنْ هُوَ فِي شِقَاقٍ بَعِيدٍ"},"next":{"a":54,"text":"أَلَا إِنَّهُمْ فِي مِرْيَةٍ مِنْ لِقَاءِ رَبِّهِمْ أَلَا إِنَّهُ بِكُلِّ شَيْءٍ مُحِيطٌ"},"reason":"وعدٌ بإراءة الآيات في الآفاق والأنفس — أي في الكون وفي تكوين الإنسان — حتى يتبين الحق؛ ثم استفهامٌ تقريري: أوَلم يكفِ أن ربك شهيدٌ على كل شيء؟ فشهادتُه أغنى من كل برهان.","adds":"كل اكتشافٍ في الكون أو في جسد الإنسان تحقيقٌ لوعد ﴿سَنُرِيهِمْ آيَاتِنَا فِي الْآفَاقِ وَفِي أَنْفُسِهِمْ﴾."},{"i":7,"of":8,"s":58,"surah":"المجادلة","a":6,"text":"يَوْمَ يَبْعَثُهُمُ اللَّهُ جَمِيعًا فَيُنَبِّئُهُمْ بِمَا عَمِلُوا أَحْصَاهُ اللَّهُ وَنَسُوهُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ شَهِيدٌ","prev":{"a":5,"text":"إِنَّ الَّذِينَ يُحَادُّونَ اللَّهَ وَرَسُولَهُ كُبِتُوا كَمَا كُبِتَ الَّذِينَ مِنْ قَبْلِهِمْ وَقَدْ أَنْزَلْنَا آيَاتٍ بَيِّنَاتٍ وَلِلْكَافِرِينَ عَذَابٌ مُهِينٌ"},"next":{"a":7,"text":"أَلَمْ تَرَ أَنَّ اللَّهَ يَعْلَمُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ مَا يَكُونُ مِنْ نَجْوَى ثَلَاثَةٍ إِلَّا هُوَ رَابِعُهُمْ وَلَا خَمْسَةٍ إِلَّا هُوَ سَادِسُهُمْ وَلَا أَدْنَى مِنْ ذَلِكَ وَلَا أَكْثَرَ إِلَّا هُوَ مَعَهُمْ أَيْنَ مَا كَانُوا ثُمَّ يُنَبِّئُهُمْ بِمَا عَمِلُوا يَوْمَ الْقِيَامَةِ إِنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ"},"reason":"مفارقةٌ مخيفة: ﴿أَحْصَاهُ اللَّهُ وَنَسُوهُ﴾ — ما نسيتَه أنت محفوظٌ عنده بتمامه؛ فالنسيانُ البشري لا يمحو شيئًا من السجل، والشهيدُ يشهد بما لم تعد تذكره.","adds":"أخطر ما في الذنوب أن تنساها وهي محفوظة: ﴿أَحْصَاهُ اللَّهُ وَنَسُوهُ﴾ — فاستغفر لما لا تذكر."},{"i":8,"of":8,"s":85,"surah":"البروج","a":9,"text":"الَّذِي لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَاللَّهُ عَلَى كُلِّ شَيْءٍ شَهِيدٌ","prev":{"a":8,"text":"وَمَا نَقَمُوا مِنْهُمْ إِلَّا أَنْ يُؤْمِنُوا بِاللَّهِ الْعَزِيزِ الْحَمِيدِ"},"next":{"a":10,"text":"إِنَّ الَّذِينَ فَتَنُوا الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ ثُمَّ لَمْ يَتُوبُوا فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ الْحَرِيقِ"},"context":"في أصحاب الأخدود: ﴿الَّذِي لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَاللَّهُ عَلَى كُلِّ شَيْءٍ شَهِيدٌ﴾ — بعد ﴿وَهُمْ عَلَى مَا يَفْعَلُونَ بِالْمُؤْمِنِينَ شُهُودٌ﴾.","reason":"مقابلةٌ مرعبة: الطغاةُ قعودٌ «شهود» على تعذيب المؤمنين — واللهُ ﴿عَلَى كُلِّ شَيْءٍ شَهِيدٌ﴾: شهودُهم على الجريمة وشهادتُه عليهم؛ فمن تلذذ بمشاهدة الظلم فهو في السجل شريك.","adds":"مجرد المشاهدة والتلذذ بالظلم جريمةٌ مسجلة: ﴿وَهُمْ عَلَى مَا يَفْعَلُونَ بِالْمُؤْمِنِينَ شُهُودٌ﴾."}],"hadiths":[{"i":1,"of":1,"text":"قام فينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بموعظةٍ، فقال: يا أيُّها الناسُ، إنَّكم مَحْشورونَ إلى اللهِ حُفاةً، عُراةً، غُرلًا: {كَمَا بَدَأْنَا أَوَّلَ خَلْقٍ نُعِيدُهُ وَعْدًا عَلَيْنَا إِنَّا كُنَّا فَاعِلِينَ} [الأنبياء: 104]، ألَا وإنَّ أولَ الخلقِ يُكسَى يومَ القيامةِ إبراهيمُ، وإنَّه سيُجاءُ بأُناسٍ من أمَّتي فيُؤخَذُ بهم ذاتَ الشِّمالِ، فلَأَقولَنَّ: أصحابي، فلَيُقالَنَّ لي: إنَّك لا تَدْري ما أحدَثوا بعدَكَ، فلَأَقولَنَّ كما قال العبدُ الصالِحُ: {وَكُنْتُ عَلَيْهِمْ شَهِيدًا مَا دُمْتُ فِيهِمْ فَلَمَّا تَوَفَّيْتَنِي كُنْتَ أَنْتَ الرَّقِيبَ عَلَيْهِمْ وَأَنْتَ عَلَى كُلِّ شَيْءٍ شَهِيدٌ...} إلى: {فَإِنَّهُمْ عِبَادُكَ وَإِنْ تَغْفِرْ لَهُمْ فَإِنَّكَ أَنْتَ الْعَزِيزُ الْحَكِيمُ} [المائدة:117- 118] فيُقالُ: إنَّ هؤلاءِ لم يزالوا مُرتدِّينَ على أعقابِهم منذُ فارَقْتَهم.","narrator":"عبدالله بن عباس","source":"تخريج المسند لشعيب 2281","grade":"صحيح","judgment":"إسناده صحيح على شرط الشيخين","url":"https://dorar.net/h/tNxLyh9B","nameForm":"عَلَى كُلِّ شَيْءٍ شَهِيدٌ","scene":"موعظة النبي ﷺ: «إنكم محشورون حفاةً عراة… ويُجاء برجال من أمتي فيؤخذ بهم ذات الشمال، فأقول: أصحابي! فيقال: لا تدري ما أحدثوا بعدك، فلأقولنّ كما قال العبد الصالح: ﴿وَكُنتُ عَلَيْهِمْ شَهِيدًا مَّا دُمْتُ فِيهِمْ فَلَمَّا تَوَفَّيْتَنِي كُنتَ أَنتَ الرَّقِيبَ عَلَيْهِمْ وَأَنتَ عَلَىٰ كُلِّ شَيْءٍ شَهِيدٌ﴾».","reason":"شهادة النبي محدودة بحياته، وشهادة الله على كل شيء: فحين يُسأل عن أمته بعد موته يردّ الشهادة إلى من هي له على كل شيء.","adds":"يُري الاسم في تفويض النبي ﷺ شهادة ما بعد موته."}],"sunnah":{"card":"الصيغة: عَلَى كُلِّ شَيْءٍ شَهِيدٌ — مركّبة\nفي السنة: شاهد واحد (رواية واحدة)\nخصوصية الورود في السنة: في موعظة الحشر: يقول النبي ﷺ كما قال العبد الصالح عيسى ﴿وَكُنتُ عَلَيْهِمْ شَهِيدًا مَّا دُمْتُ فِيهِمْ فَلَمَّا تَوَفَّيْتَنِي كُنتَ أَنتَ الرَّقِيبَ عَلَيْهِمْ وَأَنتَ عَلَىٰ كُلِّ شَيْءٍ شَهِيدٌ﴾.\nالمعنى المختصر: الشاهد على كل شيء لا يغيب عنه شيء.","teaches":"1. أن شهادته تشمل ما بعد موت الشهداء من الأنبياء.\n2. أن ما أُحدث بعد الأنبياء مشهود عنده.","whenRecall":"- حين تحاسب على ما لا تعلم.\n- حين تفارق من تشهد عليهم.","whenPray":"عند الشعور بـ:\n1. العجز عن شهادة ما غاب عنك.\nعند طلب:\n1. أن يشهد لك لا عليك.\nعند الرغبة في:\n1. تفويض ما لا تعلمه إليه.","duaItems":"لا صيغة منصوصة؛ ويُتلى قول عيسى [المائدة: 117].","summary":"«على كل شيء شهيد» في السنة كلمة عيسى يقولها النبي ﷺ يوم الحشر فيمن بدّل بعده: شهادة النبي محدودة، وشهادة الله على كل شيء."},"situations":[{"situationId":18,"verses":[{"i":7,"strength":"direct","headline":"كلامٌ قديمٌ في المجالس طواه النسيان","bridge":"خضتَ في مجلسٍ بكلامٍ نسيته منذ سنين؟ سورة المجادلة — سورة النجوى — تقول: ﴿أَحْصَاهُ اللَّهُ وَنَسُوهُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ شَهِيدٌ﴾ — كلمات المجالس التي طواها نسيانك مكتوبةٌ بشهادة من شهدها؛ فتُب عن كلامٍ لا تذكره كما تتوب عما تذكر."}],"hadiths":[]},{"situationId":29,"verses":[{"i":2,"strength":"direct","headline":"نسبة ما لم تقله إليك بعد غيابك","bridge":"يُنسب إليك ما لم تقله بعد أن غبت عن المجلس؟ تبرأ عيسى مما نُسب إليه بعد رفعه: ﴿وَكُنْتُ عَلَيْهِمْ شَهِيدًا مَا دُمْتُ فِيهِمْ فَلَمَّا تَوَفَّيْتَنِي كُنْتَ أَنْتَ الرَّقِيبَ عَلَيْهِمْ وَأَنْتَ عَلَى كُلِّ شَيْءٍ شَهِيدٌ﴾ — لست مسؤولًا عمّا يُنسب إليك بعد غيابك بل عمّا قلته وأنت بينهم؛ فأحكم بيانك، والشهيد يشهد لك بما قلت حقًّا."}],"hadiths":[]},{"situationId":47,"verses":[{"i":1,"strength":"direct","headline":"اتفاقٌ عقدته بلا وثيقة ولا شاهد","bridge":"عقدتَ اتفاقًا بلا ورقٍ ولا شاهد؟ ﴿وَالَّذِينَ عَقَدَتْ أَيْمَانُكُمْ فَآتُوهُمْ نَصِيبَهُمْ إِنَّ اللَّهَ كَانَ عَلَى كُلِّ شَيْءٍ شَهِيدًا﴾ — حقوق المعاقدين تضيع لأنها بلا وثائق، فخُتمت بالشهيد: شاهدٌ على العقود التي لا يشهدها أحد؛ فأوفِ بما عقدت، فله شاهدٌ لا يغيب."}],"hadiths":[]},{"situationId":73,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"الخلوة حين يغيب عنك من يراقبك","bridge":"غاب عنك من يراقبك؟ ﴿كُنتَ أَنتَ الرَّقِيبَ عَلَيْهِمْ وَأَنتَ عَلَىٰ كُلِّ شَيْءٍ شَهِيدٌ﴾ — كلمة عيسى التي يقولها النبي ﷺ يوم الحشر: الشهيد لا يغيب."}]},{"situationId":74,"verses":[{"i":4,"strength":"direct","headline":"العفة داخل البيوت حيث لا رقيب من الناس","bridge":"تعيش داخل بيتك حيث لا رقيب ولا قانون؟ خُتمت أحكام المحارم داخل البيوت: ﴿وَاتَّقِينَ اللَّهَ إِنَّ اللَّهَ كَانَ عَلَى كُلِّ شَيْءٍ شَهِيدًا﴾ — الرقيب الوحيد في هذه المساحة هو الشهيد على كل شيء؛ فالعفة داخل البيوت لا يحرسها قانون بل إيمانٌ بشهيدٍ يرى."}],"hadiths":[]},{"situationId":134,"verses":[{"i":3,"strength":"direct","headline":"نزاعٌ فكريٌّ أو دينيٌّ لا يُحسم بالكلام","bridge":"نزاعٌ فكري أو ديني لا يُحسم بالكلام؟ عُدّت الملل الست ثم: ﴿إِنَّ اللَّهَ يَفْصِلُ بَيْنَهُمْ يَوْمَ الْقِيَامَةِ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ شَهِيدٌ﴾ — الجدال بين الملل لا يُحسم اليوم بالكلام بل غدًا بشهادة من شهد الجميع؛ فقضاؤه عن شهادةٍ لا عن رواية، فقدّم حجتك واترك الفصل له."}],"hadiths":[]},{"situationId":137,"verses":[{"i":8,"strength":"direct","headline":"مشاهدة الظلم والاكتفاء بالفرجة عليه","bridge":"ترى منكرًا وتكتفي بالمشاهدة؟ طغاة الأخدود ﴿وَهُمْ عَلَى مَا يَفْعَلُونَ بِالْمُؤْمِنِينَ شُهُودٌ﴾ ثم ﴿وَاللَّهُ عَلَى كُلِّ شَيْءٍ شَهِيدٌ﴾ — شهودُهم على الجريمة قوبل بشهادته عليهم؛ فمن تلذذ بمشاهدة الظلم أو اكتفى بالفرجة فهو في السجل شريك."}],"hadiths":[]},{"situationId":138,"verses":[{"i":5,"strength":"direct","headline":"شبهةٌ في كسبٍ يمرّ عبر الدين والدعوة","bridge":"شبهةٌ في كسبٍ يمرّ عبر دينك أو دعوتك؟ ﴿قُلْ مَا سَأَلْتُكُمْ مِنْ أَجْرٍ فَهُوَ لَكُمْ إِنْ أَجْرِيَ إِلَّا عَلَى اللَّهِ وَهُوَ عَلَى كُلِّ شَيْءٍ شَهِيدٌ﴾ — استقلال الداعية عن أجور الناس شرط صدقه، وأجره محفوظ عند شهيدٍ لا ينسى؛ فلا تجعل الدين بابًا لكسبٍ مشبوه."}],"hadiths":[]},{"situationId":175,"verses":[{"i":6,"strength":"direct","headline":"التأمّل في اكتشافات الكون وأسرار الجسد","bridge":"تتابع اكتشافات الكون والجسد؟ كل اكتشافٍ تحقيقٌ لوعد: ﴿سَنُرِيهِمْ آيَاتِنَا فِي الْآفَاقِ وَفِي أَنْفُسِهِمْ حَتَّى يَتَبَيَّنَ لَهُمْ أَنَّهُ الْحَقُّ أَوَلَمْ يَكْفِ بِرَبِّكَ أَنَّهُ عَلَى كُلِّ شَيْءٍ شَهِيدٌ﴾ — آيات الآفاق والأنفس شهادةٌ متجددة؛ فاقرأ كل اكتشافٍ على أنه وفاءٌ بـ«سنريهم»."}],"hadiths":[]}]},{"id":154,"name":"الملك القدوس السلام المؤمن المهيمن العزيز الجبار المتكبر","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: الْمَلِكُ الْقُدُّوسُ السَّلَامُ الْمُؤْمِنُ الْمُهَيْمِنُ الْعَزِيزُ الْجَبَّارُ الْمُتَكَبِّرُ — ثمانية أسماء متتابعة | المواضع: 1 (الحشر: 23)\nخصوصية: أعظمُ نسقٍ اسميٍّ في القرآن — ثمانية أسماء في آيةٍ واحدة، وهي وسط آيات الأسماء الجامعة في خواتيم الحشر.\n\nالمعنى:\n- الملك: المالك المتصرف.\n- القدوس: المنزّه عن كل نقص.\n- السلام: السالم من كل عيب، ومنه السلامة.\n- المؤمن: المصدّق لرسله، المؤمِّن لعباده من الخوف.\n- المهيمن: الرقيب الشاهد المسيطر.\n- العزيز: الغالب.\n- الجبار: الذي يجبر الكسر ويقهر الجبابرة.\n- المتكبر: المتعالي عن صفات الخلق.","teaches":"الحقائق التي كشفها الموضع:\n1. ثمانية أسماء ترسم صورةً متكاملة: ملكٌ منزّهٌ سالمٌ مؤمِّنٌ مهيمنٌ عزيزٌ جبارٌ متكبر.\n2. «الجبار» يجبر كسرك كما يقهر من كسرك.\n3. «المؤمن» يؤمّن عباده من الخوف — فالأمن اسمٌ من أسمائه.\n4. من اجتمعت له هذه الصفات يستحيل أن يُشرَك به.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند الانكسار: ادعُ «الجبار».\n- عند الخوف: ادعُ «المؤمن».\n- عند تلاوة خواتيم الحشر.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. جبر الكسر: «اللَّهُمَّ اغْفِرْ لِي وَارْحَمْنِي وَاجْبُرْنِي وَارْفَعْنِي وَارْزُقْنِي وَاهْدِنِي وَعَافِنِي» — بين السجدتين (رواه أبو داود والترمذي).\n2. سؤال الأمن من المؤمن: «اللَّهُمَّ اسْتُرْ عَوْرَاتِي وَآمِنْ رَوْعَاتِي» — رواه أبو داود.\n3. بعد السلام من الصلاة: «اللَّهُمَّ أَنْتَ السَّلَامُ وَمِنْكَ السَّلَامُ» — رواه مسلم.","summary":"ثمانية أسماء في آية — ومنها «الجبار» بوجهيه: يقهر من كسرك، ويجبر ما انكسر فيك — فقل في سجودك: «اللهم اجبرني».","verses":[{"i":1,"of":1,"s":59,"surah":"الحشر","a":23,"text":"هُوَ اللَّهُ الَّذِي لَا إِلَهَ إِلَّا هُوَ الْمَلِكُ الْقُدُّوسُ السَّلَامُ الْمُؤْمِنُ الْمُهَيْمِنُ الْعَزِيزُ الْجَبَّارُ الْمُتَكَبِّرُ سُبْحَانَ اللَّهِ عَمَّا يُشْرِكُونَ","prev":{"a":22,"text":"هُوَ اللَّهُ الَّذِي لَا إِلَهَ إِلَّا هُوَ عَالِمُ الْغَيْبِ وَالشَّهَادَةِ هُوَ الرَّحْمَنُ الرَّحِيمُ"},"next":{"a":24,"text":"هُوَ اللَّهُ الْخَالِقُ الْبَارِئُ الْمُصَوِّرُ لَهُ الْأَسْمَاءُ الْحُسْنَى يُسَبِّحُ لَهُ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ وَهُوَ الْعَزِيزُ الْحَكِيمُ"},"reason":"نسقٌ صاعد يبني صورةً متكاملة: ملكٌ يملك، قدوسٌ منزّه، سلامٌ لا نقص فيه ولا يصدر عنه إلا السلامة، مؤمنٌ يؤمّن عباده، مهيمنٌ يراقب ويسيطر، عزيزٌ يغلب، جبارٌ يجبر الكسر ويقهر، متكبرٌ عن كل نقص. ثم التنزيه: ﴿سُبْحَانَ اللَّهِ عَمَّا يُشْرِكُونَ﴾ — فمن اجتمعت له هذه لا يُشرَك به.","adds":"الجبار له وجهان: يقهر الجبابرة ويجبر المكسورين — ومن أسمائه ما يُخاف منه ويُرجى فيه معًا."}],"hadiths":[],"sunnah":{"card":"الصيغة: الْمَلِكُ الْقُدُّوسُ السَّلَامُ الْمُؤْمِنُ الْمُهَيْمِنُ الْعَزِيزُ الْجَبَّارُ الْمُتَكَبِّرُ — مركّبة من ثمانية أسماء (آية الحشر)\nفي السنة: شاهد واحد (روايتان)\nخصوصية الورود في السنة: وردت الأسماء الثمانية متتالية بترتيب الآية في رواية الترمذي لحديث الإحصاء.","teaches":"1. أن الأسماء الثمانية في آية الحشر محصاة بترتيبها.","whenRecall":"- في آخر الحشر.\n- في إحصاء الأسماء.","whenPray":"عند الشعور بـ:\n1. الحاجة إلى تعظيم جامع.\nعند طلب:\n1. السلامة من الملك القدوس السلام.\nعند الرغبة في:\n1. إحصاء الأسماء.","duaItems":"لا صيغة منصوصة؛ ويُتلى آخر الحشر.","summary":"الأسماء الثمانية من آية الحشر محصاة في السنة بترتيبها."},"situations":[{"situationId":1,"verses":[{"i":1,"strength":"direct","headline":"انكسار الحال وانسداد المخارج","bridge":"انكسر أمرك وأطبق عليك؟ من أسمائه في هذا النسق ﴿الْجَبَّارُ﴾ — وله وجهان: يقهر الجبابرة ويجبر المكسورين؛ فاسأل الجبار جبر ما انكسر منك."}],"hadiths":[]}]},{"id":155,"name":"الواسع الحكيم","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: وَاسِعًا حَكِيمًا — مركّبة | المواضع: 1 (النساء: 130)\nخصوصية: جاء في أصعب لحظةٍ أسرية: لحظة الفراق النهائي بين الزوجين.\n\nالمعنى:\n- الواسع: واسع الفضل والرزق والرحمة.\n- الحكيم: يضع كل شيءٍ موضعه.","teaches":"الحقائق التي كشفها الموضع:\n1. الفراق قد يكون حكمة — والوعد بالتعويض للطرفين معًا.\n2. سعتُه تكفي لتعويض كل مفترقين.\n3. الشرع يستنفد الإصلاح قبل الفراق — ثم لا يترك المفترقين بلا وعد.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- بعد طلاقٍ أو انفصال.\n- عند الخوف من المستقبل بعد نهاية علاقة.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. عند الفراق: ﴿يُغْنِ اللَّهُ كُلًّا مِنْ سَعَتِهِ﴾ — النساء 130.\n2. سؤال البدل الأحسن: «اللَّهُمَّ أْجُرْنِي فِي مُصِيبَتِي وَأَخْلِفْ لِي خَيْرًا مِنْهَا» — رواه مسلم.\n3. الدعاء بالخير للطرف الآخر — فالوعد لكليهما.","summary":"لمن انتهت علاقته: ﴿وَإِنْ يَتَفَرَّقَا يُغْنِ اللَّهُ كُلًّا مِنْ سَعَتِهِ﴾ — سعةٌ تكفي الطرفين، فلا أحد يخرج خاسرًا.","verses":[{"i":1,"of":1,"s":4,"surah":"النساء","a":130,"text":"وَإِنْ يَتَفَرَّقَا يُغْنِ اللَّهُ كُلًّا مِنْ سَعَتِهِ وَكَانَ اللَّهُ وَاسِعًا حَكِيمًا","prev":{"a":129,"text":"وَلَنْ تَسْتَطِيعُوا أَنْ تَعْدِلُوا بَيْنَ النِّسَاءِ وَلَوْ حَرَصْتُمْ فَلَا تَمِيلُوا كُلَّ الْمَيْلِ فَتَذَرُوهَا كَالْمُعَلَّقَةِ وَإِنْ تُصْلِحُوا وَتَتَّقُوا فَإِنَّ اللَّهَ كَانَ غَفُورًا رَحِيمًا"},"next":{"a":131,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَلَقَدْ وَصَّيْنَا الَّذِينَ أُوتُوا الْكِتَابَ مِنْ قَبْلِكُمْ وَإِيَّاكُمْ أَنِ اتَّقُوا اللَّهَ وَإِنْ تَكْفُرُوا فَإِنَّ لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَانَ اللَّهُ غَنِيًّا حَمِيدًا"},"context":"بعد محاولات الإصلاح والصلح بين الزوجين: ﴿وَإِنْ يَتَفَرَّقَا يُغْنِ اللَّهُ كُلًّا مِنْ سَعَتِهِ وَكَانَ اللَّهُ وَاسِعًا حَكِيمًا﴾.","reason":"وعدٌ مزدوج عند الفراق: ﴿يُغْنِ اللَّهُ كُلًّا﴾ — كليهما، لا أحدهما على حساب الآخر — «من سعته»: فسعتُه تكفي لتعويض طرفين افترقا؛ حكيمٌ يعلم أن بعض الفراق خيرٌ من بقاءٍ فاسد.","adds":"أرحمُ آيةٍ لمن انتهت علاقته الزوجية: الوعدُ بالغنى لكليهما — فلا أحد يخرج خاسرًا من سعة الواسع."}],"hadiths":[],"sunnah":{"card":"الصيغة: الْوَاسِعُ الْحَكِيمُ — مركّبة\nفي السنة: شاهد واحد (رواية واحدة)\nخصوصية الورود في السنة: وردا متجاورين في رواية الترمذي لحديث الإحصاء: «…المجيب، الواسع، الحكيم، الودود…».","teaches":"1. أنه واسع في عطائه حكيم في وضعه.","whenRecall":"- في إحصاء الأسماء.\n- حين تستقل ما أُعطيت: واسعٌ حكيم.","whenPray":"عند الشعور بـ:\n1. ضيق العطاء.\nعند طلب:\n1. سعةً بحكمة.\nعند الرغبة في:\n1. إحصاء الأسماء.","duaItems":"لا صيغة منصوصة؛ ويُدعى بالقرآن: «إن الله واسع حكيم» [النساء: 130].","summary":"«الواسع الحكيم» في السنة اسمان محصيان بعد المجيب."},"situations":[{"situationId":49,"verses":[{"i":1,"strength":"direct","headline":"انتهاء العلاقة الزوجية والخوف مما بعدها","bridge":"انتهت علاقتك الزوجية وتخاف ما بعدها؟ أرحم آيةٍ لك: ﴿وَإِنْ يَتَفَرَّقَا يُغْنِ اللَّهُ كُلًّا مِنْ سَعَتِهِ وَكَانَ اللَّهُ وَاسِعًا حَكِيمًا﴾ — وعدٌ بالغنى لكليهما لا لأحدهما على حساب الآخر؛ سعته تكفي طرفين افترقا، وحكمته تعلم أن بعض الفراق خيرٌ من بقاءٍ فاسد."}],"hadiths":[]}]},{"id":156,"name":"رب العرش الكريم","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: رَبُّ الْعَرْشِ الْكَرِيمِ — مضافة | المواضع: 1 (المؤمنون: 116)\nخصوصية: خاتمة سورة المؤمنون — وفيها الجمع بين «الملك الحق» و«رب العرش الكريم».\n\nالمعنى:\n- رب العرش الكريم: مالكُ العرش الموصوف بالكرم — كرمُ العرش من كرم ربّه.","teaches":"الحقائق التي كشفها الموضع:\n1. نفي العبث عن الخلق يستلزم البعث والحساب.\n2. الملك الحق لا يخلق سدًى.\n3. كرمُ العرش من كرم ربّه.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند الشعور بلا معنى للحياة.\n- عند ختام قراءة سورة المؤمنون.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. دعاء خاتمة المؤمنون: ﴿رَبِّ اغْفِرْ وَارْحَمْ وَأَنْتَ خَيْرُ الرَّاحِمِينَ﴾ — المؤمنون 118.\n2. التوسل برب العرش الكريم عند الكرب.\n3. سؤال معنى الحياة وغايتها والثبات عليها.","summary":"﴿أَفَحَسِبْتُمْ أَنَّمَا خَلَقْنَاكُمْ عَبَثًا﴾ — لست صدفة: خلقك ملكٌ حقٌّ ربُّ العرش الكريم لغايةٍ ومرجع.","verses":[{"i":1,"of":1,"s":23,"surah":"المؤمنون","a":116,"text":"فَتَعَالَى اللَّهُ الْمَلِكُ الْحَقُّ لَا إِلَهَ إِلَّا هُوَ رَبُّ الْعَرْشِ الْكَرِيمِ","prev":{"a":115,"text":"أَفَحَسِبْتُمْ أَنَّمَا خَلَقْنَاكُمْ عَبَثًا وَأَنَّكُمْ إِلَيْنَا لَا تُرْجَعُونَ"},"next":{"a":117,"text":"وَمَنْ يَدْعُ مَعَ اللَّهِ إِلَهًا آخَرَ لَا بُرْهَانَ لَهُ بِهِ فَإِنَّمَا حِسَابُهُ عِنْدَ رَبِّهِ إِنَّهُ لَا يُفْلِحُ الْكَافِرُونَ"},"reason":"جاء بعد أخطر سؤال: أظننتم الخلق عبثًا بلا رجوع؟ — فالتعالي والملك الحق وربوبية العرش الكريم كلها تنفي العبث: مَلِكٌ حقٌّ لا يخلق سدًى، وربُّ عرشٍ كريم لا يُهمل خلقه. فنفيُ العبث يستلزم البعث.","adds":"﴿أَفَحَسِبْتُمْ أَنَّمَا خَلَقْنَاكُمْ عَبَثًا﴾ — أقوى ردٍّ على من يظن حياته بلا معنى: وجودُك ليس صدفةً ولا عبثًا."}],"hadiths":[{"i":1,"of":1,"text":"أنَّ نَبيَّ اللهِ صلَّى اللهُ عليه وسلَّم كان يقولُ عِندَ الكَربِ: لا إلَهَ إلَّا اللهُ العَظيمُ الحَليمُ، لا إلَهَ إلَّا اللهُ رَبُّ العَرشِ العَظيمِ، لا إلَهَ إلَّا اللهُ رَبُّ السَّمَواتِ ورَبُّ الأرضِ ورَبُّ العَرشِ الكَريمِ. وفي روايةٍ: أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم كان يَدعو بهنَّ ويقولُهنَّ عِندَ الكَربِ، فذَكَرَ بمِثلِ حَديثِ مُعاذِ بنِ هِشامٍ، عن أبيه، عن قَتادةَ، غيرَ أنَّه قال: رَبُّ السَّمَواتِ والأرضِ. وفي روايةٍ: أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم كانَ إذا حَزَبَه أمرٌ، قال: فذَكَرَ بمِثلِ حَديثِ مُعاذٍ، عن أبيه. وزادَ معهُنَّ: لا إلَهَ إلَّا اللهُ رَبُّ العَرشِ الكَريمِ.","narrator":"عبدالله بن عباس","source":"صحيح مسلم 2730","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/9gq6zyAJ","nameForm":"ورَبُّ العَرشِ الكَريمِ ؛ رَبُّ العَرشِ الكَريمِ","scene":"دعاء الكرب النبوي بتهليلاته الثلاث، آخرها: «لا إله إلا الله رب السماوات ورب الأرض ورب العرش الكريم». وفي رواية زاد معهن: «لا إله إلا الله رب العرش الكريم».","reason":"ختم دعاء الكرب بالعرش الكريم بعد العرش العظيم: عظمةٌ ثم كرم — المكروب بعد أن يُعظّم يرجو الكرم. فالاسم خاتمة التدرج من التعظيم إلى الرجاء.","adds":"يُتمّ الشاهد دعاء الكرب بالكرم بعد العظمة."}],"sunnah":{"card":"الصيغة: رَبُّ الْعَرْشِ الْكَرِيمِ — مركّبة\nفي السنة: شاهد واحد (4 روايات)\nخصوصية الورود في السنة: خاتمة دعاء الكرب: «لا إله إلا الله رب السماوات ورب الأرض ورب العرش الكريم» (مسلم)، وفي كلمات التلقين للموتى «سبحان الله رب العرش الكريم».","teaches":"1. أن عرشه كريم: بعد التعظيم يُرجى الكرم.\n2. أنه يُلقَّن للموتى.","whenRecall":"- في آخر دعاء الكرب.\n- عند تلقين المحتضر.","whenPray":"عند الشعور بـ:\n1. الكرب.\nعند طلب:\n1. الكرم بعد التعظيم.\nعند الرغبة في:\n1. تلقين الموتى.","duaItems":"دعاء الكرب — صحيح مسلم 2730؛ وكلمات التلقين — الأحاديث المختارة 9/149.","summary":"«رب العرش الكريم» في السنة خاتمة دعاء الكرب: من العرش العظيم إلى العرش الكريم — تعظيمٌ فرجاء."},"situations":[{"situationId":1,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"الكرب الشديد ورجاء الكرم بعد التعظيم","bridge":"أطبق عليك الأمر؟ آخر تهليلات الكرب: «لا إله إلا الله رب السماوات ورب الأرض ورب العرش الكريم» — بعد أن تعظّم، ارجُ الكرم."}]},{"situationId":158,"verses":[{"i":1,"strength":"direct","headline":"ختام المجلس أو اليوم بالتنزيه والتوحيد","bridge":"تختم مجلسًا أو يومًا؟ اختمه بما جاء في خواتيم سورة المؤمنون: ﴿فَتَعَالَى اللَّهُ الْمَلِكُ الْحَقُّ لَا إِلَهَ إِلَّا هُوَ رَبُّ الْعَرْشِ الْكَرِيمِ﴾ — تنزيهٌ وتوحيدٌ وإقرار بربوبية العرش الكريم؛ خاتمةٌ تذكّرك أن ما مضى من مجلسك ليس عبثًا وأن مرجعه إلى ربّ عرشٍ كريم."}],"hadiths":[]}]},{"id":157,"name":"بكل شيء بصير","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: بِكُلِّ شَيْءٍ بَصِيرٌ — | المواضع: 1 (الملك: 19)\nخصوصية: جاء في آية الطير الصافّات — أدقّ مشهدٍ يوميٍّ يُغفل عنه.\n\nالمعنى:\n- بكل شيء بصير: المبصرُ لكل شيءٍ إبصارًا محيطًا، لا يخفى عليه دقيقٌ ولا جليل.","teaches":"الحقائق التي كشفها الموضع:\n1. ما تسميه قوانين الطيران إمساكُ الرحمن.\n2. الإبصار المحيط شرط الإمساك المحيط.\n3. أعظم الآيات فوق رؤوسنا ونحن لا نرفع أبصارنا.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند رؤية طائرٍ محلّق.\n- عند الغفلة عن الآيات اليومية.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. التأمل في الطير ذكرًا وشكرًا — الملك 19.\n2. سؤال الإمساك والحفظ ممن يمسك السماء والطير.\n3. المداومة على سورة الملك — فهي الشافعة.","summary":"ارفع رأسك إلى طيرٍ يحلّق: ﴿مَا يُمْسِكُهُنَّ إِلَّا الرَّحْمَنُ إِنَّهُ بِكُلِّ شَيْءٍ بَصِيرٌ﴾ — ما تسميه قانونًا هو إمساكُ رحمن.","verses":[{"i":1,"of":1,"s":67,"surah":"الملك","a":19,"text":"أَوَلَمْ يَرَوْا إِلَى الطَّيْرِ فَوْقَهُمْ صَافَّاتٍ وَيَقْبِضْنَ مَا يُمْسِكُهُنَّ إِلَّا الرَّحْمَنُ إِنَّهُ بِكُلِّ شَيْءٍ بَصِيرٌ","prev":{"a":18,"text":"وَلَقَدْ كَذَّبَ الَّذِينَ مِنْ قَبْلِهِمْ فَكَيْفَ كَانَ نَكِيرِ"},"next":{"a":20,"text":"أَمَّنْ هَذَا الَّذِي هُوَ جُنْدٌ لَكُمْ يَنْصُرُكُمْ مِنْ دُونِ الرَّحْمَنِ إِنِ الْكَافِرُونَ إِلَّا فِي غُرُورٍ"},"reason":"مشهدٌ فوق رؤوسهم يوميًّا: طيرٌ تبسط أجنحتها وتقبضها في الهواء بلا سند — ﴿مَا يُمْسِكُهُنَّ إِلَّا الرَّحْمَنُ﴾؛ وخُتم بالبصير: الذي يمسك كل طائرٍ في السماء يبصر كل شيء — فالإمساكُ فرعُ الإبصار: لا يمسك ما لا يرى.","adds":"اختيار «الرحمن» في آية الطير لافت: إمساكُ الطير في الهواء رحمةٌ جارية لا مجرد قانون فيزياء."}],"hadiths":[{"i":1,"of":1,"text":"رأيتُ رسولَ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّمَ وهو يقرأُ هذِهِ الآيةَ يعني خاتمةِ سورةِ النُّورِ وَهوَ جاعلٌ أصبعيْهِ تحتَ عينيْهِ يقولُ (وَاللَّهُ بِكُلِّ شَيْءٍ بَصِيرٌ)","narrator":"عقبة بن عامر","source":"الدر المنثور 11/132","grade":"حسن","judgment":"إسناده حسن","url":"https://dorar.net/h/JbSY003b","nameForm":"بِكُلِّ شَيْءٍ بَصِيرٌ","scene":"عقبة بن عامر: رأى النبي ﷺ يقرأ آيةً وهو جاعلٌ أصبعيه تحت عينيه يقول: «والله بكل شيء بصير».","reason":"الإشارة إلى العين عند الاسم إثباتٌ لحقيقة البصر: يبصر كل شيء بصرًا حقيقيًّا.","adds":"يُوثّق الاسم بإشارة نبوية."}],"sunnah":{"card":"الصيغة: بِكُلِّ شَيْءٍ بَصِيرٌ — مركّبة\nفي السنة: شاهد واحد (رواية واحدة)\nخصوصية الورود في السنة: عقبة: رأيت النبي ﷺ يقرأ خاتمة النور «والله بكل شيء بصير» وهو جاعلٌ إصبعيه تحت عينيه.","teaches":"1. أن بصره حقيقة، أشار النبي ﷺ إلى عينيه عند اسمه.","whenRecall":"- عند خاتمة النور.\n- حين تظن أن فعلك لا يُرى.","whenPray":"عند الشعور بـ:\n1. الخلوة بمعصية.\nعند طلب:\n1. أن يراك حيث يحب.\nعند الرغبة في:\n1. الإشارة عند الآية كما أشار.","duaItems":"لا صيغة منصوصة؛ وتُتلى خاتمة النور مع الإشارة — الدر المنثور 11/132 (إسناده حسن).","summary":"«بكل شيء بصير» في السنة آية يقرؤها النبي ﷺ جاعلًا إصبعيه تحت عينيه."},"situations":[{"situationId":73,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"الخلوة حيث لا يراك أحدٌ من الناس","bridge":"وحدك ولا يراك أحد؟ قرأ النبي ﷺ خاتمة الآية وقال: «والله بكل شيء بصير» وهو جاعلٌ أصبعيه تحت عينيه — البصر حقيقة."}]},{"situationId":175,"verses":[{"i":1,"strength":"direct","headline":"التأمل في مشاهد الخلق اليومية فوق رأسك","bridge":"تنظر في السماء؟ ارفع بصرك إلى ما فوق رأسك يوميًّا: ﴿أَوَلَمْ يَرَوْا إِلَى الطَّيْرِ فَوْقَهُمْ صَافَّاتٍ وَيَقْبِضْنَ مَا يُمْسِكُهُنَّ إِلَّا الرَّحْمَنُ إِنَّهُ بِكُلِّ شَيْءٍ بَصِيرٌ﴾ — طيرٌ معلق بلا سند، والإمساك فرع الإبصار: لا يمسك ما لا يرى؛ فكل طائرٍ تراه برهانٌ على بصرٍ يرى كل شيء."}],"hadiths":[]}]},{"id":158,"name":"الله رب العالمين الرحمن الرحيم مالك يوم الدين","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: رَبِّ الْعَالَمِينَ * الرَّحْمَنِ الرَّحِيمِ * مَالِكِ يَوْمِ الدِّينِ — نسق متتابع | المواضع: 3 (الفاتحة: 2-4)\nخصوصية: النسقُ الذي تقرؤه سبعَ عشرة مرةً في اليوم على الأقل — أعظمُ ترتيبٍ للتعرف على الله.\n\nالمعنى:\n- رب العالمين: خالقهم ومربّيهم جميعًا.\n- الرحمن الرحيم: واسعُ الرحمة موصلُها.\n- مالك يوم الدين: المالكُ المتصرف يوم الجزاء.","teaches":"الحقائق التي كشفتها المواضع:\n1. الحمد قبل الطلب — أدب الفاتحة كلها.\n2. الرحمة تتوسط الربوبية والملك — فلا رهبة بلا رحمة.\n3. العبادة تُبنى على معرفةٍ مكتملة لا على خوفٍ وحده ولا رجاءٍ وحده.","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- في كل ركعة تصليها — سبع عشرة مرة يوميًّا على الأقل.\n- عند اختلال صورتك عن الله خوفًا أو أمنًا.","whenPray":"بنود الدعاء — مشتقة من سياق المواضع:\n1. تدبر الفاتحة في كل صلاة — وفي الحديث القدسي: «قَسَمْتُ الصَّلَاةَ بَيْنِي وَبَيْنَ عَبْدِي نِصْفَيْنِ» (رواه مسلم).\n2. الوقوف عند كل آيةٍ لتُجاب: «حمدني عبدي، أثنى عليّ عبدي، مجّدني عبدي».\n3. سؤال الهداية للصراط المستقيم — غاية الفاتحة.","summary":"ترتيبٌ تقرؤه سبع عشرة مرةً يوميًّا: ربٌّ للعالمين، فرحمةٌ مثناة، فملكُ يوم الدين — ثم ﴿إِيَّاكَ نَعْبُدُ﴾: معرفةٌ مكتملة تسبق العبادة.","verses":[{"i":1,"of":1,"s":1,"surah":"الفاتحة","a":2,"last":4,"text":"الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ الرَّحْمَنِ الرَّحِيمِ مَالِكِ يَوْمِ الدِّينِ","prev":{"a":1,"text":"بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"},"next":{"a":5,"text":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ"},"context":"﴿الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ﴾ — أول ما يُقال بعد البسملة.","reason":"بُدئ بالحمد مقرونًا بالربوبية العامة: ربُّ العالمين كلهم — لا ربُّ فئةٍ ولا قوم؛ فأولُ ما تعرفه عنه أنه ربُّ الجميع، وأولُ ما تقدّمه له الحمد قبل الطلب.","adds":"علّمك أن تبدأ بالحمد قبل السؤال في كل ركعة — فأدبُ الطلب مقدَّمٌ على الطلب."}],"hadiths":[{"i":1,"of":1,"text":"أنه كان يعِدُ الصحابةَ بالخروجِ في يومٍ معينٍ إلى المصلَّى ويخرجُ في ذلك اليومِ بعد طلوعِ الشمسِ بهيئةِ الخاشعِ المتواضعِ مبتذلًا ، فإذا وصل إلى المصلَّى صعِدَ المنبرَ وقرأ الخطبةَ ، والمحفوظُ منها : الحمدُ للهِ ربِّ العالمينَ الرحمنِ الرحيمِ مالكِ يومِ الدينِ ، لا إلهَ إلَّا اللهُ يفعلُ ما يريدُ ، اللهمَّ أنت اللهُ الذي لا إلهَ إلا أنت تفعلُ ما تريدُ ، اللهمَّ أنت اللهُ الذي لا إلهَ إلا أنتَ ، أنت الغنيُّ ونحن الفقراءُ أنزلْ علينا الغيثَ واجعلْ ما أنزلتَ لنا قوتًا وبلاغًا إلى حينٍ ، ثمَّ رفع يديهِ وأخذ في التضرعِ والابتهالِ والدعاءِ وبالَغَ في الرَّفعِ حتَّى بدا بياضُ إبطيهِ ، ثمَّ استقبل القبلةَ واستدبرَ الحاضرينَ وقلبَ رداءَهُ المبارَكَ حتَّى صار طرَفُ اليمينِ على الجانبِ الشمالِ وطرَفُ الشِّمالِ على الجانبِ اليمينِ ، وما كان من الرِّداءِ داخِلًا صار خارِجًا وما كان خارِجًا صار داخِلًا ، وكان الرداءُ أسودَ اللونِ ، وأخذ في الدُّعاءِ كذلك ثمَّ نزل وشرع في الصلاةِ فصلَّى ركعتين بغيرِ أذانٍ ولا إقامةٍ جهر فيهما بالقراءةِ وقرأ في الركعةِ الأولَى بعد الفاتحةِ { سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى } وفي الثانيةِ { هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ }","narrator":"-","source":"سفر السعادة 121","grade":"صحيح","judgment":"ثابت","url":"https://dorar.net/h/FIBfmsdD","nameForm":"للهِ ربِّ العالمينَ الرحمنِ الرحيمِ مالكِ يومِ الدينِ","scene":"خطبة الاستسقاء على المنبر في المصلى: «الحمد لله رب العالمين الرحمن الرحيم مالك يوم الدين، لا إله إلا الله يفعل ما يريد، اللهم أنت الله الذي لا إله إلا أنت تفعل ما تريد، أنت الغني ونحن الفقراء، أنزل علينا الغيث…».","reason":"الفاتحة تُقدَّم بين يدي طلب المطر: حمدٌ وثناءٌ وتمجيد بالأسماء الثلاثة قبل السؤال — فالجدب يُرفع بمن يُحمد ويُثنى عليه ويُمجَّد.","adds":"يُري الأسماء الثلاثة مقدمةً لدعاء الاستسقاء."}],"sunnah":{"card":"الصيغة: اللَّهُ رَبُّ الْعَالَمِينَ الرَّحْمَنُ الرَّحِيمُ مَالِكُ يَوْمِ الدِّينِ — مركّبة، آيات الفاتحة\nفي السنة: شاهد واحد (روايتان)\nخصوصية الورود في السنة: في خطبة الاستسقاء: «الحمد لله رب العالمين الرحمن الرحيم مالك يوم الدين، لا إله إلا الله يفعل ما يريد… أنت الغني ونحن الفقراء».","teaches":"1. أن الحمد والثناء والتمجيد بأسماء الفاتحة يُقدَّم قبل الطلب.","whenRecall":"- عند الاستسقاء.\n- في كل ركعة.","whenPray":"عند الشعور بـ:\n1. الجدب والحاجة.\nعند طلب:\n1. الغيث.\nعند الرغبة في:\n1. الثناء قبل الطلب.","duaItems":"خطبة الاستسقاء — سفر السعادة 121، المستدرك 1242.","summary":"أسماء الفاتحة الثلاثة في السنة مقدمةُ دعاء الاستسقاء قبل «أنزل علينا الغيث»."},"situations":[{"situationId":162,"verses":[{"i":1,"strength":"direct","headline":"أدب الوقوف بين يدي الله بالحمد قبل السؤال","bridge":"في كل ركعة تبدأ بـ﴿الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ﴾ — علّمك أن تبدأ بالحمد قبل السؤال؛ فأدب الطلب مقدَّمٌ على الطلب، وأول ما تعرفه عنه في صلاتك أنه ربُّ الجميع لا ربُّ فئة."}],"hadiths":[{"i":1,"strength":"direct","headline":"افتتاح الدعاء بالثناء قبل عرض الحاجة","bridge":"تريد أن تقدّم بين يدي طلبك؟ افتتح كما افتتح النبي ﷺ الاستسقاء: الحمد لله رب العالمين الرحمن الرحيم مالك يوم الدين — ثم سل."}]}]},{"id":159,"name":"التواب الحكيم","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: تَوَّابٌ حَكِيمٌ — مركّبة | المواضع: 1 (النور: 10)\nخصوصية: جاء في آية اللعان — أدقّ تشريعٍ في أزمة اتهام الزوج لزوجته.\n\nالمعنى:\n- التواب: كثير قبول التوبة.\n- الحكيم: واضع الأمور مواضعها.","teaches":"الحقائق التي كشفها الموضع:\n1. الشريعة تضع مخارج لأعقد الأزمات الأسرية.\n2. حين تنعدم البيّنة تُوكل السرائر إلى التواب.\n3. حذف جواب «لولا» أبلغ من ذكره.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند أزمةٍ زوجية حادة بلا بيّنات.\n- عند الاتهام في العرض.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. سؤال الستر: «اللَّهُمَّ اسْتُرْ عَوْرَاتِي» — رواه أبو داود.\n2. التوبة قبل أن ينكشف الأمر.\n3. سؤال الحكمة في معالجة الأزمات الأسرية.","summary":"في أعقد أزمةٍ أسرية شُرع مخرجٌ يحفظ الحقوق ويكل السرائر إلى ﴿تَوَّابٌ حَكِيمٌ﴾ — يقبل من رجع، ويضع كل أمرٍ موضعه.","verses":[{"i":1,"of":1,"s":24,"surah":"النور","a":10,"text":"وَلَوْلَا فَضْلُ اللَّهِ عَلَيْكُمْ وَرَحْمَتُهُ وَأَنَّ اللَّهَ تَوَّابٌ حَكِيمٌ","prev":{"a":9,"text":"وَالْخَامِسَةَ أَنَّ غَضَبَ اللَّهِ عَلَيْهَا إِنْ كَانَ مِنَ الصَّادِقِينَ"},"next":{"a":11,"text":"إِنَّ الَّذِينَ جَاءُوا بِالْإِفْكِ عُصْبَةٌ مِنْكُمْ لَا تَحْسَبُوهُ شَرًّا لَكُمْ بَلْ هُوَ خَيْرٌ لَكُمْ لِكُلِّ امْرِئٍ مِنْهُمْ مَا اكْتَسَبَ مِنَ الْإِثْمِ وَالَّذِي تَوَلَّى كِبْرَهُ مِنْهُمْ لَهُ عَذَابٌ عَظِيمٌ"},"context":"بعد تفصيل اللعان — شهادات الزوج الأربع ولعنُه، ودرءُ العذاب عنها بشهاداتها — ﴿وَلَوْلَا فَضْلُ اللَّهِ عَلَيْكُمْ وَرَحْمَتُهُ وَأَنَّ اللَّهَ تَوَّابٌ حَكِيمٌ﴾.","reason":"جوابُ «لولا» محذوفٌ لتذهب النفس كل مذهب — أي لولا فضله لفُضحتم وعوقبتم؛ والاسمان: توابٌ يفتح باب التوبة لمن كذب منهما، حكيمٌ شرّع اللعان مخرجًا يحفظ الأسرة والحقوق حين تنعدم البيّنة.","adds":"حكمةُ التشريع في أعقد المواقف: زوجٌ بلا شهود وزوجةٌ متهمة — فشُرع مخرجٌ يحفظ ماء الوجه ويكل السرائر إلى التواب."}],"hadiths":[],"situations":[{"situationId":29,"verses":[{"i":1,"strength":"direct","headline":"الاتهام في العرض ولا بيّنة للبراءة","bridge":"اتُّهمتَ في عرضك بلا شهود؟ شُرع للزوجة المتهمة أن تدرأ العذاب بشهاداتها، وخُتم التشريع بـ﴿وَأَنَّ اللَّهَ تَوَّابٌ حَكِيمٌ﴾ — الحكيم لا يترك بريئًا بلا مخرج، والتواب يعلم من الكاذب ويفتح له باب الرجوع؛ فبراءتك محفوظة عند من شرّع لك المخرج."}],"hadiths":[]}]},{"id":160,"name":"العزيز العليم","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: الْعَزِيزِ الْعَلِيمِ — مركّبة | المواضع: 6 (الأنعام: 96 — النمل: 78 — يس: 38 — غافر: 2 — فصلت: 12 — الزخرف: 9)\nخصوصية: ثلاثةٌ من مواضعه تُختم بعبارة واحدة: ﴿ذَلِكَ تَقْدِيرُ الْعَزِيزِ الْعَلِيمِ﴾ — فهو اسمُ النظام الكوني الدقيق.\n\nالمعنى:\n- العزيز: الغالب الذي تنفذ إرادته في الأجرام فلا تشذّ.\n- العليم: الذي يضبط المقادير بعلمٍ دقيق.","teaches":"الحقائق التي كشفتها المواضع:\n1. النظام الكوني «تقديرٌ» لا صدفة — تكررت العبارة ثلاثًا.\n2. الشمس تجري لمستقر — فلكل جارٍ نهاية.\n3. المشركون مقرّون بالخالق: المشكلة في لوازم المعرفة لا في أصلها.\n4. الزينة والحفظ يجتمعان في تصميمه (فصلت 12).","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- عند تأمل انتظام الشمس والقمر ومواقيت الصلاة.\n- عند رؤية النجوم.\n- عند من يعرف الله ولا يعبده.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. الحمد على تقدير المواقيت الذي تنضبط به عبادتك — الأنعام 96.\n2. سؤال القضاء بالحق في الخلافات — النمل 78.\n3. سؤال إتمام لوازم المعرفة: علمٌ يورث عملًا.","summary":"ثلاثُ مراتٍ تتكرر: ﴿ذَلِكَ تَقْدِيرُ الْعَزِيزِ الْعَلِيمِ﴾ — فالشمس والقمر والليل والنهار تقديرٌ لا صدفة؛ وحتى الشمس تجري لمستقر.","verses":[{"i":1,"of":5,"s":6,"surah":"الأنعام","a":96,"text":"فَالِقُ الْإِصْبَاحِ وَجَعَلَ اللَّيْلَ سَكَنًا وَالشَّمْسَ وَالْقَمَرَ حُسْبَانًا ذَلِكَ تَقْدِيرُ الْعَزِيزِ الْعَلِيمِ","prev":{"a":95,"text":"إِنَّ اللَّهَ فَالِقُ الْحَبِّ وَالنَّوَى يُخْرِجُ الْحَيَّ مِنَ الْمَيِّتِ وَمُخْرِجُ الْمَيِّتِ مِنَ الْحَيِّ ذَلِكُمُ اللَّهُ فَأَنَّى تُؤْفَكُونَ"},"next":{"a":97,"text":"وَهُوَ الَّذِي جَعَلَ لَكُمُ النُّجُومَ لِتَهْتَدُوا بِهَا فِي ظُلُمَاتِ الْبَرِّ وَالْبَحْرِ قَدْ فَصَّلْنَا الْآيَاتِ لِقَوْمٍ يَعْلَمُونَ"},"reason":"سُمّي نظامُ الليل والنهار والشمس والقمر «تقديرًا» صادرًا عن عزيزٍ عليم: عزةٌ تفرض النظام على الأجرام فلا تشذّ، وعلمٌ يضبط الحسبان بدقةٍ يُبنى عليها التقويم كله.","adds":"دقة التقويم الفلكي التي تضبط بها صلاتك وصيامك ثمرةُ «تقدير العزيز العليم»."},{"i":2,"of":5,"s":27,"surah":"النمل","a":78,"text":"إِنَّ رَبَّكَ يَقْضِي بَيْنَهُمْ بِحُكْمِهِ وَهُوَ الْعَزِيزُ الْعَلِيمُ","prev":{"a":77,"text":"وَإِنَّهُ لَهُدًى وَرَحْمَةٌ لِلْمُؤْمِنِينَ"},"next":{"a":79,"text":"فَتَوَكَّلْ عَلَى اللَّهِ إِنَّكَ عَلَى الْحَقِّ الْمُبِينِ"},"context":"﴿إِنَّ رَبَّكَ يَقْضِي بَيْنَهُمْ بِحُكْمِهِ وَهُوَ الْعَزِيزُ الْعَلِيمُ﴾ — في اختلاف بني إسرائيل.","reason":"القضاء في خلافاتهم موكولٌ إليه: عزيزٌ ينفّذ حكمه فلا يُردّ، عليمٌ بحقيقة الخلاف وأصحابه. فالخلافاتُ المستعصية بين الطوائف مؤجلةٌ إلى قاضٍ يعلم ويقدر.","adds":"لا تُرهق نفسك بحسم كل خلافٍ تاريخي: القاضي عزيزٌ عليم، والموعد محدد."},{"i":3,"of":5,"s":36,"surah":"يس","a":38,"text":"وَالشَّمْسُ تَجْرِي لِمُسْتَقَرٍّ لَهَا ذَلِكَ تَقْدِيرُ الْعَزِيزِ الْعَلِيمِ","prev":{"a":37,"text":"وَآيَةٌ لَهُمُ اللَّيْلُ نَسْلَخُ مِنْهُ النَّهَارَ فَإِذَا هُمْ مُظْلِمُونَ"},"next":{"a":39,"text":"وَالْقَمَرَ قَدَّرْنَاهُ مَنَازِلَ حَتَّى عَادَ كَالْعُرْجُونِ الْقَدِيمِ"},"reason":"جريانُ الشمس إلى مستقرٍّ محدد — بمدارٍ وسرعةٍ ونهاية — تقديرُ عزيزٍ عليم: عزةٌ تسيّر جرمًا بهذا الحجم، وعلمٌ يحدد له مستقرًّا. والآيةُ سبقت علم الفلك بقرون في إثبات جريان الشمس.","adds":"حتى الشمس لها «مستقر» تنتهي إليه — فكل جارٍ في هذا الكون له نهايةٌ مقدَّرة، بما فيك."},{"i":4,"of":5,"s":41,"surah":"فصلت","a":12,"text":"فَقَضَاهُنَّ سَبْعَ سَمَاوَاتٍ فِي يَوْمَيْنِ وَأَوْحَى فِي كُلِّ سَمَاءٍ أَمْرَهَا وَزَيَّنَّا السَّمَاءَ الدُّنْيَا بِمَصَابِيحَ وَحِفْظًا ذَلِكَ تَقْدِيرُ الْعَزِيزِ الْعَلِيمِ","prev":{"a":11,"text":"ثُمَّ اسْتَوَى إِلَى السَّمَاءِ وَهِيَ دُخَانٌ فَقَالَ لَهَا وَلِلْأَرْضِ ائْتِيَا طَوْعًا أَوْ كَرْهًا قَالَتَا أَتَيْنَا طَائِعِينَ"},"next":{"a":13,"text":"فَإِنْ أَعْرَضُوا فَقُلْ أَنْذَرْتُكُمْ صَاعِقَةً مِثْلَ صَاعِقَةِ عَادٍ وَثَمُودَ"},"reason":"بناءُ السماوات وتوزيعُ أوامرها وتزيينُ الدنيا بالمصابيح مع الحفظ — كلُّه «تقدير العزيز العليم»: عزةٌ في البناء وعلمٌ في التوزيع؛ ولاحظ أن الزينة والحفظ اجتمعا في المصابيح: جمالٌ ووظيفة.","adds":"في تصميمه يجتمع الجمال والوظيفة: ﴿زَيَّنَّا السَّمَاءَ الدُّنْيَا بِمَصَابِيحَ وَحِفْظًا﴾ — فاجعل عملك جميلًا نافعًا."},{"i":5,"of":5,"s":43,"surah":"الزخرف","a":9,"text":"وَلَئِنْ سَأَلْتَهُمْ مَنْ خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ لَيَقُولُنَّ خَلَقَهُنَّ الْعَزِيزُ الْعَلِيمُ","prev":{"a":8,"text":"فَأَهْلَكْنَا أَشَدَّ مِنْهُمْ بَطْشًا وَمَضَى مَثَلُ الْأَوَّلِينَ"},"next":{"a":10,"text":"الَّذِي جَعَلَ لَكُمُ الْأَرْضَ مَهْدًا وَجَعَلَ لَكُمْ فِيهَا سُبُلًا لَعَلَّكُمْ تَهْتَدُونَ"},"reason":"إقرارٌ مؤكد من المشركين أنفسهم بالاسمين: يعرفون أن الخالق عزيزٌ عليم — ومع ذلك يعبدون سواه؛ فالمشكلة ليست في الجهل بالخالق بل في رفض لوازم المعرفة.","adds":"معرفةُ الله بلا عبادةٍ له هي مأزق المشركين نفسُه: ﴿لَيَقُولُنَّ خَلَقَهُنَّ الْعَزِيزُ الْعَلِيمُ﴾ ثم يشركون."}],"hadiths":[{"i":1,"of":1,"text":"قال النَّبيُّ صلَّى اللهُ عليه وسلَّم لأبي ذَرٍّ حينَ غَرَبَتِ الشَّمسُ: أتَدري أينَ تَذهَبُ؟ قُلتُ: اللهُ ورَسولُه أعلَمُ، قال: فإنَّها تَذهَبُ حتَّى تَسجُدَ تَحتَ العَرشِ، فتَستَأذِنَ، فيُؤذَنُ لَها، ويوشِكُ أن تَسجُدَ فلا يُقبَلَ منها، وتَستَأذِنَ فلا يُؤذَنَ لَها، يُقالُ لَها: ارجِعي مِن حَيثُ جِئتِ، فتَطلُعُ مِن مَغرِبِها، فذلك قَولُه تَعالى: {والشَّمسُ تَجري لمُستَقَرٍّ لَها ذلك تَقديرُ العَزيزِ العَليمِ} [يس: 38].","narrator":"أبو ذر الغفاري","source":"صحيح البخاري 3199","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/GHKXpqoM","nameForm":"العَزيزِ العَليمِ","scene":"البخاري: قال النبي ﷺ لأبي ذر حين غربت الشمس: «أتدري أين تذهب؟» قلت: الله ورسوله أعلم. قال: «فإنها تذهب حتى تسجد تحت العرش فتستأذن فيؤذن لها، ويوشك أن تسجد فلا يُقبل منها وتستأذن فلا يؤذن لها، يقال لها: ارجعي من حيث جئت، فتطلع من مغربها، فذلك قوله ﴿وَالشَّمْسُ تَجْرِي لِمُسْتَقَرٍّ لَّهَا ذَٰلِكَ تَقْدِيرُ الْعَزِيزِ الْعَلِيمِ﴾».","reason":"جريان الشمس وسجودها واستئذانها وردّها يومًا من مغربها: كله «تقدير العزيز العليم» — عزيزٌ يأمر الشمس فتطيع، عليمٌ بموعد ردّها. فالاسم تفسيره سجود الشمس.","adds":"يُوثّق الاسم بتفسير نبوي في البخاري عند غروب الشمس."}],"sunnah":{"card":"الصيغة: الْعَزِيزُ الْعَلِيمُ — مركّبة\nفي السنة: شاهد واحد (روايتان)\nخصوصية الورود في السنة: قال النبي ﷺ لأبي ذر عند غروب الشمس: «أتدري أين تذهب؟… تذهب حتى تسجد تحت العرش فتستأذن فيؤذن لها… فذلك قوله ﴿وَالشَّمْسُ تَجْرِي لِمُسْتَقَرٍّ لَّهَا ذَٰلِكَ تَقْدِيرُ الْعَزِيزِ الْعَلِيمِ﴾» (البخاري).","teaches":"1. أن الشمس تسجد وتستأذن بتقديره.\n2. أن طلوعها من مغربها بأمره وعلمه.","whenRecall":"- عند غروب الشمس.\n- حين تقرأ يس 38.","whenPray":"عند الشعور بـ:\n1. انتظام الكون واستقرار الحياة.\nعند طلب:\n1. أن يجعلك من الساجدين قبل أن يُغلق باب التوبة.\nعند الرغبة في:\n1. التفكر في الغروب.","duaItems":"لا صيغة منصوصة؛ وتُتلى الآية عند الغروب كما فسّرها النبي ﷺ — صحيح البخاري 3199.","summary":"«العزيز العليم» في السنة تقدير الشمس: تسجد تحت العرش وتستأذن، ويوشك أن تُردّ — «ذلك تقدير العزيز العليم»."},"situations":[{"situationId":47,"verses":[{"i":4,"strength":"direct","headline":"إتقان العمل والجمع بين جماله ونفعه","bridge":"تصنع شيئًا وتحتار بين الجمال والوظيفة؟ في تصميم الخالق يجتمعان: ﴿وَزَيَّنَّا السَّمَاءَ الدُّنْيَا بِمَصَابِيحَ وَحِفْظًا ذَلِكَ تَقْدِيرُ الْعَزِيزِ الْعَلِيمِ﴾ — الزينة والحفظ في المصابيح نفسها؛ فاجعل عملك جميلًا ونافعًا معًا، فذاك تقدير العزيز العليم في صنعته."}],"hadiths":[]},{"situationId":101,"verses":[{"i":5,"strength":"direct","headline":"معرفة الله دون القيام بحق عبادته","bridge":"تعرف الله ولا تعبده حق عبادته؟ هذا مأزق المشركين نفسه: ﴿وَلَئِنْ سَأَلْتَهُمْ مَنْ خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ لَيَقُولُنَّ خَلَقَهُنَّ الْعَزِيزُ الْعَلِيمُ﴾ — أقرّوا بالاسمين ثم عبدوا سواه؛ فالمشكلة ليست الجهل بالخالق بل رفض لوازم المعرفة، والتوحيد أن تُتبع المعرفة بالعبادة."}],"hadiths":[]},{"situationId":134,"verses":[{"i":2,"strength":"direct","headline":"خصومةٌ طالت ولم يُحسم فيها فصل","bridge":"خصومةٌ طالت ولم يظهر فيها فصل؟ ﴿إِنَّ رَبَّكَ يَقْضِي بَيْنَهُمْ بِحُكْمِهِ وَهُوَ الْعَزِيزُ الْعَلِيمُ﴾ — عزيزٌ ينفّذ حكمه فلا يُردّ، عليمٌ بحقيقة الخلاف وأصحابه؛ فالخلافات المستعصية مؤجلةٌ إلى قاضٍ يعلم ويقدر، فلا تُرهق نفسك بحسم ما لم يُحسم."}],"hadiths":[]},{"situationId":177,"verses":[{"i":1,"strength":"direct","headline":"التفكر في نظام الليل والنهار ودقة حسابهما","bridge":"تضبط صلاتك وصيامك بمواقيت الشمس والقمر؟ ﴿فَالِقُ الْإِصْبَاحِ وَجَعَلَ اللَّيْلَ سَكَنًا وَالشَّمْسَ وَالْقَمَرَ حُسْبَانًا ذَلِكَ تَقْدِيرُ الْعَزِيزِ الْعَلِيمِ﴾ — عزةٌ تفرض النظام على الأجرام فلا تشذّ، وعلمٌ يضبط الحسبان بدقةٍ يُبنى عليها تقويمك وعبادتك."},{"i":3,"strength":"direct","headline":"التفكر في جريان الشمس وأن لكل جارٍ نهاية","bridge":"تتأمل الشمس؟ ﴿وَالشَّمْسُ تَجْرِي لِمُسْتَقَرٍّ لَهَا ذَلِكَ تَقْدِيرُ الْعَزِيزِ الْعَلِيمِ﴾ — جرمٌ بهذا الحجم يجري بمدارٍ وسرعةٍ ونهاية، وقد سبقت الآية علم الفلك بقرون في إثبات جريانها؛ فحتى الشمس لها مستقرٌّ تنتهي إليه، وكل جارٍ في الكون له نهايةٌ مقدَّرة بما فيك."}],"hadiths":[{"i":1,"strength":"direct","headline":"التأمل في غروب الشمس ومسيرها كل يوم","bridge":"تنظر إلى الغروب؟ سأل النبي ﷺ أبا ذر: «أتدري أين تذهب؟ تسجد تحت العرش فتستأذن… ذلك تقدير العزيز العليم» — ويوشك أن تُردّ."}]}]},{"id":161,"name":"بكل شيء عليم","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: بِكُلِّ شَيْءٍ عَلِيمٌ / عَلِيمًا — | المواضع: 20\nخصوصية: يُختم به تشريعُ الأحكام الدقيقة — آيةُ الدَّين (أطول آية)، والكلالة، والرجعة، والميراث — كأنه توقيعُ المشرّع؛ وفيه أعجبُ إحصاءٍ عددي في القرآن: و﴿ثَلَاثَةٍ إِلَّا هُوَ رَابِعُهُمْ﴾.\n\nالمعنى:\n- بكل شيء عليم: المحيطُ علمًا بكل موجودٍ ومعدوم، وكلِّ ظاهرٍ وباطن، وكلِّ ماضٍ وآتٍ — علمٌ لا يعزب عنه شيء.","teaches":"الحقائق التي كشفتها المواضع العشرون:\n1. لا مجلس سري في الوجود: و﴿ثَلَاثَةٍ إِلَّا هُوَ رَابِعُهُمْ﴾ (المجادلة 7).\n2. لا حساب قبل بيان: و﴿حَتَّى يُبَيِّنَ لَهُمْ مَا يَتَّقُونَ﴾ (التوبة 115).\n3. علاج الحسد مذكورٌ في موضعه: و﴿وَاسْأَلُوا اللَّهَ مِنْ فَضْلِهِ﴾ (النساء 32).\n4. التحايل على النصوص مكشوف: و﴿وَلَا تَتَّخِذُوا آيَاتِ اللَّهِ هُزُوًا﴾ (البقرة 231).\n5. ختم النبوة قرارٌ صادر عن علمٍ بكل شيء (الأحزاب 40).\n6. المصيبة بإذن، والإيمان يهدي القلب فيها (التغابن 11).\n7. المن بالتدين جهلٌ: و﴿أَتُعَلِّمُونَ اللَّهَ بِدِينِكُمْ﴾ (الحجرات 16).","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- في كل مجلسٍ تظنه سرًّا.\n- عند تمني ما عند غيرك.\n- عند التحايل على حكمٍ شرعي بحرفيّته.\n- عند كتابة دَينٍ أو توثيق حق.\n- عند المصيبة: اسأل هداية القلب.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. بدل الحسد: و﴿وَاسْأَلُوا اللَّهَ مِنْ فَضْلِهِ﴾ — النساء 32.\n2. عند المصيبة: سؤال هداية القلب — التغابن 11.\n3. سؤال السكينة عند الاستفزاز بدل حميّة الجاهلية — الفتح 26.\n4. سؤال البيان قبل الحساب: و﴿حَتَّى يُبَيِّنَ لَهُمْ مَا يَتَّقُونَ﴾.\n5. التبرؤ من المنّ بالتدين — الحجرات 16.","summary":"لا مجلسَ سريًّا في الوجود: و﴿مَا يَكُونُ مِنْ نَجْوَى ثَلَاثَةٍ إِلَّا هُوَ رَابِعُهُمْ﴾ — وهو توقيعُ المشرّع على كل حكمٍ دقيق: يعلم كل حالةٍ وما يصلح لها.","verses":[{"i":1,"of":20,"s":2,"surah":"البقرة","a":29,"text":"هُوَ الَّذِي خَلَقَ لَكُمْ مَا فِي الْأَرْضِ جَمِيعًا ثُمَّ اسْتَوَى إِلَى السَّمَاءِ فَسَوَّاهُنَّ سَبْعَ سَمَاوَاتٍ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ","prev":{"a":28,"text":"كَيْفَ تَكْفُرُونَ بِاللَّهِ وَكُنْتُمْ أَمْوَاتًا فَأَحْيَاكُمْ ثُمَّ يُمِيتُكُمْ ثُمَّ يُحْيِيكُمْ ثُمَّ إِلَيْهِ تُرْجَعُونَ"},"next":{"a":30,"text":"وَإِذْ قَالَ رَبُّكَ لِلْمَلَائِكَةِ إِنِّي جَاعِلٌ فِي الْأَرْضِ خَلِيفَةً قَالُوا أَتَجْعَلُ فِيهَا مَنْ يُفْسِدُ فِيهَا وَيَسْفِكُ الدِّمَاءَ وَنَحْنُ نُسَبِّحُ بِحَمْدِكَ وَنُقَدِّسُ لَكَ قَالَ إِنِّي أَعْلَمُ مَا لَا تَعْلَمُونَ"},"reason":"﴿خَلَقَ لَكُمْ﴾ — تسخيرٌ معلن لما في الأرض جميعًا؛ والعلمُ الشامل خاتمةُ الآية: يعلم ما في الأرض وما تحتاجه فسخّره لك على علمٍ لا اعتباطًا. فالتسخيرُ مبنيٌّ على علمٍ بحاجتك.","adds":"كل ما في الأرض مسخَّرٌ لك على علمٍ بحاجتك — فاستعمله في طاعةٍ لا في معصية."},{"i":2,"of":20,"s":2,"surah":"البقرة","a":231,"text":"وَإِذَا طَلَّقْتُمُ النِّسَاءَ فَبَلَغْنَ أَجَلَهُنَّ فَأَمْسِكُوهُنَّ بِمَعْرُوفٍ أَوْ سَرِّحُوهُنَّ بِمَعْرُوفٍ وَلَا تُمْسِكُوهُنَّ ضِرَارًا لِتَعْتَدُوا وَمَنْ يَفْعَلْ ذَلِكَ فَقَدْ ظَلَمَ نَفْسَهُ وَلَا تَتَّخِذُوا آيَاتِ اللَّهِ هُزُوًا وَاذْكُرُوا نِعْمَتَ اللَّهِ عَلَيْكُمْ وَمَا أَنْزَلَ عَلَيْكُمْ مِنَ الْكِتَابِ وَالْحِكْمَةِ يَعِظُكُمْ بِهِ وَاتَّقُوا اللَّهَ وَاعْلَمُوا أَنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ","prev":{"a":230,"text":"فَإِنْ طَلَّقَهَا فَلَا تَحِلُّ لَهُ مِنْ بَعْدُ حَتَّى تَنْكِحَ زَوْجًا غَيْرَهُ فَإِنْ طَلَّقَهَا فَلَا جُنَاحَ عَلَيْهِمَا أَنْ يَتَرَاجَعَا إِنْ ظَنَّا أَنْ يُقِيمَا حُدُودَ اللَّهِ وَتِلْكَ حُدُودُ اللَّهِ يُبَيِّنُهَا لِقَوْمٍ يَعْلَمُونَ"},"next":{"a":232,"text":"وَإِذَا طَلَّقْتُمُ النِّسَاءَ فَبَلَغْنَ أَجَلَهُنَّ فَلَا تَعْضُلُوهُنَّ أَنْ يَنْكِحْنَ أَزْوَاجَهُنَّ إِذَا تَرَاضَوْا بَيْنَهُمْ بِالْمَعْرُوفِ ذَلِكَ يُوعَظُ بِهِ مَنْ كَانَ مِنْكُمْ يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الْآخِرِ ذَلِكُمْ أَزْكَى لَكُمْ وَأَطْهَرُ وَاللَّهُ يَعْلَمُ وَأَنْتُمْ لَا تَعْلَمُونَ"},"context":"في الرجعة بعد الطلاق: و﴿وَلَا تَتَّخِذُوا آيَاتِ اللَّهِ هُزُوًا وَاذْكُرُوا نِعْمَتَ اللَّهِ عَلَيْكُمْ وَمَا أَنْزَلَ عَلَيْكُمْ مِنَ الْكِتَابِ وَالْحِكْمَةِ يَعِظُكُمْ بِهِ وَاتَّقُوا اللَّهَ وَاعْلَمُوا أَنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ﴾.","reason":"نهيٌ عن اتخاذ الأحكام هزوًا — كمن يطلّق ويراجع تلاعبًا — والعلمُ الشامل رقيبٌ على النية: يعلم من يستعمل الشرع لعبةً ومن يتقيه؛ فالتحايلُ على النص مكشوف.","adds":"من تحايل على حكمٍ شرعي بحرفيّته فقد اتخذ آيات الله هزوًا — والعليم يعرف قصده."},{"i":3,"of":20,"s":2,"surah":"البقرة","a":282,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا تَدَايَنْتُمْ بِدَيْنٍ إِلَى أَجَلٍ مُسَمًّى فَاكْتُبُوهُ وَلْيَكْتُبْ بَيْنَكُمْ كَاتِبٌ بِالْعَدْلِ وَلَا يَأْبَ كَاتِبٌ أَنْ يَكْتُبَ كَمَا عَلَّمَهُ اللَّهُ فَلْيَكْتُبْ وَلْيُمْلِلِ الَّذِي عَلَيْهِ الْحَقُّ وَلْيَتَّقِ اللَّهَ رَبَّهُ وَلَا يَبْخَسْ مِنْهُ شَيْئًا فَإِنْ كَانَ الَّذِي عَلَيْهِ الْحَقُّ سَفِيهًا أَوْ ضَعِيفًا أَوْ لَا يَسْتَطِيعُ أَنْ يُمِلَّ هُوَ فَلْيُمْلِلْ وَلِيُّهُ بِالْعَدْلِ وَاسْتَشْهِدُوا شَهِيدَيْنِ مِنْ رِجَالِكُمْ فَإِنْ لَمْ يَكُونَا رَجُلَيْنِ فَرَجُلٌ وَامْرَأَتَانِ مِمَّنْ تَرْضَوْنَ مِنَ الشُّهَدَاءِ أَنْ تَضِلَّ إِحْدَاهُمَا فَتُذَكِّرَ إِحْدَاهُمَا الْأُخْرَى وَلَا يَأْبَ الشُّهَدَاءُ إِذَا مَا دُعُوا وَلَا تَسْأَمُوا أَنْ تَكْتُبُوهُ صَغِيرًا أَوْ كَبِيرًا إِلَى أَجَلِهِ ذَلِكُمْ أَقْسَطُ عِنْدَ اللَّهِ وَأَقْوَمُ لِلشَّهَادَةِ وَأَدْنَى أَلَّا تَرْتَابُوا إِلَّا أَنْ تَكُونَ تِجَارَةً حَاضِرَةً تُدِيرُونَهَا بَيْنَكُمْ فَلَيْسَ عَلَيْكُمْ جُنَاحٌ أَلَّا تَكْتُبُوهَا وَأَشْهِدُوا إِذَا تَبَايَعْتُمْ وَلَا يُضَارَّ كَاتِبٌ وَلَا شَهِيدٌ وَإِنْ تَفْعَلُوا فَإِنَّهُ فُسُوقٌ بِكُمْ وَاتَّقُوا اللَّهَ وَيُعَلِّمُكُمُ اللَّهُ وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ","prev":{"a":281,"text":"وَاتَّقُوا يَوْمًا تُرْجَعُونَ فِيهِ إِلَى اللَّهِ ثُمَّ تُوَفَّى كُلُّ نَفْسٍ مَا كَسَبَتْ وَهُمْ لَا يُظْلَمُونَ"},"next":{"a":283,"text":"وَإِنْ كُنْتُمْ عَلَى سَفَرٍ وَلَمْ تَجِدُوا كَاتِبًا فَرِهَانٌ مَقْبُوضَةٌ فَإِنْ أَمِنَ بَعْضُكُمْ بَعْضًا فَلْيُؤَدِّ الَّذِي اؤْتُمِنَ أَمَانَتَهُ وَلْيَتَّقِ اللَّهَ رَبَّهُ وَلَا تَكْتُمُوا الشَّهَادَةَ وَمَنْ يَكْتُمْهَا فَإِنَّهُ آثِمٌ قَلْبُهُ وَاللَّهُ بِمَا تَعْمَلُونَ عَلِيمٌ"},"context":"آية الدَّين — أطول آية في القرآن: و﴿وَاتَّقُوا اللَّهَ وَيُعَلِّمُكُمُ اللَّهُ وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ﴾.","reason":"خُتمت أدقُّ آيةٍ تنظيمية — كتابةُ الدَّين والشهود والإملاء — بالعلم الشامل والتعليم: و﴿وَيُعَلِّمُكُمُ اللَّهُ﴾؛ فأنظمةُ التوثيق التي تحفظ الحقوق تعليمٌ من العليم لا اجتهادٌ بشري.","adds":"التوثيق المالي تعليمٌ إلهي: و﴿فَاكْتُبُوهُ﴾ — فلا تستهن بكتابة حقوقك وحقوق غيرك."},{"i":4,"of":20,"s":4,"surah":"النساء","a":32,"text":"وَلَا تَتَمَنَّوْا مَا فَضَّلَ اللَّهُ بِهِ بَعْضَكُمْ عَلَى بَعْضٍ لِلرِّجَالِ نَصِيبٌ مِمَّا اكْتَسَبُوا وَلِلنِّسَاءِ نَصِيبٌ مِمَّا اكْتَسَبْنَ وَاسْأَلُوا اللَّهَ مِنْ فَضْلِهِ إِنَّ اللَّهَ كَانَ بِكُلِّ شَيْءٍ عَلِيمًا","prev":{"a":31,"text":"إِنْ تَجْتَنِبُوا كَبَائِرَ مَا تُنْهَوْنَ عَنْهُ نُكَفِّرْ عَنْكُمْ سَيِّئَاتِكُمْ وَنُدْخِلْكُمْ مُدْخَلًا كَرِيمًا"},"next":{"a":33,"text":"وَلِكُلٍّ جَعَلْنَا مَوَالِيَ مِمَّا تَرَكَ الْوَالِدَانِ وَالْأَقْرَبُونَ وَالَّذِينَ عَقَدَتْ أَيْمَانُكُمْ فَآتُوهُمْ نَصِيبَهُمْ إِنَّ اللَّهَ كَانَ عَلَى كُلِّ شَيْءٍ شَهِيدًا"},"reason":"نُهي عن تمني ما فُضّل به الغير — وهو عملُ قلبٍ خفي — وفُتح البديل: و﴿وَاسْأَلُوا اللَّهَ مِنْ فَضْلِهِ﴾؛ فبدلَ الحسد سؤالُ الفضل، والعليمُ يعلم ما في القلوب من تمنٍّ وما يصلح لكلٍّ.","adds":"علاج الحسد في الآية نفسها: و﴿وَاسْأَلُوا اللَّهَ مِنْ فَضْلِهِ﴾ — اطلب لنفسك ولا تتمنَّ زوال نعمة غيرك."},{"i":5,"of":20,"s":4,"surah":"النساء","a":176,"text":"يَسْتَفْتُونَكَ قُلِ اللَّهُ يُفْتِيكُمْ فِي الْكَلَالَةِ إِنِ امْرُؤٌ هَلَكَ لَيْسَ لَهُ وَلَدٌ وَلَهُ أُخْتٌ فَلَهَا نِصْفُ مَا تَرَكَ وَهُوَ يَرِثُهَا إِنْ لَمْ يَكُنْ لَهَا وَلَدٌ فَإِنْ كَانَتَا اثْنَتَيْنِ فَلَهُمَا الثُّلُثَانِ مِمَّا تَرَكَ وَإِنْ كَانُوا إِخْوَةً رِجَالًا وَنِسَاءً فَلِلذَّكَرِ مِثْلُ حَظِّ الْأُنْثَيَيْنِ يُبَيِّنُ اللَّهُ لَكُمْ أَنْ تَضِلُّوا وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ","prev":{"a":175,"text":"فَأَمَّا الَّذِينَ آمَنُوا بِاللَّهِ وَاعْتَصَمُوا بِهِ فَسَيُدْخِلُهُمْ فِي رَحْمَةٍ مِنْهُ وَفَضْلٍ وَيَهْدِيهِمْ إِلَيْهِ صِرَاطًا مُسْتَقِيمًا"},"context":"آية الكلالة — آخر آية نزلت في الأحكام (صحيح البخاري 4364): و﴿يُبَيِّنُ اللَّهُ لَكُمْ أَنْ تَضِلُّوا وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ﴾.","reason":"بيانٌ لأدق حالات الميراث — الكلالة — لئلا تضلوا؛ والعلمُ الشامل ضمانةُ صحة القسمة: يعلم كل حالةٍ ممكنة وما يستحقه كل وارث؛ فالبيانُ صادرٌ عن استيعابٍ كامل للحالات.","adds":"لا حالةَ ميراثٍ نادرة إلا وحكمُها موجود: و﴿يُبَيِّنُ اللَّهُ لَكُمْ أَنْ تَضِلُّوا﴾.","dorar":[{"id":"TvWdGTvG","label":"صحيح البخاري 4364"},{"id":"U1zFvJcB","label":"تخريج المسند لشعيب 18638"},{"id":"XHsJBZ6E","label":"تخريج مشكل الآثار 6/ 305"}]},{"i":6,"of":20,"s":5,"surah":"المائدة","a":97,"text":"جَعَلَ اللَّهُ الْكَعْبَةَ الْبَيْتَ الْحَرَامَ قِيَامًا لِلنَّاسِ وَالشَّهْرَ الْحَرَامَ وَالْهَدْيَ وَالْقَلَائِدَ ذَلِكَ لِتَعْلَمُوا أَنَّ اللَّهَ يَعْلَمُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَأَنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ","prev":{"a":96,"text":"أُحِلَّ لَكُمْ صَيْدُ الْبَحْرِ وَطَعَامُهُ مَتَاعًا لَكُمْ وَلِلسَّيَّارَةِ وَحُرِّمَ عَلَيْكُمْ صَيْدُ الْبَرِّ مَا دُمْتُمْ حُرُمًا وَاتَّقُوا اللَّهَ الَّذِي إِلَيْهِ تُحْشَرُونَ"},"next":{"a":98,"text":"اعْلَمُوا أَنَّ اللَّهَ شَدِيدُ الْعِقَابِ وَأَنَّ اللَّهَ غَفُورٌ رَحِيمٌ"},"reason":"سُمّيت الكعبة «قيامًا للناس» — به تقوم مصالحهم الدينية والدنيوية؛ والغايةُ المعلنة: و﴿لِتَعْلَمُوا﴾ أن الله بكل شيء عليم: فنظامُ الحرمات دليلٌ على علمٍ محيط بما يقيم حياة الناس.","adds":"نظام الحرمات — مكانًا وزمانًا وهديًا — قيامٌ لحياة الناس: فمن حفظه حفظ نظام حياته."},{"i":7,"of":20,"s":6,"surah":"الأنعام","a":101,"text":"بَدِيعُ السَّمَاوَاتِ وَالْأَرْضِ أَنَّى يَكُونُ لَهُ وَلَدٌ وَلَمْ تَكُنْ لَهُ صَاحِبَةٌ وَخَلَقَ كُلَّ شَيْءٍ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ","prev":{"a":100,"text":"وَجَعَلُوا لِلَّهِ شُرَكَاءَ الْجِنَّ وَخَلَقَهُمْ وَخَرَقُوا لَهُ بَنِينَ وَبَنَاتٍ بِغَيْرِ عِلْمٍ سُبْحَانَهُ وَتَعَالَى عَمَّا يَصِفُونَ"},"next":{"a":102,"text":"ذَلِكُمُ اللَّهُ رَبُّكُمْ لَا إِلَهَ إِلَّا هُوَ خَالِقُ كُلِّ شَيْءٍ فَاعْبُدُوهُ وَهُوَ عَلَى كُلِّ شَيْءٍ وَكِيلٌ"},"reason":"برهانٌ مركّب على نفي الولد: إبداعٌ بلا مثال، وانتفاءُ صاحبة، وخلقُ كل شيء — ثم العلمُ الشامل؛ فالعلمُ بكل شيء يقطع دعوى الولد: من علم كل شيءٍ يعلم أنه لا ولد له.","adds":"احفظ البرهان الثلاثي: بديعٌ، بلا صاحبة، خالقُ كل شيء — وعليمٌ بكل شيء."},{"i":8,"of":20,"s":8,"surah":"الأنفال","a":75,"text":"وَالَّذِينَ آمَنُوا مِنْ بَعْدُ وَهَاجَرُوا وَجَاهَدُوا مَعَكُمْ فَأُولَئِكَ مِنْكُمْ وَأُولُو الْأَرْحَامِ بَعْضُهُمْ أَوْلَى بِبَعْضٍ فِي كِتَابِ اللَّهِ إِنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ","prev":{"a":74,"text":"وَالَّذِينَ آمَنُوا وَهَاجَرُوا وَجَاهَدُوا فِي سَبِيلِ اللَّهِ وَالَّذِينَ آوَوْا وَنَصَرُوا أُولَئِكَ هُمُ الْمُؤْمِنُونَ حَقًّا لَهُمْ مَغْفِرَةٌ وَرِزْقٌ كَرِيمٌ"},"context":"﴿وَالَّذِينَ آمَنُوا مِنْ بَعْدُ وَهَاجَرُوا وَجَاهَدُوا مَعَكُمْ فَأُولَئِكَ مِنْكُمْ وَأُولُو الْأَرْحَامِ بَعْضُهُمْ أَوْلَى بِبَعْضٍ فِي كِتَابِ اللَّهِ إِنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ﴾ — خاتمة الأنفال.","reason":"تعديلٌ في نظام التوارث: من الولاية بالهجرة إلى أولوية الأرحام — والعلمُ الشامل ضمانةُ صواب التعديل: يعلم مصالح الأمة في كل مرحلة؛ فتغيّرُ الأحكام بتغيّر الأحوال عن علم.","adds":"﴿وَأُولُو الْأَرْحَامِ بَعْضُهُمْ أَوْلَى بِبَعْضٍ﴾ — قاعدةُ الميراث الكبرى، صادرةٌ عن علمٍ بكل شيء."},{"i":9,"of":20,"s":9,"surah":"التوبة","a":115,"text":"وَمَا كَانَ اللَّهُ لِيُضِلَّ قَوْمًا بَعْدَ إِذْ هَدَاهُمْ حَتَّى يُبَيِّنَ لَهُمْ مَا يَتَّقُونَ إِنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ","prev":{"a":114,"text":"وَمَا كَانَ اسْتِغْفَارُ إِبْرَاهِيمَ لِأَبِيهِ إِلَّا عَنْ مَوْعِدَةٍ وَعَدَهَا إِيَّاهُ فَلَمَّا تَبَيَّنَ لَهُ أَنَّهُ عَدُوٌّ لِلَّهِ تَبَرَّأَ مِنْهُ إِنَّ إِبْرَاهِيمَ لَأَوَّاهٌ حَلِيمٌ"},"next":{"a":116,"text":"إِنَّ اللَّهَ لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ يُحْيِي وَيُمِيتُ وَمَا لَكُمْ مِنْ دُونِ اللَّهِ مِنْ وَلِيٍّ وَلَا نَصِيرٍ"},"reason":"قاعدةُ عدلٍ عظيمة: لا إضلال قبل البيان — فلا يُحاسب أحدٌ على ما لم يُبيَّن له؛ والعلمُ الشامل يعلم من بلغه البيان ومن لم يبلغه: فالحسابُ على قدر البلاغ.","adds":"أرجى قاعدةٍ لمن يخاف على نفسه: لا إضلال قبل بيان — و﴿حَتَّى يُبَيِّنَ لَهُمْ مَا يَتَّقُونَ﴾."},{"i":10,"of":20,"s":24,"surah":"النور","a":35,"text":"اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ مَثَلُ نُورِهِ كَمِشْكَاةٍ فِيهَا مِصْبَاحٌ الْمِصْبَاحُ فِي زُجَاجَةٍ الزُّجَاجَةُ كَأَنَّهَا كَوْكَبٌ دُرِّيٌّ يُوقَدُ مِنْ شَجَرَةٍ مُبَارَكَةٍ زَيْتُونَةٍ لَا شَرْقِيَّةٍ وَلَا غَرْبِيَّةٍ يَكَادُ زَيْتُهَا يُضِيءُ وَلَوْ لَمْ تَمْسَسْهُ نَارٌ نُورٌ عَلَى نُورٍ يَهْدِي اللَّهُ لِنُورِهِ مَنْ يَشَاءُ وَيَضْرِبُ اللَّهُ الْأَمْثَالَ لِلنَّاسِ وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ","prev":{"a":34,"text":"وَلَقَدْ أَنْزَلْنَا إِلَيْكُمْ آيَاتٍ مُبَيِّنَاتٍ وَمَثَلًا مِنَ الَّذِينَ خَلَوْا مِنْ قَبْلِكُمْ وَمَوْعِظَةً لِلْمُتَّقِينَ"},"next":{"a":36,"text":"فِي بُيُوتٍ أَذِنَ اللَّهُ أَنْ تُرْفَعَ وَيُذْكَرَ فِيهَا اسْمُهُ يُسَبِّحُ لَهُ فِيهَا بِالْغُدُوِّ وَالْآصَالِ"},"context":"آية النور: و﴿يَهْدِي اللَّهُ لِنُورِهِ مَنْ يَشَاءُ وَيَضْرِبُ اللَّهُ الْأَمْثَالَ لِلنَّاسِ وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ﴾.","reason":"خُتمت أعظمُ آيةٍ في وصف نور الإيمان بالعلم الشامل: فالهدايةُ إلى النور اختيارٌ عن علمٍ بمن يستحق — لا محاباة؛ وضربُ الأمثال تعليمٌ من عليم يعرف كيف تُفهم المعاني.","adds":"الأمثال في القرآن تعليمٌ من عليم: و﴿وَيَضْرِبُ اللَّهُ الْأَمْثَالَ لِلنَّاسِ﴾ — فتدبّرها ولا تتجاوزها."},{"i":11,"of":20,"s":24,"surah":"النور","a":64,"text":"أَلَا إِنَّ لِلَّهِ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ قَدْ يَعْلَمُ مَا أَنْتُمْ عَلَيْهِ وَيَوْمَ يُرْجَعُونَ إِلَيْهِ فَيُنَبِّئُهُمْ بِمَا عَمِلُوا وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ","prev":{"a":63,"text":"لَا تَجْعَلُوا دُعَاءَ الرَّسُولِ بَيْنَكُمْ كَدُعَاءِ بَعْضِكُمْ بَعْضًا قَدْ يَعْلَمُ اللَّهُ الَّذِينَ يَتَسَلَّلُونَ مِنْكُمْ لِوَاذًا فَلْيَحْذَرِ الَّذِينَ يُخَالِفُونَ عَنْ أَمْرِهِ أَنْ تُصِيبَهُمْ فِتْنَةٌ أَوْ يُصِيبَهُمْ عَذَابٌ أَلِيمٌ"},"context":"﴿أَلَا إِنَّ لِلَّهِ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ قَدْ يَعْلَمُ مَا أَنْتُمْ عَلَيْهِ وَيَوْمَ يُرْجَعُونَ إِلَيْهِ فَيُنَبِّئُهُمْ بِمَا عَمِلُوا وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ﴾ — خاتمة النور.","reason":"خُتمت سورةُ الآداب والحدود بأنه و﴿قَدْ يَعْلَمُ مَا أَنْتُمْ عَلَيْهِ﴾ — أي حالكم الآن — ثم الإنباءُ يوم الرجوع؛ فالعلمُ بالحال الآن والإنباءُ بالتفصيل غدًا: رقابةٌ حاضرة وحسابٌ آجل.","adds":"﴿قَدْ يَعْلَمُ مَا أَنْتُمْ عَلَيْهِ﴾ الآن — لا غدًا فقط: فهو يعلم حالك في هذه اللحظة."},{"i":12,"of":20,"s":29,"surah":"العنكبوت","a":62,"text":"اللَّهُ يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ مِنْ عِبَادِهِ وَيَقْدِرُ لَهُ إِنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ","prev":{"a":61,"text":"وَلَئِنْ سَأَلْتَهُمْ مَنْ خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ وَسَخَّرَ الشَّمْسَ وَالْقَمَرَ لَيَقُولُنَّ اللَّهُ فَأَنَّى يُؤْفَكُونَ"},"next":{"a":63,"text":"وَلَئِنْ سَأَلْتَهُمْ مَنْ نَزَّلَ مِنَ السَّمَاءِ مَاءً فَأَحْيَا بِهِ الْأَرْضَ مِنْ بَعْدِ مَوْتِهَا لَيَقُولُنَّ اللَّهُ قُلِ الْحَمْدُ لِلَّهِ بَلْ أَكْثَرُهُمْ لَا يَعْقِلُونَ"},"reason":"البسطُ والقدرُ في الرزق مبنيّان على علمٍ شامل: يعلم من يصلحه البسط ومن يفسده — فتفاوتُ الأرزاق قسمةُ عليمٍ لا عبثَ سوق؛ وجاءت بعد ذكر من يهاجرون في سبيل الله.","adds":"قسمةُ الرزق صادرةٌ عن علمٍ بك: فلا تقس نصيبك بنصيب غيرك."},{"i":13,"of":20,"s":33,"surah":"الأحزاب","a":40,"text":"مَا كَانَ مُحَمَّدٌ أَبَا أَحَدٍ مِنْ رِجَالِكُمْ وَلَكِنْ رَسُولَ اللَّهِ وَخَاتَمَ النَّبِيِّينَ وَكَانَ اللَّهُ بِكُلِّ شَيْءٍ عَلِيمًا","prev":{"a":39,"text":"الَّذِينَ يُبَلِّغُونَ رِسَالَاتِ اللَّهِ وَيَخْشَوْنَهُ وَلَا يَخْشَوْنَ أَحَدًا إِلَّا اللَّهَ وَكَفَى بِاللَّهِ حَسِيبًا"},"next":{"a":41,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اذْكُرُوا اللَّهَ ذِكْرًا كَثِيرًا"},"reason":"إعلانُ ختم النبوة مقرونًا بالعلم الشامل: فمن يعلم كل شيء — بما فيه مستقبلُ البشرية إلى قيام الساعة — هو الذي يقرر أن الرسالة خُتمت؛ فالختمُ قرارُ عليمٍ لا حدثٌ عارض.","adds":"ختمُ النبوة قرارٌ صادر عن علمٍ بكل ما سيحتاجه البشر إلى آخر الزمان — فلا نبيَّ بعده."},{"i":14,"of":20,"s":33,"surah":"الأحزاب","a":54,"text":"إِنْ تُبْدُوا شَيْئًا أَوْ تُخْفُوهُ فَإِنَّ اللَّهَ كَانَ بِكُلِّ شَيْءٍ عَلِيمًا","prev":{"a":53,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَدْخُلُوا بُيُوتَ النَّبِيِّ إِلَّا أَنْ يُؤْذَنَ لَكُمْ إِلَى طَعَامٍ غَيْرَ نَاظِرِينَ إِنَاهُ وَلَكِنْ إِذَا دُعِيتُمْ فَادْخُلُوا فَإِذَا طَعِمْتُمْ فَانْتَشِرُوا وَلَا مُسْتَأْنِسِينَ لِحَدِيثٍ إِنَّ ذَلِكُمْ كَانَ يُؤْذِي النَّبِيَّ فَيَسْتَحْيِي مِنْكُمْ وَاللَّهُ لَا يَسْتَحْيِي مِنَ الْحَقِّ وَإِذَا سَأَلْتُمُوهُنَّ مَتَاعًا فَاسْأَلُوهُنَّ مِنْ وَرَاءِ حِجَابٍ ذَلِكُمْ أَطْهَرُ لِقُلُوبِكُمْ وَقُلُوبِهِنَّ وَمَا كَانَ لَكُمْ أَنْ تُؤْذُوا رَسُولَ اللَّهِ وَلَا أَنْ تَنْكِحُوا أَزْوَاجَهُ مِنْ بَعْدِهِ أَبَدًا إِنَّ ذَلِكُمْ كَانَ عِنْدَ اللَّهِ عَظِيمًا"},"next":{"a":55,"text":"لَا جُنَاحَ عَلَيْهِنَّ فِي آبَائِهِنَّ وَلَا أَبْنَائِهِنَّ وَلَا إِخْوَانِهِنَّ وَلَا أَبْنَاءِ إِخْوَانِهِنَّ وَلَا أَبْنَاءِ أَخَوَاتِهِنَّ وَلَا نِسَائِهِنَّ وَلَا مَا مَلَكَتْ أَيْمَانُهُنَّ وَاتَّقِينَ اللَّهَ إِنَّ اللَّهَ كَانَ عَلَى كُلِّ شَيْءٍ شَهِيدًا"},"context":"﴿إِنْ تُبْدُوا شَيْئًا أَوْ تُخْفُوهُ فَإِنَّ اللَّهَ كَانَ بِكُلِّ شَيْءٍ عَلِيمًا﴾ — في آداب بيت النبوة.","reason":"جاءت في سياق آداب دقيقة داخل البيوت: فالإبداءُ والإخفاء سواء عنده — والعلمُ الشامل يجعل أدب الخلوة كأدب العلن؛ فلا فرق بين ما تفعله أمام الناس وما تفعله وحدك.","adds":"معيارٌ واحد لسلوكك في العلن والخلوة: و﴿فَإِنَّ اللَّهَ كَانَ بِكُلِّ شَيْءٍ عَلِيمًا﴾."},{"i":15,"of":20,"s":42,"surah":"الشورى","a":12,"text":"لَهُ مَقَالِيدُ السَّمَاوَاتِ وَالْأَرْضِ يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ وَيَقْدِرُ إِنَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ","prev":{"a":11,"text":"فَاطِرُ السَّمَاوَاتِ وَالْأَرْضِ جَعَلَ لَكُمْ مِنْ أَنْفُسِكُمْ أَزْوَاجًا وَمِنَ الْأَنْعَامِ أَزْوَاجًا يَذْرَؤُكُمْ فِيهِ لَيْسَ كَمِثْلِهِ شَيْءٌ وَهُوَ السَّمِيعُ الْبَصِيرُ"},"next":{"a":13,"text":"شَرَعَ لَكُمْ مِنَ الدِّينِ مَا وَصَّى بِهِ نُوحًا وَالَّذِي أَوْحَيْنَا إِلَيْكَ وَمَا وَصَّيْنَا بِهِ إِبْرَاهِيمَ وَمُوسَى وَعِيسَى أَنْ أَقِيمُوا الدِّينَ وَلَا تَتَفَرَّقُوا فِيهِ كَبُرَ عَلَى الْمُشْرِكِينَ مَا تَدْعُوهُمْ إِلَيْهِ اللَّهُ يَجْتَبِي إِلَيْهِ مَنْ يَشَاءُ وَيَهْدِي إِلَيْهِ مَنْ يُنِيبُ"},"reason":"جُمعت المقاليد — المفاتيح — بتوزيع الرزق: فمن بيده المفاتيح يفتح ويقدر بعلم؛ ولا يُفتح بابٌ إلا بمفتاحه، ولا يُقدَّر رزقٌ إلا بعلمٍ بصاحبه.","adds":"المفاتيح كلها عنده: فاطلب من صاحب المفاتيح ولا تطرق الأبواب المغلقة."},{"i":16,"of":20,"s":48,"surah":"الفتح","a":26,"text":"إِذْ جَعَلَ الَّذِينَ كَفَرُوا فِي قُلُوبِهِمُ الْحَمِيَّةَ حَمِيَّةَ الْجَاهِلِيَّةِ فَأَنْزَلَ اللَّهُ سَكِينَتَهُ عَلَى رَسُولِهِ وَعَلَى الْمُؤْمِنِينَ وَأَلْزَمَهُمْ كَلِمَةَ التَّقْوَى وَكَانُوا أَحَقَّ بِهَا وَأَهْلَهَا وَكَانَ اللَّهُ بِكُلِّ شَيْءٍ عَلِيمًا","prev":{"a":25,"text":"هُمُ الَّذِينَ كَفَرُوا وَصَدُّوكُمْ عَنِ الْمَسْجِدِ الْحَرَامِ وَالْهَدْيَ مَعْكُوفًا أَنْ يَبْلُغَ مَحِلَّهُ وَلَوْلَا رِجَالٌ مُؤْمِنُونَ وَنِسَاءٌ مُؤْمِنَاتٌ لَمْ تَعْلَمُوهُمْ أَنْ تَطَئُوهُمْ فَتُصِيبَكُمْ مِنْهُمْ مَعَرَّةٌ بِغَيْرِ عِلْمٍ لِيُدْخِلَ اللَّهُ فِي رَحْمَتِهِ مَنْ يَشَاءُ لَوْ تَزَيَّلُوا لَعَذَّبْنَا الَّذِينَ كَفَرُوا مِنْهُمْ عَذَابًا أَلِيمًا"},"next":{"a":27,"text":"لَقَدْ صَدَقَ اللَّهُ رَسُولَهُ الرُّؤْيَا بِالْحَقِّ لَتَدْخُلُنَّ الْمَسْجِدَ الْحَرَامَ إِنْ شَاءَ اللَّهُ آمِنِينَ مُحَلِّقِينَ رُءُوسَكُمْ وَمُقَصِّرِينَ لَا تَخَافُونَ فَعَلِمَ مَا لَمْ تَعْلَمُوا فَجَعَلَ مِنْ دُونِ ذَلِكَ فَتْحًا قَرِيبًا"},"reason":"مقابلةٌ بين حميّة الجاهلية في قلوب الكفار وسكينةٍ أُنزلت على قلوب المؤمنين — والعلمُ الشامل يعلم ما في القلبين؛ فالسكينةُ تُنزل على من يعلم أنه أهلٌ لها: و﴿وَكَانُوا أَحَقَّ بِهَا وَأَهْلَهَا﴾.","adds":"في لحظة الاستفزاز: إما حميّةُ جاهلية أو سكينةٌ منزلة — والعليم يعرف من يستحق أيَّهما."},{"i":17,"of":20,"s":49,"surah":"الحجرات","a":16,"text":"قُلْ أَتُعَلِّمُونَ اللَّهَ بِدِينِكُمْ وَاللَّهُ يَعْلَمُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ","prev":{"a":15,"text":"إِنَّمَا الْمُؤْمِنُونَ الَّذِينَ آمَنُوا بِاللَّهِ وَرَسُولِهِ ثُمَّ لَمْ يَرْتَابُوا وَجَاهَدُوا بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ فِي سَبِيلِ اللَّهِ أُولَئِكَ هُمُ الصَّادِقُونَ"},"next":{"a":17,"text":"يَمُنُّونَ عَلَيْكَ أَنْ أَسْلَمُوا قُلْ لَا تَمُنُّوا عَلَيَّ إِسْلَامَكُمْ بَلِ اللَّهُ يَمُنُّ عَلَيْكُمْ أَنْ هَدَاكُمْ لِلْإِيمَانِ إِنْ كُنْتُمْ صَادِقِينَ"},"reason":"سخريةٌ لطيفة من المانّين بإسلامهم: و﴿أَتُعَلِّمُونَ اللَّهَ بِدِينِكُمْ﴾ — أتُخبرونه بما لا يعلم؟ فالمنُّ بالتدين جهلٌ بمن يُمَنّ عليه؛ والعلمُ الشامل يفضح حقيقة الإيمان المدَّعى.","adds":"من منّ على الله بتدينه فقد ظنّ أنه يعلّمه ما لا يعلم — فأيُّ جهلٍ أعظم؟"},{"i":18,"of":20,"s":57,"surah":"الحديد","a":3,"text":"هُوَ الْأَوَّلُ وَالْآخِرُ وَالظَّاهِرُ وَالْبَاطِنُ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ","prev":{"a":2,"text":"لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ يُحْيِي وَيُمِيتُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},"next":{"a":4,"text":"هُوَ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ فِي سِتَّةِ أَيَّامٍ ثُمَّ اسْتَوَى عَلَى الْعَرْشِ يَعْلَمُ مَا يَلِجُ فِي الْأَرْضِ وَمَا يَخْرُجُ مِنْهَا وَمَا يَنْزِلُ مِنَ السَّمَاءِ وَمَا يَعْرُجُ فِيهَا وَهُوَ مَعَكُمْ أَيْنَ مَا كُنْتُمْ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ"},"reason":"خُتمت أسماء الإحاطة الأربعة بالعلم الشامل: فبعد إحاطة الزمان (الأول والآخر) وإحاطة المكان (الظاهر والباطن) جاء العلمُ يملأ ما أحاطت به الأسماء — إحاطةٌ لا فراغَ فيها.","adds":"إحاطةٌ زمانية ومكانية ومعرفية: فأين تذهب من عليمٍ بكل شيء أحاط بكل جهة؟"},{"i":19,"of":20,"s":58,"surah":"المجادلة","a":7,"text":"أَلَمْ تَرَ أَنَّ اللَّهَ يَعْلَمُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ مَا يَكُونُ مِنْ نَجْوَى ثَلَاثَةٍ إِلَّا هُوَ رَابِعُهُمْ وَلَا خَمْسَةٍ إِلَّا هُوَ سَادِسُهُمْ وَلَا أَدْنَى مِنْ ذَلِكَ وَلَا أَكْثَرَ إِلَّا هُوَ مَعَهُمْ أَيْنَ مَا كَانُوا ثُمَّ يُنَبِّئُهُمْ بِمَا عَمِلُوا يَوْمَ الْقِيَامَةِ إِنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ","prev":{"a":6,"text":"يَوْمَ يَبْعَثُهُمُ اللَّهُ جَمِيعًا فَيُنَبِّئُهُمْ بِمَا عَمِلُوا أَحْصَاهُ اللَّهُ وَنَسُوهُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ شَهِيدٌ"},"next":{"a":8,"text":"أَلَمْ تَرَ إِلَى الَّذِينَ نُهُوا عَنِ النَّجْوَى ثُمَّ يَعُودُونَ لِمَا نُهُوا عَنْهُ وَيَتَنَاجَوْنَ بِالْإِثْمِ وَالْعُدْوَانِ وَمَعْصِيَتِ الرَّسُولِ وَإِذَا جَاءُوكَ حَيَّوْكَ بِمَا لَمْ يُحَيِّكَ بِهِ اللَّهُ وَيَقُولُونَ فِي أَنْفُسِهِمْ لَوْلَا يُعَذِّبُنَا اللَّهُ بِمَا نَقُولُ حَسْبُهُمْ جَهَنَّمُ يَصْلَوْنَهَا فَبِئْسَ الْمَصِيرُ"},"reason":"إحصاءٌ عددي مذهل: ثلاثةٌ فرابعُهم، وخمسةٌ فسادسُهم، وأدنى وأكثر — تفصيلٌ يقصد إشعارك أن كل مجلسٍ سري له حاضرٌ رابع أو سادس؛ فالنجوى مستحيلةٌ عمليًّا.","adds":"لا يوجد مجلسٌ سري في الوجود: أيُّ اجتماعٍ تعقده فأنتم عددكم زائدٌ واحد."},{"i":20,"of":20,"s":64,"surah":"التغابن","a":11,"text":"مَا أَصَابَ مِنْ مُصِيبَةٍ إِلَّا بِإِذْنِ اللَّهِ وَمَنْ يُؤْمِنْ بِاللَّهِ يَهْدِ قَلْبَهُ وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ","prev":{"a":10,"text":"وَالَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا أُولَئِكَ أَصْحَابُ النَّارِ خَالِدِينَ فِيهَا وَبِئْسَ الْمَصِيرُ"},"next":{"a":12,"text":"وَأَطِيعُوا اللَّهَ وَأَطِيعُوا الرَّسُولَ فَإِنْ تَوَلَّيْتُمْ فَإِنَّمَا عَلَى رَسُولِنَا الْبَلَاغُ الْمُبِينُ"},"reason":"وعدٌ لافت: الإيمان يورث هدايةَ القلب عند المصيبة — و﴿يَهْدِ قَلْبَهُ﴾: أي يُثبته ويُسدده حال البلاء؛ والعلمُ الشامل ضمانةُ أن المصيبة بإذنٍ عن علم لا اعتباط.","adds":"عند المصيبة تُختبر هدايةُ قلبك: و﴿وَمَنْ يُؤْمِنْ بِاللَّهِ يَهْدِ قَلْبَهُ﴾ — فاسأل هداية القلب لا رفع البلاء فقط."}],"hadiths":[{"i":1,"of":1,"text":"سَألْتُ ابنَ عبَّاسٍ فقُلْتُ: «ما شيءٌ أجِدُه في صَدْري؟ قالَ: ما هو؟ قُلْتُ: واللهِ لا أتَكلَّمُ به، قالَ: فقالَ لي: أشيءٌ مِن شَكٍّ؟ قالَ: وضَحِكَ، قالَ: ما نَجا مِن ذلك أحَدٌ، قالَ: حتَّى أَنزَلَ اللهُ عَزَّ وجَلَّ: {فَإِنْ كُنْتَ فِي شَكٍّ مِمَّا أَنْزَلْنَا إِلَيْكَ فَاسْأَلِ الَّذِينَ يَقْرَءُونَ الكِتَابَ مِنْ قَبْلِكَ} الآية، قالَ: فقالَ لي: إذا وَجَدْتَ في نَفْسِك شَيئًا فقُلْ: {هُوَ الْأَوَّلُ وَالْآخِرُ وَالظَّاهِرُ والْبَاطِنُ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ}».","narrator":"أبو زميل","source":"الأحاديث المختارة 10 / 419","grade":"صحيح","judgment":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","url":"https://dorar.net/h/dGOesAzJ","nameForm":"بِكُلِّ شَيْءٍ عَلِيمٌ","scene":"أبو زميل: سألت ابن عباس عن شيء أجده في صدري ولا أتكلم به، فضحك وقال: ما نجا من ذلك أحد… «فإذا وجدت في نفسك شيئًا فقل: ﴿هُوَ الْأَوَّلُ وَالْآخِرُ وَالظَّاهِرُ وَالْبَاطِنُ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ﴾».","reason":"الآية تُختم بالاسم بعد الأربعة: علمٌ بكل شيء يستوعب الشك نفسه — فمن قاله علم أن ما في صدره معلوم فلا يخاف منه.","adds":"يجعل الاسم خاتمة رقية الشك."}],"sunnah":{"card":"الصيغة: بِكُلِّ شَيْءٍ عَلِيمٌ — مركّبة\nفي السنة: شاهد واحد (رواية واحدة)\nخصوصية الورود في السنة: في وصية ابن عباس لمن وجد شكًّا: «فإذا وجدت في نفسك شيئًا فقل: ﴿هُوَ الْأَوَّلُ وَالْآخِرُ وَالظَّاهِرُ وَالْبَاطِنُ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ﴾».","teaches":"1. أن ما في صدرك من شك معلوم عنده، فلا تُحرج منه.","whenRecall":"- عند الشك.","whenPray":"عند الشعور بـ:\n1. شكٍّ لا تتكلم به.\nعند طلب:\n1. طرد الشك.\nعند الرغبة في:\n1. قراءة آية الحديد.","duaItems":"﴿هُوَ الْأَوَّلُ وَالْآخِرُ وَالظَّاهِرُ وَالْبَاطِنُ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ﴾ [الحديد: 3] عند الشك — الأحاديث المختارة 10/419.","summary":"«بكل شيء عليم» في السنة خاتمة رقية الشك عند ابن عباس."},"situations":[{"situationId":8,"verses":[{"i":20,"strength":"direct","headline":"مصيبةٌ لا تفهم حكمتها وتخاف على قلبك","bridge":"نزلت بك مصيبة لا تفهمها وتخاف على قلبك؟ ﴿مَا أَصَابَ مِنْ مُصِيبَةٍ إِلَّا بِإِذْنِ اللَّهِ وَمَنْ يُؤْمِنْ بِاللَّهِ يَهْدِ قَلْبَهُ وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ﴾ — المصيبة بإذنٍ عن علم لا عن عشوائية، والوعد أن الإيمان يهدي القلب عند البلاء؛ فاسأل هداية القلب لا تفسير المصيبة، فعند المصيبة تُختبر هداية قلبك."}],"hadiths":[]},{"situationId":26,"verses":[{"i":9,"strength":"direct","headline":"وسوسة الخوف من المؤاخذة بما لم تعلمه","bridge":"تخاف أن تُحاسب على ما لم يُبيَّن لك؟ أرجى قاعدةٍ لمن يخاف على نفسه: ﴿وَمَا كَانَ اللَّهُ لِيُضِلَّ قَوْمًا بَعْدَ إِذْ هَدَاهُمْ حَتَّى يُبَيِّنَ لَهُمْ مَا يَتَّقُونَ إِنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ﴾ — لا إضلال قبل بيان، والعليم يعلم من بلغه البيان ومن لم يبلغه؛ فالحساب على قدر البلاغ، وهذا يقطع وسوسة الخوف مما لم تعلمه."}],"hadiths":[]},{"situationId":39,"verses":[{"i":15,"strength":"direct","headline":"ضيق الرزق وانغلاق الأبواب في وجهك","bridge":"تطرق أبوابًا مغلقة لرزقك؟ المفاتيح كلها عنده: ﴿لَهُ مَقَالِيدُ السَّمَاوَاتِ وَالْأَرْضِ يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ وَيَقْدِرُ إِنَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ﴾ — لا يُفتح باب إلا بمفتاحه ولا يُقدَّر رزقٌ إلا بعلمٍ بصاحبه؛ فاطلب من صاحب المفاتيح ولا تطرق الأبواب المغلقة."}],"hadiths":[]},{"situationId":47,"verses":[{"i":3,"strength":"direct","headline":"إبرام عقدٍ أو دينٍ والتهاون في توثيقه","bridge":"توقّع عقدًا أو تُداين؟ أطول آية في القرآن كلها في توثيق الدَّين: ﴿إِذَا تَدَايَنْتُمْ بِدَيْنٍ إِلَى أَجَلٍ مُسَمًّى فَاكْتُبُوهُ... وَاتَّقُوا اللَّهَ وَيُعَلِّمُكُمُ اللَّهُ وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ﴾ — التوثيق تعليمٌ إلهي لا اجتهاد بشري؛ فلا تستهن بكتابة حقوقك وحقوق غيرك."}],"hadiths":[]},{"situationId":49,"verses":[{"i":2,"strength":"direct","headline":"التحايل على أحكام الشرع لإيذاء الطرف الآخر","bridge":"تطلّق وتراجع تلاعبًا أو تمسك إضرارًا؟ ﴿وَلَا تُمْسِكُوهُنَّ ضِرَارًا لِتَعْتَدُوا... وَلَا تَتَّخِذُوا آيَاتِ اللَّهِ هُزُوًا... وَاعْلَمُوا أَنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ﴾ — من تحايل على حكمٍ شرعي بحرفيته فقد اتخذ آيات الله هزوًا، والعليم يعرف قصده؛ فإمساكٌ بمعروف أو تسريحٌ بإحسان، لا ثالث."}],"hadiths":[]},{"situationId":54,"verses":[{"i":5,"strength":"direct","headline":"حالة ميراثٍ نادرة لا تجد لها حكمًا","bridge":"واجهت حالة ميراثٍ نادرة لا تجد لها حكمًا؟ ﴿يَسْتَفْتُونَكَ قُلِ اللَّهُ يُفْتِيكُمْ فِي الْكَلَالَةِ... يُبَيِّنُ اللَّهُ لَكُمْ أَنْ تَضِلُّوا وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ﴾ — بيانٌ لأدق الحالات لئلا تضلوا، صادرٌ عن استيعابٍ لكل حالةٍ ممكنة؛ فلا حالة ميراثٍ نادرة إلا وحكمها موجود عند العليم."},{"i":8,"strength":"direct","headline":"قسمة الميراث وأولوية الأرحام فيه","bridge":"تريد قاعدة الميراث الكبرى؟ ﴿وَأُولُو الْأَرْحَامِ بَعْضُهُمْ أَوْلَى بِبَعْضٍ فِي كِتَابِ اللَّهِ إِنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ﴾ — انتقل نظام التوارث من الولاية بالهجرة إلى أولوية الأرحام بعلمٍ بمصالح الأمة في كل مرحلة؛ فالقاعدة صادرةٌ عن علمٍ بكل شيء لا عن عرفٍ متغير."}],"hadiths":[]},{"situationId":56,"verses":[{"i":16,"strength":"direct","headline":"استفزاز الناس لك وثوران الحميّة في صدرك","bridge":"استُفزّت فثارت فيك حمية؟ في الحديبية: ﴿إِذْ جَعَلَ الَّذِينَ كَفَرُوا فِي قُلُوبِهِمُ الْحَمِيَّةَ حَمِيَّةَ الْجَاهِلِيَّةِ فَأَنْزَلَ اللَّهُ سَكِينَتَهُ عَلَى رَسُولِهِ وَعَلَى الْمُؤْمِنِينَ... وَكَانَ اللَّهُ بِكُلِّ شَيْءٍ عَلِيمًا﴾ — في لحظة الاستفزاز إما حمية جاهلية أو سكينة منزلة؛ فاحتمل الناس بالسكينة، والعليم يعرف من يستحق أيهما."}],"hadiths":[]},{"situationId":73,"verses":[{"i":11,"strength":"direct","headline":"الخلوة بالنفس بعيدًا عن أعين الناس","bridge":"أنت وحدك الآن؟ خُتمت سورة الحدود والآداب بـ﴿قَدْ يَعْلَمُ مَا أَنْتُمْ عَلَيْهِ﴾ — يعلم حالك الآن لا غدًا فقط — ﴿وَيَوْمَ يُرْجَعُونَ إِلَيْهِ فَيُنَبِّئُهُمْ بِمَا عَمِلُوا وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ﴾؛ رقابةٌ حاضرة في هذه اللحظة وحسابٌ آجل."},{"i":14,"strength":"direct","headline":"اختلاف سلوكك في الخلوة عنه في العلن","bridge":"تفعل في خلوتك ما لا تفعله في العلن؟ ﴿إِنْ تُبْدُوا شَيْئًا أَوْ تُخْفُوهُ فَإِنَّ اللَّهَ كَانَ بِكُلِّ شَيْءٍ عَلِيمًا﴾ — الإبداء والإخفاء سواء عنده؛ فمعيارٌ واحد لسلوكك في العلن والخلوة، ومن استوى عنده الحالان فقد عرف العليم."},{"i":18,"strength":"direct","headline":"الخلوة بالمعصية ظنًّا أنها خارج علم الله","bridge":"تظن أن خلوتك خارج الإحاطة؟ ﴿هُوَ الْأَوَّلُ وَالْآخِرُ وَالظَّاهِرُ وَالْبَاطِنُ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ﴾ — إحاطةٌ زمانية ومكانية ثم علمٌ يملأ ما أحاطت به الأسماء؛ فأين تذهب بخلوتك من عليمٍ أحاط بكل جهة؟"},{"i":19,"strength":"direct","headline":"مجلسٌ سريٌّ تظنه بعيدًا عن كل رقيب","bridge":"تجتمع بمن تثق بهم في مجلسٍ سري؟ ﴿مَا يَكُونُ مِنْ نَجْوَى ثَلَاثَةٍ إِلَّا هُوَ رَابِعُهُمْ وَلَا خَمْسَةٍ إِلَّا هُوَ سَادِسُهُمْ وَلَا أَدْنَى مِنْ ذَلِكَ وَلَا أَكْثَرَ إِلَّا هُوَ مَعَهُمْ أَيْنَ مَا كَانُوا﴾ — لا يوجد مجلسٌ سري في الوجود؛ أيُّ اجتماعٍ تعقده فأنتم عددكم زائدٌ واحد."}],"hadiths":[]},{"situationId":82,"verses":[{"i":17,"strength":"direct","headline":"المنّ على الله بالتديّن والطاعة","bridge":"تمنّ على الله أو على الناس بتدينك؟ ﴿قُلْ أَتُعَلِّمُونَ اللَّهَ بِدِينِكُمْ وَاللَّهُ يَعْلَمُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ﴾ — سخرية لطيفة: أتخبرونه بما لا يعلم؟ فمن منّ بتدينه فقد ظن أنه يعلّم العليم، وأي جهلٍ أعظم؟"}],"hadiths":[]},{"situationId":84,"verses":[{"i":4,"strength":"direct","headline":"ضيق الصدر بنعمةٍ عند غيرك وحسده عليها","bridge":"يضيق صدرك بنعمةٍ عند غيرك؟ الآية شخّصت الداء وأعطت الدواء في سطر: ﴿وَلَا تَتَمَنَّوْا مَا فَضَّلَ اللَّهُ بِهِ بَعْضَكُمْ عَلَى بَعْضٍ... وَاسْأَلُوا اللَّهَ مِنْ فَضْلِهِ إِنَّ اللَّهَ كَانَ بِكُلِّ شَيْءٍ عَلِيمًا﴾ — بدل الحسد سؤال الفضل: اطلب لنفسك ولا تتمنَّ زوال نعمة غيرك، والعليم يعلم ما يصلح لكلٍّ."},{"i":12,"strength":"direct","headline":"مقارنة رزقك برزق غيرك والتحسر على التفاوت","bridge":"تقارن رزقك برزق غيرك؟ ﴿اللَّهُ يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ مِنْ عِبَادِهِ وَيَقْدِرُ لَهُ إِنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ﴾ — البسط والقدر مبنيان على علمٍ شامل بمن يصلحه البسط ومن يفسده؛ فتفاوت الأرزاق قسمة عليمٍ لا عبث سوق، ولا تقس نصيبك بنصيب غيرك."}],"hadiths":[]},{"situationId":104,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"خواطر الشك الخفية والحرج من البوح بها","bridge":"شكٌّ لا تستطيع التكلم به؟ ابن عباس: «ما نجا من ذلك أحد… فقل: هو الأول والآخر والظاهر والباطن وهو بكل شيء عليم» — ما تخفيه معلوم فلا تُحرج منه."}]},{"situationId":106,"verses":[{"i":7,"strength":"direct","headline":"محاورة من يدّعي لله ولدًا","bridge":"تريد برهانًا ثلاثيًّا على نفي الولد؟ ﴿بَدِيعُ السَّمَاوَاتِ وَالْأَرْضِ أَنَّى يَكُونُ لَهُ وَلَدٌ وَلَمْ تَكُنْ لَهُ صَاحِبَةٌ وَخَلَقَ كُلَّ شَيْءٍ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ﴾ — بديعٌ لا يلد المبدع، بلا صاحبة فلا سبيل للولد، خالق كل شيء فالمدّعى ولدًا مخلوقٌ له؛ والعلم بكل شيء يقطع الدعوى، فاحفظه لتحاور به."}],"hadiths":[]},{"situationId":107,"verses":[{"i":13,"strength":"direct","headline":"شبهة استئناف النبوة بعد خاتم النبيين","bridge":"يُقال لك إن النبوة قد تُستأنف؟ إعلان الختم مقرون بالعلم الشامل: ﴿وَلَكِنْ رَسُولَ اللَّهِ وَخَاتَمَ النَّبِيِّينَ وَكَانَ اللَّهُ بِكُلِّ شَيْءٍ عَلِيمًا﴾ — من يعلم كل شيء بما فيه مستقبل البشرية إلى قيام الساعة هو الذي قرر أن الرسالة خُتمت؛ فالختم قرار عليمٍ بكل ما سيحتاجه البشر، فلا نبي بعده."}],"hadiths":[]},{"situationId":145,"verses":[{"i":1,"strength":"direct","headline":"استعمال ما سُخّر لك في الأرض بلا شكر","bridge":"تستعمل ما سُخّر لك بلا شكر؟ ﴿هُوَ الَّذِي خَلَقَ لَكُمْ مَا فِي الْأَرْضِ جَمِيعًا... وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ﴾ — تسخيرٌ معلن لك على علمٍ بحاجتك لا اعتباطًا؛ فكل ما في الأرض مسخّر لك، فاستعمله في طاعةٍ لا في معصية، فذاك شكره."}],"hadiths":[]},{"situationId":166,"verses":[{"i":6,"strength":"direct","headline":"حضور الحج وطلب فهم حكمة الحرمات","bridge":"تحضر الحج وتريد أن تفهم لِمَ الحرمات؟ ﴿جَعَلَ اللَّهُ الْكَعْبَةَ الْبَيْتَ الْحَرَامَ قِيَامًا لِلنَّاسِ وَالشَّهْرَ الْحَرَامَ وَالْهَدْيَ وَالْقَلَائِدَ ذَلِكَ لِتَعْلَمُوا أَنَّ اللَّهَ يَعْلَمُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ﴾ — الكعبة قيامٌ للناس به تقوم مصالحهم؛ فنظام الحرمات مكانًا وزمانًا وهديًا قيامٌ لحياة الناس، ومن حفظه حفظ نظام حياته."}],"hadiths":[]},{"situationId":191,"verses":[{"i":10,"strength":"direct","headline":"المرور على أمثال القرآن دون تدبّرها","bridge":"تقرأ أمثال القرآن وتمرّ عليها؟ خُتمت آية النور: ﴿وَيَضْرِبُ اللَّهُ الْأَمْثَالَ لِلنَّاسِ وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ﴾ — ضرب الأمثال تعليمٌ من عليمٍ يعرف كيف تُقرَّب المعاني إلى القلوب؛ فتدبّر المثل ولا تتجاوزه، فمن بكل شيءٍ عليم اختار هذه الصورة لك بعينها."}],"hadiths":[]}]},{"id":162,"name":"الله الواحد القهار رب السماوات والأرض وما بينهما العزيز الغفار","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: اللَّهُ الْوَاحِدُ الْقَهَّارُ * رَبُّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا الْعَزِيزُ الْغَفَّارُ — نسق متتابع | المواضع: 2 (ص: 65-66)\nخصوصية: النسقُ الكامل الذي ورد في ذكر التعار من الليل — فهو أشهرُ نسقٍ اسميٍّ في أذكار الليل.\n\nالمعنى: يجمع الوحدانية والقهر والربوبية الشاملة والعزة والمغفرة المتكررة في نَفَسٍ واحد.","teaches":"الحقائق التي كشفها الموضعان:\n1. المبلّغ منذرٌ لا مؤلَّه — والإله واحدٌ قهار.\n2. القهر والمغفرة في نَفَسٍ واحد: رهبةٌ ورجاء.\n3. النسق كله ذكرٌ مأثور لمن استيقظ من الليل.","whenRecall":"لحظات الاستحضار — مشتقة من موضعيه:\n- عند التعار من الليل.\n- عند الغلو في شخصٍ أو داعية.","whenPray":"بنود الدعاء — مشتقة من سياق الموضعين:\n1. ذكر التعار من الليل بالنسق الكامل — النسائي، صحيح.\n2. سؤال المغفرة عقب استحضار القهر.\n3. ضبط الولاء: تبجيل المبلّغين بلا تأليه.","summary":"إذا استيقظتَ من الليل فقل ما كان يقوله نبيك: «لا إله إلا الله الواحد القهار رب السماوات والأرض وما بينهما العزيز الغفار» — قهرٌ يوقظ ومغفرةٌ تُرجّي.","verses":[{"i":1,"of":1,"s":38,"surah":"ص","a":65,"last":66,"text":"قُلْ إِنَّمَا أَنَا مُنْذِرٌ وَمَا مِنْ إِلَهٍ إِلَّا اللَّهُ الْوَاحِدُ الْقَهَّارُ رَبُّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا الْعَزِيزُ الْغَفَّارُ","prev":{"a":64,"text":"إِنَّ ذَلِكَ لَحَقٌّ تَخَاصُمُ أَهْلِ النَّارِ"},"next":{"a":67,"text":"قُلْ هُوَ نَبَأٌ عَظِيمٌ"},"reason":"حصران متتاليان: وظيفةُ النبي إنذارٌ فحسب، والألوهيةُ للواحد القهار فحسب — فقُطعت الوسائط من الجهتين: لا مبلّغٌ يُؤلَّه، ولا إلهٌ يُشارَك.","adds":"اضبط علاقتك بالدعاة والعلماء على هذه الآية: ﴿إِنَّمَا أَنَا مُنْذِرٌ﴾ — تبجيلٌ بلا تأليه.","dorar":[{"id":"j3oHzErV","label":"السلسلة الصحيحة 2066"}]}],"hadiths":[],"situations":[{"situationId":96,"verses":[{"i":1,"strength":"direct","headline":"الغلوّ في داعيةٍ أو وسيطٍ حتى يكاد يُؤلَّه","bridge":"تعلّق قلبك بوسيطٍ أو داعية حتى كاد يُؤلَّه؟ حصران متتاليان: ﴿قُلْ إِنَّمَا أَنَا مُنْذِرٌ وَمَا مِنْ إِلَهٍ إِلَّا اللَّهُ الْوَاحِدُ الْقَهَّارُ﴾ — لا مبلّغٌ يُؤلَّه ولا إلهٌ يُشارَك؛ فاضبط علاقتك بالدعاة والعلماء على هذه الآية: تبجيلٌ بلا تأليه."}],"hadiths":[]}]},{"id":163,"name":"العلي الحكيم","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: عَلِيٌّ حَكِيمٌ — مركّبة | المواضع: 1 (الشورى: 51)\nخصوصية: جاء في بيان طرق تكليم الله للبشر — أدقّ آيةٍ في كيفية الوحي.\n\nالمعنى:\n- العلي: العالي فوق خلقه.\n- الحكيم: الذي يضع كل شيءٍ موضعه.","teaches":"الحقائق التي كشفها الموضع:\n1. طرق التكليم ثلاث محصورة — فكل دعوى خارجها باطلة.\n2. الحجاب مقتضى العلو لا الحرمان.\n3. الوحي بإذنه وبمشيئته: ﴿فَيُوحِيَ بِإِذْنِهِ مَا يَشَاءُ﴾.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند سماع دعاوى الإلهام والمكاشفة.\n- عند التفكر في كيفية نزول الوحي.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. سؤال الرؤيا الصالحة — فهي الباقية من المبشرات.\n2. الاستعاذة من الاغترار بالخواطر ونسبتها إلى الوحي.\n3. تعظيم الوحي المنزل والاكتفاء به.","summary":"﴿وَمَا كَانَ لِبَشَرٍ أَنْ يُكَلِّمَهُ اللَّهُ إِلَّا وَحْيًا أَوْ مِنْ وَرَاءِ حِجَابٍ أَوْ يُرْسِلَ رَسُولًا﴾ — ثلاثُ طرقٍ محصورة عن عليٍّ حكيم: فاحذر كل دعوى خارجها.","verses":[{"i":1,"of":1,"s":42,"surah":"الشورى","a":51,"text":"وَمَا كَانَ لِبَشَرٍ أَنْ يُكَلِّمَهُ اللَّهُ إِلَّا وَحْيًا أَوْ مِنْ وَرَاءِ حِجَابٍ أَوْ يُرْسِلَ رَسُولًا فَيُوحِيَ بِإِذْنِهِ مَا يَشَاءُ إِنَّهُ عَلِيٌّ حَكِيمٌ","prev":{"a":50,"text":"أَوْ يُزَوِّجُهُمْ ذُكْرَانًا وَإِنَاثًا وَيَجْعَلُ مَنْ يَشَاءُ عَقِيمًا إِنَّهُ عَلِيمٌ قَدِيرٌ"},"next":{"a":52,"text":"وَكَذَلِكَ أَوْحَيْنَا إِلَيْكَ رُوحًا مِنْ أَمْرِنَا مَا كُنْتَ تَدْرِي مَا الْكِتَابُ وَلَا الْإِيمَانُ وَلَكِنْ جَعَلْنَاهُ نُورًا نَهْدِي بِهِ مَنْ نَشَاءُ مِنْ عِبَادِنَا وَإِنَّكَ لَتَهْدِي إِلَى صِرَاطٍ مُسْتَقِيمٍ"},"reason":"ثلاثُ طرقٍ حصرية للتكليم: وحيٌ في القلب أو الرؤيا، أو من وراء حجاب (كموسى)، أو رسولٌ ملكي — وعُلّل بالاسمين: عليٌّ لا يُخاطب البشر مباشرةً بلا واسطة لعلوّه، حكيمٌ اختار لكل مقامٍ طريقته. فالحجابُ مقتضى العلو لا البخل بالكلام.","adds":"قاعدةٌ تنسف كل دعوى «كلّمني الله مباشرةً»: الطرق ثلاثٌ محصورة، وقد انقطع الوحي بموته ﷺ إلا الرؤيا الصالحة (تخريج المسند لشعيب 24977).","dorar":[{"id":"Zg4x1Okq","label":"تخريج المسند لشعيب 24977"}]}],"hadiths":[],"sunnah":{"card":"الصيغة: الْعَلِيُّ الْحَكِيمُ — مركّبة\nفي السنة: شاهد واحد (رواية واحدة)\nخصوصية الورود في السنة: وردا متجاورين في رواية ابن ماجه لحديث الإحصاء: «…القاهر، العلي، الحكيم، القريب…».","teaches":"1. أن علوّه مقرون بحكمته في الإحصاء.","whenRecall":"- في إحصاء الأسماء.","whenPray":"عند الشعور بـ:\n1. الحاجة إلى حكمة من علوّ.\nعند طلب:\n1. حكمةً تعلو بها.\nعند الرغبة في:\n1. إحصاء الأسماء.","duaItems":"لا صيغة منصوصة؛ ويُدعى بالقرآن: «إنه علي حكيم» [الشورى: 51].","summary":"«العلي الحكيم» في السنة اسمان محصيان في رواية ابن ماجه."},"situations":[{"situationId":105,"verses":[{"i":1,"strength":"direct","headline":"استشكال حجاب الله عن مخاطبة البشر مباشرة","bridge":"تستشكل لماذا لا يخاطبنا الله مباشرة؟ الجواب في الاسمين: ﴿إِنَّهُ عَلِيٌّ حَكِيمٌ﴾ — عليٌّ لا يخاطب البشر بلا واسطة لعلوّه، حكيمٌ اختار لكل مقامٍ طريقته؛ فالحجاب مقتضى العلو لا البخل بالكلام."}],"hadiths":[]}]},{"id":164,"name":"الواسع العليم","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: وَاسِعٌ عَلِيمٌ / وَاسِعًا عَلِيمًا — مركّبة | المواضع: 7\nخصوصية: يتكرر في مواضع الرزق والإنفاق والاصطفاء — فهو اسمُ من لا تنفد خزائنه ولا تضيق معاييره.\n\nالمعنى:\n- الواسع: واسعُ الفضل والرحمة والملك والعطاء — لا يحدّه حدٌّ ولا ينقصه بذل.\n- العليم: العالم بمن يستحق وبما يصلح.","teaches":"الحقائق التي كشفتها المواضع:\n1. عطاؤه لغيرك لا ينقص عطاءك — فالواسع لا تُقسّم خزائنه.\n2. الخوف من الفقر عند الإنفاق وسوسةٌ منسوبةٌ لمصدرها (البقرة 268).\n3. معيار القيادة: بسطةٌ في العلم والجسم لا مالٌ ولا نسب (البقرة 247).\n4. الزواج سببُ غنًى: ﴿إِنْ يَكُونُوا فُقَرَاءَ يُغْنِهِمُ اللَّهُ مِنْ فَضْلِهِ﴾ (النور 32).\n5. سعةُ الجهات ترفع الحرج في العبادة (البقرة 115).","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- عند التردد في صدقةٍ خوف الفقر.\n- عند التردد في الزواج خوف الفقر.\n- عند حسد نعمةٍ عند غيرك.\n- عند اشتباه القبلة في سفر.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. عند الإنفاق: تكذيب وعد الشيطان بالفقر — البقرة 268.\n2. للمقبلين على الزواج: ﴿يُغْنِهِمُ اللَّهُ مِنْ فَضْلِهِ﴾ — النور 32.\n3. سؤال أن تكون من القوم الموصوفين في المائدة 54.\n4. الاستعاذة من الحسد بتذكر سعة الخزائن.","summary":"خزائنُه لا تُقسّم: عطاؤه لغيرك لا ينقص عطاءك — ﴿وَاللَّهُ وَاسِعٌ عَلِيمٌ﴾؛ فأنفق ولا تسمع من يعدك الفقر، وتزوّج ولا تخف.","verses":[{"i":1,"of":7,"s":2,"surah":"البقرة","a":115,"text":"وَلِلَّهِ الْمَشْرِقُ وَالْمَغْرِبُ فَأَيْنَمَا تُوَلُّوا فَثَمَّ وَجْهُ اللَّهِ إِنَّ اللَّهَ وَاسِعٌ عَلِيمٌ","prev":{"a":114,"text":"وَمَنْ أَظْلَمُ مِمَّنْ مَنَعَ مَسَاجِدَ اللَّهِ أَنْ يُذْكَرَ فِيهَا اسْمُهُ وَسَعَى فِي خَرَابِهَا أُولَئِكَ مَا كَانَ لَهُمْ أَنْ يَدْخُلُوهَا إِلَّا خَائِفِينَ لَهُمْ فِي الدُّنْيَا خِزْيٌ وَلَهُمْ فِي الْآخِرَةِ عَذَابٌ عَظِيمٌ"},"next":{"a":116,"text":"وَقَالُوا اتَّخَذَ اللَّهُ وَلَدًا سُبْحَانَهُ بَلْ لَهُ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ كُلٌّ لَهُ قَانِتُونَ"},"reason":"سعةٌ في المكان: المشرق والمغرب له، فلا تضيق الأرض بعبادةٍ في أي جهة — نزلت رخصةً لمن اشتبهت عليه القبلة أو صلى في سفر (صحيح مسلم 700)؛ واسعٌ لا تحدّه جهة، عليمٌ بمن اجتهد فأخطأ.","adds":"إن اشتبهت عليك القبلة فاجتهد وصلِّ: ﴿فَأَيْنَمَا تُوَلُّوا فَثَمَّ وَجْهُ اللَّهِ﴾ — سعةٌ تمنع الحرج.","dorar":[{"id":"7sJUa7bh","label":"صحيح مسلم 700"},{"id":"pUnT4nPp","label":"شرح العمدة (الصلاة) 545"},{"id":"bzhvh1ND","label":"صحيح ابن خزيمة 2/ 421"}]},{"i":2,"of":7,"s":2,"surah":"البقرة","a":247,"text":"وَقَالَ لَهُمْ نَبِيُّهُمْ إِنَّ اللَّهَ قَدْ بَعَثَ لَكُمْ طَالُوتَ مَلِكًا قَالُوا أَنَّى يَكُونُ لَهُ الْمُلْكُ عَلَيْنَا وَنَحْنُ أَحَقُّ بِالْمُلْكِ مِنْهُ وَلَمْ يُؤْتَ سَعَةً مِنَ الْمَالِ قَالَ إِنَّ اللَّهَ اصْطَفَاهُ عَلَيْكُمْ وَزَادَهُ بَسْطَةً فِي الْعِلْمِ وَالْجِسْمِ وَاللَّهُ يُؤْتِي مُلْكَهُ مَنْ يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ","prev":{"a":246,"text":"أَلَمْ تَرَ إِلَى الْمَلَإِ مِنْ بَنِي إِسْرَائِيلَ مِنْ بَعْدِ مُوسَى إِذْ قَالُوا لِنَبِيٍّ لَهُمُ ابْعَثْ لَنَا مَلِكًا نُقَاتِلْ فِي سَبِيلِ اللَّهِ قَالَ هَلْ عَسَيْتُمْ إِنْ كُتِبَ عَلَيْكُمُ الْقِتَالُ أَلَّا تُقَاتِلُوا قَالُوا وَمَا لَنَا أَلَّا نُقَاتِلَ فِي سَبِيلِ اللَّهِ وَقَدْ أُخْرِجْنَا مِنْ دِيَارِنَا وَأَبْنَائِنَا فَلَمَّا كُتِبَ عَلَيْهِمُ الْقِتَالُ تَوَلَّوْا إِلَّا قَلِيلًا مِنْهُمْ وَاللَّهُ عَلِيمٌ بِالظَّالِمِينَ"},"next":{"a":248,"text":"وَقَالَ لَهُمْ نَبِيُّهُمْ إِنَّ آيَةَ مُلْكِهِ أَنْ يَأْتِيَكُمُ التَّابُوتُ فِيهِ سَكِينَةٌ مِنْ رَبِّكُمْ وَبَقِيَّةٌ مِمَّا تَرَكَ آلُ مُوسَى وَآلُ هَارُونَ تَحْمِلُهُ الْمَلَائِكَةُ إِنَّ فِي ذَلِكَ لَآيَةً لَكُمْ إِنْ كُنْتُمْ مُؤْمِنِينَ"},"context":"في اعتراضهم على ملك طالوت لفقره: ﴿قَالَ إِنَّ اللَّهَ اصْطَفَاهُ عَلَيْكُمْ وَزَادَهُ بَسْطَةً فِي الْعِلْمِ وَالْجِسْمِ وَاللَّهُ يُؤْتِي مُلْكَهُ مَنْ يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ﴾.","reason":"اعترضوا بمقياس المال والنسب، فصُحّح المقياس: العلمُ والجسم — أي الكفاءة والقدرة — لا الثروة والحسب؛ واسعٌ يعطي الملك من يشاء بلا حدود معاييركم، عليمٌ بمن يصلح للقيادة.","adds":"معيار اختيار القائد في القرآن: بسطةٌ في العلم والجسم — كفاءةٌ وقدرة، لا مالٌ ولا نسب."},{"i":3,"of":7,"s":2,"surah":"البقرة","a":261,"text":"مَثَلُ الَّذِينَ يُنْفِقُونَ أَمْوَالَهُمْ فِي سَبِيلِ اللَّهِ كَمَثَلِ حَبَّةٍ أَنْبَتَتْ سَبْعَ سَنَابِلَ فِي كُلِّ سُنْبُلَةٍ مِائَةُ حَبَّةٍ وَاللَّهُ يُضَاعِفُ لِمَنْ يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ","prev":{"a":260,"text":"وَإِذْ قَالَ إِبْرَاهِيمُ رَبِّ أَرِنِي كَيْفَ تُحْيِي الْمَوْتَى قَالَ أَوَلَمْ تُؤْمِنْ قَالَ بَلَى وَلَكِنْ لِيَطْمَئِنَّ قَلْبِي قَالَ فَخُذْ أَرْبَعَةً مِنَ الطَّيْرِ فَصُرْهُنَّ إِلَيْكَ ثُمَّ اجْعَلْ عَلَى كُلِّ جَبَلٍ مِنْهُنَّ جُزْءًا ثُمَّ ادْعُهُنَّ يَأْتِينَكَ سَعْيًا وَاعْلَمْ أَنَّ اللَّهَ عَزِيزٌ حَكِيمٌ"},"next":{"a":262,"text":"الَّذِينَ يُنْفِقُونَ أَمْوَالَهُمْ فِي سَبِيلِ اللَّهِ ثُمَّ لَا يُتْبِعُونَ مَا أَنْفَقُوا مَنًّا وَلَا أَذًى لَهُمْ أَجْرُهُمْ عِنْدَ رَبِّهِمْ وَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ"},"reason":"سبعُ مئةٍ من حبةٍ واحدة — ثم ﴿وَاللَّهُ يُضَاعِفُ لِمَنْ يَشَاءُ﴾ بلا سقف؛ واسعٌ لا ينفد عطاؤه بالمضاعفة، عليمٌ بنية المنفق فيضاعف على قدرها. فالسبعمائة حدُّ المثل لا حدُّ العطاء.","adds":"استثمارٌ بعائد سبعمائة ضعف كحدٍّ أدنى للمثل — ثم مضاعفةٌ مفتوحة: أين تجد مثله؟"},{"i":4,"of":7,"s":2,"surah":"البقرة","a":268,"text":"الشَّيْطَانُ يَعِدُكُمُ الْفَقْرَ وَيَأْمُرُكُمْ بِالْفَحْشَاءِ وَاللَّهُ يَعِدُكُمْ مَغْفِرَةً مِنْهُ وَفَضْلًا وَاللَّهُ وَاسِعٌ عَلِيمٌ","prev":{"a":267,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا أَنْفِقُوا مِنْ طَيِّبَاتِ مَا كَسَبْتُمْ وَمِمَّا أَخْرَجْنَا لَكُمْ مِنَ الْأَرْضِ وَلَا تَيَمَّمُوا الْخَبِيثَ مِنْهُ تُنْفِقُونَ وَلَسْتُمْ بِآخِذِيهِ إِلَّا أَنْ تُغْمِضُوا فِيهِ وَاعْلَمُوا أَنَّ اللَّهَ غَنِيٌّ حَمِيدٌ"},"next":{"a":269,"text":"يُؤْتِي الْحِكْمَةَ مَنْ يَشَاءُ وَمَنْ يُؤْتَ الْحِكْمَةَ فَقَدْ أُوتِيَ خَيْرًا كَثِيرًا وَمَا يَذَّكَّرُ إِلَّا أُولُو الْأَلْبَابِ"},"reason":"وعدان متقابلان عند كل نفقة: الشيطانُ يخوّفك الفقر، والله يعدك مغفرةً وفضلًا — واسعٌ لا يُفقره العطاء، عليمٌ بحاجتك. فالخوفُ من الفقر عند الإنفاق وسوسةٌ منسوبةٌ لمصدرها صراحةً.","adds":"اعرف صوت من يخوّفك عند الصدقة: ﴿الشَّيْطَانُ يَعِدُكُمُ الْفَقْرَ﴾ — فلا تطعه في وعده."},{"i":5,"of":7,"s":3,"surah":"آل عمران","a":73,"text":"وَلَا تُؤْمِنُوا إِلَّا لِمَنْ تَبِعَ دِينَكُمْ قُلْ إِنَّ الْهُدَى هُدَى اللَّهِ أَنْ يُؤْتَى أَحَدٌ مِثْلَ مَا أُوتِيتُمْ أَوْ يُحَاجُّوكُمْ عِنْدَ رَبِّكُمْ قُلْ إِنَّ الْفَضْلَ بِيَدِ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ","prev":{"a":72,"text":"وَقَالَتْ طَائِفَةٌ مِنْ أَهْلِ الْكِتَابِ آمِنُوا بِالَّذِي أُنْزِلَ عَلَى الَّذِينَ آمَنُوا وَجْهَ النَّهَارِ وَاكْفُرُوا آخِرَهُ لَعَلَّهُمْ يَرْجِعُونَ"},"next":{"a":74,"text":"يَخْتَصُّ بِرَحْمَتِهِ مَنْ يَشَاءُ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ"},"context":"﴿قُلْ إِنَّ الْهُدَى هُدَى اللَّهِ أَنْ يُؤْتَى أَحَدٌ مِثْلَ مَا أُوتِيتُمْ... قُلْ إِنَّ الْفَضْلَ بِيَدِ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ﴾.","reason":"حسدُ أهل الكتاب أن يُؤتى غيرُهم مثل ما أوتوا — فجاء الرد بالسعة: الفضلُ بيده يؤتيه من يشاء، واسعٌ لا ينقص عطاؤه لقومٍ بإعطاء آخرين، عليمٌ بمن يستحق.","adds":"عطاءُ الله لغيرك لا ينقص عطاءك: الواسعُ لا تُقسّم خزائنه — فاطرد الحسد بهذه القاعدة."},{"i":6,"of":7,"s":5,"surah":"المائدة","a":54,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا مَنْ يَرْتَدَّ مِنْكُمْ عَنْ دِينِهِ فَسَوْفَ يَأْتِي اللَّهُ بِقَوْمٍ يُحِبُّهُمْ وَيُحِبُّونَهُ أَذِلَّةٍ عَلَى الْمُؤْمِنِينَ أَعِزَّةٍ عَلَى الْكَافِرِينَ يُجَاهِدُونَ فِي سَبِيلِ اللَّهِ وَلَا يَخَافُونَ لَوْمَةَ لَائِمٍ ذَلِكَ فَضْلُ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ","prev":{"a":53,"text":"وَيَقُولُ الَّذِينَ آمَنُوا أَهَؤُلَاءِ الَّذِينَ أَقْسَمُوا بِاللَّهِ جَهْدَ أَيْمَانِهِمْ إِنَّهُمْ لَمَعَكُمْ حَبِطَتْ أَعْمَالُهُمْ فَأَصْبَحُوا خَاسِرِينَ"},"next":{"a":55,"text":"إِنَّمَا وَلِيُّكُمُ اللَّهُ وَرَسُولُهُ وَالَّذِينَ آمَنُوا الَّذِينَ يُقِيمُونَ الصَّلَاةَ وَيُؤْتُونَ الزَّكَاةَ وَهُمْ رَاكِعُونَ"},"reason":"وعدٌ بجيلٍ بديل بخمس صفات — أعظمها ﴿يُحِبُّهُمْ وَيُحِبُّونَهُ﴾ — وسُمّي ذلك «فضلًا» لا استحقاقًا؛ واسعٌ لا تُعجزه صناعة أجيال، عليمٌ بمن يصلح لها. فالدينُ لا ينتظر أحدًا.","adds":"الصفات الخمس معيارُ الجيل المنصور: محبةٌ متبادلة، ولينٌ للمؤمنين، وعزةٌ على الكافرين، وجهاد، ولا خوف من لومة لائم."},{"i":7,"of":7,"s":24,"surah":"النور","a":32,"text":"وَأَنْكِحُوا الْأَيَامَى مِنْكُمْ وَالصَّالِحِينَ مِنْ عِبَادِكُمْ وَإِمَائِكُمْ إِنْ يَكُونُوا فُقَرَاءَ يُغْنِهِمُ اللَّهُ مِنْ فَضْلِهِ وَاللَّهُ وَاسِعٌ عَلِيمٌ","prev":{"a":31,"text":"وَقُلْ لِلْمُؤْمِنَاتِ يَغْضُضْنَ مِنْ أَبْصَارِهِنَّ وَيَحْفَظْنَ فُرُوجَهُنَّ وَلَا يُبْدِينَ زِينَتَهُنَّ إِلَّا مَا ظَهَرَ مِنْهَا وَلْيَضْرِبْنَ بِخُمُرِهِنَّ عَلَى جُيُوبِهِنَّ وَلَا يُبْدِينَ زِينَتَهُنَّ إِلَّا لِبُعُولَتِهِنَّ أَوْ آبَائِهِنَّ أَوْ آبَاءِ بُعُولَتِهِنَّ أَوْ أَبْنَائِهِنَّ أَوْ أَبْنَاءِ بُعُولَتِهِنَّ أَوْ إِخْوَانِهِنَّ أَوْ بَنِي إِخْوَانِهِنَّ أَوْ بَنِي أَخَوَاتِهِنَّ أَوْ نِسَائِهِنَّ أَوْ مَا مَلَكَتْ أَيْمَانُهُنَّ أَوِ التَّابِعِينَ غَيْرِ أُولِي الْإِرْبَةِ مِنَ الرِّجَالِ أَوِ الطِّفْلِ الَّذِينَ لَمْ يَظْهَرُوا عَلَى عَوْرَاتِ النِّسَاءِ وَلَا يَضْرِبْنَ بِأَرْجُلِهِنَّ لِيُعْلَمَ مَا يُخْفِينَ مِنْ زِينَتِهِنَّ وَتُوبُوا إِلَى اللَّهِ جَمِيعًا أَيُّهَ الْمُؤْمِنُونَ لَعَلَّكُمْ تُفْلِحُونَ"},"next":{"a":33,"text":"وَلْيَسْتَعْفِفِ الَّذِينَ لَا يَجِدُونَ نِكَاحًا حَتَّى يُغْنِيَهُمُ اللَّهُ مِنْ فَضْلِهِ وَالَّذِينَ يَبْتَغُونَ الْكِتَابَ مِمَّا مَلَكَتْ أَيْمَانُكُمْ فَكَاتِبُوهُمْ إِنْ عَلِمْتُمْ فِيهِمْ خَيْرًا وَآتُوهُمْ مِنْ مَالِ اللَّهِ الَّذِي آتَاكُمْ وَلَا تُكْرِهُوا فَتَيَاتِكُمْ عَلَى الْبِغَاءِ إِنْ أَرَدْنَ تَحَصُّنًا لِتَبْتَغُوا عَرَضَ الْحَيَاةِ الدُّنْيَا وَمَنْ يُكْرِهْهُنَّ فَإِنَّ اللَّهَ مِنْ بَعْدِ إِكْرَاهِهِنَّ غَفُورٌ رَحِيمٌ"},"reason":"عالجت الآيةُ أكبر عائقٍ للزواج — الفقر — بوعدٍ صريح: ﴿إِنْ يَكُونُوا فُقَرَاءَ يُغْنِهِمُ اللَّهُ مِنْ فَضْلِهِ﴾؛ واسعٌ يغني المتزوجين من فضله، عليمٌ بحاجتهم وصدق عزمهم. فالزواجُ سببُ غنًى لا سببُ فقر.","adds":"آيةٌ يحتاجها كل متردد في الزواج خوف الفقر — والوعد صريح: ﴿يُغْنِهِمُ اللَّهُ مِنْ فَضْلِهِ﴾."}],"hadiths":[{"i":1,"of":1,"text":"لمَّا نزَلت: {مَثَلُ الَّذِينَ يُنْفِقُونَ أَمْوَالَهُمْ فِي سَبِيلِ اللَّهِ كَمَثَلِ حَبَّةٍ أَنْبَتَتْ سَبْعَ سَنَابِلَ فِي كُلِّ سُنْبُلَةٍ مِائَةُ حَبَّةٍ وَاللَّهُ يُضَاعِفُ لِمَنْ يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ} [البقرة: 261] قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( ربِّ زِدْ أمَّتي ) فنزَلت: {مَنْ ذَا الَّذِي يُقْرِضُ اللَّهَ قَرْضًا حَسَنًا فَيُضَاعِفَهُ لَهُ أَضْعَافًا كَثِيرَةً} [البقرة: 245] قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( ربِّ زِدْ أمَّتي ) فنزَلت: {إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُمْ بِغَيْرِ حِسَابٍ} [الزمر: 10]","narrator":"عبدالله بن عمر","source":"صحيح ابن حبان 4648","grade":"صحيح","judgment":"أخرجه في صحيحه","url":"https://dorar.net/h/LGm5VEnJ","nameForm":"وَاسِعٌ عَلِيمٌ","scene":"ابن عمر: لما نزلت ﴿مَّثَلُ الَّذِينَ يُنفِقُونَ أَمْوَالَهُمْ فِي سَبِيلِ اللَّهِ كَمَثَلِ حَبَّةٍ أَنبَتَتْ سَبْعَ سَنَابِلَ… وَاللَّهُ يُضَاعِفُ لِمَن يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ﴾ قال النبي ﷺ: «رب زد أمتي» فنزلت آية القرض الحسن، فقال: «رب زد أمتي» فنزلت آية الصابرين بغير حساب.","reason":"الاسم «واسع عليم» في آية السبعمائة فتح للنبي ﷺ باب الطلب: إن كان واسعًا فزد — فزاد أضعافًا كثيرة ثم بغير حساب. فالسعة في الاسم استُدرّت بها الزيادة.","adds":"يُري الاسم مفتاحًا لطلب النبي ﷺ الزيادة لأمته ثلاث مرات."}],"sunnah":{"card":"الصيغة: الْوَاسِعُ الْعَلِيمُ — مركّبة، وردت «واسع عليم»\nفي السنة: شاهد واحد (رواية واحدة)\nخصوصية الورود في السنة: لما نزلت آية السبع سنابل ﴿وَاللَّهُ يُضَاعِفُ لِمَن يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ﴾ قال النبي ﷺ: «رب زد أمتي» فنزلت ﴿مَّن ذَا الَّذِي يُقْرِضُ اللَّهَ قَرْضًا حَسَنًا فَيُضَاعِفَهُ لَهُ أَضْعَافًا كَثِيرَةً﴾ فقال: «رب زد أمتي» فنزلت ﴿إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُم بِغَيْرِ حِسَابٍ﴾.","teaches":"1. أن سعته تُطلب بها الزيادة: «رب زد أمتي».\n2. أنه يضاعف سبعمائة ثم أضعافًا ثم بغير حساب.","whenRecall":"- عند الإنفاق.\n- حين تستكثر أجرًا: هو واسع.","whenPray":"عند الشعور بـ:\n1. التردد في الإنفاق.\nعند طلب:\n1. المضاعفة بغير حساب.\nعند الرغبة في:\n1. أن تطلب لأمتك كما طلب النبي ﷺ.","duaItems":"«رب زد أمتي» — كلمة النبي ﷺ بعد الاسم — صحيح ابن حبان 4648.","summary":"«الواسع العليم» في السنة مفتاح «رب زد أمتي»: من سبعمائة إلى أضعاف كثيرة إلى بغير حساب."},"situations":[{"situationId":43,"verses":[{"i":3,"strength":"direct","headline":"التردد في الإنفاق خوفًا من الفقر","bridge":"تريد أن تنفق ويخوّفك الفقر؟ اقرأ عائد الاستثمار: ﴿كَمَثَلِ حَبَّةٍ أَنْبَتَتْ سَبْعَ سَنَابِلَ فِي كُلِّ سُنْبُلَةٍ مِائَةُ حَبَّةٍ وَاللَّهُ يُضَاعِفُ لِمَنْ يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ﴾ — سبعمائة حدُّ المثل لا حدُّ العطاء، والواسع لا ينفد عطاؤه، والعليم يضاعف على قدر نيتك."},{"i":4,"strength":"direct","headline":"صوتٌ يخوّفك الفقر كلما هممت بالصدقة","bridge":"تسمع صوتًا يخوّفك عند كل صدقة؟ اعرف مصدره: ﴿الشَّيْطَانُ يَعِدُكُمُ الْفَقْرَ وَيَأْمُرُكُمْ بِالْفَحْشَاءِ وَاللَّهُ يَعِدُكُمْ مَغْفِرَةً مِنْهُ وَفَضْلًا وَاللَّهُ وَاسِعٌ عَلِيمٌ﴾ — وعدان متقابلان عند كل نفقة؛ فلا تطع في وعده من نُسب إليه التخويف صراحة."}],"hadiths":[{"i":1,"strength":"direct","headline":"التردد في الإنفاق خشية النقص","bridge":"تتردد في الإنفاق؟ آية السبع سنابل تُختم ﴿وَاللَّهُ وَاسِعٌ عَلِيمٌ﴾ فقال النبي ﷺ: «رب زد أمتي» — فزاد إلى أضعافٍ كثيرة ثم بغير حساب."}]},{"situationId":50,"verses":[{"i":7,"strength":"direct","headline":"تأخير الزواج خوفًا من الفقر","bridge":"تؤخر الزواج خوف الفقر؟ الآية عالجت أكبر عائقٍ بوعدٍ صريح: ﴿وَأَنْكِحُوا الْأَيَامَى مِنْكُمْ... إِنْ يَكُونُوا فُقَرَاءَ يُغْنِهِمُ اللَّهُ مِنْ فَضْلِهِ وَاللَّهُ وَاسِعٌ عَلِيمٌ﴾ — الزواج سبب غنًى لا سبب فقر؛ واسعٌ يغني المتزوجين، عليمٌ بصدق عزمهم."}],"hadiths":[]},{"situationId":66,"verses":[{"i":2,"strength":"direct","headline":"اختيار الأكفأ لأمرٍ بعيدًا عن معيار المال والنسب","bridge":"ترشّح أحدًا لأمرٍ وتقيسه بماله ونسبه؟ اعترض بنو إسرائيل على ملك طالوت لفقره فصُحّح المقياس: ﴿إِنَّ اللَّهَ اصْطَفَاهُ عَلَيْكُمْ وَزَادَهُ بَسْطَةً فِي الْعِلْمِ وَالْجِسْمِ وَاللَّهُ يُؤْتِي مُلْكَهُ مَنْ يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ﴾ — معيار الاختيار في القرآن الكفاءة والقدرة لا الثروة والحسب؛ فرشّح بالعلم والقدرة."}],"hadiths":[]},{"situationId":84,"verses":[{"i":5,"strength":"direct","headline":"ضيق الصدر بما أُعطي غيرك من النعم","bridge":"يضيق صدرك أن يُعطى غيرك مثل ما أُعطيت؟ هذا كان داء أهل الكتاب: ﴿أَنْ يُؤْتَى أَحَدٌ مِثْلَ مَا أُوتِيتُمْ﴾ فجاء الرد: ﴿قُلْ إِنَّ الْفَضْلَ بِيَدِ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ﴾ — عطاء الله لغيرك لا ينقص عطاءك، فالواسع لا تُقسَّم خزائنه."}],"hadiths":[]},{"situationId":160,"verses":[{"i":1,"strength":"direct","headline":"اشتباه القبلة في سفرٍ أو مكانٍ غريب","bridge":"اشتبهت عليك القبلة في سفرٍ أو مكانٍ غريب؟ ﴿وَلِلَّهِ الْمَشْرِقُ وَالْمَغْرِبُ فَأَيْنَمَا تُوَلُّوا فَثَمَّ وَجْهُ اللَّهِ إِنَّ اللَّهَ وَاسِعٌ عَلِيمٌ﴾ — سعةٌ في المكان لا تضيق بعبادةٍ في أي جهة: واسعٌ لا تحده جهة، عليمٌ بمن اجتهد؛ فاجتهد وصلّ ولا تحرج."}],"hadiths":[]},{"situationId":173,"verses":[{"i":6,"strength":"direct","headline":"طلب محبة الله والسعي لنيلها","bridge":"تريد أن تكون ممن يحبهم الله ويحبونه؟ الصفات الخمس للجيل الموعود: ﴿فَسَوْفَ يَأْتِي اللَّهُ بِقَوْمٍ يُحِبُّهُمْ وَيُحِبُّونَهُ أَذِلَّةٍ عَلَى الْمُؤْمِنِينَ أَعِزَّةٍ عَلَى الْكَافِرِينَ يُجَاهِدُونَ فِي سَبِيلِ اللَّهِ وَلَا يَخَافُونَ لَوْمَةَ لَائِمٍ ذَلِكَ فَضْلُ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ﴾ — محبةٌ متبادلة سُميت فضلًا؛ فتخلّق بالصفات واسأل الواسع الفضل."}],"hadiths":[]}]},{"id":165,"name":"بكل شيء محيط","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: بِكُلِّ شَيْءٍ مُحِيطٌ / مُحِيطًا — | المواضع: 2 (النساء: 126 — فصلت: 54)\nخصوصية: الإحاطة أشملُ من العلم والقدرة: إحاطةُ ملكٍ وعلمٍ وقدرةٍ معًا.\n\nالمعنى:\n- بكل شيء محيط: الذي أحاط بكل شيءٍ علمًا وقدرةً وملكًا — فلا يخرج شيءٌ عن إحاطته من أي جهة.","teaches":"الحقائق التي كشفها الموضعان:\n1. الإحاطة تشمل الملك والعلم والقدرة معًا.\n2. أدق الحقوق داخلةٌ في الإحاطة.\n3. الشك في اللقاء لا يمنعه: المحاط لا يفلت.","whenRecall":"لحظات الاستحضار — مشتقة من موضعيه:\n- عند هضم حقٍّ صغير لا يحصيه أحد.\n- عند وسوسة الشك في اللقاء.","whenPray":"بنود الدعاء — مشتقة من سياق الموضعين:\n1. سؤال أداء الحقوق كاملة — النساء 126.\n2. سؤال اليقين باللقاء — فصلت 54.\n3. الاستعاذة من الظلم في التفاصيل الصغيرة.","summary":"لا تفلت من محيطٍ أحاط بكل شيء: ﴿أَلَا إِنَّهُ بِكُلِّ شَيْءٍ مُحِيطٌ﴾ — فأدِّ الحقوق التي لا يحصيها أحد.","verses":[{"i":1,"of":2,"s":4,"surah":"النساء","a":126,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَانَ اللَّهُ بِكُلِّ شَيْءٍ مُحِيطًا","prev":{"a":125,"text":"وَمَنْ أَحْسَنُ دِينًا مِمَّنْ أَسْلَمَ وَجْهَهُ لِلَّهِ وَهُوَ مُحْسِنٌ وَاتَّبَعَ مِلَّةَ إِبْرَاهِيمَ حَنِيفًا وَاتَّخَذَ اللَّهُ إِبْرَاهِيمَ خَلِيلًا"},"next":{"a":127,"text":"وَيَسْتَفْتُونَكَ فِي النِّسَاءِ قُلِ اللَّهُ يُفْتِيكُمْ فِيهِنَّ وَمَا يُتْلَى عَلَيْكُمْ فِي الْكِتَابِ فِي يَتَامَى النِّسَاءِ اللَّاتِي لَا تُؤْتُونَهُنَّ مَا كُتِبَ لَهُنَّ وَتَرْغَبُونَ أَنْ تَنْكِحُوهُنَّ وَالْمُسْتَضْعَفِينَ مِنَ الْوِلْدَانِ وَأَنْ تَقُومُوا لِلْيَتَامَى بِالْقِسْطِ وَمَا تَفْعَلُوا مِنْ خَيْرٍ فَإِنَّ اللَّهَ كَانَ بِهِ عَلِيمًا"},"context":"﴿وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَانَ اللَّهُ بِكُلِّ شَيْءٍ مُحِيطًا﴾ — بعد ذكر ملة إبراهيم وخُلّته، وبين يدي آيات الاستفتاء في النساء واليتامى.","reason":"قُدِّمت الإحاطةُ بين يدي أحكام النساء واليتامى: من يملك ما في السماوات والأرض ويحيط بكل شيء لا يفوته حقٌّ مهضوم ولا تفصيلٌ في معاملة يتيمٍ أو امرأة؛ وهي كذلك ختامٌ لما قبلها من الجزاء على العمل: لا يفوته صالحٌ ولا سوء.","adds":"الحقوق الصغيرة التي تظن أن لا أحد يحصيها داخلةٌ في إحاطته: ﴿بِكُلِّ شَيْءٍ مُحِيطًا﴾."},{"i":2,"of":2,"s":41,"surah":"فصلت","a":54,"text":"أَلَا إِنَّهُمْ فِي مِرْيَةٍ مِنْ لِقَاءِ رَبِّهِمْ أَلَا إِنَّهُ بِكُلِّ شَيْءٍ مُحِيطٌ","prev":{"a":53,"text":"سَنُرِيهِمْ آيَاتِنَا فِي الْآفَاقِ وَفِي أَنْفُسِهِمْ حَتَّى يَتَبَيَّنَ لَهُمْ أَنَّهُ الْحَقُّ أَوَلَمْ يَكْفِ بِرَبِّكَ أَنَّهُ عَلَى كُلِّ شَيْءٍ شَهِيدٌ"},"context":"خاتمة فصلت: ﴿أَلَا إِنَّهُمْ فِي مِرْيَةٍ مِنْ لِقَاءِ رَبِّهِمْ أَلَا إِنَّهُ بِكُلِّ شَيْءٍ مُحِيطٌ﴾.","reason":"شكٌّ في اللقاء يُقابله تنبيهان بـ﴿أَلَا﴾: تشخيصُ الداء (مِرية من اللقاء) ثم الدواء (الإحاطة) — فمن أحاط بكل شيءٍ محيطٌ بهم أينما ذهبوا، ولقاؤه حتميٌّ لمن أحاط به.","adds":"الشك في اللقاء لا يلغيه: ﴿أَلَا إِنَّهُ بِكُلِّ شَيْءٍ مُحِيطٌ﴾ — والمحاطُ لا يهرب من محيطه."}],"hadiths":[],"situations":[{"situationId":76,"verses":[{"i":1,"strength":"direct","headline":"الاستهانة بحقٍّ صغير تظن أن لا أحد يحصيه","bridge":"حقٌّ صغير تظن أن لا أحد يحصيه؟ بين يدي أحكام حقوق النساء واليتامى جاءت: ﴿وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَانَ اللَّهُ بِكُلِّ شَيْءٍ مُحِيطًا﴾ — من يحيط بكل شيء لا يفوته حقٌّ مهضوم ولا تفصيلٌ في معاملة يتيمٍ أو امرأة؛ فالصغير داخلٌ في إحاطته."}],"hadiths":[]},{"situationId":104,"verses":[{"i":2,"strength":"direct","headline":"وسوسة الشك في لقاء الله والحساب","bridge":"يوسوس إليك شكٌّ في اللقاء والحساب؟ خاتمة فصلت شخّصت الداء والدواء: ﴿أَلَا إِنَّهُمْ فِي مِرْيَةٍ مِنْ لِقَاءِ رَبِّهِمْ أَلَا إِنَّهُ بِكُلِّ شَيْءٍ مُحِيطٌ﴾ — الشك في اللقاء لا يلغيه؛ فالمحاط لا يهرب من محيطه، واللقاء حتميٌّ لمن أحاط به."}],"hadiths":[]}]},{"id":166,"name":"الذي له ملك السماوات والأرض وما بينهما وعنده علم الساعة","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: الَّذِي لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَعِنْدَهُ عِلْمُ السَّاعَةِ — مركّبة | المواضع: 1 (الزخرف: 85)\nخصوصية: تجمع الملك الشامل بعلم الساعة المستأثر به — ملكٌ معلوم وغيبٌ محجوب.\n\nالمعنى: مالكُ العوالم الثلاثة، والمنفردُ بعلم موعد الساعة، وإليه المرجع.","teaches":"الحقائق التي كشفها الموضع:\n1. علم الساعة مستأثرٌ به وحده.\n2. الملك الشامل والمرجع في جملة واحدة.\n3. التبريك يليق بمن جمع الملك والعلم والمرجع.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند سماع تحديدٍ لموعد الساعة.\n- عند التفكر في المرجع والنهاية.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. الاستعداد للمرجع: ﴿وَإِلَيْهِ تُرْجَعُونَ﴾.\n2. التبرؤ من ادعاء علم الغيب وتصديق مدّعيه.\n3. سؤال حسن الاستعداد للساعة وأشراطها.","summary":"له الملك كله، وعنده وحده علم الساعة، وإليه المرجع — فمن حدّد موعدها فقد ادّعى ما ليس له.","verses":[{"i":1,"of":1,"s":43,"surah":"الزخرف","a":85,"text":"وَتَبَارَكَ الَّذِي لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَعِنْدَهُ عِلْمُ السَّاعَةِ وَإِلَيْهِ تُرْجَعُونَ","prev":{"a":84,"text":"وَهُوَ الَّذِي فِي السَّمَاءِ إِلَهٌ وَفِي الْأَرْضِ إِلَهٌ وَهُوَ الْحَكِيمُ الْعَلِيمُ"},"next":{"a":86,"text":"وَلَا يَمْلِكُ الَّذِينَ يَدْعُونَ مِنْ دُونِهِ الشَّفَاعَةَ إِلَّا مَنْ شَهِدَ بِالْحَقِّ وَهُمْ يَعْلَمُونَ"},"reason":"بعد التنزيه عن الولد جاء التبريك بثلاث: ملكٌ شامل، وعلمُ ساعةٍ مستأثرٌ به، ومرجعٌ إليه — فالمِلكُ يُثبت القدرة، وعلمُ الساعة يُثبت انفراده بالغيب، والمرجعُ يقطع كل هروب.","adds":"من ادّعى معرفة موعد الساعة فقد ادّعى ما استأثر به مالكُ الملك — فاحذر كل تحديدٍ لموعدها."}],"hadiths":[],"situations":[{"situationId":110,"verses":[{"i":1,"strength":"direct","headline":"ضعف اليقين بما بعد الموت والرجوع إلى الله","bridge":"تريد أن يرسخ يقينك بما بعد الموت؟ ﴿وَتَبَارَكَ الَّذِي لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَعِنْدَهُ عِلْمُ السَّاعَةِ وَإِلَيْهِ تُرْجَعُونَ﴾ — الملك يُثبت القدرة، وعلم الساعة يُثبت انفراده بالغيب، والمرجع يقطع كل هروب؛ ومن ادّعى معرفة موعدها فقد ادّعى ما استأثر به مالك الملك."}],"hadiths":[]}]},{"id":167,"name":"رب العرش","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: رَبُّ الْعَرْشِ (بمفردها ومقيدة) | المواضع: 6\nخصوصية: تجمع كل مواضع إضافة الربوبية إلى العرش — عظيمًا وكريمًا ومطلقًا — وتتقاطع مع صيغتي «رب العرش العظيم» و«رب العرش الكريم» بزاويةٍ جامعة: العرشُ أعلى المخلوقات، فذكرُه معيارٌ يُقاس به كل ما دونه.\n\nالمعنى:\n- رب العرش: مالكُ العرش الأعظم ومدبّرُه — وهو سقفُ المخلوقات وأعظمُها.","teaches":"الحقائق التي كشفتها المواضع:\n1. ذكرُ العرش معيارٌ يصغّر كل ما تهابه.\n2. الحسبنة به تكفي إعراض الخلق (التوبة 129).\n3. الإقرار بربوبيته يُلزم بالتقوى (المؤمنون 86).\n4. مالك العرش منزّهٌ عن الولد والشريك.","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- عند الخذلان والإعراض.\n- عند الكرب — فالصيغة في دعائه.\n- عند مهابة أصحاب العروش الأرضية.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. ﴿حَسْبِيَ اللَّهُ لَا إِلَهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ﴾ — التوبة 129.\n2. دعاء الكرب: «لَا إِلَهَ إِلَّا اللَّهُ رَبُّ الْعَرْشِ الْعَظِيمِ» — متفق عليه.\n3. التسبيح عند سماع الأوصاف الباطلة — الأنبياء 22.","summary":"كلما هالك عرشٌ في الأرض فقس عليه: ﴿وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ﴾ — ومن كان حسبُه ربَّ العرش لم يعبأ بمن أعرض.","verses":[],"hadiths":[{"i":1,"of":2,"text":"تُوقَفون مَوقِفًا واحدًا يومَ القيامةِ ، مِقدارَ سبعين عامًا ، لا يُنظَرُ إليكم ، ولا يُقضى بينَكم ، قد حصر عليكم ، فتبكون حتى ينقطعَ الدمعُ ، ثم تدمَعون دمًا ، وتَبكون حتى يبلغَ ذلك منكم الأذقانَ ، أو يُلجِمَكم فتصيحون ، ثم تقولون : مَنْ يشفعُ لنا إلى ربِّنا فيقضيَ بينَنا ؟ فيقولون : مَنْ أحقُّ بذلك مِنْ أبيكم آدمَ ؟ جبل اللهُ تربتَه ، وخلَقه بيدِه ، ونفَخ فيه مِنْ روحِه ، وكلَّمه قُبُلًا ، فيؤتى آدمُ ، فيُطلبُ ذلك إليه ، فيأبى ، ثم يَستقرئون الأنبياءَ نبيًّا نبيًّا ، كلما جاءوا نبيًّا أبى ، قال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ : حتى يأتوني ، فإذا جاءوني خرجتُ حتى آتيَ الفحصَ ، قال أبو هريرةَ : يا رسولَ اللهِ ! وما الفحصُ ؟ قال : قدامُ العرشِ ، فأخِرَّ ساجدًا ، فلا أزالُ ساجدًا حتى يبعَثَ اللهُ إليَّ ملَكًا ، فيأخُذَ بِعَضُدي فيرفعَني ، ثم يقولُ اللهُ لي : يا محمدُ ! فأقولُ : نعمْ ، وهو أعلمُ ، فيقولُ : ما شأنُك ؟ فأقولُ : يا ربِّ وعدتَني الشفاعةَ ، فشفِّعْني في خلقِك فاقْضِ بينَهم ! فيقولُ : قد شفَّعْتُك ، أنا آتيكم فأقضي بينَكم ، قال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ : فأنصرفُ حتى أقفَ مع الناسِ ، فبينا نحنُ وُقوفٌ ، سمِعْنا حسًّا مِنَ السماءِ شديدًا ، فهالَنا ، فنزَل أهلُ السماءِ الدنيا بمثلَيْ مَنْ في الأرضِ مِنَ الجنِّ والإنسِ ، حتى إذا دنَوا مِنَ الأرضِ ، أشرقَتِ الأرضُ بنورِهم ، وأخذوا مصافَّهم ، فقلنا لهم : أفيكم ربُّنا ؟ قالوا : لا وهو آتٍ ، ثم نزَل أهلُ السماءِ الثانيةِ بمثلَيْ مَنْ نزَل مِنَ الملائكةِ ، وبمثلَيْ مَنْ فيها مِنَ الجنِّ والإنسِ ، حتى إذا دنَوْا مِنَ الأرضِ ، أشرقَتِ الأرضُ بنورِهم ، وأخذوا مصافَّهم ، فقلنا لهم : أفيكم ربُّنا ؟ قالوا : لا ، وهو آتٍ ، ثم نزَل أهلُ السماءِ الثالثةِ بمثلَيْ مَنْ نزَل مِنَ الملائكةِ ، وبمثلَيْ مَنْ في الأرضِ مِنَ الجنِّ والإنسِ ، حتى إذا دنَوْا مِنَ الأرضِ ، أشرقَتِ الأرضُ بنورِهم ، وأخذوا مصافَّهم ، فقلنا لهم : أفيكم ربُّنا ؟ قالوا : لا وهو آتٍ ، ثم نزَل أهلُ السماوات على عددِ ذلك مِنَ التضعيفِ ، حتى نزَل الجبارُ في ظُلَلٍ مِنَ الغَمامِ والملائكةُ ، ولهم زَجَلٌ مِنْ تسبيحِهم ، يقولون : سبحان ذي المُلْكِ والملَكُوتِ ، سبحان رب العرشِ ذي الجَبَروتِ ، سبحان الحيِّ الذي لا يموتُ ، سبحان الذي يُميتُ الخلائقَ ولا يَموتُ ، سُبُّوحٌ قُدُّوسٌ ، ربُّ الملائكةِ والروحِ ، قدُّوسٌ قدُّوسٌ ، سبحان ربِّنا الأعلى ، سبحان ذي السُّلْطانِ والعظمةِ ، سبحانه أبدًا أبدًا ، فينزِلُ تبارك وتعالى يَحمِلُ عرشَه يومئذٍ ثمانيةٌ ، وهمُ اليومَ أربعةٌ ، أقدامُهم على تُخُومِ الأرضِ السفلى ، والسماواتُ إلى حُجُزِهم ، والعرشُ على مناكبِهم ، فوضَع اللهُ عز وجل عرَشه حيثُ شاء مِنَ الأرضِ ، ثم يُنادي منادٍ نداءً يُسمِعُ الخلائقَ ، فيقولُ : يا معشرَ الجنِّ والإنسِ إني قد أَنْصَتُّ منذُ يومِ خلقْتُكم إلى يومِكم هذا ، أسمعُ كلامَكم ، وأبصرُ أعمالَكم ، فأنصِتوا إليَّ ، فإنما هي صحُفُكم وأعمالُكم تُقرأُ عليكم ، فمن وجَد خيرًا فلْيَحْمَدِ اللهَ ، ومَنْ وجَد غيرَ ذلك فلا يلومنَّ إلا نفسَه ، فيقضي اللهُ عز وجل بينَ خلقِه الجنِّ والإنسِ والبهائمِ ، فإنه ليُقْتَصُّ يومئذٍ للجمَّاءِ مِنْ ذاتِ القَرْنِ","narrator":"أبو هريرة","source":"تفسير الطبري 2/439","grade":"صحيح","judgment":"ثابت","url":"https://dorar.net/h/yzb5w1FI","nameForm":"رب العرشِ","scene":"أبو هريرة: يوقف الناس يوم القيامة سبعين عامًا… حتى ينزل الجبار في ظلل من الغمام والملائكة لهم زجلٌ من تسبيحهم: «سبحان ذي الملك والملكوت، سبحان رب العرش ذي الجبروت، سبحان الحي الذي لا يموت…».","reason":"الملائكة تسبّح رب العرش وهم ينزلون به: من كان العرش عرشه فله الجبروت.","adds":"يُري الاسم في تسبيح الملائكة يوم الفصل."},{"i":2,"of":2,"text":"قالَت صفيَّةُ بنتُ عبدِ المطَّلبِ ترثي رسولَ اللهِ صلَّى اللَّهُ عليه وسلَّم لَهْفَ نفسي وبِتُّ كالمسلوبِ أرقُبُ اللَّيلَ فِعْلَةَ المحروبِ من همومٍ وحسرةٍ أرَّقَتْني لَيْتَ أنِّي سقَيْتُها بشَعوبِ حينَ قالوا إنَّ الرَّسولَ قد أمسى وافَقَتْه منيَّةُ المكتوبِ حينَ جِئْنا لآلِ بيتِ محمَّدٍ فأشاب القَذالَ منِّي مَشِيبُ حينَ رأَيْنا بيوتَه مُوحِشاتٍ ليس فيهنَّ بعدُ عيشُ غريبِ فعراني لذاك حزنٌ طويلٌ خالَط القلبَ فَهْوَ كالمرعوبِ وقالَت أيضًا ألا يا رسولَ اللهِ كُنْتَ رخاءَنا وكُنْتَ بنا برًّا ولم تَكُ جافيَا وكان بنا برًّا رحيمًا نبيُّنا ليَبْكِ عليك اليومَ مَن كان باكيَا لَعَمْري ما أبكي النَّبيَّ لموتِه ولكن لهَرْجٍ كان بعدَك آتيَا كأنَّ على قلبي لفَقْدِ محمَّدٍ ومِن حبِّه من بعدِ ذاك المكاويَا أفاطِمُ صلَّى اللهُ ربُّ محمَّدٍ على جَدَثٍ أمسى بيثربَ ثاويَا أرى حَسَنًا أيتَمْتَه وترَكْتَه يبكي ويدعو جدَّه اليومَ نائيَا فِدًى لرسولِ اللهِ أمِّي وخالَتي وعمِّي ونفسي قَصْرَه وعِياليَا صبَرْتَ وبلَّغْتَ الرِّسالةَ صادقًا ومِتَّ صليبَ الدِّينَ أَبْلَجَ صافيَا فلو أنَّ ربَّ العرشِ أبقاك بينَنا سعِدْنا ولكنْ أمرُه كان ماضيَا عليك من اللهِ السَّلامُ تحيَّةً وأُدخِلْت جنَّاتٍ من العَدْنِ راضيَا","narrator":"عروة بن الزبير","source":"مجمع الزوائد 9/41","grade":"حسن","judgment":"إسناده حسن","url":"https://dorar.net/h/AR4sgx1U","nameForm":"ربَّ العرشِ","scene":"صفية بنت عبد المطلب ترثي النبي ﷺ: «فلو أن رب العرش أبقاك بيننا سعدنا ولكن أمره كان ماضيا، عليك من الله السلام تحيةً وأُدخلت جناتٍ من العدن راضيا».","reason":"في الرثاء يُنسب الأجل إلى رب العرش: لو أبقاه لسعدنا، لكن أمره ماضٍ — تسليمٌ بقضاء ربّ العرش في أعز فقد.","adds":"يُري الاسم في تسليم عمة النبي ﷺ عند موته."}],"sunnah":{"card":"الصيغة: رَبُّ الْعَرْشِ — مركّبة\nفي السنة: شاهدان (روايتان)\nخصوصية الورود في السنة: في تسبيح الملائكة يوم القيامة «سبحان رب العرش ذي الجبروت»، وفي رثاء صفية بنت عبد المطلب للنبي ﷺ: «فلو أن رب العرش أبقاك بيننا».\nالمعنى المختصر: مالك العرش ومدبّره.","teaches":"1. أنه رب العرش ذو الجبروت تسبّحه الملائكة.\n2. أن أمره في الآجال ماضٍ ولو كان الفقيد رسول الله.","whenRecall":"- عند فقد عزيز.\n- حين تقرأ عن الموقف.","whenPray":"عند الشعور بـ:\n1. الفقد.\nعند طلب:\n1. التسليم لقضائه.\nعند الرغبة في:\n1. تسبيحه كتسبيح الملائكة.","duaItems":"لا صيغة منصوصة؛ وتسبيح الملائكة: «سبحان رب العرش ذي الجبروت» — تفسير الطبري 2/439 (ثابت).","summary":"«رب العرش» في السنة تسبيح الملائكة في الموقف ورثاء صفية: «فلو أن رب العرش أبقاك بيننا… ولكن أمره كان ماضيا»."},"situations":[{"situationId":4,"verses":[],"hadiths":[{"i":2,"strength":"direct","headline":"فقد عزيزٍ والتسليم لقضاء الله في أجله","bridge":"فقدت من تحب؟ قالت صفية في رثاء النبي ﷺ: «فلو أن رب العرش أبقاك بيننا سعدنا ولكن أمره كان ماضيا» — التسليم لرب العرش في أعز فقد."}]},{"situationId":183,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"هول الموقف يوم القيامة وطول انتظار الفصل بين الخلائق","bridge":"يهولك طول وقوف الناس يوم القيامة حتى يقولوا: «مَنْ يشفعُ لنا إلى ربِّنا فيقضيَ بينَنا»؟ يأتي النبي ﷺ فيخرّ ساجدًا «قدامُ العرشِ» — فعظّم رب العرش اليوم، واسأله أن يجعلك ممن يُشفَّع فيهم يوم الفصل."}]}]},{"id":168,"name":"فاطر السماوات والأرض","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: فَاطِرِ السَّمَاوَاتِ وَالْأَرْضِ — مضافة | المواضع: 6\nخصوصية: يُنادى به في أدق المقامات: اختيار الولي، وقمة التمكين (يوسف)، والشك في وجود الله، وفصل الخلاف — وهو نداءُ استفتاح التهجد النبوي.\n\nالمعنى:\n- فاطر السماوات والأرض: مبتدئُهما وشاقُّهما على غير مثالٍ سابق — و«الفطر» الشقُّ والابتداء معًا.","teaches":"الحقائق التي كشفتها المواضع:\n1. معيار الولي: فاطرٌ ينشئ، ويطعم ولا يُطعَم (الأنعام 14).\n2. غاية دعوته لك: ﴿يَدْعُوكُمْ لِيَغْفِرَ لَكُمْ﴾ (إبراهيم 10).\n3. عند الاختلاف يُنادى الفاطر ويُفوَّض الحكم (الزمر 46).\n4. الأزواج والذرية امتدادٌ لفعل الفطر (الشورى 11).","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- في استفتاح قيام الليل.\n- عند اشتباه الحق في مسألةٍ مختلف فيها.\n- عند بلوغ قمة نجاحك (دعاء يوسف).","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. استفتاح التهجد: «اللَّهُمَّ رَبَّ جِبْرَائِيلَ وَمِيكَائِيلَ وَإِسْرَافِيلَ فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ... اهْدِنِي لِمَا اخْتُلِفَ فِيهِ مِنَ الْحَقِّ» — رواه مسلم.\n2. دعاء يوسف في التمكين — يوسف 101.\n3. تفويض الحكم في الخلافات — الزمر 46.","summary":"نادِ من فطر السماوات والأرض على غير مثال: هو معيار الولي، وهو من يُفصل عنده الخلاف — وبه استفتح نبيك قيامه.","verses":[{"i":1,"of":4,"s":6,"surah":"الأنعام","a":14,"text":"قُلْ أَغَيْرَ اللَّهِ أَتَّخِذُ وَلِيًّا فَاطِرِ السَّمَاوَاتِ وَالْأَرْضِ وَهُوَ يُطْعِمُ وَلَا يُطْعَمُ قُلْ إِنِّي أُمِرْتُ أَنْ أَكُونَ أَوَّلَ مَنْ أَسْلَمَ وَلَا تَكُونَنَّ مِنَ الْمُشْرِكِينَ","prev":{"a":13,"text":"وَلَهُ مَا سَكَنَ فِي اللَّيْلِ وَالنَّهَارِ وَهُوَ السَّمِيعُ الْعَلِيمُ"},"next":{"a":15,"text":"قُلْ إِنِّي أَخَافُ إِنْ عَصَيْتُ رَبِّي عَذَابَ يَوْمٍ عَظِيمٍ"},"reason":"معيارُ الولي في وصفين: فاطرٌ ينشئ من عدم، ويطعم ولا يُطعَم — يعطي بلا مقابل؛ فكل وليٍّ سواه إما عاجزٌ عن الإنشاء أو محتاجٌ إلى ما يأخذه منك.","adds":"اختبر كل جهةٍ تطلب ولاءك: ماذا أنشأت؟ وهل تعطيك بلا مقابل؟"},{"i":2,"of":4,"s":12,"surah":"يوسف","a":101,"text":"رَبِّ قَدْ آتَيْتَنِي مِنَ الْمُلْكِ وَعَلَّمْتَنِي مِنْ تَأْوِيلِ الْأَحَادِيثِ فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ أَنْتَ وَلِيِّي فِي الدُّنْيَا وَالْآخِرَةِ تَوَفَّنِي مُسْلِمًا وَأَلْحِقْنِي بِالصَّالِحِينَ","prev":{"a":100,"text":"وَرَفَعَ أَبَوَيْهِ عَلَى الْعَرْشِ وَخَرُّوا لَهُ سُجَّدًا وَقَالَ يَا أَبَتِ هَذَا تَأْوِيلُ رُؤْيَايَ مِنْ قَبْلُ قَدْ جَعَلَهَا رَبِّي حَقًّا وَقَدْ أَحْسَنَ بِي إِذْ أَخْرَجَنِي مِنَ السِّجْنِ وَجَاءَ بِكُمْ مِنَ الْبَدْوِ مِنْ بَعْدِ أَنْ نَزَغَ الشَّيْطَانُ بَيْنِي وَبَيْنَ إِخْوَتِي إِنَّ رَبِّي لَطِيفٌ لِمَا يَشَاءُ إِنَّهُ هُوَ الْعَلِيمُ الْحَكِيمُ"},"next":{"a":102,"text":"ذَلِكَ مِنْ أَنْبَاءِ الْغَيْبِ نُوحِيهِ إِلَيْكَ وَمَا كُنْتَ لَدَيْهِمْ إِذْ أَجْمَعُوا أَمْرَهُمْ وَهُمْ يَمْكُرُونَ"},"context":"يوسف في قمة التمكين: ﴿فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ أَنْتَ وَلِيِّي فِي الدُّنْيَا وَالْآخِرَةِ تَوَفَّنِي مُسْلِمًا وَأَلْحِقْنِي بِالصَّالِحِينَ﴾.","reason":"نادى يوسفُ ربَّه بالفاطر في ذروة نجاحه: من فطر السماوات والأرض هو من فطر هذه القصة من عدم — جبٌّ ورقٌّ وسجنٌ ثم ملك؛ فالنداء بالفاطر إقرارٌ بأن حياته كلها صناعتُه.","adds":"عند اكتمال النعمة نادِ الفاطر واسأل الخاتمة — لا المزيد: ﴿تَوَفَّنِي مُسْلِمًا﴾."},{"i":3,"of":4,"s":14,"surah":"إبراهيم","a":10,"text":"قَالَتْ رُسُلُهُمْ أَفِي اللَّهِ شَكٌّ فَاطِرِ السَّمَاوَاتِ وَالْأَرْضِ يَدْعُوكُمْ لِيَغْفِرَ لَكُمْ مِنْ ذُنُوبِكُمْ وَيُؤَخِّرَكُمْ إِلَى أَجَلٍ مُسَمًّى قَالُوا إِنْ أَنْتُمْ إِلَّا بَشَرٌ مِثْلُنَا تُرِيدُونَ أَنْ تَصُدُّونَا عَمَّا كَانَ يَعْبُدُ آبَاؤُنَا فَأْتُونَا بِسُلْطَانٍ مُبِينٍ","prev":{"a":9,"text":"أَلَمْ يَأْتِكُمْ نَبَأُ الَّذِينَ مِنْ قَبْلِكُمْ قَوْمِ نُوحٍ وَعَادٍ وَثَمُودَ وَالَّذِينَ مِنْ بَعْدِهِمْ لَا يَعْلَمُهُمْ إِلَّا اللَّهُ جَاءَتْهُمْ رُسُلُهُمْ بِالْبَيِّنَاتِ فَرَدُّوا أَيْدِيَهُمْ فِي أَفْوَاهِهِمْ وَقَالُوا إِنَّا كَفَرْنَا بِمَا أُرْسِلْتُمْ بِهِ وَإِنَّا لَفِي شَكٍّ مِمَّا تَدْعُونَنَا إِلَيْهِ مُرِيبٍ"},"next":{"a":11,"text":"قَالَتْ لَهُمْ رُسُلُهُمْ إِنْ نَحْنُ إِلَّا بَشَرٌ مِثْلُكُمْ وَلَكِنَّ اللَّهَ يَمُنُّ عَلَى مَنْ يَشَاءُ مِنْ عِبَادِهِ وَمَا كَانَ لَنَا أَنْ نَأْتِيَكُمْ بِسُلْطَانٍ إِلَّا بِإِذْنِ اللَّهِ وَعَلَى اللَّهِ فَلْيَتَوَكَّلِ الْمُؤْمِنُونَ"},"reason":"استنكارٌ في صيغة سؤال: أفي الله شك — وهو فاطر السماوات والأرض؟ ثم بيانُ غاية دعوته: المغفرة؛ فالفاطرُ لا يدعوكم لحاجةٍ بل ليغفر لكم. جمعت الآيةُ عظمةَ الخالق ولطفَ الغاية.","adds":"غايةُ دعوته لك مذكورة: ﴿يَدْعُوكُمْ لِيَغْفِرَ لَكُمْ﴾ — يدعوك ليغفر لا ليأخذ."},{"i":4,"of":4,"s":42,"surah":"الشورى","a":11,"text":"فَاطِرُ السَّمَاوَاتِ وَالْأَرْضِ جَعَلَ لَكُمْ مِنْ أَنْفُسِكُمْ أَزْوَاجًا وَمِنَ الْأَنْعَامِ أَزْوَاجًا يَذْرَؤُكُمْ فِيهِ لَيْسَ كَمِثْلِهِ شَيْءٌ وَهُوَ السَّمِيعُ الْبَصِيرُ","prev":{"a":10,"text":"وَمَا اخْتَلَفْتُمْ فِيهِ مِنْ شَيْءٍ فَحُكْمُهُ إِلَى اللَّهِ ذَلِكُمُ اللَّهُ رَبِّي عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ أُنِيبُ"},"next":{"a":12,"text":"لَهُ مَقَالِيدُ السَّمَاوَاتِ وَالْأَرْضِ يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ وَيَقْدِرُ إِنَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ"},"reason":"قُرن فطرُ السماوات والأرض بجعل الأزواج: فمنظومةُ التكاثر جزءٌ من الفطر الأول — وخُتم بقاعدة التنزيه: ﴿لَيْسَ كَمِثْلِهِ شَيْءٌ﴾؛ فالفاطرُ لا يشبه ما فطر.","adds":"عائلتك امتدادٌ لفعل الفطر الأول: ﴿يَذْرَؤُكُمْ فِيهِ﴾ — يكثّركم بهذا الزواج."}],"hadiths":[{"i":1,"of":1,"text":"قالَ أبو بَكْرٍ رضيَ اللَّهُ عنهُ : يا رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ علِّمني شيئًا أقولُهُ إذا أصبحتُ ، وإذا أمسيتُ ، وإذا أخذتُ مَضجَعي . قالَ : قل : اللَّهُمَّ فاطرَ السَّمواتِ والأَرضِ ، عالِمَ الغَيبِ والشَّهادةِ - أو قالَ : اللَّهمَّ عالمَ الغيبِ والشَّهادةِ ، فاطرَ السَّمواتِ والأرضِ - رَبَّ كلِّ شيءٍ ومليكَهُ ، أشهدُ أن لا إلَهَ إلَّا أنتَ ، أعوذُ بِكَ من شرِّ نَفسي ، وشرِّ الشَّيطانِ وشِركِهِ","narrator":"أبو هريرة","source":"تخريج المسند لشاكر 1/43","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/L4uG4ly0","nameForm":"فاطرَ السَّمواتِ والأرضِ","scene":"أبو بكر: يا رسول الله علّمني شيئًا أقوله إذا أصبحت وإذا أمسيت وإذا أخذت مضجعي. قال: «قل: اللهم فاطر السماوات والأرض، عالم الغيب والشهادة، رب كل شيء ومليكه، أشهد أن لا إله إلا أنت، أعوذ بك من شر نفسي وشر الشيطان وشركه».","reason":"أول الذكر «فاطر السماوات والأرض»: من فطر الكون يُستعاذ به من النفس والشيطان — أصغر ما فيه يُردّ إلى فاطر أكبره.","adds":"يعطي الاسم موضع الافتتاح في ذكر الطرفين والمضجع."}],"sunnah":{"card":"الصيغة: فَاطِرُ السَّمَاوَاتِ وَالْأَرْضِ — مركّبة\nفي السنة: شاهد واحد (رواية واحدة)\nخصوصية الورود في السنة: أول ذكر الصباح والمساء والمضجع الذي علّمه النبي ﷺ أبا بكر: «اللهم فاطر السماوات والأرض، عالم الغيب والشهادة، رب كل شيء ومليكه…».","teaches":"1. أن فاطر الكون يُستعاذ به من النفس والشيطان.","whenRecall":"- صباحًا ومساءً وعند المضجع.","whenPray":"عند الشعور بـ:\n1. الخوف من النفس.\nعند طلب:\n1. الحفظ من الشيطان وشركه.\nعند الرغبة في:\n1. ذكر أبي بكر.","duaItems":"«اللهم فاطر السماوات والأرض، عالم الغيب والشهادة، رب كل شيء ومليكه، أشهد أن لا إله إلا أنت، أعوذ بك من شر نفسي وشر الشيطان وشركه» — تخريج المسند 1/43 (إسناده صحيح).","summary":"«فاطر السماوات والأرض» في السنة مفتتح ذكر الصباح والمساء والمضجع الذي علّمه النبي ﷺ أبا بكر."},"situations":[{"situationId":51,"verses":[{"i":4,"strength":"direct","headline":"تأخر الزواج أو الذرية وطول انتظارهما","bridge":"تنتظر زواجًا أو ذرية؟ منظومة التكاثر جزءٌ من الفطر الأول: ﴿فَاطِرُ السَّمَاوَاتِ وَالْأَرْضِ جَعَلَ لَكُمْ مِنْ أَنْفُسِكُمْ أَزْوَاجًا وَمِنَ الْأَنْعَامِ أَزْوَاجًا يَذْرَؤُكُمْ فِيهِ﴾ — الذي فطر السماوات هو الذي جعل الأزواج ويذرأ بها الذرية؛ فاطلب زوجك وولدك ممن جعل نظام الأزواج نفسه."}],"hadiths":[]},{"situationId":104,"verses":[{"i":3,"strength":"direct","headline":"وسوسةٌ بالشك في وجود الله","bridge":"يوسوس إليك شكٌّ في الله نفسه؟ الرسل ردّوا بسؤالٍ يستنكر: ﴿أَفِي اللَّهِ شَكٌّ فَاطِرِ السَّمَاوَاتِ وَالْأَرْضِ يَدْعُوكُمْ لِيَغْفِرَ لَكُمْ مِنْ ذُنُوبِكُمْ﴾ — فاطر السماوات والأرض لا يُشك فيه، وغاية دعوته لك مذكورة: ليغفر لك لا ليأخذ منك؛ فردّ الوسوسة بالسؤال نفسه: أفي الفاطر شك؟"}],"hadiths":[]},{"situationId":128,"verses":[{"i":1,"strength":"direct","headline":"تعلّق القلب بجهةٍ تطلب ولاءك وتأخذ منك","bridge":"تختبر جهةً تطلب ولاءك؟ اسألها سؤالين من الآية: ﴿قُلْ أَغَيْرَ اللَّهِ أَتَّخِذُ وَلِيًّا فَاطِرِ السَّمَاوَاتِ وَالْأَرْضِ وَهُوَ يُطْعِمُ وَلَا يُطْعَمُ﴾ — ماذا أنشأت؟ وهل تعطيك بلا مقابل؟ فكل وليٍّ سوى الفاطر إما عاجزٌ عن الإنشاء أو محتاجٌ إلى ما يأخذه منك."}],"hadiths":[]},{"situationId":147,"verses":[{"i":2,"strength":"direct","headline":"اكتمال النعمة واجتماع الشمل بعد طول الفرقة","bridge":"كُشف عنك ما كنت تخافه واجتمع شملك؟ يوسف بعد اجتماع الشمل لم يسكر بالفرح بل قال: ﴿رَبِّ قَدْ آتَيْتَنِي مِنَ الْمُلْكِ... فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ أَنْتَ وَلِيِّي﴾ — نسب القصة كلها إلى فاطرها؛ فبعد الفرج انسب النعمة إلى من فطرها من عدم."}],"hadiths":[]},{"situationId":156,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"الحاجة إلى وردٍ جامعٍ للصباح والمساء والنوم","bridge":"وردك صباحًا ومساءً وعند النوم؟ علّم النبي ﷺ أبا بكر: «اللهم فاطر السماوات والأرض، عالم الغيب والشهادة، رب كل شيء ومليكه… أعوذ بك من شر نفسي وشر الشيطان وشركه»."}]}]},{"id":169,"name":"رب هذا البيت","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: رَبَّ هَذَا الْبَيْتِ — مضافة | المواضع: 1 (قريش: 3)\nخصوصية: أقصرُ سورةٍ تحوي اسمًا مضافًا إلى مكان — وفيها ربطُ العبادة بالنعمة الاقتصادية والأمنية.\n\nالمعنى:\n- رب هذا البيت: مالكُ الكعبة ومدبّرُ شأنها ومانحُ بركاتها لأهلها.","teaches":"الحقائق التي كشفها الموضع:\n1. النعمة توجب العبادة لا الاستغناء.\n2. الطعام والأمن أعظم نعم المجتمعات.\n3. البركة من ربّ المكان لا من المكان.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند شبعك وأمنك: أنت في نعمتَي السورة.\n- عند رؤية الكعبة أو الحج.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. شكر نعمتي الطعام والأمن — قريش 4.\n2. من السنة: «مَنْ أَصْبَحَ مِنْكُمْ آمِنًا فِي سِرْبِهِ، مُعَافًى فِي جَسَدِهِ، عِنْدَهُ قُوتُ يَوْمِهِ، فَكَأَنَّمَا حِيزَتْ لَهُ الدُّنْيَا» — الترمذي وحسّنه.\n3. الدعاء لبلد الله الحرام وأهله بالأمن.","summary":"أُطعمتَ من جوعٍ وأُمنتَ من خوف — فما الذي يبقى؟ ﴿فَلْيَعْبُدُوا رَبَّ هَذَا الْبَيْتِ﴾.","verses":[{"i":1,"of":1,"s":106,"surah":"قريش","a":3,"text":"فَلْيَعْبُدُوا رَبَّ هَذَا الْبَيْتِ","prev":{"a":2,"text":"إِيلَافِهِمْ رِحْلَةَ الشِّتَاءِ وَالصَّيْفِ"},"next":{"a":4,"text":"الَّذِي أَطْعَمَهُمْ مِنْ جُوعٍ وَآمَنَهُمْ مِنْ خَوْفٍ"},"context":"﴿لِإِيلَافِ قُرَيْشٍ * إِيلَافِهِمْ رِحْلَةَ الشِّتَاءِ وَالصَّيْفِ * فَلْيَعْبُدُوا رَبَّ هَذَا الْبَيْتِ * الَّذِي أَطْعَمَهُمْ مِنْ جُوعٍ وَآمَنَهُمْ مِنْ خَوْفٍ﴾.","reason":"بُنيت الدعوةُ إلى العبادة على نعمتين مشهودتين: إطعامٌ من جوع وأمنٌ من خوف — وهما ما تسعى إليه كل دولةٍ اليوم؛ ونُسبت النعمةُ إلى «رب هذا البيت» لا إلى البيت نفسه: فالمكانُ مبارك بربه لا بذاته.","adds":"أعظمُ نعمتين على أي مجتمع: الطعام والأمن — وهما موجبتان للعبادة لا للاستغناء."}],"hadiths":[{"i":1,"of":6,"text":"عَنِ ابْنِ عَبَّاسٍ وَعَبْدِ اللَّهِ بْنِ مَسْعُودٍ، وَأُنَاسٍ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ، \"إنَّ اللهَ أوْحى إلى موسَى بنِ عِمْرانَ أنِّي مُتوَفٍّ هارونَ، فأْتِ به جبَلَ كذا وكذا، فانطَلَقَ موسَى وهارونُ نحوَ ذلك الجبَلِ، فإذا هُم فيه بشَجَرةٍ فلم يَرَ شَجرةً مِثلَها، وإذا هُم ببَيتٍ مَبنيٍّ، وإذا هُم فيه بسَريرٍ عليه فُرُشٌ، وإذا فيه ريحٌ طيِّبٌ، فلمَّا نظَرَ هارونُ إلى ذلك الجبَلِ والبَيتِ وما فيه أعجَبَه، قالَ: يا موسَى، إنِّي لَأُحِبُّ أنْ أنامَ على هذا السَّريرِ، قالَ له موسَى: فنَمْ عليه، قالَ: إنِّي أخافُ أنْ يأْتيَ ربُّ هذا البَيتِ فيغضَبَ علَيَّ، قالَ له موسَى: لا تَرهَبْ؛ أنا أكْفيكَ ربَّ هذا البَيتِ، فنَمْ، فقالَ: يا موسَى، بل نَمْ مَعي، فإنْ جاءَ ربُّ هذا البَيتِ غضِبَ عليَّ وعليكَ جَميعًا، فلمَّا نامَا أخَذَ هارونَ المَوتُ، فلمَّا وجَدَ حِسَّه، قالَ: يا موسَى، خَدَعتَني، فلمَّا قُبِض رُفِعَ ذلك البَيتُ وذهبَتْ تلك الشَّجرةُ، ورُفِعَ السَّريرُ إلى السَّماءِ، فلمَّا رجَعَ موسَى إلى بَني إسْرائيلَ وليس معَه هارونُ، قالوا: إنَّ موسَى قتَلَ هارونَ وحسَدَه حُبَّ بَني إسْرائيلَ له، وكان هارونُ آلَفَ عندَهم وأليَنَ لهُم من موسَى، كانَ في موسَى بَعضُ الغِلَظِ عليهم، فلمَّا بلَغَه ذلك، قالَ لهُم: وَيْحَكم! إنَّه كان أخي، أفتَرَوْني أقتُلُه؟! فلمَّا أكْثَروا عليه قامَ فصَلَّى رَكعَتَينِ، ثمَّ دَعا اللهَ فنزَلَ بالسَّريرِ حتَّى نَظَروا إليه بيْنَ السَّماءِ والأرْضِ فصَدَّقوه.","narrator":"أبو مالك ومرة الهمداني","source":"المستدرك على الصحيحين 4160","grade":"صحيح","judgment":"صحيح على شرط مسلم","url":"https://dorar.net/h/DpAvYLSF","nameForm":"ربُّ هذا البَيتِ ؛ ربَّ هذا البَيتِ ؛ ربُّ هذا البَيتِ","scene":"ابن عباس وابن مسعود: أوحى الله إلى موسى أني متوفٍّ هارون، فأتى به جبلًا فيه بيتٌ وسرير، فأعجب هارون فقال: إني لأحب أن أنام على هذا السرير، قال: نم. قال: إني أخاف أن يأتي رب هذا البيت فيغضب عليّ. قال موسى: أنا أكفيك رب هذا البيت. فقال: بل نم معي فإن جاء رب هذا البيت غضب علينا جميعًا — فناما، فقُبض هارون.","reason":"«رب البيت» في قصة هارون معناه صاحب البيت الذي يُخاف غضبه: نبيٌّ يخاف أن يستعمل ما ليس له — فالمعنى العام للاسم: صاحب البيت الذي لا يُدخل بيته إلا بإذنه.","adds":"يُري لفظ الاسم في قصة موت هارون بمعناه اللغوي."},{"i":2,"of":6,"text":"عَن أسماءَ بنتِ أبي بَكرٍ، قالت: لَمَّا نَزَلَت: {تَبَّت يَدا أبي لَهَبٍ وتَبَّ} [المسد: 1] أقبَلَتِ العَوراءُ أُمُّ جَميلٍ بنتُ حَربٍ -ولَها ولولةٌ، وفي يَدِها فِهرٌ- وهيَ تَقولُ: [مِن مُجَزَّأِ الرَّجَزِ] مُذَمَّمًا أبَينا ودينَه قَلَينا وأمرَه عَصَينا. والنَّبيُّ صلَّى اللهُ عليه وسلَّم جالِسٌ في المَسجِدِ -ومَعَه أبو بَكرٍ- فلَمَّا رَآها أبو بَكرٍ قال: يا رَسولَ اللَّهِ، قد أقبَلَت وأنا أخافُ أن تَراكَ. فقال [رَسولُ اللَّهِ صلَّى اللهُ عليه وسلَّم]: (إنَّها لَن تَراني). وقَرَأ قُرآنًا فاعتَصَمَ به كما قال تَعالى: {وإذا قَرَأتَ القُرآنَ جَعَلنا بَينَكَ وبَينَ الذينَ لا يُؤمِنونَ بالآخِرةِ حِجابًا مَستورًا} [الإسراء: 45]، فوقَفَت على أبي بَكرٍ، ولَم تَرَ رَسولَ اللَّهِ صلَّى اللهُ عليه وسلَّم، فقالت: يا أبا بَكرٍ، (ألَم أُخبَرْ أنَّ (صاحِبَكَ) هَجاني؟ فقال: لا، ورَبِّ هذا البَيتِ ما هَجاكِ. فولَّت وهيَ تَقولُ: قد عَلِمَت قُرَيشٌ أنِّي ابنةُ سَيِّدِها.","narrator":"أسماء بنت أبي بكر","source":"مسند أبي بكر الصديق 591","grade":"صحيح","url":"https://dorar.net/h/My28swtQ","nameForm":"ورَبِّ هذا البَيتِ","scene":"أسماء: لما نزلت تبت جاءت أم جميل ولها ولولة وفي يدها فهر تقول شعرًا، فوقفت على أبي بكر ولم تر النبي ﷺ فقالت: ألم أُخبر أن صاحبك هجاني؟ فقال: «لا، ورب هذا البيت ما هجاك».","reason":"أبو بكر يحلف بالاسم عند الكعبة صادقًا: النبي ﷺ لم يهجها بل هجاها الله — فالقسم برب البيت عند بيته.","adds":"يُري القسم بالاسم في موقف حماية النبي ﷺ."},{"i":3,"of":6,"text":"«فضَّلَ اللهُ قريشًا بسبعِ خِلالٍ: أنِّي فيهم وأنَّ النُّبوَّةَ فيهم، والحِجابةَ فيهم، والسِّقايَةَ فيهم، وأنَّ اللهَ نَصَرَهُم على الفيلِ، وأنَّهم عَبدوا اللهَ عشْرَ سنينَ لا يَعبدُهُ غيرُهُم، وأنَّ اللهَ أَنزلَ فيهم سورةً مِنَ القرآنِ»، ثُمَّ تلاها رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: بِسمِ اللهِ الرَّحمنِ الرَّحيمِ {لِإِيلَافِ قُرَيْشٍ (1) إِيلَافِهِمْ رِحْلَةَ الشِّتَاءِ وَالصَّيْفِ (2) فَلْيَعْبُدُوا رَبَّ هَذَا الْبَيْتِ (3) الَّذِي أَطْعَمَهُمْ مِنْ جُوعٍ وَآمَنَهُمْ مِنْ خَوْفٍ} [قريش: 1 - 4].","narrator":"أم هانئ بنت أبي طالب","source":"المستدرك على الصحيحين 4023","grade":"صحيح","judgment":"صحيح الإسناد","url":"https://dorar.net/h/wmco5jpy","nameForm":"رَبَّ هَذَا الْبَيْتِ","scene":"«فضّل الله قريشًا بسبع خلال… وأنزل فيهم سورة» ثم تلا: ﴿لِإِيلَافِ قُرَيْشٍ * إِيلَافِهِمْ رِحْلَةَ الشِّتَاءِ وَالصَّيْفِ * فَلْيَعْبُدُوا رَبَّ هَذَا الْبَيْتِ * الَّذِي أَطْعَمَهُم مِّن جُوعٍ وَآمَنَهُم مِّنْ خَوْفٍ﴾.","reason":"أمر العبادة معلل بالبيت الذي آمنهم وأطعمهم: يُعبد رب البيت لأن بيته سبب أمنهم ورزقهم.","adds":"يربط الاسم بفضل قريش وسورتهم."},{"i":4,"of":6,"text":"عنْ أبي هريرةَ يقولُ وربِّ هذا البيتِ ما أنا نُهِيتُ عن صيامِ يومِ الجمعةِ ولكن محمدٌ نَهى عنه وربُّ هذا البيتِ ما أنا قلت من أدركَه الصبحَ جُنُبا فليفطرْ ولكن رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ قالَه","narrator":"عبدالله بن عمرو القاري","source":"تخريج المسند لشاكر 14/233","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/INq5MGQ2","nameForm":"وربِّ هذا البيتِ ؛ وربُّ هذا البيتِ","scene":"أبو هريرة: «ورب هذا البيت ما أنا نُهيت عن صيام يوم الجمعة ولكن محمد ﷺ نهى عنه، ورب هذا البيت ما أنا قلت: من أدركه الصبح جنبًا فليفطر ولكن رسول الله ﷺ قاله».","reason":"القسم بالاسم لتوثيق الرواية: أبو هريرة يحلف عند البيت أن الحكم عن النبي ﷺ لا عن رأيه.","adds":"يُري الاسم قسمًا في نسبة الحديث."},{"i":5,"of":6,"text":"عن عبدِ اللَّهِ بنِ الزُّبيرِ أنَّهُ قال وهوَ على المنبرِ وربِّ هذا البيتِ الحرامِ والبلدِ الحرامِ إنَّ الحَكمَ بنَ أبي العاصِ وولدَه ملعونونَ على لسانِ محمد صلَّى اللَّهُ عليهِ وسلَّم","narrator":"عبدالله بن الزبير","source":"تاريخ دمشق 57/271","grade":"صحيح","judgment":"محفوظ","url":"https://dorar.net/h/AcRW3f3I","nameForm":"وربِّ هذا البيتِ","scene":"ابن الزبير وهو على المنبر: «ورب هذا البيت الحرام والبلد الحرام إن الحكم بن أبي العاص وولده ملعونون على لسان محمد ﷺ».","reason":"قسمٌ بالاسم في أخطر مقام: إخبار عن لعن نبوي — يُوثّق بالقسم عند البيت.","adds":"يُظهر شدة القسم بالاسم في المنبر."},{"i":6,"of":6,"text":"نهى عن صيامِ يومِ الجمُعةِ [يعني حديث: سألتُ جابرَ بنَ عبدِ اللهِ، وأنا أطوفُ بالبيتِ : أنَهى النَّبيُّ صلَّى الله عليْهِ وسلَّمَ عن صيامِ يومِ الجمعةِ ؟ قالَ : نعم، وربِّ هذا البيت.]","narrator":"جابر بن عبدالله","source":"صحيح الجامع 6963","grade":"صحيح","url":"https://dorar.net/h/NJPHr047","nameForm":"وربِّ هذا البيت","scene":"جابر — وسائله يطوف بالبيت: أنهى النبي ﷺ عن صيام يوم الجمعة؟ قال: «نعم، ورب هذا البيت».","reason":"الجواب في الطواف يُقسم فيه برب البيت الذي يُطاف به.","adds":"يُبيّن القسم بالاسم في موضعه: الطواف."}],"sunnah":{"card":"الصيغة: رَبُّ هَذَا الْبَيْتِ — مركّبة، من سورة قريش\nفي السنة: 6 شواهد (8 روايات)\nخصوصية الورود في السنة: الاسم قَسَمٌ عند الصحابة: «ورب هذا البيت» يقولها أبو بكر وأبو هريرة وجابر وابن الزبير مستندًا إلى الكعبة؛ وفي سورة قريش التي تلاها النبي ﷺ في فضل قريش؛ وفي قصة هارون حين خاف من رب البيت الذي وُضع له فيه سرير.\nالمعنى المختصر: رب الكعبة ومالكها الذي أطعم أهلها من جوع وآمنهم من خوف.","teaches":"1. أنه رب الكعبة الذي أطعم وآمن، فيُعبد.\n2. أن الصحابة كانوا يحلفون به عند بيته صادقين.\n3. أن رب البيت يُخاف غضبه في بيته — كما خاف هارون.","whenRecall":"- في الطواف.\n- حين تقسم على حديث.\n- في سورة قريش.","whenPray":"عند الشعور بـ:\n1. الجوع والخوف.\nعند طلب:\n1. الأمن والطعام كما أُعطيت قريش.\nعند الرغبة في:\n1. أن تحلف صادقًا برب البيت.","duaItems":"لا صيغة منصوصة؛ وتُتلى سورة قريش.","summary":"«رب هذا البيت» في السنة قسمُ الصحابة عند الكعبة: أبو بكر وأبو هريرة وجابر وابن الزبير — والاسم في سورة قريش التي فُضّلوا بها."},"situations":[{"situationId":41,"verses":[],"hadiths":[{"i":3,"strength":"direct","headline":"الخوف على الرزق والأمن ونسيان مصدرهما","bridge":"تخاف على طعامك وأمنك؟ ﴿فَلْيَعْبُدُوا رَبَّ هَذَا الْبَيْتِ * الَّذِي أَطْعَمَهُم مِّن جُوعٍ وَآمَنَهُم مِّنْ خَوْفٍ﴾ — الطعام والأمن من رب البيت لا من الرحلتين."}]},{"situationId":47,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"التورع عن استعمال ما ليس لك بغير إذن صاحبه","bridge":"تريد أن تعرف كيف يخاف نبيٌّ صاحب البيت؟ في خبر موت هارون: أُتي به جبلًا فيه بيتٌ وسرير فأعجبه فقال: إني لأحب أن أنام على هذا السرير، ثم قال: إني أخاف أن يأتي رب هذا البيت فيغضب عليّ — نبيٌّ يخاف أن يستعمل ما ليس له؛ فصاحب البيت لا يُدخل بيته إلا بإذنه."}]},{"situationId":61,"verses":[],"hadiths":[{"i":2,"strength":"direct","headline":"الدفاع عمّن تحب حين يُسأل عنه ليُكاد له","bridge":"تُسأل عمّن تحب ليُوقَع به؟ أقسم أبو بكر لأم جميل: «لا، ورب هذا البيت ما هجاك» — القسم برب البيت صادقًا في حماية الحق."},{"i":4,"strength":"direct","headline":"الحاجة إلى توثيق كلامك بالقسم ونفي التقوّل","bridge":"تريد أن توثّق كلامك بقسم؟ أبو هريرة: «ورب هذا البيت ما أنا نُهيت عن صيام يوم الجمعة ولكن محمد ﷺ نهى عنه، ورب هذا البيت ما أنا قلت: من أدركه الصبح جنبًا فليفطر ولكن رسول الله ﷺ قاله» — القسم بالاسم لتوثيق النسبة: يحلف عند البيت أن الحكم عن النبي ﷺ لا عن رأيه."},{"i":5,"strength":"direct","headline":"الحلف على أمرٍ خطير أمام الناس","bridge":"تحلف على أمرٍ خطير أمام الناس؟ ابن الزبير وهو على المنبر: «ورب هذا البيت الحرام والبلد الحرام إن الحكم بن أبي العاص وولده ملعونون على لسان محمد ﷺ» — قسمٌ بالاسم في أخطر مقام يُوثَّق برب البيت؛ فلا تحلف بمثله إلا على مثله."},{"i":6,"strength":"direct","headline":"تأكيد حكمٍ شرعيٍّ بالقسم حين تُسأل عنه","bridge":"تُسأل وأنت تطوف فتريد أن تؤكد؟ سُئل جابر وسائله يطوف بالبيت: أنهى النبي ﷺ عن صيام يوم الجمعة؟ قال: «نعم، ورب هذا البيت» — الجواب في الطواف يُقسم فيه برب البيت الذي يُطاف به؛ فالقسم في موضعه."}]},{"situationId":143,"verses":[{"i":1,"strength":"direct","headline":"التنعّم بالأمن والرزق مع الغفلة عن شكرهما","bridge":"أنت في طعامٍ وأمن؟ هاتان أعظم نعمتين على أي مجتمع وبهما بُنيت الدعوة إلى العبادة: ﴿فَلْيَعْبُدُوا رَبَّ هَذَا الْبَيْتِ * الَّذِي أَطْعَمَهُمْ مِنْ جُوعٍ وَآمَنَهُمْ مِنْ خَوْفٍ﴾ — ما تسعى إليه كل دولةٍ اليوم أعطيتَه؛ فهما موجبتان للعبادة لا للاستغناء."}],"hadiths":[]}]},{"id":170,"name":"قريب مجيب","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: قَرِيبٌ مُجِيبٌ — مركّبة | المواضع: 1 (هود: 61)\nخصوصية: الاقتران الوحيد بين القرب والإجابة — على لسان صالح لثمود، في سياق الاستعمار في الأرض.\n\nالمعنى:\n- القريب: القريب من عباده بعلمه وإجابته.\n- المجيب: الذي يجيب دعاء الداعي.\nسر الاقتران: قربٌ يُلغي المسافة + إجابةٌ تحقق الطلب — فلا حاجب ولا تأخير.","teaches":"الحقائق التي كشفها الموضع:\n1. عمارة الأرض تكليفٌ لا مجرد إباحة.\n2. القرب والإجابة صفتان تلغيان كل حاجةٍ لوسيط.\n3. الاستغفار ثم التوبة: ترتيبٌ يتكرر في دعوات الرسل.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند الشعور بالبعد عن الله.\n- عند العمل في عمارة الأرض والبناء.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. الاستغفار ثم التوبة: ﴿فَاسْتَغْفِرُوهُ ثُمَّ تُوبُوا إِلَيْهِ إِنَّ رَبِّي قَرِيبٌ مُجِيبٌ﴾ — هود 61.\n2. ﴿وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ﴾ — البقرة 186.\n3. سؤال التوفيق في عمارة الأرض.","summary":"﴿إِنَّ رَبِّي قَرِيبٌ مُجِيبٌ﴾ — قربٌ بلا مسافة وإجابةٌ بلا وسيط: فاستغفره وتب إليه وأنت تعمر أرضه.","verses":[{"i":1,"of":1,"s":11,"surah":"هود","a":61,"text":"وَإِلَى ثَمُودَ أَخَاهُمْ صَالِحًا قَالَ يَا قَوْمِ اعْبُدُوا اللَّهَ مَا لَكُمْ مِنْ إِلَهٍ غَيْرُهُ هُوَ أَنْشَأَكُمْ مِنَ الْأَرْضِ وَاسْتَعْمَرَكُمْ فِيهَا فَاسْتَغْفِرُوهُ ثُمَّ تُوبُوا إِلَيْهِ إِنَّ رَبِّي قَرِيبٌ مُجِيبٌ","prev":{"a":60,"text":"وَأُتْبِعُوا فِي هَذِهِ الدُّنْيَا لَعْنَةً وَيَوْمَ الْقِيَامَةِ أَلَا إِنَّ عَادًا كَفَرُوا رَبَّهُمْ أَلَا بُعْدًا لِعَادٍ قَوْمِ هُودٍ"},"next":{"a":62,"text":"قَالُوا يَا صَالِحُ قَدْ كُنْتَ فِينَا مَرْجُوًّا قَبْلَ هَذَا أَتَنْهَانَا أَنْ نَعْبُدَ مَا يَعْبُدُ آبَاؤُنَا وَإِنَّنَا لَفِي شَكٍّ مِمَّا تَدْعُونَا إِلَيْهِ مُرِيبٍ"},"context":"صالحٌ لثمود: ﴿هُوَ أَنْشَأَكُمْ مِنَ الْأَرْضِ وَاسْتَعْمَرَكُمْ فِيهَا فَاسْتَغْفِرُوهُ ثُمَّ تُوبُوا إِلَيْهِ إِنَّ رَبِّي قَرِيبٌ مُجِيبٌ﴾.","reason":"بُنيت الدعوة على حقيقتين: الإنشاءُ من الأرض والاستعمارُ فيها — أي التكليف بعمارتها — ثم الاستغفار والتوبة، وعُلّل بالاسمين: قريبٌ لا يحتاج وسيطًا، مجيبٌ لا يردّ الطالب. فالعمارةُ مهمة، والرجوعُ إليه سهل.","adds":"﴿وَاسْتَعْمَرَكُمْ فِيهَا﴾ — عمارةُ الأرض تكليفٌ شرعي: فالبناء والإصلاح والزراعة عبادةٌ لا تشغلك عن الاستغفار."}],"hadiths":[{"i":1,"of":1,"text":"عن أبي موسى أنَّهم كانوا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في سَفرٍ، فرَفَعوا أصْواتَهم بالدُّعاءِ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّكم لا تَدعونَ أصَمَّ ولا غائبًا، إنَّكم تَدعونَ قَريبًا مُجيبًا يَسمَعُ دُعاءَكم ويَستجيبُ، ثُمَّ قال: يا عبدَ اللهِ بنَ قَيسٍ -أو: يا أبا موسى- ألَا أدُلُّكَ على كَنزٍ مِن كُنوزِ الجنَّةِ؟ لا حَولَ ولا قوَّةَ إلَّا باللهِ.","narrator":"أبو موسى الأشعري","source":"تخريج المسند لشعيب 19605","grade":"صحيح","judgment":"إسناده صحيح على شرط الشيخين","url":"https://dorar.net/h/6yNQh92p","nameForm":"قَريبًا مُجيبًا","scene":"أبو موسى: رفعوا أصواتهم بالدعاء في السفر، فقال النبي ﷺ: «إنكم لا تدعون أصم ولا غائبًا، إنكم تدعون قريبًا مجيبًا يسمع دعاءكم ويستجيب» ثم دلّه على كنز الحوقلة.","reason":"قريبٌ فلا يُرفع الصوت، مجيبٌ فلا يُيأس: الاسم في هذه الرواية يجمع القرب بالإجابة — «يسمع دعاءكم ويستجيب».","adds":"يعلّل خفض الصوت في الدعاء: تدعون قريبًا مجيبًا."}],"sunnah":{"card":"الصيغة: قَرِيبٌ مُجِيبٌ — مركّبة، وردت «قريبًا مجيبًا»\nفي السنة: شاهد واحد (رواية واحدة)\nخصوصية الورود في السنة: كلمة النبي ﷺ لمن رفعوا أصواتهم بالدعاء: «إنكم لا تدعون أصم ولا غائبًا، إنكم تدعون قريبًا مجيبًا يسمع دعاءكم ويستجيب».","teaches":"1. أنه قريب يسمع ومجيب يستجيب.","whenRecall":"- حين ترفع صوتك بالدعاء.","whenPray":"عند الشعور بـ:\n1. البعد واليأس من الإجابة.\nعند طلب:\n1. الإجابة.\nعند الرغبة في:\n1. الدعاء بهمس.","duaItems":"«إنكم تدعون قريبًا مجيبًا يسمع دعاءكم ويستجيب» — تخريج المسند 19605 (على شرط الشيخين).","summary":"«قريب مجيب» في السنة تعليل النبي ﷺ لخفض الصوت في الدعاء: قريبٌ يسمع، مجيبٌ يستجيب."},"situations":[{"situationId":162,"verses":[{"i":1,"strength":"direct","headline":"تقديم الاستغفار والتوبة بين يدي الدعاء","bridge":"تريد أن تُحسن الطلب؟ صالحٌ بنى دعوته على حقيقتين ثم أمر: ﴿هُوَ أَنْشَأَكُمْ مِنَ الْأَرْضِ وَاسْتَعْمَرَكُمْ فِيهَا فَاسْتَغْفِرُوهُ ثُمَّ تُوبُوا إِلَيْهِ إِنَّ رَبِّي قَرِيبٌ مُجِيبٌ﴾ — استغفارٌ ثم توبةٌ ثم طلب، ممن هو قريبٌ لا يحتاج وسيطًا، مجيبٌ لا يردّ الطالب؛ فقدّم الاستغفار بين يدي دعائك."}],"hadiths":[]},{"situationId":164,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"الشعور بأن الله بعيدٌ عن دعائك لا يسمعه","bridge":"دعوت وطال الأمد؟ «إنكم تدعون قريبًا مجيبًا يسمع دعاءكم ويستجيب» — القرب والإجابة صفتان ثابتتان وإن تأخر أثرهما."}]}]},{"id":171,"name":"بكل خلق عليم","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: بِكُلِّ خَلْقٍ عَلِيمٌ — | المواضع: 1 (يس: 79)\nخصوصية: جواب من ضرب المثل بالعظام الرميم — وهي خاتمة سورة يس.\n\nالمعنى:\n- بكل خلق عليم: العالم بكل مخلوقٍ وكيفية إنشائه وإعادته — علمٌ يخصّ «الخلق» تحديدًا.","teaches":"الحقائق التي كشفها الموضع:\n1. أصل الإنكار نسيانُ النشأة الأولى.\n2. من أنشأ أول مرةٍ أقدرُ على الإعادة.\n3. علمه بـ«كل خلق» يشمل مصير كل ذرة.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند وسوسة إنكار البعث.\n- عند التفكر في نشأتك الأولى.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. تثبيت اليقين بالبعث بقياس يس.\n2. الاستعداد لليوم الذي تُعاد فيه العظام.\n3. تلاوة يس وتدبر خاتمتها.","summary":"نسي نشأته وسأل: من يحيي العظام؟ فجاء الجواب: ﴿يُحْيِيهَا الَّذِي أَنْشَأَهَا أَوَّلَ مَرَّةٍ وَهُوَ بِكُلِّ خَلْقٍ عَلِيمٌ﴾.","verses":[{"i":1,"of":1,"s":36,"surah":"يس","a":79,"text":"قُلْ يُحْيِيهَا الَّذِي أَنْشَأَهَا أَوَّلَ مَرَّةٍ وَهُوَ بِكُلِّ خَلْقٍ عَلِيمٌ","prev":{"a":78,"text":"وَضَرَبَ لَنَا مَثَلًا وَنَسِيَ خَلْقَهُ قَالَ مَنْ يُحْيِي الْعِظَامَ وَهِيَ رَمِيمٌ"},"next":{"a":80,"text":"الَّذِي جَعَلَ لَكُمْ مِنَ الشَّجَرِ الْأَخْضَرِ نَارًا فَإِذَا أَنْتُمْ مِنْهُ تُوقِدُونَ"},"reason":"التشخيصُ في ﴿وَنَسِيَ خَلْقَهُ﴾: نسي أنه كان نطفةً فصار خصيمًا مبينًا — والجوابُ من واقعه: الذي أنشأك أول مرة يعيدك؛ وهو ﴿بِكُلِّ خَلْقٍ عَلِيمٌ﴾: يعلم كل ذرةٍ من عظامك أين ذهبت.","adds":"أقصر جوابٍ لمنكر البعث: انظر إلى نفسك — ﴿وَنَسِيَ خَلْقَهُ﴾؛ فالبرهان في جسدك لا خارجه."}],"hadiths":[],"situations":[{"situationId":109,"verses":[{"i":1,"strength":"direct","headline":"وسوسةٌ تشكّك في إمكان إعادة العظام بعد فنائها","bridge":"خاطرٌ يوسوس إليك: كيف تعود العظام وهي رميم؟ التشخيص في الآية: ﴿وَنَسِيَ خَلْقَهُ﴾ — نسي أنه كان نطفةً فصار خصيمًا مبينًا؛ فردّ الخاطر إلى بدايتك: من أنشأك أول مرة لا يعجزه أن يعيدك، وهو ﴿بِكُلِّ خَلْقٍ عَلِيمٌ﴾."}],"hadiths":[]}]},{"id":172,"name":"الله رب السماوات ورب الأرض رب العالمين","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: رَبِّ السَّمَاوَاتِ وَرَبِّ الْأَرْضِ رَبِّ الْعَالَمِينَ — مركّبة ثلاثية | المواضع: 1 (الجاثية: 36)\nخصوصية: ثلاثُ إضافاتٍ متتابعة للربوبية في آيةٍ واحدة — تدرّجٌ من الأعلى إلى الأشمل.\n\nالمعنى: ربوبيةٌ للسماوات، وللأرض، وللعالمين كلهم — استيعابٌ كامل بثلاث عبارات.","teaches":"الحقائق التي كشفها الموضع:\n1. الحمد المطلق يقابل الربوبية الشاملة.\n2. التكرار الثلاثي استيعابٌ لا إطناب.\n3. الكبرياء له وحده في العالمين.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند ضيق تصورك عن عظمة الله.\n- عند ختام قراءة الجاثية.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. الحمد المستوعب: ﴿فَلِلَّهِ الْحَمْدُ رَبِّ السَّمَاوَاتِ وَرَبِّ الْأَرْضِ رَبِّ الْعَالَمِينَ﴾ — الجاثية 36.\n2. الاستعاذة من الكبر — فالكبرياء له وحده.\n3. توسعة الحمد بقدر توسعة المعرفة.","summary":"ثلاثُ ربوبيات في نفَسٍ واحد — والحمدُ يقابلها: ﴿فَلِلَّهِ الْحَمْدُ رَبِّ السَّمَاوَاتِ وَرَبِّ الْأَرْضِ رَبِّ الْعَالَمِينَ﴾.","verses":[{"i":1,"of":1,"s":45,"surah":"الجاثية","a":36,"text":"فَلِلَّهِ الْحَمْدُ رَبِّ السَّمَاوَاتِ وَرَبِّ الْأَرْضِ رَبِّ الْعَالَمِينَ","prev":{"a":35,"text":"ذَلِكُمْ بِأَنَّكُمُ اتَّخَذْتُمْ آيَاتِ اللَّهِ هُزُوًا وَغَرَّتْكُمُ الْحَيَاةُ الدُّنْيَا فَالْيَوْمَ لَا يُخْرَجُونَ مِنْهَا وَلَا هُمْ يُسْتَعْتَبُونَ"},"next":{"a":37,"text":"وَلَهُ الْكِبْرِيَاءُ فِي السَّمَاوَاتِ وَالْأَرْضِ وَهُوَ الْعَزِيزُ الْحَكِيمُ"},"context":"﴿فَلِلَّهِ الْحَمْدُ رَبِّ السَّمَاوَاتِ وَرَبِّ الْأَرْضِ رَبِّ الْعَالَمِينَ * وَلَهُ الْكِبْرِيَاءُ فِي السَّمَاوَاتِ وَالْأَرْضِ وَهُوَ الْعَزِيزُ الْحَكِيمُ﴾ — خاتمة الجاثية.","reason":"تكرارُ لفظ «رب» ثلاثًا استيعابٌ لكل جهات الربوبية، مقدَّمًا عليه الحمد بالتقديم: ﴿فَلِلَّهِ الْحَمْدُ﴾ — أي له وحده؛ فالحمدُ يستوعب ما استوعبته الربوبية.","adds":"حمدٌ بقدر ربوبية: كلما اتسع تصورك لربوبيته اتسع حمدك — والآية تعلّمك التوسعة."}],"hadiths":[],"situations":[{"situationId":162,"verses":[{"i":1,"strength":"direct","headline":"الرغبة في الثناء على الله بما يليق بربوبيته","bridge":"تريد أن تثني عليه كما ينبغي؟ خاتمة الجاثية: ﴿فَلِلَّهِ الْحَمْدُ رَبِّ السَّمَاوَاتِ وَرَبِّ الْأَرْضِ رَبِّ الْعَالَمِينَ﴾ — تقديم ﴿فَلِلَّهِ﴾ حصرٌ: له وحده، وتكرار «رب» ثلاثًا استيعابٌ لكل جهات الربوبية؛ فحمدٌ بقدر ربوبية، وكلما اتسع تصورك لربوبيته اتسع حمدك."}],"hadiths":[]}]},{"id":173,"name":"خير الماكرين","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: خَيْرُ الْمَاكِرِينَ — صيغة تفضيل | المواضع: 2 (آل عمران: 54 — الأنفال: 30)\nخصوصية: من أسماء المقابلة — لا يُطلق مفردًا بل في مقابلة مكر الماكرين؛ والمكرُ في حقه سبحانه تدبيرٌ خفيٌّ محمود يقابل به مكرَ الظالمين.\n\nالمعنى:\n- خير الماكرين: أقدرُهم على التدبير الخفي وأحكمُهم — لأن مكره عدلٌ يقابل به مكرًا ظالمًا، ولا يُحيط أحدٌ بتدبيره.","teaches":"الحقائق التي كشفها الموضعان:\n1. التدبير المقابل يعمل في اللحظة نفسها لا بعدها.\n2. مكرُه يحوّل المؤامرة إلى فضيحةٍ للماكرين.\n3. مكرُه صفةُ كمالٍ في مقابلةٍ لا صفةَ ذمّ مطلقة.","whenRecall":"لحظات الاستحضار — مشتقة من موضعيه:\n- عند اكتشاف مؤامرةٍ تُحاك ضدك.\n- عند العجز عن دفع كيدٍ خفي.","whenPray":"بنود الدعاء — مشتقة من سياق الموضعين:\n1. «اللَّهُمَّ اكْفِنِيهِمْ بِمَا شِئْتَ» — من دعائه ﷺ.\n2. سؤال ردّ الكيد في نحر صاحبه — آل عمران 54.\n3. عدم مقابلة المكر بالمكر: ﴿وَلَا يَحِيقُ الْمَكْرُ السَّيِّئُ إِلَّا بِأَهْلِهِ﴾ — فاطر 43.","summary":"بينما يخططون ضدك، التدبيرُ الأعلى يعمل في اللحظة نفسها: ﴿وَيَمْكُرُونَ وَيَمْكُرُ اللَّهُ وَاللَّهُ خَيْرُ الْمَاكِرِينَ﴾.","verses":[{"i":1,"of":2,"s":3,"surah":"آل عمران","a":54,"text":"وَمَكَرُوا وَمَكَرَ اللَّهُ وَاللَّهُ خَيْرُ الْمَاكِرِينَ","prev":{"a":53,"text":"رَبَّنَا آمَنَّا بِمَا أَنْزَلْتَ وَاتَّبَعْنَا الرَّسُولَ فَاكْتُبْنَا مَعَ الشَّاهِدِينَ"},"next":{"a":55,"text":"إِذْ قَالَ اللَّهُ يَا عِيسَى إِنِّي مُتَوَفِّيكَ وَرَافِعُكَ إِلَيَّ وَمُطَهِّرُكَ مِنَ الَّذِينَ كَفَرُوا وَجَاعِلُ الَّذِينَ اتَّبَعُوكَ فَوْقَ الَّذِينَ كَفَرُوا إِلَى يَوْمِ الْقِيَامَةِ ثُمَّ إِلَيَّ مَرْجِعُكُمْ فَأَحْكُمُ بَيْنَكُمْ فِيمَا كُنْتُمْ فِيهِ تَخْتَلِفُونَ"},"context":"مؤامرة قتل عيسى: ﴿وَمَكَرُوا وَمَكَرَ اللَّهُ وَاللَّهُ خَيْرُ الْمَاكِرِينَ﴾ — ثم ﴿إِنِّي مُتَوَفِّيكَ وَرَافِعُكَ إِلَيَّ﴾.","reason":"مكرٌ يقابل مكرًا: دبّروا القتل، فدبّر الرفعَ والتشبيه — فانقلب مكرُهم عليهم وظنوا أنهم قتلوه؛ فالمكرُ الإلهي لا يُبطل مكرهم فحسب بل يحوّله إلى فضيحةٍ تاريخية.","adds":"لا تقابل المكر بالمكر: قابله بالتوكل على خير الماكرين — فتدبيرُه يفوق تدبيرك وتدبيرهم."},{"i":2,"of":2,"s":8,"surah":"الأنفال","a":30,"text":"وَإِذْ يَمْكُرُ بِكَ الَّذِينَ كَفَرُوا لِيُثْبِتُوكَ أَوْ يَقْتُلُوكَ أَوْ يُخْرِجُوكَ وَيَمْكُرُونَ وَيَمْكُرُ اللَّهُ وَاللَّهُ خَيْرُ الْمَاكِرِينَ","prev":{"a":29,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ تَتَّقُوا اللَّهَ يَجْعَلْ لَكُمْ فُرْقَانًا وَيُكَفِّرْ عَنْكُمْ سَيِّئَاتِكُمْ وَيَغْفِرْ لَكُمْ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ"},"next":{"a":31,"text":"وَإِذَا تُتْلَى عَلَيْهِمْ آيَاتُنَا قَالُوا قَدْ سَمِعْنَا لَوْ نَشَاءُ لَقُلْنَا مِثْلَ هَذَا إِنْ هَذَا إِلَّا أَسَاطِيرُ الْأَوَّلِينَ"},"context":"دار الندوة: ﴿وَإِذْ يَمْكُرُ بِكَ الَّذِينَ كَفَرُوا لِيُثْبِتُوكَ أَوْ يَقْتُلُوكَ أَوْ يُخْرِجُوكَ وَيَمْكُرُونَ وَيَمْكُرُ اللَّهُ وَاللَّهُ خَيْرُ الْمَاكِرِينَ﴾.","reason":"ثلاثةُ خياراتٍ للمؤامرة — حبسٌ أو قتلٌ أو نفي — وفي اللحظة نفسها تدبيرٌ مقابل: خرج ﷺ من بينهم وهم على أبوابه؛ فبينما هم يخططون كان التدبيرُ الأعلى يعمل — ﴿وَيَمْكُرُونَ وَيَمْكُرُ اللَّهُ﴾ بصيغة المضارع: تزامنٌ لا تعاقب.","adds":"تزامنُ الفعلين في الآية: بينما يخططون ضدك، خيرُ الماكرين يخطط لك — في اللحظة نفسها.","dorar":[{"id":"Qle8HxDs","label":"البداية والنهاية 3/178"}]}],"hadiths":[],"situations":[{"situationId":30,"verses":[{"i":1,"strength":"direct","headline":"كيدٌ يُدبَّر لك في الخفاء ولا تراه","bridge":"تُدبَّر لك أمورٌ لا تراها؟ دبّروا قتل عيسى فدبّر الله رفعه: ﴿وَمَكَرُوا وَمَكَرَ اللَّهُ وَاللَّهُ خَيْرُ الْمَاكِرِينَ﴾ — انقلب مكرهم عليهم وصار فضيحةً تاريخية؛ فلا تقابل المكر بالمكر، قابله بالتوكل على خير الماكرين، فتدبيره يفوق تدبيرك وتدبيرهم."},{"i":2,"strength":"direct","headline":"التخطيط ضدك في الخفاء والغرف المغلقة","bridge":"يخططون ضدك في غرفٍ مغلقة؟ في دار الندوة خطّطوا: حبسٌ أو قتلٌ أو نفي — ﴿وَيَمْكُرُونَ وَيَمْكُرُ اللَّهُ وَاللَّهُ خَيْرُ الْمَاكِرِينَ﴾ بصيغة المضارع: تزامنٌ لا تعاقب؛ فبينما يخططون ضدك خيرُ الماكرين يخطط لك في اللحظة نفسها، وقد خرج ﷺ من بينهم وهم على بابه."}],"hadiths":[]}]},{"id":174,"name":"رب المشرق والمغرب","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: رَبُّ الْمَشْرِقِ وَالْمَغْرِبِ — مضافة | المواضع: 2 (الشعراء: 28 — المزمل: 9)\nخصوصية: مرةً حجةً في وجه فرعون، ومرةً أمرًا باتخاذه وكيلًا — فهو اسمُ الحجة والتوكل معًا.\n\nالمعنى:\n- رب المشرق والمغرب: مالكُ جهتَي الشروق والغروب ومدبّرُ حركتهما — أي مالكُ الزمان والمكان معًا.","teaches":"الحقائق التي كشفها الموضعان:\n1. بعض البراهين تحتاج عقلًا لا إيمانًا: ﴿إِنْ كُنْتُمْ تَعْقِلُونَ﴾.\n2. اتخاذ الوكيل قرارٌ مأمورٌ به: ﴿فَاتَّخِذْهُ وَكِيلًا﴾.\n3. من ملك المشرق والمغرب استحق التبتل إليه.","whenRecall":"لحظات الاستحضار — مشتقة من موضعيه:\n- عند كل شروقٍ وغروب.\n- عند قيام الليل والانقطاع للعبادة.","whenPray":"بنود الدعاء — مشتقة من سياق الموضعين:\n1. اتخاذه وكيلًا قرارًا: ﴿فَاتَّخِذْهُ وَكِيلًا﴾ — المزمل 9.\n2. التبتل إليه في الأسحار — المزمل 8.\n3. الاستدلال بالمحسوس عند محاورة الجاحدين.","summary":"من ملك المشرق والمغرب يستحق أمرين: انقطاعك إليه، وتوكيلك له — ﴿فَاتَّخِذْهُ وَكِيلًا﴾.","verses":[{"i":1,"of":1,"s":73,"surah":"المزمل","a":9,"text":"رَبُّ الْمَشْرِقِ وَالْمَغْرِبِ لَا إِلَهَ إِلَّا هُوَ فَاتَّخِذْهُ وَكِيلًا","prev":{"a":8,"text":"وَاذْكُرِ اسْمَ رَبِّكَ وَتَبَتَّلْ إِلَيْهِ تَبْتِيلًا"},"next":{"a":10,"text":"وَاصْبِرْ عَلَى مَا يَقُولُونَ وَاهْجُرْهُمْ هَجْرًا جَمِيلًا"},"context":"﴿وَاذْكُرِ اسْمَ رَبِّكَ وَتَبَتَّلْ إِلَيْهِ تَبْتِيلًا * رَبُّ الْمَشْرِقِ وَالْمَغْرِبِ لَا إِلَهَ إِلَّا هُوَ فَاتَّخِذْهُ وَكِيلًا﴾ — في سورة المزمل مع الأمر بقيام الليل.","reason":"قُرن ربُّ المشرق والمغرب بأمرين: التبتّل (الانقطاع إليه) واتخاذه وكيلًا — فمن يملك المشرق والمغرب يستحق انقطاعك إليه وتوكيلك له؛ والأمرُ صريح: ﴿فَاتَّخِذْهُ وَكِيلًا﴾ — قرارٌ لا انتظار.","adds":"التبتل والتوكيل معًا: انقطاعٌ بالليل وتوكيلٌ بالنهار — منهج سورة المزمل لحملة الرسالة."}],"hadiths":[],"situations":[{"situationId":155,"verses":[{"i":1,"strength":"direct","headline":"حمل همّ الرسالة بين قيام الليل وأعباء النهار","bridge":"تقوم الليل؟ في سورة القيام نفسها: ﴿وَاذْكُرِ اسْمَ رَبِّكَ وَتَبَتَّلْ إِلَيْهِ تَبْتِيلًا * رَبُّ الْمَشْرِقِ وَالْمَغْرِبِ لَا إِلَهَ إِلَّا هُوَ فَاتَّخِذْهُ وَكِيلًا﴾ — تبتّلٌ بالليل وتوكيلٌ بالنهار؛ منهج المزمل لحملة الرسالة: انقطاعٌ إليه في القيام، وتفويضٌ له في العمل."}],"hadiths":[]}]},{"id":175,"name":"رب السماوات والأرض وما بينهما الرحمن","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: رَبِّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا الرَّحْمَنِ — مركّبة | المواضع: 1 (النبأ: 37)\nخصوصية: الموضع الوحيد الذي يُختم فيه وصفُ الربوبية الشاملة بـ«الرحمن» في مشهد القيامة.\n\nالمعنى: ربُّ العوالم الثلاثة الموصوف بالرحمة الواسعة — رحمةٌ تُذكر في أرهب المواقف.","teaches":"الحقائق التي كشفها الموضع:\n1. أرهب المواقف يُذكر فيها «الرحمن».\n2. الكلام يومئذ بإذنٍ وشرطُه الصواب.\n3. الملائكة والروح يقفون صفًّا صامتين.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند التساهل في الكلام.\n- عند الخوف من موقف القيامة.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. سؤال الإذن والقول الصواب يومئذ — النبأ 38.\n2. سؤال اتخاذ السبيل إلى الله: ﴿فَمَنْ شَاءَ اتَّخَذَ إِلَى رَبِّهِ مَآبًا﴾ — النبأ 39.\n3. حفظ اللسان تدريبًا لذلك اليوم.","summary":"يومٌ لا يُملك فيه خطاب — وشرطُ الكلام فيه: ﴿إِلَّا مَنْ أَذِنَ لَهُ الرَّحْمَنُ وَقَالَ صَوَابًا﴾: فدرّب لسانك على الصواب.","verses":[{"i":1,"of":1,"s":78,"surah":"النبأ","a":37,"text":"رَبِّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا الرَّحْمَنِ لَا يَمْلِكُونَ مِنْهُ خِطَابًا","prev":{"a":36,"text":"جَزَاءً مِنْ رَبِّكَ عَطَاءً حِسَابًا"},"next":{"a":38,"text":"يَوْمَ يَقُومُ الرُّوحُ وَالْمَلَائِكَةُ صَفًّا لَا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ الرَّحْمَنُ وَقَالَ صَوَابًا"},"reason":"في مشهدٍ لا يُملك فيه خطابٌ ولا كلام، تكرر اسم «الرحمن» مرتين: فالمهيبُ في ذلك اليوم هو الرحمن نفسه — والإذنُ بالكلام منه ومشروطٌ بالصواب. فالرحمةُ لا تلغي الهيبة والهيبةُ لا تلغي الرحمة.","adds":"شرطان للكلام يومئذ: إذنُ الرحمن، وصوابُ القول — فدرّب لسانك على الصواب اليوم."}],"hadiths":[],"situations":[{"situationId":60,"verses":[{"i":1,"strength":"direct","headline":"الخوف من زلّات اللسان وتبعات الكلام","bridge":"تتكلم وتخشى أن تزلّ؟ تذكّر يومًا لا يُملك فيه خطاب: ﴿رَبِّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا الرَّحْمَنِ لَا يَمْلِكُونَ مِنْهُ خِطَابًا﴾ ثم ﴿لَا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ الرَّحْمَنُ وَقَالَ صَوَابًا﴾ — شرطان للكلام يومئذ: إذنُ الرحمن وصوابُ القول؛ فدرّب لسانك على الصواب اليوم."}],"hadiths":[]}]},{"id":176,"name":"رب المشرقين ورب المغربين","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: رَبُّ الْمَشْرِقَيْنِ وَرَبُّ الْمَغْرِبَيْنِ — مضافة بالتثنية | المواضع: 1 (الرحمن: 17)\nخصوصية: الصيغة الوحيدة بالتثنية — مشرقا الشتاء والصيف ومغرباهما: أي طرفا مسار الشمس على مدار السنة.\n\nالمعنى: مالكُ مشرقَي الصيف والشتاء ومغربَيهما — أي المتحكم في تغير مسار الشمس الذي تنشأ عنه الفصول.","teaches":"الحقائق التي كشفها الموضع:\n1. النظام الفلكي يُعدّ في «الآلاء» — النعم لا مجرد الظواهر.\n2. اختلاف الفصول أثرُ تدبيرٍ مقصود.\n3. السؤال المتكرر في السورة تحدٍّ للجحود.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند تغير الفصول.\n- عند قراءة سورة الرحمن.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. شكر آلاء الرحمن عند كل نعمة: ﴿فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ﴾ — والجواب المأثور: «ولا بشيء من نعمك ربنا نكذب فلك الحمد».\n2. شكر نعمة تعاقب الفصول والمواقيت.","summary":"حتى تغيّرُ مشرق الشمس بين الشتاء والصيف نعمةٌ تُعدّ: ﴿رَبُّ الْمَشْرِقَيْنِ وَرَبُّ الْمَغْرِبَيْنِ * فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ﴾.","verses":[{"i":1,"of":1,"s":55,"surah":"الرحمن","a":17,"text":"رَبُّ الْمَشْرِقَيْنِ وَرَبُّ الْمَغْرِبَيْنِ","prev":{"a":16,"text":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},"next":{"a":18,"text":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},"context":"﴿رَبُّ الْمَشْرِقَيْنِ وَرَبُّ الْمَغْرِبَيْنِ * فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ﴾ — في سورة الرحمن بين آيات النعم.","reason":"عُدّ اختلافُ مشارق الشمس ومغاربها بين الصيف والشتاء «آلاءً» — نعمةً لا مجرد ظاهرة: فعليها تقوم الفصول والزراعة والمواقيت؛ وجاء بعدها السؤال المتكرر: ﴿فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ﴾.","adds":"تعاقبُ الفصول نعمةٌ تُعدّ في سورة الرحمن — فمن شكر الطعام والثمار فليشكر النظام الذي أنتجها."}],"hadiths":[],"situations":[{"situationId":177,"verses":[{"i":1,"strength":"direct","headline":"التفكر في تعاقب الفصول واختلاف المشارق والمغارب","bridge":"تنظر إلى تعاقب الفصول؟ اختلاف مشارق الشمس ومغاربها بين الصيف والشتاء عُدّ في سورة الرحمن «آلاءً»: ﴿رَبُّ الْمَشْرِقَيْنِ وَرَبُّ الْمَغْرِبَيْنِ * فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ﴾ — نعمةٌ لا مجرد ظاهرة: عليها تقوم الفصول والزراعة والمواقيت."}],"hadiths":[]}]},{"id":177,"name":"رب السماوات والأرض","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: رَبُّ السَّمَاوَاتِ وَالْأَرْضِ — مضافة | المواضع: 11\nخصوصية: الصيغةُ الجامعة التي تتردد في مواجهات الأنبياء الكبرى: إبراهيم مع قومه، وموسى مع فرعون، وفتية الكهف مع دولتهم — فهي إعلانُ الانتماء الأول عند كل مواجهة.\n\nالمعنى:\n- رب السماوات والأرض: خالقُ العالمَين ومالكهما ومدبّرهما — إعلانُ ربوبيةٍ يُسقط كل ربوبيةٍ مدّعاة.","teaches":"الحقائق التي كشفتها المواضع:\n1. الثبات عطيةٌ تسبق الموقف: ﴿وَرَبَطْنَا عَلَى قُلُوبِهِمْ إِذْ قَامُوا﴾ (الكهف 14).\n2. العبادة تحتاج اصطبارًا لا حماسة (مريم 65).\n3. الجحود مع العلم أخطر من الجهل: ﴿لَقَدْ عَلِمْتَ﴾ (الإسراء 102).\n4. المعرفة مشروطة بطلب اليقين (الشعراء 24، الدخان 7).\n5. لا يكفي أن تعرف الحق: كن من الشاهدين (الأنبياء 56).","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- قبل موقفٍ صعب تحتاج فيه ثباتًا.\n- عند مواجهة سلطةٍ تطلب ولاءً على حساب الدين.\n- عند ثقل المواظبة على العبادة.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. سؤال الربط على القلب قبل المواقف — الكهف 14.\n2. سؤال العون على الاصطبار للعبادة — مريم 65.\n3. الاستعاذة من الجحود بعد العلم — الإسراء 102.\n4. دعاء فتية الكهف: ﴿رَبَّنَا آتِنَا مِنْ لَدُنْكَ رَحْمَةً وَهَيِّئْ لَنَا مِنْ أَمْرِنَا رَشَدًا﴾ — الكهف 10.","summary":"إعلانُ الانتماء الأول عند كل مواجهة: ﴿رَبُّنَا رَبُّ السَّمَاوَاتِ وَالْأَرْضِ لَنْ نَدْعُوَ مِنْ دُونِهِ إِلَهًا﴾ — وقبله ربطٌ على القلب: فاسأله قبل أن تقوم.","verses":[{"i":1,"of":4,"s":13,"surah":"الرعد","a":16,"text":"قُلْ مَنْ رَبُّ السَّمَاوَاتِ وَالْأَرْضِ قُلِ اللَّهُ قُلْ أَفَاتَّخَذْتُمْ مِنْ دُونِهِ أَوْلِيَاءَ لَا يَمْلِكُونَ لِأَنْفُسِهِمْ نَفْعًا وَلَا ضَرًّا قُلْ هَلْ يَسْتَوِي الْأَعْمَى وَالْبَصِيرُ أَمْ هَلْ تَسْتَوِي الظُّلُمَاتُ وَالنُّورُ أَمْ جَعَلُوا لِلَّهِ شُرَكَاءَ خَلَقُوا كَخَلْقِهِ فَتَشَابَهَ الْخَلْقُ عَلَيْهِمْ قُلِ اللَّهُ خَالِقُ كُلِّ شَيْءٍ وَهُوَ الْوَاحِدُ الْقَهَّارُ","prev":{"a":15,"text":"وَلِلَّهِ يَسْجُدُ مَنْ فِي السَّمَاوَاتِ وَالْأَرْضِ طَوْعًا وَكَرْهًا وَظِلَالُهُمْ بِالْغُدُوِّ وَالْآصَالِ"},"next":{"a":17,"text":"أَنْزَلَ مِنَ السَّمَاءِ مَاءً فَسَالَتْ أَوْدِيَةٌ بِقَدَرِهَا فَاحْتَمَلَ السَّيْلُ زَبَدًا رَابِيًا وَمِمَّا يُوقِدُونَ عَلَيْهِ فِي النَّارِ ابْتِغَاءَ حِلْيَةٍ أَوْ مَتَاعٍ زَبَدٌ مِثْلُهُ كَذَلِكَ يَضْرِبُ اللَّهُ الْحَقَّ وَالْبَاطِلَ فَأَمَّا الزَّبَدُ فَيَذْهَبُ جُفَاءً وَأَمَّا مَا يَنْفَعُ النَّاسَ فَيَمْكُثُ فِي الْأَرْضِ كَذَلِكَ يَضْرِبُ اللَّهُ الْأَمْثَالَ"},"reason":"سؤالٌ وجوابٌ من المتكلم نفسه — ﴿قُلِ اللَّهُ﴾ — لأن الجواب بدهيّ لا يحتمل النقاش؛ ثم الإلزام: كيف تتخذون أولياء لا يملكون لأنفسهم نفعًا وقد أقررتم بربّ السماوات والأرض؟","adds":"من لا يملك لنفسه نفعًا ولا ضرًّا لا يصلح وليًّا لك — قاعدةٌ تسقط بها كل الوسائط."},{"i":2,"of":4,"s":17,"surah":"الإسراء","a":102,"text":"قَالَ لَقَدْ عَلِمْتَ مَا أَنْزَلَ هَؤُلَاءِ إِلَّا رَبُّ السَّمَاوَاتِ وَالْأَرْضِ بَصَائِرَ وَإِنِّي لَأَظُنُّكَ يَا فِرْعَوْنُ مَثْبُورًا","prev":{"a":101,"text":"وَلَقَدْ آتَيْنَا مُوسَى تِسْعَ آيَاتٍ بَيِّنَاتٍ فَاسْأَلْ بَنِي إِسْرَائِيلَ إِذْ جَاءَهُمْ فَقَالَ لَهُ فِرْعَوْنُ إِنِّي لَأَظُنُّكَ يَا مُوسَى مَسْحُورًا"},"next":{"a":103,"text":"فَأَرَادَ أَنْ يَسْتَفِزَّهُمْ مِنَ الْأَرْضِ فَأَغْرَقْنَاهُ وَمَنْ مَعَهُ جَمِيعًا"},"context":"موسى لفرعون: ﴿لَقَدْ عَلِمْتَ مَا أَنْزَلَ هَؤُلَاءِ إِلَّا رَبُّ السَّمَاوَاتِ وَالْأَرْضِ بَصَائِرَ وَإِنِّي لَأَظُنُّكَ يَا فِرْعَوْنُ مَثْبُورًا﴾.","reason":"مواجهةٌ حاسمة: ﴿لَقَدْ عَلِمْتَ﴾ — فرعونُ يعلم الحق ويجحده؛ فالجحودُ عن علمٍ لا عن جهل. وسُمّيت الآيات «بصائر»: تُبصِر من أرادها.","adds":"أخطر أنواع الكفر: الجحود مع العلم — ﴿لَقَدْ عَلِمْتَ﴾؛ فراجع ما تعلمه ولا تعمل به."},{"i":3,"of":4,"s":18,"surah":"الكهف","a":14,"text":"وَرَبَطْنَا عَلَى قُلُوبِهِمْ إِذْ قَامُوا فَقَالُوا رَبُّنَا رَبُّ السَّمَاوَاتِ وَالْأَرْضِ لَنْ نَدْعُوَ مِنْ دُونِهِ إِلَهًا لَقَدْ قُلْنَا إِذًا شَطَطًا","prev":{"a":13,"text":"نَحْنُ نَقُصُّ عَلَيْكَ نَبَأَهُمْ بِالْحَقِّ إِنَّهُمْ فِتْيَةٌ آمَنُوا بِرَبِّهِمْ وَزِدْنَاهُمْ هُدًى"},"next":{"a":15,"text":"هَؤُلَاءِ قَوْمُنَا اتَّخَذُوا مِنْ دُونِهِ آلِهَةً لَوْلَا يَأْتُونَ عَلَيْهِمْ بِسُلْطَانٍ بَيِّنٍ فَمَنْ أَظْلَمُ مِمَّنِ افْتَرَى عَلَى اللَّهِ كَذِبًا"},"context":"فتية الكهف: ﴿وَرَبَطْنَا عَلَى قُلُوبِهِمْ إِذْ قَامُوا فَقَالُوا رَبُّنَا رَبُّ السَّمَاوَاتِ وَالْأَرْضِ لَنْ نَدْعُوَ مِنْ دُونِهِ إِلَهًا لَقَدْ قُلْنَا إِذًا شَطَطًا﴾.","reason":"إعلانُ توحيدٍ في وجه دولةٍ وثنية — سبقه ربطٌ على القلوب: ﴿وَرَبَطْنَا عَلَى قُلُوبِهِمْ﴾ فالثباتُ عطيةٌ تسبق الموقف؛ ثم أعلنوا ربوبيةً شاملة تُسقط كل إلهٍ سواها.","adds":"قبل أن تقف موقفًا صعبًا اسأل الربط على القلب — فالفتية رُبط على قلوبهم ثم قاموا."},{"i":4,"of":4,"s":21,"surah":"الأنبياء","a":56,"text":"قَالَ بَلْ رَبُّكُمْ رَبُّ السَّمَاوَاتِ وَالْأَرْضِ الَّذِي فَطَرَهُنَّ وَأَنَا عَلَى ذَلِكُمْ مِنَ الشَّاهِدِينَ","prev":{"a":55,"text":"قَالُوا أَجِئْتَنَا بِالْحَقِّ أَمْ أَنْتَ مِنَ اللَّاعِبِينَ"},"next":{"a":57,"text":"وَتَاللَّهِ لَأَكِيدَنَّ أَصْنَامَكُمْ بَعْدَ أَنْ تُوَلُّوا مُدْبِرِينَ"},"context":"إبراهيم بعد تكسير الأصنام: ﴿قَالَ بَلْ رَبُّكُمْ رَبُّ السَّمَاوَاتِ وَالْأَرْضِ الَّذِي فَطَرَهُنَّ وَأَنَا عَلَى ذَلِكُمْ مِنَ الشَّاهِدِينَ﴾.","reason":"تصحيحٌ بـ«بل» الإضرابية: ليس ربكم هذه الأصنام بل ربُّ السماوات والأرض الذي فطرهن — ثم شهادةٌ شخصية: ﴿وَأَنَا عَلَى ذَلِكُمْ مِنَ الشَّاهِدِينَ﴾: بيانٌ وشهادةٌ وموقف.","adds":"لا يكفي أن تعرف الحق: كن من الشاهدين عليه — ﴿وَأَنَا عَلَى ذَلِكُمْ مِنَ الشَّاهِدِينَ﴾."}],"hadiths":[{"i":1,"of":4,"text":"أنَّ نَبيَّ اللهِ صلَّى اللهُ عليه وسلَّم كان يقولُ عِندَ الكَربِ: لا إلَهَ إلَّا اللهُ العَظيمُ الحَليمُ، لا إلَهَ إلَّا اللهُ رَبُّ العَرشِ العَظيمِ، لا إلَهَ إلَّا اللهُ رَبُّ السَّمَواتِ ورَبُّ الأرضِ ورَبُّ العَرشِ الكَريمِ. وفي روايةٍ: أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم كان يَدعو بهنَّ ويقولُهنَّ عِندَ الكَربِ، فذَكَرَ بمِثلِ حَديثِ مُعاذِ بنِ هِشامٍ، عن أبيه، عن قَتادةَ، غيرَ أنَّه قال: رَبُّ السَّمَواتِ والأرضِ. وفي روايةٍ: أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم كانَ إذا حَزَبَه أمرٌ، قال: فذَكَرَ بمِثلِ حَديثِ مُعاذٍ، عن أبيه. وزادَ معهُنَّ: لا إلَهَ إلَّا اللهُ رَبُّ العَرشِ الكَريمِ.","narrator":"عبدالله بن عباس","source":"صحيح مسلم 2730","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/9gq6zyAJ","nameForm":"رَبُّ السَّمَواتِ والأرضِ","scene":"دعاء الكرب: «…لا إله إلا الله رب السماوات ورب الأرض ورب العرش الكريم». وفي رواية: «رب السماوات والأرض».","reason":"التهليلة الثالثة تنزل من العرش إلى السماوات والأرض: ربوبية تشمل موضع المكروب.","adds":"يُتمّ الاسم دعاء الكرب."},{"i":2,"of":4,"text":"كان إذا تَضَوَّرَ مِنَ الليلِ قال : لا إلهَ إلَّا اللهُ الوَاحِدُ القَهَّارُ ، رَبُّ السَّماوَاتِ والأرضِ و ما بينَهُما العَزِيزُ الغَفَّارُ","narrator":"عائشة أم المؤمنين","source":"السلسلة الصحيحة 2066","grade":"صحيح","judgment":"صحيح على شرط البخاري","url":"https://dorar.net/h/j3oHzErV","nameForm":"رَبُّ السَّماوَاتِ والأرضِ","scene":"ذكر التضوّر: «لا إله إلا الله الواحد القهار، رب السماوات والأرض وما بينهما العزيز الغفار».","reason":"الاسم في وسط ذكر الليل بين القهر والمغفرة.","adds":"يعطي الاسم موضعًا في ذكر التقلّب."},{"i":3,"of":4,"text":"عن ابنِ عباسٍ, قال : غزونا مع معاويةَ غزوةَ المصيفِ, فمَرُّوا بالكهفِ الذي فيهِ أصحابُ الكهفِ, الذين ذكر اللهُ في القرآنِ, فقال معاويةُ : لو كُشِفَ لنا عن هؤلاءِ, فنظرنا إليهم, فقال ابنُ عباسٍ : ليس ذلك لك قد منع اللهُ ذلك من هو خيرٌ منك, فقال : { لَوْ اطَّلَعْتَ عَلَيْهِمْ لَوَلَّيْتَ مِنْهُمْ فِرَارًا وَلَمُلِئْتَ مِنْهُمْ رُعْبًا } قال معاويةُ : لا أنتهي حتى أعلمَ علمهم, قال : فبعث ناسًا, فقال : اذهبوا فانظروا فلمَّا دخلوا الكهفَ, بعث اللهُ عليهم ريحًا, فأخرجتهم, فبلغ ذلك ابنُ عباسٍ, فأنشأَ يُحدِّثهم عنهم, فقال : إنَّهم كانوا في مملكةِ ملكٍ من هذهِ الجبابرةِ, فجعلوا يعبدونَ حتى عبدةَ الأوثانِ, قال : وهؤلاءِ الفتيةُ بالمدينةِ, فلمَّا رأوا ذلك خرجوا من تلك المدينةِ على غيرِ ميعادٍ, فجمعهم اللهُ, عزَّ وجلَّ, على غيرِ ميعادٍ, فجعل بعضهم يقولُ لبعضٍ : أين تريدون ؟ أين تذهبون, قال : فجعل بعضهم يُخفي من بعضٍ, لأنَّهُ لا يدري هذا على ما خرج هذا, فأخذ بعضهم على بعضٍ المواثيقَ أن يُخبرَ بعضهم بعضًا, فإنِ اجتمعوا على شيٍء, وإلا كتم بعضهم على بعضٍ , قال : فاجتمعوا على كلمةٍ واحدةٍ, ?فقالوا رَبُّنَا رَبُّ السَّمَوَاتِ وَالْأَرْضِ لَنْ نَدْعُوَ مِنْ دُونِهِ إِلَهًا لَقَدْ قُلْنَا إِذًا شَطَطًا هَؤُلاءِ قَوْمُنَا اتَّخَذُوْا مِنْ دُونِهِ آلِهَةً لَوْلَا يَأْتُونَ عَلَيْهِمْ بِسُلْطَانٍ بَيِّنٍ, فَمَنْ أَظْلَمُ مِمَّنِ افْتَرَى عَلَى اللهِ كَذِبًا, وَإِذِ اعْتَزَلْتُمُوهُمْ - إلى قولِهِ –مِنْ أَمْرِكُمْ مِرْفَقًا ? [ 14 - 16 : الكهف ] ,قال : فهذا قولُ الفتيةِ, قال : ففُقدوا فجاء أهلُ هذا يطلبونَهُ لا يدرون أين ذهب, وجاء أهلُ هذا يطلبونَهُ لا يدرون أين ذهب, فطلبهم أهلوهم, لا يدرون أين ذهبوا, فرُفِعَ ذلك إلى الملكِ, فقال : ليكونَنَّ لهؤلاءِ شأنٌ بعد اليومِ, قومٌ خرجوا ولا يُدرى أين توجهوا في غيرِ جنايةٍ, ولا شيٌء يُعرفُ, فدعا بلوحٍ من رصاصٍ, فكتب فيهِ أسماءهم, وطرحَهُ في خزانتِهِ, فذلك قولُ اللهِ تباركَ وتعالى [ 9 : الكهف ] { إِنَّ أَصْحَابَ الْكَهْفِ وَالرَّقِيمِ كَانُوْا مِنْ آيَاتِنَا عَجَبًا } والرقيمُ هو اللوحُ الذي كتبوا, قال : فانطلقوا حتى دخلوا الكهفَ, فضرب اللهُ على آذانهم, فناموا, قال : فقال ابنُ عباسٍ : واللهِ لو أنَّ الشمسَ تطلعُ عليهم لأحرقتهم, ولولا أنَّهم يُقلبونَ, لأكلتهمُ الأرضُ, فذلك قولُ اللهِ تباركَ وتعالى?وَتَرَى الشَّمْسَ إِذَا طَلَعَتْ تَزَاوَرُ عَنْ كَهْفِهِمْ ذَاتَ الْيَمِينِ,وَإِذَا غَرَبَتْ تَقْرِضُهُمْ ذَاتَ الشِّمَالِ وَكَلْبُهُمْ بَاسِطٌ ذِرَاعَيْهِ بِالْوَصِيدِ ?يقولُ : بالفناءِ { وَنُقَلِّبُهُمْ ذَاتَ الْيَمِينِ وَذَاتَ الشِّمَالِ ?ثم إنَّ ذلك الملكَ ذهب وجاء ملكٌ آخرُ, فكسر تلك الأوثانَ وعبدَ اللهَ, وعدلَ في الناسِ, فبعثهم اللهُ لما يريدُ, فقال بعضهم لبعضٍ : { كَمْ لَبِثْتُمْ } قال بعضهم : ?يَوْمًا } وقال بعضهم : ?بَعْضَ يَوْمٍ ?,وقال بعضهم : أكثرُ من ذلك, فقال كبيرهم : لا تختلفوا, فإنَّهُ لم يختلف قومٌ قطُّ إلا هَلكوا, قال : فقالوا : { فَابْعَثُوْا أَحَدَكُمْ بِوَرِقِكِمْ هَذِهِ إِلَى الْمَدِينَةِ فَلْيَنْظُرْ أَيُّهَا أَزْكَى طَعَامًا فَلْيَأْتِكُمْ بِرِزْقٍ مِنْهُ وَلْيَتَلَطَّفْ } يعني بأزكى : بأطهرَ, إنَّهم كانوا يذبحونَ الخنازيرَ, قال : فجاء إلى المدينةِ, فرأى شارةً أنكرها, وبنيانًا أنكرَهُ, ثم دنا إلى خبازٍ, فرمى إليهِ بدرهمٍ, فأنكرَ الخبازُ الدرهمَ, وكانت دراهمهم كخفافِ الربعِ يعني والربعِ الفصيلَ, قال : فأنكر الخبازُ, وقال : من أين لك هذا الدرهمَ ؟ لقد وجدتَ كنزًا لتَدُلَّني على هذا الكنزِ أو لأرفعنَّكَ إلى الأميرِ, قال : أَتُخَوِّفُنِي بالأميرِ , وإني لدهقانُ الأميرِ فقال : من أبوكَ ؟ قال : فلانٌ, فلم يعرفْهُ, فقال : من الملكُ ؟ فقال : فلانٌ, فلم يعرفْهُ, قال : فاجتمع الناسُ, ورفع إلى عاملهم, فسألَهُ, فأخبرَهُ, فقال : عليَّ باللوحِ, قال : فجيءَ بهِ, فسمَّى أصحابَهُ فلانٌ وفلانٌ, وهم في اللوحِ مكتوبونَ قال : فقال الناسُ : قد دلَّكمُ اللهُ على إخوانكم, قال : فانطلقوا, فركبوا حتى أتوْا الكهفَ, فقال الفتى : مكانكم أنتم, حتى أدخلَ على أصحابي, لا تهجموا عليهم, فيفزعوا منكم, وهم لا يعلمونَ, أنَّ اللهَ قد أقبل بكم, وتاب عليكم, فقالوا : آللهِ لتَخْرُجَنَّ إلينا, قال : إن شاء اللهُ, فلم يَدْرِ أين ذهب, وعميَ عليهم المكانُ قال : فطلبوا وحرصوا, فلم يَقدروا على الدخولِ عليهم, فقالوا : أَكْرِمُوا إخوانكم, قال : فنظروا في أمرهم, فقالوا : ?لَنَتَّخِذَنَّ عَلَيْهِمْ مَسْجِدًا } فجعلوا يُصلُّونَ عليهم, ويستغفرونَ لهم, ويدعون لهم, فذلك قولُ اللهِ تعالى ?فَلَا تُمَارِ فِيهِمْ إِلَّا مِرَاءً ظَاهِرًا وَلَا تَسْتَفْتِ فِيهِمْ مِنْهُمْ أَحَدًا } يعني اليهودَ ?وَلَا تَقُولَنَّ لِشَيٍء إِنِّي فَاعِلٌ ذَلِكَ غَدًا إِلَّا أَنْ يَشَاءَ اللهُ وَاذْكُرْ رَبَّكَ إِذَا نَسِيتَ } [ 22 - 24 : الكهف ] فكان ابنُ عباسٍ, يقولُ : إذا قلتَ شيئًا فلم تقل : إن شاء اللهُ, فقل إذا ذكرتَ إن شاء اللهُ","narrator":"عبدالله بن عباس","source":"تغليق التعليق 4/244","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/1XuVFTjJ","nameForm":"رَبُّ السَّمَوَاتِ وَالْأَرْضِ","scene":"ابن عباس مع معاوية عند الكهف: أراد معاوية أن يكشف عن أصحاب الكهف، فذكّره ابن عباس بقصتهم: فتيةٌ أخذ بعضهم على بعض المواثيق فاجتمعوا على كلمة واحدة: ﴿رَبُّنَا رَبُّ السَّمَاوَاتِ وَالْأَرْضِ لَن نَّدْعُوَ مِن دُونِهِ إِلَٰهًا﴾.","reason":"كلمة الفتية حين قاموا: الاسم أول ما اجتمعوا عليه — من كان ربه رب السماوات والأرض لم يدعُ من دونه إلهًا.","adds":"يقرن الاسم بموقف الفتية في وجه قومهم."},{"i":4,"of":4,"text":"عن كعبٍ، قال: أشهَدُ والذي فَلَقَ البَحرَ لموسى صلَّى اللهُ عليه وسلَّمَ لَسَمِعتُ صُهَيبًا يقولُ: كان النَّبيُّ صلَّى اللهُ عليه وسلَّمَ إذا رأى قَريةً يُريدُ نُزولَها قال: اللَّهُمَّ ربَّ السَّمواتِ والأرضِ وما أظلَلْنَ، وربَّ الرِّياحِ وما ذَرَينَ، وربَّ الأرَضينَ وما أقلَلْنَ، وربَّ الشَّياطينِ وما أضلَلْنَ، أسأَلُكَ من خَيرِ هذه القَريةِ ومن خَيرِ أهْلِها، وأعوذُ بكَ من شَرِّها ومن شَرِّ أهْلِها وشرِّ ما فيها.","narrator":"صهيب","source":"تخريج مشكل الآثار 2528","grade":"حسن","judgment":"إسناده حسن","url":"https://dorar.net/h/DYCobpt6","nameForm":"ربَّ السَّمواتِ والأرضِ","scene":"صهيب: كان النبي ﷺ إذا رأى قريةً يريد نزولها قال: «اللهم رب السماوات والأرض وما أظللن، ورب الرياح وما ذرين، ورب الأرضين وما أقللن، ورب الشياطين وما أضللن، أسألك من خير هذه القرية ومن خير أهلها، وأعوذ بك من شرها وشر أهلها».","reason":"عند دخول قرية جديدة يُذكر رب السماوات والأرض: القرية الغريبة داخلة في ربوبيته، فيُسأل خيرها ويُستعاذ من شرها.","adds":"دعاء دخول البلد بلفظ الاسم: يُسأل فيه خير القرية وخير أهلها، ويُستعاذ من شرها."}],"sunnah":{"card":"الصيغة: رَبُّ السَّمَاوَاتِ وَالْأَرْضِ — مركّبة\nفي السنة: 4 شواهد (5 روايات)\nخصوصية الورود في السنة: في دعاء الكرب «لا إله إلا الله رب السماوات ورب الأرض» (مسلم)، وذكر التضوّر من الليل، وكلمة أصحاب الكهف ﴿رَبُّنَا رَبُّ السَّمَاوَاتِ وَالْأَرْضِ﴾ التي احتج بها ابن عباس، ودعاء دخول القرية.","teaches":"1. أن ربوبيته تشمل موضع كربك وقريتك الجديدة.\n2. أن كلمة الفتية كانت هذا الاسم.","whenRecall":"- عند دخول بلد.\n- في الكرب والتضوّر.\n- حين تُدعى إلى الشرك: كلمة الفتية.","whenPray":"عند الشعور بـ:\n1. الغربة في بلد جديد.\n2. الكرب.\nعند طلب:\n1. خير البلد وأهله.\nعند الرغبة في:\n1. الثبات كالفتية.","duaItems":"دعاء دخول القرية: «اللهم رب السماوات والأرض وما أظللن، ورب الرياح وما ذرين، ورب الأرضين وما أقللن، ورب الشياطين وما أضللن، أسألك من خير هذه القرية ومن خير أهلها، وأعوذ بك من شرها وشر أهلها وشر ما فيها» — تخريج مشكل الآثار 2528 (إسناده حسن).","summary":"«رب السماوات والأرض» في السنة اسم الكرب والتضوّر ودخول البلد، وكلمة فتية الكهف."},"situations":[{"situationId":1,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"الكرب الشديد واستحضار ربوبيةٍ تشمل موضعك","bridge":"أطبق عليك الأمر؟ دعاء الكرب النبوي: «لا إله إلا الله العظيم الحليم، لا إله إلا الله رب العرش العظيم، لا إله إلا الله رب السماوات ورب الأرض ورب العرش الكريم» — التهليلة الثالثة تنزل من العرش إلى السماوات والأرض: ربوبيةٌ تشمل موضع المكروب؛ فتلك خاتمة دعاء الكرب."}]},{"situationId":32,"verses":[{"i":2,"strength":"direct","headline":"مواجهة سلطةٍ تعلم الحق وتجحده","bridge":"تواجه سلطةً تعلم الحق وتجحده؟ موسى لفرعون: ﴿لَقَدْ عَلِمْتَ مَا أَنْزَلَ هَؤُلَاءِ إِلَّا رَبُّ السَّمَاوَاتِ وَالْأَرْضِ بَصَائِرَ وَإِنِّي لَأَظُنُّكَ يَا فِرْعَوْنُ مَثْبُورًا﴾ — واجهه بأنه يجحد عن علم لا عن جهل؛ فأخطر ما تواجهه سلطةٌ تعلم، وأقوى ما تقوله لها: لقد علمتَ."}],"hadiths":[{"i":3,"strength":"direct","headline":"مطالبتك بولاءٍ لذي سلطانٍ على حساب دينك","bridge":"يُطلب منك ولاءٌ على حساب دينك؟ فتية الكهف قاموا فقالوا: ﴿رَبُّنَا رَبُّ السَّمَاوَاتِ وَالْأَرْضِ لَن نَّدْعُوَ مِن دُونِهِ إِلَٰهًا﴾."}]},{"situationId":96,"verses":[{"i":1,"strength":"direct","headline":"الاعتماد على الوسائط بينك وبين ربك","bridge":"تريد قاعدةً تسقط بها كل الوسائط؟ ﴿قُلْ مَنْ رَبُّ السَّمَاوَاتِ وَالْأَرْضِ قُلِ اللَّهُ قُلْ أَفَاتَّخَذْتُمْ مِنْ دُونِهِ أَوْلِيَاءَ لَا يَمْلِكُونَ لِأَنْفُسِهِمْ نَفْعًا وَلَا ضَرًّا﴾ — سؤالٌ وجواب من المتكلم نفسه لأن الجواب بدهي، ثم الإلزام؛ فمن لا يملك لنفسه نفعًا ولا ضرًّا لا يصلح وليًّا لك."}],"hadiths":[]},{"situationId":118,"verses":[{"i":3,"strength":"direct","headline":"الخوف من عدم الثبات في موقفٍ صعب على الدين","bridge":"تخاف ألا تثبت في موقفٍ صعب؟ فتية الكهف قاموا في وجه دولةٍ وثنية بعد أن ﴿رَبَطْنَا عَلَى قُلُوبِهِمْ إِذْ قَامُوا فَقَالُوا رَبُّنَا رَبُّ السَّمَاوَاتِ وَالْأَرْضِ﴾ — الثبات عطيةٌ سبقت الموقف: رُبط على قلوبهم ثم قاموا؛ فقبل أن تقف اسأل الربط على القلب."}],"hadiths":[]},{"situationId":135,"verses":[{"i":4,"strength":"direct","headline":"الصدع بالحق أمام قومٍ متمسكين بموروث الآباء","bridge":"تواجه قومك بالحق بعد أن كسرت باطلهم؟ إبراهيم قال: ﴿بَلْ رَبُّكُمْ رَبُّ السَّمَاوَاتِ وَالْأَرْضِ الَّذِي فَطَرَهُنَّ وَأَنَا عَلَى ذَلِكُمْ مِنَ الشَّاهِدِينَ﴾ — بيانٌ وشهادةٌ وموقف؛ فلا يكفي أن تعرف الحق أمام السلطة: كن من الشاهدين عليه."}],"hadiths":[]},{"situationId":157,"verses":[],"hadiths":[{"i":2,"strength":"direct","headline":"الأرق والتقلّب في الفراش أثناء الليل","bridge":"تقلّبتَ في فراشك ليلًا؟ «كان إذا تضوّر من الليل قال: لا إله إلا الله الواحد القهار، رب السماوات والأرض وما بينهما العزيز الغفار» — الاسم في وسط ذكر الليل بين القهر والمغفرة؛ فقلها عند كل تقلّب."}]},{"situationId":160,"verses":[],"hadiths":[{"i":4,"strength":"direct","headline":"الانتقال إلى بلدٍ جديد أو نزول مكانٍ غريب","bridge":"تنتقل إلى بلد جديد؟ كان النبي ﷺ إذا رأى قرية يريد نزولها قال: «اللهم رب السماوات والأرض وما أظللن… أسألك من خير هذه القرية ومن خير أهلها وأعوذ بك من شرها وشر أهلها»."}]}]},{"id":178,"name":"رب السماوات والأرض وما بينهما ورب المشارق","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: رَبُّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ الْمَشَارِقِ — مركّبة | المواضع: 1 (الصافات: 5)\nخصوصية: أُضيفت «رب المشارق» بالجمع إلى الربوبية الشاملة — تنبيهًا على التدبير المتجدد يوميًّا.\n\nالمعنى: ربُّ العوالم الثلاثة، ومالكُ كل مشرقٍ من مشارق الشمس على مدار السنة.","teaches":"الحقائق التي كشفها الموضع:\n1. الوحدانية مع تجدد التدبير — لا جمود.\n2. تعدد المشارق دقةٌ فلكية يومية.\n3. البرهان على الوحدانية ربوبيةٌ شاملة.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند كل شروق.\n- عند تصور الوحدانية جمودًا.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. التسبيح عند الشروق: ﴿وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ الشَّمْسِ﴾.\n2. تجديد التوحيد بتأمل تجدد التدبير.","summary":"إلهٌ واحد وتدبيرٌ متجدد: ﴿رَبُّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ الْمَشَارِقِ﴾ — كل يومٍ مشرقٌ جديد من ربٍّ واحد.","verses":[{"i":1,"of":1,"s":37,"surah":"الصافات","a":5,"text":"رَبُّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ الْمَشَارِقِ","prev":{"a":4,"text":"إِنَّ إِلَهَكُمْ لَوَاحِدٌ"},"next":{"a":6,"text":"إِنَّا زَيَّنَّا السَّمَاءَ الدُّنْيَا بِزِينَةٍ الْكَوَاكِبِ"},"context":"﴿إِنَّ إِلَهَكُمْ لَوَاحِدٌ * رَبُّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ الْمَشَارِقِ﴾ — بعد القسم بالصافات صفًّا.","reason":"بعد إثبات الوحدانية جاء البرهان بالربوبية: عوالمُ ثلاثة ومشارقُ متعددة — كلها لربٍّ واحد؛ وذكرُ «المشارق» بالجمع يبرز أن الوحدانية لا تعني جمودًا: تدبيرٌ متجدد كل يومٍ بمشرقٍ مختلف.","adds":"وحدانيةُ المدبِّر لا تعني تكرار التدبير: كل يومٍ مشرقٌ جديد من ربٍّ واحد."}],"hadiths":[],"situations":[{"situationId":175,"verses":[{"i":1,"strength":"direct","headline":"التأمل في السماوات والأرض وتجدّد المشارق","bridge":"تتأمل السماء والأرض؟ ﴿إِنَّ إِلَهَكُمْ لَوَاحِدٌ * رَبُّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ الْمَشَارِقِ﴾ — عوالم ثلاثة ومشارق متعددة لربٍّ واحد؛ و«المشارق» بالجمع تبرز أن الوحدانية لا تعني جمودًا: كل يومٍ مشرقٌ جديد من ربٍّ واحد."}],"hadiths":[]}]},{"id":179,"name":"رب هذه البلدة","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: رَبَّ هَذِهِ الْبَلْدَةِ الَّذِي حَرَّمَهَا — مضافة | المواضع: 1 (النمل: 91)\nخصوصية: أُضيفت الربوبية إلى مكة مع وصف التحريم — تشريفًا للمكان بنسبته إلى ربه.\n\nالمعنى:\n- رب هذه البلدة الذي حرمها: مالكُ مكة الذي جعلها حرمًا آمنًا — فحرمتُها من جعله لا من ذاتها.","teaches":"الحقائق التي كشفها الموضع:\n1. حرمة المكان من تحريم ربه لا من ذاته.\n2. الخصوصية تشريفٌ لا تحديدٌ للملك: ﴿وَلَهُ كُلُّ شَيْءٍ﴾.\n3. الإسلام أمرٌ مقرون بالعبادة: ﴿وَأُمِرْتُ أَنْ أَكُونَ مِنَ الْمُسْلِمِينَ﴾.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند دخول الحرم أو الحج والعمرة.\n- عند تعظيم المكان دون ربه.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. تعظيم حرمات الله في الحرم.\n2. دعاء إبراهيم لمكة: ﴿رَبِّ اجْعَلْ هَذَا بَلَدًا آمِنًا﴾ — البقرة 126.\n3. سؤال الثبات على الإسلام.","summary":"حرمةُ البلدة من ربها لا من حجارتها: ﴿رَبَّ هَذِهِ الْبَلْدَةِ الَّذِي حَرَّمَهَا وَلَهُ كُلُّ شَيْءٍ﴾ — تشريفٌ للمكان بنسبته إليه.","verses":[{"i":1,"of":1,"s":27,"surah":"النمل","a":91,"text":"إِنَّمَا أُمِرْتُ أَنْ أَعْبُدَ رَبَّ هَذِهِ الْبَلْدَةِ الَّذِي حَرَّمَهَا وَلَهُ كُلُّ شَيْءٍ وَأُمِرْتُ أَنْ أَكُونَ مِنَ الْمُسْلِمِينَ","prev":{"a":90,"text":"وَمَنْ جَاءَ بِالسَّيِّئَةِ فَكُبَّتْ وُجُوهُهُمْ فِي النَّارِ هَلْ تُجْزَوْنَ إِلَّا مَا كُنْتُمْ تَعْمَلُونَ"},"next":{"a":92,"text":"وَأَنْ أَتْلُوَ الْقُرْآنَ فَمَنِ اهْتَدَى فَإِنَّمَا يَهْتَدِي لِنَفْسِهِ وَمَنْ ضَلَّ فَقُلْ إِنَّمَا أَنَا مِنَ الْمُنْذِرِينَ"},"reason":"أُضيفت الربوبية إلى البلدة تذكيرًا لأهلها بأن حرمتهم وأمنهم من ربها — ثم عُمّمت فورًا: ﴿وَلَهُ كُلُّ شَيْءٍ﴾ لئلا يُظن اختصاصُه بمكان؛ فالخصوصيةُ في التشريف لا في الملك.","adds":"حرمةُ الأماكن المقدسة من جعل الله لا من ذاتها — فمن انتهك حرمة مكة انتهك أمر ربها لا حجرًا."}],"hadiths":[],"situations":[{"situationId":166,"verses":[{"i":1,"strength":"direct","headline":"قصد البلد الحرام وتعظيم حرمته","bridge":"حضر موسم الحج وأنت في البلدة الحرام؟ ﴿إِنَّمَا أُمِرْتُ أَنْ أَعْبُدَ رَبَّ هَذِهِ الْبَلْدَةِ الَّذِي حَرَّمَهَا وَلَهُ كُلُّ شَيْءٍ﴾ — حرمتها وأمنها من ربها لا من ذاتها؛ فاعمر موسمك بعبادة ربّ البلدة، ومن انتهك حرمتها انتهك أمر ربها لا حجرًا."}],"hadiths":[]}]},{"id":180,"name":"الكريم","compound":false,"meaning":"بطاقة الاسم:\nالصيغة: الْكَرِيمِ — مفردة | المواضع: 1 (الانفطار: 6)\nخصوصية: جاء في أرقّ عتابٍ في القرآن — عتابٌ يُذكر فيه كرمُ المعاتِب لا سلطانه.\n\nالمعنى:\n- الكريم: كثير الخير، الجواد المعطي بلا مقابل، الذي يعفو ويستر ويعطي فوق ما يُسأل.","teaches":"الحقائق التي كشفها الموضع:\n1. العتاب بالكرم أبلغ من العتاب بالسلطان.\n2. تسويتك وتعديلك وتركيبك في أحسن صورةٍ من كرمه.\n3. كرمُ الله لا ينبغي أن يكون سبب جرأتك عليه.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- ساعةَ تهمّ بمعصية.\n- عند التأمل في تمام خلقتك.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. الحياء من الكريم عند الهمّ بالذنب — الانفطار 6.\n2. سؤال الكريم من كرمه: «يا كريم» — فهو نداءٌ يليق بالطلب.\n3. شكر تمام الخلقة والتسوية.","summary":"أرقُّ عتابٍ في القرآن: ﴿مَا غَرَّكَ بِرَبِّكَ الْكَرِيمِ﴾ — عاتبك بكرمه لا بسلطانه، فأيُّهما أدعى للحياء؟","verses":[{"i":1,"of":1,"s":82,"surah":"الانفطار","a":6,"text":"يَا أَيُّهَا الْإِنْسَانُ مَا غَرَّكَ بِرَبِّكَ الْكَرِيمِ","prev":{"a":5,"text":"عَلِمَتْ نَفْسٌ مَا قَدَّمَتْ وَأَخَّرَتْ"},"next":{"a":7,"text":"الَّذِي خَلَقَكَ فَسَوَّاكَ فَعَدَلَكَ"},"context":"﴿يَا أَيُّهَا الْإِنْسَانُ مَا غَرَّكَ بِرَبِّكَ الْكَرِيمِ * الَّذِي خَلَقَكَ فَسَوَّاكَ فَعَدَلَكَ * فِي أَيِّ صُورَةٍ مَا شَاءَ رَكَّبَكَ﴾.","reason":"عتابٌ يُذكر فيه أرقُّ الأوصاف لا أشدُّها: لم يقل: بربك الجبار، بل ﴿الْكَرِيمِ﴾ — فالسؤال: ما الذي جرّأك على من كرمُه هو صفتُه معك؟ ثم يعدّد كرمه في خلقك: خلقًا فتسويةً فتعديلًا فتركيبًا في أي صورةٍ شاء.","adds":"قال بعض السلف في جواب السؤال: غرّه كرمُ الكريم — فكرمُه هو الذي جرّأك، وذاك أدعى للحياء لا للاستمرار."}],"hadiths":[{"i":1,"of":8,"text":"أنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ قرأَ هذهِ الآيةَ ذاتَ يومٍ على المنبرِ { وَمَا قَدَرُوا اللَّهَ حَقَّ قَدْرِهِ وَالْأَرْضُ جَمِيعًا قَبْضَتُهُ يَوْمَ الْقِيَامَةِ وَالسَّمَاوَاتُ مَطْوِيَّاتٌ بِيَمِينِهِ سُبْحَانَهُ وَتَعَالَى عَمَّا يُشْرِكُونَ} ورسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يقولُ هكذا بيدِه ويُحَرِّكُها يُقْبِلُ بها ويُدْبِرُ يُمَجِّدُ الرَّبُّ نفسَه أنا الجبارُ أنا المتكبرُ أنا العزيزُ أنا الكريمُ فَرَجَفَ برسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ المنبرُ حتى قُلنا ليَخُرَّنَّ بهِ","narrator":"عبدالله بن عمر","source":"السلسلة الصحيحة 7/596","grade":"صحيح","judgment":"إسناده صحيح على شرط مسلم","url":"https://dorar.net/h/vEVU1mWm","nameForm":"الكريمُ","scene":"ابن عمر: قرأ النبي ﷺ على المنبر ﴿وَمَا قَدَرُوا اللَّهَ حَقَّ قَدْرِهِ وَالْأَرْضُ جَمِيعًا قَبْضَتُهُ يَوْمَ الْقِيَامَةِ وَالسَّمَاوَاتُ مَطْوِيَّاتٌ بِيَمِينِهِ﴾ ويقول هكذا بيده يحركها: «يمجّد الرب نفسه: أنا الجبار، أنا المتكبر، أنا العزيز، أنا الكريم» — فرجف المنبر حتى قلنا ليخرّن به.","reason":"الله يمجّد نفسه بأربعة، آخرها الكريم بعد الجبار والمتكبر والعزيز: جبروتٌ وكبرياء وعزة تنتهي إلى كرم — فالكرم مع القهر لا بدله. ورجفة المنبر من هيبة التمجيد.","adds":"الاسم في تمجيد الله لنفسه على لسان نبيه حتى رجف المنبر: كرمٌ يُختم به الجبروت."},{"i":2,"of":8,"text":"«لمَّا ماتَ أبو طالِبٍ خَرَجَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ إلى الطَّائِفِ ماشِيًا على قَدَمَيه، فدَعا لهم إلى اللهِ، فلم يُجيبوه، فأتى ظِلَّ شَجَرةٍ فصلَّى تحتَها رَكْعتَينِ، ثُمَّ قالَ: اللَّهُمَّ إليك أَشْكو ضَعْفي وهَواني على النَّاسِ، أَرحَمَ الرَّاحِمينَ إلى مَن تَكِلُني، إلى بَعيدٍ يَتَجَهَّمُني أم إلى قَريبٍ مَلَّكْتَه أمْري، فإن لم تكنْ ساخِطًا عليَّ فلا أُبالي، لك العُتْبى حتَّى تَرْضى، ولا حَوْلَ ولا قُوَّةَ إلَّا بك، أَعوذُ بنورِ وَجْهِك الكَريمِ الَّذي أضاءَتْ له السَّمواتُ وأَشرَقَتْ له الظُّلُماتُ وصَلَحَ عليه أمْرُ الدُّنْيا والآخِرةِ أن يَنزِلَ عليَّ غَضَبُك أو يَحِلَّ عليَّ سَخَطُك».\nوفي رِوايةٍ: لمَّا تُوفِّيَ أبو طالِبٍ، وعِنْدَه: فدَعاهم إلى الإسْلامِ فلم يُجيبوه، فانْصَرَفَ، فأتى ظِلَّ شَجَرةٍ فصلَّى رَكْعَتَينِ، ثُمَّ قالَ: اللَّهُمَّ إليك أَشْكو ضَعْفَ قُوَّتي وقِلَّةَ حيلتي وهَواني على النَّاسِ، أَرحَمَ الرَّاحِمينَ أنت أَرحَمُ الرَّاحِمينَ إلى مَن تَكِلُني إلى عَدُوٍّ يَتَجَهَّمُني أم إلى قَريبٍ مَلَّكْتَه أمْري، إن لم تكنْ غَضبانَ عليَّ فلا أُبالي، غَيْرَ أنَّ عافيتَك أَوْسَعُ لي، أَعوذُ بنورِ وَجْهِك الَّذي أَشرَقَتْ له الظُّلُماتُ وصَلَحَ عليه أمْرُ الدُّنْيا والآخِرةِ أن يَنزِلَ بي غَضَبُك أو يَحِلَّ عليَّ سَخَطُك، لك العُتْبى حتَّى تَرْضى، ولا حَوْلَ ولا قُوَّةَ إلَّا بك».","narrator":"عبدالله بن جعفر بن أبي طالب","source":"الأحاديث المختارة 9 / 180","grade":"صحيح","judgment":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","url":"https://dorar.net/h/KoUQeI8l","nameForm":"الكَريمِ","scene":"دعاء الطائف: «…أعوذ بنور وجهك الكريم الذي أضاءت له السماوات وأشرقت له الظلمات وصلح عليه أمر الدنيا والآخرة أن ينزل عليّ غضبك أو يحل عليّ سخطك».","reason":"في أشد الوحدة يُستعاذ بنور وجهه الكريم من غضبه: الكرم في وجهه يُلجأ إليه من سخطه.","adds":"يُري الاسم في استعاذة الطائف."},{"i":3,"of":8,"text":"نَزَلَ جِبريلُ عليه السَّلامُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ بهذا الدُّعاءِ مِنَ السَّماءِ، وأنَّ جِبريلَ جاءَ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في أَحسنِ صورةٍ، لمْ يَنزِلْ في مِثلِها قَطُّ ضاحِكًا مُستبشِرًا، فقالَ: السَّلامُ عليكَ يا مُحمَّدُ، قالَ: وعليكَ السَّلامُ يا جِبريلُ، قالَ: إنَّ اللهَ بَعَثَني إليكَ بهديَّةٍ، قالَ: وما تلكَ الهديَّةُ يا جِبريلُ؟ قالَ: كلماتٌ مِن كُنوزِ العَرشِ، أَكْرَمَكَ اللهُ بهِنَّ، قالَ: وما هُنَّ يا جِبريلُ؟ قالَ: فقالَ جِبريلُ: قلْ: يا مَنْ أَظْهَرَ الجميلَ وسَتَرَ القبيحَ، يا مَنْ لا يُؤاخِذُ بالجَريرةِ، ولا يَهتِكُ السِّترَ يا عظيمَ العفوِ، يا حَسَنَ التَّجاوزِ، يا واسعَ المغفرةِ، يا باسطَ اليَدينِ بالرَّحمةِ، يا صاحبَ كُلِّ نَجوى، ويا مُنتَهى كُلِّ شَكوى، يا كريمَ الصَّفحِ، يا عظيمَ المَنِّ، يا مُبتدِئَ النِّعمِ قبلَ استِحْقاقِها، يا ربَّنا، ويا سيِّدَنا، ويا مَولانا، ويا غايةَ رغْبَتِنا، أَسألُكَ يا اللهُ أنْ لا تَشوِيَ خَلْقي بالنَّارِ، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: فما ثوابُ هذه الكلماتِ؟ ثُمَّ ذَكَرَ باقيَ الحديثِ بعدَ الدُّعاءِ بطولِهِ.","narrator":"[عبدالله بن عمرو]","source":"المستدرك على الصحيحين 2024","grade":"صحيح","judgment":"صحيح الإسناد فإن رواته كلهم مدنيون ثقات","url":"https://dorar.net/h/7NiQCPgZ","nameForm":"كريمَ","scene":"دعاء جبريل: «…يا كريم الصفح، يا عظيم المن، يا مبتدئ النعم قبل استحقاقها».","reason":"الكرم مضاف إلى الصفح: كريمٌ في عفوه — الصفح الكريم لا يُعيّر ولا يذكّر.","adds":"يعطي الاسم مضافًا في نداء العفو."},{"i":4,"of":8,"text":"كَتَب لي عَلِيُّ بنُ أبي طالِبٍ رَضِيَ اللهُ عنه كِتابًا قال: أمَرَني به رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، قال: إذا أخَذْتَ مَضجَعَك فقُلْ: أعوذُ بوَجْهِك الكَريمِ وكَلِماتِك التَّامَّةِ، مِن شَرِّ ما أنت آخِذٌ بناصيتِه، اللَّهُمَّ أنت تَكشِفُ المغرَمَ والمأثَمَ، اللَّهُمَّ لا يُهزَمُ جُندُك، ولا يُخلَفُ وَعدُك، ولا يَنفَعُ ذا الجَدِّ منك الجَدُّ، سُبحانَك وبحَمْدِك.","narrator":"علي بن أبي طالب","source":"الأسماء والصفات للبيهقي 2/33","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/NQEZ5vj9","nameForm":"الكَريمِ","scene":"علي: كتب لي كتابًا أمره به النبي ﷺ: «إذا أخذت مضجعك فقل: أعوذ بوجهك الكريم وكلماتك التامة من شر ما أنت آخذ بناصيته، اللهم أنت تكشف المغرم والمأثم، اللهم لا يُهزم جندك ولا يُخلف وعدك ولا ينفع ذا الجد منك الجد، سبحانك وبحمدك».","reason":"عند المضجع يُستعاذ بوجهه الكريم مع كلماته التامة: النائم يلجأ إلى كرم الوجه ليحفظه.","adds":"يعطي الاسم ذكر المضجع."},{"i":5,"of":8,"text":"«أنَّه زَوَّجَ ابْنَتَه مِن الحَجَّاجِ بنِ يوسُفَ، فقالَ لها: إذا دَخَلَ بك فقولي: لا إلهَ إلَّا اللهُ الحَليمُ الكَريمُ، سُبْحانَ اللهِ رَبِّ العَرْشِ العَظيمِ، الحَمْدُ للهِ رَبِّ العالَمينَ، وزَعَمَ أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ كانَ إذا حَزَبَه أمْرٌ قالَ هذا.\nقالَ حَمَّادٌ: فظَنَنْتُ أنَّه قالَ: فلم يَصِلْ إليها».","narrator":"عبدالله بن جعفر بن أبي طالب","source":"الأحاديث المختارة 9 / 174","grade":"صحيح","judgment":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","url":"https://dorar.net/h/qQcgRWlZ","nameForm":"الكَريمُ","scene":"عبد الله بن جعفر لابنته قبل الحجاج: «قولي: لا إله إلا الله الحليم الكريم، سبحان الله رب العرش العظيم، الحمد لله رب العالمين» — وكان النبي ﷺ يقولها إذا حزبه أمر، فقالتها فلم يصل إليها.","reason":"«الحليم الكريم» في كلمات الجهد: حلمٌ لا يعجل، وكرمٌ يعطي المكروب فوق طلبه.","adds":"يُري الاسم حصنًا أمام ظالم."},{"i":6,"of":8,"text":"«قالَ في شَأنِ هؤلاء الكَلِماتِ: لا إلهَ إلَّا اللهُ الحَليمُ الكَريمُ، سُبْحانَ اللهِ رَبِّ العَرْشِ العَظيمِ، الحَمْدُ للهِ رَبِّ العالَمينَ، اللَّهُمَّ ارْحَمْني، اللَّهُمَّ تَجاوَزْ عنِّي، اللَّهُمَّ اعْفُ عنِّي، قالَ عَبْدُ اللهِ بنُ جَعْفَرٍ، أَخبَرَني عمِّي أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم علَّمَه هذه الكَلِماتِ».","narrator":"علي بن أبي طالب","source":"الأحاديث المختارة 561","grade":"صحيح","judgment":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","url":"https://dorar.net/h/rj3jt9g4","nameForm":"الكَريمُ","scene":"عبد الله بن جعفر: أخبرني عمي علي أن رسول الله ﷺ علّمه هذه الكلمات: «لا إله إلا الله الحليم الكريم، سبحان الله رب العرش العظيم، الحمد لله رب العالمين، اللهم ارحمني، اللهم تجاوز عني، اللهم اعف عني».","reason":"تبدأ الكلمات بالحليم الكريم ثم رحمةٌ وتجاوزٌ وعفو: الكرم مقدمة الطلب.","adds":"يعطي الاسم في كلماتٍ علّمها النبي ﷺ عليًّا."},{"i":7,"of":8,"text":"«يا علِيُّ، أَلَا أُعَلِّمُك كَلِماتٍ إذا قُلْتَهنَّ وعليك عَدَدُ الذَّرِّ مِن الخَطايا غُفِرَ لك، على أنَّه مَغْفورٌ لك؟ تقولُ: لا إلهَ إلَّا اللهُ العَليُّ العَظيمُ، لا إلهَ إلَّا اللهُ الحَليمُ الكَريمُ، سُبْحانَ اللهِ وتَبارَكَ اللهُ رَبُّ العَرْشِ العَظيمِ، الحَمْدُ للهِ رَبِّ العالَمينَ».","narrator":"علي بن أبي طالب","source":"الأحاديث المختارة 603","grade":"صحيح","judgment":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","url":"https://dorar.net/h/r5S0IaCP","nameForm":"الكَريمُ","scene":"«يا علي ألا أعلمك كلمات إذا قلتهن وعليك عدد الذر من الخطايا غُفر لك؟ لا إله إلا الله العلي العظيم، لا إله إلا الله الحليم الكريم، سبحان الله وتبارك الله رب العرش العظيم، الحمد لله رب العالمين».","reason":"التهليل بالحليم الكريم يمحو خطايا عدد الذر: الكرم لا يحاسب على العدد.","adds":"يقرن الاسم بمغفرة الخطايا الكثيرة."},{"i":8,"of":8,"text":"عن النبيِّ صلَّى اللهُ عليه وسلَّم أنه كان إذا دخل المسجدَ قال أعوذُ باللهِ العظيمِ ، وبوجهِهِ الكريمِ ، وبسلطانِهِ القديمِ ، من الشيطانِ الرجيمِ . قال : فإذا قال ذلك ، قال الشيطانُ : حُفِظَ مِنِّي سائرَ اليومِ","narrator":"عبدالله بن عمرو","source":"الكلم الطيب 66","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/jABPMEki","nameForm":"الكريمِ","scene":"عند دخول المسجد: «أعوذ بالله العظيم وبوجهه الكريم وبسلطانه القديم من الشيطان الرجيم» — فيقول الشيطان: حُفظ مني سائر اليوم.","reason":"الاستعاذة بوجهه الكريم تحفظ من الشيطان يومًا: الكرم في الحفظ لا في العطاء فقط.","adds":"يعطي الاسم ذكر دخول المسجد."}],"sunnah":{"card":"الصيغة: الْكَرِيمُ — مفردة\nفي السنة: 9 شواهد (16 رواية)\nخصوصية الورود في السنة: يمجّد الله نفسه بالاسم على المنبر: «أنا الجبار أنا المتكبر أنا العزيز أنا الكريم» حتى رجف المنبر؛ ويُستعاذ بوجهه الكريم في الطائف وعند المضجع وعند دخول المسجد؛ و«الحليم الكريم» في كلمات الكرب؛ و«يا كريم الصفح» في دعاء جبريل. روجعت مواضعه فحُذف ما جاء فيه «الكريم» وصفًا لغير الله.\nالمعنى المختصر: الجواد الذي لا ينفد عطاؤه، الرفيع الذي يُعطي بلا سؤال ويعفو بلا عتاب.","teaches":"1. أنه يمجّد نفسه بالكرم بعد الجبروت: كريمٌ مع القهر.\n2. أن وجهه الكريم يُستعاذ به من غضبه ومن الشيطان.\n3. أن كرمه يغفر خطايا عدد الذر.\n4. أن كرمه في الصفح: لا يعيّر.","whenRecall":"- عند المضجع: أعوذ بوجهك الكريم.\n- عند الكرب: الحليم الكريم.\n- عند دخول المسجد.\n- حين تقرأ آية الزمر 67.","whenPray":"عند الشعور بـ:\n1. الكرب والجهد.\n2. كثرة الخطايا.\n3. الخوف من الغضب الإلهي.\nعند طلب:\n1. الصفح الكريم.\n2. الحفظ بوجهه الكريم.\nعند الرغبة في:\n1. كلمات علي عند الكرب.","duaItems":"1. عند الكرب: «لا إله إلا الله الحليم الكريم، سبحان الله رب العرش العظيم، الحمد لله رب العالمين، اللهم ارحمني، اللهم تجاوز عني، اللهم اعف عني» — الأحاديث المختارة 561.\n2. عند المضجع: «أعوذ بوجهك الكريم وكلماتك التامة من شر ما أنت آخذ بناصيته…» — الأسماء والصفات 2/33 (إسناده صحيح).\n3. عند دخول المسجد: «أعوذ بالله العظيم وبوجهه الكريم وبسلطانه القديم من الشيطان الرجيم» — الكلم الطيب 66.","summary":"«الكريم» في السنة يمجّد الله به نفسه بعد الجبار والمتكبر والعزيز حتى رجف المنبر — ويُستعاذ بوجهه الكريم في الطائف والمضجع والمسجد، ويُهلَّل به في الكرب: الحليم الكريم."},"situations":[{"situationId":1,"verses":[],"hadiths":[{"i":6,"strength":"direct","headline":"طلب الرحمة والعفو حين يشتد عليك الأمر","bridge":"أطبق عليك الأمر؟ ادعُ بالكلمات التي علّمها النبي ﷺ عليًّا: «لا إله إلا الله الحليم الكريم، سبحان الله رب العرش العظيم، الحمد لله رب العالمين، اللهم ارحمني، اللهم تجاوز عني، اللهم اعف عني»."}]},{"situationId":6,"verses":[],"hadiths":[{"i":2,"strength":"direct","headline":"الوحدة والخذلان مع الخوف من سخط الله","bridge":"خذلك الجميع حتى صرت وحدك؟ في الطائف بعد رد أهلها دعا النبي ﷺ: «…أعوذ بنور وجهك الكريم الذي أضاءت له السماوات وأشرقت له الظلمات وصلح عليه أمر الدنيا والآخرة أن ينزل عليّ غضبك أو يحل عليّ سخطك» — في أشد الوحدة يُستعاذ بنور وجهه الكريم؛ فالكرم في وجهه يُلجأ إليه."}]},{"situationId":15,"verses":[],"hadiths":[{"i":3,"strength":"direct","headline":"طلب صفحٍ من الله لا تعيير فيه ولا تذكير","bridge":"تريد صفحًا لا يعيّر؟ نزل جبريل بدعاء: «…يا كريم الصفح، يا عظيم المن، يا مبتدئ النعم قبل استحقاقها» — الكرم مضاف إلى الصفح: كريمٌ في عفوه لا يعيّر ولا يذكّر؛ فتخلّق بكرم الصفح واسأله من كريم الصفح."}]},{"situationId":18,"verses":[],"hadiths":[{"i":7,"strength":"direct","headline":"كثرة الخطايا ورجاء كرمٍ لا يحاسب بالعدد","bridge":"خطاياك عدد الذر؟ «لا إله إلا الله الحليم الكريم…» — كلمات إذا قلتها وعليك عدد الذر من الخطايا غُفر لك."}]},{"situationId":21,"verses":[{"i":1,"strength":"direct","headline":"التمادي في المعصية اغترارًا بكرم الله وإمهاله","bridge":"يجرّئك على المعصية أن الله لم يعاجلك؟ اسمع العتاب بأرقّ الأوصاف: ﴿يَا أَيُّهَا الْإِنْسَانُ مَا غَرَّكَ بِرَبِّكَ الْكَرِيمِ﴾ — ﴿الَّذِي خَلَقَكَ فَسَوَّاكَ فَعَدَلَكَ﴾؛ فكرمه معك أدعى للحياء منه لا للاستمرار."}],"hadiths":[]},{"situationId":32,"verses":[],"hadiths":[{"i":5,"strength":"direct","headline":"الدخول على صاحب سلطةٍ تخاف بطشه","bridge":"تدخل على ظالمٍ تخاف بطشه؟ علّم عبد الله بن جعفر ابنته قبل الحجاج: «قولي: لا إله إلا الله الحليم الكريم، سبحان الله رب العرش العظيم، الحمد لله رب العالمين» — كلمات الجهد التي كان النبي ﷺ يقولها إذا حزبه أمر، فقالتها فلم يصل إليها؛ الحليم الكريم حصنٌ أمام ظالم."}]},{"situationId":157,"verses":[],"hadiths":[{"i":4,"strength":"direct","headline":"أخذ المضجع والاستعاذة من كل شرٍّ قبل النوم","bridge":"عند مضجعك؟ «أعوذ بوجهك الكريم وكلماتك التامة من شر ما أنت آخذ بناصيته» — كتاب علي بأمر النبي ﷺ."}]},{"situationId":159,"verses":[],"hadiths":[{"i":8,"strength":"direct","headline":"دخول المسجد والتحصّن من الشيطان سائر اليوم","bridge":"تدخل المسجد؟ كان النبي ﷺ إذا دخل المسجد قال: «أعوذ بالله العظيم وبوجهه الكريم وبسلطانه القديم من الشيطان الرجيم» فيقول الشيطان: حُفظ مني سائر اليوم — الاستعاذة بوجهه الكريم تحفظك يومًا كاملًا؛ فالكرم في الحفظ لا في العطاء فقط."}]},{"situationId":174,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"طلب تعظيم الله وهيبته في القلب","bridge":"تريد أن يكبر الله في قلبك؟ على المنبر قرأ النبي ﷺ آية طي السماوات وقال: «يمجّد الرب نفسه: أنا الجبار أنا المتكبر أنا العزيز أنا الكريم» — فرجف المنبر."}]}]},{"id":181,"name":"الحي","compound":false,"meaning":"بطاقة الاسم:\nالصيغة: الْحَيُّ — مفردة | المواضع: 1 (غافر: 65)\nخصوصية: وردت مفردةً هنا — بخلاف اقترانها بالقيوم في المواضع الأخرى — ومقرونةً بالأمر بالدعاء المخلص.\n\nالمعنى:\n- الحي: ذو الحياة الكاملة الدائمة التي لا يعتريها موتٌ ولا نقص.","teaches":"الحقائق التي كشفها الموضع:\n1. الدعاء لا يُوجَّه إلا لحيّ — والحيُّ الذي لا يموت واحد.\n2. شرط الدعاء: الإخلاص — ﴿مُخْلِصِينَ لَهُ الدِّينَ﴾.\n3. ختام الدعاء الحمد لله رب العالمين.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- قبل كل دعاء: لمن توجّه طلبك؟\n- عند رؤية من يدعو الأموات.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. إخلاص الدعاء له وحده — غافر 65.\n2. «يَا حَيُّ يَا قَيُّومُ بِرَحْمَتِكَ أَسْتَغِيثُ» — رواه الترمذي وحسّنه.\n3. ختم الدعاء بالحمد.","summary":"﴿هُوَ الْحَيُّ لَا إِلَهَ إِلَّا هُوَ فَادْعُوهُ مُخْلِصِينَ لَهُ الدِّينَ﴾ — الفاء برهان: الدعاء لا يليق إلا بحيٍّ لا يموت.","verses":[{"i":1,"of":1,"s":40,"surah":"غافر","a":65,"text":"هُوَ الْحَيُّ لَا إِلَهَ إِلَّا هُوَ فَادْعُوهُ مُخْلِصِينَ لَهُ الدِّينَ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ","prev":{"a":64,"text":"اللَّهُ الَّذِي جَعَلَ لَكُمُ الْأَرْضَ قَرَارًا وَالسَّمَاءَ بِنَاءً وَصَوَّرَكُمْ فَأَحْسَنَ صُوَرَكُمْ وَرَزَقَكُمْ مِنَ الطَّيِّبَاتِ ذَلِكُمُ اللَّهُ رَبُّكُمْ فَتَبَارَكَ اللَّهُ رَبُّ الْعَالَمِينَ"},"next":{"a":66,"text":"قُلْ إِنِّي نُهِيتُ أَنْ أَعْبُدَ الَّذِينَ تَدْعُونَ مِنْ دُونِ اللَّهِ لَمَّا جَاءَنِيَ الْبَيِّنَاتُ مِنْ رَبِّي وَأُمِرْتُ أَنْ أُسْلِمَ لِرَبِّ الْعَالَمِينَ"},"reason":"رُتّب الدعاءُ المخلص على الحياة: ﴿هُوَ الْحَيُّ... فَادْعُوهُ﴾ — فالدعاءُ لا يُوجَّه إلا لحيٍّ يسمع؛ وكلُّ من دُعي من دون الله إما ميتٌ أو جماد. ثم خُتم بالحمد: فالدعاء يُفتتح بالتوحيد ويُختم بالحمد.","adds":"الفاء في ﴿فَادْعُوهُ﴾ برهانٌ كامل: حيٌّ ← يُدعى؛ فمن دعا ميتًا فقد ناقض شرط الدعاء."}],"hadiths":[{"i":1,"of":5,"text":"لمَّا كان يَومُ بَدرٍ قاتلْتُ شَيئًا من قِتالٍ، ثمَّ جِئتُ مُسرِعًا لِأنظُرَ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ ما فَعَل، فجِئتُ فأجِدُه وهو ساجِدُ يَقولُ: يا حَيُّ يا قَيُّومُ لا يَزيدُ عَلَيها، فرَجَعتُ إلى القِتالِ، ثمَّ جِئتُ وهو ساجِدٌ يَقولُ ذلكَ، ثمَّ ذَهَبتُ إلى القِتالِ، ثمَّ جِئتُ وهو ساجِدٌ يَقولُ ذلكَ، فلم يَزَلْ يَقولُ ذلكَ حتَّى فَتَح اللهُ عليه.","narrator":"علي بن أبي طالب","source":"المستدرك على الصحيحين 905","grade":"صحيح","judgment":"صحيح الإسناد","url":"https://dorar.net/h/Z2d43e6Q","nameForm":"حَيُّ","scene":"علي: قاتلت يوم بدر ثم جئت مسرعًا لأنظر إلى النبي ﷺ فإذا هو ساجد يقول: «يا حي يا قيوم» — لا يزيد عليها، ثم رجعت فقاتلت ثم جئت فإذا هو كذلك، حتى فتح الله عليه.","reason":"في أشد ساعات المعركة يقتصر النبي ﷺ على الاسمين: الحي الذي لا يموت والجند يموتون، والقيوم الذي يقيم الصف. التكرار بلا زيادة يُري أن الاسم وحده كفاية.","adds":"الاسم وحده يُكرَّر في سجود بدر حتى الفتح."},{"i":2,"of":5,"text":"كانَ إذا نزلَ بِه همٌّ أو غمٌّ قالَ يا حيُّ يا قيُّومُ برحمتِك أستغيثُ","narrator":"عبدالله بن مسعود","source":"الجامع الصغير 6791","grade":"صحيح","url":"https://dorar.net/h/6l9IW4KZ","nameForm":"حيُّ","scene":"ابن مسعود: كان النبي ﷺ إذا نزل به همٌّ أو غمٌّ قال: «يا حي يا قيوم برحمتك أستغيث».","reason":"الاستغاثة بالحي: الهم يميت القلب فيُستغاث بالحياة التي لا تموت، والقيوم يقيم ما انهار — وبرحمته لا بحق العبد.","adds":"صيغة الاستغاثة عند الهم والغم."},{"i":3,"of":5,"text":"«قال النَّبيُّ صلَّى اللهُ عليه وسلَّم لفاطِمةَ رَضِيَ اللهُ عنها: ما يمنَعُك أن تَسْمَعي ما أوصيكِ به؛ أن تَقولي إذا أصبَحْتِ وإذا أمسَيتِ: يا حَيُّ يا قَيُّومُ، برَحْمَتِك أستَغيثُ، أصلِحْ لي شَأني كُلَّه، ولا تَكِلْني إلى نَفْسي طَرْفةَ عَينٍ».","narrator":"أنس بن مالك","source":"الأحاديث المختارة 2320","grade":"صحيح","judgment":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","url":"https://dorar.net/h/5Lk8rRlb","nameForm":"حَيُّ","scene":"أنس: قال النبي ﷺ لفاطمة: «ما يمنعك أن تسمعي ما أوصيك به: أن تقولي إذا أصبحت وإذا أمسيت: يا حي يا قيوم برحمتك أستغيث، أصلح لي شأني كله ولا تكلني إلى نفسي طرفة عين».","reason":"وصية للابنة صباحًا ومساءً بالاسم: من استغاث بالحي القيوم لم يُوكل إلى نفسه — والنفس تموت إن وُكلت إليها.","adds":"يعطي الاسم ورد فاطمة اليومي."},{"i":4,"of":5,"text":"كُنتُ جالِسًا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في الحَلْقةِ، ورَجُلٌ قائِمٌ يُصَلِّي. فلمَّا رَكَعَ وسَجَدَ جَلَسَ وتَشَهَّدَ، ثم دَعا، فقال: اللهمَّ إنِّي أسْألُكَ بأنَّ لكَ الحَمدَ لا إلَهَ إلَّا أنتَ، المنَّانُ، بَديعُ السَّمواتِ والأرْضِ، ذا الجَلالِ والإكْرامِ، يا حَيُّ يا قَيُّومُ، إنِّي أسألُكَ. فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: أتَدْرونَ بما دَعا؟، قالوا: اللهُ ورَسولُه أعلَمُ، قال: والذي نَفْسي بِيَدِه، لقد دَعا اللهَ بِاسمِه العَظيمِ الذي إذا دُعيَ به أجابَ، وإذا سُئِلَ به أَعطَى قال: عَفَّانُ: دَعا باسْمِه.","narrator":"أنس بن مالك","source":"تخريج المسند لشعيب 12611","grade":"صحيح","url":"https://dorar.net/h/ARVv1r24","nameForm":"حَيُّ","scene":"الرجل الذي دعا: «…بديع السماوات والأرض ذا الجلال والإكرام، يا حي يا قيوم، إني أسألك» فقال النبي ﷺ: «لقد دعا الله باسمه العظيم الذي إذا دُعي به أجاب».","reason":"الاسم الأعظم يُختم بيا حي يا قيوم: النداء بالحياة والقيومية آخر ما يُقال قبل السؤال.","adds":"يربط الاسم بالاسم الأعظم."},{"i":5,"of":5,"text":"عنِ ابنِ مسعودٍ قالَ لَمَّا بعثَ اللَّهُ موسى إلى فِرعونَ قال ربِّ أيُّ شَيءٍ أقولُ قال قُلْ أَهْيا شَرَاهْيا قال الأعمشَ تفسيرُ ذلكَ الحَيُّ قبلَ كلِّ شيءٍ والحَيُّ بعدَ كلِّ شيءٍ","narrator":"-","source":"الدر المنثور 10/196","grade":"حسن","judgment":"إسناده جيد","url":"https://dorar.net/h/NtPClmH2","nameForm":"الحَيُّ ؛ والحَيُّ","scene":"ابن مسعود: لما بعث الله موسى إلى فرعون قال: رب أي شيء أقول؟ قال: قل: أهيا شراهيا. قال الأعمش: تفسير ذلك: الحي قبل كل شيء، والحي بعد كل شيء.","reason":"كلمة موسى في وجه فرعون تفسيرها الحي قبل كل شيء وبعده: فرعون يموت والحي باق.","adds":"يُري الاسم في تعليم موسى قبل فرعون."}],"sunnah":{"card":"الصيغة: الْحَيُّ — مفردة، وردت نداءً «يا حي يا قيوم»\nفي السنة: 5 شواهد (9 روايات)\nخصوصية الورود في السنة: «يا حي يا قيوم برحمتك أستغيث» — دعاء الهم والغم والكرب، ودعاء بدر في العريش، والاسم الأعظم؛ وعلّمه النبي ﷺ فاطمة صباحًا ومساءً «ولا تكلني إلى نفسي طرفة عين»؛ وتفسير «أهيا شراهيا»: الحي قبل كل شيء والحي بعد كل شيء. روجعت مواضعه فحُذف ما جاء فيه «الحي» بمعنى القبيلة أو ضد الميت.\nالمعنى المختصر: الكامل الحياة الذي لا يموت، وكل حياةٍ منه.","teaches":"1. أن الاستغاثة به تكفي في بدر وفي الهم.\n2. أن من استغاث به لم يُوكل إلى نفسه.\n3. أنه الحي قبل كل شيء وبعد كل شيء.","whenRecall":"- عند الهم والغم: يا حي يا قيوم برحمتك أستغيث.\n- صباحًا ومساءً: وصية فاطمة.\n- في المعركة والكرب.","whenPray":"عند الشعور بـ:\n1. الهم والغم.\n2. الخوف من أن تُوكل إلى نفسك.\nعند طلب:\n1. إصلاح الشأن كله.\n2. الغوث.\nعند الرغبة في:\n1. الاقتصار على الاسم في الشدة كما في بدر.","duaItems":"1. «يا حي يا قيوم برحمتك أستغيث» — الجامع الصغير 6791، صحيح الجامع 4777.\n2. صباحًا ومساءً: «يا حي يا قيوم برحمتك أستغيث، أصلح لي شأني كله ولا تكلني إلى نفسي طرفة عين» — الأحاديث المختارة 2320.","summary":"«الحي» في السنة استغاثة: «يا حي يا قيوم برحمتك أستغيث» في سجود بدر وفي كل همّ، ووصية فاطمة صباحًا ومساءً «ولا تكلني إلى نفسي طرفة عين»."},"situations":[{"situationId":2,"verses":[],"hadiths":[{"i":2,"strength":"direct","headline":"نزول الهم والغم والحاجة إلى الاستغاثة","bridge":"أطبق عليك الأمر؟ كان النبي ﷺ إذا نزل به همٌّ أو غمٌّ قال: «يا حي يا قيوم برحمتك أستغيث» — الحي لا يموت والقيوم يقيم ما انهار."}]},{"situationId":31,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"اشتداد المعركة وإحاطة العدو بك","bridge":"يحاصرك عدو؟ في بدر لم يزد النبي ﷺ في سجوده على «يا حي يا قيوم» حتى فتح الله عليه."}]},{"situationId":32,"verses":[],"hadiths":[{"i":5,"strength":"direct","headline":"مواجهة طاغيةٍ متجبّرٍ يظن نفسه باقيًا","bridge":"تواجه طاغيةً يظن نفسه باقيًا؟ ابن مسعود: لما بعث الله موسى إلى فرعون قال: رب أي شيء أقول؟ قال: قل: أهيا شراهيا — تفسيره: الحي قبل كل شيء والحي بعد كل شيء — فرعون يموت والحي باق؛ فكلمة موسى في وجه فرعون اسم الحي."}]},{"situationId":94,"verses":[{"i":1,"strength":"direct","headline":"تعلّق القلب بفانٍ لا يملك حياةً ولا سمعًا","bridge":"تعلّق قلبك بمن لا يملك لنفسه حياة؟ الدعاء لا يُوجَّه إلا لحيٍّ يسمع: ﴿هُوَ الْحَيُّ... فَادْعُوهُ﴾ — وكل من دُعي من دون الله إما ميتٌ أو جماد؛ فمن دعا ميتًا أو تعلّق بفانٍ فقد ناقض شرط الدعاء، والحي وحده يستحق التعلق."}],"hadiths":[]},{"situationId":102,"verses":[],"hadiths":[{"i":3,"strength":"direct","headline":"الخوف من أن تُوكل إلى نفسك في شؤونك","bridge":"وردك صباحًا ومساءً؟ أوصى النبي ﷺ فاطمة: «يا حي يا قيوم برحمتك أستغيث، أصلح لي شأني كله ولا تكلني إلى نفسي طرفة عين»."}]},{"situationId":154,"verses":[],"hadiths":[{"i":4,"strength":"direct","headline":"ما تقوله قبل أن تسأل حاجتك في آخر الصلاة","bridge":"تريد أن تدعو بالاسم الأعظم؟ رجلٌ دعا بعد تشهده: «اللهم إني أسألك بأن لك الحمد، لا إله إلا أنت، المنان، بديع السماوات والأرض، ذا الجلال والإكرام، يا حي يا قيوم، إني أسألك» فقال النبي ﷺ: «لقد دعا الله باسمه العظيم الذي إذا دُعي به أجاب» — النداء بالحياة والقيومية آخر ما يُقال قبل السؤال."}]}]},{"id":182,"name":"الرقيب","compound":false,"meaning":"بطاقة الاسم:\nالصيغة: رَقِيبًا / الرَّقِيبَ | المواضع: 2 (النساء: 1 — المائدة: 117)\nخصوصية: مرةً في فاتحة سورة الحقوق الأسرية، ومرةً في شهادة عيسى — فهو اسمُ الرقابة على الأرحام وعلى الأتباع.\n\nالمعنى:\n- الرقيب: الحافظ المطّلع الذي لا يغفل عن شيء.","teaches":"الحقائق التي كشفها الموضعان:\n1. حقوق الأرحام تحت رقابةٍ خاصة.\n2. الرقابة بعد الموت لله وحده — لا للأنبياء ولا للصالحين.\n3. الناس كلهم من نفسٍ واحدة — فالقطيعة قطعٌ للأصل.","whenRecall":"لحظات الاستحضار — مشتقة من موضعيه:\n- عند التهاون بصلة رحمٍ لا يلومك عليها أحد.\n- عند دعوى اطلاع الأموات على الأحياء.","whenPray":"بنود الدعاء — مشتقة من سياق الموضعين:\n1. سؤال التوفيق لصلة الرحم — النساء 1.\n2. استحضار الرقيب في الخلوات.\n3. التبرؤ من دعاء الأموات ورجائهم.","summary":"أول ما قُرن بالأرحام: ﴿إِنَّ اللَّهَ كَانَ عَلَيْكُمْ رَقِيبًا﴾ — فقطيعةُ الرحم تقع بصمتٍ لا يحاسب عليه أحد إلا الرقيب.","verses":[{"i":1,"of":2,"s":4,"surah":"النساء","a":1,"text":"يَا أَيُّهَا النَّاسُ اتَّقُوا رَبَّكُمُ الَّذِي خَلَقَكُمْ مِنْ نَفْسٍ وَاحِدَةٍ وَخَلَقَ مِنْهَا زَوْجَهَا وَبَثَّ مِنْهُمَا رِجَالًا كَثِيرًا وَنِسَاءً وَاتَّقُوا اللَّهَ الَّذِي تَسَاءَلُونَ بِهِ وَالْأَرْحَامَ إِنَّ اللَّهَ كَانَ عَلَيْكُمْ رَقِيبًا","next":{"a":2,"text":"وَآتُوا الْيَتَامَى أَمْوَالَهُمْ وَلَا تَتَبَدَّلُوا الْخَبِيثَ بِالطَّيِّبِ وَلَا تَأْكُلُوا أَمْوَالَهُمْ إِلَى أَمْوَالِكُمْ إِنَّهُ كَانَ حُوبًا كَبِيرًا"},"context":"﴿يَا أَيُّهَا النَّاسُ اتَّقُوا رَبَّكُمُ الَّذِي خَلَقَكُمْ مِنْ نَفْسٍ وَاحِدَةٍ... وَاتَّقُوا اللَّهَ الَّذِي تَسَاءَلُونَ بِهِ وَالْأَرْحَامَ إِنَّ اللَّهَ كَانَ عَلَيْكُمْ رَقِيبًا﴾.","reason":"افتُتحت سورةُ النساء — سورةِ الحقوق الدقيقة — بتقوى الله والأرحام، وخُتمت الآيةُ بالرقيب: فحقوقُ الأرحام والأيتام والنساء تجري في الخفاء ولا يحصيها إلا رقيب. والأصلُ واحد: ﴿مِنْ نَفْسٍ وَاحِدَةٍ﴾.","adds":"أول ما يُذكر مع الأرحام: الرقابة — لأن قطيعة الرحم تقع بصمتٍ لا يحاسب عليه أحد."},{"i":2,"of":2,"s":5,"surah":"المائدة","a":117,"text":"مَا قُلْتُ لَهُمْ إِلَّا مَا أَمَرْتَنِي بِهِ أَنِ اعْبُدُوا اللَّهَ رَبِّي وَرَبَّكُمْ وَكُنْتُ عَلَيْهِمْ شَهِيدًا مَا دُمْتُ فِيهِمْ فَلَمَّا تَوَفَّيْتَنِي كُنْتَ أَنْتَ الرَّقِيبَ عَلَيْهِمْ وَأَنْتَ عَلَى كُلِّ شَيْءٍ شَهِيدٌ","prev":{"a":116,"text":"وَإِذْ قَالَ اللَّهُ يَا عِيسَى ابْنَ مَرْيَمَ أَأَنْتَ قُلْتَ لِلنَّاسِ اتَّخِذُونِي وَأُمِّيَ إِلَهَيْنِ مِنْ دُونِ اللَّهِ قَالَ سُبْحَانَكَ مَا يَكُونُ لِي أَنْ أَقُولَ مَا لَيْسَ لِي بِحَقٍّ إِنْ كُنْتُ قُلْتُهُ فَقَدْ عَلِمْتَهُ تَعْلَمُ مَا فِي نَفْسِي وَلَا أَعْلَمُ مَا فِي نَفْسِكَ إِنَّكَ أَنْتَ عَلَّامُ الْغُيُوبِ"},"next":{"a":118,"text":"إِنْ تُعَذِّبْهُمْ فَإِنَّهُمْ عِبَادُكَ وَإِنْ تَغْفِرْ لَهُمْ فَإِنَّكَ أَنْتَ الْعَزِيزُ الْحَكِيمُ"},"context":"عيسى يوم القيامة: ﴿وَكُنْتُ عَلَيْهِمْ شَهِيدًا مَا دُمْتُ فِيهِمْ فَلَمَّا تَوَفَّيْتَنِي كُنْتَ أَنْتَ الرَّقِيبَ عَلَيْهِمْ وَأَنْتَ عَلَى كُلِّ شَيْءٍ شَهِيدٌ﴾.","reason":"سلّم عيسى الرقابةَ لصاحبها بعد رفعه: فالرقابةُ على الأتباع ليست للأنبياء بعد موتهم — بل لله وحده؛ وفي هذا نفيٌ لكل دعوى اطّلاعٍ للأموات على أحوال الأحياء.","adds":"الأموات — ولو كانوا أنبياء — لا يرقبون الأحياء: ﴿فَلَمَّا تَوَفَّيْتَنِي كُنْتَ أَنْتَ الرَّقِيبَ عَلَيْهِمْ﴾."}],"hadiths":[{"i":1,"of":1,"text":"قام فينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بموعظةٍ، فقال: يا أيُّها الناسُ، إنَّكم مَحْشورونَ إلى اللهِ حُفاةً، عُراةً، غُرلًا: {كَمَا بَدَأْنَا أَوَّلَ خَلْقٍ نُعِيدُهُ وَعْدًا عَلَيْنَا إِنَّا كُنَّا فَاعِلِينَ} [الأنبياء: 104]، ألَا وإنَّ أولَ الخلقِ يُكسَى يومَ القيامةِ إبراهيمُ، وإنَّه سيُجاءُ بأُناسٍ من أمَّتي فيُؤخَذُ بهم ذاتَ الشِّمالِ، فلَأَقولَنَّ: أصحابي، فلَيُقالَنَّ لي: إنَّك لا تَدْري ما أحدَثوا بعدَكَ، فلَأَقولَنَّ كما قال العبدُ الصالِحُ: {وَكُنْتُ عَلَيْهِمْ شَهِيدًا مَا دُمْتُ فِيهِمْ فَلَمَّا تَوَفَّيْتَنِي كُنْتَ أَنْتَ الرَّقِيبَ عَلَيْهِمْ وَأَنْتَ عَلَى كُلِّ شَيْءٍ شَهِيدٌ...} إلى: {فَإِنَّهُمْ عِبَادُكَ وَإِنْ تَغْفِرْ لَهُمْ فَإِنَّكَ أَنْتَ الْعَزِيزُ الْحَكِيمُ} [المائدة:117- 118] فيُقالُ: إنَّ هؤلاءِ لم يزالوا مُرتدِّينَ على أعقابِهم منذُ فارَقْتَهم.","narrator":"عبدالله بن عباس","source":"تخريج المسند لشعيب 2281","grade":"صحيح","judgment":"إسناده صحيح على شرط الشيخين","url":"https://dorar.net/h/tNxLyh9B","nameForm":"الرَّقِيبَ","scene":"موعظة الحشر: «…فلأقولنّ كما قال العبد الصالح: ﴿وَكُنتُ عَلَيْهِمْ شَهِيدًا مَّا دُمْتُ فِيهِمْ فَلَمَّا تَوَفَّيْتَنِي كُنتَ أَنتَ الرَّقِيبَ عَلَيْهِمْ﴾».","reason":"الرقابة بعد موت الشاهد: النبي يرقب في حياته، والله الرقيب بعد وفاته — فالاسم يسدّ فراغ الشهود.","adds":"يُري الاسم في تفويض النبي ﷺ."}],"sunnah":{"card":"الصيغة: الرَّقِيبُ — مفردة\nفي السنة: شاهدان (4 روايات)\nخصوصية الورود في السنة: في كلمة عيسى التي يقولها النبي ﷺ يوم الحشر ﴿فَلَمَّا تَوَفَّيْتَنِي كُنتَ أَنتَ الرَّقِيبَ عَلَيْهِمْ﴾، وفي تعداد الأسماء.","teaches":"1. أنه الرقيب بعد موت كل رقيب.","whenRecall":"- حين يغيب من يرقبك.","whenPray":"عند الشعور بـ:\n1. غياب الرقيب.\nعند طلب:\n1. أن يرقبك بكرمه.\nعند الرغبة في:\n1. مراقبته في الخلوة.","duaItems":"لا صيغة منصوصة؛ ويُتلى قول عيسى [المائدة: 117].","summary":"«الرقيب» في السنة رقابة ما بعد موت الأنبياء في كلمة عيسى، وهو محصًى بين الكريم والمجيب."},"situations":[{"situationId":53,"verses":[{"i":1,"strength":"direct","headline":"جفوة مع الأرحام تقع خفيةً بلا شاهد","bridge":"جفوةٌ مع رحمٍ تقع في صمتٍ لا يحاسب عليه أحد؟ افتُتحت سورة الحقوق الدقيقة بها: ﴿وَاتَّقُوا اللَّهَ الَّذِي تَسَاءَلُونَ بِهِ وَالْأَرْحَامَ إِنَّ اللَّهَ كَانَ عَلَيْكُمْ رَقِيبًا﴾ — أول ما يُذكر مع الأرحام: الرقابة، لأن قطيعتها تقع بلا شاهد؛ والأصل واحد: ﴿مِنْ نَفْسٍ وَاحِدَةٍ﴾."}],"hadiths":[]},{"situationId":73,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"غياب الرقيب من الناس بموتٍ أو بعد","bridge":"غاب عنك من يراقبك؟ كلمة عيسى التي يقولها النبي ﷺ يوم الحشر: ﴿فَلَمَّا تَوَفَّيْتَنِي كُنتَ أَنتَ الرَّقِيبَ عَلَيْهِمْ﴾ — الرقيب لا يموت."}]},{"situationId":96,"verses":[{"i":2,"strength":"direct","headline":"التعلق بالأموات الصالحين وظن أنهم يرقبونك","bridge":"تعلّق قلبك بميتٍ صالح تظنه يرقبك ويسمعك؟ عيسى نفسه قال: ﴿فَلَمَّا تَوَفَّيْتَنِي كُنْتَ أَنْتَ الرَّقِيبَ عَلَيْهِمْ وَأَنْتَ عَلَى كُلِّ شَيْءٍ شَهِيدٌ﴾ — سلّم الرقابة لصاحبها بعد رفعه؛ فالأموات ولو كانوا أنبياء لا يرقبون الأحياء، وهذا نفيٌ لكل دعوى اطلاع الأموات على أحوال الأحياء، فعلّق قلبك بالرقيب الحي."}],"hadiths":[]}]},{"id":183,"name":"الغفور","compound":false,"meaning":"بطاقة الاسم:\nالصيغة: غَفُورًا — مفردة مقيدة بالأوابين | المواضع: 1 (الإسراء: 25)\nخصوصية: خُصّت المغفرة هنا بوصفٍ واحد: «الأوابين» — كثيري الرجوع؛ وجاءت في سياق برّ الوالدين.\n\nالمعنى:\n- الغفور للأوابين: الساتر الماحي لذنوب كثيري الرجوع إليه.","teaches":"الحقائق التي كشفها الموضع:\n1. المغفرة مقيدةٌ بالأوّابين — كثيري الرجوع.\n2. يعلم ما في النفوس من ضيقٍ عند التكاليف الشاقة.\n3. صلاح الأصل يشفع لزلات العارض.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- بعد جفوةٍ مع والديك.\n- عند شعورك بالتقصير في البر.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. دعاء الوالدين المأمور به: ﴿رَبِّ ارْحَمْهُمَا كَمَا رَبَّيَانِي صَغِيرًا﴾ — الإسراء 24.\n2. سؤال أن تكون من الأوابين.\n3. الاستغفار من زلات البر.","summary":"بعد أشقّ التكاليف — برّ الوالدين — جاء المخرج: ﴿فَإِنَّهُ كَانَ لِلْأَوَّابِينَ غَفُورًا﴾: كن أوّابًا رجّاعًا يُغفر تقصيرك.","verses":[{"i":1,"of":1,"s":17,"surah":"الإسراء","a":25,"text":"رَبُّكُمْ أَعْلَمُ بِمَا فِي نُفُوسِكُمْ إِنْ تَكُونُوا صَالِحِينَ فَإِنَّهُ كَانَ لِلْأَوَّابِينَ غَفُورًا","prev":{"a":24,"text":"وَاخْفِضْ لَهُمَا جَنَاحَ الذُّلِّ مِنَ الرَّحْمَةِ وَقُلْ رَبِّ ارْحَمْهُمَا كَمَا رَبَّيَانِي صَغِيرًا"},"next":{"a":26,"text":"وَآتِ ذَا الْقُرْبَى حَقَّهُ وَالْمِسْكِينَ وَابْنَ السَّبِيلِ وَلَا تُبَذِّرْ تَبْذِيرًا"},"context":"بعد آيات برّ الوالدين — ﴿فَلَا تَقُلْ لَهُمَا أُفٍّ﴾ و﴿وَاخْفِضْ لَهُمَا جَنَاحَ الذُّلِّ مِنَ الرَّحْمَةِ﴾ — ﴿رَبُّكُمْ أَعْلَمُ بِمَا فِي نُفُوسِكُمْ إِنْ تَكُونُوا صَالِحِينَ فَإِنَّهُ كَانَ لِلْأَوَّابِينَ غَفُورًا﴾.","reason":"جاءت بعد أشقّ التكاليف النفسية — برّ والدين كبيرين — تطمينًا لمن قصّر: يعلم ما في نفسك من ضيقٍ أو زلة، فإن كان أصلُك الصلاح وكنت أوّابًا رجّاعًا فالمغفرة لك. فالبرُّ الكامل عزيز، والرجوعُ متاح.","adds":"من بدرت منه جفوةٌ مع والديه فبابُه مفتوح: ﴿فَإِنَّهُ كَانَ لِلْأَوَّابِينَ غَفُورًا﴾ — فارجع واعتذر وأحسن."}],"hadiths":[{"i":1,"of":1,"text":"عن رَجُلٍ مِن أصْحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ مِن الأنصارِ، قال: -قال شُعْبةُ: أو قال: رَجُلٌ مِن الأنصارِ- إنَّه سَمِعَ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ في صَلاةٍ وهو يقولُ: ربِّ اغفِرْ لي -قال شُعْبةُ: أو قال: اللَّهُمَّ اغفِرْ لي- وتُبْ علَيَّ؛ إنَّك أنتَ التوَّابُ الغَفورُ، مِئَةَ مَرَّةٍ.","narrator":"رجل من الصحابة","source":"تخريج المسند لشعيب 23150","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/puGdNdKH","nameForm":"الغَفورُ","scene":"سُمع النبي ﷺ في صلاة يقول: «رب اغفر لي وتب عليّ إنك أنت التواب الغفور» مائة مرة.","reason":"الغفور بعد التواب: يُقبل التوبة ثم يغفر — والاسم خاتمة استغفارٍ مكرر مائةً.","adds":"يعطي الاسم في ورد المائة."}],"sunnah":{"card":"الصيغة: الْغَفُورُ — مفردة\nفي السنة: شاهد واحد (روايتان)\nخصوصية الورود في السنة: في استغفار النبي ﷺ مائةً: «رب اغفر لي وتب علي إنك أنت التواب الغفور».","teaches":"1. أنه غفور لمن تاب عليه.","whenRecall":"- في المجلس: مائة.","whenPray":"عند الشعور بـ:\n1. الحاجة إلى المغفرة.\nعند طلب:\n1. التوبة والمغفرة.\nعند الرغبة في:\n1. الاستغفار مائة.","duaItems":"«رب اغفر لي وتب عليّ إنك أنت التواب الغفور» مائة مرة — تخريج المسند 23150 (إسناده صحيح).","summary":"«الغفور» في السنة خاتمة استغفار المائة: «إنك أنت التواب الغفور»."},"situations":[{"situationId":15,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"الإكثار من الاستغفار في الصلاة بعد الذنب","bridge":"أذنبت الآن؟ «رب اغفر لي وتب عليّ إنك أنت التواب الغفور» — مائة مرة كما سُمع من النبي ﷺ."}]},{"situationId":53,"verses":[{"i":1,"strength":"direct","headline":"جفوةٌ بدرت منك مع والديك وخوفك ألا تُغفر","bridge":"بدرت منك جفوةٌ مع والديك؟ بعد أشقّ التكاليف النفسية — ﴿فَلَا تَقُلْ لَهُمَا أُفٍّ﴾ — جاء التطمين: ﴿رَبُّكُمْ أَعْلَمُ بِمَا فِي نُفُوسِكُمْ إِنْ تَكُونُوا صَالِحِينَ فَإِنَّهُ كَانَ لِلْأَوَّابِينَ غَفُورًا﴾ — يعلم ما في نفسك من ضيقٍ أو زلة، فإن كان أصلك الصلاح وكنت رجّاعًا فالمغفرة لك؛ فارجع واعتذر وأحسن."}],"hadiths":[]}]},{"id":184,"name":"الوكيل","compound":false,"meaning":"بطاقة الاسم:\nالصيغة: وَكِيلًا / الْوَكِيلُ — | المواضع: 10\nخصوصية: يتكرر بصيغة الكفاية ﴿وَكَفَى بِاللَّهِ وَكِيلًا﴾ خمس مرات — وهي أكثرُ صيغةِ كفايةٍ تكرارًا في القرآن؛ وفيه الأمر الصريح: ﴿فَاتَّخِذْهُ وَكِيلًا﴾.\n\nالمعنى:\n- الوكيل: الموكولُ إليه تدبير الأمور، القائم بشؤون خلقه، الكفيلُ بأرزاقهم ومصالحهم — ووكالتُه ذاتية لا يوكّله أحد.","teaches":"الحقائق التي كشفتها المواضع:\n1. التوكل قرارٌ يُتخذ: ﴿فَاتَّخِذْهُ وَكِيلًا﴾ (المزمل 9).\n2. لا سلطان لإبليس على العباد والوكيل كافٍ (الإسراء 65).\n3. العقود تُستكمل بإشهاد الوكيل (يوسف 66، القصص 28).\n4. علاج التبييت والأذى: إعراضٌ وتوكل لا ملاحقة (النساء 81، الأحزاب 48).\n5. من مقاصد الوحي: ألّا تتخذ وكيلًا سواه (الإسراء 2).","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- عند توقيع عقدٍ أو أخذ عهد.\n- عند علمك بمن يبيّت لك سوءًا.\n- بعد رفض ضغطٍ على مبدأ.\n- عند اشتداد الوسوسة.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. «حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ» — قالها إبراهيم في النار ومحمد ﷺ عند جمع الأحزاب (رواه البخاري).\n2. عند العقود: ﴿اللَّهُ عَلَى مَا نَقُولُ وَكِيلٌ﴾ — يوسف 66.\n3. اتخاذ الوكالة قرارًا — المزمل 9.\n4. الإعراض عمّن يؤذي وتفويض أمره — الأحزاب 48.","summary":"﴿فَاتَّخِذْهُ وَكِيلًا﴾ — أمرٌ لا انتظارُ شعور: وكّل من يملك كل شيء، ثم دع أذاهم وأعرض؛ ﴿وَكَفَى بِاللَّهِ وَكِيلًا﴾.","verses":[{"i":1,"of":10,"s":4,"surah":"النساء","a":81,"text":"وَيَقُولُونَ طَاعَةٌ فَإِذَا بَرَزُوا مِنْ عِنْدِكَ بَيَّتَ طَائِفَةٌ مِنْهُمْ غَيْرَ الَّذِي تَقُولُ وَاللَّهُ يَكْتُبُ مَا يُبَيِّتُونَ فَأَعْرِضْ عَنْهُمْ وَتَوَكَّلْ عَلَى اللَّهِ وَكَفَى بِاللَّهِ وَكِيلًا","prev":{"a":80,"text":"مَنْ يُطِعِ الرَّسُولَ فَقَدْ أَطَاعَ اللَّهَ وَمَنْ تَوَلَّى فَمَا أَرْسَلْنَاكَ عَلَيْهِمْ حَفِيظًا"},"next":{"a":82,"text":"أَفَلَا يَتَدَبَّرُونَ الْقُرْآنَ وَلَوْ كَانَ مِنْ عِنْدِ غَيْرِ اللَّهِ لَوَجَدُوا فِيهِ اخْتِلَافًا كَثِيرًا"},"reason":"تبييتٌ في الليل وطاعةٌ في النهار — واللهُ يكتب ما يبيّتون؛ فالعلاجُ المأمور به: إعراضٌ وتوكل، لا ملاحقةٌ ومواجهةٌ لكل مبيّت. فالوكيلُ يتولى ما لا تراه.","adds":"لا تُتعب نفسك بمطاردة ما يُقال عنك في الغرف المغلقة: ﴿وَاللَّهُ يَكْتُبُ مَا يُبَيِّتُونَ﴾."},{"i":2,"of":10,"s":4,"surah":"النساء","a":132,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَفَى بِاللَّهِ وَكِيلًا","prev":{"a":131,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَلَقَدْ وَصَّيْنَا الَّذِينَ أُوتُوا الْكِتَابَ مِنْ قَبْلِكُمْ وَإِيَّاكُمْ أَنِ اتَّقُوا اللَّهَ وَإِنْ تَكْفُرُوا فَإِنَّ لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَانَ اللَّهُ غَنِيًّا حَمِيدًا"},"next":{"a":133,"text":"إِنْ يَشَأْ يُذْهِبْكُمْ أَيُّهَا النَّاسُ وَيَأْتِ بِآخَرِينَ وَكَانَ اللَّهُ عَلَى ذَلِكَ قَدِيرًا"},"reason":"مِلكيةٌ شاملة تُعقبها كفايةٌ في الوكالة: من يملك كل شيء هو الوحيد الذي تصح وكالته في كل شيء — فوكالةُ من لا يملك ناقصةٌ بالضرورة.","adds":"وكّل من يملك: كلُّ وكيلٍ سواه يتصرف فيما لا يملك."},{"i":3,"of":10,"s":4,"surah":"النساء","a":171,"text":"يَا أَهْلَ الْكِتَابِ لَا تَغْلُوا فِي دِينِكُمْ وَلَا تَقُولُوا عَلَى اللَّهِ إِلَّا الْحَقَّ إِنَّمَا الْمَسِيحُ عِيسَى ابْنُ مَرْيَمَ رَسُولُ اللَّهِ وَكَلِمَتُهُ أَلْقَاهَا إِلَى مَرْيَمَ وَرُوحٌ مِنْهُ فَآمِنُوا بِاللَّهِ وَرُسُلِهِ وَلَا تَقُولُوا ثَلَاثَةٌ انْتَهُوا خَيْرًا لَكُمْ إِنَّمَا اللَّهُ إِلَهٌ وَاحِدٌ سُبْحَانَهُ أَنْ يَكُونَ لَهُ وَلَدٌ لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَفَى بِاللَّهِ وَكِيلًا","prev":{"a":170,"text":"يَا أَيُّهَا النَّاسُ قَدْ جَاءَكُمُ الرَّسُولُ بِالْحَقِّ مِنْ رَبِّكُمْ فَآمِنُوا خَيْرًا لَكُمْ وَإِنْ تَكْفُرُوا فَإِنَّ لِلَّهِ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ وَكَانَ اللَّهُ عَلِيمًا حَكِيمًا"},"next":{"a":172,"text":"لَنْ يَسْتَنْكِفَ الْمَسِيحُ أَنْ يَكُونَ عَبْدًا لِلَّهِ وَلَا الْمَلَائِكَةُ الْمُقَرَّبُونَ وَمَنْ يَسْتَنْكِفْ عَنْ عِبَادَتِهِ وَيَسْتَكْبِرْ فَسَيَحْشُرُهُمْ إِلَيْهِ جَمِيعًا"},"context":"﴿يَا أَهْلَ الْكِتَابِ لَا تَغْلُوا فِي دِينِكُمْ... إِنَّمَا اللَّهُ إِلَهٌ وَاحِدٌ سُبْحَانَهُ أَنْ يَكُونَ لَهُ وَلَدٌ لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَفَى بِاللَّهِ وَكِيلًا﴾.","reason":"نهيٌ عن الغلو في الدين — وهو أصلُ تأليه المخلوقين — وخُتم بالوكالة: من يملك كل شيء ويكفي وكيلًا لا يحتاج شريكًا ولا ولدًا ولا وسيطًا.","adds":"الغلو في الصالحين بدايةُ الشرك: ﴿لَا تَغْلُوا فِي دِينِكُمْ﴾ — والكفاية في الوكيل وحده."},{"i":4,"of":10,"s":12,"surah":"يوسف","a":66,"text":"قَالَ لَنْ أُرْسِلَهُ مَعَكُمْ حَتَّى تُؤْتُونِ مَوْثِقًا مِنَ اللَّهِ لَتَأْتُنَّنِي بِهِ إِلَّا أَنْ يُحَاطَ بِكُمْ فَلَمَّا آتَوْهُ مَوْثِقَهُمْ قَالَ اللَّهُ عَلَى مَا نَقُولُ وَكِيلٌ","prev":{"a":65,"text":"وَلَمَّا فَتَحُوا مَتَاعَهُمْ وَجَدُوا بِضَاعَتَهُمْ رُدَّتْ إِلَيْهِمْ قَالُوا يَا أَبَانَا مَا نَبْغِي هَذِهِ بِضَاعَتُنَا رُدَّتْ إِلَيْنَا وَنَمِيرُ أَهْلَنَا وَنَحْفَظُ أَخَانَا وَنَزْدَادُ كَيْلَ بَعِيرٍ ذَلِكَ كَيْلٌ يَسِيرٌ"},"next":{"a":67,"text":"وَقَالَ يَا بَنِيَّ لَا تَدْخُلُوا مِنْ بَابٍ وَاحِدٍ وَادْخُلُوا مِنْ أَبْوَابٍ مُتَفَرِّقَةٍ وَمَا أُغْنِي عَنْكُمْ مِنَ اللَّهِ مِنْ شَيْءٍ إِنِ الْحُكْمُ إِلَّا لِلَّهِ عَلَيْهِ تَوَكَّلْتُ وَعَلَيْهِ فَلْيَتَوَكَّلِ الْمُتَوَكِّلُونَ"},"context":"يعقوب حين أخذ الموثق على أبنائه: ﴿فَلَمَّا آتَوْهُ مَوْثِقَهُمْ قَالَ اللَّهُ عَلَى مَا نَقُولُ وَكِيلٌ﴾.","reason":"أخذ العهدَ الموثق ثم أشهد الله عليه: وكيلٌ على العقود يحفظها ويطالب بها — فالوثيقةُ البشرية تُستكمل بإشهاد الوكيل.","adds":"عند كل عهدٍ أو اتفاق: قل ما قاله يعقوب — ﴿اللَّهُ عَلَى مَا نَقُولُ وَكِيلٌ﴾."},{"i":5,"of":10,"s":17,"surah":"الإسراء","a":2,"text":"وَآتَيْنَا مُوسَى الْكِتَابَ وَجَعَلْنَاهُ هُدًى لِبَنِي إِسْرَائِيلَ أَلَّا تَتَّخِذُوا مِنْ دُونِي وَكِيلًا","prev":{"a":1,"text":"سُبْحَانَ الَّذِي أَسْرَى بِعَبْدِهِ لَيْلًا مِنَ الْمَسْجِدِ الْحَرَامِ إِلَى الْمَسْجِدِ الْأَقْصَى الَّذِي بَارَكْنَا حَوْلَهُ لِنُرِيَهُ مِنْ آيَاتِنَا إِنَّهُ هُوَ السَّمِيعُ الْبَصِيرُ"},"next":{"a":3,"text":"ذُرِّيَّةَ مَنْ حَمَلْنَا مَعَ نُوحٍ إِنَّهُ كَانَ عَبْدًا شَكُورًا"},"reason":"غايةٌ صريحة لإنزال الكتاب: ألّا يُتخذ وكيلٌ من دونه — فالتوحيدُ في التوكل مقصدٌ من مقاصد الوحي كله، لا فرعًا من فروعه.","adds":"أول ما يعلّمك الكتاب: أن تحصر توكلك فيه — ﴿أَلَّا تَتَّخِذُوا مِنْ دُونِي وَكِيلًا﴾."},{"i":6,"of":10,"s":17,"surah":"الإسراء","a":65,"text":"إِنَّ عِبَادِي لَيْسَ لَكَ عَلَيْهِمْ سُلْطَانٌ وَكَفَى بِرَبِّكَ وَكِيلًا","prev":{"a":64,"text":"وَاسْتَفْزِزْ مَنِ اسْتَطَعْتَ مِنْهُمْ بِصَوْتِكَ وَأَجْلِبْ عَلَيْهِمْ بِخَيْلِكَ وَرَجِلِكَ وَشَارِكْهُمْ فِي الْأَمْوَالِ وَالْأَوْلَادِ وَعِدْهُمْ وَمَا يَعِدُهُمُ الشَّيْطَانُ إِلَّا غُرُورًا"},"next":{"a":66,"text":"رَبُّكُمُ الَّذِي يُزْجِي لَكُمُ الْفُلْكَ فِي الْبَحْرِ لِتَبْتَغُوا مِنْ فَضْلِهِ إِنَّهُ كَانَ بِكُمْ رَحِيمًا"},"context":"﴿إِنَّ عِبَادِي لَيْسَ لَكَ عَلَيْهِمْ سُلْطَانٌ وَكَفَى بِرَبِّكَ وَكِيلًا﴾ — خطابًا لإبليس.","reason":"إعلانُ حصانةٍ للعباد: لا سلطان لإبليس عليهم — والكفايةُ في الوكيل؛ فحمايتُك من الشيطان ليست بقوتك بل بوكالة ربك عنك.","adds":"إبليس بلا سلطان على أهل الإخلاص — والضمانة: ﴿وَكَفَى بِرَبِّكَ وَكِيلًا﴾."},{"i":7,"of":10,"s":28,"surah":"القصص","a":28,"text":"قَالَ ذَلِكَ بَيْنِي وَبَيْنَكَ أَيَّمَا الْأَجَلَيْنِ قَضَيْتُ فَلَا عُدْوَانَ عَلَيَّ وَاللَّهُ عَلَى مَا نَقُولُ وَكِيلٌ","prev":{"a":27,"text":"قَالَ إِنِّي أُرِيدُ أَنْ أُنْكِحَكَ إِحْدَى ابْنَتَيَّ هَاتَيْنِ عَلَى أَنْ تَأْجُرَنِي ثَمَانِيَ حِجَجٍ فَإِنْ أَتْمَمْتَ عَشْرًا فَمِنْ عِنْدِكَ وَمَا أُرِيدُ أَنْ أَشُقَّ عَلَيْكَ سَتَجِدُنِي إِنْ شَاءَ اللَّهُ مِنَ الصَّالِحِينَ"},"next":{"a":29,"text":"فَلَمَّا قَضَى مُوسَى الْأَجَلَ وَسَارَ بِأَهْلِهِ آنَسَ مِنْ جَانِبِ الطُّورِ نَارًا قَالَ لِأَهْلِهِ امْكُثُوا إِنِّي آنَسْتُ نَارًا لَعَلِّي آتِيكُمْ مِنْهَا بِخَبَرٍ أَوْ جَذْوَةٍ مِنَ النَّارِ لَعَلَّكُمْ تَصْطَلُونَ"},"context":"موسى وشعيب عند العقد: ﴿قَالَ ذَلِكَ بَيْنِي وَبَيْنَكَ أَيَّمَا الْأَجَلَيْنِ قَضَيْتُ فَلَا عُدْوَانَ عَلَيَّ وَاللَّهُ عَلَى مَا نَقُولُ وَكِيلٌ﴾.","reason":"عقدُ عملٍ بشروطٍ واضحة وخيارٍ للطرف الأضعف — ثم إشهاد الوكيل: فالعقودُ في القرآن تُبنى على وضوح الشروط وإشهاد الله، لا على الثقة وحدها.","adds":"نموذج العقد الشرعي: شروطٌ واضحة، وخيارٌ محفوظ، وإشهادٌ لله — قبل التوقيع لا بعده."},{"i":8,"of":10,"s":33,"surah":"الأحزاب","a":3,"text":"وَتَوَكَّلْ عَلَى اللَّهِ وَكَفَى بِاللَّهِ وَكِيلًا","prev":{"a":2,"text":"وَاتَّبِعْ مَا يُوحَى إِلَيْكَ مِنْ رَبِّكَ إِنَّ اللَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًا"},"next":{"a":4,"text":"مَا جَعَلَ اللَّهُ لِرَجُلٍ مِنْ قَلْبَيْنِ فِي جَوْفِهِ وَمَا جَعَلَ أَزْوَاجَكُمُ اللَّائِي تُظَاهِرُونَ مِنْهُنَّ أُمَّهَاتِكُمْ وَمَا جَعَلَ أَدْعِيَاءَكُمْ أَبْنَاءَكُمْ ذَلِكُمْ قَوْلُكُمْ بِأَفْوَاهِكُمْ وَاللَّهُ يَقُولُ الْحَقَّ وَهُوَ يَهْدِي السَّبِيلَ"},"context":"﴿يَا أَيُّهَا النَّبِيُّ اتَّقِ اللَّهَ وَلَا تُطِعِ الْكَافِرِينَ وَالْمُنَافِقِينَ... وَتَوَكَّلْ عَلَى اللَّهِ وَكَفَى بِاللَّهِ وَكِيلًا﴾.","reason":"قُرن رفضُ المساومة بالتوكل: فمن رفض الطاعة للضاغطين احتاج وكيلًا يتولاه — والكفايةُ مضمونة. فالثباتُ على المبدأ لا يُترك صاحبه وحيدًا.","adds":"كلما رفضتَ ضغطًا على مبدأ، فوّض النتائج للوكيل: ﴿وَكَفَى بِاللَّهِ وَكِيلًا﴾."},{"i":9,"of":10,"s":33,"surah":"الأحزاب","a":48,"text":"وَلَا تُطِعِ الْكَافِرِينَ وَالْمُنَافِقِينَ وَدَعْ أَذَاهُمْ وَتَوَكَّلْ عَلَى اللَّهِ وَكَفَى بِاللَّهِ وَكِيلًا","prev":{"a":47,"text":"وَبَشِّرِ الْمُؤْمِنِينَ بِأَنَّ لَهُمْ مِنَ اللَّهِ فَضْلًا كَبِيرًا"},"next":{"a":49,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا نَكَحْتُمُ الْمُؤْمِنَاتِ ثُمَّ طَلَّقْتُمُوهُنَّ مِنْ قَبْلِ أَنْ تَمَسُّوهُنَّ فَمَا لَكُمْ عَلَيْهِنَّ مِنْ عِدَّةٍ تَعْتَدُّونَهَا فَمَتِّعُوهُنَّ وَسَرِّحُوهُنَّ سَرَاحًا جَمِيلًا"},"reason":"جاء فيها: ﴿وَدَعْ أَذَاهُمْ﴾ — أي اتركه ولا تشتغل بالرد؛ فالطاقةُ المصروفة في الرد على المؤذين تُصرف في العمل، والوكيلُ يتولى حسابهم.","adds":"دستور التعامل مع الأذى: لا طاعة، ولا انشغال بالرد، وتوكلٌ على الوكيل."},{"i":10,"of":10,"s":73,"surah":"المزمل","a":9,"text":"رَبُّ الْمَشْرِقِ وَالْمَغْرِبِ لَا إِلَهَ إِلَّا هُوَ فَاتَّخِذْهُ وَكِيلًا","prev":{"a":8,"text":"وَاذْكُرِ اسْمَ رَبِّكَ وَتَبَتَّلْ إِلَيْهِ تَبْتِيلًا"},"next":{"a":10,"text":"وَاصْبِرْ عَلَى مَا يَقُولُونَ وَاهْجُرْهُمْ هَجْرًا جَمِيلًا"},"context":"﴿رَبُّ الْمَشْرِقِ وَالْمَغْرِبِ لَا إِلَهَ إِلَّا هُوَ فَاتَّخِذْهُ وَكِيلًا﴾ — في سورة المزمل.","reason":"أمرٌ صريح باتخاذ الوكيل — ﴿فَاتَّخِذْهُ وَكِيلًا﴾ — بعد الأمر بقيام الليل والصبر على ما يقولون؛ فالتوكيلُ قرارٌ يُتخذ لا شعورٌ يُنتظر.","adds":"التوكل قرارٌ إرادي: ﴿فَاتَّخِذْهُ وَكِيلًا﴾ — اتخذه اليوم بقرارٍ لا بانتظار شعور."}],"hadiths":[],"sunnah":{"card":"الصيغة: الْوَكِيلُ — مفردة\nفي السنة: شاهد واحد (3 روايات)\nخصوصية الورود في السنة: ورد مفردًا في تعداد الأسماء في الروايات الثلاث: بعد «الحق» في رواية الترمذي، وبعد «الحافظ» في رواية ابن ماجه.","teaches":"1. أن التوكل عليه مبني على أنه حق وحافظ.","whenRecall":"- في إحصاء الأسماء.\n- عند التوكل.","whenPray":"عند الشعور بـ:\n1. الحاجة إلى من يكفيك.\nعند طلب:\n1. الكفاية.\nعند الرغبة في:\n1. إحصاء الأسماء.","duaItems":"لا صيغة منصوصة؛ ويُدعى: «حسبي الله ونعم الوكيل» (انظر اسمه).","summary":"«الوكيل» في السنة محصًى بعد الحق وبعد الحافظ."},"situations":[{"situationId":10,"verses":[{"i":2,"strength":"direct","headline":"الخوف من غدٍ لا تملك منه شيئًا","bridge":"تخاف من غدٍ لا تملكه؟ وكّل من يملك: ﴿وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَفَى بِاللَّهِ وَكِيلًا﴾ — من يملك كل شيء هو الوحيد الذي تصح وكالته في كل شيء، وكل وكيلٍ سواه يتصرف فيما لا يملك؛ فغدك في وكالة من يملكه."}],"hadiths":[]},{"situationId":30,"verses":[{"i":1,"strength":"direct","headline":"كلامٌ وتدبيرٌ يُحاك ضدك في الخفاء","bridge":"يبيّتون لك غير ما يُظهرون؟ ﴿فَإِذَا بَرَزُوا مِنْ عِنْدِكَ بَيَّتَ طَائِفَةٌ مِنْهُمْ غَيْرَ الَّذِي تَقُولُ وَاللَّهُ يَكْتُبُ مَا يُبَيِّتُونَ فَأَعْرِضْ عَنْهُمْ وَتَوَكَّلْ عَلَى اللَّهِ وَكَفَى بِاللَّهِ وَكِيلًا﴾ — العلاج إعراضٌ وتوكل لا ملاحقة؛ فلا تُتعب نفسك بمطاردة ما يُقال في الغرف المغلقة، الوكيل يتولى ما لا تراه."}],"hadiths":[]},{"situationId":47,"verses":[{"i":7,"strength":"direct","headline":"إبرام عقد عملٍ بشروطٍ واضحة","bridge":"توقّع عقد عمل؟ نموذج العقد الشرعي في قصة موسى وشعيب: شروطٌ واضحة، وخيارٌ محفوظ للطرف الأضعف ﴿أَيَّمَا الْأَجَلَيْنِ قَضَيْتُ فَلَا عُدْوَانَ عَلَيَّ﴾، ثم إشهاد: ﴿وَاللَّهُ عَلَى مَا نَقُولُ وَكِيلٌ﴾ — فالعقود تُبنى على وضوح الشروط وإشهاد الله لا على الثقة وحدها."}],"hadiths":[]},{"situationId":56,"verses":[{"i":9,"strength":"direct","headline":"استنزاف الطاقة في الرد على المؤذين","bridge":"يؤذيك الناس وتستنزف طاقتك في الرد؟ دستور التعامل مع الأذى: ﴿وَدَعْ أَذَاهُمْ وَتَوَكَّلْ عَلَى اللَّهِ وَكَفَى بِاللَّهِ وَكِيلًا﴾ — اتركه ولا تشتغل بالرد؛ فالطاقة المصروفة في الرد على المؤذين تُصرف في العمل، والوكيل يتولى حسابهم."}],"hadiths":[]},{"situationId":62,"verses":[{"i":4,"strength":"direct","headline":"إبرام عهدٍ أو اتفاقٍ مع الآخرين","bridge":"تأخذ عهدًا على أحد؟ افعل ما فعل يعقوب: أخذ الموثق ثم أشهد الله: ﴿فَلَمَّا آتَوْهُ مَوْثِقَهُمْ قَالَ اللَّهُ عَلَى مَا نَقُولُ وَكِيلٌ﴾ — الوثيقة البشرية تُستكمل بإشهاد الوكيل الذي يحفظ العهد ويطالب به؛ فعند كل اتفاق قلها."}],"hadiths":[]},{"situationId":75,"verses":[{"i":6,"strength":"direct","headline":"وساوس الشيطان والخوف من تسلّطه عليك","bridge":"خواطر تقتحمك وتظن أن للشيطان سلطانًا عليك؟ الحصانة معلنة: ﴿إِنَّ عِبَادِي لَيْسَ لَكَ عَلَيْهِمْ سُلْطَانٌ وَكَفَى بِرَبِّكَ وَكِيلًا﴾ — لا سلطان له على أهل الإخلاص، وحمايتك ليست بقوتك بل بوكالة ربك عنك؛ فالوسوسة بلا سلطان والوكيل كافٍ."}],"hadiths":[]},{"situationId":94,"verses":[{"i":5,"strength":"direct","headline":"تعليق الأمر بمخلوقٍ واتخاذه وكيلًا من دون الله","bridge":"يوسوس إليك أن تعلّق أمرك بغير الله؟ أول ما يعلّمك الكتاب: ﴿أَلَّا تَتَّخِذُوا مِنْ دُونِي وَكِيلًا﴾ — حصر التوكل فيه مقصدٌ للوحي كله لا فرعًا؛ فردّ كل خاطرٍ يعرض عليك وكيلًا آخر إلى هذه الغاية."}],"hadiths":[]},{"situationId":96,"verses":[{"i":3,"strength":"direct","headline":"التعلّق بصالحٍ حتى يصير وسيطًا بينك وبين الله","bridge":"غلوت في صالحٍ حتى كاد يصير وسيطًا بينك وبين الله؟ ﴿يَا أَهْلَ الْكِتَابِ لَا تَغْلُوا فِي دِينِكُمْ... لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَفَى بِاللَّهِ وَكِيلًا﴾ — الغلو في الصالحين أصل تأليه المخلوقين، ومن يملك كل شيء ويكفي وكيلًا لا يحتاج وسيطًا؛ فالكفاية في الوكيل وحده."}],"hadiths":[]},{"situationId":102,"verses":[{"i":10,"strength":"direct","headline":"انتظار الطمأنينة قبل الإقدام على التوكل","bridge":"تنتظر شعورًا بالطمأنينة قبل أن تتوكل؟ التوكل قرارٌ إرادي بصيغة الأمر: ﴿رَبُّ الْمَشْرِقِ وَالْمَغْرِبِ لَا إِلَهَ إِلَّا هُوَ فَاتَّخِذْهُ وَكِيلًا﴾ — اتخذه اليوم بقرارٍ لا بانتظار شعور، فالقلق من الغد يزول بالقرار لا بالانتظار."}],"hadiths":[]},{"situationId":125,"verses":[{"i":8,"strength":"direct","headline":"الخوف من عواقب رفض الضغط على المبدأ","bridge":"رفضتَ مساومةً على مبدأ وتخاف النتائج؟ قُرن رفض الطاعة للضاغطين بالتوكل: ﴿وَلَا تُطِعِ الْكَافِرِينَ وَالْمُنَافِقِينَ... وَتَوَكَّلْ عَلَى اللَّهِ وَكَفَى بِاللَّهِ وَكِيلًا﴾ — من رفض الضغط لا يُترك وحيدًا؛ فكلما رفضتَ ضغطًا على مبدأ فوّض النتائج للوكيل."}],"hadiths":[]}]},{"id":185,"name":"الأكرم","compound":false,"meaning":"بطاقة الاسم:\nالصيغة: الْأَكْرَمُ — صيغة تفضيل | المواضع: 1 (العلق: 3)\nخصوصية: في أول ما نزل من القرآن — الوصف الوحيد لله في أول خمس آياتٍ نزلت.\n\nالمعنى:\n- الأكرم: الذي لا أكرم منه — كرمٌ مطلق يتجاوز كل كرم؛ ومن كرمه أن علّم الإنسان ما لم يعلم.","teaches":"الحقائق التي كشفها الموضع:\n1. أعظم مظاهر الكرم الأعظم: تعليم الإنسان ما لم يعلم.\n2. القلم أداةٌ مذكورة في أول الوحي — فالكتابة نعمةُ كرم.\n3. عجزك عن القراءة لا يعطل الأمر: ﴿اقْرَأْ وَرَبُّكَ الْأَكْرَمُ﴾.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند بدء تعلّم شيءٍ تظن نفسك عاجزًا عنه.\n- عند كل قراءةٍ وكتابة.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. سؤال العلم النافع من الأكرم: ﴿عَلَّمَ الْإِنْسَانَ مَا لَمْ يَعْلَمْ﴾.\n2. ﴿رَبِّ زِدْنِي عِلْمًا﴾ — طه 114.\n3. الشكر على نعمة القلم والقراءة.","summary":"أولُ ما نزل: ﴿اقْرَأْ وَرَبُّكَ الْأَكْرَمُ﴾ — قيل لأمّي فصار أمةَ اقرأ: فأعظمُ كرمه أن ﴿عَلَّمَ الْإِنْسَانَ مَا لَمْ يَعْلَمْ﴾.","verses":[{"i":1,"of":1,"s":96,"surah":"العلق","a":3,"text":"اقْرَأْ وَرَبُّكَ الْأَكْرَمُ","prev":{"a":2,"text":"خَلَقَ الْإِنْسَانَ مِنْ عَلَقٍ"},"next":{"a":4,"text":"الَّذِي عَلَّمَ بِالْقَلَمِ"},"context":"﴿اقْرَأْ بِاسْمِ رَبِّكَ الَّذِي خَلَقَ * خَلَقَ الْإِنْسَانَ مِنْ عَلَقٍ * اقْرَأْ وَرَبُّكَ الْأَكْرَمُ * الَّذِي عَلَّمَ بِالْقَلَمِ * عَلَّمَ الْإِنْسَانَ مَا لَمْ يَعْلَمْ﴾.","reason":"جاء ﴿الْأَكْرَمُ﴾ في الأمر الثاني بالقراءة — تشجيعًا للنبي الأمّي ﷺ في أول ما نزل: اقرأ فربُّك الأكرم؛ فكرمُه يسدّ عجزك، ودليلُ كرمه أنه علّم بالقلم وعلّم الإنسان ما لم يعلم. فالعلمُ أولُ ما ذُكر من مظاهر الكرم الأعظم.","adds":"إذا واجهك عجزٌ عن تعلّم شيء فتذكر: أولُ أمرٍ نزل كان ﴿اقْرَأْ﴾ لأمّي — وضمانتُه ﴿وَرَبُّكَ الْأَكْرَمُ﴾.","dorar":[{"id":"sM0T91MS","label":"صحيح البخاري 6982"}]}],"hadiths":[],"sunnah":{"card":"الصيغة: الْأَكْرَمُ — مفردة\nفي السنة: شاهد واحد (رواية واحدة)\nخصوصية الورود في السنة: ورد في رواية المستدرك لحديث الإحصاء: «…المليك، المقتدر، الأكرم، الرؤوف…».","teaches":"1. أنه الأكرم: كرمه من ملك وقدرة.","whenRecall":"- في العلق: ﴿اقْرَأْ وَرَبُّكَ الْأَكْرَمُ﴾.\n- في إحصاء الأسماء.","whenPray":"عند الشعور بـ:\n1. الحاجة إلى كرم فوق كل كرم.\nعند طلب:\n1. العلم كما أُقرئ النبي ﷺ باسمه.\nعند الرغبة في:\n1. إحصاء الأسماء.","duaItems":"لا صيغة منصوصة؛ ويُتلى ﴿اقْرَأْ وَرَبُّكَ الْأَكْرَمُ﴾ [العلق: 3].","summary":"«الأكرم» في السنة محصًى في رواية المستدرك بعد المليك المقتدر."},"situations":[{"situationId":192,"verses":[{"i":1,"strength":"direct","headline":"العجز والاستصعاب عند تعلّم شيءٍ جديد","bridge":"تستصعب تعلّم شيءٍ؟ أول أمرٍ نزل كان ﴿اقْرَأْ﴾ لنبيٍّ أمّي — وضمانته في الأمر الثاني: ﴿اقْرَأْ وَرَبُّكَ الْأَكْرَمُ * الَّذِي عَلَّمَ بِالْقَلَمِ * عَلَّمَ الْإِنْسَانَ مَا لَمْ يَعْلَمْ﴾ — كرمه يسدّ عجزك، والعلم أول ما ذُكر من مظاهر الكرم الأعظم."}],"hadiths":[]}]},{"id":186,"name":"القريب","compound":false,"meaning":"بطاقة الاسم:\nالصيغة: قَرِيبٌ — مفردة | المواضع: 1 (البقرة: 186)\nخصوصية: أشهرُ آية دعاءٍ في القرآن — وهي الآية الوحيدة التي حُذف فيها الوسيط: لم يقل «فقل إني قريب» بل ﴿فَإِنِّي قَرِيبٌ﴾ مباشرة.\n\nالمعنى:\n- القريب: القريب من عباده بعلمه وسمعه وإجابته — قربًا يليق بجلاله.","teaches":"الحقائق التي كشفها الموضع:\n1. حذف الواسطة في الجواب دليلُ القرب نفسه.\n2. الإجابة مشروطة بالاستجابة والإيمان: ﴿فَلْيَسْتَجِيبُوا لِي وَلْيُؤْمِنُوا بِي﴾.\n3. موضعها بين آيات الصيام: رمضان موسمُ دعاءٍ وإجابة.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند الشعور بالبعد أو بأن دعاءك لا يُسمع.\n- في رمضان وعند كل فطر.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. الدعاء بلا وسيط ولا رفع صوت — البقرة 186.\n2. تحقيق شرط الإجابة: ﴿فَلْيَسْتَجِيبُوا لِي﴾ — استجب له يستجب لك.\n3. الإكثار من الدعاء في رمضان — موضع الآية.","summary":"سألوا عنه فأجاب بنفسه بلا واسطة: ﴿فَإِنِّي قَرِيبٌ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ﴾ — وشرطُ الإجابة أن تستجيب له.","verses":[{"i":1,"of":1,"s":2,"surah":"البقرة","a":186,"text":"وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ فَلْيَسْتَجِيبُوا لِي وَلْيُؤْمِنُوا بِي لَعَلَّهُمْ يَرْشُدُونَ","prev":{"a":185,"text":"شَهْرُ رَمَضَانَ الَّذِي أُنْزِلَ فِيهِ الْقُرْآنُ هُدًى لِلنَّاسِ وَبَيِّنَاتٍ مِنَ الْهُدَى وَالْفُرْقَانِ فَمَنْ شَهِدَ مِنْكُمُ الشَّهْرَ فَلْيَصُمْهُ وَمَنْ كَانَ مَرِيضًا أَوْ عَلَى سَفَرٍ فَعِدَّةٌ مِنْ أَيَّامٍ أُخَرَ يُرِيدُ اللَّهُ بِكُمُ الْيُسْرَ وَلَا يُرِيدُ بِكُمُ الْعُسْرَ وَلِتُكْمِلُوا الْعِدَّةَ وَلِتُكَبِّرُوا اللَّهَ عَلَى مَا هَدَاكُمْ وَلَعَلَّكُمْ تَشْكُرُونَ"},"next":{"a":187,"text":"أُحِلَّ لَكُمْ لَيْلَةَ الصِّيَامِ الرَّفَثُ إِلَى نِسَائِكُمْ هُنَّ لِبَاسٌ لَكُمْ وَأَنْتُمْ لِبَاسٌ لَهُنَّ عَلِمَ اللَّهُ أَنَّكُمْ كُنْتُمْ تَخْتَانُونَ أَنْفُسَكُمْ فَتَابَ عَلَيْكُمْ وَعَفَا عَنْكُمْ فَالْآنَ بَاشِرُوهُنَّ وَابْتَغُوا مَا كَتَبَ اللَّهُ لَكُمْ وَكُلُوا وَاشْرَبُوا حَتَّى يَتَبَيَّنَ لَكُمُ الْخَيْطُ الْأَبْيَضُ مِنَ الْخَيْطِ الْأَسْوَدِ مِنَ الْفَجْرِ ثُمَّ أَتِمُّوا الصِّيَامَ إِلَى اللَّيْلِ وَلَا تُبَاشِرُوهُنَّ وَأَنْتُمْ عَاكِفُونَ فِي الْمَسَاجِدِ تِلْكَ حُدُودُ اللَّهِ فَلَا تَقْرَبُوهَا كَذَلِكَ يُبَيِّنُ اللَّهُ آيَاتِهِ لِلنَّاسِ لَعَلَّهُمْ يَتَّقُونَ"},"context":"﴿وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ فَلْيَسْتَجِيبُوا لِي وَلْيُؤْمِنُوا بِي لَعَلَّهُمْ يَرْشُدُونَ﴾ — بين آيات الصيام.","reason":"سألوا عن الله فأجاب بنفسه بلا واسطة: حُذف الأمر (قل) الذي يتكرر في أجوبة القرآن — فجاء الجواب مباشرًا: ﴿فَإِنِّي قَرِيبٌ﴾؛ وسمّاهم ﴿عِبَادِي﴾ تكريمًا، وجاءت ضمائر المتكلم فيها سبع مرات في آيةٍ واحدة. وموضعُها بين آيات الصيام: فالصيامُ موسمُ إجابة.","adds":"أحصِ ضمائر المتكلم في الآية: عبادي، عني، فإني، أجيب، دعاني، لي، بي — قربٌ في المعنى وفي بناء الجملة معًا."}],"hadiths":[],"sunnah":{"card":"الصيغة: الْقَرِيبُ — مفردة\nفي السنة: شاهد واحد (روايتان)\nخصوصية الورود في السنة: ورد مفردًا في تعداد الأسماء: «…العلي، الحكيم، القريب، المجيب…» في رواية ابن ماجه، وفي رواية المستدرك. روجعت مواضعه فحُذف ما جاء فيه «القريب» بمعنى ذي القربى.","teaches":"1. أنه قريب مجيب.","whenRecall":"- في إحصاء الأسماء.\n- عند الدعاء.","whenPray":"عند الشعور بـ:\n1. البعد.\nعند طلب:\n1. الإجابة.\nعند الرغبة في:\n1. إحصاء الأسماء.","duaItems":"لا صيغة منصوصة؛ انظر «السميع القريب» و«قريب مجيب».","summary":"«القريب» في السنة محصًى مقرونًا بالمجيب."},"situations":[{"situationId":164,"verses":[{"i":1,"strength":"direct","headline":"الحاجة إلى الدعاء والشك في قرب الله وإجابته","bridge":"تريد أن تُحسن الطلب؟ سألوا النبي ﷺ عن الله فأجاب الله بنفسه بلا (قل): ﴿وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ﴾ — أحصِ ضمائر المتكلم: عبادي، عني، فإني، أجيب، دعاني، لي، بي؛ قربٌ في المعنى وفي بناء الجملة، والشرط بعدها: ﴿فَلْيَسْتَجِيبُوا لِي وَلْيُؤْمِنُوا بِي﴾."}],"hadiths":[]}]},{"id":187,"name":"عالم الغيب","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: عَالِمُ الْغَيْبِ (مفردةً ومع الشهادة) | المواضع: 12\nخصوصية: يجمع مواضع «عالم الغيب» بشقّيها — وفيه الآيةُ الحاسمة التي تُبطل كل دعوى اطلاعٍ على الغيب: ﴿فَلَا يُظْهِرُ عَلَى غَيْبِهِ أَحَدًا﴾.\n\nالمعنى:\n- عالم الغيب: المحيط علمًا بما غاب عن الخلق — ماضيًا وحاضرًا ومستقبلًا، في الآفاق والنفوس.","teaches":"الحقائق التي كشفتها المواضع:\n1. باب الاطلاع على الغيب مغلق إلا بوحيٍ لرسول مرتضى (الجن 26-27).\n2. الأعذار المصنوعة تشتري وقتًا لا براءة (التوبة 94).\n3. عملك يُعرض مرتين: على الناس وعلى عالم الغيب (التوبة 105).\n4. من فرّ من الموت لقيه (الجمعة 8).\n5. العلم الشامل مقرونٌ بالرحمة لا بالتربّص (الحشر 22).","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- عند سماع دعاوى الكهانة والتنجيم.\n- عند صياغة عذرٍ غير صادق.\n- عند الخوف من الموت والفرار من ذكره.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. تفويض الخلافات: ﴿اللَّهُمَّ فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ عَالِمَ الْغَيْبِ وَالشَّهَادَةِ أَنْتَ تَحْكُمُ﴾ — الزمر 46.\n2. الاستعداد للردّ إليه — التوبة 105، الجمعة 8.\n3. التبرؤ من تصديق مدّعي الغيب — الجن 26.","summary":"﴿عَالِمُ الْغَيْبِ فَلَا يُظْهِرُ عَلَى غَيْبِهِ أَحَدًا﴾ — بابٌ مغلق إلا بوحيٍ لرسول؛ فكلُّ مدّعٍ للغيب بعد خاتم الرسل كاذب.","verses":[{"i":1,"of":2,"s":34,"surah":"سبأ","a":3,"text":"وَقَالَ الَّذِينَ كَفَرُوا لَا تَأْتِينَا السَّاعَةُ قُلْ بَلَى وَرَبِّي لَتَأْتِيَنَّكُمْ عَالِمِ الْغَيْبِ لَا يَعْزُبُ عَنْهُ مِثْقَالُ ذَرَّةٍ فِي السَّمَاوَاتِ وَلَا فِي الْأَرْضِ وَلَا أَصْغَرُ مِنْ ذَلِكَ وَلَا أَكْبَرُ إِلَّا فِي كِتَابٍ مُبِينٍ","prev":{"a":2,"text":"يَعْلَمُ مَا يَلِجُ فِي الْأَرْضِ وَمَا يَخْرُجُ مِنْهَا وَمَا يَنْزِلُ مِنَ السَّمَاءِ وَمَا يَعْرُجُ فِيهَا وَهُوَ الرَّحِيمُ الْغَفُورُ"},"next":{"a":4,"text":"لِيَجْزِيَ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ أُولَئِكَ لَهُمْ مَغْفِرَةٌ وَرِزْقٌ كَرِيمٌ"},"reason":"قسمٌ مؤكد على إتيان الساعة بوصف «عالم الغيب» — ثم البرهان: ﴿لَا يَعْزُبُ عَنْهُ مِثْقَالُ ذَرَّةٍ﴾؛ فمن أحصى الذرات قادرٌ على جمعها وحسابها، وموعدُ الساعة جزءٌ من علمه لا من ظنون البشر.","adds":"أُمر النبي ﷺ أن يقسم على البعث: ﴿قُلْ بَلَى وَرَبِّي لَتَأْتِيَنَّكُمْ﴾ — فالساعة آتيةٌ بقسمٍ على لسان نبيّه."},{"i":2,"of":2,"s":72,"surah":"الجن","a":26,"text":"عَالِمُ الْغَيْبِ فَلَا يُظْهِرُ عَلَى غَيْبِهِ أَحَدًا","prev":{"a":25,"text":"قُلْ إِنْ أَدْرِي أَقَرِيبٌ مَا تُوعَدُونَ أَمْ يَجْعَلُ لَهُ رَبِّي أَمَدًا"},"next":{"a":27,"text":"إِلَّا مَنِ ارْتَضَى مِنْ رَسُولٍ فَإِنَّهُ يَسْلُكُ مِنْ بَيْنِ يَدَيْهِ وَمِنْ خَلْفِهِ رَصَدًا"},"reason":"حصرٌ قاطع: لا يُظهر على غيبه أحدًا — واستثناءٌ ضيق: رسولٌ مرتضى، وبقدر ما يوحى إليه فقط؛ فبابُ الاطلاع على الغيب مغلقٌ إلا بوحيٍ لرسول، وقد خُتمت الرسالة.","adds":"أقوى آيةٍ تُبطل دعاوى الكهانة والتنجيم والمكاشفة: ﴿فَلَا يُظْهِرُ عَلَى غَيْبِهِ أَحَدًا﴾."}],"hadiths":[],"situations":[{"situationId":20,"verses":[{"i":1,"strength":"direct","headline":"التسويف بالتوبة لأن الساعة تبدو بعيدة","bridge":"تؤجل التوبة لأن الساعة تبدو بعيدة؟ أُمر النبي ﷺ بالقسم: ﴿قُلْ بَلَى وَرَبِّي لَتَأْتِيَنَّكُمْ عَالِمِ الْغَيْبِ لَا يَعْزُبُ عَنْهُ مِثْقَالُ ذَرَّةٍ فِي السَّمَاوَاتِ وَلَا فِي الْأَرْضِ﴾ — موعدها في علمه لا في ظنونك، ومن أحصى الذرات لا يفوته تأجيلك؛ فما تؤجله محسوبٌ بمثقال الذرة."}],"hadiths":[]},{"situationId":113,"verses":[{"i":2,"strength":"direct","headline":"ادعاء المكاشفة وعلم الغيب بالتنجيم والكهانة","bridge":"يدّعي أحدٌ مكاشفةً أو علم غيبٍ بتنجيمٍ أو كهانة؟ أقوى آيةٍ تبطل دعواه: ﴿عَالِمُ الْغَيْبِ فَلَا يُظْهِرُ عَلَى غَيْبِهِ أَحَدًا * إِلَّا مَنِ ارْتَضَى مِنْ رَسُولٍ﴾ — حصرٌ قاطع واستثناءٌ ضيق: رسولٌ مرتضى بقدر ما يوحى إليه فقط، وقد خُتمت الرسل؛ فالباب مغلق."}],"hadiths":[]}]},{"id":188,"name":"نعم الوكيل","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: نِعْمَ الْوَكِيلُ — صيغة مدح | المواضع: 1 (آل عمران: 173)\nخصوصية: قالها إبراهيم حين أُلقي في النار، وقالها النبي ﷺ وأصحابه بعد أُحد — وهي كلمةُ المؤمنين ساعةَ الإرهاب النفسي.\n\nالمعنى:\n- نعم الوكيل: أفضلُ من يُوكَّل إليه الأمر — لأنه يعلم ويقدر ويرحم؛ فالوكيلُ الكامل من اجتمع فيه الثلاثة.","teaches":"الحقائق التي كشفها الموضع:\n1. التخويف المنظم يزيد المؤمن إيمانًا لا خوفًا.\n2. سلاح اللحظة كلمةٌ واحدة: حسبنا الله ونعم الوكيل.\n3. النتيجة الموعودة: ﴿لَمْ يَمْسَسْهُمْ سُوءٌ﴾.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند حملة تخويفٍ أو تهديد.\n- عند سماع أخبارٍ تُقصد بها إرهابك.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. «حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ» — رواه البخاري عن ابن عباس.\n2. سؤال زيادة الإيمان عند التخويف — آل عمران 173.\n3. تفويض النتائج بعد بذل الوسع.","summary":"قيل لهم ﴿إِنَّ النَّاسَ قَدْ جَمَعُوا لَكُمْ فَاخْشَوْهُمْ﴾ فزادهم إيمانًا وقالوا كلمةً واحدة: «حسبنا الله ونعم الوكيل» — فانقلبوا بنعمةٍ لم يمسسهم سوء.","verses":[{"i":1,"of":1,"s":3,"surah":"آل عمران","a":173,"text":"الَّذِينَ قَالَ لَهُمُ النَّاسُ إِنَّ النَّاسَ قَدْ جَمَعُوا لَكُمْ فَاخْشَوْهُمْ فَزَادَهُمْ إِيمَانًا وَقَالُوا حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ","prev":{"a":172,"text":"الَّذِينَ اسْتَجَابُوا لِلَّهِ وَالرَّسُولِ مِنْ بَعْدِ مَا أَصَابَهُمُ الْقَرْحُ لِلَّذِينَ أَحْسَنُوا مِنْهُمْ وَاتَّقَوْا أَجْرٌ عَظِيمٌ"},"next":{"a":174,"text":"فَانْقَلَبُوا بِنِعْمَةٍ مِنَ اللَّهِ وَفَضْلٍ لَمْ يَمْسَسْهُمْ سُوءٌ وَاتَّبَعُوا رِضْوَانَ اللَّهِ وَاللَّهُ ذُو فَضْلٍ عَظِيمٍ"},"context":"بعد أُحد خرج النبي ﷺ وأصحابه إلى حمراء الأسد وهم جرحى (مجمع الزوائد 6/124)، فأتاهم من يخوّفهم بجمع أبي سفيان: ﴿الَّذِينَ قَالَ لَهُمُ النَّاسُ إِنَّ النَّاسَ قَدْ جَمَعُوا لَكُمْ فَاخْشَوْهُمْ فَزَادَهُمْ إِيمَانًا وَقَالُوا حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ﴾.","reason":"حربٌ نفسية منظمة — ﴿فَاخْشَوْهُمْ﴾ — فكانت النتيجة عكسية تمامًا: ﴿فَزَادَهُمْ إِيمَانًا﴾؛ والسلاحُ كلمةٌ واحدة: حسبنا الله ونعم الوكيل. فانقلبت النتيجة: ﴿فَانْقَلَبُوا بِنِعْمَةٍ مِنَ اللَّهِ وَفَضْلٍ لَمْ يَمْسَسْهُمْ سُوءٌ﴾.","adds":"الحسبلة سلاحُ ساعة التخويف: قالها المؤمنون جرحى أمام جمعٍ يُخوَّفون به، فزادتهم إيمانًا وانقلبوا بنعمةٍ وفضلٍ لم يمسسهم سوء.","dorar":[{"id":"ZwSnBKE8","label":"مجمع الزوائد 6/124"},{"id":"OXdwmQiR","label":"صحيح البخاري 4077"},{"id":"IMnKSEJR","label":"المستدرك على الصحيحين 3208"}]}],"hadiths":[{"i":1,"of":4,"text":"عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهُما، قالَ: آخِرُ كلامِ إبراهيمَ حين أُلقِيَ في النَّارِ: حَسْبيَ اللهُ ونِعْمَ الوكيلُ، وقالَ نبِيُّكُم صلَّى اللهُ عليه وسلَّمَ مِثلَها: {الَّذِينَ قَالَ لَهُمُ النَّاسُ إِنَّ النَّاسَ قَدْ جَمَعُوا لَكُمْ فَاخْشَوْهُمْ فَزَادَهُمْ إِيمَانًا وَقَالُوا حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ} [آل عمران: 173].","narrator":"أبو الضحى","source":"المستدرك على الصحيحين 3208","grade":"صحيح","judgment":"صحيح على شرط الشيخين","url":"https://dorar.net/h/IMnKSEJR","nameForm":"ونِعْمَ الوكيلُ ؛ وَنِعْمَ الْوَكِيلُ","scene":"ابن عباس: «آخر كلام إبراهيم حين أُلقي في النار: حسبي الله ونعم الوكيل، وقال نبيكم ﷺ مثلها: ﴿الَّذِينَ قَالَ لَهُمُ النَّاسُ إِنَّ النَّاسَ قَدْ جَمَعُوا لَكُمْ فَاخْشَوْهُمْ فَزَادَهُمْ إِيمَانًا وَقَالُوا حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ﴾».","reason":"كلمة النار والحصار: إبراهيم حين أُلقي في النار والنبي ﷺ أمام جمع الناس — كلاهما وكّل الأمر إلى من نعم الوكيل. فالاسم كلمة الأنبياء حين تنقطع الحيل.","adds":"كلمة نبيَّين في أشد المواقف: إبراهيم في النار، والنبي ﷺ حين قيل له: إن الناس قد جمعوا لكم."},{"i":2,"of":4,"text":"تحصَّنتُ بالذي لا إلهَ إلَّا هو إلهي وإلهُ كلِّ شيءٍ واعتصمتُ بربِّي وبربِّ كلِّ شيءٍ وتوكلتُ على الحيِّ الذي لا يموتُ واستدفعتُ الشرَّ بلا حولَ ولا قوةَ إلَّا باللهِ ، حسبيَ اللهُ ونعمَ الوكيلُ ، حسبيَ الربُّ من العبادِ ، حسبيَ الخالقُ من المخلوقِ ، حسبيَ الرزاقُ من المرزوقِ ، حسبيَ الذي هو حسبي ، حسبيَ الذي بيدهِ ملكوتُ كلِّ شيءٍ ، وهو يجيرُ ولا يجارُ عليه ، حسبيَ اللهُ وكفَى ، سمِع اللهُ لمن دعا ، ليس وراءَ اللهِ مَرمَى ، حسبيَ اللهُ لا إلهَ إلَّا هو عليه توكلتُ وهو ربُّ العرشِ العظيمِ","narrator":"-","source":"سفر السعادة 310","grade":"صحيح","url":"https://dorar.net/h/kUN6OVoQ","nameForm":"ونعمَ الوكيلُ","scene":"دعاء التحصن: «…حسبي الله ونعم الوكيل، حسبي الرب من العباد…».","reason":"الاسم في سلسلة الحسب: كفايةٌ بحسن التوكيل.","adds":"يعطي الاسم في صيغة تحصن."},{"i":3,"of":4,"text":"أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ قضَى بينَ رجُلَيْنِ فقالَ المقضيُّ عليهِ لما أدبرَ : حسبيَ اللَّهُ ونعمَ الوَكيلُ . فقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ : ردُّوا عليَّ الرَّجلَ . فقالَ : ما قلتَ ؟ . قالَ : قلتُ : حسبيَ اللَّهُ ونعمَ الوَكيلُ . فقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ : إنَّ اللَّهَ يلومُ علَى العجزِ ، ولَكِن عليكَ بالكَيسِ ، فإذا غلبَكَ أمرٌ فقُلْ : حسبيَ اللَّهُ ونعمَ الوَكيلُ","narrator":"عوف بن مالك الأشجعي","source":"عمدة التفسير 1/441","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/crgAnxGW","nameForm":"ونعمَ الوَكيلُ ؛ ونعمَ الوَكيلُ ؛ ونعمَ الوَكيلُ","scene":"قضى النبي ﷺ بين رجلين فقال المقضي عليه لما أدبر: حسبي الله ونعم الوكيل. فقال: «ردوا عليّ الرجل، ما قلت؟» قال: حسبي الله ونعم الوكيل. فقال: «إن الله يلوم على العجز، ولكن عليك بالكيس، فإذا غلبك أمر فقل: حسبي الله ونعم الوكيل».","reason":"الكلمة لا تُقال عجزًا عن الأخذ بالأسباب بل بعد استنفادها: «فإذا غلبك أمر» — فالاسم لمن بذل الكيس ثم غُلب.","adds":"يضع شرط استعمال الاسم: بعد الكيس لا قبله."},{"i":4,"of":4,"text":"ومن حديثِ ابنِ عباسٍ أيضًا [يعني حديث: في قَولِه: {فَإِذَا نُقِرَ فِي النَّاقُورِ} [المدثر: 8] قال: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: كيف أَنعَمُ وَصاحِبُ القَرنِ قد التقَمَ القَرنَ، وحَنى جَبهَتَه يَسمَعُ مَتى يُؤمَرُ، فيَنفُخُ؟! فقال أَصحابُ محمدٍ: كيف نَقولُ؟ قال: قولوا: حَسبُنا اللهُ، ونِعمَ الوَكيلُ، على اللهِ توَكَّلْنا.]","narrator":"عبدالله بن عباس","source":"صحيح الترغيب 3571","grade":"صحيح","url":"https://dorar.net/h/H5chE83g","nameForm":"ونِعمَ الوَكيلُ","scene":"«كيف أنعم وصاحب القرن قد التقم القرن وحنى جبهته يسمع متى يؤمر فينفخ؟» فقال أصحابه: كيف نقول؟ قال: «قولوا: حسبنا الله ونعم الوكيل، على الله توكلنا».","reason":"هول انتظار النفخة يُقابل بالكلمة: إذا لم يبق إلا انتظار الصور فليس إلا التوكيل — نعم الوكيل يكفي الهول.","adds":"يعطي الاسم جوابًا على هول الآخرة."}],"sunnah":{"card":"الصيغة: نِعْمَ الْوَكِيلُ — مركّبة، من قوله ﴿حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ﴾\nفي السنة: 4 شواهد (12 رواية)\nخصوصية الورود في السنة: آخر كلام إبراهيم في النار «حسبي الله ونعم الوكيل» وقالها النبي ﷺ حين قيل إن الناس قد جمعوا لكم؛ وأمر النبي ﷺ أصحابه أن يقولوها لما ذكر صاحب القرن: «قولوا: حسبنا الله ونعم الوكيل على الله توكلنا»؛ وردّ على المقضي عليه الذي قالها عاجزًا: «إن الله يلوم على العجز ولكن عليك بالكيس».\nالمعنى المختصر: نعم من يُوكل إليه الأمر فيكفي.","teaches":"1. أنه نعم من يُوكل إليه في النار والحصار والهول.\n2. أنه يلوم على العجز ويرضى التوكيل بعد الكيس.\n3. أن الأنبياء اختاروا هذه الكلمة عند انقطاع الحيل.","whenRecall":"- حين يغلبك أمر بعد بذل الوسع.\n- حين يُخوّفك الناس بجمعهم.\n- حين تذكر النفخة في الصور.","whenPray":"عند الشعور بـ:\n1. الغلبة بعد الاجتهاد.\n2. التهديد بجمع الناس.\n3. هول الآخرة.\nعند طلب:\n1. الكفاية.\nعند الرغبة في:\n1. التوكل بعد الكيس لا بدله.","duaItems":"«حسبنا الله ونعم الوكيل، على الله توكلنا» — صحيح الترمذي 2431؛ و«فإذا غلبك أمر فقل: حسبي الله ونعم الوكيل» — عمدة التفسير 1/441 (إسناده صحيح).","summary":"«نعم الوكيل» في السنة آخر كلام إبراهيم في النار وكلمة النبي ﷺ أمام الجمع، تُقال بعد الكيس إذا غلبك أمر — وجواب هول الصور."},"situations":[{"situationId":12,"verses":[],"hadiths":[{"i":2,"strength":"direct","headline":"طلب الكفاية من شرّ العباد بحسن التوكل","bridge":"تريد صيغة تحصّنٍ تجمع الحسبنة؟ في دعاء التحصن: «…حسبي الله ونعم الوكيل، حسبي الرب من العباد، حسبي الخالق من المخلوق» — الاسم في سلسلة الحسب: كفايةٌ بحسن التوكيل؛ فاجعلها في وردك."}]},{"situationId":31,"verses":[{"i":1,"strength":"direct","headline":"الكرب الشديد والحصار من كل جهة","bridge":"أطبق عليك الأمر وحوصرت من كل جهة؟ قالها جرحى أُحد وقد قيل لهم ﴿إِنَّ النَّاسَ قَدْ جَمَعُوا لَكُمْ فَاخْشَوْهُمْ﴾ فكان جوابهم: ﴿حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ﴾ — فانقلبوا ﴿بِنِعْمَةٍ مِنَ اللَّهِ وَفَضْلٍ لَمْ يَمْسَسْهُمْ سُوءٌ﴾؛ فقلها في كربك كما قالوها."}],"hadiths":[{"i":1,"strength":"direct","headline":"شدةٌ قصوى تنقطع فيها الحيل ويجتمع عليك الناس","bridge":"يخوّفونك بجمعهم؟ ﴿إِنَّ النَّاسَ قَدْ جَمَعُوا لَكُمْ فَاخْشَوْهُمْ فَزَادَهُمْ إِيمَانًا وَقَالُوا حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ﴾ — كلمة إبراهيم في النار قالها النبي ﷺ."}]},{"situationId":102,"verses":[],"hadiths":[{"i":3,"strength":"direct","headline":"الاستسلام للعجز قبل بذل الأسباب","bridge":"تقولها قبل أن تجتهد؟ قال النبي ﷺ لمن قالها عاجزًا: «إن الله يلوم على العجز ولكن عليك بالكيس، فإذا غلبك أمر فقل: حسبي الله ونعم الوكيل» — الكيس أولًا."}]},{"situationId":183,"verses":[],"hadiths":[{"i":4,"strength":"direct","headline":"هول انتظار نفخة الصور وأهوال الآخرة","bridge":"هالك انتظار الصور؟ قال النبي ﷺ: «قولوا: حسبنا الله ونعم الوكيل، على الله توكلنا»."}]}]},{"id":189,"name":"عليم بذات الصدور","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: عَلِيمٌ بِذَاتِ الصُّدُورِ — | المواضع: 12\nخصوصية: «ذات الصدور» أخصُّ من السرّ: ما لم يُنطق أصلًا — خواطرُ وميولٌ ونياتٌ لم تخرج بعد؛ ويتردد في مواضع كشف العلاقات المزيفة وفرز القلوب في المحن.\n\nالمعنى:\n- عليم بذات الصدور: المحيط علمًا بما استقر في الصدور من نياتٍ وخواطر — لا يخفى عليه ما لم يُنطق قط.","teaches":"الحقائق التي كشفتها المواضع:\n1. المحن أدواتُ فرزٍ لا عقوبات: ﴿وَلِيَبْتَلِيَ اللَّهُ مَا فِي صُدُورِكُمْ﴾ (آل عمران 154).\n2. قد يحجب عنك معلوماتٍ رحمةً بصدرك (الأنفال 43).\n3. الحُجب المادية لا تحجب: ﴿حِينَ يَسْتَغْشُونَ ثِيَابَهُمْ﴾ (هود 5).\n4. المواثيق تُقاس بما في الصدور لا بما جرى على اللسان (المائدة 7).\n5. البرهان الأوجز: ﴿أَلَا يَعْلَمُ مَنْ خَلَقَ﴾ (الملك 14).","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- عند بناء علاقةٍ من طرفٍ واحد.\n- عند عهدٍ تقوله ولا يوافقه قلبك.\n- عند خاطرٍ لم تنطق به.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. سؤال سلامة الصدر: «اللهم طهّر قلبي من النفاق».\n2. الثبات في المحن التي تُمحّص القلوب — آل عمران 154.\n3. الاستعاذة من ظن الجاهلية عند الشدائد.","summary":"«ذات الصدور» ما لم تنطق به قط — ويعلمه: ﴿أَلَا يَعْلَمُ مَنْ خَلَقَ﴾؟ فأصلح ما لا يراه أحد.","verses":[{"i":1,"of":12,"s":3,"surah":"آل عمران","a":119,"text":"هَا أَنْتُمْ أُولَاءِ تُحِبُّونَهُمْ وَلَا يُحِبُّونَكُمْ وَتُؤْمِنُونَ بِالْكِتَابِ كُلِّهِ وَإِذَا لَقُوكُمْ قَالُوا آمَنَّا وَإِذَا خَلَوْا عَضُّوا عَلَيْكُمُ الْأَنَامِلَ مِنَ الْغَيْظِ قُلْ مُوتُوا بِغَيْظِكُمْ إِنَّ اللَّهَ عَلِيمٌ بِذَاتِ الصُّدُورِ","prev":{"a":118,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَتَّخِذُوا بِطَانَةً مِنْ دُونِكُمْ لَا يَأْلُونَكُمْ خَبَالًا وَدُّوا مَا عَنِتُّمْ قَدْ بَدَتِ الْبَغْضَاءُ مِنْ أَفْوَاهِهِمْ وَمَا تُخْفِي صُدُورُهُمْ أَكْبَرُ قَدْ بَيَّنَّا لَكُمُ الْآيَاتِ إِنْ كُنْتُمْ تَعْقِلُونَ"},"next":{"a":120,"text":"إِنْ تَمْسَسْكُمْ حَسَنَةٌ تَسُؤْهُمْ وَإِنْ تُصِبْكُمْ سَيِّئَةٌ يَفْرَحُوا بِهَا وَإِنْ تَصْبِرُوا وَتَتَّقُوا لَا يَضُرُّكُمْ كَيْدُهُمْ شَيْئًا إِنَّ اللَّهَ بِمَا يَعْمَلُونَ مُحِيطٌ"},"context":"﴿هَا أَنْتُمْ أُولَاءِ تُحِبُّونَهُمْ وَلَا يُحِبُّونَكُمْ... وَإِذَا خَلَوْا عَضُّوا عَلَيْكُمُ الْأَنَامِلَ مِنَ الْغَيْظِ قُلْ مُوتُوا بِغَيْظِكُمْ إِنَّ اللَّهَ عَلِيمٌ بِذَاتِ الصُّدُورِ﴾.","reason":"كشفٌ لعلاقةٍ من طرف واحد: تحبونهم ولا يحبونكم — والدليلُ سلوكٌ خفي: عضُّ الأنامل من الغيظ في الخلوة؛ فالعليم بذات الصدور يكشف لك حقيقة من تودّهم وهم يبيّتون لك الغيظ.","adds":"أعظم آيةٍ في فقه العلاقات: لا تبنِ ودًّا من طرفٍ واحد — فالله يكشف لك ما في صدورهم."},{"i":2,"of":12,"s":3,"surah":"آل عمران","a":154,"text":"ثُمَّ أَنْزَلَ عَلَيْكُمْ مِنْ بَعْدِ الْغَمِّ أَمَنَةً نُعَاسًا يَغْشَى طَائِفَةً مِنْكُمْ وَطَائِفَةٌ قَدْ أَهَمَّتْهُمْ أَنْفُسُهُمْ يَظُنُّونَ بِاللَّهِ غَيْرَ الْحَقِّ ظَنَّ الْجَاهِلِيَّةِ يَقُولُونَ هَلْ لَنَا مِنَ الْأَمْرِ مِنْ شَيْءٍ قُلْ إِنَّ الْأَمْرَ كُلَّهُ لِلَّهِ يُخْفُونَ فِي أَنْفُسِهِمْ مَا لَا يُبْدُونَ لَكَ يَقُولُونَ لَوْ كَانَ لَنَا مِنَ الْأَمْرِ شَيْءٌ مَا قُتِلْنَا هَاهُنَا قُلْ لَوْ كُنْتُمْ فِي بُيُوتِكُمْ لَبَرَزَ الَّذِينَ كُتِبَ عَلَيْهِمُ الْقَتْلُ إِلَى مَضَاجِعِهِمْ وَلِيَبْتَلِيَ اللَّهُ مَا فِي صُدُورِكُمْ وَلِيُمَحِّصَ مَا فِي قُلُوبِكُمْ وَاللَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ","prev":{"a":153,"text":"إِذْ تُصْعِدُونَ وَلَا تَلْوُونَ عَلَى أَحَدٍ وَالرَّسُولُ يَدْعُوكُمْ فِي أُخْرَاكُمْ فَأَثَابَكُمْ غَمًّا بِغَمٍّ لِكَيْلَا تَحْزَنُوا عَلَى مَا فَاتَكُمْ وَلَا مَا أَصَابَكُمْ وَاللَّهُ خَبِيرٌ بِمَا تَعْمَلُونَ"},"next":{"a":155,"text":"إِنَّ الَّذِينَ تَوَلَّوْا مِنْكُمْ يَوْمَ الْتَقَى الْجَمْعَانِ إِنَّمَا اسْتَزَلَّهُمُ الشَّيْطَانُ بِبَعْضِ مَا كَسَبُوا وَلَقَدْ عَفَا اللَّهُ عَنْهُمْ إِنَّ اللَّهَ غَفُورٌ حَلِيمٌ"},"context":"بعد أُحد: ﴿ثُمَّ أَنْزَلَ عَلَيْكُمْ مِنْ بَعْدِ الْغَمِّ أَمَنَةً نُعَاسًا يَغْشَى طَائِفَةً مِنْكُمْ وَطَائِفَةٌ قَدْ أَهَمَّتْهُمْ أَنْفُسُهُمْ يَظُنُّونَ بِاللَّهِ غَيْرَ الْحَقِّ ظَنَّ الْجَاهِلِيَّةِ... وَلِيَبْتَلِيَ اللَّهُ مَا فِي صُدُورِكُمْ وَلِيُمَحِّصَ مَا فِي قُلُوبِكُمْ وَاللَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ﴾.","reason":"فرزٌ دقيق بين طائفتين في اللحظة نفسها: طائفةٌ يغشاها النعاس أمنةً، وطائفةٌ أهمّتها أنفسها تظن ظن الجاهلية — والغايةُ معلنة: ابتلاءُ ما في الصدور وتمحيصُ ما في القلوب؛ فالمحنُ أدواتُ فرزٍ لا عقوبات.","adds":"النعاس في ساعة الخوف علامةُ طمأنينةِ قلب — فانظر ماذا تفعل بك ساعةُ الخطر."},{"i":3,"of":12,"s":5,"surah":"المائدة","a":7,"text":"وَاذْكُرُوا نِعْمَةَ اللَّهِ عَلَيْكُمْ وَمِيثَاقَهُ الَّذِي وَاثَقَكُمْ بِهِ إِذْ قُلْتُمْ سَمِعْنَا وَأَطَعْنَا وَاتَّقُوا اللَّهَ إِنَّ اللَّهَ عَلِيمٌ بِذَاتِ الصُّدُورِ","prev":{"a":6,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا قُمْتُمْ إِلَى الصَّلَاةِ فَاغْسِلُوا وُجُوهَكُمْ وَأَيْدِيَكُمْ إِلَى الْمَرَافِقِ وَامْسَحُوا بِرُءُوسِكُمْ وَأَرْجُلَكُمْ إِلَى الْكَعْبَيْنِ وَإِنْ كُنْتُمْ جُنُبًا فَاطَّهَّرُوا وَإِنْ كُنْتُمْ مَرْضَى أَوْ عَلَى سَفَرٍ أَوْ جَاءَ أَحَدٌ مِنْكُمْ مِنَ الْغَائِطِ أَوْ لَامَسْتُمُ النِّسَاءَ فَلَمْ تَجِدُوا مَاءً فَتَيَمَّمُوا صَعِيدًا طَيِّبًا فَامْسَحُوا بِوُجُوهِكُمْ وَأَيْدِيكُمْ مِنْهُ مَا يُرِيدُ اللَّهُ لِيَجْعَلَ عَلَيْكُمْ مِنْ حَرَجٍ وَلَكِنْ يُرِيدُ لِيُطَهِّرَكُمْ وَلِيُتِمَّ نِعْمَتَهُ عَلَيْكُمْ لَعَلَّكُمْ تَشْكُرُونَ"},"next":{"a":8,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا كُونُوا قَوَّامِينَ لِلَّهِ شُهَدَاءَ بِالْقِسْطِ وَلَا يَجْرِمَنَّكُمْ شَنَآنُ قَوْمٍ عَلَى أَلَّا تَعْدِلُوا اعْدِلُوا هُوَ أَقْرَبُ لِلتَّقْوَى وَاتَّقُوا اللَّهَ إِنَّ اللَّهَ خَبِيرٌ بِمَا تَعْمَلُونَ"},"reason":"ذُكّروا بميثاق «سمعنا وأطعنا» — وهو قولٌ باللسان قد يخالفه القلب — فخُتم بالعليم بذات الصدور: فالميثاقُ يُقاس بما في الصدر لا بما جرى على اللسان.","adds":"كل بيعةٍ أو عهدٍ تقوله بلسانك يُقاس بما في صدرك: ﴿سَمِعْنَا وَأَطَعْنَا﴾ قولٌ ومعنى."},{"i":4,"of":12,"s":8,"surah":"الأنفال","a":43,"text":"إِذْ يُرِيكَهُمُ اللَّهُ فِي مَنَامِكَ قَلِيلًا وَلَوْ أَرَاكَهُمْ كَثِيرًا لَفَشِلْتُمْ وَلَتَنَازَعْتُمْ فِي الْأَمْرِ وَلَكِنَّ اللَّهَ سَلَّمَ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ","prev":{"a":42,"text":"إِذْ أَنْتُمْ بِالْعُدْوَةِ الدُّنْيَا وَهُمْ بِالْعُدْوَةِ الْقُصْوَى وَالرَّكْبُ أَسْفَلَ مِنْكُمْ وَلَوْ تَوَاعَدْتُمْ لَاخْتَلَفْتُمْ فِي الْمِيعَادِ وَلَكِنْ لِيَقْضِيَ اللَّهُ أَمْرًا كَانَ مَفْعُولًا لِيَهْلِكَ مَنْ هَلَكَ عَنْ بَيِّنَةٍ وَيَحْيَى مَنْ حَيَّ عَنْ بَيِّنَةٍ وَإِنَّ اللَّهَ لَسَمِيعٌ عَلِيمٌ"},"next":{"a":44,"text":"وَإِذْ يُرِيكُمُوهُمْ إِذِ الْتَقَيْتُمْ فِي أَعْيُنِكُمْ قَلِيلًا وَيُقَلِّلُكُمْ فِي أَعْيُنِهِمْ لِيَقْضِيَ اللَّهُ أَمْرًا كَانَ مَفْعُولًا وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ"},"context":"بدر: ﴿إِذْ يُرِيكَهُمُ اللَّهُ فِي مَنَامِكَ قَلِيلًا وَلَوْ أَرَاكَهُمْ كَثِيرًا لَفَشِلْتُمْ وَلَتَنَازَعْتُمْ فِي الْأَمْرِ وَلَكِنَّ اللَّهَ سَلَّمَ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ﴾.","reason":"تقليلُ العدو في منام النبي ﷺ تدبيرٌ نفسي مقصود — لأن العليم بذات الصدور يعلم أن رؤية الكثرة تورث الفشل والتنازع؛ فأخفى عنهم ما يضرّ علمُه بهم.","adds":"قد يحجب عنك معلوماتٍ رحمةً بك: يعلم ما يحتمله صدرُك وما يكسره."},{"i":5,"of":12,"s":11,"surah":"هود","a":5,"text":"أَلَا إِنَّهُمْ يَثْنُونَ صُدُورَهُمْ لِيَسْتَخْفُوا مِنْهُ أَلَا حِينَ يَسْتَغْشُونَ ثِيَابَهُمْ يَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِنُونَ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ","prev":{"a":4,"text":"إِلَى اللَّهِ مَرْجِعُكُمْ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},"next":{"a":6,"text":"وَمَا مِنْ دَابَّةٍ فِي الْأَرْضِ إِلَّا عَلَى اللَّهِ رِزْقُهَا وَيَعْلَمُ مُسْتَقَرَّهَا وَمُسْتَوْدَعَهَا كُلٌّ فِي كِتَابٍ مُبِينٍ"},"reason":"صورةٌ حسية للاستخفاء: يثنون صدورهم ويستغشون ثيابهم ظنًّا أن ذلك يحجب — فجاء الردّ: يعلم السرَّ والعلن وذات الصدور؛ فالحجبُ المادية لا تحجب عن عالم البواطن.","adds":"لا ستار يحجبك عنه: لا ثوبٌ ولا جدارٌ ولا انحناءةُ صدر — فأصلح ما في الداخل."},{"i":6,"of":12,"s":31,"surah":"لقمان","a":23,"text":"وَمَنْ كَفَرَ فَلَا يَحْزُنْكَ كُفْرُهُ إِلَيْنَا مَرْجِعُهُمْ فَنُنَبِّئُهُمْ بِمَا عَمِلُوا إِنَّ اللَّهَ عَلِيمٌ بِذَاتِ الصُّدُورِ","prev":{"a":22,"text":"وَمَنْ يُسْلِمْ وَجْهَهُ إِلَى اللَّهِ وَهُوَ مُحْسِنٌ فَقَدِ اسْتَمْسَكَ بِالْعُرْوَةِ الْوُثْقَى وَإِلَى اللَّهِ عَاقِبَةُ الْأُمُورِ"},"next":{"a":24,"text":"نُمَتِّعُهُمْ قَلِيلًا ثُمَّ نَضْطَرُّهُمْ إِلَى عَذَابٍ غَلِيظٍ"},"reason":"نهيٌ عن الحزن على كفر الكافرين — مع تفويض المرجع؛ والعليمُ بذات الصدور يعلم من أصرّ عن علمٍ ومن لم يبلغه الحق: فالحكمُ على البواطن ليس من شأنك.","adds":"لا تحمل همّ هداية من أعرض: ﴿فَلَا يَحْزُنْكَ كُفْرُهُ﴾ — بلّغ ولا تحزن."},{"i":7,"of":12,"s":35,"surah":"فاطر","a":38,"text":"إِنَّ اللَّهَ عَالِمُ غَيْبِ السَّمَاوَاتِ وَالْأَرْضِ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ","prev":{"a":37,"text":"وَهُمْ يَصْطَرِخُونَ فِيهَا رَبَّنَا أَخْرِجْنَا نَعْمَلْ صَالِحًا غَيْرَ الَّذِي كُنَّا نَعْمَلُ أَوَلَمْ نُعَمِّرْكُمْ مَا يَتَذَكَّرُ فِيهِ مَنْ تَذَكَّرَ وَجَاءَكُمُ النَّذِيرُ فَذُوقُوا فَمَا لِلظَّالِمِينَ مِنْ نَصِيرٍ"},"next":{"a":39,"text":"هُوَ الَّذِي جَعَلَكُمْ خَلَائِفَ فِي الْأَرْضِ فَمَنْ كَفَرَ فَعَلَيْهِ كُفْرُهُ وَلَا يَزِيدُ الْكَافِرِينَ كُفْرُهُمْ عِنْدَ رَبِّهِمْ إِلَّا مَقْتًا وَلَا يَزِيدُ الْكَافِرِينَ كُفْرُهُمْ إِلَّا خَسَارًا"},"reason":"قُرن غيبُ السماوات والأرض بذات الصدور في آيةٍ واحدة: فصدرُك عالمٌ من عوالم الغيب — بل هو أقربُ غيبٍ إليك وأبعدُه عن غيرك؛ ومن أحاط بغيب العوالم أحاط بغيب صدرك.","adds":"صدرُك غيبٌ كغيب السماوات — يعلمه وحده: فلا تظن خاطرًا يمرّ دون أن يُرصد."},{"i":8,"of":12,"s":39,"surah":"الزمر","a":7,"text":"إِنْ تَكْفُرُوا فَإِنَّ اللَّهَ غَنِيٌّ عَنْكُمْ وَلَا يَرْضَى لِعِبَادِهِ الْكُفْرَ وَإِنْ تَشْكُرُوا يَرْضَهُ لَكُمْ وَلَا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَى ثُمَّ إِلَى رَبِّكُمْ مَرْجِعُكُمْ فَيُنَبِّئُكُمْ بِمَا كُنْتُمْ تَعْمَلُونَ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ","prev":{"a":6,"text":"خَلَقَكُمْ مِنْ نَفْسٍ وَاحِدَةٍ ثُمَّ جَعَلَ مِنْهَا زَوْجَهَا وَأَنْزَلَ لَكُمْ مِنَ الْأَنْعَامِ ثَمَانِيَةَ أَزْوَاجٍ يَخْلُقُكُمْ فِي بُطُونِ أُمَّهَاتِكُمْ خَلْقًا مِنْ بَعْدِ خَلْقٍ فِي ظُلُمَاتٍ ثَلَاثٍ ذَلِكُمُ اللَّهُ رَبُّكُمْ لَهُ الْمُلْكُ لَا إِلَهَ إِلَّا هُوَ فَأَنَّى تُصْرَفُونَ"},"next":{"a":8,"text":"وَإِذَا مَسَّ الْإِنْسَانَ ضُرٌّ دَعَا رَبَّهُ مُنِيبًا إِلَيْهِ ثُمَّ إِذَا خَوَّلَهُ نِعْمَةً مِنْهُ نَسِيَ مَا كَانَ يَدْعُو إِلَيْهِ مِنْ قَبْلُ وَجَعَلَ لِلَّهِ أَنْدَادًا لِيُضِلَّ عَنْ سَبِيلِهِ قُلْ تَمَتَّعْ بِكُفْرِكَ قَلِيلًا إِنَّكَ مِنْ أَصْحَابِ النَّارِ"},"context":"﴿إِنْ تَكْفُرُوا فَإِنَّ اللَّهَ غَنِيٌّ عَنْكُمْ وَلَا يَرْضَى لِعِبَادِهِ الْكُفْرَ وَإِنْ تَشْكُرُوا يَرْضَهُ لَكُمْ... ثُمَّ إِلَى رَبِّكُمْ مَرْجِعُكُمْ فَيُنَبِّئُكُمْ بِمَا كُنْتُمْ تَعْمَلُونَ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ﴾.","reason":"الرضا والسخط متعلقان بالباطن: يرضى لك الشكر لأنه يعلم صدق قلبك فيه، ولا يرضى الكفر — والعليمُ بذات الصدور يميّز شكرَ اللسان من شكر القلب.","adds":"شكرك يُقاس بقلبك: كم من حامدٍ بلسانه ساخطٍ بقلبه — والعليم بذات الصدور يفرّق."},{"i":9,"of":12,"s":42,"surah":"الشورى","a":24,"text":"أَمْ يَقُولُونَ افْتَرَى عَلَى اللَّهِ كَذِبًا فَإِنْ يَشَإِ اللَّهُ يَخْتِمْ عَلَى قَلْبِكَ وَيَمْحُ اللَّهُ الْبَاطِلَ وَيُحِقُّ الْحَقَّ بِكَلِمَاتِهِ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ","prev":{"a":23,"text":"ذَلِكَ الَّذِي يُبَشِّرُ اللَّهُ عِبَادَهُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ قُلْ لَا أَسْأَلُكُمْ عَلَيْهِ أَجْرًا إِلَّا الْمَوَدَّةَ فِي الْقُرْبَى وَمَنْ يَقْتَرِفْ حَسَنَةً نَزِدْ لَهُ فِيهَا حُسْنًا إِنَّ اللَّهَ غَفُورٌ شَكُورٌ"},"next":{"a":25,"text":"وَهُوَ الَّذِي يَقْبَلُ التَّوْبَةَ عَنْ عِبَادِهِ وَيَعْفُو عَنِ السَّيِّئَاتِ وَيَعْلَمُ مَا تَفْعَلُونَ"},"reason":"ردٌّ على تهمة الافتراء بأسلوبٍ فريد: لو افتريتَ لختم على قلبك — لكنه يمحو الباطل ويحق الحق؛ فبقاءُ الوحي واستمرارُه دليلُ صدقه، والعليمُ بذات الصدور يشهد ببراءة قلبه ﷺ.","adds":"استمرارُ الحق وانمحاءُ الباطل عبر القرون برهانٌ عملي: ﴿وَيَمْحُ اللَّهُ الْبَاطِلَ وَيُحِقُّ الْحَقَّ بِكَلِمَاتِهِ﴾."},{"i":10,"of":12,"s":57,"surah":"الحديد","a":6,"text":"يُولِجُ اللَّيْلَ فِي النَّهَارِ وَيُولِجُ النَّهَارَ فِي اللَّيْلِ وَهُوَ عَلِيمٌ بِذَاتِ الصُّدُورِ","prev":{"a":5,"text":"لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ"},"next":{"a":7,"text":"آمِنُوا بِاللَّهِ وَرَسُولِهِ وَأَنْفِقُوا مِمَّا جَعَلَكُمْ مُسْتَخْلَفِينَ فِيهِ فَالَّذِينَ آمَنُوا مِنْكُمْ وَأَنْفَقُوا لَهُمْ أَجْرٌ كَبِيرٌ"},"reason":"قُرن الإيلاجُ التدريجي الخفي بعلم البواطن: فكما يتسلل الليلُ في النهار بلا إحساس، تتسلل الخواطرُ في الصدور بلا إعلان — ومن يدبّر ذاك يعلم هذا.","adds":"التغيّرات الخفية في قلبك تجري كإيلاج الليل في النهار — بطيئةً حتى تنقلب الحال: فراقبها."},{"i":11,"of":12,"s":64,"surah":"التغابن","a":4,"text":"يَعْلَمُ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ وَيَعْلَمُ مَا تُسِرُّونَ وَمَا تُعْلِنُونَ وَاللَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ","prev":{"a":3,"text":"خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ بِالْحَقِّ وَصَوَّرَكُمْ فَأَحْسَنَ صُوَرَكُمْ وَإِلَيْهِ الْمَصِيرُ"},"next":{"a":5,"text":"أَلَمْ يَأْتِكُمْ نَبَأُ الَّذِينَ كَفَرُوا مِنْ قَبْلُ فَذَاقُوا وَبَالَ أَمْرِهِمْ وَلَهُمْ عَذَابٌ أَلِيمٌ"},"context":"﴿يَعْلَمُ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ وَيَعْلَمُ مَا تُسِرُّونَ وَمَا تُعْلِنُونَ وَاللَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ﴾ — في التغابن.","reason":"ثلاثُ دوائر متدرجة: علمُ ما في العوالم، ثم السرُّ والعلن، ثم ذاتُ الصدور — تدرّجٌ من الأوسع إلى الأخفى؛ فالخاتمةُ أدقُّ من كل ما سبقها: ما في الصدر أخفى من السرّ المنطوق.","adds":"«ذات الصدور» أخفى من السرّ: السرُّ ما نطقتَ به همسًا، وذاتُ الصدور ما لم تنطقه أصلًا."},{"i":12,"of":12,"s":67,"surah":"الملك","a":13,"text":"وَأَسِرُّوا قَوْلَكُمْ أَوِ اجْهَرُوا بِهِ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ","prev":{"a":12,"text":"إِنَّ الَّذِينَ يَخْشَوْنَ رَبَّهُمْ بِالْغَيْبِ لَهُمْ مَغْفِرَةٌ وَأَجْرٌ كَبِيرٌ"},"next":{"a":14,"text":"أَلَا يَعْلَمُ مَنْ خَلَقَ وَهُوَ اللَّطِيفُ الْخَبِيرُ"},"reason":"تحدٍّ في صيغة أمر: أسرّوا أو اجهروا — سيّان؛ ثم البرهان العقلي: ﴿أَلَا يَعْلَمُ مَنْ خَلَقَ﴾. فمن صنع الصدر يعلم ما فيه — حجةٌ لا تُردّ.","adds":"أوجز برهانٍ على علم الله ببواطنك: ﴿أَلَا يَعْلَمُ مَنْ خَلَقَ﴾ — أيجهل الصانع صنعته؟"}],"hadiths":[],"situations":[{"situationId":8,"verses":[{"i":4,"strength":"direct","headline":"حجب معلومةٍ أو حقيقةٍ عنك دون أن تفهم السبب","bridge":"حُجبت عنك معلومةٌ أو حقيقة ولا تفهم لماذا؟ ﴿إِذْ يُرِيكَهُمُ اللَّهُ فِي مَنَامِكَ قَلِيلًا وَلَوْ أَرَاكَهُمْ كَثِيرًا لَفَشِلْتُمْ وَلَتَنَازَعْتُمْ فِي الْأَمْرِ... إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ﴾ — قلّل العدو في المنام لأنه يعلم أن رؤية الكثرة تكسر الصدور؛ فقد يحجب عنك معلوماتٍ رحمةً بك، يعلم ما يحتمله صدرك وما يكسره."}],"hadiths":[]},{"situationId":13,"verses":[{"i":2,"strength":"direct","headline":"طلب الطمأنينة في ساعة الخوف والخطر","bridge":"تريد علامةً على طمأنينة قلبك؟ في أُحد فُرزت طائفتان في اللحظة نفسها: ﴿ثُمَّ أَنْزَلَ عَلَيْكُمْ مِنْ بَعْدِ الْغَمِّ أَمَنَةً نُعَاسًا يَغْشَى طَائِفَةً مِنْكُمْ وَطَائِفَةٌ قَدْ أَهَمَّتْهُمْ أَنْفُسُهُمْ﴾ — النعاس في ساعة الخوف علامة طمأنينة القلب؛ فانظر ماذا تفعل بك ساعة الخطر تعرف حال قلبك، واسأل الأمنة ممن أنزلها."}],"hadiths":[]},{"situationId":58,"verses":[{"i":12,"strength":"direct","headline":"الغيبة والكلام المهموس في المجالس","bridge":"تغتاب همسًا وتظن الهمس سترًا؟ ﴿وَأَسِرُّوا قَوْلَكُمْ أَوِ اجْهَرُوا بِهِ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ﴾ — الهمس في الغيبة لا يخفف من وزنها شيئًا؛ فذنوب المجالس المهموسة مسموعة عند من يعلم ما تحت الهمس."}],"hadiths":[]},{"situationId":62,"verses":[{"i":3,"strength":"direct","headline":"عهدٌ أو بيعةٌ قلتها بلسانك وقد يخالفها قلبك","bridge":"قلتَ سمعنا وأطعنا في عهدٍ أو بيعة؟ ﴿وَاذْكُرُوا... مِيثَاقَهُ الَّذِي وَاثَقَكُمْ بِهِ إِذْ قُلْتُمْ سَمِعْنَا وَأَطَعْنَا وَاتَّقُوا اللَّهَ إِنَّ اللَّهَ عَلِيمٌ بِذَاتِ الصُّدُورِ﴾ — الميثاق قولٌ باللسان قد يخالفه القلب، وهو يُقاس بما في الصدر؛ فكل عهدٍ تقوله بلسانك له نسخةٌ في صدرك يقرؤها العليم."}],"hadiths":[]},{"situationId":68,"verses":[{"i":1,"strength":"direct","headline":"بناء ودٍّ من طرفٍ واحد مع من لا يحبك","bridge":"تبني ودًّا من طرفٍ واحد؟ اقرأ أعظم آيةٍ في فقه العلاقات: ﴿هَا أَنْتُمْ أُولَاءِ تُحِبُّونَهُمْ وَلَا يُحِبُّونَكُمْ... وَإِذَا خَلَوْا عَضُّوا عَلَيْكُمُ الْأَنَامِلَ مِنَ الْغَيْظِ... إِنَّ اللَّهَ عَلِيمٌ بِذَاتِ الصُّدُورِ﴾ — يكشف لك ما في صدور من تودّهم وهم يبيّتون الغيظ؛ فاختر صحبتك بميزان من يعلم الصدور."}],"hadiths":[]},{"situationId":73,"verses":[{"i":5,"strength":"direct","headline":"الخلوة بالمعصية ظنًّا أن الستر يحجبك عن الله","bridge":"تظن أن سترًا أو جدارًا يحجبك؟ ﴿أَلَا إِنَّهُمْ يَثْنُونَ صُدُورَهُمْ لِيَسْتَخْفُوا مِنْهُ أَلَا حِينَ يَسْتَغْشُونَ ثِيَابَهُمْ يَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِنُونَ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ﴾ — لا ثوبٌ ولا جدارٌ ولا انحناءةُ صدر تحجب عن عالم البواطن؛ فأصلح ما في الداخل بدل أن تُحكم الستار."},{"i":7,"strength":"direct","headline":"خاطرٌ في الخلوة تظنه غير مرصود","bridge":"أنت وحدك ويمرّ بك خاطرٌ تظنه غير مرصود؟ ﴿إِنَّ اللَّهَ عَالِمُ غَيْبِ السَّمَاوَاتِ وَالْأَرْضِ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ﴾ — صدرك غيبٌ كغيب السماوات، أقرب غيبٍ إليك وأبعده عن غيرك، ومن أحاط بغيب العوالم أحاط بغيب صدرك؛ فلا خاطر يمرّ دون أن يُرصد."}],"hadiths":[]},{"situationId":80,"verses":[{"i":10,"strength":"direct","headline":"تغيّر القلب الخفي والرغبة في إصلاح الباطن","bridge":"تريد أن يصلح ما لا يراه أحد؟ راقب تغيّرات قلبك الخفية: ﴿يُولِجُ اللَّيْلَ فِي النَّهَارِ وَيُولِجُ النَّهَارَ فِي اللَّيْلِ وَهُوَ عَلِيمٌ بِذَاتِ الصُّدُورِ﴾ — كما يتسلل الليل في النهار بلا إحساس تتسلل الخواطر في الصدور بلا إعلان؛ فالتزكية مراقبةُ الإيلاج البطيء قبل أن ينقلب الحال."}],"hadiths":[]},{"situationId":86,"verses":[{"i":11,"strength":"direct","headline":"مراقبة الله فيما يخفيه صدرك ولا تنطقه","bridge":"تظن أن السرّ أخفى ما عندك؟ ثلاث دوائر متدرجة: ﴿يَعْلَمُ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ وَيَعْلَمُ مَا تُسِرُّونَ وَمَا تُعْلِنُونَ وَاللَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ﴾ — ذات الصدور أخفى من السرّ: السرّ ما نطقتَ به همسًا، وذات الصدور ما لم تنطقه أصلًا؛ فخلوتك الحقيقية داخل صدرك."}],"hadiths":[]},{"situationId":131,"verses":[{"i":6,"strength":"direct","headline":"إعراض من تدعوهم حتى أنهكك الحزن","bridge":"تحزن على من أعرض عن دعوتك حتى أنهكك الحزن؟ ﴿وَمَنْ كَفَرَ فَلَا يَحْزُنْكَ كُفْرُهُ إِلَيْنَا مَرْجِعُهُمْ فَنُنَبِّئُهُمْ بِمَا عَمِلُوا إِنَّ اللَّهَ عَلِيمٌ بِذَاتِ الصُّدُورِ﴾ — نهيٌ عن الحزن مع تفويض المرجع؛ فالعليم بذات الصدور يعلم من أصرّ عن علم ومن لم يبلغه الحق، والحكم على البواطن ليس من شأنك: بلّغ ولا تحزن."}],"hadiths":[]},{"situationId":136,"verses":[{"i":9,"strength":"direct","headline":"اتهامك بالكذب والافتراء وأنت بريء","bridge":"اتُّهمت بالافتراء وطال بقاء ما تحمله من حق؟ ﴿أَمْ يَقُولُونَ افْتَرَى عَلَى اللَّهِ كَذِبًا فَإِنْ يَشَإِ اللَّهُ يَخْتِمْ عَلَى قَلْبِكَ وَيَمْحُ اللَّهُ الْبَاطِلَ وَيُحِقُّ الْحَقَّ بِكَلِمَاتِهِ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ﴾ — لو كان افتراءً لختم على قلب صاحبه، لكنه يمحو الباطل ويحق الحق؛ فاستمرار الحق وانمحاء الباطل عبر الزمن برهانٌ عملي على براءة المتهم."}],"hadiths":[]},{"situationId":144,"verses":[{"i":8,"strength":"direct","headline":"الحمد باللسان والقلب ساخط","bridge":"تحمد بلسانك وقلبك ساخط؟ ﴿وَإِنْ تَشْكُرُوا يَرْضَهُ لَكُمْ... إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ﴾ — الرضا متعلق بالباطن: يرضى الشكر الذي يعلم صدق القلب فيه؛ فشكرك يُقاس بقلبك، وكم من حامدٍ بلسانه ساخطٍ بقلبه والعليم بذات الصدور يفرّق، فاجعل شكرك من الصدر."}],"hadiths":[]}]},{"id":190,"name":"الله بصير بالعباد","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: بَصِيرٌ بِالْعِبَادِ — | المواضع: 3 (آل عمران: 15، 20 — غافر: 44)\nخصوصية: تخصيص البصر بـ«العباد» — لا بالأعمال: نظرٌ إلى الأشخاص وأحوالهم لا إلى أفعالهم فقط.\n\nالمعنى:\n- بصير بالعباد: المبصرُ لأحوال عباده وحاجاتهم وضعفهم ومقاصدهم.","teaches":"الحقائق التي كشفتها المواضع:\n1. البصر بالعباد لا بالأعمال فقط: يرى حالك ودافعك.\n2. مهمتك البلاغ والنتائج على البصير.\n3. التفويض ينجّي: ﴿فَوَقَاهُ اللَّهُ سَيِّئَاتِ مَا مَكَرُوا﴾.","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- عند المفاضلة بين زينة عاجلة وثوابٍ آجل.\n- عند إنهاكك من إعراض من تدعوهم.\n- عند مواجهة سلطةٍ باطشة.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. دعاء التفويض: ﴿وَأُفَوِّضُ أَمْرِي إِلَى اللَّهِ إِنَّ اللَّهَ بَصِيرٌ بِالْعِبَادِ﴾ — غافر 44.\n2. سؤال اختيار «الخير من ذلكم» — آل عمران 15.\n3. الاكتفاء بالبلاغ وترك النتائج — آل عمران 20.","summary":"قالها رجلٌ وحيد في وجه فرعون فنجا: ﴿وَأُفَوِّضُ أَمْرِي إِلَى اللَّهِ إِنَّ اللَّهَ بَصِيرٌ بِالْعِبَادِ﴾ — يراك ويرى ما يُدبَّر لك.","verses":[{"i":1,"of":3,"s":3,"surah":"آل عمران","a":15,"text":"قُلْ أَؤُنَبِّئُكُمْ بِخَيْرٍ مِنْ ذَلِكُمْ لِلَّذِينَ اتَّقَوْا عِنْدَ رَبِّهِمْ جَنَّاتٌ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا وَأَزْوَاجٌ مُطَهَّرَةٌ وَرِضْوَانٌ مِنَ اللَّهِ وَاللَّهُ بَصِيرٌ بِالْعِبَادِ","prev":{"a":14,"text":"زُيِّنَ لِلنَّاسِ حُبُّ الشَّهَوَاتِ مِنَ النِّسَاءِ وَالْبَنِينَ وَالْقَنَاطِيرِ الْمُقَنْطَرَةِ مِنَ الذَّهَبِ وَالْفِضَّةِ وَالْخَيْلِ الْمُسَوَّمَةِ وَالْأَنْعَامِ وَالْحَرْثِ ذَلِكَ مَتَاعُ الْحَيَاةِ الدُّنْيَا وَاللَّهُ عِنْدَهُ حُسْنُ الْمَآبِ"},"next":{"a":16,"text":"الَّذِينَ يَقُولُونَ رَبَّنَا إِنَّنَا آمَنَّا فَاغْفِرْ لَنَا ذُنُوبَنَا وَقِنَا عَذَابَ النَّارِ"},"context":"بعد ذكر زينة الشهوات — النساء والبنين والقناطير والخيل والأنعام والحرث — ﴿قُلْ أَؤُنَبِّئُكُمْ بِخَيْرٍ مِنْ ذَلِكُمْ لِلَّذِينَ اتَّقَوْا عِنْدَ رَبِّهِمْ جَنَّاتٌ... وَاللَّهُ بَصِيرٌ بِالْعِبَادِ﴾.","reason":"عرض البديلَ الأفضل بعد تعداد المغريات، وختم بأنه بصيرٌ بالعباد: يرى من انشدّ قلبُه إلى الزينة ومن اختار الآجل — فالبصرُ هنا بصرُ من يعرف قلوب المفاضلين لا أفعالهم فقط.","adds":"﴿زُيِّنَ لِلنَّاسِ حُبُّ الشَّهَوَاتِ﴾ ثم ﴿أَؤُنَبِّئُكُمْ بِخَيْرٍ مِنْ ذَلِكُمْ﴾ — عرضٌ مفتوح: من يختار الأفضل؟"},{"i":2,"of":3,"s":3,"surah":"آل عمران","a":20,"text":"فَإِنْ حَاجُّوكَ فَقُلْ أَسْلَمْتُ وَجْهِيَ لِلَّهِ وَمَنِ اتَّبَعَنِ وَقُلْ لِلَّذِينَ أُوتُوا الْكِتَابَ وَالْأُمِّيِّينَ أَأَسْلَمْتُمْ فَإِنْ أَسْلَمُوا فَقَدِ اهْتَدَوْا وَإِنْ تَوَلَّوْا فَإِنَّمَا عَلَيْكَ الْبَلَاغُ وَاللَّهُ بَصِيرٌ بِالْعِبَادِ","prev":{"a":19,"text":"إِنَّ الدِّينَ عِنْدَ اللَّهِ الْإِسْلَامُ وَمَا اخْتَلَفَ الَّذِينَ أُوتُوا الْكِتَابَ إِلَّا مِنْ بَعْدِ مَا جَاءَهُمُ الْعِلْمُ بَغْيًا بَيْنَهُمْ وَمَنْ يَكْفُرْ بِآيَاتِ اللَّهِ فَإِنَّ اللَّهَ سَرِيعُ الْحِسَابِ"},"next":{"a":21,"text":"إِنَّ الَّذِينَ يَكْفُرُونَ بِآيَاتِ اللَّهِ وَيَقْتُلُونَ النَّبِيِّينَ بِغَيْرِ حَقٍّ وَيَقْتُلُونَ الَّذِينَ يَأْمُرُونَ بِالْقِسْطِ مِنَ النَّاسِ فَبَشِّرْهُمْ بِعَذَابٍ أَلِيمٍ"},"context":"﴿فَإِنْ حَاجُّوكَ فَقُلْ أَسْلَمْتُ وَجْهِيَ لِلَّهِ وَمَنِ اتَّبَعَنِ... فَإِنْ أَسْلَمُوا فَقَدِ اهْتَدَوْا وَإِنْ تَوَلَّوْا فَإِنَّمَا عَلَيْكَ الْبَلَاغُ وَاللَّهُ بَصِيرٌ بِالْعِبَادِ﴾.","reason":"حُدّدت مهمتك: البلاغ فقط — وحُدّد ما ليس عليك: النتائج؛ والبصيرُ بالعباد يتولى ما بعد البلاغ: يرى من قبل ومن أعرض ولماذا. فالبصرُ بالعباد يعفيك من دور المحاسب.","adds":"﴿فَإِنَّمَا عَلَيْكَ الْبَلَاغُ﴾ — أرحمُ جملةٍ لكل داعيةٍ أنهكه إعراض الناس."},{"i":3,"of":3,"s":40,"surah":"غافر","a":44,"text":"فَسَتَذْكُرُونَ مَا أَقُولُ لَكُمْ وَأُفَوِّضُ أَمْرِي إِلَى اللَّهِ إِنَّ اللَّهَ بَصِيرٌ بِالْعِبَادِ","prev":{"a":43,"text":"لَا جَرَمَ أَنَّمَا تَدْعُونَنِي إِلَيْهِ لَيْسَ لَهُ دَعْوَةٌ فِي الدُّنْيَا وَلَا فِي الْآخِرَةِ وَأَنَّ مَرَدَّنَا إِلَى اللَّهِ وَأَنَّ الْمُسْرِفِينَ هُمْ أَصْحَابُ النَّارِ"},"next":{"a":45,"text":"فَوَقَاهُ اللَّهُ سَيِّئَاتِ مَا مَكَرُوا وَحَاقَ بِآلِ فِرْعَوْنَ سُوءُ الْعَذَابِ"},"context":"مؤمن آل فرعون بعد أن أنذر قومه: ﴿فَسَتَذْكُرُونَ مَا أَقُولُ لَكُمْ وَأُفَوِّضُ أَمْرِي إِلَى اللَّهِ إِنَّ اللَّهَ بَصِيرٌ بِالْعِبَادِ﴾.","reason":"تفويضٌ في أخطر موقف: رجلٌ وحيد يواجه فرعون وملأه بعد إعلان إيمانه — فوّض أمره وعلّل بالبصر بالعباد: يراني ويرى ما يُدبَّر لي؛ فكانت النتيجة: ﴿فَوَقَاهُ اللَّهُ سَيِّئَاتِ مَا مَكَرُوا﴾.","adds":"دعاء التفويض الذي نجا به قائله من بطش فرعون: ﴿وَأُفَوِّضُ أَمْرِي إِلَى اللَّهِ إِنَّ اللَّهَ بَصِيرٌ بِالْعِبَادِ﴾."}],"hadiths":[],"situations":[{"situationId":33,"verses":[{"i":3,"strength":"direct","headline":"تهديدٌ ببطش صاحب نفوذ","bridge":"يخوّفونك ببطش صاحب نفوذ؟ رجلٌ واحد أمام فرعون فوّض: ﴿وَأُفَوِّضُ أَمْرِي إِلَى اللَّهِ إِنَّ اللَّهَ بَصِيرٌ بِالْعِبَادِ﴾ — البصير يرى المخوِّف والمخوَّف وما بينهما؛ فقلها حين تُهدَّد، فقد وقى الله قائلها سيئات ما مكروا."}],"hadiths":[]},{"situationId":91,"verses":[{"i":1,"strength":"direct","headline":"انشداد القلب إلى زينة الدنيا عن الآخرة","bridge":"انشدّ قلبك إلى زينة الدنيا؟ بعد تعداد المغريات جاء عرضٌ مفتوح: ﴿قُلْ أَؤُنَبِّئُكُمْ بِخَيْرٍ مِنْ ذَلِكُمْ لِلَّذِينَ اتَّقَوْا عِنْدَ رَبِّهِمْ جَنَّاتٌ... وَرِضْوَانٌ مِنَ اللَّهِ وَاللَّهُ بَصِيرٌ بِالْعِبَادِ﴾ — بصيرٌ بمن انشدّ قلبه إلى الزينة ومن اختار الآجل؛ فالعرض قائم: من يقبل الأفضل؟"}],"hadiths":[]},{"situationId":130,"verses":[{"i":2,"strength":"direct","headline":"إعراض من تدعوهم إلى الحق بعد البلاغ","bridge":"أنهكك إعراض من تدعوهم؟ أرحم جملةٍ لك في القرآن: ﴿فَإِنْ أَسْلَمُوا فَقَدِ اهْتَدَوْا وَإِنْ تَوَلَّوْا فَإِنَّمَا عَلَيْكَ الْبَلَاغُ وَاللَّهُ بَصِيرٌ بِالْعِبَادِ﴾ — حُدّدت مهمتك: البلاغ، وحُدّد ما ليس عليك: النتائج؛ والبصير بالعباد يرى من قبل ومن أعرض ولماذا، فذلك يعفيك من دور المحاسب."}],"hadiths":[]}]},{"id":191,"name":"لطيف لما يشاء","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: لَطِيفٌ لِمَا يَشَاءُ — | المواضع: 1 (يوسف: 100)\nخصوصية: قالها يوسف في ختام القصة كلها — بعد أن اكتملت الصورة ورأى الخيوط مجتمعة.\n\nالمعنى:\n- لطيف لما يشاء: الذي يوصل ما يشاء بألطف الطرق وأخفاها — تدبيرٌ دقيق لا يُدرَك حال جريانه ويُدرك عند اكتماله.","teaches":"الحقائق التي كشفها الموضع:\n1. اللطف يُدرك عند اكتمال الصورة لا أثناءها.\n2. أدب يوسف: ستر إخوته حتى في لحظة انتصاره.\n3. الرؤيا الصادقة قد تتحقق بعد عقود.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- في منتصف ألمٍ لا تفهم معناه.\n- عند اكتمال نعمةٍ بعد طول انتظار.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. سؤال اللطف الخفي: «اللهم الطف بي فيما جرت به المقادير».\n2. دعاء يوسف عند اكتمال النعمة: ﴿تَوَفَّنِي مُسْلِمًا وَأَلْحِقْنِي بِالصَّالِحِينَ﴾ — يوسف 101.\n3. الستر على من أساء إليك عند القدرة.","summary":"بعد الجبّ والرقّ والسجن قال يوسف: ﴿إِنَّ رَبِّي لَطِيفٌ لِمَا يَشَاءُ﴾ — فاللطف يُرى عند اكتمال الصورة، لا في منتصفها.","verses":[{"i":1,"of":1,"s":12,"surah":"يوسف","a":100,"text":"وَرَفَعَ أَبَوَيْهِ عَلَى الْعَرْشِ وَخَرُّوا لَهُ سُجَّدًا وَقَالَ يَا أَبَتِ هَذَا تَأْوِيلُ رُؤْيَايَ مِنْ قَبْلُ قَدْ جَعَلَهَا رَبِّي حَقًّا وَقَدْ أَحْسَنَ بِي إِذْ أَخْرَجَنِي مِنَ السِّجْنِ وَجَاءَ بِكُمْ مِنَ الْبَدْوِ مِنْ بَعْدِ أَنْ نَزَغَ الشَّيْطَانُ بَيْنِي وَبَيْنَ إِخْوَتِي إِنَّ رَبِّي لَطِيفٌ لِمَا يَشَاءُ إِنَّهُ هُوَ الْعَلِيمُ الْحَكِيمُ","prev":{"a":99,"text":"فَلَمَّا دَخَلُوا عَلَى يُوسُفَ آوَى إِلَيْهِ أَبَوَيْهِ وَقَالَ ادْخُلُوا مِصْرَ إِنْ شَاءَ اللَّهُ آمِنِينَ"},"next":{"a":101,"text":"رَبِّ قَدْ آتَيْتَنِي مِنَ الْمُلْكِ وَعَلَّمْتَنِي مِنْ تَأْوِيلِ الْأَحَادِيثِ فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ أَنْتَ وَلِيِّي فِي الدُّنْيَا وَالْآخِرَةِ تَوَفَّنِي مُسْلِمًا وَأَلْحِقْنِي بِالصَّالِحِينَ"},"context":"﴿وَرَفَعَ أَبَوَيْهِ عَلَى الْعَرْشِ وَخَرُّوا لَهُ سُجَّدًا وَقَالَ يَا أَبَتِ هَذَا تَأْوِيلُ رُؤْيَايَ مِنْ قَبْلُ قَدْ جَعَلَهَا رَبِّي حَقًّا... مِنْ بَعْدِ أَنْ نَزَغَ الشَّيْطَانُ بَيْنِي وَبَيْنَ إِخْوَتِي إِنَّ رَبِّي لَطِيفٌ لِمَا يَشَاءُ﴾.","reason":"قراءةٌ نهائية للقصة من أعلاها: جبٌّ ورقٌّ وتهمةٌ وسجنٌ ومجاعة — كلها خيوطٌ في نسيجٍ واحد لم يظهر إلا الآن؛ فسمّاها «لطفًا»: تدبيرٌ خفي كان يعمل طوال السنين وهو لا يراه. ولاحظ أدبه: لم يذكر الجبّ ولا كيد إخوته بل سمّاه «نزغ شيطان».","adds":"كل ألمٍ في قصتك قد يكون خيطًا في نسيجٍ لن تراه إلا في النهاية: ﴿إِنَّ رَبِّي لَطِيفٌ لِمَا يَشَاءُ﴾."}],"hadiths":[],"situations":[{"situationId":9,"verses":[{"i":1,"strength":"direct","headline":"طول الانتظار حتى تظن أن التدبير توقّف","bridge":"طال انتظارك حتى ظننت أن التدبير توقف؟ يوسف انتظر عقودًا واللطيف يعمل في الخفاء: ﴿إِنَّ رَبِّي لَطِيفٌ لِمَا يَشَاءُ﴾ — اللطف تدبيرٌ خفي لا يُرى أثره إلا بعد سنين؛ فطول الأمد ليس توقفًا، بل نسيجٌ يُحاك."}],"hadiths":[]}]},{"id":192,"name":"ذو فضل على العالمين","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: ذُو فَضْلٍ عَلَى الْعَالَمِينَ — مضافة | المواضع: 1 (البقرة: 251)\nخصوصية: جاءت بعد قصة طالوت وجالوت — تعليلًا لسنّة الدفع بين الناس.\n\nالمعنى:\n- ذو فضل على العالمين: صاحبُ الفضل الشامل على الخلق كلهم — مؤمنهم وكافرهم، في نظام الكون وحفظ الأرض من الفساد.","teaches":"الحقائق التي كشفها الموضع:\n1. التدافع سنّةُ حفظٍ للأرض من الفساد.\n2. فضله يعمّ العالمين لا فئةً بعينها.\n3. الملك والحكمة والعلم عطاءٌ لمن قام بالمهمة (داود).","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند التساؤل عن جدوى الصراع بين الحق والباطل.\n- عند رؤية من يقاوم الظلم.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. سؤال أن تكون من أهل الدفع لا من أهل الفساد.\n2. دعاء الفئة القليلة: ﴿رَبَّنَا أَفْرِغْ عَلَيْنَا صَبْرًا وَثَبِّتْ أَقْدَامَنَا﴾ — البقرة 250.\n3. الحمد على سنّة التدافع التي تحفظ الأرض.","summary":"لولا التدافع لفسدت الأرض — فوجودُ من يقاوم الظلم ﴿فَضْلٍ عَلَى الْعَالَمِينَ﴾: نعمةٌ تعمّ البشرية كلها.","verses":[{"i":1,"of":1,"s":2,"surah":"البقرة","a":251,"text":"فَهَزَمُوهُمْ بِإِذْنِ اللَّهِ وَقَتَلَ دَاوُودُ جَالُوتَ وَآتَاهُ اللَّهُ الْمُلْكَ وَالْحِكْمَةَ وَعَلَّمَهُ مِمَّا يَشَاءُ وَلَوْلَا دَفْعُ اللَّهِ النَّاسَ بَعْضَهُمْ بِبَعْضٍ لَفَسَدَتِ الْأَرْضُ وَلَكِنَّ اللَّهَ ذُو فَضْلٍ عَلَى الْعَالَمِينَ","prev":{"a":250,"text":"وَلَمَّا بَرَزُوا لِجَالُوتَ وَجُنُودِهِ قَالُوا رَبَّنَا أَفْرِغْ عَلَيْنَا صَبْرًا وَثَبِّتْ أَقْدَامَنَا وَانْصُرْنَا عَلَى الْقَوْمِ الْكَافِرِينَ"},"next":{"a":252,"text":"تِلْكَ آيَاتُ اللَّهِ نَتْلُوهَا عَلَيْكَ بِالْحَقِّ وَإِنَّكَ لَمِنَ الْمُرْسَلِينَ"},"reason":"سُمّيت سنةُ التدافع «فضلًا على العالمين»: فلولا أن يدفع اللهُ الظالمين بالمصلحين لفسدت الأرض — فالصراعُ بين الحق والباطل ليس شرًّا محضًا بل آليةُ حفظٍ للأرض كلها؛ والفضلُ يعمّ العالمين لا المؤمنين فقط.","adds":"وجودُ من يقاوم الظلم في الأرض فضلٌ على البشرية جمعاء — بمن فيهم من لا يؤمن: ﴿وَلَكِنَّ اللَّهَ ذُو فَضْلٍ عَلَى الْعَالَمِينَ﴾."}],"hadiths":[],"situations":[{"situationId":28,"verses":[{"i":1,"strength":"direct","headline":"ظلمٌ واقعٌ عليك ولا تجد من يدفعه عنك","bridge":"ظُلمتَ ولا تجد من يدفع عنك؟ سنّة الله أن يدفع الناس بعضهم ببعض: ﴿وَلَوْلَا دَفْعُ اللَّهِ النَّاسَ بَعْضَهُمْ بِبَعْضٍ لَفَسَدَتِ الْأَرْضُ﴾ — وقد دفع جالوت بداود الصغير؛ فمن يدفع عنك قد يأتي من حيث لا تتوقع، والدفع فضلٌ من ذي فضلٍ على العالمين."}],"hadiths":[]}]},{"id":193,"name":"عالم الغيب والشهادة","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: عَالِمُ الْغَيْبِ وَالشَّهَادَةِ — مركّبة | المواضع: 10\nخصوصية: يجمع طبقتَي الوجود: ما غاب وما شُهد — فهو الاسم الذي لا يترك للإنسان زاويةً مظلمة يظن أنها خارج العلم.\n\nالمعنى:\n- عالم الغيب والشهادة: الذي استوى في علمه ما غاب عن الخلق وما شاهدوه — فلا فرق عنده بين المستور والمعلن.","teaches":"الحقائق التي كشفتها المواضع:\n1. من عاش بوجهين يُردّ إلى من يعلم الوجهين.\n2. الثناء الدنيوي شهادةٌ ناقصة والحكم لمن يرى الغيب معها.\n3. علمُه مقرونٌ بالرحمة والعزة لا بالتربّص.\n4. الفصل في الخلافات لمن يملك أدوات العلم الكامل.","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- عند اختلاف ظاهرك عن باطنك.\n- عند مدح الناس لك بما ليس فيك.\n- عند خلافٍ لا تحسمه الأدلة.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. «اللَّهُمَّ اجْعَلْنِي خَيْرًا مِمَّا يَظُنُّونَ، وَاغْفِرْ لِي مَا لَا يَعْلَمُونَ» — أثرٌ عن أبي بكر.\n2. تفويض الخلافات لعالم الغيب والشهادة — الزمر 46.\n3. الاستعداد للرد إليه — الجمعة 8.","summary":"لا زاوية مظلمة في حياتك: ما غاب وما شُهد عنده سواء — فمن عاش بوجهين سيُردّ إلى من يعلم الوجهين.","verses":[{"i":1,"of":6,"s":6,"surah":"الأنعام","a":73,"text":"وَهُوَ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ بِالْحَقِّ وَيَوْمَ يَقُولُ كُنْ فَيَكُونُ قَوْلُهُ الْحَقُّ وَلَهُ الْمُلْكُ يَوْمَ يُنْفَخُ فِي الصُّورِ عَالِمُ الْغَيْبِ وَالشَّهَادَةِ وَهُوَ الْحَكِيمُ الْخَبِيرُ","prev":{"a":72,"text":"وَأَنْ أَقِيمُوا الصَّلَاةَ وَاتَّقُوهُ وَهُوَ الَّذِي إِلَيْهِ تُحْشَرُونَ"},"next":{"a":74,"text":"وَإِذْ قَالَ إِبْرَاهِيمُ لِأَبِيهِ آزَرَ أَتَتَّخِذُ أَصْنَامًا آلِهَةً إِنِّي أَرَاكَ وَقَوْمَكَ فِي ضَلَالٍ مُبِينٍ"},"reason":"قُرن علمُ الغيب والشهادة بملك يوم النفخ: فالجمعُ بين علم الموعد وملك اليوم يقطع كل دعوى لمن يزعم علم الساعة أو الشفاعة فيها بغير إذن.","adds":"ملكُ ذلك اليوم وعلمُه بيدٍ واحدة — فلا وسيط يعرف ولا شفيع يملك."},{"i":2,"of":6,"s":9,"surah":"التوبة","a":94,"text":"يَعْتَذِرُونَ إِلَيْكُمْ إِذَا رَجَعْتُمْ إِلَيْهِمْ قُلْ لَا تَعْتَذِرُوا لَنْ نُؤْمِنَ لَكُمْ قَدْ نَبَّأَنَا اللَّهُ مِنْ أَخْبَارِكُمْ وَسَيَرَى اللَّهُ عَمَلَكُمْ وَرَسُولُهُ ثُمَّ تُرَدُّونَ إِلَى عَالِمِ الْغَيْبِ وَالشَّهَادَةِ فَيُنَبِّئُكُمْ بِمَا كُنْتُمْ تَعْمَلُونَ","prev":{"a":93,"text":"إِنَّمَا السَّبِيلُ عَلَى الَّذِينَ يَسْتَأْذِنُونَكَ وَهُمْ أَغْنِيَاءُ رَضُوا بِأَنْ يَكُونُوا مَعَ الْخَوَالِفِ وَطَبَعَ اللَّهُ عَلَى قُلُوبِهِمْ فَهُمْ لَا يَعْلَمُونَ"},"next":{"a":95,"text":"سَيَحْلِفُونَ بِاللَّهِ لَكُمْ إِذَا انْقَلَبْتُمْ إِلَيْهِمْ لِتُعْرِضُوا عَنْهُمْ فَأَعْرِضُوا عَنْهُمْ إِنَّهُمْ رِجْسٌ وَمَأْوَاهُمْ جَهَنَّمُ جَزَاءً بِمَا كَانُوا يَكْسِبُونَ"},"context":"﴿قَدْ نَبَّأَنَا اللَّهُ مِنْ أَخْبَارِكُمْ... ثُمَّ تُرَدُّونَ إِلَى عَالِمِ الْغَيْبِ وَالشَّهَادَةِ﴾.","reason":"جمعُ الغيب والشهادة يناسب المنافقين تحديدًا: لهم شهادةٌ معلنة وغيبٌ مبطَّن — فالاسمُ يخترق الطبقتين معًا؛ ولذلك لم يُقبل اعتذارُهم.","adds":"من عاش بوجهين فسيُردّ إلى من يعلم الوجهين معًا."},{"i":3,"of":6,"s":9,"surah":"التوبة","a":105,"text":"وَقُلِ اعْمَلُوا فَسَيَرَى اللَّهُ عَمَلَكُمْ وَرَسُولُهُ وَالْمُؤْمِنُونَ وَسَتُرَدُّونَ إِلَى عَالِمِ الْغَيْبِ وَالشَّهَادَةِ فَيُنَبِّئُكُمْ بِمَا كُنْتُمْ تَعْمَلُونَ","prev":{"a":104,"text":"أَلَمْ يَعْلَمُوا أَنَّ اللَّهَ هُوَ يَقْبَلُ التَّوْبَةَ عَنْ عِبَادِهِ وَيَأْخُذُ الصَّدَقَاتِ وَأَنَّ اللَّهَ هُوَ التَّوَّابُ الرَّحِيمُ"},"next":{"a":106,"text":"وَآخَرُونَ مُرْجَوْنَ لِأَمْرِ اللَّهِ إِمَّا يُعَذِّبُهُمْ وَإِمَّا يَتُوبُ عَلَيْهِمْ وَاللَّهُ عَلِيمٌ حَكِيمٌ"},"context":"﴿وَقُلِ اعْمَلُوا فَسَيَرَى اللَّهُ عَمَلَكُمْ... وَسَتُرَدُّونَ إِلَى عَالِمِ الْغَيْبِ وَالشَّهَادَةِ﴾.","reason":"عرضُ الأعمال على الله ورسوله والمؤمنين شهادةٌ، والردُّ إلى عالم الغيب والشهادة يكشف الباطن: فالثناءُ الدنيوي شهادةٌ ناقصة، والحكمُ النهائي لمن يعلم الطبقتين.","adds":"لا يغرّك ثناء الناس على عملك: هم يرون الشهادة، والحكم عند من يرى الغيب معها."},{"i":4,"of":6,"s":23,"surah":"المؤمنون","a":92,"text":"عَالِمِ الْغَيْبِ وَالشَّهَادَةِ فَتَعَالَى عَمَّا يُشْرِكُونَ","prev":{"a":91,"text":"مَا اتَّخَذَ اللَّهُ مِنْ وَلَدٍ وَمَا كَانَ مَعَهُ مِنْ إِلَهٍ إِذًا لَذَهَبَ كُلُّ إِلَهٍ بِمَا خَلَقَ وَلَعَلَا بَعْضُهُمْ عَلَى بَعْضٍ سُبْحَانَ اللَّهِ عَمَّا يَصِفُونَ"},"next":{"a":93,"text":"قُلْ رَبِّ إِمَّا تُرِيَنِّي مَا يُوعَدُونَ"},"context":"﴿عَالِمِ الْغَيْبِ وَالشَّهَادَةِ فَتَعَالَى عَمَّا يُشْرِكُونَ﴾ — بعد نفي الولد والشريك: ﴿مَا اتَّخَذَ اللَّهُ مِنْ وَلَدٍ وَمَا كَانَ مَعَهُ مِنْ إِلَهٍ﴾.","reason":"رُتّب التعالي عن الشرك على العلم الشامل: فمن علم الغيب والشهادة يستحيل أن يُشارَك — إذ الشريكُ يجب أن يكون مثله في العلم، ولا مثل له.","adds":"برهانٌ مختصر ضد الشرك: هل يعلم شريكُك المزعوم الغيب والشهادة؟"},{"i":5,"of":6,"s":59,"surah":"الحشر","a":22,"text":"هُوَ اللَّهُ الَّذِي لَا إِلَهَ إِلَّا هُوَ عَالِمُ الْغَيْبِ وَالشَّهَادَةِ هُوَ الرَّحْمَنُ الرَّحِيمُ","prev":{"a":21,"text":"لَوْ أَنْزَلْنَا هَذَا الْقُرْآنَ عَلَى جَبَلٍ لَرَأَيْتَهُ خَاشِعًا مُتَصَدِّعًا مِنْ خَشْيَةِ اللَّهِ وَتِلْكَ الْأَمْثَالُ نَضْرِبُهَا لِلنَّاسِ لَعَلَّهُمْ يَتَفَكَّرُونَ"},"next":{"a":23,"text":"هُوَ اللَّهُ الَّذِي لَا إِلَهَ إِلَّا هُوَ الْمَلِكُ الْقُدُّوسُ السَّلَامُ الْمُؤْمِنُ الْمُهَيْمِنُ الْعَزِيزُ الْجَبَّارُ الْمُتَكَبِّرُ سُبْحَانَ اللَّهِ عَمَّا يُشْرِكُونَ"},"reason":"صُدّر أعظمُ عرضٍ للأسماء بالعلم الشامل ثم الرحمة: فترتيبُ التعرف عليه يبدأ بأنه يعلم كل شيء ثم أنه رحمن رحيم — علمٌ محيطٌ لا يُخيف بل يُطمئن.","adds":"أول ما تتعرّف به عليه في هذا العرض: علمٌ بالغيب والشهادة ثم رحمة — فعلمُه بك يُطمئنك لأنه علمُ الرحمن الرحيم."},{"i":6,"of":6,"s":62,"surah":"الجمعة","a":8,"text":"قُلْ إِنَّ الْمَوْتَ الَّذِي تَفِرُّونَ مِنْهُ فَإِنَّهُ مُلَاقِيكُمْ ثُمَّ تُرَدُّونَ إِلَى عَالِمِ الْغَيْبِ وَالشَّهَادَةِ فَيُنَبِّئُكُمْ بِمَا كُنْتُمْ تَعْمَلُونَ","prev":{"a":7,"text":"وَلَا يَتَمَنَّوْنَهُ أَبَدًا بِمَا قَدَّمَتْ أَيْدِيهِمْ وَاللَّهُ عَلِيمٌ بِالظَّالِمِينَ"},"next":{"a":9,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا نُودِيَ لِلصَّلَاةِ مِنْ يَوْمِ الْجُمُعَةِ فَاسْعَوْا إِلَى ذِكْرِ اللَّهِ وَذَرُوا الْبَيْعَ ذَلِكُمْ خَيْرٌ لَكُمْ إِنْ كُنْتُمْ تَعْلَمُونَ"},"reason":"محطتان لا مفرّ منهما: لقاءُ الموت ثم الردُّ إلى عالم الغيب والشهادة — والفرارُ من الأولى لا ينفع، والاستعدادُ للثانية هو المطلوب.","adds":"رتّب أولوياتك على محطتين حتميتين: موتٌ يلاقيك وردٌّ إلى من يعلم كل شيء."}],"hadiths":[{"i":1,"of":2,"text":"قلتُ لحُذَيْفَةَ بنِ اليَمَانِ : أَصَلَّى رسولُ اللهِ صلَّى اللهُ عليه وسلَّم في بَيْتِ المَقْدِسِ ؟ قال : لا ، قلتُ : بلى ، قال : أنت تقولُ ذاك يا أَصْلَعُ ؟ ! بِمَ تقولُ ذلك ؟ ! قلتُ : بالقرآنِ ، بَيْنِي وبينَك القرآنُ ، فقال حُذَيْفَةُ : مَنِ احْتَجَّ بالقرآنِ ، فقد أَفْلَحَ قال سفيانُ : يقولُ فقد احْتَجَّ ، وربما قال : قد فَلَجَ ، فقال :  سُبْحَانَ الَّذِي أَسْرَى بِعَبْدِهِ لَيْلًا مِنَ الْمَسْجِدِ الْحَرَامِ إِلَى الْمَسْجِدِ الْأَقْصَى .  قال : أَفَتُرَاهُ صَلَّى فيه ؟ قلتُ : لا . قال : لو صَلَّى فيه لَكُتِبَتْ عليكم الصلاةُ فيه ، كما كُتِبَتِ الصلاةُ في المسجدِ الحرامِ . قال حذيفةُ : قد أُتِيَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بدابَّةٍ طويلةِ الظَّهْرِ ممدودةٍ هكذا . خَطْوُهُ مَدُّ بَصَرِهِ ، فما زَايَلَا ظَهْرَ البُرَاقِ ، حتى رَأَيَا الجنةَ والنارَ ، ووَعْدَ الآخرةِ أَجْمَعَ ، ثم رَجَعا عَوْدَهُما على بَدْئِهِما . قال : ويتحدثونَ أنه رَبَطَهُ لِمَا لِيَفِرَّ منه وإنما سَخَّرَهُ له عالِمُ الغيبِ والشهادةِ","narrator":"حذيفة بن اليمان","source":"سنن الترمذي 3147","grade":"صحيح","judgment":"حسن صحيح","url":"https://dorar.net/h/6pNR92L1","nameForm":"عالِمُ الغيبِ والشهادةِ","scene":"زر يسأل حذيفة عن صلاة النبي ﷺ في بيت المقدس ليلة الإسراء، فيحدّث عن البراق: خطوه مد بصره، فما زايلا ظهره حتى رأيا الجنة والنار ثم رجعا — «ويتحدثون أنه ربطه لئلا يفرّ منه، وإنما سخّره له عالم الغيب والشهادة».","reason":"حذيفة ينفي ربط البراق: من سخّره هو عالم الغيب والشهادة — فلا يحتاج مسخَّرُه إلى رباط.","adds":"يُري الاسم في تعليل تسخير البراق."},{"i":2,"of":2,"text":"قالَ أبو بَكْرٍ رضيَ اللَّهُ عنهُ : يا رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ علِّمني شيئًا أقولُهُ إذا أصبحتُ ، وإذا أمسيتُ ، وإذا أخذتُ مَضجَعي . قالَ : قل : اللَّهُمَّ فاطرَ السَّمواتِ والأَرضِ ، عالِمَ الغَيبِ والشَّهادةِ - أو قالَ : اللَّهمَّ عالمَ الغيبِ والشَّهادةِ ، فاطرَ السَّمواتِ والأرضِ - رَبَّ كلِّ شيءٍ ومليكَهُ ، أشهدُ أن لا إلَهَ إلَّا أنتَ ، أعوذُ بِكَ من شرِّ نَفسي ، وشرِّ الشَّيطانِ وشِركِهِ","narrator":"أبو هريرة","source":"تخريج المسند لشاكر 1/43","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/L4uG4ly0","nameForm":"عالمَ الغيبِ والشَّهادةِ","scene":"ذكر أبي بكر: «اللهم فاطر السماوات والأرض، عالم الغيب والشهادة، رب كل شيء ومليكه… أعوذ بك من شر نفسي».","reason":"الاستعاذة من شر النفس تُطلب من عالم الغيب: شر النفس غيبٌ لا يعلمه إلا هو.","adds":"يعطي الاسم في ورد الطرفين."}],"sunnah":{"card":"الصيغة: عَالِمُ الْغَيْبِ وَالشَّهَادَةِ — مركّبة\nفي السنة: شاهدان (3 روايات)\nخصوصية الورود في السنة: في ذكر أبي بكر «اللهم فاطر السماوات والأرض عالم الغيب والشهادة»، وفي حديث حذيفة عن الإسراء: البراق لم يُربط «وإنما سخّره له عالم الغيب والشهادة».","teaches":"1. أن ما يسخّره لا يحتاج رباطًا.\n2. أن شر النفس غيبٌ يُستعاذ منه بعالم الغيب.","whenRecall":"- صباحًا ومساءً.\n- حين تخاف ما لا تراه من نفسك.","whenPray":"عند الشعور بـ:\n1. الخوف من خفايا النفس.\nعند طلب:\n1. الحفظ من شر النفس.\nعند الرغبة في:\n1. ذكر أبي بكر.","duaItems":"«اللهم فاطر السماوات والأرض، عالم الغيب والشهادة، رب كل شيء ومليكه، أشهد أن لا إله إلا أنت، أعوذ بك من شر نفسي وشر الشيطان وشركه» — تخريج المسند 1/43.","summary":"«عالم الغيب والشهادة» في السنة اسم ذكر أبي بكر، وعلّة تسخير البراق بلا رباط."},"situations":[{"situationId":73,"verses":[{"i":5,"strength":"direct","headline":"الخلوة واستشعار علم الله المحيط بك","bridge":"أنت وحدك؟ أول ما تعرفه عنه في أعظم عرضٍ للأسماء: ﴿عَالِمُ الْغَيْبِ وَالشَّهَادَةِ هُوَ الرَّحْمَنُ الرَّحِيمُ﴾ — يعلم كل شيء عنك في خلوتك وهو الرحمن الرحيم؛ علمٌ محيط يُطمئن ولا يُخيف من أصلح خلوته."}],"hadiths":[]},{"situationId":80,"verses":[],"hadiths":[{"i":2,"strength":"direct","headline":"الخوف من شر النفس الخفي وطلب الحماية منه","bridge":"وردك؟ «اللهم فاطر السماوات والأرض، عالم الغيب والشهادة… أعوذ بك من شر نفسي» — شر نفسك غيبٌ يعلمه وحده."}]},{"situationId":81,"verses":[{"i":3,"strength":"direct","headline":"الاغترار بثناء الناس على عملك","bridge":"يغرّك ثناء الناس على عملك؟ عملك معروضٌ على دائرتين: ﴿فَسَيَرَى اللَّهُ عَمَلَكُمْ وَرَسُولُهُ وَالْمُؤْمِنُونَ وَسَتُرَدُّونَ إِلَى عَالِمِ الْغَيْبِ وَالشَّهَادَةِ﴾ — الناس يرون الشهادة، والحكم النهائي عند من يرى الغيب معها؛ فالثناء الدنيوي شهادةٌ ناقصة، ولا تعمل لأجله."}],"hadiths":[]},{"situationId":85,"verses":[{"i":2,"strength":"direct","headline":"العيش بوجهين: وجهٍ للناس ووجهٍ في الخلوة","bridge":"تعيش بوجهين: وجهٍ للناس ووجهٍ في الخلوة؟ الاسم يناسب المنافقين تحديدًا: شهادةٌ معلنة وغيبٌ مبطَّن، وقيل لهم: ﴿ثُمَّ تُرَدُّونَ إِلَى عَالِمِ الْغَيْبِ وَالشَّهَادَةِ﴾ — يخترق الطبقتين معًا؛ فمن عاش بوجهين سيُردّ إلى من يعلم الوجهين."}],"hadiths":[]},{"situationId":96,"verses":[{"i":1,"strength":"direct","headline":"التعلق بوسيطٍ يُظن أنه يعلم الساعة أو يشفع","bridge":"تتعلق بوسيطٍ يعرف الساعة أو يشفع فيها بلا إذن؟ ﴿وَلَهُ الْمُلْكُ يَوْمَ يُنْفَخُ فِي الصُّورِ عَالِمُ الْغَيْبِ وَالشَّهَادَةِ وَهُوَ الْحَكِيمُ الْخَبِيرُ﴾ — قُرن علم الغيب بملك يوم النفخ؛ فملك ذلك اليوم وعلمه بيدٍ واحدة، فلا وسيط يعرف ولا شفيع يملك."}],"hadiths":[]},{"situationId":102,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"الاطمئنان إلى تسخير الله دون تعلّقٍ بالأسباب","bridge":"تشدّ الوثاق خوفًا أن يفلت منك ما سخّره الله لك؟ قال حذيفة في البراق: «وإنما سخره له عالم الغيب والشهادة» — ما سخّره العالمُ بالغيب لا يحتاج إلى رباطك."}]},{"situationId":106,"verses":[{"i":4,"strength":"direct","headline":"طلب برهانٍ مختصر على بطلان الشرك","bridge":"تريد برهانًا مختصرًا ضد الشرك؟ ﴿عَالِمِ الْغَيْبِ وَالشَّهَادَةِ فَتَعَالَى عَمَّا يُشْرِكُونَ﴾ — رُتّب التعالي عن الشرك على العلم الشامل: الشريك يجب أن يكون مثله في العلم ولا مثل له؛ فاسأل: هل يعلم شريكك المزعوم الغيب والشهادة؟"}],"hadiths":[]},{"situationId":182,"verses":[{"i":6,"strength":"direct","headline":"الفرار من ذكر الموت والغفلة عن الاستعداد له","bridge":"ترتّب أولوياتك على أوهامٍ لا على الحتميات؟ محطتان لا مفر منهما: ﴿قُلْ إِنَّ الْمَوْتَ الَّذِي تَفِرُّونَ مِنْهُ فَإِنَّهُ مُلَاقِيكُمْ ثُمَّ تُرَدُّونَ إِلَى عَالِمِ الْغَيْبِ وَالشَّهَادَةِ فَيُنَبِّئُكُمْ بِمَا كُنْتُمْ تَعْمَلُونَ﴾ — الفرار من الأولى لا ينفع والاستعداد للثانية هو المطلوب؛ فرتّب أولوياتك على موتٍ يلاقيك وردٍّ إلى من يعلم كل شيء."}],"hadiths":[]}]},{"id":194,"name":"شكور حليم عالم الغيب والشهادة العزيز الحكيم","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: شَكُورٌ حَلِيمٌ * عَالِمُ الْغَيْبِ وَالشَّهَادَةِ الْعَزِيزُ الْحَكِيمُ — مركّبة ممتدّة على آيتين متصلتين | المواضع: 1 (التغابن: 17–18)\nخصوصية: جاءت في ختام آية «القرض الحسن» وخاتمةِ سورة التغابن — سورةِ الابتلاء بالأزواج والأولاد والأموال: الغنيُّ يستقرض من عبده، ثم يعرّفه بمن أقرضه.\n\nالمعنى:\n- الشكور: يقبل القليل ويضاعفه ويثني على صاحبه.\n- الحليم: لا يعاجل المقصّر في الإنفاق بالعقوبة.\n- عالم الغيب والشهادة: المحيط بما غاب من نيتك وما ظهر من عملك.\n- العزيز الحكيم: الغالب الذي ينفّذ وعده، ويضع كل عطاءٍ وابتلاءٍ موضعه.\nسر الاقتران: شكرٌ لمن أعطى، وحلمٌ على من بخل، وعلمٌ بالنية، وعزةٌ تنفّذ المضاعفة، وحكمةٌ تزن — فالعطاء معه لا يضيع.","teaches":"الحقائق التي كشفها الموضع:\n1. عطاؤك «قرض» عند الغني — تلطفًا بك وضمانًا للرد مضاعفًا مع المغفرة.\n2. شكره يقبل القليل ويضاعفه، وحلمه يمهل الباخل ليصلح ولا يقطع عنه الفرصة.\n3. نيتك في الإنفاق معلومةٌ له غيبًا وشهادة، فلا يضيع ما أخفيت.\n4. وعد المضاعفة مضمونٌ بعزةٍ تنفّذه وحكمةٍ تزن العطايا والفتن.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند التردد في صدقة: أنت تُقرض من يشكر، لا تخسر.\n- عند شعورك بشحّ نفسك أو تقصيرك في البذل: الحليم لم يغلق الباب.\n- عند الإنفاق سرًّا لا يراه أحد: عالم الغيب يراه.\n- عند ابتلائك بأهلك ومالك: من يحاسبك عزيزٌ حكيم.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. سؤال الوقاية من الشح: ﴿وَمَنْ يُوقَ شُحَّ نَفْسِهِ فَأُولَئِكَ هُمُ الْمُفْلِحُونَ﴾ — التغابن 16.\n2. الإقراض الحسن رجاء المضاعفة والمغفرة: ﴿إِنْ تُقْرِضُوا اللَّهَ قَرْضًا حَسَنًا يُضَاعِفْهُ لَكُمْ وَيَغْفِرْ لَكُمْ﴾ — التغابن 17.\n3. تقوى المستطاع: ﴿فَاتَّقُوا اللَّهَ مَا اسْتَطَعْتُمْ﴾ — التغابن 16.\n4. سؤال قبول ما أنفقتَ سرًّا وعلانيةً، وألا تكون من المغبونين يوم التغابن.","summary":"الغنيُّ يسمّي عطاءك «قرضًا» ويردّه مضاعفًا مع مغفرة، ويعلم ما أخفيت منه، وينفّذ وعده بعزةٍ وحكمة — ﴿وَاللَّهُ شَكُورٌ حَلِيمٌ * عَالِمُ الْغَيْبِ وَالشَّهَادَةِ الْعَزِيزُ الْحَكِيمُ﴾: فأقرض من ماله تربح.","verses":[{"i":1,"of":1,"s":64,"surah":"التغابن","a":17,"last":18,"text":"إِنْ تُقْرِضُوا اللَّهَ قَرْضًا حَسَنًا يُضَاعِفْهُ لَكُمْ وَيَغْفِرْ لَكُمْ وَاللَّهُ شَكُورٌ حَلِيمٌ عَالِمُ الْغَيْبِ وَالشَّهَادَةِ الْعَزِيزُ الْحَكِيمُ","prev":{"a":16,"text":"فَاتَّقُوا اللَّهَ مَا اسْتَطَعْتُمْ وَاسْمَعُوا وَأَطِيعُوا وَأَنْفِقُوا خَيْرًا لِأَنْفُسِكُمْ وَمَنْ يُوقَ شُحَّ نَفْسِهِ فَأُولَئِكَ هُمُ الْمُفْلِحُونَ"},"context":"بعد التحذير من فتنة الأموال والأولاد، والأمر بالإنفاق والوقاية من الشح، يسمّي الله الإنفاق قرضًا له: ﴿إِنْ تُقْرِضُوا اللَّهَ قَرْضًا حَسَنًا يُضَاعِفْهُ لَكُمْ وَيَغْفِرْ لَكُمْ وَاللَّهُ شَكُورٌ حَلِيمٌ * عَالِمُ الْغَيْبِ وَالشَّهَادَةِ الْعَزِيزُ الْحَكِيمُ﴾ — خاتمة سورة التغابن.","reason":"خُتم وعد القرض بالاسم كاملًا: شكورٌ يقبل القليل ويضاعفه، حليمٌ لا يعاجل من بخل، ثم عالمٌ بنية المنفق غيبًا وشهادة، عزيزٌ ينفّذ وعد المضاعفة، حكيمٌ يوزّع العطاء والابتلاء بميزان — فمنظومة العطاء والجزاء كلها مضمونةٌ لمن أقرض.","adds":"عطاؤك لا يضيع: يقبله الشكور وإن قلّ، ويمهلك الحليم إن قصّرت، ويعلم عالمُ الغيب ما أخفيت، وينفّذ العزيزُ الحكيم وعده."}],"hadiths":[],"situations":[{"situationId":43,"verses":[{"i":1,"strength":"direct","headline":"التردد في الإنفاق والخوف ألا يُقبل ما بذلت","bridge":"تتردد في الإنفاق وتخاف ألا يُقبل ما بذلت؟ ﴿إِنْ تُقْرِضُوا اللَّهَ قَرْضًا حَسَنًا يُضَاعِفْهُ لَكُمْ وَيَغْفِرْ لَكُمْ﴾ — ومن تُقرضه ﴿شَكُورٌ حَلِيمٌ﴾ يضاعف القليل ويمهل المقصّر، و﴿عَالِمُ الْغَيْبِ وَالشَّهَادَةِ﴾ يعلم ما أخفيت؛ فأنفق مطمئنًّا."}],"hadiths":[]}]},{"id":195,"name":"عالم غيب السماوات والأرض","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: عَالِمُ غَيْبِ السَّمَاوَاتِ وَالْأَرْضِ — مضافة | المواضع: 1 (فاطر: 38)\nخصوصية: قُرن فيها غيبُ العوالم بغيب الصدور في آيةٍ واحدة.\n\nالمعنى:\n- عالم غيب السماوات والأرض: المحيط بما غاب في العالمين العلوي والسفلي — وما في الصدور جزءٌ من هذا الغيب.","teaches":"الحقائق التي كشفها الموضع:\n1. غيب الصدور من جنس غيب السماوات والأرض.\n2. صدق الوعود المستقبلية معلومٌ قبل وقوعها.\n3. طلب الرجعة يومئذ لا يُجاب لعلمه بالحقيقة.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند وعدك لنفسك بالتوبة «لاحقًا».\n- عند التسويف بالعمل الصالح.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. صدق العزم لا مجرد النية: «اللهم إني أسألك العزيمة على الرشد» — رواه النسائي.\n2. الاستعاذة من التسويف والوعود الفارغة.\n3. المبادرة بالعمل قبل أن يُطلب الرجوع ولا يُجاب.","summary":"﴿إِنَّ اللَّهَ عَالِمُ غَيْبِ السَّمَاوَاتِ وَالْأَرْضِ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ﴾ — يعلم إن كان وعدُك لنفسك صادقًا: فابدأ الآن.","verses":[{"i":1,"of":1,"s":35,"surah":"فاطر","a":38,"text":"إِنَّ اللَّهَ عَالِمُ غَيْبِ السَّمَاوَاتِ وَالْأَرْضِ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ","prev":{"a":37,"text":"وَهُمْ يَصْطَرِخُونَ فِيهَا رَبَّنَا أَخْرِجْنَا نَعْمَلْ صَالِحًا غَيْرَ الَّذِي كُنَّا نَعْمَلُ أَوَلَمْ نُعَمِّرْكُمْ مَا يَتَذَكَّرُ فِيهِ مَنْ تَذَكَّرَ وَجَاءَكُمُ النَّذِيرُ فَذُوقُوا فَمَا لِلظَّالِمِينَ مِنْ نَصِيرٍ"},"next":{"a":39,"text":"هُوَ الَّذِي جَعَلَكُمْ خَلَائِفَ فِي الْأَرْضِ فَمَنْ كَفَرَ فَعَلَيْهِ كُفْرُهُ وَلَا يَزِيدُ الْكَافِرِينَ كُفْرُهُمْ عِنْدَ رَبِّهِمْ إِلَّا مَقْتًا وَلَا يَزِيدُ الْكَافِرِينَ كُفْرُهُمْ إِلَّا خَسَارًا"},"context":"﴿إِنَّ اللَّهَ عَالِمُ غَيْبِ السَّمَاوَاتِ وَالْأَرْضِ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ﴾ — بعد ذكر استغاثة أهل النار وطلبهم الرجوع.","reason":"جاءت بعد قولهم ﴿رَبَّنَا أَخْرِجْنَا نَعْمَلْ صَالِحًا﴾ — ووعدُهم بالعمل الصالح دعوى: فعالمُ غيب السماوات والأرض عليمٌ بذات صدورهم، يعلم صدقَ وعدهم من كذبه. فالوعودُ المستقبلية معلومةُ الصدق سلفًا.","adds":"وعودُك لنفسك بالتغيير معلومةٌ عنده صادقةً كانت أو دعوى — فاجعلها صادقةً بالعمل الآن."}],"hadiths":[],"situations":[{"situationId":20,"verses":[{"i":1,"strength":"direct","headline":"التسويف بالتوبة ووعد النفس بالتغيير لاحقًا","bridge":"تعدُ نفسك بالتغيير لاحقًا؟ أهل النار وعدوا: ﴿رَبَّنَا أَخْرِجْنَا نَعْمَلْ صَالِحًا﴾ فجاء: ﴿إِنَّ اللَّهَ عَالِمُ غَيْبِ السَّمَاوَاتِ وَالْأَرْضِ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ﴾ — يعلم ما في صدورهم من صدق الوعد أو كذبه؛ فوعودك لنفسك معلومةٌ عنده صادقةً كانت أو دعوى، فاجعلها صادقةً بالعمل الآن."}],"hadiths":[]}]},{"id":196,"name":"فاطر السماوات والأرض عالم الغيب والشهادة","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ عَالِمَ الْغَيْبِ وَالشَّهَادَةِ — مركّبة | المواضع: 1 (الزمر: 46)\nخصوصية: آخرُ الأسماء في هذا المصنف — وهي نداءٌ في دعاءٍ مأمورٍ به، وهو نصُّ استفتاح النبي ﷺ لقيام الليل.\n\nالمعنى: مبتدئُ العوالم على غير مثال، والمحيطُ بغيبها وشهادتها — فمن أنشأ وعلم فهو أهلٌ للحكم بين المختلفين.","teaches":"الحقائق التي كشفها الموضع:\n1. حين يستعصي الحوار يُرفع الأمر بالدعاء لا بالمكابرة.\n2. الفصل في الخلاف يحتاج فاطرًا عالمًا بالغيب والشهادة.\n3. الهداية لما اختُلف فيه من الحق تُطلب ولا تُدّعى.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند استفتاح قيام الليل.\n- عند حيرتك في مسألةٍ اختلف فيها العلماء.\n- عند فشل الحوار مع مخالف.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. دعاء الاستفتاح النبوي كاملًا — رواه مسلم.\n2. سؤال الهداية لما اختُلف فيه من الحق بإذنه.\n3. رفع الخلافات إلى الحاكم الحق بدل إطالة الجدل.","summary":"حين يستعصي الحق على الحوار، ارفع الأمر إلى من فطر وعلم: ﴿أَنْتَ تَحْكُمُ بَيْنَ عِبَادِكَ فِي مَا كَانُوا فِيهِ يَخْتَلِفُونَ﴾ — «اهدني لما اختُلف فيه من الحق بإذنك».","verses":[{"i":1,"of":1,"s":39,"surah":"الزمر","a":46,"text":"قُلِ اللَّهُمَّ فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ عَالِمَ الْغَيْبِ وَالشَّهَادَةِ أَنْتَ تَحْكُمُ بَيْنَ عِبَادِكَ فِي مَا كَانُوا فِيهِ يَخْتَلِفُونَ","prev":{"a":45,"text":"وَإِذَا ذُكِرَ اللَّهُ وَحْدَهُ اشْمَأَزَّتْ قُلُوبُ الَّذِينَ لَا يُؤْمِنُونَ بِالْآخِرَةِ وَإِذَا ذُكِرَ الَّذِينَ مِنْ دُونِهِ إِذَا هُمْ يَسْتَبْشِرُونَ"},"next":{"a":47,"text":"وَلَوْ أَنَّ لِلَّذِينَ ظَلَمُوا مَا فِي الْأَرْضِ جَمِيعًا وَمِثْلَهُ مَعَهُ لَافْتَدَوْا بِهِ مِنْ سُوءِ الْعَذَابِ يَوْمَ الْقِيَامَةِ وَبَدَا لَهُمْ مِنَ اللَّهِ مَا لَمْ يَكُونُوا يَحْتَسِبُونَ"},"reason":"أُمر النبي ﷺ أن يدعو بهذا النداء بعد أن اشمأزت قلوبُ المشركين من ذكر الله وحده — فلمّا استعصى الحوار، أُمر بالدعاء: نداءٌ بالفطر والعلم ثم تفويضُ الحكم؛ فالخلافُ الذي لا يُحسم بالحجة يُرفع إلى من فطر وعلم.","adds":"إذا استعصى عليك الخلاف فلا تزد جدالًا، بل ارفعه بالدعاء: ﴿أَنْتَ تَحْكُمُ بَيْنَ عِبَادِكَ فِي مَا كَانُوا فِيهِ يَخْتَلِفُونَ﴾."}],"hadiths":[{"i":1,"of":4,"text":"«أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ عَلَّمَه وأَمَرَه أنْ يَتعاهدَ أهلَه في كُلِّ صباحٍ: لبَّيكَ اللَّهُمَّ لبَّيكَ، لبَّيكَ وسَعديْكَ، والخيرُ في يَديْكَ ومنكَ وإليكَ، اللَّهُمَّ ما قُلتُ مِن قَولٍ، أوْ حَلَفتُ مِن حَلِفٍ، أوْ نَذرْتُ مِن نَذْرٍ فمَشيئتُكَ بيْنَ يديْ ذلك كُلِّهِ، ما شئتَ كان، وما لمْ تَشأْ لا يكُنْ، ولا حَولَ ولا قُوَّةَ إلَّا بكَ، إنَّكَ على كُلِّ شيءٍ قديرٌ، اللَّهُمَّ ما صلَّيتُ مِن صلاةٍ فعلى مَنْ صلَّيتَ، وما لَعنتُ مِن لَعنٍ فعلى مَنْ لَعنتَ، أنتَ وَليِّي في الدُّنيا والآخِرةِ، تَوفَّني مسلمًا، وأَلحِقني بالصَّالحينَ، اللَّهُمَّ إنِّي أَسألُكَ الرِّضا بعدَ القضاءِ، وبَرْدَ العَيشِ بعدَ الموتِ، ولَذَّةَ النَّظرِ إلى وَجهِكَ، وشوقًا إلى لقائكَ في غيرِ ضرَّاءَ مُضِرَّةٍ ولا فِتنةٍ مُضلَّةٍ، وأَعوذُ بكَ أنْ أَظلِمَ أوْ أُظلَمَ، أوْ أَعتدِيَ أوْ يُعتدَى عَلَيَّ، أوْ أَكسِبَ خطيئةً أوْ ذنبًا لا تَغفِرُه، اللَّهُمَّ فاطِرَ السَّمواتِ والأرضِ، عالِمَ الغيبِ والشَّهادةِ ذا الجلالِ والإكرامِ، فإنِّي أَعهدُ إليكَ في هذه الحياةِ الدُّنيا، وأُشهِدُكَ، وكفى بكَ شَهيدًا أنِّي أَشهدُ أنْ لا إلَهَ إلَّا أنتَ، وحْدَكَ لا شريكَ لكَ، لكَ المُلكُ، ولكَ الحمدُ، وأنتَ على كُلِّ شيءٍ قديرٌ، وأَشهدُ أنَّ مُحمَّدًا عَبدُكَ ورسولُكَ، وأَشهدُ أنَّ وَعدَكَ حقٌّ ولقاءَكَ حقٌّ، والسَّاعةَ آتيةٌ لا رَيبَ فيها، وأنَّكَ تَبعثُ مَن في القُبورِ، وأنَّكَ إنْ تَكِلْني إلى نفسي؛ تَكِلْني إلى ضَعفٍ وعَورةٍ وذَنبٍ وخطيئةٍ، وإنِّي لا أَثِقُ إلَّا برحمتِكَ، فاغفرْ لي ذنوبي كُلَّها؛ إنَّه لا يَغفِرُ الذُّنوبَ إلَّا أنتَ، وتُبْ عَلَيَّ؛ إنَّكَ أنتَ التَّوابُ الرَّحيمُ.»","narrator":"زيد بن ثابت","source":"المستدرك على الصحيحين (1924)","grade":"صحيح","judgment":"صحيح الإسناد","url":"https://dorar.net/h/nn7o6HNi","nameForm":"فاطِرَ السَّمواتِ والأرضِ، عالِمَ الغيبِ والشَّهادةِ","scene":"علّم النبي ﷺ زيد بن ثابت وأمره أن يتعاهد أهله كل صباح: «لبيك اللهم لبيك، لبيك وسعديك، والخير في يديك ومنك وإليك، اللهم ما قلت من قول أو حلفت من حلف أو نذرت من نذر فمشيئتك بين يدي ذلك كله، ما شئت كان وما لم تشأ لا يكن…»، وفيه: «اللهم فاطر السماوات والأرض عالم الغيب والشهادة ذا الجلال والإكرام، فإني أعهد إليك في هذه الحياة الدنيا».","reason":"في أثناء ذكر الصباح يأتي مقطع العهد، ويُفتتح بنداء «فاطر السماوات والأرض عالم الغيب والشهادة» قبل «فإني أعهد إليك»: من فطر الكون ويعلم غيب العبد يُعهد إليه ويُشهَد، والعهد يُتعاهد كل صباح في الأهل؛ فالاسم افتتاح عهدٍ يومي بين العبد وربه.","adds":"الاسم يفتتح مقطع العهد في ذكر الصباح: «فإني أعهد إليك في هذه الحياة الدنيا»."},{"i":2,"of":4,"text":"عنْ عبدِ اللهِ بنِ مسعودٍ رَضيَ اللهُ عنه، أنَّه قَرَأَ: {إِلَّا مَنِ اتَّخَذَ عِنْدَ الرَّحْمَنِ عَهْدًا} [مريم: 87] فقالَ: اتَّخذوا عندَ الرَّحمنِ عهدًا، فإنَّ اللهَ يقولُ يومَ القيامةِ: مَنْ كان له عندي عهدٌ فليَقُمْ. قالَ: فقُلنا: فعلِّمْنا يا أبا عبدِ الرَّحمنِ، قالَ: قولوا: {قُلِ اللَّهُمَّ فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ عَالِمَ الْغَيْبِ وَالشَّهَادَةِ} [الزمر: 46] إنِّي أعهدُ إليكَ في هذه الحياةِ الدُّنيا بأنِّي أَشهدُ أنْ لا إلهَ إلَّا أنتَ وحدَكَ لا شريكَ لكَ، وأنَّ مُحمَّدًا عبدُكَ ورسولُكَ، فإنَّكَ إنْ تَكِلني إلى عمَلٍ يُقرِّبني مِنَ الشَّرِّ، ويُباعدُني مِنَ الخيرِ، وإنِّي لا أثِقُ إلَّا برحمتِكَ فاجعلْهُ لي عندكَ عهدًا تُوفِّيهِ إليَّ يومَ القيامةِ، إنَّكَ لا تُخلِفُ الميعادَ.","narrator":"الأسود بن يزيد","source":"المستدرك على الصحيحين 3470","grade":"صحيح","judgment":"صحيح الإسناد","url":"https://dorar.net/h/JPqjOyp0","nameForm":"فاطِرَ السَّمواتِ والأرضِ، عالِمَ الغيبِ والشَّهادةِ","scene":"قرأ ابن مسعود ﴿إِلَّا مَنِ اتَّخَذَ عِنْدَ الرَّحْمَنِ عَهْدًا﴾ فقال: اتخذوا عند الرحمن عهدًا، فإن الله يقول يوم القيامة: من كان له عندي عهد فليقم، فقالوا: علمنا، قال: قولوا: ﴿قُلِ اللَّهُمَّ فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ عَالِمَ الْغَيْبِ وَالشَّهَادَةِ﴾ إني أعهد إليك في هذه الحياة الدنيا بأني أشهد أن لا إله إلا أنت وحدك لا شريك لك وأن محمدًا عبدك ورسولك، فإنك إن تكلني إلى عمل يقربني من الشر ويباعدني من الخير، وإني لا أثق إلا برحمتك، فاجعله لي عندك عهدًا توفيه إليّ يوم القيامة، إنك لا تخلف الميعاد.","reason":"العهد الذي يُنادى به يوم القيامة يُعقد بنداء فاطر السماوات والأرض عالم الغيب والشهادة؛ فابن مسعود يعلّم أن يُستفتح العهد بالآية، والاسم مفتاح عهد يُوفّى يوم القيامة.","adds":"عهد يُوفّى يوم القيامة يُعقد باسم فاطر السماوات والأرض عالم الغيب والشهادة."},{"i":3,"of":4,"text":"عن أبي راشد الحبراني قال: أتَيْتُ عبدَ اللهِ بنَ عَمرِو بنِ العاصِ، فقُلْتُ له: حدِّثْنا ما سمِعْتَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فأَلقى بين يدَيَّ صَحيفةً، فقال: هذا ما كتَبَ لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فنظَرْتُ فيها، فإذا فيها: أنَّ أبا بَكرٍ الصِّدِّيقَ قال: يا رسولَ اللهِ، علِّمْني ما أقولُ إذا أصبَحْتُ وإذا أمسَيْتُ؟ فقال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا أبا بَكرٍ، قُلْ: اللَّهُمَّ فاطرَ السَّمواتِ والأرضِ، عالمَ الغَيبِ والشَّهادةِ، لا إلهَ إلَّا أنتَ، ربَّ كلِّ شيءٍ ومَليكَه، أعوذُ بكَ مِن شرِّ نفْسي، ومِن شرِّ الشَّيطانِ وشِركِه، وأنْ أقترِفَ على نفْسي سوءًا، أو أجُرَّه إلى مُسلمِ .","narrator":"عبدالله بن عمرو","source":"تخريج المسند لشعيب 6851","grade":"صحيح","judgment":"صحيح لغيره","url":"https://dorar.net/h/yOxhA5H0","nameForm":"فاطرَ السَّمواتِ والأرضِ، عالمَ الغَيبِ والشَّهادةِ","scene":"سأل أبو بكر النبيَّ ﷺ: علّمني ما أقول إذا أصبحت وإذا أمسيت، فقال: «قل: اللهم فاطر السماوات والأرض، عالم الغيب والشهادة، لا إله إلا أنت، رب كل شيء ومليكه، أعوذ بك من شر نفسي ومن شر الشيطان وشركه وأن أقترف على نفسي سوءًا أو أجره إلى مسلم».","reason":"الفطر والعلم يجتمعان في الاستعاذة: من فطر النفس وعلم غيبها يُعيذ منها.","adds":"يعطي الاسمين في ذكرٍ علّمه النبي ﷺ أبا بكر يقوله إذا أصبح وإذا أمسى."},{"i":4,"of":4,"text":"[عَن أبي] سَلَمةَ بنِ عبدِ الرَّحمنِ بنِ عَوفٍ قالَ: سألتُ عائشةَ أمَّ المؤمنينَ: بأيِّ شيءٍ كانَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يفتتحُ صلاتَهُ إذا قامَ منَ اللَّيلِ قالت: كانَ إذا قامَ منَ اللَّيلِ افتتحَ صلاتَهُ قالَ: اللَّهمَّ ربَّ جَبرائيلَ وميكائيلَ وإسرافيلَ، فاطرَ السَّمواتِ والأرضِ، عالمَ الغيبِ والشَّهادةِ، أنتَ تحكمُ بينَ عبادِكَ فيما كانوا فيهِ يختلفونَ، اهدِني لما اختُلِفَ فيهِ منَ الحقِّ، فإنَّكَ تَهْدي من تشاءُ إلى صراطٍ مستقيمٍ","narrator":"عائشة","source":"صحيح ابن خزيمة 2/ 325","grade":"صحيح","judgment":"أخرجه في صحيحه","url":"https://dorar.net/h/se8tFaKV","nameForm":"فاطرَ السَّمواتِ والأرضِ، عالمَ الغيبِ والشَّهادةِ","scene":"عائشة: كان النبي ﷺ إذا قام من الليل افتتح صلاته: «اللهم رب جبرائيل وميكائيل وإسرافيل، فاطر السماوات والأرض، عالم الغيب والشهادة، أنت تحكم بين عبادك فيما كانوا فيه يختلفون، اهدني لما اختُلف فيه من الحق، فإنك تهدي من تشاء إلى صراط مستقيم».","reason":"الهداية فيما اختُلف فيه تُطلب من عالم الغيب: الاختلاف ظاهر والحق فيه غيب — فيُسأل من يعلم الغيب والشهادة أن يهدي إليه.","adds":"يعطي الاسمين استفتاح صلاة الليل."}],"sunnah":{"card":"الصيغة: فَاطِرُ السَّمَاوَاتِ وَالْأَرْضِ عَالِمُ الْغَيْبِ وَالشَّهَادَةِ — مركّبة\nفي السنة: 3 شواهد (8 روايات)\nخصوصية الورود في السنة: مفتتح ثلاثة أدعية: عهد زيد بن ثابت الصباحي «فإني أعهد إليك في هذه الحياة الدنيا»، وذكر أبي بكر صباحًا ومساءً، واستفتاح صلاة الليل «اللهم رب جبرائيل وميكائيل وإسرافيل، فاطر السماوات والأرض، عالم الغيب والشهادة، أنت تحكم بين عبادك فيما كانوا فيه يختلفون، اهدني لما اختُلف فيه من الحق بإذنك» (مسلم).","teaches":"1. أن العهد يُعقد عنده لأنه يعلم الغيب.\n2. أن الهداية فيما اختُلف فيه تُطلب منه.\n3. أن شر النفس يُستعاذ منه به.","whenRecall":"- كل صباح: عهد زيد.\n- صباحًا ومساءً: ذكر أبي بكر.\n- استفتاح صلاة الليل.\n- عند الحيرة في اختلاف.","whenPray":"عند الشعور بـ:\n1. الحيرة في اختلاف الناس.\n2. الخوف من شر النفس.\nعند طلب:\n1. الهداية لما اختُلف فيه من الحق.\n2. أن يُقبل عهدك.\nعند الرغبة في:\n1. افتتاح صلاة الليل بدعاء النبي ﷺ.","duaItems":"1. استفتاح الليل: «اللهم رب جبرائيل وميكائيل وإسرافيل، فاطر السماوات والأرض، عالم الغيب والشهادة، أنت تحكم بين عبادك فيما كانوا فيه يختلفون، اهدني لما اختُلف فيه من الحق بإذنك، إنك تهدي من تشاء إلى صراط مستقيم» — صحيح ابن خزيمة 2/325.\n2. عهد الصباح — المستدرك 1924.\n3. ذكر أبي بكر — تخريج المسند 6851.","summary":"«فاطر السماوات والأرض عالم الغيب والشهادة» في السنة مفتتح العهد اليومي وذكر الطرفين واستفتاح الليل: «اهدني لما اختُلف فيه من الحق بإذنك»."},"situations":[{"situationId":80,"verses":[],"hadiths":[{"i":3,"strength":"direct","headline":"الخوف من شر نفسك قبل شر غيرك","bridge":"تخاف من شر نفسك قبل شر غيرك؟ ذكر أبي بكر: «اللهم فاطر السماوات والأرض، عالم الغيب والشهادة، لا إله إلا أنت، رب كل شيء ومليكه، أعوذ بك من شر نفسي ومن شر الشيطان وشركه وأن أقترف على نفسي سوءًا أو أجره إلى مسلم» — من فطر النفس وعلم غيبها يُعيذ منها؛ فاستعذ به من نفسك."}]},{"situationId":111,"verses":[],"hadiths":[{"i":4,"strength":"direct","headline":"الحيرة في اختلاف من تثق بعلمهم","bridge":"اختلف من تثق بهم؟ استفتح كما استفتح النبي ﷺ ليله: «فاطر السماوات والأرض عالم الغيب والشهادة، أنت تحكم بين عبادك فيما كانوا فيه يختلفون، اهدني لما اختُلف فيه من الحق»."}]},{"situationId":115,"verses":[],"hadiths":[{"i":2,"strength":"direct","headline":"الخوف من سوء الخاتمة وطلب عهدٍ يُوفّى يوم القيامة","bridge":"تريد عهدًا عند الله يُنادى به يوم القيامة؟ قال ابن مسعود: يقول الله يوم القيامة: من كان له عندي عهد فليقم، وعلّمهم: «اللهم فاطر السماوات والأرض عالم الغيب والشهادة، إني أعهد إليك… فاجعله لي عندك عهدًا توفيه إليّ يوم القيامة» — اعقد العهد اليوم باسمه تقم به غدًا."}]},{"situationId":134,"verses":[{"i":1,"strength":"direct","headline":"خصومةٌ طالت واستعصى حسمها بالحوار والحجة","bridge":"استعصى الحوار في خصومةٍ طالت؟ لما اشمأزت قلوب المشركين من ذكر الله وحده أُمر النبي ﷺ لا بمزيد جدل بل بالدعاء: ﴿قُلِ اللَّهُمَّ فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ عَالِمَ الْغَيْبِ وَالشَّهَادَةِ أَنْتَ تَحْكُمُ بَيْنَ عِبَادِكَ فِي مَا كَانُوا فِيهِ يَخْتَلِفُونَ﴾ — الخلاف الذي لا يُحسم بالحجة يُرفع إلى من فطر وعلم."}],"hadiths":[]},{"situationId":156,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"تعليم الأهل ذكرًا يتعاهدونه كل صباح","bridge":"تريد ذكرًا تعلّمه أهلك؟ أُمر زيد أن يتعاهد أهله بهذا العهد كل صباح؛ فعلّمه أهلك وتعاهدهم به."}]}]},{"id":197,"name":"كفى بالله وكيلاً","compound":true,"meaning":"كفى بالله وكيلًا: يكفيك أن يكون الله هو القائم بأمرك؛ فلا تحتاج معه إلى وكيلٍ غيره. والباء تأكيدٌ للكفاية، والوكيل من تُفوَّض إليه الأمور فيقوم بها.","teaches":"1. الصيغة خاتمةٌ لأوامر التوكل في أغلب مواضعها: أعرض عنهم، دع أذاهم، توكل — ثم تُختم بالكفاية.\n2. لا تأتي إلا بعد ذكر ما يُقلق: مكر المنافقين، أذى الكافرين، ثقل الرسالة.\n3. ملكُه لما في السماوات والأرض هو دليل كفايته (النساء 132، 171).","whenRecall":"- حين يُبيَّت لك كيدٌ لا تعلمه.\n- حين يؤذيك الناس وتريد أن تدع أذاهم.\n- حين تُقبل على أمرٍ ثقيل وحدك.","whenPray":"1. أن تقول بعد أن تأخذ بالأسباب: توكلت على الله وكفى بالله وكيلًا.\n2. ﴿وَتَوَكَّلْ عَلَى اللَّهِ وَكَفَى بِاللَّهِ وَكِيلًا﴾ — الأحزاب 3، تُقرأ عند بداية الأمر.","summary":"أعرض عن الكيد ودع الأذى وتوكل — فالذي له ما في السماوات وما في الأرض يكفيك وكيلًا.","verses":[{"i":1,"of":5,"s":4,"surah":"النساء","a":81,"text":"وَيَقُولُونَ طَاعَةٌ فَإِذَا بَرَزُوا مِنْ عِنْدِكَ بَيَّتَ طَائِفَةٌ مِنْهُمْ غَيْرَ الَّذِي تَقُولُ وَاللَّهُ يَكْتُبُ مَا يُبَيِّتُونَ فَأَعْرِضْ عَنْهُمْ وَتَوَكَّلْ عَلَى اللَّهِ وَكَفَى بِاللَّهِ وَكِيلًا","prev":{"a":80,"text":"مَنْ يُطِعِ الرَّسُولَ فَقَدْ أَطَاعَ اللَّهَ وَمَنْ تَوَلَّى فَمَا أَرْسَلْنَاكَ عَلَيْهِمْ حَفِيظًا"},"next":{"a":82,"text":"أَفَلَا يَتَدَبَّرُونَ الْقُرْآنَ وَلَوْ كَانَ مِنْ عِنْدِ غَيْرِ اللَّهِ لَوَجَدُوا فِيهِ اخْتِلَافًا كَثِيرًا"},"context":"المنافقون يقولون أمام النبي ﷺ طاعة، فإذا خرجوا دبّروا ليلًا غير ما قالوا.","reason":"الكيد خفيٌّ مدبَّر، فأُمر بالإعراض والتوكل، وخُتمت الآية بأن الله يكفيه هذا الكيد دون أن يلاحقه بنفسه."},{"i":2,"of":5,"s":4,"surah":"النساء","a":132,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَفَى بِاللَّهِ وَكِيلًا","prev":{"a":131,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَلَقَدْ وَصَّيْنَا الَّذِينَ أُوتُوا الْكِتَابَ مِنْ قَبْلِكُمْ وَإِيَّاكُمْ أَنِ اتَّقُوا اللَّهَ وَإِنْ تَكْفُرُوا فَإِنَّ لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَانَ اللَّهُ غَنِيًّا حَمِيدًا"},"next":{"a":133,"text":"إِنْ يَشَأْ يُذْهِبْكُمْ أَيُّهَا النَّاسُ وَيَأْتِ بِآخَرِينَ وَكَانَ اللَّهُ عَلَى ذَلِكَ قَدِيرًا"},"context":"آيات في التقوى وأن غنى الله لا يضرّه كفر الناس، وتكرر ذكر ملكه لما في السماوات والأرض.","reason":"من ملك كل شيء كفى من توكل عليه؛ فالكفاية هنا مبنية على الملك."},{"i":3,"of":5,"s":4,"surah":"النساء","a":171,"text":"يَا أَهْلَ الْكِتَابِ لَا تَغْلُوا فِي دِينِكُمْ وَلَا تَقُولُوا عَلَى اللَّهِ إِلَّا الْحَقَّ إِنَّمَا الْمَسِيحُ عِيسَى ابْنُ مَرْيَمَ رَسُولُ اللَّهِ وَكَلِمَتُهُ أَلْقَاهَا إِلَى مَرْيَمَ وَرُوحٌ مِنْهُ فَآمِنُوا بِاللَّهِ وَرُسُلِهِ وَلَا تَقُولُوا ثَلَاثَةٌ انْتَهُوا خَيْرًا لَكُمْ إِنَّمَا اللَّهُ إِلَهٌ وَاحِدٌ سُبْحَانَهُ أَنْ يَكُونَ لَهُ وَلَدٌ لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَفَى بِاللَّهِ وَكِيلًا","prev":{"a":170,"text":"يَا أَيُّهَا النَّاسُ قَدْ جَاءَكُمُ الرَّسُولُ بِالْحَقِّ مِنْ رَبِّكُمْ فَآمِنُوا خَيْرًا لَكُمْ وَإِنْ تَكْفُرُوا فَإِنَّ لِلَّهِ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ وَكَانَ اللَّهُ عَلِيمًا حَكِيمًا"},"next":{"a":172,"text":"لَنْ يَسْتَنْكِفَ الْمَسِيحُ أَنْ يَكُونَ عَبْدًا لِلَّهِ وَلَا الْمَلَائِكَةُ الْمُقَرَّبُونَ وَمَنْ يَسْتَنْكِفْ عَنْ عِبَادَتِهِ وَيَسْتَكْبِرْ فَسَيَحْشُرُهُمْ إِلَيْهِ جَمِيعًا"},"context":"خطاب لأهل الكتاب ينهاهم عن الغلو في المسيح ونسبة الولد إلى الله.","reason":"ردٌّ على اتخاذ الولد: الله غنيٌّ له ما في السماوات والأرض، يكفي نفسه وعباده، فلا يحتاج إلى ولد ولا شريك يقوم معه."},{"i":4,"of":5,"s":33,"surah":"الأحزاب","a":3,"text":"وَتَوَكَّلْ عَلَى اللَّهِ وَكَفَى بِاللَّهِ وَكِيلًا","prev":{"a":2,"text":"وَاتَّبِعْ مَا يُوحَى إِلَيْكَ مِنْ رَبِّكَ إِنَّ اللَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًا"},"next":{"a":4,"text":"مَا جَعَلَ اللَّهُ لِرَجُلٍ مِنْ قَلْبَيْنِ فِي جَوْفِهِ وَمَا جَعَلَ أَزْوَاجَكُمُ اللَّائِي تُظَاهِرُونَ مِنْهُنَّ أُمَّهَاتِكُمْ وَمَا جَعَلَ أَدْعِيَاءَكُمْ أَبْنَاءَكُمْ ذَلِكُمْ قَوْلُكُمْ بِأَفْوَاهِكُمْ وَاللَّهُ يَقُولُ الْحَقَّ وَهُوَ يَهْدِي السَّبِيلَ"},"context":"مطلع الأحزاب: أوامر للنبي ﷺ بالتقوى وترك طاعة الكافرين واتباع الوحي.","reason":"الأوامر ثقيلة في مواجهة الضغط، فخُتمت بالتوكل والكفاية ليقوى القلب على الثبات."},{"i":5,"of":5,"s":33,"surah":"الأحزاب","a":48,"text":"وَلَا تُطِعِ الْكَافِرِينَ وَالْمُنَافِقِينَ وَدَعْ أَذَاهُمْ وَتَوَكَّلْ عَلَى اللَّهِ وَكَفَى بِاللَّهِ وَكِيلًا","prev":{"a":47,"text":"وَبَشِّرِ الْمُؤْمِنِينَ بِأَنَّ لَهُمْ مِنَ اللَّهِ فَضْلًا كَبِيرًا"},"next":{"a":49,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا نَكَحْتُمُ الْمُؤْمِنَاتِ ثُمَّ طَلَّقْتُمُوهُنَّ مِنْ قَبْلِ أَنْ تَمَسُّوهُنَّ فَمَا لَكُمْ عَلَيْهِنَّ مِنْ عِدَّةٍ تَعْتَدُّونَهَا فَمَتِّعُوهُنَّ وَسَرِّحُوهُنَّ سَرَاحًا جَمِيلًا"},"context":"صفات النبي ﷺ: شاهد ومبشر ونذير وداع إلى الله، ثم الأمر بترك طاعة الكافرين والمنافقين.","reason":"أُمر أن يدع أذاهم لا أن ينشغل بالرد عليه، والكفاية هي التي تجعل ترك الأذى ممكنًا."}],"hadiths":[{"i":1,"of":1,"text":"كيفَ أنعَمُ وصاحبُ الصُّورِ قدِ التَقمَ وحَنا جبهتَهُ ينتَظِرُ متَى يؤمَرُ أن ينفُخَ قُلنا : يا رسولَ اللَّهِ : ما نقولُ يومئذٍ ؟ قال : قولوا : حَسبُنا اللَّهُ ونِعمَ الوَكيلُ علَى اللَّهِ توَكَّلْنا .","narrator":"أبو سعيد الخدري","source":"الصحيح المسند 422","grade":"صحيح","url":"https://dorar.net/h/N7La1Xm5","nameForm":"كفى بالله وكيلاً"}],"sunnah":{},"situations":[{"situationId":30,"verses":[{"i":1,"strength":"direct","bridge":"ما يدبَّر لك في الخفاء يكتبه الله، فأعرض عنه وتوكل؛ ﴿وَكَفَى بِاللَّهِ وَكِيلًا﴾."}],"hadiths":[]},{"situationId":35,"verses":[{"i":5,"strength":"direct","bridge":"لا يلزمك أن ترد على كل أذى؛ ﴿وَدَعْ أَذَاهُمْ وَتَوَكَّلْ عَلَى اللَّهِ﴾ فهو يكفيك."}],"hadiths":[]},{"situationId":102,"verses":[{"i":2,"strength":"direct","bridge":"إن خفت أن تضيع إن لم يقم بأمرك أحد، فاذكر أن له ﴿مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ﴾ ﴿وَكَفَى بِاللَّهِ وَكِيلًا﴾."}],"hadiths":[]},{"situationId":106,"verses":[{"i":3,"strength":"direct","bridge":"حين تسمع نسبة الولد إلى الله، فالجواب في ختام الآية: ملكه كله له ﴿وَكَفَى بِاللَّهِ وَكِيلًا﴾."}],"hadiths":[]},{"situationId":135,"verses":[{"i":4,"strength":"direct","bridge":"إذا ثقل عليك الثبات على الحق وحدك، فاتبع ما أُمرت به ﴿وَتَوَكَّلْ عَلَى اللَّهِ وَكَفَى بِاللَّهِ وَكِيلًا﴾."}],"hadiths":[]}]},{"id":198,"name":"إليه المصير","compound":true,"meaning":"إليه المصير: إليه وحده مرجع الخلق ومآل أمورهم؛ فالنهاية عنده، والحساب عنده.","teaches":"1. تأتي ختامًا لتقرير ملكه أو أسمائه، فتربط المعرفة بالله بالعاقبة.\n2. تحسم الجدال: إذا لم ينتهِ الخلاف هنا فالمرجع إليه (الشورى 15).\n3. تكسر الغرور بالنسب: لا أحد قريب منه بلا عمل (المائدة 18).","whenRecall":"- حين يطول الخلاف ولا يُحسم.\n- حين تغترّ بانتسابٍ أو مكانة.\n- حين تنسى العاقبة في زحمة الدنيا.","whenPray":"1. أن تختم الدعاء بالرجوع إليه: ربنا إليك المصير.\n2. ﴿غَافِرِ الذَّنْبِ وَقَابِلِ التَّوْبِ﴾ ثم ﴿إِلَيْهِ الْمَصِيرُ﴾ — غافر 3، تدعو بها عند التوبة.","summary":"كل طريق ينتهي إليه؛ فاجعل عملك مما يحسن أن تلقاه به.","verses":[{"i":1,"of":4,"s":5,"surah":"المائدة","a":18,"text":"وَقَالَتِ الْيَهُودُ وَالنَّصَارَى نَحْنُ أَبْنَاءُ اللَّهِ وَأَحِبَّاؤُهُ قُلْ فَلِمَ يُعَذِّبُكُمْ بِذُنُوبِكُمْ بَلْ أَنْتُمْ بَشَرٌ مِمَّنْ خَلَقَ يَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَإِلَيْهِ الْمَصِيرُ","prev":{"a":17,"text":"لَقَدْ كَفَرَ الَّذِينَ قَالُوا إِنَّ اللَّهَ هُوَ الْمَسِيحُ ابْنُ مَرْيَمَ قُلْ فَمَنْ يَمْلِكُ مِنَ اللَّهِ شَيْئًا إِنْ أَرَادَ أَنْ يُهْلِكَ الْمَسِيحَ ابْنَ مَرْيَمَ وَأُمَّهُ وَمَنْ فِي الْأَرْضِ جَمِيعًا وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا يَخْلُقُ مَا يَشَاءُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},"next":{"a":19,"text":"يَا أَهْلَ الْكِتَابِ قَدْ جَاءَكُمْ رَسُولُنَا يُبَيِّنُ لَكُمْ عَلَى فَتْرَةٍ مِنَ الرُّسُلِ أَنْ تَقُولُوا مَا جَاءَنَا مِنْ بَشِيرٍ وَلَا نَذِيرٍ فَقَدْ جَاءَكُمْ بَشِيرٌ وَنَذِيرٌ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},"context":"اليهود والنصارى يدّعون أنهم أبناء الله وأحباؤه.","reason":"رُدّت الدعوى بأنهم بشر يُعذَّبون بذنوبهم، وأن المصير إليه لا إلى نسبٍ يدّعونه."},{"i":2,"of":4,"s":40,"surah":"غافر","a":3,"text":"غَافِرِ الذَّنْبِ وَقَابِلِ التَّوْبِ شَدِيدِ الْعِقَابِ ذِي الطَّوْلِ لَا إِلَهَ إِلَّا هُوَ إِلَيْهِ الْمَصِيرُ","prev":{"a":2,"text":"تَنْزِيلُ الْكِتَابِ مِنَ اللَّهِ الْعَزِيزِ الْعَلِيمِ"},"next":{"a":4,"text":"مَا يُجَادِلُ فِي آيَاتِ اللَّهِ إِلَّا الَّذِينَ كَفَرُوا فَلَا يَغْرُرْكَ تَقَلُّبُهُمْ فِي الْبِلَادِ"},"context":"مطلع غافر: تنزيل الكتاب من العزيز العليم، ثم أسماء المغفرة والتوبة والعقاب.","reason":"بعد أن جمع الرجاء والخوف، ختم بأن المصير إليه؛ فالتوبة الآن قبل الرجوع."},{"i":3,"of":4,"s":42,"surah":"الشورى","a":15,"text":"فَلِذَلِكَ فَادْعُ وَاسْتَقِمْ كَمَا أُمِرْتَ وَلَا تَتَّبِعْ أَهْوَاءَهُمْ وَقُلْ آمَنْتُ بِمَا أَنْزَلَ اللَّهُ مِنْ كِتَابٍ وَأُمِرْتُ لِأَعْدِلَ بَيْنَكُمُ اللَّهُ رَبُّنَا وَرَبُّكُمْ لَنَا أَعْمَالُنَا وَلَكُمْ أَعْمَالُكُمْ لَا حُجَّةَ بَيْنَنَا وَبَيْنَكُمُ اللَّهُ يَجْمَعُ بَيْنَنَا وَإِلَيْهِ الْمَصِيرُ","prev":{"a":14,"text":"وَمَا تَفَرَّقُوا إِلَّا مِنْ بَعْدِ مَا جَاءَهُمُ الْعِلْمُ بَغْيًا بَيْنَهُمْ وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِنْ رَبِّكَ إِلَى أَجَلٍ مُسَمًّى لَقُضِيَ بَيْنَهُمْ وَإِنَّ الَّذِينَ أُورِثُوا الْكِتَابَ مِنْ بَعْدِهِمْ لَفِي شَكٍّ مِنْهُ مُرِيبٍ"},"next":{"a":16,"text":"وَالَّذِينَ يُحَاجُّونَ فِي اللَّهِ مِنْ بَعْدِ مَا اسْتُجِيبَ لَهُ حُجَّتُهُمْ دَاحِضَةٌ عِنْدَ رَبِّهِمْ وَعَلَيْهِمْ غَضَبٌ وَلَهُمْ عَذَابٌ شَدِيدٌ"},"context":"أمرٌ بالدعوة والاستقامة مع أهل الكتاب، وترك الحجاج معهم بعد البيان.","reason":"لما انتهى البلاغ وبقي الخلاف، أُحيل الحسم إلى الله الذي يجمع بين الفريقين."},{"i":4,"of":4,"s":64,"surah":"التغابن","a":3,"text":"خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ بِالْحَقِّ وَصَوَّرَكُمْ فَأَحْسَنَ صُوَرَكُمْ وَإِلَيْهِ الْمَصِيرُ","prev":{"a":2,"text":"هُوَ الَّذِي خَلَقَكُمْ فَمِنْكُمْ كَافِرٌ وَمِنْكُمْ مُؤْمِنٌ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ"},"next":{"a":4,"text":"يَعْلَمُ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ وَيَعْلَمُ مَا تُسِرُّونَ وَمَا تُعْلِنُونَ وَاللَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ"},"context":"التغابن: تسبيح الكون، وخلق السماوات والأرض بالحق، وتصوير الإنسان.","reason":"الخالق المصوِّر هو المرجع؛ فمن صوّرك فأحسن سيسألك عما صنعت بهذه الصورة."}],"hadiths":[{"i":1,"of":1,"text":"كانَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ يُعلِّمُ أصحابَهُ يقولُ : إذا أصبحَ أحدُكُم فليقُلْ : اللَّهمَّ بِكَ أصبَحنا ، وبِكَ أمسَينا ، وبِكَ نحيا وبِكَ نموتُ وإليكَ المصيرُ ، وإذا أمسَى فليقُلْ : اللَّهمَّ بِكَ أمسَينا وبِكَ أصبَحنا وبِكَ نحيا وبِكَ نموتُ وإليكَ النُّشورُ","narrator":"أبو هريرة","source":"صحيح الترمذي 3391","grade":"صحيح","url":"https://dorar.net/h/pH17vuWc","nameForm":"إليه المصير"}],"sunnah":{},"situations":[{"situationId":20,"verses":[{"i":2,"strength":"direct","bridge":"إن كنت بين ذنبٍ وتوبة، فهو ﴿غَافِرِ الذَّنْبِ وَقَابِلِ التَّوْبِ﴾ و﴿إِلَيْهِ الْمَصِيرُ﴾، فبادر قبل الرجوع إليه."}],"hadiths":[]},{"situationId":89,"verses":[{"i":1,"strength":"direct","bridge":"الانتساب لا يغني عن العمل؛ فالكل بشر ممن خلق ﴿وَإِلَيْهِ الْمَصِيرُ﴾."}],"hadiths":[]},{"situationId":92,"verses":[{"i":4,"strength":"direct","bridge":"الذي ﴿صَوَّرَكُمْ فَأَحْسَنَ صُوَرَكُمْ﴾ إليه ترجع؛ فلا تنشغل بالدنيا عن هذا اللقاء."}],"hadiths":[]},{"situationId":134,"verses":[{"i":3,"strength":"direct","bridge":"إذا بلّغت وطال الخلاف، فقل: ﴿اللَّهُ يَجْمَعُ بَيْنَنَا وَإِلَيْهِ الْمَصِيرُ﴾."}],"hadiths":[]}]},{"id":199,"name":"عنده مفاتح الغيب","compound":true,"meaning":"عنده مفاتح الغيب: خزائن الغيب ومفاتيحه عند الله وحده، لا يعلمها إلا هو.","teaches":"1. الغيب ليس متاحًا لأحد؛ فطلبه من غير الله وهمٌ.\n2. علمه يمتد إلى أدق الأشياء: الورقة الساقطة، والحبة في الظلمات.\n3. ما لا تعلمه أنت ليس مجهولًا عنده.","whenRecall":"- حين تقلق مما يخبئه الغد.\n- حين تُغرى بالتنجيم أو التشاؤم لمعرفة المستقبل.","whenPray":"1. أن تسأله الخير فيما لا تعلم: اللهم إنك تعلم ولا أعلم.","summary":"ما يخفيه الغد مفتاحه عند الله وحده؛ فاطمئن لعلمه، ولا تطلبه من غيره.","verses":[{"i":1,"of":1,"s":6,"surah":"الأنعام","a":59,"text":"وَعِنْدَهُ مَفَاتِحُ الْغَيْبِ لَا يَعْلَمُهَا إِلَّا هُوَ وَيَعْلَمُ مَا فِي الْبَرِّ وَالْبَحْرِ وَمَا تَسْقُطُ مِنْ وَرَقَةٍ إِلَّا يَعْلَمُهَا وَلَا حَبَّةٍ فِي ظُلُمَاتِ الْأَرْضِ وَلَا رَطْبٍ وَلَا يَابِسٍ إِلَّا فِي كِتَابٍ مُبِينٍ","prev":{"a":58,"text":"قُلْ لَوْ أَنَّ عِنْدِي مَا تَسْتَعْجِلُونَ بِهِ لَقُضِيَ الْأَمْرُ بَيْنِي وَبَيْنَكُمْ وَاللَّهُ أَعْلَمُ بِالظَّالِمِينَ"},"next":{"a":60,"text":"وَهُوَ الَّذِي يَتَوَفَّاكُمْ بِاللَّيْلِ وَيَعْلَمُ مَا جَرَحْتُمْ بِالنَّهَارِ ثُمَّ يَبْعَثُكُمْ فِيهِ لِيُقْضَى أَجَلٌ مُسَمًّى ثُمَّ إِلَيْهِ مَرْجِعُكُمْ ثُمَّ يُنَبِّئُكُمْ بِمَا كُنْتُمْ تَعْمَلُونَ"},"context":"الأنعام في محاجة المشركين، وقبلها أن الله أعلم بالظالمين وأن الحكم بيده.","reason":"ذكر مفاتح الغيب يقطع تعلّق المشركين بمن يدّعي علم الغيب، ويبيّن إحاطة علمه بأصغر الأشياء."}],"hadiths":[{"i":1,"of":1,"text":"مَفاتيحُ الغَيبِ في خَمْسٍ، لا يَعلَمُهُنَّ إلَّا اللهُ: لا يَعلَمُ ما في غَدٍ إلَّا اللهُ، ولا يَعلَمُ نُزولَ الغَيثِ إلَّا اللهُ، ولا يَعلَمُ ما في الأرحامِ إلَّا اللهُ، ولا يَعلَمُ السَّاعةَ إلَّا اللهُ، وما تَدري نَفْسٌ ماذا تَكسِبُ غدًا، وما تَدري نَفْسٌ بأيِّ أرضٍ تَموتُ.","narrator":"عبدالله بن عمر","source":"تخريج المسند لشعيب 5133","grade":"صحيح","judgment":"إسناده صحيح على شرط الشيخين","url":"https://dorar.net/h/RZMfCSyA","nameForm":"عنده مفاتح الغيب"}],"sunnah":{},"situations":[{"situationId":113,"verses":[{"i":1,"strength":"direct","bridge":"ما تخافه من المستقبل في علمه؛ ﴿وَعِنْدَهُ مَفَاتِحُ الْغَيْبِ لَا يَعْلَمُهَا إِلَّا هُوَ﴾، فلا تطلبه من كاهن ولا نجم."}],"hadiths":[]}]},{"id":200,"name":"أعلم بالمهتدين","compound":true,"meaning":"أعلم بالمهتدين: الله أعلم بمن يستحق الهداية ومن سلكها؛ فالحكم على القلوب له لا للناس.","teaches":"1. تأتي مقرونة غالبًا بـ«أعلم بمن ضل»: العلم بالفريقين له.\n2. واجبك البلاغ بالحكمة، والهداية بيده (القصص 56).\n3. لا تكثرة الناس ولا قلّتهم معيار للهداية (الأنعام 117).","whenRecall":"- حين تحزن على قريب لم يهتدِ.\n- حين تجادل وتريد أن ترى النتيجة.\n- حين تُغرى بالحكم على قلوب الناس.","whenPray":"1. أن تدعو لمن تحب بالهداية، وتترك النتيجة له.","summary":"ادعُ بالحكمة وأحسن الجدال، ثم دع الهداية لمن هو أعلم بالمهتدين.","verses":[{"i":1,"of":4,"s":6,"surah":"الأنعام","a":117,"text":"إِنَّ رَبَّكَ هُوَ أَعْلَمُ مَنْ يَضِلُّ عَنْ سَبِيلِهِ وَهُوَ أَعْلَمُ بِالْمُهْتَدِينَ","prev":{"a":116,"text":"وَإِنْ تُطِعْ أَكْثَرَ مَنْ فِي الْأَرْضِ يُضِلُّوكَ عَنْ سَبِيلِ اللَّهِ إِنْ يَتَّبِعُونَ إِلَّا الظَّنَّ وَإِنْ هُمْ إِلَّا يَخْرُصُونَ"},"next":{"a":118,"text":"فَكُلُوا مِمَّا ذُكِرَ اسْمُ اللَّهِ عَلَيْهِ إِنْ كُنْتُمْ بِآيَاتِهِ مُؤْمِنِينَ"},"context":"قبلها: إن تطع أكثر من في الأرض يضلوك عن سبيل الله.","reason":"لما حذّر من اتباع الأكثرية، بيّن أن الله وحده يعلم المهتدي من الضال."},{"i":2,"of":4,"s":16,"surah":"النحل","a":125,"text":"ادْعُ إِلَى سَبِيلِ رَبِّكَ بِالْحِكْمَةِ وَالْمَوْعِظَةِ الْحَسَنَةِ وَجَادِلْهُمْ بِالَّتِي هِيَ أَحْسَنُ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَنْ ضَلَّ عَنْ سَبِيلِهِ وَهُوَ أَعْلَمُ بِالْمُهْتَدِينَ","prev":{"a":124,"text":"إِنَّمَا جُعِلَ السَّبْتُ عَلَى الَّذِينَ اخْتَلَفُوا فِيهِ وَإِنَّ رَبَّكَ لَيَحْكُمُ بَيْنَهُمْ يَوْمَ الْقِيَامَةِ فِيمَا كَانُوا فِيهِ يَخْتَلِفُونَ"},"next":{"a":126,"text":"وَإِنْ عَاقَبْتُمْ فَعَاقِبُوا بِمِثْلِ مَا عُوقِبْتُمْ بِهِ وَلَئِنْ صَبَرْتُمْ لَهُوَ خَيْرٌ لِلصَّابِرِينَ"},"context":"منهج الدعوة: الحكمة والموعظة الحسنة والجدال بالتي هي أحسن.","reason":"بعد رسم المنهج، رفع عن الداعي همّ النتيجة؛ فالله أعلم بالفريقين."},{"i":3,"of":4,"s":28,"surah":"القصص","a":56,"text":"إِنَّكَ لَا تَهْدِي مَنْ أَحْبَبْتَ وَلَكِنَّ اللَّهَ يَهْدِي مَنْ يَشَاءُ وَهُوَ أَعْلَمُ بِالْمُهْتَدِينَ","prev":{"a":55,"text":"وَإِذَا سَمِعُوا اللَّغْوَ أَعْرَضُوا عَنْهُ وَقَالُوا لَنَا أَعْمَالُنَا وَلَكُمْ أَعْمَالُكُمْ سَلَامٌ عَلَيْكُمْ لَا نَبْتَغِي الْجَاهِلِينَ"},"next":{"a":57,"text":"وَقَالُوا إِنْ نَتَّبِعِ الْهُدَى مَعَكَ نُتَخَطَّفْ مِنْ أَرْضِنَا أَوَلَمْ نُمَكِّنْ لَهُمْ حَرَمًا آمِنًا يُجْبَى إِلَيْهِ ثَمَرَاتُ كُلِّ شَيْءٍ رِزْقًا مِنْ لَدُنَّا وَلَكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ"},"context":"نزلت في حرص النبي ﷺ على هداية عمه أبي طالب.","reason":"أعزّ ما يحبه الداعي هداية قريبه، فبيّن أن الهداية بيد الله وهو أعلم بأهلها."},{"i":4,"of":4,"s":68,"surah":"القلم","a":7,"text":"إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَنْ ضَلَّ عَنْ سَبِيلِهِ وَهُوَ أَعْلَمُ بِالْمُهْتَدِينَ","prev":{"a":6,"text":"بِأَيِّكُمُ الْمَفْتُونُ"},"next":{"a":8,"text":"فَلَا تُطِعِ الْمُكَذِّبِينَ"},"context":"مطلع القلم: تثبيت النبي ﷺ أمام اتهامه بالجنون.","reason":"لما رُمي بالضلال، طمأنه بأن الله أعلم بمن ضل ومن اهتدى؛ فحكم الناس لا يغيّر الحقيقة."}],"hadiths":[{"i":1,"of":1,"text":"لَمَّا حَضَرَت أبا طالِبٍ الوفاةُ جاءَه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فوجَدَ عِندَه أبا جَهلٍ، وعَبدَ اللهِ بنَ أبي أُمَيَّةَ بنِ المُغيرةِ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: يا عَمِّ، قُلْ: لا إلَهَ إلَّا اللهُ، كَلِمةً أشهَدُ لكَ بها عِندَ اللهِ، فقال أبو جَهلٍ وعَبدُ اللهِ بنُ أبي أُمَيَّةَ: يا أبا طالِبٍ، أتَرغَبُ عن مِلَّةِ عبدِ المُطَّلِبِ؟ فلم يَزَلْ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يَعرِضُها عليه، ويُعيدُ له تلك المَقالةَ حتَّى قال أبو طالِبٍ آخِرَ ما كَلَّمَهم: هو على مِلَّةِ عبدِ المُطَّلِبِ، وأبى أن يَقولَ: لا إلَهَ إلَّا اللهُ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أما واللهِ لأستَغفِرَنَّ لكَ ما لم أُنهَ عَنكَ، فأنزَلَ اللهُ عَزَّ وجَلَّ: {ما كان للنَّبيِّ والذينَ آمَنوا أن يَستَغفِروا للمُشرِكينَ ولو كانوا أولي قُربى مِن بَعدِ ما تَبَيَّنَ لهم أنَّهم أصحابُ الجَحيمِ} [التوبة: 113]، وأنزَلَ اللهُ تَعالى في أبي طالِبٍ، فقال لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّم: {إنَّكَ لا تَهدي مَن أحبَبتَ ولَكِنَّ اللهَ يَهدي مَن يَشاءُ وهو أعلَمُ بالمُهتَدينَ} [القصص: 56]. وفي روايةٍ: مِثلَه، غيرَ أنَّ حَديثَ صالِحٍ انتَهى عِندَ قَولِه: فأنزَلَ اللهُ عَزَّ وجَلَّ فيه، ولم يَذكُرِ الآيَتَينِ، وقال في حَديثِه: ويَعودانِ في تلك المَقالةِ، وفي حَديثِ مَعمَرٍ مَكانَ هذه الكَلِمةِ: فلم يَزالا به.","narrator":"المسيب بن حزن","source":"صحيح مسلم 24","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/zixiMxdu","nameForm":"أعلم بالمهتدين"}],"sunnah":{},"situations":[{"situationId":117,"verses":[{"i":1,"strength":"direct","bridge":"لا تجعل كثرة الناس دليلك؛ ﴿إِنَّ رَبَّكَ هُوَ أَعْلَمُ مَنْ يَضِلُّ عَنْ سَبِيلِهِ﴾."}],"hadiths":[]},{"situationId":131,"verses":[{"i":3,"strength":"direct","bridge":"﴿إِنَّكَ لَا تَهْدِي مَنْ أَحْبَبْتَ﴾؛ ادعُ له واصبر، فالله أعلم بالمهتدين."}],"hadiths":[]},{"situationId":133,"verses":[{"i":2,"strength":"direct","bridge":"إذا جادلت بالتي هي أحسن ولم يقتنع، فقد أديت ما عليك؛ ﴿وَهُوَ أَعْلَمُ بِالْمُهْتَدِينَ﴾."}],"hadiths":[]},{"situationId":136,"verses":[{"i":4,"strength":"direct","bridge":"إن اتُّهمت بالضلال وأنت على الحق، فـ﴿إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَنْ ضَلَّ عَنْ سَبِيلِهِ﴾."}],"hadiths":[]}]},{"id":201,"name":"بيده الخير","compound":true,"meaning":"بيده الخير: الخير كله في تصرفه وعطائه؛ يؤتيه من يشاء، ولا يُطلب إلا منه.","teaches":"1. وردت في دعاءٍ أُمر النبي ﷺ أن يقوله: ﴿قُلِ اللَّهُمَّ مَالِكَ الْمُلْكِ﴾.\n2. العزّ والذل والملك تتقلب بأمره، والخير ثابت في يده.\n3. نُسب الخير إلى يده أدبًا، مع أن كل شيء بقدرته.","whenRecall":"- حين ترى الملك والجاه ينتقل بين الناس.\n- حين تتعلق بمن بيده منصب أو مال.","whenPray":"1. ﴿قُلِ اللَّهُمَّ مَالِكَ الْمُلْكِ﴾ إلى ﴿بِيَدِكَ الْخَيْرُ إِنَّكَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — آل عمران 26.","summary":"الملك يؤتى وينزع، والعز يتبدّل، والخير ثابت في يده؛ فاطلبه منه.","verses":[{"i":1,"of":1,"s":3,"surah":"آل عمران","a":26,"text":"قُلِ اللَّهُمَّ مَالِكَ الْمُلْكِ تُؤْتِي الْمُلْكَ مَنْ تَشَاءُ وَتَنْزِعُ الْمُلْكَ مِمَّنْ تَشَاءُ وَتُعِزُّ مَنْ تَشَاءُ وَتُذِلُّ مَنْ تَشَاءُ بِيَدِكَ الْخَيْرُ إِنَّكَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":25,"text":"فَكَيْفَ إِذَا جَمَعْنَاهُمْ لِيَوْمٍ لَا رَيْبَ فِيهِ وَوُفِّيَتْ كُلُّ نَفْسٍ مَا كَسَبَتْ وَهُمْ لَا يُظْلَمُونَ"},"next":{"a":27,"text":"تُولِجُ اللَّيْلَ فِي النَّهَارِ وَتُولِجُ النَّهَارَ فِي اللَّيْلِ وَتُخْرِجُ الْحَيَّ مِنَ الْمَيِّتِ وَتُخْرِجُ الْمَيِّتَ مِنَ الْحَيِّ وَتَرْزُقُ مَنْ تَشَاءُ بِغَيْرِ حِسَابٍ"},"context":"آل عمران في سياق المحاجة مع أهل الكتاب، ودعاء يقرر أن الملك لله يتصرف فيه.","reason":"لما ذكر إيتاء الملك ونزعه، والإعزاز والإذلال، نسب الخير إلى يده؛ فما يقضيه خير وإن رآه العبد شرًّا."}],"hadiths":[{"i":1,"of":2,"text":"كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّم إذا خرَج لسفرٍ قال اللهمَّ بلاغًا يُبَلِّغُ خيرًا مغفِرةً منك ورِضوانًا بيدِك الخيرُ إنَّك على كلِّ شيءٍ قديرٌ اللهمَّ أنت الصاحِبُ في السَّفرِ والخليفةُ في الأهلِ اللهمَّ هوِّنْ علينا السَّفرَ واطْوِ لنا الأرضَ اللهمَّ أعوذُ بك مِن وَعْثاءِ السَّفرِ وكآبةِ المُنْقَلَبِ","narrator":"البراء بن عازب","source":"مجمع الزوائد 10/133","grade":"صحيح","judgment":"رجاله رجال الصحيح غير فطر بن خليفة وهو ثقة","url":"https://dorar.net/h/o8siNHne","nameForm":"بيده الخير"},{"i":2,"of":2,"text":"«قالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ لمُعاذِ بنِ جَبَلٍ: ألَا أُعَلِّمُك دُعاءً تَدْعو به، لو كانَ عليك مِثلُ جَبَلٍ دَيْنًا لأدَّاه اللهُ عنك؟ قُلْ يا مَعاذُ: اللَّهُمَّ مالِكَ المُلْكِ، تُؤْتي المُلْكَ مَن تَشاءُ، وتَنزِعُ المُلْكَ مِمَّن تَشاءُ، وتُعِزُّ مَن تَشاءُ، وتُذِلُّ مَن تَشاءُ، بيَدِك الخَيْرُ إنَّك على كلِّ شيءٍ قَديرٌ، رَحْمانُ الدُّنْيا والآخِرةِ ورَحيمُهما، تُعْطيهما مَن تَشاءُ، وتَمنَعُ مِنهما مَن تَشاءُ، ارْحَمْني رَحْمةً تُغْنيني بها عن رَحْمةِ مَن سِواك».\nقالَ الطَّبَرانِيُّ: لم يَرْوِه عن الزُّهْرِيِّ إلَّا يونُسُ، ولا عنه إلَّا وَهْبُ اللهِ.","narrator":"أنس بن مالك","source":"الأحاديث المختارة 2633","grade":"صحيح","judgment":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","url":"https://dorar.net/h/harp7m5M","nameForm":"بيده الخير"}],"sunnah":{},"situations":[{"situationId":42,"verses":[{"i":1,"strength":"direct","bridge":"لا تتعلق بمن يملك منصبك أو رزقك؛ فالله ﴿مَالِكَ الْمُلْكِ﴾ و﴿بِيَدِكَ الْخَيْرُ﴾."}],"hadiths":[]}]},{"id":202,"name":"له مقاليد السماوات والأرض","compound":true,"meaning":"له مقاليد السماوات والأرض: مفاتيح خزائنهما وتدبيرهما بيده؛ فلا يُفتح شيء ولا يُغلق إلا بأمره.","teaches":"1. المقاليد هي المفاتيح؛ فالرزق والأمر لا يُفتح بالحيلة وحدها.\n2. بسط الرزق وتضييقه بعلمه (الشورى 12).\n3. الكفر بآياته خسارة لمن ملك المفاتيح كلها (الزمر 63).","whenRecall":"- حين ينغلق عليك باب رزق.\n- حين ترى غيرك أوسع منك رزقًا.","whenPray":"1. أن تسأله فتح الأبواب: يا من له مقاليد السماوات والأرض افتح لي.","summary":"المفاتيح كلها عنده؛ فاسأل من يملك المفتاح قبل أن تطرق الباب.","verses":[{"i":1,"of":2,"s":39,"surah":"الزمر","a":63,"text":"لَهُ مَقَالِيدُ السَّمَاوَاتِ وَالْأَرْضِ وَالَّذِينَ كَفَرُوا بِآيَاتِ اللَّهِ أُولَئِكَ هُمُ الْخَاسِرُونَ","prev":{"a":62,"text":"اللَّهُ خَالِقُ كُلِّ شَيْءٍ وَهُوَ عَلَى كُلِّ شَيْءٍ وَكِيلٌ"},"next":{"a":64,"text":"قُلْ أَفَغَيْرَ اللَّهِ تَأْمُرُونِّي أَعْبُدُ أَيُّهَا الْجَاهِلُونَ"},"context":"الزمر: الله خالق كل شيء وهو على كل شيء وكيل.","reason":"ذكر المقاليد بعد الوكالة: من يملك المفاتيح هو القائم على كل شيء، ومن كفر بآياته خسر."},{"i":2,"of":2,"s":42,"surah":"الشورى","a":12,"text":"لَهُ مَقَالِيدُ السَّمَاوَاتِ وَالْأَرْضِ يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ وَيَقْدِرُ إِنَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ","prev":{"a":11,"text":"فَاطِرُ السَّمَاوَاتِ وَالْأَرْضِ جَعَلَ لَكُمْ مِنْ أَنْفُسِكُمْ أَزْوَاجًا وَمِنَ الْأَنْعَامِ أَزْوَاجًا يَذْرَؤُكُمْ فِيهِ لَيْسَ كَمِثْلِهِ شَيْءٌ وَهُوَ السَّمِيعُ الْبَصِيرُ"},"next":{"a":13,"text":"شَرَعَ لَكُمْ مِنَ الدِّينِ مَا وَصَّى بِهِ نُوحًا وَالَّذِي أَوْحَيْنَا إِلَيْكَ وَمَا وَصَّيْنَا بِهِ إِبْرَاهِيمَ وَمُوسَى وَعِيسَى أَنْ أَقِيمُوا الدِّينَ وَلَا تَتَفَرَّقُوا فِيهِ كَبُرَ عَلَى الْمُشْرِكِينَ مَا تَدْعُوهُمْ إِلَيْهِ اللَّهُ يَجْتَبِي إِلَيْهِ مَنْ يَشَاءُ وَيَهْدِي إِلَيْهِ مَنْ يُنِيبُ"},"context":"الشورى: فاطر السماوات والأرض، ليس كمثله شيء.","reason":"قرن المقاليد ببسط الرزق وتقديره وعلمه بكل شيء؛ فالتفاوت في الرزق عن علم."}],"hadiths":[],"situations":[{"situationId":1,"verses":[{"i":1,"strength":"direct","bridge":"ما أُغلق عليك ليس مغلقًا عنده؛ ﴿لَهُ مَقَالِيدُ السَّمَاوَاتِ وَالْأَرْضِ﴾."}],"hadiths":[]},{"situationId":39,"verses":[{"i":2,"strength":"direct","bridge":"إن ضاق رزقك فالذي ﴿يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ وَيَقْدِرُ﴾ يملك مقاليده، وهو بكل شيء عليم."}],"hadiths":[]}]},{"id":203,"name":"لطيف بعباده","compound":true,"meaning":"لطيف بعباده: يوصل إليهم الخير من حيث لا يشعرون، ويرفق بهم في تدبير أمورهم.","teaches":"1. لطفه عام بعباده، ومنه الرزق لمن يشاء.\n2. جاء بعده القوي العزيز: لطفه عن قوة لا عن ضعف.","whenRecall":"- حين يأتيك الرزق من غير حساب.\n- حين تتعجل الفرج ولا ترى أسبابه.","whenPray":"1. يا لطيفًا بعباده، الطف بي في أمري.","summary":"رزقه يصل بلطف من حيث لا تحتسب، وقوته تضمن أنه لا يعجز عن إيصاله.","verses":[{"i":1,"of":1,"s":42,"surah":"الشورى","a":19,"text":"اللَّهُ لَطِيفٌ بِعِبَادِهِ يَرْزُقُ مَنْ يَشَاءُ وَهُوَ الْقَوِيُّ الْعَزِيزُ","prev":{"a":18,"text":"يَسْتَعْجِلُ بِهَا الَّذِينَ لَا يُؤْمِنُونَ بِهَا وَالَّذِينَ آمَنُوا مُشْفِقُونَ مِنْهَا وَيَعْلَمُونَ أَنَّهَا الْحَقُّ أَلَا إِنَّ الَّذِينَ يُمَارُونَ فِي السَّاعَةِ لَفِي ضَلَالٍ بَعِيدٍ"},"next":{"a":20,"text":"مَنْ كَانَ يُرِيدُ حَرْثَ الْآخِرَةِ نَزِدْ لَهُ فِي حَرْثِهِ وَمَنْ كَانَ يُرِيدُ حَرْثَ الدُّنْيَا نُؤْتِهِ مِنْهَا وَمَا لَهُ فِي الْآخِرَةِ مِنْ نَصِيبٍ"},"context":"الشورى بعد ذكر الساعة واستعجال المكذبين بها.","reason":"بعد الوعيد ذكر اللطف بالعباد ورزقهم؛ فالإمهال والرزق من لطفه لا من غفلته."}],"hadiths":[],"situations":[{"situationId":41,"verses":[{"i":1,"strength":"direct","bridge":"إن قلقت على رزقك، فـ﴿اللَّهُ لَطِيفٌ بِعِبَادِهِ يَرْزُقُ مَنْ يَشَاءُ﴾."}],"hadiths":[]}]},{"id":204,"name":"ربهما","compound":false,"meaning":"ربهما: ربّ الاثنين المذكورين، يربّيهما ويرعاهما؛ وتأتي في القرآن مع الزوجين أو الوالدين.","teaches":"1. ثلاثة مواضع كلها في شأن الأسرة: آدم وزوجه، والزوجان عند الحمل، والوالدان في قصة الغلام.\n2. الرب ينادي ليعاتب، ويُدعى عند الحمل، ويبدل خيرًا.","whenRecall":"- حين يخطئ الزوجان معًا.\n- حين تنتظر مولودًا.\n- حين تفقد ولدًا أو تخاف عليه.","whenPray":"1. ﴿لَئِنْ آتَيْتَنَا صَالِحًا لَنَكُونَنَّ مِنَ الشَّاكِرِينَ﴾ — الأعراف 189، دعاء الزوجين عند الحمل.","summary":"ربّ الأسرة واحد: يعاتب الزوجين ليتوبا، ويُدعى للولد، ويبدل الوالدين خيرًا مما فقدا.","verses":[{"i":1,"of":3,"s":7,"surah":"الأعراف","a":22,"text":"فَدَلَّاهُمَا بِغُرُورٍ فَلَمَّا ذَاقَا الشَّجَرَةَ بَدَتْ لَهُمَا سَوْآتُهُمَا وَطَفِقَا يَخْصِفَانِ عَلَيْهِمَا مِنْ وَرَقِ الْجَنَّةِ وَنَادَاهُمَا رَبُّهُمَا أَلَمْ أَنْهَكُمَا عَنْ تِلْكُمَا الشَّجَرَةِ وَأَقُلْ لَكُمَا إِنَّ الشَّيْطَانَ لَكُمَا عَدُوٌّ مُبِينٌ","prev":{"a":21,"text":"وَقَاسَمَهُمَا إِنِّي لَكُمَا لَمِنَ النَّاصِحِينَ"},"next":{"a":23,"text":"قَالَا رَبَّنَا ظَلَمْنَا أَنْفُسَنَا وَإِنْ لَمْ تَغْفِرْ لَنَا وَتَرْحَمْنَا لَنَكُونَنَّ مِنَ الْخَاسِرِينَ"},"context":"قصة آدم وزوجه حين أغواهما الشيطان فأكلا من الشجرة.","reason":"النداء جاء من ربهما معًا، تذكيرًا بالنهي والعداوة؛ فالخطأ المشترك يُعالج بتوبة مشتركة."},{"i":2,"of":3,"s":7,"surah":"الأعراف","a":189,"text":"هُوَ الَّذِي خَلَقَكُمْ مِنْ نَفْسٍ وَاحِدَةٍ وَجَعَلَ مِنْهَا زَوْجَهَا لِيَسْكُنَ إِلَيْهَا فَلَمَّا تَغَشَّاهَا حَمَلَتْ حَمْلًا خَفِيفًا فَمَرَّتْ بِهِ فَلَمَّا أَثْقَلَتْ دَعَوَا اللَّهَ رَبَّهُمَا لَئِنْ آتَيْتَنَا صَالِحًا لَنَكُونَنَّ مِنَ الشَّاكِرِينَ","prev":{"a":188,"text":"قُلْ لَا أَمْلِكُ لِنَفْسِي نَفْعًا وَلَا ضَرًّا إِلَّا مَا شَاءَ اللَّهُ وَلَوْ كُنْتُ أَعْلَمُ الْغَيْبَ لَاسْتَكْثَرْتُ مِنَ الْخَيْرِ وَمَا مَسَّنِيَ السُّوءُ إِنْ أَنَا إِلَّا نَذِيرٌ وَبَشِيرٌ لِقَوْمٍ يُؤْمِنُونَ"},"next":{"a":190,"text":"فَلَمَّا آتَاهُمَا صَالِحًا جَعَلَا لَهُ شُرَكَاءَ فِيمَا آتَاهُمَا فَتَعَالَى اللَّهُ عَمَّا يُشْرِكُونَ"},"context":"خلق الناس من نفس واحدة، وجعل الزوج سكنًا، ثم الحمل.","reason":"عند ثقل الحمل اتجه الزوجان إلى ربهما بالدعاء والعهد بالشكر."},{"i":3,"of":3,"s":18,"surah":"الكهف","a":81,"text":"فَأَرَدْنَا أَنْ يُبْدِلَهُمَا رَبُّهُمَا خَيْرًا مِنْهُ زَكَاةً وَأَقْرَبَ رُحْمًا","prev":{"a":80,"text":"وَأَمَّا الْغُلَامُ فَكَانَ أَبَوَاهُ مُؤْمِنَيْنِ فَخَشِينَا أَنْ يُرْهِقَهُمَا طُغْيَانًا وَكُفْرًا"},"next":{"a":82,"text":"وَأَمَّا الْجِدَارُ فَكَانَ لِغُلَامَيْنِ يَتِيمَيْنِ فِي الْمَدِينَةِ وَكَانَ تَحْتَهُ كَنْزٌ لَهُمَا وَكَانَ أَبُوهُمَا صَالِحًا فَأَرَادَ رَبُّكَ أَنْ يَبْلُغَا أَشُدَّهُمَا وَيَسْتَخْرِجَا كَنْزَهُمَا رَحْمَةً مِنْ رَبِّكَ وَمَا فَعَلْتُهُ عَنْ أَمْرِي ذَلِكَ تَأْوِيلُ مَا لَمْ تَسْطِعْ عَلَيْهِ صَبْرًا"},"context":"قصة موسى والخضر وقتل الغلام.","reason":"الغلام قُتل لحكمة، وربّ الوالدين يبدلهما خيرًا منه زكاة ورحمة."}],"hadiths":[],"situations":[{"situationId":8,"verses":[{"i":3,"strength":"direct","bridge":"ما فقدته من ولد قد يكون لحكمة لا تراها؛ ﴿فَأَرَدْنَا أَنْ يُبْدِلَهُمَا رَبُّهُمَا خَيْرًا مِنْهُ﴾."}],"hadiths":[]},{"situationId":51,"verses":[{"i":2,"strength":"direct","bridge":"إذا انتظرتما ولدًا فادعوا ربكما معًا: ﴿لَئِنْ آتَيْتَنَا صَالِحًا لَنَكُونَنَّ مِنَ الشَّاكِرِينَ﴾."}],"hadiths":[]},{"situationId":75,"verses":[{"i":1,"strength":"direct","bridge":"إذا أخطأتما معًا فارجعا معًا؛ ﴿وَنَادَاهُمَا رَبُّهُمَا أَلَمْ أَنْهَكُمَا عَنْ تِلْكُمَا الشَّجَرَةِ﴾."}],"hadiths":[]}]},{"id":205,"name":"ما الله بغافل عما تعملون / ما ربك بغافل عما تعملون / ما الله بغافل عما يعملون / ما ربك بغافل عما يعملون","compound":true,"meaning":"ما الله بغافل عما تعملون: نفيٌ للغفلة عن الله؛ فكل عمل محفوظ عنده، خيرًا كان أو شرًّا.","teaches":"1. تأتي بعد ذكر عمل خفي أو كتمان: قسوة القلوب، كتمان الشهادة، الصد عن السبيل.\n2. وتأتي بعد أمر بطاعة: التوجه إلى القبلة، العبادة والتوكل.\n3. النفي يحمل الوعيد للعاصي والطمأنينة للمطيع معًا.","whenRecall":"- حين تعمل خيرًا لا يراه أحد.\n- حين تُغرى بمعصية في الخلوة.\n- حين ترى ظالمًا يظن أنه لن يُحاسب.","whenPray":"1. اللهم اجعل عملي خالصًا لك، فأنت لست بغافل عما أعمل.","summary":"لا يضيع عندك عمل: لا قسوة قلب ولا كتمان ولا طاعة خفية؛ فاعمل على علمٍ بأنه يرى.","verses":[{"i":1,"of":9,"s":2,"surah":"البقرة","a":74,"text":"ثُمَّ قَسَتْ قُلُوبُكُمْ مِنْ بَعْدِ ذَلِكَ فَهِيَ كَالْحِجَارَةِ أَوْ أَشَدُّ قَسْوَةً وَإِنَّ مِنَ الْحِجَارَةِ لَمَا يَتَفَجَّرُ مِنْهُ الْأَنْهَارُ وَإِنَّ مِنْهَا لَمَا يَشَّقَّقُ فَيَخْرُجُ مِنْهُ الْمَاءُ وَإِنَّ مِنْهَا لَمَا يَهْبِطُ مِنْ خَشْيَةِ اللَّهِ وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ","prev":{"a":73,"text":"فَقُلْنَا اضْرِبُوهُ بِبَعْضِهَا كَذَلِكَ يُحْيِي اللَّهُ الْمَوْتَى وَيُرِيكُمْ آيَاتِهِ لَعَلَّكُمْ تَعْقِلُونَ"},"next":{"a":75,"text":"أَفَتَطْمَعُونَ أَنْ يُؤْمِنُوا لَكُمْ وَقَدْ كَانَ فَرِيقٌ مِنْهُمْ يَسْمَعُونَ كَلَامَ اللَّهِ ثُمَّ يُحَرِّفُونَهُ مِنْ بَعْدِ مَا عَقَلُوهُ وَهُمْ يَعْلَمُونَ"},"context":"بعد قصة البقرة: قلوب بني إسرائيل قست كالحجارة أو أشد.","reason":"ختم وصف القسوة بنفي الغفلة؛ فقسوة القلب عمل يُحاسب عليه."},{"i":2,"of":9,"s":2,"surah":"البقرة","a":85,"text":"ثُمَّ أَنْتُمْ هَؤُلَاءِ تَقْتُلُونَ أَنْفُسَكُمْ وَتُخْرِجُونَ فَرِيقًا مِنْكُمْ مِنْ دِيَارِهِمْ تَظَاهَرُونَ عَلَيْهِمْ بِالْإِثْمِ وَالْعُدْوَانِ وَإِنْ يَأْتُوكُمْ أُسَارَى تُفَادُوهُمْ وَهُوَ مُحَرَّمٌ عَلَيْكُمْ إِخْرَاجُهُمْ أَفَتُؤْمِنُونَ بِبَعْضِ الْكِتَابِ وَتَكْفُرُونَ بِبَعْضٍ فَمَا جَزَاءُ مَنْ يَفْعَلُ ذَلِكَ مِنْكُمْ إِلَّا خِزْيٌ فِي الْحَيَاةِ الدُّنْيَا وَيَوْمَ الْقِيَامَةِ يُرَدُّونَ إِلَى أَشَدِّ الْعَذَابِ وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ","prev":{"a":84,"text":"وَإِذْ أَخَذْنَا مِيثَاقَكُمْ لَا تَسْفِكُونَ دِمَاءَكُمْ وَلَا تُخْرِجُونَ أَنْفُسَكُمْ مِنْ دِيَارِكُمْ ثُمَّ أَقْرَرْتُمْ وَأَنْتُمْ تَشْهَدُونَ"},"next":{"a":86,"text":"أُولَئِكَ الَّذِينَ اشْتَرَوُا الْحَيَاةَ الدُّنْيَا بِالْآخِرَةِ فَلَا يُخَفَّفُ عَنْهُمُ الْعَذَابُ وَلَا هُمْ يُنْصَرُونَ"},"context":"بنو إسرائيل يقتلون أنفسهم ويخرجون فريقًا من ديارهم، ويفادون الأسرى.","reason":"الإيمان ببعض الكتاب وترك بعضه لا يخفى على الله."},{"i":3,"of":9,"s":2,"surah":"البقرة","a":140,"text":"أَمْ تَقُولُونَ إِنَّ إِبْرَاهِيمَ وَإِسْمَاعِيلَ وَإِسْحَاقَ وَيَعْقُوبَ وَالْأَسْبَاطَ كَانُوا هُودًا أَوْ نَصَارَى قُلْ أَأَنْتُمْ أَعْلَمُ أَمِ اللَّهُ وَمَنْ أَظْلَمُ مِمَّنْ كَتَمَ شَهَادَةً عِنْدَهُ مِنَ اللَّهِ وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ","prev":{"a":139,"text":"قُلْ أَتُحَاجُّونَنَا فِي اللَّهِ وَهُوَ رَبُّنَا وَرَبُّكُمْ وَلَنَا أَعْمَالُنَا وَلَكُمْ أَعْمَالُكُمْ وَنَحْنُ لَهُ مُخْلِصُونَ"},"next":{"a":141,"text":"تِلْكَ أُمَّةٌ قَدْ خَلَتْ لَهَا مَا كَسَبَتْ وَلَكُمْ مَا كَسَبْتُمْ وَلَا تُسْأَلُونَ عَمَّا كَانُوا يَعْمَلُونَ"},"context":"المحاجة في ملة إبراهيم وادعاء أهل الكتاب أنه كان يهوديًّا أو نصرانيًّا.","reason":"كتمان الشهادة عمل خفي، فخُتم بأن الله لا يغفل عنه."},{"i":4,"of":9,"s":2,"surah":"البقرة","a":144,"text":"قَدْ نَرَى تَقَلُّبَ وَجْهِكَ فِي السَّمَاءِ فَلَنُوَلِّيَنَّكَ قِبْلَةً تَرْضَاهَا فَوَلِّ وَجْهَكَ شَطْرَ الْمَسْجِدِ الْحَرَامِ وَحَيْثُ مَا كُنْتُمْ فَوَلُّوا وُجُوهَكُمْ شَطْرَهُ وَإِنَّ الَّذِينَ أُوتُوا الْكِتَابَ لَيَعْلَمُونَ أَنَّهُ الْحَقُّ مِنْ رَبِّهِمْ وَمَا اللَّهُ بِغَافِلٍ عَمَّا يَعْمَلُونَ","prev":{"a":143,"text":"وَكَذَلِكَ جَعَلْنَاكُمْ أُمَّةً وَسَطًا لِتَكُونُوا شُهَدَاءَ عَلَى النَّاسِ وَيَكُونَ الرَّسُولُ عَلَيْكُمْ شَهِيدًا وَمَا جَعَلْنَا الْقِبْلَةَ الَّتِي كُنْتَ عَلَيْهَا إِلَّا لِنَعْلَمَ مَنْ يَتَّبِعُ الرَّسُولَ مِمَّنْ يَنْقَلِبُ عَلَى عَقِبَيْهِ وَإِنْ كَانَتْ لَكَبِيرَةً إِلَّا عَلَى الَّذِينَ هَدَى اللَّهُ وَمَا كَانَ اللَّهُ لِيُضِيعَ إِيمَانَكُمْ إِنَّ اللَّهَ بِالنَّاسِ لَرَءُوفٌ رَحِيمٌ"},"next":{"a":145,"text":"وَلَئِنْ أَتَيْتَ الَّذِينَ أُوتُوا الْكِتَابَ بِكُلِّ آيَةٍ مَا تَبِعُوا قِبْلَتَكَ وَمَا أَنْتَ بِتَابِعٍ قِبْلَتَهُمْ وَمَا بَعْضُهُمْ بِتَابِعٍ قِبْلَةَ بَعْضٍ وَلَئِنِ اتَّبَعْتَ أَهْوَاءَهُمْ مِنْ بَعْدِ مَا جَاءَكَ مِنَ الْعِلْمِ إِنَّكَ إِذًا لَمِنَ الظَّالِمِينَ"},"context":"تحويل القبلة إلى المسجد الحرام بعد تقلب وجه النبي ﷺ في السماء.","reason":"أهل الكتاب يعلمون أنه الحق ويكتمونه، والله لا يغفل عن عملهم."},{"i":5,"of":9,"s":2,"surah":"البقرة","a":149,"text":"وَمِنْ حَيْثُ خَرَجْتَ فَوَلِّ وَجْهَكَ شَطْرَ الْمَسْجِدِ الْحَرَامِ وَإِنَّهُ لَلْحَقُّ مِنْ رَبِّكَ وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ","prev":{"a":148,"text":"وَلِكُلٍّ وِجْهَةٌ هُوَ مُوَلِّيهَا فَاسْتَبِقُوا الْخَيْرَاتِ أَيْنَ مَا تَكُونُوا يَأْتِ بِكُمُ اللَّهُ جَمِيعًا إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},"next":{"a":150,"text":"وَمِنْ حَيْثُ خَرَجْتَ فَوَلِّ وَجْهَكَ شَطْرَ الْمَسْجِدِ الْحَرَامِ وَحَيْثُ مَا كُنْتُمْ فَوَلُّوا وُجُوهَكُمْ شَطْرَهُ لِئَلَّا يَكُونَ لِلنَّاسِ عَلَيْكُمْ حُجَّةٌ إِلَّا الَّذِينَ ظَلَمُوا مِنْهُمْ فَلَا تَخْشَوْهُمْ وَاخْشَوْنِي وَلِأُتِمَّ نِعْمَتِي عَلَيْكُمْ وَلَعَلَّكُمْ تَهْتَدُونَ"},"context":"تكرار الأمر بالتوجه إلى المسجد الحرام من حيث خرج.","reason":"بعد أمر الطاعة جاء النفي ليطمئن المطيع أن عمله محفوظ."},{"i":6,"of":9,"s":3,"surah":"آل عمران","a":99,"text":"قُلْ يَا أَهْلَ الْكِتَابِ لِمَ تَصُدُّونَ عَنْ سَبِيلِ اللَّهِ مَنْ آمَنَ تَبْغُونَهَا عِوَجًا وَأَنْتُمْ شُهَدَاءُ وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ","prev":{"a":98,"text":"قُلْ يَا أَهْلَ الْكِتَابِ لِمَ تَكْفُرُونَ بِآيَاتِ اللَّهِ وَاللَّهُ شَهِيدٌ عَلَى مَا تَعْمَلُونَ"},"next":{"a":100,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ تُطِيعُوا فَرِيقًا مِنَ الَّذِينَ أُوتُوا الْكِتَابَ يَرُدُّوكُمْ بَعْدَ إِيمَانِكُمْ كَافِرِينَ"},"context":"خطاب لأهل الكتاب الذين يصدون المؤمنين عن سبيل الله.","reason":"الصد عن السبيل عمل مستتر بالشبهات، والله شاهد عليه."},{"i":7,"of":9,"s":6,"surah":"الأنعام","a":132,"text":"وَلِكُلٍّ دَرَجَاتٌ مِمَّا عَمِلُوا وَمَا رَبُّكَ بِغَافِلٍ عَمَّا يَعْمَلُونَ","prev":{"a":131,"text":"ذَلِكَ أَنْ لَمْ يَكُنْ رَبُّكَ مُهْلِكَ الْقُرَى بِظُلْمٍ وَأَهْلُهَا غَافِلُونَ"},"next":{"a":133,"text":"وَرَبُّكَ الْغَنِيُّ ذُو الرَّحْمَةِ إِنْ يَشَأْ يُذْهِبْكُمْ وَيَسْتَخْلِفْ مِنْ بَعْدِكُمْ مَا يَشَاءُ كَمَا أَنْشَأَكُمْ مِنْ ذُرِّيَّةِ قَوْمٍ آخَرِينَ"},"context":"بعد ذكر الجن والإنس وأن الله لا يهلك القرى بظلم.","reason":"لكل درجات بحسب عمله، ولا يضيع منها شيء لأنه لا يغفل."},{"i":8,"of":9,"s":11,"surah":"هود","a":123,"text":"وَلِلَّهِ غَيْبُ السَّمَاوَاتِ وَالْأَرْضِ وَإِلَيْهِ يُرْجَعُ الْأَمْرُ كُلُّهُ فَاعْبُدْهُ وَتَوَكَّلْ عَلَيْهِ وَمَا رَبُّكَ بِغَافِلٍ عَمَّا تَعْمَلُونَ","prev":{"a":122,"text":"وَانْتَظِرُوا إِنَّا مُنْتَظِرُونَ"},"context":"خاتمة هود بعد قصص الأنبياء وأقوامهم.","reason":"جمعت الآية الغيب والرجوع والأمر بالعبادة والتوكل، ثم ختمت بنفي الغفلة."},{"i":9,"of":9,"s":27,"surah":"النمل","a":93,"text":"وَقُلِ الْحَمْدُ لِلَّهِ سَيُرِيكُمْ آيَاتِهِ فَتَعْرِفُونَهَا وَمَا رَبُّكَ بِغَافِلٍ عَمَّا تَعْمَلُونَ","prev":{"a":92,"text":"وَأَنْ أَتْلُوَ الْقُرْآنَ فَمَنِ اهْتَدَى فَإِنَّمَا يَهْتَدِي لِنَفْسِهِ وَمَنْ ضَلَّ فَقُلْ إِنَّمَا أَنَا مِنَ الْمُنْذِرِينَ"},"context":"خاتمة النمل: الأمر بالحمد ووعدٌ بإراءة الآيات.","reason":"بعد الوعد بالآيات جاء التذكير بأن الله يرى عمل كل أحد."}],"hadiths":[],"situations":[{"situationId":73,"verses":[{"i":9,"strength":"direct","bridge":"احمد الله وانتظر آياته، واعلم أن ﴿وَمَا رَبُّكَ بِغَافِلٍ عَمَّا تَعْمَلُونَ﴾."}],"hadiths":[]},{"situationId":76,"verses":[{"i":7,"strength":"direct","bridge":"لا تستصغر عملك؛ ﴿وَلِكُلٍّ دَرَجَاتٌ مِمَّا عَمِلُوا وَمَا رَبُّكَ بِغَافِلٍ عَمَّا يَعْمَلُونَ﴾."}],"hadiths":[]},{"situationId":87,"verses":[{"i":1,"strength":"direct","bridge":"إذا شعرت بقسوة قلبك فلا تطمئن لها؛ ﴿وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ﴾."}],"hadiths":[]},{"situationId":102,"verses":[{"i":8,"strength":"direct","bridge":"اعبده وتوكل عليه ولا تقلق على أجرك؛ ﴿وَمَا رَبُّكَ بِغَافِلٍ عَمَّا تَعْمَلُونَ﴾."}],"hadiths":[]},{"situationId":119,"verses":[{"i":2,"strength":"direct","bridge":"لا تأخذ من الدين ما يوافقك وتترك الباقي؛ ﴿وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ﴾."}],"hadiths":[]},{"situationId":121,"verses":[{"i":3,"strength":"direct","bridge":"من كتم شهادة يعلمها فليذكر: ﴿وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ﴾."},{"i":4,"strength":"direct","bridge":"من عرف الحق وأعرض عنه فليعلم ﴿وَمَا اللَّهُ بِغَافِلٍ عَمَّا يَعْمَلُونَ﴾."}],"hadiths":[]},{"situationId":139,"verses":[{"i":6,"strength":"direct","bridge":"إن رأيت من يصد عن الدين ويشوّهه، فـ﴿وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ﴾."}],"hadiths":[]},{"situationId":171,"verses":[{"i":5,"strength":"direct","bridge":"إذا أطعت في أمر لم يره أحد، فـ﴿مَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ﴾."}],"hadiths":[]}]},{"id":206,"name":"حسبنا الله / حسبي الله / حسبك الله / فهو حسبه","compound":true,"meaning":"حسبنا الله: الله كافينا؛ والحسب هو الكافي الذي لا يُحتاج معه إلى غيره.","teaches":"1. قالها المؤمنون حين خُوّفوا بجمع الناس، فزادتهم إيمانًا (آل عمران 173).\n2. تُقال عند التخويف، والخداع، والإعراض، والرضا بالقسمة.\n3. جزاؤها في الطلاق 3: من توكل على الله فهو حسبه.","whenRecall":"- حين يُخوَّفك الناس بكثرة عدوّك.\n- حين تخشى الخداع.\n- حين يُعرض عنك من دعوته.\n- حين لا ترضى بما أُعطيت.","whenPray":"1. ﴿حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ﴾ — آل عمران 173.\n2. ﴿حَسْبِيَ اللَّهُ لَا إِلَهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ﴾ — التوبة 129.","summary":"كلمة القلب حين يُخوَّف أو يُخدع أو يُترك: الله يكفيني.","verses":[{"i":1,"of":7,"s":3,"surah":"آل عمران","a":173,"text":"الَّذِينَ قَالَ لَهُمُ النَّاسُ إِنَّ النَّاسَ قَدْ جَمَعُوا لَكُمْ فَاخْشَوْهُمْ فَزَادَهُمْ إِيمَانًا وَقَالُوا حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ","prev":{"a":172,"text":"الَّذِينَ اسْتَجَابُوا لِلَّهِ وَالرَّسُولِ مِنْ بَعْدِ مَا أَصَابَهُمُ الْقَرْحُ لِلَّذِينَ أَحْسَنُوا مِنْهُمْ وَاتَّقَوْا أَجْرٌ عَظِيمٌ"},"next":{"a":174,"text":"فَانْقَلَبُوا بِنِعْمَةٍ مِنَ اللَّهِ وَفَضْلٍ لَمْ يَمْسَسْهُمْ سُوءٌ وَاتَّبَعُوا رِضْوَانَ اللَّهِ وَاللَّهُ ذُو فَضْلٍ عَظِيمٍ"},"context":"بعد أحد، خُوّف المؤمنون بأن قريشًا جمعت لهم.","reason":"التخويف زادهم إيمانًا، فقالوا كلمة الكفاية."},{"i":2,"of":7,"s":8,"surah":"الأنفال","a":62,"text":"وَإِنْ يُرِيدُوا أَنْ يَخْدَعُوكَ فَإِنَّ حَسْبَكَ اللَّهُ هُوَ الَّذِي أَيَّدَكَ بِنَصْرِهِ وَبِالْمُؤْمِنِينَ","prev":{"a":61,"text":"وَإِنْ جَنَحُوا لِلسَّلْمِ فَاجْنَحْ لَهَا وَتَوَكَّلْ عَلَى اللَّهِ إِنَّهُ هُوَ السَّمِيعُ الْعَلِيمُ"},"next":{"a":63,"text":"وَأَلَّفَ بَيْنَ قُلُوبِهِمْ لَوْ أَنْفَقْتَ مَا فِي الْأَرْضِ جَمِيعًا مَا أَلَّفْتَ بَيْنَ قُلُوبِهِمْ وَلَكِنَّ اللَّهَ أَلَّفَ بَيْنَهُمْ إِنَّهُ عَزِيزٌ حَكِيمٌ"},"context":"بعد الأمر بالجنوح للسلم إن جنح له العدو.","reason":"خشية أن يكون الصلح خديعة، فطمأنه بأن الله كافيه."},{"i":3,"of":7,"s":8,"surah":"الأنفال","a":64,"text":"يَا أَيُّهَا النَّبِيُّ حَسْبُكَ اللَّهُ وَمَنِ اتَّبَعَكَ مِنَ الْمُؤْمِنِينَ","prev":{"a":63,"text":"وَأَلَّفَ بَيْنَ قُلُوبِهِمْ لَوْ أَنْفَقْتَ مَا فِي الْأَرْضِ جَمِيعًا مَا أَلَّفْتَ بَيْنَ قُلُوبِهِمْ وَلَكِنَّ اللَّهَ أَلَّفَ بَيْنَهُمْ إِنَّهُ عَزِيزٌ حَكِيمٌ"},"next":{"a":65,"text":"يَا أَيُّهَا النَّبِيُّ حَرِّضِ الْمُؤْمِنِينَ عَلَى الْقِتَالِ إِنْ يَكُنْ مِنْكُمْ عِشْرُونَ صَابِرُونَ يَغْلِبُوا مِائَتَيْنِ وَإِنْ يَكُنْ مِنْكُمْ مِائَةٌ يَغْلِبُوا أَلْفًا مِنَ الَّذِينَ كَفَرُوا بِأَنَّهُمْ قَوْمٌ لَا يَفْقَهُونَ"},"context":"سياق القتال وقلة المؤمنين أمام عدوهم.","reason":"الكفاية للنبي ﷺ ولمن اتبعه؛ فالقلة لا تخيف مع كفاية الله."},{"i":4,"of":7,"s":9,"surah":"التوبة","a":59,"text":"وَلَوْ أَنَّهُمْ رَضُوا مَا آتَاهُمُ اللَّهُ وَرَسُولُهُ وَقَالُوا حَسْبُنَا اللَّهُ سَيُؤْتِينَا اللَّهُ مِنْ فَضْلِهِ وَرَسُولُهُ إِنَّا إِلَى اللَّهِ رَاغِبُونَ","prev":{"a":58,"text":"وَمِنْهُمْ مَنْ يَلْمِزُكَ فِي الصَّدَقَاتِ فَإِنْ أُعْطُوا مِنْهَا رَضُوا وَإِنْ لَمْ يُعْطَوْا مِنْهَا إِذَا هُمْ يَسْخَطُونَ"},"next":{"a":60,"text":"إِنَّمَا الصَّدَقَاتُ لِلْفُقَرَاءِ وَالْمَسَاكِينِ وَالْعَامِلِينَ عَلَيْهَا وَالْمُؤَلَّفَةِ قُلُوبُهُمْ وَفِي الرِّقَابِ وَالْغَارِمِينَ وَفِي سَبِيلِ اللَّهِ وَابْنِ السَّبِيلِ فَرِيضَةً مِنَ اللَّهِ وَاللَّهُ عَلِيمٌ حَكِيمٌ"},"context":"المنافقون يلمزون النبي ﷺ في قسمة الصدقات.","reason":"أرشدهم إلى الرضا وقول حسبنا الله والرغبة إليه بدل الاعتراض."},{"i":5,"of":7,"s":9,"surah":"التوبة","a":129,"text":"فَإِنْ تَوَلَّوْا فَقُلْ حَسْبِيَ اللَّهُ لَا إِلَهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ","prev":{"a":128,"text":"لَقَدْ جَاءَكُمْ رَسُولٌ مِنْ أَنْفُسِكُمْ عَزِيزٌ عَلَيْهِ مَا عَنِتُّمْ حَرِيصٌ عَلَيْكُمْ بِالْمُؤْمِنِينَ رَءُوفٌ رَحِيمٌ"},"context":"آخر التوبة بعد وصف حرص النبي ﷺ على أمته.","reason":"إن أعرضوا بعد كل هذا الحرص، فالله كافيه."},{"i":6,"of":7,"s":39,"surah":"الزمر","a":38,"text":"وَلَئِنْ سَأَلْتَهُمْ مَنْ خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ لَيَقُولُنَّ اللَّهُ قُلْ أَفَرَأَيْتُمْ مَا تَدْعُونَ مِنْ دُونِ اللَّهِ إِنْ أَرَادَنِيَ اللَّهُ بِضُرٍّ هَلْ هُنَّ كَاشِفَاتُ ضُرِّهِ أَوْ أَرَادَنِي بِرَحْمَةٍ هَلْ هُنَّ مُمْسِكَاتُ رَحْمَتِهِ قُلْ حَسْبِيَ اللَّهُ عَلَيْهِ يَتَوَكَّلُ الْمُتَوَكِّلُونَ","prev":{"a":37,"text":"وَمَنْ يَهْدِ اللَّهُ فَمَا لَهُ مِنْ مُضِلٍّ أَلَيْسَ اللَّهُ بِعَزِيزٍ ذِي انْتِقَامٍ"},"next":{"a":39,"text":"قُلْ يَا قَوْمِ اعْمَلُوا عَلَى مَكَانَتِكُمْ إِنِّي عَامِلٌ فَسَوْفَ تَعْلَمُونَ"},"context":"المشركون يقرّون بأن الله خالق السماوات، ثم يدعون من دونه.","reason":"الآلهة لا تكشف ضرًّا ولا تمسك رحمة، فلا كافي إلا الله."},{"i":7,"of":7,"s":65,"surah":"الطلاق","a":3,"text":"وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ وَمَنْ يَتَوَكَّلْ عَلَى اللَّهِ فَهُوَ حَسْبُهُ إِنَّ اللَّهَ بَالِغُ أَمْرِهِ قَدْ جَعَلَ اللَّهُ لِكُلِّ شَيْءٍ قَدْرًا","prev":{"a":2,"text":"فَإِذَا بَلَغْنَ أَجَلَهُنَّ فَأَمْسِكُوهُنَّ بِمَعْرُوفٍ أَوْ فَارِقُوهُنَّ بِمَعْرُوفٍ وَأَشْهِدُوا ذَوَيْ عَدْلٍ مِنْكُمْ وَأَقِيمُوا الشَّهَادَةَ لِلَّهِ ذَلِكُمْ يُوعَظُ بِهِ مَنْ كَانَ يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مَخْرَجًا"},"next":{"a":4,"text":"وَاللَّائِي يَئِسْنَ مِنَ الْمَحِيضِ مِنْ نِسَائِكُمْ إِنِ ارْتَبْتُمْ فَعِدَّتُهُنَّ ثَلَاثَةُ أَشْهُرٍ وَاللَّائِي لَمْ يَحِضْنَ وَأُولَاتُ الْأَحْمَالِ أَجَلُهُنَّ أَنْ يَضَعْنَ حَمْلَهُنَّ وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مِنْ أَمْرِهِ يُسْرًا"},"context":"الطلاق: الأمر بالتقوى، ووعد المخرج والرزق.","reason":"جزاء التوكل أن يكون الله حسب المتوكل، وأمره نافذ."}],"hadiths":[{"i":1,"of":2,"text":"عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهُما، قالَ: آخِرُ كلامِ إبراهيمَ حين أُلقِيَ في النَّارِ: حَسْبيَ اللهُ ونِعْمَ الوكيلُ، وقالَ نبِيُّكُم صلَّى اللهُ عليه وسلَّمَ مِثلَها: {الَّذِينَ قَالَ لَهُمُ النَّاسُ إِنَّ النَّاسَ قَدْ جَمَعُوا لَكُمْ فَاخْشَوْهُمْ فَزَادَهُمْ إِيمَانًا وَقَالُوا حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ} [آل عمران: 173].","narrator":"أبو الضحى","source":"المستدرك على الصحيحين 3208","grade":"صحيح","judgment":"صحيح على شرط الشيخين","url":"https://dorar.net/h/IMnKSEJR","nameForm":"حسبنا الله / حسبي الله / حسبك الله / فهو حسبه"},{"i":2,"of":2,"text":"مَن قال في كلِّ يومٍ حينَ يُصبِحُ وحينَ يُمْسي: حَسبيَ اللهُ لا إلهَ إلَّا هو، عليه تَوكَّلْتُ، وهو ربُّ العَرشِ العَظيمِ، سَبعَ مراتٍ، كَفاه اللهُ ما أهَمَّه من أمرِ الدُّنيا والآخِرةِ.","narrator":"أبو الدرداء","source":"تخريج زاد المعاد 2/342","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/Ftqgc7p2","nameForm":"حسبنا الله / حسبي الله / حسبك الله / فهو حسبه"}],"sunnah":{},"situations":[{"situationId":31,"verses":[{"i":3,"strength":"direct","bridge":"إن قلّ من معك، فـ﴿حَسْبُكَ اللَّهُ وَمَنِ اتَّبَعَكَ مِنَ الْمُؤْمِنِينَ﴾."}],"hadiths":[]},{"situationId":33,"verses":[{"i":1,"strength":"direct","bridge":"إذا قيل لك إن الناس قد جمعوا لك، فقل: ﴿حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ﴾."}],"hadiths":[]},{"situationId":39,"verses":[{"i":7,"strength":"direct","bridge":"إذا ضاق رزقك بعد فراق أو أزمة، ﴿وَمَنْ يَتَوَكَّلْ عَلَى اللَّهِ فَهُوَ حَسْبُهُ﴾."}],"hadiths":[]},{"situationId":69,"verses":[{"i":2,"strength":"direct","bridge":"إن خفت أن يُخدعك من صالحته، ﴿فَإِنَّ حَسْبَكَ اللَّهُ﴾."}],"hadiths":[]},{"situationId":84,"verses":[{"i":4,"strength":"direct","bridge":"إن لم ترضَ بما قُسم لك، فقل: ﴿حَسْبُنَا اللَّهُ سَيُؤْتِينَا اللَّهُ مِنْ فَضْلِهِ﴾."}],"hadiths":[]},{"situationId":94,"verses":[{"i":6,"strength":"direct","bridge":"من تعلّق بغير الله ليكشف ضره فليعلم أنهم لا يملكون ذلك؛ ﴿قُلْ حَسْبِيَ اللَّهُ﴾."}],"hadiths":[]},{"situationId":130,"verses":[{"i":5,"strength":"direct","bridge":"إذا أعرض عنك من حرصت عليه، ﴿فَقُلْ حَسْبِيَ اللَّهُ لَا إِلَهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ﴾."}],"hadiths":[]}]},{"id":207,"name":"إلهٌ واحدٌ","compound":true,"meaning":"إلهٌ واحد: المعبود بحق واحدٌ لا شريك له، لا يستحق العبادة غيره.","teaches":"1. تأتي ردًّا على التعدد: التثليث، والإلهين، والآلهة مع الله.\n2. يتبعها غالبًا أمرٌ عملي: الإسلام له، الاستقامة إليه، العمل الصالح بلا شرك.\n3. وحدانيته مقرونة بالرحمة (البقرة 163).","whenRecall":"- حين يتوزع قلبك بين أكثر من مقصود.\n- حين تسمع الشرك أو التثليث.\n- قبل أن تعمل عملًا تريد به الله.","whenPray":"1. أن تستفتح دعاءك بالتوحيد: لا إله إلا أنت.","summary":"إلهك واحد؛ فاجعل قصدك واحدًا وعملك له وحده.","verses":[{"i":1,"of":11,"s":2,"surah":"البقرة","a":163,"text":"وَإِلَهُكُمْ إِلَهٌ وَاحِدٌ لَا إِلَهَ إِلَّا هُوَ الرَّحْمَنُ الرَّحِيمُ","prev":{"a":162,"text":"خَالِدِينَ فِيهَا لَا يُخَفَّفُ عَنْهُمُ الْعَذَابُ وَلَا هُمْ يُنْظَرُونَ"},"next":{"a":164,"text":"إِنَّ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ وَاخْتِلَافِ اللَّيْلِ وَالنَّهَارِ وَالْفُلْكِ الَّتِي تَجْرِي فِي الْبَحْرِ بِمَا يَنْفَعُ النَّاسَ وَمَا أَنْزَلَ اللَّهُ مِنَ السَّمَاءِ مِنْ مَاءٍ فَأَحْيَا بِهِ الْأَرْضَ بَعْدَ مَوْتِهَا وَبَثَّ فِيهَا مِنْ كُلِّ دَابَّةٍ وَتَصْرِيفِ الرِّيَاحِ وَالسَّحَابِ الْمُسَخَّرِ بَيْنَ السَّمَاءِ وَالْأَرْضِ لَآيَاتٍ لِقَوْمٍ يَعْقِلُونَ"},"context":"بعد ذكر عذاب الكافرين الذين ماتوا على كفرهم.","reason":"بعد الوعيد ذكر التوحيد مقرونًا بالرحمة، فالباب مفتوح لمن وحّد."},{"i":2,"of":11,"s":4,"surah":"النساء","a":171,"text":"يَا أَهْلَ الْكِتَابِ لَا تَغْلُوا فِي دِينِكُمْ وَلَا تَقُولُوا عَلَى اللَّهِ إِلَّا الْحَقَّ إِنَّمَا الْمَسِيحُ عِيسَى ابْنُ مَرْيَمَ رَسُولُ اللَّهِ وَكَلِمَتُهُ أَلْقَاهَا إِلَى مَرْيَمَ وَرُوحٌ مِنْهُ فَآمِنُوا بِاللَّهِ وَرُسُلِهِ وَلَا تَقُولُوا ثَلَاثَةٌ انْتَهُوا خَيْرًا لَكُمْ إِنَّمَا اللَّهُ إِلَهٌ وَاحِدٌ سُبْحَانَهُ أَنْ يَكُونَ لَهُ وَلَدٌ لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَفَى بِاللَّهِ وَكِيلًا","prev":{"a":170,"text":"يَا أَيُّهَا النَّاسُ قَدْ جَاءَكُمُ الرَّسُولُ بِالْحَقِّ مِنْ رَبِّكُمْ فَآمِنُوا خَيْرًا لَكُمْ وَإِنْ تَكْفُرُوا فَإِنَّ لِلَّهِ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ وَكَانَ اللَّهُ عَلِيمًا حَكِيمًا"},"next":{"a":172,"text":"لَنْ يَسْتَنْكِفَ الْمَسِيحُ أَنْ يَكُونَ عَبْدًا لِلَّهِ وَلَا الْمَلَائِكَةُ الْمُقَرَّبُونَ وَمَنْ يَسْتَنْكِفْ عَنْ عِبَادَتِهِ وَيَسْتَكْبِرْ فَسَيَحْشُرُهُمْ إِلَيْهِ جَمِيعًا"},"context":"نهي أهل الكتاب عن الغلو في المسيح والقول بالتثليث.","reason":"نفى التثليث صراحة وأثبت الوحدانية والتنزيه عن الولد."},{"i":3,"of":11,"s":5,"surah":"المائدة","a":73,"text":"لَقَدْ كَفَرَ الَّذِينَ قَالُوا إِنَّ اللَّهَ ثَالِثُ ثَلَاثَةٍ وَمَا مِنْ إِلَهٍ إِلَّا إِلَهٌ وَاحِدٌ وَإِنْ لَمْ يَنْتَهُوا عَمَّا يَقُولُونَ لَيَمَسَّنَّ الَّذِينَ كَفَرُوا مِنْهُمْ عَذَابٌ أَلِيمٌ","prev":{"a":72,"text":"لَقَدْ كَفَرَ الَّذِينَ قَالُوا إِنَّ اللَّهَ هُوَ الْمَسِيحُ ابْنُ مَرْيَمَ وَقَالَ الْمَسِيحُ يَا بَنِي إِسْرَائِيلَ اعْبُدُوا اللَّهَ رَبِّي وَرَبَّكُمْ إِنَّهُ مَنْ يُشْرِكْ بِاللَّهِ فَقَدْ حَرَّمَ اللَّهُ عَلَيْهِ الْجَنَّةَ وَمَأْوَاهُ النَّارُ وَمَا لِلظَّالِمِينَ مِنْ أَنْصَارٍ"},"next":{"a":74,"text":"أَفَلَا يَتُوبُونَ إِلَى اللَّهِ وَيَسْتَغْفِرُونَهُ وَاللَّهُ غَفُورٌ رَحِيمٌ"},"context":"قبلها كفر من قال إن الله هو المسيح.","reason":"حصر الألوهية في إله واحد ردًّا على قول ثالث ثلاثة."},{"i":4,"of":11,"s":6,"surah":"الأنعام","a":19,"text":"قُلْ أَيُّ شَيْءٍ أَكْبَرُ شَهَادَةً قُلِ اللَّهُ شَهِيدٌ بَيْنِي وَبَيْنَكُمْ وَأُوحِيَ إِلَيَّ هَذَا الْقُرْآنُ لِأُنْذِرَكُمْ بِهِ وَمَنْ بَلَغَ أَئِنَّكُمْ لَتَشْهَدُونَ أَنَّ مَعَ اللَّهِ آلِهَةً أُخْرَى قُلْ لَا أَشْهَدُ قُلْ إِنَّمَا هُوَ إِلَهٌ وَاحِدٌ وَإِنَّنِي بَرِيءٌ مِمَّا تُشْرِكُونَ","prev":{"a":18,"text":"وَهُوَ الْقَاهِرُ فَوْقَ عِبَادِهِ وَهُوَ الْحَكِيمُ الْخَبِيرُ"},"next":{"a":20,"text":"الَّذِينَ آتَيْنَاهُمُ الْكِتَابَ يَعْرِفُونَهُ كَمَا يَعْرِفُونَ أَبْنَاءَهُمُ الَّذِينَ خَسِرُوا أَنْفُسَهُمْ فَهُمْ لَا يُؤْمِنُونَ"},"context":"قبلها: وهو القاهر فوق عباده، ثم سؤال عن أكبر شهادة.","reason":"أمره أن يعلن البراءة من الشرك ويشهد بالتوحيد أمام قومه."},{"i":5,"of":11,"s":14,"surah":"إبراهيم","a":52,"text":"هَذَا بَلَاغٌ لِلنَّاسِ وَلِيُنْذَرُوا بِهِ وَلِيَعْلَمُوا أَنَّمَا هُوَ إِلَهٌ وَاحِدٌ وَلِيَذَّكَّرَ أُولُو الْأَلْبَابِ","prev":{"a":51,"text":"لِيَجْزِيَ اللَّهُ كُلَّ نَفْسٍ مَا كَسَبَتْ إِنَّ اللَّهَ سَرِيعُ الْحِسَابِ"},"context":"ختام سورة إبراهيم بعد مشاهد الحساب.","reason":"غاية البلاغ كله أن يعلم الناس أنه إله واحد ويتذكروا."},{"i":6,"of":11,"s":16,"surah":"النحل","a":22,"text":"إِلَهُكُمْ إِلَهٌ وَاحِدٌ فَالَّذِينَ لَا يُؤْمِنُونَ بِالْآخِرَةِ قُلُوبُهُمْ مُنْكِرَةٌ وَهُمْ مُسْتَكْبِرُونَ","prev":{"a":21,"text":"أَمْوَاتٌ غَيْرُ أَحْيَاءٍ وَمَا يَشْعُرُونَ أَيَّانَ يُبْعَثُونَ"},"next":{"a":23,"text":"لَا جَرَمَ أَنَّ اللَّهَ يَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِنُونَ إِنَّهُ لَا يُحِبُّ الْمُسْتَكْبِرِينَ"},"context":"قبلها: الأصنام أموات لا يشعرون متى يُبعثون.","reason":"بعد بيان عجز الأصنام، قرر الوحدانية وكشف أن العلة إنكار الآخرة والاستكبار."},{"i":7,"of":11,"s":16,"surah":"النحل","a":51,"text":"وَقَالَ اللَّهُ لَا تَتَّخِذُوا إِلَهَيْنِ اثْنَيْنِ إِنَّمَا هُوَ إِلَهٌ وَاحِدٌ فَإِيَّايَ فَارْهَبُونِ","prev":{"a":50,"text":"يَخَافُونَ رَبَّهُمْ مِنْ فَوْقِهِمْ وَيَفْعَلُونَ مَا يُؤْمَرُونَ"},"next":{"a":52,"text":"وَلَهُ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ وَلَهُ الدِّينُ وَاصِبًا أَفَغَيْرَ اللَّهِ تَتَّقُونَ"},"context":"قبلها: الملائكة يخافون ربهم من فوقهم.","reason":"نهى عن اتخاذ إلهين وأمر بأن يكون الخوف منه وحده."},{"i":8,"of":11,"s":18,"surah":"الكهف","a":110,"text":"قُلْ إِنَّمَا أَنَا بَشَرٌ مِثْلُكُمْ يُوحَى إِلَيَّ أَنَّمَا إِلَهُكُمْ إِلَهٌ وَاحِدٌ فَمَنْ كَانَ يَرْجُو لِقَاءَ رَبِّهِ فَلْيَعْمَلْ عَمَلًا صَالِحًا وَلَا يُشْرِكْ بِعِبَادَةِ رَبِّهِ أَحَدًا","prev":{"a":109,"text":"قُلْ لَوْ كَانَ الْبَحْرُ مِدَادًا لِكَلِمَاتِ رَبِّي لَنَفِدَ الْبَحْرُ قَبْلَ أَنْ تَنْفَدَ كَلِمَاتُ رَبِّي وَلَوْ جِئْنَا بِمِثْلِهِ مَدَدًا"},"context":"ختام الكهف بعد ذكر كلمات الله التي لا تنفد.","reason":"التوحيد يُترجم إلى عملٍ صالح لا شرك فيه لمن يرجو لقاء ربه."},{"i":9,"of":11,"s":21,"surah":"الأنبياء","a":108,"text":"قُلْ إِنَّمَا يُوحَى إِلَيَّ أَنَّمَا إِلَهُكُمْ إِلَهٌ وَاحِدٌ فَهَلْ أَنْتُمْ مُسْلِمُونَ","prev":{"a":107,"text":"وَمَا أَرْسَلْنَاكَ إِلَّا رَحْمَةً لِلْعَالَمِينَ"},"next":{"a":109,"text":"فَإِنْ تَوَلَّوْا فَقُلْ آذَنْتُكُمْ عَلَى سَوَاءٍ وَإِنْ أَدْرِي أَقَرِيبٌ أَمْ بَعِيدٌ مَا تُوعَدُونَ"},"context":"بعد ذكر إرسال النبي ﷺ رحمة للعالمين.","reason":"خلاصة الوحي التوحيد، ثم السؤال: هل أنتم مسلمون؟"},{"i":10,"of":11,"s":22,"surah":"الحج","a":34,"text":"وَلِكُلِّ أُمَّةٍ جَعَلْنَا مَنْسَكًا لِيَذْكُرُوا اسْمَ اللَّهِ عَلَى مَا رَزَقَهُمْ مِنْ بَهِيمَةِ الْأَنْعَامِ فَإِلَهُكُمْ إِلَهٌ وَاحِدٌ فَلَهُ أَسْلِمُوا وَبَشِّرِ الْمُخْبِتِينَ","prev":{"a":33,"text":"لَكُمْ فِيهَا مَنَافِعُ إِلَى أَجَلٍ مُسَمًّى ثُمَّ مَحِلُّهَا إِلَى الْبَيْتِ الْعَتِيقِ"},"next":{"a":35,"text":"الَّذِينَ إِذَا ذُكِرَ اللَّهُ وَجِلَتْ قُلُوبُهُمْ وَالصَّابِرِينَ عَلَى مَا أَصَابَهُمْ وَالْمُقِيمِي الصَّلَاةِ وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ"},"context":"سياق المناسك وذكر اسم الله على الأنعام.","reason":"تعدد المناسك بين الأمم لا يعني تعدد المعبود؛ فالإله واحد فأسلموا له."},{"i":11,"of":11,"s":41,"surah":"فصلت","a":6,"text":"قُلْ إِنَّمَا أَنَا بَشَرٌ مِثْلُكُمْ يُوحَى إِلَيَّ أَنَّمَا إِلَهُكُمْ إِلَهٌ وَاحِدٌ فَاسْتَقِيمُوا إِلَيْهِ وَاسْتَغْفِرُوهُ وَوَيْلٌ لِلْمُشْرِكِينَ","prev":{"a":5,"text":"وَقَالُوا قُلُوبُنَا فِي أَكِنَّةٍ مِمَّا تَدْعُونَا إِلَيْهِ وَفِي آذَانِنَا وَقْرٌ وَمِنْ بَيْنِنَا وَبَيْنِكَ حِجَابٌ فَاعْمَلْ إِنَّنَا عَامِلُونَ"},"next":{"a":7,"text":"الَّذِينَ لَا يُؤْتُونَ الزَّكَاةَ وَهُمْ بِالْآخِرَةِ هُمْ كَافِرُونَ"},"context":"قبلها قول المشركين: قلوبنا في أكنة.","reason":"قابل إعراضهم بتواضع البشرية وبيان التوحيد والأمر بالاستقامة والاستغفار."}],"hadiths":[{"i":1,"of":1,"text":"قدمَ [ عديُّ بنُ حاتمٍ ] على النَّبيِّ صلَّى اللهُ عليهِ وسلَّمَ وهو نصرانيٌّ فسمعه يقرأُ هذه الآيةَ :  اتَّخَذُوا أَحْبَارَهُمْ وَرُهْبَانَهُمْ أَرْبَابًا مِنْ دُونِ اللَّهِ وَالْمَسِيحَ ابْنَ مَرْيَمَ وَمَا أُمِرُوا إِلَّا لِيَعْبُدُوا إِلَهًا وَاحِدًا لَا إِلَهَ إِلَّا هُوَ سُبْحَانَهُ عَمَّا يُشْرِكُونَ قال : فقلتُ له : إنَّا لسنا نعبدُهم ، قال : أليسَ يحرمونَ ما أحلَّ اللهُ فتحرِّمونَه ، ويحلُّونَ ما حرَّمَ اللهُ فتحلُّونَه ، قال : قلتُ : بلى ، قال : فتلك عبادتُهم","narrator":"عدي بن حاتم الطائي","source":"حقيقة الإسلام و الإيمان 111","grade":"حسن","url":"https://dorar.net/h/iDciFrcm","nameForm":"إلهٌ واحدٌ"}],"sunnah":{},"situations":[{"situationId":19,"verses":[{"i":1,"strength":"direct","bridge":"بعد كل وعيد يبقى باب الرحمة: ﴿وَإِلَهُكُمْ إِلَهٌ وَاحِدٌ لَا إِلَهَ إِلَّا هُوَ الرَّحْمَنُ الرَّحِيمُ﴾."}],"hadiths":[]},{"situationId":94,"verses":[{"i":7,"strength":"direct","bridge":"إن تقاسم قلبَك خوفان، فالأمر: ﴿إِنَّمَا هُوَ إِلَهٌ وَاحِدٌ فَإِيَّايَ فَارْهَبُونِ﴾."}],"hadiths":[]},{"situationId":106,"verses":[{"i":2,"strength":"direct","bridge":"إن عُرضت عليك شبهة التثليث فالجواب: ﴿إِنَّمَا اللَّهُ إِلَهٌ وَاحِدٌ سُبْحَانَهُ أَنْ يَكُونَ لَهُ وَلَدٌ﴾."},{"i":3,"strength":"direct","bridge":"﴿وَمَا مِنْ إِلَهٍ إِلَّا إِلَهٌ وَاحِدٌ﴾ تقطع كل قولٍ بتعدد الآلهة."}],"hadiths":[]},{"situationId":110,"verses":[{"i":5,"strength":"direct","bridge":"كل ما في القرآن من إنذار غايته ﴿وَلِيَعْلَمُوا أَنَّمَا هُوَ إِلَهٌ وَاحِدٌ﴾."}],"hadiths":[]},{"situationId":119,"verses":[{"i":9,"strength":"direct","bridge":"خلاصة الرسالة في كلمة: ﴿أَنَّمَا إِلَهُكُمْ إِلَهٌ وَاحِدٌ فَهَلْ أَنْتُمْ مُسْلِمُونَ﴾."}],"hadiths":[]},{"situationId":122,"verses":[{"i":6,"strength":"direct","bridge":"إن رأيت من ينكر الحق مستكبرًا، فالعلة في القلب: ﴿قُلُوبُهُمْ مُنْكِرَةٌ وَهُمْ مُسْتَكْبِرُونَ﴾."}],"hadiths":[]},{"situationId":130,"verses":[{"i":11,"strength":"direct","bridge":"إن قست قلوب من تدعوهم فبلّغ: ﴿فَاسْتَقِيمُوا إِلَيْهِ وَاسْتَغْفِرُوهُ﴾."}],"hadiths":[]},{"situationId":132,"verses":[{"i":4,"strength":"direct","bridge":"إذا دعوت قومك فقل كما قيل: ﴿إِنَّمَا هُوَ إِلَهٌ وَاحِدٌ وَإِنَّنِي بَرِيءٌ مِمَّا تُشْرِكُونَ﴾."}],"hadiths":[]},{"situationId":169,"verses":[{"i":8,"strength":"direct","bridge":"من رجا لقاء ربه فليصلح عمله: ﴿وَلَا يُشْرِكْ بِعِبَادَةِ رَبِّهِ أَحَدًا﴾."},{"i":10,"strength":"direct","bridge":"عبادتك كلها لواحد: ﴿فَإِلَهُكُمْ إِلَهٌ وَاحِدٌ فَلَهُ أَسْلِمُوا وَبَشِّرِ الْمُخْبِتِينَ﴾."}],"hadiths":[]}]},{"id":208,"name":"الله غالبٌ على أمره","compound":true,"meaning":"الله غالب على أمره: ما أراده نافذ لا يردّه أحد، وإن دبّر الناس خلافه.","teaches":"1. وردت في قصة يوسف بعد أن بيع بثمن بخس.\n2. تدبير الإخوة كان طريقًا لتمكينه.\n3. أكثر الناس لا يعلمون هذا التدبير.","whenRecall":"- حين يدبّر لك الناس ما يضرك.\n- حين يبدو أمرك في أسوأ حال.","whenPray":"1. اللهم أنت غالب على أمرك، فاجعل أمري إلى خير.","summary":"ما دبّروه ليوسف كان طريق تمكينه؛ فأمر الله غالب.","verses":[{"i":1,"of":1,"s":12,"surah":"يوسف","a":21,"text":"وَقَالَ الَّذِي اشْتَرَاهُ مِنْ مِصْرَ لِامْرَأَتِهِ أَكْرِمِي مَثْوَاهُ عَسَى أَنْ يَنْفَعَنَا أَوْ نَتَّخِذَهُ وَلَدًا وَكَذَلِكَ مَكَّنَّا لِيُوسُفَ فِي الْأَرْضِ وَلِنُعَلِّمَهُ مِنْ تَأْوِيلِ الْأَحَادِيثِ وَاللَّهُ غَالِبٌ عَلَى أَمْرِهِ وَلَكِنَّ أَكْثَرَ النَّاسِ لَا يَعْلَمُونَ","prev":{"a":20,"text":"وَشَرَوْهُ بِثَمَنٍ بَخْسٍ دَرَاهِمَ مَعْدُودَةٍ وَكَانُوا فِيهِ مِنَ الزَّاهِدِينَ"},"next":{"a":22,"text":"وَلَمَّا بَلَغَ أَشُدَّهُ آتَيْنَاهُ حُكْمًا وَعِلْمًا وَكَذَلِكَ نَجْزِي الْمُحْسِنِينَ"},"context":"يوسف بِيع بدراهم معدودة، ثم اشتراه عزيز مصر.","reason":"انتقل يوسف من الجب والبيع إلى بيت العزيز والتمكين؛ فأمر الله غالب على تدبير الإخوة."}],"hadiths":[],"situations":[{"situationId":30,"verses":[{"i":1,"strength":"direct","bridge":"ما يُدبَّر لك من سوء قد يكون طريقًا إلى خير: ﴿وَاللَّهُ غَالِبٌ عَلَى أَمْرِهِ﴾."}],"hadiths":[]}]},{"id":209,"name":"بيده الفضل / الفضل بيد الله","compound":true,"meaning":"الفضل بيد الله: العطاء الزائد على الاستحقاق ملكه، يؤتيه من يشاء.","teaches":"1. وردت ردًّا على أهل الكتاب الذين حصروا الفضل فيهم.\n2. الفضل لا يحتكره قوم، ولا يُنال بالحسد.","whenRecall":"- حين ترى غيرك فُضّل عليك.\n- حين يظن قوم أن الخير حكرٌ عليهم.","whenPray":"1. اللهم إن الفضل بيدك فآتني من فضلك.","summary":"لا يُحتكر الفضل ولا يُنتزع؛ هو بيد الله يؤتيه من يشاء.","verses":[{"i":1,"of":2,"s":3,"surah":"آل عمران","a":73,"text":"وَلَا تُؤْمِنُوا إِلَّا لِمَنْ تَبِعَ دِينَكُمْ قُلْ إِنَّ الْهُدَى هُدَى اللَّهِ أَنْ يُؤْتَى أَحَدٌ مِثْلَ مَا أُوتِيتُمْ أَوْ يُحَاجُّوكُمْ عِنْدَ رَبِّكُمْ قُلْ إِنَّ الْفَضْلَ بِيَدِ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ","prev":{"a":72,"text":"وَقَالَتْ طَائِفَةٌ مِنْ أَهْلِ الْكِتَابِ آمِنُوا بِالَّذِي أُنْزِلَ عَلَى الَّذِينَ آمَنُوا وَجْهَ النَّهَارِ وَاكْفُرُوا آخِرَهُ لَعَلَّهُمْ يَرْجِعُونَ"},"next":{"a":74,"text":"يَخْتَصُّ بِرَحْمَتِهِ مَنْ يَشَاءُ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ"},"context":"طائفة من أهل الكتاب تتواصى بألا يؤمنوا إلا لمن تبع دينهم.","reason":"حسدوا أن يؤتى غيرهم مثل ما أوتوا، فبيّن أن الفضل بيده لا بأيديهم."},{"i":2,"of":2,"s":57,"surah":"الحديد","a":29,"text":"لِئَلَّا يَعْلَمَ أَهْلُ الْكِتَابِ أَلَّا يَقْدِرُونَ عَلَى شَيْءٍ مِنْ فَضْلِ اللَّهِ وَأَنَّ الْفَضْلَ بِيَدِ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ","prev":{"a":28,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَآمِنُوا بِرَسُولِهِ يُؤْتِكُمْ كِفْلَيْنِ مِنْ رَحْمَتِهِ وَيَجْعَلْ لَكُمْ نُورًا تَمْشُونَ بِهِ وَيَغْفِرْ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ"},"context":"ختام الحديد بعد وعد المؤمنين بكفلين من رحمته.","reason":"أهل الكتاب لا يقدرون على شيء من فضل الله؛ فهو بيده وحده."}],"hadiths":[],"situations":[{"situationId":42,"verses":[{"i":2,"strength":"direct","bridge":"لا يملك أحد أن يمنعك فضل الله: ﴿وَأَنَّ الْفَضْلَ بِيَدِ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ﴾."}],"hadiths":[]},{"situationId":84,"verses":[{"i":1,"strength":"direct","bridge":"إن حسدت أحدًا على ما أوتي، فتذكر: ﴿إِنَّ الْفَضْلَ بِيَدِ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ﴾."}],"hadiths":[]}]},{"id":210,"name":"الذي بيده ملكوت كل شيء","compound":true,"meaning":"الذي بيده ملكوت كل شيء: ملكه التام لكل شيء ظاهرًا وباطنًا، وتصرفه فيه.","teaches":"1. ختام يس بعد إثبات البعث: إنما أمره إذا أراد شيئًا أن يقول له كن.\n2. التسبيح هنا تنزيه له عن العجز عن الإعادة.","whenRecall":"- حين تستبعد البعث بعد الموت.\n- حين ترى أمرًا مستحيلًا في نظرك.","whenPray":"1. ﴿فَسُبْحَانَ الَّذِي بِيَدِهِ مَلَكُوتُ كُلِّ شَيْءٍ﴾ — تسبيح عند ذكر الموت والبعث.","summary":"من بيده ملكوت كل شيء لا يعجزه أن يعيدك؛ وإليه ترجع.","verses":[{"i":1,"of":1,"s":36,"surah":"يس","a":83,"text":"فَسُبْحَانَ الَّذِي بِيَدِهِ مَلَكُوتُ كُلِّ شَيْءٍ وَإِلَيْهِ تُرْجَعُونَ","prev":{"a":82,"text":"إِنَّمَا أَمْرُهُ إِذَا أَرَادَ شَيْئًا أَنْ يَقُولَ لَهُ كُنْ فَيَكُونُ"},"context":"قبلها: إنما أمره إذا أراد شيئًا أن يقول له كن فيكون، بعد حجاج منكر البعث.","reason":"ختم الرد على منكر البعث بالتسبيح وإثبات الملكوت والرجوع."}],"hadiths":[],"situations":[{"situationId":109,"verses":[{"i":1,"strength":"direct","bridge":"إن ثقل عليك تصور البعث فسبّح: ﴿فَسُبْحَانَ الَّذِي بِيَدِهِ مَلَكُوتُ كُلِّ شَيْءٍ وَإِلَيْهِ تُرْجَعُونَ﴾."}],"hadiths":[]}]},{"id":211,"name":"قوي شديد العقاب","compound":true,"meaning":"قوي شديد العقاب: قوته لا تُغالب، وعقابه لمن كفر بآياته شديد.","teaches":"1. يأتي بعد ذكر هلاك آل فرعون والأمم المكذبة.\n2. الأخذ كان بالذنوب لا بالظلم.","whenRecall":"- حين تأمن العقوبة وتتمادى.\n- حين ترى طاغية مطمئنًّا.","whenPray":"1. أن تستعيذ بالله من أخذه: اللهم لا تأخذنا بذنوبنا.","summary":"أخذ الأمم بذنوبها؛ فقوته وشدة عقابه تمنعك من الأمن.","verses":[{"i":1,"of":2,"s":8,"surah":"الأنفال","a":52,"text":"كَدَأْبِ آلِ فِرْعَوْنَ وَالَّذِينَ مِنْ قَبْلِهِمْ كَفَرُوا بِآيَاتِ اللَّهِ فَأَخَذَهُمُ اللَّهُ بِذُنُوبِهِمْ إِنَّ اللَّهَ قَوِيٌّ شَدِيدُ الْعِقَابِ","prev":{"a":51,"text":"ذَلِكَ بِمَا قَدَّمَتْ أَيْدِيكُمْ وَأَنَّ اللَّهَ لَيْسَ بِظَلَّامٍ لِلْعَبِيدِ"},"next":{"a":53,"text":"ذَلِكَ بِأَنَّ اللَّهَ لَمْ يَكُ مُغَيِّرًا نِعْمَةً أَنْعَمَهَا عَلَى قَوْمٍ حَتَّى يُغَيِّرُوا مَا بِأَنْفُسِهِمْ وَأَنَّ اللَّهَ سَمِيعٌ عَلِيمٌ"},"context":"بعد مشهد الملائكة تضرب وجوه الكافرين عند الوفاة.","reason":"شبّه حالهم بآل فرعون، وأن الأخذ كان بذنوبهم من قوي شديد العقاب."},{"i":2,"of":2,"s":40,"surah":"غافر","a":22,"text":"ذَلِكَ بِأَنَّهُمْ كَانَتْ تَأْتِيهِمْ رُسُلُهُمْ بِالْبَيِّنَاتِ فَكَفَرُوا فَأَخَذَهُمُ اللَّهُ إِنَّهُ قَوِيٌّ شَدِيدُ الْعِقَابِ","prev":{"a":21,"text":"أَوَلَمْ يَسِيرُوا فِي الْأَرْضِ فَيَنْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الَّذِينَ كَانُوا مِنْ قَبْلِهِمْ كَانُوا هُمْ أَشَدَّ مِنْهُمْ قُوَّةً وَآثَارًا فِي الْأَرْضِ فَأَخَذَهُمُ اللَّهُ بِذُنُوبِهِمْ وَمَا كَانَ لَهُمْ مِنَ اللَّهِ مِنْ وَاقٍ"},"next":{"a":23,"text":"وَلَقَدْ أَرْسَلْنَا مُوسَى بِآيَاتِنَا وَسُلْطَانٍ مُبِينٍ"},"context":"دعوة إلى السير في الأرض والنظر في عاقبة من قبلهم.","reason":"جاءتهم البينات فكفروا، فأخذهم؛ القوة والعقاب بعد البيان."}],"hadiths":[],"situations":[{"situationId":21,"verses":[{"i":1,"strength":"direct","bridge":"لا تأمن الإمهال؛ ﴿فَأَخَذَهُمُ اللَّهُ بِذُنُوبِهِمْ إِنَّ اللَّهَ قَوِيٌّ شَدِيدُ الْعِقَابِ﴾."}],"hadiths":[]},{"situationId":121,"verses":[{"i":2,"strength":"direct","bridge":"من جاءته البينات وأعرض فليتذكر: ﴿فَأَخَذَهُمُ اللَّهُ إِنَّهُ قَوِيٌّ شَدِيدُ الْعِقَابِ﴾."}],"hadiths":[]}]},{"id":212,"name":"الله أسرع مكرًا","compound":true,"meaning":"الله أسرع مكرًا: تدبيره في جزاء الماكرين أسبق وأنفذ من مكرهم.","teaches":"1. نزلت فيمن ينكر نعمة الله بعد كشف الضر ويمكر بآياته.\n2. مكرهم مكتوب: ﴿إِنَّ رُسُلَنَا يَكْتُبُونَ مَا تَمْكُرُونَ﴾.","whenRecall":"- حين ترى من يمكر بالحق بعد أن نجّاه الله.\n- حين تنسى الله بعد زوال الضر.","whenPray":"1. اللهم لا تجعلني ممن يمكر بآياتك بعد رحمتك.","summary":"من مكر بآيات الله بعد رحمته فالله أسرع مكرًا، ومكره مكتوب.","verses":[{"i":1,"of":1,"s":10,"surah":"يونس","a":21,"text":"وَإِذَا أَذَقْنَا النَّاسَ رَحْمَةً مِنْ بَعْدِ ضَرَّاءَ مَسَّتْهُمْ إِذَا لَهُمْ مَكْرٌ فِي آيَاتِنَا قُلِ اللَّهُ أَسْرَعُ مَكْرًا إِنَّ رُسُلَنَا يَكْتُبُونَ مَا تَمْكُرُونَ","prev":{"a":20,"text":"وَيَقُولُونَ لَوْلَا أُنْزِلَ عَلَيْهِ آيَةٌ مِنْ رَبِّهِ فَقُلْ إِنَّمَا الْغَيْبُ لِلَّهِ فَانْتَظِرُوا إِنِّي مَعَكُمْ مِنَ الْمُنْتَظِرِينَ"},"next":{"a":22,"text":"هُوَ الَّذِي يُسَيِّرُكُمْ فِي الْبَرِّ وَالْبَحْرِ حَتَّى إِذَا كُنْتُمْ فِي الْفُلْكِ وَجَرَيْنَ بِهِمْ بِرِيحٍ طَيِّبَةٍ وَفَرِحُوا بِهَا جَاءَتْهَا رِيحٌ عَاصِفٌ وَجَاءَهُمُ الْمَوْجُ مِنْ كُلِّ مَكَانٍ وَظَنُّوا أَنَّهُمْ أُحِيطَ بِهِمْ دَعَوُا اللَّهَ مُخْلِصِينَ لَهُ الدِّينَ لَئِنْ أَنْجَيْتَنَا مِنْ هَذِهِ لَنَكُونَنَّ مِنَ الشَّاكِرِينَ"},"context":"الناس إذا ذاقوا رحمة بعد ضراء مكروا في آيات الله.","reason":"قابل مكرهم بأن الله أسرع مكرًا، وأن رسله يكتبون."}],"hadiths":[],"situations":[{"situationId":92,"verses":[{"i":1,"strength":"direct","bridge":"إذا كُشف عنك الضر فلا تنقلب على آياته؛ ﴿قُلِ اللَّهُ أَسْرَعُ مَكْرًا﴾."}],"hadiths":[]}]},{"id":213,"name":"الله أشد بأسًا وأشد تنكيلًا","compound":true,"meaning":"الله أشد بأسًا وأشد تنكيلًا: قوته في البطش بأعدائه أعظم من بأسهم، وعقوبته أشد ردعًا.","teaches":"1. جاءت في الأمر بالقتال والتحريض مع قلة الناصر.\n2. لا يُكلَّف المرء إلا نفسه.","whenRecall":"- حين تخاف بأس من يعاديك.\n- حين تقوم بالحق وحدك.","whenPray":"1. عسى الله أن يكف بأس الذين يعادون الحق.","summary":"بأس العدو محدود، وبأس الله أشد؛ فقم بما كُلّفت.","verses":[{"i":1,"of":1,"s":4,"surah":"النساء","a":84,"text":"فَقَاتِلْ فِي سَبِيلِ اللَّهِ لَا تُكَلَّفُ إِلَّا نَفْسَكَ وَحَرِّضِ الْمُؤْمِنِينَ عَسَى اللَّهُ أَنْ يَكُفَّ بَأْسَ الَّذِينَ كَفَرُوا وَاللَّهُ أَشَدُّ بَأْسًا وَأَشَدُّ تَنْكِيلًا","prev":{"a":83,"text":"وَإِذَا جَاءَهُمْ أَمْرٌ مِنَ الْأَمْنِ أَوِ الْخَوْفِ أَذَاعُوا بِهِ وَلَوْ رَدُّوهُ إِلَى الرَّسُولِ وَإِلَى أُولِي الْأَمْرِ مِنْهُمْ لَعَلِمَهُ الَّذِينَ يَسْتَنْبِطُونَهُ مِنْهُمْ وَلَوْلَا فَضْلُ اللَّهِ عَلَيْكُمْ وَرَحْمَتُهُ لَاتَّبَعْتُمُ الشَّيْطَانَ إِلَّا قَلِيلًا"},"next":{"a":85,"text":"مَنْ يَشْفَعْ شَفَاعَةً حَسَنَةً يَكُنْ لَهُ نَصِيبٌ مِنْهَا وَمَنْ يَشْفَعْ شَفَاعَةً سَيِّئَةً يَكُنْ لَهُ كِفْلٌ مِنْهَا وَكَانَ اللَّهُ عَلَى كُلِّ شَيْءٍ مُقِيتًا"},"context":"سياق القتال وذكر المثبطين وإذاعة الأخبار.","reason":"كلّفه نفسه ووعده بكف بأس الكافرين؛ فالله أشد بأسًا منهم."}],"hadiths":[],"situations":[{"situationId":31,"verses":[{"i":1,"strength":"direct","bridge":"إذا خفت بأس عدوك وأنت وحدك، فـ﴿لَا تُكَلَّفُ إِلَّا نَفْسَكَ﴾ ﴿وَاللَّهُ أَشَدُّ بَأْسًا وَأَشَدُّ تَنْكِيلًا﴾."}],"hadiths":[]}]},{"id":214,"name":"الله خير وأبقى","compound":true,"meaning":"الله خير وأبقى: ما عند الله وثوابه خير مما يعِد به الطغاة، وأدوم.","teaches":"1. قالها سحرة فرعون بعد إيمانهم وتهديدهم بالقتل.\n2. قارنوا بين متاع زائل وما عند الله الباقي.","whenRecall":"- حين تُهدَّد لتترك الحق.\n- حين تُغرى بمتاع زائل.","whenPray":"1. ربنا آمنا بك فاغفر لنا خطايانا، وأنت خير وأبقى.","summary":"قالها من هُدّد بالصلب: ما عند الله خير وأبقى من كل وعدٍ ووعيد.","verses":[{"i":1,"of":1,"s":20,"surah":"طه","a":73,"text":"إِنَّا آمَنَّا بِرَبِّنَا لِيَغْفِرَ لَنَا خَطَايَانَا وَمَا أَكْرَهْتَنَا عَلَيْهِ مِنَ السِّحْرِ وَاللَّهُ خَيْرٌ وَأَبْقَى","prev":{"a":72,"text":"قَالُوا لَنْ نُؤْثِرَكَ عَلَى مَا جَاءَنَا مِنَ الْبَيِّنَاتِ وَالَّذِي فَطَرَنَا فَاقْضِ مَا أَنْتَ قَاضٍ إِنَّمَا تَقْضِي هَذِهِ الْحَيَاةَ الدُّنْيَا"},"next":{"a":74,"text":"إِنَّهُ مَنْ يَأْتِ رَبَّهُ مُجْرِمًا فَإِنَّ لَهُ جَهَنَّمَ لَا يَمُوتُ فِيهَا وَلَا يَحْيَى"},"context":"سحرة فرعون آمنوا، فهددهم بالقطع والصلب.","reason":"ردّوا تهديده بأن الله خير ثوابًا وأبقى عذابًا من فرعون."}],"hadiths":[],"situations":[{"situationId":33,"verses":[{"i":1,"strength":"direct","bridge":"إن هُدّدت لتترك الحق فقل كما قالوا: ﴿وَاللَّهُ خَيْرٌ وَأَبْقَى﴾."}],"hadiths":[]}]},{"id":216,"name":"المليك المقتدر","compound":true,"meaning":"المليك المقتدر: الملك التام الملك، القادر على كل شيء قدرة كاملة.","teaches":"1. وردت في وصف مقام المتقين في الجنة.\n2. القرب من المليك المقتدر هو ذروة النعيم.","whenRecall":"- حين تشتاق إلى جزاء التقوى.\n- حين تجد طريق التقوى طويلًا.","whenPray":"1. اللهم اجعلنا في مقعد صدق عندك.","summary":"غاية المتقي مقعد صدق عند مليك مقتدر.","verses":[{"i":1,"of":1,"s":54,"surah":"القمر","a":55,"text":"فِي مَقْعَدِ صِدْقٍ عِنْدَ مَلِيكٍ مُقْتَدِرٍ","prev":{"a":54,"text":"إِنَّ الْمُتَّقِينَ فِي جَنَّاتٍ وَنَهَرٍ"},"context":"ختام القمر بعد ذكر المجرمين وعذابهم.","reason":"قابل مصير المجرمين بمقام المتقين عند المليك المقتدر."}],"hadiths":[],"situations":[{"situationId":184,"verses":[{"i":1,"strength":"direct","bridge":"إن طال عليك طريق التقوى فتذكر غايته: ﴿فِي مَقْعَدِ صِدْقٍ عِنْدَ مَلِيكٍ مُقْتَدِرٍ﴾."}],"hadiths":[]}]},{"id":217,"name":"رحيم","compound":false,"meaning":"رحيم (منكّرًا مقرونًا بمن رحمهم): رحمته خاصة بمن ذُكر، تظهر في تشريعه ونعمه.","teaches":"1. جاء بعد النهي عن أكل المال بالباطل وقتل النفس.\n2. وبعد تسخير الفلك في البحر.\n3. وبعد صلاته على المؤمنين وإخراجهم من الظلمات.","whenRecall":"- حين تضيق بحكم شرعي.\n- حين تركب البحر أو تسافر.\n- حين تشعر بظلمة القلب.","whenPray":"1. اللهم ارحمني رحمةً تخرجني بها من الظلمات إلى النور.","summary":"نهيه رحمة، وتسخيره رحمة، وهدايته رحمة.","verses":[{"i":1,"of":3,"s":4,"surah":"النساء","a":29,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَأْكُلُوا أَمْوَالَكُمْ بَيْنَكُمْ بِالْبَاطِلِ إِلَّا أَنْ تَكُونَ تِجَارَةً عَنْ تَرَاضٍ مِنْكُمْ وَلَا تَقْتُلُوا أَنْفُسَكُمْ إِنَّ اللَّهَ كَانَ بِكُمْ رَحِيمًا","prev":{"a":28,"text":"يُرِيدُ اللَّهُ أَنْ يُخَفِّفَ عَنْكُمْ وَخُلِقَ الْإِنْسَانُ ضَعِيفًا"},"next":{"a":30,"text":"وَمَنْ يَفْعَلْ ذَلِكَ عُدْوَانًا وَظُلْمًا فَسَوْفَ نُصْلِيهِ نَارًا وَكَانَ ذَلِكَ عَلَى اللَّهِ يَسِيرًا"},"context":"سياق الأحكام بعد إرادة التخفيف عن الإنسان الضعيف.","reason":"النهي عن أكل المال بالباطل وقتل النفس رحمة بكم."},{"i":2,"of":3,"s":17,"surah":"الإسراء","a":66,"text":"رَبُّكُمُ الَّذِي يُزْجِي لَكُمُ الْفُلْكَ فِي الْبَحْرِ لِتَبْتَغُوا مِنْ فَضْلِهِ إِنَّهُ كَانَ بِكُمْ رَحِيمًا","prev":{"a":65,"text":"إِنَّ عِبَادِي لَيْسَ لَكَ عَلَيْهِمْ سُلْطَانٌ وَكَفَى بِرَبِّكَ وَكِيلًا"},"next":{"a":67,"text":"وَإِذَا مَسَّكُمُ الضُّرُّ فِي الْبَحْرِ ضَلَّ مَنْ تَدْعُونَ إِلَّا إِيَّاهُ فَلَمَّا نَجَّاكُمْ إِلَى الْبَرِّ أَعْرَضْتُمْ وَكَانَ الْإِنْسَانُ كَفُورًا"},"context":"بعد ذكر إبليس وأنه لا سلطان له على عباد الله.","reason":"تسخير الفلك للتجارة والسفر من رحمته."},{"i":3,"of":3,"s":33,"surah":"الأحزاب","a":43,"text":"هُوَ الَّذِي يُصَلِّي عَلَيْكُمْ وَمَلَائِكَتُهُ لِيُخْرِجَكُمْ مِنَ الظُّلُمَاتِ إِلَى النُّورِ وَكَانَ بِالْمُؤْمِنِينَ رَحِيمًا","prev":{"a":42,"text":"وَسَبِّحُوهُ بُكْرَةً وَأَصِيلًا"},"next":{"a":44,"text":"تَحِيَّتُهُمْ يَوْمَ يَلْقَوْنَهُ سَلَامٌ وَأَعَدَّ لَهُمْ أَجْرًا كَرِيمًا"},"context":"بعد الأمر بذكر الله كثيرًا وتسبيحه بكرة وأصيلًا.","reason":"صلاته وملائكته على المؤمنين ليخرجهم من الظلمات رحمة خاصة بهم."}],"hadiths":[{"i":1,"of":1,"text":"احْتَلَمْتُ في لَيْلةٍ بارِدةٍ في غَزْوةِ ذاتِ السَّلاسِلِ، فأَشْفَقْتُ إن اغْتَسَلْتُ أن أَهلِكَ، فتَيَمَّمْتُ ثُمَّ صَلَّيْتُ بأصْحابي الصُّبْحَ، فذَكَروا ذلك للنَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقالَ: \"يا عَمْرُو، صَلَّيْتَ بأصْحابِك الصُّبْحَ وأنت جُنُبٌ؟\"، فأَخبَرْتُه بالَّذي مَنَعَني مِن الاغْتِسالِ، وقُلْتُ: إنِّي سَمِعْتُ اللهَ يَقولُ: {وَلا تَقْتُلُوا أَنْفُسَكُمْ إِنَّ اللَّهَ كَانَ بِكُمْ رَحِيمًا}، فضَحِكَ نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ، ولم يَقُلْ شَيئًا. وعنه في هذا الحديث أنَّه غَسَلَ مَغابِنَه، وتَوَضَّأَ وُضوءَه للصَّلاةِ، ثُمَّ صلَّى بِهم.","narrator":"عمرو بن العاص","source":"الأحكام الوسطى 1/ 223","grade":"صحيح","judgment":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","url":"https://dorar.net/h/C3vvPMD1","nameForm":"رحيم"}],"sunnah":{},"situations":[{"situationId":41,"verses":[{"i":2,"strength":"direct","bridge":"إذا خرجت تطلب رزقك برًّا أو بحرًا، فالذي ﴿يُزْجِي لَكُمُ الْفُلْكَ فِي الْبَحْرِ﴾ ﴿كَانَ بِكُمْ رَحِيمًا﴾."}],"hadiths":[]},{"situationId":46,"verses":[{"i":1,"strength":"direct","bridge":"إذا أغراك الكسب الحرام فتذكر أن النهي رحمة: ﴿إِنَّ اللَّهَ كَانَ بِكُمْ رَحِيمًا﴾."}],"hadiths":[]},{"situationId":116,"verses":[{"i":3,"strength":"direct","bridge":"إن أظلم قلبك فاذكر الله؛ ﴿هُوَ الَّذِي يُصَلِّي عَلَيْكُمْ وَمَلَائِكَتُهُ لِيُخْرِجَكُمْ مِنَ الظُّلُمَاتِ إِلَى النُّورِ﴾."}],"hadiths":[]}]},{"id":219,"name":"كفى بالله حسيباً","compound":true,"meaning":"كفى بالله حسيبًا: يكفي أن يكون الله محاسبًا ورقيبًا على الأعمال.","teaches":"1. ختم بها أحكام أموال اليتامى.\n2. ووصف بها الدعاة الذين لا يخشون إلا الله.","whenRecall":"- حين تتولى مالًا أو أمانة لغيرك.\n- حين تخشى الناس في البلاغ.","whenPray":"1. اللهم كن حسيبي، واجعلني أخشاك وحدك.","summary":"الأمانة والبلاغ تحت حساب الله؛ وكفى به حسيبًا.","verses":[{"i":1,"of":2,"s":4,"surah":"النساء","a":6,"text":"وَابْتَلُوا الْيَتَامَى حَتَّى إِذَا بَلَغُوا النِّكَاحَ فَإِنْ آنَسْتُمْ مِنْهُمْ رُشْدًا فَادْفَعُوا إِلَيْهِمْ أَمْوَالَهُمْ وَلَا تَأْكُلُوهَا إِسْرَافًا وَبِدَارًا أَنْ يَكْبَرُوا وَمَنْ كَانَ غَنِيًّا فَلْيَسْتَعْفِفْ وَمَنْ كَانَ فَقِيرًا فَلْيَأْكُلْ بِالْمَعْرُوفِ فَإِذَا دَفَعْتُمْ إِلَيْهِمْ أَمْوَالَهُمْ فَأَشْهِدُوا عَلَيْهِمْ وَكَفَى بِاللَّهِ حَسِيبًا","prev":{"a":5,"text":"وَلَا تُؤْتُوا السُّفَهَاءَ أَمْوَالَكُمُ الَّتِي جَعَلَ اللَّهُ لَكُمْ قِيَامًا وَارْزُقُوهُمْ فِيهَا وَاكْسُوهُمْ وَقُولُوا لَهُمْ قَوْلًا مَعْرُوفًا"},"next":{"a":7,"text":"لِلرِّجَالِ نَصِيبٌ مِمَّا تَرَكَ الْوَالِدَانِ وَالْأَقْرَبُونَ وَلِلنِّسَاءِ نَصِيبٌ مِمَّا تَرَكَ الْوَالِدَانِ وَالْأَقْرَبُونَ مِمَّا قَلَّ مِنْهُ أَوْ كَثُرَ نَصِيبًا مَفْرُوضًا"},"context":"أحكام دفع أموال اليتامى إليهم عند الرشد والإشهاد.","reason":"الإشهاد للناس، والحساب الحقيقي عند الله."},{"i":2,"of":2,"s":33,"surah":"الأحزاب","a":39,"text":"الَّذِينَ يُبَلِّغُونَ رِسَالَاتِ اللَّهِ وَيَخْشَوْنَهُ وَلَا يَخْشَوْنَ أَحَدًا إِلَّا اللَّهَ وَكَفَى بِاللَّهِ حَسِيبًا","prev":{"a":38,"text":"مَا كَانَ عَلَى النَّبِيِّ مِنْ حَرَجٍ فِيمَا فَرَضَ اللَّهُ لَهُ سُنَّةَ اللَّهِ فِي الَّذِينَ خَلَوْا مِنْ قَبْلُ وَكَانَ أَمْرُ اللَّهِ قَدَرًا مَقْدُورًا"},"next":{"a":40,"text":"مَا كَانَ مُحَمَّدٌ أَبَا أَحَدٍ مِنْ رِجَالِكُمْ وَلَكِنْ رَسُولَ اللَّهِ وَخَاتَمَ النَّبِيِّينَ وَكَانَ اللَّهُ بِكُلِّ شَيْءٍ عَلِيمًا"},"context":"بعد ذكر ما فرض الله لنبيه من غير حرج، سنة الله في الأنبياء.","reason":"الدعاة يخشونه وحده، وحسابهم عليه لا على الناس."}],"hadiths":[],"situations":[{"situationId":47,"verses":[{"i":1,"strength":"direct","bridge":"إذا توليت مالًا لغيرك فاعلم أن الإشهاد لا يكفي؛ ﴿وَكَفَى بِاللَّهِ حَسِيبًا﴾."}],"hadiths":[]},{"situationId":135,"verses":[{"i":2,"strength":"direct","bridge":"إن خشيت الناس في قول الحق، فالذين ﴿وَيَخْشَوْنَهُ وَلَا يَخْشَوْنَ أَحَدًا إِلَّا اللَّهَ﴾ ﴿وَكَفَى بِاللَّهِ حَسِيبًا﴾."}],"hadiths":[]}]},{"id":220,"name":"كفى بالله وليًا","compound":true,"meaning":"كفى بالله وليًا: يكفيك أن يتولى الله أمرك ويحبك وينصرك.","teaches":"1. جاءت بعد ذكر من يريدون أن يضلوا المؤمنين.\n2. الله أعلم بأعدائكم، فلا تحتاجون وليًّا سواه.","whenRecall":"- حين تشعر أنك بلا سند.\n- حين يحيط بك من يريد إضلالك.","whenPray":"1. اللهم كن وليي، وكفى بك وليًّا.","summary":"من كان الله وليه لم يضره كيد أعدائه.","verses":[{"i":1,"of":1,"s":4,"surah":"النساء","a":45,"text":"وَاللَّهُ أَعْلَمُ بِأَعْدَائِكُمْ وَكَفَى بِاللَّهِ وَلِيًّا وَكَفَى بِاللَّهِ نَصِيرًا","prev":{"a":44,"text":"أَلَمْ تَرَ إِلَى الَّذِينَ أُوتُوا نَصِيبًا مِنَ الْكِتَابِ يَشْتَرُونَ الضَّلَالَةَ وَيُرِيدُونَ أَنْ تَضِلُّوا السَّبِيلَ"},"next":{"a":46,"text":"مِنَ الَّذِينَ هَادُوا يُحَرِّفُونَ الْكَلِمَ عَنْ مَوَاضِعِهِ وَيَقُولُونَ سَمِعْنَا وَعَصَيْنَا وَاسْمَعْ غَيْرَ مُسْمَعٍ وَرَاعِنَا لَيًّا بِأَلْسِنَتِهِمْ وَطَعْنًا فِي الدِّينِ وَلَوْ أَنَّهُمْ قَالُوا سَمِعْنَا وَأَطَعْنَا وَاسْمَعْ وَانْظُرْنَا لَكَانَ خَيْرًا لَهُمْ وَأَقْوَمَ وَلَكِنْ لَعَنَهُمُ اللَّهُ بِكُفْرِهِمْ فَلَا يُؤْمِنُونَ إِلَّا قَلِيلًا"},"context":"قبلها: أهل الكتاب يشترون الضلالة ويريدون أن تضلوا السبيل.","reason":"الله يعلم أعداءكم، فهو يتولاكم ويكفيكم."}],"hadiths":[],"situations":[{"situationId":118,"verses":[{"i":1,"strength":"direct","bridge":"إذا شعرت أنك وحدك بين من يريد إضلالك، ﴿وَاللَّهُ أَعْلَمُ بِأَعْدَائِكُمْ وَكَفَى بِاللَّهِ وَلِيًّا﴾."}],"hadiths":[]}]},{"id":221,"name":"كفى بالله نصيرًا","compound":true,"meaning":"كفى بالله نصيرًا: يكفيك نصر الله عن نصر غيره.","teaches":"1. جاءت مع الولاية في الآية نفسها: يتولاك وينصرك.\n2. النصر يتبع الولاية.","whenRecall":"- حين يقلّ ناصرك.\n- حين تُظلم ولا تجد من ينصفك.","whenPray":"1. اللهم انصرني، وكفى بك نصيرًا.","summary":"إذا قلّ الناصرون فالله وحده نصير.","verses":[{"i":1,"of":1,"s":4,"surah":"النساء","a":45,"text":"وَاللَّهُ أَعْلَمُ بِأَعْدَائِكُمْ وَكَفَى بِاللَّهِ وَلِيًّا وَكَفَى بِاللَّهِ نَصِيرًا","prev":{"a":44,"text":"أَلَمْ تَرَ إِلَى الَّذِينَ أُوتُوا نَصِيبًا مِنَ الْكِتَابِ يَشْتَرُونَ الضَّلَالَةَ وَيُرِيدُونَ أَنْ تَضِلُّوا السَّبِيلَ"},"next":{"a":46,"text":"مِنَ الَّذِينَ هَادُوا يُحَرِّفُونَ الْكَلِمَ عَنْ مَوَاضِعِهِ وَيَقُولُونَ سَمِعْنَا وَعَصَيْنَا وَاسْمَعْ غَيْرَ مُسْمَعٍ وَرَاعِنَا لَيًّا بِأَلْسِنَتِهِمْ وَطَعْنًا فِي الدِّينِ وَلَوْ أَنَّهُمْ قَالُوا سَمِعْنَا وَأَطَعْنَا وَاسْمَعْ وَانْظُرْنَا لَكَانَ خَيْرًا لَهُمْ وَأَقْوَمَ وَلَكِنْ لَعَنَهُمُ اللَّهُ بِكُفْرِهِمْ فَلَا يُؤْمِنُونَ إِلَّا قَلِيلًا"},"context":"نفس سياق: الله أعلم بأعدائكم.","reason":"النصر بعد الولاية؛ فالله يكفيكم ولاية ونصرًا."}],"hadiths":[],"situations":[{"situationId":28,"verses":[{"i":1,"strength":"direct","bridge":"إن ظُلمت ولم تجد ناصرًا، ﴿وَكَفَى بِاللَّهِ نَصِيرًا﴾."}],"hadiths":[]}]},{"id":222,"name":"كفى بالله عليماً","compound":true,"meaning":"كفى بالله عليمًا: علمه بالمطيعين ومنازلهم كافٍ، لا يضيع عنده عمل.","teaches":"1. جاءت بعد ذكر صحبة النبيين والصديقين لمن أطاع الله ورسوله.\n2. الفضل منه، والعلم بالمستحق عنده.","whenRecall":"- حين لا يرى الناس طاعتك.\n- حين تشتاق إلى رفقة الصالحين.","whenPray":"1. اللهم اجعلني مع الذين أنعمت عليهم.","summary":"صحبة الصالحين فضل من الله، وهو أعلم بمن يستحقها.","verses":[{"i":1,"of":1,"s":4,"surah":"النساء","a":70,"text":"ذَلِكَ الْفَضْلُ مِنَ اللَّهِ وَكَفَى بِاللَّهِ عَلِيمًا","prev":{"a":69,"text":"وَمَنْ يُطِعِ اللَّهَ وَالرَّسُولَ فَأُولَئِكَ مَعَ الَّذِينَ أَنْعَمَ اللَّهُ عَلَيْهِمْ مِنَ النَّبِيِّينَ وَالصِّدِّيقِينَ وَالشُّهَدَاءِ وَالصَّالِحِينَ وَحَسُنَ أُولَئِكَ رَفِيقًا"},"next":{"a":71,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا خُذُوا حِذْرَكُمْ فَانْفِرُوا ثُبَاتٍ أَوِ انْفِرُوا جَمِيعًا"},"context":"قبلها: من يطع الله والرسول فأولئك مع النبيين والصديقين والشهداء والصالحين.","reason":"ذلك الفضل منه، وهو عليم بمن يستحقه."}],"hadiths":[],"situations":[{"situationId":170,"verses":[{"i":1,"strength":"direct","bridge":"إذا أطعت ولم يرك أحد، فـ﴿ذَلِكَ الْفَضْلُ مِنَ اللَّهِ وَكَفَى بِاللَّهِ عَلِيمًا﴾."}],"hadiths":[]}]},{"id":223,"name":"كفى بالله شهيداً","compound":true,"meaning":"كفى بالله شهيدًا: شهادة الله على الحق كافية، وإن كذّب الناس.","teaches":"1. أكثر مواضعها في الرد على تكذيب الرسالة.\n2. تُقال حين ينقطع الجدال.\n3. شهادة الله بما أنزل وشهادة الملائكة (النساء 166).","whenRecall":"- حين تُكذَّب وأنت صادق.\n- حين ينقطع الحوار مع من لا يقبل.","whenPray":"1. ﴿قُلْ كَفَى بِاللَّهِ شَهِيدًا بَيْنِي وَبَيْنَكُمْ﴾ — الإسراء 96، عند انتهاء الحجاج.","summary":"إذا كذّبك الناس فشهادة الله بينك وبينهم تكفي.","verses":[{"i":1,"of":6,"s":4,"surah":"النساء","a":79,"text":"مَا أَصَابَكَ مِنْ حَسَنَةٍ فَمِنَ اللَّهِ وَمَا أَصَابَكَ مِنْ سَيِّئَةٍ فَمِنْ نَفْسِكَ وَأَرْسَلْنَاكَ لِلنَّاسِ رَسُولًا وَكَفَى بِاللَّهِ شَهِيدًا","prev":{"a":78,"text":"أَيْنَمَا تَكُونُوا يُدْرِكْكُمُ الْمَوْتُ وَلَوْ كُنْتُمْ فِي بُرُوجٍ مُشَيَّدَةٍ وَإِنْ تُصِبْهُمْ حَسَنَةٌ يَقُولُوا هَذِهِ مِنْ عِنْدِ اللَّهِ وَإِنْ تُصِبْهُمْ سَيِّئَةٌ يَقُولُوا هَذِهِ مِنْ عِنْدِكَ قُلْ كُلٌّ مِنْ عِنْدِ اللَّهِ فَمَالِ هَؤُلَاءِ الْقَوْمِ لَا يَكَادُونَ يَفْقَهُونَ حَدِيثًا"},"next":{"a":80,"text":"مَنْ يُطِعِ الرَّسُولَ فَقَدْ أَطَاعَ اللَّهَ وَمَنْ تَوَلَّى فَمَا أَرْسَلْنَاكَ عَلَيْهِمْ حَفِيظًا"},"context":"قبلها: المنافقون ينسبون السيئة إلى النبي ﷺ.","reason":"الحسنة من الله والسيئة من النفس، والله شهيد على صدق الرسالة."},{"i":2,"of":6,"s":4,"surah":"النساء","a":166,"text":"لَكِنِ اللَّهُ يَشْهَدُ بِمَا أَنْزَلَ إِلَيْكَ أَنْزَلَهُ بِعِلْمِهِ وَالْمَلَائِكَةُ يَشْهَدُونَ وَكَفَى بِاللَّهِ شَهِيدًا","prev":{"a":165,"text":"رُسُلًا مُبَشِّرِينَ وَمُنْذِرِينَ لِئَلَّا يَكُونَ لِلنَّاسِ عَلَى اللَّهِ حُجَّةٌ بَعْدَ الرُّسُلِ وَكَانَ اللَّهُ عَزِيزًا حَكِيمًا"},"next":{"a":167,"text":"إِنَّ الَّذِينَ كَفَرُوا وَصَدُّوا عَنْ سَبِيلِ اللَّهِ قَدْ ضَلُّوا ضَلَالًا بَعِيدًا"},"context":"بعد ذكر الرسل مبشرين ومنذرين.","reason":"إن كفروا بالقرآن فالله يشهد به والملائكة."},{"i":3,"of":6,"s":10,"surah":"يونس","a":29,"text":"فَكَفَى بِاللَّهِ شَهِيدًا بَيْنَنَا وَبَيْنَكُمْ إِنْ كُنَّا عَنْ عِبَادَتِكُمْ لَغَافِلِينَ","prev":{"a":28,"text":"وَيَوْمَ نَحْشُرُهُمْ جَمِيعًا ثُمَّ نَقُولُ لِلَّذِينَ أَشْرَكُوا مَكَانَكُمْ أَنْتُمْ وَشُرَكَاؤُكُمْ فَزَيَّلْنَا بَيْنَهُمْ وَقَالَ شُرَكَاؤُهُمْ مَا كُنْتُمْ إِيَّانَا تَعْبُدُونَ"},"next":{"a":30,"text":"هُنَالِكَ تَبْلُو كُلُّ نَفْسٍ مَا أَسْلَفَتْ وَرُدُّوا إِلَى اللَّهِ مَوْلَاهُمُ الْحَقِّ وَضَلَّ عَنْهُمْ مَا كَانُوا يَفْتَرُونَ"},"context":"يوم الحشر يتبرأ الشركاء ممن عبدهم.","reason":"المعبودون يستشهدون بالله على أنهم لم يعلموا بعبادتهم."},{"i":4,"of":6,"s":13,"surah":"الرعد","a":43,"text":"وَيَقُولُ الَّذِينَ كَفَرُوا لَسْتَ مُرْسَلًا قُلْ كَفَى بِاللَّهِ شَهِيدًا بَيْنِي وَبَيْنَكُمْ وَمَنْ عِنْدَهُ عِلْمُ الْكِتَابِ","prev":{"a":42,"text":"وَقَدْ مَكَرَ الَّذِينَ مِنْ قَبْلِهِمْ فَلِلَّهِ الْمَكْرُ جَمِيعًا يَعْلَمُ مَا تَكْسِبُ كُلُّ نَفْسٍ وَسَيَعْلَمُ الْكُفَّارُ لِمَنْ عُقْبَى الدَّارِ"},"context":"الكافرون يقولون: لست مرسلًا.","reason":"أحال الحكم إلى شهادة الله ومن عنده علم الكتاب."},{"i":5,"of":6,"s":17,"surah":"الإسراء","a":96,"text":"قُلْ كَفَى بِاللَّهِ شَهِيدًا بَيْنِي وَبَيْنَكُمْ إِنَّهُ كَانَ بِعِبَادِهِ خَبِيرًا بَصِيرًا","prev":{"a":95,"text":"قُلْ لَوْ كَانَ فِي الْأَرْضِ مَلَائِكَةٌ يَمْشُونَ مُطْمَئِنِّينَ لَنَزَّلْنَا عَلَيْهِمْ مِنَ السَّمَاءِ مَلَكًا رَسُولًا"},"next":{"a":97,"text":"وَمَنْ يَهْدِ اللَّهُ فَهُوَ الْمُهْتَدِ وَمَنْ يُضْلِلْ فَلَنْ تَجِدَ لَهُمْ أَوْلِيَاءَ مِنْ دُونِهِ وَنَحْشُرُهُمْ يَوْمَ الْقِيَامَةِ عَلَى وُجُوهِهِمْ عُمْيًا وَبُكْمًا وَصُمًّا مَأْوَاهُمْ جَهَنَّمُ كُلَّمَا خَبَتْ زِدْنَاهُمْ سَعِيرًا"},"context":"بعد مطالب المشركين بالآيات وإنزال ملك رسولًا.","reason":"انتهى الجدال، فأحال إلى شهادة الله الخبير البصير بعباده."},{"i":6,"of":6,"s":48,"surah":"الفتح","a":28,"text":"هُوَ الَّذِي أَرْسَلَ رَسُولَهُ بِالْهُدَى وَدِينِ الْحَقِّ لِيُظْهِرَهُ عَلَى الدِّينِ كُلِّهِ وَكَفَى بِاللَّهِ شَهِيدًا","prev":{"a":27,"text":"لَقَدْ صَدَقَ اللَّهُ رَسُولَهُ الرُّؤْيَا بِالْحَقِّ لَتَدْخُلُنَّ الْمَسْجِدَ الْحَرَامَ إِنْ شَاءَ اللَّهُ آمِنِينَ مُحَلِّقِينَ رُءُوسَكُمْ وَمُقَصِّرِينَ لَا تَخَافُونَ فَعَلِمَ مَا لَمْ تَعْلَمُوا فَجَعَلَ مِنْ دُونِ ذَلِكَ فَتْحًا قَرِيبًا"},"next":{"a":29,"text":"مُحَمَّدٌ رَسُولُ اللَّهِ وَالَّذِينَ مَعَهُ أَشِدَّاءُ عَلَى الْكُفَّارِ رُحَمَاءُ بَيْنَهُمْ تَرَاهُمْ رُكَّعًا سُجَّدًا يَبْتَغُونَ فَضْلًا مِنَ اللَّهِ وَرِضْوَانًا سِيمَاهُمْ فِي وُجُوهِهِمْ مِنْ أَثَرِ السُّجُودِ ذَلِكَ مَثَلُهُمْ فِي التَّوْرَاةِ وَمَثَلُهُمْ فِي الْإِنْجِيلِ كَزَرْعٍ أَخْرَجَ شَطْأَهُ فَآزَرَهُ فَاسْتَغْلَظَ فَاسْتَوَى عَلَى سُوقِهِ يُعْجِبُ الزُّرَّاعَ لِيَغِيظَ بِهِمُ الْكُفَّارَ وَعَدَ اللَّهُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ مِنْهُمْ مَغْفِرَةً وَأَجْرًا عَظِيمًا"},"context":"بعد صدق رؤيا النبي ﷺ في دخول المسجد الحرام.","reason":"وعد بإظهار الدين، والله شهيد على صدق الوعد."}],"hadiths":[],"situations":[{"situationId":25,"verses":[{"i":1,"strength":"direct","bridge":"إذا أصابتك سيئة فانظر إلى نفسك لا إلى غيرك، ﴿وَكَفَى بِاللَّهِ شَهِيدًا﴾."}],"hadiths":[]},{"situationId":38,"verses":[{"i":6,"strength":"direct","bridge":"إن استبطأت ظهور الحق، فالله ﴿أَرْسَلَ رَسُولَهُ بِالْهُدَى وَدِينِ الْحَقِّ لِيُظْهِرَهُ عَلَى الدِّينِ كُلِّهِ﴾."}],"hadiths":[]},{"situationId":94,"verses":[{"i":3,"strength":"direct","bridge":"من تعلّق بمخلوق سيتبرأ منه يوم القيامة: ﴿فَكَفَى بِاللَّهِ شَهِيدًا بَيْنَنَا وَبَيْنَكُمْ﴾."}],"hadiths":[]},{"situationId":108,"verses":[{"i":2,"strength":"direct","bridge":"إن شككت في الوحي فتذكر: ﴿لَكِنِ اللَّهُ يَشْهَدُ بِمَا أَنْزَلَ إِلَيْكَ أَنْزَلَهُ بِعِلْمِهِ﴾."}],"hadiths":[]},{"situationId":133,"verses":[{"i":5,"strength":"direct","bridge":"إذا انتهى الحوار ولم يقبلوا، ﴿قُلْ كَفَى بِاللَّهِ شَهِيدًا بَيْنِي وَبَيْنَكُمْ﴾."}],"hadiths":[]},{"situationId":136,"verses":[{"i":4,"strength":"direct","bridge":"إذا قيل لك: لست على حق، فقل: ﴿كَفَى بِاللَّهِ شَهِيدًا بَيْنِي وَبَيْنَكُمْ﴾."}],"hadiths":[]}]},{"id":224,"name":"كفى بربك هادياً ونصيراً","compound":true,"meaning":"كفى بربك هاديًا ونصيرًا: يكفيك ربك هاديًا إلى الحق، وناصرًا على عدوك.","teaches":"1. جاءت بعد شكوى الرسول هجر القرآن.\n2. لكل نبي عدو من المجرمين، وهذه سنة.","whenRecall":"- حين يهجر قومك الحق.\n- حين ترى العداوة على دعوتك.","whenPray":"1. يا رب اهدني وانصرني، وكفى بك هاديًا ونصيرًا.","summary":"العداوة سنة، والهداية والنصر من ربك.","verses":[{"i":1,"of":1,"s":25,"surah":"الفرقان","a":31,"text":"وَكَذَلِكَ جَعَلْنَا لِكُلِّ نَبِيٍّ عَدُوًّا مِنَ الْمُجْرِمِينَ وَكَفَى بِرَبِّكَ هَادِيًا وَنَصِيرًا","prev":{"a":30,"text":"وَقَالَ الرَّسُولُ يَا رَبِّ إِنَّ قَوْمِي اتَّخَذُوا هَذَا الْقُرْآنَ مَهْجُورًا"},"next":{"a":32,"text":"وَقَالَ الَّذِينَ كَفَرُوا لَوْلَا نُزِّلَ عَلَيْهِ الْقُرْآنُ جُمْلَةً وَاحِدَةً كَذَلِكَ لِنُثَبِّتَ بِهِ فُؤَادَكَ وَرَتَّلْنَاهُ تَرْتِيلًا"},"context":"قبلها: شكوى الرسول أن قومه اتخذوا القرآن مهجورًا.","reason":"سلّاه بأن لكل نبي عدوًّا، وأن ربه يكفيه هدايةً ونصرًا."}],"hadiths":[],"situations":[{"situationId":130,"verses":[{"i":1,"strength":"direct","bridge":"إذا عاداك قوم على الحق، فـ﴿وَكَذَلِكَ جَعَلْنَا لِكُلِّ نَبِيٍّ عَدُوًّا مِنَ الْمُجْرِمِينَ وَكَفَى بِرَبِّكَ هَادِيًا وَنَصِيرًا﴾."}],"hadiths":[]}]},{"id":225,"name":"كفى بربك وكيلاً","compound":true,"meaning":"كفى بربك وكيلًا: ربك يحفظ عباده من سلطان الشيطان، ويكفيهم.","teaches":"1. جاءت في خطاب إبليس: لا سلطان لك على عبادي.\n2. الوكالة هنا حفظٌ من الإغواء.","whenRecall":"- حين تشتد عليك وسوسة الشيطان.","whenPray":"1. اللهم إني أعوذ بك من الشيطان، وكفى بك وكيلًا.","summary":"عباد الله ليس للشيطان عليهم سلطان، وربهم وكيلهم.","verses":[{"i":1,"of":1,"s":17,"surah":"الإسراء","a":65,"text":"إِنَّ عِبَادِي لَيْسَ لَكَ عَلَيْهِمْ سُلْطَانٌ وَكَفَى بِرَبِّكَ وَكِيلًا","prev":{"a":64,"text":"وَاسْتَفْزِزْ مَنِ اسْتَطَعْتَ مِنْهُمْ بِصَوْتِكَ وَأَجْلِبْ عَلَيْهِمْ بِخَيْلِكَ وَرَجِلِكَ وَشَارِكْهُمْ فِي الْأَمْوَالِ وَالْأَوْلَادِ وَعِدْهُمْ وَمَا يَعِدُهُمُ الشَّيْطَانُ إِلَّا غُرُورًا"},"next":{"a":66,"text":"رَبُّكُمُ الَّذِي يُزْجِي لَكُمُ الْفُلْكَ فِي الْبَحْرِ لِتَبْتَغُوا مِنْ فَضْلِهِ إِنَّهُ كَانَ بِكُمْ رَحِيمًا"},"context":"قبلها: الإذن لإبليس أن يستفز من استطاع بصوته وخيله.","reason":"استثنى عباده من سلطانه، وضمن حفظهم بوكالته."}],"hadiths":[],"situations":[{"situationId":75,"verses":[{"i":1,"strength":"direct","bridge":"إذا اشتدت وسوسته، فتذكر: ﴿إِنَّ عِبَادِي لَيْسَ لَكَ عَلَيْهِمْ سُلْطَانٌ وَكَفَى بِرَبِّكَ وَكِيلًا﴾."}],"hadiths":[]}]},{"id":226,"name":"ليس بظلام للعبيد / ما ربك بظلام للعبيد / ما أنا بظلام للعبيد","compound":true,"meaning":"ليس بظلام للعبيد: نفي الظلم عن الله نفيًا تامًّا؛ فما يصيب العبد من عقوبة فبما قدّم.","teaches":"1. يسبقها غالبًا: ذلك بما قدمت أيديكم.\n2. صيغة المبالغة تنفي كل ظلم قليله وكثيره.\n3. قالها الله بنفسه يوم القيامة (ق 29).","whenRecall":"- حين تعترض على عدل الله.\n- حين تلوم القدر على عاقبة عملك.","whenPray":"1. اللهم إنك لا تظلم، فاغفر لي ما قدمت يداي.","summary":"كل جزاء بما قدّمت يداك، وربك ليس بظلام للعبيد.","verses":[{"i":1,"of":5,"s":3,"surah":"آل عمران","a":182,"text":"ذَلِكَ بِمَا قَدَّمَتْ أَيْدِيكُمْ وَأَنَّ اللَّهَ لَيْسَ بِظَلَّامٍ لِلْعَبِيدِ","prev":{"a":181,"text":"لَقَدْ سَمِعَ اللَّهُ قَوْلَ الَّذِينَ قَالُوا إِنَّ اللَّهَ فَقِيرٌ وَنَحْنُ أَغْنِيَاءُ سَنَكْتُبُ مَا قَالُوا وَقَتْلَهُمُ الْأَنْبِيَاءَ بِغَيْرِ حَقٍّ وَنَقُولُ ذُوقُوا عَذَابَ الْحَرِيقِ"},"next":{"a":183,"text":"الَّذِينَ قَالُوا إِنَّ اللَّهَ عَهِدَ إِلَيْنَا أَلَّا نُؤْمِنَ لِرَسُولٍ حَتَّى يَأْتِيَنَا بِقُرْبَانٍ تَأْكُلُهُ النَّارُ قُلْ قَدْ جَاءَكُمْ رُسُلٌ مِنْ قَبْلِي بِالْبَيِّنَاتِ وَبِالَّذِي قُلْتُمْ فَلِمَ قَتَلْتُمُوهُمْ إِنْ كُنْتُمْ صَادِقِينَ"},"context":"بعد قول من قال: إن الله فقير ونحن أغنياء.","reason":"عذابهم بما قدّموا، لا ظلمًا منه."},{"i":2,"of":5,"s":8,"surah":"الأنفال","a":51,"text":"ذَلِكَ بِمَا قَدَّمَتْ أَيْدِيكُمْ وَأَنَّ اللَّهَ لَيْسَ بِظَلَّامٍ لِلْعَبِيدِ","prev":{"a":50,"text":"وَلَوْ تَرَى إِذْ يَتَوَفَّى الَّذِينَ كَفَرُوا الْمَلَائِكَةُ يَضْرِبُونَ وُجُوهَهُمْ وَأَدْبَارَهُمْ وَذُوقُوا عَذَابَ الْحَرِيقِ"},"next":{"a":52,"text":"كَدَأْبِ آلِ فِرْعَوْنَ وَالَّذِينَ مِنْ قَبْلِهِمْ كَفَرُوا بِآيَاتِ اللَّهِ فَأَخَذَهُمُ اللَّهُ بِذُنُوبِهِمْ إِنَّ اللَّهَ قَوِيٌّ شَدِيدُ الْعِقَابِ"},"context":"مشهد الملائكة تضرب وجوه الكافرين وأدبارهم.","reason":"الضرب جزاء عملهم، والله لا يظلم."},{"i":3,"of":5,"s":22,"surah":"الحج","a":10,"text":"ذَلِكَ بِمَا قَدَّمَتْ يَدَاكَ وَأَنَّ اللَّهَ لَيْسَ بِظَلَّامٍ لِلْعَبِيدِ","prev":{"a":9,"text":"ثَانِيَ عِطْفِهِ لِيُضِلَّ عَنْ سَبِيلِ اللَّهِ لَهُ فِي الدُّنْيَا خِزْيٌ وَنُذِيقُهُ يَوْمَ الْقِيَامَةِ عَذَابَ الْحَرِيقِ"},"next":{"a":11,"text":"وَمِنَ النَّاسِ مَنْ يَعْبُدُ اللَّهَ عَلَى حَرْفٍ فَإِنْ أَصَابَهُ خَيْرٌ اطْمَأَنَّ بِهِ وَإِنْ أَصَابَتْهُ فِتْنَةٌ انْقَلَبَ عَلَى وَجْهِهِ خَسِرَ الدُّنْيَا وَالْآخِرَةَ ذَلِكَ هُوَ الْخُسْرَانُ الْمُبِينُ"},"context":"من يجادل في الله بغير علم ليضل عن سبيله.","reason":"خزي الدنيا وعذاب الآخرة بما قدمت يداه."},{"i":4,"of":5,"s":41,"surah":"فصلت","a":46,"text":"مَنْ عَمِلَ صَالِحًا فَلِنَفْسِهِ وَمَنْ أَسَاءَ فَعَلَيْهَا وَمَا رَبُّكَ بِظَلَّامٍ لِلْعَبِيدِ","prev":{"a":45,"text":"وَلَقَدْ آتَيْنَا مُوسَى الْكِتَابَ فَاخْتُلِفَ فِيهِ وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِنْ رَبِّكَ لَقُضِيَ بَيْنَهُمْ وَإِنَّهُمْ لَفِي شَكٍّ مِنْهُ مُرِيبٍ"},"next":{"a":47,"text":"إِلَيْهِ يُرَدُّ عِلْمُ السَّاعَةِ وَمَا تَخْرُجُ مِنْ ثَمَرَاتٍ مِنْ أَكْمَامِهَا وَمَا تَحْمِلُ مِنْ أُنْثَى وَلَا تَضَعُ إِلَّا بِعِلْمِهِ وَيَوْمَ يُنَادِيهِمْ أَيْنَ شُرَكَائِي قَالُوا آذَنَّاكَ مَا مِنَّا مِنْ شَهِيدٍ"},"context":"بعد ذكر الاختلاف في كتاب موسى.","reason":"العمل الصالح لنفسك، والإساءة عليها؛ لا ظلم في الحساب."},{"i":5,"of":5,"s":50,"surah":"ق","a":29,"text":"مَا يُبَدَّلُ الْقَوْلُ لَدَيَّ وَمَا أَنَا بِظَلَّامٍ لِلْعَبِيدِ","prev":{"a":28,"text":"قَالَ لَا تَخْتَصِمُوا لَدَيَّ وَقَدْ قَدَّمْتُ إِلَيْكُمْ بِالْوَعِيدِ"},"next":{"a":30,"text":"يَوْمَ نَقُولُ لِجَهَنَّمَ هَلِ امْتَلَأْتِ وَتَقُولُ هَلْ مِنْ مَزِيدٍ"},"context":"يوم القيامة يختصم الإنسان وقرينه.","reason":"قالها الله بنفسه: قد قدّمت الوعيد، فلا تبديل ولا ظلم."}],"hadiths":[{"i":1,"of":1,"text":"عَنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم فيما رَوى عَنِ اللهِ تَبارَكَ وتَعالى، أنَّه قال: يا عِبادي، إنِّي حَرَّمتُ الظُّلمَ على نَفسي، وجَعَلتُه بينَكُم مُحَرَّمًا، فلا تَظالَموا، يا عِبادي، كُلُّكُم ضالٌّ إلَّا مَن هَدَيتُه، فاستَهدوني أهدِكُم، يا عِبادي، كُلُّكُم جائِعٌ إلَّا مَن أطعَمتُه، فاستَطعِموني أُطعِمكُم، يا عِبادي، كُلُّكُم عارٍ إلَّا مَن كَسَوتُه، فاستَكسوني أكسُكُم، يا عِبادي، إنَّكُم تُخطِئونَ باللَّيلِ والنَّهارِ، وأنا أغفِرُ الذُّنوبَ جَميعًا، فاستَغفِروني أغفِرْ لَكُم، يا عِبادي، إنَّكُم لَن تَبلُغوا ضَرِّي فتَضُرُّوني، ولَن تَبلُغوا نَفعي فتَنفَعوني، يا عِبادي، لو أنَّ أوَّلَكُم وآخِرَكُم وإنسَكُم وجِنَّكُم كانوا على أتقى قَلبِ رَجُلٍ واحِدٍ مِنكُم، ما زادَ ذلك في مُلكي شيئًا، يا عِبادي، لو أنَّ أوَّلَكُم وآخِرَكُم وإنسَكُم وجِنَّكُم كانوا على أفجَرِ قَلبِ رَجُلٍ واحِدٍ ما نَقَصَ ذلك مِن مُلكي شيئًا، يا عِبادي، لو أنَّ أوَّلَكُم وآخِرَكُم وإنسَكُم وجِنَّكُم قاموا في صَعيدٍ واحِدٍ فسَألوني، فأعطَيتُ كُلَّ إنسانٍ مَسألَتَه، ما نَقَصَ ذلك ممَّا عِندي إلَّا كما يَنقُصُ المِخيَطُ إذا أُدخِلَ البَحرَ، يا عِبادي، إنَّما هي أعمالُكُم أُحصيها لَكُم، ثُمَّ أوفِّيكُم إيَّاها، فمَن وجَدَ خَيرًا فليَحمَدِ اللَّهَ، ومَن وجَدَ غيرَ ذلك فلا يَلومَنَّ إلَّا نَفسَه. وفي روايةٍ: إنِّي حَرَّمتُ على نَفسي الظُّلمَ وعلى عِبادي، فلا تَظالَموا.","narrator":"أبو ذر الغفاري","source":"صحيح مسلم 2577","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/kUubJmRB","nameForm":"ليس بظلام للعبيد / ما ربك بظلام للعبيد / ما أنا بظلام للعبيد"}],"sunnah":{},"situations":[{"situationId":25,"verses":[{"i":2,"strength":"direct","bridge":"إن اعترضت على عقوبة فاعلم: ﴿ذَلِكَ بِمَا قَدَّمَتْ أَيْدِيكُمْ﴾."}],"hadiths":[]},{"situationId":76,"verses":[{"i":4,"strength":"direct","bridge":"عملك يعود عليك: ﴿مَنْ عَمِلَ صَالِحًا فَلِنَفْسِهِ وَمَنْ أَسَاءَ فَعَلَيْهَا﴾."}],"hadiths":[]},{"situationId":108,"verses":[{"i":1,"strength":"direct","bridge":"ما تلقاه بسبب عملك، فـ﴿ذَلِكَ بِمَا قَدَّمَتْ أَيْدِيكُمْ وَأَنَّ اللَّهَ لَيْسَ بِظَلَّامٍ لِلْعَبِيدِ﴾."}],"hadiths":[]},{"situationId":139,"verses":[{"i":3,"strength":"direct","bridge":"من صد عن سبيل الله فجزاؤه ﴿بِمَا قَدَّمَتْ يَدَاكَ وَأَنَّ اللَّهَ لَيْسَ بِظَلَّامٍ لِلْعَبِيدِ﴾."}],"hadiths":[]},{"situationId":183,"verses":[{"i":5,"strength":"direct","bridge":"الوعيد قُدّم إليك اليوم؛ ﴿مَا يُبَدَّلُ الْقَوْلُ لَدَيَّ وَمَا أَنَا بِظَلَّامٍ لِلْعَبِيدِ﴾."}],"hadiths":[]}]},{"id":227,"name":"وما كان ربك نسيًّا","compound":true,"meaning":"وما كان ربك نسيًّا: الله لا ينسى شيئًا، ولا يترك عبده.","teaches":"1. قالها جبريل حين أبطأ الوحي.\n2. التأخير بأمر الله، لا عن نسيان.","whenRecall":"- حين يتأخر عنك ما تنتظره.\n- حين تشعر أنك منسي.","whenPray":"1. يا من لا ينسى، لا تنسني.","summary":"إبطاء ما تنتظر ليس نسيانًا؛ ربك لا ينسى.","verses":[{"i":1,"of":1,"s":19,"surah":"مريم","a":64,"text":"وَمَا نَتَنَزَّلُ إِلَّا بِأَمْرِ رَبِّكَ لَهُ مَا بَيْنَ أَيْدِينَا وَمَا خَلْفَنَا وَمَا بَيْنَ ذَلِكَ وَمَا كَانَ رَبُّكَ نَسِيًّا","prev":{"a":63,"text":"تِلْكَ الْجَنَّةُ الَّتِي نُورِثُ مِنْ عِبَادِنَا مَنْ كَانَ تَقِيًّا"},"next":{"a":65,"text":"رَبُّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا فَاعْبُدْهُ وَاصْطَبِرْ لِعِبَادَتِهِ هَلْ تَعْلَمُ لَهُ سَمِيًّا"},"context":"قول جبريل حين استبطأ النبي ﷺ نزول الوحي.","reason":"النزول بأمر الله، وله ما بين الأيدي والخلف، وهو لا ينسى."}],"hadiths":[{"i":1,"of":2,"text":"قال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ لِجِبريلَ: ما يَمنَعُكَ أنْ تَزورَنا أَكثَرَ ممَّا تَزورُنا؟ قال: فنزَلَت: {وَمَا نَتَنَزَّلُ إلَّا بِأَمْرِ رَبِّكَ لَهُ مَا بَيْنَ أَيْدِينَا وَمَا خَلْفَنَا وَمَا بَيْنَ ذَلِكَ وَمَا كَانَ رَبُّكَ نَسِيًّا} [مريم: 64] قال: وكان ذلك الجَوابُ لِمحمدٍ صلَّى اللهُ عليه وسلَّمَ.","narrator":"عبدالله بن عباس","source":"تخريج المسند لشعيب 3365","grade":"صحيح","judgment":"إسناده صحيح على شرط البخاري","url":"https://dorar.net/h/cG7M28Xa","nameForm":"وما كان ربك نسيًّا"},{"i":2,"of":2,"text":"«ما أحَلَّ اللهُ في كتابهِ فهوَ حلالٌ، وما حرَّمَ فهو حرامٌ، وما سَكَتَ عنه فهو عافيةٌ، فاقبَلوا مِنَ اللهِ عافيتَهُ، فإنَّ اللهَ لمْ يكنْ نَسِيًّا». ثُمَّ تلا هذه الآيةَ: {وَمَا كَانَ رَبُّكَ نَسِيًّا} [مريم: 64].","narrator":"أبو الدرداء","source":"المستدرك على الصحيحين 3463","grade":"صحيح","judgment":"صحيح الإسناد","url":"https://dorar.net/h/7tG49oBf","nameForm":"وما كان ربك نسيًّا"}],"sunnah":{},"situations":[{"situationId":10,"verses":[{"i":1,"strength":"direct","bridge":"إذا تأخر عنك فرج تنتظره، فتذكر: ﴿وَمَا كَانَ رَبُّكَ نَسِيًّا﴾."}],"hadiths":[]}]},{"id":228,"name":"لا تحسبن الله غافلًا عما يعمل الظالمون","compound":true,"meaning":"لا تحسبن الله غافلًا عما يعمل الظالمون: إمهال الظالم ليس غفلة، بل تأخير إلى يوم الحساب.","teaches":"1. جاءت بعد دعاء إبراهيم يوم يقوم الحساب.\n2. التأخير ليوم تشخص فيه الأبصار.","whenRecall":"- حين ترى ظالمًا ممهلًا.\n- حين تُظلم ولا ترى الجزاء.","whenPray":"1. اللهم إنك لست بغافل، فخذ لي حقي.","summary":"إمهال الظالم ليس غفلة؛ إنما يؤخره ليوم تشخص فيه الأبصار.","verses":[{"i":1,"of":1,"s":14,"surah":"إبراهيم","a":42,"text":"وَلَا تَحْسَبَنَّ اللَّهَ غَافِلًا عَمَّا يَعْمَلُ الظَّالِمُونَ إِنَّمَا يُؤَخِّرُهُمْ لِيَوْمٍ تَشْخَصُ فِيهِ الْأَبْصَارُ","prev":{"a":41,"text":"رَبَّنَا اغْفِرْ لِي وَلِوَالِدَيَّ وَلِلْمُؤْمِنِينَ يَوْمَ يَقُومُ الْحِسَابُ"},"next":{"a":43,"text":"مُهْطِعِينَ مُقْنِعِي رُءُوسِهِمْ لَا يَرْتَدُّ إِلَيْهِمْ طَرْفُهُمْ وَأَفْئِدَتُهُمْ هَوَاءٌ"},"context":"بعد دعاء إبراهيم: ربنا اغفر لي ولوالدي يوم يقوم الحساب.","reason":"نفى الغفلة وبيّن حكمة التأخير."}],"hadiths":[],"situations":[{"situationId":36,"verses":[{"i":1,"strength":"direct","bridge":"إذا رأيت الظالم ممهلًا فـ﴿وَلَا تَحْسَبَنَّ اللَّهَ غَافِلًا عَمَّا يَعْمَلُ الظَّالِمُونَ﴾."}],"hadiths":[]}]},{"id":229,"name":"ما كان الله معذبهم وهم يستغفرون","compound":true,"meaning":"ما كان الله معذبهم وهم يستغفرون: الاستغفار أمانٌ من العذاب.","teaches":"1. أمانان: وجود النبي ﷺ فيهم، والاستغفار.\n2. قيلت بعد أن طلب المشركون العذاب.","whenRecall":"- حين تخاف العقوبة بعد ذنب.\n- حين تكثر الفتن والبلاء.","whenPray":"1. أكثِر من الاستغفار؛ فهو أمان باقٍ.","summary":"الاستغفار أمان من العذاب ما دام العبد مستغفرًا.","verses":[{"i":1,"of":1,"s":8,"surah":"الأنفال","a":33,"text":"وَمَا كَانَ اللَّهُ لِيُعَذِّبَهُمْ وَأَنْتَ فِيهِمْ وَمَا كَانَ اللَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ","prev":{"a":32,"text":"وَإِذْ قَالُوا اللَّهُمَّ إِنْ كَانَ هَذَا هُوَ الْحَقَّ مِنْ عِنْدِكَ فَأَمْطِرْ عَلَيْنَا حِجَارَةً مِنَ السَّمَاءِ أَوِ ائْتِنَا بِعَذَابٍ أَلِيمٍ"},"next":{"a":34,"text":"وَمَا لَهُمْ أَلَّا يُعَذِّبَهُمُ اللَّهُ وَهُمْ يَصُدُّونَ عَنِ الْمَسْجِدِ الْحَرَامِ وَمَا كَانُوا أَوْلِيَاءَهُ إِنْ أَوْلِيَاؤُهُ إِلَّا الْمُتَّقُونَ وَلَكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ"},"context":"قبلها: المشركون يقولون إن كان هذا هو الحق فأمطر علينا حجارة.","reason":"رغم طلبهم العذاب لم يعذبهم لوجود النبي ﷺ والاستغفار."}],"hadiths":[{"i":1,"of":2,"text":"أمانانِ كانا على عَهدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، رُفِعَ أحَدُهما، وبَقيَ الآخَرُ: {وَمَا كَانَ اللَّهُ لِيُعَذِّبَهُمْ وَأَنْتَ فِيهِمْ وَمَا كَانَ اللَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ} [الأنفال: 33].","narrator":"أبو موسى الأشعري","source":"تخريج المسند لشعيب 19506","grade":"صحيح","judgment":"صحيح لغيره","url":"https://dorar.net/h/4C4uf1c3","nameForm":"ما كان الله معذبهم وهم يستغفرون"},{"i":2,"of":2,"text":"قال أبو جَهلٍ: اللَّهمَّ إن كان هذا هو الحَقَّ مِن عِندِكَ فأمطِرْ علينا حِجارةً مِنَ السَّماءِ، أوِ ائتِنا بعَذابٍ أليمٍ، فنَزَلَت: {وما كان اللهُ ليُعَذِّبَهم وأنتَ فيهم وما كان اللهُ مُعَذِّبَهم وهم يَستَغفِرونَ وما لهم ألَّا يُعَذِّبَهمُ اللهُ وهم يَصُدُّونَ عَنِ المَسجِدِ الحَرامِ} [الأنفال: 33 - 34] إلى آخِرِ الآيةِ.","narrator":"أنس بن مالك","source":"صحيح مسلم 2796","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/vTKhcYT6","nameForm":"ما كان الله معذبهم وهم يستغفرون"}],"sunnah":{},"situations":[{"situationId":15,"verses":[{"i":1,"strength":"direct","bridge":"إذا خفت عاقبة ذنبك فاستغفر؛ ﴿وَمَا كَانَ اللَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ﴾."}],"hadiths":[]}]},{"id":230,"name":"لم يكن ربك مهلك القرى بظلم وأهلها غافلون","compound":true,"meaning":"لم يكن ربك مهلك القرى بظلم: لا يهلك الله قومًا قبل أن ينذرهم.","teaches":"1. جاءت بعد سؤال الجن والإنس: ألم يأتكم رسل منكم؟\n2. الإنذار قبل العقوبة سنة الله.","whenRecall":"- حين تسأل عن عدل الله فيمن لم تبلغه الرسالة.","whenPray":"1. اللهم لا تجعلنا من الغافلين.","summary":"لا هلاك قبل إنذار؛ وهذا من عدله.","verses":[{"i":1,"of":1,"s":6,"surah":"الأنعام","a":131,"text":"ذَلِكَ أَنْ لَمْ يَكُنْ رَبُّكَ مُهْلِكَ الْقُرَى بِظُلْمٍ وَأَهْلُهَا غَافِلُونَ","prev":{"a":130,"text":"يَا مَعْشَرَ الْجِنِّ وَالْإِنْسِ أَلَمْ يَأْتِكُمْ رُسُلٌ مِنْكُمْ يَقُصُّونَ عَلَيْكُمْ آيَاتِي وَيُنْذِرُونَكُمْ لِقَاءَ يَوْمِكُمْ هَذَا قَالُوا شَهِدْنَا عَلَى أَنْفُسِنَا وَغَرَّتْهُمُ الْحَيَاةُ الدُّنْيَا وَشَهِدُوا عَلَى أَنْفُسِهِمْ أَنَّهُمْ كَانُوا كَافِرِينَ"},"next":{"a":132,"text":"وَلِكُلٍّ دَرَجَاتٌ مِمَّا عَمِلُوا وَمَا رَبُّكَ بِغَافِلٍ عَمَّا يَعْمَلُونَ"},"context":"قبلها: يا معشر الجن والإنس ألم يأتكم رسل منكم.","reason":"إرسال الرسل قبل العذاب يقطع حجة الغافلين."}],"hadiths":[],"situations":[{"situationId":108,"verses":[{"i":1,"strength":"direct","bridge":"عدل الله ألا يعاقب قبل البيان: ﴿أَنْ لَمْ يَكُنْ رَبُّكَ مُهْلِكَ الْقُرَى بِظُلْمٍ وَأَهْلُهَا غَافِلُونَ﴾."}],"hadiths":[]}]},{"id":231,"name":"ما كان ربك مهلك القرى حتى يبعث في أمها رسولًا يتلو عليهم آياتنا","compound":true,"meaning":"ما كان ربك مهلك القرى حتى يبعث في أمها رسولًا: لا يقع الهلاك إلا بعد البلاغ، ولا يقع إلا بظلم أهلها.","teaches":"1. جاءت بعد ذكر القرى التي بطرت معيشتها.\n2. شرطان: بلوغ الرسالة، وظلم الأهل.","whenRecall":"- حين ترى نعمة قوم تزول.\n- حين تبطر النعمة.","whenPray":"1. اللهم لا تجعلنا ممن بطر معيشته.","summary":"الهلاك لا يأتي إلا بعد رسول وظلم؛ فاحذر بطر النعمة.","verses":[{"i":1,"of":1,"s":28,"surah":"القصص","a":59,"text":"وَمَا كَانَ رَبُّكَ مُهْلِكَ الْقُرَى حَتَّى يَبْعَثَ فِي أُمِّهَا رَسُولًا يَتْلُو عَلَيْهِمْ آيَاتِنَا وَمَا كُنَّا مُهْلِكِي الْقُرَى إِلَّا وَأَهْلُهَا ظَالِمُونَ","prev":{"a":58,"text":"وَكَمْ أَهْلَكْنَا مِنْ قَرْيَةٍ بَطِرَتْ مَعِيشَتَهَا فَتِلْكَ مَسَاكِنُهُمْ لَمْ تُسْكَنْ مِنْ بَعْدِهِمْ إِلَّا قَلِيلًا وَكُنَّا نَحْنُ الْوَارِثِينَ"},"next":{"a":60,"text":"وَمَا أُوتِيتُمْ مِنْ شَيْءٍ فَمَتَاعُ الْحَيَاةِ الدُّنْيَا وَزِينَتُهَا وَمَا عِنْدَ اللَّهِ خَيْرٌ وَأَبْقَى أَفَلَا تَعْقِلُونَ"},"context":"قبلها: كم أهلكنا من قرية بطرت معيشتها.","reason":"بيّن أن الهلاك بعد البلاغ وبسبب الظلم."}],"hadiths":[],"situations":[{"situationId":92,"verses":[{"i":1,"strength":"direct","bridge":"إذا بطرت نعمتك فتذكر: ﴿وَمَا كُنَّا مُهْلِكِي الْقُرَى إِلَّا وَأَهْلُهَا ظَالِمُونَ﴾."}],"hadiths":[]}]},{"id":232,"name":"ما كنت متخذ المضلين عضدًا","compound":true,"meaning":"ما كنت متخذ المضلين عضدًا: الله لم يستعن بأحد في الخلق، فضلًا عن المضلين.","teaches":"1. جاءت بعد قصة إبليس واتخاذ ذريته أولياء.\n2. لم يُشهدهم خلق السماوات ولا أنفسهم.","whenRecall":"- حين تُعجب بمن يضلك.\n- حين تتخذ قدوة تبعدك عن الله.","whenPray":"1. اللهم لا تجعل لي وليًّا من دونك.","summary":"من لم يشهد الخلق ولم يُعِن عليه، كيف يُتخذ وليًّا من دون الله؟","verses":[{"i":1,"of":1,"s":18,"surah":"الكهف","a":51,"text":"مَا أَشْهَدْتُهُمْ خَلْقَ السَّمَاوَاتِ وَالْأَرْضِ وَلَا خَلْقَ أَنْفُسِهِمْ وَمَا كُنْتُ مُتَّخِذَ الْمُضِلِّينَ عَضُدًا","prev":{"a":50,"text":"وَإِذْ قُلْنَا لِلْمَلَائِكَةِ اسْجُدُوا لِآدَمَ فَسَجَدُوا إِلَّا إِبْلِيسَ كَانَ مِنَ الْجِنِّ فَفَسَقَ عَنْ أَمْرِ رَبِّهِ أَفَتَتَّخِذُونَهُ وَذُرِّيَّتَهُ أَوْلِيَاءَ مِنْ دُونِي وَهُمْ لَكُمْ عَدُوٌّ بِئْسَ لِلظَّالِمِينَ بَدَلًا"},"next":{"a":52,"text":"وَيَوْمَ يَقُولُ نَادُوا شُرَكَائِيَ الَّذِينَ زَعَمْتُمْ فَدَعَوْهُمْ فَلَمْ يَسْتَجِيبُوا لَهُمْ وَجَعَلْنَا بَيْنَهُمْ مَوْبِقًا"},"context":"قبلها: اتخاذ إبليس وذريته أولياء من دون الله.","reason":"ردّ على تولي الشيطان: لم يكن معينًا في الخلق."}],"hadiths":[],"situations":[{"situationId":117,"verses":[{"i":1,"strength":"direct","bridge":"إن اتخذت قدوة تضلك فتذكر: ﴿وَمَا كُنْتُ مُتَّخِذَ الْمُضِلِّينَ عَضُدًا﴾."}],"hadiths":[]}]},{"id":233,"name":"لا تحسبن الله مخلف وعده رسله","compound":true,"meaning":"لا تحسبن الله مخلف وعده رسله: وعده للرسل بالنصر حق لا يُخلف.","teaches":"1. جاءت بعد ذكر مكر الكافرين وإن كان لتزول منه الجبال.\n2. خُتمت بعزيز ذو انتقام.","whenRecall":"- حين يتأخر النصر.\n- حين ترى مكرًا عظيمًا.","whenPray":"1. اللهم إنك لا تخلف وعدك، فانصر الحق.","summary":"المكر مهما عظم لا يخلف وعد الله لرسله.","verses":[{"i":1,"of":1,"s":14,"surah":"إبراهيم","a":47,"text":"فَلَا تَحْسَبَنَّ اللَّهَ مُخْلِفَ وَعْدِهِ رُسُلَهُ إِنَّ اللَّهَ عَزِيزٌ ذُو انْتِقَامٍ","prev":{"a":46,"text":"وَقَدْ مَكَرُوا مَكْرَهُمْ وَعِنْدَ اللَّهِ مَكْرُهُمْ وَإِنْ كَانَ مَكْرُهُمْ لِتَزُولَ مِنْهُ الْجِبَالُ"},"next":{"a":48,"text":"يَوْمَ تُبَدَّلُ الْأَرْضُ غَيْرَ الْأَرْضِ وَالسَّمَاوَاتُ وَبَرَزُوا لِلَّهِ الْوَاحِدِ الْقَهَّارِ"},"context":"قبلها: وقد مكروا مكرهم وعند الله مكرهم.","reason":"مكرهم عظيم لكن الوعد لا يُخلف، والله عزيز ذو انتقام."}],"hadiths":[],"situations":[{"situationId":38,"verses":[{"i":1,"strength":"direct","bridge":"إن استبطأت نصر الحق فـ﴿فَلَا تَحْسَبَنَّ اللَّهَ مُخْلِفَ وَعْدِهِ رُسُلَهُ﴾."}],"hadiths":[]}]},{"id":234,"name":"عنده حُسن المآب","compound":true,"meaning":"عنده حسن المآب: المرجع الحسن والعاقبة الطيبة عند الله.","teaches":"1. جاءت بعد تعداد شهوات الدنيا: النساء والبنين والذهب.\n2. كل ذلك متاع، والمآب الحسن عنده.","whenRecall":"- حين يشتد تعلقك بزينة الدنيا.","whenPray":"1. اللهم اجعل مآبي إليك حسنًا.","summary":"زينة الدنيا متاع، وحسن المآب عند الله.","verses":[{"i":1,"of":1,"s":3,"surah":"آل عمران","a":14,"text":"زُيِّنَ لِلنَّاسِ حُبُّ الشَّهَوَاتِ مِنَ النِّسَاءِ وَالْبَنِينَ وَالْقَنَاطِيرِ الْمُقَنْطَرَةِ مِنَ الذَّهَبِ وَالْفِضَّةِ وَالْخَيْلِ الْمُسَوَّمَةِ وَالْأَنْعَامِ وَالْحَرْثِ ذَلِكَ مَتَاعُ الْحَيَاةِ الدُّنْيَا وَاللَّهُ عِنْدَهُ حُسْنُ الْمَآبِ","prev":{"a":13,"text":"قَدْ كَانَ لَكُمْ آيَةٌ فِي فِئَتَيْنِ الْتَقَتَا فِئَةٌ تُقَاتِلُ فِي سَبِيلِ اللَّهِ وَأُخْرَى كَافِرَةٌ يَرَوْنَهُمْ مِثْلَيْهِمْ رَأْيَ الْعَيْنِ وَاللَّهُ يُؤَيِّدُ بِنَصْرِهِ مَنْ يَشَاءُ إِنَّ فِي ذَلِكَ لَعِبْرَةً لِأُولِي الْأَبْصَارِ"},"next":{"a":15,"text":"قُلْ أَؤُنَبِّئُكُمْ بِخَيْرٍ مِنْ ذَلِكُمْ لِلَّذِينَ اتَّقَوْا عِنْدَ رَبِّهِمْ جَنَّاتٌ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا وَأَزْوَاجٌ مُطَهَّرَةٌ وَرِضْوَانٌ مِنَ اللَّهِ وَاللَّهُ بَصِيرٌ بِالْعِبَادِ"},"context":"بعد آية الفئتين يوم بدر.","reason":"عدّد الشهوات ثم ختم بأنها متاع وأن حسن المرجع عنده."}],"hadiths":[],"situations":[{"situationId":93,"verses":[{"i":1,"strength":"direct","bridge":"إذا تعلق قلبك بالمال والأهل فاقرأ: ﴿ذَلِكَ مَتَاعُ الْحَيَاةِ الدُّنْيَا وَاللَّهُ عِنْدَهُ حُسْنُ الْمَآبِ﴾."}],"hadiths":[]}]},{"id":235,"name":"عنده حُسن الثواب","compound":true,"meaning":"عنده حسن الثواب: أحسن الجزاء عند الله لمن عمل وصبر.","teaches":"1. جاءت جوابًا لدعاء أولي الألباب.\n2. لا يضيع عمل ذكر ولا أنثى.","whenRecall":"- حين تُؤذى في سبيل الله.\n- حين تخاف ضياع عملك.","whenPray":"1. ربنا آتنا ما وعدتنا على رسلك.","summary":"لا يضيع عند الله عمل، وعنده حسن الثواب.","verses":[{"i":1,"of":1,"s":3,"surah":"آل عمران","a":195,"text":"فَاسْتَجَابَ لَهُمْ رَبُّهُمْ أَنِّي لَا أُضِيعُ عَمَلَ عَامِلٍ مِنْكُمْ مِنْ ذَكَرٍ أَوْ أُنْثَى بَعْضُكُمْ مِنْ بَعْضٍ فَالَّذِينَ هَاجَرُوا وَأُخْرِجُوا مِنْ دِيَارِهِمْ وَأُوذُوا فِي سَبِيلِي وَقَاتَلُوا وَقُتِلُوا لَأُكَفِّرَنَّ عَنْهُمْ سَيِّئَاتِهِمْ وَلَأُدْخِلَنَّهُمْ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ ثَوَابًا مِنْ عِنْدِ اللَّهِ وَاللَّهُ عِنْدَهُ حُسْنُ الثَّوَابِ","prev":{"a":194,"text":"رَبَّنَا وَآتِنَا مَا وَعَدْتَنَا عَلَى رُسُلِكَ وَلَا تُخْزِنَا يَوْمَ الْقِيَامَةِ إِنَّكَ لَا تُخْلِفُ الْمِيعَادَ"},"next":{"a":196,"text":"لَا يَغُرَّنَّكَ تَقَلُّبُ الَّذِينَ كَفَرُوا فِي الْبِلَادِ"},"context":"استجابة الله لدعاء أولي الألباب في آخر آل عمران.","reason":"وعد بتكفير السيئات وإدخال الجنات لمن هاجر وأوذي، وحسن الثواب عنده."}],"hadiths":[],"situations":[{"situationId":171,"verses":[{"i":1,"strength":"direct","bridge":"إن أُوذيت في سبيل الله فاعلم: ﴿أَنِّي لَا أُضِيعُ عَمَلَ عَامِلٍ مِنْكُمْ﴾."}],"hadiths":[]}]},{"id":236,"name":"عنده أجر عظيم","compound":true,"meaning":"عنده أجر عظيم: الثواب الكبير مدّخر عند الله لمن صبر على الفتنة.","teaches":"1. مرتان بعد ذكر فتنة المال والولد.\n2. ومرة بعد ذكر الجنة والخلود.","whenRecall":"- حين يشغلك المال والولد عن الطاعة.\n- حين تؤثر الله على أهلك.","whenPray":"1. اللهم اجعل أموالنا وأولادنا عونًا على طاعتك.","summary":"المال والولد فتنة، وما عند الله أعظم.","verses":[{"i":1,"of":3,"s":8,"surah":"الأنفال","a":28,"text":"وَاعْلَمُوا أَنَّمَا أَمْوَالُكُمْ وَأَوْلَادُكُمْ فِتْنَةٌ وَأَنَّ اللَّهَ عِنْدَهُ أَجْرٌ عَظِيمٌ","prev":{"a":27,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَخُونُوا اللَّهَ وَالرَّسُولَ وَتَخُونُوا أَمَانَاتِكُمْ وَأَنْتُمْ تَعْلَمُونَ"},"next":{"a":29,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ تَتَّقُوا اللَّهَ يَجْعَلْ لَكُمْ فُرْقَانًا وَيُكَفِّرْ عَنْكُمْ سَيِّئَاتِكُمْ وَيَغْفِرْ لَكُمْ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ"},"context":"قبلها: النهي عن خيانة الله والرسول والأمانات.","reason":"المال والولد قد يدفعان إلى الخيانة، فذكّر بالأجر العظيم."},{"i":2,"of":3,"s":9,"surah":"التوبة","a":22,"text":"خَالِدِينَ فِيهَا أَبَدًا إِنَّ اللَّهَ عِنْدَهُ أَجْرٌ عَظِيمٌ","prev":{"a":21,"text":"يُبَشِّرُهُمْ رَبُّهُمْ بِرَحْمَةٍ مِنْهُ وَرِضْوَانٍ وَجَنَّاتٍ لَهُمْ فِيهَا نَعِيمٌ مُقِيمٌ"},"next":{"a":23,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَتَّخِذُوا آبَاءَكُمْ وَإِخْوَانَكُمْ أَوْلِيَاءَ إِنِ اسْتَحَبُّوا الْكُفْرَ عَلَى الْإِيمَانِ وَمَنْ يَتَوَلَّهُمْ مِنْكُمْ فَأُولَئِكَ هُمُ الظَّالِمُونَ"},"context":"بشارة المؤمنين المهاجرين المجاهدين بالرحمة والرضوان والجنات.","reason":"خلود في الجنة، وأجر عظيم فوق ذلك."},{"i":3,"of":3,"s":64,"surah":"التغابن","a":15,"text":"إِنَّمَا أَمْوَالُكُمْ وَأَوْلَادُكُمْ فِتْنَةٌ وَاللَّهُ عِنْدَهُ أَجْرٌ عَظِيمٌ","prev":{"a":14,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنَّ مِنْ أَزْوَاجِكُمْ وَأَوْلَادِكُمْ عَدُوًّا لَكُمْ فَاحْذَرُوهُمْ وَإِنْ تَعْفُوا وَتَصْفَحُوا وَتَغْفِرُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ"},"next":{"a":16,"text":"فَاتَّقُوا اللَّهَ مَا اسْتَطَعْتُمْ وَاسْمَعُوا وَأَطِيعُوا وَأَنْفِقُوا خَيْرًا لِأَنْفُسِكُمْ وَمَنْ يُوقَ شُحَّ نَفْسِهِ فَأُولَئِكَ هُمُ الْمُفْلِحُونَ"},"context":"قبلها: إن من أزواجكم وأولادكم عدوًا لكم فاحذروهم.","reason":"الأهل قد يكونون فتنة، والأجر العظيم لمن صبر وعفا."}],"hadiths":[],"situations":[{"situationId":52,"verses":[{"i":3,"strength":"direct","bridge":"إن وجدت من أهلك ما يصدك، فـ﴿إِنَّمَا أَمْوَالُكُمْ وَأَوْلَادُكُمْ فِتْنَةٌ وَاللَّهُ عِنْدَهُ أَجْرٌ عَظِيمٌ﴾."}],"hadiths":[]},{"situationId":93,"verses":[{"i":1,"strength":"direct","bridge":"إذا جرّك المال والولد إلى ما لا يرضي الله فتذكر: ﴿وَأَنَّ اللَّهَ عِنْدَهُ أَجْرٌ عَظِيمٌ﴾."}],"hadiths":[]},{"situationId":140,"verses":[{"i":2,"strength":"direct","bridge":"من بذل في سبيل الله فبشراه: ﴿خَالِدِينَ فِيهَا أَبَدًا إِنَّ اللَّهَ عِنْدَهُ أَجْرٌ عَظِيمٌ﴾."}],"hadiths":[]}]}]}