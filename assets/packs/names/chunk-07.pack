{"schema":1,"kind":"names-chunk","version":"names-88e4add036a8","names":[{"id":237,"name":"عنده أم الكتاب","compound":true,"meaning":"عنده أم الكتاب: أصل الكتاب الذي فيه المقادير ثابت عنده.","teaches":"1. يمحو الله ما يشاء ويثبت مما في صحف الملائكة.\n2. والأصل محفوظ عنده لا يتغير.","whenRecall":"- حين تقلق من قدر مكتوب.\n- حين تدعو وتخاف أن القدر لا يتغير.","whenPray":"1. أن تدعو بقلب مطمئن: الله يمحو ما يشاء ويثبت.","summary":"ما تخافه في صحف المقادير، الله يمحو منه ويثبت؛ وأصل الكتاب عنده.","verses":[{"i":1,"of":1,"s":13,"surah":"الرعد","a":39,"text":"يَمْحُو اللَّهُ مَا يَشَاءُ وَيُثْبِتُ وَعِنْدَهُ أُمُّ الْكِتَابِ","prev":{"a":38,"text":"وَلَقَدْ أَرْسَلْنَا رُسُلًا مِنْ قَبْلِكَ وَجَعَلْنَا لَهُمْ أَزْوَاجًا وَذُرِّيَّةً وَمَا كَانَ لِرَسُولٍ أَنْ يَأْتِيَ بِآيَةٍ إِلَّا بِإِذْنِ اللَّهِ لِكُلِّ أَجَلٍ كِتَابٌ"},"next":{"a":40,"text":"وَإِنْ مَا نُرِيَنَّكَ بَعْضَ الَّذِي نَعِدُهُمْ أَوْ نَتَوَفَّيَنَّكَ فَإِنَّمَا عَلَيْكَ الْبَلَاغُ وَعَلَيْنَا الْحِسَابُ"},"context":"قبلها: لكل أجل كتاب، وما كان لرسول أن يأتي بآية إلا بإذن الله.","reason":"المحو والإثبات بيده، والأصل عنده."}],"hadiths":[{"i":1,"of":2,"text":"عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهُما في قولِ اللهِ عزَّ وجلَّ: {يَمْحُو اللَّهُ مَا يَشَاء} [الرعد: 39] مِن أَحَدِ الكِتابينِ؛ هما كِتابانِ يمحو اللهُ ما يشاءُ مِن أَحدِهِما ويُثبتُ، وعندَهُ أُمُّ الكتابِ؛ أيْ جُملةُ الكتابِ.","narrator":"عكرمة","source":"المستدرك على الصحيحين 3375","grade":"صحيح","judgment":"غريب صحيح من حديث سليمان التيمي","url":"https://dorar.net/h/PN24tpQ3","nameForm":"عنده أم الكتاب"},{"i":2,"of":2,"text":"أنَّ عمرَ بنَ الخطَّابِ كان يطوفُ بالبيتِ وهو يبكي ، ويقولُ : اللَّهمَّ إن كنتَ كتبتَنا عندك في شِقوةٍ وذنبٍ فإنَّك تمحو ما تشاءُ وتُثبِتُ وعندك أمُّ الكتابِ فاجعلْها سعادةً ومغفرةً","narrator":"عبدالرحمن بن مل النهدي أبو عثمان","source":"مسند الفاروق 2/593","grade":"حسن","judgment":"إسناده حسن","url":"https://dorar.net/h/P87Kafp3","nameForm":"عنده أم الكتاب"}],"sunnah":{},"situations":[{"situationId":164,"verses":[{"i":1,"strength":"direct","bridge":"لا تيأس من الدعاء؛ ﴿يَمْحُو اللَّهُ مَا يَشَاءُ وَيُثْبِتُ وَعِنْدَهُ أُمُّ الْكِتَابِ﴾."}],"hadiths":[]}]},{"id":238,"name":"عنده علم الساعة","compound":true,"meaning":"عنده علم الساعة: وقت القيامة لا يعلمه إلا الله.","teaches":"1. من مفاتح الغيب الخمسة في لقمان.\n2. ومقرونة بملكه ورجوع الخلق إليه.","whenRecall":"- حين تقلق مما يخبئه الغد.\n- حين يتكلم الناس في موعد القيامة.","whenPray":"1. اللهم اجعل خير أيامي يوم ألقاك.","summary":"الساعة والغيث والأرحام والغد عند الله؛ فاستعد ولا تتطلع.","verses":[{"i":1,"of":2,"s":31,"surah":"لقمان","a":34,"text":"إِنَّ اللَّهَ عِنْدَهُ عِلْمُ السَّاعَةِ وَيُنَزِّلُ الْغَيْثَ وَيَعْلَمُ مَا فِي الْأَرْحَامِ وَمَا تَدْرِي نَفْسٌ مَاذَا تَكْسِبُ غَدًا وَمَا تَدْرِي نَفْسٌ بِأَيِّ أَرْضٍ تَمُوتُ إِنَّ اللَّهَ عَلِيمٌ خَبِيرٌ","prev":{"a":33,"text":"يَا أَيُّهَا النَّاسُ اتَّقُوا رَبَّكُمْ وَاخْشَوْا يَوْمًا لَا يَجْزِي وَالِدٌ عَنْ وَلَدِهِ وَلَا مَوْلُودٌ هُوَ جَازٍ عَنْ وَالِدِهِ شَيْئًا إِنَّ وَعْدَ اللَّهِ حَقٌّ فَلَا تَغُرَّنَّكُمُ الْحَيَاةُ الدُّنْيَا وَلَا يَغُرَّنَّكُمْ بِاللَّهِ الْغَرُورُ"},"context":"قبلها: اتقوا ربكم واخشوا يومًا لا يجزي والد عن ولده.","reason":"ذكر خمسًا من الغيب لا يعلمها إلا الله."},{"i":2,"of":2,"s":43,"surah":"الزخرف","a":85,"text":"وَتَبَارَكَ الَّذِي لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَعِنْدَهُ عِلْمُ السَّاعَةِ وَإِلَيْهِ تُرْجَعُونَ","prev":{"a":84,"text":"وَهُوَ الَّذِي فِي السَّمَاءِ إِلَهٌ وَفِي الْأَرْضِ إِلَهٌ وَهُوَ الْحَكِيمُ الْعَلِيمُ"},"next":{"a":86,"text":"وَلَا يَمْلِكُ الَّذِينَ يَدْعُونَ مِنْ دُونِهِ الشَّفَاعَةَ إِلَّا مَنْ شَهِدَ بِالْحَقِّ وَهُمْ يَعْلَمُونَ"},"context":"قبلها: هو الذي في السماء إله وفي الأرض إله.","reason":"الملك والعلم بالساعة والرجوع إليه."}],"hadiths":[{"i":1,"of":1,"text":"كانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يَومًا بارِزًا للنَّاسِ، فأتاه رَجُلٌ، فقال: يا رَسولُ اللهِ، ما الإيمانُ؟ قال: أن تُؤمِنَ باللهِ، ومَلائِكَتِه، وكِتابِه، ولقائِه، ورُسُلِه، وتُؤمِنَ بالبَعثِ الآخِرِ، قال: يا رَسولَ اللهِ، ما الإسلامُ؟ قال: الإسلامُ أن تَعبُدَ اللهَ، ولا تُشرِكَ به شيئًا، وتُقيمَ الصَّلاةَ المَكتوبةَ، وتُؤَدِّيَ الزَّكاةَ المَفروضةَ، وتَصومَ رَمَضانَ، قال: يا رَسولَ اللهِ، ما الإحسانُ؟ قال: أن تَعبُدَ اللهَ كَأنَّك تَراه؛ فإنَّك إن لا تَراه فإنَّه يَراك، قال: يا رَسولَ اللهَ، مَتى السَّاعةُ؟ قال: ما المَسؤولُ عَنها بأعلَمَ مِنَ السَّائِلِ، ولَكِن سَأُحَدِّثُك عن أشراطِها: إذا ولَدَتِ الأَمَةُ رَبَّها، فذاك مِن أشراطِها، وإذا كانَتِ العُراةُ الحُفاةُ رُؤوسَ النَّاسِ، فذاك مِن أشراطِها، وإذا تَطاولَ رِعاءُ البَهمِ في البُنيانِ، فذاك مِن أشراطِها، في خَمسٍ لا يَعلَمُهنَّ إلَّا اللهُ، ثُمَّ تَلا صلَّى اللهُ عليه وسلَّم: {إنَّ اللهَ عِندَه عِلمُ السَّاعةِ ويُنَزِّلُ الغَيثَ ويَعلَمُ ما في الأرحامِ وما تَدري نَفسٌ ماذا تَكسِبُ غَدًا وما تَدري نَفسٌ بأيِّ أرضٍ تَموتُ إنَّ اللهَ عَليمٌ خَبيرٌ}. قال: ثُمَّ أدبَرَ الرَّجُلُ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: رُدُّوا عليَّ الرَّجُلَ، فأخَذوا ليَرُدُّوه، فلَم يَرَوا شيئًا، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: هذا جِبريلُ جاءَ ليُعَلِّمَ النَّاسَ دينَهم.","narrator":"أبو هريرة","source":"صحيح مسلم 9","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/rk4KPaEE","nameForm":"عنده علم الساعة"}],"sunnah":{},"situations":[{"situationId":10,"verses":[{"i":1,"strength":"direct","bridge":"إذا قلقت من غدك، ﴿وَمَا تَدْرِي نَفْسٌ مَاذَا تَكْسِبُ غَدًا﴾ وعلمه عند الله."}],"hadiths":[]},{"situationId":113,"verses":[{"i":2,"strength":"direct","bridge":"من سأل عن الساعة فجوابه: ﴿وَعِنْدَهُ عِلْمُ السَّاعَةِ وَإِلَيْهِ تُرْجَعُونَ﴾."}],"hadiths":[]}]},{"id":239,"name":"كل شيء عنده بمقدار","compound":true,"meaning":"كل شيء عنده بمقدار: كل شيء مقدّر بحكمة، لا يزيد ولا ينقص عما قدّره.","teaches":"1. جاءت بعد علمه بما تحمل كل أنثى وما تغيض الأرحام.\n2. الحمل والولادة بمقدار.","whenRecall":"- حين تنتظر الحمل أو تخاف على الجنين.\n- حين تستعجل ما لم يأتِ وقته.","whenPray":"1. اللهم إنك تعلم ما في الأرحام، فاجعله خيرًا.","summary":"ما في الأرحام وما تأخر عنك؛ كله عنده بمقدار.","verses":[{"i":1,"of":1,"s":13,"surah":"الرعد","a":8,"text":"اللَّهُ يَعْلَمُ مَا تَحْمِلُ كُلُّ أُنْثَى وَمَا تَغِيضُ الْأَرْحَامُ وَمَا تَزْدَادُ وَكُلُّ شَيْءٍ عِنْدَهُ بِمِقْدَارٍ","prev":{"a":7,"text":"وَيَقُولُ الَّذِينَ كَفَرُوا لَوْلَا أُنْزِلَ عَلَيْهِ آيَةٌ مِنْ رَبِّهِ إِنَّمَا أَنْتَ مُنْذِرٌ وَلِكُلِّ قَوْمٍ هَادٍ"},"next":{"a":9,"text":"عَالِمُ الْغَيْبِ وَالشَّهَادَةِ الْكَبِيرُ الْمُتَعَالِ"},"context":"قبلها: الكافرون يطلبون آية.","reason":"علمه بالأرحام وتقديره كل شيء من آياته."}],"hadiths":[{"i":1,"of":1,"text":"أرسَلَتِ ابنةُ النَّبيِّ صلَّى اللهُ عليه وسلَّم إليه: إنَّ ابنًا لي قُبِضَ، فأْتِنا، فأرسَلَ يُقرِئُ السَّلامَ، ويقولُ: إنَّ للهِ ما أخَذَ، وله ما أعطى، وكُلٌّ عِندَه بأجَلٍ مُسَمًّى، فلتَصبِرْ ولتَحتَسِبْ، فأرسَلَت إليه تُقسِمُ عليه لَيَأتيَنَّها، فقامَ ومعهُ سَعدُ بنُ عُبادةَ، ومعاذُ بنُ جَبَلٍ، وأُبَيُّ بنُ كَعبٍ، وزَيدُ بنُ ثابِتٍ، ورِجالٌ، فرُفِعَ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم الصَّبيُّ ونَفسُه تَتَقَعقَعُ -قال: حَسِبتُه أنَّه قال كَأنَّها شَنٌّ - ففاضَت عَيناه، فقال سَعدٌ: يا رَسولَ اللهِ، ما هذا؟ فقال: هذه رَحمةٌ جَعَلَها اللهُ في قُلوبِ عِبادِه، وإنَّما يَرحَمُ اللهُ مِن عِبادِه الرُّحَماءَ.","narrator":"أسامة بن زيد","source":"صحيح البخاري 1284","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/JbVgmBmd","nameForm":"كل شيء عنده بمقدار"}],"sunnah":{},"situations":[{"situationId":51,"verses":[{"i":1,"strength":"direct","bridge":"إن تأخر الحمل أو قلقت على الجنين، فـ﴿اللَّهُ يَعْلَمُ مَا تَحْمِلُ كُلُّ أُنْثَى﴾ ﴿وَكُلُّ شَيْءٍ عِنْدَهُ بِمِقْدَارٍ﴾."}],"hadiths":[]}]},{"id":240,"name":"إلى الله المصير","compound":true,"meaning":"إلى الله المصير: المرجع والمآل إلى الله وحده.","teaches":"1. تأتي ختامًا للتحذير: من الموالاة، ومن حمل الأوزار.\n2. الملك في الدنيا له، والمصير في الآخرة إليه.","whenRecall":"- حين تحمل وزر غيرك أو يحمل غيرك وزرك.\n- حين تُغرى بموالاة أعداء الحق.","whenPray":"1. أن تختم أمرك: وإلى الله المصير.","summary":"كل نفس تزكو لنفسها، والمصير إلى الله.","verses":[{"i":1,"of":3,"s":3,"surah":"آل عمران","a":28,"text":"لَا يَتَّخِذِ الْمُؤْمِنُونَ الْكَافِرِينَ أَوْلِيَاءَ مِنْ دُونِ الْمُؤْمِنِينَ وَمَنْ يَفْعَلْ ذَلِكَ فَلَيْسَ مِنَ اللَّهِ فِي شَيْءٍ إِلَّا أَنْ تَتَّقُوا مِنْهُمْ تُقَاةً وَيُحَذِّرُكُمُ اللَّهُ نَفْسَهُ وَإِلَى اللَّهِ الْمَصِيرُ","prev":{"a":27,"text":"تُولِجُ اللَّيْلَ فِي النَّهَارِ وَتُولِجُ النَّهَارَ فِي اللَّيْلِ وَتُخْرِجُ الْحَيَّ مِنَ الْمَيِّتِ وَتُخْرِجُ الْمَيِّتَ مِنَ الْحَيِّ وَتَرْزُقُ مَنْ تَشَاءُ بِغَيْرِ حِسَابٍ"},"next":{"a":29,"text":"قُلْ إِنْ تُخْفُوا مَا فِي صُدُورِكُمْ أَوْ تُبْدُوهُ يَعْلَمْهُ اللَّهُ وَيَعْلَمُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},"context":"بعد ذكر ملك الله وإيلاج الليل في النهار.","reason":"النهي عن موالاة الكافرين، والتحذير من الله نفسه، لأن المصير إليه."},{"i":2,"of":3,"s":24,"surah":"النور","a":42,"text":"وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَإِلَى اللَّهِ الْمَصِيرُ","prev":{"a":41,"text":"أَلَمْ تَرَ أَنَّ اللَّهَ يُسَبِّحُ لَهُ مَنْ فِي السَّمَاوَاتِ وَالْأَرْضِ وَالطَّيْرُ صَافَّاتٍ كُلٌّ قَدْ عَلِمَ صَلَاتَهُ وَتَسْبِيحَهُ وَاللَّهُ عَلِيمٌ بِمَا يَفْعَلُونَ"},"next":{"a":43,"text":"أَلَمْ تَرَ أَنَّ اللَّهَ يُزْجِي سَحَابًا ثُمَّ يُؤَلِّفُ بَيْنَهُ ثُمَّ يَجْعَلُهُ رُكَامًا فَتَرَى الْوَدْقَ يَخْرُجُ مِنْ خِلَالِهِ وَيُنَزِّلُ مِنَ السَّمَاءِ مِنْ جِبَالٍ فِيهَا مِنْ بَرَدٍ فَيُصِيبُ بِهِ مَنْ يَشَاءُ وَيَصْرِفُهُ عَنْ مَنْ يَشَاءُ يَكَادُ سَنَا بَرْقِهِ يَذْهَبُ بِالْأَبْصَارِ"},"context":"قبلها: تسبيح من في السماوات والأرض والطير.","reason":"الملك والمصير كلاهما لله."},{"i":3,"of":3,"s":35,"surah":"فاطر","a":18,"text":"وَلَا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَى وَإِنْ تَدْعُ مُثْقَلَةٌ إِلَى حِمْلِهَا لَا يُحْمَلْ مِنْهُ شَيْءٌ وَلَوْ كَانَ ذَا قُرْبَى إِنَّمَا تُنْذِرُ الَّذِينَ يَخْشَوْنَ رَبَّهُمْ بِالْغَيْبِ وَأَقَامُوا الصَّلَاةَ وَمَنْ تَزَكَّى فَإِنَّمَا يَتَزَكَّى لِنَفْسِهِ وَإِلَى اللَّهِ الْمَصِيرُ","prev":{"a":17,"text":"وَمَا ذَلِكَ عَلَى اللَّهِ بِعَزِيزٍ"},"next":{"a":19,"text":"وَمَا يَسْتَوِي الْأَعْمَى وَالْبَصِيرُ"},"context":"قبلها: إن يشأ يذهبكم ويأت بخلق جديد.","reason":"لا يحمل أحد وزر أحد، ومن تزكى فلنفسه."}],"hadiths":[],"situations":[{"situationId":89,"verses":[{"i":3,"strength":"direct","bridge":"لا ينفعك قريب يوم الحساب؛ ﴿وَمَنْ تَزَكَّى فَإِنَّمَا يَتَزَكَّى لِنَفْسِهِ وَإِلَى اللَّهِ الْمَصِيرُ﴾."}],"hadiths":[]},{"situationId":110,"verses":[{"i":2,"strength":"direct","bridge":"إن نسيت أن الأمر كله لله، ﴿وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَإِلَى اللَّهِ الْمَصِيرُ﴾."}],"hadiths":[]},{"situationId":118,"verses":[{"i":1,"strength":"direct","bridge":"إذا مالت نفسك إلى أهل الباطل، ﴿وَيُحَذِّرُكُمُ اللَّهُ نَفْسَهُ وَإِلَى اللَّهِ الْمَصِيرُ﴾."}],"hadiths":[]}]},{"id":241,"name":"إليه الوسيلة","compound":true,"meaning":"إليه الوسيلة: اطلبوا ما يقربكم إليه من الطاعات.","teaches":"1. أمرٌ بثلاثة: التقوى، وابتغاء الوسيلة، والجهاد.\n2. جاءت بعد ذكر التوبة قبل القدرة عليهم.","whenRecall":"- حين تشعر بالبعد عن الله.\n- حين تبحث عن طريق للقرب.","whenPray":"1. اللهم ارزقني ما يقربني إليك.","summary":"القرب يُطلب بالتقوى والعمل؛ وإليه الوسيلة.","verses":[{"i":1,"of":1,"s":5,"surah":"المائدة","a":35,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَابْتَغُوا إِلَيْهِ الْوَسِيلَةَ وَجَاهِدُوا فِي سَبِيلِهِ لَعَلَّكُمْ تُفْلِحُونَ","prev":{"a":34,"text":"إِلَّا الَّذِينَ تَابُوا مِنْ قَبْلِ أَنْ تَقْدِرُوا عَلَيْهِمْ فَاعْلَمُوا أَنَّ اللَّهَ غَفُورٌ رَحِيمٌ"},"next":{"a":36,"text":"إِنَّ الَّذِينَ كَفَرُوا لَوْ أَنَّ لَهُمْ مَا فِي الْأَرْضِ جَمِيعًا وَمِثْلَهُ مَعَهُ لِيَفْتَدُوا بِهِ مِنْ عَذَابِ يَوْمِ الْقِيَامَةِ مَا تُقُبِّلَ مِنْهُمْ وَلَهُمْ عَذَابٌ أَلِيمٌ"},"context":"قبلها: استثناء من تاب قبل القدرة عليه.","reason":"بعد باب التوبة، أمر بالتقوى وطلب القرب والجهاد."}],"hadiths":[{"i":1,"of":1,"text":"إذا سَمِعْتُمُ المؤذِّنَ فَقولوا مثلَ ما يقولُ، ثُمَّ صلُّوا عليَّ فإنَّهُ مَن صلَّى عليَّ صلاةً صلَّى اللَّهُ عليهِ عَشرًا، ثمَّ سلوا اللَّهَ ليَ الوسيلةَ، وإنَّها درجةٌ في الجنَّةِ لا تنبَغي إلَّا لِعبدٍ من عبَّادِ اللَّهِ، فمن سألَ ليَ الوسيلةَ حلَّت لَهُ الشَّفاعةُ - وفي روايةٍ - قالَ: وأرجو أن أَكونَ أَنا هوَ","narrator":"عبدالله بن عمرو","source":"صحيح ابن خزيمة 1/ 499","grade":"صحيح","judgment":"أخرجه في صحيحه","url":"https://dorar.net/h/B7NK0MAI","nameForm":"إليه الوسيلة"}],"sunnah":{},"situations":[{"situationId":23,"verses":[{"i":1,"strength":"direct","bridge":"إن شعرت بالبعد بعد الذنوب، ﴿اتَّقُوا اللَّهَ وَابْتَغُوا إِلَيْهِ الْوَسِيلَةَ﴾."}],"hadiths":[]}]},{"id":242,"name":"إلى الله مرجعكم","compound":true,"meaning":"إلى الله مرجعكم: رجوعكم إليه، وهو قادر على كل شيء.","teaches":"1. جاءت بعد الأمر بالاستغفار والتوبة والوعد بالمتاع الحسن.","whenRecall":"- حين تؤجل التوبة.","whenPray":"1. استغفر ربك وتب إليه، فإليه مرجعك.","summary":"استغفر وتب الآن؛ فإلى الله مرجعك.","verses":[{"i":1,"of":1,"s":11,"surah":"هود","a":4,"text":"إِلَى اللَّهِ مَرْجِعُكُمْ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":3,"text":"وَأَنِ اسْتَغْفِرُوا رَبَّكُمْ ثُمَّ تُوبُوا إِلَيْهِ يُمَتِّعْكُمْ مَتَاعًا حَسَنًا إِلَى أَجَلٍ مُسَمًّى وَيُؤْتِ كُلَّ ذِي فَضْلٍ فَضْلَهُ وَإِنْ تَوَلَّوْا فَإِنِّي أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ كَبِيرٍ"},"next":{"a":5,"text":"أَلَا إِنَّهُمْ يَثْنُونَ صُدُورَهُمْ لِيَسْتَخْفُوا مِنْهُ أَلَا حِينَ يَسْتَغْشُونَ ثِيَابَهُمْ يَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِنُونَ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ"},"context":"قبلها: استغفروا ربكم ثم توبوا إليه يمتعكم متاعًا حسنًا.","reason":"بعد الدعوة إلى التوبة ذكّر بالرجوع والقدرة."}],"hadiths":[],"situations":[{"situationId":20,"verses":[{"i":1,"strength":"direct","bridge":"لا تؤجل التوبة؛ ﴿إِلَى اللَّهِ مَرْجِعُكُمْ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾."}],"hadiths":[]}]},{"id":243,"name":"إليه مرجعكم جميعاً","compound":true,"meaning":"إليه مرجعكم جميعًا: الخلق كلهم يرجعون إليه ليُجزوا بالقسط.","teaches":"1. وعد الله حق: يبدأ الخلق ثم يعيده.\n2. الإعادة للجزاء بالعدل.","whenRecall":"- حين تستبعد البعث.\n- حين ترى ظلمًا لم يُجزَ صاحبه.","whenPray":"1. اللهم اجزني بالحسنى يوم ألقاك.","summary":"البداية منه والإعادة إليه، والجزاء بالقسط.","verses":[{"i":1,"of":1,"s":10,"surah":"يونس","a":4,"text":"إِلَيْهِ مَرْجِعُكُمْ جَمِيعًا وَعْدَ اللَّهِ حَقًّا إِنَّهُ يَبْدَأُ الْخَلْقَ ثُمَّ يُعِيدُهُ لِيَجْزِيَ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ بِالْقِسْطِ وَالَّذِينَ كَفَرُوا لَهُمْ شَرَابٌ مِنْ حَمِيمٍ وَعَذَابٌ أَلِيمٌ بِمَا كَانُوا يَكْفُرُونَ","prev":{"a":3,"text":"إِنَّ رَبَّكُمُ اللَّهُ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ فِي سِتَّةِ أَيَّامٍ ثُمَّ اسْتَوَى عَلَى الْعَرْشِ يُدَبِّرُ الْأَمْرَ مَا مِنْ شَفِيعٍ إِلَّا مِنْ بَعْدِ إِذْنِهِ ذَلِكُمُ اللَّهُ رَبُّكُمْ فَاعْبُدُوهُ أَفَلَا تَذَكَّرُونَ"},"next":{"a":5,"text":"هُوَ الَّذِي جَعَلَ الشَّمْسَ ضِيَاءً وَالْقَمَرَ نُورًا وَقَدَّرَهُ مَنَازِلَ لِتَعْلَمُوا عَدَدَ السِّنِينَ وَالْحِسَابَ مَا خَلَقَ اللَّهُ ذَلِكَ إِلَّا بِالْحَقِّ يُفَصِّلُ الْآيَاتِ لِقَوْمٍ يَعْلَمُونَ"},"context":"قبلها: ربكم الذي خلق السماوات والأرض في ستة أيام.","reason":"الخالق يعيد ليجزي بالقسط."}],"hadiths":[],"situations":[{"situationId":110,"verses":[{"i":1,"strength":"direct","bridge":"إن طلبت يقينًا بالبعث، ﴿إِنَّهُ يَبْدَأُ الْخَلْقَ ثُمَّ يُعِيدُهُ لِيَجْزِيَ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ بِالْقِسْطِ﴾."}],"hadiths":[]}]},{"id":244,"name":"إلى الله مرجعكم جميعاً","compound":true,"meaning":"إلى الله مرجعكم جميعًا: يرجع إليه المختلفون، فينبئهم بما كانوا فيه يختلفون.","teaches":"1. تأتي مع الاختلاف: في الشرائع، وفي الهداية والضلال.\n2. الواجب: استباق الخيرات، وإصلاح النفس.","whenRecall":"- حين يطول الخلاف.\n- حين تنشغل بضلال غيرك عن نفسك.","whenPray":"1. اللهم اهدني لما اختُلف فيه من الحق بإذنك.","summary":"استبق الخيرات وأصلح نفسك، والحكم في الخلاف عند المرجع.","verses":[{"i":1,"of":2,"s":5,"surah":"المائدة","a":48,"text":"وَأَنْزَلْنَا إِلَيْكَ الْكِتَابَ بِالْحَقِّ مُصَدِّقًا لِمَا بَيْنَ يَدَيْهِ مِنَ الْكِتَابِ وَمُهَيْمِنًا عَلَيْهِ فَاحْكُمْ بَيْنَهُمْ بِمَا أَنْزَلَ اللَّهُ وَلَا تَتَّبِعْ أَهْوَاءَهُمْ عَمَّا جَاءَكَ مِنَ الْحَقِّ لِكُلٍّ جَعَلْنَا مِنْكُمْ شِرْعَةً وَمِنْهَاجًا وَلَوْ شَاءَ اللَّهُ لَجَعَلَكُمْ أُمَّةً وَاحِدَةً وَلَكِنْ لِيَبْلُوَكُمْ فِي مَا آتَاكُمْ فَاسْتَبِقُوا الْخَيْرَاتِ إِلَى اللَّهِ مَرْجِعُكُمْ جَمِيعًا فَيُنَبِّئُكُمْ بِمَا كُنْتُمْ فِيهِ تَخْتَلِفُونَ","prev":{"a":47,"text":"وَلْيَحْكُمْ أَهْلُ الْإِنْجِيلِ بِمَا أَنْزَلَ اللَّهُ فِيهِ وَمَنْ لَمْ يَحْكُمْ بِمَا أَنْزَلَ اللَّهُ فَأُولَئِكَ هُمُ الْفَاسِقُونَ"},"next":{"a":49,"text":"وَأَنِ احْكُمْ بَيْنَهُمْ بِمَا أَنْزَلَ اللَّهُ وَلَا تَتَّبِعْ أَهْوَاءَهُمْ وَاحْذَرْهُمْ أَنْ يَفْتِنُوكَ عَنْ بَعْضِ مَا أَنْزَلَ اللَّهُ إِلَيْكَ فَإِنْ تَوَلَّوْا فَاعْلَمْ أَنَّمَا يُرِيدُ اللَّهُ أَنْ يُصِيبَهُمْ بِبَعْضِ ذُنُوبِهِمْ وَإِنَّ كَثِيرًا مِنَ النَّاسِ لَفَاسِقُونَ"},"context":"إنزال الكتاب مهيمنًا، ولكلٍّ شرعة ومنهاج.","reason":"الاختلاف ابتلاء، والواجب استباق الخيرات، والحكم يوم المرجع."},{"i":2,"of":2,"s":5,"surah":"المائدة","a":105,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا عَلَيْكُمْ أَنْفُسَكُمْ لَا يَضُرُّكُمْ مَنْ ضَلَّ إِذَا اهْتَدَيْتُمْ إِلَى اللَّهِ مَرْجِعُكُمْ جَمِيعًا فَيُنَبِّئُكُمْ بِمَا كُنْتُمْ تَعْمَلُونَ","prev":{"a":104,"text":"وَإِذَا قِيلَ لَهُمْ تَعَالَوْا إِلَى مَا أَنْزَلَ اللَّهُ وَإِلَى الرَّسُولِ قَالُوا حَسْبُنَا مَا وَجَدْنَا عَلَيْهِ آبَاءَنَا أَوَلَوْ كَانَ آبَاؤُهُمْ لَا يَعْلَمُونَ شَيْئًا وَلَا يَهْتَدُونَ"},"next":{"a":106,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا شَهَادَةُ بَيْنِكُمْ إِذَا حَضَرَ أَحَدَكُمُ الْمَوْتُ حِينَ الْوَصِيَّةِ اثْنَانِ ذَوَا عَدْلٍ مِنْكُمْ أَوْ آخَرَانِ مِنْ غَيْرِكُمْ إِنْ أَنْتُمْ ضَرَبْتُمْ فِي الْأَرْضِ فَأَصَابَتْكُمْ مُصِيبَةُ الْمَوْتِ تَحْبِسُونَهُمَا مِنْ بَعْدِ الصَّلَاةِ فَيُقْسِمَانِ بِاللَّهِ إِنِ ارْتَبْتُمْ لَا نَشْتَرِي بِهِ ثَمَنًا وَلَوْ كَانَ ذَا قُرْبَى وَلَا نَكْتُمُ شَهَادَةَ اللَّهِ إِنَّا إِذًا لَمِنَ الْآثِمِينَ"},"context":"قبلها: من قالوا حسبنا ما وجدنا عليه آباءنا.","reason":"عليكم أنفسكم، ولا يضركم ضلال غيركم إذا اهتديتم."}],"hadiths":[],"situations":[{"situationId":131,"verses":[{"i":2,"strength":"direct","bridge":"إن أحزنك ضلال من حولك فـ﴿عَلَيْكُمْ أَنْفُسَكُمْ لَا يَضُرُّكُمْ مَنْ ضَلَّ إِذَا اهْتَدَيْتُمْ﴾."}],"hadiths":[]},{"situationId":142,"verses":[{"i":1,"strength":"direct","bridge":"بدل أن تنشغل بالخلاف، ﴿فَاسْتَبِقُوا الْخَيْرَاتِ إِلَى اللَّهِ مَرْجِعُكُمْ جَمِيعًا﴾."}],"hadiths":[]}]},{"id":245,"name":"إليه متاب","compound":true,"meaning":"إليه متاب: إليه وحده رجوعي وتوبتي.","teaches":"1. قالها النبي ﷺ بأمر الله ردًّا على كفر قومه بالرحمن.\n2. جمعت التوحيد والتوكل والتوبة.","whenRecall":"- حين يكفر قومك بالحق.\n- حين تريد العودة إلى الله.","whenPray":"1. ﴿هُوَ رَبِّي لَا إِلَهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ مَتَابِ﴾ — الرعد 30.","summary":"توحيد وتوكل ورجوع: إليه متابي.","verses":[{"i":1,"of":1,"s":13,"surah":"الرعد","a":30,"text":"كَذَلِكَ أَرْسَلْنَاكَ فِي أُمَّةٍ قَدْ خَلَتْ مِنْ قَبْلِهَا أُمَمٌ لِتَتْلُوَ عَلَيْهِمُ الَّذِي أَوْحَيْنَا إِلَيْكَ وَهُمْ يَكْفُرُونَ بِالرَّحْمَنِ قُلْ هُوَ رَبِّي لَا إِلَهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ مَتَابِ","prev":{"a":29,"text":"الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ طُوبَى لَهُمْ وَحُسْنُ مَآبٍ"},"next":{"a":31,"text":"وَلَوْ أَنَّ قُرْآنًا سُيِّرَتْ بِهِ الْجِبَالُ أَوْ قُطِّعَتْ بِهِ الْأَرْضُ أَوْ كُلِّمَ بِهِ الْمَوْتَى بَلْ لِلَّهِ الْأَمْرُ جَمِيعًا أَفَلَمْ يَيْأَسِ الَّذِينَ آمَنُوا أَنْ لَوْ يَشَاءُ اللَّهُ لَهَدَى النَّاسَ جَمِيعًا وَلَا يَزَالُ الَّذِينَ كَفَرُوا تُصِيبُهُمْ بِمَا صَنَعُوا قَارِعَةٌ أَوْ تَحُلُّ قَرِيبًا مِنْ دَارِهِمْ حَتَّى يَأْتِيَ وَعْدُ اللَّهِ إِنَّ اللَّهَ لَا يُخْلِفُ الْمِيعَادَ"},"context":"قبلها: الذين آمنوا وعملوا الصالحات طوبى لهم.","reason":"قومه يكفرون بالرحمن، فأُمر أن يعلن توحيده وتوكله ورجوعه."}],"hadiths":[],"situations":[{"situationId":27,"verses":[{"i":1,"strength":"direct","bridge":"إذا أردت العودة إلى الله بعد بعد، فقل: ﴿هُوَ رَبِّي لَا إِلَهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ مَتَابِ﴾."}],"hadiths":[]}]},{"id":246,"name":"إلى الله تُرجَع الأمور","compound":true,"meaning":"إلى الله ترجع الأمور: كل الأمور تعود إليه في الدنيا والآخرة، فلا يخرج شيء عن تدبيره.","teaches":"1. تأتي بعد تدبير الأحداث: تقليل العدو في الأعين يوم بدر.\n2. وبعد التكذيب: إن يكذبوك فقد كُذّبت رسل.\n3. وبعد ذكر الملك.","whenRecall":"- حين يُكذَّب صدقك.\n- حين لا تفهم تدبير ما يحدث.","whenPray":"1. اللهم إليك ترجع الأمور، فاقضِ لي بالخير.","summary":"ما لا تفهمه الآن يرجع إلى من يدبره.","verses":[{"i":1,"of":6,"s":2,"surah":"البقرة","a":210,"text":"هَلْ يَنْظُرُونَ إِلَّا أَنْ يَأْتِيَهُمُ اللَّهُ فِي ظُلَلٍ مِنَ الْغَمَامِ وَالْمَلَائِكَةُ وَقُضِيَ الْأَمْرُ وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ","prev":{"a":209,"text":"فَإِنْ زَلَلْتُمْ مِنْ بَعْدِ مَا جَاءَتْكُمُ الْبَيِّنَاتُ فَاعْلَمُوا أَنَّ اللَّهَ عَزِيزٌ حَكِيمٌ"},"next":{"a":211,"text":"سَلْ بَنِي إِسْرَائِيلَ كَمْ آتَيْنَاهُمْ مِنْ آيَةٍ بَيِّنَةٍ وَمَنْ يُبَدِّلْ نِعْمَةَ اللَّهِ مِنْ بَعْدِ مَا جَاءَتْهُ فَإِنَّ اللَّهَ شَدِيدُ الْعِقَابِ"},"context":"قبلها: فإن زللتم بعد البينات فاعلموا أن الله عزيز حكيم.","reason":"تهديد من زلّ بعد البيان: الأمر سيقضى."},{"i":2,"of":6,"s":3,"surah":"آل عمران","a":109,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ","prev":{"a":108,"text":"تِلْكَ آيَاتُ اللَّهِ نَتْلُوهَا عَلَيْكَ بِالْحَقِّ وَمَا اللَّهُ يُرِيدُ ظُلْمًا لِلْعَالَمِينَ"},"next":{"a":110,"text":"كُنْتُمْ خَيْرَ أُمَّةٍ أُخْرِجَتْ لِلنَّاسِ تَأْمُرُونَ بِالْمَعْرُوفِ وَتَنْهَوْنَ عَنِ الْمُنْكَرِ وَتُؤْمِنُونَ بِاللَّهِ وَلَوْ آمَنَ أَهْلُ الْكِتَابِ لَكَانَ خَيْرًا لَهُمْ مِنْهُمُ الْمُؤْمِنُونَ وَأَكْثَرُهُمُ الْفَاسِقُونَ"},"context":"قبلها: وما الله يريد ظلمًا للعالمين.","reason":"الملك والأمور كلها له؛ فلا يحتاج إلى ظلم."},{"i":3,"of":6,"s":8,"surah":"الأنفال","a":44,"text":"وَإِذْ يُرِيكُمُوهُمْ إِذِ الْتَقَيْتُمْ فِي أَعْيُنِكُمْ قَلِيلًا وَيُقَلِّلُكُمْ فِي أَعْيُنِهِمْ لِيَقْضِيَ اللَّهُ أَمْرًا كَانَ مَفْعُولًا وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ","prev":{"a":43,"text":"إِذْ يُرِيكَهُمُ اللَّهُ فِي مَنَامِكَ قَلِيلًا وَلَوْ أَرَاكَهُمْ كَثِيرًا لَفَشِلْتُمْ وَلَتَنَازَعْتُمْ فِي الْأَمْرِ وَلَكِنَّ اللَّهَ سَلَّمَ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ"},"next":{"a":45,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا لَقِيتُمْ فِئَةً فَاثْبُتُوا وَاذْكُرُوا اللَّهَ كَثِيرًا لَعَلَّكُمْ تُفْلِحُونَ"},"context":"يوم بدر: قلّل الله كل فريق في عين الآخر.","reason":"التقليل تدبير لقضاء أمر كان مفعولًا."},{"i":4,"of":6,"s":22,"surah":"الحج","a":76,"text":"يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ","prev":{"a":75,"text":"اللَّهُ يَصْطَفِي مِنَ الْمَلَائِكَةِ رُسُلًا وَمِنَ النَّاسِ إِنَّ اللَّهَ سَمِيعٌ بَصِيرٌ"},"next":{"a":77,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا ارْكَعُوا وَاسْجُدُوا وَاعْبُدُوا رَبَّكُمْ وَافْعَلُوا الْخَيْرَ لَعَلَّكُمْ تُفْلِحُونَ"},"context":"قبلها: الله يصطفي من الملائكة رسلًا ومن الناس.","reason":"علمه بما بين أيديهم وما خلفهم، والأمور إليه."},{"i":5,"of":6,"s":35,"surah":"فاطر","a":4,"text":"وَإِنْ يُكَذِّبُوكَ فَقَدْ كُذِّبَتْ رُسُلٌ مِنْ قَبْلِكَ وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ","prev":{"a":3,"text":"يَا أَيُّهَا النَّاسُ اذْكُرُوا نِعْمَتَ اللَّهِ عَلَيْكُمْ هَلْ مِنْ خَالِقٍ غَيْرُ اللَّهِ يَرْزُقُكُمْ مِنَ السَّمَاءِ وَالْأَرْضِ لَا إِلَهَ إِلَّا هُوَ فَأَنَّى تُؤْفَكُونَ"},"next":{"a":5,"text":"يَا أَيُّهَا النَّاسُ إِنَّ وَعْدَ اللَّهِ حَقٌّ فَلَا تَغُرَّنَّكُمُ الْحَيَاةُ الدُّنْيَا وَلَا يَغُرَّنَّكُمْ بِاللَّهِ الْغَرُورُ"},"context":"قبلها: اذكروا نعمة الله، هل من خالق غير الله.","reason":"تسلية للنبي ﷺ: التكذيب سنة، والأمور ترجع إلى الله."},{"i":6,"of":6,"s":57,"surah":"الحديد","a":5,"text":"لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ","prev":{"a":4,"text":"هُوَ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ فِي سِتَّةِ أَيَّامٍ ثُمَّ اسْتَوَى عَلَى الْعَرْشِ يَعْلَمُ مَا يَلِجُ فِي الْأَرْضِ وَمَا يَخْرُجُ مِنْهَا وَمَا يَنْزِلُ مِنَ السَّمَاءِ وَمَا يَعْرُجُ فِيهَا وَهُوَ مَعَكُمْ أَيْنَ مَا كُنْتُمْ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ"},"next":{"a":6,"text":"يُولِجُ اللَّيْلَ فِي النَّهَارِ وَيُولِجُ النَّهَارَ فِي اللَّيْلِ وَهُوَ عَلِيمٌ بِذَاتِ الصُّدُورِ"},"context":"قبلها: خلق السماوات والأرض في ستة أيام ثم استوى على العرش.","reason":"ملكه ورجوع الأمور إليه."}],"hadiths":[],"situations":[{"situationId":8,"verses":[{"i":3,"strength":"direct","bridge":"ما يجري حولك قد يكون تدبيرًا لأمر مفعول: ﴿لِيَقْضِيَ اللَّهُ أَمْرًا كَانَ مَفْعُولًا﴾."}],"hadiths":[]},{"situationId":20,"verses":[{"i":1,"strength":"direct","bridge":"إن زللت بعد البيان فلا تنتظر؛ ﴿وَقُضِيَ الْأَمْرُ وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ﴾."}],"hadiths":[]},{"situationId":84,"verses":[{"i":4,"strength":"direct","bridge":"اختيار الله لمن يصطفيه عن علم، ﴿وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ﴾."}],"hadiths":[]},{"situationId":102,"verses":[{"i":2,"strength":"direct","bridge":"ما في السماوات والأرض له، ﴿وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ﴾."},{"i":6,"strength":"direct","bridge":"ما يقلقك من أمرك يرجع إلى مالكه: ﴿لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ﴾."}],"hadiths":[]},{"situationId":136,"verses":[{"i":5,"strength":"direct","bridge":"إن كُذّبت فـ﴿فَقَدْ كُذِّبَتْ رُسُلٌ مِنْ قَبْلِكَ وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ﴾."}],"hadiths":[]}]},{"id":247,"name":"إليه النشور","compound":true,"meaning":"إليه النشور: إليه البعث والخروج من القبور.","teaches":"1. جاءت بعد تذليل الأرض والأمر بالمشي فيها والأكل من الرزق.\n2. السعي في الأرض لا ينسي البعث.","whenRecall":"- حين تسعى في رزقك.\n- حين تنشغل بالدنيا.","whenPray":"1. اللهم بارك في رزقي، واجعل سعيي لك.","summary":"امشِ في الأرض وكل من رزقه، واذكر أن إليه النشور.","verses":[{"i":1,"of":1,"s":67,"surah":"الملك","a":15,"text":"هُوَ الَّذِي جَعَلَ لَكُمُ الْأَرْضَ ذَلُولًا فَامْشُوا فِي مَنَاكِبِهَا وَكُلُوا مِنْ رِزْقِهِ وَإِلَيْهِ النُّشُورُ","prev":{"a":14,"text":"أَلَا يَعْلَمُ مَنْ خَلَقَ وَهُوَ اللَّطِيفُ الْخَبِيرُ"},"next":{"a":16,"text":"أَأَمِنْتُمْ مَنْ فِي السَّمَاءِ أَنْ يَخْسِفَ بِكُمُ الْأَرْضَ فَإِذَا هِيَ تَمُورُ"},"context":"قبلها: ألا يعلم من خلق وهو اللطيف الخبير.","reason":"الأرض مذللة للرزق، والنهاية بعث إليه."}],"hadiths":[{"i":1,"of":1,"text":"كان إذا أصبحَ قال : اللهمَّ بِكَ أَصْبَحْنا ، و بِكَ أَمْسَيْنا ، و بِكَ نَحْيا ، و بكَ نَمُوتُ ، و إليكَ النُّشُور ، و إذا أَمْسَى قال : اللهمَّ بِكَ أَمْسَيْنا ، و بِكَ أَصْبَحْنا ، و بِكَ نَحْيا و بِكَ نَمُوتُ ، و إليكَ المَصِير","narrator":"أبو هريرة","source":"السلسلة الصحيحة 262","grade":"صحيح","judgment":"إسناده صحيح رجاله ثقات رجال مسلم","url":"https://dorar.net/h/ob1ehQBH","nameForm":"إليه النشور"}],"sunnah":{},"situations":[{"situationId":41,"verses":[{"i":1,"strength":"direct","bridge":"اسعَ في رزقك ولا تنسَ: ﴿فَامْشُوا فِي مَنَاكِبِهَا وَكُلُوا مِنْ رِزْقِهِ وَإِلَيْهِ النُّشُورُ﴾."}],"hadiths":[]}]},{"id":248,"name":"إلى الله تصير الأمور","compound":true,"meaning":"إلى الله تصير الأمور: تنتهي الأمور كلها إليه.","teaches":"1. ختام الشورى بعد ذكر الوحي والصراط المستقيم.\n2. الصراط صراط من له ما في السماوات والأرض.","whenRecall":"- حين تحتار في الطريق.","whenPray":"1. اللهم اهدني صراطك المستقيم.","summary":"الطريق إلى الله، والأمور كلها تصير إليه.","verses":[{"i":1,"of":1,"s":42,"surah":"الشورى","a":53,"text":"صِرَاطِ اللَّهِ الَّذِي لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ أَلَا إِلَى اللَّهِ تَصِيرُ الْأُمُورُ","prev":{"a":52,"text":"وَكَذَلِكَ أَوْحَيْنَا إِلَيْكَ رُوحًا مِنْ أَمْرِنَا مَا كُنْتَ تَدْرِي مَا الْكِتَابُ وَلَا الْإِيمَانُ وَلَكِنْ جَعَلْنَاهُ نُورًا نَهْدِي بِهِ مَنْ نَشَاءُ مِنْ عِبَادِنَا وَإِنَّكَ لَتَهْدِي إِلَى صِرَاطٍ مُسْتَقِيمٍ"},"context":"قبلها: أوحينا إليك روحًا من أمرنا، وإنك لتهدي إلى صراط مستقيم.","reason":"الصراط صراط الله، والأمور تصير إليه."}],"hadiths":[],"situations":[{"situationId":14,"verses":[{"i":1,"strength":"direct","bridge":"إذا احترت في طريقك فاسلك ﴿صِرَاطِ اللَّهِ الَّذِي لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ﴾."}],"hadiths":[]}]},{"id":249,"name":"وله كل شيء","compound":true,"meaning":"وله كل شيء: كل موجود ملكٌ لله وحده.","teaches":"1. قالها النبي ﷺ بأمر الله وهو يعلن عبادته لرب البلدة الحرام.\n2. ملكه لكل شيء سببٌ لإفراده بالعبادة.","whenRecall":"- حين تتعلق بشيء تخاف فقده.","whenPray":"1. اللهم لك كل شيء، فاجعلني من المسلمين لك.","summary":"من له كل شيء هو وحده المستحق للعبادة.","verses":[{"i":1,"of":1,"s":27,"surah":"النمل","a":91,"text":"إِنَّمَا أُمِرْتُ أَنْ أَعْبُدَ رَبَّ هَذِهِ الْبَلْدَةِ الَّذِي حَرَّمَهَا وَلَهُ كُلُّ شَيْءٍ وَأُمِرْتُ أَنْ أَكُونَ مِنَ الْمُسْلِمِينَ","prev":{"a":90,"text":"وَمَنْ جَاءَ بِالسَّيِّئَةِ فَكُبَّتْ وُجُوهُهُمْ فِي النَّارِ هَلْ تُجْزَوْنَ إِلَّا مَا كُنْتُمْ تَعْمَلُونَ"},"next":{"a":92,"text":"وَأَنْ أَتْلُوَ الْقُرْآنَ فَمَنِ اهْتَدَى فَإِنَّمَا يَهْتَدِي لِنَفْسِهِ وَمَنْ ضَلَّ فَقُلْ إِنَّمَا أَنَا مِنَ الْمُنْذِرِينَ"},"context":"ختام النمل بعد ذكر جزاء الحسنة والسيئة.","reason":"أمرٌ بإعلان العبادة لرب مكة الذي حرّمها، مع التذكير بملكه لكل شيء."}],"hadiths":[],"situations":[{"situationId":93,"verses":[{"i":1,"strength":"direct","bridge":"إذا خفت فقد شيء تملكه فتذكر أنه ليس لك أصلًا: ﴿الَّذِي حَرَّمَهَا وَلَهُ كُلُّ شَيْءٍ﴾."}],"hadiths":[]}]},{"id":250,"name":"له المُلك","compound":true,"meaning":"له الملك: الملك الحق التام لله، يؤتيه من يشاء.","teaches":"1. ردٌّ على من ظن الملك بالمال والنسب (قصة طالوت).\n2. ومقرون بالخلق وتدبير الليل والنهار.\n3. ومن يُدعى من دونه لا يملك قطميرًا.","whenRecall":"- حين تُقدّم المال والنسب معيارًا.\n- حين تدعو غير الله.","whenPray":"1. اللهم لك الملك فلا أسأل غيرك.","summary":"الملك له؛ يؤتيه بالاصطفاء لا بالمال، ولا يملك غيره شيئًا.","verses":[{"i":1,"of":3,"s":2,"surah":"البقرة","a":247,"text":"وَقَالَ لَهُمْ نَبِيُّهُمْ إِنَّ اللَّهَ قَدْ بَعَثَ لَكُمْ طَالُوتَ مَلِكًا قَالُوا أَنَّى يَكُونُ لَهُ الْمُلْكُ عَلَيْنَا وَنَحْنُ أَحَقُّ بِالْمُلْكِ مِنْهُ وَلَمْ يُؤْتَ سَعَةً مِنَ الْمَالِ قَالَ إِنَّ اللَّهَ اصْطَفَاهُ عَلَيْكُمْ وَزَادَهُ بَسْطَةً فِي الْعِلْمِ وَالْجِسْمِ وَاللَّهُ يُؤْتِي مُلْكَهُ مَنْ يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ","prev":{"a":246,"text":"أَلَمْ تَرَ إِلَى الْمَلَإِ مِنْ بَنِي إِسْرَائِيلَ مِنْ بَعْدِ مُوسَى إِذْ قَالُوا لِنَبِيٍّ لَهُمُ ابْعَثْ لَنَا مَلِكًا نُقَاتِلْ فِي سَبِيلِ اللَّهِ قَالَ هَلْ عَسَيْتُمْ إِنْ كُتِبَ عَلَيْكُمُ الْقِتَالُ أَلَّا تُقَاتِلُوا قَالُوا وَمَا لَنَا أَلَّا نُقَاتِلَ فِي سَبِيلِ اللَّهِ وَقَدْ أُخْرِجْنَا مِنْ دِيَارِنَا وَأَبْنَائِنَا فَلَمَّا كُتِبَ عَلَيْهِمُ الْقِتَالُ تَوَلَّوْا إِلَّا قَلِيلًا مِنْهُمْ وَاللَّهُ عَلِيمٌ بِالظَّالِمِينَ"},"next":{"a":248,"text":"وَقَالَ لَهُمْ نَبِيُّهُمْ إِنَّ آيَةَ مُلْكِهِ أَنْ يَأْتِيَكُمُ التَّابُوتُ فِيهِ سَكِينَةٌ مِنْ رَبِّكُمْ وَبَقِيَّةٌ مِمَّا تَرَكَ آلُ مُوسَى وَآلُ هَارُونَ تَحْمِلُهُ الْمَلَائِكَةُ إِنَّ فِي ذَلِكَ لَآيَةً لَكُمْ إِنْ كُنْتُمْ مُؤْمِنِينَ"},"context":"بنو إسرائيل يعترضون على تمليك طالوت لقلة ماله.","reason":"بيّن أن الاصطفاء والعلم والجسم هي المعيار، والملك يؤتيه الله من يشاء."},{"i":2,"of":3,"s":35,"surah":"فاطر","a":13,"text":"يُولِجُ اللَّيْلَ فِي النَّهَارِ وَيُولِجُ النَّهَارَ فِي اللَّيْلِ وَسَخَّرَ الشَّمْسَ وَالْقَمَرَ كُلٌّ يَجْرِي لِأَجَلٍ مُسَمًّى ذَلِكُمُ اللَّهُ رَبُّكُمْ لَهُ الْمُلْكُ وَالَّذِينَ تَدْعُونَ مِنْ دُونِهِ مَا يَمْلِكُونَ مِنْ قِطْمِيرٍ","prev":{"a":12,"text":"وَمَا يَسْتَوِي الْبَحْرَانِ هَذَا عَذْبٌ فُرَاتٌ سَائِغٌ شَرَابُهُ وَهَذَا مِلْحٌ أُجَاجٌ وَمِنْ كُلٍّ تَأْكُلُونَ لَحْمًا طَرِيًّا وَتَسْتَخْرِجُونَ حِلْيَةً تَلْبَسُونَهَا وَتَرَى الْفُلْكَ فِيهِ مَوَاخِرَ لِتَبْتَغُوا مِنْ فَضْلِهِ وَلَعَلَّكُمْ تَشْكُرُونَ"},"next":{"a":14,"text":"إِنْ تَدْعُوهُمْ لَا يَسْمَعُوا دُعَاءَكُمْ وَلَوْ سَمِعُوا مَا اسْتَجَابُوا لَكُمْ وَيَوْمَ الْقِيَامَةِ يَكْفُرُونَ بِشِرْكِكُمْ وَلَا يُنَبِّئُكَ مِثْلُ خَبِيرٍ"},"context":"قبلها: البحران العذب والملح وما فيهما من النعم.","reason":"مدبّر الليل والنهار له الملك، والمدعوون من دونه لا يملكون شيئًا."},{"i":3,"of":3,"s":39,"surah":"الزمر","a":6,"text":"خَلَقَكُمْ مِنْ نَفْسٍ وَاحِدَةٍ ثُمَّ جَعَلَ مِنْهَا زَوْجَهَا وَأَنْزَلَ لَكُمْ مِنَ الْأَنْعَامِ ثَمَانِيَةَ أَزْوَاجٍ يَخْلُقُكُمْ فِي بُطُونِ أُمَّهَاتِكُمْ خَلْقًا مِنْ بَعْدِ خَلْقٍ فِي ظُلُمَاتٍ ثَلَاثٍ ذَلِكُمُ اللَّهُ رَبُّكُمْ لَهُ الْمُلْكُ لَا إِلَهَ إِلَّا هُوَ فَأَنَّى تُصْرَفُونَ","prev":{"a":5,"text":"خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ بِالْحَقِّ يُكَوِّرُ اللَّيْلَ عَلَى النَّهَارِ وَيُكَوِّرُ النَّهَارَ عَلَى اللَّيْلِ وَسَخَّرَ الشَّمْسَ وَالْقَمَرَ كُلٌّ يَجْرِي لِأَجَلٍ مُسَمًّى أَلَا هُوَ الْعَزِيزُ الْغَفَّارُ"},"next":{"a":7,"text":"إِنْ تَكْفُرُوا فَإِنَّ اللَّهَ غَنِيٌّ عَنْكُمْ وَلَا يَرْضَى لِعِبَادِهِ الْكُفْرَ وَإِنْ تَشْكُرُوا يَرْضَهُ لَكُمْ وَلَا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَى ثُمَّ إِلَى رَبِّكُمْ مَرْجِعُكُمْ فَيُنَبِّئُكُمْ بِمَا كُنْتُمْ تَعْمَلُونَ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ"},"context":"خلق الإنسان من نفس واحدة وفي ظلمات ثلاث.","reason":"من خلقك في بطن أمك له الملك، فكيف تُصرف عنه؟"}],"hadiths":[],"situations":[{"situationId":84,"verses":[{"i":1,"strength":"direct","bridge":"إن ظننت أن المال يصنع الأحقية فتذكر اعتراضهم: ﴿وَلَمْ يُؤْتَ سَعَةً مِنَ الْمَالِ﴾، والملك لله."}],"hadiths":[]},{"situationId":94,"verses":[{"i":2,"strength":"direct","bridge":"لا تطلب من مخلوق ما لا يملكه: ﴿وَالَّذِينَ تَدْعُونَ مِنْ دُونِهِ مَا يَمْلِكُونَ مِنْ قِطْمِيرٍ﴾."}],"hadiths":[]},{"situationId":178,"verses":[{"i":3,"strength":"direct","bridge":"الذي ﴿يَخْلُقُكُمْ فِي بُطُونِ أُمَّهَاتِكُمْ﴾ له الملك؛ ﴿فَأَنَّى تُصْرَفُونَ﴾."}],"hadiths":[]}]},{"id":251,"name":"له ملك السماوات والأرض","compound":true,"meaning":"له ملك السماوات والأرض: ملكه يعمّ العالم كله، ومنه الإحياء والإماتة والمغفرة والعذاب.","teaches":"1. تأتي مع نفي الولي والنصير من دونه.\n2. ومع الإحياء والإماتة.\n3. ومع شهادته على الظالمين (البروج 9).","whenRecall":"- حين تبحث عن ولي ونصير.\n- حين تخاف الموت.","whenPray":"1. يا من له ملك السماوات والأرض، كن وليي ونصيري.","summary":"من يملك السماوات والأرض هو الولي والنصير، يحيي ويميت.","verses":[{"i":1,"of":9,"s":2,"surah":"البقرة","a":107,"text":"أَلَمْ تَعْلَمْ أَنَّ اللَّهَ لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا لَكُمْ مِنْ دُونِ اللَّهِ مِنْ وَلِيٍّ وَلَا نَصِيرٍ","prev":{"a":106,"text":"مَا نَنْسَخْ مِنْ آيَةٍ أَوْ نُنْسِهَا نَأْتِ بِخَيْرٍ مِنْهَا أَوْ مِثْلِهَا أَلَمْ تَعْلَمْ أَنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},"next":{"a":108,"text":"أَمْ تُرِيدُونَ أَنْ تَسْأَلُوا رَسُولَكُمْ كَمَا سُئِلَ مُوسَى مِنْ قَبْلُ وَمَنْ يَتَبَدَّلِ الْكُفْرَ بِالْإِيمَانِ فَقَدْ ضَلَّ سَوَاءَ السَّبِيلِ"},"context":"سياق النسخ وتشكيك اليهود فيه.","reason":"المالك يغيّر الحكم كيف يشاء، ولا ولي لكم سواه."},{"i":2,"of":9,"s":5,"surah":"المائدة","a":40,"text":"أَلَمْ تَعْلَمْ أَنَّ اللَّهَ لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ يُعَذِّبُ مَنْ يَشَاءُ وَيَغْفِرُ لِمَنْ يَشَاءُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":39,"text":"فَمَنْ تَابَ مِنْ بَعْدِ ظُلْمِهِ وَأَصْلَحَ فَإِنَّ اللَّهَ يَتُوبُ عَلَيْهِ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ"},"next":{"a":41,"text":"يَا أَيُّهَا الرَّسُولُ لَا يَحْزُنْكَ الَّذِينَ يُسَارِعُونَ فِي الْكُفْرِ مِنَ الَّذِينَ قَالُوا آمَنَّا بِأَفْوَاهِهِمْ وَلَمْ تُؤْمِنْ قُلُوبُهُمْ وَمِنَ الَّذِينَ هَادُوا سَمَّاعُونَ لِلْكَذِبِ سَمَّاعُونَ لِقَوْمٍ آخَرِينَ لَمْ يَأْتُوكَ يُحَرِّفُونَ الْكَلِمَ مِنْ بَعْدِ مَوَاضِعِهِ يَقُولُونَ إِنْ أُوتِيتُمْ هَذَا فَخُذُوهُ وَإِنْ لَمْ تُؤْتَوْهُ فَاحْذَرُوا وَمَنْ يُرِدِ اللَّهُ فِتْنَتَهُ فَلَنْ تَمْلِكَ لَهُ مِنَ اللَّهِ شَيْئًا أُولَئِكَ الَّذِينَ لَمْ يُرِدِ اللَّهُ أَنْ يُطَهِّرَ قُلُوبَهُمْ لَهُمْ فِي الدُّنْيَا خِزْيٌ وَلَهُمْ فِي الْآخِرَةِ عَذَابٌ عَظِيمٌ"},"context":"بعد حد السرقة وقبول توبة من تاب.","reason":"المالك يعذب ويغفر بمشيئته؛ فباب التوبة مفتوح."},{"i":3,"of":9,"s":7,"surah":"الأعراف","a":158,"text":"قُلْ يَا أَيُّهَا النَّاسُ إِنِّي رَسُولُ اللَّهِ إِلَيْكُمْ جَمِيعًا الَّذِي لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ لَا إِلَهَ إِلَّا هُوَ يُحْيِي وَيُمِيتُ فَآمِنُوا بِاللَّهِ وَرَسُولِهِ النَّبِيِّ الْأُمِّيِّ الَّذِي يُؤْمِنُ بِاللَّهِ وَكَلِمَاتِهِ وَاتَّبِعُوهُ لَعَلَّكُمْ تَهْتَدُونَ","prev":{"a":157,"text":"الَّذِينَ يَتَّبِعُونَ الرَّسُولَ النَّبِيَّ الْأُمِّيَّ الَّذِي يَجِدُونَهُ مَكْتُوبًا عِنْدَهُمْ فِي التَّوْرَاةِ وَالْإِنْجِيلِ يَأْمُرُهُمْ بِالْمَعْرُوفِ وَيَنْهَاهُمْ عَنِ الْمُنْكَرِ وَيُحِلُّ لَهُمُ الطَّيِّبَاتِ وَيُحَرِّمُ عَلَيْهِمُ الْخَبَائِثَ وَيَضَعُ عَنْهُمْ إِصْرَهُمْ وَالْأَغْلَالَ الَّتِي كَانَتْ عَلَيْهِمْ فَالَّذِينَ آمَنُوا بِهِ وَعَزَّرُوهُ وَنَصَرُوهُ وَاتَّبَعُوا النُّورَ الَّذِي أُنْزِلَ مَعَهُ أُولَئِكَ هُمُ الْمُفْلِحُونَ"},"next":{"a":159,"text":"وَمِنْ قَوْمِ مُوسَى أُمَّةٌ يَهْدُونَ بِالْحَقِّ وَبِهِ يَعْدِلُونَ"},"context":"إعلان عموم الرسالة إلى الناس جميعًا.","reason":"الرسالة من مالك السماوات والأرض المحيي المميت."},{"i":4,"of":9,"s":9,"surah":"التوبة","a":116,"text":"إِنَّ اللَّهَ لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ يُحْيِي وَيُمِيتُ وَمَا لَكُمْ مِنْ دُونِ اللَّهِ مِنْ وَلِيٍّ وَلَا نَصِيرٍ","prev":{"a":115,"text":"وَمَا كَانَ اللَّهُ لِيُضِلَّ قَوْمًا بَعْدَ إِذْ هَدَاهُمْ حَتَّى يُبَيِّنَ لَهُمْ مَا يَتَّقُونَ إِنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ"},"next":{"a":117,"text":"لَقَدْ تَابَ اللَّهُ عَلَى النَّبِيِّ وَالْمُهَاجِرِينَ وَالْأَنْصَارِ الَّذِينَ اتَّبَعُوهُ فِي سَاعَةِ الْعُسْرَةِ مِنْ بَعْدِ مَا كَادَ يَزِيغُ قُلُوبُ فَرِيقٍ مِنْهُمْ ثُمَّ تَابَ عَلَيْهِمْ إِنَّهُ بِهِمْ رَءُوفٌ رَحِيمٌ"},"context":"بعد النهي عن الاستغفار للمشركين ولو كانوا أولي قربى.","reason":"الولاية لله وحده، لا للقرابة."},{"i":5,"of":9,"s":25,"surah":"الفرقان","a":2,"text":"الَّذِي لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَلَمْ يَتَّخِذْ وَلَدًا وَلَمْ يَكُنْ لَهُ شَرِيكٌ فِي الْمُلْكِ وَخَلَقَ كُلَّ شَيْءٍ فَقَدَّرَهُ تَقْدِيرًا","prev":{"a":1,"text":"تَبَارَكَ الَّذِي نَزَّلَ الْفُرْقَانَ عَلَى عَبْدِهِ لِيَكُونَ لِلْعَالَمِينَ نَذِيرًا"},"next":{"a":3,"text":"وَاتَّخَذُوا مِنْ دُونِهِ آلِهَةً لَا يَخْلُقُونَ شَيْئًا وَهُمْ يُخْلَقُونَ وَلَا يَمْلِكُونَ لِأَنْفُسِهِمْ ضَرًّا وَلَا نَفْعًا وَلَا يَمْلِكُونَ مَوْتًا وَلَا حَيَاةً وَلَا نُشُورًا"},"context":"مطلع الفرقان: تبارك الذي نزّل الفرقان.","reason":"نفي الولد والشريك، وتقدير كل شيء."},{"i":6,"of":9,"s":39,"surah":"الزمر","a":44,"text":"قُلْ لِلَّهِ الشَّفَاعَةُ جَمِيعًا لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ ثُمَّ إِلَيْهِ تُرْجَعُونَ","prev":{"a":43,"text":"أَمِ اتَّخَذُوا مِنْ دُونِ اللَّهِ شُفَعَاءَ قُلْ أَوَلَوْ كَانُوا لَا يَمْلِكُونَ شَيْئًا وَلَا يَعْقِلُونَ"},"next":{"a":45,"text":"وَإِذَا ذُكِرَ اللَّهُ وَحْدَهُ اشْمَأَزَّتْ قُلُوبُ الَّذِينَ لَا يُؤْمِنُونَ بِالْآخِرَةِ وَإِذَا ذُكِرَ الَّذِينَ مِنْ دُونِهِ إِذَا هُمْ يَسْتَبْشِرُونَ"},"context":"المشركون اتخذوا شفعاء من دون الله.","reason":"الشفاعة كلها لمالك السماوات والأرض."},{"i":7,"of":9,"s":57,"surah":"الحديد","a":2,"text":"لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ يُحْيِي وَيُمِيتُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":1,"text":"سَبَّحَ لِلَّهِ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ وَهُوَ الْعَزِيزُ الْحَكِيمُ"},"next":{"a":3,"text":"هُوَ الْأَوَّلُ وَالْآخِرُ وَالظَّاهِرُ وَالْبَاطِنُ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ"},"context":"مطلع الحديد: تسبيح ما في السماوات والأرض.","reason":"الملك والإحياء والإماتة والقدرة."},{"i":8,"of":9,"s":57,"surah":"الحديد","a":5,"text":"لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ","prev":{"a":4,"text":"هُوَ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ فِي سِتَّةِ أَيَّامٍ ثُمَّ اسْتَوَى عَلَى الْعَرْشِ يَعْلَمُ مَا يَلِجُ فِي الْأَرْضِ وَمَا يَخْرُجُ مِنْهَا وَمَا يَنْزِلُ مِنَ السَّمَاءِ وَمَا يَعْرُجُ فِيهَا وَهُوَ مَعَكُمْ أَيْنَ مَا كُنْتُمْ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ"},"next":{"a":6,"text":"يُولِجُ اللَّيْلَ فِي النَّهَارِ وَيُولِجُ النَّهَارَ فِي اللَّيْلِ وَهُوَ عَلِيمٌ بِذَاتِ الصُّدُورِ"},"context":"بعد ذكر خلق السماوات والأرض في ستة أيام والاستواء والعلم.","reason":"الملك ورجوع الأمور إليه."},{"i":9,"of":9,"s":85,"surah":"البروج","a":9,"text":"الَّذِي لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَاللَّهُ عَلَى كُلِّ شَيْءٍ شَهِيدٌ","prev":{"a":8,"text":"وَمَا نَقَمُوا مِنْهُمْ إِلَّا أَنْ يُؤْمِنُوا بِاللَّهِ الْعَزِيزِ الْحَمِيدِ"},"next":{"a":10,"text":"إِنَّ الَّذِينَ فَتَنُوا الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ ثُمَّ لَمْ يَتُوبُوا فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ الْحَرِيقِ"},"context":"أصحاب الأخدود عذبوا المؤمنين لأنهم آمنوا.","reason":"المعذَّبون في ملك الله، وهو شهيد على ما فُعل بهم."}],"hadiths":[],"situations":[{"situationId":8,"verses":[{"i":5,"strength":"direct","bridge":"كل ما يجري لك مقدّر: ﴿وَخَلَقَ كُلَّ شَيْءٍ فَقَدَّرَهُ تَقْدِيرًا﴾."}],"hadiths":[]},{"situationId":15,"verses":[{"i":2,"strength":"direct","bridge":"بعد الذنب: المالك ﴿يُعَذِّبُ مَنْ يَشَاءُ وَيَغْفِرُ لِمَنْ يَشَاءُ﴾ فبادر بالتوبة."}],"hadiths":[]},{"situationId":35,"verses":[{"i":9,"strength":"direct","bridge":"إذا أوذيت لإيمانك فاعلم: ﴿وَاللَّهُ عَلَى كُلِّ شَيْءٍ شَهِيدٌ﴾."}],"hadiths":[]},{"situationId":94,"verses":[{"i":4,"strength":"direct","bridge":"إن شدّتك قرابة إلى ما لا يرضي الله: ﴿وَمَا لَكُمْ مِنْ دُونِ اللَّهِ مِنْ وَلِيٍّ وَلَا نَصِيرٍ﴾."}],"hadiths":[]},{"situationId":102,"verses":[{"i":8,"strength":"direct","bridge":"كل أمرك راجع إليه: ﴿وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ﴾."}],"hadiths":[]},{"situationId":108,"verses":[{"i":1,"strength":"direct","bridge":"إن شككت في حكمه فاعلم ﴿أَنَّ اللَّهَ لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا لَكُمْ مِنْ دُونِ اللَّهِ مِنْ وَلِيٍّ وَلَا نَصِيرٍ﴾."}],"hadiths":[]},{"situationId":132,"verses":[{"i":3,"strength":"direct","bridge":"رسالة الإسلام للجميع، من ﴿الَّذِي لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ لَا إِلَهَ إِلَّا هُوَ يُحْيِي وَيُمِيتُ﴾."}],"hadiths":[]},{"situationId":182,"verses":[{"i":7,"strength":"direct","bridge":"إن خفت الموت فهو بيد من ﴿يُحْيِي وَيُمِيتُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾."}],"hadiths":[]},{"situationId":184,"verses":[{"i":6,"strength":"direct","bridge":"لا تطلب الشفاعة إلا منه: ﴿قُلْ لِلَّهِ الشَّفَاعَةُ جَمِيعًا﴾."}],"hadiths":[]}]},{"id":252,"name":"له ملك السماوات والأرض وما بينهما وعنده علم الساعة","compound":true,"meaning":"صيغة جامعة: الملك الشامل، وعلم الساعة، والرجوع إليه.","teaches":"1. جاءت بعد إثبات ألوهيته في السماء والأرض.\n2. تبارك: كثُر خيره.","whenRecall":"- حين تتساءل عن الساعة.","whenPray":"1. تبارك الذي له الملك، اجعل لقائي إياك خيرًا.","summary":"الملك له، وعلم الساعة عنده، والرجوع إليه.","verses":[{"i":1,"of":1,"s":43,"surah":"الزخرف","a":85,"text":"وَتَبَارَكَ الَّذِي لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَعِنْدَهُ عِلْمُ السَّاعَةِ وَإِلَيْهِ تُرْجَعُونَ","prev":{"a":84,"text":"وَهُوَ الَّذِي فِي السَّمَاءِ إِلَهٌ وَفِي الْأَرْضِ إِلَهٌ وَهُوَ الْحَكِيمُ الْعَلِيمُ"},"next":{"a":86,"text":"وَلَا يَمْلِكُ الَّذِينَ يَدْعُونَ مِنْ دُونِهِ الشَّفَاعَةَ إِلَّا مَنْ شَهِدَ بِالْحَقِّ وَهُمْ يَعْلَمُونَ"},"context":"قبلها: هو الذي في السماء إله وفي الأرض إله.","reason":"ختم بالبركة والملك وعلم الساعة والرجوع."}],"hadiths":[],"situations":[{"situationId":182,"verses":[{"i":1,"strength":"direct","bridge":"إذا شغلك سؤال الساعة فاشتغل بالاستعداد: ﴿وَعِنْدَهُ عِلْمُ السَّاعَةِ وَإِلَيْهِ تُرْجَعُونَ﴾."}],"hadiths":[]}]},{"id":253,"name":"له المُلك وله الحمد","compound":true,"meaning":"له الملك وله الحمد: الملك التام والحمد الكامل لله؛ فملكه محمود.","teaches":"1. مطلع التغابن بعد تسبيح ما في السماوات والأرض.\n2. ملك الملوك قد يُذم، وملكه كله حمد.","whenRecall":"- عند الذكر صباحًا ومساءً.","whenPray":"1. لا إله إلا الله وحده لا شريك له، له الملك وله الحمد.","summary":"ملكٌ لا يُذم، وحمدٌ لا ينقطع.","verses":[{"i":1,"of":1,"s":64,"surah":"التغابن","a":1,"text":"يُسَبِّحُ لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","next":{"a":2,"text":"هُوَ الَّذِي خَلَقَكُمْ فَمِنْكُمْ كَافِرٌ وَمِنْكُمْ مُؤْمِنٌ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ"},"context":"مطلع سورة التغابن.","reason":"جمع التسبيح والملك والحمد والقدرة في افتتاح السورة."}],"hadiths":[{"i":1,"of":2,"text":"مَن قال حينَ يُصبِحُ عَشْرَ مراتٍ: لا إلهَ إلَّا اللهُ وَحْدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كلِّ شيءٍ قَديرٌ، كتَبَ اللهُ بها عَشْرَ حَسَناتٍ، ومَحا عنه بها عَشْرَ سيِّئاتٍ، وكانت كعَدلِ عَشْرِ رِقابٍ، وأجارَه اللهُ يَومَه منَ الشيطانِ الرجيمِ، وإذا أمْسى فمثلُ ذلك حتى يُصبِحَ.","narrator":"أبو عياش الزرقي","source":"تخريج زاد المعاد 2/344","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/juVBjYvx","nameForm":"له المُلك وله الحمد"},{"i":2,"of":2,"text":"أفضلُ ما قُلْتُ أنا و النَّبيونَ عشيةَ عرفةَ : لا إلهَ إِلَّا اللهُ وحْدَهُ لا شريكَ لهُ ، لهُ الملكُ و لهُ الحمدُ ، و هو على كلِّ شيءٍ قديرٌ","narrator":"علي بن أبي طالب","source":"السلسلة الصحيحة 1503","grade":"صحيح","judgment":"صحيح بمجموع طرقه","url":"https://dorar.net/h/v93qUGeh","nameForm":"له المُلك وله الحمد"}],"sunnah":{},"situations":[{"situationId":144,"verses":[{"i":1,"strength":"direct","bridge":"اجعل ذكرك اليومي: ﴿لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾."}],"hadiths":[]}]},{"id":254,"name":"له الحكم","compound":true,"meaning":"له الحكم: الفصل والقضاء له وحده، في الدنيا والآخرة.","teaches":"1. يأتي بعد ذكر الموت والرد إلى الله.\n2. وبعد: كل شيء هالك إلا وجهه.","whenRecall":"- حين تخاف الحساب.\n- حين يُطلب منك أن تدعو غيره.","whenPray":"1. اللهم أنت الحَكَم، فاحكم لي بالحق.","summary":"الحكم له، وهو أسرع الحاسبين؛ وكل شيء هالك إلا وجهه.","verses":[{"i":1,"of":2,"s":6,"surah":"الأنعام","a":62,"text":"ثُمَّ رُدُّوا إِلَى اللَّهِ مَوْلَاهُمُ الْحَقِّ أَلَا لَهُ الْحُكْمُ وَهُوَ أَسْرَعُ الْحَاسِبِينَ","prev":{"a":61,"text":"وَهُوَ الْقَاهِرُ فَوْقَ عِبَادِهِ وَيُرْسِلُ عَلَيْكُمْ حَفَظَةً حَتَّى إِذَا جَاءَ أَحَدَكُمُ الْمَوْتُ تَوَفَّتْهُ رُسُلُنَا وَهُمْ لَا يُفَرِّطُونَ"},"next":{"a":63,"text":"قُلْ مَنْ يُنَجِّيكُمْ مِنْ ظُلُمَاتِ الْبَرِّ وَالْبَحْرِ تَدْعُونَهُ تَضَرُّعًا وَخُفْيَةً لَئِنْ أَنْجَانَا مِنْ هَذِهِ لَنَكُونَنَّ مِنَ الشَّاكِرِينَ"},"context":"بعد ذكر الحفظة وتوفي الرسل الأنفس.","reason":"بعد الموت يُرد العبد إلى مولاه الحق، والحكم له."},{"i":2,"of":2,"s":28,"surah":"القصص","a":88,"text":"وَلَا تَدْعُ مَعَ اللَّهِ إِلَهًا آخَرَ لَا إِلَهَ إِلَّا هُوَ كُلُّ شَيْءٍ هَالِكٌ إِلَّا وَجْهَهُ لَهُ الْحُكْمُ وَإِلَيْهِ تُرْجَعُونَ","prev":{"a":87,"text":"وَلَا يَصُدُّنَّكَ عَنْ آيَاتِ اللَّهِ بَعْدَ إِذْ أُنْزِلَتْ إِلَيْكَ وَادْعُ إِلَى رَبِّكَ وَلَا تَكُونَنَّ مِنَ الْمُشْرِكِينَ"},"context":"ختام القصص: النهي عن الصد عن آيات الله.","reason":"كل شيء يفنى، والحكم والرجوع إليه."}],"hadiths":[],"situations":[{"situationId":92,"verses":[{"i":2,"strength":"direct","bridge":"إذا تعلقت بزائل فـ﴿كُلُّ شَيْءٍ هَالِكٌ إِلَّا وَجْهَهُ لَهُ الْحُكْمُ﴾."}],"hadiths":[]},{"situationId":182,"verses":[{"i":1,"strength":"direct","bridge":"إذا تذكرت الموت فتذكر ما بعده: ﴿أَلَا لَهُ الْحُكْمُ وَهُوَ أَسْرَعُ الْحَاسِبِينَ﴾."}],"hadiths":[]}]},{"id":255,"name":"له الحمد في الأولى والآخرة وله الحكم","compound":true,"meaning":"له الحمد في الأولى والآخرة: محمود في الدنيا والآخرة، والحكم له.","teaches":"1. جاءت بعد علمه بما تكن الصدور.\n2. الحمد في الدارين.","whenRecall":"- حين تُخفي في صدرك ما لا يرضيه.","whenPray":"1. لك الحمد في الأولى والآخرة.","summary":"يعلم ما تكنّه صدرك، وله الحمد والحكم.","verses":[{"i":1,"of":1,"s":28,"surah":"القصص","a":70,"text":"وَهُوَ اللَّهُ لَا إِلَهَ إِلَّا هُوَ لَهُ الْحَمْدُ فِي الْأُولَى وَالْآخِرَةِ وَلَهُ الْحُكْمُ وَإِلَيْهِ تُرْجَعُونَ","prev":{"a":69,"text":"وَرَبُّكَ يَعْلَمُ مَا تُكِنُّ صُدُورُهُمْ وَمَا يُعْلِنُونَ"},"next":{"a":71,"text":"قُلْ أَرَأَيْتُمْ إِنْ جَعَلَ اللَّهُ عَلَيْكُمُ اللَّيْلَ سَرْمَدًا إِلَى يَوْمِ الْقِيَامَةِ مَنْ إِلَهٌ غَيْرُ اللَّهِ يَأْتِيكُمْ بِضِيَاءٍ أَفَلَا تَسْمَعُونَ"},"context":"قبلها: وربك يعلم ما تكن صدورهم وما يعلنون.","reason":"بعد علمه بالسرائر أثبت ألوهيته وحمده وحكمه."}],"hadiths":[],"situations":[{"situationId":73,"verses":[{"i":1,"strength":"direct","bridge":"ما تخفيه في صدرك عند من ﴿لَهُ الْحَمْدُ فِي الْأُولَى وَالْآخِرَةِ وَلَهُ الْحُكْمُ﴾."}],"hadiths":[]}]},{"id":256,"name":"الحكم لله العلي الكبير","compound":true,"meaning":"الحكم لله العلي الكبير: الفصل للعلي فوق خلقه، الكبير الذي لا أكبر منه.","teaches":"1. قيلت لأهل النار حين اعترفوا بذنوبهم.\n2. سبب عذابهم: كفروا بالتوحيد وآمنوا بالشرك.","whenRecall":"- حين يضيق صدرك بذكر الله وحده.","whenPray":"1. اللهم اجعلني ممن إذا ذُكرت وحدك اطمأن قلبه.","summary":"من اشمأز من التوحيد حُكم عليه العلي الكبير.","verses":[{"i":1,"of":1,"s":40,"surah":"غافر","a":12,"text":"ذَلِكُمْ بِأَنَّهُ إِذَا دُعِيَ اللَّهُ وَحْدَهُ كَفَرْتُمْ وَإِنْ يُشْرَكْ بِهِ تُؤْمِنُوا فَالْحُكْمُ لِلَّهِ الْعَلِيِّ الْكَبِيرِ","prev":{"a":11,"text":"قَالُوا رَبَّنَا أَمَتَّنَا اثْنَتَيْنِ وَأَحْيَيْتَنَا اثْنَتَيْنِ فَاعْتَرَفْنَا بِذُنُوبِنَا فَهَلْ إِلَى خُرُوجٍ مِنْ سَبِيلٍ"},"next":{"a":13,"text":"هُوَ الَّذِي يُرِيكُمْ آيَاتِهِ وَيُنَزِّلُ لَكُمْ مِنَ السَّمَاءِ رِزْقًا وَمَا يَتَذَكَّرُ إِلَّا مَنْ يُنِيبُ"},"context":"أهل النار يطلبون الخروج بعد اعترافهم.","reason":"بيّن سبب العذاب: الكفر عند التوحيد والإيمان عند الشرك."}],"hadiths":[],"situations":[{"situationId":94,"verses":[{"i":1,"strength":"direct","bridge":"افحص قلبك: هل تنقبض ﴿إِذَا دُعِيَ اللَّهُ وَحْدَهُ﴾؟ ﴿فَالْحُكْمُ لِلَّهِ الْعَلِيِّ الْكَبِيرِ﴾."}],"hadiths":[]}]},{"id":257,"name":"لله الدين الخالص","compound":true,"meaning":"لله الدين الخالص: العبادة الخالية من الشرك حقٌّ لله وحده.","teaches":"1. جاءت ردًّا على من عبد الأولياء ليقربوه.\n2. الواسطة في العبادة تنقض الإخلاص.","whenRecall":"- حين تقصد غير الله بعملك.","whenPray":"1. اللهم اجعل عملي كله خالصًا لوجهك.","summary":"العبادة لله خالصة، بلا وسيط يقرّبك.","verses":[{"i":1,"of":1,"s":39,"surah":"الزمر","a":3,"text":"أَلَا لِلَّهِ الدِّينُ الْخَالِصُ وَالَّذِينَ اتَّخَذُوا مِنْ دُونِهِ أَوْلِيَاءَ مَا نَعْبُدُهُمْ إِلَّا لِيُقَرِّبُونَا إِلَى اللَّهِ زُلْفَى إِنَّ اللَّهَ يَحْكُمُ بَيْنَهُمْ فِي مَا هُمْ فِيهِ يَخْتَلِفُونَ إِنَّ اللَّهَ لَا يَهْدِي مَنْ هُوَ كَاذِبٌ كَفَّارٌ","prev":{"a":2,"text":"إِنَّا أَنْزَلْنَا إِلَيْكَ الْكِتَابَ بِالْحَقِّ فَاعْبُدِ اللَّهَ مُخْلِصًا لَهُ الدِّينَ"},"next":{"a":4,"text":"لَوْ أَرَادَ اللَّهُ أَنْ يَتَّخِذَ وَلَدًا لَاصْطَفَى مِمَّا يَخْلُقُ مَا يَشَاءُ سُبْحَانَهُ هُوَ اللَّهُ الْوَاحِدُ الْقَهَّارُ"},"context":"قبلها: فاعبد الله مخلصًا له الدين.","reason":"ردّ على قولهم: ما نعبدهم إلا ليقربونا."}],"hadiths":[],"situations":[{"situationId":169,"verses":[{"i":1,"strength":"direct","bridge":"لا تجعل بينك وبين الله واسطة: ﴿أَلَا لِلَّهِ الدِّينُ الْخَالِصُ﴾."}],"hadiths":[]}]},{"id":258,"name":"لله الشفاعة جميعاً","compound":true,"meaning":"لله الشفاعة جميعًا: الشفاعة كلها ملك لله، لا تكون إلا بإذنه.","teaches":"1. ردٌّ على من اتخذوا شفعاء لا يملكون شيئًا ولا يعقلون.","whenRecall":"- حين ترجو شفاعة أحد.","whenPray":"1. اللهم شفّع فيّ نبيك ﷺ.","summary":"اطلب الشفاعة من مالكها.","verses":[{"i":1,"of":1,"s":39,"surah":"الزمر","a":44,"text":"قُلْ لِلَّهِ الشَّفَاعَةُ جَمِيعًا لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ ثُمَّ إِلَيْهِ تُرْجَعُونَ","prev":{"a":43,"text":"أَمِ اتَّخَذُوا مِنْ دُونِ اللَّهِ شُفَعَاءَ قُلْ أَوَلَوْ كَانُوا لَا يَمْلِكُونَ شَيْئًا وَلَا يَعْقِلُونَ"},"next":{"a":45,"text":"وَإِذَا ذُكِرَ اللَّهُ وَحْدَهُ اشْمَأَزَّتْ قُلُوبُ الَّذِينَ لَا يُؤْمِنُونَ بِالْآخِرَةِ وَإِذَا ذُكِرَ الَّذِينَ مِنْ دُونِهِ إِذَا هُمْ يَسْتَبْشِرُونَ"},"context":"قبلها: أم اتخذوا من دون الله شفعاء.","reason":"الشفاعة لمالك السماوات والأرض."}],"hadiths":[],"situations":[{"situationId":184,"verses":[{"i":1,"strength":"direct","bridge":"من رجا الشفاعة فليطلبها من الله: ﴿قُلْ لِلَّهِ الشَّفَاعَةُ جَمِيعًا﴾."}],"hadiths":[]}]},{"id":259,"name":"له ما في السماوات والأرض","compound":true,"meaning":"له ما في السماوات والأرض: كل ما فيهما ملكه، خاضع له.","teaches":"1. ردٌّ على من نسب إليه الولد.\n2. وكل ما في السماوات والأرض يسبّح له.","whenRecall":"- حين تسمع نسبة الولد إليه.","whenPray":"1. سبحانك، لك ما في السماوات والأرض.","summary":"كل شيء ملكه وقانت له؛ فلا ولد ولا شريك.","verses":[{"i":1,"of":2,"s":2,"surah":"البقرة","a":116,"text":"وَقَالُوا اتَّخَذَ اللَّهُ وَلَدًا سُبْحَانَهُ بَلْ لَهُ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ كُلٌّ لَهُ قَانِتُونَ","prev":{"a":115,"text":"وَلِلَّهِ الْمَشْرِقُ وَالْمَغْرِبُ فَأَيْنَمَا تُوَلُّوا فَثَمَّ وَجْهُ اللَّهِ إِنَّ اللَّهَ وَاسِعٌ عَلِيمٌ"},"next":{"a":117,"text":"بَدِيعُ السَّمَاوَاتِ وَالْأَرْضِ وَإِذَا قَضَى أَمْرًا فَإِنَّمَا يَقُولُ لَهُ كُنْ فَيَكُونُ"},"context":"قبلها: ولله المشرق والمغرب.","reason":"التنزيه عن الولد بالملك والقنوت."},{"i":2,"of":2,"s":59,"surah":"الحشر","a":24,"text":"هُوَ اللَّهُ الْخَالِقُ الْبَارِئُ الْمُصَوِّرُ لَهُ الْأَسْمَاءُ الْحُسْنَى يُسَبِّحُ لَهُ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ وَهُوَ الْعَزِيزُ الْحَكِيمُ","prev":{"a":23,"text":"هُوَ اللَّهُ الَّذِي لَا إِلَهَ إِلَّا هُوَ الْمَلِكُ الْقُدُّوسُ السَّلَامُ الْمُؤْمِنُ الْمُهَيْمِنُ الْعَزِيزُ الْجَبَّارُ الْمُتَكَبِّرُ سُبْحَانَ اللَّهِ عَمَّا يُشْرِكُونَ"},"context":"ختام الحشر بعد الأسماء: الملك القدوس السلام...","reason":"الخالق البارئ المصور يسبّح له كل شيء."}],"hadiths":[],"situations":[{"situationId":106,"verses":[{"i":1,"strength":"direct","bridge":"إذا سمعت نسبة الولد إلى الله فقل: ﴿سُبْحَانَهُ بَلْ لَهُ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ كُلٌّ لَهُ قَانِتُونَ﴾."}],"hadiths":[]},{"situationId":165,"verses":[{"i":2,"strength":"direct","bridge":"إذا أردت أن تسبّح فاستحضر أن ﴿يُسَبِّحُ لَهُ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ﴾."}],"hadiths":[]}]},{"id":260,"name":"له ما في السماوات وما في الأرض","compound":true,"meaning":"له ما في السماوات وما في الأرض: الملك المفصّل لما في السماوات وما في الأرض.","teaches":"1. في آية الكرسي بعد الحي القيوم.\n2. وفي الرد على نسبة الولد.\n3. ومقرونة بالغنى والحمد والعلو.","whenRecall":"- حين تقرأ آية الكرسي.\n- حين تحتاج.","whenPray":"1. آية الكرسي في الصباح والمساء والنوم.","summary":"الحي القيوم الغني الحميد له كل ما في الكون.","verses":[{"i":1,"of":8,"s":2,"surah":"البقرة","a":255,"text":"اللَّهُ لَا إِلَهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ مَنْ ذَا الَّذِي يَشْفَعُ عِنْدَهُ إِلَّا بِإِذْنِهِ يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَلَا يُحِيطُونَ بِشَيْءٍ مِنْ عِلْمِهِ إِلَّا بِمَا شَاءَ وَسِعَ كُرْسِيُّهُ السَّمَاوَاتِ وَالْأَرْضَ وَلَا يَئُودُهُ حِفْظُهُمَا وَهُوَ الْعَلِيُّ الْعَظِيمُ","prev":{"a":254,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا أَنْفِقُوا مِمَّا رَزَقْنَاكُمْ مِنْ قَبْلِ أَنْ يَأْتِيَ يَوْمٌ لَا بَيْعٌ فِيهِ وَلَا خُلَّةٌ وَلَا شَفَاعَةٌ وَالْكَافِرُونَ هُمُ الظَّالِمُونَ"},"next":{"a":256,"text":"لَا إِكْرَاهَ فِي الدِّينِ قَدْ تَبَيَّنَ الرُّشْدُ مِنَ الْغَيِّ فَمَنْ يَكْفُرْ بِالطَّاغُوتِ وَيُؤْمِنْ بِاللَّهِ فَقَدِ اسْتَمْسَكَ بِالْعُرْوَةِ الْوُثْقَى لَا انْفِصَامَ لَهَا وَاللَّهُ سَمِيعٌ عَلِيمٌ"},"context":"آية الكرسي بعد الأمر بالإنفاق.","reason":"الملك يتبع الحياة والقيومية، ثم الشفاعة بإذنه."},{"i":2,"of":8,"s":4,"surah":"النساء","a":171,"text":"يَا أَهْلَ الْكِتَابِ لَا تَغْلُوا فِي دِينِكُمْ وَلَا تَقُولُوا عَلَى اللَّهِ إِلَّا الْحَقَّ إِنَّمَا الْمَسِيحُ عِيسَى ابْنُ مَرْيَمَ رَسُولُ اللَّهِ وَكَلِمَتُهُ أَلْقَاهَا إِلَى مَرْيَمَ وَرُوحٌ مِنْهُ فَآمِنُوا بِاللَّهِ وَرُسُلِهِ وَلَا تَقُولُوا ثَلَاثَةٌ انْتَهُوا خَيْرًا لَكُمْ إِنَّمَا اللَّهُ إِلَهٌ وَاحِدٌ سُبْحَانَهُ أَنْ يَكُونَ لَهُ وَلَدٌ لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَفَى بِاللَّهِ وَكِيلًا","prev":{"a":170,"text":"يَا أَيُّهَا النَّاسُ قَدْ جَاءَكُمُ الرَّسُولُ بِالْحَقِّ مِنْ رَبِّكُمْ فَآمِنُوا خَيْرًا لَكُمْ وَإِنْ تَكْفُرُوا فَإِنَّ لِلَّهِ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ وَكَانَ اللَّهُ عَلِيمًا حَكِيمًا"},"next":{"a":172,"text":"لَنْ يَسْتَنْكِفَ الْمَسِيحُ أَنْ يَكُونَ عَبْدًا لِلَّهِ وَلَا الْمَلَائِكَةُ الْمُقَرَّبُونَ وَمَنْ يَسْتَنْكِفْ عَنْ عِبَادَتِهِ وَيَسْتَكْبِرْ فَسَيَحْشُرُهُمْ إِلَيْهِ جَمِيعًا"},"context":"نهي أهل الكتاب عن الغلو في المسيح.","reason":"من له ما في السماوات والأرض لا يحتاج إلى ولد."},{"i":3,"of":8,"s":10,"surah":"يونس","a":68,"text":"قَالُوا اتَّخَذَ اللَّهُ وَلَدًا سُبْحَانَهُ هُوَ الْغَنِيُّ لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ إِنْ عِنْدَكُمْ مِنْ سُلْطَانٍ بِهَذَا أَتَقُولُونَ عَلَى اللَّهِ مَا لَا تَعْلَمُونَ","prev":{"a":67,"text":"هُوَ الَّذِي جَعَلَ لَكُمُ اللَّيْلَ لِتَسْكُنُوا فِيهِ وَالنَّهَارَ مُبْصِرًا إِنَّ فِي ذَلِكَ لَآيَاتٍ لِقَوْمٍ يَسْمَعُونَ"},"next":{"a":69,"text":"قُلْ إِنَّ الَّذِينَ يَفْتَرُونَ عَلَى اللَّهِ الْكَذِبَ لَا يُفْلِحُونَ"},"context":"بعد ذكر الليل للسكن والنهار للإبصار.","reason":"الغني لا يتخذ ولدًا، ولا برهان لهم."},{"i":4,"of":8,"s":14,"surah":"إبراهيم","a":2,"text":"اللَّهِ الَّذِي لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَوَيْلٌ لِلْكَافِرِينَ مِنْ عَذَابٍ شَدِيدٍ","prev":{"a":1,"text":"الر كِتَابٌ أَنْزَلْنَاهُ إِلَيْكَ لِتُخْرِجَ النَّاسَ مِنَ الظُّلُمَاتِ إِلَى النُّورِ بِإِذْنِ رَبِّهِمْ إِلَى صِرَاطِ الْعَزِيزِ الْحَمِيدِ"},"next":{"a":3,"text":"الَّذِينَ يَسْتَحِبُّونَ الْحَيَاةَ الدُّنْيَا عَلَى الْآخِرَةِ وَيَصُدُّونَ عَنْ سَبِيلِ اللَّهِ وَيَبْغُونَهَا عِوَجًا أُولَئِكَ فِي ضَلَالٍ بَعِيدٍ"},"context":"مطلع إبراهيم: الكتاب لإخراج الناس من الظلمات.","reason":"الهداية إلى صراط من يملك كل شيء."},{"i":5,"of":8,"s":20,"surah":"طه","a":6,"text":"لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَمَا بَيْنَهُمَا وَمَا تَحْتَ الثَّرَى","prev":{"a":5,"text":"الرَّحْمَنُ عَلَى الْعَرْشِ اسْتَوَى"},"next":{"a":7,"text":"وَإِنْ تَجْهَرْ بِالْقَوْلِ فَإِنَّهُ يَعْلَمُ السِّرَّ وَأَخْفَى"},"context":"قبلها: الرحمن على العرش استوى.","reason":"ملكه يمتد من العرش إلى ما تحت الثرى."},{"i":6,"of":8,"s":22,"surah":"الحج","a":64,"text":"لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَإِنَّ اللَّهَ لَهُوَ الْغَنِيُّ الْحَمِيدُ","prev":{"a":63,"text":"أَلَمْ تَرَ أَنَّ اللَّهَ أَنْزَلَ مِنَ السَّمَاءِ مَاءً فَتُصْبِحُ الْأَرْضُ مُخْضَرَّةً إِنَّ اللَّهَ لَطِيفٌ خَبِيرٌ"},"next":{"a":65,"text":"أَلَمْ تَرَ أَنَّ اللَّهَ سَخَّرَ لَكُمْ مَا فِي الْأَرْضِ وَالْفُلْكَ تَجْرِي فِي الْبَحْرِ بِأَمْرِهِ وَيُمْسِكُ السَّمَاءَ أَنْ تَقَعَ عَلَى الْأَرْضِ إِلَّا بِإِذْنِهِ إِنَّ اللَّهَ بِالنَّاسِ لَرَءُوفٌ رَحِيمٌ"},"context":"قبلها: إنزال الماء فتصبح الأرض مخضرة.","reason":"الملك مع الغنى والحمد."},{"i":7,"of":8,"s":42,"surah":"الشورى","a":4,"text":"لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَهُوَ الْعَلِيُّ الْعَظِيمُ","prev":{"a":3,"text":"كَذَلِكَ يُوحِي إِلَيْكَ وَإِلَى الَّذِينَ مِنْ قَبْلِكَ اللَّهُ الْعَزِيزُ الْحَكِيمُ"},"next":{"a":5,"text":"تَكَادُ السَّمَاوَاتُ يَتَفَطَّرْنَ مِنْ فَوْقِهِنَّ وَالْمَلَائِكَةُ يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ وَيَسْتَغْفِرُونَ لِمَنْ فِي الْأَرْضِ أَلَا إِنَّ اللَّهَ هُوَ الْغَفُورُ الرَّحِيمُ"},"context":"قبلها: كذلك يوحي إليك.","reason":"الملك مع العلو والعظمة."},{"i":8,"of":8,"s":42,"surah":"الشورى","a":53,"text":"صِرَاطِ اللَّهِ الَّذِي لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ أَلَا إِلَى اللَّهِ تَصِيرُ الْأُمُورُ","prev":{"a":52,"text":"وَكَذَلِكَ أَوْحَيْنَا إِلَيْكَ رُوحًا مِنْ أَمْرِنَا مَا كُنْتَ تَدْرِي مَا الْكِتَابُ وَلَا الْإِيمَانُ وَلَكِنْ جَعَلْنَاهُ نُورًا نَهْدِي بِهِ مَنْ نَشَاءُ مِنْ عِبَادِنَا وَإِنَّكَ لَتَهْدِي إِلَى صِرَاطٍ مُسْتَقِيمٍ"},"context":"ختام الشورى: إنك لتهدي إلى صراط مستقيم.","reason":"الصراط صراط المالك."}],"hadiths":[],"situations":[{"situationId":14,"verses":[{"i":8,"strength":"direct","bridge":"إذا احترت فاسلك ﴿صِرَاطِ اللَّهِ الَّذِي لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ﴾."}],"hadiths":[]},{"situationId":41,"verses":[{"i":6,"strength":"direct","bridge":"إن احتجت فاسأل ﴿الْغَنِيُّ الْحَمِيدُ﴾ الذي له ما في السماوات والأرض."}],"hadiths":[]},{"situationId":106,"verses":[{"i":2,"strength":"direct","bridge":"جواب شبهة الولد: ﴿سُبْحَانَهُ أَنْ يَكُونَ لَهُ وَلَدٌ لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ﴾."},{"i":3,"strength":"direct","bridge":"طالب من يدّعي على الله ببرهانه: ﴿إِنْ عِنْدَكُمْ مِنْ سُلْطَانٍ بِهَذَا﴾."}],"hadiths":[]},{"situationId":116,"verses":[{"i":4,"strength":"direct","bridge":"إذا أظلم طريقك فاسلك صراط ﴿اللَّهِ الَّذِي لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ﴾."}],"hadiths":[]},{"situationId":165,"verses":[{"i":1,"strength":"direct","bridge":"قبل نومك: ﴿لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ مَنْ ذَا الَّذِي يَشْفَعُ عِنْدَهُ إِلَّا بِإِذْنِهِ﴾."}],"hadiths":[]},{"situationId":174,"verses":[{"i":5,"strength":"direct","bridge":"لا شيء خارج ملكه: ﴿وَمَا بَيْنَهُمَا وَمَا تَحْتَ الثَّرَى﴾."},{"i":7,"strength":"direct","bridge":"إذا استعظمت شيئًا فتذكر: ﴿وَهُوَ الْعَلِيُّ الْعَظِيمُ﴾."}],"hadiths":[]}]},{"id":261,"name":"له غيب السماوات والأرض","compound":true,"meaning":"له غيب السماوات والأرض: علم الغائب كله عنده.","teaches":"1. جاءت في قصة أهل الكهف بعد الخلاف في مدة لبثهم.\n2. أبصر به وأسمع: كمال سمعه وبصره.","whenRecall":"- حين يكثر الخلاف في أمر غيبي.","whenPray":"1. اللهم أنت أعلم، فعلّمني ما ينفعني.","summary":"ما اختلف فيه الناس من الغيب، علمه عند الله.","verses":[{"i":1,"of":1,"s":18,"surah":"الكهف","a":26,"text":"قُلِ اللَّهُ أَعْلَمُ بِمَا لَبِثُوا لَهُ غَيْبُ السَّمَاوَاتِ وَالْأَرْضِ أَبْصِرْ بِهِ وَأَسْمِعْ مَا لَهُمْ مِنْ دُونِهِ مِنْ وَلِيٍّ وَلَا يُشْرِكُ فِي حُكْمِهِ أَحَدًا","prev":{"a":25,"text":"وَلَبِثُوا فِي كَهْفِهِمْ ثَلَاثَ مِائَةٍ سِنِينَ وَازْدَادُوا تِسْعًا"},"next":{"a":27,"text":"وَاتْلُ مَا أُوحِيَ إِلَيْكَ مِنْ كِتَابِ رَبِّكَ لَا مُبَدِّلَ لِكَلِمَاتِهِ وَلَنْ تَجِدَ مِنْ دُونِهِ مُلْتَحَدًا"},"context":"قبلها: لبثوا في كهفهم ثلاثمئة سنين وازدادوا تسعًا.","reason":"حسم الخلاف بردّ العلم إلى الله."}],"hadiths":[],"situations":[{"situationId":113,"verses":[{"i":1,"strength":"direct","bridge":"إذا اختلف الناس في غيب لا يُعلم فقل: ﴿قُلِ اللَّهُ أَعْلَمُ بِمَا لَبِثُوا لَهُ غَيْبُ السَّمَاوَاتِ وَالْأَرْضِ﴾."}],"hadiths":[]}]},{"id":262,"name":"له ما في السماوات وما في الأرض وله الحمد في الآخرة","compound":true,"meaning":"صيغة جامعة في مطلع سبأ: الملك في الدنيا، والحمد في الآخرة.","teaches":"1. الحمد في الدنيا على ملكه، وفي الآخرة على جزائه.","whenRecall":"- عند الحمد.","whenPray":"1. الحمد لله الذي له ما في السماوات وما في الأرض.","summary":"احمده على ملكه اليوم، وسيُحمد على جزائه غدًا.","verses":[{"i":1,"of":1,"s":34,"surah":"سبأ","a":1,"text":"الْحَمْدُ لِلَّهِ الَّذِي لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَلَهُ الْحَمْدُ فِي الْآخِرَةِ وَهُوَ الْحَكِيمُ الْخَبِيرُ","next":{"a":2,"text":"يَعْلَمُ مَا يَلِجُ فِي الْأَرْضِ وَمَا يَخْرُجُ مِنْهَا وَمَا يَنْزِلُ مِنَ السَّمَاءِ وَمَا يَعْرُجُ فِيهَا وَهُوَ الرَّحِيمُ الْغَفُورُ"},"context":"مطلع سورة سبأ.","reason":"افتتاح بالحمد على الملك والحكمة والخبرة."}],"hadiths":[],"situations":[{"situationId":144,"verses":[{"i":1,"strength":"direct","bridge":"احمد الله الحكيم الخبير: ﴿وَلَهُ الْحَمْدُ فِي الْآخِرَةِ وَهُوَ الْحَكِيمُ الْخَبِيرُ﴾."}],"hadiths":[]}]},{"id":263,"name":"له الحمد في السماوات والأرض وعشياً وحين تُظهرون","compound":true,"meaning":"له الحمد في السماوات والأرض وفي كل الأوقات: المساء والصباح والعشي والظهيرة.","teaches":"1. قرن التسبيح بالحمد في أوقات اليوم.\n2. قيل: إشارة إلى أوقات الصلوات.","whenRecall":"- في أوقات الصلاة والأذكار.","whenPray":"1. سبحان الله وبحمده في الصباح والمساء.","summary":"اجعل يومك موزعًا بين التسبيح والحمد.","verses":[{"i":1,"of":1,"s":30,"surah":"الروم","a":18,"text":"وَلَهُ الْحَمْدُ فِي السَّمَاوَاتِ وَالْأَرْضِ وَعَشِيًّا وَحِينَ تُظْهِرُونَ","prev":{"a":17,"text":"فَسُبْحَانَ اللَّهِ حِينَ تُمْسُونَ وَحِينَ تُصْبِحُونَ"},"next":{"a":19,"text":"يُخْرِجُ الْحَيَّ مِنَ الْمَيِّتِ وَيُخْرِجُ الْمَيِّتَ مِنَ الْحَيِّ وَيُحْيِي الْأَرْضَ بَعْدَ مَوْتِهَا وَكَذَلِكَ تُخْرَجُونَ"},"context":"قبلها: فسبحان الله حين تمسون وحين تصبحون.","reason":"الحمد في كل مكان وكل وقت."}],"hadiths":[{"i":1,"of":1,"text":"من قالَ حينَ يصبحُ { فَسُبْحَانَ اللَّهِ حِينَ تُمْسُونَ وَحِينَ تُصْبِحُونَ وَلَهُ الْحَمْدُ فِي السَّمَاوَاتِ وَالْأَرْضِ وَعَشِيًّا وَحِينَ تُظْهِرُونَ } إلى قوله { وَكَذَلِكَ تُخْرَجُونَ } أدرَك ما فاتَه في يومِه ذلِك ومن قالَهنَّ حينَ يمسي أدرَك ما فاتَه في ليلتِهِ","narrator":"عبدالله بن عباس","source":"هداية الرواة 2/471","grade":"حسن","judgment":"[حسن كما قال في المقدمة]","url":"https://dorar.net/h/ohzc3hxT","nameForm":"له الحمد في السماوات والأرض وعشياً وحين تُظهرون"}],"sunnah":{},"situations":[{"situationId":144,"verses":[{"i":1,"strength":"direct","bridge":"وزّع يومك على ذكره: ﴿وَلَهُ الْحَمْدُ فِي السَّمَاوَاتِ وَالْأَرْضِ وَعَشِيًّا وَحِينَ تُظْهِرُونَ﴾."}],"hadiths":[]}]},{"id":264,"name":"الملك اليوم لله الواحد القهار","compound":true,"meaning":"لمن الملك اليوم: يوم القيامة يتفرد الله بالملك ظاهرًا، الواحد القهار.","teaches":"1. سؤالٌ لا يجيبه أحد، فيجيب الله نفسه.\n2. يوم بروز الخلق لا يخفى منهم شيء.","whenRecall":"- حين ترى طغيان الملوك.","whenPray":"1. اللهم أنت الملك، فاجعلني ممن يأمن يوم البروز.","summary":"كل ملك يزول، ويبقى سؤال: لمن الملك اليوم؟","verses":[{"i":1,"of":1,"s":40,"surah":"غافر","a":16,"text":"يَوْمَ هُمْ بَارِزُونَ لَا يَخْفَى عَلَى اللَّهِ مِنْهُمْ شَيْءٌ لِمَنِ الْمُلْكُ الْيَوْمَ لِلَّهِ الْوَاحِدِ الْقَهَّارِ","prev":{"a":15,"text":"رَفِيعُ الدَّرَجَاتِ ذُو الْعَرْشِ يُلْقِي الرُّوحَ مِنْ أَمْرِهِ عَلَى مَنْ يَشَاءُ مِنْ عِبَادِهِ لِيُنْذِرَ يَوْمَ التَّلَاقِ"},"next":{"a":17,"text":"الْيَوْمَ تُجْزَى كُلُّ نَفْسٍ بِمَا كَسَبَتْ لَا ظُلْمَ الْيَوْمَ إِنَّ اللَّهَ سَرِيعُ الْحِسَابِ"},"context":"قبلها: رفيع الدرجات ذو العرش ليُنذر يوم التلاق.","reason":"يوم يبرز الخلق ينكشف أن الملك لله وحده."}],"hadiths":[{"i":1,"of":1,"text":"حديث  يومُ الدِّينِ يكون المُلكُ كلُّهُ للهِ الواحدِ القهارِ [يعني حديث:  عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهُما قالَ: يُنادي مُنادٍ بيْنَ يدَيِ السَّاعةِ: يا أيُّها النَّاسُ، أتَتْكم السَّاعةُ، فيَسمَعُها الأحياءُ والأمواتُ، ويَنزِلُ اللهُ إلى السَّماءِ الدُّنيا فيُنادي: لِمَنِ الملكُ اليومَ؟ للهِ الواحدِ القهَّارِ.]","narrator":"[عبدالله بن عباس]","source":"عارضة الأحوذي 6/71","grade":"صحيح","url":"https://dorar.net/h/ZcgG2O6r","nameForm":"الملك اليوم لله الواحد القهار"}],"sunnah":{},"situations":[{"situationId":32,"verses":[{"i":1,"strength":"direct","bridge":"إذا رأيت سلطانًا يطغى فتذكر: ﴿لِمَنِ الْمُلْكُ الْيَوْمَ لِلَّهِ الْوَاحِدِ الْقَهَّارِ﴾."}],"hadiths":[]}]},{"id":265,"name":"المساجد لله","compound":true,"meaning":"المساجد لله: أماكن السجود له وحده، فلا يُدعى فيها غيره.","teaches":"1. جاءت في سورة الجن بعد ذكر من أعرض عن ذكر ربه.","whenRecall":"- عند دخول المسجد.","whenPray":"1. أن تدخل المسجد وأنت لا تدعو مع الله أحدًا.","summary":"في المسجد: الدعاء لله وحده.","verses":[{"i":1,"of":1,"s":72,"surah":"الجن","a":18,"text":"وَأَنَّ الْمَسَاجِدَ لِلَّهِ فَلَا تَدْعُوا مَعَ اللَّهِ أَحَدًا","prev":{"a":17,"text":"لِنَفْتِنَهُمْ فِيهِ وَمَنْ يُعْرِضْ عَنْ ذِكْرِ رَبِّهِ يَسْلُكْهُ عَذَابًا صَعَدًا"},"next":{"a":19,"text":"وَأَنَّهُ لَمَّا قَامَ عَبْدُ اللَّهِ يَدْعُوهُ كَادُوا يَكُونُونَ عَلَيْهِ لِبَدًا"},"context":"قبلها: ومن يعرض عن ذكر ربه يسلكه عذابًا صعدًا.","reason":"المساجد لله، فلا يُدعى معه أحد."}],"hadiths":[],"situations":[{"situationId":169,"verses":[{"i":1,"strength":"direct","bridge":"إذا دخلت المسجد فادعُه وحده: ﴿وَأَنَّ الْمَسَاجِدَ لِلَّهِ فَلَا تَدْعُوا مَعَ اللَّهِ أَحَدًا﴾."}],"hadiths":[]}]},{"id":266,"name":"لله المثل الأعلى","compound":true,"meaning":"لله المثل الأعلى: الوصف الأكمل والأعلى لله وحده.","teaches":"1. جاءت ردًّا على من نسبوا إلى الله البنات وكرهوهن لأنفسهم.","whenRecall":"- حين تسمع ما لا يليق بالله.","whenPray":"1. سبحانك، لك المثل الأعلى.","summary":"كل كمال لله، وكل نقص منزّه عنه.","verses":[{"i":1,"of":1,"s":16,"surah":"النحل","a":60,"text":"لِلَّذِينَ لَا يُؤْمِنُونَ بِالْآخِرَةِ مَثَلُ السَّوْءِ وَلِلَّهِ الْمَثَلُ الْأَعْلَى وَهُوَ الْعَزِيزُ الْحَكِيمُ","prev":{"a":59,"text":"يَتَوَارَى مِنَ الْقَوْمِ مِنْ سُوءِ مَا بُشِّرَ بِهِ أَيُمْسِكُهُ عَلَى هُونٍ أَمْ يَدُسُّهُ فِي التُّرَابِ أَلَا سَاءَ مَا يَحْكُمُونَ"},"next":{"a":61,"text":"وَلَوْ يُؤَاخِذُ اللَّهُ النَّاسَ بِظُلْمِهِمْ مَا تَرَكَ عَلَيْهَا مِنْ دَابَّةٍ وَلَكِنْ يُؤَخِّرُهُمْ إِلَى أَجَلٍ مُسَمًّى فَإِذَا جَاءَ أَجَلُهُمْ لَا يَسْتَأْخِرُونَ سَاعَةً وَلَا يَسْتَقْدِمُونَ"},"context":"قبلها: من بُشّر بالأنثى ظل وجهه مسودًّا.","reason":"ردّ على من ينسب إلى الله ما يكرهه لنفسه."}],"hadiths":[],"situations":[{"situationId":52,"verses":[{"i":1,"strength":"direct","bridge":"إذا كرهت ما وُهب لك من البنات فتذكر: ﴿وَلِلَّهِ الْمَثَلُ الْأَعْلَى﴾."}],"hadiths":[]}]},{"id":267,"name":"وله ما في السماوات والأرض وله الدين واصباً","compound":true,"meaning":"وله الدين واصبًا: الطاعة له دائمة لازمة.","teaches":"1. جاءت بعد النهي عن اتخاذ إلهين.\n2. ثم سؤال: أفغير الله تتقون؟","whenRecall":"- حين تخاف غير الله.","whenPray":"1. اللهم اجعل طاعتي لك دائمة.","summary":"من له الملك والدين الدائم فهو أحق أن يُتّقى.","verses":[{"i":1,"of":1,"s":16,"surah":"النحل","a":52,"text":"وَلَهُ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ وَلَهُ الدِّينُ وَاصِبًا أَفَغَيْرَ اللَّهِ تَتَّقُونَ","prev":{"a":51,"text":"وَقَالَ اللَّهُ لَا تَتَّخِذُوا إِلَهَيْنِ اثْنَيْنِ إِنَّمَا هُوَ إِلَهٌ وَاحِدٌ فَإِيَّايَ فَارْهَبُونِ"},"next":{"a":53,"text":"وَمَا بِكُمْ مِنْ نِعْمَةٍ فَمِنَ اللَّهِ ثُمَّ إِذَا مَسَّكُمُ الضُّرُّ فَإِلَيْهِ تَجْأَرُونَ"},"context":"قبلها: لا تتخذوا إلهين اثنين.","reason":"الطاعة الدائمة له، فلا يُتقى غيره."}],"hadiths":[],"situations":[{"situationId":94,"verses":[{"i":1,"strength":"direct","bridge":"إذا خفت أحدًا أكثر من الله: ﴿وَلَهُ الدِّينُ وَاصِبًا أَفَغَيْرَ اللَّهِ تَتَّقُونَ﴾."}],"hadiths":[]}]},{"id":268,"name":"العزة لله جميعاً","compound":true,"meaning":"العزة لله جميعًا: العزة كلها لله، يعطيها من يشاء.","teaches":"1. ردٌّ على من يطلب العزة عند الكافرين.\n2. وتسلية للنبي ﷺ: لا يحزنك قولهم.","whenRecall":"- حين تطلب المكانة عند أهل الباطل.\n- حين يحزنك كلام الناس.","whenPray":"1. اللهم أعزني بطاعتك.","summary":"لا عزة إلا من الله؛ فلا تطلبها عند غيره ولا يحزنك قولهم.","verses":[{"i":1,"of":2,"s":4,"surah":"النساء","a":139,"text":"الَّذِينَ يَتَّخِذُونَ الْكَافِرِينَ أَوْلِيَاءَ مِنْ دُونِ الْمُؤْمِنِينَ أَيَبْتَغُونَ عِنْدَهُمُ الْعِزَّةَ فَإِنَّ الْعِزَّةَ لِلَّهِ جَمِيعًا","prev":{"a":138,"text":"بَشِّرِ الْمُنَافِقِينَ بِأَنَّ لَهُمْ عَذَابًا أَلِيمًا"},"next":{"a":140,"text":"وَقَدْ نَزَّلَ عَلَيْكُمْ فِي الْكِتَابِ أَنْ إِذَا سَمِعْتُمْ آيَاتِ اللَّهِ يُكْفَرُ بِهَا وَيُسْتَهْزَأُ بِهَا فَلَا تَقْعُدُوا مَعَهُمْ حَتَّى يَخُوضُوا فِي حَدِيثٍ غَيْرِهِ إِنَّكُمْ إِذًا مِثْلُهُمْ إِنَّ اللَّهَ جَامِعُ الْمُنَافِقِينَ وَالْكَافِرِينَ فِي جَهَنَّمَ جَمِيعًا"},"context":"قبلها: بشّر المنافقين بعذاب أليم.","reason":"طلبوا العزة عند الكافرين، والعزة لله."},{"i":2,"of":2,"s":10,"surah":"يونس","a":65,"text":"وَلَا يَحْزُنْكَ قَوْلُهُمْ إِنَّ الْعِزَّةَ لِلَّهِ جَمِيعًا هُوَ السَّمِيعُ الْعَلِيمُ","prev":{"a":64,"text":"لَهُمُ الْبُشْرَى فِي الْحَيَاةِ الدُّنْيَا وَفِي الْآخِرَةِ لَا تَبْدِيلَ لِكَلِمَاتِ اللَّهِ ذَلِكَ هُوَ الْفَوْزُ الْعَظِيمُ"},"next":{"a":66,"text":"أَلَا إِنَّ لِلَّهِ مَنْ فِي السَّمَاوَاتِ وَمَنْ فِي الْأَرْضِ وَمَا يَتَّبِعُ الَّذِينَ يَدْعُونَ مِنْ دُونِ اللَّهِ شُرَكَاءَ إِنْ يَتَّبِعُونَ إِلَّا الظَّنَّ وَإِنْ هُمْ إِلَّا يَخْرُصُونَ"},"context":"قبلها: البشرى لأولياء الله.","reason":"تسلية من أقوال المكذبين."}],"hadiths":[],"situations":[{"situationId":29,"verses":[{"i":2,"strength":"direct","bridge":"إذا أحزنك كلامهم: ﴿وَلَا يَحْزُنْكَ قَوْلُهُمْ إِنَّ الْعِزَّةَ لِلَّهِ جَمِيعًا﴾."}],"hadiths":[]},{"situationId":81,"verses":[{"i":1,"strength":"direct","bridge":"لا تطلب مكانتك عند أهل الباطل: ﴿أَيَبْتَغُونَ عِنْدَهُمُ الْعِزَّةَ فَإِنَّ الْعِزَّةَ لِلَّهِ جَمِيعًا﴾."}],"hadiths":[]}]},{"id":269,"name":"القوة لله جميعاً","compound":true,"meaning":"القوة لله جميعًا: القوة كلها لله، ويظهر ذلك حين يُرى العذاب.","teaches":"1. جاءت في الذين يحبون الأنداد كحب الله.\n2. المؤمنون أشد حبًّا لله.","whenRecall":"- حين يتعلق قلبك بمخلوق محبةً.","whenPray":"1. اللهم اجعل حبك أحب إليّ من كل شيء.","summary":"من أحب غير الله كحبه سيرى أن القوة لله جميعًا.","verses":[{"i":1,"of":1,"s":2,"surah":"البقرة","a":165,"text":"وَمِنَ النَّاسِ مَنْ يَتَّخِذُ مِنْ دُونِ اللَّهِ أَنْدَادًا يُحِبُّونَهُمْ كَحُبِّ اللَّهِ وَالَّذِينَ آمَنُوا أَشَدُّ حُبًّا لِلَّهِ وَلَوْ يَرَى الَّذِينَ ظَلَمُوا إِذْ يَرَوْنَ الْعَذَابَ أَنَّ الْقُوَّةَ لِلَّهِ جَمِيعًا وَأَنَّ اللَّهَ شَدِيدُ الْعَذَابِ","prev":{"a":164,"text":"إِنَّ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ وَاخْتِلَافِ اللَّيْلِ وَالنَّهَارِ وَالْفُلْكِ الَّتِي تَجْرِي فِي الْبَحْرِ بِمَا يَنْفَعُ النَّاسَ وَمَا أَنْزَلَ اللَّهُ مِنَ السَّمَاءِ مِنْ مَاءٍ فَأَحْيَا بِهِ الْأَرْضَ بَعْدَ مَوْتِهَا وَبَثَّ فِيهَا مِنْ كُلِّ دَابَّةٍ وَتَصْرِيفِ الرِّيَاحِ وَالسَّحَابِ الْمُسَخَّرِ بَيْنَ السَّمَاءِ وَالْأَرْضِ لَآيَاتٍ لِقَوْمٍ يَعْقِلُونَ"},"next":{"a":166,"text":"إِذْ تَبَرَّأَ الَّذِينَ اتُّبِعُوا مِنَ الَّذِينَ اتَّبَعُوا وَرَأَوُا الْعَذَابَ وَتَقَطَّعَتْ بِهِمُ الْأَسْبَابُ"},"context":"قبلها: آيات خلق السماوات والأرض.","reason":"حب الأنداد ينكشف عند العذاب: القوة لله."}],"hadiths":[],"situations":[{"situationId":94,"verses":[{"i":1,"strength":"direct","bridge":"زن حبك: ﴿وَالَّذِينَ آمَنُوا أَشَدُّ حُبًّا لِلَّهِ﴾."}],"hadiths":[]}]},{"id":270,"name":"الولاية لله الحق","compound":true,"meaning":"الولاية لله الحق: النصرة والتولي في الشدائد لله وحده.","teaches":"1. ختام قصة صاحب الجنتين بعد هلاك جنته.\n2. لم تكن له فئة تنصره.","whenRecall":"- حين يهلك ما اغتررت به.","whenPray":"1. اللهم كن وليي، فأنت خير ثوابًا وخير عقبى.","summary":"عند زوال ما اعتمدت عليه، تبقى الولاية لله.","verses":[{"i":1,"of":1,"s":18,"surah":"الكهف","a":44,"text":"هُنَالِكَ الْوَلَايَةُ لِلَّهِ الْحَقِّ هُوَ خَيْرٌ ثَوَابًا وَخَيْرٌ عُقْبًا","prev":{"a":43,"text":"وَلَمْ تَكُنْ لَهُ فِئَةٌ يَنْصُرُونَهُ مِنْ دُونِ اللَّهِ وَمَا كَانَ مُنْتَصِرًا"},"next":{"a":45,"text":"وَاضْرِبْ لَهُمْ مَثَلَ الْحَيَاةِ الدُّنْيَا كَمَاءٍ أَنْزَلْنَاهُ مِنَ السَّمَاءِ فَاخْتَلَطَ بِهِ نَبَاتُ الْأَرْضِ فَأَصْبَحَ هَشِيمًا تَذْرُوهُ الرِّيَاحُ وَكَانَ اللَّهُ عَلَى كُلِّ شَيْءٍ مُقْتَدِرًا"},"context":"قبلها: لم تكن له فئة ينصرونه من دون الله.","reason":"بعد هلاك الجنة انكشف أن الولاية لله."}],"hadiths":[],"situations":[{"situationId":3,"verses":[{"i":1,"strength":"direct","bridge":"إذا ضاع ما اعتمدت عليه: ﴿هُنَالِكَ الْوَلَايَةُ لِلَّهِ الْحَقِّ هُوَ خَيْرٌ ثَوَابًا وَخَيْرٌ عُقْبًا﴾."}],"hadiths":[]}]},{"id":271,"name":"لله ميراث السماوات والأرض","compound":true,"meaning":"لله ميراث السماوات والأرض: كل شيء يعود إليه بعد فناء الخلق.","teaches":"1. تأتي في سياق البخل والإنفاق.\n2. ما تبخل به سيعود إلى الله.","whenRecall":"- حين تبخل بمالك.","whenPray":"1. اللهم قني شح نفسي.","summary":"مالك سيورث؛ فأنفقه قبل أن يرجع إلى وارث السماوات والأرض.","verses":[{"i":1,"of":2,"s":3,"surah":"آل عمران","a":180,"text":"وَلَا يَحْسَبَنَّ الَّذِينَ يَبْخَلُونَ بِمَا آتَاهُمُ اللَّهُ مِنْ فَضْلِهِ هُوَ خَيْرًا لَهُمْ بَلْ هُوَ شَرٌّ لَهُمْ سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ وَلِلَّهِ مِيرَاثُ السَّمَاوَاتِ وَالْأَرْضِ وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ","prev":{"a":179,"text":"مَا كَانَ اللَّهُ لِيَذَرَ الْمُؤْمِنِينَ عَلَى مَا أَنْتُمْ عَلَيْهِ حَتَّى يَمِيزَ الْخَبِيثَ مِنَ الطَّيِّبِ وَمَا كَانَ اللَّهُ لِيُطْلِعَكُمْ عَلَى الْغَيْبِ وَلَكِنَّ اللَّهَ يَجْتَبِي مِنْ رُسُلِهِ مَنْ يَشَاءُ فَآمِنُوا بِاللَّهِ وَرُسُلِهِ وَإِنْ تُؤْمِنُوا وَتَتَّقُوا فَلَكُمْ أَجْرٌ عَظِيمٌ"},"next":{"a":181,"text":"لَقَدْ سَمِعَ اللَّهُ قَوْلَ الَّذِينَ قَالُوا إِنَّ اللَّهَ فَقِيرٌ وَنَحْنُ أَغْنِيَاءُ سَنَكْتُبُ مَا قَالُوا وَقَتْلَهُمُ الْأَنْبِيَاءَ بِغَيْرِ حَقٍّ وَنَقُولُ ذُوقُوا عَذَابَ الْحَرِيقِ"},"context":"قبلها: ما كان الله ليذر المؤمنين على ما أنتم عليه.","reason":"البخل شر، والمال يعود لله."},{"i":2,"of":2,"s":57,"surah":"الحديد","a":10,"text":"وَمَا لَكُمْ أَلَّا تُنْفِقُوا فِي سَبِيلِ اللَّهِ وَلِلَّهِ مِيرَاثُ السَّمَاوَاتِ وَالْأَرْضِ لَا يَسْتَوِي مِنْكُمْ مَنْ أَنْفَقَ مِنْ قَبْلِ الْفَتْحِ وَقَاتَلَ أُولَئِكَ أَعْظَمُ دَرَجَةً مِنَ الَّذِينَ أَنْفَقُوا مِنْ بَعْدُ وَقَاتَلُوا وَكُلًّا وَعَدَ اللَّهُ الْحُسْنَى وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ","prev":{"a":9,"text":"هُوَ الَّذِي يُنَزِّلُ عَلَى عَبْدِهِ آيَاتٍ بَيِّنَاتٍ لِيُخْرِجَكُمْ مِنَ الظُّلُمَاتِ إِلَى النُّورِ وَإِنَّ اللَّهَ بِكُمْ لَرَءُوفٌ رَحِيمٌ"},"next":{"a":11,"text":"مَنْ ذَا الَّذِي يُقْرِضُ اللَّهَ قَرْضًا حَسَنًا فَيُضَاعِفَهُ لَهُ وَلَهُ أَجْرٌ كَرِيمٌ"},"context":"قبلها: هو الذي ينزل على عبده آيات بينات.","reason":"سؤال: ما لكم لا تنفقون والكل لله؟"}],"hadiths":[],"situations":[{"situationId":44,"verses":[{"i":1,"strength":"direct","bridge":"إذا بخلت فاعلم أنك ﴿سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ﴾ ﴿وَلِلَّهِ مِيرَاثُ السَّمَاوَاتِ وَالْأَرْضِ﴾."},{"i":2,"strength":"direct","bridge":"﴿وَمَا لَكُمْ أَلَّا تُنْفِقُوا فِي سَبِيلِ اللَّهِ وَلِلَّهِ مِيرَاثُ السَّمَاوَاتِ وَالْأَرْضِ﴾."}],"hadiths":[]}]},{"id":272,"name":"لله ما في السماوات والأرض","compound":true,"meaning":"لله ما في السماوات والأرض: الملك العام بصيغة تقديم الجار، أي له وحده.","teaches":"1. تأتي مع: إن تكفروا فإن لله ما في السماوات والأرض — غناه عنكم.\n2. ومع: وعد الله حق.\n3. ومع التسبيح.","whenRecall":"- حين تظن أن الله يحتاج طاعتك.","whenPray":"1. اللهم أنت الغني وأنا الفقير.","summary":"كفرك لا يضره وطاعتك لا تنفعه؛ لله ما في السماوات والأرض.","verses":[{"i":1,"of":5,"s":4,"surah":"النساء","a":170,"text":"يَا أَيُّهَا النَّاسُ قَدْ جَاءَكُمُ الرَّسُولُ بِالْحَقِّ مِنْ رَبِّكُمْ فَآمِنُوا خَيْرًا لَكُمْ وَإِنْ تَكْفُرُوا فَإِنَّ لِلَّهِ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ وَكَانَ اللَّهُ عَلِيمًا حَكِيمًا","prev":{"a":169,"text":"إِلَّا طَرِيقَ جَهَنَّمَ خَالِدِينَ فِيهَا أَبَدًا وَكَانَ ذَلِكَ عَلَى اللَّهِ يَسِيرًا"},"next":{"a":171,"text":"يَا أَهْلَ الْكِتَابِ لَا تَغْلُوا فِي دِينِكُمْ وَلَا تَقُولُوا عَلَى اللَّهِ إِلَّا الْحَقَّ إِنَّمَا الْمَسِيحُ عِيسَى ابْنُ مَرْيَمَ رَسُولُ اللَّهِ وَكَلِمَتُهُ أَلْقَاهَا إِلَى مَرْيَمَ وَرُوحٌ مِنْهُ فَآمِنُوا بِاللَّهِ وَرُسُلِهِ وَلَا تَقُولُوا ثَلَاثَةٌ انْتَهُوا خَيْرًا لَكُمْ إِنَّمَا اللَّهُ إِلَهٌ وَاحِدٌ سُبْحَانَهُ أَنْ يَكُونَ لَهُ وَلَدٌ لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَفَى بِاللَّهِ وَكِيلًا"},"context":"قبلها: طريق جهنم لمن كفر وظلم.","reason":"غناه عن الكافرين."},{"i":2,"of":5,"s":10,"surah":"يونس","a":55,"text":"أَلَا إِنَّ لِلَّهِ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ أَلَا إِنَّ وَعْدَ اللَّهِ حَقٌّ وَلَكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ","prev":{"a":54,"text":"وَلَوْ أَنَّ لِكُلِّ نَفْسٍ ظَلَمَتْ مَا فِي الْأَرْضِ لَافْتَدَتْ بِهِ وَأَسَرُّوا النَّدَامَةَ لَمَّا رَأَوُا الْعَذَابَ وَقُضِيَ بَيْنَهُمْ بِالْقِسْطِ وَهُمْ لَا يُظْلَمُونَ"},"next":{"a":56,"text":"هُوَ يُحْيِي وَيُمِيتُ وَإِلَيْهِ تُرْجَعُونَ"},"context":"قبلها: لو أن لكل نفس ظلمت ما في الأرض لافتدت به.","reason":"الملك له ووعده حق."},{"i":3,"of":5,"s":24,"surah":"النور","a":64,"text":"أَلَا إِنَّ لِلَّهِ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ قَدْ يَعْلَمُ مَا أَنْتُمْ عَلَيْهِ وَيَوْمَ يُرْجَعُونَ إِلَيْهِ فَيُنَبِّئُهُمْ بِمَا عَمِلُوا وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ","prev":{"a":63,"text":"لَا تَجْعَلُوا دُعَاءَ الرَّسُولِ بَيْنَكُمْ كَدُعَاءِ بَعْضِكُمْ بَعْضًا قَدْ يَعْلَمُ اللَّهُ الَّذِينَ يَتَسَلَّلُونَ مِنْكُمْ لِوَاذًا فَلْيَحْذَرِ الَّذِينَ يُخَالِفُونَ عَنْ أَمْرِهِ أَنْ تُصِيبَهُمْ فِتْنَةٌ أَوْ يُصِيبَهُمْ عَذَابٌ أَلِيمٌ"},"context":"ختام النور بعد التحذير من مخالفة الرسول.","reason":"يعلم ما أنتم عليه وسينبئكم."},{"i":4,"of":5,"s":31,"surah":"لقمان","a":26,"text":"لِلَّهِ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ إِنَّ اللَّهَ هُوَ الْغَنِيُّ الْحَمِيدُ","prev":{"a":25,"text":"وَلَئِنْ سَأَلْتَهُمْ مَنْ خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ لَيَقُولُنَّ اللَّهُ قُلِ الْحَمْدُ لِلَّهِ بَلْ أَكْثَرُهُمْ لَا يَعْلَمُونَ"},"next":{"a":27,"text":"وَلَوْ أَنَّمَا فِي الْأَرْضِ مِنْ شَجَرَةٍ أَقْلَامٌ وَالْبَحْرُ يَمُدُّهُ مِنْ بَعْدِهِ سَبْعَةُ أَبْحُرٍ مَا نَفِدَتْ كَلِمَاتُ اللَّهِ إِنَّ اللَّهَ عَزِيزٌ حَكِيمٌ"},"context":"قبلها: سؤال المشركين عن خالق السماوات والأرض.","reason":"الملك مع الغنى والحمد."},{"i":5,"of":5,"s":57,"surah":"الحديد","a":1,"text":"سَبَّحَ لِلَّهِ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ وَهُوَ الْعَزِيزُ الْحَكِيمُ","next":{"a":2,"text":"لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ يُحْيِي وَيُمِيتُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},"context":"مطلع الحديد.","reason":"التسبيح الكوني مع العزة والحكمة."}],"hadiths":[],"situations":[{"situationId":41,"verses":[{"i":4,"strength":"direct","bridge":"إذا افتقرت فاسأل ﴿الْغَنِيُّ الْحَمِيدُ﴾."}],"hadiths":[]},{"situationId":73,"verses":[{"i":3,"strength":"direct","bridge":"ما أنت عليه الآن معلوم: ﴿قَدْ يَعْلَمُ مَا أَنْتُمْ عَلَيْهِ﴾."}],"hadiths":[]},{"situationId":110,"verses":[{"i":2,"strength":"direct","bridge":"لا تشكّ في الوعد: ﴿أَلَا إِنَّ وَعْدَ اللَّهِ حَقٌّ﴾."}],"hadiths":[]},{"situationId":119,"verses":[{"i":1,"strength":"direct","bridge":"إيمانك لك: ﴿فَآمِنُوا خَيْرًا لَكُمْ وَإِنْ تَكْفُرُوا فَإِنَّ لِلَّهِ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ﴾."}],"hadiths":[]},{"situationId":165,"verses":[{"i":5,"strength":"direct","bridge":"سبّح مع الكون: ﴿سَبَّحَ لِلَّهِ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ﴾."}],"hadiths":[]}]},{"id":273,"name":"لله ما في السماوات وما في الأرض","compound":true,"meaning":"لله ما في السماوات وما في الأرض: ملكٌ يقتضي الحساب على ما في النفوس، والجزاء، والغنى.","teaches":"1. أكثر مواضعها في النساء، مع الوصية بالتقوى.\n2. ومع المحاسبة على ما في النفس (البقرة 284).\n3. ومع التسبيح في مطالع السور.","whenRecall":"- حين يختلج في نفسك ما تخافه.\n- حين تظن أن الله يحتاجك.","whenPray":"1. ﴿لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ﴾ تُقرأ مع خواتيم البقرة.","summary":"المالك يحاسب ويجزي ويُسبَّح، وهو غني عنك.","verses":[{"i":1,"of":11,"s":2,"surah":"البقرة","a":284,"text":"لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَإِنْ تُبْدُوا مَا فِي أَنْفُسِكُمْ أَوْ تُخْفُوهُ يُحَاسِبْكُمْ بِهِ اللَّهُ فَيَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":283,"text":"وَإِنْ كُنْتُمْ عَلَى سَفَرٍ وَلَمْ تَجِدُوا كَاتِبًا فَرِهَانٌ مَقْبُوضَةٌ فَإِنْ أَمِنَ بَعْضُكُمْ بَعْضًا فَلْيُؤَدِّ الَّذِي اؤْتُمِنَ أَمَانَتَهُ وَلْيَتَّقِ اللَّهَ رَبَّهُ وَلَا تَكْتُمُوا الشَّهَادَةَ وَمَنْ يَكْتُمْهَا فَإِنَّهُ آثِمٌ قَلْبُهُ وَاللَّهُ بِمَا تَعْمَلُونَ عَلِيمٌ"},"next":{"a":285,"text":"آمَنَ الرَّسُولُ بِمَا أُنْزِلَ إِلَيْهِ مِنْ رَبِّهِ وَالْمُؤْمِنُونَ كُلٌّ آمَنَ بِاللَّهِ وَمَلَائِكَتِهِ وَكُتُبِهِ وَرُسُلِهِ لَا نُفَرِّقُ بَيْنَ أَحَدٍ مِنْ رُسُلِهِ وَقَالُوا سَمِعْنَا وَأَطَعْنَا غُفْرَانَكَ رَبَّنَا وَإِلَيْكَ الْمَصِيرُ"},"context":"قبلها: أحكام الرهن والشهادة.","reason":"الملك يقتضي المحاسبة على ما تخفيه النفس."},{"i":2,"of":11,"s":3,"surah":"آل عمران","a":109,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ","prev":{"a":108,"text":"تِلْكَ آيَاتُ اللَّهِ نَتْلُوهَا عَلَيْكَ بِالْحَقِّ وَمَا اللَّهُ يُرِيدُ ظُلْمًا لِلْعَالَمِينَ"},"next":{"a":110,"text":"كُنْتُمْ خَيْرَ أُمَّةٍ أُخْرِجَتْ لِلنَّاسِ تَأْمُرُونَ بِالْمَعْرُوفِ وَتَنْهَوْنَ عَنِ الْمُنْكَرِ وَتُؤْمِنُونَ بِاللَّهِ وَلَوْ آمَنَ أَهْلُ الْكِتَابِ لَكَانَ خَيْرًا لَهُمْ مِنْهُمُ الْمُؤْمِنُونَ وَأَكْثَرُهُمُ الْفَاسِقُونَ"},"context":"قبلها: وما الله يريد ظلمًا للعالمين.","reason":"الملك والأمور إليه."},{"i":3,"of":11,"s":3,"surah":"آل عمران","a":129,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ يَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ وَاللَّهُ غَفُورٌ رَحِيمٌ","prev":{"a":128,"text":"لَيْسَ لَكَ مِنَ الْأَمْرِ شَيْءٌ أَوْ يَتُوبَ عَلَيْهِمْ أَوْ يُعَذِّبَهُمْ فَإِنَّهُمْ ظَالِمُونَ"},"next":{"a":130,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَأْكُلُوا الرِّبَا أَضْعَافًا مُضَاعَفَةً وَاتَّقُوا اللَّهَ لَعَلَّكُمْ تُفْلِحُونَ"},"context":"قبلها: ليس لك من الأمر شيء.","reason":"حتى النبي ﷺ ليس له من الأمر شيء؛ المغفرة والعذاب لله."},{"i":4,"of":11,"s":4,"surah":"النساء","a":126,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَانَ اللَّهُ بِكُلِّ شَيْءٍ مُحِيطًا","prev":{"a":125,"text":"وَمَنْ أَحْسَنُ دِينًا مِمَّنْ أَسْلَمَ وَجْهَهُ لِلَّهِ وَهُوَ مُحْسِنٌ وَاتَّبَعَ مِلَّةَ إِبْرَاهِيمَ حَنِيفًا وَاتَّخَذَ اللَّهُ إِبْرَاهِيمَ خَلِيلًا"},"next":{"a":127,"text":"وَيَسْتَفْتُونَكَ فِي النِّسَاءِ قُلِ اللَّهُ يُفْتِيكُمْ فِيهِنَّ وَمَا يُتْلَى عَلَيْكُمْ فِي الْكِتَابِ فِي يَتَامَى النِّسَاءِ اللَّاتِي لَا تُؤْتُونَهُنَّ مَا كُتِبَ لَهُنَّ وَتَرْغَبُونَ أَنْ تَنْكِحُوهُنَّ وَالْمُسْتَضْعَفِينَ مِنَ الْوِلْدَانِ وَأَنْ تَقُومُوا لِلْيَتَامَى بِالْقِسْطِ وَمَا تَفْعَلُوا مِنْ خَيْرٍ فَإِنَّ اللَّهَ كَانَ بِهِ عَلِيمًا"},"context":"قبلها: من أحسن دينًا ممن أسلم وجهه لله.","reason":"الملك مع الإحاطة."},{"i":5,"of":11,"s":4,"surah":"النساء","a":131,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَلَقَدْ وَصَّيْنَا الَّذِينَ أُوتُوا الْكِتَابَ مِنْ قَبْلِكُمْ وَإِيَّاكُمْ أَنِ اتَّقُوا اللَّهَ وَإِنْ تَكْفُرُوا فَإِنَّ لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَانَ اللَّهُ غَنِيًّا حَمِيدًا","prev":{"a":130,"text":"وَإِنْ يَتَفَرَّقَا يُغْنِ اللَّهُ كُلًّا مِنْ سَعَتِهِ وَكَانَ اللَّهُ وَاسِعًا حَكِيمًا"},"next":{"a":132,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَفَى بِاللَّهِ وَكِيلًا"},"context":"قبلها: إن يتفرقا يغن الله كلًّا من سعته.","reason":"بعد الطلاق: الغنى من الله، والوصية بالتقوى."},{"i":6,"of":11,"s":4,"surah":"النساء","a":132,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَفَى بِاللَّهِ وَكِيلًا","prev":{"a":131,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَلَقَدْ وَصَّيْنَا الَّذِينَ أُوتُوا الْكِتَابَ مِنْ قَبْلِكُمْ وَإِيَّاكُمْ أَنِ اتَّقُوا اللَّهَ وَإِنْ تَكْفُرُوا فَإِنَّ لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَانَ اللَّهُ غَنِيًّا حَمِيدًا"},"next":{"a":133,"text":"إِنْ يَشَأْ يُذْهِبْكُمْ أَيُّهَا النَّاسُ وَيَأْتِ بِآخَرِينَ وَكَانَ اللَّهُ عَلَى ذَلِكَ قَدِيرًا"},"context":"تكرار الملك بعد الوصية.","reason":"الملك مع الوكالة."},{"i":7,"of":11,"s":53,"surah":"النجم","a":31,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ لِيَجْزِيَ الَّذِينَ أَسَاءُوا بِمَا عَمِلُوا وَيَجْزِيَ الَّذِينَ أَحْسَنُوا بِالْحُسْنَى","prev":{"a":30,"text":"ذَلِكَ مَبْلَغُهُمْ مِنَ الْعِلْمِ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَنْ ضَلَّ عَنْ سَبِيلِهِ وَهُوَ أَعْلَمُ بِمَنِ اهْتَدَى"},"next":{"a":32,"text":"الَّذِينَ يَجْتَنِبُونَ كَبَائِرَ الْإِثْمِ وَالْفَوَاحِشَ إِلَّا اللَّمَمَ إِنَّ رَبَّكَ وَاسِعُ الْمَغْفِرَةِ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنْشَأَكُمْ مِنَ الْأَرْضِ وَإِذْ أَنْتُمْ أَجِنَّةٌ فِي بُطُونِ أُمَّهَاتِكُمْ فَلَا تُزَكُّوا أَنْفُسَكُمْ هُوَ أَعْلَمُ بِمَنِ اتَّقَى"},"context":"قبلها: إن ربك أعلم بمن ضل.","reason":"الملك للجزاء: المسيء بعمله والمحسن بالحسنى."},{"i":8,"of":11,"s":59,"surah":"الحشر","a":1,"text":"سَبَّحَ لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَهُوَ الْعَزِيزُ الْحَكِيمُ","next":{"a":2,"text":"هُوَ الَّذِي أَخْرَجَ الَّذِينَ كَفَرُوا مِنْ أَهْلِ الْكِتَابِ مِنْ دِيَارِهِمْ لِأَوَّلِ الْحَشْرِ مَا ظَنَنْتُمْ أَنْ يَخْرُجُوا وَظَنُّوا أَنَّهُمْ مَانِعَتُهُمْ حُصُونُهُمْ مِنَ اللَّهِ فَأَتَاهُمُ اللَّهُ مِنْ حَيْثُ لَمْ يَحْتَسِبُوا وَقَذَفَ فِي قُلُوبِهِمُ الرُّعْبَ يُخْرِبُونَ بُيُوتَهُمْ بِأَيْدِيهِمْ وَأَيْدِي الْمُؤْمِنِينَ فَاعْتَبِرُوا يَا أُولِي الْأَبْصَارِ"},"context":"مطلع الحشر.","reason":"تسبيح الكون في مطلع سورة إجلاء بني النضير."},{"i":9,"of":11,"s":61,"surah":"الصف","a":1,"text":"سَبَّحَ لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَهُوَ الْعَزِيزُ الْحَكِيمُ","next":{"a":2,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لِمَ تَقُولُونَ مَا لَا تَفْعَلُونَ"},"context":"مطلع الصف.","reason":"تسبيح قبل العتاب على قول ما لا يُفعل."},{"i":10,"of":11,"s":62,"surah":"الجمعة","a":1,"text":"يُسَبِّحُ لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ الْمَلِكِ الْقُدُّوسِ الْعَزِيزِ الْحَكِيمِ","next":{"a":2,"text":"هُوَ الَّذِي بَعَثَ فِي الْأُمِّيِّينَ رَسُولًا مِنْهُمْ يَتْلُو عَلَيْهِمْ آيَاتِهِ وَيُزَكِّيهِمْ وَيُعَلِّمُهُمُ الْكِتَابَ وَالْحِكْمَةَ وَإِنْ كَانُوا مِنْ قَبْلُ لَفِي ضَلَالٍ مُبِينٍ"},"context":"مطلع الجمعة.","reason":"التسبيح بأسماء الملك القدوس العزيز الحكيم."},{"i":11,"of":11,"s":64,"surah":"التغابن","a":1,"text":"يُسَبِّحُ لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","next":{"a":2,"text":"هُوَ الَّذِي خَلَقَكُمْ فَمِنْكُمْ كَافِرٌ وَمِنْكُمْ مُؤْمِنٌ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ"},"context":"مطلع التغابن.","reason":"التسبيح مع الملك والحمد والقدرة."}],"hadiths":[{"i":1,"of":1,"text":"قَعَدنا نفرًا مِن أصحابِ رسولِ اللَّهِ -صلَّى اللَّهُ عليهِ وعلَى آلِه وسلَّمَ- فتذاكَرنا فقُلنا : لَو نعلَمُ أيُّ الأعمالِ أحبُّ إلى اللَّهِ لعَمِلناهُ فأنزلَ اللَّهُ (سَبَّحَ لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأرْضِ وَهُوَ الْعَزِيزُ الْحَكِيمُ يَا أيُّهَا الَّذِينَ آمَنُوا لِمَ تَقُولُونَ مَا لَا تَفْعَلُونَ) قالَ عبدُ اللَّهِ بنُ سلامٍ فَقرأها علَينا رسولُ اللَّهِ -صلَّى اللَّهُ عليهِ وعلَى آلِه وسلَّمَ- قالَ أبو سلَمةَ فقَرأها ابنُ سلامٍ قالَ يحيَى فقَرأها علَينا أبو سلَمةَ قالَ ابنُ كثيرٍ فقَرأها علَينا الأوزاعيُّ قالَ عبدُ اللَّهِ فقَرأها علَينا ابنُ كثيرٍ","narrator":"عبدالله بن سلام","source":"الصحيح المسند 581","grade":"صحيح","url":"https://dorar.net/h/jjh4Dezz","nameForm":"لله ما في السماوات وما في الأرض"}],"sunnah":{},"situations":[{"situationId":49,"verses":[{"i":5,"strength":"direct","bridge":"إذا تفرق الزوجان فالرزق من الله، والوصية: ﴿أَنِ اتَّقُوا اللَّهَ﴾."}],"hadiths":[]},{"situationId":59,"verses":[{"i":3,"strength":"direct","bridge":"لا تحكم على مصير أحد: ﴿يَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ﴾."}],"hadiths":[]},{"situationId":85,"verses":[{"i":9,"strength":"direct","bridge":"قبل أن تقول ما لا تفعل، تذكر أن ﴿سَبَّحَ لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ﴾."}],"hadiths":[]},{"situationId":86,"verses":[{"i":1,"strength":"direct","bridge":"إذا خفت مما في نفسك: ﴿وَإِنْ تُبْدُوا مَا فِي أَنْفُسِكُمْ أَوْ تُخْفُوهُ يُحَاسِبْكُمْ بِهِ اللَّهُ﴾، ثم ﴿فَيَغْفِرُ لِمَنْ يَشَاءُ﴾."}],"hadiths":[]},{"situationId":102,"verses":[{"i":2,"strength":"direct","bridge":"كل شيء لله ﴿وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ﴾."},{"i":6,"strength":"direct","bridge":"توكل: ﴿وَكَفَى بِاللَّهِ وَكِيلًا﴾."}],"hadiths":[]},{"situationId":165,"verses":[{"i":8,"strength":"direct","bridge":"سبّح العزيز الحكيم: ﴿سَبَّحَ لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ﴾."},{"i":10,"strength":"direct","bridge":"يوم الجمعة: ﴿يُسَبِّحُ لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ الْمَلِكِ الْقُدُّوسِ﴾."},{"i":11,"strength":"direct","bridge":"سبّح الملك: ﴿يُسَبِّحُ لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ﴾."}],"hadiths":[]},{"situationId":171,"verses":[{"i":7,"strength":"direct","bridge":"اعمل وأحسن: ﴿وَيَجْزِيَ الَّذِينَ أَحْسَنُوا بِالْحُسْنَى﴾."}],"hadiths":[]},{"situationId":174,"verses":[{"i":4,"strength":"direct","bridge":"لا يخرج شيء عن إحاطته: ﴿وَكَانَ اللَّهُ بِكُلِّ شَيْءٍ مُحِيطًا﴾."}],"hadiths":[]}]},{"id":274,"name":"وله اختلاف الليل والنهار","compound":true,"meaning":"وله اختلاف الليل والنهار: تعاقبهما بتدبيره.","teaches":"1. جاءت مع الإحياء والإماتة.\n2. ثم سؤال: أفلا تعقلون؟","whenRecall":"- حين يمضي يومك بلا تأمل.","whenPray":"1. اللهم بارك لي في ليلي ونهاري.","summary":"تعاقب الليل والنهار آية؛ فتأمل.","verses":[{"i":1,"of":1,"s":23,"surah":"المؤمنون","a":80,"text":"وَهُوَ الَّذِي يُحْيِي وَيُمِيتُ وَلَهُ اخْتِلَافُ اللَّيْلِ وَالنَّهَارِ أَفَلَا تَعْقِلُونَ","prev":{"a":79,"text":"وَهُوَ الَّذِي ذَرَأَكُمْ فِي الْأَرْضِ وَإِلَيْهِ تُحْشَرُونَ"},"next":{"a":81,"text":"بَلْ قَالُوا مِثْلَ مَا قَالَ الْأَوَّلُونَ"},"context":"قبلها: هو الذي ذرأكم في الأرض وإليه تحشرون.","reason":"الإحياء والإماتة وتعاقب الليل والنهار دليل البعث."}],"hadiths":[],"situations":[{"situationId":175,"verses":[{"i":1,"strength":"direct","bridge":"تأمل يومك: ﴿وَلَهُ اخْتِلَافُ اللَّيْلِ وَالنَّهَارِ أَفَلَا تَعْقِلُونَ﴾."}],"hadiths":[]}]},{"id":275,"name":"وله الكبرياء في السماوات والأرض","compound":true,"meaning":"وله الكبرياء: العظمة والجلال له وحده.","teaches":"1. ختام الجاثية بعد الحمد لرب السماوات والأرض.","whenRecall":"- حين يدب الكبر في قلبك.","whenPray":"1. الله أكبر.","summary":"الكبرياء لله؛ فلا تنازعه إياها.","verses":[{"i":1,"of":1,"s":45,"surah":"الجاثية","a":37,"text":"وَلَهُ الْكِبْرِيَاءُ فِي السَّمَاوَاتِ وَالْأَرْضِ وَهُوَ الْعَزِيزُ الْحَكِيمُ","prev":{"a":36,"text":"فَلِلَّهِ الْحَمْدُ رَبِّ السَّمَاوَاتِ وَرَبِّ الْأَرْضِ رَبِّ الْعَالَمِينَ"},"context":"قبلها: فلله الحمد رب السماوات ورب الأرض.","reason":"الحمد والكبرياء في الختام."}],"hadiths":[],"situations":[{"situationId":83,"verses":[{"i":1,"strength":"direct","bridge":"إذا شعرت بالكبر فتذكر: ﴿وَلَهُ الْكِبْرِيَاءُ فِي السَّمَاوَاتِ وَالْأَرْضِ﴾."}],"hadiths":[]}]},{"id":276,"name":"له دعوة الحق","compound":true,"meaning":"له دعوة الحق: الدعاء الحق له وحده، فهو الذي يستجيب.","teaches":"1. مثلٌ لمن يدعو غيره: كباسط كفيه إلى الماء ليبلغ فاه.","whenRecall":"- حين تتجه إلى غير الله في حاجتك.","whenPray":"1. أن توجّه دعاءك إلى الله وحده.","summary":"دعاء غير الله كمن يبسط كفيه إلى الماء ولا يصل.","verses":[{"i":1,"of":1,"s":13,"surah":"الرعد","a":14,"text":"لَهُ دَعْوَةُ الْحَقِّ وَالَّذِينَ يَدْعُونَ مِنْ دُونِهِ لَا يَسْتَجِيبُونَ لَهُمْ بِشَيْءٍ إِلَّا كَبَاسِطِ كَفَّيْهِ إِلَى الْمَاءِ لِيَبْلُغَ فَاهُ وَمَا هُوَ بِبَالِغِهِ وَمَا دُعَاءُ الْكَافِرِينَ إِلَّا فِي ضَلَالٍ","prev":{"a":13,"text":"وَيُسَبِّحُ الرَّعْدُ بِحَمْدِهِ وَالْمَلَائِكَةُ مِنْ خِيفَتِهِ وَيُرْسِلُ الصَّوَاعِقَ فَيُصِيبُ بِهَا مَنْ يَشَاءُ وَهُمْ يُجَادِلُونَ فِي اللَّهِ وَهُوَ شَدِيدُ الْمِحَالِ"},"next":{"a":15,"text":"وَلِلَّهِ يَسْجُدُ مَنْ فِي السَّمَاوَاتِ وَالْأَرْضِ طَوْعًا وَكَرْهًا وَظِلَالُهُمْ بِالْغُدُوِّ وَالْآصَالِ"},"context":"قبلها: يسبح الرعد بحمده.","reason":"دعاء غيره لا يُستجاب."}],"hadiths":[],"situations":[{"situationId":164,"verses":[{"i":1,"strength":"direct","bridge":"إذا طلبت حاجتك من غيره فتذكر المثل: ﴿كَبَاسِطِ كَفَّيْهِ إِلَى الْمَاءِ لِيَبْلُغَ فَاهُ وَمَا هُوَ بِبَالِغِهِ﴾."}],"hadiths":[]}]},{"id":277,"name":"الأمر يومئذ لله","compound":true,"meaning":"الأمر يومئذ لله: يوم الدين لا يملك أحد لأحد شيئًا.","teaches":"1. ختام الانفطار بعد السؤال: ما أدراك ما يوم الدين.","whenRecall":"- حين تعتمد على شفاعة قريب.","whenPray":"1. اللهم ارحمني يوم لا تملك نفس لنفس شيئًا.","summary":"يوم الدين لا قريب ولا شفيع إلا بإذنه؛ الأمر لله.","verses":[{"i":1,"of":1,"s":82,"surah":"الانفطار","a":19,"text":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِنَفْسٍ شَيْئًا وَالْأَمْرُ يَوْمَئِذٍ لِلَّهِ","prev":{"a":18,"text":"ثُمَّ مَا أَدْرَاكَ مَا يَوْمُ الدِّينِ"},"context":"قبلها: ثم ما أدراك ما يوم الدين.","reason":"انقطاع الأسباب يوم القيامة."}],"hadiths":[],"situations":[{"situationId":89,"verses":[{"i":1,"strength":"direct","bridge":"لا تعتمد على أحد: ﴿يَوْمَ لَا تَمْلِكُ نَفْسٌ لِنَفْسٍ شَيْئًا وَالْأَمْرُ يَوْمَئِذٍ لِلَّهِ﴾."}],"hadiths":[]}]},{"id":278,"name":"لله الأمر من قبل ومن بعد","compound":true,"meaning":"لله الأمر من قبل ومن بعد: التدبير له قبل النصر وبعده.","teaches":"1. نزلت في غلبة الروم ثم وعد غلبتهم.\n2. يفرح المؤمنون بنصر الله.","whenRecall":"- حين تُهزم.\n- حين تنتصر.","whenPray":"1. اللهم لك الأمر، فاجعل العاقبة لنا.","summary":"الهزيمة والنصر بأمره قبل وبعد.","verses":[{"i":1,"of":1,"s":30,"surah":"الروم","a":4,"text":"فِي بِضْعِ سِنِينَ لِلَّهِ الْأَمْرُ مِنْ قَبْلُ وَمِنْ بَعْدُ وَيَوْمَئِذٍ يَفْرَحُ الْمُؤْمِنُونَ","prev":{"a":3,"text":"فِي أَدْنَى الْأَرْضِ وَهُمْ مِنْ بَعْدِ غَلَبِهِمْ سَيَغْلِبُونَ"},"next":{"a":5,"text":"بِنَصْرِ اللَّهِ يَنْصُرُ مَنْ يَشَاءُ وَهُوَ الْعَزِيزُ الرَّحِيمُ"},"context":"قبلها: غُلبت الروم في أدنى الأرض وهم من بعد غلبهم سيغلبون.","reason":"الأمر لله في الهزيمة والنصر."}],"hadiths":[{"i":1,"of":1,"text":"كان المُسلِمونَ يُحبُّونَ أنْ تظهَرَ الرُّومُ على فارسَ؛ لأنَّهم أهلُ كتابٍ، وكان المُشرِكونَ يُحبُّونَ أنْ تظهَرَ فارسُ على الرُّومِ؛ لأنَّهم أهلُ أوثانٍ، فذكَرَ ذلكَ المُسلِمونَ لأبي بَكرٍ رضِيَ اللهُ عنه، فذكَرَ ذلكَ أبو بَكرٍ للنَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّهم سيُهزَمونَ، فذكَرَ ذلكَ أبو بَكرٍ لهم، فقالوا: اجعَلْ بيْنَنا وبيْنَكَ أجَلًا، فإنْ ظهَروا كان لكَ كَذا وكَذا، وإنْ ظهَرْنا، كان لكَ كَذا وكَذا، فجعَلَ بيْنَهم أجَلًا خَمْسَ سِنينَ، فلمْ يَظهَروا، فذكَرَ ذلكَ أبو بَكرٍ للنَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقال: ألَا جعَلْتَهُ دونَ البِضعِ، قال: دونَ العَشَرةِ؟ قال: وقال سَعيدُ بنُ جُبَيرٍ: والبِضعُ ما دونَ العَشْرِ، قال: فظهَرتِ الرُّومُ بعدَ ذلكَ، قال: فذلكَ قولُهُ عزَّ وجلَّ: {الم * غُلِبَتِ الرُّومُ * فِي أَدْنَى الْأَرْضِ وَهُمْ مِنْ بَعْدِ غَلَبِهِمْ سَيَغْلِبُونَ * فِي بِضْعِ سِنِينَ} [الروم: الآيات من 1-3]. قال: فغُلِبتِ الرُّومُ، ثمَّ غلَبتْ بَعدُ، فقال اللهُ عزَّ وجلَّ: {لِلَّهِ الْأَمْرُ مِنْ قَبْلُ وَمِنْ بَعْدُ وَيَوْمَئِذٍ يَفْرَحُ الْمُؤْمِنُونَ * بِنَصْرِ اللَّهِ} [الروم: الآيتان: 4-5].","narrator":"عبدالله بن عباس","source":"تخريج مشكل الآثار 2988","grade":"صحيح","url":"https://dorar.net/h/x7E65PEw","nameForm":"لله الأمر من قبل ومن بعد"}],"sunnah":{},"situations":[{"situationId":38,"verses":[{"i":1,"strength":"direct","bridge":"إذا هُزمت فلا تيأس: ﴿لِلَّهِ الْأَمْرُ مِنْ قَبْلُ وَمِنْ بَعْدُ﴾."}],"hadiths":[]}]},{"id":279,"name":"لله الأمر جميعاً","compound":true,"meaning":"لله الأمر جميعًا: كل أمر بيده، والهداية بمشيئته.","teaches":"1. جاءت ردًّا على طلب الآيات الخارقة.\n2. لو شاء لهدى الناس جميعًا.","whenRecall":"- حين تتمنى آية تهدي من تحب.","whenPray":"1. اللهم اهدِ من أحب، فالأمر لك.","summary":"الهداية بمشيئته، لا بالخوارق.","verses":[{"i":1,"of":1,"s":13,"surah":"الرعد","a":31,"text":"وَلَوْ أَنَّ قُرْآنًا سُيِّرَتْ بِهِ الْجِبَالُ أَوْ قُطِّعَتْ بِهِ الْأَرْضُ أَوْ كُلِّمَ بِهِ الْمَوْتَى بَلْ لِلَّهِ الْأَمْرُ جَمِيعًا أَفَلَمْ يَيْأَسِ الَّذِينَ آمَنُوا أَنْ لَوْ يَشَاءُ اللَّهُ لَهَدَى النَّاسَ جَمِيعًا وَلَا يَزَالُ الَّذِينَ كَفَرُوا تُصِيبُهُمْ بِمَا صَنَعُوا قَارِعَةٌ أَوْ تَحُلُّ قَرِيبًا مِنْ دَارِهِمْ حَتَّى يَأْتِيَ وَعْدُ اللَّهِ إِنَّ اللَّهَ لَا يُخْلِفُ الْمِيعَادَ","prev":{"a":30,"text":"كَذَلِكَ أَرْسَلْنَاكَ فِي أُمَّةٍ قَدْ خَلَتْ مِنْ قَبْلِهَا أُمَمٌ لِتَتْلُوَ عَلَيْهِمُ الَّذِي أَوْحَيْنَا إِلَيْكَ وَهُمْ يَكْفُرُونَ بِالرَّحْمَنِ قُلْ هُوَ رَبِّي لَا إِلَهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ مَتَابِ"},"next":{"a":32,"text":"وَلَقَدِ اسْتُهْزِئَ بِرُسُلٍ مِنْ قَبْلِكَ فَأَمْلَيْتُ لِلَّذِينَ كَفَرُوا ثُمَّ أَخَذْتُهُمْ فَكَيْفَ كَانَ عِقَابِ"},"context":"قبلها: كذلك أرسلناك في أمة قد خلت.","reason":"لو سُيّرت الجبال ما آمنوا؛ الأمر لله."}],"hadiths":[],"situations":[{"situationId":131,"verses":[{"i":1,"strength":"direct","bridge":"إذا تمنيت معجزة لتهدي أحدًا: ﴿بَلْ لِلَّهِ الْأَمْرُ جَمِيعًا﴾."}],"hadiths":[]}]},{"id":280,"name":"وله المثل الأعلى في السماوات والأرض","compound":true,"meaning":"وله المثل الأعلى: الوصف الأعلى في كل شيء، والإعادة أهون عليه.","teaches":"1. جاءت في إثبات البعث: يبدأ الخلق ثم يعيده.","whenRecall":"- حين تستبعد البعث.","whenPray":"1. سبحان من له المثل الأعلى.","summary":"الإعادة أهون من البدء، وله المثل الأعلى.","verses":[{"i":1,"of":1,"s":30,"surah":"الروم","a":27,"text":"وَهُوَ الَّذِي يَبْدَأُ الْخَلْقَ ثُمَّ يُعِيدُهُ وَهُوَ أَهْوَنُ عَلَيْهِ وَلَهُ الْمَثَلُ الْأَعْلَى فِي السَّمَاوَاتِ وَالْأَرْضِ وَهُوَ الْعَزِيزُ الْحَكِيمُ","prev":{"a":26,"text":"وَلَهُ مَنْ فِي السَّمَاوَاتِ وَالْأَرْضِ كُلٌّ لَهُ قَانِتُونَ"},"next":{"a":28,"text":"ضَرَبَ لَكُمْ مَثَلًا مِنْ أَنْفُسِكُمْ هَلْ لَكُمْ مِنْ مَا مَلَكَتْ أَيْمَانُكُمْ مِنْ شُرَكَاءَ فِي مَا رَزَقْنَاكُمْ فَأَنْتُمْ فِيهِ سَوَاءٌ تَخَافُونَهُمْ كَخِيفَتِكُمْ أَنْفُسَكُمْ كَذَلِكَ نُفَصِّلُ الْآيَاتِ لِقَوْمٍ يَعْقِلُونَ"},"context":"قبلها: وله من في السماوات والأرض كل له قانتون.","reason":"البدء والإعادة دليل البعث."}],"hadiths":[],"situations":[{"situationId":109,"verses":[{"i":1,"strength":"direct","bridge":"إن استبعدت البعث: ﴿وَهُوَ الَّذِي يَبْدَأُ الْخَلْقَ ثُمَّ يُعِيدُهُ وَهُوَ أَهْوَنُ عَلَيْهِ﴾."}],"hadiths":[]}]},{"id":281,"name":"له الأسماء الحسنى","compound":true,"meaning":"له الأسماء الحسنى: أسماؤه كلها بالغة الحسن.","teaches":"1. في طه بعد علمه بالسر وأخفى.\n2. وفي الحشر بعد سلسلة الأسماء.","whenRecall":"- عند الدعاء.","whenPray":"1. أن تدعوه بالاسم المناسب لحاجتك.","summary":"أسماؤه حسنى؛ فادعه بها.","verses":[{"i":1,"of":2,"s":20,"surah":"طه","a":8,"text":"اللَّهُ لَا إِلَهَ إِلَّا هُوَ لَهُ الْأَسْمَاءُ الْحُسْنَى","prev":{"a":7,"text":"وَإِنْ تَجْهَرْ بِالْقَوْلِ فَإِنَّهُ يَعْلَمُ السِّرَّ وَأَخْفَى"},"next":{"a":9,"text":"وَهَلْ أَتَاكَ حَدِيثُ مُوسَى"},"context":"قبلها: يعلم السر وأخفى.","reason":"من يعلم السر له الأسماء الحسنى."},{"i":2,"of":2,"s":59,"surah":"الحشر","a":24,"text":"هُوَ اللَّهُ الْخَالِقُ الْبَارِئُ الْمُصَوِّرُ لَهُ الْأَسْمَاءُ الْحُسْنَى يُسَبِّحُ لَهُ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ وَهُوَ الْعَزِيزُ الْحَكِيمُ","prev":{"a":23,"text":"هُوَ اللَّهُ الَّذِي لَا إِلَهَ إِلَّا هُوَ الْمَلِكُ الْقُدُّوسُ السَّلَامُ الْمُؤْمِنُ الْمُهَيْمِنُ الْعَزِيزُ الْجَبَّارُ الْمُتَكَبِّرُ سُبْحَانَ اللَّهِ عَمَّا يُشْرِكُونَ"},"context":"ختام الحشر.","reason":"جمع الخالق البارئ المصور مع الأسماء الحسنى."}],"hadiths":[],"situations":[{"situationId":163,"verses":[{"i":1,"strength":"direct","bridge":"ادعه بما يناسب حاجتك: ﴿اللَّهُ لَا إِلَهَ إِلَّا هُوَ لَهُ الْأَسْمَاءُ الْحُسْنَى﴾."},{"i":2,"strength":"direct","bridge":"ادعه بأسمائه: ﴿هُوَ اللَّهُ الْخَالِقُ الْبَارِئُ الْمُصَوِّرُ لَهُ الْأَسْمَاءُ الْحُسْنَى﴾."}],"hadiths":[]}]},{"id":282,"name":"له الخلق والأمر","compound":true,"meaning":"له الخلق والأمر: الإيجاد والتدبير والتشريع له.","teaches":"1. جاءت بعد خلق السماوات والأرض والاستواء وتسخير الشمس والقمر.\n2. ثم: تبارك الله رب العالمين.","whenRecall":"- حين يُشرَّع لك ما تكره.","whenPray":"1. تبارك الله رب العالمين.","summary":"من خلق هو الذي يأمر.","verses":[{"i":1,"of":1,"s":7,"surah":"الأعراف","a":54,"text":"إِنَّ رَبَّكُمُ اللَّهُ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ فِي سِتَّةِ أَيَّامٍ ثُمَّ اسْتَوَى عَلَى الْعَرْشِ يُغْشِي اللَّيْلَ النَّهَارَ يَطْلُبُهُ حَثِيثًا وَالشَّمْسَ وَالْقَمَرَ وَالنُّجُومَ مُسَخَّرَاتٍ بِأَمْرِهِ أَلَا لَهُ الْخَلْقُ وَالْأَمْرُ تَبَارَكَ اللَّهُ رَبُّ الْعَالَمِينَ","prev":{"a":53,"text":"هَلْ يَنْظُرُونَ إِلَّا تَأْوِيلَهُ يَوْمَ يَأْتِي تَأْوِيلُهُ يَقُولُ الَّذِينَ نَسُوهُ مِنْ قَبْلُ قَدْ جَاءَتْ رُسُلُ رَبِّنَا بِالْحَقِّ فَهَلْ لَنَا مِنْ شُفَعَاءَ فَيَشْفَعُوا لَنَا أَوْ نُرَدُّ فَنَعْمَلَ غَيْرَ الَّذِي كُنَّا نَعْمَلُ قَدْ خَسِرُوا أَنْفُسَهُمْ وَضَلَّ عَنْهُمْ مَا كَانُوا يَفْتَرُونَ"},"next":{"a":55,"text":"ادْعُوا رَبَّكُمْ تَضَرُّعًا وَخُفْيَةً إِنَّهُ لَا يُحِبُّ الْمُعْتَدِينَ"},"context":"قبلها: يوم يأتي تأويله.","reason":"الخالق هو الآمر."}],"hadiths":[],"situations":[{"situationId":119,"verses":[{"i":1,"strength":"direct","bridge":"إذا ثقل عليك حكم شرعي: ﴿أَلَا لَهُ الْخَلْقُ وَالْأَمْرُ تَبَارَكَ اللَّهُ رَبُّ الْعَالَمِينَ﴾."}],"hadiths":[]}]},{"id":283,"name":"الحمد لله رب العالمين","compound":true,"meaning":"الحمد لله رب العالمين: كل الحمد لربّ الخلق جميعًا.","teaches":"1. فاتحة الكتاب، وخاتمة الدعاء في الجنة.\n2. تُقال بعد هلاك الظالمين، وبعد القضاء بالحق.","whenRecall":"- في كل صلاة.\n- عند الفرج.\n- عند ختام الدعاء.","whenPray":"1. اختم دعاءك بها كما يختم أهل الجنة.","summary":"ابدأ بها صلاتك واختم بها دعاءك.","verses":[{"i":1,"of":6,"s":1,"surah":"الفاتحة","a":2,"text":"الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ","prev":{"a":1,"text":"بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"},"next":{"a":3,"text":"الرَّحْمَنِ الرَّحِيمِ"},"context":"مطلع الفاتحة.","reason":"أول الكتاب حمد لرب العالمين."},{"i":2,"of":6,"s":6,"surah":"الأنعام","a":45,"text":"فَقُطِعَ دَابِرُ الْقَوْمِ الَّذِينَ ظَلَمُوا وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ","prev":{"a":44,"text":"فَلَمَّا نَسُوا مَا ذُكِّرُوا بِهِ فَتَحْنَا عَلَيْهِمْ أَبْوَابَ كُلِّ شَيْءٍ حَتَّى إِذَا فَرِحُوا بِمَا أُوتُوا أَخَذْنَاهُمْ بَغْتَةً فَإِذَا هُمْ مُبْلِسُونَ"},"next":{"a":46,"text":"قُلْ أَرَأَيْتُمْ إِنْ أَخَذَ اللَّهُ سَمْعَكُمْ وَأَبْصَارَكُمْ وَخَتَمَ عَلَى قُلُوبِكُمْ مَنْ إِلَهٌ غَيْرُ اللَّهِ يَأْتِيكُمْ بِهِ انْظُرْ كَيْفَ نُصَرِّفُ الْآيَاتِ ثُمَّ هُمْ يَصْدِفُونَ"},"context":"قبلها: فتحنا عليهم أبواب كل شيء ثم أخذناهم بغتة.","reason":"الحمد على قطع دابر الظالمين."},{"i":3,"of":6,"s":10,"surah":"يونس","a":10,"text":"دَعْوَاهُمْ فِيهَا سُبْحَانَكَ اللَّهُمَّ وَتَحِيَّتُهُمْ فِيهَا سَلَامٌ وَآخِرُ دَعْوَاهُمْ أَنِ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ","prev":{"a":9,"text":"إِنَّ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ يَهْدِيهِمْ رَبُّهُمْ بِإِيمَانِهِمْ تَجْرِي مِنْ تَحْتِهِمُ الْأَنْهَارُ فِي جَنَّاتِ النَّعِيمِ"},"next":{"a":11,"text":"وَلَوْ يُعَجِّلُ اللَّهُ لِلنَّاسِ الشَّرَّ اسْتِعْجَالَهُمْ بِالْخَيْرِ لَقُضِيَ إِلَيْهِمْ أَجَلُهُمْ فَنَذَرُ الَّذِينَ لَا يَرْجُونَ لِقَاءَنَا فِي طُغْيَانِهِمْ يَعْمَهُونَ"},"context":"قبلها: يهديهم ربهم بإيمانهم.","reason":"آخر دعاء أهل الجنة الحمد."},{"i":4,"of":6,"s":37,"surah":"الصافات","a":182,"text":"وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ","prev":{"a":181,"text":"وَسَلَامٌ عَلَى الْمُرْسَلِينَ"},"context":"ختام الصافات: سلام على المرسلين.","reason":"خُتمت السورة بالحمد."},{"i":5,"of":6,"s":39,"surah":"الزمر","a":75,"text":"وَتَرَى الْمَلَائِكَةَ حَافِّينَ مِنْ حَوْلِ الْعَرْشِ يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ وَقُضِيَ بَيْنَهُمْ بِالْحَقِّ وَقِيلَ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ","prev":{"a":74,"text":"وَقَالُوا الْحَمْدُ لِلَّهِ الَّذِي صَدَقَنَا وَعْدَهُ وَأَوْرَثَنَا الْأَرْضَ نَتَبَوَّأُ مِنَ الْجَنَّةِ حَيْثُ نَشَاءُ فَنِعْمَ أَجْرُ الْعَامِلِينَ"},"context":"قبلها: الحمد لله الذي صدقنا وعده.","reason":"بعد القضاء بالحق يُحمد الله."},{"i":6,"of":6,"s":40,"surah":"غافر","a":65,"text":"هُوَ الْحَيُّ لَا إِلَهَ إِلَّا هُوَ فَادْعُوهُ مُخْلِصِينَ لَهُ الدِّينَ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ","prev":{"a":64,"text":"اللَّهُ الَّذِي جَعَلَ لَكُمُ الْأَرْضَ قَرَارًا وَالسَّمَاءَ بِنَاءً وَصَوَّرَكُمْ فَأَحْسَنَ صُوَرَكُمْ وَرَزَقَكُمْ مِنَ الطَّيِّبَاتِ ذَلِكُمُ اللَّهُ رَبُّكُمْ فَتَبَارَكَ اللَّهُ رَبُّ الْعَالَمِينَ"},"next":{"a":66,"text":"قُلْ إِنِّي نُهِيتُ أَنْ أَعْبُدَ الَّذِينَ تَدْعُونَ مِنْ دُونِ اللَّهِ لَمَّا جَاءَنِيَ الْبَيِّنَاتُ مِنْ رَبِّي وَأُمِرْتُ أَنْ أُسْلِمَ لِرَبِّ الْعَالَمِينَ"},"context":"قبلها: جعل الأرض قرارًا والسماء بناء.","reason":"الدعاء بإخلاص ثم الحمد."}],"hadiths":[{"i":1,"of":2,"text":"أَلَا أُخْبِرُكَ بِأخْيَرِ سورةٍ في القرآنِ  الْحَمْدُ للَّهِ رَبِّ الْعَالَمِينَ","narrator":"عبدالله بن جعفر البياضي","source":"صحيح الجامع 2592","grade":"صحيح","url":"https://dorar.net/h/uvKA27za","nameForm":"الحمد لله رب العالمين"},{"i":2,"of":2,"text":"إذا عَطَسَ أحدُكم فلْيقلْ : الحمدُ للهِ ربِّ العالمينَ ، و لْيقلْ له : يرحمُك اللهُ ، و لْيقلْ هو : يغفرُ اللهُ لنا و لكم","narrator":"عبدالله بن مسعود وسالم بن عبيد الأشجعي","source":"صحيح الجامع 686","grade":"صحيح","url":"https://dorar.net/h/BujLTSku","nameForm":"الحمد لله رب العالمين"}],"sunnah":{},"situations":[{"situationId":36,"verses":[{"i":2,"strength":"direct","bridge":"إذا رفع الله ظلمًا: ﴿فَقُطِعَ دَابِرُ الْقَوْمِ الَّذِينَ ظَلَمُوا وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ﴾."}],"hadiths":[]},{"situationId":108,"verses":[{"i":5,"strength":"direct","bridge":"حين يُقضى بالحق: ﴿وَقُضِيَ بَيْنَهُمْ بِالْحَقِّ وَقِيلَ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ﴾."}],"hadiths":[]},{"situationId":144,"verses":[{"i":1,"strength":"direct","bridge":"في كل صلاة: ﴿الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ﴾."},{"i":4,"strength":"direct","bridge":"اختم مجلسك وعملك: ﴿وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ﴾."}],"hadiths":[]},{"situationId":164,"verses":[{"i":3,"strength":"direct","bridge":"اختم دعاءك كأهل الجنة: ﴿وَآخِرُ دَعْوَاهُمْ أَنِ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ﴾."}],"hadiths":[]},{"situationId":169,"verses":[{"i":6,"strength":"direct","bridge":"ادعه مخلصًا: ﴿فَادْعُوهُ مُخْلِصِينَ لَهُ الدِّينَ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ﴾."}],"hadiths":[]}]},{"id":284,"name":"الحق لله","compound":true,"meaning":"الحق لله: يوم القيامة يعلم المشركون أن الحق لله، ويضل عنهم ما افتروا.","teaches":"1. يُنزع من كل أمة شهيد، ويُطالبون بالبرهان.","whenRecall":"- حين تجادل بغير حجة.","whenPray":"1. اللهم أرني الحق حقًّا.","summary":"عند البرهان يظهر الحق لله، ويضل الافتراء.","verses":[{"i":1,"of":1,"s":28,"surah":"القصص","a":75,"text":"وَنَزَعْنَا مِنْ كُلِّ أُمَّةٍ شَهِيدًا فَقُلْنَا هَاتُوا بُرْهَانَكُمْ فَعَلِمُوا أَنَّ الْحَقَّ لِلَّهِ وَضَلَّ عَنْهُمْ مَا كَانُوا يَفْتَرُونَ","prev":{"a":74,"text":"وَيَوْمَ يُنَادِيهِمْ فَيَقُولُ أَيْنَ شُرَكَائِيَ الَّذِينَ كُنْتُمْ تَزْعُمُونَ"},"next":{"a":76,"text":"إِنَّ قَارُونَ كَانَ مِنْ قَوْمِ مُوسَى فَبَغَى عَلَيْهِمْ وَآتَيْنَاهُ مِنَ الْكُنُوزِ مَا إِنَّ مَفَاتِحَهُ لَتَنُوءُ بِالْعُصْبَةِ أُولِي الْقُوَّةِ إِذْ قَالَ لَهُ قَوْمُهُ لَا تَفْرَحْ إِنَّ اللَّهَ لَا يُحِبُّ الْفَرِحِينَ"},"context":"قبلها: يناديهم: أين شركائي؟","reason":"سقطت حجتهم وظهر الحق."}],"hadiths":[],"situations":[{"situationId":122,"verses":[{"i":1,"strength":"direct","bridge":"لا تتمسك بقول بلا برهان: ﴿فَعَلِمُوا أَنَّ الْحَقَّ لِلَّهِ وَضَلَّ عَنْهُمْ مَا كَانُوا يَفْتَرُونَ﴾."}],"hadiths":[]}]},{"id":285,"name":"الحمد لله","compound":true,"meaning":"الحمد لله: الثناء الكامل لله على صفاته ونعمه.","teaches":"1. أكثر مواضعها حمدٌ على نعمة محددة: الهداية، والولد، والنجاة، والفضل، وذهاب الحزن.\n2. تأتي أيضًا بعد ضرب المثل: الحمد لله بل أكثرهم لا يعلمون.\n3. أهل الجنة يحمدون على صدق الوعد.","whenRecall":"- عند كل نعمة تتجدد.\n- عند النجاة من ظالم.\n- عند ذهاب الحزن.","whenPray":"1. الحمد لله الذي هدانا لهذا.\n2. الحمد لله الذي أذهب عنا الحزن.","summary":"لكل نعمة حمدها: على الهداية، والولد، والنجاة، وذهاب الحزن.","verses":[{"i":1,"of":24,"s":1,"surah":"الفاتحة","a":2,"text":"الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ","prev":{"a":1,"text":"بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"},"next":{"a":3,"text":"الرَّحْمَنِ الرَّحِيمِ"},"context":"مطلع الفاتحة.","reason":"أول الحمد في الكتاب."},{"i":2,"of":24,"s":6,"surah":"الأنعام","a":1,"text":"الْحَمْدُ لِلَّهِ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ وَجَعَلَ الظُّلُمَاتِ وَالنُّورَ ثُمَّ الَّذِينَ كَفَرُوا بِرَبِّهِمْ يَعْدِلُونَ","next":{"a":2,"text":"هُوَ الَّذِي خَلَقَكُمْ مِنْ طِينٍ ثُمَّ قَضَى أَجَلًا وَأَجَلٌ مُسَمًّى عِنْدَهُ ثُمَّ أَنْتُمْ تَمْتَرُونَ"},"context":"مطلع الأنعام.","reason":"الحمد على خلق السماوات والأرض والظلمات والنور."},{"i":3,"of":24,"s":6,"surah":"الأنعام","a":45,"text":"فَقُطِعَ دَابِرُ الْقَوْمِ الَّذِينَ ظَلَمُوا وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ","prev":{"a":44,"text":"فَلَمَّا نَسُوا مَا ذُكِّرُوا بِهِ فَتَحْنَا عَلَيْهِمْ أَبْوَابَ كُلِّ شَيْءٍ حَتَّى إِذَا فَرِحُوا بِمَا أُوتُوا أَخَذْنَاهُمْ بَغْتَةً فَإِذَا هُمْ مُبْلِسُونَ"},"next":{"a":46,"text":"قُلْ أَرَأَيْتُمْ إِنْ أَخَذَ اللَّهُ سَمْعَكُمْ وَأَبْصَارَكُمْ وَخَتَمَ عَلَى قُلُوبِكُمْ مَنْ إِلَهٌ غَيْرُ اللَّهِ يَأْتِيكُمْ بِهِ انْظُرْ كَيْفَ نُصَرِّفُ الْآيَاتِ ثُمَّ هُمْ يَصْدِفُونَ"},"context":"هلاك الظالمين بعد فتح أبواب كل شيء عليهم.","reason":"الحمد على زوال الظلم."},{"i":4,"of":24,"s":7,"surah":"الأعراف","a":43,"text":"وَنَزَعْنَا مَا فِي صُدُورِهِمْ مِنْ غِلٍّ تَجْرِي مِنْ تَحْتِهِمُ الْأَنْهَارُ وَقَالُوا الْحَمْدُ لِلَّهِ الَّذِي هَدَانَا لِهَذَا وَمَا كُنَّا لِنَهْتَدِيَ لَوْلَا أَنْ هَدَانَا اللَّهُ لَقَدْ جَاءَتْ رُسُلُ رَبِّنَا بِالْحَقِّ وَنُودُوا أَنْ تِلْكُمُ الْجَنَّةُ أُورِثْتُمُوهَا بِمَا كُنْتُمْ تَعْمَلُونَ","prev":{"a":42,"text":"وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَا نُكَلِّفُ نَفْسًا إِلَّا وُسْعَهَا أُولَئِكَ أَصْحَابُ الْجَنَّةِ هُمْ فِيهَا خَالِدُونَ"},"next":{"a":44,"text":"وَنَادَى أَصْحَابُ الْجَنَّةِ أَصْحَابَ النَّارِ أَنْ قَدْ وَجَدْنَا مَا وَعَدَنَا رَبُّنَا حَقًّا فَهَلْ وَجَدْتُمْ مَا وَعَدَ رَبُّكُمْ حَقًّا قَالُوا نَعَمْ فَأَذَّنَ مُؤَذِّنٌ بَيْنَهُمْ أَنْ لَعْنَةُ اللَّهِ عَلَى الظَّالِمِينَ"},"context":"أهل الجنة بعد نزع الغل من صدورهم.","reason":"حمدٌ على الهداية، مع الاعتراف بأنها فضل."},{"i":5,"of":24,"s":10,"surah":"يونس","a":10,"text":"دَعْوَاهُمْ فِيهَا سُبْحَانَكَ اللَّهُمَّ وَتَحِيَّتُهُمْ فِيهَا سَلَامٌ وَآخِرُ دَعْوَاهُمْ أَنِ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ","prev":{"a":9,"text":"إِنَّ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ يَهْدِيهِمْ رَبُّهُمْ بِإِيمَانِهِمْ تَجْرِي مِنْ تَحْتِهِمُ الْأَنْهَارُ فِي جَنَّاتِ النَّعِيمِ"},"next":{"a":11,"text":"وَلَوْ يُعَجِّلُ اللَّهُ لِلنَّاسِ الشَّرَّ اسْتِعْجَالَهُمْ بِالْخَيْرِ لَقُضِيَ إِلَيْهِمْ أَجَلُهُمْ فَنَذَرُ الَّذِينَ لَا يَرْجُونَ لِقَاءَنَا فِي طُغْيَانِهِمْ يَعْمَهُونَ"},"context":"أهل الجنة.","reason":"الحمد آخر دعائهم."},{"i":6,"of":24,"s":14,"surah":"إبراهيم","a":39,"text":"الْحَمْدُ لِلَّهِ الَّذِي وَهَبَ لِي عَلَى الْكِبَرِ إِسْمَاعِيلَ وَإِسْحَاقَ إِنَّ رَبِّي لَسَمِيعُ الدُّعَاءِ","prev":{"a":38,"text":"رَبَّنَا إِنَّكَ تَعْلَمُ مَا نُخْفِي وَمَا نُعْلِنُ وَمَا يَخْفَى عَلَى اللَّهِ مِنْ شَيْءٍ فِي الْأَرْضِ وَلَا فِي السَّمَاءِ"},"next":{"a":40,"text":"رَبِّ اجْعَلْنِي مُقِيمَ الصَّلَاةِ وَمِنْ ذُرِّيَّتِي رَبَّنَا وَتَقَبَّلْ دُعَاءِ"},"context":"دعاء إبراهيم بمكة.","reason":"حمدٌ على الولد في الكبر."},{"i":7,"of":24,"s":16,"surah":"النحل","a":75,"text":"ضَرَبَ اللَّهُ مَثَلًا عَبْدًا مَمْلُوكًا لَا يَقْدِرُ عَلَى شَيْءٍ وَمَنْ رَزَقْنَاهُ مِنَّا رِزْقًا حَسَنًا فَهُوَ يُنْفِقُ مِنْهُ سِرًّا وَجَهْرًا هَلْ يَسْتَوُونَ الْحَمْدُ لِلَّهِ بَلْ أَكْثَرُهُمْ لَا يَعْلَمُونَ","prev":{"a":74,"text":"فَلَا تَضْرِبُوا لِلَّهِ الْأَمْثَالَ إِنَّ اللَّهَ يَعْلَمُ وَأَنْتُمْ لَا تَعْلَمُونَ"},"next":{"a":76,"text":"وَضَرَبَ اللَّهُ مَثَلًا رَجُلَيْنِ أَحَدُهُمَا أَبْكَمُ لَا يَقْدِرُ عَلَى شَيْءٍ وَهُوَ كَلٌّ عَلَى مَوْلَاهُ أَيْنَمَا يُوَجِّهْهُ لَا يَأْتِ بِخَيْرٍ هَلْ يَسْتَوِي هُوَ وَمَنْ يَأْمُرُ بِالْعَدْلِ وَهُوَ عَلَى صِرَاطٍ مُسْتَقِيمٍ"},"context":"قبلها: فلا تضربوا لله الأمثال.","reason":"مثل العبد العاجز والمنفق."},{"i":8,"of":24,"s":17,"surah":"الإسراء","a":111,"text":"وَقُلِ الْحَمْدُ لِلَّهِ الَّذِي لَمْ يَتَّخِذْ وَلَدًا وَلَمْ يَكُنْ لَهُ شَرِيكٌ فِي الْمُلْكِ وَلَمْ يَكُنْ لَهُ وَلِيٌّ مِنَ الذُّلِّ وَكَبِّرْهُ تَكْبِيرًا","prev":{"a":110,"text":"قُلِ ادْعُوا اللَّهَ أَوِ ادْعُوا الرَّحْمَنَ أَيًّا مَا تَدْعُوا فَلَهُ الْأَسْمَاءُ الْحُسْنَى وَلَا تَجْهَرْ بِصَلَاتِكَ وَلَا تُخَافِتْ بِهَا وَابْتَغِ بَيْنَ ذَلِكَ سَبِيلًا"},"context":"ختام الإسراء بعد: ادعوا الله أو ادعوا الرحمن.","reason":"الحمد والتكبير ونفي الولد والشريك والولي من الذل."},{"i":9,"of":24,"s":18,"surah":"الكهف","a":1,"text":"الْحَمْدُ لِلَّهِ الَّذِي أَنْزَلَ عَلَى عَبْدِهِ الْكِتَابَ وَلَمْ يَجْعَلْ لَهُ عِوَجًا","next":{"a":2,"text":"قَيِّمًا لِيُنْذِرَ بَأْسًا شَدِيدًا مِنْ لَدُنْهُ وَيُبَشِّرَ الْمُؤْمِنِينَ الَّذِينَ يَعْمَلُونَ الصَّالِحَاتِ أَنَّ لَهُمْ أَجْرًا حَسَنًا"},"context":"مطلع الكهف.","reason":"الحمد على إنزال الكتاب بلا عوج."},{"i":10,"of":24,"s":23,"surah":"المؤمنون","a":28,"text":"فَإِذَا اسْتَوَيْتَ أَنْتَ وَمَنْ مَعَكَ عَلَى الْفُلْكِ فَقُلِ الْحَمْدُ لِلَّهِ الَّذِي نَجَّانَا مِنَ الْقَوْمِ الظَّالِمِينَ","prev":{"a":27,"text":"فَأَوْحَيْنَا إِلَيْهِ أَنِ اصْنَعِ الْفُلْكَ بِأَعْيُنِنَا وَوَحْيِنَا فَإِذَا جَاءَ أَمْرُنَا وَفَارَ التَّنُّورُ فَاسْلُكْ فِيهَا مِنْ كُلٍّ زَوْجَيْنِ اثْنَيْنِ وَأَهْلَكَ إِلَّا مَنْ سَبَقَ عَلَيْهِ الْقَوْلُ مِنْهُمْ وَلَا تُخَاطِبْنِي فِي الَّذِينَ ظَلَمُوا إِنَّهُمْ مُغْرَقُونَ"},"next":{"a":29,"text":"وَقُلْ رَبِّ أَنْزِلْنِي مُنْزَلًا مُبَارَكًا وَأَنْتَ خَيْرُ الْمُنْزِلِينَ"},"context":"أمر نوح أن يحمد إذا استوى على الفلك.","reason":"الحمد على النجاة من الظالمين."},{"i":11,"of":24,"s":27,"surah":"النمل","a":15,"text":"وَلَقَدْ آتَيْنَا دَاوُودَ وَسُلَيْمَانَ عِلْمًا وَقَالَا الْحَمْدُ لِلَّهِ الَّذِي فَضَّلَنَا عَلَى كَثِيرٍ مِنْ عِبَادِهِ الْمُؤْمِنِينَ","prev":{"a":14,"text":"وَجَحَدُوا بِهَا وَاسْتَيْقَنَتْهَا أَنْفُسُهُمْ ظُلْمًا وَعُلُوًّا فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُفْسِدِينَ"},"next":{"a":16,"text":"وَوَرِثَ سُلَيْمَانُ دَاوُودَ وَقَالَ يَا أَيُّهَا النَّاسُ عُلِّمْنَا مَنْطِقَ الطَّيْرِ وَأُوتِينَا مِنْ كُلِّ شَيْءٍ إِنَّ هَذَا لَهُوَ الْفَضْلُ الْمُبِينُ"},"context":"داود وسليمان أوتيا علمًا.","reason":"الحمد على نعمة العلم والتفضيل."},{"i":12,"of":24,"s":27,"surah":"النمل","a":59,"text":"قُلِ الْحَمْدُ لِلَّهِ وَسَلَامٌ عَلَى عِبَادِهِ الَّذِينَ اصْطَفَى آللَّهُ خَيْرٌ أَمَّا يُشْرِكُونَ","prev":{"a":58,"text":"وَأَمْطَرْنَا عَلَيْهِمْ مَطَرًا فَسَاءَ مَطَرُ الْمُنْذَرِينَ"},"next":{"a":60,"text":"أَمَّنْ خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ وَأَنْزَلَ لَكُمْ مِنَ السَّمَاءِ مَاءً فَأَنْبَتْنَا بِهِ حَدَائِقَ ذَاتَ بَهْجَةٍ مَا كَانَ لَكُمْ أَنْ تُنْبِتُوا شَجَرَهَا أَإِلَهٌ مَعَ اللَّهِ بَلْ هُمْ قَوْمٌ يَعْدِلُونَ"},"context":"بعد إهلاك قوم لوط.","reason":"الحمد والسلام على المصطفين."},{"i":13,"of":24,"s":27,"surah":"النمل","a":93,"text":"وَقُلِ الْحَمْدُ لِلَّهِ سَيُرِيكُمْ آيَاتِهِ فَتَعْرِفُونَهَا وَمَا رَبُّكَ بِغَافِلٍ عَمَّا تَعْمَلُونَ","prev":{"a":92,"text":"وَأَنْ أَتْلُوَ الْقُرْآنَ فَمَنِ اهْتَدَى فَإِنَّمَا يَهْتَدِي لِنَفْسِهِ وَمَنْ ضَلَّ فَقُلْ إِنَّمَا أَنَا مِنَ الْمُنْذِرِينَ"},"context":"ختام النمل.","reason":"الحمد مع وعد إراءة الآيات."},{"i":14,"of":24,"s":29,"surah":"العنكبوت","a":63,"text":"وَلَئِنْ سَأَلْتَهُمْ مَنْ نَزَّلَ مِنَ السَّمَاءِ مَاءً فَأَحْيَا بِهِ الْأَرْضَ مِنْ بَعْدِ مَوْتِهَا لَيَقُولُنَّ اللَّهُ قُلِ الْحَمْدُ لِلَّهِ بَلْ أَكْثَرُهُمْ لَا يَعْقِلُونَ","prev":{"a":62,"text":"اللَّهُ يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ مِنْ عِبَادِهِ وَيَقْدِرُ لَهُ إِنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ"},"next":{"a":64,"text":"وَمَا هَذِهِ الْحَيَاةُ الدُّنْيَا إِلَّا لَهْوٌ وَلَعِبٌ وَإِنَّ الدَّارَ الْآخِرَةَ لَهِيَ الْحَيَوَانُ لَوْ كَانُوا يَعْلَمُونَ"},"context":"قبلها: الله يبسط الرزق لمن يشاء.","reason":"إقرارهم بإنزال المطر ثم الحمد."},{"i":15,"of":24,"s":31,"surah":"لقمان","a":25,"text":"وَلَئِنْ سَأَلْتَهُمْ مَنْ خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ لَيَقُولُنَّ اللَّهُ قُلِ الْحَمْدُ لِلَّهِ بَلْ أَكْثَرُهُمْ لَا يَعْلَمُونَ","prev":{"a":24,"text":"نُمَتِّعُهُمْ قَلِيلًا ثُمَّ نَضْطَرُّهُمْ إِلَى عَذَابٍ غَلِيظٍ"},"next":{"a":26,"text":"لِلَّهِ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ إِنَّ اللَّهَ هُوَ الْغَنِيُّ الْحَمِيدُ"},"context":"قبلها: نمتعهم قليلًا.","reason":"إقرارهم بالخالق ثم الحمد."},{"i":16,"of":24,"s":34,"surah":"سبأ","a":1,"text":"الْحَمْدُ لِلَّهِ الَّذِي لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَلَهُ الْحَمْدُ فِي الْآخِرَةِ وَهُوَ الْحَكِيمُ الْخَبِيرُ","next":{"a":2,"text":"يَعْلَمُ مَا يَلِجُ فِي الْأَرْضِ وَمَا يَخْرُجُ مِنْهَا وَمَا يَنْزِلُ مِنَ السَّمَاءِ وَمَا يَعْرُجُ فِيهَا وَهُوَ الرَّحِيمُ الْغَفُورُ"},"context":"مطلع سبأ.","reason":"الحمد على الملك في الدارين."},{"i":17,"of":24,"s":35,"surah":"فاطر","a":1,"text":"الْحَمْدُ لِلَّهِ فَاطِرِ السَّمَاوَاتِ وَالْأَرْضِ جَاعِلِ الْمَلَائِكَةِ رُسُلًا أُولِي أَجْنِحَةٍ مَثْنَى وَثُلَاثَ وَرُبَاعَ يَزِيدُ فِي الْخَلْقِ مَا يَشَاءُ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","next":{"a":2,"text":"مَا يَفْتَحِ اللَّهُ لِلنَّاسِ مِنْ رَحْمَةٍ فَلَا مُمْسِكَ لَهَا وَمَا يُمْسِكْ فَلَا مُرْسِلَ لَهُ مِنْ بَعْدِهِ وَهُوَ الْعَزِيزُ الْحَكِيمُ"},"context":"مطلع فاطر.","reason":"الحمد على الخلق وجعل الملائكة رسلًا."},{"i":18,"of":24,"s":35,"surah":"فاطر","a":34,"text":"وَقَالُوا الْحَمْدُ لِلَّهِ الَّذِي أَذْهَبَ عَنَّا الْحَزَنَ إِنَّ رَبَّنَا لَغَفُورٌ شَكُورٌ","prev":{"a":33,"text":"جَنَّاتُ عَدْنٍ يَدْخُلُونَهَا يُحَلَّوْنَ فِيهَا مِنْ أَسَاوِرَ مِنْ ذَهَبٍ وَلُؤْلُؤًا وَلِبَاسُهُمْ فِيهَا حَرِيرٌ"},"next":{"a":35,"text":"الَّذِي أَحَلَّنَا دَارَ الْمُقَامَةِ مِنْ فَضْلِهِ لَا يَمَسُّنَا فِيهَا نَصَبٌ وَلَا يَمَسُّنَا فِيهَا لُغُوبٌ"},"context":"أهل الجنة يدخلون جنات عدن.","reason":"الحمد على ذهاب الحزن."},{"i":19,"of":24,"s":37,"surah":"الصافات","a":182,"text":"وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ","prev":{"a":181,"text":"وَسَلَامٌ عَلَى الْمُرْسَلِينَ"},"context":"ختام الصافات.","reason":"الحمد بعد السلام على المرسلين."},{"i":20,"of":24,"s":39,"surah":"الزمر","a":29,"text":"ضَرَبَ اللَّهُ مَثَلًا رَجُلًا فِيهِ شُرَكَاءُ مُتَشَاكِسُونَ وَرَجُلًا سَلَمًا لِرَجُلٍ هَلْ يَسْتَوِيَانِ مَثَلًا الْحَمْدُ لِلَّهِ بَلْ أَكْثَرُهُمْ لَا يَعْلَمُونَ","prev":{"a":28,"text":"قُرْآنًا عَرَبِيًّا غَيْرَ ذِي عِوَجٍ لَعَلَّهُمْ يَتَّقُونَ"},"next":{"a":30,"text":"إِنَّكَ مَيِّتٌ وَإِنَّهُمْ مَيِّتُونَ"},"context":"مثل الرجل فيه شركاء متشاكسون.","reason":"الحمد على التوحيد الذي يجمع القلب."},{"i":21,"of":24,"s":39,"surah":"الزمر","a":74,"text":"وَقَالُوا الْحَمْدُ لِلَّهِ الَّذِي صَدَقَنَا وَعْدَهُ وَأَوْرَثَنَا الْأَرْضَ نَتَبَوَّأُ مِنَ الْجَنَّةِ حَيْثُ نَشَاءُ فَنِعْمَ أَجْرُ الْعَامِلِينَ","prev":{"a":73,"text":"وَسِيقَ الَّذِينَ اتَّقَوْا رَبَّهُمْ إِلَى الْجَنَّةِ زُمَرًا حَتَّى إِذَا جَاءُوهَا وَفُتِحَتْ أَبْوَابُهَا وَقَالَ لَهُمْ خَزَنَتُهَا سَلَامٌ عَلَيْكُمْ طِبْتُمْ فَادْخُلُوهَا خَالِدِينَ"},"next":{"a":75,"text":"وَتَرَى الْمَلَائِكَةَ حَافِّينَ مِنْ حَوْلِ الْعَرْشِ يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ وَقُضِيَ بَيْنَهُمْ بِالْحَقِّ وَقِيلَ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ"},"context":"المتقون يُساقون إلى الجنة زمرًا.","reason":"الحمد على صدق الوعد."},{"i":22,"of":24,"s":39,"surah":"الزمر","a":75,"text":"وَتَرَى الْمَلَائِكَةَ حَافِّينَ مِنْ حَوْلِ الْعَرْشِ يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ وَقُضِيَ بَيْنَهُمْ بِالْحَقِّ وَقِيلَ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ","prev":{"a":74,"text":"وَقَالُوا الْحَمْدُ لِلَّهِ الَّذِي صَدَقَنَا وَعْدَهُ وَأَوْرَثَنَا الْأَرْضَ نَتَبَوَّأُ مِنَ الْجَنَّةِ حَيْثُ نَشَاءُ فَنِعْمَ أَجْرُ الْعَامِلِينَ"},"context":"الملائكة حول العرش.","reason":"الحمد بعد القضاء بالحق."},{"i":23,"of":24,"s":40,"surah":"غافر","a":65,"text":"هُوَ الْحَيُّ لَا إِلَهَ إِلَّا هُوَ فَادْعُوهُ مُخْلِصِينَ لَهُ الدِّينَ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ","prev":{"a":64,"text":"اللَّهُ الَّذِي جَعَلَ لَكُمُ الْأَرْضَ قَرَارًا وَالسَّمَاءَ بِنَاءً وَصَوَّرَكُمْ فَأَحْسَنَ صُوَرَكُمْ وَرَزَقَكُمْ مِنَ الطَّيِّبَاتِ ذَلِكُمُ اللَّهُ رَبُّكُمْ فَتَبَارَكَ اللَّهُ رَبُّ الْعَالَمِينَ"},"next":{"a":66,"text":"قُلْ إِنِّي نُهِيتُ أَنْ أَعْبُدَ الَّذِينَ تَدْعُونَ مِنْ دُونِ اللَّهِ لَمَّا جَاءَنِيَ الْبَيِّنَاتُ مِنْ رَبِّي وَأُمِرْتُ أَنْ أُسْلِمَ لِرَبِّ الْعَالَمِينَ"},"reason":"الدعاء بإخلاص ثم الحمد."},{"i":24,"of":24,"s":45,"surah":"الجاثية","a":36,"text":"فَلِلَّهِ الْحَمْدُ رَبِّ السَّمَاوَاتِ وَرَبِّ الْأَرْضِ رَبِّ الْعَالَمِينَ","prev":{"a":35,"text":"ذَلِكُمْ بِأَنَّكُمُ اتَّخَذْتُمْ آيَاتِ اللَّهِ هُزُوًا وَغَرَّتْكُمُ الْحَيَاةُ الدُّنْيَا فَالْيَوْمَ لَا يُخْرَجُونَ مِنْهَا وَلَا هُمْ يُسْتَعْتَبُونَ"},"next":{"a":37,"text":"وَلَهُ الْكِبْرِيَاءُ فِي السَّمَاوَاتِ وَالْأَرْضِ وَهُوَ الْعَزِيزُ الْحَكِيمُ"},"context":"ختام الجاثية بعد ذكر المستهزئين.","reason":"الحمد لرب السماوات والأرض."}],"hadiths":[{"i":1,"of":1,"text":"أَفضلُ الذِّكرِ: لا إلَهَ إلَّا اللهُ، وأَفضلُ الدُّعاءِ: الحمدُ للهِ.","narrator":"جابر بن عبدالله","source":"المستدرك على الصحيحين 1876","grade":"صحيح","judgment":"صحيح الإسناد","url":"https://dorar.net/h/GocXepcb","nameForm":"الحمد لله"}],"sunnah":{},"situations":[{"situationId":2,"verses":[{"i":18,"strength":"direct","bridge":"إذا أثقلك الحزن، فأهل الجنة يقولون: ﴿الْحَمْدُ لِلَّهِ الَّذِي أَذْهَبَ عَنَّا الْحَزَنَ﴾."}],"hadiths":[]},{"situationId":28,"verses":[{"i":10,"strength":"direct","bridge":"إذا نجوت من ظالم: ﴿فَقُلِ الْحَمْدُ لِلَّهِ الَّذِي نَجَّانَا مِنَ الْقَوْمِ الظَّالِمِينَ﴾."}],"hadiths":[]},{"situationId":36,"verses":[{"i":3,"strength":"direct","bridge":"إذا زال ظلم: ﴿وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ﴾."}],"hadiths":[]},{"situationId":41,"verses":[{"i":14,"strength":"direct","bridge":"إذا أحيا الله أرضك بالمطر: ﴿قُلِ الْحَمْدُ لِلَّهِ﴾."}],"hadiths":[]},{"situationId":45,"verses":[{"i":7,"strength":"direct","bridge":"احمد على أن جعلك ممن ينفق: ﴿هَلْ يَسْتَوُونَ الْحَمْدُ لِلَّهِ﴾."}],"hadiths":[]},{"situationId":51,"verses":[{"i":6,"strength":"direct","bridge":"إذا رُزقت ولدًا بعد انتظار: ﴿الْحَمْدُ لِلَّهِ الَّذِي وَهَبَ لِي عَلَى الْكِبَرِ إِسْمَاعِيلَ وَإِسْحَاقَ﴾."}],"hadiths":[]},{"situationId":83,"verses":[{"i":11,"strength":"direct","bridge":"إذا فُضّلت بعلم فاحمد: ﴿الْحَمْدُ لِلَّهِ الَّذِي فَضَّلَنَا عَلَى كَثِيرٍ مِنْ عِبَادِهِ الْمُؤْمِنِينَ﴾."}],"hadiths":[]},{"situationId":94,"verses":[{"i":20,"strength":"direct","bridge":"القلب الموحد مرتاح: ﴿هَلْ يَسْتَوِيَانِ مَثَلًا الْحَمْدُ لِلَّهِ﴾."}],"hadiths":[]},{"situationId":106,"verses":[{"i":15,"strength":"direct","bridge":"إقرار الفطرة: ﴿لَيَقُولُنَّ اللَّهُ قُلِ الْحَمْدُ لِلَّهِ﴾."}],"hadiths":[]},{"situationId":108,"verses":[{"i":22,"strength":"direct","bridge":"﴿وَقِيلَ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ﴾."}],"hadiths":[]},{"situationId":110,"verses":[{"i":21,"strength":"direct","bridge":"احمد على وعد صادق: ﴿الْحَمْدُ لِلَّهِ الَّذِي صَدَقَنَا وَعْدَهُ﴾."}],"hadiths":[]},{"situationId":118,"verses":[{"i":4,"strength":"direct","bridge":"احمد على هدايتك: ﴿الْحَمْدُ لِلَّهِ الَّذِي هَدَانَا لِهَذَا وَمَا كُنَّا لِنَهْتَدِيَ لَوْلَا أَنْ هَدَانَا اللَّهُ﴾."}],"hadiths":[]},{"situationId":144,"verses":[{"i":1,"strength":"direct","bridge":"ابدأ يومك بها: ﴿الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ﴾."},{"i":8,"strength":"direct","bridge":"ختام يومك: ﴿وَقُلِ الْحَمْدُ لِلَّهِ الَّذِي لَمْ يَتَّخِذْ وَلَدًا﴾ ﴿وَكَبِّرْهُ تَكْبِيرًا﴾."},{"i":12,"strength":"direct","bridge":"﴿قُلِ الْحَمْدُ لِلَّهِ وَسَلَامٌ عَلَى عِبَادِهِ الَّذِينَ اصْطَفَى﴾."},{"i":16,"strength":"direct","bridge":"﴿الْحَمْدُ لِلَّهِ الَّذِي لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ﴾."},{"i":19,"strength":"direct","bridge":"﴿وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ﴾."},{"i":24,"strength":"direct","bridge":"﴿فَلِلَّهِ الْحَمْدُ رَبِّ السَّمَاوَاتِ وَرَبِّ الْأَرْضِ رَبِّ الْعَالَمِينَ﴾."}],"hadiths":[]},{"situationId":164,"verses":[{"i":5,"strength":"direct","bridge":"اختم بها: ﴿وَآخِرُ دَعْوَاهُمْ أَنِ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ﴾."}],"hadiths":[]},{"situationId":169,"verses":[{"i":23,"strength":"direct","bridge":"﴿فَادْعُوهُ مُخْلِصِينَ لَهُ الدِّينَ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ﴾."}],"hadiths":[]},{"situationId":174,"verses":[{"i":17,"strength":"direct","bridge":"﴿الْحَمْدُ لِلَّهِ فَاطِرِ السَّمَاوَاتِ وَالْأَرْضِ﴾."}],"hadiths":[]},{"situationId":175,"verses":[{"i":2,"strength":"direct","bridge":"تأمل وتحمد: ﴿الْحَمْدُ لِلَّهِ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ وَجَعَلَ الظُّلُمَاتِ وَالنُّورَ﴾."},{"i":13,"strength":"direct","bridge":"﴿وَقُلِ الْحَمْدُ لِلَّهِ سَيُرِيكُمْ آيَاتِهِ فَتَعْرِفُونَهَا﴾."}],"hadiths":[]},{"situationId":191,"verses":[{"i":9,"strength":"direct","bridge":"احمد على القرآن: ﴿الْحَمْدُ لِلَّهِ الَّذِي أَنْزَلَ عَلَى عَبْدِهِ الْكِتَابَ وَلَمْ يَجْعَلْ لَهُ عِوَجًا﴾."}],"hadiths":[]}]},{"id":286,"name":"لله ملك السماوات والأرض","compound":true,"meaning":"لله ملك السماوات والأرض: الملك له، ويتصرف فيه بالخلق والهبة والمغفرة والعذاب.","teaches":"1. تأتي مع الهبة: يهب لمن يشاء إناثًا ويهب الذكور.\n2. ومع رد دعوى بنوة الله.\n3. ومع المغفرة والعذاب.","whenRecall":"- حين تنتظر الولد.\n- حين تغترّ بانتسابك.","whenPray":"1. يا من له الملك، هب لي ما تشاء.","summary":"المالك يهب ويمنع ويغفر ويعذب.","verses":[{"i":1,"of":7,"s":3,"surah":"آل عمران","a":189,"text":"وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":188,"text":"لَا تَحْسَبَنَّ الَّذِينَ يَفْرَحُونَ بِمَا أَتَوْا وَيُحِبُّونَ أَنْ يُحْمَدُوا بِمَا لَمْ يَفْعَلُوا فَلَا تَحْسَبَنَّهُمْ بِمَفَازَةٍ مِنَ الْعَذَابِ وَلَهُمْ عَذَابٌ أَلِيمٌ"},"next":{"a":190,"text":"إِنَّ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ وَاخْتِلَافِ اللَّيْلِ وَالنَّهَارِ لَآيَاتٍ لِأُولِي الْأَلْبَابِ"},"context":"قبلها: الذين يفرحون بما أتوا ويحبون أن يُحمدوا بما لم يفعلوا.","reason":"الملك والقدرة بعد ذم حب المدح الكاذب."},{"i":2,"of":7,"s":5,"surah":"المائدة","a":17,"text":"لَقَدْ كَفَرَ الَّذِينَ قَالُوا إِنَّ اللَّهَ هُوَ الْمَسِيحُ ابْنُ مَرْيَمَ قُلْ فَمَنْ يَمْلِكُ مِنَ اللَّهِ شَيْئًا إِنْ أَرَادَ أَنْ يُهْلِكَ الْمَسِيحَ ابْنَ مَرْيَمَ وَأُمَّهُ وَمَنْ فِي الْأَرْضِ جَمِيعًا وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا يَخْلُقُ مَا يَشَاءُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":16,"text":"يَهْدِي بِهِ اللَّهُ مَنِ اتَّبَعَ رِضْوَانَهُ سُبُلَ السَّلَامِ وَيُخْرِجُهُمْ مِنَ الظُّلُمَاتِ إِلَى النُّورِ بِإِذْنِهِ وَيَهْدِيهِمْ إِلَى صِرَاطٍ مُسْتَقِيمٍ"},"next":{"a":18,"text":"وَقَالَتِ الْيَهُودُ وَالنَّصَارَى نَحْنُ أَبْنَاءُ اللَّهِ وَأَحِبَّاؤُهُ قُلْ فَلِمَ يُعَذِّبُكُمْ بِذُنُوبِكُمْ بَلْ أَنْتُمْ بَشَرٌ مِمَّنْ خَلَقَ يَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَإِلَيْهِ الْمَصِيرُ"},"context":"كفر من قال: إن الله هو المسيح.","reason":"لو أراد إهلاك المسيح وأمه لم يملك أحد منعه."},{"i":3,"of":7,"s":5,"surah":"المائدة","a":18,"text":"وَقَالَتِ الْيَهُودُ وَالنَّصَارَى نَحْنُ أَبْنَاءُ اللَّهِ وَأَحِبَّاؤُهُ قُلْ فَلِمَ يُعَذِّبُكُمْ بِذُنُوبِكُمْ بَلْ أَنْتُمْ بَشَرٌ مِمَّنْ خَلَقَ يَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَإِلَيْهِ الْمَصِيرُ","prev":{"a":17,"text":"لَقَدْ كَفَرَ الَّذِينَ قَالُوا إِنَّ اللَّهَ هُوَ الْمَسِيحُ ابْنُ مَرْيَمَ قُلْ فَمَنْ يَمْلِكُ مِنَ اللَّهِ شَيْئًا إِنْ أَرَادَ أَنْ يُهْلِكَ الْمَسِيحَ ابْنَ مَرْيَمَ وَأُمَّهُ وَمَنْ فِي الْأَرْضِ جَمِيعًا وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا يَخْلُقُ مَا يَشَاءُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},"next":{"a":19,"text":"يَا أَهْلَ الْكِتَابِ قَدْ جَاءَكُمْ رَسُولُنَا يُبَيِّنُ لَكُمْ عَلَى فَتْرَةٍ مِنَ الرُّسُلِ أَنْ تَقُولُوا مَا جَاءَنَا مِنْ بَشِيرٍ وَلَا نَذِيرٍ فَقَدْ جَاءَكُمْ بَشِيرٌ وَنَذِيرٌ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},"context":"دعوى أنهم أبناء الله وأحباؤه.","reason":"النسب لا يمنع العذاب."},{"i":4,"of":7,"s":24,"surah":"النور","a":42,"text":"وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَإِلَى اللَّهِ الْمَصِيرُ","prev":{"a":41,"text":"أَلَمْ تَرَ أَنَّ اللَّهَ يُسَبِّحُ لَهُ مَنْ فِي السَّمَاوَاتِ وَالْأَرْضِ وَالطَّيْرُ صَافَّاتٍ كُلٌّ قَدْ عَلِمَ صَلَاتَهُ وَتَسْبِيحَهُ وَاللَّهُ عَلِيمٌ بِمَا يَفْعَلُونَ"},"next":{"a":43,"text":"أَلَمْ تَرَ أَنَّ اللَّهَ يُزْجِي سَحَابًا ثُمَّ يُؤَلِّفُ بَيْنَهُ ثُمَّ يَجْعَلُهُ رُكَامًا فَتَرَى الْوَدْقَ يَخْرُجُ مِنْ خِلَالِهِ وَيُنَزِّلُ مِنَ السَّمَاءِ مِنْ جِبَالٍ فِيهَا مِنْ بَرَدٍ فَيُصِيبُ بِهِ مَنْ يَشَاءُ وَيَصْرِفُهُ عَنْ مَنْ يَشَاءُ يَكَادُ سَنَا بَرْقِهِ يَذْهَبُ بِالْأَبْصَارِ"},"context":"تسبيح من في السماوات والأرض والطير.","reason":"الملك والمصير."},{"i":5,"of":7,"s":42,"surah":"الشورى","a":49,"text":"لِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ يَخْلُقُ مَا يَشَاءُ يَهَبُ لِمَنْ يَشَاءُ إِنَاثًا وَيَهَبُ لِمَنْ يَشَاءُ الذُّكُورَ","prev":{"a":48,"text":"فَإِنْ أَعْرَضُوا فَمَا أَرْسَلْنَاكَ عَلَيْهِمْ حَفِيظًا إِنْ عَلَيْكَ إِلَّا الْبَلَاغُ وَإِنَّا إِذَا أَذَقْنَا الْإِنْسَانَ مِنَّا رَحْمَةً فَرِحَ بِهَا وَإِنْ تُصِبْهُمْ سَيِّئَةٌ بِمَا قَدَّمَتْ أَيْدِيهِمْ فَإِنَّ الْإِنْسَانَ كَفُورٌ"},"next":{"a":50,"text":"أَوْ يُزَوِّجُهُمْ ذُكْرَانًا وَإِنَاثًا وَيَجْعَلُ مَنْ يَشَاءُ عَقِيمًا إِنَّهُ عَلِيمٌ قَدِيرٌ"},"context":"بعد: إن أعرضوا فما أرسلناك عليهم حفيظًا.","reason":"الهبة بيده: إناثًا وذكورًا أو عقمًا."},{"i":6,"of":7,"s":45,"surah":"الجاثية","a":27,"text":"وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَيَوْمَ تَقُومُ السَّاعَةُ يَوْمَئِذٍ يَخْسَرُ الْمُبْطِلُونَ","prev":{"a":26,"text":"قُلِ اللَّهُ يُحْيِيكُمْ ثُمَّ يُمِيتُكُمْ ثُمَّ يَجْمَعُكُمْ إِلَى يَوْمِ الْقِيَامَةِ لَا رَيْبَ فِيهِ وَلَكِنَّ أَكْثَرَ النَّاسِ لَا يَعْلَمُونَ"},"next":{"a":28,"text":"وَتَرَى كُلَّ أُمَّةٍ جَاثِيَةً كُلُّ أُمَّةٍ تُدْعَى إِلَى كِتَابِهَا الْيَوْمَ تُجْزَوْنَ مَا كُنْتُمْ تَعْمَلُونَ"},"context":"قبلها: الله يحييكم ثم يميتكم ثم يجمعكم.","reason":"يوم تقوم الساعة يخسر المبطلون."},{"i":7,"of":7,"s":48,"surah":"الفتح","a":14,"text":"وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ يَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا","prev":{"a":13,"text":"وَمَنْ لَمْ يُؤْمِنْ بِاللَّهِ وَرَسُولِهِ فَإِنَّا أَعْتَدْنَا لِلْكَافِرِينَ سَعِيرًا"},"next":{"a":15,"text":"سَيَقُولُ الْمُخَلَّفُونَ إِذَا انْطَلَقْتُمْ إِلَى مَغَانِمَ لِتَأْخُذُوهَا ذَرُونَا نَتَّبِعْكُمْ يُرِيدُونَ أَنْ يُبَدِّلُوا كَلَامَ اللَّهِ قُلْ لَنْ تَتَّبِعُونَا كَذَلِكُمْ قَالَ اللَّهُ مِنْ قَبْلُ فَسَيَقُولُونَ بَلْ تَحْسُدُونَنَا بَلْ كَانُوا لَا يَفْقَهُونَ إِلَّا قَلِيلًا"},"context":"بعد ذكر المخلفين من الأعراب.","reason":"الملك مع المغفرة والرحمة."}],"hadiths":[],"situations":[{"situationId":19,"verses":[{"i":7,"strength":"direct","bridge":"باب المغفرة مفتوح: ﴿يَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا﴾."}],"hadiths":[]},{"situationId":51,"verses":[{"i":5,"strength":"direct","bridge":"إذا تأخرت الذرية أو جاءت على غير ما تريد: ﴿يَهَبُ لِمَنْ يَشَاءُ إِنَاثًا وَيَهَبُ لِمَنْ يَشَاءُ الذُّكُورَ﴾."}],"hadiths":[]},{"situationId":81,"verses":[{"i":1,"strength":"direct","bridge":"لا تطلب مدح الناس بما لم تفعل؛ ﴿وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ﴾."}],"hadiths":[]},{"situationId":89,"verses":[{"i":3,"strength":"direct","bridge":"الانتساب لا يكفي: ﴿بَلْ أَنْتُمْ بَشَرٌ مِمَّنْ خَلَقَ﴾."}],"hadiths":[]},{"situationId":106,"verses":[{"i":2,"strength":"direct","bridge":"لا أحد يملك من الله شيئًا: ﴿فَمَنْ يَمْلِكُ مِنَ اللَّهِ شَيْئًا﴾."}],"hadiths":[]},{"situationId":110,"verses":[{"i":6,"strength":"direct","bridge":"﴿وَيَوْمَ تَقُومُ السَّاعَةُ يَوْمَئِذٍ يَخْسَرُ الْمُبْطِلُونَ﴾."}],"hadiths":[]},{"situationId":174,"verses":[{"i":4,"strength":"direct","bridge":"﴿وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَإِلَى اللَّهِ الْمَصِيرُ﴾."}],"hadiths":[]}]},{"id":287,"name":"لله ملك السماوات والأرض وما فيهن","compound":true,"meaning":"لله ملك السماوات والأرض وما فيهن: ختام المائدة، الملك الشامل مع القدرة.","teaches":"1. جاءت بعد: هذا يوم ينفع الصادقين صدقهم.","whenRecall":"- حين تحتاج إلى الصدق.","whenPray":"1. اللهم اجعلني من الصادقين.","summary":"يوم ينفع الصدق، والملك كله لله.","verses":[{"i":1,"of":1,"s":5,"surah":"المائدة","a":120,"text":"لِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا فِيهِنَّ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":119,"text":"قَالَ اللَّهُ هَذَا يَوْمُ يَنْفَعُ الصَّادِقِينَ صِدْقُهُمْ لَهُمْ جَنَّاتٌ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا أَبَدًا رَضِيَ اللَّهُ عَنْهُمْ وَرَضُوا عَنْهُ ذَلِكَ الْفَوْزُ الْعَظِيمُ"},"context":"قبلها: هذا يوم ينفع الصادقين صدقهم.","reason":"ختام السورة بالملك والقدرة."}],"hadiths":[],"situations":[{"situationId":60,"verses":[{"i":1,"strength":"direct","bridge":"اصدق اليوم لتنتفع غدًا عند من ﴿لِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا فِيهِنَّ﴾."}],"hadiths":[]}]},{"id":288,"name":"لله الحمد رب السماوات ورب الأرض رب العالمين","compound":true,"meaning":"لله الحمد رب السماوات ورب الأرض رب العالمين: الحمد لرب كل شيء.","teaches":"1. ختام الجاثية.","whenRecall":"- عند ختام الأعمال.","whenPray":"1. فلله الحمد رب السماوات ورب الأرض.","summary":"احمد رب كل شيء.","verses":[{"i":1,"of":1,"s":45,"surah":"الجاثية","a":36,"text":"فَلِلَّهِ الْحَمْدُ رَبِّ السَّمَاوَاتِ وَرَبِّ الْأَرْضِ رَبِّ الْعَالَمِينَ","prev":{"a":35,"text":"ذَلِكُمْ بِأَنَّكُمُ اتَّخَذْتُمْ آيَاتِ اللَّهِ هُزُوًا وَغَرَّتْكُمُ الْحَيَاةُ الدُّنْيَا فَالْيَوْمَ لَا يُخْرَجُونَ مِنْهَا وَلَا هُمْ يُسْتَعْتَبُونَ"},"next":{"a":37,"text":"وَلَهُ الْكِبْرِيَاءُ فِي السَّمَاوَاتِ وَالْأَرْضِ وَهُوَ الْعَزِيزُ الْحَكِيمُ"},"context":"بعد ذكر من اتخذوا آيات الله هزوًا.","reason":"الحمد ختامًا."}],"hadiths":[],"situations":[{"situationId":144,"verses":[{"i":1,"strength":"direct","bridge":"﴿فَلِلَّهِ الْحَمْدُ رَبِّ السَّمَاوَاتِ وَرَبِّ الْأَرْضِ رَبِّ الْعَالَمِينَ﴾."}],"hadiths":[]}]},{"id":289,"name":"لله من في السماوات ومن في الأرض","compound":true,"meaning":"لله من في السماوات ومن في الأرض: كل العقلاء ملكه.","teaches":"1. جاءت بعد: لا يحزنك قولهم.\n2. الشركاء ظن وخرص.","whenRecall":"- حين تخاف أحدًا.","whenPray":"1. اللهم كلهم ملكك، فاكفنيهم.","summary":"من تخافه ملكٌ لله.","verses":[{"i":1,"of":1,"s":10,"surah":"يونس","a":66,"text":"أَلَا إِنَّ لِلَّهِ مَنْ فِي السَّمَاوَاتِ وَمَنْ فِي الْأَرْضِ وَمَا يَتَّبِعُ الَّذِينَ يَدْعُونَ مِنْ دُونِ اللَّهِ شُرَكَاءَ إِنْ يَتَّبِعُونَ إِلَّا الظَّنَّ وَإِنْ هُمْ إِلَّا يَخْرُصُونَ","prev":{"a":65,"text":"وَلَا يَحْزُنْكَ قَوْلُهُمْ إِنَّ الْعِزَّةَ لِلَّهِ جَمِيعًا هُوَ السَّمِيعُ الْعَلِيمُ"},"next":{"a":67,"text":"هُوَ الَّذِي جَعَلَ لَكُمُ اللَّيْلَ لِتَسْكُنُوا فِيهِ وَالنَّهَارَ مُبْصِرًا إِنَّ فِي ذَلِكَ لَآيَاتٍ لِقَوْمٍ يَسْمَعُونَ"},"context":"قبلها: ولا يحزنك قولهم إن العزة لله جميعًا.","reason":"الكل ملكه، والشركاء ظن."}],"hadiths":[],"situations":[{"situationId":94,"verses":[{"i":1,"strength":"direct","bridge":"من تخافه ملكٌ لله: ﴿أَلَا إِنَّ لِلَّهِ مَنْ فِي السَّمَاوَاتِ وَمَنْ فِي الْأَرْضِ﴾."}],"hadiths":[]}]},{"id":290,"name":"الحمد لله الذي له ما في السماوات وما في الأرض وله الحمد في الآخرة","compound":true,"meaning":"صيغة مطلع سبأ كاملة: الحمد في الدارين على الملك.","teaches":"1. افتتاح السورة بالحمد، والختم بالحكيم الخبير.","whenRecall":"- عند الحمد.","whenPray":"1. الحمد لله الذي له ما في السماوات وما في الأرض.","summary":"الحمد في الدنيا والآخرة.","verses":[{"i":1,"of":1,"s":34,"surah":"سبأ","a":1,"text":"الْحَمْدُ لِلَّهِ الَّذِي لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَلَهُ الْحَمْدُ فِي الْآخِرَةِ وَهُوَ الْحَكِيمُ الْخَبِيرُ","next":{"a":2,"text":"يَعْلَمُ مَا يَلِجُ فِي الْأَرْضِ وَمَا يَخْرُجُ مِنْهَا وَمَا يَنْزِلُ مِنَ السَّمَاءِ وَمَا يَعْرُجُ فِيهَا وَهُوَ الرَّحِيمُ الْغَفُورُ"},"context":"مطلع سبأ.","reason":"الحمد على الملك، والحكمة والخبرة."}],"hadiths":[],"situations":[{"situationId":144,"verses":[{"i":1,"strength":"direct","bridge":"﴿الْحَمْدُ لِلَّهِ الَّذِي لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَلَهُ الْحَمْدُ فِي الْآخِرَةِ﴾."}],"hadiths":[]}]},{"id":291,"name":"الحمد لله فاطر السماوات والأرض جاعل الملائكة رسلاً أولي أجنحة","compound":true,"meaning":"صيغة مطلع فاطر: الحمد للمبدع، وجاعل الملائكة رسلًا.","teaches":"1. يزيد في الخلق ما يشاء.","whenRecall":"- حين تتأمل الخلق.","whenPray":"1. الحمد لله فاطر السماوات والأرض.","summary":"المبدع يزيد في الخلق ما يشاء.","verses":[{"i":1,"of":1,"s":35,"surah":"فاطر","a":1,"text":"الْحَمْدُ لِلَّهِ فَاطِرِ السَّمَاوَاتِ وَالْأَرْضِ جَاعِلِ الْمَلَائِكَةِ رُسُلًا أُولِي أَجْنِحَةٍ مَثْنَى وَثُلَاثَ وَرُبَاعَ يَزِيدُ فِي الْخَلْقِ مَا يَشَاءُ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","next":{"a":2,"text":"مَا يَفْتَحِ اللَّهُ لِلنَّاسِ مِنْ رَحْمَةٍ فَلَا مُمْسِكَ لَهَا وَمَا يُمْسِكْ فَلَا مُرْسِلَ لَهُ مِنْ بَعْدِهِ وَهُوَ الْعَزِيزُ الْحَكِيمُ"},"context":"مطلع فاطر.","reason":"الحمد على الإبداع وإرسال الملائكة."}],"hadiths":[],"situations":[{"situationId":174,"verses":[{"i":1,"strength":"direct","bridge":"﴿يَزِيدُ فِي الْخَلْقِ مَا يَشَاءُ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾."}],"hadiths":[]}]},{"id":292,"name":"لله المشرق والمغرب","compound":true,"meaning":"لله المشرق والمغرب: الجهات كلها له، فحيثما توجهت فثم وجه الله.","teaches":"1. في سياق منع المساجد.\n2. وفي تحويل القبلة واعتراض السفهاء.","whenRecall":"- عند السفر وجهل القبلة.\n- حين يُعترض على حكم شرعي.","whenPray":"1. اللهم اهدني إلى صراط مستقيم.","summary":"الجهات كلها له، والهداية بيده.","verses":[{"i":1,"of":2,"s":2,"surah":"البقرة","a":115,"text":"وَلِلَّهِ الْمَشْرِقُ وَالْمَغْرِبُ فَأَيْنَمَا تُوَلُّوا فَثَمَّ وَجْهُ اللَّهِ إِنَّ اللَّهَ وَاسِعٌ عَلِيمٌ","prev":{"a":114,"text":"وَمَنْ أَظْلَمُ مِمَّنْ مَنَعَ مَسَاجِدَ اللَّهِ أَنْ يُذْكَرَ فِيهَا اسْمُهُ وَسَعَى فِي خَرَابِهَا أُولَئِكَ مَا كَانَ لَهُمْ أَنْ يَدْخُلُوهَا إِلَّا خَائِفِينَ لَهُمْ فِي الدُّنْيَا خِزْيٌ وَلَهُمْ فِي الْآخِرَةِ عَذَابٌ عَظِيمٌ"},"next":{"a":116,"text":"وَقَالُوا اتَّخَذَ اللَّهُ وَلَدًا سُبْحَانَهُ بَلْ لَهُ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ كُلٌّ لَهُ قَانِتُونَ"},"context":"قبلها: من أظلم ممن منع مساجد الله.","reason":"لا يُمنع ذكر الله؛ فالأرض كلها له."},{"i":2,"of":2,"s":2,"surah":"البقرة","a":142,"text":"سَيَقُولُ السُّفَهَاءُ مِنَ النَّاسِ مَا وَلَّاهُمْ عَنْ قِبْلَتِهِمُ الَّتِي كَانُوا عَلَيْهَا قُلْ لِلَّهِ الْمَشْرِقُ وَالْمَغْرِبُ يَهْدِي مَنْ يَشَاءُ إِلَى صِرَاطٍ مُسْتَقِيمٍ","prev":{"a":141,"text":"تِلْكَ أُمَّةٌ قَدْ خَلَتْ لَهَا مَا كَسَبَتْ وَلَكُمْ مَا كَسَبْتُمْ وَلَا تُسْأَلُونَ عَمَّا كَانُوا يَعْمَلُونَ"},"next":{"a":143,"text":"وَكَذَلِكَ جَعَلْنَاكُمْ أُمَّةً وَسَطًا لِتَكُونُوا شُهَدَاءَ عَلَى النَّاسِ وَيَكُونَ الرَّسُولُ عَلَيْكُمْ شَهِيدًا وَمَا جَعَلْنَا الْقِبْلَةَ الَّتِي كُنْتَ عَلَيْهَا إِلَّا لِنَعْلَمَ مَنْ يَتَّبِعُ الرَّسُولَ مِمَّنْ يَنْقَلِبُ عَلَى عَقِبَيْهِ وَإِنْ كَانَتْ لَكَبِيرَةً إِلَّا عَلَى الَّذِينَ هَدَى اللَّهُ وَمَا كَانَ اللَّهُ لِيُضِيعَ إِيمَانَكُمْ إِنَّ اللَّهَ بِالنَّاسِ لَرَءُوفٌ رَحِيمٌ"},"context":"قبلها: تلك أمة قد خلت.","reason":"ردّ على اعتراض السفهاء على تحويل القبلة."}],"hadiths":[{"i":1,"of":1,"text":"كانَ النَّبيُّ صلَّى اللَّهُ عليْهِ وسلَّمَ يصلِّي على راحلتِهِ تطوُّعًا أينَما توجَّهت بِهِ وَهوَ جاءٍ من مَكَّةَ إلى المدينةِ ثمَّ قرأَ ابنُ عمرَ هذِهِ الآيةَ  وَلِلَّهِ الْمَشْرِقُ وَالْمَغْرِبُ  الآيةَ فقالَ ابنُ عمرَ ففي هذا أُنزِلت هذِهِ الآيةُ","narrator":"عبدالله بن عمر","source":"صحيح الترمذي 2958","grade":"صحيح","url":"https://dorar.net/h/q7r0bbYj","nameForm":"لله المشرق والمغرب"}],"sunnah":{},"situations":[{"situationId":108,"verses":[{"i":2,"strength":"direct","bridge":"إذا اعترض الناس على حكم الله: ﴿قُلْ لِلَّهِ الْمَشْرِقُ وَالْمَغْرِبُ يَهْدِي مَنْ يَشَاءُ إِلَى صِرَاطٍ مُسْتَقِيمٍ﴾."}],"hadiths":[]},{"situationId":165,"verses":[{"i":1,"strength":"direct","bridge":"حيثما كنت: ﴿فَأَيْنَمَا تُوَلُّوا فَثَمَّ وَجْهُ اللَّهِ﴾."}],"hadiths":[]}]},{"id":293,"name":"لله غيب السماوات والأرض","compound":true,"meaning":"لله غيب السماوات والأرض: الغيب ملكه، وأمر الساعة كلمح البصر.","teaches":"1. خاتمة هود مع الأمر بالعبادة والتوكل.\n2. وفي النحل مع قرب الساعة.","whenRecall":"- حين تقلق من المستقبل.","whenPray":"1. اللهم إليك يرجع الأمر كله، فاكفني.","summary":"الغيب له، فاعبده وتوكل عليه.","verses":[{"i":1,"of":2,"s":11,"surah":"هود","a":123,"text":"وَلِلَّهِ غَيْبُ السَّمَاوَاتِ وَالْأَرْضِ وَإِلَيْهِ يُرْجَعُ الْأَمْرُ كُلُّهُ فَاعْبُدْهُ وَتَوَكَّلْ عَلَيْهِ وَمَا رَبُّكَ بِغَافِلٍ عَمَّا تَعْمَلُونَ","prev":{"a":122,"text":"وَانْتَظِرُوا إِنَّا مُنْتَظِرُونَ"},"context":"ختام هود.","reason":"الغيب والأمر كله إليه، ثم العبادة والتوكل."},{"i":2,"of":2,"s":16,"surah":"النحل","a":77,"text":"وَلِلَّهِ غَيْبُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا أَمْرُ السَّاعَةِ إِلَّا كَلَمْحِ الْبَصَرِ أَوْ هُوَ أَقْرَبُ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":76,"text":"وَضَرَبَ اللَّهُ مَثَلًا رَجُلَيْنِ أَحَدُهُمَا أَبْكَمُ لَا يَقْدِرُ عَلَى شَيْءٍ وَهُوَ كَلٌّ عَلَى مَوْلَاهُ أَيْنَمَا يُوَجِّهْهُ لَا يَأْتِ بِخَيْرٍ هَلْ يَسْتَوِي هُوَ وَمَنْ يَأْمُرُ بِالْعَدْلِ وَهُوَ عَلَى صِرَاطٍ مُسْتَقِيمٍ"},"next":{"a":78,"text":"وَاللَّهُ أَخْرَجَكُمْ مِنْ بُطُونِ أُمَّهَاتِكُمْ لَا تَعْلَمُونَ شَيْئًا وَجَعَلَ لَكُمُ السَّمْعَ وَالْأَبْصَارَ وَالْأَفْئِدَةَ لَعَلَّكُمْ تَشْكُرُونَ"},"context":"قبلها: مثل الأبكم والذي يأمر بالعدل.","reason":"الساعة قريبة كلمح البصر."}],"hadiths":[],"situations":[{"situationId":20,"verses":[{"i":2,"strength":"direct","bridge":"لا تؤجل: ﴿وَمَا أَمْرُ السَّاعَةِ إِلَّا كَلَمْحِ الْبَصَرِ أَوْ هُوَ أَقْرَبُ﴾."}],"hadiths":[]},{"situationId":102,"verses":[{"i":1,"strength":"direct","bridge":"إذا قلقت مما لا تعلم: ﴿وَإِلَيْهِ يُرْجَعُ الْأَمْرُ كُلُّهُ فَاعْبُدْهُ وَتَوَكَّلْ عَلَيْهِ﴾."}],"hadiths":[]}]},{"id":294,"name":"لله عاقبة الأمور","compound":true,"meaning":"لله عاقبة الأمور: نهايات الأشياء إليه.","teaches":"1. جاءت في صفة الممكَّنين: يقيمون الصلاة ويؤتون الزكاة ويأمرون بالمعروف.","whenRecall":"- حين تُمكَّن في منصب.","whenPray":"1. اللهم اجعل عاقبة أمري خيرًا.","summary":"إن مُكّنت فأقم الحق؛ فالعاقبة لله.","verses":[{"i":1,"of":1,"s":22,"surah":"الحج","a":41,"text":"الَّذِينَ إِنْ مَكَّنَّاهُمْ فِي الْأَرْضِ أَقَامُوا الصَّلَاةَ وَآتَوُا الزَّكَاةَ وَأَمَرُوا بِالْمَعْرُوفِ وَنَهَوْا عَنِ الْمُنْكَرِ وَلِلَّهِ عَاقِبَةُ الْأُمُورِ","prev":{"a":40,"text":"الَّذِينَ أُخْرِجُوا مِنْ دِيَارِهِمْ بِغَيْرِ حَقٍّ إِلَّا أَنْ يَقُولُوا رَبُّنَا اللَّهُ وَلَوْلَا دَفْعُ اللَّهِ النَّاسَ بَعْضَهُمْ بِبَعْضٍ لَهُدِّمَتْ صَوَامِعُ وَبِيَعٌ وَصَلَوَاتٌ وَمَسَاجِدُ يُذْكَرُ فِيهَا اسْمُ اللَّهِ كَثِيرًا وَلَيَنْصُرَنَّ اللَّهُ مَنْ يَنْصُرُهُ إِنَّ اللَّهَ لَقَوِيٌّ عَزِيزٌ"},"next":{"a":42,"text":"وَإِنْ يُكَذِّبُوكَ فَقَدْ كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ وَعَادٌ وَثَمُودُ"},"context":"قبلها: الذين أُخرجوا من ديارهم بغير حق.","reason":"صفة من ينصرهم الله، والعاقبة له."}],"hadiths":[],"situations":[{"situationId":150,"verses":[{"i":1,"strength":"direct","bridge":"إذا مُكّنت فتذكر المهمة: ﴿أَقَامُوا الصَّلَاةَ وَآتَوُا الزَّكَاةَ وَأَمَرُوا بِالْمَعْرُوفِ﴾."}],"hadiths":[]}]},{"id":295,"name":"لله جنود السماوات والأرض","compound":true,"meaning":"لله جنود السماوات والأرض: جنوده لا يعلمها إلا هو، ينصر بها من يشاء.","teaches":"1. جاءت بعد إنزال السكينة في قلوب المؤمنين.\n2. وبعد ذكر تعذيب المنافقين.","whenRecall":"- حين تقل عُدّتك.","whenPray":"1. اللهم أنزل سكينتك على قلبي.","summary":"السكينة والجنود من عنده.","verses":[{"i":1,"of":2,"s":48,"surah":"الفتح","a":4,"text":"هُوَ الَّذِي أَنْزَلَ السَّكِينَةَ فِي قُلُوبِ الْمُؤْمِنِينَ لِيَزْدَادُوا إِيمَانًا مَعَ إِيمَانِهِمْ وَلِلَّهِ جُنُودُ السَّمَاوَاتِ وَالْأَرْضِ وَكَانَ اللَّهُ عَلِيمًا حَكِيمًا","prev":{"a":3,"text":"وَيَنْصُرَكَ اللَّهُ نَصْرًا عَزِيزًا"},"next":{"a":5,"text":"لِيُدْخِلَ الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا وَيُكَفِّرَ عَنْهُمْ سَيِّئَاتِهِمْ وَكَانَ ذَلِكَ عِنْدَ اللَّهِ فَوْزًا عَظِيمًا"},"context":"قبلها: وينصرك الله نصرًا عزيزًا.","reason":"السكينة تزيد الإيمان، والجنود لله."},{"i":2,"of":2,"s":48,"surah":"الفتح","a":7,"text":"وَلِلَّهِ جُنُودُ السَّمَاوَاتِ وَالْأَرْضِ وَكَانَ اللَّهُ عَزِيزًا حَكِيمًا","prev":{"a":6,"text":"وَيُعَذِّبَ الْمُنَافِقِينَ وَالْمُنَافِقَاتِ وَالْمُشْرِكِينَ وَالْمُشْرِكَاتِ الظَّانِّينَ بِاللَّهِ ظَنَّ السَّوْءِ عَلَيْهِمْ دَائِرَةُ السَّوْءِ وَغَضِبَ اللَّهُ عَلَيْهِمْ وَلَعَنَهُمْ وَأَعَدَّ لَهُمْ جَهَنَّمَ وَسَاءَتْ مَصِيرًا"},"next":{"a":8,"text":"إِنَّا أَرْسَلْنَاكَ شَاهِدًا وَمُبَشِّرًا وَنَذِيرًا"},"context":"بعد تعذيب المنافقين والمشركين.","reason":"الجنود مع العزة والحكمة."}],"hadiths":[],"situations":[{"situationId":13,"verses":[{"i":1,"strength":"direct","bridge":"إذا اضطرب قلبك: ﴿هُوَ الَّذِي أَنْزَلَ السَّكِينَةَ فِي قُلُوبِ الْمُؤْمِنِينَ﴾."}],"hadiths":[]},{"situationId":31,"verses":[{"i":2,"strength":"direct","bridge":"لا تخش عدوك: ﴿وَلِلَّهِ جُنُودُ السَّمَاوَاتِ وَالْأَرْضِ وَكَانَ اللَّهُ عَزِيزًا حَكِيمًا﴾."}],"hadiths":[]}]},{"id":296,"name":"لله الأسماء الحسنى","compound":true,"meaning":"لله الأسماء الحسنى: أسماؤه حسنى، والأمر بالدعاء بها.","teaches":"1. أمرٌ صريح: فادعوه بها.\n2. وتحذير من الإلحاد في أسمائه.","whenRecall":"- عند كل دعاء.","whenPray":"1. ادعه بالاسم المناسب لحاجتك.","summary":"ادعه بأسمائه، وذر من يلحد فيها.","verses":[{"i":1,"of":1,"s":7,"surah":"الأعراف","a":180,"text":"وَلِلَّهِ الْأَسْمَاءُ الْحُسْنَى فَادْعُوهُ بِهَا وَذَرُوا الَّذِينَ يُلْحِدُونَ فِي أَسْمَائِهِ سَيُجْزَوْنَ مَا كَانُوا يَعْمَلُونَ","prev":{"a":179,"text":"وَلَقَدْ ذَرَأْنَا لِجَهَنَّمَ كَثِيرًا مِنَ الْجِنِّ وَالْإِنْسِ لَهُمْ قُلُوبٌ لَا يَفْقَهُونَ بِهَا وَلَهُمْ أَعْيُنٌ لَا يُبْصِرُونَ بِهَا وَلَهُمْ آذَانٌ لَا يَسْمَعُونَ بِهَا أُولَئِكَ كَالْأَنْعَامِ بَلْ هُمْ أَضَلُّ أُولَئِكَ هُمُ الْغَافِلُونَ"},"next":{"a":181,"text":"وَمِمَّنْ خَلَقْنَا أُمَّةٌ يَهْدُونَ بِالْحَقِّ وَبِهِ يَعْدِلُونَ"},"context":"قبلها: ذرأنا لجهنم كثيرًا لهم قلوب لا يفقهون بها.","reason":"الأمر بالدعاء بالأسماء والنهي عن الإلحاد."}],"hadiths":[],"situations":[{"situationId":163,"verses":[{"i":1,"strength":"direct","bridge":"إذا دعوت فادعه بأسمائه: ﴿وَلِلَّهِ الْأَسْمَاءُ الْحُسْنَى فَادْعُوهُ بِهَا﴾."}],"hadiths":[]}]},{"id":297,"name":"لله خزائن السماوات والأرض","compound":true,"meaning":"لله خزائن السماوات والأرض: الأرزاق كلها في خزائنه.","teaches":"1. ردٌّ على المنافقين: لا تنفقوا على من عند رسول الله.","whenRecall":"- حين يقطع أحد عنك رزقًا.","whenPray":"1. اللهم ارزقني من خزائنك.","summary":"من قطع عنك رزقه لم يقطع خزائن الله.","verses":[{"i":1,"of":1,"s":63,"surah":"المنافقون","a":7,"text":"هُمُ الَّذِينَ يَقُولُونَ لَا تُنْفِقُوا عَلَى مَنْ عِنْدَ رَسُولِ اللَّهِ حَتَّى يَنْفَضُّوا وَلِلَّهِ خَزَائِنُ السَّمَاوَاتِ وَالْأَرْضِ وَلَكِنَّ الْمُنَافِقِينَ لَا يَفْقَهُونَ","prev":{"a":6,"text":"سَوَاءٌ عَلَيْهِمْ أَسْتَغْفَرْتَ لَهُمْ أَمْ لَمْ تَسْتَغْفِرْ لَهُمْ لَنْ يَغْفِرَ اللَّهُ لَهُمْ إِنَّ اللَّهَ لَا يَهْدِي الْقَوْمَ الْفَاسِقِينَ"},"next":{"a":8,"text":"يَقُولُونَ لَئِنْ رَجَعْنَا إِلَى الْمَدِينَةِ لَيُخْرِجَنَّ الْأَعَزُّ مِنْهَا الْأَذَلَّ وَلِلَّهِ الْعِزَّةُ وَلِرَسُولِهِ وَلِلْمُؤْمِنِينَ وَلَكِنَّ الْمُنَافِقِينَ لَا يَعْلَمُونَ"},"context":"قبلها: استغفرت لهم أم لم تستغفر.","reason":"المنافقون أرادوا قطع النفقة، والخزائن لله."}],"hadiths":[],"situations":[{"situationId":42,"verses":[{"i":1,"strength":"direct","bridge":"إن قُطع عنك رزق من أحد: ﴿وَلِلَّهِ خَزَائِنُ السَّمَاوَاتِ وَالْأَرْضِ﴾."}],"hadiths":[]}]},{"id":298,"name":"الملك يومئذ لله","compound":true,"meaning":"الملك يومئذ لله: يوم القيامة يحكم بين الناس.","teaches":"1. جاءت بعد ذكر الذين في مرية حتى تأتيهم الساعة.","whenRecall":"- حين تشك في الجزاء.","whenPray":"1. اللهم اجعلني من أهل جنات النعيم.","summary":"يوم القيامة: الملك لله، والجنات للمؤمنين العاملين.","verses":[{"i":1,"of":1,"s":22,"surah":"الحج","a":56,"text":"الْمُلْكُ يَوْمَئِذٍ لِلَّهِ يَحْكُمُ بَيْنَهُمْ فَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فِي جَنَّاتِ النَّعِيمِ","prev":{"a":55,"text":"وَلَا يَزَالُ الَّذِينَ كَفَرُوا فِي مِرْيَةٍ مِنْهُ حَتَّى تَأْتِيَهُمُ السَّاعَةُ بَغْتَةً أَوْ يَأْتِيَهُمْ عَذَابُ يَوْمٍ عَقِيمٍ"},"next":{"a":57,"text":"وَالَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا فَأُولَئِكَ لَهُمْ عَذَابٌ مُهِينٌ"},"context":"قبلها: لا يزال الذين كفروا في مرية.","reason":"يوم يحكم بين الفريقين."}],"hadiths":[],"situations":[{"situationId":110,"verses":[{"i":1,"strength":"direct","bridge":"اعمل لذلك اليوم: ﴿فَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فِي جَنَّاتِ النَّعِيمِ﴾."}],"hadiths":[]}]},{"id":299,"name":"الملك يومئذ الحق للرحمن","compound":true,"meaning":"الملك يومئذ الحق للرحمن: الملك الحق يوم القيامة للرحمن.","teaches":"1. اقترن الملك بالرحمن، والعسر بالكافرين.","whenRecall":"- حين تخاف يوم القيامة.","whenPray":"1. يا رحمن ارحمني يوم يكون الملك لك.","summary":"يوم عسير على الكافرين، والملك فيه للرحمن.","verses":[{"i":1,"of":1,"s":25,"surah":"الفرقان","a":26,"text":"الْمُلْكُ يَوْمَئِذٍ الْحَقُّ لِلرَّحْمَنِ وَكَانَ يَوْمًا عَلَى الْكَافِرِينَ عَسِيرًا","prev":{"a":25,"text":"وَيَوْمَ تَشَقَّقُ السَّمَاءُ بِالْغَمَامِ وَنُزِّلَ الْمَلَائِكَةُ تَنْزِيلًا"},"next":{"a":27,"text":"وَيَوْمَ يَعَضُّ الظَّالِمُ عَلَى يَدَيْهِ يَقُولُ يَا لَيْتَنِي اتَّخَذْتُ مَعَ الرَّسُولِ سَبِيلًا"},"context":"قبلها: يوم تشقق السماء بالغمام.","reason":"الملك للرحمن، والعسر للكافرين."}],"hadiths":[],"situations":[{"situationId":183,"verses":[{"i":1,"strength":"direct","bridge":"رحمته مرجوّة: ﴿الْمُلْكُ يَوْمَئِذٍ الْحَقُّ لِلرَّحْمَنِ﴾."}],"hadiths":[]}]},{"id":300,"name":"الدين لله","compound":true,"meaning":"الدين لله: أن تكون الطاعة كلها لله بلا فتنة.","teaches":"1. جاءت في القتال حتى لا تكون فتنة.","whenRecall":"- حين يُفتن الناس عن دينهم.","whenPray":"1. اللهم اجعل الدين كله لك.","summary":"غاية الجهاد ألا يُفتن أحد عن دينه.","verses":[{"i":1,"of":1,"s":2,"surah":"البقرة","a":193,"text":"وَقَاتِلُوهُمْ حَتَّى لَا تَكُونَ فِتْنَةٌ وَيَكُونَ الدِّينُ لِلَّهِ فَإِنِ انْتَهَوْا فَلَا عُدْوَانَ إِلَّا عَلَى الظَّالِمِينَ","prev":{"a":192,"text":"فَإِنِ انْتَهَوْا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ"},"next":{"a":194,"text":"الشَّهْرُ الْحَرَامُ بِالشَّهْرِ الْحَرَامِ وَالْحُرُمَاتُ قِصَاصٌ فَمَنِ اعْتَدَى عَلَيْكُمْ فَاعْتَدُوا عَلَيْهِ بِمِثْلِ مَا اعْتَدَى عَلَيْكُمْ وَاتَّقُوا اللَّهَ وَاعْلَمُوا أَنَّ اللَّهَ مَعَ الْمُتَّقِينَ"},"context":"قبلها: فإن انتهوا فإن الله غفور رحيم.","reason":"غاية القتال رفع الفتنة."}],"hadiths":[{"i":1,"of":1,"text":"أتاه رَجُلانِ في فِتنةِ ابنِ الزُّبَيرِ فقالا: إنَّ النَّاسَ قد ضَيَّعوا وأنتَ ابنُ عُمَرَ، وصاحِبُ النَّبيِّ صلَّى اللهُ عليه وسلَّم، فما يَمنَعُكَ أن تَخرُجَ؟ فقال: يَمنَعُني أنَّ اللهَ حَرَّمَ دَمَ أخي، فقالا: ألَم يَقُلِ اللهُ: {وقاتِلوهم حتَّى لا تَكونَ فِتنةٌ}، فقال: قاتَلنا حتَّى لَم تَكُنْ فِتنةٌ، وكان الدِّينُ للَّهِ، وأنتُم تُريدونَ أن تُقاتِلوا حتَّى تَكونَ فِتنةٌ، ويَكونَ الدِّينُ لغَيرِ اللهِ.","narrator":"عبدالله بن عمر","source":"صحيح البخاري 4513","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/lxBCK7CK","nameForm":"الدين لله"}],"sunnah":{},"situations":[{"situationId":35,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَيَكُونَ الدِّينُ لِلَّهِ فَإِنِ انْتَهَوْا فَلَا عُدْوَانَ إِلَّا عَلَى الظَّالِمِينَ﴾."}],"hadiths":[]}]},{"id":301,"name":"الدين كله لله","compound":true,"meaning":"الدين كله لله: الطاعة كاملة لله.","teaches":"1. جاءت في الأنفال بعد عرض المغفرة على الكافرين إن انتهوا.","whenRecall":"- حين تُضطهد لدينك.","whenPray":"1. اللهم اجعل ديني كله لك.","summary":"باب المغفرة مفتوح، والغاية أن يكون الدين كله لله.","verses":[{"i":1,"of":1,"s":8,"surah":"الأنفال","a":39,"text":"وَقَاتِلُوهُمْ حَتَّى لَا تَكُونَ فِتْنَةٌ وَيَكُونَ الدِّينُ كُلُّهُ لِلَّهِ فَإِنِ انْتَهَوْا فَإِنَّ اللَّهَ بِمَا يَعْمَلُونَ بَصِيرٌ","prev":{"a":38,"text":"قُلْ لِلَّذِينَ كَفَرُوا إِنْ يَنْتَهُوا يُغْفَرْ لَهُمْ مَا قَدْ سَلَفَ وَإِنْ يَعُودُوا فَقَدْ مَضَتْ سُنَّتُ الْأَوَّلِينَ"},"next":{"a":40,"text":"وَإِنْ تَوَلَّوْا فَاعْلَمُوا أَنَّ اللَّهَ مَوْلَاكُمْ نِعْمَ الْمَوْلَى وَنِعْمَ النَّصِيرُ"},"context":"قبلها: إن ينتهوا يُغفر لهم ما قد سلف.","reason":"رفع الفتنة."}],"hadiths":[],"situations":[{"situationId":35,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَيَكُونَ الدِّينُ كُلُّهُ لِلَّهِ﴾."}],"hadiths":[]}]},{"id":302,"name":"إن الأمر كله لله","compound":true,"meaning":"إن الأمر كله لله: قالها النبي ﷺ ردًّا على المنافقين يوم أحد.","teaches":"1. أنزل الله الأمنة نعاسًا بعد الغم.\n2. طائفة أهمتهم أنفسهم فظنوا بالله ظن الجاهلية.","whenRecall":"- حين تقول: لو فعلنا كذا ما حدث.","whenPray":"1. قدّر الله وما شاء فعل.","summary":"لا لوم على القدر: الأمر كله لله.","verses":[{"i":1,"of":1,"s":3,"surah":"آل عمران","a":154,"text":"ثُمَّ أَنْزَلَ عَلَيْكُمْ مِنْ بَعْدِ الْغَمِّ أَمَنَةً نُعَاسًا يَغْشَى طَائِفَةً مِنْكُمْ وَطَائِفَةٌ قَدْ أَهَمَّتْهُمْ أَنْفُسُهُمْ يَظُنُّونَ بِاللَّهِ غَيْرَ الْحَقِّ ظَنَّ الْجَاهِلِيَّةِ يَقُولُونَ هَلْ لَنَا مِنَ الْأَمْرِ مِنْ شَيْءٍ قُلْ إِنَّ الْأَمْرَ كُلَّهُ لِلَّهِ يُخْفُونَ فِي أَنْفُسِهِمْ مَا لَا يُبْدُونَ لَكَ يَقُولُونَ لَوْ كَانَ لَنَا مِنَ الْأَمْرِ شَيْءٌ مَا قُتِلْنَا هَاهُنَا قُلْ لَوْ كُنْتُمْ فِي بُيُوتِكُمْ لَبَرَزَ الَّذِينَ كُتِبَ عَلَيْهِمُ الْقَتْلُ إِلَى مَضَاجِعِهِمْ وَلِيَبْتَلِيَ اللَّهُ مَا فِي صُدُورِكُمْ وَلِيُمَحِّصَ مَا فِي قُلُوبِكُمْ وَاللَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ","prev":{"a":153,"text":"إِذْ تُصْعِدُونَ وَلَا تَلْوُونَ عَلَى أَحَدٍ وَالرَّسُولُ يَدْعُوكُمْ فِي أُخْرَاكُمْ فَأَثَابَكُمْ غَمًّا بِغَمٍّ لِكَيْلَا تَحْزَنُوا عَلَى مَا فَاتَكُمْ وَلَا مَا أَصَابَكُمْ وَاللَّهُ خَبِيرٌ بِمَا تَعْمَلُونَ"},"next":{"a":155,"text":"إِنَّ الَّذِينَ تَوَلَّوْا مِنْكُمْ يَوْمَ الْتَقَى الْجَمْعَانِ إِنَّمَا اسْتَزَلَّهُمُ الشَّيْطَانُ بِبَعْضِ مَا كَسَبُوا وَلَقَدْ عَفَا اللَّهُ عَنْهُمْ إِنَّ اللَّهَ غَفُورٌ حَلِيمٌ"},"context":"قبلها: هزيمة أحد والفرار.","reason":"الأمر لله، ولو كانوا في بيوتهم لبرز الذين كُتب عليهم القتل."}],"hadiths":[],"situations":[{"situationId":10,"verses":[{"i":1,"strength":"direct","bridge":"إذا قلت: لو، فتذكر: ﴿قُلْ إِنَّ الْأَمْرَ كُلَّهُ لِلَّهِ﴾."}],"hadiths":[]}]},{"id":303,"name":"إن الحكم إلا لله","compound":true,"meaning":"إن الحكم إلا لله: الحكم والأمر لله وحده، شرعًا وقدرًا.","teaches":"1. قالها يوسف في السجن داعيًا إلى التوحيد.\n2. وقالها يعقوب بعد أخذ الأسباب.\n3. وقالها النبي ﷺ لمن استعجل العذاب.","whenRecall":"- بعد أن تأخذ بالأسباب.","whenPray":"1. ﴿إِنِ الْحُكْمُ إِلَّا لِلَّهِ عَلَيْهِ تَوَكَّلْتُ﴾ — يوسف 67.","summary":"خذ بالأسباب ثم قل: إن الحكم إلا لله.","verses":[{"i":1,"of":3,"s":6,"surah":"الأنعام","a":57,"text":"قُلْ إِنِّي عَلَى بَيِّنَةٍ مِنْ رَبِّي وَكَذَّبْتُمْ بِهِ مَا عِنْدِي مَا تَسْتَعْجِلُونَ بِهِ إِنِ الْحُكْمُ إِلَّا لِلَّهِ يَقُصُّ الْحَقَّ وَهُوَ خَيْرُ الْفَاصِلِينَ","prev":{"a":56,"text":"قُلْ إِنِّي نُهِيتُ أَنْ أَعْبُدَ الَّذِينَ تَدْعُونَ مِنْ دُونِ اللَّهِ قُلْ لَا أَتَّبِعُ أَهْوَاءَكُمْ قَدْ ضَلَلْتُ إِذًا وَمَا أَنَا مِنَ الْمُهْتَدِينَ"},"next":{"a":58,"text":"قُلْ لَوْ أَنَّ عِنْدِي مَا تَسْتَعْجِلُونَ بِهِ لَقُضِيَ الْأَمْرُ بَيْنِي وَبَيْنَكُمْ وَاللَّهُ أَعْلَمُ بِالظَّالِمِينَ"},"context":"قبلها: إني نهيت أن أعبد الذين تدعون.","reason":"العذاب المستعجل ليس بيده؛ الحكم لله."},{"i":2,"of":3,"s":12,"surah":"يوسف","a":40,"text":"مَا تَعْبُدُونَ مِنْ دُونِهِ إِلَّا أَسْمَاءً سَمَّيْتُمُوهَا أَنْتُمْ وَآبَاؤُكُمْ مَا أَنْزَلَ اللَّهُ بِهَا مِنْ سُلْطَانٍ إِنِ الْحُكْمُ إِلَّا لِلَّهِ أَمَرَ أَلَّا تَعْبُدُوا إِلَّا إِيَّاهُ ذَلِكَ الدِّينُ الْقَيِّمُ وَلَكِنَّ أَكْثَرَ النَّاسِ لَا يَعْلَمُونَ","prev":{"a":39,"text":"يَا صَاحِبَيِ السِّجْنِ أَأَرْبَابٌ مُتَفَرِّقُونَ خَيْرٌ أَمِ اللَّهُ الْوَاحِدُ الْقَهَّارُ"},"next":{"a":41,"text":"يَا صَاحِبَيِ السِّجْنِ أَمَّا أَحَدُكُمَا فَيَسْقِي رَبَّهُ خَمْرًا وَأَمَّا الْآخَرُ فَيُصْلَبُ فَتَأْكُلُ الطَّيْرُ مِنْ رَأْسِهِ قُضِيَ الْأَمْرُ الَّذِي فِيهِ تَسْتَفْتِيَانِ"},"context":"يوسف يدعو صاحبي السجن.","reason":"الدعوة إلى التوحيد في السجن."},{"i":3,"of":3,"s":12,"surah":"يوسف","a":67,"text":"وَقَالَ يَا بَنِيَّ لَا تَدْخُلُوا مِنْ بَابٍ وَاحِدٍ وَادْخُلُوا مِنْ أَبْوَابٍ مُتَفَرِّقَةٍ وَمَا أُغْنِي عَنْكُمْ مِنَ اللَّهِ مِنْ شَيْءٍ إِنِ الْحُكْمُ إِلَّا لِلَّهِ عَلَيْهِ تَوَكَّلْتُ وَعَلَيْهِ فَلْيَتَوَكَّلِ الْمُتَوَكِّلُونَ","prev":{"a":66,"text":"قَالَ لَنْ أُرْسِلَهُ مَعَكُمْ حَتَّى تُؤْتُونِ مَوْثِقًا مِنَ اللَّهِ لَتَأْتُنَّنِي بِهِ إِلَّا أَنْ يُحَاطَ بِكُمْ فَلَمَّا آتَوْهُ مَوْثِقَهُمْ قَالَ اللَّهُ عَلَى مَا نَقُولُ وَكِيلٌ"},"next":{"a":68,"text":"وَلَمَّا دَخَلُوا مِنْ حَيْثُ أَمَرَهُمْ أَبُوهُمْ مَا كَانَ يُغْنِي عَنْهُمْ مِنَ اللَّهِ مِنْ شَيْءٍ إِلَّا حَاجَةً فِي نَفْسِ يَعْقُوبَ قَضَاهَا وَإِنَّهُ لَذُو عِلْمٍ لِمَا عَلَّمْنَاهُ وَلَكِنَّ أَكْثَرَ النَّاسِ لَا يَعْلَمُونَ"},"context":"يعقوب يوصي أبناءه بالدخول من أبواب متفرقة.","reason":"أخذ بالسبب ثم فوّض."}],"hadiths":[],"situations":[{"situationId":11,"verses":[{"i":3,"strength":"direct","bridge":"خذ بالأسباب ثم: ﴿إِنِ الْحُكْمُ إِلَّا لِلَّهِ عَلَيْهِ تَوَكَّلْتُ﴾."}],"hadiths":[]},{"situationId":132,"verses":[{"i":2,"strength":"direct","bridge":"حتى في السجن دعا: ﴿إِنِ الْحُكْمُ إِلَّا لِلَّهِ أَمَرَ أَلَّا تَعْبُدُوا إِلَّا إِيَّاهُ﴾."}],"hadiths":[]},{"situationId":142,"verses":[{"i":1,"strength":"direct","bridge":"إذا استُعجلت النتائج: ﴿إِنِ الْحُكْمُ إِلَّا لِلَّهِ يَقُصُّ الْحَقَّ وَهُوَ خَيْرُ الْفَاصِلِينَ﴾."}],"hadiths":[]}]},{"id":304,"name":"إنما الغيب لله","compound":true,"meaning":"إنما الغيب لله: الغيب ومنه نزول الآيات بيد الله.","teaches":"1. ردٌّ على من طلب الآيات.","whenRecall":"- حين تطلب علامة.","whenPray":"1. فانتظر مع المنتظرين.","summary":"لا تطلب علامات؛ الغيب لله فانتظر.","verses":[{"i":1,"of":1,"s":10,"surah":"يونس","a":20,"text":"وَيَقُولُونَ لَوْلَا أُنْزِلَ عَلَيْهِ آيَةٌ مِنْ رَبِّهِ فَقُلْ إِنَّمَا الْغَيْبُ لِلَّهِ فَانْتَظِرُوا إِنِّي مَعَكُمْ مِنَ الْمُنْتَظِرِينَ","prev":{"a":19,"text":"وَمَا كَانَ النَّاسُ إِلَّا أُمَّةً وَاحِدَةً فَاخْتَلَفُوا وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِنْ رَبِّكَ لَقُضِيَ بَيْنَهُمْ فِيمَا فِيهِ يَخْتَلِفُونَ"},"next":{"a":21,"text":"وَإِذَا أَذَقْنَا النَّاسَ رَحْمَةً مِنْ بَعْدِ ضَرَّاءَ مَسَّتْهُمْ إِذَا لَهُمْ مَكْرٌ فِي آيَاتِنَا قُلِ اللَّهُ أَسْرَعُ مَكْرًا إِنَّ رُسُلَنَا يَكْتُبُونَ مَا تَمْكُرُونَ"},"context":"قبلها: كان الناس أمة واحدة فاختلفوا.","reason":"الآيات من الغيب."}],"hadiths":[],"situations":[{"situationId":113,"verses":[{"i":1,"strength":"direct","bridge":"إن انتظرت علامة: ﴿فَقُلْ إِنَّمَا الْغَيْبُ لِلَّهِ فَانْتَظِرُوا﴾."}],"hadiths":[]}]},{"id":305,"name":"فلله العزة جميعًا","compound":true,"meaning":"فلله العزة جميعًا: من أراد العزة فليطلبها بالطاعة.","teaches":"1. طريق العزة: الكلم الطيب والعمل الصالح.","whenRecall":"- حين تطلب المكانة.","whenPray":"1. اللهم أعزني بطاعتك.","summary":"العزة بالكلم الطيب والعمل الصالح.","verses":[{"i":1,"of":1,"s":35,"surah":"فاطر","a":10,"text":"مَنْ كَانَ يُرِيدُ الْعِزَّةَ فَلِلَّهِ الْعِزَّةُ جَمِيعًا إِلَيْهِ يَصْعَدُ الْكَلِمُ الطَّيِّبُ وَالْعَمَلُ الصَّالِحُ يَرْفَعُهُ وَالَّذِينَ يَمْكُرُونَ السَّيِّئَاتِ لَهُمْ عَذَابٌ شَدِيدٌ وَمَكْرُ أُولَئِكَ هُوَ يَبُورُ","prev":{"a":9,"text":"وَاللَّهُ الَّذِي أَرْسَلَ الرِّيَاحَ فَتُثِيرُ سَحَابًا فَسُقْنَاهُ إِلَى بَلَدٍ مَيِّتٍ فَأَحْيَيْنَا بِهِ الْأَرْضَ بَعْدَ مَوْتِهَا كَذَلِكَ النُّشُورُ"},"next":{"a":11,"text":"وَاللَّهُ خَلَقَكُمْ مِنْ تُرَابٍ ثُمَّ مِنْ نُطْفَةٍ ثُمَّ جَعَلَكُمْ أَزْوَاجًا وَمَا تَحْمِلُ مِنْ أُنْثَى وَلَا تَضَعُ إِلَّا بِعِلْمِهِ وَمَا يُعَمَّرُ مِنْ مُعَمَّرٍ وَلَا يُنْقَصُ مِنْ عُمُرِهِ إِلَّا فِي كِتَابٍ إِنَّ ذَلِكَ عَلَى اللَّهِ يَسِيرٌ"},"context":"قبلها: الرياح والسحاب وإحياء الأرض.","reason":"من أراد العزة فهي لله وحده."}],"hadiths":[],"situations":[{"situationId":81,"verses":[{"i":1,"strength":"direct","bridge":"طريق العزة: ﴿إِلَيْهِ يَصْعَدُ الْكَلِمُ الطَّيِّبُ وَالْعَمَلُ الصَّالِحُ يَرْفَعُهُ﴾."}],"hadiths":[]}]},{"id":306,"name":"ولله العزة","compound":true,"meaning":"ولله العزة ولرسوله وللمؤمنين: العزة لله ثم لمن أطاعه.","teaches":"1. ردٌّ على ابن سلول: ليخرجن الأعز منها الأذل.","whenRecall":"- حين يحتقرك أحد لدينك.","whenPray":"1. اللهم أعزنا بالإسلام.","summary":"عزتك بإيمانك.","verses":[{"i":1,"of":1,"s":63,"surah":"المنافقون","a":8,"text":"يَقُولُونَ لَئِنْ رَجَعْنَا إِلَى الْمَدِينَةِ لَيُخْرِجَنَّ الْأَعَزُّ مِنْهَا الْأَذَلَّ وَلِلَّهِ الْعِزَّةُ وَلِرَسُولِهِ وَلِلْمُؤْمِنِينَ وَلَكِنَّ الْمُنَافِقِينَ لَا يَعْلَمُونَ","prev":{"a":7,"text":"هُمُ الَّذِينَ يَقُولُونَ لَا تُنْفِقُوا عَلَى مَنْ عِنْدَ رَسُولِ اللَّهِ حَتَّى يَنْفَضُّوا وَلِلَّهِ خَزَائِنُ السَّمَاوَاتِ وَالْأَرْضِ وَلَكِنَّ الْمُنَافِقِينَ لَا يَفْقَهُونَ"},"next":{"a":9,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تُلْهِكُمْ أَمْوَالُكُمْ وَلَا أَوْلَادُكُمْ عَنْ ذِكْرِ اللَّهِ وَمَنْ يَفْعَلْ ذَلِكَ فَأُولَئِكَ هُمُ الْخَاسِرُونَ"},"context":"قبلها: هم الذين يقولون لا تنفقوا.","reason":"قلب ميزان العزة."}],"hadiths":[],"situations":[{"situationId":35,"verses":[{"i":1,"strength":"direct","bridge":"إن احتُقرت لدينك: ﴿وَلِلَّهِ الْعِزَّةُ وَلِرَسُولِهِ وَلِلْمُؤْمِنِينَ﴾."}],"hadiths":[]}]},{"id":307,"name":"فلله الحجة البالغة","compound":true,"meaning":"فلله الحجة البالغة: الحجة التامة لله.","teaches":"1. ردٌّ على الاحتجاج بالمشيئة على الشرك.","whenRecall":"- حين تحتج بالقدر على المعصية.","whenPray":"1. اللهم اهدني.","summary":"لا حجة للعاصي بالقدر؛ الحجة لله.","verses":[{"i":1,"of":1,"s":6,"surah":"الأنعام","a":149,"text":"قُلْ فَلِلَّهِ الْحُجَّةُ الْبَالِغَةُ فَلَوْ شَاءَ لَهَدَاكُمْ أَجْمَعِينَ","prev":{"a":148,"text":"سَيَقُولُ الَّذِينَ أَشْرَكُوا لَوْ شَاءَ اللَّهُ مَا أَشْرَكْنَا وَلَا آبَاؤُنَا وَلَا حَرَّمْنَا مِنْ شَيْءٍ كَذَلِكَ كَذَّبَ الَّذِينَ مِنْ قَبْلِهِمْ حَتَّى ذَاقُوا بَأْسَنَا قُلْ هَلْ عِنْدَكُمْ مِنْ عِلْمٍ فَتُخْرِجُوهُ لَنَا إِنْ تَتَّبِعُونَ إِلَّا الظَّنَّ وَإِنْ أَنْتُمْ إِلَّا تَخْرُصُونَ"},"next":{"a":150,"text":"قُلْ هَلُمَّ شُهَدَاءَكُمُ الَّذِينَ يَشْهَدُونَ أَنَّ اللَّهَ حَرَّمَ هَذَا فَإِنْ شَهِدُوا فَلَا تَشْهَدْ مَعَهُمْ وَلَا تَتَّبِعْ أَهْوَاءَ الَّذِينَ كَذَّبُوا بِآيَاتِنَا وَالَّذِينَ لَا يُؤْمِنُونَ بِالْآخِرَةِ وَهُمْ بِرَبِّهِمْ يَعْدِلُونَ"},"context":"قبلها: لو شاء الله ما أشركنا.","reason":"ردّ الاحتجاج بالقدر."}],"hadiths":[],"situations":[{"situationId":25,"verses":[{"i":1,"strength":"direct","bridge":"لا تحتج بالقدر: ﴿قُلْ فَلِلَّهِ الْحُجَّةُ الْبَالِغَةُ﴾."}],"hadiths":[]}]},{"id":308,"name":"وله ما سكن في الليل والنهار","compound":true,"meaning":"وله ما سكن في الليل والنهار: كل ما استقر في الزمان ملكه.","teaches":"1. مقرونة بالسميع العليم.","whenRecall":"- في سكون الليل.","whenPray":"1. يا سميع يا عليم، احفظني في ليلي ونهاري.","summary":"كل ساكن في ليلك ونهارك ملكه ويسمعه.","verses":[{"i":1,"of":1,"s":6,"surah":"الأنعام","a":13,"text":"وَلَهُ مَا سَكَنَ فِي اللَّيْلِ وَالنَّهَارِ وَهُوَ السَّمِيعُ الْعَلِيمُ","prev":{"a":12,"text":"قُلْ لِمَنْ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ قُلْ لِلَّهِ كَتَبَ عَلَى نَفْسِهِ الرَّحْمَةَ لَيَجْمَعَنَّكُمْ إِلَى يَوْمِ الْقِيَامَةِ لَا رَيْبَ فِيهِ الَّذِينَ خَسِرُوا أَنْفُسَهُمْ فَهُمْ لَا يُؤْمِنُونَ"},"next":{"a":14,"text":"قُلْ أَغَيْرَ اللَّهِ أَتَّخِذُ وَلِيًّا فَاطِرِ السَّمَاوَاتِ وَالْأَرْضِ وَهُوَ يُطْعِمُ وَلَا يُطْعَمُ قُلْ إِنِّي أُمِرْتُ أَنْ أَكُونَ أَوَّلَ مَنْ أَسْلَمَ وَلَا تَكُونَنَّ مِنَ الْمُشْرِكِينَ"},"context":"قبلها: كتب على نفسه الرحمة.","reason":"الملك في الزمان بعد المكان."}],"hadiths":[],"situations":[{"situationId":175,"verses":[{"i":1,"strength":"direct","bridge":"في سكون ليلك: ﴿وَلَهُ مَا سَكَنَ فِي اللَّيْلِ وَالنَّهَارِ وَهُوَ السَّمِيعُ الْعَلِيمُ﴾."}],"hadiths":[]}]},{"id":309,"name":"الأرض لله","compound":true,"meaning":"الأرض لله: يورثها من يشاء، والعاقبة للمتقين.","teaches":"1. قالها موسى لقومه أمام تهديد فرعون.\n2. الاستعانة والصبر.","whenRecall":"- حين يهددك ظالم بسلطانه.","whenPray":"1. اللهم أعني واصبرني.","summary":"استعن واصبر؛ فالأرض لله والعاقبة للمتقين.","verses":[{"i":1,"of":1,"s":7,"surah":"الأعراف","a":128,"text":"قَالَ مُوسَى لِقَوْمِهِ اسْتَعِينُوا بِاللَّهِ وَاصْبِرُوا إِنَّ الْأَرْضَ لِلَّهِ يُورِثُهَا مَنْ يَشَاءُ مِنْ عِبَادِهِ وَالْعَاقِبَةُ لِلْمُتَّقِينَ","prev":{"a":127,"text":"وَقَالَ الْمَلَأُ مِنْ قَوْمِ فِرْعَوْنَ أَتَذَرُ مُوسَى وَقَوْمَهُ لِيُفْسِدُوا فِي الْأَرْضِ وَيَذَرَكَ وَآلِهَتَكَ قَالَ سَنُقَتِّلُ أَبْنَاءَهُمْ وَنَسْتَحْيِي نِسَاءَهُمْ وَإِنَّا فَوْقَهُمْ قَاهِرُونَ"},"next":{"a":129,"text":"قَالُوا أُوذِينَا مِنْ قَبْلِ أَنْ تَأْتِيَنَا وَمِنْ بَعْدِ مَا جِئْتَنَا قَالَ عَسَى رَبُّكُمْ أَنْ يُهْلِكَ عَدُوَّكُمْ وَيَسْتَخْلِفَكُمْ فِي الْأَرْضِ فَيَنْظُرَ كَيْفَ تَعْمَلُونَ"},"context":"الملأ يحرّضون فرعون على موسى.","reason":"موسى يثبّت قومه بالاستعانة والصبر."}],"hadiths":[{"i":1,"of":1,"text":"بينَما نَحنُ في المَسجِدِ خَرَجَ النَّبيُّ صلَّى اللهُ عليه وسلَّم فقال: انطَلِقوا إلى يَهودَ، فخَرَجنا حتَّى جِئنا بَيتَ المِدراسِ، فقال: أسلِموا تَسلَموا، واعلَموا أنَّ الأرضَ للَّهِ ورَسولِه، وإنِّي أُريدُ أن أُجليَكُم مِن هذه الأرضِ، فمَن يَجِدْ مِنكُم بمالِه شيئًا فليَبِعْه، وإلَّا فاعلَموا أنَّ الأرضَ للَّهِ ورَسولِه.","narrator":"أبو هريرة","source":"صحيح البخاري 3167","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/gDiE9sWS","nameForm":"الأرض لله"}],"sunnah":{},"situations":[{"situationId":32,"verses":[{"i":1,"strength":"direct","bridge":"أمام تهديد الظالم: ﴿اسْتَعِينُوا بِاللَّهِ وَاصْبِرُوا إِنَّ الْأَرْضَ لِلَّهِ﴾."}],"hadiths":[]}]},{"id":310,"name":"فلله المكر جميعًا","compound":true,"meaning":"فلله المكر جميعًا: التدبير المحكم لله، ومكرهم لا يضر إلا بإذنه.","teaches":"1. يعلم ما تكسب كل نفس.","whenRecall":"- حين يمكر بك أحد.","whenPray":"1. اللهم امكر لي ولا تمكر علي.","summary":"مكرهم في علم الله وتدبيره.","verses":[{"i":1,"of":1,"s":13,"surah":"الرعد","a":42,"text":"وَقَدْ مَكَرَ الَّذِينَ مِنْ قَبْلِهِمْ فَلِلَّهِ الْمَكْرُ جَمِيعًا يَعْلَمُ مَا تَكْسِبُ كُلُّ نَفْسٍ وَسَيَعْلَمُ الْكُفَّارُ لِمَنْ عُقْبَى الدَّارِ","prev":{"a":41,"text":"أَوَلَمْ يَرَوْا أَنَّا نَأْتِي الْأَرْضَ نَنْقُصُهَا مِنْ أَطْرَافِهَا وَاللَّهُ يَحْكُمُ لَا مُعَقِّبَ لِحُكْمِهِ وَهُوَ سَرِيعُ الْحِسَابِ"},"next":{"a":43,"text":"وَيَقُولُ الَّذِينَ كَفَرُوا لَسْتَ مُرْسَلًا قُلْ كَفَى بِاللَّهِ شَهِيدًا بَيْنِي وَبَيْنَكُمْ وَمَنْ عِنْدَهُ عِلْمُ الْكِتَابِ"},"context":"قبلها: ننقص الأرض من أطرافها.","reason":"المكر كله بيد الله."}],"hadiths":[],"situations":[{"situationId":30,"verses":[{"i":1,"strength":"direct","bridge":"إن مُكر بك: ﴿فَلِلَّهِ الْمَكْرُ جَمِيعًا يَعْلَمُ مَا تَكْسِبُ كُلُّ نَفْسٍ﴾."}],"hadiths":[]}]},{"id":311,"name":"له ما بين أيدينا وما خلفنا وما بين ذلك","compound":true,"meaning":"له ما بين أيدينا وما خلفنا: الزمان كله ماضيه ومستقبله وحاضره ملكه.","teaches":"1. قالها جبريل حين أبطأ الوحي.","whenRecall":"- حين تقلق من المستقبل.","whenPray":"1. اللهم لك ما مضى وما يأتي.","summary":"الماضي والمستقبل والحاضر بيده.","verses":[{"i":1,"of":1,"s":19,"surah":"مريم","a":64,"text":"وَمَا نَتَنَزَّلُ إِلَّا بِأَمْرِ رَبِّكَ لَهُ مَا بَيْنَ أَيْدِينَا وَمَا خَلْفَنَا وَمَا بَيْنَ ذَلِكَ وَمَا كَانَ رَبُّكَ نَسِيًّا","prev":{"a":63,"text":"تِلْكَ الْجَنَّةُ الَّتِي نُورِثُ مِنْ عِبَادِنَا مَنْ كَانَ تَقِيًّا"},"next":{"a":65,"text":"رَبُّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا فَاعْبُدْهُ وَاصْطَبِرْ لِعِبَادَتِهِ هَلْ تَعْلَمُ لَهُ سَمِيًّا"},"context":"جواب جبريل عن إبطاء الوحي.","reason":"النزول بأمر من يملك الزمان كله."}],"hadiths":[{"i":1,"of":1,"text":"قال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ لِجِبريلَ: ما يَمنَعُكَ أنْ تَزورَنا أَكثَرَ ممَّا تَزورُنا؟ قال: فنزَلَت: {وَمَا نَتَنَزَّلُ إلَّا بِأَمْرِ رَبِّكَ لَهُ مَا بَيْنَ أَيْدِينَا وَمَا خَلْفَنَا وَمَا بَيْنَ ذَلِكَ وَمَا كَانَ رَبُّكَ نَسِيًّا} [مريم: 64] قال: وكان ذلك الجَوابُ لِمحمدٍ صلَّى اللهُ عليه وسلَّمَ.","narrator":"عبدالله بن عباس","source":"تخريج المسند لشعيب 3365","grade":"صحيح","judgment":"إسناده صحيح على شرط البخاري","url":"https://dorar.net/h/cG7M28Xa","nameForm":"له ما بين أيدينا وما خلفنا وما بين ذلك"}],"sunnah":{},"situations":[{"situationId":10,"verses":[{"i":1,"strength":"direct","bridge":"ما مضى وما يأتي له: ﴿لَهُ مَا بَيْنَ أَيْدِينَا وَمَا خَلْفَنَا وَمَا بَيْنَ ذَلِكَ﴾."}],"hadiths":[]}]},{"id":312,"name":"وله من في السماوات والأرض","compound":true,"meaning":"وله من في السماوات والأرض: الخلق كلهم عبيده قانتون له.","teaches":"1. الملائكة لا يستكبرون عن عبادته.","whenRecall":"- حين تثقل عليك العبادة.","whenPray":"1. اللهم اجعلني من القانتين.","summary":"الكون كله يعبده؛ فلا تكن النشاز.","verses":[{"i":1,"of":2,"s":21,"surah":"الأنبياء","a":19,"text":"وَلَهُ مَنْ فِي السَّمَاوَاتِ وَالْأَرْضِ وَمَنْ عِنْدَهُ لَا يَسْتَكْبِرُونَ عَنْ عِبَادَتِهِ وَلَا يَسْتَحْسِرُونَ","prev":{"a":18,"text":"بَلْ نَقْذِفُ بِالْحَقِّ عَلَى الْبَاطِلِ فَيَدْمَغُهُ فَإِذَا هُوَ زَاهِقٌ وَلَكُمُ الْوَيْلُ مِمَّا تَصِفُونَ"},"next":{"a":20,"text":"يُسَبِّحُونَ اللَّيْلَ وَالنَّهَارَ لَا يَفْتُرُونَ"},"context":"قبلها: نقذف بالحق على الباطل فيدمغه.","reason":"الملائكة لا يستكبرون ولا يستحسرون."},{"i":2,"of":2,"s":30,"surah":"الروم","a":26,"text":"وَلَهُ مَنْ فِي السَّمَاوَاتِ وَالْأَرْضِ كُلٌّ لَهُ قَانِتُونَ","prev":{"a":25,"text":"وَمِنْ آيَاتِهِ أَنْ تَقُومَ السَّمَاءُ وَالْأَرْضُ بِأَمْرِهِ ثُمَّ إِذَا دَعَاكُمْ دَعْوَةً مِنَ الْأَرْضِ إِذَا أَنْتُمْ تَخْرُجُونَ"},"next":{"a":27,"text":"وَهُوَ الَّذِي يَبْدَأُ الْخَلْقَ ثُمَّ يُعِيدُهُ وَهُوَ أَهْوَنُ عَلَيْهِ وَلَهُ الْمَثَلُ الْأَعْلَى فِي السَّمَاوَاتِ وَالْأَرْضِ وَهُوَ الْعَزِيزُ الْحَكِيمُ"},"context":"قبلها: قيام السماء والأرض بأمره.","reason":"كل شيء قانت."}],"hadiths":[],"situations":[{"situationId":78,"verses":[{"i":1,"strength":"direct","bridge":"إذا تعبت من العبادة فتذكر: ﴿لَا يَسْتَكْبِرُونَ عَنْ عِبَادَتِهِ وَلَا يَسْتَحْسِرُونَ﴾."}],"hadiths":[]},{"situationId":174,"verses":[{"i":2,"strength":"direct","bridge":"﴿وَلَهُ مَنْ فِي السَّمَاوَاتِ وَالْأَرْضِ كُلٌّ لَهُ قَانِتُونَ﴾."}],"hadiths":[]}]},{"id":313,"name":"فلله الآخرة والأولى","compound":true,"meaning":"فلله الآخرة والأولى: الدنيا والآخرة ملكه، لا تنال بالتمني.","teaches":"1. جاءت بعد: أم للإنسان ما تمنى؟","whenRecall":"- حين تكثر أمانيك.","whenPray":"1. اللهم آتني في الدنيا حسنة وفي الآخرة حسنة.","summary":"الأماني لا تملك شيئًا؛ الدارين لله.","verses":[{"i":1,"of":1,"s":53,"surah":"النجم","a":25,"text":"فَلِلَّهِ الْآخِرَةُ وَالْأُولَى","prev":{"a":24,"text":"أَمْ لِلْإِنْسَانِ مَا تَمَنَّى"},"next":{"a":26,"text":"وَكَمْ مِنْ مَلَكٍ فِي السَّمَاوَاتِ لَا تُغْنِي شَفَاعَتُهُمْ شَيْئًا إِلَّا مِنْ بَعْدِ أَنْ يَأْذَنَ اللَّهُ لِمَنْ يَشَاءُ وَيَرْضَى"},"context":"قبلها: أم للإنسان ما تمنى.","reason":"ردّ على الأماني."}],"hadiths":[],"situations":[{"situationId":89,"verses":[{"i":1,"strength":"direct","bridge":"لا تعش على الأماني: ﴿فَلِلَّهِ الْآخِرَةُ وَالْأُولَى﴾."}],"hadiths":[]}]},{"id":314,"name":"وله الجوار المنشآت في البحر كالأعلام","compound":true,"meaning":"وله الجوار المنشآت: السفن الكبيرة كالجبال ملكه وتسخيره.","teaches":"1. في سورة الرحمن بين آلاء الله.","whenRecall":"- عند ركوب البحر.","whenPray":"1. سبحان الذي سخر لنا هذا.","summary":"السفن كالجبال من آلائه.","verses":[{"i":1,"of":1,"s":55,"surah":"الرحمن","a":24,"text":"وَلَهُ الْجَوَارِ الْمُنْشَآتُ فِي الْبَحْرِ كَالْأَعْلَامِ","prev":{"a":23,"text":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},"next":{"a":25,"text":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},"context":"بين: فبأي آلاء ربكما تكذبان.","reason":"تعداد النعم."}],"hadiths":[],"situations":[{"situationId":175,"verses":[{"i":1,"strength":"direct","bridge":"إذا ركبت البحر: ﴿وَلَهُ الْجَوَارِ الْمُنْشَآتُ فِي الْبَحْرِ كَالْأَعْلَامِ﴾."}],"hadiths":[]}]},{"id":315,"name":"بصير بما يعملون","compound":true,"meaning":"بصير بما يعملون: يرى أعمالهم كلها، لا يغيب عنه منها شيء.","teaches":"1. تأتي بعد وصف حال قومٍ: حرصهم على الحياة، أو تفاوت درجاتهم، أو عماهم بعد التوبة.","whenRecall":"- حين يطول عمرك وتؤجل العمل.","whenPray":"1. اللهم اجعل عملي مما يسرّني أن تراه.","summary":"طول العمر لا يزحزح عن العذاب؛ والله يرى العمل.","verses":[{"i":1,"of":3,"s":2,"surah":"البقرة","a":96,"text":"وَلَتَجِدَنَّهُمْ أَحْرَصَ النَّاسِ عَلَى حَيَاةٍ وَمِنَ الَّذِينَ أَشْرَكُوا يَوَدُّ أَحَدُهُمْ لَوْ يُعَمَّرُ أَلْفَ سَنَةٍ وَمَا هُوَ بِمُزَحْزِحِهِ مِنَ الْعَذَابِ أَنْ يُعَمَّرَ وَاللَّهُ بَصِيرٌ بِمَا يَعْمَلُونَ","prev":{"a":95,"text":"وَلَنْ يَتَمَنَّوْهُ أَبَدًا بِمَا قَدَّمَتْ أَيْدِيهِمْ وَاللَّهُ عَلِيمٌ بِالظَّالِمِينَ"},"next":{"a":97,"text":"قُلْ مَنْ كَانَ عَدُوًّا لِجِبْرِيلَ فَإِنَّهُ نَزَّلَهُ عَلَى قَلْبِكَ بِإِذْنِ اللَّهِ مُصَدِّقًا لِمَا بَيْنَ يَدَيْهِ وَهُدًى وَبُشْرَى لِلْمُؤْمِنِينَ"},"context":"قبلها: لن يتمنوا الموت بما قدمت أيديهم.","reason":"الحرص على العمر لا ينفع، والله بصير بعملهم."},{"i":2,"of":3,"s":3,"surah":"آل عمران","a":163,"text":"هُمْ دَرَجَاتٌ عِنْدَ اللَّهِ وَاللَّهُ بَصِيرٌ بِمَا يَعْمَلُونَ","prev":{"a":162,"text":"أَفَمَنِ اتَّبَعَ رِضْوَانَ اللَّهِ كَمَنْ بَاءَ بِسَخَطٍ مِنَ اللَّهِ وَمَأْوَاهُ جَهَنَّمُ وَبِئْسَ الْمَصِيرُ"},"next":{"a":164,"text":"لَقَدْ مَنَّ اللَّهُ عَلَى الْمُؤْمِنِينَ إِذْ بَعَثَ فِيهِمْ رَسُولًا مِنْ أَنْفُسِهِمْ يَتْلُو عَلَيْهِمْ آيَاتِهِ وَيُزَكِّيهِمْ وَيُعَلِّمُهُمُ الْكِتَابَ وَالْحِكْمَةَ وَإِنْ كَانُوا مِنْ قَبْلُ لَفِي ضَلَالٍ مُبِينٍ"},"context":"قبلها: أفمن اتبع رضوان الله كمن باء بسخط.","reason":"الناس درجات عند الله بحسب أعمالهم."},{"i":3,"of":3,"s":5,"surah":"المائدة","a":71,"text":"وَحَسِبُوا أَلَّا تَكُونَ فِتْنَةٌ فَعَمُوا وَصَمُّوا ثُمَّ تَابَ اللَّهُ عَلَيْهِمْ ثُمَّ عَمُوا وَصَمُّوا كَثِيرٌ مِنْهُمْ وَاللَّهُ بَصِيرٌ بِمَا يَعْمَلُونَ","prev":{"a":70,"text":"لَقَدْ أَخَذْنَا مِيثَاقَ بَنِي إِسْرَائِيلَ وَأَرْسَلْنَا إِلَيْهِمْ رُسُلًا كُلَّمَا جَاءَهُمْ رَسُولٌ بِمَا لَا تَهْوَى أَنْفُسُهُمْ فَرِيقًا كَذَّبُوا وَفَرِيقًا يَقْتُلُونَ"},"next":{"a":72,"text":"لَقَدْ كَفَرَ الَّذِينَ قَالُوا إِنَّ اللَّهَ هُوَ الْمَسِيحُ ابْنُ مَرْيَمَ وَقَالَ الْمَسِيحُ يَا بَنِي إِسْرَائِيلَ اعْبُدُوا اللَّهَ رَبِّي وَرَبَّكُمْ إِنَّهُ مَنْ يُشْرِكْ بِاللَّهِ فَقَدْ حَرَّمَ اللَّهُ عَلَيْهِ الْجَنَّةَ وَمَأْوَاهُ النَّارُ وَمَا لِلظَّالِمِينَ مِنْ أَنْصَارٍ"},"context":"بنو إسرائيل قتلوا الأنبياء وكذبوهم.","reason":"عموا وصموا، ثم تاب الله عليهم، ثم عادوا."}],"hadiths":[],"situations":[{"situationId":16,"verses":[{"i":3,"strength":"direct","bridge":"إذا تاب الله عليك فلا تعد: ﴿ثُمَّ تَابَ اللَّهُ عَلَيْهِمْ ثُمَّ عَمُوا وَصَمُّوا﴾."}],"hadiths":[]},{"situationId":172,"verses":[{"i":2,"strength":"direct","bridge":"لا تستوي الأعمال: ﴿هُمْ دَرَجَاتٌ عِنْدَ اللَّهِ وَاللَّهُ بَصِيرٌ بِمَا يَعْمَلُونَ﴾."}],"hadiths":[]},{"situationId":182,"verses":[{"i":1,"strength":"direct","bridge":"طول العمر بلا عمل لا ينجي: ﴿وَمَا هُوَ بِمُزَحْزِحِهِ مِنَ الْعَذَابِ أَنْ يُعَمَّرَ﴾."}],"hadiths":[]}]},{"id":316,"name":"بصير بما تعملون","compound":true,"meaning":"بصير بما تعملون: يرى أعمالكم، فلا تمنّوا عليه بها.","teaches":"1. ختام الحجرات بعد ذكر من يمنّون بإسلامهم.","whenRecall":"- حين تمنّ بطاعتك.","whenPray":"1. اللهم لك المنة علي.","summary":"المنة لله عليك بالهداية، وهو يرى عملك.","verses":[{"i":1,"of":1,"s":49,"surah":"الحجرات","a":18,"text":"إِنَّ اللَّهَ يَعْلَمُ غَيْبَ السَّمَاوَاتِ وَالْأَرْضِ وَاللَّهُ بَصِيرٌ بِمَا تَعْمَلُونَ","prev":{"a":17,"text":"يَمُنُّونَ عَلَيْكَ أَنْ أَسْلَمُوا قُلْ لَا تَمُنُّوا عَلَيَّ إِسْلَامَكُمْ بَلِ اللَّهُ يَمُنُّ عَلَيْكُمْ أَنْ هَدَاكُمْ لِلْإِيمَانِ إِنْ كُنْتُمْ صَادِقِينَ"},"context":"قبلها: يمنون عليك أن أسلموا.","reason":"ردّ المنّ: الله يعلم الغيب ويرى العمل."}],"hadiths":[],"situations":[{"situationId":82,"verses":[{"i":1,"strength":"direct","bridge":"لا تمنّ بعملك: ﴿إِنَّ اللَّهَ يَعْلَمُ غَيْبَ السَّمَاوَاتِ وَالْأَرْضِ وَاللَّهُ بَصِيرٌ بِمَا تَعْمَلُونَ﴾."}],"hadiths":[]}]},{"id":317,"name":"بما تعملون بصير","compound":true,"meaning":"بما تعملون بصير: كل عمل تقدمه مرئيٌّ لله، وتجده عنده.","teaches":"1. تأتي في الأحكام: الرضاع، والطلاق، والإنفاق، والجهاد.\n2. وفي الأمر بالاستقامة.\n3. تقديم «بما تعملون» يؤكد الإحاطة بالعمل.","whenRecall":"- عند العبادة في السر.\n- عند الخلاف الأسري.\n- عند الإنفاق.","whenPray":"1. اللهم أعني على الاستقامة كما أمرت.","summary":"ما تقدمه من خير تجده، والله بصير به.","verses":[{"i":1,"of":14,"s":2,"surah":"البقرة","a":110,"text":"وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ وَمَا تُقَدِّمُوا لِأَنْفُسِكُمْ مِنْ خَيْرٍ تَجِدُوهُ عِنْدَ اللَّهِ إِنَّ اللَّهَ بِمَا تَعْمَلُونَ بَصِيرٌ","prev":{"a":109,"text":"وَدَّ كَثِيرٌ مِنْ أَهْلِ الْكِتَابِ لَوْ يَرُدُّونَكُمْ مِنْ بَعْدِ إِيمَانِكُمْ كُفَّارًا حَسَدًا مِنْ عِنْدِ أَنْفُسِهِمْ مِنْ بَعْدِ مَا تَبَيَّنَ لَهُمُ الْحَقُّ فَاعْفُوا وَاصْفَحُوا حَتَّى يَأْتِيَ اللَّهُ بِأَمْرِهِ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},"next":{"a":111,"text":"وَقَالُوا لَنْ يَدْخُلَ الْجَنَّةَ إِلَّا مَنْ كَانَ هُودًا أَوْ نَصَارَى تِلْكَ أَمَانِيُّهُمْ قُلْ هَاتُوا بُرْهَانَكُمْ إِنْ كُنْتُمْ صَادِقِينَ"},"context":"قبلها: ود كثير من أهل الكتاب لو يردونكم كفارًا.","reason":"الأمر بالصلاة والزكاة، وما تقدمه تجده."},{"i":2,"of":14,"s":2,"surah":"البقرة","a":233,"text":"وَالْوَالِدَاتُ يُرْضِعْنَ أَوْلَادَهُنَّ حَوْلَيْنِ كَامِلَيْنِ لِمَنْ أَرَادَ أَنْ يُتِمَّ الرَّضَاعَةَ وَعَلَى الْمَوْلُودِ لَهُ رِزْقُهُنَّ وَكِسْوَتُهُنَّ بِالْمَعْرُوفِ لَا تُكَلَّفُ نَفْسٌ إِلَّا وُسْعَهَا لَا تُضَارَّ وَالِدَةٌ بِوَلَدِهَا وَلَا مَوْلُودٌ لَهُ بِوَلَدِهِ وَعَلَى الْوَارِثِ مِثْلُ ذَلِكَ فَإِنْ أَرَادَا فِصَالًا عَنْ تَرَاضٍ مِنْهُمَا وَتَشَاوُرٍ فَلَا جُنَاحَ عَلَيْهِمَا وَإِنْ أَرَدْتُمْ أَنْ تَسْتَرْضِعُوا أَوْلَادَكُمْ فَلَا جُنَاحَ عَلَيْكُمْ إِذَا سَلَّمْتُمْ مَا آتَيْتُمْ بِالْمَعْرُوفِ وَاتَّقُوا اللَّهَ وَاعْلَمُوا أَنَّ اللَّهَ بِمَا تَعْمَلُونَ بَصِيرٌ","prev":{"a":232,"text":"وَإِذَا طَلَّقْتُمُ النِّسَاءَ فَبَلَغْنَ أَجَلَهُنَّ فَلَا تَعْضُلُوهُنَّ أَنْ يَنْكِحْنَ أَزْوَاجَهُنَّ إِذَا تَرَاضَوْا بَيْنَهُمْ بِالْمَعْرُوفِ ذَلِكَ يُوعَظُ بِهِ مَنْ كَانَ مِنْكُمْ يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الْآخِرِ ذَلِكُمْ أَزْكَى لَكُمْ وَأَطْهَرُ وَاللَّهُ يَعْلَمُ وَأَنْتُمْ لَا تَعْلَمُونَ"},"next":{"a":234,"text":"وَالَّذِينَ يُتَوَفَّوْنَ مِنْكُمْ وَيَذَرُونَ أَزْوَاجًا يَتَرَبَّصْنَ بِأَنْفُسِهِنَّ أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا فَإِذَا بَلَغْنَ أَجَلَهُنَّ فَلَا جُنَاحَ عَلَيْكُمْ فِيمَا فَعَلْنَ فِي أَنْفُسِهِنَّ بِالْمَعْرُوفِ وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ"},"context":"أحكام الرضاع بعد الطلاق.","reason":"لا تكلَّف نفس إلا وسعها، ولا مضارة بالولد."},{"i":3,"of":14,"s":2,"surah":"البقرة","a":237,"text":"وَإِنْ طَلَّقْتُمُوهُنَّ مِنْ قَبْلِ أَنْ تَمَسُّوهُنَّ وَقَدْ فَرَضْتُمْ لَهُنَّ فَرِيضَةً فَنِصْفُ مَا فَرَضْتُمْ إِلَّا أَنْ يَعْفُونَ أَوْ يَعْفُوَ الَّذِي بِيَدِهِ عُقْدَةُ النِّكَاحِ وَأَنْ تَعْفُوا أَقْرَبُ لِلتَّقْوَى وَلَا تَنْسَوُا الْفَضْلَ بَيْنَكُمْ إِنَّ اللَّهَ بِمَا تَعْمَلُونَ بَصِيرٌ","prev":{"a":236,"text":"لَا جُنَاحَ عَلَيْكُمْ إِنْ طَلَّقْتُمُ النِّسَاءَ مَا لَمْ تَمَسُّوهُنَّ أَوْ تَفْرِضُوا لَهُنَّ فَرِيضَةً وَمَتِّعُوهُنَّ عَلَى الْمُوسِعِ قَدَرُهُ وَعَلَى الْمُقْتِرِ قَدَرُهُ مَتَاعًا بِالْمَعْرُوفِ حَقًّا عَلَى الْمُحْسِنِينَ"},"next":{"a":238,"text":"حَافِظُوا عَلَى الصَّلَوَاتِ وَالصَّلَاةِ الْوُسْطَى وَقُومُوا لِلَّهِ قَانِتِينَ"},"context":"الطلاق قبل الدخول وحقوق المهر.","reason":"العفو أقرب للتقوى، ولا تنسوا الفضل."},{"i":4,"of":14,"s":2,"surah":"البقرة","a":265,"text":"وَمَثَلُ الَّذِينَ يُنْفِقُونَ أَمْوَالَهُمُ ابْتِغَاءَ مَرْضَاتِ اللَّهِ وَتَثْبِيتًا مِنْ أَنْفُسِهِمْ كَمَثَلِ جَنَّةٍ بِرَبْوَةٍ أَصَابَهَا وَابِلٌ فَآتَتْ أُكُلَهَا ضِعْفَيْنِ فَإِنْ لَمْ يُصِبْهَا وَابِلٌ فَطَلٌّ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ","prev":{"a":264,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تُبْطِلُوا صَدَقَاتِكُمْ بِالْمَنِّ وَالْأَذَى كَالَّذِي يُنْفِقُ مَالَهُ رِئَاءَ النَّاسِ وَلَا يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الْآخِرِ فَمَثَلُهُ كَمَثَلِ صَفْوَانٍ عَلَيْهِ تُرَابٌ فَأَصَابَهُ وَابِلٌ فَتَرَكَهُ صَلْدًا لَا يَقْدِرُونَ عَلَى شَيْءٍ مِمَّا كَسَبُوا وَاللَّهُ لَا يَهْدِي الْقَوْمَ الْكَافِرِينَ"},"next":{"a":266,"text":"أَيَوَدُّ أَحَدُكُمْ أَنْ تَكُونَ لَهُ جَنَّةٌ مِنْ نَخِيلٍ وَأَعْنَابٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ لَهُ فِيهَا مِنْ كُلِّ الثَّمَرَاتِ وَأَصَابَهُ الْكِبَرُ وَلَهُ ذُرِّيَّةٌ ضُعَفَاءُ فَأَصَابَهَا إِعْصَارٌ فِيهِ نَارٌ فَاحْتَرَقَتْ كَذَلِكَ يُبَيِّنُ اللَّهُ لَكُمُ الْآيَاتِ لَعَلَّكُمْ تَتَفَكَّرُونَ"},"context":"قبلها: لا تبطلوا صدقاتكم بالمن والأذى.","reason":"مثل المنفق ابتغاء مرضاة الله."},{"i":5,"of":14,"s":3,"surah":"آل عمران","a":156,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَكُونُوا كَالَّذِينَ كَفَرُوا وَقَالُوا لِإِخْوَانِهِمْ إِذَا ضَرَبُوا فِي الْأَرْضِ أَوْ كَانُوا غُزًّى لَوْ كَانُوا عِنْدَنَا مَا مَاتُوا وَمَا قُتِلُوا لِيَجْعَلَ اللَّهُ ذَلِكَ حَسْرَةً فِي قُلُوبِهِمْ وَاللَّهُ يُحْيِي وَيُمِيتُ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ","prev":{"a":155,"text":"إِنَّ الَّذِينَ تَوَلَّوْا مِنْكُمْ يَوْمَ الْتَقَى الْجَمْعَانِ إِنَّمَا اسْتَزَلَّهُمُ الشَّيْطَانُ بِبَعْضِ مَا كَسَبُوا وَلَقَدْ عَفَا اللَّهُ عَنْهُمْ إِنَّ اللَّهَ غَفُورٌ حَلِيمٌ"},"next":{"a":157,"text":"وَلَئِنْ قُتِلْتُمْ فِي سَبِيلِ اللَّهِ أَوْ مُتُّمْ لَمَغْفِرَةٌ مِنَ اللَّهِ وَرَحْمَةٌ خَيْرٌ مِمَّا يَجْمَعُونَ"},"context":"بعد أحد: من تولوا يوم التقى الجمعان.","reason":"لا تقولوا لو كانوا عندنا ما ماتوا."},{"i":6,"of":14,"s":8,"surah":"الأنفال","a":72,"text":"إِنَّ الَّذِينَ آمَنُوا وَهَاجَرُوا وَجَاهَدُوا بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ فِي سَبِيلِ اللَّهِ وَالَّذِينَ آوَوْا وَنَصَرُوا أُولَئِكَ بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ وَالَّذِينَ آمَنُوا وَلَمْ يُهَاجِرُوا مَا لَكُمْ مِنْ وَلَايَتِهِمْ مِنْ شَيْءٍ حَتَّى يُهَاجِرُوا وَإِنِ اسْتَنْصَرُوكُمْ فِي الدِّينِ فَعَلَيْكُمُ النَّصْرُ إِلَّا عَلَى قَوْمٍ بَيْنَكُمْ وَبَيْنَهُمْ مِيثَاقٌ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ","prev":{"a":71,"text":"وَإِنْ يُرِيدُوا خِيَانَتَكَ فَقَدْ خَانُوا اللَّهَ مِنْ قَبْلُ فَأَمْكَنَ مِنْهُمْ وَاللَّهُ عَلِيمٌ حَكِيمٌ"},"next":{"a":73,"text":"وَالَّذِينَ كَفَرُوا بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ إِلَّا تَفْعَلُوهُ تَكُنْ فِتْنَةٌ فِي الْأَرْضِ وَفَسَادٌ كَبِيرٌ"},"context":"ختام الأنفال: الولاء بين المهاجرين والأنصار.","reason":"الولاية بالإيمان والهجرة والنصرة."},{"i":7,"of":14,"s":11,"surah":"هود","a":112,"text":"فَاسْتَقِمْ كَمَا أُمِرْتَ وَمَنْ تَابَ مَعَكَ وَلَا تَطْغَوْا إِنَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ","prev":{"a":111,"text":"وَإِنَّ كُلًّا لَمَّا لَيُوَفِّيَنَّهُمْ رَبُّكَ أَعْمَالَهُمْ إِنَّهُ بِمَا يَعْمَلُونَ خَبِيرٌ"},"next":{"a":113,"text":"وَلَا تَرْكَنُوا إِلَى الَّذِينَ ظَلَمُوا فَتَمَسَّكُمُ النَّارُ وَمَا لَكُمْ مِنْ دُونِ اللَّهِ مِنْ أَوْلِيَاءَ ثُمَّ لَا تُنْصَرُونَ"},"context":"قبلها: ليوفينهم ربك أعمالهم.","reason":"الأمر بالاستقامة ونهي عن الطغيان."},{"i":8,"of":14,"s":33,"surah":"الأحزاب","a":9,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اذْكُرُوا نِعْمَةَ اللَّهِ عَلَيْكُمْ إِذْ جَاءَتْكُمْ جُنُودٌ فَأَرْسَلْنَا عَلَيْهِمْ رِيحًا وَجُنُودًا لَمْ تَرَوْهَا وَكَانَ اللَّهُ بِمَا تَعْمَلُونَ بَصِيرًا","prev":{"a":8,"text":"لِيَسْأَلَ الصَّادِقِينَ عَنْ صِدْقِهِمْ وَأَعَدَّ لِلْكَافِرِينَ عَذَابًا أَلِيمًا"},"next":{"a":10,"text":"إِذْ جَاءُوكُمْ مِنْ فَوْقِكُمْ وَمِنْ أَسْفَلَ مِنْكُمْ وَإِذْ زَاغَتِ الْأَبْصَارُ وَبَلَغَتِ الْقُلُوبُ الْحَنَاجِرَ وَتَظُنُّونَ بِاللَّهِ الظُّنُونَا"},"context":"غزوة الأحزاب.","reason":"تذكير بنعمة الريح والجنود يوم الأحزاب."},{"i":9,"of":14,"s":34,"surah":"سبأ","a":11,"text":"أَنِ اعْمَلْ سَابِغَاتٍ وَقَدِّرْ فِي السَّرْدِ وَاعْمَلُوا صَالِحًا إِنِّي بِمَا تَعْمَلُونَ بَصِيرٌ","prev":{"a":10,"text":"وَلَقَدْ آتَيْنَا دَاوُودَ مِنَّا فَضْلًا يَا جِبَالُ أَوِّبِي مَعَهُ وَالطَّيْرَ وَأَلَنَّا لَهُ الْحَدِيدَ"},"next":{"a":12,"text":"وَلِسُلَيْمَانَ الرِّيحَ غُدُوُّهَا شَهْرٌ وَرَوَاحُهَا شَهْرٌ وَأَسَلْنَا لَهُ عَيْنَ الْقِطْرِ وَمِنَ الْجِنِّ مَنْ يَعْمَلُ بَيْنَ يَدَيْهِ بِإِذْنِ رَبِّهِ وَمَنْ يَزِغْ مِنْهُمْ عَنْ أَمْرِنَا نُذِقْهُ مِنْ عَذَابِ السَّعِيرِ"},"context":"داود يُعلَّم صنعة الدروع.","reason":"إتقان العمل مع العمل الصالح."},{"i":10,"of":14,"s":41,"surah":"فصلت","a":40,"text":"إِنَّ الَّذِينَ يُلْحِدُونَ فِي آيَاتِنَا لَا يَخْفَوْنَ عَلَيْنَا أَفَمَنْ يُلْقَى فِي النَّارِ خَيْرٌ أَمْ مَنْ يَأْتِي آمِنًا يَوْمَ الْقِيَامَةِ اعْمَلُوا مَا شِئْتُمْ إِنَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ","prev":{"a":39,"text":"وَمِنْ آيَاتِهِ أَنَّكَ تَرَى الْأَرْضَ خَاشِعَةً فَإِذَا أَنْزَلْنَا عَلَيْهَا الْمَاءَ اهْتَزَّتْ وَرَبَتْ إِنَّ الَّذِي أَحْيَاهَا لَمُحْيِي الْمَوْتَى إِنَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},"next":{"a":41,"text":"إِنَّ الَّذِينَ كَفَرُوا بِالذِّكْرِ لَمَّا جَاءَهُمْ وَإِنَّهُ لَكِتَابٌ عَزِيزٌ"},"context":"الملحدون في آيات الله.","reason":"تهديد: اعملوا ما شئتم."},{"i":11,"of":14,"s":48,"surah":"الفتح","a":24,"text":"وَهُوَ الَّذِي كَفَّ أَيْدِيَهُمْ عَنْكُمْ وَأَيْدِيَكُمْ عَنْهُمْ بِبَطْنِ مَكَّةَ مِنْ بَعْدِ أَنْ أَظْفَرَكُمْ عَلَيْهِمْ وَكَانَ اللَّهُ بِمَا تَعْمَلُونَ بَصِيرًا","prev":{"a":23,"text":"سُنَّةَ اللَّهِ الَّتِي قَدْ خَلَتْ مِنْ قَبْلُ وَلَنْ تَجِدَ لِسُنَّةِ اللَّهِ تَبْدِيلًا"},"next":{"a":25,"text":"هُمُ الَّذِينَ كَفَرُوا وَصَدُّوكُمْ عَنِ الْمَسْجِدِ الْحَرَامِ وَالْهَدْيَ مَعْكُوفًا أَنْ يَبْلُغَ مَحِلَّهُ وَلَوْلَا رِجَالٌ مُؤْمِنُونَ وَنِسَاءٌ مُؤْمِنَاتٌ لَمْ تَعْلَمُوهُمْ أَنْ تَطَئُوهُمْ فَتُصِيبَكُمْ مِنْهُمْ مَعَرَّةٌ بِغَيْرِ عِلْمٍ لِيُدْخِلَ اللَّهُ فِي رَحْمَتِهِ مَنْ يَشَاءُ لَوْ تَزَيَّلُوا لَعَذَّبْنَا الَّذِينَ كَفَرُوا مِنْهُمْ عَذَابًا أَلِيمًا"},"context":"صلح الحديبية.","reason":"كفّ الأيدي ببطن مكة بعد الظفر."},{"i":12,"of":14,"s":57,"surah":"الحديد","a":4,"text":"هُوَ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ فِي سِتَّةِ أَيَّامٍ ثُمَّ اسْتَوَى عَلَى الْعَرْشِ يَعْلَمُ مَا يَلِجُ فِي الْأَرْضِ وَمَا يَخْرُجُ مِنْهَا وَمَا يَنْزِلُ مِنَ السَّمَاءِ وَمَا يَعْرُجُ فِيهَا وَهُوَ مَعَكُمْ أَيْنَ مَا كُنْتُمْ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ","prev":{"a":3,"text":"هُوَ الْأَوَّلُ وَالْآخِرُ وَالظَّاهِرُ وَالْبَاطِنُ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ"},"next":{"a":5,"text":"لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ"},"context":"قبلها: هو الأول والآخر والظاهر والباطن.","reason":"علمه بما يلج ويخرج، ومعيته."},{"i":13,"of":14,"s":60,"surah":"الممتحنة","a":3,"text":"لَنْ تَنْفَعَكُمْ أَرْحَامُكُمْ وَلَا أَوْلَادُكُمْ يَوْمَ الْقِيَامَةِ يَفْصِلُ بَيْنَكُمْ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ","prev":{"a":2,"text":"إِنْ يَثْقَفُوكُمْ يَكُونُوا لَكُمْ أَعْدَاءً وَيَبْسُطُوا إِلَيْكُمْ أَيْدِيَهُمْ وَأَلْسِنَتَهُمْ بِالسُّوءِ وَوَدُّوا لَوْ تَكْفُرُونَ"},"next":{"a":4,"text":"قَدْ كَانَتْ لَكُمْ أُسْوَةٌ حَسَنَةٌ فِي إِبْرَاهِيمَ وَالَّذِينَ مَعَهُ إِذْ قَالُوا لِقَوْمِهِمْ إِنَّا بُرَآءُ مِنْكُمْ وَمِمَّا تَعْبُدُونَ مِنْ دُونِ اللَّهِ كَفَرْنَا بِكُمْ وَبَدَا بَيْنَنَا وَبَيْنَكُمُ الْعَدَاوَةُ وَالْبَغْضَاءُ أَبَدًا حَتَّى تُؤْمِنُوا بِاللَّهِ وَحْدَهُ إِلَّا قَوْلَ إِبْرَاهِيمَ لِأَبِيهِ لَأَسْتَغْفِرَنَّ لَكَ وَمَا أَمْلِكُ لَكَ مِنَ اللَّهِ مِنْ شَيْءٍ رَبَّنَا عَلَيْكَ تَوَكَّلْنَا وَإِلَيْكَ أَنَبْنَا وَإِلَيْكَ الْمَصِيرُ"},"context":"حاطب بن أبي بلتعة ومكاتبة قريش.","reason":"الأرحام والأولاد لا تنفع يوم القيامة."},{"i":14,"of":14,"s":64,"surah":"التغابن","a":2,"text":"هُوَ الَّذِي خَلَقَكُمْ فَمِنْكُمْ كَافِرٌ وَمِنْكُمْ مُؤْمِنٌ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ","prev":{"a":1,"text":"يُسَبِّحُ لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},"next":{"a":3,"text":"خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ بِالْحَقِّ وَصَوَّرَكُمْ فَأَحْسَنَ صُوَرَكُمْ وَإِلَيْهِ الْمَصِيرُ"},"context":"مطلع التغابن.","reason":"الخلق منهم كافر ومؤمن، والله بصير."}],"hadiths":[],"situations":[{"situationId":4,"verses":[{"i":5,"strength":"direct","bridge":"لا تقل لو: ﴿لَوْ كَانُوا عِنْدَنَا مَا مَاتُوا وَمَا قُتِلُوا﴾ قول الذين كفروا."}],"hadiths":[]},{"situationId":8,"verses":[{"i":11,"strength":"direct","bridge":"قد يكون الكف خيرًا من الظفر: ﴿وَهُوَ الَّذِي كَفَّ أَيْدِيَهُمْ عَنْكُمْ وَأَيْدِيَكُمْ عَنْهُمْ﴾."}],"hadiths":[]},{"situationId":45,"verses":[{"i":4,"strength":"direct","bridge":"أنفق ابتغاء وجه الله: ﴿كَمَثَلِ جَنَّةٍ بِرَبْوَةٍ أَصَابَهَا وَابِلٌ فَآتَتْ أُكُلَهَا ضِعْفَيْنِ﴾."}],"hadiths":[]},{"situationId":47,"verses":[{"i":9,"strength":"direct","bridge":"أتقن عملك: ﴿أَنِ اعْمَلْ سَابِغَاتٍ وَقَدِّرْ فِي السَّرْدِ وَاعْمَلُوا صَالِحًا﴾."}],"hadiths":[]},{"situationId":49,"verses":[{"i":2,"strength":"direct","bridge":"عند الخلاف بعد الفراق: ﴿لَا تُضَارَّ وَالِدَةٌ بِوَلَدِهَا﴾."},{"i":3,"strength":"direct","bridge":"عند الفراق: ﴿وَأَنْ تَعْفُوا أَقْرَبُ لِلتَّقْوَى وَلَا تَنْسَوُا الْفَضْلَ بَيْنَكُمْ﴾."}],"hadiths":[]},{"situationId":73,"verses":[{"i":12,"strength":"direct","bridge":"أينما كنت: ﴿يَعْلَمُ مَا يَلِجُ فِي الْأَرْضِ وَمَا يَخْرُجُ مِنْهَا﴾."}],"hadiths":[]},{"situationId":78,"verses":[{"i":7,"strength":"direct","bridge":"﴿فَاسْتَقِمْ كَمَا أُمِرْتَ وَمَنْ تَابَ مَعَكَ وَلَا تَطْغَوْا﴾."}],"hadiths":[]},{"situationId":93,"verses":[{"i":13,"strength":"direct","bridge":"لا تخن دينك لأجل أهلك: ﴿لَنْ تَنْفَعَكُمْ أَرْحَامُكُمْ وَلَا أَوْلَادُكُمْ يَوْمَ الْقِيَامَةِ﴾."}],"hadiths":[]},{"situationId":119,"verses":[{"i":14,"strength":"direct","bridge":"﴿هُوَ الَّذِي خَلَقَكُمْ فَمِنْكُمْ كَافِرٌ وَمِنْكُمْ مُؤْمِنٌ﴾ فاختر طريقك."}],"hadiths":[]},{"situationId":128,"verses":[{"i":6,"strength":"direct","bridge":"ولاؤك لأهل الإيمان: ﴿أُولَئِكَ بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ﴾."}],"hadiths":[]},{"situationId":139,"verses":[{"i":10,"strength":"direct","bridge":"من يلحد في الآيات لا يخفى: ﴿إِنَّ الَّذِينَ يُلْحِدُونَ فِي آيَاتِنَا لَا يَخْفَوْنَ عَلَيْنَا﴾."}],"hadiths":[]},{"situationId":148,"verses":[{"i":8,"strength":"direct","bridge":"إذا نجّاك الله من شدة: ﴿اذْكُرُوا نِعْمَةَ اللَّهِ عَلَيْكُمْ إِذْ جَاءَتْكُمْ جُنُودٌ﴾."}],"hadiths":[]},{"situationId":171,"verses":[{"i":1,"strength":"direct","bridge":"عملك محفوظ: ﴿وَمَا تُقَدِّمُوا لِأَنْفُسِكُمْ مِنْ خَيْرٍ تَجِدُوهُ عِنْدَ اللَّهِ﴾."}],"hadiths":[]}]},{"id":318,"name":"بما تعملون خبير","compound":true,"meaning":"بما تعملون خبير: يعلم دقائق الأعمال وبواطنها.","teaches":"1. تأتي في أحكام الأسرة: العدة، والصلح بين الزوجين، والظهار.\n2. وفي الصدقة سرًّا وجهرًا.\n3. وفي العدل في الشهادة.","whenRecall":"- عند الصدقة في السر.\n- عند خلاف الزوجين.\n- عند الشهادة.","whenPray":"1. اللهم أنت الخبير بعملي فأصلحه.","summary":"الخبير يعلم ما وراء الظاهر؛ فأحسن باطنك.","verses":[{"i":1,"of":13,"s":2,"surah":"البقرة","a":234,"text":"وَالَّذِينَ يُتَوَفَّوْنَ مِنْكُمْ وَيَذَرُونَ أَزْوَاجًا يَتَرَبَّصْنَ بِأَنْفُسِهِنَّ أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا فَإِذَا بَلَغْنَ أَجَلَهُنَّ فَلَا جُنَاحَ عَلَيْكُمْ فِيمَا فَعَلْنَ فِي أَنْفُسِهِنَّ بِالْمَعْرُوفِ وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ","prev":{"a":233,"text":"وَالْوَالِدَاتُ يُرْضِعْنَ أَوْلَادَهُنَّ حَوْلَيْنِ كَامِلَيْنِ لِمَنْ أَرَادَ أَنْ يُتِمَّ الرَّضَاعَةَ وَعَلَى الْمَوْلُودِ لَهُ رِزْقُهُنَّ وَكِسْوَتُهُنَّ بِالْمَعْرُوفِ لَا تُكَلَّفُ نَفْسٌ إِلَّا وُسْعَهَا لَا تُضَارَّ وَالِدَةٌ بِوَلَدِهَا وَلَا مَوْلُودٌ لَهُ بِوَلَدِهِ وَعَلَى الْوَارِثِ مِثْلُ ذَلِكَ فَإِنْ أَرَادَا فِصَالًا عَنْ تَرَاضٍ مِنْهُمَا وَتَشَاوُرٍ فَلَا جُنَاحَ عَلَيْهِمَا وَإِنْ أَرَدْتُمْ أَنْ تَسْتَرْضِعُوا أَوْلَادَكُمْ فَلَا جُنَاحَ عَلَيْكُمْ إِذَا سَلَّمْتُمْ مَا آتَيْتُمْ بِالْمَعْرُوفِ وَاتَّقُوا اللَّهَ وَاعْلَمُوا أَنَّ اللَّهَ بِمَا تَعْمَلُونَ بَصِيرٌ"},"next":{"a":235,"text":"وَلَا جُنَاحَ عَلَيْكُمْ فِيمَا عَرَّضْتُمْ بِهِ مِنْ خِطْبَةِ النِّسَاءِ أَوْ أَكْنَنْتُمْ فِي أَنْفُسِكُمْ عَلِمَ اللَّهُ أَنَّكُمْ سَتَذْكُرُونَهُنَّ وَلَكِنْ لَا تُوَاعِدُوهُنَّ سِرًّا إِلَّا أَنْ تَقُولُوا قَوْلًا مَعْرُوفًا وَلَا تَعْزِمُوا عُقْدَةَ النِّكَاحِ حَتَّى يَبْلُغَ الْكِتَابُ أَجَلَهُ وَاعْلَمُوا أَنَّ اللَّهَ يَعْلَمُ مَا فِي أَنْفُسِكُمْ فَاحْذَرُوهُ وَاعْلَمُوا أَنَّ اللَّهَ غَفُورٌ حَلِيمٌ"},"context":"أحكام عدة الوفاة.","reason":"المرأة بعد العدة تتصرف بالمعروف."},{"i":2,"of":13,"s":2,"surah":"البقرة","a":271,"text":"إِنْ تُبْدُوا الصَّدَقَاتِ فَنِعِمَّا هِيَ وَإِنْ تُخْفُوهَا وَتُؤْتُوهَا الْفُقَرَاءَ فَهُوَ خَيْرٌ لَكُمْ وَيُكَفِّرُ عَنْكُمْ مِنْ سَيِّئَاتِكُمْ وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ","prev":{"a":270,"text":"وَمَا أَنْفَقْتُمْ مِنْ نَفَقَةٍ أَوْ نَذَرْتُمْ مِنْ نَذْرٍ فَإِنَّ اللَّهَ يَعْلَمُهُ وَمَا لِلظَّالِمِينَ مِنْ أَنْصَارٍ"},"next":{"a":272,"text":"لَيْسَ عَلَيْكَ هُدَاهُمْ وَلَكِنَّ اللَّهَ يَهْدِي مَنْ يَشَاءُ وَمَا تُنْفِقُوا مِنْ خَيْرٍ فَلِأَنْفُسِكُمْ وَمَا تُنْفِقُونَ إِلَّا ابْتِغَاءَ وَجْهِ اللَّهِ وَمَا تُنْفِقُوا مِنْ خَيْرٍ يُوَفَّ إِلَيْكُمْ وَأَنْتُمْ لَا تُظْلَمُونَ"},"context":"قبلها: ما أنفقتم من نفقة أو نذرتم من نذر.","reason":"إخفاء الصدقة خير."},{"i":3,"of":13,"s":3,"surah":"آل عمران","a":180,"text":"وَلَا يَحْسَبَنَّ الَّذِينَ يَبْخَلُونَ بِمَا آتَاهُمُ اللَّهُ مِنْ فَضْلِهِ هُوَ خَيْرًا لَهُمْ بَلْ هُوَ شَرٌّ لَهُمْ سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ وَلِلَّهِ مِيرَاثُ السَّمَاوَاتِ وَالْأَرْضِ وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ","prev":{"a":179,"text":"مَا كَانَ اللَّهُ لِيَذَرَ الْمُؤْمِنِينَ عَلَى مَا أَنْتُمْ عَلَيْهِ حَتَّى يَمِيزَ الْخَبِيثَ مِنَ الطَّيِّبِ وَمَا كَانَ اللَّهُ لِيُطْلِعَكُمْ عَلَى الْغَيْبِ وَلَكِنَّ اللَّهَ يَجْتَبِي مِنْ رُسُلِهِ مَنْ يَشَاءُ فَآمِنُوا بِاللَّهِ وَرُسُلِهِ وَإِنْ تُؤْمِنُوا وَتَتَّقُوا فَلَكُمْ أَجْرٌ عَظِيمٌ"},"next":{"a":181,"text":"لَقَدْ سَمِعَ اللَّهُ قَوْلَ الَّذِينَ قَالُوا إِنَّ اللَّهَ فَقِيرٌ وَنَحْنُ أَغْنِيَاءُ سَنَكْتُبُ مَا قَالُوا وَقَتْلَهُمُ الْأَنْبِيَاءَ بِغَيْرِ حَقٍّ وَنَقُولُ ذُوقُوا عَذَابَ الْحَرِيقِ"},"context":"البخل بما آتاهم الله.","reason":"البخل شر يطوّقون به."},{"i":4,"of":13,"s":4,"surah":"النساء","a":94,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا ضَرَبْتُمْ فِي سَبِيلِ اللَّهِ فَتَبَيَّنُوا وَلَا تَقُولُوا لِمَنْ أَلْقَى إِلَيْكُمُ السَّلَامَ لَسْتَ مُؤْمِنًا تَبْتَغُونَ عَرَضَ الْحَيَاةِ الدُّنْيَا فَعِنْدَ اللَّهِ مَغَانِمُ كَثِيرَةٌ كَذَلِكَ كُنْتُمْ مِنْ قَبْلُ فَمَنَّ اللَّهُ عَلَيْكُمْ فَتَبَيَّنُوا إِنَّ اللَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًا","prev":{"a":93,"text":"وَمَنْ يَقْتُلْ مُؤْمِنًا مُتَعَمِّدًا فَجَزَاؤُهُ جَهَنَّمُ خَالِدًا فِيهَا وَغَضِبَ اللَّهُ عَلَيْهِ وَلَعَنَهُ وَأَعَدَّ لَهُ عَذَابًا عَظِيمًا"},"next":{"a":95,"text":"لَا يَسْتَوِي الْقَاعِدُونَ مِنَ الْمُؤْمِنِينَ غَيْرُ أُولِي الضَّرَرِ وَالْمُجَاهِدُونَ فِي سَبِيلِ اللَّهِ بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ فَضَّلَ اللَّهُ الْمُجَاهِدِينَ بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ عَلَى الْقَاعِدِينَ دَرَجَةً وَكُلًّا وَعَدَ اللَّهُ الْحُسْنَى وَفَضَّلَ اللَّهُ الْمُجَاهِدِينَ عَلَى الْقَاعِدِينَ أَجْرًا عَظِيمًا"},"context":"قبلها: من يقتل مؤمنًا متعمدًا.","reason":"التبين قبل الحكم على الناس."},{"i":5,"of":13,"s":4,"surah":"النساء","a":128,"text":"وَإِنِ امْرَأَةٌ خَافَتْ مِنْ بَعْلِهَا نُشُوزًا أَوْ إِعْرَاضًا فَلَا جُنَاحَ عَلَيْهِمَا أَنْ يُصْلِحَا بَيْنَهُمَا صُلْحًا وَالصُّلْحُ خَيْرٌ وَأُحْضِرَتِ الْأَنْفُسُ الشُّحَّ وَإِنْ تُحْسِنُوا وَتَتَّقُوا فَإِنَّ اللَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًا","prev":{"a":127,"text":"وَيَسْتَفْتُونَكَ فِي النِّسَاءِ قُلِ اللَّهُ يُفْتِيكُمْ فِيهِنَّ وَمَا يُتْلَى عَلَيْكُمْ فِي الْكِتَابِ فِي يَتَامَى النِّسَاءِ اللَّاتِي لَا تُؤْتُونَهُنَّ مَا كُتِبَ لَهُنَّ وَتَرْغَبُونَ أَنْ تَنْكِحُوهُنَّ وَالْمُسْتَضْعَفِينَ مِنَ الْوِلْدَانِ وَأَنْ تَقُومُوا لِلْيَتَامَى بِالْقِسْطِ وَمَا تَفْعَلُوا مِنْ خَيْرٍ فَإِنَّ اللَّهَ كَانَ بِهِ عَلِيمًا"},"next":{"a":129,"text":"وَلَنْ تَسْتَطِيعُوا أَنْ تَعْدِلُوا بَيْنَ النِّسَاءِ وَلَوْ حَرَصْتُمْ فَلَا تَمِيلُوا كُلَّ الْمَيْلِ فَتَذَرُوهَا كَالْمُعَلَّقَةِ وَإِنْ تُصْلِحُوا وَتَتَّقُوا فَإِنَّ اللَّهَ كَانَ غَفُورًا رَحِيمًا"},"context":"قبلها: يستفتونك في النساء.","reason":"الصلح خير عند النشوز أو الإعراض."},{"i":6,"of":13,"s":4,"surah":"النساء","a":135,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا كُونُوا قَوَّامِينَ بِالْقِسْطِ شُهَدَاءَ لِلَّهِ وَلَوْ عَلَى أَنْفُسِكُمْ أَوِ الْوَالِدَيْنِ وَالْأَقْرَبِينَ إِنْ يَكُنْ غَنِيًّا أَوْ فَقِيرًا فَاللَّهُ أَوْلَى بِهِمَا فَلَا تَتَّبِعُوا الْهَوَى أَنْ تَعْدِلُوا وَإِنْ تَلْوُوا أَوْ تُعْرِضُوا فَإِنَّ اللَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًا","prev":{"a":134,"text":"مَنْ كَانَ يُرِيدُ ثَوَابَ الدُّنْيَا فَعِنْدَ اللَّهِ ثَوَابُ الدُّنْيَا وَالْآخِرَةِ وَكَانَ اللَّهُ سَمِيعًا بَصِيرًا"},"next":{"a":136,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا آمِنُوا بِاللَّهِ وَرَسُولِهِ وَالْكِتَابِ الَّذِي نَزَّلَ عَلَى رَسُولِهِ وَالْكِتَابِ الَّذِي أَنْزَلَ مِنْ قَبْلُ وَمَنْ يَكْفُرْ بِاللَّهِ وَمَلَائِكَتِهِ وَكُتُبِهِ وَرُسُلِهِ وَالْيَوْمِ الْآخِرِ فَقَدْ ضَلَّ ضَلَالًا بَعِيدًا"},"context":"قبلها: من كان يريد ثواب الدنيا.","reason":"الشهادة لله ولو على النفس والوالدين."},{"i":7,"of":13,"s":31,"surah":"لقمان","a":29,"text":"أَلَمْ تَرَ أَنَّ اللَّهَ يُولِجُ اللَّيْلَ فِي النَّهَارِ وَيُولِجُ النَّهَارَ فِي اللَّيْلِ وَسَخَّرَ الشَّمْسَ وَالْقَمَرَ كُلٌّ يَجْرِي إِلَى أَجَلٍ مُسَمًّى وَأَنَّ اللَّهَ بِمَا تَعْمَلُونَ خَبِيرٌ","prev":{"a":28,"text":"مَا خَلْقُكُمْ وَلَا بَعْثُكُمْ إِلَّا كَنَفْسٍ وَاحِدَةٍ إِنَّ اللَّهَ سَمِيعٌ بَصِيرٌ"},"next":{"a":30,"text":"ذَلِكَ بِأَنَّ اللَّهَ هُوَ الْحَقُّ وَأَنَّ مَا يَدْعُونَ مِنْ دُونِهِ الْبَاطِلُ وَأَنَّ اللَّهَ هُوَ الْعَلِيُّ الْكَبِيرُ"},"context":"قبلها: ما خلقكم ولا بعثكم إلا كنفس واحدة.","reason":"تعاقب الليل والنهار والشمس والقمر."},{"i":8,"of":13,"s":33,"surah":"الأحزاب","a":2,"text":"وَاتَّبِعْ مَا يُوحَى إِلَيْكَ مِنْ رَبِّكَ إِنَّ اللَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًا","prev":{"a":1,"text":"يَا أَيُّهَا النَّبِيُّ اتَّقِ اللَّهَ وَلَا تُطِعِ الْكَافِرِينَ وَالْمُنَافِقِينَ إِنَّ اللَّهَ كَانَ عَلِيمًا حَكِيمًا"},"next":{"a":3,"text":"وَتَوَكَّلْ عَلَى اللَّهِ وَكَفَى بِاللَّهِ وَكِيلًا"},"context":"قبلها: اتق الله ولا تطع الكافرين.","reason":"اتباع الوحي."},{"i":9,"of":13,"s":48,"surah":"الفتح","a":11,"text":"سَيَقُولُ لَكَ الْمُخَلَّفُونَ مِنَ الْأَعْرَابِ شَغَلَتْنَا أَمْوَالُنَا وَأَهْلُونَا فَاسْتَغْفِرْ لَنَا يَقُولُونَ بِأَلْسِنَتِهِمْ مَا لَيْسَ فِي قُلُوبِهِمْ قُلْ فَمَنْ يَمْلِكُ لَكُمْ مِنَ اللَّهِ شَيْئًا إِنْ أَرَادَ بِكُمْ ضَرًّا أَوْ أَرَادَ بِكُمْ نَفْعًا بَلْ كَانَ اللَّهُ بِمَا تَعْمَلُونَ خَبِيرًا","prev":{"a":10,"text":"إِنَّ الَّذِينَ يُبَايِعُونَكَ إِنَّمَا يُبَايِعُونَ اللَّهَ يَدُ اللَّهِ فَوْقَ أَيْدِيهِمْ فَمَنْ نَكَثَ فَإِنَّمَا يَنْكُثُ عَلَى نَفْسِهِ وَمَنْ أَوْفَى بِمَا عَاهَدَ عَلَيْهُ اللَّهَ فَسَيُؤْتِيهِ أَجْرًا عَظِيمًا"},"next":{"a":12,"text":"بَلْ ظَنَنْتُمْ أَنْ لَنْ يَنْقَلِبَ الرَّسُولُ وَالْمُؤْمِنُونَ إِلَى أَهْلِيهِمْ أَبَدًا وَزُيِّنَ ذَلِكَ فِي قُلُوبِكُمْ وَظَنَنْتُمْ ظَنَّ السَّوْءِ وَكُنْتُمْ قَوْمًا بُورًا"},"reason":"اعتذروا بالأموال والأهل."},{"i":10,"of":13,"s":57,"surah":"الحديد","a":10,"text":"وَمَا لَكُمْ أَلَّا تُنْفِقُوا فِي سَبِيلِ اللَّهِ وَلِلَّهِ مِيرَاثُ السَّمَاوَاتِ وَالْأَرْضِ لَا يَسْتَوِي مِنْكُمْ مَنْ أَنْفَقَ مِنْ قَبْلِ الْفَتْحِ وَقَاتَلَ أُولَئِكَ أَعْظَمُ دَرَجَةً مِنَ الَّذِينَ أَنْفَقُوا مِنْ بَعْدُ وَقَاتَلُوا وَكُلًّا وَعَدَ اللَّهُ الْحُسْنَى وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ","prev":{"a":9,"text":"هُوَ الَّذِي يُنَزِّلُ عَلَى عَبْدِهِ آيَاتٍ بَيِّنَاتٍ لِيُخْرِجَكُمْ مِنَ الظُّلُمَاتِ إِلَى النُّورِ وَإِنَّ اللَّهَ بِكُمْ لَرَءُوفٌ رَحِيمٌ"},"next":{"a":11,"text":"مَنْ ذَا الَّذِي يُقْرِضُ اللَّهَ قَرْضًا حَسَنًا فَيُضَاعِفَهُ لَهُ وَلَهُ أَجْرٌ كَرِيمٌ"},"context":"الحث على الإنفاق.","reason":"لا يستوي من أنفق قبل الفتح."},{"i":11,"of":13,"s":58,"surah":"المجادلة","a":3,"text":"وَالَّذِينَ يُظَاهِرُونَ مِنْ نِسَائِهِمْ ثُمَّ يَعُودُونَ لِمَا قَالُوا فَتَحْرِيرُ رَقَبَةٍ مِنْ قَبْلِ أَنْ يَتَمَاسَّا ذَلِكُمْ تُوعَظُونَ بِهِ وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ","prev":{"a":2,"text":"الَّذِينَ يُظَاهِرُونَ مِنْكُمْ مِنْ نِسَائِهِمْ مَا هُنَّ أُمَّهَاتِهِمْ إِنْ أُمَّهَاتُهُمْ إِلَّا اللَّائِي وَلَدْنَهُمْ وَإِنَّهُمْ لَيَقُولُونَ مُنْكَرًا مِنَ الْقَوْلِ وَزُورًا وَإِنَّ اللَّهَ لَعَفُوٌّ غَفُورٌ"},"next":{"a":4,"text":"فَمَنْ لَمْ يَجِدْ فَصِيَامُ شَهْرَيْنِ مُتَتَابِعَيْنِ مِنْ قَبْلِ أَنْ يَتَمَاسَّا فَمَنْ لَمْ يَسْتَطِعْ فَإِطْعَامُ سِتِّينَ مِسْكِينًا ذَلِكَ لِتُؤْمِنُوا بِاللَّهِ وَرَسُولِهِ وَتِلْكَ حُدُودُ اللَّهِ وَلِلْكَافِرِينَ عَذَابٌ أَلِيمٌ"},"context":"قبلها: الذين يظاهرون من نسائهم.","reason":"كفارة الظهار."},{"i":12,"of":13,"s":58,"surah":"المجادلة","a":11,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا قِيلَ لَكُمْ تَفَسَّحُوا فِي الْمَجَالِسِ فَافْسَحُوا يَفْسَحِ اللَّهُ لَكُمْ وَإِذَا قِيلَ انْشُزُوا فَانْشُزُوا يَرْفَعِ اللَّهُ الَّذِينَ آمَنُوا مِنْكُمْ وَالَّذِينَ أُوتُوا الْعِلْمَ دَرَجَاتٍ وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ","prev":{"a":10,"text":"إِنَّمَا النَّجْوَى مِنَ الشَّيْطَانِ لِيَحْزُنَ الَّذِينَ آمَنُوا وَلَيْسَ بِضَارِّهِمْ شَيْئًا إِلَّا بِإِذْنِ اللَّهِ وَعَلَى اللَّهِ فَلْيَتَوَكَّلِ الْمُؤْمِنُونَ"},"next":{"a":12,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا نَاجَيْتُمُ الرَّسُولَ فَقَدِّمُوا بَيْنَ يَدَيْ نَجْوَاكُمْ صَدَقَةً ذَلِكَ خَيْرٌ لَكُمْ وَأَطْهَرُ فَإِنْ لَمْ تَجِدُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ"},"context":"قبلها: إنما النجوى من الشيطان.","reason":"التفسح في المجالس ورفع أهل العلم."},{"i":13,"of":13,"s":64,"surah":"التغابن","a":8,"text":"فَآمِنُوا بِاللَّهِ وَرَسُولِهِ وَالنُّورِ الَّذِي أَنْزَلْنَا وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ","prev":{"a":7,"text":"زَعَمَ الَّذِينَ كَفَرُوا أَنْ لَنْ يُبْعَثُوا قُلْ بَلَى وَرَبِّي لَتُبْعَثُنَّ ثُمَّ لَتُنَبَّؤُنَّ بِمَا عَمِلْتُمْ وَذَلِكَ عَلَى اللَّهِ يَسِيرٌ"},"next":{"a":9,"text":"يَوْمَ يَجْمَعُكُمْ لِيَوْمِ الْجَمْعِ ذَلِكَ يَوْمُ التَّغَابُنِ وَمَنْ يُؤْمِنْ بِاللَّهِ وَيَعْمَلْ صَالِحًا يُكَفِّرْ عَنْهُ سَيِّئَاتِهِ وَيُدْخِلْهُ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا أَبَدًا ذَلِكَ الْفَوْزُ الْعَظِيمُ"},"context":"قبلها: زعم الذين كفروا أن لن يبعثوا.","reason":"الأمر بالإيمان بالله ورسوله والنور."}],"hadiths":[],"situations":[{"situationId":4,"verses":[{"i":1,"strength":"direct","bridge":"بعد الفقد: ﴿فَإِذَا بَلَغْنَ أَجَلَهُنَّ فَلَا جُنَاحَ عَلَيْكُمْ فِيمَا فَعَلْنَ فِي أَنْفُسِهِنَّ بِالْمَعْرُوفِ﴾."}],"hadiths":[]},{"situationId":44,"verses":[{"i":3,"strength":"direct","bridge":"﴿وَلَا يَحْسَبَنَّ الَّذِينَ يَبْخَلُونَ بِمَا آتَاهُمُ اللَّهُ مِنْ فَضْلِهِ هُوَ خَيْرًا لَهُمْ﴾."}],"hadiths":[]},{"situationId":45,"verses":[{"i":2,"strength":"direct","bridge":"﴿وَإِنْ تُخْفُوهَا وَتُؤْتُوهَا الْفُقَرَاءَ فَهُوَ خَيْرٌ لَكُمْ﴾."}],"hadiths":[]},{"situationId":48,"verses":[{"i":5,"strength":"direct","bridge":"إذا خفت إعراض زوجك: ﴿فَلَا جُنَاحَ عَلَيْهِمَا أَنْ يُصْلِحَا بَيْنَهُمَا صُلْحًا وَالصُّلْحُ خَيْرٌ﴾."},{"i":11,"strength":"direct","bridge":"إذا جرحت زوجتك بقول منكر: ﴿ذَلِكُمْ تُوعَظُونَ بِهِ﴾."}],"hadiths":[]},{"situationId":59,"verses":[{"i":4,"strength":"direct","bridge":"لا تتهم أحدًا في إيمانه: ﴿وَلَا تَقُولُوا لِمَنْ أَلْقَى إِلَيْكُمُ السَّلَامَ لَسْتَ مُؤْمِنًا﴾."}],"hadiths":[]},{"situationId":63,"verses":[{"i":6,"strength":"direct","bridge":"اشهد بالحق: ﴿كُونُوا قَوَّامِينَ بِالْقِسْطِ شُهَدَاءَ لِلَّهِ وَلَوْ عَلَى أَنْفُسِكُمْ﴾."}],"hadiths":[]},{"situationId":71,"verses":[{"i":12,"strength":"direct","bridge":"في المجلس: ﴿إِذَا قِيلَ لَكُمْ تَفَسَّحُوا فِي الْمَجَالِسِ فَافْسَحُوا يَفْسَحِ اللَّهُ لَكُمْ﴾."}],"hadiths":[]},{"situationId":109,"verses":[{"i":13,"strength":"direct","bridge":"﴿فَآمِنُوا بِاللَّهِ وَرَسُولِهِ وَالنُّورِ الَّذِي أَنْزَلْنَا﴾."}],"hadiths":[]},{"situationId":123,"verses":[{"i":8,"strength":"direct","bridge":"إذا تجاذبتك الآراء: ﴿وَاتَّبِعْ مَا يُوحَى إِلَيْكَ مِنْ رَبِّكَ﴾."}],"hadiths":[]},{"situationId":141,"verses":[{"i":9,"strength":"direct","bridge":"إذا اعتذرت عن واجب: ﴿شَغَلَتْنَا أَمْوَالُنَا وَأَهْلُونَا﴾ عذر لا يقبل."}],"hadiths":[]},{"situationId":172,"verses":[{"i":10,"strength":"direct","bridge":"بادر بالبذل: ﴿لَا يَسْتَوِي مِنْكُمْ مَنْ أَنْفَقَ مِنْ قَبْلِ الْفَتْحِ وَقَاتَلَ﴾."}],"hadiths":[]},{"situationId":177,"verses":[{"i":7,"strength":"direct","bridge":"تأمل: ﴿أَلَمْ تَرَ أَنَّ اللَّهَ يُولِجُ اللَّيْلَ فِي النَّهَارِ﴾."}],"hadiths":[]}]},{"id":319,"name":"بما يعملون محيط","compound":true,"meaning":"بما يعملون محيط: علمه وقدرته تحيط بأعمالهم.","teaches":"1. تأتي مع كيد الأعداء، والتبييت، والخروج رياءً.","whenRecall":"- حين يُكاد لك.\n- حين تُبيّت ما لا يرضي الله.","whenPray":"1. اللهم اكفني كيدهم.","summary":"الصبر والتقوى يُبطلان الكيد.","verses":[{"i":1,"of":3,"s":3,"surah":"آل عمران","a":120,"text":"إِنْ تَمْسَسْكُمْ حَسَنَةٌ تَسُؤْهُمْ وَإِنْ تُصِبْكُمْ سَيِّئَةٌ يَفْرَحُوا بِهَا وَإِنْ تَصْبِرُوا وَتَتَّقُوا لَا يَضُرُّكُمْ كَيْدُهُمْ شَيْئًا إِنَّ اللَّهَ بِمَا يَعْمَلُونَ مُحِيطٌ","prev":{"a":119,"text":"هَا أَنْتُمْ أُولَاءِ تُحِبُّونَهُمْ وَلَا يُحِبُّونَكُمْ وَتُؤْمِنُونَ بِالْكِتَابِ كُلِّهِ وَإِذَا لَقُوكُمْ قَالُوا آمَنَّا وَإِذَا خَلَوْا عَضُّوا عَلَيْكُمُ الْأَنَامِلَ مِنَ الْغَيْظِ قُلْ مُوتُوا بِغَيْظِكُمْ إِنَّ اللَّهَ عَلِيمٌ بِذَاتِ الصُّدُورِ"},"next":{"a":121,"text":"وَإِذْ غَدَوْتَ مِنْ أَهْلِكَ تُبَوِّئُ الْمُؤْمِنِينَ مَقَاعِدَ لِلْقِتَالِ وَاللَّهُ سَمِيعٌ عَلِيمٌ"},"context":"قبلها: تحبونهم ولا يحبونكم.","reason":"الصبر والتقوى يمنعان ضرر الكيد."},{"i":2,"of":3,"s":4,"surah":"النساء","a":108,"text":"يَسْتَخْفُونَ مِنَ النَّاسِ وَلَا يَسْتَخْفُونَ مِنَ اللَّهِ وَهُوَ مَعَهُمْ إِذْ يُبَيِّتُونَ مَا لَا يَرْضَى مِنَ الْقَوْلِ وَكَانَ اللَّهُ بِمَا يَعْمَلُونَ مُحِيطًا","prev":{"a":107,"text":"وَلَا تُجَادِلْ عَنِ الَّذِينَ يَخْتَانُونَ أَنْفُسَهُمْ إِنَّ اللَّهَ لَا يُحِبُّ مَنْ كَانَ خَوَّانًا أَثِيمًا"},"next":{"a":109,"text":"هَا أَنْتُمْ هَؤُلَاءِ جَادَلْتُمْ عَنْهُمْ فِي الْحَيَاةِ الدُّنْيَا فَمَنْ يُجَادِلُ اللَّهَ عَنْهُمْ يَوْمَ الْقِيَامَةِ أَمْ مَنْ يَكُونُ عَلَيْهِمْ وَكِيلًا"},"context":"قبلها: لا تجادل عن الذين يختانون أنفسهم.","reason":"الاستخفاء من الناس دون الله."},{"i":3,"of":3,"s":8,"surah":"الأنفال","a":47,"text":"وَلَا تَكُونُوا كَالَّذِينَ خَرَجُوا مِنْ دِيَارِهِمْ بَطَرًا وَرِئَاءَ النَّاسِ وَيَصُدُّونَ عَنْ سَبِيلِ اللَّهِ وَاللَّهُ بِمَا يَعْمَلُونَ مُحِيطٌ","prev":{"a":46,"text":"وَأَطِيعُوا اللَّهَ وَرَسُولَهُ وَلَا تَنَازَعُوا فَتَفْشَلُوا وَتَذْهَبَ رِيحُكُمْ وَاصْبِرُوا إِنَّ اللَّهَ مَعَ الصَّابِرِينَ"},"next":{"a":48,"text":"وَإِذْ زَيَّنَ لَهُمُ الشَّيْطَانُ أَعْمَالَهُمْ وَقَالَ لَا غَالِبَ لَكُمُ الْيَوْمَ مِنَ النَّاسِ وَإِنِّي جَارٌ لَكُمْ فَلَمَّا تَرَاءَتِ الْفِئَتَانِ نَكَصَ عَلَى عَقِبَيْهِ وَقَالَ إِنِّي بَرِيءٌ مِنْكُمْ إِنِّي أَرَى مَا لَا تَرَوْنَ إِنِّي أَخَافُ اللَّهَ وَاللَّهُ شَدِيدُ الْعِقَابِ"},"context":"قبلها: لا تنازعوا فتفشلوا.","reason":"النهي عن الخروج بطرًا ورياء."}],"hadiths":[],"situations":[{"situationId":30,"verses":[{"i":1,"strength":"direct","bridge":"إذا كادك أحد: ﴿وَإِنْ تَصْبِرُوا وَتَتَّقُوا لَا يَضُرُّكُمْ كَيْدُهُمْ شَيْئًا﴾."}],"hadiths":[]},{"situationId":73,"verses":[{"i":2,"strength":"direct","bridge":"﴿يَسْتَخْفُونَ مِنَ النَّاسِ وَلَا يَسْتَخْفُونَ مِنَ اللَّهِ وَهُوَ مَعَهُمْ﴾."}],"hadiths":[]},{"situationId":81,"verses":[{"i":3,"strength":"direct","bridge":"﴿وَلَا تَكُونُوا كَالَّذِينَ خَرَجُوا مِنْ دِيَارِهِمْ بَطَرًا وَرِئَاءَ النَّاسِ﴾."}],"hadiths":[]}]},{"id":320,"name":"بما تعملون عليم","compound":true,"meaning":"بما تعملون عليم: علمه بأعمالكم تام.","teaches":"1. في الأمانة والشهادة.\n2. وفي أكل الطيبات والعمل الصالح.\n3. وفي آداب الاستئذان.","whenRecall":"- عند أداء الأمانة.\n- عند الاستئذان.","whenPray":"1. اللهم ارزقني الطيبات والعمل الصالح.","summary":"أدِّ الأمانة، وكل الطيب، واستأذن؛ والله عليم.","verses":[{"i":1,"of":3,"s":2,"surah":"البقرة","a":283,"text":"وَإِنْ كُنْتُمْ عَلَى سَفَرٍ وَلَمْ تَجِدُوا كَاتِبًا فَرِهَانٌ مَقْبُوضَةٌ فَإِنْ أَمِنَ بَعْضُكُمْ بَعْضًا فَلْيُؤَدِّ الَّذِي اؤْتُمِنَ أَمَانَتَهُ وَلْيَتَّقِ اللَّهَ رَبَّهُ وَلَا تَكْتُمُوا الشَّهَادَةَ وَمَنْ يَكْتُمْهَا فَإِنَّهُ آثِمٌ قَلْبُهُ وَاللَّهُ بِمَا تَعْمَلُونَ عَلِيمٌ","prev":{"a":282,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا تَدَايَنْتُمْ بِدَيْنٍ إِلَى أَجَلٍ مُسَمًّى فَاكْتُبُوهُ وَلْيَكْتُبْ بَيْنَكُمْ كَاتِبٌ بِالْعَدْلِ وَلَا يَأْبَ كَاتِبٌ أَنْ يَكْتُبَ كَمَا عَلَّمَهُ اللَّهُ فَلْيَكْتُبْ وَلْيُمْلِلِ الَّذِي عَلَيْهِ الْحَقُّ وَلْيَتَّقِ اللَّهَ رَبَّهُ وَلَا يَبْخَسْ مِنْهُ شَيْئًا فَإِنْ كَانَ الَّذِي عَلَيْهِ الْحَقُّ سَفِيهًا أَوْ ضَعِيفًا أَوْ لَا يَسْتَطِيعُ أَنْ يُمِلَّ هُوَ فَلْيُمْلِلْ وَلِيُّهُ بِالْعَدْلِ وَاسْتَشْهِدُوا شَهِيدَيْنِ مِنْ رِجَالِكُمْ فَإِنْ لَمْ يَكُونَا رَجُلَيْنِ فَرَجُلٌ وَامْرَأَتَانِ مِمَّنْ تَرْضَوْنَ مِنَ الشُّهَدَاءِ أَنْ تَضِلَّ إِحْدَاهُمَا فَتُذَكِّرَ إِحْدَاهُمَا الْأُخْرَى وَلَا يَأْبَ الشُّهَدَاءُ إِذَا مَا دُعُوا وَلَا تَسْأَمُوا أَنْ تَكْتُبُوهُ صَغِيرًا أَوْ كَبِيرًا إِلَى أَجَلِهِ ذَلِكُمْ أَقْسَطُ عِنْدَ اللَّهِ وَأَقْوَمُ لِلشَّهَادَةِ وَأَدْنَى أَلَّا تَرْتَابُوا إِلَّا أَنْ تَكُونَ تِجَارَةً حَاضِرَةً تُدِيرُونَهَا بَيْنَكُمْ فَلَيْسَ عَلَيْكُمْ جُنَاحٌ أَلَّا تَكْتُبُوهَا وَأَشْهِدُوا إِذَا تَبَايَعْتُمْ وَلَا يُضَارَّ كَاتِبٌ وَلَا شَهِيدٌ وَإِنْ تَفْعَلُوا فَإِنَّهُ فُسُوقٌ بِكُمْ وَاتَّقُوا اللَّهَ وَيُعَلِّمُكُمُ اللَّهُ وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ"},"next":{"a":284,"text":"لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَإِنْ تُبْدُوا مَا فِي أَنْفُسِكُمْ أَوْ تُخْفُوهُ يُحَاسِبْكُمْ بِهِ اللَّهُ فَيَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},"context":"آية الدين.","reason":"أداء الأمانة وعدم كتمان الشهادة."},{"i":2,"of":3,"s":23,"surah":"المؤمنون","a":51,"text":"يَا أَيُّهَا الرُّسُلُ كُلُوا مِنَ الطَّيِّبَاتِ وَاعْمَلُوا صَالِحًا إِنِّي بِمَا تَعْمَلُونَ عَلِيمٌ","prev":{"a":50,"text":"وَجَعَلْنَا ابْنَ مَرْيَمَ وَأُمَّهُ آيَةً وَآوَيْنَاهُمَا إِلَى رَبْوَةٍ ذَاتِ قَرَارٍ وَمَعِينٍ"},"next":{"a":52,"text":"وَإِنَّ هَذِهِ أُمَّتُكُمْ أُمَّةً وَاحِدَةً وَأَنَا رَبُّكُمْ فَاتَّقُونِ"},"context":"خطاب الرسل.","reason":"الأكل من الطيبات مقرون بالعمل الصالح."},{"i":3,"of":3,"s":24,"surah":"النور","a":28,"text":"فَإِنْ لَمْ تَجِدُوا فِيهَا أَحَدًا فَلَا تَدْخُلُوهَا حَتَّى يُؤْذَنَ لَكُمْ وَإِنْ قِيلَ لَكُمُ ارْجِعُوا فَارْجِعُوا هُوَ أَزْكَى لَكُمْ وَاللَّهُ بِمَا تَعْمَلُونَ عَلِيمٌ","prev":{"a":27,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَدْخُلُوا بُيُوتًا غَيْرَ بُيُوتِكُمْ حَتَّى تَسْتَأْنِسُوا وَتُسَلِّمُوا عَلَى أَهْلِهَا ذَلِكُمْ خَيْرٌ لَكُمْ لَعَلَّكُمْ تَذَكَّرُونَ"},"next":{"a":29,"text":"لَيْسَ عَلَيْكُمْ جُنَاحٌ أَنْ تَدْخُلُوا بُيُوتًا غَيْرَ مَسْكُونَةٍ فِيهَا مَتَاعٌ لَكُمْ وَاللَّهُ يَعْلَمُ مَا تُبْدُونَ وَمَا تَكْتُمُونَ"},"context":"آداب دخول البيوت.","reason":"الرجوع إذا قيل ارجعوا أزكى."}],"hadiths":[{"i":1,"of":1,"text":"إنَّ اللهَ طيِّبٌ. [يعني حديث: أَيُّها النَّاسُ، إنَّ اللَّهَ طَيِّبٌ لا يَقْبَلُ إلَّا طَيِّبًا، وإنَّ اللَّهَ أمَرَ المُؤْمِنِينَ بما أمَرَ به المُرْسَلِينَ، فقالَ: {يَا أَيُّهَا الرُّسُلُ كُلُوا مِنَ الطَّيِّبَاتِ وَاعْمَلُوا صَالِحًا إِنِّي بِمَا تَعْمَلُونَ عَلِيمٌ} [المؤمنون: 51]، وقالَ: {يَا أَيُّهَا الَّذِينَ آمَنُوا كُلُوا مِنْ طَيِّبَاتِ مَا رَزَقْنَاكُمْ} [البقرة: 172]، ثُمَّ ذَكَرَ الرَّجُلَ يُطِيلُ السَّفَرَ أشْعَثَ أغْبَرَ، يَمُدُّ يَدَيْهِ إلى السَّماءِ، يا رَبِّ، يا رَبِّ، ومَطْعَمُهُ حَرامٌ، ومَشْرَبُهُ حَرامٌ، ومَلْبَسُهُ حَرامٌ، وغُذِيَ بالحَرامِ ، فأنَّى يُسْتَجابُ لذلكَ؟!]","narrator":"[أبو هريرة]","source":"عارضة الأحوذي 5/408","grade":"صحيح","url":"https://dorar.net/h/QsWdQUuL","nameForm":"بما تعملون عليم"}],"sunnah":{},"situations":[{"situationId":46,"verses":[{"i":2,"strength":"direct","bridge":"﴿كُلُوا مِنَ الطَّيِّبَاتِ وَاعْمَلُوا صَالِحًا﴾."}],"hadiths":[]},{"situationId":47,"verses":[{"i":1,"strength":"direct","bridge":"﴿فَلْيُؤَدِّ الَّذِي اؤْتُمِنَ أَمَانَتَهُ وَلْيَتَّقِ اللَّهَ رَبَّهُ﴾."}],"hadiths":[]},{"situationId":71,"verses":[{"i":3,"strength":"direct","bridge":"إذا رُدّ استئذانك: ﴿وَإِنْ قِيلَ لَكُمُ ارْجِعُوا فَارْجِعُوا هُوَ أَزْكَى لَكُمْ﴾."}],"hadiths":[]}]},{"id":321,"name":"القائم على كل نفسٍ بما كسبت","compound":true,"meaning":"القائم على كل نفس بما كسبت: رقيب حافظ مجازٍ لكل نفس.","teaches":"1. سؤال إنكاري: أفمن هو قائم على كل نفس كمن لا يملك؟","whenRecall":"- حين تتعلق بشريك.","whenPray":"1. يا قائمًا على كل نفس، أصلح نفسي.","summary":"لا يستوي القائم على كل نفس مع شركاء بلا أسماء حقيقية.","verses":[{"i":1,"of":1,"s":13,"surah":"الرعد","a":33,"text":"أَفَمَنْ هُوَ قَائِمٌ عَلَى كُلِّ نَفْسٍ بِمَا كَسَبَتْ وَجَعَلُوا لِلَّهِ شُرَكَاءَ قُلْ سَمُّوهُمْ أَمْ تُنَبِّئُونَهُ بِمَا لَا يَعْلَمُ فِي الْأَرْضِ أَمْ بِظَاهِرٍ مِنَ الْقَوْلِ بَلْ زُيِّنَ لِلَّذِينَ كَفَرُوا مَكْرُهُمْ وَصُدُّوا عَنِ السَّبِيلِ وَمَنْ يُضْلِلِ اللَّهُ فَمَا لَهُ مِنْ هَادٍ","prev":{"a":32,"text":"وَلَقَدِ اسْتُهْزِئَ بِرُسُلٍ مِنْ قَبْلِكَ فَأَمْلَيْتُ لِلَّذِينَ كَفَرُوا ثُمَّ أَخَذْتُهُمْ فَكَيْفَ كَانَ عِقَابِ"},"next":{"a":34,"text":"لَهُمْ عَذَابٌ فِي الْحَيَاةِ الدُّنْيَا وَلَعَذَابُ الْآخِرَةِ أَشَقُّ وَمَا لَهُمْ مِنَ اللَّهِ مِنْ وَاقٍ"},"context":"قبلها: استهزئ برسل من قبلك فأمليت.","reason":"مقارنة بين القائم على النفوس والشركاء."}],"hadiths":[],"situations":[{"situationId":99,"verses":[{"i":1,"strength":"direct","bridge":"﴿أَفَمَنْ هُوَ قَائِمٌ عَلَى كُلِّ نَفْسٍ بِمَا كَسَبَتْ وَجَعَلُوا لِلَّهِ شُرَكَاءَ﴾."}],"hadiths":[]}]},{"id":322,"name":"بما تعملون محيط","compound":true,"meaning":"إن ربي بما تعملون محيط: قالها شعيب لقومه.","teaches":"1. قومه احترموا رهطه أكثر من الله.","whenRecall":"- حين يُراعى الناس أكثر من الله.","whenPray":"1. اللهم اجعلني أخشاك أكثر من الناس.","summary":"لا تجعل الناس أعز عليك من الله.","verses":[{"i":1,"of":1,"s":11,"surah":"هود","a":92,"text":"قَالَ يَا قَوْمِ أَرَهْطِي أَعَزُّ عَلَيْكُمْ مِنَ اللَّهِ وَاتَّخَذْتُمُوهُ وَرَاءَكُمْ ظِهْرِيًّا إِنَّ رَبِّي بِمَا تَعْمَلُونَ مُحِيطٌ","prev":{"a":91,"text":"قَالُوا يَا شُعَيْبُ مَا نَفْقَهُ كَثِيرًا مِمَّا تَقُولُ وَإِنَّا لَنَرَاكَ فِينَا ضَعِيفًا وَلَوْلَا رَهْطُكَ لَرَجَمْنَاكَ وَمَا أَنْتَ عَلَيْنَا بِعَزِيزٍ"},"next":{"a":93,"text":"وَيَا قَوْمِ اعْمَلُوا عَلَى مَكَانَتِكُمْ إِنِّي عَامِلٌ سَوْفَ تَعْلَمُونَ مَنْ يَأْتِيهِ عَذَابٌ يُخْزِيهِ وَمَنْ هُوَ كَاذِبٌ وَارْتَقِبُوا إِنِّي مَعَكُمْ رَقِيبٌ"},"context":"قوم شعيب: لولا رهطك لرجمناك.","reason":"عاتبهم: أرهطي أعز عليكم من الله."}],"hadiths":[],"situations":[{"situationId":88,"verses":[{"i":1,"strength":"direct","bridge":"﴿أَرَهْطِي أَعَزُّ عَلَيْكُمْ مِنَ اللَّهِ وَاتَّخَذْتُمُوهُ وَرَاءَكُمْ ظِهْرِيًّا﴾."}],"hadiths":[]}]},{"id":323,"name":"أعلم بمن ضل عن سبيله / من يضل عن سبيله","compound":true,"meaning":"أعلم بمن ضل عن سبيله: علمه بالضالين تام.","teaches":"1. تأتي مع: وهو أعلم بالمهتدين.\n2. مقابل الأكثرية، وفي منهج الدعوة.","whenRecall":"- حين يُتهم المصلح بالضلال.","whenPray":"1. اللهم ثبتني على سبيلك.","summary":"الحكم على الضلال لله.","verses":[{"i":1,"of":4,"s":6,"surah":"الأنعام","a":117,"text":"إِنَّ رَبَّكَ هُوَ أَعْلَمُ مَنْ يَضِلُّ عَنْ سَبِيلِهِ وَهُوَ أَعْلَمُ بِالْمُهْتَدِينَ","prev":{"a":116,"text":"وَإِنْ تُطِعْ أَكْثَرَ مَنْ فِي الْأَرْضِ يُضِلُّوكَ عَنْ سَبِيلِ اللَّهِ إِنْ يَتَّبِعُونَ إِلَّا الظَّنَّ وَإِنْ هُمْ إِلَّا يَخْرُصُونَ"},"next":{"a":118,"text":"فَكُلُوا مِمَّا ذُكِرَ اسْمُ اللَّهِ عَلَيْهِ إِنْ كُنْتُمْ بِآيَاتِهِ مُؤْمِنِينَ"},"context":"قبلها: إن تطع أكثر من في الأرض يضلوك.","reason":"العلم بالضال عند الله لا عند الأكثرية."},{"i":2,"of":4,"s":16,"surah":"النحل","a":125,"text":"ادْعُ إِلَى سَبِيلِ رَبِّكَ بِالْحِكْمَةِ وَالْمَوْعِظَةِ الْحَسَنَةِ وَجَادِلْهُمْ بِالَّتِي هِيَ أَحْسَنُ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَنْ ضَلَّ عَنْ سَبِيلِهِ وَهُوَ أَعْلَمُ بِالْمُهْتَدِينَ","prev":{"a":124,"text":"إِنَّمَا جُعِلَ السَّبْتُ عَلَى الَّذِينَ اخْتَلَفُوا فِيهِ وَإِنَّ رَبَّكَ لَيَحْكُمُ بَيْنَهُمْ يَوْمَ الْقِيَامَةِ فِيمَا كَانُوا فِيهِ يَخْتَلِفُونَ"},"next":{"a":126,"text":"وَإِنْ عَاقَبْتُمْ فَعَاقِبُوا بِمِثْلِ مَا عُوقِبْتُمْ بِهِ وَلَئِنْ صَبَرْتُمْ لَهُوَ خَيْرٌ لِلصَّابِرِينَ"},"context":"منهج الدعوة.","reason":"رفع همّ النتيجة."},{"i":3,"of":4,"s":53,"surah":"النجم","a":30,"text":"ذَلِكَ مَبْلَغُهُمْ مِنَ الْعِلْمِ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَنْ ضَلَّ عَنْ سَبِيلِهِ وَهُوَ أَعْلَمُ بِمَنِ اهْتَدَى","prev":{"a":29,"text":"فَأَعْرِضْ عَنْ مَنْ تَوَلَّى عَنْ ذِكْرِنَا وَلَمْ يُرِدْ إِلَّا الْحَيَاةَ الدُّنْيَا"},"next":{"a":31,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ لِيَجْزِيَ الَّذِينَ أَسَاءُوا بِمَا عَمِلُوا وَيَجْزِيَ الَّذِينَ أَحْسَنُوا بِالْحُسْنَى"},"context":"قبلها: أعرض عمن تولى عن ذكرنا.","reason":"مبلغهم من العلم الدنيا."},{"i":4,"of":4,"s":68,"surah":"القلم","a":7,"text":"إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَنْ ضَلَّ عَنْ سَبِيلِهِ وَهُوَ أَعْلَمُ بِالْمُهْتَدِينَ","prev":{"a":6,"text":"بِأَيِّكُمُ الْمَفْتُونُ"},"next":{"a":8,"text":"فَلَا تُطِعِ الْمُكَذِّبِينَ"},"context":"قبلها: بأيكم المفتون.","reason":"تثبيت النبي ﷺ أمام الاتهام."}],"hadiths":[],"situations":[{"situationId":29,"verses":[{"i":4,"strength":"direct","bridge":"﴿إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَنْ ضَلَّ عَنْ سَبِيلِهِ﴾."}],"hadiths":[]},{"situationId":92,"verses":[{"i":3,"strength":"direct","bridge":"﴿ذَلِكَ مَبْلَغُهُمْ مِنَ الْعِلْمِ﴾."}],"hadiths":[]},{"situationId":125,"verses":[{"i":1,"strength":"direct","bridge":"﴿إِنَّ رَبَّكَ هُوَ أَعْلَمُ مَنْ يَضِلُّ عَنْ سَبِيلِهِ﴾."}],"hadiths":[]},{"situationId":138,"verses":[{"i":2,"strength":"direct","bridge":"﴿ادْعُ إِلَى سَبِيلِ رَبِّكَ بِالْحِكْمَةِ وَالْمَوْعِظَةِ الْحَسَنَةِ﴾."}],"hadiths":[]}]},{"id":324,"name":"أعلم بمن اهتدى","compound":true,"meaning":"أعلم بمن اهتدى: يعلم المهتدين حقًّا.","teaches":"1. جاءت بعد ذمّ من لم يرد إلا الحياة الدنيا.","whenRecall":"- حين تقيس الناس بظاهرهم.","whenPray":"1. اللهم اجعلني ممن اهتدى.","summary":"الهداية الحقيقية يعلمها الله.","verses":[{"i":1,"of":1,"s":53,"surah":"النجم","a":30,"text":"ذَلِكَ مَبْلَغُهُمْ مِنَ الْعِلْمِ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَنْ ضَلَّ عَنْ سَبِيلِهِ وَهُوَ أَعْلَمُ بِمَنِ اهْتَدَى","prev":{"a":29,"text":"فَأَعْرِضْ عَنْ مَنْ تَوَلَّى عَنْ ذِكْرِنَا وَلَمْ يُرِدْ إِلَّا الْحَيَاةَ الدُّنْيَا"},"next":{"a":31,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ لِيَجْزِيَ الَّذِينَ أَسَاءُوا بِمَا عَمِلُوا وَيَجْزِيَ الَّذِينَ أَحْسَنُوا بِالْحُسْنَى"},"context":"قبلها: فأعرض عمن تولى عن ذكرنا.","reason":"العلم بالمهتدي عند الله."}],"hadiths":[],"situations":[{"situationId":59,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَهُوَ أَعْلَمُ بِمَنِ اهْتَدَى﴾."}],"hadiths":[]}]},{"id":325,"name":"أعلم بمن اتقى","compound":true,"meaning":"أعلم بمن اتقى: يعلم المتقين، فلا تزكّوا أنفسكم.","teaches":"1. جاءت بعد ذكر اجتناب الكبائر إلا اللمم وسعة المغفرة.\n2. يعلمكم منذ كنتم أجنة.","whenRecall":"- حين تزكّي نفسك.","whenPray":"1. اللهم لا تجعلني ممن يزكي نفسه.","summary":"لا تزكِّ نفسك، فهو أعلم بك منذ كنت جنينًا.","verses":[{"i":1,"of":1,"s":53,"surah":"النجم","a":32,"text":"الَّذِينَ يَجْتَنِبُونَ كَبَائِرَ الْإِثْمِ وَالْفَوَاحِشَ إِلَّا اللَّمَمَ إِنَّ رَبَّكَ وَاسِعُ الْمَغْفِرَةِ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنْشَأَكُمْ مِنَ الْأَرْضِ وَإِذْ أَنْتُمْ أَجِنَّةٌ فِي بُطُونِ أُمَّهَاتِكُمْ فَلَا تُزَكُّوا أَنْفُسَكُمْ هُوَ أَعْلَمُ بِمَنِ اتَّقَى","prev":{"a":31,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ لِيَجْزِيَ الَّذِينَ أَسَاءُوا بِمَا عَمِلُوا وَيَجْزِيَ الَّذِينَ أَحْسَنُوا بِالْحُسْنَى"},"next":{"a":33,"text":"أَفَرَأَيْتَ الَّذِي تَوَلَّى"},"context":"قبلها: ليجزي الذين أساءوا ويجزي الذين أحسنوا.","reason":"سعة المغفرة والنهي عن تزكية النفس."}],"hadiths":[],"situations":[{"situationId":82,"verses":[{"i":1,"strength":"direct","bridge":"﴿فَلَا تُزَكُّوا أَنْفُسَكُمْ هُوَ أَعْلَمُ بِمَنِ اتَّقَى﴾."}],"hadiths":[]}]},{"id":326,"name":"أعلم بمن جاء بالهدى من عنده ومن تكون له عاقبة الدار","compound":true,"meaning":"قالها موسى لفرعون: ربي أعلم بالمهتدي وبمن له العاقبة.","teaches":"1. ردٌّ على اتهام الآيات بالسحر.","whenRecall":"- حين يُتهم الحق بالباطل.","whenPray":"1. ربي أعلم بمن جاء بالهدى.","summary":"الظالمون لا يفلحون، والعاقبة يعلمها الله.","verses":[{"i":1,"of":1,"s":28,"surah":"القصص","a":37,"text":"وَقَالَ مُوسَى رَبِّي أَعْلَمُ بِمَنْ جَاءَ بِالْهُدَى مِنْ عِنْدِهِ وَمَنْ تَكُونُ لَهُ عَاقِبَةُ الدَّارِ إِنَّهُ لَا يُفْلِحُ الظَّالِمُونَ","prev":{"a":36,"text":"فَلَمَّا جَاءَهُمْ مُوسَى بِآيَاتِنَا بَيِّنَاتٍ قَالُوا مَا هَذَا إِلَّا سِحْرٌ مُفْتَرًى وَمَا سَمِعْنَا بِهَذَا فِي آبَائِنَا الْأَوَّلِينَ"},"next":{"a":38,"text":"وَقَالَ فِرْعَوْنُ يَا أَيُّهَا الْمَلَأُ مَا عَلِمْتُ لَكُمْ مِنْ إِلَهٍ غَيْرِي فَأَوْقِدْ لِي يَا هَامَانُ عَلَى الطِّينِ فَاجْعَلْ لِي صَرْحًا لَعَلِّي أَطَّلِعُ إِلَى إِلَهِ مُوسَى وَإِنِّي لَأَظُنُّهُ مِنَ الْكَاذِبِينَ"},"context":"قبلها: قالوا ما هذا إلا سحر مفترى.","reason":"فوّض موسى الحكم إلى ربه."}],"hadiths":[],"situations":[{"situationId":32,"verses":[{"i":1,"strength":"direct","bridge":"إذا وُصف الحق بالباطل: ﴿إِنَّهُ لَا يُفْلِحُ الظَّالِمُونَ﴾."}],"hadiths":[]}]},{"id":327,"name":"أعلم من جاء بالهدى ومن هو في ضلال مبين","compound":true,"meaning":"أعلم من جاء بالهدى: قالها النبي ﷺ مع وعد الرد إلى معاد.","teaches":"1. وعدٌ بالرجوع إلى مكة.","whenRecall":"- حين تغترب عن وطنك لدينك.","whenPray":"1. اللهم ردّني إلى خير.","summary":"من فرض عليك القرآن سيردك.","verses":[{"i":1,"of":1,"s":28,"surah":"القصص","a":85,"text":"إِنَّ الَّذِي فَرَضَ عَلَيْكَ الْقُرْآنَ لَرَادُّكَ إِلَى مَعَادٍ قُلْ رَبِّي أَعْلَمُ مَنْ جَاءَ بِالْهُدَى وَمَنْ هُوَ فِي ضَلَالٍ مُبِينٍ","prev":{"a":84,"text":"مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ خَيْرٌ مِنْهَا وَمَنْ جَاءَ بِالسَّيِّئَةِ فَلَا يُجْزَى الَّذِينَ عَمِلُوا السَّيِّئَاتِ إِلَّا مَا كَانُوا يَعْمَلُونَ"},"next":{"a":86,"text":"وَمَا كُنْتَ تَرْجُو أَنْ يُلْقَى إِلَيْكَ الْكِتَابُ إِلَّا رَحْمَةً مِنْ رَبِّكَ فَلَا تَكُونَنَّ ظَهِيرًا لِلْكَافِرِينَ"},"context":"قبلها: من جاء بالحسنة فله خير منها.","reason":"تسلية بعد الهجرة: لرادك إلى معاد."}],"hadiths":[],"situations":[{"situationId":129,"verses":[{"i":1,"strength":"direct","bridge":"إذا اغتربت لأجل دينك: ﴿إِنَّ الَّذِي فَرَضَ عَلَيْكَ الْقُرْآنَ لَرَادُّكَ إِلَى مَعَادٍ﴾."}],"hadiths":[]}]},{"id":328,"name":"ولي الذين آمنوا","compound":true,"meaning":"الله ولي الذين آمنوا: يتولاهم ويخرجهم من الظلمات إلى النور.","teaches":"1. جاءت بعد: لا إكراه في الدين.\n2. مقابلها: أولياء الكافرين الطاغوت.","whenRecall":"- حين تشعر بالظلمة.","whenPray":"1. اللهم تولّني وأخرجني من الظلمات إلى النور.","summary":"وليّك يخرجك من الظلمات.","verses":[{"i":1,"of":1,"s":2,"surah":"البقرة","a":257,"text":"اللَّهُ وَلِيُّ الَّذِينَ آمَنُوا يُخْرِجُهُمْ مِنَ الظُّلُمَاتِ إِلَى النُّورِ وَالَّذِينَ كَفَرُوا أَوْلِيَاؤُهُمُ الطَّاغُوتُ يُخْرِجُونَهُمْ مِنَ النُّورِ إِلَى الظُّلُمَاتِ أُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ","prev":{"a":256,"text":"لَا إِكْرَاهَ فِي الدِّينِ قَدْ تَبَيَّنَ الرُّشْدُ مِنَ الْغَيِّ فَمَنْ يَكْفُرْ بِالطَّاغُوتِ وَيُؤْمِنْ بِاللَّهِ فَقَدِ اسْتَمْسَكَ بِالْعُرْوَةِ الْوُثْقَى لَا انْفِصَامَ لَهَا وَاللَّهُ سَمِيعٌ عَلِيمٌ"},"next":{"a":258,"text":"أَلَمْ تَرَ إِلَى الَّذِي حَاجَّ إِبْرَاهِيمَ فِي رَبِّهِ أَنْ آتَاهُ اللَّهُ الْمُلْكَ إِذْ قَالَ إِبْرَاهِيمُ رَبِّيَ الَّذِي يُحْيِي وَيُمِيتُ قَالَ أَنَا أُحْيِي وَأُمِيتُ قَالَ إِبْرَاهِيمُ فَإِنَّ اللَّهَ يَأْتِي بِالشَّمْسِ مِنَ الْمَشْرِقِ فَأْتِ بِهَا مِنَ الْمَغْرِبِ فَبُهِتَ الَّذِي كَفَرَ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ"},"context":"قبلها: لا إكراه في الدين قد تبين الرشد من الغي.","reason":"الولاية للمؤمنين والإخراج إلى النور."}],"hadiths":[],"situations":[{"situationId":116,"verses":[{"i":1,"strength":"direct","bridge":"إذا اشتدت ظلمتك: ﴿اللَّهُ وَلِيُّ الَّذِينَ آمَنُوا يُخْرِجُهُمْ مِنَ الظُّلُمَاتِ إِلَى النُّورِ﴾."}],"hadiths":[]}]},{"id":329,"name":"مولى الذين آمنوا","compound":true,"meaning":"مولى الذين آمنوا: ناصرهم وسيدهم، والكافرون لا مولى لهم.","teaches":"1. جاءت بعد النظر في عاقبة الأمم.","whenRecall":"- حين تشعر بالوحدة.","whenPray":"1. اللهم أنت مولاي فنعم المولى.","summary":"لك مولى، ولا مولى لمن كفر.","verses":[{"i":1,"of":1,"s":47,"surah":"محمد","a":11,"text":"ذَلِكَ بِأَنَّ اللَّهَ مَوْلَى الَّذِينَ آمَنُوا وَأَنَّ الْكَافِرِينَ لَا مَوْلَى لَهُمْ","prev":{"a":10,"text":"أَفَلَمْ يَسِيرُوا فِي الْأَرْضِ فَيَنْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الَّذِينَ مِنْ قَبْلِهِمْ دَمَّرَ اللَّهُ عَلَيْهِمْ وَلِلْكَافِرِينَ أَمْثَالُهَا"},"next":{"a":12,"text":"إِنَّ اللَّهَ يُدْخِلُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ وَالَّذِينَ كَفَرُوا يَتَمَتَّعُونَ وَيَأْكُلُونَ كَمَا تَأْكُلُ الْأَنْعَامُ وَالنَّارُ مَثْوًى لَهُمْ"},"context":"قبلها: أفلم يسيروا في الأرض فينظروا.","reason":"الولاية للمؤمنين."}],"hadiths":[],"situations":[{"situationId":6,"verses":[{"i":1,"strength":"direct","bridge":"إذا تخلّى عنك الناس: ﴿ذَلِكَ بِأَنَّ اللَّهَ مَوْلَى الَّذِينَ آمَنُوا﴾."}],"hadiths":[]}]},{"id":330,"name":"هاد الذين آمنوا إلى صراط مستقيم","compound":true,"meaning":"هاد الذين آمنوا: يهديهم إلى الصراط المستقيم.","teaches":"1. بعد ذكر ما يلقي الشيطان من فتنة.\n2. أهل العلم يؤمنون وتخبت قلوبهم.","whenRecall":"- حين تخاف الفتنة والشبهة.","whenPray":"1. اهدنا الصراط المستقيم.","summary":"مع الشبهات، الهداية للمؤمنين.","verses":[{"i":1,"of":1,"s":22,"surah":"الحج","a":54,"text":"وَلِيَعْلَمَ الَّذِينَ أُوتُوا الْعِلْمَ أَنَّهُ الْحَقُّ مِنْ رَبِّكَ فَيُؤْمِنُوا بِهِ فَتُخْبِتَ لَهُ قُلُوبُهُمْ وَإِنَّ اللَّهَ لَهَادِ الَّذِينَ آمَنُوا إِلَى صِرَاطٍ مُسْتَقِيمٍ","prev":{"a":53,"text":"لِيَجْعَلَ مَا يُلْقِي الشَّيْطَانُ فِتْنَةً لِلَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ وَالْقَاسِيَةِ قُلُوبُهُمْ وَإِنَّ الظَّالِمِينَ لَفِي شِقَاقٍ بَعِيدٍ"},"next":{"a":55,"text":"وَلَا يَزَالُ الَّذِينَ كَفَرُوا فِي مِرْيَةٍ مِنْهُ حَتَّى تَأْتِيَهُمُ السَّاعَةُ بَغْتَةً أَوْ يَأْتِيَهُمْ عَذَابُ يَوْمٍ عَقِيمٍ"},"context":"قبلها: ليجعل ما يلقي الشيطان فتنة.","reason":"أهل العلم يزدادون إيمانًا وإخباتًا."}],"hadiths":[],"situations":[{"situationId":104,"verses":[{"i":1,"strength":"direct","bridge":"إذا عرضت لك شبهة: ﴿وَإِنَّ اللَّهَ لَهَادِ الَّذِينَ آمَنُوا إِلَى صِرَاطٍ مُسْتَقِيمٍ﴾."}],"hadiths":[]}]},{"id":331,"name":"غفار لمن تاب وآمن وعمل صالحًا ثم اهتدى","compound":true,"meaning":"غفار لمن تاب: كثير المغفرة لمن جمع التوبة والإيمان والعمل والثبات.","teaches":"1. أربعة شروط: تاب، آمن، عمل صالحًا، ثم اهتدى.","whenRecall":"- بعد التوبة.","whenPray":"1. يا غفار اغفر لي.","summary":"التوبة طريق له أربع خطوات.","verses":[{"i":1,"of":1,"s":20,"surah":"طه","a":82,"text":"وَإِنِّي لَغَفَّارٌ لِمَنْ تَابَ وَآمَنَ وَعَمِلَ صَالِحًا ثُمَّ اهْتَدَى","prev":{"a":81,"text":"كُلُوا مِنْ طَيِّبَاتِ مَا رَزَقْنَاكُمْ وَلَا تَطْغَوْا فِيهِ فَيَحِلَّ عَلَيْكُمْ غَضَبِي وَمَنْ يَحْلِلْ عَلَيْهِ غَضَبِي فَقَدْ هَوَى"},"next":{"a":83,"text":"وَمَا أَعْجَلَكَ عَنْ قَوْمِكَ يَا مُوسَى"},"context":"قبلها: ولا تطغوا فيه فيحل عليكم غضبي.","reason":"بعد الوعيد باب المغفرة."}],"hadiths":[],"situations":[{"situationId":24,"verses":[{"i":1,"strength":"direct","bridge":"بعد ذنبك: ﴿وَإِنِّي لَغَفَّارٌ لِمَنْ تَابَ وَآمَنَ وَعَمِلَ صَالِحًا ثُمَّ اهْتَدَى﴾."}],"hadiths":[]}]},{"id":332,"name":"إن ربك للذين هاجروا من بعد ما فتنوا ثم جاهدوا وصبروا إن ربك من بعدها لغفور رحيم","compound":true,"meaning":"المغفرة لمن فُتن ثم هاجر وجاهد وصبر.","teaches":"1. نزلت في من فُتن في مكة ثم هاجر.","whenRecall":"- حين تحمل ماضيًا من الضعف.","whenPray":"1. اللهم اغفر لي ضعفي.","summary":"الفتنة لا تُغلق الباب إذا تبعتها هجرة وصبر.","verses":[{"i":1,"of":1,"s":16,"surah":"النحل","a":110,"text":"ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ هَاجَرُوا مِنْ بَعْدِ مَا فُتِنُوا ثُمَّ جَاهَدُوا وَصَبَرُوا إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ","prev":{"a":109,"text":"لَا جَرَمَ أَنَّهُمْ فِي الْآخِرَةِ هُمُ الْخَاسِرُونَ"},"next":{"a":111,"text":"يَوْمَ تَأْتِي كُلُّ نَفْسٍ تُجَادِلُ عَنْ نَفْسِهَا وَتُوَفَّى كُلُّ نَفْسٍ مَا عَمِلَتْ وَهُمْ لَا يُظْلَمُونَ"},"context":"قبلها: في الآخرة هم الخاسرون.","reason":"باب المغفرة لمن فُتن ثم صبر."}],"hadiths":[{"i":1,"of":1,"text":"لَمَّا نزلتْ: {إِنَّ الَّذِينَ تَوَفَّاهُمُ الْمَلَائِكَةُ ظَالِمِي أَنفُسِهِمْ} [النساء: 97] قال: كان قومٌ بمكَّةَ قد أسلَموا، وكانوا مُستَخْفينَ بالإسلامِ، فلما خَرَجَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ إلى بدرٍ وخَرَجَ المُشرِكون، أخرَجوهم معهم مُكرَهينَ، فأُصيبَ بعضُهُم يومَ بدرٍ مع المُشرِكينَ، فقال المُسلِمونُ: أصحابُنا هؤلاءِ كانوا مُسلِمينَ، أخرَجوهم مُكرَهينَ، فاسْتغفِروا لهم، فنَزَلَتْ، كَتَبوها إلى مَنْ بَقِيَ منهم بمكَّةَ، فخَرَجوا حتى إذا كانوا ببعضِ الطَّريقِ ظَهَرَ عليهم المُشرِكون وعلى خُروجِهم، فلَحِقوهم، فرَدُّوهم، فرَجَعوا معهم فنزلتْ: {وَمِنَ النَّاسِ مَنْ يَقُولُ آمَنَّا بِاللَّهِ فَإِذَا أُوذِيَ فِي اللَّهِ جَعَلَ فِتْنَةَ النَّاسِ كَعَذَابِ اللَّهِ} [العنكبوت: 10]، فكَتَبَ المُسلِمونَ إليهم بذلك، فنزلتْ: {ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ هَاجَرُوا مِن بَعْدِ مَا فُتِنُوا ثُمَّ جَاهَدُوا وَصَبَرُوا إِنَّ رَبَّكَ مِن بَعْدِهَا لَغَفُورٌ رَحِيمٌ} [النحل: 110]، فكَتَبوا إليهم بذلك.","narrator":"عبدالله بن عباس","source":"تخريج العواصم والقواصم 1/ 341","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/WkSBBX2p","nameForm":"إن ربك للذين هاجروا من بعد ما فتنوا ثم جاهدوا وصبروا إن ربك من بعدها لغفور رحيم"}],"sunnah":{},"situations":[{"situationId":17,"verses":[{"i":1,"strength":"direct","bridge":"إن ضعفت ثم رجعت: ﴿ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ هَاجَرُوا مِنْ بَعْدِ مَا فُتِنُوا﴾."}],"hadiths":[]}]},{"id":333,"name":"إن ربك للذين عملوا السوء بجهالة ثم تابوا من بعد ذلك وأصلحوا إن ربك من بعدها لغفور رحيم","compound":true,"meaning":"المغفرة لمن عمل السوء بجهالة ثم تاب وأصلح.","teaches":"1. التوبة والإصلاح بعد السوء.","whenRecall":"- بعد ذنب بجهل.","whenPray":"1. رب اغفر وأصلح.","summary":"تب وأصلح، فربك غفور رحيم.","verses":[{"i":1,"of":1,"s":16,"surah":"النحل","a":119,"text":"ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ عَمِلُوا السُّوءَ بِجَهَالَةٍ ثُمَّ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ","prev":{"a":118,"text":"وَعَلَى الَّذِينَ هَادُوا حَرَّمْنَا مَا قَصَصْنَا عَلَيْكَ مِنْ قَبْلُ وَمَا ظَلَمْنَاهُمْ وَلَكِنْ كَانُوا أَنْفُسَهُمْ يَظْلِمُونَ"},"next":{"a":120,"text":"إِنَّ إِبْرَاهِيمَ كَانَ أُمَّةً قَانِتًا لِلَّهِ حَنِيفًا وَلَمْ يَكُ مِنَ الْمُشْرِكِينَ"},"context":"قبلها: على الذين هادوا حرمنا.","reason":"باب التوبة لمن عمل بجهالة."}],"hadiths":[],"situations":[{"situationId":26,"verses":[{"i":1,"strength":"direct","bridge":"﴿ثُمَّ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ﴾."}],"hadiths":[]}]},{"id":334,"name":"مخرج ما كنتم تكتمون","compound":true,"meaning":"مخرج ما كنتم تكتمون: يكشف ما يُخفى.","teaches":"1. في قصة البقرة والقتيل.","whenRecall":"- حين تكتم جريمة أو خطأ.","whenPray":"1. اللهم استرني.","summary":"ما تكتمه سيُخرجه الله.","verses":[{"i":1,"of":1,"s":2,"surah":"البقرة","a":72,"text":"وَإِذْ قَتَلْتُمْ نَفْسًا فَادَّارَأْتُمْ فِيهَا وَاللَّهُ مُخْرِجٌ مَا كُنْتُمْ تَكْتُمُونَ","prev":{"a":71,"text":"قَالَ إِنَّهُ يَقُولُ إِنَّهَا بَقَرَةٌ لَا ذَلُولٌ تُثِيرُ الْأَرْضَ وَلَا تَسْقِي الْحَرْثَ مُسَلَّمَةٌ لَا شِيَةَ فِيهَا قَالُوا الْآنَ جِئْتَ بِالْحَقِّ فَذَبَحُوهَا وَمَا كَادُوا يَفْعَلُونَ"},"next":{"a":73,"text":"فَقُلْنَا اضْرِبُوهُ بِبَعْضِهَا كَذَلِكَ يُحْيِي اللَّهُ الْمَوْتَى وَيُرِيكُمْ آيَاتِهِ لَعَلَّكُمْ تَعْقِلُونَ"},"context":"قصة البقرة.","reason":"كشف القاتل بعد التدافع."}],"hadiths":[],"situations":[{"situationId":86,"verses":[{"i":1,"strength":"direct","bridge":"لا تراهن على الكتمان: ﴿وَاللَّهُ مُخْرِجٌ مَا كُنْتُمْ تَكْتُمُونَ﴾."}],"hadiths":[]}]},{"id":335,"name":"مخرج ما تحذرون","compound":true,"meaning":"مخرج ما تحذرون: سيُظهر ما يخاف المنافقون ظهوره.","teaches":"1. المنافقون يحذرون نزول سورة تفضحهم.","whenRecall":"- حين تخفي النفاق.","whenPray":"1. اللهم طهر قلبي من النفاق.","summary":"ما في القلوب سيظهر.","verses":[{"i":1,"of":1,"s":9,"surah":"التوبة","a":64,"text":"يَحْذَرُ الْمُنَافِقُونَ أَنْ تُنَزَّلَ عَلَيْهِمْ سُورَةٌ تُنَبِّئُهُمْ بِمَا فِي قُلُوبِهِمْ قُلِ اسْتَهْزِئُوا إِنَّ اللَّهَ مُخْرِجٌ مَا تَحْذَرُونَ","prev":{"a":63,"text":"أَلَمْ يَعْلَمُوا أَنَّهُ مَنْ يُحَادِدِ اللَّهَ وَرَسُولَهُ فَأَنَّ لَهُ نَارَ جَهَنَّمَ خَالِدًا فِيهَا ذَلِكَ الْخِزْيُ الْعَظِيمُ"},"next":{"a":65,"text":"وَلَئِنْ سَأَلْتَهُمْ لَيَقُولُنَّ إِنَّمَا كُنَّا نَخُوضُ وَنَلْعَبُ قُلْ أَبِاللَّهِ وَآيَاتِهِ وَرَسُولِهِ كُنْتُمْ تَسْتَهْزِئُونَ"},"context":"قبلها: من يحادد الله ورسوله.","reason":"فضح ما في القلوب."}],"hadiths":[],"situations":[{"situationId":85,"verses":[{"i":1,"strength":"direct","bridge":"﴿يَحْذَرُ الْمُنَافِقُونَ أَنْ تُنَزَّلَ عَلَيْهِمْ سُورَةٌ تُنَبِّئُهُمْ بِمَا فِي قُلُوبِهِمْ﴾."}],"hadiths":[]}]},{"id":336,"name":"عليم بما يفعلون","compound":true,"meaning":"عليم بما يفعلون: يعلم أفعالهم، ومنها اتباع الظن.","teaches":"1. مع اتباع الظن.\n2. ومع صلاة الطير وتسبيحها.","whenRecall":"- حين تتبع الظن.","whenPray":"1. اللهم علمني الحق.","summary":"الظن لا يغني من الحق شيئًا.","verses":[{"i":1,"of":2,"s":10,"surah":"يونس","a":36,"text":"وَمَا يَتَّبِعُ أَكْثَرُهُمْ إِلَّا ظَنًّا إِنَّ الظَّنَّ لَا يُغْنِي مِنَ الْحَقِّ شَيْئًا إِنَّ اللَّهَ عَلِيمٌ بِمَا يَفْعَلُونَ","prev":{"a":35,"text":"قُلْ هَلْ مِنْ شُرَكَائِكُمْ مَنْ يَهْدِي إِلَى الْحَقِّ قُلِ اللَّهُ يَهْدِي لِلْحَقِّ أَفَمَنْ يَهْدِي إِلَى الْحَقِّ أَحَقُّ أَنْ يُتَّبَعَ أَمَّنْ لَا يَهِدِّي إِلَّا أَنْ يُهْدَى فَمَا لَكُمْ كَيْفَ تَحْكُمُونَ"},"next":{"a":37,"text":"وَمَا كَانَ هَذَا الْقُرْآنُ أَنْ يُفْتَرَى مِنْ دُونِ اللَّهِ وَلَكِنْ تَصْدِيقَ الَّذِي بَيْنَ يَدَيْهِ وَتَفْصِيلَ الْكِتَابِ لَا رَيْبَ فِيهِ مِنْ رَبِّ الْعَالَمِينَ"},"context":"قبلها: هل من شركائكم من يهدي إلى الحق.","reason":"اتباع الظن."},{"i":2,"of":2,"s":24,"surah":"النور","a":41,"text":"أَلَمْ تَرَ أَنَّ اللَّهَ يُسَبِّحُ لَهُ مَنْ فِي السَّمَاوَاتِ وَالْأَرْضِ وَالطَّيْرُ صَافَّاتٍ كُلٌّ قَدْ عَلِمَ صَلَاتَهُ وَتَسْبِيحَهُ وَاللَّهُ عَلِيمٌ بِمَا يَفْعَلُونَ","prev":{"a":40,"text":"أَوْ كَظُلُمَاتٍ فِي بَحْرٍ لُجِّيٍّ يَغْشَاهُ مَوْجٌ مِنْ فَوْقِهِ مَوْجٌ مِنْ فَوْقِهِ سَحَابٌ ظُلُمَاتٌ بَعْضُهَا فَوْقَ بَعْضٍ إِذَا أَخْرَجَ يَدَهُ لَمْ يَكَدْ يَرَاهَا وَمَنْ لَمْ يَجْعَلِ اللَّهُ لَهُ نُورًا فَمَا لَهُ مِنْ نُورٍ"},"next":{"a":42,"text":"وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَإِلَى اللَّهِ الْمَصِيرُ"},"context":"قبلها: ظلمات في بحر لجي.","reason":"كل شيء يسبح."}],"hadiths":[],"situations":[{"situationId":59,"verses":[{"i":1,"strength":"direct","bridge":"﴿إِنَّ الظَّنَّ لَا يُغْنِي مِنَ الْحَقِّ شَيْئًا﴾."}],"hadiths":[]},{"situationId":179,"verses":[{"i":2,"strength":"direct","bridge":"﴿كُلٌّ قَدْ عَلِمَ صَلَاتَهُ وَتَسْبِيحَهُ﴾."}],"hadiths":[]}]},{"id":337,"name":"عليم بما يصنعون","compound":true,"meaning":"عليم بما يصنعون: يعلم صنيعهم؛ فلا تذهب نفسك عليهم حسرات.","teaches":"1. من زُين له سوء عمله.","whenRecall":"- حين تتحسر على من ضل.","whenPray":"1. اللهم أرني الحق حقًّا.","summary":"لا تتحسر على من زُين له سوء عمله.","verses":[{"i":1,"of":1,"s":35,"surah":"فاطر","a":8,"text":"أَفَمَنْ زُيِّنَ لَهُ سُوءُ عَمَلِهِ فَرَآهُ حَسَنًا فَإِنَّ اللَّهَ يُضِلُّ مَنْ يَشَاءُ وَيَهْدِي مَنْ يَشَاءُ فَلَا تَذْهَبْ نَفْسُكَ عَلَيْهِمْ حَسَرَاتٍ إِنَّ اللَّهَ عَلِيمٌ بِمَا يَصْنَعُونَ","prev":{"a":7,"text":"الَّذِينَ كَفَرُوا لَهُمْ عَذَابٌ شَدِيدٌ وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ مَغْفِرَةٌ وَأَجْرٌ كَبِيرٌ"},"next":{"a":9,"text":"وَاللَّهُ الَّذِي أَرْسَلَ الرِّيَاحَ فَتُثِيرُ سَحَابًا فَسُقْنَاهُ إِلَى بَلَدٍ مَيِّتٍ فَأَحْيَيْنَا بِهِ الْأَرْضَ بَعْدَ مَوْتِهَا كَذَلِكَ النُّشُورُ"},"context":"قبلها: للذين كفروا عذاب شديد.","reason":"النهي عن الحسرة."}],"hadiths":[],"situations":[{"situationId":131,"verses":[{"i":1,"strength":"direct","bridge":"﴿فَلَا تَذْهَبْ نَفْسُكَ عَلَيْهِمْ حَسَرَاتٍ﴾."}],"hadiths":[]}]},{"id":338,"name":"عليم بما يعملون","compound":true,"meaning":"عليم بما يعملون: علمه بما يجري في قصة يوسف.","teaches":"1. السيارة أسرّوه بضاعة.","whenRecall":"- حين تُعامل كسلعة.","whenPray":"1. اللهم أنت تعلم حالي.","summary":"ما يُفعل بك معلوم عنده.","verses":[{"i":1,"of":1,"s":12,"surah":"يوسف","a":19,"text":"وَجَاءَتْ سَيَّارَةٌ فَأَرْسَلُوا وَارِدَهُمْ فَأَدْلَى دَلْوَهُ قَالَ يَا بُشْرَى هَذَا غُلَامٌ وَأَسَرُّوهُ بِضَاعَةً وَاللَّهُ عَلِيمٌ بِمَا يَعْمَلُونَ","prev":{"a":18,"text":"وَجَاءُوا عَلَى قَمِيصِهِ بِدَمٍ كَذِبٍ قَالَ بَلْ سَوَّلَتْ لَكُمْ أَنْفُسُكُمْ أَمْرًا فَصَبْرٌ جَمِيلٌ وَاللَّهُ الْمُسْتَعَانُ عَلَى مَا تَصِفُونَ"},"next":{"a":20,"text":"وَشَرَوْهُ بِثَمَنٍ بَخْسٍ دَرَاهِمَ مَعْدُودَةٍ وَكَانُوا فِيهِ مِنَ الزَّاهِدِينَ"},"context":"قبلها: جاؤوا على قميصه بدم كذب.","reason":"بيع يوسف بضاعة."}],"hadiths":[],"situations":[{"situationId":28,"verses":[{"i":1,"strength":"direct","bridge":"إذا ظُلمت وبُخست: ﴿وَأَسَرُّوهُ بِضَاعَةً وَاللَّهُ عَلِيمٌ بِمَا يَعْمَلُونَ﴾."}],"hadiths":[]}]},{"id":339,"name":"عليم بما كنتم تعملون","compound":true,"meaning":"عليم بما كنتم تعملون: إنكار الظالمين عند الموت لا ينفع.","teaches":"1. الملائكة تتوفى الظالمين فيقولون: ما كنا نعمل من سوء.","whenRecall":"- حين تنكر ذنبك.","whenPray":"1. اللهم أحسن خاتمتي.","summary":"الإنكار عند الموت لا يُغني.","verses":[{"i":1,"of":1,"s":16,"surah":"النحل","a":28,"text":"الَّذِينَ تَتَوَفَّاهُمُ الْمَلَائِكَةُ ظَالِمِي أَنْفُسِهِمْ فَأَلْقَوُا السَّلَمَ مَا كُنَّا نَعْمَلُ مِنْ سُوءٍ بَلَى إِنَّ اللَّهَ عَلِيمٌ بِمَا كُنْتُمْ تَعْمَلُونَ","prev":{"a":27,"text":"ثُمَّ يَوْمَ الْقِيَامَةِ يُخْزِيهِمْ وَيَقُولُ أَيْنَ شُرَكَائِيَ الَّذِينَ كُنْتُمْ تُشَاقُّونَ فِيهِمْ قَالَ الَّذِينَ أُوتُوا الْعِلْمَ إِنَّ الْخِزْيَ الْيَوْمَ وَالسُّوءَ عَلَى الْكَافِرِينَ"},"next":{"a":29,"text":"فَادْخُلُوا أَبْوَابَ جَهَنَّمَ خَالِدِينَ فِيهَا فَلَبِئْسَ مَثْوَى الْمُتَكَبِّرِينَ"},"context":"قبلها: يوم القيامة يخزيهم.","reason":"إنكارهم يُرد بعلم الله."}],"hadiths":[],"situations":[{"situationId":115,"verses":[{"i":1,"strength":"direct","bridge":"﴿مَا كُنَّا نَعْمَلُ مِنْ سُوءٍ بَلَى إِنَّ اللَّهَ عَلِيمٌ بِمَا كُنْتُمْ تَعْمَلُونَ﴾."}],"hadiths":[]}]},{"id":340,"name":"بما يعملون خبير","compound":true,"meaning":"بما يعملون خبير: سيوفّي كلًّا عمله.","teaches":"1. بعد الاختلاف في كتاب موسى.","whenRecall":"- حين تخاف ضياع حقك.","whenPray":"1. اللهم وفِّني عملي.","summary":"كل سيُوفّى عمله.","verses":[{"i":1,"of":1,"s":11,"surah":"هود","a":111,"text":"وَإِنَّ كُلًّا لَمَّا لَيُوَفِّيَنَّهُمْ رَبُّكَ أَعْمَالَهُمْ إِنَّهُ بِمَا يَعْمَلُونَ خَبِيرٌ","prev":{"a":110,"text":"وَلَقَدْ آتَيْنَا مُوسَى الْكِتَابَ فَاخْتُلِفَ فِيهِ وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِنْ رَبِّكَ لَقُضِيَ بَيْنَهُمْ وَإِنَّهُمْ لَفِي شَكٍّ مِنْهُ مُرِيبٍ"},"next":{"a":112,"text":"فَاسْتَقِمْ كَمَا أُمِرْتَ وَمَنْ تَابَ مَعَكَ وَلَا تَطْغَوْا إِنَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ"},"context":"قبلها: آتينا موسى الكتاب فاختلف فيه.","reason":"التوفية التامة."}],"hadiths":[],"situations":[{"situationId":171,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَإِنَّ كُلًّا لَمَّا لَيُوَفِّيَنَّهُمْ رَبُّكَ أَعْمَالَهُمْ﴾."}],"hadiths":[]}]},{"id":341,"name":"خبير بما يصنعون","compound":true,"meaning":"خبير بما يصنعون: يعلم النظرة والخاطرة.","teaches":"1. الأمر بغض البصر وحفظ الفرج.","whenRecall":"- حين يُغرى بصرك.","whenPray":"1. اللهم حصّن فرجي واحفظ بصري.","summary":"غضّ البصر أزكى، والله خبير بما تصنع.","verses":[{"i":1,"of":1,"s":24,"surah":"النور","a":30,"text":"قُلْ لِلْمُؤْمِنِينَ يَغُضُّوا مِنْ أَبْصَارِهِمْ وَيَحْفَظُوا فُرُوجَهُمْ ذَلِكَ أَزْكَى لَهُمْ إِنَّ اللَّهَ خَبِيرٌ بِمَا يَصْنَعُونَ","prev":{"a":29,"text":"لَيْسَ عَلَيْكُمْ جُنَاحٌ أَنْ تَدْخُلُوا بُيُوتًا غَيْرَ مَسْكُونَةٍ فِيهَا مَتَاعٌ لَكُمْ وَاللَّهُ يَعْلَمُ مَا تُبْدُونَ وَمَا تَكْتُمُونَ"},"next":{"a":31,"text":"وَقُلْ لِلْمُؤْمِنَاتِ يَغْضُضْنَ مِنْ أَبْصَارِهِنَّ وَيَحْفَظْنَ فُرُوجَهُنَّ وَلَا يُبْدِينَ زِينَتَهُنَّ إِلَّا مَا ظَهَرَ مِنْهَا وَلْيَضْرِبْنَ بِخُمُرِهِنَّ عَلَى جُيُوبِهِنَّ وَلَا يُبْدِينَ زِينَتَهُنَّ إِلَّا لِبُعُولَتِهِنَّ أَوْ آبَائِهِنَّ أَوْ آبَاءِ بُعُولَتِهِنَّ أَوْ أَبْنَائِهِنَّ أَوْ أَبْنَاءِ بُعُولَتِهِنَّ أَوْ إِخْوَانِهِنَّ أَوْ بَنِي إِخْوَانِهِنَّ أَوْ بَنِي أَخَوَاتِهِنَّ أَوْ نِسَائِهِنَّ أَوْ مَا مَلَكَتْ أَيْمَانُهُنَّ أَوِ التَّابِعِينَ غَيْرِ أُولِي الْإِرْبَةِ مِنَ الرِّجَالِ أَوِ الطِّفْلِ الَّذِينَ لَمْ يَظْهَرُوا عَلَى عَوْرَاتِ النِّسَاءِ وَلَا يَضْرِبْنَ بِأَرْجُلِهِنَّ لِيُعْلَمَ مَا يُخْفِينَ مِنْ زِينَتِهِنَّ وَتُوبُوا إِلَى اللَّهِ جَمِيعًا أَيُّهَ الْمُؤْمِنُونَ لَعَلَّكُمْ تُفْلِحُونَ"},"context":"قبلها: آداب دخول البيوت.","reason":"غض البصر وحفظ الفرج."}],"hadiths":[],"situations":[{"situationId":74,"verses":[{"i":1,"strength":"direct","bridge":"﴿قُلْ لِلْمُؤْمِنِينَ يَغُضُّوا مِنْ أَبْصَارِهِمْ وَيَحْفَظُوا فُرُوجَهُمْ ذَلِكَ أَزْكَى لَهُمْ﴾."}],"hadiths":[]}]},{"id":342,"name":"خبير بما تفعلون","compound":true,"meaning":"خبير بما تفعلون: صنع الله المتقن، وخبرته بأفعالكم.","teaches":"1. الجبال تمر مر السحاب.","whenRecall":"- حين تتأمل إتقان الخلق.","whenPray":"1. سبحان من أتقن كل شيء.","summary":"من أتقن كل شيء خبير بعملك.","verses":[{"i":1,"of":1,"s":27,"surah":"النمل","a":88,"text":"وَتَرَى الْجِبَالَ تَحْسَبُهَا جَامِدَةً وَهِيَ تَمُرُّ مَرَّ السَّحَابِ صُنْعَ اللَّهِ الَّذِي أَتْقَنَ كُلَّ شَيْءٍ إِنَّهُ خَبِيرٌ بِمَا تَفْعَلُونَ","prev":{"a":87,"text":"وَيَوْمَ يُنْفَخُ فِي الصُّورِ فَفَزِعَ مَنْ فِي السَّمَاوَاتِ وَمَنْ فِي الْأَرْضِ إِلَّا مَنْ شَاءَ اللَّهُ وَكُلٌّ أَتَوْهُ دَاخِرِينَ"},"next":{"a":89,"text":"مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ خَيْرٌ مِنْهَا وَهُمْ مِنْ فَزَعٍ يَوْمَئِذٍ آمِنُونَ"},"context":"قبلها: يوم ينفخ في الصور.","reason":"الجبال تمر، صنع الله."}],"hadiths":[],"situations":[{"situationId":175,"verses":[{"i":1,"strength":"direct","bridge":"﴿صُنْعَ اللَّهِ الَّذِي أَتْقَنَ كُلَّ شَيْءٍ﴾."}],"hadiths":[]}]},{"id":343,"name":"أعلم بما تعملون","compound":true,"meaning":"الله أعلم بما تعملون: جوابٌ يُنهي الجدال.","teaches":"1. في الحج: إن جادلوك فقل.\n2. قالها شعيب لقومه.","whenRecall":"- حين يطول الجدال العقيم.","whenPray":"1. الله أعلم بما تعملون.","summary":"إذا طال الجدال فأحِل إلى علم الله.","verses":[{"i":1,"of":2,"s":22,"surah":"الحج","a":68,"text":"وَإِنْ جَادَلُوكَ فَقُلِ اللَّهُ أَعْلَمُ بِمَا تَعْمَلُونَ","prev":{"a":67,"text":"لِكُلِّ أُمَّةٍ جَعَلْنَا مَنْسَكًا هُمْ نَاسِكُوهُ فَلَا يُنَازِعُنَّكَ فِي الْأَمْرِ وَادْعُ إِلَى رَبِّكَ إِنَّكَ لَعَلَى هُدًى مُسْتَقِيمٍ"},"next":{"a":69,"text":"اللَّهُ يَحْكُمُ بَيْنَكُمْ يَوْمَ الْقِيَامَةِ فِيمَا كُنْتُمْ فِيهِ تَخْتَلِفُونَ"},"context":"قبلها: لكل أمة منسك.","reason":"ترك الجدال."},{"i":2,"of":2,"s":26,"surah":"الشعراء","a":188,"text":"قَالَ رَبِّي أَعْلَمُ بِمَا تَعْمَلُونَ","prev":{"a":187,"text":"فَأَسْقِطْ عَلَيْنَا كِسَفًا مِنَ السَّمَاءِ إِنْ كُنْتَ مِنَ الصَّادِقِينَ"},"next":{"a":189,"text":"فَكَذَّبُوهُ فَأَخَذَهُمْ عَذَابُ يَوْمِ الظُّلَّةِ إِنَّهُ كَانَ عَذَابَ يَوْمٍ عَظِيمٍ"},"context":"قوم شعيب: أسقط علينا كسفًا.","reason":"تفويض العقوبة."}],"hadiths":[],"situations":[{"situationId":133,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَإِنْ جَادَلُوكَ فَقُلِ اللَّهُ أَعْلَمُ بِمَا تَعْمَلُونَ﴾."}],"hadiths":[]},{"situationId":136,"verses":[{"i":2,"strength":"direct","bridge":"إذا استعجلوك بالعقوبة: ﴿قَالَ رَبِّي أَعْلَمُ بِمَا تَعْمَلُونَ﴾."}],"hadiths":[]}]},{"id":344,"name":"أعلم بما يفعلون","compound":true,"meaning":"أعلم بما يفعلون: يوم القيامة توفّى كل نفس.","teaches":"1. بعد وضع الكتاب ومجيء النبيين والشهداء.","whenRecall":"- حين تتذكر الحساب.","whenPray":"1. اللهم يسّر حسابي.","summary":"تُوفّى كل نفس ما عملت.","verses":[{"i":1,"of":1,"s":39,"surah":"الزمر","a":70,"text":"وَوُفِّيَتْ كُلُّ نَفْسٍ مَا عَمِلَتْ وَهُوَ أَعْلَمُ بِمَا يَفْعَلُونَ","prev":{"a":69,"text":"وَأَشْرَقَتِ الْأَرْضُ بِنُورِ رَبِّهَا وَوُضِعَ الْكِتَابُ وَجِيءَ بِالنَّبِيِّينَ وَالشُّهَدَاءِ وَقُضِيَ بَيْنَهُمْ بِالْحَقِّ وَهُمْ لَا يُظْلَمُونَ"},"next":{"a":71,"text":"وَسِيقَ الَّذِينَ كَفَرُوا إِلَى جَهَنَّمَ زُمَرًا حَتَّى إِذَا جَاءُوهَا فُتِحَتْ أَبْوَابُهَا وَقَالَ لَهُمْ خَزَنَتُهَا أَلَمْ يَأْتِكُمْ رُسُلٌ مِنْكُمْ يَتْلُونَ عَلَيْكُمْ آيَاتِ رَبِّكُمْ وَيُنْذِرُونَكُمْ لِقَاءَ يَوْمِكُمْ هَذَا قَالُوا بَلَى وَلَكِنْ حَقَّتْ كَلِمَةُ الْعَذَابِ عَلَى الْكَافِرِينَ"},"context":"قبلها: أشرقت الأرض بنور ربها.","reason":"التوفية."}],"hadiths":[],"situations":[{"situationId":185,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَوُفِّيَتْ كُلُّ نَفْسٍ مَا عَمِلَتْ﴾."}],"hadiths":[]}]},{"id":345,"name":"أعلم بما يكتمون","compound":true,"meaning":"أعلم بما يكتمون: يعلم ما يُخفيه المنافقون.","teaches":"1. المنافقون يوم أحد: لو نعلم قتالًا لاتبعناكم.","whenRecall":"- حين تقول بلسانك ما ليس في قلبك.","whenPray":"1. اللهم طهر قلبي.","summary":"ما تكتمه يعلمه.","verses":[{"i":1,"of":1,"s":3,"surah":"آل عمران","a":167,"text":"وَلِيَعْلَمَ الَّذِينَ نَافَقُوا وَقِيلَ لَهُمْ تَعَالَوْا قَاتِلُوا فِي سَبِيلِ اللَّهِ أَوِ ادْفَعُوا قَالُوا لَوْ نَعْلَمُ قِتَالًا لَاتَّبَعْنَاكُمْ هُمْ لِلْكُفْرِ يَوْمَئِذٍ أَقْرَبُ مِنْهُمْ لِلْإِيمَانِ يَقُولُونَ بِأَفْوَاهِهِمْ مَا لَيْسَ فِي قُلُوبِهِمْ وَاللَّهُ أَعْلَمُ بِمَا يَكْتُمُونَ","prev":{"a":166,"text":"وَمَا أَصَابَكُمْ يَوْمَ الْتَقَى الْجَمْعَانِ فَبِإِذْنِ اللَّهِ وَلِيَعْلَمَ الْمُؤْمِنِينَ"},"next":{"a":168,"text":"الَّذِينَ قَالُوا لِإِخْوَانِهِمْ وَقَعَدُوا لَوْ أَطَاعُونَا مَا قُتِلُوا قُلْ فَادْرَءُوا عَنْ أَنْفُسِكُمُ الْمَوْتَ إِنْ كُنْتُمْ صَادِقِينَ"},"context":"بعد أحد.","reason":"قالوا بأفواههم ما ليس في قلوبهم."}],"hadiths":[],"situations":[{"situationId":85,"verses":[{"i":1,"strength":"direct","bridge":"﴿هُمْ لِلْكُفْرِ يَوْمَئِذٍ أَقْرَبُ مِنْهُمْ لِلْإِيمَانِ﴾."}],"hadiths":[]}]},{"id":346,"name":"أعلم بما كانوا يكتمون","compound":true,"meaning":"أعلم بما كانوا يكتمون: دخلوا بالكفر وخرجوا به.","teaches":"1. يقولون آمنا وهم كافرون.","whenRecall":"- حين تتظاهر.","whenPray":"1. اللهم اجعل سريرتي خيرًا من علانيتي.","summary":"الدخول والخروج بالكفر لا يخفى.","verses":[{"i":1,"of":1,"s":5,"surah":"المائدة","a":61,"text":"وَإِذَا جَاءُوكُمْ قَالُوا آمَنَّا وَقَدْ دَخَلُوا بِالْكُفْرِ وَهُمْ قَدْ خَرَجُوا بِهِ وَاللَّهُ أَعْلَمُ بِمَا كَانُوا يَكْتُمُونَ","prev":{"a":60,"text":"قُلْ هَلْ أُنَبِّئُكُمْ بِشَرٍّ مِنْ ذَلِكَ مَثُوبَةً عِنْدَ اللَّهِ مَنْ لَعَنَهُ اللَّهُ وَغَضِبَ عَلَيْهِ وَجَعَلَ مِنْهُمُ الْقِرَدَةَ وَالْخَنَازِيرَ وَعَبَدَ الطَّاغُوتَ أُولَئِكَ شَرٌّ مَكَانًا وَأَضَلُّ عَنْ سَوَاءِ السَّبِيلِ"},"next":{"a":62,"text":"وَتَرَى كَثِيرًا مِنْهُمْ يُسَارِعُونَ فِي الْإِثْمِ وَالْعُدْوَانِ وَأَكْلِهِمُ السُّحْتَ لَبِئْسَ مَا كَانُوا يَعْمَلُونَ"},"context":"قبلها: هل أنبئكم بشر من ذلك مثوبة.","reason":"النفاق مكشوف."}],"hadiths":[],"situations":[{"situationId":85,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَإِذَا جَاءُوكُمْ قَالُوا آمَنَّا وَقَدْ دَخَلُوا بِالْكُفْرِ﴾."}],"hadiths":[]}]},{"id":347,"name":"أعلم بما تصفون","compound":true,"meaning":"أعلم بما تصفون: قالها يوسف في نفسه حين اتُّهم بالسرقة.","teaches":"1. أسرّها في نفسه ولم يبدها لهم.","whenRecall":"- حين تُتهم بباطل.","whenPray":"1. الله أعلم بما تصفون.","summary":"اكتم غيظك أمام البهتان.","verses":[{"i":1,"of":1,"s":12,"surah":"يوسف","a":77,"text":"قَالُوا إِنْ يَسْرِقْ فَقَدْ سَرَقَ أَخٌ لَهُ مِنْ قَبْلُ فَأَسَرَّهَا يُوسُفُ فِي نَفْسِهِ وَلَمْ يُبْدِهَا لَهُمْ قَالَ أَنْتُمْ شَرٌّ مَكَانًا وَاللَّهُ أَعْلَمُ بِمَا تَصِفُونَ","prev":{"a":76,"text":"فَبَدَأَ بِأَوْعِيَتِهِمْ قَبْلَ وِعَاءِ أَخِيهِ ثُمَّ اسْتَخْرَجَهَا مِنْ وِعَاءِ أَخِيهِ كَذَلِكَ كِدْنَا لِيُوسُفَ مَا كَانَ لِيَأْخُذَ أَخَاهُ فِي دِينِ الْمَلِكِ إِلَّا أَنْ يَشَاءَ اللَّهُ نَرْفَعُ دَرَجَاتٍ مَنْ نَشَاءُ وَفَوْقَ كُلِّ ذِي عِلْمٍ عَلِيمٌ"},"next":{"a":78,"text":"قَالُوا يَا أَيُّهَا الْعَزِيزُ إِنَّ لَهُ أَبًا شَيْخًا كَبِيرًا فَخُذْ أَحَدَنَا مَكَانَهُ إِنَّا نَرَاكَ مِنَ الْمُحْسِنِينَ"},"context":"قبلها: بدأ بأوعيتهم.","reason":"يوسف يكتم الغيظ."}],"hadiths":[],"situations":[{"situationId":29,"verses":[{"i":1,"strength":"direct","bridge":"إذا رُميت بتهمة: ﴿فَأَسَرَّهَا يُوسُفُ فِي نَفْسِهِ وَلَمْ يُبْدِهَا لَهُمْ﴾."}],"hadiths":[]}]},{"id":348,"name":"أعلم بما أخفيتم وما أعلنتم","compound":true,"meaning":"أعلم بما أخفيتم وما أعلنتم: يعلم المودة الخفية للأعداء.","teaches":"1. نزلت في مكاتبة قريش.","whenRecall":"- حين تُسرّ بالمودة لأعداء الدين.","whenPray":"1. اللهم اجعل ولائي لك.","summary":"المودة الخفية معلومة.","verses":[{"i":1,"of":1,"s":60,"surah":"الممتحنة","a":1,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَتَّخِذُوا عَدُوِّي وَعَدُوَّكُمْ أَوْلِيَاءَ تُلْقُونَ إِلَيْهِمْ بِالْمَوَدَّةِ وَقَدْ كَفَرُوا بِمَا جَاءَكُمْ مِنَ الْحَقِّ يُخْرِجُونَ الرَّسُولَ وَإِيَّاكُمْ أَنْ تُؤْمِنُوا بِاللَّهِ رَبِّكُمْ إِنْ كُنْتُمْ خَرَجْتُمْ جِهَادًا فِي سَبِيلِي وَابْتِغَاءَ مَرْضَاتِي تُسِرُّونَ إِلَيْهِمْ بِالْمَوَدَّةِ وَأَنَا أَعْلَمُ بِمَا أَخْفَيْتُمْ وَمَا أَعْلَنْتُمْ وَمَنْ يَفْعَلْهُ مِنْكُمْ فَقَدْ ضَلَّ سَوَاءَ السَّبِيلِ","next":{"a":2,"text":"إِنْ يَثْقَفُوكُمْ يَكُونُوا لَكُمْ أَعْدَاءً وَيَبْسُطُوا إِلَيْكُمْ أَيْدِيَهُمْ وَأَلْسِنَتَهُمْ بِالسُّوءِ وَوَدُّوا لَوْ تَكْفُرُونَ"},"context":"مطلع الممتحنة.","reason":"النهي عن موالاة الأعداء."}],"hadiths":[],"situations":[{"situationId":128,"verses":[{"i":1,"strength":"direct","bridge":"﴿لَا تَتَّخِذُوا عَدُوِّي وَعَدُوَّكُمْ أَوْلِيَاءَ﴾."}],"hadiths":[]}]},{"id":349,"name":"أعلم بما تفيضون فيه","compound":true,"meaning":"أعلم بما تفيضون فيه: يعلم ما تخوضون فيه من الطعن.","teaches":"1. ردٌّ على اتهام القرآن بالافتراء.\n2. ثم: وهو الغفور الرحيم.","whenRecall":"- حين تخوض في الطعن.","whenPray":"1. اللهم اغفر لي ما خضت فيه.","summary":"الخائض في الطعن يعلمه الله، والباب مفتوح.","verses":[{"i":1,"of":1,"s":46,"surah":"الأحقاف","a":8,"text":"أَمْ يَقُولُونَ افْتَرَاهُ قُلْ إِنِ افْتَرَيْتُهُ فَلَا تَمْلِكُونَ لِي مِنَ اللَّهِ شَيْئًا هُوَ أَعْلَمُ بِمَا تُفِيضُونَ فِيهِ كَفَى بِهِ شَهِيدًا بَيْنِي وَبَيْنَكُمْ وَهُوَ الْغَفُورُ الرَّحِيمُ","prev":{"a":7,"text":"وَإِذَا تُتْلَى عَلَيْهِمْ آيَاتُنَا بَيِّنَاتٍ قَالَ الَّذِينَ كَفَرُوا لِلْحَقِّ لَمَّا جَاءَهُمْ هَذَا سِحْرٌ مُبِينٌ"},"next":{"a":9,"text":"قُلْ مَا كُنْتُ بِدْعًا مِنَ الرُّسُلِ وَمَا أَدْرِي مَا يُفْعَلُ بِي وَلَا بِكُمْ إِنْ أَتَّبِعُ إِلَّا مَا يُوحَى إِلَيَّ وَمَا أَنَا إِلَّا نَذِيرٌ مُبِينٌ"},"context":"قبلها: قالوا هذا سحر مبين.","reason":"الاحتكام إلى شهادة الله."}],"hadiths":[],"situations":[{"situationId":107,"verses":[{"i":1,"strength":"direct","bridge":"﴿هُوَ أَعْلَمُ بِمَا تُفِيضُونَ فِيهِ كَفَى بِهِ شَهِيدًا بَيْنِي وَبَيْنَكُمْ﴾."}],"hadiths":[]}]},{"id":350,"name":"أعلم بما يوعون","compound":true,"meaning":"أعلم بما يوعون: يعلم ما يجمعونه في صدورهم.","teaches":"1. بعد: بل الذين كفروا يكذبون.","whenRecall":"- حين تُضمر في صدرك.","whenPray":"1. اللهم طهر صدري.","summary":"ما تجمعه في صدرك معلوم.","verses":[{"i":1,"of":1,"s":84,"surah":"الانشقاق","a":23,"text":"وَاللَّهُ أَعْلَمُ بِمَا يُوعُونَ","prev":{"a":22,"text":"بَلِ الَّذِينَ كَفَرُوا يُكَذِّبُونَ"},"next":{"a":24,"text":"فَبَشِّرْهُمْ بِعَذَابٍ أَلِيمٍ"},"context":"قبلها: بل الذين كفروا يكذبون.","reason":"علمه بما في الصدور."}],"hadiths":[],"situations":[{"situationId":86,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَاللَّهُ أَعْلَمُ بِمَا يُوعُونَ﴾."}],"hadiths":[]}]},{"id":351,"name":"أعلم بما لبثتم / بما لبثوا","compound":true,"meaning":"أعلم بما لبثتم: رد العلم بالمدة إلى الله.","teaches":"1. أهل الكهف بعد البعث.","whenRecall":"- حين ينشغل الناس بتفاصيل لا تنفع.","whenPray":"1. ربكم أعلم.","summary":"اترك ما لا ينفع وانشغل بالعمل.","verses":[{"i":1,"of":2,"s":18,"surah":"الكهف","a":19,"text":"وَكَذَلِكَ بَعَثْنَاهُمْ لِيَتَسَاءَلُوا بَيْنَهُمْ قَالَ قَائِلٌ مِنْهُمْ كَمْ لَبِثْتُمْ قَالُوا لَبِثْنَا يَوْمًا أَوْ بَعْضَ يَوْمٍ قَالُوا رَبُّكُمْ أَعْلَمُ بِمَا لَبِثْتُمْ فَابْعَثُوا أَحَدَكُمْ بِوَرِقِكُمْ هَذِهِ إِلَى الْمَدِينَةِ فَلْيَنْظُرْ أَيُّهَا أَزْكَى طَعَامًا فَلْيَأْتِكُمْ بِرِزْقٍ مِنْهُ وَلْيَتَلَطَّفْ وَلَا يُشْعِرَنَّ بِكُمْ أَحَدًا","prev":{"a":18,"text":"وَتَحْسَبُهُمْ أَيْقَاظًا وَهُمْ رُقُودٌ وَنُقَلِّبُهُمْ ذَاتَ الْيَمِينِ وَذَاتَ الشِّمَالِ وَكَلْبُهُمْ بَاسِطٌ ذِرَاعَيْهِ بِالْوَصِيدِ لَوِ اطَّلَعْتَ عَلَيْهِمْ لَوَلَّيْتَ مِنْهُمْ فِرَارًا وَلَمُلِئْتَ مِنْهُمْ رُعْبًا"},"next":{"a":20,"text":"إِنَّهُمْ إِنْ يَظْهَرُوا عَلَيْكُمْ يَرْجُمُوكُمْ أَوْ يُعِيدُوكُمْ فِي مِلَّتِهِمْ وَلَنْ تُفْلِحُوا إِذًا أَبَدًا"},"context":"قبلها: نقلبهم ذات اليمين.","reason":"تركوا الجدال وانشغلوا بالحاجة."},{"i":2,"of":2,"s":18,"surah":"الكهف","a":26,"text":"قُلِ اللَّهُ أَعْلَمُ بِمَا لَبِثُوا لَهُ غَيْبُ السَّمَاوَاتِ وَالْأَرْضِ أَبْصِرْ بِهِ وَأَسْمِعْ مَا لَهُمْ مِنْ دُونِهِ مِنْ وَلِيٍّ وَلَا يُشْرِكُ فِي حُكْمِهِ أَحَدًا","prev":{"a":25,"text":"وَلَبِثُوا فِي كَهْفِهِمْ ثَلَاثَ مِائَةٍ سِنِينَ وَازْدَادُوا تِسْعًا"},"next":{"a":27,"text":"وَاتْلُ مَا أُوحِيَ إِلَيْكَ مِنْ كِتَابِ رَبِّكَ لَا مُبَدِّلَ لِكَلِمَاتِهِ وَلَنْ تَجِدَ مِنْ دُونِهِ مُلْتَحَدًا"},"context":"ثلاثمئة سنين وتسع.","reason":"حسم العدد."}],"hadiths":[],"situations":[{"situationId":142,"verses":[{"i":1,"strength":"direct","bridge":"إذا انشغلت بجدال لا ينفع: ﴿قَالُوا رَبُّكُمْ أَعْلَمُ بِمَا لَبِثْتُمْ فَابْعَثُوا أَحَدَكُمْ﴾."}],"hadiths":[]},{"situationId":195,"verses":[{"i":2,"strength":"direct","bridge":"﴿قُلِ اللَّهُ أَعْلَمُ بِمَا لَبِثُوا﴾."}],"hadiths":[]}]},{"id":352,"name":"أعلم بما وضعت","compound":true,"meaning":"أعلم بما وضعت: الله أعلم بما في الولد من خير.","teaches":"1. امرأة عمران نذرت ما في بطنها، فوضعت أنثى.","whenRecall":"- حين يأتيك المولود على غير ما أردت.","whenPray":"1. ﴿وَإِنِّي أُعِيذُهَا بِكَ وَذُرِّيَّتَهَا مِنَ الشَّيْطَانِ الرَّجِيمِ﴾.","summary":"ما وهبك الله أعلم به منك.","verses":[{"i":1,"of":1,"s":3,"surah":"آل عمران","a":36,"text":"فَلَمَّا وَضَعَتْهَا قَالَتْ رَبِّ إِنِّي وَضَعْتُهَا أُنْثَى وَاللَّهُ أَعْلَمُ بِمَا وَضَعَتْ وَلَيْسَ الذَّكَرُ كَالْأُنْثَى وَإِنِّي سَمَّيْتُهَا مَرْيَمَ وَإِنِّي أُعِيذُهَا بِكَ وَذُرِّيَّتَهَا مِنَ الشَّيْطَانِ الرَّجِيمِ","prev":{"a":35,"text":"إِذْ قَالَتِ امْرَأَتُ عِمْرَانَ رَبِّ إِنِّي نَذَرْتُ لَكَ مَا فِي بَطْنِي مُحَرَّرًا فَتَقَبَّلْ مِنِّي إِنَّكَ أَنْتَ السَّمِيعُ الْعَلِيمُ"},"next":{"a":37,"text":"فَتَقَبَّلَهَا رَبُّهَا بِقَبُولٍ حَسَنٍ وَأَنْبَتَهَا نَبَاتًا حَسَنًا وَكَفَّلَهَا زَكَرِيَّا كُلَّمَا دَخَلَ عَلَيْهَا زَكَرِيَّا الْمِحْرَابَ وَجَدَ عِنْدَهَا رِزْقًا قَالَ يَا مَرْيَمُ أَنَّى لَكِ هَذَا قَالَتْ هُوَ مِنْ عِنْدِ اللَّهِ إِنَّ اللَّهَ يَرْزُقُ مَنْ يَشَاءُ بِغَيْرِ حِسَابٍ"},"context":"قبلها: نذرت لك ما في بطني محررًا.","reason":"الأنثى صارت مريم."}],"hadiths":[],"situations":[{"situationId":52,"verses":[{"i":1,"strength":"direct","bridge":"إذا جاء الولد على غير ما تمنيت: ﴿وَاللَّهُ أَعْلَمُ بِمَا وَضَعَتْ﴾، وأعذه بالله."}],"hadiths":[]}]},{"id":353,"name":"شهيد على ما تعملون","compound":true,"meaning":"شهيد على ما تعملون: يشهد على كفر من كفر بالآيات.","teaches":"1. خطاب أهل الكتاب.","whenRecall":"- حين تُعرض عن الآيات.","whenPray":"1. اللهم اجعلني من المؤمنين بآياتك.","summary":"الكفر بالآيات مشهود.","verses":[{"i":1,"of":1,"s":3,"surah":"آل عمران","a":98,"text":"قُلْ يَا أَهْلَ الْكِتَابِ لِمَ تَكْفُرُونَ بِآيَاتِ اللَّهِ وَاللَّهُ شَهِيدٌ عَلَى مَا تَعْمَلُونَ","prev":{"a":97,"text":"فِيهِ آيَاتٌ بَيِّنَاتٌ مَقَامُ إِبْرَاهِيمَ وَمَنْ دَخَلَهُ كَانَ آمِنًا وَلِلَّهِ عَلَى النَّاسِ حِجُّ الْبَيْتِ مَنِ اسْتَطَاعَ إِلَيْهِ سَبِيلًا وَمَنْ كَفَرَ فَإِنَّ اللَّهَ غَنِيٌّ عَنِ الْعَالَمِينَ"},"next":{"a":99,"text":"قُلْ يَا أَهْلَ الْكِتَابِ لِمَ تَصُدُّونَ عَنْ سَبِيلِ اللَّهِ مَنْ آمَنَ تَبْغُونَهَا عِوَجًا وَأَنْتُمْ شُهَدَاءُ وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ"},"context":"قبلها: فيه آيات بينات مقام إبراهيم.","reason":"سؤال إنكار."}],"hadiths":[],"situations":[{"situationId":121,"verses":[{"i":1,"strength":"direct","bridge":"﴿لِمَ تَكْفُرُونَ بِآيَاتِ اللَّهِ وَاللَّهُ شَهِيدٌ عَلَى مَا تَعْمَلُونَ﴾."}],"hadiths":[]}]},{"id":354,"name":"شهيد على ما يفعلون","compound":true,"meaning":"شهيد على ما يفعلون: إن رأيت العقوبة أو لم ترها فالمرجع إلى الله.","teaches":"1. تسلية النبي ﷺ.","whenRecall":"- حين لا ترى جزاء الظالم.","whenPray":"1. اللهم أرني عدلك.","summary":"سواء رأيت الجزاء أم لا، الله شهيد.","verses":[{"i":1,"of":1,"s":10,"surah":"يونس","a":46,"text":"وَإِمَّا نُرِيَنَّكَ بَعْضَ الَّذِي نَعِدُهُمْ أَوْ نَتَوَفَّيَنَّكَ فَإِلَيْنَا مَرْجِعُهُمْ ثُمَّ اللَّهُ شَهِيدٌ عَلَى مَا يَفْعَلُونَ","prev":{"a":45,"text":"وَيَوْمَ يَحْشُرُهُمْ كَأَنْ لَمْ يَلْبَثُوا إِلَّا سَاعَةً مِنَ النَّهَارِ يَتَعَارَفُونَ بَيْنَهُمْ قَدْ خَسِرَ الَّذِينَ كَذَّبُوا بِلِقَاءِ اللَّهِ وَمَا كَانُوا مُهْتَدِينَ"},"next":{"a":47,"text":"وَلِكُلِّ أُمَّةٍ رَسُولٌ فَإِذَا جَاءَ رَسُولُهُمْ قُضِيَ بَيْنَهُمْ بِالْقِسْطِ وَهُمْ لَا يُظْلَمُونَ"},"context":"قبلها: يحشرهم كأن لم يلبثوا إلا ساعة.","reason":"الجزاء قد يُرى أو يُؤخر."}],"hadiths":[],"situations":[{"situationId":36,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَإِمَّا نُرِيَنَّكَ بَعْضَ الَّذِي نَعِدُهُمْ أَوْ نَتَوَفَّيَنَّكَ فَإِلَيْنَا مَرْجِعُهُمْ﴾."}],"hadiths":[]}]},{"id":355,"name":"على ما نقول وكيل","compound":true,"meaning":"الله على ما نقول وكيل: يُشهد الله على العهد.","teaches":"1. يعقوب مع أبنائه.\n2. موسى مع الشيخ في عقد الأجل.","whenRecall":"- عند عقد أو عهد.","whenPray":"1. الله على ما نقول وكيل.","summary":"اجعل الله شاهدًا على عقودك.","verses":[{"i":1,"of":2,"s":12,"surah":"يوسف","a":66,"text":"قَالَ لَنْ أُرْسِلَهُ مَعَكُمْ حَتَّى تُؤْتُونِ مَوْثِقًا مِنَ اللَّهِ لَتَأْتُنَّنِي بِهِ إِلَّا أَنْ يُحَاطَ بِكُمْ فَلَمَّا آتَوْهُ مَوْثِقَهُمْ قَالَ اللَّهُ عَلَى مَا نَقُولُ وَكِيلٌ","prev":{"a":65,"text":"وَلَمَّا فَتَحُوا مَتَاعَهُمْ وَجَدُوا بِضَاعَتَهُمْ رُدَّتْ إِلَيْهِمْ قَالُوا يَا أَبَانَا مَا نَبْغِي هَذِهِ بِضَاعَتُنَا رُدَّتْ إِلَيْنَا وَنَمِيرُ أَهْلَنَا وَنَحْفَظُ أَخَانَا وَنَزْدَادُ كَيْلَ بَعِيرٍ ذَلِكَ كَيْلٌ يَسِيرٌ"},"next":{"a":67,"text":"وَقَالَ يَا بَنِيَّ لَا تَدْخُلُوا مِنْ بَابٍ وَاحِدٍ وَادْخُلُوا مِنْ أَبْوَابٍ مُتَفَرِّقَةٍ وَمَا أُغْنِي عَنْكُمْ مِنَ اللَّهِ مِنْ شَيْءٍ إِنِ الْحُكْمُ إِلَّا لِلَّهِ عَلَيْهِ تَوَكَّلْتُ وَعَلَيْهِ فَلْيَتَوَكَّلِ الْمُتَوَكِّلُونَ"},"context":"يعقوب يأخذ الموثق على بنيامين.","reason":"الموثق والتوكل."},{"i":2,"of":2,"s":28,"surah":"القصص","a":28,"text":"قَالَ ذَلِكَ بَيْنِي وَبَيْنَكَ أَيَّمَا الْأَجَلَيْنِ قَضَيْتُ فَلَا عُدْوَانَ عَلَيَّ وَاللَّهُ عَلَى مَا نَقُولُ وَكِيلٌ","prev":{"a":27,"text":"قَالَ إِنِّي أُرِيدُ أَنْ أُنْكِحَكَ إِحْدَى ابْنَتَيَّ هَاتَيْنِ عَلَى أَنْ تَأْجُرَنِي ثَمَانِيَ حِجَجٍ فَإِنْ أَتْمَمْتَ عَشْرًا فَمِنْ عِنْدِكَ وَمَا أُرِيدُ أَنْ أَشُقَّ عَلَيْكَ سَتَجِدُنِي إِنْ شَاءَ اللَّهُ مِنَ الصَّالِحِينَ"},"next":{"a":29,"text":"فَلَمَّا قَضَى مُوسَى الْأَجَلَ وَسَارَ بِأَهْلِهِ آنَسَ مِنْ جَانِبِ الطُّورِ نَارًا قَالَ لِأَهْلِهِ امْكُثُوا إِنِّي آنَسْتُ نَارًا لَعَلِّي آتِيكُمْ مِنْهَا بِخَبَرٍ أَوْ جَذْوَةٍ مِنَ النَّارِ لَعَلَّكُمْ تَصْطَلُونَ"},"context":"موسى يعقد مع الشيخ.","reason":"عقد الزواج والإجارة."}],"hadiths":[],"situations":[{"situationId":50,"verses":[{"i":2,"strength":"direct","bridge":"في العقود: ﴿وَاللَّهُ عَلَى مَا نَقُولُ وَكِيلٌ﴾."}],"hadiths":[]},{"situationId":62,"verses":[{"i":1,"strength":"direct","bridge":"عند العهود: ﴿فَلَمَّا آتَوْهُ مَوْثِقَهُمْ قَالَ اللَّهُ عَلَى مَا نَقُولُ وَكِيلٌ﴾."}],"hadiths":[]}]},{"id":356,"name":"وليهم بما كانوا يعملون","compound":true,"meaning":"وليهم بما كانوا يعملون: يتولى المؤمنين جزاءً بعملهم.","teaches":"1. لهم دار السلام.","whenRecall":"- حين تطلب السلام.","whenPray":"1. اللهم اجعلنا من أهل دار السلام.","summary":"العمل طريق ولاية الله ودار السلام.","verses":[{"i":1,"of":1,"s":6,"surah":"الأنعام","a":127,"text":"لَهُمْ دَارُ السَّلَامِ عِنْدَ رَبِّهِمْ وَهُوَ وَلِيُّهُمْ بِمَا كَانُوا يَعْمَلُونَ","prev":{"a":126,"text":"وَهَذَا صِرَاطُ رَبِّكَ مُسْتَقِيمًا قَدْ فَصَّلْنَا الْآيَاتِ لِقَوْمٍ يَذَّكَّرُونَ"},"next":{"a":128,"text":"وَيَوْمَ يَحْشُرُهُمْ جَمِيعًا يَا مَعْشَرَ الْجِنِّ قَدِ اسْتَكْثَرْتُمْ مِنَ الْإِنْسِ وَقَالَ أَوْلِيَاؤُهُمْ مِنَ الْإِنْسِ رَبَّنَا اسْتَمْتَعَ بَعْضُنَا بِبَعْضٍ وَبَلَغْنَا أَجَلَنَا الَّذِي أَجَّلْتَ لَنَا قَالَ النَّارُ مَثْوَاكُمْ خَالِدِينَ فِيهَا إِلَّا مَا شَاءَ اللَّهُ إِنَّ رَبَّكَ حَكِيمٌ عَلِيمٌ"},"context":"قبلها: هذا صراط ربك مستقيمًا.","reason":"دار السلام والولاية."}],"hadiths":[],"situations":[{"situationId":187,"verses":[{"i":1,"strength":"direct","bridge":"﴿لَهُمْ دَارُ السَّلَامِ عِنْدَ رَبِّهِمْ وَهُوَ وَلِيُّهُمْ﴾."}],"hadiths":[]}]},{"id":357,"name":"متوفيك ورافعك إلي ومطهرك من الذين كفروا وجاعل الذين اتبعوك فوق الذين كفروا إلى يوم القيامة","compound":true,"meaning":"وعدٌ لعيسى: التوفي والرفع والتطهير ورفعة أتباعه.","teaches":"1. بعد: ومكروا ومكر الله.","whenRecall":"- حين يمكر الناس بك.","whenPray":"1. اللهم طهرني وارفعني.","summary":"مكرهم بعيسى انتهى برفعه.","verses":[{"i":1,"of":1,"s":3,"surah":"آل عمران","a":55,"text":"إِذْ قَالَ اللَّهُ يَا عِيسَى إِنِّي مُتَوَفِّيكَ وَرَافِعُكَ إِلَيَّ وَمُطَهِّرُكَ مِنَ الَّذِينَ كَفَرُوا وَجَاعِلُ الَّذِينَ اتَّبَعُوكَ فَوْقَ الَّذِينَ كَفَرُوا إِلَى يَوْمِ الْقِيَامَةِ ثُمَّ إِلَيَّ مَرْجِعُكُمْ فَأَحْكُمُ بَيْنَكُمْ فِيمَا كُنْتُمْ فِيهِ تَخْتَلِفُونَ","prev":{"a":54,"text":"وَمَكَرُوا وَمَكَرَ اللَّهُ وَاللَّهُ خَيْرُ الْمَاكِرِينَ"},"next":{"a":56,"text":"فَأَمَّا الَّذِينَ كَفَرُوا فَأُعَذِّبُهُمْ عَذَابًا شَدِيدًا فِي الدُّنْيَا وَالْآخِرَةِ وَمَا لَهُمْ مِنْ نَاصِرِينَ"},"context":"قبلها: ومكروا ومكر الله والله خير الماكرين.","reason":"نجاة عيسى ورفعه."}],"hadiths":[],"situations":[{"situationId":30,"verses":[{"i":1,"strength":"direct","bridge":"إذا مكروا بك: ﴿إِنِّي مُتَوَفِّيكَ وَرَافِعُكَ إِلَيَّ وَمُطَهِّرُكَ مِنَ الَّذِينَ كَفَرُوا﴾."}],"hadiths":[]}]},{"id":358,"name":"الله أحق أن تخشوه / أن تخشاه","compound":true,"meaning":"الله أحق أن تخشوه: الخشية لله أولى من خشية الناس.","teaches":"1. في قتال ناكثي العهد.\n2. وفي قصة زيد وزينب: تخشى الناس والله أحق.","whenRecall":"- حين تخاف كلام الناس.","whenPray":"1. اللهم اجعلني أخشاك كأني أراك.","summary":"خشية الناس لا تقدّم على خشية الله.","verses":[{"i":1,"of":2,"s":9,"surah":"التوبة","a":13,"text":"أَلَا تُقَاتِلُونَ قَوْمًا نَكَثُوا أَيْمَانَهُمْ وَهَمُّوا بِإِخْرَاجِ الرَّسُولِ وَهُمْ بَدَءُوكُمْ أَوَّلَ مَرَّةٍ أَتَخْشَوْنَهُمْ فَاللَّهُ أَحَقُّ أَنْ تَخْشَوْهُ إِنْ كُنْتُمْ مُؤْمِنِينَ","prev":{"a":12,"text":"وَإِنْ نَكَثُوا أَيْمَانَهُمْ مِنْ بَعْدِ عَهْدِهِمْ وَطَعَنُوا فِي دِينِكُمْ فَقَاتِلُوا أَئِمَّةَ الْكُفْرِ إِنَّهُمْ لَا أَيْمَانَ لَهُمْ لَعَلَّهُمْ يَنْتَهُونَ"},"next":{"a":14,"text":"قَاتِلُوهُمْ يُعَذِّبْهُمُ اللَّهُ بِأَيْدِيكُمْ وَيُخْزِهِمْ وَيَنْصُرْكُمْ عَلَيْهِمْ وَيَشْفِ صُدُورَ قَوْمٍ مُؤْمِنِينَ"},"context":"قبلها: إن نكثوا أيمانهم.","reason":"التخويف من العدو."},{"i":2,"of":2,"s":33,"surah":"الأحزاب","a":37,"text":"وَإِذْ تَقُولُ لِلَّذِي أَنْعَمَ اللَّهُ عَلَيْهِ وَأَنْعَمْتَ عَلَيْهِ أَمْسِكْ عَلَيْكَ زَوْجَكَ وَاتَّقِ اللَّهَ وَتُخْفِي فِي نَفْسِكَ مَا اللَّهُ مُبْدِيهِ وَتَخْشَى النَّاسَ وَاللَّهُ أَحَقُّ أَنْ تَخْشَاهُ فَلَمَّا قَضَى زَيْدٌ مِنْهَا وَطَرًا زَوَّجْنَاكَهَا لِكَيْ لَا يَكُونَ عَلَى الْمُؤْمِنِينَ حَرَجٌ فِي أَزْوَاجِ أَدْعِيَائِهِمْ إِذَا قَضَوْا مِنْهُنَّ وَطَرًا وَكَانَ أَمْرُ اللَّهِ مَفْعُولًا","prev":{"a":36,"text":"وَمَا كَانَ لِمُؤْمِنٍ وَلَا مُؤْمِنَةٍ إِذَا قَضَى اللَّهُ وَرَسُولُهُ أَمْرًا أَنْ يَكُونَ لَهُمُ الْخِيَرَةُ مِنْ أَمْرِهِمْ وَمَنْ يَعْصِ اللَّهَ وَرَسُولَهُ فَقَدْ ضَلَّ ضَلَالًا مُبِينًا"},"next":{"a":38,"text":"مَا كَانَ عَلَى النَّبِيِّ مِنْ حَرَجٍ فِيمَا فَرَضَ اللَّهُ لَهُ سُنَّةَ اللَّهِ فِي الَّذِينَ خَلَوْا مِنْ قَبْلُ وَكَانَ أَمْرُ اللَّهِ قَدَرًا مَقْدُورًا"},"context":"قصة زيد وزينب.","reason":"خشية كلام الناس."}],"hadiths":[{"i":1,"of":1,"text":"ولَو كانَ مُحَمَّدٌ صلَّى اللهُ عليه وسلَّم كاتِمًا شيئًا ممَّا أُنزِلَ عليه لَكَتَمَ هذه الآيةَ: {وإذ تَقولُ للذي أنعَمَ اللهُ عليه وأنعَمتَ عليه أمسِكْ عَلَيْكَ زَوجَك واتَّقِ اللهَ وتُخفي في نَفسِك ما اللهُ مُبديه وتَخشى النَّاسَ والله أحَقُّ أن تَخشاه} [الأحزاب: 37].","narrator":"عائشة أم المؤمنين","source":"صحيح مسلم 177","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/2Ow0O5vA","nameForm":"الله أحق أن تخشوه / أن تخشاه"}],"sunnah":{},"situations":[{"situationId":33,"verses":[{"i":1,"strength":"direct","bridge":"﴿أَتَخْشَوْنَهُمْ فَاللَّهُ أَحَقُّ أَنْ تَخْشَوْهُ إِنْ كُنْتُمْ مُؤْمِنِينَ﴾."}],"hadiths":[]},{"situationId":88,"verses":[{"i":2,"strength":"direct","bridge":"إذا خفت كلام الناس في حكم الله: ﴿وَتَخْشَى النَّاسَ وَاللَّهُ أَحَقُّ أَنْ تَخْشَاهُ﴾."}],"hadiths":[]}]},{"id":359,"name":"القادر على أن يبعث عليكم عذابًا من فوقكم أو من تحت أرجلكم أو يلبسكم شيعًا ويذيق بعضكم بأس بعض","compound":true,"meaning":"القادر على أن يبعث العذاب: من فوق، أو من تحت، أو بالفرقة.","teaches":"1. بعد: الله ينجيكم من كل كرب ثم أنتم تشركون.\n2. الفرقة نوع من العذاب.","whenRecall":"- حين يتفرق المسلمون.","whenPray":"1. اللهم اجمع كلمتنا.","summary":"الفرقة عذاب كالعذاب النازل.","verses":[{"i":1,"of":1,"s":6,"surah":"الأنعام","a":65,"text":"قُلْ هُوَ الْقَادِرُ عَلَى أَنْ يَبْعَثَ عَلَيْكُمْ عَذَابًا مِنْ فَوْقِكُمْ أَوْ مِنْ تَحْتِ أَرْجُلِكُمْ أَوْ يَلْبِسَكُمْ شِيَعًا وَيُذِيقَ بَعْضَكُمْ بَأْسَ بَعْضٍ انْظُرْ كَيْفَ نُصَرِّفُ الْآيَاتِ لَعَلَّهُمْ يَفْقَهُونَ","prev":{"a":64,"text":"قُلِ اللَّهُ يُنَجِّيكُمْ مِنْهَا وَمِنْ كُلِّ كَرْبٍ ثُمَّ أَنْتُمْ تُشْرِكُونَ"},"next":{"a":66,"text":"وَكَذَّبَ بِهِ قَوْمُكَ وَهُوَ الْحَقُّ قُلْ لَسْتُ عَلَيْكُمْ بِوَكِيلٍ"},"context":"قبلها: الله ينجيكم منها ومن كل كرب.","reason":"تحذير من العذاب والفرقة."}],"hadiths":[{"i":1,"of":1,"text":"عن أُبَيِّ بنِ كَعْبٍ «{هُوَ الْقَادِرُ عَلَى أَنْ يَبْعَثَ عَلَيْكُمْ عَذَابًا مِنْ فَوْقِكُمْ أَوْ مِنْ تَحْتِ أَرْجُلِكُمْ أَوْ يَلْبِسَكُمْ شِيَعًا وَيُذِيقَ بَعْضَكُمْ بَأْسَ بَعْضٍ}، قالَ: فهي أرْبَعُ خِلالٍ، قالَ: فجاءَ مِنها ثِنْتانِ بَعْدَ وَفاةِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ بِخَمْسٍ وعِشْرينَ: أُلْبِسوا شِيَعًا، وذاقَ بعضُهم بأسَ بعضٍ، وبَقِيَتِ اثْنَتانِ لا بُدَّ مِنها واقِعتانِ: الرَّجْمُ، والخَسْفُ».","narrator":"أبو العالية","source":"الأحاديث المختارة 1150","grade":"صحيح","judgment":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","url":"https://dorar.net/h/vHonIqAl","nameForm":"القادر على أن يبعث عليكم عذابًا من فوقكم أو من تحت أرجلكم أو يلبسكم شيعًا ويذيق بعضكم بأس بعض"}],"sunnah":{},"situations":[{"situationId":142,"verses":[{"i":1,"strength":"direct","bridge":"إذا تفرقت الكلمة: ﴿أَوْ يَلْبِسَكُمْ شِيَعًا وَيُذِيقَ بَعْضَكُمْ بَأْسَ بَعْضٍ﴾."}],"hadiths":[]}]},{"id":360,"name":"قادر على أن يخلق مثلهم / بقادر على أن يخلق مثلهم","compound":true,"meaning":"قادر على أن يخلق مثلهم: من خلق السماوات قادر على الإعادة.","teaches":"1. حجة البعث بخلق السماوات.","whenRecall":"- حين تستبعد البعث.","whenPray":"1. سبحان الخلاق العليم.","summary":"خلق السماوات أكبر من إعادتك.","verses":[{"i":1,"of":2,"s":17,"surah":"الإسراء","a":99,"text":"أَوَلَمْ يَرَوْا أَنَّ اللَّهَ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ قَادِرٌ عَلَى أَنْ يَخْلُقَ مِثْلَهُمْ وَجَعَلَ لَهُمْ أَجَلًا لَا رَيْبَ فِيهِ فَأَبَى الظَّالِمُونَ إِلَّا كُفُورًا","prev":{"a":98,"text":"ذَلِكَ جَزَاؤُهُمْ بِأَنَّهُمْ كَفَرُوا بِآيَاتِنَا وَقَالُوا أَإِذَا كُنَّا عِظَامًا وَرُفَاتًا أَإِنَّا لَمَبْعُوثُونَ خَلْقًا جَدِيدًا"},"next":{"a":100,"text":"قُلْ لَوْ أَنْتُمْ تَمْلِكُونَ خَزَائِنَ رَحْمَةِ رَبِّي إِذًا لَأَمْسَكْتُمْ خَشْيَةَ الْإِنْفَاقِ وَكَانَ الْإِنْسَانُ قَتُورًا"},"context":"قبلها: قالوا أئذا كنا عظامًا ورفاتًا.","reason":"حجة البعث."},{"i":2,"of":2,"s":36,"surah":"يس","a":81,"text":"أَوَلَيْسَ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ بِقَادِرٍ عَلَى أَنْ يَخْلُقَ مِثْلَهُمْ بَلَى وَهُوَ الْخَلَّاقُ الْعَلِيمُ","prev":{"a":80,"text":"الَّذِي جَعَلَ لَكُمْ مِنَ الشَّجَرِ الْأَخْضَرِ نَارًا فَإِذَا أَنْتُمْ مِنْهُ تُوقِدُونَ"},"next":{"a":82,"text":"إِنَّمَا أَمْرُهُ إِذَا أَرَادَ شَيْئًا أَنْ يَقُولَ لَهُ كُنْ فَيَكُونُ"},"context":"قبلها: جعل لكم من الشجر الأخضر نارًا.","reason":"حجة البعث."}],"hadiths":[],"situations":[{"situationId":109,"verses":[{"i":1,"strength":"direct","bridge":"﴿أَوَلَمْ يَرَوْا أَنَّ اللَّهَ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ قَادِرٌ عَلَى أَنْ يَخْلُقَ مِثْلَهُمْ﴾."},{"i":2,"strength":"direct","bridge":"﴿بَلَى وَهُوَ الْخَلَّاقُ الْعَلِيمُ﴾."}],"hadiths":[]}]},{"id":361,"name":"قادر على أن ينزل آية","compound":true,"meaning":"قادر على أن ينزل آية: قدرته على الآيات، وحكمته في تأخيرها.","teaches":"1. ردٌّ على طلب الآيات.","whenRecall":"- حين تطلب علامة.","whenPray":"1. اللهم أرني آياتك في نفسي.","summary":"لا تطلب الخوارق؛ آياته حولك.","verses":[{"i":1,"of":1,"s":6,"surah":"الأنعام","a":37,"text":"وَقَالُوا لَوْلَا نُزِّلَ عَلَيْهِ آيَةٌ مِنْ رَبِّهِ قُلْ إِنَّ اللَّهَ قَادِرٌ عَلَى أَنْ يُنَزِّلَ آيَةً وَلَكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ","prev":{"a":36,"text":"إِنَّمَا يَسْتَجِيبُ الَّذِينَ يَسْمَعُونَ وَالْمَوْتَى يَبْعَثُهُمُ اللَّهُ ثُمَّ إِلَيْهِ يُرْجَعُونَ"},"next":{"a":38,"text":"وَمَا مِنْ دَابَّةٍ فِي الْأَرْضِ وَلَا طَائِرٍ يَطِيرُ بِجَنَاحَيْهِ إِلَّا أُمَمٌ أَمْثَالُكُمْ مَا فَرَّطْنَا فِي الْكِتَابِ مِنْ شَيْءٍ ثُمَّ إِلَى رَبِّهِمْ يُحْشَرُونَ"},"context":"قبلها: إنما يستجيب الذين يسمعون.","reason":"القدرة مع الحكمة."}],"hadiths":[],"situations":[{"situationId":112,"verses":[{"i":1,"strength":"direct","bridge":"﴿قُلْ إِنَّ اللَّهَ قَادِرٌ عَلَى أَنْ يُنَزِّلَ آيَةً وَلَكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ﴾."}],"hadiths":[]}]},{"id":362,"name":"قادر على أن يحيي الموتى","compound":true,"meaning":"قادر على أن يحيي الموتى: من لم يعيَ بخلق السماوات يحيي الموتى.","teaches":"1. في الأحقاف والقيامة.","whenRecall":"- عند زيارة القبور.","whenPray":"1. بلى، إنه على كل شيء قدير.","summary":"من خلق النطفة يحيي الموتى.","verses":[{"i":1,"of":2,"s":46,"surah":"الأحقاف","a":33,"text":"أَوَلَمْ يَرَوْا أَنَّ اللَّهَ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ وَلَمْ يَعْيَ بِخَلْقِهِنَّ بِقَادِرٍ عَلَى أَنْ يُحْيِيَ الْمَوْتَى بَلَى إِنَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":32,"text":"وَمَنْ لَا يُجِبْ دَاعِيَ اللَّهِ فَلَيْسَ بِمُعْجِزٍ فِي الْأَرْضِ وَلَيْسَ لَهُ مِنْ دُونِهِ أَوْلِيَاءُ أُولَئِكَ فِي ضَلَالٍ مُبِينٍ"},"next":{"a":34,"text":"وَيَوْمَ يُعْرَضُ الَّذِينَ كَفَرُوا عَلَى النَّارِ أَلَيْسَ هَذَا بِالْحَقِّ قَالُوا بَلَى وَرَبِّنَا قَالَ فَذُوقُوا الْعَذَابَ بِمَا كُنْتُمْ تَكْفُرُونَ"},"context":"قبلها: من لا يجب داعي الله.","reason":"حجة البعث بخلق السماوات."},{"i":2,"of":2,"s":75,"surah":"القيامة","a":40,"text":"أَلَيْسَ ذَلِكَ بِقَادِرٍ عَلَى أَنْ يُحْيِيَ الْمَوْتَى","prev":{"a":39,"text":"فَجَعَلَ مِنْهُ الزَّوْجَيْنِ الذَّكَرَ وَالْأُنْثَى"},"context":"قبلها: جعل منه الزوجين الذكر والأنثى.","reason":"من خلق من نطفة يعيد."}],"hadiths":[],"situations":[{"situationId":110,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَلَمْ يَعْيَ بِخَلْقِهِنَّ بِقَادِرٍ عَلَى أَنْ يُحْيِيَ الْمَوْتَى﴾."}],"hadiths":[]},{"situationId":178,"verses":[{"i":2,"strength":"direct","bridge":"﴿أَلَيْسَ ذَلِكَ بِقَادِرٍ عَلَى أَنْ يُحْيِيَ الْمَوْتَى﴾."}],"hadiths":[]}]},{"id":363,"name":"ربها","compound":false,"meaning":"ربها: رب المؤنث المذكور، يتقبل ويأذن ويأمر.","teaches":"1. تقبّل مريم، وأُكل الشجرة الطيبة بإذن ربها، وإشراق الأرض بنوره، والريح بأمره.\n2. والسماء والأرض تأذن لربها.","whenRecall":"- حين تنذر ولدك لله.\n- عند تأمل الكون الطائع.","whenPray":"1. ربي تقبّل مني كما تقبلت مريم.","summary":"كل شيء يطيع ربه: المرأة الصالحة، والشجرة، والريح، والسماء.","verses":[{"i":1,"of":9,"s":3,"surah":"آل عمران","a":37,"text":"فَتَقَبَّلَهَا رَبُّهَا بِقَبُولٍ حَسَنٍ وَأَنْبَتَهَا نَبَاتًا حَسَنًا وَكَفَّلَهَا زَكَرِيَّا كُلَّمَا دَخَلَ عَلَيْهَا زَكَرِيَّا الْمِحْرَابَ وَجَدَ عِنْدَهَا رِزْقًا قَالَ يَا مَرْيَمُ أَنَّى لَكِ هَذَا قَالَتْ هُوَ مِنْ عِنْدِ اللَّهِ إِنَّ اللَّهَ يَرْزُقُ مَنْ يَشَاءُ بِغَيْرِ حِسَابٍ","prev":{"a":36,"text":"فَلَمَّا وَضَعَتْهَا قَالَتْ رَبِّ إِنِّي وَضَعْتُهَا أُنْثَى وَاللَّهُ أَعْلَمُ بِمَا وَضَعَتْ وَلَيْسَ الذَّكَرُ كَالْأُنْثَى وَإِنِّي سَمَّيْتُهَا مَرْيَمَ وَإِنِّي أُعِيذُهَا بِكَ وَذُرِّيَّتَهَا مِنَ الشَّيْطَانِ الرَّجِيمِ"},"next":{"a":38,"text":"هُنَالِكَ دَعَا زَكَرِيَّا رَبَّهُ قَالَ رَبِّ هَبْ لِي مِنْ لَدُنْكَ ذُرِّيَّةً طَيِّبَةً إِنَّكَ سَمِيعُ الدُّعَاءِ"},"context":"بعد نذر امرأة عمران.","reason":"قبول حسن وإنبات حسن."},{"i":2,"of":9,"s":14,"surah":"إبراهيم","a":25,"text":"تُؤْتِي أُكُلَهَا كُلَّ حِينٍ بِإِذْنِ رَبِّهَا وَيَضْرِبُ اللَّهُ الْأَمْثَالَ لِلنَّاسِ لَعَلَّهُمْ يَتَذَكَّرُونَ","prev":{"a":24,"text":"أَلَمْ تَرَ كَيْفَ ضَرَبَ اللَّهُ مَثَلًا كَلِمَةً طَيِّبَةً كَشَجَرَةٍ طَيِّبَةٍ أَصْلُهَا ثَابِتٌ وَفَرْعُهَا فِي السَّمَاءِ"},"next":{"a":26,"text":"وَمَثَلُ كَلِمَةٍ خَبِيثَةٍ كَشَجَرَةٍ خَبِيثَةٍ اجْتُثَّتْ مِنْ فَوْقِ الْأَرْضِ مَا لَهَا مِنْ قَرَارٍ"},"context":"مثل الكلمة الطيبة.","reason":"تؤتي أكلها كل حين بإذن ربها."},{"i":3,"of":9,"s":39,"surah":"الزمر","a":69,"text":"وَأَشْرَقَتِ الْأَرْضُ بِنُورِ رَبِّهَا وَوُضِعَ الْكِتَابُ وَجِيءَ بِالنَّبِيِّينَ وَالشُّهَدَاءِ وَقُضِيَ بَيْنَهُمْ بِالْحَقِّ وَهُمْ لَا يُظْلَمُونَ","prev":{"a":68,"text":"وَنُفِخَ فِي الصُّورِ فَصَعِقَ مَنْ فِي السَّمَاوَاتِ وَمَنْ فِي الْأَرْضِ إِلَّا مَنْ شَاءَ اللَّهُ ثُمَّ نُفِخَ فِيهِ أُخْرَى فَإِذَا هُمْ قِيَامٌ يَنْظُرُونَ"},"next":{"a":70,"text":"وَوُفِّيَتْ كُلُّ نَفْسٍ مَا عَمِلَتْ وَهُوَ أَعْلَمُ بِمَا يَفْعَلُونَ"},"context":"بعد النفخ في الصور.","reason":"إشراق الأرض ووضع الكتاب."},{"i":4,"of":9,"s":46,"surah":"الأحقاف","a":25,"text":"تُدَمِّرُ كُلَّ شَيْءٍ بِأَمْرِ رَبِّهَا فَأَصْبَحُوا لَا يُرَى إِلَّا مَسَاكِنُهُمْ كَذَلِكَ نَجْزِي الْقَوْمَ الْمُجْرِمِينَ","prev":{"a":24,"text":"فَلَمَّا رَأَوْهُ عَارِضًا مُسْتَقْبِلَ أَوْدِيَتِهِمْ قَالُوا هَذَا عَارِضٌ مُمْطِرُنَا بَلْ هُوَ مَا اسْتَعْجَلْتُمْ بِهِ رِيحٌ فِيهَا عَذَابٌ أَلِيمٌ"},"next":{"a":26,"text":"وَلَقَدْ مَكَّنَّاهُمْ فِيمَا إِنْ مَكَّنَّاكُمْ فِيهِ وَجَعَلْنَا لَهُمْ سَمْعًا وَأَبْصَارًا وَأَفْئِدَةً فَمَا أَغْنَى عَنْهُمْ سَمْعُهُمْ وَلَا أَبْصَارُهُمْ وَلَا أَفْئِدَتُهُمْ مِنْ شَيْءٍ إِذْ كَانُوا يَجْحَدُونَ بِآيَاتِ اللَّهِ وَحَاقَ بِهِمْ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ"},"context":"عاد رأوا العارض.","reason":"الريح تدمر بأمر ربها."},{"i":5,"of":9,"s":65,"surah":"الطلاق","a":8,"text":"وَكَأَيِّنْ مِنْ قَرْيَةٍ عَتَتْ عَنْ أَمْرِ رَبِّهَا وَرُسُلِهِ فَحَاسَبْنَاهَا حِسَابًا شَدِيدًا وَعَذَّبْنَاهَا عَذَابًا نُكْرًا","prev":{"a":7,"text":"لِيُنْفِقْ ذُو سَعَةٍ مِنْ سَعَتِهِ وَمَنْ قُدِرَ عَلَيْهِ رِزْقُهُ فَلْيُنْفِقْ مِمَّا آتَاهُ اللَّهُ لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا مَا آتَاهَا سَيَجْعَلُ اللَّهُ بَعْدَ عُسْرٍ يُسْرًا"},"next":{"a":9,"text":"فَذَاقَتْ وَبَالَ أَمْرِهَا وَكَانَ عَاقِبَةُ أَمْرِهَا خُسْرًا"},"context":"بعد أحكام النفقة.","reason":"القرى التي عتت عن أمر ربها."},{"i":6,"of":9,"s":66,"surah":"التحريم","a":12,"text":"وَمَرْيَمَ ابْنَتَ عِمْرَانَ الَّتِي أَحْصَنَتْ فَرْجَهَا فَنَفَخْنَا فِيهِ مِنْ رُوحِنَا وَصَدَّقَتْ بِكَلِمَاتِ رَبِّهَا وَكُتُبِهِ وَكَانَتْ مِنَ الْقَانِتِينَ","prev":{"a":11,"text":"وَضَرَبَ اللَّهُ مَثَلًا لِلَّذِينَ آمَنُوا امْرَأَتَ فِرْعَوْنَ إِذْ قَالَتْ رَبِّ ابْنِ لِي عِنْدَكَ بَيْتًا فِي الْجَنَّةِ وَنَجِّنِي مِنْ فِرْعَوْنَ وَعَمَلِهِ وَنَجِّنِي مِنَ الْقَوْمِ الظَّالِمِينَ"},"context":"مثل امرأة فرعون ثم مريم.","reason":"مريم صدقت بكلمات ربها."},{"i":7,"of":9,"s":75,"surah":"القيامة","a":23,"text":"إِلَى رَبِّهَا نَاظِرَةٌ","prev":{"a":22,"text":"وُجُوهٌ يَوْمَئِذٍ نَاضِرَةٌ"},"next":{"a":24,"text":"وَوُجُوهٌ يَوْمَئِذٍ بَاسِرَةٌ"},"reason":"النظر إلى الرب."},{"i":8,"of":9,"s":84,"surah":"الانشقاق","a":2,"text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","prev":{"a":1,"text":"إِذَا السَّمَاءُ انْشَقَّتْ"},"next":{"a":3,"text":"وَإِذَا الْأَرْضُ مُدَّتْ"},"reason":"السماء تطيع ربها."},{"i":9,"of":9,"s":84,"surah":"الانشقاق","a":5,"text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","prev":{"a":4,"text":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ"},"next":{"a":6,"text":"يَا أَيُّهَا الْإِنْسَانُ إِنَّكَ كَادِحٌ إِلَى رَبِّكَ كَدْحًا فَمُلَاقِيهِ"},"context":"الأرض ألقت ما فيها.","reason":"الأرض تطيع ربها."}],"hadiths":[],"situations":[{"situationId":52,"verses":[{"i":1,"strength":"direct","bridge":"إذا نذرت ولدك لله: ﴿فَتَقَبَّلَهَا رَبُّهَا بِقَبُولٍ حَسَنٍ وَأَنْبَتَهَا نَبَاتًا حَسَنًا﴾."}],"hadiths":[]},{"situationId":60,"verses":[{"i":2,"strength":"direct","bridge":"الكلمة الطيبة تثمر: ﴿تُؤْتِي أُكُلَهَا كُلَّ حِينٍ بِإِذْنِ رَبِّهَا﴾."}],"hadiths":[]},{"situationId":117,"verses":[{"i":6,"strength":"direct","bridge":"قدوة: ﴿وَصَدَّقَتْ بِكَلِمَاتِ رَبِّهَا وَكُتُبِهِ وَكَانَتْ مِنَ الْقَانِتِينَ﴾."}],"hadiths":[]},{"situationId":179,"verses":[{"i":8,"strength":"direct","bridge":"السماء تسمع وتطيع: ﴿وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ﴾."}],"hadiths":[]},{"situationId":180,"verses":[{"i":4,"strength":"direct","bridge":"﴿تُدَمِّرُ كُلَّ شَيْءٍ بِأَمْرِ رَبِّهَا﴾."},{"i":5,"strength":"direct","bridge":"﴿وَكَأَيِّنْ مِنْ قَرْيَةٍ عَتَتْ عَنْ أَمْرِ رَبِّهَا وَرُسُلِهِ﴾."}],"hadiths":[]},{"situationId":183,"verses":[{"i":3,"strength":"direct","bridge":"﴿وَأَشْرَقَتِ الْأَرْضُ بِنُورِ رَبِّهَا وَوُضِعَ الْكِتَابُ﴾."},{"i":9,"strength":"direct","bridge":"﴿وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ﴾."}],"hadiths":[]},{"situationId":187,"verses":[{"i":7,"strength":"direct","bridge":"غاية الشوق: ﴿إِلَى رَبِّهَا نَاظِرَةٌ﴾."}],"hadiths":[]}]},{"id":364,"name":"رب آبائكم الأولين","compound":true,"meaning":"رب آبائكم الأولين: ربّ الآباء كما هو ربكم.","teaches":"1. قالها موسى لفرعون، وإلياس لقومه.\n2. ردٌّ على التمسك بدين الآباء.","whenRecall":"- حين يُحتج عليك بالتقاليد.","whenPray":"1. ربي ورب آبائي.","summary":"رب الآباء هو ربك؛ فلا تقلّدهم في الباطل.","verses":[{"i":1,"of":3,"s":26,"surah":"الشعراء","a":26,"text":"قَالَ رَبُّكُمْ وَرَبُّ آبَائِكُمُ الْأَوَّلِينَ","prev":{"a":25,"text":"قَالَ لِمَنْ حَوْلَهُ أَلَا تَسْتَمِعُونَ"},"next":{"a":27,"text":"قَالَ إِنَّ رَسُولَكُمُ الَّذِي أُرْسِلَ إِلَيْكُمْ لَمَجْنُونٌ"},"context":"فرعون يقول لمن حوله: ألا تستمعون.","reason":"رب الأولين والآخرين."},{"i":2,"of":3,"s":37,"surah":"الصافات","a":126,"text":"اللَّهَ رَبَّكُمْ وَرَبَّ آبَائِكُمُ الْأَوَّلِينَ","prev":{"a":125,"text":"أَتَدْعُونَ بَعْلًا وَتَذَرُونَ أَحْسَنَ الْخَالِقِينَ"},"next":{"a":127,"text":"فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ"},"context":"إلياس: أتدعون بعلًا.","reason":"ردٌّ على عبادة بعل."},{"i":3,"of":3,"s":44,"surah":"الدخان","a":8,"text":"لَا إِلَهَ إِلَّا هُوَ يُحْيِي وَيُمِيتُ رَبُّكُمْ وَرَبُّ آبَائِكُمُ الْأَوَّلِينَ","prev":{"a":7,"text":"رَبِّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا إِنْ كُنْتُمْ مُوقِنِينَ"},"next":{"a":9,"text":"بَلْ هُمْ فِي شَكٍّ يَلْعَبُونَ"},"context":"قبلها: رب السماوات والأرض.","reason":"الإحياء والإماتة."}],"hadiths":[],"situations":[{"situationId":103,"verses":[{"i":3,"strength":"direct","bridge":"﴿لَا إِلَهَ إِلَّا هُوَ يُحْيِي وَيُمِيتُ رَبُّكُمْ وَرَبُّ آبَائِكُمُ الْأَوَّلِينَ﴾."}],"hadiths":[]},{"situationId":124,"verses":[{"i":1,"strength":"direct","bridge":"﴿قَالَ رَبُّكُمْ وَرَبُّ آبَائِكُمُ الْأَوَّلِينَ﴾."},{"i":2,"strength":"direct","bridge":"﴿اللَّهَ رَبَّكُمْ وَرَبَّ آبَائِكُمُ الْأَوَّلِينَ﴾."}],"hadiths":[]}]},{"id":365,"name":"رب موسى وهارون / رب هارون وموسى","compound":true,"meaning":"رب موسى وهارون: قالها السحرة حين آمنوا.","teaches":"1. تحديد الرب ليفرّقوه عن ادعاء فرعون.","whenRecall":"- حين تعود إلى الحق بعد الباطل.","whenPray":"1. آمنت برب العالمين.","summary":"من الباطل إلى الإيمان في لحظة.","verses":[{"i":1,"of":5,"s":7,"surah":"الأعراف","a":121,"text":"قَالُوا آمَنَّا بِرَبِّ الْعَالَمِينَ","prev":{"a":120,"text":"وَأُلْقِيَ السَّحَرَةُ سَاجِدِينَ"},"next":{"a":122,"text":"رَبِّ مُوسَى وَهَارُونَ"},"reason":"إعلان الإيمان."},{"i":2,"of":5,"s":7,"surah":"الأعراف","a":122,"text":"رَبِّ مُوسَى وَهَارُونَ","prev":{"a":121,"text":"قَالُوا آمَنَّا بِرَبِّ الْعَالَمِينَ"},"next":{"a":123,"text":"قَالَ فِرْعَوْنُ آمَنْتُمْ بِهِ قَبْلَ أَنْ آذَنَ لَكُمْ إِنَّ هَذَا لَمَكْرٌ مَكَرْتُمُوهُ فِي الْمَدِينَةِ لِتُخْرِجُوا مِنْهَا أَهْلَهَا فَسَوْفَ تَعْلَمُونَ"},"context":"تتمة.","reason":"تحديد الرب."},{"i":3,"of":5,"s":20,"surah":"طه","a":70,"text":"فَأُلْقِيَ السَّحَرَةُ سُجَّدًا قَالُوا آمَنَّا بِرَبِّ هَارُونَ وَمُوسَى","prev":{"a":69,"text":"وَأَلْقِ مَا فِي يَمِينِكَ تَلْقَفْ مَا صَنَعُوا إِنَّمَا صَنَعُوا كَيْدُ سَاحِرٍ وَلَا يُفْلِحُ السَّاحِرُ حَيْثُ أَتَى"},"next":{"a":71,"text":"قَالَ آمَنْتُمْ لَهُ قَبْلَ أَنْ آذَنَ لَكُمْ إِنَّهُ لَكَبِيرُكُمُ الَّذِي عَلَّمَكُمُ السِّحْرَ فَلَأُقَطِّعَنَّ أَيْدِيَكُمْ وَأَرْجُلَكُمْ مِنْ خِلَافٍ وَلَأُصَلِّبَنَّكُمْ فِي جُذُوعِ النَّخْلِ وَلَتَعْلَمُنَّ أَيُّنَا أَشَدُّ عَذَابًا وَأَبْقَى"},"context":"بعد تلقف العصا.","reason":"السجود والإيمان."},{"i":4,"of":5,"s":26,"surah":"الشعراء","a":47,"text":"قَالُوا آمَنَّا بِرَبِّ الْعَالَمِينَ","prev":{"a":46,"text":"فَأُلْقِيَ السَّحَرَةُ سَاجِدِينَ"},"next":{"a":48,"text":"رَبِّ مُوسَى وَهَارُونَ"},"reason":"إعلان الإيمان."},{"i":5,"of":5,"s":26,"surah":"الشعراء","a":48,"text":"رَبِّ مُوسَى وَهَارُونَ","prev":{"a":47,"text":"قَالُوا آمَنَّا بِرَبِّ الْعَالَمِينَ"},"next":{"a":49,"text":"قَالَ آمَنْتُمْ لَهُ قَبْلَ أَنْ آذَنَ لَكُمْ إِنَّهُ لَكَبِيرُكُمُ الَّذِي عَلَّمَكُمُ السِّحْرَ فَلَسَوْفَ تَعْلَمُونَ لَأُقَطِّعَنَّ أَيْدِيَكُمْ وَأَرْجُلَكُمْ مِنْ خِلَافٍ وَلَأُصَلِّبَنَّكُمْ أَجْمَعِينَ"},"context":"تتمة.","reason":"تحديد الرب."}],"hadiths":[],"situations":[{"situationId":27,"verses":[{"i":1,"strength":"direct","bridge":"﴿قَالُوا آمَنَّا بِرَبِّ الْعَالَمِينَ﴾."},{"i":2,"strength":"direct","bridge":"﴿رَبِّ مُوسَى وَهَارُونَ﴾."},{"i":3,"strength":"direct","bridge":"﴿فَأُلْقِيَ السَّحَرَةُ سُجَّدًا قَالُوا آمَنَّا بِرَبِّ هَارُونَ وَمُوسَى﴾."},{"i":4,"strength":"direct","bridge":"﴿قَالُوا آمَنَّا بِرَبِّ الْعَالَمِينَ﴾."},{"i":5,"strength":"direct","bridge":"﴿رَبِّ مُوسَى وَهَارُونَ﴾."}],"hadiths":[]}]},{"id":366,"name":"كاف عبده","compound":true,"meaning":"أليس الله بكاف عبده: كفايته لعبده تامة.","teaches":"1. ردٌّ على تخويف النبي ﷺ بالآلهة.","whenRecall":"- حين يُخوّفونك.","whenPray":"1. أليس الله بكاف عبده.","summary":"يكفيك الله من كل ما تُخوَّف به.","verses":[{"i":1,"of":1,"s":39,"surah":"الزمر","a":36,"text":"أَلَيْسَ اللَّهُ بِكَافٍ عَبْدَهُ وَيُخَوِّفُونَكَ بِالَّذِينَ مِنْ دُونِهِ وَمَنْ يُضْلِلِ اللَّهُ فَمَا لَهُ مِنْ هَادٍ","prev":{"a":35,"text":"لِيُكَفِّرَ اللَّهُ عَنْهُمْ أَسْوَأَ الَّذِي عَمِلُوا وَيَجْزِيَهُمْ أَجْرَهُمْ بِأَحْسَنِ الَّذِي كَانُوا يَعْمَلُونَ"},"next":{"a":37,"text":"وَمَنْ يَهْدِ اللَّهُ فَمَا لَهُ مِنْ مُضِلٍّ أَلَيْسَ اللَّهُ بِعَزِيزٍ ذِي انْتِقَامٍ"},"context":"قبلها: ليكفر الله عنهم أسوأ الذي عملوا.","reason":"تخويفه بآلهتهم."}],"hadiths":[],"situations":[{"situationId":33,"verses":[{"i":1,"strength":"direct","bridge":"إذا خوّفوك: ﴿أَلَيْسَ اللَّهُ بِكَافٍ عَبْدَهُ وَيُخَوِّفُونَكَ بِالَّذِينَ مِنْ دُونِهِ﴾."}],"hadiths":[]}]},{"id":367,"name":"رءُوف بالعباد","compound":true,"meaning":"رءوف بالعباد: شديد الرحمة الرفيقة بعباده.","teaches":"1. مع من باع نفسه لله.\n2. ومع التحذير من نفسه.","whenRecall":"- حين تبذل نفسك لله.","whenPray":"1. يا رءوف ارأف بي.","summary":"التحذير نفسه رأفة.","verses":[{"i":1,"of":2,"s":2,"surah":"البقرة","a":207,"text":"وَمِنَ النَّاسِ مَنْ يَشْرِي نَفْسَهُ ابْتِغَاءَ مَرْضَاتِ اللَّهِ وَاللَّهُ رَءُوفٌ بِالْعِبَادِ","prev":{"a":206,"text":"وَإِذَا قِيلَ لَهُ اتَّقِ اللَّهَ أَخَذَتْهُ الْعِزَّةُ بِالْإِثْمِ فَحَسْبُهُ جَهَنَّمُ وَلَبِئْسَ الْمِهَادُ"},"next":{"a":208,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا ادْخُلُوا فِي السِّلْمِ كَافَّةً وَلَا تَتَّبِعُوا خُطُوَاتِ الشَّيْطَانِ إِنَّهُ لَكُمْ عَدُوٌّ مُبِينٌ"},"context":"قبلها: من إذا قيل له اتق الله أخذته العزة.","reason":"مقابلة: من يشري نفسه لله."},{"i":2,"of":2,"s":3,"surah":"آل عمران","a":30,"text":"يَوْمَ تَجِدُ كُلُّ نَفْسٍ مَا عَمِلَتْ مِنْ خَيْرٍ مُحْضَرًا وَمَا عَمِلَتْ مِنْ سُوءٍ تَوَدُّ لَوْ أَنَّ بَيْنَهَا وَبَيْنَهُ أَمَدًا بَعِيدًا وَيُحَذِّرُكُمُ اللَّهُ نَفْسَهُ وَاللَّهُ رَءُوفٌ بِالْعِبَادِ","prev":{"a":29,"text":"قُلْ إِنْ تُخْفُوا مَا فِي صُدُورِكُمْ أَوْ تُبْدُوهُ يَعْلَمْهُ اللَّهُ وَيَعْلَمُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},"next":{"a":31,"text":"قُلْ إِنْ كُنْتُمْ تُحِبُّونَ اللَّهَ فَاتَّبِعُونِي يُحْبِبْكُمُ اللَّهُ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ"},"context":"قبلها: إن تخفوا ما في صدوركم.","reason":"يوم تجد كل نفس ما عملت."}],"hadiths":[],"situations":[{"situationId":140,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَمِنَ النَّاسِ مَنْ يَشْرِي نَفْسَهُ ابْتِغَاءَ مَرْضَاتِ اللَّهِ﴾."}],"hadiths":[]},{"situationId":185,"verses":[{"i":2,"strength":"direct","bridge":"﴿تَوَدُّ لَوْ أَنَّ بَيْنَهَا وَبَيْنَهُ أَمَدًا بَعِيدًا وَيُحَذِّرُكُمُ اللَّهُ نَفْسَهُ﴾."}],"hadiths":[]}]},{"id":368,"name":"مُحيي الموتى","compound":true,"meaning":"محيي الموتى: كما يحيي الأرض بعد موتها يحيي الموتى.","teaches":"1. حجة البعث بإحياء الأرض.","whenRecall":"- عند رؤية المطر والنبات.","whenPray":"1. سبحان محيي الموتى.","summary":"المطر درسٌ في البعث.","verses":[{"i":1,"of":2,"s":30,"surah":"الروم","a":50,"text":"فَانْظُرْ إِلَى آثَارِ رَحْمَتِ اللَّهِ كَيْفَ يُحْيِي الْأَرْضَ بَعْدَ مَوْتِهَا إِنَّ ذَلِكَ لَمُحْيِي الْمَوْتَى وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":49,"text":"وَإِنْ كَانُوا مِنْ قَبْلِ أَنْ يُنَزَّلَ عَلَيْهِمْ مِنْ قَبْلِهِ لَمُبْلِسِينَ"},"next":{"a":51,"text":"وَلَئِنْ أَرْسَلْنَا رِيحًا فَرَأَوْهُ مُصْفَرًّا لَظَلُّوا مِنْ بَعْدِهِ يَكْفُرُونَ"},"context":"قبلها: كانوا من قبل أن ينزل عليهم لمبلسين.","reason":"آثار الرحمة."},{"i":2,"of":2,"s":41,"surah":"فصلت","a":39,"text":"وَمِنْ آيَاتِهِ أَنَّكَ تَرَى الْأَرْضَ خَاشِعَةً فَإِذَا أَنْزَلْنَا عَلَيْهَا الْمَاءَ اهْتَزَّتْ وَرَبَتْ إِنَّ الَّذِي أَحْيَاهَا لَمُحْيِي الْمَوْتَى إِنَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":38,"text":"فَإِنِ اسْتَكْبَرُوا فَالَّذِينَ عِنْدَ رَبِّكَ يُسَبِّحُونَ لَهُ بِاللَّيْلِ وَالنَّهَارِ وَهُمْ لَا يَسْأَمُونَ"},"next":{"a":40,"text":"إِنَّ الَّذِينَ يُلْحِدُونَ فِي آيَاتِنَا لَا يَخْفَوْنَ عَلَيْنَا أَفَمَنْ يُلْقَى فِي النَّارِ خَيْرٌ أَمْ مَنْ يَأْتِي آمِنًا يَوْمَ الْقِيَامَةِ اعْمَلُوا مَا شِئْتُمْ إِنَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ"},"context":"قبلها: الذين عند ربك يسبحون.","reason":"الأرض الخاشعة تهتز."}],"hadiths":[],"situations":[{"situationId":176,"verses":[{"i":1,"strength":"direct","bridge":"﴿فَانْظُرْ إِلَى آثَارِ رَحْمَتِ اللَّهِ كَيْفَ يُحْيِي الْأَرْضَ بَعْدَ مَوْتِهَا﴾."},{"i":2,"strength":"direct","bridge":"﴿إِنَّ الَّذِي أَحْيَاهَا لَمُحْيِي الْمَوْتَى﴾."}],"hadiths":[]}]},{"id":369,"name":"الله مولاهم الحق","compound":true,"meaning":"مولاهم الحق: يُرد الخلق إلى سيدهم الحق.","teaches":"1. عند الموت، ويوم القيامة.","whenRecall":"- عند ذكر الموت.","whenPray":"1. اللهم أنت مولاي الحق.","summary":"الرد إلى المولى الحق، ويضل ما افتروا.","verses":[{"i":1,"of":2,"s":6,"surah":"الأنعام","a":62,"text":"ثُمَّ رُدُّوا إِلَى اللَّهِ مَوْلَاهُمُ الْحَقِّ أَلَا لَهُ الْحُكْمُ وَهُوَ أَسْرَعُ الْحَاسِبِينَ","prev":{"a":61,"text":"وَهُوَ الْقَاهِرُ فَوْقَ عِبَادِهِ وَيُرْسِلُ عَلَيْكُمْ حَفَظَةً حَتَّى إِذَا جَاءَ أَحَدَكُمُ الْمَوْتُ تَوَفَّتْهُ رُسُلُنَا وَهُمْ لَا يُفَرِّطُونَ"},"next":{"a":63,"text":"قُلْ مَنْ يُنَجِّيكُمْ مِنْ ظُلُمَاتِ الْبَرِّ وَالْبَحْرِ تَدْعُونَهُ تَضَرُّعًا وَخُفْيَةً لَئِنْ أَنْجَانَا مِنْ هَذِهِ لَنَكُونَنَّ مِنَ الشَّاكِرِينَ"},"context":"قبلها: يرسل عليكم حفظة.","reason":"الرد إلى الله بعد الموت."},{"i":2,"of":2,"s":10,"surah":"يونس","a":30,"text":"هُنَالِكَ تَبْلُو كُلُّ نَفْسٍ مَا أَسْلَفَتْ وَرُدُّوا إِلَى اللَّهِ مَوْلَاهُمُ الْحَقِّ وَضَلَّ عَنْهُمْ مَا كَانُوا يَفْتَرُونَ","prev":{"a":29,"text":"فَكَفَى بِاللَّهِ شَهِيدًا بَيْنَنَا وَبَيْنَكُمْ إِنْ كُنَّا عَنْ عِبَادَتِكُمْ لَغَافِلِينَ"},"next":{"a":31,"text":"قُلْ مَنْ يَرْزُقُكُمْ مِنَ السَّمَاءِ وَالْأَرْضِ أَمَّنْ يَمْلِكُ السَّمْعَ وَالْأَبْصَارَ وَمَنْ يُخْرِجُ الْحَيَّ مِنَ الْمَيِّتِ وَيُخْرِجُ الْمَيِّتَ مِنَ الْحَيِّ وَمَنْ يُدَبِّرُ الْأَمْرَ فَسَيَقُولُونَ اللَّهُ فَقُلْ أَفَلَا تَتَّقُونَ"},"context":"يوم الحشر.","reason":"تختبر كل نفس ما أسلفت."}],"hadiths":[],"situations":[{"situationId":182,"verses":[{"i":1,"strength":"direct","bridge":"﴿ثُمَّ رُدُّوا إِلَى اللَّهِ مَوْلَاهُمُ الْحَقِّ﴾."}],"hadiths":[]},{"situationId":185,"verses":[{"i":2,"strength":"direct","bridge":"﴿هُنَالِكَ تَبْلُو كُلُّ نَفْسٍ مَا أَسْلَفَتْ﴾."}],"hadiths":[]}]},{"id":370,"name":"ذو فضل على الناس","compound":true,"meaning":"ذو فضل على الناس: فضله يعم، وأكثرهم لا يشكرون.","teaches":"1. تأتي غالبًا مع: ولكن أكثرهم لا يشكرون.","whenRecall":"- عند الغفلة عن النعم.","whenPray":"1. اللهم أعني على شكرك.","summary":"الفضل عام، والشكر قليل.","verses":[{"i":1,"of":4,"s":2,"surah":"البقرة","a":243,"text":"أَلَمْ تَرَ إِلَى الَّذِينَ خَرَجُوا مِنْ دِيَارِهِمْ وَهُمْ أُلُوفٌ حَذَرَ الْمَوْتِ فَقَالَ لَهُمُ اللَّهُ مُوتُوا ثُمَّ أَحْيَاهُمْ إِنَّ اللَّهَ لَذُو فَضْلٍ عَلَى النَّاسِ وَلَكِنَّ أَكْثَرَ النَّاسِ لَا يَشْكُرُونَ","prev":{"a":242,"text":"كَذَلِكَ يُبَيِّنُ اللَّهُ لَكُمْ آيَاتِهِ لَعَلَّكُمْ تَعْقِلُونَ"},"next":{"a":244,"text":"وَقَاتِلُوا فِي سَبِيلِ اللَّهِ وَاعْلَمُوا أَنَّ اللَّهَ سَمِيعٌ عَلِيمٌ"},"context":"قبلها: يبين الله لكم آياته.","reason":"الذين خرجوا حذر الموت ثم أحياهم."},{"i":2,"of":4,"s":10,"surah":"يونس","a":60,"text":"وَمَا ظَنُّ الَّذِينَ يَفْتَرُونَ عَلَى اللَّهِ الْكَذِبَ يَوْمَ الْقِيَامَةِ إِنَّ اللَّهَ لَذُو فَضْلٍ عَلَى النَّاسِ وَلَكِنَّ أَكْثَرَهُمْ لَا يَشْكُرُونَ","prev":{"a":59,"text":"قُلْ أَرَأَيْتُمْ مَا أَنْزَلَ اللَّهُ لَكُمْ مِنْ رِزْقٍ فَجَعَلْتُمْ مِنْهُ حَرَامًا وَحَلَالًا قُلْ آللَّهُ أَذِنَ لَكُمْ أَمْ عَلَى اللَّهِ تَفْتَرُونَ"},"next":{"a":61,"text":"وَمَا تَكُونُ فِي شَأْنٍ وَمَا تَتْلُو مِنْهُ مِنْ قُرْآنٍ وَلَا تَعْمَلُونَ مِنْ عَمَلٍ إِلَّا كُنَّا عَلَيْكُمْ شُهُودًا إِذْ تُفِيضُونَ فِيهِ وَمَا يَعْزُبُ عَنْ رَبِّكَ مِنْ مِثْقَالِ ذَرَّةٍ فِي الْأَرْضِ وَلَا فِي السَّمَاءِ وَلَا أَصْغَرَ مِنْ ذَلِكَ وَلَا أَكْبَرَ إِلَّا فِي كِتَابٍ مُبِينٍ"},"context":"قبلها: ما أنزل الله لكم من رزق فجعلتم منه حرامًا.","reason":"الفضل والشكر."},{"i":3,"of":4,"s":27,"surah":"النمل","a":73,"text":"وَإِنَّ رَبَّكَ لَذُو فَضْلٍ عَلَى النَّاسِ وَلَكِنَّ أَكْثَرَهُمْ لَا يَشْكُرُونَ","prev":{"a":72,"text":"قُلْ عَسَى أَنْ يَكُونَ رَدِفَ لَكُمْ بَعْضُ الَّذِي تَسْتَعْجِلُونَ"},"next":{"a":74,"text":"وَإِنَّ رَبَّكَ لَيَعْلَمُ مَا تُكِنُّ صُدُورُهُمْ وَمَا يُعْلِنُونَ"},"context":"قبلها: عسى أن يكون ردف لكم.","reason":"تأخير العذاب فضل."},{"i":4,"of":4,"s":40,"surah":"غافر","a":61,"text":"اللَّهُ الَّذِي جَعَلَ لَكُمُ اللَّيْلَ لِتَسْكُنُوا فِيهِ وَالنَّهَارَ مُبْصِرًا إِنَّ اللَّهَ لَذُو فَضْلٍ عَلَى النَّاسِ وَلَكِنَّ أَكْثَرَ النَّاسِ لَا يَشْكُرُونَ","prev":{"a":60,"text":"وَقَالَ رَبُّكُمُ ادْعُونِي أَسْتَجِبْ لَكُمْ إِنَّ الَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِي سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ"},"next":{"a":62,"text":"ذَلِكُمُ اللَّهُ رَبُّكُمْ خَالِقُ كُلِّ شَيْءٍ لَا إِلَهَ إِلَّا هُوَ فَأَنَّى تُؤْفَكُونَ"},"context":"قبلها: ادعوني أستجب لكم.","reason":"الليل للسكن والنهار مبصرًا."}],"hadiths":[],"situations":[{"situationId":143,"verses":[{"i":1,"strength":"direct","bridge":"﴿إِنَّ اللَّهَ لَذُو فَضْلٍ عَلَى النَّاسِ وَلَكِنَّ أَكْثَرَ النَّاسِ لَا يَشْكُرُونَ﴾."},{"i":3,"strength":"direct","bridge":"﴿وَإِنَّ رَبَّكَ لَذُو فَضْلٍ عَلَى النَّاسِ﴾."}],"hadiths":[]},{"situationId":177,"verses":[{"i":4,"strength":"direct","bridge":"﴿اللَّهُ الَّذِي جَعَلَ لَكُمُ اللَّيْلَ لِتَسْكُنُوا فِيهِ وَالنَّهَارَ مُبْصِرًا﴾."}],"hadiths":[]},{"situationId":196,"verses":[{"i":2,"strength":"direct","bridge":"﴿إِنَّ اللَّهَ لَذُو فَضْلٍ عَلَى النَّاسِ وَلَكِنَّ أَكْثَرَهُمْ لَا يَشْكُرُونَ﴾."}],"hadiths":[]}]},{"id":371,"name":"بارئكم","compound":false,"meaning":"بارئكم: خالقكم الذي أوجدكم سويًّا.","teaches":"1. قالها موسى بعد عبادة العجل: فتوبوا إلى بارئكم.","whenRecall":"- عند التوبة من الشرك.","whenPray":"1. توبوا إلى بارئكم.","summary":"التوبة إلى من خلقك.","verses":[{"i":1,"of":1,"s":2,"surah":"البقرة","a":54,"text":"وَإِذْ قَالَ مُوسَى لِقَوْمِهِ يَا قَوْمِ إِنَّكُمْ ظَلَمْتُمْ أَنْفُسَكُمْ بِاتِّخَاذِكُمُ الْعِجْلَ فَتُوبُوا إِلَى بَارِئِكُمْ فَاقْتُلُوا أَنْفُسَكُمْ ذَلِكُمْ خَيْرٌ لَكُمْ عِنْدَ بَارِئِكُمْ فَتَابَ عَلَيْكُمْ إِنَّهُ هُوَ التَّوَّابُ الرَّحِيمُ","prev":{"a":53,"text":"وَإِذْ آتَيْنَا مُوسَى الْكِتَابَ وَالْفُرْقَانَ لَعَلَّكُمْ تَهْتَدُونَ"},"next":{"a":55,"text":"وَإِذْ قُلْتُمْ يَا مُوسَى لَنْ نُؤْمِنَ لَكَ حَتَّى نَرَى اللَّهَ جَهْرَةً فَأَخَذَتْكُمُ الصَّاعِقَةُ وَأَنْتُمْ تَنْظُرُونَ"},"context":"قبلها: آتينا موسى الكتاب.","reason":"التوبة إلى الخالق."}],"hadiths":[],"situations":[{"situationId":17,"verses":[{"i":1,"strength":"direct","bridge":"﴿إِنَّكُمْ ظَلَمْتُمْ أَنْفُسَكُمْ بِاتِّخَاذِكُمُ الْعِجْلَ فَتُوبُوا إِلَى بَارِئِكُمْ﴾."}],"hadiths":[]}]},{"id":372,"name":"آخذ بناصية كل دابة","compound":true,"meaning":"آخذ بناصيتها: كل مخلوق في قبضته وتصرفه.","teaches":"1. قالها هود متحديًا قومه.","whenRecall":"- حين تخاف كيد الناس.","whenPray":"1. ناصيتي بيدك.","summary":"كل من تخافه ناصيته بيد الله.","verses":[{"i":1,"of":1,"s":11,"surah":"هود","a":56,"text":"إِنِّي تَوَكَّلْتُ عَلَى اللَّهِ رَبِّي وَرَبِّكُمْ مَا مِنْ دَابَّةٍ إِلَّا هُوَ آخِذٌ بِنَاصِيَتِهَا إِنَّ رَبِّي عَلَى صِرَاطٍ مُسْتَقِيمٍ","prev":{"a":55,"text":"مِنْ دُونِهِ فَكِيدُونِي جَمِيعًا ثُمَّ لَا تُنْظِرُونِ"},"next":{"a":57,"text":"فَإِنْ تَوَلَّوْا فَقَدْ أَبْلَغْتُكُمْ مَا أُرْسِلْتُ بِهِ إِلَيْكُمْ وَيَسْتَخْلِفُ رَبِّي قَوْمًا غَيْرَكُمْ وَلَا تَضُرُّونَهُ شَيْئًا إِنَّ رَبِّي عَلَى كُلِّ شَيْءٍ حَفِيظٌ"},"context":"قبلها: فكيدوني جميعًا ثم لا تنظرون.","reason":"التوكل والتحدي."}],"hadiths":[],"situations":[{"situationId":30,"verses":[{"i":1,"strength":"direct","bridge":"﴿إِنِّي تَوَكَّلْتُ عَلَى اللَّهِ رَبِّي وَرَبِّكُمْ مَا مِنْ دَابَّةٍ إِلَّا هُوَ آخِذٌ بِنَاصِيَتِهَا﴾."}],"hadiths":[]}]},{"id":373,"name":"بعباده خبيراً بصيراً","compound":true,"meaning":"بعباده خبيرًا بصيرًا: يعلم ما يصلح عباده ويرى أحوالهم.","teaches":"1. يبسط الرزق ويقدر.\n2. لو بسط الرزق لبغوا.","whenRecall":"- حين يضيق رزقك.","whenPray":"1. اللهم ارزقني ما يصلحني.","summary":"التقدير في الرزق عن خبرة وبصر.","verses":[{"i":1,"of":4,"s":17,"surah":"الإسراء","a":30,"text":"إِنَّ رَبَّكَ يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ وَيَقْدِرُ إِنَّهُ كَانَ بِعِبَادِهِ خَبِيرًا بَصِيرًا","prev":{"a":29,"text":"وَلَا تَجْعَلْ يَدَكَ مَغْلُولَةً إِلَى عُنُقِكَ وَلَا تَبْسُطْهَا كُلَّ الْبَسْطِ فَتَقْعُدَ مَلُومًا مَحْسُورًا"},"next":{"a":31,"text":"وَلَا تَقْتُلُوا أَوْلَادَكُمْ خَشْيَةَ إِمْلَاقٍ نَحْنُ نَرْزُقُهُمْ وَإِيَّاكُمْ إِنَّ قَتْلَهُمْ كَانَ خِطْئًا كَبِيرًا"},"context":"قبلها: لا تجعل يدك مغلولة.","reason":"البسط والقدر."},{"i":2,"of":4,"s":17,"surah":"الإسراء","a":96,"text":"قُلْ كَفَى بِاللَّهِ شَهِيدًا بَيْنِي وَبَيْنَكُمْ إِنَّهُ كَانَ بِعِبَادِهِ خَبِيرًا بَصِيرًا","prev":{"a":95,"text":"قُلْ لَوْ كَانَ فِي الْأَرْضِ مَلَائِكَةٌ يَمْشُونَ مُطْمَئِنِّينَ لَنَزَّلْنَا عَلَيْهِمْ مِنَ السَّمَاءِ مَلَكًا رَسُولًا"},"next":{"a":97,"text":"وَمَنْ يَهْدِ اللَّهُ فَهُوَ الْمُهْتَدِ وَمَنْ يُضْلِلْ فَلَنْ تَجِدَ لَهُمْ أَوْلِيَاءَ مِنْ دُونِهِ وَنَحْشُرُهُمْ يَوْمَ الْقِيَامَةِ عَلَى وُجُوهِهِمْ عُمْيًا وَبُكْمًا وَصُمًّا مَأْوَاهُمْ جَهَنَّمُ كُلَّمَا خَبَتْ زِدْنَاهُمْ سَعِيرًا"},"context":"مطالب المشركين.","reason":"الشهادة."},{"i":3,"of":4,"s":35,"surah":"فاطر","a":31,"text":"وَالَّذِي أَوْحَيْنَا إِلَيْكَ مِنَ الْكِتَابِ هُوَ الْحَقُّ مُصَدِّقًا لِمَا بَيْنَ يَدَيْهِ إِنَّ اللَّهَ بِعِبَادِهِ لَخَبِيرٌ بَصِيرٌ","prev":{"a":30,"text":"لِيُوَفِّيَهُمْ أُجُورَهُمْ وَيَزِيدَهُمْ مِنْ فَضْلِهِ إِنَّهُ غَفُورٌ شَكُورٌ"},"next":{"a":32,"text":"ثُمَّ أَوْرَثْنَا الْكِتَابَ الَّذِينَ اصْطَفَيْنَا مِنْ عِبَادِنَا فَمِنْهُمْ ظَالِمٌ لِنَفْسِهِ وَمِنْهُمْ مُقْتَصِدٌ وَمِنْهُمْ سَابِقٌ بِالْخَيْرَاتِ بِإِذْنِ اللَّهِ ذَلِكَ هُوَ الْفَضْلُ الْكَبِيرُ"},"context":"قبلها: ليوفيهم أجورهم.","reason":"الكتاب حق مصدق."},{"i":4,"of":4,"s":42,"surah":"الشورى","a":27,"text":"وَلَوْ بَسَطَ اللَّهُ الرِّزْقَ لِعِبَادِهِ لَبَغَوْا فِي الْأَرْضِ وَلَكِنْ يُنَزِّلُ بِقَدَرٍ مَا يَشَاءُ إِنَّهُ بِعِبَادِهِ خَبِيرٌ بَصِيرٌ","prev":{"a":26,"text":"وَيَسْتَجِيبُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَيَزِيدُهُمْ مِنْ فَضْلِهِ وَالْكَافِرُونَ لَهُمْ عَذَابٌ شَدِيدٌ"},"next":{"a":28,"text":"وَهُوَ الَّذِي يُنَزِّلُ الْغَيْثَ مِنْ بَعْدِ مَا قَنَطُوا وَيَنْشُرُ رَحْمَتَهُ وَهُوَ الْوَلِيُّ الْحَمِيدُ"},"context":"قبلها: يستجيب الذين آمنوا.","reason":"حكمة تقدير الرزق."}],"hadiths":[],"situations":[{"situationId":39,"verses":[{"i":1,"strength":"direct","bridge":"﴿إِنَّ رَبَّكَ يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ وَيَقْدِرُ﴾."},{"i":4,"strength":"direct","bridge":"﴿وَلَوْ بَسَطَ اللَّهُ الرِّزْقَ لِعِبَادِهِ لَبَغَوْا فِي الْأَرْضِ﴾."}],"hadiths":[]},{"situationId":107,"verses":[{"i":3,"strength":"direct","bridge":"﴿وَالَّذِي أَوْحَيْنَا إِلَيْكَ مِنَ الْكِتَابِ هُوَ الْحَقُّ﴾."}],"hadiths":[]},{"situationId":136,"verses":[{"i":2,"strength":"direct","bridge":"﴿قُلْ كَفَى بِاللَّهِ شَهِيدًا بَيْنِي وَبَيْنَكُمْ﴾."}],"hadiths":[]}]},{"id":374,"name":"بذنوب عباده خبيراً بصيراً","compound":true,"meaning":"بذنوب عباده خبيرًا بصيرًا: يعلم الذنوب ويراها.","teaches":"1. بعد ذكر إهلاك القرون.","whenRecall":"- حين تستهين بالذنب.","whenPray":"1. اللهم اغفر لي ما تعلم.","summary":"الذنوب معلومة، والقرون الهالكة شاهد.","verses":[{"i":1,"of":1,"s":17,"surah":"الإسراء","a":17,"text":"وَكَمْ أَهْلَكْنَا مِنَ الْقُرُونِ مِنْ بَعْدِ نُوحٍ وَكَفَى بِرَبِّكَ بِذُنُوبِ عِبَادِهِ خَبِيرًا بَصِيرًا","prev":{"a":16,"text":"وَإِذَا أَرَدْنَا أَنْ نُهْلِكَ قَرْيَةً أَمَرْنَا مُتْرَفِيهَا فَفَسَقُوا فِيهَا فَحَقَّ عَلَيْهَا الْقَوْلُ فَدَمَّرْنَاهَا تَدْمِيرًا"},"next":{"a":18,"text":"مَنْ كَانَ يُرِيدُ الْعَاجِلَةَ عَجَّلْنَا لَهُ فِيهَا مَا نَشَاءُ لِمَنْ نُرِيدُ ثُمَّ جَعَلْنَا لَهُ جَهَنَّمَ يَصْلَاهَا مَذْمُومًا مَدْحُورًا"},"context":"قبلها: إذا أردنا أن نهلك قرية.","reason":"هلاك القرون بذنوبها."}],"hadiths":[],"situations":[{"situationId":180,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَكَمْ أَهْلَكْنَا مِنَ الْقُرُونِ مِنْ بَعْدِ نُوحٍ﴾."}],"hadiths":[]}]},{"id":375,"name":"ذو مغفرة للناس على ظلمهم","compound":true,"meaning":"ذو مغفرة للناس على ظلمهم: يغفر مع وجود الظلم، وهو شديد العقاب.","teaches":"1. المغفرة والعقاب في آية.","whenRecall":"- حين تيأس.","whenPray":"1. اغفر لي على ظلمي.","summary":"مغفرة واسعة وعقاب شديد.","verses":[{"i":1,"of":1,"s":13,"surah":"الرعد","a":6,"text":"وَيَسْتَعْجِلُونَكَ بِالسَّيِّئَةِ قَبْلَ الْحَسَنَةِ وَقَدْ خَلَتْ مِنْ قَبْلِهِمُ الْمَثُلَاتُ وَإِنَّ رَبَّكَ لَذُو مَغْفِرَةٍ لِلنَّاسِ عَلَى ظُلْمِهِمْ وَإِنَّ رَبَّكَ لَشَدِيدُ الْعِقَابِ","prev":{"a":5,"text":"وَإِنْ تَعْجَبْ فَعَجَبٌ قَوْلُهُمْ أَإِذَا كُنَّا تُرَابًا أَإِنَّا لَفِي خَلْقٍ جَدِيدٍ أُولَئِكَ الَّذِينَ كَفَرُوا بِرَبِّهِمْ وَأُولَئِكَ الْأَغْلَالُ فِي أَعْنَاقِهِمْ وَأُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ"},"next":{"a":7,"text":"وَيَقُولُ الَّذِينَ كَفَرُوا لَوْلَا أُنْزِلَ عَلَيْهِ آيَةٌ مِنْ رَبِّهِ إِنَّمَا أَنْتَ مُنْذِرٌ وَلِكُلِّ قَوْمٍ هَادٍ"},"context":"قبلها: عجبٌ قولهم أئذا كنا ترابًا.","reason":"استعجال العذاب."}],"hadiths":[],"situations":[{"situationId":22,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَإِنَّ رَبَّكَ لَذُو مَغْفِرَةٍ لِلنَّاسِ عَلَى ظُلْمِهِمْ﴾."}],"hadiths":[]}]},{"id":376,"name":"عليم بالظالمين","compound":true,"meaning":"عليم بالظالمين: يعلمهم وما يستحقون.","teaches":"1. لا يتمنون الموت بما قدمت أيديهم.\n2. من تولى عن القتال.","whenRecall":"- حين تكره الموت لسوء عملك.","whenPray":"1. اللهم لا تجعلني من الظالمين.","summary":"كراهة الموت دليل ما قدمت اليد.","verses":[{"i":1,"of":4,"s":2,"surah":"البقرة","a":95,"text":"وَلَنْ يَتَمَنَّوْهُ أَبَدًا بِمَا قَدَّمَتْ أَيْدِيهِمْ وَاللَّهُ عَلِيمٌ بِالظَّالِمِينَ","prev":{"a":94,"text":"قُلْ إِنْ كَانَتْ لَكُمُ الدَّارُ الْآخِرَةُ عِنْدَ اللَّهِ خَالِصَةً مِنْ دُونِ النَّاسِ فَتَمَنَّوُا الْمَوْتَ إِنْ كُنْتُمْ صَادِقِينَ"},"next":{"a":96,"text":"وَلَتَجِدَنَّهُمْ أَحْرَصَ النَّاسِ عَلَى حَيَاةٍ وَمِنَ الَّذِينَ أَشْرَكُوا يَوَدُّ أَحَدُهُمْ لَوْ يُعَمَّرُ أَلْفَ سَنَةٍ وَمَا هُوَ بِمُزَحْزِحِهِ مِنَ الْعَذَابِ أَنْ يُعَمَّرَ وَاللَّهُ بَصِيرٌ بِمَا يَعْمَلُونَ"},"context":"قبلها: إن كانت لكم الدار الآخرة خالصة.","reason":"لا يتمنون الموت."},{"i":2,"of":4,"s":2,"surah":"البقرة","a":246,"text":"أَلَمْ تَرَ إِلَى الْمَلَإِ مِنْ بَنِي إِسْرَائِيلَ مِنْ بَعْدِ مُوسَى إِذْ قَالُوا لِنَبِيٍّ لَهُمُ ابْعَثْ لَنَا مَلِكًا نُقَاتِلْ فِي سَبِيلِ اللَّهِ قَالَ هَلْ عَسَيْتُمْ إِنْ كُتِبَ عَلَيْكُمُ الْقِتَالُ أَلَّا تُقَاتِلُوا قَالُوا وَمَا لَنَا أَلَّا نُقَاتِلَ فِي سَبِيلِ اللَّهِ وَقَدْ أُخْرِجْنَا مِنْ دِيَارِنَا وَأَبْنَائِنَا فَلَمَّا كُتِبَ عَلَيْهِمُ الْقِتَالُ تَوَلَّوْا إِلَّا قَلِيلًا مِنْهُمْ وَاللَّهُ عَلِيمٌ بِالظَّالِمِينَ","prev":{"a":245,"text":"مَنْ ذَا الَّذِي يُقْرِضُ اللَّهَ قَرْضًا حَسَنًا فَيُضَاعِفَهُ لَهُ أَضْعَافًا كَثِيرَةً وَاللَّهُ يَقْبِضُ وَيَبْسُطُ وَإِلَيْهِ تُرْجَعُونَ"},"next":{"a":247,"text":"وَقَالَ لَهُمْ نَبِيُّهُمْ إِنَّ اللَّهَ قَدْ بَعَثَ لَكُمْ طَالُوتَ مَلِكًا قَالُوا أَنَّى يَكُونُ لَهُ الْمُلْكُ عَلَيْنَا وَنَحْنُ أَحَقُّ بِالْمُلْكِ مِنْهُ وَلَمْ يُؤْتَ سَعَةً مِنَ الْمَالِ قَالَ إِنَّ اللَّهَ اصْطَفَاهُ عَلَيْكُمْ وَزَادَهُ بَسْطَةً فِي الْعِلْمِ وَالْجِسْمِ وَاللَّهُ يُؤْتِي مُلْكَهُ مَنْ يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ"},"reason":"تولوا إلا قليلًا."},{"i":3,"of":4,"s":9,"surah":"التوبة","a":47,"text":"لَوْ خَرَجُوا فِيكُمْ مَا زَادُوكُمْ إِلَّا خَبَالًا وَلَأَوْضَعُوا خِلَالَكُمْ يَبْغُونَكُمُ الْفِتْنَةَ وَفِيكُمْ سَمَّاعُونَ لَهُمْ وَاللَّهُ عَلِيمٌ بِالظَّالِمِينَ","prev":{"a":46,"text":"وَلَوْ أَرَادُوا الْخُرُوجَ لَأَعَدُّوا لَهُ عُدَّةً وَلَكِنْ كَرِهَ اللَّهُ انْبِعَاثَهُمْ فَثَبَّطَهُمْ وَقِيلَ اقْعُدُوا مَعَ الْقَاعِدِينَ"},"next":{"a":48,"text":"لَقَدِ ابْتَغَوُا الْفِتْنَةَ مِنْ قَبْلُ وَقَلَّبُوا لَكَ الْأُمُورَ حَتَّى جَاءَ الْحَقُّ وَظَهَرَ أَمْرُ اللَّهِ وَهُمْ كَارِهُونَ"},"context":"المنافقون لو خرجوا.","reason":"ما زادوكم إلا خبالًا."},{"i":4,"of":4,"s":62,"surah":"الجمعة","a":7,"text":"وَلَا يَتَمَنَّوْنَهُ أَبَدًا بِمَا قَدَّمَتْ أَيْدِيهِمْ وَاللَّهُ عَلِيمٌ بِالظَّالِمِينَ","prev":{"a":6,"text":"قُلْ يَا أَيُّهَا الَّذِينَ هَادُوا إِنْ زَعَمْتُمْ أَنَّكُمْ أَوْلِيَاءُ لِلَّهِ مِنْ دُونِ النَّاسِ فَتَمَنَّوُا الْمَوْتَ إِنْ كُنْتُمْ صَادِقِينَ"},"next":{"a":8,"text":"قُلْ إِنَّ الْمَوْتَ الَّذِي تَفِرُّونَ مِنْهُ فَإِنَّهُ مُلَاقِيكُمْ ثُمَّ تُرَدُّونَ إِلَى عَالِمِ الْغَيْبِ وَالشَّهَادَةِ فَيُنَبِّئُكُمْ بِمَا كُنْتُمْ تَعْمَلُونَ"},"context":"قبلها: إن زعمتم أنكم أولياء لله.","reason":"لا يتمنونه."}],"hadiths":[],"situations":[{"situationId":67,"verses":[{"i":3,"strength":"direct","bridge":"﴿لَوْ خَرَجُوا فِيكُمْ مَا زَادُوكُمْ إِلَّا خَبَالًا﴾."}],"hadiths":[]},{"situationId":89,"verses":[{"i":4,"strength":"direct","bridge":"﴿وَلَا يَتَمَنَّوْنَهُ أَبَدًا بِمَا قَدَّمَتْ أَيْدِيهِمْ﴾."}],"hadiths":[]},{"situationId":141,"verses":[{"i":2,"strength":"direct","bridge":"﴿هَلْ عَسَيْتُمْ إِنْ كُتِبَ عَلَيْكُمُ الْقِتَالُ أَلَّا تُقَاتِلُوا﴾."}],"hadiths":[]},{"situationId":182,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَلَنْ يَتَمَنَّوْهُ أَبَدًا بِمَا قَدَّمَتْ أَيْدِيهِمْ﴾."}],"hadiths":[]}]},{"id":377,"name":"عليم بالمفسدين","compound":true,"meaning":"عليم بالمفسدين: من تولى بعد البيان فهو مفسد.","teaches":"1. بعد المباهلة.","whenRecall":"- حين تُعرض بعد البيان.","whenPray":"1. اللهم اجعلني من المصلحين.","summary":"التولي بعد الحق إفساد.","verses":[{"i":1,"of":1,"s":3,"surah":"آل عمران","a":63,"text":"فَإِنْ تَوَلَّوْا فَإِنَّ اللَّهَ عَلِيمٌ بِالْمُفْسِدِينَ","prev":{"a":62,"text":"إِنَّ هَذَا لَهُوَ الْقَصَصُ الْحَقُّ وَمَا مِنْ إِلَهٍ إِلَّا اللَّهُ وَإِنَّ اللَّهَ لَهُوَ الْعَزِيزُ الْحَكِيمُ"},"next":{"a":64,"text":"قُلْ يَا أَهْلَ الْكِتَابِ تَعَالَوْا إِلَى كَلِمَةٍ سَوَاءٍ بَيْنَنَا وَبَيْنَكُمْ أَلَّا نَعْبُدَ إِلَّا اللَّهَ وَلَا نُشْرِكَ بِهِ شَيْئًا وَلَا يَتَّخِذَ بَعْضُنَا بَعْضًا أَرْبَابًا مِنْ دُونِ اللَّهِ فَإِنْ تَوَلَّوْا فَقُولُوا اشْهَدُوا بِأَنَّا مُسْلِمُونَ"},"context":"قبلها: إن هذا لهو القصص الحق.","reason":"التولي بعد الحق."}],"hadiths":[],"situations":[{"situationId":121,"verses":[{"i":1,"strength":"direct","bridge":"﴿فَإِنْ تَوَلَّوْا فَإِنَّ اللَّهَ عَلِيمٌ بِالْمُفْسِدِينَ﴾."}],"hadiths":[]}]},{"id":378,"name":"عليم بالمتقين","compound":true,"meaning":"عليم بالمتقين: لا يضيع خيرهم.","teaches":"1. ما يفعلوا من خير فلن يُكفروه.\n2. المؤمنون لا يستأذنون في الجهاد.","whenRecall":"- حين لا يُقدَّر عملك.","whenPray":"1. اللهم اجعلني من المتقين.","summary":"خير المتقي محفوظ.","verses":[{"i":1,"of":2,"s":3,"surah":"آل عمران","a":115,"text":"وَمَا يَفْعَلُوا مِنْ خَيْرٍ فَلَنْ يُكْفَرُوهُ وَاللَّهُ عَلِيمٌ بِالْمُتَّقِينَ","prev":{"a":114,"text":"يُؤْمِنُونَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَيَأْمُرُونَ بِالْمَعْرُوفِ وَيَنْهَوْنَ عَنِ الْمُنْكَرِ وَيُسَارِعُونَ فِي الْخَيْرَاتِ وَأُولَئِكَ مِنَ الصَّالِحِينَ"},"next":{"a":116,"text":"إِنَّ الَّذِينَ كَفَرُوا لَنْ تُغْنِيَ عَنْهُمْ أَمْوَالُهُمْ وَلَا أَوْلَادُهُمْ مِنَ اللَّهِ شَيْئًا وَأُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ"},"context":"قبلها: يأمرون بالمعروف.","reason":"الخير لا يُجحد."},{"i":2,"of":2,"s":9,"surah":"التوبة","a":44,"text":"لَا يَسْتَأْذِنُكَ الَّذِينَ يُؤْمِنُونَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ أَنْ يُجَاهِدُوا بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ وَاللَّهُ عَلِيمٌ بِالْمُتَّقِينَ","prev":{"a":43,"text":"عَفَا اللَّهُ عَنْكَ لِمَ أَذِنْتَ لَهُمْ حَتَّى يَتَبَيَّنَ لَكَ الَّذِينَ صَدَقُوا وَتَعْلَمَ الْكَاذِبِينَ"},"next":{"a":45,"text":"إِنَّمَا يَسْتَأْذِنُكَ الَّذِينَ لَا يُؤْمِنُونَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَارْتَابَتْ قُلُوبُهُمْ فَهُمْ فِي رَيْبِهِمْ يَتَرَدَّدُونَ"},"context":"قبلها: عفا الله عنك لم أذنت لهم.","reason":"المؤمن لا يستأذن."}],"hadiths":[],"situations":[{"situationId":141,"verses":[{"i":2,"strength":"direct","bridge":"﴿لَا يَسْتَأْذِنُكَ الَّذِينَ يُؤْمِنُونَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ أَنْ يُجَاهِدُوا﴾."}],"hadiths":[]},{"situationId":170,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَمَا يَفْعَلُوا مِنْ خَيْرٍ فَلَنْ يُكْفَرُوهُ﴾."}],"hadiths":[]}]},{"id":379,"name":"أعلم بالظالمين","compound":true,"meaning":"أعلم بالظالمين: الحكم بيده، وهو أعلم بمن يستحق.","teaches":"1. لو كان العذاب بيد النبي ﷺ لقضي الأمر.","whenRecall":"- حين تستعجل العقوبة.","whenPray":"1. اللهم احكم بيننا.","summary":"العقوبة ليست بيدك.","verses":[{"i":1,"of":1,"s":6,"surah":"الأنعام","a":58,"text":"قُلْ لَوْ أَنَّ عِنْدِي مَا تَسْتَعْجِلُونَ بِهِ لَقُضِيَ الْأَمْرُ بَيْنِي وَبَيْنَكُمْ وَاللَّهُ أَعْلَمُ بِالظَّالِمِينَ","prev":{"a":57,"text":"قُلْ إِنِّي عَلَى بَيِّنَةٍ مِنْ رَبِّي وَكَذَّبْتُمْ بِهِ مَا عِنْدِي مَا تَسْتَعْجِلُونَ بِهِ إِنِ الْحُكْمُ إِلَّا لِلَّهِ يَقُصُّ الْحَقَّ وَهُوَ خَيْرُ الْفَاصِلِينَ"},"next":{"a":59,"text":"وَعِنْدَهُ مَفَاتِحُ الْغَيْبِ لَا يَعْلَمُهَا إِلَّا هُوَ وَيَعْلَمُ مَا فِي الْبَرِّ وَالْبَحْرِ وَمَا تَسْقُطُ مِنْ وَرَقَةٍ إِلَّا يَعْلَمُهَا وَلَا حَبَّةٍ فِي ظُلُمَاتِ الْأَرْضِ وَلَا رَطْبٍ وَلَا يَابِسٍ إِلَّا فِي كِتَابٍ مُبِينٍ"},"context":"قبلها: إني على بينة من ربي.","reason":"تفويض العقوبة."}],"hadiths":[],"situations":[{"situationId":36,"verses":[{"i":1,"strength":"direct","bridge":"﴿قُلْ لَوْ أَنَّ عِنْدِي مَا تَسْتَعْجِلُونَ بِهِ لَقُضِيَ الْأَمْرُ بَيْنِي وَبَيْنَكُمْ﴾."}],"hadiths":[]}]},{"id":380,"name":"أعلم بالمعتدين","compound":true,"meaning":"أعلم بالمعتدين: يعلم من يضل الناس بأهوائه.","teaches":"1. في الذبائح والأطعمة.","whenRecall":"- حين يحرم الناس ما أحل الله.","whenPray":"1. اللهم علمني الحلال.","summary":"التحريم بالهوى اعتداء.","verses":[{"i":1,"of":1,"s":6,"surah":"الأنعام","a":119,"text":"وَمَا لَكُمْ أَلَّا تَأْكُلُوا مِمَّا ذُكِرَ اسْمُ اللَّهِ عَلَيْهِ وَقَدْ فَصَّلَ لَكُمْ مَا حَرَّمَ عَلَيْكُمْ إِلَّا مَا اضْطُرِرْتُمْ إِلَيْهِ وَإِنَّ كَثِيرًا لَيُضِلُّونَ بِأَهْوَائِهِمْ بِغَيْرِ عِلْمٍ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِالْمُعْتَدِينَ","prev":{"a":118,"text":"فَكُلُوا مِمَّا ذُكِرَ اسْمُ اللَّهِ عَلَيْهِ إِنْ كُنْتُمْ بِآيَاتِهِ مُؤْمِنِينَ"},"next":{"a":120,"text":"وَذَرُوا ظَاهِرَ الْإِثْمِ وَبَاطِنَهُ إِنَّ الَّذِينَ يَكْسِبُونَ الْإِثْمَ سَيُجْزَوْنَ بِمَا كَانُوا يَقْتَرِفُونَ"},"context":"قبلها: كلوا مما ذكر اسم الله عليه.","reason":"الإضلال بالهوى."}],"hadiths":[],"situations":[{"situationId":196,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَإِنَّ كَثِيرًا لَيُضِلُّونَ بِأَهْوَائِهِمْ بِغَيْرِ عِلْمٍ﴾."}],"hadiths":[]}]},{"id":381,"name":"أعلم بالمفسدين","compound":true,"meaning":"وربك أعلم بالمفسدين: منهم من يؤمن ومنهم من لا يؤمن.","teaches":"1. بعد التكذيب بما لم يحيطوا بعلمه.","whenRecall":"- حين يُكذَّب الحق.","whenPray":"1. اللهم اهدني.","summary":"التكذيب بلا علم إفساد.","verses":[{"i":1,"of":1,"s":10,"surah":"يونس","a":40,"text":"وَمِنْهُمْ مَنْ يُؤْمِنُ بِهِ وَمِنْهُمْ مَنْ لَا يُؤْمِنُ بِهِ وَرَبُّكَ أَعْلَمُ بِالْمُفْسِدِينَ","prev":{"a":39,"text":"بَلْ كَذَّبُوا بِمَا لَمْ يُحِيطُوا بِعِلْمِهِ وَلَمَّا يَأْتِهِمْ تَأْوِيلُهُ كَذَلِكَ كَذَّبَ الَّذِينَ مِنْ قَبْلِهِمْ فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الظَّالِمِينَ"},"next":{"a":41,"text":"وَإِنْ كَذَّبُوكَ فَقُلْ لِي عَمَلِي وَلَكُمْ عَمَلُكُمْ أَنْتُمْ بَرِيئُونَ مِمَّا أَعْمَلُ وَأَنَا بَرِيءٌ مِمَّا تَعْمَلُونَ"},"context":"قبلها: كذبوا بما لم يحيطوا بعلمه.","reason":"الانقسام في الإيمان."}],"hadiths":[],"situations":[{"situationId":130,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَمِنْهُمْ مَنْ يُؤْمِنُ بِهِ وَمِنْهُمْ مَنْ لَا يُؤْمِنُ بِهِ﴾."}],"hadiths":[]}]},{"id":382,"name":"أعلم بالشاكرين","compound":true,"meaning":"أعلم بالشاكرين: يعلم من يستحق المنة.","teaches":"1. المستكبرون يحتقرون الفقراء: أهؤلاء من الله عليهم؟","whenRecall":"- حين تحتقر فقيرًا.","whenPray":"1. اللهم اجعلني من الشاكرين.","summary":"الفضل لمن يشكر لا لمن يتكبر.","verses":[{"i":1,"of":1,"s":6,"surah":"الأنعام","a":53,"text":"وَكَذَلِكَ فَتَنَّا بَعْضَهُمْ بِبَعْضٍ لِيَقُولُوا أَهَؤُلَاءِ مَنَّ اللَّهُ عَلَيْهِمْ مِنْ بَيْنِنَا أَلَيْسَ اللَّهُ بِأَعْلَمَ بِالشَّاكِرِينَ","prev":{"a":52,"text":"وَلَا تَطْرُدِ الَّذِينَ يَدْعُونَ رَبَّهُمْ بِالْغَدَاةِ وَالْعَشِيِّ يُرِيدُونَ وَجْهَهُ مَا عَلَيْكَ مِنْ حِسَابِهِمْ مِنْ شَيْءٍ وَمَا مِنْ حِسَابِكَ عَلَيْهِمْ مِنْ شَيْءٍ فَتَطْرُدَهُمْ فَتَكُونَ مِنَ الظَّالِمِينَ"},"next":{"a":54,"text":"وَإِذَا جَاءَكَ الَّذِينَ يُؤْمِنُونَ بِآيَاتِنَا فَقُلْ سَلَامٌ عَلَيْكُمْ كَتَبَ رَبُّكُمْ عَلَى نَفْسِهِ الرَّحْمَةَ أَنَّهُ مَنْ عَمِلَ مِنْكُمْ سُوءًا بِجَهَالَةٍ ثُمَّ تَابَ مِنْ بَعْدِهِ وَأَصْلَحَ فَأَنَّهُ غَفُورٌ رَحِيمٌ"},"context":"قبلها: لا تطرد الذين يدعون ربهم.","reason":"فتنة بعضهم ببعض."}],"hadiths":[],"situations":[{"situationId":83,"verses":[{"i":1,"strength":"direct","bridge":"﴿أَهَؤُلَاءِ مَنَّ اللَّهُ عَلَيْهِمْ مِنْ بَيْنِنَا أَلَيْسَ اللَّهُ بِأَعْلَمَ بِالشَّاكِرِينَ﴾."}],"hadiths":[]}]},{"id":383,"name":"أعلم بمن هو أهدى سبيلًا","compound":true,"meaning":"أعلم بمن هو أهدى سبيلًا: كل يعمل على طريقته، والحكم لله.","teaches":"1. بعد ذكر إعراض الإنسان عند النعمة.","whenRecall":"- حين تقارن نفسك بغيرك.","whenPray":"1. اهدني سبيلًا.","summary":"كلٌّ على شاكلته، والله أعلم بالأهدى.","verses":[{"i":1,"of":1,"s":17,"surah":"الإسراء","a":84,"text":"قُلْ كُلٌّ يَعْمَلُ عَلَى شَاكِلَتِهِ فَرَبُّكُمْ أَعْلَمُ بِمَنْ هُوَ أَهْدَى سَبِيلًا","prev":{"a":83,"text":"وَإِذَا أَنْعَمْنَا عَلَى الْإِنْسَانِ أَعْرَضَ وَنَأَى بِجَانِبِهِ وَإِذَا مَسَّهُ الشَّرُّ كَانَ يَئُوسًا"},"next":{"a":85,"text":"وَيَسْأَلُونَكَ عَنِ الرُّوحِ قُلِ الرُّوحُ مِنْ أَمْرِ رَبِّي وَمَا أُوتِيتُمْ مِنَ الْعِلْمِ إِلَّا قَلِيلًا"},"context":"قبلها: إذا أنعمنا على الإنسان أعرض.","reason":"الشاكلة."}],"hadiths":[],"situations":[{"situationId":80,"verses":[{"i":1,"strength":"direct","bridge":"﴿قُلْ كُلٌّ يَعْمَلُ عَلَى شَاكِلَتِهِ﴾."}],"hadiths":[]}]},{"id":384,"name":"ولي المؤمنين","compound":true,"meaning":"ولي المؤمنين: يتولى أتباع إبراهيم الحق.","teaches":"1. أولى الناس بإبراهيم أتباعه.","whenRecall":"- حين تختلف الدعاوى.","whenPray":"1. اللهم تولّني.","summary":"الأحق بإبراهيم من اتبعه.","verses":[{"i":1,"of":1,"s":3,"surah":"آل عمران","a":68,"text":"إِنَّ أَوْلَى النَّاسِ بِإِبْرَاهِيمَ لَلَّذِينَ اتَّبَعُوهُ وَهَذَا النَّبِيُّ وَالَّذِينَ آمَنُوا وَاللَّهُ وَلِيُّ الْمُؤْمِنِينَ","prev":{"a":67,"text":"مَا كَانَ إِبْرَاهِيمُ يَهُودِيًّا وَلَا نَصْرَانِيًّا وَلَكِنْ كَانَ حَنِيفًا مُسْلِمًا وَمَا كَانَ مِنَ الْمُشْرِكِينَ"},"next":{"a":69,"text":"وَدَّتْ طَائِفَةٌ مِنْ أَهْلِ الْكِتَابِ لَوْ يُضِلُّونَكُمْ وَمَا يُضِلُّونَ إِلَّا أَنْفُسَهُمْ وَمَا يَشْعُرُونَ"},"context":"قبلها: ما كان إبراهيم يهوديًا ولا نصرانيًا.","reason":"الولاية بالاتباع."}],"hadiths":[{"i":1,"of":1,"text":"«إنَّ لكلِّ نَبيٍّ وُلاةً مِنَ النَّبيِّينَ، وإنَّ وَليِّي منهم أَبي وخليلي إبراهيمُ». ثُمَّ قَرَأَ: {إِنَّ أَوْلَى النَّاسِ بِإِبْرَاهِيمَ لَلَّذِينَ اتَّبَعُوهُ وَهَذَا النَّبِيُّ وَالَّذِينَ آمَنُوا وَاللَّهُ وَلِيُّ الْمُؤْمِنِين} [آل عمران: 68].","narrator":"عبدالله","source":"المستدرك على الصحيحين 3192","grade":"صحيح","judgment":"صحيح على شرط الشيخين","url":"https://dorar.net/h/bS3jdZ6f","nameForm":"ولي المؤمنين"}],"sunnah":{},"situations":[{"situationId":89,"verses":[{"i":1,"strength":"direct","bridge":"﴿إِنَّ أَوْلَى النَّاسِ بِإِبْرَاهِيمَ لَلَّذِينَ اتَّبَعُوهُ﴾."}],"hadiths":[]}]},{"id":385,"name":"ولي المتقين","compound":true,"meaning":"ولي المتقين: الظالمون أولياء بعض، والله ولي المتقين.","teaches":"1. بعد الأمر باتباع الشريعة.","whenRecall":"- حين تشعر بالضعف أمام كثرة أهل الباطل.","whenPray":"1. اللهم أنت ولي المتقين.","summary":"لا يغنون عنك من الله شيئًا.","verses":[{"i":1,"of":1,"s":45,"surah":"الجاثية","a":19,"text":"إِنَّهُمْ لَنْ يُغْنُوا عَنْكَ مِنَ اللَّهِ شَيْئًا وَإِنَّ الظَّالِمِينَ بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ وَاللَّهُ وَلِيُّ الْمُتَّقِينَ","prev":{"a":18,"text":"ثُمَّ جَعَلْنَاكَ عَلَى شَرِيعَةٍ مِنَ الْأَمْرِ فَاتَّبِعْهَا وَلَا تَتَّبِعْ أَهْوَاءَ الَّذِينَ لَا يَعْلَمُونَ"},"next":{"a":20,"text":"هَذَا بَصَائِرُ لِلنَّاسِ وَهُدًى وَرَحْمَةٌ لِقَوْمٍ يُوقِنُونَ"},"context":"قبلها: جعلناك على شريعة.","reason":"الولاية."}],"hadiths":[],"situations":[{"situationId":127,"verses":[{"i":1,"strength":"direct","bridge":"﴿إِنَّهُمْ لَنْ يُغْنُوا عَنْكَ مِنَ اللَّهِ شَيْئًا﴾."}],"hadiths":[]}]},{"id":386,"name":"بالمؤمنين رحيمًا","compound":true,"meaning":"بالمؤمنين رحيمًا: رحمة خاصة بالمؤمنين.","teaches":"1. يصلي عليهم وملائكته.","whenRecall":"- حين تذكر الله.","whenPray":"1. اللهم صلِّ علينا.","summary":"الذكر طريق صلاة الله عليك.","verses":[{"i":1,"of":1,"s":33,"surah":"الأحزاب","a":43,"text":"هُوَ الَّذِي يُصَلِّي عَلَيْكُمْ وَمَلَائِكَتُهُ لِيُخْرِجَكُمْ مِنَ الظُّلُمَاتِ إِلَى النُّورِ وَكَانَ بِالْمُؤْمِنِينَ رَحِيمًا","prev":{"a":42,"text":"وَسَبِّحُوهُ بُكْرَةً وَأَصِيلًا"},"next":{"a":44,"text":"تَحِيَّتُهُمْ يَوْمَ يَلْقَوْنَهُ سَلَامٌ وَأَعَدَّ لَهُمْ أَجْرًا كَرِيمًا"},"context":"قبلها: سبحوه بكرة وأصيلًا.","reason":"الإخراج من الظلمات."}],"hadiths":[],"situations":[{"situationId":79,"verses":[{"i":1,"strength":"direct","bridge":"﴿هُوَ الَّذِي يُصَلِّي عَلَيْكُمْ وَمَلَائِكَتُهُ﴾."}],"hadiths":[]}]},{"id":387,"name":"للأوابين غفورًا","compound":true,"meaning":"للأوابين غفورًا: يغفر لمن يكثر الرجوع.","teaches":"1. بعد آيات بر الوالدين.","whenRecall":"- حين تقصّر في بر والديك.","whenPray":"1. اغفر لي تقصيري.","summary":"إن كنت صالح النية فالرجوع يمحو.","verses":[{"i":1,"of":1,"s":17,"surah":"الإسراء","a":25,"text":"رَبُّكُمْ أَعْلَمُ بِمَا فِي نُفُوسِكُمْ إِنْ تَكُونُوا صَالِحِينَ فَإِنَّهُ كَانَ لِلْأَوَّابِينَ غَفُورًا","prev":{"a":24,"text":"وَاخْفِضْ لَهُمَا جَنَاحَ الذُّلِّ مِنَ الرَّحْمَةِ وَقُلْ رَبِّ ارْحَمْهُمَا كَمَا رَبَّيَانِي صَغِيرًا"},"next":{"a":26,"text":"وَآتِ ذَا الْقُرْبَى حَقَّهُ وَالْمِسْكِينَ وَابْنَ السَّبِيلِ وَلَا تُبَذِّرْ تَبْذِيرًا"},"context":"قبلها: اخفض لهما جناح الذل.","reason":"التقصير في البر."}],"hadiths":[],"situations":[{"situationId":53,"verses":[{"i":1,"strength":"direct","bridge":"﴿إِنْ تَكُونُوا صَالِحِينَ فَإِنَّهُ كَانَ لِلْأَوَّابِينَ غَفُورًا﴾."}],"hadiths":[]}]},{"id":388,"name":"ذو فضل على المؤمنين","compound":true,"meaning":"ذو فضل على المؤمنين: عفا عنهم بعد أحد.","teaches":"1. صدقهم وعده ثم فشلوا وتنازعوا.","whenRecall":"- بعد الإخفاق.","whenPray":"1. اللهم اعف عنا.","summary":"حتى بعد الفشل، العفو فضل.","verses":[{"i":1,"of":1,"s":3,"surah":"آل عمران","a":152,"text":"وَلَقَدْ صَدَقَكُمُ اللَّهُ وَعْدَهُ إِذْ تَحُسُّونَهُمْ بِإِذْنِهِ حَتَّى إِذَا فَشِلْتُمْ وَتَنَازَعْتُمْ فِي الْأَمْرِ وَعَصَيْتُمْ مِنْ بَعْدِ مَا أَرَاكُمْ مَا تُحِبُّونَ مِنْكُمْ مَنْ يُرِيدُ الدُّنْيَا وَمِنْكُمْ مَنْ يُرِيدُ الْآخِرَةَ ثُمَّ صَرَفَكُمْ عَنْهُمْ لِيَبْتَلِيَكُمْ وَلَقَدْ عَفَا عَنْكُمْ وَاللَّهُ ذُو فَضْلٍ عَلَى الْمُؤْمِنِينَ","prev":{"a":151,"text":"سَنُلْقِي فِي قُلُوبِ الَّذِينَ كَفَرُوا الرُّعْبَ بِمَا أَشْرَكُوا بِاللَّهِ مَا لَمْ يُنَزِّلْ بِهِ سُلْطَانًا وَمَأْوَاهُمُ النَّارُ وَبِئْسَ مَثْوَى الظَّالِمِينَ"},"next":{"a":153,"text":"إِذْ تُصْعِدُونَ وَلَا تَلْوُونَ عَلَى أَحَدٍ وَالرَّسُولُ يَدْعُوكُمْ فِي أُخْرَاكُمْ فَأَثَابَكُمْ غَمًّا بِغَمٍّ لِكَيْلَا تَحْزَنُوا عَلَى مَا فَاتَكُمْ وَلَا مَا أَصَابَكُمْ وَاللَّهُ خَبِيرٌ بِمَا تَعْمَلُونَ"},"context":"قبلها: سنلقي في قلوب الذين كفروا الرعب.","reason":"الفشل والتنازع."}],"hadiths":[],"situations":[{"situationId":7,"verses":[{"i":1,"strength":"direct","bridge":"﴿حَتَّى إِذَا فَشِلْتُمْ وَتَنَازَعْتُمْ فِي الْأَمْرِ وَعَصَيْتُمْ﴾."}],"hadiths":[]}]},{"id":389,"name":"بالناس لرءوف رحيم","compound":true,"meaning":"بالناس لرءوف رحيم: لا يضيع إيمانكم.","teaches":"1. تحويل القبلة.\n2. تسخير ما في الأرض.","whenRecall":"- حين تخاف ضياع عملك.","whenPray":"1. يا رءوف يا رحيم.","summary":"عمل الماضي محفوظ.","verses":[{"i":1,"of":2,"s":2,"surah":"البقرة","a":143,"text":"وَكَذَلِكَ جَعَلْنَاكُمْ أُمَّةً وَسَطًا لِتَكُونُوا شُهَدَاءَ عَلَى النَّاسِ وَيَكُونَ الرَّسُولُ عَلَيْكُمْ شَهِيدًا وَمَا جَعَلْنَا الْقِبْلَةَ الَّتِي كُنْتَ عَلَيْهَا إِلَّا لِنَعْلَمَ مَنْ يَتَّبِعُ الرَّسُولَ مِمَّنْ يَنْقَلِبُ عَلَى عَقِبَيْهِ وَإِنْ كَانَتْ لَكَبِيرَةً إِلَّا عَلَى الَّذِينَ هَدَى اللَّهُ وَمَا كَانَ اللَّهُ لِيُضِيعَ إِيمَانَكُمْ إِنَّ اللَّهَ بِالنَّاسِ لَرَءُوفٌ رَحِيمٌ","prev":{"a":142,"text":"سَيَقُولُ السُّفَهَاءُ مِنَ النَّاسِ مَا وَلَّاهُمْ عَنْ قِبْلَتِهِمُ الَّتِي كَانُوا عَلَيْهَا قُلْ لِلَّهِ الْمَشْرِقُ وَالْمَغْرِبُ يَهْدِي مَنْ يَشَاءُ إِلَى صِرَاطٍ مُسْتَقِيمٍ"},"next":{"a":144,"text":"قَدْ نَرَى تَقَلُّبَ وَجْهِكَ فِي السَّمَاءِ فَلَنُوَلِّيَنَّكَ قِبْلَةً تَرْضَاهَا فَوَلِّ وَجْهَكَ شَطْرَ الْمَسْجِدِ الْحَرَامِ وَحَيْثُ مَا كُنْتُمْ فَوَلُّوا وُجُوهَكُمْ شَطْرَهُ وَإِنَّ الَّذِينَ أُوتُوا الْكِتَابَ لَيَعْلَمُونَ أَنَّهُ الْحَقُّ مِنْ رَبِّهِمْ وَمَا اللَّهُ بِغَافِلٍ عَمَّا يَعْمَلُونَ"},"context":"قبلها: سيقول السفهاء.","reason":"الأمة الوسط."},{"i":2,"of":2,"s":22,"surah":"الحج","a":65,"text":"أَلَمْ تَرَ أَنَّ اللَّهَ سَخَّرَ لَكُمْ مَا فِي الْأَرْضِ وَالْفُلْكَ تَجْرِي فِي الْبَحْرِ بِأَمْرِهِ وَيُمْسِكُ السَّمَاءَ أَنْ تَقَعَ عَلَى الْأَرْضِ إِلَّا بِإِذْنِهِ إِنَّ اللَّهَ بِالنَّاسِ لَرَءُوفٌ رَحِيمٌ","prev":{"a":64,"text":"لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَإِنَّ اللَّهَ لَهُوَ الْغَنِيُّ الْحَمِيدُ"},"next":{"a":66,"text":"وَهُوَ الَّذِي أَحْيَاكُمْ ثُمَّ يُمِيتُكُمْ ثُمَّ يُحْيِيكُمْ إِنَّ الْإِنْسَانَ لَكَفُورٌ"},"context":"قبلها: له ما في السماوات.","reason":"التسخير."}],"hadiths":[],"situations":[{"situationId":143,"verses":[{"i":2,"strength":"direct","bridge":"﴿أَلَمْ تَرَ أَنَّ اللَّهَ سَخَّرَ لَكُمْ مَا فِي الْأَرْضِ﴾."}],"hadiths":[]},{"situationId":171,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَكَذَلِكَ جَعَلْنَاكُمْ أُمَّةً وَسَطًا﴾."}],"hadiths":[]}]},{"id":390,"name":"محيط بالكافرين","compound":true,"meaning":"محيط بالكافرين: لا يفوتونه.","teaches":"1. مثل المنافقين في الصيب.","whenRecall":"- حين تهرب من الحق.","whenPray":"1. اللهم اهدني.","summary":"سد الأذن لا ينجي.","verses":[{"i":1,"of":1,"s":2,"surah":"البقرة","a":19,"text":"أَوْ كَصَيِّبٍ مِنَ السَّمَاءِ فِيهِ ظُلُمَاتٌ وَرَعْدٌ وَبَرْقٌ يَجْعَلُونَ أَصَابِعَهُمْ فِي آذَانِهِمْ مِنَ الصَّوَاعِقِ حَذَرَ الْمَوْتِ وَاللَّهُ مُحِيطٌ بِالْكَافِرِينَ","prev":{"a":18,"text":"صُمٌّ بُكْمٌ عُمْيٌ فَهُمْ لَا يَرْجِعُونَ"},"next":{"a":20,"text":"يَكَادُ الْبَرْقُ يَخْطَفُ أَبْصَارَهُمْ كُلَّمَا أَضَاءَ لَهُمْ مَشَوْا فِيهِ وَإِذَا أَظْلَمَ عَلَيْهِمْ قَامُوا وَلَوْ شَاءَ اللَّهُ لَذَهَبَ بِسَمْعِهِمْ وَأَبْصَارِهِمْ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},"context":"قبلها: صم بكم عمي.","reason":"مثل الصيب."}],"hadiths":[],"situations":[{"situationId":120,"verses":[{"i":1,"strength":"direct","bridge":"﴿يَجْعَلُونَ أَصَابِعَهُمْ فِي آذَانِهِمْ مِنَ الصَّوَاعِقِ حَذَرَ الْمَوْتِ﴾."}],"hadiths":[]}]},{"id":391,"name":"مخزي الكافرين","compound":true,"meaning":"مخزي الكافرين: يذلهم ولا يعجزونه.","teaches":"1. براءة من المشركين وإمهالهم أربعة أشهر.","whenRecall":"- حين ترى ظالمًا مطمئنًّا.","whenPray":"1. اللهم لا تخزنا.","summary":"لن تعجزوا الله.","verses":[{"i":1,"of":1,"s":9,"surah":"التوبة","a":2,"text":"فَسِيحُوا فِي الْأَرْضِ أَرْبَعَةَ أَشْهُرٍ وَاعْلَمُوا أَنَّكُمْ غَيْرُ مُعْجِزِي اللَّهِ وَأَنَّ اللَّهَ مُخْزِي الْكَافِرِينَ","prev":{"a":1,"text":"بَرَاءَةٌ مِنَ اللَّهِ وَرَسُولِهِ إِلَى الَّذِينَ عَاهَدْتُمْ مِنَ الْمُشْرِكِينَ"},"next":{"a":3,"text":"وَأَذَانٌ مِنَ اللَّهِ وَرَسُولِهِ إِلَى النَّاسِ يَوْمَ الْحَجِّ الْأَكْبَرِ أَنَّ اللَّهَ بَرِيءٌ مِنَ الْمُشْرِكِينَ وَرَسُولُهُ فَإِنْ تُبْتُمْ فَهُوَ خَيْرٌ لَكُمْ وَإِنْ تَوَلَّيْتُمْ فَاعْلَمُوا أَنَّكُمْ غَيْرُ مُعْجِزِي اللَّهِ وَبَشِّرِ الَّذِينَ كَفَرُوا بِعَذَابٍ أَلِيمٍ"},"context":"قبلها: براءة من الله ورسوله.","reason":"الإمهال."}],"hadiths":[],"situations":[{"situationId":36,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَاعْلَمُوا أَنَّكُمْ غَيْرُ مُعْجِزِي اللَّهِ﴾."}],"hadiths":[]}]},{"id":392,"name":"عدو للكافرين","compound":true,"meaning":"عدو للكافرين: من عادى ملائكته ورسله.","teaches":"1. ردٌّ على اليهود في عداوة جبريل.","whenRecall":"- حين تسمع الطعن في الرسل.","whenPray":"1. اللهم اجعلني من أوليائك.","summary":"من عادى أولياء الله فالله عدوه.","verses":[{"i":1,"of":1,"s":2,"surah":"البقرة","a":98,"text":"مَنْ كَانَ عَدُوًّا لِلَّهِ وَمَلَائِكَتِهِ وَرُسُلِهِ وَجِبْرِيلَ وَمِيكَالَ فَإِنَّ اللَّهَ عَدُوٌّ لِلْكَافِرِينَ","prev":{"a":97,"text":"قُلْ مَنْ كَانَ عَدُوًّا لِجِبْرِيلَ فَإِنَّهُ نَزَّلَهُ عَلَى قَلْبِكَ بِإِذْنِ اللَّهِ مُصَدِّقًا لِمَا بَيْنَ يَدَيْهِ وَهُدًى وَبُشْرَى لِلْمُؤْمِنِينَ"},"next":{"a":99,"text":"وَلَقَدْ أَنْزَلْنَا إِلَيْكَ آيَاتٍ بَيِّنَاتٍ وَمَا يَكْفُرُ بِهَا إِلَّا الْفَاسِقُونَ"},"context":"قبلها: من كان عدوًا لجبريل.","reason":"عداوة الملائكة."}],"hadiths":[],"situations":[{"situationId":107,"verses":[{"i":1,"strength":"direct","bridge":"﴿مَنْ كَانَ عَدُوًّا لِلَّهِ وَمَلَائِكَتِهِ وَرُسُلِهِ﴾."}],"hadiths":[]}]},{"id":393,"name":"بريء من المشركين","compound":true,"meaning":"بريء من المشركين: إعلان البراءة، مع باب التوبة.","teaches":"1. يوم الحج الأكبر.","whenRecall":"- عند التبرؤ من الشرك.","whenPray":"1. اللهم إني بريء مما يشركون.","summary":"البراءة مع التوبة المفتوحة.","verses":[{"i":1,"of":1,"s":9,"surah":"التوبة","a":3,"text":"وَأَذَانٌ مِنَ اللَّهِ وَرَسُولِهِ إِلَى النَّاسِ يَوْمَ الْحَجِّ الْأَكْبَرِ أَنَّ اللَّهَ بَرِيءٌ مِنَ الْمُشْرِكِينَ وَرَسُولُهُ فَإِنْ تُبْتُمْ فَهُوَ خَيْرٌ لَكُمْ وَإِنْ تَوَلَّيْتُمْ فَاعْلَمُوا أَنَّكُمْ غَيْرُ مُعْجِزِي اللَّهِ وَبَشِّرِ الَّذِينَ كَفَرُوا بِعَذَابٍ أَلِيمٍ","prev":{"a":2,"text":"فَسِيحُوا فِي الْأَرْضِ أَرْبَعَةَ أَشْهُرٍ وَاعْلَمُوا أَنَّكُمْ غَيْرُ مُعْجِزِي اللَّهِ وَأَنَّ اللَّهَ مُخْزِي الْكَافِرِينَ"},"next":{"a":4,"text":"إِلَّا الَّذِينَ عَاهَدْتُمْ مِنَ الْمُشْرِكِينَ ثُمَّ لَمْ يَنْقُصُوكُمْ شَيْئًا وَلَمْ يُظَاهِرُوا عَلَيْكُمْ أَحَدًا فَأَتِمُّوا إِلَيْهِمْ عَهْدَهُمْ إِلَى مُدَّتِهِمْ إِنَّ اللَّهَ يُحِبُّ الْمُتَّقِينَ"},"context":"قبلها: فسيحوا في الأرض.","reason":"الأذان."}],"hadiths":[{"i":1,"of":1,"text":"كنْتُ مع علِيِّ بنِ أبي طالبٍ رَضيَ اللهُ عنه حينَ بعَثَهُ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ إلى أهْلِ مَكَّةَ ببَراءةَ، فقيلَ: ما كُنتُم تُنادُونَ؟ فقال: كنَّا نُنادِي: أنَّه لا يَدْخُلُ الجنَّةَ إلَّا نفْسٌ مُؤمِنةٌ، ولا يَطوفُ بالبيتِ عُرْيانٌ، ومَن كانَ بيْنَه وبيْنَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ عهْدٌ، فأجَلُهُ ومُدَّةُ عهدِهِ إلى أربعةِ أشهُرٍ، فإذا مَضَتِ الأربعةُ الأشهُرِ فإنَّ اللهَ بَريءٌ مِن المُشرِكينَ ورَسولُه، ولا يَحُجُّ بعْدَ العامِ مُشْرِكٌ. فكُنتُ أنادي حتَّى صَحِلَ صَوْتي.","narrator":"أبو هريرة","source":"المستدرك على الصحيحين 7559","grade":"صحيح","judgment":"صحيح الإسناد","url":"https://dorar.net/h/7YjSp5AN","nameForm":"بريء من المشركين"}],"sunnah":{},"situations":[{"situationId":128,"verses":[{"i":1,"strength":"direct","bridge":"﴿فَإِنْ تُبْتُمْ فَهُوَ خَيْرٌ لَكُمْ﴾."}],"hadiths":[]}]},{"id":394,"name":"جامع المنافقين والكافرين في جهنم جميعًا","compound":true,"meaning":"جامع المنافقين والكافرين: يجمعهم كما اجتمعوا في الدنيا.","teaches":"1. النهي عن القعود مع المستهزئين.","whenRecall":"- في مجلس يُستهزأ فيه بالدين.","whenPray":"1. اللهم لا تجعلني مع القوم الظالمين.","summary":"من جالسهم صار مثلهم.","verses":[{"i":1,"of":1,"s":4,"surah":"النساء","a":140,"text":"وَقَدْ نَزَّلَ عَلَيْكُمْ فِي الْكِتَابِ أَنْ إِذَا سَمِعْتُمْ آيَاتِ اللَّهِ يُكْفَرُ بِهَا وَيُسْتَهْزَأُ بِهَا فَلَا تَقْعُدُوا مَعَهُمْ حَتَّى يَخُوضُوا فِي حَدِيثٍ غَيْرِهِ إِنَّكُمْ إِذًا مِثْلُهُمْ إِنَّ اللَّهَ جَامِعُ الْمُنَافِقِينَ وَالْكَافِرِينَ فِي جَهَنَّمَ جَمِيعًا","prev":{"a":139,"text":"الَّذِينَ يَتَّخِذُونَ الْكَافِرِينَ أَوْلِيَاءَ مِنْ دُونِ الْمُؤْمِنِينَ أَيَبْتَغُونَ عِنْدَهُمُ الْعِزَّةَ فَإِنَّ الْعِزَّةَ لِلَّهِ جَمِيعًا"},"next":{"a":141,"text":"الَّذِينَ يَتَرَبَّصُونَ بِكُمْ فَإِنْ كَانَ لَكُمْ فَتْحٌ مِنَ اللَّهِ قَالُوا أَلَمْ نَكُنْ مَعَكُمْ وَإِنْ كَانَ لِلْكَافِرِينَ نَصِيبٌ قَالُوا أَلَمْ نَسْتَحْوِذْ عَلَيْكُمْ وَنَمْنَعْكُمْ مِنَ الْمُؤْمِنِينَ فَاللَّهُ يَحْكُمُ بَيْنَكُمْ يَوْمَ الْقِيَامَةِ وَلَنْ يَجْعَلَ اللَّهُ لِلْكَافِرِينَ عَلَى الْمُؤْمِنِينَ سَبِيلًا"},"context":"قبلها: يتخذون الكافرين أولياء.","reason":"القعود مع المستهزئين."}],"hadiths":[],"situations":[{"situationId":67,"verses":[{"i":1,"strength":"direct","bridge":"﴿فَلَا تَقْعُدُوا مَعَهُمْ حَتَّى يَخُوضُوا فِي حَدِيثٍ غَيْرِهِ﴾."}],"hadiths":[]}]},{"id":395,"name":"موهن كيد الكافرين","compound":true,"meaning":"موهن كيد الكافرين: يضعف كيدهم.","teaches":"1. بعد بدر: فلم تقتلوهم ولكن الله قتلهم.","whenRecall":"- حين يُكاد لك.","whenPray":"1. اللهم أوهن كيدهم.","summary":"الكيد موهون.","verses":[{"i":1,"of":1,"s":8,"surah":"الأنفال","a":18,"text":"ذَلِكُمْ وَأَنَّ اللَّهَ مُوهِنُ كَيْدِ الْكَافِرِينَ","prev":{"a":17,"text":"فَلَمْ تَقْتُلُوهُمْ وَلَكِنَّ اللَّهَ قَتَلَهُمْ وَمَا رَمَيْتَ إِذْ رَمَيْتَ وَلَكِنَّ اللَّهَ رَمَى وَلِيُبْلِيَ الْمُؤْمِنِينَ مِنْهُ بَلَاءً حَسَنًا إِنَّ اللَّهَ سَمِيعٌ عَلِيمٌ"},"next":{"a":19,"text":"إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ وَإِنْ تَنْتَهُوا فَهُوَ خَيْرٌ لَكُمْ وَإِنْ تَعُودُوا نَعُدْ وَلَنْ تُغْنِيَ عَنْكُمْ فِئَتُكُمْ شَيْئًا وَلَوْ كَثُرَتْ وَأَنَّ اللَّهَ مَعَ الْمُؤْمِنِينَ"},"context":"قبلها: فلم تقتلوهم.","reason":"توهين الكيد."}],"hadiths":[],"situations":[{"situationId":30,"verses":[{"i":1,"strength":"direct","bridge":"﴿ذَلِكُمْ وَأَنَّ اللَّهَ مُوهِنُ كَيْدِ الْكَافِرِينَ﴾."}],"hadiths":[]}]},{"id":396,"name":"غني عن العالمين","compound":true,"meaning":"غني عن العالمين: لا يحتاج إلى أحد.","teaches":"1. بعد فرض الحج.\n2. من جاهد فلنفسه.","whenRecall":"- حين تظن أن الله يحتاج طاعتك.","whenPray":"1. يا غني أغنني.","summary":"طاعتك لنفسك.","verses":[{"i":1,"of":2,"s":3,"surah":"آل عمران","a":97,"text":"فِيهِ آيَاتٌ بَيِّنَاتٌ مَقَامُ إِبْرَاهِيمَ وَمَنْ دَخَلَهُ كَانَ آمِنًا وَلِلَّهِ عَلَى النَّاسِ حِجُّ الْبَيْتِ مَنِ اسْتَطَاعَ إِلَيْهِ سَبِيلًا وَمَنْ كَفَرَ فَإِنَّ اللَّهَ غَنِيٌّ عَنِ الْعَالَمِينَ","prev":{"a":96,"text":"إِنَّ أَوَّلَ بَيْتٍ وُضِعَ لِلنَّاسِ لَلَّذِي بِبَكَّةَ مُبَارَكًا وَهُدًى لِلْعَالَمِينَ"},"next":{"a":98,"text":"قُلْ يَا أَهْلَ الْكِتَابِ لِمَ تَكْفُرُونَ بِآيَاتِ اللَّهِ وَاللَّهُ شَهِيدٌ عَلَى مَا تَعْمَلُونَ"},"context":"قبلها: أول بيت وضع للناس.","reason":"فرض الحج."},{"i":2,"of":2,"s":29,"surah":"العنكبوت","a":6,"text":"وَمَنْ جَاهَدَ فَإِنَّمَا يُجَاهِدُ لِنَفْسِهِ إِنَّ اللَّهَ لَغَنِيٌّ عَنِ الْعَالَمِينَ","prev":{"a":5,"text":"مَنْ كَانَ يَرْجُو لِقَاءَ اللَّهِ فَإِنَّ أَجَلَ اللَّهِ لَآتٍ وَهُوَ السَّمِيعُ الْعَلِيمُ"},"next":{"a":7,"text":"وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَنُكَفِّرَنَّ عَنْهُمْ سَيِّئَاتِهِمْ وَلَنَجْزِيَنَّهُمْ أَحْسَنَ الَّذِي كَانُوا يَعْمَلُونَ"},"context":"قبلها: من كان يرجو لقاء الله.","reason":"الجهاد للنفس."}],"hadiths":[],"situations":[{"situationId":77,"verses":[{"i":2,"strength":"direct","bridge":"﴿وَمَنْ جَاهَدَ فَإِنَّمَا يُجَاهِدُ لِنَفْسِهِ﴾."}],"hadiths":[]},{"situationId":166,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَلِلَّهِ عَلَى النَّاسِ حِجُّ الْبَيْتِ مَنِ اسْتَطَاعَ إِلَيْهِ سَبِيلًا﴾."}],"hadiths":[]}]},{"id":397,"name":"ما الله مبديه","compound":true,"meaning":"ما الله مبديه: ما أخفيته سيظهره الله.","teaches":"1. في قصة زيد وزينب.","whenRecall":"- حين تخفي شيئًا خوف الناس.","whenPray":"1. اللهم اجعل سري خيرًا.","summary":"ما سيبديه الله لا تخفه خوف الناس.","verses":[{"i":1,"of":1,"s":33,"surah":"الأحزاب","a":37,"text":"وَإِذْ تَقُولُ لِلَّذِي أَنْعَمَ اللَّهُ عَلَيْهِ وَأَنْعَمْتَ عَلَيْهِ أَمْسِكْ عَلَيْكَ زَوْجَكَ وَاتَّقِ اللَّهَ وَتُخْفِي فِي نَفْسِكَ مَا اللَّهُ مُبْدِيهِ وَتَخْشَى النَّاسَ وَاللَّهُ أَحَقُّ أَنْ تَخْشَاهُ فَلَمَّا قَضَى زَيْدٌ مِنْهَا وَطَرًا زَوَّجْنَاكَهَا لِكَيْ لَا يَكُونَ عَلَى الْمُؤْمِنِينَ حَرَجٌ فِي أَزْوَاجِ أَدْعِيَائِهِمْ إِذَا قَضَوْا مِنْهُنَّ وَطَرًا وَكَانَ أَمْرُ اللَّهِ مَفْعُولًا","prev":{"a":36,"text":"وَمَا كَانَ لِمُؤْمِنٍ وَلَا مُؤْمِنَةٍ إِذَا قَضَى اللَّهُ وَرَسُولُهُ أَمْرًا أَنْ يَكُونَ لَهُمُ الْخِيَرَةُ مِنْ أَمْرِهِمْ وَمَنْ يَعْصِ اللَّهَ وَرَسُولَهُ فَقَدْ ضَلَّ ضَلَالًا مُبِينًا"},"next":{"a":38,"text":"مَا كَانَ عَلَى النَّبِيِّ مِنْ حَرَجٍ فِيمَا فَرَضَ اللَّهُ لَهُ سُنَّةَ اللَّهِ فِي الَّذِينَ خَلَوْا مِنْ قَبْلُ وَكَانَ أَمْرُ اللَّهِ قَدَرًا مَقْدُورًا"},"context":"قبلها: ما كان لمؤمن ولا مؤمنة.","reason":"الإخفاء."}],"hadiths":[{"i":1,"of":1,"text":"جاءَ زَيدُ بنُ حارِثةَ يَشكو، فجَعَلَ النَّبيُّ صلَّى اللهُ عليه وسلَّم يقولُ: اتَّقِ اللهَ، وأمسِكْ عليك زَوجَكَ، قال أنَسٌ: لو كان رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم كاتِمًا شيئًا لَكَتَمَ هذه، قال: فكانَت زَينَبُ تَفخَرُ على أزواجِ النَّبيِّ صلَّى اللهُ عليه وسلَّم تَقولُ: زَوَّجَكُنَّ أهاليكُنَّ، وزَوَّجَني اللهُ تَعالى مِن فوقِ سَبعِ سَمَواتٍ، وعَن ثابِتٍ: {وتُخفي في نَفسِكَ ما اللهُ مُبْدِيه وتَخشى النَّاسَ} [الأحزاب: 37]، نَزَلَت في شَأنِ زَينَبَ وزَيدِ بنِ حارِثةَ.","narrator":"أنس بن مالك","source":"صحيح البخاري 7420","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/OTMkz3YO","nameForm":"ما الله مبديه"}],"sunnah":{},"situations":[{"situationId":88,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَتُخْفِي فِي نَفْسِكَ مَا اللَّهُ مُبْدِيهِ وَتَخْشَى النَّاسَ﴾."}],"hadiths":[]}]},{"id":398,"name":"أعلم بما في أنفسهم","compound":true,"meaning":"الله أعلم بما في أنفسهم: قالها نوح عن المستضعفين.","teaches":"1. لا أقول للذين تزدري أعينكم لن يؤتيهم الله خيرًا.","whenRecall":"- حين يُحتقر الضعفاء.","whenPray":"1. اللهم لا تجعلني أزدري أحدًا.","summary":"لا تحكم على قلوب الضعفاء.","verses":[{"i":1,"of":1,"s":11,"surah":"هود","a":31,"text":"وَلَا أَقُولُ لَكُمْ عِنْدِي خَزَائِنُ اللَّهِ وَلَا أَعْلَمُ الْغَيْبَ وَلَا أَقُولُ إِنِّي مَلَكٌ وَلَا أَقُولُ لِلَّذِينَ تَزْدَرِي أَعْيُنُكُمْ لَنْ يُؤْتِيَهُمُ اللَّهُ خَيْرًا اللَّهُ أَعْلَمُ بِمَا فِي أَنْفُسِهِمْ إِنِّي إِذًا لَمِنَ الظَّالِمِينَ","prev":{"a":30,"text":"وَيَا قَوْمِ مَنْ يَنْصُرُنِي مِنَ اللَّهِ إِنْ طَرَدْتُهُمْ أَفَلَا تَذَكَّرُونَ"},"next":{"a":32,"text":"قَالُوا يَا نُوحُ قَدْ جَادَلْتَنَا فَأَكْثَرْتَ جِدَالَنَا فَأْتِنَا بِمَا تَعِدُنَا إِنْ كُنْتَ مِنَ الصَّادِقِينَ"},"context":"قبلها: من ينصرني من الله إن طردتهم.","reason":"رفض طرد المستضعفين."}],"hadiths":[],"situations":[{"situationId":83,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَلَا أَقُولُ لِلَّذِينَ تَزْدَرِي أَعْيُنُكُمْ لَنْ يُؤْتِيَهُمُ اللَّهُ خَيْرًا﴾."}],"hadiths":[]}]},{"id":399,"name":"أعلم بما في نفوسكم","compound":true,"meaning":"ربكم أعلم بما في نفوسكم: في سياق بر الوالدين.","teaches":"1. يعلم نيتك في البر.","whenRecall":"- حين يضيق صدرك بوالديك.","whenPray":"1. رب ارحمهما كما ربياني صغيرًا.","summary":"نيتك في البر معلومة.","verses":[{"i":1,"of":1,"s":17,"surah":"الإسراء","a":25,"text":"رَبُّكُمْ أَعْلَمُ بِمَا فِي نُفُوسِكُمْ إِنْ تَكُونُوا صَالِحِينَ فَإِنَّهُ كَانَ لِلْأَوَّابِينَ غَفُورًا","prev":{"a":24,"text":"وَاخْفِضْ لَهُمَا جَنَاحَ الذُّلِّ مِنَ الرَّحْمَةِ وَقُلْ رَبِّ ارْحَمْهُمَا كَمَا رَبَّيَانِي صَغِيرًا"},"next":{"a":26,"text":"وَآتِ ذَا الْقُرْبَى حَقَّهُ وَالْمِسْكِينَ وَابْنَ السَّبِيلِ وَلَا تُبَذِّرْ تَبْذِيرًا"},"context":"قبلها: رب ارحمهما.","reason":"النية في البر."}],"hadiths":[],"situations":[{"situationId":53,"verses":[{"i":1,"strength":"direct","bridge":"﴿رَبُّكُمْ أَعْلَمُ بِمَا فِي نُفُوسِكُمْ إِنْ تَكُونُوا صَالِحِينَ﴾."}],"hadiths":[]}]},{"id":400,"name":"أعلم بما في صدور العالمين","compound":true,"meaning":"أعلم بما في صدور العالمين: يعلم من يقول آمنا فإذا أوذي ارتد.","teaches":"1. جعل فتنة الناس كعذاب الله.","whenRecall":"- حين تؤذى في دينك.","whenPray":"1. اللهم ثبتني.","summary":"إيمان الأذى يُختبر.","verses":[{"i":1,"of":1,"s":29,"surah":"العنكبوت","a":10,"text":"وَمِنَ النَّاسِ مَنْ يَقُولُ آمَنَّا بِاللَّهِ فَإِذَا أُوذِيَ فِي اللَّهِ جَعَلَ فِتْنَةَ النَّاسِ كَعَذَابِ اللَّهِ وَلَئِنْ جَاءَ نَصْرٌ مِنْ رَبِّكَ لَيَقُولُنَّ إِنَّا كُنَّا مَعَكُمْ أَوَلَيْسَ اللَّهُ بِأَعْلَمَ بِمَا فِي صُدُورِ الْعَالَمِينَ","prev":{"a":9,"text":"وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَنُدْخِلَنَّهُمْ فِي الصَّالِحِينَ"},"next":{"a":11,"text":"وَلَيَعْلَمَنَّ اللَّهُ الَّذِينَ آمَنُوا وَلَيَعْلَمَنَّ الْمُنَافِقِينَ"},"context":"قبلها: الذين آمنوا وعملوا الصالحات.","reason":"فتنة الناس."}],"hadiths":[],"situations":[{"situationId":118,"verses":[{"i":1,"strength":"direct","bridge":"﴿فَإِذَا أُوذِيَ فِي اللَّهِ جَعَلَ فِتْنَةَ النَّاسِ كَعَذَابِ اللَّهِ﴾."}],"hadiths":[]}]},{"id":401,"name":"أعلم بإيمانكم","compound":true,"meaning":"أعلم بإيمانكم: التفاضل بالإيمان لا بالحرية والنسب.","teaches":"1. في نكاح الفتيات المؤمنات.","whenRecall":"- حين تختار شريكًا.","whenPray":"1. اللهم ارزقني زوجًا صالحًا.","summary":"الإيمان معيار الاختيار.","verses":[{"i":1,"of":1,"s":4,"surah":"النساء","a":25,"text":"وَمَنْ لَمْ يَسْتَطِعْ مِنْكُمْ طَوْلًا أَنْ يَنْكِحَ الْمُحْصَنَاتِ الْمُؤْمِنَاتِ فَمِنْ مَا مَلَكَتْ أَيْمَانُكُمْ مِنْ فَتَيَاتِكُمُ الْمُؤْمِنَاتِ وَاللَّهُ أَعْلَمُ بِإِيمَانِكُمْ بَعْضُكُمْ مِنْ بَعْضٍ فَانْكِحُوهُنَّ بِإِذْنِ أَهْلِهِنَّ وَآتُوهُنَّ أُجُورَهُنَّ بِالْمَعْرُوفِ مُحْصَنَاتٍ غَيْرَ مُسَافِحَاتٍ وَلَا مُتَّخِذَاتِ أَخْدَانٍ فَإِذَا أُحْصِنَّ فَإِنْ أَتَيْنَ بِفَاحِشَةٍ فَعَلَيْهِنَّ نِصْفُ مَا عَلَى الْمُحْصَنَاتِ مِنَ الْعَذَابِ ذَلِكَ لِمَنْ خَشِيَ الْعَنَتَ مِنْكُمْ وَأَنْ تَصْبِرُوا خَيْرٌ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ","prev":{"a":24,"text":"وَالْمُحْصَنَاتُ مِنَ النِّسَاءِ إِلَّا مَا مَلَكَتْ أَيْمَانُكُمْ كِتَابَ اللَّهِ عَلَيْكُمْ وَأُحِلَّ لَكُمْ مَا وَرَاءَ ذَلِكُمْ أَنْ تَبْتَغُوا بِأَمْوَالِكُمْ مُحْصِنِينَ غَيْرَ مُسَافِحِينَ فَمَا اسْتَمْتَعْتُمْ بِهِ مِنْهُنَّ فَآتُوهُنَّ أُجُورَهُنَّ فَرِيضَةً وَلَا جُنَاحَ عَلَيْكُمْ فِيمَا تَرَاضَيْتُمْ بِهِ مِنْ بَعْدِ الْفَرِيضَةِ إِنَّ اللَّهَ كَانَ عَلِيمًا حَكِيمًا"},"next":{"a":26,"text":"يُرِيدُ اللَّهُ لِيُبَيِّنَ لَكُمْ وَيَهْدِيَكُمْ سُنَنَ الَّذِينَ مِنْ قَبْلِكُمْ وَيَتُوبَ عَلَيْكُمْ وَاللَّهُ عَلِيمٌ حَكِيمٌ"},"context":"قبلها: والمحصنات من النساء.","reason":"نكاح الفتيات المؤمنات."}],"hadiths":[],"situations":[{"situationId":50,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَاللَّهُ أَعْلَمُ بِإِيمَانِكُمْ بَعْضُكُمْ مِنْ بَعْضٍ﴾."}],"hadiths":[]}]},{"id":402,"name":"أعلم بإيمانهن","compound":true,"meaning":"الله أعلم بإيمانهن: امتحان المهاجرات.","teaches":"1. الحكم بالظاهر والعلم بالباطن لله.","whenRecall":"- حين تحكم على إيمان أحد.","whenPray":"1. اللهم اعف عن سوء ظني.","summary":"احكم بالظاهر ودع الباطن لله.","verses":[{"i":1,"of":1,"s":60,"surah":"الممتحنة","a":10,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا جَاءَكُمُ الْمُؤْمِنَاتُ مُهَاجِرَاتٍ فَامْتَحِنُوهُنَّ اللَّهُ أَعْلَمُ بِإِيمَانِهِنَّ فَإِنْ عَلِمْتُمُوهُنَّ مُؤْمِنَاتٍ فَلَا تَرْجِعُوهُنَّ إِلَى الْكُفَّارِ لَا هُنَّ حِلٌّ لَهُمْ وَلَا هُمْ يَحِلُّونَ لَهُنَّ وَآتُوهُمْ مَا أَنْفَقُوا وَلَا جُنَاحَ عَلَيْكُمْ أَنْ تَنْكِحُوهُنَّ إِذَا آتَيْتُمُوهُنَّ أُجُورَهُنَّ وَلَا تُمْسِكُوا بِعِصَمِ الْكَوَافِرِ وَاسْأَلُوا مَا أَنْفَقْتُمْ وَلْيَسْأَلُوا مَا أَنْفَقُوا ذَلِكُمْ حُكْمُ اللَّهِ يَحْكُمُ بَيْنَكُمْ وَاللَّهُ عَلِيمٌ حَكِيمٌ","prev":{"a":9,"text":"إِنَّمَا يَنْهَاكُمُ اللَّهُ عَنِ الَّذِينَ قَاتَلُوكُمْ فِي الدِّينِ وَأَخْرَجُوكُمْ مِنْ دِيَارِكُمْ وَظَاهَرُوا عَلَى إِخْرَاجِكُمْ أَنْ تَوَلَّوْهُمْ وَمَنْ يَتَوَلَّهُمْ فَأُولَئِكَ هُمُ الظَّالِمُونَ"},"next":{"a":11,"text":"وَإِنْ فَاتَكُمْ شَيْءٌ مِنْ أَزْوَاجِكُمْ إِلَى الْكُفَّارِ فَعَاقَبْتُمْ فَآتُوا الَّذِينَ ذَهَبَتْ أَزْوَاجُهُمْ مِثْلَ مَا أَنْفَقُوا وَاتَّقُوا اللَّهَ الَّذِي أَنْتُمْ بِهِ مُؤْمِنُونَ"},"context":"قبلها: ينهاكم عن الذين قاتلوكم.","reason":"الامتحان."}],"hadiths":[{"i":1,"of":1,"text":"لَمَّا كاتَبَ سُهَيلُ بنُ عَمرٍو يَومَئذٍ كان فيما اشتَرَطَ سُهَيلُ بنُ عَمرٍو على النَّبيِّ صلَّى اللهُ عليه وسلَّم: أنَّه لا يَأتيك مِنَّا أحَدٌ وإن كان على دينِك، إلَّا رَدَدتَه إلينا، وخَلَّيتَ بينَنا وبينَه، فكَرِهَ المُؤمِنونَ ذلك وامتَعَضوا منه، وأبى سُهَيلٌ إلَّا ذلك، فكاتَبَه النَّبيُّ صلَّى اللهُ عليه وسلَّم على ذلك، فرَدَّ يَومَئذٍ أبا جَندَلٍ إلى أبيه سُهَيلِ بنِ عَمرٍو، ولم يَأتِه أحَدٌ مِنَ الرِّجالِ إلَّا رَدَّه في تلك المُدَّةِ وإن كان مُسلِمًا، وجاءَتِ المُؤمِناتُ مُهاجِراتٍ، وكانَت أُمُّ كُلثومٍ بنتُ عُقبةَ بنِ أبي مُعَيطٍ مِمَّن خَرَجَ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم يَومَئذٍ، وهي عاتِقٌ، فجاءَ أهلُها يَسألونَ النَّبيَّ صلَّى اللهُ عليه وسلَّم أن يَرجِعَها إليهم، فلَم يَرجِعْها إليهم، لمَّا أنزَلَ اللهُ فيهنَّ: {إذا جاءَكُمُ المُؤمِناتُ مُهاجِراتٍ فامتَحِنوهُنَّ اللهُ أعلَمُ بِإيمانِهنَّ} إلى قَولِه: {ولا هم يَحِلُّونَ لَهنَّ} [الممتحنة: 10]. قال عُروةُ: فأخبَرَتني عائِشةُ أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم كان يَمتَحِنُهنَّ بهذه الآيةِ: {يا أيُّها الذينَ آمَنوا إذا جاءَكُمُ المُؤمِناتُ مُهاجِراتٍ فامتَحِنوهُنَّ} إلى {غَفورٌ رَحيمٌ} [الممتحنة: 10 - 12]. قال عُروةُ: قالت عائِشةُ: فمَن أقَرَّ بهذا الشَّرطِ منهنَّ قال لَها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: قد بايَعتُكِ، كَلامًا يُكَلِّمُها به، واللهِ ما مَسَّت يَدُه يَدَ امرَأةٍ قَطُّ في المُبايَعةِ، وما بايَعَهنَّ إلَّا بقَولِه.","narrator":"أصحاب النبي صلى الله عليه وسلم","source":"صحيح البخاري 2711","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/xNtwnwf4","nameForm":"أعلم بإيمانهن"}],"sunnah":{},"situations":[{"situationId":59,"verses":[{"i":1,"strength":"direct","bridge":"﴿إِذَا جَاءَكُمُ الْمُؤْمِنَاتُ مُهَاجِرَاتٍ فَامْتَحِنُوهُنَّ اللَّهُ أَعْلَمُ بِإِيمَانِهِنَّ﴾."}],"hadiths":[]}]},{"id":403,"name":"أعلم بأعدائكم","compound":true,"meaning":"الله أعلم بأعدائكم: يعرفهم أكثر منكم.","teaches":"1. مع كفى بالله وليًّا ونصيرًا.","whenRecall":"- حين لا تعرف من يعاديك.","whenPray":"1. اللهم اكفني من لا أعلم.","summary":"يعلم أعداءك ويكفيك.","verses":[{"i":1,"of":1,"s":4,"surah":"النساء","a":45,"text":"وَاللَّهُ أَعْلَمُ بِأَعْدَائِكُمْ وَكَفَى بِاللَّهِ وَلِيًّا وَكَفَى بِاللَّهِ نَصِيرًا","prev":{"a":44,"text":"أَلَمْ تَرَ إِلَى الَّذِينَ أُوتُوا نَصِيبًا مِنَ الْكِتَابِ يَشْتَرُونَ الضَّلَالَةَ وَيُرِيدُونَ أَنْ تَضِلُّوا السَّبِيلَ"},"next":{"a":46,"text":"مِنَ الَّذِينَ هَادُوا يُحَرِّفُونَ الْكَلِمَ عَنْ مَوَاضِعِهِ وَيَقُولُونَ سَمِعْنَا وَعَصَيْنَا وَاسْمَعْ غَيْرَ مُسْمَعٍ وَرَاعِنَا لَيًّا بِأَلْسِنَتِهِمْ وَطَعْنًا فِي الدِّينِ وَلَوْ أَنَّهُمْ قَالُوا سَمِعْنَا وَأَطَعْنَا وَاسْمَعْ وَانْظُرْنَا لَكَانَ خَيْرًا لَهُمْ وَأَقْوَمَ وَلَكِنْ لَعَنَهُمُ اللَّهُ بِكُفْرِهِمْ فَلَا يُؤْمِنُونَ إِلَّا قَلِيلًا"},"context":"قبلها: يريدون أن تضلوا السبيل.","reason":"العلم بالأعداء."}],"hadiths":[],"situations":[{"situationId":30,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَاللَّهُ أَعْلَمُ بِأَعْدَائِكُمْ﴾."}],"hadiths":[]}]},{"id":404,"name":"أعلم بعدتهم","compound":true,"meaning":"ربي أعلم بعدتهم: النهي عن الرجم بالغيب.","teaches":"1. اختلاف الناس في عدد أهل الكهف.","whenRecall":"- حين تخوض فيما لا علم لك به.","whenPray":"1. ربي أعلم.","summary":"لا تخض بلا علم.","verses":[{"i":1,"of":1,"s":18,"surah":"الكهف","a":22,"text":"سَيَقُولُونَ ثَلَاثَةٌ رَابِعُهُمْ كَلْبُهُمْ وَيَقُولُونَ خَمْسَةٌ سَادِسُهُمْ كَلْبُهُمْ رَجْمًا بِالْغَيْبِ وَيَقُولُونَ سَبْعَةٌ وَثَامِنُهُمْ كَلْبُهُمْ قُلْ رَبِّي أَعْلَمُ بِعِدَّتِهِمْ مَا يَعْلَمُهُمْ إِلَّا قَلِيلٌ فَلَا تُمَارِ فِيهِمْ إِلَّا مِرَاءً ظَاهِرًا وَلَا تَسْتَفْتِ فِيهِمْ مِنْهُمْ أَحَدًا","prev":{"a":21,"text":"وَكَذَلِكَ أَعْثَرْنَا عَلَيْهِمْ لِيَعْلَمُوا أَنَّ وَعْدَ اللَّهِ حَقٌّ وَأَنَّ السَّاعَةَ لَا رَيْبَ فِيهَا إِذْ يَتَنَازَعُونَ بَيْنَهُمْ أَمْرَهُمْ فَقَالُوا ابْنُوا عَلَيْهِمْ بُنْيَانًا رَبُّهُمْ أَعْلَمُ بِهِمْ قَالَ الَّذِينَ غَلَبُوا عَلَى أَمْرِهِمْ لَنَتَّخِذَنَّ عَلَيْهِمْ مَسْجِدًا"},"next":{"a":23,"text":"وَلَا تَقُولَنَّ لِشَيْءٍ إِنِّي فَاعِلٌ ذَلِكَ غَدًا"},"context":"قبلها: أعثرنا عليهم.","reason":"الرجم بالغيب."}],"hadiths":[],"situations":[{"situationId":195,"verses":[{"i":1,"strength":"direct","bridge":"﴿رَجْمًا بِالْغَيْبِ﴾."}],"hadiths":[]}]},{"id":405,"name":"به عليم / به عليمًا","compound":true,"meaning":"فإن الله به عليم: ما تنفقه وتفعله من خير معلوم.","teaches":"1. أكثر مواضعها في الإنفاق.\n2. والإحسان إلى اليتامى.","whenRecall":"- حين تنفق سرًّا.","whenPray":"1. اللهم تقبّل نفقتي.","summary":"النفقة معلومة.","verses":[{"i":1,"of":4,"s":2,"surah":"البقرة","a":215,"text":"يَسْأَلُونَكَ مَاذَا يُنْفِقُونَ قُلْ مَا أَنْفَقْتُمْ مِنْ خَيْرٍ فَلِلْوَالِدَيْنِ وَالْأَقْرَبِينَ وَالْيَتَامَى وَالْمَسَاكِينِ وَابْنِ السَّبِيلِ وَمَا تَفْعَلُوا مِنْ خَيْرٍ فَإِنَّ اللَّهَ بِهِ عَلِيمٌ","prev":{"a":214,"text":"أَمْ حَسِبْتُمْ أَنْ تَدْخُلُوا الْجَنَّةَ وَلَمَّا يَأْتِكُمْ مَثَلُ الَّذِينَ خَلَوْا مِنْ قَبْلِكُمْ مَسَّتْهُمُ الْبَأْسَاءُ وَالضَّرَّاءُ وَزُلْزِلُوا حَتَّى يَقُولَ الرَّسُولُ وَالَّذِينَ آمَنُوا مَعَهُ مَتَى نَصْرُ اللَّهِ أَلَا إِنَّ نَصْرَ اللَّهِ قَرِيبٌ"},"next":{"a":216,"text":"كُتِبَ عَلَيْكُمُ الْقِتَالُ وَهُوَ كُرْهٌ لَكُمْ وَعَسَى أَنْ تَكْرَهُوا شَيْئًا وَهُوَ خَيْرٌ لَكُمْ وَعَسَى أَنْ تُحِبُّوا شَيْئًا وَهُوَ شَرٌّ لَكُمْ وَاللَّهُ يَعْلَمُ وَأَنْتُمْ لَا تَعْلَمُونَ"},"context":"قبلها: أم حسبتم أن تدخلوا الجنة.","reason":"مواضع النفقة."},{"i":2,"of":4,"s":2,"surah":"البقرة","a":273,"text":"لِلْفُقَرَاءِ الَّذِينَ أُحْصِرُوا فِي سَبِيلِ اللَّهِ لَا يَسْتَطِيعُونَ ضَرْبًا فِي الْأَرْضِ يَحْسَبُهُمُ الْجَاهِلُ أَغْنِيَاءَ مِنَ التَّعَفُّفِ تَعْرِفُهُمْ بِسِيمَاهُمْ لَا يَسْأَلُونَ النَّاسَ إِلْحَافًا وَمَا تُنْفِقُوا مِنْ خَيْرٍ فَإِنَّ اللَّهَ بِهِ عَلِيمٌ","prev":{"a":272,"text":"لَيْسَ عَلَيْكَ هُدَاهُمْ وَلَكِنَّ اللَّهَ يَهْدِي مَنْ يَشَاءُ وَمَا تُنْفِقُوا مِنْ خَيْرٍ فَلِأَنْفُسِكُمْ وَمَا تُنْفِقُونَ إِلَّا ابْتِغَاءَ وَجْهِ اللَّهِ وَمَا تُنْفِقُوا مِنْ خَيْرٍ يُوَفَّ إِلَيْكُمْ وَأَنْتُمْ لَا تُظْلَمُونَ"},"next":{"a":274,"text":"الَّذِينَ يُنْفِقُونَ أَمْوَالَهُمْ بِاللَّيْلِ وَالنَّهَارِ سِرًّا وَعَلَانِيَةً فَلَهُمْ أَجْرُهُمْ عِنْدَ رَبِّهِمْ وَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ"},"context":"قبلها: ليس عليك هداهم.","reason":"المتعففون."},{"i":3,"of":4,"s":3,"surah":"آل عمران","a":92,"text":"لَنْ تَنَالُوا الْبِرَّ حَتَّى تُنْفِقُوا مِمَّا تُحِبُّونَ وَمَا تُنْفِقُوا مِنْ شَيْءٍ فَإِنَّ اللَّهَ بِهِ عَلِيمٌ","prev":{"a":91,"text":"إِنَّ الَّذِينَ كَفَرُوا وَمَاتُوا وَهُمْ كُفَّارٌ فَلَنْ يُقْبَلَ مِنْ أَحَدِهِمْ مِلْءُ الْأَرْضِ ذَهَبًا وَلَوِ افْتَدَى بِهِ أُولَئِكَ لَهُمْ عَذَابٌ أَلِيمٌ وَمَا لَهُمْ مِنْ نَاصِرِينَ"},"next":{"a":93,"text":"كُلُّ الطَّعَامِ كَانَ حِلًّا لِبَنِي إِسْرَائِيلَ إِلَّا مَا حَرَّمَ إِسْرَائِيلُ عَلَى نَفْسِهِ مِنْ قَبْلِ أَنْ تُنَزَّلَ التَّوْرَاةُ قُلْ فَأْتُوا بِالتَّوْرَاةِ فَاتْلُوهَا إِنْ كُنْتُمْ صَادِقِينَ"},"context":"قبلها: الذين كفروا وماتوا.","reason":"البر بالإنفاق مما تحب."},{"i":4,"of":4,"s":4,"surah":"النساء","a":127,"text":"وَيَسْتَفْتُونَكَ فِي النِّسَاءِ قُلِ اللَّهُ يُفْتِيكُمْ فِيهِنَّ وَمَا يُتْلَى عَلَيْكُمْ فِي الْكِتَابِ فِي يَتَامَى النِّسَاءِ اللَّاتِي لَا تُؤْتُونَهُنَّ مَا كُتِبَ لَهُنَّ وَتَرْغَبُونَ أَنْ تَنْكِحُوهُنَّ وَالْمُسْتَضْعَفِينَ مِنَ الْوِلْدَانِ وَأَنْ تَقُومُوا لِلْيَتَامَى بِالْقِسْطِ وَمَا تَفْعَلُوا مِنْ خَيْرٍ فَإِنَّ اللَّهَ كَانَ بِهِ عَلِيمًا","prev":{"a":126,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَانَ اللَّهُ بِكُلِّ شَيْءٍ مُحِيطًا"},"next":{"a":128,"text":"وَإِنِ امْرَأَةٌ خَافَتْ مِنْ بَعْلِهَا نُشُوزًا أَوْ إِعْرَاضًا فَلَا جُنَاحَ عَلَيْهِمَا أَنْ يُصْلِحَا بَيْنَهُمَا صُلْحًا وَالصُّلْحُ خَيْرٌ وَأُحْضِرَتِ الْأَنْفُسُ الشُّحَّ وَإِنْ تُحْسِنُوا وَتَتَّقُوا فَإِنَّ اللَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًا"},"context":"قبلها: لله ما في السماوات.","reason":"يتامى النساء."}],"hadiths":[{"i":1,"of":1,"text":"عنِ ابنِ عَبَّاسٍ رَضيَ اللهُ عنهُما قالَ: كانوا يَكْرَهونَ أنْ يَرْضَخوا لِأنسابِهِم وهُم مُشرِكونَ، فنَزَلَتْ: {لَيْسَ عَلَيْكَ هُدَاهُمْ} [البقرة: 272] حتَّى بلَغَ: {وَمَا تُنْفِقُوا مِنْ خَيْرٍ فَإِنَّ اللَّهَ بِهِ عَلِيمٌ} [البقرة: 273]، فرُخِّصَ لهمْ.","narrator":"سعيد بن جبير","source":"المستدرك على الصحيحين 7470","grade":"صحيح","judgment":"صحيح الإسناد","url":"https://dorar.net/h/jwqcv7mA","nameForm":"به عليم / به عليمًا"}],"sunnah":{},"situations":[{"situationId":43,"verses":[{"i":3,"strength":"direct","bridge":"﴿لَنْ تَنَالُوا الْبِرَّ حَتَّى تُنْفِقُوا مِمَّا تُحِبُّونَ﴾."}],"hadiths":[]},{"situationId":45,"verses":[{"i":1,"strength":"direct","bridge":"﴿قُلْ مَا أَنْفَقْتُمْ مِنْ خَيْرٍ فَلِلْوَالِدَيْنِ وَالْأَقْرَبِينَ﴾."},{"i":2,"strength":"direct","bridge":"﴿يَحْسَبُهُمُ الْجَاهِلُ أَغْنِيَاءَ مِنَ التَّعَفُّفِ﴾."}],"hadiths":[]},{"situationId":55,"verses":[{"i":4,"strength":"direct","bridge":"﴿وَيَسْتَفْتُونَكَ فِي النِّسَاءِ قُلِ اللَّهُ يُفْتِيكُمْ فِيهِنَّ﴾."}],"hadiths":[]}]},{"id":406,"name":"بهم عليمًا","compound":true,"meaning":"بهم عليمًا: يعلم المرائين والمنفقين.","teaches":"1. ماذا عليهم لو آمنوا وأنفقوا؟","whenRecall":"- حين تبخل.","whenPray":"1. اللهم ارزقني الإنفاق.","summary":"ما الذي يضرك لو آمنت وأنفقت؟","verses":[{"i":1,"of":1,"s":4,"surah":"النساء","a":39,"text":"وَمَاذَا عَلَيْهِمْ لَوْ آمَنُوا بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَأَنْفَقُوا مِمَّا رَزَقَهُمُ اللَّهُ وَكَانَ اللَّهُ بِهِمْ عَلِيمًا","prev":{"a":38,"text":"وَالَّذِينَ يُنْفِقُونَ أَمْوَالَهُمْ رِئَاءَ النَّاسِ وَلَا يُؤْمِنُونَ بِاللَّهِ وَلَا بِالْيَوْمِ الْآخِرِ وَمَنْ يَكُنِ الشَّيْطَانُ لَهُ قَرِينًا فَسَاءَ قَرِينًا"},"next":{"a":40,"text":"إِنَّ اللَّهَ لَا يَظْلِمُ مِثْقَالَ ذَرَّةٍ وَإِنْ تَكُ حَسَنَةً يُضَاعِفْهَا وَيُؤْتِ مِنْ لَدُنْهُ أَجْرًا عَظِيمًا"},"context":"قبلها: ينفقون أموالهم رئاء الناس.","reason":"سؤال الاستنكار."}],"hadiths":[],"situations":[{"situationId":81,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَمَاذَا عَلَيْهِمْ لَوْ آمَنُوا بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَأَنْفَقُوا﴾."}],"hadiths":[]}]},{"id":407,"name":"أعلم بكم / أعلم بهم","compound":true,"meaning":"ربكم أعلم بكم: يرحم أو يعذب بعلمه.","teaches":"1. بعد الأمر بالقول الحسن.\n2. في أهل الكهف.\n3. لا تزكوا أنفسكم.","whenRecall":"- حين تزكي نفسك.","whenPray":"1. اللهم ارحمني.","summary":"علمه بك أعمق من علمك.","verses":[{"i":1,"of":3,"s":17,"surah":"الإسراء","a":54,"text":"رَبُّكُمْ أَعْلَمُ بِكُمْ إِنْ يَشَأْ يَرْحَمْكُمْ أَوْ إِنْ يَشَأْ يُعَذِّبْكُمْ وَمَا أَرْسَلْنَاكَ عَلَيْهِمْ وَكِيلًا","prev":{"a":53,"text":"وَقُلْ لِعِبَادِي يَقُولُوا الَّتِي هِيَ أَحْسَنُ إِنَّ الشَّيْطَانَ يَنْزَغُ بَيْنَهُمْ إِنَّ الشَّيْطَانَ كَانَ لِلْإِنْسَانِ عَدُوًّا مُبِينًا"},"next":{"a":55,"text":"وَرَبُّكَ أَعْلَمُ بِمَنْ فِي السَّمَاوَاتِ وَالْأَرْضِ وَلَقَدْ فَضَّلْنَا بَعْضَ النَّبِيِّينَ عَلَى بَعْضٍ وَآتَيْنَا دَاوُودَ زَبُورًا"},"context":"قبلها: قل لعبادي يقولوا التي هي أحسن.","reason":"الرحمة والعذاب بمشيئته."},{"i":2,"of":3,"s":18,"surah":"الكهف","a":21,"text":"وَكَذَلِكَ أَعْثَرْنَا عَلَيْهِمْ لِيَعْلَمُوا أَنَّ وَعْدَ اللَّهِ حَقٌّ وَأَنَّ السَّاعَةَ لَا رَيْبَ فِيهَا إِذْ يَتَنَازَعُونَ بَيْنَهُمْ أَمْرَهُمْ فَقَالُوا ابْنُوا عَلَيْهِمْ بُنْيَانًا رَبُّهُمْ أَعْلَمُ بِهِمْ قَالَ الَّذِينَ غَلَبُوا عَلَى أَمْرِهِمْ لَنَتَّخِذَنَّ عَلَيْهِمْ مَسْجِدًا","prev":{"a":20,"text":"إِنَّهُمْ إِنْ يَظْهَرُوا عَلَيْكُمْ يَرْجُمُوكُمْ أَوْ يُعِيدُوكُمْ فِي مِلَّتِهِمْ وَلَنْ تُفْلِحُوا إِذًا أَبَدًا"},"next":{"a":22,"text":"سَيَقُولُونَ ثَلَاثَةٌ رَابِعُهُمْ كَلْبُهُمْ وَيَقُولُونَ خَمْسَةٌ سَادِسُهُمْ كَلْبُهُمْ رَجْمًا بِالْغَيْبِ وَيَقُولُونَ سَبْعَةٌ وَثَامِنُهُمْ كَلْبُهُمْ قُلْ رَبِّي أَعْلَمُ بِعِدَّتِهِمْ مَا يَعْلَمُهُمْ إِلَّا قَلِيلٌ فَلَا تُمَارِ فِيهِمْ إِلَّا مِرَاءً ظَاهِرًا وَلَا تَسْتَفْتِ فِيهِمْ مِنْهُمْ أَحَدًا"},"context":"قبلها: إن يظهروا عليكم يرجموكم.","reason":"التنازع في أمرهم."},{"i":3,"of":3,"s":53,"surah":"النجم","a":32,"text":"الَّذِينَ يَجْتَنِبُونَ كَبَائِرَ الْإِثْمِ وَالْفَوَاحِشَ إِلَّا اللَّمَمَ إِنَّ رَبَّكَ وَاسِعُ الْمَغْفِرَةِ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنْشَأَكُمْ مِنَ الْأَرْضِ وَإِذْ أَنْتُمْ أَجِنَّةٌ فِي بُطُونِ أُمَّهَاتِكُمْ فَلَا تُزَكُّوا أَنْفُسَكُمْ هُوَ أَعْلَمُ بِمَنِ اتَّقَى","prev":{"a":31,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ لِيَجْزِيَ الَّذِينَ أَسَاءُوا بِمَا عَمِلُوا وَيَجْزِيَ الَّذِينَ أَحْسَنُوا بِالْحُسْنَى"},"next":{"a":33,"text":"أَفَرَأَيْتَ الَّذِي تَوَلَّى"},"context":"قبلها: ليجزي الذين أحسنوا بالحسنى.","reason":"العلم بالنشأة."}],"hadiths":[{"i":1,"of":1,"text":"يَتَعاقَبونَ فيكُم مَلائِكةٌ باللَّيلِ ومَلائِكةٌ بالنَّهارِ، ويَجتَمِعونَ في صَلاةِ العَصرِ وصَلاةِ الفَجرِ، ثُمَّ يَعرُجُ الذينَ باتوا فيكُم فيَسألُهم وهو أعلَمُ بكُم، فيَقولُ: كيفَ تَرَكتُم عِبادي؟ فيَقولونَ: تَرَكناهم وهم يُصَلُّونَ، وأتَيناهم وهم يُصَلُّونَ.","narrator":"أبو هريرة","source":"صحيح البخاري 7429","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/5lwbsOwJ","nameForm":"أعلم بكم / أعلم بهم"}],"sunnah":{},"situations":[{"situationId":22,"verses":[{"i":1,"strength":"direct","bridge":"﴿رَبُّكُمْ أَعْلَمُ بِكُمْ إِنْ يَشَأْ يَرْحَمْكُمْ﴾."}],"hadiths":[]},{"situationId":82,"verses":[{"i":3,"strength":"direct","bridge":"﴿هُوَ أَعْلَمُ بِكُمْ إِذْ أَنْشَأَكُمْ مِنَ الْأَرْضِ﴾."}],"hadiths":[]},{"situationId":110,"verses":[{"i":2,"strength":"direct","bridge":"﴿لِيَعْلَمُوا أَنَّ وَعْدَ اللَّهِ حَقٌّ وَأَنَّ السَّاعَةَ لَا رَيْبَ فِيهَا﴾."}],"hadiths":[]}]},{"id":408,"name":"كنت بنا بصيرًا / كان به بصيرًا","compound":true,"meaning":"كنت بنا بصيرًا: دعاء موسى، وبصره بمن ظن أن لن يحور.","teaches":"1. موسى يطلب أخاه وزيرًا.\n2. من ظن ألا يرجع.","whenRecall":"- حين تطلب معينًا.","whenPray":"1. ﴿إِنَّكَ كُنْتَ بِنَا بَصِيرًا﴾.","summary":"اطلب العون ممن يراك.","verses":[{"i":1,"of":2,"s":20,"surah":"طه","a":35,"text":"إِنَّكَ كُنْتَ بِنَا بَصِيرًا","prev":{"a":34,"text":"وَنَذْكُرَكَ كَثِيرًا"},"next":{"a":36,"text":"قَالَ قَدْ أُوتِيتَ سُؤْلَكَ يَا مُوسَى"},"context":"قبلها: ونذكرك كثيرًا.","reason":"ختام دعاء موسى."},{"i":2,"of":2,"s":84,"surah":"الانشقاق","a":15,"text":"بَلَى إِنَّ رَبَّهُ كَانَ بِهِ بَصِيرًا","prev":{"a":14,"text":"إِنَّهُ ظَنَّ أَنْ لَنْ يَحُورَ"},"next":{"a":16,"text":"فَلَا أُقْسِمُ بِالشَّفَقِ"},"context":"قبلها: إنه ظن أن لن يحور.","reason":"الرجوع."}],"hadiths":[],"situations":[{"situationId":109,"verses":[{"i":2,"strength":"direct","bridge":"﴿بَلَى إِنَّ رَبَّهُ كَانَ بِهِ بَصِيرًا﴾."}],"hadiths":[]},{"situationId":162,"verses":[{"i":1,"strength":"direct","bridge":"﴿إِنَّكَ كُنْتَ بِنَا بَصِيرًا﴾."}],"hadiths":[]}]},{"id":409,"name":"بهم يومئذ لخبير","compound":true,"meaning":"إن ربهم بهم يومئذ لخبير: يوم يحصل ما في الصدور.","teaches":"1. ختام العاديات.","whenRecall":"- حين تُضمر.","whenPray":"1. اللهم طهر صدري.","summary":"ما في الصدور يُحصّل.","verses":[{"i":1,"of":1,"s":100,"surah":"العاديات","a":11,"text":"إِنَّ رَبَّهُمْ بِهِمْ يَوْمَئِذٍ لَخَبِيرٌ","prev":{"a":10,"text":"وَحُصِّلَ مَا فِي الصُّدُورِ"},"context":"قبلها: حصل ما في الصدور.","reason":"الخبرة يوم القيامة."}],"hadiths":[],"situations":[{"situationId":86,"verses":[{"i":1,"strength":"direct","bridge":"﴿إِنَّ رَبَّهُمْ بِهِمْ يَوْمَئِذٍ لَخَبِيرٌ﴾."}],"hadiths":[]}]},{"id":410,"name":"من ورائهم محيط","compound":true,"meaning":"والله من ورائهم محيط: لا مهرب منه.","teaches":"1. بعد: بل الذين كفروا في تكذيب.","whenRecall":"- حين ترى المكذبين.","whenPray":"1. اللهم احفظني.","summary":"لا مهرب.","verses":[{"i":1,"of":1,"s":85,"surah":"البروج","a":20,"text":"وَاللَّهُ مِنْ وَرَائِهِمْ مُحِيطٌ","prev":{"a":19,"text":"بَلِ الَّذِينَ كَفَرُوا فِي تَكْذِيبٍ"},"next":{"a":21,"text":"بَلْ هُوَ قُرْآنٌ مَجِيدٌ"},"context":"قبلها: بل الذين كفروا في تكذيب.","reason":"الإحاطة."}],"hadiths":[],"situations":[{"situationId":35,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَاللَّهُ مِنْ وَرَائِهِمْ مُحِيطٌ﴾."}],"hadiths":[]}]},{"id":411,"name":"الرقيب عليهم","compound":true,"meaning":"كنت أنت الرقيب عليهم: قالها عيسى يوم القيامة.","teaches":"1. بعد غيابه، الرقيب الله.","whenRecall":"- حين تغيب عن أهلك.","whenPray":"1. أنت الرقيب.","summary":"إذا غبت فالرقيب الله.","verses":[{"i":1,"of":1,"s":5,"surah":"المائدة","a":117,"text":"مَا قُلْتُ لَهُمْ إِلَّا مَا أَمَرْتَنِي بِهِ أَنِ اعْبُدُوا اللَّهَ رَبِّي وَرَبَّكُمْ وَكُنْتُ عَلَيْهِمْ شَهِيدًا مَا دُمْتُ فِيهِمْ فَلَمَّا تَوَفَّيْتَنِي كُنْتَ أَنْتَ الرَّقِيبَ عَلَيْهِمْ وَأَنْتَ عَلَى كُلِّ شَيْءٍ شَهِيدٌ","prev":{"a":116,"text":"وَإِذْ قَالَ اللَّهُ يَا عِيسَى ابْنَ مَرْيَمَ أَأَنْتَ قُلْتَ لِلنَّاسِ اتَّخِذُونِي وَأُمِّيَ إِلَهَيْنِ مِنْ دُونِ اللَّهِ قَالَ سُبْحَانَكَ مَا يَكُونُ لِي أَنْ أَقُولَ مَا لَيْسَ لِي بِحَقٍّ إِنْ كُنْتُ قُلْتُهُ فَقَدْ عَلِمْتَهُ تَعْلَمُ مَا فِي نَفْسِي وَلَا أَعْلَمُ مَا فِي نَفْسِكَ إِنَّكَ أَنْتَ عَلَّامُ الْغُيُوبِ"},"next":{"a":118,"text":"إِنْ تُعَذِّبْهُمْ فَإِنَّهُمْ عِبَادُكَ وَإِنْ تَغْفِرْ لَهُمْ فَإِنَّكَ أَنْتَ الْعَزِيزُ الْحَكِيمُ"},"context":"قبلها: أأنت قلت للناس اتخذوني.","reason":"البراءة."}],"hadiths":[{"i":1,"of":1,"text":"فَكَيْفَ إِذَا جِئْنَا مِنْ كُلِّ أُمَّةٍ بِشَهِيدٍ  قال : قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ شَهيدٌ علَيهم ما دمتُ فيهِم ، فإذا تَوفَّيتَني كنتَ أنتَ الرَّقيبَ علَيهم","narrator":"عبدالله بن مسعود","source":"عمدة التفسير 1/509","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/CP9BaEm1","nameForm":"الرقيب عليهم"}],"sunnah":{},"situations":[{"situationId":11,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَكُنْتُ عَلَيْهِمْ شَهِيدًا مَا دُمْتُ فِيهِمْ﴾."}],"hadiths":[]}]},{"id":412,"name":"حفيظ عليهم","compound":true,"meaning":"الله حفيظ عليهم: يحصي على المشركين، وما أنت عليهم بوكيل.","teaches":"1. رفع المسؤولية عن الداعي.","whenRecall":"- حين تحمّل نفسك هداية الناس.","whenPray":"1. اللهم أعني على البلاغ.","summary":"لست وكيلًا عليهم.","verses":[{"i":1,"of":1,"s":42,"surah":"الشورى","a":6,"text":"وَالَّذِينَ اتَّخَذُوا مِنْ دُونِهِ أَوْلِيَاءَ اللَّهُ حَفِيظٌ عَلَيْهِمْ وَمَا أَنْتَ عَلَيْهِمْ بِوَكِيلٍ","prev":{"a":5,"text":"تَكَادُ السَّمَاوَاتُ يَتَفَطَّرْنَ مِنْ فَوْقِهِنَّ وَالْمَلَائِكَةُ يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ وَيَسْتَغْفِرُونَ لِمَنْ فِي الْأَرْضِ أَلَا إِنَّ اللَّهَ هُوَ الْغَفُورُ الرَّحِيمُ"},"next":{"a":7,"text":"وَكَذَلِكَ أَوْحَيْنَا إِلَيْكَ قُرْآنًا عَرَبِيًّا لِتُنْذِرَ أُمَّ الْقُرَى وَمَنْ حَوْلَهَا وَتُنْذِرَ يَوْمَ الْجَمْعِ لَا رَيْبَ فِيهِ فَرِيقٌ فِي الْجَنَّةِ وَفَرِيقٌ فِي السَّعِيرِ"},"context":"قبلها: تكاد السماوات يتفطرن.","reason":"الحفظ."}],"hadiths":[],"situations":[{"situationId":131,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَمَا أَنْتَ عَلَيْهِمْ بِوَكِيلٍ﴾."}],"hadiths":[]}]},{"id":413,"name":"وليهما / وليكم / ولينا / وليي","compound":true,"meaning":"الله وليهما: يتولى من همّ بالفشل، ومن أقام الصلاة.","teaches":"1. يوم أحد: طائفتان همتا أن تفشلا.\n2. إنما وليكم الله.\n3. أنت ولينا: دعاء موسى.\n4. إن وليي الله الذي نزل الكتاب.","whenRecall":"- حين تهمّ بالفشل.","whenPray":"1. ﴿أَنْتَ وَلِيُّنَا فَاغْفِرْ لَنَا وَارْحَمْنَا﴾.","summary":"وليك يحفظك من الفشل.","verses":[{"i":1,"of":4,"s":3,"surah":"آل عمران","a":122,"text":"إِذْ هَمَّتْ طَائِفَتَانِ مِنْكُمْ أَنْ تَفْشَلَا وَاللَّهُ وَلِيُّهُمَا وَعَلَى اللَّهِ فَلْيَتَوَكَّلِ الْمُؤْمِنُونَ","prev":{"a":121,"text":"وَإِذْ غَدَوْتَ مِنْ أَهْلِكَ تُبَوِّئُ الْمُؤْمِنِينَ مَقَاعِدَ لِلْقِتَالِ وَاللَّهُ سَمِيعٌ عَلِيمٌ"},"next":{"a":123,"text":"وَلَقَدْ نَصَرَكُمُ اللَّهُ بِبَدْرٍ وَأَنْتُمْ أَذِلَّةٌ فَاتَّقُوا اللَّهَ لَعَلَّكُمْ تَشْكُرُونَ"},"context":"قبلها: غدوت من أهلك.","reason":"الهمّ بالفشل."},{"i":2,"of":4,"s":5,"surah":"المائدة","a":55,"text":"إِنَّمَا وَلِيُّكُمُ اللَّهُ وَرَسُولُهُ وَالَّذِينَ آمَنُوا الَّذِينَ يُقِيمُونَ الصَّلَاةَ وَيُؤْتُونَ الزَّكَاةَ وَهُمْ رَاكِعُونَ","prev":{"a":54,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا مَنْ يَرْتَدَّ مِنْكُمْ عَنْ دِينِهِ فَسَوْفَ يَأْتِي اللَّهُ بِقَوْمٍ يُحِبُّهُمْ وَيُحِبُّونَهُ أَذِلَّةٍ عَلَى الْمُؤْمِنِينَ أَعِزَّةٍ عَلَى الْكَافِرِينَ يُجَاهِدُونَ فِي سَبِيلِ اللَّهِ وَلَا يَخَافُونَ لَوْمَةَ لَائِمٍ ذَلِكَ فَضْلُ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ"},"next":{"a":56,"text":"وَمَنْ يَتَوَلَّ اللَّهَ وَرَسُولَهُ وَالَّذِينَ آمَنُوا فَإِنَّ حِزْبَ اللَّهِ هُمُ الْغَالِبُونَ"},"context":"قبلها: من يرتد منكم.","reason":"الولاية."},{"i":3,"of":4,"s":7,"surah":"الأعراف","a":155,"text":"وَاخْتَارَ مُوسَى قَوْمَهُ سَبْعِينَ رَجُلًا لِمِيقَاتِنَا فَلَمَّا أَخَذَتْهُمُ الرَّجْفَةُ قَالَ رَبِّ لَوْ شِئْتَ أَهْلَكْتَهُمْ مِنْ قَبْلُ وَإِيَّايَ أَتُهْلِكُنَا بِمَا فَعَلَ السُّفَهَاءُ مِنَّا إِنْ هِيَ إِلَّا فِتْنَتُكَ تُضِلُّ بِهَا مَنْ تَشَاءُ وَتَهْدِي مَنْ تَشَاءُ أَنْتَ وَلِيُّنَا فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الْغَافِرِينَ","prev":{"a":154,"text":"وَلَمَّا سَكَتَ عَنْ مُوسَى الْغَضَبُ أَخَذَ الْأَلْوَاحَ وَفِي نُسْخَتِهَا هُدًى وَرَحْمَةٌ لِلَّذِينَ هُمْ لِرَبِّهِمْ يَرْهَبُونَ"},"next":{"a":156,"text":"وَاكْتُبْ لَنَا فِي هَذِهِ الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ إِنَّا هُدْنَا إِلَيْكَ قَالَ عَذَابِي أُصِيبُ بِهِ مَنْ أَشَاءُ وَرَحْمَتِي وَسِعَتْ كُلَّ شَيْءٍ فَسَأَكْتُبُهَا لِلَّذِينَ يَتَّقُونَ وَيُؤْتُونَ الزَّكَاةَ وَالَّذِينَ هُمْ بِآيَاتِنَا يُؤْمِنُونَ"},"context":"قبلها: سكت عن موسى الغضب.","reason":"الرجفة."},{"i":4,"of":4,"s":7,"surah":"الأعراف","a":196,"text":"إِنَّ وَلِيِّيَ اللَّهُ الَّذِي نَزَّلَ الْكِتَابَ وَهُوَ يَتَوَلَّى الصَّالِحِينَ","prev":{"a":195,"text":"أَلَهُمْ أَرْجُلٌ يَمْشُونَ بِهَا أَمْ لَهُمْ أَيْدٍ يَبْطِشُونَ بِهَا أَمْ لَهُمْ أَعْيُنٌ يُبْصِرُونَ بِهَا أَمْ لَهُمْ آذَانٌ يَسْمَعُونَ بِهَا قُلِ ادْعُوا شُرَكَاءَكُمْ ثُمَّ كِيدُونِ فَلَا تُنْظِرُونِ"},"next":{"a":197,"text":"وَالَّذِينَ تَدْعُونَ مِنْ دُونِهِ لَا يَسْتَطِيعُونَ نَصْرَكُمْ وَلَا أَنْفُسَهُمْ يَنْصُرُونَ"},"context":"قبلها: ألهم أرجل يمشون بها.","reason":"الولاية."}],"hadiths":[{"i":1,"of":1,"text":"نَزَلَت هذه الآيةُ فينا: {إذ هَمَّت طائِفَتانِ مِنكُم أن تَفشَلا} [آل عمران: 122] بَني سَلِمةَ، وبَني حارِثةَ، وما أُحِبُّ أنَّها لَم تَنزِلْ، واللهُ يقولُ: {وَاللهُ وليُّهما}.","narrator":"جابر بن عبدالله","source":"صحيح البخاري 4051","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/lhEtVSmt","nameForm":"وليهما / وليكم / ولينا / وليي"}],"sunnah":{},"situations":[{"situationId":7,"verses":[{"i":1,"strength":"direct","bridge":"﴿إِذْ هَمَّتْ طَائِفَتَانِ مِنْكُمْ أَنْ تَفْشَلَا وَاللَّهُ وَلِيُّهُمَا﴾."}],"hadiths":[]},{"situationId":15,"verses":[{"i":3,"strength":"direct","bridge":"﴿أَتُهْلِكُنَا بِمَا فَعَلَ السُّفَهَاءُ مِنَّا﴾."}],"hadiths":[]},{"situationId":98,"verses":[{"i":4,"strength":"direct","bridge":"﴿إِنَّ وَلِيِّيَ اللَّهُ الَّذِي نَزَّلَ الْكِتَابَ وَهُوَ يَتَوَلَّى الصَّالِحِينَ﴾."}],"hadiths":[]},{"situationId":128,"verses":[{"i":2,"strength":"direct","bridge":"﴿إِنَّمَا وَلِيُّكُمُ اللَّهُ وَرَسُولُهُ وَالَّذِينَ آمَنُوا﴾."}],"hadiths":[]}]},{"id":414,"name":"وليي في الدنيا والآخرة","compound":true,"meaning":"أنت وليي في الدنيا والآخرة: دعاء يوسف بعد التمكين.","teaches":"1. بعد اجتماع الأسرة.\n2. سأل حسن الخاتمة.","whenRecall":"- بعد التمكين.","whenPray":"1. ﴿تَوَفَّنِي مُسْلِمًا وَأَلْحِقْنِي بِالصَّالِحِينَ﴾.","summary":"بعد كل نجاح اسأل حسن الخاتمة.","verses":[{"i":1,"of":1,"s":12,"surah":"يوسف","a":101,"text":"رَبِّ قَدْ آتَيْتَنِي مِنَ الْمُلْكِ وَعَلَّمْتَنِي مِنْ تَأْوِيلِ الْأَحَادِيثِ فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ أَنْتَ وَلِيِّي فِي الدُّنْيَا وَالْآخِرَةِ تَوَفَّنِي مُسْلِمًا وَأَلْحِقْنِي بِالصَّالِحِينَ","prev":{"a":100,"text":"وَرَفَعَ أَبَوَيْهِ عَلَى الْعَرْشِ وَخَرُّوا لَهُ سُجَّدًا وَقَالَ يَا أَبَتِ هَذَا تَأْوِيلُ رُؤْيَايَ مِنْ قَبْلُ قَدْ جَعَلَهَا رَبِّي حَقًّا وَقَدْ أَحْسَنَ بِي إِذْ أَخْرَجَنِي مِنَ السِّجْنِ وَجَاءَ بِكُمْ مِنَ الْبَدْوِ مِنْ بَعْدِ أَنْ نَزَغَ الشَّيْطَانُ بَيْنِي وَبَيْنَ إِخْوَتِي إِنَّ رَبِّي لَطِيفٌ لِمَا يَشَاءُ إِنَّهُ هُوَ الْعَلِيمُ الْحَكِيمُ"},"next":{"a":102,"text":"ذَلِكَ مِنْ أَنْبَاءِ الْغَيْبِ نُوحِيهِ إِلَيْكَ وَمَا كُنْتَ لَدَيْهِمْ إِذْ أَجْمَعُوا أَمْرَهُمْ وَهُمْ يَمْكُرُونَ"},"context":"قبلها: رفع أبويه على العرش.","reason":"الدعاء بعد التمكين."}],"hadiths":[],"situations":[{"situationId":115,"verses":[{"i":1,"strength":"direct","bridge":"﴿أَنْتَ وَلِيِّي فِي الدُّنْيَا وَالْآخِرَةِ تَوَفَّنِي مُسْلِمًا﴾."}],"hadiths":[]}]},{"id":415,"name":"مولاكم / مولانا / مولاه","compound":true,"meaning":"الله مولاكم: نعم المولى ونعم النصير.","teaches":"1. أنت مولانا فانصرنا (البقرة 286).\n2. لن يصيبنا إلا ما كتب الله لنا.","whenRecall":"- حين تخاف.","whenPray":"1. ﴿أَنْتَ مَوْلَانَا فَانْصُرْنَا عَلَى الْقَوْمِ الْكَافِرِينَ﴾.","summary":"مولاك ناصرك.","verses":[{"i":1,"of":7,"s":2,"surah":"البقرة","a":286,"text":"لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا لَهَا مَا كَسَبَتْ وَعَلَيْهَا مَا اكْتَسَبَتْ رَبَّنَا لَا تُؤَاخِذْنَا إِنْ نَسِينَا أَوْ أَخْطَأْنَا رَبَّنَا وَلَا تَحْمِلْ عَلَيْنَا إِصْرًا كَمَا حَمَلْتَهُ عَلَى الَّذِينَ مِنْ قَبْلِنَا رَبَّنَا وَلَا تُحَمِّلْنَا مَا لَا طَاقَةَ لَنَا بِهِ وَاعْفُ عَنَّا وَاغْفِرْ لَنَا وَارْحَمْنَا أَنْتَ مَوْلَانَا فَانْصُرْنَا عَلَى الْقَوْمِ الْكَافِرِينَ","prev":{"a":285,"text":"آمَنَ الرَّسُولُ بِمَا أُنْزِلَ إِلَيْهِ مِنْ رَبِّهِ وَالْمُؤْمِنُونَ كُلٌّ آمَنَ بِاللَّهِ وَمَلَائِكَتِهِ وَكُتُبِهِ وَرُسُلِهِ لَا نُفَرِّقُ بَيْنَ أَحَدٍ مِنْ رُسُلِهِ وَقَالُوا سَمِعْنَا وَأَطَعْنَا غُفْرَانَكَ رَبَّنَا وَإِلَيْكَ الْمَصِيرُ"},"context":"ختام البقرة.","reason":"الدعاء."},{"i":2,"of":7,"s":3,"surah":"آل عمران","a":150,"text":"بَلِ اللَّهُ مَوْلَاكُمْ وَهُوَ خَيْرُ النَّاصِرِينَ","prev":{"a":149,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ تُطِيعُوا الَّذِينَ كَفَرُوا يَرُدُّوكُمْ عَلَى أَعْقَابِكُمْ فَتَنْقَلِبُوا خَاسِرِينَ"},"next":{"a":151,"text":"سَنُلْقِي فِي قُلُوبِ الَّذِينَ كَفَرُوا الرُّعْبَ بِمَا أَشْرَكُوا بِاللَّهِ مَا لَمْ يُنَزِّلْ بِهِ سُلْطَانًا وَمَأْوَاهُمُ النَّارُ وَبِئْسَ مَثْوَى الظَّالِمِينَ"},"context":"قبلها: إن تطيعوا الذين كفروا.","reason":"المولى."},{"i":3,"of":7,"s":8,"surah":"الأنفال","a":40,"text":"وَإِنْ تَوَلَّوْا فَاعْلَمُوا أَنَّ اللَّهَ مَوْلَاكُمْ نِعْمَ الْمَوْلَى وَنِعْمَ النَّصِيرُ","prev":{"a":39,"text":"وَقَاتِلُوهُمْ حَتَّى لَا تَكُونَ فِتْنَةٌ وَيَكُونَ الدِّينُ كُلُّهُ لِلَّهِ فَإِنِ انْتَهَوْا فَإِنَّ اللَّهَ بِمَا يَعْمَلُونَ بَصِيرٌ"},"next":{"a":41,"text":"وَاعْلَمُوا أَنَّمَا غَنِمْتُمْ مِنْ شَيْءٍ فَأَنَّ لِلَّهِ خُمُسَهُ وَلِلرَّسُولِ وَلِذِي الْقُرْبَى وَالْيَتَامَى وَالْمَسَاكِينِ وَابْنِ السَّبِيلِ إِنْ كُنْتُمْ آمَنْتُمْ بِاللَّهِ وَمَا أَنْزَلْنَا عَلَى عَبْدِنَا يَوْمَ الْفُرْقَانِ يَوْمَ الْتَقَى الْجَمْعَانِ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},"context":"قبلها: قاتلوهم حتى لا تكون فتنة.","reason":"المولى."},{"i":4,"of":7,"s":9,"surah":"التوبة","a":51,"text":"قُلْ لَنْ يُصِيبَنَا إِلَّا مَا كَتَبَ اللَّهُ لَنَا هُوَ مَوْلَانَا وَعَلَى اللَّهِ فَلْيَتَوَكَّلِ الْمُؤْمِنُونَ","prev":{"a":50,"text":"إِنْ تُصِبْكَ حَسَنَةٌ تَسُؤْهُمْ وَإِنْ تُصِبْكَ مُصِيبَةٌ يَقُولُوا قَدْ أَخَذْنَا أَمْرَنَا مِنْ قَبْلُ وَيَتَوَلَّوْا وَهُمْ فَرِحُونَ"},"next":{"a":52,"text":"قُلْ هَلْ تَرَبَّصُونَ بِنَا إِلَّا إِحْدَى الْحُسْنَيَيْنِ وَنَحْنُ نَتَرَبَّصُ بِكُمْ أَنْ يُصِيبَكُمُ اللَّهُ بِعَذَابٍ مِنْ عِنْدِهِ أَوْ بِأَيْدِينَا فَتَرَبَّصُوا إِنَّا مَعَكُمْ مُتَرَبِّصُونَ"},"context":"قبلها: إن تصبك حسنة تسؤهم.","reason":"القدر."},{"i":5,"of":7,"s":22,"surah":"الحج","a":78,"text":"وَجَاهِدُوا فِي اللَّهِ حَقَّ جِهَادِهِ هُوَ اجْتَبَاكُمْ وَمَا جَعَلَ عَلَيْكُمْ فِي الدِّينِ مِنْ حَرَجٍ مِلَّةَ أَبِيكُمْ إِبْرَاهِيمَ هُوَ سَمَّاكُمُ الْمُسْلِمِينَ مِنْ قَبْلُ وَفِي هَذَا لِيَكُونَ الرَّسُولُ شَهِيدًا عَلَيْكُمْ وَتَكُونُوا شُهَدَاءَ عَلَى النَّاسِ فَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ وَاعْتَصِمُوا بِاللَّهِ هُوَ مَوْلَاكُمْ فَنِعْمَ الْمَوْلَى وَنِعْمَ النَّصِيرُ","prev":{"a":77,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا ارْكَعُوا وَاسْجُدُوا وَاعْبُدُوا رَبَّكُمْ وَافْعَلُوا الْخَيْرَ لَعَلَّكُمْ تُفْلِحُونَ"},"context":"قبلها: اركعوا واسجدوا.","reason":"الاجتباء."},{"i":6,"of":7,"s":66,"surah":"التحريم","a":2,"text":"قَدْ فَرَضَ اللَّهُ لَكُمْ تَحِلَّةَ أَيْمَانِكُمْ وَاللَّهُ مَوْلَاكُمْ وَهُوَ الْعَلِيمُ الْحَكِيمُ","prev":{"a":1,"text":"يَا أَيُّهَا النَّبِيُّ لِمَ تُحَرِّمُ مَا أَحَلَّ اللَّهُ لَكَ تَبْتَغِي مَرْضَاتَ أَزْوَاجِكَ وَاللَّهُ غَفُورٌ رَحِيمٌ"},"next":{"a":3,"text":"وَإِذْ أَسَرَّ النَّبِيُّ إِلَى بَعْضِ أَزْوَاجِهِ حَدِيثًا فَلَمَّا نَبَّأَتْ بِهِ وَأَظْهَرَهُ اللَّهُ عَلَيْهِ عَرَّفَ بَعْضَهُ وَأَعْرَضَ عَنْ بَعْضٍ فَلَمَّا نَبَّأَهَا بِهِ قَالَتْ مَنْ أَنْبَأَكَ هَذَا قَالَ نَبَّأَنِيَ الْعَلِيمُ الْخَبِيرُ"},"context":"قبلها: لم تحرم ما أحل الله لك.","reason":"تحلة الأيمان."},{"i":7,"of":7,"s":66,"surah":"التحريم","a":4,"text":"إِنْ تَتُوبَا إِلَى اللَّهِ فَقَدْ صَغَتْ قُلُوبُكُمَا وَإِنْ تَظَاهَرَا عَلَيْهِ فَإِنَّ اللَّهَ هُوَ مَوْلَاهُ وَجِبْرِيلُ وَصَالِحُ الْمُؤْمِنِينَ وَالْمَلَائِكَةُ بَعْدَ ذَلِكَ ظَهِيرٌ","prev":{"a":3,"text":"وَإِذْ أَسَرَّ النَّبِيُّ إِلَى بَعْضِ أَزْوَاجِهِ حَدِيثًا فَلَمَّا نَبَّأَتْ بِهِ وَأَظْهَرَهُ اللَّهُ عَلَيْهِ عَرَّفَ بَعْضَهُ وَأَعْرَضَ عَنْ بَعْضٍ فَلَمَّا نَبَّأَهَا بِهِ قَالَتْ مَنْ أَنْبَأَكَ هَذَا قَالَ نَبَّأَنِيَ الْعَلِيمُ الْخَبِيرُ"},"next":{"a":5,"text":"عَسَى رَبُّهُ إِنْ طَلَّقَكُنَّ أَنْ يُبْدِلَهُ أَزْوَاجًا خَيْرًا مِنْكُنَّ مُسْلِمَاتٍ مُؤْمِنَاتٍ قَانِتَاتٍ تَائِبَاتٍ عَابِدَاتٍ سَائِحَاتٍ ثَيِّبَاتٍ وَأَبْكَارًا"},"context":"قبلها: أسر النبي إلى بعض أزواجه.","reason":"التوبة."}],"hadiths":[],"situations":[{"situationId":3,"verses":[{"i":4,"strength":"direct","bridge":"﴿قُلْ لَنْ يُصِيبَنَا إِلَّا مَا كَتَبَ اللَّهُ لَنَا هُوَ مَوْلَانَا﴾."}],"hadiths":[]},{"situationId":26,"verses":[{"i":1,"strength":"direct","bridge":"﴿رَبَّنَا لَا تُؤَاخِذْنَا إِنْ نَسِينَا أَوْ أَخْطَأْنَا﴾."}],"hadiths":[]},{"situationId":31,"verses":[{"i":3,"strength":"direct","bridge":"﴿فَاعْلَمُوا أَنَّ اللَّهَ مَوْلَاكُمْ نِعْمَ الْمَوْلَى وَنِعْمَ النَّصِيرُ﴾."}],"hadiths":[]},{"situationId":48,"verses":[{"i":7,"strength":"direct","bridge":"﴿إِنْ تَتُوبَا إِلَى اللَّهِ فَقَدْ صَغَتْ قُلُوبُكُمَا﴾."}],"hadiths":[]},{"situationId":61,"verses":[{"i":6,"strength":"direct","bridge":"﴿قَدْ فَرَضَ اللَّهُ لَكُمْ تَحِلَّةَ أَيْمَانِكُمْ﴾."}],"hadiths":[]},{"situationId":98,"verses":[{"i":2,"strength":"direct","bridge":"﴿بَلِ اللَّهُ مَوْلَاكُمْ وَهُوَ خَيْرُ النَّاصِرِينَ﴾."}],"hadiths":[]},{"situationId":161,"verses":[{"i":5,"strength":"direct","bridge":"﴿هُوَ اجْتَبَاكُمْ وَمَا جَعَلَ عَلَيْكُمْ فِي الدِّينِ مِنْ حَرَجٍ﴾."}],"hadiths":[]}]},{"id":416,"name":"بهم رءوف رحيم / بكم لرءوف رحيم","compound":true,"meaning":"رءوف رحيم: تاب على الثلاثة وأهل العسرة.","teaches":"1. توبة النبي والمهاجرين والأنصار.\n2. إنزال الآيات.","whenRecall":"- بعد زيغ القلب.","whenPray":"1. اللهم تب علي.","summary":"التوبة بعد كاد يزيغ.","verses":[{"i":1,"of":2,"s":9,"surah":"التوبة","a":117,"text":"لَقَدْ تَابَ اللَّهُ عَلَى النَّبِيِّ وَالْمُهَاجِرِينَ وَالْأَنْصَارِ الَّذِينَ اتَّبَعُوهُ فِي سَاعَةِ الْعُسْرَةِ مِنْ بَعْدِ مَا كَادَ يَزِيغُ قُلُوبُ فَرِيقٍ مِنْهُمْ ثُمَّ تَابَ عَلَيْهِمْ إِنَّهُ بِهِمْ رَءُوفٌ رَحِيمٌ","prev":{"a":116,"text":"إِنَّ اللَّهَ لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ يُحْيِي وَيُمِيتُ وَمَا لَكُمْ مِنْ دُونِ اللَّهِ مِنْ وَلِيٍّ وَلَا نَصِيرٍ"},"next":{"a":118,"text":"وَعَلَى الثَّلَاثَةِ الَّذِينَ خُلِّفُوا حَتَّى إِذَا ضَاقَتْ عَلَيْهِمُ الْأَرْضُ بِمَا رَحُبَتْ وَضَاقَتْ عَلَيْهِمْ أَنْفُسُهُمْ وَظَنُّوا أَنْ لَا مَلْجَأَ مِنَ اللَّهِ إِلَّا إِلَيْهِ ثُمَّ تَابَ عَلَيْهِمْ لِيَتُوبُوا إِنَّ اللَّهَ هُوَ التَّوَّابُ الرَّحِيمُ"},"context":"قبلها: له ملك السماوات.","reason":"ساعة العسرة."},{"i":2,"of":2,"s":57,"surah":"الحديد","a":9,"text":"هُوَ الَّذِي يُنَزِّلُ عَلَى عَبْدِهِ آيَاتٍ بَيِّنَاتٍ لِيُخْرِجَكُمْ مِنَ الظُّلُمَاتِ إِلَى النُّورِ وَإِنَّ اللَّهَ بِكُمْ لَرَءُوفٌ رَحِيمٌ","prev":{"a":8,"text":"وَمَا لَكُمْ لَا تُؤْمِنُونَ بِاللَّهِ وَالرَّسُولُ يَدْعُوكُمْ لِتُؤْمِنُوا بِرَبِّكُمْ وَقَدْ أَخَذَ مِيثَاقَكُمْ إِنْ كُنْتُمْ مُؤْمِنِينَ"},"next":{"a":10,"text":"وَمَا لَكُمْ أَلَّا تُنْفِقُوا فِي سَبِيلِ اللَّهِ وَلِلَّهِ مِيرَاثُ السَّمَاوَاتِ وَالْأَرْضِ لَا يَسْتَوِي مِنْكُمْ مَنْ أَنْفَقَ مِنْ قَبْلِ الْفَتْحِ وَقَاتَلَ أُولَئِكَ أَعْظَمُ دَرَجَةً مِنَ الَّذِينَ أَنْفَقُوا مِنْ بَعْدُ وَقَاتَلُوا وَكُلًّا وَعَدَ اللَّهُ الْحُسْنَى وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ"},"context":"قبلها: ما لكم لا تؤمنون.","reason":"الآيات."}],"hadiths":[],"situations":[{"situationId":114,"verses":[{"i":1,"strength":"direct","bridge":"﴿مِنْ بَعْدِ مَا كَادَ يَزِيغُ قُلُوبُ فَرِيقٍ مِنْهُمْ﴾."}],"hadiths":[]},{"situationId":116,"verses":[{"i":2,"strength":"direct","bridge":"﴿هُوَ الَّذِي يُنَزِّلُ عَلَى عَبْدِهِ آيَاتٍ بَيِّنَاتٍ لِيُخْرِجَكُمْ مِنَ الظُّلُمَاتِ إِلَى النُّورِ﴾."}],"hadiths":[]}]},{"id":417,"name":"غني عنكم","compound":true,"meaning":"غني عنكم: لا يرضى الكفر، ويرضى الشكر.","teaches":"1. لا تزر وازرة وزر أخرى.","whenRecall":"- حين تظن أن كفرك يضر الله.","whenPray":"1. اللهم أعني على شكرك.","summary":"الشكر يرضيه.","verses":[{"i":1,"of":1,"s":39,"surah":"الزمر","a":7,"text":"إِنْ تَكْفُرُوا فَإِنَّ اللَّهَ غَنِيٌّ عَنْكُمْ وَلَا يَرْضَى لِعِبَادِهِ الْكُفْرَ وَإِنْ تَشْكُرُوا يَرْضَهُ لَكُمْ وَلَا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَى ثُمَّ إِلَى رَبِّكُمْ مَرْجِعُكُمْ فَيُنَبِّئُكُمْ بِمَا كُنْتُمْ تَعْمَلُونَ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ","prev":{"a":6,"text":"خَلَقَكُمْ مِنْ نَفْسٍ وَاحِدَةٍ ثُمَّ جَعَلَ مِنْهَا زَوْجَهَا وَأَنْزَلَ لَكُمْ مِنَ الْأَنْعَامِ ثَمَانِيَةَ أَزْوَاجٍ يَخْلُقُكُمْ فِي بُطُونِ أُمَّهَاتِكُمْ خَلْقًا مِنْ بَعْدِ خَلْقٍ فِي ظُلُمَاتٍ ثَلَاثٍ ذَلِكُمُ اللَّهُ رَبُّكُمْ لَهُ الْمُلْكُ لَا إِلَهَ إِلَّا هُوَ فَأَنَّى تُصْرَفُونَ"},"next":{"a":8,"text":"وَإِذَا مَسَّ الْإِنْسَانَ ضُرٌّ دَعَا رَبَّهُ مُنِيبًا إِلَيْهِ ثُمَّ إِذَا خَوَّلَهُ نِعْمَةً مِنْهُ نَسِيَ مَا كَانَ يَدْعُو إِلَيْهِ مِنْ قَبْلُ وَجَعَلَ لِلَّهِ أَنْدَادًا لِيُضِلَّ عَنْ سَبِيلِهِ قُلْ تَمَتَّعْ بِكُفْرِكَ قَلِيلًا إِنَّكَ مِنْ أَصْحَابِ النَّارِ"},"context":"قبلها: خلقكم من نفس واحدة.","reason":"الغنى."}],"hadiths":[],"situations":[{"situationId":144,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَإِنْ تَشْكُرُوا يَرْضَهُ لَكُمْ﴾."}],"hadiths":[]}]},{"id":418,"name":"وهو خادعهم","compound":true,"meaning":"وهو خادعهم: يجازي المنافقين على خداعهم.","teaches":"1. يقومون إلى الصلاة كسالى.","whenRecall":"- حين تكسل في الصلاة.","whenPray":"1. اللهم أعني على ذكرك.","summary":"كسل الصلاة علامة.","verses":[{"i":1,"of":1,"s":4,"surah":"النساء","a":142,"text":"إِنَّ الْمُنَافِقِينَ يُخَادِعُونَ اللَّهَ وَهُوَ خَادِعُهُمْ وَإِذَا قَامُوا إِلَى الصَّلَاةِ قَامُوا كُسَالَى يُرَاءُونَ النَّاسَ وَلَا يَذْكُرُونَ اللَّهَ إِلَّا قَلِيلًا","prev":{"a":141,"text":"الَّذِينَ يَتَرَبَّصُونَ بِكُمْ فَإِنْ كَانَ لَكُمْ فَتْحٌ مِنَ اللَّهِ قَالُوا أَلَمْ نَكُنْ مَعَكُمْ وَإِنْ كَانَ لِلْكَافِرِينَ نَصِيبٌ قَالُوا أَلَمْ نَسْتَحْوِذْ عَلَيْكُمْ وَنَمْنَعْكُمْ مِنَ الْمُؤْمِنِينَ فَاللَّهُ يَحْكُمُ بَيْنَكُمْ يَوْمَ الْقِيَامَةِ وَلَنْ يَجْعَلَ اللَّهُ لِلْكَافِرِينَ عَلَى الْمُؤْمِنِينَ سَبِيلًا"},"next":{"a":143,"text":"مُذَبْذَبِينَ بَيْنَ ذَلِكَ لَا إِلَى هَؤُلَاءِ وَلَا إِلَى هَؤُلَاءِ وَمَنْ يُضْلِلِ اللَّهُ فَلَنْ تَجِدَ لَهُ سَبِيلًا"},"context":"قبلها: يتربصون بكم.","reason":"الخداع."}],"hadiths":[],"situations":[{"situationId":77,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَإِذَا قَامُوا إِلَى الصَّلَاةِ قَامُوا كُسَالَى﴾."}],"hadiths":[]}]},{"id":419,"name":"إني جاعل في الأرض خليفة","compound":true,"meaning":"إني جاعل في الأرض خليفة: استخلاف الإنسان.","teaches":"1. سؤال الملائكة.","whenRecall":"- حين تسأل عن غاية الحياة.","whenPray":"1. اللهم اجعلني خليفة صالحًا.","summary":"أنت خليفة؛ فاعمر.","verses":[{"i":1,"of":1,"s":2,"surah":"البقرة","a":30,"text":"وَإِذْ قَالَ رَبُّكَ لِلْمَلَائِكَةِ إِنِّي جَاعِلٌ فِي الْأَرْضِ خَلِيفَةً قَالُوا أَتَجْعَلُ فِيهَا مَنْ يُفْسِدُ فِيهَا وَيَسْفِكُ الدِّمَاءَ وَنَحْنُ نُسَبِّحُ بِحَمْدِكَ وَنُقَدِّسُ لَكَ قَالَ إِنِّي أَعْلَمُ مَا لَا تَعْلَمُونَ","prev":{"a":29,"text":"هُوَ الَّذِي خَلَقَ لَكُمْ مَا فِي الْأَرْضِ جَمِيعًا ثُمَّ اسْتَوَى إِلَى السَّمَاءِ فَسَوَّاهُنَّ سَبْعَ سَمَاوَاتٍ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ"},"next":{"a":31,"text":"وَعَلَّمَ آدَمَ الْأَسْمَاءَ كُلَّهَا ثُمَّ عَرَضَهُمْ عَلَى الْمَلَائِكَةِ فَقَالَ أَنْبِئُونِي بِأَسْمَاءِ هَؤُلَاءِ إِنْ كُنْتُمْ صَادِقِينَ"},"context":"قبلها: خلق لكم ما في الأرض جميعًا.","reason":"الاستخلاف."}],"hadiths":[{"i":1,"of":1,"text":"عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهُما، قالَ: لقد أَخْرَجَ اللهُ آدمَ مِنَ الجنَّةِ قبلَ أنْ يَدخُلَها أَحَدٌ، قالَ اللهُ تَعالَى: {إِنِّي جَاعِلٌ فِي الْأَرْضِ خَلِيفَةً قَالُوا أَتَجْعَلُ فِيهَا مَنْ يُفْسِدُ فِيهَا وَيَسْفِكُ الدِّمَاءَ} [البقرة: 30]. وقد كان فيها قبلَ أنْ يُخلَقَ بألْفَيْ عامٍ الجِنُّ بنو الجانِّ، فأَفْسَدوا في الأرضِ، وسَفَكوا الدِّماءَ، فلمَّا قالَ اللهُ تَعالَى: {إِنِّي جَاعِلٌ فِي الْأَرْضِ خَلِيفَةً قَالُوا أَتَجْعَلُ فِيهَا مَنْ يُفْسِدُ فِيهَا وَيَسْفِكُ الدِّمَاءَ} [البقرة: 30]، يَعنونَ الجِنَّ بني الجانِّ، فلمَّا أَفْسَدوا في الأرضِ بَعَثَ عليهم جُنودًا مِنَ الملائكةِ، فضَرَبوهم حتَّى أَلْحَقوهم بجزائرِ البُحورِ. قالَ: فقالتِ الملائكةُ: أتجْعلُ فيها من يُفسِدُ فيها كما فَعَلَ أولئك الجِنُّ بنو الجانِّ؟ قالَ: فقالَ اللهُ: {إِنِّي أَعْلَمُ مَا لَا تَعْلَمُونَ} [البقرة: 30].","narrator":"مجاهد","source":"المستدرك على الصحيحين 3076","grade":"صحيح","judgment":"صحيح الإسناد","url":"https://dorar.net/h/cyRiGYtV","nameForm":"إني جاعل في الأرض خليفة"}],"sunnah":{},"situations":[{"situationId":181,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَإِذْ قَالَ رَبُّكَ لِلْمَلَائِكَةِ إِنِّي جَاعِلٌ فِي الْأَرْضِ خَلِيفَةً﴾."}],"hadiths":[]}]},{"id":420,"name":"إني جاعلك للناس إمامًا","compound":true,"meaning":"إني جاعلك للناس إمامًا: الإمامة بعد الابتلاء.","teaches":"1. لا ينال عهدي الظالمين.","whenRecall":"- حين تُبتلى.","whenPray":"1. واجعلنا للمتقين إمامًا.","summary":"الإمامة بعد إتمام الابتلاء.","verses":[{"i":1,"of":1,"s":2,"surah":"البقرة","a":124,"text":"وَإِذِ ابْتَلَى إِبْرَاهِيمَ رَبُّهُ بِكَلِمَاتٍ فَأَتَمَّهُنَّ قَالَ إِنِّي جَاعِلُكَ لِلنَّاسِ إِمَامًا قَالَ وَمِنْ ذُرِّيَّتِي قَالَ لَا يَنَالُ عَهْدِي الظَّالِمِينَ","prev":{"a":123,"text":"وَاتَّقُوا يَوْمًا لَا تَجْزِي نَفْسٌ عَنْ نَفْسٍ شَيْئًا وَلَا يُقْبَلُ مِنْهَا عَدْلٌ وَلَا تَنْفَعُهَا شَفَاعَةٌ وَلَا هُمْ يُنْصَرُونَ"},"next":{"a":125,"text":"وَإِذْ جَعَلْنَا الْبَيْتَ مَثَابَةً لِلنَّاسِ وَأَمْنًا وَاتَّخِذُوا مِنْ مَقَامِ إِبْرَاهِيمَ مُصَلًّى وَعَهِدْنَا إِلَى إِبْرَاهِيمَ وَإِسْمَاعِيلَ أَنْ طَهِّرَا بَيْتِيَ لِلطَّائِفِينَ وَالْعَاكِفِينَ وَالرُّكَّعِ السُّجُودِ"},"context":"قبلها: اتقوا يومًا.","reason":"الابتلاء ثم الإمامة."}],"hadiths":[],"situations":[{"situationId":118,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَإِذِ ابْتَلَى إِبْرَاهِيمَ رَبُّهُ بِكَلِمَاتٍ فَأَتَمَّهُنَّ﴾."}],"hadiths":[]}]},{"id":421,"name":"إني خالق بشرًا من صلصال من حمإ مسنون / من طين","compound":true,"meaning":"إني خالق بشرًا: خلق آدم من طين.","teaches":"1. أصل الإنسان التراب.","whenRecall":"- حين يتكبر الإنسان.","whenPray":"1. سبحان الخالق.","summary":"أصلك طين؛ فلا تتكبر.","verses":[{"i":1,"of":2,"s":15,"surah":"الحجر","a":28,"text":"وَإِذْ قَالَ رَبُّكَ لِلْمَلَائِكَةِ إِنِّي خَالِقٌ بَشَرًا مِنْ صَلْصَالٍ مِنْ حَمَإٍ مَسْنُونٍ","prev":{"a":27,"text":"وَالْجَانَّ خَلَقْنَاهُ مِنْ قَبْلُ مِنْ نَارِ السَّمُومِ"},"next":{"a":29,"text":"فَإِذَا سَوَّيْتُهُ وَنَفَخْتُ فِيهِ مِنْ رُوحِي فَقَعُوا لَهُ سَاجِدِينَ"},"context":"قبلها: الجان خلقناه من نار السموم.","reason":"الخلق."},{"i":2,"of":2,"s":38,"surah":"ص","a":71,"text":"إِذْ قَالَ رَبُّكَ لِلْمَلَائِكَةِ إِنِّي خَالِقٌ بَشَرًا مِنْ طِينٍ","prev":{"a":70,"text":"إِنْ يُوحَى إِلَيَّ إِلَّا أَنَّمَا أَنَا نَذِيرٌ مُبِينٌ"},"next":{"a":72,"text":"فَإِذَا سَوَّيْتُهُ وَنَفَخْتُ فِيهِ مِنْ رُوحِي فَقَعُوا لَهُ سَاجِدِينَ"},"context":"قبلها: إن يوحى إلي إلا أنما أنا نذير.","reason":"الخلق."}],"hadiths":[],"situations":[{"situationId":83,"verses":[{"i":1,"strength":"direct","bridge":"﴿إِنِّي خَالِقٌ بَشَرًا مِنْ صَلْصَالٍ مِنْ حَمَإٍ مَسْنُونٍ﴾."}],"hadiths":[]},{"situationId":178,"verses":[{"i":2,"strength":"direct","bridge":"﴿إِنِّي خَالِقٌ بَشَرًا مِنْ طِينٍ﴾."}],"hadiths":[]}]},{"id":422,"name":"مبتليكم بنهر","compound":true,"meaning":"مبتليكم بنهر: ابتلاء الصبر عن الشهوة.","teaches":"1. جيش طالوت.","whenRecall":"- حين تُختبر بشهوة قريبة.","whenPray":"1. اللهم أعني على الصبر.","summary":"من صبر عن النهر عبر.","verses":[{"i":1,"of":1,"s":2,"surah":"البقرة","a":249,"text":"فَلَمَّا فَصَلَ طَالُوتُ بِالْجُنُودِ قَالَ إِنَّ اللَّهَ مُبْتَلِيكُمْ بِنَهَرٍ فَمَنْ شَرِبَ مِنْهُ فَلَيْسَ مِنِّي وَمَنْ لَمْ يَطْعَمْهُ فَإِنَّهُ مِنِّي إِلَّا مَنِ اغْتَرَفَ غُرْفَةً بِيَدِهِ فَشَرِبُوا مِنْهُ إِلَّا قَلِيلًا مِنْهُمْ فَلَمَّا جَاوَزَهُ هُوَ وَالَّذِينَ آمَنُوا مَعَهُ قَالُوا لَا طَاقَةَ لَنَا الْيَوْمَ بِجَالُوتَ وَجُنُودِهِ قَالَ الَّذِينَ يَظُنُّونَ أَنَّهُمْ مُلَاقُو اللَّهِ كَمْ مِنْ فِئَةٍ قَلِيلَةٍ غَلَبَتْ فِئَةً كَثِيرَةً بِإِذْنِ اللَّهِ وَاللَّهُ مَعَ الصَّابِرِينَ","prev":{"a":248,"text":"وَقَالَ لَهُمْ نَبِيُّهُمْ إِنَّ آيَةَ مُلْكِهِ أَنْ يَأْتِيَكُمُ التَّابُوتُ فِيهِ سَكِينَةٌ مِنْ رَبِّكُمْ وَبَقِيَّةٌ مِمَّا تَرَكَ آلُ مُوسَى وَآلُ هَارُونَ تَحْمِلُهُ الْمَلَائِكَةُ إِنَّ فِي ذَلِكَ لَآيَةً لَكُمْ إِنْ كُنْتُمْ مُؤْمِنِينَ"},"next":{"a":250,"text":"وَلَمَّا بَرَزُوا لِجَالُوتَ وَجُنُودِهِ قَالُوا رَبَّنَا أَفْرِغْ عَلَيْنَا صَبْرًا وَثَبِّتْ أَقْدَامَنَا وَانْصُرْنَا عَلَى الْقَوْمِ الْكَافِرِينَ"},"context":"قبلها: آية ملكه.","reason":"الابتلاء بالنهر."}],"hadiths":[],"situations":[{"situationId":74,"verses":[{"i":1,"strength":"direct","bridge":"﴿إِنَّ اللَّهَ مُبْتَلِيكُمْ بِنَهَرٍ﴾."}],"hadiths":[]}]},{"id":423,"name":"أني ممدكم بألف من الملائكة مردفين","compound":true,"meaning":"ممدكم بألف من الملائكة: استجابة الاستغاثة يوم بدر.","teaches":"1. تستغيثون ربكم فاستجاب.","whenRecall":"- حين تستغيث.","whenPray":"1. يا غياث المستغيثين.","summary":"الاستغاثة تستجاب.","verses":[{"i":1,"of":1,"s":8,"surah":"الأنفال","a":9,"text":"إِذْ تَسْتَغِيثُونَ رَبَّكُمْ فَاسْتَجَابَ لَكُمْ أَنِّي مُمِدُّكُمْ بِأَلْفٍ مِنَ الْمَلَائِكَةِ مُرْدِفِينَ","prev":{"a":8,"text":"لِيُحِقَّ الْحَقَّ وَيُبْطِلَ الْبَاطِلَ وَلَوْ كَرِهَ الْمُجْرِمُونَ"},"next":{"a":10,"text":"وَمَا جَعَلَهُ اللَّهُ إِلَّا بُشْرَى وَلِتَطْمَئِنَّ بِهِ قُلُوبُكُمْ وَمَا النَّصْرُ إِلَّا مِنْ عِنْدِ اللَّهِ إِنَّ اللَّهَ عَزِيزٌ حَكِيمٌ"},"context":"قبلها: ليحق الحق.","reason":"الاستغاثة."}],"hadiths":[{"i":1,"of":1,"text":"حدَّثني عمرُ بنُ الخطَّابِ رَضِيَ اللهُ عنه، قال: لمَّا كان يومُ بَدْرٍ، قال: نظر النبيُّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ إلى أصحابِهِ وهُمْ ثلاثُ مئةٍ ونَيِّفٌ، ونظر إلى المشركينَ فإذا هُمْ ألفٌ وزيادةٌ، فاستقبَلَ النبيُّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ القِبلةَ، ثم مَدَّ يديْهِ وعليه رِداؤُهُ وإزارُهُ، ثم قال: اللَّهمَّ أينَ ما وَعَدْتَني؟ اللَّهمَّ أَنْجِزْ لي ما وَعَدْتَني، اللَّهمَّ إنَّكَ إنْ تُهلِكْ هذهِ العِصابةَ مِن أهلِ الإسلامِ، فلا تُعْبَدُ في الأرضِ أبدًا، قال: فما زال يَستَغيثُ ربَّهُ عزَّ وجلَّ ويَدْعوه حتى سَقَطَ رِداؤُهُ، فأتاهُ أبو بكرٍ رَضِيَ اللهُ عنه، فأخذ رِداءَهُ فرَدَّاهُ، ثم الْتَزَمَهُ مِن وَرائِهِ، ثم قال: يا نَبيَّ اللهِ، كَفاكَ مُناشَدَتُكَ ربَّكَ؛ فإنَّهُ سيُنْجِزُ لكَ ما وَعَدَكَ، وأنزل اللهُ عزَّ وجلَّ: {إِذْ تَسْتَغِيثُونَ رَبَّكُمْ فَاسْتَجَابَ لَكُمْ أَنِّي مُمِدُّكُمْ بِأَلْفٍ مِنَ الْمَلَائِكَةِ مُرْدِفِينَ} [الأنفال: 9]، فلمَّا كان يومئذٍ والْتَقَوْا، فهزم اللهُ عزَّ وجلَّ المشركينَ، فقُتِلَ مِنهُم سبعونَ رجُلًا، وأُسِرَ منهم سبعونَ رجُلًا، فاستشار رسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ أبا بكرٍ وعليًّا وعُمرَ رَضِيَ اللهُ عنهم، فقال أبو بكرٍ رَضِيَ اللهُ عنه: يا رسولَ اللهِ، هؤلاءِ بَنو العَمِّ والعشيرةِ والإخوانِ؛ فإنِّي أرى أنْ تأخُذَ منهُمُ الفِديةَ، فيكونَ ما أخَذْنا منهم قُوَّةً لنا على الكُفَّارِ، وعسى اللهُ أنْ يَهديَهم؛ فيكونوا لنا عَضُدًا، فقال رسولُ اللهِ صلَّى اللهُ عليه وعلى آلِهِ وسلَّمَ: ما ترى يا بنَ الخطَّابِ؟ قلتُ: واللهِ، ما أرى ما رأى أبو بكرٍ، ولكنِّي أرى أنْ تُمَكِّنَني مِن فُلانٍ -قريبًا لعُمرَ- فأضرِبَ عُنُقَهُ، وتُمَكِّنَ عليًّا رَضِيَ اللهُ عنه مِن عَقيلٍ فيضرِبَ عُنُقَهُ، وتُمَكِّنَ حمزةَ مِن فُلانٍ أخيه فيضرِبَ عُنُقَهُ؛ حتى يعلَمَ اللهُ أنَّه ليستْ في قُلوبِنا هَوادَةٌ للمشركينَ، هؤلاءِ صَناديدُهم وأئمَّتُهم وقادتُهم، فهَوِيَ رسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ ما قال أبو بكرٍ رَضِيَ اللهُ عنه، ولم يَهْوَ ما قلتُ؛ فأخَذَ مِنهُمُ الفِداءَ، فلمَّا أنْ كان مِنَ الغَدِ قال عمرُ رَضِيَ اللهُ عنه: غَدَوْتُ إلى رسولِ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، فإذا هو قاعدٌ وأبو بكرٍ رَضِيَ اللهُ عنه، وإذا هما يبكيانِ، فقلتُ: يا رسولَ اللهِ، أَخبِرْني ماذا يُبكيكَ أنتَ وصاحبَكَ، فإنْ وجدْتُ بُكاءً بكيْتُ، وإنْ لم أجِدْ تَباكَيْتُ لبكائِكما، قال: فقال النبيُّ صلَّى اللهُ عليه وعلى آلِهِ وسلَّمَ: الذي عَرَضَ عليَّ أَصحابُكَ مِنَ الفِداءِ، لقد عُرِضَ عليَّ عذابُهم أَدْنَى مِن هذهِ الشَّجرةِ -لشجرةٍ قريبةٍ-، وأنزل اللهُ عزَّ وجلَّ: {مَا كَانَ لِنَبِيٍّ أَنْ يَكونَ لَهُ أَسْرَى حَتَّى يُثْخِنَ فِي الْأَرْضِ} [الأنفال: 67] إلى قولِهِ: {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ لَمَسَّكُمْ فِيمَا أَخَذْتُمْ} [الأنفال: 68] مِنَ الفِداءِ، ثُمَّ أحَلَّ اللهُ لهُمُ الغنائِمَ، فلمَّا كان يومُ أُحُدٍ مِنَ العامِ المُقْبِلِ عُوقِبوا بما صنَعوا يومَ بَدْرٍ مِن أَخْذِهِمُ الفِداءَ، فقُتِلَ مِنهُم سبعونَ، وفَرَّ أصحابُ النبيِّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ عَنِ النبيِّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، وكُسِرَتْ رَباعِيَتُهُ، وهُشِّمَتِ البَيْضةُ على رأسِهِ، وسال الدَّمُ على وجهِهِ، وأنزل اللهُ عزَّ وجلَّ: {أَوَلَمَّا أَصَابَتْكُمْ مُصِيبَةٌ قَدْ أَصَبْتُمْ مِثْلَيْهَا} [آل عمران: 165] بأخْذِكُمُ الفِداءَ.","narrator":"عمر بن الخطاب","source":"صحيح أسباب النزول 61","grade":"صحيح","judgment":"رجاله رجال الصحيح","url":"https://dorar.net/h/FGoysDoa","nameForm":"أني ممدكم بألف من الملائكة مردفين"}],"sunnah":{},"situations":[{"situationId":147,"verses":[{"i":1,"strength":"direct","bridge":"﴿إِذْ تَسْتَغِيثُونَ رَبَّكُمْ فَاسْتَجَابَ لَكُمْ﴾."}],"hadiths":[]}]},{"id":424,"name":"لرادك إلى معاد","compound":true,"meaning":"لرادك إلى معاد: وعد بالرجوع.","teaches":"1. نزلت في طريق الهجرة.","whenRecall":"- حين تغترب.","whenPray":"1. اللهم ردني.","summary":"الذي فرض عليك القرآن سيردك.","verses":[{"i":1,"of":1,"s":28,"surah":"القصص","a":85,"text":"إِنَّ الَّذِي فَرَضَ عَلَيْكَ الْقُرْآنَ لَرَادُّكَ إِلَى مَعَادٍ قُلْ رَبِّي أَعْلَمُ مَنْ جَاءَ بِالْهُدَى وَمَنْ هُوَ فِي ضَلَالٍ مُبِينٍ","prev":{"a":84,"text":"مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ خَيْرٌ مِنْهَا وَمَنْ جَاءَ بِالسَّيِّئَةِ فَلَا يُجْزَى الَّذِينَ عَمِلُوا السَّيِّئَاتِ إِلَّا مَا كَانُوا يَعْمَلُونَ"},"next":{"a":86,"text":"وَمَا كُنْتَ تَرْجُو أَنْ يُلْقَى إِلَيْكَ الْكِتَابُ إِلَّا رَحْمَةً مِنْ رَبِّكَ فَلَا تَكُونَنَّ ظَهِيرًا لِلْكَافِرِينَ"},"context":"قبلها: من جاء بالحسنة.","reason":"الوعد."}],"hadiths":[{"i":1,"of":1,"text":"عَنِ ابنِ عَبَّاسٍ: {لَرادُّكَ إلى مَعادٍ} [القصص: 85] قال: إلى مَكَّةَ.","narrator":"عكرمة مولى ابن عباس","source":"صحيح البخاري 4773","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/oRVPWs7o","nameForm":"لرادك إلى معاد"}],"sunnah":{},"situations":[{"situationId":9,"verses":[{"i":1,"strength":"direct","bridge":"﴿إِنَّ الَّذِي فَرَضَ عَلَيْكَ الْقُرْآنَ لَرَادُّكَ إِلَى مَعَادٍ﴾."}],"hadiths":[]}]},{"id":425,"name":"إني منزلها عليكم","compound":true,"meaning":"إني منزلها عليكم: نزول المائدة مع الوعيد.","teaches":"1. طلب الحواريين.","whenRecall":"- حين تطلب آية.","whenPray":"1. اللهم لا تجعلني ممن يكفر بعد الآية.","summary":"الآية تزيد المسؤولية.","verses":[{"i":1,"of":1,"s":5,"surah":"المائدة","a":115,"text":"قَالَ اللَّهُ إِنِّي مُنَزِّلُهَا عَلَيْكُمْ فَمَنْ يَكْفُرْ بَعْدُ مِنْكُمْ فَإِنِّي أُعَذِّبُهُ عَذَابًا لَا أُعَذِّبُهُ أَحَدًا مِنَ الْعَالَمِينَ","prev":{"a":114,"text":"قَالَ عِيسَى ابْنُ مَرْيَمَ اللَّهُمَّ رَبَّنَا أَنْزِلْ عَلَيْنَا مَائِدَةً مِنَ السَّمَاءِ تَكُونُ لَنَا عِيدًا لِأَوَّلِنَا وَآخِرِنَا وَآيَةً مِنْكَ وَارْزُقْنَا وَأَنْتَ خَيْرُ الرَّازِقِينَ"},"next":{"a":116,"text":"وَإِذْ قَالَ اللَّهُ يَا عِيسَى ابْنَ مَرْيَمَ أَأَنْتَ قُلْتَ لِلنَّاسِ اتَّخِذُونِي وَأُمِّيَ إِلَهَيْنِ مِنْ دُونِ اللَّهِ قَالَ سُبْحَانَكَ مَا يَكُونُ لِي أَنْ أَقُولَ مَا لَيْسَ لِي بِحَقٍّ إِنْ كُنْتُ قُلْتُهُ فَقَدْ عَلِمْتَهُ تَعْلَمُ مَا فِي نَفْسِي وَلَا أَعْلَمُ مَا فِي نَفْسِكَ إِنَّكَ أَنْتَ عَلَّامُ الْغُيُوبِ"},"context":"قبلها: اللهم ربنا أنزل علينا مائدة.","reason":"الوعيد."}],"hadiths":[],"situations":[{"situationId":112,"verses":[{"i":1,"strength":"direct","bridge":"﴿فَمَنْ يَكْفُرْ بَعْدُ مِنْكُمْ فَإِنِّي أُعَذِّبُهُ عَذَابًا﴾."}],"hadiths":[]}]},{"id":426,"name":"الله مهلكهم أو معذبهم عذابًا شديدًا","compound":true,"meaning":"قولٌ لأمة يئست من الوعظ.","teaches":"1. أصحاب السبت.\n2. معذرة إلى ربكم.","whenRecall":"- حين تيأس من الإصلاح.","whenPray":"1. اللهم اجعلني من الناهين عن المنكر.","summary":"الوعظ معذرة ولعلهم يتقون.","verses":[{"i":1,"of":1,"s":7,"surah":"الأعراف","a":164,"text":"وَإِذْ قَالَتْ أُمَّةٌ مِنْهُمْ لِمَ تَعِظُونَ قَوْمًا اللَّهُ مُهْلِكُهُمْ أَوْ مُعَذِّبُهُمْ عَذَابًا شَدِيدًا قَالُوا مَعْذِرَةً إِلَى رَبِّكُمْ وَلَعَلَّهُمْ يَتَّقُونَ","prev":{"a":163,"text":"وَاسْأَلْهُمْ عَنِ الْقَرْيَةِ الَّتِي كَانَتْ حَاضِرَةَ الْبَحْرِ إِذْ يَعْدُونَ فِي السَّبْتِ إِذْ تَأْتِيهِمْ حِيتَانُهُمْ يَوْمَ سَبْتِهِمْ شُرَّعًا وَيَوْمَ لَا يَسْبِتُونَ لَا تَأْتِيهِمْ كَذَلِكَ نَبْلُوهُمْ بِمَا كَانُوا يَفْسُقُونَ"},"next":{"a":165,"text":"فَلَمَّا نَسُوا مَا ذُكِّرُوا بِهِ أَنْجَيْنَا الَّذِينَ يَنْهَوْنَ عَنِ السُّوءِ وَأَخَذْنَا الَّذِينَ ظَلَمُوا بِعَذَابٍ بَئِيسٍ بِمَا كَانُوا يَفْسُقُونَ"},"context":"قبلها: القرية حاضرة البحر.","reason":"الوعظ."}],"hadiths":[],"situations":[{"situationId":137,"verses":[{"i":1,"strength":"direct","bridge":"﴿قَالُوا مَعْذِرَةً إِلَى رَبِّكُمْ وَلَعَلَّهُمْ يَتَّقُونَ﴾."}],"hadiths":[]}]},{"id":427,"name":"الله أولى بهما","compound":true,"meaning":"فالله أولى بهما: لا تميلوا لغني أو فقير.","teaches":"1. الشهادة بالقسط.","whenRecall":"- حين تشهد لقريب.","whenPray":"1. اللهم اجعلني قوامًا بالقسط.","summary":"الله أولى بالغني والفقير منك.","verses":[{"i":1,"of":1,"s":4,"surah":"النساء","a":135,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا كُونُوا قَوَّامِينَ بِالْقِسْطِ شُهَدَاءَ لِلَّهِ وَلَوْ عَلَى أَنْفُسِكُمْ أَوِ الْوَالِدَيْنِ وَالْأَقْرَبِينَ إِنْ يَكُنْ غَنِيًّا أَوْ فَقِيرًا فَاللَّهُ أَوْلَى بِهِمَا فَلَا تَتَّبِعُوا الْهَوَى أَنْ تَعْدِلُوا وَإِنْ تَلْوُوا أَوْ تُعْرِضُوا فَإِنَّ اللَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًا","prev":{"a":134,"text":"مَنْ كَانَ يُرِيدُ ثَوَابَ الدُّنْيَا فَعِنْدَ اللَّهِ ثَوَابُ الدُّنْيَا وَالْآخِرَةِ وَكَانَ اللَّهُ سَمِيعًا بَصِيرًا"},"next":{"a":136,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا آمِنُوا بِاللَّهِ وَرَسُولِهِ وَالْكِتَابِ الَّذِي نَزَّلَ عَلَى رَسُولِهِ وَالْكِتَابِ الَّذِي أَنْزَلَ مِنْ قَبْلُ وَمَنْ يَكْفُرْ بِاللَّهِ وَمَلَائِكَتِهِ وَكُتُبِهِ وَرُسُلِهِ وَالْيَوْمِ الْآخِرِ فَقَدْ ضَلَّ ضَلَالًا بَعِيدًا"},"context":"قبلها: من كان يريد ثواب الدنيا.","reason":"الشهادة."}],"hadiths":[],"situations":[{"situationId":63,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَلَوْ عَلَى أَنْفُسِكُمْ أَوِ الْوَالِدَيْنِ وَالْأَقْرَبِينَ﴾."}],"hadiths":[]}]},{"id":428,"name":"شهيد بيني وبينكم / كفى به شهيدًا بيني وبينكم","compound":true,"meaning":"شهيد بيني وبينكم: أكبر الشهادات.","teaches":"1. أي شيء أكبر شهادة؟\n2. ردٌّ على الافتراء.","whenRecall":"- حين تُكذب.","whenPray":"1. الله شهيد.","summary":"شهادة الله أكبر.","verses":[{"i":1,"of":2,"s":6,"surah":"الأنعام","a":19,"text":"قُلْ أَيُّ شَيْءٍ أَكْبَرُ شَهَادَةً قُلِ اللَّهُ شَهِيدٌ بَيْنِي وَبَيْنَكُمْ وَأُوحِيَ إِلَيَّ هَذَا الْقُرْآنُ لِأُنْذِرَكُمْ بِهِ وَمَنْ بَلَغَ أَئِنَّكُمْ لَتَشْهَدُونَ أَنَّ مَعَ اللَّهِ آلِهَةً أُخْرَى قُلْ لَا أَشْهَدُ قُلْ إِنَّمَا هُوَ إِلَهٌ وَاحِدٌ وَإِنَّنِي بَرِيءٌ مِمَّا تُشْرِكُونَ","prev":{"a":18,"text":"وَهُوَ الْقَاهِرُ فَوْقَ عِبَادِهِ وَهُوَ الْحَكِيمُ الْخَبِيرُ"},"next":{"a":20,"text":"الَّذِينَ آتَيْنَاهُمُ الْكِتَابَ يَعْرِفُونَهُ كَمَا يَعْرِفُونَ أَبْنَاءَهُمُ الَّذِينَ خَسِرُوا أَنْفُسَهُمْ فَهُمْ لَا يُؤْمِنُونَ"},"context":"قبلها: القاهر فوق عباده.","reason":"أكبر شهادة."},{"i":2,"of":2,"s":46,"surah":"الأحقاف","a":8,"text":"أَمْ يَقُولُونَ افْتَرَاهُ قُلْ إِنِ افْتَرَيْتُهُ فَلَا تَمْلِكُونَ لِي مِنَ اللَّهِ شَيْئًا هُوَ أَعْلَمُ بِمَا تُفِيضُونَ فِيهِ كَفَى بِهِ شَهِيدًا بَيْنِي وَبَيْنَكُمْ وَهُوَ الْغَفُورُ الرَّحِيمُ","prev":{"a":7,"text":"وَإِذَا تُتْلَى عَلَيْهِمْ آيَاتُنَا بَيِّنَاتٍ قَالَ الَّذِينَ كَفَرُوا لِلْحَقِّ لَمَّا جَاءَهُمْ هَذَا سِحْرٌ مُبِينٌ"},"next":{"a":9,"text":"قُلْ مَا كُنْتُ بِدْعًا مِنَ الرُّسُلِ وَمَا أَدْرِي مَا يُفْعَلُ بِي وَلَا بِكُمْ إِنْ أَتَّبِعُ إِلَّا مَا يُوحَى إِلَيَّ وَمَا أَنَا إِلَّا نَذِيرٌ مُبِينٌ"},"context":"قبلها: قالوا هذا سحر.","reason":"الافتراء."}],"hadiths":[],"situations":[{"situationId":107,"verses":[{"i":2,"strength":"direct","bridge":"﴿كَفَى بِهِ شَهِيدًا بَيْنِي وَبَيْنَكُمْ﴾."}],"hadiths":[]},{"situationId":136,"verses":[{"i":1,"strength":"direct","bridge":"﴿قُلْ أَيُّ شَيْءٍ أَكْبَرُ شَهَادَةً قُلِ اللَّهُ شَهِيدٌ بَيْنِي وَبَيْنَكُمْ﴾."}],"hadiths":[]}]},{"id":429,"name":"كان بي حفيًّا","compound":true,"meaning":"إنه كان بي حفيًّا: قالها إبراهيم لأبيه.","teaches":"1. بعد تهديد أبيه.\n2. سلام عليك سأستغفر لك.","whenRecall":"- حين يقسو عليك أحد أهلك.","whenPray":"1. ربي كان بي حفيًّا.","summary":"قابل القسوة بالسلام.","verses":[{"i":1,"of":1,"s":19,"surah":"مريم","a":47,"text":"قَالَ سَلَامٌ عَلَيْكَ سَأَسْتَغْفِرُ لَكَ رَبِّي إِنَّهُ كَانَ بِي حَفِيًّا","prev":{"a":46,"text":"قَالَ أَرَاغِبٌ أَنْتَ عَنْ آلِهَتِي يَا إِبْرَاهِيمُ لَئِنْ لَمْ تَنْتَهِ لَأَرْجُمَنَّكَ وَاهْجُرْنِي مَلِيًّا"},"next":{"a":48,"text":"وَأَعْتَزِلُكُمْ وَمَا تَدْعُونَ مِنْ دُونِ اللَّهِ وَأَدْعُو رَبِّي عَسَى أَلَّا أَكُونَ بِدُعَاءِ رَبِّي شَقِيًّا"},"context":"قبلها: أراغب أنت عن آلهتي.","reason":"رد إبراهيم."}],"hadiths":[],"situations":[{"situationId":53,"verses":[{"i":1,"strength":"direct","bridge":"﴿قَالَ سَلَامٌ عَلَيْكَ سَأَسْتَغْفِرُ لَكَ رَبِّي﴾."}],"hadiths":[]}]},{"id":430,"name":"على رجعه لقادر","compound":true,"meaning":"على رجعه لقادر: قادر على إعادة الإنسان.","teaches":"1. بعد ذكر خلقه من ماء دافق.","whenRecall":"- حين تستبعد البعث.","whenPray":"1. سبحان القادر.","summary":"من بدأك يعيدك.","verses":[{"i":1,"of":1,"s":86,"surah":"الطارق","a":8,"text":"إِنَّهُ عَلَى رَجْعِهِ لَقَادِرٌ","prev":{"a":7,"text":"يَخْرُجُ مِنْ بَيْنِ الصُّلْبِ وَالتَّرَائِبِ"},"next":{"a":9,"text":"يَوْمَ تُبْلَى السَّرَائِرُ"},"context":"قبلها: يخرج من بين الصلب.","reason":"الرجع."}],"hadiths":[],"situations":[{"situationId":109,"verses":[{"i":1,"strength":"direct","bridge":"﴿إِنَّهُ عَلَى رَجْعِهِ لَقَادِرٌ﴾."}],"hadiths":[]}]},{"id":431,"name":"عليكم رقيبًا","compound":true,"meaning":"إن الله كان عليكم رقيبًا: في صلة الأرحام.","teaches":"1. مطلع النساء.","whenRecall":"- حين تقطع رحمك.","whenPray":"1. اللهم أعني على صلة رحمي.","summary":"الرقيب يرى الرحم.","verses":[{"i":1,"of":1,"s":4,"surah":"النساء","a":1,"text":"يَا أَيُّهَا النَّاسُ اتَّقُوا رَبَّكُمُ الَّذِي خَلَقَكُمْ مِنْ نَفْسٍ وَاحِدَةٍ وَخَلَقَ مِنْهَا زَوْجَهَا وَبَثَّ مِنْهُمَا رِجَالًا كَثِيرًا وَنِسَاءً وَاتَّقُوا اللَّهَ الَّذِي تَسَاءَلُونَ بِهِ وَالْأَرْحَامَ إِنَّ اللَّهَ كَانَ عَلَيْكُمْ رَقِيبًا","next":{"a":2,"text":"وَآتُوا الْيَتَامَى أَمْوَالَهُمْ وَلَا تَتَبَدَّلُوا الْخَبِيثَ بِالطَّيِّبِ وَلَا تَأْكُلُوا أَمْوَالَهُمْ إِلَى أَمْوَالِكُمْ إِنَّهُ كَانَ حُوبًا كَبِيرًا"},"context":"مطلع النساء.","reason":"تقوى الأرحام."}],"hadiths":[{"i":1,"of":1,"text":"علَّمَنا رسولُ اللَّه صلَّى اللَّهُ عليهِ وسلَّمَ خُطبةَ الحاجةِ الحمدُ للَّهِ نستعينهُ ونستغفرهُ ونعوذُ بِهِ من شرورِ أنفسِنا من يهدِه اللَّهُ فلا مُضلَّ لهُ ومن يُضللْ فلا هاديَ لَهُ وأشهدُ أن لا إله إلَّا اللَّهُ وحدَهُ لا شريكَ له وأشهدُ أنَّ محمَّدًا عبدهُ ورسولُهُ  يَا أَيُّهَا النَّاسُ اتَّقُوا رَبَّكُمُ الَّذِي خَلَقَكُمْ مِنْ نَفْسٍ وَاحِدَةٍ وَخَلَقَ مِنْهَا زَوْجَهَا وَبَثَّ مِنْهُمَا رِجَالًا كَثِيرًا وَنِسَاءً وَاتَّقُوا اللَّهَ الَّذِي تَسَاءَلُونَ بِهِ وَالْأَرْحَامَ إِنَّ اللَّهَ كَانَ عَلَيْكُمْ رَقِيبًا  [ النساء : 1 ]  يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ حَقَّ تُقَاتِهِ وَلَا تَمُوتُنَّ إِلَّا وَأَنْتُمْ مُسْلِمُونَ  [ آل عمران : 102 ]  يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَقُولُوا قَوْلًا سَدِيدًا 70 يُصْلِحْ لَكُمْ أَعْمَالَكُمْ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ وَمَنْ يُطِعِ اللَّهَ وَرَسُولَهُ فَقَدْ فَازَ فَوْزًا عَظِيمًا  [ الأحزاب : 70 - 71 ] وفي رواية أخرى بعد قولِهِ ورسولِهِ أرسلَهُ بالحقِّ بشيرًا ونذيرًا بينَ يدَيِ السَّاعةِ من يُطعِ اللَّهَ ورسولَهُ فقد رشَدَ ومن يعصِهِما فإنَّهُ لا يضرُّ إلَّا نفسَهُ ولا يضرُّ اللَّهَ شيئًا","narrator":"عبدالله بن مسعود","source":"الأذكار للنووي 355","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/ro0xscE2","nameForm":"عليكم رقيبًا"}],"sunnah":{},"situations":[{"situationId":53,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَاتَّقُوا اللَّهَ الَّذِي تَسَاءَلُونَ بِهِ وَالْأَرْحَامَ﴾."}],"hadiths":[]}]},{"id":432,"name":"بعباده بصيرًا","compound":true,"meaning":"بعباده بصيرًا: يرى عباده ويمهلهم إلى أجل.","teaches":"1. لو يؤاخذ الناس بما كسبوا ما ترك على ظهرها من دابة.","whenRecall":"- حين تستعجل العقوبة.","whenPray":"1. اللهم لا تؤاخذنا بذنوبنا.","summary":"الإمهال رحمة، وهو بصير بعباده.","verses":[{"i":1,"of":1,"s":35,"surah":"فاطر","a":45,"text":"وَلَوْ يُؤَاخِذُ اللَّهُ النَّاسَ بِمَا كَسَبُوا مَا تَرَكَ عَلَى ظَهْرِهَا مِنْ دَابَّةٍ وَلَكِنْ يُؤَخِّرُهُمْ إِلَى أَجَلٍ مُسَمًّى فَإِذَا جَاءَ أَجَلُهُمْ فَإِنَّ اللَّهَ كَانَ بِعِبَادِهِ بَصِيرًا","prev":{"a":44,"text":"أَوَلَمْ يَسِيرُوا فِي الْأَرْضِ فَيَنْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الَّذِينَ مِنْ قَبْلِهِمْ وَكَانُوا أَشَدَّ مِنْهُمْ قُوَّةً وَمَا كَانَ اللَّهُ لِيُعْجِزَهُ مِنْ شَيْءٍ فِي السَّمَاوَاتِ وَلَا فِي الْأَرْضِ إِنَّهُ كَانَ عَلِيمًا قَدِيرًا"},"context":"قبلها: أولم يسيروا في الأرض.","reason":"الإمهال إلى أجل."}],"hadiths":[],"situations":[{"situationId":21,"verses":[{"i":1,"strength":"direct","bridge":"﴿وَلَوْ يُؤَاخِذُ اللَّهُ النَّاسَ بِمَا كَسَبُوا مَا تَرَكَ عَلَى ظَهْرِهَا مِنْ دَابَّةٍ﴾."}],"hadiths":[]}]},{"id":433,"name":"ربك","compound":false,"meaning":"«ربك» هو الله المالك المدبّر المربّي، مضافًا إلى المخاطَب إضافةَ تشريفٍ وعنايةٍ ورعاية.","teaches":"1. أن الله يرعاك ويدبّر أمرك عن علمٍ وحكمة.\n2. أن الحق ما جاء من ربك فلا امتراء فيه.\n3. أن ربك لا يغفل ولا ينسى ولا يظلم أحدًا.\n4. أن مغفرته واسعة وعقابه شديد، فتعيش بين الخوف والرجاء.","whenRecall":"- عند الشك في الحق أو كثرة المخالفين.\n- عند الضيق والحزن وطول الانتظار.\n- عند الذنب والرغبة في التوبة.\n- عند الذكر والتسبيح والقيام.","whenPray":"1. سبّح بحمد ربك واسجد له عند ضيق الصدر: ﴿فَسَبِّحْ بِحَمْدِ رَبِّكَ وَكُنْ مِنَ السَّاجِدِينَ﴾.\n2. اذكر ربك في نفسك تضرعًا وخيفة صباحًا ومساءً.\n3. قل عند النسيان: ﴿عَسَى أَنْ يَهْدِيَنِ رَبِّي لِأَقْرَبَ مِنْ هَذَا رَشَدًا﴾.","summary":"ربك الذي يرعاك لا يغفل عنك ولا ينساك، فاعبده وتوكّل عليه حتى يأتيك اليقين.","verses":[{"i":1,"of":224,"s":2,"surah":"البقرة","a":30,"text":"وَإِذْ قَالَ رَبُّكَ لِلْمَلَائِكَةِ إِنِّي جَاعِلٌ فِي الْأَرْضِ خَلِيفَةً قَالُوا أَتَجْعَلُ فِيهَا مَنْ يُفْسِدُ فِيهَا وَيَسْفِكُ الدِّمَاءَ وَنَحْنُ نُسَبِّحُ بِحَمْدِكَ وَنُقَدِّسُ لَكَ قَالَ إِنِّي أَعْلَمُ مَا لَا تَعْلَمُونَ","prev":{"a":29,"text":"هُوَ الَّذِي خَلَقَ لَكُمْ مَا فِي الْأَرْضِ جَمِيعًا ثُمَّ اسْتَوَى إِلَى السَّمَاءِ فَسَوَّاهُنَّ سَبْعَ سَمَاوَاتٍ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ"},"next":{"a":31,"text":"وَعَلَّمَ آدَمَ الْأَسْمَاءَ كُلَّهَا ثُمَّ عَرَضَهُمْ عَلَى الْمَلَائِكَةِ فَقَالَ أَنْبِئُونِي بِأَسْمَاءِ هَؤُلَاءِ إِنْ كُنْتُمْ صَادِقِينَ"},"context":"الله يُخبر الملائكة بأنه جاعلٌ في الأرض خليفة، فيسألون عن الحكمة.","reason":"ذُكر «ربك» لأن الرب المدبّر يعلم من حكمة خلقه ما لا يعلمه غيره."},{"i":2,"of":224,"s":2,"surah":"البقرة","a":61,"text":"وَإِذْ قُلْتُمْ يَا مُوسَى لَنْ نَصْبِرَ عَلَى طَعَامٍ وَاحِدٍ فَادْعُ لَنَا رَبَّكَ يُخْرِجْ لَنَا مِمَّا تُنْبِتُ الْأَرْضُ مِنْ بَقْلِهَا وَقِثَّائِهَا وَفُومِهَا وَعَدَسِهَا وَبَصَلِهَا قَالَ أَتَسْتَبْدِلُونَ الَّذِي هُوَ أَدْنَى بِالَّذِي هُوَ خَيْرٌ اهْبِطُوا مِصْرًا فَإِنَّ لَكُمْ مَا سَأَلْتُمْ وَضُرِبَتْ عَلَيْهِمُ الذِّلَّةُ وَالْمَسْكَنَةُ وَبَاءُوا بِغَضَبٍ مِنَ اللَّهِ ذَلِكَ بِأَنَّهُمْ كَانُوا يَكْفُرُونَ بِآيَاتِ اللَّهِ وَيَقْتُلُونَ النَّبِيِّينَ بِغَيْرِ الْحَقِّ ذَلِكَ بِمَا عَصَوْا وَكَانُوا يَعْتَدُونَ","prev":{"a":60,"text":"وَإِذِ اسْتَسْقَى مُوسَى لِقَوْمِهِ فَقُلْنَا اضْرِبْ بِعَصَاكَ الْحَجَرَ فَانْفَجَرَتْ مِنْهُ اثْنَتَا عَشْرَةَ عَيْنًا قَدْ عَلِمَ كُلُّ أُنَاسٍ مَشْرَبَهُمْ كُلُوا وَاشْرَبُوا مِنْ رِزْقِ اللَّهِ وَلَا تَعْثَوْا فِي الْأَرْضِ مُفْسِدِينَ"},"next":{"a":62,"text":"إِنَّ الَّذِينَ آمَنُوا وَالَّذِينَ هَادُوا وَالنَّصَارَى وَالصَّابِئِينَ مَنْ آمَنَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَعَمِلَ صَالِحًا فَلَهُمْ أَجْرُهُمْ عِنْدَ رَبِّهِمْ وَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ"},"context":"بنو إسرائيل يملّون المنّ والسلوى ويطلبون من موسى أن يدعو ربه بأدنى الطعام.","reason":"نسبوا الرب إلى موسى «ربك» جفاءً، واستبدلوا الأدنى بالخير."},{"i":3,"of":224,"s":2,"surah":"البقرة","a":68,"text":"قَالُوا ادْعُ لَنَا رَبَّكَ يُبَيِّنْ لَنَا مَا هِيَ قَالَ إِنَّهُ يَقُولُ إِنَّهَا بَقَرَةٌ لَا فَارِضٌ وَلَا بِكْرٌ عَوَانٌ بَيْنَ ذَلِكَ فَافْعَلُوا مَا تُؤْمَرُونَ","prev":{"a":67,"text":"وَإِذْ قَالَ مُوسَى لِقَوْمِهِ إِنَّ اللَّهَ يَأْمُرُكُمْ أَنْ تَذْبَحُوا بَقَرَةً قَالُوا أَتَتَّخِذُنَا هُزُوًا قَالَ أَعُوذُ بِاللَّهِ أَنْ أَكُونَ مِنَ الْجَاهِلِينَ"},"next":{"a":69,"text":"قَالُوا ادْعُ لَنَا رَبَّكَ يُبَيِّنْ لَنَا مَا لَوْنُهَا قَالَ إِنَّهُ يَقُولُ إِنَّهَا بَقَرَةٌ صَفْرَاءُ فَاقِعٌ لَوْنُهَا تَسُرُّ النَّاظِرِينَ"},"context":"أُمروا بذبح بقرة فأخذوا يسألون عن سنّها تعنّتًا.","reason":"قالوا «ربك» ليتنصّلوا من الأمر ويُكثروا السؤال تشدّدًا."},{"i":4,"of":224,"s":2,"surah":"البقرة","a":69,"text":"قَالُوا ادْعُ لَنَا رَبَّكَ يُبَيِّنْ لَنَا مَا لَوْنُهَا قَالَ إِنَّهُ يَقُولُ إِنَّهَا بَقَرَةٌ صَفْرَاءُ فَاقِعٌ لَوْنُهَا تَسُرُّ النَّاظِرِينَ","prev":{"a":68,"text":"قَالُوا ادْعُ لَنَا رَبَّكَ يُبَيِّنْ لَنَا مَا هِيَ قَالَ إِنَّهُ يَقُولُ إِنَّهَا بَقَرَةٌ لَا فَارِضٌ وَلَا بِكْرٌ عَوَانٌ بَيْنَ ذَلِكَ فَافْعَلُوا مَا تُؤْمَرُونَ"},"next":{"a":70,"text":"قَالُوا ادْعُ لَنَا رَبَّكَ يُبَيِّنْ لَنَا مَا هِيَ إِنَّ الْبَقَرَ تَشَابَهَ عَلَيْنَا وَإِنَّا إِنْ شَاءَ اللَّهُ لَمُهْتَدُونَ"},"context":"يستمرون في السؤال عن لون البقرة بعد بيان سنّها.","reason":"كرّروا «ادع لنا ربك» تسويفًا، فشدّد الله عليهم بالأوصاف."},{"i":5,"of":224,"s":2,"surah":"البقرة","a":70,"text":"قَالُوا ادْعُ لَنَا رَبَّكَ يُبَيِّنْ لَنَا مَا هِيَ إِنَّ الْبَقَرَ تَشَابَهَ عَلَيْنَا وَإِنَّا إِنْ شَاءَ اللَّهُ لَمُهْتَدُونَ","prev":{"a":69,"text":"قَالُوا ادْعُ لَنَا رَبَّكَ يُبَيِّنْ لَنَا مَا لَوْنُهَا قَالَ إِنَّهُ يَقُولُ إِنَّهَا بَقَرَةٌ صَفْرَاءُ فَاقِعٌ لَوْنُهَا تَسُرُّ النَّاظِرِينَ"},"next":{"a":71,"text":"قَالَ إِنَّهُ يَقُولُ إِنَّهَا بَقَرَةٌ لَا ذَلُولٌ تُثِيرُ الْأَرْضَ وَلَا تَسْقِي الْحَرْثَ مُسَلَّمَةٌ لَا شِيَةَ فِيهَا قَالُوا الْآنَ جِئْتَ بِالْحَقِّ فَذَبَحُوهَا وَمَا كَادُوا يَفْعَلُونَ"},"context":"يسألون للمرة الثالثة بحجة أن البقر تشابه عليهم.","reason":"ختموا سؤالهم بالمشيئة فكان سببَ هدايتهم بعد تلكّؤ."},{"i":6,"of":224,"s":2,"surah":"البقرة","a":147,"text":"الْحَقُّ مِنْ رَبِّكَ فَلَا تَكُونَنَّ مِنَ الْمُمْتَرِينَ","prev":{"a":146,"text":"الَّذِينَ آتَيْنَاهُمُ الْكِتَابَ يَعْرِفُونَهُ كَمَا يَعْرِفُونَ أَبْنَاءَهُمْ وَإِنَّ فَرِيقًا مِنْهُمْ لَيَكْتُمُونَ الْحَقَّ وَهُمْ يَعْلَمُونَ"},"next":{"a":148,"text":"وَلِكُلٍّ وِجْهَةٌ هُوَ مُوَلِّيهَا فَاسْتَبِقُوا الْخَيْرَاتِ أَيْنَ مَا تَكُونُوا يَأْتِ بِكُمُ اللَّهُ جَمِيعًا إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},"context":"أهل الكتاب يعرفون الحق ويكتمونه في شأن القبلة.","reason":"الحق صادرٌ من ربك المربّي لك، فلا موضع للشك فيه."},{"i":7,"of":224,"s":2,"surah":"البقرة","a":149,"text":"وَمِنْ حَيْثُ خَرَجْتَ فَوَلِّ وَجْهَكَ شَطْرَ الْمَسْجِدِ الْحَرَامِ وَإِنَّهُ لَلْحَقُّ مِنْ رَبِّكَ وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ","prev":{"a":148,"text":"وَلِكُلٍّ وِجْهَةٌ هُوَ مُوَلِّيهَا فَاسْتَبِقُوا الْخَيْرَاتِ أَيْنَ مَا تَكُونُوا يَأْتِ بِكُمُ اللَّهُ جَمِيعًا إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},"next":{"a":150,"text":"وَمِنْ حَيْثُ خَرَجْتَ فَوَلِّ وَجْهَكَ شَطْرَ الْمَسْجِدِ الْحَرَامِ وَحَيْثُ مَا كُنْتُمْ فَوَلُّوا وُجُوهَكُمْ شَطْرَهُ لِئَلَّا يَكُونَ لِلنَّاسِ عَلَيْكُمْ حُجَّةٌ إِلَّا الَّذِينَ ظَلَمُوا مِنْهُمْ فَلَا تَخْشَوْهُمْ وَاخْشَوْنِي وَلِأُتِمَّ نِعْمَتِي عَلَيْكُمْ وَلَعَلَّكُمْ تَهْتَدُونَ"},"context":"الأمر باستقبال المسجد الحرام في كل مكانٍ يخرج منه النبي ﷺ.","reason":"أكّد أن القبلة حقٌّ من ربك، وأنه لا يغفل عن العمل."},{"i":8,"of":224,"s":3,"surah":"آل عمران","a":41,"text":"قَالَ رَبِّ اجْعَلْ لِي آيَةً قَالَ آيَتُكَ أَلَّا تُكَلِّمَ النَّاسَ ثَلَاثَةَ أَيَّامٍ إِلَّا رَمْزًا وَاذْكُرْ رَبَّكَ كَثِيرًا وَسَبِّحْ بِالْعَشِيِّ وَالْإِبْكَارِ","prev":{"a":40,"text":"قَالَ رَبِّ أَنَّى يَكُونُ لِي غُلَامٌ وَقَدْ بَلَغَنِيَ الْكِبَرُ وَامْرَأَتِي عَاقِرٌ قَالَ كَذَلِكَ اللَّهُ يَفْعَلُ مَا يَشَاءُ"},"next":{"a":42,"text":"وَإِذْ قَالَتِ الْمَلَائِكَةُ يَا مَرْيَمُ إِنَّ اللَّهَ اصْطَفَاكِ وَطَهَّرَكِ وَاصْطَفَاكِ عَلَى نِسَاءِ الْعَالَمِينَ"},"context":"زكريا يطلب آيةً على البشارة بالولد، فيُجعل له الصمت ثلاثة أيام.","reason":"أُمر بذكر ربه الذي بشّره، فالذكر شكرٌ للنعمة المنتظرة."},{"i":9,"of":224,"s":3,"surah":"آل عمران","a":43,"text":"يَا مَرْيَمُ اقْنُتِي لِرَبِّكِ وَاسْجُدِي وَارْكَعِي مَعَ الرَّاكِعِينَ","prev":{"a":42,"text":"وَإِذْ قَالَتِ الْمَلَائِكَةُ يَا مَرْيَمُ إِنَّ اللَّهَ اصْطَفَاكِ وَطَهَّرَكِ وَاصْطَفَاكِ عَلَى نِسَاءِ الْعَالَمِينَ"},"next":{"a":44,"text":"ذَلِكَ مِنْ أَنْبَاءِ الْغَيْبِ نُوحِيهِ إِلَيْكَ وَمَا كُنْتَ لَدَيْهِمْ إِذْ يُلْقُونَ أَقْلَامَهُمْ أَيُّهُمْ يَكْفُلُ مَرْيَمَ وَمَا كُنْتَ لَدَيْهِمْ إِذْ يَخْتَصِمُونَ"},"context":"الملائكة تبشّر مريم باصطفائها وتأمرها بالعبادة.","reason":"الاصطفاء من الرب يقابَل بالقنوت له وحده."},{"i":10,"of":224,"s":3,"surah":"آل عمران","a":60,"text":"الْحَقُّ مِنْ رَبِّكَ فَلَا تَكُنْ مِنَ الْمُمْتَرِينَ","prev":{"a":59,"text":"إِنَّ مَثَلَ عِيسَى عِنْدَ اللَّهِ كَمَثَلِ آدَمَ خَلَقَهُ مِنْ تُرَابٍ ثُمَّ قَالَ لَهُ كُنْ فَيَكُونُ"},"next":{"a":61,"text":"فَمَنْ حَاجَّكَ فِيهِ مِنْ بَعْدِ مَا جَاءَكَ مِنَ الْعِلْمِ فَقُلْ تَعَالَوْا نَدْعُ أَبْنَاءَنَا وَأَبْنَاءَكُمْ وَنِسَاءَنَا وَنِسَاءَكُمْ وَأَنْفُسَنَا وَأَنْفُسَكُمْ ثُمَّ نَبْتَهِلْ فَنَجْعَلْ لَعْنَتَ اللَّهِ عَلَى الْكَاذِبِينَ"},"context":"بيان حقيقة عيسى عليه السلام وأنه كآدم خُلق من تراب.","reason":"الحق في شأن عيسى من ربك، لا من أقوال الغالين."},{"i":11,"of":224,"s":4,"surah":"النساء","a":65,"text":"فَلَا وَرَبِّكَ لَا يُؤْمِنُونَ حَتَّى يُحَكِّمُوكَ فِيمَا شَجَرَ بَيْنَهُمْ ثُمَّ لَا يَجِدُوا فِي أَنْفُسِهِمْ حَرَجًا مِمَّا قَضَيْتَ وَيُسَلِّمُوا تَسْلِيمًا","prev":{"a":64,"text":"وَمَا أَرْسَلْنَا مِنْ رَسُولٍ إِلَّا لِيُطَاعَ بِإِذْنِ اللَّهِ وَلَوْ أَنَّهُمْ إِذْ ظَلَمُوا أَنْفُسَهُمْ جَاءُوكَ فَاسْتَغْفَرُوا اللَّهَ وَاسْتَغْفَرَ لَهُمُ الرَّسُولُ لَوَجَدُوا اللَّهَ تَوَّابًا رَحِيمًا"},"next":{"a":66,"text":"وَلَوْ أَنَّا كَتَبْنَا عَلَيْهِمْ أَنِ اقْتُلُوا أَنْفُسَكُمْ أَوِ اخْرُجُوا مِنْ دِيَارِكُمْ مَا فَعَلُوهُ إِلَّا قَلِيلٌ مِنْهُمْ وَلَوْ أَنَّهُمْ فَعَلُوا مَا يُوعَظُونَ بِهِ لَكَانَ خَيْرًا لَهُمْ وَأَشَدَّ تَثْبِيتًا"},"context":"الحديث عن المنافقين الذين يتحاكمون إلى غير الرسول ﷺ.","reason":"أقسم الله بربوبيته للنبي ﷺ تعظيمًا لشأن التحاكم إليه."},{"i":12,"of":224,"s":5,"surah":"المائدة","a":24,"text":"قَالُوا يَا مُوسَى إِنَّا لَنْ نَدْخُلَهَا أَبَدًا مَا دَامُوا فِيهَا فَاذْهَبْ أَنْتَ وَرَبُّكَ فَقَاتِلَا إِنَّا هَاهُنَا قَاعِدُونَ","prev":{"a":23,"text":"قَالَ رَجُلَانِ مِنَ الَّذِينَ يَخَافُونَ أَنْعَمَ اللَّهُ عَلَيْهِمَا ادْخُلُوا عَلَيْهِمُ الْبَابَ فَإِذَا دَخَلْتُمُوهُ فَإِنَّكُمْ غَالِبُونَ وَعَلَى اللَّهِ فَتَوَكَّلُوا إِنْ كُنْتُمْ مُؤْمِنِينَ"},"next":{"a":25,"text":"قَالَ رَبِّ إِنِّي لَا أَمْلِكُ إِلَّا نَفْسِي وَأَخِي فَافْرُقْ بَيْنَنَا وَبَيْنَ الْقَوْمِ الْفَاسِقِينَ"},"context":"موسى يأمر قومه بدخول الأرض المقدسة فيرفضون خوفًا من الجبابرة.","reason":"قالوا «وربك» تبرّؤًا وجبنًا، فأحالوا الجهاد على موسى وربه."},{"i":13,"of":224,"s":5,"surah":"المائدة","a":64,"text":"وَقَالَتِ الْيَهُودُ يَدُ اللَّهِ مَغْلُولَةٌ غُلَّتْ أَيْدِيهِمْ وَلُعِنُوا بِمَا قَالُوا بَلْ يَدَاهُ مَبْسُوطَتَانِ يُنْفِقُ كَيْفَ يَشَاءُ وَلَيَزِيدَنَّ كَثِيرًا مِنْهُمْ مَا أُنْزِلَ إِلَيْكَ مِنْ رَبِّكَ طُغْيَانًا وَكُفْرًا وَأَلْقَيْنَا بَيْنَهُمُ الْعَدَاوَةَ وَالْبَغْضَاءَ إِلَى يَوْمِ الْقِيَامَةِ كُلَّمَا أَوْقَدُوا نَارًا لِلْحَرْبِ أَطْفَأَهَا اللَّهُ وَيَسْعَوْنَ فِي الْأَرْضِ فَسَادًا وَاللَّهُ لَا يُحِبُّ الْمُفْسِدِينَ","prev":{"a":63,"text":"لَوْلَا يَنْهَاهُمُ الرَّبَّانِيُّونَ وَالْأَحْبَارُ عَنْ قَوْلِهِمُ الْإِثْمَ وَأَكْلِهِمُ السُّحْتَ لَبِئْسَ مَا كَانُوا يَصْنَعُونَ"},"next":{"a":65,"text":"وَلَوْ أَنَّ أَهْلَ الْكِتَابِ آمَنُوا وَاتَّقَوْا لَكَفَّرْنَا عَنْهُمْ سَيِّئَاتِهِمْ وَلَأَدْخَلْنَاهُمْ جَنَّاتِ النَّعِيمِ"},"context":"اليهود يصفون الله بالبخل، فيُردّ عليهم بأن يديه مبسوطتان.","reason":"ما أنزله ربك للنبي ﷺ زادهم طغيانًا لحسدهم."},{"i":14,"of":224,"s":5,"surah":"المائدة","a":67,"text":"يَا أَيُّهَا الرَّسُولُ بَلِّغْ مَا أُنْزِلَ إِلَيْكَ مِنْ رَبِّكَ وَإِنْ لَمْ تَفْعَلْ فَمَا بَلَّغْتَ رِسَالَتَهُ وَاللَّهُ يَعْصِمُكَ مِنَ النَّاسِ إِنَّ اللَّهَ لَا يَهْدِي الْقَوْمَ الْكَافِرِينَ","prev":{"a":66,"text":"وَلَوْ أَنَّهُمْ أَقَامُوا التَّوْرَاةَ وَالْإِنْجِيلَ وَمَا أُنْزِلَ إِلَيْهِمْ مِنْ رَبِّهِمْ لَأَكَلُوا مِنْ فَوْقِهِمْ وَمِنْ تَحْتِ أَرْجُلِهِمْ مِنْهُمْ أُمَّةٌ مُقْتَصِدَةٌ وَكَثِيرٌ مِنْهُمْ سَاءَ مَا يَعْمَلُونَ"},"next":{"a":68,"text":"قُلْ يَا أَهْلَ الْكِتَابِ لَسْتُمْ عَلَى شَيْءٍ حَتَّى تُقِيمُوا التَّوْرَاةَ وَالْإِنْجِيلَ وَمَا أُنْزِلَ إِلَيْكُمْ مِنْ رَبِّكُمْ وَلَيَزِيدَنَّ كَثِيرًا مِنْهُمْ مَا أُنْزِلَ إِلَيْكَ مِنْ رَبِّكَ طُغْيَانًا وَكُفْرًا فَلَا تَأْسَ عَلَى الْقَوْمِ الْكَافِرِينَ"},"context":"الأمر للرسول ﷺ بتبليغ الرسالة كاملةً.","reason":"ما أُنزل من ربك أمانةٌ، وربك يعصمك ممن يخشاهم الداعي."},{"i":15,"of":224,"s":5,"surah":"المائدة","a":68,"text":"قُلْ يَا أَهْلَ الْكِتَابِ لَسْتُمْ عَلَى شَيْءٍ حَتَّى تُقِيمُوا التَّوْرَاةَ وَالْإِنْجِيلَ وَمَا أُنْزِلَ إِلَيْكُمْ مِنْ رَبِّكُمْ وَلَيَزِيدَنَّ كَثِيرًا مِنْهُمْ مَا أُنْزِلَ إِلَيْكَ مِنْ رَبِّكَ طُغْيَانًا وَكُفْرًا فَلَا تَأْسَ عَلَى الْقَوْمِ الْكَافِرِينَ","prev":{"a":67,"text":"يَا أَيُّهَا الرَّسُولُ بَلِّغْ مَا أُنْزِلَ إِلَيْكَ مِنْ رَبِّكَ وَإِنْ لَمْ تَفْعَلْ فَمَا بَلَّغْتَ رِسَالَتَهُ وَاللَّهُ يَعْصِمُكَ مِنَ النَّاسِ إِنَّ اللَّهَ لَا يَهْدِي الْقَوْمَ الْكَافِرِينَ"},"next":{"a":69,"text":"إِنَّ الَّذِينَ آمَنُوا وَالَّذِينَ هَادُوا وَالصَّابِئُونَ وَالنَّصَارَى مَنْ آمَنَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَعَمِلَ صَالِحًا فَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ"},"context":"خطاب أهل الكتاب بأنهم ليسوا على شيء حتى يقيموا كتبهم.","reason":"الوحي من ربك يزيد المعاندين كفرًا، فلا تحزن عليهم."},{"i":16,"of":224,"s":5,"surah":"المائدة","a":112,"text":"إِذْ قَالَ الْحَوَارِيُّونَ يَا عِيسَى ابْنَ مَرْيَمَ هَلْ يَسْتَطِيعُ رَبُّكَ أَنْ يُنَزِّلَ عَلَيْنَا مَائِدَةً مِنَ السَّمَاءِ قَالَ اتَّقُوا اللَّهَ إِنْ كُنْتُمْ مُؤْمِنِينَ","prev":{"a":111,"text":"وَإِذْ أَوْحَيْتُ إِلَى الْحَوَارِيِّينَ أَنْ آمِنُوا بِي وَبِرَسُولِي قَالُوا آمَنَّا وَاشْهَدْ بِأَنَّنَا مُسْلِمُونَ"},"next":{"a":113,"text":"قَالُوا نُرِيدُ أَنْ نَأْكُلَ مِنْهَا وَتَطْمَئِنَّ قُلُوبُنَا وَنَعْلَمَ أَنْ قَدْ صَدَقْتَنَا وَنَكُونَ عَلَيْهَا مِنَ الشَّاهِدِينَ"},"context":"الحواريون يسألون عيسى أن يُنزل ربه مائدةً من السماء.","reason":"سألوا قدرة «ربك» فأمرهم عيسى بالتقوى بدل طلب الآيات."},{"i":17,"of":224,"s":6,"surah":"الأنعام","a":83,"text":"وَتِلْكَ حُجَّتُنَا آتَيْنَاهَا إِبْرَاهِيمَ عَلَى قَوْمِهِ نَرْفَعُ دَرَجَاتٍ مَنْ نَشَاءُ إِنَّ رَبَّكَ حَكِيمٌ عَلِيمٌ","prev":{"a":82,"text":"الَّذِينَ آمَنُوا وَلَمْ يَلْبِسُوا إِيمَانَهُمْ بِظُلْمٍ أُولَئِكَ لَهُمُ الْأَمْنُ وَهُمْ مُهْتَدُونَ"},"next":{"a":84,"text":"وَوَهَبْنَا لَهُ إِسْحَاقَ وَيَعْقُوبَ كُلًّا هَدَيْنَا وَنُوحًا هَدَيْنَا مِنْ قَبْلُ وَمِنْ ذُرِّيَّتِهِ دَاوُودَ وَسُلَيْمَانَ وَأَيُّوبَ وَيُوسُفَ وَمُوسَى وَهَارُونَ وَكَذَلِكَ نَجْزِي الْمُحْسِنِينَ"},"context":"ختام محاجّة إبراهيم لقومه في الكواكب والأصنام.","reason":"ربك يرفع بالحجة من يشاء بحكمته وعلمه."},{"i":18,"of":224,"s":6,"surah":"الأنعام","a":106,"text":"اتَّبِعْ مَا أُوحِيَ إِلَيْكَ مِنْ رَبِّكَ لَا إِلَهَ إِلَّا هُوَ وَأَعْرِضْ عَنِ الْمُشْرِكِينَ","prev":{"a":105,"text":"وَكَذَلِكَ نُصَرِّفُ الْآيَاتِ وَلِيَقُولُوا دَرَسْتَ وَلِنُبَيِّنَهُ لِقَوْمٍ يَعْلَمُونَ"},"next":{"a":107,"text":"وَلَوْ شَاءَ اللَّهُ مَا أَشْرَكُوا وَمَا جَعَلْنَاكَ عَلَيْهِمْ حَفِيظًا وَمَا أَنْتَ عَلَيْهِمْ بِوَكِيلٍ"},"context":"بعد بيان أن البصائر جاءت من الله، يُؤمر النبي ﷺ بالاتباع.","reason":"الوحي من ربك هو المتّبَع، لا أهواء المشركين."},{"i":19,"of":224,"s":6,"surah":"الأنعام","a":112,"text":"وَكَذَلِكَ جَعَلْنَا لِكُلِّ نَبِيٍّ عَدُوًّا شَيَاطِينَ الْإِنْسِ وَالْجِنِّ يُوحِي بَعْضُهُمْ إِلَى بَعْضٍ زُخْرُفَ الْقَوْلِ غُرُورًا وَلَوْ شَاءَ رَبُّكَ مَا فَعَلُوهُ فَذَرْهُمْ وَمَا يَفْتَرُونَ","prev":{"a":111,"text":"وَلَوْ أَنَّنَا نَزَّلْنَا إِلَيْهِمُ الْمَلَائِكَةَ وَكَلَّمَهُمُ الْمَوْتَى وَحَشَرْنَا عَلَيْهِمْ كُلَّ شَيْءٍ قُبُلًا مَا كَانُوا لِيُؤْمِنُوا إِلَّا أَنْ يَشَاءَ اللَّهُ وَلَكِنَّ أَكْثَرَهُمْ يَجْهَلُونَ"},"next":{"a":113,"text":"وَلِتَصْغَى إِلَيْهِ أَفْئِدَةُ الَّذِينَ لَا يُؤْمِنُونَ بِالْآخِرَةِ وَلِيَرْضَوْهُ وَلِيَقْتَرِفُوا مَا هُمْ مُقْتَرِفُونَ"},"context":"لكل نبيٍّ أعداء من شياطين الإنس والجن يزخرفون القول.","reason":"عداوتهم واقعةٌ بمشيئة ربك، فلا تخشَ منها إلا ما شاء."},{"i":20,"of":224,"s":6,"surah":"الأنعام","a":114,"text":"أَفَغَيْرَ اللَّهِ أَبْتَغِي حَكَمًا وَهُوَ الَّذِي أَنْزَلَ إِلَيْكُمُ الْكِتَابَ مُفَصَّلًا وَالَّذِينَ آتَيْنَاهُمُ الْكِتَابَ يَعْلَمُونَ أَنَّهُ مُنَزَّلٌ مِنْ رَبِّكَ بِالْحَقِّ فَلَا تَكُونَنَّ مِنَ الْمُمْتَرِينَ","prev":{"a":113,"text":"وَلِتَصْغَى إِلَيْهِ أَفْئِدَةُ الَّذِينَ لَا يُؤْمِنُونَ بِالْآخِرَةِ وَلِيَرْضَوْهُ وَلِيَقْتَرِفُوا مَا هُمْ مُقْتَرِفُونَ"},"next":{"a":115,"text":"وَتَمَّتْ كَلِمَتُ رَبِّكَ صِدْقًا وَعَدْلًا لَا مُبَدِّلَ لِكَلِمَاتِهِ وَهُوَ السَّمِيعُ الْعَلِيمُ"},"context":"إنكار طلب حكَمٍ غير الله وقد أنزل الكتاب مفصّلًا.","reason":"الكتاب منزَّلٌ من ربك بالحق، يشهد بذلك أهل الكتاب."},{"i":21,"of":224,"s":6,"surah":"الأنعام","a":115,"text":"وَتَمَّتْ كَلِمَتُ رَبِّكَ صِدْقًا وَعَدْلًا لَا مُبَدِّلَ لِكَلِمَاتِهِ وَهُوَ السَّمِيعُ الْعَلِيمُ","prev":{"a":114,"text":"أَفَغَيْرَ اللَّهِ أَبْتَغِي حَكَمًا وَهُوَ الَّذِي أَنْزَلَ إِلَيْكُمُ الْكِتَابَ مُفَصَّلًا وَالَّذِينَ آتَيْنَاهُمُ الْكِتَابَ يَعْلَمُونَ أَنَّهُ مُنَزَّلٌ مِنْ رَبِّكَ بِالْحَقِّ فَلَا تَكُونَنَّ مِنَ الْمُمْتَرِينَ"},"next":{"a":116,"text":"وَإِنْ تُطِعْ أَكْثَرَ مَنْ فِي الْأَرْضِ يُضِلُّوكَ عَنْ سَبِيلِ اللَّهِ إِنْ يَتَّبِعُونَ إِلَّا الظَّنَّ وَإِنْ هُمْ إِلَّا يَخْرُصُونَ"},"context":"بعد بيان أن الكتاب منزّلٌ بالحق.","reason":"كلمات ربك تامّةٌ صدقًا في الخبر وعدلًا في الحكم."},{"i":22,"of":224,"s":6,"surah":"الأنعام","a":117,"text":"إِنَّ رَبَّكَ هُوَ أَعْلَمُ مَنْ يَضِلُّ عَنْ سَبِيلِهِ وَهُوَ أَعْلَمُ بِالْمُهْتَدِينَ","prev":{"a":116,"text":"وَإِنْ تُطِعْ أَكْثَرَ مَنْ فِي الْأَرْضِ يُضِلُّوكَ عَنْ سَبِيلِ اللَّهِ إِنْ يَتَّبِعُونَ إِلَّا الظَّنَّ وَإِنْ هُمْ إِلَّا يَخْرُصُونَ"},"next":{"a":118,"text":"فَكُلُوا مِمَّا ذُكِرَ اسْمُ اللَّهِ عَلَيْهِ إِنْ كُنْتُمْ بِآيَاتِهِ مُؤْمِنِينَ"},"context":"التحذير من طاعة أكثر من في الأرض لأنهم يتبعون الظن.","reason":"ربك وحده يعلم الضالّ من المهتدي، لا كثرة الناس."},{"i":23,"of":224,"s":6,"surah":"الأنعام","a":119,"text":"وَمَا لَكُمْ أَلَّا تَأْكُلُوا مِمَّا ذُكِرَ اسْمُ اللَّهِ عَلَيْهِ وَقَدْ فَصَّلَ لَكُمْ مَا حَرَّمَ عَلَيْكُمْ إِلَّا مَا اضْطُرِرْتُمْ إِلَيْهِ وَإِنَّ كَثِيرًا لَيُضِلُّونَ بِأَهْوَائِهِمْ بِغَيْرِ عِلْمٍ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِالْمُعْتَدِينَ","prev":{"a":118,"text":"فَكُلُوا مِمَّا ذُكِرَ اسْمُ اللَّهِ عَلَيْهِ إِنْ كُنْتُمْ بِآيَاتِهِ مُؤْمِنِينَ"},"next":{"a":120,"text":"وَذَرُوا ظَاهِرَ الْإِثْمِ وَبَاطِنَهُ إِنَّ الَّذِينَ يَكْسِبُونَ الْإِثْمَ سَيُجْزَوْنَ بِمَا كَانُوا يَقْتَرِفُونَ"},"context":"بيان حِلّ ما ذُكر اسم الله عليه، ونقد المضلّين بأهوائهم.","reason":"ربك أعلم بمن يعتدي في التحليل والتحريم بغير علم."},{"i":24,"of":224,"s":6,"surah":"الأنعام","a":126,"text":"وَهَذَا صِرَاطُ رَبِّكَ مُسْتَقِيمًا قَدْ فَصَّلْنَا الْآيَاتِ لِقَوْمٍ يَذَّكَّرُونَ","prev":{"a":125,"text":"فَمَنْ يُرِدِ اللَّهُ أَنْ يَهْدِيَهُ يَشْرَحْ صَدْرَهُ لِلْإِسْلَامِ وَمَنْ يُرِدْ أَنْ يُضِلَّهُ يَجْعَلْ صَدْرَهُ ضَيِّقًا حَرَجًا كَأَنَّمَا يَصَّعَّدُ فِي السَّمَاءِ كَذَلِكَ يَجْعَلُ اللَّهُ الرِّجْسَ عَلَى الَّذِينَ لَا يُؤْمِنُونَ"},"next":{"a":127,"text":"لَهُمْ دَارُ السَّلَامِ عِنْدَ رَبِّهِمْ وَهُوَ وَلِيُّهُمْ بِمَا كَانُوا يَعْمَلُونَ"},"context":"بعد ذكر شرح الصدر للإسلام وضيقه على الكافر.","reason":"الصراط منسوبٌ إلى ربك لأنه هو الذي شرعه وهدى إليه."},{"i":25,"of":224,"s":6,"surah":"الأنعام","a":128,"text":"وَيَوْمَ يَحْشُرُهُمْ جَمِيعًا يَا مَعْشَرَ الْجِنِّ قَدِ اسْتَكْثَرْتُمْ مِنَ الْإِنْسِ وَقَالَ أَوْلِيَاؤُهُمْ مِنَ الْإِنْسِ رَبَّنَا اسْتَمْتَعَ بَعْضُنَا بِبَعْضٍ وَبَلَغْنَا أَجَلَنَا الَّذِي أَجَّلْتَ لَنَا قَالَ النَّارُ مَثْوَاكُمْ خَالِدِينَ فِيهَا إِلَّا مَا شَاءَ اللَّهُ إِنَّ رَبَّكَ حَكِيمٌ عَلِيمٌ","prev":{"a":127,"text":"لَهُمْ دَارُ السَّلَامِ عِنْدَ رَبِّهِمْ وَهُوَ وَلِيُّهُمْ بِمَا كَانُوا يَعْمَلُونَ"},"next":{"a":129,"text":"وَكَذَلِكَ نُوَلِّي بَعْضَ الظَّالِمِينَ بَعْضًا بِمَا كَانُوا يَكْسِبُونَ"},"context":"مشهد حشر الجن وأوليائهم من الإنس واعترافهم بالاستمتاع.","reason":"جزاؤهم صادرٌ عن ربٍّ حكيمٍ في عقابه عليمٍ بأعمالهم."},{"i":26,"of":224,"s":6,"surah":"الأنعام","a":131,"text":"ذَلِكَ أَنْ لَمْ يَكُنْ رَبُّكَ مُهْلِكَ الْقُرَى بِظُلْمٍ وَأَهْلُهَا غَافِلُونَ","prev":{"a":130,"text":"يَا مَعْشَرَ الْجِنِّ وَالْإِنْسِ أَلَمْ يَأْتِكُمْ رُسُلٌ مِنْكُمْ يَقُصُّونَ عَلَيْكُمْ آيَاتِي وَيُنْذِرُونَكُمْ لِقَاءَ يَوْمِكُمْ هَذَا قَالُوا شَهِدْنَا عَلَى أَنْفُسِنَا وَغَرَّتْهُمُ الْحَيَاةُ الدُّنْيَا وَشَهِدُوا عَلَى أَنْفُسِهِمْ أَنَّهُمْ كَانُوا كَافِرِينَ"},"next":{"a":132,"text":"وَلِكُلٍّ دَرَجَاتٌ مِمَّا عَمِلُوا وَمَا رَبُّكَ بِغَافِلٍ عَمَّا يَعْمَلُونَ"},"context":"بعد إقامة الحجة بالرسل على الجن والإنس.","reason":"ربك لا يُهلك قومًا قبل إنذارهم، وهذا من عدله."},{"i":27,"of":224,"s":6,"surah":"الأنعام","a":132,"text":"وَلِكُلٍّ دَرَجَاتٌ مِمَّا عَمِلُوا وَمَا رَبُّكَ بِغَافِلٍ عَمَّا يَعْمَلُونَ","prev":{"a":131,"text":"ذَلِكَ أَنْ لَمْ يَكُنْ رَبُّكَ مُهْلِكَ الْقُرَى بِظُلْمٍ وَأَهْلُهَا غَافِلُونَ"},"next":{"a":133,"text":"وَرَبُّكَ الْغَنِيُّ ذُو الرَّحْمَةِ إِنْ يَشَأْ يُذْهِبْكُمْ وَيَسْتَخْلِفْ مِنْ بَعْدِكُمْ مَا يَشَاءُ كَمَا أَنْشَأَكُمْ مِنْ ذُرِّيَّةِ قَوْمٍ آخَرِينَ"},"context":"بيان أن لكل من الفريقين درجاتٍ بحسب عمله.","reason":"ربك لا يغفل عن عملٍ، فيضع كلًّا في درجته."},{"i":28,"of":224,"s":6,"surah":"الأنعام","a":133,"text":"وَرَبُّكَ الْغَنِيُّ ذُو الرَّحْمَةِ إِنْ يَشَأْ يُذْهِبْكُمْ وَيَسْتَخْلِفْ مِنْ بَعْدِكُمْ مَا يَشَاءُ كَمَا أَنْشَأَكُمْ مِنْ ذُرِّيَّةِ قَوْمٍ آخَرِينَ","prev":{"a":132,"text":"وَلِكُلٍّ دَرَجَاتٌ مِمَّا عَمِلُوا وَمَا رَبُّكَ بِغَافِلٍ عَمَّا يَعْمَلُونَ"},"next":{"a":134,"text":"إِنَّ مَا تُوعَدُونَ لَآتٍ وَمَا أَنْتُمْ بِمُعْجِزِينَ"},"context":"بعد ذكر الجزاء، يُبيَّن غنى الله عن خلقه.","reason":"ربك غنيٌّ لا يحتاجهم، وذو رحمة فلا يعاجلهم."},{"i":29,"of":224,"s":6,"surah":"الأنعام","a":145,"text":"قُلْ لَا أَجِدُ فِي مَا أُوحِيَ إِلَيَّ مُحَرَّمًا عَلَى طَاعِمٍ يَطْعَمُهُ إِلَّا أَنْ يَكُونَ مَيْتَةً أَوْ دَمًا مَسْفُوحًا أَوْ لَحْمَ خِنْزِيرٍ فَإِنَّهُ رِجْسٌ أَوْ فِسْقًا أُهِلَّ لِغَيْرِ اللَّهِ بِهِ فَمَنِ اضْطُرَّ غَيْرَ بَاغٍ وَلَا عَادٍ فَإِنَّ رَبَّكَ غَفُورٌ رَحِيمٌ","prev":{"a":144,"text":"وَمِنَ الْإِبِلِ اثْنَيْنِ وَمِنَ الْبَقَرِ اثْنَيْنِ قُلْ آلذَّكَرَيْنِ حَرَّمَ أَمِ الْأُنْثَيَيْنِ أَمَّا اشْتَمَلَتْ عَلَيْهِ أَرْحَامُ الْأُنْثَيَيْنِ أَمْ كُنْتُمْ شُهَدَاءَ إِذْ وَصَّاكُمُ اللَّهُ بِهَذَا فَمَنْ أَظْلَمُ مِمَّنِ افْتَرَى عَلَى اللَّهِ كَذِبًا لِيُضِلَّ النَّاسَ بِغَيْرِ عِلْمٍ إِنَّ اللَّهَ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ"},"next":{"a":146,"text":"وَعَلَى الَّذِينَ هَادُوا حَرَّمْنَا كُلَّ ذِي ظُفُرٍ وَمِنَ الْبَقَرِ وَالْغَنَمِ حَرَّمْنَا عَلَيْهِمْ شُحُومَهُمَا إِلَّا مَا حَمَلَتْ ظُهُورُهُمَا أَوِ الْحَوَايَا أَوْ مَا اخْتَلَطَ بِعَظْمٍ ذَلِكَ جَزَيْنَاهُمْ بِبَغْيِهِمْ وَإِنَّا لَصَادِقُونَ"},"context":"حصر المحرّمات من الطعام ونقض تحريم المشركين.","reason":"ربك غفورٌ رحيم بالمضطرّ فرخّص له."},{"i":30,"of":224,"s":6,"surah":"الأنعام","a":158,"text":"هَلْ يَنْظُرُونَ إِلَّا أَنْ تَأْتِيَهُمُ الْمَلَائِكَةُ أَوْ يَأْتِيَ رَبُّكَ أَوْ يَأْتِيَ بَعْضُ آيَاتِ رَبِّكَ يَوْمَ يَأْتِي بَعْضُ آيَاتِ رَبِّكَ لَا يَنْفَعُ نَفْسًا إِيمَانُهَا لَمْ تَكُنْ آمَنَتْ مِنْ قَبْلُ أَوْ كَسَبَتْ فِي إِيمَانِهَا خَيْرًا قُلِ انْتَظِرُوا إِنَّا مُنْتَظِرُونَ","prev":{"a":157,"text":"أَوْ تَقُولُوا لَوْ أَنَّا أُنْزِلَ عَلَيْنَا الْكِتَابُ لَكُنَّا أَهْدَى مِنْهُمْ فَقَدْ جَاءَكُمْ بَيِّنَةٌ مِنْ رَبِّكُمْ وَهُدًى وَرَحْمَةٌ فَمَنْ أَظْلَمُ مِمَّنْ كَذَّبَ بِآيَاتِ اللَّهِ وَصَدَفَ عَنْهَا سَنَجْزِي الَّذِينَ يَصْدِفُونَ عَنْ آيَاتِنَا سُوءَ الْعَذَابِ بِمَا كَانُوا يَصْدِفُونَ"},"next":{"a":159,"text":"إِنَّ الَّذِينَ فَرَّقُوا دِينَهُمْ وَكَانُوا شِيَعًا لَسْتَ مِنْهُمْ فِي شَيْءٍ إِنَّمَا أَمْرُهُمْ إِلَى اللَّهِ ثُمَّ يُنَبِّئُهُمْ بِمَا كَانُوا يَفْعَلُونَ"},"context":"المعرضون ينتظرون مجيء الملائكة أو بعض الآيات.","reason":"إذا جاء ربك أو بعض آياته أُغلق باب التوبة."},{"i":31,"of":224,"s":6,"surah":"الأنعام","a":165,"text":"وَهُوَ الَّذِي جَعَلَكُمْ خَلَائِفَ الْأَرْضِ وَرَفَعَ بَعْضَكُمْ فَوْقَ بَعْضٍ دَرَجَاتٍ لِيَبْلُوَكُمْ فِي مَا آتَاكُمْ إِنَّ رَبَّكَ سَرِيعُ الْعِقَابِ وَإِنَّهُ لَغَفُورٌ رَحِيمٌ","prev":{"a":164,"text":"قُلْ أَغَيْرَ اللَّهِ أَبْغِي رَبًّا وَهُوَ رَبُّ كُلِّ شَيْءٍ وَلَا تَكْسِبُ كُلُّ نَفْسٍ إِلَّا عَلَيْهَا وَلَا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَى ثُمَّ إِلَى رَبِّكُمْ مَرْجِعُكُمْ فَيُنَبِّئُكُمْ بِمَا كُنْتُمْ فِيهِ تَخْتَلِفُونَ"},"context":"ختام الأنعام: الله جعلكم خلائف ورفع بعضكم فوق بعض ليبتليكم.","reason":"جمع بين سرعة عقاب ربك وسعة مغفرته ليبقى العبد بين خوفٍ ورجاء."},{"i":32,"of":224,"s":7,"surah":"الأعراف","a":134,"text":"وَلَمَّا وَقَعَ عَلَيْهِمُ الرِّجْزُ قَالُوا يَا مُوسَى ادْعُ لَنَا رَبَّكَ بِمَا عَهِدَ عِنْدَكَ لَئِنْ كَشَفْتَ عَنَّا الرِّجْزَ لَنُؤْمِنَنَّ لَكَ وَلَنُرْسِلَنَّ مَعَكَ بَنِي إِسْرَائِيلَ","prev":{"a":133,"text":"فَأَرْسَلْنَا عَلَيْهِمُ الطُّوفَانَ وَالْجَرَادَ وَالْقُمَّلَ وَالضَّفَادِعَ وَالدَّمَ آيَاتٍ مُفَصَّلَاتٍ فَاسْتَكْبَرُوا وَكَانُوا قَوْمًا مُجْرِمِينَ"},"next":{"a":135,"text":"فَلَمَّا كَشَفْنَا عَنْهُمُ الرِّجْزَ إِلَى أَجَلٍ هُمْ بَالِغُوهُ إِذَا هُمْ يَنْكُثُونَ"},"context":"آل فرعون إذا نزل بهم العذاب استغاثوا بموسى.","reason":"قالوا «ربك» لأنهم لا يعترفون به ربًّا لهم، ثم نكثوا."},{"i":33,"of":224,"s":7,"surah":"الأعراف","a":137,"text":"وَأَوْرَثْنَا الْقَوْمَ الَّذِينَ كَانُوا يُسْتَضْعَفُونَ مَشَارِقَ الْأَرْضِ وَمَغَارِبَهَا الَّتِي بَارَكْنَا فِيهَا وَتَمَّتْ كَلِمَتُ رَبِّكَ الْحُسْنَى عَلَى بَنِي إِسْرَائِيلَ بِمَا صَبَرُوا وَدَمَّرْنَا مَا كَانَ يَصْنَعُ فِرْعَوْنُ وَقَوْمُهُ وَمَا كَانُوا يَعْرِشُونَ","prev":{"a":136,"text":"فَانْتَقَمْنَا مِنْهُمْ فَأَغْرَقْنَاهُمْ فِي الْيَمِّ بِأَنَّهُمْ كَذَّبُوا بِآيَاتِنَا وَكَانُوا عَنْهَا غَافِلِينَ"},"next":{"a":138,"text":"وَجَاوَزْنَا بِبَنِي إِسْرَائِيلَ الْبَحْرَ فَأَتَوْا عَلَى قَوْمٍ يَعْكُفُونَ عَلَى أَصْنَامٍ لَهُمْ قَالُوا يَا مُوسَى اجْعَلْ لَنَا إِلَهًا كَمَا لَهُمْ آلِهَةٌ قَالَ إِنَّكُمْ قَوْمٌ تَجْهَلُونَ"},"context":"بعد إغراق فرعون، أورث الله المستضعفين الأرض.","reason":"كلمة ربك الحسنى تمّت بسبب صبرهم."},{"i":34,"of":224,"s":7,"surah":"الأعراف","a":153,"text":"وَالَّذِينَ عَمِلُوا السَّيِّئَاتِ ثُمَّ تَابُوا مِنْ بَعْدِهَا وَآمَنُوا إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ","prev":{"a":152,"text":"إِنَّ الَّذِينَ اتَّخَذُوا الْعِجْلَ سَيَنَالُهُمْ غَضَبٌ مِنْ رَبِّهِمْ وَذِلَّةٌ فِي الْحَيَاةِ الدُّنْيَا وَكَذَلِكَ نَجْزِي الْمُفْتَرِينَ"},"next":{"a":154,"text":"وَلَمَّا سَكَتَ عَنْ مُوسَى الْغَضَبُ أَخَذَ الْأَلْوَاحَ وَفِي نُسْخَتِهَا هُدًى وَرَحْمَةٌ لِلَّذِينَ هُمْ لِرَبِّهِمْ يَرْهَبُونَ"},"context":"بعد ذكر عبادة العجل وغضب الله على متّخذيه.","reason":"ربك يغفر حتى لمن عبد العجل إذا تاب وآمن."},{"i":35,"of":224,"s":7,"surah":"الأعراف","a":167,"text":"وَإِذْ تَأَذَّنَ رَبُّكَ لَيَبْعَثَنَّ عَلَيْهِمْ إِلَى يَوْمِ الْقِيَامَةِ مَنْ يَسُومُهُمْ سُوءَ الْعَذَابِ إِنَّ رَبَّكَ لَسَرِيعُ الْعِقَابِ وَإِنَّهُ لَغَفُورٌ رَحِيمٌ","prev":{"a":166,"text":"فَلَمَّا عَتَوْا عَنْ مَا نُهُوا عَنْهُ قُلْنَا لَهُمْ كُونُوا قِرَدَةً خَاسِئِينَ"},"next":{"a":168,"text":"وَقَطَّعْنَاهُمْ فِي الْأَرْضِ أُمَمًا مِنْهُمُ الصَّالِحُونَ وَمِنْهُمْ دُونَ ذَلِكَ وَبَلَوْنَاهُمْ بِالْحَسَنَاتِ وَالسَّيِّئَاتِ لَعَلَّهُمْ يَرْجِعُونَ"},"context":"بعد قصة أصحاب السبت الذين اعتدوا.","reason":"ربك أعلن عقوبة المعتدين، وأبقى باب المغفرة مفتوحًا."},{"i":36,"of":224,"s":7,"surah":"الأعراف","a":172,"text":"وَإِذْ أَخَذَ رَبُّكَ مِنْ بَنِي آدَمَ مِنْ ظُهُورِهِمْ ذُرِّيَّتَهُمْ وَأَشْهَدَهُمْ عَلَى أَنْفُسِهِمْ أَلَسْتُ بِرَبِّكُمْ قَالُوا بَلَى شَهِدْنَا أَنْ تَقُولُوا يَوْمَ الْقِيَامَةِ إِنَّا كُنَّا عَنْ هَذَا غَافِلِينَ","prev":{"a":171,"text":"وَإِذْ نَتَقْنَا الْجَبَلَ فَوْقَهُمْ كَأَنَّهُ ظُلَّةٌ وَظَنُّوا أَنَّهُ وَاقِعٌ بِهِمْ خُذُوا مَا آتَيْنَاكُمْ بِقُوَّةٍ وَاذْكُرُوا مَا فِيهِ لَعَلَّكُمْ تَتَّقُونَ"},"next":{"a":173,"text":"أَوْ تَقُولُوا إِنَّمَا أَشْرَكَ آبَاؤُنَا مِنْ قَبْلُ وَكُنَّا ذُرِّيَّةً مِنْ بَعْدِهِمْ أَفَتُهْلِكُنَا بِمَا فَعَلَ الْمُبْطِلُونَ"},"context":"ميثاق الذرية المأخوذ من بني آدم.","reason":"ربك أخذ الميثاق على الربوبية حتى لا يحتجّ أحدٌ بالغفلة."},{"i":37,"of":224,"s":7,"surah":"الأعراف","a":205,"text":"وَاذْكُرْ رَبَّكَ فِي نَفْسِكَ تَضَرُّعًا وَخِيفَةً وَدُونَ الْجَهْرِ مِنَ الْقَوْلِ بِالْغُدُوِّ وَالْآصَالِ وَلَا تَكُنْ مِنَ الْغَافِلِينَ","prev":{"a":204,"text":"وَإِذَا قُرِئَ الْقُرْآنُ فَاسْتَمِعُوا لَهُ وَأَنْصِتُوا لَعَلَّكُمْ تُرْحَمُونَ"},"next":{"a":206,"text":"إِنَّ الَّذِينَ عِنْدَ رَبِّكَ لَا يَسْتَكْبِرُونَ عَنْ عِبَادَتِهِ وَيُسَبِّحُونَهُ وَلَهُ يَسْجُدُونَ"},"context":"بعد الأمر بالإنصات للقرآن.","reason":"ذكر ربك في النفس تضرّعًا وخيفة هو أدب العبد مع مربّيه."},{"i":38,"of":224,"s":7,"surah":"الأعراف","a":206,"text":"إِنَّ الَّذِينَ عِنْدَ رَبِّكَ لَا يَسْتَكْبِرُونَ عَنْ عِبَادَتِهِ وَيُسَبِّحُونَهُ وَلَهُ يَسْجُدُونَ","prev":{"a":205,"text":"وَاذْكُرْ رَبَّكَ فِي نَفْسِكَ تَضَرُّعًا وَخِيفَةً وَدُونَ الْجَهْرِ مِنَ الْقَوْلِ بِالْغُدُوِّ وَالْآصَالِ وَلَا تَكُنْ مِنَ الْغَافِلِينَ"},"context":"ختام الأعراف بعد الأمر بالذكر.","reason":"الملائكة عند ربك لا يستكبرون، فأولى بالبشر ألا يستكبروا."},{"i":39,"of":224,"s":8,"surah":"الأنفال","a":5,"text":"كَمَا أَخْرَجَكَ رَبُّكَ مِنْ بَيْتِكَ بِالْحَقِّ وَإِنَّ فَرِيقًا مِنَ الْمُؤْمِنِينَ لَكَارِهُونَ","prev":{"a":4,"text":"أُولَئِكَ هُمُ الْمُؤْمِنُونَ حَقًّا لَهُمْ دَرَجَاتٌ عِنْدَ رَبِّهِمْ وَمَغْفِرَةٌ وَرِزْقٌ كَرِيمٌ"},"next":{"a":6,"text":"يُجَادِلُونَكَ فِي الْحَقِّ بَعْدَمَا تَبَيَّنَ كَأَنَّمَا يُسَاقُونَ إِلَى الْمَوْتِ وَهُمْ يَنْظُرُونَ"},"context":"خلاف الصحابة في الأنفال وخروجهم إلى بدر.","reason":"ربك أخرجك بالحق وإن كره بعضهم، فكان الخير فيما قدّره."},{"i":40,"of":224,"s":8,"surah":"الأنفال","a":12,"text":"إِذْ يُوحِي رَبُّكَ إِلَى الْمَلَائِكَةِ أَنِّي مَعَكُمْ فَثَبِّتُوا الَّذِينَ آمَنُوا سَأُلْقِي فِي قُلُوبِ الَّذِينَ كَفَرُوا الرُّعْبَ فَاضْرِبُوا فَوْقَ الْأَعْنَاقِ وَاضْرِبُوا مِنْهُمْ كُلَّ بَنَانٍ","prev":{"a":11,"text":"إِذْ يُغَشِّيكُمُ النُّعَاسَ أَمَنَةً مِنْهُ وَيُنَزِّلُ عَلَيْكُمْ مِنَ السَّمَاءِ مَاءً لِيُطَهِّرَكُمْ بِهِ وَيُذْهِبَ عَنْكُمْ رِجْزَ الشَّيْطَانِ وَلِيَرْبِطَ عَلَى قُلُوبِكُمْ وَيُثَبِّتَ بِهِ الْأَقْدَامَ"},"next":{"a":13,"text":"ذَلِكَ بِأَنَّهُمْ شَاقُّوا اللَّهَ وَرَسُولَهُ وَمَنْ يُشَاقِقِ اللَّهَ وَرَسُولَهُ فَإِنَّ اللَّهَ شَدِيدُ الْعِقَابِ"},"context":"المؤمنون في بدر قلةٌ، والله ينزل النعاس والمطر تثبيتًا لهم.","reason":"ربك يوحي إلى الملائكة بمعيّته وتثبيت المؤمنين."},{"i":41,"of":224,"s":10,"surah":"يونس","a":19,"text":"وَمَا كَانَ النَّاسُ إِلَّا أُمَّةً وَاحِدَةً فَاخْتَلَفُوا وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِنْ رَبِّكَ لَقُضِيَ بَيْنَهُمْ فِيمَا فِيهِ يَخْتَلِفُونَ","prev":{"a":18,"text":"وَيَعْبُدُونَ مِنْ دُونِ اللَّهِ مَا لَا يَضُرُّهُمْ وَلَا يَنْفَعُهُمْ وَيَقُولُونَ هَؤُلَاءِ شُفَعَاؤُنَا عِنْدَ اللَّهِ قُلْ أَتُنَبِّئُونَ اللَّهَ بِمَا لَا يَعْلَمُ فِي السَّمَاوَاتِ وَلَا فِي الْأَرْضِ سُبْحَانَهُ وَتَعَالَى عَمَّا يُشْرِكُونَ"},"next":{"a":20,"text":"وَيَقُولُونَ لَوْلَا أُنْزِلَ عَلَيْهِ آيَةٌ مِنْ رَبِّهِ فَقُلْ إِنَّمَا الْغَيْبُ لِلَّهِ فَانْتَظِرُوا إِنِّي مَعَكُمْ مِنَ الْمُنْتَظِرِينَ"},"context":"بيان أن الناس كانوا أمةً واحدة ثم اختلفوا.","reason":"كلمةٌ سبقت من ربك بتأخير الفصل إلى أجله."},{"i":42,"of":224,"s":10,"surah":"يونس","a":33,"text":"كَذَلِكَ حَقَّتْ كَلِمَتُ رَبِّكَ عَلَى الَّذِينَ فَسَقُوا أَنَّهُمْ لَا يُؤْمِنُونَ","prev":{"a":32,"text":"فَذَلِكُمُ اللَّهُ رَبُّكُمُ الْحَقُّ فَمَاذَا بَعْدَ الْحَقِّ إِلَّا الضَّلَالُ فَأَنَّى تُصْرَفُونَ"},"next":{"a":34,"text":"قُلْ هَلْ مِنْ شُرَكَائِكُمْ مَنْ يَبْدَأُ الْخَلْقَ ثُمَّ يُعِيدُهُ قُلِ اللَّهُ يَبْدَأُ الْخَلْقَ ثُمَّ يُعِيدُهُ فَأَنَّى تُؤْفَكُونَ"},"context":"بعد إقامة الحجج على المشركين بالرزق والتدبير.","reason":"حقّت كلمة ربك على من فسق وأصرّ."},{"i":43,"of":224,"s":10,"surah":"يونس","a":40,"text":"وَمِنْهُمْ مَنْ يُؤْمِنُ بِهِ وَمِنْهُمْ مَنْ لَا يُؤْمِنُ بِهِ وَرَبُّكَ أَعْلَمُ بِالْمُفْسِدِينَ","prev":{"a":39,"text":"بَلْ كَذَّبُوا بِمَا لَمْ يُحِيطُوا بِعِلْمِهِ وَلَمَّا يَأْتِهِمْ تَأْوِيلُهُ كَذَلِكَ كَذَّبَ الَّذِينَ مِنْ قَبْلِهِمْ فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الظَّالِمِينَ"},"next":{"a":41,"text":"وَإِنْ كَذَّبُوكَ فَقُلْ لِي عَمَلِي وَلَكُمْ عَمَلُكُمْ أَنْتُمْ بَرِيئُونَ مِمَّا أَعْمَلُ وَأَنَا بَرِيءٌ مِمَّا تَعْمَلُونَ"},"context":"المكذبون بالقرآن قبل أن يحيطوا بعلمه.","reason":"ربك يعلم المفسدين، فليس عليك أن تُكره أحدًا."},{"i":44,"of":224,"s":10,"surah":"يونس","a":61,"text":"وَمَا تَكُونُ فِي شَأْنٍ وَمَا تَتْلُو مِنْهُ مِنْ قُرْآنٍ وَلَا تَعْمَلُونَ مِنْ عَمَلٍ إِلَّا كُنَّا عَلَيْكُمْ شُهُودًا إِذْ تُفِيضُونَ فِيهِ وَمَا يَعْزُبُ عَنْ رَبِّكَ مِنْ مِثْقَالِ ذَرَّةٍ فِي الْأَرْضِ وَلَا فِي السَّمَاءِ وَلَا أَصْغَرَ مِنْ ذَلِكَ وَلَا أَكْبَرَ إِلَّا فِي كِتَابٍ مُبِينٍ","prev":{"a":60,"text":"وَمَا ظَنُّ الَّذِينَ يَفْتَرُونَ عَلَى اللَّهِ الْكَذِبَ يَوْمَ الْقِيَامَةِ إِنَّ اللَّهَ لَذُو فَضْلٍ عَلَى النَّاسِ وَلَكِنَّ أَكْثَرَهُمْ لَا يَشْكُرُونَ"},"next":{"a":62,"text":"أَلَا إِنَّ أَوْلِيَاءَ اللَّهِ لَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ"},"context":"بيان إحاطة الله بأحوال النبي ﷺ والناس.","reason":"لا يغيب عن ربك مثقال ذرة، فكل شأنٍ مشهود."},{"i":45,"of":224,"s":10,"surah":"يونس","a":93,"text":"وَلَقَدْ بَوَّأْنَا بَنِي إِسْرَائِيلَ مُبَوَّأَ صِدْقٍ وَرَزَقْنَاهُمْ مِنَ الطَّيِّبَاتِ فَمَا اخْتَلَفُوا حَتَّى جَاءَهُمُ الْعِلْمُ إِنَّ رَبَّكَ يَقْضِي بَيْنَهُمْ يَوْمَ الْقِيَامَةِ فِيمَا كَانُوا فِيهِ يَخْتَلِفُونَ","prev":{"a":92,"text":"فَالْيَوْمَ نُنَجِّيكَ بِبَدَنِكَ لِتَكُونَ لِمَنْ خَلْفَكَ آيَةً وَإِنَّ كَثِيرًا مِنَ النَّاسِ عَنْ آيَاتِنَا لَغَافِلُونَ"},"next":{"a":94,"text":"فَإِنْ كُنْتَ فِي شَكٍّ مِمَّا أَنْزَلْنَا إِلَيْكَ فَاسْأَلِ الَّذِينَ يَقْرَءُونَ الْكِتَابَ مِنْ قَبْلِكَ لَقَدْ جَاءَكَ الْحَقُّ مِنْ رَبِّكَ فَلَا تَكُونَنَّ مِنَ الْمُمْتَرِينَ"},"context":"بعد نجاة بني إسرائيل وتمكينهم.","reason":"اختلفوا بعد العلم، وربك يقضي بينهم يوم القيامة."},{"i":46,"of":224,"s":10,"surah":"يونس","a":94,"text":"فَإِنْ كُنْتَ فِي شَكٍّ مِمَّا أَنْزَلْنَا إِلَيْكَ فَاسْأَلِ الَّذِينَ يَقْرَءُونَ الْكِتَابَ مِنْ قَبْلِكَ لَقَدْ جَاءَكَ الْحَقُّ مِنْ رَبِّكَ فَلَا تَكُونَنَّ مِنَ الْمُمْتَرِينَ","prev":{"a":93,"text":"وَلَقَدْ بَوَّأْنَا بَنِي إِسْرَائِيلَ مُبَوَّأَ صِدْقٍ وَرَزَقْنَاهُمْ مِنَ الطَّيِّبَاتِ فَمَا اخْتَلَفُوا حَتَّى جَاءَهُمُ الْعِلْمُ إِنَّ رَبَّكَ يَقْضِي بَيْنَهُمْ يَوْمَ الْقِيَامَةِ فِيمَا كَانُوا فِيهِ يَخْتَلِفُونَ"},"next":{"a":95,"text":"وَلَا تَكُونَنَّ مِنَ الَّذِينَ كَذَّبُوا بِآيَاتِ اللَّهِ فَتَكُونَ مِنَ الْخَاسِرِينَ"},"context":"خطابٌ فيه تثبيتٌ بشهادة أهل الكتاب.","reason":"ما جاءك هو الحق من ربك فلا امتراء."},{"i":47,"of":224,"s":10,"surah":"يونس","a":96,"text":"إِنَّ الَّذِينَ حَقَّتْ عَلَيْهِمْ كَلِمَتُ رَبِّكَ لَا يُؤْمِنُونَ","prev":{"a":95,"text":"وَلَا تَكُونَنَّ مِنَ الَّذِينَ كَذَّبُوا بِآيَاتِ اللَّهِ فَتَكُونَ مِنَ الْخَاسِرِينَ"},"next":{"a":97,"text":"وَلَوْ جَاءَتْهُمْ كُلُّ آيَةٍ حَتَّى يَرَوُا الْعَذَابَ الْأَلِيمَ"},"context":"ختام قصص الأنبياء وموقف المكذبين.","reason":"من حقّت عليهم كلمة ربك لا تنفعهم الآيات."},{"i":48,"of":224,"s":10,"surah":"يونس","a":99,"text":"وَلَوْ شَاءَ رَبُّكَ لَآمَنَ مَنْ فِي الْأَرْضِ كُلُّهُمْ جَمِيعًا أَفَأَنْتَ تُكْرِهُ النَّاسَ حَتَّى يَكُونُوا مُؤْمِنِينَ","prev":{"a":98,"text":"فَلَوْلَا كَانَتْ قَرْيَةٌ آمَنَتْ فَنَفَعَهَا إِيمَانُهَا إِلَّا قَوْمَ يُونُسَ لَمَّا آمَنُوا كَشَفْنَا عَنْهُمْ عَذَابَ الْخِزْيِ فِي الْحَيَاةِ الدُّنْيَا وَمَتَّعْنَاهُمْ إِلَى حِينٍ"},"next":{"a":100,"text":"وَمَا كَانَ لِنَفْسٍ أَنْ تُؤْمِنَ إِلَّا بِإِذْنِ اللَّهِ وَيَجْعَلُ الرِّجْسَ عَلَى الَّذِينَ لَا يَعْقِلُونَ"},"context":"بعد قصة قوم يونس الذين نفعهم إيمانهم.","reason":"الهداية بمشيئة ربك، لا بإكراه الداعي."},{"i":49,"of":224,"s":11,"surah":"هود","a":17,"text":"أَفَمَنْ كَانَ عَلَى بَيِّنَةٍ مِنْ رَبِّهِ وَيَتْلُوهُ شَاهِدٌ مِنْهُ وَمِنْ قَبْلِهِ كِتَابُ مُوسَى إِمَامًا وَرَحْمَةً أُولَئِكَ يُؤْمِنُونَ بِهِ وَمَنْ يَكْفُرْ بِهِ مِنَ الْأَحْزَابِ فَالنَّارُ مَوْعِدُهُ فَلَا تَكُ فِي مِرْيَةٍ مِنْهُ إِنَّهُ الْحَقُّ مِنْ رَبِّكَ وَلَكِنَّ أَكْثَرَ النَّاسِ لَا يُؤْمِنُونَ","prev":{"a":16,"text":"أُولَئِكَ الَّذِينَ لَيْسَ لَهُمْ فِي الْآخِرَةِ إِلَّا النَّارُ وَحَبِطَ مَا صَنَعُوا فِيهَا وَبَاطِلٌ مَا كَانُوا يَعْمَلُونَ"},"next":{"a":18,"text":"وَمَنْ أَظْلَمُ مِمَّنِ افْتَرَى عَلَى اللَّهِ كَذِبًا أُولَئِكَ يُعْرَضُونَ عَلَى رَبِّهِمْ وَيَقُولُ الْأَشْهَادُ هَؤُلَاءِ الَّذِينَ كَذَبُوا عَلَى رَبِّهِمْ أَلَا لَعْنَةُ اللَّهِ عَلَى الظَّالِمِينَ"},"context":"الموازنة بين من كان على بيّنة ومن يريد الحياة الدنيا.","reason":"القرآن الحق من ربك وإن لم يؤمن به أكثر الناس."},{"i":50,"of":224,"s":11,"surah":"هود","a":66,"text":"فَلَمَّا جَاءَ أَمْرُنَا نَجَّيْنَا صَالِحًا وَالَّذِينَ آمَنُوا مَعَهُ بِرَحْمَةٍ مِنَّا وَمِنْ خِزْيِ يَوْمِئِذٍ إِنَّ رَبَّكَ هُوَ الْقَوِيُّ الْعَزِيزُ","prev":{"a":65,"text":"فَعَقَرُوهَا فَقَالَ تَمَتَّعُوا فِي دَارِكُمْ ثَلَاثَةَ أَيَّامٍ ذَلِكَ وَعْدٌ غَيْرُ مَكْذُوبٍ"},"next":{"a":67,"text":"وَأَخَذَ الَّذِينَ ظَلَمُوا الصَّيْحَةُ فَأَصْبَحُوا فِي دِيَارِهِمْ جَاثِمِينَ"},"context":"هلاك ثمود بعد عقر الناقة.","reason":"ربك القويّ العزيز نجّى صالحًا ومن معه."},{"i":51,"of":224,"s":11,"surah":"هود","a":76,"text":"يَا إِبْرَاهِيمُ أَعْرِضْ عَنْ هَذَا إِنَّهُ قَدْ جَاءَ أَمْرُ رَبِّكَ وَإِنَّهُمْ آتِيهِمْ عَذَابٌ غَيْرُ مَرْدُودٍ","prev":{"a":75,"text":"إِنَّ إِبْرَاهِيمَ لَحَلِيمٌ أَوَّاهٌ مُنِيبٌ"},"next":{"a":77,"text":"وَلَمَّا جَاءَتْ رُسُلُنَا لُوطًا سِيءَ بِهِمْ وَضَاقَ بِهِمْ ذَرْعًا وَقَالَ هَذَا يَوْمٌ عَصِيبٌ"},"context":"إبراهيم يجادل الملائكة في قوم لوط.","reason":"أمر ربك نافذٌ فلا مجادلة فيه."},{"i":52,"of":224,"s":11,"surah":"هود","a":81,"text":"قَالُوا يَا لُوطُ إِنَّا رُسُلُ رَبِّكَ لَنْ يَصِلُوا إِلَيْكَ فَأَسْرِ بِأَهْلِكَ بِقِطْعٍ مِنَ اللَّيْلِ وَلَا يَلْتَفِتْ مِنْكُمْ أَحَدٌ إِلَّا امْرَأَتَكَ إِنَّهُ مُصِيبُهَا مَا أَصَابَهُمْ إِنَّ مَوْعِدَهُمُ الصُّبْحُ أَلَيْسَ الصُّبْحُ بِقَرِيبٍ","prev":{"a":80,"text":"قَالَ لَوْ أَنَّ لِي بِكُمْ قُوَّةً أَوْ آوِي إِلَى رُكْنٍ شَدِيدٍ"},"next":{"a":82,"text":"فَلَمَّا جَاءَ أَمْرُنَا جَعَلْنَا عَالِيَهَا سَافِلَهَا وَأَمْطَرْنَا عَلَيْهَا حِجَارَةً مِنْ سِجِّيلٍ مَنْضُودٍ"},"context":"لوط يضيق بقومه حين أرادوا ضيفه.","reason":"رسل ربك يطمئنون لوطًا بأنهم لن يصلوا إليه."},{"i":53,"of":224,"s":11,"surah":"هود","a":83,"text":"مُسَوَّمَةً عِنْدَ رَبِّكَ وَمَا هِيَ مِنَ الظَّالِمِينَ بِبَعِيدٍ","prev":{"a":82,"text":"فَلَمَّا جَاءَ أَمْرُنَا جَعَلْنَا عَالِيَهَا سَافِلَهَا وَأَمْطَرْنَا عَلَيْهَا حِجَارَةً مِنْ سِجِّيلٍ مَنْضُودٍ"},"next":{"a":84,"text":"وَإِلَى مَدْيَنَ أَخَاهُمْ شُعَيْبًا قَالَ يَا قَوْمِ اعْبُدُوا اللَّهَ مَا لَكُمْ مِنْ إِلَهٍ غَيْرُهُ وَلَا تَنْقُصُوا الْمِكْيَالَ وَالْمِيزَانَ إِنِّي أَرَاكُمْ بِخَيْرٍ وَإِنِّي أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ مُحِيطٍ"},"context":"وصف الحجارة التي أُمطرت على قوم لوط.","reason":"الحجارة معلَّمةٌ عند ربك، والعقوبة غير بعيدة عن الظالمين."},{"i":54,"of":224,"s":11,"surah":"هود","a":101,"text":"وَمَا ظَلَمْنَاهُمْ وَلَكِنْ ظَلَمُوا أَنْفُسَهُمْ فَمَا أَغْنَتْ عَنْهُمْ آلِهَتُهُمُ الَّتِي يَدْعُونَ مِنْ دُونِ اللَّهِ مِنْ شَيْءٍ لَمَّا جَاءَ أَمْرُ رَبِّكَ وَمَا زَادُوهُمْ غَيْرَ تَتْبِيبٍ","prev":{"a":100,"text":"ذَلِكَ مِنْ أَنْبَاءِ الْقُرَى نَقُصُّهُ عَلَيْكَ مِنْهَا قَائِمٌ وَحَصِيدٌ"},"next":{"a":102,"text":"وَكَذَلِكَ أَخْذُ رَبِّكَ إِذَا أَخَذَ الْقُرَى وَهِيَ ظَالِمَةٌ إِنَّ أَخْذَهُ أَلِيمٌ شَدِيدٌ"},"context":"خلاصة قصص الأمم المهلكة.","reason":"لم تُغنِ عنهم آلهتهم حين جاء أمر ربك."},{"i":55,"of":224,"s":11,"surah":"هود","a":102,"text":"وَكَذَلِكَ أَخْذُ رَبِّكَ إِذَا أَخَذَ الْقُرَى وَهِيَ ظَالِمَةٌ إِنَّ أَخْذَهُ أَلِيمٌ شَدِيدٌ","prev":{"a":101,"text":"وَمَا ظَلَمْنَاهُمْ وَلَكِنْ ظَلَمُوا أَنْفُسَهُمْ فَمَا أَغْنَتْ عَنْهُمْ آلِهَتُهُمُ الَّتِي يَدْعُونَ مِنْ دُونِ اللَّهِ مِنْ شَيْءٍ لَمَّا جَاءَ أَمْرُ رَبِّكَ وَمَا زَادُوهُمْ غَيْرَ تَتْبِيبٍ"},"next":{"a":103,"text":"إِنَّ فِي ذَلِكَ لَآيَةً لِمَنْ خَافَ عَذَابَ الْآخِرَةِ ذَلِكَ يَوْمٌ مَجْمُوعٌ لَهُ النَّاسُ وَذَلِكَ يَوْمٌ مَشْهُودٌ"},"context":"ختام التعقيب على هلاك الأمم.","reason":"هذه سنة ربك في أخذ القرى الظالمة."},{"i":56,"of":224,"s":11,"surah":"هود","a":107,"text":"خَالِدِينَ فِيهَا مَا دَامَتِ السَّمَاوَاتُ وَالْأَرْضُ إِلَّا مَا شَاءَ رَبُّكَ إِنَّ رَبَّكَ فَعَّالٌ لِمَا يُرِيدُ","prev":{"a":106,"text":"فَأَمَّا الَّذِينَ شَقُوا فَفِي النَّارِ لَهُمْ فِيهَا زَفِيرٌ وَشَهِيقٌ"},"next":{"a":108,"text":"وَأَمَّا الَّذِينَ سُعِدُوا فَفِي الْجَنَّةِ خَالِدِينَ فِيهَا مَا دَامَتِ السَّمَاوَاتُ وَالْأَرْضُ إِلَّا مَا شَاءَ رَبُّكَ عَطَاءً غَيْرَ مَجْذُوذٍ"},"context":"وصف حال الأشقياء في النار يوم القيامة.","reason":"مصيرهم معلّقٌ بمشيئة ربك الفعّال لما يريد."},{"i":57,"of":224,"s":11,"surah":"هود","a":108,"text":"وَأَمَّا الَّذِينَ سُعِدُوا فَفِي الْجَنَّةِ خَالِدِينَ فِيهَا مَا دَامَتِ السَّمَاوَاتُ وَالْأَرْضُ إِلَّا مَا شَاءَ رَبُّكَ عَطَاءً غَيْرَ مَجْذُوذٍ","prev":{"a":107,"text":"خَالِدِينَ فِيهَا مَا دَامَتِ السَّمَاوَاتُ وَالْأَرْضُ إِلَّا مَا شَاءَ رَبُّكَ إِنَّ رَبَّكَ فَعَّالٌ لِمَا يُرِيدُ"},"next":{"a":109,"text":"فَلَا تَكُ فِي مِرْيَةٍ مِمَّا يَعْبُدُ هَؤُلَاءِ مَا يَعْبُدُونَ إِلَّا كَمَا يَعْبُدُ آبَاؤُهُمْ مِنْ قَبْلُ وَإِنَّا لَمُوَفُّوهُمْ نَصِيبَهُمْ غَيْرَ مَنْقُوصٍ"},"context":"بعد ذكر الأشقياء يأتي ذكر السعداء.","reason":"نعيم الجنة عطاءٌ من ربك لا ينقطع."},{"i":58,"of":224,"s":11,"surah":"هود","a":110,"text":"وَلَقَدْ آتَيْنَا مُوسَى الْكِتَابَ فَاخْتُلِفَ فِيهِ وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِنْ رَبِّكَ لَقُضِيَ بَيْنَهُمْ وَإِنَّهُمْ لَفِي شَكٍّ مِنْهُ مُرِيبٍ","prev":{"a":109,"text":"فَلَا تَكُ فِي مِرْيَةٍ مِمَّا يَعْبُدُ هَؤُلَاءِ مَا يَعْبُدُونَ إِلَّا كَمَا يَعْبُدُ آبَاؤُهُمْ مِنْ قَبْلُ وَإِنَّا لَمُوَفُّوهُمْ نَصِيبَهُمْ غَيْرَ مَنْقُوصٍ"},"next":{"a":111,"text":"وَإِنَّ كُلًّا لَمَّا لَيُوَفِّيَنَّهُمْ رَبُّكَ أَعْمَالَهُمْ إِنَّهُ بِمَا يَعْمَلُونَ خَبِيرٌ"},"context":"اختلاف قوم موسى في الكتاب كاختلاف قوم محمد ﷺ.","reason":"تأخير الفصل كلمةٌ سبقت من ربك."},{"i":59,"of":224,"s":11,"surah":"هود","a":111,"text":"وَإِنَّ كُلًّا لَمَّا لَيُوَفِّيَنَّهُمْ رَبُّكَ أَعْمَالَهُمْ إِنَّهُ بِمَا يَعْمَلُونَ خَبِيرٌ","prev":{"a":110,"text":"وَلَقَدْ آتَيْنَا مُوسَى الْكِتَابَ فَاخْتُلِفَ فِيهِ وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِنْ رَبِّكَ لَقُضِيَ بَيْنَهُمْ وَإِنَّهُمْ لَفِي شَكٍّ مِنْهُ مُرِيبٍ"},"next":{"a":112,"text":"فَاسْتَقِمْ كَمَا أُمِرْتَ وَمَنْ تَابَ مَعَكَ وَلَا تَطْغَوْا إِنَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ"},"context":"بعد ذكر الاختلاف في الكتاب.","reason":"ربك يوفّي كل عاملٍ عمله لأنه خبيرٌ به."},{"i":60,"of":224,"s":11,"surah":"هود","a":117,"text":"وَمَا كَانَ رَبُّكَ لِيُهْلِكَ الْقُرَى بِظُلْمٍ وَأَهْلُهَا مُصْلِحُونَ","prev":{"a":116,"text":"فَلَوْلَا كَانَ مِنَ الْقُرُونِ مِنْ قَبْلِكُمْ أُولُو بَقِيَّةٍ يَنْهَوْنَ عَنِ الْفَسَادِ فِي الْأَرْضِ إِلَّا قَلِيلًا مِمَّنْ أَنْجَيْنَا مِنْهُمْ وَاتَّبَعَ الَّذِينَ ظَلَمُوا مَا أُتْرِفُوا فِيهِ وَكَانُوا مُجْرِمِينَ"},"next":{"a":118,"text":"وَلَوْ شَاءَ رَبُّكَ لَجَعَلَ النَّاسَ أُمَّةً وَاحِدَةً وَلَا يَزَالُونَ مُخْتَلِفِينَ"},"context":"بعد ذكر أولي البقية الذين ينهون عن الفساد.","reason":"ربك لا يهلك قومًا مصلحين، فالإصلاح أمان."},{"i":61,"of":224,"s":11,"surah":"هود","a":118,"text":"وَلَوْ شَاءَ رَبُّكَ لَجَعَلَ النَّاسَ أُمَّةً وَاحِدَةً وَلَا يَزَالُونَ مُخْتَلِفِينَ","prev":{"a":117,"text":"وَمَا كَانَ رَبُّكَ لِيُهْلِكَ الْقُرَى بِظُلْمٍ وَأَهْلُهَا مُصْلِحُونَ"},"next":{"a":119,"text":"إِلَّا مَنْ رَحِمَ رَبُّكَ وَلِذَلِكَ خَلَقَهُمْ وَتَمَّتْ كَلِمَةُ رَبِّكَ لَأَمْلَأَنَّ جَهَنَّمَ مِنَ الْجِنَّةِ وَالنَّاسِ أَجْمَعِينَ"},"context":"بيان سنة الاختلاف بين الناس.","reason":"الاختلاف بمشيئة ربك وحكمته، لا عجزًا عن جمعهم."},{"i":62,"of":224,"s":11,"surah":"هود","a":119,"text":"إِلَّا مَنْ رَحِمَ رَبُّكَ وَلِذَلِكَ خَلَقَهُمْ وَتَمَّتْ كَلِمَةُ رَبِّكَ لَأَمْلَأَنَّ جَهَنَّمَ مِنَ الْجِنَّةِ وَالنَّاسِ أَجْمَعِينَ","prev":{"a":118,"text":"وَلَوْ شَاءَ رَبُّكَ لَجَعَلَ النَّاسَ أُمَّةً وَاحِدَةً وَلَا يَزَالُونَ مُخْتَلِفِينَ"},"next":{"a":120,"text":"وَكُلًّا نَقُصُّ عَلَيْكَ مِنْ أَنْبَاءِ الرُّسُلِ مَا نُثَبِّتُ بِهِ فُؤَادَكَ وَجَاءَكَ فِي هَذِهِ الْحَقُّ وَمَوْعِظَةٌ وَذِكْرَى لِلْمُؤْمِنِينَ"},"context":"استثناء المرحومين من الاختلاف المذموم.","reason":"النجاة من الخلاف برحمة ربك."},{"i":63,"of":224,"s":11,"surah":"هود","a":123,"text":"وَلِلَّهِ غَيْبُ السَّمَاوَاتِ وَالْأَرْضِ وَإِلَيْهِ يُرْجَعُ الْأَمْرُ كُلُّهُ فَاعْبُدْهُ وَتَوَكَّلْ عَلَيْهِ وَمَا رَبُّكَ بِغَافِلٍ عَمَّا تَعْمَلُونَ","prev":{"a":122,"text":"وَانْتَظِرُوا إِنَّا مُنْتَظِرُونَ"},"context":"ختام سورة هود بعد قصص الأنبياء.","reason":"ربك لا يغفل عن عملك، فاعبده وتوكّل عليه."},{"i":64,"of":224,"s":12,"surah":"يوسف","a":6,"text":"وَكَذَلِكَ يَجْتَبِيكَ رَبُّكَ وَيُعَلِّمُكَ مِنْ تَأْوِيلِ الْأَحَادِيثِ وَيُتِمُّ نِعْمَتَهُ عَلَيْكَ وَعَلَى آلِ يَعْقُوبَ كَمَا أَتَمَّهَا عَلَى أَبَوَيْكَ مِنْ قَبْلُ إِبْرَاهِيمَ وَإِسْحَاقَ إِنَّ رَبَّكَ عَلِيمٌ حَكِيمٌ","prev":{"a":5,"text":"قَالَ يَا بُنَيَّ لَا تَقْصُصْ رُؤْيَاكَ عَلَى إِخْوَتِكَ فَيَكِيدُوا لَكَ كَيْدًا إِنَّ الشَّيْطَانَ لِلْإِنْسَانِ عَدُوٌّ مُبِينٌ"},"next":{"a":7,"text":"لَقَدْ كَانَ فِي يُوسُفَ وَإِخْوَتِهِ آيَاتٌ لِلسَّائِلِينَ"},"context":"يوسف يقصّ رؤياه على أبيه.","reason":"ربك يجتبيك ويتمّ نعمته عليك بعلمه وحكمته."},{"i":65,"of":224,"s":13,"surah":"الرعد","a":1,"text":"المر تِلْكَ آيَاتُ الْكِتَابِ وَالَّذِي أُنْزِلَ إِلَيْكَ مِنْ رَبِّكَ الْحَقُّ وَلَكِنَّ أَكْثَرَ النَّاسِ لَا يُؤْمِنُونَ","next":{"a":2,"text":"اللَّهُ الَّذِي رَفَعَ السَّمَاوَاتِ بِغَيْرِ عَمَدٍ تَرَوْنَهَا ثُمَّ اسْتَوَى عَلَى الْعَرْشِ وَسَخَّرَ الشَّمْسَ وَالْقَمَرَ كُلٌّ يَجْرِي لِأَجَلٍ مُسَمًّى يُدَبِّرُ الْأَمْرَ يُفَصِّلُ الْآيَاتِ لَعَلَّكُمْ بِلِقَاءِ رَبِّكُمْ تُوقِنُونَ"},"context":"افتتاح سورة الرعد بالحروف المقطعة.","reason":"المنزل من ربك هو الحق وإن أعرض أكثر الناس."},{"i":66,"of":224,"s":13,"surah":"الرعد","a":6,"text":"وَيَسْتَعْجِلُونَكَ بِالسَّيِّئَةِ قَبْلَ الْحَسَنَةِ وَقَدْ خَلَتْ مِنْ قَبْلِهِمُ الْمَثُلَاتُ وَإِنَّ رَبَّكَ لَذُو مَغْفِرَةٍ لِلنَّاسِ عَلَى ظُلْمِهِمْ وَإِنَّ رَبَّكَ لَشَدِيدُ الْعِقَابِ","prev":{"a":5,"text":"وَإِنْ تَعْجَبْ فَعَجَبٌ قَوْلُهُمْ أَإِذَا كُنَّا تُرَابًا أَإِنَّا لَفِي خَلْقٍ جَدِيدٍ أُولَئِكَ الَّذِينَ كَفَرُوا بِرَبِّهِمْ وَأُولَئِكَ الْأَغْلَالُ فِي أَعْنَاقِهِمْ وَأُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ"},"next":{"a":7,"text":"وَيَقُولُ الَّذِينَ كَفَرُوا لَوْلَا أُنْزِلَ عَلَيْهِ آيَةٌ مِنْ رَبِّهِ إِنَّمَا أَنْتَ مُنْذِرٌ وَلِكُلِّ قَوْمٍ هَادٍ"},"context":"المشركون يستعجلون العذاب استهزاءً.","reason":"ربك يجمع مغفرةً تسع ظلم الناس وعقابًا شديدًا."},{"i":67,"of":224,"s":13,"surah":"الرعد","a":19,"text":"أَفَمَنْ يَعْلَمُ أَنَّمَا أُنْزِلَ إِلَيْكَ مِنْ رَبِّكَ الْحَقُّ كَمَنْ هُوَ أَعْمَى إِنَّمَا يَتَذَكَّرُ أُولُو الْأَلْبَابِ","prev":{"a":18,"text":"لِلَّذِينَ اسْتَجَابُوا لِرَبِّهِمُ الْحُسْنَى وَالَّذِينَ لَمْ يَسْتَجِيبُوا لَهُ لَوْ أَنَّ لَهُمْ مَا فِي الْأَرْضِ جَمِيعًا وَمِثْلَهُ مَعَهُ لَافْتَدَوْا بِهِ أُولَئِكَ لَهُمْ سُوءُ الْحِسَابِ وَمَأْوَاهُمْ جَهَنَّمُ وَبِئْسَ الْمِهَادُ"},"next":{"a":20,"text":"الَّذِينَ يُوفُونَ بِعَهْدِ اللَّهِ وَلَا يَنْقُضُونَ الْمِيثَاقَ"},"context":"بعد ضرب المثل للحق والباطل بالزبد.","reason":"العالم بأن ما أنزل من ربك حقٌّ ليس كالأعمى."},{"i":68,"of":224,"s":15,"surah":"الحجر","a":25,"text":"وَإِنَّ رَبَّكَ هُوَ يَحْشُرُهُمْ إِنَّهُ حَكِيمٌ عَلِيمٌ","prev":{"a":24,"text":"وَلَقَدْ عَلِمْنَا الْمُسْتَقْدِمِينَ مِنْكُمْ وَلَقَدْ عَلِمْنَا الْمُسْتَأْخِرِينَ"},"next":{"a":26,"text":"وَلَقَدْ خَلَقْنَا الْإِنْسَانَ مِنْ صَلْصَالٍ مِنْ حَمَإٍ مَسْنُونٍ"},"context":"ذكر إحاطة الله بالمتقدمين والمستأخرين.","reason":"ربك يحشر الجميع بحكمته وعلمه."},{"i":69,"of":224,"s":15,"surah":"الحجر","a":28,"text":"وَإِذْ قَالَ رَبُّكَ لِلْمَلَائِكَةِ إِنِّي خَالِقٌ بَشَرًا مِنْ صَلْصَالٍ مِنْ حَمَإٍ مَسْنُونٍ","prev":{"a":27,"text":"وَالْجَانَّ خَلَقْنَاهُ مِنْ قَبْلُ مِنْ نَارِ السَّمُومِ"},"next":{"a":29,"text":"فَإِذَا سَوَّيْتُهُ وَنَفَخْتُ فِيهِ مِنْ رُوحِي فَقَعُوا لَهُ سَاجِدِينَ"},"context":"بداية قصة خلق آدم.","reason":"ربك هو الخالق للبشر من صلصالٍ مسنون."},{"i":70,"of":224,"s":15,"surah":"الحجر","a":86,"text":"إِنَّ رَبَّكَ هُوَ الْخَلَّاقُ الْعَلِيمُ","prev":{"a":85,"text":"وَمَا خَلَقْنَا السَّمَاوَاتِ وَالْأَرْضَ وَمَا بَيْنَهُمَا إِلَّا بِالْحَقِّ وَإِنَّ السَّاعَةَ لَآتِيَةٌ فَاصْفَحِ الصَّفْحَ الْجَمِيلَ"},"next":{"a":87,"text":"وَلَقَدْ آتَيْنَاكَ سَبْعًا مِنَ الْمَثَانِي وَالْقُرْآنَ الْعَظِيمَ"},"context":"الأمر بالصفح الجميل عن المكذبين.","reason":"ربك الخلّاق العليم يتولّى الجزاء، فاصفح."},{"i":71,"of":224,"s":15,"surah":"الحجر","a":92,"text":"فَوَرَبِّكَ لَنَسْأَلَنَّهُمْ أَجْمَعِينَ","prev":{"a":91,"text":"الَّذِينَ جَعَلُوا الْقُرْآنَ عِضِينَ"},"next":{"a":93,"text":"عَمَّا كَانُوا يَعْمَلُونَ"},"context":"المقتسمون الذين جعلوا القرآن عضين.","reason":"أقسم بربوبيته للنبي ﷺ على سؤالهم جميعًا."},{"i":72,"of":224,"s":15,"surah":"الحجر","a":98,"text":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَكُنْ مِنَ السَّاجِدِينَ","prev":{"a":97,"text":"وَلَقَدْ نَعْلَمُ أَنَّكَ يَضِيقُ صَدْرُكَ بِمَا يَقُولُونَ"},"next":{"a":99,"text":"وَاعْبُدْ رَبَّكَ حَتَّى يَأْتِيَكَ الْيَقِينُ"},"context":"النبي ﷺ يضيق صدره بما يقولون.","reason":"علاج الضيق التسبيح بحمد ربك والسجود."},{"i":73,"of":224,"s":15,"surah":"الحجر","a":99,"text":"وَاعْبُدْ رَبَّكَ حَتَّى يَأْتِيَكَ الْيَقِينُ","prev":{"a":98,"text":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَكُنْ مِنَ السَّاجِدِينَ"},"context":"ختام سورة الحجر.","reason":"عبادة ربك ممتدةٌ حتى الموت بلا انقطاع."},{"i":74,"of":224,"s":16,"surah":"النحل","a":33,"text":"هَلْ يَنْظُرُونَ إِلَّا أَنْ تَأْتِيَهُمُ الْمَلَائِكَةُ أَوْ يَأْتِيَ أَمْرُ رَبِّكَ كَذَلِكَ فَعَلَ الَّذِينَ مِنْ قَبْلِهِمْ وَمَا ظَلَمَهُمُ اللَّهُ وَلَكِنْ كَانُوا أَنْفُسَهُمْ يَظْلِمُونَ","prev":{"a":32,"text":"الَّذِينَ تَتَوَفَّاهُمُ الْمَلَائِكَةُ طَيِّبِينَ يَقُولُونَ سَلَامٌ عَلَيْكُمُ ادْخُلُوا الْجَنَّةَ بِمَا كُنْتُمْ تَعْمَلُونَ"},"next":{"a":34,"text":"فَأَصَابَهُمْ سَيِّئَاتُ مَا عَمِلُوا وَحَاقَ بِهِمْ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ"},"context":"المكذبون لا ينتظرون إلا الموت أو العذاب.","reason":"أمر ربك آتٍ، وما ظلمهم الله."},{"i":75,"of":224,"s":16,"surah":"النحل","a":68,"text":"وَأَوْحَى رَبُّكَ إِلَى النَّحْلِ أَنِ اتَّخِذِي مِنَ الْجِبَالِ بُيُوتًا وَمِنَ الشَّجَرِ وَمِمَّا يَعْرِشُونَ","prev":{"a":67,"text":"وَمِنْ ثَمَرَاتِ النَّخِيلِ وَالْأَعْنَابِ تَتَّخِذُونَ مِنْهُ سَكَرًا وَرِزْقًا حَسَنًا إِنَّ فِي ذَلِكَ لَآيَةً لِقَوْمٍ يَعْقِلُونَ"},"next":{"a":69,"text":"ثُمَّ كُلِي مِنْ كُلِّ الثَّمَرَاتِ فَاسْلُكِي سُبُلَ رَبِّكِ ذُلُلًا يَخْرُجُ مِنْ بُطُونِهَا شَرَابٌ مُخْتَلِفٌ أَلْوَانُهُ فِيهِ شِفَاءٌ لِلنَّاسِ إِنَّ فِي ذَلِكَ لَآيَةً لِقَوْمٍ يَتَفَكَّرُونَ"},"context":"تعداد نعم الله في الأنعام والثمرات.","reason":"ربك ألهم النحل صنعتها، فالتدبير منه."},{"i":76,"of":224,"s":16,"surah":"النحل","a":69,"text":"ثُمَّ كُلِي مِنْ كُلِّ الثَّمَرَاتِ فَاسْلُكِي سُبُلَ رَبِّكِ ذُلُلًا يَخْرُجُ مِنْ بُطُونِهَا شَرَابٌ مُخْتَلِفٌ أَلْوَانُهُ فِيهِ شِفَاءٌ لِلنَّاسِ إِنَّ فِي ذَلِكَ لَآيَةً لِقَوْمٍ يَتَفَكَّرُونَ","prev":{"a":68,"text":"وَأَوْحَى رَبُّكَ إِلَى النَّحْلِ أَنِ اتَّخِذِي مِنَ الْجِبَالِ بُيُوتًا وَمِنَ الشَّجَرِ وَمِمَّا يَعْرِشُونَ"},"next":{"a":70,"text":"وَاللَّهُ خَلَقَكُمْ ثُمَّ يَتَوَفَّاكُمْ وَمِنْكُمْ مَنْ يُرَدُّ إِلَى أَرْذَلِ الْعُمُرِ لِكَيْ لَا يَعْلَمَ بَعْدَ عِلْمٍ شَيْئًا إِنَّ اللَّهَ عَلِيمٌ قَدِيرٌ"},"context":"تتمة إلهام النحل.","reason":"سبل ربك مذلّلةٌ للنحل، فيخرج منها شفاء."},{"i":77,"of":224,"s":16,"surah":"النحل","a":102,"text":"قُلْ نَزَّلَهُ رُوحُ الْقُدُسِ مِنْ رَبِّكَ بِالْحَقِّ لِيُثَبِّتَ الَّذِينَ آمَنُوا وَهُدًى وَبُشْرَى لِلْمُسْلِمِينَ","prev":{"a":101,"text":"وَإِذَا بَدَّلْنَا آيَةً مَكَانَ آيَةٍ وَاللَّهُ أَعْلَمُ بِمَا يُنَزِّلُ قَالُوا إِنَّمَا أَنْتَ مُفْتَرٍ بَلْ أَكْثَرُهُمْ لَا يَعْلَمُونَ"},"next":{"a":103,"text":"وَلَقَدْ نَعْلَمُ أَنَّهُمْ يَقُولُونَ إِنَّمَا يُعَلِّمُهُ بَشَرٌ لِسَانُ الَّذِي يُلْحِدُونَ إِلَيْهِ أَعْجَمِيٌّ وَهَذَا لِسَانٌ عَرَبِيٌّ مُبِينٌ"},"context":"المشركون يتهمون النبي ﷺ بالافتراء عند النسخ.","reason":"القرآن نزل من ربك بالحق ليثبّت المؤمنين."},{"i":78,"of":224,"s":16,"surah":"النحل","a":110,"text":"ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ هَاجَرُوا مِنْ بَعْدِ مَا فُتِنُوا ثُمَّ جَاهَدُوا وَصَبَرُوا إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ","prev":{"a":109,"text":"لَا جَرَمَ أَنَّهُمْ فِي الْآخِرَةِ هُمُ الْخَاسِرُونَ"},"next":{"a":111,"text":"يَوْمَ تَأْتِي كُلُّ نَفْسٍ تُجَادِلُ عَنْ نَفْسِهَا وَتُوَفَّى كُلُّ نَفْسٍ مَا عَمِلَتْ وَهُمْ لَا يُظْلَمُونَ"},"context":"بعد ذكر من أُكره على الكفر وقلبه مطمئن.","reason":"ربك يغفر لمن هاجر وجاهد وصبر بعد الفتنة."},{"i":79,"of":224,"s":16,"surah":"النحل","a":119,"text":"ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ عَمِلُوا السُّوءَ بِجَهَالَةٍ ثُمَّ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ","prev":{"a":118,"text":"وَعَلَى الَّذِينَ هَادُوا حَرَّمْنَا مَا قَصَصْنَا عَلَيْكَ مِنْ قَبْلُ وَمَا ظَلَمْنَاهُمْ وَلَكِنْ كَانُوا أَنْفُسَهُمْ يَظْلِمُونَ"},"next":{"a":120,"text":"إِنَّ إِبْرَاهِيمَ كَانَ أُمَّةً قَانِتًا لِلَّهِ حَنِيفًا وَلَمْ يَكُ مِنَ الْمُشْرِكِينَ"},"context":"بعد بيان ما حرّم الله والنهي عن الكذب عليه.","reason":"ربك يغفر لمن عمل السوء بجهالة ثم تاب وأصلح."},{"i":80,"of":224,"s":16,"surah":"النحل","a":124,"text":"إِنَّمَا جُعِلَ السَّبْتُ عَلَى الَّذِينَ اخْتَلَفُوا فِيهِ وَإِنَّ رَبَّكَ لَيَحْكُمُ بَيْنَهُمْ يَوْمَ الْقِيَامَةِ فِيمَا كَانُوا فِيهِ يَخْتَلِفُونَ","prev":{"a":123,"text":"ثُمَّ أَوْحَيْنَا إِلَيْكَ أَنِ اتَّبِعْ مِلَّةَ إِبْرَاهِيمَ حَنِيفًا وَمَا كَانَ مِنَ الْمُشْرِكِينَ"},"next":{"a":125,"text":"ادْعُ إِلَى سَبِيلِ رَبِّكَ بِالْحِكْمَةِ وَالْمَوْعِظَةِ الْحَسَنَةِ وَجَادِلْهُمْ بِالَّتِي هِيَ أَحْسَنُ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَنْ ضَلَّ عَنْ سَبِيلِهِ وَهُوَ أَعْلَمُ بِالْمُهْتَدِينَ"},"context":"بعد ذكر ملة إبراهيم الحنيفية.","reason":"ربك هو الحاكم بين المختلفين يوم القيامة."},{"i":81,"of":224,"s":16,"surah":"النحل","a":125,"text":"ادْعُ إِلَى سَبِيلِ رَبِّكَ بِالْحِكْمَةِ وَالْمَوْعِظَةِ الْحَسَنَةِ وَجَادِلْهُمْ بِالَّتِي هِيَ أَحْسَنُ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَنْ ضَلَّ عَنْ سَبِيلِهِ وَهُوَ أَعْلَمُ بِالْمُهْتَدِينَ","prev":{"a":124,"text":"إِنَّمَا جُعِلَ السَّبْتُ عَلَى الَّذِينَ اخْتَلَفُوا فِيهِ وَإِنَّ رَبَّكَ لَيَحْكُمُ بَيْنَهُمْ يَوْمَ الْقِيَامَةِ فِيمَا كَانُوا فِيهِ يَخْتَلِفُونَ"},"next":{"a":126,"text":"وَإِنْ عَاقَبْتُمْ فَعَاقِبُوا بِمِثْلِ مَا عُوقِبْتُمْ بِهِ وَلَئِنْ صَبَرْتُمْ لَهُوَ خَيْرٌ لِلصَّابِرِينَ"},"context":"منهج الدعوة إلى الله.","reason":"السبيل سبيل ربك، وهو أعلم بالضالّ والمهتدي."},{"i":82,"of":224,"s":17,"surah":"الإسراء","a":17,"text":"وَكَمْ أَهْلَكْنَا مِنَ الْقُرُونِ مِنْ بَعْدِ نُوحٍ وَكَفَى بِرَبِّكَ بِذُنُوبِ عِبَادِهِ خَبِيرًا بَصِيرًا","prev":{"a":16,"text":"وَإِذَا أَرَدْنَا أَنْ نُهْلِكَ قَرْيَةً أَمَرْنَا مُتْرَفِيهَا فَفَسَقُوا فِيهَا فَحَقَّ عَلَيْهَا الْقَوْلُ فَدَمَّرْنَاهَا تَدْمِيرًا"},"next":{"a":18,"text":"مَنْ كَانَ يُرِيدُ الْعَاجِلَةَ عَجَّلْنَا لَهُ فِيهَا مَا نَشَاءُ لِمَنْ نُرِيدُ ثُمَّ جَعَلْنَا لَهُ جَهَنَّمَ يَصْلَاهَا مَذْمُومًا مَدْحُورًا"},"context":"بعد بيان سنة الله في إهلاك القرى المترفة.","reason":"ربك خبيرٌ بصير بذنوب عباده، فلا يحتاج شاهدًا."},{"i":83,"of":224,"s":17,"surah":"الإسراء","a":20,"text":"كُلًّا نُمِدُّ هَؤُلَاءِ وَهَؤُلَاءِ مِنْ عَطَاءِ رَبِّكَ وَمَا كَانَ عَطَاءُ رَبِّكَ مَحْظُورًا","prev":{"a":19,"text":"وَمَنْ أَرَادَ الْآخِرَةَ وَسَعَى لَهَا سَعْيَهَا وَهُوَ مُؤْمِنٌ فَأُولَئِكَ كَانَ سَعْيُهُمْ مَشْكُورًا"},"next":{"a":21,"text":"انْظُرْ كَيْفَ فَضَّلْنَا بَعْضَهُمْ عَلَى بَعْضٍ وَلَلْآخِرَةُ أَكْبَرُ دَرَجَاتٍ وَأَكْبَرُ تَفْضِيلًا"},"context":"ذكر مريد العاجلة ومريد الآخرة.","reason":"عطاء ربك الدنيوي يعمّ الفريقين ولا يُمنع."},{"i":84,"of":224,"s":17,"surah":"الإسراء","a":23,"text":"وَقَضَى رَبُّكَ أَلَّا تَعْبُدُوا إِلَّا إِيَّاهُ وَبِالْوَالِدَيْنِ إِحْسَانًا إِمَّا يَبْلُغَنَّ عِنْدَكَ الْكِبَرَ أَحَدُهُمَا أَوْ كِلَاهُمَا فَلَا تَقُلْ لَهُمَا أُفٍّ وَلَا تَنْهَرْهُمَا وَقُلْ لَهُمَا قَوْلًا كَرِيمًا","prev":{"a":22,"text":"لَا تَجْعَلْ مَعَ اللَّهِ إِلَهًا آخَرَ فَتَقْعُدَ مَذْمُومًا مَخْذُولًا"},"next":{"a":24,"text":"وَاخْفِضْ لَهُمَا جَنَاحَ الذُّلِّ مِنَ الرَّحْمَةِ وَقُلْ رَبِّ ارْحَمْهُمَا كَمَا رَبَّيَانِي صَغِيرًا"},"context":"بداية وصايا سورة الإسراء.","reason":"قضاء ربك قرن توحيده بالإحسان إلى الوالدين."},{"i":85,"of":224,"s":17,"surah":"الإسراء","a":28,"text":"وَإِمَّا تُعْرِضَنَّ عَنْهُمُ ابْتِغَاءَ رَحْمَةٍ مِنْ رَبِّكَ تَرْجُوهَا فَقُلْ لَهُمْ قَوْلًا مَيْسُورًا","prev":{"a":27,"text":"إِنَّ الْمُبَذِّرِينَ كَانُوا إِخْوَانَ الشَّيَاطِينِ وَكَانَ الشَّيْطَانُ لِرَبِّهِ كَفُورًا"},"next":{"a":29,"text":"وَلَا تَجْعَلْ يَدَكَ مَغْلُولَةً إِلَى عُنُقِكَ وَلَا تَبْسُطْهَا كُلَّ الْبَسْطِ فَتَقْعُدَ مَلُومًا مَحْسُورًا"},"context":"الأمر بإيتاء ذي القربى والمسكين.","reason":"إن لم تجد ما تعطي وأنت ترجو رحمة ربك فلا تجرح السائل."},{"i":86,"of":224,"s":17,"surah":"الإسراء","a":30,"text":"إِنَّ رَبَّكَ يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ وَيَقْدِرُ إِنَّهُ كَانَ بِعِبَادِهِ خَبِيرًا بَصِيرًا","prev":{"a":29,"text":"وَلَا تَجْعَلْ يَدَكَ مَغْلُولَةً إِلَى عُنُقِكَ وَلَا تَبْسُطْهَا كُلَّ الْبَسْطِ فَتَقْعُدَ مَلُومًا مَحْسُورًا"},"next":{"a":31,"text":"وَلَا تَقْتُلُوا أَوْلَادَكُمْ خَشْيَةَ إِمْلَاقٍ نَحْنُ نَرْزُقُهُمْ وَإِيَّاكُمْ إِنَّ قَتْلَهُمْ كَانَ خِطْئًا كَبِيرًا"},"context":"النهي عن البخل والإسراف في الإنفاق.","reason":"الرزق بيد ربك يبسطه ويقدره بخبرته."},{"i":87,"of":224,"s":17,"surah":"الإسراء","a":38,"text":"كُلُّ ذَلِكَ كَانَ سَيِّئُهُ عِنْدَ رَبِّكَ مَكْرُوهًا","prev":{"a":37,"text":"وَلَا تَمْشِ فِي الْأَرْضِ مَرَحًا إِنَّكَ لَنْ تَخْرِقَ الْأَرْضَ وَلَنْ تَبْلُغَ الْجِبَالَ طُولًا"},"next":{"a":39,"text":"ذَلِكَ مِمَّا أَوْحَى إِلَيْكَ رَبُّكَ مِنَ الْحِكْمَةِ وَلَا تَجْعَلْ مَعَ اللَّهِ إِلَهًا آخَرَ فَتُلْقَى فِي جَهَنَّمَ مَلُومًا مَدْحُورًا"},"context":"ختام جملةٍ من المناهي كالزنى والكبر.","reason":"هذه المناهي مكروهةٌ عند ربك."},{"i":88,"of":224,"s":17,"surah":"الإسراء","a":39,"text":"ذَلِكَ مِمَّا أَوْحَى إِلَيْكَ رَبُّكَ مِنَ الْحِكْمَةِ وَلَا تَجْعَلْ مَعَ اللَّهِ إِلَهًا آخَرَ فَتُلْقَى فِي جَهَنَّمَ مَلُومًا مَدْحُورًا","prev":{"a":38,"text":"كُلُّ ذَلِكَ كَانَ سَيِّئُهُ عِنْدَ رَبِّكَ مَكْرُوهًا"},"next":{"a":40,"text":"أَفَأَصْفَاكُمْ رَبُّكُمْ بِالْبَنِينَ وَاتَّخَذَ مِنَ الْمَلَائِكَةِ إِنَاثًا إِنَّكُمْ لَتَقُولُونَ قَوْلًا عَظِيمًا"},"context":"تعقيب على الوصايا السابقة.","reason":"هذه الحكمة وحيٌ من ربك، وأولها التوحيد."},{"i":89,"of":224,"s":17,"surah":"الإسراء","a":46,"text":"وَجَعَلْنَا عَلَى قُلُوبِهِمْ أَكِنَّةً أَنْ يَفْقَهُوهُ وَفِي آذَانِهِمْ وَقْرًا وَإِذَا ذَكَرْتَ رَبَّكَ فِي الْقُرْآنِ وَحْدَهُ وَلَّوْا عَلَى أَدْبَارِهِمْ نُفُورًا","prev":{"a":45,"text":"وَإِذَا قَرَأْتَ الْقُرْآنَ جَعَلْنَا بَيْنَكَ وَبَيْنَ الَّذِينَ لَا يُؤْمِنُونَ بِالْآخِرَةِ حِجَابًا مَسْتُورًا"},"next":{"a":47,"text":"نَحْنُ أَعْلَمُ بِمَا يَسْتَمِعُونَ بِهِ إِذْ يَسْتَمِعُونَ إِلَيْكَ وَإِذْ هُمْ نَجْوَى إِذْ يَقُولُ الظَّالِمُونَ إِنْ تَتَّبِعُونَ إِلَّا رَجُلًا مَسْحُورًا"},"context":"المشركون يُحجبون عن فهم القرآن.","reason":"ذكر ربك وحده يُنفّر المشركين."},{"i":90,"of":224,"s":17,"surah":"الإسراء","a":55,"text":"وَرَبُّكَ أَعْلَمُ بِمَنْ فِي السَّمَاوَاتِ وَالْأَرْضِ وَلَقَدْ فَضَّلْنَا بَعْضَ النَّبِيِّينَ عَلَى بَعْضٍ وَآتَيْنَا دَاوُودَ زَبُورًا","prev":{"a":54,"text":"رَبُّكُمْ أَعْلَمُ بِكُمْ إِنْ يَشَأْ يَرْحَمْكُمْ أَوْ إِنْ يَشَأْ يُعَذِّبْكُمْ وَمَا أَرْسَلْنَاكَ عَلَيْهِمْ وَكِيلًا"},"next":{"a":56,"text":"قُلِ ادْعُوا الَّذِينَ زَعَمْتُمْ مِنْ دُونِهِ فَلَا يَمْلِكُونَ كَشْفَ الضُّرِّ عَنْكُمْ وَلَا تَحْوِيلًا"},"context":"الأمر بالقول الأحسن ونهي الشيطان عن النزغ.","reason":"ربك أعلم بخلقه فيفاضل بينهم بعلمه."},{"i":91,"of":224,"s":17,"surah":"الإسراء","a":57,"text":"أُولَئِكَ الَّذِينَ يَدْعُونَ يَبْتَغُونَ إِلَى رَبِّهِمُ الْوَسِيلَةَ أَيُّهُمْ أَقْرَبُ وَيَرْجُونَ رَحْمَتَهُ وَيَخَافُونَ عَذَابَهُ إِنَّ عَذَابَ رَبِّكَ كَانَ مَحْذُورًا","prev":{"a":56,"text":"قُلِ ادْعُوا الَّذِينَ زَعَمْتُمْ مِنْ دُونِهِ فَلَا يَمْلِكُونَ كَشْفَ الضُّرِّ عَنْكُمْ وَلَا تَحْوِيلًا"},"next":{"a":58,"text":"وَإِنْ مِنْ قَرْيَةٍ إِلَّا نَحْنُ مُهْلِكُوهَا قَبْلَ يَوْمِ الْقِيَامَةِ أَوْ مُعَذِّبُوهَا عَذَابًا شَدِيدًا كَانَ ذَلِكَ فِي الْكِتَابِ مَسْطُورًا"},"context":"الرد على من يدعون الصالحين من دون الله.","reason":"المدعوّون أنفسهم يخافون عذاب ربك."},{"i":92,"of":224,"s":17,"surah":"الإسراء","a":60,"text":"وَإِذْ قُلْنَا لَكَ إِنَّ رَبَّكَ أَحَاطَ بِالنَّاسِ وَمَا جَعَلْنَا الرُّؤْيَا الَّتِي أَرَيْنَاكَ إِلَّا فِتْنَةً لِلنَّاسِ وَالشَّجَرَةَ الْمَلْعُونَةَ فِي الْقُرْآنِ وَنُخَوِّفُهُمْ فَمَا يَزِيدُهُمْ إِلَّا طُغْيَانًا كَبِيرًا","prev":{"a":59,"text":"وَمَا مَنَعَنَا أَنْ نُرْسِلَ بِالْآيَاتِ إِلَّا أَنْ كَذَّبَ بِهَا الْأَوَّلُونَ وَآتَيْنَا ثَمُودَ النَّاقَةَ مُبْصِرَةً فَظَلَمُوا بِهَا وَمَا نُرْسِلُ بِالْآيَاتِ إِلَّا تَخْوِيفًا"},"next":{"a":61,"text":"وَإِذْ قُلْنَا لِلْمَلَائِكَةِ اسْجُدُوا لِآدَمَ فَسَجَدُوا إِلَّا إِبْلِيسَ قَالَ أَأَسْجُدُ لِمَنْ خَلَقْتَ طِينًا"},"context":"بيان أن الآيات تخويفٌ للناس.","reason":"ربك أحاط بالناس فلا يخرجون عن قدرته."},{"i":93,"of":224,"s":17,"surah":"الإسراء","a":65,"text":"إِنَّ عِبَادِي لَيْسَ لَكَ عَلَيْهِمْ سُلْطَانٌ وَكَفَى بِرَبِّكَ وَكِيلًا","prev":{"a":64,"text":"وَاسْتَفْزِزْ مَنِ اسْتَطَعْتَ مِنْهُمْ بِصَوْتِكَ وَأَجْلِبْ عَلَيْهِمْ بِخَيْلِكَ وَرَجِلِكَ وَشَارِكْهُمْ فِي الْأَمْوَالِ وَالْأَوْلَادِ وَعِدْهُمْ وَمَا يَعِدُهُمُ الشَّيْطَانُ إِلَّا غُرُورًا"},"next":{"a":66,"text":"رَبُّكُمُ الَّذِي يُزْجِي لَكُمُ الْفُلْكَ فِي الْبَحْرِ لِتَبْتَغُوا مِنْ فَضْلِهِ إِنَّهُ كَانَ بِكُمْ رَحِيمًا"},"context":"إبليس يتوعّد بإغواء ذرية آدم.","reason":"ربك يكفي عباده كيد الشيطان."},{"i":94,"of":224,"s":17,"surah":"الإسراء","a":79,"text":"وَمِنَ اللَّيْلِ فَتَهَجَّدْ بِهِ نَافِلَةً لَكَ عَسَى أَنْ يَبْعَثَكَ رَبُّكَ مَقَامًا مَحْمُودًا","prev":{"a":78,"text":"أَقِمِ الصَّلَاةَ لِدُلُوكِ الشَّمْسِ إِلَى غَسَقِ اللَّيْلِ وَقُرْآنَ الْفَجْرِ إِنَّ قُرْآنَ الْفَجْرِ كَانَ مَشْهُودًا"},"next":{"a":80,"text":"وَقُلْ رَبِّ أَدْخِلْنِي مُدْخَلَ صِدْقٍ وَأَخْرِجْنِي مُخْرَجَ صِدْقٍ وَاجْعَلْ لِي مِنْ لَدُنْكَ سُلْطَانًا نَصِيرًا"},"context":"الأمر بإقامة الصلوات وقرآن الفجر.","reason":"التهجد سبيلٌ إلى مقامٍ محمودٍ يبعثك إليه ربك."},{"i":95,"of":224,"s":17,"surah":"الإسراء","a":87,"text":"إِلَّا رَحْمَةً مِنْ رَبِّكَ إِنَّ فَضْلَهُ كَانَ عَلَيْكَ كَبِيرًا","prev":{"a":86,"text":"وَلَئِنْ شِئْنَا لَنَذْهَبَنَّ بِالَّذِي أَوْحَيْنَا إِلَيْكَ ثُمَّ لَا تَجِدُ لَكَ بِهِ عَلَيْنَا وَكِيلًا"},"next":{"a":88,"text":"قُلْ لَئِنِ اجْتَمَعَتِ الْإِنْسُ وَالْجِنُّ عَلَى أَنْ يَأْتُوا بِمِثْلِ هَذَا الْقُرْآنِ لَا يَأْتُونَ بِمِثْلِهِ وَلَوْ كَانَ بَعْضُهُمْ لِبَعْضٍ ظَهِيرًا"},"context":"لو شاء الله لذهب بالوحي.","reason":"بقاء الوحي رحمةٌ من ربك وفضلٌ كبير."},{"i":96,"of":224,"s":18,"surah":"الكهف","a":24,"text":"إِلَّا أَنْ يَشَاءَ اللَّهُ وَاذْكُرْ رَبَّكَ إِذَا نَسِيتَ وَقُلْ عَسَى أَنْ يَهْدِيَنِ رَبِّي لِأَقْرَبَ مِنْ هَذَا رَشَدًا","prev":{"a":23,"text":"وَلَا تَقُولَنَّ لِشَيْءٍ إِنِّي فَاعِلٌ ذَلِكَ غَدًا"},"next":{"a":25,"text":"وَلَبِثُوا فِي كَهْفِهِمْ ثَلَاثَ مِائَةٍ سِنِينَ وَازْدَادُوا تِسْعًا"},"context":"النهي عن الجزم بفعل شيءٍ غدًا دون المشيئة.","reason":"ذكر ربك علاجُ النسيان وطريق الرشد."},{"i":97,"of":224,"s":18,"surah":"الكهف","a":27,"text":"وَاتْلُ مَا أُوحِيَ إِلَيْكَ مِنْ كِتَابِ رَبِّكَ لَا مُبَدِّلَ لِكَلِمَاتِهِ وَلَنْ تَجِدَ مِنْ دُونِهِ مُلْتَحَدًا","prev":{"a":26,"text":"قُلِ اللَّهُ أَعْلَمُ بِمَا لَبِثُوا لَهُ غَيْبُ السَّمَاوَاتِ وَالْأَرْضِ أَبْصِرْ بِهِ وَأَسْمِعْ مَا لَهُمْ مِنْ دُونِهِ مِنْ وَلِيٍّ وَلَا يُشْرِكُ فِي حُكْمِهِ أَحَدًا"},"next":{"a":28,"text":"وَاصْبِرْ نَفْسَكَ مَعَ الَّذِينَ يَدْعُونَ رَبَّهُمْ بِالْغَدَاةِ وَالْعَشِيِّ يُرِيدُونَ وَجْهَهُ وَلَا تَعْدُ عَيْنَاكَ عَنْهُمْ تُرِيدُ زِينَةَ الْحَيَاةِ الدُّنْيَا وَلَا تُطِعْ مَنْ أَغْفَلْنَا قَلْبَهُ عَنْ ذِكْرِنَا وَاتَّبَعَ هَوَاهُ وَكَانَ أَمْرُهُ فُرُطًا"},"context":"بعد قصة أصحاب الكهف.","reason":"كتاب ربك لا مبدّل لكلماته، ولا ملجأ دونه."},{"i":98,"of":224,"s":18,"surah":"الكهف","a":46,"text":"الْمَالُ وَالْبَنُونَ زِينَةُ الْحَيَاةِ الدُّنْيَا وَالْبَاقِيَاتُ الصَّالِحَاتُ خَيْرٌ عِنْدَ رَبِّكَ ثَوَابًا وَخَيْرٌ أَمَلًا","prev":{"a":45,"text":"وَاضْرِبْ لَهُمْ مَثَلَ الْحَيَاةِ الدُّنْيَا كَمَاءٍ أَنْزَلْنَاهُ مِنَ السَّمَاءِ فَاخْتَلَطَ بِهِ نَبَاتُ الْأَرْضِ فَأَصْبَحَ هَشِيمًا تَذْرُوهُ الرِّيَاحُ وَكَانَ اللَّهُ عَلَى كُلِّ شَيْءٍ مُقْتَدِرًا"},"next":{"a":47,"text":"وَيَوْمَ نُسَيِّرُ الْجِبَالَ وَتَرَى الْأَرْضَ بَارِزَةً وَحَشَرْنَاهُمْ فَلَمْ نُغَادِرْ مِنْهُمْ أَحَدًا"},"context":"بعد مثل الحياة الدنيا كماءٍ اختلط بنبات الأرض.","reason":"الباقيات الصالحات خيرٌ عند ربك من المال والبنين."},{"i":99,"of":224,"s":18,"surah":"الكهف","a":48,"text":"وَعُرِضُوا عَلَى رَبِّكَ صَفًّا لَقَدْ جِئْتُمُونَا كَمَا خَلَقْنَاكُمْ أَوَّلَ مَرَّةٍ بَلْ زَعَمْتُمْ أَلَّنْ نَجْعَلَ لَكُمْ مَوْعِدًا","prev":{"a":47,"text":"وَيَوْمَ نُسَيِّرُ الْجِبَالَ وَتَرَى الْأَرْضَ بَارِزَةً وَحَشَرْنَاهُمْ فَلَمْ نُغَادِرْ مِنْهُمْ أَحَدًا"},"next":{"a":49,"text":"وَوُضِعَ الْكِتَابُ فَتَرَى الْمُجْرِمِينَ مُشْفِقِينَ مِمَّا فِيهِ وَيَقُولُونَ يَا وَيْلَتَنَا مَالِ هَذَا الْكِتَابِ لَا يُغَادِرُ صَغِيرَةً وَلَا كَبِيرَةً إِلَّا أَحْصَاهَا وَوَجَدُوا مَا عَمِلُوا حَاضِرًا وَلَا يَظْلِمُ رَبُّكَ أَحَدًا"},"context":"مشهد تسيير الجبال وحشر الناس.","reason":"العرض على ربك صفًّا كما خُلقوا أول مرة."},{"i":100,"of":224,"s":18,"surah":"الكهف","a":49,"text":"وَوُضِعَ الْكِتَابُ فَتَرَى الْمُجْرِمِينَ مُشْفِقِينَ مِمَّا فِيهِ وَيَقُولُونَ يَا وَيْلَتَنَا مَالِ هَذَا الْكِتَابِ لَا يُغَادِرُ صَغِيرَةً وَلَا كَبِيرَةً إِلَّا أَحْصَاهَا وَوَجَدُوا مَا عَمِلُوا حَاضِرًا وَلَا يَظْلِمُ رَبُّكَ أَحَدًا","prev":{"a":48,"text":"وَعُرِضُوا عَلَى رَبِّكَ صَفًّا لَقَدْ جِئْتُمُونَا كَمَا خَلَقْنَاكُمْ أَوَّلَ مَرَّةٍ بَلْ زَعَمْتُمْ أَلَّنْ نَجْعَلَ لَكُمْ مَوْعِدًا"},"next":{"a":50,"text":"وَإِذْ قُلْنَا لِلْمَلَائِكَةِ اسْجُدُوا لِآدَمَ فَسَجَدُوا إِلَّا إِبْلِيسَ كَانَ مِنَ الْجِنِّ فَفَسَقَ عَنْ أَمْرِ رَبِّهِ أَفَتَتَّخِذُونَهُ وَذُرِّيَّتَهُ أَوْلِيَاءَ مِنْ دُونِي وَهُمْ لَكُمْ عَدُوٌّ بِئْسَ لِلظَّالِمِينَ بَدَلًا"},"context":"وضع كتاب الأعمال يوم القيامة.","reason":"ربك لا يظلم أحدًا، والكتاب يحصي الصغير والكبير."},{"i":101,"of":224,"s":18,"surah":"الكهف","a":58,"text":"وَرَبُّكَ الْغَفُورُ ذُو الرَّحْمَةِ لَوْ يُؤَاخِذُهُمْ بِمَا كَسَبُوا لَعَجَّلَ لَهُمُ الْعَذَابَ بَلْ لَهُمْ مَوْعِدٌ لَنْ يَجِدُوا مِنْ دُونِهِ مَوْئِلًا","prev":{"a":57,"text":"وَمَنْ أَظْلَمُ مِمَّنْ ذُكِّرَ بِآيَاتِ رَبِّهِ فَأَعْرَضَ عَنْهَا وَنَسِيَ مَا قَدَّمَتْ يَدَاهُ إِنَّا جَعَلْنَا عَلَى قُلُوبِهِمْ أَكِنَّةً أَنْ يَفْقَهُوهُ وَفِي آذَانِهِمْ وَقْرًا وَإِنْ تَدْعُهُمْ إِلَى الْهُدَى فَلَنْ يَهْتَدُوا إِذًا أَبَدًا"},"next":{"a":59,"text":"وَتِلْكَ الْقُرَى أَهْلَكْنَاهُمْ لَمَّا ظَلَمُوا وَجَعَلْنَا لِمَهْلِكِهِمْ مَوْعِدًا"},"context":"المعرضون عن الآيات يستعجلون العذاب.","reason":"ربك الغفور ذو الرحمة لا يعاجلهم."},{"i":102,"of":224,"s":18,"surah":"الكهف","a":82,"text":"وَأَمَّا الْجِدَارُ فَكَانَ لِغُلَامَيْنِ يَتِيمَيْنِ فِي الْمَدِينَةِ وَكَانَ تَحْتَهُ كَنْزٌ لَهُمَا وَكَانَ أَبُوهُمَا صَالِحًا فَأَرَادَ رَبُّكَ أَنْ يَبْلُغَا أَشُدَّهُمَا وَيَسْتَخْرِجَا كَنْزَهُمَا رَحْمَةً مِنْ رَبِّكَ وَمَا فَعَلْتُهُ عَنْ أَمْرِي ذَلِكَ تَأْوِيلُ مَا لَمْ تَسْطِعْ عَلَيْهِ صَبْرًا","prev":{"a":81,"text":"فَأَرَدْنَا أَنْ يُبْدِلَهُمَا رَبُّهُمَا خَيْرًا مِنْهُ زَكَاةً وَأَقْرَبَ رُحْمًا"},"next":{"a":83,"text":"وَيَسْأَلُونَكَ عَنْ ذِي الْقَرْنَيْنِ قُلْ سَأَتْلُو عَلَيْكُمْ مِنْهُ ذِكْرًا"},"context":"الخضر يبيّن لموسى تأويل إقامة الجدار.","reason":"ربك أراد حفظ كنز اليتيمين رحمةً بصلاح أبيهما."},{"i":103,"of":224,"s":19,"surah":"مريم","a":2,"text":"ذِكْرُ رَحْمَتِ رَبِّكَ عَبْدَهُ زَكَرِيَّا","prev":{"a":1,"text":"كهيعص"},"next":{"a":3,"text":"إِذْ نَادَى رَبَّهُ نِدَاءً خَفِيًّا"},"context":"افتتاح سورة مريم.","reason":"رحمة ربك بعبده زكريا تُذكر وتُتلى."},{"i":104,"of":224,"s":19,"surah":"مريم","a":9,"text":"قَالَ كَذَلِكَ قَالَ رَبُّكَ هُوَ عَلَيَّ هَيِّنٌ وَقَدْ خَلَقْتُكَ مِنْ قَبْلُ وَلَمْ تَكُ شَيْئًا","prev":{"a":8,"text":"قَالَ رَبِّ أَنَّى يَكُونُ لِي غُلَامٌ وَكَانَتِ امْرَأَتِي عَاقِرًا وَقَدْ بَلَغْتُ مِنَ الْكِبَرِ عِتِيًّا"},"next":{"a":10,"text":"قَالَ رَبِّ اجْعَلْ لِي آيَةً قَالَ آيَتُكَ أَلَّا تُكَلِّمَ النَّاسَ ثَلَاثَ لَيَالٍ سَوِيًّا"},"context":"زكريا يتعجّب من الولد مع كِبره وعقم امرأته.","reason":"ربك قال إنه هيّنٌ عليه."},{"i":105,"of":224,"s":19,"surah":"مريم","a":19,"text":"قَالَ إِنَّمَا أَنَا رَسُولُ رَبِّكِ لِأَهَبَ لَكِ غُلَامًا زَكِيًّا","prev":{"a":18,"text":"قَالَتْ إِنِّي أَعُوذُ بِالرَّحْمَنِ مِنْكَ إِنْ كُنْتَ تَقِيًّا"},"next":{"a":20,"text":"قَالَتْ أَنَّى يَكُونُ لِي غُلَامٌ وَلَمْ يَمْسَسْنِي بَشَرٌ وَلَمْ أَكُ بَغِيًّا"},"context":"الملَك يتمثّل لمريم بشرًا فتستعيذ منه.","reason":"عرّف نفسه بأنه رسول ربك ليطمئنها."},{"i":106,"of":224,"s":19,"surah":"مريم","a":21,"text":"قَالَ كَذَلِكِ قَالَ رَبُّكِ هُوَ عَلَيَّ هَيِّنٌ وَلِنَجْعَلَهُ آيَةً لِلنَّاسِ وَرَحْمَةً مِنَّا وَكَانَ أَمْرًا مَقْضِيًّا","prev":{"a":20,"text":"قَالَتْ أَنَّى يَكُونُ لِي غُلَامٌ وَلَمْ يَمْسَسْنِي بَشَرٌ وَلَمْ أَكُ بَغِيًّا"},"next":{"a":22,"text":"فَحَمَلَتْهُ فَانْتَبَذَتْ بِهِ مَكَانًا قَصِيًّا"},"context":"مريم تتعجّب كيف يكون لها غلام ولم يمسسها بشر.","reason":"ربك قال إنه هيّنٌ عليه وأمرٌ مقضيّ."},{"i":107,"of":224,"s":19,"surah":"مريم","a":24,"text":"فَنَادَاهَا مِنْ تَحْتِهَا أَلَّا تَحْزَنِي قَدْ جَعَلَ رَبُّكِ تَحْتَكِ سَرِيًّا","prev":{"a":23,"text":"فَأَجَاءَهَا الْمَخَاضُ إِلَى جِذْعِ النَّخْلَةِ قَالَتْ يَا لَيْتَنِي مِتُّ قَبْلَ هَذَا وَكُنْتُ نَسْيًا مَنْسِيًّا"},"next":{"a":25,"text":"وَهُزِّي إِلَيْكِ بِجِذْعِ النَّخْلَةِ تُسَاقِطْ عَلَيْكِ رُطَبًا جَنِيًّا"},"context":"مريم في المخاض تتمنى الموت.","reason":"ربك جعل تحتها سريًّا تسليةً لحزنها."},{"i":108,"of":224,"s":19,"surah":"مريم","a":64,"text":"وَمَا نَتَنَزَّلُ إِلَّا بِأَمْرِ رَبِّكَ لَهُ مَا بَيْنَ أَيْدِينَا وَمَا خَلْفَنَا وَمَا بَيْنَ ذَلِكَ وَمَا كَانَ رَبُّكَ نَسِيًّا","prev":{"a":63,"text":"تِلْكَ الْجَنَّةُ الَّتِي نُورِثُ مِنْ عِبَادِنَا مَنْ كَانَ تَقِيًّا"},"next":{"a":65,"text":"رَبُّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا فَاعْبُدْهُ وَاصْطَبِرْ لِعِبَادَتِهِ هَلْ تَعْلَمُ لَهُ سَمِيًّا"},"context":"جبريل يجيب عن تأخّر الوحي.","reason":"التنزّل بأمر ربك، وربك لا ينسى."},{"i":109,"of":224,"s":19,"surah":"مريم","a":68,"text":"فَوَرَبِّكَ لَنَحْشُرَنَّهُمْ وَالشَّيَاطِينَ ثُمَّ لَنُحْضِرَنَّهُمْ حَوْلَ جَهَنَّمَ جِثِيًّا","prev":{"a":67,"text":"أَوَلَا يَذْكُرُ الْإِنْسَانُ أَنَّا خَلَقْنَاهُ مِنْ قَبْلُ وَلَمْ يَكُ شَيْئًا"},"next":{"a":69,"text":"ثُمَّ لَنَنْزِعَنَّ مِنْ كُلِّ شِيعَةٍ أَيُّهُمْ أَشَدُّ عَلَى الرَّحْمَنِ عِتِيًّا"},"context":"المنكر للبعث يقول: أإذا ما متّ لسوف أُخرج حيًّا.","reason":"أقسم الله بربوبيته للنبي ﷺ على حشرهم."},{"i":110,"of":224,"s":19,"surah":"مريم","a":71,"text":"وَإِنْ مِنْكُمْ إِلَّا وَارِدُهَا كَانَ عَلَى رَبِّكَ حَتْمًا مَقْضِيًّا","prev":{"a":70,"text":"ثُمَّ لَنَحْنُ أَعْلَمُ بِالَّذِينَ هُمْ أَوْلَى بِهَا صِلِيًّا"},"next":{"a":72,"text":"ثُمَّ نُنَجِّي الَّذِينَ اتَّقَوْا وَنَذَرُ الظَّالِمِينَ فِيهَا جِثِيًّا"},"context":"بعد ذكر حشر الكافرين حول جهنم.","reason":"ورود النار قضاءٌ محتوم على ربك."},{"i":111,"of":224,"s":19,"surah":"مريم","a":76,"text":"وَيَزِيدُ اللَّهُ الَّذِينَ اهْتَدَوْا هُدًى وَالْبَاقِيَاتُ الصَّالِحَاتُ خَيْرٌ عِنْدَ رَبِّكَ ثَوَابًا وَخَيْرٌ مَرَدًّا","prev":{"a":75,"text":"قُلْ مَنْ كَانَ فِي الضَّلَالَةِ فَلْيَمْدُدْ لَهُ الرَّحْمَنُ مَدًّا حَتَّى إِذَا رَأَوْا مَا يُوعَدُونَ إِمَّا الْعَذَابَ وَإِمَّا السَّاعَةَ فَسَيَعْلَمُونَ مَنْ هُوَ شَرٌّ مَكَانًا وَأَضْعَفُ جُنْدًا"},"next":{"a":77,"text":"أَفَرَأَيْتَ الَّذِي كَفَرَ بِآيَاتِنَا وَقَالَ لَأُوتَيَنَّ مَالًا وَوَلَدًا"},"context":"الكافرون يفتخرون بمقامهم وناديهم.","reason":"الباقيات الصالحات خيرٌ عند ربك ثوابًا ومردًّا."},{"i":112,"of":224,"s":20,"surah":"طه","a":12,"text":"إِنِّي أَنَا رَبُّكَ فَاخْلَعْ نَعْلَيْكَ إِنَّكَ بِالْوَادِ الْمُقَدَّسِ طُوًى","prev":{"a":11,"text":"فَلَمَّا أَتَاهَا نُودِيَ يَا مُوسَى"},"next":{"a":13,"text":"وَأَنَا اخْتَرْتُكَ فَاسْتَمِعْ لِمَا يُوحَى"},"context":"موسى يرى النار فيأتيها، فيُنادى.","reason":"عرّف الله نفسه لموسى بأنه ربه قبل أن يكلّفه."},{"i":113,"of":224,"s":20,"surah":"طه","a":47,"text":"فَأْتِيَاهُ فَقُولَا إِنَّا رَسُولَا رَبِّكَ فَأَرْسِلْ مَعَنَا بَنِي إِسْرَائِيلَ وَلَا تُعَذِّبْهُمْ قَدْ جِئْنَاكَ بِآيَةٍ مِنْ رَبِّكَ وَالسَّلَامُ عَلَى مَنِ اتَّبَعَ الْهُدَى","prev":{"a":46,"text":"قَالَ لَا تَخَافَا إِنَّنِي مَعَكُمَا أَسْمَعُ وَأَرَى"},"next":{"a":48,"text":"إِنَّا قَدْ أُوحِيَ إِلَيْنَا أَنَّ الْعَذَابَ عَلَى مَنْ كَذَّبَ وَتَوَلَّى"},"context":"بعد أن طمأن الله موسى وهارون بمعيّته، أمرهما أن يأتيا فرعون ويبلّغاه.","reason":"نسبة الرسالة إلى «ربك» تذكيرٌ لفرعون بأن له ربًّا فوقه هو مالكه."},{"i":114,"of":224,"s":20,"surah":"طه","a":129,"text":"وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِنْ رَبِّكَ لَكَانَ لِزَامًا وَأَجَلٌ مُسَمًّى","prev":{"a":128,"text":"أَفَلَمْ يَهْدِ لَهُمْ كَمْ أَهْلَكْنَا قَبْلَهُمْ مِنَ الْقُرُونِ يَمْشُونَ فِي مَسَاكِنِهِمْ إِنَّ فِي ذَلِكَ لَآيَاتٍ لِأُولِي النُّهَى"},"next":{"a":130,"text":"فَاصْبِرْ عَلَى مَا يَقُولُونَ وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ غُرُوبِهَا وَمِنْ آنَاءِ اللَّيْلِ فَسَبِّحْ وَأَطْرَافَ النَّهَارِ لَعَلَّكَ تَرْضَى"},"context":"بعد ذكر إهلاك القرون قبلهم يبيّن سبب تأخير العذاب عن المكذبين.","reason":"كلمة ربك السابقة بتأجيل العقوبة هي التي أمهلتهم، فالتأخير بحكمة لا عن غفلة."},{"i":115,"of":224,"s":20,"surah":"طه","a":130,"text":"فَاصْبِرْ عَلَى مَا يَقُولُونَ وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ غُرُوبِهَا وَمِنْ آنَاءِ اللَّيْلِ فَسَبِّحْ وَأَطْرَافَ النَّهَارِ لَعَلَّكَ تَرْضَى","prev":{"a":129,"text":"وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِنْ رَبِّكَ لَكَانَ لِزَامًا وَأَجَلٌ مُسَمًّى"},"next":{"a":131,"text":"وَلَا تَمُدَّنَّ عَيْنَيْكَ إِلَى مَا مَتَّعْنَا بِهِ أَزْوَاجًا مِنْهُمْ زَهْرَةَ الْحَيَاةِ الدُّنْيَا لِنَفْتِنَهُمْ فِيهِ وَرِزْقُ رَبِّكَ خَيْرٌ وَأَبْقَى"},"context":"بعد بيان إمهال المكذبين يؤمر النبي ﷺ بالصبر على أقوالهم.","reason":"علاج أذى الكلام التسبيح بحمد الرب في أوقات اليوم، وثمرته الرضا."},{"i":116,"of":224,"s":20,"surah":"طه","a":131,"text":"وَلَا تَمُدَّنَّ عَيْنَيْكَ إِلَى مَا مَتَّعْنَا بِهِ أَزْوَاجًا مِنْهُمْ زَهْرَةَ الْحَيَاةِ الدُّنْيَا لِنَفْتِنَهُمْ فِيهِ وَرِزْقُ رَبِّكَ خَيْرٌ وَأَبْقَى","prev":{"a":130,"text":"فَاصْبِرْ عَلَى مَا يَقُولُونَ وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ غُرُوبِهَا وَمِنْ آنَاءِ اللَّيْلِ فَسَبِّحْ وَأَطْرَافَ النَّهَارِ لَعَلَّكَ تَرْضَى"},"next":{"a":132,"text":"وَأْمُرْ أَهْلَكَ بِالصَّلَاةِ وَاصْطَبِرْ عَلَيْهَا لَا نَسْأَلُكَ رِزْقًا نَحْنُ نَرْزُقُكَ وَالْعَاقِبَةُ لِلتَّقْوَى"},"context":"بعد الأمر بالتسبيح يُنهى عن مدّ العين إلى متاع أهل الدنيا.","reason":"رزق ربك الذي يربيك به خيرٌ من زهرة يفتن الله بها غيرك."},{"i":117,"of":224,"s":21,"surah":"الأنبياء","a":46,"text":"وَلَئِنْ مَسَّتْهُمْ نَفْحَةٌ مِنْ عَذَابِ رَبِّكَ لَيَقُولُنَّ يَا وَيْلَنَا إِنَّا كُنَّا ظَالِمِينَ","prev":{"a":45,"text":"قُلْ إِنَّمَا أُنْذِرُكُمْ بِالْوَحْيِ وَلَا يَسْمَعُ الصُّمُّ الدُّعَاءَ إِذَا مَا يُنْذَرُونَ"},"next":{"a":47,"text":"وَنَضَعُ الْمَوَازِينَ الْقِسْطَ لِيَوْمِ الْقِيَامَةِ فَلَا تُظْلَمُ نَفْسٌ شَيْئًا وَإِنْ كَانَ مِثْقَالَ حَبَّةٍ مِنْ خَرْدَلٍ أَتَيْنَا بِهَا وَكَفَى بِنَا حَاسِبِينَ"},"context":"النبي ﷺ ينذرهم بالوحي، والصمّ لا يسمعون الدعاء إذا أُنذروا.","reason":"لمسةٌ يسيرة من عذاب ربك تكفي لتُسقط كبرهم فيعترفوا بظلمهم."},{"i":118,"of":224,"s":22,"surah":"الحج","a":47,"text":"وَيَسْتَعْجِلُونَكَ بِالْعَذَابِ وَلَنْ يُخْلِفَ اللَّهُ وَعْدَهُ وَإِنَّ يَوْمًا عِنْدَ رَبِّكَ كَأَلْفِ سَنَةٍ مِمَّا تَعُدُّونَ","prev":{"a":46,"text":"أَفَلَمْ يَسِيرُوا فِي الْأَرْضِ فَتَكُونَ لَهُمْ قُلُوبٌ يَعْقِلُونَ بِهَا أَوْ آذَانٌ يَسْمَعُونَ بِهَا فَإِنَّهَا لَا تَعْمَى الْأَبْصَارُ وَلَكِنْ تَعْمَى الْقُلُوبُ الَّتِي فِي الصُّدُورِ"},"next":{"a":48,"text":"وَكَأَيِّنْ مِنْ قَرْيَةٍ أَمْلَيْتُ لَهَا وَهِيَ ظَالِمَةٌ ثُمَّ أَخَذْتُهَا وَإِلَيَّ الْمَصِيرُ"},"context":"بعد التنبيه إلى أن العمى عمى القلوب، يُذكر استعجالهم العذاب.","reason":"الزمن عند ربك ليس كزمنكم، فلا يُستعجل وعده."},{"i":119,"of":224,"s":22,"surah":"الحج","a":54,"text":"وَلِيَعْلَمَ الَّذِينَ أُوتُوا الْعِلْمَ أَنَّهُ الْحَقُّ مِنْ رَبِّكَ فَيُؤْمِنُوا بِهِ فَتُخْبِتَ لَهُ قُلُوبُهُمْ وَإِنَّ اللَّهَ لَهَادِ الَّذِينَ آمَنُوا إِلَى صِرَاطٍ مُسْتَقِيمٍ","prev":{"a":53,"text":"لِيَجْعَلَ مَا يُلْقِي الشَّيْطَانُ فِتْنَةً لِلَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ وَالْقَاسِيَةِ قُلُوبُهُمْ وَإِنَّ الظَّالِمِينَ لَفِي شِقَاقٍ بَعِيدٍ"},"next":{"a":55,"text":"وَلَا يَزَالُ الَّذِينَ كَفَرُوا فِي مِرْيَةٍ مِنْهُ حَتَّى تَأْتِيَهُمُ السَّاعَةُ بَغْتَةً أَوْ يَأْتِيَهُمْ عَذَابُ يَوْمٍ عَقِيمٍ"},"context":"بعد ذكر إلقاء الشيطان فتنةً لمرضى القلوب.","reason":"أهل العلم يعرفون أن الوحي حقٌّ من ربك فتخبت قلوبهم."},{"i":120,"of":224,"s":22,"surah":"الحج","a":67,"text":"لِكُلِّ أُمَّةٍ جَعَلْنَا مَنْسَكًا هُمْ نَاسِكُوهُ فَلَا يُنَازِعُنَّكَ فِي الْأَمْرِ وَادْعُ إِلَى رَبِّكَ إِنَّكَ لَعَلَى هُدًى مُسْتَقِيمٍ","prev":{"a":66,"text":"وَهُوَ الَّذِي أَحْيَاكُمْ ثُمَّ يُمِيتُكُمْ ثُمَّ يُحْيِيكُمْ إِنَّ الْإِنْسَانَ لَكَفُورٌ"},"next":{"a":68,"text":"وَإِنْ جَادَلُوكَ فَقُلِ اللَّهُ أَعْلَمُ بِمَا تَعْمَلُونَ"},"context":"بعد ذكر الإحياء والإماتة، يُذكر أن لكل أمة منسكًا ويُنهى عن منازعة النبي ﷺ.","reason":"الأمر بالدعوة إلى «ربك» يثبّت الداعي بأنه على هدى من ربه."},{"i":121,"of":224,"s":23,"surah":"المؤمنون","a":72,"text":"أَمْ تَسْأَلُهُمْ خَرْجًا فَخَرَاجُ رَبِّكَ خَيْرٌ وَهُوَ خَيْرُ الرَّازِقِينَ","prev":{"a":71,"text":"وَلَوِ اتَّبَعَ الْحَقُّ أَهْوَاءَهُمْ لَفَسَدَتِ السَّمَاوَاتُ وَالْأَرْضُ وَمَنْ فِيهِنَّ بَلْ أَتَيْنَاهُمْ بِذِكْرِهِمْ فَهُمْ عَنْ ذِكْرِهِمْ مُعْرِضُونَ"},"next":{"a":73,"text":"وَإِنَّكَ لَتَدْعُوهُمْ إِلَى صِرَاطٍ مُسْتَقِيمٍ"},"context":"بعد بيان إعراضهم عن ذكرهم، يُسألون: هل يطلب منهم النبي ﷺ أجرًا؟","reason":"النبي ﷺ لا يسألهم أجرًا، لأن عطاء ربه خير، وهو خير الرازقين."},{"i":122,"of":224,"s":25,"surah":"الفرقان","a":16,"text":"لَهُمْ فِيهَا مَا يَشَاءُونَ خَالِدِينَ كَانَ عَلَى رَبِّكَ وَعْدًا مَسْئُولًا","prev":{"a":15,"text":"قُلْ أَذَلِكَ خَيْرٌ أَمْ جَنَّةُ الْخُلْدِ الَّتِي وُعِدَ الْمُتَّقُونَ كَانَتْ لَهُمْ جَزَاءً وَمَصِيرًا"},"next":{"a":17,"text":"وَيَوْمَ يَحْشُرُهُمْ وَمَا يَعْبُدُونَ مِنْ دُونِ اللَّهِ فَيَقُولُ أَأَنْتُمْ أَضْلَلْتُمْ عِبَادِي هَؤُلَاءِ أَمْ هُمْ ضَلُّوا السَّبِيلَ"},"context":"بعد السؤال: أذلك خير أم جنة الخلد التي وُعد المتقون؟","reason":"الجنة وعدٌ ألزم به ربك نفسه، فهو حقٌّ يُسأل ويُرجى."},{"i":123,"of":224,"s":25,"surah":"الفرقان","a":20,"text":"وَمَا أَرْسَلْنَا قَبْلَكَ مِنَ الْمُرْسَلِينَ إِلَّا إِنَّهُمْ لَيَأْكُلُونَ الطَّعَامَ وَيَمْشُونَ فِي الْأَسْوَاقِ وَجَعَلْنَا بَعْضَكُمْ لِبَعْضٍ فِتْنَةً أَتَصْبِرُونَ وَكَانَ رَبُّكَ بَصِيرًا","prev":{"a":19,"text":"فَقَدْ كَذَّبُوكُمْ بِمَا تَقُولُونَ فَمَا تَسْتَطِيعُونَ صَرْفًا وَلَا نَصْرًا وَمَنْ يَظْلِمْ مِنْكُمْ نُذِقْهُ عَذَابًا كَبِيرًا"},"next":{"a":21,"text":"وَقَالَ الَّذِينَ لَا يَرْجُونَ لِقَاءَنَا لَوْلَا أُنْزِلَ عَلَيْنَا الْمَلَائِكَةُ أَوْ نَرَى رَبَّنَا لَقَدِ اسْتَكْبَرُوا فِي أَنْفُسِهِمْ وَعَتَوْا عُتُوًّا كَبِيرًا"},"context":"بعد ذكر تبرّؤ المعبودين من عابديهم، يُبيَّن حال الرسل قبل النبي ﷺ.","reason":"الرسل بشرٌ يأكلون ويمشون في الأسواق، والناس فتنة لبعضهم، وربك بصير بمن يصبر."},{"i":124,"of":224,"s":25,"surah":"الفرقان","a":31,"text":"وَكَذَلِكَ جَعَلْنَا لِكُلِّ نَبِيٍّ عَدُوًّا مِنَ الْمُجْرِمِينَ وَكَفَى بِرَبِّكَ هَادِيًا وَنَصِيرًا","prev":{"a":30,"text":"وَقَالَ الرَّسُولُ يَا رَبِّ إِنَّ قَوْمِي اتَّخَذُوا هَذَا الْقُرْآنَ مَهْجُورًا"},"next":{"a":32,"text":"وَقَالَ الَّذِينَ كَفَرُوا لَوْلَا نُزِّلَ عَلَيْهِ الْقُرْآنُ جُمْلَةً وَاحِدَةً كَذَلِكَ لِنُثَبِّتَ بِهِ فُؤَادَكَ وَرَتَّلْنَاهُ تَرْتِيلًا"},"context":"شكوى الرسول من هجر قومه للقرآن.","reason":"لكل نبي عدوّ، وربك وحده يكفيه هدايةً ونصرًا."},{"i":125,"of":224,"s":25,"surah":"الفرقان","a":45,"text":"أَلَمْ تَرَ إِلَى رَبِّكَ كَيْفَ مَدَّ الظِّلَّ وَلَوْ شَاءَ لَجَعَلَهُ سَاكِنًا ثُمَّ جَعَلْنَا الشَّمْسَ عَلَيْهِ دَلِيلًا","prev":{"a":44,"text":"أَمْ تَحْسَبُ أَنَّ أَكْثَرَهُمْ يَسْمَعُونَ أَوْ يَعْقِلُونَ إِنْ هُمْ إِلَّا كَالْأَنْعَامِ بَلْ هُمْ أَضَلُّ سَبِيلًا"},"next":{"a":46,"text":"ثُمَّ قَبَضْنَاهُ إِلَيْنَا قَبْضًا يَسِيرًا"},"context":"بعد ذكر ضلال المشركين يُلفت النظر إلى آيات الكون.","reason":"مدّ الظل من تدبير ربك الذي يربي خلقه بالليل والنهار."},{"i":126,"of":224,"s":25,"surah":"الفرقان","a":54,"text":"وَهُوَ الَّذِي خَلَقَ مِنَ الْمَاءِ بَشَرًا فَجَعَلَهُ نَسَبًا وَصِهْرًا وَكَانَ رَبُّكَ قَدِيرًا","prev":{"a":53,"text":"وَهُوَ الَّذِي مَرَجَ الْبَحْرَيْنِ هَذَا عَذْبٌ فُرَاتٌ وَهَذَا مِلْحٌ أُجَاجٌ وَجَعَلَ بَيْنَهُمَا بَرْزَخًا وَحِجْرًا مَحْجُورًا"},"next":{"a":55,"text":"وَيَعْبُدُونَ مِنْ دُونِ اللَّهِ مَا لَا يَنْفَعُهُمْ وَلَا يَضُرُّهُمْ وَكَانَ الْكَافِرُ عَلَى رَبِّهِ ظَهِيرًا"},"context":"في سياق آيات الماء وخلق البحرين.","reason":"خلق البشر من ماء وجعلهم نسبًا وصهرًا دليل قدرة ربك."},{"i":127,"of":224,"s":26,"surah":"الشعراء","a":9,"text":"وَإِنَّ رَبَّكَ لَهُوَ الْعَزِيزُ الرَّحِيمُ","prev":{"a":8,"text":"إِنَّ فِي ذَلِكَ لَآيَةً وَمَا كَانَ أَكْثَرُهُمْ مُؤْمِنِينَ"},"next":{"a":10,"text":"وَإِذْ نَادَى رَبُّكَ مُوسَى أَنِ ائْتِ الْقَوْمَ الظَّالِمِينَ"},"context":"تعقيبٌ بعد آيةٍ ظاهرة لم يؤمن بها أكثرهم، وقبل نداء موسى.","reason":"ربك عزيز قادر على أخذ المعرضين، رحيم يمهلهم."},{"i":128,"of":224,"s":26,"surah":"الشعراء","a":10,"text":"وَإِذْ نَادَى رَبُّكَ مُوسَى أَنِ ائْتِ الْقَوْمَ الظَّالِمِينَ","prev":{"a":9,"text":"وَإِنَّ رَبَّكَ لَهُوَ الْعَزِيزُ الرَّحِيمُ"},"next":{"a":11,"text":"قَوْمَ فِرْعَوْنَ أَلَا يَتَّقُونَ"},"context":"بعد التعقيب بعزّة الرب ورحمته، يبدأ خبر نداء الله موسى.","reason":"نداء ربك لموسى تكليفٌ وعناية، يبعثه إلى الظالمين."},{"i":129,"of":224,"s":26,"surah":"الشعراء","a":68,"text":"وَإِنَّ رَبَّكَ لَهُوَ الْعَزِيزُ الرَّحِيمُ","prev":{"a":67,"text":"إِنَّ فِي ذَلِكَ لَآيَةً وَمَا كَانَ أَكْثَرُهُمْ مُؤْمِنِينَ"},"next":{"a":69,"text":"وَاتْلُ عَلَيْهِمْ نَبَأَ إِبْرَاهِيمَ"},"context":"تعقيبٌ بعد آيةٍ لم يؤمن بها أكثرهم، وقبل نبأ إبراهيم.","reason":"ربك عزيز ينتقم من المكذبين، رحيم ينجي أولياءه."},{"i":130,"of":224,"s":26,"surah":"الشعراء","a":104,"text":"وَإِنَّ رَبَّكَ لَهُوَ الْعَزِيزُ الرَّحِيمُ","prev":{"a":103,"text":"إِنَّ فِي ذَلِكَ لَآيَةً وَمَا كَانَ أَكْثَرُهُمْ مُؤْمِنِينَ"},"next":{"a":105,"text":"كَذَّبَتْ قَوْمُ نُوحٍ الْمُرْسَلِينَ"},"context":"تعقيبٌ بعد آيةٍ لم يؤمن بها أكثرهم، وقبل تكذيب قوم نوح.","reason":"ربك عزيز في نصرة رسله، رحيم بمن يرجع إليه."},{"i":131,"of":224,"s":26,"surah":"الشعراء","a":122,"text":"وَإِنَّ رَبَّكَ لَهُوَ الْعَزِيزُ الرَّحِيمُ","prev":{"a":121,"text":"إِنَّ فِي ذَلِكَ لَآيَةً وَمَا كَانَ أَكْثَرُهُمْ مُؤْمِنِينَ"},"next":{"a":123,"text":"كَذَّبَتْ عَادٌ الْمُرْسَلِينَ"},"context":"تعقيبٌ بعد آيةٍ لم يؤمن بها أكثرهم، وقبل تكذيب عاد.","reason":"ربك عزيز يأخذ المكذبين، رحيم لا يعجّل عليهم."},{"i":132,"of":224,"s":26,"surah":"الشعراء","a":140,"text":"وَإِنَّ رَبَّكَ لَهُوَ الْعَزِيزُ الرَّحِيمُ","prev":{"a":139,"text":"فَكَذَّبُوهُ فَأَهْلَكْنَاهُمْ إِنَّ فِي ذَلِكَ لَآيَةً وَمَا كَانَ أَكْثَرُهُمْ مُؤْمِنِينَ"},"next":{"a":141,"text":"كَذَّبَتْ ثَمُودُ الْمُرْسَلِينَ"},"context":"بعد أن كذّبوا رسولهم فأهلكهم الله، وقبل تكذيب ثمود.","reason":"تكذيبهم انتهى بالهلاك، فربك عزيز، وهو رحيم بمن آمن."},{"i":133,"of":224,"s":26,"surah":"الشعراء","a":159,"text":"وَإِنَّ رَبَّكَ لَهُوَ الْعَزِيزُ الرَّحِيمُ","prev":{"a":158,"text":"فَأَخَذَهُمُ الْعَذَابُ إِنَّ فِي ذَلِكَ لَآيَةً وَمَا كَانَ أَكْثَرُهُمْ مُؤْمِنِينَ"},"next":{"a":160,"text":"كَذَّبَتْ قَوْمُ لُوطٍ الْمُرْسَلِينَ"},"context":"بعد أن أخذهم العذاب، وقبل تكذيب قوم لوط.","reason":"أخذُهم بالعذاب من عزّة ربك، وإمهال غيرهم من رحمته."},{"i":134,"of":224,"s":26,"surah":"الشعراء","a":175,"text":"وَإِنَّ رَبَّكَ لَهُوَ الْعَزِيزُ الرَّحِيمُ","prev":{"a":174,"text":"إِنَّ فِي ذَلِكَ لَآيَةً وَمَا كَانَ أَكْثَرُهُمْ مُؤْمِنِينَ"},"next":{"a":176,"text":"كَذَّبَ أَصْحَابُ الْأَيْكَةِ الْمُرْسَلِينَ"},"context":"تعقيبٌ بعد آيةٍ لم يؤمن بها أكثرهم، وقبل تكذيب أصحاب الأيكة.","reason":"ربك عزيز في عقاب المكذبين، رحيم بمن آمن."},{"i":135,"of":224,"s":26,"surah":"الشعراء","a":191,"text":"وَإِنَّ رَبَّكَ لَهُوَ الْعَزِيزُ الرَّحِيمُ","prev":{"a":190,"text":"إِنَّ فِي ذَلِكَ لَآيَةً وَمَا كَانَ أَكْثَرُهُمْ مُؤْمِنِينَ"},"next":{"a":192,"text":"وَإِنَّهُ لَتَنْزِيلُ رَبِّ الْعَالَمِينَ"},"context":"تعقيبٌ بعد آيةٍ لم يؤمن بها أكثرهم، وقبل تقرير أن القرآن تنزيل رب العالمين.","reason":"ربك عزيز في أخذ المكذبين، رحيم بمن اتبع رسله."},{"i":136,"of":224,"s":27,"surah":"النمل","a":73,"text":"وَإِنَّ رَبَّكَ لَذُو فَضْلٍ عَلَى النَّاسِ وَلَكِنَّ أَكْثَرَهُمْ لَا يَشْكُرُونَ","prev":{"a":72,"text":"قُلْ عَسَى أَنْ يَكُونَ رَدِفَ لَكُمْ بَعْضُ الَّذِي تَسْتَعْجِلُونَ"},"next":{"a":74,"text":"وَإِنَّ رَبَّكَ لَيَعْلَمُ مَا تُكِنُّ صُدُورُهُمْ وَمَا يُعْلِنُونَ"},"context":"المكذبون يستعجلون العذاب فيُقال لهم عسى أن يكون قريبًا.","reason":"تأخير العذاب فضلٌ من ربك على الناس، وأكثرهم لا يشكره."},{"i":137,"of":224,"s":27,"surah":"النمل","a":74,"text":"وَإِنَّ رَبَّكَ لَيَعْلَمُ مَا تُكِنُّ صُدُورُهُمْ وَمَا يُعْلِنُونَ","prev":{"a":73,"text":"وَإِنَّ رَبَّكَ لَذُو فَضْلٍ عَلَى النَّاسِ وَلَكِنَّ أَكْثَرَهُمْ لَا يَشْكُرُونَ"},"next":{"a":75,"text":"وَمَا مِنْ غَائِبَةٍ فِي السَّمَاءِ وَالْأَرْضِ إِلَّا فِي كِتَابٍ مُبِينٍ"},"context":"بعد ذكر فضل الله وقلة شكر الناس.","reason":"ربك يعلم ما يخفونه وما يظهرونه، فالإمهال ليس جهلًا بحالهم."},{"i":138,"of":224,"s":27,"surah":"النمل","a":78,"text":"إِنَّ رَبَّكَ يَقْضِي بَيْنَهُمْ بِحُكْمِهِ وَهُوَ الْعَزِيزُ الْعَلِيمُ","prev":{"a":77,"text":"وَإِنَّهُ لَهُدًى وَرَحْمَةٌ لِلْمُؤْمِنِينَ"},"next":{"a":79,"text":"فَتَوَكَّلْ عَلَى اللَّهِ إِنَّكَ عَلَى الْحَقِّ الْمُبِينِ"},"context":"بعد وصف القرآن بأنه هدى ورحمة للمؤمنين، وقبل الأمر بالتوكل.","reason":"ربك يقضي بين المختلفين بحكمه، وهو العزيز العليم."},{"i":139,"of":224,"s":27,"surah":"النمل","a":93,"text":"وَقُلِ الْحَمْدُ لِلَّهِ سَيُرِيكُمْ آيَاتِهِ فَتَعْرِفُونَهَا وَمَا رَبُّكَ بِغَافِلٍ عَمَّا تَعْمَلُونَ","prev":{"a":92,"text":"وَأَنْ أَتْلُوَ الْقُرْآنَ فَمَنِ اهْتَدَى فَإِنَّمَا يَهْتَدِي لِنَفْسِهِ وَمَنْ ضَلَّ فَقُلْ إِنَّمَا أَنَا مِنَ الْمُنْذِرِينَ"},"context":"بعد أمر النبي ﷺ بتلاوة القرآن، وأن من ضلّ فإنما هو من المنذرين.","reason":"ربك لا يغفل عن عمل أحد، فالجزاء آتٍ."},{"i":140,"of":224,"s":28,"surah":"القصص","a":32,"text":"اسْلُكْ يَدَكَ فِي جَيْبِكَ تَخْرُجْ بَيْضَاءَ مِنْ غَيْرِ سُوءٍ وَاضْمُمْ إِلَيْكَ جَنَاحَكَ مِنَ الرَّهْبِ فَذَانِكَ بُرْهَانَانِ مِنْ رَبِّكَ إِلَى فِرْعَوْنَ وَمَلَئِهِ إِنَّهُمْ كَانُوا قَوْمًا فَاسِقِينَ","prev":{"a":31,"text":"وَأَنْ أَلْقِ عَصَاكَ فَلَمَّا رَآهَا تَهْتَزُّ كَأَنَّهَا جَانٌّ وَلَّى مُدْبِرًا وَلَمْ يُعَقِّبْ يَا مُوسَى أَقْبِلْ وَلَا تَخَفْ إِنَّكَ مِنَ الْآمِنِينَ"},"next":{"a":33,"text":"قَالَ رَبِّ إِنِّي قَتَلْتُ مِنْهُمْ نَفْسًا فَأَخَافُ أَنْ يَقْتُلُونِ"},"context":"موسى عند الشجرة يُؤمر بإلقاء العصا فيخاف ويولّي.","reason":"آيتا العصا واليد برهانان من ربك يثبّت بهما قلب موسى الخائف."},{"i":141,"of":224,"s":28,"surah":"القصص","a":46,"text":"وَمَا كُنْتَ بِجَانِبِ الطُّورِ إِذْ نَادَيْنَا وَلَكِنْ رَحْمَةً مِنْ رَبِّكَ لِتُنْذِرَ قَوْمًا مَا أَتَاهُمْ مِنْ نَذِيرٍ مِنْ قَبْلِكَ لَعَلَّهُمْ يَتَذَكَّرُونَ","prev":{"a":45,"text":"وَلَكِنَّا أَنْشَأْنَا قُرُونًا فَتَطَاوَلَ عَلَيْهِمُ الْعُمُرُ وَمَا كُنْتَ ثَاوِيًا فِي أَهْلِ مَدْيَنَ تَتْلُو عَلَيْهِمْ آيَاتِنَا وَلَكِنَّا كُنَّا مُرْسِلِينَ"},"next":{"a":47,"text":"وَلَوْلَا أَنْ تُصِيبَهُمْ مُصِيبَةٌ بِمَا قَدَّمَتْ أَيْدِيهِمْ فَيَقُولُوا رَبَّنَا لَوْلَا أَرْسَلْتَ إِلَيْنَا رَسُولًا فَنَتَّبِعَ آيَاتِكَ وَنَكُونَ مِنَ الْمُؤْمِنِينَ"},"context":"ذكر أن النبي ﷺ لم يكن حاضرًا لأخبار موسى.","reason":"علم النبي ﷺ بما غاب عنه رحمةٌ من ربه ليُنذر قومه."},{"i":142,"of":224,"s":28,"surah":"القصص","a":59,"text":"وَمَا كَانَ رَبُّكَ مُهْلِكَ الْقُرَى حَتَّى يَبْعَثَ فِي أُمِّهَا رَسُولًا يَتْلُو عَلَيْهِمْ آيَاتِنَا وَمَا كُنَّا مُهْلِكِي الْقُرَى إِلَّا وَأَهْلُهَا ظَالِمُونَ","prev":{"a":58,"text":"وَكَمْ أَهْلَكْنَا مِنْ قَرْيَةٍ بَطِرَتْ مَعِيشَتَهَا فَتِلْكَ مَسَاكِنُهُمْ لَمْ تُسْكَنْ مِنْ بَعْدِهِمْ إِلَّا قَلِيلًا وَكُنَّا نَحْنُ الْوَارِثِينَ"},"next":{"a":60,"text":"وَمَا أُوتِيتُمْ مِنْ شَيْءٍ فَمَتَاعُ الْحَيَاةِ الدُّنْيَا وَزِينَتُهَا وَمَا عِنْدَ اللَّهِ خَيْرٌ وَأَبْقَى أَفَلَا تَعْقِلُونَ"},"context":"بعد ذكر القرى التي بطرت معيشتها فأُهلكت.","reason":"عدل ربك ألا يهلك قومًا قبل أن يبعث إليهم رسولًا."},{"i":143,"of":224,"s":28,"surah":"القصص","a":68,"text":"وَرَبُّكَ يَخْلُقُ مَا يَشَاءُ وَيَخْتَارُ مَا كَانَ لَهُمُ الْخِيَرَةُ سُبْحَانَ اللَّهِ وَتَعَالَى عَمَّا يُشْرِكُونَ","prev":{"a":67,"text":"فَأَمَّا مَنْ تَابَ وَآمَنَ وَعَمِلَ صَالِحًا فَعَسَى أَنْ يَكُونَ مِنَ الْمُفْلِحِينَ"},"next":{"a":69,"text":"وَرَبُّكَ يَعْلَمُ مَا تُكِنُّ صُدُورُهُمْ وَمَا يُعْلِنُونَ"},"context":"بعد ذكر من تاب وآمن وعمل صالحًا.","reason":"الخلق والاختيار لربك وحده، وليس للناس أن يختاروا عليه."},{"i":144,"of":224,"s":28,"surah":"القصص","a":69,"text":"وَرَبُّكَ يَعْلَمُ مَا تُكِنُّ صُدُورُهُمْ وَمَا يُعْلِنُونَ","prev":{"a":68,"text":"وَرَبُّكَ يَخْلُقُ مَا يَشَاءُ وَيَخْتَارُ مَا كَانَ لَهُمُ الْخِيَرَةُ سُبْحَانَ اللَّهِ وَتَعَالَى عَمَّا يُشْرِكُونَ"},"next":{"a":70,"text":"وَهُوَ اللَّهُ لَا إِلَهَ إِلَّا هُوَ لَهُ الْحَمْدُ فِي الْأُولَى وَالْآخِرَةِ وَلَهُ الْحُكْمُ وَإِلَيْهِ تُرْجَعُونَ"},"context":"بعد تقرير أن الاختيار لله وحده.","reason":"ربك يعلم ما في القلوب، فاختياره عن علمٍ بخفاياها."},{"i":145,"of":224,"s":28,"surah":"القصص","a":86,"text":"وَمَا كُنْتَ تَرْجُو أَنْ يُلْقَى إِلَيْكَ الْكِتَابُ إِلَّا رَحْمَةً مِنْ رَبِّكَ فَلَا تَكُونَنَّ ظَهِيرًا لِلْكَافِرِينَ","prev":{"a":85,"text":"إِنَّ الَّذِي فَرَضَ عَلَيْكَ الْقُرْآنَ لَرَادُّكَ إِلَى مَعَادٍ قُلْ رَبِّي أَعْلَمُ مَنْ جَاءَ بِالْهُدَى وَمَنْ هُوَ فِي ضَلَالٍ مُبِينٍ"},"next":{"a":87,"text":"وَلَا يَصُدُّنَّكَ عَنْ آيَاتِ اللَّهِ بَعْدَ إِذْ أُنْزِلَتْ إِلَيْكَ وَادْعُ إِلَى رَبِّكَ وَلَا تَكُونَنَّ مِنَ الْمُشْرِكِينَ"},"context":"بعد وعد النبي ﷺ بالردّ إلى معاد، وأن ربه أعلم بالمهتدي والضال.","reason":"نزول الكتاب لم يكن أملًا يرجوه، بل رحمة من ربه."},{"i":146,"of":224,"s":28,"surah":"القصص","a":87,"text":"وَلَا يَصُدُّنَّكَ عَنْ آيَاتِ اللَّهِ بَعْدَ إِذْ أُنْزِلَتْ إِلَيْكَ وَادْعُ إِلَى رَبِّكَ وَلَا تَكُونَنَّ مِنَ الْمُشْرِكِينَ","prev":{"a":86,"text":"وَمَا كُنْتَ تَرْجُو أَنْ يُلْقَى إِلَيْكَ الْكِتَابُ إِلَّا رَحْمَةً مِنْ رَبِّكَ فَلَا تَكُونَنَّ ظَهِيرًا لِلْكَافِرِينَ"},"next":{"a":88,"text":"وَلَا تَدْعُ مَعَ اللَّهِ إِلَهًا آخَرَ لَا إِلَهَ إِلَّا هُوَ كُلُّ شَيْءٍ هَالِكٌ إِلَّا وَجْهَهُ لَهُ الْحُكْمُ وَإِلَيْهِ تُرْجَعُونَ"},"context":"بعد النهي عن مظاهرة الكافرين.","reason":"الدعوة إلى «ربك» تحصّن الداعي من أن يُصدّ عن الآيات."},{"i":147,"of":224,"s":29,"surah":"العنكبوت","a":10,"text":"وَمِنَ النَّاسِ مَنْ يَقُولُ آمَنَّا بِاللَّهِ فَإِذَا أُوذِيَ فِي اللَّهِ جَعَلَ فِتْنَةَ النَّاسِ كَعَذَابِ اللَّهِ وَلَئِنْ جَاءَ نَصْرٌ مِنْ رَبِّكَ لَيَقُولُنَّ إِنَّا كُنَّا مَعَكُمْ أَوَلَيْسَ اللَّهُ بِأَعْلَمَ بِمَا فِي صُدُورِ الْعَالَمِينَ","prev":{"a":9,"text":"وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَنُدْخِلَنَّهُمْ فِي الصَّالِحِينَ"},"next":{"a":11,"text":"وَلَيَعْلَمَنَّ اللَّهُ الَّذِينَ آمَنُوا وَلَيَعْلَمَنَّ الْمُنَافِقِينَ"},"context":"بعد وعد المؤمنين العاملين بالدخول في الصالحين، يُذكر صنفٌ يتزعزع عند الأذى.","reason":"إذا جاء نصر ربك ادّعى المتلونون أنهم كانوا مع المؤمنين."},{"i":148,"of":224,"s":32,"surah":"السجدة","a":3,"text":"أَمْ يَقُولُونَ افْتَرَاهُ بَلْ هُوَ الْحَقُّ مِنْ رَبِّكَ لِتُنْذِرَ قَوْمًا مَا أَتَاهُمْ مِنْ نَذِيرٍ مِنْ قَبْلِكَ لَعَلَّهُمْ يَهْتَدُونَ","prev":{"a":2,"text":"تَنْزِيلُ الْكِتَابِ لَا رَيْبَ فِيهِ مِنْ رَبِّ الْعَالَمِينَ"},"next":{"a":4,"text":"اللَّهُ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ وَمَا بَيْنَهُمَا فِي سِتَّةِ أَيَّامٍ ثُمَّ اسْتَوَى عَلَى الْعَرْشِ مَا لَكُمْ مِنْ دُونِهِ مِنْ وَلِيٍّ وَلَا شَفِيعٍ أَفَلَا تَتَذَكَّرُونَ"},"context":"افتتاح السجدة بأن الكتاب لا ريب فيه من رب العالمين.","reason":"القرآن حقٌّ من ربك وليس افتراءً كما يزعمون."},{"i":149,"of":224,"s":32,"surah":"السجدة","a":25,"text":"إِنَّ رَبَّكَ هُوَ يَفْصِلُ بَيْنَهُمْ يَوْمَ الْقِيَامَةِ فِيمَا كَانُوا فِيهِ يَخْتَلِفُونَ","prev":{"a":24,"text":"وَجَعَلْنَا مِنْهُمْ أَئِمَّةً يَهْدُونَ بِأَمْرِنَا لَمَّا صَبَرُوا وَكَانُوا بِآيَاتِنَا يُوقِنُونَ"},"next":{"a":26,"text":"أَوَلَمْ يَهْدِ لَهُمْ كَمْ أَهْلَكْنَا مِنْ قَبْلِهِمْ مِنَ الْقُرُونِ يَمْشُونَ فِي مَسَاكِنِهِمْ إِنَّ فِي ذَلِكَ لَآيَاتٍ أَفَلَا يَسْمَعُونَ"},"context":"ذكر أئمة بني إسرائيل الذين صبروا وأيقنوا.","reason":"ربك هو الذي يفصل في الخلاف يوم القيامة."},{"i":150,"of":224,"s":33,"surah":"الأحزاب","a":2,"text":"وَاتَّبِعْ مَا يُوحَى إِلَيْكَ مِنْ رَبِّكَ إِنَّ اللَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًا","prev":{"a":1,"text":"يَا أَيُّهَا النَّبِيُّ اتَّقِ اللَّهَ وَلَا تُطِعِ الْكَافِرِينَ وَالْمُنَافِقِينَ إِنَّ اللَّهَ كَانَ عَلِيمًا حَكِيمًا"},"next":{"a":3,"text":"وَتَوَكَّلْ عَلَى اللَّهِ وَكَفَى بِاللَّهِ وَكِيلًا"},"context":"افتتاح الأحزاب بأمر النبي ﷺ بالتقوى وعدم طاعة الكافرين.","reason":"اتباع ما يوحيه ربك هو البديل عن طاعة أهل الأهواء."},{"i":151,"of":224,"s":34,"surah":"سبأ","a":6,"text":"وَيَرَى الَّذِينَ أُوتُوا الْعِلْمَ الَّذِي أُنْزِلَ إِلَيْكَ مِنْ رَبِّكَ هُوَ الْحَقَّ وَيَهْدِي إِلَى صِرَاطِ الْعَزِيزِ الْحَمِيدِ","prev":{"a":5,"text":"وَالَّذِينَ سَعَوْا فِي آيَاتِنَا مُعَاجِزِينَ أُولَئِكَ لَهُمْ عَذَابٌ مِنْ رِجْزٍ أَلِيمٌ"},"next":{"a":7,"text":"وَقَالَ الَّذِينَ كَفَرُوا هَلْ نَدُلُّكُمْ عَلَى رَجُلٍ يُنَبِّئُكُمْ إِذَا مُزِّقْتُمْ كُلَّ مُمَزَّقٍ إِنَّكُمْ لَفِي خَلْقٍ جَدِيدٍ"},"context":"بعد وعيد الذين سعوا في الآيات معاجزين.","reason":"أهل العلم يرون أن المنزل من ربك هو الحق الهادي."},{"i":152,"of":224,"s":34,"surah":"سبأ","a":21,"text":"وَمَا كَانَ لَهُ عَلَيْهِمْ مِنْ سُلْطَانٍ إِلَّا لِنَعْلَمَ مَنْ يُؤْمِنُ بِالْآخِرَةِ مِمَّنْ هُوَ مِنْهَا فِي شَكٍّ وَرَبُّكَ عَلَى كُلِّ شَيْءٍ حَفِيظٌ","prev":{"a":20,"text":"وَلَقَدْ صَدَّقَ عَلَيْهِمْ إِبْلِيسُ ظَنَّهُ فَاتَّبَعُوهُ إِلَّا فَرِيقًا مِنَ الْمُؤْمِنِينَ"},"next":{"a":22,"text":"قُلِ ادْعُوا الَّذِينَ زَعَمْتُمْ مِنْ دُونِ اللَّهِ لَا يَمْلِكُونَ مِثْقَالَ ذَرَّةٍ فِي السَّمَاوَاتِ وَلَا فِي الْأَرْضِ وَمَا لَهُمْ فِيهِمَا مِنْ شِرْكٍ وَمَا لَهُ مِنْهُمْ مِنْ ظَهِيرٍ"},"context":"بعد ذكر أن إبليس صدّق عليهم ظنه فاتبعوه إلا فريقًا من المؤمنين.","reason":"سلطان إبليس محدود، وربك حفيظ على كل شيء."},{"i":153,"of":224,"s":37,"surah":"الصافات","a":149,"text":"فَاسْتَفْتِهِمْ أَلِرَبِّكَ الْبَنَاتُ وَلَهُمُ الْبَنُونَ","prev":{"a":148,"text":"فَآمَنُوا فَمَتَّعْنَاهُمْ إِلَى حِينٍ"},"next":{"a":150,"text":"أَمْ خَلَقْنَا الْمَلَائِكَةَ إِنَاثًا وَهُمْ شَاهِدُونَ"},"context":"بعد ذكر قومٍ آمنوا فمُتّعوا إلى حين، يُؤمر النبي ﷺ أن يستفتي المشركين في زعمهم.","reason":"إنكار نسبة البنات إلى ربك الذي له الكمال."},{"i":154,"of":224,"s":37,"surah":"الصافات","a":180,"text":"سُبْحَانَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُونَ","prev":{"a":179,"text":"وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ"},"next":{"a":181,"text":"وَسَلَامٌ عَلَى الْمُرْسَلِينَ"},"context":"بعد وعيد المكذبين بأنهم سوف يبصرون، تُختم السورة بالتنزيه والسلام على المرسلين.","reason":"تنزيه ربك رب العزة عما يصفه به المشركون."},{"i":155,"of":224,"s":38,"surah":"ص","a":9,"text":"أَمْ عِنْدَهُمْ خَزَائِنُ رَحْمَةِ رَبِّكَ الْعَزِيزِ الْوَهَّابِ","prev":{"a":8,"text":"أَأُنْزِلَ عَلَيْهِ الذِّكْرُ مِنْ بَيْنِنَا بَلْ هُمْ فِي شَكٍّ مِنْ ذِكْرِي بَلْ لَمَّا يَذُوقُوا عَذَابِ"},"next":{"a":10,"text":"أَمْ لَهُمْ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا فَلْيَرْتَقُوا فِي الْأَسْبَابِ"},"context":"المشركون ينكرون أن يُنزل الذكر على النبي ﷺ من بينهم.","reason":"خزائن الرحمة لربك الوهاب وحده، فهو يعطي من يشاء."},{"i":156,"of":224,"s":38,"surah":"ص","a":71,"text":"إِذْ قَالَ رَبُّكَ لِلْمَلَائِكَةِ إِنِّي خَالِقٌ بَشَرًا مِنْ طِينٍ","prev":{"a":70,"text":"إِنْ يُوحَى إِلَيَّ إِلَّا أَنَّمَا أَنَا نَذِيرٌ مُبِينٌ"},"next":{"a":72,"text":"فَإِذَا سَوَّيْتُهُ وَنَفَخْتُ فِيهِ مِنْ رُوحِي فَقَعُوا لَهُ سَاجِدِينَ"},"context":"بعد قول النبي ﷺ إن ما يوحى إليه أنما هو نذير مبين.","reason":"ربك أخبر الملائكة بخلق بشر من طين، وأمرهم بالسجود له إذا نفخ فيه من روحه."},{"i":157,"of":224,"s":40,"surah":"غافر","a":6,"text":"وَكَذَلِكَ حَقَّتْ كَلِمَتُ رَبِّكَ عَلَى الَّذِينَ كَفَرُوا أَنَّهُمْ أَصْحَابُ النَّارِ","prev":{"a":5,"text":"كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ وَالْأَحْزَابُ مِنْ بَعْدِهِمْ وَهَمَّتْ كُلُّ أُمَّةٍ بِرَسُولِهِمْ لِيَأْخُذُوهُ وَجَادَلُوا بِالْبَاطِلِ لِيُدْحِضُوا بِهِ الْحَقَّ فَأَخَذْتُهُمْ فَكَيْفَ كَانَ عِقَابِ"},"next":{"a":7,"text":"الَّذِينَ يَحْمِلُونَ الْعَرْشَ وَمَنْ حَوْلَهُ يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ وَيُؤْمِنُونَ بِهِ وَيَسْتَغْفِرُونَ لِلَّذِينَ آمَنُوا رَبَّنَا وَسِعْتَ كُلَّ شَيْءٍ رَحْمَةً وَعِلْمًا فَاغْفِرْ لِلَّذِينَ تَابُوا وَاتَّبَعُوا سَبِيلَكَ وَقِهِمْ عَذَابَ الْجَحِيمِ"},"context":"بعد ذكر أخذ الأمم المكذبة التي جادلت بالباطل.","reason":"كلمة ربك نافذة على الكافرين كما نفذت فيمن قبلهم."},{"i":158,"of":224,"s":40,"surah":"غافر","a":55,"text":"فَاصْبِرْ إِنَّ وَعْدَ اللَّهِ حَقٌّ وَاسْتَغْفِرْ لِذَنْبِكَ وَسَبِّحْ بِحَمْدِ رَبِّكَ بِالْعَشِيِّ وَالْإِبْكَارِ","prev":{"a":54,"text":"هُدًى وَذِكْرَى لِأُولِي الْأَلْبَابِ"},"next":{"a":56,"text":"إِنَّ الَّذِينَ يُجَادِلُونَ فِي آيَاتِ اللَّهِ بِغَيْرِ سُلْطَانٍ أَتَاهُمْ إِنْ فِي صُدُورِهِمْ إِلَّا كِبْرٌ مَا هُمْ بِبَالِغِيهِ فَاسْتَعِذْ بِاللَّهِ إِنَّهُ هُوَ السَّمِيعُ الْبَصِيرُ"},"context":"بعد ذكر الهدى والذكرى لأولي الألباب، يُؤمر النبي ﷺ بالصبر.","reason":"الصبر والاستغفار والتسبيح بحمد ربك زاد انتظار وعد الله."},{"i":159,"of":224,"s":41,"surah":"فصلت","a":38,"text":"فَإِنِ اسْتَكْبَرُوا فَالَّذِينَ عِنْدَ رَبِّكَ يُسَبِّحُونَ لَهُ بِاللَّيْلِ وَالنَّهَارِ وَهُمْ لَا يَسْأَمُونَ","prev":{"a":37,"text":"وَمِنْ آيَاتِهِ اللَّيْلُ وَالنَّهَارُ وَالشَّمْسُ وَالْقَمَرُ لَا تَسْجُدُوا لِلشَّمْسِ وَلَا لِلْقَمَرِ وَاسْجُدُوا لِلَّهِ الَّذِي خَلَقَهُنَّ إِنْ كُنْتُمْ إِيَّاهُ تَعْبُدُونَ"},"next":{"a":39,"text":"وَمِنْ آيَاتِهِ أَنَّكَ تَرَى الْأَرْضَ خَاشِعَةً فَإِذَا أَنْزَلْنَا عَلَيْهَا الْمَاءَ اهْتَزَّتْ وَرَبَتْ إِنَّ الَّذِي أَحْيَاهَا لَمُحْيِي الْمَوْتَى إِنَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},"context":"الأمر بالسجود لله لا للشمس والقمر.","reason":"إن استكبر البشر فعند ربك ملائكة لا تفتر عن تسبيحه."},{"i":160,"of":224,"s":41,"surah":"فصلت","a":43,"text":"مَا يُقَالُ لَكَ إِلَّا مَا قَدْ قِيلَ لِلرُّسُلِ مِنْ قَبْلِكَ إِنَّ رَبَّكَ لَذُو مَغْفِرَةٍ وَذُو عِقَابٍ أَلِيمٍ","prev":{"a":42,"text":"لَا يَأْتِيهِ الْبَاطِلُ مِنْ بَيْنِ يَدَيْهِ وَلَا مِنْ خَلْفِهِ تَنْزِيلٌ مِنْ حَكِيمٍ حَمِيدٍ"},"next":{"a":44,"text":"وَلَوْ جَعَلْنَاهُ قُرْآنًا أَعْجَمِيًّا لَقَالُوا لَوْلَا فُصِّلَتْ آيَاتُهُ أَأَعْجَمِيٌّ وَعَرَبِيٌّ قُلْ هُوَ لِلَّذِينَ آمَنُوا هُدًى وَشِفَاءٌ وَالَّذِينَ لَا يُؤْمِنُونَ فِي آذَانِهِمْ وَقْرٌ وَهُوَ عَلَيْهِمْ عَمًى أُولَئِكَ يُنَادَوْنَ مِنْ مَكَانٍ بَعِيدٍ"},"context":"بعد وصف القرآن بأنه لا يأتيه الباطل، تنزيل من حكيم حميد.","reason":"ما يقال للنبي ﷺ قيل لمن قبله، وربك ذو مغفرة وعقاب."},{"i":161,"of":224,"s":41,"surah":"فصلت","a":45,"text":"وَلَقَدْ آتَيْنَا مُوسَى الْكِتَابَ فَاخْتُلِفَ فِيهِ وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِنْ رَبِّكَ لَقُضِيَ بَيْنَهُمْ وَإِنَّهُمْ لَفِي شَكٍّ مِنْهُ مُرِيبٍ","prev":{"a":44,"text":"وَلَوْ جَعَلْنَاهُ قُرْآنًا أَعْجَمِيًّا لَقَالُوا لَوْلَا فُصِّلَتْ آيَاتُهُ أَأَعْجَمِيٌّ وَعَرَبِيٌّ قُلْ هُوَ لِلَّذِينَ آمَنُوا هُدًى وَشِفَاءٌ وَالَّذِينَ لَا يُؤْمِنُونَ فِي آذَانِهِمْ وَقْرٌ وَهُوَ عَلَيْهِمْ عَمًى أُولَئِكَ يُنَادَوْنَ مِنْ مَكَانٍ بَعِيدٍ"},"next":{"a":46,"text":"مَنْ عَمِلَ صَالِحًا فَلِنَفْسِهِ وَمَنْ أَسَاءَ فَعَلَيْهَا وَمَا رَبُّكَ بِظَلَّامٍ لِلْعَبِيدِ"},"context":"بعد بيان أن القرآن للذين آمنوا هدى وشفاء.","reason":"كلمة ربك السابقة بالتأجيل هي التي أخّرت القضاء بين المختلفين."},{"i":162,"of":224,"s":41,"surah":"فصلت","a":46,"text":"مَنْ عَمِلَ صَالِحًا فَلِنَفْسِهِ وَمَنْ أَسَاءَ فَعَلَيْهَا وَمَا رَبُّكَ بِظَلَّامٍ لِلْعَبِيدِ","prev":{"a":45,"text":"وَلَقَدْ آتَيْنَا مُوسَى الْكِتَابَ فَاخْتُلِفَ فِيهِ وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِنْ رَبِّكَ لَقُضِيَ بَيْنَهُمْ وَإِنَّهُمْ لَفِي شَكٍّ مِنْهُ مُرِيبٍ"},"next":{"a":47,"text":"إِلَيْهِ يُرَدُّ عِلْمُ السَّاعَةِ وَمَا تَخْرُجُ مِنْ ثَمَرَاتٍ مِنْ أَكْمَامِهَا وَمَا تَحْمِلُ مِنْ أُنْثَى وَلَا تَضَعُ إِلَّا بِعِلْمِهِ وَيَوْمَ يُنَادِيهِمْ أَيْنَ شُرَكَائِي قَالُوا آذَنَّاكَ مَا مِنَّا مِنْ شَهِيدٍ"},"context":"بعد ذكر الاختلاف في كتاب موسى وتأجيل القضاء بينهم.","reason":"ربك لا يظلم عبيده، فكل عامل يلقى عمله."},{"i":163,"of":224,"s":41,"surah":"فصلت","a":53,"text":"سَنُرِيهِمْ آيَاتِنَا فِي الْآفَاقِ وَفِي أَنْفُسِهِمْ حَتَّى يَتَبَيَّنَ لَهُمْ أَنَّهُ الْحَقُّ أَوَلَمْ يَكْفِ بِرَبِّكَ أَنَّهُ عَلَى كُلِّ شَيْءٍ شَهِيدٌ","prev":{"a":52,"text":"قُلْ أَرَأَيْتُمْ إِنْ كَانَ مِنْ عِنْدِ اللَّهِ ثُمَّ كَفَرْتُمْ بِهِ مَنْ أَضَلُّ مِمَّنْ هُوَ فِي شِقَاقٍ بَعِيدٍ"},"next":{"a":54,"text":"أَلَا إِنَّهُمْ فِي مِرْيَةٍ مِنْ لِقَاءِ رَبِّهِمْ أَلَا إِنَّهُ بِكُلِّ شَيْءٍ مُحِيطٌ"},"context":"بعد تحذير المكذبين: أرأيتم إن كان القرآن من عند الله ثم كفرتم به؟","reason":"شهادة ربك على كل شيء كافية دليلًا على الحق."},{"i":164,"of":224,"s":42,"surah":"الشورى","a":14,"text":"وَمَا تَفَرَّقُوا إِلَّا مِنْ بَعْدِ مَا جَاءَهُمُ الْعِلْمُ بَغْيًا بَيْنَهُمْ وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِنْ رَبِّكَ إِلَى أَجَلٍ مُسَمًّى لَقُضِيَ بَيْنَهُمْ وَإِنَّ الَّذِينَ أُورِثُوا الْكِتَابَ مِنْ بَعْدِهِمْ لَفِي شَكٍّ مِنْهُ مُرِيبٍ","prev":{"a":13,"text":"شَرَعَ لَكُمْ مِنَ الدِّينِ مَا وَصَّى بِهِ نُوحًا وَالَّذِي أَوْحَيْنَا إِلَيْكَ وَمَا وَصَّيْنَا بِهِ إِبْرَاهِيمَ وَمُوسَى وَعِيسَى أَنْ أَقِيمُوا الدِّينَ وَلَا تَتَفَرَّقُوا فِيهِ كَبُرَ عَلَى الْمُشْرِكِينَ مَا تَدْعُوهُمْ إِلَيْهِ اللَّهُ يَجْتَبِي إِلَيْهِ مَنْ يَشَاءُ وَيَهْدِي إِلَيْهِ مَنْ يُنِيبُ"},"next":{"a":15,"text":"فَلِذَلِكَ فَادْعُ وَاسْتَقِمْ كَمَا أُمِرْتَ وَلَا تَتَّبِعْ أَهْوَاءَهُمْ وَقُلْ آمَنْتُ بِمَا أَنْزَلَ اللَّهُ مِنْ كِتَابٍ وَأُمِرْتُ لِأَعْدِلَ بَيْنَكُمُ اللَّهُ رَبُّنَا وَرَبُّكُمْ لَنَا أَعْمَالُنَا وَلَكُمْ أَعْمَالُكُمْ لَا حُجَّةَ بَيْنَنَا وَبَيْنَكُمُ اللَّهُ يَجْمَعُ بَيْنَنَا وَإِلَيْهِ الْمَصِيرُ"},"context":"بعد الأمر بإقامة الدين الذي وُصّي به الأنبياء وعدم التفرق فيه.","reason":"التفرق كان بغيًا بعد العلم، وتأجيل القضاء بكلمة من ربك."},{"i":165,"of":224,"s":43,"surah":"الزخرف","a":32,"text":"أَهُمْ يَقْسِمُونَ رَحْمَتَ رَبِّكَ نَحْنُ قَسَمْنَا بَيْنَهُمْ مَعِيشَتَهُمْ فِي الْحَيَاةِ الدُّنْيَا وَرَفَعْنَا بَعْضَهُمْ فَوْقَ بَعْضٍ دَرَجَاتٍ لِيَتَّخِذَ بَعْضُهُمْ بَعْضًا سُخْرِيًّا وَرَحْمَتُ رَبِّكَ خَيْرٌ مِمَّا يَجْمَعُونَ","prev":{"a":31,"text":"وَقَالُوا لَوْلَا نُزِّلَ هَذَا الْقُرْآنُ عَلَى رَجُلٍ مِنَ الْقَرْيَتَيْنِ عَظِيمٍ"},"next":{"a":33,"text":"وَلَوْلَا أَنْ يَكُونَ النَّاسُ أُمَّةً وَاحِدَةً لَجَعَلْنَا لِمَنْ يَكْفُرُ بِالرَّحْمَنِ لِبُيُوتِهِمْ سُقُفًا مِنْ فِضَّةٍ وَمَعَارِجَ عَلَيْهَا يَظْهَرُونَ"},"context":"المشركون يقترحون نزول القرآن على رجل عظيم من القريتين.","reason":"قسمة المعيشة والرحمة بيد ربك، ورحمته خير من حطام الدنيا."},{"i":166,"of":224,"s":43,"surah":"الزخرف","a":35,"text":"وَزُخْرُفًا وَإِنْ كُلُّ ذَلِكَ لَمَّا مَتَاعُ الْحَيَاةِ الدُّنْيَا وَالْآخِرَةُ عِنْدَ رَبِّكَ لِلْمُتَّقِينَ","prev":{"a":34,"text":"وَلِبُيُوتِهِمْ أَبْوَابًا وَسُرُرًا عَلَيْهَا يَتَّكِئُونَ"},"next":{"a":36,"text":"وَمَنْ يَعْشُ عَنْ ذِكْرِ الرَّحْمَنِ نُقَيِّضْ لَهُ شَيْطَانًا فَهُوَ لَهُ قَرِينٌ"},"context":"بعد ذكر ما كان سيُجعل للكافرين من بيوت وأبواب وسرر يتكئون عليها.","reason":"زخرف الدنيا متاعٌ زائل، والآخرة عند ربك للمتقين."},{"i":167,"of":224,"s":43,"surah":"الزخرف","a":49,"text":"وَقَالُوا يَا أَيُّهَ السَّاحِرُ ادْعُ لَنَا رَبَّكَ بِمَا عَهِدَ عِنْدَكَ إِنَّنَا لَمُهْتَدُونَ","prev":{"a":48,"text":"وَمَا نُرِيهِمْ مِنْ آيَةٍ إِلَّا هِيَ أَكْبَرُ مِنْ أُخْتِهَا وَأَخَذْنَاهُمْ بِالْعَذَابِ لَعَلَّهُمْ يَرْجِعُونَ"},"next":{"a":50,"text":"فَلَمَّا كَشَفْنَا عَنْهُمُ الْعَذَابَ إِذَا هُمْ يَنْكُثُونَ"},"context":"قوم فرعون يُؤخذون بالعذاب لعلهم يرجعون.","reason":"يلجؤون إلى موسى ليدعو ربه عند الشدة ثم ينكثون."},{"i":168,"of":224,"s":43,"surah":"الزخرف","a":77,"text":"وَنَادَوْا يَا مَالِكُ لِيَقْضِ عَلَيْنَا رَبُّكَ قَالَ إِنَّكُمْ مَاكِثُونَ","prev":{"a":76,"text":"وَمَا ظَلَمْنَاهُمْ وَلَكِنْ كَانُوا هُمُ الظَّالِمِينَ"},"next":{"a":78,"text":"لَقَدْ جِئْنَاكُمْ بِالْحَقِّ وَلَكِنَّ أَكْثَرَكُمْ لِلْحَقِّ كَارِهُونَ"},"context":"بعد بيان أن أهل النار لم يُظلموا بل كانوا هم الظالمين.","reason":"ينادون مالكًا ليقضي عليهم ربك، فيُجابون بأنهم ماكثون."},{"i":169,"of":224,"s":44,"surah":"الدخان","a":6,"text":"رَحْمَةً مِنْ رَبِّكَ إِنَّهُ هُوَ السَّمِيعُ الْعَلِيمُ","prev":{"a":5,"text":"أَمْرًا مِنْ عِنْدِنَا إِنَّا كُنَّا مُرْسِلِينَ"},"next":{"a":7,"text":"رَبِّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا إِنْ كُنْتُمْ مُوقِنِينَ"},"context":"بعد ذكر أن الله كان مرسلًا أمرًا من عنده.","reason":"إرسال الرسل رحمة من ربك السميع العليم."},{"i":170,"of":224,"s":44,"surah":"الدخان","a":57,"text":"فَضْلًا مِنْ رَبِّكَ ذَلِكَ هُوَ الْفَوْزُ الْعَظِيمُ","prev":{"a":56,"text":"لَا يَذُوقُونَ فِيهَا الْمَوْتَ إِلَّا الْمَوْتَةَ الْأُولَى وَوَقَاهُمْ عَذَابَ الْجَحِيمِ"},"next":{"a":58,"text":"فَإِنَّمَا يَسَّرْنَاهُ بِلِسَانِكَ لَعَلَّهُمْ يَتَذَكَّرُونَ"},"context":"وصف نعيم المتقين في الجنة ووقايتهم عذاب الجحيم.","reason":"النجاة من الجحيم ونعيم الجنة فضلٌ من ربك، وذلك هو الفوز العظيم."},{"i":171,"of":224,"s":45,"surah":"الجاثية","a":17,"text":"وَآتَيْنَاهُمْ بَيِّنَاتٍ مِنَ الْأَمْرِ فَمَا اخْتَلَفُوا إِلَّا مِنْ بَعْدِ مَا جَاءَهُمُ الْعِلْمُ بَغْيًا بَيْنَهُمْ إِنَّ رَبَّكَ يَقْضِي بَيْنَهُمْ يَوْمَ الْقِيَامَةِ فِيمَا كَانُوا فِيهِ يَخْتَلِفُونَ","prev":{"a":16,"text":"وَلَقَدْ آتَيْنَا بَنِي إِسْرَائِيلَ الْكِتَابَ وَالْحُكْمَ وَالنُّبُوَّةَ وَرَزَقْنَاهُمْ مِنَ الطَّيِّبَاتِ وَفَضَّلْنَاهُمْ عَلَى الْعَالَمِينَ"},"next":{"a":18,"text":"ثُمَّ جَعَلْنَاكَ عَلَى شَرِيعَةٍ مِنَ الْأَمْرِ فَاتَّبِعْهَا وَلَا تَتَّبِعْ أَهْوَاءَ الَّذِينَ لَا يَعْلَمُونَ"},"context":"ذكر ما آتى الله بني إسرائيل من الكتاب والنعم.","reason":"اختلافهم كان بغيًا بعد العلم، وربك يقضي فيه يوم القيامة."},{"i":172,"of":224,"s":50,"surah":"ق","a":39,"text":"فَاصْبِرْ عَلَى مَا يَقُولُونَ وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ الْغُرُوبِ","prev":{"a":38,"text":"وَلَقَدْ خَلَقْنَا السَّمَاوَاتِ وَالْأَرْضَ وَمَا بَيْنَهُمَا فِي سِتَّةِ أَيَّامٍ وَمَا مَسَّنَا مِنْ لُغُوبٍ"},"next":{"a":40,"text":"وَمِنَ اللَّيْلِ فَسَبِّحْهُ وَأَدْبَارَ السُّجُودِ"},"context":"بعد ذكر خلق السماوات والأرض في ستة أيام بلا لغوب.","reason":"الصبر على أقوالهم يُعان عليه بالتسبيح بحمد ربك."},{"i":173,"of":224,"s":51,"surah":"الذاريات","a":30,"text":"قَالُوا كَذَلِكِ قَالَ رَبُّكِ إِنَّهُ هُوَ الْحَكِيمُ الْعَلِيمُ","prev":{"a":29,"text":"فَأَقْبَلَتِ امْرَأَتُهُ فِي صَرَّةٍ فَصَكَّتْ وَجْهَهَا وَقَالَتْ عَجُوزٌ عَقِيمٌ"},"next":{"a":31,"text":"قَالَ فَمَا خَطْبُكُمْ أَيُّهَا الْمُرْسَلُونَ"},"context":"الملائكة تبشر إبراهيم بغلام فتعجب امرأته العجوز العقيم.","reason":"البشارة قول ربك الحكيم العليم فلا مجال للعجب."},{"i":174,"of":224,"s":51,"surah":"الذاريات","a":34,"text":"مُسَوَّمَةً عِنْدَ رَبِّكَ لِلْمُسْرِفِينَ","prev":{"a":33,"text":"لِنُرْسِلَ عَلَيْهِمْ حِجَارَةً مِنْ طِينٍ"},"next":{"a":35,"text":"فَأَخْرَجْنَا مَنْ كَانَ فِيهَا مِنَ الْمُؤْمِنِينَ"},"context":"الملائكة يخبرون إبراهيم أنهم أُرسلوا ليرسلوا حجارة من طين على قومٍ مجرمين.","reason":"الحجارة معلّمة عند ربك لمن أسرف، فالعقوبة مقدّرة."},{"i":175,"of":224,"s":52,"surah":"الطور","a":7,"text":"إِنَّ عَذَابَ رَبِّكَ لَوَاقِعٌ","prev":{"a":6,"text":"وَالْبَحْرِ الْمَسْجُورِ"},"next":{"a":8,"text":"مَا لَهُ مِنْ دَافِعٍ"},"context":"بعد أقسامٍ آخرها البحر المسجور.","reason":"جواب القسم أن عذاب ربك واقع لا محالة."},{"i":176,"of":224,"s":52,"surah":"الطور","a":29,"text":"فَذَكِّرْ فَمَا أَنْتَ بِنِعْمَتِ رَبِّكَ بِكَاهِنٍ وَلَا مَجْنُونٍ","prev":{"a":28,"text":"إِنَّا كُنَّا مِنْ قَبْلُ نَدْعُوهُ إِنَّهُ هُوَ الْبَرُّ الرَّحِيمُ"},"next":{"a":30,"text":"أَمْ يَقُولُونَ شَاعِرٌ نَتَرَبَّصُ بِهِ رَيْبَ الْمَنُونِ"},"context":"بعد حكاية قول أهل الجنة: إنا كنا من قبل ندعوه إنه هو البر الرحيم.","reason":"النبي ﷺ بنعمة ربه بريء من الكهانة والجنون، فليمضِ في التذكير."},{"i":177,"of":224,"s":52,"surah":"الطور","a":37,"text":"أَمْ عِنْدَهُمْ خَزَائِنُ رَبِّكَ أَمْ هُمُ الْمُصَيْطِرُونَ","prev":{"a":36,"text":"أَمْ خَلَقُوا السَّمَاوَاتِ وَالْأَرْضَ بَلْ لَا يُوقِنُونَ"},"next":{"a":38,"text":"أَمْ لَهُمْ سُلَّمٌ يَسْتَمِعُونَ فِيهِ فَلْيَأْتِ مُسْتَمِعُهُمْ بِسُلْطَانٍ مُبِينٍ"},"context":"سلسلة استفهامات إنكارية على المشركين، منها: أم خلقوا السماوات والأرض؟","reason":"الخزائن لربك وحده، فليس لهم التحكم فيمن يُعطى."},{"i":178,"of":224,"s":52,"surah":"الطور","a":48,"text":"وَاصْبِرْ لِحُكْمِ رَبِّكَ فَإِنَّكَ بِأَعْيُنِنَا وَسَبِّحْ بِحَمْدِ رَبِّكَ حِينَ تَقُومُ","prev":{"a":47,"text":"وَإِنَّ لِلَّذِينَ ظَلَمُوا عَذَابًا دُونَ ذَلِكَ وَلَكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ"},"next":{"a":49,"text":"وَمِنَ اللَّيْلِ فَسَبِّحْهُ وَإِدْبَارَ النُّجُومِ"},"context":"بعد بيان أن للذين ظلموا عذابًا دون ذلك.","reason":"الصبر لحكم ربك يصحبه حفظه ورعايته."},{"i":179,"of":224,"s":53,"surah":"النجم","a":30,"text":"ذَلِكَ مَبْلَغُهُمْ مِنَ الْعِلْمِ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَنْ ضَلَّ عَنْ سَبِيلِهِ وَهُوَ أَعْلَمُ بِمَنِ اهْتَدَى","prev":{"a":29,"text":"فَأَعْرِضْ عَنْ مَنْ تَوَلَّى عَنْ ذِكْرِنَا وَلَمْ يُرِدْ إِلَّا الْحَيَاةَ الدُّنْيَا"},"next":{"a":31,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ لِيَجْزِيَ الَّذِينَ أَسَاءُوا بِمَا عَمِلُوا وَيَجْزِيَ الَّذِينَ أَحْسَنُوا بِالْحُسْنَى"},"context":"الأمر بالإعراض عمن تولّى عن الذكر ولم يرد إلا الدنيا.","reason":"ربك أعلم بالضال والمهتدي، فلا يحزنك إعراضهم."},{"i":180,"of":224,"s":53,"surah":"النجم","a":32,"text":"الَّذِينَ يَجْتَنِبُونَ كَبَائِرَ الْإِثْمِ وَالْفَوَاحِشَ إِلَّا اللَّمَمَ إِنَّ رَبَّكَ وَاسِعُ الْمَغْفِرَةِ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنْشَأَكُمْ مِنَ الْأَرْضِ وَإِذْ أَنْتُمْ أَجِنَّةٌ فِي بُطُونِ أُمَّهَاتِكُمْ فَلَا تُزَكُّوا أَنْفُسَكُمْ هُوَ أَعْلَمُ بِمَنِ اتَّقَى","prev":{"a":31,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ لِيَجْزِيَ الَّذِينَ أَسَاءُوا بِمَا عَمِلُوا وَيَجْزِيَ الَّذِينَ أَحْسَنُوا بِالْحُسْنَى"},"next":{"a":33,"text":"أَفَرَأَيْتَ الَّذِي تَوَلَّى"},"context":"ذكر جزاء المحسنين بالحسنى.","reason":"سعة مغفرة ربك للمّم، مع النهي عن تزكية النفس."},{"i":181,"of":224,"s":53,"surah":"النجم","a":42,"text":"وَأَنَّ إِلَى رَبِّكَ الْمُنْتَهَى","prev":{"a":41,"text":"ثُمَّ يُجْزَاهُ الْجَزَاءَ الْأَوْفَى"},"next":{"a":43,"text":"وَأَنَّهُ هُوَ أَضْحَكَ وَأَبْكَى"},"context":"بعد بيان أن الساعي يُجزى سعيه الجزاء الأوفى.","reason":"منتهى كل شيء إلى ربك، فإليه المصير."},{"i":182,"of":224,"s":53,"surah":"النجم","a":55,"text":"فَبِأَيِّ آلَاءِ رَبِّكَ تَتَمَارَى","prev":{"a":54,"text":"فَغَشَّاهَا مَا غَشَّى"},"next":{"a":56,"text":"هَذَا نَذِيرٌ مِنَ النُّذُرِ الْأُولَى"},"context":"بعد ذكر ما غشّى الله به المهلكين.","reason":"إنكار التشكك في نعم ربك بعد ظهورها."},{"i":183,"of":224,"s":55,"surah":"الرحمن","a":27,"text":"وَيَبْقَى وَجْهُ رَبِّكَ ذُو الْجَلَالِ وَالْإِكْرَامِ","prev":{"a":26,"text":"كُلُّ مَنْ عَلَيْهَا فَانٍ"},"next":{"a":28,"text":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},"context":"كل من على الأرض فانٍ.","reason":"يبقى وجه ربك ذو الجلال والإكرام وحده."},{"i":184,"of":224,"s":55,"surah":"الرحمن","a":78,"text":"تَبَارَكَ اسْمُ رَبِّكَ ذِي الْجَلَالِ وَالْإِكْرَامِ","prev":{"a":77,"text":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ"},"context":"ختام سورة الرحمن بعد تكرار السؤال عن آلاء الرب.","reason":"تعظيم اسم ربك الذي أنعم بكل ما ذُكر."},{"i":185,"of":224,"s":56,"surah":"الواقعة","a":74,"text":"فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيمِ","prev":{"a":73,"text":"نَحْنُ جَعَلْنَاهَا تَذْكِرَةً وَمَتَاعًا لِلْمُقْوِينَ"},"next":{"a":75,"text":"فَلَا أُقْسِمُ بِمَوَاقِعِ النُّجُومِ"},"context":"بعد ذكر آيات النار التي يوقدونها وجعلها تذكرة ومتاعًا.","reason":"التأمل في النعم يقود إلى تسبيح اسم ربك العظيم."},{"i":186,"of":224,"s":56,"surah":"الواقعة","a":96,"text":"فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيمِ","prev":{"a":95,"text":"إِنَّ هَذَا لَهُوَ حَقُّ الْيَقِينِ"},"context":"ختام الواقعة بعد تقرير أن هذا لهو حق اليقين.","reason":"تسبيح ربك العظيم ختام اليقين بالحق."},{"i":187,"of":224,"s":68,"surah":"القلم","a":2,"text":"مَا أَنْتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍ","prev":{"a":1,"text":"ن وَالْقَلَمِ وَمَا يَسْطُرُونَ"},"next":{"a":3,"text":"وَإِنَّ لَكَ لَأَجْرًا غَيْرَ مَمْنُونٍ"},"context":"قسمٌ بالقلم وما يسطرون.","reason":"نفي الجنون عن النبي ﷺ بنعمة ربه عليه."},{"i":188,"of":224,"s":68,"surah":"القلم","a":7,"text":"إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَنْ ضَلَّ عَنْ سَبِيلِهِ وَهُوَ أَعْلَمُ بِالْمُهْتَدِينَ","prev":{"a":6,"text":"بِأَيِّكُمُ الْمَفْتُونُ"},"next":{"a":8,"text":"فَلَا تُطِعِ الْمُكَذِّبِينَ"},"context":"وعيد بأن يتبين أيّهم المفتون.","reason":"ربك أعلم بالضال والمهتدي، فالحكم له لا للناس."},{"i":189,"of":224,"s":68,"surah":"القلم","a":19,"text":"فَطَافَ عَلَيْهَا طَائِفٌ مِنْ رَبِّكَ وَهُمْ نَائِمُونَ","prev":{"a":18,"text":"وَلَا يَسْتَثْنُونَ"},"next":{"a":20,"text":"فَأَصْبَحَتْ كَالصَّرِيمِ"},"context":"أصحاب الجنة أقسموا ليصرمنها مصبحين ولا يستثنون.","reason":"فطاف على جنتهم طائفٌ من ربك ليلًا وهم نائمون، فأصبحت كالصريم."},{"i":190,"of":224,"s":68,"surah":"القلم","a":48,"text":"فَاصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُنْ كَصَاحِبِ الْحُوتِ إِذْ نَادَى وَهُوَ مَكْظُومٌ","prev":{"a":47,"text":"أَمْ عِنْدَهُمُ الْغَيْبُ فَهُمْ يَكْتُبُونَ"},"next":{"a":49,"text":"لَوْلَا أَنْ تَدَارَكَهُ نِعْمَةٌ مِنْ رَبِّهِ لَنُبِذَ بِالْعَرَاءِ وَهُوَ مَذْمُومٌ"},"context":"بعد السؤال الإنكاري: أم عندهم الغيب فهم يكتبون؟","reason":"الصبر لحكم ربك، وألا يكون كصاحب الحوت إذ نادى وهو مكظوم."},{"i":191,"of":224,"s":69,"surah":"الحاقة","a":17,"text":"وَالْمَلَكُ عَلَى أَرْجَائِهَا وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍ ثَمَانِيَةٌ","prev":{"a":16,"text":"وَانْشَقَّتِ السَّمَاءُ فَهِيَ يَوْمَئِذٍ وَاهِيَةٌ"},"next":{"a":18,"text":"يَوْمَئِذٍ تُعْرَضُونَ لَا تَخْفَى مِنْكُمْ خَافِيَةٌ"},"context":"وصف انشقاق السماء يوم القيامة.","reason":"عرش ربك يحمله ثمانية يومئذ، تعظيمًا لموقف الجزاء."},{"i":192,"of":224,"s":69,"surah":"الحاقة","a":52,"text":"فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيمِ","prev":{"a":51,"text":"وَإِنَّهُ لَحَقُّ الْيَقِينِ"},"context":"ختام الحاقة بأن القرآن حق اليقين.","reason":"تسبيح اسم ربك العظيم إقرار بصدق الوحي."},{"i":193,"of":224,"s":73,"surah":"المزمل","a":8,"text":"وَاذْكُرِ اسْمَ رَبِّكَ وَتَبَتَّلْ إِلَيْهِ تَبْتِيلًا","prev":{"a":7,"text":"إِنَّ لَكَ فِي النَّهَارِ سَبْحًا طَوِيلًا"},"next":{"a":9,"text":"رَبُّ الْمَشْرِقِ وَالْمَغْرِبِ لَا إِلَهَ إِلَّا هُوَ فَاتَّخِذْهُ وَكِيلًا"},"context":"بعد بيان أن للنبي ﷺ في النهار سبحًا طويلًا.","reason":"ذكر اسم ربك والانقطاع إليه زاد القائم."},{"i":194,"of":224,"s":73,"surah":"المزمل","a":20,"text":"إِنَّ رَبَّكَ يَعْلَمُ أَنَّكَ تَقُومُ أَدْنَى مِنْ ثُلُثَيِ اللَّيْلِ وَنِصْفَهُ وَثُلُثَهُ وَطَائِفَةٌ مِنَ الَّذِينَ مَعَكَ وَاللَّهُ يُقَدِّرُ اللَّيْلَ وَالنَّهَارَ عَلِمَ أَنْ لَنْ تُحْصُوهُ فَتَابَ عَلَيْكُمْ فَاقْرَءُوا مَا تَيَسَّرَ مِنَ الْقُرْآنِ عَلِمَ أَنْ سَيَكُونُ مِنْكُمْ مَرْضَى وَآخَرُونَ يَضْرِبُونَ فِي الْأَرْضِ يَبْتَغُونَ مِنْ فَضْلِ اللَّهِ وَآخَرُونَ يُقَاتِلُونَ فِي سَبِيلِ اللَّهِ فَاقْرَءُوا مَا تَيَسَّرَ مِنْهُ وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ وَأَقْرِضُوا اللَّهَ قَرْضًا حَسَنًا وَمَا تُقَدِّمُوا لِأَنْفُسِكُمْ مِنْ خَيْرٍ تَجِدُوهُ عِنْدَ اللَّهِ هُوَ خَيْرًا وَأَعْظَمَ أَجْرًا وَاسْتَغْفِرُوا اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":19,"text":"إِنَّ هَذِهِ تَذْكِرَةٌ فَمَنْ شَاءَ اتَّخَذَ إِلَى رَبِّهِ سَبِيلًا"},"context":"بعد قوله: إن هذه تذكرة فمن شاء اتخذ إلى ربه سبيلًا.","reason":"ربك يعلم قيامك وعجزك فخفّف عنك."},{"i":195,"of":224,"s":74,"surah":"المدثر","a":3,"text":"وَرَبَّكَ فَكَبِّرْ","prev":{"a":2,"text":"قُمْ فَأَنْذِرْ"},"next":{"a":4,"text":"وَثِيَابَكَ فَطَهِّرْ"},"context":"أمر النبي ﷺ بالقيام والإنذار.","reason":"تكبير ربك أول ما يحمله الداعي."},{"i":196,"of":224,"s":74,"surah":"المدثر","a":7,"text":"وَلِرَبِّكَ فَاصْبِرْ","prev":{"a":6,"text":"وَلَا تَمْنُنْ تَسْتَكْثِرُ"},"next":{"a":8,"text":"فَإِذَا نُقِرَ فِي النَّاقُورِ"},"context":"بعد النهي عن المنّ استكثارًا.","reason":"الصبر لأجل ربك وحده على تكاليف الدعوة."},{"i":197,"of":224,"s":74,"surah":"المدثر","a":31,"text":"وَمَا جَعَلْنَا أَصْحَابَ النَّارِ إِلَّا مَلَائِكَةً وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةً لِلَّذِينَ كَفَرُوا لِيَسْتَيْقِنَ الَّذِينَ أُوتُوا الْكِتَابَ وَيَزْدَادَ الَّذِينَ آمَنُوا إِيمَانًا وَلَا يَرْتَابَ الَّذِينَ أُوتُوا الْكِتَابَ وَالْمُؤْمِنُونَ وَلِيَقُولَ الَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ وَالْكَافِرُونَ مَاذَا أَرَادَ اللَّهُ بِهَذَا مَثَلًا كَذَلِكَ يُضِلُّ اللَّهُ مَنْ يَشَاءُ وَيَهْدِي مَنْ يَشَاءُ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ وَمَا هِيَ إِلَّا ذِكْرَى لِلْبَشَرِ","prev":{"a":30,"text":"عَلَيْهَا تِسْعَةَ عَشَرَ"},"next":{"a":32,"text":"كَلَّا وَالْقَمَرِ"},"context":"بعد ذكر أن على سقر تسعة عشر.","reason":"جنود ربك لا يعلمها إلا هو، فلا يُستقل عددها."},{"i":198,"of":224,"s":75,"surah":"القيامة","a":12,"text":"إِلَى رَبِّكَ يَوْمَئِذٍ الْمُسْتَقَرُّ","prev":{"a":11,"text":"كَلَّا لَا وَزَرَ"},"next":{"a":13,"text":"يُنَبَّأُ الْإِنْسَانُ يَوْمَئِذٍ بِمَا قَدَّمَ وَأَخَّرَ"},"context":"بعد نفي أن يكون ثمة ملجأ: كلا لا وزر.","reason":"لا ملجأ إلا إلى ربك، فإليه المستقر."},{"i":199,"of":224,"s":75,"surah":"القيامة","a":30,"text":"إِلَى رَبِّكَ يَوْمَئِذٍ الْمَسَاقُ","prev":{"a":29,"text":"وَالْتَفَّتِ السَّاقُ بِالسَّاقِ"},"next":{"a":31,"text":"فَلَا صَدَّقَ وَلَا صَلَّى"},"context":"وصف التفاف الساق بالساق عند الموت.","reason":"المساق عند الموت إلى ربك."},{"i":200,"of":224,"s":76,"surah":"الإنسان","a":24,"text":"فَاصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تُطِعْ مِنْهُمْ آثِمًا أَوْ كَفُورًا","prev":{"a":23,"text":"إِنَّا نَحْنُ نَزَّلْنَا عَلَيْكَ الْقُرْآنَ تَنْزِيلًا"},"next":{"a":25,"text":"وَاذْكُرِ اسْمَ رَبِّكَ بُكْرَةً وَأَصِيلًا"},"context":"تذكير بتنزيل القرآن على النبي ﷺ تنزيلًا.","reason":"الصبر لحكم ربك مع ترك طاعة الآثم والكفور."},{"i":201,"of":224,"s":76,"surah":"الإنسان","a":25,"text":"وَاذْكُرِ اسْمَ رَبِّكَ بُكْرَةً وَأَصِيلًا","prev":{"a":24,"text":"فَاصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تُطِعْ مِنْهُمْ آثِمًا أَوْ كَفُورًا"},"next":{"a":26,"text":"وَمِنَ اللَّيْلِ فَاسْجُدْ لَهُ وَسَبِّحْهُ لَيْلًا طَوِيلًا"},"context":"بعد الأمر بالصبر وترك طاعة الآثمين.","reason":"ذكر اسم ربك أول النهار وآخره عون على الثبات."},{"i":202,"of":224,"s":78,"surah":"النبأ","a":36,"text":"جَزَاءً مِنْ رَبِّكَ عَطَاءً حِسَابًا","prev":{"a":35,"text":"لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّابًا"},"next":{"a":37,"text":"رَبِّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا الرَّحْمَنِ لَا يَمْلِكُونَ مِنْهُ خِطَابًا"},"context":"بعد وصف الجنة بأنهم لا يسمعون فيها لغوًا ولا كذابًا.","reason":"النعيم جزاء وعطاء من ربك، كافٍ وافٍ."},{"i":203,"of":224,"s":79,"surah":"النازعات","a":19,"text":"وَأَهْدِيَكَ إِلَى رَبِّكَ فَتَخْشَى","prev":{"a":18,"text":"فَقُلْ هَلْ لَكَ إِلَى أَنْ تَزَكَّى"},"next":{"a":20,"text":"فَأَرَاهُ الْآيَةَ الْكُبْرَى"},"context":"موسى يُبعث إلى فرعون ليقول له هل لك إلى أن تزكى.","reason":"الهداية إلى «ربك» تخاطب فرعون بربوبية الله عليه لتثمر الخشية."},{"i":204,"of":224,"s":79,"surah":"النازعات","a":44,"text":"إِلَى رَبِّكَ مُنْتَهَاهَا","prev":{"a":43,"text":"فِيمَ أَنْتَ مِنْ ذِكْرَاهَا"},"next":{"a":45,"text":"إِنَّمَا أَنْتَ مُنْذِرُ مَنْ يَخْشَاهَا"},"context":"بعد السؤال: فيم أنت من ذكر الساعة؟","reason":"علم الساعة منتهاه إلى ربك وحده."},{"i":205,"of":224,"s":82,"surah":"الانفطار","a":6,"text":"يَا أَيُّهَا الْإِنْسَانُ مَا غَرَّكَ بِرَبِّكَ الْكَرِيمِ","prev":{"a":5,"text":"عَلِمَتْ نَفْسٌ مَا قَدَّمَتْ وَأَخَّرَتْ"},"next":{"a":7,"text":"الَّذِي خَلَقَكَ فَسَوَّاكَ فَعَدَلَكَ"},"context":"بعد بيان أن كل نفس تعلم يومئذ ما قدّمت وأخّرت.","reason":"عتابٌ للإنسان المغتر بكرم ربه فيعصيه."},{"i":206,"of":224,"s":84,"surah":"الانشقاق","a":6,"text":"يَا أَيُّهَا الْإِنْسَانُ إِنَّكَ كَادِحٌ إِلَى رَبِّكَ كَدْحًا فَمُلَاقِيهِ","prev":{"a":5,"text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},"next":{"a":7,"text":"فَأَمَّا مَنْ أُوتِيَ كِتَابَهُ بِيَمِينِهِ"},"context":"بعد وصف انقياد السماء لربها يوم القيامة.","reason":"كل سعي الإنسان كدحٌ ينتهي بلقاء ربه."},{"i":207,"of":224,"s":85,"surah":"البروج","a":12,"text":"إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ","prev":{"a":11,"text":"إِنَّ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ جَنَّاتٌ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ ذَلِكَ الْفَوْزُ الْكَبِيرُ"},"next":{"a":13,"text":"إِنَّهُ هُوَ يُبْدِئُ وَيُعِيدُ"},"context":"بعد بشارة المؤمنين العاملين بجنات تجري من تحتها الأنهار.","reason":"بطش ربك شديد، وهو الذي يبدئ ويعيد."},{"i":208,"of":224,"s":87,"surah":"الأعلى","a":1,"text":"سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى","next":{"a":2,"text":"الَّذِي خَلَقَ فَسَوَّى"},"context":"افتتاح سورة الأعلى.","reason":"تنزيه اسم ربك الأعلى عن كل نقص."},{"i":209,"of":224,"s":89,"surah":"الفجر","a":6,"text":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ","prev":{"a":5,"text":"هَلْ فِي ذَلِكَ قَسَمٌ لِذِي حِجْرٍ"},"next":{"a":7,"text":"إِرَمَ ذَاتِ الْعِمَادِ"},"context":"بعد أقسامٍ يُسأل: هل في ذلك قسم لذي حجر؟","reason":"ما فعله ربك بعاد عبرة لكل متجبر."},{"i":210,"of":224,"s":89,"surah":"الفجر","a":13,"text":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ","prev":{"a":12,"text":"فَأَكْثَرُوا فِيهَا الْفَسَادَ"},"next":{"a":14,"text":"إِنَّ رَبَّكَ لَبِالْمِرْصَادِ"},"context":"بعد ذكر أقوامٍ أكثروا في البلاد الفساد.","reason":"ربك صبّ عليهم العذاب جزاء طغيانهم."},{"i":211,"of":224,"s":89,"surah":"الفجر","a":14,"text":"إِنَّ رَبَّكَ لَبِالْمِرْصَادِ","prev":{"a":13,"text":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ"},"next":{"a":15,"text":"فَأَمَّا الْإِنْسَانُ إِذَا مَا ابْتَلَاهُ رَبُّهُ فَأَكْرَمَهُ وَنَعَّمَهُ فَيَقُولُ رَبِّي أَكْرَمَنِ"},"context":"بعد ذكر عذاب الطغاة.","reason":"ربك يرصد أعمال العباد لا يفوته شيء."},{"i":212,"of":224,"s":89,"surah":"الفجر","a":22,"text":"وَجَاءَ رَبُّكَ وَالْمَلَكُ صَفًّا صَفًّا","prev":{"a":21,"text":"كَلَّا إِذَا دُكَّتِ الْأَرْضُ دَكًّا دَكًّا"},"next":{"a":23,"text":"وَجِيءَ يَوْمَئِذٍ بِجَهَنَّمَ يَوْمَئِذٍ يَتَذَكَّرُ الْإِنْسَانُ وَأَنَّى لَهُ الذِّكْرَى"},"context":"دكّ الأرض يوم القيامة دكًّا دكًّا.","reason":"مجيء ربك والملائكة صفوفًا لفصل القضاء."},{"i":213,"of":224,"s":89,"surah":"الفجر","a":28,"text":"ارْجِعِي إِلَى رَبِّكِ رَاضِيَةً مَرْضِيَّةً","prev":{"a":27,"text":"يَا أَيَّتُهَا النَّفْسُ الْمُطْمَئِنَّةُ"},"next":{"a":29,"text":"فَادْخُلِي فِي عِبَادِي"},"context":"نداء النفس المطمئنة.","reason":"رجوعها إلى ربها راضية مرضية تكريم لها."},{"i":214,"of":224,"s":93,"surah":"الضحى","a":3,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَى","prev":{"a":2,"text":"وَاللَّيْلِ إِذَا سَجَى"},"next":{"a":4,"text":"وَلَلْآخِرَةُ خَيْرٌ لَكَ مِنَ الْأُولَى"},"context":"قسمٌ بالضحى والليل إذا سجى.","reason":"ربك ما تركك وما أبغضك، والآخرة خير لك من الأولى."},{"i":215,"of":224,"s":93,"surah":"الضحى","a":5,"text":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَى","prev":{"a":4,"text":"وَلَلْآخِرَةُ خَيْرٌ لَكَ مِنَ الْأُولَى"},"next":{"a":6,"text":"أَلَمْ يَجِدْكَ يَتِيمًا فَآوَى"},"context":"وعد بأن الآخرة خير من الأولى.","reason":"عطاء ربك سيأتي حتى ترضى."},{"i":216,"of":224,"s":93,"surah":"الضحى","a":11,"text":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","prev":{"a":10,"text":"وَأَمَّا السَّائِلَ فَلَا تَنْهَرْ"},"context":"بعد النهي عن نهر السائل.","reason":"التحديث بنعمة ربك شكرٌ لها."},{"i":217,"of":224,"s":94,"surah":"الشرح","a":8,"text":"وَإِلَى رَبِّكَ فَارْغَبْ","prev":{"a":7,"text":"فَإِذَا فَرَغْتَ فَانْصَبْ"},"context":"بعد الأمر بالنصب إذا فرغ.","reason":"اجعل رغبتك إلى ربك وحده."},{"i":218,"of":224,"s":96,"surah":"العلق","a":1,"text":"اقْرَأْ بِاسْمِ رَبِّكَ الَّذِي خَلَقَ","next":{"a":2,"text":"خَلَقَ الْإِنْسَانَ مِنْ عَلَقٍ"},"context":"أول ما نزل من القرآن.","reason":"القراءة باسم ربك الخالق تجعل العلم عبادة."},{"i":219,"of":224,"s":96,"surah":"العلق","a":3,"text":"اقْرَأْ وَرَبُّكَ الْأَكْرَمُ","prev":{"a":2,"text":"خَلَقَ الْإِنْسَانَ مِنْ عَلَقٍ"},"next":{"a":4,"text":"الَّذِي عَلَّمَ بِالْقَلَمِ"},"context":"بعد ذكر خلق الإنسان من علق.","reason":"ربك الأكرم يعلّم الإنسان ما لم يعلم."},{"i":220,"of":224,"s":96,"surah":"العلق","a":8,"text":"إِنَّ إِلَى رَبِّكَ الرُّجْعَى","prev":{"a":7,"text":"أَنْ رَآهُ اسْتَغْنَى"},"next":{"a":9,"text":"أَرَأَيْتَ الَّذِي يَنْهَى"},"context":"الإنسان يطغى أن رآه استغنى.","reason":"مرجع الطاغي المستغني إلى ربك."},{"i":221,"of":224,"s":99,"surah":"الزلزلة","a":5,"text":"بِأَنَّ رَبَّكَ أَوْحَى لَهَا","prev":{"a":4,"text":"يَوْمَئِذٍ تُحَدِّثُ أَخْبَارَهَا"},"next":{"a":6,"text":"يَوْمَئِذٍ يَصْدُرُ النَّاسُ أَشْتَاتًا لِيُرَوْا أَعْمَالَهُمْ"},"context":"الأرض تحدث أخبارها يوم الزلزلة.","reason":"تحديثها بأمر ربك الذي أوحى لها."},{"i":222,"of":224,"s":105,"surah":"الفيل","a":1,"text":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَابِ الْفِيلِ","next":{"a":2,"text":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِي تَضْلِيلٍ"},"context":"افتتاح سورة الفيل.","reason":"ربك جعل كيد أصحاب الفيل في تضليل."},{"i":223,"of":224,"s":108,"surah":"الكوثر","a":2,"text":"فَصَلِّ لِرَبِّكَ وَانْحَرْ","prev":{"a":1,"text":"إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ"},"next":{"a":3,"text":"إِنَّ شَانِئَكَ هُوَ الْأَبْتَرُ"},"context":"بعد الامتنان بإعطاء الكوثر.","reason":"الشكر على العطاء صلاة ونحر لربك وحده."},{"i":224,"of":224,"s":110,"surah":"النصر","a":3,"text":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُ إِنَّهُ كَانَ تَوَّابًا","prev":{"a":2,"text":"وَرَأَيْتَ النَّاسَ يَدْخُلُونَ فِي دِينِ اللَّهِ أَفْوَاجًا"},"context":"مجيء نصر الله والفتح ودخول الناس في الدين أفواجًا.","reason":"عند تمام النصر يُشرع التسبيح بحمد ربك والاستغفار."}],"hadiths":[],"situations":[{"situationId":1,"verses":[{"i":52,"strength":"direct","bridge":"إذا ضاقت بك الحيلة أمام المعتدين فتذكّر: ﴿إِنَّا رُسُلُ رَبِّكَ لَنْ يَصِلُوا إِلَيْكَ﴾."},{"i":129,"strength":"direct","bridge":"إذا ضاقت بك المخارج كما ضاقت على موسى عند البحر فثق بربك؛ ﴿وَإِنَّ رَبَّكَ لَهُوَ الْعَزِيزُ الرَّحِيمُ﴾."}],"hadiths":[]},{"situationId":2,"verses":[{"i":72,"strength":"direct","bridge":"إذا ضاق صدرك بكلام الناس فالجأ إلى: ﴿فَسَبِّحْ بِحَمْدِ رَبِّكَ وَكُنْ مِنَ السَّاجِدِينَ﴾."},{"i":107,"strength":"direct","bridge":"إذا اشتدّ حزنك فاسمع النداء: ﴿أَلَّا تَحْزَنِي قَدْ جَعَلَ رَبُّكِ تَحْتَكِ سَرِيًّا﴾."}],"hadiths":[]},{"situationId":4,"verses":[{"i":183,"strength":"direct","bridge":"إذا فقدت عزيزًا وأوجعك الفناء فتعلّق بالباقي؛ ﴿وَيَبْقَى وَجْهُ رَبِّكَ ذُو الْجَلَالِ وَالْإِكْرَامِ﴾."}],"hadiths":[]},{"situationId":5,"verses":[{"i":76,"strength":"direct","bridge":"إذا مرضت فتذكّر أن ربك جعل في خلقه دواء: ﴿فِيهِ شِفَاءٌ لِلنَّاسِ﴾."}],"hadiths":[]},{"situationId":6,"verses":[{"i":178,"strength":"direct","bridge":"إذا ضاق صدرك بحكم الله عليك فأنت في رعايته؛ ﴿وَاصْبِرْ لِحُكْمِ رَبِّكَ فَإِنَّكَ بِأَعْيُنِنَا﴾."},{"i":214,"strength":"direct","bridge":"إذا شعرت أنك متروك فاسمع هذا الطمأنة؛ ﴿مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَى﴾."}],"hadiths":[]},{"situationId":8,"verses":[{"i":1,"strength":"direct","bridge":"حين يخفى عليك وجه الحكمة في تدبيرٍ ما، فتذكّر قول ربك: ﴿إِنِّي أَعْلَمُ مَا لَا تَعْلَمُونَ﴾."},{"i":39,"strength":"direct","bridge":"إذا كرهت أمرًا ساقك الله إليه فتذكّر: ﴿كَمَا أَخْرَجَكَ رَبُّكَ مِنْ بَيْتِكَ بِالْحَقِّ﴾."},{"i":51,"strength":"direct","bridge":"إذا شفقت على من حقّ عليه العذاب فسلّم: ﴿إِنَّهُ قَدْ جَاءَ أَمْرُ رَبِّكَ﴾."},{"i":106,"strength":"direct","bridge":"إذا واجهت قدرًا يفوق إدراكك فسلّم: ﴿وَكَانَ أَمْرًا مَقْضِيًّا﴾."},{"i":143,"strength":"direct","bridge":"إذا اخترت شيئًا فجاءك غيره فسلّم لاختيار ربك؛ ﴿وَرَبُّكَ يَخْلُقُ مَا يَشَاءُ وَيَخْتَارُ﴾."}],"hadiths":[]},{"situationId":9,"verses":[{"i":104,"strength":"direct","bridge":"إذا استبعدت الفرج لضعف الأسباب فتذكّر: ﴿قَالَ رَبُّكَ هُوَ عَلَيَّ هَيِّنٌ﴾."},{"i":108,"strength":"direct","bridge":"إذا شعرت أن الله نسيك فاطمئن: ﴿وَمَا كَانَ رَبُّكَ نَسِيًّا﴾."},{"i":118,"strength":"direct","bridge":"إن طال عليك انتظار وعد الله فقِس الزمن بميزان ربك؛ ﴿وَإِنَّ يَوْمًا عِنْدَ رَبِّكَ كَأَلْفِ سَنَةٍ مِمَّا تَعُدُّونَ﴾."},{"i":190,"strength":"direct","bridge":"إذا ضقت بالانتظار وكدت تستعجل فاصبر؛ ﴿فَاصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُنْ كَصَاحِبِ الْحُوتِ﴾."}],"hadiths":[]},{"situationId":10,"verses":[{"i":215,"strength":"direct","bridge":"إذا طال انتظارك فربك يعدك بما يرضيك؛ ﴿وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَى﴾."}],"hadiths":[]},{"situationId":11,"verses":[{"i":102,"strength":"direct","bridge":"إذا خفت على أولادك بعدك فأصلح نفسك: ﴿وَكَانَ أَبُوهُمَا صَالِحًا فَأَرَادَ رَبُّكَ أَنْ يَبْلُغَا أَشُدَّهُمَا﴾."}],"hadiths":[]},{"situationId":13,"verses":[{"i":105,"strength":"direct","bridge":"إذا فاجأك أمرٌ مخيف فاعلم أنه قد يحمل بشرى: ﴿إِنَّمَا أَنَا رَسُولُ رَبِّكِ لِأَهَبَ لَكِ غُلَامًا زَكِيًّا﴾."},{"i":140,"strength":"direct","bridge":"إذا أصابك الرهب قبل مهمة عظيمة فاضمم إليك جناحك وثق بربك؛ ﴿وَاضْمُمْ إِلَيْكَ جَنَاحَكَ مِنَ الرَّهْبِ فَذَانِكَ بُرْهَانَانِ مِنْ رَبِّكَ﴾."}],"hadiths":[]},{"situationId":14,"verses":[{"i":5,"strength":"direct","bridge":"إذا تردّدت كثيرًا فعلّق أمرك بالله لتُهدى: ﴿وَإِنَّا إِنْ شَاءَ اللَّهُ لَمُهْتَدُونَ﴾."}],"hadiths":[]},{"situationId":15,"verses":[{"i":180,"strength":"direct","bridge":"إذا زللت في صغيرة فلا تيأس، ولا تزكّ نفسك؛ ﴿إِنَّ رَبَّكَ وَاسِعُ الْمَغْفِرَةِ﴾."}],"hadiths":[]},{"situationId":17,"verses":[{"i":34,"strength":"direct","bridge":"إذا ثقل عليك ماضيك فاعلم: ﴿إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ﴾."}],"hadiths":[]},{"situationId":18,"verses":[{"i":82,"strength":"direct","bridge":"إذا ظننت أن ذنبك منسيّ فاعلم: ﴿وَكَفَى بِرَبِّكَ بِذُنُوبِ عِبَادِهِ خَبِيرًا بَصِيرًا﴾."}],"hadiths":[]},{"situationId":20,"verses":[{"i":30,"strength":"direct","bridge":"إذا سوّفت إيمانك وعملك فاحذر يومًا ﴿لَا يَنْفَعُ نَفْسًا إِيمَانُهَا لَمْ تَكُنْ آمَنَتْ مِنْ قَبْلُ﴾."},{"i":74,"strength":"direct","bridge":"إذا أجّلت الرجوع إلى الله فاعلم أنه قد ﴿يَأْتِيَ أَمْرُ رَبِّكَ﴾."}],"hadiths":[]},{"situationId":21,"verses":[{"i":28,"strength":"direct","bridge":"إذا اغتررت بأنك لا تُستبدل فتذكّر: ﴿وَرَبُّكَ الْغَنِيُّ ذُو الرَّحْمَةِ إِنْ يَشَأْ يُذْهِبْكُمْ﴾."},{"i":117,"strength":"direct","bridge":"لا تغترّ بإمهال الله لك، فأدنى عقوبة توقظ الغافل؛ ﴿وَلَئِنْ مَسَّتْهُمْ نَفْحَةٌ مِنْ عَذَابِ رَبِّكَ لَيَقُولُنَّ يَا وَيْلَنَا إِنَّا كُنَّا ظَالِمِينَ﴾."},{"i":174,"strength":"direct","bridge":"إذا أسرفت على نفسك فاعلم أن العقوبة محسوبة عند ربك؛ ﴿مُسَوَّمَةً عِنْدَ رَبِّكَ لِلْمُسْرِفِينَ﴾."},{"i":205,"strength":"direct","bridge":"إذا اغتررت بستر الله وكرمه فقف مع هذا العتاب؛ ﴿يَا أَيُّهَا الْإِنْسَانُ مَا غَرَّكَ بِرَبِّكَ الْكَرِيمِ﴾."}],"hadiths":[]},{"situationId":22,"verses":[{"i":31,"strength":"direct","bridge":"إذا رأيت تفاوت الأرزاق والمراتب فاعلم أنه ابتلاء: ﴿إِنَّ رَبَّكَ سَرِيعُ الْعِقَابِ وَإِنَّهُ لَغَفُورٌ رَحِيمٌ﴾."},{"i":35,"strength":"direct","bridge":"إذا أمنت مكر الله بعد معصية فتذكّر: ﴿إِنَّ رَبَّكَ لَسَرِيعُ الْعِقَابِ وَإِنَّهُ لَغَفُورٌ رَحِيمٌ﴾."},{"i":66,"strength":"direct","bridge":"إذا أذنبت فلا تيأس ولا تأمن: ﴿وَإِنَّ رَبَّكَ لَذُو مَغْفِرَةٍ لِلنَّاسِ عَلَى ظُلْمِهِمْ﴾."}],"hadiths":[]},{"situationId":24,"verses":[{"i":79,"strength":"direct","bridge":"إذا وقعت في الذنب بجهالة فبادر: ﴿ثُمَّ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا﴾."}],"hadiths":[]},{"situationId":28,"verses":[{"i":211,"strength":"direct","bridge":"إذا ظُلمت ولا ناصر لك فربك بالمرصاد؛ ﴿إِنَّ رَبَّكَ لَبِالْمِرْصَادِ﴾."}],"hadiths":[]},{"situationId":29,"verses":[{"i":176,"strength":"direct","bridge":"إذا رموك بالباطل لدعوتك فامضِ في التذكير؛ ﴿فَذَكِّرْ فَمَا أَنْتَ بِنِعْمَتِ رَبِّكَ بِكَاهِنٍ وَلَا مَجْنُونٍ﴾."},{"i":187,"strength":"direct","bridge":"إذا رُميت بالسفه لتمسكك بالحق فنعمة ربك عليك تكذّبهم؛ ﴿مَا أَنْتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍ﴾."}],"hadiths":[]},{"situationId":30,"verses":[{"i":19,"strength":"direct","bridge":"إذا أحاط بك المزخرِفون للباطل فاطمئن: ﴿وَلَوْ شَاءَ رَبُّكَ مَا فَعَلُوهُ فَذَرْهُمْ وَمَا يَفْتَرُونَ﴾."},{"i":222,"strength":"direct","bridge":"إذا تكالب الأقوياء على الحق فتذكر أصحاب الفيل؛ ﴿أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَابِ الْفِيلِ﴾."}],"hadiths":[]},{"situationId":31,"verses":[{"i":40,"strength":"direct","bridge":"إذا قلّ ناصرك أمام عدوٍّ كثير فاستحضر: ﴿أَنِّي مَعَكُمْ فَثَبِّتُوا الَّذِينَ آمَنُوا﴾."},{"i":50,"strength":"direct","bridge":"إذا ضعفت أمام قومٍ ظالمين فاعلم: ﴿إِنَّ رَبَّكَ هُوَ الْقَوِيُّ الْعَزِيزُ﴾."},{"i":124,"strength":"direct","bridge":"إذا كثر خصومك وقلّ ناصرك فحسبك ربك؛ ﴿وَكَفَى بِرَبِّكَ هَادِيًا وَنَصِيرًا﴾."},{"i":197,"strength":"direct","bridge":"إذا شعرت بقلة الناصر فاعلم أن لربك جنودًا لا تُحصى؛ ﴿وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ﴾."}],"hadiths":[]},{"situationId":32,"verses":[{"i":113,"strength":"direct","bridge":"إذا وقفت أمام متكبّر فذكّره بأن فوقه ربًّا يملكه؛ ﴿إِنَّا رَسُولَا رَبِّكَ﴾."},{"i":128,"strength":"direct","bridge":"إذا كُلّفت بمواجهة ظالم فاعلم أن ربك هو الذي يبعثك؛ ﴿وَإِذْ نَادَى رَبُّكَ مُوسَى أَنِ ائْتِ الْقَوْمَ الظَّالِمِينَ﴾."}],"hadiths":[]},{"situationId":34,"verses":[{"i":123,"strength":"direct","bridge":"إذا امتُحنت بالناس فاصبر، فربك يرى؛ ﴿أَتَصْبِرُونَ وَكَانَ رَبُّكَ بَصِيرًا﴾."}],"hadiths":[]},{"situationId":35,"verses":[{"i":147,"strength":"direct","bridge":"إذا أوذيت في دينك فلا تجعل أذى الناس كعذاب الله؛ ﴿فَإِذَا أُوذِيَ فِي اللَّهِ جَعَلَ فِتْنَةَ النَّاسِ كَعَذَابِ اللَّهِ﴾."},{"i":207,"strength":"direct","bridge":"إذا رأيت المؤمنين يُعذبون لإيمانهم فاعلم أن لربك بطشًا؛ ﴿إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ﴾."}],"hadiths":[]},{"situationId":36,"verses":[{"i":53,"strength":"direct","bridge":"إذا رأيت الظالم آمنًا فلا تغترّ: ﴿وَمَا هِيَ مِنَ الظَّالِمِينَ بِبَعِيدٍ﴾."},{"i":101,"strength":"direct","bridge":"إذا رأيت إمهال الله للمذنبين فاعلم: ﴿وَرَبُّكَ الْغَفُورُ ذُو الرَّحْمَةِ﴾."},{"i":114,"strength":"direct","bridge":"إن رأيت الظالم ممهَلًا فاعلم أن تأخيره بقدرٍ سابق؛ ﴿وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِنْ رَبِّكَ لَكَانَ لِزَامًا﴾."},{"i":210,"strength":"direct","bridge":"إذا آلمك فساد الطغاة فاعلم أن لهم يومًا؛ ﴿فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ﴾."}],"hadiths":[]},{"situationId":37,"verses":[{"i":83,"strength":"direct","bridge":"إذا رأيت أهل الباطل في سعة فلا تعجب: ﴿وَمَا كَانَ عَطَاءُ رَبِّكَ مَحْظُورًا﴾."},{"i":157,"strength":"direct","bridge":"إذا رأيت أهل الباطل يتقلبون في البلاد فلا يغرّنك؛ ﴿وَكَذَلِكَ حَقَّتْ كَلِمَتُ رَبِّكَ عَلَى الَّذِينَ كَفَرُوا﴾."}],"hadiths":[]},{"situationId":38,"verses":[{"i":33,"strength":"direct","bridge":"إذا طال استضعافك فاصبر، فقد ﴿وَتَمَّتْ كَلِمَتُ رَبِّكَ الْحُسْنَى عَلَى بَنِي إِسْرَائِيلَ بِمَا صَبَرُوا﴾."},{"i":161,"strength":"direct","bridge":"إذا استبطأت الحسم في خلافات الناس فهو مؤجل بكلمة سبقت؛ ﴿وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِنْ رَبِّكَ لَقُضِيَ بَيْنَهُمْ﴾."}],"hadiths":[]},{"situationId":41,"verses":[{"i":86,"strength":"direct","bridge":"إذا قلقت على رزقك فاعلم: ﴿إِنَّ رَبَّكَ يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ وَيَقْدِرُ﴾."}],"hadiths":[]},{"situationId":42,"verses":[{"i":177,"strength":"direct","bridge":"إذا علّقت رجاءك بمخلوق فاعلم أنه لا يملك الخزائن؛ ﴿أَمْ عِنْدَهُمْ خَزَائِنُ رَبِّكَ﴾."}],"hadiths":[]},{"situationId":47,"verses":[{"i":135,"strength":"direct","bridge":"إذا أغراك الغش في الكيل والتعامل فتذكّر عاقبة مدين؛ ﴿وَإِنَّ رَبَّكَ لَهُوَ الْعَزِيزُ الرَّحِيمُ﴾."}],"hadiths":[]},{"situationId":51,"verses":[{"i":103,"strength":"direct","bridge":"إذا تأخّر عنك الولد فاقرأ ﴿ذِكْرُ رَحْمَتِ رَبِّكَ عَبْدَهُ زَكَرِيَّا﴾."},{"i":173,"strength":"direct","bridge":"إذا تأخرت ذريتك واستبعدت الولد فتذكر بشارة سارة؛ ﴿قَالُوا كَذَلِكِ قَالَ رَبُّكِ إِنَّهُ هُوَ الْحَكِيمُ الْعَلِيمُ﴾."}],"hadiths":[]},{"situationId":52,"verses":[{"i":64,"strength":"direct","bridge":"إذا رأيت بشائر الخير في ولدك فادعُ له: ﴿وَكَذَلِكَ يَجْتَبِيكَ رَبُّكَ وَيُعَلِّمُكَ مِنْ تَأْوِيلِ الْأَحَادِيثِ﴾."}],"hadiths":[]},{"situationId":53,"verses":[{"i":84,"strength":"direct","bridge":"إذا ضقت بكِبر والديك فتذكّر: ﴿فَلَا تَقُلْ لَهُمَا أُفٍّ وَلَا تَنْهَرْهُمَا وَقُلْ لَهُمَا قَوْلًا كَرِيمًا﴾."}],"hadiths":[]},{"situationId":57,"verses":[{"i":70,"strength":"direct","bridge":"إذا ضاق صدرك من المكذبين فاصفح واعلم: ﴿إِنَّ رَبَّكَ هُوَ الْخَلَّاقُ الْعَلِيمُ﴾."}],"hadiths":[]},{"situationId":59,"verses":[{"i":188,"strength":"direct","bridge":"إذا حكم الناس عليك بالضلال فالعبرة بعلم ربك؛ ﴿إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَنْ ضَلَّ عَنْ سَبِيلِهِ﴾."}],"hadiths":[]},{"situationId":65,"verses":[{"i":11,"strength":"direct","bridge":"إذا ثقل عليك حكمٌ شرعيٌّ في نزاعك فتذكّر القسم: ﴿فَلَا وَرَبِّكَ لَا يُؤْمِنُونَ حَتَّى يُحَكِّمُوكَ فِيمَا شَجَرَ بَيْنَهُمْ﴾."}],"hadiths":[]},{"situationId":67,"verses":[{"i":25,"strength":"direct","bridge":"إذا استهوتك متعةٌ مع رفقة السوء فتذكّر مآلها: ﴿قَالَ النَّارُ مَثْوَاكُمْ خَالِدِينَ فِيهَا﴾."}],"hadiths":[]},{"situationId":68,"verses":[{"i":85,"strength":"direct","bridge":"إذا سألك محتاجٌ ولا تجد شيئًا ﴿فَقُلْ لَهُمْ قَوْلًا مَيْسُورًا﴾."}],"hadiths":[]},{"situationId":73,"verses":[{"i":44,"strength":"direct","bridge":"إذا خلوت وظننت أن لا رقيب فتذكّر: ﴿وَمَا يَعْزُبُ عَنْ رَبِّكَ مِنْ مِثْقَالِ ذَرَّةٍ﴾."},{"i":139,"strength":"direct","bridge":"إذا عملت في الخفاء خيرًا أو شرًّا فاعلم أن ربك شاهد؛ ﴿وَمَا رَبُّكَ بِغَافِلٍ عَمَّا تَعْمَلُونَ﴾."},{"i":221,"strength":"direct","bridge":"إذا عصيت على أرض فاعلم أنها ستشهد بأمر ربك؛ ﴿بِأَنَّ رَبَّكَ أَوْحَى لَهَا﴾."}],"hadiths":[]},{"situationId":74,"verses":[{"i":134,"strength":"direct","bridge":"إذا ضغطت عليك البيئة لتقبل المنكر فاعتزلها واثقًا بربك؛ ﴿وَإِنَّ رَبَّكَ لَهُوَ الْعَزِيزُ الرَّحِيمُ﴾."}],"hadiths":[]},{"situationId":75,"verses":[{"i":93,"strength":"direct","bridge":"إذا اشتدّت عليك الوساوس فاحتمِ: ﴿إِنَّ عِبَادِي لَيْسَ لَكَ عَلَيْهِمْ سُلْطَانٌ وَكَفَى بِرَبِّكَ وَكِيلًا﴾."},{"i":152,"strength":"direct","bridge":"إذا خشيت وساوس الشيطان فاعلم أن ربك هو الحافظ؛ ﴿وَرَبُّكَ عَلَى كُلِّ شَيْءٍ حَفِيظٌ﴾."}],"hadiths":[]},{"situationId":76,"verses":[{"i":87,"strength":"direct","bridge":"إذا هوّنت ذنبًا فتذكّر: ﴿كُلُّ ذَلِكَ كَانَ سَيِّئُهُ عِنْدَ رَبِّكَ مَكْرُوهًا﴾."},{"i":100,"strength":"direct","bridge":"إذا استهنت بصغيرة فتذكّر: ﴿لَا يُغَادِرُ صَغِيرَةً وَلَا كَبِيرَةً إِلَّا أَحْصَاهَا﴾."}],"hadiths":[]},{"situationId":77,"verses":[{"i":159,"strength":"direct","bridge":"إذا تكاسلت عن العبادة فتذكّر من لا يسأم؛ ﴿فَالَّذِينَ عِنْدَ رَبِّكَ يُسَبِّحُونَ لَهُ بِاللَّيْلِ وَالنَّهَارِ وَهُمْ لَا يَسْأَمُونَ﴾."}],"hadiths":[]},{"situationId":78,"verses":[{"i":73,"strength":"direct","bridge":"إذا فترت عن الطاعة فتذكّر أن لا نهاية لها: ﴿وَاعْبُدْ رَبَّكَ حَتَّى يَأْتِيَكَ الْيَقِينُ﴾."}],"hadiths":[]},{"situationId":79,"verses":[{"i":37,"strength":"direct","bridge":"إذا شغلك يومك فاجعل لربك نصيبًا: ﴿وَاذْكُرْ رَبَّكَ فِي نَفْسِكَ تَضَرُّعًا وَخِيفَةً﴾."},{"i":115,"strength":"direct","bridge":"إذا أثقلك كلام الناس فاشتغل بتسبيح ربك تجد الرضا؛ ﴿وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ غُرُوبِهَا﴾."}],"hadiths":[]},{"situationId":84,"verses":[{"i":90,"strength":"direct","bridge":"إذا اعترضت على قسمة الله بين الناس فتذكّر: ﴿وَرَبُّكَ أَعْلَمُ بِمَنْ فِي السَّمَاوَاتِ وَالْأَرْضِ﴾."},{"i":155,"strength":"direct","bridge":"إذا اعترضت على عطاء الله لغيرك فاعلم لمن الخزائن؛ ﴿أَمْ عِنْدَهُمْ خَزَائِنُ رَحْمَةِ رَبِّكَ الْعَزِيزِ الْوَهَّابِ﴾."},{"i":165,"strength":"direct","bridge":"إذا اعترضت على تفاوت الأرزاق فتذكّر من قسمها؛ ﴿نَحْنُ قَسَمْنَا بَيْنَهُمْ مَعِيشَتَهُمْ فِي الْحَيَاةِ الدُّنْيَا﴾."}],"hadiths":[]},{"situationId":86,"verses":[{"i":137,"strength":"direct","bridge":"إذا ظننت أن ما في صدرك خافٍ فاعلم أن ربك يعلمه؛ ﴿وَإِنَّ رَبَّكَ لَيَعْلَمُ مَا تُكِنُّ صُدُورُهُمْ وَمَا يُعْلِنُونَ﴾."},{"i":144,"strength":"direct","bridge":"إذا أخفيت نيّتك عن الناس فهي ظاهرة عند ربك؛ ﴿وَرَبُّكَ يَعْلَمُ مَا تُكِنُّ صُدُورُهُمْ وَمَا يُعْلِنُونَ﴾."}],"hadiths":[]},{"situationId":88,"verses":[{"i":92,"strength":"direct","bridge":"إذا خفت من الناس فاعلم: ﴿إِنَّ رَبَّكَ أَحَاطَ بِالنَّاسِ﴾."}],"hadiths":[]},{"situationId":90,"verses":[{"i":13,"strength":"direct","bridge":"إذا ضاق رزقك فلا تُسئ الظن، فإن ربك ﴿بَلْ يَدَاهُ مَبْسُوطَتَانِ يُنْفِقُ كَيْفَ يَشَاءُ﴾."},{"i":142,"strength":"direct","bridge":"إذا خشيت ظلم القدر فاعلم أن ربك لا يأخذ إلا بعد البلاغ؛ ﴿وَمَا كَانَ رَبُّكَ مُهْلِكَ الْقُرَى حَتَّى يَبْعَثَ فِي أُمِّهَا رَسُولًا﴾."}],"hadiths":[]},{"situationId":91,"verses":[{"i":111,"strength":"direct","bridge":"إذا رأيت تفاخر الناس بالدنيا فاعلم: ﴿وَالْبَاقِيَاتُ الصَّالِحَاتُ خَيْرٌ عِنْدَ رَبِّكَ ثَوَابًا وَخَيْرٌ مَرَدًّا﴾."},{"i":116,"strength":"direct","bridge":"إذا لفتتك زينة ما عند الناس فاذكر عطاء ربك لك؛ ﴿وَرِزْقُ رَبِّكَ خَيْرٌ وَأَبْقَى﴾."},{"i":166,"strength":"direct","bridge":"إذا بهرتك زخارف الدنيا فقارنها بما عند ربك؛ ﴿وَالْآخِرَةُ عِنْدَ رَبِّكَ لِلْمُتَّقِينَ﴾."}],"hadiths":[]},{"situationId":93,"verses":[{"i":98,"strength":"direct","bridge":"إذا انبهرت بزينة المال والأولاد فتذكّر: ﴿وَالْبَاقِيَاتُ الصَّالِحَاتُ خَيْرٌ عِنْدَ رَبِّكَ ثَوَابًا﴾."}],"hadiths":[]},{"situationId":94,"verses":[{"i":217,"strength":"direct","bridge":"إذا فرغت من شغلك وتعلقت بالناس فارغب إلى ربك؛ ﴿وَإِلَى رَبِّكَ فَارْغَبْ﴾."}],"hadiths":[]},{"situationId":95,"verses":[{"i":54,"strength":"direct","bridge":"إذا تعلّق قلبك بغير الله فتأمّل: ﴿فَمَا أَغْنَتْ عَنْهُمْ آلِهَتُهُمُ الَّتِي يَدْعُونَ مِنْ دُونِ اللَّهِ مِنْ شَيْءٍ﴾."}],"hadiths":[]},{"situationId":96,"verses":[{"i":91,"strength":"direct","bridge":"إذا تعلّقت بالصالحين فاعلم أنهم ﴿يَبْتَغُونَ إِلَى رَبِّهِمُ الْوَسِيلَةَ﴾."}],"hadiths":[]},{"situationId":97,"verses":[{"i":189,"strength":"direct","bridge":"إذا عزمت على أمرٍ واثقًا بقدرتك ناسيًا مشيئة ربك فتذكّر أصحاب الجنة؛ ﴿فَطَافَ عَلَيْهَا طَائِفٌ مِنْ رَبِّكَ وَهُمْ نَائِمُونَ﴾."}],"hadiths":[]},{"situationId":100,"verses":[{"i":88,"strength":"direct","bridge":"إذا مال قلبك إلى غير الله فاحذر: ﴿وَلَا تَجْعَلْ مَعَ اللَّهِ إِلَهًا آخَرَ﴾."}],"hadiths":[]},{"situationId":102,"verses":[{"i":63,"strength":"direct","bridge":"إذا أهمّك أمرٌ لا تملكه فخذ الوصية: ﴿فَاعْبُدْهُ وَتَوَكَّلْ عَلَيْهِ وَمَا رَبُّكَ بِغَافِلٍ عَمَّا تَعْمَلُونَ﴾."}],"hadiths":[]},{"situationId":103,"verses":[{"i":36,"strength":"direct","bridge":"إذا خفت وحشة القلب فجدّد العهد الأول: ﴿أَلَسْتُ بِرَبِّكُمْ قَالُوا بَلَى شَهِدْنَا﴾."}],"hadiths":[]},{"situationId":104,"verses":[{"i":6,"strength":"direct","bridge":"إذا كثر حولك المشكّكون فاثبت على ما جاءك من ربك: ﴿الْحَقُّ مِنْ رَبِّكَ فَلَا تَكُونَنَّ مِنَ الْمُمْتَرِينَ﴾."},{"i":119,"strength":"direct","bridge":"إذا اضطربت أمام الشبهات فاطلب العلم الذي يورث الإخبات؛ ﴿وَلِيَعْلَمَ الَّذِينَ أُوتُوا الْعِلْمَ أَنَّهُ الْحَقُّ مِنْ رَبِّكَ فَيُؤْمِنُوا بِهِ فَتُخْبِتَ لَهُ قُلُوبُهُمْ﴾."},{"i":148,"strength":"direct","bridge":"إذا سمعت التشكيك في القرآن فثق بمصدره؛ ﴿بَلْ هُوَ الْحَقُّ مِنْ رَبِّكَ﴾."},{"i":163,"strength":"direct","bridge":"إذا ساورك الشك فتأمل آيات الآفاق والأنفس؛ ﴿سَنُرِيهِمْ آيَاتِنَا فِي الْآفَاقِ وَفِي أَنْفُسِهِمْ حَتَّى يَتَبَيَّنَ لَهُمْ أَنَّهُ الْحَقُّ﴾."}],"hadiths":[]},{"situationId":105,"verses":[{"i":153,"strength":"direct","bridge":"إذا سمعت ما لا يليق بربك فنزّهه عنه؛ ﴿فَاسْتَفْتِهِمْ أَلِرَبِّكَ الْبَنَاتُ وَلَهُمُ الْبَنُونَ﴾."}],"hadiths":[]},{"situationId":106,"verses":[{"i":10,"strength":"direct","bridge":"إذا سمعت من ينسب لله ولدًا فقل بيقين: ﴿الْحَقُّ مِنْ رَبِّكَ فَلَا تَكُنْ مِنَ الْمُمْتَرِينَ﴾."}],"hadiths":[]},{"situationId":107,"verses":[{"i":20,"strength":"direct","bridge":"إذا عُرضت عليك مرجعياتٌ غير الوحي فقل: ﴿أَفَغَيْرَ اللَّهِ أَبْتَغِي حَكَمًا﴾."},{"i":46,"strength":"direct","bridge":"إذا عرضت لك شبهة فتذكّر: ﴿لَقَدْ جَاءَكَ الْحَقُّ مِنْ رَبِّكَ فَلَا تَكُونَنَّ مِنَ الْمُمْتَرِينَ﴾."}],"hadiths":[]},{"situationId":108,"verses":[{"i":21,"strength":"direct","bridge":"إذا شككت في وعدٍ أو حكمٍ إلهي فتذكّر: ﴿وَتَمَّتْ كَلِمَتُ رَبِّكَ صِدْقًا وَعَدْلًا لَا مُبَدِّلَ لِكَلِمَاتِهِ﴾."},{"i":26,"strength":"direct","bridge":"إذا سألت عن عدل الله في الجزاء فتأمّل: ﴿ذَلِكَ أَنْ لَمْ يَكُنْ رَبُّكَ مُهْلِكَ الْقُرَى بِظُلْمٍ﴾."}],"hadiths":[]},{"situationId":109,"verses":[{"i":109,"strength":"direct","bridge":"إذا سمعت منكري البعث فتذكّر القسم: ﴿فَوَرَبِّكَ لَنَحْشُرَنَّهُمْ وَالشَّيَاطِينَ﴾."}],"hadiths":[]},{"situationId":110,"verses":[{"i":68,"strength":"direct","bridge":"إذا استبعدت البعث فتذكّر: ﴿وَإِنَّ رَبَّكَ هُوَ يَحْشُرُهُمْ إِنَّهُ حَكِيمٌ عَلِيمٌ﴾."},{"i":175,"strength":"direct","bridge":"إذا استبعدت الجزاء فهذا خبر مؤكد بالقسم؛ ﴿إِنَّ عَذَابَ رَبِّكَ لَوَاقِعٌ﴾."}],"hadiths":[]},{"situationId":111,"verses":[{"i":61,"strength":"direct","bridge":"إذا ضقت بكثرة الآراء والمذاهب فاعلم: ﴿وَلَوْ شَاءَ رَبُّكَ لَجَعَلَ النَّاسَ أُمَّةً وَاحِدَةً﴾."}],"hadiths":[]},{"situationId":112,"verses":[{"i":16,"strength":"direct","bridge":"إذا طلبت برهانًا حسيًّا لتطمئن فتذكّر الجواب: ﴿اتَّقُوا اللَّهَ إِنْ كُنْتُمْ مُؤْمِنِينَ﴾."},{"i":133,"strength":"direct","bridge":"إذا طلبت آيةً حسية لتؤمن فتذكّر ثمود؛ ﴿وَإِنَّ رَبَّكَ لَهُوَ الْعَزِيزُ الرَّحِيمُ﴾."}],"hadiths":[]},{"situationId":115,"verses":[{"i":213,"strength":"direct","bridge":"إذا اشتقت إلى الطمأنينة فاسع لهذا النداء؛ ﴿ارْجِعِي إِلَى رَبِّكِ رَاضِيَةً مَرْضِيَّةً﴾."}],"hadiths":[]},{"situationId":116,"verses":[{"i":24,"strength":"direct","bridge":"إذا تاهت بك السبل فاعلم أن الطريق واحد: ﴿وَهَذَا صِرَاطُ رَبِّكَ مُسْتَقِيمًا﴾."}],"hadiths":[]},{"situationId":118,"verses":[{"i":62,"strength":"direct","bridge":"إذا أردت النجاة من فتن الخلاف فاطلب أن تكون ممن قال فيهم: ﴿إِلَّا مَنْ رَحِمَ رَبُّكَ﴾."},{"i":77,"strength":"direct","bridge":"إذا اهتزّ قلبك أمام شبهة فاعلم أنه نزل ﴿لِيُثَبِّتَ الَّذِينَ آمَنُوا وَهُدًى وَبُشْرَى لِلْمُسْلِمِينَ﴾."},{"i":146,"strength":"direct","bridge":"إذا حاول أحد صرفك عن القرآن فاثبت وادعُ إلى ربك؛ ﴿وَلَا يَصُدُّنَّكَ عَنْ آيَاتِ اللَّهِ بَعْدَ إِذْ أُنْزِلَتْ إِلَيْكَ وَادْعُ إِلَى رَبِّكَ﴾."}],"hadiths":[]},{"situationId":119,"verses":[{"i":3,"strength":"direct","bridge":"إذا أمرك ربك بأمرٍ واضح فلا تُعقّده بكثرة السؤال؛ ﴿فَافْعَلُوا مَا تُؤْمَرُونَ﴾."},{"i":4,"strength":"direct","bridge":"كل سؤالٍ تتهرّب به من الطاعة يزيد الأمر ثقلًا عليك؛ ﴿ادْعُ لَنَا رَبَّكَ يُبَيِّنْ لَنَا مَا لَوْنُهَا﴾."}],"hadiths":[]},{"situationId":120,"verses":[{"i":67,"strength":"direct","bridge":"إذا أُعرضت عن تدبّر الوحي فتأمّل: ﴿إِنَّمَا يَتَذَكَّرُ أُولُو الْأَلْبَابِ﴾."}],"hadiths":[]},{"situationId":121,"verses":[{"i":42,"strength":"direct","bridge":"إذا استمرأت المعصية فاحذر أن يُطبع على قلبك: ﴿كَذَلِكَ حَقَّتْ كَلِمَتُ رَبِّكَ عَلَى الَّذِينَ فَسَقُوا﴾."}],"hadiths":[]},{"situationId":123,"verses":[{"i":150,"strength":"direct","bridge":"إذا تجاذبتك الآراء فاتبع وحي ربك؛ ﴿وَاتَّبِعْ مَا يُوحَى إِلَيْكَ مِنْ رَبِّكَ﴾."}],"hadiths":[]},{"situationId":124,"verses":[{"i":22,"strength":"direct","bridge":"إذا خُدعت بكثرة السالكين لطريقٍ فاعلم: ﴿إِنَّ رَبَّكَ هُوَ أَعْلَمُ مَنْ يَضِلُّ عَنْ سَبِيلِهِ﴾."}],"hadiths":[]},{"situationId":125,"verses":[{"i":18,"strength":"direct","bridge":"إذا اختلطت عليك الأصوات فاجعل مرجعك: ﴿اتَّبِعْ مَا أُوحِيَ إِلَيْكَ مِنْ رَبِّكَ﴾."},{"i":200,"strength":"direct","bridge":"إذا ضغط عليك الناس لتترك الحق فاصبر ولا تطعهم؛ ﴿فَاصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تُطِعْ مِنْهُمْ آثِمًا أَوْ كَفُورًا﴾."}],"hadiths":[]},{"situationId":127,"verses":[{"i":49,"strength":"direct","bridge":"إذا استوحشت من قلّة المؤمنين فتذكّر: ﴿إِنَّهُ الْحَقُّ مِنْ رَبِّكَ وَلَكِنَّ أَكْثَرَ النَّاسِ لَا يُؤْمِنُونَ﴾."},{"i":65,"strength":"direct","bridge":"إذا تكاثر المعرضون فلا تهتزّ: ﴿وَالَّذِي أُنْزِلَ إِلَيْكَ مِنْ رَبِّكَ الْحَقُّ﴾."},{"i":196,"strength":"direct","bridge":"إذا تعبت في طريق الحق فاجعل صبرك لربك؛ ﴿وَلِرَبِّكَ فَاصْبِرْ﴾."}],"hadiths":[]},{"situationId":128,"verses":[{"i":145,"strength":"direct","bridge":"إذا شعرت بنعمة الهداية عليك فاعلم أنها هبة من ربك فلا تبددها؛ ﴿وَمَا كُنْتَ تَرْجُو أَنْ يُلْقَى إِلَيْكَ الْكِتَابُ إِلَّا رَحْمَةً مِنْ رَبِّكَ﴾."}],"hadiths":[]},{"situationId":129,"verses":[{"i":78,"strength":"direct","bridge":"إذا خرجت من بيئة فتنةٍ وصبرت فأبشر: ﴿إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ﴾."}],"hadiths":[]},{"situationId":130,"verses":[{"i":43,"strength":"direct","bridge":"إذا انقسم الناس أمام دعوتك فكِلْ أمرهم إلى الله: ﴿وَرَبُّكَ أَعْلَمُ بِالْمُفْسِدِينَ﴾."},{"i":131,"strength":"direct","bridge":"إذا طالت دعوتك ولم تر ثمرتها فتذكّر عاقبة نوح؛ ﴿وَإِنَّ رَبَّكَ لَهُوَ الْعَزِيزُ الرَّحِيمُ﴾."}],"hadiths":[]},{"situationId":131,"verses":[{"i":15,"strength":"direct","bridge":"إذا آلمك إعراض الناس عن الحق فاسمع التسلية: ﴿فَلَا تَأْسَ عَلَى الْقَوْمِ الْكَافِرِينَ﴾."},{"i":47,"strength":"direct","bridge":"إذا حزنت على من لا يستجيب فاعلم: ﴿إِنَّ الَّذِينَ حَقَّتْ عَلَيْهِمْ كَلِمَتُ رَبِّكَ لَا يُؤْمِنُونَ﴾."},{"i":48,"strength":"direct","bridge":"إذا اشتدّ حرصك على هداية أحد فاسمع: ﴿أَفَأَنْتَ تُكْرِهُ النَّاسَ حَتَّى يَكُونُوا مُؤْمِنِينَ﴾."},{"i":127,"strength":"direct","bridge":"إذا حزنت لإعراض الناس عن الحق فتذكّر عزّة ربك ورحمته؛ ﴿وَإِنَّ رَبَّكَ لَهُوَ الْعَزِيزُ الرَّحِيمُ﴾."},{"i":179,"strength":"direct","bridge":"إذا حزنت على من أعرض عن الهداية فكِله إلى علم ربك؛ ﴿إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَنْ ضَلَّ عَنْ سَبِيلِهِ﴾."}],"hadiths":[]},{"situationId":132,"verses":[{"i":89,"strength":"direct","bridge":"إذا ثقل عليك التوحيد الخالص على قومٍ فلا تعجب: ﴿وَإِذَا ذَكَرْتَ رَبَّكَ فِي الْقُرْآنِ وَحْدَهُ وَلَّوْا عَلَى أَدْبَارِهِمْ نُفُورًا﴾."},{"i":130,"strength":"direct","bridge":"إذا دعوت أهلك إلى التوحيد فلم يستجيبوا فاطمئن إلى ربك؛ ﴿وَإِنَّ رَبَّكَ لَهُوَ الْعَزِيزُ الرَّحِيمُ﴾."}],"hadiths":[]},{"situationId":133,"verses":[{"i":17,"strength":"direct","bridge":"إذا حاورت مخالفًا فاطلب الحجة من ربك؛ ﴿نَرْفَعُ دَرَجَاتٍ مَنْ نَشَاءُ إِنَّ رَبَّكَ حَكِيمٌ عَلِيمٌ﴾."},{"i":120,"strength":"direct","bridge":"إذا نازعك المخالفون فامضِ في الدعوة واثقًا؛ ﴿وَادْعُ إِلَى رَبِّكَ إِنَّكَ لَعَلَى هُدًى مُسْتَقِيمٍ﴾."}],"hadiths":[]},{"situationId":134,"verses":[{"i":41,"strength":"direct","bridge":"إذا عجبت من بقاء الخلاف بلا حسم فاعلم: ﴿وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِنْ رَبِّكَ لَقُضِيَ بَيْنَهُمْ﴾."},{"i":58,"strength":"direct","bridge":"إذا تأخر الحسم في نزاعٍ على الحق فاصبر: ﴿وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِنْ رَبِّكَ لَقُضِيَ بَيْنَهُمْ﴾."},{"i":80,"strength":"direct","bridge":"إذا طال نزاعك مع المخالفين فكِل الحكم إليه: ﴿وَإِنَّ رَبَّكَ لَيَحْكُمُ بَيْنَهُمْ يَوْمَ الْقِيَامَةِ﴾."},{"i":138,"strength":"direct","bridge":"إذا طال خلافٌ لم يُحسم فكِله إلى ربك؛ ﴿إِنَّ رَبَّكَ يَقْضِي بَيْنَهُمْ بِحُكْمِهِ﴾."},{"i":171,"strength":"direct","bridge":"إذا طال النزاع وخفي الحق فيه فالقضاء النهائي عند ربك؛ ﴿إِنَّ رَبَّكَ يَقْضِي بَيْنَهُمْ يَوْمَ الْقِيَامَةِ﴾."}],"hadiths":[]},{"situationId":135,"verses":[{"i":14,"strength":"direct","bridge":"إذا خشيت الناس في قول الحق فاستحضر الوعد: ﴿وَاللَّهُ يَعْصِمُكَ مِنَ النَّاسِ﴾."}],"hadiths":[]},{"situationId":136,"verses":[{"i":160,"strength":"direct","bridge":"إذا كُذِّبت وأنت صادق فهذا طريق الرسل قبلك؛ ﴿مَا يُقَالُ لَكَ إِلَّا مَا قَدْ قِيلَ لِلرُّسُلِ مِنْ قَبْلِكَ﴾."}],"hadiths":[]},{"situationId":137,"verses":[{"i":60,"strength":"direct","bridge":"إذا ظننت أن النهي عن المنكر لا جدوى منه فاعلم: ﴿وَمَا كَانَ رَبُّكَ لِيُهْلِكَ الْقُرَى بِظُلْمٍ وَأَهْلُهَا مُصْلِحُونَ﴾."}],"hadiths":[]},{"situationId":138,"verses":[{"i":81,"strength":"direct","bridge":"إذا دعوت أحدًا فالتزم المنهج: ﴿ادْعُ إِلَى سَبِيلِ رَبِّكَ بِالْحِكْمَةِ وَالْمَوْعِظَةِ الْحَسَنَةِ﴾."},{"i":121,"strength":"direct","bridge":"إذا خفت أن تخسر شيئًا بإخلاصك فاعلم أن ما عند ربك أوفى؛ ﴿فَخَرَاجُ رَبِّكَ خَيْرٌ وَهُوَ خَيْرُ الرَّازِقِينَ﴾."},{"i":203,"strength":"direct","bridge":"إذا دعوت متكبرًا فادعه برفق إلى ربه؛ ﴿وَأَهْدِيَكَ إِلَى رَبِّكَ فَتَخْشَى﴾."}],"hadiths":[]},{"situationId":141,"verses":[{"i":12,"strength":"direct","bridge":"إذا دُعيت إلى واجبٍ فاحذر أن تقول بلسان حالك: ﴿فَاذْهَبْ أَنْتَ وَرَبُّكَ فَقَاتِلَا إِنَّا هَاهُنَا قَاعِدُونَ﴾."}],"hadiths":[]},{"situationId":142,"verses":[{"i":45,"strength":"direct","bridge":"إذا رأيت خلاف أهل العلم بغيًا فاعلم: ﴿إِنَّ رَبَّكَ يَقْضِي بَيْنَهُمْ يَوْمَ الْقِيَامَةِ﴾."},{"i":149,"strength":"direct","bridge":"إذا أعياك خلافٌ لم تُحسم فيه الحجة فموعده عند ربك؛ ﴿إِنَّ رَبَّكَ هُوَ يَفْصِلُ بَيْنَهُمْ يَوْمَ الْقِيَامَةِ﴾."},{"i":164,"strength":"direct","bridge":"إذا رأيت أهل الحق يتفرقون بغيًا فاحذر أن تكون منهم؛ ﴿وَمَا تَفَرَّقُوا إِلَّا مِنْ بَعْدِ مَا جَاءَهُمُ الْعِلْمُ بَغْيًا بَيْنَهُمْ﴾."}],"hadiths":[]},{"situationId":143,"verses":[{"i":2,"strength":"direct","bridge":"إذا ضجرت من نعمةٍ رتيبة واشتهيت ما دونها، فاسمع العتاب: ﴿أَتَسْتَبْدِلُونَ الَّذِي هُوَ أَدْنَى بِالَّذِي هُوَ خَيْرٌ﴾."},{"i":136,"strength":"direct","bridge":"إذا رأيت إمهال الله لك ولغيرك فاعرف أنه فضل يستحق الشكر؛ ﴿وَإِنَّ رَبَّكَ لَذُو فَضْلٍ عَلَى النَّاسِ وَلَكِنَّ أَكْثَرَهُمْ لَا يَشْكُرُونَ﴾."},{"i":182,"strength":"direct","bridge":"إذا شككت في نعمة أو غفلت عنها فتذكّر هذا السؤال؛ ﴿فَبِأَيِّ آلَاءِ رَبِّكَ تَتَمَارَى﴾."}],"hadiths":[]},{"situationId":144,"verses":[{"i":95,"strength":"direct","bridge":"إذا نسيت قيمة القرآن في يدك فتذكّر: ﴿إِلَّا رَحْمَةً مِنْ رَبِّكَ إِنَّ فَضْلَهُ كَانَ عَلَيْكَ كَبِيرًا﴾."},{"i":216,"strength":"direct","bridge":"إذا أنعم الله عليك فاذكر نعمته شاكرًا؛ ﴿وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ﴾."}],"hadiths":[]},{"situationId":147,"verses":[{"i":224,"strength":"direct","bridge":"إذا جاءك فرج أو نجاح فسبّح واستغفر؛ ﴿فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُ إِنَّهُ كَانَ تَوَّابًا﴾."}],"hadiths":[]},{"situationId":148,"verses":[{"i":32,"strength":"direct","bridge":"إذا وعدت الله في شدّتك فلا تكن ممن قالوا: ﴿لَئِنْ كَشَفْتَ عَنَّا الرِّجْزَ لَنُؤْمِنَنَّ لَكَ﴾."},{"i":167,"strength":"direct","bridge":"إذا فرّج الله عنك شدة فلا تكن ممن ينكث بعدها؛ ﴿ادْعُ لَنَا رَبَّكَ بِمَا عَهِدَ عِنْدَكَ إِنَّنَا لَمُهْتَدُونَ﴾."}],"hadiths":[]},{"situationId":150,"verses":[{"i":220,"strength":"direct","bridge":"إذا أطغاك الغنى أو النجاح فتذكر المرجع؛ ﴿إِنَّ إِلَى رَبِّكَ الرُّجْعَى﴾."}],"hadiths":[]},{"situationId":153,"verses":[{"i":9,"strength":"direct","bridge":"إذا شعرت بفضل الله عليك فقابله بالطاعة: ﴿يَا مَرْيَمُ اقْنُتِي لِرَبِّكِ وَاسْجُدِي وَارْكَعِي مَعَ الرَّاكِعِينَ﴾."},{"i":38,"strength":"direct","bridge":"إذا تكاسلت عن السجود فاقتدِ بمن ﴿وَيُسَبِّحُونَهُ وَلَهُ يَسْجُدُونَ﴾."},{"i":185,"strength":"direct","bridge":"إذا تأملت نعمة بين يديك فسبّح؛ ﴿فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيمِ﴾."},{"i":208,"strength":"direct","bridge":"إذا سجدت فاستحضر علوّ ربك؛ ﴿سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى﴾."}],"hadiths":[]},{"situationId":154,"verses":[{"i":154,"strength":"direct","bridge":"إذا ختمت مجلسك أو صلاتك فنزّه ربك؛ ﴿سُبْحَانَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُونَ﴾."}],"hadiths":[]},{"situationId":155,"verses":[{"i":94,"strength":"direct","bridge":"إذا ثقل عليك القيام فتذكّر الغاية: ﴿عَسَى أَنْ يَبْعَثَكَ رَبُّكَ مَقَامًا مَحْمُودًا﴾."},{"i":193,"strength":"direct","bridge":"إذا انشغل قلبك بالدنيا فانقطع إلى ربك؛ ﴿وَاذْكُرِ اسْمَ رَبِّكَ وَتَبَتَّلْ إِلَيْهِ تَبْتِيلًا﴾."}],"hadiths":[]},{"situationId":156,"verses":[{"i":8,"strength":"direct","bridge":"إذا بُشّرت بخيرٍ وأنت تنتظره فاشغل انتظارك بالذكر: ﴿وَاذْكُرْ رَبَّكَ كَثِيرًا وَسَبِّحْ بِالْعَشِيِّ وَالْإِبْكَارِ﴾."},{"i":158,"strength":"direct","bridge":"إذا طال عليك انتظار النصر فاستغفر وسبّح صباح مساء؛ ﴿وَسَبِّحْ بِحَمْدِ رَبِّكَ بِالْعَشِيِّ وَالْإِبْكَارِ﴾."},{"i":172,"strength":"direct","bridge":"إذا آذاك قول الناس فالجأ إلى التسبيح؛ ﴿فَاصْبِرْ عَلَى مَا يَقُولُونَ وَسَبِّحْ بِحَمْدِ رَبِّكَ﴾."},{"i":201,"strength":"direct","bridge":"إذا أردت حصنًا ليومك فاذكر ربك صباحًا ومساءً؛ ﴿وَاذْكُرِ اسْمَ رَبِّكَ بُكْرَةً وَأَصِيلًا﴾."}],"hadiths":[]},{"situationId":158,"verses":[{"i":96,"strength":"direct","bridge":"إذا نسيت الاستثناء أو غفلت ﴿وَاذْكُرْ رَبَّكَ إِذَا نَسِيتَ﴾."},{"i":218,"strength":"direct","bridge":"إذا بدأت تعلّمًا أو عملًا فابدأ باسم ربك؛ ﴿اقْرَأْ بِاسْمِ رَبِّكَ الَّذِي خَلَقَ﴾."}],"hadiths":[]},{"situationId":161,"verses":[{"i":29,"strength":"direct","bridge":"إذا اضطُررت إلى محظورٍ بلا بغيٍ ولا عدوان فاطمئن: ﴿فَإِنَّ رَبَّكَ غَفُورٌ رَحِيمٌ﴾."},{"i":194,"strength":"direct","bridge":"إذا عجزت عن الكمال في العبادة فخذ ما تيسر؛ ﴿عَلِمَ أَنْ لَنْ تُحْصُوهُ فَتَابَ عَلَيْكُمْ فَاقْرَءُوا مَا تَيَسَّرَ مِنَ الْقُرْآنِ﴾."}],"hadiths":[]},{"situationId":162,"verses":[{"i":184,"strength":"direct","bridge":"إذا عدّدت نعم الله فاختم بالثناء عليه؛ ﴿تَبَارَكَ اسْمُ رَبِّكَ ذِي الْجَلَالِ وَالْإِكْرَامِ﴾."}],"hadiths":[]},{"situationId":166,"verses":[{"i":7,"strength":"direct","bridge":"حين تتوجّه في صلاتك من أي أرض فاعلم أن ﴿وَإِنَّهُ لَلْحَقُّ مِنْ رَبِّكَ﴾."}],"hadiths":[]},{"situationId":167,"verses":[{"i":169,"strength":"direct","bridge":"إذا شعرت بحاجتك إلى الهداية فاعلم أن الوحي رحمة مهداة؛ ﴿رَحْمَةً مِنْ رَبِّكَ إِنَّهُ هُوَ السَّمِيعُ الْعَلِيمُ﴾."}],"hadiths":[]},{"situationId":169,"verses":[{"i":223,"strength":"direct","bridge":"إذا أُعطيت خيرًا فاشكره بالإخلاص؛ ﴿فَصَلِّ لِرَبِّكَ وَانْحَرْ﴾."}],"hadiths":[]},{"situationId":171,"verses":[{"i":27,"strength":"direct","bridge":"إذا ظننت أن عملك الخفيّ ضائع فاعلم: ﴿وَمَا رَبُّكَ بِغَافِلٍ عَمَّا يَعْمَلُونَ﴾."},{"i":59,"strength":"direct","bridge":"إذا خشيت ألا يُجزى عملك فاطمئن: ﴿لَيُوَفِّيَنَّهُمْ رَبُّكَ أَعْمَالَهُمْ إِنَّهُ بِمَا يَعْمَلُونَ خَبِيرٌ﴾."},{"i":162,"strength":"direct","bridge":"إذا خفت ضياع عملك الصالح فاطمئن؛ ﴿مَنْ عَمِلَ صَالِحًا فَلِنَفْسِهِ وَمَنْ أَسَاءَ فَعَلَيْهَا وَمَا رَبُّكَ بِظَلَّامٍ لِلْعَبِيدِ﴾."}],"hadiths":[]},{"situationId":174,"verses":[{"i":112,"strength":"direct","bridge":"إذا وقفت بين يدي الله فتأدّب كما أُمر موسى: ﴿إِنِّي أَنَا رَبُّكَ فَاخْلَعْ نَعْلَيْكَ﴾."},{"i":195,"strength":"direct","bridge":"إذا هبت مهمة كبيرة فعظّم ربك فيصغر كل شيء؛ ﴿وَرَبَّكَ فَكَبِّرْ﴾."}],"hadiths":[]},{"situationId":175,"verses":[{"i":75,"strength":"direct","bridge":"إذا تأمّلت دقة المخلوقات الصغيرة فتذكّر: ﴿وَأَوْحَى رَبُّكَ إِلَى النَّحْلِ﴾."}],"hadiths":[]},{"situationId":177,"verses":[{"i":125,"strength":"direct","bridge":"إذا غفلت عن ربك فتأمّل الظل حولك؛ ﴿أَلَمْ تَرَ إِلَى رَبِّكَ كَيْفَ مَدَّ الظِّلَّ﴾."}],"hadiths":[]},{"situationId":178,"verses":[{"i":69,"strength":"direct","bridge":"إذا تأمّلت أصل خلقك فتواضع: ﴿إِنِّي خَالِقٌ بَشَرًا مِنْ صَلْصَالٍ مِنْ حَمَإٍ مَسْنُونٍ﴾."},{"i":126,"strength":"direct","bridge":"إذا تأملت روابط أسرتك فاذكر من نسجها؛ ﴿فَجَعَلَهُ نَسَبًا وَصِهْرًا وَكَانَ رَبُّكَ قَدِيرًا﴾."},{"i":156,"strength":"direct","bridge":"إذا تأملت أصل خلقك فاعرف تواضع المبدأ وكرم الخالق؛ ﴿إِذْ قَالَ رَبُّكَ لِلْمَلَائِكَةِ إِنِّي خَالِقٌ بَشَرًا مِنْ طِينٍ﴾."}],"hadiths":[]},{"situationId":180,"verses":[{"i":55,"strength":"direct","bridge":"إذا اعتبرت بمصارع الظالمين فاعلم: ﴿وَكَذَلِكَ أَخْذُ رَبِّكَ إِذَا أَخَذَ الْقُرَى وَهِيَ ظَالِمَةٌ﴾."},{"i":132,"strength":"direct","bridge":"إذا اغتررت بقوة البشر فاعتبر بمصرع عاد؛ ﴿وَإِنَّ رَبَّكَ لَهُوَ الْعَزِيزُ الرَّحِيمُ﴾."},{"i":209,"strength":"direct","bridge":"إذا رأيت قوة الظالمين فتذكر عادًا؛ ﴿أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ﴾."}],"hadiths":[]},{"situationId":181,"verses":[{"i":170,"strength":"direct","bridge":"إذا تطلعت إلى الفوز الحقيقي فاعلم أنه فضل ربك؛ ﴿فَضْلًا مِنْ رَبِّكَ ذَلِكَ هُوَ الْفَوْزُ الْعَظِيمُ﴾."},{"i":181,"strength":"direct","bridge":"إذا تاهت بك الأسئلة عن نهاية الحياة فاعلم إلى أين المصير؛ ﴿وَأَنَّ إِلَى رَبِّكَ الْمُنْتَهَى﴾."},{"i":206,"strength":"direct","bridge":"إذا أرهقك تعب الحياة فاعلم إلى أين يمضي كدحك؛ ﴿يَا أَيُّهَا الْإِنْسَانُ إِنَّكَ كَادِحٌ إِلَى رَبِّكَ كَدْحًا فَمُلَاقِيهِ﴾."}],"hadiths":[]},{"situationId":182,"verses":[{"i":186,"strength":"direct","bridge":"إذا تيقنت حقيقة الموت والجزاء فعظّم ربك؛ ﴿فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيمِ﴾."},{"i":199,"strength":"direct","bridge":"إذا خفت الموت فاستعد للقاء من تُساق إليه؛ ﴿إِلَى رَبِّكَ يَوْمَئِذٍ الْمَسَاقُ﴾."}],"hadiths":[]},{"situationId":183,"verses":[{"i":99,"strength":"direct","bridge":"إذا تخيّلت يوم القيامة فاستعدّ: ﴿وَعُرِضُوا عَلَى رَبِّكَ صَفًّا﴾."},{"i":191,"strength":"direct","bridge":"إذا تفكرت في أهوال القيامة فاستحضر عظمة ربك؛ ﴿وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍ ثَمَانِيَةٌ﴾."},{"i":198,"strength":"direct","bridge":"إذا فكرت بالهروب من المحاسبة فلا مفر؛ ﴿إِلَى رَبِّكَ يَوْمَئِذٍ الْمُسْتَقَرُّ﴾."}],"hadiths":[]},{"situationId":185,"verses":[{"i":56,"strength":"direct","bridge":"إذا تفكّرت في الحساب فتذكّر سلطانه: ﴿إِنَّ رَبَّكَ فَعَّالٌ لِمَا يُرِيدُ﴾."},{"i":71,"strength":"direct","bridge":"إذا عبثت بآيات الله أو رأيت من يعبث فتذكّر: ﴿فَوَرَبِّكَ لَنَسْأَلَنَّهُمْ أَجْمَعِينَ﴾."},{"i":110,"strength":"direct","bridge":"إذا غفلت عن الآخرة فتذكّر: ﴿وَإِنْ مِنْكُمْ إِلَّا وَارِدُهَا﴾."},{"i":168,"strength":"direct","bridge":"إذا تهاونت بالمعصية فتصوّر هذا النداء؛ ﴿وَنَادَوْا يَا مَالِكُ لِيَقْضِ عَلَيْنَا رَبُّكَ قَالَ إِنَّكُمْ مَاكِثُونَ﴾."},{"i":212,"strength":"direct","bridge":"إذا تخيلت موقف الحساب فاستعد لمجيء ربك؛ ﴿وَجَاءَ رَبُّكَ وَالْمَلَكُ صَفًّا صَفًّا﴾."}],"hadiths":[]},{"situationId":186,"verses":[{"i":204,"strength":"direct","bridge":"إذا انشغلت بموعد الساعة عن الاستعداد لها فاعلم أن علمها عند ربك؛ ﴿إِلَى رَبِّكَ مُنْتَهَاهَا﴾."}],"hadiths":[]},{"situationId":187,"verses":[{"i":57,"strength":"direct","bridge":"إذا اشتقت إلى الجنة فتذكّر أنها ﴿عَطَاءً غَيْرَ مَجْذُوذٍ﴾."},{"i":122,"strength":"direct","bridge":"إذا اشتقت إلى الجنة فاعلم أنها وعدٌ من ربك لا يخلف؛ ﴿كَانَ عَلَى رَبِّكَ وَعْدًا مَسْئُولًا﴾."},{"i":202,"strength":"direct","bridge":"إذا خشيت ألا يكافأ عملك فاعلم أن عطاء ربك وافٍ؛ ﴿جَزَاءً مِنْ رَبِّكَ عَطَاءً حِسَابًا﴾."}],"hadiths":[]},{"situationId":191,"verses":[{"i":97,"strength":"direct","bridge":"إذا بحثت عن ملجأ فاعلم: ﴿وَلَنْ تَجِدَ مِنْ دُونِهِ مُلْتَحَدًا﴾."},{"i":141,"strength":"direct","bridge":"إذا تأملت نعمة الوحي عليك فاعرف أنها رحمة لا استحقاق؛ ﴿وَلَكِنْ رَحْمَةً مِنْ رَبِّكَ لِتُنْذِرَ قَوْمًا مَا أَتَاهُمْ مِنْ نَذِيرٍ مِنْ قَبْلِكَ﴾."},{"i":192,"strength":"direct","bridge":"إذا قرأت القرآن وأيقنت بحقه فسبّح؛ ﴿فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيمِ﴾."}],"hadiths":[]},{"situationId":193,"verses":[{"i":151,"strength":"direct","bridge":"إذا طلبت الهداية فاطلبها في العلم بما أنزل ربك؛ ﴿وَيَرَى الَّذِينَ أُوتُوا الْعِلْمَ الَّذِي أُنْزِلَ إِلَيْكَ مِنْ رَبِّكَ هُوَ الْحَقَّ﴾."},{"i":219,"strength":"direct","bridge":"إذا شعرت بقصور علمك فاطلبه من الأكرم؛ ﴿اقْرَأْ وَرَبُّكَ الْأَكْرَمُ﴾."}],"hadiths":[]},{"situationId":196,"verses":[{"i":23,"strength":"direct","bridge":"إذا سمعت من يحرّم ويحلّ بهواه فاحذر: ﴿وَإِنَّ كَثِيرًا لَيُضِلُّونَ بِأَهْوَائِهِمْ بِغَيْرِ عِلْمٍ﴾."}],"hadiths":[]}]}]}