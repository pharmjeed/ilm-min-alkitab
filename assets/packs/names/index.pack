رى الرحم.","positions":1,"surahs":1,"hadiths":1,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":289},{"id":432,"name":"بعباده بصيرًا","compound":true,"excerpt":"الإمهال رحمة، وهو بصير بعباده.","positions":1,"surahs":1,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":290},{"id":433,"name":"ربك","compound":false,"excerpt":"ربك الذي يرعاك لا يغفل عنك ولا ينساك، فاعبده وتوكّل عليه حتى يأتيك اليقين.","positions":224,"surahs":62,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":201},{"id":434,"name":"ربكم","compound":false,"excerpt":"ربك الذي خلقك ورباك بنعمه هو وحده الأحق أن تعبده وتدعوه وترجع إليه.","positions":116,"surahs":38,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":202},{"id":435,"name":"ربكما","compound":false,"excerpt":"كل نعمةٍ في الكون والآخرة شاهدةٌ بربوبية الله، فلا يليق بالعبد أن يكذّب بشيءٍ منها.","positions":33,"surahs":3,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":203},{"id":436,"name":"ربه","compound":false,"excerpt":"لكل عبدٍ ربٌّ قريب يربيه، فمن نادى ربه أجابه، ومن عصاه ثم تاب اجتباه.","positions":72,"surahs":42,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":204},{"id":437,"name":"ربهم","compound":false,"excerpt":"من عرف أن له ربًا يربيه ويرجع إليه خشيه بالغيب وتوكل عليه وطلب ما عنده.","positions":122,"surahs":46,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":205},{"id":438,"name":"ربي","compound":false,"excerpt":"من قال «ربي» بصدق عاش في كنف من يتولاه: يهديه ويكفيه ويغفر له ويعلم ما لا يعلم.","positions":86,"surahs":33,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":207},{"id":439,"name":"ربنا","compound":false,"excerpt":"من عرف أن الله ربُّه دعاه بـ«ربنا» في كل حال قبل أن يأتي يومٌ يقولها فيه أهل الندم بلا نفع.","positions":98,"surahs":38,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":208}],"doors":[{"id":1,"slug":"ضيق-وكرب","label":