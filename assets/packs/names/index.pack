ين","compound":true,"excerpt":"العقوبة ليست بيدك.","positions":1,"surahs":1,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":233},{"id":380,"name":"أعلم بالمعتدين","compound":true,"excerpt":"التحريم بالهوى اعتداء.","positions":1,"surahs":1,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":234},{"id":381,"name":"أعلم بالمفسدين","compound":true,"excerpt":"التكذيب بلا علم إفساد.","positions":1,"surahs":1,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":235},{"id":382,"name":"أعلم بالشاكرين","compound":true,"excerpt":"الفضل لمن يشكر لا لمن يتكبر.","positions":1,"surahs":1,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":236},{"id":383,"name":"أعلم بمن هو أهدى سبيلًا","compound":true,"excerpt":"كلٌّ على شاكلته، والله أعلم بالأهدى.","positions":1,"surahs":1,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":238},{"id":384,"name":"ولي المؤمنين","compound":true,"excerpt":"الأحق بإبراهيم من اتبعه.","positions":1,"surahs":1,"hadiths":1,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":239},{"id":385,"name":"ولي المتقين","compound":true,"excerpt":"لا يغنون عنك من الله شيئًا.","positions":1,"surahs":1,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":240},{"id":386,"name":"بالمؤمنين رحيمًا","compound":true,"excerpt":"الذكر طريق صلاة الله عليك.","positions":1,"surahs":1,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":241},{"id":387,"name":"للأوابين غفورًا","compound":true,"excerpt":"إن كنت صالح النية فالرجوع يمحو.","positions":1,"surahs":1,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":242},{"id":388,"name":"ذو فضل على المؤمنين","compound":true,"excerpt":"حتى بعد الفشل، العفو فضل.","positions":1,"surahs":1,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":244},{"id":389,"name":"بالناس لرءوف رحيم","compound":true,"excerpt":"عمل الماضي محفوظ.","positions":2,"s