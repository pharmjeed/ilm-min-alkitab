{"schema":1,"kind":"names","version":"names-f6a9cb129678","generatedAt":"2026-11-26T10:26:58Z","source":{"content":"v25@2026-11-26T10:26:58Z","sunnahLayer":"v25@2026-11-26T10:22:14Z#d2cd556f8a4a"},"stats":{"names":434,"positions":3040,"hadiths":561,"doors":16,"situations":198},"nameOfDay":{"mode":"sequential_by_date"},"names":[{"id":1,"name":"الله","compound":false,"excerpt":"العَلَم الجامع الذي تُضاف إليه كل الأسماء ولا يُضاف إلى شيء: 1,825 موضعًا أكثفُها في سور بناء المجتمع لا في سور التأمل — لأن ما يُنسب إلى «الله» يصير مُلزِمًا؛ وميزانُه محفوظ في نسبته نفسها: 108 مواضع لقبول التوبة تقابلها 120 للوعيد، و262…","positions":1058,"surahs":74,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":1},{"id":2,"name":"الحكيم الخبير","compound":true,"excerpt":"إذا غاب عنك وجهُ الحكمة في قضائه، فلم يغب عن الحكيم الخبير — فهو يدبّر عن خبرةٍ ببواطن لا تراها.","positions":4,"surahs":3,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":17},{"id":3,"name":"سميع الدعاء","compound":true,"excerpt":"«سميع الدعاء» لم يُذكر في القرآن إلا وحوله دعوةٌ مجابة على انقطاع الأسباب — فاذكرْه وأنت موقنٌ بمثلها.","positions":2,"surahs":2,"hadiths":1,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":226},{"id":4,"name":"رب رحيم","compound":true,"excerpt":"أعظمُ ما في الجنة كلمةُ «سلام» من ربٍّ رحيم — فاطلبْ صاحبَ الكلمة قبل النعيم.","positions":1,"surahs":1,"hadiths":1,"category":"أسماء الربوبية","categoryOrder":157},{"id":5,"name":"الله أحد","compound":true,"excerpt":"من عرف أنه «أحد» لم يَقسم قلبَه بين اثنين.","positions":1,"surahs":1,"hadiths":17,"category":"أسماء الألوهية","categoryOrder":12},{"id":6,"name":"الله الرحمن الرحيم","compound":true,"excerpt":"كلُّ أبواب القرآن — وكلُّ أبواب حياتك — تُفتح بمفتاحٍ واحد: بسم الله الرحمن الرحيم.","positions":2,"surahs":2,"hadiths":28,"category":"أسماء الألوهية","categoryOrder":3},{"id":7,"name":"الرحمن","compound":false,"excerpt":"قالت قريش: «وما الرحمن؟» فأجابهم القرآن ثمانيةً وأربعين جوابًا: هو الذي على العرش استوى، ويمسك الطيرَ فوقك، ويكلؤك وأنت نائم، ويملك اليومَ الذي تلقاه — فادعُه بالاسم الذي أنكروه، وقل: آمنّا به وعليه توكلنا.","positions":48,"surahs":13,"hadiths":58,"category":"أسماء الرحمانية","categoryOrder":97},{"id":8,"name":"الحكيم الحميد","compound":true,"excerpt":"المصحف الذي بين يديك يحمل ضمانًا من كل جهة: «تنزيلٌ من حكيم حميد» — فاقرأه بيقين من لا يخشى على كتابه باطلًا.","positions":1,"surahs":1,"hadiths":1,"category":"أسماء الرحمانية","categoryOrder":126},{"id":9,"name":"أحكم الحاكمين","compound":true,"excerpt":"ناداه نوحٌ بها والموجُ يحمل ابنه — فإذا أوجعك قضاءٌ لا تفهمه، فقف موقفه: اعرض ولا تعترض، وقل: «وأنت أحكم الحاكمين».","positions":2,"surahs":2,"hadiths":1,"category":"أسماء الرحمانية","categoryOrder":101},{"id":10,"name":"رب غفور","compound":true,"excerpt":"الحياة الكاملة في أربع كلمات: ﴿بَلْدَةٌ طَيِّبَةٌ وَرَبٌّ غَفُورٌ﴾ — رزقٌ تأكله ومغفرةٌ تسترك، وثمنُهما شكرٌ يسير.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":152},{"id":11,"name":"ذو العرش","compound":true,"excerpt":"لكل طاغيةٍ كرسيٌّ يزول، وفوق الجميع «ذو العرش المجيد» — فارفع كربك وشكواك إلى من عرشُه لا يزول.","positions":2,"surahs":2,"hadiths":4,"category":"أسماء الألوهية","categoryOrder":56},{"id":12,"name":"الله رب العالمين","compound":true,"excerpt":"الجملة التي تفتتح بها كلَّ ركعةٍ هي نفسُها آخرُ ما يُقال في الوجود بعد القضاء — «الحمد لله رب العالمين» بدايةُ كتابك وخاتمةُ التاريخ، فمن لزمها عاش على لغة أهل الجنة.","positions":14,"surahs":11,"hadiths":23,"category":"أسماء الرحمانية","categoryOrder":127},{"id":13,"name":"العظيم","compound":false,"excerpt":"ثلاثُ مراتٍ أمرك القرآن بحرفٍ واحد: ﴿فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيمِ﴾ — فاجعلها في ركوعك ولسانك: كلمتان خفيفتان، ثقيلتان في الميزان، حبيبتان إلى الرحمن.","positions":3,"surahs":2,"hadiths":4,"category":"أسماء الربوبية","categoryOrder":168},{"id":14,"name":"العفو الغفور","compound":true,"excerpt":"من اسمه «العفوّ» جاءتك رخصُك وأعذارُك وكفاراتُك — فقل كما علّم النبيُّ ﷺ: «اللهم إنك عفوٌّ تحب العفو فاعفُ عني».","positions":4,"surahs":3,"hadiths":2,"category":"أسماء الألوهية","categoryOrder":19},{"id":15,"name":"خير الحاكمين","compound":true,"excerpt":"قالها في القرآن ثلاثةُ منتظرين في ثلاثة مآزق — فإذا طال انتظارُك فقل قولهم: «حتى يحكم الله وهو خير الحاكمين»، واعمل ولا تستعجل.","positions":3,"surahs":3,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":65},{"id":16,"name":"علام الغيوب","compound":true,"excerpt":"الاسمُ الذي فوّض به الرسلُ علمَهم، وتبرأ به المسيح، وتُختم به كلُّ استخارة: «وأنت علام الغيوب» — ففوّض إليه كلَّ قرارٍ غابت عنك عاقبتُه.","positions":4,"surahs":3,"hadiths":3,"category":"أسماء الرحمانية","categoryOrder":116},{"id":17,"name":"واسع المغفرة","compound":true,"excerpt":"يعرف طينتَك من قبل أن تولد — فمغفرتُه أوسع من لممك، وعلمُه أصدقُ من تزكيتك لنفسك: فلا تيأس ولا تغترّ.","positions":1,"surahs":1,"hadiths":2,"category":"أسماء الربوبية","categoryOrder":174},{"id":18,"name":"الله العزيز الحكيم","compound":true,"excerpt":"حيث استشكلتَ حكمًا أو ضاقت بك حال، جاء التوقيع نفسُه: «والله عزيز حكيم» — يقدر على ما تعجز عنه، ولا يفعل إلا ما هو الأصوب.","positions":7,"surahs":7,"hadiths":2,"category":"أسماء الألوهية","categoryOrder":41},{"id":19,"name":"الأعلى","compound":false,"excerpt":"أخفضُ ما تكون — ساجدًا بجبهتك على الأرض — تقول: «سبحان ربي الأعلى»؛ ومن رفع قصدَه إلى وجه الأعلى استغنى عن كل جزاءٍ أدنى.","positions":2,"surahs":2,"hadiths":14,"category":"أسماء الربوبية","categoryOrder":184},{"id":20,"name":"الحليم الغفور","compound":true,"excerpt":"السماءُ فوق رأسك لم تسقط بعد — ذلك حلمُه؛ وبابُ التوبة لم يُغلق بعد — تلك مغفرتُه: ﴿إِنَّهُ كَانَ حَلِيمًا غَفُورًا﴾.","positions":2,"surahs":2,"hadiths":1,"category":"أسماء الألوهية","categoryOrder":54},{"id":21,"name":"أرحم الراحمين","compound":true,"excerpt":"أربعةُ أنبياء نادوه به في أضيق ساعاتهم — وأبلغُهم أيوب: عرض حالَه ووصف ربَّه فاستُجيب له. فإن ضاق بك الأمر فقل: «مسّني الضر وأنت أرحم الراحمين».","positions":4,"surahs":3,"hadiths":11,"category":"أسماء الرحمانية","categoryOrder":131},{"id":22,"name":"مالك الملك","compound":true,"excerpt":"كلُّ ملكٍ تراه عاريةٌ من مالك الملك — يؤتي وينزع، ويعزّ ويذل؛ فادعُه بما أمرك أن تقول، ولا تتذلل لمن مُلكُه في يد غيره.","positions":1,"surahs":1,"hadiths":1,"category":"أسماء الألوهية","categoryOrder":55},{"id":23,"name":"شديد المحال","compound":true,"excerpt":"الرعدُ يسبّح والملائكةُ ترتجف — والمجادلُ بلا علم آمنٌ مطمئن! والاسمُ تذكيرٌ: ﴿وَهُوَ شَدِيدُ الْمِحَالِ﴾، فمن غالبه غُلب.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":64},{"id":24,"name":"الله الواحد القهار","compound":true,"excerpt":"سألها يوسفُ في السجن: ﴿أَأَرْبَابٌ مُتَفَرِّقُونَ خَيْرٌ أَمِ اللَّهُ الْوَاحِدُ الْقَهَّارُ﴾ — وسيُسأل يوم البروز: ﴿لِمَنِ الْمُلْكُ الْيَوْمَ﴾، والجواب واحد. فاجمع قلبك عليه اليوم.","positions":4,"surahs":4,"hadiths":3,"category":"أسماء الألوهية","categoryOrder":30},{"id":25,"name":"الوهاب","compound":false,"excerpt":"اسمٌ لم يرد في القرآن إلا في ذيل دعاء: به سأل الراسخون ثباتَ القلب، وبه سأل سليمان ملكًا لا ينبغي لأحدٍ بعده — فلا تستصغر قلبك أن تسأله الثبات، ولا تستعظم حاجةً على الوهاب.","positions":2,"surahs":2,"hadiths":4,"category":"أسماء الربوبية","categoryOrder":185},{"id":26,"name":"الرحيم الغفور","compound":true,"excerpt":"أحاط علمُه بكل والجٍ وخارجٍ ونازلٍ وعارج — ثم قال عن نفسه قبل أن ترتعب: ﴿وَهُوَ الرَّحِيمُ الْغَفُورُ﴾ — فعلمُه بك أمانٌ لا فضيحة.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":6},{"id":27,"name":"خير الراحمين","compound":true,"excerpt":"فريقٌ سُخر منهم فقالوا: ﴿رَبَّنَا آمَنَّا فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الرَّاحِمِينَ﴾ — فتُلي دعاؤهم يوم القيامة وقيل: هم الفائزون. فقل قولهم واصبر صبرهم.","positions":2,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":159},{"id":28,"name":"الله الصمد","compound":true,"excerpt":"كلُّ من تطرق بابه محتاجٌ يصمد إلى الصمد مثلك — فاختصر الطريق: اقصد من يقصده الجميع ولا يحتاج أحدًا.","positions":1,"surahs":1,"hadiths":5,"category":"أسماء الألوهية","categoryOrder":11},{"id":29,"name":"المليك المقتدر","compound":true,"excerpt":"بعد سورةٍ من المصارع، خُتم الطريق بغايته: ﴿فِي مَقْعَدِ صِدْقٍ عِنْدَ مَلِيكٍ مُقْتَدِرٍ﴾ — فاطلب الجوارَ قبل الدار، والصدقَ قبل النعيم.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الرحمانية","categoryOrder":121},{"id":30,"name":"الله ذو المعارج","compound":true,"excerpt":"سأل ساخرٌ تعجيلَ العذاب، فكان الجواب اسمًا: ﴿ذِي الْمَعَارِجِ﴾ — النازل من ذلك العلو لا يدفعه أحد؛ فاصبر صبرًا جميلًا: إنهم يرونه بعيدًا ونراه قريبًا.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":31},{"id":31,"name":"التواب","compound":false,"excerpt":"علّمك القرآن ماذا تقول في قمة نجاحك: ﴿فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُ﴾ — فالتوابُ يقبل العائدين حتى من ذروة الإنجاز، والاستغفارُ خاتمُ الأعمال.","positions":1,"surahs":1,"hadiths":2,"category":"أسماء الربوبية","categoryOrder":186},{"id":32,"name":"الغفور الرحيم","compound":true,"excerpt":"أكثرُ اسمين اقترانًا في كتاب الله — أحدَ عشر وسبعين موضعًا كلها تشرح نبأً واحدًا أعلنه بنفسه: ﴿نَبِّئْ عِبَادِي أَنِّي أَنَا الْغَفُورُ الرَّحِيمُ﴾ — فلا تقنط، ولا تؤجل التوبة، ولا تحرم الناسَ مما ترجوه لنفسك.","positions":71,"surahs":31,"hadiths":33,"category":"أسماء الرحمانية","categoryOrder":103},{"id":33,"name":"خير الفاتحين","compound":true,"excerpt":"إذا أُغلق كل حوارٍ وضاق كل طريق، فقف موقف شعيب: ثباتٌ، فتوكل، ثم: ﴿رَبَّنَا افْتَحْ بَيْنَنَا وَبَيْنَ قَوْمِنَا بِالْحَقِّ وَأَنْتَ خَيْرُ الْفَاتِحِينَ﴾.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الرحمانية","categoryOrder":110},{"id":34,"name":"الله العظيم","compound":true,"excerpt":"جريمتان أوردتاه سلسلةَ السبعين ذراعًا: ﴿لَا يُؤْمِنُ بِاللَّهِ الْعَظِيمِ * وَلَا يَحُضُّ عَلَى طَعَامِ الْمِسْكِينِ﴾ — فاجمع ضدّيهما: إيمانًا بالعظيم وإطعامًا لمسكينه.","positions":1,"surahs":1,"hadiths":14,"category":"أسماء الألوهية","categoryOrder":5},{"id":35,"name":"عزيز ذو انتقام","compound":true,"excerpt":"لا ينتقم سبحانه إلا بعد كتابٍ أنزله وعفوٍ قدّمه ووعدٍ أعلنه — فإن رأيت المكر يهزّ الجبال فلا تحسبنّ الله مخلف وعده: ﴿إِنَّ اللَّهَ عَزِيزٌ ذُو انْتِقَامٍ﴾.","positions":4,"surahs":4,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":39},{"id":36,"name":"الله الملك الحق","compound":true,"excerpt":"سؤال العبث أجابه اسمٌ: ﴿فَتَعَالَى اللَّهُ الْمَلِكُ الْحَقُّ﴾ — ملكٌ حقّ لا يعبث، فلحياتك غاية؛ وسؤال العلم أجابه دعاء: ﴿رَبِّ زِدْنِي عِلْمًا﴾.","positions":2,"surahs":2,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":8},{"id":37,"name":"الغفار","compound":false,"excerpt":"قالها لك بنفسه: ﴿وَإِنِّي لَغَفَّارٌ لِمَنْ تَابَ﴾ — فمهما تكرر سقوطك كرّر رجوعك؛ وإن ضاق رزقك فالوصفة عند نوح: ﴿اسْتَغْفِرُوا رَبَّكُمْ إِنَّهُ كَانَ غَفَّارًا﴾.","positions":2,"surahs":2,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":183},{"id":38,"name":"الغفور ذو الرحمة","compound":true,"excerpt":"لو يؤاخذ لعجّل — لكنه ﴿الْغَفُورُ ذُو الرَّحْمَةِ﴾: يملك الرحمة فيمهل بها حتى الظالمين. فاجعل مهلتك توبةً لا غفلة — فالموعد ﴿لَنْ يَجِدُوا مِنْ دُونِهِ مَوْئِلًا﴾.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":162},{"id":39,"name":"خير الوارثين","compound":true,"excerpt":"سل حاجتك وسلّم عاقبتها كما فعل زكريا: ﴿رَبِّ لَا تَذَرْنِي فَرْدًا وَأَنْتَ خَيْرُ الْوَارِثِينَ﴾ — فوُهب يحيى وأُصلحت زوجُه: الإجابة قد تفوق السؤال.","positions":1,"surahs":1,"hadiths":1,"category":"أسماء الربوبية","categoryOrder":172},{"id":40,"name":"خير حافظا","compound":true,"excerpt":"حَذَرُ يعقوب الأول لم يحفظ يوسف — فقالها في الثانية: ﴿فَاللَّهُ خَيْرٌ حَافِظًا﴾: افعل أسبابك، ثم أودِع من تحب عند من لا ينام حفظُه.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":80},{"id":41,"name":"متم نوره","compound":true,"excerpt":"يجمعون أفواههم لإطفاء شمس: ﴿وَاللَّهُ مُتِمُّ نُورِهِ وَلَوْ كَرِهَ الْكَافِرُونَ﴾ — فاعمل في جانب النور: النتيجة محسومة قبل أن تبدأ المعركة.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":89},{"id":42,"name":"ذو الفضل العظيم","compound":true,"excerpt":"قاعدةٌ كررها ستًّا: ﴿ذَلِكَ فَضْلُ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ﴾ — فلا حاسدٌ يمنع ولا محتكرٌ يحجب ولا عملٌ يوازي: فاسأل من فضله وسابق.","positions":7,"surahs":5,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":23},{"id":43,"name":"القدير","compound":false,"excerpt":"خمسة ميادين لخصت قدرته: يستبدل الأمم، وينصر المظلوم، وينشئ الأنساب من ماء، ويجمع الخلائق، ويقلب العداوة مودة — فأيُّ بابٍ ضاق بك، فالقدير واحد.","positions":5,"surahs":5,"hadiths":0,"category":"أسماء الرحمانية","categoryOrder":137},{"id":44,"name":"الغفور الشكور","compound":true,"excerpt":"تتعامل مع من يمحو سيّئك ويضاعف حسنك — ﴿غَفُورٌ شَكُورٌ﴾ — فأيُّ تجارةٍ تبور مع شريكٍ كهذا؟","positions":3,"surahs":2,"hadiths":0,"category":"أسماء الرحمانية","categoryOrder":113},{"id":45,"name":"خير المنزلين","compound":true,"excerpt":"بعد أن غُسلت الأرض من أهلها ووقف نوحٌ على عالمٍ يبدأ من الصفر، لم يُعلَّم أن يسأل مالًا ولا أرضًا بل: ﴿رَبِّ أَنْزِلْنِي مُنْزَلًا مُبَارَكًا وَأَنْتَ خَيْرُ الْمُنْزِلِينَ﴾ — فلا تسكن منزلًا قبل أن تطلب بركته من مالكها.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":176},{"id":46,"name":"رب كل شيء","compound":true,"excerpt":"كلُّ من قد تتخذه ربًّا — رئيسًا أو تيارًا أو هوًى — هو نفسه مربوبٌ لرب كل شيء: فاختصر: ﴿أَغَيْرَ اللَّهِ أَبْغِي رَبًّا وَهُوَ رَبُّ كُلِّ شَيْءٍ﴾.","positions":1,"surahs":1,"hadiths":4,"category":"أسماء الربوبية","categoryOrder":148},{"id":47,"name":"رب الشعرى","compound":true,"excerpt":"عبدوا ألمعَ نجوم السماء فقال: ﴿وَأَنَّهُ هُوَ رَبُّ الشِّعْرَى﴾ — معبودُهم عبدٌ في ملكه: فكلُّ ما بهرك في الكون مربوبٌ — فاعبد ربَّه لا إياه.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":156},{"id":48,"name":"أهل التقوى وأهل المغفرة","compound":true,"excerpt":"لا تتعامل معه بما أنت أهله — بل بما هو أهله: ﴿هُوَ أَهْلُ التَّقْوَى وَأَهْلُ الْمَغْفِرَةِ﴾ — أعطه تقواه ينَلْك غفرانُه.","positions":1,"surahs":1,"hadiths":1,"category":"أسماء الألوهية","categoryOrder":22},{"id":49,"name":"الولي","compound":false,"excerpt":"وليٌّ حتى في لحظة وهنك: ﴿إِذْ هَمَّتْ طَائِفَتَانِ مِنْكُمْ أَنْ تَفْشَلَا وَاللَّهُ وَلِيُّهُمَا﴾ — فأعلنها كيوسف في قمتك، وكموسى في كارثتك: أنت وليّي في الدنيا والآخرة.","positions":13,"surahs":10,"hadiths":1,"category":"أسماء الألوهية","categoryOrder":36},{"id":50,"name":"الغفور الحليم","compound":true,"excerpt":"يعرف لغوَ لسانك وخطراتِ قلبك وزلاتِ مواقفك — ومع ذلك: ﴿غَفُورٌ حَلِيمٌ﴾: يغفر ما وقع ويمهل ما بقي — فالميزان ما كسب قلبُك، لا ما جرى به لسانك.","positions":4,"surahs":3,"hadiths":2,"category":"أسماء الألوهية","categoryOrder":53},{"id":51,"name":"خير الغافرين","compound":true,"excerpt":"حين يخطئ سفهاءُ قومك وتخشى أن يعمّ البلاء، قف موقف موسى: ﴿أَنْتَ وَلِيُّنَا فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الْغَافِرِينَ﴾.","positions":1,"surahs":1,"hadiths":1,"category":"أسماء الربوبية","categoryOrder":171},{"id":52,"name":"الواحد القهار","compound":true,"excerpt":"سؤال يوسف في سجنه هو سؤال الموقف الأعظم: أربابٌ متفرقون أم الواحد القهار؟ — أجب به اليوم بقلبك، وقلها إذا تعارّيت من الليل كما علّم النبي ﷺ.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":85},{"id":53,"name":"فالق الإصباح","compound":true,"excerpt":"الذي يشقّ ظلامَ الكون كلَّ فجرٍ قادرٌ أن يشقّ ظلامَ همّك — فقل مع كل فجر: هذا توقيع ﴿فَالِقُ الْإِصْبَاحِ﴾، ولليلي إصباح.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":28},{"id":54,"name":"رفيع الدرجات ذو العرش","compound":true,"excerpt":"ادعُ ﴿رَفِيعُ الدَّرَجَاتِ ذُو الْعَرْشِ﴾ بلا سقف — فدرجاتُ عظمته لا تتناهى، ودرجاتُ عطائه أوسع من أعلى طموحك.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":60},{"id":55,"name":"الحق","compound":false,"excerpt":"القسمة ثنائية لا ثالث لها: ﴿فَمَاذَا بَعْدَ الْحَقِّ إِلَّا الضَّلَالُ﴾ — فإذا سقطت الأسنادُ يومًا فاعلم: ﴿هُنَالِكَ الْوَلَايَةُ لِلَّهِ الْحَقِّ﴾.","positions":7,"surahs":5,"hadiths":2,"category":"أسماء الرحمانية","categoryOrder":105},{"id":56,"name":"الرحمن الرحيم","compound":true,"excerpt":"قبل أن يعرّفك بملكه ويوم دينه، عرّفك برحمته مثنّاة: ﴿الرَّحْمَنِ الرَّحِيمِ * مَالِكِ يَوْمِ الدِّينِ﴾ — فادخل على كل رهبةٍ في دينك من باب الرحمة.","positions":3,"surahs":3,"hadiths":7,"category":"أسماء الألوهية","categoryOrder":4},{"id":57,"name":"خير الرازقين","compound":true,"excerpt":"أنفق ولا تخف: ﴿وَمَا أَنْفَقْتُمْ مِنْ شَيْءٍ فَهُوَ يُخْلِفُهُ وَهُوَ خَيْرُ الرَّازِقِينَ﴾ — رازقٌ لا ينقطع عطاؤه حتى بعد موتك، فلا تبع صلاتك بقافلة.","positions":5,"surahs":5,"hadiths":2,"category":"أسماء الرحمانية","categoryOrder":111},{"id":58,"name":"الولي الحميد","compound":true,"excerpt":"توقيت الغيث مكتوب في الآية: ﴿مِنْ بَعْدِ مَا قَنَطُوا﴾ — فإذا بلغ يأسُك مداه، فأنت أقرب ما تكون إلى غيث الولي الحميد.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":20},{"id":59,"name":"الذي بيده الملك","compound":true,"excerpt":"افتتحت سورةُ نجاتك في قبرك باسمه: ﴿تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ﴾ — ومطلوبه منك واحد: ﴿أَيُّكُمْ أَحْسَنُ عَمَلًا﴾: أحسِن، ولا تشغلك الكثرة.","positions":1,"surahs":1,"hadiths":1,"category":"أسماء الألوهية","categoryOrder":73},{"id":60,"name":"الله المستعان على ما تصفون","compound":true,"excerpt":"حين يُحاك حولك كذبٌ بأدلةٍ مصنوعة، قل قول يعقوب: ﴿فَصَبْرٌ جَمِيلٌ وَاللَّهُ الْمُسْتَعَانُ عَلَى مَا تَصِفُونَ﴾ — فالقميص الذي شهد عليك زورًا، سيشهد لك نظيرُه صدقًا.","positions":1,"surahs":1,"hadiths":1,"category":"الأسماء الحسنى المرتبطة بأفعال","categoryOrder":291},{"id":61,"name":"الغني","compound":false,"excerpt":"المقابلة الفاصلة: ﴿وَاللَّهُ الْغَنِيُّ وَأَنْتُمُ الْفُقَرَاءُ﴾ — فكل ما يطلبه منك سدادٌ لفقرك أنت: من بخل بخل عن نفسه، ومن عمل عمل لنفسه.","positions":5,"surahs":5,"hadiths":1,"category":"أسماء الألوهية","categoryOrder":37},{"id":62,"name":"البر الرحيم","compound":true,"excerpt":"من دعاه في الرخاء مشفقًا، وجده عند العاقبة بَرًّا رحيمًا.","positions":1,"surahs":1,"hadiths":1,"category":"أسماء الألوهية","categoryOrder":7},{"id":63,"name":"أحسن الخالقين","compound":true,"excerpt":"كلما أبهرتك صنعةٌ — بشريةٌ أو كونية — فارفع النسبَ لأصله: ﴿فَتَبَارَكَ اللَّهُ أَحْسَنُ الْخَالِقِينَ﴾ — وأولُ معرضه أنت: من نطفةٍ إلى خلقٍ آخر.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":84},{"id":64,"name":"سريع الحساب","compound":true,"excerpt":"يحاسب الخلائق كلَّها كمحاسبة نفسٍ واحدة — بشارةً لمحسنٍ لا يتأخر أجرُه، ونذارةً لمسوِّفٍ يظن الحساب بعيدًا — فاسأله من اليوم: «اللهم حاسبني حسابًا يسيرًا».","positions":8,"surahs":7,"hadiths":4,"category":"أسماء الألوهية","categoryOrder":69},{"id":65,"name":"الهادي والنصير","compound":true,"excerpt":"إذا كثر خصومك بسبب حقٍّ تحمله، فأنت على سنة الأنبياء — ومعك زادُهم: ﴿وَكَفَى بِرَبِّكَ هَادِيًا وَنَصِيرًا﴾.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":173},{"id":66,"name":"الله الخالق البارئ المصور","compound":true,"excerpt":"ثلاث مراحل لوجودك: قدّرك الخالق، وأوجدك البارئ، وميّزك المصور — ثم قال: ﴿لَهُ الْأَسْمَاءُ الْحُسْنَى﴾: فاعرفها، وادعُه بها — فذلك مقصودُ الباب كله.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":14},{"id":67,"name":"البصير","compound":false,"excerpt":"يرى فضلَك ساعة الفراق، وإتقانَك في صنعتك، ونيتَك تحت مالك، وقلبَك ليلة حصارك — فاعمل لعينٍ لا تنام، واختم دعاءك بخاتمة موسى: ﴿إِنَّكَ كُنْتَ بِنَا بَصِيرًا﴾.","positions":23,"surahs":17,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":180},{"id":68,"name":"الرؤوف الرحيم","compound":true,"excerpt":"من رأفته: يحفظ عبادتك الماضية، ويتدارك قلبك عند الحافة، ويمسك السماء فوقك — فاسأله أثمنَ المطالب: ﴿وَلَا تَجْعَلْ فِي قُلُوبِنَا غِلًّا لِلَّذِينَ آمَنُوا رَبَّنَا إِنَّكَ رَءُوفٌ رَحِيمٌ﴾.","positions":8,"surahs":7,"hadiths":4,"category":"أسماء الرحمانية","categoryOrder":106},{"id":69,"name":"أسرع الحاسبين","compound":true,"excerpt":"تقبضك ملائكةٌ لا تفرّط، وتُرَدّ إلى مولًى لا يبطئ: ﴿أَلَا لَهُ الْحُكْمُ وَهُوَ أَسْرَعُ الْحَاسِبِينَ﴾ — فاجعله مولاك اليوم، يَهُن حسابُك غدًا.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":68},{"id":70,"name":"رب السماوات السبع ورب العرش العظيم","compound":true,"excerpt":"سيُقرّ الجميع: ﴿سَيَقُولُونَ لِلَّهِ﴾ — والسؤال الفاصل: ﴿أَفَلَا تَتَّقُونَ﴾ — فإن أقررتَ أن له السماوات السبع والعرش العظيم، فأعطِه لوازم إقرارك، وادعُه بها عند كل كرب.","positions":1,"surahs":1,"hadiths":3,"category":"أسماء الربوبية","categoryOrder":160},{"id":71,"name":"ذو الجلال والإكرام","compound":true,"excerpt":"كلُّ من عليها فان — فعلّق قلبك بالوجه الباقي، وألظّ بما أمرك نبيك: «يا ذا الجلال والإكرام» — جلالٌ تخشع له، وإكرامٌ تطمع فيه.","positions":2,"surahs":1,"hadiths":6,"category":"أسماء الربوبية","categoryOrder":190},{"id":72,"name":"الحكيم العليم","compound":true,"excerpt":"قالت سارة: عجوزٌ عقيم! فكان الجواب: ﴿كَذَلِكِ قَالَ رَبُّكِ إِنَّهُ هُوَ الْحَكِيمُ الْعَلِيمُ﴾ — فإذا استبعد الناسُ أمنيتك فتذكّر: التوقيت عند الحكيم، والإمكان عند العليم.","positions":7,"surahs":5,"hadiths":1,"category":"أسماء الرحمانية","categoryOrder":129},{"id":73,"name":"التواب الرحيم","compound":true,"excerpt":"توبتُه تسبق توبتك: لقّن آدمَ كلماتِه، وتاب على الثلاثة ليتوبوا — فإذا ضاقت عليك الأرض بما رحبت فالمخرج واحد: ﴿لَا مَلْجَأَ مِنَ اللَّهِ إِلَّا إِلَيْهِ﴾.","positions":9,"surahs":4,"hadiths":6,"category":"أسماء الرحمانية","categoryOrder":104},{"id":74,"name":"خير الناصرين","compound":true,"excerpt":"كل ناصرٍ سواه يطلب ثمنًا — وقد يكون الثمن دينَك: ﴿بَلِ اللَّهُ مَوْلَاكُمْ وَهُوَ خَيْرُ النَّاصِرِينَ﴾ — فلا تبع الولاء بنصرةٍ خاسرة.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":27},{"id":75,"name":"رب السماوات والأرض رب العرش","compound":true,"excerpt":"جوابُ كل وصفٍ باطل جملةٌ واحدة: ﴿سُبْحَانَ رَبِّ السَّمَاوَاتِ وَالْأَرْضِ رَبِّ الْعَرْشِ عَمَّا يَصِفُونَ﴾ — فاجعلها حاضرةً على لسانك.","positions":1,"surahs":1,"hadiths":1,"category":"أسماء الربوبية","categoryOrder":151},{"id":76,"name":"الرزاق ذو القوة المتين","compound":true,"excerpt":"كل سيدٍ في الأرض يطلب من عبيده — إلا هذا السيد: ﴿مَا أُرِيدُ مِنْهُمْ مِنْ رِزْقٍ... إِنَّ اللَّهَ هُوَ الرَّزَّاقُ ذُو الْقُوَّةِ الْمَتِينُ﴾ — فاعبده مطمئنًا: راتبُك على من خلقك.","positions":1,"surahs":1,"hadiths":1,"category":"أسماء الألوهية","categoryOrder":75},{"id":77,"name":"السميع العليم","compound":true,"excerpt":"حيث اجتمع قولٌ تنطقه ونيةٌ تخفيها، جاء الاسمان: يسمع ما قلت ويعلم ما قصدت — فاسأله القبول وأنت في وسط عملك: ﴿رَبَّنَا تَقَبَّلْ مِنَّا إِنَّكَ أَنْتَ السَّمِيعُ الْعَلِيمُ﴾.","positions":32,"surahs":17,"hadiths":9,"category":"أسماء الرحمانية","categoryOrder":117},{"id":78,"name":"الرحيم الودود","compound":true,"excerpt":"لستَ عائدًا إلى سيدٍ متجهم — بل إلى ﴿رَحِيمٌ وَدُودٌ﴾: يقبل توبتك ويحبك بعدها — فما الذي يؤخرك؟","positions":1,"surahs":1,"hadiths":1,"category":"أسماء الربوبية","categoryOrder":158},{"id":79,"name":"خير الفاصلين","compound":true,"excerpt":"لا تستعجل الفصلَ بجدول خصومك: ﴿إِنِ الْحُكْمُ إِلَّا لِلَّهِ يَقُصُّ الْحَقَّ وَهُوَ خَيْرُ الْفَاصِلِينَ﴾ — اثبت على بينتك ودع التوقيت له.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":21},{"id":80,"name":"رب العزة","compound":true,"excerpt":"العزةُ لها ربٌّ واحد يملكها: ﴿سُبْحَانَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُونَ﴾ — فمن أراد العزة فليطرق باب ربّها، لا أبواب مستعيريها.","positions":1,"surahs":1,"hadiths":9,"category":"أسماء الربوبية","categoryOrder":149},{"id":81,"name":"ذو رحمة واسعة","compound":true,"excerpt":"حتى المكذبُ يُخاطَب أولًا بـ﴿ذُو رَحْمَةٍ وَاسِعَةٍ﴾ — فلا تيأس من أحدٍ ولا من نفسك؛ واحذر الشقَّ الثاني: ﴿وَلَا يُرَدُّ بَأْسُهُ عَنِ الْقَوْمِ الْمُجْرِمِينَ﴾.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":163},{"id":82,"name":"نور السماوات والأرض","compound":true,"excerpt":"في قلبك زيتٌ يكاد يضيء — فطرتُك — فإذا مسّه نورُ الوحي صار ﴿نُورٌ عَلَى نُورٍ﴾: فاسأل نورَ السماوات والأرض أن يهديك لنوره.","positions":1,"surahs":1,"hadiths":5,"category":"أسماء الألوهية","categoryOrder":96},{"id":83,"name":"الخلاق العليم","compound":true,"excerpt":"خلقك وخلق من يؤذيك، وأحاط علمًا بكل شيء — ﴿فَاصْفَحِ الصَّفْحَ الْجَمِيلَ * إِنَّ رَبَّكَ هُوَ الْخَلَّاقُ الْعَلِيمُ﴾: اطوِ الأذى ودَع الحساب لخالق الجميع.","positions":2,"surahs":2,"hadiths":0,"category":"أسماء الرحمانية","categoryOrder":130},{"id":84,"name":"الحي القيوم","compound":true,"excerpt":"اسمان قيل إنهما الاسم الأعظم، وبهما افتُتحت أعظم آية — فاجعلهما ملاذك في كل كرب: «يَا حَيُّ يَا قَيُّومُ بِرَحْمَتِكَ أَسْتَغِيثُ».","positions":3,"surahs":3,"hadiths":8,"category":"أسماء الألوهية","categoryOrder":83},{"id":85,"name":"الغني الحميد","compound":true,"excerpt":"لو كفر أهلُ الأرض جميعًا ما نقص من حمده شيء — فقرُك إليه ذاتيٌّ وغناه عنك ذاتي: فأعطه طيبًا، واشكره لنفسك، واستعذ من كلمة ﴿وَاسْتَغْنَى اللَّهُ﴾.","positions":10,"surahs":9,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":59},{"id":86,"name":"القاهر فوق عباده","compound":true,"excerpt":"قاهرٌ يرسل على مقهوريه حفظة: ﴿وَهُوَ الْقَاهِرُ فَوْقَ عِبَادِهِ وَيُرْسِلُ عَلَيْكُمْ حَفَظَةً﴾ — أنت في قبضته وفي حراسته معًا: فاستسلم له طوعًا.","positions":2,"surahs":1,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":217},{"id":87,"name":"الحي الذي لا يموت","compound":true,"excerpt":"راجع قائمة من تعتمد عليهم: كلُّهم سيموتون — ﴿وَتَوَكَّلْ عَلَى الْحَيِّ الَّذِي لَا يَمُوتُ﴾: سندٌ واحدٌ لا ينهار أبدًا.","positions":1,"surahs":1,"hadiths":5,"category":"أسماء الألوهية","categoryOrder":61},{"id":88,"name":"بديع السماوات والأرض","compound":true,"excerpt":"أبدع الكونَ بلا مثالٍ سابق، وأمرُه ﴿كُنْ فَيَكُونُ﴾ — فلا تحصر فرَجَك في الأسباب المألوفة: البديعُ لا يحتاج نموذجًا ليصنع لك مخرجًا.","positions":2,"surahs":2,"hadiths":2,"category":"أسماء الألوهية","categoryOrder":86},{"id":89,"name":"الشاكر العليم","compound":true,"excerpt":"اقرأ السؤال الذي يصحح صورة ربك عندك: ﴿مَا يَفْعَلُ اللَّهُ بِعَذَابِكُمْ إِنْ شَكَرْتُمْ وَآمَنْتُمْ﴾ — لا يريد عذابك: يريد شكرك وإيمانك — وهو يشكرهما لك.","positions":2,"surahs":2,"hadiths":2,"category":"أسماء الألوهية","categoryOrder":35},{"id":90,"name":"الفتاح العليم","compound":true,"excerpt":"كل قضيةٍ عالقةٍ لم تجد فصلًا في الأرض لها موعدٌ مضمون: ﴿يَجْمَعُ بَيْنَنَا رَبُّنَا ثُمَّ يَفْتَحُ بَيْنَنَا بِالْحَقِّ وَهُوَ الْفَتَّاحُ الْعَلِيمُ﴾ — فأودعها عنده وامضِ خفيفًا.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":167},{"id":91,"name":"الغني ذو الرحمة","compound":true,"excerpt":"غنيٌّ عنك قادرٌ على أن يُذهبك ويستخلف غيرك — لكنه ﴿ذُو الرَّحْمَةِ﴾: فبقاؤك رحمةٌ ممنوحة، لا ضرورةً يحتاجها.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":161},{"id":92,"name":"فعال لما يريد","compound":true,"excerpt":"حُرق أصحاب الأخدود ولم يُنجَّوا — وخُتمت سورتهم بـ﴿فَعَّالٌ لِمَا يُرِيدُ﴾: ما جرى إرادةٌ نافذة عن حكمة، والفوزُ الكبير محفوظ.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":175},{"id":93,"name":"فالق الحب والنوى","compound":true,"excerpt":"الذي يشقّ الحبةَ اليابسة فيُخرج منها حياةً قادرٌ أن يشقّ يباسَ قلبك وحالك: ﴿يُخْرِجُ الْحَيَّ مِنَ الْمَيِّتِ﴾.","positions":1,"surahs":1,"hadiths":1,"category":"أسماء الألوهية","categoryOrder":29},{"id":94,"name":"جامع الناس ليوم لا ريب فيه","compound":true,"excerpt":"ختم الراسخون دعاء الثبات بيقين الجمع: ﴿إِنَّكَ جَامِعُ النَّاسِ لِيَوْمٍ لَا رَيْبَ فِيهِ﴾ — فمن أيقن بالموعد استقام في الطريق.","positions":1,"surahs":1,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":227},{"id":95,"name":"العليم الحكيم","compound":true,"excerpt":"توقيعُ المشرّع على كل حكمٍ يستشكله عقلك: ﴿وَاللَّهُ عَلِيمٌ حَكِيمٌ﴾ — لأن العلة علمٌ لا تملكه: ﴿لَا تَدْرُونَ أَيُّهُمْ أَقْرَبُ لَكُمْ نَفْعًا﴾.","positions":29,"surahs":13,"hadiths":6,"category":"أسماء الرحمانية","categoryOrder":119},{"id":96,"name":"الحميد المجيد","compound":true,"excerpt":"قالتها الملائكةُ لعجوزٍ عقيم بُشّرت بغلام: ﴿أَتَعْجَبِينَ مِنْ أَمْرِ اللَّهِ... إِنَّهُ حَمِيدٌ مَجِيدٌ﴾ — وأنت تختم بها صلاتك كل يوم.","positions":1,"surahs":1,"hadiths":5,"category":"أسماء الألوهية","categoryOrder":78},{"id":97,"name":"الغني الحليم","compound":true,"excerpt":"كلمةٌ طيبة وسترٌ خيرٌ من عطاءٍ يتبعه أذى — فالله غنيٌّ عن مالك، لكن كرامةَ الفقير عنده ليست رخيصة.","positions":1,"surahs":1,"hadiths":1,"category":"أسماء الألوهية","categoryOrder":58},{"id":98,"name":"سريع العقاب","compound":true,"excerpt":"لم يُذكر ﴿سَرِيعُ الْعِقَابِ﴾ في القرآن قط إلا ومعه ﴿لَغَفُورٌ رَحِيمٌ﴾ — فسِر بين الخوف والرجاء، ولا تفصل ما جمعه الله.","positions":2,"surahs":2,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":178},{"id":99,"name":"بيده ملكوت كل شيء","compound":true,"excerpt":"﴿وَهُوَ يُجِيرُ وَلَا يُجَارُ عَلَيْهِ﴾ — من استجار به سقطت عنه هيبةُ كل مخيف؛ وبيده ملكوت كل شيء وإليه ترجعون.","positions":2,"surahs":2,"hadiths":1,"category":"أسماء الألوهية","categoryOrder":63},{"id":100,"name":"الملك القدوس العزيز الحكيم","compound":true,"excerpt":"الكون كله يسبّح للملك القدوس العزيز الحكيم — ومهمةُ رسوله فيك تزكيةٌ من مقتضى قدسه: «زكِّها أنت خير من زكاها».","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":13},{"id":101,"name":"العليم الخبير","compound":true,"excerpt":"يعلم نية الوسيط، وأرض موتك، ومقدار تقوى القلوب — ﴿عَلِيمٌ خَبِيرٌ﴾: فسلّم له ما لا تعلم، واستُر ما علمت.","positions":4,"surahs":4,"hadiths":5,"category":"أسماء الألوهية","categoryOrder":26},{"id":103,"name":"الغني الكريم","compound":true,"excerpt":"قالها سليمانُ في ذروة الخارق: ﴿هَذَا مِنْ فَضْلِ رَبِّي لِيَبْلُوَنِي أَأَشْكُرُ أَمْ أَكْفُرُ﴾ — فالنعمة امتحان، والشكر لك، والجحود لا يضر ﴿غَنِيٌّ كَرِيمٌ﴾.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":170},{"id":104,"name":"شديد العقاب","compound":true,"excerpt":"شدةٌ لا تنزل إلا بعد بيانٍ وإمهال، وعلى دأبٍ لا زلة — ولم تُذكر في القرآن إلا محفوفةً بمغفرة: ﴿اعْلَمُوا أَنَّ اللَّهَ شَدِيدُ الْعِقَابِ وَأَنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾.","positions":13,"surahs":7,"hadiths":1,"category":"أسماء الرحمانية","categoryOrder":122},{"id":105,"name":"الله أحسن الخالقين","compound":true,"excerpt":"تأمّل رحلتك من سلالةٍ من طين إلى ﴿خَلْقًا آخَرَ﴾ يعقل ويشعر — ثم قل ما لا يملك المتأمل غيره: ﴿فَتَبَارَكَ اللَّهُ أَحْسَنُ الْخَالِقِينَ﴾.","positions":1,"surahs":1,"hadiths":3,"category":"أسماء الألوهية","categoryOrder":40},{"id":106,"name":"رب المشرق والمغرب وما بينهما","compound":true,"excerpt":"حين استهزأ فرعون نقل موسى الحجةَ إلى ما فوق رأسه: ﴿رَبُّ الْمَشْرِقِ وَالْمَغْرِبِ وَمَا بَيْنَهُمَا إِنْ كُنْتُمْ تَعْقِلُونَ﴾ — شروقٌ لا يملك أعظم طاغيةٍ تأخيره لحظة.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":140},{"id":107,"name":"العليم الحليم","compound":true,"excerpt":"يعلم نية الحيلة في وصيتك، وغيرةَ القلب في بيتك، وما يُرضيك في جنتك — ﴿عَلِيمٌ حَلِيمٌ﴾: علمٌ يكشف، وحلمٌ يمهل.","positions":3,"surahs":3,"hadiths":1,"category":"أسماء الألوهية","categoryOrder":18},{"id":108,"name":"العلي العظيم","compound":true,"excerpt":"بعد كل مظاهر العظمة في آية الكرسي جاءت الخلاصة: ﴿وَهُوَ الْعَلِيُّ الْعَظِيمُ﴾ — علوٌّ لا يبعده عنك، وعظمةٌ تصغّر كل ما تهابه.","positions":2,"surahs":2,"hadiths":9,"category":"أسماء الألوهية","categoryOrder":66},{"id":109,"name":"الحق المبين","compound":true,"excerpt":"يومَ تنطق ألسنتُهم وأيديهم وأرجلهم عليهم يعلمون اضطرارًا: ﴿أَنَّ اللَّهَ هُوَ الْحَقُّ الْمُبِينُ﴾ — فكل حقٍّ طُمس له موعد بيان.","positions":1,"surahs":1,"hadiths":2,"category":"أسماء الألوهية","categoryOrder":52},{"id":110,"name":"شديد العذاب","compound":true,"excerpt":"الشرك قد يدخل من باب الحب: ﴿يُحِبُّونَهُمْ كَحُبِّ اللَّهِ﴾ — وعلامتك: ﴿أَشَدُّ حُبًّا لِلَّهِ﴾؛ فاختبر قلبك حين تتعارض المحاب.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":10},{"id":111,"name":"الله العزيز الحميد","compound":true,"excerpt":"لم يجدوا عليهم جريمةً إلا واحدة: ﴿أَنْ يُؤْمِنُوا بِاللَّهِ الْعَزِيزِ الْحَمِيدِ﴾ — أشرفُ تهمةٍ وُجّهت لبشر.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":42},{"id":112,"name":"رب السماوات والأرض وما بينهما","compound":true,"excerpt":"ربُّ العوالم كلها — ومقتضى ذلك أمران: ﴿فَاعْبُدْهُ وَاصْطَبِرْ لِعِبَادَتِهِ﴾ — عبادةٌ ومصابرةٌ عليها، ﴿هَلْ تَعْلَمُ لَهُ سَمِيًّا﴾؟","positions":3,"surahs":3,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":145},{"id":113,"name":"العليم القدير","compound":true,"excerpt":"خُلقتَ من ضعفٍ وستعود إليه، وعِلمُك عاريةٌ تُستردّ — ﴿وَهُوَ الْعَلِيمُ الْقَدِيرُ﴾: فاستثمر لحظة القوة بين الضعفين.","positions":4,"surahs":4,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":45},{"id":114,"name":"العلي الكبير","compound":true,"excerpt":"فوق كل قوامٍ وصاحبِ سلطة: ﴿إِنَّ اللَّهَ كَانَ عَلِيًّا كَبِيرًا﴾ — فمن علا على من تحت يده، فليذكر من يعلوه.","positions":5,"surahs":5,"hadiths":2,"category":"أسماء الرحمانية","categoryOrder":125},{"id":115,"name":"خالق كل شيء","compound":true,"excerpt":"﴿خَالِقُ كُلِّ شَيْءٍ فَاعْبُدُوهُ﴾ — الفاء هي كل البرهان: من خلق كل شيءٍ استحق أن يُعبد وحده، وهو مع ذلك ﴿عَلَى كُلِّ شَيْءٍ وَكِيلٌ﴾.","positions":4,"surahs":4,"hadiths":1,"category":"أسماء الرحمانية","categoryOrder":112},{"id":116,"name":"رب الفلق","compound":true,"excerpt":"من ملك فلقَ الصبح من الليل ملك كشفَ كل شرٍّ مستور — ولذلك: ﴿قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ﴾ من كل ما يُضمر في الظلام.","positions":1,"surahs":1,"hadiths":10,"category":"أسماء الربوبية","categoryOrder":146},{"id":117,"name":"رب المشارق والمغارب","compound":true,"excerpt":"من يدبّر مشارق الشمس ومغاربها كل يومٍ بدقةٍ لا تختل، أقسم أنه ﴿لَقَادِرُونَ * عَلَى أَنْ نُبَدِّلَ خَيْرًا مِنْهُمْ﴾ — فلا تكن ممن يُستبدل.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":142},{"id":118,"name":"الرحمن المستعان على ما تصفون","compound":true,"excerpt":"حين تكثر الأوصاف الكاذبة عنك، فقل ما ختم به نبيك سورةَ الأنبياء: ﴿رَبِّ احْكُمْ بِالْحَقِّ وَرَبُّنَا الرَّحْمَنُ الْمُسْتَعَانُ عَلَى مَا تَصِفُونَ﴾.","positions":1,"surahs":1,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بأفعال","categoryOrder":292},{"id":119,"name":"القوي العزيز","compound":true,"excerpt":"النتيجة النهائية مكتوبةٌ ومختومة: ﴿كَتَبَ اللَّهُ لَأَغْلِبَنَّ أَنَا وَرُسُلِي إِنَّ اللَّهَ قَوِيٌّ عَزِيزٌ﴾ — فلا تحكم على المعركة من جولةٍ واحدة.","positions":7,"surahs":6,"hadiths":3,"category":"أسماء الرحمانية","categoryOrder":124},{"id":120,"name":"اللطيف الخبير","compound":true,"excerpt":"يأتي بحبة خردلٍ من جوف صخرة، ويُخضّر الأرض بقطراتٍ لا تُحسّ — ﴿أَلَا يَعْلَمُ مَنْ خَلَقَ وَهُوَ اللَّطِيفُ الْخَبِيرُ﴾: فما عجزتَ عن قوله يعلمه بلا كلام.","positions":5,"surahs":5,"hadiths":2,"category":"أسماء الرحمانية","categoryOrder":123},{"id":121,"name":"على كل شيء حسيب","compound":true,"excerpt":"حتى ردُّ السلام محسوب: ﴿فَحَيُّوا بِأَحْسَنَ مِنْهَا أَوْ رُدُّوهَا﴾ — فمن استهان بأصغر حقوق الناس فليتذكر: ﴿إِنَّ اللَّهَ كَانَ عَلَى كُلِّ شَيْءٍ حَسِيبًا﴾.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":32},{"id":122,"name":"عالم الغيب والشهادة الكبير المتعال","compound":true,"excerpt":"يعلم ما تحمل كل أنثى وما تغيض الأرحام وما تزداد — ﴿وَكُلُّ شَيْءٍ عِنْدَهُ بِمِقْدَارٍ﴾: فليس في حياتك تفصيلٌ واحد عشوائي.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":77},{"id":123,"name":"نعم المولى ونعم النصير","compound":true,"excerpt":"حين يتولى عنك الجميع، تبقى الجملة التي أثنى الله بها على نفسه: ﴿نِعْمَ الْمَوْلَى وَنِعْمَ النَّصِيرُ﴾ — فاعتصم به تُكفَ.","positions":3,"surahs":3,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":48},{"id":124,"name":"العزيز الحكيم","compound":true,"excerpt":"قوةٌ بلا حكمةٍ بطش، وحكمةٌ بلا قوةٍ عجز — وهو ﴿الْعَزِيزُ الْحَكِيمُ﴾: يفعل ما يشاء ولا يفعل إلا لغاية؛ فما فُتح لك فلا ممسك له، وما أُمسك عنك فلا مرسل له — وكلاهما عن حكمة.","positions":38,"surahs":20,"hadiths":8,"category":"أسماء الرحمانية","categoryOrder":114},{"id":125,"name":"الخبير البصير","compound":true,"excerpt":"لماذا ضُيّق عليك؟ الجواب في الآية: ﴿وَلَوْ بَسَطَ اللَّهُ الرِّزْقَ لِعِبَادِهِ لَبَغَوْا فِي الْأَرْضِ... إِنَّهُ بِعِبَادِهِ خَبِيرٌ بَصِيرٌ﴾ — تقديرٌ صادر عن معرفةٍ بك.","positions":5,"surahs":3,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":225},{"id":126,"name":"على كل شيء حفيظ","compound":true,"excerpt":"الشيطان بلا سلطان عليك، والمهددون لا يضرون الله شيئًا — ﴿إِنَّ رَبِّي عَلَى كُلِّ شَيْءٍ حَفِيظٌ﴾: حفظُ رعايةٍ لك وإحصاءٍ عليهم.","positions":2,"surahs":2,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":165},{"id":127,"name":"عالم الغيب والشهادة العزيز الرحيم","compound":true,"excerpt":"علمٌ يحيط، وعزةٌ تنفّذ، ورحمةٌ توجّه — ونتيجتُها: ﴿الَّذِي أَحْسَنَ كُلَّ شَيْءٍ خَلَقَهُ﴾: فما خُلق شيءٌ فيك إلا بإحسان.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":43},{"id":128,"name":"خير ثواباً وخير عقباً","compound":true,"excerpt":"حين سقط كل شيء ظهرت الحقيقة: ﴿هُنَالِكَ الْوَلَايَةُ لِلَّهِ الْحَقِّ هُوَ خَيْرٌ ثَوَابًا وَخَيْرٌ عُقْبًا﴾ — فراهن على الأفضل قبل أن تسقط الأسناد.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":87},{"id":129,"name":"العزيز الرحيم","compound":true,"excerpt":"لازمةٌ تكررت ثماني مراتٍ بعد كل مصرعٍ ونجاة: ﴿وَإِنَّ رَبَّكَ لَهُوَ الْعَزِيزُ الرَّحِيمُ﴾ — فالبحر الذي أغرق فرعون هو الذي أنجى موسى.","positions":12,"surahs":4,"hadiths":1,"category":"أسماء الرحمانية","categoryOrder":102},{"id":130,"name":"السميع البصير","compound":true,"excerpt":"امرأةٌ اشتكت زوجها في بيتٍ من بيوت المدينة فنزل: ﴿قَدْ سَمِعَ اللَّهُ﴾ — يُتلى إلى قيام الساعة؛ فلا تحقرنّ شكواك، ولا تنسَ القاعدة: ﴿لَيْسَ كَمِثْلِهِ شَيْءٌ وَهُوَ السَّمِيعُ الْبَصِيرُ﴾.","positions":10,"surahs":7,"hadiths":5,"category":"أسماء الألوهية","categoryOrder":50},{"id":131,"name":"على كل شيء مقتدر","compound":true,"excerpt":"ماءٌ فخضرةٌ فهشيمٌ تذروه الرياح — ذلك عمرُ الدنيا؛ ﴿وَالْبَاقِيَاتُ الصَّالِحَاتُ خَيْرٌ عِنْدَ رَبِّكَ ثَوَابًا وَخَيْرٌ أَمَلًا﴾.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":33},{"id":133,"name":"رب الناس ملك الناس إله الناس","compound":true,"excerpt":"ختم اللهُ المصحف باستعاذةٍ بثلاثة أسماء من عدوٍّ واحد صفتُه أنه «خنّاس» — ينسحب عند الذكر: فسلاحك جاهز.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الرحمانية","categoryOrder":134},{"id":134,"name":"العزيز الحميد","compound":true,"excerpt":"الطريق يُعرف بصاحبه: ﴿إِلَى صِرَاطِ الْعَزِيزِ الْحَمِيدِ﴾ — عزةٌ تحميك وحمدٌ يجذبك؛ وأشرفُ تهمةٍ أن تُنقم لأجل الإيمان به.","positions":2,"surahs":2,"hadiths":1,"category":"أسماء الربوبية","categoryOrder":166},{"id":135,"name":"السميع القريب","compound":true,"excerpt":"﴿إِنَّهُ سَمِيعٌ قَرِيبٌ﴾ — لا تحتاج صوتًا مرتفعًا ولا وسيطًا: سمعٌ يبلغه همسُك، وقربٌ يُلغي المسافة.","positions":1,"surahs":1,"hadiths":1,"category":"أسماء الربوبية","categoryOrder":182},{"id":136,"name":"على كل شيء وكيل","compound":true,"excerpt":"بلّغ ولا تحمل النتائج: ﴿إِنَّمَا أَنْتَ نَذِيرٌ وَاللَّهُ عَلَى كُلِّ شَيْءٍ وَكِيلٌ﴾ — فالمفاتيح كلها عند الوكيل لا عندك.","positions":3,"surahs":3,"hadiths":0,"category":"أسماء الرحمانية","categoryOrder":99},{"id":137,"name":"الأول والآخر والظاهر والباطن","compound":true,"excerpt":"أربعة أسماء تحيط بالزمان والمكان — وفسّرها نبيك: «ليس قبلك شيء، وليس بعدك شيء، وليس فوقك شيء، وليس دونك شيء» — فأين تذهب من إحاطته؟","positions":1,"surahs":1,"hadiths":2,"category":"أسماء الألوهية","categoryOrder":79},{"id":138,"name":"ذو مغفرة وذو عقاب أليم","compound":true,"excerpt":"ما قيل فيك قيل في الرسل قبلك — ﴿إِنَّ رَبَّكَ لَذُو مَغْفِرَةٍ وَذُو عِقَابٍ أَلِيمٍ﴾: فاصبر، ودَع الحساب لمالك الأمرين.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":191},{"id":139,"name":"العزيز الغفور","compound":true,"excerpt":"من عرفه خشيه: ﴿إِنَّمَا يَخْشَى اللَّهَ مِنْ عِبَادِهِ الْعُلَمَاءُ إِنَّ اللَّهَ عَزِيزٌ غَفُورٌ﴾ — خشيةٌ من عزته ورجاءٌ في مغفرته.","positions":2,"surahs":2,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":47},{"id":140,"name":"العفو القدير","compound":true,"excerpt":"العفو لا يُحمد إلا من قادر: ﴿فَإِنَّ اللَّهَ كَانَ عَفُوًّا قَدِيرًا﴾ — فإذا قدرتَ على من ظلمك فتلك ساعةُ التخلق باسمه.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":72},{"id":141,"name":"على كل شيء مقيت","compound":true,"excerpt":"كلُّ واسطةٍ تصنعها لك نصيبٌ من أثرها — حسنةً أو سيئة: ﴿وَكَانَ اللَّهُ عَلَى كُلِّ شَيْءٍ مُقِيتًا﴾ — فانظر لمن تشفع وفيمَ.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":16},{"id":142,"name":"الله فاطر السماوات والأرض جاعل الملائكة رسلاً أولي أجنحة","compound":true,"excerpt":"فطر العوالم وجعل الملائكة رسلًا بأجنحةٍ متفاوتة — ثم ترك البابَ مفتوحًا: ﴿يَزِيدُ فِي الْخَلْقِ مَا يَشَاءُ﴾: فلا تحصر قدرته فيما رأيت.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":94},{"id":143,"name":"العزيز الغفار","compound":true,"excerpt":"يدير الكونَ بتكويرٍ لا يختل ويغفر لأهله المتكرر من الذنوب: ﴿أَلَا هُوَ الْعَزِيزُ الْغَفَّارُ﴾ — قهرٌ يوقظ ومغفرةٌ تُرجّي.","positions":2,"surahs":2,"hadiths":1,"category":"أسماء الألوهية","categoryOrder":46},{"id":144,"name":"رب العالمين","compound":true,"excerpt":"أولُ وصفٍ في المصحف وآخرُ كلمةٍ بعد فصل القضاء: ﴿الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ﴾ — ربوبيةٌ تسع العالمين، فأسلِم لها كإبراهيم، وأعلنها كموسى، واستغنِ بها عن أجور الناس كالمرسلين.","positions":26,"surahs":13,"hadiths":34,"category":"أسماء الربوبية","categoryOrder":138},{"id":145,"name":"على كل شيء قدير","compound":true,"excerpt":"قدرةٌ لا يحدّها موضوع: البديلُ مضمون لما نُسخ، والفرجُ ممكنٌ حيث انتهت قدرتك، وإحياءُ الأرض كل عامٍ برهانٌ يتجدد — و﴿رَبَّنَا أَتْمِمْ لَنَا نُورَنَا... إِنَّكَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾.","positions":35,"surahs":24,"hadiths":25,"category":"أسماء الرحمانية","categoryOrder":98},{"id":146,"name":"الله العزيز العليم غافر الذنب وقابل التوب شديد العقاب ذي الطول","compound":true,"excerpt":"أدقُّ عرضٍ مختصر لمن تعبد: ﴿غَافِرِ الذَّنْبِ وَقَابِلِ التَّوْبِ شَدِيدِ الْعِقَابِ ذِي الطَّوْلِ﴾ — شدةٌ محفوفةٌ بمغفرتين وفضل.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":93},{"id":147,"name":"العزيز المقتدر","compound":true,"excerpt":"لم يقل «أخذناهم» فحسب بل ﴿أَخْذَ عَزِيزٍ مُقْتَدِرٍ﴾ — أخذٌ لا إفلات منه ولا إعجاز: ﴿فَهَلْ مِنْ مُدَّكِرٍ﴾؟","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الرحمانية","categoryOrder":118},{"id":148,"name":"الله رب العرش","compound":true,"excerpt":"انتظامُ الكون برهانُ وحدانية مدبّره: ﴿لَوْ كَانَ فِيهِمَا آلِهَةٌ إِلَّا اللَّهُ لَفَسَدَتَا﴾ — فسبحان الله رب العرش عما يصفون.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الرحمانية","categoryOrder":115},{"id":149,"name":"على كل شيء رقيب","compound":true,"excerpt":"رقابةٌ تسبق الفعل إلى الخاطر: ﴿وَلَوْ أَعْجَبَكَ حُسْنُهُنَّ... وَكَانَ اللَّهُ عَلَى كُلِّ شَيْءٍ رَقِيبًا﴾.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":15},{"id":150,"name":"الغفور الودود ذو العرش المجيد فعال لما يريد","compound":true,"excerpt":"بعد أشد مشهد تعذيبٍ في القرآن جاءت الأسماء: ﴿الْغَفُورُ الْوَدُودُ * ذُو الْعَرْشِ الْمَجِيدُ * فَعَّالٌ لِمَا يُرِيدُ﴾ — بطشٌ بالظالم، وودٌّ بالمبتلى، وإرادةٌ نافذة لحكمة.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":192},{"id":151,"name":"العزيز الوهاب","compound":true,"excerpt":"من اعترض على قسمة الله يُسأل: ﴿أَمْ عِنْدَهُمْ خَزَائِنُ رَحْمَةِ رَبِّكَ الْعَزِيزِ الْوَهَّابِ﴾؟ — الخزائن ليست بيدك، لكنك تملك أن تسأل الوهّاب.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":181},{"id":152,"name":"رب العرش العظيم","compound":true,"excerpt":"إن تولّى عنك الناس فلديك خاتمة التوبة: ﴿حَسْبِيَ اللَّهُ لَا إِلَهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ﴾.","positions":2,"surahs":2,"hadiths":7,"category":"أسماء الربوبية","categoryOrder":154},{"id":153,"name":"على كل شيء شهيد","compound":true,"excerpt":"﴿أَحْصَاهُ اللَّهُ وَنَسُوهُ﴾ — ما نسيتَه محفوظٌ عند شهيدٍ لا يغيب: فأوفِ بما عقدت في الخفاء، واستغفر لما لا تذكر.","positions":8,"surahs":8,"hadiths":1,"category":"أسماء الرحمانية","categoryOrder":108},{"id":154,"name":"الملك القدوس السلام المؤمن المهيمن العزيز الجبار المتكبر","compound":true,"excerpt":"ثمانية أسماء في آية — ومنها «الجبار» بوجهيه: يقهر من كسرك، ويجبر ما انكسر فيك — فقل في سجودك: «اللهم اجبرني».","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":92},{"id":155,"name":"الواسع الحكيم","compound":true,"excerpt":"لمن انتهت علاقته: ﴿وَإِنْ يَتَفَرَّقَا يُغْنِ اللَّهُ كُلًّا مِنْ سَعَتِهِ﴾ — سعةٌ تكفي الطرفين، فلا أحد يخرج خاسرًا.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":57},{"id":156,"name":"رب العرش الكريم","compound":true,"excerpt":"﴿أَفَحَسِبْتُمْ أَنَّمَا خَلَقْنَاكُمْ عَبَثًا﴾ — لست صدفة: خلقك ملكٌ حقٌّ ربُّ العرش الكريم لغايةٍ ومرجع.","positions":1,"surahs":1,"hadiths":1,"category":"أسماء الربوبية","categoryOrder":155},{"id":157,"name":"بكل شيء بصير","compound":true,"excerpt":"ارفع رأسك إلى طيرٍ يحلّق: ﴿مَا يُمْسِكُهُنَّ إِلَّا الرَّحْمَنُ إِنَّهُ بِكُلِّ شَيْءٍ بَصِيرٌ﴾ — ما تسميه قانونًا هو إمساكُ رحمن.","positions":1,"surahs":1,"hadiths":1,"category":"أسماء الرحمانية","categoryOrder":107},{"id":158,"name":"الله رب العالمين الرحمن الرحيم مالك يوم الدين","compound":true,"excerpt":"ترتيبٌ تقرؤه سبع عشرة مرةً يوميًّا: ربٌّ للعالمين، فرحمةٌ مثناة، فملكُ يوم الدين — ثم ﴿إِيَّاكَ نَعْبُدُ﴾: معرفةٌ مكتملة تسبق العبادة.","positions":1,"surahs":1,"hadiths":1,"category":"أسماء الرحمانية","categoryOrder":135},{"id":159,"name":"التواب الحكيم","compound":true,"excerpt":"في أعقد أزمةٍ أسرية شُرع مخرجٌ يحفظ الحقوق ويكل السرائر إلى ﴿تَوَّابٌ حَكِيمٌ﴾ — يقبل من رجع، ويضع كل أمرٍ موضعه.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":71},{"id":160,"name":"العزيز العليم","compound":true,"excerpt":"ثلاثُ مراتٍ تتكرر: ﴿ذَلِكَ تَقْدِيرُ الْعَزِيزِ الْعَلِيمِ﴾ — فالشمس والقمر والليل والنهار تقديرٌ لا صدفة؛ وحتى الشمس تجري لمستقر.","positions":5,"surahs":5,"hadiths":1,"category":"أسماء الرحمانية","categoryOrder":120},{"id":161,"name":"بكل شيء عليم","compound":true,"excerpt":"لا مجلسَ سريًّا في الوجود: و﴿مَا يَكُونُ مِنْ نَجْوَى ثَلَاثَةٍ إِلَّا هُوَ رَابِعُهُمْ﴾ — وهو توقيعُ المشرّع على كل حكمٍ دقيق: يعلم كل حالةٍ وما يصلح لها.","positions":20,"surahs":15,"hadiths":1,"category":"أسماء الألوهية","categoryOrder":24},{"id":162,"name":"الله الواحد القهار رب السماوات والأرض وما بينهما العزيز الغفار","compound":true,"excerpt":"إذا استيقظتَ من الليل فقل ما كان يقوله نبيك: «لا إله إلا الله الواحد القهار رب السماوات والأرض وما بينهما العزيز الغفار» — قهرٌ يوقظ ومغفرةٌ تُرجّي.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الرحمانية","categoryOrder":132},{"id":163,"name":"العلي الحكيم","compound":true,"excerpt":"﴿وَمَا كَانَ لِبَشَرٍ أَنْ يُكَلِّمَهُ اللَّهُ إِلَّا وَحْيًا أَوْ مِنْ وَرَاءِ حِجَابٍ أَوْ يُرْسِلَ رَسُولًا﴾ — ثلاثُ طرقٍ محصورة عن عليٍّ حكيم: فاحذر كل دعوى خارجها.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":88},{"id":164,"name":"الواسع العليم","compound":true,"excerpt":"خزائنُه لا تُقسّم: عطاؤه لغيرك لا ينقص عطاءك — ﴿وَاللَّهُ وَاسِعٌ عَلِيمٌ﴾؛ فأنفق ولا تسمع من يعدك الفقر، وتزوّج ولا تخف.","positions":7,"surahs":4,"hadiths":1,"category":"أسماء الألوهية","categoryOrder":34},{"id":165,"name":"بكل شيء محيط","compound":true,"excerpt":"لا تفلت من محيطٍ أحاط بكل شيء: ﴿أَلَا إِنَّهُ بِكُلِّ شَيْءٍ مُحِيطٌ﴾ — فأدِّ الحقوق التي لا يحصيها أحد.","positions":2,"surahs":2,"hadiths":0,"category":"أسماء الرحمانية","categoryOrder":109},{"id":166,"name":"الذي له ملك السماوات والأرض وما بينهما وعنده علم الساعة","compound":true,"excerpt":"له الملك كله، وعنده وحده علم الساعة، وإليه المرجع — فمن حدّد موعدها فقد ادّعى ما ليس له.","positions":1,"surahs":1,"hadiths":0,"category":"فئة «له» و«لله»","categoryOrder":354},{"id":167,"name":"رب العرش","compound":true,"excerpt":"كلما هالك عرشٌ في الأرض فقس عليه: ﴿وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ﴾ — ومن كان حسبُه ربَّ العرش لم يعبأ بمن أعرض.","positions":0,"surahs":0,"hadiths":2,"category":"أسماء الربوبية","categoryOrder":153},{"id":168,"name":"فاطر السماوات والأرض","compound":true,"excerpt":"نادِ من فطر السماوات والأرض على غير مثال: هو معيار الولي، وهو من يُفصل عنده الخلاف — وبه استفتح نبيك قيامه.","positions":4,"surahs":4,"hadiths":1,"category":"أسماء الرحمانية","categoryOrder":100},{"id":169,"name":"رب هذا البيت","compound":true,"excerpt":"أُطعمتَ من جوعٍ وأُمنتَ من خوف — فما الذي يبقى؟ ﴿فَلْيَعْبُدُوا رَبَّ هَذَا الْبَيْتِ﴾.","positions":1,"surahs":1,"hadiths":6,"category":"أسماء الربوبية","categoryOrder":150},{"id":170,"name":"قريب مجيب","compound":true,"excerpt":"﴿إِنَّ رَبِّي قَرِيبٌ مُجِيبٌ﴾ — قربٌ بلا مسافة وإجابةٌ بلا وسيط: فاستغفره وتب إليه وأنت تعمر أرضه.","positions":1,"surahs":1,"hadiths":1,"category":"أسماء الربوبية","categoryOrder":179},{"id":171,"name":"بكل خلق عليم","compound":true,"excerpt":"نسي نشأته وسأل: من يحيي العظام؟ فجاء الجواب: ﴿يُحْيِيهَا الَّذِي أَنْشَأَهَا أَوَّلَ مَرَّةٍ وَهُوَ بِكُلِّ خَلْقٍ عَلِيمٌ﴾.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":25},{"id":172,"name":"الله رب السماوات ورب الأرض رب العالمين","compound":true,"excerpt":"ثلاثُ ربوبيات في نفَسٍ واحد — والحمدُ يقابلها: ﴿فَلِلَّهِ الْحَمْدُ رَبِّ السَّمَاوَاتِ وَرَبِّ الْأَرْضِ رَبِّ الْعَالَمِينَ﴾.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الرحمانية","categoryOrder":133},{"id":173,"name":"خير الماكرين","compound":true,"excerpt":"بينما يخططون ضدك، التدبيرُ الأعلى يعمل في اللحظة نفسها: ﴿وَيَمْكُرُونَ وَيَمْكُرُ اللَّهُ وَاللَّهُ خَيْرُ الْمَاكِرِينَ﴾.","positions":2,"surahs":2,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":67},{"id":174,"name":"رب المشرق والمغرب","compound":true,"excerpt":"من ملك المشرق والمغرب يستحق أمرين: انقطاعك إليه، وتوكيلك له — ﴿فَاتَّخِذْهُ وَكِيلًا﴾.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":139},{"id":175,"name":"رب السماوات والأرض وما بينهما الرحمن","compound":true,"excerpt":"يومٌ لا يُملك فيه خطاب — وشرطُ الكلام فيه: ﴿إِلَّا مَنْ أَذِنَ لَهُ الرَّحْمَنُ وَقَالَ صَوَابًا﴾: فدرّب لسانك على الصواب.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":164},{"id":176,"name":"رب المشرقين ورب المغربين","compound":true,"excerpt":"حتى تغيّرُ مشرق الشمس بين الشتاء والصيف نعمةٌ تُعدّ: ﴿رَبُّ الْمَشْرِقَيْنِ وَرَبُّ الْمَغْرِبَيْنِ * فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ﴾.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":141},{"id":177,"name":"رب السماوات والأرض","compound":true,"excerpt":"إعلانُ الانتماء الأول عند كل مواجهة: ﴿رَبُّنَا رَبُّ السَّمَاوَاتِ وَالْأَرْضِ لَنْ نَدْعُوَ مِنْ دُونِهِ إِلَهًا﴾ — وقبله ربطٌ على القلب: فاسأله قبل أن تقوم.","positions":4,"surahs":4,"hadiths":4,"category":"أسماء الربوبية","categoryOrder":144},{"id":178,"name":"رب السماوات والأرض وما بينهما ورب المشارق","compound":true,"excerpt":"إلهٌ واحد وتدبيرٌ متجدد: ﴿رَبُّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ الْمَشَارِقِ﴾ — كل يومٍ مشرقٌ جديد من ربٍّ واحد.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":143},{"id":179,"name":"رب هذه البلدة","compound":true,"excerpt":"حرمةُ البلدة من ربها لا من حجارتها: ﴿رَبَّ هَذِهِ الْبَلْدَةِ الَّذِي حَرَّمَهَا وَلَهُ كُلُّ شَيْءٍ﴾ — تشريفٌ للمكان بنسبته إليه.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":147},{"id":180,"name":"الكريم","compound":false,"excerpt":"أرقُّ عتابٍ في القرآن: ﴿مَا غَرَّكَ بِرَبِّكَ الْكَرِيمِ﴾ — عاتبك بكرمه لا بسلطانه، فأيُّهما أدعى للحياء؟","positions":1,"surahs":1,"hadiths":8,"category":"أسماء الربوبية","categoryOrder":188},{"id":181,"name":"الحي","compound":false,"excerpt":"﴿هُوَ الْحَيُّ لَا إِلَهَ إِلَّا هُوَ فَادْعُوهُ مُخْلِصِينَ لَهُ الدِّينَ﴾ — الفاء برهان: الدعاء لا يليق إلا بحيٍّ لا يموت.","positions":1,"surahs":1,"hadiths":5,"category":"أسماء الألوهية","categoryOrder":38},{"id":182,"name":"الرقيب","compound":false,"excerpt":"أول ما قُرن بالأرحام: ﴿إِنَّ اللَّهَ كَانَ عَلَيْكُمْ رَقِيبًا﴾ — فقطيعةُ الرحم تقع بصمتٍ لا يحاسب عليه أحد إلا الرقيب.","positions":2,"surahs":2,"hadiths":1,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":268},{"id":183,"name":"الغفور","compound":false,"excerpt":"بعد أشقّ التكاليف — برّ الوالدين — جاء المخرج: ﴿فَإِنَّهُ كَانَ لِلْأَوَّابِينَ غَفُورًا﴾: كن أوّابًا رجّاعًا يُغفر تقصيرك.","positions":1,"surahs":1,"hadiths":1,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":243},{"id":184,"name":"الوكيل","compound":false,"excerpt":"﴿فَاتَّخِذْهُ وَكِيلًا﴾ — أمرٌ لا انتظارُ شعور: وكّل من يملك كل شيء، ثم دع أذاهم وأعرض؛ ﴿وَكَفَى بِاللَّهِ وَكِيلًا﴾.","positions":10,"surahs":6,"hadiths":0,"category":"أسماء الرحمانية","categoryOrder":128},{"id":185,"name":"الأكرم","compound":false,"excerpt":"أولُ ما نزل: ﴿اقْرَأْ وَرَبُّكَ الْأَكْرَمُ﴾ — قيل لأمّي فصار أمةَ اقرأ: فأعظمُ كرمه أن ﴿عَلَّمَ الْإِنْسَانَ مَا لَمْ يَعْلَمْ﴾.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":187},{"id":186,"name":"القريب","compound":false,"excerpt":"سألوا عنه فأجاب بنفسه بلا واسطة: ﴿فَإِنِّي قَرِيبٌ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ﴾ — وشرطُ الإجابة أن تستجيب له.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":189},{"id":187,"name":"عالم الغيب","compound":true,"excerpt":"﴿عَالِمُ الْغَيْبِ فَلَا يُظْهِرُ عَلَى غَيْبِهِ أَحَدًا﴾ — بابٌ مغلق إلا بوحيٍ لرسول؛ فكلُّ مدّعٍ للغيب بعد خاتم الرسل كاذب.","positions":2,"surahs":2,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":169},{"id":188,"name":"نعم الوكيل","compound":true,"excerpt":"قيل لهم ﴿إِنَّ النَّاسَ قَدْ جَمَعُوا لَكُمْ فَاخْشَوْهُمْ﴾ فزادهم إيمانًا وقالوا كلمةً واحدة: «حسبنا الله ونعم الوكيل» — فانقلبوا بنعمةٍ لم يمسسهم سوء.","positions":1,"surahs":1,"hadiths":4,"category":"أسماء الألوهية","categoryOrder":82},{"id":189,"name":"عليم بذات الصدور","compound":true,"excerpt":"«ذات الصدور» ما لم تنطق به قط — ويعلمه: ﴿أَلَا يَعْلَمُ مَنْ خَلَقَ﴾؟ فأصلح ما لا يراه أحد.","positions":12,"surahs":11,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":221},{"id":190,"name":"الله بصير بالعباد","compound":true,"excerpt":"قالها رجلٌ وحيد في وجه فرعون فنجا: ﴿وَأُفَوِّضُ أَمْرِي إِلَى اللَّهِ إِنَّ اللَّهَ بَصِيرٌ بِالْعِبَادِ﴾ — يراك ويرى ما يُدبَّر لك.","positions":3,"surahs":2,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":214},{"id":191,"name":"لطيف لما يشاء","compound":true,"excerpt":"بعد الجبّ والرقّ والسجن قال يوسف: ﴿إِنَّ رَبِّي لَطِيفٌ لِمَا يَشَاءُ﴾ — فاللطف يُرى عند اكتمال الصورة، لا في منتصفها.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الربوبية","categoryOrder":177},{"id":192,"name":"ذو فضل على العالمين","compound":true,"excerpt":"لولا التدافع لفسدت الأرض — فوجودُ من يقاوم الظلم ﴿فَضْلٍ عَلَى الْعَالَمِينَ﴾: نعمةٌ تعمّ البشرية كلها.","positions":1,"surahs":1,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":213},{"id":193,"name":"عالم الغيب والشهادة","compound":true,"excerpt":"لا زاوية مظلمة في حياتك: ما غاب وما شُهد عنده سواء — فمن عاش بوجهين سيُردّ إلى من يعلم الوجهين.","positions":6,"surahs":5,"hadiths":2,"category":"أسماء الألوهية","categoryOrder":44},{"id":194,"name":"شكور حليم عالم الغيب والشهادة العزيز الحكيم","compound":true,"excerpt":"الغنيُّ يسمّي عطاءك «قرضًا» ويردّه مضاعفًا مع مغفرة، ويعلم ما أخفيت منه، وينفّذ وعده بعزةٍ وحكمة — ﴿وَاللَّهُ شَكُورٌ حَلِيمٌ * عَالِمُ الْغَيْبِ وَالشَّهَادَةِ الْعَزِيزُ الْحَكِيمُ﴾: فأقرض من ماله تربح.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":95},{"id":195,"name":"عالم غيب السماوات والأرض","compound":true,"excerpt":"﴿إِنَّ اللَّهَ عَالِمُ غَيْبِ السَّمَاوَاتِ وَالْأَرْضِ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ﴾ — يعلم إن كان وعدُك لنفسك صادقًا: فابدأ الآن.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":76},{"id":196,"name":"فاطر السماوات والأرض عالم الغيب والشهادة","compound":true,"excerpt":"حين يستعصي الحق على الحوار، ارفع الأمر إلى من فطر وعلم: ﴿أَنْتَ تَحْكُمُ بَيْنَ عِبَادِكَ فِي مَا كَانُوا فِيهِ يَخْتَلِفُونَ﴾ — «اهدني لما اختُلف فيه من الحق بإذنك».","positions":1,"surahs":1,"hadiths":4,"category":"أسماء الألوهية","categoryOrder":49},{"id":197,"name":"كفى بالله وكيلاً","compound":true,"excerpt":"أعرض عن الكيد ودع الأذى وتوكل — فالذي له ما في السماوات وما في الأرض يكفيك وكيلًا.","positions":5,"surahs":2,"hadiths":1,"category":"أسماء الكفاية — الرحمانية","categoryOrder":199},{"id":198,"name":"إليه المصير","compound":true,"excerpt":"كل طريق ينتهي إليه؛ فاجعل عملك مما يحسن أن تلقاه به.","positions":4,"surahs":4,"hadiths":1,"category":"فئة «إليه» و«إلى الله»","categoryOrder":410},{"id":199,"name":"عنده مفاتح الغيب","compound":true,"excerpt":"ما يخفيه الغد مفتاحه عند الله وحده؛ فاطمئن لعلمه، ولا تطلبه من غيره.","positions":1,"surahs":1,"hadiths":1,"category":"فئة «عنده»","categoryOrder":403},{"id":200,"name":"أعلم بالمهتدين","compound":true,"excerpt":"ادعُ بالحكمة وأحسن الجدال، ثم دع الهداية لمن هو أعلم بالمهتدين.","positions":4,"surahs":4,"hadiths":1,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":237},{"id":201,"name":"بيده الخير","compound":true,"excerpt":"الملك يؤتى وينزع، والعز يتبدّل، والخير ثابت في يده؛ فاطلبه منه.","positions":1,"surahs":1,"hadiths":2,"category":"أسماء الألوهية","categoryOrder":70},{"id":202,"name":"له مقاليد السماوات والأرض","compound":true,"excerpt":"المفاتيح كلها عنده؛ فاسأل من يملك المفتاح قبل أن تطرق الباب.","positions":2,"surahs":2,"hadiths":0,"category":"فئة «له» و«لله»","categoryOrder":370},{"id":203,"name":"لطيف بعباده","compound":true,"excerpt":"رزقه يصل بلطف من حيث لا تحتسب، وقوته تضمن أنه لا يعجز عن إيصاله.","positions":1,"surahs":1,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":219},{"id":204,"name":"ربهما","compound":false,"excerpt":"ربّ الأسرة واحد: يعاتب الزوجين ليتوبا، ويُدعى للولد، ويبدل الوالدين خيرًا مما فقدا.","positions":3,"surahs":2,"hadiths":0,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":209},{"id":205,"name":"ما الله بغافل عما تعملون / ما ربك بغافل عما تعملون / ما الله بغافل عما يعملون / ما ربك بغافل عما يعملون","compound":true,"excerpt":"لا يضيع عندك عمل: لا قسوة قلب ولا كتمان ولا طاعة خفية؛ فاعمل على علمٍ بأنه يرى.","positions":9,"surahs":5,"hadiths":0,"category":"الأسماء المنفية","categoryOrder":342},{"id":206,"name":"حسبنا الله / حسبي الله / حسبك الله / فهو حسبه","compound":true,"excerpt":"كلمة القلب حين يُخوَّف أو يُخدع أو يُترك: الله يكفيني.","positions":7,"surahs":5,"hadiths":2,"category":"الأسماء الحسنى المرتبطة بمفاعيل","categoryOrder":285},{"id":207,"name":"إلهٌ واحدٌ","compound":true,"excerpt":"إلهك واحد؛ فاجعل قصدك واحدًا وعملك له وحده.","positions":11,"surahs":10,"hadiths":1,"category":"أسماء الألوهية","categoryOrder":2},{"id":208,"name":"الله غالبٌ على أمره","compound":true,"excerpt":"ما دبّروه ليوسف كان طريق تمكينه؛ فأمر الله غالب.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":9},{"id":209,"name":"بيده الفضل / الفضل بيد الله","compound":true,"excerpt":"لا يُحتكر الفضل ولا يُنتزع؛ هو بيد الله يؤتيه من يشاء.","positions":2,"surahs":2,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":51},{"id":210,"name":"الذي بيده ملكوت كل شيء","compound":true,"excerpt":"من بيده ملكوت كل شيء لا يعجزه أن يعيدك؛ وإليه ترجع.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":62},{"id":211,"name":"قوي شديد العقاب","compound":true,"excerpt":"أخذ الأمم بذنوبها؛ فقوته وشدة عقابه تمنعك من الأمن.","positions":2,"surahs":2,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":74},{"id":212,"name":"الله أسرع مكرًا","compound":true,"excerpt":"من مكر بآيات الله بعد رحمته فالله أسرع مكرًا، ومكره مكتوب.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":81},{"id":213,"name":"الله أشد بأسًا وأشد تنكيلًا","compound":true,"excerpt":"بأس العدو محدود، وبأس الله أشد؛ فقم بما كُلّفت.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":90},{"id":214,"name":"الله خير وأبقى","compound":true,"excerpt":"قالها من هُدّد بالصلب: ما عند الله خير وأبقى من كل وعدٍ ووعيد.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الألوهية","categoryOrder":91},{"id":217,"name":"رحيم","compound":false,"excerpt":"نهيه رحمة، وتسخيره رحمة، وهدايته رحمة.","positions":3,"surahs":3,"hadiths":1,"category":"أسماء الرحمانية","categoryOrder":136},{"id":219,"name":"كفى بالله حسيباً","compound":true,"excerpt":"الأمانة والبلاغ تحت حساب الله؛ وكفى به حسيبًا.","positions":2,"surahs":2,"hadiths":0,"category":"أسماء الكفاية — الألوهية","categoryOrder":193},{"id":220,"name":"كفى بالله وليًا","compound":true,"excerpt":"من كان الله وليه لم يضره كيد أعدائه.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الكفاية — الألوهية","categoryOrder":194},{"id":221,"name":"كفى بالله نصيرًا","compound":true,"excerpt":"إذا قلّ الناصرون فالله وحده نصير.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الكفاية — الألوهية","categoryOrder":195},{"id":222,"name":"كفى بالله عليماً","compound":true,"excerpt":"صحبة الصالحين فضل من الله، وهو أعلم بمن يستحقها.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الكفاية — الألوهية","categoryOrder":196},{"id":223,"name":"كفى بالله شهيداً","compound":true,"excerpt":"إذا كذّبك الناس فشهادة الله بينك وبينهم تكفي.","positions":6,"surahs":5,"hadiths":0,"category":"أسماء الكفاية — الألوهية","categoryOrder":197},{"id":224,"name":"كفى بربك هادياً ونصيراً","compound":true,"excerpt":"العداوة سنة، والهداية والنصر من ربك.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الكفاية — الربوبية","categoryOrder":198},{"id":225,"name":"كفى بربك وكيلاً","compound":true,"excerpt":"عباد الله ليس للشيطان عليهم سلطان، وربهم وكيلهم.","positions":1,"surahs":1,"hadiths":0,"category":"أسماء الكفاية — الرحمانية","categoryOrder":200},{"id":226,"name":"ليس بظلام للعبيد / ما ربك بظلام للعبيد / ما أنا بظلام للعبيد","compound":true,"excerpt":"كل جزاء بما قدّمت يداك، وربك ليس بظلام للعبيد.","positions":5,"surahs":5,"hadiths":1,"category":"الأسماء المنفية","categoryOrder":341},{"id":227,"name":"وما كان ربك نسيًّا","compound":true,"excerpt":"إبطاء ما تنتظر ليس نسيانًا؛ ربك لا ينسى.","positions":1,"surahs":1,"hadiths":2,"category":"الأسماء المنفية","categoryOrder":343},{"id":228,"name":"لا تحسبن الله غافلًا عما يعمل الظالمون","compound":true,"excerpt":"إمهال الظالم ليس غفلة؛ إنما يؤخره ليوم تشخص فيه الأبصار.","positions":1,"surahs":1,"hadiths":0,"category":"الأسماء المنفية","categoryOrder":344},{"id":229,"name":"ما كان الله معذبهم وهم يستغفرون","compound":true,"excerpt":"الاستغفار أمان من العذاب ما دام العبد مستغفرًا.","positions":1,"surahs":1,"hadiths":2,"category":"الأسماء المنفية","categoryOrder":345},{"id":230,"name":"لم يكن ربك مهلك القرى بظلم وأهلها غافلون","compound":true,"excerpt":"لا هلاك قبل إنذار؛ وهذا من عدله.","positions":1,"surahs":1,"hadiths":0,"category":"الأسماء المنفية","categoryOrder":346},{"id":231,"name":"ما كان ربك مهلك القرى حتى يبعث في أمها رسولًا يتلو عليهم آياتنا","compound":true,"excerpt":"الهلاك لا يأتي إلا بعد رسول وظلم؛ فاحذر بطر النعمة.","positions":1,"surahs":1,"hadiths":0,"category":"الأسماء المنفية","categoryOrder":347},{"id":232,"name":"ما كنت متخذ المضلين عضدًا","compound":true,"excerpt":"من لم يشهد الخلق ولم يُعِن عليه، كيف يُتخذ وليًّا من دون الله؟","positions":1,"surahs":1,"hadiths":0,"category":"الأسماء المنفية","categoryOrder":348},{"id":233,"name":"لا تحسبن الله مخلف وعده رسله","compound":true,"excerpt":"المكر مهما عظم لا يخلف وعد الله لرسله.","positions":1,"surahs":1,"hadiths":0,"category":"الأسماء المنفية","categoryOrder":349},{"id":234,"name":"عنده حُسن المآب","compound":true,"excerpt":"زينة الدنيا متاع، وحسن المآب عند الله.","positions":1,"surahs":1,"hadiths":0,"category":"فئة «عنده»","categoryOrder":404},{"id":235,"name":"عنده حُسن الثواب","compound":true,"excerpt":"لا يضيع عند الله عمل، وعنده حسن الثواب.","positions":1,"surahs":1,"hadiths":0,"category":"فئة «عنده»","categoryOrder":405},{"id":236,"name":"عنده أجر عظيم","compound":true,"excerpt":"المال والولد فتنة، وما عند الله أعظم.","positions":3,"surahs":3,"hadiths":0,"category":"فئة «عنده»","categoryOrder":406},{"id":237,"name":"عنده أم الكتاب","compound":true,"excerpt":"ما تخافه في صحف المقادير، الله يمحو منه ويثبت؛ وأصل الكتاب عنده.","positions":1,"surahs":1,"hadiths":2,"category":"فئة «عنده»","categoryOrder":407},{"id":238,"name":"عنده علم الساعة","compound":true,"excerpt":"الساعة والغيث والأرحام والغد عند الله؛ فاستعد ولا تتطلع.","positions":2,"surahs":2,"hadiths":1,"category":"فئة «عنده»","categoryOrder":408},{"id":239,"name":"كل شيء عنده بمقدار","compound":true,"excerpt":"ما في الأرحام وما تأخر عنك؛ كله عنده بمقدار.","positions":1,"surahs":1,"hadiths":1,"category":"فئة «عنده»","categoryOrder":409},{"id":240,"name":"إلى الله المصير","compound":true,"excerpt":"كل نفس تزكو لنفسها، والمصير إلى الله.","positions":3,"surahs":3,"hadiths":0,"category":"فئة «إليه» و«إلى الله»","categoryOrder":411},{"id":241,"name":"إليه الوسيلة","compound":true,"excerpt":"القرب يُطلب بالتقوى والعمل؛ وإليه الوسيلة.","positions":1,"surahs":1,"hadiths":1,"category":"فئة «إليه» و«إلى الله»","categoryOrder":412},{"id":242,"name":"إلى الله مرجعكم","compound":true,"excerpt":"استغفر وتب الآن؛ فإلى الله مرجعك.","positions":1,"surahs":1,"hadiths":0,"category":"فئة «إليه» و«إلى الله»","categoryOrder":413},{"id":243,"name":"إليه مرجعكم جميعاً","compound":true,"excerpt":"البداية منه والإعادة إليه، والجزاء بالقسط.","positions":1,"surahs":1,"hadiths":0,"category":"فئة «إليه» و«إلى الله»","categoryOrder":414},{"id":244,"name":"إلى الله مرجعكم جميعاً","compound":true,"excerpt":"استبق الخيرات وأصلح نفسك، والحكم في الخلاف عند المرجع.","positions":2,"surahs":1,"hadiths":0,"category":"فئة «إليه» و«إلى الله»","categoryOrder":415},{"id":245,"name":"إليه متاب","compound":true,"excerpt":"توحيد وتوكل ورجوع: إليه متابي.","positions":1,"surahs":1,"hadiths":0,"category":"فئة «إليه» و«إلى الله»","categoryOrder":416},{"id":246,"name":"إلى الله تُرجَع الأمور","compound":true,"excerpt":"ما لا تفهمه الآن يرجع إلى من يدبره.","positions":6,"surahs":6,"hadiths":0,"category":"فئة «إليه» و«إلى الله»","categoryOrder":417},{"id":247,"name":"إليه النشور","compound":true,"excerpt":"امشِ في الأرض وكل من رزقه، واذكر أن إليه النشور.","positions":1,"surahs":1,"hadiths":1,"category":"فئة «إليه» و«إلى الله»","categoryOrder":418},{"id":248,"name":"إلى الله تصير الأمور","compound":true,"excerpt":"الطريق إلى الله، والأمور كلها تصير إليه.","positions":1,"surahs":1,"hadiths":0,"category":"فئة «إليه» و«إلى الله»","categoryOrder":419},{"id":249,"name":"وله كل شيء","compound":true,"excerpt":"من له كل شيء هو وحده المستحق للعبادة.","positions":1,"surahs":1,"hadiths":0,"category":"فئة «له» و«لله»","categoryOrder":350},{"id":250,"name":"له المُلك","compound":true,"excerpt":"الملك له؛ يؤتيه بالاصطفاء لا بالمال، ولا يملك غيره شيئًا.","positions":3,"surahs":3,"hadiths":0,"category":"فئة «له» و«لله»","categoryOrder":351},{"id":251,"name":"له ملك السماوات والأرض","compound":true,"excerpt":"من يملك السماوات والأرض هو الولي والنصير، يحيي ويميت.","positions":9,"surahs":8,"hadiths":0,"category":"فئة «له» و«لله»","categoryOrder":352},{"id":252,"name":"له ملك السماوات والأرض وما بينهما وعنده علم الساعة","compound":true,"excerpt":"الملك له، وعلم الساعة عنده، والرجوع إليه.","positions":1,"surahs":1,"hadiths":0,"category":"فئة «له» و«لله»","categoryOrder":353},{"id":253,"name":"له المُلك وله الحمد","compound":true,"excerpt":"ملكٌ لا يُذم، وحمدٌ لا ينقطع.","positions":1,"surahs":1,"hadiths":2,"category":"فئة «له» و«لله»","categoryOrder":355},{"id":254,"name":"له الحكم","compound":true,"excerpt":"الحكم له، وهو أسرع الحاسبين؛ وكل شيء هالك إلا وجهه.","positions":2,"surahs":2,"hadiths":0,"category":"فئة «له» و«لله»","categoryOrder":356},{"id":255,"name":"له الحمد في الأولى والآخرة وله الحكم","compound":true,"excerpt":"يعلم ما تكنّه صدرك، وله الحمد والحكم.","positions":1,"surahs":1,"hadiths":0,"category":"فئة «له» و«لله»","categoryOrder":357},{"id":256,"name":"الحكم لله العلي الكبير","compound":true,"excerpt":"من اشمأز من التوحيد حُكم عليه العلي الكبير.","positions":1,"surahs":1,"hadiths":0,"category":"فئة «له» و«لله»","categoryOrder":358},{"id":257,"name":"لله الدين الخالص","compound":true,"excerpt":"العبادة لله خالصة، بلا وسيط يقرّبك.","positions":1,"surahs":1,"hadiths":0,"category":"فئة «له» و«لله»","categoryOrder":359},{"id":258,"name":"لله الشفاعة جميعاً","compound":true,"excerpt":"اطلب الشفاعة من مالكها.","positions":1,"surahs":1,"hadiths":0,"category":"فئة «له» و«لله»","categoryOrder":360},{"id":259,"name":"له ما في السماوات والأرض","compound":true,"excerpt":"كل شيء ملكه وقانت له؛ فلا ولد ولا شريك.","positions":2,"surahs":2,"hadiths":0,"category":"فئة «له» و«لله»","categoryOrder":361},{"id":260,"name":"له ما في السماوات وما في الأرض","compound":true,"excerpt":"الحي القيوم الغني الحميد له كل ما في الكون.","positions":8,"surahs":7,"hadiths":0,"category":"فئة «له» و«لله»","categoryOrder":362},{"id":261,"name":"له غيب السماوات والأرض","compound":true,"excerpt":"ما اختلف فيه الناس من الغيب، علمه عند الله.","positions":1,"surahs":1,"hadiths":0,"category":"فئة «له» و«لله»","categoryOrder":363},{"id":262,"name":"له ما في السماوات وما في الأرض وله الحمد في الآخرة","compound":true,"excerpt":"احمده على ملكه اليوم، وسيُحمد على جزائه غدًا.","positions":1,"surahs":1,"hadiths":0,"category":"فئة «له» و«لله»","categoryOrder":364},{"id":263,"name":"له الحمد في السماوات والأرض وعشياً وحين تُظهرون","compound":true,"excerpt":"اجعل يومك موزعًا بين التسبيح والحمد.","positions":1,"surahs":1,"hadiths":1,"category":"فئة «له» و«لله»","categoryOrder":365},{"id":264,"name":"الملك اليوم لله الواحد القهار","compound":true,"excerpt":"كل ملك يزول، ويبقى سؤال: لمن الملك اليوم؟","positions":1,"surahs":1,"hadiths":1,"category":"فئة «له» و«لله»","categoryOrder":366},{"id":265,"name":"المساجد لله","compound":true,"excerpt":"في المسجد: الدعاء لله وحده.","positions":1,"surahs":1,"hadiths":0,"category":"فئة «له» و«لله»","categoryOrder":367},{"id":266,"name":"لله المثل الأعلى","compound":true,"excerpt":"كل كمال لله، وكل نقص منزّه عنه.","positions":1,"surahs":1,"hadiths":0,"category":"فئة «له» و«لله»","categoryOrder":368},{"id":267,"name":"وله ما في السماوات والأرض وله الدين واصباً","compound":true,"excerpt":"من له الملك والدين الدائم فهو أحق أن يُتّقى.","positions":1,"surahs":1,"hadiths":0,"category":"فئة «له» و«لله»","categoryOrder":369},{"id":268,"name":"العزة لله جميعاً","compound":true,"excerpt":"لا عزة إلا من الله؛ فلا تطلبها عند غيره ولا يحزنك قولهم.","positions":2,"surahs":2,"hadiths":0,"category":"فئة «له»