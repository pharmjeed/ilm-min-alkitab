{"schema":1,"kind":"names-chunk","version":"names-b52c0b18ade7","names":[{"id":20,"name":"الحليم الغفور","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: حَلِيمًا غَفُورًا — مركّبة | المواضع: 2 (الإسراء: 44 — فاطر: 41)\nخصوصية: الموضعان كلاهما في سياقٍ كوني واحد: تسبيحُ السماوات والأرض، وإمساكُ السماوات والأرض — فالاسمان جوابٌ عن سؤال: لماذا لم يسقط الكونُ على رؤوس المكذبين بعد؟\n\nالمعنى:\n- الحليم: الذي لا يعاجل بالعقوبة مع كمال قدرته، يمهل ولا يهمل.\n- الغفور: الذي يستر ويتجاوز إذا رجع العبد.\nسر الاقتران: حلمٌ يؤخّر العقوبة، ومغفرةٌ تمحوها إن تبتَ في المهلة — فالحلم يفتح الوقت، والمغفرة تفتح الباب.","teaches":"الحقائق التي كشفها الموضعان:\n1. الكون كله مسبّح، والشاذُّ من يشرك — ومع ذلك لا يُعاجَل، حلمًا (الإسراء 44).\n2. بقاءُ السماء فوق رأسك أثرٌ مباشر من حلمه ومغفرته (فاطر 41).\n3. المهلةُ ليست إهمالًا بل فرصةً مقترنة بمغفرةٍ مفتوحة.","whenRecall":"لحظات الاستحضار — مشتقة من موضعيه:\n- عند النظر إلى السماء: من يمسكها؟\n- عند رؤية استهزاءٍ بالدين لا يعقبه عقاب فوري.\n- عند تأخر عقوبتك أنت عن ذنبك — فهي مهلةٌ لا براءة.","whenPray":"بنود الدعاء — مشتقة من سياق الموضعين:\n1. شكرُ المهلة والاستغفار فيها قبل انقضائها — الإسراء 44.\n2. عند رؤية الإساءة إلى الله ودينه: الصبر واستحضار حلمه بدل الاستعجال.\n3. سؤال الثبات وأنت تحت سماءٍ يمسكها — فاطر 41.\n4. الاستغفار لمن حولك من الغافلين: بابُ الغفور مفتوح ما دامت المهلة.\n\nمن السنة: كان النبي ﷺ يقول عند الكرب: «لَا إِلَهَ إِلَّا اللَّهُ الْعَظِيمُ الْحَلِيمُ» — متفق عليه؛ فالحلم من أسماء الفرج عند الشدائد.","summary":"السماءُ فوق رأسك لم تسقط بعد — ذلك حلمُه؛ وبابُ التوبة لم يُغلق بعد — تلك مغفرتُه: ﴿إِنَّهُ كَانَ حَلِيمًا غَفُورًا﴾.","verses":[{"i":1,"of":2,"s":17,"surah":"الإسراء","a":44,"text":"تُسَبِّحُ لَهُ السَّمَاوَاتُ السَّبْعُ وَالْأَرْضُ وَمَنْ فِيهِنَّ وَإِنْ مِنْ شَيْءٍ إِلَّا يُسَبِّحُ بِحَمْدِهِ وَلَكِنْ لَا تَفْقَهُونَ تَسْبِيحَهُمْ إِنَّهُ كَانَ حَلِيمًا غَفُورًا","prev":{"a":43,"text":"سُبْحَانَهُ وَتَعَالَى عَمَّا يَقُولُونَ عُلُوًّا كَبِيرًا"},"next":{"a":45,"text":"وَإِذَا قَرَأْتَ الْقُرْآنَ جَعَلْنَا بَيْنَكَ وَبَيْنَ الَّذِينَ لَا يُؤْمِنُونَ بِالْآخِرَةِ حِجَابًا مَسْتُورًا"},"context":"﴿تُسَبِّحُ لَهُ السَّمَاوَاتُ السَّبْعُ وَالْأَرْضُ وَمَنْ فِيهِنَّ وَإِنْ مِنْ شَيْءٍ إِلَّا يُسَبِّحُ بِحَمْدِهِ وَلَكِنْ لَا تَفْقَهُونَ تَسْبِيحَهُمْ إِنَّهُ كَانَ حَلِيمًا غَفُورًا﴾ — الكونُ كله في تسبيحٍ دائم، وأنت لا تسمعه، والسياق قبله ردٌّ على من نسب لله الولد والشريك.","reason":"خُتمت آيةُ التسبيح الكوني بالاسمين لمفارقةٍ عجيبة: كلُّ شيء يسبّح بحمده — ذرةً وشجرةً وسماء — إلا فئةً من البشر تنسب إليه الولدَ وتشرك به؛ ومع هذا النشاز لم يعاجلهم، لأنه حليمٌ غفور. فالسكوتُ حلمٌ لا رضا، والانتظارُ فرصةُ مغفرة.","adds":"يجيب عن سؤال يتردد: لماذا لا يُعاقَب المستهزئون بالله فورًا؟ لأنه حليم — والمهلةُ نفسُها دعوةٌ للعودة قبل أن تُغلق."},{"i":2,"of":2,"s":35,"surah":"فاطر","a":41,"text":"إِنَّ اللَّهَ يُمْسِكُ السَّمَاوَاتِ وَالْأَرْضَ أَنْ تَزُولَا وَلَئِنْ زَالَتَا إِنْ أَمْسَكَهُمَا مِنْ أَحَدٍ مِنْ بَعْدِهِ إِنَّهُ كَانَ حَلِيمًا غَفُورًا","prev":{"a":40,"text":"قُلْ أَرَأَيْتُمْ شُرَكَاءَكُمُ الَّذِينَ تَدْعُونَ مِنْ دُونِ اللَّهِ أَرُونِي مَاذَا خَلَقُوا مِنَ الْأَرْضِ أَمْ لَهُمْ شِرْكٌ فِي السَّمَاوَاتِ أَمْ آتَيْنَاهُمْ كِتَابًا فَهُمْ عَلَى بَيِّنَتٍ مِنْهُ بَلْ إِنْ يَعِدُ الظَّالِمُونَ بَعْضُهُمْ بَعْضًا إِلَّا غُرُورًا"},"next":{"a":42,"text":"وَأَقْسَمُوا بِاللَّهِ جَهْدَ أَيْمَانِهِمْ لَئِنْ جَاءَهُمْ نَذِيرٌ لَيَكُونُنَّ أَهْدَى مِنْ إِحْدَى الْأُمَمِ فَلَمَّا جَاءَهُمْ نَذِيرٌ مَا زَادَهُمْ إِلَّا نُفُورًا"},"context":"﴿إِنَّ اللَّهَ يُمْسِكُ السَّمَاوَاتِ وَالْأَرْضَ أَنْ تَزُولَا وَلَئِنْ زَالَتَا إِنْ أَمْسَكَهُمَا مِنْ أَحَدٍ مِنْ بَعْدِهِ إِنَّهُ كَانَ حَلِيمًا غَفُورًا﴾ — بعد تحدّي المشركين أن يُروا ما خلق شركاؤهم من الأرض أو ما لهم من شركٍ في السماوات.","reason":"عُلّل بقاءُ السماوات والأرض بالحلم والمغفرة: الكون قائمٌ بإمساكه لا بذاته، ولو تُرك لحظةً لزال — فاستمرارُ وجودك تحت سماءٍ لم تسقط هو أثرٌ يومي لاسم «الحليم الغفور». فحِلمُه يمسك الكونَ عن الانهيار على أهل المعاصي.","adds":"أعظمُ تجسيدٍ لمعنى الحلم: انظر إلى السماء فوقك الآن — ثباتُها ذاته رسالةٌ من حليمٍ غفور، لا قانونٌ مستقل عنه."}],"hadiths":[{"i":1,"of":1,"text":"قال نوحٌ لابنِهِ : إنِّي مُوصِيكَ بوصيَّةٍ وقاصِرُها لكي لا تنساها ؛ أُوصِيك باثنتَيْنِ ، وأنهاك عن اثنتيْنِ : أمَّا اللَّتانِ أُوصِيكَ بهِما ؛ فيستبشِرُ اللهُ بِهِما وصالِحُ خَلقِه ، وهما يُكثرانِ الوُلوجَ على اللهِ : أُوصِيك ب ( لا إلهَ إلَّا اللهُ ) ؛ فإنَّ السَّمواتِ والأرضِ لَو كانَتا حلقةً قَصمَتْهُما ، ولَو كانَتا في كفَّةٍ وزنتْهُما . وأُوصِيك ب ( سُبحانَ اللهِ وبِحَمدِه ) ؛ فإنَّهُما صلاةُ الخَلقِ ، وبهما يُرْزَقُ الخلقُ ،  وَإِنْ مِنْ شَيْءٍ إِلَّا يُسَبِّحُ بِحَمْدِهِ وَلَكِنْ لَا تَفْقَهُونَ تَسْبِيحَهُمْ إِنَّهُ كَانَ حَلِيمًا غَفُورًا  . وأمَّا اللَّتانِ أنهاك عَنهُما ؛ فيحتَجبُ اللهُ منهُما وصالِحُ خلقِه : أنهاكَ عن الشِّركِ والكِبْرِ .","narrator":"رجل من الأنصار","source":"صحيح الترغيب 1543","grade":"صحيح","url":"https://dorar.net/h/cBhXOPuB","nameForm":"حَلِيمًا غَفُورًا","scene":"النبي ﷺ يروي وصية نوحٍ لابنه: «إني موصيك بوصية وقاصرها لكي لا تنساها؛ أوصيك باثنتين وأنهاك عن اثنتين. أما اللتان أوصيك بهما فيستبشر الله بهما وصالح خلقه، وهما يكثران الولوج على الله: أوصيك بـ(لا إله إلا الله)؛ فإن السماوات والأرض لو كانتا حلقةً قصمتهما، ولو كانتا في كفةٍ وزنتهما. وأوصيك بـ(سبحان الله وبحمده)؛ فإنهما صلاة الخلق، وبهما يُرزق الخلق، ﴿وَإِن مِّن شَيْءٍ إِلَّا يُسَبِّحُ بِحَمْدِهِ وَلَـٰكِن لَّا تَفْقَهُونَ تَسْبِيحَهُمْ إِنَّهُ كَانَ حَلِيمًا غَفُورًا﴾. وأما اللتان أنهاك عنهما فيحتجب الله منهما وصالح خلقه: أنهاك عن الشرك والكبر».","reason":"آية الإسراء تقول إن كل شيء يسبّح بحمده، ثم تعتذر عن الإنسان: «ولكن لا تفقهون تسبيحهم»، ثم تختم بالاسم. فما علاقة الحلم والمغفرة بتسبيح الكائنات؟ العلاقة أن الإنسان وحده يُقصّر في التسبيح وسط خلقٍ لا يفتر عنه، فلو عاجله الله لهلك، لكنه حليمٌ يُمهل وغفورٌ يمحو تقصيره إذا سبّح. ونوح يجعل هذا الاسم حجّةَ الوصية بالتسبيح: سبّح لأن الكون كله يسبّح، ولأن الذي تسبّحه حليمٌ عن غفلتك غفورٌ لها. واقتران التسبيح بالرزق «وبهما يُرزق الخلق» يناسب الحلم: يرزق من يقصّر في تسبيحه ولا يقطع عنه.","adds":"يجعل الشاهد الاسم جزءًا من وصية موتٍ مختصرة «لكي لا تنساها»: نوحٌ يورّث ابنه كلمتين، والاسم هو ما يُطمئن الابن أن التقصير في الثانية مغفور. ويضيف أن الله «يستبشر» بالتسبيح، وأن الاسم يُذكر مقابل نهيٍ عن الشرك والكبر — فالحليم الغفور يُقابله متكبّرٌ لا يسبّح."}],"sunnah":{"card":"الصيغة: حَلِيمًا غَفُورًا — مركّبة، وردت في الحديث بلفظ القرآن ﴿إِنَّهُ كَانَ حَلِيمًا غَفُورًا﴾\nفي السنة: شاهد واحد (رواية واحدة)\nخصوصية الورود في السنة: الاسم في وصية نوحٍ لابنه كما رواها النبي ﷺ: يوصيه بـ«سبحان الله وبحمده» ويستدل بآية الإسراء ﴿وَإِن مِّن شَيْءٍ إِلَّا يُسَبِّحُ بِحَمْدِهِ… إِنَّهُ كَانَ حَلِيمًا غَفُورًا﴾ — فالاسم هنا خاتمةُ آيةٍ تُتلى في وصية أبٍ لابنه عند الموت.\nالمعنى المختصر: الحليم الذي لا يعاجل بالعقوبة مع القدرة، الغفور الذي يستر ويمحو.","teaches":"1. أنه حليمٌ عمّن قصّر في تسبيحه وسط خلقٍ كله يسبّح، لا يعاجله.\n2. أنه غفورٌ لغفلة الإنسان إذا رجع إلى الذكر.\n3. أنه يرزق الخلق بتسبيحهم، ويرزق المقصّر بحلمه.\n4. أنه يستبشر بذكر عبده، ويحتجب عن الشرك والكبر.","whenRecall":"- حين تقول «سبحان الله وبحمده» فتذكر أن الكون كله يقولها وأنك المقصّر المُمهَل.\n- حين تُوصي ولدك أو تلقّنه: كلمتان لا تُنسيان.\n- حين تجد قسوةً وغفلة في قلبك عن الذكر.\n- حين ترى رزقًا يجري على غافل: ذاك حلمه.","whenPray":"عند الشعور بـ:\n1. الغفلة عن الذكر والتقصير فيه.\n2. الخوف من المعاجلة بالعقوبة على التقصير.\n3. الحرص على ما تُورّثه أبناءك.\nعند طلب:\n1. المغفرة لما فات من الذكر.\n2. الرزق ببركة التسبيح.\n3. النجاة من الشرك والكبر.\nعند الرغبة في:\n1. المداومة على «سبحان الله وبحمده».\n2. أن تكون وصيتك لأهلك كلماتٍ لا مالًا.","duaItems":"1. «لا إله إلا الله» و«سبحان الله وبحمده» — وصية نوح لابنه كما رواها النبي ﷺ (صحيح الترغيب 1543 — صحيح).\n2. يُدعى بخاتمة الآية: «اللهم إنك كنت حليمًا غفورًا، فاحلُم عن تقصيري في ذكرك واغفره لي» — مستفادٌ من [الإسراء: 44].","summary":"«حليمًا غفورًا» في السنة خاتمةُ آية التسبيح في وصية نوحٍ لابنه عند الموت: الكون كله يسبّح وأنت المقصّر المُمهَل، فسبّح واحمد لأن الذي تسبّحه حليمٌ عن غفلتك غفورٌ لها، ويرزق بالتسبيح ويستبشر به."},"situations":[{"situationId":15,"verses":[{"i":2,"strength":"direct","headline":"ذنبٌ اقترفته للتوّ ومهلةٌ لم تنقطع بعد","bridge":"أذنبتَ الآن والسماء لم تسقط عليك؟ ذلك لأن ﴿اللَّهَ يُمْسِكُ السَّمَاوَاتِ وَالْأَرْضَ أَنْ تَزُولَا﴾ وعُلّل الإمساك بـ﴿إِنَّهُ كَانَ حَلِيمًا غَفُورًا﴾ — ثبات السماء فوقك الآن مهلةٌ من حليم، فعد قبل أن تنقضي."}],"hadiths":[]},{"situationId":36,"verses":[{"i":1,"strength":"direct","headline":"رؤية المستهزئين بالله ممهَلين بلا عقوبة","bridge":"تسأل: لماذا لا يُعاقب المستهزئون بالله فورًا؟ الكون كله يسبّح بحمده إلا فئةً تنسب إليه الولد، ومع هذا النشاز لم يعاجلهم: ﴿إِنَّهُ كَانَ حَلِيمًا غَفُورًا﴾ — فالسكوت حلمٌ لا رضا، والمهلة دعوةٌ للعودة قبل أن تُغلق."}],"hadiths":[]},{"situationId":179,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"الغفلة عن التسبيح وقسوة القلب وسط كونٍ يسبّح","bridge":"تقرأ ولا تتأثر وتصلي ولا تحضر؟ نوحٌ أوصى ابنه بـ«سبحان الله وبحمده» وقال: هي صلاة الخلق، ﴿وَإِن مِّن شَيْءٍ إِلَّا يُسَبِّحُ بِحَمْدِهِ… إِنَّهُ كَانَ حَلِيمًا غَفُورًا﴾ — أنت الغافل الوحيد في كونٍ يسبّح، والذي تسبّحه حليمٌ عن غفلتك إذا رجعت."}]}]},{"id":21,"name":"أرحم الراحمين","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: أَرْحَمُ الرَّاحِمِينَ — صيغة تفضيل | المواضع: 4 (الأعراف: 151 — يوسف: 64، 92 — الأنبياء: 83)\nخصوصية: كل مواضعه على ألسنة الأنبياء في مواطن الانكسار: موسى بعد فتنة العجل، ويعقوب حين فقد الثاني، ويوسف حين قدر فعفا، وأيوب في ذروة الضر — فهو اسم النداء عند غاية الحاجة.\n\nالمعنى:\n- أرحم الراحمين: الذي رحمتُه فوق كل رحمة — أرحم بك من أمك وأبيك ومن نفسك، لا يقاس به راحم.","teaches":"الحقائق التي كشفتها المواضع:\n1. الاسم اسمُ الانكسار: كل مواضعه في لحظات فقدٍ أو ضرٍّ أو ندم.\n2. عرضُ الحال يغني عن صيغة الطلب إذا عرفتَ من تخاطب (الأنبياء 83).\n3. من عرف أنه أرحم الراحمين تخلّق برحمته مع الناس (يوسف 92).\n4. حين تسقط الثقة بالبشر، ينتقل التوكل إلى «خير حافظًا وهو أرحم الراحمين» (يوسف 64).","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- في ذروة المرض والضر الجسدي.\n- عند فقد عزيز أو الخوف من تكرار الفجيعة.\n- بعد غضبٍ على قريب.\n- ساعةَ تقدر على من ظلمك.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. في المرض والضرّ: دعاء أيوب بحرفه — «مسّني الضر وأنت أرحم الراحمين» — الأنبياء 83.\n2. بعد الخصومة مع قريب: «رب اغفر لي ولأخي وأدخلنا في رحمتك» — الأعراف 151.\n3. عند الخوف على من تحب: «فالله خير حافظًا وهو أرحم الراحمين» — يوسف 64.\n4. عند العفو عمن أساء إليك: ادعُ له بالمغفرة كما فعل يوسف — يوسف 92.\n5. سؤال الدخول في الرحمة إحاطةً لا مسًّا — الأعراف 151.\n\nدعاء جامع مقتبس من مواضعه:\n«ربِّ مسّني الضرُّ وأنت أرحم الراحمين، اغفر لي ولإخواني وأدخلنا في رحمتك، واحفظ من أحبُّ فأنت خير حافظًا، ولا تثريب على من أساء إليّ — يغفر الله لنا ولهم».","summary":"أربعةُ أنبياء نادوه به في أضيق ساعاتهم — وأبلغُهم أيوب: عرض حالَه ووصف ربَّه فاستُجيب له. فإن ضاق بك الأمر فقل: «مسّني الضر وأنت أرحم الراحمين».","verses":[{"i":1,"of":4,"s":7,"surah":"الأعراف","a":151,"text":"قَالَ رَبِّ اغْفِرْ لِي وَلِأَخِي وَأَدْخِلْنَا فِي رَحْمَتِكَ وَأَنْتَ أَرْحَمُ الرَّاحِمِينَ","prev":{"a":150,"text":"وَلَمَّا رَجَعَ مُوسَى إِلَى قَوْمِهِ غَضْبَانَ أَسِفًا قَالَ بِئْسَمَا خَلَفْتُمُونِي مِنْ بَعْدِي أَعَجِلْتُمْ أَمْرَ رَبِّكُمْ وَأَلْقَى الْأَلْوَاحَ وَأَخَذَ بِرَأْسِ أَخِيهِ يَجُرُّهُ إِلَيْهِ قَالَ ابْنَ أُمَّ إِنَّ الْقَوْمَ اسْتَضْعَفُونِي وَكَادُوا يَقْتُلُونَنِي فَلَا تُشْمِتْ بِيَ الْأَعْدَاءَ وَلَا تَجْعَلْنِي مَعَ الْقَوْمِ الظَّالِمِينَ"},"next":{"a":152,"text":"إِنَّ الَّذِينَ اتَّخَذُوا الْعِجْلَ سَيَنَالُهُمْ غَضَبٌ مِنْ رَبِّهِمْ وَذِلَّةٌ فِي الْحَيَاةِ الدُّنْيَا وَكَذَلِكَ نَجْزِي الْمُفْتَرِينَ"},"context":"موسى يعود من الميقات فيجد قومَه عبدوا العجل، فيلقي الألواح ويأخذ برأس أخيه يجرّه إليه، فيعتذر هارون: ﴿ابْنَ أُمَّ إِنَّ الْقَوْمَ اسْتَضْعَفُونِي وَكَادُوا يَقْتُلُونَنِي﴾ — فيهدأ موسى ويدعو: ﴿رَبِّ اغْفِرْ لِي وَلِأَخِي وَأَدْخِلْنَا فِي رَحْمَتِكَ وَأَنْتَ أَرْحَمُ الرَّاحِمِينَ﴾.","reason":"بعد غضبٍ نبويٍّ غيرةً لله، وبعد ظهور عذر الأخ، ختم موسى بـ«أرحم الراحمين»: فالغضبُ ولو كان لله يحتاج إلى استغفارٍ بعده، والأخوةُ تُرمَّم بدعاءٍ يجمع الاثنين: «اغفر لي ولأخي». وطلبُ الدخول «في رحمتك» يناسب الاسم: أن تحيط بك الرحمةُ إحاطة.","adds":"أدبُ ما بعد الغضب مع الأقربين: لا تكتفِ بالاعتذار — ادعُ لنفسك وله معًا، واسأل أرحم الراحمين أن يدخلكما في رحمته."},{"i":2,"of":4,"s":12,"surah":"يوسف","a":64,"text":"قَالَ هَلْ آمَنُكُمْ عَلَيْهِ إِلَّا كَمَا أَمِنْتُكُمْ عَلَى أَخِيهِ مِنْ قَبْلُ فَاللَّهُ خَيْرٌ حَافِظًا وَهُوَ أَرْحَمُ الرَّاحِمِينَ","prev":{"a":63,"text":"فَلَمَّا رَجَعُوا إِلَى أَبِيهِمْ قَالُوا يَا أَبَانَا مُنِعَ مِنَّا الْكَيْلُ فَأَرْسِلْ مَعَنَا أَخَانَا نَكْتَلْ وَإِنَّا لَهُ لَحَافِظُونَ"},"next":{"a":65,"text":"وَلَمَّا فَتَحُوا مَتَاعَهُمْ وَجَدُوا بِضَاعَتَهُمْ رُدَّتْ إِلَيْهِمْ قَالُوا يَا أَبَانَا مَا نَبْغِي هَذِهِ بِضَاعَتُنَا رُدَّتْ إِلَيْنَا وَنَمِيرُ أَهْلَنَا وَنَحْفَظُ أَخَانَا وَنَزْدَادُ كَيْلَ بَعِيرٍ ذَلِكَ كَيْلٌ يَسِيرٌ"},"context":"يعقوب وقد طُلب منه إرسال بنيامين، والجرحُ القديم لم يندمل: ﴿هَلْ آمَنُكُمْ عَلَيْهِ إِلَّا كَمَا أَمِنْتُكُمْ عَلَى أَخِيهِ مِنْ قَبْلُ﴾ — ثم يُسلم الأمر: ﴿فَاللَّهُ خَيْرٌ حَافِظًا وَهُوَ أَرْحَمُ الرَّاحِمِينَ﴾.","reason":"في لحظة انعدام الثقة بالبشر، انتقل يعقوب من الحفظ البشري إلى الحفظ الإلهي: «الله خير حافظًا» ثم علّل بالرحمة — «وهو أرحم الراحمين»: أي أرحم بي من أن يفجعني مرتين. فالاسم هنا رجاءُ أبٍ مكلوم يُحسن الظنّ بعد التجربة المرّة.","adds":"لكل من خذلته الثقةُ مرة: لا تمتنع عن الحياة، بل انقل التوكل من الناس إلى أرحم الراحمين — وقد رُدّ ليعقوب الاثنان معًا."},{"i":3,"of":4,"s":12,"surah":"يوسف","a":92,"text":"قَالَ لَا تَثْرِيبَ عَلَيْكُمُ الْيَوْمَ يَغْفِرُ اللَّهُ لَكُمْ وَهُوَ أَرْحَمُ الرَّاحِمِينَ","prev":{"a":91,"text":"قَالُوا تَاللَّهِ لَقَدْ آثَرَكَ اللَّهُ عَلَيْنَا وَإِنْ كُنَّا لَخَاطِئِينَ"},"next":{"a":93,"text":"اذْهَبُوا بِقَمِيصِي هَذَا فَأَلْقُوهُ عَلَى وَجْهِ أَبِي يَأْتِ بَصِيرًا وَأْتُونِي بِأَهْلِكُمْ أَجْمَعِينَ"},"context":"الإخوة يقفون أمام العزيز مكشوفين: ﴿أَإِنَّكَ لَأَنْتَ يُوسُفُ﴾ — وهو في ذروة القدرة على الانتقام ممن ألقوه في الجب. فيقول: ﴿لَا تَثْرِيبَ عَلَيْكُمُ الْيَوْمَ يَغْفِرُ اللَّهُ لَكُمْ وَهُوَ أَرْحَمُ الرَّاحِمِينَ﴾.","reason":"أسقط يوسف التثريب — أي اللومَ والتعيير — ثم دعا لهم بالمغفرة معلّلًا بأنه «أرحم الراحمين»: كأنه يقول: إن كنتُ أنا رحمتُكم على ما فعلتم، فمن هو أرحمُ الراحمين أولى بأن يرحمكم. فتخلّق باسمه ثم استشفع به لهم.","adds":"أرقى مقامات العفو في القرآن: لا انتقام، ولا حتى لومًا، بل دعاءً للجاني — وهذا ثمرةُ معرفةِ أرحم الراحمين."},{"i":4,"of":4,"s":21,"surah":"الأنبياء","a":83,"text":"وَأَيُّوبَ إِذْ نَادَى رَبَّهُ أَنِّي مَسَّنِيَ الضُّرُّ وَأَنْتَ أَرْحَمُ الرَّاحِمِينَ","prev":{"a":82,"text":"وَمِنَ الشَّيَاطِينِ مَنْ يَغُوصُونَ لَهُ وَيَعْمَلُونَ عَمَلًا دُونَ ذَلِكَ وَكُنَّا لَهُمْ حَافِظِينَ"},"next":{"a":84,"text":"فَاسْتَجَبْنَا لَهُ فَكَشَفْنَا مَا بِهِ مِنْ ضُرٍّ وَآتَيْنَاهُ أَهْلَهُ وَمِثْلَهُمْ مَعَهُمْ رَحْمَةً مِنْ عِنْدِنَا وَذِكْرَى لِلْعَابِدِينَ"},"context":"أيوب بعد سنوات البلاء في جسده وأهله وماله، ينادي بأدبٍ عجيب: ﴿أَنِّي مَسَّنِيَ الضُّرُّ وَأَنْتَ أَرْحَمُ الرَّاحِمِينَ﴾ — لم يقل: فاكشفه، ولم يشكُ ولم يسأل صراحة. فكان الجواب: ﴿فَاسْتَجَبْنَا لَهُ فَكَشَفْنَا مَا بِهِ مِنْ ضُرٍّ﴾.","reason":"أعظمُ دعاءٍ بأقلّ الألفاظ: عرضُ حالٍ (مسّني الضر) + وصفُ الربّ بأرحم الراحمين — والباقي متروكٌ لرحمته. وقولُه «مسّني» تأدبٌ: ما قال أهلكني، مع أن البلاء كان عظيمًا. فالاسمُ هنا أغنى عن صيغة الطلب كلها.","adds":"مدرسةُ الدعاء في الشدة: اعرض حالك ثم ذكّر برحمته، ودع الطلبَ لكرمه — فقد استُجيب لأيوب بلا سؤالٍ صريح."}],"hadiths":[{"i":1,"of":11,"text":"«أنَّ ناسًا في زَمَنِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم قالوا: يا رَسولَ اللهِ، هل نَرى رَبَّنا يَومَ القيامةِ؟ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: نَعَم، قال: هل تُضارُّونَ في رُؤيةِ الشَّمسِ بالظَّهيرةِ صَحوًا ليس معها سَحابٌ؟ وهل تُضارُّونَ في رُؤيةِ القَمَرِ لَيلةَ البَدرِ صَحوًا ليس فيها سَحابٌ؟ قالوا: لا يا رَسولَ اللهِ، قال: ما تُضارُّونَ في رُؤيةِ اللهِ تَبارَك وتَعالى يَومَ القيامةِ إلَّا كما تُضارُّونَ في رُؤيةِ أحَدِهما، إذا كانَ يَومُ القيامةِ أذَّنَ مُؤَذِّنٌ: ليَتَّبِعْ كُلُّ أُمَّةٍ ما كانَت تَعبُدُ، فلا يَبقى أحَدٌ كانَ يَعبُدُ غيرَ اللهِ سُبحانَه مِنَ الأصنامِ والأنصابِ إلَّا يَتَساقَطونَ في النَّارِ، حتَّى إذا لَم يَبقَ إلَّا مَن كانَ يَعبُدُ اللهَ مِن بَرٍّ وفاجِرٍ وغُبَّرِ أهلِ الكِتابِ، فيُدعى اليَهودُ، فيُقالُ لهم: ما كُنتُم تَعبُدونَ؟ قالوا: كُنَّا نَعبُدُ عُزَيرَ ابنَ اللهِ، فيُقالُ: كَذَبتُم، ما اتَّخَذَ اللهُ مِن صاحِبةٍ ولا ولَدٍ، فماذا تَبغونَ؟ قالوا: عَطِشنا يا رَبَّنا، فاسقِنا، فيُشارُ إليهم، ألا تَرِدونَ؟ فيُحشَرونَ إلى النَّارِ كَأنَّها سَرابٌ يَحطِمُ بَعضُها بَعضًا، فيَتَساقَطونَ في النَّارِ، ثُمَّ يُدعى النَّصارى، فيُقالُ لهم: ما كُنتُم تَعبُدونَ؟ قالوا: كُنَّا نَعبُدُ المَسيحَ ابنَ اللهِ، فيُقالُ لهم، كَذَبتُم، ما اتَّخَذَ اللهُ مِن صاحِبةٍ ولا ولَدٍ، فيُقالُ لهم: ماذا تَبغونَ؟ فيَقولونَ: عَطِشنا يا رَبَّنا، فاسقِنا، قال: فيُشارُ إليهم، ألا تَرِدونَ؟ فيُحشَرونَ إلى جَهَنَّمَ كَأنَّها سَرابٌ يَحطِمُ بَعضُها بَعضًا، فيَتَساقَطونَ في النَّارِ، حتَّى إذا لَم يَبقَ إلَّا مَن كانَ يَعبُدُ اللهَ تَعالى مِن بَرٍّ وفاجِرٍ، أتاهم رَبُّ العالَمينَ سُبحانَه وتَعالى في أدنى صورةٍ مِنَ التي رَأوْه فيها، قال: فما تَنتَظِرونَ؟ تَتبَعُ كُلُّ أُمَّةٍ ما كانَت تَعبُدُ، قالوا: يا رَبَّنا، فارَقنا النَّاسَ في الدُّنيا أفقَرَ ما كُنَّا إليهم، ولَم نُصاحِبْهُم، فيَقولُ: أنا رَبُّكُم، فيَقولونَ: نَعوذُ باللهِ مِنك لا نُشرِكُ باللهِ شيئًا، مَرَّتَينِ أو ثَلاثًا، حتَّى إنَّ بَعضَهم لَيَكادُ أن يَنقَلِبَ، فيَقولُ: هل بينَكُم وبينَه آيةٌ فتَعرِفونَه بها؟ فيَقولونَ: نَعَم، فيُكشَفُ عن ساقٍ، فلا يَبقى مَن كانَ يَسجُدُ للَّهِ مِن تِلقاءِ نَفسِه إلَّا أذِنَ اللهُ له بالسُّجودِ، ولا يَبقى مَن كانَ يَسجُدُ اتِّقاءً ورياءً إلَّا جَعَلَ اللهُ ظَهرَه طَبَقةً واحِدةً، كُلَّما أرادَ أن يَسجُدَ خَرَّ على قَفاه، ثُمَّ يَرفَعونَ رُؤوسَهم وقد تَحَوَّلَ في صورَتِه التي رَأوْه فيها أوَّلَ مَرَّةٍ، فقال: أنا رَبُّكُم، فيَقولونَ: أنتَ رَبُّنا، ثُمَّ يُضرَبُ الجِسرُ على جَهَنَّمَ، وتَحِلُّ الشَّفاعةُ، ويقولونَ: اللهمَّ سَلِّمْ سَلِّمْ، قيلَ: يا رَسولَ اللهِ، وما الجِسرُ؟ قال: دَحضٌ مَزِلَّةٌ، فيه خَطاطيفُ وكَلاليبُ، وحَسَكٌ تَكونُ بنَجدٍ فيها شويكةٌ يُقالُ لها السَّعدانُ، فيَمُرُّ المُؤمِنونَ كَطَرفِ العَينِ، وكالبَرقِ، وكالرِّيحِ، وكالطَّيرِ، وكَأجاويدِ الخَيلِ والرِّكابِ؛ فناجٍ مُسَلَّمٌ، ومَخدوشٌ مُرسَلٌ، ومَكدوسٌ في نارِ جَهَنَّمَ، حتَّى إذا خَلَصَ المُؤمِنونَ مِنَ النَّارِ، فوالذي نَفسي بيَدِه، ما مِنكُم مِن أحَدٍ بأشَدَّ مُناشَدةً للَّهِ في استِقصاءِ الحَقِّ مِنَ المُؤمِنينَ للَّهِ يَومَ القيامةِ لإخوانِهمُ الذينَ في النَّارِ، يقولونَ: رَبَّنا كانوا يَصومونَ معنا ويُصَلُّونَ ويَحُجُّونَ، فيُقالُ لهم: أخرِجوا مَن عَرَفتُم، فتُحَرَّمُ صورُهم على النَّارِ، فيُخرِجونَ خَلقًا كَثيرًا قدِ أخَذَتِ النَّارُ إلى نِصفِ ساقَيه، وإلى رُكبَتَيه، ثُمَّ يقولونَ: رَبَّنا ما بَقيَ فيها أحَدٌ مِمَّن أمَرتَنا به، فيَقولُ: ارجِعوا فمَن وجَدتُم في قَلبِه مِثقالَ دينارٍ مِن خَيرٍ فأخرِجوه، فيُخرِجونَ خَلقًا كَثيرًا، ثُمَّ يقولونَ: رَبَّنا لَم نَذَرْ فيها أحَدًا مِمَّن أمَرتَنا، ثُمَّ يقولُ: ارجِعوا فمَن وجَدتُم في قَلبِه مِثقالَ نِصفِ دينارٍ مِن خَيرٍ فأخرِجوه، فيُخرِجونَ خَلقًا كَثيرًا، ثُمَّ يقولونَ: رَبَّنا لَم نَذَرْ فيها مِمَّن أمَرتَنا أحَدًا، ثُمَّ يقولُ: ارجِعوا فمَن وجَدتُم في قَلبِه مِثقالَ ذَرَّةٍ مِن خَيرٍ فأخرِجوه، فيُخرِجونَ خَلقًا كَثيرًا، ثُمَّ يقولونَ: رَبَّنا لَم نَذَرْ فيها خَيرًا. وكانَ أبو سَعيدٍ الخُدريُّ يقولُ: إن لَم تُصَدِّقوني بهذا الحَديثِ فاقرَؤوا إن شِئتُم: {إنَّ اللهَ لا يَظلِمُ مِثقالَ ذَرَّةٍ وإن تَكُ حَسَنةً يُضاعِفها ويُؤتِ مِن لَدُنْه أجرًا عَظيمًا} [النساء: 40]، فيَقولُ اللهُ عزَّ وجلَّ: شَفَعَتِ المَلائِكةُ، وشَفَعَ النَّبيُّونَ، وشَفَعَ المُؤمِنونَ، ولَم يَبقَ إلَّا أرحَمُ الرَّاحِمينَ، فيَقبِضُ قَبضةً مِنَ النَّارِ، فيُخرِجُ مِنها قَومًا لَم يَعمَلوا خَيرًا قَطُّ قد عادوا حُمَمًا، فيُلقيهم في نَهَرٍ في أفواهِ الجَنَّةِ، يُقالُ له: نَهَرُ الحَياةِ، فيَخرُجونَ كما تَخرُجُ الحِبَّةُ في حَميلِ السَّيلِ، ألا تَرَونَها تَكونُ إلى الحَجَرِ أو إلى الشَّجَرِ، ما يَكونُ إلى الشَّمسِ أُصَيفِرُ وأُخَيضِرُ، وما يَكونُ مِنها إلى الظِّلِّ يَكونُ أبيَضَ؟ فقالوا: يا رَسولَ اللهِ، كَأنَّك كُنتَ تَرعى بالباديةِ! قال: فيَخرُجونَ كاللُّؤلُؤِ في رِقابِهمُ الخَواتِمُ، يَعرِفُهم أهلُ الجَنَّةِ: هؤلاء عُتَقاءُ اللهِ الذينَ أدخَلَهمُ اللهُ الجَنَّةَ بغيرِ عَمَلٍ عَمِلوه، ولا خَيرٍ قدَّموه، ثُمَّ يقولُ: ادخُلوا الجَنَّةَ فما رَأيتُموه فهو لكم، فيَقولونَ: رَبَّنا، أعطَيتَنا ما لَم تُعطِ أحَدًا مِنَ العالَمينَ، فيَقولُ: لكم عِندي أفضَلُ مِن هذا، فيَقولونَ: يا رَبَّنا، أيُّ شيءٍ أفضَلُ مِن هذا؟ فيَقولُ: رِضايَ، فلا أسخَطُ علَيكُم بَعدَه أبَدًا. قال مُسلِمٌ: قَرَأتُ على عيسى بنِ حَمَّادٍ زُغبةَ المِصريِّ هذا الحَديثَ في الشَّفاعةِ، وقُلتُ له: أُحَدِّثُ بهذا الحَديثِ عَنك أنَّك سَمِعتَ مِنَ اللَّيثِ بنِ سَعدٍ، فقال: نَعَم، قُلتُ لعيسى بنِ حَمَّادٍ: أخبَرَكُمُ اللَّيثُ بنُ سَعدٍ، عن خالِدِ بنِ يَزيدَ، عن سَعيدِ بنِ أبي هِلالٍ، عن زَيدِ بنِ أسلَمَ، عن عَطاءِ بنِ يَسارٍ، عن أبي سَعيدٍ الخُدريِّ، أنَّه قال: قُلنا: يا رَسولَ اللهِ، أنَرى رَبَّنا؟ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: هل تُضارُّونَ في رُؤيةِ الشَّمسِ إذا كانَ يَومٌ صَحوٌ؟ قُلنا: لا، وسُقتُ الحَديثَ حتَّى انقَضى آخِرُه، وهو نَحوُ حَديثِ حَفصِ بنِ مَيسَرةَ، وزادَ بَعدَ قَولِه: بغيرِ عَمَلٍ عَمِلوه، ولا قدَمٍ قدَّموه، فيُقالُ لهم: لكم ما رَأيتُم ومِثلُه معهُ. قال أبو سَعيدٍ: بَلَغَني أنَّ الجِسرَ أدَقُّ مِنَ الشَّعرةِ، وأحَدُّ مِنَ السَّيفِ. وليسَ في حَديثِ اللَّيثِ، فيَقولونَ: رَبَّنا أعطَيتَنا ما لَم تُعطِ أحَدًا مِنَ العالَمينَ وما بَعدَه، فأقَرَّ به عيسى بنُ حَمَّادٍ.»","narrator":"أبو سعيد الخدري","source":"صحيح مسلم (183)","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/KOAVhCFo","nameForm":"أرحَمُ الرَّاحِمينَ","scene":"في حديث الرؤية الطويل: سُئل النبي ﷺ: هل نرى ربنا يوم القيامة؟ قال: «نعم»، وذكر اتباع كل أمة ما كانت تعبد، والصراط، ثم إخراج المؤمنين من عرفوا من النار، حتى يقول الله: «شفعت الملائكة وشفع النبيون وشفع المؤمنون ولم يبق إلا أرحم الراحمين» فيقبض قبضة من النار فيخرج قومًا لم يعملوا خيرًا قط.","reason":"بعد أن تنتهي شفاعات الخلق كلها يبقى اسم أرحم الراحمين وحده يُخرج من النار من لم يعمل خيرًا؛ فالاسم آخر رحمة في المشهد وأوسعها، وما عجزت عنه شفاعة الخلق تدركه رحمته.","adds":"آخر ما يبقى في مشهد الإخراج من النار: أرحم الراحمين."},{"i":2,"of":11,"text":"إذا خلُص المؤمنون من النَّارِ وأمِنوا ، ف [ والَّذي نفسي بيدِه ] ما مجادَلةُ أحدِكم لصاحبِه في الحقِّ يكونُ له في الدُّنيا بأشدَّ من مجادلةِ المؤمنين لربَّهم في إخوانِهم الَّذين أُدخِلوا النَّارَ . قال : يقولون : ربَّنا ! إخوانُنا كانوا يُصلُّون معنا ، ويصومون معنا ، ويحُجُّون معنا ، [ ويجاهدون معنا ] ، فأدخلتهم النَّارَ ! قال : فيقولُ : اذهبوا ، فأخرِجوا من عرفتم منهم . فيأتونهم ؛ فيعرِفونهم بصوَرِهم ، لا تأكُلُ النَّارُ صورَهم ، [ لم تغْشَ الوجهَ ] فمنهم من أخذته النَّارُ إلى أنصافِ ساقَيْه ، ومنهم من أخذته إلى كعبَيْه ، [ فيُخرِجون منها بشَرًا كثيرًا ] فيقولون : ربَّنا ! قد أخرجنا من أمرتَنا . قال : ثمَّ [ يعودون فيتكلَّمون ف ] يقولُ : أخرِجوا من كان في قلبِه مثقالُ دينارٍ من الإيمانِ . [ فيُخرِجون خلقًا كثيرًا ] ثمَّ [ يقولون : ربَّنا ! لم نذَرْ فيها أحدًا ممَّن أمرتَنا ثمَّ يقولُ : ارجِعوا ، ف ] من كان في قلبِه وزنُ نصفِ دينارٍ [ فأخرِجوه ، فيُخرِجون خلقًا كثيرًا ، ثمَّ يقولون : ربَّنا لم نذَرْ فيها ممَّن أمرتَنا . . . ] . . حتَّى يقولَ : أخرِجوا من كان في قلبِه مثقالُ ذرَّةٍ [ فيُخرِجون خَلقًا كثيرًا ] قال أبو سعيدٍ : فمن لم يُصدِّقْ بهذا الحديثِ فليقرَأْ هذه الآيةَ :  إِنَّ اللَّهَ لَا يَظْلِمُ مِثْقَالَ ذَرَّةٍ وَإِنْ تَكُ حَسَنَةً يُضَاعِفْهَا وَيُؤْتِ مِنْ لَدُنْهُ أَجْرًا عَظِيمًا  قال : فيقولون : ربَّنا قد أخرجنا من أمرتنا ، فلم يبقَ في النَّارِ أحدٌ فيه خيرٌ ! قال : ثمَّ يقولُ اللهُ : شفَعت الملائكةُ ، وشفَعت الأنبياءُ ، وشفَع المؤمنون ، وبقي أرحمُ الرَّاحمين . قال : فيقبضُ قبضةً من النَّارِ _ أو قال : قبضتَيْن _ ناسًا لم يعمَلوا للهِ خيرًا قطُّ ، قد احتُرِقوا حتَّى صاروا حِمَمًا . قال : فيُؤتَى بهم إلى ماءٍ يُقالُ له : ( الحياةُ ) فيُصبُّ عليهم فينبُتون كما تنبُتُ الحبَّةُ في حَميلِ السَّيلِ ، [ قد رأيتموها إلى جانبِ الصَّخرةِ ، وإلى جانبِ الشَّجرةِ ، فما كان إلى الشَّمسِ منها كان أخضرَ ، وما كان منها إلى الظِّلِّ كان أبيضَ ] . قال : فيخرُجون من أجسادِهم مثلُ اللُّؤلؤِ ، وفي أعناقِهم الخاتمُ ، ( وفي روايةٍ : الخواتمُ ) عُتَقاءُ اللهِ . قال : فيُقالُ لهم : ادخُلوا الجنَّة ؛ فما تمنَّيتم ورأيتم من شيءٍ فهو لكم [ ومثلُه معه ] ، [ فيقولُ أهلُ الجنَّةِ : هؤلاء عُتَقاءُ الرَّحمنِ ، أدخلهم الجنَّةَ بغيرِ عملٍ عمِلوه ، ولا خيرٍ قدَّموه ] قال : فيقولون : ربَّنا ! أعطيْتَنا ما لم تُعطِ أحدًا من العالمين ! قال : فيقولُ : فإنَّ لكم عندي أفضلَ منه ! فيقولون : ربَّنا ! وما أفضلُ من ذلك ؟ [ قال : ] فيقولُ : رضائي عنكم ، فلا أسخَطُ عليكم أبدًا","narrator":"أبو سعيد الخدري","source":"حكم تارك الصلاة 27","grade":"صحيح","judgment":"إسناده صحيح على شرط الشيخين","url":"https://dorar.net/h/cUIB3veM","nameForm":"أرحَمُ الرَّاحِمينَ","scene":"قال النبي ﷺ: «إذا خلص المؤمنون من النار وأمنوا فما مجادلة أحدكم لصاحبه في الحق في الدنيا بأشد من مجادلة المؤمنين لربهم في إخوانهم الذين أُدخلوا النار، يقولون: ربنا إخواننا كانوا يصلون معنا ويصومون معنا فأدخلتهم النار، فيقول: اذهبوا فأخرجوا من عرفتم»، ثم يقول الله ما يقول في آخره من إخراج البقية برحمته.","reason":"المؤمنون يجادلون ربهم في إخوانهم فيُجابون، ثم يتولى أرحم الراحمين إخراج من بقي؛ فالرحمة تعمل على مستويين: شفاعة الإخوان أولًا، ثم رحمة الأرحم بمن لا شفيع له.","adds":"بعد شفاعة الإخوان يتولى أرحم الراحمين من لا شفيع له."},{"i":3,"of":11,"text":"يومَ القيامةِ يشفعُ النَّبيونَ و الملائكةُ و يشفَعُ المؤمنونَ و يبقَى أرحمُ الراحمينَ قال فيقبِضُ قبضةً أو قبضتينِ من النَّارِ خلقًا كثيرًا لم يعمَلوا خيرًا فيَخرُجونَ قد امتَحشوا و صاروا حَممًا فيُصَبُّ عليهم من ماءٍ يُقالُ لهُ ماءُ الحياةِ فيخرجونَ مِن أجسادِهم كأنَّها اللُّؤلؤُ مكتوبٌ من عاتقِه نَحنُ عتقاءُ من النَّارِ","narrator":"أبو سعيد الخدري","source":"تخريج كتاب السنة 527","grade":"صحيح","url":"https://dorar.net/h/EVEa864B","nameForm":"أرحَمُ الرَّاحِمينَ","scene":"قال النبي ﷺ: «يوم القيامة يشفع النبيون والملائكة ويشفع المؤمنون ويبقى أرحم الراحمين، فيقبض قبضة أو قبضتين من النار خلقًا كثيرًا لم يعملوا خيرًا فيخرجون قد امتحشوا وصاروا حممًا، فيُصب عليهم من ماء يقال له ماء الحياة فيخرجون كأنهم اللؤلؤ، مكتوب من عاتقه: نحن عتقاء من النار».","reason":"قبضة من أرحم الراحمين تُخرج خلقًا كثيرًا صاروا حممًا فيعودون كاللؤلؤ؛ فرحمة الاسم لا تكتفي بالإخراج بل تعيد الخلق بماء الحياة، وتكتب على العتقاء نسبتهم إلى الرحمة.","adds":"قبضة أرحم الراحمين تعيد الحمم لؤلؤًا: عتقاء من النار."},{"i":4,"of":11,"text":"كنَّا عِندَ عبدِ اللهِ بنِ مَسعودٍ رَضيَ اللهُ عنه، فذُكِر عِنده الدَّجَّالُ، فقال عبدُ اللهِ بنُ مَسعودٍ: تَفترِقون أيُّها النَّاسُ لخُروجِه على ثَلاثِ فِرَقٍ: فِرقةٍ تَتْبَعُه، وفِرقةٍ تَلْحَقُ بأرضِ آبائِها بمَنابتِ الشِّيحِ، وفِرقةٍ تَأخُذُ شطَّ الفُراتِ يُقاتِلُهم ويُقاتِلونه، حتَّى يَجتمِعَ المؤمنونَ بقُرى الشَّامِ، فيَبْعَثون إليهم طَليعةً فيهم فارسٌ على فرَسٍ أشقَرَ وأبْلَقَ، قال: فيَقتَتِلون، فلا يَرجِعُ منهم بشَرٌ -قال سَلَمةُ: فحَدَّثَني أبو صادقٍ، عن رَبيعةَ بنِ ناجذٍ، أنَّ عبدَ اللهِ بن مَسعودٍ- قال: فرَسٍ أشقَرَ، قال عبْدُ اللهِ: ويَزعُمُ أهلُ الكتابِ أنَّ المسيحَ يَنزِلُ إليه- قال: سَمِعتُه يَذكُرُ عن أهلِ الكتابِ حَديثًا غيْرَ هذا- ثمَّ يَخرُجُ يَأْجوجُ ومَأْجوجُ، فيَمْرَحون في الأرضِ، فيُفسِدون فيها، ثمَّ قَرَأ عبدُ اللهِ: {وَهُمْ مِنْ كُلِّ حَدَبٍ يَنْسِلُونَ} [الأنبياء: 96]. قال: ثمَّ يَبعَثُ اللهُ عليهم دابَّةً مِثلَ هذا النَّغَفِ، فتَلِجُ في أسماعِهم ومَناخِرِهم، فيَموتون منها، فتَنْتُنُ الأرضُ منهم، قال: ثمَّ يَبعَثُ اللهُ رِيحًا فيها زَمْهريرٌ باردةٌ، فلمْ تَدَعْ على وجْهِ الأرضِ مُؤمنًا إلَّا كَفَتْه تلكَ الرِّيحُ، قال: ثمَّ تَقومُ السَّاعةُ على شِرارِ النَّاسِ، ثمَّ يقومُ الملَكُ بالصُّورِ بيْن السَّماءِ والأرضِ، فيَنفُخُ فيه -والصُّورُ قَرْنٌ- فلا يَبْقى خلْقٌ في السَّمواتِ والأرضِ إلَّا مات، إلَّا مَن شاء ربُّكَ، ثمَّ يكونُ بيْن النَّفختينِ ما شاء اللهُ أنْ يكونَ، فليْس مِن بَني آدَمَ خَلْقٌ إلَّا منه شَيءٌ. قال: فيُرسِلُ اللهُ ماءً مِن تحْتِ العرشِ كمَنيِّ الرِّجالِ، فتَنبُتُ لُحمانُهم وجُثمانُهم مِن ذلكَ الماءِ، كما يُنبِتُ الأرضُ مِنَ الثَّرى، ثمَّ قَرَأ عبدُ اللهِ: {وَاللَّهُ الَّذِي أَرْسَلَ الرِّيَاحَ فَتُثِيرُ سَحَابًا فَسُقْنَاهُ إِلَى بَلَدٍ مَيِّتٍ فَأَحْيَيْنَا بِهِ الْأَرْضَ بَعْدَ مَوْتِهَا كَذَلِكَ النُّشُورُ} [فاطر: 9]، قال: ثمَّ يقومُ ملَكٌ بالصُّورِ بيْن السَّماءِ والأرضِ، فيَنفُخُ فيه، فيَنطلِقُ كلُّ نفْسٍ إلى جسَدِها حتَّى تَدخُلَ فيه، ثمَّ يَقومون، فيَحْيَون حياةَ رجُلٍ واحدٍ قِيامًا لربِّ العالَمِين. قال: ثمَّ يَتمثَّلُ اللهُ تعالَى إلى الخلْقِ فيَلْقاهم، فليْس أحدٌ يَعبُدُ مِن دونِ اللهِ شَيئًا إلَّا وهو مَرفوعٌ له يَتْبَعُه، قال: فيَلْقى، قال: فيَقولُ: مَن تَعبِدون؟ قال: فيَقولُون: نَعبُدُ عُزَيرًا، قال: هلْ يَسُرُّكم الماءُ؟ فيَقولُون: نعمْ، فيُرِيهم جَهنَّمَ كهَيئةِ السَّرابِ، قال: ثمَّ قَرَأ عبدُ اللهِ: {وَعَرَضْنَا جَهَنَّمَ يَوْمَئِذٍ لِلْكَافِرِينَ عَرْضًا} [الكهف: 100]. قال: ثمَّ يَلْقى النَّصارى فيَقولُ: مَن تَعبُدون؟ فيَقولُون: المسيحَ، قال: فيَقولُ: هلْ يَسُرُّكم الماءُ؟ قال: فيَقولُون: نعمْ، قال: فيُرِيهم جَهنَّمَ كهَيئةِ السَّرابِ، ثمَّ كذلكَ لمَن كان يَعبُدُ مِن دونِ اللهِ شَيئًا، قال: ثمَّ قَرَأ عبدُ اللهِ: {وَقِفُوهُمْ إِنَّهُمْ مَسْئُولُونَ} [الصافات: 24]. قال: ثمَّ يَتمثَّلُ اللهُ تعالَى للخلْقِ حتَّى يَمُرَّ المسْلِمون، قال: فيَقولُ: مَن تَعبُدون؟ فيَقولُون: نَعبُدُ اللهَ ولا نُشرِكُ به شَيئًا، فيَنتَهِرُهم مرَّتينِ أو ثلاثًا، فيَقولُ: مَن تَعبُدون؟ فيَقولُون: نَعبُدُ اللهَ ولا نُشرِكُ به شَيئًا، قال: فيَقولُ: هلْ تَعرِفون ربَّكم؟ قال: فيَقولُون: سُبحانه! إذا اعتَرَفَ لنا عَرَفْناه، قال: فعِندَ ذلكَ يُكشَفُ عن ساقٍ، فلا يَبْقى مُؤمنٌ إلَّا خَرَّ للهِ ساجدًا، ويَبْقى المنافِقون ظُهورُهم طبَقًا واحدًا كأنَّما فيها السَّفافيدُ، قال: فيَقولُون: ربَّنا، فيَقولُ: قدْ كُنتم تُدْعَون إلى السُّجودِ وأنتُم سالِمون. قال: ثمَّ يَأمُرُ بالصِّراطِ فيُضرَبُ على جَهنَّمَ، فيَمُرُّ النَّاسُ كقدْرِ أعمالِهم زُمَرًا؛ كلمْحِ البَرْقِ، ثمَّ كمَرِّ الرِّيحِ، ثمَّ كمَرِّ الطَّيرِ، ثمَّ كأسرَعِ البهائمِ، ثمَّ كذلكَ حتَّى يَمُرَّ الرَّجلُ سَعيًا ثمَّ مَشْيًا، ثمَّ يكونُ آخِرُهم رجُلًا يَتلبَّطُ على بَطنِه، قال: فيَقولُ: أيْ ربِّ، لِماذا أبطَأْتَ بي؟ فيَقولُ: لمْ أُبْطِئْ بكَ، إنَّما أبطَأَ بكَ عَملُكَ. قال: ثمَّ يَأذَنُ اللهُ تعالَى في الشَّفاعةِ، فيكونُ أوَّلُ شافعٍ رُوحَ القُدسِ جِبريلَ عليه السَّلامُ، ثمَّ إبراهيمَ خَليلَ اللهِ، ثمَّ مُوسى، ثمَّ عِيسى عليهما السَّلامُ، قال: ثمَّ يقومُ نبيُّكم رابعًا، لا يَشفَعُ أحدٌ بعْدَه فيما يَشفَعُ فيه، وهو المقامُ المحمودُ الَّذي ذَكَره اللهُ تبارَك وتعالَى: {عَسَى أَنْ يَبْعَثَكَ رَبُّكَ مَقَامًا مَحْمُودًا} [الإسراء: 79]. قال: فليْس مِن نفْسٍ إلَّا وهي تَنظُرُ إلى بَيتٍ في الجنَّة أو بَيتٍ في النَّارِ، قال: وهو يوْمُ الحسْرةِ. قال: فيَرى أهلُ النَّارِ البيتَ الَّذي في الجنَّةِ، ثمَّ يُقالُ: لوْ عَمِلْتُم، قال: فتَأخُذُهم الحسرةُ، قال: ويَرى أهلُ الجنَّةِ البيتَ الَّذي في النَّارِ، فيُقالُ: لوْلا أنَّ مَنَّ اللهُ عليكم، قال: ثمَّ يَشفَعُ الملائكةُ والنَّبيُّون والشُّهداءُ والصَّالِحون والمؤمنونَ، فيُشَفِّعُهم اللهُ، قال: ثمَّ يَقولُ اللهُ: أنا أرحَمُ الرَّاحمينَ، فيُخرِجُ مِنَ النَّارِ أكثَرَ ممَّا أخْرَجَ مِن جَميعِ الخلْقِ برَحمتِه، قال: ثمَّ يَقولُ: أنا أرحَمُ الرَّاحمينَ. قال: ثمَّ قَرَأ عبدُ اللهِ: {مَا سَلَكَكُمْ فِي سَقَرَ * قَالُوا لَمْ نَكُ مِنَ الْمُصَلِّينَ * وَلَمْ نَكُ نُطْعِمُ الْمِسْكِينَ * وَكُنَّا نَخُوضُ مَعَ الْخَائِضِينَ * وَكُنَّا نُكَذِّبُ بِيَوْمِ الدِّينِ} [المدثر: 42-46]، قال: فعقَدَ عبدُ اللهِ بيَدِه أربعًا، ثمَّ قال: هلْ تَرَون في هؤلاء مِن خيرٍ؟ ما يَنزِلُ فيها أحدٌ فيه خَيرٌ، فإذا أراد اللهُ عزَّ وجلَّ ألَّا يَخرُجَ منها أحدٌ غيَّرَ وُجوهَهم وألْوانَهم، قال: فيَجِيءُ الرَّجلُ فيَنظُرُ ولا يَعرِفُ أحدًا، فيُناديه الرَّجلُ فيَقولُ: يا فُلانُ، أنا فلانٌ، فيَقولُ: ما أعْرِفُكَ، فعندَ ذلكَ يَقولُون: {رَبَّنَا أَخْرِجْنَا مِنْهَا فَإِنْ عُدْنَا فَإِنَّا ظَالِمُونَ} [المؤمنون: 107]، فيَقولُ عِندَ ذلك: {اخْسَئُوا فِيهَا وَلَا تُكَلِّمُونِ} [المؤمنون: 108]، فإذا قال ذلكَ أُطبِقَت عليهم، فلا يَخرُجُ منهم بشَرٌ.","narrator":"أبو  الزعراء","source":"المستدرك على الصحيحين 8743","grade":"صحيح","judgment":"صحيح على شرط الشيخين، ولم يخرجاه","url":"https://dorar.net/h/vLdeeegX","nameForm":"أرحَمُ الرَّاحمينَ ؛ أرحَمُ الرَّاحمينَ","scene":"عند ابن مسعود يُذكر الدجال، فيحدّث عن الفرق الثلاث ثم عن يوم القيامة: تشفع الملائكة والنبيون والشهداء والصالحون والمؤمنون فيشفّعهم الله، «ثم يقول الله: أنا أرحم الراحمين، فيخرج من النار أكثر مما أخرج من جميع الخلق برحمته، ثم يقول: أنا أرحم الراحمين» — ثم يقرأ ابن مسعود ﴿مَا سَلَكَكُمْ فِي سَقَرَ﴾.","reason":"هنا يقول الله الاسم عن نفسه مرتين، والفعل بينهما: إخراجٌ يفوق ما أخرجه الشافعون كلهم. فالاسم يُذكر قبل الفعل تعريفًا، وبعده تفسيرًا: هذا الإخراج الزائد هو معنى «أرحم الراحمين». والمقارنة العددية «أكثر مما أخرج من جميع الخلق» تُترجم صيغة التفضيل إلى واقع.","adds":"يُري الشاهد أن الاسم ينطق به الله بنفسه، وأن رحمته وحده أكثر حصادًا من رحمة الخلق مجتمعين."},{"i":5,"of":11,"text":"لَمَّا خرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ إلى أُحدٍ وقَعَ اليَمانُ بنُ حِسْلِ بنِ جابِرٍ أبو حُذَيفةَ، وثابِتُ بنُ وَقشِ بنِ زَعوراءَ في الآطامِ معَ النِّساءِ والصِّبْيانِ، فقالَ أحَدُهما لصاحِبِه وهُما شَيْخانِ كَبيرانِ: لا أبا لكَ، ما نَنتَظِرُ، فواللهِ ما بَقيَ لواحِدٍ منَّا من عُمرِه إلَّا ظَمأٌ، إنَّما نحن هامةُ القَومِ، ألَا نأخُذُ أسْيافَنا ثمَّ نَلحَقُ برَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فدخَلَا في المُسلِمينَ ولا يَعلَمونَ بهِما، فأمَّا ثابِتُ بنُ وَقْشٍ فقَتَلَه المُشْرِكونَ، وأمَّا أبو حُذَيْفةَ فاختَلَفَتْ عليه أسْيافُ المُسْلِمينَ، فقَتَلوه ولا يَعْرِفونَه، فقالَ حُذَيْفةُ: أبي أبي، فقالوا: واللهِ إنْ عَرَفْناه، وصُدِّقوا، فقالَ حُذَيْفةُ: يَغفِرُ اللهُ لكم وهو أرحَمُ الرَّاحِمينَ، فأرادَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ أنْ يَدِيَه، فتَصدَّقَ به حُذَيفةُ على المُسْلِمينَ، فزادَه ذلك عندَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ.","narrator":"محمود بن لبيد","source":"المستدرك على الصحيحين 4978","grade":"صحيح","judgment":"صحيح على شرط مسلم","url":"https://dorar.net/h/zlsXsGwM","nameForm":"أرحَمُ الرَّاحِمينَ","scene":"يوم أُحد كان اليمان أبو حذيفة وثابت بن وقش — شيخين كبيرين — في الآطام مع النساء والصبيان. فقال أحدهما لصاحبه: ما ننتظر؟ فأخذا أسيافهما ولحقا برسول الله ﷺ. فقتل المشركون ثابتًا، وأما أبو حذيفة فاختلفت عليه أسياف المسلمين فقتلوه ولا يعرفونه. فصاح حذيفة: «أبي أبي». قالوا: والله إن عرفناه. فقال حذيفة: «يغفر الله لكم وهو أرحم الراحمين». فأراد النبي ﷺ أن يديه، فتصدق حذيفة بديته على المسلمين، فزاده ذلك عند رسول الله ﷺ.","reason":"لحظةُ مقتل الأب خطأً بأيدي الإخوة: أشدّ ما يُطلب فيه العفو من إنسان. فاختار حذيفة الاسم الذي يسع الموقف: لم يقل: الله غفور، بل «وهو أرحم الراحمين» — كأنه يقول: أنا أرحمكم بالعفو، وهو أرحم مني بكم وبأبي. فالاسم هنا حجةُ الراحم على نفسه ليرحم: من علم أن الله أرحم الراحمين لم يعسر عليه أن يكون من الراحمين.","adds":"يُخرج الشاهد الاسم من الآخرة إلى ساعة المصاب: يقوله الابن على دم أبيه. ويُري ثمرته العملية: عفوٌ ثم صدقةٌ بالدية، وثوابٌ عند النبي ﷺ. فالاسم يُعلّم كيف يُعفى."},{"i":6,"of":11,"text":"أصبَحَ رَسولُ اللَّهِ صلَّى اللهُ عليه وسلَّم ذاتَ يَومٍ، فصَلَّى الغَداةَ، ثُمَّ جَلَسَ، حَتَّى إذا كانَ مِنَ الصُّبحِ ضَحِكَ رَسولُ اللَّهِ صلَّى اللهُ عليه وسلَّم، ثُمَّ جَلَسَ مَكانَه، حَتَّى صَلَّى الأولى والعَصرَ والمَغرِبَ، كُلَّ ذلك لا يَتَكَلَّمُ، حَتَّى صَلَّى العِشاءَ الآخِرةَ، ثُمَّ قامَ إلى أهلِه، فقال النَّاسُ لأبي بَكرٍ: ألا تَسألُ رَسولَ اللَّهِ صلَّى اللهُ عليه وسلَّم: ما شَأنُه؟ صَنَعَ اليَومَ شَيئًا لَم يَصنَعْه قَطُّ! فسَألَه، فقال: نَعَم، عُرِضَ عليَّ ما هو كائِنٌ مِن أمرِ الدُّنيا وأمرِ الآخِرةِ، يُجمَعُ الأوَّلونَ والآخِرونَ بصَعيدٍ واحِدٍ، فقَطَعَ النَّاسُ بذلك، حَتَّى انطَلَقوا إلى آدَمَ -والعَرَقُ يَكادُ يُلجِمُهم- فقالوا: يا آدَمُ، أنتَ أبو البَشَرِ، وأنتَ اصطَفاكَ اللَّهُ، اشفَعْ لَنا إلى رَبِّكَ. فقال: لَقد لَقيتُ مِثلَ الذي لَقيتُم، فانطَلِقوا إلى أبيكُم بَعدَ أبيكُم: إلى نوحٍ {إنَّ اللَّهَ اصطَفى آدَمَ ونوحًا وآلَ إبراهيمَ وآلَ عِمرانَ على العالَمينَ} [آل عمران: 33]. قال: فيَنطَلِقونَ إلى نوحٍ عليه السَّلامُ فيَقولونَ: اشفَعْ لَنا إلى رَبِّكَ، فأنتَ اصطَفاكَ اللَّهُ، واستَجابَ لَكَ في دُعائِكَ، ولَم يَدَعْ على الأرضِ مِنَ الكافِرينَ دَيَّارًا. فيَقولُ: ليس ذلك عِندي، انطَلِقوا إلى إبراهيمَ؛ فإنَّ اللَّهَ اتَّخَذَه خَليلًا. فيَنطَلِقونَ إلى إبراهيمَ فيَقولُ: ليس ذلكم عِندي، انطَلِقوا إلى موسى؛ فإنَّ اللَّهَ كَلَّمَه تَكليمًا. فيَقولُ موسى: ليس ذلكم عِندي، انطَلِقوا إلى عيسى ابنِ مَريَمَ؛ فإنَّه يُبرِئُ الأكمَهَ والأبرَصَ ويُحيي المَوتى. فيَقولُ عيسى: ليس ذلكم عِندي، ولَكِنِ انطَلِقوا إلى سَيِّدِ ولَدِ آدَمَ؛ فإنَّه أوَّلُ مَن تَنشَقُّ (عنه الأرضُ) يَومَ القيامةِ، انطَلِقوا إلى مُحَمَّدٍ فيَشفَعَ لَكُم إلى رَبِّكُم. قال: فيَنطَلِقُ (فيُنادي جِبريل، قال): فيَأتي جِبريلُ رَبَّه عَزَّ وجَلَّ، قال: فيَنطَلِقُ فيَأتي جِبريلُ رَبَّه تَعالى، فيَقولُ اللَّهُ تَعالى: (ائذَنْ لَه، وبَشِّرْهُ بالجَنَّةِ). قال: فيَنطَلِقُ به جِبريلُ فيَخِرُّ ساجِدًا قَدرَ جُمُعةٍ، ويَقولُ اللَّهُ عَزَّ وجَلَّ: (ارفَعْ رَأسَكَ [يا مُحَمَّدُ] وقُلْ يُسمَعْ، واشفَعْ تُشَفَّعْ). قال: فيَرفَعُ رَأسَه، فإذا نَظَرَ إلى رَبِّه عَزَّ وجَلَّ خَرَّ ساجِدًا قَدرَ جُمُعةٍ أُخرى، فيَقولُ اللَّهُ عَزَّ وجَلَّ: (ارفَعْ رَأسَكَ، وقُلْ يُسمَعْ، واشفَعْ تُشَفَّعْ). قال: فيَذهَبُ ليَقَعَ ساجِدًا، فيَأخُذُ جِبريلُ بضَبعَيه فيَفتَحُ عليه مِنَ الدُّعاءِ شَيئًا لَم يَفتَحْه على بَشَرٍ، فيَقولُ: أي رَبِّ، خَلَقتَني سَيِّدَ ولَدِ آدَمَ ولا فخرَ، وأوَّلَ مَن تَنشَقُّ عنه الأرضُ يَومَ القيامةِ ولا فَخرَ، حَتَّى إنَّه لَيَرِدُ عليَّ الحَوضَ أكثَرُ مِمَّا بَينَ صَنعاءَ وأَيلةَ. ثُمَّ يُقالُ: ادعوا الصِّدِّيقينَ. فيَشفَعونَ، ثُمَّ يُقالُ: ادعوا الأنبياءَ. قال: فيَجيءُ النَّبيُّ مَعَه العِصابةُ، والنَّبيُّ مَعَه الخَمسةُ والسِّتَّةُ، والنَّبيُّ ليس مَعَه أحَدٌ، ثُمَّ يُقالُ: ادعوا الشُّهَداءَ. فيَشفَعونَ لمَن أرادوا، قال: فإذا فعَلَتِ الشُّهَداءُ ذلك، قال: يَقولُ اللَّهُ عَزَّ وجَلَّ: (أنا أرحَمُ الرَّاحِمينَ، أدخِلوا جَنَّتي مَن كانَ لا يُشرِكُ بي شَيئًا). قال: فيَدخُلونَ الجَنَّةَ، قال: ثُمَّ يَقولُ اللَّهُ عَزَّ وجَلَّ: (انظُروا في النَّارِ، هَل تَلقَونَ مِن أحَدٍ عَمِلَ خَيرًا قَطُّ؟). قال: فيَجِدونَ في النَّارِ رَجُلًا، فيَقولُ لَه: هَل عَمِلتَ خَيرًا قَطُّ؟ فيَقولُ: لا، غَيرَ أنِّي كُنتُ أُسامِحُ النَّاسَ في البَيعِ. فيَقولُ اللَّه: (أسمِحوا لعَبدي كَإسماحِه إلى عَبيدي). ثُمَّ يُخرِجونَ مِنَ النَّارِ رَجُلًا، فيَقولُ لَه: هَل عَمِلتَ خَيرًا قَطُّ؟ فيَقولُ: لا، غَيرَ أنِّي قد أمَرتُ ولَدي: إذا مُتُّ فأحرِقوني بالنَّارِ، ثُمَّ اطحَنوني، حَتَّى إذا كُنتُ مِثلَ الكُحلِ فاذهَبوا بي إلى البَحرِ، فاذْرُوني في الرِّيحِ، فواللَّهِ لا يَقدِرُ عليَّ رَبُّ العالَمينَ أبَدًا. فقال اللَّهُ تَعالى: (لمَ فعَلتَ ذلك؟) قال: مِن مَخافَتِكَ. قال: فيَقولُ اللَّهُ عَزَّ وجَلَّ: (انظُرْ إلى مُلكِ أعظَمِ مَلِكٍ؛ فإنَّ لَكَ مِثلَه وعَشَرةَ أمثالِه)، قال: فيَقولُ: لمَ تَسخَرُ بي وأنتَ المَلِكُ؟ قال: (يَعني: رَسولَ اللَّهِ صلَّى اللهُ عليه وسلَّم): (وذلك الذي ضَحِكتُ منه مِنَ الضُّحى)","narrator":"حذيفة","source":"مسند أبي بكر الصديق 700","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/On8AXZvT","nameForm":"أرحَمُ الرَّاحِمينَ","scene":"حديث حذيفة الطويل عن اليوم الذي ضحك فيه النبي ﷺ بعد الفجر ثم صمت حتى المغرب، ثم حدّث عن يوم القيامة: يُدعى الأنبياء ومعهم العصابات والخمسة والستة والنبي ليس معه أحد، ثم الشهداء فيشفعون، «فإذا فعلت الشهداء ذلك يقول الله: أنا أرحم الراحمين، أدخلوا جنتي من كان لا يشرك بي شيئًا، فيدخلون الجنة، ثم يقول: انظروا في النار هل تلقون من أحدٍ عمل خيرًا قط؟».","reason":"الاسم يُقال بعد شفاعة الشهداء مباشرةً، وبعده أمرٌ بمقياسٍ واحد: «من كان لا يشرك بي شيئًا». فأرحم الراحمين لا يشترط عملًا بل توحيدًا؛ ثم يبحث في النار عمّن عمل خيرًا قط — أي إن الاسم يفتّش عن أدنى سبب ليرحم. فصيغة التفضيل تتجلى في تنازل الشرط: الشهداء يشفعون «لمن أرادوا»، والله يرحم من لم يشرك.","adds":"يُبيّن الشاهد أن معيار «أرحم الراحمين» التوحيد المحض، وأنه يبحث في النار عن أي خيرٍ ليخرج صاحبه — فالسنة تُري الاسم يعمل تفتيشًا لا انتظارًا."},{"i":7,"of":11,"text":"«لمَّا ماتَ أبو طالِبٍ خَرَجَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ إلى الطَّائِفِ ماشِيًا على قَدَمَيه، فدَعا لهم إلى اللهِ، فلم يُجيبوه، فأتى ظِلَّ شَجَرةٍ فصلَّى تحتَها رَكْعتَينِ، ثُمَّ قالَ: اللَّهُمَّ إليك أَشْكو ضَعْفي وهَواني على النَّاسِ، أَرحَمَ الرَّاحِمينَ إلى مَن تَكِلُني، إلى بَعيدٍ يَتَجَهَّمُني أم إلى قَريبٍ مَلَّكْتَه أمْري، فإن لم تكنْ ساخِطًا عليَّ فلا أُبالي، لك العُتْبى حتَّى تَرْضى، ولا حَوْلَ ولا قُوَّةَ إلَّا بك، أَعوذُ بنورِ وَجْهِك الكَريمِ الَّذي أضاءَتْ له السَّمواتُ وأَشرَقَتْ له الظُّلُماتُ وصَلَحَ عليه أمْرُ الدُّنْيا والآخِرةِ أن يَنزِلَ عليَّ غَضَبُك أو يَحِلَّ عليَّ سَخَطُك».\nوفي رِوايةٍ: لمَّا تُوفِّيَ أبو طالِبٍ، وعِنْدَه: فدَعاهم إلى الإسْلامِ فلم يُجيبوه، فانْصَرَفَ، فأتى ظِلَّ شَجَرةٍ فصلَّى رَكْعَتَينِ، ثُمَّ قالَ: اللَّهُمَّ إليك أَشْكو ضَعْفَ قُوَّتي وقِلَّةَ حيلتي وهَواني على النَّاسِ، أَرحَمَ الرَّاحِمينَ أنت أَرحَمُ الرَّاحِمينَ إلى مَن تَكِلُني إلى عَدُوٍّ يَتَجَهَّمُني أم إلى قَريبٍ مَلَّكْتَه أمْري، إن لم تكنْ غَضبانَ عليَّ فلا أُبالي، غَيْرَ أنَّ عافيتَك أَوْسَعُ لي، أَعوذُ بنورِ وَجْهِك الَّذي أَشرَقَتْ له الظُّلُماتُ وصَلَحَ عليه أمْرُ الدُّنْيا والآخِرةِ أن يَنزِلَ بي غَضَبُك أو يَحِلَّ عليَّ سَخَطُك، لك العُتْبى حتَّى تَرْضى، ولا حَوْلَ ولا قُوَّةَ إلَّا بك».","narrator":"عبدالله بن جعفر بن أبي طالب","source":"الأحاديث المختارة 9 / 180","grade":"صحيح","judgment":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","url":"https://dorar.net/h/KoUQeI8l","nameForm":"أَرحَمَ الرَّاحِمينَ ؛ أَرحَمَ الرَّاحِمينَ ؛ أَرحَمُ الرَّاحِمينَ","scene":"بعد موت أبي طالب، يخرج النبي ﷺ إلى الطائف ماشيًا، يدعوهم فلا يجيبونه، فيأتي ظل شجرة فيصلي ركعتين ثم يقول: «اللهم إليك أشكو ضعفي وهواني على الناس، أرحم الراحمين، إلى من تكلني؟ إلى بعيدٍ يتجهّمني أم إلى قريبٍ ملّكته أمري؟ فإن لم تكن ساخطًا عليّ فلا أبالي، لك العتبى حتى ترضى، ولا حول ولا قوة إلا بك، أعوذ بنور وجهك الكريم الذي أضاءت له السماوات…».","reason":"انقطع السند البشري كله: مات العم الحامي، وردّت الطائف، فلم يبقَ إلا الله. والاسم يُنادى به في وسط الشكوى بعد «هواني على الناس» مباشرة: هان على الناس فلم يبقَ راحمٌ منهم، فلجأ إلى من رحمته فوق رحمة الراحمين كلهم. ثم السؤال «إلى من تكلني» يُفسّر النداء: إن كنت أرحم الراحمين فلا تكلني إلى أحد منهم.","adds":"يعطي الشاهد صيغة الدعاء في أقسى وحدة مرّ بها النبي ﷺ، ويعلّم أن الاسم يُنادى به حين يهون العبد على الناس — فالهوان على الخلق طريقٌ إلى أرحم الراحمين."},{"i":8,"of":11,"text":"وقالَ النَّسائيُّ في هذا الحَديث: ولَجَأَتْ صَناديدُ قُرَيْشٍ وعُظَماؤُها إلى الكَعْبةِ -يَعْني دَخَلوا فيها- قالَ: فجاءَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ حتَّى طافَ بالبَيْتِ، فجَعَلَ يَمُرُّ بتلك الأصْنامِ فيَطعَنُها بسِيَةِ القَوْسِ ويَقولُ: {جَاءَ الْحَقُّ وَزَهَقَ الْبَاطِلُ إِنَّ الْبَاطِلَ كَانَ زَهُوقًا}، حتَّى إذا فَرَغَ وصلَّى جاءَ فأخَذَ بعِضادَتَيِ البابِ، ثُمَّ قالَ: \"يا مَعشَرَ قُرَيْشٍ، ما تقَولونَ؟\"، قالوا: نَقولُ: ابنُ أخٍ، وابنُ عَمٍّ، رَحيمٌ كَريمٌ، ثُمَّ أَعادَ عليهم القَوْلَ: قالوا مِثلَ ذلك، قالَ: \"فإنِّي أَقولُ كما قالَ أخي يوسُفُ: {لا تَثْرِيبَ عَلَيْكُمُ الْيَوْمَ يَغْفِرُ اللَّهُ لَكُمْ وَهُوَ أَرْحَمُ الرَّاحِمِينَ}\"، فخَرَجوا فبايَعوه على الإسْلامِ.","narrator":"أبو هريرة","source":"الأحكام الوسطى 3/ 65","grade":"صحيح","judgment":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","url":"https://dorar.net/h/u7x7zZJ7","nameForm":"أَرْحَمُ الرَّاحِمِينَ","scene":"يوم الفتح، لجأت صناديد قريش إلى الكعبة، وطاف النبي ﷺ بالبيت يطعن الأصنام بسية القوس ويقول ﴿جَاءَ الْحَقُّ وَزَهَقَ الْبَاطِلُ﴾، ثم قال: «يا معشر قريش، ما تقولون؟» قالوا: نقول ابن أخٍ وابن عمٍّ رحيمٌ كريم — مرتين. فقال: «فإني أقول كما قال أخي يوسف: ﴿لَا تَثْرِيبَ عَلَيْكُمُ الْيَوْمَ يَغْفِرُ اللَّهُ لَكُمْ وَهُوَ أَرْحَمُ الرَّاحِمِينَ﴾» — فخرجوا فبايعوه على الإسلام.","reason":"قريش استعطفت النبي ﷺ برحمته هو: «رحيم كريم». فردّ الرحمة إلى مصدرها: أنا أعفو، والمغفرة من الله «وهو أرحم الراحمين» — فرحمة الفاتح بالمغلوبين فرعٌ من رحمة أرحم الراحمين، والعفو الإنساني يُنسب إلى الاسم الإلهي. واختيار آية يوسف يجعل الاسم عهدًا بين نبيَّين: كلاهما عفا عن إخوته بأرحم الراحمين.","adds":"يُري الشاهد الاسم في لحظة القدرة على الانتقام: من ملك خصمه فليذكر أرحم الراحمين — وثمرة الاسم مشهودة: «فخرجوا فبايعوه على الإسلام»."},{"i":9,"of":11,"text":"أتى النَّبيَّ - صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ - رجلٌ ومعَهُ صبيٌّ ، فجعلَ يضمُّهُ إليهِ ، فقالَ النَّبيُّ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ: أترحمُهُ ؟ قالَ: نعَم ، قالَ: فاللَّهُ أرحَمُ بِكَ منكَ بِهِ ، وَهوَ أرحمُ الرَّاحمينَ .","narrator":"أبو هريرة","source":"الصحيح المسند 1411","grade":"صحيح","url":"https://dorar.net/h/Rsy3lIUQ","nameForm":"أرحمُ الرَّاحمينَ","scene":"رجلٌ يأتي النبي ﷺ ومعه صبيٌّ يضمّه إليه. فيقول النبي ﷺ: «أترحمه؟» قال: نعم. قال: «فالله أرحم بك منك به، وهو أرحم الراحمين».","reason":"أقرب رحمةٍ يعرفها الإنسان رحمة الأب بولده وهو يضمّه؛ فجعلها النبي ﷺ مقياسًا ثم تجاوزها: الله أرحم بك من رحمتك التي تراها الآن بين يديك. فالاسم يُشرح بأقرب تجربة حسية، وصيغة التفضيل تُعقل بالمقارنة: إن كانت رحمتك بابنك هكذا، فرحمة أرحم الراحمين بك فوقها.","adds":"يقدّم الشاهد أبسط طريق لفهم الاسم: قِسْ على رحمتك بولدك ثم ارفع بلا حد. وهو اسمٌ يُقال للآباء ليطمئنوا على أنفسهم قبل أولادهم."},{"i":10,"of":11,"text":"إنَّ للهِ تعالَى مَلَكًا مُوَكَّلًا بمَن يقولُ : يا أرحمَ الراحمينَ ! فمَن قالها ثلاثًا قال له المَلَكُ : إنَّ أرحمَ الراحمينَ قد أقبل عليك فسَلْ","narrator":"أبو أمامة الباهلي","source":"الجامع الصغير (4/ 40)","grade":"صحيح","url":"https://dorar.net/h/lexOqe03","nameForm":"أرحمَ الراحمينَ ؛ أرحمَ الراحمينَ","scene":"«إن لله تعالى ملكًا موكلًا بمن يقول: يا أرحم الراحمين، فمن قالها ثلاثًا قال له الملك: إن أرحم الراحمين قد أقبل عليك فسل».","reason":"النداء بالاسم له أثرٌ خاص: ملكٌ موكّل به. والعدد ثلاث يدل على الإلحاح، وجواب الملك «قد أقبل عليك فسل» يفسّر الاسم: أرحم الراحمين يُقبل على من ناداه قبل أن يسأل. فهذا الاسم مفتاح إقبالٍ يسبق المسألة.","adds":"يعطي الشاهد صيغةً وعددًا: «يا أرحم الراحمين» ثلاثًا قبل السؤال — أدبٌ نبوي في افتتاح الطلب."},{"i":11,"of":11,"text":"إنَّ للهِ عزَّ وجَلَّ لَوحًا من زَبَرجَدةٍ خَضراءَ تحتَ العَرشِ كُتِب فيه: أنا اللهُ لا إلهَ إلَّا أنا أرحَمُ الرَّاحمين، خَلَقتُ بِضعةَ عَشَرَ وثلاثَ مِئةِ خُلُقٍ، من جاء بخُلُقٍ منها مع شهادةِ أنْ لا إلهَ إلَّا اللهُ دَخَل الجنَّةَ","narrator":"-","source":"فيض القدير 2/ 482","grade":"حسن","judgment":"إسناده حسن","url":"https://dorar.net/h/2uzqAiDN","nameForm":"أرحَمُ الرَّاحمين","scene":"«إن لله عز وجل لوحًا من زبرجدة خضراء تحت العرش كُتب فيه: أنا الله لا إله إلا أنا أرحم الراحمين، خلقت بضعة عشر وثلاثمائة خُلق، من جاء بخلقٍ منها مع شهادة أن لا إله إلا الله دخل الجنة». إسناده حسن كما في فيض القدير.","reason":"الاسم مكتوبٌ تحت العرش بعد التوحيد مباشرة: «لا إله إلا أنا أرحم الراحمين» — ثم يُذكر بعده باب دخول الجنة بخلقٍ واحد مع التوحيد. فالمناسبة أن الرحمة الفائقة هي التي تقبل خُلقًا واحدًا من ثلاثمائة، وأن الاسم مقترن بالتوحيد كتابةً.","adds":"يُظهر الشاهد الاسم مكتوبًا لا منطوقًا، وموضعه تحت العرش، ويفتح بابًا عمليًّا: خُلقٌ واحد مع التوحيد يكفي عند أرحم الراحمين."}],"sunnah":{"card":"الصيغة: أَرْحَمُ الرَّاحِمِينَ — مركّبة (أفعل تفضيل مضاف)\nفي السنة: 9 شواهد (13 رواية)\nخصوصية الورود في السنة: الاسم في السنة اسمُ آخر الشفاعات يوم القيامة: يشفع الملائكة والنبيون والمؤمنون «ولم يبق إلا أرحم الراحمين» فيقبض قبضةً من النار (صحيح مسلم)، ويقوله الله عن نفسه: «أنا أرحم الراحمين» فيُخرج أكثر مما أخرج الجميع. وهو اسم دعاء الطائف حين انقطع كل سند، واسم عفو الفتح، واسم حذيفة حين قُتل أبوه بأيدي المسلمين خطأً، ومَلَكٌ موكّلٌ بمن يقوله ثلاثًا. فهو في السنة الرحمةُ التي تبقى بعد نفاد كل رحمة.\nالمعنى المختصر: الذي رحمته فوق رحمة كل راحم، بلا حدٍّ ولا شرط.","teaches":"1. أن رحمته تبقى بعد نفاد رحمة كل راحم: تُخرج من النار من لم يعمل خيرًا قط.\n2. أنه أرحم بك من الأب بولده الذي يضمّه.\n3. أنه يُقبل على من ناداه بهذا الاسم قبل أن يسأل.\n4. أنه يقبل التوحيد المحض بلا اشتراط عمل، ويفتّش في النار عن أدنى خير.\n5. أن العفو عن الناس فرعٌ من الإيمان بأنه أرحم الراحمين: حذيفة على دم أبيه، والنبي ﷺ يوم الفتح.","whenRecall":"- حين تهون على الناس وينقطع سندك: دعاء الطائف.\n- حين تملك من ظلمك: كلمة الفتح.\n- حين يُقتل لك حق خطأً أو يُظلم من تحب: كلمة حذيفة.\n- حين تضم ولدك: الله أرحم بك منك به.\n- قبل أن تسأل: «يا أرحم الراحمين» ثلاثًا.\n- حين ترى نفسك بلا عملٍ يشفع لك.","whenPray":"عند الشعور بـ:\n1. الهوان على الناس وانقطاع كل سند.\n2. اليأس من العمل والخوف ألا يشفع لك أحد.\n3. الغضب على من ظلمك وأنت قادر عليه.\nعند طلب:\n1. أن يُقبل الله عليك قبل السؤال.\n2. العفو والرحمة في الآخرة بلا حساب على قلة العمل.\n3. أن يرحم من تحب حيث عجزت.\nعند الرغبة في:\n1. العفو عن الناس كما عفا حذيفة والنبي ﷺ.\n2. تربية ولدك على أن الله أرحم به منك.","duaItems":"1. «يا أرحم الراحمين» ثلاثًا قبل السؤال — الجامع الصغير 4/40 (صحيح).\n2. دعاء الطائف: «اللهم إليك أشكو ضعفي وهواني على الناس، أرحم الراحمين، إلى من تكلني؟…» — الأحاديث المختارة 9/180.\n3. كلمة العفو: «لا تثريب عليكم اليوم يغفر الله لكم وهو أرحم الراحمين» — الأحكام الوسطى 3/65، وهي آية يوسف 92 على لسان النبي ﷺ يوم الفتح.\n4. «يغفر الله لكم وهو أرحم الراحمين» — كلمة حذيفة في قتلة أبيه خطأً — المستدرك 4978 (صحيح على شرط مسلم).","summary":"«أرحم الراحمين» في السنة الرحمةُ الأخيرة: تشفع الملائكة والنبيون والمؤمنون «ولم يبق إلا أرحم الراحمين» فيقبض قبضةً من النار — واسمُ من هان على الناس في الطائف، ومن ملك خصمه يوم الفتح، ومن قُتل أبوه خطأً؛ يُنادى به ثلاثًا فيُقبل عليك قبل أن تسأل."},"situations":[{"situationId":4,"verses":[],"hadiths":[{"i":5,"strength":"direct","headline":"فقد عزيزٍ بخطأ غيرك والعفو عمّن تسبّب فيه","bridge":"فقدتَ عزيزًا بخطأ أحد؟ حذيفة رأى أباه يُقتل بأسياف المسلمين خطأً فقال: «يغفر الله لكم وهو أرحم الراحمين» وتصدّق بالدية — الاسم الذي يسع مصابك يسع من تسبّب فيه."}]},{"situationId":5,"verses":[{"i":4,"strength":"direct","headline":"مرضٌ أو بلاءٌ طويل يلحّ على الجسد والأهل","bridge":"مرضٌ يلحّ عليك أو على من تحب؟ أيوب بعد سنوات البلاء لم يقل «فاكشفه»، بل عرض حاله وذكّر بالرحمة: ﴿أَنِّي مَسَّنِيَ الضُّرُّ وَأَنْتَ أَرْحَمُ الرَّاحِمِينَ﴾ — فاستُجيب له بلا سؤالٍ صريح؛ اعرض وجعك واترك الطلب لكرمه."}],"hadiths":[]},{"situationId":6,"verses":[],"hadiths":[{"i":7,"strength":"direct","headline":"تخلّي من كنت تعدّهم سندًا","bridge":"تخلّى عنك من كنت تعدّهم سندًا؟ النبي ﷺ بعد موت عمّه وردّ الطائف صلّى ركعتين وقال: «اللهم إليك أشكو ضعفي وهواني على الناس، أرحم الراحمين، إلى من تكلني؟» — الهوان على الناس طريقٌ إلى أرحم الراحمين لا حاجزٌ دونه."}]},{"situationId":11,"verses":[{"i":2,"strength":"direct","headline":"الخوف على من بقي بعد فقد عزيز","bridge":"فقدتَ عزيزًا وتخاف على من بقي؟ يعقوب فقد يوسف، فلما طُلب منه بنيامين لم يمنع الحياة من أن تمضي بل نقل توكله: ﴿فَاللَّهُ خَيْرٌ حَافِظًا وَهُوَ أَرْحَمُ الرَّاحِمِينَ﴾ — أرحمُ بي من أن يفجعني مرتين؛ وقد رُدّ إليه الاثنان معًا."}],"hadiths":[{"i":9,"strength":"direct","headline":"رحمتك بولدك وخوفك عليه","bridge":"تضمّ ولدك وتخاف عليه؟ قال النبي ﷺ لرجلٍ يضم صبيه: «أترحمه؟ فالله أرحم بك منك به، وهو أرحم الراحمين» — قِس رحمته بك على رحمتك بولدك ثم ارفع بلا حد."}]},{"situationId":19,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"اليأس من النجاة لقلة العمل الصالح","bridge":"تظن أن عملك لا يشفع لك؟ في حديث الرؤية: «شفعت الملائكة وشفع النبيون وشفع المؤمنون ولم يبق إلا أرحم الراحمين» فيقبض قبضة من النار فيخرج قومًا لم يعملوا خيرًا قط — الاسم آخر رحمة في المشهد وأوسعها؛ فلا تقنط ولا تأمن."},{"i":3,"strength":"direct","headline":"اليأس من الرحمة وظنّ أنك أبعد الناس عنها","bridge":"يئست حتى ظننت أنك أبعد من كل رحمة؟ «يبقى أرحم الراحمين فيقبض قبضة من النار خلقًا كثيرًا لم يعملوا خيرًا… فيُصب عليهم ماء الحياة فيخرجون كأنهم اللؤلؤ» — من صار حممًا أعادته قبضة الرحمة لؤلؤًا؛ فكيف تيأس وأنت لم تحترق بعد؟"}]},{"situationId":53,"verses":[{"i":1,"strength":"direct","headline":"جفوةٌ مع قريبٍ بعد غضبٍ تبيّن فيه عذره","bridge":"جفوةٌ مع رحم بعد غضب؟ موسى أخذ برأس أخيه يجرّه، فلما ظهر عذره دعا: ﴿رَبِّ اغْفِرْ لِي وَلِأَخِي وَأَدْخِلْنَا فِي رَحْمَتِكَ وَأَنْتَ أَرْحَمُ الرَّاحِمِينَ﴾ — لا تكتفِ بالاعتذار؛ ادعُ لنفسك ولرحمك معًا، واسأل أرحم الراحمين أن يحيطكما برحمته."}],"hadiths":[]},{"situationId":57,"verses":[{"i":3,"strength":"direct","headline":"القدرة على الانتقام ممن ظلمك بعد أن صار تحت يدك","bridge":"صار من ظلمك تحت يدك؟ يوسف وقف أمامه من ألقوه في الجب وهو عزيز مصر، فقال: ﴿لَا تَثْرِيبَ عَلَيْكُمُ الْيَوْمَ يَغْفِرُ اللَّهُ لَكُمْ وَهُوَ أَرْحَمُ الرَّاحِمِينَ﴾ — لا انتقام، ولا حتى لومًا؛ ومن عرف أرحم الراحمين هان عليه أن يرحم."}],"hadiths":[{"i":8,"strength":"direct","headline":"التمكّن ممن آذاك وتردّدك بين الانتقام والعفو","bridge":"صار من ظلمك تحت يدك؟ يوم الفتح وقف النبي ﷺ على قريش وقالوا «رحيم كريم»، فقال: «لا تثريب عليكم اليوم يغفر الله لكم وهو أرحم الراحمين» — عفوك اليوم فرعٌ من اسمه، فردّ الرحمة إلى مصدرها."}]},{"situationId":162,"verses":[],"hadiths":[{"i":10,"strength":"direct","headline":"افتتاح الطلب بالإلحاح في النداء قبل السؤال","bridge":"تريد أن تُحسن الطلب؟ «إن لله ملكًا موكلًا بمن يقول: يا أرحم الراحمين، فمن قالها ثلاثًا قال له الملك: إن أرحم الراحمين قد أقبل عليك فسل» — نادِ ثلاثًا قبل أن تسأل."}]},{"situationId":172,"verses":[],"hadiths":[{"i":11,"strength":"direct","headline":"البحث عن بابٍ يسيرٍ إلى الجنة","bridge":"تريد بابًا يسيرًا إلى الجنة؟ «إن لله لوحًا من زبرجدة خضراء تحت العرش كُتب فيه: أنا الله لا إله إلا أنا أرحم الراحمين، خلقت بضعة عشر وثلاثمائة خُلق، من جاء بخلقٍ منها مع شهادة أن لا إله إلا الله دخل الجنة» — خُلقٌ واحد مع التوحيد يكفي عند أرحم الراحمين."}]},{"situationId":184,"verses":[],"hadiths":[{"i":2,"strength":"direct","headline":"الخوف من انقطاع الشفعاء ورجاء رحمة الله بمن لا شفيع له","bridge":"تخاف ألا يبقى لك شفيعٌ يوم القيامة؟ «شفَعت الملائكةُ» ثم «وبقي أرحمُ الرَّاحمين» — إذا انقطعت الشفاعات كلها بقيت رحمة أرحم الراحمين تُخرج من لا شفيع له؛ فلا تقنط وأنت تعبده."},{"i":4,"strength":"direct","headline":"اليأس من أن تبلغك شفاعة أو رحمة","bridge":"يئستَ حتى ظننتَ أن الشفاعات لا تبلغك؟ في حديث ابن مسعود: تشفع الملائكة والنبيون والشهداء والصالحون، «ثم يقول الله: أنا أرحم الراحمين، فيخرج من النار أكثر مما أخرج من جميع الخلق برحمته، ثم يقول: أنا أرحم الراحمين» — رحمته وحده أكثر حصادًا من رحمة الخلق مجتمعين."},{"i":6,"strength":"direct","headline":"التطلع إلى رحمة الله بالموحدين يوم القيامة","bridge":"تريد أن يرسخ يقينك بما بعد الموت؟ اقرأ مشهد الشفاعات في حديث حذيفة: أنبياءٌ مع أحدهم عصابة ومع آخر لا أحد، ثم يقول الله: «أنا أرحم الراحمين، أدخلوا جنتي من كان لا يشرك بي شيئًا» — المعيار يوم القيامة التوحيد، والرحمة أرحم الراحمين."}]}]},{"id":22,"name":"مالك الملك","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: مَالِكَ الْمُلْكِ — مضافة | المواضع: 1 (آل عمران: 26)\nخصوصية: الموضع الوحيد، وجاء في صيغة دعاءٍ مباشر مأمورٍ به: ﴿قُلِ اللَّهُمَّ مَالِكَ الْمُلْكِ﴾ — فهو من أوضح الأسماء التي عُلّم العبدُ الدعاءَ بها نصًّا.\n\nالمعنى:\n- مالك الملك: المالك المطلق لكل ملكٍ وسلطان، يؤتيه من يشاء وينزعه ممن يشاء — فالملوك مستأجَرون في ملكه.","teaches":"الحقائق التي كشفها الموضع:\n1. الملك عاريةٌ: كل سلطانٍ في الأرض مُعارٌ من مالك الملك، يُؤتى ويُنزع بمشيئته.\n2. العز والذل بيده وحده — فلا يُطلبان من مخلوق.\n3. الخير كله بيده، ولا يُنسب إليه شر — حتى في مقام النزع والإذلال.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند رؤية سقوط دولةٍ أو صعود أخرى.\n- عند الحاجة إلى صاحب سلطانٍ أو منصب.\n- عند الشعور بالذل أو التطلع إلى العز.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. الدعاء بالنص المأمور به: ﴿قُلِ اللَّهُمَّ مَالِكَ الْمُلْكِ...﴾ — آل عمران 26.\n2. طلب العز والحفظ من الذل — فهما بيده وحده.\n3. عند الحاجة إلى ذي سلطان: ادعُ مالك الملك قبل أن تطرق بابه.\n4. للمستضعفين وأهل الحق في زمن ضعفهم: هذا دعاء نزل وهم قلة — وهو دعاء التمكين.\n5. سؤال الخير المطلق: «بيدك الخير» — فاجعل طلبك كله منه.\n\nدعاء مقتبس من الآية (وهو نصٌّ قرآني يُدعى به):\n«اللهم مالك الملك، تؤتي الملك من تشاء وتنزع الملك ممن تشاء، وتعز من تشاء وتذل من تشاء، بيدك الخير إنك على كل شيء قدير: أعزّنا بطاعتك ولا تذلّنا بمعصيتك، وارزقنا من خيرك الذي بيدك».","summary":"كلُّ ملكٍ تراه عاريةٌ من مالك الملك — يؤتي وينزع، ويعزّ ويذل؛ فادعُه بما أمرك أن تقول، ولا تتذلل لمن مُلكُه في يد غيره.","verses":[{"i":1,"of":1,"s":3,"surah":"آل عمران","a":26,"text":"قُلِ اللَّهُمَّ مَالِكَ الْمُلْكِ تُؤْتِي الْمُلْكَ مَنْ تَشَاءُ وَتَنْزِعُ الْمُلْكَ مِمَّنْ تَشَاءُ وَتُعِزُّ مَنْ تَشَاءُ وَتُذِلُّ مَنْ تَشَاءُ بِيَدِكَ الْخَيْرُ إِنَّكَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":25,"text":"فَكَيْفَ إِذَا جَمَعْنَاهُمْ لِيَوْمٍ لَا رَيْبَ فِيهِ وَوُفِّيَتْ كُلُّ نَفْسٍ مَا كَسَبَتْ وَهُمْ لَا يُظْلَمُونَ"},"next":{"a":27,"text":"تُولِجُ اللَّيْلَ فِي النَّهَارِ وَتُولِجُ النَّهَارَ فِي اللَّيْلِ وَتُخْرِجُ الْحَيَّ مِنَ الْمَيِّتِ وَتُخْرِجُ الْمَيِّتَ مِنَ الْحَيِّ وَتَرْزُقُ مَنْ تَشَاءُ بِغَيْرِ حِسَابٍ"},"context":"﴿قُلِ اللَّهُمَّ مَالِكَ الْمُلْكِ تُؤْتِي الْمُلْكَ مَنْ تَشَاءُ وَتَنْزِعُ الْمُلْكَ مِمَّنْ تَشَاءُ وَتُعِزُّ مَنْ تَشَاءُ وَتُذِلُّ مَنْ تَشَاءُ بِيَدِكَ الْخَيْرُ إِنَّكَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — ثم تأتي الآية التالية بمشاهد التقليب الكوني: ﴿تُولِجُ اللَّيْلَ فِي النَّهَارِ وَتُولِجُ النَّهَارَ فِي اللَّيْلِ وَتُخْرِجُ الْحَيَّ مِنَ الْمَيِّتِ﴾. والسياق العام: وعدُ المؤمنين المستضعفين بالتمكين وقد كانوا قلة.","reason":"أُمر النبيُّ ﷺ أن يعلن هذا الدعاء في وقتٍ لم يكن للمسلمين فيه ملكٌ ولا سلطان: إعلانُ أن الملك كلَّه بيد مالكه — يعطي وينزع، ويعزّ ويذل. ولطيفةُ الآية أنه قال ﴿بِيَدِكَ الْخَيْرُ﴾ ولم يقل «والشر»، مع ذكر النزع والإذلال: تأدبًا وبيانًا أن حتى النزع والإذلال يجريان لحكمةٍ خيّرة، والشرُّ لا يُنسب إليه.","adds":"يحرّر القلب من هيبة أصحاب السلطان: من عرف أن الملك يُؤتى ويُنزع بمشيئة مالكه، لم يتذلل لممنوحٍ زائل — ولم ييأس من عزٍّ يأتي به مالك الملك."}],"hadiths":[{"i":1,"of":1,"text":"«قالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ لمُعاذِ بنِ جَبَلٍ: ألَا أُعَلِّمُك دُعاءً تَدْعو به، لو كانَ عليك مِثلُ جَبَلٍ دَيْنًا لأدَّاه اللهُ عنك؟ قُلْ يا مَعاذُ: اللَّهُمَّ مالِكَ المُلْكِ، تُؤْتي المُلْكَ مَن تَشاءُ، وتَنزِعُ المُلْكَ مِمَّن تَشاءُ، وتُعِزُّ مَن تَشاءُ، وتُذِلُّ مَن تَشاءُ، بيَدِك الخَيْرُ إنَّك على كلِّ شيءٍ قَديرٌ، رَحْمانُ الدُّنْيا والآخِرةِ ورَحيمُهما، تُعْطيهما مَن تَشاءُ، وتَمنَعُ مِنهما مَن تَشاءُ، ارْحَمْني رَحْمةً تُغْنيني بها عن رَحْمةِ مَن سِواك».\nقالَ الطَّبَرانِيُّ: لم يَرْوِه عن الزُّهْرِيِّ إلَّا يونُسُ، ولا عنه إلَّا وَهْبُ اللهِ.","narrator":"أنس بن مالك","source":"الأحاديث المختارة 2633","grade":"صحيح","judgment":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","url":"https://dorar.net/h/harp7m5M","nameForm":"مالِكَ المُلْكِ","scene":"النبي ﷺ يقول لمعاذ بن جبل: «ألا أعلّمك دعاءً تدعو به، لو كان عليك مثل جبلٍ دَينًا لأدّاه الله عنك؟ قل يا معاذ: اللهم مالك الملك، تؤتي الملك من تشاء، وتنزع الملك ممن تشاء، وتعزّ من تشاء، وتذلّ من تشاء، بيدك الخير، إنك على كل شيء قدير. رحمان الدنيا والآخرة ورحيمهما، تعطيهما من تشاء وتمنع منهما من تشاء، ارحمني رحمةً تغنيني بها عن رحمة من سواك». الحديث في الأحاديث المختارة للضياء.","reason":"المدين إنسانٌ خرج بعضُ ملكه من يده إلى يد غيره، فأول ما يُعلَّم أن يقول: «مالك الملك» — الذي يملك ما في يدك وما في يد دائنك. ثم يُفصَّل الاسم بآية آل عمران: يؤتي وينزع ويعزّ ويذلّ — فالذي نزع منك صار يقدر أن يؤتيك، والذي أذلّك الدَّينُ عنده عزّتك. ثم يجيء المطلوب: «ارحمني رحمةً تغنيني بها عن رحمة من سواك» — الغنى عن الناس، وهو عين ما يحتاجه المدين. فالاسم أوّلُ الدعاء لأنه أصل المسألة: لا يُسأل قضاءُ الدَّين إلا من يملك الملك كله.","adds":"تُري السنة هنا الاسم في استعمالٍ عملي مقيس: دعاءٌ موزونٌ بـ«مثل جبلٍ دَينًا»، مبنيٌّ على آية آل عمران، مزيدٌ فيه اسمان من السنة «رحمان الدنيا والآخرة ورحيمهما». فتتعلم أن الاسم يُبسط في الدعاء بآثاره (تؤتي، تنزع، تعز، تذل) لا يُذكر مجردًا، وأن غاية الدعاء بمالك الملك الاستغناءُ عن ملك الناس."}],"sunnah":{"card":"الصيغة: مَالِكُ الْمُلْكِ — مركّبة (اسمٌ مضاف)\nفي السنة: شاهدان (روايتان)\nخصوصية الورود في السنة: ورد الاسم في حديث الأسماء التسعة والتسعين في تعدادها، وورد نداءً في دعاءٍ علّمه النبي ﷺ معاذًا لقضاء الدَّين: «اللهم مالك الملك، تؤتي الملك من تشاء…» — فالسنة تُري الاسم مُحصًى في قائمة الأسماء، ومستعملًا في أخصّ حاجات المدين.\nالمعنى المختصر: الذي له الملك كله: يعطيه وينزعه ويعزّ به ويذلّ.","teaches":"1. أن الملك كله بيده: ما في يدك وما في يد دائنك ومن فوقكما.\n2. أن الإيتاء والنزع والإعزاز والإذلال أفعاله وحده، فلا يُخاف ذو ملكٍ ولا يُرجى.\n3. أن الغنى الحقيقي رحمةٌ منه تُغنيك عن رحمة من سواه.\n4. أن اسمه مُحصًى في التسعة والتسعين، ومن أحصاها دخل الجنة.","whenRecall":"- حين يثقلك دَين: «لو كان عليك مثل جبل».\n- حين تحسد ذا ملكٍ أو تخافه: المُلك يُؤتى ويُنزع.\n- حين تطلب من الناس: «رحمةً تغنيني بها عن رحمة من سواك».\n- حين تحصي الأسماء التسعة والتسعين.","whenPray":"عند الشعور بـ:\n1. ثقل الدَّين والعجز عن قضائه.\n2. الذل من حاجةٍ إلى الناس.\n3. الخوف من ذي سلطان أو الرغبة فيما عنده.\nعند طلب:\n1. قضاء الدَّين ولو كان مثل جبل.\n2. رحمةً تُغني عن رحمة الخلق.\n3. العزّ الذي لا يُنزع.\nعند الرغبة في:\n1. أن تدعو بالاسم مبسوطًا بآثاره كما في آية آل عمران.\n2. إحصاء الأسماء والتعبد بها.","duaItems":"1. دعاء معاذ لقضاء الدَّين: «اللهم مالك الملك، تؤتي الملك من تشاء، وتنزع الملك ممن تشاء، وتعزّ من تشاء، وتذلّ من تشاء، بيدك الخير، إنك على كل شيء قدير. رحمان الدنيا والآخرة ورحيمهما، تعطيهما من تشاء وتمنع منهما من تشاء، ارحمني رحمةً تغنيني بها عن رحمة من سواك» — الأحاديث المختارة 2633 (أورده الضياء فيما اختاره مما ليس في الصحيحين).\n2. إحصاء الأسماء التسعة والتسعين وفيها «مالك الملك» — الجامع الصغير 2351 (صحيح).","summary":"«مالك الملك» في السنة أوّلُ كلمةٍ يُعلَّمها المدين: من ملكُه كله بيده يُؤتي ما نُزع ويُعزّ من أُذلّ، والمطلوب به رحمةٌ تُغنيك عن رحمة من سواه — واسمٌ مُحصًى في التسعة والتسعين."},"situations":[{"situationId":40,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"دَينٌ يثقلك والحاجة إلى ما في أيدي الناس","bridge":"دَينٌ يثقلك؟ النبي ﷺ قال لمعاذ: «ألا أعلّمك دعاءً لو كان عليك مثل جبلٍ دَينًا لأدّاه الله عنك؟» وبدأه بـ«اللهم مالك الملك» — ما نُزع من يدك ملكٌ لمالك الملك، وهو الذي يؤتيه من يشاء."}]},{"situationId":149,"verses":[{"i":1,"strength":"direct","headline":"الخوف من أن يُسلب ما أنت فيه من نعمة","bridge":"تخشى أن يُسلب ما أنت فيه؟ الذي أعطاك هو وحده من يملك أن ينزع، وهو الذي وصف يده بالخير لا بالشر: ﴿تُؤْتِي الْمُلْكَ مَنْ تَشَاءُ وَتَنْزِعُ الْمُلْكَ مِمَّنْ تَشَاءُ... بِيَدِكَ الْخَيْرُ﴾ — فما بقي ففضله، وما نُزع ففيه خيرٌ لا تراه."}],"hadiths":[]}]},{"id":23,"name":"شديد المحال","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: شَدِيدُ الْمِحَالِ — مضافة | المواضع: 1 (الرعد: 13)\nخصوصية: الموضع الوحيد، وجاء في أعجب مقابلة: رعدٌ وملائكةٌ وصواعق تسبّح وتخاف، وبشرٌ يجادلون في الله.\n\nالمعنى:\n- شديد المحال: شديد الأخذ والقوة والمكر بالمعاندين — والمِحال: القوة والبطش والكيد لمن كاد. أي: من حاول أن يغالبه غُلب وأُخذ أخذًا شديدًا.","teaches":"الحقائق التي كشفها الموضع:\n1. الكون كله في خشيةٍ وتسبيح، والمجادل بلا علم شاذٌّ عن نظام الوجود.\n2. شدة أخذه لا تُستبطأ: الصاعقة تنزل والجدالُ لم ينتهِ بعد.\n3. خوف الملائكة — وهم المعصومون — ميزانٌ لمن يأمن مكر الله.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند سماع الرعد ورؤية البرق.\n- عند حضور مجلسٍ يُجادَل فيه في الله بغير علم.\n- عند أمن المكر والاستهانة بالذنب.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. عند سماع الرعد: الذكر المأثور بدل الفزع.\n2. الاستعاذة من الجدال بغير علم ومن أن يؤخذ المرء على غرة.\n3. سؤال الخشية التي وصفت بها الملائكة: ﴿وَالْمَلَائِكَةُ مِنْ خِيفَتِهِ﴾.\n4. للمظلوم من معاندٍ متجبر: تفويضُ أمره إلى شديد المحال.\n\nمن السنة: كان ابن عمر رضي الله عنهما إذا سمع الرعد قال: «سُبْحَانَ الَّذِي يُسَبِّحُ الرَّعْدُ بِحَمْدِهِ وَالْمَلَائِكَةُ مِنْ خِيفَتِهِ» — رواه مالك في الموطأ.","summary":"الرعدُ يسبّح والملائكةُ ترتجف — والمجادلُ بلا علم آمنٌ مطمئن! والاسمُ تذكيرٌ: ﴿وَهُوَ شَدِيدُ الْمِحَالِ﴾، فمن غالبه غُلب.","verses":[{"i":1,"of":1,"s":13,"surah":"الرعد","a":13,"text":"وَيُسَبِّحُ الرَّعْدُ بِحَمْدِهِ وَالْمَلَائِكَةُ مِنْ خِيفَتِهِ وَيُرْسِلُ الصَّوَاعِقَ فَيُصِيبُ بِهَا مَنْ يَشَاءُ وَهُمْ يُجَادِلُونَ فِي اللَّهِ وَهُوَ شَدِيدُ الْمِحَالِ","prev":{"a":12,"text":"هُوَ الَّذِي يُرِيكُمُ الْبَرْقَ خَوْفًا وَطَمَعًا وَيُنْشِئُ السَّحَابَ الثِّقَالَ"},"next":{"a":14,"text":"لَهُ دَعْوَةُ الْحَقِّ وَالَّذِينَ يَدْعُونَ مِنْ دُونِهِ لَا يَسْتَجِيبُونَ لَهُمْ بِشَيْءٍ إِلَّا كَبَاسِطِ كَفَّيْهِ إِلَى الْمَاءِ لِيَبْلُغَ فَاهُ وَمَا هُوَ بِبَالِغِهِ وَمَا دُعَاءُ الْكَافِرِينَ إِلَّا فِي ضَلَالٍ"},"context":"﴿وَيُسَبِّحُ الرَّعْدُ بِحَمْدِهِ وَالْمَلَائِكَةُ مِنْ خِيفَتِهِ وَيُرْسِلُ الصَّوَاعِقَ فَيُصِيبُ بِهَا مَنْ يَشَاءُ وَهُمْ يُجَادِلُونَ فِي اللَّهِ وَهُوَ شَدِيدُ الْمِحَالِ﴾ — الرعدُ يسبّح، والملائكةُ ترتجف خيفةً، والصواعقُ تنزل — وهم في هذا كله منشغلون بالجدال. وفي حديث أنسٍ أن الآية نزلت في رأسٍ من المشركين جادل في الله فأصابته صاعقة (الصحيح المسند 91).","reason":"جاء الاسم في ذيل المشهد تهديدًا مبطنًا: إن كان الرعدُ يسبّح والملائكةُ تخاف، فما بالُ هؤلاء يجادلون في الله بلا علم؟ وهو «شديد المحال» — لا يعجزه أخذُ المجادل في لحظة، كما أصاب الصاعقةُ من أصابت. فالمشهدُ الكوني حجةٌ، والاسمُ إنذار.","adds":"يضبط أدبَ الكلام في الله: الجدال بغير علم في ذاته وصفاته وقدره ليس ترفًا فكريًا — فوقك سماءٌ تسبّح، وأمامك اسمٌ شديد المحال.","dorar":[{"id":"QbK1MxlL","label":"الصحيح المسند 91"}]}],"hadiths":[],"situations":[{"situationId":105,"verses":[{"i":1,"strength":"direct","headline":"الجدال في الله وصفاته بغير علم","bridge":"حين يجادلك أحدٌ في الله بلا علم، فتذكّر مشهد الآية: الرعد يسبّح، والملائكة ترتجف خيفةً، والصواعق تصيب من يشاء ﴿وَهُمْ يُجَادِلُونَ فِي اللَّهِ وَهُوَ شَدِيدُ الْمِحَالِ﴾ — الجدال في الله ليس ترفًا فكريًا؛ فوق المجادل سماءٌ تسبّح، وأمامه اسمٌ لا يعجزه أخذُه."}],"hadiths":[]}]},{"id":24,"name":"الله الواحد القهار","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: اللَّهُ الْوَاحِدُ الْقَهَّارُ — مركّبة ثلاثية | المواضع: 5 (يوسف: 39 — إبراهيم: 48 — ص: 65 — الزمر: 4 — غافر: 16)\nخصوصية: ثلاثةٌ من مواضعه في مقام إبطال الشرك والولد، وموضعان في مشهد يوم البروز — فهو صيغة «حسم التعدد»: في الاعتقاد وفي المصير.\n\nالمعنى:\n- الواحد: المتفرد في ذاته وصفاته وأفعاله، لا شريك له ولا نظير.\n- القهار: الغالب الذي قهر كل شيء فدان له، لا يمتنع عليه شيء.\nسر الاقتران: وحدانيةٌ مقرونة بقهر — فليست وحدةَ دعوى بل وحدةَ من غلب كلَّ ما سواه فلم يبق مع قهره ندٌّ يُدّعى.","teaches":"الحقائق التي كشفتها المواضع:\n1. التعدد تفرقٌ وضعف: ﴿أَأَرْبَابٌ مُتَفَرِّقُونَ خَيْرٌ أَمِ اللَّهُ الْوَاحِدُ الْقَهَّارُ﴾ (يوسف 39).\n2. كل ما سواه مقهور — فلا يصلح مقهورٌ أن يكون إلهًا أو ولدًا لإله (الزمر 4).\n3. يوم البروز يسقط كل ملكٍ ولقب، ويجيب سبحانه سؤالَه بنفسه (غافر 16، إبراهيم 48).\n4. وظيفة الرسل الإنذار، والألوهية محصورة في الواحد القهار (ص 65).","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- عند تفرق قلبك بين مطلوبين ومرجعيات متعددة.\n- عند هيبة أصحاب السلطان.\n- عند سماع دعاوى تأليه المخلوقين أو الغلوّ في الصالحين.\n- عند تذكر يوم البروز والعرض.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. عند تشتت القلب بين الأرباب المتفرقة (الوظيفة، الناس، الهوى): جمعُه على الواحد القهار — يوسف 39.\n2. في السجن والضيق والظلم: الثبات على التوحيد والدعوة إليه كما فعل يوسف.\n3. سؤال التيسير يوم البروز والعرض — إبراهيم 48، غافر 16.\n4. الاستعاذة من الغلوّ في المخلوقين وتنزيهُ الله عن الولد والشريك — الزمر 4.\n5. طلب قهر ما قهرك من شهوةٍ أو عدوٍّ: «يا قهار اقهر ما لم أقدر عليه».\n\nدعاء مقتبس من مواضعه:\n«اللهم أنت الواحد القهار: اجمع قلبي عليك فلا أعبد أربابًا متفرقين، واقهر لي ما غلبني من نفسي وهواي وعدوّي، وهوّن عليّ يوم أبرز إليك لا يخفى عليك مني شيء — لك الملك اليوم وحدك».","summary":"سألها يوسفُ في السجن: ﴿أَأَرْبَابٌ مُتَفَرِّقُونَ خَيْرٌ أَمِ اللَّهُ الْوَاحِدُ الْقَهَّارُ﴾ — وسيُسأل يوم البروز: ﴿لِمَنِ الْمُلْكُ الْيَوْمَ﴾، والجواب واحد. فاجمع قلبك عليه اليوم.","verses":[{"i":1,"of":4,"s":12,"surah":"يوسف","a":39,"text":"يَا صَاحِبَيِ السِّجْنِ أَأَرْبَابٌ مُتَفَرِّقُونَ خَيْرٌ أَمِ اللَّهُ الْوَاحِدُ الْقَهَّارُ","prev":{"a":38,"text":"وَاتَّبَعْتُ مِلَّةَ آبَائِي إِبْرَاهِيمَ وَإِسْحَاقَ وَيَعْقُوبَ مَا كَانَ لَنَا أَنْ نُشْرِكَ بِاللَّهِ مِنْ شَيْءٍ ذَلِكَ مِنْ فَضْلِ اللَّهِ عَلَيْنَا وَعَلَى النَّاسِ وَلَكِنَّ أَكْثَرَ النَّاسِ لَا يَشْكُرُونَ"},"next":{"a":40,"text":"مَا تَعْبُدُونَ مِنْ دُونِهِ إِلَّا أَسْمَاءً سَمَّيْتُمُوهَا أَنْتُمْ وَآبَاؤُكُمْ مَا أَنْزَلَ اللَّهُ بِهَا مِنْ سُلْطَانٍ إِنِ الْحُكْمُ إِلَّا لِلَّهِ أَمَرَ أَلَّا تَعْبُدُوا إِلَّا إِيَّاهُ ذَلِكَ الدِّينُ الْقَيِّمُ وَلَكِنَّ أَكْثَرَ النَّاسِ لَا يَعْلَمُونَ"},"context":"يوسف في السجن، وصاحباه يسألانه عن رؤياهما، فيبدأ بالأهم قبل التعبير: ﴿يَا صَاحِبَيِ السِّجْنِ أَأَرْبَابٌ مُتَفَرِّقُونَ خَيْرٌ أَمِ اللَّهُ الْوَاحِدُ الْقَهَّارُ﴾.","reason":"طرح المفاضلة بلغة يفهمها السجينان: أربابٌ متفرقون — كلٌّ يجرّك إلى جهة ولا يملك لك شيئًا — أم واحدٌ قهار يملك أمرك كله؟ فذكرُ «القهار» يحسم المقارنة: التعدد ضعفٌ وتفرق، والقهرُ لواحدٍ يعني أن كل ما سواه مقهور. ثم قال: ﴿مَا تَعْبُدُونَ مِنْ دُونِهِ إِلَّا أَسْمَاءً سَمَّيْتُمُوهَا﴾.","adds":"منهجُ الدعوة في أصعب الظروف: يوسف في السجن مظلومًا يبدأ بالتوحيد قبل خدمة الناس بعلمه — والسجنُ لم يمنعه أن يكون داعية."},{"i":2,"of":4,"s":14,"surah":"إبراهيم","a":48,"text":"يَوْمَ تُبَدَّلُ الْأَرْضُ غَيْرَ الْأَرْضِ وَالسَّمَاوَاتُ وَبَرَزُوا لِلَّهِ الْوَاحِدِ الْقَهَّارِ","prev":{"a":47,"text":"فَلَا تَحْسَبَنَّ اللَّهَ مُخْلِفَ وَعْدِهِ رُسُلَهُ إِنَّ اللَّهَ عَزِيزٌ ذُو انْتِقَامٍ"},"next":{"a":49,"text":"وَتَرَى الْمُجْرِمِينَ يَوْمَئِذٍ مُقَرَّنِينَ فِي الْأَصْفَادِ"},"context":"﴿يَوْمَ تُبَدَّلُ الْأَرْضُ غَيْرَ الْأَرْضِ وَالسَّمَاوَاتُ وَبَرَزُوا لِلَّهِ الْوَاحِدِ الْقَهَّارِ﴾ — تتغير الأرض والسماوات كليًا، ويخرج الخلق من قبورهم ظاهرين لا ساتر لهم ولا حاجب.","reason":"قُرن مشهد البروز الكوني بالاسم: في يومٍ تتبدل فيه الأرضُ والسماء، لا يبقى إلا الواحدُ القهار — فتزول كلُّ الأسماء والألقاب والملوك، ويبرز الجميع لواحدٍ قهار لا يُمانَع. فالاسم يصف حال ذلك اليوم: تفرّدٌ كامل وقهرٌ شامل.","adds":"يخفف من هيبة أي سلطانٍ دنيوي: كل من تهابه اليوم سيبرز غدًا مكشوفًا للواحد القهار مثلك تمامًا."},{"i":3,"of":4,"s":39,"surah":"الزمر","a":4,"text":"لَوْ أَرَادَ اللَّهُ أَنْ يَتَّخِذَ وَلَدًا لَاصْطَفَى مِمَّا يَخْلُقُ مَا يَشَاءُ سُبْحَانَهُ هُوَ اللَّهُ الْوَاحِدُ الْقَهَّارُ","prev":{"a":3,"text":"أَلَا لِلَّهِ الدِّينُ الْخَالِصُ وَالَّذِينَ اتَّخَذُوا مِنْ دُونِهِ أَوْلِيَاءَ مَا نَعْبُدُهُمْ إِلَّا لِيُقَرِّبُونَا إِلَى اللَّهِ زُلْفَى إِنَّ اللَّهَ يَحْكُمُ بَيْنَهُمْ فِي مَا هُمْ فِيهِ يَخْتَلِفُونَ إِنَّ اللَّهَ لَا يَهْدِي مَنْ هُوَ كَاذِبٌ كَفَّارٌ"},"next":{"a":5,"text":"خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ بِالْحَقِّ يُكَوِّرُ اللَّيْلَ عَلَى النَّهَارِ وَيُكَوِّرُ النَّهَارَ عَلَى اللَّيْلِ وَسَخَّرَ الشَّمْسَ وَالْقَمَرَ كُلٌّ يَجْرِي لِأَجَلٍ مُسَمًّى أَلَا هُوَ الْعَزِيزُ الْغَفَّارُ"},"context":"﴿لَوْ أَرَادَ اللَّهُ أَنْ يَتَّخِذَ وَلَدًا لَاصْطَفَى مِمَّا يَخْلُقُ مَا يَشَاءُ سُبْحَانَهُ هُوَ اللَّهُ الْوَاحِدُ الْقَهَّارُ﴾ — فرضُ محالٍ لإبطال الدعوى: لو أراد لاصطفى، لكنه لم يُرد، سبحانه.","reason":"خُتم إبطال فرية الولد بالاسمين: «الواحد» ينفي الشريك والولد، و«القهار» يبيّن الاستحالة العقلية — لأن الولد يماثل أباه، ولا مماثل لمن قهر كل شيء؛ والولدُ يُتخذ للحاجة، والقهارُ لا يحتاج. فبطلت الدعوى بالوحدانية والقهر معًا.","adds":"برهانٌ مختصر ضد كل تأليهٍ لمخلوق: من كان مقهورًا لا يكون إلهًا ولا ابنًا لإله — والخلقُ كلهم مقهورون."},{"i":4,"of":4,"s":40,"surah":"غافر","a":16,"text":"يَوْمَ هُمْ بَارِزُونَ لَا يَخْفَى عَلَى اللَّهِ مِنْهُمْ شَيْءٌ لِمَنِ الْمُلْكُ الْيَوْمَ لِلَّهِ الْوَاحِدِ الْقَهَّارِ","prev":{"a":15,"text":"رَفِيعُ الدَّرَجَاتِ ذُو الْعَرْشِ يُلْقِي الرُّوحَ مِنْ أَمْرِهِ عَلَى مَنْ يَشَاءُ مِنْ عِبَادِهِ لِيُنْذِرَ يَوْمَ التَّلَاقِ"},"next":{"a":17,"text":"الْيَوْمَ تُجْزَى كُلُّ نَفْسٍ بِمَا كَسَبَتْ لَا ظُلْمَ الْيَوْمَ إِنَّ اللَّهَ سَرِيعُ الْحِسَابِ"},"context":"﴿يَوْمَ هُمْ بَارِزُونَ لَا يَخْفَى عَلَى اللَّهِ مِنْهُمْ شَيْءٌ لِمَنِ الْمُلْكُ الْيَوْمَ لِلَّهِ الْوَاحِدِ الْقَهَّارِ﴾ — سؤالٌ يُلقى في يومٍ لا مُجيب فيه، فيجيب سبحانه نفسَه بنفسه.","reason":"بلغ التفرد ذروتَه: يسأل ولا يجيب أحد، فيتولى الجواب — ﴿لِلَّهِ الْوَاحِدِ الْقَهَّارِ﴾. فالملوك الذين تنازعوا الملك في الدنيا خرسوا، ولم يبق إلا صوتُ الواحد القهار. وقرْنُ الاسم بـ﴿لَا يَخْفَى عَلَى اللَّهِ مِنْهُمْ شَيْءٌ﴾ يجمع القهر مع الإحاطة.","adds":"أرهبُ سؤالٍ في القرآن وأسهلُ جواب: تدرَّب على جوابه اليوم في قلبك — ﴿لِلَّهِ الْوَاحِدِ الْقَهَّارِ﴾ — قبل أن تسمعه هناك."}],"hadiths":[{"i":1,"of":3,"text":"أنَّها سأَلَته عن قولِه: {يَوْمَ تُبَدَّلُ الْأَرْضُ غَيْرَ الْأَرْضِ وَالسَّمَوَاتُ} [إبراهيم: 48] {وَبَرَزُوا لِلَّهِ الْوَاحِدِ الْقَهَّارِ} [إبراهيم: 48] فأينَ يكونُ النَّاسُ يومَئذٍ ؟ فقال: ( على الصِّراطِ ) قالت: قُلْتُ: يا رسولَ اللهِ، ابنُ جُدْعانَ كان في الجاهليَّةِ يصِلُ الرَّحِمَ ويُطعِمُ المسكينَ فهل ذاك نافِعُه ؟ قال: ( لا ينفَعُه لم يقُلْ يومًا: ربِّ اغفِرْ لي خطيئتي يومَ الدِّينَ )","narrator":"عائشة أم المؤمنين","source":"تخريج صحيح ابن حبان 331","grade":"صحيح","judgment":"إسناده صحيح على شرط مسلم","url":"https://dorar.net/h/KZmztBw2","nameForm":"لِلَّهِ الْوَاحِدِ الْقَهَّارِ","scene":"عائشة تسأل النبي ﷺ عن قوله ﴿يَوْمَ تُبَدَّلُ الْأَرْضُ غَيْرَ الْأَرْضِ وَالسَّمَاوَاتُ وَبَرَزُوا لِلَّهِ الْوَاحِدِ الْقَهَّارِ﴾: فأين يكون الناس يومئذ؟ قال: «على الصراط». ثم تسأل عن ابن جدعان الذي كان يصل الرحم ويطعم المسكين في الجاهلية: هل ينفعه؟ قال: «لا ينفعه، لم يقل يومًا: رب اغفر لي خطيئتي يوم الدين».","reason":"الآية تصف بروز الخلق كلهم لله والأرض مبدّلة — لا موضع لأحدٍ إلا حيث يقهرهم الله أن يكونوا: «على الصراط». فالجواب النبوي يفسّر «القهار»: الناس يومئذ في موضعٍ واحد لا يختارونه. ثم سؤال ابن جدعان يكشف وجه «الواحد»: عملٌ كثير لم يكن لله الواحد ولم يُقرن بطلب المغفرة، فلم ينفع يوم البروز لله وحده.","adds":"يُعيّن الشاهد المكان الذي يُبرز فيه الناس للواحد القهار: الصراط. ويربط الاسم بالشرط الذي ينفع يومئذ: أن يكون العمل للواحد مع طلب المغفرة — فالإحسان إلى الناس بلا توحيدٍ لا يعبر الصراط."},{"i":2,"of":3,"text":"كان إذا تَضَوَّرَ مِنَ الليلِ قال : لا إلهَ إلَّا اللهُ الوَاحِدُ القَهَّارُ ، رَبُّ السَّماوَاتِ والأرضِ و ما بينَهُما العَزِيزُ الغَفَّارُ","narrator":"عائشة أم المؤمنين","source":"السلسلة الصحيحة 2066","grade":"صحيح","judgment":"صحيح على شرط البخاري","url":"https://dorar.net/h/j3oHzErV","nameForm":"اللهُ الوَاحِدُ القَهَّارُ","scene":"عائشة تروي أن النبي ﷺ كان إذا تضوّر من الليل — تقلّب وتلوّى — قال: «لا إله إلا الله الواحد القهار، رب السماوات والأرض وما بينهما العزيز الغفار».","reason":"لحظة التضوّر في الليل لحظةُ ضعفٍ بلا شاهد، فيذكر فيها النبي ﷺ اسم القهر: من يقهر الليل والنوم والجسد المتقلّب هو الواحد القهار. ثم يُتبع التهليلَ «رب السماوات والأرض وما بينهما العزيز الغفار»: فيُختم القهر بالغفران — قهارٌ للخلق، غفارٌ لمن وحّده.","adds":"يعطي الشاهد الاسم ذكرًا مأثورًا لمن استيقظ متقلبًا في الليل، ويقرن القهر بالمغفرة في نفسٍ واحد — فلا يُذكر القهار في الليل إلا ومعه الغفار."},{"i":3,"of":3,"text":"حديث  يومُ الدِّينِ يكون المُلكُ كلُّهُ للهِ الواحدِ القهارِ [يعني حديث:  عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهُما قالَ: يُنادي مُنادٍ بيْنَ يدَيِ السَّاعةِ: يا أيُّها النَّاسُ، أتَتْكم السَّاعةُ، فيَسمَعُها الأحياءُ والأمواتُ، ويَنزِلُ اللهُ إلى السَّماءِ الدُّنيا فيُنادي: لِمَنِ الملكُ اليومَ؟ للهِ الواحدِ القهَّارِ.]","narrator":"[عبدالله بن عباس]","source":"عارضة الأحوذي 6/71","grade":"صحيح","url":"https://dorar.net/h/ZcgG2O6r","nameForm":"للهِ الواحدِ القهارِ ؛ للهِ الواحدِ القهَّارِ","scene":"حديث ابن عباس كما أورده ابن العربي: ينادي منادٍ بين يدي الساعة: يا أيها الناس أتتكم الساعة، فيسمعها الأحياء والأموات، وينزل الله إلى السماء الدنيا فينادي: «لمن الملك اليوم؟ لله الواحد القهار».","reason":"السؤال «لمن الملك اليوم» لا يُجاب عنه يومئذ إلا بالاسم؛ لأن كل مُلكٍ في الأرض زال، فبقي الواحد الذي لا مُلك لغيره، والقهار الذي أزال كل ملك. فالاسم جوابٌ يقوله الله عن نفسه حين لا يبقى مدّعٍ.","adds":"يُبيّن الشاهد أن الاسم يُنطق به بين يدي الساعة سؤالًا وجوابًا من الله نفسه، حين يسمع النداءَ الأحياءُ والأموات."}],"sunnah":{"card":"الصيغة: اللَّهُ الْوَاحِدُ الْقَهَّارُ — مركّبة من لفظ الجلالة واسمين\nفي السنة: 3 شواهد (4 روايات)\nخصوصية الورود في السنة: الاسم في السنة اسمُ يوم التبديل: سألت عائشة أين يكون الناس حين ﴿وَبَرَزُوا لِلَّهِ الْوَاحِدِ الْقَهَّارِ﴾ فقال: «على الصراط»؛ وهو جواب النداء «لمن الملك اليوم؟ لله الواحد القهار»؛ وهو ذكر النبي ﷺ إذا تقلّب من الليل: «لا إله إلا الله الواحد القهار». فيُقال في الليل تهيؤًا ليوم يُقال فيه.\nالمعنى المختصر: المتفرّد الذي لا شريك له، القاهر الذي خضع له كل شيء.","teaches":"1. أن الخلق كلهم سيبرزون له في موضعٍ لا يختارونه: الصراط.\n2. أنه يقهر الليل والجسد المتقلّب فيُذكر في التضوّر.\n3. أن الملك يومئذ له وحده، يسأل ويجيب.\n4. أن الإحسان بلا توحيدٍ ولا استغفار لا ينفع يوم البروز للواحد.","whenRecall":"- حين تتقلّب في فراشك من الليل.\n- حين تقرأ آية التبديل فتتصور نفسك على الصراط.\n- حين يعجبك عملُ محسنٍ لا يوحّد.\n- حين ترى ملوك الأرض: «لمن الملك اليوم؟».","whenPray":"عند الشعور بـ:\n1. الأرق والتقلّب في الليل.\n2. هيبة يوم القيامة والصراط.\n3. الاغترار بالعمل الصالح دون سؤال المغفرة.\nعند طلب:\n1. أن يقهر عنك ما يقلقك في ليلك.\n2. الثبات على الصراط يوم البروز.\nعند الرغبة في:\n1. ذكرٍ مأثور عند الاستيقاظ المتقلّب.\n2. أن تجعل مع إحسانك: «رب اغفر لي خطيئتي يوم الدين».","duaItems":"1. عند التضوّر من الليل: «لا إله إلا الله الواحد القهار، رب السماوات والأرض وما بينهما العزيز الغفار» — السلسلة الصحيحة 2066 (صحيح على شرط البخاري).\n2. «رب اغفر لي خطيئتي يوم الدين» — الكلمة التي لم يقلها ابن جدعان فلم ينفعه إحسانه — صحيح ابن حبان 331.","summary":"«الله الواحد القهار» في السنة اسمُ يوم البروز حين يكون الناس «على الصراط»، وجوابُ «لمن الملك اليوم؟» — ويقوله النبي ﷺ إذا تقلّب من الليل مقرونًا بالعزيز الغفار؛ فمن ذكره في تضوّره ذُكر به يوم يُنادى به."},"situations":[{"situationId":32,"verses":[{"i":2,"strength":"direct","headline":"سلطةٌ تطلب ولاءك على حساب دينك","bridge":"يُطلب منك ولاءٌ على حساب دينك؟ كل من تهابه اليوم سيبرز غدًا مكشوفًا مثلك تمامًا: ﴿يَوْمَ تُبَدَّلُ الْأَرْضُ غَيْرَ الْأَرْضِ وَالسَّمَاوَاتُ وَبَرَزُوا لِلَّهِ الْوَاحِدِ الْقَهَّارِ﴾ — تزول الألقاب والملوك ولا يبقى إلا واحدٌ قهار لا يُمانَع."},{"i":4,"strength":"direct","headline":"هيبة أصحاب السلطان والملك الزائل","bridge":"تهاب صاحب سلطان؟ تدرّب على جواب أرهب سؤالٍ في القرآن: ﴿لِمَنِ الْمُلْكُ الْيَوْمَ﴾ — يوم يخرس الملوك الذين تنازعوا الملك، فيجيب سبحانه نفسه: ﴿لِلَّهِ الْوَاحِدِ الْقَهَّارِ﴾؛ من حفظ هذا الجواب في قلبه اليوم لم ينحنِ لملكٍ زائل."}],"hadiths":[{"i":3,"strength":"direct","headline":"الرهبة من سلطانٍ متسلّط وملكٍ جائر","bridge":"يثقلك ملكُ أحد؟ بين يدي الساعة ينادي الله: «لمن الملك اليوم؟ لله الواحد القهار» — كل ملكٍ تخافه اليوم سيُسأل عنه فلا يجيب إلا الواحد."}]},{"situationId":82,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"الإعجاب بالإحسان إلى الناس مع الغفلة عن الاستغفار","bridge":"تعجب بعملك؟ ابن جدعان كان يصل الرحم ويطعم المسكين، فلم ينفعه يوم البروز للواحد القهار لأنه «لم يقل يومًا: رب اغفر لي خطيئتي يوم الدين» — أضف إلى إحسانك التوحيد وسؤال المغفرة."}]},{"situationId":94,"verses":[{"i":1,"strength":"direct","headline":"تشتّت القلب بين تعلّقاتٍ كثيرة بغير الله","bridge":"من احتل قلبك أكبر مما يستحق فهو من ﴿أَرْبَابٌ مُتَفَرِّقُونَ﴾: كلٌّ يجرّك إلى جهة ولا يملك لك شيئًا؛ ويوسف في سجنه طرح السؤال الحاسم: ﴿خَيْرٌ أَمِ اللَّهُ الْوَاحِدُ الْقَهَّارُ﴾ — التعدد تفرّق وضعف، والقهر لواحدٍ يعني أن كل ما سواه مقهورٌ مثلك."},{"i":3,"strength":"direct","headline":"تعلّق القلب بمخلوقٍ مقهورٍ من دون الله","bridge":"كل ما يتعلق به قلبك من دون الله مخلوقٌ مقهور، والقاعدة في الآية: ﴿سُبْحَانَهُ هُوَ اللَّهُ الْوَاحِدُ الْقَهَّارُ﴾ — فالولد يماثل أباه ولا مماثل لمن قهر كل شيء؛ ومن كان مقهورًا لا يكون إلهًا ولا يستحق أن يحتل من قلبك ما لا يحتله إلا الواحد."}],"hadiths":[]},{"situationId":157,"verses":[],"hadiths":[{"i":2,"strength":"direct","headline":"التقلّب في الفراش والاستيقاظ من الليل","bridge":"تتقلّب في فراشك وتستيقظ من الليل؟ كان النبي ﷺ إذا تضوّر من الليل قال: «لا إله إلا الله الواحد القهار، رب السماوات والأرض وما بينهما العزيز الغفار» — قهّار للأرق، غفّار لما يقلقك."}]}]},{"id":25,"name":"الوهاب","compound":false,"meaning":"بطاقة الاسم:\nالصيغة: الْوَهَّابُ — مفردة بصيغة مبالغة | المواضع: 2 (آل عمران: 8 — ص: 35)\nخصوصية: لم يرد الاسم في القرآن إلا على ألسنة السائلين وفي ذيل دعاء: الراسخون يسألون الثبات، وسليمان يسأل الملك — فهو اسم مقام الطلب، وخاصةً الطلب الكبير.\n\nالمعنى:\n- الوهاب: كثير الهبات، يعطي عطاءً واسعًا بلا عوضٍ ولا استحقاقٍ سابق — فالهبة عطاءٌ مجاني، والوهاب من يتكرر منه ذلك ويعظم.","teaches":"الحقائق التي كشفها الموضعان:\n1. الثبات على الهداية هبةٌ تُسأل، لا مكسبٌ يُضمن — وأعلم الناس أشدهم سؤالًا له.\n2. لا سقف للطلب مع الوهاب: سليمان طلب ما لا ينبغي لأحدٍ بعده فأُعطي.\n3. الاستغفار مفتاح العطايا: «اغفر لي» ثم «هب لي».","whenRecall":"لحظات الاستحضار — مشتقة من موضعيه:\n- عند الخوف من تقلب القلب وفتنة الشبهات.\n- حين تريد أن تطلب شيئًا عظيمًا وتستحي من عظمته.","whenPray":"بنود الدعاء — مشتقة من سياق الموضعين:\n1. دعاء الثبات بنصه القرآني: ﴿رَبَّنَا لَا تُزِغْ قُلُوبَنَا بَعْدَ إِذْ هَدَيْتَنَا وَهَبْ لَنَا مِنْ لَدُنْكَ رَحْمَةً إِنَّكَ أَنْتَ الْوَهَّابُ﴾ — آل عمران 8.\n2. الطلبات الكبيرة فوق حساب الأسباب: اطلبها من الوهاب كما طلب سليمان — ص 35.\n3. تقديم الاستغفار بين يدي كل مطلب عظيم.\n4. سؤال هبات لم تخطر لك: فالوهاب يعطي بلا عوض ولا استحقاق.\n\nمن السنة: كان أكثر دعاء النبي ﷺ: «يَا مُقَلِّبَ الْقُلُوبِ ثَبِّتْ قَلْبِي عَلَى دِينِكَ» — رواه الترمذي وصححه — وهو أخو دعاء الراسخين بالمعنى.","summary":"اسمٌ لم يرد في القرآن إلا في ذيل دعاء: به سأل الراسخون ثباتَ القلب، وبه سأل سليمان ملكًا لا ينبغي لأحدٍ بعده — فلا تستصغر قلبك أن تسأله الثبات، ولا تستعظم حاجةً على الوهاب.","verses":[{"i":1,"of":2,"s":3,"surah":"آل عمران","a":8,"text":"رَبَّنَا لَا تُزِغْ قُلُوبَنَا بَعْدَ إِذْ هَدَيْتَنَا وَهَبْ لَنَا مِنْ لَدُنْكَ رَحْمَةً إِنَّكَ أَنْتَ الْوَهَّابُ","prev":{"a":7,"text":"هُوَ الَّذِي أَنْزَلَ عَلَيْكَ الْكِتَابَ مِنْهُ آيَاتٌ مُحْكَمَاتٌ هُنَّ أُمُّ الْكِتَابِ وَأُخَرُ مُتَشَابِهَاتٌ فَأَمَّا الَّذِينَ فِي قُلُوبِهِمْ زَيْغٌ فَيَتَّبِعُونَ مَا تَشَابَهَ مِنْهُ ابْتِغَاءَ الْفِتْنَةِ وَابْتِغَاءَ تَأْوِيلِهِ وَمَا يَعْلَمُ تَأْوِيلَهُ إِلَّا اللَّهُ وَالرَّاسِخُونَ فِي الْعِلْمِ يَقُولُونَ آمَنَّا بِهِ كُلٌّ مِنْ عِنْدِ رَبِّنَا وَمَا يَذَّكَّرُ إِلَّا أُولُو الْأَلْبَابِ"},"next":{"a":9,"text":"رَبَّنَا إِنَّكَ جَامِعُ النَّاسِ لِيَوْمٍ لَا رَيْبَ فِيهِ إِنَّ اللَّهَ لَا يُخْلِفُ الْمِيعَادَ"},"context":"بعد آية المحكم والمتشابه وذكر الذين في قلوبهم زيغ يتبعون ما تشابه منه، يدعو الراسخون في العلم: ﴿رَبَّنَا لَا تُزِغْ قُلُوبَنَا بَعْدَ إِذْ هَدَيْتَنَا وَهَبْ لَنَا مِنْ لَدُنْكَ رَحْمَةً إِنَّكَ أَنْتَ الْوَهَّابُ﴾.","reason":"سأل الراسخون الثباتَ بصيغة الهبة: ﴿وَهَبْ لَنَا مِنْ لَدُنْكَ﴾ — لأن ثبات القلب بعد الهداية ليس مكسبًا مضمونًا بالعلم، بل هبةٌ تُسأل من الوهاب؛ فأعلمُ الناس أخوفُهم من الزيغ وأكثرهم سؤالًا للتثبيت. والختم بـ﴿إِنَّكَ أَنْتَ الْوَهَّابُ﴾ توسلٌ: من كثرت هباته لا يضيق بسؤال الثبات.","adds":"دعاء الثبات الأشهر في القرآن معلّق بهذا الاسم — فاجعله وردك كلما خفت على قلبك، فالثبات هبةٌ تُسأل من الوهاب."},{"i":2,"of":2,"s":38,"surah":"ص","a":35,"text":"قَالَ رَبِّ اغْفِرْ لِي وَهَبْ لِي مُلْكًا لَا يَنْبَغِي لِأَحَدٍ مِنْ بَعْدِي إِنَّكَ أَنْتَ الْوَهَّابُ","prev":{"a":34,"text":"وَلَقَدْ فَتَنَّا سُلَيْمَانَ وَأَلْقَيْنَا عَلَى كُرْسِيِّهِ جَسَدًا ثُمَّ أَنَابَ"},"next":{"a":36,"text":"فَسَخَّرْنَا لَهُ الرِّيحَ تَجْرِي بِأَمْرِهِ رُخَاءً حَيْثُ أَصَابَ"},"context":"سليمان بعد الفتنة والإنابة: ﴿قَالَ رَبِّ اغْفِرْ لِي وَهَبْ لِي مُلْكًا لَا يَنْبَغِي لِأَحَدٍ مِنْ بَعْدِي إِنَّكَ أَنْتَ الْوَهَّابُ﴾ — فسُخّرت له الريح والشياطين، ووُهب عطاءً بغير حساب.","reason":"طلب سليمان عطيةً لم يطلبها أحد — ملكًا لا ينبغي لأحدٍ من بعده — ولم يكن ذلك تجاوزًا لأنه وجّه الطلب إلى «الوهاب»: كثيرُ الهبات لا يُستكثر عليه شيء. ولاحظ الترتيب: ﴿اغْفِرْ لِي﴾ قبل ﴿وَهَبْ لِي﴾ — تخليةُ الذنب قبل طلب العطية.","adds":"أدبان في آية: لا تستحِ من عِظم طلبك إذا كان المسؤول هو الوهاب، وقدّم الاستغفار بين يدي كل طلبٍ كبير."}],"hadiths":[{"i":1,"of":4,"text":"«أنَّه قَدِمَ المَدينةَ في خِلافةِ أبي بَكرٍ الصِّدِّيقِ رَضيَ اللهُ عنه، وصَلَّى خَلْفَ أبي بَكرٍ المَغربَ، فقرَأَ في الرَّكعتَينِ الأُوليَينِ بأُمِّ القُرآنِ وسورةٍ؛ سورةٍ مِن قِصارِ المُفصَّلِ، ثُمَّ قام في الرَّكعةِ الثَّالثةِ فدَنَوتُ منه حتى كاد أنْ تمَسَّ ثيابي ثيابَه، فسَمِعتُه قرَأَ بأُمِّ القُرآنِ وهذه الآيةِ: {رَبَّنَا لَا تُزِغْ قُلُوبَنَا بَعْدَ إِذْ هَدَيْتَنَا وَهَبْ لَنَا مِنْ لَدُنْكَ رَحْمَةً إِنَّكَ أَنْتَ الْوَهَّابُ} [آل عمران: 8]. ثم ذكر مثله قال ‌عبادة: فحَضَرتُ عُمَرَ بنَ عبدِ العَزيزِ وهو يقولُ لقَيسٍ، وسأَلَ عن هذا الحديثِ فحَدَّثَ به، قال عُمَرُ: ما تَرَكتُها منذ سَمِعتُكَ تُحدِّثُ به، وإنْ كنتُ قبلَ ذلك لعَلى غيرِه، قُلتُ: وما هو يا أميرَ المؤمنينَ؟ قال: كنتُ أقرَأُ: {قُلْ هُوَ اللَّهُ أَحَدٌ}.»","narrator":"أبو عبد الله الصنابحي","source":"تخريج مشكل الآثار (12/55)","grade":"صحيح","judgment":"إسناده صحيح.","url":"https://dorar.net/h/f2mR34g1","nameForm":"الْوَهَّابُ","scene":"يحكي الصنابحي: قدمت المدينة في خلافة أبي بكر فصليت خلفه المغرب، فقرأ في الركعتين الأوليين بأم القرآن وسورة من قصار المفصل، ثم قام في الثالثة فدنوت منه حتى كادت ثيابي تمس ثيابه، فسمعته يقرأ بأم القرآن وهذه الآية: ﴿رَبَّنَا لَا تُزِغْ قُلُوبَنَا بَعْدَ إِذْ هَدَيْتَنَا وَهَبْ لَنَا مِنْ لَدُنْكَ رَحْمَةً إِنَّكَ أَنْتَ الْوَهَّابُ﴾. وقال عمر بن عبد العزيز لما سمع الحديث: ما تركتها منذ سمعتها.","reason":"الصديق في خلافته، وهو أثبت الأمة، يسأل الثبات في ثالثة المغرب كل ليلة بهذه الآية؛ فالثبات هبة تُسأل من الوهاب حتى من أرسخ الناس، وعمر بن عبد العزيز لزمها لما بلغته.","adds":"أثبت الناس يسأل الثبات من الوهاب في صلاته كل ليلة."},{"i":2,"of":4,"text":"أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ كانَ يُكثِرُ في دُعائِه أنْ يَقولَ: اللَّهمَّ مُقَلِّبَ القُلوبِ، ثَبِّتْ قَلبي على دِينِكَ. قالت: قُلتُ: يا رَسولَ اللهِ، أوَإنَّ القُلوبَ لَتَتقَلَّبُ؟ قال: نَعَمْ، ما مِنْ خَلقِ اللهِ مِن بَني آدَمَ مِن بَشَرٍ إلَّا أنَّ قَلبَه بَينَ إصبَعَيْنِ مِن أصابِعِ اللهِ، فإنْ شاءَ اللهُ عزَّ وجلَّ أقامَه، وإنْ شاءَ اللهُ أزاغَه؛ فنَسألُ اللهَ رَبَّنا ألَّا يُزيغَ قُلوبَنا بَعدَ إذْ هَدانا، ونَسألُه أنْ يَهَبَ لنا مِن لَدُنْه رَحمةً، إنَّه هو الوَّهَّابُ. قالت: قُلتُ: يا رَسولَ اللهِ، ألَا تُعَلِّمُني دَعوةً أدْعو بها لِنَفْسي؟ قال: بَلى، قُولي: اللَّهمَّ رَبَّ مُحمدٍ النَّبيِّ، اغفِرْ لي ذَنْبي، وأذهِبْ غَيظَ قَلْبي، وأجِرْني مِن مُضِلَّاتِ الفِتَنِ ما أحيَيْتَنا.","narrator":"أم سلمة أم المؤمنين","source":"عمدة التفسير 1/355","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/YeMAAcfN","nameForm":"الْوَهَّابُ","scene":"قالت أم سلمة: كان النبي ﷺ يكثر في دعائه أن يقول: «اللهم مقلب القلوب ثبت قلبي على دينك»، قلت: يا رسول الله أوإن القلوب لتتقلب؟ قال: «نعم، ما من خلق الله من بني آدم من بشر إلا أن قلبه بين إصبعين من أصابع الله، فإن شاء أقامه وإن شاء أزاغه، فنسأل الله ربنا ألا يزيغ قلوبنا بعد إذ هدانا، ونسأله أن يهب لنا من لدنه رحمة إنه هو الوهاب».","reason":"النبي ﷺ نفسه يكثر سؤال الثبات ويشرح لماذا: القلوب بين أصابع الله، ثم يستشهد بآية الوهاب؛ فالثبات هبة تُسأل من الوهاب لأن القلب ليس بيد صاحبه.","adds":"القلوب بين أصابع الله فيُسأل ثباتها من الوهاب: دعاء النبي ﷺ الأكثر."},{"i":3,"of":4,"text":"أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ كان إذا استيقَظَ من اللَّيلِ قال: لا إلهَ إلَّا أنتَ، سُبْحانَكَ، اللَّهُمَّ أستَغفِرُكَ لِذَنْبي، وأسأَلُك رَحْمَتَكَ، اللَّهُمَّ زِدْني عِلمًا، ولا تُزِغْ قَلْبي بعدَ إذ هَدَيْتَني، وهَبْ لي من لدُنْكَ رَحْمةً، إنَّك أنتَ الوَّهَّابُ.","narrator":"عائشة أم المؤمنين","source":"تخريج سنن أبي داود 5061","grade":"صحيح","judgment":"رجاله رجال الصحيح إلا عبد الله بن الوليد -وهو التجيبي- فقد روى عن جمع وروى عنه جمع، وذكره ابن حبان في \"الثقات\"، وقال الدارقطني: لا يعتبر بحديثه، ولينه الحافظ في \"التقريب\".","url":"https://dorar.net/h/2yBxP9cs","nameForm":"الوَّهَّابُ","scene":"عائشة: كان النبي ﷺ إذا استيقظ من الليل قال: «لا إله إلا أنت، سبحانك، اللهم أستغفرك لذنبي، وأسألك رحمتك، اللهم زدني علمًا، ولا تزغ قلبي بعد إذ هديتني، وهب لي من لدنك رحمة، إنك أنت الوهاب».","reason":"أول الاستيقاظ لحظةُ بدايةٍ جديدة، فيطلب فيها النبي ﷺ ثلاث هبات: مغفرة، وعلمًا، وثبات قلب مع رحمة — ثم يختم بالاسم الذي يجمعها. فالوهاب يُذكر في الاستيقاظ لأن اليوم كله هبةٌ لم يعمل لها العبد بعد.","adds":"يعطي الشاهد الاسم صيغةً كاملة لأول اليقظة، وفيها طلب العلم — فالعلم عند النبي ﷺ هبةٌ تُسأل من الوهاب."},{"i":4,"of":4,"text":"عن سَلمةَ بنِ الأكوعِ رَضِيَ اللهُ تعالى عنه قال: «ما سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يستفتِحُ دُعاءً إلَّا استفتحه بـ «سبحانَ رَبِّي الأعلى العَليِّ الوَهَّابِ»","narrator":"سلمة بن الأكوع","source":"سبل الهدى والرشاد 8/508","grade":"صحيح","judgment":"[رجاله] رجال الصحيح غير عُمَرَ بن راشد اليماني، وثقه جماعة.","url":"https://dorar.net/h/1bYHlOlO","nameForm":"الوَهَّابِ","scene":"سلمة بن الأكوع: «ما سمعت رسول الله ﷺ يستفتح دعاءً إلا استفتحه بـ: سبحان ربي الأعلى العلي الوهاب».","reason":"افتتاح الدعاء بالاسم تمهيدٌ للطلب: يُنزَّه، ثم يُعلّى، ثم يُسمّى «الوهاب» — فيدخل العبد على من عرف أنه يهب قبل أن يذكر حاجته. وتقديم «الأعلى العلي» يجعل الهبة نازلةً من علو: لا يُطلب من الوهاب ما يُطلب من الأنداد.","adds":"أهم ما يقدمه الشاهد: أن الاسم مفتاحُ الدعاء النبوي — فسلمة لم يسمعه ﷺ يستفتح دعاءً إلا به. فمن أراد أن يدعو كما دعا النبي ﷺ بدأ بالوهاب."}],"sunnah":{"card":"الصيغة: الْوَهَّابُ — مفردة\nفي السنة: 4 شواهد (11 رواية)\nخصوصية الورود في السنة: الاسم في السنة اسمُ افتتاح الدعاء وطلب ثبات القلب: كان النبي ﷺ لا يستفتح دعاءً إلا بـ«سبحان ربي الأعلى العلي الوهاب»، وإذا استيقظ من الليل قال «وهب لي من لدنك رحمة إنك أنت الوهاب»، وقرأ أبو بكر في ثالثة المغرب ﴿رَبَّنَا لَا تُزِغْ قُلُوبَنَا… إِنَّكَ أَنْتَ الْوَهَّابُ﴾ فلزمها عمر بن عبد العزيز. وهو في التسعة والتسعين.\nالمعنى المختصر: كثير الهبات التي لا عوض لها ولا سبب من العبد.","teaches":"1. أن ثبات القلب هبةٌ لا كسب: يُطلب من الوهاب لا من النفس.\n2. أنه يهب في أول اليقظة قبل أي عمل: مغفرةً وعلمًا وثباتًا.\n3. أنه يُدعى قبل كل طلب: مفتاح الدعاء النبوي.\n4. أن هبته من علوّ: «الأعلى العلي الوهاب».","whenRecall":"- في أول كل دعاء: «سبحان ربي الأعلى العلي الوهاب».\n- عند الاستيقاظ من الليل.\n- في الركعة الثالثة من المغرب كما قرأ أبو بكر.\n- حين تخاف على قلبك من الزيغ.","whenPray":"عند الشعور بـ:\n1. الخوف من انقلاب القلب بعد الهداية.\n2. الحاجة إلى علمٍ لا تجد إليه سبيلًا.\n3. بداية يومٍ لا تدري ما فيه.\nعند طلب:\n1. رحمةً من لدنه بلا سبب منك.\n2. ثبات القلب على الدين.\n3. الزيادة في العلم.\nعند الرغبة في:\n1. افتتاح الدعاء كما كان النبي ﷺ يفتتحه.\n2. لزوم آية آل عمران 8 في صلاتك.","duaItems":"1. افتتاح الدعاء: «سبحان ربي الأعلى العلي الوهاب» — المستدرك 1859، وسبل الهدى 8/508 (رجاله رجال الصحيح).\n2. عند الاستيقاظ من الليل: «لا إله إلا أنت، سبحانك، اللهم أستغفرك لذنبي، وأسألك رحمتك، اللهم زدني علمًا، ولا تزغ قلبي بعد إذ هديتني، وهب لي من لدنك رحمة، إنك أنت الوهاب» — تخريج سنن أبي داود 5061.\n3. ﴿رَبَّنَا لَا تُزِغْ قُلُوبَنَا بَعْدَ إِذْ هَدَيْتَنَا وَهَبْ لَنَا مِنْ لَدُنْكَ رَحْمَةً إِنَّكَ أَنْتَ الْوَهَّابُ﴾ في ثالثة المغرب — فعل أبي بكر، تخريج مشكل الآثار 12/55 (إسناده صحيح).\n4. «اللهم مقلب القلوب ثبت قلبي على دينك» — عمدة التفسير 1/355.","summary":"«الوهاب» في السنة مفتاحُ الدعاء وهبةُ الثبات: «ما سمعته يستفتح دعاءً إلا بسبحان ربي الأعلى العلي الوهاب»، ويُسأل عند اليقظة ثبات القلب والعلم والرحمة، وقرأ أبو بكر آيته في ثالثة المغرب فلزمها عمر بن عبد العزيز — لأن ما لا كسب لك فيه لا يُطلب إلا من الوهاب."},"situations":[{"situationId":114,"verses":[{"i":1,"strength":"direct","headline":"الخوف من زيغ القلب بعد الهداية","bridge":"تخاف أن ينقلب قلبك؟ هذا خوف الراسخين في العلم، ودعاؤهم هو دعاؤك: ﴿رَبَّنَا لَا تُزِغْ قُلُوبَنَا بَعْدَ إِذْ هَدَيْتَنَا وَهَبْ لَنَا مِنْ لَدُنْكَ رَحْمَةً إِنَّكَ أَنْتَ الْوَهَّابُ﴾ — الثبات ليس مكسبًا يضمنه علمك، بل هبةٌ تُسأل من الوهاب."}],"hadiths":[{"i":1,"strength":"direct","headline":"الخوف من زيغ القلب وانقلابه بعد الهداية","bridge":"تخاف أن ينقلب قلبك؟ كان أبو بكر في خلافته يقرأ في ثالثة المغرب: ﴿رَبَّنَا لَا تُزِغْ قُلُوبَنَا بَعْدَ إِذْ هَدَيْتَنَا وَهَبْ لَنَا مِنْ لَدُنْكَ رَحْمَةً إِنَّكَ أَنْتَ الْوَهَّابُ﴾ — أثبت الأمة يسأل الثبات من الوهاب كل ليلة؛ فمن كان دونه أولى، وقال عمر بن عبد العزيز: ما تركتها منذ سمعتها."},{"i":2,"strength":"direct","headline":"الخوف من زيغ القلب بعد الهداية","bridge":"تظن قلبك بيدك؟ قال النبي ﷺ لأم سلمة: «ما من بشر إلا قلبه بين إصبعين من أصابع الله فإن شاء أقامه وإن شاء أزاغه، فنسأل الله ألا يزيغ قلوبنا… ونسأله أن يهب لنا من لدنه رحمة إنه هو الوهاب» — أكثر دعائه ﷺ: مقلب القلوب ثبت قلبي؛ فاسأل الثبات هبةً من الوهاب."}]},{"situationId":157,"verses":[],"hadiths":[{"i":3,"strength":"direct","headline":"الاستيقاظ من الليل وافتتاح اليوم بسؤال الهبات","bridge":"وردك عند الاستيقاظ؟ كان النبي ﷺ إذا استيقظ من الليل قال: «…اللهم زدني علمًا، ولا تزغ قلبي بعد إذ هديتني، وهب لي من لدنك رحمة، إنك أنت الوهاب» — افتح يومك بطلب ثلاث هبات."}]},{"situationId":162,"verses":[],"hadiths":[{"i":4,"strength":"direct","headline":"تقديم الثناء على الله قبل عرض الحاجة","bridge":"تريد أن تُحسن الطلب؟ ابدأ كما بدأ النبي ﷺ كل دعاء: «سبحان ربي الأعلى العلي الوهاب» — تنزيهٌ وتعلية وتسميةٌ للوهاب قبل أن تذكر حاجتك."}]},{"situationId":164,"verses":[{"i":2,"strength":"direct","headline":"التردد في طلب عطاءٍ عظيم من الله","bridge":"تريد أن تُحسن الطلب؟ سليمان طلب ما لم يطلبه أحد — ملكًا لا ينبغي لأحدٍ من بعده — ولم يكن تجاوزًا لأنه وجّهه إلى الوهاب، وقدّم قبله ﴿رَبِّ اغْفِرْ لِي﴾: تخليةُ الذنب قبل طلب العطية، ولا حياء من عِظم الطلب إذا كان المسؤول الوهاب."}],"hadiths":[]}]},{"id":26,"name":"الرحيم الغفور","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: الرَّحِيمُ الْغَفُورُ — مركّبة | المواضع: 1 (سبأ: 2)\nخصوصية: الموضع الوحيد في القرآن الذي تقدم فيه «الرحيم» على «الغفور» — عكس الترتيب المعتاد (غفور رحيم) — وجاء عقب أشمل آية إحاطةٍ علمية بحركات الكون.\n\nالمعنى:\n- الرحيم: واصل الرحمة إلى عباده.\n- الغفور: الساتر المتجاوز.\nسر التقديم هنا: المقام مقام إحاطة علمٍ قد تُخيف — فقُدّمت الرحمة طمأنةً قبل ذكر المغفرة.","teaches":"الحقائق التي كشفها الموضع:\n1. لا تخرج حركةٌ في الكون — ولا في حياتك — عن علمه: ولوجًا وخروجًا ونزولًا وعروجًا.\n2. علمه بك مقرون برحمته: يعلم فيرحم ويستر — لا يعلم فيفضح.\n3. تقديم الرحيم على الغفور في مقام هيبة الإحاطة — بلاغة الطمأنة.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند استشعار أن أدق تفاصيلك مكشوفة له.\n- عند صعود دعائك وعملك: هو مما «يعرج فيها».","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. عند خوف الافتضاح بما يعلمه منك: التوسل بأن علمه مقرون برحمته وستره — سبأ 2.\n2. سؤال قبول ما يعرج إليه من عملك ودعائك.\n3. طلب الستر في النازل والصاعد: فيما يقدّر لك وفيما يرفع عنك.\n\nدعاء مقتبس من الآية:\n«اللهم يا رحيم يا غفور، يا من يعلم ما يلج في الأرض وما يخرج منها وما ينزل من السماء وما يعرج فيها: ارحم ضعفًا تعلمه مني، واستر ذنبًا أحطتَ به، وتقبّل ما يعرج إليك من دعائي وعملي».","summary":"أحاط علمُه بكل والجٍ وخارجٍ ونازلٍ وعارج — ثم قال عن نفسه قبل أن ترتعب: ﴿وَهُوَ الرَّحِيمُ الْغَفُورُ﴾ — فعلمُه بك أمانٌ لا فضيحة.","verses":[{"i":1,"of":1,"s":34,"surah":"سبأ","a":2,"text":"يَعْلَمُ مَا يَلِجُ فِي الْأَرْضِ وَمَا يَخْرُجُ مِنْهَا وَمَا يَنْزِلُ مِنَ السَّمَاءِ وَمَا يَعْرُجُ فِيهَا وَهُوَ الرَّحِيمُ الْغَفُورُ","prev":{"a":1,"text":"الْحَمْدُ لِلَّهِ الَّذِي لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَلَهُ الْحَمْدُ فِي الْآخِرَةِ وَهُوَ الْحَكِيمُ الْخَبِيرُ"},"next":{"a":3,"text":"وَقَالَ الَّذِينَ كَفَرُوا لَا تَأْتِينَا السَّاعَةُ قُلْ بَلَى وَرَبِّي لَتَأْتِيَنَّكُمْ عَالِمِ الْغَيْبِ لَا يَعْزُبُ عَنْهُ مِثْقَالُ ذَرَّةٍ فِي السَّمَاوَاتِ وَلَا فِي الْأَرْضِ وَلَا أَصْغَرُ مِنْ ذَلِكَ وَلَا أَكْبَرُ إِلَّا فِي كِتَابٍ مُبِينٍ"},"context":"﴿يَعْلَمُ مَا يَلِجُ فِي الْأَرْضِ وَمَا يَخْرُجُ مِنْهَا وَمَا يَنْزِلُ مِنَ السَّمَاءِ وَمَا يَعْرُجُ فِيهَا وَهُوَ الرَّحِيمُ الْغَفُورُ﴾ — أربعُ حركاتٍ تستوعب كل ما في الكون: كل والجٍ في الأرض من قطرةٍ وبذرةٍ وميت، وكل خارجٍ منها من نبتٍ وماء، وكل نازلٍ من السماء من رزقٍ وملَك، وكل عارجٍ فيها من عملٍ وروحٍ ودعاء.","reason":"بعد هذه الإحاطة المطلقة — التي تشمل أعمالك الصاعدة ودعواتك وأنفاسك — جاء الختم: ﴿وَهُوَ الرَّحِيمُ الْغَفُورُ﴾ بتقديم الرحمة: فعلمُه المحيط بك ليس علمَ رقيبٍ يتربص، بل علمَ رحيمٍ يرحم ما يعلم من ضعفك، غفورٍ يستر ما يعلم من ذنبك. فالإحاطة مقرونة بالأمان.","adds":"يصحح صورة المراقبة الإلهية: من عرف أن المحيطَ بكل والجٍ وخارج «رحيمٌ غفور» عاش بين مهابة العلم وطمأنينة الرحمة — لا في رعب المراقَب."}],"hadiths":[],"situations":[{"situationId":90,"verses":[{"i":1,"strength":"direct","headline":"ظنّ أن علم الله بتكرار ذنبك تربّصٌ بك","bridge":"تظن أن عودك المتكرر مرصودٌ عند رقيبٍ يتربص؟ الآية تحصي كل والجٍ وخارجٍ ونازلٍ وصاعد — أعمالك ودعواتك وأنفاسك — ثم تختم: ﴿وَهُوَ الرَّحِيمُ الْغَفُورُ﴾ بتقديم الرحمة؛ فعلمه المحيط بك علمُ رحيمٍ يرحم ما يعلم من ضعفك، وغفورٍ يستر ما يعلم من ذنبك."}],"hadiths":[]}]},{"id":27,"name":"خير الراحمين","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: خَيْرُ الرَّاحِمِينَ — صيغة تفضيل | المواضع: 2 (المؤمنون: 109، 118)\nخصوصية: موضعاه في سورةٍ واحدة: مرةً على لسان المستضعفين الذين سُخر منهم — ودعاؤهم يُتلى يوم القيامة سببَ فوزهم — ومرةً أمرًا مباشرًا للنبي ﷺ في آخر آيةٍ من السورة.\n\nالمعنى:\n- خير الراحمين: أفضل من رحم وأكملهم رحمةً — فكل رحمةٍ في الخلق ذرةٌ من رحمته، وهو فوق كل راحم.","teaches":"الحقائق التي كشفها الموضعان:\n1. دعاء المظلومين المسخور منهم محفوظ عند الله يُتلى يوم القيامة.\n2. الرد الأبلغ على السخرية: صبرٌ ودعاء — والفوز النهائي للصابرين الداعين.\n3. المغفرة والرحمة جماع حاجة العبد: بهما ختمت سورة الفلاح.","whenRecall":"لحظات الاستحضار — مشتقة من موضعيه:\n- حين يُسخر منك أو من تدينك.\n- في ختام اليوم والمجلس والعمل.","whenPray":"بنود الدعاء — مشتقة من سياق الموضعين:\n1. عند التعرض للسخرية والاستهزاء لأجل إيمانك: دعاء الفريق الفائز — ﴿رَبَّنَا آمَنَّا فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الرَّاحِمِينَ﴾ — المؤمنون 109.\n2. الوِرد المأمور به نصًّا: ﴿رَبِّ اغْفِرْ وَارْحَمْ وَأَنْتَ خَيْرُ الرَّاحِمِينَ﴾ — المؤمنون 118.\n3. الصبر على الأذى مع الدعاء — فبهما معًا كان الفوز: ﴿إِنِّي جَزَيْتُهُمُ الْيَوْمَ بِمَا صَبَرُوا﴾.","summary":"فريقٌ سُخر منهم فقالوا: ﴿رَبَّنَا آمَنَّا فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الرَّاحِمِينَ﴾ — فتُلي دعاؤهم يوم القيامة وقيل: هم الفائزون. فقل قولهم واصبر صبرهم.","verses":[{"i":1,"of":2,"s":23,"surah":"المؤمنون","a":109,"text":"إِنَّهُ كَانَ فَرِيقٌ مِنْ عِبَادِي يَقُولُونَ رَبَّنَا آمَنَّا فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الرَّاحِمِينَ","prev":{"a":108,"text":"قَالَ اخْسَئُوا فِيهَا وَلَا تُكَلِّمُونِ"},"next":{"a":110,"text":"فَاتَّخَذْتُمُوهُمْ سِخْرِيًّا حَتَّى أَنْسَوْكُمْ ذِكْرِي وَكُنْتُمْ مِنْهُمْ تَضْحَكُونَ"},"context":"المشهد في جهنم، والحوار في ذروته: أهلُ النار يستغيثون ﴿رَبَّنَا أَخْرِجْنَا مِنْهَا فَإِنْ عُدْنَا فَإِنَّا ظَالِمُونَ﴾ — فيأتي الجواب الذي ينهي كل رجاء: ﴿اخْسَئُوا فِيهَا وَلَا تُكَلِّمُونِ﴾. ثم — وهذا موضع العجب — يُذكّرهم سبحانه بسبب مصيرهم، فيقتبس لهم دعاءً قديمًا كانوا يسمعونه في الدنيا ويضحكون منه: ﴿إِنَّهُ كَانَ فَرِيقٌ مِنْ عِبَادِي يَقُولُونَ رَبَّنَا آمَنَّا فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الرَّاحِمِينَ﴾. فريقٌ مستضعف، دعاؤه بسيط: إيمانٌ ومغفرةٌ ورحمة، لا يشكو ساخريه ولا يدعو عليهم. ﴿فَاتَّخَذْتُمُوهُمْ سِخْرِيًّا حَتَّى أَنْسَوْكُمْ ذِكْرِي وَكُنْتُمْ مِنْهُمْ تَضْحَكُونَ﴾. فالسخريةُ التي ملأت مجالسهم بالدنيا صارت هي التهمة، والدعاءُ المسخور منه صار وثيقةَ الفوز تُتلى في أعظم موقف.","reason":"حُفظ دعاءُ المستضعفين بحروفه وتُلي في الموقف الأعظم شاهدَ فوزهم: قومٌ سُخر منهم فما ردّوا بمثلها، بل لجؤوا إلى «خير الراحمين» بالمغفرة والرحمة وصبروا — فكان الجزاء: هم الفائزون. فالاسم هنا ملاذُ من ضاق بسخرية الخلق: يطلب الرحمة من خيرٍ من كل الساخرين والراحمين معًا.","adds":"دعاؤك اليوم قد يُتلى يوم القيامة بحروفه شاهدًا لك — فاختر كلماتك كما اختار هذا الفريق."},{"i":2,"of":2,"s":23,"surah":"المؤمنون","a":118,"text":"وَقُلْ رَبِّ اغْفِرْ وَارْحَمْ وَأَنْتَ خَيْرُ الرَّاحِمِينَ","prev":{"a":117,"text":"وَمَنْ يَدْعُ مَعَ اللَّهِ إِلَهًا آخَرَ لَا بُرْهَانَ لَهُ بِهِ فَإِنَّمَا حِسَابُهُ عِنْدَ رَبِّهِ إِنَّهُ لَا يُفْلِحُ الْكَافِرُونَ"},"context":"آخر آيةٍ في سورة المؤمنون — وقبلها مباشرةً قُرر ﴿إِنَّهُ لَا يُفْلِحُ الْكَافِرُونَ﴾ — يُؤمر النبي ﷺ: ﴿وَقُلْ رَبِّ اغْفِرْ وَارْحَمْ وَأَنْتَ خَيْرُ الرَّاحِمِينَ﴾.","reason":"خُتمت السورة بدعاءٍ وجيزٍ جامع: طلبان مطلقان بلا قيد — اغفر (لكل ما مضى) وارحم (في كل ما يأتي) — وثناءٌ بالاسم. فبعد تقرير أن الكافرين لا يفلحون عُلّق الفلاح بالمغفرة والرحمة من خير الراحمين، والأمرُ بـ﴿وَقُلْ﴾ يجعله وِردًا مأمورًا به.","adds":"كلماتٌ قليلة تجمع حاجة الدارين: ﴿رَبِّ اغْفِرْ وَارْحَمْ﴾ — اجعلها خاتمة يومك ومجلسك، فقد اختارها الله خاتمةً لسورة المؤمنون."}],"hadiths":[],"situations":[{"situationId":34,"verses":[{"i":1,"strength":"direct","headline":"السخرية منك بسبب تديّنك والتزامك","bridge":"يُسخر منك لأجل التزامك؟ فريقٌ من العباد اتُّخذوا سخريًّا فلم يردّوا بمثلها بل قالوا: ﴿رَبَّنَا آمَنَّا فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الرَّاحِمِينَ﴾ — وحُفظ دعاؤهم بحروفه ليُتلى يوم القيامة شاهدَ فوزهم؛ فاختر كلماتك كما اختاروا."}],"hadiths":[]},{"situationId":158,"verses":[{"i":2,"strength":"direct","headline":"ختام العمل أو اليوم بطلب المغفرة والرحمة","bridge":"تنهي مجلسًا أو عملًا أو يومًا؟ اختر ما اختاره الله خاتمةً لسورة المؤمنون: ﴿وَقُلْ رَبِّ اغْفِرْ وَارْحَمْ وَأَنْتَ خَيْرُ الرَّاحِمِينَ﴾ — كلماتٌ تجمع حاجة الدارين: مغفرةً لما مضى ورحمةً فيما يأتي، والأمر بـ﴿وَقُلْ﴾ يجعلها وِردًا مأمورًا به."}],"hadiths":[]}]},{"id":28,"name":"الله الصمد","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: اللَّهُ الصَّمَدُ — مركّبة | المواضع: 1 (الإخلاص: 2)\nخصوصية: الآية الثانية من السورة التي تعدل ثلث القرآن، وأُعيد فيها لفظ الجلالة (ولم يقل: وهو الصمد) — تقريرًا مستقلًا يُحفظ وحده.\n\nالمعنى:\n- الصمد: السيدُ الذي كمُل سؤددُه، الذي تصمُد إليه الخلائق — أي تقصده وتعتمد عليه — في حوائجها كلها؛ يحتاجه كلُّ شيء ولا يحتاج إلى شيء، ولا جوف له فلا يأكل ولا يشرب.","teaches":"الحقائق التي كشفها الموضع:\n1. الخلق كلهم يصمدون إليه في حوائجهم، وهو الغني عن الجميع.\n2. الأحدية والصمدية معًا تهدمان كل شرك: لا مثيل له، ولا غنى عنه.\n3. غنى الله المطلق أصلُ التنزيه: من لا يحتاج لا يلد ولا يولد.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند تعدد حوائجك وتزاحم أبواب المخلوقين.\n- في قراءة الإخلاص: ثلث القرآن في وردك اليومي.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. اجعل قصدك (صمدك) في كل حاجةٍ إليه أولًا قبل أبواب الخلق.\n2. التوسل به في الدعاء الذي شهد له النبي ﷺ (من قاعدة الأحاديث): «اللَّهُمَّ إِنِّي أَسْأَلُكَ يَا اللهُ الأَحَدُ الصَّمَدُ، الَّذِي لَمْ يَلِدْ وَلَمْ يُولَدْ وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ، أَنْ تَغْفِرَ لِي ذُنُوبِي إِنَّكَ أَنْتَ الغَفُورُ الرَّحِيمُ» — صحيح أبي داود (985)، قال ﷺ: «قد غُفر له».\n3. عند انسداد الأبواب البشرية وخذلانها: بابُ الصمد لا يُغلق ولا يزدحم.","summary":"كلُّ من تطرق بابه محتاجٌ يصمد إلى الصمد مثلك — فاختصر الطريق: اقصد من يقصده الجميع ولا يحتاج أحدًا.","verses":[{"i":1,"of":1,"s":112,"surah":"الإخلاص","a":2,"text":"اللَّهُ الصَّمَدُ","prev":{"a":1,"text":"قُلْ هُوَ اللَّهُ أَحَدٌ"},"next":{"a":3,"text":"لَمْ يَلِدْ وَلَمْ يُولَدْ"},"context":"بعد إعلان الأحدية ﴿قُلْ هُوَ اللَّهُ أَحَدٌ﴾ يأتي التقرير الثاني: ﴿اللَّهُ الصَّمَدُ﴾ — ثم تُبنى عليهما بقية السورة: لم يلد ولم يولد، ولم يكن له كفوًا أحد.","reason":"قُرنت الصمديةُ بالأحدية لأنهما جناحا التوحيد: «أحد» ينفي المثيل والشريك، و«الصمد» يثبت افتقارَ كل شيءٍ إليه واستغناءَه عن كل شيء — فمن كان الكلُّ يصمد إليه وهو لا يصمد إلى أحد، استحال عليه الولدُ والوالد والكفء، وهو ما فصّلته الآيتان بعدها. وإعادةُ لفظ الجلالة تجعلها جملةً مستقلة تُحفظ وتُدعى بها.","adds":"الصمدية ميزانُ حياتك اليومية: أبوابُ الخلق كلُّها أبوابُ محتاجين إلى الصمد — فمن وقف عليها دونه فقد عكس الاتجاه."}],"hadiths":[{"i":1,"of":5,"text":"خَرَجَ إلينا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: أقرَأُ علَيكُم ثُلُثَ القُرآنِ، فقَرَأ: {قُل هو اللهُ أحَدٌ * اللهُ الصَّمَدُ} حتَّى خَتَمَها.","narrator":"أبو هريرة","source":"صحيح مسلم 812","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/c8nx8Vqz","nameForm":"اللهُ الصَّمَدُ","scene":"يخرج النبي ﷺ إلى أصحابه فيقول: «أقرأ عليكم ثلث القرآن» — فقرأ ﴿قُلْ هُوَ اللَّهُ أَحَدٌ * اللَّهُ الصَّمَدُ﴾ حتى ختمها. صحيح مسلم.","reason":"السورة تعدل ثلث القرآن لأنها تجمع صفة الله خالصةً: أحدٌ في ذاته، صمدٌ يُقصد ولا يقصد، لا يلد ولا يولد، لا كفء له. و«الصمد» هو القلب من هذه الصفة: كل الخلق يحتاجون إليه وهو لا يحتاج، وهذا ما يُصدَّر به علم التوحيد الذي هو ثلث الدين.","adds":"يقدّر الشاهد وزن الاسم: سورةٌ من أربع آيات في وسطها «الصمد» تُساوي ثلث القرآن؛ فالاسم من أثقل ما يُقرأ."},{"i":2,"of":5,"text":"أقبلتُ مَعَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فسمِعَ رجُلًا يقرَأُ: {قُلْ هُوَ اللَّهُ أَحَدٌ (1) اللَّهُ الصَّمَدُ (2) لَمْ يَلِدْ وَلَمْ يُولَدْ (3) وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ} [الإخلاص: 1 - 4]، فقالَ: قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: وَجَبَتْ، فسألتُهُ: ماذا يا رسولَ اللهِ؟ فقالَ: الجنَّةُ، فقالَ أبو هُريرةَ: فأردْتُ أنْ أذهَبَ إلى الرَّجُلِ فأُبَشِّرَهُ، ثُمَّ فَرِقْتُ أنْ يَفوتَني الغَداءُ مَعَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فآثَرْتُ الغَداءَ، ثُمَّ ذهبتُ إلى الرَّجُلِ، فوجدتُهُ قدْ ذهَبَ.","narrator":"أبو هريرة","source":"تخريج شرح السنة 1211","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/EdLMI6rA","nameForm":"اللَّهُ الصَّمَدُ","scene":"أبو هريرة يُقبل مع النبي ﷺ فيسمع رجلًا يقرأ ﴿قُلْ هُوَ اللَّهُ أَحَدٌ * اللَّهُ الصَّمَدُ…﴾ فيقول النبي ﷺ: «وجبت». قال: ماذا يا رسول الله؟ قال: «الجنة». فأراد أبو هريرة أن يذهب فيبشّره.","reason":"لم يقل النبي ﷺ «وجبت» لقراءةٍ عامة بل لهذه السورة بعينها — لأن من يقرأ «الله الصمد» فقد أعلن أن مقصوده في حوائجه واحدٌ لا يحتاج، فوجبت له الجنة بوجوب التوحيد. فالاسم علّة الوجوب.","adds":"يُري الشاهد الأثر الفوري لقراءة الاسم: حكمٌ نبويٌّ بالجنة لقارئٍ لم يُسمَّ، وفرحُ أبي هريرة بالتبشير."},{"i":3,"of":5,"text":"عن أبي بن كعب: أنَّ المشركينَ قالوا: يا مُحمَّدُ، انسُبْ لنا ربَّكَ. فأَنزلَ اللهُ عزَّ وجلَّ: {قُلْ هُوَ اللَّهُ أَحَدٌ (1) اللَّهُ الصَّمَدُ (2) لَمْ يَلِدْ وَلَمْ يُولَدْ (3) وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ (4)} [الإخلاص: 1 - 4] لأنَّهُ ليس شيءٌ يُولدُ إلَّا سيَموتُ، وليس شيءٌ يموتُ إلَّا سيُورثُ، وإنَّ اللهَ لا يموتُ ولا يُورثُ، {وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ}: لمْ يكُنْ له شَبيهٌ، ولا عَدْلٌ، وليس كمِثلِهِ شيءٌ.","narrator":"أبي بن كعب","source":"المستدرك على الصحيحين 4035","grade":"صحيح","judgment":"صحيح الإسناد","url":"https://dorar.net/h/HCJNqNjp","nameForm":"اللَّهُ الصَّمَدُ","scene":"أبيّ بن كعب: قال المشركون: يا محمد، انسب لنا ربك. فأنزل الله ﴿قُلْ هُوَ اللَّهُ أَحَدٌ * اللَّهُ الصَّمَدُ * لَمْ يَلِدْ وَلَمْ يُولَدْ * وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ﴾. ويفسّر أبيّ: لأنه ليس شيءٌ يولد إلا سيموت، وليس شيء يموت إلا سيورث، وإن الله لا يموت ولا يورث، ولم يكن له شبيه ولا عدل.","reason":"طُلب نسبٌ فأُجيب باسم: الصمد هو نسب الله — والنسب عند العرب يقوم على الولادة، فجاء «الصمد» ينفي الولادة من الجهتين ﴿لَمْ يَلِدْ وَلَمْ يُولَدْ﴾، لأن الصمد الذي لا جوف له ولا حاجة لا يلد ولا يُولد. وتفسير أبيّ يربط الاسم بالخلود: من يولد يموت ويُورث، والصمد لا يموت ولا يُورث.","adds":"يُبيّن الشاهد سبب نزول الاسم وتفسير صحابيٍّ قارئ له: الصمد هو جواب «انسب لنا ربك»."},{"i":4,"of":5,"text":"فذَكَرَ نحوَه [أي نحوَ حديثِ: لا يزالُ النَّاسُ يَتساءَلونَ حتى يُقالَ: هذا خَلَقَ اللهُ الخَلْقَ، فمَن خلَقَ اللهَ؟ فمَن وجَدَ من ذلك شيئًا، فلْيَقُلْ: آمَنتُ باللهِ]، قال: فإذا قالوا ذلك، فقُولوا: {قُلْ هُوَ اللَّهُ أَحَدٌ * اللَّهُ الصَّمَدُ * لَمْ يَلِدْ وَلَمْ يُولَدْ * وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ} [الإخلاص: 1-4] ثُمَّ لْيَتْفُلْ عن يَسارِه ثلاثًا، ولْيَستَعِذْ من الشَّيطانِ.","narrator":"أبو هريرة","source":"تخريج سنن أبي داود 4722","grade":"صحيح","url":"https://dorar.net/h/tjTNsDnY","nameForm":"اللَّهُ الصَّمَدُ","scene":"أبو هريرة عن النبي ﷺ: «لا يزال الناس يتساءلون حتى يقال: هذا خلق الله الخلق، فمن خلق الله؟ فمن وجد من ذلك شيئًا فليقل: آمنت بالله»، وفي هذه الرواية: «فإذا قالوا ذلك فقولوا: ﴿قُلْ هُوَ اللَّهُ أَحَدٌ * اللَّهُ الصَّمَدُ * لَمْ يَلِدْ وَلَمْ يُولَدْ * وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ﴾ ثم ليتفل عن يساره ثلاثًا وليستعذ من الشيطان».","reason":"وسواس «من خلق الله» وسواسُ التسلسل في الولادة والأصل، والسورة تقطعه بالاسم: الصمد لم يُولد فلا أصل قبله، ولم يلد فلا فرع من جنسه. فالاسم علاجٌ منطقيٌّ للوسواس لا مجرد تعوذ، ثم يُتبع بالتفل والاستعاذة.","adds":"يجعل الشاهد الاسم رقيةً للعقل: يُقرأ عند سؤال «من خلق الله» — فالسنة تُعيّن الاسم علاجًا لأخطر الوساوس."},{"i":5,"of":5,"text":"أيَعجِزُ أحَدُكم أنْ يَقرَأَ ثُلُثَ القُرآنِ في لَيْلةٍ؛ فإنَّه مَن قَرَأَ {قُلْ هُوَ اللَّهُ أَحَدٌ * اللَّهُ الصَّمَدُ} [الإخلاص: 1، 2] في لَيْلةٍ فقد قَرَأَ لَيلَتئِذٍ ثُلُثَ القُرآنِ.","narrator":"أبو أيوب الأنصاري","source":"تخريج المسند لشعيب 23554","grade":"صحيح","judgment":"صحيح لغيره","url":"https://dorar.net/h/VGYiql8j","nameForm":"اللَّهُ الصَّمَدُ","scene":"أبو أيوب عن النبي ﷺ: «أيعجز أحدكم أن يقرأ ثلث القرآن في ليلة؟ فإنه من قرأ ﴿قُلْ هُوَ اللَّهُ أَحَدٌ * اللَّهُ الصَّمَدُ﴾ في ليلة فقد قرأ ليلتئذ ثلث القرآن».","reason":"الاستفهام «أيعجز أحدكم» يُحوّل فضل الاسم إلى وردٍ ليلي: السورة قصيرة، والصمد في وسطها، فمن قرأها في ليلة نال ثلث القرآن — لأن الله الصمد يُقصد في الحوائج، ومن قصده ليلًا بسورته قصده بأخصّ ما وصف به نفسه.","adds":"يحدد الشاهد وقتًا: في الليل — فيصير الاسم من أذكار الليل المضاعفة الأجر."}],"sunnah":{"card":"الصيغة: اللَّهُ الصَّمَدُ — مركّبة من لفظ الجلالة واسم، وهي الآية الثانية من سورة الإخلاص\nفي السنة: 5 شواهد (7 روايات)\nخصوصية الورود في السنة: كل شواهد الاسم في سورة الإخلاص: النبي ﷺ يقرؤها ويسمّيها ثلث القرآن، ويقول لمن يقرؤها «وجبت» الجنة، ويُخبر أنها نزلت جوابًا لقريش «انسب لنا ربك»، ويأمر أن تُقرأ عند وسوسة «من خلق الله». فالصمد في السنة اسمُ نسب الله الذي يُردّ به الوسواس وتُنال به الجنة.\nالمعنى المختصر: السيد الذي يُقصد في الحوائج كلها، الكامل الذي لا جوف له ولا حاجة، لم يلد ولم يولد.","teaches":"1. أنه يُقصد في الحوائج كلها ولا يحتاج إلى أحد.\n2. أنه لا يلد ولا يولد فلا يموت ولا يُورث.\n3. أن سورته ثلث القرآن، وأنها توجب الجنة لقارئها.\n4. أنه جواب «انسب لنا ربك» وجواب «من خلق الله».","whenRecall":"- في ليلك: اقرأها فهي ثلث القرآن.\n- إذا هجم عليك خاطر «من خلق الله».\n- حين يسألك أحدٌ عن ربك: هذه نسبته.\n- حين تقصد أحدًا في حاجة: الصمد قبله.","whenPray":"عند الشعور بـ:\n1. وسواسٍ في أصل الخالق.\n2. الحاجة إلى خلقٍ يقضون حوائجك.\n3. تقصير الورد الليلي.\nعند طلب:\n1. الجنة التي قال النبي ﷺ لقارئها «وجبت».\n2. ثباتٍ في التوحيد يردّ الشبهات.\nعند الرغبة في:\n1. قراءة الإخلاص كل ليلة.\n2. تعليم الأبناء نسب الله كما نزل.","duaItems":"1. ﴿قُلْ هُوَ اللَّهُ أَحَدٌ * اللَّهُ الصَّمَدُ * لَمْ يَلِدْ وَلَمْ يُولَدْ * وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ﴾ في الليل — تعدل ثلث القرآن — صحيح مسلم 812، وتخريج المسند 23554 (صحيح لغيره).\n2. عند وسوسة «من خلق الله»: تقرأ السورة ثم تتفل عن يسارك ثلاثًا وتستعيذ — تخريج سنن أبي داود 4722 (صحيح).","summary":"«الله الصمد» في السنة نسبُ الله الذي نزل جوابًا لقريش: يُقرأ فتُعدل ثلث القرآن، ويُقال لقارئه «وجبت» الجنة، ويُقرأ عند وسوسة «من خلق الله» فيقطعها — لأن الصمد لا أصل قبله ولا فرع بعده."},"situations":[{"situationId":6,"verses":[{"i":1,"strength":"direct","headline":"تخلّي من كنت تعدّهم سندًا","bridge":"تخلّى عنك من كنت تعدّهم سندًا؟ ما تخلّوا عنك إلا لأنهم محتاجون مثلك، والآية تحسم: ﴿اللَّهُ الصَّمَدُ﴾ — الكلُّ يصمد إليه في حاجاته وهو لا يصمد إلى أحد؛ فالسند الذي لا ينقطع هو من لا يحتاج إلى أحدٍ ليكون سندًا."}],"hadiths":[]},{"situationId":95,"verses":[],"hadiths":[{"i":2,"strength":"direct","headline":"تفرّق القلب في طلب الحوائج من الخلق","bridge":"تقرأ الإخلاص وتمرّ عليها سريعًا؟ رجلٌ سمعه النبي ﷺ يقرؤها فقال: «وجبت» — الجنة. قف عند «الله الصمد»: كل ما تقصده في حوائجك يقصد الصمد."}]},{"situationId":104,"verses":[],"hadiths":[{"i":4,"strength":"direct","headline":"وسوسة التسلسل في الخلق وقطعها بالتوحيد","bridge":"خاطر يقتحم قلبك: من خلق الله؟ النبي ﷺ عيّن الدواء: «فقولوا: قل هو الله أحد، الله الصمد، لم يلد ولم يولد… ثم ليتفل عن يساره ثلاثًا وليستعذ» — الصمد لم يُولد فلا أصل قبله، وبهذا ينقطع التسلسل."}]},{"situationId":106,"verses":[],"hadiths":[{"i":3,"strength":"direct","headline":"شبهة نسبة الولد أو الأصل إلى الله","bridge":"سُئلت عن ربك؟ قالت قريش «انسب لنا ربك» فنزل ﴿اللَّهُ الصَّمَدُ * لَمْ يَلِدْ وَلَمْ يُولَدْ﴾ — نسبُ الله أنه لا نسب له: الصمد لا يموت ولا يورث."}]},{"situationId":155,"verses":[],"hadiths":[{"i":5,"strength":"direct","headline":"قِصَر ورد الليل والرغبة في أجرٍ عظيم بعمل يسير","bridge":"تقوم من الليل وتخشى قصر وردك؟ «أيعجز أحدكم أن يقرأ ثلث القرآن في ليلة؟» — اقرأ ﴿اللَّهُ الصَّمَدُ﴾ في سورتها ليلًا تنل ثلث القرآن."}]},{"situationId":191,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"استصغار سورة الإخلاص والغفلة عن وزنها","bridge":"تقرأ الإخلاص وتحسبها سورة صغيرة؟ خرج النبي ﷺ فقال: «أقرأ عليكم ثلث القرآن» فقرأ ﴿قُلْ هُوَ اللَّهُ أَحَدٌ * اللَّهُ الصَّمَدُ﴾ حتى ختمها — أربع آيات في وسطها الصمد تعدل ثلث القرآن لأنها صفة الله خالصة؛ فالاسم من أثقل ما يُقرأ."}]}]},{"id":29,"name":"الملك المقتدر","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: مَلِيكٍ مُقْتَدِرٍ — مركّبة منكّرة | المواضع: 1 (القمر: 55)\nخصوصية: آخر آيةٍ في سورة القمر — سورة الإنذارات المتتابعة (كذبت قوم نوح، وعاد، وثمود...) — تُختم بأجمل مشهد قرب: المتقون في مقعد صدقٍ عند مليكٍ مقتدر.\n\nالمعنى:\n- مليك: صيغة مبالغة من الملك — التام الملك.\n- مقتدر: البالغ غاية القدرة، لا يمتنع عليه شيء.\nسر الاقتران: ملكٌ تام بقدرةٍ تامة — فجوارُه أعظم الجوار، وضيافته لا يعتريها نقص ولا زوال.","teaches":"الحقائق التي كشفها الموضع:\n1. أعلى النعيم القربُ والجوار: «عند مليك مقتدر» فوق «جنات ونهر».\n2. مقعد الصدق ثابتٌ لا يتبدل — لأن مضيفه مقتدر لا يعجزه شيء.\n3. السورة ميزان: مصارع للمكذبين، ومقعد صدقٍ للمتقين — والقرآن ميسّر لمن ادّكر.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند مجالس الدنيا الزائلة والمجاملات الكاذبة: تذكّر مقعد الصدق.\n- عند السعي في التقوى: هذه غايتها.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. سؤال مقعد الصدق: «اللهم اجعلنا في مقعد صدقٍ عندك» — القمر 55.\n2. سؤال التقوى الموصلة إليه: ﴿إِنَّ الْمُتَّقِينَ﴾ — فهي بطاقة الدخول.\n3. عند الادّكار بالقرآن الميسّر: سؤال أن تكون من المدّكرين لا المكذبين.","summary":"بعد سورةٍ من المصارع، خُتم الطريق بغايته: ﴿فِي مَقْعَدِ صِدْقٍ عِنْدَ مَلِيكٍ مُقْتَدِرٍ﴾ — فاطلب الجوارَ قبل الدار، والصدقَ قبل النعيم.","verses":[{"i":1,"of":1,"s":54,"surah":"القمر","a":55,"text":"فِي مَقْعَدِ صِدْقٍ عِنْدَ مَلِيكٍ مُقْتَدِرٍ","prev":{"a":54,"text":"إِنَّ الْمُتَّقِينَ فِي جَنَّاتٍ وَنَهَرٍ"},"context":"في ختام سورة القمر، بعد ﴿وَلَقَدْ أَهْلَكْنَا أَشْيَاعَكُمْ فَهَلْ مِنْ مُدَّكِرٍ﴾ و﴿وَكُلُّ صَغِيرٍ وَكَبِيرٍ مُسْتَطَرٌ﴾، ينقلب المشهد: ﴿إِنَّ الْمُتَّقِينَ فِي جَنَّاتٍ وَنَهَرٍ * فِي مَقْعَدِ صِدْقٍ عِنْدَ مَلِيكٍ مُقْتَدِرٍ﴾.","reason":"لم تُختم غاية المتقين بالجنات والنهر بل بما فوقهما: ﴿عِنْدَ مَلِيكٍ مُقْتَدِرٍ﴾ — فالجوار أعظم من الدار. وسُمي المقعد «مقعد صدق»: لا لغو فيه ولا زيف ولا زوال، لأن المضيف مليكٌ ملكُه تام، مقتدرٌ لا يعجز عن إدامة النعيم. فبعد مصارع المكذبين، هذا مستقر المصدّقين.","adds":"يرفع سقف الطموح: لا تجعل غايتك الجنةَ وحدها — اطلب المقعد «عند» صاحبها؛ فالقرب غاية الغايات."}],"hadiths":[],"sunnah":{"card":"الصيغة: الْمَلِيكُ الْمُقْتَدِرُ — مركّبة، من قوله ﴿عِندَ مَلِيكٍ مُّقْتَدِرٍ﴾\nفي السنة: شاهد واحد (رواية واحدة)\nخصوصية الورود في السنة: ورد الاسمان متجاورين في رواية المستدرك لحديث الإحصاء: «…العلي، العظيم، الغني، المليك، المقتدر، الأكرم…» — فالسنة تُثبت الصيغة القرآنية في التعداد.\nالمعنى المختصر: المليك: صيغة مبالغة من المَلِك؛ والمقتدر: التام القدرة الذي لا يعجزه شيء.","teaches":"1. أن ملكه تامٌّ وقدرته تامة، ولا ينفكّان.\n2. أن مجلس الصدق في الجنة عنده هو، لا عند ملكٍ سواه.\n3. أنه محصًى في الأسماء التي من أحصاها دخل الجنة.","whenRecall":"- حين تقرأ آخر سورة القمر: ﴿عِندَ مَلِيكٍ مُّقْتَدِرٍ﴾.\n- حين تُبهرك قدرة ذي ملكٍ في الأرض.\n- في إحصاء الأسماء.","whenPray":"عند الشعور بـ:\n1. الخوف من ذي سلطان قادر.\n2. الشوق إلى مقعد الصدق.\nعند طلب:\n1. مقعد صدقٍ عنده.\n2. القدرة على ما عجزت عنه.\nعند الرغبة في:\n1. إحصاء الأسماء بصيغها القرآنية.","duaItems":"لا صيغة دعاء منصوصة؛ ويُدعى بمضمون الآية: «اللهم اجعلني في مقعد صدقٍ عندك، يا مليك يا مقتدر» — مستفاد من [القمر: 55] (الشاهد: المستدرك 42).","summary":"«المليك المقتدر» في السنة اسمٌ مُحصًى بصيغته القرآنية في تعداد المستدرك بين الغني والأكرم — ملكٌ تام وقدرةٌ تامة يُجلس عندهما أهل الصدق."},"situations":[{"situationId":181,"verses":[{"i":1,"strength":"direct","headline":"البحث عن غاية الحياة ومنتهى الطموح","bridge":"تسأل: لماذا أنا هنا؟ سورةٌ كاملة من مصارع المكذبين تنتهي بجواب الغاية: ﴿إِنَّ الْمُتَّقِينَ فِي جَنَّاتٍ وَنَهَرٍ * فِي مَقْعَدِ صِدْقٍ عِنْدَ مَلِيكٍ مُقْتَدِرٍ﴾ — الغاية ليست الجنة وحدها بل الجوار: مقعدٌ لا زيف فيه ولا زوال عند من ملكه تام وقدرته لا تعجز."}],"hadiths":[]}]},{"id":30,"name":"الله ذو المعارج","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: اللَّهِ ذِي الْمَعَارِجِ — مركّبة | المواضع: 1 (المعارج: 3)\nخصوصية: به سُميت السورة، وجاء ردًّا على مستهزئٍ سأل تعجيل العذاب — فالاسم جواب المستعجلين الساخرين.\n\nالمعنى:\n- ذو المعارج: صاحب المصاعد والدرجات التي تعرج فيها الملائكةُ والروح إليه — مقامات العلو التي لا يبلغها الخلق، وعلوٌّ يصعد إليه كل شيء ولا يُصعد فوقه.","teaches":"الحقائق التي كشفها الموضع:\n1. قضاؤه النازل من علوّه لا دافع له — فالاستهزاء بالوعيد لا يعطله.\n2. المسافة إليه معارجُ تقطعها الملائكة في خمسين ألف سنة — فأين يصعد المعترض؟\n3. جواب السخرية: صبرٌ جميل — بلا شكوى للخلق — واليقين أن ما يرونه بعيدًا قريب.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند سخرية المستعجلين: «أين وعد الله؟».\n- عند صعود عملك ودعائك: فإليه يعرج الكلم الطيب.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. عند الاستهزاء بدينك أو بوعد الله: سؤال الصبر الجميل — المعارج 5.\n2. سؤال قبول ما يعرج إليه من عملك في معارجه.\n3. اليقين بقرب ما يستبعده الساخرون: «ونراه قريبًا».\n\nدعاء مقتبس من الآيات:\n«اللهم يا ذا المعارج، ارفع إليك عملي ودعائي في معارجك، وارزقني صبرًا جميلًا على ما يقولون، ويقينًا بأن وعدك قريبٌ وإن رآه الناس بعيدًا».","summary":"سأل ساخرٌ تعجيلَ العذاب، فكان الجواب اسمًا: ﴿ذِي الْمَعَارِجِ﴾ — النازل من ذلك العلو لا يدفعه أحد؛ فاصبر صبرًا جميلًا: إنهم يرونه بعيدًا ونراه قريبًا.","verses":[{"i":1,"of":1,"s":70,"surah":"المعارج","a":3,"text":"مِنَ اللَّهِ ذِي الْمَعَارِجِ","prev":{"a":2,"text":"لِلْكَافِرِينَ لَيْسَ لَهُ دَافِعٌ"},"next":{"a":4,"text":"تَعْرُجُ الْمَلَائِكَةُ وَالرُّوحُ إِلَيْهِ فِي يَوْمٍ كَانَ مِقْدَارُهُ خَمْسِينَ أَلْفَ سَنَةٍ"},"context":"﴿سَأَلَ سَائِلٌ بِعَذَابٍ وَاقِعٍ * لِلْكَافِرِينَ لَيْسَ لَهُ دَافِعٌ * مِنَ اللَّهِ ذِي الْمَعَارِجِ﴾ — سائلٌ يستعجل العذاب، فجاء الجواب: العذاب واقعٌ لا دافع له، لأنه من ذي المعارج — ﴿تَعْرُجُ الْمَلَائِكَةُ وَالرُّوحُ إِلَيْهِ فِي يَوْمٍ كَانَ مِقْدَارُهُ خَمْسِينَ أَلْفَ سَنَةٍ﴾ — ثم الأمر: ﴿فَاصْبِرْ صَبْرًا جَمِيلًا﴾.","reason":"عُلّل امتناعُ دفع العذاب بالاسم: النازلُ من علوّ «ذي المعارج» لا تبلغه يدُ دافع — فمن أراد ردّ قضائه فليصعد إليه أولًا، وهيهات: الملائكة نفسها تعرج إليه في يومٍ مقداره خمسون ألف سنة. فعلوُّه المطلق يجعل حكمه فوق كل اعتراض واستهزاء.","adds":"يوجه المستهزَأ به: لا تنشغل بردّ السخرية — ﴿فَاصْبِرْ صَبْرًا جَمِيلًا * إِنَّهُمْ يَرَوْنَهُ بَعِيدًا﴾ وهو قريب: الحساب أقرب مما يظن الساخرون."}],"hadiths":[],"situations":[{"situationId":34,"verses":[{"i":1,"strength":"direct","headline":"الاستهزاء بالدين واستعجال وعيد الله تحديًا","bridge":"يستهزئون بدينك ويستعجلون وعيد الله تحديًا؟ سألوا العذاب سخرية فجاء: ﴿مِنَ اللَّهِ ذِي الْمَعَارِجِ﴾ لا يدفعه دافع، ثم أُمر النبي ﷺ: ﴿فَاصْبِرْ صَبْرًا جَمِيلًا * إِنَّهُمْ يَرَوْنَهُ بَعِيدًا﴾ وهو قريب — لا تنشغل برد السخرية، فما ينزل من علوّ ذي المعارج لا تبلغه يد ساخر."}],"hadiths":[]}]},{"id":31,"name":"التواب","compound":false,"meaning":"بطاقة الاسم:\nالصيغة: تَوَّابًا — مفردة بصيغة مبالغة | المواضع: 1 بهذه الصورة المفردة (النصر: 3) — وما جاء مقرونًا (التواب الرحيم / التواب الحكيم) ففي صفوفه\nخصوصية: جاء في آخر سورةٍ نزلت كاملةً، في مقام قمة النصر — لا في مقام الذنب — فهو اسمُ خواتيم الأعمال والأعمار.\n\nالمعنى:\n- التواب: الكثير القبول لتوبة التائبين، يعود على عبده بالقبول كلما عاد — مهما تكرر الرجوع.","teaches":"الحقائق التي كشفها الموضع:\n1. قمة النجاح موطنُ استغفارٍ لا زهو — فالتقصير الخفي يلازم أكمل الأعمال.\n2. التواب يقبل العائدين دائمًا — حتى من لا ذنب ظاهرًا له.\n3. الاستغفار خاتمة الأعمال الصالحة: الصلاة، والمجلس، والعمر.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عقب كل إنجازٍ كبير أو نجاحٍ باهر.\n- في ختام الصلاة والمجلس واليوم.\n- عند استشعار اقتراب نهاية مرحلةٍ من عمرك.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. عقب كل نصرٍ ونجاح: تسبيحٌ بالحمد واستغفار — النصر 3.\n2. تطبيق النبي ﷺ الحرفي للآية: «سُبْحَانَكَ اللَّهُمَّ رَبَّنَا وَبِحَمْدِكَ اللَّهُمَّ اغْفِرْ لِي» في الركوع والسجود — متفق عليه.\n3. الاستغفار ثلاثًا بعد كل صلاة كما كان ﷺ يفعل — رواه مسلم.\n4. جعل الاستغفار خاتمة كل عملٍ ومجلس — فمن ختم بالتوبة قُبل ما قبلها.","summary":"علّمك القرآن ماذا تقول في قمة نجاحك: ﴿فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُ﴾ — فالتوابُ يقبل العائدين حتى من ذروة الإنجاز، والاستغفارُ خاتمُ الأعمال.","verses":[{"i":1,"of":1,"s":110,"surah":"النصر","a":3,"text":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُ إِنَّهُ كَانَ تَوَّابًا","prev":{"a":2,"text":"وَرَأَيْتَ النَّاسَ يَدْخُلُونَ فِي دِينِ اللَّهِ أَفْوَاجًا"},"context":"﴿إِذَا جَاءَ نَصْرُ اللَّهِ وَالْفَتْحُ * وَرَأَيْتَ النَّاسَ يَدْخُلُونَ فِي دِينِ اللَّهِ أَفْوَاجًا * فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُ إِنَّهُ كَانَ تَوَّابًا﴾ — قمةُ النجاح: مكة فُتحت، والعرب تدخل أفواجًا، والمهمة اكتملت. والأمر: سبّح واحمد واستغفر. وقال فيها ابنُ عباس: «هو أجَلُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم أعلَمَه له»، فقال عُمَرُ: «ما أعلَمُ منها إلَّا ما تَقولُ» (صحيح البخاري 4970).","reason":"في ذروة النصر لم يُؤمر بالاحتفال بل بالتسبيح والاستغفار — وعُلّل بـ﴿إِنَّهُ كَانَ تَوَّابًا﴾: فحتى العملُ المكتمل على أتمّ وجه يحتاج استغفارًا مما شابه من تقصيرٍ لا يُرى، والتوابُ يقبل رجوعَ الراجعين ولو من قمة الإنجاز. فخواتيمُ الأعمال العظيمة استغفار، لا زهو.","adds":"ما صلّى ﷺ صلاةً بعد نزولها إلا قال فيها: «سُبحانَكَ رَبَّنا وبحَمدِكَ، اللهُمَّ اغفِرْ لي» (صحيح البخاري 4967)، وكان يُكثر أن يقولها في ركوعه وسجوده «يَتأوَّلُ القُرآنَ» (صحيح ابن خزيمة 1/ 636). فهذا التطبيق النبوي الحرفي للآية.","dorar":[{"id":"ccSC6kea","label":"صحيح البخاري 4970"},{"id":"egcgjr3d","label":"صحيح البخاري 4967"},{"id":"Pon5yk5w","label":"صحيح ابن خزيمة 1/ 636"}]}],"hadiths":[{"i":1,"of":2,"text":"عن رَجُلٍ مِن أصْحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ مِن الأنصارِ، قال: -قال شُعْبةُ: أو قال: رَجُلٌ مِن الأنصارِ- إنَّه سَمِعَ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ في صَلاةٍ وهو يقولُ: ربِّ اغفِرْ لي -قال شُعْبةُ: أو قال: اللَّهُمَّ اغفِرْ لي- وتُبْ علَيَّ؛ إنَّك أنتَ التوَّابُ الغَفورُ، مِئَةَ مَرَّةٍ.","narrator":"رجل من الصحابة","source":"تخريج المسند لشعيب 23150","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/puGdNdKH","nameForm":"التوَّابُ","scene":"رجلٌ من الأنصار من أصحاب النبي ﷺ سمعه في صلاة وهو يقول: «رب اغفر لي وتب عليّ، إنك أنت التواب الغفور» — مائة مرة.","reason":"التكرار مائةً يفسّر صيغة المبالغة «التوّاب»: من يعود عليك مائة مرة في صلاةٍ واحدة هو التوّاب لا التائب عليه مرة. وطلب «وتب عليّ» قبل الاسم يُري أن التوبة تبدأ من الله عودًا على العبد، ثم يتوب العبد، ثم يقبل. واقتران «الغفور» بعده: التوبة تُقبل والذنب يُمحى.","adds":"يُعطي الشاهد عددًا وموضعًا: مائة مرة في الصلاة — فالاسم يُذكر بالإكثار لا بالاكتفاء."},{"i":2,"of":2,"text":"كان النَّبيُّ صلَّى اللهُ عليه وسلَّمَ يُكثِرُ أنْ يقولَ: سُبحانَكَ اللَّهُمَّ وبحمدِكَ، اللَّهُمَّ اغفِرْ لي. فلمَّا نَزلَتْ: {إِذَا جَاءَ نَصْرُ اللَّهِ وَالْفَتْحُ} قالَ: سُبحانَكَ اللَّهُمَّ، اللَّهُمَّ اغفِرْ لي؛ إنَّكَ أنتَ التَّوَّابُ.","narrator":"عبدالله بن مسعود","source":"المستدرك على الصحيحين 1873","grade":"صحيح","judgment":"إسناده صحيح إن كان أبو عبيدة بن عبد الله بن مسعود سمع من أبيه","url":"https://dorar.net/h/dmPFMNyi","nameForm":"التَّوَّابُ","scene":"ابن مسعود: كان النبي ﷺ يكثر أن يقول: «سبحانك اللهم وبحمدك، اللهم اغفر لي». فلما نزلت ﴿إِذَا جَاءَ نَصْرُ اللَّهِ وَالْفَتْحُ﴾ قال: «سبحانك اللهم، اللهم اغفر لي، إنك أنت التواب».","reason":"سورة النصر تأمر بالتسبيح والاستغفار وتُختم بأنه كان توابًا — فأضاف النبي ﷺ إلى ذكره القديم الاسمَ: «إنك أنت التواب». فهذا تنفيذٌ للسورة: أمرٌ بالاستغفار معللٌ بالاسم، فصار الاسم خاتمة الاستغفار النبوي عند تمام النصر لا عند الذنب.","adds":"يُبيّن الشاهد أن الاسم يُذكر عند اكتمال النعمة والنصر لا عند الذنب فقط، وأن النبي ﷺ يحوّل خاتمة الآية إلى خاتمة ذكره."}],"sunnah":{"card":"الصيغة: التَّوَّابُ — مفردة\nفي السنة: 3 شواهد (7 روايات)\nخصوصية الورود في السنة: الاسم في السنة اسمُ الاستغفار المكرّر: سُمع النبي ﷺ في صلاته يقول «رب اغفر لي وتب علي إنك أنت التواب الغفور» مائة مرة، وكان بعد نزول سورة النصر يقول في ركوعه «سبحانك اللهم اللهم اغفر لي إنك أنت التواب». وهو في التسعة والتسعين.\nالمعنى المختصر: الذي يوفّق عبده للتوبة ثم يقبلها منه، ويعود عليه كلما عاد.","teaches":"1. أنه يعود على عبده مرارًا: التوبة تبدأ منه قبل أن تبدأ من العبد.\n2. أنه يُذكر عند النصر والفتح لا عند الذنب فقط.\n3. أنه يقبل التوبة ويغفر معها: «التواب الغفور».\n4. أن الإكثار من طلب التوبة — مائةً — سنة.","whenRecall":"- في صلاتك ركوعًا وسجودًا: «سبحانك اللهم وبحمدك، اللهم اغفر لي إنك أنت التواب».\n- في المجلس: «رب اغفر لي وتب علي» مائة مرة.\n- حين يتم لك أمرٌ أو نصر.\n- حين تعود إلى الذنب: عد إلى التواب.","whenPray":"عند الشعور بـ:\n1. الحاجة إلى العودة بعد الذنب.\n2. الفرح بنصرٍ أو تمام نعمة.\n3. الخوف من أن تُغلق التوبة بتكرار العود.\nعند طلب:\n1. أن يتوب الله عليك أولًا لتتوب.\n2. المغفرة مع التوبة.\nعند الرغبة في:\n1. الإكثار من الاستغفار مائةً في المجلس.\n2. أن تجعل شكر النصر استغفارًا.","duaItems":"1. «رب اغفر لي وتب عليّ، إنك أنت التواب الغفور» مائة مرة — تخريج المسند 23150 (إسناده صحيح)، و5564 عن ابن عمر.\n2. في الركوع والسجود: «سبحانك اللهم وبحمدك، اللهم اغفر لي، إنك أنت التواب» — المستدرك 1873.","summary":"«التواب» في السنة اسمُ الاستغفار المكرّر مائةً: «رب اغفر لي وتب عليّ إنك أنت التواب الغفور» — ويُذكر عند تمام النصر امتثالًا لخاتمة سورة النصر؛ فالتوّاب يعود على من يعود، ويُطلب منه أن يعود أولًا."},"situations":[{"situationId":16,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"تكرار الذنب والحياء من العودة إلى التوبة","bridge":"عدتَ إلى الذنب حتى استحييت؟ النبي ﷺ سُمع يقول في صلاة واحدة مائة مرة: «رب اغفر لي وتب عليّ إنك أنت التواب الغفور» — من يعود على العبد مائة مرة في صلاة لا يملّ من عودتك."}]},{"situationId":147,"verses":[],"hadiths":[{"i":2,"strength":"direct","headline":"بلوغ النصر وتمام النعمة بعد طول السعي","bridge":"بلغتَ ما تريد؟ لما نزلت سورة النصر صار النبي ﷺ يقول: «سبحانك اللهم، اللهم اغفر لي، إنك أنت التواب» — شكر النصر عند النبي ﷺ استغفارٌ يُختم بالتواب."}]},{"situationId":150,"verses":[{"i":1,"strength":"direct","headline":"بلوغ النجاح والخوف من العُجب به","bridge":"بلغتَ ما تريد وتخاف العُجب؟ في ذروة النصر — مكة تُفتح والناس يدخلون أفواجًا — لم يُؤمر النبي ﷺ بالاحتفال بل: ﴿فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُ إِنَّهُ كَانَ تَوَّابًا﴾ — خواتيم الأعمال العظيمة استغفارٌ لا زهو، لأن النجاح المكتمل يحتاج إلى استغفارٍ مما شابه من تقصيرٍ لا يُرى."}],"hadiths":[]}]},{"id":32,"name":"الغفور الرحيم","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: غَفُورٌ رَحِيمٌ (بصورها) — مركّبة | المواضع: 71\nخصوصية: أكثرُ اقترانِ اسمين في القرآن على الإطلاق — وأبرز مواطنه ثلاثة: خواتيمُ الرخص والأعذار (المضطر، العاجز، المكره، المعدم)، وأبوابُ التوبة بعد كل ذنبٍ من الردة إلى الحرابة، وأرجى آيةٍ في كتاب الله (الزمر 53). وقد أعلنه اللهُ هويةً رسمية: ﴿نَبِّئْ عِبَادِي أَنِّي أَنَا الْغَفُورُ الرَّحِيمُ﴾.\n\nالمعنى:\n- الغفور: الكثير المغفرة، الساتر لذنوب عباده المتجاوز عنها مهما عظُمت وتكررت.\n- الرحيم: الموصِل رحمته إلى عباده فعلًا.\nسر الاقتران: مغفرةٌ تمحو الماضي خلفك، ورحمةٌ تستقبلك فيما بقي — فلا يبقى للذنب أثرٌ وراءك ولا حرمانٌ أمامك.","teaches":"الحقائق التي كشفتها المواضع الواحدة والسبعون:\n1. لا ذنب أكبر من مغفرته: الردةُ والحرابة والقتل والزنى كلها دون التوبة — بل تُبدَّل السيئات حسنات (الفرقان 70)، ويغفر الذنوب جميعًا (الزمر 53).\n2. كل رخصةٍ في الشريعة توقيعُها «غفور رحيم»: المضطر (ثلاث مرات بنص واحد)، والعاجز، والمُكرَه، والمعدم — فالاسم روحُ فقه التيسير كله.\n3. المغفرة هويته المعلنة رسميًا: ﴿نَبِّئْ عِبَادِي أَنِّي أَنَا الْغَفُورُ الرَّحِيمُ﴾ (الحجر 49) — وقدّمها على ذكر العذاب.\n4. عفوُك عن الناس ثمنُ مغفرته لك: آية أبي بكر ومسطح (النور 22)، وعفو الأهل (التغابن 14).\n5. أسرع مغفرة تعقب أسرع اعتراف: ﴿فَاغْفِرْ لِي فَغَفَرَ لَهُ﴾ (القصص 16).\n6. الملائكة تستغفر لمن في الأرض الآن (الشورى 5).\n7. العبرة بتعمّد القلوب لا سبق اللسان (الأحزاب 5)، والمُكرَه لا وزر عليه (النحل 110، النور 33).\n8. الرجاء أدبُ أهل أعظم الأعمال: المهاجرون المجاهدون «يرجون» (البقرة 218)، وأول جزاء المجاهدين «مغفرة» (النساء 96).\n9. الميزان: ﴿شَدِيدُ الْعِقَابِ﴾ و﴿غَفُورٌ رَحِيمٌ﴾ في آية واحدة (المائدة 98) — فسِر بجناحين.","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- فور كل ذنبٍ — قبل أن يبرد الندم (القصص 16).\n- عند كل رخصةٍ تأخذها: مرضٍ أو سفرٍ أو ضرورة.\n- عند القنوط من كثرة الذنوب وتكرارها (الزمر 53).\n- حين يظلمك قريبٌ أو صديق وتهمّ بالقطيعة (النور 22، التغابن 14).\n- في السحَر مع استغفار يعقوب (يوسف 98).\n- عند ركوب كل وسيلة: ﴿بِسْمِ اللَّهِ مَجْرَاهَا وَمُرْسَاهَا﴾ (هود 41).\n- عند العجز عن طاعةٍ تشتهيها نفسك (التوبة 91).","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. عند اليأس من النفس: أرجى آية — ﴿يَا عِبَادِيَ الَّذِينَ أَسْرَفُوا عَلَى أَنْفُسِهِمْ لَا تَقْنَطُوا﴾ — الزمر 53.\n2. فور الذنب: توبة موسى الفورية — ﴿رَبِّ إِنِّي ظَلَمْتُ نَفْسِي فَاغْفِرْ لِي﴾ — القصص 16.\n3. من ظلمه قريب: العفو ابتغاء المغفرة — ﴿أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللَّهُ لَكُمْ﴾ — النور 22، التغابن 14.\n4. عند العجز عن الطاعات: نية المحسن العاجز — ﴿مَا عَلَى الْمُحْسِنِينَ مِنْ سَبِيلٍ﴾ — التوبة 91.\n5. لمن يخاف الموت قبل إتمام عمله الصالح — النساء 100.\n6. للأبناء والمخالفين: استغفار يعقوب في السحر (يوسف 98) وتفويض إبراهيم — ﴿وَمَنْ عَصَانِي فَإِنَّكَ غَفُورٌ رَحِيمٌ﴾ — إبراهيم 36.\n7. عند التقصير في شكر نعمٍ لا تُحصى — النحل 18.\n8. عند الركوب: ﴿بِسْمِ اللَّهِ مَجْرَاهَا وَمُرْسَاهَا إِنَّ رَبِّي لَغَفُورٌ رَحِيمٌ﴾ — هود 41.\n9. لمن نطق أو فعل تحت إكراهٍ وضغط — النحل 110.\n10. طلب تبديل السيئات حسنات بالتوبة والإيمان والعمل — الفرقان 70.\n11. عقب العبادات: استغفار ما بعد النسك والقيام — البقرة 199، المزمل 20.\n\nمن السنة — سيد الاستغفار: «اللَّهُمَّ أَنْتَ رَبِّي لَا إِلَهَ إِلَّا أَنْتَ، خَلَقْتَنِي وَأَنَا عَبْدُكَ، وَأَنَا عَلَى عَهْدِكَ وَوَعْدِكَ مَا اسْتَطَعْتُ، أَعُوذُ بِكَ مِنْ شَرِّ مَا صَنَعْتُ، أَبُوءُ لَكَ بِنِعْمَتِكَ عَلَيَّ وَأَبُوءُ لَكَ بِذَنْبِي فَاغْفِرْ لِي، فَإِنَّهُ لَا يَغْفِرُ الذُّنُوبَ إِلَّا أَنْتَ» — البخاري: من قالها موقنًا بها من نهاره أو ليلته فمات، دخل الجنة.\n\nدعاء جامع مقتبس من مواضعه:\n«اللهم أنت الغفور الرحيم، نبّأتنا أنك تغفر الذنوب جميعًا: إنا أسرفنا على أنفسنا فلا تجعلنا من القانطين، اغفر لنا وبدّل سيئاتنا حسنات، وارزقنا أن نعفو عمّن ظلمنا لتغفر لنا، واختم لنا بنُزُلٍ من غفورٍ رحيم».","summary":"أكثرُ اسمين اقترانًا في كتاب الله — أحدَ عشر وسبعين موضعًا كلها تشرح نبأً واحدًا أعلنه بنفسه: ﴿نَبِّئْ عِبَادِي أَنِّي أَنَا الْغَفُورُ الرَّحِيمُ﴾ — فلا تقنط، ولا تؤجل التوبة، ولا تحرم الناسَ مما ترجوه لنفسك.","verses":[{"i":1,"of":71,"s":2,"surah":"البقرة","a":173,"text":"إِنَّمَا حَرَّمَ عَلَيْكُمُ الْمَيْتَةَ وَالدَّمَ وَلَحْمَ الْخِنْزِيرِ وَمَا أُهِلَّ بِهِ لِغَيْرِ اللَّهِ فَمَنِ اضْطُرَّ غَيْرَ بَاغٍ وَلَا عَادٍ فَلَا إِثْمَ عَلَيْهِ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":172,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا كُلُوا مِنْ طَيِّبَاتِ مَا رَزَقْنَاكُمْ وَاشْكُرُوا لِلَّهِ إِنْ كُنْتُمْ إِيَّاهُ تَعْبُدُونَ"},"next":{"a":174,"text":"إِنَّ الَّذِينَ يَكْتُمُونَ مَا أَنْزَلَ اللَّهُ مِنَ الْكِتَابِ وَيَشْتَرُونَ بِهِ ثَمَنًا قَلِيلًا أُولَئِكَ مَا يَأْكُلُونَ فِي بُطُونِهِمْ إِلَّا النَّارَ وَلَا يُكَلِّمُهُمُ اللَّهُ يَوْمَ الْقِيَامَةِ وَلَا يُزَكِّيهِمْ وَلَهُمْ عَذَابٌ أَلِيمٌ"},"context":"آية المحرمات من الطعام: الميتة والدم ولحم الخنزير وما أهل به لغير الله — ثم يفتح باب الضرورة: ﴿فَمَنِ اضْطُرَّ غَيْرَ بَاغٍ وَلَا عَادٍ فَلَا إِثْمَ عَلَيْهِ﴾.","reason":"خُتمت رخصة المضطر بالاسمين: رفعُ الإثم عن المضطر مغفرةٌ مقدَّمة ورحمةٌ بحاله — بشرطين: غير باغٍ (طالبٍ للمحرم لذاته) ولا عادٍ (متجاوزٍ قدر الضرورة). فالرحمة تفتح الباب والشرطان يضبطانه.","adds":"قاعدة الضرورات تُقدَّر بقدرها — وبابها الرحمة لا التحايل."},{"i":2,"of":71,"s":2,"surah":"البقرة","a":182,"text":"فَمَنْ خَافَ مِنْ مُوصٍ جَنَفًا أَوْ إِثْمًا فَأَصْلَحَ بَيْنَهُمْ فَلَا إِثْمَ عَلَيْهِ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":181,"text":"فَمَنْ بَدَّلَهُ بَعْدَمَا سَمِعَهُ فَإِنَّمَا إِثْمُهُ عَلَى الَّذِينَ يُبَدِّلُونَهُ إِنَّ اللَّهَ سَمِيعٌ عَلِيمٌ"},"next":{"a":183,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا كُتِبَ عَلَيْكُمُ الصِّيَامُ كَمَا كُتِبَ عَلَى الَّذِينَ مِنْ قَبْلِكُمْ لَعَلَّكُمْ تَتَّقُونَ"},"context":"في أحكام الوصية: ﴿فَمَنْ خَافَ مِنْ مُوصٍ جَنَفًا أَوْ إِثْمًا فَأَصْلَحَ بَيْنَهُمْ فَلَا إِثْمَ عَلَيْهِ﴾.","reason":"من عدّل وصيةً جائرة وأصلح بين أطرافها فلا إثم عليه — فتعديل ظلم الميت ليس خيانةً له بل إصلاحٌ يحبه الغفور الرحيم: يغفر للموصي جنفَه إن تاب، ويرحم المصلحَ في سعيه.","adds":"الإصلاح مقدَّم على حرفية وصيةٍ ظالمة — والوسيط المصلح مأجور لا آثم."},{"i":3,"of":71,"s":2,"surah":"البقرة","a":192,"text":"فَإِنِ انْتَهَوْا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":191,"text":"وَاقْتُلُوهُمْ حَيْثُ ثَقِفْتُمُوهُمْ وَأَخْرِجُوهُمْ مِنْ حَيْثُ أَخْرَجُوكُمْ وَالْفِتْنَةُ أَشَدُّ مِنَ الْقَتْلِ وَلَا تُقَاتِلُوهُمْ عِنْدَ الْمَسْجِدِ الْحَرَامِ حَتَّى يُقَاتِلُوكُمْ فِيهِ فَإِنْ قَاتَلُوكُمْ فَاقْتُلُوهُمْ كَذَلِكَ جَزَاءُ الْكَافِرِينَ"},"next":{"a":193,"text":"وَقَاتِلُوهُمْ حَتَّى لَا تَكُونَ فِتْنَةٌ وَيَكُونَ الدِّينُ لِلَّهِ فَإِنِ انْتَهَوْا فَلَا عُدْوَانَ إِلَّا عَلَى الظَّالِمِينَ"},"context":"في آيات القتال: ﴿فَإِنْ قَاتَلُوكُمْ فَاقْتُلُوهُمْ كَذَلِكَ جَزَاءُ الْكَافِرِينَ﴾ — ثم مباشرة: ﴿فَإِنِ انْتَهَوْا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾.","reason":"حتى في ساحة الحرب: انتهاءُ العدو عن قتاله وكفره يفتح له بابَ الغفور الرحيم فورًا — فالقتال لدفع العدوان لا للانتقام، والمقاتلُ بالأمس إن انتهى فذنبه إلى غفورٍ رحيم لا إلى ثأر البشر.","adds":"أخلاق الحرب القرآنية: السيف يتوقف حيث يتوقف العدوان — والباب مفتوح حتى للمحارب."},{"i":4,"of":71,"s":2,"surah":"البقرة","a":199,"text":"ثُمَّ أَفِيضُوا مِنْ حَيْثُ أَفَاضَ النَّاسُ وَاسْتَغْفِرُوا اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":198,"text":"لَيْسَ عَلَيْكُمْ جُنَاحٌ أَنْ تَبْتَغُوا فَضْلًا مِنْ رَبِّكُمْ فَإِذَا أَفَضْتُمْ مِنْ عَرَفَاتٍ فَاذْكُرُوا اللَّهَ عِنْدَ الْمَشْعَرِ الْحَرَامِ وَاذْكُرُوهُ كَمَا هَدَاكُمْ وَإِنْ كُنْتُمْ مِنْ قَبْلِهِ لَمِنَ الضَّالِّينَ"},"next":{"a":200,"text":"فَإِذَا قَضَيْتُمْ مَنَاسِكَكُمْ فَاذْكُرُوا اللَّهَ كَذِكْرِكُمْ آبَاءَكُمْ أَوْ أَشَدَّ ذِكْرًا فَمِنَ النَّاسِ مَنْ يَقُولُ رَبَّنَا آتِنَا فِي الدُّنْيَا وَمَا لَهُ فِي الْآخِرَةِ مِنْ خَلَاقٍ"},"context":"في مناسك الحج: ﴿ثُمَّ أَفِيضُوا مِنْ حَيْثُ أَفَاضَ النَّاسُ وَاسْتَغْفِرُوا اللَّهَ﴾ — وكانت قريش تفيض من المزدلفة ترفّعًا عن الوقوف بعرفة مع الناس.","reason":"أُمروا بالإفاضة مع الناس — هدمًا لكِبر الجاهلية — وبالاستغفار: مما مضى من ترفّعهم، ومن التقصير الملازم لكل نسك. فالاستغفار نُسكٌ في قلب الحج، يُختم به الموقف كما يُختم به كل عمل.","adds":"الاستغفار يَتبع الطاعات لا المعاصي فقط — فاختم كل عبادةٍ به."},{"i":5,"of":71,"s":2,"surah":"البقرة","a":218,"text":"إِنَّ الَّذِينَ آمَنُوا وَالَّذِينَ هَاجَرُوا وَجَاهَدُوا فِي سَبِيلِ اللَّهِ أُولَئِكَ يَرْجُونَ رَحْمَتَ اللَّهِ وَاللَّهُ غَفُورٌ رَحِيمٌ","prev":{"a":217,"text":"يَسْأَلُونَكَ عَنِ الشَّهْرِ الْحَرَامِ قِتَالٍ فِيهِ قُلْ قِتَالٌ فِيهِ كَبِيرٌ وَصَدٌّ عَنْ سَبِيلِ اللَّهِ وَكُفْرٌ بِهِ وَالْمَسْجِدِ الْحَرَامِ وَإِخْرَاجُ أَهْلِهِ مِنْهُ أَكْبَرُ عِنْدَ اللَّهِ وَالْفِتْنَةُ أَكْبَرُ مِنَ الْقَتْلِ وَلَا يَزَالُونَ يُقَاتِلُونَكُمْ حَتَّى يَرُدُّوكُمْ عَنْ دِينِكُمْ إِنِ اسْتَطَاعُوا وَمَنْ يَرْتَدِدْ مِنْكُمْ عَنْ دِينِهِ فَيَمُتْ وَهُوَ كَافِرٌ فَأُولَئِكَ حَبِطَتْ أَعْمَالُهُمْ فِي الدُّنْيَا وَالْآخِرَةِ وَأُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ"},"next":{"a":219,"text":"يَسْأَلُونَكَ عَنِ الْخَمْرِ وَالْمَيْسِرِ قُلْ فِيهِمَا إِثْمٌ كَبِيرٌ وَمَنَافِعُ لِلنَّاسِ وَإِثْمُهُمَا أَكْبَرُ مِنْ نَفْعِهِمَا وَيَسْأَلُونَكَ مَاذَا يُنْفِقُونَ قُلِ الْعَفْوَ كَذَلِكَ يُبَيِّنُ اللَّهُ لَكُمُ الْآيَاتِ لَعَلَّكُمْ تَتَفَكَّرُونَ"},"reason":"أصحابُ أعظم الأعمال — إيمانٍ وهجرةٍ وجهاد — وُصفوا بأنهم «يرجون» رحمته لا يستحقونها جزمًا: فالعمل سببٌ والرجاء أدبٌ، والاسمان ضمان: غفورٌ لتقصير العامل، رحيمٌ يقبل عمله ويزيده.","adds":"لا أحد يدخل الجنة بعمله وحده — حتى المهاجرُ المجاهد يرجو، فكيف بمن دونه؟"},{"i":6,"of":71,"s":2,"surah":"البقرة","a":226,"text":"لِلَّذِينَ يُؤْلُونَ مِنْ نِسَائِهِمْ تَرَبُّصُ أَرْبَعَةِ أَشْهُرٍ فَإِنْ فَاءُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":225,"text":"لَا يُؤَاخِذُكُمُ اللَّهُ بِاللَّغْوِ فِي أَيْمَانِكُمْ وَلَكِنْ يُؤَاخِذُكُمْ بِمَا كَسَبَتْ قُلُوبُكُمْ وَاللَّهُ غَفُورٌ حَلِيمٌ"},"next":{"a":227,"text":"وَإِنْ عَزَمُوا الطَّلَاقَ فَإِنَّ اللَّهَ سَمِيعٌ عَلِيمٌ"},"context":"في الإيلاء — حلف الرجل هجرَ زوجته: ﴿لِلَّذِينَ يُؤْلُونَ مِنْ نِسَائِهِمْ تَرَبُّصُ أَرْبَعَةِ أَشْهُرٍ فَإِنْ فَاءُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾.","reason":"من حلف في غضبه ثم فاء ورجع إلى زوجته خلال المهلة، قوبل رجوعُه بالغفور الرحيم: يغفر له حِلفَه وحِدّته، ويرحم البيتَ الذي عاد إلى استقراره. فالفيئةُ عن قرارات الغضب توبةٌ محمودة.","adds":"الرجوع عن قرارٍ اتخذته غاضبًا في بيتك ليس ضعفًا — هو فيئةٌ يحبها الغفور الرحيم."},{"i":7,"of":71,"s":3,"surah":"آل عمران","a":31,"text":"قُلْ إِنْ كُنْتُمْ تُحِبُّونَ اللَّهَ فَاتَّبِعُونِي يُحْبِبْكُمُ اللَّهُ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ","prev":{"a":30,"text":"يَوْمَ تَجِدُ كُلُّ نَفْسٍ مَا عَمِلَتْ مِنْ خَيْرٍ مُحْضَرًا وَمَا عَمِلَتْ مِنْ سُوءٍ تَوَدُّ لَوْ أَنَّ بَيْنَهَا وَبَيْنَهُ أَمَدًا بَعِيدًا وَيُحَذِّرُكُمُ اللَّهُ نَفْسَهُ وَاللَّهُ رَءُوفٌ بِالْعِبَادِ"},"next":{"a":32,"text":"قُلْ أَطِيعُوا اللَّهَ وَالرَّسُولَ فَإِنْ تَوَلَّوْا فَإِنَّ اللَّهَ لَا يُحِبُّ الْكَافِرِينَ"},"context":"آية المحبة والاختبار: ﴿قُلْ إِنْ كُنْتُمْ تُحِبُّونَ اللَّهَ فَاتَّبِعُونِي يُحْبِبْكُمُ اللَّهُ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾.","reason":"دعوى محبة الله تُختبر باتباع نبيه ﷺ — وجزاء الصادق فيها مزدوج: محبةُ الله له ومغفرةُ ذنوبه. فقُرنت المغفرة بالمحبة: من أحبّ واتبع غُفر له، لأن الحبيب لا يحاسِب حبيبه محاسبة الخصوم.","adds":"طريق أن يحبك الله ويغفر لك واحد: الاتباع — لا كثرة الدعاوى."},{"i":8,"of":71,"s":3,"surah":"آل عمران","a":89,"text":"إِلَّا الَّذِينَ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":88,"text":"خَالِدِينَ فِيهَا لَا يُخَفَّفُ عَنْهُمُ الْعَذَابُ وَلَا هُمْ يُنْظَرُونَ"},"next":{"a":90,"text":"إِنَّ الَّذِينَ كَفَرُوا بَعْدَ إِيمَانِهِمْ ثُمَّ ازْدَادُوا كُفْرًا لَنْ تُقْبَلَ تَوْبَتُهُمْ وَأُولَئِكَ هُمُ الضَّالُّونَ"},"context":"في الذين كفروا بعد إيمانهم وازدادوا كفرًا، جاء الاستثناء: ﴿إِلَّا الَّذِينَ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾.","reason":"حتى الردة بعد الإيمان — أغلظُ صور الكفر — لها بابُ توبةٍ وإصلاح يقابله الغفور الرحيم. فلم يستثنِ القرآن ذنبًا من التوبة ما دام صاحبه حيًّا صادقًا.","adds":"لا ذنب يُغلق الباب — حتى من خرج من الدين كلِّه ثم عاد."},{"i":9,"of":71,"s":3,"surah":"آل عمران","a":129,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ يَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ وَاللَّهُ غَفُورٌ رَحِيمٌ","prev":{"a":128,"text":"لَيْسَ لَكَ مِنَ الْأَمْرِ شَيْءٌ أَوْ يَتُوبَ عَلَيْهِمْ أَوْ يُعَذِّبَهُمْ فَإِنَّهُمْ ظَالِمُونَ"},"next":{"a":130,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَأْكُلُوا الرِّبَا أَضْعَافًا مُضَاعَفَةً وَاتَّقُوا اللَّهَ لَعَلَّكُمْ تُفْلِحُونَ"},"context":"بعد أُحد وقول النبي ﷺ ما قال في قاتلي أصحابه، نزل (صحيح البخاري 4069): ﴿لَيْسَ لَكَ مِنَ الْأَمْرِ شَيْءٌ﴾ ثم: ﴿وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ يَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾.","reason":"الملك كلُّه له، فالمغفرة والعذاب بمشيئته وحده — حتى النبي ليس له من الأمر شيء. وخُتمت الآية بالغفور الرحيم ترجيحًا: مشيئتُه تميل بها رحمته — وقد أسلم بعضُ من دُعي عليهم يومئذ (تخريج المسند لشعيب 5674).","adds":"لا تحكم على مصير أحدٍ مهما رأيت منه — فعدوّ اليوم قد يكون في سجل المغفورين غدًا.","dorar":[{"id":"Igbe1gZ4","label":"صحيح البخاري 4069"},{"id":"Ay1oGv0M","label":"تخريج المسند لشعيب 5674"}]},{"i":10,"of":71,"s":4,"surah":"النساء","a":23,"text":"حُرِّمَتْ عَلَيْكُمْ أُمَّهَاتُكُمْ وَبَنَاتُكُمْ وَأَخَوَاتُكُمْ وَعَمَّاتُكُمْ وَخَالَاتُكُمْ وَبَنَاتُ الْأَخِ وَبَنَاتُ الْأُخْتِ وَأُمَّهَاتُكُمُ اللَّاتِي أَرْضَعْنَكُمْ وَأَخَوَاتُكُمْ مِنَ الرَّضَاعَةِ وَأُمَّهَاتُ نِسَائِكُمْ وَرَبَائِبُكُمُ اللَّاتِي فِي حُجُورِكُمْ مِنْ نِسَائِكُمُ اللَّاتِي دَخَلْتُمْ بِهِنَّ فَإِنْ لَمْ تَكُونُوا دَخَلْتُمْ بِهِنَّ فَلَا جُنَاحَ عَلَيْكُمْ وَحَلَائِلُ أَبْنَائِكُمُ الَّذِينَ مِنْ أَصْلَابِكُمْ وَأَنْ تَجْمَعُوا بَيْنَ الْأُخْتَيْنِ إِلَّا مَا قَدْ سَلَفَ إِنَّ اللَّهَ كَانَ غَفُورًا رَحِيمًا","prev":{"a":22,"text":"وَلَا تَنْكِحُوا مَا نَكَحَ آبَاؤُكُمْ مِنَ النِّسَاءِ إِلَّا مَا قَدْ سَلَفَ إِنَّهُ كَانَ فَاحِشَةً وَمَقْتًا وَسَاءَ سَبِيلًا"},"next":{"a":24,"text":"وَالْمُحْصَنَاتُ مِنَ النِّسَاءِ إِلَّا مَا مَلَكَتْ أَيْمَانُكُمْ كِتَابَ اللَّهِ عَلَيْكُمْ وَأُحِلَّ لَكُمْ مَا وَرَاءَ ذَلِكُمْ أَنْ تَبْتَغُوا بِأَمْوَالِكُمْ مُحْصِنِينَ غَيْرَ مُسَافِحِينَ فَمَا اسْتَمْتَعْتُمْ بِهِ مِنْهُنَّ فَآتُوهُنَّ أُجُورَهُنَّ فَرِيضَةً وَلَا جُنَاحَ عَلَيْكُمْ فِيمَا تَرَاضَيْتُمْ بِهِ مِنْ بَعْدِ الْفَرِيضَةِ إِنَّ اللَّهَ كَانَ عَلِيمًا حَكِيمًا"},"context":"آية المحرمات من النساء: الأمهات والبنات والأخوات... ﴿وَأَنْ تَجْمَعُوا بَيْنَ الْأُخْتَيْنِ إِلَّا مَا قَدْ سَلَفَ إِنَّ اللَّهَ كَانَ غَفُورًا رَحِيمًا﴾.","reason":"﴿إِلَّا مَا قَدْ سَلَفَ﴾: ما وقع في الجاهلية قبل التحريم لا يؤاخَذ به — فالشرع لا يحاسب على ما قبل العلم، والاسمان يطويان صفحة الماضي: مغفرةٌ لما سلف ورحمةٌ فيما يُستقبل.","adds":"قاعدة «عفا الله عما سلف»: ما فعلتَه قبل أن تعلم الحكم مطويٌّ برحمته."},{"i":11,"of":71,"s":4,"surah":"النساء","a":25,"text":"وَمَنْ لَمْ يَسْتَطِعْ مِنْكُمْ طَوْلًا أَنْ يَنْكِحَ الْمُحْصَنَاتِ الْمُؤْمِنَاتِ فَمِنْ مَا مَلَكَتْ أَيْمَانُكُمْ مِنْ فَتَيَاتِكُمُ الْمُؤْمِنَاتِ وَاللَّهُ أَعْلَمُ بِإِيمَانِكُمْ بَعْضُكُمْ مِنْ بَعْضٍ فَانْكِحُوهُنَّ بِإِذْنِ أَهْلِهِنَّ وَآتُوهُنَّ أُجُورَهُنَّ بِالْمَعْرُوفِ مُحْصَنَاتٍ غَيْرَ مُسَافِحَاتٍ وَلَا مُتَّخِذَاتِ أَخْدَانٍ فَإِذَا أُحْصِنَّ فَإِنْ أَتَيْنَ بِفَاحِشَةٍ فَعَلَيْهِنَّ نِصْفُ مَا عَلَى الْمُحْصَنَاتِ مِنَ الْعَذَابِ ذَلِكَ لِمَنْ خَشِيَ الْعَنَتَ مِنْكُمْ وَأَنْ تَصْبِرُوا خَيْرٌ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ","prev":{"a":24,"text":"وَالْمُحْصَنَاتُ مِنَ النِّسَاءِ إِلَّا مَا مَلَكَتْ أَيْمَانُكُمْ كِتَابَ اللَّهِ عَلَيْكُمْ وَأُحِلَّ لَكُمْ مَا وَرَاءَ ذَلِكُمْ أَنْ تَبْتَغُوا بِأَمْوَالِكُمْ مُحْصِنِينَ غَيْرَ مُسَافِحِينَ فَمَا اسْتَمْتَعْتُمْ بِهِ مِنْهُنَّ فَآتُوهُنَّ أُجُورَهُنَّ فَرِيضَةً وَلَا جُنَاحَ عَلَيْكُمْ فِيمَا تَرَاضَيْتُمْ بِهِ مِنْ بَعْدِ الْفَرِيضَةِ إِنَّ اللَّهَ كَانَ عَلِيمًا حَكِيمًا"},"next":{"a":26,"text":"يُرِيدُ اللَّهُ لِيُبَيِّنَ لَكُمْ وَيَهْدِيَكُمْ سُنَنَ الَّذِينَ مِنْ قَبْلِكُمْ وَيَتُوبَ عَلَيْكُمْ وَاللَّهُ عَلِيمٌ حَكِيمٌ"},"context":"لمن لم يستطع مهرَ الحرائر: رخصة نكاح الفتيات المؤمنات ﴿ذَلِكَ لِمَنْ خَشِيَ الْعَنَتَ مِنْكُمْ وَأَنْ تَصْبِرُوا خَيْرٌ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾.","reason":"شرعُ مخرجٍ لمن خشي العنت (المشقة والوقوع في الحرام) مع بيان أن الصبر خير — فالغفور الرحيم يسع الحالين: يرحم من أخذ بالرخصة لضعفه، ويأجر من صبر لعزيمته.","adds":"الدين يفتح مخارجَ للضعف البشري ولا يفضحه — فلا تحرج من رخصةٍ شرعها الرحيم."},{"i":12,"of":71,"s":4,"surah":"النساء","a":96,"text":"دَرَجَاتٍ مِنْهُ وَمَغْفِرَةً وَرَحْمَةً وَكَانَ اللَّهُ غَفُورًا رَحِيمًا","prev":{"a":95,"text":"لَا يَسْتَوِي الْقَاعِدُونَ مِنَ الْمُؤْمِنِينَ غَيْرُ أُولِي الضَّرَرِ وَالْمُجَاهِدُونَ فِي سَبِيلِ اللَّهِ بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ فَضَّلَ اللَّهُ الْمُجَاهِدِينَ بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ عَلَى الْقَاعِدِينَ دَرَجَةً وَكُلًّا وَعَدَ اللَّهُ الْحُسْنَى وَفَضَّلَ اللَّهُ الْمُجَاهِدِينَ عَلَى الْقَاعِدِينَ أَجْرًا عَظِيمًا"},"next":{"a":97,"text":"إِنَّ الَّذِينَ تَوَفَّاهُمُ الْمَلَائِكَةُ ظَالِمِي أَنْفُسِهِمْ قَالُوا فِيمَ كُنْتُمْ قَالُوا كُنَّا مُسْتَضْعَفِينَ فِي الْأَرْضِ قَالُوا أَلَمْ تَكُنْ أَرْضُ اللَّهِ وَاسِعَةً فَتُهَاجِرُوا فِيهَا فَأُولَئِكَ مَأْوَاهُمْ جَهَنَّمُ وَسَاءَتْ مَصِيرًا"},"context":"في تفضيل المجاهدين: ﴿دَرَجَاتٍ مِنْهُ وَمَغْفِرَةً وَرَحْمَةً وَكَانَ اللَّهُ غَفُورًا رَحِيمًا﴾.","reason":"جزاءُ المجاهدين ثلاثي: درجاتٌ ومغفرةٌ ورحمة — ثم أُكّد بالاسمين: فالعطاء من معدنه؛ من كان اسمه الغفور الرحيم كان عطاؤه مغفرةً ورحمة. والمغفرة ذُكرت في الجزاء قبل تمامه: حتى المجاهد أول حاجته المغفرة.","adds":"أول ما يحتاجه أهل أعظم الأعمال: مغفرة — فاجعلها أول مسألتك دائمًا."},{"i":13,"of":71,"s":4,"surah":"النساء","a":100,"text":"وَمَنْ يُهَاجِرْ فِي سَبِيلِ اللَّهِ يَجِدْ فِي الْأَرْضِ مُرَاغَمًا كَثِيرًا وَسَعَةً وَمَنْ يَخْرُجْ مِنْ بَيْتِهِ مُهَاجِرًا إِلَى اللَّهِ وَرَسُولِهِ ثُمَّ يُدْرِكْهُ الْمَوْتُ فَقَدْ وَقَعَ أَجْرُهُ عَلَى اللَّهِ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا","prev":{"a":99,"text":"فَأُولَئِكَ عَسَى اللَّهُ أَنْ يَعْفُوَ عَنْهُمْ وَكَانَ اللَّهُ عَفُوًّا غَفُورًا"},"next":{"a":101,"text":"وَإِذَا ضَرَبْتُمْ فِي الْأَرْضِ فَلَيْسَ عَلَيْكُمْ جُنَاحٌ أَنْ تَقْصُرُوا مِنَ الصَّلَاةِ إِنْ خِفْتُمْ أَنْ يَفْتِنَكُمُ الَّذِينَ كَفَرُوا إِنَّ الْكَافِرِينَ كَانُوا لَكُمْ عَدُوًّا مُبِينًا"},"reason":"من مات في الطريق قبل بلوغ غايته الصالحة، فأجره «وقع» على الله — تعبيرُ وجوبٍ وثبوت — كاملًا غير منقوص. فالغفور يغفر نقصَ العمل الذي قطعه الموت، والرحيم يُتمّ بالنية ما لم تتمه الأيام.","adds":"أعظم آيةٍ لمن يخاف أن يموت قبل إتمام مشروعه الصالح: عليك البدايةُ الصادقة، وعلى الغفور الرحيم الإتمام."},{"i":14,"of":71,"s":4,"surah":"النساء","a":106,"text":"وَاسْتَغْفِرِ اللَّهَ إِنَّ اللَّهَ كَانَ غَفُورًا رَحِيمًا","prev":{"a":105,"text":"إِنَّا أَنْزَلْنَا إِلَيْكَ الْكِتَابَ بِالْحَقِّ لِتَحْكُمَ بَيْنَ النَّاسِ بِمَا أَرَاكَ اللَّهُ وَلَا تَكُنْ لِلْخَائِنِينَ خَصِيمًا"},"next":{"a":107,"text":"وَلَا تُجَادِلْ عَنِ الَّذِينَ يَخْتَانُونَ أَنْفُسَهُمْ إِنَّ اللَّهَ لَا يُحِبُّ مَنْ كَانَ خَوَّانًا أَثِيمًا"},"context":"في قصة من جادل عن الخائن (بني أُبيرق) (صحيح الترمذي 3036): ﴿وَاسْتَغْفِرِ اللَّهَ إِنَّ اللَّهَ كَانَ غَفُورًا رَحِيمًا﴾.","reason":"أُمر النبيُّ ﷺ نفسُه بالاستغفار حين مال إلى ظاهرٍ برّأ خائنًا واتهم بريئًا — فالاستغفار يصحح حتى الاجتهادات والمواقف الحسنة النية إذا أخطأت المحل، والغفور الرحيم يقبل رجوع المجتهد.","adds":"إذا اكتشفتَ أنك دافعتَ عن مخطئ أو ظلمتَ بريئًا بحسن نية: استغفر وصحّح — فالنية لا تصحح الخطأ لكنها تفتح باب المغفرة.","dorar":[{"id":"ca46UMvl","label":"صحيح الترمذي 3036"},{"id":"dfK91aXH","label":"المستدرك على الصحيحين 8376"}]},{"i":15,"of":71,"s":4,"surah":"النساء","a":110,"text":"وَمَنْ يَعْمَلْ سُوءًا أَوْ يَظْلِمْ نَفْسَهُ ثُمَّ يَسْتَغْفِرِ اللَّهَ يَجِدِ اللَّهَ غَفُورًا رَحِيمًا","prev":{"a":109,"text":"هَا أَنْتُمْ هَؤُلَاءِ جَادَلْتُمْ عَنْهُمْ فِي الْحَيَاةِ الدُّنْيَا فَمَنْ يُجَادِلُ اللَّهَ عَنْهُمْ يَوْمَ الْقِيَامَةِ أَمْ مَنْ يَكُونُ عَلَيْهِمْ وَكِيلًا"},"next":{"a":111,"text":"وَمَنْ يَكْسِبْ إِثْمًا فَإِنَّمَا يَكْسِبُهُ عَلَى نَفْسِهِ وَكَانَ اللَّهُ عَلِيمًا حَكِيمًا"},"reason":"أوسع آيات الاستغفار وأصرحها: أيُّ سوءٍ وأيُّ ظلمٍ للنفس، يعقبه استغفارٌ صادق — والنتيجة بفعل التحقق: ﴿يَجِدِ﴾ اللهَ غفورًا رحيمًا — وجدانًا محققًا لا وعدًا مؤجلًا، كمن يجد شيئًا حاضرًا بين يديه.","adds":"«يجد» فعلُ تحققٍ فوري: جرّب الاستغفار الصادق تجد المغفرة حاضرة — الآية عرضٌ مفتوح بلا شروطٍ معقدة."},{"i":16,"of":71,"s":4,"surah":"النساء","a":129,"text":"وَلَنْ تَسْتَطِيعُوا أَنْ تَعْدِلُوا بَيْنَ النِّسَاءِ وَلَوْ حَرَصْتُمْ فَلَا تَمِيلُوا كُلَّ الْمَيْلِ فَتَذَرُوهَا كَالْمُعَلَّقَةِ وَإِنْ تُصْلِحُوا وَتَتَّقُوا فَإِنَّ اللَّهَ كَانَ غَفُورًا رَحِيمًا","prev":{"a":128,"text":"وَإِنِ امْرَأَةٌ خَافَتْ مِنْ بَعْلِهَا نُشُوزًا أَوْ إِعْرَاضًا فَلَا جُنَاحَ عَلَيْهِمَا أَنْ يُصْلِحَا بَيْنَهُمَا صُلْحًا وَالصُّلْحُ خَيْرٌ وَأُحْضِرَتِ الْأَنْفُسُ الشُّحَّ وَإِنْ تُحْسِنُوا وَتَتَّقُوا فَإِنَّ اللَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًا"},"next":{"a":130,"text":"وَإِنْ يَتَفَرَّقَا يُغْنِ اللَّهُ كُلًّا مِنْ سَعَتِهِ وَكَانَ اللَّهُ وَاسِعًا حَكِيمًا"},"context":"﴿وَلَنْ تَسْتَطِيعُوا أَنْ تَعْدِلُوا بَيْنَ النِّسَاءِ وَلَوْ حَرَصْتُمْ فَلَا تَمِيلُوا كُلَّ الْمَيْلِ... وَإِنْ تُصْلِحُوا وَتَتَّقُوا فَإِنَّ اللَّهَ كَانَ غَفُورًا رَحِيمًا﴾.","reason":"اعترف الشرعُ بعجز القلب عن التسوية الكاملة في المحبة — ﴿وَلَوْ حَرَصْتُمْ﴾ — فطلب المقدور: ألا تميلوا كل الميل. ومع الإصلاح والتقوى يغفر الغفورُ ميلَ القلب الذي لا يُملك، ويرحم الساعي في العدل الممكن.","adds":"لا تُكلَّف ما لا يُطاق من مشاعر قلبك — تُكلَّف عدلَ فعلك: والفارق بينهما مغفور."},{"i":17,"of":71,"s":4,"surah":"النساء","a":152,"text":"وَالَّذِينَ آمَنُوا بِاللَّهِ وَرُسُلِهِ وَلَمْ يُفَرِّقُوا بَيْنَ أَحَدٍ مِنْهُمْ أُولَئِكَ سَوْفَ يُؤْتِيهِمْ أُجُورَهُمْ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا","prev":{"a":151,"text":"أُولَئِكَ هُمُ الْكَافِرُونَ حَقًّا وَأَعْتَدْنَا لِلْكَافِرِينَ عَذَابًا مُهِينًا"},"next":{"a":153,"text":"يَسْأَلُكَ أَهْلُ الْكِتَابِ أَنْ تُنَزِّلَ عَلَيْهِمْ كِتَابًا مِنَ السَّمَاءِ فَقَدْ سَأَلُوا مُوسَى أَكْبَرَ مِنْ ذَلِكَ فَقَالُوا أَرِنَا اللَّهَ جَهْرَةً فَأَخَذَتْهُمُ الصَّاعِقَةُ بِظُلْمِهِمْ ثُمَّ اتَّخَذُوا الْعِجْلَ مِنْ بَعْدِ مَا جَاءَتْهُمُ الْبَيِّنَاتُ فَعَفَوْنَا عَنْ ذَلِكَ وَآتَيْنَا مُوسَى سُلْطَانًا مُبِينًا"},"reason":"في مقابل من آمن ببعض الرسل وكفر ببعض، وُعد من آمن بهم جميعًا بلا تفريق بالأجور — وخُتم الوعد بالاسمين: مغفرةٌ تسبق الأجر تطهّر العامل، ورحمةٌ تحفّ الإيمان الجامع.","adds":"وحدة الإيمان بالرسل كلهم شرطُ القبول — والأجر محفوف بمغفرةٍ ورحمة."},{"i":18,"of":71,"s":5,"surah":"المائدة","a":3,"text":"حُرِّمَتْ عَلَيْكُمُ الْمَيْتَةُ وَالدَّمُ وَلَحْمُ الْخِنْزِيرِ وَمَا أُهِلَّ لِغَيْرِ اللَّهِ بِهِ وَالْمُنْخَنِقَةُ وَالْمَوْقُوذَةُ وَالْمُتَرَدِّيَةُ وَالنَّطِيحَةُ وَمَا أَكَلَ السَّبُعُ إِلَّا مَا ذَكَّيْتُمْ وَمَا ذُبِحَ عَلَى النُّصُبِ وَأَنْ تَسْتَقْسِمُوا بِالْأَزْلَامِ ذَلِكُمْ فِسْقٌ الْيَوْمَ يَئِسَ الَّذِينَ كَفَرُوا مِنْ دِينِكُمْ فَلَا تَخْشَوْهُمْ وَاخْشَوْنِ الْيَوْمَ أَكْمَلْتُ لَكُمْ دِينَكُمْ وَأَتْمَمْتُ عَلَيْكُمْ نِعْمَتِي وَرَضِيتُ لَكُمُ الْإِسْلَامَ دِينًا فَمَنِ اضْطُرَّ فِي مَخْمَصَةٍ غَيْرَ مُتَجَانِفٍ لِإِثْمٍ فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":2,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تُحِلُّوا شَعَائِرَ اللَّهِ وَلَا الشَّهْرَ الْحَرَامَ وَلَا الْهَدْيَ وَلَا الْقَلَائِدَ وَلَا آمِّينَ الْبَيْتَ الْحَرَامَ يَبْتَغُونَ فَضْلًا مِنْ رَبِّهِمْ وَرِضْوَانًا وَإِذَا حَلَلْتُمْ فَاصْطَادُوا وَلَا يَجْرِمَنَّكُمْ شَنَآنُ قَوْمٍ أَنْ صَدُّوكُمْ عَنِ الْمَسْجِدِ الْحَرَامِ أَنْ تَعْتَدُوا وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَى وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ وَاتَّقُوا اللَّهَ إِنَّ اللَّهَ شَدِيدُ الْعِقَابِ"},"next":{"a":4,"text":"يَسْأَلُونَكَ مَاذَا أُحِلَّ لَهُمْ قُلْ أُحِلَّ لَكُمُ الطَّيِّبَاتُ وَمَا عَلَّمْتُمْ مِنَ الْجَوَارِحِ مُكَلِّبِينَ تُعَلِّمُونَهُنَّ مِمَّا عَلَّمَكُمُ اللَّهُ فَكُلُوا مِمَّا أَمْسَكْنَ عَلَيْكُمْ وَاذْكُرُوا اسْمَ اللَّهِ عَلَيْهِ وَاتَّقُوا اللَّهَ إِنَّ اللَّهَ سَرِيعُ الْحِسَابِ"},"context":"في آية إكمال الدين نفسها، بعد تفصيل المحرمات: ﴿فَمَنِ اضْطُرَّ فِي مَخْمَصَةٍ غَيْرَ مُتَجَانِفٍ لِإِثْمٍ فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾.","reason":"في اليوم الذي أُكمل فيه الدين، أُكملت رخصتُه أيضًا: المخمصة (شدة الجوع) تبيح المحظور لغير المتعمّد للإثم — فكمالُ الدين يشمل كمالَ رحمته ورخصه، لا كمال قيوده فقط.","adds":"من تمام الدين تمامُ رخصه: فلن يحرجك دينُك في مخمصةٍ أبدًا."},{"i":19,"of":71,"s":5,"surah":"المائدة","a":34,"text":"إِلَّا الَّذِينَ تَابُوا مِنْ قَبْلِ أَنْ تَقْدِرُوا عَلَيْهِمْ فَاعْلَمُوا أَنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":33,"text":"إِنَّمَا جَزَاءُ الَّذِينَ يُحَارِبُونَ اللَّهَ وَرَسُولَهُ وَيَسْعَوْنَ فِي الْأَرْضِ فَسَادًا أَنْ يُقَتَّلُوا أَوْ يُصَلَّبُوا أَوْ تُقَطَّعَ أَيْدِيهِمْ وَأَرْجُلُهُمْ مِنْ خِلَافٍ أَوْ يُنْفَوْا مِنَ الْأَرْضِ ذَلِكَ لَهُمْ خِزْيٌ فِي الدُّنْيَا وَلَهُمْ فِي الْآخِرَةِ عَذَابٌ عَظِيمٌ"},"next":{"a":35,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَابْتَغُوا إِلَيْهِ الْوَسِيلَةَ وَجَاهِدُوا فِي سَبِيلِهِ لَعَلَّكُمْ تُفْلِحُونَ"},"context":"في حد الحرابة الغليظ (قطاع الطرق)، جاء الاستثناء: ﴿إِلَّا الَّذِينَ تَابُوا مِنْ قَبْلِ أَنْ تَقْدِرُوا عَلَيْهِمْ فَاعْلَمُوا أَنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾.","reason":"حتى المحاربُ قاطعُ الطريق — صاحبُ أغلظ الحدود — إن جاء تائبًا قبل أن تصل إليه يدُ السلطان سقط عنه الحد: فتوبته قبل القدرة عليه دليلُ صدقٍ يقابله الغفور الرحيم.","adds":"باب التوبة أسبق من يد القانون لمن بادر صادقًا — فلا تنتظر أن تُمسك لتتوب."},{"i":20,"of":71,"s":5,"surah":"المائدة","a":39,"text":"فَمَنْ تَابَ مِنْ بَعْدِ ظُلْمِهِ وَأَصْلَحَ فَإِنَّ اللَّهَ يَتُوبُ عَلَيْهِ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":38,"text":"وَالسَّارِقُ وَالسَّارِقَةُ فَاقْطَعُوا أَيْدِيَهُمَا جَزَاءً بِمَا كَسَبَا نَكَالًا مِنَ اللَّهِ وَاللَّهُ عَزِيزٌ حَكِيمٌ"},"next":{"a":40,"text":"أَلَمْ تَعْلَمْ أَنَّ اللَّهَ لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ يُعَذِّبُ مَنْ يَشَاءُ وَيَغْفِرُ لِمَنْ يَشَاءُ وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},"context":"بعد حد السرقة مباشرة: ﴿فَمَنْ تَابَ مِنْ بَعْدِ ظُلْمِهِ وَأَصْلَحَ فَإِنَّ اللَّهَ يَتُوبُ عَلَيْهِ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾.","reason":"لم يُترك السارق المحدود لليأس: توبتُه بعد ظلمه مقبولة والله يتوب عليه — فالحدُّ يطهّر في الدنيا، والتوبة تمحو عند الله، ولا تَعارُض: عقوبةُ القضاء لا تُغلق بابَ السماء.","adds":"العقوبة الدنيوية لا تعني سقوطك الأبدي — بعد الحد بابُ الغفور الرحيم مفتوح."},{"i":21,"of":71,"s":5,"surah":"المائدة","a":74,"text":"أَفَلَا يَتُوبُونَ إِلَى اللَّهِ وَيَسْتَغْفِرُونَهُ وَاللَّهُ غَفُورٌ رَحِيمٌ","prev":{"a":73,"text":"لَقَدْ كَفَرَ الَّذِينَ قَالُوا إِنَّ اللَّهَ ثَالِثُ ثَلَاثَةٍ وَمَا مِنْ إِلَهٍ إِلَّا إِلَهٌ وَاحِدٌ وَإِنْ لَمْ يَنْتَهُوا عَمَّا يَقُولُونَ لَيَمَسَّنَّ الَّذِينَ كَفَرُوا مِنْهُمْ عَذَابٌ أَلِيمٌ"},"next":{"a":75,"text":"مَا الْمَسِيحُ ابْنُ مَرْيَمَ إِلَّا رَسُولٌ قَدْ خَلَتْ مِنْ قَبْلِهِ الرُّسُلُ وَأُمُّهُ صِدِّيقَةٌ كَانَا يَأْكُلَانِ الطَّعَامَ انْظُرْ كَيْفَ نُبَيِّنُ لَهُمُ الْآيَاتِ ثُمَّ انْظُرْ أَنَّى يُؤْفَكُونَ"},"context":"بعد تقرير كفر من قالوا إن الله ثالث ثلاثة وتوعدهم: ﴿أَفَلَا يَتُوبُونَ إِلَى اللَّهِ وَيَسْتَغْفِرُونَهُ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾.","reason":"عرضٌ حانٍ بصيغة الاستفهام الرقيق: أفلا يتوبون؟ — حتى أصحابُ أغلظ مقالةٍ في حق الله يُدعَون إلى بابه دعوةَ مشفقٍ لا شامت. فالتشخيص القاسي للكفر لم يمنع الدعوةَ الرحيمة لأهله.","adds":"منهج الدعوة: سمِّ الباطل باسمه، ثم افتح الباب بأرقّ عبارة — «أفلا يتوبون؟»"},{"i":22,"of":71,"s":5,"surah":"المائدة","a":98,"text":"اعْلَمُوا أَنَّ اللَّهَ شَدِيدُ الْعِقَابِ وَأَنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":97,"text":"جَعَلَ اللَّهُ الْكَعْبَةَ الْبَيْتَ الْحَرَامَ قِيَامًا لِلنَّاسِ وَالشَّهْرَ الْحَرَامَ وَالْهَدْيَ وَالْقَلَائِدَ ذَلِكَ لِتَعْلَمُوا أَنَّ اللَّهَ يَعْلَمُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَأَنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ"},"next":{"a":99,"text":"مَا عَلَى الرَّسُولِ إِلَّا الْبَلَاغُ وَاللَّهُ يَعْلَمُ مَا تُبْدُونَ وَمَا تَكْتُمُونَ"},"context":"﴿اعْلَمُوا أَنَّ اللَّهَ شَدِيدُ الْعِقَابِ وَأَنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — آية واحدة تجمع الطرفين.","reason":"أمرٌ بعلمَين متقابلين في جملة واحدة: شدةُ العقاب تورث الخوف، والمغفرةُ والرحمة تورثان الرجاء — فالسير إلى الله بجناحين متوازنين، ومن طار بجناحٍ واحد سقط: إما إلى الأمن من المكر أو إلى القنوط.","adds":"آية الميزان الاعتقادي الصريحة: احفظها لتعتدل — خوفٌ بلا قنوط ورجاءٌ بلا أمن."},{"i":23,"of":71,"s":6,"surah":"الأنعام","a":54,"text":"وَإِذَا جَاءَكَ الَّذِينَ يُؤْمِنُونَ بِآيَاتِنَا فَقُلْ سَلَامٌ عَلَيْكُمْ كَتَبَ رَبُّكُمْ عَلَى نَفْسِهِ الرَّحْمَةَ أَنَّهُ مَنْ عَمِلَ مِنْكُمْ سُوءًا بِجَهَالَةٍ ثُمَّ تَابَ مِنْ بَعْدِهِ وَأَصْلَحَ فَأَنَّهُ غَفُورٌ رَحِيمٌ","prev":{"a":53,"text":"وَكَذَلِكَ فَتَنَّا بَعْضَهُمْ بِبَعْضٍ لِيَقُولُوا أَهَؤُلَاءِ مَنَّ اللَّهُ عَلَيْهِمْ مِنْ بَيْنِنَا أَلَيْسَ اللَّهُ بِأَعْلَمَ بِالشَّاكِرِينَ"},"next":{"a":55,"text":"وَكَذَلِكَ نُفَصِّلُ الْآيَاتِ وَلِتَسْتَبِينَ سَبِيلُ الْمُجْرِمِينَ"},"reason":"ثلاث لآلئ في آية: استقبالُ المذنبين التائبين بالسلام لا بالتأنيب، والتزامٌ إلهي ذاتي — ﴿كَتَبَ رَبُّكُمْ عَلَى نَفْسِهِ الرَّحْمَةَ﴾ — لم يُلزمه أحد، ومعادلةُ المغفرة: سوءٌ بجهالة + توبة + إصلاح = غفور رحيم.","adds":"أدب استقبال العائدين: «سلامٌ عليكم» — فمن كتب الرحمةَ على نفسه، لا يليق بأتباعه تعييرُ التائبين."},{"i":24,"of":71,"s":6,"surah":"الأنعام","a":145,"text":"قُلْ لَا أَجِدُ فِي مَا أُوحِيَ إِلَيَّ مُحَرَّمًا عَلَى طَاعِمٍ يَطْعَمُهُ إِلَّا أَنْ يَكُونَ مَيْتَةً أَوْ دَمًا مَسْفُوحًا أَوْ لَحْمَ خِنْزِيرٍ فَإِنَّهُ رِجْسٌ أَوْ فِسْقًا أُهِلَّ لِغَيْرِ اللَّهِ بِهِ فَمَنِ اضْطُرَّ غَيْرَ بَاغٍ وَلَا عَادٍ فَإِنَّ رَبَّكَ غَفُورٌ رَحِيمٌ","prev":{"a":144,"text":"وَمِنَ الْإِبِلِ اثْنَيْنِ وَمِنَ الْبَقَرِ اثْنَيْنِ قُلْ آلذَّكَرَيْنِ حَرَّمَ أَمِ الْأُنْثَيَيْنِ أَمَّا اشْتَمَلَتْ عَلَيْهِ أَرْحَامُ الْأُنْثَيَيْنِ أَمْ كُنْتُمْ شُهَدَاءَ إِذْ وَصَّاكُمُ اللَّهُ بِهَذَا فَمَنْ أَظْلَمُ مِمَّنِ افْتَرَى عَلَى اللَّهِ كَذِبًا لِيُضِلَّ النَّاسَ بِغَيْرِ عِلْمٍ إِنَّ اللَّهَ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ"},"next":{"a":146,"text":"وَعَلَى الَّذِينَ هَادُوا حَرَّمْنَا كُلَّ ذِي ظُفُرٍ وَمِنَ الْبَقَرِ وَالْغَنَمِ حَرَّمْنَا عَلَيْهِمْ شُحُومَهُمَا إِلَّا مَا حَمَلَتْ ظُهُورُهُمَا أَوِ الْحَوَايَا أَوْ مَا اخْتَلَطَ بِعَظْمٍ ذَلِكَ جَزَيْنَاهُمْ بِبَغْيِهِمْ وَإِنَّا لَصَادِقُونَ"},"context":"﴿قُلْ لَا أَجِدُ فِي مَا أُوحِيَ إِلَيَّ مُحَرَّمًا عَلَى طَاعِمٍ يَطْعَمُهُ إِلَّا...﴾ — حصرُ المحرمات، ثم: ﴿فَمَنِ اضْطُرَّ غَيْرَ بَاغٍ وَلَا عَادٍ فَإِنَّ رَبَّكَ غَفُورٌ رَحِيمٌ﴾.","reason":"الأصل في الأطعمة الحِلّ والتحريم استثناءٌ محصور — وحتى المحصورُ يُفتح عند الضرورة لغير الباغي ولا العادي: فباب الاضطرار مقرونٌ بالتحريم في الآية نفسها.","adds":"من ضيّق على الناس ما وسّعه الله فقد خالف منهج «لا أجد محرمًا إلا» — فالأصل الحل."},{"i":25,"of":71,"s":6,"surah":"الأنعام","a":165,"text":"وَهُوَ الَّذِي جَعَلَكُمْ خَلَائِفَ الْأَرْضِ وَرَفَعَ بَعْضَكُمْ فَوْقَ بَعْضٍ دَرَجَاتٍ لِيَبْلُوَكُمْ فِي مَا آتَاكُمْ إِنَّ رَبَّكَ سَرِيعُ الْعِقَابِ وَإِنَّهُ لَغَفُورٌ رَحِيمٌ","prev":{"a":164,"text":"قُلْ أَغَيْرَ اللَّهِ أَبْغِي رَبًّا وَهُوَ رَبُّ كُلِّ شَيْءٍ وَلَا تَكْسِبُ كُلُّ نَفْسٍ إِلَّا عَلَيْهَا وَلَا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَى ثُمَّ إِلَى رَبِّكُمْ مَرْجِعُكُمْ فَيُنَبِّئُكُمْ بِمَا كُنْتُمْ فِيهِ تَخْتَلِفُونَ"},"context":"﴿وَهُوَ الَّذِي جَعَلَكُمْ خَلَائِفَ الْأَرْضِ وَرَفَعَ بَعْضَكُمْ فَوْقَ بَعْضٍ دَرَجَاتٍ لِيَبْلُوَكُمْ فِي مَا آتَاكُمْ إِنَّ رَبَّكَ سَرِيعُ الْعِقَابِ وَإِنَّهُ لَغَفُورٌ رَحِيمٌ﴾ — آخر آية في الأنعام.","reason":"تفاوتُ الناس في الأرزاق والمراتب ابتلاءٌ لا تفضيلٌ نهائي — والختامُ ميزان: سريعُ العقاب لمن أساء فيما أوتي، غفورٌ رحيم لمن اتقى وعاد. فالدرجات الدنيوية مادةُ امتحان، والاسمان نتيجتاه.","adds":"لا تقرأ تفاوت الأرزاق قراءة حسدٍ أو زهو — اقرأه سؤالَ امتحان: ماذا ستفعل بما أوتيت؟"},{"i":26,"of":71,"s":7,"surah":"الأعراف","a":153,"text":"وَالَّذِينَ عَمِلُوا السَّيِّئَاتِ ثُمَّ تَابُوا مِنْ بَعْدِهَا وَآمَنُوا إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ","prev":{"a":152,"text":"إِنَّ الَّذِينَ اتَّخَذُوا الْعِجْلَ سَيَنَالُهُمْ غَضَبٌ مِنْ رَبِّهِمْ وَذِلَّةٌ فِي الْحَيَاةِ الدُّنْيَا وَكَذَلِكَ نَجْزِي الْمُفْتَرِينَ"},"next":{"a":154,"text":"وَلَمَّا سَكَتَ عَنْ مُوسَى الْغَضَبُ أَخَذَ الْأَلْوَاحَ وَفِي نُسْخَتِهَا هُدًى وَرَحْمَةٌ لِلَّذِينَ هُمْ لِرَبِّهِمْ يَرْهَبُونَ"},"context":"بعد قصة العجل وغضب موسى ورجوع بني إسرائيل: ﴿وَالَّذِينَ عَمِلُوا السَّيِّئَاتِ ثُمَّ تَابُوا مِنْ بَعْدِهَا وَآمَنُوا إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ﴾.","reason":"جاءت القاعدة عقب أعظم خطيئةٍ جماعية — عبادة العجل بعد النجاة من فرعون — فحتى هي تُمحى بالتوبة والإيمان. وتكرار ﴿مِنْ بَعْدِهَا﴾ يرسم الانقلاب: بعد السيئات مباشرةً تنقلب الصفحة إن انقلب القلب.","adds":"لا خطيئة — فرديةً كانت أو جماعية — فوق طاقة التوبة: قومٌ عبدوا عجلًا ثم تيب عليهم."},{"i":27,"of":71,"s":7,"surah":"الأعراف","a":167,"text":"وَإِذْ تَأَذَّنَ رَبُّكَ لَيَبْعَثَنَّ عَلَيْهِمْ إِلَى يَوْمِ الْقِيَامَةِ مَنْ يَسُومُهُمْ سُوءَ الْعَذَابِ إِنَّ رَبَّكَ لَسَرِيعُ الْعِقَابِ وَإِنَّهُ لَغَفُورٌ رَحِيمٌ","prev":{"a":166,"text":"فَلَمَّا عَتَوْا عَنْ مَا نُهُوا عَنْهُ قُلْنَا لَهُمْ كُونُوا قِرَدَةً خَاسِئِينَ"},"next":{"a":168,"text":"وَقَطَّعْنَاهُمْ فِي الْأَرْضِ أُمَمًا مِنْهُمُ الصَّالِحُونَ وَمِنْهُمْ دُونَ ذَلِكَ وَبَلَوْنَاهُمْ بِالْحَسَنَاتِ وَالسَّيِّئَاتِ لَعَلَّهُمْ يَرْجِعُونَ"},"reason":"مع القضاء التاريخي على بني إسرائيل بالإذلال جزاءَ نقضهم، خُتم الإعلان بالجناحين: سريعُ العقاب سنّةً في الأمم الناكثة، غفورٌ رحيم بابًا مفتوحًا لكل فردٍ خرج من أسباب العقوبة بالإيمان والاستقامة.","adds":"الأحكام على الأمم لا تُغلق باب الأفراد: فردٌ تائب يخرج من قضاءٍ نزل بأمة."},{"i":28,"of":71,"s":8,"surah":"الأنفال","a":69,"text":"فَكُلُوا مِمَّا غَنِمْتُمْ حَلَالًا طَيِّبًا وَاتَّقُوا اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":68,"text":"لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ لَمَسَّكُمْ فِيمَا أَخَذْتُمْ عَذَابٌ عَظِيمٌ"},"next":{"a":70,"text":"يَا أَيُّهَا النَّبِيُّ قُلْ لِمَنْ فِي أَيْدِيكُمْ مِنَ الْأَسْرَى إِنْ يَعْلَمِ اللَّهُ فِي قُلُوبِكُمْ خَيْرًا يُؤْتِكُمْ خَيْرًا مِمَّا أُخِذَ مِنْكُمْ وَيَغْفِرْ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ"},"context":"بعد عتاب الأسرى: ﴿فَكُلُوا مِمَّا غَنِمْتُمْ حَلَالًا طَيِّبًا وَاتَّقُوا اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾.","reason":"عقب العتاب مباشرةً أُحلّت الغنيمة حلالًا طيبًا: فالمغفرة شملت ما مضى من اجتهادهم في الفداء، والرحمة أباحت لهذه الأمة ما لم يُبَح لأمةٍ قبلها. عتابٌ ثم توسعة — لا عتابٌ يعقبه حرمان.","adds":"إذا عاتبك الله بابتلاءٍ ثم فتح لك بابًا فكُلْ منه طيبًا — عتابُه لا يقطع عطاءه."},{"i":29,"of":71,"s":8,"surah":"الأنفال","a":70,"text":"يَا أَيُّهَا النَّبِيُّ قُلْ لِمَنْ فِي أَيْدِيكُمْ مِنَ الْأَسْرَى إِنْ يَعْلَمِ اللَّهُ فِي قُلُوبِكُمْ خَيْرًا يُؤْتِكُمْ خَيْرًا مِمَّا أُخِذَ مِنْكُمْ وَيَغْفِرْ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ","prev":{"a":69,"text":"فَكُلُوا مِمَّا غَنِمْتُمْ حَلَالًا طَيِّبًا وَاتَّقُوا اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ"},"next":{"a":71,"text":"وَإِنْ يُرِيدُوا خِيَانَتَكَ فَقَدْ خَانُوا اللَّهَ مِنْ قَبْلُ فَأَمْكَنَ مِنْهُمْ وَاللَّهُ عَلِيمٌ حَكِيمٌ"},"reason":"حتى أسرى بدرٍ المشركون خوطبوا بالرجاء: خيرُ القلب يعوّض الفداء المأخوذ ويجلب المغفرة — وقد تحققت في العباس رضي الله عنه وغيره ممن أسلم فأوتي خيرًا مما أُخذ منه أضعافًا.","adds":"رسالة لكل من خسر مالًا أو مكانةً في طريق الحق: أصلِح قلبك — والتعويض والمغفرة على الغفور الرحيم."},{"i":30,"of":71,"s":9,"surah":"التوبة","a":5,"text":"فَإِذَا انْسَلَخَ الْأَشْهُرُ الْحُرُمُ فَاقْتُلُوا الْمُشْرِكِينَ حَيْثُ وَجَدْتُمُوهُمْ وَخُذُوهُمْ وَاحْصُرُوهُمْ وَاقْعُدُوا لَهُمْ كُلَّ مَرْصَدٍ فَإِنْ تَابُوا وَأَقَامُوا الصَّلَاةَ وَآتَوُا الزَّكَاةَ فَخَلُّوا سَبِيلَهُمْ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":4,"text":"إِلَّا الَّذِينَ عَاهَدْتُمْ مِنَ الْمُشْرِكِينَ ثُمَّ لَمْ يَنْقُصُوكُمْ شَيْئًا وَلَمْ يُظَاهِرُوا عَلَيْكُمْ أَحَدًا فَأَتِمُّوا إِلَيْهِمْ عَهْدَهُمْ إِلَى مُدَّتِهِمْ إِنَّ اللَّهَ يُحِبُّ الْمُتَّقِينَ"},"next":{"a":6,"text":"وَإِنْ أَحَدٌ مِنَ الْمُشْرِكِينَ اسْتَجَارَكَ فَأَجِرْهُ حَتَّى يَسْمَعَ كَلَامَ اللَّهِ ثُمَّ أَبْلِغْهُ مَأْمَنَهُ ذَلِكَ بِأَنَّهُمْ قَوْمٌ لَا يَعْلَمُونَ"},"context":"أشد آيات القتال: ﴿فَاقْتُلُوا الْمُشْرِكِينَ حَيْثُ وَجَدْتُمُوهُمْ...﴾ — وخاتمتها: ﴿فَإِنْ تَابُوا وَأَقَامُوا الصَّلَاةَ وَآتَوُا الزَّكَاةَ فَخَلُّوا سَبِيلَهُمْ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾.","reason":"حتى آيةُ السيف تنتهي بشرط التوبة وتخلية السبيل والاسمين: فالسيف لكفّ حرابة الناقضين لا للإكراه، والتوبة تقلب المحارَب أخًا يُخلّى سبيله ويُغفر ماضيه كلُّه.","adds":"من دخل في التوبة خرج من كل حسابٍ مضى — «فخلّوا سبيلهم» حكمُ الأرض، و«غفور رحيم» حكمُ السماء."},{"i":31,"of":71,"s":9,"surah":"التوبة","a":27,"text":"ثُمَّ يَتُوبُ اللَّهُ مِنْ بَعْدِ ذَلِكَ عَلَى مَنْ يَشَاءُ وَاللَّهُ غَفُورٌ رَحِيمٌ","prev":{"a":26,"text":"ثُمَّ أَنْزَلَ اللَّهُ سَكِينَتَهُ عَلَى رَسُولِهِ وَعَلَى الْمُؤْمِنِينَ وَأَنْزَلَ جُنُودًا لَمْ تَرَوْهَا وَعَذَّبَ الَّذِينَ كَفَرُوا وَذَلِكَ جَزَاءُ الْكَافِرِينَ"},"next":{"a":28,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنَّمَا الْمُشْرِكُونَ نَجَسٌ فَلَا يَقْرَبُوا الْمَسْجِدَ الْحَرَامَ بَعْدَ عَامِهِمْ هَذَا وَإِنْ خِفْتُمْ عَيْلَةً فَسَوْفَ يُغْنِيكُمُ اللَّهُ مِنْ فَضْلِهِ إِنْ شَاءَ إِنَّ اللَّهَ عَلِيمٌ حَكِيمٌ"},"context":"بعد هزيمة هوازن في حنين وفرار المشركين: ﴿ثُمَّ يَتُوبُ اللَّهُ مِنْ بَعْدِ ذَلِكَ عَلَى مَنْ يَشَاءُ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾.","reason":"فُتح بابُ التوبة للمنهزمين فور انكسارهم: فهزيمة الباطل قد تكون أول طريق هداية أهله — وقد أسلمت هوازن بعدها وردّ النبي ﷺ عليهم السبي. فالله يهزم أقوامًا ليتوب عليهم.","adds":"انكسار خصمك قد يكون بداية هدايته — فافتح له الباب كما فتحه الله.","dorar":[{"id":"NyqHICN3","label":"صحيح البخاري 4318"}]},{"i":32,"of":71,"s":9,"surah":"التوبة","a":91,"text":"لَيْسَ عَلَى الضُّعَفَاءِ وَلَا عَلَى الْمَرْضَى وَلَا عَلَى الَّذِينَ لَا يَجِدُونَ مَا يُنْفِقُونَ حَرَجٌ إِذَا نَصَحُوا لِلَّهِ وَرَسُولِهِ مَا عَلَى الْمُحْسِنِينَ مِنْ سَبِيلٍ وَاللَّهُ غَفُورٌ رَحِيمٌ","prev":{"a":90,"text":"وَجَاءَ الْمُعَذِّرُونَ مِنَ الْأَعْرَابِ لِيُؤْذَنَ لَهُمْ وَقَعَدَ الَّذِينَ كَذَبُوا اللَّهَ وَرَسُولَهُ سَيُصِيبُ الَّذِينَ كَفَرُوا مِنْهُمْ عَذَابٌ أَلِيمٌ"},"next":{"a":92,"text":"وَلَا عَلَى الَّذِينَ إِذَا مَا أَتَوْكَ لِتَحْمِلَهُمْ قُلْتَ لَا أَجِدُ مَا أَحْمِلُكُمْ عَلَيْهِ تَوَلَّوْا وَأَعْيُنُهُمْ تَفِيضُ مِنَ الدَّمْعِ حَزَنًا أَلَّا يَجِدُوا مَا يُنْفِقُونَ"},"reason":"رُفع الحرج عن ثلاثة أصناف عاجزين عن الجهاد — بشرط واحد: النصحُ (صدق النية والولاء) — وسُمّوا «محسنين» مع قعودهم! فالنيةُ الصادقة تجعل العاجزَ محسنًا، والقاعدةُ الذهبية: ما على المحسنين من سبيل.","adds":"إذا عجزتَ عن عملٍ صالح فاصدق النية وانصح — تُكتب محسنًا وأنت قاعد."},{"i":33,"of":71,"s":9,"surah":"التوبة","a":99,"text":"وَمِنَ الْأَعْرَابِ مَنْ يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَيَتَّخِذُ مَا يُنْفِقُ قُرُبَاتٍ عِنْدَ اللَّهِ وَصَلَوَاتِ الرَّسُولِ أَلَا إِنَّهَا قُرْبَةٌ لَهُمْ سَيُدْخِلُهُمُ اللَّهُ فِي رَحْمَتِهِ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":98,"text":"وَمِنَ الْأَعْرَابِ مَنْ يَتَّخِذُ مَا يُنْفِقُ مَغْرَمًا وَيَتَرَبَّصُ بِكُمُ الدَّوَائِرَ عَلَيْهِمْ دَائِرَةُ السَّوْءِ وَاللَّهُ سَمِيعٌ عَلِيمٌ"},"next":{"a":100,"text":"وَالسَّابِقُونَ الْأَوَّلُونَ مِنَ الْمُهَاجِرِينَ وَالْأَنْصَارِ وَالَّذِينَ اتَّبَعُوهُمْ بِإِحْسَانٍ رَضِيَ اللَّهُ عَنْهُمْ وَرَضُوا عَنْهُ وَأَعَدَّ لَهُمْ جَنَّاتٍ تَجْرِي تَحْتَهَا الْأَنْهَارُ خَالِدِينَ فِيهَا أَبَدًا ذَلِكَ الْفَوْزُ الْعَظِيمُ"},"reason":"في مقابل أعرابٍ يعدّون النفقة مغرمًا، أعرابٌ يحتسبونها قربات — فشهد الله لهم بجملةٍ مؤكدة: ﴿أَلَا إِنَّهَا قُرْبَةٌ لَهُمْ﴾ ووعدهم دخولَ الرحمة نفسِها لا نيلَها فقط.","adds":"النية تقلب المغرمَ قربة: المبلغ نفسه يدفعه اثنان — أحدهما غارم والآخر متقرب."},{"i":34,"of":71,"s":9,"surah":"التوبة","a":102,"text":"وَآخَرُونَ اعْتَرَفُوا بِذُنُوبِهِمْ خَلَطُوا عَمَلًا صَالِحًا وَآخَرَ سَيِّئًا عَسَى اللَّهُ أَنْ يَتُوبَ عَلَيْهِمْ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":101,"text":"وَمِمَّنْ حَوْلَكُمْ مِنَ الْأَعْرَابِ مُنَافِقُونَ وَمِنْ أَهْلِ الْمَدِينَةِ مَرَدُوا عَلَى النِّفَاقِ لَا تَعْلَمُهُمْ نَحْنُ نَعْلَمُهُمْ سَنُعَذِّبُهُمْ مَرَّتَيْنِ ثُمَّ يُرَدُّونَ إِلَى عَذَابٍ عَظِيمٍ"},"next":{"a":103,"text":"خُذْ مِنْ أَمْوَالِهِمْ صَدَقَةً تُطَهِّرُهُمْ وَتُزَكِّيهِمْ بِهَا وَصَلِّ عَلَيْهِمْ إِنَّ صَلَاتَكَ سَكَنٌ لَهُمْ وَاللَّهُ سَمِيعٌ عَلِيمٌ"},"reason":"هذه آيةُ أكثر الناس: الخالطون — لا أبرارٌ خُلّص ولا فجارٌ خُلّص — وطريقُهم المفتوح: الاعتراف بلا تبرير. و«عسى» من الله قريبةُ الوقوع، والاسمان يحسمان الرجاء.","adds":"لست ملَكًا ولا شيطانًا — أنت خالط: فابدأ من حيث بدؤوا: الاعتراف."},{"i":35,"of":71,"s":10,"surah":"يونس","a":107,"text":"وَإِنْ يَمْسَسْكَ اللَّهُ بِضُرٍّ فَلَا كَاشِفَ لَهُ إِلَّا هُوَ وَإِنْ يُرِدْكَ بِخَيْرٍ فَلَا رَادَّ لِفَضْلِهِ يُصِيبُ بِهِ مَنْ يَشَاءُ مِنْ عِبَادِهِ وَهُوَ الْغَفُورُ الرَّحِيمُ","prev":{"a":106,"text":"وَلَا تَدْعُ مِنْ دُونِ اللَّهِ مَا لَا يَنْفَعُكَ وَلَا يَضُرُّكَ فَإِنْ فَعَلْتَ فَإِنَّكَ إِذًا مِنَ الظَّالِمِينَ"},"next":{"a":108,"text":"قُلْ يَا أَيُّهَا النَّاسُ قَدْ جَاءَكُمُ الْحَقُّ مِنْ رَبِّكُمْ فَمَنِ اهْتَدَى فَإِنَّمَا يَهْتَدِي لِنَفْسِهِ وَمَنْ ضَلَّ فَإِنَّمَا يَضِلُّ عَلَيْهَا وَمَا أَنَا عَلَيْكُمْ بِوَكِيلٍ"},"reason":"احتُكر كشفُ الضر وردُّ الفضل بيده وحده — ثم خُتم التصريف كلُّه بالغفور الرحيم: فحتى الضرُّ يجري عليك من غفورٍ رحيم، لا من قدرةٍ باطشة — يبتلي بمغفرةٍ مدّخرة ورحمةٍ مستورة في طيّ البلاء.","adds":"يطمئن كل مبتلى: الماسكُ بملف ضرّك هو نفسه «الغفور الرحيم» — فالضر بيد الرحمة."},{"i":36,"of":71,"s":11,"surah":"هود","a":41,"text":"وَقَالَ ارْكَبُوا فِيهَا بِسْمِ اللَّهِ مَجْرَاهَا وَمُرْسَاهَا إِنَّ رَبِّي لَغَفُورٌ رَحِيمٌ","prev":{"a":40,"text":"حَتَّى إِذَا جَاءَ أَمْرُنَا وَفَارَ التَّنُّورُ قُلْنَا احْمِلْ فِيهَا مِنْ كُلٍّ زَوْجَيْنِ اثْنَيْنِ وَأَهْلَكَ إِلَّا مَنْ سَبَقَ عَلَيْهِ الْقَوْلُ وَمَنْ آمَنَ وَمَا آمَنَ مَعَهُ إِلَّا قَلِيلٌ"},"next":{"a":42,"text":"وَهِيَ تَجْرِي بِهِمْ فِي مَوْجٍ كَالْجِبَالِ وَنَادَى نُوحٌ ابْنَهُ وَكَانَ فِي مَعْزِلٍ يَا بُنَيَّ ارْكَبْ مَعَنَا وَلَا تَكُنْ مَعَ الْكَافِرِينَ"},"context":"لحظة الطوفان: ﴿وَقَالَ ارْكَبُوا فِيهَا بِسْمِ اللَّهِ مَجْرَاهَا وَمُرْسَاهَا إِنَّ رَبِّي لَغَفُورٌ رَحِيمٌ﴾.","reason":"افتتح نوحٌ ركوبَ سفينة النجاة بالبسملة وختم بالاسمين: فالسفينة تجري وترسو باسم الله لا بالخشب والمسامير، والنجاةُ نفسُها مغفرةٌ ورحمة — نجا الراكبون لأن ربهم غفورٌ رحيم لا لأن السفينة متينة.","adds":"سنّةُ كل ركوب: «بسم الله مجراها ومرساها» — قلها في سيارتك وطائرتك: تُجريها المغفرة والرحمة."},{"i":37,"of":71,"s":12,"surah":"يوسف","a":53,"text":"وَمَا أُبَرِّئُ نَفْسِي إِنَّ النَّفْسَ لَأَمَّارَةٌ بِالسُّوءِ إِلَّا مَا رَحِمَ رَبِّي إِنَّ رَبِّي غَفُورٌ رَحِيمٌ","prev":{"a":52,"text":"ذَلِكَ لِيَعْلَمَ أَنِّي لَمْ أَخُنْهُ بِالْغَيْبِ وَأَنَّ اللَّهَ لَا يَهْدِي كَيْدَ الْخَائِنِينَ"},"next":{"a":54,"text":"وَقَالَ الْمَلِكُ ائْتُونِي بِهِ أَسْتَخْلِصْهُ لِنَفْسِي فَلَمَّا كَلَّمَهُ قَالَ إِنَّكَ الْيَوْمَ لَدَيْنَا مَكِينٌ أَمِينٌ"},"reason":"اعترافٌ بحقيقة النفس البشرية كلِّها: أمّارةٌ بالسوء بطبعها — والعصمة استثناءُ رحمةٍ لا قوةً ذاتية: ﴿إِلَّا مَا رَحِمَ رَبِّي﴾. فمن نجا فبرحمته، ومن زلّ فبين يديه غفورٌ رحيم — لا عذرَ للأمن ولا مبررَ لليأس.","adds":"لا تأمن نفسك ولا تيأس منها: عِش بين ﴿لَأَمَّارَةٌ بِالسُّوءِ﴾ و﴿إِلَّا مَا رَحِمَ رَبِّي﴾."},{"i":38,"of":71,"s":12,"surah":"يوسف","a":98,"text":"قَالَ سَوْفَ أَسْتَغْفِرُ لَكُمْ رَبِّي إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ","prev":{"a":97,"text":"قَالُوا يَا أَبَانَا اسْتَغْفِرْ لَنَا ذُنُوبَنَا إِنَّا كُنَّا خَاطِئِينَ"},"next":{"a":99,"text":"فَلَمَّا دَخَلُوا عَلَى يُوسُفَ آوَى إِلَيْهِ أَبَوَيْهِ وَقَالَ ادْخُلُوا مِصْرَ إِنْ شَاءَ اللَّهُ آمِنِينَ"},"context":"بنو يعقوب يطلبون: ﴿يَا أَبَانَا اسْتَغْفِرْ لَنَا ذُنُوبَنَا﴾ — فيجيب: ﴿سَوْفَ أَسْتَغْفِرُ لَكُمْ رَبِّي إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ﴾.","reason":"وعد يعقوبُ بنيه بالاستغفار وأخّره بـ«سوف» — قيل: إلى وقت السحر تحريًا لساعة الإجابة — وقدّم يقينه: ﴿إِنَّهُ هُوَ﴾ بضمير الحصر: لا غافر سواه. فجمع بين حسن الظن بالقبول وحسن اختيار الوقت.","adds":"درسان: الوالد يستغفر لولده الجاني مهما فعل، والاستغفار يُتحرّى له وقتُ السحَر."},{"i":39,"of":71,"s":14,"surah":"إبراهيم","a":36,"text":"رَبِّ إِنَّهُنَّ أَضْلَلْنَ كَثِيرًا مِنَ النَّاسِ فَمَنْ تَبِعَنِي فَإِنَّهُ مِنِّي وَمَنْ عَصَانِي فَإِنَّكَ غَفُورٌ رَحِيمٌ","prev":{"a":35,"text":"وَإِذْ قَالَ إِبْرَاهِيمُ رَبِّ اجْعَلْ هَذَا الْبَلَدَ آمِنًا وَاجْنُبْنِي وَبَنِيَّ أَنْ نَعْبُدَ الْأَصْنَامَ"},"next":{"a":37,"text":"رَبَّنَا إِنِّي أَسْكَنْتُ مِنْ ذُرِّيَّتِي بِوَادٍ غَيْرِ ذِي زَرْعٍ عِنْدَ بَيْتِكَ الْمُحَرَّمِ رَبَّنَا لِيُقِيمُوا الصَّلَاةَ فَاجْعَلْ أَفْئِدَةً مِنَ النَّاسِ تَهْوِي إِلَيْهِمْ وَارْزُقْهُمْ مِنَ الثَّمَرَاتِ لَعَلَّهُمْ يَشْكُرُونَ"},"context":"إبراهيم يشكو الأصنام: ﴿رَبِّ إِنَّهُنَّ أَضْلَلْنَ كَثِيرًا مِنَ النَّاسِ فَمَنْ تَبِعَنِي فَإِنَّهُ مِنِّي وَمَنْ عَصَانِي فَإِنَّكَ غَفُورٌ رَحِيمٌ﴾.","reason":"أعجبُ شفقةٍ في القرآن: لم يقل «ومن عصاني فعذّبه» بل فوّض العاصي إلى الغفور الرحيم — رجاءَ أن يهديه فيتوب أو يتجاوز عنه. فقلبُ الخليل لا يحمل دعاءً على أحد حتى على من عصاه.","adds":"أدبُ الموقف من المخالفين: بدل اللعن والدعاء عليهم — «فإنك غفور رحيم»: كِلهم إلى رحمته."},{"i":40,"of":71,"s":15,"surah":"الحجر","a":49,"text":"نَبِّئْ عِبَادِي أَنِّي أَنَا الْغَفُورُ الرَّحِيمُ","prev":{"a":48,"text":"لَا يَمَسُّهُمْ فِيهَا نَصَبٌ وَمَا هُمْ مِنْهَا بِمُخْرَجِينَ"},"next":{"a":50,"text":"وَأَنَّ عَذَابِي هُوَ الْعَذَابُ الْأَلِيمُ"},"context":"﴿نَبِّئْ عِبَادِي أَنِّي أَنَا الْغَفُورُ الرَّحِيمُ﴾ — ثم: ﴿وَأَنَّ عَذَابِي هُوَ الْعَذَابُ الْأَلِيمُ﴾.","reason":"أمرٌ نبويٌّ بتبليغ نبأٍ رسمي من الله لعباده — بثلاث مؤكدات: ﴿أَنِّي أَنَا الْـ﴾ — هويتُه المعلنة أولًا: الغفور الرحيم؛ وقدّم المغفرةَ على العذاب: فالبشارة أصلٌ والإنذار تكملة، والمغفرة هي التعريف الأول.","adds":"أرقّ آية تعريف في القرآن: رسالةٌ شخصية من الله إليك عبر نبيه: «نبّئ عبادي أني أنا الغفور الرحيم» — فقد بلَغك النبأ."},{"i":41,"of":71,"s":16,"surah":"النحل","a":18,"text":"وَإِنْ تَعُدُّوا نِعْمَةَ اللَّهِ لَا تُحْصُوهَا إِنَّ اللَّهَ لَغَفُورٌ رَحِيمٌ","prev":{"a":17,"text":"أَفَمَنْ يَخْلُقُ كَمَنْ لَا يَخْلُقُ أَفَلَا تَذَكَّرُونَ"},"next":{"a":19,"text":"وَاللَّهُ يَعْلَمُ مَا تُسِرُّونَ وَمَا تُعْلِنُونَ"},"reason":"عجزُك عن إحصاء النعم يستلزم عجزَك عن شكرها — معادلةٌ مستحيلة تسحق العبد لولا الختام: غفورٌ يغفر التقصيرَ الحتمي في الشكر، رحيمٌ لا يقطع النعم بسببه. ولولا الاسمان لَهلك الشاكرون قبل الغافلين.","adds":"الاسمان هنا جوابُ معادلة مستحيلة: نعمٌ لا تُحصى وشكرٌ لا يُوفّى — فاشكر ما استطعت ودَعِ الباقي لمغفرته."},{"i":42,"of":71,"s":16,"surah":"النحل","a":110,"text":"ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ هَاجَرُوا مِنْ بَعْدِ مَا فُتِنُوا ثُمَّ جَاهَدُوا وَصَبَرُوا إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ","prev":{"a":109,"text":"لَا جَرَمَ أَنَّهُمْ فِي الْآخِرَةِ هُمُ الْخَاسِرُونَ"},"next":{"a":111,"text":"يَوْمَ تَأْتِي كُلُّ نَفْسٍ تُجَادِلُ عَنْ نَفْسِهَا وَتُوَفَّى كُلُّ نَفْسٍ مَا عَمِلَتْ وَهُمْ لَا يُظْلَمُونَ"},"context":"﴿ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ هَاجَرُوا مِنْ بَعْدِ مَا فُتِنُوا ثُمَّ جَاهَدُوا وَصَبَرُوا إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ﴾ — في المستضعفين الذين عُذّبوا حتى نطقوا بما أرضى المشركين، كعمّار.","reason":"من فُتن فنطق بالكفر مُكرهًا وقلبه مطمئن بالإيمان، ثم هاجر وجاهد وصبر — فربُّه من بعدها غفورٌ رحيم: يغفر كلمةَ الإكراه ويرحم صاحبَها المجروح. فزلّةُ التعذيب لا تُحسب على المقهور.","adds":"ما قلتَه أو فعلتَه تحت قهرٍ حقيقي مغفور — والعبرة بما بعده: هل نهضتَ وواصلت؟"},{"i":43,"of":71,"s":16,"surah":"النحل","a":115,"text":"إِنَّمَا حَرَّمَ عَلَيْكُمُ الْمَيْتَةَ وَالدَّمَ وَلَحْمَ الْخِنْزِيرِ وَمَا أُهِلَّ لِغَيْرِ اللَّهِ بِهِ فَمَنِ اضْطُرَّ غَيْرَ بَاغٍ وَلَا عَادٍ فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":114,"text":"فَكُلُوا مِمَّا رَزَقَكُمُ اللَّهُ حَلَالًا طَيِّبًا وَاشْكُرُوا نِعْمَتَ اللَّهِ إِنْ كُنْتُمْ إِيَّاهُ تَعْبُدُونَ"},"next":{"a":116,"text":"وَلَا تَقُولُوا لِمَا تَصِفُ أَلْسِنَتُكُمُ الْكَذِبَ هَذَا حَلَالٌ وَهَذَا حَرَامٌ لِتَفْتَرُوا عَلَى اللَّهِ الْكَذِبَ إِنَّ الَّذِينَ يَفْتَرُونَ عَلَى اللَّهِ الْكَذِبَ لَا يُفْلِحُونَ"},"context":"﴿إِنَّمَا حَرَّمَ عَلَيْكُمُ الْمَيْتَةَ وَالدَّمَ وَلَحْمَ الْخِنْزِيرِ وَمَا أُهِلَّ لِغَيْرِ اللَّهِ بِهِ فَمَنِ اضْطُرَّ غَيْرَ بَاغٍ وَلَا عَادٍ فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — بعد الأمر بالأكل من الحلال الطيب وشكر النعمة.","reason":"حُصر المحرَّم في أصنافٍ معدودة، ثم فُتح باب الضرورة: من اضطُرّ غيرَ باغٍ يطلبه شهوةً ولا عادٍ يتجاوز قدر الحاجة، فربُّه غفورٌ رحيم لا يؤاخذه — فالرخصة رحمةٌ مقيّدة بصدق الاضطرار.","adds":"لن يُحرجك الدين في ضرورةٍ حقيقية — والشرط في الآية نفسها: لا بغي ولا عدوان على قدر الحاجة."},{"i":44,"of":71,"s":16,"surah":"النحل","a":119,"text":"ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ عَمِلُوا السُّوءَ بِجَهَالَةٍ ثُمَّ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ","prev":{"a":118,"text":"وَعَلَى الَّذِينَ هَادُوا حَرَّمْنَا مَا قَصَصْنَا عَلَيْكَ مِنْ قَبْلُ وَمَا ظَلَمْنَاهُمْ وَلَكِنْ كَانُوا أَنْفُسَهُمْ يَظْلِمُونَ"},"next":{"a":120,"text":"إِنَّ إِبْرَاهِيمَ كَانَ أُمَّةً قَانِتًا لِلَّهِ حَنِيفًا وَلَمْ يَكُ مِنَ الْمُشْرِكِينَ"},"reason":"قال السلف: كلُّ من عصى الله فهو جاهلٌ حالَ معصيته — فباب «بجهالة» يسع كل عاصٍ غلبته شهوةٌ أو غفلة. والطريق ثابت: توبةٌ فإصلاح، والاستقبال ثابت: غفورٌ رحيم «من بعدها» مباشرة.","adds":"«بجهالة» ليست عذرَ من لا يعلم فقط — هي وصفُ كل عاصٍ لحظةَ الذنب: فالباب يسعك."},{"i":45,"of":71,"s":24,"surah":"النور","a":5,"text":"إِلَّا الَّذِينَ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":4,"text":"وَالَّذِينَ يَرْمُونَ الْمُحْصَنَاتِ ثُمَّ لَمْ يَأْتُوا بِأَرْبَعَةِ شُهَدَاءَ فَاجْلِدُوهُمْ ثَمَانِينَ جَلْدَةً وَلَا تَقْبَلُوا لَهُمْ شَهَادَةً أَبَدًا وَأُولَئِكَ هُمُ الْفَاسِقُونَ"},"next":{"a":6,"text":"وَالَّذِينَ يَرْمُونَ أَزْوَاجَهُمْ وَلَمْ يَكُنْ لَهُمْ شُهَدَاءُ إِلَّا أَنْفُسُهُمْ فَشَهَادَةُ أَحَدِهِمْ أَرْبَعُ شَهَادَاتٍ بِاللَّهِ إِنَّهُ لَمِنَ الصَّادِقِينَ"},"context":"بعد حد القذف ورد الشهادة والحكم بالفسق: ﴿إِلَّا الَّذِينَ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾.","reason":"القاذفُ المجلود المردودُ الشهادة الموصومُ بالفسق — إن تاب وأصلح رُفع عنه وصفُ الفسق وغُفر له: فالتوبة تعيد الاعتبارَ الديني حتى بعد أشد الوصم الاجتماعي.","adds":"لا وصمة أبدية في الإسلام: حتى «فاسق» ترفعها التوبة والإصلاح."},{"i":46,"of":71,"s":24,"surah":"النور","a":22,"text":"وَلَا يَأْتَلِ أُولُو الْفَضْلِ مِنْكُمْ وَالسَّعَةِ أَنْ يُؤْتُوا أُولِي الْقُرْبَى وَالْمَسَاكِينَ وَالْمُهَاجِرِينَ فِي سَبِيلِ اللَّهِ وَلْيَعْفُوا وَلْيَصْفَحُوا أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللَّهُ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ","prev":{"a":21,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَتَّبِعُوا خُطُوَاتِ الشَّيْطَانِ وَمَنْ يَتَّبِعْ خُطُوَاتِ الشَّيْطَانِ فَإِنَّهُ يَأْمُرُ بِالْفَحْشَاءِ وَالْمُنْكَرِ وَلَوْلَا فَضْلُ اللَّهِ عَلَيْكُمْ وَرَحْمَتُهُ مَا زَكَى مِنْكُمْ مِنْ أَحَدٍ أَبَدًا وَلَكِنَّ اللَّهَ يُزَكِّي مَنْ يَشَاءُ وَاللَّهُ سَمِيعٌ عَلِيمٌ"},"next":{"a":23,"text":"إِنَّ الَّذِينَ يَرْمُونَ الْمُحْصَنَاتِ الْغَافِلَاتِ الْمُؤْمِنَاتِ لُعِنُوا فِي الدُّنْيَا وَالْآخِرَةِ وَلَهُمْ عَذَابٌ عَظِيمٌ"},"context":"أقسم أبو بكرٍ أن يقطع نفقته عن مسطح — قريبه الفقير — لخوضه في إفك عائشة، فنزل: ﴿وَلْيَعْفُوا وَلْيَصْفَحُوا أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللَّهُ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾ — فقال أبو بكر: بلى واللهِ أحبُّ أن يغفر الله لي، وأعاد النفقة (صحيح الترمذي 3180).","reason":"أعظمُ آيةٍ في العفو الشخصي: رجلٌ خاض في عرض ابنتك وأنت تنفق عليه — ومع ذلك: اعفُ واصفح، والثمن معروض: ﴿أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللَّهُ لَكُمْ﴾ — مقايضةٌ ربانية: عفوُك عمّن ظلمك بمغفرته لذنوبك.","adds":"حين يعزّ عليك العفو عمّن جرحك، اسأل نفسك سؤال الآية: ألا تحب أن يغفر الله لك؟ — وأجب جوابَ الصدّيق.","dorar":[{"id":"j8FDRESJ","label":"صحيح الترمذي 3180"}]},{"i":47,"of":71,"s":24,"surah":"النور","a":33,"text":"وَلْيَسْتَعْفِفِ الَّذِينَ لَا يَجِدُونَ نِكَاحًا حَتَّى يُغْنِيَهُمُ اللَّهُ مِنْ فَضْلِهِ وَالَّذِينَ يَبْتَغُونَ الْكِتَابَ مِمَّا مَلَكَتْ أَيْمَانُكُمْ فَكَاتِبُوهُمْ إِنْ عَلِمْتُمْ فِيهِمْ خَيْرًا وَآتُوهُمْ مِنْ مَالِ اللَّهِ الَّذِي آتَاكُمْ وَلَا تُكْرِهُوا فَتَيَاتِكُمْ عَلَى الْبِغَاءِ إِنْ أَرَدْنَ تَحَصُّنًا لِتَبْتَغُوا عَرَضَ الْحَيَاةِ الدُّنْيَا وَمَنْ يُكْرِهْهُنَّ فَإِنَّ اللَّهَ مِنْ بَعْدِ إِكْرَاهِهِنَّ غَفُورٌ رَحِيمٌ","prev":{"a":32,"text":"وَأَنْكِحُوا الْأَيَامَى مِنْكُمْ وَالصَّالِحِينَ مِنْ عِبَادِكُمْ وَإِمَائِكُمْ إِنْ يَكُونُوا فُقَرَاءَ يُغْنِهِمُ اللَّهُ مِنْ فَضْلِهِ وَاللَّهُ وَاسِعٌ عَلِيمٌ"},"next":{"a":34,"text":"وَلَقَدْ أَنْزَلْنَا إِلَيْكُمْ آيَاتٍ مُبَيِّنَاتٍ وَمَثَلًا مِنَ الَّذِينَ خَلَوْا مِنْ قَبْلِكُمْ وَمَوْعِظَةً لِلْمُتَّقِينَ"},"context":"في آية الاستعفاف والمكاتبة، ثم النهي عن إكراه الفتيات على البغاء: ﴿وَمَنْ يُكْرِهْهُنَّ فَإِنَّ اللَّهَ مِنْ بَعْدِ إِكْرَاهِهِنَّ غَفُورٌ رَحِيمٌ﴾.","reason":"المغفرةُ والرحمة هنا للمُكرَهات الضحايا لا للمُكرِه: فالإثم على من أكره، والله من بعد إكراههنّ غفورٌ لهنّ رحيمٌ بانكسارهن — لا تُحمَّل الضحيةُ وزرَ ما أُجبرت عليه.","adds":"قاعدة إنصاف الضحايا: من أُكره على معصيةٍ فالوزر على مُكرِهه — والرحمة لجرحه هو."},{"i":48,"of":71,"s":24,"surah":"النور","a":62,"text":"إِنَّمَا الْمُؤْمِنُونَ الَّذِينَ آمَنُوا بِاللَّهِ وَرَسُولِهِ وَإِذَا كَانُوا مَعَهُ عَلَى أَمْرٍ جَامِعٍ لَمْ يَذْهَبُوا حَتَّى يَسْتَأْذِنُوهُ إِنَّ الَّذِينَ يَسْتَأْذِنُونَكَ أُولَئِكَ الَّذِينَ يُؤْمِنُونَ بِاللَّهِ وَرَسُولِهِ فَإِذَا اسْتَأْذَنُوكَ لِبَعْضِ شَأْنِهِمْ فَأْذَنْ لِمَنْ شِئْتَ مِنْهُمْ وَاسْتَغْفِرْ لَهُمُ اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":61,"text":"لَيْسَ عَلَى الْأَعْمَى حَرَجٌ وَلَا عَلَى الْأَعْرَجِ حَرَجٌ وَلَا عَلَى الْمَرِيضِ حَرَجٌ وَلَا عَلَى أَنْفُسِكُمْ أَنْ تَأْكُلُوا مِنْ بُيُوتِكُمْ أَوْ بُيُوتِ آبَائِكُمْ أَوْ بُيُوتِ أُمَّهَاتِكُمْ أَوْ بُيُوتِ إِخْوَانِكُمْ أَوْ بُيُوتِ أَخَوَاتِكُمْ أَوْ بُيُوتِ أَعْمَامِكُمْ أَوْ بُيُوتِ عَمَّاتِكُمْ أَوْ بُيُوتِ أَخْوَالِكُمْ أَوْ بُيُوتِ خَالَاتِكُمْ أَوْ مَا مَلَكْتُمْ مَفَاتِحَهُ أَوْ صَدِيقِكُمْ لَيْسَ عَلَيْكُمْ جُنَاحٌ أَنْ تَأْكُلُوا جَمِيعًا أَوْ أَشْتَاتًا فَإِذَا دَخَلْتُمْ بُيُوتًا فَسَلِّمُوا عَلَى أَنْفُسِكُمْ تَحِيَّةً مِنْ عِنْدِ اللَّهِ مُبَارَكَةً طَيِّبَةً كَذَلِكَ يُبَيِّنُ اللَّهُ لَكُمُ الْآيَاتِ لَعَلَّكُمْ تَعْقِلُونَ"},"next":{"a":63,"text":"لَا تَجْعَلُوا دُعَاءَ الرَّسُولِ بَيْنَكُمْ كَدُعَاءِ بَعْضِكُمْ بَعْضًا قَدْ يَعْلَمُ اللَّهُ الَّذِينَ يَتَسَلَّلُونَ مِنْكُمْ لِوَاذًا فَلْيَحْذَرِ الَّذِينَ يُخَالِفُونَ عَنْ أَمْرِهِ أَنْ تُصِيبَهُمْ فِتْنَةٌ أَوْ يُصِيبَهُمْ عَذَابٌ أَلِيمٌ"},"context":"في أدب الجماعة: المؤمنون لا يذهبون عن الأمر الجامع حتى يستأذنوا — ﴿فَإِذَا اسْتَأْذَنُوكَ لِبَعْضِ شَأْنِهِمْ فَأْذَنْ لِمَنْ شِئْتَ مِنْهُمْ وَاسْتَغْفِرْ لَهُمُ اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾.","reason":"حتى المستأذنُ بعذرٍ صادق ومعه إذنُ النبي ﷺ — يُستغفر له: فالانصراف عن واجبٍ جماعي، ولو بإذنٍ مشروع، يبقى فيه أثرٌ يجبره الاستغفار. أدبٌ رفيع: الرخصة لا تُلغي الاستغفار.","adds":"إذا اعتذرتَ عن واجبٍ جماعي بعذرٍ صحيح: خذ الرخصة واستغفر — فكمالُ الأدب فوق مجرد الإباحة."},{"i":49,"of":71,"s":25,"surah":"الفرقان","a":6,"text":"قُلْ أَنْزَلَهُ الَّذِي يَعْلَمُ السِّرَّ فِي السَّمَاوَاتِ وَالْأَرْضِ إِنَّهُ كَانَ غَفُورًا رَحِيمًا","prev":{"a":5,"text":"وَقَالُوا أَسَاطِيرُ الْأَوَّلِينَ اكْتَتَبَهَا فَهِيَ تُمْلَى عَلَيْهِ بُكْرَةً وَأَصِيلًا"},"next":{"a":7,"text":"وَقَالُوا مَالِ هَذَا الرَّسُولِ يَأْكُلُ الطَّعَامَ وَيَمْشِي فِي الْأَسْوَاقِ لَوْلَا أُنْزِلَ إِلَيْهِ مَلَكٌ فَيَكُونَ مَعَهُ نَذِيرًا"},"context":"قالوا عن القرآن أساطير الأولين اكتتبها — فجاء الرد: ﴿قُلْ أَنْزَلَهُ الَّذِي يَعْلَمُ السِّرَّ فِي السَّمَاوَاتِ وَالْأَرْضِ إِنَّهُ كَانَ غَفُورًا رَحِيمًا﴾.","reason":"الردُّ على الطعن برهانٌ ثم دعوة: أنزله عالمُ السرّ — فإعجازه من إحاطة علمه — ثم بدل تهديد الطاعنين: ﴿غَفُورًا رَحِيمًا﴾: بابٌ مفتوح لهم رغم بهتانهم. فخصومُ الرسالة يُدعَون قبل أن يُهدَّدوا.","adds":"منهج الرد على من طعن في دينك: حجةٌ قوية وبابٌ مفتوح — لا شتيمةٌ وقطيعة."},{"i":50,"of":71,"s":25,"surah":"الفرقان","a":70,"text":"إِلَّا مَنْ تَابَ وَآمَنَ وَعَمِلَ عَمَلًا صَالِحًا فَأُولَئِكَ يُبَدِّلُ اللَّهُ سَيِّئَاتِهِمْ حَسَنَاتٍ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا","prev":{"a":69,"text":"يُضَاعَفْ لَهُ الْعَذَابُ يَوْمَ الْقِيَامَةِ وَيَخْلُدْ فِيهِ مُهَانًا"},"next":{"a":71,"text":"وَمَنْ تَابَ وَعَمِلَ صَالِحًا فَإِنَّهُ يَتُوبُ إِلَى اللَّهِ مَتَابًا"},"context":"بعد ذكر أعظم ثلاث كبائر — الشرك والقتل والزنى — ووعيد مضاعفة العذاب: ﴿إِلَّا مَنْ تَابَ وَآمَنَ وَعَمِلَ عَمَلًا صَالِحًا فَأُولَئِكَ يُبَدِّلُ اللَّهُ سَيِّئَاتِهِمْ حَسَنَاتٍ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا﴾.","reason":"أعجبُ عطاءٍ في باب المغفرة كله: ليس محوَ السيئات فحسب، بل تبديلها حسنات — صحيفةُ الجرائم تنقلب صحيفةَ أجور — لمن جمع الثلاثة: توبة وإيمان وعمل. وذلك بعد أكبر الكبائر تحديدًا.","adds":"قمة الكرم الإلهي: ماضيك الأسود قد يصبح رصيدَك الأبيض — فالتائب الصادق لا يخسر حتى تاريخه."},{"i":51,"of":71,"s":27,"surah":"النمل","a":11,"text":"إِلَّا مَنْ ظَلَمَ ثُمَّ بَدَّلَ حُسْنًا بَعْدَ سُوءٍ فَإِنِّي غَفُورٌ رَحِيمٌ","prev":{"a":10,"text":"وَأَلْقِ عَصَاكَ فَلَمَّا رَآهَا تَهْتَزُّ كَأَنَّهَا جَانٌّ وَلَّى مُدْبِرًا وَلَمْ يُعَقِّبْ يَا مُوسَى لَا تَخَفْ إِنِّي لَا يَخَافُ لَدَيَّ الْمُرْسَلُونَ"},"next":{"a":12,"text":"وَأَدْخِلْ يَدَكَ فِي جَيْبِكَ تَخْرُجْ بَيْضَاءَ مِنْ غَيْرِ سُوءٍ فِي تِسْعِ آيَاتٍ إِلَى فِرْعَوْنَ وَقَوْمِهِ إِنَّهُمْ كَانُوا قَوْمًا فَاسِقِينَ"},"context":"في الوادي المقدس، خاف موسى من العصا الجانّ: ﴿لَا تَخَفْ إِنِّي لَا يَخَافُ لَدَيَّ الْمُرْسَلُونَ * إِلَّا مَنْ ظَلَمَ ثُمَّ بَدَّلَ حُسْنًا بَعْدَ سُوءٍ فَإِنِّي غَفُورٌ رَحِيمٌ﴾ — وموسى كان قتل نفسًا.","reason":"طمأنةٌ خاصة لموسى الحامل همَّ ذنبه القديم: من بدّل حُسنًا بعد سوءٍ فالخطاب المباشر بضمير المتكلم: ﴿فَإِنِّي غَفُورٌ رَحِيمٌ﴾ — أقربُ صيغ المغفرة وأحناها. فذنبُ الأمس لا يمنع اصطفاءَ اليوم.","adds":"ماضيك لا يعطل مستقبلك عند الله: قاتلُ الأمس صار كليمَ اليوم — فبدّل حُسنًا وامضِ."},{"i":52,"of":71,"s":28,"surah":"القصص","a":16,"text":"قَالَ رَبِّ إِنِّي ظَلَمْتُ نَفْسِي فَاغْفِرْ لِي فَغَفَرَ لَهُ إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ","prev":{"a":15,"text":"وَدَخَلَ الْمَدِينَةَ عَلَى حِينِ غَفْلَةٍ مِنْ أَهْلِهَا فَوَجَدَ فِيهَا رَجُلَيْنِ يَقْتَتِلَانِ هَذَا مِنْ شِيعَتِهِ وَهَذَا مِنْ عَدُوِّهِ فَاسْتَغَاثَهُ الَّذِي مِنْ شِيعَتِهِ عَلَى الَّذِي مِنْ عَدُوِّهِ فَوَكَزَهُ مُوسَى فَقَضَى عَلَيْهِ قَالَ هَذَا مِنْ عَمَلِ الشَّيْطَانِ إِنَّهُ عَدُوٌّ مُضِلٌّ مُبِينٌ"},"next":{"a":17,"text":"قَالَ رَبِّ بِمَا أَنْعَمْتَ عَلَيَّ فَلَنْ أَكُونَ ظَهِيرًا لِلْمُجْرِمِينَ"},"context":"فور قتل موسى للقبطي خطأً: ﴿قَالَ رَبِّ إِنِّي ظَلَمْتُ نَفْسِي فَاغْفِرْ لِي فَغَفَرَ لَهُ إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ﴾.","reason":"أسرعُ توبةٍ وأسرعُ مغفرةٍ موثقتان في القرآن: اعترافٌ فوري ﴿ظَلَمْتُ نَفْسِي﴾ + طلبٌ مباشر ﴿فَاغْفِرْ لِي﴾ — فجاء الجواب بفاء التعقيب: ﴿فَغَفَرَ لَهُ﴾ — بلا فاصل زمني. والحصر: ﴿إِنَّهُ هُوَ﴾.","adds":"نموذج التوبة الفورية: لا تجعل بين الذنب والاستغفار فاصلًا — فالمغفرة تأتي بفاء التعقيب لمن بادر."},{"i":53,"of":71,"s":33,"surah":"الأحزاب","a":5,"text":"ادْعُوهُمْ لِآبَائِهِمْ هُوَ أَقْسَطُ عِنْدَ اللَّهِ فَإِنْ لَمْ تَعْلَمُوا آبَاءَهُمْ فَإِخْوَانُكُمْ فِي الدِّينِ وَمَوَالِيكُمْ وَلَيْسَ عَلَيْكُمْ جُنَاحٌ فِيمَا أَخْطَأْتُمْ بِهِ وَلَكِنْ مَا تَعَمَّدَتْ قُلُوبُكُمْ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا","prev":{"a":4,"text":"مَا جَعَلَ اللَّهُ لِرَجُلٍ مِنْ قَلْبَيْنِ فِي جَوْفِهِ وَمَا جَعَلَ أَزْوَاجَكُمُ اللَّائِي تُظَاهِرُونَ مِنْهُنَّ أُمَّهَاتِكُمْ وَمَا جَعَلَ أَدْعِيَاءَكُمْ أَبْنَاءَكُمْ ذَلِكُمْ قَوْلُكُمْ بِأَفْوَاهِكُمْ وَاللَّهُ يَقُولُ الْحَقَّ وَهُوَ يَهْدِي السَّبِيلَ"},"next":{"a":6,"text":"النَّبِيُّ أَوْلَى بِالْمُؤْمِنِينَ مِنْ أَنْفُسِهِمْ وَأَزْوَاجُهُ أُمَّهَاتُهُمْ وَأُولُو الْأَرْحَامِ بَعْضُهُمْ أَوْلَى بِبَعْضٍ فِي كِتَابِ اللَّهِ مِنَ الْمُؤْمِنِينَ وَالْمُهَاجِرِينَ إِلَّا أَنْ تَفْعَلُوا إِلَى أَوْلِيَائِكُمْ مَعْرُوفًا كَانَ ذَلِكَ فِي الْكِتَابِ مَسْطُورًا"},"context":"بعد الأمر بنسبة الأدعياء لآبائهم الحقيقيين: ﴿وَلَيْسَ عَلَيْكُمْ جُنَاحٌ فِيمَا أَخْطَأْتُمْ بِهِ وَلَكِنْ مَا تَعَمَّدَتْ قُلُوبُكُمْ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا﴾.","reason":"من نادى زيدًا «ابن محمد» سهوًا على العادة القديمة (صحيح البخاري 4782) فلا جناح — فالمؤاخذة بما «تعمّدت القلوب» لا بسبق اللسان. قاعدةٌ ذهبية خُتمت بالاسمين: الخطأ غير المقصود مغفورٌ ابتداءً.","adds":"ميزان المؤاخذة قلبُك لا لسانُك: ما سبق به لسانك بلا قصدٍ مطويٌّ بالمغفرة.","dorar":[{"id":"IUHxdHwS","label":"صحيح البخاري 4782"}]},{"i":54,"of":71,"s":33,"surah":"الأحزاب","a":24,"text":"لِيَجْزِيَ اللَّهُ الصَّادِقِينَ بِصِدْقِهِمْ وَيُعَذِّبَ الْمُنَافِقِينَ إِنْ شَاءَ أَوْ يَتُوبَ عَلَيْهِمْ إِنَّ اللَّهَ كَانَ غَفُورًا رَحِيمًا","prev":{"a":23,"text":"مِنَ الْمُؤْمِنِينَ رِجَالٌ صَدَقُوا مَا عَاهَدُوا اللَّهَ عَلَيْهِ فَمِنْهُمْ مَنْ قَضَى نَحْبَهُ وَمِنْهُمْ مَنْ يَنْتَظِرُ وَمَا بَدَّلُوا تَبْدِيلًا"},"next":{"a":25,"text":"وَرَدَّ اللَّهُ الَّذِينَ كَفَرُوا بِغَيْظِهِمْ لَمْ يَنَالُوا خَيْرًا وَكَفَى اللَّهُ الْمُؤْمِنِينَ الْقِتَالَ وَكَانَ اللَّهُ قَوِيًّا عَزِيزًا"},"context":"في غزوة الأحزاب: ﴿لِيَجْزِيَ اللَّهُ الصَّادِقِينَ بِصِدْقِهِمْ وَيُعَذِّبَ الْمُنَافِقِينَ إِنْ شَاءَ أَوْ يَتُوبَ عَلَيْهِمْ إِنَّ اللَّهَ كَانَ غَفُورًا رَحِيمًا﴾.","reason":"حتى منافقو الأحزاب — المعوّقون الذين سلقوا المؤمنين بألسنةٍ حداد — عُلّق أمرُهم بين العذاب والتوبة: ﴿أَوْ يَتُوبَ عَلَيْهِمْ﴾ — فالباب لم يُغلق حتى في وجه النفاق، والختمُ بالاسمين يرجّح كفة من رجع.","adds":"إذا لم يُغلق الباب في وجه منافقي الأحزاب — فمن ذا الذي يُغلق في وجهه؟"},{"i":55,"of":71,"s":33,"surah":"الأحزاب","a":50,"text":"يَا أَيُّهَا النَّبِيُّ إِنَّا أَحْلَلْنَا لَكَ أَزْوَاجَكَ اللَّاتِي آتَيْتَ أُجُورَهُنَّ وَمَا مَلَكَتْ يَمِينُكَ مِمَّا أَفَاءَ اللَّهُ عَلَيْكَ وَبَنَاتِ عَمِّكَ وَبَنَاتِ عَمَّاتِكَ وَبَنَاتِ خَالِكَ وَبَنَاتِ خَالَاتِكَ اللَّاتِي هَاجَرْنَ مَعَكَ وَامْرَأَةً مُؤْمِنَةً إِنْ وَهَبَتْ نَفْسَهَا لِلنَّبِيِّ إِنْ أَرَادَ النَّبِيُّ أَنْ يَسْتَنْكِحَهَا خَالِصَةً لَكَ مِنْ دُونِ الْمُؤْمِنِينَ قَدْ عَلِمْنَا مَا فَرَضْنَا عَلَيْهِمْ فِي أَزْوَاجِهِمْ وَمَا مَلَكَتْ أَيْمَانُهُمْ لِكَيْلَا يَكُونَ عَلَيْكَ حَرَجٌ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا","prev":{"a":49,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا نَكَحْتُمُ الْمُؤْمِنَاتِ ثُمَّ طَلَّقْتُمُوهُنَّ مِنْ قَبْلِ أَنْ تَمَسُّوهُنَّ فَمَا لَكُمْ عَلَيْهِنَّ مِنْ عِدَّةٍ تَعْتَدُّونَهَا فَمَتِّعُوهُنَّ وَسَرِّحُوهُنَّ سَرَاحًا جَمِيلًا"},"next":{"a":51,"text":"تُرْجِي مَنْ تَشَاءُ مِنْهُنَّ وَتُؤْوِي إِلَيْكَ مَنْ تَشَاءُ وَمَنِ ابْتَغَيْتَ مِمَّنْ عَزَلْتَ فَلَا جُنَاحَ عَلَيْكَ ذَلِكَ أَدْنَى أَنْ تَقَرَّ أَعْيُنُهُنَّ وَلَا يَحْزَنَّ وَيَرْضَيْنَ بِمَا آتَيْتَهُنَّ كُلُّهُنَّ وَاللَّهُ يَعْلَمُ مَا فِي قُلُوبِكُمْ وَكَانَ اللَّهُ عَلِيمًا حَلِيمًا"},"context":"في تنظيم ما أحلّ الله لنبيه ﷺ من أزواجه: ﴿...لِكَيْلَا يَكُونَ عَلَيْكَ حَرَجٌ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا﴾.","reason":"عُلّلت التوسعة على النبي ﷺ برفع الحرج عنه — فحتى خصوصياتُ النبوة شُرعت بميزان الرحمة ورفع المشقة، والاسمان يظللان التشريع الخاص كما يظللان العام.","adds":"رفع الحرج مقصدٌ شرعي ثابت — من خصوصيات النبي ﷺ إلى عموم أمته."},{"i":56,"of":71,"s":33,"surah":"الأحزاب","a":59,"text":"يَا أَيُّهَا النَّبِيُّ قُلْ لِأَزْوَاجِكَ وَبَنَاتِكَ وَنِسَاءِ الْمُؤْمِنِينَ يُدْنِينَ عَلَيْهِنَّ مِنْ جَلَابِيبِهِنَّ ذَلِكَ أَدْنَى أَنْ يُعْرَفْنَ فَلَا يُؤْذَيْنَ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا","prev":{"a":58,"text":"وَالَّذِينَ يُؤْذُونَ الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ بِغَيْرِ مَا اكْتَسَبُوا فَقَدِ احْتَمَلُوا بُهْتَانًا وَإِثْمًا مُبِينًا"},"next":{"a":60,"text":"لَئِنْ لَمْ يَنْتَهِ الْمُنَافِقُونَ وَالَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ وَالْمُرْجِفُونَ فِي الْمَدِينَةِ لَنُغْرِيَنَّكَ بِهِمْ ثُمَّ لَا يُجَاوِرُونَكَ فِيهَا إِلَّا قَلِيلًا"},"context":"آية الجلباب: ﴿يُدْنِينَ عَلَيْهِنَّ مِنْ جَلَابِيبِهِنَّ ذَلِكَ أَدْنَى أَنْ يُعْرَفْنَ فَلَا يُؤْذَيْنَ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا﴾.","reason":"عُلّل تشريع الجلباب بالحماية: ﴿أَدْنَى أَنْ يُعْرَفْنَ فَلَا يُؤْذَيْنَ﴾ — فهو درعٌ لا قيد. والختم بالاسمين: مغفرةٌ لما كان قبل الأمر، ورحمةٌ هي روحُ التشريع الحامي نفسه.","adds":"أحكام اللباس في القرآن معلّلة بالحماية والرحمة — فالحجاب تكريمٌ مُعلَّل لا تضييق."},{"i":57,"of":71,"s":33,"surah":"الأحزاب","a":73,"text":"لِيُعَذِّبَ اللَّهُ الْمُنَافِقِينَ وَالْمُنَافِقَاتِ وَالْمُشْرِكِينَ وَالْمُشْرِكَاتِ وَيَتُوبَ اللَّهُ عَلَى الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا","prev":{"a":72,"text":"إِنَّا عَرَضْنَا الْأَمَانَةَ عَلَى السَّمَاوَاتِ وَالْأَرْضِ وَالْجِبَالِ فَأَبَيْنَ أَنْ يَحْمِلْنَهَا وَأَشْفَقْنَ مِنْهَا وَحَمَلَهَا الْإِنْسَانُ إِنَّهُ كَانَ ظَلُومًا جَهُولًا"},"context":"خاتمة آية الأمانة التي أشفقت منها السماوات والجبال وحملها الإنسان: ﴿لِيُعَذِّبَ اللَّهُ الْمُنَافِقِينَ وَالْمُنَافِقَاتِ وَالْمُشْرِكِينَ وَالْمُشْرِكَاتِ وَيَتُوبَ اللَّهُ عَلَى الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا﴾.","reason":"حمل الإنسانُ الأمانة ﴿ظَلُومًا جَهُولًا﴾ — لكن العاقبة فرّقت: عذابٌ لأهل الخيانة (نفاقًا وشركًا)، وتوبةٌ من الله على المؤمنين والمؤمنات نصًّا بالجنسين. فضعفُ الحامل يجبره بابُ التوبة لمن أدّى بإيمان.","adds":"حملتَ أمانةً أثقل من الجبال وأنت ظلوم جهول — لكن مؤمنًا: فختامُ حملك ﴿وَيَتُوبَ اللَّهُ عَلَى الْمُؤْمِنِينَ﴾."},{"i":58,"of":71,"s":39,"surah":"الزمر","a":53,"text":"قُلْ يَا عِبَادِيَ الَّذِينَ أَسْرَفُوا عَلَى أَنْفُسِهِمْ لَا تَقْنَطُوا مِنْ رَحْمَةِ اللَّهِ إِنَّ اللَّهَ يَغْفِرُ الذُّنُوبَ جَمِيعًا إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ","prev":{"a":52,"text":"أَوَلَمْ يَعْلَمُوا أَنَّ اللَّهَ يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ وَيَقْدِرُ إِنَّ فِي ذَلِكَ لَآيَاتٍ لِقَوْمٍ يُؤْمِنُونَ"},"next":{"a":54,"text":"وَأَنِيبُوا إِلَى رَبِّكُمْ وَأَسْلِمُوا لَهُ مِنْ قَبْلِ أَنْ يَأْتِيَكُمُ الْعَذَابُ ثُمَّ لَا تُنْصَرُونَ"},"context":"﴿قُلْ يَا عِبَادِيَ الَّذِينَ أَسْرَفُوا عَلَى أَنْفُسِهِمْ لَا تَقْنَطُوا مِنْ رَحْمَةِ اللَّهِ إِنَّ اللَّهَ يَغْفِرُ الذُّنُوبَ جَمِيعًا إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ﴾ — نزلت في قومٍ أثقلتهم كبائرُهم: «قَتَلوا فأكثَروا، وزَنَوا فأكثَروا» ثم سألوا هل لما عملوا كفارة (صحيح مسلم 122).","reason":"أرجى آيةٍ في كتاب الله عند عبد الله بن عمرو (المستدرك على الصحيحين 199): نداءُ ﴿يَا عِبَادِيَ﴾ موجّهٌ للمسرفين أنفسهم — لم يتبرأ منهم بل نسبهم إليه — ونهيٌ صريح عن القنوط، وعمومٌ قاطع: ﴿يَغْفِرُ الذُّنُوبَ جَمِيعًا﴾ لمن تاب، وحصرٌ مؤكد: ﴿إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ﴾.","adds":"احفظ هذه الآية لأحلك ساعاتك وأظلمها — فمهما فعلتَ، فأنت عند الله «عبادي»، والقنوطُ هو الممنوع الوحيد.","dorar":[{"id":"W4Mk137U","label":"صحيح مسلم 122"},{"id":"v8DtwDQo","label":"المستدرك على الصحيحين 199"}]},{"i":59,"of":71,"s":41,"surah":"فصلت","a":32,"text":"نُزُلًا مِنْ غَفُورٍ رَحِيمٍ","prev":{"a":31,"text":"نَحْنُ أَوْلِيَاؤُكُمْ فِي الْحَيَاةِ الدُّنْيَا وَفِي الْآخِرَةِ وَلَكُمْ فِيهَا مَا تَشْتَهِي أَنْفُسُكُمْ وَلَكُمْ فِيهَا مَا تَدَّعُونَ"},"next":{"a":33,"text":"وَمَنْ أَحْسَنُ قَوْلًا مِمَّنْ دَعَا إِلَى اللَّهِ وَعَمِلَ صَالِحًا وَقَالَ إِنَّنِي مِنَ الْمُسْلِمِينَ"},"context":"بشرى المستقيمين عند الموت: ﴿تَتَنَزَّلُ عَلَيْهِمُ الْمَلَائِكَةُ أَلَّا تَخَافُوا وَلَا تَحْزَنُوا وَأَبْشِرُوا بِالْجَنَّةِ... نُزُلًا مِنْ غَفُورٍ رَحِيمٍ﴾.","reason":"سُمّيت الجنةُ وضيافتُها ﴿نُزُلًا﴾ — عطاءَ ضيافةٍ مُعدًّا للنازل — من ﴿غَفُورٍ رَحِيمٍ﴾: فأولُ أسباب دخولها مغفرةٌ تُسقط الذنوب ورحمةٌ تُدخل الجنة — لا استحقاقُ العمل وحده. فالمضيفُ عرّف نفسه في بطاقة الدعوة باسمَي المغفرة والرحمة.","adds":"بطاقةُ الضيافة الأخيرة موقّعة: «نُزلًا من غفورٍ رحيم» — فاستقم يتنزّل عليك حاملوها عند الرحيل."},{"i":60,"of":71,"s":42,"surah":"الشورى","a":5,"text":"تَكَادُ السَّمَاوَاتُ يَتَفَطَّرْنَ مِنْ فَوْقِهِنَّ وَالْمَلَائِكَةُ يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ وَيَسْتَغْفِرُونَ لِمَنْ فِي الْأَرْضِ أَلَا إِنَّ اللَّهَ هُوَ الْغَفُورُ الرَّحِيمُ","prev":{"a":4,"text":"لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَهُوَ الْعَلِيُّ الْعَظِيمُ"},"next":{"a":6,"text":"وَالَّذِينَ اتَّخَذُوا مِنْ دُونِهِ أَوْلِيَاءَ اللَّهُ حَفِيظٌ عَلَيْهِمْ وَمَا أَنْتَ عَلَيْهِمْ بِوَكِيلٍ"},"reason":"بين تفطّر السماوات من عظمته والملائكةِ المسبّحة، عملٌ ملائكي عجيب: ﴿يَسْتَغْفِرُونَ لِمَنْ فِي الْأَرْضِ﴾ — لأهل الأرض عمومًا. فلك في السماء مستغفرون لا تعرفهم، والختمُ بأداة التنبيه: ﴿أَلَا إِنَّ اللَّهَ هُوَ الْغَفُورُ الرَّحِيمُ﴾ — إعلانٌ يستوقف.","adds":"في هذه اللحظة ملائكةٌ تستغفر لك وأنت لا تدري — فلا تكن أزهدَ في مغفرته من ملائكةٍ تسألها لغيرها."},{"i":61,"of":71,"s":46,"surah":"الأحقاف","a":8,"text":"أَمْ يَقُولُونَ افْتَرَاهُ قُلْ إِنِ افْتَرَيْتُهُ فَلَا تَمْلِكُونَ لِي مِنَ اللَّهِ شَيْئًا هُوَ أَعْلَمُ بِمَا تُفِيضُونَ فِيهِ كَفَى بِهِ شَهِيدًا بَيْنِي وَبَيْنَكُمْ وَهُوَ الْغَفُورُ الرَّحِيمُ","prev":{"a":7,"text":"وَإِذَا تُتْلَى عَلَيْهِمْ آيَاتُنَا بَيِّنَاتٍ قَالَ الَّذِينَ كَفَرُوا لِلْحَقِّ لَمَّا جَاءَهُمْ هَذَا سِحْرٌ مُبِينٌ"},"next":{"a":9,"text":"قُلْ مَا كُنْتُ بِدْعًا مِنَ الرُّسُلِ وَمَا أَدْرِي مَا يُفْعَلُ بِي وَلَا بِكُمْ إِنْ أَتَّبِعُ إِلَّا مَا يُوحَى إِلَيَّ وَمَا أَنَا إِلَّا نَذِيرٌ مُبِينٌ"},"context":"اتهموه بالافتراء: ﴿أَمْ يَقُولُونَ افْتَرَاهُ قُلْ إِنِ افْتَرَيْتُهُ فَلَا تَمْلِكُونَ لِي مِنَ اللَّهِ شَيْئًا... كَفَى بِهِ شَهِيدًا بَيْنِي وَبَيْنَكُمْ وَهُوَ الْغَفُورُ الرَّحِيمُ﴾.","reason":"احتكم النبيُّ ﷺ إلى شهادة الله على صدقه — ثم خُتم الرد بالاسمين: فالمتهِمون الطاعنون أنفسُهم مدعوّون إلى باب الغفور الرحيم. ردُّ التهمة وفتحُ الباب في جملة واحدة — هذا أدبُ البريء الواثق.","adds":"إذا اتُّهمتَ ظلمًا: اجعل الله شهيدك، وأبقِ للمتّهِمين بابَ الرجوع — فقد يصيرون إخوتك."},{"i":62,"of":71,"s":48,"surah":"الفتح","a":14,"text":"وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ يَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا","prev":{"a":13,"text":"وَمَنْ لَمْ يُؤْمِنْ بِاللَّهِ وَرَسُولِهِ فَإِنَّا أَعْتَدْنَا لِلْكَافِرِينَ سَعِيرًا"},"next":{"a":15,"text":"سَيَقُولُ الْمُخَلَّفُونَ إِذَا انْطَلَقْتُمْ إِلَى مَغَانِمَ لِتَأْخُذُوهَا ذَرُونَا نَتَّبِعْكُمْ يُرِيدُونَ أَنْ يُبَدِّلُوا كَلَامَ اللَّهِ قُلْ لَنْ تَتَّبِعُونَا كَذَلِكُمْ قَالَ اللَّهُ مِنْ قَبْلُ فَسَيَقُولُونَ بَلْ تَحْسُدُونَنَا بَلْ كَانُوا لَا يَفْقَهُونَ إِلَّا قَلِيلًا"},"reason":"المغفرةُ والتعذيب تصرّفُ مالكٍ في ملكه لا يُسأل عما يفعل — لكن لاحظ: قدّم ﴿يَغْفِرُ﴾ على ﴿يُعَذِّبُ﴾ وختم بالغفور الرحيم: فالبدايةُ مغفرة والنهايةُ رحمة، والعذاب محفوفٌ بينهما لمن أبى.","adds":"حين تُذكر المشيئة المطلقة، تُقدَّم المغفرة وتُختم الرحمة — فافهم ميلَ الميزان."},{"i":63,"of":71,"s":49,"surah":"الحجرات","a":5,"text":"وَلَوْ أَنَّهُمْ صَبَرُوا حَتَّى تَخْرُجَ إِلَيْهِمْ لَكَانَ خَيْرًا لَهُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ","prev":{"a":4,"text":"إِنَّ الَّذِينَ يُنَادُونَكَ مِنْ وَرَاءِ الْحُجُرَاتِ أَكْثَرُهُمْ لَا يَعْقِلُونَ"},"next":{"a":6,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ جَاءَكُمْ فَاسِقٌ بِنَبَإٍ فَتَبَيَّنُوا أَنْ تُصِيبُوا قَوْمًا بِجَهَالَةٍ فَتُصْبِحُوا عَلَى مَا فَعَلْتُمْ نَادِمِينَ"},"context":"في الذين نادوا النبيَّ ﷺ من وراء الحجرات بجفاء: ﴿وَلَوْ أَنَّهُمْ صَبَرُوا حَتَّى تَخْرُجَ إِلَيْهِمْ لَكَانَ خَيْرًا لَهُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾.","reason":"أعرابٌ جفاةٌ صاحوا بالنبي من وراء حجراته — فعُلّموا الأدبَ بلطف: ﴿لَكَانَ خَيْرًا لَهُمْ﴾، وخُتم بالاسمين: فسوءُ الأدب الصادر عن جهلٍ لا خبث يُعالج بالتعليم والمغفرة، لا بالطرد والتشهير.","adds":"من أساء إليك أدبًا عن جهلٍ لا عن خبث: علّمه واغفر — فهكذا عومل الجفاة مع سيد الخلق."},{"i":64,"of":71,"s":49,"surah":"الحجرات","a":14,"text":"قَالَتِ الْأَعْرَابُ آمَنَّا قُلْ لَمْ تُؤْمِنُوا وَلَكِنْ قُولُوا أَسْلَمْنَا وَلَمَّا يَدْخُلِ الْإِيمَانُ فِي قُلُوبِكُمْ وَإِنْ تُطِيعُوا اللَّهَ وَرَسُولَهُ لَا يَلِتْكُمْ مِنْ أَعْمَالِكُمْ شَيْئًا إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":13,"text":"يَا أَيُّهَا النَّاسُ إِنَّا خَلَقْنَاكُمْ مِنْ ذَكَرٍ وَأُنْثَى وَجَعَلْنَاكُمْ شُعُوبًا وَقَبَائِلَ لِتَعَارَفُوا إِنَّ أَكْرَمَكُمْ عِنْدَ اللَّهِ أَتْقَاكُمْ إِنَّ اللَّهَ عَلِيمٌ خَبِيرٌ"},"next":{"a":15,"text":"إِنَّمَا الْمُؤْمِنُونَ الَّذِينَ آمَنُوا بِاللَّهِ وَرَسُولِهِ ثُمَّ لَمْ يَرْتَابُوا وَجَاهَدُوا بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ فِي سَبِيلِ اللَّهِ أُولَئِكَ هُمُ الصَّادِقُونَ"},"reason":"صُححت دعوى الأعراب بلا تنفير: لم يُقل «كذبتم» بل ﴿قُولُوا أَسْلَمْنَا﴾ — توصيفٌ دقيق لمرحلتهم مع فتح الطريق: أطيعوا ولن يُنقَص من أعمالكم شيء ﴿لَا يَلِتْكُمْ﴾. فالغفور الرحيم يقبل السائرين من أول درجات السلّم.","adds":"من كان في أول الطريق فلا يُحبَط ولا يُحتقر: «أسلمنا» بدايةٌ مقبولة — والإيمان يدخل القلب بالطاعة تدريجًا."},{"i":65,"of":71,"s":57,"surah":"الحديد","a":28,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَآمِنُوا بِرَسُولِهِ يُؤْتِكُمْ كِفْلَيْنِ مِنْ رَحْمَتِهِ وَيَجْعَلْ لَكُمْ نُورًا تَمْشُونَ بِهِ وَيَغْفِرْ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ","prev":{"a":27,"text":"ثُمَّ قَفَّيْنَا عَلَى آثَارِهِمْ بِرُسُلِنَا وَقَفَّيْنَا بِعِيسَى ابْنِ مَرْيَمَ وَآتَيْنَاهُ الْإِنْجِيلَ وَجَعَلْنَا فِي قُلُوبِ الَّذِينَ اتَّبَعُوهُ رَأْفَةً وَرَحْمَةً وَرَهْبَانِيَّةً ابْتَدَعُوهَا مَا كَتَبْنَاهَا عَلَيْهِمْ إِلَّا ابْتِغَاءَ رِضْوَانِ اللَّهِ فَمَا رَعَوْهَا حَقَّ رِعَايَتِهَا فَآتَيْنَا الَّذِينَ آمَنُوا مِنْهُمْ أَجْرَهُمْ وَكَثِيرٌ مِنْهُمْ فَاسِقُونَ"},"next":{"a":29,"text":"لِئَلَّا يَعْلَمَ أَهْلُ الْكِتَابِ أَلَّا يَقْدِرُونَ عَلَى شَيْءٍ مِنْ فَضْلِ اللَّهِ وَأَنَّ الْفَضْلَ بِيَدِ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ"},"reason":"ثلاثُ عطايا لمن جمع التقوى والإيمان بالرسول ﷺ: كِفلان (نصيبان مضاعفان) من الرحمة، ونورٌ يُمشى به في الظلمات، ومغفرة — وخُتمت بالمصدر: ﴿وَاللَّهُ غَفُورٌ رَحِيمٌ﴾. فمن جاء من أهل كتابٍ سابق فآمن، ضُوعف أجره لسعيه مرتين.","adds":"عطاء الله يتضاعف ولا يضيق: من صدق في مرحلةٍ ثم اهتدى لأكمل منها أُجر عليهما معًا."},{"i":66,"of":71,"s":58,"surah":"المجادلة","a":12,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا نَاجَيْتُمُ الرَّسُولَ فَقَدِّمُوا بَيْنَ يَدَيْ نَجْوَاكُمْ صَدَقَةً ذَلِكَ خَيْرٌ لَكُمْ وَأَطْهَرُ فَإِنْ لَمْ تَجِدُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":11,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا قِيلَ لَكُمْ تَفَسَّحُوا فِي الْمَجَالِسِ فَافْسَحُوا يَفْسَحِ اللَّهُ لَكُمْ وَإِذَا قِيلَ انْشُزُوا فَانْشُزُوا يَرْفَعِ اللَّهُ الَّذِينَ آمَنُوا مِنْكُمْ وَالَّذِينَ أُوتُوا الْعِلْمَ دَرَجَاتٍ وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ"},"next":{"a":13,"text":"أَأَشْفَقْتُمْ أَنْ تُقَدِّمُوا بَيْنَ يَدَيْ نَجْوَاكُمْ صَدَقَاتٍ فَإِذْ لَمْ تَفْعَلُوا وَتَابَ اللَّهُ عَلَيْكُمْ فَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ وَأَطِيعُوا اللَّهَ وَرَسُولَهُ وَاللَّهُ خَبِيرٌ بِمَا تَعْمَلُونَ"},"context":"في أدب مناجاة الرسول ﷺ: ﴿فَقَدِّمُوا بَيْنَ يَدَيْ نَجْوَاكُمْ صَدَقَةً ذَلِكَ خَيْرٌ لَكُمْ وَأَطْهَرُ فَإِنْ لَمْ تَجِدُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾.","reason":"شُرعت صدقةُ النجوى تطهيرًا وتوقيرًا — لكن من لم يجد لم يُحرم من مناجاة النبي: ﴿فَإِنْ لَمْ تَجِدُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — فالفقرُ لا يحجب عن القرب، والرخصة جاهزة قبل أن يسألها المعدم.","adds":"لا يحجبك ضيقُ ذات اليد عن بابٍ من أبواب الخير — فالرخصة مكتوبة لك سلفًا."},{"i":67,"of":71,"s":60,"surah":"الممتحنة","a":7,"text":"عَسَى اللَّهُ أَنْ يَجْعَلَ بَيْنَكُمْ وَبَيْنَ الَّذِينَ عَادَيْتُمْ مِنْهُمْ مَوَدَّةً وَاللَّهُ قَدِيرٌ وَاللَّهُ غَفُورٌ رَحِيمٌ","prev":{"a":6,"text":"لَقَدْ كَانَ لَكُمْ فِيهِمْ أُسْوَةٌ حَسَنَةٌ لِمَنْ كَانَ يَرْجُو اللَّهَ وَالْيَوْمَ الْآخِرَ وَمَنْ يَتَوَلَّ فَإِنَّ اللَّهَ هُوَ الْغَنِيُّ الْحَمِيدُ"},"next":{"a":8,"text":"لَا يَنْهَاكُمُ اللَّهُ عَنِ الَّذِينَ لَمْ يُقَاتِلُوكُمْ فِي الدِّينِ وَلَمْ يُخْرِجُوكُمْ مِنْ دِيَارِكُمْ أَنْ تَبَرُّوهُمْ وَتُقْسِطُوا إِلَيْهِمْ إِنَّ اللَّهَ يُحِبُّ الْمُقْسِطِينَ"},"context":"بعد أحكام البراءة من المشركين المحاربين: ﴿عَسَى اللَّهُ أَنْ يَجْعَلَ بَيْنَكُمْ وَبَيْنَ الَّذِينَ عَادَيْتُمْ مِنْهُمْ مَوَدَّةً وَاللَّهُ قَدِيرٌ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾.","reason":"وعدٌ بقلب العداوة مودة — وقد تحقق بإسلام كبار محاربي الأمس وصاروا إخوة — فالقدير يقلّب القلوب، والغفور الرحيم يمحو ماضي العداوة كلَّه كأن لم يكن. فلا يُعامَل عدوُّ اليوم كأنه عدو الأبد.","adds":"اترك في كل خصومةٍ موضعًا للمصالحة — فالذي بينك وبينه عداوةٌ قد يجعل الله بينكما مودة."},{"i":68,"of":71,"s":60,"surah":"الممتحنة","a":12,"text":"يَا أَيُّهَا النَّبِيُّ إِذَا جَاءَكَ الْمُؤْمِنَاتُ يُبَايِعْنَكَ عَلَى أَنْ لَا يُشْرِكْنَ بِاللَّهِ شَيْئًا وَلَا يَسْرِقْنَ وَلَا يَزْنِينَ وَلَا يَقْتُلْنَ أَوْلَادَهُنَّ وَلَا يَأْتِينَ بِبُهْتَانٍ يَفْتَرِينَهُ بَيْنَ أَيْدِيهِنَّ وَأَرْجُلِهِنَّ وَلَا يَعْصِينَكَ فِي مَعْرُوفٍ فَبَايِعْهُنَّ وَاسْتَغْفِرْ لَهُنَّ اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":11,"text":"وَإِنْ فَاتَكُمْ شَيْءٌ مِنْ أَزْوَاجِكُمْ إِلَى الْكُفَّارِ فَعَاقَبْتُمْ فَآتُوا الَّذِينَ ذَهَبَتْ أَزْوَاجُهُمْ مِثْلَ مَا أَنْفَقُوا وَاتَّقُوا اللَّهَ الَّذِي أَنْتُمْ بِهِ مُؤْمِنُونَ"},"next":{"a":13,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَتَوَلَّوْا قَوْمًا غَضِبَ اللَّهُ عَلَيْهِمْ قَدْ يَئِسُوا مِنَ الْآخِرَةِ كَمَا يَئِسَ الْكُفَّارُ مِنْ أَصْحَابِ الْقُبُورِ"},"context":"بيعة المؤمنات: ﴿إِذَا جَاءَكَ الْمُؤْمِنَاتُ يُبَايِعْنَكَ عَلَى أَنْ لَا يُشْرِكْنَ بِاللَّهِ شَيْئًا وَلَا يَسْرِقْنَ وَلَا يَزْنِينَ... فَبَايِعْهُنَّ وَاسْتَغْفِرْ لَهُنَّ اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾.","reason":"أُمر النبي ﷺ أن يبايع المؤمنات القادمات من الجاهلية ويستغفر لهن: فصفحةُ الماضي كلُّها — بما فيها من شركٍ وذنوب — تُطوى ببيعةٍ واستغفار، وتُفتتح الصفحة الجديدة بالمغفرة لا بالمحاسبة على ما مضى.","adds":"من دخل في التوبة والعهد الجديد فماضيه مطويّ — فلا تُذكّر أحدًا بجاهليته."},{"i":69,"of":71,"s":64,"surah":"التغابن","a":14,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنَّ مِنْ أَزْوَاجِكُمْ وَأَوْلَادِكُمْ عَدُوًّا لَكُمْ فَاحْذَرُوهُمْ وَإِنْ تَعْفُوا وَتَصْفَحُوا وَتَغْفِرُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":13,"text":"اللَّهُ لَا إِلَهَ إِلَّا هُوَ وَعَلَى اللَّهِ فَلْيَتَوَكَّلِ الْمُؤْمِنُونَ"},"next":{"a":15,"text":"إِنَّمَا أَمْوَالُكُمْ وَأَوْلَادُكُمْ فِتْنَةٌ وَاللَّهُ عِنْدَهُ أَجْرٌ عَظِيمٌ"},"context":"﴿يَا أَيُّهَا الَّذِينَ آمَنُوا إِنَّ مِنْ أَزْوَاجِكُمْ وَأَوْلَادِكُمْ عَدُوًّا لَكُمْ فَاحْذَرُوهُمْ وَإِنْ تَعْفُوا وَتَصْفَحُوا وَتَغْفِرُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — نزلت فيمن ثبّطهم أهلوهم عن الهجرة.","reason":"قد يصدّك أقربُ الناس — زوجٌ أو ولد — عن الخير: فاحذر، لكنّ العلاج المأمور ثلاث درجات: عفوٌ (ترك المؤاخذة) فصفحٌ (طيّ الأمر) فغفران (محوُ الأثر من القلب) — والجزاء من جنس العمل: ﴿فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾.","adds":"التخلق بالاسم يبدأ داخل بيتك: اغفر لأهلك ما جنوه عليك في دينك ودنياك — يغفر الله لك.","dorar":[{"id":"iYMqJvy1","label":"المستدرك على الصحيحين 3860"},{"id":"TwZefY3J","label":"الأحاديث المختارة 12 / 49"}]},{"i":70,"of":71,"s":66,"surah":"التحريم","a":1,"text":"يَا أَيُّهَا النَّبِيُّ لِمَ تُحَرِّمُ مَا أَحَلَّ اللَّهُ لَكَ تَبْتَغِي مَرْضَاتَ أَزْوَاجِكَ وَاللَّهُ غَفُورٌ رَحِيمٌ","next":{"a":2,"text":"قَدْ فَرَضَ اللَّهُ لَكُمْ تَحِلَّةَ أَيْمَانِكُمْ وَاللَّهُ مَوْلَاكُمْ وَهُوَ الْعَلِيمُ الْحَكِيمُ"},"context":"﴿يَا أَيُّهَا النَّبِيُّ لِمَ تُحَرِّمُ مَا أَحَلَّ اللَّهُ لَكَ تَبْتَغِي مَرْضَاتَ أَزْوَاجِكَ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾ — حرّم النبي ﷺ على نفسه ما أحلّ الله إرضاءً لبعض أزواجه.","reason":"عتابٌ للحبيب ﷺ مقرونٌ في الجملة نفسها بالمغفرة والرحمة: فحتى العتابُ الإلهي لأحبّ الخلق إليه محفوفٌ بالاسمين سلفًا — عتابُ من يريد التقويم لا التجريح.","adds":"تعلّم كيف تعاتب من تحب: سمِّ الخطأ بوضوح، ولفّه بالمغفرة قبل أن تنطق — كما عاتب الغفورُ الرحيم نبيَّه."},{"i":71,"of":71,"s":73,"surah":"المزمل","a":20,"text":"إِنَّ رَبَّكَ يَعْلَمُ أَنَّكَ تَقُومُ أَدْنَى مِنْ ثُلُثَيِ اللَّيْلِ وَنِصْفَهُ وَثُلُثَهُ وَطَائِفَةٌ مِنَ الَّذِينَ مَعَكَ وَاللَّهُ يُقَدِّرُ اللَّيْلَ وَالنَّهَارَ عَلِمَ أَنْ لَنْ تُحْصُوهُ فَتَابَ عَلَيْكُمْ فَاقْرَءُوا مَا تَيَسَّرَ مِنَ الْقُرْآنِ عَلِمَ أَنْ سَيَكُونُ مِنْكُمْ مَرْضَى وَآخَرُونَ يَضْرِبُونَ فِي الْأَرْضِ يَبْتَغُونَ مِنْ فَضْلِ اللَّهِ وَآخَرُونَ يُقَاتِلُونَ فِي سَبِيلِ اللَّهِ فَاقْرَءُوا مَا تَيَسَّرَ مِنْهُ وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ وَأَقْرِضُوا اللَّهَ قَرْضًا حَسَنًا وَمَا تُقَدِّمُوا لِأَنْفُسِكُمْ مِنْ خَيْرٍ تَجِدُوهُ عِنْدَ اللَّهِ هُوَ خَيْرًا وَأَعْظَمَ أَجْرًا وَاسْتَغْفِرُوا اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","prev":{"a":19,"text":"إِنَّ هَذِهِ تَذْكِرَةٌ فَمَنْ شَاءَ اتَّخَذَ إِلَى رَبِّهِ سَبِيلًا"},"context":"خاتمة سورة قيام الليل: ﴿إِنَّ رَبَّكَ يَعْلَمُ أَنَّكَ تَقُومُ أَدْنَى مِنْ ثُلُثَيِ اللَّيْلِ... عَلِمَ أَنْ لَنْ تُحْصُوهُ فَتَابَ عَلَيْكُمْ فَاقْرَءُوا مَا تَيَسَّرَ مِنَ الْقُرْآنِ... وَاسْتَغْفِرُوا اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾.","reason":"خفّف قيامَ الليل عن الأمة لعلمه بالمرضى والضاربين في الأرض والمقاتلين: ﴿عَلِمَ أَنْ لَنْ تُحْصُوهُ فَتَابَ عَلَيْكُمْ﴾ — تخفيفٌ سُمّي توبةً منه علينا. وآخرُ كلمةٍ في سورة القيام كله: ﴿وَاسْتَغْفِرُوا اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾.","adds":"اعبده بما تطيق وداوم — واختم عبادتك المخففة بالاستغفار: فالمخفِّفُ عنك هو الغفور الرحيم نفسه."}],"hadiths":[{"i":1,"of":33,"text":"«لَمَّا كاتَبَ سُهَيلُ بنُ عَمرٍو يَومَئذٍ كان فيما اشتَرَطَ سُهَيلُ بنُ عَمرٍو على النَّبيِّ صلَّى اللهُ عليه وسلَّم: أنَّه لا يَأتيك مِنَّا أحَدٌ وإن كان على دينِك، إلَّا رَدَدتَه إلينا، وخَلَّيتَ بينَنا وبينَه، فكَرِهَ المُؤمِنونَ ذلك وامتَعَضوا منه، وأبى سُهَيلٌ إلَّا ذلك، فكاتَبَه النَّبيُّ صلَّى اللهُ عليه وسلَّم على ذلك، فرَدَّ يَومَئذٍ أبا جَندَلٍ إلى أبيه سُهَيلِ بنِ عَمرٍو، ولم يَأتِه أحَدٌ مِنَ الرِّجالِ إلَّا رَدَّه في تلك المُدَّةِ وإن كان مُسلِمًا، وجاءَتِ المُؤمِناتُ مُهاجِراتٍ، وكانَت أُمُّ كُلثومٍ بنتُ عُقبةَ بنِ أبي مُعَيطٍ مِمَّن خَرَجَ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم يَومَئذٍ، وهي عاتِقٌ، فجاءَ أهلُها يَسألونَ النَّبيَّ صلَّى اللهُ عليه وسلَّم أن يَرجِعَها إليهم، فلَم يَرجِعْها إليهم، لمَّا أنزَلَ اللهُ فيهنَّ: {إذا جاءَكُمُ المُؤمِناتُ مُهاجِراتٍ فامتَحِنوهُنَّ اللهُ أعلَمُ بِإيمانِهنَّ} إلى قَولِه: {ولا هم يَحِلُّونَ لَهنَّ} [الممتحنة: 10]. قال عُروةُ: فأخبَرَتني عائِشةُ أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم كان يَمتَحِنُهنَّ بهذه الآيةِ: {يا أيُّها الذينَ آمَنوا إذا جاءَكُمُ المُؤمِناتُ مُهاجِراتٍ فامتَحِنوهُنَّ} إلى {غَفورٌ رَحيمٌ} [الممتحنة: 10 - 12]. قال عُروةُ: قالت عائِشةُ: فمَن أقَرَّ بهذا الشَّرطِ منهنَّ قال لَها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: قد بايَعتُكِ، كَلامًا يُكَلِّمُها به، واللهِ ما مَسَّت يَدُه يَدَ امرَأةٍ قَطُّ في المُبايَعةِ، وما بايَعَهنَّ إلَّا بقَولِه.»","narrator":"أصحاب النبي صلى الله عليه وسلم","source":"صحيح البخاري (2711)","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/xNtwnwf4","nameForm":"غَفورٌ رَحيمٌ","scene":"في الحديبية اشترط سهيل بن عمرو على النبي ﷺ ألا يأتيه أحد منهم وإن كان على دينه إلا رده، فكره المؤمنون ذلك، ورد النبي ﷺ أبا جندل إلى أبيه، ثم جاءت المؤمنات مهاجرات ومنهن أم كلثوم بنت عقبة، فجاء أهلها يطلبون ردها، فأنزل الله ﴿يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا جَاءَكُمُ الْمُؤْمِنَاتُ مُهَاجِرَاتٍ فَامْتَحِنُوهُنَّ﴾ فلم يردهن.","reason":"استثنى الله المؤمنات المهاجرات من شرط الرد بآية الامتحان، وفي سياقها ذكر ﴿غَفُورٌ رَحِيمٌ﴾؛ فالمرأة التي تركت الشرك وهاجرت لا تُرد، ومغفرة ما مضى ورحمة ما يأتي تحفظ العائدة من أن تُسلم.","adds":"آية الامتحان استثنت المهاجرات من الرد: الغفور الرحيم يحمي العائدة."},{"i":2,"of":33,"text":"أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم كان يَمتَحِنُ مَن هاجَرَ إليه مِنَ المُؤمِناتِ بهذه الآيةِ؛ بقَولِ اللهِ: {يا أيُّها النَّبيُّ إذا جاءَكَ المُؤمِناتُ يُبايِعنَكَ} إلى قَولِه: {غَفورٌ رَحيمٌ} [الممتحنة: 12]. قال عُروةُ: قالت عائِشةُ: فمَن أقَرَّ بهذا الشَّرطِ مِنَ المُؤمِناتِ قال لَها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: قد بايَعتُكِ، كَلامًا، ولا واللهِ ما مَسَّت يَدُه يَدَ امرَأةٍ قَطُّ في المُبايَعةِ، ما يُبايِعُهنَّ إلَّا بقَولِه: قد بايَعتُكِ على ذلك.","narrator":"عائشة أم المؤمنين","source":"صحيح البخاري 4891","grade":"صحيح","judgment":"[أورده في صحيحه] وقال : تابعه يونس ومعمر وعبد الرحمن بن إسحاق عن الزهري. وقال إسحاق بن راشد: عن الزهري عن عروة وعمرة.","url":"https://dorar.net/h/LRNhLKAk","nameForm":"غَفورٌ رَحيمٌ","scene":"قالت عائشة: كان النبي ﷺ يمتحن من هاجر إليه من المؤمنات بهذه الآية: ﴿يَا أَيُّهَا النَّبِيُّ إِذَا جَاءَكَ الْمُؤْمِنَاتُ يُبَايِعْنَكَ﴾ إلى قوله ﴿غَفُورٌ رَحِيمٌ﴾، فمن أقر بهذا الشرط قال لها: «قد بايعتك» كلامًا، ولا والله ما مست يده يد امرأة قط في المبايعة.","reason":"بيعة النساء تُختم بآية فيها الاستغفار لهن ووصف الله بالغفور الرحيم؛ فالدخول في العهد الجديد مقرون بمغفرة ما قبله، والبيعة كلام بلا مصافحة حفظًا للحدود.","adds":"بيعة النساء تُختم بالغفور الرحيم: العهد الجديد يطوي ما قبله."},{"i":3,"of":33,"text":"شهدتُ الصلاةَ مع رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ومع أبي بكرٍ وعمرَ وعثمانَ رضيَ اللهُ عنهم فكلُّهم يُصلِّيها قبلَ الخطبةِ ثم يخطُبُ بعدُ. قال: ونزل نبيُّ اللهِ صلَّى اللهُ عليهِ وسلَّمَ فكأني أنظرُ إليه يُجلِسُ الرجلَ بيدِه ثم أقبل يشقُّهم حتى أتى النِّساءَ ومعه بلالٌ رضيَ اللهُ عنه فقال {يَا أَيُّهَا النَّبِيُّ إِذَا جَاءَكَ الْمُؤْمِنَاتُ يُبَايِعْنَكَ عَلَى أَنْ لَا يُشْرِكْنَ بِاللَّهِ شَيْئًا وَلَا يَسْرِقْنَ وَلَا يَزْنِينَ وَلَا يَقْتُلْنَ أَوْلَادَهُنَّ وَلَا يَأْتِينَ بِبُهْتَانٍ يَفْتَرِينَهُ بَيْنَ أَيْدِيهِنَّ وَأَرْجُلِهِنَّ وَلَا يَعْصِينَكَ فِي مَعْرُوفٍ فَبَايِعْهُنَّ وَاسْتَغْفِرْ لَهُنَّ اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ  } فقال حين فرغ أنتُنَّ على ذلك فقالت امرأةٌ واحدةٌ لم تُجبْه غيرُها نعم يا رسولَ اللهِ قال فتصدَّقْنَ فبسط بلالٌ رضيَ اللهُ عنه ثوبه ثم قال لهنَّ ألقِينَ فجعلْن يُلقِينَ الفَتَخَ والخواتيمَ في ثوبِ بلالٍ رضيَ اللهُ عنه","narrator":"عبدالله بن عباس","source":"شرح معاني الآثار 4/352","grade":"صحيح","judgment":"ثابت","url":"https://dorar.net/h/d4ObUini","nameForm":"غَفورٌ رَحيمٌ","scene":"يحكي ابن عباس: شهدت صلاة العيد مع النبي ﷺ وأبي بكر وعمر وعثمان، كلهم يصليها قبل الخطبة، ونزل النبي ﷺ فأقبل يشق الرجال حتى أتى النساء ومعه بلال، فقرأ ﴿يَا أَيُّهَا النَّبِيُّ إِذَا جَاءَكَ الْمُؤْمِنَاتُ يُبَايِعْنَكَ﴾ الآية كلها إلى ﴿غَفُورٌ رَحِيمٌ﴾، ثم قال: «أنتن على ذلك؟» ثم أمرهن بالصدقة فجعلن يلقين الفتخ والخواتيم في ثوب بلال.","reason":"في يوم العيد خص النبي ﷺ النساء بآية البيعة المختومة بالغفور الرحيم ثم حثهن على الصدقة؛ فالعهد المقرون بالمغفرة يُجدد في المواسم، والاستجابة كانت صدقة فورية.","adds":"آية الغفور الرحيم تُتلى على النساء يوم العيد: تجديد العهد في الموسم."},{"i":4,"of":33,"text":"عَنِ ابنِ عَبَّاسٍ، قال: يَطَّوَّفُ الرَّجُلُ بالبَيتِ ما كان حَلالًا حتَّى يُهِلَّ بالحَجِّ، فإذا رَكِبَ إلى عَرَفةَ فمَن تَيَسَّرَ له هَديَّةٌ مِنَ الإبِلِ أوِ البَقَرِ أوِ الغَنَمِ، ما تَيَسَّرَ له مِن ذلك، أيَّ ذلك شاءَ، غيرَ أنَّه إن لَم يَتَيَسَّرْ له فعليه ثَلاثةُ أيَّامٍ في الحَجِّ، وذلك قَبلَ يَومِ عَرَفةَ، فإن كان آخِرُ يَومٍ مِنَ الأيَّامِ الثَّلاثةِ يَومَ عَرَفةَ، فلا جُناحَ عليه، ثُمَّ ليَنطَلِقْ حتَّى يَقِفَ بعَرَفاتٍ مِن صَلاةِ العَصرِ إلى أن يَكونَ الظَّلامُ، ثُمَّ ليَدفَعوا مِن عَرَفاتٍ إذا أفاضوا منها حتَّى يَبلُغوا جَمعًا الذي يُتَبَرَّرُ فيه، ثُمَّ ليَذكُروا اللهَ كَثيرًا، وأكثِروا التَّكبيرَ والتَّهليلَ قَبلَ أن تُصبِحوا، ثُمَّ أفيضوا؛ فإنَّ النَّاسَ كانوا يُفيضونَ، وقال اللهُ تَعالى: {ثُمَّ أفيضوا مِن حَيثُ أفاضَ النَّاسُ واستَغفِروا اللهَ إنَّ اللهَ غَفورٌ رَحيمٌ} [البقرة: 199] حتَّى تَرموا الجَمرةَ.","narrator":"كريب مولى ابن عباس","source":"صحيح البخاري 4521","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/gdbWc19w","nameForm":"غَفورٌ رَحيمٌ","scene":"ابن عباس: يطوف الرجل بالبيت حلالًا حتى يهل بالحج… ثم يفيض من عرفات ﴿ثُمَّ أَفِيضُوا مِنْ حَيْثُ أَفَاضَ النَّاسُ وَاسْتَغْفِرُوا اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَّحِيمٌ﴾ حتى ترموا الجمرة.","reason":"الإفاضة من عرفة مقرونة بالاستغفار والاسم: الحاج يستغفر في الطريق من عرفة إلى مزدلفة.","adds":"يعطي الاسم في مناسك الحج."},{"i":5,"of":33,"text":"سُئل ابنَ عَبَّاسٍ عن قَولِه تَعالى: {ومَن يَقتُل مُؤمِنًا مُتَعَمِّدًا فجَزاؤُه جَهَنَّمُ خالِدًا فيها}، وقَولِه: {ولا يَقتُلونَ النَّفسَ التي حَرَّمَ اللهُ إلَّا بالحَقِّ} حتَّى بَلَغَ {إلَّا مَن تابَ وآمَنَ} فسَألتُه فقال: لَمَّا نَزَلَت قال أهلُ مَكَّةَ: فقد عَدَلنا باللهِ، وقد قَتَلنا النَّفسَ التي حَرَّمَ اللهُ إلَّا بالحَقِّ، وأتَينا الفَواحِشَ، فأنزَلَ اللهُ: {إلَّا مَن تابَ وآمَنَ وعَمِلَ عَمَلًا صالِحًا} إلى قَولِه: {غَفورًا رَحيمًا}","narrator":"عبدالله بن عباس","source":"صحيح البخاري 4765","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/0q446Lv5","nameForm":"غَفورًا رَحيمًا","scene":"سُئل ابن عباس عن ﴿وَمَن يَقْتُلْ مُؤْمِنًا مُّتَعَمِّدًا﴾ وآية الفرقان: فقال: لما نزلت قال أهل الشرك: قد قتلنا النفس وأتينا الفواحش، فأنزل الله ﴿إِلَّا مَن تَابَ وَآمَنَ وَعَمِلَ عَمَلًا صَالِحًا﴾ إلى ﴿غَفُورًا رَّحِيمًا﴾.","reason":"أهل القتل والفواحش يئسوا فنزل الاستثناء مختومًا بالاسم: التوبة تبدل السيئات حسنات لأنه غفور رحيم.","adds":"يقرن الاسم بتوبة القاتل والزاني."},{"i":6,"of":33,"text":"أنَّ أبا بَكرٍ الصِّدِّيقَ رَضيَ اللهُ عنه، قال للنَّبيِّ صلَّى اللهُ عليه وسلَّم: يا رَسولَ اللهِ، عَلِّمْني دُعاءً أدعو به في صَلاتي، قال: قُلِ: اللهُمَّ إنِّي ظَلَمتُ نَفسي ظُلمًا كَثيرًا، ولا يَغفِرُ الذُّنوبَ إلَّا أنتَ، فاغفِرْ لي مِن عِندِكَ مَغفِرةً؛ إنَّكَ أنتَ الغَفورُ الرَّحيمُ.","narrator":"عبدالله بن عمرو","source":"صحيح البخاري 7387","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/T1yV8yTS","nameForm":"الغَفورُ الرَّحيمُ","scene":"أبو بكر: يا رسول الله علمني دعاءً أدعو به في صلاتي. قال: «قل: اللهم إني ظلمت نفسي ظلمًا كثيرًا، ولا يغفر الذنوب إلا أنت، فاغفر لي من عندك مغفرة، إنك أنت الغفور الرحيم».","reason":"دعاءٌ علّمه النبي ﷺ أبا بكر لصلاته: اعتراف بالظلم، وحصر المغفرة، وطلبها «من عندك» لا باستحقاق، ثم الاسم.","adds":"دعاءٌ في الصلاة يُختم بالغفور الرحيم بعد الاعتراف بالظلم."},{"i":7,"of":33,"text":"كان عبدُ اللهِ بنُ أُبَيٍّ ابنُ سَلولَ يقولُ لجاريةٍ له: اذهَبْي فابغينا شيئًا، فأنزَلَ اللهُ عَزَّ وجَلَّ: {ولا تُكرِهوا فتَياتِكُم على البِغاءِ إن أرَدنَ تَحَصُّنًا لتَبتَغوا عَرَضَ الحَياةِ الدُّنيا ومَن يُكرِهْهنَّ فإنَّ اللَّهَ مِن بَعدِ إكراهِهنَّ} لَهُنَّ {غَفورٌ رَحيمٌ} [النور: 33].","narrator":"جابر بن عبدالله","source":"صحيح مسلم 3029","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/Ci2fCOgf","nameForm":"غَفورٌ رَحيمٌ","scene":"عبد الله بن أبي كان يكره جاريتيه مسيكة وأميمة على الزنا، فشكتا إلى النبي ﷺ فنزلت ﴿وَلَا تُكْرِهُوا فَتَيَاتِكُمْ عَلَى الْبِغَاءِ… فَإِنَّ اللَّهَ مِن بَعْدِ إِكْرَاهِهِنَّ غَفُورٌ رَّحِيمٌ﴾.","reason":"المكرهة مغفور لها مرحومة: الاسم للمظلومة لا للظالم.","adds":"يُري الاسم رحمة بالمكرهات."},{"i":8,"of":33,"text":"لَمَّا بعَثَ أهْلُ مكَّةَ في فِداءِ أَسْراهُم، بعَثَتْ زَيْنبُ بِنتُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في فِداءِ أبي العاصِ، وبعَثَتْ فيه بقِلادةٍ كانتْ خَديجةُ أدخَلَتْها بها على أبي العاصِ حينَ بَنى عليها، فلمَّا رَآها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ رَقَّ رِقَّةً شَديدةً، وقالَ: إنْ رَأيْتُم أنْ تُطلِقوا لها أَسيرَها وتَرُدُّوا عليها الَّذي لها فافْعَلوا، قالوا: نعمْ يا رَسولَ اللهِ، ورَدُّوا عليه الَّذي لها، قالَ: وقالَ العبَّاسُ: يا رَسولَ اللهِ، إنِّي كُنْتُ مُسلِمًا، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: اللهُ أعلَمُ بإسْلامِكَ، فإنْ يكُنْ كما تَقولُ فاللهُ يَجْزيكَ، فافْدِ نفْسَكَ وابْنَيْ أخَوَيْكَ: نَوْفلَ بنَ الحارِثِ بنِ عَبدِ المُطَّلِبِ، وعَقيلَ بنَ أبي طالِبِ بنِ عَبدِ المُطَّلِبِ، وحَليفَكَ عُتْبةَ بنَ عَمْرِو بنِ جَحْدَمٍ أخَا بَني الحارِثِ بنِ فِهْرٍ، فقالَ: ما ذاك عِندي يا رَسولَ اللهِ؟ قالَ: فأين المالُ الَّذي دفَنْتَ أنتَ وأُمُّ الفَضلِ؟ فقُلْتَ لها: إنْ أُصِبْتُ فهذا المالُ لبَني الفَضلِ، وعَبدِ اللهِ وقُثَمَ؟ فقالَ: واللهِ يا رَسولَ اللهِ، إنِّي أشهَدُ أنَّكَ رَسولُ اللهِ، إنَّ هذا لشَيءٌ ما عَلِمَه أحَدٌ غَيْري وغَيرُ أُمِّ الفَضلِ، فاحسِبْ لي يا رَسولَ اللهِ ما أصَبْتُم منِّي عِشْرينَ أُوقيَّةً مِن مالٍ كانَ مَعي، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: أفْعَلُ، ففَدَى العبَّاسُ نفْسَه وابْنَيْ أخَوَيْه وحَليفَه، وأنزَلَ اللهُ عزَّ وجلَّ: {يَاأَيُّهَا النَّبِيُّ قُلْ لِمَنْ فِي أَيْدِيكُمْ مِنَ الْأَسْرَى إِنْ يَعْلَمِ اللَّهُ فِي قُلُوبِكُمْ خَيْرًا يُؤْتِكُمْ خَيْرًا مِمَّا أُخِذَ مِنْكُمْ وَيَغْفِرْ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ} [الأنفال: 70]، فأعْطاني مَكانَ العِشْرينَ الأُوقيَّةِ في الإسْلامِ عِشْرينَ عَبدًا كلُّهم في يَدِه مالٌ يَضرِبُ به معَ ما أرْجو مِن مَغْفِرةِ اللهِ عزَّ وجلَّ.","narrator":"عائشة","source":"المستدرك على الصحيحين 5505","grade":"صحيح","judgment":"صحيح على شرط مسلم","url":"https://dorar.net/h/wl55YOMx","nameForm":"غَفُورٌ رَحِيمٌ","scene":"زينب بنت النبي ﷺ بعثت في فداء أبي العاص قلادة خديجة، فرقّ النبي ﷺ… ونزلت ﴿قُل لِّمَن فِي أَيْدِيكُم مِّنَ الْأَسْرَىٰ إِن يَعْلَمِ اللَّهُ فِي قُلُوبِكُمْ خَيْرًا يُؤْتِكُمْ خَيْرًا مِّمَّا أُخِذَ مِنكُمْ وَيَغْفِرْ لَكُمْ وَاللَّهُ غَفُورٌ رَّحِيمٌ﴾ — قال العباس: فأعطاني مكان العشرين أوقية عشرين عبدًا.","reason":"الأسرى الذين في قلوبهم خير يُعوَّضون ويُغفر لهم: الاسم وعد للأسير الصادق.","adds":"يقرن الاسم بفداء أسرى بدر وتعويض العباس."},{"i":9,"of":33,"text":"قرَأَ أُبَيٌّ آيةً، وقرَأَ ابنُ مسعودٍ خِلافَها، وقرَأَ رَجلٌ آخَرُ خِلافَها، فأتَيْنا النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فقُلتُ له: ألم تَقرَأْ آيةَ كذا وكذا، كذا وكذا؟ وقال ابنُ مسعودٍ: ألم تقرَأْ آيةَ كذا وكذا، كذا وكذا؟ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: كلُّكم مُحسِنٌ مُجمِلٌ، قال: قُلْنا: ما كلُّنا أحسَنَ ولا أجمَلَ، قال: فضرَبَ صَدْري، وقال: يا أُبَيُّ، أُقرِئْتُ القُرآنَ، فقُلتُ: على حَرفٍ، أو على حَرفَيْنِ؟ فقال لي المَلَكُ الذي عندي: على حَرفَيْنِ، فقُلتُ: على حَرفَيْنِ؟ فقال لي: على حَرفَينِ أو على ثَلاثةٍ، فقال لي المَلَكُ الذي معي: على ثَلاثةٍ، فقُلتُ: على ثَلاثةٍ، هكذا حتى بلَغَ سَبعةَ أحرُفٍ، ليس منها إلَّا شافٍ كافٍ، قُلتَ: غَفورًا رَحيمًا، أو قُلتَ: سَميعًا حَكيمًا، أو قُلتَ: عَليما حَكيمًا، أو قُلتَ: عَزيزًا حَكيمًا، أيَّ ذلك قُلتَ؛ فإنَّه كذلك.\nوزادَ سُليمانُ في حديثِهِ: ما لم يُختَمْ عذابٌ برحمةٍ أو رحمةٌ بعذابٍ.","narrator":"أبي بن كعب","source":"تخريج مشكل الآثار 3113","grade":"صحيح","judgment":"إسناده صحيح على شرطهما.","url":"https://dorar.net/h/Xf3ApFoa","nameForm":"غَفورًا رَحيمًا","scene":"الأحرف السبعة: «قلت: غفورًا رحيمًا، أو قلت: سميعًا حكيمًا… أيَّ ذلك قلت فإنه كذلك»، وزاد سليمان: «ما لم يُختم عذابٌ برحمةٍ أو رحمةٌ بعذاب».","reason":"«غفورًا رحيمًا» أول مثال للخواتم في الأحرف.","adds":"يُثبت الاسم مثالًا في الأحرف."},{"i":10,"of":33,"text":"كان رجُلٌ يكتُبُ للنَّبيِّ صلَّى اللهُ عليه وسلَّم وكان قد قرَأ البقرةَ وآلَ عِمرانَ عُدَّ فينا ذو شأنٍ وكان النَّبيُّ صلَّى اللهُ عليه وسلَّم يُمِلُّ عليه { غَفُورًا رَحِيمًا } فيكتُبُ: ( عَفُوًّا غَفُورًا ) فيقولُ النَّبيُّ صلَّى اللهُ عليه وسلَّم : ( اكتُبْ ) ويُملي عليه { عَلِيمًا حَكِيمًا } فيكتُبُ: ( سَمِيعًا بَصِيرًا ) فيقولُ النَّبيُّ صلَّى اللهُ عليه وسلَّم : ( اكتُبْ أيَّهما شِئْتَ ) قال : فارتدَّ عنِ الإسلامِ فلحِق بالمُشرِكينَ فقال : أنا أعلَمُكم بمُحمَّدٍ ـ صلَّى اللهُ عليه وسلَّم ـ إنْ كُنْتُ لَأكتُبُ ما شِئْتُ فمات فبلَغ ذلك النَّبيَّ صلَّى اللهُ عليه وسلَّم فقال : ( إنَّ الأرضَ لنْ تقبَلَه ) قال : فقال أبو طَلحةَ : فأتَيْتُ تلكَ الأرضَ الَّتي مات فيها وقد علِمْتُ أنَّ الَّذي قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم كما قال فوجَدْتُه مَنبوذًا فقُلْتُ : ما شأنُ هذا ؟ فقالوا : دفَنَّاه فلَمْ تقبَلْه الأرضُ","narrator":"أنس بن مالك","source":"تخريج صحيح ابن حبان 744","grade":"صحيح","judgment":"إسناده صحيح على شرط مسلم","url":"https://dorar.net/h/5k7r0ZvQ","nameForm":"غَفُورًا رَحِيمًا","scene":"الكاتب الذي أُملي عليه ﴿غَفُورًا رَّحِيمًا﴾ فكتب «عفوًّا غفورًا» — ثم ارتد فلفظته الأرض.","reason":"الاسم مما أملاه النبي ﷺ على الكتّاب.","adds":"يُثبت الإملاء ويحذّر التلاعب."},{"i":11,"of":33,"text":"عنْ عبدِ اللهِ بنِ عُمَرَ قالَ: كنَّا نقولُ ما لمُفتَتَنٍ تَوبةٌ، وما اللهُ بقابِلٍ منه شيئًا، فلمَّا قَدِمَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ المدينةَ أُنزِلَ فيهم: {يَا عِبَادِيَ الَّذِينَ أَسْرَفُوا عَلَى أَنْفُسِهِمْ لَا تَقْنَطُوا مِنْ رَحْمَةِ اللَّهِ إِنَّ اللَّهَ يَغْفِرُ الذُّنُوبَ جَمِيعًا إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ} [الزمر: 53]، والآياتِ الَّتي بعدَها، قالَ عُمَرُ: فكتَبْتُها فجَلَسْتُ على بعيري، ثُمَّ طُفتُ المدينةَ، ثُمَّ أقامَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بمكَّةَ يَنتظرُ أنْ يَأذنَ اللهُ له في الهِجرةِ وأصحابِهِ منَ المهاجِرينَ، وقد أقامَ أبو بكرٍ رَضيَ اللهُ عنه، يَنتظِرُ أن يُؤذنَ لرسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فيَخرُجَ معه.","narrator":"عمر بن الخطاب","source":"المستدرك على الصحيحين 3674","grade":"صحيح","judgment":"صحيح على شرط مسلم","url":"https://dorar.net/h/BXb0Es5o","nameForm":"الْغَفُورُ الرَّحِيمُ","scene":"عمر: كنا نقول ما لمفتتن توبة — عياش وهشام فُتنا في مكة — فلما قدم النبي ﷺ المدينة نزلت ﴿يَا عِبَادِيَ الَّذِينَ أَسْرَفُوا عَلَىٰ أَنفُسِهِمْ لَا تَقْنَطُوا مِن رَّحْمَةِ اللَّهِ إِنَّ اللَّهَ يَغْفِرُ الذُّنُوبَ جَمِيعًا إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ﴾ — قال عمر: فكتبتها بيدي وبعثت بها إلى هشام، فقرأها ثم أسلم ورجع.","reason":"أرجى آية نزلت لمن ظنوا أن لا توبة للمفتون: يغفر الذنوب جميعًا لأنه هو الغفور الرحيم — عمر كتبها ليعود بها صاحبه هشام.","adds":"نزلت الآية فيمن ظُنّ ألا توبة له بعد الفتنة: لا قنوط مع الغفور الرحيم."},{"i":12,"of":33,"text":"«سألْتُ عبدَ اللهِ بنَ عبَّاسٍ رضِيَ اللهُ عنهما عن قولِ اللهِ عَزَّ وجَلَّ لموسى صَلَّى اللهُ عليه وسلَّمَ: {وَفَتَنَّاكَ فُتُونًا} [طه: 40]، فسألْتُه عن الفُتونِ؟ فقال: استأنِفِ النَّهارَ يا ابنَ جُبيرٍ؛ فإنَّ لها حديثًا طويلًا.\nقال: فغدوْتُ على ابنِ عبَّاسٍ لأنتجِزَ ما وَعَدني مِن حديثِ الفُتونِ، فقال: تذاكَرَ فِرعونُ وجُلساؤُه ما كان اللهُ عَزَّ وجَلَّ وعَدَ إبراهيمَ صَلَّى اللهُ عليه وسلَّمَ مِن أنْ يجعَلَ في ذُرِّيتَه أنبياءَ ومُلوكًا؛ فقال بعضُهم: إنَّ بني إسرائيلَ لينتظِرونَ ذلك ما يشُكُّون فيه، وقد كانوا يظنُّونَ أنَّه يُوسفُ بنُ يعقوبَ عليهما الصَّلاةُ والسَّلامُ، فلمَّا هلَكَ قالوا: ليس هكذا كان، إنَّ اللهَ عَزَّ وجَلَّ وعَدَ إبراهيمَ صَلَّى اللهُ عليه وسلَّمَ. قال فِرعونُ: فكيف تَرَونَ؟ فائْتَمَروا، واجتمَعوا أمْرَهم على أنْ يبعَثَ رِجالًا بالشِّفارِ، يَطُوفون في بني إسرائيلَ، فلا يَجِدون مولودًا ذكَرًا إلَّا ذَبَحوه، ففَعَلوا ذلك، فلمَّا أنْ رَأَوا أنَّ الكبارَ في بني إسرائيلَ يموتونَ بآجالِهم، والصِّغارَ يُذْبَحونَ، قالوا: أتوشِكونَ أنْ تُفْنوا بني إسرائيلَ، فتَصيروا إلى أنْ تُباشِروا مِن الأعمالِ والخدمةِ الَّتي كانوا يَكْفُونكم؟ فاقْتُلوا عامًا كلَّ مولودٍ ذكرٍ، فيقِلَّ نَباتُهم، ودَعُوا عامًا، فلا تَقْتلوا منهم أحدًا، فيشِبَّ الصِّغارُ مكانَ مَن يموتُ مِن الكبارِ، فإنَّهم لنْ يَكْثروا بمَن تَسْتحيون، فتخافوا مُكاثرتَهم إياكم، ولنْ يَفْنَوا بمَن تقتُلونَ، فتحتاجونَ إليهم، فأجْمَعوا أمْرَهم على ذلك، فحمَلَت أُمُّ موسى بهارونَ عليهما السَّلامُ العامَ الَّذي لا يُذْبَحُ فيه الغِلمانُ، فولدَتْه عَلانيةً، فلمَّا كان مِن قابلٍ حمَلَتْ بمُوسى عليه السَّلامُ، فوقَعَ في قلْبِها مِن الهَمِّ والحزنِ. فذلك مِن الفُتونِ يا ابنَ جُبيرٍ، ما دخَلَ عليه في دهو بَطْنِ أُمِّه ممَّا يُرادُ به، فأوحَى اللهُ تعالى إليها: {وَلَا تَخَافِي وَلَا تَحْزَنِي إِنَّا رَادُّوهُ إِلَيْكِ وَجَاعِلُوهُ مِنَ الْمُرْسَلِينَ} [القصص: 7]، وأمَرَها أنْ إذا ولَدَتْ أنْ تجعَلَه في تابوتٍ، ثمَّ تُلْقِيه في اليمِّ، فلمَّا ولَدَت فعَلَت ذلك به، فألْقَته في اليمِّ، فلمَّا توارى عنها ابنُها أتاها الشَّيطانُ، فقالت في نفْسِها: ما فعَلْتُ بابني؟! لو ذُبِحَ لبِثَ عندي فرأيْتُه وكفَّنْتُه، كان أحَبَّ إليَّ مِن أنْ أُلْقِيَه بيدي إلى دوابِّ البحرِ وحِيتانِه، وانتهى الماءُ به حتَّى أرفَأَ به عند فُرْضَةُ مُسْتَقى جواري امرأةِ فِرعونَ، فلمَّا رأيْنَه أخذْنَه، فهمَمْنَ أنْ يفتحْنَ التَّابوتَ، فقالت بعضُهنَّ: إنَّ في هذا مالًا، وإنَّا إنْ فتحْناه لم تُصدِّقْنا امرأةُ الملِكِ بما وجَدْنا فيه، فحمَلْنَه بهيئةٍ لم يُحرِّكْنَ منه شيئًا، دفعْنَه إليها، فلمَّا فتحَتْه رأتْ فيه غُلامًا، فأُلْقِيَ عليه منها محبَّةٌ لم تُلْقَ مثْلُها على البشَرِ قطُّ، وأصبَحَ فُؤَادُ أُمِّ موسى فارغًا مِن ذِكْرِ كلِّ شَيءٍ إلَّا مِن ذِكْرِ مُوسى عليه السَّلامُ، فلمَّا سمِعَ الذَّابِحونَ بأمْرِه أقبلوا بشِفارِهم إلى امرأةِ فرعونَ ليذبَحُوه -وذلك مِن الفُتونِ يا ابنَ جُبيرٍ- فقالت للذَّبَّاحينَ: أقِرُّوه؛ فإنَّ هذا الواحدَ لا يَزيدُ في بني إسرائيلَ حتَّى آتِيَ فِرعونَ فأسْتَوْهِبَه منه، فإنْ وهَبَه لي كنْتُم قد أحسنْتُم وأجمَلْتُم، وإنْ أمَرَ بذبْحِه لم أَلُمْكم، فأتَتْ به فرعونَ، فقالت: قُرَّةُ عينٍ لي ولك، قال فِرعونُ: يكونُ لك، فأمَّا لي فلا حاجةَ لي في ذلك. قال رسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ: والَّذي أحلِفُ به، لو أقَرَّ فِرعونُ بأنْ يكونَ له قُرَّةَ عينٍ كما أقَرَّت امرأتُه، لهداهُ اللهُ به كما هدى به امرأتَه، ولكنَّ اللهَ حرَمَه ذلك.\nفأرسَلَتْ إلى مَن حولَها، مِن كلِّ امرأةٍ لها لبنٌ، تختارُ لها ظِئرًا، فجعَلَ كلَّما أخذَتْه امرأةٌ منهنَّ، فترُضِعُه، لم يَقْبَلْ ثَدْيَها، حتَّى أشفَقَت عليه امرأةُ فِرعونَ أنْ يَمتنِعَ مِن اللَّبنِ فيموتَ، فأحْزَنَها ذلك، فأمرَتْ به، فأُخْرِجَ إلى السُّوقِ وتجمَّعَ النَّاسُ، تَرْجو أنْ تجِدَ له ظِئرًا يأخُذُ منها، فلم يَقْبَلْ، وأصبَحَتْ أُمُّ موسى والهةً، فقالت لأُخْتِه: قُصِّيه -يعني: أثَرَهُ- واطْلُبِيه، هل تسمعينَ له ذِكْرًا؟ أحيٌّ ابْني أمْ قد أكلَتْه الدَّوابُّ؟ ونسِيَت ما كان اللهُ عَزَّ وجَلَّ وعَدَها فيه، فبَصُرتْ به أختُه عن جُنُبٍ وهم لا يَشعُرونَ، والجُنُبُ: أنْ يبصِرَ الإنسانُ إلى الشَّيءِ البعيدِ وهو إلى جَنْبِه لا يشعُرُ به، فقالت مِن الفرحِ حين أعياهم الظُّؤارتُ: أنا {أَدُلُّكُمْ عَلَى أَهْلِ بَيْتٍ يَكْفُلُونَهُ لَكُمْ وَهُمْ لَهُ نَاصِحُونَ} [القصص: 12]، فأخَذُوها فقالوا: ما يُدريك ما نُصْحُهم له؟ هل يعرِفونَه؟ حتَّى شكُّوا في ذلك -فذلك مِن الفُتونِ يا ابنَ جُبيرٍ- فقالت: نصيحَتُهم له وشفقَتُهم عليه رغبةً في صِهر الـمَلِك، ورجاءَ مَنفعتِه، فأرْسَلوها، فانطلَقَتْ إلى أُمِّها فأخبرتْها الخبرَ، فجاءتْ أُمُّه، فلمَّا وضعَتْه في حِجْرِها، نزَا إلى ثَدْيِها، فمَصَّه حتَّى امتلَأَ جَنباهُ رِيًّا، وانطلَقَ البشيرُ إلى امرأةِ فرعونَ: أنْ قد وجَدْنا لابْنِك، فأرسَلَتْ إليها، فأُوتِيتْ بها وبه، فلمَّا رأت ما يصنَعُ، قالت لها: امْكُثي عندي؛ تُرْضِعي ابني هذا، فإنِّي لم أحجِبْه شيئًا قطُّ، فقالت أُمُّ مُوسى: لا أستطيعُ أنْ أدَعَ بيتي وولدي، فيَضيعَ، فإنْ طابتْ نفْسُك أنْ تُعْطِيَنه، فأذهَبَ به إلى مَنْزلي، فيكونَ معي لا آلوهُ خيرًا، فعلْتُ، وإلَّا فإنِّي غيرُ تاركةٍ بيتي وولدي، وذكَرَت أُمُّ مُوسى عليه السَّلامُ ما كان اللهُ عَزَّ وجَلَّ وعَدَها، فتعاسَرَت على امرأةِ فرعونَ، وأيقنَتْ بأنَّ اللهَ عَزَّ وجَلَّ يُنْجِزُ موعودَه، فرجَعَتْ إلى بيتِها بابنِها مِن يومِها، فأنبَتَه اللهُ نباتًا حسنًا، وحفِظَه لِمَا قد قَضى فيه، فلم يزَلْ بنو إسرائيلَ وهم في ناحيةِ القريةِ مُمْتنعينَ يَمْتنعونَ به مِن السُّخرةِ ما كان فيهم.\nفلمَّا تَرعرَعَ قالت امرأةُ فرعونَ لأُمِّ مُوسى: أريدُ أنْ تُرِيني ابني، فوعَدَتْها يومًا تُرِيها فيه إيَّاه، فقالتِ امرأةُ فِرعونَ لخُزَّانِها، وظُؤورتِها، وقَهارِمَتِها: لا يَبْقينَّ أحدٌ منكم إلَّا استقبَلَ ابني اليومَ بهَديَّةٍ وكَرامةٍ؛ لِأَرى ذلك فيه، وأنا باعثةٌ أمينًا يُحْصِي ما يصنَعُ كلُّ إنسانٍ منكم، فلم تَزَلِ الهدايا والكرامةُ والنِّحلةُ، تَستقبِلُه مِن حينِ خرَجَ مِن بيتِ أُمِّه إلى أنْ دخَلَ على امرأةِ فرعونَ، فلمَّا دخَلَ عليها بجَّلَتْه، وأكرمَتْه، وفرِحَت به، وأعجَبَها، ونحَلَت أُمَّه؛ لحُسْنِ أثَرِه، ثمَّ قالت: لآتيَنَّ به فِرعونَ، فليَنْحَلَنَّه، وليُكْرِمَنَّه، فلمَّا دخَلَتْ به عليه، جعَلَه في حِجْرِه، فتناوَلَ مُوسى لِحيةَ فرعونَ، فمَدَّها إلى الأرضِ، فقال الغواةُ مِن أعداءِ اللهِ لفرعونَ: ألَا ترى إلى ما وعَدَ اللهُ عَزَّ وجَلَّ إبراهيمَ نَبِيَّه عليه السَّلامُ أنَّه يرِثُك، ويَعْلوك، ويصرَعُك، فأرسَلَ إلى الذَّبَّاحينَ، وذلك مِن الفُتونِ يا ابنَ جُبيرٍ، بعدَ كلِّ بلاءٍ ابتُلِيَ به، أو أُرِيدَ به فُتونًا.\nفجاءت امرأةُ فِرعونَ تَسْعى إلى فرعونَ، فقالت: ما بدا لك في هذا الغلامِ الَّذي وهَبْتَه لي؟ قال: ألَا تَرَيْنَه يزعُمُ أنَّه يصرَعُني ويَعْلوني؟ قالت: اجْعَلْ بيني وبينك أمرًا تعرِفُ فيه الحقَّ؛ ائْتِ بجَمْرتينِ ولُؤلؤتَينِ، فقَرِّبْهما إليه، فإنْ بطَش باللُّؤلؤتَينِ واجتنَبَ الجَمْرتينِ، عرَفْتَ أنَّه يعقِلُ، وإنْ تَناوَلَ الجَمْرتَينِ ولم يُرِدِ اللُّؤلؤتَينِ، علِمْتَ أنَّ أحدًا لا يُؤثِرُ الجَمرتينِ على اللُّؤلؤتينَ وهو يعقِلُ، فقُرِّبَ ذلك إليه، فتناوَلَ الجَمرتَينِ، فانْتَزَعوهما مِن يَدِه، وخافت أنْ يحرِقَا يدَيْه، فقالت المرأةُ: ألَا ترى؟! فصرَفَه اللهُ عنه بعدما كان قد هَمَّ به، وكان الله عَزَّ وجَلَّ بالغًا فيه أمْرَه.\nفلمَّا بلَغَ أشُدَّه وصار مِن الرِّجالِ، لم يكُنْ أحدٌ مِن آلِ فِرعونَ يخلُصُ إلى أحدٍ مِن بني إسرائيلَ معه بظُلمٍ، ولا يخرُجُ حتَّى امْتَنعوا كلَّ الامتناعِ.\nفبينما مُوسى عليه السَّلامُ يَمْشي في ناحيةِ المدينةِ، إذ هو برجُلينِ يَقْتتلانِ؛ أحدُهما فرعونيٌّ، والآخرُ إسرائيليٌّ، فاستغاثَه الإسرائيليُّ على الفرعونيِّ، فغضِبَ مُوسى عليه السَّلامُ غضبًا شديدًا؛ لأنَّه تناوَلَ وهو يعلَمُ منزلةَ مُوسى عليه السَّلامُ مِن بَني إسرائيلَ، وحِفْظَه لهم، لا يعلَمُ النَّاسُ إلَّا إنَّما ذلك مِن الرَّضاعِ إلَّا أُمُّ مُوسى، إلَّا أنْ يكونَ اللهُ عَزَّ وجَلَّ أَطْلَعَ مُوسى عليه السَّلامُ مِن ذلك على ما لم يُطْلِعْ عليه غيرَه. فوكَزَ مُوسى عليه السَّلامُ الفرعونيَّ، فقتَلَه، وليس يراهما أحدٌ إلَّا اللهُ عَزَّ وجَلَّ، فقال مُوسى عليه السَّلامُ حين قتَلَ الرَّجلَ: هذا مِن عمَلِ الشَّيطانِ؛ إنَّه عدُوٌّ مُضِلٌّ مُبينٌ، ثمَّ قال: {رَبِّ إِنِّي ظَلَمْتُ}، إلى قولِه: {إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ} [القصص: 16].\n{فَأَصْبَحَ فِي الْمَدِينَةِ خَائِفًا يَتَرَقَّبُ} [القصص: 18] الأخبارَ، فأُتِيَ فِرعونُ فقيلَ: إنَّ بني إسرائيلَ قد قتَلَتْ رجُلًا مِن آلِ فرعونَ، فخُذْ لنا بحَقِّنا، ولا تُرخِّصْ لهم، فقال: ابْغُوني قاتِلَه ومَن شهِدَ عليه؛ فإنَّ الملِكَ وإنْ كان صَفْوُه مع قومِه، لا يستقيمُ له أنْ يُقِيدَ بغيرِ بيِّنةٍ، ولا ثَبَتٍ، فانْظُروا في عِلْمِ ذلك آخُذْ لكم بحَقِّكم، فبينا هم يَطوفونَ لا يَجِدونَ شيئًا، إذا موسى عليه السَّلامُ قد رأى في الغدِ ذلك الإسرائيليَّ يقتُلُ رجُلًا مِن آلِ فرعونَ آخرَ، فاستغاثَه الإسرائيليُّ على الفرعونيِّ، فصادَفَ مُوسى عليه السَّلامُ قد ندِمَ على ما كان منه، فكَرِهَ الَّذي رأى، فغضِبَ الإسرائيليُّ وهو يُريدُ أنْ يبطِشَ بالفرعونيِّ، فقال للإسرائيليِّ -لِمَا فعَلَ أمسِ واليومَ-: {إِنَّكَ لَغَوِيٌّ مُبِينٌ} [القصص: 18]. فنظَرَ الإسرائيليُّ إلى مُوسى عليه السَّلامُ بعدما قال له ما قال، فإذا هو غضبانُ كغضَبِه بالأمسِ الَّذي قتَلَ به الفرعونيَّ، فخاف أنْ يكونَ بعدما قال له: {إِنَّكَ لَغَوِيٌّ مُبِينٌ} إيَّاه أراد، ولم يكُنْ أراده، إنَّما أراد الفرعونيَّ، فخاف الإسرائيليُّ، فحاجَزَ الفرعونيَّ، فقال: {يَا مُوسَى أَتُرِيدُ أَنْ تَقْتُلَنِي كَمَا قَتَلْتَ نَفْسًا بِالْأَمْسِ} [القصص: 19]؟ وإنَّما قال ذلك؛ مخافةَ أنْ يكون إيَّاهُ أراد مُوسى عليه السَّلامُ أنْ يقتُلَه، فتنازَعَا. فانطلَقَ الفرعونيُّ إلى قومِه، فأخبَرَهم بما سمِعَ مِن الإسرائيليِّ مِن الخبرِ حين يقولُ: {أَتُرِيدُ أَنْ تَقْتُلَنِي كَمَا قَتَلْتَ نَفْسًا بِالْأَمْسِ} [القصص: 19]، فأرسَلَ فرعونُ الذَّبَّاحينَ ليقتُلوا موسى عليه السَّلامُ، فأخَذَ رُسلُ فرعونَ الطَّريقَ الأعظمَ يَمْشون على هَيئتِهم يطلُبونَ مُوسى عليه السَّلامُ، وهم لا يخافونَ أنْ يفوتَهم، فجاء رجُلٌ مِن شِيعَةِ مُوسى عليه السَّلامُ مِن أَقْصى المدينةِ، فاختصَرَ طريقًا قريبًا حتَّى سبَقَهم إلى موسى عليه السَّلامُ فأخْبَرَه. فذلك مِن الفُتونِ يا ابنَ جُبيرٍ.\nفخرَجَ مُوسى عليه السَّلامُ مُتوجِّهًا نحوَ مدينَ لم يلْقَ بلاءً قبلَ ذلك، وليس له علمٌ بالطَّريقِ إلَّا حُسْنَ الظَّنِّ بربِّه عَزَّ وجَلَّ، فإنَّه قال: {عَسَى رَبِّي أَنْ يَهْدِيَنِي سَوَاءَ السَّبِيلِ} [القصص: 22].\n{وَلَمَّا وَرَدَ مَاءَ مَدْيَنَ وَجَدَ عَلَيْهِ أُمَّةً مِنَ النَّاسِ يَسْقُونَ} إلى {تَذُودَانِ} [القصص: 23]، يعني بذلك: حابستَينِ غنَمَهما، فقال لهما: ما خطْبُكما مُعتزلتَينِ لا تَسْقيانِ مع النَّاسِ؟ قالتا: ليس لنا قُوَّةٌ نُزاحِمُ القومَ، وإنَّما ننتظِرُ فُضولَ حياضِهم، فسقى لهما، فجعَلَ يغرِفُ بالدَّلْوِ ماءً كثيرًا، حتَّى كانتا أوَّلَ الرِّعاءِ فراغًا، فانصرَفَتا بغنَمِهما إلى أبيهما، وانصرَفَ موسى عليه السَّلامُ، فاستظَلَّ بشجرةٍ، وقال: {رَبِّ إِنِّي لِمَا أَنْزَلْتَ إِلَيَّ مِنْ خَيْرٍ فَقِيرٌ} [القصص: 24]، فاستنكَرَ أبوهما سُرعةَ صُدورِهما بغنَمِهما حُفَّلًا بطانًا، فقال: إنَّ لكما اليومَ لشأنًا، فأخبَرَتَاه بما صنَعَ موسى عليه السَّلامُ، فأمَرَ إحداهما أنْ تَدْعُوَه له، فأتَتْ موسى عليه السَّلامُ فدَعَتْه، فلمَّا كلَّمَه قال: {لَا تَخَفْ نَجَوْتَ مِنَ الْقَوْمِ الظَّالِمِينَ} [القصص: 25]، ليس لفِرعونَ ولا لقومِه علينا سُلطانٌ، ولسْنا في مَمْلكتِه.\nقال: فقالت إحداهما: {يَا أَبَتِ اسْتَأْجِرْهُ إِنَّ خَيْرَ مَنِ اسْتَأْجَرْتَ الْقَوِيُّ الْأَمِينُ} [القصص: 26]، فاحتمَلَتْه الغَيرةُ على أنْ قال: وما يُدريكِ ما قُوَّتُه؟ وما أمانَتُه؟ قالت: أمَّا قُوَّتُه: فما رأيْتُ في الدَّلوِ حين سَقى لنا، لم أرَ رجُلًا قطُّ في ذلك المَسْقى أقوى منه، وأمَّا أمانَتُه: فإنَّه نظَرَ إليَّ حين أقبلْتُ إليه وشَخَصْتُ له، فلمَّا علِمَ إنِّي امرأةٌ، صوَّبَ رأْسَه لم يرفَعْه، ولم ينظُرْ إليَّ حتَّى بلَّغْتُه رِسالتَك، ثمَّ قال لي: امشِي خلفي، وانْعَتي لي الطَّريقَ، لم يفعَلْ هذا إلَّا وهو أمينٌ، فسُرِّيَ عن أبيها وصدَّقَها، وظَنَّ به الَّذي قالت له.\nفقال له: هل لك {أَنْ أُنْكِحَكَ إِحْدَى ابْنَتَيَّ هَاتَيْنِ}، إلى قوله: {مِنَ الصَّالِحِينَ} [القصص: 27]، ففعَلَ، فكانت على نَبِيِّ اللهِ موسى عليه السَّلامُ ثمانيَ سنينَ واجبةً، وكانت سنتانِ عِدَةً منه، فقَضَى اللهُ عَزَّ وجَلَّ عنه عِدَتَه فأتمَّها عشْرًا.\nقال سَعيدٌ: فلَقِيَني رجُلٌ مِن أهلِ النَّصرانيَّةِ مِن عُلمائِهم، فقال: هلْ تَدْري أيَّ الأجلينِ قضى مُوسى عليه السَّلامُ؟ قلْتُ: لا، وأنا يومئذٍ لا أدري، فلقِيتُ ابنَ عبَّاسٍ، فذكَرْتُ ذلك له، فقال: أمَا علِمْتَ أنَّ ثمانيًا كانت على نبيِّ اللهِ عليه السَّلامُ واجبةً، لم يكُنْ نبيُّ اللهِ ليَنْقُصَ منها شيئًا، وتعلَمُ أنَّ اللهَ عَزَّ وجَلَّ كان قاضيًا عن مُوسى عليه السَّلامُ عِدَتَه الَّتي وعَدَ، فإنَّه قضى عشْرَ سنينَ. فلقِيتُ النَّصرانيَّ، فأخبَرْتُه بذلك، فقال: الَّذي سألْتَه فأخبَرَك أعلَمُ منك بذلك؟ قلْتُ: أجلْ، وأَولى.\nفلمَّا سار مُوسى عليه السَّلامُ بأهلِه كان مِن أمْرِ النَّارِ ما قَصَّ اللهُ عليك في القُرآنِ، وأمْرِ العصا ويَدِه، فشكا إلى ربِّه عَزَّ وجَلَّ ما يتخوَّفُ مِن آلِ فرعونَ في القتيلِ، وعُقدةَ لسانِه، فآتاهُ اللهُ عَزَّ وجَلَّ سُؤْلَه، وحَلَّ عُقدةً مِن لسانِه، وأوحى اللهُ عَزَّ وجَلَّ إلى هارونَ عليه السَّلامُ، وأمَرَه أنْ يلقاهُ، واندفَعَ مُوسى عليه السَّلامُ بعصاهُ، حتَّى لقِيَ هارونَ عليه السَّلامُ، وانطلَقَا جميعًا إلى فرعونَ، فأقاما حِينًا على بابِه لا يُؤْذَنُ لهما، فقالا: إنَّا رسولَا ربِّك، قال: فمَن ربُّكما يا موسى؟ فأخبراهُ بالَّذي قَصَّ اللهُ عَزَّ وجَلَّ عليك في القُرآنِ، قال: فما تُريدانِ؟ وذكَّرَه القتيلَ، واعتذَرَ بما قد سمِعْتَ، وقال: أريدُ أنْ تُؤمِنَ باللهِ، وأنْ تُرْسِلَ معي بني إسرائيلَ، فأبى عليه، وقال: ائتِ بآيةٍ إنْ كنْتَ مِن الصَّادقينَ، فألقى عصاه فإذا هي حيَّةٌ عظيمةٌ، فازعةٌ، فاغرةٌ فاها، مُسرعةٌ إلى فرعونَ، فلمَّا رآها فِرعونُ قاصدةً إليه خافها، فاقتحَمَ عن سَريرِه، واستغاثَ بمُوسى عليه السَّلامُ أنْ يكُفَّها عنه، ففعَلَ، ثمَّ أخرَجَ يَدَه مِن جَيْبِه، فرآها بيضاءَ مِن غيرِ سُوءٍ، يعني: مِن غيرِ برَصٍ، فرَدَّها، فعادت إلى لونِها الأوَّلِ.\nفاستشارَ الملَأَ حولَه فيما رأى، فقالوا له: {هَذَانِ لَسَاحِرَانِ يُرِيدَانِ أَنْ يُخْرِجَاكُمْ مِنْ أَرْضِكُمْ} [طه: 63] الآيةَ، والمُثْلى: مُلْكُهم الَّذي هم فيه والعيشُ. فأَبَوا على مُوسى عليه السَّلامُ أنْ يُعْطُوه شيئًا ممَّا طلَبَ، وقالوا له: اجمَعْ لهما السَّحرةَ؛ فإنَّهم بأرضِك كثيرٌ، حتَّى نغلِبَ سِحْرَهما، وأرسَلَ في المدائنِ، فحُشِرَ له كلُّ ساحرٍ مُتعالمٍ، فلمَّا أَتَوا على فرعونَ، قالوا: ما يعمَلُ هذا السَّاحرُ؟ قالوا: يعمَلُ الحيَّاتِ، قالوا: فلا واللهِ ما أحدٌ في الأرضِ يعمَلُ السِّحرَ والحيَّاتِ والحبالَ والعِصِيَّ الَّذي نعمَلُ، فما أجْرُنا إنْ نحن غلَبْنا؟ قال لهم: أنتم أقاربي وخاصَّتي، وأنا صانعٌ إليكم كلَّ شَيءٍ أحببتم، فتَواعَدوا يومَ الزِّينةِ وأنْ يُحْشَرَ النَّاسُ ضُحًى.\nقال سعيدٌ: فحدَّثني ابنُ عبَّاسٍ: أنَّ يومَ الزِّينةِ اليومُ الَّذي أظهَرَ اللهُ عَزَّ وجَلَّ فيه مُوسى عليه السَّلامُ على فِرعونَ والسَّحرةِ هو يومُ عاشوراءَ.\nفلمَّا اجتمعوا في صَعيدٍ، قال النَّاسُ بعضُهم لبعضٍ: انطَلِقوا، فنتخبَّرْ هذا الأمْرَ، {لَعَلَّنَا نَتَّبِعُ السَّحَرَةَ إِنْ كَانُوا هُمُ الْغَالِبِينَ} [الشعراء: 40]، يعنون مُوسى وهارونَ عليهما السَّلامُ؛ استهزاءً بهما، فقالوا: يا موسى -لِقُدْرتِهم في أنفُسِهم بسِحْرِهم- إمَّا أنْ تُلْقِيَ، وإمَّا أنْ نكونَ نحن المُلْقينَ، قال: بل ألْقُوا. {فَأَلْقَوْا حِبَالَهُمْ وَعِصِيَّهُمْ وَقَالُوا بِعِزَّةِ فِرْعَوْنَ إِنَّا لَنَحْنُ الْغَالِبُونَ} [الشعراء: 44]، فرأى مُوسى عليه السَّلامُ مِن سِحْرِهم ما أوجَسَ في نفْسِه خِيفةً، فأوحى اللهُ عَزَّ وجَلَّ إليه: أنْ ألْقِ عصاك، فلمَّا ألقاها، صارت ثُعبانًا عظيمًا فاغرةً فاها، فجُعِلَتِ العِصِيُّ بدَعوةِ مُوسي عليه السَّلامُ تلتبِسُ بالحبالِ، حتَّى صارتْ جُرُزًا إلى الثُّعبانِ تَدخُل فيه، حتَّى ما أبقَتْ عصًا ولا حبلًا إلَّا ابتلعَتْه. فلمَّا عرَفَ السَّحرةُ ذلك، قالوا: لو كان هذا سِحرٌ لم يَبلُغْ مِن سِحرِنا كلَّ هذا، ولكنَّه أمْرٌ مِن اللهِ، آمنَّا باللهِ ربِّنا وما جاء به مُوسى عليه السَّلامُ، ونتوبُ إلى اللهِ عَزَّ وجَلَّ ممَّا كنَّا عليه. وكسَرَ اللهُ ظهْرَ فِرعونَ في ذلك الموطنِ وأشياعِه، وأظهَرَ الحقَّ، وبطَلَ ما كانوا يعمَلونَ، فغُلِبوا هنالك وانقَلَبوا صاغِرينَ. وامرأةُ فِرعونَ بارزةٌ مُتبذِّلَةٌ تَدْعو بالنَّصرِ لمُوسى عليه السَّلامُ على فِرعونَ، فمَن رآها مِن آلِ فرعونَ ظَنَّ أنَّها إنَّما تبذَّلَتْ للشفقةِ على فِرعونَ وأشياعِه، وإنَّما كان حُزْنُها وهمُّها لمُوسى عليه السَّلامُ. فلمَّا طال مُكْثُ مُوسى عليه السَّلامُ لمواعيدِ فِرعونَ الكاذبةِ، كلَّما جاءه بآيةٍ وعَدَه عندها أنْ يُرْسِلَ معه بني إسرائيلَ، فإذا مضَتْ أخلَفَ موعِدَه، وقال: هل يستطيعُ ربُّك أنْ يصنَعَ غيرَ هذا؟ فأرسَلَ اللهُ عليه وعلى قومِه الطُّوفانَ، والجرادَ، والقُمَّلَ، والضَّفادعَ، آياتٍ مُفصَّلاتٍ، كلُّ ذلك يَشْكو إلى موسى عليه السَّلامُ، ويطلُبُ إليه أنْ يكُفَّها عنه، ويُواثِقُه على أنْ يُرسِلَ معه بني إسرائيلَ، فإذا كَفَّ ذلك عنه، أخلَفَ موعِدَه ونكَثَ عهدَه. فأُمِرَ موسى عليه السَّلامُ بالخُروجِ بقومِه، فخرَجَ بهم ليلًا، فلمَّا أصبَحَ فرعونُ ورأى أنَّهم قد مَضَوا، أرسَلَ في المدائنِ حاشرينَ، فتبِعَهم بجُنودٍ عظيمةٍ كثيرةٍ، وأوحى اللهُ عَزَّ وجَلَّ إلى البحرِ: أنْ إذا ضرَبَك مُوسى بعصاهُ، فانفرِقْ له اثنتَيْ عشْرةَ فِرقةً، حتَّى يجوزَ موسى عليه السَّلامُ ومَن معه، ثمَّ الْتَئَمَ على مَن بقِيَ بعدُ مِن فرعونَ وأشياعِه، فنسِيَ مُوسى عليه السَّلامُ أنْ يضرِبَ البحرَ بالعصا، فانْتَهى إلى البحرِ وله قصيفٌ؛ مخافةَ أنْ يَضرِبَه موسى عليه السَّلامُ، وهو غافِلٌ، فيصيرَ عاصيًا اللهَ عَزَّ وجَلَّ. فلمَّا تراءى الجَمْعانِ وتقارَبَا، قال أصحابُ موسى: إنَّا لمُدْرَكونَ، افعَلْ ما أمرَكَ به ربُّك عَزَّ وجَلَّ؛ فإنَّك لم تكذِبْ ولم تُكْذَبْ، فقال: وعَدَني ربِّي عَزَّ وجَلَّ إذا أتيْتُ البحرَ، انفرَقَ لي اثنتيْ عشْرةَ فِرقةً حتَّى أُجاوزَه، ثمَّ ذكَرَ بعدَ ذلك العصا، فضرَبَ البحرَ بعصاه حين دنا أوائلُ جُندِ فرعونَ مِن أواخرِ جُندِ مُوسى عليه السَّلامُ، فانفرَقَ البحرُ كما أمَرَه اللهُ عَزَّ وجَلَّ، وكما وُعِدَ مُوسى عليه السَّلامُ، فلمَّا أنْ جاوَزَ موسى عليه السَّلامُ وأصحابُه البحرَ، ودخَلَ فِرعونُ وأصحابُه، الْتَقى عليهم البحرُ كما أُمِرَ. فلمَّا جاوَزَ مُوسى عليه السَّلامُ البحرَ، قال أصحابُه: إنَّا نخافُ ألَّا يكونَ فِرعونُ قد غرِقَ، فلا نُؤمِنُ بهلاكِه، فدعا ربَّه عَزَّ وجَلَّ، فأخرَجَه له ببدنه حتَّى استيْقَنوا بهلاكِه.\nثمَّ مَرُّوا بعدَ ذلك {عَلَى قَوْمٍ يَعْكُفُونَ عَلَى أَصْنَامٍ لَهُمْ قَالُوا يَا مُوسَى اجْعَلْ لَنَا إِلَهًا كَمَا لَهُمْ آلِهَةٌ} [الأعراف: 138]، إلى {وَبَاطِلٌ مَا كَانُوا يَعْمَلُونَ} [الأعراف: 139]، قد رأيتُمْ مِن العِبَرِ، وسمِعْتُم ما يَكْفيكم، ومَضَى. فأنزَلَهم مُوسى عليه السَّلامُ منزلًا، ثمَّ قال لهم: أطيعوا هارونَ عليه السَّلامُ؛ فإنِّي قد استخلفْتُه عليكم، وإنِّي ذاهبٌ إلى ربِّي عَزَّ وجَلَّ، وأجَّلَهم ثلاثينَ يومًا أنْ يَرجِعَ إليهم فيها، فلمَّا أتى ربَّه وأراد أنْ يُكلِّمَه ثلاثينَ يومًا، وقد صامهنَّ: ليلَهنَّ ونهارَهنَّ، وكرِهَ أنْ يُكلِّمَ ربَّه عَزَّ وجَلَّ ورِيحُ فَمِه رِيحُ فَمِ الصَّائمِ، فتناوَلَ مُوسى عليه السَّلامُ مِن نباتِ الأرضِ شيئًا فمضَغَه، فقال له ربُّه عَزَّ وجَلَّ حين لقاه: لِمَ أفطرْتَ؟ -وهو أعلَمُ بالَّذي كان- قال: يا ربِّ، إنِّي كرِهْتُ أنْ أُكلِّمَك إلَّا وفَمِي طيِّبُ الرِّيحِ، قال: أوما علِمْتَ يا مُوسى أنْ رِيحَ فَمِ الصَّائمِ أطيبُ عندي مِن رِيحِ المِسْكِ؟ ارجِعْ حتَّى تصومَ عشْرًا ثمَّ ائْتِني، ففعَلَ مُوسى عليه السَّلامُ ما أُمِرَ به.\nفلمَّا رأى قومُ مُوسى عليه السَّلامُ أنَّه لم يرجِعْ إليهم للأجَلِ ساءَهم ذلك، وكان هارونُ عليه السَّلامُ قد خطَبَهم، فقال لهم: خرجْتُم مِن مِصْرَ ولقومِ فرعونَ عندي عواري وودائعُ، ولكم فيهم مثلُ ذلك، وأنا أرى أنْ تحتَسِبوا ما لكم عندهم، ولا أحلَّ لكم وديعةً اسْتُودِعْتُمُوها، ولا عاريَّةً، ولسنا برادِّين إليهم شيئًا مِن ذلك، ولا مُمْسِكيه لأنفُسِنا، فحفَرَ حفيرًا، وأمَرَ كلَّ قومٍ عليهم شَيءٌ مِن ذلك؛ مِن متاعٍ أو حِليةٍ أنْ يَقْذِفوه في ذلك الحفيرِ، ثمَّ أوقَدَ عليه النَّارَ، فأحرَقَه، فقال: لا يكونُ لنا، ولا لهم.\nوكان السَّامريُّ رجلًا مِن قومٍ يَعْبُدون البقرَ جيرانٍ لهم، ولم يكُنْ مِن بني إسرائيلَ، فاحتملَ مع مُوسى عليه السَّلامُ وبني إسرائيلَ حين احْتملوا، فقُضِيَ له أنْ رأى أثرًا، فأخَذَ منه بقبْضَتِه، فمَرَّ بهارونَ، فقال له هارونُ عليه السَّلامُ: يا سامريُّ، ألَا تُلْقي ما في يدَيْك؟ وهو قابضٌ عليه لا يَراه أحدٌ طوالَ ذلك، فقال: هذه قبْضةٌ مِن أثرِ الرَّسولِ الَّذي جاوَزَ بكم البحرَ، ولا أُلْقيها لشَيءٍ إلَّا أنْ تَدْعُوَ اللهَ إذا ألقيْتُها أنْ تكونَ ما أُرِيدُ، فألْقاها، ودعا اللهَ هارونُ عليه السَّلامُ، فقال: أريدُ أنْ يكونَ عِجْلًا، واجتمَعَ ما كان في الحُفرةِ مِن متاعٍ له، أو حِلْيةٍ، أو نحاسٍ، أو حديدٍ، فصار عِجْلًا أجوفَ ليس فيه رُوحٌ، له خُوارٌ.\nقال ابنُ عبَّاسٍ: لا واللهِ ما كان له صوتٌ قطُّ، إنَّما كانت الرِّيحُ تدخُلُ مِن دُبُرِه وتخرُجُ مِن فَمِه، فكان ذلك الصَّوتُ مِن ذلك.\nفتفرَّقَ بنو إسرائيلَ فِرَقًا؛ فقالت فِرقةٌ: يا سامريُّ، ما هذا فأنت أعلَمُ به؟ قال: هذا ربُّكم عَزَّ وجَلَّ، ولكنَّ مُوسى عليه السَّلامُ أضَلَّ الطَّريقَ. وقالت فِرقةٌ: لا نُكذِّب بهذا حتَّى يرجِعَ إلينا مُوسى، فإنْ كان ربَّنا لم نكُنْ ضيَّعْناه وعجَزْنا فيه حِينَ رأيْناه، وإنْ لم يكُنْ ربَّنا، فإنَّا نتَّبِعُ قولَ مُوسى عليه السَّلامُ. وقالت فِرقةٌ: هذا عمَلُ الشَّيطانِ، وليس بربِّنا، ولا نُؤْمِنُ، ولا نُصدِّقُ.\nوأُشْرِبَ فِرقةٌ في قُلوبِهم التَّصديقَ بما قال السَّامريُّ في العجلِ، وأعْلَنوا التَّكذيبَ، فقال لهم هارونُ عليه السَّلامُ: {يَا قَوْمِ إِنَّمَا فُتِنْتُمْ بِهِ} [طه: 90]، وإنَّ ربَّكم ليس هكذا، قالوا: فما بالُ مُوسى عليه السَّلامُ؛ وعَدَنا ثلاثينَ يومًا ثمَّ أخلَفَنا، فهذه أربعونَ قد مَضَت؟! فقال سُفهاؤُهم: أخطَأَ ربَّه، فهو يطلُبُه ويتبَعُه. فلمَّا كلَّمَ اللهُ عَزَّ وجَلَّ مُوسى عليه السَّلامُ وقال له ما قال، أخبَرَه بما لقِيَ قومُه بعده. {فَرَجَعَ مُوسَى إِلَى قَوْمِهِ غَضْبَانَ أَسِفًا} [طه: 86]، وقال لهم ما سمِعْتُم في القُرآنِ وأخَذَ برأْسِ أخِيه، وألْقى الألواحَ مِن الغضَبِ، ثمَّ عذَرَ أخاه بعُذْرِه، واستغفَرَ له، وانصرَفَ إلى السَّامريِّ، فقال له: ما حمَلَك على ما صنعْتَ؟ قال: قبَضْتُ قبضةً مِن أثرِ الرَّسولِ وفطِنْتُ لها، وعُمِّيَت عليكم، فقَذفْتُها؛ وكذلك سوَّلَت لي نَفْسي.\nقال: {اذْهَبْ فَإِنَّ لَكَ فِي الْحَيَاةِ أَنْ تَقُولَ لَا مِسَاسَ وَإِنَّ لَكَ مَوْعِدًا لَنْ تُخْلَفَهُ وَانْظُرْ إِلَى إِلَهِكَ} إلى قولِه: {نَسْفًا} [طه: 97]، ولو كان إلهًا لم يُخْلَصْ إلى ذلك منه. فاستيقَنَ بنو إسرائيلَ بالفتنةِ، واغْتَبَطَ الَّذين كان رأيُهم فيه مثلَ رأيِ هارونَ عليه السَّلامُ، فقالوا بجماعتِهم لمُوسى عليه السَّلامُ: سَلْ لنا ربَّك عَزَّ وجَلَّ أنْ يفتَحَ لنا بابَ توبةٍ نصنَعُها؛ فيُكَفِّرَ عنَّا ما عمِلْنا، فاختارَ موسى عليه السَّلامُ قومَه سبعينَ رجُلًا لذلك -لا يأْلُو الخيرَ- خيارَ بني إسرائيلَ، ومَن لم يُشْرِكْ في العجلِ. فانطلَقَ بهم ليسأَلَ لهم التَّوبةَ، فرجَفَتْ بهم الأرضُ، فاستحيا نبيُّ اللهِ صَلَّى اللهُ عليه وسلَّمَ من قومِه ووفْدِه حين فُعِلَ بهم ما فُعِلَ، فقال: {رَبِّ لَوْ شِئْتَ أَهْلَكْتَهُمْ مِنْ قَبْلُ وَإِيَّايَ أَتُهْلِكُنَا بِمَا فَعَلَ السُّفَهَاءُ مِنَّا} [الأعراف: 155]، وفيهم مَن قد كان اللهُ عَزَّ وجَلَّ اطَّلَعَ على ما أُشْرِبَ قلبُه من حُبِّ العجلِ وإيمانِه به؛ فلذلك رجَفَت بهم الأرضُ.\nفقال: {وَرَحْمَتِي وَسِعَتْ كُلَّ شَيْءٍ فَسَأَكْتُبُهَا لِلَّذِينَ يَتَّقُونَ} [الأعراف: 156] إلى: {فِي التَّوْرَاةِ وَالْإِنْجِيلِ} [الأعراف: 157]، فقال: رَبِّ سألْتُك التَّوبةَ لقومي، فقلْتَ: إنَّ رحمتي كتبْتُها لقومٍ غيرِ قومي، فليتَكَ أخَّرْتَني حين تُخْرِجُني حيًّا في أُمَّةِ ذلك الرَّجلِ المرحومةِ، فقال اللهُ له: إنَّ توبتَهم أنْ يقتُلَ كلُّ رجُلٍ منهم مَن لقِيَ مِن والدٍ أو ولدٍ، فيقتُلَه بالسَّيفِ لا يُبَالي مَن قتَلَ في ذلك الموطنِ، وتاب أولئك الَّذين كان خفِيَ على موسى وهارونَ عليهما السلام ما اطَّلَعُ اللهُ عليهم من ذُنوبِهم، فاعتَرَفوا بها، وفعَلوا ما أُمِروا، وغفَرَ اللهُ للقاتِلِ والمقتولِ. ثمَّ سار بهم مُوسى عليه السَّلامُ مُتوجِّهًا نحوَ الأرضِ المُقدَّسةِ، وأخَذَ الألواحَ بعدما سكَتَ عنه الغضبُ، وأمَرَهم بالَّذي أُمِرَ به أنْ يُبَلِّغَهم من الوظائفِ، فثقُلَ ذلك عليهم، وأبَوا أنْ يُقِرُّوا بها، فنتَقَ اللهُ عليهم الجبلَ كأنَّه ظُلَّةٌ، ودنا منهم حتَّى خافوا أنْ يقَعَ عليهم، فأخَذُوا الكتابَ بأيمانِهم وهم يَصْغُون ينظُرونَ إلى الجبلِ والأرضِ، والكتابُ بأيديهم وهم يَنظُرونَ إلى الجبلِ؛ مخافةَ أنْ يقَعَ عليهم، ثمَّ مَضَوا إلى الأرضِ المُقدَّسةِ، فوَجَدوا مدينةَ قومٍ جبَّارينَ خَلْقُهم مُنْكرٌ، وذكَرَ من ثِمارِهم أمرًا عجَبًا من عِظَمِها، فقالوا: يا موسى، إنَّ فيها قومًا جبَّارينَ لا طاقةَ لنا بهم، ولا ندخُلُها ما داموا فيها، فإنْ يَخْرجوا منها فإنَّا داخِلونَ، قال رجُلانِ من الَّذين يَخافونَ مِن الجبَّارينَ: آمنَّا بمُوسى عليه السَّلامُ، فخرَجَا إليه، فقالا: نحنُ أعلَمُ بقومِنا، إنْ كنتُمْ إنَّما تَخافونَ ما رأيتُمْ من أجسامِهم وعدَدِهم، فإنَّهم لا قُلوبَ لهم، ولا مَنعةَ عندهم، فادْخُلوا عليهم البابَ، فإذا دخلْتُموه فإنَّكم غالِبونَ. ويقولُ أناسٌ: إنَّهما من قومِ مُوسى عليه السَّلامُ. وزعَمَ سعيدُ بنُ جُبيرٍ أنَّهما من الجبَّارينَ آمَنَا بمُوسى، بقولِه: {مِنَ الَّذِينَ يَخَافُونَ} [المائدة: 23]: إنَّما عَنى بذلك: مِن الَّذين يَخافونَ بني إسرائيلَ.\n{قَالُوا يَا مُوسَى إِنَّا لَنْ نَدْخُلَهَا أَبَدًا مَا دَامُوا فِيهَا فَاذْهَبْ أَنْتَ وَرَبُّكَ فَقَاتِلَا إِنَّا هَاهُنَا قَاعِدُونَ} [المائدة: 24]، فأغْضَبوا مُوسَى عليه السَّلامُ، فدعا عليهم، وسمَّاهم فاسقينَ، ولم يدْعُ عليهم قبلَ ذلك؛ لِمَا رأى منهم من المعصيةِ وإساءتِهم حتَّى كان يومئذٍ، فاستجابَ اللهُ عَزَّ وجَلَّ له، فسمَّاهم كما سمَّاهم مُوسى عليه السَّلامُ فاسقينَ، فحرَّمَها عليهم أربعينَ سَنةً يَتِيهون في الأرضِ؛ يُصْبِحون كلَّ يومٍ، فيَسِيرونَ ليس لهم قرارٌ، ثمَّ ظلَّلَ عليهم الغمامَ في التِّيهِ، وأنزَلَ عليهم المَنَّ والسَّلوى، وجعَلَ لهم ثيابًا لا تَبْلى، ولا تتَّسِخُ، وجعَلَ بين ظَهرِهم حَجرًا مُربَّعًا، وأمَرَ مُوسى عليه السَّلامُ فضرَبَه بعصاهُ، فانفجَرَ منه اثنتا عشْرةَ عينًا، في كلِّ ناحيةٍ ثلاثةُ أعينٍ، وأعلَمَ كلَّ سِبْطٍ عينَهم الَّتي يَشْربون منها، فلا يَرْتحِلونَ من مَنزلٍ إلَّا وجدوا ذلك الحجرَ منهم بالمكانِ الَّذي كان منه أمسِ.»","narrator":"عبدالله بن عباس","source":"إتحاف الخيرة المهرة (6/234)","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/n97bkyvU","nameForm":"الْغَفُورُ الرَّحِيمُ","scene":"سأل سعيد بن جبير ابن عباس عن ﴿وَفَتَنَّاكَ فُتُونًا﴾ فحدثه حديث الفتون الطويل: ولادة موسى في عام الذبح، وإلقاؤه في اليم، وقتله القبطي ثم قوله ﴿رَبِّ إِنِّي ظَلَمْتُ نَفْسِي فَاغْفِرْ لِي فَغَفَرَ لَهُ إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ﴾، وهربه إلى مدين ورجوعه.","reason":"في سلسلة فتون موسى كانت لحظة القتل الخطأ ثم الاعتراف فالمغفرة الفورية؛ فالغفور الرحيم في تفسير ابن عباس يظهر في لحظة سقوط نبي ثم قيامه بكلمة اعتراف.","adds":"المغفرة الفورية في وسط سلسلة الفتون: اعتراف فغفران."},{"i":13,"of":33,"text":"قالَ اللهُ تعالى : يا ابنَ آدمَ ! ثلاثةٌ : واحدةٌ لي، وواحدةٌ لكَ، وواحدةٌ بيني وبينكَ . فأمَّا التي لي ؛ فتعبدُني لا تشركْ بي شيئًا، وأما التي لك ؛ فما عملتَ منْ عملٍ جزيتُك بهِ ؛ فإنْ أَغْفِرْ فأنا الغفورُ الرحيمُ، وأما التي بيني وبينكَ، فعليكَ الدعاءُ والمسألةُ، وعليَّ الاستجابةُ","narrator":"سلمان الفارسي","source":"الجامع الصغير 6050","grade":"حسن","url":"https://dorar.net/h/1eEbnlw4","nameForm":"الْغَفُورُ الرَّحِيمُ","scene":"قال النبي ﷺ: «قال الله تعالى: يا ابن آدم ثلاثة: واحدة لي وواحدة لك وواحدة بيني وبينك؛ فأما التي لي فتعبدني لا تشرك بي شيئًا، وأما التي لك فما عملت من عمل جزيتك به، فإن أغفر فأنا الغفور الرحيم، وأما التي بيني وبينك فعليك الدعاء والمسألة وعلي الاستجابة».","reason":"في القسمة الإلهية الثلاثية جاء الاسم في حق العبد: يُجزى بعمله، فإن غُفر له فذلك من الغفور الرحيم؛ فالمغفرة زائدة على الجزاء، والاسم بابها، والدعاء طريقها.","adds":"الجزاء بالعمل والمغفرة بالاسم: القسمة الثلاثية بين الله والعبد."},{"i":14,"of":33,"text":"«لمَّا ذُكِرَ مِن شأني الَّذي ذُكِرَ وما عَلِمْتُ بِهِ ، قامَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ فيَّ خطيبًا فتشَهَّدَ فحمِدَ اللَّهَ وأثنَى علَيهِ بما هوَ أَهْلُهُ ثمَّ قالَ : أمَّا بعدُ : أشيروا علَيَّ في أُناسٍ أبَنوا أَهْلي واللَّهِ ما عَلِمْتُ علَى أَهْلي مِن سوءٍ قطُّ وأبَنوا بمَن واللَّهِ ما عَلِمْتُ علَيهِ من سوءٍ قطُّ ولَا دخلَ بَيتي قطُّ إلَّا وأَنا حاضرٌ ولَا غِبتُ في سفرٍ إلَّا غابَ معي ، فقامَ سعدُ بنُ مُعاذٍ فقالَ : ائذَنْ لي يا رسولَ اللَّهِ أن أضربَ أعناقَهُم ، وقامَ رجلٌ من الخزرجِ وَكانتْ أمُّ حسَّانَ بنِ ثابتٍ من رَهْطِ ذلِكَ الرَّجلِ ، فقالَ : كذبتَ ، أما واللَّهِ أن لَو كانوا منَ الأوسِ ما أحببْتَ أن تُضرَبَ أعناقُهُم حتَّى كادَ أن يَكونَ بينَ الأوسِ والخزرجِ شرٌّ في المسجدِ وما عَلِمْتُ بِهِ ، فلمَّا كانَ مساءُ ذلِكَ اليومِ خرجتُ لبعضِ حاجَتي ومعي أُمُّ مِسطَحٍ فعثرَتْ ، فقالَت : تعِسَ مِسطَحٌ ، فقلتُ لَها : أيْ أُمُّ تَسُبِّينَ ابنَكِ ؟ فسَكَتتْ ، ثمَّ عثرَتِ الثَّانيةَ فقالَت : تعِسَ مِسطَحٌ ، فقلتُ لَها : أيْ أُمُّ تَسُبِّينَ ابنَكِ ؟ فسَكَتتْ ، ثمَّ عثرَتِ الثَّالثةَ فقالَت : تعِسَ مِسطَحٌ فانتَهَرتُها ، فقلتُ لَها : أيْ أُمُّ تَسُبِّينَ ابنَكِ ؟ فقالَت : واللَّهِ ما أسُبُّهُ إلَّا فيكِ ، فقلتُ : في أيِّ شأني ؟ قالت : فبقَرَتْ الحديثَ ، وقلتُ قد كانَ هذا ؟ قالت : نعم ، واللَّهِِ لقد رجعتُ إلى بَيتي وَكَأنَّ الَّذي خرجتُ لَهُ لم أخرُجْ . لَا أجدُ منهُ قليلًا ولَا كثيرًا ، وَوُعِكْتُ ، فقلتُ لرسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ : أرسِلْني إلى بيتِ أبي ، فأرسلَ معي الغُلامَ ، فدخلتُ الدَّارَ ، فوجدتُ أُمَّ رومانَ في السُّفلِ وأبو بكرٍ فَوقَ البيتِ يقرأُ ، فقالَت أُمِّي : ما جاءَ بِكِ يا بُنَيَّةُ ؟ قالت : فأخبرتُها ، وذَكَرتُ لَها الحديثَ ، فإذا هوَ لم يبلُغْ مِنها ما بلغَ منِّي ، فقالَت : يا بُنَيَّةُ خَفِّفي علَيكِ الشَّأنَ ، فإنَّهُ واللَّهِ لقلَّما كانت امرأةٌ حَسناءُ عندَ رجلٍ يحبُّها ، لَها ضرائرُ إلَّا حسدنَها وقيلَ فيها ، فإذا هيَ لم يبلُغْ مِنها ما بلغَ منِّي ، قالت : قلتُ : وقد علِمَ بِهِ أبي ؟ قالت : نعم ، قلتُ : ورسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ ؟ قالت : نعم ، واستعبَرْتُ وبَكَيتُ ، فسمِعَ أبو بكرٍ صَوتي وَهوَ فَوقَ البيتِ يقرأُ فنزلَ فقالَ لأُمِّي : ما شأنُها ؟ قالت : بلغَها الَّذي ذُكِرَ مِن شأنِها ، ففاضَتْ عَيناهُ ، فقالَ : أقسَمتُ علَيكِ يا بُنَيَّةُ إلَّا رجِعْتِ إلى بَيتِكِ ، فرجَعْتُ ، ولقد جاءَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ إلى بَيتي وسألَ عنِّي خادِمَتي فقالت : لَا واللَّهِ ما عَلِمْتُ علَيها عَيبًا إلَّا أنَّها كانت ترقُدُ حتَّى تدخُلَ الشَّاةُ فتأكُلَ خميرتَها أو عجينَتَها ، وانتَهَرَها بعضُ أصحابِهِ فقالَ : أَصدِقي رسولَ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ حتَّى أسقطوا لَها بِهِ فقالت : سبحانَ اللَّهِ واللَّهِ ما عَلِمْتُ علَيها إلَّا ما يعلمُ الصَّائغُ علَى تبرِ الذَّهبِ الأحمرِ ، فبلغَ الأمرُ ذلِكَ الرَّجلَ الَّذي قيلَ لَهُ ، فقالَ : سبحانَ اللَّهِ ، واللَّهِ ما كشفتُ كنفَ أُنثَى قطُّ ، قالت عائشةُ : فقُتِلَ شَهيدًا في سبيلِ اللَّهِ ، قالت : وأصبحَ أبَوايَ عندي فلمْ يزالَا عندي حتَّى دخلَ علَيَّ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وقد صلَّى العصرَ ، ثمَّ دخلَ وقد اكتنفَ أبَوايَ عن يميني وعن شمالي ، فتشَهَّدَ النَّبيُّ صلَّى اللَّهُ علَيهِ وسلَّمَ وحمِدَ اللَّهَ وأثنَى علَيهِ بما هوَ أهْلُهُ ، ثمَّ قالَ : أمَّا بعدُ يا عائشةُ ، إن كُنتِ قارفْتِ سوءًا أو ظلمْتِ فتوبي إلى اللَّهِ ، فإنَّ اللَّهَ يقبلُ التَّوبةَ عن عبادِهِ ، قالت : وقد جاءتْ امرأةٌ منَ الأنصارِ وَهيَ جالسةٌ بالبابِ ، فقلتُ : ألَا تستَحْيي من هذِهِ المرأةِ أن تذكرَ شيئًا ، ووعظَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ ، فالتفَتُّ إلى أبي فقُلتُ : أَجِبْهُ ، قالَ : فماذا أقولُ ؟ فالتفَتُّ إلى أُمِّي فقُلتُ : أجيبيهِ ، قالت : أقولُ ماذا ؟ قالت : فلمَّا لم يُجيبا تشَهَّدتُ فحَمِدْتُ اللَّهَ وأثنَيتُ علَيهِ بما هوَ أهْلُهُ ، ثمَّ قلتُ : أما واللَّهِ لئن قلتُ لَكُم إنِّي لم أفعلْ واللَّهُ يشهدُ إنِّي لصادقةٌ ما ذاكَ بنافِعي عندَكُم لي لقد تَكَلَّمتُمْ وأُشْرِبَتْ قلوبُكُم ، ولئن قلتُ إنِّي قد فعلتُ واللَّهُ يعلمُ أنِّي لم أفعلْ لتقولُنَّ إنَّها قد باءتْ بِهِ علَى نفسِها ، وإنِّي واللَّهِ ما أجدُ لي ولَكُم مثلًا . قالت : والتمستُ اسمَ يعقوبَ فلمْ أقدِرْ علَيهِ إلَّا أبا يوسفَ حينَ قالَ :  فَصَبْرٌ جَمِيلٌ وَاللَّهُ الْمُسْتَعَانُ عَلَى مَا تَصِفُونَ  قالت : وأُنْزِلَ علَى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ من ساعتِهِ ، فسَكَتنا ، فرُفِعَ عنهُ وإنِّي لأتبَيَّنُ السُّرورَ في وجهِهِ وَهوَ يمسحُ جبينَهُ ويقولُ : أبشِري يا عائشةُ ، فقد أنزلَ اللَّهُ براءتَكِ قالت : فَكُنتُ أشدَّ ما كنتُ غضبًا ، فقالَ لي أبَوايَ ، قومي إليهِ ، فقُلتُ : لَا واللَّهِ لَا أقومُ إليهِ ولَا أحمدُهُ ولَا أحمدُكُما ، ولَكِن أحمدُ اللَّهَ الَّذي أنزلَ براءَتي ، لقد سمِعتُموهُ فما أنكرتُموهُ ولَا غَيَّرتُموهُ ، وَكانت عائشةُ تقولُ : أمَّا زينبُ بنتُ جَحشٍ فعصمَها اللَّهُ بدينِها فلم تقُلْ إلَّا خَيرًا ، وأمَّا أُختُها حَمنَةُ فَهَلَكَتْ فيمَن هلَكَ ، وَكانَ الَّذي يتَكَلَّمُ فيهِ مِسطَحٌ وحسَّانُ بنُ ثابتٍ والمُنافقُ عبدُ اللَّهِ بنُ أُبَيٍّ وَكانَ يستَوشيهِ ويجمعُهُ ، وَهوَ الَّذي تَولَّى كِبرَهُ منهُم هوَ وحَمنَةُ ، قالت : فحلفَ أبو بكرٍ أن لَا ينفعَ مِسطَحًا بنافعةٍ أبدًا ، فأنزلَ اللَّهُ تعالى هذِهِ الآيةَ  وَلَا يَأْتَلِ أُولُو الْفَضْلِ مِنْكُمْ وَالسَّعَةِ  يعني أبا بكرٍ ،  أَنْ يُؤْتُوا أُولِي الْقُرْبَى وَالْمَسَاكِينَ وَالْمُهَاجِرِينَ فِي سَبِيلِ اللَّهِ  ، يعني مِسطَحًا ، إلى قولِهِ  أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللَّهُ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ  قالَ أبو بكرٍ : بلَى واللَّهِ يا ربَّنا ، إنَّا لنحِبُّ أن تغفرَ لَنا ، وعادَ لَهُ بما كانَ يصنعُ»","narrator":"عائشة أم المؤمنين","source":"صحيح الترمذي (3180)","grade":"صحيح","url":"https://dorar.net/h/j8FDRESJ","nameForm":"غَفُورٌ رَحِيمٌ","scene":"في حديث الإفك: قامت عائشة تحكي أن النبي ﷺ قام خطيبًا فقال: «أشيروا علي في أناس أبنوا أهلي، والله ما علمت على أهلي من سوء قط»، فقام سعد بن معاذ وسعد بن عبادة واختلف الحيان، ثم نزلت براءتها، وفيه حلف أبي بكر ألا ينفق على مسطح فنزلت ﴿وَلْيَعْفُوا وَلْيَصْفَحُوا أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللَّهُ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾ فقال أبو بكر: بلى، وأعاد النفقة.","reason":"الاسم نزل في أشد ما يكون العفو صعبًا: أبٌ جُرح في عرض ابنته يُدعى إلى العفو عمن خاض، فربط الله عفوه بمغفرة الغفور الرحيم له؛ فمن أراد المغفرة أعطى العفو.","adds":"أصعب عفو في السيرة رُبط بالغفور الرحيم: ألا تحبون أن يغفر الله لكم."},{"i":15,"of":33,"text":"سَمِعتُ أبا ماجدةَ يَقولُ: كُنتُ قاعدًا مع عبدِ اللهِ بنِ مَسعودٍ رَضيَ اللهُ عنه، فقال: إنِّي لا أذْكُرُ أوَّلَ رجُلٍ قَطَعَه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ؛ أُتِيَ بسارقٍ، فأمَرَ بقَطعِه، فكأنَّما أُسِفَ وجْهُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فقالوا: يا رَسولَ اللهِ، كأنَّك كَرِهْتَ قَطْعَه، قال: وما يَمنَعُني، لا تَكونوا أعوانًا للشَّيطانِ على أخِيكم؛ إنَّه لا يَنْبغي للإمامِ إذا انْتَهى إليه حدٌّ إلَّا أنْ يُقِيمَه، إنَّ اللهَ عفوٌّ يُحِبُّ العفْوَ، {وَلْيَعْفُوا وَلْيَصْفَحُوا أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللَّهُ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ} [النور: 22].","narrator":"عبدالله بن مسعود","source":"المستدرك على الصحيحين 8367","grade":"صحيح","judgment":"صحيح الإسناد ولم يخرجاه","url":"https://dorar.net/h/FT5MdKJd","nameForm":"غَفُورٌ رَحِيمٌ","scene":"يحكي ابن مسعود: أُتي النبي ﷺ بسارق فأمر بقطعه فكأنما أُسف وجهه، فقالوا: كأنك كرهت قطعه، قال: «وما يمنعني؟ لا تكونوا أعوانًا للشيطان على أخيكم، إنه لا ينبغي للإمام إذا انتهى إليه حد إلا أن يقيمه، إن الله عفو يحب العفو» ثم تلا ﴿وَلْيَعْفُوا وَلْيَصْفَحُوا أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللَّهُ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾.","reason":"أقام النبي ﷺ الحد وحزن على المحدود ونهى عن معونة الشيطان عليه، وتلا آية الغفور الرحيم؛ فالعدل يُقام والرحمة تبقى للمحدود، والاسم يمنع أن يتحول الحد إلى شماتة.","adds":"الحد يُقام والغفور الرحيم يحفظ للمحدود رحمة الناس."},{"i":16,"of":33,"text":"نُهِيَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم عنْ أصنافِ النِّساءِ، إلَّا ما كان مِن المؤمناتِ المهاجراتِ، قالَ: {لَا يَحِلُّ لَكَ النِّسَاءُ مِنْ بَعْدُ وَلَا أَنْ تَبَدَّلَ بِهِنَّ مِنْ أَزْوَاجٍ وَلَوْ أَعْجَبَكَ حُسْنُهُنَّ إِلَّا مَا مَلَكَتْ يَمِينُكَ} [الأحزاب: 52]، وأحلَّ اللهُ عزَّ وَجلَّ فتياتِكُم المؤمناتِ، {وَامْرَأَةً مُؤْمِنَةً إِنْ وَهَبَتْ نَفْسَهَا لِلنَّبِيِّ} [الأحزاب: 50]، وحَرَّمَ كلَّ ذاتِ دِينٍ غيرِ دِينِ الإسلامِ، قال: {حُرِّمَتْ عَلَيْكُمُ الْمَيْتَةُ وَالدَّمُ وَلَحْمُ الْخِنْزِيرِ وَمَا أُهِلَّ لِغَيْرِ اللَّهِ بِهِ وَالْمُنْخَنِقَةُ وَالْمَوْقُوذَةُ وَالْمُتَرَدِّيَةُ وَالنَّطِيحَةُ وَمَا أَكَلَ السَّبُعُ إِلَّا مَا ذَكَّيْتُمْ وَمَا ذُبِحَ عَلَى النُّصُبِ وَأَنْ تَسْتَقْسِمُوا بِالْأَزْلَامِ ذَلِكُمْ فِسْقٌ الْيَوْمَ يَئِسَ الَّذِينَ كَفَرُوا مِنْ دِينِكُمْ فَلَا تَخْشَوْهُمْ وَاخْشَوْنِ الْيَوْمَ أَكْمَلْتُ لَكُمْ دِينَكُمْ وَأَتْمَمْتُ عَلَيْكُمْ نِعْمَتِي وَرَضِيتُ لَكُمُ الْإِسْلَامَ دِينًا فَمَنِ اضْطُرَّ فِي مَخْمَصَةٍ غَيْرَ مُتَجَانِفٍ لِإِثْمٍ فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ (3) يَسْأَلُونَكَ مَاذَا أُحِلَّ لَهُمْ قُلْ أُحِلَّ لَكُمُ الطَّيِّبَاتُ وَمَا عَلَّمْتُمْ مِنَ الْجَوَارِحِ مُكَلِّبِينَ تُعَلِّمُونَهُنَّ مِمَّا عَلَّمَكُمُ اللَّهُ فَكُلُوا مِمَّا أَمْسَكْنَ عَلَيْكُمْ وَاذْكُرُوا اسْمَ اللَّهِ عَلَيْهِ وَاتَّقُوا اللَّهَ إِنَّ اللَّهَ سَرِيعُ الْحِسَابِ (4) الْيَوْمَ أُحِلَّ لَكُمُ الطَّيِّبَاتُ وَطَعَامُ الَّذِينَ أُوتُوا الْكِتَابَ حِلٌّ لَكُمْ وَطَعَامُكُمْ حِلٌّ لَهُمْ وَالْمُحْصَنَاتُ مِنَ الْمُؤْمِنَاتِ وَالْمُحْصَنَاتُ مِنَ الَّذِينَ أُوتُوا الْكِتَابَ مِنْ قَبْلِكُمْ إِذَا آتَيْتُمُوهُنَّ أُجُورَهُنَّ مُحْصِنِينَ غَيْرَ مُسَافِحِينَ وَلَا مُتَّخِذِي أَخْدَانٍ وَمَنْ يَكْفُرْ بِالْإِيمَانِ فَقَدْ حَبِطَ عَمَلُهُ وَهُوَ فِي الْآخِرَةِ مِنَ الْخَاسِرِينَ (5) } [المائدة: 3 - 5]، وقال: {يَا أَيُّهَا النَّبِيُّ إِنَّا أَحْلَلْنَا لَكَ أَزْوَاجَكَ اللَّاتِي آتَيْتَ أُجُورَهُنَّ وَمَا مَلَكَتْ يَمِينُكَ}، إلى قولِه: {خَالِصَةً لَكَ مِنْ دُونِ الْمُؤْمِنِينَ} [الأحزاب: 50]، وحَرَّمَ سوى ذلك مِن أصنافِ النِّساءِ.","narrator":"عبدالله بن عباس","source":"تخريج المسند لشاكر 4/332","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/DEUoanWO","nameForm":"غَفُورٌ رَحِيمٌ","scene":"آية المائدة: ﴿فَمَنِ اضْطُرَّ فِي مَخْمَصَةٍ غَيْرَ مُتَجَانِفٍ لِّإِثْمٍ فَإِنَّ اللَّهَ غَفُورٌ رَّحِيمٌ﴾ فيما رواه ابن عباس.","reason":"المضطر إلى المحرم مغفور له مرحوم.","adds":"يقرن الاسم برخصة الضرورة."},{"i":17,"of":33,"text":"لمَّا كانَ يَومُ بَدرٍ، قالَ لهُم رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «ما تَقولونَ في هؤلاء الأُسارى»، فقالَ عَبدُ اللهِ بنُ رَواحةَ: أنتَ في وادٍ كَثيرِ الحطَبِ، فأضْرِمْ نارًا، ثمَّ ألْقِهم فيها، فقالَ العبَّاسُ رَضيَ اللهُ عنه: قطَعَ اللهُ رَحمَكَ، فقالَ عُمَرُ رَضيَ اللهُ عنه: قادَتُهم ورُؤساؤُهم قاتَلوكَ وكذَّبوكَ فاضْرِبْ أعْناقَهم بَعدُ، فقالَ أبو بَكرٍ رَضيَ اللهُ عنه: عَشيرَتُكَ وقَومُكَ، ثمَّ دخَلَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ لبَعضِ حاجَتِه، فقالَتْ طائفةٌ: القَولُ ما قالَ عُمَرُ، قال: فخرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: \"ما تَقولونَ في هؤلاء؟ إنَّ مثَلَ هؤلاء كمثَلِ إخْوةٍ لهُم كانوا من قَبلِهم، قالَ نوحٌ: {رَبِّ لَا تَذَرْ عَلَى الْأَرْضِ مِنَ الْكَافِرِينَ دَيَّارًا} [نوح: 26]، وقالَ موسى: {رَبَّنَا اطْمِسْ عَلَى أَمْوَالِهِمْ وَاشْدُدْ عَلَى قُلُوبِهِمْ} [يونس: 88] الآيةَ، وقالَ إبْراهيمُ: رَبِّ {فَمَنْ تَبِعَنِي فَإِنَّهُ مِنِّي وَمَنْ عَصَانِي فَإِنَّكَ غَفُورٌ رَحِيمٌ} [إبراهيم: 36]، وقالَ عيسَى: {إِنْ تُعَذِّبْهُمْ فَإِنَّهُمْ عِبَادُكَ وَإِنْ تَغْفِرْ لَهُمْ فَإِنَّكَ أَنْتَ الْعَزِيزُ الْحَكِيمُ} [المائدة: 118]، وأنتم قَومٌ بكم عَيْلةٌ، فلا يَنفَلِتَنَّ أحدٌ منكم إلَّا بفِداءٍ أو بضَرْبةِ عُنقٍ\"، قالَ عبدُ اللهِ: فقلْتُ: إلَّا سُهيلَ بنَ بَيْضاءَ؛ فإنَّه لا يُقتَلُ، وقد سمِعْتُه يَتكلَّمُ بالإسْلامِ فسكَتَ، فما كان يومٌ أخوَفَ عِنْدي أنْ يُلْقى عليَّ حِجارةٌ منَ السَّماءِ من يَوْمي ذلك، حتَّى قالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «إلَّا سُهَيلَ بنَ بَيْضاءَ».","narrator":"[عبدالله بن مسعود]","source":"المستدرك على الصحيحين 4356","grade":"صحيح","judgment":"صحيح الإسناد","url":"https://dorar.net/h/o4dQZtqv","nameForm":"غَفُورٌ رَحِيمٌ","scene":"يوم بدر استشار النبي ﷺ أصحابه في الأسرى: فأشار ابن رواحة بإحراقهم، وعمر بضرب أعناقهم، وقال أبو بكر: «عشيرتك وقومك». ثم خرج النبي ﷺ فقال: «إن مثل هؤلاء كمثل إخوة لهم كانوا من قبلهم»، وذكر دعاء نوح وموسى، وقول إبراهيم: ﴿فَمَنْ تَبِعَنِي فَإِنَّهُ مِنِّي وَمَنْ عَصَانِي فَإِنَّكَ غَفُورٌ رَحِيمٌ﴾، وقول عيسى، ثم قضى: «فلا ينفلتن أحد منكم إلا بفداء أو بضربة عنق».","reason":"كلمة إبراهيم في العصاة تفويضٌ إلى الغفور الرحيم، ذكرها النبي ﷺ في مشورة الأسرى بين دعاء الشدة من نوح وموسى وكلمة التفويض من عيسى: فالاسم وجه اللين في الموقف، وقد أشار به أبو بكر.","adds":"يقرن الاسم بكلمة إبراهيم في مشورة أسرى بدر."},{"i":18,"of":33,"text":"عنِ النَّبيِّ صلَّى اللَّهُ عليْهِ وسلَّمَ أنَّهُ بعثَ رَهطًا وبعثَ عليْهم أبا عُبيدةَ بنَ الجرَّاحِ أو عبيدةَ بنَ الحارثِ فلمَّا ذَهبَ لينطلِقَ بَكى صَبابةً إلى رسولِ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّمَ فجلسَ وبعثَ مكانَهُ عبدَ اللَّهِ بنَ جَحشٍ وَكتبَ لَهُ كتابًا وأمرَهُ أن لا يقرأَ الْكتابَ حتَّى يبلُغَ مَكانَ كذا وَكذا وقالَ لا تُكرِهنَّ أحدًا على السَّيرِ معَكَ من أصحابِكَ فلمَّا قرأَ الْكتابَ استرجعَ وقالَ سمعًا وطاعةً للَّهِ ولرسولِهِ فخبَّرَهمُ الخبرَ وقرأَ عليْهمُ الْكتابَ فرجعَ رجلانِ ومضى بقيَّتُهم فلقَوُا ابنَ الحضرميِّ فقتلوهُ ولم يدروا أنَّ ذلِكَ اليومَ من رجَبٍ أو جُمادَى فقالَ المشرِكونَ للمُسلِمينَ قتلتُم في الشَّهرِ الحرامِ فأنزلَ اللَّهُ يَسْأَلُونَكَ عَنِ الشَّهْرِ الْحَرَامِ قِتَالٍ فِيهِ الآيةَفقالَ بعضُهم إن لم يَكونوا أصابوا وِزرًا فليسَ لَهم أجرٌ فأنزلَ اللَّهُ  إِنَّ الَّذِينَ آمَنُوا وَالَّذِينَ هَاجَرُوا وَجَاهَدُوا فِي سَبِيلِ اللَّهِ أُولَئِكَ يَرْجُونَ رَحْمَةَ اللَّهِ وَاللَّهُ غَفُورٌ رَحِيمٌ","narrator":"جندب بن عبدالله","source":"الدر المنثور 2/535","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/PC8QVgTB","nameForm":"غَفُورٌ رَحِيمٌ","scene":"سرية عبد الله بن جحش: قتلوا ابن الحضرمي ولم يدروا أن ذلك اليوم من رجب أو جمادى، فعيّرهم المشركون بالقتال في الشهر الحرام، فقال بعضهم: إن لم يكونوا أصابوا وزرًا فليس لهم أجر، فأنزل الله ﴿إِنَّ الَّذِينَ آمَنُوا وَالَّذِينَ هَاجَرُوا وَجَاهَدُوا فِي سَبِيلِ اللَّهِ أُولَٰئِكَ يَرْجُونَ رَحْمَتَ اللَّهِ وَاللَّهُ غَفُورٌ رَّحِيمٌ﴾.","reason":"المجاهد الذي خاف أن يكون آثمًا يُرجّى بالاسم.","adds":"يقرن الاسم برجاء المجاهدين."},{"i":19,"of":33,"text":"لَمَّا نزلتْ: {إِنَّ الَّذِينَ تَوَفَّاهُمُ الْمَلَائِكَةُ ظَالِمِي أَنفُسِهِمْ} [النساء: 97] قال: كان قومٌ بمكَّةَ قد أسلَموا، وكانوا مُستَخْفينَ بالإسلامِ، فلما خَرَجَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ إلى بدرٍ وخَرَجَ المُشرِكون، أخرَجوهم معهم مُكرَهينَ، فأُصيبَ بعضُهُم يومَ بدرٍ مع المُشرِكينَ، فقال المُسلِمونُ: أصحابُنا هؤلاءِ كانوا مُسلِمينَ، أخرَجوهم مُكرَهينَ، فاسْتغفِروا لهم، فنَزَلَتْ، كَتَبوها إلى مَنْ بَقِيَ منهم بمكَّةَ، فخَرَجوا حتى إذا كانوا ببعضِ الطَّريقِ ظَهَرَ عليهم المُشرِكون وعلى خُروجِهم، فلَحِقوهم، فرَدُّوهم، فرَجَعوا معهم فنزلتْ: {وَمِنَ النَّاسِ مَنْ يَقُولُ آمَنَّا بِاللَّهِ فَإِذَا أُوذِيَ فِي اللَّهِ جَعَلَ فِتْنَةَ النَّاسِ كَعَذَابِ اللَّهِ} [العنكبوت: 10]، فكَتَبَ المُسلِمونَ إليهم بذلك، فنزلتْ: {ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ هَاجَرُوا مِن بَعْدِ مَا فُتِنُوا ثُمَّ جَاهَدُوا وَصَبَرُوا إِنَّ رَبَّكَ مِن بَعْدِهَا لَغَفُورٌ رَحِيمٌ} [النحل: 110]، فكَتَبوا إليهم بذلك.","narrator":"عبدالله بن عباس","source":"تخريج العواصم والقواصم 1/ 341","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/WkSBBX2p","nameForm":"لَغَفُورٌ رَحِيمٌ","scene":"قومٌ أسلموا بمكة وأُخرجوا إلى بدر مكرهين، ثم خرج من بقي منهم فردّهم المشركون ففُتنوا، فكتب إليهم المسلمون بآية ﴿ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ هَاجَرُوا مِن بَعْدِ مَا فُتِنُوا ثُمَّ جَاهَدُوا وَصَبَرُوا إِنَّ رَبَّكَ مِن بَعْدِهَا لَغَفُورٌ رَّحِيمٌ﴾.","reason":"المفتون الذي عاد بالهجرة مغفور له: الاسم خاتمة طريق العودة.","adds":"يُري الاسم دافعًا للهجرة بعد الفتنة."},{"i":20,"of":33,"text":"«عنْ عبدِ اللهِ بنِ مسعودٍ رَضيَ اللهُ عنه قالَ: إنَّ في سورةِ النِّساءِ لخمسُ آياتٍ ما يَسُرُّني أنَّ لي بها الدُّنيا وما فيها: {إِنَّ اللَّهَ لَا يَظْلِمُ مِثْقَالَ ذَرَّةٍ وَإِنْ تَكُ حَسَنَةً يُضَاعِفْهَا وَيُؤْتِ مِن لَدُنْهُ أَجْرًا عَظِيمًا} [النساء: 40]، {إِنْ تَجْتَنِبُوا كَبَائِرَ مَا تُنْهَوْنَ عَنْهُ نُكَفِّرْ عَنْكُمْ سَيِّئَاتِكُمْ وَنُدْخِلْكُمْ مُدْخَلًا كَرِيمًا} [النساء: 31]، {إِنَّ اللَّهَ لَا يَغْفِرُ أَنْ يُشْرَكَ بِهِ وَيَغْفِرُ مَا دُونَ ذَلِكَ لِمَنْ يَشَاءُ} [النساء: 48]، {وَلَوْ أَنَّهُمْ إِذْ ظَلَمُوا أَنْفُسَهُمْ جَاؤُوكَ فَاسْتَغْفَرُوا اللَّهَ وَاسْتَغْفَرَ لَهُمُ الرَّسُولُ لَوَجَدُوا اللَّهَ تَوَّابًا رَحِيمًا} [النساء: 64]، {وَمَنْ يَعْمَلْ سُوءًا أَوْ يَظْلِمْ نَفْسَهُ ثُمَّ يَسْتَغْفِرِ اللَّهَ يَجِدِ اللَّهَ غَفُورًا رَحِيمًا} [النساء: 110]. قالَ عبدُ اللهِ: ما يسُرُّني أنَّ لي بها الدُّنيا وما فيها.»","narrator":"عبد الرحمن بن عبدالله بن مسعود","source":"المستدرك على الصحيحين (3236)","grade":"صحيح","judgment":"[إسناده صحيح إن كان عبد الرحمن سمع من أبيه فقد اختلف في ذلك]","url":"https://dorar.net/h/6kfGWkBb","nameForm":"غَفُورًا رَحِيمًا","scene":"قال ابن مسعود: إن في سورة النساء لخمس آيات ما يسرني أن لي بها الدنيا وما فيها: ﴿إِنَّ اللَّهَ لَا يَظْلِمُ مِثْقَالَ ذَرَّةٍ﴾، و﴿إِنْ تَجْتَنِبُوا كَبَائِرَ مَا تُنْهَوْنَ عَنْهُ﴾، و﴿إِنَّ اللَّهَ لَا يَغْفِرُ أَنْ يُشْرَكَ بِهِ وَيَغْفِرُ مَا دُونَ ذَلِكَ﴾، و﴿وَلَوْ أَنَّهُمْ إِذْ ظَلَمُوا أَنْفُسَهُمْ جَاءُوكَ فَاسْتَغْفَرُوا اللَّهَ﴾، و﴿وَمَنْ يَعْمَلْ سُوءًا أَوْ يَظْلِمْ نَفْسَهُ ثُمَّ يَسْتَغْفِرِ اللَّهَ يَجِدِ اللَّهَ غَفُورًا رَحِيمًا﴾.","reason":"صحابي كبير يقيس خمس آيات بالدنيا وما فيها، والخامسة فيها الاسم: من استغفر وجد الله غفورًا رحيمًا؛ فالاسم في آية يُفضلها الصحابة على الدنيا كلها.","adds":"آية الغفور الرحيم عند ابن مسعود خير من الدنيا وما فيها."},{"i":21,"of":33,"text":"عن عبدِ اللَّهِ _ هو ابن مسعود – قالَ : كانَ بنو إسرائيلَ إذا أصابَ أحدُهُم ذنبًا أصبحَ قد كُتِبَ كفَّارةُ ذلِكَ الذَّنبِ على بابِهِ ، وإذا أصابَ البولُ منه شيئا قرضَهُ بالمِقراضِ فقالَ رجلٌ : لقد آتى اللَّهُ بني إسرائيلَ خيرًا ، فقال عبدُ اللَّهِ : ما آتاكم اللَّهُ خيرًا مِمَّا آتاهم ، جعلَ الماءَ لَكُم طَهورًا ، وقالَ  وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ ذَكَرُوا اللَّهَ فَاسْتَغْفَرُوا لِذُنُوبِهِمْ  [آلِ عمرانَ :135] ، وقالَ :  وَمَنْ يَعْمَلْ سُوءًا أَوْ يَظْلِمْ نَفْسَهُ ثُمَّ يَسْتَغْفِرِ اللَّهَ يَجِدِ اللَّهَ غَفُورًا رَحِيمًا","narrator":"-","source":"عمدة التفسير 1/571","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/TIZTdMx9","nameForm":"غَفُورًا رَحِيمًا","scene":"قال ابن مسعود: كان بنو إسرائيل إذا أصاب أحدهم ذنبًا أصبح قد كُتبت كفارة ذلك الذنب على بابه، وإذا أصاب البول منه شيئًا قرضه بالمقراض، فقال رجل: لقد آتى الله بني إسرائيل خيرًا، فقال: ما آتاكم الله خيرًا مما آتاهم: جعل الماء لكم طهورًا وقال ﴿وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ ذَكَرُوا اللَّهَ فَاسْتَغْفَرُوا﴾ وقال ﴿وَمَنْ يَعْمَلْ سُوءًا أَوْ يَظْلِمْ نَفْسَهُ ثُمَّ يَسْتَغْفِرِ اللَّهَ يَجِدِ اللَّهَ غَفُورًا رَحِيمًا﴾.","reason":"قارن ابن مسعود بين توبة بني إسرائيل المكتوبة على الأبواب وتوبة هذه الأمة بالاستغفار الخفي فيجد الغفور الرحيم؛ فالاسم يجعل توبة هذه الأمة أيسر وأستر من كل أمة.","adds":"توبة هذه الأمة استغفار خفي يجد الغفور الرحيم: خير مما أوتي من قبلنا."},{"i":22,"of":33,"text":"قال رجلٌ لعُمرَ بنِ الخطَّابِ , رضي اللهُ عنه : إني لأعرِفُ أشدَّ آيةٍ في كتابِ اللهِ ، فأهوى عُمرُ فضرَبه بالدِّرَّةِ وقال : مالَكَ نقبتَ عنها حتى علِمْتَها ، فانصرِفْ حتى إذا كان الغَدُ قال له عُمرُ : الآيةَ التي ذكَرتَ بالأمسِ , قال : وهل ترَكتَني أخبرُكَ عنها ؟ فقال له عُمرُ : ما نِمتُ البارحةَ ، فقال : يا أميرَ المؤمِنينَ ، قال اللهُ , عزَّ وجلَّ : مَن يَعمَلْ سوءًا يُجزَ به ما مِن أحدٍ يَعمَلُ سوءًا إلا جُزِي به ، فقال عُمرُ : إنا حين نزَلَتْ ما نفَعَنا طعامٌ ولا شرابٌ حتى أَنزَل اللهُ , تبارَك وتعالى , بعدَ ذلك ورخَّص قال : ومَن يَعمَلْ سوءًا أو يَظلِمْ نفسَه ثم يَستَغفِرِ اللهَ يجِدِ اللهَ غفورًا رحيمًا","narrator":"محمد بن المنتشر","source":"إتحاف الخيرة المهرة 6/198","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/jR6c9sHh","nameForm":"غَفُورًا رَحِيمًا","scene":"قال رجل لعمر: إني لأعرف أشد آية في كتاب الله، فضربه بالدرة: ما لك نقبت عنها؟ فلما كان الغد قال: يا أمير المؤمنين قال الله ﴿مَنْ يَعْمَلْ سُوءًا يُجْزَ بِهِ﴾، فقال عمر: إنا حين نزلت ما نفعنا طعام ولا شراب حتى أنزل الله بعد ذلك ورخص: ﴿وَمَنْ يَعْمَلْ سُوءًا أَوْ يَظْلِمْ نَفْسَهُ ثُمَّ يَسْتَغْفِرِ اللَّهَ يَجِدِ اللَّهَ غَفُورًا رَحِيمًا﴾.","reason":"عمر لم يهنأ بطعام حتى نزلت آية الغفور الرحيم؛ فالاسم كان الرخصة التي أعادت للصحابة أنفاسهم بعد أشد آية، وهو الجناح الذي يقابل جناح الخوف.","adds":"آية الغفور الرحيم أعادت لعمر طعامه وشرابه: الرجاء الذي يوازن أشد آية."},{"i":23,"of":33,"text":"«عن ابنِ عبَّاسٍ، وسَألَه رَجُلٌ عن هذه الآيةِ: {يَا أَيُّهَا الَّذِينَ آمَنُوا إِنَّ مِنْ أَزْوَاجِكُمْ وَأَوْلَادِكُمْ عَدُوًّا لَكُمْ فَاحْذَرُوهُمْ وَإِنْ تَعْفُوا وَتَصْفَحُوا وَتَغْفِرُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ}، قالَ: قالَ: هؤلاء رِجالٌ أَسْلَموا مِن أهْلِ مَكَّةَ، فأرادوا أن يَأتوا النَّبيَّ صلَّى اللهُ عليه وسلَّمَ فأبى أزْواجُهم وأوْلادُهم أن يَدَعوهم، فأتَوا النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فلمَّا أتَوا رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ رأَوا النَّاسَ قد فَقِهوا في الدِّينِ، فهَمُّوا أن يُعاقِبوهم، فأَنزَلَ اللهُ: {يَا أَيُّهَا الَّذِينَ آمَنُوا إِنَّ مِنْ أَزْوَاجِكُمْ وَأَوْلَادِكُمْ عَدُوًّا لَكُمْ فَاحْذَرُوهُمْ وَإِنْ تَعْفُوا وَتَصْفَحُوا وَتَغْفِرُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ}».","narrator":"عكرمة مولى ابن عباس","source":"الأحاديث المختارة 12 / 49","grade":"صحيح","judgment":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","url":"https://dorar.net/h/TwZefY3J","nameForm":"غَفُورٌ رَحِيمٌ ؛ غَفُورٌ رَحِيمٌ","scene":"ابن عباس في ﴿إِنَّ مِنْ أَزْوَاجِكُمْ وَأَوْلَادِكُمْ عَدُوًّا لَّكُمْ فَاحْذَرُوهُمْ وَإِن تَعْفُوا وَتَصْفَحُوا وَتَغْفِرُوا فَإِنَّ اللَّهَ غَفُورٌ رَّحِيمٌ﴾: رجال أسلموا بمكة فمنعهم أزواجهم وأولادهم من الهجرة، فلما هاجروا أرادوا أن يعاقبوهم فنزلت.","reason":"من عفا عن أهله الذين ثبّطوه غُفر له: الاسم يُنال بالعفو عن الأهل.","adds":"يقرن الاسم بالعفو عن الأهل المثبّطين."},{"i":24,"of":33,"text":"أنَّ امرأةً سرقت على عَهْدِ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ، فجاءَ بِها الَّذينَ سرقَتهم فقالوا : يا رسولَ اللَّهِ ، إنَّ هذِهِ المرأةَ سرقَتنا ! قالَ قومُها : فنَحنُ نَفديها ، فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : اقطَعوا يدَها فقالوا : نحنُ نَفديها بخَمسِمائةِ دينارٍ . فقالَ : اقطَعوا يدَها . فقُطِعَت يدُها اليُمنى . فقالتِ المرأةُ : هل لي من توبةٍ يا رسولَ اللَّهِ ؟ قالَ : نعَم ، أنتِ اليومَ من خطيئتِكِ كيومِ ولدتكِ أمُّكِ . فأنزلَ اللَّهُ في سورةِ المائدةِ :  فَمَنْ تَابَ مِنْ بَعْدِ ظُلْمِهِ وَأَصْلَحَ فَإِنَّ اللَّهَ يَتُوبُ عَلَيْهِ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","narrator":"عبدالله بن عمرو","source":"عمدة التفسير 1/677","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/T4YTUnkp","nameForm":"غَفُورٌ رَحِيمٌ","scene":"امرأة سرقت فقُطعت يدها، فسألت: هل لي من توبة؟ قال: «نعم، أنت اليوم من خطيئتك كيوم ولدتك أمك» فنزلت ﴿فَمَن تَابَ مِن بَعْدِ ظُلْمِهِ وَأَصْلَحَ فَإِنَّ اللَّهَ يَتُوبُ عَلَيْهِ إِنَّ اللَّهَ غَفُورٌ رَّحِيمٌ﴾.","reason":"الحد لا يمنع التوبة: السارقة بعد القطع كيوم ولدتها أمها.","adds":"يُري الاسم بعد إقامة الحد."},{"i":25,"of":33,"text":"كانَ رَجُلٌ مِنَ الأنصارِ أسلَمَ، ثم ارتَدَّ، ولَحِقَ بالشِّركِ، ثم تَنَدَّمَ، فأرسَلَ إلى قَومِه: سَلوا لي رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ: هل لي مِن تَوبةٍ؟ فجاءَ قَومُه إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقالوا: إنَّ فُلانًا قَد نَدِمَ، وإنَّه أمَرَنا أنْ نَسألَكَ: هل له مِن تَوبةٍ؟ فنَزَلتْ: {كَيْفَ يَهْدِي اللَّهُ قَوْمًا كَفَرُوا بَعْدَ إِيمَانِهِمْ وَشَهِدُوا أَنَّ الرَّسُولَ حَقٌّ} [آل عمران: 86]، إلى قَولِه: {غَفُورٌ رَحِيمٌ} [آل عمران: 89]، فأرسَلَ إليه، فأسلَمَ.","narrator":"عبدالله بن عباس","source":"الاقتراح في بيان الاصطلاح 105","grade":"صحيح","url":"https://dorar.net/h/9SXozC2I","nameForm":"غَفُورٌ رَحِيمٌ","scene":"أنصاري ارتد ولحق بالشرك ثم ندم فأرسل: سلوا لي رسول الله هل لي من توبة؟ فنزلت ﴿كَيْفَ يَهْدِي اللَّهُ قَوْمًا كَفَرُوا بَعْدَ إِيمَانِهِمْ﴾ إلى استثناء التائبين المختوم بـ﴿غَفُورٌ رَحِيمٌ﴾ فأرسل إليه فأسلم.","reason":"حتى المرتد له توبة: الاسم خاتمة استثناء التائبين من الكفر.","adds":"يُري الاسم بابًا للمرتد التائب."},{"i":26,"of":33,"text":"عن ابنِ عبَّاسٍ، قالَ: «{إِنَّمَا جَزَاءُ الَّذِينَ يُحَارِبُونَ اللَّهَ وَرَسُولَهُ وَيَسْعَوْنَ فِي الْأَرْضِ فَسَادًا أَنْ يُقْتَّلُوا أَوْ يُصَلَّبُوا أَوْ تُقَطَّعَ أَيْدِيهِمْ وَأَرْجُلُهُمْ مِنْ خِلَافٍ أَوْ يُنْفَوا مِنَ الْأَرْضِ} إلى {غَفُورٌ رَحِيمٌ}، نَزَلَتْ هذه الآيةُ في المُشرِكينَ، فمَن تابَ مِنهم قَبْلَ أن يُقدَرَ عليه لم يَمنَعْه ذلك أن يُقامَ فيه الحَدُّ الَّذي أصابَه».","narrator":"عكرمة","source":"الأحاديث المختارة 12 / 318","grade":"صحيح","judgment":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","url":"https://dorar.net/h/yz80alY2","nameForm":"غَفُورٌ رَحِيمٌ","scene":"ابن عباس: آية المحاربة إلى ﴿غَفُورٌ رَّحِيمٌ﴾ نزلت في المشركين، فمن تاب قبل أن يُقدر عليه لم يمنعه ذلك أن يُقام فيه الحد.","reason":"الاسم يختم آية المحاربة ومعه استثناء التائبين، وابن عباس يحدّد فيمن نزلت: في المشركين؛ فمغفرة الغفور الرحيم للمشرك التائب قبل القدرة عليه، أما غيره فتوبته قبل القدرة عليه لا تمنع أن يُقام فيه الحد الذي أصابه.","adds":"يحدّد ابن عباس مجال الاسم في آية الحرابة: الاستثناء بالغفور الرحيم نزل في المشركين، ولا تُسقط التوبةُ الحدَّ عن غيرهم."},{"i":27,"of":33,"text":"أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ دخلَ المسجدَ ، إذا رجلٌ قد قَضى صلاتَهُ وَهوَ يتشَهَّدُ ، فقالَ: اللَّهمَّ إنِّي أسألُكَ يا اللَّهُ بأنَّكَ الواحدُ الأحدُ الصَّمدُ ، الَّذي لم يَلِدْ ولم يولَدْ ولم يَكُنْ لَهُ كُفُوًا أَحَدٌ ، أن تغفِرَ لي ذُنوبي ، إنَّكَ أنتَ الغَفورُ الرَّحيمُ ، فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: قَد غَفرَ اللَّهُ لَهُ ، ثلاثًا","narrator":"محجن بن الأدرع","source":"صحيح النسائي 1300","grade":"صحيح","url":"https://dorar.net/h/EP1jHA8m","nameForm":"الغَفورُ الرَّحيمُ","scene":"رجل قضى صلاته وهو يتشهد يقول: «اللهم إني أسألك يا الله بأنك الواحد الأحد الصمد الذي لم يلد ولم يولد ولم يكن له كفوًا أحد أن تغفر لي ذنوبي إنك أنت الغفور الرحيم» فقال النبي ﷺ: «قد غفر الله له» ثلاثًا.","reason":"التوسل بأسماء التوحيد ثم طلب المغفرة بالاسم: فيُجاب في الحال.","adds":"يعطي صيغة دعاء مغفرة مُجابة."},{"i":28,"of":33,"text":"قال: صلَّى بنا رَسولُ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ على رَجُلٍ مِنَ المُسلِمينَ، فسَمِعتُه يَقولُ: اللَّهمَّ إنَّ فُلانَ بنَ فُلانٍ في ذِمَّتِكَ؛ فَقِهِ فِتنةَ القَبرِ. قال عَبدُ الرَّحمنِ: في ذِمَّتِكَ وحَبلِ جِوارِكَ؛ فَقِهِ مِن فِتنةِ القَبرِ وعَذابِ النَّارِ، وأنتَ أهلُ الوَفاءِ والحَمدِ، اللَّهمَّ فاغفِرْ له وارْحَمْه؛ إنَّكَ أنتَ الغَفورُ الرَّحيمُ.","narrator":"واثلة بن الأسقع الليثي أبو فسيلة","source":"تخريج سنن أبي داود 3202","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/pKaCbOud","nameForm":"الغَفورُ الرَّحيمُ","scene":"صلاة الجنازة: «اللهم إن فلان بن فلان في ذمتك وحبل جوارك، فقه من فتنة القبر وعذاب النار، وأنت أهل الوفاء والحمد، اللهم فاغفر له وارحمه إنك أنت الغفور الرحيم».","reason":"دعاء الميت يُختم بالاسم: مغفرة ورحمة لمن انقطع عمله.","adds":"يعطي الاسم في صلاة الجنازة."},{"i":29,"of":33,"text":"عن عبدِ اللهِ بنِ مسعودٍ ؛ أنَّه سُئل عن ذلك , يعني عن الرَّجلِ يزني بالمرأةِ , ثمَّ يتزوجُّها ؟ فتلا هذه الآيةَ : { وَالَّذِينَ عَمِلُوا السَّيِّئَاتِ ثُمَّ تَابُوا مِنْ بَعْدِهَا وَآَمَنُوا إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ  } , فتلاها عبدُ اللهِ عشرَ مرَّاتٍ , فلم يأمرْهم بها ولم ينهَهم عنها","narrator":"علقمة بن قيس","source":"عمدة التفسير 2/61","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/tuSFvQ0b","nameForm":"لَغَفُورٌ رَحِيمٌ","scene":"سُئل ابن مسعود عن الرجل يزني بالمرأة ثم يتزوجها فتلا ﴿وَالَّذِينَ عَمِلُوا السَّيِّئَاتِ ثُمَّ تَابُوا مِن بَعْدِهَا وَآمَنُوا إِنَّ رَبَّكَ مِن بَعْدِهَا لَغَفُورٌ رَّحِيمٌ﴾ عشر مرات.","reason":"الجواب بالاسم عشرًا: التوبة تمحو، والغفور الرحيم بعدها.","adds":"يُري الاسم جوابًا فقهيًّا."},{"i":30,"of":33,"text":"عن ابنِ عبَّاسٍ، قالَ: «{لَا يَسْتَأْذِنُكَ الَّذِينَ يُؤْمِنُونَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ} الآية، نَسَخَتْها الَّتي في النُّورِ {إِنَّمَا الْمُؤْمِنُونَ الَّذِينَ آمَنُوا بِاللَّهِ وَرَسُولِهِ} إلى قَوْلِه - {غَفُورٌ رَحِيمٌ}».","narrator":"عكرمة","source":"الأحاديث المختارة 12 / 320","grade":"صحيح","judgment":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","url":"https://dorar.net/h/A2PuPaxR","nameForm":"غَفُورٌ رَحِيمٌ","scene":"ابن عباس: ﴿لَا يَسْتَأْذِنُكَ الَّذِينَ يُؤْمِنُونَ﴾ نسختها آية النور ﴿إِنَّمَا الْمُؤْمِنُونَ…﴾ إلى ﴿غَفُورٌ رَّحِيمٌ﴾.","reason":"الاسم في الناسخ: أذن للمستأذنين مع الاستغفار لهم.","adds":"فقه النسخ."},{"i":31,"of":33,"text":"لو أنَّ العبادَ لم يُذْنِبوا لخَلَقَ اللهُ خلقًا يُذْنِبونَ ثُمَّ يَسْتَغْفِرونَ ، ثُمَّ يَغْفِرُ لهم ، وهو الغفورُ الرحيمُ","narrator":"عبدالله بن عمرو","source":"صحيح الجامع 5243","grade":"صحيح","url":"https://dorar.net/h/BJkZY9R1","nameForm":"الغفورُ الرحيمُ","scene":"«لو أن العباد لم يذنبوا لخلق الله خلقًا يذنبون ثم يستغفرون ثم يغفر لهم، وهو الغفور الرحيم».","reason":"الاسم يقتضي مذنبًا يستغفر: لو لم يُذنبوا لخُلق من يُذنب ليظهر الغفور الرحيم.","adds":"الاسم يقتضي خلقًا يذنبون ثم يستغفرون فيغفر لهم."},{"i":32,"of":33,"text":"كانَ أَهلُ بيتٍ منَّا يقالُ لَهم بنو أُبَيرِقٍ بِشرٌ وبشيرٌ ومُبشِّرٌ وَكانَ بشيرٌ رجُلًا منافقًا يقولُ الشِّعرَ يَهجو بِهِ أصحابَ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ثمَّ يَنحلُهُ بعضَ العرَبِ ثمَّ يقولُ قالَ فلانٌ كذا وَكذا قالَ فلانٌ كذا وَكذا فإذا سمعَ أصحابُ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ذلِكَ الشِّعرَ قالوا واللَّهِ ما يقولُ هذا الشِّعرَ إلَّا هذا الخبيثُ أو كما قالَ الرَّجلُ وقالوا ابنُ الأبيرقِ قالَها قالَ وَكانوا أَهلَ بيتِ حاجةٍ وفاقةٍ في الجاهليَّةِ والإسلامِ وَكانَ النَّاسُ إنَّما طعامُهم بالمدينةِ التَّمرُ والشَّعيرُ وَكانَ الرَّجلُ إذا كانَ لَهُ يسارٌ فقدمت ضافِطةٌ منَ الشَّامِ منَ الدَّرمَكِ ابتاعَ الرَّجلُ منها فخصَّ بِها نفسَهُ وأمَّا العيالُ فإنَّما طعامُهمُ التَّمرُ والشَّعيرُ فقدمت ضافطةٌ منَ الشَّامِ فابتاعَ عمِّي رفاعةُ بنُ زيدٍ حملًا منَ الدَّرمَكِ فجعلَهُ في مشربةٍ لَهُ وفي المشربةِ سلاحٌ ودِرعٌ وسيفٌ فعُدِيَ عليهِ من تحتِ البيتِ فنُقبت المشربةُ وأُخِذَ الطَّعامُ والسِّلاحُ فلمَّا أصبحَ أتاني عمِّي رفاعةُ فقالَ يا ابنَ أخي إنَّهُ قد عُدِيَ علينا في ليلتِنا هذِهِ فنُقِّبَت مشربتُنا فذُهِبَ بطعامِنا وسلاحِنا. قالَ فتحسَّسنا في الدَّارِ وسألنا فقيلَ لنا قد رأينا بني أبيرقٍ استوقدوا في هذِهِ اللَّيلةِ ولا نرى فيما نرى إلَّا على بعضِ طعامِكم قالَ وَكانَ بنو أبيرقٍ قالوا ونحنُ نسألُ في الدَّارِ واللَّهِ ما نرى صاحبَكم إلَّا لبيدَ بنَ سَهلٍ رجلٌ منَّا لَهُ صلاحٌ وإسلامٌ فلمَّا سمعَ لبيدٌ اخترطَ سيفَهُ وقالَ أنا أسرقُ فواللَّهِ ليخالطنَّكم هذا السَّيفُ أو لتبيِّنُنَّ هذِهِ السَّرقةَ قالوا إليْكَ عنها أيُّها الرَّجلُ فما أنتَ بصاحبِها فسألنا في الدَّارِ حتَّى لم نشُكَ أنَّهم أصحابُها فقالَ لي عمِّي يا ابنَ أخي لو أتيتَ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فذَكرتَ ذلِكَ لَهُ قالَ قتادةُ فأتيتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فقلتُ إنَّ أَهلَ بيتٍ منَّا أَهلَ جفاءٍ عمدوا إلى عمِّي رفاعةَ بنِ زيدٍ فنقبوا مشربةً لَهُ وأخذوا سلاحَهُ وطعامَهُ فليردُّوا علينا سلاحَنا فأمَّا الطَّعامُ فلا حاجةَ لنا فيهِ فقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ سآمُرُ في ذلِكَ فلمَّا سمِعَ بنو أبيرقٍ أتَوا رجلًا منهُم يقالُ لَهُ أُسيرُ بنُ عُروةَ فَكلَّموهُ في ذلِكَ واجتَمعَ في ذلِكَ ناسٌ من أَهلِ الدَّارِ فقالوا يا رسولَ اللَّهِ إنَّ قتادةَ بنَ النُّعمانِ وعمَّهُ عمدا إلى أَهلِ بيتٍ منَّا أَهلِ إسلامٍ وصلاحٍ يرمونَهم بالسَّرقةِ من غيرِ بيِّنةٍ ولا ثبتٍ قالَ قتادةُ فأتيتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فَكلَّمتُهُ فقالَ عمدتَ إلى أَهلِ بيتٍ ذُكرَ منهم إسلامٌ وصلاحٌ ترميهم بالسَّرقةِ على غيرِ ثبتٍ وبيِّنةٍ قالَ فرجَعتُ ولودِدتُ أنِّي خرجتُ من بعضِ مالي ولم أُكلِّم رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ في ذلِكَ فأتاني عمِّي رفاعةُ فقالَ يا ابنَ أخي ما صنعتَ فأخبرتُهُ بما قالَ لي رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ اللَّهُ المستعانُ فلم يلبَث أن نزلَ القرآنُ إِنَّا أَنْزَلْنَا إِلَيْكَ الْكِتَابَ بِالْحَقِّ لِتَحْكُمَ بِيْنَ النَّاسِ بِمَا أَرَاكَ اللَّهُ وَلا تَكُنْ لِلْخَائِنِينَ خَصِيمًا بني أبيرقٍ وَاسْتَغْفِرِ اللَّهَ مِمَّا قلتَ لقتادةَ إِنَّ اللَّهَ كَانَ غَفُورًا رَحِيمًا وَلَا تُجَادِلْ عَنِ الَّذِينَ يَخْتَانُونَ أَنْفُسَهُمْ إِنَّ اللَّهَ لَا يُحِبُّ مَنْ كَانَ خَوَّانًا أَثِيمًا يَسْتَخْفُونَ مِنَ النَّاسِ وَلَا يَسْتَخْفُونَ مِنَ اللَّهِ وَهُوَ مَعَهُمْ - إلى قولِهِ -  رَحِيمًا أي لو استغفروا اللَّهَ لغفرَ لَهم  وَمَنْ يَكْسِبْ إِثْمًا فَإِنَّمَا يَكْسِبُهُ عَلَى نَفْسِهِ  - إلى قولِهِ - وَإِثْمًا مُبِينًا قولَهم للبيدٍ  وَلَوْلَا فَضْلُ اللَّهِ عَلَيْكَ وَرَحْمَتُهُ  - إلى قولِهِ -  فَسَوْفَ نُؤْتِيهِ أَجْرًا عَظِيمًا  فلمَّا نزلَ القرآنُ أتى رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ بالسِّلاحِ فردَّهُ إلى رِفاعةَ فقالَ قتادةُ لَمَّا أتيتُ عمِّي بالسِّلاحِ وَكانَ شيخًا قد عشا - أو عسا – الشَّكُّ مِن أبي عيسى- في الجاهليَّةِ وَكنتُ أرى إسلامُهُ مدخولًا فلمَّا أتيتُهُ قالَ يا ابنَ أخي هوَ في سبيلِ اللَّهِ فعرَفتُ أنَّ إسلامَهُ كانَ صحيحًا فلمَّا نزلَ القرآنُ لَحِقَ بشيرٌ بالمُشرِكينَ فنزلَ على سُلافةَ بنتِ سعدِ ابنِ سميَّةَ فأنزلَ اللَّهُ  وَمَنْ يُشَاقِقِ الرَّسُولَ مِنْ بَعْدِ مَا تَبَيَّنَ لَهُ الْهُدَى وَيَتَّبِعْ غَيْرَ سَبِيلِ الْمُؤْمِنِينَ نُوَلِّهِ مَا تَوَلَّى وَنُصْلِهِ جَهَنَّمَ وَسَاءَتْ مَصِيرًا إِنَّ اللَّهَ لَا يَغْفِرُ أَنْ يُشْرَكَ بِهِ وَيَغْفِرُ مَا دُونَ ذَلِكَ لِمَنْ يَشَاءُ وَمَنْ يُشْرِكْ بِاللَّهِ فَقَدْ ضَلَّ ضَلَالًا بَعِيدًا  فلمَّا نزلَ على سُلافةَ رماها حسَّانُ بنُ ثابتٍ بأبياتٍ من شعرٍ فأخذَت رحلَهُ فوضعَتهُ على رأسِها ثمَّ خرجت بِهِ فرمت بِهِ في الأبطَحِ ثمَّ قالت أَهدَيتَ لي شِعرَ حسَّانَ ما كنتَ تأتيني بِخَيرٍ","narrator":"قتادة بن النعمان","source":"صحيح الترمذي 3036","grade":"حسن","url":"https://dorar.net/h/ca46UMvl","nameForm":"غَفُورًا رَحِيمًا","scene":"بنو أبيرق: سرقوا ورموا بريئًا، فهمّ النبي ﷺ أن يجادل عنهم فنزلت ﴿وَلَا تَكُن لِّلْخَائِنِينَ خَصِيمًا * وَاسْتَغْفِرِ اللَّهَ إِنَّ اللَّهَ كَانَ غَفُورًا رَّحِيمًا﴾.","reason":"الاستغفار بعد الهمّ بمجادلة الخائن: الاسم لمن كاد يميل.","adds":"يُري الاسم في تصحيح ميلٍ نبوي."},{"i":33,"of":33,"text":"هاجر خالدُ بنُ حزامٍ إلى أرضِ الحبشةِ ، فنهشَتْهُ حيَّةٌ في الطريقِ فمات ، فنزلت فيه :  وَمَنْ يَخْرُجْ مِنْ بَيْتِهِ مُهَاجِرًا إِلَى اللهِ وَرَسُولِهِ ثُمَّ يُدْرِكْهُ الْمَوْتُ فَقَدْ وَقَعَ أَجْرُهُ عَلَى اللهِ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا  [ النساء : 100 ] قال الزبيرُ بنُ العوامِ : وكنتُ أتوقَّعُه وأنتظرُ قُدومَه وأنا بأرضِ الحبشةِ ، فما أحزَنَنِي شيءٌ حُزنِي على وفاتِه حين بلغَني ؛ لأنَّهُ قلَّ أحدٌ ممن هاجر من قريشٍ إلا معه بعضُ أهلِه أو ذي رحمِه ، ولم يكن معي أحدٌ من بني أسدِ بنِ عبدِ العُزَّى ، ولا أرجو غيرَه","narrator":"الزبير بن العوام","source":"السلسلة الصحيحة 3218","grade":"حسن","judgment":"إسناده حسن رجاله ثقات","url":"https://dorar.net/h/XwJ4kIbM","nameForm":"غَفُورًا رَحِيمًا","scene":"خالد بن حزام هاجر إلى الحبشة فنهشته حية في الطريق فمات فنزلت ﴿وَمَن يَخْرُجْ مِن بَيْتِهِ مُهَاجِرًا إِلَى اللَّهِ وَرَسُولِهِ ثُمَّ يُدْرِكْهُ الْمَوْتُ فَقَدْ وَقَعَ أَجْرُهُ عَلَى اللَّهِ وَكَانَ اللَّهُ غَفُورًا رَّحِيمًا﴾ — قال الزبير: كنت أتوقعه وأنتظر قدومه.","reason":"من مات في الطريق قبل أن يبلغ: أجره وقع، والغفور الرحيم يتم له.","adds":"يقرن الاسم بمن مات دون غايته."}],"sunnah":{"card":"الصيغة: الْغَفُورُ الرَّحِيمُ — مركّبة، وردت «غفور رحيم» و«غفورًا رحيمًا» و«الغفور الرحيم»\nفي السنة: 27 شاهدًا (50 رواية)\nخصوصية الورود في السنة: أكثر خواتم القرآن ورودًا في أسباب النزول: بيعة النساء، والإفاضة من عرفات، وتوبة القاتل والزاني، والأسرى، وإكراه الجواري، والمهاجرين المفتونين، والسارقة، والمرتد الذي تاب، والأحرف السبعة؛ ودعاء أبي بكر في الصلاة «إنك أنت الغفور الرحيم» (البخاري)، وآية الزمر التي طاف بها عمر المدينة، وآية النساء 110 التي هي «أشد آية» وأرجاها، و«لو لم تذنبوا…».\nالمعنى المختصر: الغفور الذي يستر ويمحو، الرحيم الذي يرحم بعد المغفرة.","teaches":"1. أنه يغفر الذنوب جميعًا: نزلت لمن قالوا ما لمفتتن توبة.\n2. أن من استغفر «وجده» غفورًا رحيمًا — وإن زنى وإن سرق.\n3. أن مغفرته تُشترى بالعفو عن الناس والأهل.\n4. أن الحد والردة والقتل لا تغلق بابه.\n5. أنه لو لم يذنب العباد لخلق من يذنب ليغفر.","whenRecall":"- في صلاتك: دعاء أبي بكر.\n- حين تعفو عن مسيء: ألا تحبون أن يغفر الله لكم.\n- حين تظن أن لا توبة لك.\n- بعد إقامة حد أو عقوبة.\n- في صلاة الجنازة.","whenPray":"عند الشعور بـ:\n1. القنوط بعد ذنب عظيم.\n2. الغضب على من أساء إليك.\n3. الخوف من أن يُردّ عملك.\nعند طلب:\n1. مغفرة من عنده لا باستحقاق.\n2. المغفرة للميت.\nعند الرغبة في:\n1. أن تعفو لتُغفر لك.","duaItems":"1. دعاء الصلاة: «اللهم إني ظلمت نفسي ظلمًا كثيرًا ولا يغفر الذنوب إلا أنت فاغفر لي من عندك مغفرة إنك أنت الغفور الرحيم» — صحيح البخاري 7387.\n2. «اللهم إني أسألك يا الله بأنك الواحد الأحد الصمد الذي لم يلد ولم يولد ولم يكن له كفوًا أحد أن تغفر لي ذنوبي إنك أنت الغفور الرحيم» — صحيح النسائي 1300 (قال: قد غُفر له).\n3. الجنازة: «…اللهم فاغفر له وارحمه إنك أنت الغفور الرحيم» — تخريج سنن أبي داود 3202.","summary":"«الغفور الرحيم» في السنة دعاء أبي بكر في الصلاة، وآية الزمر التي كتبها عمر لأخيه المفتون، وآية النساء التي يجدها المستغفر وجدانًا «وإن زنى وإن سرق» — تُشترى مغفرته بالعفو، ولا يغلق بابه حدٌّ ولا ردة."},"situations":[{"situationId":3,"verses":[],"hadiths":[{"i":8,"strength":"direct","headline":"خسارة مالٍ أو حريةٍ في محنة","bridge":"خسرتَ مالًا أو حرية في محنة؟ بعثت زينب في فداء أبي العاص قلادة خديجة فرقّ النبي ﷺ، ونزلت ﴿إِنْ يَعْلَمِ اللَّهُ فِي قُلُوبِكُمْ خَيْرًا يُؤْتِكُمْ خَيْرًا مِمَّا أُخِذَ مِنْكُمْ وَيَغْفِرْ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾ — قال العباس: فأعطاني الله خيرًا مما أُخذ مني؛ فما فُقد بصدقٍ يُعوَّض."}]},{"situationId":4,"verses":[],"hadiths":[{"i":28,"strength":"direct","headline":"الصلاة على الميت والدعاء له بعد انقطاع عمله","bridge":"تصلي على ميت؟ «اللهم إن فلانًا في ذمتك وحبل جوارك… اللهم فاغفر له وارحمه إنك أنت الغفور الرحيم»."}]},{"situationId":5,"verses":[{"i":35,"strength":"direct","headline":"مرضٌ أو ضرٌّ يلحّ عليك ولا كاشف له سواه","bridge":"مرضٌ يلحّ عليك؟ الذي يمسّك بالضر هو وحده كاشفه، وانظر بأي اسمٍ خُتم تصريف الضر والخير كله: ﴿وَإِنْ يَمْسَسْكَ اللَّهُ بِضُرٍّ فَلَا كَاشِفَ لَهُ إِلَّا هُوَ... وَهُوَ الْغَفُورُ الرَّحِيمُ﴾ — فالماسك بملف وجعك غفورٌ رحيم، والضر بيد الرحمة لا بيد قدرةٍ باطشة."}],"hadiths":[]},{"situationId":10,"verses":[{"i":27,"strength":"direct","headline":"الخوف من أن يحاصرك قضاءٌ نزل بقومك وبيئتك","bridge":"تخاف أن يحاصرك قضاءٌ نزل بأمتك أو بيئتك؟ مع الإعلان التاريخي على الناكثين خُتم بالجناحين: ﴿إِنَّ رَبَّكَ لَسَرِيعُ الْعِقَابِ وَإِنَّهُ لَغَفُورٌ رَحِيمٌ﴾ — سريع العقاب سنةً في الأمم، وغفور رحيم بابًا لكل فرد؛ فالأحكام على الأمم لا تغلق باب الأفراد، وفردٌ تائب يخرج من قضاءٍ نزل بأمة."}],"hadiths":[]},{"situationId":15,"verses":[{"i":15,"strength":"direct","headline":"الوقوع في الذنب والحاجة إلى توبةٍ فورية","bridge":"أذنبتَ الآن؟ هذا عرضٌ مفتوح بلا شروطٍ معقدة: ﴿وَمَنْ يَعْمَلْ سُوءًا أَوْ يَظْلِمْ نَفْسَهُ ثُمَّ يَسْتَغْفِرِ اللَّهَ يَجِدِ اللَّهَ غَفُورًا رَحِيمًا﴾ — و«يجد» فعلُ تحققٍ فوري لا وعدٍ مؤجل؛ فاستغفر الآن تجد المغفرة حاضرة بين يديك."},{"i":19,"strength":"direct","headline":"المبادرة بالتوبة قبل أن تُمسك أو تُفضح","bridge":"بادر بالتوبة قبل أن تُمسك: حتى قاطع الطريق صاحبُ أغلظ الحدود إن تاب ﴿مِنْ قَبْلِ أَنْ تَقْدِرُوا عَلَيْهِمْ﴾ سقط عنه الحد وقيل: ﴿فَاعْلَمُوا أَنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — فتوبتك قبل أن تُفضح أو تُحاسب دليلُ صدقٍ يقابله الغفور الرحيم."},{"i":52,"strength":"direct","headline":"الوقوع في الذنب للتوّ","bridge":"أذنبتَ الآن؟ افعل ما فعل موسى فور الخطأ: ﴿قَالَ رَبِّ إِنِّي ظَلَمْتُ نَفْسِي فَاغْفِرْ لِي فَغَفَرَ لَهُ إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ﴾ — اعترافٌ فوري وطلبٌ مباشر، فجاء الجواب بفاء التعقيب بلا فاصل؛ لا تجعل بين الذنب والاستغفار مسافة."}],"hadiths":[{"i":12,"strength":"direct","headline":"الوقوع في خطأٍ جسيم والمبادرة إلى الاعتراف به","bridge":"أذنبت وتريد أن تعرف كم تستغرق المغفرة؟ في حديث الفتون: قتل موسى القبطي فقال ﴿رَبِّ إِنِّي ظَلَمْتُ نَفْسِي فَاغْفِرْ لِي فَغَفَرَ لَهُ إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ﴾ — اعتراف فمغفرة في الجملة نفسها؛ فلا تجعل بين الذنب والاعتراف مسافة."},{"i":20,"strength":"direct","headline":"الوقوع في الذنب والرغبة في وجدان المغفرة","bridge":"أذنبت؟ آية يقول ابن مسعود ما يسره أن له بها الدنيا وما فيها: ﴿وَمَنْ يَعْمَلْ سُوءًا أَوْ يَظْلِمْ نَفْسَهُ ثُمَّ يَسْتَغْفِرِ اللَّهَ يَجِدِ اللَّهَ غَفُورًا رَحِيمًا﴾ — «يجد» وجدان محقق؛ فاستغفر الآن تجده."}]},{"situationId":16,"verses":[{"i":23,"strength":"direct","headline":"التردد في التوبة حياءً وتوقعًا للتأنيب","bridge":"تستحي أن تعود لأنك تتوقع التأنيب؟ أُمر النبي ﷺ باستقبال المذنبين التائبين بـ﴿سَلَامٌ عَلَيْكُمْ﴾ لا بالتعيير، و﴿كَتَبَ رَبُّكُمْ عَلَى نَفْسِهِ الرَّحْمَةَ﴾ — فالباب الذي تتردد أمامه يُستقبل عنده العائدون بالسلام."},{"i":54,"strength":"direct","headline":"اليأس من التوبة بعد تكرار الذنب","bridge":"حتى منافقو الأحزاب الذين عوّقوا غيرهم وسلقوا المؤمنين بألسنةٍ حداد عُلّق أمرهم: ﴿أَوْ يَتُوبَ عَلَيْهِمْ إِنَّ اللَّهَ كَانَ غَفُورًا رَحِيمًا﴾ — فإذا لم يُغلق الباب في وجه أولئك، فمن ذا الذي يُغلق في وجهه بعد أن تكرر منه الذنب؟"},{"i":60,"strength":"direct","headline":"تكرار الذنب واليأس من قبول التوبة","bridge":"في هذه اللحظة ملائكةٌ ﴿يَسْتَغْفِرُونَ لِمَنْ فِي الْأَرْضِ﴾ وأنت لا تدري، والختم بأداة التنبيه: ﴿أَلَا إِنَّ اللَّهَ هُوَ الْغَفُورُ الرَّحِيمُ﴾ — فلا تكن أزهد في مغفرته من ملائكةٍ تسألها لغيرها وهم لا يذنبون."}],"hadiths":[{"i":21,"strength":"direct","headline":"تكرار الذنب وظنّ أن كفارته فضيحةٌ وعسر","bridge":"تظن أن ذنوبك المتكررة تحتاج كفارات مفضوحة؟ كان ذنب الإسرائيلي يُكتب على بابه، وهذه الأمة قيل لها: ﴿ثُمَّ يَسْتَغْفِرِ اللَّهَ يَجِدِ اللَّهَ غَفُورًا رَحِيمًا﴾ — قال ابن مسعود: ما آتاكم الله خيرًا مما آتاهم؛ فتوبتك سر بينك وبين الغفور الرحيم مهما تكررت."},{"i":31,"strength":"direct","headline":"تكرار الذنب وظنّ أنه أخرجك من الرحمة","bridge":"تظن أن تكرار ذنبك أخرجك من رحمته؟ «لو أن العباد لم يذنبوا لخلق الله خلقًا يذنبون ثم يستغفرون ثم يغفر لهم، وهو الغفور الرحيم» — الاسم يقتضي مذنبًا يستغفر؛ فذنبك وقود اسمه لا مانعٌ منه، بشرط الاستغفار."}]},{"situationId":17,"verses":[{"i":26,"strength":"direct","headline":"استعظام خطيئةٍ كبيرة واليأس من قبول التوبة","bridge":"خطيئتك تبدو لك أكبر من أن تُغفر؟ قومٌ عبدوا عجلًا بعد أن شقّ الله لهم البحر، ثم قيل: ﴿وَالَّذِينَ عَمِلُوا السَّيِّئَاتِ ثُمَّ تَابُوا مِنْ بَعْدِهَا وَآمَنُوا إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ﴾ — بعد السيئات مباشرةً تنقلب الصفحة إن انقلب القلب."},{"i":44,"strength":"direct","headline":"الذنب عن علمٍ والظن أنه لا عذر ولا توبة","bridge":"تقول: أذنبتُ وأنا أعلم فلا عذر لي؟ قال السلف: كل من عصى الله فهو جاهلٌ حالَ معصيته — فباب ﴿عَمِلُوا السُّوءَ بِجَهَالَةٍ﴾ يسعك، والطريق ثابت: ﴿ثُمَّ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ﴾."},{"i":50,"strength":"direct","headline":"ماضٍ مثقلٌ بالكبائر واليأس من محوه","bridge":"ماضيك أسود؟ بعد ذكر الشرك والقتل والزنى — أكبر الكبائر — جاء الاستثناء: ﴿إِلَّا مَنْ تَابَ وَآمَنَ وَعَمِلَ عَمَلًا صَالِحًا فَأُولَئِكَ يُبَدِّلُ اللَّهُ سَيِّئَاتِهِمْ حَسَنَاتٍ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا﴾ — ليس محوًا فحسب بل تبديل: صحيفة الجرائم تنقلب صحيفة أجور."},{"i":58,"strength":"direct","headline":"ثقل الكبائر والميل إلى القنوط من المغفرة","bridge":"أثقلتك كبائرك حتى ملت إلى القنوط؟ الآية نزلت في قومٍ مثلك (صحيح مسلم 122) فقالت ﴿لَا تَقْنَطُوا﴾ صريحًا، وعمّمت ﴿يَغْفِرُ الذُّنُوبَ جَمِيعًا﴾ لمن تاب — والميزان أن تسمع النهي عن القنوط دون أن تنسى شرط الرجوع الذي جاء في الآية التالية: ﴿وَأَنِيبُوا إِلَى رَبِّكُمْ﴾."}],"hadiths":[{"i":5,"strength":"direct","headline":"اقتراف الكبائر كالقتل والفواحش والقنوط من التوبة","bridge":"قتلتَ أو أتيت الفواحش فيئست؟ لما نزل جزاء القاتل قال أهل الشرك: قد قتلنا النفس وأتينا الفواحش، فأنزل الله ﴿إِلَّا مَنْ تَابَ وَآمَنَ وَعَمِلَ عَمَلًا صَالِحًا﴾ إلى ﴿غَفُورًا رَحِيمًا﴾ كما روى ابن عباس — التوبة تبدل السيئات حسنات حتى للقاتل والزاني."}]},{"situationId":19,"verses":[{"i":20,"strength":"direct","headline":"الشعور بالسقوط الأبدي بعد عقوبةٍ أو فضيحة","bridge":"أُقيمت عليك عقوبةٌ أو فُضحت بذنبك وظننت أنه سقوطك الأبدي؟ بعد حد السرقة مباشرة: ﴿فَمَنْ تَابَ مِنْ بَعْدِ ظُلْمِهِ وَأَصْلَحَ فَإِنَّ اللَّهَ يَتُوبُ عَلَيْهِ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — عقوبة الأرض لا تُغلق باب السماء."},{"i":34,"strength":"direct","headline":"خلط العمل الصالح بالسيئ واليأس من التوبة","bridge":"لست ملَكًا ولا شيطانًا، أنت من أكثر الناس: ﴿خَلَطُوا عَمَلًا صَالِحًا وَآخَرَ سَيِّئًا﴾ — وطريقهم المفتوح: ﴿اعْتَرَفُوا بِذُنُوبِهِمْ﴾ بلا تبرير، وجزاؤهم: ﴿عَسَى اللَّهُ أَنْ يَتُوبَ عَلَيْهِمْ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — فابدأ من حيث بدؤوا: الاعتراف."}],"hadiths":[]},{"situationId":22,"verses":[{"i":22,"strength":"direct","headline":"التأرجح بين القنوط والأمن من مكر الله","bridge":"تتأرجح بين قنوطٍ وأمن؟ احفظ آية الميزان: ﴿اعْلَمُوا أَنَّ اللَّهَ شَدِيدُ الْعِقَابِ وَأَنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — أمرٌ بعلمَين متقابلين في جملة واحدة؛ فالسير إليه بجناحين، ومن طار بجناحٍ واحد سقط: إما إلى الأمن من المكر أو إلى القنوط."},{"i":37,"strength":"direct","headline":"الاغترار بصلاح النفس أو اليأس منها","bridge":"عِش بين طرفي الآية: ﴿إِنَّ النَّفْسَ لَأَمَّارَةٌ بِالسُّوءِ﴾ فلا تأمن نفسك، و﴿إِلَّا مَا رَحِمَ رَبِّي إِنَّ رَبِّي غَفُورٌ رَحِيمٌ﴾ فلا تيأس منها — من نجا فبرحمته، ومن زلّ فبين يدي رحمته؛ لا عذر للأمن ولا مبرر للقنوط."},{"i":62,"strength":"direct","headline":"التأرجح بين الخوف والرجاء عند تذكّر مشيئة الله المطلقة","bridge":"حين تُذكر مشيئته المطلقة انظر إلى الترتيب: ﴿يَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا﴾ — البداية مغفرة والنهاية رحمة والعذاب محفوف بينهما لمن أبى؛ فافهم ميل الميزان دون أن تلغي كفته الأخرى."}],"hadiths":[{"i":13,"strength":"direct","headline":"التأرجح بين الاتكال على العمل ورجاء المغفرة","bridge":"تحتار بين عملك ورحمة ربك؟ «يا ابن آدم ثلاثة: واحدة لي: تعبدني لا تشرك بي، وواحدة لك: ما عملت من عمل جزيتك به فإن أغفر فأنا الغفور الرحيم، وواحدة بيني وبينك: عليك الدعاء وعلي الاستجابة» — اعمل وارجُ المغفرة وادعُ؛ ثلاثة أطراف يتوازن بها القلب."},{"i":22,"strength":"direct","headline":"اشتداد الخوف من آيات الوعيد والجزاء على السوء","bridge":"تهزك آيات الوعيد حتى لا تهنأ؟ قال عمر عن ﴿مَنْ يَعْمَلْ سُوءًا يُجْزَ بِهِ﴾: ما نفعنا طعام ولا شراب حتى نزل ﴿ثُمَّ يَسْتَغْفِرِ اللَّهَ يَجِدِ اللَّهَ غَفُورًا رَحِيمًا﴾ — الخوف الذي يقطع الطعام يوازنه الاسم؛ فاقرأ الآيتين معًا كما عاشهما عمر."}]},{"situationId":23,"verses":[{"i":40,"strength":"direct","headline":"الشعور بالبعد عن الله بعد الذنوب","bridge":"تظن أن الله بعيدٌ عنك بعد ما فعلت؟ اسمع نبأً رسميًّا أُمر النبي ﷺ بتبليغه لك بثلاث مؤكدات: ﴿نَبِّئْ عِبَادِي أَنِّي أَنَا الْغَفُورُ الرَّحِيمُ﴾ — هويته المعلنة أولًا: الغفور الرحيم، وقد بلغك النبأ."}],"hadiths":[]},{"situationId":24,"verses":[{"i":45,"strength":"direct","headline":"وصمة ذنبٍ عُرف به المرء بين الناس","bridge":"وُصمتَ بذنبٍ أمام الناس حتى استحييت؟ القاذف المجلود المردود الشهادة الموصوم بالفسق قيل فيه: ﴿إِلَّا الَّذِينَ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — لا وصمة أبدية عند الله؛ التوبة تعيد اعتبارك عنده وإن تأخر الناس."},{"i":51,"strength":"direct","headline":"ذنبٌ قديم يلاحقك ويعطّل مسيرك","bridge":"ذنبٌ قديم يلاحقك ويمنعك من أن تتقدم؟ موسى كان قتل نفسًا، فلما نُودي في الوادي المقدس خُوطب بأحنى صيغة: ﴿إِلَّا مَنْ ظَلَمَ ثُمَّ بَدَّلَ حُسْنًا بَعْدَ سُوءٍ فَإِنِّي غَفُورٌ رَحِيمٌ﴾ — قاتل الأمس صار كليم اليوم؛ فبدّل حُسنًا وامضِ."},{"i":68,"strength":"direct","headline":"ماضٍ مثقلٌ بالذنوب يلاحقك بعد التوبة","bridge":"تخشى أن يُذكّرك ماضيك كلما تقدمت؟ المؤمنات القادمات من الجاهلية بشركها وذنوبها أُمر النبي ﷺ أن يبايعهن ويستغفر لهن: ﴿فَبَايِعْهُنَّ وَاسْتَغْفِرْ لَهُنَّ اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — من دخل في العهد الجديد فصفحته مطوية، فلا تُذكّر نفسك بما طواه الله."}],"hadiths":[{"i":24,"strength":"direct","headline":"ظنّ انغلاق باب التوبة بعد إقامة الحد","bridge":"أُقيم عليك حدٌّ فظننتَ أن لا توبة؟ امرأة سرقت فقُطعت يدها فسألت: هل لي من توبة؟ قال ﷺ: «نعم، أنت اليوم من خطيئتك كيوم ولدتك أمك» فنزلت ﴿فَمَنْ تَابَ مِنْ بَعْدِ ظُلْمِهِ وَأَصْلَحَ فَإِنَّ اللَّهَ يَتُوبُ عَلَيْهِ﴾ — عقوبة الأرض لا تغلق باب السماء."},{"i":29,"strength":"direct","headline":"تائبٌ يخشى أن تلاحقه وصمة ذنبه القديم","bridge":"زنى رجلٌ بامرأة ثم تاب فيريد أن يتزوجها؟ سُئل ابن مسعود فتلا ﴿وَالَّذِينَ عَمِلُوا السَّيِّئَاتِ ثُمَّ تَابُوا مِنْ بَعْدِهَا وَآمَنُوا إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ﴾ عشر مرات — الجواب بالاسم عشرًا: التوبة تمحو، ولا تُبقِ على تائبٍ وصمة."}]},{"situationId":26,"verses":[{"i":10,"strength":"direct","headline":"محاسبة النفس على ما فُعل قبل معرفة الحكم","bridge":"تحاسب نفسك على ما فعلته قبل أن تعرف الحكم؟ في المحرمات من النساء: ﴿إِلَّا مَا قَدْ سَلَفَ إِنَّ اللَّهَ كَانَ غَفُورًا رَحِيمًا﴾ — الشرع لا يحاسب على ما قبل العلم، والاسمان يطويان صفحة الماضي؛ فقاعدة «عفا الله عما سلف» تجعل ما فعلته قبل البيان مطويًّا برحمته."},{"i":42,"strength":"direct","headline":"الندم على ما قيل أو فُعل تحت القهر والإكراه","bridge":"قلتَ أو فعلتَ تحت قهرٍ حقيقي ما تندم عليه؟ من فُتن فنطق بالكفر مكرهًا وقلبه مطمئن ثم هاجر وجاهد وصبر: ﴿إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ﴾ — كلمة الإكراه مغفورة وصاحبها المجروح مرحوم؛ والعبرة بما بعدها: هل نهضت وواصلت؟"},{"i":47,"strength":"direct","headline":"الإكراه على معصيةٍ وحمل وزرها في النفس","bridge":"أُكرهتَ على أمرٍ لا تريده وتحمل وزره في نفسك؟ المغفرة والرحمة في الآية للمُكرَهات الضحايا لا للمُكرِه: ﴿وَمَنْ يُكْرِهْهُنَّ فَإِنَّ اللَّهَ مِنْ بَعْدِ إِكْرَاهِهِنَّ غَفُورٌ رَحِيمٌ﴾ — الإثم على من أكره، والرحمة لجرح الضحية؛ فمن أُكره على معصيةٍ فالوزر على مُكرِهه."},{"i":53,"strength":"direct","headline":"زلّة لسانٍ بخطأٍ لم تقصده","bridge":"سبق لسانك بخطأٍ لم تقصده؟ ﴿وَلَيْسَ عَلَيْكُمْ جُنَاحٌ فِيمَا أَخْطَأْتُمْ بِهِ وَلَكِنْ مَا تَعَمَّدَتْ قُلُوبُكُمْ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا﴾ — كانوا لا يدعون زيدًا إلا «زيدَ بنَ مُحَمَّدٍ» حتى نزلت (صحيح البخاري 4782)، فمن سبق لسانه بذلك سهوًا فلا جناح عليه؛ وميزان المؤاخذة قلبك لا لسانك، وما سبق به لسانك بلا قصدٍ مطويٌّ بالمغفرة."}],"hadiths":[{"i":7,"strength":"direct","headline":"الإكراه على المعصية ظلمًا من صاحب سلطة","bridge":"أُكرهتَ على معصية؟ كان عبد الله بن أبي يكره جاريتيه على الزنا فشكتا إلى النبي ﷺ فنزلت ﴿وَلَا تُكْرِهُوا فَتَيَاتِكُمْ عَلَى الْبِغَاءِ… فَإِنَّ اللَّهَ مِنْ بَعْدِ إِكْرَاهِهِنَّ غَفُورٌ رَحِيمٌ﴾ — الاسم للمظلومة لا للظالم؛ فالوزر على من أكرهك."},{"i":18,"strength":"direct","headline":"عملٌ صالح تخاف أن تكون آثمًا فيه لا مأجورًا","bridge":"عملتَ وتخاف أن تكون آثمًا لا مأجورًا؟ قاتلت سرية عبد الله بن جحش ولم تدرِ أن اليوم من الشهر الحرام، فقيل: إن لم يكونوا أصابوا وزرًا فليس لهم أجر، فنزلت ﴿أُولَٰئِكَ يَرْجُونَ رَحْمَتَ اللَّهِ وَاللَّهُ غَفُورٌ رَّحِيمٌ﴾ — المجاهد الذي خاف الإثم رُجّي بالاسم؛ فارجُ ولا تحكم على عملك."}]},{"situationId":27,"verses":[{"i":8,"strength":"direct","headline":"الحياء من الرجوع إلى الله بعد انتكاسةٍ كبيرة","bridge":"استحييت من الرجوع؟ حتى من كفر بعد إيمانه وازداد كفرًا لم يُستثنَ من الباب: ﴿إِلَّا الَّذِينَ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — فلم يستثنِ القرآن ذنبًا من التوبة ما دام صاحبه حيًّا صادقًا، وذنبك أهون مما فُتح له الباب."}],"hadiths":[{"i":11,"strength":"direct","headline":"القنوط من التوبة بعد الفتنة في الدين","bridge":"قنطت؟ كان الصحابة يقولون ما لمفتتن توبة، فنزلت: ﴿لَا تَقْنَطُوا مِن رَّحْمَةِ اللَّهِ إِنَّ اللَّهَ يَغْفِرُ الذُّنُوبَ جَمِيعًا إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ﴾ — كتبها عمر لصاحبه هشام بن العاص فرجع."},{"i":19,"strength":"direct","headline":"العودة إلى الدين بعد الفتنة عنه والضعف فيه","bridge":"فُتنت عن دينك ثم تريد العودة؟ كتب المسلمون إلى المفتونين بمكة ﴿ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ هَاجَرُوا مِنْ بَعْدِ مَا فُتِنُوا ثُمَّ جَاهَدُوا وَصَبَرُوا إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ﴾ — الآية وعدت من هاجر بعد الفتنة وجاهد وصبر؛ فمن فُتن ثم عاد فمغفرته موعودة."},{"i":25,"strength":"direct","headline":"الندم بعد الردة أو ترك الدين والسؤال عن التوبة","bridge":"ارتددتَ أو تركتَ الدين ثم ندمت؟ أنصاريٌّ ارتد ولحق بالشرك ثم ندم فأرسل: سلوا لي رسول الله هل لي من توبة؟ فنزلت الآيات مختومةً بـ﴿غَفُورٌ رَحِيمٌ﴾ فأرسل إليه فأسلم — حتى المرتد له توبة، فذنبك أهون."}]},{"situationId":29,"verses":[{"i":61,"strength":"direct","headline":"الرد على من اتهمك ظلمًا مع إبقاء باب الرجوع","bridge":"اتُّهمتَ بالكذب أو الافتراء ولا تملك بيّنة؟ ﴿قُلْ إِنِ افْتَرَيْتُهُ فَلَا تَمْلِكُونَ لِي مِنَ اللَّهِ شَيْئًا هُوَ أَعْلَمُ بِمَا تُفِيضُونَ فِيهِ كَفَى بِهِ شَهِيدًا بَيْنِي وَبَيْنَكُمْ وَهُوَ الْغَفُورُ الرَّحِيمُ﴾ — اجعل الله شهيدك، وأبقِ للمتهمين باب الرجوع؛ فقد يصيرون إخوتك."}],"hadiths":[]},{"situationId":35,"verses":[{"i":29,"strength":"direct","headline":"خسارة مالٍ أو مكانةٍ في طريق الحق","bridge":"خسرتَ مالًا أو مكانة في طريق الحق؟ حتى أسرى بدر المشركون خوطبوا بالرجاء: ﴿إِنْ يَعْلَمِ اللَّهُ فِي قُلُوبِكُمْ خَيْرًا يُؤْتِكُمْ خَيْرًا مِمَّا أُخِذَ مِنْكُمْ وَيَغْفِرْ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾ — وتحققت في العباس وغيره؛ فأصلح قلبك، والتعويض والمغفرة على الغفور الرحيم."}],"hadiths":[]},{"situationId":45,"verses":[{"i":33,"strength":"direct","headline":"دفع الصدقة على مضض كأنها غرامة","bridge":"تدفع النفقة على مضض كأنها مغرم؟ المبلغ نفسه يدفعه اثنان: ﴿وَمِنَ الْأَعْرَابِ مَنْ يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَيَتَّخِذُ مَا يُنْفِقُ قُرُبَاتٍ عِنْدَ اللَّهِ... أَلَا إِنَّهَا قُرْبَةٌ لَهُمْ سَيُدْخِلُهُمُ اللَّهُ فِي رَحْمَتِهِ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — أحدهما غارم والآخر متقرب؛ فالنية تقلب المغرم قربة."}],"hadiths":[]},{"situationId":48,"verses":[{"i":6,"strength":"direct","headline":"الرجوع عن قرارٍ اتخذته غاضبًا بهجر أهلك","bridge":"حلفتَ في غضبك على هجر زوجتك؟ ﴿لِلَّذِينَ يُؤْلُونَ مِنْ نِسَائِهِمْ تَرَبُّصُ أَرْبَعَةِ أَشْهُرٍ فَإِنْ فَاءُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — الرجوع عن قرارٍ اتخذته غاضبًا ليس ضعفًا بل فيئةٌ يحبها الغفور الرحيم: يغفر حدّتك ويرحم بيتًا عاد إلى استقراره؛ فلا تجعل الغضب يكتب مصير بيتك."},{"i":16,"strength":"direct","headline":"العجز عن العدل في مشاعر القلب بين الأهل","bridge":"تشعر أنك لا تعدل في مشاعرك بين أهلك؟ اعترف الشرع بعجز القلب: ﴿وَلَنْ تَسْتَطِيعُوا أَنْ تَعْدِلُوا بَيْنَ النِّسَاءِ وَلَوْ حَرَصْتُمْ فَلَا تَمِيلُوا كُلَّ الْمَيْلِ... وَإِنْ تُصْلِحُوا وَتَتَّقُوا فَإِنَّ اللَّهَ كَانَ غَفُورًا رَحِيمًا﴾ — تُكلَّف عدل فعلك لا مشاعر قلبك، والفارق بينهما مغفور."},{"i":69,"strength":"direct","headline":"العفو عن أذى الأهل والصفح عنهم","bridge":"صدّك أقرب الناس، زوجٌ أو ولد، عن خير أردته؟ ﴿إِنَّ مِنْ أَزْوَاجِكُمْ وَأَوْلَادِكُمْ عَدُوًّا لَكُمْ فَاحْذَرُوهُمْ وَإِنْ تَعْفُوا وَتَصْفَحُوا وَتَغْفِرُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — احذر، لكن العلاج ثلاث درجات: عفوٌ فصفحٌ فغفران؛ فالتخلق بالاسم يبدأ داخل بيتك."},{"i":70,"strength":"direct","headline":"عتاب من تحب على خطأٍ وقع منه","bridge":"تعاتب شريكك على خطأ؟ تعلّم من عتاب الله لأحب الخلق إليه: ﴿لِمَ تُحَرِّمُ مَا أَحَلَّ اللَّهُ لَكَ تَبْتَغِي مَرْضَاتَ أَزْوَاجِكَ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾ — سمّى الخطأ بوضوح ولفّه بالمغفرة في الجملة نفسها؛ فعاتب من تحب بتسمية الخطأ ومغفرةٍ تسبق النطق."}],"hadiths":[]},{"situationId":50,"verses":[{"i":11,"strength":"direct","headline":"تأخر الزواج والخوف على النفس من الحرام","bridge":"تأخر زواجك حتى خشيت على نفسك؟ الشرع فتح مخرجًا لمن خشي العنت مع بيان أن الصبر خير: ﴿ذَلِكَ لِمَنْ خَشِيَ الْعَنَتَ مِنْكُمْ وَأَنْ تَصْبِرُوا خَيْرٌ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾ — الغفور الرحيم يسع الحالين: يرحم من أخذ بالمخرج لضعفه ويأجر من صبر؛ فالدين لا يفضح ضعفك بل يفتح له مخارج."}],"hadiths":[]},{"situationId":52,"verses":[{"i":38,"strength":"direct","headline":"ولدٌ جنى جنايةً كبيرة ثم جاء نادمًا يطلب الاستغفار","bridge":"جنى عليك ولدك جنايةً كبيرة؟ يعقوب قال لبنيه الذين أخذوا يوسف: ﴿سَوْفَ أَسْتَغْفِرُ لَكُمْ رَبِّي إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ﴾ — أخّر الاستغفار إلى السحر تحريًا للإجابة، وقدّم يقينه بضمير الحصر؛ فالوالد يستغفر لولده الجاني مهما فعل، ويتحرّى له وقت السحر."}],"hadiths":[]},{"situationId":54,"verses":[{"i":2,"strength":"direct","headline":"وصيةٌ جائرة تحتاج إصلاحًا بين الورثة","bridge":"رأيتَ في وصيةٍ جنفًا على بعض الورثة؟ ﴿فَمَنْ خَافَ مِنْ مُوصٍ جَنَفًا أَوْ إِثْمًا فَأَصْلَحَ بَيْنَهُمْ فَلَا إِثْمَ عَلَيْهِ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — تعديل ظلم الميت ليس خيانةً له بل إصلاحٌ يحبه الغفور الرحيم؛ فالإصلاح مقدَّم على حرفية وصيةٍ ظالمة، والوسيط المصلح مأجور."}],"hadiths":[]},{"situationId":56,"verses":[{"i":63,"strength":"direct","headline":"إساءة الناس إليك أدبًا عن جهلٍ لا عن خبث","bridge":"يسيء إليك الناس أدبًا عن جهلٍ لا عن خبث؟ أعرابٌ جفاة صاحوا بالنبي من وراء الحجرات فعُلّموا بلطف: ﴿وَلَوْ أَنَّهُمْ صَبَرُوا حَتَّى تَخْرُجَ إِلَيْهِمْ لَكَانَ خَيْرًا لَهُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾ — سوء الأدب الصادر عن جهل يُعالج بالتعليم والمغفرة؛ فعلّم واغفر كما عومل الجفاة مع سيد الخلق."}],"hadiths":[]},{"situationId":57,"verses":[{"i":46,"strength":"direct","headline":"صعوبة العفو عمّن جرحك في أغلى ما عندك","bridge":"يعزّ عليك العفو عمّن جرحك في أغلى ما عندك؟ أبو بكر حلف ألا ينفق على مسطح الذي خاض في عرض ابنته، فنزل: ﴿وَلْيَعْفُوا وَلْيَصْفَحُوا أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللَّهُ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾ فقال: بلى، وأعاد النفقة — فاسأل نفسك سؤال الآية وأجب جواب الصدّيق."}],"hadiths":[{"i":14,"strength":"direct","headline":"القدرة على معاقبة من أساء إليك في عرضك وأهلك","bridge":"تملك من أساء إليك في أغلى ما عندك؟ حلف أبو بكر ألا ينفق على مسطح الذي خاض في عرض ابنته، فنزل ﴿أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللَّهُ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾ فقال: بلى، وأعاد النفقة — العفو مع القدرة ثمنه مغفرة الغفور الرحيم؛ فأجب كما أجاب الصديق."},{"i":23,"strength":"direct","headline":"أهلٌ ثبّطوك عن الخير وتهمّ بمعاقبتهم","bridge":"ثبّطك أهلك عن خير؟ ﴿وَإِن تَعْفُوا وَتَصْفَحُوا وَتَغْفِرُوا فَإِنَّ اللَّهَ غَفُورٌ رَّحِيمٌ﴾ — نزلت فيمن منعهم أهلهم الهجرة فأرادوا معاقبتهم."}]},{"situationId":59,"verses":[{"i":9,"strength":"direct","headline":"الحكم على من عاداك بماضيه ورفض عودته","bridge":"تحكم على مصير من عاداك بما رأيت منه؟ ﴿يَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾ — حتى النبي ﷺ قيل له ليس لك من الأمر شيء، وقد أسلم بعض من دعا عليهم؛ فعدوّ اليوم قد يكون في سجل المغفورين غدًا، فاستقبل العائد ولا تحكم عليه بماضيه."}],"hadiths":[{"i":15,"strength":"direct","headline":"الشماتة بمن أُقيمت عليه عقوبة","bridge":"أُقيم على أحد حد أو عقوبة فتشمّت به الناس؟ حزن النبي ﷺ لقطع السارق وقال: «لا تكونوا أعوانًا للشيطان على أخيكم… إن الله عفو يحب العفو» وتلا ﴿وَاللَّهُ غَفُورٌ رَحِيمٌ﴾ — العقوبة تُقام ويبقى أخاك؛ فلا تكن عون الشيطان عليه بالتعيير."}]},{"situationId":63,"verses":[{"i":14,"strength":"direct","headline":"اكتشاف أنك دافعت عن مخطئ أو ظلمت بريئًا بحسن نية","bridge":"اكتشفتَ أنك دافعتَ عن مخطئ أو ظلمتَ بريئًا بحسن نية؟ حتى النبي ﷺ حين مال إلى ظاهرٍ برّأ خائنًا خوطب: ﴿وَاسْتَغْفِرِ اللَّهَ إِنَّ اللَّهَ كَانَ غَفُورًا رَحِيمًا﴾ — النية لا تصحح الخطأ لكنها تفتح باب المغفرة؛ فاستغفر وصحّح قبل أن يبرد الأمر."}],"hadiths":[{"i":32,"strength":"direct","headline":"الميل إلى طرفٍ في خصومة لحسن الظن به","bridge":"كدتَ تميل إلى طرفٍ في خصومة لحسن ظنك به؟ بنو أبيرق سرقوا ورموا بريئًا فهمّ النبي ﷺ أن يجادل عنهم فنزلت ﴿وَلَا تَكُنْ لِلْخَائِنِينَ خَصِيمًا * وَاسْتَغْفِرِ اللَّهَ إِنَّ اللَّهَ كَانَ غَفُورًا رَحِيمًا﴾ — الميل عن العدل بحسن نية يُستغفر منه، فاستغفر وأعد الحق."}]},{"situationId":66,"verses":[{"i":57,"strength":"direct","headline":"الخوف من ثقل الأمانة والتقصير فيها","bridge":"تخاف من ثقل الأمانة التي تحملها؟ حملها الإنسان ﴿ظَلُومًا جَهُولًا﴾ لكن العاقبة فرّقت: عذابٌ لأهل النفاق والشرك، ﴿وَيَتُوبَ اللَّهُ عَلَى الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا﴾ — فخف من خيانة الأمانة، وارجُ لأن ختام حملها للمؤمن توبةٌ من غفورٍ رحيم."}],"hadiths":[]},{"situationId":70,"verses":[{"i":3,"strength":"direct","headline":"كفّ الخصم عن عدوانه وقبول رجوعه","bridge":"انتهى من كان يحاربك أو يؤذيك وتتردد في قبوله؟ حتى في ساحة الحرب: ﴿فَإِنِ انْتَهَوْا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — السيف يتوقف حيث يتوقف العدوان، والمقاتل بالأمس إن انتهى فبابه مفتوح فورًا؛ فمن فتح الله له الباب لا تُغلقه أنت."},{"i":30,"strength":"direct","headline":"استقبال من تاب بعد أن كان يعادي أهل الحق","bridge":"تاب من كان يقاتل أهل الحق فكيف تعامله؟ حتى آية السيف انتهت بشرط التوبة: ﴿فَإِنْ تَابُوا وَأَقَامُوا الصَّلَاةَ وَآتَوُا الزَّكَاةَ فَخَلُّوا سَبِيلَهُمْ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — «فخلّوا سبيلهم» حكم الأرض و«غفور رحيم» حكم السماء؛ فمن دخل في التوبة خرج من كل حسابٍ مضى."},{"i":31,"strength":"direct","headline":"انكسار الخصم والرغبة في التشفّي منه","bridge":"انكسر خصمك وترى في كسره فرصةً للتشفي؟ بعد حنين مباشرة: ﴿ثُمَّ يَتُوبُ اللَّهُ مِنْ بَعْدِ ذَلِكَ عَلَى مَنْ يَشَاءُ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾ — وقد أسلمت هوازن وردّ النبي ﷺ عليهم السبي؛ فانكسار خصمك قد يكون بداية هدايته، فافتح له الباب كما فتحه الله."}],"hadiths":[]},{"situationId":84,"verses":[{"i":25,"strength":"direct","headline":"مقارنة رزقك برزق غيرك وتفاوت الدرجات","bridge":"تقرأ تفاوت الأرزاق قراءة حسدٍ أو زهو؟ ﴿وَرَفَعَ بَعْضَكُمْ فَوْقَ بَعْضٍ دَرَجَاتٍ لِيَبْلُوَكُمْ فِي مَا آتَاكُمْ إِنَّ رَبَّكَ سَرِيعُ الْعِقَابِ وَإِنَّهُ لَغَفُورٌ رَحِيمٌ﴾ — التفاوت ابتلاء لا تفضيل نهائي، والدرجات الدنيوية لا تدل على الدرجات الأخروية؛ فاقرأه سؤال امتحان: ماذا ستفعل بما أوتيت؟"}],"hadiths":[]},{"situationId":107,"verses":[{"i":49,"strength":"direct","headline":"الطعن في القرآن والدين أمامك","bridge":"طُعن في القرآن أمامك؟ الرد برهانٌ ثم دعوة: ﴿قُلْ أَنْزَلَهُ الَّذِي يَعْلَمُ السِّرَّ فِي السَّمَاوَاتِ وَالْأَرْضِ إِنَّهُ كَانَ غَفُورًا رَحِيمًا﴾ — إعجازه من إحاطة علمه، وبدل تهديد الطاعنين فُتح لهم الباب؛ فمنهج الرد على من طعن في دينك: حجةٌ قوية وبابٌ مفتوح لا شتيمة وقطيعة."}],"hadiths":[]},{"situationId":114,"verses":[{"i":17,"strength":"direct","headline":"الخوف من الزيغ عن بعض ما آمنت به","bridge":"تخاف أن تُفرّق بين ما آمنت به فتزيغ؟ الوعد لمن ثبت على الإيمان كله: ﴿وَالَّذِينَ آمَنُوا بِاللَّهِ وَرُسُلِهِ وَلَمْ يُفَرِّقُوا بَيْنَ أَحَدٍ مِنْهُمْ أُولَئِكَ سَوْفَ يُؤْتِيهِمْ أُجُورَهُمْ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا﴾ — وحدة الإيمان بالرسل كلهم شرط القبول، وأجرها محفوف بمغفرةٍ ورحمة؛ فاثبت على الكل ولا تتبعض."}],"hadiths":[]},{"situationId":115,"verses":[{"i":59,"strength":"direct","headline":"الخوف من لحظة الرحيل وسوء الخاتمة","bridge":"تخاف لحظة الرحيل؟ للمستقيمين تتنزل الملائكة عند الموت: ﴿أَلَّا تَخَافُوا وَلَا تَحْزَنُوا... نُزُلًا مِنْ غَفُورٍ رَحِيمٍ﴾ — سُمّيت الجنة نُزلًا: ضيافةً معدّة للنازل من غفورٍ رحيم، وأول أسباب دخولها مغفرةٌ تُسقط الذنوب؛ فاستقم يتنزّل عليك حاملو البطاقة عند الرحيل."}],"hadiths":[]},{"situationId":130,"verses":[{"i":39,"strength":"direct","headline":"إعراض من دعوتهم والهمّ بالدعاء عليهم","bridge":"أعرض عنك من دعوتهم فأردت أن تدعو عليهم؟ اسمع الخليل: ﴿فَمَنْ تَبِعَنِي فَإِنَّهُ مِنِّي وَمَنْ عَصَانِي فَإِنَّكَ غَفُورٌ رَحِيمٌ﴾ — لم يقل «فعذّبه» بل فوّض العاصي إلى الغفور الرحيم رجاء أن يهديه؛ فبدل اللعن والدعاء على المخالفين، كِلهم إلى رحمته."}],"hadiths":[]},{"situationId":131,"verses":[{"i":21,"strength":"direct","headline":"اليأس من هداية من قال في الله أغلظ مقالة","bridge":"تدعو من قال في الله أغلظ مقالة وتيأس منه؟ حتى من قالوا إنه ثالث ثلاثة دُعوا دعوة مشفق: ﴿أَفَلَا يَتُوبُونَ إِلَى اللَّهِ وَيَسْتَغْفِرُونَهُ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾ — التشخيص القاسي للباطل لم يمنع أرقّ عرضٍ للعودة؛ فمنهج الدعوة: سمِّ الباطل باسمه ثم افتح الباب بأرقّ عبارة."}],"hadiths":[]},{"situationId":134,"verses":[{"i":67,"strength":"direct","headline":"خصومةٌ طويلةٌ تبدو بلا نهاية","bridge":"خصومةٌ ترى أن لا نهاية لها؟ وُعد المؤمنون: ﴿عَسَى اللَّهُ أَنْ يَجْعَلَ بَيْنَكُمْ وَبَيْنَ الَّذِينَ عَادَيْتُمْ مِنْهُمْ مَوَدَّةً وَاللَّهُ قَدِيرٌ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾ — وقد أسلم كبار محاربي الأمس وصاروا إخوة؛ فاترك في كل خصومةٍ موضعًا للمصالحة، فالغفور الرحيم يمحو ماضي العداوة كله."}],"hadiths":[]},{"situationId":138,"verses":[{"i":64,"strength":"direct","headline":"التعامل مع من هو في أول طريق الالتزام","bridge":"عندك من هو في أول طريق الالتزام وتخشى أن تُحبطه؟ صُححت دعوى الأعراب بلا تنفير: ﴿قُلْ لَمْ تُؤْمِنُوا وَلَكِنْ قُولُوا أَسْلَمْنَا... وَإِنْ تُطِيعُوا اللَّهَ وَرَسُولَهُ لَا يَلِتْكُمْ مِنْ أَعْمَالِكُمْ شَيْئًا إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — «أسلمنا» بداية مقبولة والإيمان يدخل القلب بالطاعة تدريجًا؛ فلا تحتقر بداية أحد."}],"hadiths":[{"i":1,"strength":"direct","headline":"استقبال من ترك الباطل وجاءك تائبًا","bridge":"تستقبل من ترك الباطل وجاءك؟ في الحديبية شُرط رد من جاء من قريش، فجاءت أم كلثوم مهاجرة فأنزل الله آية الامتحان ولم تُرد — من ترك الشرك وهاجر لا يُسلَّم لأهل الباطل؛ فمن جاءك تائبًا فلا تعده إلى ما فرّ منه."},{"i":2,"strength":"direct","headline":"استقبال من دخل الدين حديثًا وطيّ ماضيه","bridge":"تريد أن تعرف كيف يُستقبل من دخل الدين حديثًا؟ كان النبي ﷺ يبايع المهاجرات بآية ﴿إِذَا جَاءَكَ الْمُؤْمِنَاتُ يُبَايِعْنَكَ﴾ إلى ﴿غَفُورٌ رَحِيمٌ﴾ ويقول: «قد بايعتك» كلامًا — العهد الجديد يُختم باسم المغفرة؛ فاستقبل العائد بطي ما مضى."},{"i":17,"strength":"direct","headline":"الحيرة بين الشدة واللين مع العصاة","bridge":"تحتار بين الشدة واللين مع من عصى؟ يوم بدر أشار أبو بكر في الأسرى: «عشيرتك وقومك»، وذكر النبي ﷺ قول إبراهيم: ﴿وَمَنْ عَصَانِي فَإِنَّكَ غَفُورٌ رَحِيمٌ﴾ — كلمة إبراهيم في العصاة تفويضٌ إلى الغفور الرحيم؛ فاعرف للّين موضعه."}]},{"situationId":141,"verses":[{"i":48,"strength":"direct","headline":"الاعتذار عن واجبٍ جماعي بعذرٍ صحيح","bridge":"اعتذرتَ عن واجبٍ جماعي بعذرٍ صحيح؟ حتى المستأذن الصادق ومعه إذن النبي ﷺ يُستغفر له: ﴿فَإِذَا اسْتَأْذَنُوكَ لِبَعْضِ شَأْنِهِمْ فَأْذَنْ لِمَنْ شِئْتَ مِنْهُمْ وَاسْتَغْفِرْ لَهُمُ اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — خذ الرخصة واستغفر؛ فكمال الأدب فوق مجرد الإباحة."}],"hadiths":[]},{"situationId":144,"verses":[{"i":41,"strength":"direct","headline":"العجز عن شكر نعمٍ لا تُحصى","bridge":"تحاول أن تشكر نعمًا لا تحصيها؟ المعادلة مستحيلة لولا الختام: ﴿وَإِنْ تَعُدُّوا نِعْمَةَ اللَّهِ لَا تُحْصُوهَا إِنَّ اللَّهَ لَغَفُورٌ رَحِيمٌ﴾ — نعمٌ لا تُحصى وشكرٌ لا يُوفّى، فغفورٌ يغفر التقصير الحتمي في الشكر ورحيمٌ لا يقطع النعم بسببه؛ فاشكر ما استطعت ودع الباقي لمغفرته."}],"hadiths":[]},{"situationId":147,"verses":[{"i":28,"strength":"direct","headline":"فتح بابٍ من العطاء بعد عتابٍ وابتلاء","bridge":"عاتبك الله بابتلاءٍ ثم فتح لك بابًا؟ بعد عتاب أسرى بدر مباشرة: ﴿فَكُلُوا مِمَّا غَنِمْتُمْ حَلَالًا طَيِّبًا وَاتَّقُوا اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — عتابٌ ثم توسعة، ومغفرةٌ شملت ما مضى ورحمةٌ أباحت ما لم يُبح لأمةٍ قبلها؛ فعتابه لا يقطع عطاءه، وكُل من الباب المفتوح شاكرًا."}],"hadiths":[]},{"situationId":154,"verses":[],"hadiths":[{"i":6,"strength":"direct","headline":"طلب دعاءٍ للمغفرة في الصلاة بعد ظلم النفس","bridge":"تريد دعاءً في صلاتك؟ علّم النبي ﷺ أبا بكر: «اللهم إني ظلمت نفسي ظلمًا كثيرًا ولا يغفر الذنوب إلا أنت فاغفر لي من عندك مغفرة إنك أنت الغفور الرحيم»."},{"i":27,"strength":"direct","headline":"طلب مغفرة الذنوب في آخر الصلاة بدعاءٍ مُجاب","bridge":"تريد دعاء مغفرةٍ مضمون الإجابة؟ رجلٌ قضى صلاته ثم قال: «اللهم إني أسألك يا الله بأنك الواحد الأحد الصمد الذي لم يلد ولم يولد ولم يكن له كفوًا أحد أن تغفر لي ذنوبي إنك أنت الغفور الرحيم» فقال النبي ﷺ: «قد غفر الله له» ثلاثًا — توسّل بأسماء التوحيد ثم اطلب بالاسم."}]},{"situationId":158,"verses":[{"i":4,"strength":"direct","headline":"ختم الطاعة بالاستغفار من التقصير فيها","bridge":"في الحج وتريد أن تعمره؟ في قلب النسك جاء: ﴿ثُمَّ أَفِيضُوا مِنْ حَيْثُ أَفَاضَ النَّاسُ وَاسْتَغْفِرُوا اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — الاستغفار نُسكٌ في وسط الحج يُختم به التقصير الملازم لكل عبادة؛ فاجعل الاستغفار يتبع طاعاتك في الموسم لا معاصيك فقط."}],"hadiths":[]},{"situationId":160,"verses":[{"i":36,"strength":"direct","headline":"ركوب المركب وبدء السفر والرحلة","bridge":"تركب سيارتك أو طائرتك أو تبدأ رحلة؟ افتتح كما افتتح نوح سفينة النجاة: ﴿ارْكَبُوا فِيهَا بِسْمِ اللَّهِ مَجْرَاهَا وَمُرْسَاهَا إِنَّ رَبِّي لَغَفُورٌ رَحِيمٌ﴾ — السفينة تجري وترسو باسم الله لا بالخشب والمسامير، والنجاة نفسها مغفرةٌ ورحمة؛ فقلها في كل ركوب."}],"hadiths":[]},{"situationId":161,"verses":[{"i":1,"strength":"direct","headline":"الاضطرار إلى محرّم والتردد في الأخذ بالرخصة","bridge":"اضطررتَ إلى محرّمٍ وتتردد؟ رخصة المضطر خُتمت بالاسمين: ﴿فَمَنِ اضْطُرَّ غَيْرَ بَاغٍ وَلَا عَادٍ فَلَا إِثْمَ عَلَيْهِ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — رفع الإثم مغفرةٌ مقدَّمة ورحمةٌ بحالك، بشرطين: ألا تطلب المحرم لذاته ولا تتجاوز قدر الضرورة؛ فالضرورات تُقدَّر بقدرها وبابها الرحمة لا التحايل."},{"i":32,"strength":"direct","headline":"العجز عن عمل صالح والخوف من أن تُعدّ من القاعدين","bridge":"عجزتَ عن عملٍ صالح وتخاف أن تكون من القاعدين؟ ﴿لَيْسَ عَلَى الضُّعَفَاءِ وَلَا عَلَى الْمَرْضَى وَلَا عَلَى الَّذِينَ لَا يَجِدُونَ مَا يُنْفِقُونَ حَرَجٌ إِذَا نَصَحُوا لِلَّهِ وَرَسُولِهِ مَا عَلَى الْمُحْسِنِينَ مِنْ سَبِيلٍ﴾ — سُمّي العاجز الصادق «محسنًا» مع قعوده؛ فاصدق النية وانصح، تُكتب محسنًا وأنت قاعد."},{"i":43,"strength":"direct","headline":"الضرورة الملجئة إلى محظورٍ والتردد في الأخذ بالرخصة","bridge":"تشك أن الضرورة تبيح لك ما تحتاجه؟ ﴿فَمَنِ اضْطُرَّ غَيْرَ بَاغٍ وَلَا عَادٍ فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — الرخصة رحمةٌ من الغفور الرحيم مقيّدةٌ بصدق الاضطرار: لا تطلبها شهوةً ولا تتجاوز بها قدر الحاجة؛ ولن يُحرجك الدين في ضرورةٍ حقيقية."},{"i":66,"strength":"direct","headline":"ضيق ذات اليد يحجبك عن أبواب الخير","bridge":"يحجبك ضيق ذات اليد عن بابٍ من أبواب الخير؟ شُرعت صدقة النجوى، ثم: ﴿فَإِنْ لَمْ تَجِدُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — الفقر لا يحجب عن مناجاة النبي ﷺ ولا عن باب الخير؛ فالرخصة مكتوبة لك سلفًا، ولا يمنعك ضيق رزقك من قربٍ يبذله غيرك بالمال."},{"i":71,"strength":"direct","headline":"مرضٌ أو عذرٌ يقعدك عن عبادةٍ كنت تحبها","bridge":"مرضٌ أقعدك عن عبادةٍ كنت تحبها؟ خفّف الله قيام الليل عن الأمة لأنه ﴿عَلِمَ أَنْ سَيَكُونُ مِنْكُمْ مَرْضَى﴾، وسمّى التخفيف توبةً منه عليكم، وختم: ﴿وَاسْتَغْفِرُوا اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — اعبده بما تطيق، واختم عبادتك المخففة بالاستغفار؛ فالمخفِّف عنك هو الغفور الرحيم نفسه."}],"hadiths":[{"i":16,"strength":"direct","headline":"الاضطرار إلى محرمٍ في مجاعةٍ أو ضرورة","bridge":"اضطررتَ إلى محرم في مخمصة؟ فيما رواه ابن عباس: ﴿فَمَنِ اضْطُرَّ فِي مَخْمَصَةٍ غَيْرَ مُتَجَانِفٍ لِإِثْمٍ فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — المضطر مغفور له مرحوم بنص الرخصة؛ فلا تحرج من ضرورةٍ لم تتجانف فيها لإثم."},{"i":30,"strength":"direct","headline":"الاستئذان في ترك واجبٍ جماعي لعذرٍ صادق","bridge":"تستأذن في تركِ واجبٍ جماعي لعذر؟ ابن عباس: ﴿لَا يَسْتَأْذِنُكَ الَّذِينَ يُؤْمِنُونَ﴾ نسختها آية النور ﴿إِنَّمَا الْمُؤْمِنُونَ الَّذِينَ آمَنُوا بِاللَّهِ وَرَسُولِهِ﴾ إلى ﴿غَفُورٌ رَحِيمٌ﴾ — الناسخ أذن للمستأذنين مع الاستغفار لهم؛ فالعذر الصادق مأذون به ويُستغفر معه."}]},{"situationId":166,"verses":[],"hadiths":[{"i":4,"strength":"direct","headline":"الإفاضة من عرفة والاستغفار في مناسك الحج","bridge":"تفيض من عرفة؟ ابن عباس: يطوف الرجل بالبيت حتى يهل بالحج، ثم يفيض من عرفات ﴿ثُمَّ أَفِيضُوا مِنْ حَيْثُ أَفَاضَ النَّاسُ وَاسْتَغْفِرُوا اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ حتى ترموا الجمرة — الطريق من عرفة إلى مزدلفة طريق استغفار."}]},{"situationId":167,"verses":[],"hadiths":[{"i":3,"strength":"direct","headline":"اغتنام يوم العيد بتجديد العهد والصدقة","bridge":"تحضر العيد وتريد أن تعمره؟ نزل النبي ﷺ يوم العيد فشق الرجال حتى أتى النساء فقرأ عليهن آية البيعة إلى ﴿غَفُورٌ رَحِيمٌ﴾ وقال: «أنتن على ذلك؟» ثم أمرهن بالصدقة فألقين خواتيمهن في ثوب بلال — العيد موسم تجديد عهد وصدقة؛ فجدّد عهدك وتصدق."}]},{"situationId":170,"verses":[{"i":5,"strength":"direct","headline":"الخوف من ردّ العمل أو الاتكال عليه","bridge":"تخاف ألا يُقبل عملك؟ أصحاب أعظم الأعمال وُصفوا بالرجاء لا بالاستحقاق: ﴿إِنَّ الَّذِينَ آمَنُوا وَالَّذِينَ هَاجَرُوا وَجَاهَدُوا فِي سَبِيلِ اللَّهِ أُولَئِكَ يَرْجُونَ رَحْمَتَ اللَّهِ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾ — العمل سبب والرجاء أدب، والغفور يستر تقصير العامل والرحيم يقبل؛ فلا أحد يدخل بعمله وحده، فارجُ كما رجا المهاجرون."},{"i":12,"strength":"direct","headline":"الخوف من ردّ العمل ونقصه بعد الاجتهاد","bridge":"تخاف على عملك من الرد؟ جزاء المجاهدين ثلاثي: ﴿دَرَجَاتٍ مِنْهُ وَمَغْفِرَةً وَرَحْمَةً وَكَانَ اللَّهُ غَفُورًا رَحِيمًا﴾ — ذُكرت المغفرة في جزاء أهل أعظم الأعمال، لأن أول ما يحتاجه العامل أن يُغفر نقص عمله؛ فاجعل المغفرة أول مسألتك بعد كل عمل."}],"hadiths":[]},{"situationId":171,"verses":[{"i":65,"strength":"direct","headline":"الخوف من ضياع عملٍ سابقٍ بعد الاهتداء لأكمل منه","bridge":"صدقتَ في مرحلةٍ ثم اهتديت لأكمل منها وتخاف ألا يُقبل الأول؟ ﴿اتَّقُوا اللَّهَ وَآمِنُوا بِرَسُولِهِ يُؤْتِكُمْ كِفْلَيْنِ مِنْ رَحْمَتِهِ وَيَجْعَلْ لَكُمْ نُورًا تَمْشُونَ بِهِ وَيَغْفِرْ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾ — كِفلان مضاعفان ونورٌ ومغفرة؛ فعطاء الله يتضاعف ولا يضيق، ومن صدق ثم ازداد أُجر عليهما معًا."}],"hadiths":[{"i":33,"strength":"direct","headline":"الخوف من الموت قبل بلوغ ما خرجت له من الخير","bridge":"تخاف أن تموت قبل أن تبلغ ما خرجت له؟ هاجر خالد بن حزام إلى الحبشة فنهشته حية في الطريق فمات، فنزلت ﴿وَمَنْ يَخْرُجْ مِنْ بَيْتِهِ مُهَاجِرًا إِلَى اللَّهِ وَرَسُولِهِ ثُمَّ يُدْرِكْهُ الْمَوْتُ فَقَدْ وَقَعَ أَجْرُهُ عَلَى اللَّهِ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا﴾ — من مات في الطريق وقع أجره."}]},{"situationId":173,"verses":[{"i":7,"strength":"direct","headline":"الشوق إلى أن يحبك الله ويغفر لك","bridge":"تريد أن تكون ممن يحبهم؟ الطريق واحد لا تتعدد فيه الدعاوى: ﴿قُلْ إِنْ كُنْتُمْ تُحِبُّونَ اللَّهَ فَاتَّبِعُونِي يُحْبِبْكُمُ اللَّهُ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ﴾ — والجزاء مزدوج: محبته لك ومغفرة ذنبك، لأن الحبيب لا يحاسب حبيبه محاسبة الخصوم."}],"hadiths":[]},{"situationId":182,"verses":[{"i":13,"strength":"direct","headline":"الخوف من الموت قبل إتمام العمل الصالح","bridge":"تخاف أن تموت قبل إتمام مشروعك الصالح؟ ﴿وَمَنْ يَخْرُجْ مِنْ بَيْتِهِ مُهَاجِرًا إِلَى اللَّهِ وَرَسُولِهِ ثُمَّ يُدْرِكْهُ الْمَوْتُ فَقَدْ وَقَعَ أَجْرُهُ عَلَى اللَّهِ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا﴾ — «وقع» تعبير وجوبٍ وثبوت؛ فعليك البداية الصادقة، وعلى الغفور الرحيم الإتمام إن أدركك الموت في الطريق."}],"hadiths":[]},{"situationId":190,"verses":[],"hadiths":[{"i":9,"strength":"direct","headline":"استشكال اختلاف القراءات في خواتم الآيات","bridge":"تسأل عن اختلاف القراءات في خواتم الآيات؟ في حديث الأحرف: «قلت: غفورًا رحيمًا، أو قلت: سميعًا حكيمًا… أيَّ ذلك قلت فإنه كذلك»، وفي زيادة: «ما لم يُختم عذابٌ برحمةٍ أو رحمةٌ بعذاب» — «غفورًا رحيمًا» أول مثال للخواتم في الأحرف السبعة؛ فالله كذلك على أي ترتيب قُرئا."}]},{"situationId":194,"verses":[{"i":55,"strength":"direct","headline":"استشكال خصوصيةٍ تشريعيةٍ للنبي ﷺ","bridge":"تستشكل خصوصيةً تشريعية؟ عُلّلت التوسعة على النبي ﷺ برفع الحرج: ﴿لِكَيْلَا يَكُونَ عَلَيْكَ حَرَجٌ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا﴾ — حتى خصوصيات النبوة شُرعت بميزان الرحمة ورفع المشقة؛ فرفع الحرج مقصدٌ شرعي ثابت من خصوصيات النبي ﷺ إلى عموم أمته."},{"i":56,"strength":"direct","headline":"استثقال حكم الحجاب أو وصفه بالتضييق","bridge":"يثقل عليك حكم الحجاب أو يُقال لك إنه تضييق؟ عُلّل تشريعه بالحماية: ﴿ذَلِكَ أَدْنَى أَنْ يُعْرَفْنَ فَلَا يُؤْذَيْنَ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا﴾ — درعٌ لا قيد، وخُتم بمغفرةٍ لما كان قبل الأمر ورحمةٍ هي روح الحكم؛ فأحكام اللباس في القرآن معلّلة بالحماية والرحمة."}],"hadiths":[{"i":26,"strength":"direct","headline":"استشكال أثر التوبة في إسقاط العقوبة","bridge":"تستشكل أثر التوبة في حد الحرابة؟ قال ابن عباس في آية المحاربة إلى ﴿غَفُورٌ رَحِيمٌ﴾: «نزلت هذه الآية في المشركين، فمن تاب منهم قبل أن يقدر عليه لم يمنعه ذلك أن يقام فيه الحد الذي أصابه» — فاطلب فقه الآية ممن نزلت فيهم قبل أن تبني عليها حكمًا."}]},{"situationId":197,"verses":[],"hadiths":[{"i":10,"strength":"direct","headline":"سماع من يستخف بالوحي ويتلاعب بألفاظه","bridge":"تسمع من يستخف بالوحي؟ الكاتب الذي أُملي عليه ﴿غَفُورًا رَحِيمًا﴾ فكتب «عفوًّا غفورًا» ثم ارتد فلفظته الأرض — الاسم مما أملاه النبي ﷺ على الكتّاب، والتلاعب بالإملاء أول طريق الارتداد."}]},{"situationId":198,"verses":[{"i":18,"strength":"direct","headline":"التحرّج من الأخذ بالرخصة كأنها نقصٌ في الدين","bridge":"تظن أن الأخذ بالرخصة نقصٌ في الدين؟ في اليوم الذي أُكمل فيه الدين أُكملت رخصته في الآية نفسها: ﴿فَمَنِ اضْطُرَّ فِي مَخْمَصَةٍ غَيْرَ مُتَجَانِفٍ لِإِثْمٍ فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ﴾ — كمال الدين يشمل كمال رخصه؛ فلن يحرجك دينك في مخمصةٍ أبدًا."},{"i":24,"strength":"direct","headline":"التضييق على النفس فيما وسّعه الله وحال الضرورة","bridge":"تضيّق على نفسك فيما وسّعه الله، أو اضطُررت إلى ما مُنع؟ الأصل في الطعام الحِلّ، وحتى المحصور يُفتح عند الضرورة: ﴿فَمَنِ اضْطُرَّ غَيْرَ بَاغٍ وَلَا عَادٍ فَإِنَّ رَبَّكَ غَفُورٌ رَحِيمٌ﴾ — فباب الرخصة مقرونٌ بالتحريم في الآية نفسها."}],"hadiths":[]}]},{"id":33,"name":"خير الفاتحين","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: خَيْرُ الْفَاتِحِينَ — صيغة تفضيل | المواضع: 1 (الأعراف: 89)\nخصوصية: على لسان شعيب في ذروة المواجهة مع قومه، بعد تهديده بالطرد أو العودة القسرية في ملتهم.\n\nالمعنى:\n- خير الفاتحين: أفضلُ من يفتح — والفتح هنا الحكمُ والفصل بين المتخاصمين، ويشمل فتحَ المغلقات من الأمور والأبواب.","teaches":"الحقائق التي كشفها الموضع:\n1. الفتح يُطلب بعد الثبات والتوكل — لا بديلًا عنهما.\n2. إذا انسدّ الحوار مع الخصوم فالفصل يُرفع إلى خير الفاتحين.\n3. العودة عن الحق بعد النجاة منه افتراء — مهما كان التهديد.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند خصومةٍ مستحكمة أُغلق فيها كل حوار.\n- عند بابٍ مغلقٍ في حياتك استعصى على كل مفتاح.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. عند الخصومة المستحكمة: دعاء شعيب بنصه — ﴿رَبَّنَا افْتَحْ بَيْنَنَا وَبَيْنَ قَوْمِنَا بِالْحَقِّ وَأَنْتَ خَيْرُ الْفَاتِحِينَ﴾ — الأعراف 89.\n2. عند انغلاق أمرٍ مستعصٍ: استفتاح خير الفاتحين.\n3. الثبات على الدين عند التهديد بسببه: ﴿وَمَا يَكُونُ لَنَا أَنْ نَعُودَ فِيهَا إِلَّا أَنْ يَشَاءَ اللَّهُ رَبُّنَا﴾.","summary":"إذا أُغلق كل حوارٍ وضاق كل طريق، فقف موقف شعيب: ثباتٌ، فتوكل، ثم: ﴿رَبَّنَا افْتَحْ بَيْنَنَا وَبَيْنَ قَوْمِنَا بِالْحَقِّ وَأَنْتَ خَيْرُ الْفَاتِحِينَ﴾.","verses":[{"i":1,"of":1,"s":7,"surah":"الأعراف","a":89,"text":"قَدِ افْتَرَيْنَا عَلَى اللَّهِ كَذِبًا إِنْ عُدْنَا فِي مِلَّتِكُمْ بَعْدَ إِذْ نَجَّانَا اللَّهُ مِنْهَا وَمَا يَكُونُ لَنَا أَنْ نَعُودَ فِيهَا إِلَّا أَنْ يَشَاءَ اللَّهُ رَبُّنَا وَسِعَ رَبُّنَا كُلَّ شَيْءٍ عِلْمًا عَلَى اللَّهِ تَوَكَّلْنَا رَبَّنَا افْتَحْ بَيْنَنَا وَبَيْنَ قَوْمِنَا بِالْحَقِّ وَأَنْتَ خَيْرُ الْفَاتِحِينَ","prev":{"a":88,"text":"قَالَ الْمَلَأُ الَّذِينَ اسْتَكْبَرُوا مِنْ قَوْمِهِ لَنُخْرِجَنَّكَ يَا شُعَيْبُ وَالَّذِينَ آمَنُوا مَعَكَ مِنْ قَرْيَتِنَا أَوْ لَتَعُودُنَّ فِي مِلَّتِنَا قَالَ أَوَلَوْ كُنَّا كَارِهِينَ"},"next":{"a":90,"text":"وَقَالَ الْمَلَأُ الَّذِينَ كَفَرُوا مِنْ قَوْمِهِ لَئِنِ اتَّبَعْتُمْ شُعَيْبًا إِنَّكُمْ إِذًا لَخَاسِرُونَ"},"context":"آخرُ فصلٍ في قصة شعيب مع مدين: كان قد دعا إلى الصبر حتى يحكم الله (الأعراف 87)، فردّ الملأ المستكبرون بالإنذار النهائي: ﴿لَنُخْرِجَنَّكَ يَا شُعَيْبُ وَالَّذِينَ آمَنُوا مَعَكَ مِنْ قَرْيَتِنَا أَوْ لَتَعُودُنَّ فِي مِلَّتِنَا﴾ — خياران لا ثالث لهما: النفيُ أو الردّة. فأجاب بسؤالٍ يكشف سخف العرض: ﴿أَوَلَوْ كُنَّا كَارِهِينَ﴾ — أتُكرهوننا على دينٍ نكرهه؟ ثم أعلن استحالة العودة بأشدّ ما يكون: العودةُ بعد النجاة افتراءٌ على الله. ثم رتّب موقفه ثلاث درجات: تسليمٌ للمشيئة ﴿إِلَّا أَنْ يَشَاءَ اللَّهُ رَبُّنَا﴾، فتوكلٌ ﴿عَلَى اللَّهِ تَوَكَّلْنَا﴾، فدعاءُ حسمٍ لا استسلام: ﴿رَبَّنَا افْتَحْ بَيْنَنَا وَبَيْنَ قَوْمِنَا بِالْحَقِّ وَأَنْتَ خَيْرُ الْفَاتِحِينَ﴾. وجاء الفتح: نجا شعيبٌ ومن معه، وأخذت الظالمين الرجفة فأصبحوا في دارهم جاثمين.","reason":"بعد انسداد الحوار تمامًا — إخراجٌ أو ردّة — لم يبق إلا الفصلُ من فوق: طلب شعيبٌ «الفتح بالحق» أي الحكمَ الفاصل بينه وبين قومه، وتوسل بخير الفاتحين: أحسنِ من يفصل ويقضي ويفتح المستغلَق. ولاحظ الترتيب: ثباتٌ ثم توكلٌ ثم دعاءُ فتح — لا دعاء استسلام.","adds":"دعاء المفاصلة عند انسداد كل الطرق مع المخالفين — وقد جاء الفتحُ فعلًا: نجّى الله شعيبًا والمؤمنين وأخذت الظالمين الرجفة."}],"hadiths":[],"situations":[{"situationId":134,"verses":[{"i":1,"strength":"direct","headline":"انسداد الطرق مع المخالفين ووصول الخصومة إلى نهايتها","bridge":"انسدّت كل الطرق ولم يبق إلا الإخراج أو الردة؟ هنا رفع شعيب دعاءه: ﴿رَبَّنَا افْتَحْ بَيْنَنَا وَبَيْنَ قَوْمِنَا بِالْحَقِّ وَأَنْتَ خَيْرُ الْفَاتِحِينَ﴾ — ثباتٌ ثم توكل ثم طلبُ فتح لا استسلام؛ فإذا أُغلقت المخارج كلها فاطلب الفتح ممن يفتح المستغلَق من فوق."}],"hadiths":[]}]},{"id":34,"name":"الله العظيم","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: اللَّهِ الْعَظِيمِ — مركّبة | المواضع: 1 (الحاقة: 33)\nخصوصية: جاءت في مشهد الحاقة تعليلًا لأشد عذاب — فهي تكشف أعظم جريمتين عند الله.\n\nالمعنى:\n- الله العظيم: الجامع لصفات العظمة كلها: عظمة الذات والأسماء والأفعال — فالكفر به كفرٌ بعظيمٍ، وجرمُه على قدر عظمة المكفور به.","teaches":"الحقائق التي كشفها الموضع:\n1. أعظم الجرائم اثنتان: الكفر بالعظيم، وقسوة القلب عن المسكين.\n2. الدين عمودان لا ينفصلان: حق الله وحق الضعفاء.\n3. الحضّ على الإطعام واجبٌ حتى على من لا يملك ما يُطعم.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند رؤية مسكينٍ أو حملة إطعام: هذا أحد عمودي النجاة من مشهد الحاقة.\n- في تسبيحك: «سبحان الله العظيم» — استحضر من تنزّه.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. سؤال الثبات على الإيمان بالله العظيم والنجاة من مشهد ﴿خُذُوهُ فَغُلُّوهُ﴾.\n2. العمل بضدّ الجريمة الثانية: الإطعام والحضّ عليه — فهو من أسباب النجاة يوم الحاقة.\n3. الإكثار من: «سُبْحَانَ اللَّهِ وَبِحَمْدِهِ سُبْحَانَ اللَّهِ الْعَظِيمِ» — متفق عليه.","summary":"جريمتان أوردتاه سلسلةَ السبعين ذراعًا: ﴿لَا يُؤْمِنُ بِاللَّهِ الْعَظِيمِ * وَلَا يَحُضُّ عَلَى طَعَامِ الْمِسْكِينِ﴾ — فاجمع ضدّيهما: إيمانًا بالعظيم وإطعامًا لمسكينه.","verses":[{"i":1,"of":1,"s":69,"surah":"الحاقة","a":33,"text":"إِنَّهُ كَانَ لَا يُؤْمِنُ بِاللَّهِ الْعَظِيمِ","prev":{"a":32,"text":"ثُمَّ فِي سِلْسِلَةٍ ذَرْعُهَا سَبْعُونَ ذِرَاعًا فَاسْلُكُوهُ"},"next":{"a":34,"text":"وَلَا يَحُضُّ عَلَى طَعَامِ الْمِسْكِينِ"},"context":"سورة الحاقة تعرض مشهد العرض: من أوتي كتابه بشماله يتمنى الموت: ﴿يَا لَيْتَهَا كَانَتِ الْقَاضِيَةَ﴾. ثم يُصدر الأمرُ بلا حوار: ﴿خُذُوهُ فَغُلُّوهُ * ثُمَّ الْجَحِيمَ صَلُّوهُ * ثُمَّ فِي سِلْسِلَةٍ ذَرْعُهَا سَبْعُونَ ذِرَاعًا فَاسْلُكُوهُ﴾ — أخذٌ وغلٌّ وصَليٌ وسلسلة. وأمام هول العقوبة يتحرك السؤال: ما الذي فعله ليستحق هذا؟ فيأتي الجواب في جملتين: ﴿إِنَّهُ كَانَ لَا يُؤْمِنُ بِاللَّهِ الْعَظِيمِ * وَلَا يَحُضُّ عَلَى طَعَامِ الْمِسْكِينِ﴾ — انصرافٌ عن حقّ الله الأعظم، وانصرافٌ عن حقّ أضعف خلقه.","reason":"عُلّل هذا العذاب الهائل بجريمتين لا ثالث لهما: ترك الإيمان «بالله العظيم» — فالجرم على قدر عظمة من كُفر به — وترك الحض على طعام المسكين. وقرنُهما بليغ: حقُّ الله الأعظم وحقُّ أضعف خلقه في آيةٍ واحدة — فالدين عقيدةٌ ورحمة، ومن فرّط في أحدهما اختل ميزانه.","adds":"لم يقل «لا يُطعم» بل ﴿لَا يَحُضُّ﴾: فحتى من لا يملك الطعام مطالبٌ بالحضّ عليه — والتقصير في مجرد الحضّ ذُكر بجوار الكفر."}],"hadiths":[{"i":1,"of":14,"text":"أنَّ نَبيَّ اللهِ صلَّى اللهُ عليه وسلَّم كان يقولُ عِندَ الكَربِ: لا إلَهَ إلَّا اللهُ العَظيمُ الحَليمُ، لا إلَهَ إلَّا اللهُ رَبُّ العَرشِ العَظيمِ، لا إلَهَ إلَّا اللهُ رَبُّ السَّمَواتِ ورَبُّ الأرضِ ورَبُّ العَرشِ الكَريمِ. وفي روايةٍ: أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم كان يَدعو بهنَّ ويقولُهنَّ عِندَ الكَربِ، فذَكَرَ بمِثلِ حَديثِ مُعاذِ بنِ هِشامٍ، عن أبيه، عن قَتادةَ، غيرَ أنَّه قال: رَبُّ السَّمَواتِ والأرضِ. وفي روايةٍ: أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم كانَ إذا حَزَبَه أمرٌ، قال: فذَكَرَ بمِثلِ حَديثِ مُعاذٍ، عن أبيه. وزادَ معهُنَّ: لا إلَهَ إلَّا اللهُ رَبُّ العَرشِ الكَريمِ.","narrator":"عبدالله بن عباس","source":"صحيح مسلم 2730","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/9gq6zyAJ","nameForm":"اللهُ العَظيمُ","scene":"ابن عباس: كان النبي ﷺ يقول عند الكرب: «لا إله إلا الله العظيم الحليم، لا إله إلا الله رب العرش العظيم، لا إله إلا الله رب السماوات ورب الأرض ورب العرش الكريم». صحيح مسلم.","reason":"أول ما يُقال في الكرب: «الله العظيم الحليم» — تهليلٌ أولًا (لا إله إلا الله) لأن الكرب يُنسي التوحيد فيُستحضر، ثم «العظيم» لأن الكرب عظيمٌ في عين صاحبه فيُقابَل بمن هو أعظم، ثم «الحليم» لأن المكروب يخاف أن يكون كربه عقوبةً فيُذكَّر بحلم من يُمهل. فالاسم دواءٌ نفسيٌّ مرتب: توحيد، فتعظيم، فتطمين.","adds":"يجعل الشاهد الاسم أول كلمات الكرب المأثورة عن النبي ﷺ نفسه، ويقرنه بالحليم — فلا يُذكر العظيم في الكرب إلا وبعده حلم."},{"i":2,"of":14,"text":"كانَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ إذا عادَ المريضَ جَلَسَ عندَ رأسِهِ، ثمَّ قال سَبْعَ مَرَّاتٍ: أسأَلُ اللهَ العظيمَ رَبَّ العَرْشِ العَظيمِ أنْ يَشْفِيَكَ. فإنْ كانَ في أجَلِهِ تَأخيرٌ عُوفِيَ مِن وَجَعِه ذلكَ.","narrator":"عبدالله بن عباس","source":"المستدرك على الصحيحين 7694","grade":"صحيح","judgment":"صحيح على شرط الشيخين","url":"https://dorar.net/h/PAAcaYu9","nameForm":"اللهَ العظيمَ","scene":"ابن عباس: كان النبي ﷺ إذا عاد المريض جلس عند رأسه ثم قال سبع مرات: «أسأل الله العظيم رب العرش العظيم أن يشفيك»، فإن كان في أجله تأخير عوفي من وجعه ذلك.","reason":"الشفاء يُطلب من العظيم لأن المرض يُشعر صاحبه بالعجز، والعجز يُقابل بالعظمة؛ ثم يُثنّى بـ«رب العرش العظيم» فتتكرر العظمة مرتين: في الله وفي عرشه. والعدد سبع يُعظّم الطلب كما عُظّم المطلوب منه. والشرط «فإن كان في أجله تأخير» يُبقي الأمر لله: العظيم يشفي ما لم يقض الموت.","adds":"يقدّم الشاهد الاسم رقيةً معدودة: سبع مرات عند رأس المريض — عملًا يُقاس."},{"i":3,"of":14,"text":"«كَلِمَتانِ خَفِيفَتانِ على اللِّسانِ ثَقيلَتانِ في الـمِيزانِ، حَبيبَتانِ إلى الرَّحمنِ: سُبْحانَ اللهِ وبِـحمْدِه، سُبْحانَ اللهِ العَظيمِ.»","narrator":"أبو هريرة","source":"تخريج المسند لشعيب (7167)","grade":"صحيح","judgment":"إسناده صحيح على شرط الشيخين","url":"https://dorar.net/h/xEwX6uml","nameForm":"اللهِ العَظيمِ","scene":"قال النبي ﷺ: «كلمتان خفيفتان على اللسان ثقيلتان في الميزان حبيبتان إلى الرحمن: سبحان الله وبحمده، سبحان الله العظيم».","reason":"الكلمة الثانية تنزّه الله مقرونة بالعظمة: تسبيح يثبت العظمة بعد نفي النقص، وثقلها في الميزان من ثقل الاسم الذي فيها؛ فالعظيم يثقل الكلمة الخفيفة، ومحبة الرحمن لها لأنها اعتراف خالص لا طلب فيه.","adds":"أخف كلمة وأثقلها: سبحان الله العظيم."},{"i":4,"of":14,"text":"مَنْ قال حِينَ يُصبِحُ و حِينَ يُمسِي : سُبحانَ اللهِ العظيمِ و بِحمدِهِ ، مِائةَ مَرَّةٍ ، لمْ يأتِ أحدٌ يومَ القِيامةِ بأفْضلَ مِمَّا جاء به ، إلَّا أحَدٌ قال مِثلَ ذلِكَ ، و زادَ عليْهِ","narrator":"أبو هريرة","source":"صحيح الجامع 6425","grade":"صحيح","url":"https://dorar.net/h/bs0nwLje","nameForm":"اللهِ العَظيمِ","scene":"قال النبي ﷺ: «من قال حين يصبح وحين يمسي: سبحان الله العظيم وبحمده مائة مرة، لم يأت أحد يوم القيامة بأفضل مما جاء به إلا أحد قال مثل ذلك وزاد عليه».","reason":"التسبيح بالعظيم مائة صباحًا ومائة مساء لا يأتي أحد بأفضل منه إلا من زاد؛ فالاسم في ورد الطرفين يبلغ بصاحبه أعلى ما يُؤتى به يوم القيامة.","adds":"مائة تسبيحة بالعظيم صباحًا ومساء: أفضل ما يُؤتى به يوم القيامة."},{"i":5,"of":14,"text":"سبحانَ اللهِ وبحمدِه سبحانَ اللهِ العظيمِ أستغفرُ اللهَ وأتوبُ إليه من قالها كُتِب له كما قالها ثمَّ عُلِّقتْ بالعرشِ لا يمحوها ذنبٌ عمِله صاحبُها حتَّى يلقَى اللهَ يومَ القيامةِ وهي مختومةٌ كما قالها","narrator":"عبدالله بن عباس","source":"الترغيب والترهيب 2/348","grade":"حسن","judgment":"رواته ثقات إلا يحيى بن عمر بن مالك النكري","url":"https://dorar.net/h/x9kDidAj","nameForm":"اللهِ العَظيمِ","scene":"قال النبي ﷺ: «سبحان الله وبحمده سبحان الله العظيم أستغفر الله وأتوب إليه، من قالها كُتب له كما قالها ثم عُلقت بالعرش لا يمحوها ذنب عمله صاحبها حتى يلقى الله يوم القيامة وهي مختومة كما قالها».","reason":"التسبيح بالعظيم مقرونًا بالاستغفار يُكتب ويُعلق بالعرش مختومًا لا يمحوه ذنب؛ فالاسم يحفظ الحسنة من أن تُمحى، والذكر يصير وثيقة مختومة عند العرش.","adds":"ذكر يُعلق بالعرش مختومًا لا يمحوه ذنب: سبحان الله العظيم مع الاستغفار."},{"i":6,"of":14,"text":"أتَيْتُ رسولَ اللهِ صلَّى اللهُ عليه وآلِه وسلَّم، فقُلْتُ: يا رسولَ اللهِ، ما أتَيْتُكَ حتَّى حلَفْتُ أكثَرَ مِن عددِ الأناملِ - وطبَّق بَيْنَ كفَّيْهِ إحداهما على الأخرى - ألَّا آتِيَكَ، ولا آتِيَ دِينَكَ؛ فقد أتَيْتُكَ امرأً لا أعقِلُ شيئًا إلَّا ما علَّمني اللهُ، وإنِّي أسأَلُكَ بوجهِ اللهِ العظيمِ: بِمَ بعَثكَ ربُّنا إلينا؟ قال: بدِينِ الإسلامِ، قال: وما دِينُ الإسلامِ؟ قال: أن تقولَ: أسلَمْتُ وجهيَ للهِ وتخلَّيْتُ، وتُقِيمَ الصَّلاةَ، وتُؤتِيَ الزَّكاةَ، وكلُّ مُسلِمٍ على كلِّ مُسلِمٍ مُحرَّمٌ، أخوَانِ نَصيرانِ، لا يقبَلُ اللهُ ممَّن أشرَك بعدَما أسلَم عمَلًا حتَّى يُفارِقَ المُشرِكينَ، ما لي أُمسِكُ بحُجَزِكم عنِ النَّارِ، ألَا وإنَّ ربِّي داعيَّ، وإنَّه سائلي: هل بلَّغْتَ عبادي؟ فأقولُ: ربِّ، قد بلَّغْتُ، ألَا فلْيُبلِّغْ شاهدُكم غائبَكم، ألَا ثُمَّ إنَّكم تُدْعَوْنَ مُفدَّمةً أفواهُكم بالفِدَامِ، ثمَّ إنَّ أوَّلَ شيءٍ يُنبِئُ عن أحدِكم لَفخِذُه وكفُّه، قال: قُلْتُ: يا رسولَ اللهِ، هذا دِينُنا؟ قال: هذا دِينُكَ، وأينما تُحسِنْ يَكْفِكَ!","narrator":"معاوية بن حيدة القشيري","source":"الاستيعاب في معرفة الأصحاب 1/420","grade":"صحيح","url":"https://dorar.net/h/250sJPET","nameForm":"اللهِ العظيمِ","scene":"معاوية بن حيدة يقول للنبي ﷺ: ما أتيتك حتى حلفت أكثر من عدد الأنامل ألا آتيك ولا آتي دينك، فقد أتيتك امرأً لا أعقل شيئًا إلا ما علّمني الله، «وإني أسألك بوجه الله العظيم: بم بعثك ربنا إلينا؟» قال: «بدين الإسلام…».","reason":"أعرابيٌّ جاء مقسمًا معاندًا ثم انقلب سائلًا، فأقسم على النبي ﷺ بأعظم ما يعرف: وجه الله العظيم — فالاسم في هذا الشاهد وسيلةُ سؤالٍ صادق يُراد به الحق: يُسأل بوجه العظيم من يُعلّم عن العظيم.","adds":"يُري الشاهد الاسم في مقام السؤال عن الدين بإلحاح، وأن الأعراب كانوا يعرفون تعظيم الله بوجهه قبل تفصيل الدين."},{"i":7,"of":14,"text":"ألا أُخْبِرُكُمْ بِخَيْرِ الناسِ مَنْزِلَةً ؟ قُلْنا : بلى ، قال : رجلٌ مُمْسِكٌ برأسِ فَرَسِه أوْ قال : فَرَسٍ في سبيلِ اللهِ حتى يَمُوتَ أوْ يُقتلَ . قال : فَأُخْبِرُكُمْ بِالذي يليهِ ؟ فقلْنا : نَعَمْ يا رسولَ اللهِ قال : امْرُؤٌ مُعْتَزِلٌ في شِعْبٍ يُقِيمُ الصَّلاةَ ، ويُؤْتِي الزكاةَ ، و َيَعْتَزِلُ الناسَ ، قال : فَأُخْبِرُكُمْ بِشَرُّ الناسِ مَنْزِلَةً ؟ قُلْنا : نَعَمْ يا رسولَ اللهِ قال : الذي يُسْأَلُ باللهِ العَظِيمِ ، ولا يُعْطِي بِه","narrator":"عبدالله بن عباس","source":"السلسلة الصحيحة 255","grade":"صحيح","judgment":"إسناده صحيح رجاله ثقات","url":"https://dorar.net/h/UeVTjcT5","nameForm":"باللهِ العَظِيمِ","scene":"النبي ﷺ يُخبر بخير الناس منزلةً — رجلٌ ممسكٌ برأس فرسه في سبيل الله، ثم معتزلٌ في شعبٍ يقيم الصلاة — ثم يقول: «فأخبركم بشر الناس منزلة؟ الذي يُسأل بالله العظيم ولا يعطي به».","reason":"يُسأل بالله العظيم فلا يعطي: جمع بين استخفافين — بالسائل وبالاسم الذي سُئل به؛ فصار شرّ الناس منزلة. فالاسم هنا حدٌّ للسؤال: من سُئل به فعليه أن يعطي، لأن عظمة الاسم تُلزم.","adds":"يُعلّم الشاهد حرمة الاسم في المعاملات: يُعطى من سأل بالله العظيم، ويُذم من ردّه."},{"i":8,"of":14,"text":"عن النبيِّ صلَّى اللهُ عليه وسلَّم أنه كان إذا دخل المسجدَ قال أعوذُ باللهِ العظيمِ ، وبوجهِهِ الكريمِ ، وبسلطانِهِ القديمِ ، من الشيطانِ الرجيمِ . قال : فإذا قال ذلك ، قال الشيطانُ : حُفِظَ مِنِّي سائرَ اليومِ","narrator":"عبدالله بن عمرو","source":"الكلم الطيب 66","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/jABPMEki","nameForm":"باللهِ العظيمِ","scene":"عبد الله بن عمرو: كان النبي ﷺ إذا دخل المسجد قال: «أعوذ بالله العظيم، وبوجهه الكريم، وبسلطانه القديم، من الشيطان الرجيم». قال: فإذا قال ذلك قال الشيطان: حُفظ مني سائر اليوم.","reason":"الاستعاذة عند دخول المسجد بثلاث: الله العظيم، ووجهه الكريم، وسلطانه القديم — والعظمة أولها؛ لأن الشيطان يُطرد بعظمة من يُستعاذ به لا بجهد المستعيذ. وشهادة الشيطان «حُفظ مني سائر اليوم» تُري أثر الاسم يوماً كاملًا.","adds":"يعطي الشاهد الاسم ذكرَ دخول المسجد بلفظه، وأثرًا يمتد سائر اليوم."},{"i":9,"of":14,"text":"أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ كان يُعلِّمُهم مِنَ الأوجاعِ ولمَن يُحْمى أنْ يَقولَ: باسمِ اللهِ الكبيرِ، نَعوذُ باللهِ العظيمِ مِن شَرِّ عِرقٍ نَعَّارٍ، ومِن شَرِّ حَرِّ النَّارِ.","narrator":"عبدالله بن عباس","source":"المستدرك على الصحيحين 8494","grade":"صحيح","judgment":"صحيح الإسناد، ولم يخرجاه","url":"https://dorar.net/h/cyF1NM3C","nameForm":"باللهِ العظيمِ","scene":"ابن عباس: كان النبي ﷺ يعلّمهم من الأوجاع ولمن يُحمى أن يقول: «باسم الله الكبير، نعوذ بالله العظيم من شر عرقٍ نعّار، ومن شر حر النار».","reason":"الحمى والوجع نارٌ في الجسد، فيُستعاذ منها بالله العظيم؛ لأن ما يُحسّ عظيمًا في الجسد يصغر أمام العظيم. وقرن «الكبير» و«العظيم» في رقيةٍ واحدة يُكبّر الله في عين المحموم بقدر ما تكبر عليه الحمى.","adds":"رقيةٌ نبوية بلفظ الاسم لكل وجعٍ وحمى — فالاسم دواءٌ يُقال على الجسد."},{"i":10,"of":14,"text":"من خرج من بيتِه إلى المسجدِ فقال أعوذُ باللهِ العظيِمِ وسلطانِه القديمِ من الشَّيطانِ الرَّجيمِ ربِّي اللهُ توكَّلتُ على اللهِ لاحولَ ولا قوَّةَ إلَّا باللهِ قال له الملكُ كُفِيتَ ووُقِيتَ","narrator":"أبو هريرة","source":"الترغيب والترهيب 2/380","grade":"صحيح","judgment":"[إسناده صحيح أو حسن أو ما قاربهما]","url":"https://dorar.net/h/AqZDWxo4","nameForm":"باللهِ العظيِمِ","scene":"أبو هريرة: «من خرج من بيته إلى المسجد فقال: أعوذ بالله العظيم وسلطانه القديم من الشيطان الرجيم، ربي الله توكلت على الله لا حول ولا قوة إلا بالله — قال له الملك: كُفيت ووُقيت».","reason":"الخروج إلى المسجد رحلةٌ يترصّدها الشيطان، فتُستفتح بالاستعاذة بالله العظيم، ثم توكلٌ وتبرؤٌ من الحول — فيردّ الملك: كُفيت الشرَّ ووُقيته. الاسم هنا أول جملة الخروج، والملَك يشهد بثمرته.","adds":"الاستعاذة بالله العظيم أول الخروج إلى المسجد: فيقول الملك «كفيت ووقيت»."},{"i":11,"of":14,"text":"وكان يَخطُبُ فجاء الحسَنُ والحُسَينُ يَعثُرانِ في قَميصَينِ أحمَرَينِ، فقطَعَ كلامَه، فنزَلَ فحمَلَهما، ثم عاد إلى مِنبَرِه، ثم قال: صدَقَ اللهُ العظيمُ: {إِنَّمَا أَمْوَالُكُمْ وَأَوْلَادُكُمْ فِتْنَةٌ} [التغابن: 15]، [الأنفال: 28]، رأيْتُ هذين يَعثُرانِ في قَميصَيْهما فلم أصبِرْ حتى قطَعْتُ كَلامي فحمَلْتُهما.","narrator":"-","source":"تخريج زاد المعاد 1/183","grade":"حسن","judgment":"إسناده حسن","url":"https://dorar.net/h/dkv2M3Wh","nameForm":"اللهُ العظيمُ","scene":"كان النبي ﷺ يخطب، فجاء الحسن والحسين يعثران في قميصين أحمرين، فقطع كلامه ونزل فحملهما، ثم عاد إلى منبره وقال: «صدق الله العظيم: ﴿إِنَّمَا أَمْوَالُكُمْ وَأَوْلَادُكُمْ فِتْنَةٌ﴾، رأيت هذين يعثران في قميصيهما فلم أصبر حتى قطعت كلامي فحملتهما».","reason":"يقول «صدق الله العظيم» شاهدًا على نفسه: العظيم صدق في وصف الأولاد فتنةً حين لم يصبر نبيُّه عن حمل حفيديه في الخطبة. فالاسم يُذكر تصديقًا لكلام الله حين يُرى واقعًا في النفس.","adds":"يُري الشاهد استعمال «صدق الله العظيم» تصديقًا موضعيًّا لآيةٍ رآها النبي ﷺ تتحقق فيه، لا ختمًا للتلاوة."},{"i":12,"of":14,"text":"نزلَتْ سورةُ الأنعامِ على النبيِّ صلَّى اللهُ عليه وسلَّمَ ومعها مَوْكِبٌ مِنَ الملائكةِ سَدَّ ما بينَ الخافِقَيْنِ، لهم زَجَلٌ بالتَّسبيحِ والتَّقديسِ، والأرضُ تَرْتَجُّ، ورسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: سُبحانَ اللهِ العظيمِ! سُبحانَ اللهِ العظيمِ!","narrator":"أنس بن مالك","source":"نتائج الأفكار 3/228","grade":"حسن","url":"https://dorar.net/h/RHnRXIXP","nameForm":"اللهِ العظيمِ ؛ اللهِ العظيمِ","scene":"أنس: نزلت سورة الأنعام على النبي ﷺ ومعها موكبٌ من الملائكة سدّ ما بين الخافقين، لهم زجلٌ بالتسبيح والتقديس، والأرض ترتج، ورسول الله ﷺ يقول: «سبحان الله العظيم! سبحان الله العظيم!».","reason":"مشهد نزول سورةٍ كاملة بموكبٍ من الملائكة: لا يليق به إلا تعظيم — فقال النبي ﷺ الكلمة الثقيلة نفسها مكررةً: «سبحان الله العظيم». فالاسم يُقال عند مشاهدة عظمة الوحي.","adds":"يربط الشاهد كلمة «سبحان الله العظيم» بمشهد نزول الأنعام؛ فتقولها وأنت تذكر أنها قيلت والأرض ترتج."},{"i":13,"of":14,"text":"أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم كان إذا مرَّ على القبورِ قال : السَّلامُ عليكم دارَ قومٍ مؤمنين ، وإنَّا – إن شاء اللهُ – بكم لاحقون ، غفر اللهُ العظيمُ لنا ولكم ورحِمنا وإيَّاكم","narrator":"بريدة بن الحصيب الأسلمي","source":"التمهيد 20/239","grade":"حسن","judgment":"إسناده حسن","url":"https://dorar.net/h/Lq3zVtfE","nameForm":"اللهُ العظيمُ","scene":"بريدة: كان النبي ﷺ إذا مرّ على القبور قال: «السلام عليكم دار قوم مؤمنين، وإنا إن شاء الله بكم لاحقون، غفر الله العظيم لنا ولكم ورحمنا وإياكم».","reason":"عند القبور يُسأل الغفران للأحياء والأموات معًا من «الله العظيم»: لأن المطلوب عظيم — مغفرةٌ تسع الأحياء والأموات — فيُسند إلى العظيم.","adds":"يضيف الشاهد الاسم إلى زيارة القبور: «غفر الله العظيم لنا ولكم» — فالعظمة تُستحضر حيث تُستحضر النهاية."},{"i":14,"of":14,"text":"أنَّ النَّبيَّ صلَّى اللهُ عليهِ وسلَّمَ كان إذا أهمَّه الأمرُ، رفع رأسَه إلى السَّماءِ . فقال: سبحانَ اللهِ العظيمِ، وإذا اجتهدَ في الدُّعاءِ قال: يا حيُّ يا قيُّومُ","narrator":"أبو هريرة","source":"سنن الترمذي 3436","grade":"حسن","judgment":"حسن غريب","url":"https://dorar.net/h/qAcBqNPo","nameForm":"اللهِ العظيمِ","scene":"أبو هريرة: كان النبي ﷺ إذا أهمّه الأمر رفع رأسه إلى السماء فقال: «سبحان الله العظيم»، وإذا اجتهد في الدعاء قال: «يا حي يا قيوم».","reason":"الهمّ يُقابل برفع الرأس إلى السماء وتعظيم الله: كأن الهمّ يُصغَّر برفع البصر إلى من فوق كل شيء. فيُقال الاسم أولًا تنزيهًا وتعظيمًا، ثم إذا اشتد الدعاء انتقل إلى «يا حي يا قيوم» — فالعظيم للهمّ، والحي القيوم للاجتهاد.","adds":"يُعطي الشاهد هيئةً وترتيبًا: رفع الرأس ثم «سبحان الله العظيم» عند الهم، قبل الانتقال إلى الدعاء — فالاسم أول العلاج."}],"sunnah":{"card":"الصيغة: اللَّهُ الْعَظِيمُ — مركّبة من لفظ الجلالة واسم\nفي السنة: 12 شاهدًا (28 رواية)\nخصوصية الورود في السنة: هذا من أكثر الصيغ دورانًا في أذكار النبي ﷺ: أول كلمات الكرب «لا إله إلا الله العظيم الحليم»، ودعاء عيادة المريض سبعًا «أسأل الله العظيم رب العرش العظيم أن يشفيك»، والكلمتان الخفيفتان الثقيلتان «سبحان الله العظيم»، والاستعاذة عند دخول المسجد والخروج إليه «أعوذ بالله العظيم»، ورقية الحمى، وقوله عند الهم رافعًا رأسه إلى السماء. فهو اسمُ الكرب والمرض والذكر والاستعاذة معًا.\nالمعنى المختصر: الله الذي له العظمة المطلقة، فتصغر أمامه الكروب والأوجاع والشياطين.","teaches":"1. أنه يُذكر أول ما يُذكر في الكرب والهم: العظيم قبل كل طلب.\n2. أنه يشفي المريض ما لم يحضر أجله، ويُسأل ذلك سبعًا.\n3. أن تسبيحه بالعظمة خفيفٌ على اللسان ثقيلٌ في الميزان، تُغرس به نخلة.\n4. أن الشيطان يُطرد بعظمته سائر اليوم.\n5. أن من سُئل به وجب عليه أن يعطي.\n6. أنه يُصدَّق كلامه به: «صدق الله العظيم» حين تراه واقعًا.","whenRecall":"- عند الكرب: «لا إله إلا الله العظيم الحليم».\n- عند رأس المريض: سبع مرات.\n- صباحًا ومساءً: «سبحان الله العظيم وبحمده» مائة.\n- عند الخروج إلى المسجد ودخوله.\n- عند الحمى والوجع.\n- عند الهم: ارفع رأسك وقل «سبحان الله العظيم».\n- عند القبور: «غفر الله العظيم لنا ولكم».","whenPray":"عند الشعور بـ:\n1. الكرب الذي يُنسي.\n2. الهمّ الذي يُثقل الرأس.\n3. وسوسة الشيطان في الطريق إلى العبادة.\n4. المرض والحمى لك أو لمن تعود.\nعند طلب:\n1. تفريج الكرب.\n2. شفاء المريض.\n3. الحفظ من الشيطان سائر اليوم.\n4. المغفرة لك وللأموات.\nعند الرغبة في:\n1. نخلةٍ في الجنة بكلمة.\n2. أن تعود مريضًا بسنةٍ معدودة.\n3. أن تُعطي من سألك بالله العظيم.","duaItems":"1. عند الكرب: «لا إله إلا الله العظيم الحليم، لا إله إلا الله رب العرش العظيم، لا إله إلا الله رب السماوات ورب الأرض ورب العرش الكريم» — صحيح مسلم 2730.\n2. عيادة المريض سبع مرات: «أسأل الله العظيم رب العرش العظيم أن يشفيك» — المستدرك 7694 (صحيح على شرط الشيخين)، وتخريج سنن أبي داود 3106.\n3. «سبحان الله وبحمده، سبحان الله العظيم» — تخريج المسند 7167 (على شرط الشيخين)؛ ومائة مرة صباحًا ومساءً — صحيح ابن حبان 860.\n4. عند دخول المسجد: «أعوذ بالله العظيم، وبوجهه الكريم، وبسلطانه القديم، من الشيطان الرجيم» — الكلم الطيب 66 (إسناده صحيح).\n5. عند الخروج إلى المسجد: «أعوذ بالله العظيم وسلطانه القديم من الشيطان الرجيم، ربي الله توكلت على الله لا حول ولا قوة إلا بالله» — الترغيب والترهيب 2/380.\n6. رقية الحمى والأوجاع: «باسم الله الكبير، نعوذ بالله العظيم من شر عرقٍ نعّار ومن شر حر النار» — المستدرك 8494 (صحيح الإسناد).\n7. عند القبور: «…غفر الله العظيم لنا ولكم ورحمنا وإياكم» — التمهيد 20/239 (إسناده حسن).\n8. عند الهم: رفع الرأس إلى السماء و«سبحان الله العظيم» — سنن الترمذي 3436 (حسن غريب).","summary":"«الله العظيم» في السنة اسمٌ يُقال قبل كل شيء: أول كلمات الكرب، وأول ما يُقال عند الهمّ برفع الرأس، وأول الاستعاذة في الطريق إلى المسجد، ويُسأل به الشفاء سبعًا عند رأس المريض، وتُغرس به نخلة في الجنة بكلمة خفيفة — فالعظيم اسمُ من يصغّر الكروب والأوجاع والشياطين."},"situations":[{"situationId":1,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"كربٌ يعظم في عينك وتخشى أنه عقوبة","bridge":"أطبق عليك الأمر؟ أول ما كان النبي ﷺ يقوله عند الكرب: «لا إله إلا الله العظيم الحليم» — وحّده أولًا، ثم عظّمه فيصغر الكرب، ثم اطمئن إلى حلمه."}]},{"situationId":2,"verses":[],"hadiths":[{"i":14,"strength":"direct","headline":"همٌّ نزل بك لا تدري كيف تواجهه","bridge":"أهمّك أمرٌ قادم؟ كان النبي ﷺ إذا أهمّه الأمر رفع رأسه إلى السماء فقال: «سبحان الله العظيم» — ارفع رأسك عن همّك إلى من فوقه، وعظّمه قبل أن تطلب."}]},{"situationId":4,"verses":[],"hadiths":[{"i":13,"strength":"direct","headline":"زيارة قبور من فقدتهم من الأحبة","bridge":"تزور قبر من فقدت؟ قل ما كان يقول: «السلام عليكم دار قوم مؤمنين، وإنا إن شاء الله بكم لاحقون، غفر الله العظيم لنا ولكم ورحمنا وإياكم» — مغفرةٌ تسع الحي والميت لا تُطلب إلا من العظيم."}]},{"situationId":5,"verses":[],"hadiths":[{"i":2,"strength":"direct","headline":"مرضٌ يلحّ عليك أو على من تحب","bridge":"مرضٌ يلحّ عليك أو على من تحب؟ اجلس عند رأس المريض وقل سبعًا: «أسأل الله العظيم رب العرش العظيم أن يشفيك» — فإن كان في أجله تأخير عوفي من وجعه."},{"i":9,"strength":"direct","headline":"الحمّى والأوجاع في البدن","bridge":"حمّى أو وجع؟ علّمهم النبي ﷺ من الأوجاع: «باسم الله الكبير، نعوذ بالله العظيم من شر عرقٍ نعّار ومن شر حر النار»."}]},{"situationId":27,"verses":[],"hadiths":[{"i":6,"strength":"direct","headline":"السؤال الصادق عن الدين بعد عنادٍ وإعراض","bridge":"جئتَ تسأل عن الدين بعد عناد؟ معاوية بن حيدة قال للنبي ﷺ: ما أتيتك حتى حلفت أكثر من عدد الأنامل ألا آتيك ولا آتي دينك، «وإني أسألك بوجه الله العظيم: بم بعثك ربنا إلينا؟» قال: «بدين الإسلام» — يُسأل بوجه العظيم من يعلّم عن العظيم؛ فسل بصدق تُجَب."}]},{"situationId":45,"verses":[],"hadiths":[{"i":7,"strength":"direct","headline":"سائلٌ يسألك بالله وأنت تتردد في إعطائه","bridge":"سُئلت بالله فترددت؟ «شر الناس منزلة الذي يُسأل بالله العظيم ولا يعطي به» — عظمة الاسم تُلزمك إذا سُئلت به."}]},{"situationId":93,"verses":[],"hadiths":[{"i":11,"strength":"direct","headline":"تعلّق القلب بالأولاد حتى يشغلك عن المهم","bridge":"شغلك ولدك عن أمرٍ مهم؟ النبي ﷺ قطع خطبته ليحمل الحسن والحسين ثم قال: «صدق الله العظيم: ﴿إِنَّمَا أَمْوَالُكُمْ وَأَوْلَادُكُمْ فِتْنَةٌ﴾» — اعترف كما اعترف، ثم عد إلى منبرك."}]},{"situationId":156,"verses":[],"hadiths":[{"i":4,"strength":"direct","headline":"طلب وردٍ يسير عظيم الأجر في طرفي النهار","bridge":"تريد وردًا في طرفي النهار؟ «من قال حين يصبح وحين يمسي: سبحان الله العظيم وبحمده مائة مرة لم يأت أحد يوم القيامة بأفضل مما جاء به إلا أحد قال مثل ذلك وزاد عليه» — مائة كلمة بالعظيم تبلغ بك الذروة؛ فلا تسبقك إليها أحد."}]},{"situationId":159,"verses":[],"hadiths":[{"i":8,"strength":"direct","headline":"دخول المسجد والتحصّن من الشيطان سائر اليوم","bridge":"تدخل المسجد؟ قل عند الباب: «أعوذ بالله العظيم وبوجهه الكريم وبسلطانه القديم من الشيطان الرجيم» فيقول الشيطان: «حفظ مني سائر اليوم»."},{"i":10,"strength":"direct","headline":"الخروج من البيت إلى المسجد وتربّص الشيطان","bridge":"تخرج من بيتك إلى المسجد؟ «من خرج من بيته إلى المسجد فقال: أعوذ بالله العظيم وسلطانه القديم من الشيطان الرجيم، ربي الله توكلت على الله لا حول ولا قوة إلا بالله — قال له الملك: كُفيت ووُقيت» — الاسم أول جملة الخروج، والملك يشهد بثمرته."}]},{"situationId":165,"verses":[],"hadiths":[{"i":3,"strength":"direct","headline":"طلب ذكرٍ خفيفٍ يثقل ميزانك بتعظيم الله","bridge":"تريد ذكرًا خفيفًا يثقل ميزانك؟ «كلمتان خفيفتان على اللسان ثقيلتان في الميزان حبيبتان إلى الرحمن: سبحان الله وبحمده، سبحان الله العظيم» — ثقلها من ثقل الاسم الذي فيها؛ فاختم به مجلسك ويومك."}]},{"situationId":171,"verses":[],"hadiths":[{"i":5,"strength":"direct","headline":"الخوف أن تمحو الذنوب ما قدّمت من حسنات","bridge":"تخاف أن تمحو ذنوبك حسناتك؟ «سبحان الله وبحمده سبحان الله العظيم أستغفر الله وأتوب إليه، من قالها كُتب له كما قالها ثم عُلقت بالعرش لا يمحوها ذنب عمله صاحبها» — ذكر بالعظيم يُختم ويُحفظ عند العرش؛ فأكثر مما لا يُمحى."}]},{"situationId":174,"verses":[{"i":1,"strength":"direct","headline":"ضعف تعظيم الله في القلب واستصغار حقه","bridge":"تريد أن يكبر الله في قلبك؟ انظر إلى حجم الجرم حين يصغر: صاحب الشمال عُذّب بسبعين ذراعًا من السلاسل لأنه ﴿كَانَ لَا يُؤْمِنُ بِاللَّهِ الْعَظِيمِ﴾ — فالجرم على قدر عظمة من كُفر به؛ ومن عرف عظمته لم يستصغر شيئًا يتعلق بحقه."}],"hadiths":[]},{"situationId":191,"verses":[],"hadiths":[{"i":12,"strength":"direct","headline":"استشعار عظمة نزول القرآن عند تلاوة سوره","bridge":"تقرأ سورةً وتريد أن تستشعر نزولها؟ أنس: نزلت سورة الأنعام ومعها موكبٌ من الملائكة سدّ ما بين الخافقين، لهم زجلٌ بالتسبيح، والأرض ترتج، ورسول الله ﷺ يقول: «سبحان الله العظيم! سبحان الله العظيم!» — قلها وأنت تذكر أنها قيلت والأرض ترتج."}]}]},{"id":35,"name":"عزيز ذو انتقام","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: عَزِيزٌ ذُو انْتِقَامٍ — مركّبة | المواضع: 3 (آل عمران: 4 — المائدة: 95 — إبراهيم: 47)\nخصوصية: في مواضعه الثلاثة يأتي الانتقامُ مسبوقًا دائمًا: بكتابٍ منزَّل (آل عمران)، أو عفوٍ سابق (المائدة)، أو وعدٍ معلَن (إبراهيم) — فانتقامه سبحانه لا يفاجئ أحدًا: تسبقه الحجة والمهلة.\n\nالمعنى:\n- العزيز: الغالب الذي لا يُمانَع.\n- ذو انتقام: صاحب الانتقام العادل ممن عاند بعد البيان — لا انتقامَ تشفٍّ، بل عقوبةُ عدلٍ بعد إعذار.\nسر الاقتران: عزةٌ تُنفذ الانتقام فلا يفلت منه معاند مهما احتمى.","teaches":"الحقائق التي كشفتها المواضع:\n1. انتقامه عدلٌ مسبوق دائمًا: بكتابٍ وبيان، أو عفوٍ ومهلة، أو وعدٍ معلن.\n2. الاستهانة بالعفو والعودُ بعده يستدعيان الاسم.\n3. مكر الماكرين بالرسل وأتباعهم مردود مهما عظم — فالمنتقم لهم عزيز.","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- عند رؤية معاندٍ يكابر بعد وضوح الحجة.\n- عند تحديث النفس بالعودة لذنبٍ عُفي عنه.\n- عند تعاظم مكر الظالمين بأهل الحق.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. للمظلوم من معاندٍ مصرّ: تفويض الاقتصاص للعزيز ذي الانتقام بدل الثأر الشخصي — إبراهيم 47.\n2. الاستعاذة من العود بعد العفو: «اللهم لا تجعل مغفرتك لي جرأةً عليك» — المائدة 95.\n3. الثقة بوعد النصر مهما عظم المكر: ﴿فَلَا تَحْسَبَنَّ اللَّهَ مُخْلِفَ وَعْدِهِ رُسُلَهُ﴾.\n4. شكر البيان والحجة: فما توعّد إلا بعد ثلاثة كتب — آل عمران 3–4.","summary":"لا ينتقم سبحانه إلا بعد كتابٍ أنزله وعفوٍ قدّمه ووعدٍ أعلنه — فإن رأيت المكر يهزّ الجبال فلا تحسبنّ الله مخلف وعده: ﴿إِنَّ اللَّهَ عَزِيزٌ ذُو انْتِقَامٍ﴾.","verses":[{"i":1,"of":4,"s":3,"surah":"آل عمران","a":4,"text":"مِنْ قَبْلُ هُدًى لِلنَّاسِ وَأَنْزَلَ الْفُرْقَانَ إِنَّ الَّذِينَ كَفَرُوا بِآيَاتِ اللَّهِ لَهُمْ عَذَابٌ شَدِيدٌ وَاللَّهُ عَزِيزٌ ذُو انْتِقَامٍ","prev":{"a":3,"text":"نَزَّلَ عَلَيْكَ الْكِتَابَ بِالْحَقِّ مُصَدِّقًا لِمَا بَيْنَ يَدَيْهِ وَأَنْزَلَ التَّوْرَاةَ وَالْإِنْجِيلَ"},"next":{"a":5,"text":"إِنَّ اللَّهَ لَا يَخْفَى عَلَيْهِ شَيْءٌ فِي الْأَرْضِ وَلَا فِي السَّمَاءِ"},"context":"فاتحة آل عمران: نزّل الكتاب بالحق مصدقًا، وأنزل التوراة والإنجيل من قبل هدى للناس، وأنزل الفرقان — ثم: ﴿إِنَّ الَّذِينَ كَفَرُوا بِآيَاتِ اللَّهِ لَهُمْ عَذَابٌ شَدِيدٌ وَاللَّهُ عَزِيزٌ ذُو انْتِقَامٍ﴾.","reason":"جاء الوعيد بعد تعداد ثلاثة كتبٍ منزّلة: فالكفر بالآيات بعد هذا البيان المتراكم جريمةٌ موثقة الحجة — والعزيز لا يمنعه مانع، ذو الانتقام يقتصّ للحق الذي أُنزل فكُذّب. فالانتقام هنا عدالةُ ما بعد الإعذار الكامل.","adds":"قاعدة العدل الإلهي: لا انتقام قبل كتابٍ وبيان — فالوعيد يتلو الحجةَ دائمًا لا يسبقها."},{"i":2,"of":4,"s":5,"surah":"المائدة","a":95,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَقْتُلُوا الصَّيْدَ وَأَنْتُمْ حُرُمٌ وَمَنْ قَتَلَهُ مِنْكُمْ مُتَعَمِّدًا فَجَزَاءٌ مِثْلُ مَا قَتَلَ مِنَ النَّعَمِ يَحْكُمُ بِهِ ذَوَا عَدْلٍ مِنْكُمْ هَدْيًا بَالِغَ الْكَعْبَةِ أَوْ كَفَّارَةٌ طَعَامُ مَسَاكِينَ أَوْ عَدْلُ ذَلِكَ صِيَامًا لِيَذُوقَ وَبَالَ أَمْرِهِ عَفَا اللَّهُ عَمَّا سَلَفَ وَمَنْ عَادَ فَيَنْتَقِمُ اللَّهُ مِنْهُ وَاللَّهُ عَزِيزٌ ذُو انْتِقَامٍ","prev":{"a":94,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَيَبْلُوَنَّكُمُ اللَّهُ بِشَيْءٍ مِنَ الصَّيْدِ تَنَالُهُ أَيْدِيكُمْ وَرِمَاحُكُمْ لِيَعْلَمَ اللَّهُ مَنْ يَخَافُهُ بِالْغَيْبِ فَمَنِ اعْتَدَى بَعْدَ ذَلِكَ فَلَهُ عَذَابٌ أَلِيمٌ"},"next":{"a":96,"text":"أُحِلَّ لَكُمْ صَيْدُ الْبَحْرِ وَطَعَامُهُ مَتَاعًا لَكُمْ وَلِلسَّيَّارَةِ وَحُرِّمَ عَلَيْكُمْ صَيْدُ الْبَرِّ مَا دُمْتُمْ حُرُمًا وَاتَّقُوا اللَّهَ الَّذِي إِلَيْهِ تُحْشَرُونَ"},"context":"في جزاء الصيد حال الإحرام: ﴿عَفَا اللَّهُ عَمَّا سَلَفَ وَمَنْ عَادَ فَيَنْتَقِمُ اللَّهُ مِنْهُ وَاللَّهُ عَزِيزٌ ذُو انْتِقَامٍ﴾.","reason":"عفوٌ عمّا كان قبل التحريم، وتحذيرٌ لمن عاد بعد العلم والعفو: فالعائد المستهين بعد المغفرة الأولى يتعرض للاسم — إذ الاستهانةُ بالعفو أشد من الذنب الأول. وحُرمةُ الحرم والإحرام يحرسها عزيز.","adds":"العفو الأول ليس ضمانًا للثاني: من جعل مغفرةَ الله جرأةً على العود فقد بدّل الرحمة خصومة."},{"i":3,"of":4,"s":14,"surah":"إبراهيم","a":47,"text":"فَلَا تَحْسَبَنَّ اللَّهَ مُخْلِفَ وَعْدِهِ رُسُلَهُ إِنَّ اللَّهَ عَزِيزٌ ذُو انْتِقَامٍ","prev":{"a":46,"text":"وَقَدْ مَكَرُوا مَكْرَهُمْ وَعِنْدَ اللَّهِ مَكْرُهُمْ وَإِنْ كَانَ مَكْرُهُمْ لِتَزُولَ مِنْهُ الْجِبَالُ"},"next":{"a":48,"text":"يَوْمَ تُبَدَّلُ الْأَرْضُ غَيْرَ الْأَرْضِ وَالسَّمَاوَاتُ وَبَرَزُوا لِلَّهِ الْوَاحِدِ الْقَهَّارِ"},"context":"بعد ذكر مكر الظالمين — ﴿وَإِنْ كَانَ مَكْرُهُمْ لِتَزُولَ مِنْهُ الْجِبَالُ﴾: ﴿فَلَا تَحْسَبَنَّ اللَّهَ مُخْلِفَ وَعْدِهِ رُسُلَهُ إِنَّ اللَّهَ عَزِيزٌ ذُو انْتِقَامٍ﴾.","reason":"مهما تعاظم المكر — حتى لو زالت منه الجبال — فوعدُ نصر الرسل لا يُخلف: لأن الواعد عزيزٌ لا يغالبه ماكر، ذو انتقامٍ يقتصّ لرسله وأوليائه من كل من مكر بهم. فالآية أمانٌ لأتباع الرسل في أزمنة تجبّر الماكرين.","adds":"إذا رأيت المكرَ بالحق يتضخم حتى يهزّ الجبال، فاقرأ: ﴿فَلَا تَحْسَبَنَّ اللَّهَ مُخْلِفَ وَعْدِهِ﴾ — التضخم لا يغيّر النتيجة."},{"i":4,"of":4,"s":39,"surah":"الزمر","a":37,"text":"وَمَنْ يَهْدِ اللَّهُ فَمَا لَهُ مِنْ مُضِلٍّ أَلَيْسَ اللَّهُ بِعَزِيزٍ ذِي انْتِقَامٍ","prev":{"a":36,"text":"أَلَيْسَ اللَّهُ بِكَافٍ عَبْدَهُ وَيُخَوِّفُونَكَ بِالَّذِينَ مِنْ دُونِهِ وَمَنْ يُضْلِلِ اللَّهُ فَمَا لَهُ مِنْ هَادٍ"},"next":{"a":38,"text":"وَلَئِنْ سَأَلْتَهُمْ مَنْ خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ لَيَقُولُنَّ اللَّهُ قُلْ أَفَرَأَيْتُمْ مَا تَدْعُونَ مِنْ دُونِ اللَّهِ إِنْ أَرَادَنِيَ اللَّهُ بِضُرٍّ هَلْ هُنَّ كَاشِفَاتُ ضُرِّهِ أَوْ أَرَادَنِي بِرَحْمَةٍ هَلْ هُنَّ مُمْسِكَاتُ رَحْمَتِهِ قُلْ حَسْبِيَ اللَّهُ عَلَيْهِ يَتَوَكَّلُ الْمُتَوَكِّلُونَ"},"context":"يطمئن السياق النبيَّ ﷺ: ﴿أَلَيْسَ اللَّهُ بِكَافٍ عَبْدَهُ وَيُخَوِّفُونَكَ بِالَّذِينَ مِنْ دُونِهِ﴾، ويقرّر أن الهداية والإضلال بيد الله، فمن يهده فلا مضلّ له. ثم يُختم بسؤال التقرير: ﴿أَلَيْسَ اللَّهُ بِعَزِيزٍ ذِي انْتِقَامٍ﴾. وبعدها يُسألون عمّن خلق السماوات والأرض، وهل تكشف آلهتهم ضرًّا أو تمسك رحمة.","reason":"جاء الاسمان جوابًا على التخويف: هم يخوّفونه بآلهتهم، فذكّره بأن الله عزيزٌ لا يُغلب، ذو انتقامٍ ممّن يعاديه — فالذي يُخشى حقًّا هو العزيز المنتقم، لا الآلهة العاجزة عن كشف ضرٍّ أو إمساك رحمة.","adds":"من خوّفوك بغير الله فتذكّر أن الله عزيزٌ لا يُغلب وينتقم لأوليائه؛ والكفاية والحماية منه وحده.","draft":true}],"hadiths":[],"situations":[{"situationId":16,"verses":[{"i":2,"strength":"direct","headline":"الجرأة على العود بعد عفو الله الأول","bridge":"عفا الله عنك مرةً فأخذتها جرأةً على العود؟ في جزاء الصيد: ﴿عَفَا اللَّهُ عَمَّا سَلَفَ وَمَنْ عَادَ فَيَنْتَقِمُ اللَّهُ مِنْهُ وَاللَّهُ عَزِيزٌ ذُو انْتِقَامٍ﴾ — العفو الأول ليس ضمانًا للثاني؛ من جعل مغفرة الله رخصةً للتسويف فقد بدّل الرحمة خصومة."}],"hadiths":[]},{"situationId":20,"verses":[{"i":1,"strength":"direct","headline":"تأجيل التوبة بعد بلوغ الحجة والبيان","bridge":"تؤجل التوبة وقد بلغتك الحجة؟ جاء الوعيد بعد تعداد ثلاثة كتبٍ منزّلة: ﴿إِنَّ الَّذِينَ كَفَرُوا بِآيَاتِ اللَّهِ لَهُمْ عَذَابٌ شَدِيدٌ وَاللَّهُ عَزِيزٌ ذُو انْتِقَامٍ﴾ — لا انتقام قبل بيان، لكن بعد البيان الكامل لا عذر؛ وأنت قد بلغك البيان."}],"hadiths":[]},{"situationId":28,"verses":[{"i":3,"strength":"direct","headline":"ظلمٌ وقع عليك وتضخّم مكر من ظلمك","bridge":"ظُلمتَ وتضخّم مكر الظالمين حتى كأن الجبال تزول منه؟ اقرأ: ﴿وَإِنْ كَانَ مَكْرُهُمْ لِتَزُولَ مِنْهُ الْجِبَالُ * فَلَا تَحْسَبَنَّ اللَّهَ مُخْلِفَ وَعْدِهِ رُسُلَهُ إِنَّ اللَّهَ عَزِيزٌ ذُو انْتِقَامٍ﴾ — الواعد عزيزٌ لا يغالبه ماكر، ذو انتقامٍ يقتصّ لأوليائه؛ فحجم المكر لا يغيّر النتيجة."}],"hadiths":[]},{"situationId":33,"verses":[{"i":4,"strength":"direct","headline":"تخويفك بمن دون الله من القوى والأسباب","bridge":"يخوّفونك بمن دون الله من قوى وأسباب؟ ﴿أَلَيْسَ اللَّهُ بِعَزِيزٍ ذِي انْتِقَامٍ﴾ — من يُخشى حقًّا هو العزيز الذي لا يُغلب وينتقم لأوليائه، لا من عجز عن كشف ضرٍّ أو إمساك رحمة."}],"hadiths":[]}]},{"id":36,"name":"الله الملك الحق","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: اللَّهُ الْمَلِكُ الْحَقُّ — مركّبة | المواضع: 2 (طه: 114 — المؤمنون: 116)\nخصوصية: كلا الموضعين مفتتح بـ﴿فَتَعَالَى﴾ — تنزيهًا وارتفاعًا — وكلاهما يجيب سؤالًا وجوديًا: من أين يؤخذ العلم؟ وهل الحياة عبث؟\n\nالمعنى:\n- الملك الحق: الذي ملكه ثابتُ الحقيقة، كاملٌ لا يشوبه نقص، دائمٌ لا يزول — وكل ملكٍ سواه مجازٌ زائل.","teaches":"الحقائق التي كشفها الموضعان:\n1. الملك الحق لا يخلق عبثًا — فوجودُك مقصودٌ ورجوعُك محتوم.\n2. أدب طلب العلم من مالكه: تأنٍّ في التلقي ودعاءٌ بالزيادة.\n3. ﴿فَتَعَالَى﴾: كلما عرفت حقّية ملكه ازددت له تنزيهًا.","whenRecall":"لحظات الاستحضار — مشتقة من موضعيه:\n- عند وساوس اللاجدوى والعبثية: «لماذا أنا هنا؟».\n- عند بدء طلب أي علم: قبل الدرس والمذاكرة.","whenPray":"بنود الدعاء — مشتقة من سياق الموضعين:\n1. دعاء طالب العلم القرآني: ﴿رَبِّ زِدْنِي عِلْمًا﴾ — طه 114.\n2. عند وساوس العبث واللامعنى: استحضار ﴿أَفَحَسِبْتُمْ أَنَّمَا خَلَقْنَاكُمْ عَبَثًا﴾ وتنزيه الملك الحق — المؤمنون 115–116.\n3. التأني في تلقي العلم وعدم العجلة قبل تمام الفهم — طه 114.","summary":"سؤال العبث أجابه اسمٌ: ﴿فَتَعَالَى اللَّهُ الْمَلِكُ الْحَقُّ﴾ — ملكٌ حقّ لا يعبث، فلحياتك غاية؛ وسؤال العلم أجابه دعاء: ﴿رَبِّ زِدْنِي عِلْمًا﴾.","verses":[{"i":1,"of":2,"s":20,"surah":"طه","a":114,"text":"فَتَعَالَى اللَّهُ الْمَلِكُ الْحَقُّ وَلَا تَعْجَلْ بِالْقُرْآنِ مِنْ قَبْلِ أَنْ يُقْضَى إِلَيْكَ وَحْيُهُ وَقُلْ رَبِّ زِدْنِي عِلْمًا","prev":{"a":113,"text":"وَكَذَلِكَ أَنْزَلْنَاهُ قُرْآنًا عَرَبِيًّا وَصَرَّفْنَا فِيهِ مِنَ الْوَعِيدِ لَعَلَّهُمْ يَتَّقُونَ أَوْ يُحْدِثُ لَهُمْ ذِكْرًا"},"next":{"a":115,"text":"وَلَقَدْ عَهِدْنَا إِلَى آدَمَ مِنْ قَبْلُ فَنَسِيَ وَلَمْ نَجِدْ لَهُ عَزْمًا"},"context":"سورة طه في خواتيمها تعرض يوم القيامة: ﴿يَوْمَئِذٍ يَتَّبِعُونَ الدَّاعِيَ لَا عِوَجَ لَهُ وَخَشَعَتِ الْأَصْوَاتُ لِلرَّحْمَنِ فَلَا تَسْمَعُ إِلَّا هَمْسًا﴾، ثم تطمئن العاملين: ﴿وَمَنْ يَعْمَلْ مِنَ الصَّالِحَاتِ وَهُوَ مُؤْمِنٌ فَلَا يَخَافُ ظُلْمًا وَلَا هَضْمًا﴾ — لا زيادةَ في سيئاته ولا نقصَ من حسناته. ثم تقرر أن هذا القرآن نزل عربيًّا مصرَّفًا فيه الوعيد ﴿لَعَلَّهُمْ يَتَّقُونَ﴾. وهنا — في ذروة عرض الملك والحساب — يأتي التنزيه: ﴿فَتَعَالَى اللَّهُ الْمَلِكُ الْحَقُّ﴾. ثم يلتفت الخطاب إلى النبي ﷺ في أمرٍ شخصي دقيق من أدب تلقّي الوحي: ﴿وَلَا تَعْجَلْ بِالْقُرْآنِ مِنْ قَبْلِ أَنْ يُقْضَى إِلَيْكَ وَحْيُهُ﴾ — تأنَّ فالمصدر مضمون — ﴿وَقُلْ رَبِّ زِدْنِي عِلْمًا﴾.","reason":"قُرن تنزيه الملك الحق بأدبين في التلقي: التأني بالوحي حتى يُقضى — فالمصدر مضمون لا يحتاج عجلة — وسؤال الزيادة: ﴿رَبِّ زِدْنِي عِلْمًا﴾. فالملك الحق يملك العلم كله، ومن أراد العلم أخذه من مالكه: تأنيًا في التلقي ودعاءً في الطلب.","adds":"أشهر دعاءٍ لطلب العلم في القرآن — ﴿رَبِّ زِدْنِي عِلْمًا﴾ — جاء في ظل هذا الاسم: فاطلب علمك من الملك الحق مالكِ خزائنه."},{"i":2,"of":2,"s":23,"surah":"المؤمنون","a":116,"text":"فَتَعَالَى اللَّهُ الْمَلِكُ الْحَقُّ لَا إِلَهَ إِلَّا هُوَ رَبُّ الْعَرْشِ الْكَرِيمِ","prev":{"a":115,"text":"أَفَحَسِبْتُمْ أَنَّمَا خَلَقْنَاكُمْ عَبَثًا وَأَنَّكُمْ إِلَيْنَا لَا تُرْجَعُونَ"},"next":{"a":117,"text":"وَمَنْ يَدْعُ مَعَ اللَّهِ إِلَهًا آخَرَ لَا بُرْهَانَ لَهُ بِهِ فَإِنَّمَا حِسَابُهُ عِنْدَ رَبِّهِ إِنَّهُ لَا يُفْلِحُ الْكَافِرُونَ"},"context":"خاتمة المؤمنون: ﴿أَفَحَسِبْتُمْ أَنَّمَا خَلَقْنَاكُمْ عَبَثًا وَأَنَّكُمْ إِلَيْنَا لَا تُرْجَعُونَ * فَتَعَالَى اللَّهُ الْمَلِكُ الْحَقُّ لَا إِلَهَ إِلَّا هُوَ رَبُّ الْعَرْشِ الْكَرِيمِ﴾.","reason":"تنزّه «الملك الحق» عن العبث جوابًا لأخطر سؤال: هل خُلقنا عبثًا بلا رجوع؟ — فملكٌ ملكه حقٌّ لا يخلق باطلًا ولا يترك خلقه سدى؛ الرجوعُ والحساب لازمُ حقّية ملكه. فمن ظن الحياة بلا معنى فقد طعن — من حيث لا يدري — في حقّية الملك.","adds":"جواب القرآن على العبثية واللامعنى في كلمتين: «الملك الحق» — فلحياتك غايةٌ ولموتك رجوع، لأن مالكك لا يعبث."}],"hadiths":[],"situations":[{"situationId":181,"verses":[{"i":2,"strength":"direct","headline":"الشعور بعبثية الحياة والسؤال عن غايتها","bridge":"تسأل: لماذا أنا هنا؟ جواب القرآن في كلمتين بعد سؤالٍ صريح: ﴿أَفَحَسِبْتُمْ أَنَّمَا خَلَقْنَاكُمْ عَبَثًا وَأَنَّكُمْ إِلَيْنَا لَا تُرْجَعُونَ * فَتَعَالَى اللَّهُ الْمَلِكُ الْحَقُّ﴾ — ملكٌ ملكه حق لا يخلق باطلًا ولا يترك خلقه سدى؛ فلحياتك غاية ولموتك رجوع، لأن مالكك لا يعبث."}],"hadiths":[]},{"situationId":192,"verses":[{"i":1,"strength":"direct","headline":"بداية طلب العلم أو استصعاب التحصيل","bridge":"تبدأ تعلّم شيءٍ أو تستصعبه؟ أشهر دعاءٍ لطلب العلم جاء في ظل هذا الاسم: ﴿فَتَعَالَى اللَّهُ الْمَلِكُ الْحَقُّ وَلَا تَعْجَلْ بِالْقُرْآنِ... وَقُلْ رَبِّ زِدْنِي عِلْمًا﴾ — أدبان: تأنٍّ في التلقي لأن المصدر مضمون، ودعاءٌ في الطلب لأن العلم كله في خزائن الملك الحق."}],"hadiths":[]}]},{"id":37,"name":"الغفار","compound":false,"meaning":"بطاقة الاسم:\nالصيغة: غَفَّارٌ / لَغَفَّارٌ — مفردة بصيغة مبالغة | المواضع: 2 (طه: 82 — نوح: 10)\nخصوصية: «الغفّار» أبلغ من «الغفور» في التكرار: يغفر المرةَ بعد المرة مهما عاد العبد. وموضعاه: وعدٌ مباشر بضمير المتكلم المؤكد، ووصفةُ نوحٍ لقومه تربط الاستغفار بأرزاق الدنيا الخمسة.\n\nالمعنى:\n- الغفار: الذي يغفر الذنوب مرةً بعد مرة، لا يملّ من مغفرة العائدين مهما تكررت عودتهم.","teaches":"الحقائق التي كشفها الموضعان:\n1. تكرار الذنب لا يغلق الباب: «الغفّار» صيغة التكرار — لمن يتكرر سقوطه ورجوعه.\n2. الاستغفار مفتاح أرزاق الدنيا الخمسة — لا الآخرة فقط.\n3. المغفرة الكاملة مشروع طريق: توبة وإيمان وعمل ثم استمرار.","whenRecall":"لحظات الاستحضار — مشتقة من موضعيه:\n- عند العودة للذنب بعد التوبة مرارًا حتى تخجل من الرجوع.\n- عند ضيق الرزق، أو تأخر الولد، أو انحباس الخير.","whenPray":"بنود الدعاء — مشتقة من سياق الموضعين:\n1. لمن تكرر ذنبه: لا تملّ من التوبة — فقد قال بنفسه: ﴿وَإِنِّي لَغَفَّارٌ لِمَنْ تَابَ﴾ — طه 82.\n2. عند طلب الرزق والذرية والغيث: الإكثار من الاستغفار — نوح 10–12.\n3. سؤال الاهتداء والاستمرار بعد التوبة: ﴿ثُمَّ اهْتَدَى﴾.\n4. من السنة: كان ﷺ يستغفر في المجلس الواحد مائة مرة — فمن كان أكمل الخلق يستغفر مائة، فكم يلزمك؟","summary":"قالها لك بنفسه: ﴿وَإِنِّي لَغَفَّارٌ لِمَنْ تَابَ﴾ — فمهما تكرر سقوطك كرّر رجوعك؛ وإن ضاق رزقك فالوصفة عند نوح: ﴿اسْتَغْفِرُوا رَبَّكُمْ إِنَّهُ كَانَ غَفَّارًا﴾.","verses":[{"i":1,"of":2,"s":20,"surah":"طه","a":82,"text":"وَإِنِّي لَغَفَّارٌ لِمَنْ تَابَ وَآمَنَ وَعَمِلَ صَالِحًا ثُمَّ اهْتَدَى","prev":{"a":81,"text":"كُلُوا مِنْ طَيِّبَاتِ مَا رَزَقْنَاكُمْ وَلَا تَطْغَوْا فِيهِ فَيَحِلَّ عَلَيْكُمْ غَضَبِي وَمَنْ يَحْلِلْ عَلَيْهِ غَضَبِي فَقَدْ هَوَى"},"next":{"a":83,"text":"وَمَا أَعْجَلَكَ عَنْ قَوْمِكَ يَا مُوسَى"},"context":"﴿وَإِنِّي لَغَفَّارٌ لِمَنْ تَابَ وَآمَنَ وَعَمِلَ صَالِحًا ثُمَّ اهْتَدَى﴾ — وعدٌ بضمير المتكلم مؤكدًا باللام: إني لغفار.","reason":"أعلن سبحانه بنفسه صيغةَ المبالغة لمن جمع أربعة: توبةً تمحو، وإيمانًا يؤسس، وعملًا يصدّق، ﴿ثُمَّ اهْتَدَى﴾ — لزم الاستقامة على ذلك. فالمغفرة المتجددة لأصحاب الطريق المتجدد: كلما سقطوا قاموا — والغفّار اسمُ من يتكرر ذنبه وتتكرر توبته.","adds":"الشروط الأربعة سلّمٌ صاعد آخرُ درجاته الاستمرار — فليست توبةَ لحظةٍ بل مشروعَ طريق."},{"i":2,"of":2,"s":71,"surah":"نوح","a":10,"text":"فَقُلْتُ اسْتَغْفِرُوا رَبَّكُمْ إِنَّهُ كَانَ غَفَّارًا","prev":{"a":9,"text":"ثُمَّ إِنِّي أَعْلَنْتُ لَهُمْ وَأَسْرَرْتُ لَهُمْ إِسْرَارًا"},"next":{"a":11,"text":"يُرْسِلِ السَّمَاءَ عَلَيْكُمْ مِدْرَارًا"},"context":"نوح يلخص لقومه — بعد قرونٍ من الدعوة — الوصفة: ﴿فَقُلْتُ اسْتَغْفِرُوا رَبَّكُمْ إِنَّهُ كَانَ غَفَّارًا * يُرْسِلِ السَّمَاءَ عَلَيْكُمْ مِدْرَارًا * وَيُمْدِدْكُمْ بِأَمْوَالٍ وَبَنِينَ وَيَجْعَلْ لَكُمْ جَنَّاتٍ وَيَجْعَلْ لَكُمْ أَنْهَارًا﴾.","reason":"ربط نوحٌ الاستغفارَ بخمسة أرزاق دنيوية: الغيث المدرار، والأموال، والبنون, والجنات، والأنهار — فالذنوب تحبس الأرزاق، والاستغفار يفكّ الحبس: لأن الغفّار إذا غفر الذنبَ أطلق ما كان محبوسًا بسببه. منهجٌ نبوي صريح: علاج الجدب والفقر والعقم يبدأ بالاستغفار.","adds":"شكا رجلٌ للحسن البصري الجدبَ فقال: استغفر الله، وشكا آخرُ الفقرَ وثالثٌ قلةَ الولد فقال: استغفر الله — وتلا هذه الآيات."}],"hadiths":[],"sunnah":{"card":"الصيغة: الْغَفَّارُ — مفردة\nفي السنة: شاهد واحد (روايتان)\nخصوصية الورود في السنة: ورد الاسم مفردًا في تعداد الأسماء التسعة والتسعين: في رواية الترمذي بعد «الخالق البارئ المصور» وقبل «القهار»، وفي رواية المستدرك كذلك. ولم يرد مفردًا في دعاءٍ نبوي مستقل في هذه الأحاديث، بل مقرونًا في «العزيز الغفار» (انظر اسمه).\nالمعنى المختصر: كثير المغفرة الذي يستر الذنوب مرةً بعد مرة.","teaches":"1. أنه يغفر مرةً بعد مرة لأنه خلق وصوّر فيعلم ضعف من خلق.\n2. أن مغفرته مقترنة بقهره في السرد: يغفر من موضع قوة لا ضعف.\n3. أن اسمه محصًى في التسعة والتسعين.","whenRecall":"- في إحصاء الأسماء.\n- حين تكرر الذنب: الغفار صيغة مبالغة.\n- حين تقرأ ﴿وَإِنِّي لَغَفَّارٌ لِمَنْ تَابَ﴾.","whenPray":"عند الشعور بـ:\n1. كثرة الذنوب وتكررها.\nعند طلب:\n1. مغفرةٍ متكررة لذنبٍ متكرر.\nعند الرغبة في:\n1. حفظ الأسماء وإحصائها.","duaItems":"لا صيغة دعاء منصوصة في الشاهد؛ ويُدعى بلفظ القرآن: «رب إنك غفار، فاغفر لي» — من ﴿وَإِنِّي لَغَفَّارٌ لِمَنْ تَابَ وَآمَنَ وَعَمِلَ صَالِحًا ثُمَّ اهْتَدَى﴾ [طه: 82].","summary":"«الغفار» في السنة اسمٌ محصًى بين المصوّر والقهار: يغفر لمن خلقه فعلم ضعفه، ويغفر من موضع قهرٍ لا عجز."},"situations":[{"situationId":16,"verses":[{"i":1,"strength":"direct","headline":"تكرار الذنب والخوف من ردّ التوبة","bridge":"الغفّار اسمُ من يتكرر ذنبه وتتكرر توبته، وقد أعلنه الله بنفسه مؤكدًا: ﴿وَإِنِّي لَغَفَّارٌ لِمَنْ تَابَ وَآمَنَ وَعَمِلَ صَالِحًا ثُمَّ اهْتَدَى﴾ — صيغة المبالغة لأصحاب الطريق المتجدد: كلما سقطوا قاموا؛ فالمطلوب منك ليس ألا تسقط، بل ألا تبقى."}],"hadiths":[]},{"situationId":39,"verses":[{"i":2,"strength":"direct","headline":"ضيق الرزق وحبس الخير بسبب الذنوب","bridge":"دخلٌ لا يكفي أو دَينٌ يثقلك؟ وصفة نوح لقومه بعد قرونٍ من الدعوة: ﴿اسْتَغْفِرُوا رَبَّكُمْ إِنَّهُ كَانَ غَفَّارًا * يُرْسِلِ السَّمَاءَ عَلَيْكُمْ مِدْرَارًا * وَيُمْدِدْكُمْ بِأَمْوَالٍ﴾ — الذنوب تحبس الأرزاق والاستغفار يفكّ الحبس؛ فإذا غفر الغفّار الذنب أطلق ما كان محبوسًا بسببه."}],"hadiths":[]}]},{"id":38,"name":"الغفور ذو الرحمة","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: الْغَفُورُ ذُو الرَّحْمَةِ — مركّبة | المواضع: 1 (الكهف: 58)\nخصوصية: الصيغة الوحيدة التي وُصف فيها بـ«ذو الرحمة» — مالكِ الرحمة أصالةً — وجاءت تعليلًا لإمهال الظالمين.\n\nالمعنى:\n- الغفور: الساتر المتجاوز.\n- ذو الرحمة: مالكُ الرحمة ملكًا ذاتيًا تامًّا، يمنحها متى شاء لمن شاء — حتى لمن استحق العقوبة، إمهالًا.","teaches":"الحقائق التي كشفها الموضع:\n1. تأخير العقوبة أثرٌ من ملكه للرحمة — لا غفلة ولا عجز.\n2. الإمهال لا يلغي الموعد: ﴿لَنْ يَجِدُوا مِنْ دُونِهِ مَوْئِلًا﴾.\n3. «ذو الرحمة»: يملكها فيمنحها حتى للمعرضين — فكيف بالمقبلين؟","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند استبطاء عقوبة الظالمين: المهلة من ملكه للرحمة.\n- عند إمهالك أنت رغم ذنوبك: أنت في المهلة الآن.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. اغتنام مهلة الإمهال بالتوبة قبل الموعد — فلا موئل بعده.\n2. للمظلوم المستعجل: سؤال الصبر واليقين بأن التأخير رحمةٌ وحكمة لا إفلاتًا.\n3. سؤال الرحمة من مالكها: «اللهم يا ذا الرحمة، ارحمني برحمةٍ من عندك تغنيني بها عن رحمة من سواك».","summary":"لو يؤاخذ لعجّل — لكنه ﴿الْغَفُورُ ذُو الرَّحْمَةِ﴾: يملك الرحمة فيمهل بها حتى الظالمين. فاجعل مهلتك توبةً لا غفلة — فالموعد ﴿لَنْ يَجِدُوا مِنْ دُونِهِ مَوْئِلًا﴾.","verses":[{"i":1,"of":1,"s":18,"surah":"الكهف","a":58,"text":"وَرَبُّكَ الْغَفُورُ ذُو الرَّحْمَةِ لَوْ يُؤَاخِذُهُمْ بِمَا كَسَبُوا لَعَجَّلَ لَهُمُ الْعَذَابَ بَلْ لَهُمْ مَوْعِدٌ لَنْ يَجِدُوا مِنْ دُونِهِ مَوْئِلًا","prev":{"a":57,"text":"وَمَنْ أَظْلَمُ مِمَّنْ ذُكِّرَ بِآيَاتِ رَبِّهِ فَأَعْرَضَ عَنْهَا وَنَسِيَ مَا قَدَّمَتْ يَدَاهُ إِنَّا جَعَلْنَا عَلَى قُلُوبِهِمْ أَكِنَّةً أَنْ يَفْقَهُوهُ وَفِي آذَانِهِمْ وَقْرًا وَإِنْ تَدْعُهُمْ إِلَى الْهُدَى فَلَنْ يَهْتَدُوا إِذًا أَبَدًا"},"next":{"a":59,"text":"وَتِلْكَ الْقُرَى أَهْلَكْنَاهُمْ لَمَّا ظَلَمُوا وَجَعَلْنَا لِمَهْلِكِهِمْ مَوْعِدًا"},"context":"في سياق المعرضين الذين ﴿اتَّخَذُوا آيَاتِي وَمَا أُنْذِرُوا هُزُوًا﴾، وبعد أشدّ وصفٍ للإعراض — ﴿وَمَنْ أَظْلَمُ مِمَّنْ ذُكِّرَ بِآيَاتِ رَبِّهِ فَأَعْرَضَ عَنْهَا وَنَسِيَ مَا قَدَّمَتْ يَدَاهُ﴾ — يقف السامع أمام سؤال محيّر: هؤلاء يستهزئون بالآيات ويعرضون، فلماذا لا يُؤخذون؟ لماذا تمضي أيامهم في عافيةٍ ومال؟ فتجيب الآية عن السؤال قبل أن يُطرح: ﴿وَرَبُّكَ الْغَفُورُ ذُو الرَّحْمَةِ لَوْ يُؤَاخِذُهُمْ بِمَا كَسَبُوا لَعَجَّلَ لَهُمُ الْعَذَابَ﴾ — التأخير ليس عن غفلة بل لأن الذي يملك الأمر «غفورٌ ذو رحمة»؛ لو كانت المؤاخذة فوريةً لما بقي منهم أحد. ثم يُغلق باب الاغترار فورًا: ﴿بَلْ لَهُمْ مَوْعِدٌ لَنْ يَجِدُوا مِنْ دُونِهِ مَوْئِلًا﴾ — والآية بعدها تسوق الشاهد التاريخي: ﴿وَتِلْكَ الْقُرَى أَهْلَكْنَاهُمْ لَمَّا ظَلَمُوا وَجَعَلْنَا لِمَهْلِكِهِمْ مَوْعِدًا﴾.","reason":"فسّرت الآيةُ سرَّ تأخير العذاب عن الظالمين: لو كانت المؤاخذة فورية «لعجّل» — لكنه «الغفور ذو الرحمة»: يملك الرحمة فيُمهل بها حتى مستحقّي العقوبة، فتحًا لباب العودة. غير أن الإمهال موقوت: ﴿بَلْ لَهُمْ مَوْعِدٌ لَنْ يَجِدُوا مِنْ دُونِهِ مَوْئِلًا﴾ — فالمهلة رحمة، والموعد حق.","adds":"يجيب عن سؤال: لماذا يُمهَل الظالمون؟ — لأن مالك الرحمة يمنح منها حتى من لا يستحق، إمهالًا — لكن لا موئل من الموعد لمن أضاع المهلة."}],"hadiths":[],"situations":[{"situationId":36,"verses":[{"i":1,"strength":"direct","headline":"رؤية المعرضين الظالمين ممهَلين في عافيةٍ ومال","bridge":"تسأل: لماذا يُمهَل الظالمون؟ الآية تجيب حرفيًّا: ﴿وَرَبُّكَ الْغَفُورُ ذُو الرَّحْمَةِ لَوْ يُؤَاخِذُهُمْ بِمَا كَسَبُوا لَعَجَّلَ لَهُمُ الْعَذَابَ﴾ — لأنه مالك الرحمة يمنح منها حتى من لا يستحق إمهالًا؛ لكن اقرأ ما بعدها: ﴿بَلْ لَهُمْ مَوْعِدٌ لَنْ يَجِدُوا مِنْ دُونِهِ مَوْئِلًا﴾."}],"hadiths":[]}]},{"id":39,"name":"خير الوارثين","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: خَيْرُ الْوَارِثِينَ — صيغة تفضيل | المواضع: 1 (الأنبياء: 89)\nخصوصية: في دعاء زكريا لطلب الولد — دعاءٌ جمع الطلبَ والتفويض في نفَسٍ واحد، فأُجيب بأكثر مما سأل.\n\nالمعنى:\n- خير الوارثين: الباقي بعد فناء خلقه، يرث الأرض ومن عليها — وخيرُ من يَخلُف على العبد كلَّ ما فقده أو خافه.","teaches":"الحقائق التي كشفها الموضع:\n1. الطلب مع التفويض: «لا تذرني فردًا» + «أنت خير الوارثين» — لا تعارض بينهما بل كمال.\n2. الإجابة قد تتجاوز الطلب إلى إصلاح السبب: ﴿وَأَصْلَحْنَا لَهُ زَوْجَهُ﴾.\n3. ما فقدتَه أو خفتَ ضياعه بعدك — وارثُه الحقيقي خيرُ الوارثين.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند طلب الذرية وتأخرها.\n- عند الوحدة وفقد السند.\n- عند الخوف على مشروعك وعلمك وأثرك بعد موتك.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. دعاء طلب الولد بنصه: ﴿رَبِّ لَا تَذَرْنِي فَرْدًا وَأَنْتَ خَيْرُ الْوَارِثِينَ﴾ — الأنبياء 89.\n2. عند فقد سندٍ أو عزيز: سؤال أن يَخلُف عليك — فهو خير الوارثين.\n3. لمن يخاف على أثره وعمله بعد موته: أودعه عند الوارث الباقي.\n4. الأخذ بأسباب الإجابة المذكورة بعدها: المسارعة في الخيرات والدعاء رغبًا ورهبًا — الأنبياء 90.","summary":"سل حاجتك وسلّم عاقبتها كما فعل زكريا: ﴿رَبِّ لَا تَذَرْنِي فَرْدًا وَأَنْتَ خَيْرُ الْوَارِثِينَ﴾ — فوُهب يحيى وأُصلحت زوجُه: الإجابة قد تفوق السؤال.","verses":[{"i":1,"of":1,"s":21,"surah":"الأنبياء","a":89,"text":"وَزَكَرِيَّا إِذْ نَادَى رَبَّهُ رَبِّ لَا تَذَرْنِي فَرْدًا وَأَنْتَ خَيْرُ الْوَارِثِينَ","prev":{"a":88,"text":"فَاسْتَجَبْنَا لَهُ وَنَجَّيْنَاهُ مِنَ الْغَمِّ وَكَذَلِكَ نُنْجِي الْمُؤْمِنِينَ"},"next":{"a":90,"text":"فَاسْتَجَبْنَا لَهُ وَوَهَبْنَا لَهُ يَحْيَى وَأَصْلَحْنَا لَهُ زَوْجَهُ إِنَّهُمْ كَانُوا يُسَارِعُونَ فِي الْخَيْرَاتِ وَيَدْعُونَنَا رَغَبًا وَرَهَبًا وَكَانُوا لَنَا خَاشِعِينَ"},"context":"سورة الأنبياء تسرد سلسلة نداءات في الشدائد: أيوبُ يمسّه الضر فينادي، وذو النون في بطن الحوت في ظلماتٍ ثلاث فينادي ﴿لَا إِلَهَ إِلَّا أَنْتَ سُبْحَانَكَ إِنِّي كُنْتُ مِنَ الظَّالِمِينَ﴾ فيُستجاب له. ثم يأتي نداءُ زكريا — وهو نداءٌ من نوعٍ آخر: ليس ضرًّا نازلًا بل فراغًا ممتدًّا. شيخٌ كبير، وامرأتُه عاقر، والعمر يمضي وهو يخدم المحراب ولا وارث له يحمل الدين بعده. فناداه بأرقّ صيغةٍ ممكنة: لم يقل «هب لي ولدًا» بل ﴿رَبِّ لَا تَذَرْنِي فَرْدًا﴾ — شكوى وحدةٍ لا مطالبة بحق. ثم أتبعها بما هو أعجب: ﴿وَأَنْتَ خَيْرُ الْوَارِثِينَ﴾ — أي: وإن لم تعطني وارثًا فأنت الوارث، ولن يضيع دينك بعدي. طلبٌ ورضًا بالحرمان في نفَسٍ واحد. فجاءت الإجابة أوسع من السؤال: ﴿وَوَهَبْنَا لَهُ يَحْيَى وَأَصْلَحْنَا لَهُ زَوْجَهُ﴾.","reason":"طلبٌ بأرقّ صيغة — ﴿لَا تَذَرْنِي فَرْدًا﴾ — يتبعه تفويضٌ جليل: ﴿وَأَنْتَ خَيْرُ الْوَارِثِينَ﴾ — أي: إن لم ترزقني وارثًا فأنت خيرُ وارث، لن يضيع دينُك وذكرُك بعدي. طلبٌ مع رضًا مسبق بالحرمان. فجاءت الإجابة أوسع من السؤال: وُهب يحيى، وأُصلحت زوجُه العاقر — عولج السببُ نفسُه لا النتيجة فقط.","adds":"أكمل أدب الطلب: سل حاجتك وسلّم عاقبتها — ومن أسرار الإجابة هنا ما ذكرته الآية بعدها: ﴿إِنَّهُمْ كَانُوا يُسَارِعُونَ فِي الْخَيْرَاتِ وَيَدْعُونَنَا رَغَبًا وَرَهَبًا﴾."}],"hadiths":[{"i":1,"of":1,"text":"عَنِ ابْنِ عَبَّاسٍ وَعَبْدِ اللَّهِ: \"دَعا زَكريَّا ربَّه سِرًّا، فقالَ: {رَبِّ إِنِّي وَهَنَ الْعَظْمُ مِنِّي وَاشْتَعَلَ الرَّأْسُ شَيْبًا وَلَمْ أَكُنْ بِدُعَائِكَ رَبِّ شَقِيًّا (4) وَإِنِّي خِفْتُ الْمَوَالِيَ مِنْ وَرَائِي}، وهُمُ العَصَبةُ، {وَكَانَتِ امْرَأَتِي عَاقِرًا فَهَبْ لِي مِنْ لَدُنْكَ وَلِيًّا (5) يَرِثُنِي وَيَرِثُ مِنْ آلِ يَعْقُوب}، يقولُ: يرِثُ نُبوَّتي ونُبوَّةَ آلِ يَعْقوبَ، {وَاجْعَلْهُ رَبِّ رَضِيًّا} [مريم: 4 - 6]، وقولُه: {هَبْ لِي مِنْ لَدُنْكَ ذُرِّيَّةً طَيِّبَةً}، يقولُ: مَنازِلُه، {إِنَّكَ سَمِيعُ الدُّعَاءِ} [آل عمران: 38]، وقالَ: {رَبِّ لَا تَذَرْنِي فَرْدًا وَأَنْتَ خَيْرُ الْوَارِثِينَ} [الأنبياء: 89]، {فَنَادَتْهُ الْمَلَائِكَةُ} وهو جِبْريلُ، {وَهُوَ قَائِمٌ يُصَلِّي فِي الْمِحْرَابِ أَنَّ اللَّهَ يُبَشِّرُكَ} [آل عمران: 39]، {بِغُلَامٍ اسْمُهُ يَحْيَى لَمْ نَجْعَلْ لَهُ مِنْ قَبْلُ سَمِيًّا} [مريم: 7]، لم يُسَمَّ قبلَه أحَدٌ يَحْيى، وقالَتِ المَلائكةُ: {أَنَّ اللَّهَ يُبَشِّرُكَ بِيَحْيَى مُصَدِّقًا بِكَلِمَةٍ مِنَ اللَّهِ} يُصدِّقُ بعيسَى، {وَسَيِّدًا وَحَصُورًا} [آل عمران: 39]، والحَصورُ: الَّذي لا يُريدُ النِّساءَ، فلمَّا سمِعَ النِّداءَ جاءَه الشَّيطانُ فقالَ له: يا زكَريَّا، إنَّ الصَّوتَ الَّذي سمِعْتَ ليس منَ اللهِ، إنَّما هو منَ الشَّيطانِ سخِرَ بكَ، ولو كانَ منَ اللهِ أوْحاه إليكَ كما يوحِي إليكَ غَيرَه منَ الأمْرِ، فشَكَّ مَكانَه، وقالَ: {أَنَّى يَكُونُ لِي غُلَامٌ}، يقولُ: من أين؟ {وَقَدْ بَلَغَنِيَ الْكِبَرُ وَامْرَأَتِي عَاقِرٌ قَالَ كَذَلِكَ اللَّهُ يَفْعَلُ مَا يَشَاءُ} [آل عمران: 40]، {وَقَدْ خَلَقْتُكَ مِنْ قَبْلُ وَلَمْ تَكُ شَيْئًا} [مريم: 9].","narrator":"مرة وأبو مالك","source":"المستدرك على الصحيحين 4197","grade":"صحيح","judgment":"صحيح على شرط مسلم","url":"https://dorar.net/h/nYUn6mcO","nameForm":"خَيْرُ الْوَارِثِينَ","scene":"ابن عباس وابن مسعود يرويان دعاء زكريا سرًّا: شيخٌ وهن عظمه وامرأته عاقر، يخاف الموالي من ورائه، فيسأل وليًّا يرثه ويرث من آل يعقوب، ثم يقول: ﴿رَبِّ لَا تَذَرْنِي فَرْدًا وَأَنْتَ خَيْرُ الْوَارِثِينَ﴾ — فتناديه الملائكة وهو قائم يصلي في المحراب ببشارة يحيى.","reason":"زكريا يطلب وارثًا ثم يقول للموروث الأكبر: «وأنت خير الوارثين» — أي: إن لم ترزقني ولدًا فأنت الوارث الذي يرث ما أخافه عليه؛ فالاسم هنا تسليمٌ قبل الإجابة: طلبٌ للولد مع الرضا بأن الله خير من يرث. والنداء بالبشارة جاء بعد هذا التسليم مباشرةً في سياق الرواية.","adds":"يُري الشاهد أن الاسم يُقال مع طلب الذرية لا بدلًا منه: يطلب ويسلّم في نفسٍ واحد — وأن الإجابة جاءت لمن سلّم لخير الوارثين."}],"sunnah":{"card":"الصيغة: خَيْرُ الْوَارِثِينَ — مركّبة\nفي السنة: شاهد واحد (رواية واحدة)\nخصوصية الورود في السنة: ورد في بيان ابن عباس وابن مسعود لقصة زكريا — الشاهد نفسه الذي ورد فيه «سميع الدعاء» — إذ يجمعان دعاءه من ثلاث سور: ﴿رَبِّ لَا تَذَرْنِي فَرْدًا وَأَنْتَ خَيْرُ الْوَارِثِينَ﴾.\nالمعنى المختصر: الباقي بعد فناء الخلق، الذي يرث كل شيء وهو خير من يُترك له الأمر.","teaches":"1. أنه يرث ما تخاف عليه بعدك، فهو خير من تتركه له.\n2. أنه يجيب من طلب الولد راضيًا بأن الله وارثه.\n3. أن التسليم له لا يمنع الطلب منه.","whenRecall":"- حين تخاف على ما بعدك من مالٍ أو دين أو ولد.\n- حين تدعو بالذرية.\n- عند كبر السن وقلة الخلف.","whenPray":"عند الشعور بـ:\n1. الوحدة بلا خلف.\n2. الخوف على ما تتركه بعدك.\nعند طلب:\n1. الذرية.\n2. أن يتولى الله ما بعدك.\nعند الرغبة في:\n1. أن تطلب راضيًا كما طلب زكريا.","duaItems":"«رَبِّ لَا تَذَرْنِي فَرْدًا وَأَنْتَ خَيْرُ الْوَارِثِينَ» [الأنبياء: 89] — دعاء زكريا كما بيّنه ابن عباس وابن مسعود (المستدرك 4197 — صحيح على شرط مسلم).","summary":"«خير الوارثين» في السنة كلمة زكريا وهو يطلب الولد: يطلب وارثًا ويسلّم أن الله خير الوارثين — فجاءه النداء بيحيى."},"situations":[{"situationId":11,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"القلق على ما تتركه بعدك ومن يخلفك فيه","bridge":"تقلق على ما بعدك؟ الذي خافه زكريا على الموالي من ورائه ردّه إلى «خير الوارثين» — ما تتركه لا يضيع عند من يرث الأرض ومن عليها."}]},{"situationId":51,"verses":[{"i":1,"strength":"direct","headline":"تأخر الذرية والخوف من البقاء فردًا بلا وارث","bridge":"تنتظر ولدًا تأخر؟ زكريا نادى بأرقّ صيغة: ﴿رَبِّ لَا تَذَرْنِي فَرْدًا وَأَنْتَ خَيْرُ الْوَارِثِينَ﴾ — طلبٌ مع رضًا مسبق بالحرمان؛ فجاءت الإجابة أوسع من السؤال: وُهب يحيى وأُصلحت له زوجه العاقر — عولج السبب نفسه لا النتيجة فقط."}],"hadiths":[]}]},{"id":40,"name":"خير حافظا","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: خَيْرٌ حَافِظًا — صيغة تفضيل | المواضع: 1 (يوسف: 64)\nخصوصية: من قول يعقوب عليه السلام عند إرساله بنيامين — بعد أن جرّب انخرام الحفظ البشري في يوسف — فهو اسمُ من يودّع من يحب.\n\nالمعنى:\n- خير حافظًا: أفضلُ من يحفظ — حفظُه لا تخرقه الأسباب، ولا تنام عينُه، ولا يشغله محفوظٌ عن محفوظ.","teaches":"الحقائق التي كشفها الموضع:\n1. حذرُك لا يحفظ من تحب — الحافظ الله: فافعل السبب وأودِع القلبَ عنده.\n2. الجرح القديم لا يبرر تعطيل الحياة: يعقوب أرسل الثاني رغم فقد الأول.\n3. حفظُه مقرون برحمته: ﴿خَيْرٌ حَافِظًا وَهُوَ أَرْحَمُ الرَّاحِمِينَ﴾.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند سفر الأبناء وغيابهم عن عينك.\n- عند العجز عن حماية من تحب: مريضٍ أو بعيدٍ أو مسافر.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. عند توديع الأهل والأبناء: ﴿فَاللَّهُ خَيْرٌ حَافِظًا وَهُوَ أَرْحَمُ الرَّاحِمِينَ﴾ — يوسف 64.\n2. من السنة عند التوديع: «أَسْتَوْدِعُ اللَّهَ دِينَكَ وَأَمَانَتَكَ وَخَوَاتِيمَ عَمَلِكَ» — رواه أبو داود والترمذي وصححه الألباني.\n3. تفويض حفظ من لا تصل إليه يدك — مع فعل ما تقدر عليه من الأسباب كما فعل يعقوب.","summary":"حَذَرُ يعقوب الأول لم يحفظ يوسف — فقالها في الثانية: ﴿فَاللَّهُ خَيْرٌ حَافِظًا﴾: افعل أسبابك، ثم أودِع من تحب عند من لا ينام حفظُه.","verses":[{"i":1,"of":1,"s":12,"surah":"يوسف","a":64,"text":"قَالَ هَلْ آمَنُكُمْ عَلَيْهِ إِلَّا كَمَا أَمِنْتُكُمْ عَلَى أَخِيهِ مِنْ قَبْلُ فَاللَّهُ خَيْرٌ حَافِظًا وَهُوَ أَرْحَمُ الرَّاحِمِينَ","prev":{"a":63,"text":"فَلَمَّا رَجَعُوا إِلَى أَبِيهِمْ قَالُوا يَا أَبَانَا مُنِعَ مِنَّا الْكَيْلُ فَأَرْسِلْ مَعَنَا أَخَانَا نَكْتَلْ وَإِنَّا لَهُ لَحَافِظُونَ"},"next":{"a":65,"text":"وَلَمَّا فَتَحُوا مَتَاعَهُمْ وَجَدُوا بِضَاعَتَهُمْ رُدَّتْ إِلَيْهِمْ قَالُوا يَا أَبَانَا مَا نَبْغِي هَذِهِ بِضَاعَتُنَا رُدَّتْ إِلَيْنَا وَنَمِيرُ أَهْلَنَا وَنَحْفَظُ أَخَانَا وَنَزْدَادُ كَيْلَ بَعِيرٍ ذَلِكَ كَيْلٌ يَسِيرٌ"},"context":"طُلب من يعقوب إرسال بنيامين مع إخوته — والجرح القديم حاضر: ﴿هَلْ آمَنُكُمْ عَلَيْهِ إِلَّا كَمَا أَمِنْتُكُمْ عَلَى أَخِيهِ مِنْ قَبْلُ﴾ — ثم حسم: ﴿فَاللَّهُ خَيْرٌ حَافِظًا وَهُوَ أَرْحَمُ الرَّاحِمِينَ﴾. ومع ذلك أخذ الموثقَ وأمرهم ألا يدخلوا من بابٍ واحد.","reason":"نقل يعقوبُ الحفظَ من البشر إلى الله: حَذَرُه الأول لم يحفظ يوسف — فتعلّم أن الحفظ البشري أسبابٌ تنخرم، وحفظَ الله لا يُخترق. لكنه لم يترك الأسباب: موثقٌ ووصيةُ الأبواب — فجمع الكمالَ: فعلُ السبب وتعليقُ القلب بخير الحافظين، وقرنه بأرحم الراحمين: يحفظ برحمةٍ لا بمجرد قدرة.","adds":"التجربة المرة لم تمنعه التوكلَ مجددًا — وقد رُدّ إليه الاثنان معًا: يوسفُ وبنيامين، جزاءَ توكلٍ لم تكسره الفجيعة الأولى."}],"hadiths":[],"situations":[{"situationId":11,"verses":[{"i":1,"strength":"direct","headline":"القلق على الأبناء والعجز عن حمايتهم","bridge":"قلقٌ على أبنائك؟ يعقوب فقد يوسف بحذره الأول، فلما طُلب منه بنيامين لم يقل «لن أرسله»، بل: ﴿فَاللَّهُ خَيْرٌ حَافِظًا وَهُوَ أَرْحَمُ الرَّاحِمِينَ﴾ — ومع ذلك أخذ الموثق وأوصى بالأبواب؛ افعل السبب لأبنائك وعلّق قلبك بخير الحافظين لا بالسبب."}],"hadiths":[]}]},{"id":41,"name":"متم نوره","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: مُتِمُّ نُورِهِ — مضافة بصيغة اسم الفاعل | المواضع: 1 (الصف: 8)\nخصوصية: جاءت في مقابلةٍ ساخرة من محاولة مستحيلة: أفواهٌ تنفخ لإطفاء نور الله.\n\nالمعنى:\n- متم نوره: الذي يُكمل نورَه — دينَه ووحيَه وحجتَه — إتمامًا لا يوقفه معارض؛ وصيغة اسم الفاعل تفيد الثبات والدوام: الإتمام صفةٌ جارية لا وعدٌ مؤجل فقط.","teaches":"الحقائق التي كشفها الموضع:\n1. معركة النور محسومة سلفًا — والإتمام صفة جارية لا وعدٌ بعيد.\n2. أدوات خصوم الدين «أفواه»: كلام وتشويه — وهي أعجز من مهمتها.\n3. كراهية الكارهين لا تدخل في معادلة الإتمام أصلًا.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند حملات التشويه والسخرية من الدين في الإعلام.\n- عند شعورك أن الباطل يعلو صوته: الصوت نفخٌ والنور باقٍ.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. سؤال أن تكون من جند إتمام النور لا من المتفرجين — الصف 8–9.\n2. الثبات وقت ضجيج الحملات على الدين: فالنتيجة معلنة.\n3. من السنة — دعاء النور: «اللَّهُمَّ اجْعَلْ فِي قَلْبِي نُورًا وَفِي بَصَرِي نُورًا وَفِي سَمْعِي نُورًا...» — متفق عليه: اطلب نصيبك من النور الذي يتمّه.","summary":"يجمعون أفواههم لإطفاء شمس: ﴿وَاللَّهُ مُتِمُّ نُورِهِ وَلَوْ كَرِهَ الْكَافِرُونَ﴾ — فاعمل في جانب النور: النتيجة محسومة قبل أن تبدأ المعركة.","verses":[{"i":1,"of":1,"s":61,"surah":"الصف","a":8,"text":"يُرِيدُونَ لِيُطْفِئُوا نُورَ اللَّهِ بِأَفْوَاهِهِمْ وَاللَّهُ مُتِمُّ نُورِهِ وَلَوْ كَرِهَ الْكَافِرُونَ","prev":{"a":7,"text":"وَمَنْ أَظْلَمُ مِمَّنِ افْتَرَى عَلَى اللَّهِ الْكَذِبَ وَهُوَ يُدْعَى إِلَى الْإِسْلَامِ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ"},"next":{"a":9,"text":"هُوَ الَّذِي أَرْسَلَ رَسُولَهُ بِالْهُدَى وَدِينِ الْحَقِّ لِيُظْهِرَهُ عَلَى الدِّينِ كُلِّهِ وَلَوْ كَرِهَ الْمُشْرِكُونَ"},"context":"سورة الصف تسوق شاهدًا تاريخيًّا متكررًا: عيسى ابن مريم يقف في بني إسرائيل معرّفًا بنفسه ومبشّرًا بمن بعده — ﴿وَمُبَشِّرًا بِرَسُولٍ يَأْتِي مِنْ بَعْدِي اسْمُهُ أَحْمَدُ﴾ — فلما جاءهم بالبينات كان الجواب: ﴿هَذَا سِحْرٌ مُبِينٌ﴾. وهكذا في كل عصر: بيّناتٌ تُقابَل بتهمةٍ جاهزة، وافتراءٌ على الله ممن يُدعى إلى الإسلام. ثم تُرسم الصورة التي تلخّص المعركة كلها: ﴿يُرِيدُونَ لِيُطْفِئُوا نُورَ اللَّهِ بِأَفْوَاهِهِمْ﴾ — أفواهٌ تنفخ لتطفئ نورًا يملأ السماوات والأرض؛ صورةٌ تفضح صاحبها قبل أن تُردّ عليه. ويأتي الجواب في شطر الآية الثاني بلا جدال: ﴿وَاللَّهُ مُتِمُّ نُورِهِ وَلَوْ كَرِهَ الْكَافِرُونَ﴾. ثم تفصّل الآية التالية كيف يتم النور: ﴿هُوَ الَّذِي أَرْسَلَ رَسُولَهُ بِالْهُدَى وَدِينِ الْحَقِّ لِيُظْهِرَهُ عَلَى الدِّينِ كُلِّهِ﴾.","reason":"قابلت الآيةُ إرادةَ الإطفاء ﴿يُرِيدُونَ﴾ باسم الفاعل الثابت ﴿مُتِمُّ نُورِهِ﴾ — والصورة نفسها تفضح العبث: أفواهٌ تنفخ في نورٍ كوني! فأدواتُ الإطفاء كلامٌ وإعلامٌ وتشويه، وأداةُ الإتمام إرادةُ الله — والنتيجة محسومة: ﴿وَلَوْ كَرِهَ الْكَافِرُونَ﴾: لا يتوقف الإتمام على رضا أحد.","adds":"كل حملات التشويه على هذا الدين عبر التاريخ نفخٌ في النور — ازداد به اشتعالًا: فاعمل في صفّ النور مطمئنًا إلى نتيجةٍ أعلنها متمُّ النور بنفسه."}],"hadiths":[],"situations":[{"situationId":107,"verses":[{"i":1,"strength":"direct","headline":"شبهاتٌ وطعونٌ تُلقى على الدين","bridge":"طعنٌ في الدين يُلقى عليك؟ انظر إلى صورة الآية: أفواهٌ تنفخ في نورٍ كوني — ﴿يُرِيدُونَ لِيُطْفِئُوا نُورَ اللَّهِ بِأَفْوَاهِهِمْ وَاللَّهُ مُتِمُّ نُورِهِ﴾ — كل حملات التشويه عبر التاريخ نفخٌ في النور ازداد به اشتعالًا؛ فرُدّ الشبهة بعلم، ولا تخف على النور."}],"hadiths":[]}]},{"id":42,"name":"ذو الفضل العظيم","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: ذُو الْفَضْلِ الْعَظِيمِ — مضافة | المواضع: 7 (البقرة: 105 — آل عمران: 74، 174 — الأنفال: 29 — الحديد: 21، 29 — الجمعة: 4)\nخصوصية: تتكرر الصيغة غالبًا في سياقٍ واحد: الردُّ على من ظنّ احتكار الفضل (حسد أهل الكتاب)، وتقريرُ القاعدة: ﴿ذَلِكَ فَضْلُ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ﴾.\n\nالمعنى:\n- ذو الفضل العظيم: صاحب العطاء الزائد عن الاستحقاق والمعاوضة — يعطي ابتداءً بلا موجِب، ويزيد فوق الجزاء بلا حساب.\n\nملاحظة على الصيغ: ستة مواضع بالتعريف ﴿ذُو الْفَضْلِ الْعَظِيمِ﴾، وموضعٌ واحد بالتنكير ﴿ذُو فَضْلٍ عَظِيمٍ﴾ [آل عمران: 174] — والتنكير للتعظيم والتنويع.","teaches":"الحقائق التي كشفتها المواضع:\n1. الفضل بيده وحده: لا يحتكره قومٌ ولا يمنعه حاسد ولا يقدر عليه أحد.\n2. الجنة نفسها «فضل» لا أجرة معادلة — فسابق بلا عُجب.\n3. التقوى تفتح الفرقان والتكفير والمغفرة — زيادةً فوق الجزاء.\n4. بعثة النبي الأمي في الأميين الشاهد الأكبر على الفضل المحض.","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- عند شعورك بحسد الحاسدين على نعمتك.\n- عند رؤية نعم الله على من لا «يستحقها» بمقاييسك: الفضل ليس بمقاييسك.\n- عند اشتباه الأمور وحاجتك إلى فرقان.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. سؤال الفضل مباشرةً — وقد أمر به القرآن: ﴿وَاسْأَلُوا اللَّهَ مِنْ فَضْلِهِ﴾.\n2. عند الحسد: الاطمئنان بأن مصدر النعمة ليس بيد الحاسد — البقرة 105.\n3. سؤال الفرقان بالتقوى عند اشتباه الأمور — الأنفال 29.\n4. المسابقة إلى المغفرة والجنة — الحديد 21.\n5. شكر فضل البعثة والهداية التي لم تسبقها أهلية — الجمعة 4.","summary":"قاعدةٌ كررها ستًّا: ﴿ذَلِكَ فَضْلُ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ﴾ — فلا حاسدٌ يمنع ولا محتكرٌ يحجب ولا عملٌ يوازي: فاسأل من فضله وسابق.","verses":[{"i":1,"of":7,"s":2,"surah":"البقرة","a":105,"text":"مَا يَوَدُّ الَّذِينَ كَفَرُوا مِنْ أَهْلِ الْكِتَابِ وَلَا الْمُشْرِكِينَ أَنْ يُنَزَّلَ عَلَيْكُمْ مِنْ خَيْرٍ مِنْ رَبِّكُمْ وَاللَّهُ يَخْتَصُّ بِرَحْمَتِهِ مَنْ يَشَاءُ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ","prev":{"a":104,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَقُولُوا رَاعِنَا وَقُولُوا انْظُرْنَا وَاسْمَعُوا وَلِلْكَافِرِينَ عَذَابٌ أَلِيمٌ"},"next":{"a":106,"text":"مَا نَنْسَخْ مِنْ آيَةٍ أَوْ نُنْسِهَا نَأْتِ بِخَيْرٍ مِنْهَا أَوْ مِثْلِهَا أَلَمْ تَعْلَمْ أَنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},"reason":"حسدُ الحاسدين لا يدخل في معادلة العطاء: هم لا يودّون أن ينزل عليكم خير — لكن الاختصاص بيد ذي الفضل وحده، فلا يملك حاسدٌ منعَ فضلٍ ولا حجبَ خير. فذكرُ الاسم هنا إبطالٌ لسلطة الحسد.","adds":"إذا أحسّ قلبك بثقل حسد الحاسدين على نعمتك: تذكّر أن مصدرها ليس بأيديهم — ﴿وَاللَّهُ يَخْتَصُّ بِرَحْمَتِهِ مَنْ يَشَاءُ﴾."},{"i":2,"of":7,"s":3,"surah":"آل عمران","a":74,"text":"يَخْتَصُّ بِرَحْمَتِهِ مَنْ يَشَاءُ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ","prev":{"a":73,"text":"وَلَا تُؤْمِنُوا إِلَّا لِمَنْ تَبِعَ دِينَكُمْ قُلْ إِنَّ الْهُدَى هُدَى اللَّهِ أَنْ يُؤْتَى أَحَدٌ مِثْلَ مَا أُوتِيتُمْ أَوْ يُحَاجُّوكُمْ عِنْدَ رَبِّكُمْ قُلْ إِنَّ الْفَضْلَ بِيَدِ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ"},"next":{"a":75,"text":"وَمِنْ أَهْلِ الْكِتَابِ مَنْ إِنْ تَأْمَنْهُ بِقِنْطَارٍ يُؤَدِّهِ إِلَيْكَ وَمِنْهُمْ مَنْ إِنْ تَأْمَنْهُ بِدِينَارٍ لَا يُؤَدِّهِ إِلَيْكَ إِلَّا مَا دُمْتَ عَلَيْهِ قَائِمًا ذَلِكَ بِأَنَّهُمْ قَالُوا لَيْسَ عَلَيْنَا فِي الْأُمِّيِّينَ سَبِيلٌ وَيَقُولُونَ عَلَى اللَّهِ الْكَذِبَ وَهُمْ يَعْلَمُونَ"},"context":"في سياق قول أهل الكتاب ﴿لَا تُؤْمِنُوا إِلَّا لِمَنْ تَبِعَ دِينَكُمْ﴾ جاء الرد: ﴿قُلْ إِنَّ الْفَضْلَ بِيَدِ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ﴾ ثم: ﴿يَخْتَصُّ بِرَحْمَتِهِ مَنْ يَشَاءُ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ﴾.","reason":"ادّعى قومٌ احتكارَ الهدى والنبوة وراثةً قومية — فنُقض الادعاء بالاسم: الفضلُ بيد ذي الفضل لا بيد الأقوام، يختص برحمته من يشاء بحكمته لا بأنسابهم. فالنبوةُ والهداية اختصاصُ فضلٍ لا ميراثُ عرق.","adds":"يكسر كل احتكارٍ للدين والهدى باسم طائفةٍ أو عرقٍ أو جماعة — الفضل بيده يضعه حيث يشاء."},{"i":3,"of":7,"s":3,"surah":"آل عمران","a":174,"text":"فَانْقَلَبُوا بِنِعْمَةٍ مِنَ اللَّهِ وَفَضْلٍ لَمْ يَمْسَسْهُمْ سُوءٌ وَاتَّبَعُوا رِضْوَانَ اللَّهِ وَاللَّهُ ذُو فَضْلٍ عَظِيمٍ","prev":{"a":173,"text":"الَّذِينَ قَالَ لَهُمُ النَّاسُ إِنَّ النَّاسَ قَدْ جَمَعُوا لَكُمْ فَاخْشَوْهُمْ فَزَادَهُمْ إِيمَانًا وَقَالُوا حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ"},"next":{"a":175,"text":"إِنَّمَا ذَلِكُمُ الشَّيْطَانُ يُخَوِّفُ أَوْلِيَاءَهُ فَلَا تَخَافُوهُمْ وَخَافُونِ إِنْ كُنْتُمْ مُؤْمِنِينَ"},"context":"غداةَ أُحد — والجراح لم تجفّ بعد — خرج النبي ﷺ ومعه سبعون رجلًا في أثر قريش إلى حمراء الأسد، وهم مثخنون بما أصابهم بالأمس (صحيح البخاري 4077). وكان أبو سفيان قد واعدهم موسمَ بدر، وجاءهم من يقول: ﴿إِنَّ النَّاسَ قَدْ جَمَعُوا لَكُمْ فَاخْشَوْهُمْ﴾ — حربًا نفسية منظمة تُلقى على قومٍ منهكين. فكان الجواب على غير ما توقّع المرجفون: ﴿فَزَادَهُمْ إِيمَانًا وَقَالُوا حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ﴾. فخرجوا إلى الموعد فلم يجدوا به أحدًا ولم يقع قتال، ورجع القومُ سالمين وقد تسوّقوا فأصابوا تجارةً ربحوا فيها (مجمع الزوائد 6/124) — فاجتمع لهم أمران: نعمةٌ (السلامة) وفضلٌ (الربح).","reason":"جاءت الصيغة هنا نكرةً — ﴿ذُو فَضْلٍ عَظِيمٍ﴾ — والتنكير للتعظيم والتنويع: أي فضلٌ عظيمٌ لا يُحدّ بنوعٍ واحد. وناسب المقام أن يُختم بالفضل لأن ما نالوه لم يكن بحولهم: خرجوا جرحى فرجعوا سالمين رابحين — فليس ذلك عن قوةٍ أظهروها بل فضلٌ ساقه الله إليهم. ولاحظ ترتيب الآية: ﴿بِنِعْمَةٍ مِنَ اللَّهِ وَفَضْلٍ﴾ — نعمةُ السلامة أولًا ثم فضلُ الزيادة؛ فالفضلُ ما زاد على السلامة.","adds":"يضيف الوجه العملي للاسم في ساعة الخوف: الفضل العظيم ينزل على من واجه التخويف بكلمة ﴿حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ﴾ — فليس الفضل لمن قعد بل لمن خرج وهو جريح. وفيه أن مصدر التخويف مكشوف: ﴿إِنَّمَا ذَلِكُمُ الشَّيْطَانُ يُخَوِّفُ أَوْلِيَاءَهُ﴾ — فالحملة النفسية صناعةٌ شيطانية، وجوابُها كلمةُ التوكل لا التحليل الطويل.","dorar":[{"id":"OXdwmQiR","label":"صحيح البخاري 4077"},{"id":"ZwSnBKE8","label":"مجمع الزوائد 6/124"},{"id":"N9qUzGV9","label":"الدر المنثور 4/139"}]},{"i":4,"of":7,"s":8,"surah":"الأنفال","a":29,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ تَتَّقُوا اللَّهَ يَجْعَلْ لَكُمْ فُرْقَانًا وَيُكَفِّرْ عَنْكُمْ سَيِّئَاتِكُمْ وَيَغْفِرْ لَكُمْ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ","prev":{"a":28,"text":"وَاعْلَمُوا أَنَّمَا أَمْوَالُكُمْ وَأَوْلَادُكُمْ فِتْنَةٌ وَأَنَّ اللَّهَ عِنْدَهُ أَجْرٌ عَظِيمٌ"},"next":{"a":30,"text":"وَإِذْ يَمْكُرُ بِكَ الَّذِينَ كَفَرُوا لِيُثْبِتُوكَ أَوْ يَقْتُلُوكَ أَوْ يُخْرِجُوكَ وَيَمْكُرُونَ وَيَمْكُرُ اللَّهُ وَاللَّهُ خَيْرُ الْمَاكِرِينَ"},"reason":"على تقوى واحدةٍ ثلاثُ عطايا: فرقانٌ — نورٌ في القلب يفرق به بين الحق والباطل عند اشتباه الأمور — وتكفيرٌ ومغفرة. والزيادةُ على قدر العمل هي «الفضل العظيم»: فالتقوى لا تشتري هذا كله بثمنها، لكن ذا الفضل يضاعف.","adds":"أثمن أدوات القرار في حياتك — «الفرقان» الذي تميز به عند الاشتباه — ثمنه التقوى لا الذكاء."},{"i":5,"of":7,"s":57,"surah":"الحديد","a":21,"text":"سَابِقُوا إِلَى مَغْفِرَةٍ مِنْ رَبِّكُمْ وَجَنَّةٍ عَرْضُهَا كَعَرْضِ السَّمَاءِ وَالْأَرْضِ أُعِدَّتْ لِلَّذِينَ آمَنُوا بِاللَّهِ وَرُسُلِهِ ذَلِكَ فَضْلُ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ","prev":{"a":20,"text":"اعْلَمُوا أَنَّمَا الْحَيَاةُ الدُّنْيَا لَعِبٌ وَلَهْوٌ وَزِينَةٌ وَتَفَاخُرٌ بَيْنَكُمْ وَتَكَاثُرٌ فِي الْأَمْوَالِ وَالْأَوْلَادِ كَمَثَلِ غَيْثٍ أَعْجَبَ الْكُفَّارَ نَبَاتُهُ ثُمَّ يَهِيجُ فَتَرَاهُ مُصْفَرًّا ثُمَّ يَكُونُ حُطَامًا وَفِي الْآخِرَةِ عَذَابٌ شَدِيدٌ وَمَغْفِرَةٌ مِنَ اللَّهِ وَرِضْوَانٌ وَمَا الْحَيَاةُ الدُّنْيَا إِلَّا مَتَاعُ الْغُرُورِ"},"next":{"a":22,"text":"مَا أَصَابَ مِنْ مُصِيبَةٍ فِي الْأَرْضِ وَلَا فِي أَنْفُسِكُمْ إِلَّا فِي كِتَابٍ مِنْ قَبْلِ أَنْ نَبْرَأَهَا إِنَّ ذَلِكَ عَلَى اللَّهِ يَسِيرٌ"},"reason":"سُميت الجنةُ — بعرض السماء والأرض — «فضلًا»: فهي ليست أجرةً معادلةً للعمل، إذ لا عملَ يوازيها، بل فضلٌ فوق الجزاء. والمضمار مفتوح بأمر: ﴿سَابِقُوا﴾ — فالجائزة فضلٌ والسباق متاح للجميع.","adds":"اجمع بين الحقيقتين: اعمل وسابق بكل ما تملك — واعلم أن الجائزة فضلٌ لا أجرة: فتسقط العُجب ويبقى السعي."},{"i":6,"of":7,"s":57,"surah":"الحديد","a":29,"text":"لِئَلَّا يَعْلَمَ أَهْلُ الْكِتَابِ أَلَّا يَقْدِرُونَ عَلَى شَيْءٍ مِنْ فَضْلِ اللَّهِ وَأَنَّ الْفَضْلَ بِيَدِ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ","prev":{"a":28,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَآمِنُوا بِرَسُولِهِ يُؤْتِكُمْ كِفْلَيْنِ مِنْ رَحْمَتِهِ وَيَجْعَلْ لَكُمْ نُورًا تَمْشُونَ بِهِ وَيَغْفِرْ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ"},"context":"خاتمة الحديد: ﴿لِئَلَّا يَعْلَمَ أَهْلُ الْكِتَابِ أَلَّا يَقْدِرُونَ عَلَى شَيْءٍ مِنْ فَضْلِ اللَّهِ وَأَنَّ الْفَضْلَ بِيَدِ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ﴾.","reason":"التقرير النهائي لمركزية الفضل: لا يقدر أحدٌ — كائنًا من كان — على شيءٍ من فضل الله منعًا أو منحًا؛ فالخزائن بيدٍ واحدة. وبهذا خُتمت سورةُ الحديد التي فصّلت مراتب الإنفاق والسبق.","adds":"حرر تعلقك: من لا يملك من فضل الله شيئًا لا يستحق أن تخافه على رزقك أو ترجوه فيه."},{"i":7,"of":7,"s":62,"surah":"الجمعة","a":4,"text":"ذَلِكَ فَضْلُ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ","prev":{"a":3,"text":"وَآخَرِينَ مِنْهُمْ لَمَّا يَلْحَقُوا بِهِمْ وَهُوَ الْعَزِيزُ الْحَكِيمُ"},"next":{"a":5,"text":"مَثَلُ الَّذِينَ حُمِّلُوا التَّوْرَاةَ ثُمَّ لَمْ يَحْمِلُوهَا كَمَثَلِ الْحِمَارِ يَحْمِلُ أَسْفَارًا بِئْسَ مَثَلُ الْقَوْمِ الَّذِينَ كَذَّبُوا بِآيَاتِ اللَّهِ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ"},"context":"﴿هُوَ الَّذِي بَعَثَ فِي الْأُمِّيِّينَ رَسُولًا مِنْهُمْ يَتْلُو عَلَيْهِمْ آيَاتِهِ وَيُزَكِّيهِمْ وَيُعَلِّمُهُمُ الْكِتَابَ وَالْحِكْمَةَ وَإِنْ كَانُوا مِنْ قَبْلُ لَفِي ضَلَالٍ مُبِينٍ﴾ — ثم: ﴿ذَلِكَ فَضْلُ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ﴾.","reason":"شاهدٌ جليّ للفضل: أمةٌ أمّية في ضلالٍ مبين تُختار لحمل الرسالة الخاتمة — لا سابقةَ استحقاقٍ ولا مؤهلاتِ حضارة، بل اختصاصُ فضلٍ محض. فبعثةُ النبي ﷺ فيهم هي الفضل المشار إليه: ﴿ذَلِكَ فَضْلُ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ﴾.","adds":"أنت فردٌ من أمةٍ قامت على الفضل المحض — فاعرف قدر نعمةٍ لم تسبقها أهلية."}],"hadiths":[],"situations":[{"situationId":14,"verses":[{"i":4,"strength":"direct","headline":"الحيرة بين خياراتٍ مشتبهة قبل اتخاذ القرار","bridge":"أمامك خيارات مشتبهة ولا تعرف أصوبها؟ أثمن أداة قرارٍ ثمنها التقوى لا الذكاء: ﴿إِنْ تَتَّقُوا اللَّهَ يَجْعَلْ لَكُمْ فُرْقَانًا وَيُكَفِّرْ عَنْكُمْ سَيِّئَاتِكُمْ وَيَغْفِرْ لَكُمْ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ﴾ — الفرقان نورٌ في القلب يفرق بين الحق والباطل عند الاشتباه؛ فاتقِ يُعطَ لك."}],"hadiths":[]},{"situationId":33,"verses":[{"i":3,"strength":"direct","headline":"مواجهة التخويف بالتوكل ورجاء فضل الله بعده","bridge":"خوّفوك بجمعٍ اجتمع عليك؟ الذين قيل لهم إن الناس قد جمعوا لكم قالوا حسبنا الله ونعم الوكيل ﴿فَانْقَلَبُوا بِنِعْمَةٍ مِنَ اللَّهِ وَفَضْلٍ لَمْ يَمْسَسْهُمْ سُوءٌ وَاتَّبَعُوا رِضْوَانَ اللَّهِ وَاللَّهُ ذُو فَضْلٍ عَظِيمٍ﴾ — جاءت الصيغة منكّرة هنا للتعظيم؛ فالفضل العظيم ينزل على من واجه التخويف بالحسبنة."}],"hadiths":[]},{"situationId":41,"verses":[{"i":6,"strength":"direct","headline":"الخوف على الرزق من منافسٍ أو رجاؤه من ذي نفوذ","bridge":"تخاف على رزقك من منافسٍ أو ترجوه من صاحب نفوذ؟ ﴿أَلَّا يَقْدِرُونَ عَلَى شَيْءٍ مِنْ فَضْلِ اللَّهِ﴾ — لا يقدر أحدٌ كائنًا من كان على منعٍ ولا منح؛ فحرر تعلقك: من لا يملك من فضل الله شيئًا لا يستحق أن تقارن نفسك به ولا أن تخافه."}],"hadiths":[]},{"situationId":82,"verses":[{"i":5,"strength":"direct","headline":"العُجب بالعمل ورؤية استحقاق الجنة به","bridge":"تعجب بعملك وتراه يستحق الجنة؟ الجنة بعرض السماء والأرض سُميت فضلًا لا أجرة: ﴿سَابِقُوا إِلَى مَغْفِرَةٍ مِنْ رَبِّكُمْ وَجَنَّةٍ عَرْضُهَا كَعَرْضِ السَّمَاءِ وَالْأَرْضِ... ذَلِكَ فَضْلُ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ﴾ — لا عمل يوازيها؛ فاجمع الحقيقتين: سابق بكل ما تملك، واعلم أن الجائزة فضلٌ، فيسقط العجب ويبقى السعي."}],"hadiths":[]},{"situationId":84,"verses":[{"i":1,"strength":"direct","headline":"ضيق الصدر بنعمةٍ يراها عند غيره","bridge":"يضيق صدرك بنعمةٍ عند غيرك؟ اعكس الآية على نفسك: الكفار لم يودّوا أن ينزل عليكم خير ﴿وَاللَّهُ يَخْتَصُّ بِرَحْمَتِهِ مَنْ يَشَاءُ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ﴾ — فكما لا يملك حاسدٌ منع فضلٍ عنك، لا يملك حسدك حجب فضلٍ عن غيرك؛ لا يضرّ إلا قلبك."},{"i":2,"strength":"direct","headline":"ظنّ أن غيرك أولى بفضل الله لنسبه أو مكانته","bridge":"تحسب أن غيرك أولى منك بما ناله؟ قومٌ ادّعوا احتكار الهدى وراثة، فنُقض بالاسم: ﴿قُلْ إِنَّ الْفَضْلَ بِيَدِ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ... وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ﴾ — الفضل بيده لا بيد الأقوام ولا الأنساب ولا الاستحقاق المتوهَّم؛ فلا تقس رزقك برزق أحدٍ، فالمقسِّم واحد."}],"hadiths":[]},{"situationId":143,"verses":[{"i":7,"strength":"direct","headline":"نسيان أعظم النعم وأنها فضلٌ بلا استحقاق","bridge":"تشكر نعمًا وتنسى أعظمها؟ أنت فردٌ من أمةٍ أمّية في ضلالٍ مبين اختيرت لحمل الرسالة الخاتمة بلا سابقة استحقاق: ﴿ذَلِكَ فَضْلُ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ﴾ — بعثة النبي ﷺ فيك فضلٌ محض لم تسبقه أهلية؛ فاعرف قدر نعمةٍ قامت على الفضل."}],"hadiths":[]}]},{"id":43,"name":"القدير","compound":false,"meaning":"بطاقة الاسم:\nالصيغة: قَدِيرًا / قَدِيرٌ / لَقَدِيرٌ — مفردة | المواضع: 5 (النساء: 133 — الحج: 39 — الفرقان: 54 — الشورى: 29 — الممتحنة: 7)\nخصوصية: مواضعه الخمسة تغطي خمسة ميادين للقدرة: استبدال الأمم، ونصر المظلومين، وإنشاء الأنساب من ماء، وجمع الخلائق للحشر، وقلب العداوة مودة.\n\nالمعنى:\n- القدير: التامّ القدرة الذي لا يعجزه ممكنٌ ولا يمتنع عليه مراد — صيغةُ مبالغةٍ من القادر.","teaches":"الحقائق التي كشفتها المواضع:\n1. لستَ ضرورة: يُذهبكم ويأتِ بآخرين — فالعمل له شرفٌ لك.\n2. نصر المظلوم مضمونٌ بقدرةٍ مؤكدة — وإن اختلت الموازين.\n3. القلوب والمشاعر ميدان قدرته كالأجرام: العداوة تنقلب مودة.\n4. البثّ المشهود برهانُ الجمع الموعود.","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- عند العجب بدورك ومكانتك.\n- عند ظلمٍ لا ناصر له ظاهرًا.\n- عند اليأس من تغيّر شخصٍ تحبه أو يعاديك.\n- عند النظر في تنوع الخلق والأنساب.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. للمظلوم: طلب النصر ممن هو على نصره لقدير — الحج 39.\n2. طلب تأليف قلبِ معادٍ أو جافٍ — الممتحنة 7.\n3. التواضع في العمل: «اللهم استعملنا ولا تستبدلنا» — النساء 133.\n4. من السنة: «اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ وَلَا مُعْطِيَ لِمَا مَنَعْتَ وَلَا يَنْفَعُ ذَا الْجَدِّ مِنْكَ الْجَدُّ» — متفق عليه.","summary":"خمسة ميادين لخصت قدرته: يستبدل الأمم، وينصر المظلوم، وينشئ الأنساب من ماء، ويجمع الخلائق، ويقلب العداوة مودة — فأيُّ بابٍ ضاق بك، فالقدير واحد.","verses":[{"i":1,"of":5,"s":4,"surah":"النساء","a":133,"text":"إِنْ يَشَأْ يُذْهِبْكُمْ أَيُّهَا النَّاسُ وَيَأْتِ بِآخَرِينَ وَكَانَ اللَّهُ عَلَى ذَلِكَ قَدِيرًا","prev":{"a":132,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَكَفَى بِاللَّهِ وَكِيلًا"},"next":{"a":134,"text":"مَنْ كَانَ يُرِيدُ ثَوَابَ الدُّنْيَا فَعِنْدَ اللَّهِ ثَوَابُ الدُّنْيَا وَالْآخِرَةِ وَكَانَ اللَّهُ سَمِيعًا بَصِيرًا"},"context":"﴿إِنْ يَشَأْ يُذْهِبْكُمْ أَيُّهَا النَّاسُ وَيَأْتِ بِآخَرِينَ وَكَانَ اللَّهُ عَلَى ذَلِكَ قَدِيرًا﴾ — خطابٌ للناس جميعًا.","reason":"قدرةُ الاستبدال الكامل: البشرية كلها قابلة للإذهاب والإتيان بغيرها بمجرد المشيئة — فليس أحدٌ ضرورةً لله، والعملُ له شرفٌ للعامل لا حاجةٌ للمعبود. الاسم هنا يضع الخلق في حجمهم الحقيقي.","adds":"دواء العُجب بالدور والمكانة: إن تعاظمتَ في عملٍ لله فتذكر — يُذهبكم ويأتِ بآخرين."},{"i":2,"of":5,"s":22,"surah":"الحج","a":39,"text":"أُذِنَ لِلَّذِينَ يُقَاتَلُونَ بِأَنَّهُمْ ظُلِمُوا وَإِنَّ اللَّهَ عَلَى نَصْرِهِمْ لَقَدِيرٌ","prev":{"a":38,"text":"إِنَّ اللَّهَ يُدَافِعُ عَنِ الَّذِينَ آمَنُوا إِنَّ اللَّهَ لَا يُحِبُّ كُلَّ خَوَّانٍ كَفُورٍ"},"next":{"a":40,"text":"الَّذِينَ أُخْرِجُوا مِنْ دِيَارِهِمْ بِغَيْرِ حَقٍّ إِلَّا أَنْ يَقُولُوا رَبُّنَا اللَّهُ وَلَوْلَا دَفْعُ اللَّهِ النَّاسَ بَعْضَهُمْ بِبَعْضٍ لَهُدِّمَتْ صَوَامِعُ وَبِيَعٌ وَصَلَوَاتٌ وَمَسَاجِدُ يُذْكَرُ فِيهَا اسْمُ اللَّهِ كَثِيرًا وَلَيَنْصُرَنَّ اللَّهُ مَنْ يَنْصُرُهُ إِنَّ اللَّهَ لَقَوِيٌّ عَزِيزٌ"},"context":"أول آيةٍ نزلت في الإذن بالقتال (المستدرك على الصحيحين 2411): ﴿أُذِنَ لِلَّذِينَ يُقَاتَلُونَ بِأَنَّهُمْ ظُلِمُوا وَإِنَّ اللَّهَ عَلَى نَصْرِهِمْ لَقَدِيرٌ﴾.","reason":"قُرن الإذنُ الأول للمظلومين بضمانة مؤكدة باللام: ﴿لَقَدِيرٌ﴾ على نصرهم — فالمستضعفون المأذون لهم بعد سنين الصبر يحتاجون قبل السلاح يقينًا بقدرة الناصر. فالإذن تكليف، والاسم ضمان.","adds":"لكل مظلومٍ يتحرك لرفع ظلمه بحق: تحرّك بيقين — فناصرُك قديرٌ على نصرك وإن اختل ميزان القوى.","dorar":[{"id":"rKg21xNW","label":"المستدرك على الصحيحين 2411"}]},{"i":3,"of":5,"s":25,"surah":"الفرقان","a":54,"text":"وَهُوَ الَّذِي خَلَقَ مِنَ الْمَاءِ بَشَرًا فَجَعَلَهُ نَسَبًا وَصِهْرًا وَكَانَ رَبُّكَ قَدِيرًا","prev":{"a":53,"text":"وَهُوَ الَّذِي مَرَجَ الْبَحْرَيْنِ هَذَا عَذْبٌ فُرَاتٌ وَهَذَا مِلْحٌ أُجَاجٌ وَجَعَلَ بَيْنَهُمَا بَرْزَخًا وَحِجْرًا مَحْجُورًا"},"next":{"a":55,"text":"وَيَعْبُدُونَ مِنْ دُونِ اللَّهِ مَا لَا يَنْفَعُهُمْ وَلَا يَضُرُّهُمْ وَكَانَ الْكَافِرُ عَلَى رَبِّهِ ظَهِيرًا"},"reason":"من ماءٍ واحدٍ مهين خرجت شبكةُ الأنساب والأصهار التي تملأ الأرض: قبائل وعائلات وأرحام ومصاهرات — قدرةُ التنويع من أصلٍ واحد. فعائلتك وقراباتك كلها أثرُ هذه القدرة الجارية.","adds":"انظر إلى شجرة عائلتك: كل هذا التشابك من ماء — ﴿وَكَانَ رَبُّكَ قَدِيرًا﴾."},{"i":4,"of":5,"s":42,"surah":"الشورى","a":29,"text":"وَمِنْ آيَاتِهِ خَلْقُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَثَّ فِيهِمَا مِنْ دَابَّةٍ وَهُوَ عَلَى جَمْعِهِمْ إِذَا يَشَاءُ قَدِيرٌ","prev":{"a":28,"text":"وَهُوَ الَّذِي يُنَزِّلُ الْغَيْثَ مِنْ بَعْدِ مَا قَنَطُوا وَيَنْشُرُ رَحْمَتَهُ وَهُوَ الْوَلِيُّ الْحَمِيدُ"},"next":{"a":30,"text":"وَمَا أَصَابَكُمْ مِنْ مُصِيبَةٍ فَبِمَا كَسَبَتْ أَيْدِيكُمْ وَيَعْفُو عَنْ كَثِيرٍ"},"reason":"استدلالٌ بالقدرة الأولى على الثانية: من بثّ الدوابَّ ونشرها في السماوات والأرض قادرٌ على جمعها — فالبثُّ المشهود برهانُ الجمع الموعود، وجمعُ المتفرق أهون من إنشائه ابتداءً.","adds":"جواب منكري الحشر في كلمة: الذي بثّهم يجمعهم — والدليل مبثوثٌ حولك في كل دابة."},{"i":5,"of":5,"s":60,"surah":"الممتحنة","a":7,"text":"عَسَى اللَّهُ أَنْ يَجْعَلَ بَيْنَكُمْ وَبَيْنَ الَّذِينَ عَادَيْتُمْ مِنْهُمْ مَوَدَّةً وَاللَّهُ قَدِيرٌ وَاللَّهُ غَفُورٌ رَحِيمٌ","prev":{"a":6,"text":"لَقَدْ كَانَ لَكُمْ فِيهِمْ أُسْوَةٌ حَسَنَةٌ لِمَنْ كَانَ يَرْجُو اللَّهَ وَالْيَوْمَ الْآخِرَ وَمَنْ يَتَوَلَّ فَإِنَّ اللَّهَ هُوَ الْغَنِيُّ الْحَمِيدُ"},"next":{"a":8,"text":"لَا يَنْهَاكُمُ اللَّهُ عَنِ الَّذِينَ لَمْ يُقَاتِلُوكُمْ فِي الدِّينِ وَلَمْ يُخْرِجُوكُمْ مِنْ دِيَارِكُمْ أَنْ تَبَرُّوهُمْ وَتُقْسِطُوا إِلَيْهِمْ إِنَّ اللَّهَ يُحِبُّ الْمُقْسِطِينَ"},"reason":"أُلحق الاسم بأصعب التحولات: قلبُ العداوة مودة — فالمشاعر والقلوب ميدانٌ من ميادين قدرته كالأجرام والأجساد. وقد وقع: أسلم كبارُ محاربي الأمس وصاروا إخوةً وأنصارًا.","adds":"لا تيأس من تحول قلب أحد — زوجٍ أو قريبٍ أو خصم: القدير يقلب القلوب كما يقلب الليل والنهار."}],"hadiths":[],"sunnah":{"card":"الصيغة: الْقَدِيرُ — مفردة\nفي السنة: شاهد واحد (رواية واحدة)\nخصوصية الورود في السنة: ورد مفردًا في رواية المستدرك لحديث الإحصاء: «…المدبر، المالك، القدير، الهادي…».\nالمعنى المختصر: التام القدرة الذي لا يعجزه شيء.","teaches":"1. أن قدرته تامة لا يعجزها شيء.\n2. أنها بين ملكه وهدايته: قادرٌ فيهدي من ملك.","whenRecall":"- في إحصاء الأسماء.\n- حين تعجز عن أمر: القدير لا يعجز.","whenPray":"عند الشعور بـ:\n1. العجز.\nعند طلب:\n1. ما تعجز عنه.\nعند الرغبة في:\n1. إحصاء الأسماء.","duaItems":"لا صيغة دعاء منصوصة في الشاهد؛ ويُدعى بالقرآن: «إنك على كل شيء قدير» (انظر اسمه).","summary":"«القدير» في السنة اسمٌ محصًى في رواية المستدرك بين المالك والهادي."},"situations":[{"situationId":28,"verses":[{"i":2,"strength":"direct","headline":"ظلمٌ واقعٌ عليك مع اختلال ميزان القوى","bridge":"ظُلمتَ وترى ميزان القوى مختلًّا؟ أول آيةٍ أذنت للمظلومين بردّ الظلم قُرنت بضمانةٍ مؤكدة باللام: ﴿أُذِنَ لِلَّذِينَ يُقَاتَلُونَ بِأَنَّهُمْ ظُلِمُوا وَإِنَّ اللَّهَ عَلَى نَصْرِهِمْ لَقَدِيرٌ﴾ — الإذن تكليف والاسم ضمان؛ تحرّك لرفع ظلمك بالحق وأنت موقنٌ أن ناصرك قدير."}],"hadiths":[]},{"situationId":48,"verses":[{"i":5,"strength":"direct","headline":"اليأس من تغيّر قلب زوجٍ أو قريبٍ جافٍ","bridge":"يئست من تحول قلب شريكك؟ القلوب ميدانٌ من ميادين قدرته كالأجرام: ﴿عَسَى اللَّهُ أَنْ يَجْعَلَ بَيْنَكُمْ وَبَيْنَ الَّذِينَ عَادَيْتُمْ مِنْهُمْ مَوَدَّةً وَاللَّهُ قَدِيرٌ﴾ — وقد أسلم كبار محاربي الأمس وصاروا إخوة؛ فلا تيأس من تحول قلب زوجٍ أو قريب، القدير يقلب القلوب كما يقلب الليل والنهار."}],"hadiths":[]},{"situationId":82,"verses":[{"i":1,"strength":"direct","headline":"التعاظم بالدور والمكانة في العمل لله","bridge":"تعمل وتلتفت إلى نظر الناس أو تعاظمت في دورك؟ دواء العُجب في آية: ﴿إِنْ يَشَأْ يُذْهِبْكُمْ أَيُّهَا النَّاسُ وَيَأْتِ بِآخَرِينَ وَكَانَ اللَّهُ عَلَى ذَلِكَ قَدِيرًا﴾ — لست ضرورةً لله، والعمل له شرفٌ لك لا حاجةٌ له؛ فمن استحضر الاستبدال لم يبق في قلبه موضعٌ للالتفات."}],"hadiths":[]},{"situationId":110,"verses":[{"i":4,"strength":"direct","headline":"طلب اليقين بالبعث وجمع الخلائق بعد تفرّقهم","bridge":"تريد جواب منكري الحشر في كلمة؟ ﴿وَمِنْ آيَاتِهِ خَلْقُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَثَّ فِيهِمَا مِنْ دَابَّةٍ وَهُوَ عَلَى جَمْعِهِمْ إِذَا يَشَاءُ قَدِيرٌ﴾ — الذي بثّهم يجمعهم، والبثّ المشهود برهان الجمع الموعود؛ والدليل مبثوثٌ حولك في كل دابة."}],"hadiths":[]},{"situationId":178,"verses":[{"i":3,"strength":"direct","headline":"التأمل في شبكة الأنساب والقرابات","bridge":"تنظر في شجرة عائلتك؟ كل هذا التشابك من ماء: ﴿وَهُوَ الَّذِي خَلَقَ مِنَ الْمَاءِ بَشَرًا فَجَعَلَهُ نَسَبًا وَصِهْرًا وَكَانَ رَبُّكَ قَدِيرًا﴾ — من ماءٍ واحدٍ مهين خرجت شبكة الأنساب والأصهار التي تملأ الأرض؛ فقراباتك كلها أثر قدرة التنويع من أصلٍ واحد."}],"hadiths":[]}]},{"id":44,"name":"الغفور الشكور","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: غَفُورٌ شَكُورٌ — مركّبة | المواضع: 3 (فاطر: 30، 34 — الشورى: 23)\nخصوصية: الاقتران الوحيد الذي يجمع محوَ السيئات ومضاعفةَ الحسنات — فالميزان معه كله لصالح العبد؛ وبه يفسَّر قول أهل الجنة عند دخولها.\n\nالمعنى:\n- الغفور: الساتر المسقط للسيئات.\n- الشكور: الذي يقبل اليسير من العمل ويضاعفه ويثني على صاحبه — فشكرُ الله لعبده أعظم من شكر العبد لربه.","teaches":"الحقائق التي كشفتها المواضع:\n1. شكرُ الله لعبده: قبولُ اليسير، ومضاعفتُه، والثناءُ على صاحبه.\n2. الحزن يذهب نهائيًا حين يجتمع محو السيئات وقبول الحسنات.\n3. الحسنة تنمو «فيها» عنده — فلا صغيرة من الخير مع الشكور.","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- عند استقلال عملك واحتقاره: الشكور يضاعفه.\n- عند العمل مع شعورك بخللٍ فيه: الغفور يستر نقصه.\n- عند الحزن على التقصير: تذكر قول أهل الجنة.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. طلب قبول العمل مع ستر نقصه: «اللهم تقبل يسيري واغفر تقصيري».\n2. لزوم أركان التجارة التي لن تبور: تلاوة وصلاة وإنفاق — فاطر 29.\n3. سؤال إذهاب الحزن سلفًا بدعاء أهل الجنة — فاطر 34.\n4. من السنة: «اللَّهُمَّ أَعِنِّي عَلَى ذِكْرِكَ وَشُكْرِكَ وَحُسْنِ عِبَادَتِكَ» — رواه أبو داود بسند صحيح.","summary":"تتعامل مع من يمحو سيّئك ويضاعف حسنك — ﴿غَفُورٌ شَكُورٌ﴾ — فأيُّ تجارةٍ تبور مع شريكٍ كهذا؟","verses":[{"i":1,"of":3,"s":35,"surah":"فاطر","a":30,"text":"لِيُوَفِّيَهُمْ أُجُورَهُمْ وَيَزِيدَهُمْ مِنْ فَضْلِهِ إِنَّهُ غَفُورٌ شَكُورٌ","prev":{"a":29,"text":"إِنَّ الَّذِينَ يَتْلُونَ كِتَابَ اللَّهِ وَأَقَامُوا الصَّلَاةَ وَأَنْفَقُوا مِمَّا رَزَقْنَاهُمْ سِرًّا وَعَلَانِيَةً يَرْجُونَ تِجَارَةً لَنْ تَبُورَ"},"next":{"a":31,"text":"وَالَّذِي أَوْحَيْنَا إِلَيْكَ مِنَ الْكِتَابِ هُوَ الْحَقُّ مُصَدِّقًا لِمَا بَيْنَ يَدَيْهِ إِنَّ اللَّهَ بِعِبَادِهِ لَخَبِيرٌ بَصِيرٌ"},"context":"في أهل التلاوة والصلاة والإنفاق: ﴿يَرْجُونَ تِجَارَةً لَنْ تَبُورَ * لِيُوَفِّيَهُمْ أُجُورَهُمْ وَيَزِيدَهُمْ مِنْ فَضْلِهِ إِنَّهُ غَفُورٌ شَكُورٌ﴾.","reason":"ضمانُ التجارة التي لن تبور في الاسمين: توفيةُ الأجر كاملًا ثم زيادةٌ من الفضل — فالغفور يستر ما شاب العملَ من نقص فلا يُخصم، والشكور يضاعف قليلَه فلا يقف عند حدّه. تجارةٌ شريكُها لا يحاسبك على الخسائر ويضاعف الأرباح.","adds":"أركان التجارة الرابحة ثلاثة كما في الآية قبلها: تلاوةُ الكتاب، وإقامُ الصلاة، والإنفاقُ سرًا وعلانية."},{"i":2,"of":3,"s":35,"surah":"فاطر","a":34,"text":"وَقَالُوا الْحَمْدُ لِلَّهِ الَّذِي أَذْهَبَ عَنَّا الْحَزَنَ إِنَّ رَبَّنَا لَغَفُورٌ شَكُورٌ","prev":{"a":33,"text":"جَنَّاتُ عَدْنٍ يَدْخُلُونَهَا يُحَلَّوْنَ فِيهَا مِنْ أَسَاوِرَ مِنْ ذَهَبٍ وَلُؤْلُؤًا وَلِبَاسُهُمْ فِيهَا حَرِيرٌ"},"next":{"a":35,"text":"الَّذِي أَحَلَّنَا دَارَ الْمُقَامَةِ مِنْ فَضْلِهِ لَا يَمَسُّنَا فِيهَا نَصَبٌ وَلَا يَمَسُّنَا فِيهَا لُغُوبٌ"},"context":"أهل الجنة ساعةَ الدخول: ﴿وَقَالُوا الْحَمْدُ لِلَّهِ الَّذِي أَذْهَبَ عَنَّا الْحَزَنَ إِنَّ رَبَّنَا لَغَفُورٌ شَكُورٌ * الَّذِي أَحَلَّنَا دَارَ الْمُقَامَةِ مِنْ فَضْلِهِ﴾.","reason":"فسّر أهل الجنة نجاتهم بالاسمين: غفورٌ — غفر ذنوبنا فما حاسبنا عليها — شكورٌ — شكر أعمالنا على قلّتها فأدخلنا دار المقامة. فذهابُ الحزن كلِّه — حزنِ الذنب وحزنِ التقصير — ثمرةُ اجتماعهما.","adds":"هذا أول ما ستقوله إن دخلت الجنة — فتعلّمه الآن، وادعُ به سلفًا: أن يُذهب عنك الحزن بمغفرته وشكره."},{"i":3,"of":3,"s":42,"surah":"الشورى","a":23,"text":"ذَلِكَ الَّذِي يُبَشِّرُ اللَّهُ عِبَادَهُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ قُلْ لَا أَسْأَلُكُمْ عَلَيْهِ أَجْرًا إِلَّا الْمَوَدَّةَ فِي الْقُرْبَى وَمَنْ يَقْتَرِفْ حَسَنَةً نَزِدْ لَهُ فِيهَا حُسْنًا إِنَّ اللَّهَ غَفُورٌ شَكُورٌ","prev":{"a":22,"text":"تَرَى الظَّالِمِينَ مُشْفِقِينَ مِمَّا كَسَبُوا وَهُوَ وَاقِعٌ بِهِمْ وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فِي رَوْضَاتِ الْجَنَّاتِ لَهُمْ مَا يَشَاءُونَ عِنْدَ رَبِّهِمْ ذَلِكَ هُوَ الْفَضْلُ الْكَبِيرُ"},"next":{"a":24,"text":"أَمْ يَقُولُونَ افْتَرَى عَلَى اللَّهِ كَذِبًا فَإِنْ يَشَإِ اللَّهُ يَخْتِمْ عَلَى قَلْبِكَ وَيَمْحُ اللَّهُ الْبَاطِلَ وَيُحِقُّ الْحَقَّ بِكَلِمَاتِهِ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ"},"reason":"الزيادة «في» الحسنة نفسها — ﴿نَزِدْ لَهُ فِيهَا حُسْنًا﴾ — لا زيادة بجانبها فقط: فالحسنة عنده تنمو وتتضاعف كالبذرة، وهذا عينُ شكره سبحانه؛ والغفور يستر ما خالطها من شوائب النية والأداء.","adds":"حسناتك ودائع نامية عنده: لا تحتقر منها شيئًا — فالشكور يربّيها لك كما تربّي فَلُوَّك."}],"hadiths":[],"sunnah":{"card":"الصيغة: الْغَفُورُ الشَّكُورُ — مركّبة\nفي السنة: شاهد واحد (روايتان)\nخصوصية الورود في السنة: ورد الاسمان متجاورين في رواية الترمذي لحديث الإحصاء: «…الحليم، العظيم، الغفور، الشكور، العلي، الكبير…».\nالمعنى المختصر: الغفور الذي يمحو الذنب، الشكور الذي يجازي القليل بالكثير.","teaches":"1. أنه يغفر السيئة ويشكر الحسنة في وقتٍ واحد.\n2. أن الاسمين محصيان متجاورين في السنة كما في القرآن.","whenRecall":"- حين تخلط عملًا صالحًا بذنب.\n- في إحصاء الأسماء.","whenPray":"عند الشعور بـ:\n1. الخوف من ضياع العمل بالذنب.\nعند طلب:\n1. أن يغفر ذنبك ويشكر عملك.\nعند الرغبة في:\n1. أن تُحصي الأسماء.","duaItems":"لا صيغة منصوصة؛ ويُدعى بلفظ القرآن: «ربنا إنك غفور شكور» [فاطر: 34].","summary":"«الغفور الشكور» في السنة اسمان محصيان متجاورين بعد الحليم العظيم: يغفر ما أسأت ويشكر ما أحسنت."},"situations":[{"situationId":76,"verses":[{"i":3,"strength":"direct","headline":"استصغار الحسنة والخوف من ردّ العمل","bridge":"تستصغر حسنتك وتخاف ألا تُقبل؟ ﴿وَمَنْ يَقْتَرِفْ حَسَنَةً نَزِدْ لَهُ فِيهَا حُسْنًا إِنَّ اللَّهَ غَفُورٌ شَكُورٌ﴾ — الزيادة «في» الحسنة نفسها: تنمو عنده كالبذرة، والغفور يستر ما خالطها من شوائب النية؛ فحسناتك ودائع نامية، لا تحتقر منها شيئًا."}],"hadiths":[]},{"situationId":162,"verses":[{"i":2,"strength":"direct","headline":"طلب الثناء على الله بأكمل العبارات","bridge":"تريد أن تثني عليه بلغة أهل الجنة؟ أول ما يقولونه إذا دخلوها: ﴿الْحَمْدُ لِلَّهِ الَّذِي أَذْهَبَ عَنَّا الْحَزَنَ إِنَّ رَبَّنَا لَغَفُورٌ شَكُورٌ﴾ — فسّروا نجاتهم بالاسمين: غفر فما حاسبهم، وشكر أعمالهم على قلتها؛ فتعلّم الحمد الآن وادعُ به سلفًا أن يُذهب عنك الحزن."}],"hadiths":[]},{"situationId":170,"verses":[{"i":1,"strength":"direct","headline":"الخوف من ردّ العمل لما شابه من نقص","bridge":"عملتَ وتخاف ألا يُتقبّل؟ التجارة مع الله ﴿لَنْ تَبُورَ﴾ لأن شريكك ﴿غَفُورٌ شَكُورٌ﴾: الغفور يستر ما شاب عملك من نقصٍ فلا يُخصم، والشكور يضاعف قليله فلا يقف عند حده — ﴿لِيُوَفِّيَهُمْ أُجُورَهُمْ وَيَزِيدَهُمْ مِنْ فَضْلِهِ﴾؛ لا تُحاسَب على الخسائر وتُضاعَف لك الأرباح."}],"hadiths":[]}]},{"id":45,"name":"خير المنزلين","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: خَيْرُ الْمُنْزِلِينَ — صيغة تفضيل | المواضع: 1 (المؤمنون: 29)\nخصوصية: الموضع الوحيد الذي عُلّم فيه نبيٌّ دعاءَ النزول بعد أعظم رحلةٍ في التاريخ — نزولُ نوحٍ على أرضٍ يستأنف عليها العالم من جديد.\n\nتنبيه منهجي (مهم):\nوردت الصيغة نفسها مرةً أخرى في القرآن على لسان يوسف عليه السلام: ﴿أَلَا تَرَوْنَ أَنِّي أُوفِي الْكَيْلَ وَأَنَا خَيْرُ الْمُنْزِلِينَ﴾ [يوسف: 59] — وهي هناك وصفٌ ليوسف نفسه لحسن ضيافته وإكرامه لنزلائه، لا اسمًا ولا وصفًا لله تعالى. ولذلك لم تُعدّ في مواضع هذا الاسم؛ إذ الضابط في هذا المصنف أن يكون الوصفُ مُسندًا إلى الله سبحانه، لا أن تَرِد الصيغةُ في القرآن كيفما اتفق.\nوعلى القاعدة نفسها استُبعدت نظائرُها: ﴿بِالْمُؤْمِنِينَ رَءُوفٌ رَحِيمٌ﴾ [التوبة: 128] وصفًا للنبي ﷺ، و﴿إِنَّكَ عَلَى الْحَقِّ الْمُبِينِ﴾ [النمل: 79] وصفًا لموقفه، و﴿لَعَلِيٌّ حَكِيمٌ﴾ [الزخرف: 4] وصفًا للقرآن.\n\nالمعنى:\n- خير المنزلين: أفضلُ من يُنزل عبده منزلًا: يهيّئ المكان، ويبارك النزول، ويكفي شرَّ ما فيه — فبركةُ المنزل من المنزِل لا من المكان.","teaches":"الحقائق التي كشفها الموضعان:\n1. بركة المنازل من المنزِل سبحانه — فتُطلب منه قبل السكنى.\n2. حسن الإنزال والضيافة خلقُ أنبياء يُتخلق به.\n3. لكل حركةٍ دعاء: للركوب بسملة، وللنزول سؤال البركة.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند الانتقال إلى بيتٍ جديد أو بلدٍ جديد أو عملٍ جديد: قبل أن تضع قدمك اطلب البركة.\n- عند بداية مرحلةٍ تستأنف فيها حياتك من الصفر بعد انقطاع.\n- عند النزول في سفرٍ أو استراحةٍ في طريق.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. دعاء نوح عند كل نزولٍ وانتقال: ﴿رَبِّ أَنْزِلْنِي مُنْزَلًا مُبَارَكًا وَأَنْتَ خَيْرُ الْمُنْزِلِينَ﴾ — المؤمنون 29.\n2. دعاءُ الركوب المقترن به في قصة نوح: ﴿بِسْمِ اللَّهِ مَجْرَاهَا وَمُرْسَاهَا﴾ — هود 41؛ فبسملةٌ عند الإبحار وسؤالُ بركةٍ عند النزول.\n3. من السنة عند النزول في سفر: «أَعُوذُ بِكَلِمَاتِ اللَّهِ التَّامَّاتِ مِنْ شَرِّ مَا خَلَقَ» — رواه مسلم، وفيه: لم يضره شيء حتى يرتحل من منزله ذلك.\n4. سؤال البركة في المسكن الجديد: فالبركة من المنزِل لا من المكان.","summary":"بعد أن غُسلت الأرض من أهلها ووقف نوحٌ على عالمٍ يبدأ من الصفر، لم يُعلَّم أن يسأل مالًا ولا أرضًا بل: ﴿رَبِّ أَنْزِلْنِي مُنْزَلًا مُبَارَكًا وَأَنْتَ خَيْرُ الْمُنْزِلِينَ﴾ — فلا تسكن منزلًا قبل أن تطلب بركته من مالكها.","verses":[{"i":1,"of":1,"s":23,"surah":"المؤمنون","a":29,"text":"وَقُلْ رَبِّ أَنْزِلْنِي مُنْزَلًا مُبَارَكًا وَأَنْتَ خَيْرُ الْمُنْزِلِينَ","prev":{"a":28,"text":"فَإِذَا اسْتَوَيْتَ أَنْتَ وَمَنْ مَعَكَ عَلَى الْفُلْكِ فَقُلِ الْحَمْدُ لِلَّهِ الَّذِي نَجَّانَا مِنَ الْقَوْمِ الظَّالِمِينَ"},"next":{"a":30,"text":"إِنَّ فِي ذَلِكَ لَآيَاتٍ وَإِنْ كُنَّا لَمُبْتَلِينَ"},"context":"نوحٌ يُؤمر بصنع الفلك، ويُعلَّم ما يقوله إذا استوى هو ومن معه عليها: ﴿فَقُلِ الْحَمْدُ لِلَّهِ الَّذِي نَجَّانَا مِنَ الْقَوْمِ الظَّالِمِينَ﴾، ثم: ﴿وَقُلْ رَبِّ أَنْزِلْنِي مُنْزَلًا مُبَارَكًا وَأَنْتَ خَيْرُ الْمُنْزِلِينَ﴾ — حمدٌ على النجاة، ثم سؤالُ بركةٍ في المنزل الذي سينزله بعد الطوفان.","reason":"بعد الطوفان سينزل نوحٌ على أرضٍ جديدة كليًا — عالمٌ يُبنى من الصفر — فعُلّم أن يطلب من خير المنزلين منزلًا «مباركًا»: فبركةُ المنزل من المنزِل لا من المكان، والنزلُ الحقيقي ما أنزلك الله فيه ببركته.","adds":"دعاءُ كل انتقال: بيتٍ جديد، أو بلدٍ جديد، أو مرحلةٍ جديدة — ﴿رَبِّ أَنْزِلْنِي مُنْزَلًا مُبَارَكًا﴾ قبل أن تضع قدمك."}],"hadiths":[],"situations":[{"situationId":160,"verses":[{"i":1,"strength":"direct","headline":"الانتقال إلى مسكنٍ أو بلدٍ أو عملٍ جديد","bridge":"تنتقل إلى مسكنٍ أو بلدٍ أو عملٍ جديد؟ نوح كان ينزل على أرضٍ جديدة كليًّا بعد الطوفان، فعُلّم أن يقول: ﴿رَبِّ أَنْزِلْنِي مُنْزَلًا مُبَارَكًا وَأَنْتَ خَيْرُ الْمُنْزِلِينَ﴾ — بركة المنزل من المنزِل لا من المكان؛ فقلها قبل أن تضع قدمك."}],"hadiths":[]}]},{"id":46,"name":"رب كل شيء","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: رَبُّ كُلِّ شَيْءٍ — مضافة | المواضع: 1 (الأنعام: 164)\nخصوصية: جاءت في آخر صفحة من الأنعام، جوابًا حاسمًا على من دعا النبيَّ ﷺ إلى ربٍّ سواه — ومعها أكبر قواعد المسؤولية الفردية.\n\nالمعنى:\n- رب كل شيء: مالكُ كل موجودٍ ومدبّره ومربّيه — لا يخرج عن ربوبيته شيء، حتى ما يُدّعى ربًّا من دونه.","teaches":"الحقائق التي كشفها الموضع:\n1. البحث عن ربٍّ سواه عبث: كل مرشحٍ مربوبٌ له.\n2. المسؤولية فردية صارمة: كسبك عليك ولا وزر عن أحد.\n3. الربوبية الشاملة تستلزم المرجع والحساب.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند إغراء التبعية العمياء لشخصٍ أو تيارٍ أو جماعة.\n- عند الاحتجاج بـ«الكل يفعل ذلك».","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. إفراد الرب بالطلب والولاء: ﴿أَغَيْرَ اللَّهِ أَبْغِي رَبًّا﴾ — الأنعام 164.\n2. سؤال السلامة من أوزار التبعية: أن تحمل وزر متبوعٍ أو يُحمل عليك وزر تابع.\n3. الاستعداد الفردي للمرجع: فكلٌّ يرجع بكسبه وحده.","summary":"كلُّ من قد تتخذه ربًّا — رئيسًا أو تيارًا أو هوًى — هو نفسه مربوبٌ لرب كل شيء: فاختصر: ﴿أَغَيْرَ اللَّهِ أَبْغِي رَبًّا وَهُوَ رَبُّ كُلِّ شَيْءٍ﴾.","verses":[{"i":1,"of":1,"s":6,"surah":"الأنعام","a":164,"text":"قُلْ أَغَيْرَ اللَّهِ أَبْغِي رَبًّا وَهُوَ رَبُّ كُلِّ شَيْءٍ وَلَا تَكْسِبُ كُلُّ نَفْسٍ إِلَّا عَلَيْهَا وَلَا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَى ثُمَّ إِلَى رَبِّكُمْ مَرْجِعُكُمْ فَيُنَبِّئُكُمْ بِمَا كُنْتُمْ فِيهِ تَخْتَلِفُونَ","prev":{"a":163,"text":"لَا شَرِيكَ لَهُ وَبِذَلِكَ أُمِرْتُ وَأَنَا أَوَّلُ الْمُسْلِمِينَ"},"next":{"a":165,"text":"وَهُوَ الَّذِي جَعَلَكُمْ خَلَائِفَ الْأَرْضِ وَرَفَعَ بَعْضَكُمْ فَوْقَ بَعْضٍ دَرَجَاتٍ لِيَبْلُوَكُمْ فِي مَا آتَاكُمْ إِنَّ رَبَّكَ سَرِيعُ الْعِقَابِ وَإِنَّهُ لَغَفُورٌ رَحِيمٌ"},"context":"آخرُ صفحةٍ من سورة الأنعام — سورةِ التوحيد الكبرى — والخطاب يبلغ ذروته في إعلانٍ جامع: ﴿قُلْ إِنَّ صَلَاتِي وَنُسُكِي وَمَحْيَايَ وَمَمَاتِي لِلَّهِ رَبِّ الْعَالَمِينَ * لَا شَرِيكَ لَهُ وَبِذَلِكَ أُمِرْتُ وَأَنَا أَوَّلُ الْمُسْلِمِينَ﴾. وكان المشركون يدعونه إلى الرجوع إلى دينهم. فجاء الجواب سؤالًا إنكاريًّا يقطع الطريق: ﴿قُلْ أَغَيْرَ اللَّهِ أَبْغِي رَبًّا وَهُوَ رَبُّ كُلِّ شَيْءٍ﴾ — أأطلب ربًّا آخر وكلُّ ما تعرضونه عليّ داخلٌ في ملكه ومربوبٌ له؟ ثم — وهذا موضع الالتفات — انتقل فورًا من التوحيد إلى المسؤولية الفردية: ﴿وَلَا تَكْسِبُ كُلُّ نَفْسٍ إِلَّا عَلَيْهَا وَلَا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَى﴾ — لأن الذي يدعوك إلى الشرك اليوم لن يحمل عنك شيئًا غدًا: ﴿ثُمَّ إِلَى رَبِّكُمْ مَرْجِعُكُمْ﴾.","reason":"استفهامٌ إنكاري يقطع البحث من أصله: كيف يُبتغى ربٌّ غيره وكلُّ مرشحٍ لذلك مربوبٌ له داخلٌ في ﴿كُلِّ شَيْءٍ﴾؟ ثم رُتبت على الربوبية الشاملة قواعدُ العدل الثلاث: كسبُك عليك وحدك، ولا تحمل نفسٌ وزرَ أخرى، والمرجع إليه — فربُّ الكل يحاسب كلَّ فردٍ بعدلٍ فردي.","adds":"آية المسؤولية الفردية الكبرى: لن ينفعك يوم القيامة أن «الجميع كانوا يفعلون» — ولن تُحمَّل ذنبَ أحدٍ أغراك: كلٌّ بكسبه."}],"hadiths":[{"i":1,"of":4,"text":"عنِ ابنِ عمرَ ، أنَّهُ حدَّثَهُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وعلى آلِهِ وسلَّمَ كانَ يقولُ إذا أخذَ مَضجعَهُ : ( الحمدُ للَّهِ الَّذي كَفاني وآواني ، أطعمَني وسَقاني ، والَّذي منَّ عليَّ فأفضلَ ، والَّذي أعطاني فأجزلَ ، الحمدُ للَّهِ على كلِّ حالٍ اللَّهمَّ ربَّ كلِّ شيءٍ ومليكَهُ وإلَهَ كلِّ شيءٍ ، أعوذُ بِكَ منَ النَّارِ ) .","narrator":"عبدالله بن عمر","source":"الصحيح المسند 730","grade":"صحيح","judgment":"صحيح على شرط الشيخين","url":"https://dorar.net/h/bUbSmP5R","nameForm":"ربَّ كلِّ شيءٍ","scene":"ابن عمر: كان النبي ﷺ يقول إذا أخذ مضجعه: «الحمد لله الذي كفاني وآواني، أطعمني وسقاني، والذي منّ عليّ فأفضل، والذي أعطاني فأجزل، الحمد لله على كل حال، اللهم رب كل شيء ومليكه وإله كل شيء، أعوذ بك من النار».","reason":"بعد تعداد نعم اليوم — كفاية وإيواء وطعام وشراب — يأتي الاسم جامعًا: «رب كل شيء ومليكه وإله كل شيء»، ثم استعاذة واحدة من النار. فالتفصيل في النعم ثم التعميم في الاسم: الذي ربّ هذه النعم كلها هو رب كل شيء، وهو الذي يُستعاذ به من أعظم ما يُخاف.","adds":"يعطي الشاهد الاسم ذكرًا عند النوم مبنيًّا على الحمد، ويُري أن عموم الربوبية يُذكر بعد خصوص النعم."},{"i":2,"of":4,"text":"دخلَت فاطِمةُ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّم تسألُه خادِمًا، فقال لها رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ألا أدُلُّك على ما هو خيرٌ لك مِن ذلك؟ تقولينَ: اللَّهمَّ ربَّ السَّمواتِ السَّبعِ، وربَّ العَرشِ العظيمِ، ربَّنا وربَّ كُلِّ شيءٍ، مُنزِلَ التَّوراةِ والإنجيلِ...، الحديث. [يعني حديثَ: جاءت فاطِمةُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم تسألُه خادِمًا، فقال لها: \"قولي: ‌اللَّهمَّ ‌ربَّ ‌السَّمواتِ ‌السَّبعِ، ‌وربَّ ‌العَرشِ ‌العظيمِ، ‌ربَّنا ‌وربَّ ‌كُلِّ ‌شيءٍ، ‌مُنزِلَ ‌التَّوراةِ ‌والإنجيلِ والقرآنِ، فالِقَ الحَبِّ والنَّوى، أعوذُ بك مِن شرِّ كُلِّ شيءٍ أنت آخِذٌ بناصيتِه، أنت الأوَّلُ فليس قَبلَك شيءٌ، وأنت الآخِرُ فليس بَعدَك شيءٌ، وأنت الظَّاهِرُ فليس فَوقَك شيءٌ، وأنت الباطِنُ فليس دونَك شيءٌ، اقضِ عنِّي الدَّينِ، وأغنِني مِن الفَقرِ\"].","narrator":"أبو هريرة","source":"علل الدارقطني 1980","grade":"صحيح","judgment":"[حكى فيه الخلافَ على الأعمَشِ، ثُمَّ قال]: وحديثُ أبي هُرَيرةَ محفوظٌ عن الأعمَشِ وسُهَيلٍ.","url":"https://dorar.net/h/90RVpphs","nameForm":"وربَّ كُلِّ شيءٍ ؛ ‌وربَّ ‌كُلِّ ‌شيءٍ","scene":"فاطمة تدخل على النبي ﷺ تسأله خادمًا يكفيها مشقة البيت. فيقول: «ألا أدلك على ما هو خير لك من ذلك؟ تقولين: اللهم رب السماوات السبع ورب العرش العظيم، ربنا ورب كل شيء، منزل التوراة والإنجيل والقرآن، فالق الحب والنوى، أعوذ بك من شر كل شيء أنت آخذ بناصيته…» — الحديث.","reason":"سألت عونًا محدودًا — خادمًا — فأعطاها اسمًا يسع كل عون: «ربنا ورب كل شيء». والاسم في الدعاء بعد رب السماوات والعرش، ثم ينتقل إلى الاستعاذة «من شر كل شيء أنت آخذ بناصيته» — فمن كان ربَّ كل شيء كان آخذًا بناصية كل شيء، فيُستعاذ به من شره.","adds":"يُبيّن الشاهد أن الاسم أعطاه النبي ﷺ لابنته بديلًا عن الخادم: عونٌ بالاسم أعظم من عونٍ بالخلق."},{"i":3,"of":4,"text":"عن أبي راشد الحبراني قال: أتَيْتُ عبدَ اللهِ بنَ عَمرِو بنِ العاصِ، فقُلْتُ له: حدِّثْنا ما سمِعْتَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فأَلقى بين يدَيَّ صَحيفةً، فقال: هذا ما كتَبَ لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فنظَرْتُ فيها، فإذا فيها: أنَّ أبا بَكرٍ الصِّدِّيقَ قال: يا رسولَ اللهِ، علِّمْني ما أقولُ إذا أصبَحْتُ وإذا أمسَيْتُ؟ فقال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا أبا بَكرٍ، قُلْ: اللَّهُمَّ فاطرَ السَّمواتِ والأرضِ، عالمَ الغَيبِ والشَّهادةِ، لا إلهَ إلَّا أنتَ، ربَّ كلِّ شيءٍ ومَليكَه، أعوذُ بكَ مِن شرِّ نفْسي، ومِن شرِّ الشَّيطانِ وشِركِه، وأنْ أقترِفَ على نفْسي سوءًا، أو أجُرَّه إلى مُسلمِ .","narrator":"عبدالله بن عمرو","source":"تخريج المسند لشعيب 6851","grade":"صحيح","judgment":"صحيح لغيره","url":"https://dorar.net/h/yOxhA5H0","nameForm":"ربَّ كلِّ شيءٍ","scene":"أبو بكر يسأل: يا رسول الله علّمني ما أقول إذا أصبحت وإذا أمسيت. فيقول: «قل: اللهم فاطر السماوات والأرض، عالم الغيب والشهادة، لا إله إلا أنت، رب كل شيء ومليكه، أعوذ بك من شر نفسي ومن شر الشيطان وشركه، وأن أقترف على نفسي سوءًا أو أجرّه إلى مسلم». وقد وُجد في صحيفةٍ كتبها النبي ﷺ لعبد الله بن عمرو.","reason":"ذكر الصباح والمساء يبدأ بالخلق (فاطر)، ثم العلم (عالم الغيب والشهادة)، ثم التوحيد، ثم الربوبية العامة «رب كل شيء ومليكه» — ثم يُستعاذ من أقرب الشرور: النفس والشيطان. فالذي يرب كل شيء يرب نفسك وشيطانك، فيُستعاذ به منهما.","adds":"ذكرٌ يومي علّمه النبي ﷺ أبا بكر بلفظ الاسم، مكتوبٌ في صحيفةٍ كتبها لعبد الله بن عمرو — فالاسم من أذكار الطرفين."},{"i":4,"of":4,"text":"تحصَّنتُ بالذي لا إلهَ إلَّا هو إلهي وإلهُ كلِّ شيءٍ واعتصمتُ بربِّي وبربِّ كلِّ شيءٍ وتوكلتُ على الحيِّ الذي لا يموتُ واستدفعتُ الشرَّ بلا حولَ ولا قوةَ إلَّا باللهِ ، حسبيَ اللهُ ونعمَ الوكيلُ ، حسبيَ الربُّ من العبادِ ، حسبيَ الخالقُ من المخلوقِ ، حسبيَ الرزاقُ من المرزوقِ ، حسبيَ الذي هو حسبي ، حسبيَ الذي بيدهِ ملكوتُ كلِّ شيءٍ ، وهو يجيرُ ولا يجارُ عليه ، حسبيَ اللهُ وكفَى ، سمِع اللهُ لمن دعا ، ليس وراءَ اللهِ مَرمَى ، حسبيَ اللهُ لا إلهَ إلَّا هو عليه توكلتُ وهو ربُّ العرشِ العظيمِ","narrator":"-","source":"سفر السعادة 310","grade":"صحيح","url":"https://dorar.net/h/kUN6OVoQ","nameForm":"وبربِّ كلِّ شيءٍ","scene":"دعاء التحصن: «تحصنت بالذي لا إله إلا هو، إلهي وإله كل شيء، واعتصمت بربي ورب كل شيء، وتوكلت على الحي الذي لا يموت، واستدفعت الشر بلا حول ولا قوة إلا بالله، حسبي الله ونعم الوكيل، حسبي الرب من العباد، حسبي الخالق من المخلوق، حسبي الرزاق من المرزوق…».","reason":"الاعتصام بربٍّ هو رب كل شيء يعني أن ما يُخاف منه مربوبٌ لمن اعتُصم به؛ والدعاء يكرر هذا المعنى بصيغ: حسبي الرب من العباد، الخالق من المخلوق — فالاسم أصل هذه المقابلات كلها.","adds":"يقدّم الشاهد صيغة تحصنٍ جامعة يتكرر فيها الاسم بمعناه، تصلح لكل خوف."}],"sunnah":{"card":"الصيغة: رَبُّ كُلِّ شَيْءٍ — مركّبة\nفي السنة: 4 شواهد (10 روايات)\nخصوصية الورود في السنة: هذا الاسم لا يكاد يرد في السنة إلا في دعاء: عند المضجع «اللهم رب كل شيء ومليكه»، وفي ذكر الصباح والمساء الذي علّمه النبي ﷺ أبا بكر «فاطر السماوات والأرض عالم الغيب والشهادة… رب كل شيء ومليكه»، وفي دعاء فاطمة حين سألت خادمًا «ربنا ورب كل شيء»، وفي دعاء التحصن. فهو اسمُ الاستعاذة والتفويض في أطراف اليوم.\nالمعنى المختصر: الذي ربوبيته عامة لكل شيء: خلقًا وملكًا وتدبيرًا.","teaches":"1. أن ربوبيته عامة: يرب نفسك وشيطانك وما تخافه، فيُستعاذ به منها.\n2. أنه يُذكر في أطراف اليوم: عند النوم وفي الصباح والمساء.\n3. أن اسمه أعطي لفاطمة بديلًا عن خادم — الاسم عون.\n4. أنه يُذكر بعد تفصيل النعم تعميمًا.","whenRecall":"- عند المضجع بعد الحمد على نعم اليوم.\n- في الصباح والمساء بدعاء أبي بكر.\n- حين تسأل عونًا من الناس: دعاء فاطمة.\n- حين تخاف شرًّا: دعاء التحصن.","whenPray":"عند الشعور بـ:\n1. الحاجة إلى عون في مشقة البيت والعمل.\n2. الخوف من النفس والشيطان.\n3. الخوف من النار عند النوم.\nعند طلب:\n1. الكفاية من كل شيء تخافه.\n2. الحفظ من أن تظلم أو تُظلم.\nعند الرغبة في:\n1. ختم اليوم بالحمد والاستعاذة.\n2. افتتاح اليوم بتوحيدٍ واستعاذة.","duaItems":"1. عند المضجع: «الحمد لله الذي كفاني وآواني، أطعمني وسقاني، والذي منّ عليّ فأفضل، والذي أعطاني فأجزل، الحمد لله على كل حال، اللهم رب كل شيء ومليكه وإله كل شيء، أعوذ بك من النار» — الصحيح المسند 730 (صحيح على شرط الشيخين).\n2. الصباح والمساء: «اللهم فاطر السماوات والأرض، عالم الغيب والشهادة، لا إله إلا أنت، رب كل شيء ومليكه، أعوذ بك من شر نفسي ومن شر الشيطان وشركه، وأن أقترف على نفسي سوءًا أو أجره إلى مسلم» — تخريج سنن أبي داود 5083 (صحيح).\n3. دعاء فاطمة: «اللهم رب السماوات السبع ورب العرش العظيم، ربنا ورب كل شيء، منزل التوراة والإنجيل والقرآن، فالق الحب والنوى، أعوذ بك من شر كل شيء أنت آخذ بناصيته…» — صحيح ابن ماجه 3104.\n4. التحصن: «تحصنت بالذي لا إله إلا هو… واعتصمت بربي ورب كل شيء…» — سفر السعادة 310 (صحيح).","summary":"«رب كل شيء» في السنة اسمُ أطراف اليوم: عند النوم بعد الحمد، وفي الصباح والمساء بدعاء أبي بكر، وأعطاه النبي ﷺ فاطمةَ بديلًا عن خادم — لأن من رب كل شيء يرب ما تخافه ومن تحتاجه."},"situations":[{"situationId":12,"verses":[],"hadiths":[{"i":4,"strength":"direct","headline":"الخوف من شرٍّ خفي لا تراه ولا تملك دفعه","bridge":"تخاف شرًّا لا تراه؟ «اعتصمت بربي ورب كل شيء… حسبي الرب من العباد، حسبي الخالق من المخلوق» — كل ما تخافه مربوبٌ لمن تعتصم به."}]},{"situationId":102,"verses":[],"hadiths":[{"i":2,"strength":"direct","headline":"مشقة أعباء البيت وطلب عونٍ لا تجده","bridge":"تحتاج عونًا لا تجده؟ فاطمة سألت خادمًا فأعطاها النبي ﷺ ما هو خير: «اللهم رب السماوات السبع ورب العرش العظيم، ربنا ورب كل شيء…» — العون من رب كل شيء أوسع من عون خادم."}]},{"situationId":125,"verses":[{"i":1,"strength":"direct","headline":"مسايرة من يغريك بالخطأ لأن الجميع يفعلونه","bridge":"تختار من تصاحب ومن تحالف؟ تذكّر القواعد الثلاث التي رتّبتها الآية على ربوبيته الشاملة: ﴿وَلَا تَكْسِبُ كُلُّ نَفْسٍ إِلَّا عَلَيْهَا وَلَا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَى﴾ — لن ينفعك يوم القيامة أن الجميع كانوا يفعلون، ولن يُحمَّل عنك من أغراك؛ فاختر صحبةً لا تحتاج معها إلى هذا العذر."}],"hadiths":[]},{"situationId":156,"verses":[],"hadiths":[{"i":3,"strength":"direct","headline":"ورد الصباح والمساء والاستعاذة من شر النفس","bridge":"وردك اليومي؟ علّم النبي ﷺ أبا بكر أن يقول صباحًا ومساءً: «اللهم فاطر السماوات والأرض عالم الغيب والشهادة، لا إله إلا أنت، رب كل شيء ومليكه، أعوذ بك من شر نفسي…» — الذي يرب كل شيء يرب نفسك وشيطانك."}]},{"situationId":157,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"أخذ المضجع وختم اليوم بالحمد والاستعاذة","bridge":"عند مضجعك؟ احمد على نعم يومك كما كان يحمد، ثم قل: «اللهم رب كل شيء ومليكه وإله كل شيء، أعوذ بك من النار»."}]}]},{"id":47,"name":"رب الشعرى","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: رَبُّ الشِّعْرَى — مضافة | المواضع: 1 (النجم: 49)\nخصوصية: الموضع الوحيد الذي أضاف اللهُ فيه ربوبيته إلى معبودٍ وثني بعينه — نجم الشعرى الذي عبدته خزاعة — فنقض العبادة بإعلان الربوبية على المعبود نفسه.\n\nالمعنى:\n- رب الشعرى: مالكُ نجم الشعرى — ألمعِ نجوم السماء الذي عُبد من دون الله — ومدبّرُه: فمعبودُهم مربوبٌ في ملكه.","teaches":"الحقائق التي كشفها الموضع:\n1. المعبودات من دونه مربوبةٌ له — حتى ألمع ما في السماء.\n2. القرآن يواجه الناس بمعبوداتهم بأعيانها لا بالعموميات.\n3. ضحكك وبكاؤك وموتك وحياتك ونجومُ سمائك — كلها في سلسلةٍ واحدة بيده.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند رؤية النجوم والانبهار بالسماء.\n- عند شيوع الأبراج والتنجيم وتعلق الناس بالنجوم.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. عند الانبهار الكوني: صرفُ التعظيم من المربوب إلى الرب — النجم 49.\n2. البراءة من التنجيم والأبراج: فالنفع والضر بيد رب الشعرى لا بها.\n3. التوسل بربوبيته الشاملة: يا من أضحك وأبكى وأمات وأحيا وربَّ كلِّ نجمٍ في السماء.","summary":"عبدوا ألمعَ نجوم السماء فقال: ﴿وَأَنَّهُ هُوَ رَبُّ الشِّعْرَى﴾ — معبودُهم عبدٌ في ملكه: فكلُّ ما بهرك في الكون مربوبٌ — فاعبد ربَّه لا إياه.","verses":[{"i":1,"of":1,"s":53,"surah":"النجم","a":49,"text":"وَأَنَّهُ هُوَ رَبُّ الشِّعْرَى","prev":{"a":48,"text":"وَأَنَّهُ هُوَ أَغْنَى وَأَقْنَى"},"next":{"a":50,"text":"وَأَنَّهُ أَهْلَكَ عَادًا الْأُولَى"},"context":"في سلسلة ﴿وَأَنَّهُ هُوَ أَضْحَكَ وَأَبْكَى * وَأَنَّهُ هُوَ أَمَاتَ وَأَحْيَا﴾ يأتي: ﴿وَأَنَّهُ هُوَ رَبُّ الشِّعْرَى﴾ — والشعرى ألمع نجوم السماء، عبدته خزاعة وقبائل من العرب.","reason":"سمّى نفسه ربَّ النجم المعبود بالذات — لا ربَّ النجوم عمومًا — مواجهةً مباشرة: يا من تعبدون الشعرى، معبودُكم عبدٌ مملوك في ملكي. فأبلغُ نقضٍ للمعبود الباطل أن يُذكر باسمه مربوبًا — ودخل في السلسلة نفسها التي فيها الضحك والبكاء والموت والحياة: كلها بيدٍ واحدة.","adds":"قاعدةٌ لنقض كل معبودٍ ومُعظَّمٍ فلكي أو طبيعي — شمسًا وقمرًا ونجمًا وبرجًا: كلُّ ما بهر الناسَ في السماء مربوبٌ — فاعبد ربَّه."}],"hadiths":[],"situations":[{"situationId":99,"verses":[{"i":1,"strength":"direct","headline":"الانبهار بمخلوقٍ حتى تعظيمه فوق قدره","bridge":"بهرك شيءٌ حتى عظّمته فوق قدره؟ الشعرى ألمع نجوم السماء عبدتها قبائل، فسمّى الله نفسه ﴿رَبُّ الشِّعْرَى﴾ باسمها: معبودكم عبدٌ مملوك في ملكي — فكل ما بهر الناس في الأرض أو السماء مربوبٌ؛ اعبد ربَّه ولا تقف عنده."}],"hadiths":[]}]},{"id":48,"name":"أهل التقوى وأهل المغفرة","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: أَهْلُ التَّقْوَى وَأَهْلُ الْمَغْفِرَةِ — مركّبة | المواضع: 1 (المدثر: 56)\nخصوصية: آخر آية في المدثر، والصيغة الوحيدة التي وُصف فيها سبحانه بـ«الأهلية» — أهلٌ أن يُتّقى وأهلٌ أن يغفر — فجمعت مقامَي الخوف والرجاء في هويته هو، لا في حال العبد.\n\nالمعنى:\n- أهل التقوى: المستحقُّ أن يُتّقى ويُخاف ويُجَلّ — لجلاله وحقّه.\n- أهل المغفرة: المستحقُّ أن يغفر ويليق به الغفران — لكرمه وسعة رحمته.","teaches":"الحقائق التي كشفها الموضع:\n1. التقوى حقُّ أهليته — لا مجرد تكليف عليك.\n2. المغفرة شأنُه اللائق به — لا استحقاقٌ لك.\n3. الطريق بينهما موصول: من اتقاه وجده أهلًا للمغفرة.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند التأرجح بين الخوف والرجاء: هو أهلُهما معًا.\n- عند استصغار نفسك عن سؤال المغفرة: اسأله بما هو أهله.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. «اللهم أنت أهل التقوى وأهل المغفرة: ألهمنا من تقواك ما أنت أهله، وهب لنا من مغفرتك ما أنت أهله».\n2. التوسل بأهليته لا باستحقاقك: «اللهم عاملنا بما أنت أهله ولا تعاملنا بما نحن أهله».\n3. سؤال الذكر والتذكر: ﴿وَمَا يَذْكُرُونَ إِلَّا أَنْ يَشَاءَ اللَّهُ﴾ — فاطلب منه أن يشاء لك الذكرى.","summary":"لا تتعامل معه بما أنت أهله — بل بما هو أهله: ﴿هُوَ أَهْلُ التَّقْوَى وَأَهْلُ الْمَغْفِرَةِ﴾ — أعطه تقواه ينَلْك غفرانُه.","verses":[{"i":1,"of":1,"s":74,"surah":"المدثر","a":56,"text":"وَمَا يَذْكُرُونَ إِلَّا أَنْ يَشَاءَ اللَّهُ هُوَ أَهْلُ التَّقْوَى وَأَهْلُ الْمَغْفِرَةِ","prev":{"a":55,"text":"فَمَنْ شَاءَ ذَكَرَهُ"},"context":"تُختم سورة المدثر بموقف الناس من التذكرة: ﴿كَأَنَّهُمْ حُمُرٌ مُسْتَنْفِرَةٌ * فَرَّتْ مِنْ قَسْوَرَةٍ﴾ — نفورٌ لا مبرر له، و﴿كَلَّا بَلْ لَا يَخَافُونَ الْآخِرَةَ﴾. ثم يُقرَّر: ﴿كَلَّا إِنَّهُ تَذْكِرَةٌ * فَمَنْ شَاءَ ذَكَرَهُ﴾ — مشيئتك حقيقية — ثم يُردّ الأمر إلى أصله: ﴿وَمَا يَذْكُرُونَ إِلَّا أَنْ يَشَاءَ اللَّهُ﴾، وتُختم السورة بجملةٍ تعرّف بمن يُتّقى ويُرجى: ﴿هُوَ أَهْلُ التَّقْوَى وَأَهْلُ الْمَغْفِرَةِ﴾.","reason":"عُلّق الذكرُ بمشيئته، ثم بُيّنت أهليته المزدوجة: هو أهلٌ أن يُتّقى — فتقواك حقُّه لا تفضلًا منك — وأهلٌ أن يغفر — فمغفرته شأنُه اللائق به لا استحقاقًا منك.","adds":"يقلب الاسمُ منطقَ التعامل مع الله: لا تتعامل معه بما أنت أهله — بل بما هو أهله: أعطه التقوى التي هو أهلُها، تنَل المغفرةَ التي هو أهلُها."}],"hadiths":[{"i":1,"of":1,"text":"سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قَرَأَ: {وَمَا يَذْكُرُونَ إِلَّا أَنْ يَشَاءَ اللَّهُ هُوَ أَهْلُ التَّقْوَى وَأَهْلُ الْمَغْفِرَةِ} [المدثر: 56] قالَ: «يقولُ ربُّكُم عزَّ وجلَّ: أنا أهلٌ أنْ أُتَّقى أنْ يُجعَلَ معي إلهٌ آخرُ، وأنا أهلٌ لمَنِ اتَّقى أنْ يَجعلَ معي إلهًا آخرَ أنْ أغفِرَ له».","narrator":"أنس بن مالك","source":"المستدرك على الصحيحين 3923","grade":"صحيح","judgment":"صحيح الإسناد","url":"https://dorar.net/h/aYBP9b0V","nameForm":"أَهْلُ التَّقْوَى وَأَهْلُ الْمَغْفِرَةِ","scene":"أنس: سمعت رسول الله ﷺ قرأ ﴿وَمَا يَذْكُرُونَ إِلَّا أَنْ يَشَاءَ اللَّهُ هُوَ أَهْلُ التَّقْوَى وَأَهْلُ الْمَغْفِرَةِ﴾ قال: «يقول ربكم عز وجل: أنا أهلٌ أن أُتقى أن يُجعل معي إلهٌ آخر، وأنا أهلٌ لمن اتقى أن يجعل معي إلهًا آخر أن أغفر له».","reason":"الاسم مركب من شقين، والتفسير النبوي يعطي كلَّ شق شرطه: أهل التقوى = أهلٌ أن يُتقى الشرك فيه؛ أهل المغفرة = أهلٌ أن يغفر لمن اتقى الشرك. فالمغفرة معلّقة على التقوى، والتقوى محصورة في أعظمها: ألا يُجعل معه إله. والترتيب في الآية والتفسير واحد: تقوى أولًا ثم مغفرة.","adds":"أنفع ما في الشاهد: تحديد التقوى التي هي شرط المغفرة — التوحيد؛ فمن وحّد فقد أتى بما يجعله أهلًا لمغفرة أهل المغفرة."}],"sunnah":{"card":"الصيغة: أَهْلُ التَّقْوَى وَأَهْلُ الْمَغْفِرَةِ — مركّبة\nفي السنة: شاهد واحد (3 روايات)\nخصوصية الورود في السنة: النبي ﷺ يقرأ خاتمة المدثر ﴿هُوَ أَهْلُ التَّقْوَى وَأَهْلُ الْمَغْفِرَةِ﴾ ثم يفسّرها بكلام الله عن نفسه: «أنا أهلٌ أن أُتقى… وأنا أهلٌ لمن اتقى… أن أغفر له» — تفسيرٌ نبوي بلفظ إلهي.\nالمعنى المختصر: الذي هو أهلٌ أن يُخاف ويُتقى، وأهلٌ أن يغفر لمن اتقاه.","teaches":"1. أنه أهلٌ أن يُتقى: فلا يُجعل معه إله.\n2. أنه أهلٌ أن يغفر لمن وحّده.\n3. أن المغفرة مرتبة على التقوى في اسمه وفي تفسيره.","whenRecall":"- حين تقرأ آخر المدثر.\n- حين تخاف على مغفرتك: هل اتقيت الشرك؟\n- حين تنسب المغفرة إلى استحقاقك: هو أهلها لا أنت.","whenPray":"عند الشعور بـ:\n1. الخوف من الشرك الخفي.\n2. اليأس من المغفرة.\nعند طلب:\n1. تقوى تجعلك أهلًا للمغفرة.\n2. مغفرة من أهلها.\nعند الرغبة في:\n1. تعلّم التوحيد على أنه شرط المغفرة.","duaItems":"لا صيغة منصوصة؛ ويُدعى بمضمون التفسير النبوي: «اللهم إنك أهل التقوى وأهل المغفرة، فارزقني تقواك واغفر لي» (المستدرك 3923 — صحيح الإسناد).","summary":"«أهل التقوى وأهل المغفرة» في السنة فسّره الله عن نفسه على لسان نبيه: أهلٌ أن يُتقى الشرك، وأهلٌ أن يغفر لمن اتقاه — فالتوحيد هو الباب."},"situations":[{"situationId":16,"verses":[{"i":1,"strength":"direct","headline":"الاستحياء من الرجوع إلى الله بعد تكرار الذنب","bridge":"استحييت من الرجوع بعد تكرار الذنب لأنك لا تستحق؟ الآية لم تعلّق المغفرة على استحقاقك بل على أهليته هو: ﴿وَأَهْلُ الْمَغْفِرَةِ﴾ — مغفرته شأنه اللائق به لا أجرةٌ على كمالك؛ فلا تتعامل معه بما أنت أهله، بل بما هو أهله."}],"hadiths":[]},{"situationId":22,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"التأرجح بين القنوط من المغفرة والأمن من العقوبة","bridge":"تتأرجح بين قنوط وأمن؟ الاسم نفسه يوازنك: «أنا أهلٌ أن أُتقى، وأنا أهلٌ لمن اتقى أن أغفر له» — خوفٌ من الشرك، ورجاءٌ لمن اجتنبه."}]}]},{"id":49,"name":"الولي","compound":false,"meaning":"بطاقة الاسم:\nالصيغة: الْوَلِيُّ / وَلِيُّ — | المواضع: 12\nخصوصية: مواضعه ترسم «عقد الولاية» كاملًا: أثرها (الإخراج من الظلمات إلى النور)، وشرطها (الإيمان والتقوى والعمل والصلاح)، وحصرها (فالله هو الولي)، وثمرتها (دار السلام) — وأعجب مواضعه: ولايته لطائفتين همّتا بالفشل.\n\nالمعنى:\n- الولي: الناصر المتولي لأمور عباده، القائم بشؤونهم، القريب منهم بالنصرة والتأييد والحفظ والمحبة.","teaches":"الحقائق التي كشفتها المواضع:\n1. الولاية حركة: يخرجك من الظلمات إلى النور — والاتجاه يكشف الولي.\n2. لا تسقط بلحظة وهن: كان وليَّ الطائفتين الهامّتين بالفشل.\n3. تُكتسب بالاتباع والعمل والتقوى والصلاح — لا بالنسب والدعوى.\n4. الولي الحق معياره: يُطعم ولا يُطعَم، ويحيي الموتى — وكل وليٍّ سواه يسقط بالمعيار.\n5. شبكة الظالمين أفقية هشة، وولاية المتقين عليا واحدة.","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- عند الوهن والهمّ بالتراجع عن طريق خير (آل عمران 122).\n- عند اختيار التحالفات والولاءات.\n- في قمة نجاحك (دعاء يوسف)، وفي قلب كارثتك (دعاء موسى).","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. في الأزمات: تقديم الولاية قبل الطلب — ﴿أَنْتَ وَلِيُّنَا فَاغْفِرْ لَنَا وَارْحَمْنَا﴾ — الأعراف 155.\n2. في قمم النجاح: دعاء يوسف — ﴿أَنْتَ وَلِيِّي فِي الدُّنْيَا وَالْآخِرَةِ تَوَفَّنِي مُسْلِمًا وَأَلْحِقْنِي بِالصَّالِحِينَ﴾ — يوسف 101.\n3. إعلان الولاية: ﴿إِنَّ وَلِيِّيَ اللَّهُ الَّذِي نَزَّلَ الْكِتَابَ﴾ — الأعراف 196.\n4. عند الهمّ بالفشل: طلب التثبيت من وليّ الهامّين — آل عمران 122.\n5. طلب الإخراج من الظلمات إلى النور — البقرة 257.\n6. من السنة — دعاء القنوت: «...إِنَّهُ لَا يَذِلُّ مَنْ وَالَيْتَ» — رواه أصحاب السنن وصحح.","summary":"وليٌّ حتى في لحظة وهنك: ﴿إِذْ هَمَّتْ طَائِفَتَانِ مِنْكُمْ أَنْ تَفْشَلَا وَاللَّهُ وَلِيُّهُمَا﴾ — فأعلنها كيوسف في قمتك، وكموسى في كارثتك: أنت وليّي في الدنيا والآخرة.","verses":[{"i":1,"of":13,"s":2,"surah":"البقرة","a":257,"text":"اللَّهُ وَلِيُّ الَّذِينَ آمَنُوا يُخْرِجُهُمْ مِنَ الظُّلُمَاتِ إِلَى النُّورِ وَالَّذِينَ كَفَرُوا أَوْلِيَاؤُهُمُ الطَّاغُوتُ يُخْرِجُونَهُمْ مِنَ النُّورِ إِلَى الظُّلُمَاتِ أُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ","prev":{"a":256,"text":"لَا إِكْرَاهَ فِي الدِّينِ قَدْ تَبَيَّنَ الرُّشْدُ مِنَ الْغَيِّ فَمَنْ يَكْفُرْ بِالطَّاغُوتِ وَيُؤْمِنْ بِاللَّهِ فَقَدِ اسْتَمْسَكَ بِالْعُرْوَةِ الْوُثْقَى لَا انْفِصَامَ لَهَا وَاللَّهُ سَمِيعٌ عَلِيمٌ"},"next":{"a":258,"text":"أَلَمْ تَرَ إِلَى الَّذِي حَاجَّ إِبْرَاهِيمَ فِي رَبِّهِ أَنْ آتَاهُ اللَّهُ الْمُلْكَ إِذْ قَالَ إِبْرَاهِيمُ رَبِّيَ الَّذِي يُحْيِي وَيُمِيتُ قَالَ أَنَا أُحْيِي وَأُمِيتُ قَالَ إِبْرَاهِيمُ فَإِنَّ اللَّهَ يَأْتِي بِالشَّمْسِ مِنَ الْمَشْرِقِ فَأْتِ بِهَا مِنَ الْمَغْرِبِ فَبُهِتَ الَّذِي كَفَرَ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ"},"context":"﴿اللَّهُ وَلِيُّ الَّذِينَ آمَنُوا يُخْرِجُهُمْ مِنَ الظُّلُمَاتِ إِلَى النُّورِ وَالَّذِينَ كَفَرُوا أَوْلِيَاؤُهُمُ الطَّاغُوتُ يُخْرِجُونَهُمْ مِنَ النُّورِ إِلَى الظُّلُمَاتِ﴾ — بعد آية الكرسي وآية لا إكراه في الدين.","reason":"عُرّفت الولاية بأثرها الحركي: الإخراج من الظلمات إلى النور — فولاية الله ليست شعارًا بل حركةً دائمة بك نحو النور: من ظلمة الجهل والشهوة والشبهة إلى نور اليقين. والمقابلة كاشفة: أولياء الطاغوت يعكسون الاتجاه.","adds":"اختبار عملي لولايتك: انظر إلى اتجاه حركتك — نحو النور أم نحو الظلمات؟ فالاتجاه يكشف الولي."},{"i":2,"of":13,"s":3,"surah":"آل عمران","a":68,"text":"إِنَّ أَوْلَى النَّاسِ بِإِبْرَاهِيمَ لَلَّذِينَ اتَّبَعُوهُ وَهَذَا النَّبِيُّ وَالَّذِينَ آمَنُوا وَاللَّهُ وَلِيُّ الْمُؤْمِنِينَ","prev":{"a":67,"text":"مَا كَانَ إِبْرَاهِيمُ يَهُودِيًّا وَلَا نَصْرَانِيًّا وَلَكِنْ كَانَ حَنِيفًا مُسْلِمًا وَمَا كَانَ مِنَ الْمُشْرِكِينَ"},"next":{"a":69,"text":"وَدَّتْ طَائِفَةٌ مِنْ أَهْلِ الْكِتَابِ لَوْ يُضِلُّونَكُمْ وَمَا يُضِلُّونَ إِلَّا أَنْفُسَهُمْ وَمَا يَشْعُرُونَ"},"context":"﴿إِنَّ أَوْلَى النَّاسِ بِإِبْرَاهِيمَ لَلَّذِينَ اتَّبَعُوهُ وَهَذَا النَّبِيُّ وَالَّذِينَ آمَنُوا وَاللَّهُ وَلِيُّ الْمُؤْمِنِينَ﴾ — ردًّا على ادعاء اليهود والنصارى الانتسابَ لإبراهيم.","reason":"حُسمت قرابة إبراهيم بالاتباع لا بالنسب والدعوى — ثم عُمّمت الولاية: ﴿وَاللَّهُ وَلِيُّ الْمُؤْمِنِينَ﴾: رابطة الإيمان تصل المؤمنين عبر العصور بولاية واحدة، فولي إبراهيم هو ولي أتباعه إلى اليوم.","adds":"انتسابك للأنبياء بقدر اتباعك — والولاية الجامعة تصلك بموكب الإيمان كله."},{"i":3,"of":13,"s":3,"surah":"آل عمران","a":122,"text":"إِذْ هَمَّتْ طَائِفَتَانِ مِنْكُمْ أَنْ تَفْشَلَا وَاللَّهُ وَلِيُّهُمَا وَعَلَى اللَّهِ فَلْيَتَوَكَّلِ الْمُؤْمِنُونَ","prev":{"a":121,"text":"وَإِذْ غَدَوْتَ مِنْ أَهْلِكَ تُبَوِّئُ الْمُؤْمِنِينَ مَقَاعِدَ لِلْقِتَالِ وَاللَّهُ سَمِيعٌ عَلِيمٌ"},"next":{"a":123,"text":"وَلَقَدْ نَصَرَكُمُ اللَّهُ بِبَدْرٍ وَأَنْتُمْ أَذِلَّةٌ فَاتَّقُوا اللَّهَ لَعَلَّكُمْ تَشْكُرُونَ"},"context":"في أُحد: ﴿إِذْ هَمَّتْ طَائِفَتَانِ مِنْكُمْ أَنْ تَفْشَلَا وَاللَّهُ وَلِيُّهُمَا وَعَلَى اللَّهِ فَلْيَتَوَكَّلِ الْمُؤْمِنُونَ﴾ — بنو سلمة وبنو حارثة همّتا بالرجوع مع من رجع.","reason":"أعجبُ ما في الآية: طائفتان همّتا بالفشل والانسحاب — وفي اللحظة نفسها: ﴿وَاللَّهُ وَلِيُّهُمَا﴾! فالولاية لم تسقط بلحظة الوهن، بل تداركتهما فثبّتتا ومضتا. قال جابر: ما يسرني أنها لم تنزل — لقوله ﴿وَاللَّهُ وَلِيُّهُمَا﴾.","adds":"أرجى آيةٍ لكل من همّ بالتراجع عن طريق الخير ثم استحيا: همُّك بالضعف لا يقطع ولايته ما لم تمضِ فيه — بل قد يكون شاهدَ تثبيته لك."},{"i":4,"of":13,"s":4,"surah":"النساء","a":45,"text":"وَاللَّهُ أَعْلَمُ بِأَعْدَائِكُمْ وَكَفَى بِاللَّهِ وَلِيًّا وَكَفَى بِاللَّهِ نَصِيرًا","prev":{"a":44,"text":"أَلَمْ تَرَ إِلَى الَّذِينَ أُوتُوا نَصِيبًا مِنَ الْكِتَابِ يَشْتَرُونَ الضَّلَالَةَ وَيُرِيدُونَ أَنْ تَضِلُّوا السَّبِيلَ"},"next":{"a":46,"text":"مِنَ الَّذِينَ هَادُوا يُحَرِّفُونَ الْكَلِمَ عَنْ مَوَاضِعِهِ وَيَقُولُونَ سَمِعْنَا وَعَصَيْنَا وَاسْمَعْ غَيْرَ مُسْمَعٍ وَرَاعِنَا لَيًّا بِأَلْسِنَتِهِمْ وَطَعْنًا فِي الدِّينِ وَلَوْ أَنَّهُمْ قَالُوا سَمِعْنَا وَأَطَعْنَا وَاسْمَعْ وَانْظُرْنَا لَكَانَ خَيْرًا لَهُمْ وَأَقْوَمَ وَلَكِنْ لَعَنَهُمُ اللَّهُ بِكُفْرِهِمْ فَلَا يُؤْمِنُونَ إِلَّا قَلِيلًا"},"context":"تحذّر الآية التي قبلها من الذين أوتوا نصيبًا من الكتاب، يشترون الضلالة ويريدون أن يضلّ المؤمنون السبيل، وتكشف الآية التي بعدها طرفًا من فعلهم: تحريف الكلم عن مواضعه والطعن في الدين. وبين الموضعين تأتي هذه الآية تطمئن المؤمنين: ﴿وَاللَّهُ أَعْلَمُ بِأَعْدَائِكُمْ﴾.","reason":"بعد أن كشف السياق عداوةً خفيّةً تسعى لإضلالهم، لم يَكِلهم إلى حيلتهم وحدها؛ بل ذكّرهم بأنه أعلم بأعدائهم منهم، ثم قال: ﴿وَكَفَى بِاللَّهِ وَلِيًّا﴾ — فالوليّ هو الذي يتولّى أمرهم ويحفظ عليهم دينهم من كيدٍ لا يرونه، وقُرن به النصير ليجتمع لهم الحفظ في الخفاء والنصر في الظاهر.","adds":"من خاف كيدًا لا يراه فحسبُه أن الله أعلم بعدوّه منه، وأنه كفى به وليًّا يتولّاه ونصيرًا ينصره.","draft":true},{"i":5,"of":13,"s":5,"surah":"المائدة","a":55,"text":"إِنَّمَا وَلِيُّكُمُ اللَّهُ وَرَسُولُهُ وَالَّذِينَ آمَنُوا الَّذِينَ يُقِيمُونَ الصَّلَاةَ وَيُؤْتُونَ الزَّكَاةَ وَهُمْ رَاكِعُونَ","prev":{"a":54,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا مَنْ يَرْتَدَّ مِنْكُمْ عَنْ دِينِهِ فَسَوْفَ يَأْتِي اللَّهُ بِقَوْمٍ يُحِبُّهُمْ وَيُحِبُّونَهُ أَذِلَّةٍ عَلَى الْمُؤْمِنِينَ أَعِزَّةٍ عَلَى الْكَافِرِينَ يُجَاهِدُونَ فِي سَبِيلِ اللَّهِ وَلَا يَخَافُونَ لَوْمَةَ لَائِمٍ ذَلِكَ فَضْلُ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ"},"next":{"a":56,"text":"وَمَنْ يَتَوَلَّ اللَّهَ وَرَسُولَهُ وَالَّذِينَ آمَنُوا فَإِنَّ حِزْبَ اللَّهِ هُمُ الْغَالِبُونَ"},"reason":"حصرت ﴿إِنَّمَا﴾ شبكةَ الولاء في ثلاث حلقات متصلة: الله، فرسوله، فالمؤمنون الموصوفون بالصلاة والزكاة والخضوع — فخريطة ولاءات المؤمن محسومة قرآنيًا، لا تتوزع على من حادّ الله ورسوله.","adds":"راجع خريطة ولاءاتك على هذه الآية: من تنصر وتحب وتقدم؟ — الحلقات الثلاث بالترتيب."},{"i":6,"of":13,"s":6,"surah":"الأنعام","a":14,"text":"قُلْ أَغَيْرَ اللَّهِ أَتَّخِذُ وَلِيًّا فَاطِرِ السَّمَاوَاتِ وَالْأَرْضِ وَهُوَ يُطْعِمُ وَلَا يُطْعَمُ قُلْ إِنِّي أُمِرْتُ أَنْ أَكُونَ أَوَّلَ مَنْ أَسْلَمَ وَلَا تَكُونَنَّ مِنَ الْمُشْرِكِينَ","prev":{"a":13,"text":"وَلَهُ مَا سَكَنَ فِي اللَّيْلِ وَالنَّهَارِ وَهُوَ السَّمِيعُ الْعَلِيمُ"},"next":{"a":15,"text":"قُلْ إِنِّي أَخَافُ إِنْ عَصَيْتُ رَبِّي عَذَابَ يَوْمٍ عَظِيمٍ"},"reason":"وُضع معيار اختيار الولي: فاطرُ السماوات والأرض — فولايته عن قدرة إنشاء — و﴿يُطْعِمُ وَلَا يُطْعَمُ﴾: يعطيك ولا يحتاج منك شيئًا. فكل وليٍّ سواه يأخذ منك بقدر ما يعطيك أو أكثر — والولي الحق من عطاؤه بلا مقابل.","adds":"معيار فرز الأولياء في كلمتين: هل يُطعم ولا يُطعَم؟ — طبّقه على كل جهةٍ تطلب ولاءك."},{"i":7,"of":13,"s":6,"surah":"الأنعام","a":127,"text":"لَهُمْ دَارُ السَّلَامِ عِنْدَ رَبِّهِمْ وَهُوَ وَلِيُّهُمْ بِمَا كَانُوا يَعْمَلُونَ","prev":{"a":126,"text":"وَهَذَا صِرَاطُ رَبِّكَ مُسْتَقِيمًا قَدْ فَصَّلْنَا الْآيَاتِ لِقَوْمٍ يَذَّكَّرُونَ"},"next":{"a":128,"text":"وَيَوْمَ يَحْشُرُهُمْ جَمِيعًا يَا مَعْشَرَ الْجِنِّ قَدِ اسْتَكْثَرْتُمْ مِنَ الْإِنْسِ وَقَالَ أَوْلِيَاؤُهُمْ مِنَ الْإِنْسِ رَبَّنَا اسْتَمْتَعَ بَعْضُنَا بِبَعْضٍ وَبَلَغْنَا أَجَلَنَا الَّذِي أَجَّلْتَ لَنَا قَالَ النَّارُ مَثْوَاكُمْ خَالِدِينَ فِيهَا إِلَّا مَا شَاءَ اللَّهُ إِنَّ رَبَّكَ حَكِيمٌ عَلِيمٌ"},"context":"﴿لَهُمْ دَارُ السَّلَامِ عِنْدَ رَبِّهِمْ وَهُوَ وَلِيُّهُمْ بِمَا كَانُوا يَعْمَلُونَ﴾ — في الذين يذّكّرون بعد بيان الصراط المستقيم.","reason":"عُلّقت الولاية بالعمل: ﴿بِمَا كَانُوا يَعْمَلُونَ﴾ — فهي مكتسبة بالسلوك لا موروثة بالدعوى، وثمرتها مزدوجة: دار السلام عند ربهم، وولايته لهم في الطريق إليها.","adds":"الولاية درجة تُكتسب بالعمل — فمن أراد أن يتولاه الله فليعمل عمل أوليائه."},{"i":8,"of":13,"s":7,"surah":"الأعراف","a":155,"text":"وَاخْتَارَ مُوسَى قَوْمَهُ سَبْعِينَ رَجُلًا لِمِيقَاتِنَا فَلَمَّا أَخَذَتْهُمُ الرَّجْفَةُ قَالَ رَبِّ لَوْ شِئْتَ أَهْلَكْتَهُمْ مِنْ قَبْلُ وَإِيَّايَ أَتُهْلِكُنَا بِمَا فَعَلَ السُّفَهَاءُ مِنَّا إِنْ هِيَ إِلَّا فِتْنَتُكَ تُضِلُّ بِهَا مَنْ تَشَاءُ وَتَهْدِي مَنْ تَشَاءُ أَنْتَ وَلِيُّنَا فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الْغَافِرِينَ","prev":{"a":154,"text":"وَلَمَّا سَكَتَ عَنْ مُوسَى الْغَضَبُ أَخَذَ الْأَلْوَاحَ وَفِي نُسْخَتِهَا هُدًى وَرَحْمَةٌ لِلَّذِينَ هُمْ لِرَبِّهِمْ يَرْهَبُونَ"},"next":{"a":156,"text":"وَاكْتُبْ لَنَا فِي هَذِهِ الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ إِنَّا هُدْنَا إِلَيْكَ قَالَ عَذَابِي أُصِيبُ بِهِ مَنْ أَشَاءُ وَرَحْمَتِي وَسِعَتْ كُلَّ شَيْءٍ فَسَأَكْتُبُهَا لِلَّذِينَ يَتَّقُونَ وَيُؤْتُونَ الزَّكَاةَ وَالَّذِينَ هُمْ بِآيَاتِنَا يُؤْمِنُونَ"},"context":"بعد الرجفة التي أخذت السبعين المختارين، توسل موسى ثم قال: ﴿أَنْتَ وَلِيُّنَا فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الْغَافِرِينَ﴾.","reason":"في قلب الكارثة الجماعية قدّم موسى الولاية بين يدي الطلب: ﴿أَنْتَ وَلِيُّنَا﴾ ثم ﴿فَاغْفِرْ لَنَا وَارْحَمْنَا﴾ — فالولي يُتحمَّل عنده في الكوارث، والتوسل بولايته مفتاح المغفرة والرحمة بعدها.","adds":"أدب دعاء الأزمات: أعلن الولاية أولًا — «أنت ولينا» — ثم اطلب: فالطلب على قدر العلاقة."},{"i":9,"of":13,"s":7,"surah":"الأعراف","a":196,"text":"إِنَّ وَلِيِّيَ اللَّهُ الَّذِي نَزَّلَ الْكِتَابَ وَهُوَ يَتَوَلَّى الصَّالِحِينَ","prev":{"a":195,"text":"أَلَهُمْ أَرْجُلٌ يَمْشُونَ بِهَا أَمْ لَهُمْ أَيْدٍ يَبْطِشُونَ بِهَا أَمْ لَهُمْ أَعْيُنٌ يُبْصِرُونَ بِهَا أَمْ لَهُمْ آذَانٌ يَسْمَعُونَ بِهَا قُلِ ادْعُوا شُرَكَاءَكُمْ ثُمَّ كِيدُونِ فَلَا تُنْظِرُونِ"},"next":{"a":197,"text":"وَالَّذِينَ تَدْعُونَ مِنْ دُونِهِ لَا يَسْتَطِيعُونَ نَصْرَكُمْ وَلَا أَنْفُسَهُمْ يَنْصُرُونَ"},"context":"﴿إِنَّ وَلِيِّيَ اللَّهُ الَّذِي نَزَّلَ الْكِتَابَ وَهُوَ يَتَوَلَّى الصَّالِحِينَ﴾ — إعلان النبي ﷺ أمام من يدعون من دونه ما لا ينصرهم.","reason":"أعلن النبي ﷺ وليَّه بدليلين: ﴿نَزَّلَ الْكِتَابَ﴾ — فولايته موثقة بوحيه وعهده — و﴿يَتَوَلَّى الصَّالِحِينَ﴾ — سنته الجارية في كل صالح. فالباب مفتوح: من دخل في الصلاح دخل في التولّي.","adds":"طريق دخولك في ولايته مكتوب في الآية: الصلاح — فهو يتولى الصالحين، سنةً لا تتخلف."},{"i":10,"of":13,"s":12,"surah":"يوسف","a":101,"text":"رَبِّ قَدْ آتَيْتَنِي مِنَ الْمُلْكِ وَعَلَّمْتَنِي مِنْ تَأْوِيلِ الْأَحَادِيثِ فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ أَنْتَ وَلِيِّي فِي الدُّنْيَا وَالْآخِرَةِ تَوَفَّنِي مُسْلِمًا وَأَلْحِقْنِي بِالصَّالِحِينَ","prev":{"a":100,"text":"وَرَفَعَ أَبَوَيْهِ عَلَى الْعَرْشِ وَخَرُّوا لَهُ سُجَّدًا وَقَالَ يَا أَبَتِ هَذَا تَأْوِيلُ رُؤْيَايَ مِنْ قَبْلُ قَدْ جَعَلَهَا رَبِّي حَقًّا وَقَدْ أَحْسَنَ بِي إِذْ أَخْرَجَنِي مِنَ السِّجْنِ وَجَاءَ بِكُمْ مِنَ الْبَدْوِ مِنْ بَعْدِ أَنْ نَزَغَ الشَّيْطَانُ بَيْنِي وَبَيْنَ إِخْوَتِي إِنَّ رَبِّي لَطِيفٌ لِمَا يَشَاءُ إِنَّهُ هُوَ الْعَلِيمُ الْحَكِيمُ"},"next":{"a":102,"text":"ذَلِكَ مِنْ أَنْبَاءِ الْغَيْبِ نُوحِيهِ إِلَيْكَ وَمَا كُنْتَ لَدَيْهِمْ إِذْ أَجْمَعُوا أَمْرَهُمْ وَهُمْ يَمْكُرُونَ"},"context":"يوسف في قمة التمكين — الملك والعلم واجتماع الشمل: ﴿رَبِّ قَدْ آتَيْتَنِي مِنَ الْمُلْكِ وَعَلَّمْتَنِي مِنْ تَأْوِيلِ الْأَحَادِيثِ فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ أَنْتَ وَلِيِّي فِي الدُّنْيَا وَالْآخِرَةِ تَوَفَّنِي مُسْلِمًا وَأَلْحِقْنِي بِالصَّالِحِينَ﴾.","reason":"في ذروة النجاح لم يسأل يوسفُ مزيدَ ملك، بل أعلن الولاية في الدارين وسأل حسنَ الخاتمة: ﴿تَوَفَّنِي مُسْلِمًا﴾ — فمن كان الله وليَّه في الدنيا والآخرة، صار همُّه الأكبر أن يلقاه على الإسلام لا أن يزيد رصيده.","adds":"دعاء قمم النجاح: حين تبلغ ما تريد، قل قول يوسف — فالقمم مزالق إلا لمن اعتصم بوليّه وسأل الخاتمة."},{"i":11,"of":13,"s":34,"surah":"سبأ","a":41,"text":"قَالُوا سُبْحَانَكَ أَنْتَ وَلِيُّنَا مِنْ دُونِهِمْ بَلْ كَانُوا يَعْبُدُونَ الْجِنَّ أَكْثَرُهُمْ بِهِمْ مُؤْمِنُونَ","prev":{"a":40,"text":"وَيَوْمَ يَحْشُرُهُمْ جَمِيعًا ثُمَّ يَقُولُ لِلْمَلَائِكَةِ أَهَؤُلَاءِ إِيَّاكُمْ كَانُوا يَعْبُدُونَ"},"next":{"a":42,"text":"فَالْيَوْمَ لَا يَمْلِكُ بَعْضُكُمْ لِبَعْضٍ نَفْعًا وَلَا ضَرًّا وَنَقُولُ لِلَّذِينَ ظَلَمُوا ذُوقُوا عَذَابَ النَّارِ الَّتِي كُنْتُمْ بِهَا تُكَذِّبُونَ"},"context":"يوم القيامة يُسأل الملائكة: أهؤلاء إياكم كانوا يعبدون؟ ﴿قَالُوا سُبْحَانَكَ أَنْتَ وَلِيُّنَا مِنْ دُونِهِمْ بَلْ كَانُوا يَعْبُدُونَ الْجِنَّ﴾.","reason":"تبرأ الملائكةُ ممن عبدوهم بإعلان الولاية الحصرية: ﴿أَنْتَ وَلِيُّنَا مِنْ دُونِهِمْ﴾ — فالمعبودون الصالحون أولياءُ لله لا لعابديهم، وكلُّ من غلا في صالحٍ فسيتبرأ منه الصالحُ يومئذ.","adds":"من توّلى مخلوقًا صالحًا بالعبادة والغلو، تبرأ منه ذلك الصالح يوم أحوج ما يكون إليه."},{"i":12,"of":13,"s":42,"surah":"الشورى","a":9,"text":"أَمِ اتَّخَذُوا مِنْ دُونِهِ أَوْلِيَاءَ فَاللَّهُ هُوَ الْوَلِيُّ وَهُوَ يُحْيِي الْمَوْتَى وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":8,"text":"وَلَوْ شَاءَ اللَّهُ لَجَعَلَهُمْ أُمَّةً وَاحِدَةً وَلَكِنْ يُدْخِلُ مَنْ يَشَاءُ فِي رَحْمَتِهِ وَالظَّالِمُونَ مَا لَهُمْ مِنْ وَلِيٍّ وَلَا نَصِيرٍ"},"next":{"a":10,"text":"وَمَا اخْتَلَفْتُمْ فِيهِ مِنْ شَيْءٍ فَحُكْمُهُ إِلَى اللَّهِ ذَلِكُمُ اللَّهُ رَبِّي عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ أُنِيبُ"},"reason":"جاء الحصر بضمير الفصل: ﴿فَاللَّهُ هُوَ الْوَلِيُّ﴾ — الولي الحق واحد — وبرهانه: يحيي الموتى وهو على كل شيء قدير: فالولي الحق من يملك أعظم حاجاتك — حياتَك بعد موتك — لا من يعجز عن نفع نفسه.","adds":"قِس كل وليٍّ مزعوم بهذا البرهان: أيحيي الموتى؟ أعَلى كل شيء قدير؟ — يسقط الادعاء بالسؤال."},{"i":13,"of":13,"s":45,"surah":"الجاثية","a":19,"text":"إِنَّهُمْ لَنْ يُغْنُوا عَنْكَ مِنَ اللَّهِ شَيْئًا وَإِنَّ الظَّالِمِينَ بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ وَاللَّهُ وَلِيُّ الْمُتَّقِينَ","prev":{"a":18,"text":"ثُمَّ جَعَلْنَاكَ عَلَى شَرِيعَةٍ مِنَ الْأَمْرِ فَاتَّبِعْهَا وَلَا تَتَّبِعْ أَهْوَاءَ الَّذِينَ لَا يَعْلَمُونَ"},"next":{"a":20,"text":"هَذَا بَصَائِرُ لِلنَّاسِ وَهُدًى وَرَحْمَةٌ لِقَوْمٍ يُوقِنُونَ"},"context":"﴿وَإِنَّ الظَّالِمِينَ بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ وَاللَّهُ وَلِيُّ الْمُتَّقِينَ﴾ — بعد بيان أن أهواءهم لن تغني عنك من الله شيئًا.","reason":"قابلت الآية شبكتين: الظالمون ﴿بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ﴾ — تحالفُ مصالح هشّ يتخاذل ساعة الجد — والمتقون وليُّهم واحدٌ أعلى: الله. فشتان بين شبكةٍ أفقية من العاجزين وولايةٍ عليا من القدير.","adds":"لا تُرهبك تحالفات أهل الباطل مهما اتسعت — هي «بعضهم أولياء بعض»: عاجزٌ يستند إلى عاجز."}],"hadiths":[{"i":1,"of":1,"text":"«كان يَقولُ: يا وَلِيَّ الإسلامِ وأهْلِه ثَبِّتْني به حتَّى ألقاك».","narrator":"أنس بن مالك","source":"الأحاديث المختارة 2290","grade":"صحيح","judgment":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","url":"https://dorar.net/h/qIj7sI69","nameForm":"وَلِيَّ","scene":"أنس: كان النبي ﷺ يقول: «يا ولي الإسلام وأهله، ثبتني به حتى ألقاك».","reason":"الاسم مضاف إلى الإسلام وأهله: الذي يتولى الدين يتولى أهله؛ ثم المطلوب ثبات — لأن الولي هو الذي لا يترك من تولاه ينقلب. فالنبي ﷺ يطلب من ولي الدين أن يمسك عليه دينه حتى الموت.","adds":"يعطي الشاهد صيغة نداءٍ بالاسم مضافًا، غايتها حسن الخاتمة على الإسلام — فالولاية تُطلب للثبات لا للنصر فقط."}],"sunnah":{"card":"الصيغة: الْوَلِيُّ — مفردة\nفي السنة: شاهدان (4 روايات)\nخصوصية الورود في السنة: كان النبي ﷺ يدعو: «يا ولي الإسلام وأهله، ثبتني به حتى ألقاك» — نداءٌ بالاسم مضافًا إلى الدين وأهله؛ وورد الاسم مفردًا في تعداد الأسماء.\nالمعنى المختصر: الناصر المتولي لأمر عبده الذي يحبه، لا يكله إلى غيره.","teaches":"1. أنه ولي الدين وأهله: من دخل الإسلام دخل في ولايته.\n2. أن ولايته تُطلب لثبات القلب حتى الموت.\n3. أن ولايته من قوة: بعد القوي المتين في السرد.","whenRecall":"- حين تخاف على دينك من الانقلاب: «يا ولي الإسلام وأهله».\n- حين تشعر أن لا ناصر لك.\n- في إحصاء الأسماء.","whenPray":"عند الشعور بـ:\n1. الخوف من فتنة تسلب الدين.\n2. قلة الناصر.\nعند طلب:\n1. الثبات على الإسلام حتى الموت.\n2. أن يتولى الله أمرك.\nعند الرغبة في:\n1. الدعاء بالاسم مضافًا إلى دينك.","duaItems":"«يا ولي الإسلام وأهله، ثبتني به حتى ألقاك» — السلسلة الصحيحة 1823، والأحاديث المختارة 2290؛ وفي رواية: «مسّكني بالإسلام حتى ألقاك عليه» — شرح الطحاوية 373 (حسن).","summary":"«الولي» في السنة يُنادى مضافًا: «يا ولي الإسلام وأهله ثبتني به حتى ألقاك» — الذي يتولى الدين يتولى أهله، ويُطلب منه الثبات لا النصر فقط."},"situations":[{"situationId":1,"verses":[{"i":8,"strength":"direct","headline":"كارثةٌ مفاجئة تحلّ بك ومن معك بلا مخرج","bridge":"في قلب كارثةٍ لا مخرج منها؟ لما أخذت الرجفة السبعين قدّم موسى الولاية بين يدي الطلب: ﴿أَنْتَ وَلِيُّنَا فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الْغَافِرِينَ﴾ — أدب دعاء الأزمات: أعلن الولاية أولًا ثم اطلب؛ فالطلب على قدر العلاقة، والولي يُتحمَّل عنده في الكوارث."}],"hadiths":[]},{"situationId":6,"verses":[{"i":6,"strength":"direct","headline":"انقطاع من كنت تعتمد عليهم من الناس","bridge":"انقطع من كنت تعتمد عليهم؟ ما انقطعوا إلا لأنهم يحتاجون كما تحتاج؛ أما ﴿فَاطِرِ السَّمَاوَاتِ وَالْأَرْضِ وَهُوَ يُطْعِمُ وَلَا يُطْعَمُ﴾ فلا ينقطع عطاؤه لأنه لا يحتاج إلى عطائك — فمن اتخذه وليًّا لم يُترك."},{"i":9,"strength":"direct","headline":"تخلّي من كنت تعدّهم سندًا","bridge":"تخلّى عنك من كنت تعدّهم سندًا؟ أعلن ما أعلنه النبي ﷺ أمام من يدعون من دونه ما لا ينصرهم: ﴿إِنَّ وَلِيِّيَ اللَّهُ الَّذِي نَزَّلَ الْكِتَابَ وَهُوَ يَتَوَلَّى الصَّالِحِينَ﴾ — وليٌّ موثّقة ولايته بوحيه، وسنته الجارية أنه يتولى كل صالح؛ فادخل في الصلاح تدخل في التولّي."},{"i":12,"strength":"direct","headline":"فقد النصير وتخلّي من كنت تعدّهم سندًا","bridge":"بقيت بلا نصير؟ الولي الحق واحد بضمير الحصر: ﴿فَاللَّهُ هُوَ الْوَلِيُّ وَهُوَ يُحْيِي الْمَوْتَى وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — من يملك أعظم حاجاتك، حياتك بعد موتك، يملك أن يكون سندك في أصغرها؛ أما من تخلّى عنك فلا يملك لنفسه شيئًا."}],"hadiths":[]},{"situationId":30,"verses":[{"i":4,"strength":"direct","headline":"خوفٌ من كيدٍ خفي يستهدف دينك","bridge":"تخاف كيدًا خفيًّا يريد أن يضلّك عن دينك ولا تراه؟ ﴿وَاللَّهُ أَعْلَمُ بِأَعْدَائِكُمْ وَكَفَى بِاللَّهِ وَلِيًّا﴾ — فالوليّ يتولّى أمرك ويحفظ عليك دينك من كيدٍ لا تراه."}],"hadiths":[]},{"situationId":31,"verses":[{"i":13,"strength":"direct","headline":"رهبة تحالفات أهل الباطل ضدك","bridge":"تخلّى عنك أهل الباطل ورأيتهم متحالفين ضدك؟ الآية تقابل شبكتين: ﴿وَإِنَّ الظَّالِمِينَ بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ وَاللَّهُ وَلِيُّ الْمُتَّقِينَ﴾ — شبكة أفقية من العاجزين تتخاذل ساعة الجد، وولاية عليا من القدير لا تتخاذل؛ فاستند إلى الأعلى."}],"hadiths":[]},{"situationId":67,"verses":[{"i":2,"strength":"direct","headline":"اختيار الصحبة ومن تنتسب إليهم","bridge":"تختار من تنتسب إليهم؟ قرابة إبراهيم حُسمت بالاتباع لا بالنسب: ﴿إِنَّ أَوْلَى النَّاسِ بِإِبْرَاهِيمَ لَلَّذِينَ اتَّبَعُوهُ... وَاللَّهُ وَلِيُّ الْمُؤْمِنِينَ﴾ — فرابطة الإيمان تصلك بموكب الأنبياء كله، واختر صحبتك من الشبكة التي وليّها الله."},{"i":5,"strength":"direct","headline":"اختيار من تحالف وتقدّم وتنصر في علاقاتك","bridge":"تختار من تحالف ومن تقدّم؟ خريطة الولاء محسومة بأداة الحصر: ﴿إِنَّمَا وَلِيُّكُمُ اللَّهُ وَرَسُولُهُ وَالَّذِينَ آمَنُوا الَّذِينَ يُقِيمُونَ الصَّلَاةَ وَيُؤْتُونَ الزَّكَاةَ وَهُمْ رَاكِعُونَ﴾ — ثلاث حلقات بالترتيب؛ راجع عليها من تنصر وتحب وتقدّم."}],"hadiths":[]},{"situationId":78,"verses":[{"i":3,"strength":"direct","headline":"الهمّ بالتراجع عن طريق الخير ثم الاستحياء","bridge":"همّت نفسك بالتراجع عن طريق الخير ثم استحييت؟ طائفتان في أُحد همّتا بالفشل والانسحاب، وفي اللحظة نفسها قال الله: ﴿وَاللَّهُ وَلِيُّهُمَا﴾ — لم تسقط الولاية بلحظة الوهن بل تداركتهما فثبتتا؛ قال جابر: ما يسرني أنها لم تنزل. فهمّك بالضعف لا يقطع ولايته ما لم تمضِ فيه."},{"i":7,"strength":"direct","headline":"طلب الثبات وولاية الله بالعمل الصالح","bridge":"تريد أن يثبّتك؟ الولاية تُكتسب بالسلوك لا بالدعوى: ﴿وَهُوَ وَلِيُّهُمْ بِمَا كَانُوا يَعْمَلُونَ﴾ — فمن أراد أن يتولاه الله فليعمل عمل أوليائه، والثبات ثمرةُ ولايةٍ تُستجلب بالعمل."}],"hadiths":[]},{"situationId":96,"verses":[{"i":11,"strength":"direct","headline":"الغلوّ في الصالحين والتعلّق بهم من دون الله","bridge":"تعلّقت بصالحٍ حتى غلوت فيه؟ الملائكة الذين عُبدوا تبرؤوا من عابديهم: ﴿سُبْحَانَكَ أَنْتَ وَلِيُّنَا مِنْ دُونِهِمْ بَلْ كَانُوا يَعْبُدُونَ الْجِنَّ﴾ — المعبودون الصالحون أولياء لله لا لعابديهم؛ فمن غلا في صالحٍ تبرأ منه ذلك الصالح يوم أحوج ما يكون إليه."}],"hadiths":[]},{"situationId":114,"verses":[{"i":1,"strength":"direct","headline":"خوف انقلاب القلب والرجوع إلى الظلمات","bridge":"تخاف أن ينقلب قلبك؟ ولاية الله ليست شعارًا بل حركةٌ دائمة بك: ﴿اللَّهُ وَلِيُّ الَّذِينَ آمَنُوا يُخْرِجُهُمْ مِنَ الظُّلُمَاتِ إِلَى النُّورِ﴾ — فاختبر ولايتك باتجاه حركتك: ما دمت تتحرك نحو النور فوليّك يُخرجك، والانقلاب إنما يقع لمن عكس الاتجاه."}],"hadiths":[]},{"situationId":115,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"الخوف من سوء الخاتمة والانقلاب عن الدين","bridge":"تخاف أن تُختم حياتك على غير ما تحب؟ «ثبتني به حتى ألقاك» — اطلب من الولي أن يُمسك عليك الإسلام إلى لقائه."}]},{"situationId":150,"verses":[{"i":10,"strength":"direct","headline":"بلوغ القمة والخوف من فتنة النجاح","bridge":"بلغتَ ما تريد وتخاف الفتنة؟ يوسف في قمة الملك والعلم واجتماع الشمل لم يسأل مزيدًا، بل: ﴿أَنْتَ وَلِيِّي فِي الدُّنْيَا وَالْآخِرَةِ تَوَفَّنِي مُسْلِمًا وَأَلْحِقْنِي بِالصَّالِحِينَ﴾ — دعاء القمم: من كان الله وليّه صار همّه أن يلقاه على الإسلام لا أن يزيد رصيده."}],"hadiths":[]}]},{"id":50,"name":"الغفور الحليم","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: غَفُورٌ حَلِيمٌ — مركّبة | المواضع: 4 (البقرة: 225، 235 — آل عمران: 155 — المائدة: 101)\nخصوصية: مواضعه الأربعة كلها في أرقّ مواطن الضعف البشري الملازم: لغو اللسان، وخطرات القلب نحو النساء، وفرار المعركة، وفضول الأسئلة — فهو اسم السعة مع الطبيعة البشرية.\n\nالمعنى:\n- الغفور: الساتر لما وقع.\n- الحليم: الذي لا يعاجل بالعقوبة لما بقي.\nسر الاقتران: مغفرةٌ للماضي وإمهالٌ للحاضر — سعة مزدوجة تناسب ضعفًا ملازمًا.","teaches":"الحقائق التي كشفتها المواضع:\n1. ميزان المؤاخذة كسبُ القلوب لا لغو الألسنة.\n2. خطرات الفطرة معلومة له وغير مؤاخذٍ بها — فالتشريع لبشر.\n3. الزلات الكبرى للصادقين — حتى الفرار من الزحف — يسعها العفو المعلن.\n4. ما سكت عنه الشرع عفوٌ مقصود — فلا تنقّب.","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- عند أيمان اللغو الجارية على لسانك بلا قصد.\n- عند خواطر لا تملك دفعها فتجلد نفسك عليها.\n- بعد انهيارك في موقف اختبارٍ كبير كنت ترجو فيه الثبات.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. طلب سلامة مكسب القلب — فهو مناط الحساب: «اللهم طهّر قلبي» — البقرة 225.\n2. بعد زلة كبرى: طلب العفو بلا يأس — فقد أُعلن العفو عن فارّي أُحد — آل عمران 155.\n3. الاستعاذة من ذنوبٍ تفتح ثغرات الزلل: ﴿بِبَعْضِ مَا كَسَبُوا﴾.\n4. من دعاء الكرب: «لَا إِلَهَ إِلَّا اللَّهُ الْعَظِيمُ الْحَلِيمُ» — متفق عليه.","summary":"يعرف لغوَ لسانك وخطراتِ قلبك وزلاتِ مواقفك — ومع ذلك: ﴿غَفُورٌ حَلِيمٌ﴾: يغفر ما وقع ويمهل ما بقي — فالميزان ما كسب قلبُك، لا ما جرى به لسانك.","verses":[{"i":1,"of":4,"s":2,"surah":"البقرة","a":225,"text":"لَا يُؤَاخِذُكُمُ اللَّهُ بِاللَّغْوِ فِي أَيْمَانِكُمْ وَلَكِنْ يُؤَاخِذُكُمْ بِمَا كَسَبَتْ قُلُوبُكُمْ وَاللَّهُ غَفُورٌ حَلِيمٌ","prev":{"a":224,"text":"وَلَا تَجْعَلُوا اللَّهَ عُرْضَةً لِأَيْمَانِكُمْ أَنْ تَبَرُّوا وَتَتَّقُوا وَتُصْلِحُوا بَيْنَ النَّاسِ وَاللَّهُ سَمِيعٌ عَلِيمٌ"},"next":{"a":226,"text":"لِلَّذِينَ يُؤْلُونَ مِنْ نِسَائِهِمْ تَرَبُّصُ أَرْبَعَةِ أَشْهُرٍ فَإِنْ فَاءُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ"},"context":"﴿لَا يُؤَاخِذُكُمُ اللَّهُ بِاللَّغْوِ فِي أَيْمَانِكُمْ وَلَكِنْ يُؤَاخِذُكُمْ بِمَا كَسَبَتْ قُلُوبُكُمْ وَاللَّهُ غَفُورٌ حَلِيمٌ﴾ — لغو اليمين: ما يجري على اللسان بلا قصد عقد: «لا والله» و«بلى والله».","reason":"وضعت الآية ميزان المؤاخذة في القلب لا اللسان: ما لغا به لسانك بلا قصدٍ معفوٌّ عنه، والحسابُ على ﴿مَا كَسَبَتْ قُلُوبُكُمْ﴾. فالغفور يستر لغوَ الألسنة الجارية، والحليم لا يعاجل بما تكسب القلوب — بل يمهل للتوبة.","adds":"قاعدة ذهبية في كل الديانة: العبرة بقصد القلب — فطهّر مكسبَ قلبك ولا تُرهق نفسك بجريان لسانك."},{"i":2,"of":4,"s":2,"surah":"البقرة","a":235,"text":"وَلَا جُنَاحَ عَلَيْكُمْ فِيمَا عَرَّضْتُمْ بِهِ مِنْ خِطْبَةِ النِّسَاءِ أَوْ أَكْنَنْتُمْ فِي أَنْفُسِكُمْ عَلِمَ اللَّهُ أَنَّكُمْ سَتَذْكُرُونَهُنَّ وَلَكِنْ لَا تُوَاعِدُوهُنَّ سِرًّا إِلَّا أَنْ تَقُولُوا قَوْلًا مَعْرُوفًا وَلَا تَعْزِمُوا عُقْدَةَ النِّكَاحِ حَتَّى يَبْلُغَ الْكِتَابُ أَجَلَهُ وَاعْلَمُوا أَنَّ اللَّهَ يَعْلَمُ مَا فِي أَنْفُسِكُمْ فَاحْذَرُوهُ وَاعْلَمُوا أَنَّ اللَّهَ غَفُورٌ حَلِيمٌ","prev":{"a":234,"text":"وَالَّذِينَ يُتَوَفَّوْنَ مِنْكُمْ وَيَذَرُونَ أَزْوَاجًا يَتَرَبَّصْنَ بِأَنْفُسِهِنَّ أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا فَإِذَا بَلَغْنَ أَجَلَهُنَّ فَلَا جُنَاحَ عَلَيْكُمْ فِيمَا فَعَلْنَ فِي أَنْفُسِهِنَّ بِالْمَعْرُوفِ وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ"},"next":{"a":236,"text":"لَا جُنَاحَ عَلَيْكُمْ إِنْ طَلَّقْتُمُ النِّسَاءَ مَا لَمْ تَمَسُّوهُنَّ أَوْ تَفْرِضُوا لَهُنَّ فَرِيضَةً وَمَتِّعُوهُنَّ عَلَى الْمُوسِعِ قَدَرُهُ وَعَلَى الْمُقْتِرِ قَدَرُهُ مَتَاعًا بِالْمَعْرُوفِ حَقًّا عَلَى الْمُحْسِنِينَ"},"context":"في خِطبة المعتدات: ﴿وَلَا جُنَاحَ عَلَيْكُمْ فِيمَا عَرَّضْتُمْ بِهِ مِنْ خِطْبَةِ النِّسَاءِ أَوْ أَكْنَنْتُمْ فِي أَنْفُسِكُمْ عَلِمَ اللَّهُ أَنَّكُمْ سَتَذْكُرُونَهُنَّ﴾ — ثم النهي عن المواعدة سرًّا وعن عزم العقد قبل بلوغ الكتاب أجله — ﴿وَاعْلَمُوا أَنَّ اللَّهَ غَفُورٌ حَلِيمٌ﴾.","reason":"اعترف التشريع بالفطرة قبل أن يهذبها: ﴿عَلِمَ اللَّهُ أَنَّكُمْ سَتَذْكُرُونَهُنَّ﴾ — فلم يؤاخذ بالخاطر الفطري وأذن بالتعريض، وضبط الحدَّ عند التصريح والسر. فالغفور الحليم يشرّع لبشرٍ يعلم ميولهم — لا لملائكة.","adds":"الشرع لا يصادم فطرتك بل يهذب مجراها — فلا تجلد نفسك على خاطرٍ علم اللهُ أنه سيمرّ بك."},{"i":3,"of":4,"s":3,"surah":"آل عمران","a":155,"text":"إِنَّ الَّذِينَ تَوَلَّوْا مِنْكُمْ يَوْمَ الْتَقَى الْجَمْعَانِ إِنَّمَا اسْتَزَلَّهُمُ الشَّيْطَانُ بِبَعْضِ مَا كَسَبُوا وَلَقَدْ عَفَا اللَّهُ عَنْهُمْ إِنَّ اللَّهَ غَفُورٌ حَلِيمٌ","prev":{"a":154,"text":"ثُمَّ أَنْزَلَ عَلَيْكُمْ مِنْ بَعْدِ الْغَمِّ أَمَنَةً نُعَاسًا يَغْشَى طَائِفَةً مِنْكُمْ وَطَائِفَةٌ قَدْ أَهَمَّتْهُمْ أَنْفُسُهُمْ يَظُنُّونَ بِاللَّهِ غَيْرَ الْحَقِّ ظَنَّ الْجَاهِلِيَّةِ يَقُولُونَ هَلْ لَنَا مِنَ الْأَمْرِ مِنْ شَيْءٍ قُلْ إِنَّ الْأَمْرَ كُلَّهُ لِلَّهِ يُخْفُونَ فِي أَنْفُسِهِمْ مَا لَا يُبْدُونَ لَكَ يَقُولُونَ لَوْ كَانَ لَنَا مِنَ الْأَمْرِ شَيْءٌ مَا قُتِلْنَا هَاهُنَا قُلْ لَوْ كُنْتُمْ فِي بُيُوتِكُمْ لَبَرَزَ الَّذِينَ كُتِبَ عَلَيْهِمُ الْقَتْلُ إِلَى مَضَاجِعِهِمْ وَلِيَبْتَلِيَ اللَّهُ مَا فِي صُدُورِكُمْ وَلِيُمَحِّصَ مَا فِي قُلُوبِكُمْ وَاللَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ"},"next":{"a":156,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَكُونُوا كَالَّذِينَ كَفَرُوا وَقَالُوا لِإِخْوَانِهِمْ إِذَا ضَرَبُوا فِي الْأَرْضِ أَوْ كَانُوا غُزًّى لَوْ كَانُوا عِنْدَنَا مَا مَاتُوا وَمَا قُتِلُوا لِيَجْعَلَ اللَّهُ ذَلِكَ حَسْرَةً فِي قُلُوبِهِمْ وَاللَّهُ يُحْيِي وَيُمِيتُ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ"},"context":"في الذين فرّوا يوم أُحد: ﴿إِنَّ الَّذِينَ تَوَلَّوْا مِنْكُمْ يَوْمَ الْتَقَى الْجَمْعَانِ إِنَّمَا اسْتَزَلَّهُمُ الشَّيْطَانُ بِبَعْضِ مَا كَسَبُوا وَلَقَدْ عَفَا اللَّهُ عَنْهُمْ إِنَّ اللَّهَ غَفُورٌ حَلِيمٌ﴾.","reason":"أعظم زلة ميدانية — الفرار يوم التقاء الجمعين — عولجت بثلاث: تشخيصُ السبب (استزلال شيطانٍ نفذ من ذنوبٍ سابقة: ﴿بِبَعْضِ مَا كَسَبُوا﴾)، وعفوٌ معلن ﴿وَلَقَدْ عَفَا اللَّهُ عَنْهُمْ﴾، وختمٌ بالاسمين — ولم يُفضح أحدٌ بعينه.","adds":"درسان: الذنوب تجرّ الذنوب — فزلة اليوم قد تكون ثغرة معصية الأمس — والزلات الكبرى للصادقين يسعها عفو الغفور الحليم."},{"i":4,"of":4,"s":5,"surah":"المائدة","a":101,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَسْأَلُوا عَنْ أَشْيَاءَ إِنْ تُبْدَ لَكُمْ تَسُؤْكُمْ وَإِنْ تَسْأَلُوا عَنْهَا حِينَ يُنَزَّلُ الْقُرْآنُ تُبْدَ لَكُمْ عَفَا اللَّهُ عَنْهَا وَاللَّهُ غَفُورٌ حَلِيمٌ","prev":{"a":100,"text":"قُلْ لَا يَسْتَوِي الْخَبِيثُ وَالطَّيِّبُ وَلَوْ أَعْجَبَكَ كَثْرَةُ الْخَبِيثِ فَاتَّقُوا اللَّهَ يَا أُولِي الْأَلْبَابِ لَعَلَّكُمْ تُفْلِحُونَ"},"next":{"a":102,"text":"قَدْ سَأَلَهَا قَوْمٌ مِنْ قَبْلِكُمْ ثُمَّ أَصْبَحُوا بِهَا كَافِرِينَ"},"context":"﴿يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَسْأَلُوا عَنْ أَشْيَاءَ إِنْ تُبْدَ لَكُمْ تَسُؤْكُمْ... عَفَا اللَّهُ عَنْهَا وَاللَّهُ غَفُورٌ حَلِيمٌ﴾.","reason":"نُهي عن التنطع في الأسئلة الذي يجرّ التشديد — وما سكت عنه الشرعُ فهو عفو: ﴿عَفَا اللَّهُ عَنْهَا﴾ — فالغفور يغفر ما مضى من فضول السؤال، والحليم وسّع بالسكوت عمدًا رحمةً لا نسيانًا.","adds":"أدب التدين: لا تشدد فيُشدَّد عليك — فمساحات السكوت الشرعي رحمة مقصودة، لا فراغًا يُسدّ بالتنقيب."}],"hadiths":[{"i":1,"of":2,"text":"واللهِ إنَّ النُّعاسَ لَيغشاني إذْ سمِعتُ ابنَ قُشَيرٍ يَقولُها وما أَسمَعُها منه إلَّا كالحُلْمِ ، ثمَّ قَرأَ :  إِنَّ الَّذِينَ تَوَلَّوْا مِنْكُمْ يَوْمَ الْتَقَى الْجَمْعَانِ إِنَّمَا اسْتَزَلَّهُمُ الشَّيْطَانُ بِبَعْضِ مَا كَسَبُوا وَلَقَدْ عَفَا اللَّهُ عَنْهُمْ إِنَّ اللَّهَ غَفُورٌ حَلِيمٌ  قال : والذين تَوَلَّوْا عندَ جَوْلَةِ النَّاسِ : عُثمانُ بنُ عفَّانَ ، وسعيدُ بنُ عثمانَ الزُّرَقِيُّ ، وأخوه عُقبةُ بنُ عثمانَ ، حتَّى بلَغوا جَبلًا بِناحيةِ المدينةِ يُقالُ لهُ : [ الجَلعبُ ] ، بِبَطنِ الأَعوَصِ ، فَأَقاموا بِه ثلاثًا ، فَزعَموا أَنَّهم لَمَّا رَجَعوا إلى رَسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ قال : لقد ذَهبتُمْ فيها عَريضَةً ، ثمَّ قال :  يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَكُونُوا كَالَّذِينَ كَفَرُوا  يعني : المنافقين :  وَقَالُوا لِإِخْوَانِهِمْ إِذَا ضَرَبُوا فِي الْأَرْضِ أَوْ كَانُوا غُزًّى لَوْ كَانُوا عِنْدَنَا مَا مَاتُوا وَمَا قُتِلُوا لِيَجْعَلَ اللَّهُ ذَلِكَ حَسْرَةً فِي قُلُوبِهِمْ  الآيةَ ، قال : ( انتعاءً ) وتَحسُّرًا ، وذلكَ لا يُغنِي عنهم شيئًا ، ثمَّ كانتِ القِصَّةُ فيما يَأمُرُ بِه نَبيَّهُ صلَّى اللهُ عليهِ وسلَّمَ ويَعهَدُ إليهِ ، حتَّى انتهى إلى قوله : أَوَلَمَّا أَصَابَتْكُمْ مُصِيبَةٌ قَدْ أَصَبْتُمْ مِثْلَيْهَا  يعني : يومَ بدرٍ فيمن قُتِلُوا وأُسِرُوا  قُلْتُمْ أَنَّى هَذَا قُلْ هُوَ مِنْ عِنْدِ أَنْفُسِكُمْ الَّتي كانت من الرُّمَاةِ ، قال : فقال :  وَمَا أَصَابَكُمْ يَوْمَ الْتَقَى الْجَمْعَانِ فَبِإِذْنِ اللَّهِ وَلِيَعْلَمَ الْمُؤْمِنِينَ  يَقولُ : عَلانيةَ أَمرِهمْ ، ويُظهِرُ أَمرَهُمْ  وَلِيَعْلَمَ الَّذِينَ نَافَقُوا  فيكونُ أَمرُهُم عَلانيةً ، يعني : عبدَ اللهِ بنَ أُبَيٍّ ومَن كانَ مَعَه مِمَّن رَجَعَ عن رَسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ حين سارَ إلى عَدُوِّهِ وَقِيلَ لَهُمْ تَعَالَوْا قَاتِلُوا فِي سَبِيلِ اللَّهِ أَوِ ادْفَعُوا قَالُوا لَوْ نَعْلَمُ قِتَالًا لَاتَّبَعْنَاكُمْ وذلكَ [ لِقَولِهِم ] حين قال لهم أَصحابُ رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ وهم سائِرونَ إلى أُحُدٍ حينَ انصَرَفُوا عنهم : أَتخذُلونَنَا وتُسلِمُونَنَا لِعَدَوِّنَا ؟ فقالوا : ما نَرَى أن يكونَ قِتالًا ، لَو نَرَى أن يكونَ قِتالًا لاتَّبعْنَاكُمْ ، يَقولُ اللهُ عَزَّ وجَلَّ : هُمْ لِلْكُفْرِ يَوْمَئِذٍ أَقْرَبُ مِنْهُمْ لِلْإِيمَانِ يَقُولُونَ بِأَفْوَاهِهِمْ مَا لَيْسَ فِي قُلُوبِهِمْ وَاللَّهُ أَعْلَمُ بِمَا يَكْتُمُونَ 167 الَّذِينَ قَالُوا لِإِخْوَانِهِمْ  من ذَوِي أَرحامِهِم ، ولم يَعْنِ اللهُ تعالى إخوانَهُم في الدِّينِ  لَوْ أَطَاعُونَا مَا قُتِلُوا قالُ اللهُ عَزَّ وجَلَّ  قُلْ فَادْرَءُوا عَنْ أَنْفُسِكُمُ الْمَوْتَ إِنْ كُنْتُمْ صَادِقِينَ","narrator":"الزبير بن العوام","source":"المطالب العالية 4/395","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/g7LhNLAF","nameForm":"غَفُورٌ حَلِيمٌ","scene":"الزبير بن العوام يصف ما بعد الهزيمة في أُحد: «والله إن النعاس ليغشاني إذ سمعت ابن قشير يقولها وما أسمعها منه إلا كالحلم» — ثم يقرأ ﴿إِنَّ الَّذِينَ تَوَلَّوْا مِنْكُمْ يَوْمَ الْتَقَى الْجَمْعَانِ إِنَّمَا اسْتَزَلَّهُمُ الشَّيْطَانُ بِبَعْضِ مَا كَسَبُوا وَلَقَدْ عَفَا اللَّهُ عَنْهُمْ إِنَّ اللَّهَ غَفُورٌ حَلِيمٌ﴾، ويُسمّي من تولوا حتى بلغوا جبلًا بناحية المدينة فأقاموا به ثلاثًا.","reason":"الفرار يوم الزحف من الكبائر، ومع ذلك خُتمت الآية باسمين لا عقوبةً: غفورٌ للزلة، حليمٌ عن العجلة بالعقاب. والحلم هنا بعينه: لم يعاجلهم وقد فرّوا عن نبيهم، بل نسب الزلة إلى الشيطان ﴿اسْتَزَلَّهُمُ﴾. فالاسم مفتاح العفو الذي أُعلن قبله ﴿وَلَقَدْ عَفَا اللَّهُ عَنْهُمْ﴾.","adds":"يُري الشاهد الاسم في أثقل زلة جماعية للصحابة، وأن أحد العشرة يقرؤه راويًا ما وقع — فالاسم يُروى مع الاعتراف."},{"i":2,"of":2,"text":"جاءَ رَجلٌ إلى ابنِ عُمَرَ رَضيَ اللهُ عنهُما، فقالَ: أشهِدَ عُثْمانُ بَيْعةَ الرِّضْوانِ؟ قالَ: لا، قالَ: فشهِدَ بَدرًا، قالَ: لا، قالَ: \"فكانَ ممَّن استَزَلَّه الشَّيطانُ؟ قالَ: نعمْ، فقامَ الرَّجلُ فقالَ له بَعضُ القَومِ: إنَّ هذا يَزعُمُ الآنَ أنَّكَ وقَعْتَ في عُثْمانَ، قالَ: كذلك يَقولُ: قالَ: رُدُّوا عَليَّ الرَّجلَ، فقالَ: عقَلْتُ ما قلْتُ لكَ؟ قالَ: نعمْ، سألْتُكَ: هل شهِدَ عُثْمانُ بَيْعةَ الرِّضْوانِ؟ فقلْتَ: لا، وسألْتُكَ: هل شهِدَ بَدرًا؟ فقلْتَ: لا، وسألْتُكَ: هل كانَ ممَّنِ استَزَلَّه الشَّيطانُ؟ فقلْتَ: نعمْ، فقالَ: أمَّا بَيْعةُ الرِّضْوانِ، فإنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قامَ، فقالَ: «إنَّ عُثْمانَ انطلَقَ في حاجةِ اللهِ وحاجةِ رَسولِه صلَّى اللهُ عليه وسلَّمَ، وإنِّي أُبايِعُ له»، فضرَبَ إحْدى يدَيْه على الأُخْرى، وأمَّا يومُ بَدرٍ فإنَّ نَبيَّ اللهِ صلَّى اللهُ عليه وسلَّمَ قامَ فقالَ: إنَّ عُثْمانَ انطلَقَ في حاجةِ اللهِ وحاجةِ رَسولِه صلَّى اللهُ عليه وسلَّمَ، فضرَبَ له بسَهمٍ، ولم يَضرِبْ لأحَدٍ غابَ غَيرَه، وأمَّا الَّذين توَلَّوْا يومَ الْتَقى الجَمْعانِ، إنَّما استَزَلَّهمُ الشَّيطانُ ببَعضِ ما كَسَبوا، ولقدْ عَفا اللهُ عنهم، إنَّ اللهَ غَفورٌ حَليمٌ.","narrator":"عبدالله بن عمر","source":"المستدرك على الصحيحين 4594","grade":"صحيح","judgment":"صحيح الإسناد","url":"https://dorar.net/h/fqzJwvnG","nameForm":"غَفورٌ حَليمٌ","scene":"رجلٌ يسأل ابن عمر عن عثمان: أشهد بيعة الرضوان؟ لا. أشهد بدرًا؟ لا. أكان ممن استزله الشيطان؟ نعم. فيقوم الرجل، فيُقال لابن عمر: إن هذا يزعم أنك وقعت في عثمان، فيردّه ابن عمر ويبيّن: غاب عن البيعة في حاجة الله ورسوله فبايع النبي ﷺ عنه بيده، وغاب عن بدر في حاجة الله ورسوله فضرب له بسهم، «وأما الذين تولوا يوم التقى الجمعان إنما استزلهم الشيطان ببعض ما كسبوا ولقد عفا الله عنهم إن الله غفور حليم».","reason":"ابن عمر يختم دفاعه بالآية: من عفا الله عنه باسمه الغفور الحليم لا يُعيَّر بزلته. فالاسم حجةٌ في الذبّ عن الأعراض: ما غفره الغفور وحلم عنه الحليم لا يجوز أن يُنبش.","adds":"يُحوّل الشاهد الاسم إلى قاعدةٍ في معاملة الناس: لا يُعيَّر أحدٌ بذنبٍ أعلن الله فيه المغفرة."}],"sunnah":{"card":"الصيغة: الْغَفُورُ الْحَلِيمُ — مركّبة، وردت في الشاهدين بلفظ القرآن ﴿إِنَّ اللَّهَ غَفُورٌ حَلِيمٌ﴾\nفي السنة: 3 شواهد (4 روايات)\nخصوصية الورود في السنة: الاسم خاتمة آية الذين تولّوا يوم أُحد ﴿وَلَقَدْ عَفَا اللَّهُ عَنْهُمْ إِنَّ اللَّهَ غَفُورٌ حَلِيمٌ﴾، ويستشهد بها الزبير في وصف يوم أُحد، وابن عمر في الدفاع عن عثمان. وهو في تعداد الأسماء.\nالمعنى المختصر: الغفور الذي يمحو الزلة، الحليم الذي لا يعاجل صاحبها.","teaches":"1. أنه يغفر أثقل الزلات — الفرار عن النبي ﷺ — ويحلم عن أصحابها.\n2. أن ما عفا عنه لا يُعيَّر به أحد.\n3. أنه ينسب زلة عبده إلى الشيطان رحمةً به.","whenRecall":"- حين تزل زلةً تخجل منها.\n- حين يُعيَّر إنسانٌ بذنبٍ قديم تاب منه.\n- حين تقرأ آية أُحد.","whenPray":"عند الشعور بـ:\n1. الخجل من زلةٍ كبيرة.\n2. الخوف من المعاجلة بالعقوبة.\nعند طلب:\n1. المغفرة مع الحلم.\n2. أن يُستر عليك فلا يُعيَّرك أحد.\nعند الرغبة في:\n1. الذب عن أعراض التائبين كما فعل ابن عمر.","duaItems":"لا صيغة منصوصة؛ ويُدعى بلفظ الآية: «اللهم اعف عني إنك غفور حليم» — من [آل عمران: 155] (الشاهد: المطالب العالية 4/395 — إسناده صحيح).","summary":"«الغفور الحليم» في السنة خاتمةُ آية الفارّين يوم أُحد، يرويها الزبير معترفًا ويحتج بها ابن عمر ذابًّا عن عثمان — ما غفره الغفور وحلم عنه الحليم لا يُعيَّر به أحد."},"situations":[{"situationId":17,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"زلّةٌ كبيرة وتخلٍّ عن الواجب يعقبه ندم","bridge":"زللتَ زلةً كبيرة؟ الذين فرّوا يوم أُحد نزل فيهم: ﴿وَلَقَدْ عَفَا اللَّهُ عَنْهُمْ إِنَّ اللَّهَ غَفُورٌ حَلِيمٌ﴾ — لم يعاجلهم، ونسب زلتهم إلى الشيطان، فعد قبل أن يبرد الندم."}]},{"situationId":26,"verses":[{"i":1,"strength":"direct","headline":"الخوف من المؤاخذة على كلامٍ جرى بلا قصد","bridge":"تتكلم وتخشى أن تزلّ؟ ﴿لَا يُؤَاخِذُكُمُ اللَّهُ بِاللَّغْوِ فِي أَيْمَانِكُمْ وَلَكِنْ يُؤَاخِذُكُمْ بِمَا كَسَبَتْ قُلُوبُكُمْ وَاللَّهُ غَفُورٌ حَلِيمٌ﴾ — ميزان المؤاخذة في القلب لا اللسان: الغفور يستر ما يجري على لسانك بلا قصد، والحليم لا يعاجلك بما يكسب قلبك؛ فطهّر مكسب القلب ولا تُرهق نفسك بجريان اللسان."},{"i":2,"strength":"direct","headline":"جلد النفس على خاطرٍ فطري يمرّ بها","bridge":"خاطرٌ فطري يمرّ بك فتجلد نفسك عليه؟ الشرع اعترف بالفطرة قبل أن يهذّبها: ﴿عَلِمَ اللَّهُ أَنَّكُمْ سَتَذْكُرُونَهُنَّ﴾ فلم يؤاخذ بالخاطر وضبط الحدّ عند التصريح — ﴿أَنَّ اللَّهَ غَفُورٌ حَلِيمٌ﴾ يشرّع لبشرٍ يعلم ميولهم؛ فلا تجلد نفسك على خاطرٍ علم الله أنه سيمرّ بك."}],"hadiths":[]},{"situationId":59,"verses":[],"hadiths":[{"i":2,"strength":"direct","headline":"تعيير الناس بذنوبٍ قديمة قد عفا الله عنها","bridge":"سمعتَ من يعيّر إنسانًا بذنبٍ قديم؟ ابن عمر ردّ على من نال من عثمان بالآية: «ولقد عفا الله عنهم إن الله غفور حليم» — ما غفره الله لا تنبشه."}]},{"situationId":114,"verses":[{"i":3,"strength":"direct","headline":"زلّةٌ كبيرة تخاف أن تكون علامة انقلاب","bridge":"زللتَ زلةً كبيرة وتخاف أن تكون علامة انقلاب؟ الذين فرّوا يوم أُحد عولجوا بتشخيصٍ ﴿إِنَّمَا اسْتَزَلَّهُمُ الشَّيْطَانُ بِبَعْضِ مَا كَسَبُوا﴾ وعفوٍ معلن ﴿وَلَقَدْ عَفَا اللَّهُ عَنْهُمْ إِنَّ اللَّهَ غَفُورٌ حَلِيمٌ﴾ — الزلات الكبرى للصادقين يسعها العفو، فسدّ ثغرة الأمس ولا تحكم على قلبك."}],"hadiths":[]},{"situationId":198,"verses":[{"i":4,"strength":"direct","headline":"التنقيب والتشدد في تفاصيل سكت عنها الشرع","bridge":"تنقّب في العبادة عن تفاصيل لم يذكرها الشرع فتشدد على نفسك؟ ﴿لَا تَسْأَلُوا عَنْ أَشْيَاءَ إِنْ تُبْدَ لَكُمْ تَسُؤْكُمْ... عَفَا اللَّهُ عَنْهَا وَاللَّهُ غَفُورٌ حَلِيمٌ﴾ — مساحات السكوت الشرعي رحمةٌ مقصودة لا فراغًا يُسدّ بالتنقيب؛ لا تشدد فيُشدَّد عليك."}],"hadiths":[]}]},{"id":51,"name":"خير الغافرين","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: خَيْرُ الْغَافِرِينَ — صيغة تفضيل | المواضع: 1 (الأعراف: 155)\nخصوصية: من دعاء موسى في قلب كارثةٍ جماعية — الرجفة التي أخذت السبعين المختارين — فهو اسم الاستغفار حين يخطئ بعضُ الجماعة ويُخشى عموم البلاء.\n\nالمعنى:\n- خير الغافرين: أفضلُ من يغفر — لأن مغفرته بلا منٍّ ولا تأخيرٍ ولا رصيدٍ سابقٍ يُشترط، وكل غافرٍ سواه يغفر ببقيةِ حظٍّ لنفسه.","teaches":"الحقائق التي كشفها الموضع:\n1. لا تُهلَك الجماعة بفعل سفهائها إذا لجأت واستغفرت.\n2. الفتن ابتلاء: ﴿تُضِلُّ بِهَا مَنْ تَشَاءُ وَتَهْدِي مَنْ تَشَاءُ﴾ — فاسأل الهداية فيها.\n3. تقديم الولاية بين يدي طلب المغفرة أدبُ الأنبياء.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- حين يخطئ سفهاءُ من تنتمي إليهم فتخاف العقوبة العامة.\n- عند نزول فتنةٍ عامة تعصف بالناس.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. عند خطأ بعض الجماعة: دعاء موسى — ﴿أَتُهْلِكُنَا بِمَا فَعَلَ السُّفَهَاءُ مِنَّا... فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الْغَافِرِينَ﴾ — الأعراف 155.\n2. في الفتن: سؤال أن تكون ممن يُهدى بها لا ممن يُضل — ﴿إِنْ هِيَ إِلَّا فِتْنَتُكَ﴾.\n3. طلب المغفرة الشاملة للجماعة لا لنفسك وحدك.","summary":"حين يخطئ سفهاءُ قومك وتخشى أن يعمّ البلاء، قف موقف موسى: ﴿أَنْتَ وَلِيُّنَا فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الْغَافِرِينَ﴾.","verses":[{"i":1,"of":1,"s":7,"surah":"الأعراف","a":155,"text":"وَاخْتَارَ مُوسَى قَوْمَهُ سَبْعِينَ رَجُلًا لِمِيقَاتِنَا فَلَمَّا أَخَذَتْهُمُ الرَّجْفَةُ قَالَ رَبِّ لَوْ شِئْتَ أَهْلَكْتَهُمْ مِنْ قَبْلُ وَإِيَّايَ أَتُهْلِكُنَا بِمَا فَعَلَ السُّفَهَاءُ مِنَّا إِنْ هِيَ إِلَّا فِتْنَتُكَ تُضِلُّ بِهَا مَنْ تَشَاءُ وَتَهْدِي مَنْ تَشَاءُ أَنْتَ وَلِيُّنَا فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الْغَافِرِينَ","prev":{"a":154,"text":"وَلَمَّا سَكَتَ عَنْ مُوسَى الْغَضَبُ أَخَذَ الْأَلْوَاحَ وَفِي نُسْخَتِهَا هُدًى وَرَحْمَةٌ لِلَّذِينَ هُمْ لِرَبِّهِمْ يَرْهَبُونَ"},"next":{"a":156,"text":"وَاكْتُبْ لَنَا فِي هَذِهِ الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ إِنَّا هُدْنَا إِلَيْكَ قَالَ عَذَابِي أُصِيبُ بِهِ مَنْ أَشَاءُ وَرَحْمَتِي وَسِعَتْ كُلَّ شَيْءٍ فَسَأَكْتُبُهَا لِلَّذِينَ يَتَّقُونَ وَيُؤْتُونَ الزَّكَاةَ وَالَّذِينَ هُمْ بِآيَاتِنَا يُؤْمِنُونَ"},"context":"اختار موسى سبعين رجلًا لميقات ربه، فلما أخذتهم الرجفة قال: ﴿رَبِّ لَوْ شِئْتَ أَهْلَكْتَهُمْ مِنْ قَبْلُ وَإِيَّايَ أَتُهْلِكُنَا بِمَا فَعَلَ السُّفَهَاءُ مِنَّا إِنْ هِيَ إِلَّا فِتْنَتُكَ... أَنْتَ وَلِيُّنَا فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الْغَافِرِينَ﴾.","reason":"بنى موسى دعاء الكارثة على ثلاث ركائز: التفريقُ بين السفهاء والجماعة — ﴿أَتُهْلِكُنَا بِمَا فَعَلَ السُّفَهَاءُ مِنَّا﴾ — وردُّ الأمر إلى الفتنة والمشيئة، ثم التوسل بالولاية والختمُ بخير الغافرين: طلبَ مغفرةً تسع الجماعة كلها، من أفضل من يغفر. فاستُجيب وبُعثوا.","adds":"دعاء الأزمات الجماعية الخالد: حين يخطئ بعضُ من تنتمي إليهم — أسرةً أو أمة — وتخشى أن يعمّ البلاء: قل قول موسى."}],"hadiths":[{"i":1,"of":1,"text":"عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهُما في قولِهِ عزَّ وجلَّ: {وَاخْتَارَ مُوسَى قَوْمَهُ سَبْعِينَ رَجُلًا لِمِيقَاتِنَا} [الأعراف: 155]، قالَ: دَعا موسى فبَعَثَ اللهُ سبعينَ، فجَعَلَ دُعاءهُ حين دَعاهُ لمَنْ آمَنَ بمُحمَّدٍ صلَّى اللهُ عليه وسلَّمَ، واتَّبعَهُ قولَهُ فاغفِرْ لنا وارْحَمْنا وأنتَ خيرُ الغافرينَ، فسأَكْتُبُها للَّذين يَتَّقونَ ويؤتونَ الزَّكاةَ، والَّذينَ يَتَّبِعون مُحمَّدًا صلَّى اللهُ عليه وسلَّمَ.","narrator":"سعيد بن جبير","source":"المستدرك على الصحيحين 3295","grade":"صحيح","judgment":"صحيح الإسناد","url":"https://dorar.net/h/0nQuYHKq","nameForm":"خيرُ الغافرينَ","scene":"ابن عباس في قوله ﴿وَاخْتَارَ مُوسَى قَوْمَهُ سَبْعِينَ رَجُلًا لِمِيقَاتِنَا﴾: دعا موسى فبعث الله سبعين — أي أحياهم بعد الصعقة — «فجعل دعاءه حين دعاه لمن آمن بمحمد ﷺ واتبعه: قوله ﴿فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الْغَافِرِينَ﴾، فسأكتبها للذين يتقون ويؤتون الزكاة والذين يتبعون محمدًا ﷺ».","reason":"موسى يطلب المغفرة لقومه بعد الصعقة ويقول «وأنت خير الغافرين» — فيجيب الله بأن يخص الرحمة المكتوبة بأمة محمد. فالاسم في دعاء نبي أُجيب بعطاء أوسع من طلبه: طلب لقومه فكُتبت لأمةٍ بعدهم؛ وهذا عين معنى «خير الغافرين»: يغفر فوق ما طُلب ولمن لم يُطلب لهم.","adds":"يربط الشاهد الاسم بأمة محمد ﷺ: مغفرة دعا بها موسى كُتبت لمن يتبع محمدًا — فالمسلم داخلٌ في جواب دعاءٍ قيل قبله بقرون."}],"sunnah":{"card":"الصيغة: خَيْرُ الْغَافِرِينَ — مركّبة\nفي السنة: شاهد واحد (رواية واحدة)\nخصوصية الورود في السنة: ورد في بيان ابن عباس لدعاء موسى عند الميقات: ﴿فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الْغَافِرِينَ﴾ — وأن الله جعل ثمرة هذا الدعاء لمن يؤمن بمحمد ﷺ ويتبعه.\nالمعنى المختصر: الذي مغفرته خير من مغفرة كل غافر، لا يشوبها منٌّ ولا نقص.","teaches":"1. أن مغفرته تتجاوز الطلب: يغفر لمن لم يُدعَ له.\n2. أن أمة محمد ﷺ وارثة دعاء موسى بالمغفرة.\n3. أنه خير من يُطلب منه الغفران بلا منّ.","whenRecall":"- حين تقرأ الأعراف 155–157.\n- حين تدعو لقومك أو أمتك بالمغفرة.\n- حين تشعر أنك لا تستحق: كُتبت لمن اتبع محمدًا.","whenPray":"عند الشعور بـ:\n1. الحاجة إلى مغفرة جماعية بعد فتنة.\n2. ضعف الاستحقاق.\nعند طلب:\n1. المغفرة والرحمة معًا.\n2. أن تكون ممن كُتبت لهم رحمة موسى.\nعند الرغبة في:\n1. الدعاء للأمة بدعاء الأنبياء.","duaItems":"«فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الْغَافِرِينَ» [الأعراف: 155] — دعاء موسى الذي جُعلت إجابته لمن اتبع محمدًا ﷺ (المستدرك 3295 — صحيح الإسناد).","summary":"«خير الغافرين» في السنة دعاء موسى عند الميقات، كُتبت إجابته لمن يتبع محمدًا ﷺ — فمغفرته تتجاوز من طُلبت لهم إلى من لم يُولد بعد."},"situations":[{"situationId":3,"verses":[{"i":1,"strength":"direct","headline":"بلاءٌ يعمّك بسبب ما فعله السفهاء من قومك","bridge":"تُؤخذ بجريرة غيرك ويعمّك بلاءٌ سببه سفهاء من حولك؟ هذا موقف موسى حين أخذت الرجفة السبعين: ﴿أَتُهْلِكُنَا بِمَا فَعَلَ السُّفَهَاءُ مِنَّا﴾ ثم ﴿أَنْتَ وَلِيُّنَا فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الْغَافِرِينَ﴾ — فرّق بين المسيء والجماعة، وسل خير الغافرين مغفرةً تسع الجميع؛ فاستُجيب وبُعثوا."}],"hadiths":[]},{"situationId":17,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"استعظام الذنب واستبعاد أن تُطلب مغفرته","bridge":"تظن أن مغفرتك أصعب من أن تُطلب؟ موسى دعا لقومه ﴿وَأَنْتَ خَيْرُ الْغَافِرِينَ﴾ فكتب الله الإجابة لمن يتبع محمدًا — أنت داخلٌ في جواب دعاءٍ قيل قبلك بقرون."}]}]},{"id":52,"name":"الواحد القهار","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: الْوَاحِدُ الْقَهَّارُ — مركّبة | المواضع: 6 (يوسف: 39 — الرعد: 16 — إبراهيم: 48 — ص: 65 — الزمر: 4 — غافر: 16)\nخصوصية: خمسةٌ من مواضعه وردت مقرونةً بلفظ الجلالة (انظر صيغة «الله الواحد القهار»)، والسادس — الرعد 16 — بضمير الفصل: ﴿وَهُوَ الْوَاحِدُ الْقَهَّارُ﴾ خاتمةً لبرهان الخالقية.\n\nالمعنى:\n- الواحد: المتفرد الذي لا ثاني له.\n- القهار: الغالب الذي خضع لقهره كلُّ شيء.\nسر الاقتران: وحدانيةُ من قهر كلَّ ما سواه — فلم يبق مع القهر الشامل ندٌّ يُدّعى.","teaches":"الحقائق التي كشفتها المواضع:\n1. التفرق ضعف والوحدة مع القهر كمال — حجة يوسف العقلية.\n2. وحدة الخالقية برهان وحدة الألوهية: خالق كل شيء هو الواحد القهار.\n3. يوم البروز تسقط التعدديات كلها ويبقى صوت واحد: لمن الملك اليوم.\n4. القهر الشامل ينفي الولد والشريك من أصلهما.","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- عند تفرق قلبك بين مطالب أربابٍ متفرقين: مدير وجمهور ومجتمع وهوى.\n- عند هيبة أصحاب السلطان: كلهم بارزون غدًا.\n- عند التعار من الليل — فالذكر الوارد فيه بهذا الاسم.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. جمع القلب المتفرق بسؤال يوسف: ﴿أَأَرْبَابٌ مُتَفَرِّقُونَ خَيْرٌ أَمِ اللَّهُ الْوَاحِدُ الْقَهَّارُ﴾ — يوسف 39.\n2. طلب قهر ما غلبك: نفسٍ أو هوًى أو عدوّ — فكل شيء تحت قهره.\n3. الاستعداد ليوم البروز وسؤال الملك — غافر 16.\n4. من السنة: كان ﷺ يقول إذا انقلب من الليل: «لَا إِلَهَ إِلَّا اللَّهُ الْوَاحِدُ الْقَهَّارُ، رَبُّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا الْعَزِيزُ الْغَفَّارُ» — رواه النسائي وصححه الألباني.","summary":"سؤال يوسف في سجنه هو سؤال الموقف الأعظم: أربابٌ متفرقون أم الواحد القهار؟ — أجب به اليوم بقلبك، وقلها إذا تعارّيت من الليل كما علّم النبي ﷺ.","verses":[{"i":1,"of":1,"s":13,"surah":"الرعد","a":16,"text":"قُلْ مَنْ رَبُّ السَّمَاوَاتِ وَالْأَرْضِ قُلِ اللَّهُ قُلْ أَفَاتَّخَذْتُمْ مِنْ دُونِهِ أَوْلِيَاءَ لَا يَمْلِكُونَ لِأَنْفُسِهِمْ نَفْعًا وَلَا ضَرًّا قُلْ هَلْ يَسْتَوِي الْأَعْمَى وَالْبَصِيرُ أَمْ هَلْ تَسْتَوِي الظُّلُمَاتُ وَالنُّورُ أَمْ جَعَلُوا لِلَّهِ شُرَكَاءَ خَلَقُوا كَخَلْقِهِ فَتَشَابَهَ الْخَلْقُ عَلَيْهِمْ قُلِ اللَّهُ خَالِقُ كُلِّ شَيْءٍ وَهُوَ الْوَاحِدُ الْقَهَّارُ","prev":{"a":15,"text":"وَلِلَّهِ يَسْجُدُ مَنْ فِي السَّمَاوَاتِ وَالْأَرْضِ طَوْعًا وَكَرْهًا وَظِلَالُهُمْ بِالْغُدُوِّ وَالْآصَالِ"},"next":{"a":17,"text":"أَنْزَلَ مِنَ السَّمَاءِ مَاءً فَسَالَتْ أَوْدِيَةٌ بِقَدَرِهَا فَاحْتَمَلَ السَّيْلُ زَبَدًا رَابِيًا وَمِمَّا يُوقِدُونَ عَلَيْهِ فِي النَّارِ ابْتِغَاءَ حِلْيَةٍ أَوْ مَتَاعٍ زَبَدٌ مِثْلُهُ كَذَلِكَ يَضْرِبُ اللَّهُ الْحَقَّ وَالْبَاطِلَ فَأَمَّا الزَّبَدُ فَيَذْهَبُ جُفَاءً وَأَمَّا مَا يَنْفَعُ النَّاسَ فَيَمْكُثُ فِي الْأَرْضِ كَذَلِكَ يَضْرِبُ اللَّهُ الْأَمْثَالَ"},"context":"سلسلة إفحامٍ في الرعد: أولياء لا يملكون لأنفسهم نفعًا ولا ضرًا؟ أيستوي الأعمى والبصير، أم الظلمات والنور؟ ﴿أَمْ جَعَلُوا لِلَّهِ شُرَكَاءَ خَلَقُوا كَخَلْقِهِ فَتَشَابَهَ الْخَلْقُ عَلَيْهِمْ قُلِ اللَّهُ خَالِقُ كُلِّ شَيْءٍ وَهُوَ الْوَاحِدُ الْقَهَّارُ﴾.","reason":"بُني الاسم على برهان الخالقية: هل خلق شركاؤهم كخلقه فاشتبه الأمر؟ كلا — فإذا كان خالقَ كل شيء وحده، فهو الواحد الذي لا شريك له، القهارُ الذي كلُّ مخلوقٍ تحت قهره. فوحدةُ الخلق تُنتج وحدةَ الألوهية ضرورةً.","adds":"برهانٌ تحمله في جملة: من خلق كلَّ شيء، قهر كلَّ شيء — فكيف يُعبد معه مخلوقٌ مقهور؟"}],"hadiths":[],"situations":[{"situationId":94,"verses":[{"i":1,"strength":"direct","headline":"تعلّق القلب بمخلوقٍ تراه نافعًا من دون الله","bridge":"تعلّقت بما تراه نافعًا من دون الله؟ اسمع البرهان: ﴿أَمْ جَعَلُوا لِلَّهِ شُرَكَاءَ خَلَقُوا كَخَلْقِهِ فَتَشَابَهَ الْخَلْقُ عَلَيْهِمْ قُلِ اللَّهُ خَالِقُ كُلِّ شَيْءٍ وَهُوَ الْوَاحِدُ الْقَهَّارُ﴾ — من خلق كل شيء قهر كل شيء؛ فكيف يحتل قلبك مخلوقٌ مقهور لا يملك لنفسه نفعًا ولا ضرًّا؟"}],"hadiths":[]}]},{"id":53,"name":"فالق الإصباح","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: فَالِقُ الْإِصْبَاحِ — مضافة | المواضع: 1 (الأنعام: 96)\nخصوصية: جاء في سلسلة براهين الأنعام بعد ﴿فَالِقُ الْحَبِّ وَالنَّوَى﴾ — فالْقان متجاوران: فلقُ الحياة من الحبة، وفلقُ النور من الظلمة.\n\nالمعنى:\n- فالق الإصباح: الذي يشقّ ظلمةَ الليل عن ضياء الصبح كلَّ يوم — انبثاقُ النور من قلب الظلام، معجزةً يومية متجددة.","teaches":"الحقائق التي كشفها الموضع:\n1. النور يُشقّ من قلب الظلام — سنةٌ كونية تجري في الهموم كما تجري في الآفاق.\n2. الليل سكنٌ مقصود لا مجرد غياب نور — فنومك عبادة تقدير.\n3. الفلقان متجاوران: حياةٌ من حبةٍ ميتة ونورٌ من ليلٍ مظلم — فلا يأس مع فالقهما.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند كل فجر: أنت تشهد الاسم يعمل.\n- في ليالي الهم الطويلة: لليلك إصباحٌ سيُفلق.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. أذكار الصباح عند فلق كل إصباح: «أَصْبَحْنَا وَأَصْبَحَ الْمُلْكُ لِلَّهِ» — رواه مسلم.\n2. الاستعاذة برب الفلق من شرور الظلام — سورة الفلق.\n3. في ضيق الليل الطويل: سؤال فلقِ إصباحك الخاص — فرجٍ يشقّ ظلمة همّك كما يشق الفجرُ الليل.","summary":"الذي يشقّ ظلامَ الكون كلَّ فجرٍ قادرٌ أن يشقّ ظلامَ همّك — فقل مع كل فجر: هذا توقيع ﴿فَالِقُ الْإِصْبَاحِ﴾، ولليلي إصباح.","verses":[{"i":1,"of":1,"s":6,"surah":"الأنعام","a":96,"text":"فَالِقُ الْإِصْبَاحِ وَجَعَلَ اللَّيْلَ سَكَنًا وَالشَّمْسَ وَالْقَمَرَ حُسْبَانًا ذَلِكَ تَقْدِيرُ الْعَزِيزِ الْعَلِيمِ","prev":{"a":95,"text":"إِنَّ اللَّهَ فَالِقُ الْحَبِّ وَالنَّوَى يُخْرِجُ الْحَيَّ مِنَ الْمَيِّتِ وَمُخْرِجُ الْمَيِّتِ مِنَ الْحَيِّ ذَلِكُمُ اللَّهُ فَأَنَّى تُؤْفَكُونَ"},"next":{"a":97,"text":"وَهُوَ الَّذِي جَعَلَ لَكُمُ النُّجُومَ لِتَهْتَدُوا بِهَا فِي ظُلُمَاتِ الْبَرِّ وَالْبَحْرِ قَدْ فَصَّلْنَا الْآيَاتِ لِقَوْمٍ يَعْلَمُونَ"},"context":"سورة الأنعام تسوق سلسلةً من البراهين المتصاعدة بعد أن عرضت مشهد القيامة: ﴿وَلَقَدْ جِئْتُمُونَا فُرَادَى كَمَا خَلَقْنَاكُمْ أَوَّلَ مَرَّةٍ﴾ — لا شفعاء ولا شركاء. ثم تنتقل إلى الأرض تحت أقدامهم لتقيم الحجة من المشهود: ﴿إِنَّ اللَّهَ فَالِقُ الْحَبِّ وَالنَّوَى﴾ — حبةٌ يابسة ونواةٌ صلبة تنشقّان عن حياة؛ ﴿يُخْرِجُ الْحَيَّ مِنَ الْمَيِّتِ وَمُخْرِجُ الْمَيِّتِ مِنَ الْحَيِّ﴾. ثم يرفع البصر من الحقل إلى الأفق فإذا الفلق نفسُه يتكرر في السماء: ﴿فَالِقُ الْإِصْبَاحِ﴾ — ظلمةٌ تنشقّ عن ضياء كما انشقت الحبة عن نبات. ثم تُعرض المنظومة كاملة: ﴿وَجَعَلَ اللَّيْلَ سَكَنًا وَالشَّمْسَ وَالْقَمَرَ حُسْبَانًا﴾ — نهارٌ للسعي وليلٌ للسكن ونيّرانِ لضبط الوقت — ويُوقَّع المشهد: ﴿ذَلِكَ تَقْدِيرُ الْعَزِيزِ الْعَلِيمِ﴾. ثم تضيف الآية التالية وظيفةً أخرى للسماء: ﴿وَهُوَ الَّذِي جَعَلَ لَكُمُ النُّجُومَ لِتَهْتَدُوا بِهَا فِي ظُلُمَاتِ الْبَرِّ وَالْبَحْرِ﴾.","reason":"عُرضت منظومة اليوم كاملة: فلقُ الإصباح للسعي، والليلُ سكنًا للراحة، والنيّران حسبانًا للوقت — كلُّها ﴿تَقْدِيرُ الْعَزِيزِ الْعَلِيمِ﴾. واختيار «فالق»: النور لا يأتي من خارج الظلام بل يُشقّ من قلبه — كما تُشق الحياةُ من قلب الحبة اليابسة قبلها بآية.","adds":"الاسم اسمُ الأمل اليومي: كل فجرٍ تشهده توقيعُ ﴿فَالِقُ الْإِصْبَاحِ﴾ — نورٌ يُشقّ من قلب الظلام، وليلٌ جُعل سكنًا لا سجنًا."}],"hadiths":[],"situations":[{"situationId":9,"verses":[{"i":1,"strength":"direct","headline":"ليلٌ طويل من الضيق وانتظار فرجٍ لا يلوح","bridge":"دعوتَ وطال الليل ولم يتغير شيء؟ الاسم اسم الأمل اليومي: ﴿فَالِقُ الْإِصْبَاحِ﴾ — النور لا يأتي من خارج الظلام بل يُشقّ من قلبه، ككل فجرٍ رأيته ينبثق من أشد ساعات الليل سوادًا؛ فالفرج الذي تنتظره يُفلق من داخل ظلمتك، وكل صباحٍ شهدته توقيعٌ على هذه السنّة."}],"hadiths":[]}]},{"id":54,"name":"رفيع الدرجات ذو العرش","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: رَفِيعُ الدَّرَجَاتِ ذُو الْعَرْشِ — مركّبة | المواضع: 1 (غافر: 15)\nخصوصية: الصيغة الكاملة التي جمعت رفعةَ الدرجات وملكَ العرش وإلقاءَ الوحي في آية واحدة — في سياق الأمر بالدعاء الخالص.\n\nالمعنى:\n- رفيع الدرجات: العليُّ الذي لا تتناهى درجاتُ عظمته وكماله — والرافعُ درجاتِ من يشاء من عباده.\n- ذو العرش: مالك العرش الأعظم.","teaches":"الحقائق التي كشفها الموضع:\n1. لا سقف للدعاء مع رفيع الدرجات — فلا تستصغر مطلوبك.\n2. العلو المطلق لا يقطع الصلة: من فوق العرش يُلقى الوحي على العباد.\n3. الإخلاص شرط المقام: ﴿فَادْعُوا اللَّهَ مُخْلِصِينَ لَهُ الدِّينَ﴾.","whenRecall":"لحظات الاستحضار — مشتقة من موضعه:\n- عند الطموح الروحي: الدرجات عنده بلا نهاية.\n- قبل الدعاء: استحضر من تدعو.\n- عند تذكر يوم التلاق.","whenPray":"بنود الدعاء — مشتقة من سياق الموضع:\n1. الدعاء الخالص مهما كره الكارهون — غافر 14.\n2. سؤال رفع الدرجات — ومن السنة دعاء النبي ﷺ لأبي سلمة: «اللَّهُمَّ اغْفِرْ لِأَبِي سَلَمَةَ وَارْفَعْ دَرَجَتَهُ فِي الْمَهْدِيِّينَ» — رواه مسلم.\n3. الاستعداد ليوم التلاق: سؤال النجاة يوم تلقى رفيع الدرجات.","summary":"ادعُ ﴿رَفِيعُ الدَّرَجَاتِ ذُو الْعَرْشِ﴾ بلا سقف — فدرجاتُ عظمته لا تتناهى، ودرجاتُ عطائه أوسع من أعلى طموحك.","verses":[{"i":1,"of":1,"s":40,"surah":"غافر","a":15,"text":"رَفِيعُ الدَّرَجَاتِ ذُو الْعَرْشِ يُلْقِي الرُّوحَ مِنْ أَمْرِهِ عَلَى مَنْ يَشَاءُ مِنْ عِبَادِهِ لِيُنْذِرَ يَوْمَ التَّلَاقِ","prev":{"a":14,"text":"فَادْعُوا اللَّهَ مُخْلِصِينَ لَهُ الدِّينَ وَلَوْ كَرِهَ الْكَافِرُونَ"},"next":{"a":16,"text":"يَوْمَ هُمْ بَارِزُونَ لَا يَخْفَى عَلَى اللَّهِ مِنْهُمْ شَيْءٌ لِمَنِ الْمُلْكُ الْيَوْمَ لِلَّهِ الْوَاحِدِ الْقَهَّارِ"},"context":"بعد الأمر بالدعاء الخالص: ﴿فَادْعُوا اللَّهَ مُخْلِصِينَ لَهُ الدِّينَ وَلَوْ كَرِهَ الْكَافِرُونَ﴾ — تُعرض صفات المدعوّ: ﴿رَفِيعُ الدَّرَجَاتِ ذُو الْعَرْشِ يُلْقِي الرُّوحَ مِنْ أَمْرِهِ عَلَى مَنْ يَشَاءُ مِنْ عِبَادِهِ لِيُنْذِرَ يَوْمَ التَّلَاقِ﴾ — علوٌّ لا سقف له، وعرشٌ فوق كل ملك، ووحيٌ يُلقى على بشرٍ من عباده. ثم يوصف ذلك اليوم: ﴿يَوْمَ هُمْ بَارِزُونَ لَا يَخْفَى عَلَى اللَّهِ مِنْهُمْ شَيْءٌ﴾.","reason":"قُدّمت للداعي المخلص ثلاثُ صفاتٍ لمدعوّه: درجاتُ عظمةٍ لا تتناهى — فلا سقف لدعائك — وعرشٌ فوق كل ملك، ووحيٌ يُلقى من ذلك العلو على عبدٍ من العباد — فالعلو المطلق موصول بالأرض لا معزول. ثم الغاية: الإنذار بيوم التلاق — يومِ يلتقي الخلقُ بمالك هذه الصفات.","adds":"ارفع سقف دعائك: أنت تدعو «رفيع الدرجات» — درجاتُ عظمته بلا نهاية ودرجاتُ عطائه أوسع من طموحك، ورفعُ درجاتِ عباده من شأنه."}],"hadiths":[],"situations":[{"situationId":162,"verses":[{"i":1,"strength":"direct","headline":"الرغبة في إحسان الدعاء ورفع سقف الطلب","bridge":"تريد أن تُحسن الطلب؟ اقرأ صفات مدعوّك قبل أن تدعو: ﴿رَفِيعُ الدَّرَجَاتِ ذُو الْعَرْشِ يُلْقِي الرُّوحَ مِنْ أَمْرِهِ عَلَى مَنْ يَشَاءُ مِنْ عِبَادِهِ﴾ — درجات عظمةٍ بلا نهاية فلا سقف لدعائك، وعرشٌ فوق كل ملك، وعلوٌّ موصولٌ بالأرض لا معزول؛ والآية قبلها تأمرك: ﴿فَادْعُوا اللَّهَ مُخْلِصِينَ لَهُ الدِّينَ﴾."}],"hadiths":[]}]},{"id":55,"name":"الحق","compound":false,"meaning":"بطاقة الاسم:\nالصيغة: الْحَقُّ — مفردة معرّفة | المواضع: 5 (يونس: 32 — الكهف: 44 — الحج: 6، 62 — لقمان: 30)\nخصوصية: مواضعه كلها تدور على القسمة الثنائية الحاسمة — الحق/الضلال، الحق/الباطل — بضمير الفصل «هو» دائمًا، وتكررت قاعدة الحج 62 بنصّها في لقمان 30.\n\nالمعنى:\n- الحق: الثابتُ الوجودِ والألوهيةِ ثبوتًا لا يعتريه شكٌّ ولا زوال — الحقُّ في ذاته وأسمائه ووعده وقوله؛ وكل ما سواه ممكنُ الزوال.","teaches":"الحقائق التي كشفتها المواضع:\n1. القسمة ثنائية حاسمة: ﴿فَمَاذَا بَعْدَ الْحَقِّ إِلَّا الضَّلَالُ﴾ — لا حياد.\n2. الأزمات تكشف الولاية الحق حين تسقط الولايات الباطلة.\n3. حقّيته مبرهنة بالمشهود: إحياء الأرض كل موسم.\n4. كل معبودٍ سواه «هو الباطل» — بضمير الفصل.","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- عند سقوط الأسناد في أزمة: هنالك الولاية لله الحق.\n- عند رؤية الأرض تحيا بعد المطر.\n- عند خطاب التمييع: «كل الطرق تؤدي إلى الله».","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. من دعاء تهجد النبي ﷺ: «اللَّهُمَّ لَكَ الْحَمْدُ... أَنْتَ الْحَقُّ، وَوَعْدُكَ الْحَقُّ، وَقَوْلُكَ الْحَقُّ، وَلِقَاؤُكَ حَقٌّ» — متفق عليه: اجعله استفتاح قيامك.\n2. عند الأزمات: طلب الولاية الحق التي لا تسقط — الكهف 44.\n3. سؤال الثبات على القسمة: «اللهم أرنا الحق حقًّا وارزقنا اتباعه، وأرنا الباطل باطلًا وارزقنا اجتنابه».","summary":"القسمة ثنائية لا ثالث لها: ﴿فَمَاذَا بَعْدَ الْحَقِّ إِلَّا الضَّلَالُ﴾ — فإذا سقطت الأسنادُ يومًا فاعلم: ﴿هُنَالِكَ الْوَلَايَةُ لِلَّهِ الْحَقِّ﴾.","verses":[{"i":1,"of":7,"s":6,"surah":"الأنعام","a":62,"text":"ثُمَّ رُدُّوا إِلَى اللَّهِ مَوْلَاهُمُ الْحَقِّ أَلَا لَهُ الْحُكْمُ وَهُوَ أَسْرَعُ الْحَاسِبِينَ","prev":{"a":61,"text":"وَهُوَ الْقَاهِرُ فَوْقَ عِبَادِهِ وَيُرْسِلُ عَلَيْكُمْ حَفَظَةً حَتَّى إِذَا جَاءَ أَحَدَكُمُ الْمَوْتُ تَوَفَّتْهُ رُسُلُنَا وَهُمْ لَا يُفَرِّطُونَ"},"next":{"a":63,"text":"قُلْ مَنْ يُنَجِّيكُمْ مِنْ ظُلُمَاتِ الْبَرِّ وَالْبَحْرِ تَدْعُونَهُ تَضَرُّعًا وَخُفْيَةً لَئِنْ أَنْجَانَا مِنْ هَذِهِ لَنَكُونَنَّ مِنَ الشَّاكِرِينَ"},"context":"تتتابع الآيات في مشهد السلطان المطلق: الله يتوفّى الناس بالليل ويعلم ما كسبوا بالنهار، وهو القاهر فوق عباده، يرسل عليهم حفظة، حتى إذا جاء أحدَهم الموت توفّته الرسل. ثم تأتي خاتمة الرحلة: ﴿ثُمَّ رُدُّوا إِلَى اللَّهِ مَوْلَاهُمُ الْحَقِّ﴾.","reason":"وُصف المولى بـ«الحق» في لحظة الردّ إليه، لأن الناس في الدنيا اتخذوا موالي يظنّونها تنفعهم، فإذا رُدّوا إليه ظهر أن المولى الثابت الذي لا يزول هو الله وحده، وأن ﴿لَهُ الْحُكْمُ وَهُوَ أَسْرَعُ الْحَاسِبِينَ﴾.","adds":"كل وَلاءٍ لغير الله ينقطع عند الموت، والمولى الحق هو الذي يُردّ إليه الجميع فيحكم ويحاسب.","draft":true},{"i":2,"of":7,"s":10,"surah":"يونس","a":30,"text":"هُنَالِكَ تَبْلُو كُلُّ نَفْسٍ مَا أَسْلَفَتْ وَرُدُّوا إِلَى اللَّهِ مَوْلَاهُمُ الْحَقِّ وَضَلَّ عَنْهُمْ مَا كَانُوا يَفْتَرُونَ","prev":{"a":29,"text":"فَكَفَى بِاللَّهِ شَهِيدًا بَيْنَنَا وَبَيْنَكُمْ إِنْ كُنَّا عَنْ عِبَادَتِكُمْ لَغَافِلِينَ"},"next":{"a":31,"text":"قُلْ مَنْ يَرْزُقُكُمْ مِنَ السَّمَاءِ وَالْأَرْضِ أَمَّنْ يَمْلِكُ السَّمْعَ وَالْأَبْصَارَ وَمَنْ يُخْرِجُ الْحَيَّ مِنَ الْمَيِّتِ وَيُخْرِجُ الْمَيِّتَ مِنَ الْحَيِّ وَمَنْ يُدَبِّرُ الْأَمْرَ فَسَيَقُولُونَ اللَّهُ فَقُلْ أَفَلَا تَتَّقُونَ"},"context":"مشهد الحشر: يُجمع المشركون مع شركائهم، فيتبرّأ الشركاء من عبادتهم ويُشهدون الله على ذلك. هنالك تختبر كل نفسٍ ما قدّمت، ويُردّ الجميع إلى الله مولاهم الحق.","reason":"جاء «الحق» في مقابلة ما كانوا يفترون: فالآلهة التي عبدوها ﴿ضَلَّ عَنْهُمْ﴾ — غابت حين احتاجوا إليها — والذي بقي وثبت هو الله مولاهم الحق. فالحق هنا هو الثابت الذي يبقى حين يتلاشى الباطل.","adds":"الباطل يغيب في أشدّ لحظات الحاجة، والحق يبقى؛ فاجعل ولاءك لمن لا يغيب عنك يوم تحتاجه.","draft":true},{"i":3,"of":7,"s":10,"surah":"يونس","a":32,"text":"فَذَلِكُمُ اللَّهُ رَبُّكُمُ الْحَقُّ فَمَاذَا بَعْدَ الْحَقِّ إِلَّا الضَّلَالُ فَأَنَّى تُصْرَفُونَ","prev":{"a":31,"text":"قُلْ مَنْ يَرْزُقُكُمْ مِنَ السَّمَاءِ وَالْأَرْضِ أَمَّنْ يَمْلِكُ السَّمْعَ وَالْأَبْصَارَ وَمَنْ يُخْرِجُ الْحَيَّ مِنَ الْمَيِّتِ وَيُخْرِجُ الْمَيِّتَ مِنَ الْحَيِّ وَمَنْ يُدَبِّرُ الْأَمْرَ فَسَيَقُولُونَ اللَّهُ فَقُلْ أَفَلَا تَتَّقُونَ"},"next":{"a":33,"text":"كَذَلِكَ حَقَّتْ كَلِمَتُ رَبِّكَ عَلَى الَّذِينَ فَسَقُوا أَنَّهُمْ لَا يُؤْمِنُونَ"},"context":"بعد إقرارهم بأن الله يرزق من السماء والأرض ويملك السمع والأبصار ويخرج الحي من الميت ويدبر الأمر: ﴿فَذَلِكُمُ اللَّهُ رَبُّكُمُ الْحَقُّ فَمَاذَا بَعْدَ الْحَقِّ إِلَّا الضَّلَالُ فَأَنَّى تُصْرَفُونَ﴾.","reason":"بُني الاسم على إقرارهم أنفسهم: الذي أقررتم بأفعاله هذه هو ربكم «الحق» — ثم القسمة الحاسمة: لا منطقة وسطى بين الحق والضلال؛ فمن انصرف عن الحق الواحد فوجهته الضلال حتمًا، مهما سمّاها.","adds":"يقطع أسطورة «الحياد الديني»: ﴿فَمَاذَا بَعْدَ الْحَقِّ إِلَّا الضَّلَالُ﴾ — الخريطة طريقان لا ثالث."},{"i":4,"of":7,"s":18,"surah":"الكهف","a":44,"text":"هُنَالِكَ الْوَلَايَةُ لِلَّهِ الْحَقِّ هُوَ خَيْرٌ ثَوَابًا وَخَيْرٌ عُقْبًا","prev":{"a":43,"text":"وَلَمْ تَكُنْ لَهُ فِئَةٌ يَنْصُرُونَهُ مِنْ دُونِ اللَّهِ وَمَا كَانَ مُنْتَصِرًا"},"next":{"a":45,"text":"وَاضْرِبْ لَهُمْ مَثَلَ الْحَيَاةِ الدُّنْيَا كَمَاءٍ أَنْزَلْنَاهُ مِنَ السَّمَاءِ فَاخْتَلَطَ بِهِ نَبَاتُ الْأَرْضِ فَأَصْبَحَ هَشِيمًا تَذْرُوهُ الرِّيَاحُ وَكَانَ اللَّهُ عَلَى كُلِّ شَيْءٍ مُقْتَدِرًا"},"context":"صاحب الجنتين لحظةَ هلاكها: ﴿وَلَمْ تَكُنْ لَهُ فِئَةٌ يَنْصُرُونَهُ مِنْ دُونِ اللَّهِ وَمَا كَانَ مُنْتَصِرًا * هُنَالِكَ الْوَلَايَةُ لِلَّهِ الْحَقِّ هُوَ خَيْرٌ ثَوَابًا وَخَيْرٌ عُقْبًا﴾.","reason":"﴿هُنَالِكَ﴾ — في لحظة سقوط كل الأسناد: الجنة أُحيط بثمرها والفئة لم تنصر — ظهرت الحقيقة: الولاية لله «الحق» وحده؛ فالولايات الباطلة تسقط ساعة الاختبار، وتبقى ولاية الحق: خيرٌ ثوابًا في الآجل وخيرٌ عقبًا في العاجل.","adds":"الأزمات مِحكّ الولايات: من بقي معك حين سقط كل شيء؟ — هنالك تعرف وليَّك الحق."},{"i":5,"of":7,"s":22,"surah":"الحج","a":6,"text":"ذَلِكَ بِأَنَّ اللَّهَ هُوَ الْحَقُّ وَأَنَّهُ يُحْيِي الْمَوْتَى وَأَنَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ","prev":{"a":5,"text":"يَا أَيُّهَا النَّاسُ إِنْ كُنْتُمْ فِي رَيْبٍ مِنَ الْبَعْثِ فَإِنَّا خَلَقْنَاكُمْ مِنْ تُرَابٍ ثُمَّ مِنْ نُطْفَةٍ ثُمَّ مِنْ عَلَقَةٍ ثُمَّ مِنْ مُضْغَةٍ مُخَلَّقَةٍ وَغَيْرِ مُخَلَّقَةٍ لِنُبَيِّنَ لَكُمْ وَنُقِرُّ فِي الْأَرْحَامِ مَا نَشَاءُ إِلَى أَجَلٍ مُسَمًّى ثُمَّ نُخْرِجُكُمْ طِفْلًا ثُمَّ لِتَبْلُغُوا أَشُدَّكُمْ وَمِنْكُمْ مَنْ يُتَوَفَّى وَمِنْكُمْ مَنْ يُرَدُّ إِلَى أَرْذَلِ الْعُمُرِ لِكَيْلَا يَعْلَمَ مِنْ بَعْدِ عِلْمٍ شَيْئًا وَتَرَى الْأَرْضَ هَامِدَةً فَإِذَا أَنْزَلْنَا عَلَيْهَا الْمَاءَ اهْتَزَّتْ وَرَبَتْ وَأَنْبَتَتْ مِنْ كُلِّ زَوْجٍ بَهِيجٍ"},"next":{"a":7,"text":"وَأَنَّ السَّاعَةَ آتِيَةٌ لَا رَيْبَ فِيهَا وَأَنَّ اللَّهَ يَبْعَثُ مَنْ فِي الْقُبُورِ"},"context":"بعد آية الأرض الهامدة تهتز وتربو بالماء: ﴿ذَلِكَ بِأَنَّ اللَّهَ هُوَ الْحَقُّ وَأَنَّهُ يُحْيِي الْمَوْتَى وَأَنَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾.","reason":"إحياءُ الأرض الميتة برهانٌ مشهود يتكرر كل موسم على ثلاث حقائق أولاها: أنه «الحق» — فحقّيتُه سبحانه ليست دعوى غيبية بل مبرهنةٌ بفعلٍ تراه عينُك كلَّ ربيع.","adds":"كل أرضٍ تخضرّ بعد موات — حديقتُك ومزرعتك — شاهدُ عيانٍ على أنه الحق."},{"i":6,"of":7,"s":22,"surah":"الحج","a":62,"text":"ذَلِكَ بِأَنَّ اللَّهَ هُوَ الْحَقُّ وَأَنَّ مَا يَدْعُونَ مِنْ دُونِهِ هُوَ الْبَاطِلُ وَأَنَّ اللَّهَ هُوَ الْعَلِيُّ الْكَبِيرُ","prev":{"a":61,"text":"ذَلِكَ بِأَنَّ اللَّهَ يُولِجُ اللَّيْلَ فِي النَّهَارِ وَيُولِجُ النَّهَارَ فِي اللَّيْلِ وَأَنَّ اللَّهَ سَمِيعٌ بَصِيرٌ"},"next":{"a":63,"text":"أَلَمْ تَرَ أَنَّ اللَّهَ أَنْزَلَ مِنَ السَّمَاءِ مَاءً فَتُصْبِحُ الْأَرْضُ مُخْضَرَّةً إِنَّ اللَّهَ لَطِيفٌ خَبِيرٌ"},"reason":"القسمة بضمائر الفصل الثلاثة: هو الحق — وكلُّ مدعوٍّ سواه هو الباطل — لا ثالث؛ ثم لازمُ الحقية: العلو والكِبَر. فمعيار فرز المعبودات والمرجعيات كلها في جملة واحدة.","adds":"ميزانٌ جاهز لكل معبودٍ ومُعظَّم: إما الحق الواحد وإما الباطل — والحق واحد لا يتعدد."},{"i":7,"of":7,"s":31,"surah":"لقمان","a":30,"text":"ذَلِكَ بِأَنَّ اللَّهَ هُوَ الْحَقُّ وَأَنَّ مَا يَدْعُونَ مِنْ دُونِهِ الْبَاطِلُ وَأَنَّ اللَّهَ هُوَ الْعَلِيُّ الْكَبِيرُ","prev":{"a":29,"text":"أَلَمْ تَرَ أَنَّ اللَّهَ يُولِجُ اللَّيْلَ فِي النَّهَارِ وَيُولِجُ النَّهَارَ فِي اللَّيْلِ وَسَخَّرَ الشَّمْسَ وَالْقَمَرَ كُلٌّ يَجْرِي إِلَى أَجَلٍ مُسَمًّى وَأَنَّ اللَّهَ بِمَا تَعْمَلُونَ خَبِيرٌ"},"next":{"a":31,"text":"أَلَمْ تَرَ أَنَّ الْفُلْكَ تَجْرِي فِي الْبَحْرِ بِنِعْمَتِ اللَّهِ لِيُرِيَكُمْ مِنْ آيَاتِهِ إِنَّ فِي ذَلِكَ لَآيَاتٍ لِكُلِّ صَبَّارٍ شَكُورٍ"},"context":"في لقمان — بعد آيات إيلاج الليل في النهار وتسخير الشمس والقمر، وقبل آية الفلك: ﴿ذَلِكَ بِأَنَّ اللَّهَ هُوَ الْحَقُّ وَأَنَّ مَا يَدْعُونَ مِنْ دُونِهِ الْبَاطِلُ وَأَنَّ اللَّهَ هُوَ الْعَلِيُّ الْكَبِيرُ﴾.","reason":"قاعدةٌ ترسّخ القسمة الثنائية حتى تصير محفوظةً جارية — وسياقها إيلاجُ الليل في النهار وتسخير الشمس والقمر: فالذي يُجري هذا النظام بإحكامٍ هو الحق، وما يدعونه من دونه باطلٌ لا يملك منه شيئًا.","adds":"احفظ هذه القاعدة بنصّها: هي عمودُ فرقانك في زمن تمييع الحقائق."}],"hadiths":[{"i":1,"of":2,"text":"كان النَّبيُّ صلَّى اللهُ عليه وسلَّم إذا قامَ مِنَ اللَّيلِ يَتَهَجَّدُ قال: اللهُمَّ لكَ الحَمدُ أنتَ قَيِّمُ السَّمَواتِ والأرضِ ومَن فيهنَّ، ولَكَ الحَمدُ لكَ مُلكُ السَّمَواتِ والأرضِ ومَن فيهنَّ، ولَكَ الحَمدُ أنتَ نورُ السَّمَواتِ والأرضِ ومَن فيهنَّ، ولَكَ الحَمدُ أنتَ مَلِكُ السَّمَواتِ والأرضِ، ولَكَ الحَمدُ، أنتَ الحَقُّ ووعدُكَ الحَقُّ، ولقاؤُكَ حَقٌّ، وقَولُكَ حَقٌّ، والجَنَّةُ حَقٌّ، والنَّارُ حَقٌّ، والنَّبيُّونَ حَقٌّ، ومُحَمَّدٌ صلَّى اللهُ عليه وسلَّم حَقٌّ، والسَّاعةُ حَقٌّ، اللهُمَّ لكَ أسلَمتُ، وبكَ آمَنتُ، وعليك تَوكَّلتُ، وإليكَ أنَبْتُ، وبكَ خاصَمتُ، وإليكَ حاكَمتُ، فاغفِرْ لي ما قدَّمتُ وما أخَّرتُ، وما أسرَرتُ وما أعلَنتُ، أنتَ المُقدِّمُ، وأنتَ المُؤَخِّرُ، لا إلَهَ إلَّا أنتَ -أو: لا إلَهَ غَيرُكَ- قال سُفيانُ: وزادَ عبدُ الكَريمِ أبو أُمَيَّةَ: ولا حَولَ ولا قوَّةَ إلَّا باللهِ، قال سُفيانُ: قال سُلَيمانُ بنُ أبي مُسلِمٍ: سَمِعَه مِن طاوُسٍ، عَنِ ابنِ عَبَّاسٍ رَضيَ اللهُ عنهما، عَنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم.","narrator":"عبدالله بن عباس","source":"صحيح البخاري 1120","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/uX1S0EYr","nameForm":"الحَقُّ","scene":"ابن عباس: كان النبي ﷺ إذا قام من الليل يتهجد قال: «اللهم لك الحمد أنت قيّم السماوات والأرض ومن فيهن، ولك الحمد لك ملك السماوات والأرض ومن فيهن، ولك الحمد أنت نور السماوات والأرض ومن فيهن، ولك الحمد أنت ملك السماوات والأرض، ولك الحمد أنت الحق، ووعدك الحق، ولقاؤك حق، وقولك حق، والجنة حق، والنار حق، والنبيون حق، ومحمد ﷺ حق، والساعة حق. اللهم لك أسلمت، وبك آمنت، وعليك توكلت، وإليك أنبت، وبك خاصمت، وإليك حاكمت، فاغفر لي…».","reason":"«أنت الحق» هو مركز الدعاء: بعده سلسلة «حق» معرّفة به — وعدك، لقاؤك، قولك، الجنة، النار، النبيون، الساعة — كلها حقٌّ لأنها منسوبة إلى من هو الحق. فالاسم بأل للذات وحدها، والبقية بلا أل مستمدة منه. ووقت التهجد وقت شكٍّ ونعاس، فيُثبّت القلب بأثبت الأسماء.","adds":"يجعل الشاهد الاسم أصلًا تُبنى عليه العقيدة كلها في دعاءٍ واحد يُقال في جوف الليل: من قال «أنت الحق» لم يشكّ فيما بعده."},{"i":2,"of":2,"text":"ما مِن أميرِ عَشَرةٍ إلَّا جِيء به يومَ القِيامةِ مَغلولةً يدُه إلى عُنُقِه حتى يُطلِقَه الحَقُّ أو يُوبِقَه، ومَن تَعلَّمَ القُرآنَ ثُمَّ نَسيَه، لَقيَ اللهَ وهو أجذَمُ.","narrator":"عبادة بن الصامت","source":"تخريج المسند لشعيب 22781","grade":"صحيح","judgment":"صحيح لغيره دون قوله: \"ومن تعلم القرآن ... إلخ\"","url":"https://dorar.net/h/CA2b8qvX","nameForm":"الحَقُّ","scene":"«ما من أمير عشرةٍ إلا جيء به يوم القيامة مغلولةً يده إلى عنقه حتى يطلقه الحق أو يوبقه».","reason":"الأمير يُؤتى به مغلولًا، ثم لا يفكّ غلَّه إلا «الحق»: إن عدل أطلقه وإن ظلم أوبقه. و«الحق» هنا يُحمل على الله على أحد القولين، ويُحمل على عدله الذي كان عليه على قولٍ آخر — وعلى الأول: الذي يحاسب الأمراء هو الحق الذي لا يُظلم عنده أحد.","adds":"يُري الشاهد الاسم في مقام الحساب على الولاية: من ولي أمر عشرةٍ فمرجعه إلى الحق — وهو محتمل، أُبقي لاحتماله."}],"sunnah":{"card":"الصيغة: الْحَقُّ — مفردة\nفي السنة: 3 شواهد (7 روايات)\nخصوصية الورود في السنة: الاسم في السنة اسمُ افتتاح التهجد: «اللهم لك الحمد… أنت الحق ووعدك الحق ولقاؤك حق…» (البخاري)؛ وفي تعداد الأسماء؛ وفي وعيد الأمراء: «حتى يطلقه الحق أو يوبقه». روجعت مواضعه فحُذف ما جاء فيه «الحق» بمعنى الصدق.\nالمعنى المختصر: الثابت الذي لا يزول ولا يتغير، وكل ما سواه باطلٌ إلا به.","teaches":"1. أنه الحق الذي به يثبت كل حق: الوعد واللقاء والجنة والنار.\n2. أنه يُذكر في جوف الليل لتثبيت القلب.\n3. أن الأمراء يُحاسبون عند الحق فيُطلقون أو يُوبقون.","whenRecall":"- في افتتاح التهجد.\n- حين يخالجك شكٌّ في وعدٍ أو لقاء.\n- حين تتولى أمرًا على الناس.","whenPray":"عند الشعور بـ:\n1. الشك أو الفتور في اليقين.\n2. ثقل مسؤولية على الناس.\nعند طلب:\n1. المغفرة بعد الإقرار بالحق: «فاغفر لي».\n2. أن يُطلقك الحق يوم القيامة.\nعند الرغبة في:\n1. أن تفتتح تهجدك بدعاء النبي ﷺ.","duaItems":"دعاء التهجد: «اللهم لك الحمد أنت قيّم السماوات والأرض ومن فيهن… أنت الحق ووعدك الحق ولقاؤك حق وقولك حق والجنة حق والنار حق والنبيون حق ومحمد حق والساعة حق، اللهم لك أسلمت وبك آمنت وعليك توكلت وإليك أنبت وبك خاصمت وإليك حاكمت، فاغفر لي ما قدمت وما أخرت…» — صحيح البخاري 1120.","summary":"«الحق» في السنة مركز دعاء التهجد: «أنت الحق» ثم كل ما بعده حقٌّ به — وعدٌ ولقاءٌ وجنةٌ ونار؛ ويُطلق الأمراء يوم القيامة أو يوبقهم."},"situations":[{"situationId":6,"verses":[{"i":4,"strength":"direct","headline":"سقوط الأسناد والشعور بالوحدة في الأزمة","bridge":"سقط كل من كنت تستند إليه؟ صاحب الجنتين أُحيط بثمره ولم تنصره فئة، وهناك ظهرت الحقيقة: ﴿هُنَالِكَ الْوَلَايَةُ لِلَّهِ الْحَقِّ هُوَ خَيْرٌ ثَوَابًا وَخَيْرٌ عُقْبًا﴾ — الأزمات محكّ الولايات: من بقي معك حين سقط كل شيء؟ هنالك تعرف وليّك الحق."}],"hadiths":[]},{"situationId":66,"verses":[],"hadiths":[{"i":2,"strength":"direct","headline":"تولّي أمر الناس ولو كانوا عشرة","bridge":"تولّيت أمرًا على الناس أو تراقب من تولاه؟ «ما من أمير عشرة إلا جيء به مغلولةً يده حتى يطلقه الحق أو يوبقه» — مرجع كل والٍ إلى الحق."}]},{"situationId":94,"verses":[{"i":2,"strength":"direct","headline":"تعلّقٌ بسندٍ زائل يغيب عند أشد الحاجة","bridge":"تستند إلى جاهٍ أو مالٍ أو أحدٍ من الناس؟ يوم الحشر ﴿وَرُدُّوا إِلَى اللَّهِ مَوْلَاهُمُ الْحَقِّ وَضَلَّ عَنْهُمْ مَا كَانُوا يَفْتَرُونَ﴾ — فالباطل يغيب في أشدّ لحظات الحاجة والحق يبقى؛ فاجعل ولاءك لمن لا يغيب عنك يوم تحتاجه."}],"hadiths":[]},{"situationId":98,"verses":[{"i":1,"strength":"direct","headline":"الاتكاء على ولاءاتٍ دنيوية تنقطع بالموت","bridge":"تتكئ على ولاءاتٍ تظنها تنفعك؟ ﴿ثُمَّ رُدُّوا إِلَى اللَّهِ مَوْلَاهُمُ الْحَقِّ﴾ — كل ولاءٍ لغير الله ينقطع عند الموت، والمولى الثابت الذي لا يزول هو الذي يُردّ إليه الجميع."}],"hadiths":[]},{"situationId":99,"verses":[{"i":6,"strength":"direct","headline":"طلب ميزانٍ لفرز المعبودات والمرجعيات المعظّمة","bridge":"تريد ميزانًا جاهزًا لكل معبودٍ ومرجع؟ القسمة بضمائر الفصل الثلاثة: ﴿ذَلِكَ بِأَنَّ اللَّهَ هُوَ الْحَقُّ وَأَنَّ مَا يَدْعُونَ مِنْ دُونِهِ هُوَ الْبَاطِلُ وَأَنَّ اللَّهَ هُوَ الْعَلِيُّ الْكَبِيرُ﴾ — هو الحق وكل مدعوٍّ سواه هو الباطل لا ثالث؛ فالحق واحد لا يتعدد، وبهذا الميزان يُفرز كل معظَّم."}],"hadiths":[]},{"situationId":103,"verses":[{"i":3,"strength":"direct","headline":"طلب رسوخ التوحيد ببرهانٍ لا بتقليد","bridge":"تريد أن يرسخ توحيدك ببرهانٍ لا بتقليد؟ بُني الاسم على إقرار المخالفين بأفعاله ثم القسمة الحاسمة: ﴿فَذَلِكُمُ اللَّهُ رَبُّكُمُ الْحَقُّ فَمَاذَا بَعْدَ الْحَقِّ إِلَّا الضَّلَالُ فَأَنَّى تُصْرَفُونَ﴾ — لا منطقة وسطى بين الحق والضلال، والخريطة طريقان لا ثالث؛ فالتوحيد ليس أحد الخيارات بل الحق الذي بعده الضلال."}],"hadiths":[]},{"situationId":104,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"خواطر الشك في الوعد واللقاء والآخرة","bridge":"خواطر تشكّكك في وعدٍ أو لقاء؟ في دعاء التهجد سلسلةٌ تبدأ من الاسم: «أنت الحق» ثم «ووعدك الحق ولقاؤك حق والجنة حق والنار حق» — كل حقٍّ تشك فيه مسندٌ إلى الحق."}]},{"situationId":118,"verses":[{"i":7,"strength":"direct","headline":"الخوف من تمييع الحقائق والثبات على الدين","bridge":"تخاف أن تميّع الحقائق عندك؟ احفظ القاعدة بنصها: ﴿ذَلِكَ بِأَنَّ اللَّهَ هُوَ الْحَقُّ وَأَنَّ مَا يَدْعُونَ مِنْ دُونِهِ الْبَاطِلُ﴾ — جاءت بعد آيات إيلاج الليل في النهار وتسخير الشمس والقمر ترسيخًا للقسمة الثنائية؛ فهذه القاعدة عمود فرقانك في زمن تمييع الحقائق."}],"hadiths":[]},{"situationId":176,"verses":[{"i":5,"strength":"direct","headline":"رؤية الأرض تخضرّ بعد موات","bridge":"ترى حديقتك أو مزرعتك تخضرّ بعد موات؟ أنت تشهد برهانًا على ثلاث حقائق أولاها أنه الحق: ﴿ذَلِكَ بِأَنَّ اللَّهَ هُوَ الْحَقُّ وَأَنَّهُ يُحْيِي الْمَوْتَى وَأَنَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ﴾ — حقّيته ليست دعوى غيبية بل مبرهنةٌ بفعلٍ تراه عينك كل ربيع."}],"hadiths":[]}]},{"id":56,"name":"الرحمن الرحيم","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: الرَّحْمَنُ الرَّحِيمُ — مركّبة | المواضع: 6 (الفاتحة: 1، 3 — البقرة: 163 — النمل: 30 — فصلت: 2 — الحشر: 22)\nخصوصية: أشهرُ اقترانٍ يفتتح به كل شيء: المصحفُ والسورُ والأعمال — يتوسط الفاتحة قبل ﴿مَالِكِ يَوْمِ الدِّينِ﴾، ويتقدم أسماءَ الحشر الجامعة كلَّها، ويُنسب إليه التنزيل.\n\nالمعنى:\n- الرحمن: ذو الرحمة الواسعة صفةً — وسعت كل شيء.\n- الرحيم: الموصِلها إلى عباده فعلًا.\nسر الاقتران: سعةُ الصفة + وصولُ الأثر — رحمةٌ لا تضيق ولا تنقطع.","teaches":"الحقائق التي كشفتها المواضع:\n1. الرحمة مقدَّمة على كل تعريف: في أول المصحف، وقلب الفاتحة، وصدر أسماء الحشر.\n2. ﴿مَالِكِ يَوْمِ الدِّينِ﴾ لا يُقرأ إلا بعد ﴿الرَّحْمَنِ الرَّحِيمِ﴾ — فالرهبة محفوفة برحمة.\n3. التوحيد والدعوة والمراسلة كلها تُفتتح بوجه الرحمة.\n4. القرآن كله تنزيل من الرحمن الرحيم — رسالة رحمة قبل أن يكون نص تكاليف.","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- في كل بسملة: أكثر اسمين يمران على لسانك يوميًا — لا تمرّ بهما آلية.\n- في كل فاتحةٍ تقرؤها: لحظة ﴿الرَّحْمَنِ الرَّحِيمِ﴾ قبل ﴿مَالِكِ يَوْمِ الدِّينِ﴾.\n- عند افتتاح رسالةٍ أو خطابٍ مهم.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. استحضار المعنى في بسملات يومك — فكل بسملة نداءٌ للرحمة المثناة.\n2. التوسل بالرحمة قبل ذكر الحاجات — كترتيب الفاتحة نفسها.\n3. افتتاح المراسلات المهمة بالبسملة كسنّة سليمان — النمل 30.\n4. من السنة: «يَا حَيُّ يَا قَيُّومُ بِرَحْمَتِكَ أَسْتَغِيثُ» — رواه الترمذي وحسّنه.","summary":"قبل أن يعرّفك بملكه ويوم دينه، عرّفك برحمته مثنّاة: ﴿الرَّحْمَنِ الرَّحِيمِ * مَالِكِ يَوْمِ الدِّينِ﴾ — فادخل على كل رهبةٍ في دينك من باب الرحمة.","verses":[{"i":1,"of":3,"s":2,"surah":"البقرة","a":163,"text":"وَإِلَهُكُمْ إِلَهٌ وَاحِدٌ لَا إِلَهَ إِلَّا هُوَ الرَّحْمَنُ الرَّحِيمُ","prev":{"a":162,"text":"خَالِدِينَ فِيهَا لَا يُخَفَّفُ عَنْهُمُ الْعَذَابُ وَلَا هُمْ يُنْظَرُونَ"},"next":{"a":164,"text":"إِنَّ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ وَاخْتِلَافِ اللَّيْلِ وَالنَّهَارِ وَالْفُلْكِ الَّتِي تَجْرِي فِي الْبَحْرِ بِمَا يَنْفَعُ النَّاسَ وَمَا أَنْزَلَ اللَّهُ مِنَ السَّمَاءِ مِنْ مَاءٍ فَأَحْيَا بِهِ الْأَرْضَ بَعْدَ مَوْتِهَا وَبَثَّ فِيهَا مِنْ كُلِّ دَابَّةٍ وَتَصْرِيفِ الرِّيَاحِ وَالسَّحَابِ الْمُسَخَّرِ بَيْنَ السَّمَاءِ وَالْأَرْضِ لَآيَاتٍ لِقَوْمٍ يَعْقِلُونَ"},"context":"﴿وَإِلَهُكُمْ إِلَهٌ وَاحِدٌ لَا إِلَهَ إِلَّا هُوَ الرَّحْمَنُ الرَّحِيمُ﴾ — وبعدها مباشرة آية البراهين الكبرى: ﴿إِنَّ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ...﴾.","reason":"بعد تقرير الوحدانية ونفي كل إله سواه، جاء أولُ وصفٍ للإله الواحد: ﴿الرَّحْمَنُ الرَّحِيمُ﴾ — فالتوحيد يُقدَّم بوجه الرحمة لا بوجه الرهبة: إلهك الواحد الذي لا بديل عنه رحمتُه أولُ ما ينبغي أن تعرفه عنه.","adds":"إذا عرّفت أحدًا بالله فابدأ من حيث بدأ: واحدٌ رحمن رحيم — فالوحدانية الجاذبة أول الطريق."},{"i":2,"of":3,"s":41,"surah":"فصلت","a":2,"text":"تَنْزِيلٌ مِنَ الرَّحْمَنِ الرَّحِيمِ","prev":{"a":1,"text":"حم"},"next":{"a":3,"text":"كِتَابٌ فُصِّلَتْ آيَاتُهُ قُرْآنًا عَرَبِيًّا لِقَوْمٍ يَعْلَمُونَ"},"context":"فاتحة فصلت: ﴿حم * تَنْزِيلٌ مِنَ الرَّحْمَنِ الرَّحِيمِ * كِتَابٌ فُصِّلَتْ آيَاتُهُ قُرْآنًا عَرَبِيًّا لِقَوْمٍ يَعْلَمُونَ﴾ — وستحكي السورة إعراض أكثرهم.","reason":"نُسب التنزيل هنا إلى «الرحمن الرحيم» خاصة؛ وفصلت سورةُ إعراض الأكثرين: ﴿فَأَعْرَضَ أَكْثَرُهُمْ فَهُمْ لَا يَسْمَعُونَ﴾ — فقُدّم مصدرُ الكتاب رحمةً مثناة: إن أعرضوا فما نقصت رحمةُ المصدر، والكتاب نَفَسُ رحمةٍ لمن أقبل.","adds":"القرآن كله «تنزيلٌ من الرحمن الرحيم» — فاقرأه قراءةَ من يتلقى رسالة رحمةٍ شخصية، لا نصَّ تكاليف جاف."},{"i":3,"of":3,"s":59,"surah":"الحشر","a":22,"text":"هُوَ اللَّهُ الَّذِي لَا إِلَهَ إِلَّا هُوَ عَالِمُ الْغَيْبِ وَالشَّهَادَةِ هُوَ الرَّحْمَنُ الرَّحِيمُ","prev":{"a":21,"text":"لَوْ أَنْزَلْنَا هَذَا الْقُرْآنَ عَلَى جَبَلٍ لَرَأَيْتَهُ خَاشِعًا مُتَصَدِّعًا مِنْ خَشْيَةِ اللَّهِ وَتِلْكَ الْأَمْثَالُ نَضْرِبُهَا لِلنَّاسِ لَعَلَّهُمْ يَتَفَكَّرُونَ"},"next":{"a":23,"text":"هُوَ اللَّهُ الَّذِي لَا إِلَهَ إِلَّا هُوَ الْمَلِكُ الْقُدُّوسُ السَّلَامُ الْمُؤْمِنُ الْمُهَيْمِنُ الْعَزِيزُ الْجَبَّارُ الْمُتَكَبِّرُ سُبْحَانَ اللَّهِ عَمَّا يُشْرِكُونَ"},"context":"فاتحة آيات الأسماء الجامعة في خواتيم الحشر: ﴿هُوَ اللَّهُ الَّذِي لَا إِلَهَ إِلَّا هُوَ عَالِمُ الْغَيْبِ وَالشَّهَادَةِ هُوَ الرَّحْمَنُ الرَّحِيمُ﴾ — ثم تتوالى: الملك القدوس السلام...","reason":"في أعظم عرضٍ للأسماء الحسنى في القرآن، جاء ﴿الرَّحْمَنُ الرَّحِيمُ﴾ أولَ الأسماء المعروضة — قبل الملك والقدوس والعزيز والجبار والمتكبر: فقُدّمت الرحمة على أسماء الجلال والملك كلها، تصديرًا يحكم قراءة ما بعده: جبروتُه وكبرياؤه محفوفان برحمةٍ سبقت.","adds":"حين تقرأ أسماء الجلال — الجبار المتكبر — فتذكّر أن العرض افتُتح بالرحمن الرحيم: فرتّب معرفتك كما رتّبها هو."}],"hadiths":[{"i":1,"of":7,"text":"مَن صَلَّى صَلاةً لَم يَقرَأْ فيها بأُمِّ القُرآنِ فهي خِداجٌ ثَلاثًا غَيرُ تَمامٍ. فقيلَ لأبي هُرَيرةَ: إنَّا نَكونُ وراءَ الإمامِ، فقال: اقرَأْ بها في نَفسِك؛ فإنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: قال اللهُ تَعالى: قَسَمتُ الصَّلاةَ بَيني وبينَ عَبدي نِصفَينِ، ولعَبدي ما سَألَ، فإذا قال العَبدُ: {الحَمدُ للَّهِ رَبِّ العالَمينَ}، قال اللهُ تَعالى: حَمِدَني عَبدي، وإذا قال: {الرَّحمَنِ الرَّحيمِ}، قال اللهُ تَعالى: أثنى عليَّ عَبدي، وإذا قال: {مالِكِ يَومِ الدِّينِ}، قال: مَجَّدَني عَبدي، وقال مَرَّةً فوَّضَ إلَيَّ عَبدي، فإذا قال: {إيَّاك نَعبُدُ وإيَّاك نَستَعينُ} قال: هذا بَيني وبينَ عَبدي، ولعَبدي ما سَألَ، فإذا قال: {اهدِنا الصِّراطَ المُستَقيمَ صِراطَ الذينَ أنعَمتَ عليهم غيرِ المَغضوبِ عليهم ولا الضَّالِّينَ} قال: هذا لعَبدي، ولعَبدي ما سَألَ.","narrator":"أبو هريرة","source":"صحيح مسلم 395","grade":"صحيح","judgment":"[صحيح]","url":"https://dorar.net/h/pI0s2ud8","nameForm":"الرَّحمَنِ الرَّحيمِ","scene":"أبو هريرة: «من صلى صلاةً لم يقرأ فيها بأم القرآن فهي خداج» — ثم يروي: «قال الله تعالى: قسمت الصلاة بيني وبين عبدي نصفين ولعبدي ما سأل، فإذا قال العبد: ﴿الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ﴾ قال الله: حمدني عبدي، وإذا قال: ﴿الرَّحْمَنِ الرَّحِيمِ﴾ قال الله: أثنى عليّ عبدي، وإذا قال: ﴿مَالِكِ يَوْمِ الدِّينِ﴾ قال: مجّدني عبدي…».","reason":"لكل آيةٍ من الفاتحة جوابٌ من الله، وجواب هذين الاسمين: «أثنى عليّ عبدي». فالحمد للربوبية، والثناء للرحمة، والتمجيد للملك — وخُصّ الاسمان بالثناء لأن الثناء تكرار الحمد وتوكيده، والاسمان تكرارٌ في مادة الرحمة: رحمنٌ ثم رحيم. فمن قالهما فقد كرّر المدح فسُمّي ثناءً.","adds":"يُري الشاهد أن الاسمين يُقالان في كل ركعة ويُجابان في الحال: «أثنى عليّ عبدي» — أقرب حوارٍ بين العبد وربه في الصلاة."},{"i":2,"of":7,"text":"أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ كان يُقَطِّعُ قِراءتَهُ آيَةً آيَةً: {الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ} [الفاتحة: 2]، ثُمَّ يقِفُ، {الرَّحْمَنِ الرَّحِيمِ} [الفاتحة: 3]، ثُمَّ يقِفُ. قالَ ابنُ أبي مُلَيْكةَ: وكانتْ أُمُّ سلَمةَ تَقْرَؤها: (مَلِكِ يَوْمِ الدِّينِ).","narrator":"أم سلمة","source":"المستدرك على الصحيحين 2950","grade":"صحيح","judgment":"صحيح على شرط الشيخين،","url":"https://dorar.net/h/vqb0AQqg","nameForm":"الرَّحْمَنِ الرَّحِيمِ","scene":"أم سلمة: كان النبي ﷺ يقطّع قراءته آيةً آية: ﴿الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ﴾ ثم يقف، ﴿الرَّحْمَنِ الرَّحِيمِ﴾ ثم يقف.","reason":"الوقوف على ﴿الرَّحْمَنِ الرَّحِيمِ﴾ يُفرد الاسمين بوقفة: لا يُوصلان بما بعدهما — لأن الثناء يُستوفى ثم يُنتقل إلى التمجيد. فقراءة النبي ﷺ تُعلّم أن الاسمين آيةٌ تامة يُوقف عندها ويُتأمل.","adds":"يعلّم الشاهد كيف تُقرأ الأسماء: بالوقف والتقطيع لا بالسرد."},{"i":3,"of":7,"text":"شَكا النَّاسُ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ قُحوطَ المَطَرِ، فأمَرَ بمِنبَرٍ فوُضِعَ له في المُصَلَّى، ووَعَدَ النَّاسَ يَومًا يَخرُجون فيه، قالتْ عائشةُ: فخَرَج رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ حين بَدَا حاجِبُ الشَّمسِ، فقَعَد على المِنبَرِ فكَبَّرَ وحَمِدَ اللهَ، ثمَّ قالَ: إنَّكُم شَكَوتُم جَدْبَ دِيارِكُم، واستِئخارَ المَطَرِ عنْ إبَّانِ زَمانِه عنكم، وقد أمَرَكُمُ اللهُ أن تَدعُوه، ووَعَدَكُم أن يَستَجيبَ لَكُم، ثمَّ قالَ: {الْحَمْدُ للهِ رَبِّ الْعَالَمِينَ (2) الرَّحْمَنِ الرَّحِيمِ (3) مَالِكِ يَوْمِ الدِّينِ} [الفاتحة: 2-4]، لا إلَهَ إلَّا اللهُ يَفعَلُ ما يُريدُ، اللَّهُمَّ أنت اللهُ لا إلَهَ إلَّا أنتَ الغَنيُّ ونحن الفُقَراءُ، أنزِلْ عَلَينا الغَيثَ، واجعَلْ ما أنزَلْتَ لنا قُوَّةً وبَلاغًا إلى حينٍ، ثمَّ رَفَع يَدَيه، فلم يَزَلْ في الرَّفعِ حتَّى بَدَا بَياضُ إبِطَيهِ، ثمَّ حَوَّلَ إلى النَّاسِ ظَهرَه، وقَلَب -أو: حَوَّلَ- رِداءَه وهو رافِعٌ يَدَيه، ثمَّ أقبَلَ على النَّاسِ، ونَزَل فصَلَّى رَكعَتَينِ، فأنشَأَ اللهُ سَحابًا فرَعَدَت وبَرَقَت، ثمَّ أمطَرَت بإذنِ اللهِ، فلم يَأتِ مَسجِدَه حتَّى سالَتِ السُّيولُ، فلمَّا رَأى سُرعَتَهُم إلى الكِنِّ ضَحِكَ حتَّى بَدَت نَواجِذُه، فقالَ: أشهَدُ أنَّ اللهَ على كلِّ شَيءٍ قَديرٌ، وأنِّي عَبدُ اللهِ ورَسولُه.","narrator":"عائشة","source":"المستدرك على الصحيحين 1242","grade":"صحيح","judgment":"صحيح على شرط الشيخين","url":"https://dorar.net/h/5R0Ahct2","nameForm":"الرَّحْمَنِ الرَّحِيمِ","scene":"شكا الناس قحوط المطر، فأمر النبي ﷺ بمنبر فوُضع في المصلى، فخرج حين بدا حاجب الشمس، فكبّر وحمد الله ثم قال: «إنكم شكوتم جدب دياركم… وقد أمركم الله أن تدعوه ووعدكم أن يستجيب لكم» ثم قال: ﴿الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ * الرَّحْمَنِ الرَّحِيمِ * مَالِكِ يَوْمِ الدِّينِ﴾ لا إله إلا الله يفعل ما يريد، «اللهم أنت الله لا إله إلا أنت الغني ونحن الفقراء، أنزل علينا الغيث…» ثم رفع يديه حتى بدا بياض إبطيه.","reason":"في الاستسقاء يقدّم النبي ﷺ ثناءً بالاسمين قبل أن يسأل الغيث: الجدب يُسأل رفعه من الرحمن الرحيم — فالمطر رحمة، ومن سأل الرحمة قدّم اسمها. والآيات الثلاث من الفاتحة مقدمةٌ للسؤال «أنزل علينا الغيث».","adds":"يُبيّن الشاهد أن الاسمين يُقدَّمان بين يدي طلب المطر بلفظ الفاتحة — ثناءٌ قبل الطلب في أشد الحاجات العامة."},{"i":4,"of":7,"text":"أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم لمَّا صالَح قريشًا يومَ الحُديبيَةِ قال لِعليٍّ: ( اكتُبْ بِسْمِ اللهِ الرَّحمنِ الرَّحيمِ ) فقال سُهيلُ بنُ عمرٍو: لا نعرِفُ الرَّحمنَ الرَّحيمَ، اكتُبْ باسمِك اللَّهمَّ فقال صلَّى اللهُ عليه وسلَّم لِعليٍّ: ( اكتُبْ هذا ما صالَح عليه محمَّدٌ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ) فقال سُهيلُ بنُ عمرٍو: لو نعلَمُ أنَّك رسولُ اللهِ لاتَّبَعْناك ولم نُكذِّبْك اكتُبْ بنَسَبِك مِن أبيك فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم لِعليٍّ: ( اكتُبْ محمَّدُ بنُ عبدِ اللهِ ) فكتَب: مَن أتى منكم ردَدْناه عليكم ومَن أتى منَّا ترَكْناه عليكم فقالوا: يا رسولَ اللهِ نُعطيهم هذا ؟ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( مَن أتاهم منَّا فأبعَده اللهُ، ومَن أتانا منهم فردَدْناه جعَل اللهُ له فرَجًا ومخرَجًا )","narrator":"أنس بن مالك","source":"تخريج صحيح ابن حبان 4870","grade":"صحيح","judgment":"إسناده صحيح على شرط مسلم","url":"https://dorar.net/h/jQGb3ltA","nameForm":"الرَّحمنَ الرَّحيمَ","scene":"صلح الحديبية: يقول النبي ﷺ لعلي: «اكتب: بسم الله الرحمن الرحيم». فيقول سهيل بن عمرو: «لا نعرف الرحمن الرحيم، اكتب باسمك اللهم». ثم اعترض على «محمد رسول الله» فكتب «محمد بن عبد الله».","reason":"الاسمان في هذا الشاهد محلُّ نزاع: الكافر يعرف «اللهم» وينكر «الرحمن الرحيم» — لأن الاسمين وحيٌ خاص لا تعرفه الجاهلية بهذه الصيغة، فصار الإقرار بهما علامة الإيمان. وقبول النبي ﷺ حذفهما من الكتاب صبرٌ على الصلح لا تنازلٌ عن الاسم.","adds":"يُري الشاهد أن الاسمين شعارٌ فارق بين المسلمين وقريش، وأن النبي ﷺ تجاوز عن كتابتهما لمصلحة الصلح — فالاسم يُحفظ بالقلب حين يُمنع من الورق."},{"i":5,"of":7,"text":"«كانَ جِبْريلُ عليه السَّلامُ إذا جاءَ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ بالقُرآنِ أوَّلُ ما يُلْقى عليه بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ\n[...] الرَّحْمَنِ الرَّحِيمِ الثَّانية، عَلِمَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ أنَّه قد خَتَمَ السُّورةَ وافْتَتَحَ الأخرى».","narrator":"عبدالله بن عباس","source":"الأحاديث المختارة 10 / 317","grade":"صحيح","judgment":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","url":"https://dorar.net/h/OkoWt33V","nameForm":"الرَّحْمَنِ الرَّحِيمِ","scene":"ابن عباس: كان جبريل إذا جاء إلى النبي ﷺ بالقرآن أول ما يُلقي عليه: بسم الله الرحمن الرحيم؛ فإذا أُلقيت عليه البسملة الثانية علم أنه قد ختم السورة وافتتح الأخرى.","reason":"الاسمان أول ما يُلقيه الملك من كل سورة، وبهما تُعرف الحدود بين السور: فهما مفتاح الوحي وفاصله. والافتتاح بالرحمة يُعلّم أن كل سورةٍ — وعيدًا كانت أو قصصًا — نازلةٌ من الرحمن الرحيم.","adds":"يُبيّن الشاهد وظيفةً للاسمين في نزول القرآن نفسه: علامة ختم السورة وبدء الأخرى."},{"i":6,"of":7,"text":"اجتَمَعَت قُرَيشٌ للنَّبيِّ صلَّى اللهُ عليه وسلَّم يومًا، فقالوا: انظُروا أعلَمَكم بالسِّحرِ والكِهانةِ والشِّعرِ فليأتِ هذا الرَّجُلَ الذي فَرَّق جماعتَنا وشَتَّت أمرَنا وعاب دينَنا فيُكَلِّمُه ولينظُرْ ما يَرُدُّ عليه، فقالوا: ما نعلَمُ أحدًا غيرَ عُتبةَ بنِ ربيعةَ، فقالوا: أنت أبا الوليدِ، فقام عُتبةُ حتَّى جلَس إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال يا ابنَ أخي إنَّك منَّا حيثُ قد عَلِمتَ من السِّطةِ في العشيرةِ والمكانِ في النَّسَبِ، وإنَّك قد أتيتَ قَومَك بأمرٍ عظيمٍ فرَّقتَ به جماعتَهم وسَفَّهتَ أحلامَهم وعِبتَ آلهتَهم ودينَهم وكَفَّرتَ من مضى من آبائِهم، يا محمَّدُ، أنت خيرٌ أم عبدُ اللهِ؟ فسكت رسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: أنت خيرٌ أم عبدُ المُطَّلِبِ؟ فسكت رسولُ اللهِ صلَّى اللهُ عليه وسلَّم. قال: فإن كنتَ تَزعُمُ أنَّ هؤلاء خيرٌ منك فقد عبدوا الآلهةَ، وإن كنتَ تَزعُمُ أنَّك خيرٌ منهم فتكَلَّمْ نَسمَعْ قولَك، إنَّا واللهِ ما رأينا سَخلةً قَطُّ أشأمَ على قومِك منك، فرَّقتَ جماعتَنا وأشتَتَّ أمرَنا وعِبتَ دينَنا وفَضَحتَنا في العَرَبِ، حتَّى طار فيهم أنَّ في قريشٍ ساحِرًا، وأنَّ في قريشٍ كاهِنًا، واللهِ ما ننتَظِرُ إلَّا مِثلَ صَيحةِ الحُبلى أن يقومَ بعضُنا بعضًا إليك بالسُّيوفِ حتَّى نتفانى، أيُّها الرَّجُلُ فاسمَعْ مني أعرِضْ عليك أمورًا تنظُرُ فيها لعلَّك تقبَلُ مِنَّا بعضَها، فقال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: قلْ أبا الوليدِ أسمَعْ. قال: يا ابنَ أخي، إن كنتَ إنما تريدُ بما جئتَ به من هذا الأمرِ مالًا جمعناه لك من أموالِنا حتَّى تكونَ أكثَرَنا مالًا، وإن كنتَ تريدُ به الشَّرَفَ سَوَّدناك علينا حتَّى لا نقطَعَ أمرًا دونك، وإن كنتَ تريدُ مُلكًا ملَّكناك علينا، وإن كان هذا الذي يأتيك رَئِيًّا لا تستطيعُ رَدَّه عن نَفسِك طَلَبنا لك الطِّبَّ وبَذَلنا فيه أموالَنا حتَّى نُبرئَك منه، فإنَّه ربَّما غَلَب التَّابعُ على الرَّجُلِ حتَّى يداوى منه. أو كما قال له. حتَّى إذا فرغ عُتبةُ، ورسولُ اللهِ صلَّى اللهُ عليه وسلَّم يسمعُه منه، قال له: أقد فرَغْتَ أبا الوليدِ؟ قال: نعم. قال: فاسمَعْ منِّي، قال: أفعَلُ. قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: بسمِ اللهِ الرَّحمنِ الرَّحيمِ {حم (1) تَنْزِيلٌ مِنَ الرَّحْمَنِ الرَّحِيمِ (2) كِتَابٌ فُصِّلَتْ آيَاتُهُ قُرْآنًا عَرَبِيًّا لِقَوْمٍ يَعْلَمُونَ} ومضى رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فيها يقرؤها عليه، فلمَّا سمعه عُتبةُ أنصت لها وألقى يَدَيه خَلفَ ظَهرِه معتَمِدًا عليهما، فسَمِع منه إلى أن بلغ: {فَإِنْ أَعْرَضُوا فَقُلْ أَنْذَرْتُكُمْ صَاعِقَةً مِثْلَ صَاعِقَةِ عَادٍ وَثَمُودَ} [فصلت: 13]، فأمسك عُتبةُ على فيه وناشَدَه الرَّحِمَ أن يكُفَّ عنه، ثُمَّ انتهى رسولُ اللهِ صلَّى اللهُ عليه وسلَّم إلى السَّجدةِ منها فسجَد، ثُمَّ قال: قد سَمِعتَ أبا الوليدِ ما سَمِعتَ، فأنت وذاك، فقال: ما عندك غيرُ هذا؟ فقال: ما عندي غيرُ هذا. فقام عُتبةُ ولم يَعُدْ إلى أصحابِه واحتبس عنهم، فقال أبو جهلٍ: واللهِ يا مَعشَرَ قُرَيشٍ ما نرى عُتبةَ إلَّا قد صبا إلى محمَّدٍ وأعجبه طعامُه، وما ذاك إلَّا من حاجةٍ أصابته، فانطَلِقوا بنا إليه. فأتوه. فقال أبو جهلٍ: واللهِ يا عُتبةُ ما جئناك إلَّا أنَّك قد صَبَوتَ إلى محمَّدٍ وأعجبك أمرُه، فإن كان لك حاجةٌ جمعنا لك من أموالِنا ما يغنيك عن طعامِ محمَّدٍ، فغَضِب وأقسَمَ لا يكَلِّمُ محمدًا أبدًا، وقال: لقد عَلِمتُم أنِّي من أكثَرِ قريشٍ مالًا ولكني أتيتُه، فقصَّ عليهم القصَّةَ. قالوا: فما أجابك؟ قال: واللهِ الذي نصَّها بنيةً ما فَهِمتُ شيئًا ممَّا قال غيرَ أنَّه أنذَركم صاعِقةً مِثلَ صاعِقةِ عادٍ وثمودَ، فأمسَك بفيه وناشَدتُه الرَّحِمَ أن يكُفَّ، وقد عَلِمتُم أنَّ محمدًا إذا قال شيئًا لم يكذِبْ، فخِفتُ أن يَنزِلَ عليكم العذابُ. قالوا: ويك يُكَلِّمُك الرَّجُلُ بالعربيَّةِ لا تدري ما قال؟! قال: واللهِ ما سَمِعتُ مِثلَه، واللهِ ما هو بالشِّعرِ ولا بالسِّحرِ ولا بالكِهانةِ، يا مَعشَرَ قُرَيشٍ أطيعوني واجعَلوها بي وخَلُّوا بينَ الرَّجُلِ وبينَ ما هو فيه فاعتزِلوه، فواللهِ ليكونَنَّ لقولِه الذي سمِعتُ نبأٌ، فإن تُصِبْه العرَبُ فقد كُفِيتُموه بغيركم، وإن يظهَرْ على العَرَبِ فمُلكُه مُلكُكم وعِزُّه عِزُّكم، وكنتُم أسعَدَ النَّاسِ به، يا قومِ أطيعوني في هذا الأمرِ واعصوني بعدَه، فواللهِ لقد سمِعتُ من هذا الرَّجُلِ كلامًا ما سَمِعَت أذناي كلامًا مِثلَه، وما دَرَيتُ ما أردُّ عليه. قالوا: سَحَرَك واللهِ يا أبا الوَليدِ! قال: هذا رأيي فيه فاصنَعوا ما بدا لكم.","narrator":"جابر بن عبدالله","source":"سبل الهدى والرشاد 2/335","grade":"حسن","judgment":"إسناده جيد","url":"https://dorar.net/h/VlXxoCtZ","nameForm":"الرَّحْمَنِ الرَّحِيمِ","scene":"اجتمعت قريش فأرسلت عتبة بن ربيعة يفاوض النبي ﷺ ويعرض عليه المال والملك، فلما فرغ قال النبي ﷺ: «أقد فرغت أبا الوليد؟» قال: نعم. قال: «فاسمع مني»، ثم قرأ: «بسم الله الرحمن الرحيم ﴿حم * تَنزِيلٌ مِّنَ الرَّحْمَنِ الرَّحِيمِ * كِتَابٌ فُصِّلَتْ آيَاتُهُ…﴾» فأنصت عتبة وألقى يديه خلف ظهره معتمدًا عليهما حتى بلغ ﴿فَإِنْ أَعْرَضُوا﴾.","reason":"ردُّ النبي ﷺ على عرض الدنيا كان قرآنًا يبدأ بالاسمين مرتين: في البسملة وفي ﴿تَنزِيلٌ مِّنَ الرَّحْمَنِ الرَّحِيمِ﴾ — فالجواب على المال والملك أن هذا الكتاب من الرحمن الرحيم، لا من طالب ملك. واختيار فصلت التي يليها الإنذار جعل الرحمة تسبق الإنذار.","adds":"يُري الشاهد الاسمين في أول ما سمعه أعظم مفاوضي قريش، وأنهما أخرساه — فالاسم حجةٌ على من يعرض الدنيا."},{"i":7,"of":7,"text":"الرحِمُ حُجْنَةٌ متَمسِّكةٌ بالعَرشِ ، تكلَّمَ بلِسانٍ ذَلِقٍ : اللَّهمَّ صِلْ من وَصَلَني ، واقطَع من قَطعني ، فيقولُ اللهُ تبارَك وتعالى : أنا الرَّحمنُ الرَّحيمُ ، إنِّي شقَقتُ للرِّحِمِ مِن اسمي ، فمَن وصلَها وصَلْتُه ، ومن بتَكَها بتَكْتُهُ","narrator":"أنس بن مالك","source":"صحيح الترغيب 2531","grade":"حسن","judgment":"حسن لغيره","url":"https://dorar.net/h/CZJwTZPw","nameForm":"الرَّحمنُ الرَّحيمُ","scene":"أنس: «الرحم حجنةٌ متمسكة بالعرش، تكلم بلسانٍ ذلق: اللهم صل من وصلني واقطع من قطعني، فيقول الله تبارك وتعالى: أنا الرحمن الرحيم، إني شققت للرحم من اسمي، فمن وصلها وصلته ومن بتكها بتكته».","reason":"الله يقول الاسمين عن نفسه تعليلًا لصلة الرحم: اسم الرحم مشتقٌّ من اسمه، فمن وصل ما اشتق من اسمه وصله. فالاسم هنا أصل تشريع: الصلة لأن الرحم قطعةٌ من اسم الرحمن الرحيم.","adds":"يقدّم الشاهد بعدًا عمليًّا للاسمين: صلة الرحم عبادة اسمية — تصل اسم الله إذ تصل رحمك."}],"sunnah":{"card":"الصيغة: الرَّحْمَنُ الرَّحِيمُ — مركّبة\nفي السنة: 9 شواهد (22 رواية)\nخصوصية الورود في السنة: الاسمان في السنة اسمُ الثناء في الفاتحة: «إذا قال العبد: الرحمن الرحيم، قال الله: أثنى عليّ عبدي» (مسلم)؛ والنبي ﷺ يقف عندهما في قراءته آيةً آية؛ ويُلقيهما جبريل أول ما يُلقي؛ ويرفضهما سهيل في الحديبية «لا نعرف الرحمن الرحيم»، وتهزأ بهما قريش؛ ويقولهما الله للرحم: «أنا الرحمن الرحيم شققت للرحم من اسمي».\nالمعنى المختصر: الرحمن: ذو الرحمة الواسعة الشاملة؛ الرحيم: الموصل رحمته إلى من يشاء.","teaches":"1. أن قوله «الرحمن الرحيم» في الفاتحة ثناءٌ يجيب الله عليه في الحال.\n2. أن كل سورةٍ تنزل مفتتحةً بالرحمة.\n3. أن الاسمين شعارٌ فارق: عرفهما المؤمنون وأنكرهما سهيل وقريش.\n4. أن الرحم مشتقة من اسمه: من وصلها وصله.\n5. أن الرحمة تُقدَّم بين يدي سؤال المطر.","whenRecall":"- في كل ركعة عند ﴿الرَّحْمَنِ الرَّحِيمِ﴾: انتظر «أثنى عليّ عبدي».\n- عند الاستسقاء والحاجة العامة.\n- حين تصل رحمك أو تهم بقطعها.\n- حين يُستهزأ بشعائر الدين: أخفِ ولا تترك.\n- عند افتتاح كل سورة.","whenPray":"عند الشعور بـ:\n1. الجدب والقحط والحاجة العامة.\n2. قطيعةٍ في الرحم.\n3. الاستخفاف بشعائرك.\nعند طلب:\n1. الغيث ورفع الجدب.\n2. أن يصلك الله كما وصلت رحمك.\nعند الرغبة في:\n1. أن تقرأ الفاتحة وتقف عند كل آية.\n2. أن تفتتح كل أمرٍ بالبسملة كما يفتتح جبريل كل سورة.","duaItems":"1. الفاتحة آيةً آية بالوقف عند ﴿الرَّحْمَنِ الرَّحِيمِ﴾ — المستدرك 2950، وصحيح مسلم 395 (حديث «قسمت الصلاة»).\n2. دعاء الاستسقاء: ﴿الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ * الرَّحْمَنِ الرَّحِيمِ * مَالِكِ يَوْمِ الدِّينِ﴾ لا إله إلا الله يفعل ما يريد، اللهم أنت الله لا إله إلا أنت الغني ونحن الفقراء، أنزل علينا الغيث واجعل ما أنزلت لنا قوةً وبلاغًا إلى حين — المستدرك 1242.\n3. صلة الرحم عملًا: «أنا الرحمن الرحيم، شققت للرحم من اسمي، فمن وصلها وصلته» — صحيح الترغيب 2531 (حسن لغيره).","summary":"«الرحمن الرحيم» في السنة ثناءٌ يُجاب: «أثنى عليّ عبدي» — يُوقف عندهما في القراءة، ويفتتح بهما جبريل كل سورة، وأنكرهما سهيل في الحديبية، وشقّ الله منهما اسم الرحم؛ فمن وصل رحمه وصل شيئًا من الاسم."},"situations":[{"situationId":53,"verses":[],"hadiths":[{"i":7,"strength":"direct","headline":"قطيعةٌ أو جفوةٌ مع ذوي الرحم","bridge":"جفوةٌ مع رحم؟ قال الله: «أنا الرحمن الرحيم، شققت للرحم من اسمي، فمن وصلها وصلته ومن بتكها بتكته» — صلتك لرحمك صلةٌ لشيءٍ من اسمه."}]},{"situationId":70,"verses":[],"hadiths":[{"i":4,"strength":"direct","headline":"منعك من إظهار شعائر دينك لمصلحةٍ أعظم","bridge":"يُستخف بشعائرك؟ أنكر سهيل «الرحمن الرحيم» في الحديبية وقال: «لا نعرف الرحمن الرحيم»، فقبل النبي ﷺ أن يُكتب «باسمك اللهم» حفاظًا على الصلح — الاسم يُصان بالقلب حين يُمنع من الورق."}]},{"situationId":126,"verses":[],"hadiths":[{"i":6,"strength":"direct","headline":"عرض المال أو المنصب ثمنًا للتنازل عن الدين","bridge":"عُرض عليك مالٌ أو منصب مقابل دينك؟ عرض عتبة على النبي ﷺ الملك فأجابه: «بسم الله الرحمن الرحيم ﴿حم * تَنزِيلٌ مِّنَ الرَّحْمَنِ الرَّحِيمِ﴾» — الجواب على الدنيا أن كتابك من الرحمن الرحيم."}]},{"situationId":132,"verses":[{"i":1,"strength":"direct","headline":"تعريف من تدعوه بالله وإعراضه عنك","bridge":"تعرّف أحدًا بالله فيعرض؟ ابدأ من حيث بدأ القرآن: ﴿وَإِلَهُكُمْ إِلَهٌ وَاحِدٌ لَا إِلَهَ إِلَّا هُوَ الرَّحْمَنُ الرَّحِيمُ﴾ — بعد تقرير الوحدانية جاء أول وصفٍ للإله الواحد: الرحمن الرحيم؛ فالتوحيد يُقدَّم بوجه الرحمة لا بوجه الرهبة، والوحدانية الجاذبة أول الطريق."}],"hadiths":[]},{"situationId":151,"verses":[],"hadiths":[{"i":1,"strength":"direct","headline":"قراءة الفاتحة في الصلاة بحضور قلب","bridge":"تقرأ الفاتحة في كل ركعة؟ إذا قلت ﴿الرَّحْمَنِ الرَّحِيمِ﴾ قال الله: «أثنى عليّ عبدي» — فاقرأهما متأنيًا، فأنت في حوار."},{"i":2,"strength":"direct","headline":"التعجّل في تلاوة الفاتحة دون وقوفٍ عند آياتها","bridge":"تريد أن تعرف كيف تُقرأ الأسماء في الفاتحة؟ أم سلمة: كان النبي ﷺ يقطّع قراءته آيةً آية: ﴿الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ﴾ ثم يقف، ﴿الرَّحْمَنِ الرَّحِيمِ﴾ ثم يقف — الاسمان آيةٌ تامة يُوقف عندها وتُتأمل لا تُوصل بما بعدها."}]},{"situationId":162,"verses":[],"hadiths":[{"i":3,"strength":"direct","headline":"قحط الرزق وتقديم الثناء بالرحمة قبل طلب أثرها","bridge":"قحطٌ في الرزق؟ في الاستسقاء قدّم النبي ﷺ ﴿الرَّحْمَنِ الرَّحِيمِ﴾ ثم قال: «أنت الغني ونحن الفقراء، أنزل علينا الغيث» — سمِّ الرحمة قبل أن تطلب أثرها."}]},{"situationId":188,"verses":[{"i":3,"strength":"direct","headline":"هيبة أسماء الجلال والخوف عند قراءتها","bridge":"تقرأ أسماء الجلال في الحشر فتخاف؟ العرض افتُتح بالرحمة: ﴿هُوَ اللَّهُ الَّذِي لَا إِلَهَ إِلَّا هُوَ عَالِمُ الْغَيْبِ وَالشَّهَادَةِ هُوَ الرَّحْمَنُ الرَّحِيمُ﴾ — قبل الملك والقدوس والعزيز والجبار والمتكبر جاء الرحمن الرحيم أولًا؛ فرتّب معرفتك كما رتّبها الله: الرحمة أولًا ثم الجلال."}],"hadiths":[]},{"situationId":189,"verses":[],"hadiths":[{"i":5,"strength":"direct","headline":"تلاوة البسملة في مفتتح كل سورةٍ وتدبرها","bridge":"تفتح سورةً فتمرّ على بسملتها؟ ابن عباس: كان جبريل إذا جاء إلى النبي ﷺ بالقرآن أول ما يُلقي عليه بسم الله الرحمن الرحيم، فإذا أُلقيت الثانية علم أنه ختم السورة وافتتح الأخرى — الاسمان مفتاح الوحي وفاصله؛ فكل سورةٍ نازلة من الرحمن الرحيم مهما كان موضوعها."}]},{"situationId":191,"verses":[{"i":2,"strength":"direct","headline":"قراءة القرآن بلا تأثّرٍ ولا خشوع","bridge":"تقرأ ولا تتأثر؟ اقرأ القرآن بعنوانه: ﴿تَنْزِيلٌ مِنَ الرَّحْمَنِ الرَّحِيمِ﴾ — نُسب التنزيل هنا إلى الرحمة مثنّاة في سورة إعراض الأكثرين؛ فاقرأه قراءة من يتلقى رسالة رحمةٍ شخصية لا نصَّ تكاليفَ جافًّا، يلن لك ما لان لغيرك."}],"hadiths":[]}]},{"id":57,"name":"خير الرازقين","compound":true,"meaning":"بطاقة الاسم:\nالصيغة: خَيْرُ الرَّازِقِينَ — صيغة تفضيل | المواضع: 5 (المائدة: 114 — الحج: 58 — المؤمنون: 72 — سبأ: 39 — الجمعة: 11)\nخصوصية: مواضعه الخمسة ترسم «فقه الرزق» كاملًا: رزقٌ يُتعبَّد به، ورزقٌ لا ينقطع بالموت، ورزقٌ يحرر من أجور الخلق، ورزقٌ يُخلِف النفقة، ورزقٌ لا تفوّته صلاة.\n\nالمعنى:\n- خير الرازقين: أفضلُ من رزق — لأن رزقه بلا سببٍ ملزم ولا انقطاعٍ ولا منّ، وكلُّ رازقٍ سواه إنما يرزق من رزقه.","teaches":"الحقائق التي كشفتها المواضع:\n1. ما أنفقتَ يُخلَف — قانون معلن: ﴿فَهُوَ يُخْلِفُهُ﴾.\n2. رزق من مات في طريق الله مستمر بعد موته.\n3. الصلاة لا تفوّت رزقًا: ما عند الله خير من التجارة.\n4. الداعية والمصلح يستغني بخراج ربه عن أجور الخلق.","whenRecall":"لحظات الاستحضار — مشتقة من مواضعه:\n- حين يزاحم قلقُ الرزق صلاتك وجُمعتك.\n- عند التردد في نفقةٍ خوفَ النقص.\n- حين يُعرض عليك مالٌ يرتهن به دينُك أو كلمتُك.","whenPray":"بنود الدعاء — مشتقة من سياقات المواضع:\n1. طلب رزقٍ فيه بركة ومعنى: دعاء المائدة — ﴿وَارْزُقْنَا وَأَنْتَ خَيْرُ الرَّازِقِينَ﴾ — المائدة 114.\n2. عند الإنفاق: استحضار وعد الإخلاف — سبأ 39.\n3. عند تعارض الرزق والعبادة: ﴿مَا عِنْدَ اللَّهِ خَيْرٌ﴾ — الجمعة 11.\n4. من السنة: «اللَّهُمَّ اكْفِنِي بِحَلَالِكَ عَنْ حَرَامِكَ وَأَغْنِنِي بِفَضْلِكَ عَمَّنْ سِوَاكَ» — رواه الترمذي وحسّنه.","summary":"أنفق ولا تخف: ﴿وَمَا أَنْفَقْتُمْ مِنْ شَيْءٍ فَهُوَ يُخْلِفُهُ وَهُوَ خَيْرُ الرَّازِقِينَ﴾ — رازقٌ لا ينقطع عطاؤه حتى بعد موتك، فلا تبع صلاتك بقافلة.","verses":[{"i":1,"of":5,"s":5,"surah":"المائدة","a":114,"text":"قَالَ عِيسَى ابْنُ مَرْيَمَ اللَّهُمَّ رَبَّنَا أَنْزِلْ عَلَيْنَا مَائِدَةً مِنَ السَّمَاءِ تَكُونُ لَنَا عِيدًا لِأَوَّلِنَا وَآخِرِنَا وَآيَةً مِنْكَ وَارْزُقْنَا وَأَنْتَ خَيْرُ الرَّازِقِينَ","prev":{"a":113,"text":"قَالُوا نُرِيدُ أَنْ نَأْكُلَ مِنْهَا وَتَطْمَئِنَّ قُلُوبُنَا وَنَعْلَمَ أَنْ قَدْ صَدَقْتَنَا وَنَكُونَ عَلَيْهَا مِنَ الشَّاهِدِينَ"},"next":{"a":115,"text":"قَالَ اللَّهُ إِنِّي مُنَزِّلُهَا عَلَيْكُمْ فَمَنْ يَكْفُرْ بَعْدُ مِنْكُمْ فَإِنِّي أُعَذِّبُهُ عَذَابًا لَا أُعَذِّبُهُ أَحَدًا مِنَ الْعَالَمِينَ"},"context":"طلب الحواريون مائدةً من السماء، فدعا عيسى: ﴿اللَّهُمَّ رَبَّنَا أَنْزِلْ عَلَيْنَا مَائِدَةً مِنَ السَّمَاءِ تَكُونُ لَنَا عِيدًا لِأَوَّلِنَا وَآخِرِنَا وَآيَةً مِنْكَ وَارْزُقْنَا وَأَنْتَ خَيْرُ الرَّازِقِينَ﴾.","reason":"رفع عيسى طلبَ الرزق إلى أعلى معانيه: مائدةٌ تكون عيدًا وآيةً — رزقٌ يُتعبَّد به ويُحتفل ويُستدل — ثم ختم بخير الرازقين: فرزقُه يجمع الغذاءَ والمعنى معًا، ولا يضيق عن مائدةٍ من السماء.","adds":"ارفع سقف طلب الرزق ومعناه: اسأل رزقًا يكون لك عيدًا وآيةً وقربة — لا مجرد سدّ جوع."},{"i":2,"of":5,"s":22,"surah":"الحج","a":58,"text":"وَالَّذِينَ هَاجَرُوا فِي سَبِيلِ اللَّهِ ثُمَّ قُتِلُوا أَوْ مَاتُوا لَيَرْزُقَنَّهُمُ اللَّهُ رِزْقًا حَسَنًا وَإِنَّ اللَّهَ لَهُوَ خَيْرُ الرَّازِقِينَ","prev":{"a":57,"text":"وَالَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا فَأُولَئِكَ لَهُمْ عَذَابٌ مُهِينٌ"},"next":{"a":59,"text":"لَيُدْخِلَنَّهُمْ مُدْخَلًا يَرْضَوْنَهُ وَإِنَّ اللَّهَ لَعَلِيمٌ حَلِيمٌ"},"reason":"من مات في طريق الله لم ينقطع رزقُه بموته — بل ﴿لَيَرْزُقَنَّهُمُ﴾ بنون التوكيد رزقًا حسنًا بعد الموت: فهو خيرُ الرازقين لأنه يرزق حيث ينقطع كلُّ رازقٍ سواه — خلف القبر.","adds":"لمن يخاف على رزقه إن سلك طريق الله: الرازق الذي معك يرزق حتى بعد الموت — فكيف في الحياة؟"},{"i":3,"of":5,"s":23,"surah":"المؤمنون","a":72,"text":"أَمْ تَسْأَلُهُمْ خَرْجًا فَخَرَاجُ رَبِّكَ خَيْرٌ وَهُوَ خَيْرُ الرَّازِقِينَ","prev":{"a":71,"text":"وَلَوِ اتَّبَعَ الْحَقُّ أَهْوَاءَهُمْ لَفَسَدَتِ السَّمَاوَاتُ وَالْأَرْضُ وَمَنْ فِيهِنَّ بَلْ أَتَيْنَاهُمْ بِذِكْرِهِمْ فَهُمْ عَنْ ذِكْرِهِمْ مُعْرِضُونَ"},"next":{"a":73,"text":"وَإِنَّكَ لَتَدْعُوهُمْ إِلَى صِرَاطٍ مُسْتَقِيمٍ"},"context":"﴿أَمْ تَسْأَلُهُمْ خَرْجًا فَخَرَاجُ رَبِّكَ خَيْرٌ وَهُوَ خَيْرُ الرَّازِقِينَ﴾ — ردًّا على من ظنّ أن النبي ﷺ يطلب أجرًا على دعوته.","reason":"استغنى البلاغُ النبوي عن أجور الناس: خراجُ الرب — عطاؤه الدائم — خيرٌ من خرجهم المقطوع. فمن ارتزق من جمهوره ارتهن له، ومن استغنى بخير الرازقين تحرر بلاغُه وصدقت كلمته.","adds":"قاعدة استقلال الدعاة والمصلحين: لا تجعل رزقك في جيب من تدعوهم — فخراج ربك خير."},{"i":4,"of":5,"s":34,"surah":"سبأ","a":39,"text":"قُلْ إِنَّ رَبِّي يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ مِنْ عِبَادِهِ وَيَقْدِرُ لَهُ وَمَا أَنْفَقْتُمْ مِنْ شَيْءٍ فَهُوَ يُخْلِفُهُ وَهُوَ خَيْرُ الرَّازِقِينَ","prev":{"a":38,"text":"وَالَّذِينَ يَسْعَوْنَ فِي آيَاتِنَا مُعَاجِزِينَ أُولَئِكَ فِي الْعَذَابِ مُحْضَرُونَ"},"next":{"a":40,"text":"وَيَوْمَ يَحْشُرُهُمْ جَمِيعًا ثُمَّ يَقُولُ لِلْمَلَائِكَةِ أَهَؤُلَاءِ إِيَّاكُمْ كَانُوا يَعْبُدُونَ"},"reason":"قانونُ الإخلاف الصريح: ما أنفقتَ من شيءٍ — أيِّ شيء — فهو يخلفه: فالإنفاق لا يُنقص الرزق بل يستدعي الخلَف من خير الرازقين. والبسطُ والقدرُ بمشيئته وحكمته، لا بذكاء الساعين وحدهم.","adds":"أشهر آية في ضمان الخلف: علّقها على باب قلبك عند كل تردد في نفقة — ﴿فَهُوَ يُخْلِفُهُ﴾."},{"i":5,"of":5,"s":62,"surah":"الجمعة","a":11,"text":"وَإِذَا رَأَوْا تِجَارَةً أَوْ لَهْوًا انْفَضُّوا إِلَيْهَا وَتَرَكُوكَ قَائِمًا قُلْ مَا عِنْدَ اللَّهِ خَيْرٌ مِنَ اللَّهْوِ وَمِنَ التِّجَارَةِ وَاللَّهُ خَيْرُ الرَّازِقِينَ","prev":{"a":10,"text":"فَإِذَا قُضِيَتِ الصَّلَاةُ فَانْتَشِرُوا فِي الْأَرْضِ وَابْتَغُوا مِنْ فَضْلِ اللَّهِ وَاذْكُرُوا اللَّهَ كَثِيرًا لَعَلَّكُمْ تُفْلِحُونَ"},"context":"قدمت قافلةُ تجارةٍ والنبيُّ ﷺ يخطب الجمعة، فانفضّ أكثرُ الناس إليها: ﴿وَإِذَا رَأَوْا تِجَارَةً أَوْ لَهْوًا انْفَضُّوا إِلَيْهَا وَتَرَكُوكَ قَائِمًا قُلْ مَا عِنْدَ اللَّهِ خَيْرٌ مِنَ اللَّهْوِ وَمِنَ التِّجَارَةِ وَاللَّهُ خَيْرُ الرَّازِقِينَ﴾.","reason":"صُحح الميزان المقلوب: ظنوا أن القافلة هي الرزق فتركوا الصلاة — والحقيقة: ما عند الله خيرٌ من التجارة، والرزق من خير الرازقين لا من القافلة؛ فحضورُك مع الله لا يفوّت رزقًا — بل هو بابه.","adds":"علاج أخطر أمراض العصر: قلقُ الرزق الذي يسحبك من صلاتك وجُمعتك — الرازق واحد، والقافلة سبب لا مصدر.","dorar":[{"id":"4mif8VKW","label":"صحيح البخاري 4899"},{"id":"ni2DdA9P","label":"صحيح مسلم 863"},{"id":"2mXqrpUn","label":"صحيح ابن خزيمة 3/ 311"}]}],"hadiths":[{"i":1,"of":2,"text":"أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم كان يدعو إذا استسقى: «اللهُمَّ أنزِلْ في أرضِنا بركتَها، وزينها وسكَنها» [وفي روايةٍ] «وارزُقْنا، وأنت خيرُ الرَّازِقين","narrator":"سمرة بن جندب","source":"سبل الهدى والرشاد 8/339","grade":"صحيح","judgment":"إسناده حسن، أو صحيح.","url":"https://dorar.net/h/ItVhR5Bu","nameForm":"خيرُ الرَّازِقين","scene":"سمرة بن جندب: كان النبي ﷺ يدعو إذا استسقى: «اللهم أنزل في أرضنا بركتها وزينتها وسكنها» وفي رواية: «وارزقنا، وأنت خير الرازقين».","reason":"الاستسقاء طلب رزقٍ من السماء لا من الأرض: فيُختم بالاسم الذي يميز رازقًا لا يحتاج إلى سببٍ أرضي. و«خير الرازقين» بصيغة التفضيل بعد «ارزقنا»: طلبٌ ثم تعليل — ارزقنا لأنك خير من يرزق.","adds":"يعطي الشاهد الاسم موضعًا في دعاء الاستسقاء النبوي، فيُدعى به عند الجدب."},{"i":2,"of":2,"text":"في قولِهِ عزَّ وجلَّ :  وَمَا أَنْفَقْتُمْ مِنْ شَيْءٍ فَهُوَ يُخْلِفُهُ وَهُوَ خَيْرُ الرَّازِقِينَ  [ سبأ : 39 ] قال : في غَيْرِ إسرافٍ ولا تَقْتِيرٍ","narrator":"عبدالله بن عباس","source":"صحيح الأدب المفرد 344","grade":"صحيح","judgment":"إسناده صحيح","url":"https://dorar.net/h/3f2pohY8","nameForm":"خَيْرُ الرَّازِقِينَ","scene":"ابن عباس في قوله ﴿وَمَا أَنفَقْتُم مِّن شَيْءٍ فَهُوَ يُخْلِفُهُ وَهُوَ خَيْرُ الرَّازِقِينَ﴾: قال: «في غير إسرافٍ ولا تقتير».","reason":"الآية تعد بالخلف لكل نفقة، ثم تعلل بالاسم؛ وابن عباس يقيّد النفقة الموعودة بالخلف: ما كان في غير إسرافٍ ولا تقتير. فخير الرازقين يُخلف على من أنفق بميزان — لا على المسرف ولا على المقتّر.","adds":"يُبيّن الشاهد شرط الخلف الموعود في الآية، فيربط الاسم بأدب الإنفاق."}],"sunnah":{"card":"الصيغة: خَيْرُ الرَّازِقِينَ — مركّبة\nفي السنة: شاهدان (روايتان)\nخصوصية الورود في السنة: الاسم في دعاء الاستسقاء «وارزقنا وأنت خير الرازقين»، وفي تفسير ابن عباس لآية الإنفاق ﴿وَمَا أَنفَقْتُم مِّن شَيْءٍ فَهُوَ يُخْلِفُهُ وَهُوَ خَيْرُ الرَّازِقِينَ﴾: في غير إسرافٍ ولا تقتير.\nالمعنى المختصر: الذي رزقه خير من رزق كل رازق، لا يقطعه ولا يمنّ به.","teaches":"1. أن رزقه من السماء لا يحتاج سببًا من الأرض.\n2. أنه يُخلف على المنفق المعتدل.\n3. أنه خير من يُطلب منه الرزق: يُختم به الدعاء.","whenRecall":"- عند الاستسقاء والجدب.\n- حين تنفق وتخاف الفقر: هو يخلف.\n- حين تُسرف أو تقتّر: الخلف مشروط بالتوسط.","whenPray":"عند الشعور بـ:\n1. ضيق الرزق والقحط.\n2. الخوف من الإنفاق.\nعند طلب:\n1. الرزق والبركة في الأرض.\n2. خلف ما أنفقت.\nعند الرغبة في:\n1. الاعتدال في النفقة لتستحق الخلف.","duaItems":"«اللهم أنزل في أرضنا بركتها وزينتها وسكنها، وارزقنا، وأنت خير الرازقين» — دعاء الاستسقاء — سبل الهدى 8/339 (إسناده حسن أو صحيح).","summary":"«خير الرازقين» في السنة خاتمة دعاء الاستسقاء «وارزقنا وأنت خير الرازقين»، وعلّة الخلف على من أنفق في غير إسرافٍ ولا تقتير."},"situations":[{"situationId":39,"verses":[{"i":1,"strength":"direct","headline":"ضيق الدخل واستكثار ما تسأله من الرزق","bridge":"دخلٌ لا يكفي؟ عيسى طلب مائدةً من السماء ولم يستكثرها لأنه وجّه الطلب إلى ﴿خَيْرُ الرَّازِقِينَ﴾ — ورفع سقف المعنى: ﴿تَكُونُ لَنَا عِيدًا لِأَوَّلِنَا وَآخِرِنَا وَآيَةً مِنْكَ وَارْزُقْنَا﴾؛ فاسأل رزقًا يكون عيدًا وآية لا مجرد سدّ جوع، ممن لا يضيق عن مائدةٍ من السماء."}],"hadiths":[{"i":1,"strength":"direct","headline":"الجدب وضيق الرزق وانقطاع المطر","bridge":"ضاق رزقك؟ ادعُ بما دعا به النبي ﷺ عند الجدب: «اللهم أنزل في أرضنا بركتها… وارزقنا، وأنت خير الرازقين» — من يرزق من السماء لا ينتظر سببًا من الأرض."}]},{"situationId":41,"verses":[{"i":2,"strength":"direct","headline":"الخوف على الرزق ومصدر الدخل عند سلوك طريق الله","bridge":"تخاف على رزقك إن سلكت طريق الله؟ الذين هاجروا ثم قُتلوا أو ماتوا ﴿لَيَرْزُقَنَّهُمُ اللَّهُ رِزْقًا حَسَنًا وَإِنَّ اللَّهَ لَهُوَ خَيْرُ الرَّازِقِينَ﴾ — يرزق حيث ينقطع كل رازقٍ سواه، خلف القبر؛ فكيف يقطع رزقك في الحياة؟"}],"hadiths":[]},{"situationId":42,"verses":[{"i":3,"strength":"direct","headline":"ارتهان الكلمة لمن بيده الرزق","bridge":"تعظّم من بيده رزقك حتى ارتهنت له كلمتك؟ استغنى البلاغ النبوي عن أجور الناس: ﴿أَمْ تَسْأَلُهُمْ خَرْجًا فَخَرَاجُ رَبِّكَ خَيْرٌ وَهُوَ خَيْرُ الرَّازِقِينَ﴾ — من ارتزق من جمهوره ارتهن له؛ فلا تجعل رزقك في جيب من تخافه، فخراج ربك خير."}],"hadiths":[]},{"situationId":43,"verses":[{"i":4,"strength":"direct","headline":"التردد في الإنفاق خوفًا من الفقر","bridge":"تريد أن تنفق ويخوّفك الفقر؟ علّق على باب قلبك قانون الإخلاف: ﴿وَمَا أَنْفَقْتُمْ مِنْ شَيْءٍ فَهُوَ يُخْلِفُهُ وَهُوَ خَيْرُ الرَّازِقِينَ﴾ — أيُّ شيء، بلا استثناء؛ الإنفاق لا يُنقص الرزق بل يستدعي الخلَف من خير الرازقين."}],"hadiths":[{"i":2,"strength":"direct","headline":"الخوف من الفقر عند الإنفاق","bridge":"تخاف أن تنفق فتفتقر؟ ﴿وَمَا أَنفَقْتُم مِّن شَيْءٍ فَهُوَ يُخْلِفُهُ وَهُوَ خَيْرُ الرَّازِقِينَ﴾ — وقيّدها ابن عباس: في غير إسرافٍ ولا تقتير. أنفق بميزان يُخلف عليك خير الرازقين."}]},{"situationId":152,"verses":[{"i":5,"strength":"direct","headline":"قلق الرزق الذي يسحبك من صلاتك","bridge":"قلق الرزق يسحبك من صلاتك؟ انفضّ الناس عن خطبة الجمعة إلى قافلة تجارة، فنزل: ﴿قُلْ مَا عِنْدَ اللَّهِ خَيْرٌ مِنَ اللَّهْوِ وَمِنَ التِّجَارَةِ وَاللَّهُ خَيْرُ الرَّازِقِينَ﴾ — القافلة سببٌ لا مصدر؛ حضورك مع الله لا يفوّت رزقًا بل هو بابه."}],"hadiths":[]}]}]}