{"schema":1,"kind":"sunan-chunk","version":"sunan-cb5af5731a1c","needId":70,"stateIds":[746,747,748,749,750,751,752,753,754,755,756,757,758,759,760,761,762,763,764,765,766],"items":[{"id":"س-03042","fp":"1e47ccfcdfa5","stateId":746,"easy":"إذا قضيت بغير علم ← ففي النار","cause":"وقاضي قَضَى بغَيْرِ عِلْمٍ","result":"فهُو في النَّارِ","explicit":true,"similar":["س-03043","س-03044","س-02972","س-02855","س-05022","س-01698","س-02854","س-02858"],"ref":"المستدرك على الصحيحين 7207","srcLabel":"مسلم","text":["القُضاةُ ثَلاثةٌ: قاضيانِ في النَّارِ، وقاضِي في الجَنَّةِ؛ قاضِي عَرَفَ الحَقَّ فقَضَى بهِ، فهُو في الجَنَّةِ، وقاضِي عرَفَ الحَقَّ، فجارَ مُتَعَمِّدًا، فهو في النَّارِ، ",["وقاضي قَضَى بغَيْرِ عِلْمٍ",1],"، ",["فهُو في النَّارِ",2],"."],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"صحيح الإسناد ...، وله شاهد بإسناد صحيح على شرط مسلم","bab":"إيمان › الوعيد","dorar":"cziWmKOJ"},{"id":"س-03043","fp":"3e9ddfea27eb","stateId":746,"easy":"إذا قضيت بجور ← ففي النار","cause":"وقاضٍ قضَى بجَوْرٍ","result":"فهُو في النَّارِ","explicit":true,"repOf":"س-03042","ref":"المستدرك على الصحيحين 7208","text":["قاضِيانِ في النَّارِ، وقاضٍ في الجنَّةِ؛ قاضٍ قَضَى بالحَقِّ فهو في الجَنَّةِ، ",["وقاضٍ قضَى بجَوْرٍ",1]," ",["فهُو في النَّارِ",2],"، وقاضٍ قضَى بجَهْلِه فهُو في النَّارِ. قالوا: فما ذَنْبُ هذا الَّذي يَجْهَلُ؟ قالَ: ذَنْبُه ألَّا يكونَ قاضِيًا حتَّى يَعْلَمَ."],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"[إسناده صحيح على شرط مسلم]","bab":"إيمان › الوعيد","dorar":"UozvicWh"},{"id":"س-03044","fp":"a516e8ccf7b4","stateId":746,"easy":"إذا قضيت بجهلك ← ففي النار","cause":"وقاضٍ قضَى بجَهْلِه","result":"فهُو في النَّارِ","explicit":true,"repOf":"س-03042","ref":"المستدرك على الصحيحين 7208","text":["قاضِيانِ في النَّارِ، وقاضٍ في الجنَّةِ؛ قاضٍ قَضَى بالحَقِّ فهو في الجَنَّةِ، وقاضٍ قضَى بجَوْرٍ فهُو في النَّارِ، ",["وقاضٍ قضَى بجَهْلِه",1]," ",["فهُو في النَّارِ",2],". قالوا: فما ذَنْبُ هذا الَّذي يَجْهَلُ؟ قالَ: ذَنْبُه ألَّا يكونَ قاضِيًا حتَّى يَعْلَمَ."],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"[إسناده صحيح على شرط مسلم]","bab":"إيمان › الوعيد","dorar":"UozvicWh"},{"id":"س-07454","fp":"291e2f8af046","stateId":746,"easy":"إذا قلت ولم يُرد عليك قولك (من الأمراء الظلمة) ← تتقاحم في النار","cause":"يقولونَ ، فلا يُرَدُّ عليهم قولُهُمْ","result":"يَتَقَاحَمُونَ في النارِ","explicit":true,"ref":"صحيح الجامع 3615","srcLabel":"الطبراني","text":["سَتَكُونُ أَئِمَّةٌ من بَعْدِي ، ",["يقولونَ ، فلا يُرَدُّ عليهم قولُهُمْ",1]," ، ",["يَتَقَاحَمُونَ في النارِ",2]," كما تَقَاحُمَ القِرَدَةِ"],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((الأوسط)) (5311)، وأبو الشيخ في ((أمثال الحديث)) (271) واللفظ لهما، وأبو يعلى (7382) بلفظه مطولًا.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"jMJ3iJ3o","merged":4,"otherRefs":["صحيح الجامع 2990 (صحيح)","مجمع الزوائد 5/239 (حسن)","السلسلة الصحيحة 1790 (حسن)"]},{"id":"س-02971","fp":"3199de4ed64b","stateId":746,"easy":"إذا عرفت الحق فلم تقضِ به وجرت ← ففي النار","cause":"ورَجُلٌ عَرَفَ الحَقَّ فلمْ يَقْضِ به، وجار في الحُكمِ","result":"فهو في النَّارِ","explicit":true,"ref":"تخريج مشكل الآثار 9/209","srcLabel":"الطحاوي","text":["القُضاةُ ثلاثةٌ: قاضيانِ في النَّارِ، وقاضٍ في الجنَّةِ؛ فأمَّا الذي في الجنَّةِ، فرَجُلٌ عَرَفَ الحَقَّ، فقَضى به؛ فهو في الجنَّةِ، ",["ورَجُلٌ عَرَفَ الحَقَّ فلمْ يَقْضِ به، وجار في الحُكمِ",1],"؛ ",["فهو في النَّارِ",2],"، ورَجلٌ لم يَعرِفِ الحَقَّ، فقَضى للنَّاسِ على جَهلٍ؛ فهو في النَّار."],"grade":"صحيح","muhaddith":"صحيح","bab":"إيمان › الوعيد","dorar":"O3hrjtV1","merged":3,"otherRefs":["إرواء الغليل 2628 (صحيح)","المستدرك على الصحيحين 7207 (صحيح)"]},{"id":"س-02972","fp":"565f6a951351","stateId":746,"easy":"إذا قضيت للناس على جهل ← ففي النار","cause":"ورَجلٌ لم يَعرِفِ الحَقَّ، فقَضى للنَّاسِ على جَهلٍ","result":"فهو في النَّار","explicit":true,"repOf":"س-03042","ref":"تخريج مشكل الآثار 9/209","text":["القُضاةُ ثلاثةٌ: قاضيانِ في النَّارِ، وقاضٍ في الجنَّةِ؛ فأمَّا الذي في الجنَّةِ، فرَجُلٌ عَرَفَ الحَقَّ، فقَضى به؛ فهو في الجنَّةِ، ورَجُلٌ عَرَفَ الحَقَّ فلمْ يَقْضِ به، وجار في الحُكمِ؛ فهو في النَّارِ، ",["ورَجلٌ لم يَعرِفِ الحَقَّ، فقَضى للنَّاسِ على جَهلٍ",1],"؛ ",["فهو في النَّار",2],"."],"grade":"صحيح","muhaddith":"صحيح","bab":"إيمان › الوعيد","dorar":"O3hrjtV1","merged":3,"otherRefs":["إرواء الغليل 2628 (صحيح)","مجموع الشروح الفقهية. 204/2 (صحيح)"]},{"id":"س-04934","fp":"1d2bbdfc46ba","stateId":746,"easy":"إذا كنت أميراً على عشرة ← يُؤتى بك يوم القيامة مغلولاً لا يفكك إلا العدل","cause":"ما مِن أميرِ عَشَرةٍ","result":"إلَّا يُؤتَى به يومَ القِيامةِ مَغلولًا، لا يَفُكُّه مِن ذلك الغُلِّ إلَّا العَدلُ","explicit":true,"ref":"تخريج المسند لشعيب 22463","srcLabel":"أحمد","text":[["ما مِن أميرِ عَشَرةٍ",1]," ",["إلَّا يُؤتَى به يومَ القِيامةِ مَغلولًا، لا يَفُكُّه مِن ذلك الغُلِّ إلَّا العَدلُ",2],"، وما مِن رَجُلٍ قَرَأَ القُرآنَ فنَسيَه، إلَّا لَقِيَ اللهَ يومَ يَلقاه وهو أجذَمُ."],"grade":"صحيح","narrator":"سعد بن عبادة","muhaddith":"صحيح لغيره دون قوله: \"وما من رجل قرأ القرآن ... إلخ","takhrij":"أخرجه أحمد (22463) واللفظ له، والدارمي (3340)، وعبدالرزاق (5989) مختصراً","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"dmvn7UbW","merged":3,"otherRefs":["تخريج المسند لشعيب 22456 (صحيح)","الأحكام الوسطى 2/365 (صحيح)"]},{"id":"س-07269","fp":"0e4da034d040","stateId":746,"easy":"إذا كنت إماماً ظلوماً غشوماً أو غالياً في الدين مارقاً ← لا تنالك شفاعة النبي ﷺ","cause":"إمامٌ ظَلومٌ غشومٌ ، وآخرُ غالٍ في الدِّينِ مارقٌ منهُ","result":"رجلانِ ما تَنالُهُما شفاعَتي","explicit":true,"ref":"تخريج كتاب السنة 41","srcLabel":"الطبراني","text":[["رجلانِ ما تَنالُهُما شفاعَتي ",2],":",[" إمامٌ ظَلومٌ غشومٌ ، وآخرُ غالٍ في الدِّينِ مارقٌ منهُ",1]],"grade":"صحيح","narrator":"معقل بن يسار","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (423) واللفظ له، والطبراني (20/214) (496)، وابن سمعون في ((أماليه)) (240) باختلاف يسير.","bab":"فتن › أمراء الجور","dorar":"YhyyMQji","merged":3,"otherRefs":["فتاوى صديق خان 341 (حسن)","صحيح الجامع 3798 (حسن)"]},{"id":"س-02855","fp":"5960b3314e55","stateId":746,"easy":"إذا قضيت بلا علم فأهلكت حقوق الناس ← ففي النار","cause":"وقاضٍ لا يعلَمُ ، فأَهلَكَ حقوقَ النَّاسِ","result":"فَهُوَ في النَّارِ","explicit":true,"repOf":"س-03042","ref":"صحيح الترمذي 1322","text":["القُضاةُ ثلاثةٌ : قاضيانِ في النَّارِ ، وقاضٍ في الجنَّةِ : رجلٌ قضى بغيرِ الحقِّ فعلِمَ ذاكَ فذاكَ في النَّارِ ، ",["وقاضٍ لا يعلَمُ ، فأَهلَكَ حقوقَ النَّاسِ",1]," ",["فَهُوَ في النَّارِ",2]," ، وقاضٍ قضى بالحقِّ فذلِك في الجنَّةِ"],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3573)، والترمذي (1322) واللفظ له، وابن ماجه (2315)، والنسائي في ((السنن الكبرى)) (5922).","bab":"إيمان › الوعد","dorar":"wC73r4Us","merged":2,"otherRefs":["تخريج الإحياء للعراقي 1/93 (صحيح)"]},{"id":"س-05022","fp":"0a130717d338","stateId":746,"easy":"إذا عرفت الحق فجرت أو قضيت بغير علم ← ففي النار","cause":"وقاضٍ عرفَ الحقَّ فجارَ مُتَعَمِّدًا أَوْ قَضَى بِغَيْرِ عِلْمٍ","result":"فهما في النارِ","explicit":true,"repOf":"س-03042","ref":"صحيح الجامع 4298","text":["قاضيانِ في النارِ ، وقاضٍ في الجنةِ، قاضٍ عرفَ الحقَّ فقَضَى بِهِ فهو في الجنةِ ، ",["وقاضٍ عرفَ الحقَّ فجارَ مُتَعَمِّدًا أَوْ قَضَى بِغَيْرِ عِلْمٍ",1]," ",["فهما في النارِ",2]],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3573)، والترمذي (1322)، والنسائي في ((السنن الكبرى)) (5922)، وابن ماجه (2315) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"NF4IRtT0","merged":2,"otherRefs":["تخريج مشكل الآثار 54 (حسن)"]},{"id":"س-07272","fp":"1e576cf16dac","stateId":746,"easy":"إذا وليت أمة قلّت أو كثرت فلم تعدل ← يكبك الله على وجهك في النار","cause":"ليس مِن والي أُمَّةٍ قَلَّت أو كَثُرَت، لا يَعدِلُ فيها","result":"إلَّا كَبَّه اللهُ على وَجههِ في النَّارِ","explicit":true,"similar":["س-03034"],"ref":"تخريج المسند لشعيب 20296","srcLabel":"أحمد","text":["عنِ ابنةِ مَعقِلٍ المُزَنيِّ، قالت: لَمَّا ثَقُلَ أبي أتاه ابنُ زيادٍ وساقَه، يَعني: وساقَ الحَديثَ [يَعني حَديثَ: ",["ليس مِن والي أُمَّةٍ قَلَّت أو كَثُرَت، لا يَعدِلُ فيها",1],"، ",["إلَّا كَبَّه اللهُ على وَجههِ في النَّارِ",2],"]"],"grade":"صحيح","narrator":"معقل [بن يسار] المزني","muhaddith":"صحيح","bab":"فتن › أمراء الجور","dorar":"MhBWjqS7","merged":2,"otherRefs":["صحيح الجامع 2713 (صحيح)"]},{"id":"س-07440","fp":"55a4183e7bcd","stateId":746,"easy":"إذا كنت أميراً متسلطاً أو ذا ثروة لا يؤدي حق الله أو فقيراً فخوراً ← تكون من أول من يدخل النار","cause":"فأميرٌ مُسلَّطٌ، وذو ثَروةٍ مِن مالٍ لا يؤدِّي حقَّ اللَّهِ في مالِهِ، وفَقيرٌ فخورٌ","result":"أوَّلُ ثُلَّةٍ يدخُلونَ النَّارَ","explicit":true,"ref":"صحيح ابن خزيمة 4/ 11","srcLabel":"أحمد","text":["عُرِضَ عليَّ أوَّلُ ثُلَّةٍ يدخلونَ الجنَّةَ، و",["أوَّلُ ثُلَّةٍ يدخُلونَ النَّارَ",2],"، فأمَّا أوَّلُ ثُلَّةٍ يدخلونَ الجنَّةَ: فالشَّهيدُ، وعبدٌ مملوكٌ أحسنَ عبادةَ ربِّهِ، ونَصحَ لسيِّدِهِ، وعفيفٌ مُتعفِّفٌ ذو عيالٍ، وأمَّا أوَّلُ ثلَّةٍ يدخلونَ النَّارَ: ",["فأميرٌ مُسلَّطٌ، وذو ثَروةٍ مِن مالٍ لا يؤدِّي حقَّ اللَّهِ في مالِهِ، وفَقيرٌ فخورٌ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (9492)، والحاكم (1429)، والطيالسي (2690) بنحوه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"thGyc1mt","merged":2,"otherRefs":["الكبائر للذهبي 197 (صحيح)"]},{"id":"س-01698","fp":"3518f8f79362","stateId":746,"easy":"إذا قضيت بجور ← ففي النار","cause":"ورجلٌ قضى بجورٍ","result":"فَفِي النارِ","explicit":true,"repOf":"س-03042","ref":"مجمع الزوائد 4/198","text":["القضاةُ ثلاثةٌ فرجلٌ قَضَى فَاجْتَهَدَ فأصابَ فلَهُ الجنةُ ورجلٌ قضى فاجْتَهَدَ فَأَخْطَأَ فله الجنةُ ",["ورجلٌ قضى بجورٍ",1]," ",["فَفِي النارِ",2]],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أبو داود (3573)، والترمذي (1322)، وابن ماجه (2315)، والنسائي في ((السنن الكبرى)) (5922) بنحوه مطولاً، والطبراني في ((المعجم الأوسط)) (3616) واللفظ له.","bab":"أقضية وأحكام › الحكم بالكتاب والسنة ثم باجتهاد الحاكم، والخطأ معذور","dorar":"ueK5IqIo"},{"id":"س-02854","fp":"b5e61b50c185","stateId":746,"easy":"إذا قضيت بغير الحق وأنت تعلم ← ففي النار","cause":"رجلٌ قضى بغيرِ الحقِّ فعلِمَ ذاكَ","result":"فذاكَ في النَّارِ","explicit":true,"repOf":"س-03042","ref":"صحيح الترمذي 1322","text":["القُضاةُ ثلاثةٌ : قاضيانِ في النَّارِ ، وقاضٍ في الجنَّةِ : ",["رجلٌ قضى بغيرِ الحقِّ فعلِمَ ذاكَ",1]," ",["فذاكَ في النَّارِ",2]," ، وقاضٍ لا يعلَمُ ، فأَهلَكَ حقوقَ النَّاسِ فَهُوَ في النَّارِ ، وقاضٍ قضى بالحقِّ فذلِك في الجنَّةِ"],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3573)، والترمذي (1322) واللفظ له، وابن ماجه (2315)، والنسائي في ((السنن الكبرى)) (5922).","bab":"إيمان › الوعد","dorar":"wC73r4Us"},{"id":"س-02858","fp":"6ea621682c24","stateId":746,"easy":"إذا قضيت بغير ما أمر الله ← ففي النار","cause":"وقاضٍ قضَى بغيرِ ما أمَرَ اللهُ به","result":"فهو في النارِ","explicit":true,"repOf":"س-03042","ref":"تخريج الإحياء للعراقي 1/93","text":["القضاةُ ثلاثةٌ: قاضٍ قضَى بالحقِّ وهو يعلمُ؛ فذلك في الجنَّةِ, وقاضٍ قضى بالجَوْرِ وهو يعلمُ أو لا يعلمُ؛ فهو في النارِ, ",["وقاضٍ قضَى بغيرِ ما أمَرَ اللهُ به",1],"؛ ",["فهو في النارِ",2],"."],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3573)، والترمذي (1322)، وابن ماجه (2315)، والنسائي في ((السنن الكبرى)) (5922) مطولاً.","bab":"إيمان › الوعد","dorar":"214Y1nIN"},{"id":"س-03034","fp":"346364590016","stateId":746,"easy":"إذا وليت شيئاً من أمور الأمة فلم تعدل ← يكبك الله في النار","cause":"ما مِن أحَدٍ يكونُ على شَيءٍ مِن أمورِ هذِه الأُمَّةِ، قَلَّتْ أَمْ كَثُرَتْ، فلا يَعْدِلُ فيهِمْ","result":"إلَّا أكَبَّهُ اللهُ في النَّارِ","explicit":true,"repOf":"س-07272","ref":"المستدرك على الصحيحين 7209","text":[["ما مِن أحَدٍ يكونُ على شَيءٍ مِن أمورِ هذِه الأُمَّةِ، قَلَّتْ أَمْ كَثُرَتْ، فلا يَعْدِلُ فيهِمْ؛",1]," ",["إلَّا أكَبَّهُ اللهُ في النَّارِ",2],"."],"grade":"صحيح","narrator":"والد أم معقل","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني (20/ 221) (514)، وابن أبي شيبة  (37722) كلاهما باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"XjU2UfIg"},{"id":"س-03049","fp":"10afbbb4369c","stateId":746,"easy":"إذا أُمّرت على عشرة فأكثر فلم تقسط فيهم ← تأتي يوم القيامة في الأصفاد","cause":"ما مِن أحَدٍ يُؤَمَّرُ على عَشَرةٍ فصاعِدًا لا يُقْسِطُ فيهم","result":"إلَّا جاءَ يومَ القِيامةِ في الأصفادِ والأغْلالِ","explicit":true,"ref":"المستدرك على الصحيحين 7204","srcLabel":"أحمد","text":[["ما مِن أحَدٍ يُؤَمَّرُ على عَشَرةٍ فصاعِدًا لا يُقْسِطُ فيهم؛",1]," ",["إلَّا جاءَ يومَ القِيامةِ في الأصفادِ والأغْلالِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (9573)، والدارمي (2557)، والطبراني في ((المعجم الأوسط)) (272) بنحوه","bab":"إيمان › الوعيد","dorar":"eZhsgbnr"},{"id":"س-03091","fp":"be5b0103e10d","stateId":746,"easy":"إذا جرت في الحكم متعمداً ← ففي النار","cause":"فرجُلٌ جارَ متعمِّدًا","result":"فهو في النارِ","explicit":true,"ref":"تخريج شرح السنة 2497","srcLabel":"البيهقي","text":["قال عليٌّ رَضِي اللهُ عنه: القضاةُ ثلاثةٌ: قاضيانِ في النارِ، وقاضٍ في الجنَّةِ، فأمَّا اللذانِ في النارِ، ",["فرجُلٌ جارَ متعمِّدًا",1],"، ",["فهو في النارِ",2],"، ورجُلٌ اجتهَد فأخطأ، فهو في النارِ، وأمَّا الذي في الجنَّةِ، فرجُلٌ اجتهَد فأصاب الحقَّ، فهو في الجنَّةِ.\nقال قتادةُ: فقُلْتُ لأبي العاليةِ: ما ذَنْبُ هذا الذي اجتهَد فأخطأ؟ قال: ذَنْبُهُ أن لا يكونَ قاضيًا إذ لم يَعلَمْ."],"grade":"صحيح","narrator":"أبو العالية","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن الجعد (989)، والطحاوي في ((شرح السنة)) (2498) كلاهما بلفظه، والبيهقي (20383) بنحوه.","bab":"إيمان › الوعيد","dorar":"G5dammmW"},{"id":"س-03092","fp":"88e3d4f2857c","stateId":746,"easy":"إذا اجتهدت فأخطأت (وأنت جاهل) ← ففي النار","cause":"ورجُلٌ اجتهَد فأخطأ","result":"فهو في النارِ","explicit":true,"ref":"تخريج شرح السنة 2497","srcLabel":"البيهقي","text":["قال عليٌّ رَضِي اللهُ عنه: القضاةُ ثلاثةٌ: قاضيانِ في النارِ، وقاضٍ في الجنَّةِ، فأمَّا اللذانِ في النارِ، فرجُلٌ جارَ متعمِّدًا، فهو في النارِ، ",["ورجُلٌ اجتهَد فأخطأ",1],"، ",["فهو في النارِ",2],"، وأمَّا الذي في الجنَّةِ، فرجُلٌ اجتهَد فأصاب الحقَّ، فهو في الجنَّةِ.\nقال قتادةُ: فقُلْتُ لأبي العاليةِ: ما ذَنْبُ هذا الذي اجتهَد فأخطأ؟ قال: ذَنْبُهُ أن لا يكونَ قاضيًا إذ لم يَعلَمْ."],"grade":"صحيح","narrator":"أبو العالية","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن الجعد (989)، والطحاوي في ((شرح السنة)) (2498) كلاهما بلفظه، والبيهقي (20383) بنحوه.","bab":"إيمان › الوعيد","dorar":"G5dammmW"},{"id":"س-04185","fp":"d0e929934bcd","stateId":746,"easy":"إذا وليت شيئاً من أمور المسلمين فغششتهم ← ففي النار","cause":"من وَلِيَ من أمورِ المسلمين شيئًا ، فغشَّهم","result":"فهو في النَّارِ","explicit":true,"ref":"صحيح الترغيب 2206","srcLabel":"الطبراني","text":[["من وَلِيَ من أمورِ المسلمين شيئًا ، فغشَّهم ؛ ",1],["فهو في النَّارِ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (3481)، وفي ((المعجم الصغير)) (392) باختلاف يسير.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"fneIy5cf"},{"id":"س-04930","fp":"18d77da12b6c","stateId":746,"easy":"إذا وليت أمر عشرة فما فوق ← تأتي الله مغلولاً يوم القيامة لا يفكك إلا العدل","cause":"ما مِن رَجُلٍ يَلي أمْرَ عَشَرةٍ فما فوقَ ذلك","result":"إلَّا أتى اللهَ مَغلولًا يومَ القيامةِ يدُه إلى عُنُقِه؛ فَكَّه بِرُّه، أو أَوبَقَه إثمُه، أوَّلُها مَلامةٌ، وأَوسطُها نَدامةٌ، وآخِرُها خِزيٌ يومَ القيامةِ","explicit":true,"ref":"تخريج المسند لشعيب 22300","srcLabel":"أحمد","text":[["ما مِن رَجُلٍ يَلي أمْرَ عَشَرةٍ فما فوقَ ذلك،",1]," ",["إلَّا أتى اللهَ مَغلولًا يومَ القيامةِ يدُه إلى عُنُقِه؛ فَكَّه بِرُّه، أو أَوبَقَه إثمُه، أوَّلُها مَلامةٌ، وأَوسطُها نَدامةٌ، وآخِرُها خِزيٌ يومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (22300) واللفظ له، والحارث (599)، والطبراني (8/202) (7720)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"aAglTVrg"},{"id":"س-04992","fp":"26dfb6b73c11","stateId":746,"easy":"إذا كنت أمير عشيرة ← تؤتى يوم القيامة مغلولة يداك إلى عنقك أطلقك العدل أو أوبقك الجور","cause":"أميرِ عشيرة","result":"إلَّا يُؤتَى بِهِ يومَ القيامةِ ، مَغلولةٌ يداهُ إلى عنُقِهِ ، أطلقَهُ الحقُّ أو أوبقَهُ","explicit":true,"ref":"الصحيح المسند 1395","srcLabel":"أحمد","text":["ما من ",["أميرِ عشيرة",1],"، ",["إلَّا يُؤتَى بِهِ يومَ القيامةِ ، مَغلولةٌ يداهُ إلى عنُقِهِ ، أطلقَهُ الحقُّ أو أوبقَهُ",2]," ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (9573)، والدارمي (2515) واللفظ له، والبزار (8492)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"vfgdItzi"},{"id":"س-06229","fp":"4cc728788588","stateId":746,"easy":"إذا وليت ثلاثة ← تلقى الله مغلولة يمينك: يفكها عدلك أو يغلها جورك","cause":"ما مِن والي ثلاثةٍ","result":"إلَّا لقي اللهَ مغلولةً يمينُه: فكَّه عدلُه أو غلَّه جَورُه","explicit":true,"ref":"صحيح ابن حبان 4525","srcLabel":"الطبراني","text":["بَيْنا أبو الدَّرداءِ يومًا يسيرُ شاذًّا مِن الجيشِ إذ لقيه رجلانِ شاذَّانِ مِن الجيشِ فقال: يا هذانِ إنَّه لم يكُنْ ثلاثةٌ في مِثْلِ هذا المكانِ إلَّا أمَّروا عليهم فلْيتأمَّرْ أحدُكم قالا: أنتَ يا أبا الدَّرداءِ قال: بل أنتما، سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( ",["ما مِن والي ثلاثةٍ",1]," ",["إلَّا لقي اللهَ مغلولةً يمينُه: فكَّه عدلُه أو غلَّه جَورُه )",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الطبراني في ((الشاميين)) (316)، وابن عساكر في ((تاريخ دمشق)) (46/ 312) واللفظ لهما.","bab":"سرايا › تأمير الأمراء على البعوث والسرايا ووصيتهم","dorar":"ImA3xA0m"},{"id":"س-07437","fp":"1dd8dd5092d6","stateId":746,"easy":"إذا حكمت بين الناس ← تُبعث يوم القيامة وملك آخذ بقفاك","cause":"ما من حاكِمٍ يَحكُمُ بيْنَ النَّاسِ","result":"ويُبعَثُ يَومَ القيامةِ ومَلَكٌ آخِذٌ بقَفاهُ","explicit":true,"similar":["س-08205"],"ref":"تخريج سنن الدارقطني 4465","srcLabel":"ابن ماجه","text":[["ما من حاكِمٍ يَحكُمُ بيْنَ النَّاسِ",1]," إلَّا ",["ويُبعَثُ يَومَ القيامةِ ومَلَكٌ آخِذٌ بقَفاهُ",2]," حتى يُوقِفَه على شَفيرِ جَهنَّمَ، ثُمَّ يَلتَفِتُ إلى اللهِ مُغضبًا، فإنْ قال: ألْقِه، ألْقاهُ في المَهْوى أربَعينَ خَريفًا."],"grade":"صحيح","narrator":"عبدالله","muhaddith":"صحيح","takhrij":"أخرجه الدارقطني (4465) بلفظه، وابن ماجه (2311)، وأحمد (4097) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"XoDOjOQF"},{"id":"س-07847","fp":"a76a49970562","stateId":746,"easy":"إذا وليت عشرة ← تُؤتى يوم القيامة مغلولة يدك إلى عنقك","cause":"ما من رجلٍ ولِيَ عشرَةً","result":"إلَّا أُتِيَ بهِ يومَ القيامةِ مَغْلولَةٌ يَدُهُ إلى عُنُقِهِ ، حتى يُقْضَى بينَهُ وبينَهُمْ","explicit":true,"ref":"صحيح الترغيب 2201","srcLabel":"الطبراني","text":[["ما من رجلٍ ولِيَ عشرَةً ؛",1]," ",["إلَّا أُتِيَ بهِ يومَ القيامةِ مَغْلولَةٌ يَدُهُ إلى عُنُقِهِ ، حتى يُقْضَى بينَهُ وبينَهُمْ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"حسن صحيح","takhrij":"أخرجه الطبراني (12/135) (12689)","bab":"قيامة › الحساب والقصاص","dorar":"A445kjhl"},{"id":"س-07857","fp":"8012f048157b","stateId":746,"easy":"إذا استرعاك الله رعية ← يسألك عنها يوم القيامة","cause":"لا يَستَرعي اللهُ تَبارك وتَعالى عبدًا رعيَّةً، قَلَّتْ أو كَثُرَتْ","result":"إلَّا سَأَلَه اللهُ تَبارك وتَعالى عنها يَومَ القيامَةِ، أقامَ فيهم أمْرَ اللهِ تَبارك وتَعالى أم أضاعَه؟ حتى يَسأَلَه عن أهْلِ بَيتِه خاصَّةً","explicit":true,"ref":"تخريج المسند لشعيب 4637","srcLabel":"أحمد","text":[["لا يَستَرعي اللهُ تَبارك وتَعالى عبدًا رعيَّةً، قَلَّتْ أو كَثُرَتْ",1],"، ",["إلَّا سَأَلَه اللهُ تَبارك وتَعالى عنها يَومَ القيامَةِ، أقامَ فيهم أمْرَ اللهِ تَبارك وتَعالى أم أضاعَه؟ حتى يَسأَلَه عن أهْلِ بَيتِه خاصَّةً",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (4637)، وابن أبي الدنيا في ((النفقة على العيال)) (325)، وتمام في ((الفوائد)) (1757)","bab":"قيامة › الحساب والقصاص","dorar":"C1LC1L6j"},{"id":"س-08018","fp":"3709a4a16081","stateId":746,"easy":"إذا كنت من أهل الجور أو أعوانهم ← فأنت في النار","cause":"أهْلُ الجَوْرِ وأعوانُهم","result":"في النَّارِ","explicit":true,"ref":"المستدرك على الصحيحين 7202","srcLabel":"العقيلي","text":[["أهْلُ الجَوْرِ وأعوانُهم",1]," ",["في النَّارِ",2],"."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح الإسناد","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (4/ 203) بلفظه.","bab":"مظالم › تحريم الظلم","dorar":"2GfrJNMz"},{"id":"س-04862","fp":"c6d145ea2ca7","stateId":746,"easy":"إذا كنت عريفاً (تتولى على قوم بلا عدل) ← فالعرفاء في النار","cause":"ولكنَّ العرفاءَ","result":"في النَّارِ","explicit":true,"ref":"هداية الرواة 3/466","srcLabel":"أبو داود","text":["إن العِرافة حقٌّ ولابد للنَّاسِ من عرفاءَ ",["ولكنَّ العرفاءَ",1]," ",["في النَّارِ",2]],"grade":"حسن","narrator":"جد رجل","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه أبو داود (2934)، والبيهقي (13180) واللفظ لهما في آخر حديث طويل، وابن أبي شيبة (27249) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ntjLX5zO","merged":3,"otherRefs":["السلسلة الصحيحة 1417 (حسن)","صحيح الجامع 7185 (حسن)"]},{"id":"س-03052","fp":"9ff846d8158a","stateId":746,"easy":"إذا غلب جورك عدلك في القضاء ← فلك النار","cause":"ومَن غلَب جَوْرُه عَدْلَه","result":"فله النَّارُ","explicit":true,"ref":"إرشاد الفقيه 2/390","srcLabel":"أبو داود","text":["مَن طلَب قضاءَ المُسلِمينَ حتَّى ينالَه ثمَّ غلَب عَدْلُه جَوْرَه، فله الجنَّةُ، ",["ومَن غلَب جَوْرُه عَدْلَه، ",1],["فله النَّارُ",2],"."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه أبو داود (3575)، والبيهقي (20660)","bab":"إيمان › الوعيد","dorar":"zfz5WSJK"},{"id":"س-04181","fp":"ffe348fc41a7","stateId":746,"easy":"إذا توليت عملاً وأنت تعلم أنك لست أهله ← فتبوأ مقعدك من النار","cause":"من تولى عملاً وهو يعلمُ أنَّه ليس لذلكَ العملِ أهلً","result":"فليتبوَّأْ مقعدَهُ من النَّارِ","explicit":true,"ref":"السلسلة الصحيحة 5/364","srcLabel":"الروياني","text":[["من تولى عملاً وهو يعلمُ أنَّه ليس لذلكَ العملِ أهلً ",1],["فليتبوَّأْ مقعدَهُ من النَّارِ",2],"."],"grade":"حسن","narrator":"أبو موسى الأشعري","muhaddith":"إسناده حسن","takhrij":"أخرجه الروياني في ((المسند)) (495)، وابن عساكر (26/ 57) واللفظ لهما.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"qco7Usdv"},{"id":"س-07845","fp":"893ac5cf2a11","stateId":746,"easy":"إذا استُرعيت رعية ← تُسأل يوم القيامة: أقمت فيها أمر الله أم أضعته","cause":"ما من راعٍ يُستَرعَى رعيةً","result":"إلا سُئِلَ يومَ القيامةِِ أقام فيها أمرَ اللهِ أم أضاعَه","explicit":true,"ref":"مجمع الزوائد 5/210","srcLabel":"الطبراني","text":[["ما من راعٍ يُستَرعَى رعيةً",1]," ",["إلا سُئِلَ يومَ القيامةِِ أقام فيها أمرَ اللهِ أم أضاعَه",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"فيه أبو عياش المصري وهو مستور ، وبقية رجاله ثقات وفي بعضهم كلام","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (4916) واللفظ له، وأبو سعيد النقاش في ((القضاة)) كما في ((كنز العمال)) للمتقي الهندي (6/33)","bab":"قيامة › الحساب والقصاص","dorar":"ZQohX70Q"},{"id":"س-08205","fp":"cab27eb58b55","stateId":746,"easy":"إذا حكمت بين الناس ← تُحبس يوم القيامة وملك آخذ بقفاك حتى يوقفك على جهنم","cause":"ما من حكَمٍ يحكمُ بينَ الناسِ","result":"إلا حُبِس يومَ القيامةِ وملَكٌ آخذٌ بقَفاه حتى يقِفَه على جهنمَ ثم يرفعَ رأسَه إلى اللهِ عزَّ وجلَّ فإن قال الخطأَ ألقاه في جهنمَ يهوي أربعينَ خريفًا","explicit":true,"repOf":"س-07437","ref":"تخريج المسند لشاكر 6/74","text":[["ما من حكَمٍ يحكمُ بينَ الناسِ",1]," ",["إلا حُبِس يومَ القيامةِ وملَكٌ آخذٌ بقَفاه حتى يقِفَه على جهنمَ ثم يرفعَ رأسَه إلى اللهِ عزَّ وجلَّ فإن قال الخطأَ ألقاه في جهنمَ يهوي أربعينَ خريفًا",2]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن ماجه (2311)، وأحمد (4097) واللفظ له","bab":"ملائكة › أعمال الملائكة","dorar":"JOkzpUsQ"},{"id":"س-02497","fp":"8147487cdc89","stateId":746,"easy":"إذا توليت الإمارة بغير حقها ← تكون عليك خزياً وندامة يوم القيامة","cause":"وإنَّها أمانةٌ","result":"وإنَّها يومَ القِيامةِ خِزيٌ وندامةٌ إلَّا مَن أخذَها بحقِّها، وأدَّى الذي عليه فيها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[44],"ref":"تخريج مشكل الآثار 57","srcLabel":"مسلم","text":["قُلْتُ: يا رسولَ اللهِ، ألَا تَستعمِلُني؟ قال: فضرَب بيَدِهِ على مَنْكِبِي، ثمَّ قال: يا أبا ذَرٍّ، إنَّكَ ضعيفٌ، ",["وإنَّها أمانةٌ",1],"، ",["وإنَّها يومَ القِيامةِ خِزيٌ وندامةٌ إلَّا مَن أخذَها بحقِّها، وأدَّى الذي عليه فيها",2],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (1825)، والطحاوي في ((شرح المشكل)) (57) كلاهما بلفظه، وأحمد (21513) باختلاف يسير.","bab":"إمامة وخلافة › تولية الولاة وغيرهم","dorar":"ui6GCbKd","merged":2,"otherRefs":["المستدرك على الصحيحين 7214 (صحيح)"]},{"id":"س-01667","fp":"2200c65ef3a9","stateId":746,"easy":"إذا كنت قاضياً جائراً ← فويل لك من ديّان السماء (أثر عمر)","cause":"لديَّانِ الأرضِ","result":"ويلٌ لديَّانِ الأرضِ مِن ديَّانِ السَّماءِ يومَ يلقونَهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"مختصر العلو 47","srcLabel":"أحمد","text":["قال عمر بن الخطاب: ",["ويلٌ لديَّانِ الأرضِ مِن ديَّانِ السَّماءِ يومَ يلقونَهُ",2]," ، إلَّا من أمَرَ بالعدلَ ، فقَضى بالحقِّ، ولم يَقضِ علَى هوًى، ولا علَى قرابةٍ، ولا علَى رَغبةٍ، ولا رَهَبٍ، وجعلَ كتابَ اللَّهِ مِرآةً بينَ عينيهِ، قالَ ابنُ غنيم: فحدِّثتُ بهذا عثمانَ ومعاويةَ، ويزيدَ، وعبدِ الملِكِ"],"grade":"صحيح","narrator":"عبدالرحمن بن غنم","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد في ((الزهد)) (663) واللفظ له، وابن أبي شيبة (23416)، وأبو نعيم في ((فضيلة العادلين)) (44) باختلاف يسير.","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"UnzzgZrD"},{"id":"س-01669","fp":"2da72db8d636","stateId":746,"easy":"إذا قضيت بين الناس ← تلقى شدة الحساب ولو كنت عادلاً","cause":"بالقاضي العادلِ","result":"فيَلقى مِن شدَّةِ الحسابِ ما يتمنَّى أنَّه لم يقضِ بيْنَ اثنينِ في عمرِه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"صحيح ابن حبان 5055","srcLabel":"أحمد","text":["يُدعى ",["بالقاضي العادلِ",1]," يومَ القيامةِ ",["فيَلقى مِن شدَّةِ الحسابِ ما يتمنَّى أنَّه لم يقضِ بيْنَ اثنينِ في عمرِه",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (24464)، والطبراني في ((المعجم الأوسط)) (2619)، والبيهقي (20717) باختلاف يسير","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"VtN0RuEP"},{"id":"س-08082","fp":"e881e5f993cf","stateId":746,"easy":"إذا عاقبت من تحت يدك فوق ذنوبهم ← يُقتص لهم منك الفضل","cause":"إنْْ كان عِقابُك إيَّاهُم فَوقَ ذُنُوبِهِمُ","result":"اقْتُصَّ لهمْ مِنكَ الفَضلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح الترغيب 3606","srcLabel":"الترمذي","text":["أنَّ رجلاً مِنْ أصْحابِ رسولهِ الله - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جلسَ بينَ يديْهِ، فقال: يا رسولَ الله! إنَّ لي مَمْلوكين يكذِّبونَني وَيخونونني وَيعْصونَني، وأضْرِبُهم وأشْتُمهمْ، فكيفَ أنا منهم؟ فقالَ له رسولُ الله - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: يُحسَبُ ما خانُوك وعَصَوكَ وكذَّبُوك وعِقابُك إيَّاهُم ، فإنْ كان عِقابُك إيَّاهُم دُونَ ذُنُوبِهمْ ؛ كان فَضْلًا لكَ ( عليهِم ) وإنْ كان عِقابُك إيَّاهم بقدرِ ذُنوبِهمْ ؛ كان كَفَافًا ولا لكَ ولا عليكَ ، و",["إنْْ كان عِقابُك إيَّاهُم فَوقَ ذُنُوبِهِمُ",1]," ",["اقْتُصَّ لهمْ مِنكَ الفَضلُ",2]," الذِي بَقِيَ قِبَلَكَ فجَعلَ الرجلُ يبْكِي بين يَدَيْ رسولِ اللهِ ويَهتِفُ فقال رسولُ اللهِ مالَكَ ؟ ما تَقرأُ كتابَ اللهِ \"ونَضَعُ الموازِين القِسطَ ليومِ القيامةِ فلا تظلمُ نفسٌ شيئًا وإن كان مثقالَ حبةٍ من خردلِ أتينا بها وكفى بنا حاسِبين\" ؟ فقال الرجلُ يا رسولَ الله ! ما أجِدُ شيئًا خيرًا من فِراقِ هؤلاءِ – يعني عَبِيدَهُ ( إنِّي ) أُشْهِدُكَ أنَّهم كلَّهم أحْرَارٌ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3165)، وأحمد (26401) باختلاف يسير","bab":"مظالم › قصاص المظالم","dorar":"C83DM1UR"},{"id":"س-02984","fp":"b7382effc52b","stateId":746,"easy":"إذا كنت أميراً أو أميناً أو عريفاً ← فويل لك إن لم تعدل","cause":"لأُمَراءِ، وَيْلٌ للأُمَناءِ، وَيْلٌ للعُرَفاءِ، لَيَتَمَنَّيْنَ أقْوامٌ يَوْمَ القِيامةِ أنَّ ذَوائِبَهم كانَتْ مُعَلَّقةً بالثُّرَيَّا، يَتَذَبْذَبونَ بَيْنَ السَّماءِ والأرْضِ، وأنَّهم لم يَلُوا عَمَلًا","result":"وَيْلٌ ل","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[57],"ref":"الأحكام الوسطى 2/363","srcLabel":"أبو داود","text":[["وَيْلٌ ل",2],["لأُمَراءِ، وَيْلٌ للأُمَناءِ، وَيْلٌ للعُرَفاءِ، لَيَتَمَنَّيْنَ أقْوامٌ يَوْمَ القِيامةِ أنَّ ذَوائِبَهم كانَتْ مُعَلَّقةً بالثُّرَيَّا، يَتَذَبْذَبونَ بَيْنَ السَّماءِ والأرْضِ، وأنَّهم لم يَلُوا عَمَلًا",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود الطيالسي (2646) بلفظه، وأحمد (8627)، وأبو يعلى في ((المسند)) (6217) بلفظه.","bab":"إيمان › الوعيد","dorar":"W4a4fkhj","merged":5,"otherRefs":["هداية الرواة 3/465 (حسن)","تخريج صحيح ابن حبان 4483 (صحيح)","المستدرك على الصحيحين 7211 (صحيح)","الجامع الصغير 7530 (صحيح)"]},{"id":"س-04822","fp":"beec8b280597","stateId":746,"easy":"إذا توليت الإمارة ← أولها ملامة وثانيها ندامة وثالثها عذاب يوم القيامة إلا من عدل","cause":"الإمارةِ","result":"أوَّلُها ملامةٌ ، وثانيها ندامةٌ , وثالثُها عذابٌ يومَ القيامةِ ، إلَّا من عدَل","explicit":true,"otherNeedIds":[44,57],"ref":"الأحكام الشرعية الصغرى 484","srcLabel":"الطبراني","text":["إن شئتم أنبأتُكم عن ",["الإمارةِ",1]," وما هي . فقمتُ فناديتُ بأعلَى صوتي ثلاثَ مرَّاتٍ ، وما هي يا رسولَ اللهِ ؟ قال : ",["أوَّلُها ملامةٌ ، وثانيها ندامةٌ , وثالثُها عذابٌ يومَ القيامةِ ، إلَّا من عدَل",2]," ، وكيف يعدِلُ مع أقربيه"],"grade":"صحيح","narrator":"عوف بن مالك الأشجعي","muhaddith":"[أشار في المقدمة أنه صحيح الإسناد]","takhrij":"أخرجه البزار (2756)، والطبراني في ((مسند الشاميين)) (2006)، واللفظ لهما، وابن أبي عاصم في (الآحاد والمثاني) (1284) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"N7kiV7N4","merged":3,"otherRefs":["صحيح الترغيب 2174 (صحيح)","السلسلة الصحيحة 1562 (صحيح)"]},{"id":"ق-1426","fp":"e8aaaa088dff","stateId":747,"easy":"فتنة المؤمنين والمؤمنات بلا توبة ← عذاب جهنم وعذاب الحريق","cause":"فتنة المؤمنين والمؤمنات بلا توبة","result":"عذاب جهنم وعذاب الحريق","explicit":true,"ref":"سورة البروج: 10","srcLabel":"القرآن الكريم","quran":{"s":85,"from":10,"to":10,"text":"إِنَّ الَّذِينَ فَتَنُوا الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ ثُمَّ لَمْ يَتُوبُوا فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ الْحَرِيقِ (10)","hl":[[0,132,1]]}},{"id":"س-08033","fp":"44ac5cdf7cc6","stateId":747,"easy":"إذا أخذت شبراً من الأرض ظلماً ← تُطوّقه إلى سبع أرضين","cause":"مَن أخَذَ شِبرًا مِنَ الأرضِ ظُلمًا","result":"طُوِّقَه إلى سَبعِ أرَضينَ","explicit":true,"star":true,"similar":["س-08000","س-08034","س-08039","س-05132","س-08050"],"otherNeedIds":[52],"ref":"صحيح مسلم 1610","srcLabel":"البخاري","text":["أنَّ أروى بنتَ أويسٍ ادَّعَت على سَعيدِ بنِ زَيدٍ أنَّه أخَذَ شيئًا مِن أرضِها، فخاصَمَتْه إلى مَروانَ بنِ الحَكَمِ، فقال سَعيدٌ: أنا كُنتُ آخُذُ مِن أرضِها شيئًا بَعدَ الذي سَمِعتُ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم! قال: وما سَمِعتَ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم؟ قال: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["مَن أخَذَ شِبرًا مِنَ الأرضِ ظُلمًا ",1],["طُوِّقَه إلى سَبعِ أرَضينَ",2],"، فقال له مَروانُ: لا أسألُكَ بَيِّنةً بَعدَ هذا. فقال: اللَّهُمَّ إن كانَت كاذِبةً فعَمِّ بَصَرَها، واقتُلْها في أرضِها. قال: فما ماتَت حتَّى ذَهَبَ بَصَرُها، ثُمَّ بينا هي تَمشي في أرضِها إذ وقَعَت في حُفرةٍ فماتَت."],"grade":"صحيح","narrator":"عروة بن الزبير","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3198) وأحمد (1640) بنحوه والدارمي (2648) مختصرا.","bab":"مظالم › تحريم الظلم","dorar":"71gAeqmi","merged":16,"otherRefs":["تخريج المسند لشعيب 9582 (صحيح)","صحيح البخاري 3195 (صحيح)","الترغيب والترهيب 3/72 (صحيح)","تخريج المسند لشعيب 1639 (صحيح)","تخريج مشكل الآثار 6146 (صحيح)","تخريج المسند لشاكر 3/117 (صحيح)","المصابيح في الأحاديث المتواترة 618 (صحيح)","المصابيح في الأحاديث المتواترة 615 (صحيح)","تخريج صحيح ابن حبان 3195 (صحيح)","تخريج مشكل الآثار 6145 (صحيح)","المستدرك على الصحيحين 8017 (صحيح)","صحيح مسلم 1612 (صحيح)","تخريج المسند لشعيب 26224 (صحيح)","تخريج شرح السنة 2564 (صحيح)","المصابيح في الأحاديث المتواترة 624 (صحيح)"]},{"id":"س-07863","fp":"09b905ef6cad","stateId":747,"easy":"إذا كان لأحد عندك مظلمة ← لا تدخل الجنة حتى يُقتص منك","cause":"لا يَنْبغي لِأحدٍ مِن أهلِ الجنَّةِ أنْ يَدخُلَ الجنَّةَ، ولأحدٍ مِن أهلِ النَّارِ عليه مَظْلَمةٌ","result":"حتَّى أقُصَّه منه، ولا يَنْبغي لأحدٍ مِن أهلِ النَّارِ أنْ يَدخُلَ النَّارَ، ولأحدٍ مِن أهلِ الجنَّةِ مَظْلَمةٌ حتَّى أقْضِهِ منه حتَّى اللَّطمةِ","explicit":true,"star":true,"otherNeedIds":[52,13,71],"ref":"المستدرك على الصحيحين 8941","srcLabel":"البخاري","text":["عن جابرِ بنِ عبدِ اللهِ رَضيَ اللهُ عنهُما، قال: بَلَغني عن رجُلٍ مِن أصحابِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ حَديثٌ سَمِعه مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في القِصاصِ لم أسْمَعْه منه، فابتَعْتُ بَعيرًا، فشَدَدتُ رَحْلي، ثمَّ سِرتُ إليه شَهرًا حتَّى قَدِمتُ مِصرَ -أو قال: الشَّامَ- فأتَيتُ عبدَ اللهِ بنَ أُنَيسٍ، فقُلتُ: حَديثٌ بَلَغَني عنكَ تُحدِّثُ به سَمِعتَه مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ ولم أسْمَعْه في القِصاصِ، خَشِيتُ أنْ أموتُ قبْلَ أنْ أسْمَعَه، فقال عبدُ اللهِ: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: يوْمَ يُحشَرُ العِبادُ -أو قال: النَّاسُ- عُراةً غُرْلًا بُهْمًا، ليْس معهم شَيءٌ، ثمَّ يُنادِيهم بصَوتٍ يَسمَعُه مَن بعُدَ كما يَسمَعُه مَن قرُبَ: أنا الملِكُ، أنا الدَّيَّانُ، ",["لا يَنْبغي لِأحدٍ مِن أهلِ الجنَّةِ أنْ يَدخُلَ الجنَّةَ، ولأحدٍ مِن أهلِ النَّارِ عليه مَظْلَمةٌ",1]," ",["حتَّى أقُصَّه منه، ولا يَنْبغي لأحدٍ مِن أهلِ النَّارِ أنْ يَدخُلَ النَّارَ، ولأحدٍ مِن أهلِ الجنَّةِ مَظْلَمةٌ حتَّى أقْضِهِ منه حتَّى اللَّطمةِ",2],"، قال: قُلنا: كيْف وإنَّما نَأتي اللهَ عزَّ وجلَّ عُراةً حُفاةً غُرْلًا بُهْمًا؟ قال: الحسناتُ والسَّيِّئاتُ."],"grade":"صحيح","narrator":"عبدالله بن أنيس","muhaddith":"صحيح الإسناد ولم يخرجاه","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (970) باختلاف يسير، وابن أبي شيبة في ((مسنده)) (851)، وابن أبي عاصم  ((السنة)) (514) مختصرا","bab":"قيامة › الحساب والقصاص","dorar":"bA2b6ggn","merged":5,"otherRefs":["الزواجر عن اقتراف الكبائر 2/243 (صحيح)","تخريج كتاب السنة 514 (صحيح)","حديث جابر لابن ناصر الدين 34 (حسن)","تخريج العواصم والقواصم 3/ 222 (حسن)"]},{"id":"س-07978","fp":"073bfc95ffdd","stateId":747,"easy":"إذا كانت عندك مظلمة لأخيك ← تحلّلها اليوم وإلا أُخذ من حسناتك","cause":"مَن كانَتْ عِندَه مَظلَمةٌ مِن أخيهِ، مِن عِرضِهِ أو مالِهِ، فليتحَلَّلْهُ اليَومَ قَبلَ أنْ يُؤخَذَ حينَ لا يَكونُ دينارٌ ولا دِرهمٌ","result":"كان له عَمَلٌ صالِحٌ؛ أُخِذَ منه بقَدْرِ مَظلَمَتِهِ، وإنْ لم يَكُنْ له؛ أُخِذَ مِن سَيِّئاتِ صاحِبِهِ فجُعِلتْ عليه","explicit":true,"similar":["س-07977","س-07979","س-07983"],"ref":"تخريج المسند لشعيب 10573","srcLabel":"البخاري","text":[["مَن كانَتْ عِندَه مَظلَمةٌ مِن أخيهِ، مِن عِرضِهِ أو مالِهِ، فليتحَلَّلْهُ اليَومَ قَبلَ أنْ يُؤخَذَ حينَ لا يَكونُ دينارٌ ولا دِرهمٌ",1],"، وإنْ ",["كان له عَمَلٌ صالِحٌ؛ أُخِذَ منه بقَدْرِ مَظلَمَتِهِ، وإنْ لم يَكُنْ له؛ أُخِذَ مِن سَيِّئاتِ صاحِبِهِ فجُعِلتْ عليه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6534)، وأحمد (10573) واللفظ له","bab":"مظالم › التخلص من الظلم","dorar":"Lp0CJmgh","merged":2,"otherRefs":["صحيح الجامع 6511 (صحيح)"]},{"id":"س-08040","fp":"0ebb7d487186","stateId":747,"easy":"إذا ظلمت ← يكون ظلمك ظلمات عليك يوم القيامة","cause":"اتَّقُوا الظُّلمَ","result":"فإنَّ الظُّلمَ ظُلُماتٌ يومَ القيامةِ","explicit":true,"similar":["س-08008"],"otherNeedIds":[13],"ref":"صحيح الأدب المفرد 373","srcLabel":"مسلم","text":[["اتَّقُوا الظُّلمَ ؛ ",1],["فإنَّ الظُّلمَ ظُلُماتٌ يومَ القيامةِ",2]," ، واتَّقُوا الشُّحَّ ؛ فإنَّ الشُّحَّ أهلكَ مَن كانَ قبلَكُم ، حملَهُم على أنْ سَفكُوا دِمائَهم ، واستَحَلُّوا مَحارِمَهم"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2578)","bab":"مظالم › تحريم الظلم","dorar":"OUCammRa","merged":3,"otherRefs":["تخريج المسند لشعيب 5662 (صحيح)","تخريج المسند لشعيب 6206 (صحيح)"]},{"id":"س-04787","fp":"16026a926ec8","stateId":747,"easy":"إذا أعطيت بالله ثم غدرت أو بعت حراً أو استأجرت أجيراً فلم تعطه ← فالله خصمك يوم القيامة","cause":"رَجُلٌ أعطى بي ثُمَّ غَدَرَ، ورَجُلٌ باعَ حُرًّا وأكَلَ ثَمَنَه، ورَجُلٌ استَأجَرَ أجيرًا فاستَوفى مِنه ولَم يوفِّه أجرَه","result":"ثَلاثةٌ أنا خَصمُهم يَومَ القيامةِ","explicit":true,"otherNeedIds":[28],"ref":"مجموع الشروح الفقهية. 255/10","srcLabel":"البخاري","text":["يَقولُ اللهُ عَزَّ وجلَّ: ",["ثَلاثةٌ أنا خَصمُهم يَومَ القيامةِ",2],"، ومَن كُنتُ خَصمَه خَصَمتُه: ",["رَجُلٌ أعطى بي ثُمَّ غَدَرَ، ورَجُلٌ باعَ حُرًّا وأكَلَ ثَمَنَه، ورَجُلٌ استَأجَرَ أجيرًا فاستَوفى مِنه ولَم يوفِّه أجرَه",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (2270)، وأحمد (8692)، وابن الجارود (630)، والطحاوي في ((شرح مشكل الآثار)) (1878) بلفظه.","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"uy1Jvrs8"},{"id":"س-07509","fp":"96a2b60e45e7","stateId":747,"easy":"إذا ظلمت أهل الجنة في الدنيا ← تُحبس عن الجنة حتى يُقتص منك","cause":"مَظالِمُهم الَّتي تَظالَموها في الدُّنيا","result":"لَيُحبَسُ أهلُ الجنَّةِ بعْدما يُجاوِزون الصِّراطَ على قَنطرةٍ","explicit":true,"ref":"المستدرك على الصحيحين 8932","srcLabel":"البخاري","text":[["لَيُحبَسُ أهلُ الجنَّةِ بعْدما يُجاوِزون الصِّراطَ على قَنطرةٍ",2],"، فيُؤخَذُ لبَعضِهم مِن بَعضٍ ",["مَظالِمُهم الَّتي تَظالَموها في الدُّنيا",1],"، حتَّى إذا هُذِّبوا ونُقِّوا أُذِن في دُخولِ الجنَّةِ، فلَأحَدُهم أعرَفُ بمَنزلتِهم في الآخرةِ منه بمَنزلِه كان في الدُّنيا. قال قَتادةُ: قال أبو عُبَيدةَ بنُ عبدِ اللهِ بنِ مَسعودٍ: ما يُشبِهُ إلَّا أهلَ جُمْعةٍ انْصَرَفوا مِن جُمعتِهم."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح الإسناد ولم يخرجاه","takhrij":"أخرجه البخاري (2440)، وأحمد (11095)، والطبراني في ((المعجم الأوسط)) (2749) مطولا، وجميعا بنحوه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"8YHPrnJO"},{"id":"س-07977","fp":"bae6721127f5","stateId":747,"easy":"إذا كانت لأخيك عندك مظلمة في عرض أو مال ← فاستحلّه اليوم قبل يوم لا دينار فيه ولا درهم","cause":"مَن كانت عندَه مَظلَمةٌ لأخيه مِن عِرضِه ومالِه","result":"فلْيستحِلَّه اليومَ قبْلَ أنْ يأخُذَه به حينَ لا دينارَ ولا درهمَ فإنْ كان له عمَلٌ صالحٌ أُخِذ منه بقدرِ مَظلَمتِه فإنْ لَمْ يكُنْ أُخِذ مِن سيِّئاتِ صاحبِه فجُعِلَتْ عليه","explicit":true,"repOf":"س-07978","ref":"تخريج صحيح ابن حبان 7361","text":[["مَن كانت عندَه مَظلَمةٌ لأخيه مِن عِرضِه ومالِه ",1],["فلْيستحِلَّه اليومَ قبْلَ أنْ يأخُذَه به حينَ لا دينارَ ولا درهمَ فإنْ كان له عمَلٌ صالحٌ أُخِذ منه بقدرِ مَظلَمتِه فإنْ لَمْ يكُنْ أُخِذ مِن سيِّئاتِ صاحبِه فجُعِلَتْ عليه",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الترمذي (2419)، وأحمد (9615) باختلاف يسير، وأخرجه البخاري (6534) بلفظ مقارب","bab":"مظالم › التخلص من الظلم","dorar":"aqJNxCOB"},{"id":"س-07979","fp":"fb3a073bc24d","stateId":747,"easy":"إذا كانت عندك مظلمة لأخيك ← فاستحلّه منها قبل أن يُؤخذ من حسناتك","cause":"مَن كانت عندَهُ مَظلِمَةٌ لأخيهِ في عِرضٍ، أو في مالٍ، فلْيأتِهِ فلْيُحَلِّلْهُ منها","result":"فإنَّه ليْسَ ثَمَّ دِينارٌ ولا دِرهمٌ، مِن قَبلِ أنْ يُؤخَذَ لأخيهِ من حسناتِهِ، فإنْ لمْ يكُنْ له حسناتٌ أُخِذَ من سيِّئاتِ أخيهِ فطُرِحَتْ عليه","explicit":true,"repOf":"س-07978","ref":"تخريج مشكل الآثار 189","text":[["مَن كانت عندَهُ مَظلِمَةٌ لأخيهِ في عِرضٍ، أو في مالٍ، فلْيأتِهِ فلْيُحَلِّلْهُ منها، ",1],["فإنَّه ليْسَ ثَمَّ دِينارٌ ولا دِرهمٌ، مِن قَبلِ أنْ يُؤخَذَ لأخيهِ من حسناتِهِ، فإنْ لمْ يكُنْ له حسناتٌ أُخِذَ من سيِّئاتِ أخيهِ فطُرِحَتْ عليه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الترمذي (2419)، وأحمد (9615) باختلاف يسير، وأخرجه البخاري (6534) بلفظ مقارب","bab":"مظالم › التخلص من الظلم","dorar":"KMNgu1wW"},{"id":"س-07982","fp":"3945638e1b7c","stateId":747,"easy":"إذا كانت عندك مظلمة لأخيك في عرض أو مال ← يُؤخذ من عملك الصالح بقدرها، فإن لم يكن حُمل عليك من سيئاته","cause":"كانتْ لهُ عندَ أخيه مظلمةٌ في عرضٍ أو مالٍ","result":"كان لهُ عملٌ صالحٌ ؛ أُخذَ منه بقدرِ مَظلمتِه ، وإن لَم تكن لهُ حسَناتٌ ؛ أُخذِ من سيِّئاتِ صاحِبِه فحُملَ علَيهِ","explicit":true,"ref":"صحيح الترغيب 2222","srcLabel":"البخاري","text":["رحَمَ اللهُ عبدًا ",["كانتْ لهُ عندَ أخيه مظلمةٌ في عرضٍ أو مالٍ",1]," فلْيتحلَّلْه منه اليومَ ، من قبلِ أن لا يكونَ دينارٌ ولا درهمٌ ، إن ",["كان لهُ عملٌ صالحٌ ؛ أُخذَ منه بقدرِ مَظلمتِه ، وإن لَم تكن لهُ حسَناتٌ ؛ أُخذِ من سيِّئاتِ صاحِبِه فحُملَ علَيهِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (2419)، وأحمد (9613) باختلاف يسير، وأخرجه البخاري (2449) بنحوه","bab":"مظالم › التوبة ورد المظالم والحقوق","dorar":"BHtDLUT8"},{"id":"س-08000","fp":"10301b78b87c","stateId":747,"easy":"إذا ظلمت شبراً من الأرض ← تُطوّقه يوم القيامة","cause":"من ظلَمَ شِبرًا منَ الأرضِ","result":"خنقَ بهِ يومَ القيامَةِ","explicit":true,"repOf":"س-08033","ref":"حلية الأولياء 8/182","text":[["من ظلَمَ شِبرًا منَ الأرضِ ",1],["خنقَ بهِ يومَ القيامَةِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح من حديث موسى عن سالم تفرد به عبد الله عنه","takhrij":"أخرجه أبو عوانة في ((المستخرج)) (5966)، والخرائطي في ((مساويء الأخلاق)) (634) بنحوه، والبخاري (2454) بمعناه.","bab":"مظالم › تحريم الظلم","dorar":"mhrPBHaP"},{"id":"س-08034","fp":"bcfbf299ec41","stateId":747,"easy":"إذا أخذت شبراً من الأرض بغير حقه ← تُطوّقه في سبع أرضين يوم القيامة","cause":"مَن أخَذَ شِبرًا مِنَ الأرضِ بغيرِ حَقِّه","result":"طُوِّقَه في سَبعِ أرَضينَ يَومَ القيامةِ، اللَّهُمَّ إن كانَت كاذِبةً فأعمِ بَصَرَها، واجعَلْ قَبرَها في دارِها","explicit":true,"repOf":"س-08033","ref":"صحيح مسلم 1610","text":["أنَّ أروى خاصَمَتْه في بَعضِ دارِه، فقال: دَعوها وإيَّاها؛ فإنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["مَن أخَذَ شِبرًا مِنَ الأرضِ بغيرِ حَقِّه، ",1],["طُوِّقَه في سَبعِ أرَضينَ يَومَ القيامةِ، اللَّهُمَّ إن كانَت كاذِبةً فأعمِ بَصَرَها، واجعَلْ قَبرَها في دارِها",2],". قال: فرَأيتُها عَمياءَ تَلتَمِسُ الجُدُرَ تَقولُ: أصابَتني دَعوةُ سَعيدِ بنِ زَيدٍ، فبينَما هي تَمشي في الدَّارِ مَرَّت على بئرٍ في الدَّارِ، فوقَعَت فيها، فكانَت قَبرَها."],"grade":"صحيح","narrator":"سعيد بن زيد","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3198)","bab":"مظالم › تحريم الظلم","dorar":"XNJMNK6Y"},{"id":"س-04937","fp":"52c31dfcce13","stateId":747,"easy":"إذا خلفت مجاهداً في أهله فخنته ← توقف له يوم القيامة فيأخذ من حسناتك ما شاء","cause":"وما من قاعِدٍ يَخلُفُ مُجاهِدًا في أهْلِه، فيَخونُه في أهْلِه","result":"إلَّا وُقِّفَ له يَومَ القيامةِ، قيلَ له: إنَّ هذا خانَك في أهْلِكَ، فخُذْ مِن عَمَلِه ما شِئتَ","explicit":true,"similar":["س-07867","س-07846"],"otherNeedIds":[52],"ref":"تخريج المسند لشعيب 23004","srcLabel":"مسلم","text":["فضْلُ نِساءِ المُجاهِدينَ على القاعِدينَ في الحُرْمةِ كفَضْلِ أُمَّهاتِهم، ",["وما من قاعِدٍ يَخلُفُ مُجاهِدًا في أهْلِه، فيَخونُه في أهْلِه",1],"؛ ",["إلَّا وُقِّفَ له يَومَ القيامةِ، قيلَ له: إنَّ هذا خانَك في أهْلِكَ، فخُذْ مِن عَمَلِه ما شِئتَ",2],". قال: فما ظَنُّكم؟"],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1897)، وأبو داود (2496)، والنسائي (3190)، وأحمد (23004) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"2AXelzf6"},{"id":"س-07867","fp":"fbfc5fca7a0b","stateId":747,"easy":"إذا خلفت مجاهداً في أهله بسوء ← يُنصب لك يوم القيامة فيأخذ من حسناتك","cause":"وما من رَجُلٍ مِنَ القاعدينَ يخلفُ رجلًا منَ المجاهدينَ في أهلِهِ","result":"إلَّا نصبَ لهُ يومَ القيامةِ فيقالُ يا فلانُ هذا فلانٌ فخُذْ من حسناتِهِ ما شئتَ","explicit":true,"repOf":"س-04937","otherNeedIds":[52],"ref":"صحيح النسائي 3191","text":["حُرمةُ نساءِ المجاهدينَ على القاعدينَ في الحرمةِ كأمَّهاتِهم ",["وما من رَجُلٍ مِنَ القاعدينَ يخلفُ رجلًا منَ المجاهدينَ في أهلِهِ",1]," ",["إلَّا نصبَ لهُ يومَ القيامةِ فيقالُ يا فلانُ هذا فلانٌ فخُذْ من حسناتِهِ ما شئتَ",2]," ثمَّ التفتَ النَّبيُّ إلى أصحابِهِ فقالَ ما ظنُّكم تَرونَ يدعُ لهُ مِن حسناتِهِ شيئًا"],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"صحيح","takhrij":"أخرجه النسائي (3191) واللفظ له، ومسلم (1897)، وأبو داود (2496) باختلاف يسير.","bab":"قيامة › الحساب والقصاص","dorar":"G5R6rkty"},{"id":"س-07976","fp":"3e13531d8c95","stateId":747,"easy":"إذا كان عليك حق ← لتؤدينه يوم القيامة حتى يُقاد للشاة الجلحاء من القرناء","cause":"الحُقوقَ","result":"لتؤدُّنَّ الحُقوقَ إلى أَهلِها ، حتَّى يقادَ الشَّاةُ الجلحاءُ منَ الشَّاةِ القرناءِ","explicit":true,"ref":"صحيح الترمذي 2420","srcLabel":"مسلم","text":[["لتؤدُّنَّ الحُقوقَ إلى أَهلِها ، حتَّى يقادَ الشَّاةُ الجلحاءُ منَ الشَّاةِ القرناءِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2582)","bab":"مظالم › التخلص من الظلم","dorar":"GuNDY5Vb"},{"id":"س-05379","fp":"2d5a4f2a1685","stateId":747,"easy":"إذا عذبت الناس في الدنيا (ظلماً) ← يعذبك الله","cause":"يُعَذِّبونَ النَّاسَ في الدُّنيا","result":"إنَّ اللهَ يُعَذِّبُ الذينَ","explicit":true,"ref":"صحيح مسلم 2613","srcLabel":"أبو داود","text":["مَرَّ هِشامُ بنُ حَكيمِ بنِ حِزامٍ على أُناسٍ مِنَ الأنباطِ بالشَّامِ، قد أُقيموا في الشَّمسِ، فقال: ما شَأنُهم؟ قالوا: حُبِسوا في الجِزيةِ، فقال هِشامٌ: أشهَدُ لَسَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["إنَّ اللهَ يُعَذِّبُ الذينَ",2],[" يُعَذِّبونَ النَّاسَ في الدُّنيا",1],". [وفي روايةٍ]: وأميرُهم يَومَئذٍ عُمَيرُ بنُ سَعدٍ على فِلَسطينَ، فدَخَلَ عليه فحَدَّثَه، فأمَرَ بهم فخُلُّوا."],"grade":"صحيح","narrator":"هشام بن حكيم بن حزام","muhaddith":"[صحيح]","takhrij":"أخرجه أبو داود (3045)، والنسائي في ((الكبرى)) (8718)، وأحمد (15336) باختلاف يسير","bab":"رقائق وزهد › الجزاء من جنس العمل","dorar":"mVg4f3Ho","merged":6,"otherRefs":["صحيح مسلم 2613 (صحيح)","صحيح ابن حبان 5613 (صحيح)","فيض القدير 2/ 304 (صحيح)","صحيح أبي داود 3045 (صحيح)","صحيح ابن حبان 5612 (صحيح)"]},{"id":"س-08008","fp":"133487bbf346","stateId":747,"easy":"إذا ظلمت ← يكون ظلمك ظلمات عليك يوم القيامة","cause":"إيَّاكُمْ والظُّلْمَ","result":"فَإنَّ الظُّلْمَ ظُلُماتٌ يومَ القيامَةِ","explicit":true,"repOf":"س-08040","otherNeedIds":[13],"ref":"المستدرك على الصحيحين 26","text":["قالَ: خَطَبَنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: «",["إيَّاكُمْ والظُّلْمَ؛ ",1],["فَإنَّ الظُّلْمَ ظُلُماتٌ يومَ القيامَةِ",2],"، وَإيَّاكُمْ والفُحْشَ والتَّفَحُّشَ، وإيَّاكُمْ والشُّحَّ؛ فإنَّما هَلَكَ مَنْ كان قَبْلَكُمْ بِالشُّحِّ، أَمَرَهُمْ بالقَطيعَةِ فقَطَعوا، والبُخْلَ فَبَخِلوا، وبالفُجورِ فَفَجَروا». فقامَ رَجُلٌ فقالَ: يا رسولَ اللهِ، أيُّ الإسْلامِ أفْضَلُ؟ قالَ: «أنْ يَسْلَمَ المسْلِمونَ مِنْ لِسانِكَ ويَدِكَ». فقالَ ذلك الرَّجلُ أو غَيرُهُ: يا رسولَ اللهِ، أيُّ الهِجْرةِ أَفْضَلُ؟ قالَ: «أنْ تَهْجُرَ ما كَرِهَ رَبُّكَ». قالَ: «والهِجْرَةُ هِجْرَتانِ: هِجْرَةُ الحاضِرِ، وهِجْرَةُ البادي؛ فَهِجْرَةُ البادي: أنْ يُجيبَ إذا دُعِيَ، ويُطيعَ إذا أُمِرَ، وهِجْرَةُ الحاضِرِ أَعْظَمُهُما بَلِيَّةً وأَفْضَلُهُما أَجْرًا»."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[صحيح سليم من رواية المجروحين]","takhrij":"أخرجه ابن حبان (5176) بلفظه، وأحمد (6837)، الدارمي (2558) كلاهما ببعض لفظه.","bab":"مظالم › تحريم الظلم","dorar":"2XPZM3DI","merged":5,"otherRefs":["تخريج المسند لشعيب 9569 (صحيح)","فوائد الحنائي الحنائيات 2/1197 (حسن)","صحيح الترغيب 2217 (صحيح)","تخريج المسند لشاكر 11/71 (صحيح)"]},{"id":"س-05253","fp":"a82e8c70a5a4","stateId":747,"easy":"إذا كنت أشد الناس تعذيباً للناس في الدنيا ← تكون أشد الناس عذاباً يوم القيامة","cause":"أشدُّ النَّاسِ عَذابًا للنَّاسِ في الدُّنْيا","result":"أشَدَّ النَّاسِ عَذابًا يومَ القيامةِ","explicit":true,"ref":"المستدرك على الصحيحين 5359","srcLabel":"أحمد","text":["أنَّ عِياضَ بنَ غَنْمٍ الأشْعَريَّ وقَعَ على صاحِبِ دارٍ حينَ فُتِحَتْ، فأتاهُ هِشامُ بنُ حَكيمٍ، فأغلَظَ له القَولَ، ومكَثَ هِشامٌ لَياليَ، فأتاهُ هِشامٌ مُعتَذِرًا، فقالَ له هِشامٌ: ألم تَعلَمْ أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، قالَ: إنَّ ",["أشَدَّ النَّاسِ عَذابًا يومَ القيامةِ",2]," ",["أشدُّ النَّاسِ عَذابًا للنَّاسِ في الدُّنْيا",1],"؟! فقالَ له عِياضٌ: يا هِشامُ، إنَّا قد سَمِعْنا الَّذي قد سمِعْتَ، ورَأيْنا الَّذي قد رَأيْتَ، وصَحِبْنا مَن صحِبْتَ، ألم تَسمَعْ يا هِشامُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: مَن كانتْ عندَه نَصيحةٌ لذي سُلْطانٍ فلا يُكلِّمْه بها عَلانيَةً، ولْيأخُذْ بيَدِه، ولْيَخلُ به؛ فإنْ قَبِلَها قَبِلَها، وإلَّا كانَ قد أدَّى الَّذي عليه؟! وإنَّكَ يا هِشامُ، لأنتَ المُجتَرئُ، أنْ تَجتَرئَ على سُلطانِ اللهِ، فهلَّا خَشِيتَ أنْ يَقتُلَكَ سُلطانُ اللهِ، فتَكونَ قَتيلَ سُلطانِ اللهِ."],"grade":"صحيح","narrator":"عياض بن غنم الأشعري وهشام بن حكيم","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (15333)، والطبراني (17/ 367) (1007)، والبيهقي (16738) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"4oG4GL9F","merged":3,"otherRefs":["الجامع الصغير 1043 (صحيح)","إتحاف الخيرة المهرة 8/175 (حسن)"]},{"id":"س-02975","fp":"ddf1f0c4e30c","stateId":747,"easy":"إذا فرقت بين والدة وولدها ← يفرق الله بينك وبين أحبتك يوم القيامة","cause":"مَن فرَّق بين والدةٍ وولَدِها","result":"فرَّق اللهُ بينه وبين أحِبَّتِهِ يومَ القيامةِ","explicit":true,"ref":"تخريج زاد المعاد 3/104","srcLabel":"الترمذي","text":["وكان صلَّى اللهُ عليه وسلَّمَ يَمنَعُ التفريقَ في السَّبْيِ بين الوالدةِ وولَدِها، ويقولُ: ",["مَن فرَّق بين والدةٍ وولَدِها، ",1],["فرَّق اللهُ بينه وبين أحِبَّتِهِ يومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1283)، وأحمد (23513)، والدارمي (2522) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"ZetTVFTN","merged":2,"otherRefs":["صحيح الجامع 6412 (صحيح)"]},{"id":"س-07983","fp":"241c8176dc54","stateId":747,"easy":"إذا كانت عندك مظلمة لأخيك في دم أو مال ← فتحلّله قبل يوم ليس فيه درهم ولا دينار إلا الحسنات والسيئات","cause":"من كانت عندَهُ مظلِمةٌ لأخيهِ في دمٍ أو مالٍ","result":"قبلِ أن يأتي يوم ليسَ فيهِ درْهمٌ ولا دينارٌ, إلا الحسناتِ والسيِّئاتِ فإن كانت لَهُ حسناتٌ أُخِذَ من حسناتِهِ بقدرِ مظلِمتهِ , وإلَّا أخذَ من سيِّئاتِ صاحبِهِ فطُرِحت عليهِ ثمَّ طُرِحَ في النَّارِ","explicit":true,"repOf":"س-07978","ref":"الفتح الرباني 11/5531","text":[["من كانت عندَهُ مظلِمةٌ لأخيهِ في دمٍ أو مالٍ",1]," , فليتحلَّلْها منْه ",["قبلِ أن يأتي يوم ليسَ فيهِ درْهمٌ ولا دينارٌ, إلا الحسناتِ والسيِّئاتِ فإن كانت لَهُ حسناتٌ أُخِذَ من حسناتِهِ بقدرِ مظلِمتهِ , وإلَّا أخذَ من سيِّئاتِ صاحبِهِ فطُرِحت عليهِ ثمَّ طُرِحَ في النَّارِ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"مظالم › التوبة ورد المظالم والحقوق","dorar":"3yP2vz2n","merged":2,"otherRefs":["الفتاوى الكبرى 1/113 (صحيح)"]},{"id":"س-07988","fp":"d48e4538e36c","stateId":747,"easy":"إذا ظلم العباد بعضهم بعضاً ← فالقصاص يوم القيامة لا محالة","cause":"فظلمُ العبادِ بعضِهِم بعضًا","result":"القصاصُ لا محالةَ","explicit":true,"otherNeedIds":[13],"ref":"عمدة التفسير 1/520","srcLabel":"أحمد","text":["الدَّواوينُ عندَ اللَّهِ ثلاثةٌ ؛ ديوانٌ لا يعبأُ اللَّهُ بِهِ شيئًا ، وديوانٌ لا يترُكُ اللَّهُ منهُ شيئًا ، وديوانٌ لا يغفرُهُ اللَّهُ . فأمَّا الدِّيوانُ الَّذي لا يغفرُهُ اللَّهُ ، فالشِّركُ باللَّهِ ، قالَ اللَّهُ عزَّ وجلَّ :  مَنْ يُشْرِكْ بِاللَّهِ فَقَدْ حَرَّمَ اللَّهُ عَلَيْهِ الْجَنَّةَ  المائدةِ :72 وأمَّا الدِّيوانُ الَّذي لا يعبأُ اللَّهُ بِهِ شيئًا ، فظلمُ العبدِ نفسَهُ فيما بينَهُ وبينَ ربِّهِ ، من صومِ يومٍ تركَهُ ، أو صلاةٍ تركَها ؛ فإنَّ اللَّهَ يغفرُ ذلِكَ ويتجاوزُ إن شاءَ . وأمَّا الدِّيوانُ الَّذي لا يترُكُ اللَّهُ منهُ شيئًا ، ",["فظلمُ العبادِ بعضِهِم بعضًا",1]," ؛ ",["القصاصُ لا محالةَ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (26073 )، والحاكم في ((المستدرك)) (8717 )، والبيهقي في ((شعب الإيمان)) (7069 )،","bab":"مظالم › تحريم الظلم","dorar":"ybNV1Rpi","merged":2,"otherRefs":["المستدرك على الصحيحين 8943 (صحيح)"]},{"id":"س-08010","fp":"e4fe2ad8358c","stateId":747,"easy":"إذا ظلمت بني آدم ← تتبعك مظالمهم حتى لا تبقى لك حسنة ويُزاد عليك من سيئاتهم","cause":"مَظالمُ بني آدَمَ تَتْبَعُه","result":"حتَّى ما تَبْقَى له حسنةٌ، ويُزادُ عليه مِن سيِّئاتِهِم","explicit":true,"otherNeedIds":[52],"ref":"المستدرك على الصحيحين 2302","srcLabel":"الحاكم","text":["عَنْ أَبِي عُثْمَانَ النَّهْدِيَّ أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قالَ: تُرفَعُ للرَّجلِ صحيفةٌ يومَ القيامةِ، حتَّى يَرى أنَّه ناجٍ، فما تَزالُ ",["مَظالمُ بني آدَمَ تَتْبَعُه",1]," ",["حتَّى ما تَبْقَى له حسنةٌ، ويُزادُ عليه مِن سيِّئاتِهِم",2],". قالَ: فقلتُ له -أوْ قالَ له عاصِمٌ-: عمَّن يا أبا عُثمانَ؟ قالَ: عنْ سَلمانَ، وسَعدٍ، وابنِ مسعودٍ، ورَجلينِ آخرَينِ لمْ يَحفظْهُما. قالَ شُعبَةُ: فسَألتُ عاصِمًا عنْ هذا الحديثِ فحَدَّثَنيهِ عنْ أبي عُثمانَ، عنْ سَلمانَ، وأَخْبَرني عُثمانُ بنُ غِياثٍ، أنَّه سَمِعَ أبا عُثمانَ يُحدِّثُ بهذا عنْ سَلمانَ وأصحابِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"سلمان وسعد وابن مسعود","muhaddith":"صحيح على شرط الشيخين","bab":"مظالم › تحريم الظلم","dorar":"qV1yfQA6","merged":2,"otherRefs":["صحيح الترغيب 2224 (صحيح)"]},{"id":"س-08039","fp":"3239db8d7b98","stateId":747,"easy":"إذا ظلمت شبراً من الأرض ← يكلفك الله أن تحفره حتى آخر سبع أرضين","cause":"أيُّما رجلٍ ظَلَمَ شِبْرًا مِنَ الأرضِ","result":"كَلَّفَهُ اللهُ عزَّ وجلَّ أنْ يَحْفِرَهُ حتى يَبْلُغَ بهِ سبعَ أَرَضِينَ ، ثُمَّ يُطَوَّقُهُ يومَ القيامةِ حتى يُقْضَى بين الناسِ","explicit":true,"repOf":"س-08033","ref":"صحيح الترغيب 1868","text":[["أيُّما رجلٍ ظَلَمَ شِبْرًا مِنَ الأرضِ ؛ ",1],["كَلَّفَهُ اللهُ عزَّ وجلَّ أنْ يَحْفِرَهُ حتى يَبْلُغَ بهِ سبعَ أَرَضِينَ ، ثُمَّ يُطَوَّقُهُ يومَ القيامةِ حتى يُقْضَى بين الناسِ ",2],"."],"grade":"صحيح","narrator":"يعلى بن مرة الثقفي","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17571)، وعبد بن حميد (407)، والخرائطي في ((مساوئ الأخلاق)) (633)، وابن حبان (2830)، والطبراني (22/ 270) (692) واللفظ لهم.","bab":"مظالم › تحريم الظلم","dorar":"UzpTBmlX","merged":2,"otherRefs":["الترغيب والترهيب 3/72 (صحيح)"]},{"id":"س-03921","fp":"3b17542b4c49","stateId":747,"easy":"إذا أضررت في الوصية ← تجب لك النار","cause":"فيُضارَّانِ في الوَصيَّةِ","result":"فتَجِبُ لهما النَّارُ","explicit":true,"ref":"الأحكام الوسطى 3/ 322","srcLabel":"أبو داود","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قالَ: \"إنَّ الرَّجُلَ والمَرْأةَ لَيَعمَلان بطاعةِ اللهِ سِتَّينَ سَنَةً ثُمَّ يَحضُرُهما المَوْتُ ",["فيُضارَّانِ في الوَصيَّةِ",1],"، ",["فتَجِبُ لهما النَّارُ",2],"\"، قالَ: قَرَأَ علَيَّ أبو هُرَيرةَ مِن هاهنا: {مِنْ بَعْدِ وَصِيَّةٍ يُوصَي بِهَا أَوْ دَيْنٍ غَيْرَ مُضَارٍّ...} حتَّى بَلَغَ: {وَذَلِكَ الْفَوْزُ الْعَظِيمُ}."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (2867)، والترمذي (2117)، والبيهقي (12711) بلفظه.","bab":"تفسير آيات › سورة النساء","dorar":"rfI8H6MP"},{"id":"س-04810","fp":"d7f5e5f7ee7f","stateId":747,"easy":"إذا ظلمت معاهداً أو انتقصته أو كلفته فوق طاقته أو أخذت منه بغير طيب نفس ← فالنبي ﷺ حجيجك يوم القيامة","cause":"مَن ظلَمَ مُعَاهَدًا ، أو انْتَقَصَهُ حَقَّهُ ، أو كَلَّفَهُ فَوقَ طاقَتِه ، أو أخَذَ مِنهُ شيئًا بِغيرِ طِيبِ نَفْسٍ مِنهُ","result":"فأنَا حَجِيجُهُ يَومَ القِيامةِ","explicit":true,"ref":"صحيح الجامع 2655","srcLabel":"أبو داود","text":["ألا ",["مَن ظلَمَ مُعَاهَدًا ، أو انْتَقَصَهُ حَقَّهُ ، أو كَلَّفَهُ فَوقَ طاقَتِه ، أو أخَذَ مِنهُ شيئًا بِغيرِ طِيبِ نَفْسٍ مِنهُ",1]," ، ",["فأنَا حَجِيجُهُ يَومَ القِيامةِ",2]],"grade":"صحيح","narrator":"عدة آباء من أصحاب النبي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3052)، وابن زنجويه في ((الأموال)) (621)، والبيهقي (18765) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"0qY788Cc"},{"id":"س-07404","fp":"4e8dbbf1ea42","stateId":747,"easy":"إذا ظلمت ولو شاة ← لتُختصمن يوم القيامة حتى الشاتان فيما انتطحتا","cause":"حتَّى الشَّاتانِ فيما انْتطَحَتا","result":"لَيختصمَنَّ كلُّ شَيءٍ يومَ القيامةِ","explicit":true,"ref":"صحيح الترغيب 3604","srcLabel":"أحمد","text":[["لَيختصمَنَّ كلُّ شَيءٍ يومَ القيامةِ",2]," ، ",["حتَّى الشَّاتانِ فيما انْتطَحَتا",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (9072)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"PCBvO8wp"},{"id":"س-07846","fp":"f3c65ef75a89","stateId":747,"easy":"إذا خلفت مجاهداً في أهله فخنته ← توقف يوم القيامة فيأخذ من حسناتك ما شاء","cause":"وما مِن رَجُلٍ مِنَ القاعِدينَ يَخلُفُ رَجُلًا مِنَ المُجاهِدينَ في أهلِه فيَخونُه فيهم","result":"إلَّا وُقِفَ له يَومَ القيامةِ، فيَأخُذُ مِن عَمَلِه ما شاءَ","explicit":true,"repOf":"س-04937","otherNeedIds":[52],"ref":"صحيح مسلم 1897","text":["حُرمةُ نِساءِ المُجاهِدينَ على القاعِدينَ كَحُرمةِ أُمَّهاتِهم، ",["وما مِن رَجُلٍ مِنَ القاعِدينَ يَخلُفُ رَجُلًا مِنَ المُجاهِدينَ في أهلِه فيَخونُه فيهم",1],"، ",["إلَّا وُقِفَ له يَومَ القيامةِ، فيَأخُذُ مِن عَمَلِه ما شاءَ",2],"، فما ظَنُّكُم؟ وفي روايةٍ: فخُذْ مِن حَسَناتِه ما شِئتَ، فالتَفَتَ إلَينا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: فما ظَنُّكُم؟"],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"[صحيح]","takhrij":"أخرجه أبو داود (2496)، والنسائي (3189)، وأحمد (23004) واللفظ لهم جميعا","bab":"قيامة › الحساب والقصاص","dorar":"pISHNWcX"},{"id":"س-07986","fp":"04afafbc9e23","stateId":747,"easy":"إذا ضربت عبداً لك ظالماً له ← يُقاد منك يوم القيامة","cause":"لا يضربُ أحدٌ عبدًا له وهو ظالمٌ له","result":"إلا أُقِيدَ منه يومَ القيامةِ","explicit":true,"similar":["س-08031","س-08076"],"ref":"صحيح الأدب المفرد 134","srcLabel":"البخاري (الأدب المفرد)","text":["عن عمار بنِ ياسرٍ قال ",["لا يضربُ أحدٌ عبدًا له وهو ظالمٌ له",1]," ",["إلا أُقِيدَ منه يومَ القيامةِ",2]],"grade":"صحيح","muhaddith":"صحيح الإسناد","bab":"مظالم › تحريم الظلم","dorar":"DxjH6pkQ"},{"id":"س-08031","fp":"08220b1cdc65","stateId":747,"easy":"إذا ضربت مملوكك ظالماً ← يُقاد منك يوم القيامة","cause":"من ضرب مملوكَه ظالمًا","result":"أُقِيدَ منه يومَ القيامةِ","explicit":true,"repOf":"س-07986","ref":"صحيح الجامع 6376","text":[["من ضرب مملوكَه ظالمًا ، ",1],["أُقِيدَ منه يومَ القيامةِ",2]],"grade":"صحيح","narrator":"عمار بن ياسر","muhaddith":"صحيح","takhrij":"أخرجه الطبراني كما في ((الترغيب والترهيب)) للمنذري (3/148)، وأبو نعيم في ((حلية الأولياء)) (4/378) واللفظ له","bab":"مظالم › تحريم الظلم","dorar":"3xPbiWUY"},{"id":"س-08032","fp":"5e0bb5f8ae85","stateId":747,"easy":"إذا ضربت مملوكك سوطاً ظلماً ← يُقتص منك يوم القيامة","cause":"من ضرب مملوكَه سوطًا ظُلمًا","result":"اقتُصَّ منه يومَ القيامةِ","explicit":true,"similar":["س-07989"],"ref":"صحيح الترغيب 3607","srcLabel":"الطبراني","text":[["من ضرب مملوكَه سوطًا ظُلمًا ",1],["اقتُصَّ منه يومَ القيامةِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه البزار (9446)، والطبراني في ((المعجم الأوسط)) (1445)، وابن عدي في ((الكامل في الضعفاء)) (4/168) باختلاف يسير","bab":"مظالم › تحريم الظلم","dorar":"fSTzeeSD"},{"id":"س-08038","fp":"db7fffa54119","stateId":747,"easy":"إذا ظلمت ← تُمحى حسناتك يوم القيامة حتى لا تبقى لك حسنة","cause":"اتَّقوا الظُّلمَ ما استطعتُم","result":"فيقول : امْحُوا من حسناتِه . وما يزالُ كذلك حتى ما يَبْقى له حسنةٌ","explicit":true,"otherNeedIds":[52],"ref":"صحيح الترغيب 2221","srcLabel":"الحاكم","text":["إنَّ الشيطانَ قد يَئِسَ أن تُعبَدَ الأصنامُ في أرضِ العربِ ، ولكنه سَيرضى منكم بدونِ ذلك بالمحَقِّراتِ ، وهي الموبِقاتُ يومَ القيامةِ ، ",["اتَّقوا الظُّلمَ ما استطعتُم",1]," ؛ فإنَّ العبدَ يَجيءُ بالحسناتِ يومَ القيامةِ يَرى أنها ستُنْجِيه ، فمازالَ عبدٌ يقومُ يقول : يا ربِّ ظلَمَني عبدُك مَظلَمَةً . ",["فيقول : امْحُوا من حسناتِه . وما يزالُ كذلك حتى ما يَبْقى له حسنةٌ",2]," من الذُّنوبِ ، وإنَّ مَثَلَ ذلك كسَفْرٍ نزلوا بفلاةٍ من الأرضِ ليس معهم حطبٌ ، فتفرَّقُ القومُ ليحتَطِبوا فلم يَلْبَثوا أن حَطِبوا ، فأَعظَموا النَّارَ وطبَخوا ما أرادوا ، وكذلك الذُّنوبُ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو يعلى (5122)، والحاكم (2221)، والبيهقي في ((شعب الإيمان)) (7263) باختلاف يسير","bab":"مظالم › تحريم الظلم","dorar":"CJ5GF7rQ"},{"id":"س-02941","fp":"748ccd0c7560","stateId":747,"easy":"إذا روّعت مؤمناً ← لا يؤمّن الله روعتك يوم القيامة","cause":"مَنْ رَوَّعَ مؤمنًا","result":"لمْ يَؤمِّنِ اللهُ رَوْعَتَهُ يومَ القيامةِ","explicit":true,"ref":"الجامع الصغير 8695","srcLabel":"البيهقي","text":[["مَنْ رَوَّعَ مؤمنًا، ",1],["لمْ يَؤمِّنِ اللهُ رَوْعَتَهُ يومَ القيامةِ، ",2],"ومَنْ سَعَى بمؤمنٍ، أقامَهُ اللهُ مقامَ ذلٍّ وخزيٍ يومَ القيامَةِ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (11117) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (6/ 322)، وأبو طاهر المخلص في ((المخلصيات)) (2434)، بنحوه.","bab":"إيمان › الوعيد","dorar":"aZur3Nkt"},{"id":"س-05132","fp":"3253f8ac54ff","stateId":747,"easy":"إذا ظلمت شبراً من الأرض ← تأتي يوم القيامة تحمله على عنقك","cause":"مَن ظلَمَ شِبرًا منَ الأرضِ","result":"جاءَ يَحمِلُه على عُنقِه يومَ القيامةِ","explicit":true,"repOf":"س-08033","ref":"تخريج مشكل الآثار 6149","text":[["مَن ظلَمَ شِبرًا منَ الأرضِ؛ ",1],["جاءَ يَحمِلُه على عُنقِه يومَ القيامةِ",2],"."],"grade":"حسن","narrator":"يعلى بن مرة الثقفي","muhaddith":"إسناده حسن.","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (6149) باللفظ نفسه، وأحمد (17558) ، والطبراني (691) (22 / 270) بنحوه","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"39Sr8lI3"},{"id":"س-06891","fp":"160d03b9f802","stateId":747,"easy":"إذا ظلمت ← فإن الله لا يجاوزه ظلم ظالم","cause":"ظُلمُ ظالمٍ","result":"وعزَّتي وجَلالي لا يُجاوزُني","explicit":true,"ref":"البدور السافرة 287","srcLabel":"الطبراني","text":["يُقبِلُ الجبارُ تباركَ وتعالى يومَ القيامةِ فيثني رجلَهُ على الجسرِ فيقولُ : ",["وعزَّتي وجَلالي لا يُجاوزُني",2]," ",["ظُلمُ ظالمٍ",1]," ، فينصفُ الخلقَ بعضَهم من بعضٍ حتى إنَّهُ لينصِفُ الشاةَ الجماءَ منَ الشاةِ العضباءِ بنطحةٍ تنطحُها"],"grade":"حسن","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني (2/ 95)، (1421)، وابن منده في ((الرد على الجهمية)) (ص: 20) كلاهما باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"pJENcPC1"},{"id":"س-07989","fp":"226bb6178371","stateId":747,"easy":"إذا ضربت مملوكك ظلماً ← يُقاد منك يوم القيامة","cause":"مَنْ ضَرَبَ مَمْلُوكَهُ ظُلْمًا","result":"أُقِيلَ مِنْهُ يومَ الْقِيامَةِ","explicit":true,"repOf":"س-08032","ref":"مجمع الزوائد 4/241","text":[["مَنْ ضَرَبَ مَمْلُوكَهُ ظُلْمًا",1]," ",["أُقِيلَ مِنْهُ يومَ الْقِيامَةِ",2]],"grade":"حسن","narrator":"عمار بن ياسر","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني كما في ((الترغيب والترهيب)) للمنذري (3/148)، وأبو نعيم في ((حلية الأولياء)) (4/378) باختلاف يسير.","bab":"مظالم › تحريم الظلم","dorar":"6Tkhe42i"},{"id":"س-08001","fp":"5dca1c697fca","stateId":747,"easy":"إذا ظلمت رجلاً مظلمة في الدنيا ولم تقضها من نفسك ← يقضيها الله منك يوم القيامة","cause":"ما من عبدٍ يظلمُ رجلًا مظلمةً في الدنيا لا يقضيِه من نفسِه","result":"إلا أقضاه اللهُ تعالى منه يومَ القيامةِ","explicit":true,"ref":"النوافح العطرة 321","srcLabel":"البيهقي","text":[["ما من عبدٍ يظلمُ رجلًا مظلمةً في الدنيا لا يقضيِه من نفسِه",1]," ",["إلا أقضاه اللهُ تعالى منه يومَ القيامةِ",2]],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"إسناده حسن","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (7484) باختلاف يسير.","bab":"مظالم › تحريم الظلم","dorar":"HRDYSpAp"},{"id":"س-08002","fp":"d8d1926d595a","stateId":747,"easy":"إذا انتقصت ذراعاً من أرض أخيك ← تُطوّقه يوم القيامة، ولو حصاة","cause":"ذراعٌ مِنَ الأرضِ ينتقصُهُ المرءُ منْ حقِّ أخيهِ","result":"ليستْ حصاةٌ أخذَهَا إلَّا طُوِّقَها يومَ القيامةِ","explicit":true,"ref":"الجامع الصغير 1178","srcLabel":"أحمد","text":["أعظمُ الظلمِ ",["ذراعٌ مِنَ الأرضِ ينتقصُهُ المرءُ منْ حقِّ أخيهِ",1]," ، ",["ليستْ حصاةٌ أخذَهَا إلَّا طُوِّقَها يومَ القيامةِ",2]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"حسن","takhrij":"أخرجه أحمد (3767)، والطبراني (10/267) (10516) باختلاف يسير","bab":"مظالم › تحريم الظلم","dorar":"Relid3jZ"},{"id":"س-08050","fp":"0565f57c9bd7","stateId":747,"easy":"إذا أخذت حصاة من الأرض ظلماً ← تُطوّقها يوم القيامة إلى قعر الأرض","cause":"فليسَ حَصاةٌ مِنَ الأرضِ يَأخُذُها","result":"إلَّا طُوِّقَها يَومَ القيامةِ إلى قَعرِ الأرضِ","explicit":true,"repOf":"س-08033","ref":"تنبيه الغافلين 255","text":["عن ابنِ مَسعودٍ رَضيَ اللهُ عنه، قال: قُلتُ: يا رسولَ اللَّهِ، أيُّ الظُّلمِ أظلمُ؟ فقال: «ذِراعٌ مِنَ الأرضِ يَنتَقِصُها المَرءُ المُسلمُ مِن حَقِّ أخيه، ",["فليسَ حَصاةٌ مِنَ الأرضِ يَأخُذُها",1]," ",["إلَّا طُوِّقَها يَومَ القيامةِ إلى قَعرِ الأرضِ",2],"، ولا يَعلمُ قَعرَها إلَّا الذي خَلقَها»"],"grade":"حسن","narrator":"ابن مسعود","muhaddith":"إسناده حسن.","takhrij":"أخرجه أحمد (3767)، والطبراني في ((الكبير)) (10/ 216) (10516) واللفظ لهما.","bab":"مظالم › تحريم الظلم","dorar":"lx7LXXuh"},{"id":"س-08076","fp":"e3c5ce959bfd","stateId":747,"easy":"إذا ضربت عبداً لك (ظلماً) ← يُقاد منك يوم القيامة","cause":"ما من رجلٍ يضرِبُ عبدًا له","result":"إلَّا أُقِيدَ منه يومَ القيامةِ","explicit":true,"repOf":"س-07986","ref":"مجمع الزوائد 10/356","text":[["ما من رجلٍ يضرِبُ عبدًا له",1]," ",["إلَّا أُقِيدَ منه يومَ القيامةِ",2]],"grade":"حسن","narrator":"عمار بن ياسر","muhaddith":"رجاله ثقات","takhrij":"أخرجه البزار (1399) بلفظه، وأبو نعيم الأصبهاني في ((حلية الأولياء)) (4/378) باختلاف يسير.","bab":"مظالم › قصاص المظالم","dorar":"4GhkJjnt"},{"id":"س-08024","fp":"31babccaae35","stateId":747,"easy":"إذا ظلمت ← يقتص منك المظلومون حتى ينزعوا ما في يديك","cause":"يجيءُ الظالمُ يومَ القيامةِ","result":"فما يبرحُ الذين ظلموا يقصونَ منَ الذينَ ظَلموا حتى يَنزعوا ما في أيديهُمْ منَ الحسناتِ ، فإن لم تكنْ لهم حسناتٌ رُدَّ عليْهِم من سيئاتِهم حتى يوردَ الدركَ الأسفلَ منَ النارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[52],"ref":"البدور السافرة 288","srcLabel":"الطبراني","text":[["يجيءُ الظالمُ يومَ القيامةِ",1]," حتى إذا كان على جسرِ جهنمَ بين الظلمةِ والوعرةِ لقيَهُ المظلومُ فعرفَهُ ، وعرفَ ما ظلمَهُ به ، ",["فما يبرحُ الذين ظلموا يقصونَ منَ الذينَ ظَلموا حتى يَنزعوا ما في أيديهُمْ منَ الحسناتِ ، فإن لم تكنْ لهم حسناتٌ رُدَّ عليْهِم من سيئاتِهم حتى يوردَ الدركَ الأسفلَ منَ النارِ",2]],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (5976)","bab":"مظالم › تحريم الظلم","dorar":"tpPzx9Yz"},{"id":"س-08046","fp":"118b0368eb7d","stateId":747,"easy":"إذا ظلمت العباد ← يقص الله بعضهم من بعض","cause":"وأمَّا الذي لا يُترَكُ","result":"يُقِصُّ اللَّهُ بَعضَهم مِن بَعضٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-08048"],"ref":"البعث والنشور 393","srcLabel":"الطيالسي","text":["الظُّلمُ ثَلاثةٌ: فظُلمٌ لا يَترُكُه اللهُ، وظُلمٌ يُغفَرُ، وظُلمٌ لا يُغفَرُ؛ فأمَّا الظُّلمُ الذي لا يُغفَرُ فالشِّركُ، لا يَغفِرُه اللهُ، والظُّلمُ الذي يُغفَرُ فظُلمُ العَبدِ فيما بَينَه وبَينَ رَبِّه، ",["وأمَّا الذي لا يُترَكُ",1],"، ",["يُقِصُّ اللَّهُ بَعضَهم مِن بَعضٍ",2]],"grade":"حسن","narrator":"أنس","muhaddith":"[غير قوي]","takhrij":"أخرجه الطيالسي (2223)، وأبو نعيم في ((الحلية)) (6/ 309)، والبزار كما في ((كشف الأستار)) (3439) باختلاف يسير.","bab":"مظالم › تحريم الظلم","dorar":"82Dfcjav"},{"id":"س-08048","fp":"3c7d902d7989","stateId":747,"easy":"إذا ظلمت العباد ← تُقاضى حتى يُدان بعضكم من بعض","cause":"فظُلمُ العِبادِ بَعضِهم بَعضًا","result":"حتَّى يدينَ بَعضُهم مِن بَعضٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-08046","ref":"البعث والنشور 292","text":["«الظُّلمُ ثَلاثةٌ: فظُلمٌ لا يَغفِرُه اللهُ عَزَّ وجَلَّ، وظُلمٌ يَغفِرُه، وظُلمٌ لا يَترُكُه اللهُ عَزَّ وجَلَّ؛ فأمَّا الظُّلمُ الذي لا يَغفِرُه اللهُ فالشِّركُ، قال اللهُ عَزَّ وجَلَّ: {إِنَّ الشِّرْكَ لَظُلْمٌ عَظِيمٌ}، وأمَّا الظُّلمُ الذي يَغفِرُه اللهُ فظُلمُ العِبادِ أنفُسَهم فيما بَينَهم وبَينَ رَبِّهم، وأمَّا الظُّلمُ الذي لا يَترُكُه ",["فظُلمُ العِبادِ بَعضِهم بَعضًا",1],"، ",["حتَّى يدينَ بَعضُهم مِن بَعضٍ",2],"»."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده غير قوي.","bab":"مظالم › تحريم الظلم","dorar":"eiFC1szY"},{"id":"س-08083","fp":"17e59d4bfbcf","stateId":747,"easy":"إذا زدت في العقوبة ← يُقتص منك","cause":"وإن زِدْتَ","result":"اقْتُصَّ مِنك","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"علل ابن أبي حاتم 2342","srcLabel":"الترمذي","text":["حَديثٌ رَواه قُرادٌ، عن اللَّيْثِ، عن مالِكٍ، عن الزُّهْريِّ، عن عُرْوةَ، عن عائِشةَ، عن النَّبيِّ صلَّى اللهُ عليه وسلَّم: أنَّ رَجُلًا أتى النَّبيَّ صلَّى اللهُ عليه وسلَّم، فقالَ: إنَّ لي مَماليكَ أَضرِبُهم، قالَ: إن ضَرَبْتَهم بقَدْرِ ذَنْبِهم فلا بَأسَ، ",["وإن زِدْتَ",1]," ",["اقْتُصَّ مِنك",2],"، فقالَ الرَّجُلُ: فمَماليكي أحْرارٌ، لا أَملِكُ بَعْدَ اليَوْمِ؟"],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"نَرى أنَّ قُراد غَلِطَ، بَحَثْنا عن هذا الحَديثِ مِن حَديثِ مالِكٍ، ولم نُصِبْ له أصْل، وبَحَثْنا مِن حَديثِ اللَّيْثِ، فإذا حَدَّثَنا أبو صالِحٍ، عن اللَّيْثِ، عن ابنِ الهادِ، عن زِيادٍ مَوْلى ابنِ عيَّاشٍ: أنَّ رَجُلُا أتى النَّبيَّ صلَّى اللهُ عليه وسلَّم...","takhrij":"أخرجه الترمذي (3165)، والبيهقي في ((الشعب)) (8223)، وتمام في ((فوائده)) (1192) ثلاثتهم بمعناه.","bab":"مظالم › قصاص المظالم","dorar":"5zKqZaFE"},{"id":"س-00468","fp":"a69bf4b65778","stateId":748,"easy":"إذا حبست هرة فلم تطعمها ولم تتركها ← تُعذّب بسببها","cause":"في هِرَّةٍ لَم تُطعِمْها ولَم تَسقِها، ولَم تَترُكْها تَأكُلُ مِن خَشاشِ الأرضِ","result":"عُذِّبَتِ امرَأةٌ","explicit":true,"similar":["س-01790"],"ref":"صحيح مسلم 2243","srcLabel":"متفق عليه","text":[["عُذِّبَتِ امرَأةٌ",2]," ",["في هِرَّةٍ لَم تُطعِمْها ولَم تَسقِها، ولَم تَترُكْها تَأكُلُ مِن خَشاشِ الأرضِ",1],". وفي روايةٍ: رَبَطَتها. وفي حَديثِ أبي مُعاويةَ: حَشَراتِ الأرضِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3318)، ومسلم (2243) واللفظ له","bab":"آداب عامة › الرفق بالحيوان والطير ونحوهما","dorar":"zDWDaP1V"},{"id":"س-04560","fp":"7dd60091bf1c","stateId":748,"easy":"إذا حبست هرة حتى ماتت جوعاً ← تُعذّب بها في النار","cause":"حَبَسَتها حتَّى ماتَت جوعًا، لا أطعَمَتها، ولا أرسَلَتها تَأكُلُ","result":"فإذا امرَأةٌ -حَسِبتُ أنَّه قال- تَخدِشُها هِرَّةٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح البخاري 745","srcLabel":"متفق عليه","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم صَلَّى صَلاةَ الكُسوفِ، فقامَ فأطالَ القيامَ، ثُمَّ رَكَعَ فأطالَ الرُّكوعَ، ثُمَّ قامَ فأطالَ القيامَ، ثُمَّ رَكَعَ فأطالَ الرُّكوعَ، ثُمَّ رَفَعَ، ثُمَّ سَجَدَ فأطالَ السُّجودَ، ثُمَّ رَفَعَ، ثُمَّ سَجَدَ فأطالَ السُّجودَ، ثُمَّ قامَ فأطالَ القيامَ، ثُمَّ رَكَعَ فأطالَ الرُّكوعَ، ثُمَّ رَفَعَ فأطالَ القيامَ، ثُمَّ رَكَعَ فأطالَ الرُّكوعَ، ثُمَّ رَفَعَ، فسَجَدَ فأطالَ السُّجودَ، ثُمَّ رَفَعَ، ثُمَّ سَجَدَ فأطالَ السُّجودَ، ثُمَّ انصَرَفَ، فقال: قد دَنَت مِنِّي الجَنَّةُ حتَّى لَوِ اجتَرَأتُ عليها لَجِئتُكُم بقِطافٍ مِن قِطافِها، ودَنَت مِنِّي النَّارُ حتَّى قُلتُ: أي رَبِّ، وأنا معهُم! ",["فإذا امرَأةٌ -حَسِبتُ أنَّه قال- تَخدِشُها هِرَّةٌ",2],"، قُلتُ: ما شَأنُ هذه؟ قالوا: ",["حَبَسَتها حتَّى ماتَت جوعًا، لا أطعَمَتها، ولا أرسَلَتها تَأكُلُ",1]," -قال نافِعٌ: حَسِبتُ أنَّه قال: مِن خَشيشِ- أو خَشاشِ الأرضِ."],"grade":"صحيح","narrator":"أسماء بنت أبي بكر","muhaddith":"[صحيح]","takhrij":"من أفراد البخاري على مسلم","bab":"جهنم › صفة عذاب أهل النار","dorar":"ZU7NYi2p","merged":10,"otherRefs":["تخريج المسند لشعيب 10501 (صحيح)","تخريج المسند لشعيب 7847 (صحيح)","صحيح البخاري 2365 (صحيح)","تخريج صحيح ابن حبان 7489 (صحيح)","صحيح البخاري 3482 (صحيح)","تخريج المسند لشعيب 10584 (صحيح)","مجمع الزوائد 1/121 (صحيح)","تخريج المسند لشعيب 14602 (صحيح)","صحيح مسلم 2619 (صحيح)"]},{"id":"س-07195","fp":"a9f788e2dbc3","stateId":748,"easy":"إذا قتلت عصفوراً فما فوقه بغير حقه ← يسألك الله عنه يوم القيامة","cause":"ما مِن إنسانٍ يَقتُلُ عُصفورًا فما فوْقَها بغيرِ حَقِّها","result":"سألَهُ اللهُ عزَّ وجلَّ عنها يومَ القِيامةِ","explicit":true,"similar":["س-00460"],"ref":"المستدرك على الصحيحين 7782","srcLabel":"النسائي","text":[["ما مِن إنسانٍ يَقتُلُ عُصفورًا فما فوْقَها بغيرِ حَقِّها",1],"، إلَّا ",["سألَهُ اللهُ عزَّ وجلَّ عنها يومَ القِيامةِ",2],"، قيل: يا رَسولَ اللهِ، وما حَقُّها؟ قالَ: حَقُّها أنْ يَذْبَحَها فيَأْكُلَها، ولا يَقْطَعَ رأْسَها فيَرْمِيَ بهِ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح الإسناد","takhrij":"أخرجه النسائي في ((الكبرى)) (4841) بلفظه، وأحمد (6551)، والدارمي (2021) كلاهما بلفظ مقارب.","bab":"علم › حسن السؤال ونصح العالم","dorar":"qflLUpJA","merged":2,"otherRefs":["الأحكام الوسطى 4/ 123 (صحيح)"]},{"id":"س-00460","fp":"255a7ad180cd","stateId":748,"easy":"إذا قتلت عصفوراً بغير حق ← يسألك الله عنه يوم القيامة","cause":"مَن قتلَ عصفورًا بغير حقٍ","result":"سألَهُ اللَّهُ عنهُ يومَ القيامةِ قيلَ يا رسولَ اللَّهِ وما حقُّهُ","explicit":true,"repOf":"س-07195","ref":"تخريج المسند لشاكر 10/59","text":[["مَن قتلَ عصفورًا بغير حقٍ ",1],["سألَهُ اللَّهُ عنهُ يومَ القيامةِ قيلَ يا رسولَ اللَّهِ وما حقُّهُ",2]," قالَ يَذبحُهُ ذبحًا ولا يأخذُ بعنقِهِ فيقطعُهُ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (4445)، وأحمد (6551) واللفظ له","bab":"آداب عامة › الرفق بالحيوان والطير ونحوهما","dorar":"69sqffgZ"},{"id":"س-04920","fp":"ea82fc09b0c1","stateId":748,"easy":"إذا مثّلت بذي الروح ثم لم تتب ← يمثل الله بك يوم القيامة","cause":"مَن مَثَّلَ بِذي الرُّوحِ، ثُمَّ لم يَتُبْ","result":"مَثَّلَ اللهُ به يَومَ القيامَةِ","explicit":true,"ref":"تخريج المسند لشعيب 5956","srcLabel":"أحمد","text":["عن رَجُلٍ من أصْحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ أُراهُ ابنَ عُمَرَ، قال: سَمِعتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن مَثَّلَ بِذي الرُّوحِ، ثُمَّ لم يَتُبْ",1]," ",["مَثَّلَ اللهُ به يَومَ القيامَةِ",2],"، قال حُسَينٌ: مَن مَثَّلَ بِذي رُوحٍ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (5956)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"YprZUoAR"},{"id":"س-07850","fp":"0017a9bfa6de","stateId":748,"easy":"إذا ذبحت عصفوراً أو قتلته في غير شيء ← يسألك الله عنه يوم القيامة","cause":"مَن ذبحَ عصفورًا أو قتلَهُ في غيرِ شيءٍ","result":"سألَهُ اللَّهُ عنهُ يومَ القيامةِ","explicit":true,"ref":"تخريج المسند لشاكر 10/59","srcLabel":"النسائي","text":[["مَن ذبحَ عصفورًا أو قتلَهُ في غيرِ شيءٍ",1]," قالَ عَمرٌو أحسبُهُ قالَ إلَّا بحقِّهِ ",["سألَهُ اللَّهُ عنهُ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (4445)، وأحمد (6550) واللفظ له","bab":"قيامة › الحساب والقصاص","dorar":"MD7F0RbO"},{"id":"س-00465","fp":"a92aa8c407d3","stateId":748,"easy":"إذا وسمت الحيوان في وجهه ← فأمامك القصاص","cause":"قد وسمتُها في أنفِها","result":"أما إنَّ أمامَك القصاصُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الترغيب والترهيب 3/225","srcLabel":"الطبراني","text":["أتيتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم بإبلٍ ",["قد وسمتُها في أنفِها",1]," فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم يا جُنادةُ فما وجدتَ عضوًا تسِمُه إلَّا في الوجهِ ",["أما إنَّ أمامَك القصاصُ",2]," فقال أمرُها إليك يا رسولَ اللهِ"],"grade":"صحيح","narrator":"جنادة بن جرادة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن أبي عاصم في ((الآحاد والمثاني)) (1256)، والطبري في ((تهذيب الآثار)) (661)، والطبراني (2/283) (2179) باختلاف يسير.","bab":"آداب عامة › الرفق بالحيوان والطير ونحوهما","dorar":"LN8DkwjB"},{"id":"س-01790","fp":"281dd5bbb037","stateId":748,"easy":"إذا حبست هرة فلم تطعمها ولم ترسلها ← تُعذّب في النار","cause":"ربطَتها ، فلا هي أطعَمتْها ، ولا هي أرسَلَتْها","result":"وإذا فيها الحِميَريَّةُ صاحبَةُ القطَّةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-00468","ref":"صحيح الموارد 433","text":["صلَّينا مع رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّم يومًا ، فأطالَ القيامَ ، وكان إذا صلَّى بنا خفَّفَ ، ثُمَّ لا نسمَعُ منه شيئًا غير أنه يقولُ : ربِّ وأنا فيهِم ؟ ! ثم رأيته أهوى بيدِهِ ليتناولَ شيئًا ، ثمَّ إنه ركَعَ ، ثمَّ أسرعَ بعدَ ذلكَ ، فلمَّا سلَّمَ رسولُ اللهَ صَلَّى اللَّهُ علَيهِ وسلَّمَ ؛ جلَس وجلَسنا حولَهُ ، فقال رسولُ اللهِ صَلَّى اللَّهُ علَيهِ وسلَّمَ : قد علِمتُ أنه رابكُم طولُ صلاتي وقيامي . قُلنا : أجَل يا رسولَ اللَّهِ ! وسمعناك تقولُ : ربِّ وأنا فيهِم ؟ ! فقال رسولُ اللهِ صَلَّى اللَّهُ علَيهِ وسلَّمَ : والَّذي نفسي بيدِهِ ؛ ما من شيءٍ وُعِدتُموهُ في الآخرةِ ؛ إلَّا قد عُرِضَ عليَّ في مقامي هذا ، حتَّى لقد عُرِضَت عليَّ النارُ ، وأقبلَ عليَّ منها شيءٌ حتَّى دنا مكاني هذا ، فخشيتُ أن تغشاكُم ، فقلتُ : ربِّ ! وأنا فيهِم ؟ ! فصرَفها ، فأدبرَتْ قِطعًا كأنَّها الزَّرابِّيُّ ، فنظرتُ فيها نظرةً ، فرأيتُ فيها عمرَو بنَ خرثَانَ – أخا بني غِفارٍ – متَّكئًا في جهنَّمَ على قوسِهِ ، ",["وإذا فيها الحِميَريَّةُ صاحبَةُ القطَّةِ",2]," ؛ ",["ربطَتها ، فلا هي أطعَمتْها ، ولا هي أرسَلَتْها",1]],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه الروياني (193)، وابن حبان (6432) كلاهما بلفظه، والطبراني في ((المعجم الأوسط)) (3197) بنحوه.","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"X99NXf1y"},{"id":"س-07366","fp":"33cf9710ed62","stateId":748,"easy":"إذا ظلمت ولو بهيمة ← يُقاد منك يوم القيامة","cause":"فنطَحَتْ إحْداهُما الأُخْرى","result":"لَيُقادَنَّ لها يومَ القيامةِ","explicit":true,"ref":"تخريج المسند لشعيب 21511","srcLabel":"أحمد","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ كان جالسًا، وشاتانِ تَعتَلِفانِ، ",["فنطَحَتْ إحْداهُما الأُخْرى",1],"، فأجهَضَتْها، قال: فضَحِكَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقيلَ له: ما يُضحِكُكَ يا رسولَ اللهِ؟ قال: عجِبْتُ لها، والذي نَفْسي بيَدِه، ",["لَيُقادَنَّ لها يومَ القيامةِ",2],"."],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"حسن","takhrij":"أخرجه أحمد (21511) واللفظ له، والبزار (4032)، والطبراني في ((لمعجم الأوسط)) (6110)","bab":"فضائل النبي وصفته ودلائل النبوة › أحوال النبي","dorar":"eAiD6FEC"},{"id":"س-07452","fp":"a395f7e2d8b5","stateId":749,"easy":"إذا غدرت ← يكون لك لواء يوم القيامة","cause":"لِكُلِّ غادرٍ","result":"لواءٌ يومَ القيامةِ","explicit":true,"star":true,"otherNeedIds":[60],"ref":"سنن الترمذي 2191","srcLabel":"مسلم","text":["صلَّى بنا رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يومًا صلاةَ العصرِ بنَهارٍ ثمَّ قامَ خَطيبًا فلَم يدَع شيئًا يَكونُ إلى قيامِ السَّاعةِ إلَّا أَخبرَنا بِهِ ، حفِظَهُ من حفظَهُ ، ونَسيَهُ من نسيَهُ ، وَكانَ فيما قالَ : إنَّ الدُّنيا خضرةٌ حُلوةٌ ، وإنَّ اللَّهَ مُستَخلفُكُم فيها فَناظرٌ كيفَ تعمَلونَ ، ألا فاتَّقوا الدُّنيا واتَّقوا النِّساء وَكانَ فيما قالَ : ألا لا تَمنعنَّ رجلًا هيبةُ النَّاسِ أن يقولَ بحقٍّ إذا علمَهُ قالَ : فبَكَى أبو سعيدٍ فقالَ : قد واللَّهِ رأينا أشياءَ فَهِبنا ، كانَ فيما قالَ : ألا إنَّهُ يُنصَبُ ",["لِكُلِّ غادرٍ",1]," ",["لواءٌ يومَ القيامةِ",2]," بقدرِ غدرتِهِ ، ولا غَدرةَ أعظمُ من غدرةِ إمامِ عامَّةٍ يركزُ لواؤُهُ عندَ استِهِ وكانَ فيما حفِظنا يومئذٍ : ألا إنَّ بَني آدمَ خُلِقوا على طَبقاتٍ شتَّى ، فَمِنْهُم مَن يولَدُ مُؤمنًا ويَحيا مؤمنًا ويموتُ مؤمنًا ، وَمِنْهُم من يولَدُ كافرًا ويَحيا كافرًا ويموتُ كافرًا ، وَمِنْهُم من يولَدُ مؤمنًا ويحيا مؤمنًا ويموتُ كافرًا ، وَمِنْهُم من يولَدُ كافرًا ويَحيا كافرًا ويموتُ مؤمنًا ، ألا وإنَّ منهمُ البطيءَ الغضبِ سريعَ الفَيءِ ، وَمِنْهُم سريعُ الغَضَبِ سريعُ الفيءِ ، فتِلكَ بتلكَ ، ألا وإنَّ منهُم سريعَ الغَضَبِ بطيءَ الفيءِ ، ألا وخيرُهُم بطيءُ الغضَبِ سريعُ الفيءِ ، وشرُّهم سريعُ الغضَبِ بطيءُ الفيءِ ، ألا وإنَّ منهُم حَسنَ القضاءِ حَسنَ الطَّلبِ ، وَمِنْهُم سيِّئُ القضاءِ حسنُ الطَّلبِ ، وَمِنْهُم حسنُ القضاءِ سيِّئُ الطَّلبِ ، فتلكَ بتِلكَ ، ألا وإنَّ منهمُ السَّيِّئَ القَضاءِ السَّيِّئَ الطَّلبِ ، ألا وخيرُهُمُ الحسَنُ القضاءِ الحسَنُ الطَّلبِ ، ألا وشرُّهم سيِّئُ القضاءِ سيِّئُ الطَّلبِ ، ألا وإنَّ الغضبَ جمرةٌ في قلبِ ابنِ آدمَ ، أما رأيتُمْ إلى حُمرةِ عَينيهِ وانتِفاخِ أوداجِهِ ، فمَن أحسَّ بشَيءٍ من ذلِكَ فليُلصِق بالأرضِ قالَ : وجعَلنا نَلتَفتُ إلى الشَّمسِ هل بقيَ منها شيءٌ ؟ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : ألا إنَّهُ لم يبقَ منَ الدُّنيا فيما مضى منها إلَّا كما بقيَ من يومِكُم هذا فيما مضى منهُ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"حسن صحيح","takhrij":"أخرجه مسلم (2252)، وأبو داود (4344) بنحوه مختصرا.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"zoHZhCNo","merged":18,"otherRefs":["صحيح البخاري 3186 (صحيح)","صحيح الجامع 3435 (صحيح)","صحيح البخاري 3188 (صحيح)","صحيح مسلم 1736 (صحيح)","صحيح مسلم 1738 (صحيح)","تخريج المسند لشاكر 8/66 (صحيح)","تخريج المسند لشعيب 6093 (صحيح)","تخريج المسند لشعيب 11351 (صحيح)","تخريج المسند لشعيب 11038 (صحيح)","تخريج المسند لشعيب 5804 (صحيح)","تخريج المسند لشعيب 12518 (صحيح)","تخريج المسند لشعيب 3959 (صحيح)","تخريج المسند لشعيب 4839 (صحيح)","صحيح البخاري 7111 (صحيح)","الأمالي المطلقة 194 (صحيح)","تخريج المسند لشعيب 11796 (صحيح)"]},{"id":"س-08441","fp":"8d8cca536d80","stateId":749,"easy":"إذا أردت أهل المدينة بسوء ← يذيبك الله كما يذوب الملح في الماء","cause":"مَن أراد أهْلَها بسُوءٍ","result":"أذابَه اللهُ كما يَذوبُ المِلحُ في الماءِ","explicit":true,"star":true,"similar":["س-07876"],"otherNeedIds":[61],"ref":"المستدرك على الصحيحين 8853","srcLabel":"مسلم","text":["اللَّهمَّ بارِكْ لأهلِ المدينةِ في مُدِّهم وفي صاعِهم، وبارِكْ لهم في مَدينتِهم، اللَّهمَّ إنَّ إبراهيمَ عليه السَّلامُ عبْدُك وخَليلُك، وأنا عبْدُك ورَسولُك، وإنَّ إبراهيمَ سَألَك لِمكَّةَ وإنِّي أسْألُكَ للمدينةِ مِثلَ ما سَألَك إبراهيمُ لمكَّةَ ومِثلَه معه، ألَا إنَّ المدينةَ مُشْتبِكةٌ بالملائكةِ، على كلِّ نَقْبٍ منها مَلَكانِ يَحرُسانِها، لا يَدخُلُها الطَّاعونُ والدَّجَّالُ، ",["مَن أراد أهْلَها بسُوءٍ",1]," ",["أذابَه اللهُ كما يَذوبُ المِلحُ في الماءِ",2],"."],"grade":"صحيح","narrator":"سعد بن مالك، وأبو هُرَيرةَ","muhaddith":"صحيح على شرط مسلم، ولم يخرجاه","bab":"مناقب وفضائل › مكة شرفها الله تعالى","dorar":"TS965jeB","merged":6,"otherRefs":["سير أعلام النبلاء 9/105 (صحيح)","الترغيب والترهيب 2/219 (حسن)","صحيح مسلم 1386 (صحيح)","صحيح مسلم 1387 (صحيح)","تخريج المسند لشعيب 8373 (صحيح)"]},{"id":"س-02976","fp":"fbf00bc9e52b","stateId":749,"easy":"إذا هممت بالإلحاد في الحرم ← يذيقك الله عذاباً أليماً","cause":"هَمَّ فيه بإلحادٍ","result":"لأذاقهُ اللهُ عذابًا أليمًا","explicit":true,"otherNeedIds":[61],"ref":"المستدرك على الصحيحين 3506","srcLabel":"مسلم","text":["عنْ عبدِ اللهِ رَضيَ اللهُ عنه، رَفَعَهُ في قولِ اللهِ عزَّ وجلَّ: {وَمَنْ يُرِدْ فِيهِ بِإِلْحَادٍ بِظُلْمٍ نُذِقْهُ مِن عَذَابٍ أَلِيمٍ} [الحج: 25] قالَ: «لوْ أنَّ رَجلًا ",["هَمَّ فيه بإلحادٍ",1]," وهو بعَدَنِ أبْيَنَ ",["لأذاقهُ اللهُ عذابًا أليمًا",2],"»."],"grade":"صحيح","narrator":"مرة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أحمد (4316)، والطبري في ((تاريخه)) (16/ 508)، والدارقطني في ((علله)) (781) جميعهم بلفظ قريب.","bab":"إيمان › الوعيد","dorar":"ugYr7wrS","merged":3,"otherRefs":["الزواجر عن اقتراف الكبائر 1/201 (صحيح)","أضواء البيان 5/62 (صحيح)"]},{"id":"س-03607","fp":"c1e8aecb8f00","stateId":749,"easy":"إذا أطعت أميرك في معصية ← ما خرجت منها أبداً","cause":"لَو دخلتُموها","result":"ما خرجتُمْ منها أبدًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشاكر 2/47","srcLabel":"متفق عليه","text":["بعثَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ سريَّةً ، واستعملَ عليهِم رجلًا منَ الأنصارِ قالَ : فلمَّا خرجوا قالَ : وجدَ عليهِم في شيءٍ فقالَ : قالَ لَهُم : أليسَ قد أمرَكُم رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ أن تُطيعوني قالَ : قالوا : بلَى . قالَ : فقالَ : اجمَعوا حطبًا ، ثمَّ دعا بنارٍ فأضرمَها فيهِ ، ثمَّ قالَ : عزمتُ عليكُم : لتدخلنَّها . قالَ : فَهَمَّ القَومُ أن يدخُلوها ، قالَ : فقالَ لَهُم شابٌّ منهُم : إنَّما فرَرتُمْ إلى رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ منَ النَّارِ ، فلا تعجَلوا حتَّى تلْقوا النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ ، فإن أمرَكُم أن تدخُلوها فادخُلوا ، قالَ : فرجَعوا إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ فأخبروهُ ، فقالَ لَهُم : ",["لَو دخلتُموها",1]," ",["ما خرجتُمْ منها أبدًا",2]," ، إنَّما الطَّاعةُ في المعروفِ"],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (7257)، ومسلم (1840)، وأبو داود (2625) بنحوه.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"9l45XLe9","merged":6,"otherRefs":["المحلى 10/340 (صحيح)","البحر الزخار 2/203 (صحيح)","حلية الأولياء 5/44 (صحيح)","صحيح مسلم 1840 (صحيح)","صحيح أبي داود 2625 (صحيح)"]},{"id":"س-07465","fp":"84b888f1a85c","stateId":749,"easy":"إذا سعيت في الفتنة ← فويل لك من الله يوم القيامة","cause":"للسَّاعي فيها","result":"ويلٌ للسَّاعي فيها مِن اللهِ يومَ القيامةِ","explicit":true,"ref":"تخريج صحيح ابن حبان 6705","srcLabel":"متفق عليه","text":["ويلٌ للعرَبِ مِن شرٍّ قد اقتَرَب مِن فتنةٍ عَمياءَ صمَّاءَ بَكماءَ القاعدُ فيها خيرٌ مِن القائمِ والقائمُ فيها خيرٌ مِن الماشي والماشي فيها خيرٌ مِن السَّاعي ",["ويلٌ للسَّاعي فيها مِن اللهِ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (3601)، ومسلم (2886) مختصراً","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"OEOCu03P"},{"id":"س-02230","fp":"737366924511","stateId":749,"easy":"إذا أطعت في معصية الله ← هلكت (ما خرجوا منها أبداً)","cause":"لو دَخَلُوهَا","result":"ما خَرَجُوا منها أبَدًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح الجامع 2327","srcLabel":"متفق عليه","text":["إنما الطاعةُ في المعروفِ [يعني حديث: بَعَثَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ سَرِيَّةً، وأَمَّرَ عليهم رَجُلًا مِنَ الأنْصَارِ، وأَمَرَهُمْ أنْ يُطِيعُوهُ، فَغَضِبَ عليهم، وقالَ: أليسَ قدْ أمَرَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ أنْ تُطِيعُونِي؟ قالوا: بَلَى، قالَ: قدْ عَزَمْتُ علَيْكُم لَما جَمَعْتُمْ حَطَبًا، وأَوْقَدْتُمْ نَارًا، ثُمَّ دَخَلْتُمْ فِيهَا فَجَمَعُوا حَطَبًا، فأوْقَدُوا نَارًا، فَلَمَّا هَمُّوا بالدُّخُولِ، فَقَامَ يَنْظُرُ بَعْضُهُمْ إلى بَعْضٍ، قالَ بَعْضُهُمْ: إنَّما تَبِعْنَا النبيَّ صَلَّى اللهُ عليه وسلَّمَ فِرَارًا مِنَ النَّارِ أفَنَدْخُلُهَا؟ فَبيْنَما هُمْ كَذلكَ، إذْ خَمَدَتِ النَّارُ، وسَكَنَ غَضَبُهُ، فَذُكِرَ للنبيِّ صَلَّى اللهُ عليه وسلَّمَ، فَقالَ: ",["لو دَخَلُوهَا",1]," ",["ما خَرَجُوا منها أبَدًا",2],"، إنَّما الطَّاعَةُ في المَعروفِ.]"],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح","takhrij":"أخرجه البخاري (7257)، ومسلم (1840)، وأبو داود (2625) بلفظه تامًا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"zfmAtC4J","merged":3,"otherRefs":["تخريج المسند لشعيب 1018 (صحيح)","صحيح البخاري 4340 (صحيح)"]},{"id":"ق-0022","fp":"5dfd40ec2b01","stateId":749,"easy":"تحريف الكتاب والتكسّب به ← الويل","cause":"تحريف الكتاب والتكسّب به","result":"الويل","explicit":true,"ref":"سورة البقرة: 79","srcLabel":"القرآن الكريم","quran":{"s":2,"from":79,"to":79,"text":"فَوَيْلٌ لِلَّذِينَ يَكْتُبُونَ الْكِتَابَ بِأَيْدِيهِمْ ثُمَّ يَقُولُونَ هَذَا مِنْ عِنْدِ اللَّهِ لِيَشْتَرُوا بِهِ ثَمَنًا قَلِيلًا فَوَيْلٌ لَهُمْ مِمَّا كَتَبَتْ أَيْدِيهِمْ وَوَيْلٌ لَهُمْ مِمَّا يَكْسِبُونَ (79)","hl":[[0,178,1]]}},{"id":"ق-0060","fp":"54f3023de639","stateId":749,"easy":"الاعتداء بعد العفو وأخذ الدية ← عذاب أليم","cause":"الاعتداء بعد العفو وأخذ الدية","result":"عذاب أليم","explicit":true,"ref":"سورة البقرة: 178","srcLabel":"القرآن الكريم","quran":{"s":2,"from":178,"to":178,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا كُتِبَ عَلَيْكُمُ الْقِصَاصُ فِي الْقَتْلَى الْحُرُّ بِالْحُرِّ وَالْعَبْدُ بِالْعَبْدِ وَالْأُنْثَى بِالْأُنْثَى فَمَنْ عُفِيَ لَهُ مِنْ أَخِيهِ شَيْءٌ فَاتِّبَاعٌ بِالْمَعْرُوفِ وَأَدَاءٌ إِلَيْهِ بِإِحْسَانٍ ذَلِكَ تَخْفِيفٌ مِنْ رَبِّكُمْ وَرَحْمَةٌ فَمَنِ اعْتَدَى بَعْدَ ذَلِكَ فَلَهُ عَذَابٌ أَلِيمٌ (178)","hl":[[285,337,1]]}},{"id":"ق-0076","fp":"ce8798fcd4df","stateId":749,"easy":"الإفساد في الأرض والعزّة بالإثم عند النصيحة ← جهنم وبئس المهاد","cause":"الإفساد في الأرض والعزّة بالإثم عند النصيحة","result":"جهنم وبئس المهاد","explicit":true,"ref":"سورة البقرة: 204–206","srcLabel":"القرآن الكريم","quran":{"s":2,"from":204,"to":206,"text":"وَمِنَ النَّاسِ مَنْ يُعْجِبُكَ قَوْلُهُ فِي الْحَيَاةِ الدُّنْيَا وَيُشْهِدُ اللَّهَ عَلَى مَا فِي قَلْبِهِ وَهُوَ أَلَدُّ الْخِصَامِ (204) وَإِذَا تَوَلَّى سَعَى فِي الْأَرْضِ لِيُفْسِدَ فِيهَا وَيُهْلِكَ الْحَرْثَ وَالنَّسْلَ وَاللَّهُ لَا يُحِبُّ الْفَسَادَ (205) وَإِذَا قِيلَ لَهُ اتَّقِ اللَّهَ أَخَذَتْهُ الْعِزَّةُ بِالْإِثْمِ فَحَسْبُهُ جَهَنَّمُ وَلَبِئْسَ الْمِهَادُ (206)","hl":[[0,378,1]]}},{"id":"ق-0206","fp":"328a93a500f6","stateId":749,"easy":"معصية الله ورسوله وتعدّي حدوده ← نار خالداً فيها وعذاب مهين","cause":"معصية الله ورسوله وتعدّي حدوده","result":"نار خالداً فيها وعذاب مهين","explicit":true,"similar":["ق-1388"],"ref":"سورة النساء: 14","srcLabel":"القرآن الكريم","quran":{"s":4,"from":14,"to":14,"text":"وَمَنْ يَعْصِ اللَّهَ وَرَسُولَهُ وَيَتَعَدَّ حُدُودَهُ يُدْخِلْهُ نَارًا خَالِدًا فِيهَا وَلَهُ عَذَابٌ مُهِينٌ (14)","hl":[[0,112,1]]}},{"id":"ق-0252","fp":"c1af465dc15b","stateId":749,"easy":"عمل السوء ← يُجزى به ولا وليّ ولا نصير","cause":"عمل السوء","result":"يُجزى به ولا وليّ ولا نصير","explicit":true,"otherNeedIds":[56],"ref":"سورة النساء: 123","srcLabel":"القرآن الكريم","quran":{"s":4,"from":123,"to":123,"text":"لَيْسَ بِأَمَانِيِّكُمْ وَلَا أَمَانِيِّ أَهْلِ الْكِتَابِ مَنْ يَعْمَلْ سُوءًا يُجْزَ بِهِ وَلَا يَجِدْ لَهُ مِنْ دُونِ اللَّهِ وَلِيًّا وَلَا نَصِيرًا (123)","hl":[[59,152,1]]}},{"id":"ق-0337","fp":"ae4ef07a484b","stateId":749,"easy":"الاعتداء بعد النهي ← عذاب أليم","cause":"الاعتداء بعد النهي","result":"عذاب أليم","explicit":true,"ref":"سورة المائدة: 94","srcLabel":"القرآن الكريم","quran":{"s":5,"from":94,"to":94,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَيَبْلُوَنَّكُمُ اللَّهُ بِشَيْءٍ مِنَ الصَّيْدِ تَنَالُهُ أَيْدِيكُمْ وَرِمَاحُكُمْ لِيَعْلَمَ اللَّهُ مَنْ يَخَافُهُ بِالْغَيْبِ فَمَنِ اعْتَدَى بَعْدَ ذَلِكَ فَلَهُ عَذَابٌ أَلِيمٌ (94)","hl":[[163,215,1]]}},{"id":"ق-0348","fp":"2b91629ed464","stateId":749,"easy":"معصية الله ← عذاب يوم عظيم","cause":"معصية الله","result":"عذاب يوم عظيم","explicit":true,"ref":"سورة الأنعام: 15","srcLabel":"القرآن الكريم","quran":{"s":6,"from":15,"to":15,"text":"قُلْ إِنِّي أَخَافُ إِنْ عَصَيْتُ رَبِّي عَذَابَ يَوْمٍ عَظِيمٍ (15)","hl":[[5,63,1]]}},{"id":"ق-0554","fp":"b1c8fcae1d42","stateId":749,"easy":"كسب السيئات ← جزاء سيئة بمثلها وذلة ولا عاصم من الله والخلود في النار","cause":"كسب السيئات","result":"جزاء سيئة بمثلها وذلة ولا عاصم من الله والخلود في النار","explicit":true,"ref":"سورة يونس: 27","srcLabel":"القرآن الكريم","quran":{"s":10,"from":27,"to":27,"text":"وَالَّذِينَ كَسَبُوا السَّيِّئَاتِ جَزَاءُ سَيِّئَةٍ بِمِثْلِهَا وَتَرْهَقُهُمْ ذِلَّةٌ مَا لَهُمْ مِنَ اللَّهِ مِنْ عَاصِمٍ كَأَنَّمَا أُغْشِيَتْ وُجُوهُهُمْ قِطَعًا مِنَ اللَّيْلِ مُظْلِمًا أُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ (27)","hl":[[0,243,1]]}},{"id":"ق-0598","fp":"8b7912c538d9","stateId":749,"easy":"الركون إلى الظالمين ← مسّ النار وفقد الولاية والنصر","cause":"الركون إلى الظالمين","result":"مسّ النار وفقد الولاية والنصر","explicit":true,"otherNeedIds":[60],"ref":"سورة هود: 113","srcLabel":"القرآن الكريم","quran":{"s":11,"from":113,"to":113,"text":"وَلَا تَرْكَنُوا إِلَى الَّذِينَ ظَلَمُوا فَتَمَسَّكُمُ النَّارُ وَمَا لَكُمْ مِنْ دُونِ اللَّهِ مِنْ أَوْلِيَاءَ ثُمَّ لَا تُنْصَرُونَ (113)","hl":[[0,135,1]]}},{"id":"ق-0644","fp":"c0c7f8e48eb6","stateId":749,"easy":"الظلم ← عذاب أليم","cause":"الظلم","result":"عذاب أليم","explicit":true,"similar":["ق-0738","ق-0874","ق-1016","ق-1150","ق-1163","ق-1171","ق-1266","ق-1403"],"ref":"سورة إبراهيم: 22","srcLabel":"القرآن الكريم","quran":{"s":14,"from":22,"to":22,"text":"وَقَالَ الشَّيْطَانُ لَمَّا قُضِيَ الْأَمْرُ إِنَّ اللَّهَ وَعَدَكُمْ وَعْدَ الْحَقِّ وَوَعَدْتُكُمْ فَأَخْلَفْتُكُمْ وَمَا كَانَ لِيَ عَلَيْكُمْ مِنْ سُلْطَانٍ إِلَّا أَنْ دَعَوْتُكُمْ فَاسْتَجَبْتُمْ لِي فَلَا تَلُومُونِي وَلُومُوا أَنْفُسَكُمْ مَا أَنَا بِمُصْرِخِكُمْ وَمَا أَنْتُمْ بِمُصْرِخِيَّ إِنِّي كَفَرْتُ بِمَا أَشْرَكْتُمُونِ مِنْ قَبْلُ إِنَّ الظَّالِمِينَ لَهُمْ عَذَابٌ أَلِيمٌ (22)","hl":[[351,393,1]]}},{"id":"ق-0652","fp":"e79f5c90d57c","stateId":749,"easy":"الظلم ← الإمهال ليوم تشخص فيه الأبصار","cause":"الظلم","result":"الإمهال ليوم تشخص فيه الأبصار","explicit":true,"otherNeedIds":[56],"ref":"سورة إبراهيم: 42","srcLabel":"القرآن الكريم","quran":{"s":14,"from":42,"to":42,"text":"وَلَا تَحْسَبَنَّ اللَّهَ غَافِلًا عَمَّا يَعْمَلُ الظَّالِمُونَ إِنَّمَا يُؤَخِّرُهُمْ لِيَوْمٍ تَشْخَصُ فِيهِ الْأَبْصَارُ (42)","hl":[[0,124,1]]}},{"id":"ق-0716","fp":"21f41882fb83","stateId":749,"easy":"الركون إلى أهل الباطل ← ضعف الحياة وضعف الممات ولا نصير","cause":"الركون إلى أهل الباطل","result":"ضعف الحياة وضعف الممات ولا نصير","explicit":true,"otherNeedIds":[60],"ref":"سورة الإسراء: 74–75","srcLabel":"القرآن الكريم","quran":{"s":17,"from":74,"to":75,"text":"وَلَوْلَا أَنْ ثَبَّتْنَاكَ لَقَدْ كِدْتَ تَرْكَنُ إِلَيْهِمْ شَيْئًا قَلِيلًا (74) إِذًا لَأَذَقْنَاكَ ضِعْفَ الْحَيَاةِ وَضِعْفَ الْمَمَاتِ ثُمَّ لَا تَجِدُ لَكَ عَلَيْنَا نَصِيرًا (75)","hl":[[0,182,1]]}},{"id":"ق-0728","fp":"b36af7b6e13c","stateId":749,"easy":"الظلم ← نار أحاط بهم سرادقها وماء كالمهل","cause":"الظلم","result":"نار أحاط بهم سرادقها وماء كالمهل","explicit":true,"ref":"سورة الكهف: 29","srcLabel":"القرآن الكريم","quran":{"s":18,"from":29,"to":29,"text":"وَقُلِ الْحَقُّ مِنْ رَبِّكُمْ فَمَنْ شَاءَ فَلْيُؤْمِنْ وَمَنْ شَاءَ فَلْيَكْفُرْ إِنَّا أَعْتَدْنَا لِلظَّالِمِينَ نَارًا أَحَاطَ بِهِمْ سُرَادِقُهَا وَإِنْ يَسْتَغِيثُوا يُغَاثُوا بِمَاءٍ كَالْمُهْلِ يَشْوِي الْوُجُوهَ بِئْسَ الشَّرَابُ وَسَاءَتْ مُرْتَفَقًا (29)","hl":[[83,261,1]]}},{"id":"ق-0738","fp":"ee9893b74224","stateId":749,"easy":"الظلم ← العذاب في الدنيا ثم عذاب نُكر عند الله","cause":"الظلم","result":"العذاب في الدنيا ثم عذاب نُكر عند الله","explicit":true,"repOf":"ق-0644","otherNeedIds":[56],"ref":"سورة الكهف: 87","quran":{"s":18,"from":87,"to":87,"text":"قَالَ أَمَّا مَنْ ظَلَمَ فَسَوْفَ نُعَذِّبُهُ ثُمَّ يُرَدُّ إِلَى رَبِّهِ فَيُعَذِّبُهُ عَذَابًا نُكْرًا (87)","hl":[[13,104,1]]}},{"id":"ق-0752","fp":"011e79483935","stateId":749,"easy":"الظلم ← البقاء في النار جثياً","cause":"الظلم","result":"البقاء في النار جثياً","explicit":true,"ref":"سورة مريم: 72","srcLabel":"القرآن الكريم","quran":{"s":19,"from":72,"to":72,"text":"ثُمَّ نُنَجِّي الَّذِينَ اتَّقَوْا وَنَذَرُ الظَّالِمِينَ فِيهَا جِثِيًّا (72)","hl":[[35,73,1]]}},{"id":"ق-0758","fp":"424646ee45bc","stateId":749,"easy":"الإجرام ← السَّوق إلى جهنم ورداً","cause":"الإجرام","result":"السَّوق إلى جهنم ورداً","explicit":true,"ref":"سورة مريم: 86","srcLabel":"القرآن الكريم","quran":{"s":19,"from":86,"to":86,"text":"وَنَسُوقُ الْمُجْرِمِينَ إِلَى جَهَنَّمَ وِرْدًا (86)","hl":[[0,48,1]]}},{"id":"ق-0769","fp":"1f98b8746c85","stateId":749,"easy":"إتيان الله مجرماً ← جهنم لا يموت فيها ولا يحيى","cause":"إتيان الله مجرماً","result":"جهنم لا يموت فيها ولا يحيى","explicit":true,"ref":"سورة طه: 74","srcLabel":"القرآن الكريم","quran":{"s":20,"from":74,"to":74,"text":"إِنَّهُ مَنْ يَأْتِ رَبَّهُ مُجْرِمًا فَإِنَّ لَهُ جَهَنَّمَ لَا يَمُوتُ فِيهَا وَلَا يَحْيَى (74)","hl":[[8,93,1]]}},{"id":"ق-0808","fp":"f938ac1e5740","stateId":749,"easy":"الإلحاد بظلم في الحرم والصد عن سبيل الله ← عذاب أليم","cause":"الإلحاد بظلم في الحرم والصد عن سبيل الله","result":"عذاب أليم","explicit":true,"ref":"سورة الحج: 25","srcLabel":"القرآن الكريم","quran":{"s":22,"from":25,"to":25,"text":"إِنَّ الَّذِينَ كَفَرُوا وَيَصُدُّونَ عَنْ سَبِيلِ اللَّهِ وَالْمَسْجِدِ الْحَرَامِ الَّذِي جَعَلْنَاهُ لِلنَّاسِ سَوَاءً الْعَاكِفُ فِيهِ وَالْبَادِ وَمَنْ يُرِدْ فِيهِ بِإِلْحَادٍ بِظُلْمٍ نُذِقْهُ مِنْ عَذَابٍ أَلِيمٍ (25)","hl":[[0,220,1]]}},{"id":"ق-0874","fp":"9c16471e4540","stateId":749,"easy":"الظلم ← عذاب كبير","cause":"الظلم","result":"عذاب كبير","explicit":true,"repOf":"ق-0644","ref":"سورة الفرقان: 19","quran":{"s":25,"from":19,"to":19,"text":"فَقَدْ كَذَّبُوكُمْ بِمَا تَقُولُونَ فَمَا تَسْتَطِيعُونَ صَرْفًا وَلَا نَصْرًا وَمَنْ يَظْلِمْ مِنْكُمْ نُذِقْهُ عَذَابًا كَبِيرًا (19)","hl":[[80,131,1]]}},{"id":"ق-0909","fp":"0a8e24685a0a","stateId":749,"easy":"المجيء بالسيئة ← كبّ الوجوه في النار","cause":"المجيء بالسيئة","result":"كبّ الوجوه في النار","explicit":true,"ref":"سورة النمل: 90","srcLabel":"القرآن الكريم","quran":{"s":27,"from":90,"to":90,"text":"وَمَنْ جَاءَ بِالسَّيِّئَةِ فَكُبَّتْ وُجُوهُهُمْ فِي النَّارِ هَلْ تُجْزَوْنَ إِلَّا مَا كُنْتُمْ تَعْمَلُونَ (90)","hl":[[0,110,1]]}},{"id":"ق-0980","fp":"8cddc5bbbced","stateId":749,"easy":"الفسق ← مأواهم النار كلما أرادوا الخروج أعيدوا","cause":"الفسق","result":"مأواهم النار كلما أرادوا الخروج أعيدوا","explicit":true,"ref":"سورة السجدة: 20","srcLabel":"القرآن الكريم","quran":{"s":32,"from":20,"to":20,"text":"وَأَمَّا الَّذِينَ فَسَقُوا فَمَأْوَاهُمُ النَّارُ كُلَّمَا أَرَادُوا أَنْ يَخْرُجُوا مِنْهَا أُعِيدُوا فِيهَا وَقِيلَ لَهُمْ ذُوقُوا عَذَابَ النَّارِ الَّذِي كُنْتُمْ بِهِ تُكَذِّبُونَ (20)","hl":[[0,185,1]]}},{"id":"ق-1008","fp":"44ca0bdd0e3f","stateId":749,"easy":"الزيغ عن أمر الله ← عذاب السعير","cause":"الزيغ عن أمر الله","result":"عذاب السعير","explicit":true,"ref":"سورة سبأ: 12","srcLabel":"القرآن الكريم","quran":{"s":34,"from":12,"to":12,"text":"وَلِسُلَيْمَانَ الرِّيحَ غُدُوُّهَا شَهْرٌ وَرَوَاحُهَا شَهْرٌ وَأَسَلْنَا لَهُ عَيْنَ الْقِطْرِ وَمِنَ الْجِنِّ مَنْ يَعْمَلُ بَيْنَ يَدَيْهِ بِإِذْنِ رَبِّهِ وَمَنْ يَزِغْ مِنْهُمْ عَنْ أَمْرِنَا نُذِقْهُ مِنْ عَذَابِ السَّعِيرِ (12)","hl":[[160,230,1]]}},{"id":"ق-1016","fp":"d1293febf1ab","stateId":749,"easy":"الظلم ← عذاب النار","cause":"الظلم","result":"عذاب النار","explicit":true,"repOf":"ق-0644","ref":"سورة سبأ: 42","quran":{"s":34,"from":42,"to":42,"text":"فَالْيَوْمَ لَا يَمْلِكُ بَعْضُكُمْ لِبَعْضٍ نَفْعًا وَلَا ضَرًّا وَنَقُولُ لِلَّذِينَ ظَلَمُوا ذُوقُوا عَذَابَ النَّارِ الَّتِي كُنْتُمْ بِهَا تُكَذِّبُونَ (42)","hl":[[76,156,1]]}},{"id":"ق-1023","fp":"e0e76ff13a75","stateId":749,"easy":"مكر السيئات ← عذاب شديد وبوار المكر","cause":"مكر السيئات","result":"عذاب شديد وبوار المكر","explicit":true,"otherNeedIds":[57],"ref":"سورة فاطر: 10","srcLabel":"القرآن الكريم","quran":{"s":35,"from":10,"to":10,"text":"مَنْ كَانَ يُرِيدُ الْعِزَّةَ فَلِلَّهِ الْعِزَّةُ جَمِيعًا إِلَيْهِ يَصْعَدُ الْكَلِمُ الطَّيِّبُ وَالْعَمَلُ الصَّالِحُ يَرْفَعُهُ وَالَّذِينَ يَمْكُرُونَ السَّيِّئَاتِ لَهُمْ عَذَابٌ شَدِيدٌ وَمَكْرُ أُولَئِكَ هُوَ يَبُورُ (10)","hl":[[133,225,1]]}},{"id":"ق-1067","fp":"acd7c05c763e","stateId":749,"easy":"الطغيان ← شر مآب: جهنم","cause":"الطغيان","result":"شر مآب: جهنم","explicit":true,"ref":"سورة ص: 55–56","srcLabel":"القرآن الكريم","quran":{"s":38,"from":55,"to":56,"text":"هَذَا وَإِنَّ لِلطَّاغِينَ لَشَرَّ مَآبٍ (55) جَهَنَّمَ يَصْلَوْنَهَا فَبِئْسَ الْمِهَادُ (56)","hl":[[6,89,1]]}},{"id":"ق-1092","fp":"3f47d20c5ec8","stateId":749,"easy":"الظلم ← لا تقبل الفدية وبدا لهم من الله ما لم يحتسبوا","cause":"الظلم","result":"لا تقبل الفدية وبدا لهم من الله ما لم يحتسبوا","explicit":true,"ref":"سورة الزمر: 47–48","srcLabel":"القرآن الكريم","quran":{"s":39,"from":47,"to":48,"text":"وَلَوْ أَنَّ لِلَّذِينَ ظَلَمُوا مَا فِي الْأَرْضِ جَمِيعًا وَمِثْلَهُ مَعَهُ لَافْتَدَوْا بِهِ مِنْ سُوءِ الْعَذَابِ يَوْمَ الْقِيَامَةِ وَبَدَا لَهُمْ مِنَ اللَّهِ مَا لَمْ يَكُونُوا يَحْتَسِبُونَ (47) وَبَدَا لَهُمْ سَيِّئَاتُ مَا كَسَبُوا وَحَاقَ بِهِمْ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ (48)","hl":[[0,290,1]]}},{"id":"ق-1106","fp":"15d056cc7a30","stateId":749,"easy":"الظلم ← لا حميم ولا شفيع يطاع","cause":"الظلم","result":"لا حميم ولا شفيع يطاع","explicit":true,"otherNeedIds":[60],"ref":"سورة غافر: 18","srcLabel":"القرآن الكريم","quran":{"s":40,"from":18,"to":18,"text":"وَأَنْذِرْهُمْ يَوْمَ الْآزِفَةِ إِذِ الْقُلُوبُ لَدَى الْحَنَاجِرِ كَاظِمِينَ مَا لِلظَّالِمِينَ مِنْ حَمِيمٍ وَلَا شَفِيعٍ يُطَاعُ (18)","hl":[[79,132,1]]}},{"id":"ق-1150","fp":"dfca7a36abbf","stateId":749,"easy":"الظلم ← عذاب أليم","cause":"الظلم","result":"عذاب أليم","explicit":true,"repOf":"ق-0644","ref":"سورة الشورى: 21","quran":{"s":42,"from":21,"to":21,"text":"أَمْ لَهُمْ شُرَكَاءُ شَرَعُوا لَهُمْ مِنَ الدِّينِ مَا لَمْ يَأْذَنْ بِهِ اللَّهُ وَلَوْلَا كَلِمَةُ الْفَصْلِ لَقُضِيَ بَيْنَهُمْ وَإِنَّ الظَّالِمِينَ لَهُمْ عَذَابٌ أَلِيمٌ (21)","hl":[[132,176,1]]}},{"id":"ق-1161","fp":"97c91d5078d2","stateId":749,"easy":"ظلم الناس والبغي في الأرض بغير الحق ← عذاب أليم","cause":"ظلم الناس والبغي في الأرض بغير الحق","result":"عذاب أليم","explicit":true,"ref":"سورة الشورى: 42","srcLabel":"القرآن الكريم","quran":{"s":42,"from":42,"to":42,"text":"إِنَّمَا السَّبِيلُ عَلَى الَّذِينَ يَظْلِمُونَ النَّاسَ وَيَبْغُونَ فِي الْأَرْضِ بِغَيْرِ الْحَقِّ أُولَئِكَ لَهُمْ عَذَابٌ أَلِيمٌ (42)","hl":[[26,133,1]]}},{"id":"ق-1163","fp":"3c662034237f","stateId":749,"easy":"الظلم ← عذاب مقيم ولا أولياء ينصرونهم","cause":"الظلم","result":"عذاب مقيم ولا أولياء ينصرونهم","explicit":true,"repOf":"ق-0644","otherNeedIds":[60],"ref":"سورة الشورى: 45–46","quran":{"s":42,"from":45,"to":46,"text":"وَتَرَاهُمْ يُعْرَضُونَ عَلَيْهَا خَاشِعِينَ مِنَ الذُّلِّ يَنْظُرُونَ مِنْ طَرْفٍ خَفِيٍّ وَقَالَ الَّذِينَ آمَنُوا إِنَّ الْخَاسِرِينَ الَّذِينَ خَسِرُوا أَنْفُسَهُمْ وَأَهْلِيهِمْ يَوْمَ الْقِيَامَةِ أَلَا إِنَّ الظَّالِمِينَ فِي عَذَابٍ مُقِيمٍ (45) وَمَا كَانَ لَهُمْ مِنْ أَوْلِيَاءَ يَنْصُرُونَهُمْ مِنْ دُونِ اللَّهِ وَمَنْ يُضْلِلِ اللَّهُ فَمَا لَهُ مِنْ سَبِيلٍ (46)","hl":[[203,324,1]]}},{"id":"ق-1171","fp":"52ac3bd4cca1","stateId":749,"easy":"الظلم ← ويل من عذاب يوم أليم","cause":"الظلم","result":"ويل من عذاب يوم أليم","explicit":true,"repOf":"ق-0644","ref":"سورة الزخرف: 65","quran":{"s":43,"from":65,"to":65,"text":"فَاخْتَلَفَ الْأَحْزَابُ مِنْ بَيْنِهِمْ فَوَيْلٌ لِلَّذِينَ ظَلَمُوا مِنْ عَذَابِ يَوْمٍ أَلِيمٍ (65)","hl":[[41,97,1]]}},{"id":"ق-1175","fp":"f289f814334c","stateId":749,"easy":"الإجرام ← الخلود في عذاب جهنم لا يُفتَّر عنهم","cause":"الإجرام","result":"الخلود في عذاب جهنم لا يُفتَّر عنهم","explicit":true,"ref":"سورة الزخرف: 74–75","srcLabel":"القرآن الكريم","quran":{"s":43,"from":74,"to":75,"text":"إِنَّ الْمُجْرِمِينَ فِي عَذَابِ جَهَنَّمَ خَالِدُونَ (74) لَا يُفَتَّرُ عَنْهُمْ وَهُمْ فِيهِ مُبْلِسُونَ (75)","hl":[[0,106,1]]}},{"id":"ق-1180","fp":"f9b6533da327","stateId":749,"easy":"الإثم ← شجرة الزقوم والحميم","cause":"الإثم","result":"شجرة الزقوم والحميم","explicit":true,"ref":"سورة الدخان: 43–50","srcLabel":"القرآن الكريم","quran":{"s":44,"from":43,"to":50,"text":"إِنَّ شَجَرَتَ الزَّقُّومِ (43) طَعَامُ الْأَثِيمِ (44) كَالْمُهْلِ يَغْلِي فِي الْبُطُونِ (45) كَغَلْيِ الْحَمِيمِ (46) خُذُوهُ فَاعْتِلُوهُ إِلَى سَوَاءِ الْجَحِيمِ (47) ثُمَّ صُبُّوا فَوْقَ رَأْسِهِ مِنْ عَذَابِ الْحَمِيمِ (48) ذُقْ إِنَّكَ أَنْتَ الْعَزِيزُ الْكَرِيمُ (49) إِنَّ هَذَا مَا كُنْتُمْ بِهِ تَمْتَرُونَ (50)","hl":[[0,319,1]]}},{"id":"ق-1266","fp":"bb1b4334e668","stateId":749,"easy":"الظلم ← نصيب من العذاب مثل نصيب أصحابهم","cause":"الظلم","result":"نصيب من العذاب مثل نصيب أصحابهم","explicit":true,"repOf":"ق-0644","otherNeedIds":[56],"ref":"سورة الذاريات: 59","quran":{"s":51,"from":59,"to":59,"text":"فَإِنَّ لِلَّذِينَ ظَلَمُوا ذَنُوبًا مِثْلَ ذَنُوبِ أَصْحَابِهِمْ فَلَا يَسْتَعْجِلُونِ (59)","hl":[[8,87,1]]}},{"id":"ق-1273","fp":"4088ef5e1ad1","stateId":749,"easy":"الإساءة ← الجزاء بما عملوا","cause":"الإساءة","result":"الجزاء بما عملوا","explicit":true,"ref":"سورة النجم: 31","srcLabel":"القرآن الكريم","quran":{"s":53,"from":31,"to":31,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ لِيَجْزِيَ الَّذِينَ أَسَاءُوا بِمَا عَمِلُوا وَيَجْزِيَ الَّذِينَ أَحْسَنُوا بِالْحُسْنَى (31)","hl":[[52,97,1]]}},{"id":"ق-1284","fp":"c3271736ceb0","stateId":749,"easy":"الإجرام ← ضلال وسُعر والسحب في النار على الوجوه","cause":"الإجرام","result":"ضلال وسُعر والسحب في النار على الوجوه","explicit":true,"ref":"سورة القمر: 47–48","srcLabel":"القرآن الكريم","quran":{"s":54,"from":47,"to":48,"text":"إِنَّ الْمُجْرِمِينَ فِي ضَلَالٍ وَسُعُرٍ (47) يَوْمَ يُسْحَبُونَ فِي النَّارِ عَلَى وُجُوهِهِمْ ذُوقُوا مَسَّ سَقَرَ (48)","hl":[[0,117,1]]}},{"id":"ق-1286","fp":"2d0da4c618d8","stateId":749,"easy":"الإجرام ← الأخذ بالنواصي والأقدام","cause":"الإجرام","result":"الأخذ بالنواصي والأقدام","explicit":true,"ref":"سورة الرحمن: 41","srcLabel":"القرآن الكريم","quran":{"s":55,"from":41,"to":41,"text":"يُعْرَفُ الْمُجْرِمُونَ بِسِيمَاهُمْ فَيُؤْخَذُ بِالنَّوَاصِي وَالْأَقْدَامِ (41)","hl":[[0,76,1]]}},{"id":"ق-1291","fp":"267cfd4492a5","stateId":749,"easy":"الترف والإصرار على الحنث العظيم وإنكار البعث ← سَموم وحميم وظل من يحموم","cause":"الترف والإصرار على الحنث العظيم وإنكار البعث","result":"سَموم وحميم وظل من يحموم","explicit":true,"ref":"سورة الواقعة: 41–47","srcLabel":"القرآن الكريم","quran":{"s":56,"from":41,"to":47,"text":"وَأَصْحَابُ الشِّمَالِ مَا أَصْحَابُ الشِّمَالِ (41) فِي سَمُومٍ وَحَمِيمٍ (42) وَظِلٍّ مِنْ يَحْمُومٍ (43) لَا بَارِدٍ وَلَا كَرِيمٍ (44) إِنَّهُمْ كَانُوا قَبْلَ ذَلِكَ مُتْرَفِينَ (45) وَكَانُوا يُصِرُّونَ عَلَى الْحِنْثِ الْعَظِيمِ (46) وَكَانُوا يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا أَإِنَّا لَمَبْعُوثُونَ (47)","hl":[[0,330,1]]}},{"id":"ق-1310","fp":"7c515d2bc1b2","stateId":749,"easy":"التناجي بالإثم والعدوان ومعصية الرسول ← حسبهم جهنم","cause":"التناجي بالإثم والعدوان ومعصية الرسول","result":"حسبهم جهنم","explicit":true,"ref":"سورة المجادلة: 8","srcLabel":"القرآن الكريم","quran":{"s":58,"from":8,"to":8,"text":"أَلَمْ تَرَ إِلَى الَّذِينَ نُهُوا عَنِ النَّجْوَى ثُمَّ يَعُودُونَ لِمَا نُهُوا عَنْهُ وَيَتَنَاجَوْنَ بِالْإِثْمِ وَالْعُدْوَانِ وَمَعْصِيَتِ الرَّسُولِ وَإِذَا جَاءُوكَ حَيَّوْكَ بِمَا لَمْ يُحَيِّكَ بِهِ اللَّهُ وَيَقُولُونَ فِي أَنْفُسِهِمْ لَوْلَا يُعَذِّبُنَا اللَّهُ بِمَا نَقُولُ حَسْبُهُمْ جَهَنَّمُ يَصْلَوْنَهَا فَبِئْسَ الْمَصِيرُ (8)","hl":[[88,343,1]]}},{"id":"ق-1385","fp":"d2563d63252f","stateId":749,"easy":"القسوط (الجور عن الحق) ← حطب لجهنم","cause":"القسوط (الجور عن الحق)","result":"حطب لجهنم","explicit":true,"ref":"سورة الجن: 15","srcLabel":"القرآن الكريم","quran":{"s":72,"from":15,"to":15,"text":"وَأَمَّا الْقَاسِطُونَ فَكَانُوا لِجَهَنَّمَ حَطَبًا (15)","hl":[[0,52,1]]}},{"id":"ق-1388","fp":"a894e64a0266","stateId":749,"easy":"معصية الله ورسوله ← نار جهنم خالدين فيها أبداً","cause":"معصية الله ورسوله","result":"نار جهنم خالدين فيها أبداً","explicit":true,"repOf":"ق-0206","ref":"سورة الجن: 23","quran":{"s":72,"from":23,"to":23,"text":"إِلَّا بَلَاغًا مِنَ اللَّهِ وَرِسَالَاتِهِ وَمَنْ يَعْصِ اللَّهَ وَرَسُولَهُ فَإِنَّ لَهُ نَارَ جَهَنَّمَ خَالِدِينَ فِيهَا أَبَدًا (23)","hl":[[44,132,1]]}},{"id":"ق-1403","fp":"740865a8bd1c","stateId":749,"easy":"الظلم ← عذاب أليم","cause":"الظلم","result":"عذاب أليم","explicit":true,"repOf":"ق-0644","ref":"سورة الإنسان: 31","quran":{"s":76,"from":31,"to":31,"text":"يُدْخِلُ مَنْ يَشَاءُ فِي رَحْمَتِهِ وَالظَّالِمِينَ أَعَدَّ لَهُمْ عَذَابًا أَلِيمًا (31)","hl":[[37,85,1]]}},{"id":"ق-1407","fp":"847febd57684","stateId":749,"easy":"الإجرام ← متاع قليل","cause":"الإجرام","result":"متاع قليل","explicit":true,"ref":"سورة المرسلات: 46","srcLabel":"القرآن الكريم","quran":{"s":77,"from":46,"to":46,"text":"كُلُوا وَتَمَتَّعُوا قَلِيلًا إِنَّكُمْ مُجْرِمُونَ (46)","hl":[[0,51,1]]}},{"id":"ق-1409","fp":"09c4aba010e0","stateId":749,"easy":"الطغيان وعدم رجاء الحساب والتكذيب بالآيات ← جهنم مرصاداً أحقاباً وزيادة العذاب","cause":"الطغيان وعدم رجاء الحساب والتكذيب بالآيات","result":"جهنم مرصاداً أحقاباً وزيادة العذاب","explicit":true,"ref":"سورة النبأ: 21–30","srcLabel":"القرآن الكريم","quran":{"s":78,"from":21,"to":30,"text":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا (21) لِلطَّاغِينَ مَآبًا (22) لَابِثِينَ فِيهَا أَحْقَابًا (23) لَا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا (24) إِلَّا حَمِيمًا وَغَسَّاقًا (25) جَزَاءً وِفَاقًا (26) إِنَّهُمْ كَانُوا لَا يَرْجُونَ حِسَابًا (27) وَكَذَّبُوا بِآيَاتِنَا كِذَّابًا (28) وَكُلَّ شَيْءٍ أَحْصَيْنَاهُ كِتَابًا (29) فَذُوقُوا فَلَنْ نَزِيدَكُمْ إِلَّا عَذَابًا (30)","hl":[[0,376,1]]}},{"id":"ق-1412","fp":"047d6598678c","stateId":749,"easy":"الطغيان وإيثار الحياة الدنيا ← الجحيم هي المأوى","cause":"الطغيان وإيثار الحياة الدنيا","result":"الجحيم هي المأوى","explicit":true,"ref":"سورة النازعات: 37–39","srcLabel":"القرآن الكريم","quran":{"s":79,"from":37,"to":39,"text":"فَأَمَّا مَنْ طَغَى (37) وَآثَرَ الْحَيَاةَ الدُّنْيَا (38) فَإِنَّ الْجَحِيمَ هِيَ الْمَأْوَى (39)","hl":[[0,94,1]]}},{"id":"ق-1416","fp":"754aa7fe46fa","stateId":749,"easy":"الفجور ← الجحيم","cause":"الفجور","result":"الجحيم","explicit":true,"ref":"سورة الانفطار: 14","srcLabel":"القرآن الكريم","quran":{"s":82,"from":14,"to":14,"text":"وَإِنَّ الْفُجَّارَ لَفِي جَحِيمٍ (14)","hl":[[0,33,1]]}},{"id":"س-07876","fp":"4e846a73de8a","stateId":749,"easy":"إذا أردت أهل المدينة بسوء ← يذيبك الله في النار ذوب الرصاص","cause":"ولا يُريدُ أحَدٌ أهلَ المَدينةِ بسوءٍ","result":"إلَّا أذابَه اللهُ في النَّارِ ذَوبَ الرَّصاصِ، أو ذَوبَ المِلحِ في الماءِ","explicit":true,"repOf":"س-08441","otherNeedIds":[28,52],"ref":"صحيح مسلم 1363","text":["إنِّي أُحَرِّمُ ما بينَ لابَتَيِ المَدينةِ أن يُقطَعَ عِضاهُها، أو يُقتَلَ صَيدُها، وقال: المَدينةُ خَيرٌ لهم لو كانوا يَعلَمونَ، لا يَدَعُها أحَدٌ رَغبةً عَنها إلَّا أبدَلَ اللهُ فيها مَن هو خَيرٌ منه، ولا يَثبُتُ أحَدٌ على لَأوائِها وجَهدِها إلَّا كُنتُ له شَفيعًا، أو شَهيدًا يَومَ القيامةِ. [وفي روايةٍ]: ",["ولا يُريدُ أحَدٌ أهلَ المَدينةِ بسوءٍ",1]," ",["إلَّا أذابَه اللهُ في النَّارِ ذَوبَ الرَّصاصِ، أو ذَوبَ المِلحِ في الماءِ",2],"."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (1573)، وعبد بن حميد في ((المنتخب)) (153)، والبيهقي (10053) واللفظ لهم.","bab":"قيامة › الشفاعة","dorar":"hpxIUgNd","merged":2,"otherRefs":["المحلى 7/282 (صحيح)"]},{"id":"س-03004","fp":"206f3969bcd0","stateId":749,"easy":"إذا سمّعت يهودياً أو نصرانياً (بالأذى) ← دخلت النار","cause":"مَن سمَّع يهوديًّا أو نصرانيًّا","result":"دخَل النَّارَ","explicit":true,"ref":"تخريج صحيح ابن حبان 4880","srcLabel":"النسائي","text":[["مَن سمَّع يهوديًّا أو نصرانيًّا ",1],["دخَل النَّارَ",2]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح على شرطهما. [ثم نبه الشيخ على أن هذه الرواية مختصرة ومحرفة ]","takhrij":"أخرجه ابن حبان (2941) واللفظ له، وأحمد (19536)، والنسائي في ((السنن الكبرى)) (11177)، والروياني في ((المسند)) (526) بنحوه.","bab":"إيمان › الوعيد","dorar":"rJse3WG7"},{"id":"س-05026","fp":"4b279d3b6452","stateId":749,"easy":"إذا أخفرت ذمة النبي ﷺ ← يكون خصمك ومن خاصمه خصمه","cause":"مَن يُخْفِرْ ذِمَّتِي","result":"كنتُ خَصْمَه ، ومَن خاصَمْتُه خَصَمْتُه","explicit":true,"otherNeedIds":[28],"ref":"صحيح الجامع 6607","srcLabel":"الطبراني","text":[["مَن يُخْفِرْ ذِمَّتِي",1]," ",["كنتُ خَصْمَه ، ومَن خاصَمْتُه خَصَمْتُه",2]],"grade":"صحيح","narrator":"جندب بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (1668) (2/ 162)، وابن مردويه في ((جزء فيه أحاديث ابن حيان)) (96) واللفظ لهما.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"grqVIRlS"},{"id":"س-05037","fp":"e9919b049b6f","stateId":749,"easy":"إذا طلبك الله من ذمته بشيء (بإخفارها) ← يدركك ثم يكبك على وجهك في جهنم","cause":"مَن يَطلُبْه مِن ذِمَّتِه بشيءٍ","result":"يُدرِكْه، ثُمَّ يَكُبَّه على وجهِه في نارِ جَهَنَّمَ","explicit":true,"ref":"صحيح مسلم 657","srcLabel":"أحمد","text":["مَن صَلَّى صَلاةَ الصُّبحِ فهو في ذِمَّةِ اللهِ، فلا يَطلُبَنَّكُمُ اللهُ مِن ذِمَّتِه بشيءٍ؛ فإنَّه ",["مَن يَطلُبْه مِن ذِمَّتِه بشيءٍ",1]," ",["يُدرِكْه، ثُمَّ يَكُبَّه على وجهِه في نارِ جَهَنَّمَ",2],"."],"grade":"صحيح","narrator":"جندب بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (1683) (2/ 166)، والروياني (955) باختلاف يسير، وأحمد (18814) مختصرًا.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"v64OngYp"},{"id":"س-06566","fp":"9a91836a9ca1","stateId":749,"easy":"إذا أخفرت ذمة الله ← يكبك الله في النار لوجهك","cause":"فمن أخفرَ ذمَّةَ اللَّهِ","result":"كبَّهُ اللَّهُ في النَّارِ لوجهه","explicit":true,"ref":"مجمع الزوائد 2/44","srcLabel":"الطبراني","text":["من صلَّى الصُّبحَ في جماعةٍ فهوَ في ذمَّةِ اللَّهِ ",["فمن أخفرَ ذمَّةَ اللَّهِ ",1],["كبَّهُ اللَّهُ في النَّارِ لوجهه",2]],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني كما في ((مجمع الزوائد)) للهيثمي (1646)، والدارقطني في ((العلل)) (1274) واللفظ لهما، والبزار (‌3616) بنحوه مطولا.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"7SqYWwUp"},{"id":"س-06610","fp":"8c88dd51ae74","stateId":749,"easy":"إذا أخفرت ذمة الله ← يطلبك حتى يكبك على وجهك","cause":"من أخفَر ذِمَّتَه","result":"طلبه اللهُ تبارك و تعالى ، حتى يُكبَّه على وجهِه","explicit":true,"ref":"صحيح الترغيب 462","srcLabel":"أحمد","text":["من صلَّى الصبحَ فهو في ذِمَّةِ اللهِ تبارك و تعالى ، فلا تُخفِروا اللهَ تبارك و تعالى في ذِمَّتِه ، فإنه ",["من أخفَر ذِمَّتَه ",1],["طلبه اللهُ تبارك و تعالى ، حتى يُكبَّه على وجهِه",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (5898)، والبزار (5988) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (8548) مختصراً","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"sECvm2kY"},{"id":"س-08078","fp":"894fc0b61baf","stateId":749,"easy":"إذا اعتديت بعد (حد الله) ← فلك نار جهنم خالداً فيها","cause":"ومنِ اعتدى بعدَ ذلِكَ","result":"فلَهُ نارَ جَهَنَّمَ خالِدًا فيها","explicit":true,"ref":"عمدة التفسير 1/213","srcLabel":"أبو داود","text":["مَن أصيبَ بقتلٍ أو خَبَلٍ فإنَّهُ يختارُ إحدى ثلاثٍ : إمَّا أن يَقتصَّ ، وإمَّا أن يَعفوَ ، وإمَّا أن يأخذَ الدِّيةَ ، فإن أرادَ الرَّابعةَ فخُذوا على يديهِ ، ",["ومنِ اعتدى بعدَ ذلِكَ",1]," ",["فلَهُ نارَ جَهَنَّمَ خالِدًا فيها",2]],"grade":"صحيح","narrator":"أبو شريح العدوي خويلد بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4496)، وابن ماجه (2623)، وأحمد (16375)","bab":"مظالم › قصاص المظالم","dorar":"6uh9FbBq"},{"id":"س-07495","fp":"31de0bef2d9c","stateId":749,"easy":"إذا أكلت مال أخيك وسفكت دمه وعصيت ربك وكفرت بخالقك ← تجب لك جهنم","cause":"فيأكلُ مالَ أخيه ، ويسفِكُ دمَه ، ويعصي ربَّه ، ويَكفُرُ بخالقِهِ","result":"وتجِبُ [ لهُ ] جهنَّمُ","explicit":true,"otherNeedIds":[22],"ref":"المطالب العالية 5/8","srcLabel":"الطبراني","text":["ستكونُ بَعدي فتَنٌ كقِطعِ اللَّيلِ المظلِمِ ، يُصدَمُ الرَّجلُ كصَدمِ جباهِ فُحولِ الثِّيرانِ ، يُصبِحُ الرَّجلُ فيها مُسلمًا ويُمسي كافرًا ، ويُمسي مُؤمنًا ويُصبِحُ كافرًا ، فقال رجلٌ : فكيفَ نصنعُ عندَ ذلكَ يا رسولَ اللهِ ؟ قال صلَّى اللهُ عليْهِ وسلَّمَ : ادخُلوا بيوتَكم ، وأَخمِلوا ذِكرَكُم ، فقال رجلٌ : أرأيتَ إن دُخِلَ على أحدِنا بيتُهُ ؟ قال : فلْيُمسكْ بيدِه ، ولْيكن [ عبدَ ] اللهِ المقتولَ ، ولا يكن [ عبدَ ] اللهِ القاتلَ ، فإنَّ الرَّجلَ يكونُ في [ فئةِ ] الإسلامِ ، ",["فيأكلُ مالَ أخيه ، ويسفِكُ دمَه ، ويعصي ربَّه ، ويَكفُرُ بخالقِهِ",1]," ، ",["وتجِبُ [ لهُ ] جهنَّمُ",2]],"grade":"حسن","narrator":"جندب بن عبدالله","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن أبي شيبة (38585)، وأبو يعلى (1523) واللفظ لهما، والطبراني في ((المعجم الكبير)) (2/ 177) (1724) بنحوه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"8Mc7b36f"},{"id":"س-04176","fp":"cd00b3ca0d97","stateId":749,"easy":"إذا قتلت ظالماً لك دفاعاً ← فالظالم في النار","cause":"وإن قَتلتَ","result":"ففي النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشاكر 16/199","srcLabel":"مسلم","text":["جاءَ رجلٌ إلى رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ : يا رسولَ اللَّهِ أرأيتَ إن عُدِيَ على مالي ؟ قالَ : فأنشِدِ اللَّهَ قالَ : فإن أبَوا عليَّ قالَ : أنشِدِ اللَّهَ قالَ : فإن أبوا عليَّ قالَ : فأنشدِ اللَّه قالَ فإن أبوا عليَّ قالَ : فقاتِلْ ، فإن قُتِلتَ ففي الجنَّةِ ، ",["وإن قَتلتَ",1]," ",["ففي النَّارِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (4082) باختلاف يسير، وأخرجه مسلم (140) بنحوه","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"I1lQ6JO2"},{"id":"س-01752","fp":"937299ba392c","stateId":750,"easy":"إذا قتلت نفسك بشيء ← يعذبك الله به في نار جهنم","cause":"ومَن قَتَلَ نَفسَه بشيءٍ","result":"عَذَّبَه اللهُ به في نارِ جَهَنَّمَ","explicit":true,"star":true,"similar":["س-02375","س-02368","س-04918","س-05122","س-05162","س-05163","س-05164","س-04259"],"ref":"صحيح مسلم 110","srcLabel":"متفق عليه","text":["مَن حَلَفَ بمِلَّةٍ سِوى الإسلامِ كاذِبًا مُتَعَمِّدًا، فهو كما قال، ",["ومَن قَتَلَ نَفسَه بشيءٍ ",1],["عَذَّبَه اللهُ به في نارِ جَهَنَّمَ",2],". وفي روايةٍ: مَن حَلَفَ بمِلَّةٍ سِوى الإسلامِ كاذِبًا، فهو كما قال، ومَن ذَبَحَ نَفسَه بشيءٍ ذُبِحَ به يَومَ القيامةِ."],"grade":"صحيح","narrator":"ثابت بن الضحاك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1363)، ومسلم (110).","bab":"أيمان › الحلف بغير الله عز وجل","dorar":"GdyJNve4","merged":2,"otherRefs":["الإحكام في أصول الأحكام 2/504 (صحيح)"]},{"id":"س-02375","fp":"3001b57f2178","stateId":750,"easy":"إذا قتلت نفسك بشيء في الدنيا ← تُعذّب به يوم القيامة","cause":"ومَن قَتَلَ نَفسَه بشيءٍ في الدُّنيا","result":"عُذِّبَ به يَومَ القيامةِ","explicit":true,"repOf":"س-01752","ref":"صحيح مسلم 110","text":["ليس على رَجُلٍ نَذرٌ فيما لا يَملِكُ، ولَعنُ المُؤمِنِ كَقَتلِه، ",["ومَن قَتَلَ نَفسَه بشيءٍ في الدُّنيا",1]," ",["عُذِّبَ به يَومَ القيامةِ",2],"، ومَنِ ادَّعى دَعوى كاذِبةً ليَتَكَثَّرَ بها لم يَزِدْه اللهُ إلَّا قِلَّةً، ومَن حَلَفَ على يَمينِ صَبرٍ فاجِرةٍ."],"grade":"صحيح","narrator":"ثابت بن الضحاك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6047)، ومسلم (110).","bab":"إسلام › حرمة المسلم","dorar":"LmqD8FfX","merged":2,"otherRefs":["تخريج المسند لشعيب 16391 (صحيح)"]},{"id":"س-02368","fp":"a72be3ffd479","stateId":750,"easy":"إذا قتلت نفسك بشيء ← يعذبك الله بما قتلت به نفسك يوم القيامة","cause":"ومَن قَتَل نَفْسَه بِشَيءٍ","result":"عذَّبَه اللهُ بِما قَتَل بِه نَفسَه يومَ القيامَةِ","explicit":true,"repOf":"س-01752","ref":"صحيح الترغيب 2776","text":["لَيسَ على المَرءِ نَذرٌ فيما لا يَملِكُ، ولاعِنُ المُؤمنِ كقاتِلِه، ومَن قَذَف مُؤمِنًا بِكُفرٍ فهوَ كقاتِلِه، ",["ومَن قَتَل نَفْسَه بِشَيءٍ ",1],["عذَّبَه اللهُ بِما قَتَل بِه نَفسَه يومَ القيامَةِ",2],"."],"grade":"صحيح","narrator":"ثابت بن الضحاك","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6047)، ومسلم (110) باختلاف يسير.","bab":"إسلام › حرمة المسلم","dorar":"XyD8F1In"},{"id":"س-04916","fp":"92942480a781","stateId":750,"easy":"إذا خنقت نفسك في الدنيا ← تخنق نفسك في النار","cause":"مَن خنَق نفسَه في الدُّنيا فقتَلها خنَق نفسَه","result":"في النَّارِ","explicit":true,"ref":"تخريج صحيح ابن حبان 5987","srcLabel":"البخاري","text":[["مَن خنَق نفسَه في الدُّنيا فقتَلها خنَق نفسَه ",1],["في النَّارِ ",2],"ومَن طعَن نفسَه طعَنها في النَّارِ ومَن اقتحَم فقتَل نفسَه اقتحَم في النَّارِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1365) بلفظ مقارب دون قوله: \"ومن اقتحم ...\"","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"eZWd2Yyg"},{"id":"س-04917","fp":"12d78919ffca","stateId":750,"easy":"إذا طعنت نفسك ← تطعنها في النار","cause":"ومَن طعَن نفسَه طعَنها","result":"في النَّارِ","explicit":true,"ref":"تخريج صحيح ابن حبان 5987","srcLabel":"البخاري","text":["مَن خنَق نفسَه في الدُّنيا فقتَلها خنَق نفسَه في النَّارِ ",["ومَن طعَن نفسَه طعَنها ",1],["في النَّارِ ",2],"ومَن اقتحَم فقتَل نفسَه اقتحَم في النَّارِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1365) بلفظ مقارب دون قوله: \"ومن اقتحم ...\"","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"eZWd2Yyg"},{"id":"س-04918","fp":"44ee14f4b0e3","stateId":750,"easy":"إذا اقتحمت فقتلت نفسك ← تقتحم في النار","cause":"ومَن اقتحَم فقتَل نفسَه اقتحَم","result":"في النَّارِ","explicit":true,"repOf":"س-01752","ref":"تخريج صحيح ابن حبان 5987","text":["مَن خنَق نفسَه في الدُّنيا فقتَلها خنَق نفسَه في النَّارِ ومَن طعَن نفسَه طعَنها في النَّارِ ",["ومَن اقتحَم فقتَل نفسَه اقتحَم ",1],["في النَّارِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1365) بلفظ مقارب دون قوله: \"ومن اقتحم ...\"","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"eZWd2Yyg"},{"id":"س-05122","fp":"c819e45570cf","stateId":750,"easy":"إذا قتلت نفسك بحديدة أو تردّيت ← تُعذب بها في نار جهنم خالداً","cause":"مَن قتَل نفْسَهُ بحَديدةٍ، فحَديدتُهُ في يدِهِ في نارِ جَهنَّمَ، يتوجَّأُ بها في بطنِهِ في نارِ جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا، ومَن تردَّى من جبَلٍ فقتَل نفْسَهُ","result":"فهو يتردَّى في جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا","explicit":true,"repOf":"س-01752","ref":"تخريج مشكل الآثار 196","text":[["مَن قتَل نفْسَهُ بحَديدةٍ، فحَديدتُهُ في يدِهِ في نارِ جَهنَّمَ، يتوجَّأُ بها في بطنِهِ في نارِ جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا، ومَن تردَّى من جبَلٍ فقتَل نفْسَهُ، ",1],["فهو يتردَّى في جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا",2],"، ومَن قتَل نفْسَهُ بسُمٍّ، فسُمُّهُ في يدِهِ يتحسَّاهُ في نارِ جَهنَّمَ خالدًا فيها، مُخلَّدًا فيها أبدًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (5778)، ومسلم (109) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"GpQmPCdR"},{"id":"س-05162","fp":"101c1c122b18","stateId":750,"easy":"إذا تردّيت من جبل فقتلت نفسك ← تتردى في نار جهنم خالداً","cause":"مَن تردَّى مِن جبَلٍ فقتَلَ نفْسَه","result":"فهو في نارِ جَهنَّمَ، يتردَّى خالدًا مُخلَّدًا فيها أبدًا","explicit":true,"repOf":"س-01752","ref":"صحيح النسائي 1964","text":[["مَن تردَّى مِن جبَلٍ فقتَلَ نفْسَه ",1],["فهو في نارِ جَهنَّمَ، يتردَّى خالدًا مُخلَّدًا فيها أبدًا، ",2],"ومَن تحسَّى سُمًّا فقتَلَ نفْسَه، فسُمُّه في يدِهِ، يتحسَّاه في نارِ جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا، ومَن قتَلَ نفْسَه بحَديدةٍ -ثمَّ انقطَعَ عليَّ شيء، خالِدٌ يقولُ- كانتْ حديدتُه في يدِه، يَجَأُ بها في بطنِه في نارِ جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5778)، ومسلم (109)، والترمذي (2044)، والنسائي (1965) واللفظ له، وأحمد (7448)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"aoL3jt3Q"},{"id":"س-05163","fp":"c48be0a1b5c7","stateId":750,"easy":"إذا تحسّيت سماً فقتلت نفسك ← تتحساه في نار جهنم خالداً","cause":"ومَن تحسَّى سُمًّا فقتَلَ نفْسَه، فسُمُّه في يدِهِ","result":"يتحسَّاه في نارِ جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا","explicit":true,"repOf":"س-01752","ref":"صحيح النسائي 1964","text":["مَن تردَّى مِن جبَلٍ فقتَلَ نفْسَه فهو في نارِ جَهنَّمَ، يتردَّى خالدًا مُخلَّدًا فيها أبدًا، ",["ومَن تحسَّى سُمًّا فقتَلَ نفْسَه، فسُمُّه في يدِهِ، ",1],["يتحسَّاه في نارِ جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا، ",2],"ومَن قتَلَ نفْسَه بحَديدةٍ -ثمَّ انقطَعَ عليَّ شيء، خالِدٌ يقولُ- كانتْ حديدتُه في يدِه، يَجَأُ بها في بطنِه في نارِ جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5778)، ومسلم (109)، والترمذي (2044)، والنسائي (1965) واللفظ له، وأحمد (7448)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"aoL3jt3Q"},{"id":"س-05164","fp":"d745d355bb83","stateId":750,"easy":"إذا قتلت نفسك بحديدة ← تجأ بها بطنك في نار جهنم خالداً","cause":"ومَن قتَلَ نفْسَه بحَديدةٍ","result":"كانتْ حديدتُه في يدِه، يَجَأُ بها في بطنِه في نارِ جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا","explicit":true,"repOf":"س-01752","ref":"صحيح النسائي 1964","text":["مَن تردَّى مِن جبَلٍ فقتَلَ نفْسَه فهو في نارِ جَهنَّمَ، يتردَّى خالدًا مُخلَّدًا فيها أبدًا، ومَن تحسَّى سُمًّا فقتَلَ نفْسَه، فسُمُّه في يدِهِ، يتحسَّاه في نارِ جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا، ",["ومَن قتَلَ نفْسَه بحَديدةٍ",1]," -ثمَّ انقطَعَ عليَّ شيء، خالِدٌ يقولُ- ",["كانتْ حديدتُه في يدِه، يَجَأُ بها في بطنِه في نارِ جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5778)، ومسلم (109)، والترمذي (2044)، والنسائي (1965) واللفظ له، وأحمد (7448)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"aoL3jt3Q"},{"id":"س-07496","fp":"831741b98b24","stateId":750,"easy":"إذا انتحرت ← فأنت من أهل النار","cause":"فانتَزَعَ مِنها سَهمًا، فانتَحَرَ به","result":"أما إنَّه مِن أهلِ النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح البخاري 6606","srcLabel":"متفق عليه","text":["شَهِدنا مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم خَيبَرَ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم لرَجُلٍ مِمَّن معهُ يَدَّعي الإسلامَ: هذا مِن أهلِ النَّارِ. فلَمَّا حَضَرَ القِتالُ قاتَلَ الرَّجُلُ مِن أشَدِّ القِتالِ، وكَثُرَت به الجِراحُ فأثبَتَته، فجاءَ رَجُلٌ مِن أصحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّم، فقال: يا رَسولَ اللهِ، أرَأيتَ الرَّجُلَ الذي تَحَدَّثتَ أنَّه مِن أهلِ النَّارِ، قد قاتَلَ في سَبيلِ اللهِ مِن أشَدِّ القِتالِ، فكَثُرَت به الجِراحُ! فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ",["أما إنَّه مِن أهلِ النَّارِ",2],". فكادَ بَعضُ المُسلِمينَ يَرتابُ، فبينَما هو على ذلك إذ وجَدَ الرَّجُلُ ألَمَ الجِراحِ، فأهوى بيَدِه إلى كِنانَتِه، ",["فانتَزَعَ مِنها سَهمًا، فانتَحَرَ به",1],"ا، فاشتَدَّ رِجالٌ مِنَ المُسلِمينَ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقالوا: يا رَسولَ اللهِ، صَدَّقَ اللهُ حَديثَك؛ قدِ انتَحَرَ فُلانٌ فقَتَلَ نَفسَه! فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: يا بلالُ، قُمْ فأذِّنْ: لا يَدخُلُ الجَنَّةَ إلَّا مُؤمِنٌ، وإنَّ اللهَ لَيُؤَيِّدُ هذا الدِّينَ بالرَّجُلِ الفاجِرِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6606)، ومسلم (111)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"2cXWlLL0","merged":2,"otherRefs":["تخريج المسند لشعيب 17218 (صحيح)"]},{"id":"س-04259","fp":"726e09d7bd76","stateId":750,"easy":"إذا قتلت نفسك ← تبقى في النار","cause":"انطلقت أنحرُ نفسي","result":"لو فعلتَ ما زلتَ في نارِ جَهنَّمَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-01752","ref":"المحلى 8/16","text":["جاءَ رجلٌ إلى ابنِ عبَّاسٍ فقالَ لَهُ : كنت أسيرًا في أرضِ العدوِّ فنذرت إن نجَّاني اللَّهُ أن أفعلَ كذا وأن أنحرَ نفسي وإنِّي قد فعلت ذلِكَ قالَ وفي عنقِهِ قدٌّ فأقبلَ ابنُ عبَّاسٍ على امرأةٍ سألتْهُ وغفلَ عن الرَّجلِ فانطلقَ لينحَرَ نفسَهُ فسألَ ابنَ عبَّاسٍ عنْهُ فقيلَ لَهُ ذَهبَ لينحرَ نفسَهُ فقالَ عليَّ بالرَّجلِ فجاءَ فقالَ لمَّا أعرضتَ عنِّي ",["انطلقت أنحرُ نفسي",1]," فقالَ لَهُ ابنُ عبَّاسٍ ",["لو فعلتَ ما زلتَ في نارِ جَهنَّمَ",2]," انظر ديتَك فاجعلْها في بُدنٍ فأَهدِها في كلِّ عامٍ شيئًا ولولا أنَّك شدَّدتَ على نفسِك لرجوتُ أن يجزيكَ كبشٌ"],"grade":"صحيح","narrator":"سالم بن أبي الجعد","muhaddith":"في غاية الصحة","takhrij":"لم نقف عليه إلا عند ابن حزم في ((المحلى)) (6/ 262) .","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"mRMp6Chk"},{"id":"س-03024","fp":"aeaead7d2533","stateId":750,"easy":"إذا خنقت نفسك ← تخنق نفسك في النار","cause":"الذي يخنُقُ نفْسَهُ","result":"يخنُقُ نفْسَهُ في النَّارِ","explicit":true,"ref":"تخريج مشكل الآثار 195","srcLabel":"البخاري","text":[["الذي يخنُقُ نفْسَهُ",1]," ",["يخنُقُ نفْسَهُ في النَّارِ",2],"، والذي يقتحِمُ نفْسَهُ يقتحِمُ نفْسَهُ في النَّارِ، والذي يطعُنُ نفْسَهُ يطعُنُ نفْسَهُ في النَّارِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (1365) باختلاف يسير دون قوله: \"والذي يقتحم نفسه يقتحم نفسه في النار\"","bab":"إيمان › الوعيد","dorar":"2M0dsz66","merged":2,"otherRefs":["صحيح الجامع 5494 (صحيح)"]},{"id":"س-04568","fp":"bdec41618925","stateId":750,"easy":"إذا طعنت نفسك ← تطعنها في النار","cause":"والذِي يطْعَنُها","result":"يطْعَنُها في النارِ","explicit":true,"ref":"صحيح الجامع 5494","srcLabel":"متفق عليه","text":["الذي يخنِقُ نفْسَهُ يخنُقُهَا فِي النَّارِ ، ",["والذِي يطْعَنُها",1]," ",["يطْعَنُها في النارِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1365 ) واللفظ له، ومسلم (109) بمعناه","bab":"جهنم › صفة عذاب أهل النار","dorar":"d5oYk6lq"},{"id":"س-03943","fp":"dfc371489294","stateId":751,"easy":"إذا قتلت رجلاً متعمداً ← يجيء يوم القيامة آخذاً بك","cause":"رَجُلٌ قَتَلَ رَجُلًا مُتَعَمِّدًا","result":"فجيءَ يَوْمَ القِيامةِ آخِذًا قاتِلُه بيَمينِه","explicit":true,"star":true,"similar":["س-03915"],"otherNeedIds":[13],"ref":"الأحاديث المختارة 10 / 45","srcLabel":"متفق عليه","text":["«أنَّ رَجُلًا أتاه، فقالَ: أَرأيْتَ رَجُلًا قَتَلَ رَجُلًا مُتَعَمِّدًا؟ قالَ: {فَجَزَاؤُهُ جَهَنَّمُ خَالِدًا فِيهَا وَغَضِبَ اللَّهُ عَلَيْهِ وَلَعَنَهُ وَأَعَدَّ لَهُ عَذَابًا عَظِيمًا} قالَ: لقد نَزَلَتْ في آخِرِ ما نَزَلَ، ما نَسَخَها شيءٌ حتَّى قُبِضَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ وما نَزَلَ وَحْيٌ بَعْدَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، قالَ: أَرأيْتَ إن تابَ وآمَنَ وعَمِلَ صالِحًا ثُمَّ اهْتَدى، قالَ: وأنَّى له التَّوْبةُ وقدْ سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ثَكِلَتْه أُمُّه ",["رَجُلٌ قَتَلَ رَجُلًا مُتَعَمِّدًا",1]," ",["فجيءَ يَوْمَ القِيامةِ آخِذًا قاتِلُه بيَمينِه",2]," أو يَسارِه، وآخِذًا رَأسَه بيَمينِه أو شِمالِه تَشخَبُ أوْداجُه دَمًا في قُبُلِ العَرْشِ، يقولُ: يا رَبِّ، سَلْ عَبْدَك فيمَ قَتَلَني»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"تفسير آيات › سورة النساء","dorar":"hrJtxCcM","merged":8,"otherRefs":["صحيح ابن ماجه 2139 (صحيح)","تخريج المسند لشعيب 2683 (صحيح)","السلسلة الصحيحة 6/444 (صحيح)","تخريج المسند لشعيب 1941 (صحيح)","صحيح الجامع 8032 (صحيح)","الأحاديث المختارة 10 / 47 (صحيح)","تخريج المسند لشعيب 3445 (صحيح)"]},{"id":"س-05751","fp":"ee143a49005e","stateId":751,"easy":"إذا تواجه مسلمان بسيفيهما ← فكلاهما من أهل النار","cause":"تَواجَهَ المُسلِمانِ بسَيفَيهما","result":"فكِلاهما مِن أهلِ النَّارِ","explicit":true,"star":true,"ref":"صحيح البخاري 7083","srcLabel":"مسلم","text":["عَنِ الحَسَنِ، قال: خَرَجتُ بسِلاحي لَياليَ الفِتنةِ، فاستَقبَلَني أبو بَكرةَ، فقال: أينَ تُريدُ؟ قُلتُ: أُريدُ نُصرةَ ابنِ عَمِّ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، قال: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: إذا ",["تَواجَهَ المُسلِمانِ بسَيفَيهما",1]," ",["فكِلاهما مِن أهلِ النَّارِ",2],"، قيلَ: فهذا القاتِلُ، فما بالُ المَقتولِ؟ قال: إنَّه أرادَ قَتلَ صاحِبِه."],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"[أورده في صحيحه وعلق عليه]","takhrij":"أخرجه مسلم (2888) باختلاف يسير","bab":"رقائق وزهد › النية","dorar":"U91Fsdvz","merged":5,"otherRefs":["التذكرة للقرطبي 556 (صحيح)","الجامع الصغير 483 (صحيح)","تخريج المسند لشعيب 20493 (صحيح)","تخريج المسند لشعيب 19590 (صحيح)"]},{"id":"س-01561","fp":"1d6c5216bc89","stateId":751,"easy":"إذا تواجه مسلمان بسيفيهما فقتل أحدهما الآخر ← فهما في النار","cause":"إذا تواجَهَ المُسلِمانِ بسيفَيْهِما فقتَلَ أحدُهما صاحِبَه","result":"فهما في النَّارِ","explicit":true,"star":true,"similar":["س-07280"],"ref":"تخريج مشكل الآثار 4087","srcLabel":"متفق عليه","text":["عن الأَحْنَفِ بنِ قيسٍ قال: أخَذتُ سِلاحي وأنا أُريدُ أنْ أنصُرَ ابنَ عمِّ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فلَقِيَني أبو بَكْرَةَ، فقال: أين تُريدُ؟ قُلتُ: أنصُرُ ابنَ عمِّ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، قال: أفلا أُحدِّثُك حديثًا سمعتُه مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ قال: بلى، قُلتُ: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["إذا تواجَهَ المُسلِمانِ بسيفَيْهِما فقتَلَ أحدُهما صاحِبَه",1],"، ",["فهما في النَّارِ",2],"، قيل: يا رسولَ اللهِ، هذا القاتلُ، فما بالُ المقتولِ؟! قال: إنَّه قد أراد يقتُلُ صاحِبَه."],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (4087) بلفظه، والبخاري (6875)، وأبو داود (4268) كلاهما بلفظ مقارب ، ومسلم (2888) بنحوه .","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"ix1EodgO","merged":3,"otherRefs":["تخريج المسند لشعيب 20518 (صحيح)","تخريج المسند لشعيب 19751 (صحيح)"]},{"id":"س-05297","fp":"09ccb3843bb3","stateId":751,"easy":"إذا قتلت لتكون العزة لغير الله ← يجيء المقتول آخذاً بك تشخب أوداجه دماً","cause":"قتَلْتُه لِتكونَ العِزَّةُ لِفلانٍ","result":"يجِئُ المَقتولُ آخذًا قاتلَهُ وأوْداجُه تَشْخُبُ دَمًا عند ذِي العِزَّةِ ، فيقولُ : يا ربِّ ! سلْ هذا فِيمَ قَتَلَنِي","explicit":true,"star":true,"ref":"صحيح الترغيب 2448","srcLabel":"متفق عليه","text":[["يجِئُ المَقتولُ آخذًا قاتلَهُ وأوْداجُه تَشْخُبُ دَمًا عند ذِي العِزَّةِ ، فيقولُ : يا ربِّ ! سلْ هذا فِيمَ قَتَلَنِي",2]," ؟ فيقولُ : فِيمَ قَتلْتَه ؟ قال : ",["قتَلْتُه لِتكونَ العِزَّةُ لِفلانٍ",1]," . قِيلَ : هي للهِ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (766)، واللفظ له، وأصله في البخاري (6864)، ومسلم (1678)","bab":"رقائق وزهد › الترهيب من مواقعة الحدود وانتهاك المحارم","dorar":"Y9sfYBdi","merged":3,"otherRefs":["تخريج المسند لشعيب 16600 (صحيح)","الصحيح المسند 2/453 (صحيح)"]},{"id":"س-04965","fp":"b31466b6e8c7","stateId":751,"easy":"إذا حمل أحدكما السلاح على أخيه ← فأنتما على جرف جهنم، فإن قتله دخلاها","cause":"حمَل أحدُهما -يَعني على أخيه السَّلاحَ","result":"فهُما على جُرُفِ جهنَّمَ، فإذا قتَلَ أحدُهما صاحبَه دَخلاها جَميعًا","explicit":true,"ref":"ما تمس إليه الحاجة 176","srcLabel":"متفق عليه","text":["إذا الْتقَي المسلِمانِ ",["حمَل أحدُهما -يَعني على أخيه السَّلاحَ",1],"-؛ ",["فهُما على جُرُفِ جهنَّمَ، فإذا قتَلَ أحدُهما صاحبَه دَخلاها جَميعًا",2],"."],"grade":"صحيح","narrator":"أبو بكرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2888)، وابن ماجه (3965) كلاهما بلفظه، والنسائي (4116) بلفظ مقارب، والبخاري (7083) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"eQCvSc2h","merged":2,"otherRefs":["الجامع الصغير 438 (صحيح)"]},{"id":"س-02527","fp":"3ae2b46ca1cf","stateId":751,"easy":"إذا أشرت إلى أخيك بالسلاح ← قد يقع في حفرة من النار","cause":"لا يُشيرُ أحَدُكُم إلى أخيه بالسِّلاحِ","result":"فيَقَعُ في حُفرةٍ مِنَ النَّارِ","explicit":true,"ref":"صحيح مسلم 2617","srcLabel":"البخاري","text":[["لا يُشيرُ أحَدُكُم إلى أخيه بالسِّلاحِ",1],"؛ فإنَّه لا يَدري أحَدُكُم لَعَلَّ الشَّيطانَ يَنزِعُ في يَدِه، ",["فيَقَعُ في حُفرةٍ مِنَ النَّارِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7072) باختلاف يسير","bab":"إيمان › أعمال الجن والشياطين","dorar":"3gjwyteA"},{"id":"ق-0211","fp":"e14fa3748aaa","stateId":751,"easy":"أكل الأموال بالباطل وقتل النفس عدواناً وظلماً ← صَلي النار","cause":"أكل الأموال بالباطل وقتل النفس عدواناً وظلماً","result":"صَلي النار","explicit":true,"ref":"سورة النساء: 30","srcLabel":"القرآن الكريم","quran":{"s":4,"from":30,"to":30,"text":"وَمَنْ يَفْعَلْ ذَلِكَ عُدْوَانًا وَظُلْمًا فَسَوْفَ نُصْلِيهِ نَارًا وَكَانَ ذَلِكَ عَلَى اللَّهِ يَسِيرًا (30)","hl":[[0,107,1]]}},{"id":"ق-0237","fp":"e8a470d26b5e","stateId":751,"easy":"قتل المؤمن عمداً ← جهنم خالداً فيها وغضب الله ولعنته وعذاب عظيم","cause":"قتل المؤمن عمداً","result":"جهنم خالداً فيها وغضب الله ولعنته وعذاب عظيم","explicit":true,"otherNeedIds":[28],"ref":"سورة النساء: 93","srcLabel":"القرآن الكريم","quran":{"s":4,"from":93,"to":93,"text":"وَمَنْ يَقْتُلْ مُؤْمِنًا مُتَعَمِّدًا فَجَزَاؤُهُ جَهَنَّمُ خَالِدًا فِيهَا وَغَضِبَ اللَّهُ عَلَيْهِ وَلَعَنَهُ وَأَعَدَّ لَهُ عَذَابًا عَظِيمًا (93)","hl":[[0,146,1]]}},{"id":"ق-0882","fp":"1fb93158a850","stateId":751,"easy":"الشرك وقتل النفس والزنا ← الأثام ومضاعفة العذاب والخلود مهاناً","cause":"الشرك وقتل النفس والزنا","result":"الأثام ومضاعفة العذاب والخلود مهاناً","explicit":true,"otherNeedIds":[13],"ref":"سورة الفرقان: 68–69","srcLabel":"القرآن الكريم","quran":{"s":25,"from":68,"to":69,"text":"وَالَّذِينَ لَا يَدْعُونَ مَعَ اللَّهِ إِلَهًا آخَرَ وَلَا يَقْتُلُونَ النَّفْسَ الَّتِي حَرَّمَ اللَّهُ إِلَّا بِالْحَقِّ وَلَا يَزْنُونَ وَمَنْ يَفْعَلْ ذَلِكَ يَلْقَ أَثَامًا (68) يُضَاعَفْ لَهُ الْعَذَابُ يَوْمَ الْقِيَامَةِ وَيَخْلُدْ فِيهِ مُهَانًا (69)","hl":[[139,254,1]]}},{"id":"س-04991","fp":"24414d06d37a","stateId":751,"easy":"إذا وأدت ← فالوائدة في النار","cause":"الوائدةُ","result":"في النَّارِ","explicit":true,"similar":["س-02433"],"otherNeedIds":[11],"ref":"الصحيح المسند 452","srcLabel":"الصحيح المسند","text":["انطلَقتُ أَنا وأخي إلى رسولِ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ ، قالَ: قُلنا: يا رسولَ اللَّهِ ، إنَّ أمَّنا مُلَيْكةَ كانت تَصِلُ الرَّحمَ ، وتَقري الضَّيفَ ، وتَفعلُ ، وتَفعلُ هلَكَت في الجاهليَّةِ ، فَهَل ذلِكَ نافعُها شيئًا ؟ قالَ: لا قالَ: قُلنا: فإنَّها كانَت وأدت أختًا لَنا في الجاهليَّةِ ، فَهَل ذلِكَ نافعُها شيئًا ؟ قالَ: ",["الوائدةُ",1]," والمؤودةُ ",["في النَّارِ",2]," ، إلَّا أن تُدْرِكَ الوائدةُ الإسلامَ ، فيَعفوَ اللَّهُ عنها ."],"grade":"صحيح","narrator":"سلمة بن يزيد الأشجعي","muhaddith":"صحيح ، رجاله رجال الصحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"n6mxc2KE","merged":3,"otherRefs":["طريق الهجرتين 327 (حسن)","تخريج مشكل الآثار 11/ 154 (صحيح)"]},{"id":"س-04429","fp":"f2bf2ab7e745","stateId":751,"easy":"إذا قتلت نبياً أو قتلك نبي أو كنت إمام ضلالة أو ممثلاً ← تكون من أشد الناس عذاباً","cause":"يَومَ القيامةِ مَن قَتَلَ نَبيًّا، أو قَتَلَه نَبيٌّ، وإمامُ ضَلالةٍ، ومُمَثِّلٌ مِن المُمَثِّلينَ","result":"أشَدُّ النَّاسِ عَذابًا","explicit":true,"ref":"مجموع الشروح الفقهية. 213/30","srcLabel":"أحمد","text":[["أشَدُّ النَّاسِ عَذابًا",2],[" يَومَ القيامةِ مَن قَتَلَ نَبيًّا، أو قَتَلَه نَبيٌّ، وإمامُ ضَلالةٍ، ومُمَثِّلٌ مِن المُمَثِّلينَ",1],"."],"grade":"صحيح","narrator":"ابن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (3868)، والطحاوي في ((شرح مشكل الآثار)) (6) كلاهما بلفظه، والطبراني (10/211) (10497) بلفظ مقارب.","bab":"جهاد › عقوبة من قتله نبي أو قتل نبيا","dorar":"YReRXJ6b","merged":2,"otherRefs":["تخريج المسند لشاكر 5/333 (صحيح)"]},{"id":"س-05133","fp":"5483719ac839","stateId":751,"easy":"إذا أمّنت رجلاً على نفسه فقتلته ← تُعطى لواء الغدر يوم القيامة","cause":"مَن أمَّنَ رَجُلًا على نَفْسِه، فقَتَلَه","result":"أُعطيَ لِواءَ الغَدرِ يَومَ القيامةِ","explicit":true,"ref":"تخريج سير أعلام النبلاء 3/ 539","srcLabel":"أحمد","text":["عن رِفاعَةَ بنِ شَدَّادٍ الفِتْيانيِّ قال: كُنتُ أقومُ على رَأْسِ المُختارِ، فلمَّا تبَيَّنَتْ كِذابَتُه، هَمَمتُ وايْمُ اللهِ أنْ أسُلَّ سَيفي، فأضرِبَ عُنُقَه، حتى ذَكَرتُ حَديثًا حَدَّثَنيه عَمْرُو بنُ الحَمِقِ، قال: سمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["مَن أمَّنَ رَجُلًا على نَفْسِه، فقَتَلَه، ",1],["أُعطيَ لِواءَ الغَدرِ يَومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"عمرو بن الحمق","muhaddith":"إسناده صحيح.","takhrij":"أخرجه ابن ماجة (2688)، وأحمد (21946)، والطحاوي في ((مشكل الآثار)) (201) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"WrscSmah","merged":2,"otherRefs":["تخريج العواصم والقواصم 3/ 204 (صحيح)"]},{"id":"س-07369","fp":"acd186476a67","stateId":751,"easy":"إذا قتلت مؤمناً ← فإن الله أبى أن يجعل لك توبة (على رواية)","cause":"فضربَهُ فقتلَهُ","result":"إنَّ اللَّهَ أبى عليَّ فيمن قتلَ مُؤمنًا","explicit":true,"otherNeedIds":[13],"ref":"الصحيح المسند 948","srcLabel":"النسائي","text":["بعثَ النَّبيُّ - صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ - سَريَّةً فأغارت على القومِ . فَشذَّ رجلٌ منَ القومِ واتَّبعَهُ رجلٌ منَ السَّريَّةِ ومعَهُ سيفٌ شاهرٌ فقالَ : الشَّاذُّ منَ القومِ: إنِّي مُسلمٌ ، فلم ينظُر فيما قالَ : ",["فضربَهُ فقتلَهُ",1]," ، فنُمِيَ الحديثُ إلى النَّبيِّ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ فقالَ النَّبيُّ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ قولًا شَديدًا فبلغَ القاتلَ ، فبينَما النَّبيُّ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ يخطبُ إذ قالَ القاتلُ: واللَّهِ يا نبيَّ اللَّهِ ، ما قالَ الَّذي قالَ إلَّا تعوُّذًا منَ القَتلِ ، فأعرضَ عنهُ النَّبيُّ صلَّى اللَّهُ عليهِ وعلى آلِهِ وسلَّمَ وعمَّن يليهِ منَ النَّاسِ ، فعلَ ذلِكَ مرَّتينِ ، كلُّ ذلِكَ يُعرِضُ عنهُ النَّبيُّ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ ، فلم يصبِرْ أن قالَ الثَّالثةَ مثلَ ذلِكَ ، فأقبلَ عليهِ النَّبيُّ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ بوجهِهِ تُعرَفُ المساءةُ في وجهِهِ ، فقالُ: ",["إنَّ اللَّهَ أبى عليَّ فيمن قتلَ مُؤمنًا",2]," ثلاثَ مرَّاتٍ يقولُ ذلِكَ"],"grade":"صحيح","narrator":"عقبة بن مالك","muhaddith":"صحيح","takhrij":"أخرجه أحمد (22543)، والنسائي في ((السنن الكبرى)) (8593).","bab":"فضائل النبي وصفته ودلائل النبوة › أحوال النبي","dorar":"dSJxJn0D","merged":2,"otherRefs":["الأحاديث المختارة 2164 (صحيح)"]},{"id":"س-07851","fp":"56dac164f42b","stateId":751,"easy":"إذا قتلت لتكون العزة لفلان ← تبوء بإثمه","cause":"قتلتُهُ لتكونَ العزَّةُ لفلانٍ","result":"فإنَّها ليسَت لَهُ فيبوءُ بإثمِهِ","explicit":true,"otherNeedIds":[13],"ref":"عمدة التفسير 1/553","srcLabel":"النسائي","text":["يجيءُ المقتولُ متعلِّقًا بقاتلِهِ يومَ القيامةِ ، آخذًا رأسَهُ بيدِهِ الأُخرى فيقولُ : يا ربُّ ، سَل هذا فيمَ قتلَني ؟ قال : فيقولُ : قتلتُهُ لتكونَ العزَّةُ لَكَ . فَيقولُ : إنَّها لي . قالَ : ويَجيءُ آخرُ متعلِّقًا بقاتلِهِ فيقولُ : ربِّ ، سل هذا فيمَ قتلَني ؟ قال : فيقولُ ",["قتلتُهُ لتكونَ العزَّةُ لفلانٍ",1]," . قالَ : ",["فإنَّها ليسَت لَهُ فيبوءُ بإثمِهِ .",2]," قالَ : فيَهْوي في النَّارِ سَبعينَ خريفًا"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (3997)، والطبراني (10/119) (10075)، وأبو نعيم في ((حلية الأولياء)) (4/147) بنحوه.","bab":"قيامة › الحساب والقصاص","dorar":"EvdZtBUr","merged":2,"otherRefs":["صحيح الجامع 8029 (صحيح)"]},{"id":"س-02371","fp":"82a24da1f4eb","stateId":751,"easy":"إذا اشترك أهل السماوات والأرض في دم مؤمن ← يدخلهم الله النار","cause":"ولو أنَّ أهلَ سماواتِه وأهلَ أرضِه اشتركوا في دمِ مؤمنٍ","result":"لأَدخلَهم اللهُ النَّارَ","explicit":true,"similar":["س-03191"],"ref":"صحيح الترغيب 2438","srcLabel":"ابن ماجه","text":[["ولو أنَّ أهلَ سماواتِه وأهلَ أرضِه اشتركوا في دمِ مؤمنٍ ؛",1],[" لأَدخلَهم اللهُ النَّارَ",2]],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (2619)، وابن أبي الدنيا في ((الأهوال)) (191) بنحوه، وقوام السنة في ((الترغيب والترهيب))  (2323) مطولا واللفظ له","bab":"إسلام › حرمة المسلم","dorar":"QoF9F7x4"},{"id":"س-03191","fp":"53844feabe46","stateId":751,"easy":"إذا اشترك أهل السماء والأرض في دم مؤمن ← يكبهم الله في النار","cause":"لو أنَّ أَهلَ السَّماءِ وأَهلَ الأرضِ اشترَكوا في دمِ مؤمنٍ","result":"لأَكبَّهمُ اللَّهُ في النَّارِ","explicit":true,"repOf":"س-02371","ref":"صحيح الترمذي 1398","text":[["لو أنَّ أَهلَ السَّماءِ وأَهلَ الأرضِ اشترَكوا في دمِ مؤمنٍ",1]," ",["لأَكبَّهمُ اللَّهُ في النَّارِ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري وأبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1398)، وعبد الغني المقدسي في ((تحريم القتل وتعظيمه)) (82) واللفظ لهما.","bab":"إيمان › فضل الإيمان","dorar":"IAI4l1o2"},{"id":"س-03915","fp":"1b4102c91b85","stateId":751,"easy":"إذا قتلت مؤمناً متعمداً ← يأتي يوم القيامة آخذاً بك تشخب أوداجه دماً","cause":"قاتِلُ مؤمنٍ متعمِّدًا","result":"جاءَ يومَ القيامةِ آخذَهُ بيمينِهِ أو بشمالِهِ ، تشخَبُ أوداجُهُ في قِبَلِ عرشِ الرَّحمنِ ، يلزمُ قاتلَهُ بيدِهِ الأخرى ، يقولُ : يا ربِّ سَل هذا فيمَ قتلَني","explicit":true,"repOf":"س-03943","ref":"عمدة التفسير 1/552","text":["فأتاهُ رجلٌ فَناداهُ : يا عبدَ اللَّهِ بنَ عبَّاسٍ ، ما تَرى في رجُلٍ قتلَ مُؤمنًا متعمِّدًا ؟ فقالَ :  جَزَاؤُهُ جَهَنَّمُ خَالِدًا فِيهَا وَغَضِبَ اللَّهُ عَلَيْهِ وَلَعَنَهُ وَأَعَدَّ لَهُ عَذَابًا عَظِيمًا  قالَ : أفرأيتَ إِن تابَ وعملَ صالحًا ثمَّ اهتَدى ؟ قالَ ابنُ عبَّاسٍ : ثَكِلتهُ أمُّهُ ، وأنَّى لَهُ التَّوبةُ والهُدى ؟ والَّذي نَفسي بيدِهِ ! لقَد سَمِعْتُ نبيَّكم صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ : ثَكِلتهُ أمُّهُ ، ",["قاتِلُ مؤمنٍ متعمِّدًا",1]," ، ",["جاءَ يومَ القيامةِ آخذَهُ بيمينِهِ أو بشمالِهِ ، تشخَبُ أوداجُهُ في قِبَلِ عرشِ الرَّحمنِ ، يلزمُ قاتلَهُ بيدِهِ الأخرى ، يقولُ : يا ربِّ سَل هذا فيمَ قتلَني",2]," ؟ وأيمُ الَّذي نفسُ عبدِ اللَّهِ بيدِهِ ! لقد أُنْزِلَت هذِهِ الآيةُ ، فما نسخَتها مِن آيةٍ حتَّى قُبِضَ نبيُّكم صلَّى اللَّهُ عليهِ وسلَّمَ ، وما نَزل بعدَها مِن بُرهانٍ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (2621)، وأحمد (1941)، وابن أبي عاصم في ((الديات)) (8) واللفظ لهم","bab":"تفسير آيات › سورة النساء","dorar":"42ignlne"},{"id":"س-04553","fp":"39e7ae6bd607","stateId":751,"easy":"إذا سللت سيفك على الأمة ← فلجهنم باب لك","cause":"لمن سلَّ سيفَه على أمتي","result":"لجهنَّمَ سبعةُ أبوابٍ بابٌ منها","explicit":true,"ref":"تخريج المسند لشاكر 8/56","srcLabel":"الترمذي","text":[["لجهنَّمَ سبعةُ أبوابٍ بابٌ منها",2]," ",["لمن سلَّ سيفَه على أمتي",1]," أو قال أمةِ محمدٍ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (3123)، والبزار (5372)، وابن حبان في ((المجروحين)) (1/248) باختلاف يسير","bab":"جهنم › شدة نار جهنم وبعد قعرها","dorar":"VniSFZF2"},{"id":"س-04853","fp":"4c9ae7fff664","stateId":751,"easy":"إذا اجتمع أهل السماء والأرض على قتل امرئ ظلماً ← لعذبهم الله","cause":"اجتمع أهلُ السَّماءِ والأرضِ على قتْلِ امرئٍ","result":"لعذَّبهم اللهُ","explicit":true,"ref":"الترغيب والترهيب 3/276","srcLabel":"الطبراني","text":["قُتِل بالمدينةِ قتيلٌ على عهدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم لم يعلمْ من قتله فصعِد النَّبيُّ صلَّى اللهُ عليه وسلَّم المنبرَ فقال يا أيُّها النَّاسُ يُقتلُ قتيلٌ وأنا فيكم ولا يُعلمُ من قتله لو ",["اجتمع أهلُ السَّماءِ والأرضِ على قتْلِ امرئٍ",1]," ",["لعذَّبهم اللهُ",2]," إلَّا أن يفعلَ ما يشاءُ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني (12/133) (12681)، وابن عدي في ((الكامل في الضعفاء)) (5/367)، والبيهقي (16287) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"N7ClFSYU"},{"id":"س-05144","fp":"8914ff845868","stateId":751,"easy":"إذا اطمأن إليك رجل ثم قتلته ← يُنصب لك يوم القيامة لواء غدر","cause":"إذا اطمأنَّ الرَّجلُ إلى الرَّجلِ، ثمَّ قتَلَه بعْدَما اطمَأنَّ إليه","result":"نُصِبَ له يَومَ القيامةِ لِواءُ غَدرٍ","explicit":true,"otherNeedIds":[44],"ref":"المستدرك على الصحيحين 8251","srcLabel":"النسائي","text":["عن عامرِ بنِ شدَّادٍ، قال: كنتُ أُبطِنُ شَيئًا بالكذَّابِ أدْخُلُ عليه بسَيفي، فدخَلْتُ عليه ذاتَ يوْمٍ، فقال: جِئتَني واللهِ، ولقدْ قام جِبريلُ عن هذا الكُرسيِّ، فأهْوَيْتُ إلى قائمِ سَيفي، فقلْتُ: ما أنتَظِرُ أنْ أمشِيَ بيْن رأْسِه وجسَدِه حتَّى ذكَرتُ حدَيثًا حدَّثَناه عمْرُو بنُ الحَمِقِ رَضيَ اللهُ عنه قال: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["إذا اطمأنَّ الرَّجلُ إلى الرَّجلِ، ثمَّ قتَلَه بعْدَما اطمَأنَّ إليه",1],"؛ ",["نُصِبَ له يَومَ القيامةِ لِواءُ غَدرٍ",2],"."],"grade":"صحيح","narrator":"عمرو بن الحمق","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن ماجه (2688)، والنسائي في ((الكبرى)) (8688)، وابن أبي شيبة في ((مسنده)) (863) جميعهم باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"CUNTNVs3"},{"id":"س-07280","fp":"7822a2d47330","stateId":751,"easy":"إذا التقيت مع مسلم بسيفيكما فقتل أحدكما الآخر ← دخلتما النار","cause":"ما مَن مُسلِمَينِ التقَيا بسَيفَيهما، فقَتَلَ أحَدُهما الآخَرَ","result":"إلَّا دَخَلا جَميعًا النَّارَ","explicit":true,"repOf":"س-01561","ref":"تخريج المسند لشعيب 19609","text":["أنَّ أبا موسى الأشعَريَّ كان له أخٌ يُقالُ له: أبو رُهمٍ، وكان يَتسرَّعُ في الفِتنةِ، وكان الأشعَريُّ يَكرَهُ الفِتنةَ، فقال له: لَولا ما أبلَغتَ إليَّ ما حَدَّثتُكَ إنِّي سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["ما مَن مُسلِمَينِ التقَيا بسَيفَيهما، فقَتَلَ أحَدُهما الآخَرَ",1]," ",["إلَّا دَخَلا جَميعًا النَّارَ",2],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي (4124)، وأحمد (19609) واللفظ له","bab":"فتن › ظهور الفتن","dorar":"8RY7vHKe"},{"id":"س-02433","fp":"19504432244c","stateId":751,"easy":"إذا وأدت ولدك ← فأنت في النار","cause":"الوائدةَ","result":"فإنَّهما في النارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04991","ref":"التمهيد 18/119","text":["أتيتُ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ أنا وأخي فقلنا يا رسولَ اللهِ إنَّ أُمنا ماتتْ في الجاهليةِ وكانتْ تُقري الضيفَ وتصلُ الرحمَ وتفعلُ وتفعلُ فهلْ يَنفعُها مِنْ عملِها ذلكَ شيءٌ قال لا قال فقلْنا إنَّ أُمنا ولدتْ أختًا لنا في الجاهليةِ لمْ تبلغْ الحنثَ فهلْ ذلكَ نافعُ أختَنا فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ أرأيتمُ ",["الوائدةَ",1]," والموؤدةَ ",["فإنَّهما في النارِ",2]," إلا أنْ تُدركَ الوائدةُ الإسلامَ فيغفرُ اللهُ لها"],"grade":"صحيح","narrator":"سلمة بن يزيد الجعفي","muhaddith":"صحيح من جهة الإسناد","takhrij":"أخرجه أحمد (15965)","bab":"إسلام › فضل الشهادتين","dorar":"fEak09qd","merged":2,"otherRefs":["عمدة القاري 8/44 (صحيح)"]},{"id":"س-04989","fp":"b9eeed997772","stateId":751,"easy":"إذا قتلت صادقاً ← دخلت النار","cause":"إِن كانَ صادقًا، ثمَّ قتلتَهُ","result":"دخَلتَ النَّارَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الصحيح المسند 1257","srcLabel":"أبو داود","text":["قُتِلَ رجلٌ على عَهْدِ النَّبيِّ - صلَّى اللَّهُ عليهِ وعلى آلِهِ وسلَّمَ - فرُفِعَ ذلِكَ إلى النَّبيِّ صلَّى اللَّهُ عليهِ وعلى آلِهِ وسلَّمَ فدفعَهُ إلى وليِّ المقتولِ، فقالَ القاتلُ: يا رسولَ اللَّهِ، ما أرَدتُ قتلَهُ، قالَ: فقالَ رسولُ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ للوليِّ: أما إنَّهُ ",["إِن كانَ صادقًا، ثمَّ قتلتَهُ",1],"، ",["دخَلتَ النَّارَ",2]," قالَ: فخلَّى سَبيلَهُ، قالَ: وَكانَ مَكْتوفًا بنِسعةٍ، فخرجَ يجرُّ نِسعتَهُ فسُمِّيَ ذا النِّسعَةِ ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (4498)، والترمذي (1407)، والنسائي (4722)، وابن ماجه (2690)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"BnTICpb7","merged":2,"otherRefs":["تخريج شرح السنة 10/ 162 (صحيح)"]},{"id":"س-04292","fp":"18a0c94d16a4","stateId":751,"easy":"إذا أمّنت رجلاً ثم قتلته ← وجبت لك النار وإن كان كافراً","cause":"مَن أمَّنَ رجلًا ثمَّ قتلَهُ","result":"وجبَت لَهُ النَّارُ وإن كانَ المقتولُ كافِرًا","explicit":true,"otherNeedIds":[28],"ref":"تاريخ الإسلام 13/238","srcLabel":"الطبراني","text":[["مَن أمَّنَ رجلًا ثمَّ قتلَهُ ",1],["وجبَت لَهُ النَّارُ وإن كانَ المقتولُ كافِرًا",2]],"grade":"حسن","narrator":"معاذ","muhaddith":"[روي  بإسناد صالح عن عمرو بن الحمق]","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (2/ 215)، والطبراني (20/ 41) (64)، وابن عدي في ((الكامل في الضعفاء)) (5/ 138) بلفظه.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"pXoQnqU1"},{"id":"س-07882","fp":"bb6c235fb934","stateId":751,"easy":"إذا وأدت في الجاهلية ولم تسلم ← فأنت في النار","cause":"وقد وَأَدَتْ في الجاهليَّةِ","result":"أُمُّكُما في النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 3428","srcLabel":"أحمد","text":["جاءَ ابنا مُلَيْكةَ، وهما مِنَ الأنصارِ، فقالا: يا رسولَ اللهِ، إنَّ أُمَّنا تَحفظُ على البَعْلِ، وتُكرِمُ الضَّيفَ، ",["وقد وَأَدَتْ في الجاهليَّةِ",1]," فأين أُمُّنا؟ قالَ: «",["أُمُّكُما في النَّارِ",2],"». فقاما قد شَقَّ ذلك عليهِما فدَعاهُما رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فرَجَعا فقالَ: «إنَّ أُمِّي مع أُمِّكُما». فقالَ منافقٌ مِنَ النَّاسِ لي: ما يُغني هذا عن أُمِّهِ إلَّا ما يُغني ابنا مُلَيْكةَ عنْ أُمِّهما ونحن نَطَأُ عَقِبيهِ، فقالَ رَجلٌ شابٌّ مِنَ الأنصارِ لمْ أرَ رَجلًا كان أكثرَ سؤالًا لرسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ منه: يا رسولَ اللهِ، إنَّ أبَواكَ في النَّارِ؟ قالَ: فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «ما سألتُهُما ربِّي فيُعطيني فيهما، وإنِّي لقائمٌ يومئذٍ المَقامَ المحمودَ». قالَ: فقالَ المنافقُ للشَّابِ الأنصاريِّ: سلْهُ وما المقامُ المحمودُ؟ قالَ: يا رسولَ اللهِ، وما المقامُ المحمودُ؟ قالَ: «يومَ يَنزلُ اللهُ فيه على كُرسيِّهِ يَئطُّ به كما يَئطُّ به الرَّحْلُ مِن تضايُقِهِ كسَعةِ ما بيْنَ السَّماءِ والأرضِ، ويُجاءُ بكم حُفاةً عُراةً غُرلًا، فيكونُ أوَّلَ مَنْ يُكْسى إبراهيمُ، يقولُ اللهُ عزَّ وجلَّ: اكسُوا خليلي رَيْطَتينِ بَيضاوَيْنِ مِن رياطِ الجنَّةِ، ثُمَّ أُكْسى على أَثرِهِ فأقومُ عن يمينِ اللهِ عزَّ وجلَّ مَقامًا يَغبِطُني فيه الأوَّلونَ والآخرونَ، ويُشقُّ لي نَهَرٌ مِنَ الكوثرِ إلى حَوْضي». قالَ: يقولُ المنافقُ: لمْ أسمعْ كاليومِ قطُّ، لقَلَّ ما جرى نَهَرٌ قطُّ إلَّا وكان في فخَّارةٍ أوْ رَضْراضٍ، فسَلْه فيما يجري النَّهرُ؟ قالَ: «في حالةٍ مِنَ المِسكِ ورَضْراضٍ». قالَ: يقولُ المنافقُ: لمْ أسمعْ كاليومِ قطُّ، لقَلَّ ما جرى نَهَرٌ قطُّ إلَّا كان له نباتٌ. قالَ: «نَعَمْ». قالَ: ما هو؟ قالَ: «قُضبانُ الذَّهبِ». قالَ: يقولُ المنافقُ: لمْ أسمعْ كاليومِ قطُّ، واللهِ ما نَبَتَ قَضيبٌ قطُّ إلَّا كان له ثَمَرٌ، فسَلْهُ هل لتلك القُضبانِ ثمارٌ؟ قالَ: «نَعَمِ، اللُّؤلؤ والجَوْهرُ». قالَ: فقالَ المنافقُ: لمْ أسمعْ كاليومِ قطُّ، سَلْهُ عنْ شرابِ الحوضِ، فقالَ الأنصاريُّ: يا رسولَ اللهِ، وما شرابُ الحوضِ؟ قالَ: «أشدُّ بياضًا مِنَ اللَّبنِ، وأحلى مِنَ العَسلِ، مَنْ سقاهُ اللهُ منه شَربةً لمْ يَظْمأْ بعدَها، ومَنْ حَرَمَهُ لمْ يَروِ بعدَها»."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (3787) بلفظ مقارب، والبزار (1534)، والطبراني في ((الأوسط)) (2559) كلاهما مختصرا ببعض لفظه.","bab":"قيامة › الشفاعة","dorar":"v8A9yW64"},{"id":"س-07451","fp":"92fbaa3ddf71","stateId":751,"easy":"إذا اقتتلتم في الهرج ← فالقاتل والمقتول في النار","cause":"الهَرجُ، القاتِلُ والمَقتولُ","result":"في النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[59],"ref":"صحيح مسلم 2908","srcLabel":"مسلم","text":["والذي نَفسي بيَدِه، لا تَذهَبُ الدُّنيا حتَّى يَأتيَ على النَّاسِ يَومٌ لا يَدري القاتِلُ فيمَ قَتَلَ، ولا المَقتولُ فيمَ قُتِلَ. فقيلَ: كيفَ يَكونُ ذلك؟ قال: ",["الهَرجُ، القاتِلُ والمَقتولُ",1]," ",["في النَّارِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2908)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"dIGLYggF"},{"id":"س-07870","fp":"57719aadce58","stateId":751,"easy":"إذا أمرك أحد بقتل ظلماً ففعلت ← تُقذفان في النار جميعاً","cause":"أَمَرِني هذَا","result":"فيؤْخَذُ بأيديهِما جميعًا فيُقْذَفانِ في النارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"مجمع الزوائد 7/302","srcLabel":"الطبراني","text":["يُؤْتَى بالقاتِلِ والمقتولُ يومَ القيامَةِ فيقولُ أيْ رَبِّ سلْ هذا فيمَ قَتَلَني فيقولُ أيْ ربِّ ",["أَمَرِني هذَا",1]," ",["فيؤْخَذُ بأيديهِما جميعًا فيُقْذَفانِ في النارِ",2]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"رجاله كلهم ثقات","takhrij":"أخرجه الطبراني كما في ((جامع المسانيد)) (12098) واللفظ له، وأبو نعيم في ((الحلية)) (7/ 132)، وابن أبي عاصم في ((الديات)) (صـ9) بنحوه.","bab":"قيامة › الحساب والقصاص","dorar":"NfGEGbpV"},{"id":"س-06232","fp":"3751ed24d4a5","stateId":752,"easy":"إذا أصبت شيئاً بغير إذن ← تأتي بما غللت يوم القيامة","cause":"لا تُصيبنَّ شيئًا بغيرِ إذني","result":"يَأْتِ بِمَا غَلَّ يَوْمَ الْقِيَامَةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"العلل الكبير 200","srcLabel":"الترمذي","text":["بعثني رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فلمَّا سِرتُ أرسَل في أثري فرددْتُ فقال : أتدري لم بعثتُ إليك ؟ ",["لا تُصيبنَّ شيئًا بغيرِ إذني",1]," فإنَّه غُلولٌ { وَمَنْ يَغْلُلْ ",["يَأْتِ بِمَا غَلَّ يَوْمَ الْقِيَامَةِ",2]," } لهذا دعوْتُك فامضِ لعملِك"],"grade":"حسن","narrator":"معاذ بن جبل","muhaddith":"حسن","takhrij":"أخرجه الترمذي (1335) واللفظ له، والبزار (2673)، والطبراني (20/128) (259)","bab":"سرايا › تأمير الأمراء على البعوث والسرايا ووصيتهم","dorar":"65J5adXY"},{"id":"س-02988","fp":"006ff451f919","stateId":752,"easy":"إذا غللت بعيراً أو شاة ← تأتي يوم القيامة تحمله","cause":"مَن غَلَّ فيها بَعيرًا أو شاةً","result":"أتى به يَحمِلُه يَوْمَ القِيامةِ","explicit":true,"star":true,"ref":"الأحاديث المختارة 9 / 18","srcLabel":"متفق عليه","text":["«أنَّه تَذاكَرَ هو وعُمَرُ بنُ الخَطَّابِ رَضيَ اللهُ عنه يَوْمًا الصَّدَقةَ، فقالَ عُمَرُ: أَلَمْ تَسمَعْ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ حينَ ذَكَرَ غُلولَ الصَّدَقةِ أنَّه: ",["مَن غَلَّ فيها بَعيرًا أو شاةً",1]," ",["أتى به يَحمِلُه يَوْمَ القِيامةِ",2],"؟ قالَ عَبْدُ اللهِ بنُ أُنَيْسٍ: بَلى»."],"grade":"صحيح","narrator":"عبدالله بن أنيس الجهني","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إيمان › الوعيد","dorar":"l3sJrNLR","merged":3,"otherRefs":["السلسلة الصحيحة 2354 (صحيح)","صحيح الجامع 6409 (صحيح)"]},{"id":"س-05069","fp":"c68ba4e2ccf8","stateId":752,"easy":"إذا أخذت شيئاً بغير حقه ← تأتي يوم القيامة تحمله على عاتقك","cause":"لا يأخُذُ أحدٌ منكم شيئًا بغيرِ حقِّه","result":"إلَّا جاء يومَ القيامةِ يحمِلُه على عاتقِه","explicit":true,"star":true,"similar":["س-01773","س-05119","س-01767"],"ref":"تخريج صحيح ابن حبان 4515","srcLabel":"متفق عليه","text":["استعمَل رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ابنَ اللُّتْبِيَّةِ على الصَّدقةِ فلمَّا جاء حاسَبه النَّبيُّ صلَّى اللهُ عليه وسلَّم فقال: هذا لكم وهذه هديَّةٌ أُهديت إليَّ فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ( ألا جلَسْتَ في بيتِ أبيك وأمِّك حتَّى تأتيَك هديَّتُك ) فلمَّا صلَّى رسولُ اللهِ صلَّى اللهُ عليه وسلَّم الظُّهرَ قام فخطَب فحمِد اللهَ وأثنى عليه ثمَّ قال: ( أمَّا بعدُ ما بالُ أقوامٍ نُولِّيهم أمورًا ممَّا ولَّانا اللهُ ونستعمِلُهم على أمورٍ ممَّا ولَّاني اللهُ ثمَّ يأتي أحدُهم فيقولُ: هذا لكم وهذه أُهديت إليَّ ألا جلَس في بيتِ أبيه وأمِّه حتَّى تأتيَه هديَّتُه والَّذي نفسُ محمَّدٍ بيدِه ",["لا يأخُذُ أحدٌ منكم شيئًا بغيرِ حقِّه",1]," ",["إلَّا جاء يومَ القيامةِ يحمِلُه على عاتقِه",2]," فلا أعرِفَنَّ رجلًا يحمِلُ على عنقِه يومَ القيامةِ بعيرًا له رُغاءٌ أو بقرةً لها خُوَارٌ أو شاةً تيعَرُ ) ثمَّ بسَط يدَه حتَّى رأَيْتُ بياضَ إِبْطيه بَصْرَ عيني وسَمْعَ أذني ثمَّ قال: ( ألا هل بلَّغْتُ ـ ثلاثًا ) الشَّهيدُ على ذلك زيدُ بنُ ثابتٍ الأنصاريُّ يحُكُّ مَنكِبي مَنكِبَه"],"grade":"صحيح","narrator":"أبو حميد الساعدي","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (6979)، ومسلم (1832) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"KDV1Rm55","merged":2,"otherRefs":["تخريج مشكل الآثار 4338 (حسن)"]},{"id":"س-03621","fp":"b329504b3ba5","stateId":752,"easy":"إذا كتمت مخيطاً من عمل وُليته ← فهو غُلّ تأتي به يوم القيامة","cause":"مَنِ استَعمَلْناه منكم على عملٍ فكتَمَنا مِخيَطًا","result":"فهو غُلٌّ يَأْتي به يومَ القيامةِ، فقامَ رَجلٌ منَ القومِ آدَمُ طُوالٌ منَ الأنصارِ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 17723","srcLabel":"مسلم","text":[["مَنِ استَعمَلْناه منكم على عملٍ فكتَمَنا مِخيَطًا، ",1],["فهو غُلٌّ يَأْتي به يومَ القيامةِ، فقامَ رَجلٌ منَ القومِ آدَمُ طُوالٌ منَ الأنصارِ",2],"، فقال: لا حاجةَ لي في عمَلِكَ، فقال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: لمَ؟ قال: إنِّي سمِعْتُكَ آنِفًا تقولُ، قال: وأنا أقولُ الآنَ: مَنِ استَعمَلْناه منكم على عمَلٍ، فلْيأتِ بقَليلِه وكَثيرِه، فإنْ أُتيَ بشيءٍ أخَذَه، وإنْ نُهيَ عنه انْتَهى."],"grade":"صحيح","narrator":"عدي بن عميرة الكندي","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (1833) باختلاف يسير","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"snN7lIU6","merged":3,"otherRefs":["تخريج صحيح ابن حبان 5078 (صحيح)","صحيح ابن خزيمة 4/ 91 (صحيح)"]},{"id":"س-01773","fp":"7e8afdfa230f","stateId":752,"easy":"إذا أخذت من المال العام شيئاً بغير حقه ← تلقى الله يوم القيامة تحمله","cause":"لا يَأخُذُ أحَدٌ مِنكُم منها شيئًا بغيرِ حَقِّه","result":"إلَّا لَقيَ اللَّهَ تَعالى يَحمِلُه يَومَ القيامةِ","explicit":true,"repOf":"س-05069","ref":"صحيح مسلم 1832","text":["استَعمَلَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم رَجُلًا مِنَ الأَزْدِ على صَدَقاتِ بَني سُلَيمٍ، يُدعى ابنَ الأُتْبيَّةِ، فلَمَّا جاءَ حاسَبَه، قال: هذا مالُكُم، وهذا هَديَّةٌ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: فهَلَّا جَلَستَ في بَيتِ أبيكَ وأُمِّكَ حتَّى تَأتيَكَ هَديَّتُكَ إن كُنتَ صادِقًا! ثُمَّ خَطَبَنا فحَمِدَ اللَّهَ، وأثنى عليه، ثُمَّ قال: أمَّا بَعدُ، فإنِّي أستَعمِلُ الرَّجُلَ مِنكُم على العَمَلِ ممَّا ولَّاني اللهُ، فيَأتي فيَقولُ: هذا مالُكُم، وهذا هَديَّةٌ أُهديَت لي، أفلا جَلَسَ في بَيتِ أبيه وأُمِّه حتَّى تَأتيَه هَديَّتُه إن كان صادِقًا! واللَّهِ ",["لا يَأخُذُ أحَدٌ مِنكُم منها شيئًا بغيرِ حَقِّه",1]," ",["إلَّا لَقيَ اللَّهَ تَعالى يَحمِلُه يَومَ القيامةِ",2],"، فلأعرِفَنَّ أحَدًا مِنكُم لَقيَ اللَّهَ يَحمِلُ بَعيرًا له رُغاءٌ، أو بَقَرةً لَها خوارٌ، أو شاةً تَيعَرُ، ثُمَّ رَفَعَ يَدَيه حتَّى رُئيَ بَياضُ إبْطَيه، ثُمَّ قال: اللَّهُمَّ هل بَلَّغتُ؟ بَصُرَ عَيني، وسَمِعَ أُذُني. وفي حَديثِ ابنِ نُمَيرٍ: تَعلَمُنَّ واللَّهِ، والذي نَفسي بيَدِه، لا يَأخُذُ أحَدُكُم منها شيئًا. وزادَ في حَديثِ سُفيانَ، قال: بَصُرَ عَيني، وسَمِعَ أُذُنايَ، وسَلوا زَيدَ بنَ ثابِتٍ؛ فإنَّه كان حاضِرًا مَعي. وفي روايةٍ: أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم استَعمَلَ رَجُلًا على الصَّدَقةِ، فجاءَ بسَوادٍ كَثيرٍ، فجَعَلَ يقولُ: هذا لَكُم، وهذا أُهديَ إليَّ، فذَكَرَ نَحوَه. قال عُروةُ: فقُلتُ لأبي حُمَيدٍ السَّاعِديِّ: أسَمِعتَه مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم؟ فقال: مِن فيه إلى أُذُني."],"grade":"صحيح","narrator":"أبو حميد الساعدي","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6979)، ومسلم (1832) .","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"tf6pAYlR"},{"id":"س-04490","fp":"b69637df8127","stateId":752,"easy":"إذا غللت ← فالغلول خزي عليك يوم القيامة فأدّ الخيط والمخيط","cause":"إيَّاكم والغُلولَ","result":"فإنَّ الغُلولَ خِزْيٌ على صاحِبِه يَوْمَ القِيامةِ، فأدُّوا الخَيْطَ والمِخْيَطَ وما فَوْقَ ذلك، وجاهِدوا في اللهِ القَريبَ والبَعيدَ في الحَضَرِ والسَّفَرِ، فإنَّ الجِهادَ بابٌ مِن الجنَّةِ، إنَّه يُنَجِّي","explicit":true,"similar":["س-05225","س-07872","س-04051","س-05032","س-01794","س-04849"],"ref":"الأحاديث المختارة 8 / 280","srcLabel":"متفق عليه","text":["«كانَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ يَأخُذُ الوَبَرةَ مِن جَنْبِ البَعيرِ مِن المَغنَمِ ثُمَّ يقولُ: (ما لي فيه إلَّا مِثلُ ما لأحَدِكم) ثُمَّ يقولُ: (",["إيَّاكم والغُلولَ؛ ",1],["فإنَّ الغُلولَ خِزْيٌ على صاحِبِه يَوْمَ القِيامةِ، فأدُّوا الخَيْطَ والمِخْيَطَ وما فَوْقَ ذلك، وجاهِدوا في اللهِ القَريبَ والبَعيدَ في الحَضَرِ والسَّفَرِ، فإنَّ الجِهادَ بابٌ مِن الجنَّةِ، إنَّه يُنَجِّي",2]," صاحِبَه مِن الهَمِّ والغَمِّ، وأقيموا حُدودَ اللهِ في القَريبِ والبَعيدِ، ولا تَأخُذْكم في اللهِ لَوْمةُ لائِمٍ)»."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"جهاد › فضل الجهاد","dorar":"6hPpVwtc"},{"id":"س-05119","fp":"84e15fa7051e","stateId":752,"easy":"إذا أخذت من الغنيمة شيئاً ← تأتي به يوم القيامة على رقبتك تحمله","cause":"لا يَأخُذُ أحدٌ منه شَيئًا","result":"إلَّا جاءَ به على رَقَبتِهِ يَحمِلُهُ يَومَ القيامةِ، بَعيرًا له رُغاءٌ، أو بَقَرةً لها خوارٌ، أو شاةً تَيْعَرُ","explicit":true,"repOf":"س-05069","ref":"تخريج مشكل الآثار 4340","text":["استَعمَلَ رسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ رَجُلًا مِنَ الأزْدِ يُقالُ له ابنُ الأُتبِيَّةِ على صَدَقةٍ، فلمَّا قدِمَ قال: هذا لكم، وهذا أُهديَ إليَّ. فقامَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ على المِنبَرِ، فحمِدَ اللهَ عزَّ وجلَّ، وأثْنى عليه، ثم قال: ما بالُ العامِلِ نَبعَثُهُ فيَجيءُ فيَقولُ: هذا لكم، وهذا أُهديَ إليَّ، فهَلَّا جلَسَ في بَيتِ أُمِّهِ أو بَيتِ أبيهِ فيَنظُرَ مَن يُهدي إليه، والذي نفْسُ مُحمَّدٍ بيَدِهِ، ",["لا يَأخُذُ أحدٌ منه شَيئًا",1]," ",["إلَّا جاءَ به على رَقَبتِهِ يَحمِلُهُ يَومَ القيامةِ، بَعيرًا له رُغاءٌ، أو بَقَرةً لها خوارٌ، أو شاةً تَيْعَرُ",2],". ثم رفَعَ يَدَيْهِ حتى رأيْنا عُقدةَ إبْطَيْهِ، فقال: اللَّهمَّ هل بلَّغتُ، اللَّهمَّ هل بلَّغتُ، اللَّهمَّ هل بلَّغتُ."],"grade":"صحيح","narrator":"أبو حميد الساعدي","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (2597)، ومسلم (1832) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"MFDLHhr8"},{"id":"ق-0182","fp":"3005f0c9fdc4","stateId":752,"easy":"الغلول ← يأتي بما غلّ يوم القيامة","cause":"الغلول","result":"يأتي بما غلّ يوم القيامة","explicit":true,"ref":"سورة آل عمران: 161","srcLabel":"القرآن الكريم","quran":{"s":3,"from":161,"to":161,"text":"وَمَا كَانَ لِنَبِيٍّ أَنْ يَغُلَّ وَمَنْ يَغْلُلْ يَأْتِ بِمَا غَلَّ يَوْمَ الْقِيَامَةِ ثُمَّ تُوَفَّى كُلُّ نَفْسٍ مَا كَسَبَتْ وَهُمْ لَا يُظْلَمُونَ (161)","hl":[[35,89,1]]}},{"id":"س-02958","fp":"8ceb41a12c80","stateId":752,"easy":"إذا غللت ولو شراكين ← يُعدّ لك مثلهما في النار","cause":"أصَبْتُ يومَئذٍ شِراكينِ","result":"يُعدَّدُ لك مِثلُهما في نارِ جهنَّمَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح ابن حبان 4852","srcLabel":"متفق عليه","text":["أهدى رفاعةُ لرسولِ اللهِ صلَّى اللهُ عليه وسلَّم غلامًا فخرَج به معه إلى خيبرَ فأتى سهمٌ غَرْبٌ فقتَله فقُلْنا: هنيئًا له الجنَّةُ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( والَّذي نفسي بيدِه الشَّملةُ لَتحترقُ عليه الآنَ في النَّارِ غَلَّها مِن المسلِمينَ يومَ خيبرَ ) فقال رجلٌ مِن الأنصارِ: يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ",["أصَبْتُ يومَئذٍ شِراكينِ",1]," قال: ( ",["يُعدَّدُ لك مِثلُهما في نارِ جهنَّمَ",2]," )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن أبي شيبة (33537) واللفظ له، والبخاري (‌4234)، ومسلم (‌115) بنحوه مطولا.","bab":"إيمان › الوعيد","dorar":"7AfObEXp","merged":2,"otherRefs":["تخريج زاد المعاد 3/307 (صحيح)"]},{"id":"س-05660","fp":"479d70857214","stateId":752,"easy":"إذا تخوضت في مال الله ورسوله بغير حق ← فلك النار","cause":"مُتَخَوِّضٍ في مالِ اللهِ ورَسولِه","result":"له النَّارُ","explicit":true,"similar":["س-07332"],"ref":"تخريج المسند لشعيب 27055","srcLabel":"أحمد","text":["عن خَولةَ، أنَّها سَمِعَت حَمزةَ يُذاكِرُ النَّبيَّ صلَّى اللهُ عليه وسلَّم الدُّنيا، فقال: «إنَّ الدُّنيا حُلوةٌ خَضِرةٌ، ورُبَّ ",["مُتَخَوِّضٍ في مالِ اللهِ ورَسولِه",1],"، ",["له النَّارُ",2],"»."],"grade":"صحيح","narrator":"خولة","muhaddith":"صحيح","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"y2vsJ1oj","merged":3,"otherRefs":["الأمالي المطلقة 179 (صحيح)","صحيح البخاري 3118 (صحيح)"]},{"id":"س-07332","fp":"91b4c62952a9","stateId":752,"easy":"إذا تخوضت في مال الله ورسوله فيما اشتهت نفسك ← فلك النار يوم القيامة","cause":"ورُبَّ مُتخَوِّضٍ في مالِ اللهِ عزَّ وجلَّ ورسولِه صلَّى اللهُ عليه وسلَّمَ فيما اشتهَتْ نَفْسُه","result":"له النَّارُ يومَ القيامةِ","explicit":true,"repOf":"س-05660","ref":"تخريج مشكل الآثار 4887","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قال: إنَّ هذا المالَ خَضِرةٌ حُلْوةٌ، فمَن أخَذَه بحَقِّه بُورِكَ له فيه، ",["ورُبَّ مُتخَوِّضٍ في مالِ اللهِ عزَّ وجلَّ ورسولِه صلَّى اللهُ عليه وسلَّمَ فيما اشتهَتْ نَفْسُه",1],"، ",["له النَّارُ يومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في  ((شرح مشكل الآثار)) (4887) واللفظ له، وأبو يعلى (6606) باختلاف يسير.، وابن أبي خيثمة في ((التاريخ الكبير- السفر الثاني)) (1783) باختلاف يسير وزيادة في آخره.","bab":"فتن › فتنة المال","dorar":"pmFHNzzU","merged":2,"otherRefs":["صحيح الترمذي 2374 (صحيح)"]},{"id":"س-01767","fp":"40855828ee28","stateId":752,"easy":"إذا أخذت شيئاً بغير حق ← تأتي الله يوم القيامة تحمله","cause":"لا يأخذُ أحدٌ منكم شيئاًَ بغيرِ حقٍّ","result":"إلا أتى اللهَ ليحملَه - يعني يومَ القيامةِ","explicit":true,"repOf":"س-05069","ref":"غاية المرام 461","text":["وبعث الرسولُ واليًا يجمعُ صدقاتِ الأزدِ - قبيلة - فلما جاء إلى الرسولِ أمسك بعضَ ما معه وقال : هذا لكم وهذا لي هديةٌ . فغضب النبيُّ وقال : ألا جلستَ في بيتِ أبيك وبيتِ أمِّك حتى تأتيَك هديتُك إن كنتَ صادقًا ؟ ! ثم قال : مالي أستعملُ الرجلَ منكم فيقولُ : هذا لكم . وهذا لي هديةٌ ؟ ألا جلس في بيتِ أمِّه ليُهدَى له ! والذي نفسي بيدِه ، ",["لا يأخذُ أحدٌ منكم شيئاًَ بغيرِ حقٍّ",1]," ",["إلا أتى اللهَ ليحملَه - يعني يومَ القيامةِ",2]," - فلا يأتين أحدُكم يوم القيامةِ ببعيرٍ له رغاءٌ ، أو بقرةٍ لها خوارٌ ، أو بشاةٍ تيعرُ ! ! ثم رفع يديه حتى رئى بياضَ إبطيه ثم قال : اللهمَّ هل بلغتُ ؟"],"grade":"صحيح","muhaddith":"صحيح","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"kuvyLI7v"},{"id":"س-04879","fp":"bd1ac692b91a","stateId":752,"easy":"إذا اقتطعت من حظ صاحبك ذراعاً ← تُطوّقه من سبع أرضين يوم القيامة","cause":"فيَقْتَطِعُ أحدُهما مِنْ حظِّ صاحبِهِ ذراعًا ، فإذا اقتطعَهُ","result":"طُوِّقَهُ مِنْ سبعِ أرَضينَ يومَ القيامَةِ","explicit":true,"similar":["س-05296"],"ref":"الجامع الصغير 1177","srcLabel":"الجامع الصغير","text":["أعظمُ الغُلولِ عندَ اللهِ تعالى يومَ القيامَةِ ، ذراعٌ منَ الأرضِ ، تجدونَ الرجلََّينِ جارَينِ في الأرضِ أوْ في الدارِ ، ",["فيَقْتَطِعُ أحدُهما مِنْ حظِّ صاحبِهِ ذراعًا ، فإذا اقتطعَهُ",1]," ",["طُوِّقَهُ مِنْ سبعِ أرَضينَ يومَ القيامَةِ",2]," ."],"grade":"صحيح","narrator":"أبو مالك الأشجعي سعد بن طارق","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"cIfGeib7"},{"id":"س-05225","fp":"f95ec7668ea1","stateId":752,"easy":"إذا غللت ← تأتي يوم القيامة بما غللت من بقر وغنم ومال","cause":"الغالَّ","result":"يأتي بما غلَّ من بقرٍ وغنمٍ وصامتٍ ورِقاعٍ تخفِقُ","explicit":true,"repOf":"س-04490","ref":"فتح الباري لابن رجب 3/435","text":["أنَّ ",["الغالَّ",1]," ",["يأتي بما غلَّ من بقرٍ وغنمٍ وصامتٍ ورِقاعٍ تخفِقُ",2]," ."],"grade":"صحيح","muhaddith":"صحيح.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"IKsHOPOv"},{"id":"س-07412","fp":"6b69f619c533","stateId":752,"easy":"إذا غللت ولو بردة ← رآك النبي ﷺ في النار","cause":"في بُردةٍ غَلَّها أو عَباءةٍ","result":"كَلَّا، إنِّي رَأيتُه في النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[52],"ref":"صحيح مسلم 114","srcLabel":"أحمد","text":["لَمَّا كانَ يَومُ خَيبَرَ أقبَلَ نَفَرٌ مِن صَحابةِ النَّبيِّ صلَّى اللهُ عليه وسلَّم، فقالوا: فُلانٌ شَهيدٌ، فُلانٌ شَهيدٌ، حتَّى مَرُّوا على رَجُلٍ، فقالوا: فُلانٌ شَهيدٌ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["كَلَّا، إنِّي رَأيتُه في النَّارِ",2]," ",["في بُردةٍ غَلَّها أو عَباءةٍ",1],"، ثُمَّ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: يا ابنَ الخَطَّابِ، اذهَبْ فنادِ في النَّاسِ أنَّه لا يَدخُلُ الجَنَّةَ إلَّا المُؤمِنونَ، قال: فخَرَجتُ فنادَيتُ: ألا إنَّه لا يَدخُلُ الجَنَّةَ إلَّا المُؤمِنونَ."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (203)، وابن أبي شيبة (36885)، وابن حبان (4857)، واللفظ لهم.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"dEtLw5GQ","merged":6,"otherRefs":["تخريج المسند لشعيب 12528 (صحيح)","صحيح الترمذي 1574 (صحيح)","تخريج المسند لشعيب 20736 (صحيح)","تخريج صحيح ابن حبان 4849 (صحيح)","تخريج المسند لشاكر 1/165 (صحيح)"]},{"id":"س-07872","fp":"8654d1134255","stateId":752,"easy":"إذا غللت ← تأتي به حاملاً له على ظهرك يوم القيامة","cause":"ومَن يَغلُلْ","result":"يَأتِ به حامِلًا له على ظَهرِه يَومَ القيامةِ","explicit":true,"repOf":"س-04490","ref":"فتح البيان 2/ 367","text":["(",["ومَن يَغلُلْ",1]," يَأتِ بما غَلَّ) أي ",["يَأتِ به حامِلًا له على ظَهرِه (يَومَ القيامةِ",2],")."],"grade":"صحيح","muhaddith":"[صحيح]","bab":"قيامة › الحساب والقصاص","dorar":"cOdU0bh5"},{"id":"س-04051","fp":"08071aa3b692","stateId":752,"easy":"إذا غللت شيئاً ← تأتي به يوم القيامة","cause":"فمن غَلَّ شيئًا","result":"أُتِيَ به يومَ القيامةِ","explicit":true,"repOf":"س-04490","ref":"السلسلة الصحيحة 3313","text":["إياك والذنوبَ التي لا تُغفَرُ ، ( وفي رواية : وما لا كفارةَ من الذنوبِ ) ، ",["فمن غَلَّ شيئًا",1]," ",["أُتِيَ به يومَ القيامةِ",2]," ، وأكلَ الرِّبا ؛ فمن أكل الرِّبا بُعِثَ يومَ القيامةِ مجنونًا يتخبَّطُ ، ثم قرأ :  الَّذِينَ يَأْكُلُونَ الرِّبَا لَا يَقُومُونَ إِلَّا كَمَا يَقُومُ الَّذِي يَتَخَبَّطُهُ الشَّيْطَانُ مِنَ الْمَسِّ  [ البقرة : 275 ]"],"grade":"حسن","narrator":"عوف بن مالك الأشجعي","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (18/ 60) (110)، باختلاف يسير، والخطيب في ((تاريخ بغداد)) (9/ 53)، واللفظ له دون قول:\"\"ثم قرأ: {الذين يأكلون...\"","bab":"توبة › ما يقبل فيه التوبة وما لا يقبل","dorar":"nh8Uqpyl"},{"id":"س-05032","fp":"d3fee1a54a3e","stateId":752,"easy":"إذا غللت من الغنيمة ← تأتي به يوم القيامة","cause":"هذه مِن غَنيمَةٍ كنتُ أصَبتُها","result":"لَن أقبَلَه حتى تَكونَ أنتَ الذي تُوافِيَني به يومَ القيامَةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04490","ref":"تخريج المسند لشاكر 11/178","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّم إذا أراد أنْ يُقَسِّمَ غَنيمَةً أمَر بِلالًا رضي اللهُ تَعالى عنه فنادَى ثَلاثًا فأَتى رجُلٌ بزِمامٍ مِن شَعرٍ إلى النبيِّ صلَّى اللهُ عليه وسلَّم بعدَ أنْ قَسَّم الغَنيمَةَ فقال يا رسولَ اللهِ ",["هذه مِن غَنيمَةٍ كنتُ أصَبتُها",1]," قال أما سمِعتَ بِلالًا يُنادي ثلاثًا ؟ قال: نَعَمْ قال فما منَعكَ أنْ تَأتِيَني به ؟ فاعتَلَّ له فقال النبيُّ صلَّى اللهُ عليه وسلَّم: إنِّي ",["لَن أقبَلَه حتى تَكونَ أنتَ الذي تُوافِيَني به يومَ القيامَةِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2712)، وابن حبان (4809)، والطبراني (13/516) (14397) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"K7ClToAs"},{"id":"س-05296","fp":"1e71330ea213","stateId":752,"easy":"إذا سرقت من صاحبك ذراعاً من أرض ← تُطوّقه من سبع أرضين","cause":"فيَسرِقُ أحَدُهما مِن صاحِبِه ذِراعًا مِن أرضٍ","result":"فيُطَوَّقُه مِن سَبعِ أَرَضينَ","explicit":true,"repOf":"س-04879","ref":"تخريج المسند لشعيب 22917","text":["[«أعظَمُ الغُلولِ عِندَ اللهِ يَومَ القيامةِ ذِراعٌ مِن أرضٍ يَكونُ بَينَ الرَّجُلَينِ أو بَينَ الشَّريكَينِ للدَّارِ، فيَقتَسِمانِ، ",["فيَسرِقُ أحَدُهما مِن صاحِبِه ذِراعًا مِن أرضٍ",1]," ",["فيُطَوَّقُه مِن سَبعِ أَرَضينَ",2],"»]."],"grade":"حسن","narrator":"أبو مالك الأشجعي","muhaddith":"إسناده حسن","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"vm7H9KW2"},{"id":"س-07856","fp":"244225cf23c2","stateId":752,"easy":"إذا غللت مخيطاً ← تُكلّف يوم القيامة أن تأتي به","cause":"مَنْ غلَّ مخيطًا أو خَيَّاطًا","result":"كُلِّفَ يومَ القيامةِ أن يجيءَ بهِ و ليسَ بجاءٍ","explicit":true,"ref":"الجامع الصغير 4437","srcLabel":"الطبراني","text":["رُدُّوا المِخْيَطَ والخَيَّاطَ ",["مَنْ غلَّ مخيطًا أو خَيَّاطًا",1]," ",["كُلِّفَ يومَ القيامةِ أن يجيءَ بهِ و ليسَ بجاءٍ",2]],"grade":"حسن","narrator":"المستورد بن شداد","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (20/ 303) (721) واللفظ له.","bab":"قيامة › الحساب والقصاص","dorar":"3B0dNNzu"},{"id":"س-08310","fp":"051a5cc7e924","stateId":752,"easy":"إذا وُليت الصدقة فغللت ← تجيء يوم القيامة ببعير له رغاء","cause":"بَعَثَ سَعْدَ بنَ عُبادةَ مُصَدِّقًا","result":"أن تَجيءَ يَوْمَ القِيامةِ ببَعيرٍ له رُغاءٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-08309"],"ref":"الصحيح المسند 769","srcLabel":"ابن حبان","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ ",["بَعَثَ سَعْدَ بنَ عُبادةَ مُصَدِّقًا",1],"، وقالَ: «إيَّاك يا سَعْدُ ",["أن تَجيءَ يَوْمَ القِيامةِ ببَعيرٍ له رُغاءٌ",2],"»، فقالَ: لا أَجِدُه ولا أَجيءُ به، فأَعْفاه."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح، رجاله رجال الصحيح","takhrij":"أخرجه أبو يعلى في ((معجمه)) (110)، والطبري في ((التفسير)) (6/ 206)، وابن حبان (2429) واللفظ لهم.","bab":"مناقب وفضائل › سعد بن عبادة","dorar":"jekNlYUy"},{"id":"س-01794","fp":"fee497fe4877","stateId":752,"easy":"إذا غللت شيئاً ← تأتي به يوم القيامة تحمله على عنقك","cause":"لا يَغُلُّ أحَدُكُم مِنها شيئًا","result":"إلَّا جاءَ به يَومَ القيامةِ يَحمِلُه على عُنُقِه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-04490","ref":"صحيح البخاري 6636","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم استَعمَلَ عامِلًا، فجاءَه العامِلُ حينَ فرَغَ مِن عَمَلِه، فقال: يا رَسولَ اللهِ، هذا لَكُم، وهذا أُهديَ لي. فقال له: أفَلا قَعَدتَ في بَيتِ أبيك وأُمِّك فنَظَرتَ أيُهدى لك أم لا؟! ثُمَّ قامَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم عَشيَّةً بَعدَ الصَّلاةِ، فتَشَهَّدَ وأثنى على اللهِ بما هو أهلُه، ثُمَّ قال: أمَّا بَعدُ، فما بالُ العامِلِ نَستَعمِلُه فيَأتينا فيَقولُ: هذا مِن عَمَلِكُم، وهذا أُهديَ لي؟! أفَلا قَعَدَ في بَيتِ أبيه وأُمِّه فنَظَرَ هل يُهدى له أم لا؟! فوالذي نَفسُ مُحَمَّدٍ بيَدِه ",["لا يَغُلُّ أحَدُكُم مِنها شيئًا",1]," ",["إلَّا جاءَ به يَومَ القيامةِ يَحمِلُه على عُنُقِه",2],"؛ إن كان بَعيرًا جاءَ به له رُغاءٌ، وإن كانَت بَقَرةً جاءَ بها لها خُوارٌ، وإن كانَت شاةً جاءَ بها تَيعَرُ، فقد بَلَّغتُ. فقال أبو حُمَيدٍ: ثُمَّ رَفَعَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يَدَه، حتَّى إنَّا لَنَنظُرُ إلى عُفرةِ إبْطَيه."],"grade":"صحيح","narrator":"أبو حميد الساعدي","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1832) باختلاف يسير","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"hm14eIXT","merged":4,"otherRefs":["صحيح البخاري 7174 (صحيح)","صحيح مسلم 1832 (صحيح)","صحيح ابن خزيمة 4/ 92 (صحيح)"]},{"id":"س-04849","fp":"26a90500f43d","stateId":752,"easy":"إذا غللت ← تجيء يوم القيامة وعلى رقبتك بعير له رغاء","cause":"فذَكَرَ الغُلولَ، فعَظَّمَه وعَظَّمَ أمرَه","result":"لا أُلفيَنَّ أحَدَكُم يَجيءُ يَومَ القيامةِ على رَقَبَتِه بَعيرٌ له رُغاءٌ، يقولُ: يا رَسولَ اللهِ، أغِثْني، فأقولُ: لا أملِكُ لكَ شيئًا، قد أبلَغتُكَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-04490","ref":"صحيح مسلم 1831","text":["قامَ فينا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم ذاتَ يَومٍ، ",["فذَكَرَ الغُلولَ، فعَظَّمَه وعَظَّمَ أمرَه",1],"، ثُمَّ قال: ",["لا أُلفيَنَّ أحَدَكُم يَجيءُ يَومَ القيامةِ على رَقَبَتِه بَعيرٌ له رُغاءٌ، يقولُ: يا رَسولَ اللهِ، أغِثْني، فأقولُ: لا أملِكُ لكَ شيئًا، قد أبلَغتُكَ",2],"، لا أُلفيَنَّ أحَدَكُم يَجيءُ يَومَ القيامةِ على رَقَبَتِه فرَسٌ له حَمحَمةٌ، فيَقولُ: يا رَسولَ اللهِ، أغِثْني، فأقولُ: لا أملِكُ لكَ شيئًا، قد أبلَغتُكَ، لا أُلفيَنَّ أحَدَكُم يَجيءُ يَومَ القيامةِ على رَقَبَتِه شاةٌ لَها ثُغاءٌ، يقولُ: يا رَسولَ اللهِ، أغِثْني، فأقولُ: لا أملِكُ لكَ شيئًا، قد أبلَغتُكَ، لا أُلفيَنَّ أحَدَكُم يَجيءُ يَومَ القيامةِ على رَقَبَتِه نَفسٌ لَها صياحٌ، فيَقولُ: يا رَسولَ اللهِ، أغِثْني، فأقولُ: لا أملِكُ لكَ شيئًا، قد أبلَغتُكَ، لا أُلفيَنَّ أحَدَكُم يَجيءُ يَومَ القيامةِ على رَقَبَتِه رِقاعٌ تَخفِقُ، فيَقولُ: يا رَسولَ اللهِ، أغِثْني، فأقولُ: لا أملِكُ لكَ شيئًا، قد أبلَغتُكَ، لا أُلفيَنَّ أحَدَكُم يَجيءُ يَومَ القيامةِ على رَقَبَتِه صامِتٌ، فيَقولُ: يا رَسولَ اللهِ، أغِثني، فأقولُ: لا أملِكُ لكَ شيئًا، قد أبلَغتُكَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3073)، ومسلم (1831).","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"NTy7sy0P"},{"id":"س-05283","fp":"1f6fa3f4a0c9","stateId":752,"easy":"إذا غللت ولو ديناراً ← لا يُصلّى عليك","cause":"فأصيبَت دينارٌ أو ديناران","result":"صَلُّوا على صاحِبِكم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سبل الهدى والرشاد 8/376","srcLabel":"أحمد","text":["توفِّيَ رجلٌ على عهدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقال: انظُروا داخِلةَ إزارِه «",["فأصيبَت دينارٌ أو ديناران",1],"»، فقال لنا «",["صَلُّوا على صاحِبِكم",2],"»"],"grade":"حسن","narrator":"أبو أمامة","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني ((8/ 105)) (7506) بنحوه، وأحمد (22221)، والبيهقي في ((شعب الإيمان)) (3238) مختصرا","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"veeEp5Fr"},{"id":"س-08309","fp":"775eebe8c205","stateId":752,"easy":"إذا وُليت الصدقة فغللت منها ← تأتي يوم القيامة بما غللت على رقبتك","cause":"قُمْ علَى صَدقةِ بَني فلانٍ","result":"لا تأتي يومَ القِيامةِ ببقرٍ تحمِلُه على رقَبتِك لهُ رغاءٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-08310","ref":"البحر الزخار 9/190","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ قالَ لي : ",["قُمْ علَى صَدقةِ بَني فلانٍ",1]," ، وانظُر ",["لا تأتي يومَ القِيامةِ ببقرٍ تحمِلُه على رقَبتِك لهُ رغاءٌ",2]," ، قال : اقبَل عنِّي صدقتَكَ ، فقبِلَها عنه"],"grade":"حسن","narrator":"سعد بن عبادة","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (22461)، وابن قانع في ((معجم الصحابة)) (1/ 248)، والطبراني (6/ 17)، (5363) جميعهم بلفظه.","bab":"مناقب وفضائل › سعد بن عبادة","dorar":"9l2x24yl"},{"id":"س-04987","fp":"f5e31deef986","stateId":752,"easy":"إذا غللت ← تجيء يوم القيامة على ظهرك بعير","cause":"قد أَغْلَلْتَه","result":"لا أُلْفِيَنَّك يَوْمَ القِيامةِ تَجيءُ على ظَهْرِك بَعيرٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأحكام الوسطى 2/ 185","srcLabel":"أبو داود","text":["بَعَثَني رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ساعِيًا، ثُمَّ قالَ: \"انْطَلِقْ أبا مَسْعودٍ، ",["لا أُلْفِيَنَّك يَوْمَ القِيامةِ تَجيءُ على ظَهْرِك بَعيرٌ",2]," مِن إبِلِ الصَّدَقةِ له رُغاءٌ ",["قد أَغْلَلْتَه",1],"\"، قالَ: إذًا لا أَنطَلِقُ، قالَ: \"إذًا لا أُكرِهُك\"."],"grade":"صحيح","narrator":"أبو مسعود","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (2947) بلفظه، والطبراني (17/ 247)، (688) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"JimjWMoC","merged":2,"otherRefs":["مجمع الزوائد 3/89 (صحيح)"]},{"id":"س-08093","fp":"2e9c0f94b982","stateId":752,"easy":"إذا غللت من الغنائم ← تلتهب عليك ناراً","cause":"أخَذَها مِنَ الغَنائِمِ","result":"لَتَلتَهِبُ عليه نارًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح مسلم 115","srcLabel":"متفق عليه","text":["خَرَجنا مع النَّبيِّ صلَّى اللهُ عليه وسلَّم إلى خَيبَرَ، ففَتَحَ اللهُ علينا، فلَم نَغنَمْ ذَهَبًا ولا ورِقًا، غَنِمنا المَتاعَ والطَّعامَ والثِّيابَ، ثُمَّ انطَلَقنا إلى الوادي، ومع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم عَبدٌ له وهَبَه له رَجُلٌ مِن جُذامٍ يُدعى رِفاعةَ بنَ زَيدٍ مِن بَني الضُّبَيبِ، فلَمَّا نَزَلنا الواديَ قامَ عبدُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم يَحُلُّ رَحلَه، فرُميَ بسَهمٍ، فكانَ فيه حَتفُه، فقُلنا: هَنيئًا له الشَّهادةُ يا رَسولَ اللهِ! قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: كَلَّا والذي نَفسُ مُحَمَّدٍ بيَدِه، إنَّ الشَّملةَ ",["لَتَلتَهِبُ عليه نارًا",2]," ",["أخَذَها مِنَ الغَنائِمِ",1]," يَومَ خَيبَرَ لَم تُصِبْها المَقاسِمُ، قال: ففَزِعَ النَّاسُ، فجاءَ رَجُلٌ بشِراكٍ أو شِراكَينِ، فقال: يا رَسولَ اللهِ، أصَبتُ يَومَ خَيبَرَ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: شِراكٌ مِن نارٍ، أو شِراكانِ مِن نارٍ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4234)، ومسلم (115).","bab":"مغازي › غزوة خيبر","dorar":"HZ4atbUU","merged":5,"otherRefs":["صحيح ابن حبان 4852 (صحيح)","تخريج زاد المعاد 3/307 (صحيح)","صحيح أبي داود 2711 (صحيح)","المستدرك على الصحيحين 4401 (صحيح)"]},{"id":"ق-0111","fp":"73018fd9311b","stateId":753,"easy":"العود إلى الربا ← الخلود في النار","cause":"العود إلى الربا","result":"الخلود في النار","explicit":true,"ref":"سورة البقرة: 275","srcLabel":"القرآن الكريم","quran":{"s":2,"from":275,"to":275,"text":"الَّذِينَ يَأْكُلُونَ الرِّبَا لَا يَقُومُونَ إِلَّا كَمَا يَقُومُ الَّذِي يَتَخَبَّطُهُ الشَّيْطَانُ مِنَ الْمَسِّ ذَلِكَ بِأَنَّهُمْ قَالُوا إِنَّمَا الْبَيْعُ مِثْلُ الرِّبَا وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا فَمَنْ جَاءَهُ مَوْعِظَةٌ مِنْ رَبِّهِ فَانْتَهَى فَلَهُ مَا سَلَفَ وَأَمْرُهُ إِلَى اللَّهِ وَمَنْ عَادَ فَأُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ (275)","hl":[[318,384,1]]}},{"id":"س-02989","fp":"ea0330fcf713","stateId":753,"easy":"إذا أكلت الربا ← تُبعث يوم القيامة كالمجنون يُخنق","cause":"آكلُ الرِّبا","result":"يبعثُ يومَ القيامةِ مجنونًا يُخنَقُ","explicit":true,"similar":["س-04052"],"ref":"البدور السافرة 64","srcLabel":"البدور السافرة","text":["عنِ ابنِ عباسٍ في الآيةِ  الَّذِينَ يَأْكُلُونَ الرِّبَا  قال : ",["آكلُ الرِّبا",1]," ",["يبعثُ يومَ القيامةِ مجنونًا يُخنَقُ",2]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"إيمان › الوعيد","dorar":"9hd4wAb5"},{"id":"س-04665","fp":"a194fb9ce4f5","stateId":753,"easy":"إذا أكلت الربا ← فخذ سلاحك للحرب (مع الله)","cause":"لآكلِ الرِّبا","result":"خُذ سلاحَكَ للحَربِ","explicit":true,"ref":"عمدة التفسير 1/330","srcLabel":"عمدة التفسير","text":["عنِ ابنِ عبَّاسٍ قالَ : يقالُ يومَ القيامةِ ",["لآكلِ الرِّبا",1]," : ",["خُذ سلاحَكَ للحَربِ",2]," . وقرأَ :  الَّذِينَ يَأْكُلُونَ الرِّبَا لَا يَقُومُونَ إِلَّا كَمَا يَقُومُ الَّذِي يَتَخَبَّطُهُ الشَّيْطَانُ مِنَ الْمَسِّ  قالَ : وذلِكَ حينَ يقومُ مِن قبرِهِ"],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"دفن ومقابر › عذاب القبر ونعيمه","dorar":"abs4WmHX"},{"id":"س-07426","fp":"4ed45de1ee1e","stateId":753,"easy":"إذا لم تأكل الربا (في آخر الزمان) ← يصيبك من غباره","cause":"إلَّا أكلَ الرِّبا","result":"فإنْ لمْ يَأكلْهُ ، أصابَهُ من غُبارِهِ","explicit":true,"ref":"الجامع الصغير 7513","srcLabel":"ابن ماجه","text":["لَيَأْتِيَنَّ على الناسِ زمانٌ لا يَبْقَى مِنهُمْ أحدٌ ",["إلَّا أكلَ الرِّبا",1]," ، ",["فإنْ لمْ يَأكلْهُ ، أصابَهُ من غُبارِهِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داوود (3331)، زابن ماجه (2278)، والبزار في ((مسنده)) (9562) واللفظ لهم.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"lmrTKOvE"},{"id":"س-04052","fp":"356999372314","stateId":753,"easy":"إذا أكلت الربا ← تُبعث يوم القيامة مجنوناً يتخبط","cause":"فمن أكل الرِّبا","result":"بُعِثَ يومَ القيامةِ مجنونًا يتخبَّطُ","explicit":true,"repOf":"س-02989","ref":"السلسلة الصحيحة 3313","text":["إياك والذنوبَ التي لا تُغفَرُ ، ( وفي رواية : وما لا كفارةَ من الذنوبِ ) ، فمن غَلَّ شيئًا أُتِيَ به يومَ القيامةِ ، وأكلَ الرِّبا ؛ ",["فمن أكل الرِّبا",1]," ",["بُعِثَ يومَ القيامةِ مجنونًا يتخبَّطُ",2]," ، ثم قرأ :  الَّذِينَ يَأْكُلُونَ الرِّبَا لَا يَقُومُونَ إِلَّا كَمَا يَقُومُ الَّذِي يَتَخَبَّطُهُ الشَّيْطَانُ مِنَ الْمَسِّ  [ البقرة : 275 ]"],"grade":"حسن","narrator":"عوف بن مالك الأشجعي","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (18/ 60) (110)، باختلاف يسير، والخطيب في ((تاريخ بغداد)) (9/ 53)، واللفظ له دون قول:\"\"ثم قرأ: {الذين يأكلون...\"","bab":"توبة › ما يقبل فيه التوبة وما لا يقبل","dorar":"nh8Uqpyl"},{"id":"س-04193","fp":"271aa3c22310","stateId":753,"easy":"إذا أخذت الربا بعد التحريم ← فلك النار خالداً فيها","cause":"فإن أخذَ من ذلكَ شيئًا ثمَّ عدا بعدَ ذلكَ","result":"فلهُ النَّارُ خالدًا مخلَّدًا فيها","explicit":true,"ref":"هداية الرواة 3/381","srcLabel":"أبو داود","text":["من أصيبَ بدمٍ أو خبلٍ والخبلُ الجرحُ فهوَ بالخيارِ بينَ إحدى ثلاثٍ فإن أرادَ الرَّابعةَ فخذوا على يديهِ بينَ أن يقتصَّ أو يعفوَ أو يأخذَ العقلَ ",["فإن أخذَ من ذلكَ شيئًا ثمَّ عدا بعدَ ذلكَ",1]," ",["فلهُ النَّارُ خالدًا مخلَّدًا فيها",2]],"grade":"حسن","narrator":"أبو شريح العدوي خويلد بن عمرو","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه أبو داود (4496)، وابن ماجه (2623)، وأحمد (16375)","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"mqdkpOWo"},{"id":"س-04997","fp":"b50aa374929b","stateId":753,"easy":"إذا تعاملت بالصرف الربوي ← أبشر بالنار (أثر)","cause":"مَعشَرَ الصَّيارِفةِ","result":"أَبْشِروا بالنَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الأحاديث المختارة 13 / 126","srcLabel":"متفق عليه","text":["القاسِمُ بنُ عَبْدِ الواحِدِ الوَزَّانُ، قالَ: «رَأيْتُ عَبْدَ اللهِ بنَ أبي أَوْفى في السُّوقِ في الصَّيارِفةِ، فقالَ: يا ",["مَعشَرَ الصَّيارِفةِ",1]," أَبْشِروا، قالوا: بَشَّرَك اللهُ بالجنَّةِ، بما تُبَشِّرُنا يا أبا مُحمَّدٍ؟ قالَ: قالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["أَبْشِروا بالنَّارِ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن أبي أوفى","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"2um1UZ7s"},{"id":"س-07620","fp":"5a1485f1ee44","stateId":753,"easy":"إذا أكلت الربا ← تسبح في نهر الدم وتُلقم الحجارة","cause":"آكِلُ الرِّبا","result":"رَجُلًا يَسبَحُ في نَهرٍ ويُلقَمُ الحِجارةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج المسند لشعيب 20101","srcLabel":"أحمد","text":["رَأَيتُ لَيلةَ أُسريَ بي ",["رَجُلًا يَسبَحُ في نَهرٍ ويُلقَمُ الحِجارةَ",2],"، فسَأَلتُ: ما هذا؟ فقِيلَ لي: ",["آكِلُ الرِّبا",1],"."],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"صحيح","takhrij":"أخرجه أحمد (20101) واللفظ له، والحارث في ((المسند)) (736)، والروياني في ((المسند)) (836) مطولاً","bab":"فضائل النبي وصفته ودلائل النبوة › معجزات النبي","dorar":"CzlMn5qU"},{"id":"س-07527","fp":"5b22f1fd5d9f","stateId":754,"easy":"إذا قُضي لك من حق أخيك شيئاً ← فلا تأخذه فإنما هو قطعة من النار","cause":"فمَن قضَيتُ له من حقِّ أخيهِ شَيئًا","result":"فلا يَأخُذْه، فإنَّما أقطَعُ له قِطعةً من النَّارِ يأتِي بها إِسْطامًا في عُنُقِه يومَ القِيامةِ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 26717","srcLabel":"متفق عليه","text":["جاء رجُلانِ من الأنصارِ يختَصِمانِ إلى رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ في مواريثَ بينَهما قد دُرِسَتْ، ليس بينَهما بيِّنةٌ، فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ: إنَّكم تَختَصِمونَ إليَّ، وإنَّما أنا بشَرٌ، ولعلَّ بعضَكُم أَلحَنُ بحُجَّتِه -أو قد قال: لِحُجَّتِه- من بعضٍ، فإنَّما أقضي بينَكم على نحوِ ما أسمَعُ، ",["فمَن قضَيتُ له من حقِّ أخيهِ شَيئًا، ",1],["فلا يَأخُذْه، فإنَّما أقطَعُ له قِطعةً من النَّارِ يأتِي بها إِسْطامًا في عُنُقِه يومَ القِيامةِ",2],". فبَكى الرَّجُلانِ، وقال كلُّ واحدٍ منهما: حقِّي لأخي، قال: فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ: أمَا إذْ قُلتُما، فاذهبا فاقتَسِما، ثمَّ توخَّيا الحقَّ، ثمَّ استَهِما، ثمَّ لِيَحْلِلْ كلُّ واحدٍ منكما صاحِبَه."],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"قوله: \"إنكم تختصمون إلي ... \" إلى قوله: \"فإنما أقطع له قطعة من النار\" صحيح","takhrij":"أخرجه البخاري (2680)، ومسلم (1713)، والترمذي (1339)، والنسائي (5401)، وابن ماجه (2317) مختصراً، وأبو داود (3583، 3584) مفرقاً، وأحمد (26717) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › اختصام المؤمنين إليه صلى الله عليه وسلم وحكمه عليهم","dorar":"Ip1bHpmQ","merged":8,"otherRefs":["مجموع فتاوى ابن عثيمين 121/3 (صحيح)","هداية الرواة 3/490 (حسن)","الفتح الرباني 5/2310 (صحيح)","الأم 8/185 (صحيح)","صحيح الترمذي 1339 (صحيح)","المحلى 9/422 (صحيح)","حلية الأولياء 3/261 (صحيح)"]},{"id":"س-01711","fp":"fbf74de32162","stateId":754,"easy":"إذا اقتطعت مالاً بيمين ← تلقى الله يوم القيامة أجذم","cause":"إنَّه لا يَقْتَطِعُ رَجُلٌ مالًا","result":"إلَّا لَقِيَ اللهَ عَزَّ وجَلَّ يَوْمَ القِيامةِ وهو أَجذَمُ","explicit":true,"star":true,"similar":["س-07520"],"ref":"الأحاديث المختارة 1484","srcLabel":"البخاري","text":["«أنَّ رَجُلًا مِن كِنْدةَ ورَجُلًا مِن حَضْرَمَوْتَ اخْتَصَما إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ في أرْضٍ باليَمَنِ، فقالَ الحَضْرَميُّ: يا رَسولَ اللهِ، أرْضي اغْتَصَبَها أبو هذا، فقالَ للكِنْديِّ: ما تَقولُ؟ قالَ: أقولُ إنَّ أرْضي في يَدي وَرِثْتُها مِن أبي، فقالَ للحَضْرَميِّ: هل لك مِن بَيِّنةٍ؟ قالَ: لا، ولكنْ يَحلِفُ يا رَسولَ اللهِ بالَّذي لا إلهَ إلَّا هو ما يَعلَمُ أنَّها أرْضي اغْتَصَبَها أبوه، فتَهَيَّأَ الكِنْديُّ لليَمينِ، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["إنَّه لا يَقْتَطِعُ رَجُلٌ مالًا",1]," ",["إلَّا لَقِيَ اللهَ عَزَّ وجَلَّ يَوْمَ القِيامةِ وهو أَجذَمُ",2],"، فرَدَّها الكِنْديُّ»."],"grade":"صحيح","narrator":"الأشعث بن قيس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"أقضية وأحكام › قضايا حكم فيها النبي صلى الله عليه وسلم","dorar":"Xtt1p1J0"},{"id":"س-05117","fp":"f6c676ed6565","stateId":754,"easy":"إذا حلفت على مال آخر فاقتطعته بيمينك ← وجبت لك النار وبرئت منك الجنة","cause":"يحلِفُ على مالِ آخَرَ، فيقتطِعُهُ بيَمينِهِ","result":"وجَبتْ له النَّارُ، وبَرِئَتْ منه الجَنَّةُ","explicit":true,"otherNeedIds":[71],"ref":"تخريج مشكل الآثار 445","srcLabel":"مسلم","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ في الذي ",["يحلِفُ على مالِ آخَرَ، فيقتطِعُهُ بيَمينِهِ",1],": قدْ ",["وجَبتْ له النَّارُ، وبَرِئَتْ منه الجَنَّةُ",2],"."],"grade":"حسن","narrator":"أبو أمامة","muhaddith":"إسناده حسن","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (445)، ومسلم (137)، والسائي في ((السنن الكبرى) (5939) كلاهما بمعناه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ZXCd0O4g"},{"id":"س-07521","fp":"286e22e083f7","stateId":754,"easy":"إذا قُضي لك بحق مسلم (وأنت تعلم بطلانه) ← فإنما هي قطعة من النار","cause":"فَمن قَضيتُ لَهُ بحقِّ مُسلِمٍ","result":"فإنَّما هيَ قطعةٌ منَ النَّارِ","explicit":true,"similar":["س-01699"],"ref":"نخب الافكار 14/488","srcLabel":"نخب الافكار","text":["جَاءَ رجُلانِ منَ الأنصارِ يختَصِمانِ إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ في مَواريثَ بينَهُما قد دَرسَت وليسَت بينَهُما بيِّنةٌ . فقالَ رَسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: إنَّما أَنا بَشرٌ فإنَّهُ يَأتيني الخَصمُ ولعلَّ بعضَكُم أن يَكونَ أبلغَ مِن بَعضٍ فأقضيَ لَهُ بذلِكَ وأحسَبُ أنَّهُ صادقٌ ",["فَمن قَضيتُ لَهُ بحقِّ مُسلِمٍ ",1],["فإنَّما هيَ قطعةٌ منَ النَّارِ",2]," فليأخُذها أو ليدَعْها . فبَكَى الرَّجلانِ وقالَ كلُّ واحدٍ منهما حقِّي لأخي الآخر فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: أمَّا إذا فَعلتُما هذا فاذهَبا فاقتسِما وتوخَّيا الحقَّ ثمَّ استَهِما ثمَّ ليُحلِلْ كلُّ واحدٍ منكُما صاحبَهُ"],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"[له] ثلاث طرق صحاح","bab":"فضائل النبي وصفته ودلائل النبوة › اختصام المؤمنين إليه صلى الله عليه وسلم وحكمه عليهم","dorar":"62Dy8l3D","merged":2,"otherRefs":["صحيح الجامع 2342 (صحيح)"]},{"id":"س-02365","fp":"ffa25215ad34","stateId":754,"easy":"إذا أخذت مال مسلم بيمين فاجرة ← فتبوأ بيتاً في النار","cause":"مَنْ أخَذَ شيئًا مِنْ مالِ امرئٍ مسلِمٍ بيمينٍ فاجِرَةٍ","result":"فلْيَتَبَوَّأْ بيتًا في النارِ","explicit":true,"similar":["س-03045"],"ref":"مجمع الزوائد 4/184","srcLabel":"الطبراني","text":["سمعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ وهو يمشي بينَ جَمْرَتَيْنِ منَ الجمارِ وهو يقولُ ",["مَنْ أخَذَ شيئًا مِنْ مالِ امرئٍ مسلِمٍ بيمينٍ فاجِرَةٍ ",1],["فلْيَتَبَوَّأْ بيتًا في النارِ",2]],"grade":"صحيح","narrator":"الحارث بن مالك بن البرصاء","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الحميدي (573)، والطحاوي في ((شرح مشكل الآثار)) (446) مختصرا بنحوه، والطبراني (3/256) (3330) واللفظ له","bab":"إسلام › حرمة المسلم","dorar":"KPl5AX6Q"},{"id":"س-03045","fp":"1a7640a19369","stateId":754,"easy":"إذا اقتطعت مال أخيك بيمين فاجرة ← فتبوأ مقعدك من النار","cause":"مَنِ اقتَطَع مالَ أخيه المُسلِم بيَمينٍ فاجِرةٍ","result":"فلْيَتبَوَّأْ مَقعَدَه مِن النَّارِ، ليُبَلِّغْ شاهِدُكم غائِبَكم","explicit":true,"repOf":"س-02365","ref":"المستدرك على الصحيحين 8013","text":["سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ في الحَجِّ بيْنَ الجَمرَتَينِ وهو يَقولُ: ",["مَنِ اقتَطَع مالَ أخيه المُسلِم بيَمينٍ فاجِرةٍ، ",1],["فلْيَتبَوَّأْ مَقعَدَه مِن النَّارِ، ليُبَلِّغْ شاهِدُكم غائِبَكم",2],". مَرَّتَينِ أو ثَلاثًا."],"grade":"صحيح","narrator":"الحارث بن البرصاء","muhaddith":"صحيح الإسناد","bab":"إيمان › الوعيد","dorar":"xHw7UwY6"},{"id":"س-04274","fp":"1960d9d3d6b1","stateId":754,"easy":"إذا اقتطعت بيمينك مال مسلم ولو قضيباً من أراك ← يوجب الله لك النار","cause":"من اقتطع بيمينِه مالَ مسلمٍ ولو قضيبًا من أراكٍ","result":"أوجب اللهُ له النارَ","explicit":true,"ref":"المحلى 9/433","srcLabel":"المحلى","text":[["من اقتطع بيمينِه مالَ مسلمٍ ولو قضيبًا من أراكٍ ",1],["أوجب اللهُ له النارَ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"rV475KBn"},{"id":"س-07520","fp":"9b45319234da","stateId":754,"easy":"إذا اقتطعت مالاً بيمين ← تلقى الله وأنت أجذم","cause":"لا يَقتَطِعُ أحَدٌ مالًا بيَمينٍ","result":"إلا لَقيَ اللهَ وهو أجذَمُ","explicit":true,"repOf":"س-01711","ref":"تخريج سنن أبي داود 3244","text":["أنَّ رَجُلًا مِن كِندةَ ورَجُلًا مِن حَضْرَمَوْتَ اختَصَما إلى النَّبيِّ صلَّى اللَّهُ عليه وسلَّمَ في أرضٍ مِنَ اليَمَنِ، فقال الحَضرَميُّ: يا رَسولَ اللَّهِ، إنَّ أرضي اغتَصَبَنيها أبو هذا، وهي في يَدِه. قال: هل لكَ بَيِّنةٌ؟ قال: لا، ولكنْ أُحَلِّفُه، واللهُ يَعلَمُ أنَّها أرضي، اغتَصَبَنيها أبوه. فتَهيَّأَ الكِنديُّ لِليَمينِ، فقال رَسولُ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ: ",["لا يَقتَطِعُ أحَدٌ مالًا بيَمينٍ",1]," ",["إلا لَقيَ اللهَ وهو أجذَمُ",2],". فقال الكِنديُّ: هي أرضُه."],"grade":"صحيح","narrator":"الأشعث بن قيس","muhaddith":"صحيح، دون قوله: \"إلا لقي الله وهو أجذم\"","takhrij":"أخرجه أحمد (21849)، والنسائي في ((السنن الكبرى)) (6002)، وابن الجارود في ((المنتقى)) (1005) باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › اختصام المؤمنين إليه صلى الله عليه وسلم وحكمه عليهم","dorar":"2pnyLyaX"},{"id":"س-01699","fp":"bc0746bb169e","stateId":754,"easy":"إذا قُضي لك بحق أخيك (وأنت تعلم) ← فإنما هي قطعة من النار","cause":"فقضَيْتُ لهُ، وأنا أرَى أنَّه حقُّهُ، وإنَّما هو مِن حقِّ أخيهِ","result":"فإنَّما أَقْضي له بقِطعةٍ منَ النَّارِ يُطَوَّقُها مِن سَبْعِ أرَضِينَ، يأْتي بها إِسْطَامًا في عُنُقِهِ يومَ القِيامةِ","explicit":true,"repOf":"س-07521","ref":"تخريج مشكل الآثار 756","text":["أنَّ رَجُلَيْنِ منَ الأنصارِ استَأْذَنا على رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فأذِن لهما، فاختَصَما إليه في أرضٍ قدْ تقدَّم شأْنُها، وهلَك مَن يعرِفُ أمْرَها، فقال لهما رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّما أَقْضي بيْنَكما بجَهْدِ رَأْيي فيما لمْ ينزِلْ علَيَّ، وأنا أَقْضي بيْنَكما على نَحْوِ ما أسمَعُ منكما، وأيُّكما كان له في الكلامِ فَضلٌ على صاحبِهِ ",["فقضَيْتُ لهُ، وأنا أرَى أنَّه حقُّهُ، وإنَّما هو مِن حقِّ أخيهِ",1],"، ",["فإنَّما أَقْضي له بقِطعةٍ منَ النَّارِ يُطَوَّقُها مِن سَبْعِ أرَضِينَ، يأْتي بها إِسْطَامًا في عُنُقِهِ يومَ القِيامةِ",2],"، فلمَّا سَمِعَا ذلك بكَيَا جميعًا، وقال كلُّ واحدٍ منهما: يا رسولَ اللهِ: حظِّي له، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: اذهَبا فاجتَهِدا في قَسْمِ الأرضِ شَطْرَيْنِ، ثمَّ اسْتَهِمَا، فإذا أخَذ كلُّ واحدٍ منكما نَصيبَهُ فلْيُحْلِلْ أخاهُ."],"grade":"حسن","narrator":"أم سلمة أم المؤمنين","muhaddith":"إسناده حسن","bab":"أقضية وأحكام › الحكم بالكتاب والسنة ثم باجتهاد الحاكم، والخطأ معذور","dorar":"NF3Kx356"},{"id":"س-05262","fp":"ff67273e5a89","stateId":755,"easy":"إذا تزوجت امرأة وأنت عازم ألا توفيها صداقها ← تلقى الله وأنت زانٍ","cause":"مَن أصْدَقَ امْرَأةً صَداقًا وهو مُجمِعٌ ألَّا يُوَفِّيَها إيَّاه","result":"لَقيَ اللهَ تعالى وهو زانٍ","explicit":true,"ref":"الأحاديث المختارة 8 / 70","srcLabel":"متفق عليه","text":["«",["مَن أصْدَقَ امْرَأةً صَداقًا وهو مُجمِعٌ ألَّا يُوَفِّيَها إيَّاه ",1],["لَقيَ اللهَ تعالى وهو زانٍ، ",2],"ومَن ادَّانَ دَيْنًا وهو مُجمِعٌ ألَّا يُوَفِّيَه لَقيَ اللهَ وهو سارِقٌ»)."],"grade":"صحيح","narrator":"‌‌صهيب بن سنان الرومي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"5LzDr6dR"},{"id":"س-05263","fp":"67b0df2565e6","stateId":755,"easy":"إذا استدنت وأنت عازم ألا توفي ← تلقى الله وأنت سارق","cause":"ومَن ادَّانَ دَيْنًا وهو مُجمِعٌ ألَّا يُوَفِّيَه","result":"لَقيَ اللهَ وهو سارِقٌ","explicit":true,"ref":"الأحاديث المختارة 8 / 70","srcLabel":"متفق عليه","text":["«مَن أصْدَقَ امْرَأةً صَداقًا وهو مُجمِعٌ ألَّا يُوَفِّيَها إيَّاه لَقيَ اللهَ تعالى وهو زانٍ، ",["ومَن ادَّانَ دَيْنًا وهو مُجمِعٌ ألَّا يُوَفِّيَه ",1],["لَقيَ اللهَ وهو سارِقٌ»)",2],"."],"grade":"صحيح","narrator":"‌‌صهيب بن سنان الرومي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"5LzDr6dR"},{"id":"س-07832","fp":"10480ff2b628","stateId":755,"easy":"إذا استدنت ديناً لا تريد أداءه ← تلقى الله سارقاً","cause":"وأيُّما رجلٍ اسْتَدَانَ دَيْنًا لا يُرِيدُ أنْ يُؤَدِّيَ إلى صاحِبِه حقَّهُ ؛ خَدْعَةً حتى أَخَذَ مالهُ ، فماتَ ولمْ يَرُدَّ إليهِ دِينَهُ","result":"لَقِيَ اللهَ وهوَ سارِقٌ","explicit":true,"ref":"صحيح الترغيب 1807","srcLabel":"صحيح الترغيب","text":["أيُّما رجلٍ تَزَوَّجَ امرأةً على ما قَلَّ مِنَ المَهْرِ أوْ كَثُرَ ، ليس في نفسِهِ أنْ يُؤَدِّيَ إليها حقَّها ؛ خَدَعَها ، فماتَ ولمْ يُؤَدِّ إليها حقَّها ؛ لَقِيَ اللهَ يومَ القيامةِ وهوَ زَانٍ ، ",["وأيُّما رجلٍ اسْتَدَانَ دَيْنًا لا يُرِيدُ أنْ يُؤَدِّيَ إلى صاحِبِه حقَّهُ ؛ خَدْعَةً حتى أَخَذَ مالهُ ، فماتَ ولمْ يَرُدَّ إليهِ دِينَهُ ؛ ",1],["لَقِيَ اللهَ وهوَ سارِقٌ ",2],"."],"grade":"صحيح","narrator":"أبو ميمون الكردي","muhaddith":"صحيح","takhrij":"أخرجه ((المعجم الصغير)) (111) واللفظ له.","bab":"قرض › الترهيب من الدين","dorar":"E2T5oPo8","merged":3,"otherRefs":["صحيح الترغيب 1802 (حسن)","صحيح الجامع 2720 (صحيح)"]},{"id":"س-05083","fp":"8668127b131b","stateId":755,"easy":"إذا مت وعليك دين ← يُقضى من حسناتك لا بالدينار والدرهم","cause":"ومَن مات وعليه دَيْنٌ","result":"فليس بالدِّينارِ ولا بالدِّرهمِ، ولكنَّها الحسَناتُ والسَّيِّئاتُ","explicit":true,"similar":["س-07836","س-07841","س-07837"],"otherNeedIds":[52],"ref":"تخريج المسند لشعيب 5385","srcLabel":"أبو داود","text":["خرَجْنا حُجَّاجًا عَشَرةً مِن أهلِ الشَّامِ، حتى أَتَيْنا مكَّةَ، فذَكَر الحديثَ، قال: فأَتَيْناهُ، فخَرَج إلينا -يعني: ابنَ عُمرَ، فقال: سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقول: مَن حالَتْ شَفاعَتُه دُونَ حدٍّ مِن حُدودِ اللهِ عزَّ وجلَّ، فقد ضادَّ اللهَ أَمْرَه، ",["ومَن مات وعليه دَيْنٌ، ",1],["فليس بالدِّينارِ ولا بالدِّرهمِ، ولكنَّها الحسَناتُ والسَّيِّئاتُ، ",2],"ومَن خاصَمَ في باطِلٍ وهو يَعْلَمُه، لم يَزَلْ في سَخَطِ اللهِ حتى يَنزِعَ، ومَن قال في مؤْمِنٍ ما ليس فيه، أَسْكَنَه اللهُ رَدْغةَ الخَبَالِ حتى يَخرُجَ ممَّا قالَ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3597)، وأحمد (5385) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"jwOzDMmj","merged":2,"otherRefs":["السلسلة الصحيحة 437 (صحيح)"]},{"id":"س-07831","fp":"3975bc56fd3c","stateId":755,"easy":"إذا تزوجت امرأة على مهر وليس في نفسك أن تؤديه ← تلقى الله زانياً","cause":"أيُّما رجلٍ تَزَوَّجَ امرأةً على ما قَلَّ مِنَ المَهْرِ أوْ كَثُرَ ، ليس في نفسِهِ أنْ يُؤَدِّيَ إليها حقَّها ؛ خَدَعَها ، فماتَ ولمْ يُؤَدِّ إليها حقَّها","result":"لَقِيَ اللهَ يومَ القيامةِ وهوَ زَانٍ","explicit":true,"ref":"صحيح الترغيب 1807","srcLabel":"صحيح الترغيب","text":[["أيُّما رجلٍ تَزَوَّجَ امرأةً على ما قَلَّ مِنَ المَهْرِ أوْ كَثُرَ ، ليس في نفسِهِ أنْ يُؤَدِّيَ إليها حقَّها ؛ خَدَعَها ، فماتَ ولمْ يُؤَدِّ إليها حقَّها ؛ ",1],["لَقِيَ اللهَ يومَ القيامةِ وهوَ زَانٍ ، ",2],"وأيُّما رجلٍ اسْتَدَانَ دَيْنًا لا يُرِيدُ أنْ يُؤَدِّيَ إلى صاحِبِه حقَّهُ ؛ خَدْعَةً حتى أَخَذَ مالهُ ، فماتَ ولمْ يَرُدَّ إليهِ دِينَهُ ؛ لَقِيَ اللهَ وهوَ سارِقٌ ."],"grade":"صحيح","narrator":"أبو ميمون الكردي","muhaddith":"صحيح","takhrij":"أخرجه ((المعجم الصغير)) (111) واللفظ له.","bab":"قرض › الترهيب من الدين","dorar":"E2T5oPo8"},{"id":"س-07835","fp":"37dd00e4f72e","stateId":755,"easy":"إذا مت وأنت لا تنوي قضاء دينك ← يُؤخذ من حسناتك","cause":"ومن مات وهو لا ينوي قضاءَه","result":"فذاك الذي يُؤخَذُ من حسناتِه","explicit":true,"otherNeedIds":[2],"ref":"صحيح الترغيب 1803","srcLabel":"الطبراني","text":["الدَّينُ دَيْنانِ ، فمن مات وهو ينوي قضاءَه ؛ فأنا وليُّه ، ",["ومن مات وهو لا ينوي قضاءَه",1]," ؛ ",["فذاك الذي يُؤخَذُ من حسناتِه",2]," ، ليس يومئذٍ دينارٌ ولا درهمٌ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (13/ 336) (\n14146)","bab":"قرض › الترهيب من الدين","dorar":"71SmOwWP"},{"id":"س-07836","fp":"004b802242e4","stateId":755,"easy":"إذا مت وعليك دين ← فإنما هي الحسنات والسيئات ليس ثَمّ دينار ولا درهم","cause":"لا تموتَن َّوعليك دَيْنٌ","result":"فإنَّما هي الحسناتُ والسيِّئاتُ ، ليس ثَمَّ دينارٌ ولا درهمٌ ، وليس يظلِمُ اللهُ أحدًا","explicit":true,"repOf":"س-05083","ref":"حلية الأولياء 3/345","text":[["لا تموتَن َّوعليك دَيْنٌ ، ",1],["فإنَّما هي الحسناتُ والسيِّئاتُ ، ليس ثَمَّ دينارٌ ولا درهمٌ ، وليس يظلِمُ اللهُ أحدًا",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح ثابت من حديث المقبري عن أبي هريرة مشهور من حديث ابن عمر، وهو غريب تفرد به عبد الرحمن بن مغراء","takhrij":"أخرجه ابن أبي الدنيا كما في ((البداية والنهاية)) (17/ 305)، وابن الأعرابي في ((معجم شيوخ ابن الأعرابي)) (2/ 384)، باختلاف يسير، والطبراني في ((المعجم الأوسط)) (13504)، بلفظ مقارب.","bab":"قرض › الترهيب من الدين","dorar":"E4MeBp1H"},{"id":"س-07841","fp":"8a085ca87deb","stateId":755,"easy":"إذا مت وعليك دينار أو درهم ← يُقضى من حسناتك","cause":"مَنْ ماتَ و عليْهِ دِينارٌ أوْ دِرْهَمٌ","result":"قُضِيَ من حسناتِه ، ليْسَ ثَمَّ دِينارٌ و لا دِرهَمٌ","explicit":true,"repOf":"س-05083","ref":"صحيح الجامع 6546","text":[["مَنْ ماتَ و عليْهِ دِينارٌ أوْ دِرْهَمٌ ، ",1],["قُضِيَ من حسناتِه ، ليْسَ ثَمَّ دِينارٌ و لا دِرهَمٌ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (2414) واللفظ له، والطبراني (12/408) (13504)، وابن عدي في ((الكامل في الضعفاء)) (3/413)","bab":"قرض › الترهيب من الدين","dorar":"fVdeCZH6"},{"id":"س-07837","fp":"4651db90196a","stateId":755,"easy":"إذا مت وعليك دين ← يُقضى منك يوم القيامة","cause":"الدَّيْنَ","result":"يُقضَى من صاحبِهِ يومَ القيامَةِ إذا ماتَ","explicit":true,"repOf":"س-05083","otherNeedIds":[2],"ref":"الأجوبة المرضية 3/1184","text":["إنَّ ",["الدَّيْنَ",1]," ",["يُقضَى من صاحبِهِ يومَ القيامَةِ إذا ماتَ",2]," إلا من تَدَيَّنَ في ثلاثِ خِصَالٍ رجُلٌ يُضعِفُ قوتَهُ في سبيلِ الله فيستدينُ يتقَوَّى به لعدوِّ الله وعدوِّه ورجلٌ يموتُ عنده مسلمٌ لا يجِدُ ما يُكَفِّنُهُ ويُوارِيِهِ إلا بِدَيْنٍ ورجلٌ خافَ اللهُ على نفسِهِ العَزَبَةَ فينكِحُ خشيةً على دِينِهِ فإنَّ اللهَ يقضِي عن هؤلاءِ يومَ القيامةِ"],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن","takhrij":"أخرجه ابن ماجه (2435)، والبزار كما في ((الترغيب والترهيب)) للمنذري (2/375)، والبيهقي في ((شعب الإيمان)) (5559) باختلاف يسير","bab":"قرض › الترهيب من الدين","dorar":"OVPdf0Ha"},{"id":"ق-1417","fp":"fb469f922bf0","stateId":756,"easy":"التطفيف في الكيل والميزان ← الويل","cause":"التطفيف في الكيل والميزان","result":"الويل","explicit":true,"otherNeedIds":[3],"ref":"سورة المطففين: 1–6","srcLabel":"القرآن الكريم","quran":{"s":83,"from":1,"to":6,"text":"وَيْلٌ لِلْمُطَفِّفِينَ (1) الَّذِينَ إِذَا اكْتَالُوا عَلَى النَّاسِ يَسْتَوْفُونَ (2) وَإِذَا كَالُوهُمْ أَوْ وَزَنُوهُمْ يُخْسِرُونَ (3) أَلَا يَظُنُّ أُولَئِكَ أَنَّهُمْ مَبْعُوثُونَ (4) لِيَوْمٍ عَظِيمٍ (5) يَوْمَ يَقُومُ النَّاسُ لِرَبِّ الْعَالَمِينَ (6)","hl":[[0,257,1]]}},{"id":"س-05273","fp":"b1d8ee155928","stateId":756,"easy":"إذا قبلت هدية على تعليم القرآن ← يطوقك الله طوقاً من نار (على رواية)","cause":"فاقْبَلْها","result":"إن أرَدْتَ أن يُطَوِّقَك اللهُ طَوْقًا مِن نارٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأحاديث المختارة 8 / 252","srcLabel":"متفق عليه","text":["«كُنْتُ أُعَلِّمُ ناسًا مِن أهْلِ الصُّفَّةِ الكِتابَ والقُرآنَ، فأَهْدى إليَّ رَجُلٌ مِنهم قَوْسًا فقُلْتُ: أَرْمي عنها -وليسَتْ بمالٍ- في سَبيلِ اللهِ، ثُمَّ بَدا لي أن أَسْتَفْتيَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فاسْتَفْتَيْتُه فقُلْتُ: يا رَسولَ اللهِ إنِّي كُنْتُ أُعَلِّمُ ناسًا مِن أهْلِ الصُّفَّةِ الكِتابَ والقُرآنَ، فأَهْدى إليَّ رَجُلٌ مِنهم قَوْسًا، فقُلْتُ: أَرْمي عنها في سَبيلِ اللهِ، وليسَتْ بمالٍ، فقالَ: (",["إن أرَدْتَ أن يُطَوِّقَك اللهُ طَوْقًا مِن نارٍ ",2],["فاقْبَلْها)»",1],"."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Llf3sbNi","merged":5,"otherRefs":["صحيح ابن ماجه 1765 (صحيح)","الأحاديث المختارة 9 / 103 (صحيح)","صحيح أبي داود 3416 (صحيح)","أضواء البيان 3/27 (حسن)"]},{"id":"س-04229","fp":"cbaf81f880af","stateId":756,"easy":"إذا أخذت ضالة المسلم (لتتملكها) ← فهي حرق النار","cause":"ضالَّةَ المسلِمِ","result":"حَرقُ النَّارِ","explicit":true,"similar":["س-02380"],"ref":"نخب الافكار 16/388","srcLabel":"النسائي","text":["كنَّا قدِمنا علَى رَسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ في نَفرٍ مِن بَني عامرٍ . فقالَ: ألا أحملُكُم ؟ فَقُلتُ: إنَّا نجدُ في الطَّريقِ هوامِّي الإبلِ، فقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ: إنَّ ",["ضالَّةَ المسلِمِ",1]," ",["حَرقُ النَّارِ",2]],"grade":"صحيح","narrator":"عبدالله بن الشخير","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح معاني الآثار)) (6059) بلفظه، والنسائي في ((السنن الكبرى)) (5758)، وابن حبان (4888) كلاهما بنحوه .","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"wALBHCkD","merged":8,"otherRefs":["الأحاديث المختارة 9 / 474 (صحيح)","تخريج مشكل الآثار 4725 (حسن)","الأحكام الوسطى 2022/10/4 (صحيح)","تخريج مشكل الآثار 4723 (حسن)","تخريج مشكل الآثار 4724 (صحيح)","الأحاديث المختارة 9 / 473 (صحيح)","الإعراب عن الحيرة والالتباس 2/544 (صحيح)"]},{"id":"ق-0204","fp":"08562d67bef2","stateId":756,"easy":"أكل أموال اليتامى ظلماً ← نار في البطون وصَلي السعير","cause":"أكل أموال اليتامى ظلماً","result":"نار في البطون وصَلي السعير","explicit":true,"ref":"سورة النساء: 10","srcLabel":"القرآن الكريم","quran":{"s":4,"from":10,"to":10,"text":"إِنَّ الَّذِينَ يَأْكُلُونَ أَمْوَالَ الْيَتَامَى ظُلْمًا إِنَّمَا يَأْكُلُونَ فِي بُطُونِهِمْ نَارًا وَسَيَصْلَوْنَ سَعِيرًا (10)","hl":[[0,125,1]]}},{"id":"س-03074","fp":"e20ff7f8f62c","stateId":756,"easy":"إذا أخذت على تعليم القرآن قوساً (أجرة) ← يقلدك الله مكانها قوساً من نار يوم القيامة","cause":"مَنْ أخذَ علَى تعليمِ القرآنِ قوْسًا","result":"قلَّدَهُ اللهُ مكانَها قوسًا مِنْ نارِ جَهَنَّمَ يومَ القيامَةِ","explicit":true,"ref":"صحيح الجامع 5982","srcLabel":"الطبراني","text":[["مَنْ أخذَ علَى تعليمِ القرآنِ قوْسًا ، ",1],["قلَّدَهُ اللهُ مكانَها قوسًا مِنْ نارِ جَهَنَّمَ يومَ القيامَةِ",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((مسند الشاميين)) (279)، وأبو نعيم في ((حلية الأولياء)) (6/86)، والبيهقي (12020) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"RoguYiGv","merged":2,"otherRefs":["البدر المنير 8/301 (صحيح)"]},{"id":"س-03918","fp":"eab8ba9cfd12","stateId":756,"easy":"إذا أكلت أموال اليتامى ظلماً ← تُبعث يوم القيامة وفمك يتأجج ناراً","cause":"إِنَّ الَّذِينَ يَأْكُلُونَ أَمْوَالَ الْيَتَامَى ظُلْمًا","result":"يُبعَثُ يومَ القيامةِ قومٌ مِن قبورِهم تَأَجَّجُ أفواهُهم نارًا","explicit":true,"ref":"صحيح ابن حبان 5566","srcLabel":"أبو يعلى","text":["( ",["يُبعَثُ يومَ القيامةِ قومٌ مِن قبورِهم تَأَجَّجُ أفواهُهم نارًا",2]," ) فقيل: مَن هم يا رسولَ اللهِ ؟ قال: ( ألم ترَ اللهَ يقولُ: {",["إِنَّ الَّذِينَ يَأْكُلُونَ أَمْوَالَ الْيَتَامَى ظُلْمًا",1]," إِنَّمَا يَأْكُلُونَ فِي بُطُونِهِمْ نَارًا} [النساء: 10] )"],"grade":"صحيح","narrator":"أبو برزة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو يعلى (7440)، وابن أبي حاتم في ((التفسير)) (4881) كلاهما بلفظه، وابن عدي في ((الكامل في الضعفاء)) (4/ 134)","bab":"تفسير آيات › سورة النساء","dorar":"1f4KHS8o"},{"id":"س-04277","fp":"4aed7a261298","stateId":756,"easy":"إذا دخلت في أسعار المسلمين لتغليها ← كان حقاً على الله أن يقعدك بعظم من النار","cause":"مَنْ دخل في شيءٍ مِنْ أسعارِ المسلمينَ لِيُغْلِيَهُ عليهم","result":"كان حقًّا على اللهِ تبارَكَ وتعالى أنْ يَقْذِفَهُ في معظَمٍ منَ النارِ","explicit":true,"ref":"مجمع الزوائد 4/104","srcLabel":"أحمد","text":[["مَنْ دخل في شيءٍ مِنْ أسعارِ المسلمينَ لِيُغْلِيَهُ عليهم ",1],["كان حقًّا على اللهِ تبارَكَ وتعالى أنْ يَقْذِفَهُ في معظَمٍ منَ النارِ",2]],"grade":"صحيح","narrator":"معقل بن يسار","muhaddith":"فيه زيد بن مرة أبو المعلى ولم أجد من ترجمه وبقية رجاله رجال الصحيح","takhrij":"أخرجه أحمد (20313)، والطيالسي في ((المسند)) (970) واللفظ له، والطبراني (20/210) (480)","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"evV8DRmX"},{"id":"س-05621","fp":"8199d9590bac","stateId":756,"easy":"إذا طلبت الرزق من غير حله ← تكون أشقى الأشقياء: فقر الدنيا وعذاب الآخرة","cause":"طلبِ الرِّزقِ من غيرِ حِلِّه","result":"فإنَّ أشقَى الأشقياءِ من اجتمع عليه فقرُ الدُّنيا ، وعذابُ الآخرةِ","explicit":true,"otherNeedIds":[3],"ref":"الترغيب والترهيب 4/141","srcLabel":"الحاكم","text":["يا أيُّها النَّاسُ لا تحمِلنَّكم العُسرةُ على ",["طلبِ الرِّزقِ من غيرِ حِلِّه",1]," ، فإنِّي سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ : اللَّهمَّ تَوفَّني فقيرًا ، ولا تَوفَّني غنيًّا واحشُرْني في زُمرةِ المساكينِ ، ",["فإنَّ أشقَى الأشقياءِ من اجتمع عليه فقرُ الدُّنيا ، وعذابُ الآخرةِ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (1887)، والحاكم (7911) مختصراً باختلاف يسير، والبيهقي (13282) باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"PMLC066f"},{"id":"س-04956","fp":"d9023a19475f","stateId":756,"easy":"إذا سرقت الحجاج ← تُعذّب في النار (صاحب المحجن)","cause":"كانَ يسرِقُ الحاجَّ بمِحجنِهِ","result":"ورأيتُ صاحبَ المِحجنِ في النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح ابن خزيمة 2/ 520","srcLabel":"النسائي","text":["انكسَفتِ الشَّمسُ يومًا علَى عَهْدِ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ، فقامَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ليصلِّيَ، فقامَ حتَّى لم يَكَد أن يركعَ، ثمَّ رَكَعَ حتَّى لم يَكَد يَرفعُ رأسَهُ، ثمَّ رفعَ رأسَهُ فلم يَكَد أن يسجُدَ، ثمَّ سجدَ فلم يَكَد أن يَرفعَ رأسَهُ، فجعلَ ينفُخُ ويَبكي، ويقولُ: ربِّ، ألَم تعِدْني أن لا تعذِّبَهُم وأَنا فيهِم؟ ربِّ، ألم تعِدْني أن لا تعذِّبَهُم ونحنُ نَستغفرُكَ؟، فلمَّا صلَّى رَكْعتَينِ انجلتِ الشَّمسُ، فقامَ فحمِدَ اللَّهَ وأثنى عليهِ، وقالَ: إنَّ الشَّمسَ والقَمرَ آيتانِ من آياتِ اللَّهِ فإذا انكسَفا فافزَعوا إلى ذَكَرِ اللَّهِ، ثمَّ قالَ: لقد عُرِضَت عليَّ الجنَّةُ حتَّى لو شئتُ تعاطيتُ قِطفًا مِن قطوفُها، وعُرِضت عليَّ النَّارُ فجعلتُ أنفخُها، فَخِفْتُ أن يغشاكُم، فجعلتُ أقولُ: ربِّ، ألم تعِدني أن لا تعذِّبَهُم وأَنا فيهِم؟ ربِّ، ألم تعِدني ألا تعذِّبَهُم وَهُم يستَغفِرونَ؟، قالَ: فرأيتُ فيها الحميريَّةَ السَّوداءَ الطَّويلةَ صاحبةَ الهرَّةِ، كانت تحبسُها فلم تُطعِمها ولم تَسقِها ولا تترُكُها تأكلُ من خَشاشِ الأرضِ، فرأيتُها كلَّما أدبرَت نَهَشتها، وَكُلَّما أقبَلت نَهَشتها في النَّارِ، ورأيتُ صاحبَ السِّبتيَّتينِ أخا بَني دَعدعٍ، يُدفَعُ في النَّارِ بعصًا ذي شُعبتَينِ، ",["ورأيتُ صاحبَ المِحجنِ في النَّارِ",2]," الَّذي ",["كانَ يسرِقُ الحاجَّ بمِحجنِهِ",1],"، ويقولُ: إنِّي لا أسرقُ إنَّما يسرقُ المِحجنُ، فرأيتُهُ في النَّارِ متَّكئًا على مِحجَنِهِ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه النسائي (1482)، وابن حبان (7089) بلفظ مقارب، والحاكم (1229) بنحوه مختصرا","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"AhWp7xdI","merged":2,"otherRefs":["تخريج صحيح ابن حبان 7489 (صحيح)"]},{"id":"س-04809","fp":"5ef058ce0d02","stateId":756,"easy":"إذا اكتسبت مالاً من إثم فوصلت به رحمك أو تصدقت ← يُجمع ذلك كله فيُقذف في جهنم","cause":"من اكتسب مالًا من مأْثَمٍ ، فوصَل به رَحِمَه ، أو تصدَّق به ، أو أنفقَه في سبيل اللهِ","result":"جُمِعَ ذلك كلُّه جميعًا ، فقُذِفَ به في جهنَّمَ","explicit":true,"ref":"صحيح الترغيب 1721","srcLabel":"أبو داود","text":[["من اكتسب مالًا من مأْثَمٍ ، فوصَل به رَحِمَه ، أو تصدَّق به ، أو أنفقَه في سبيل اللهِ ؛ ",1],["جُمِعَ ذلك كلُّه جميعًا ، فقُذِفَ به في جهنَّمَ ",2],"."],"grade":"حسن","narrator":"القاسم بن مخيمرة","muhaddith":"حسن لغيره","takhrij":"أخرجه أبو داود في ((المراسيل)) (131) واللفظ له، وابن المبارك في ((الزهد)) (625)، وأبو بكر الدينوري في ((المجالسة وجواهر العلم)) (1491)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Sl1zscGN"},{"id":"س-07792","fp":"59d840144edb","stateId":756,"easy":"إذا علّمت سورة من القرآن فقبلت عليها ثوباً ← تُلبس ثوباً من نار","cause":"علَّم رجلًا سورةً منَ القرآنِ فأهدى إليه ثوبًا","result":"أُلبِستَ ثوبًا مِن نارٍ","explicit":true,"otherNeedIds":[52],"ref":"إتحاف الخيرة المهرة 6/326","srcLabel":"إتحاف الخيرة المهرة","text":["عن أُبَيِّ بنِ كعبٍ : أنه ",["علَّم رجلًا سورةً منَ القرآنِ فأهدى إليه ثوبًا",1]," , أو قال : خميصةً , قال : فذكَر ذلك للنبيِّ صلَّى اللهُ عليه وسلَّم فقال : لو أنَّكَ أخَذتَه ، أو قال : إنْ أخَذتَه شَكَّ محمدٌ ",["أُلبِستَ ثوبًا مِن نارٍ",2]],"grade":"حسن","narrator":"أبي بن كعب","muhaddith":"رجاله ثقات","bab":"قرآن › تعلم القرآن وتعليمه","dorar":"sJx6hq1W"},{"id":"س-02380","fp":"e5cc3bc5ca05","stateId":756,"easy":"إذا أخذت ضالة المؤمن (بلا تعريف) ← فهي حرق النار","cause":"ضالَّةُ المُؤمِنِ","result":"حَرَقُ النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-04229","ref":"الأحاديث المختارة 9 / 473","text":["«",["ضالَّةُ المُؤمِنِ",1]," ",["حَرَقُ النَّارِ",2],"»."],"grade":"صحيح","narrator":"‌‌عبدالله بن الشخير","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إسلام › حرمة المسلم","dorar":"zRsu1bMh"},{"id":"س-07853","fp":"4618db5eaba6","stateId":756,"easy":"إذا غششت اللبن بالماء ← تُكلّف يوم القيامة أن تخلصه","cause":"قد خلطه بالماءِ","result":"كيف بك إذا قيل لك يومَ القيامةِ خلِّصِ الماءَ من اللَّبنِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الترغيب والترهيب 3/32","srcLabel":"البيهقي","text":["أنَّ أبا هريرةَ رضِي اللهُ عنه مرَّ بناحيةِ الحَرَّةِ فإذا إنسانٌ يحمِلُ لبنًا يبيعُه فنظر إليه أبو هريرةَ فإذا هو ",["قد خلطه بالماءِ",1]," فقال له أبو هريرةَ ",["كيف بك إذا قيل لك يومَ القيامةِ خلِّصِ الماءَ من اللَّبنِ",2]],"grade":"حسن","narrator":"صفوان بن سليم","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه الأصبهاني في ((الترغيب والترهيب)) (252) بلفظه، والبيهقي في ((شعب الإيمان)) (4927) باختلاف يسير.","bab":"قيامة › الحساب والقصاص","dorar":"QjiO2ZDw"},{"id":"س-02997","fp":"292f3fb8ceae","stateId":756,"easy":"إذا كنت تاجراً ← تُحشر مع الفجار إلا إن اتقيت ربك وبررت وصدقت","cause":"التُّجَّارِ","result":"تُحشرون مع الفُجَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[13],"ref":"مسند علي 47","srcLabel":"الطبري","text":["يا معشرَ ",["التُّجَّارِ",1]," ",["تُحشرون مع الفُجَّارِ",2]," إلا منِ اتَّقى ربَّه وصدق"],"grade":"صحيح","narrator":"رفاعة بن رافع","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبري في ((تهذيب الآثار - علي)) (94) بلفظه","bab":"إيمان › الوعيد","dorar":"kjjNw4tH"},{"id":"س-04191","fp":"871fe47d4637","stateId":757,"easy":"إذا لم تؤدِّ زكاة حليك ← تُسوّر يوم القيامة أساور من نار","cause":"فأدِّيا حقَّ هذا الذي في أيدِيْكما","result":"أتُحِبَّانِ أنْ يُسَوِّرَكما اللهُ يومَ القيامَةِ أَساوِرَ من نارٍ","explicit":true,"ref":"تخريج المسند لشاكر 10/151","srcLabel":"أحمد","text":["أتَتِ النبيَّ صلَّى اللهُ عليه وسلَّم امرأَتانِ في أيديهِما أَساوِرُ من ذهَبٍ فقال لهما رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["أتُحِبَّانِ أنْ يُسَوِّرَكما اللهُ يومَ القيامَةِ أَساوِرَ من نارٍ",2]," قالَتا لا قال ",["فأدِّيا حقَّ هذا الذي في أيدِيْكما",1]],"grade":"صحيح","narrator":"[جد عمرو بن شعيب]","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6667)","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"MTO6RpFF"},{"id":"س-05529","fp":"ae3d34ba70c3","stateId":757,"easy":"إذا كنزت المال ← تُكوى برضف من نار جهنم","cause":"الكانِزينَ","result":"برَضفٍ يُحمى عليه في نارِ جَهَنَّمَ، ثُمَّ يوضَعُ على حَلَمةِ ثَديِ أحَدِهم حتَّى يَخرُجَ مِن نُغضِ كَتِفِه، ويوضَعُ على نُغضِ كَتِفِه حتَّى يَخرُجَ مِن حَلَمةِ ثَديِه، يَتَزَلزَلُ","explicit":true,"star":true,"ref":"صحيح البخاري 1408","srcLabel":"مسلم","text":["جَلَستُ إلى مَلَإٍ مِن قُرَيشٍ، فجاءَ رَجُلٌ خَشِنُ الشَّعَرِ والثِّيابِ والهَيئةِ، حتَّى قامَ عليهم فسَلَّمَ، ثُمَّ قال: بَشِّرِ ",["الكانِزينَ",1]," ",["برَضفٍ يُحمى عليه في نارِ جَهَنَّمَ، ثُمَّ يوضَعُ على حَلَمةِ ثَديِ أحَدِهم حتَّى يَخرُجَ مِن نُغضِ كَتِفِه، ويوضَعُ على نُغضِ كَتِفِه حتَّى يَخرُجَ مِن حَلَمةِ ثَديِه، يَتَزَلزَلُ",2],"، ثُمَّ ولَّى، فجَلَسَ إلى ساريةٍ، وتَبِعتُه وجَلَستُ إليه وأنا لا أدري مَن هو؟ فقُلتُ له: لا أُرى القَومَ إلَّا قد كَرِهوا الذي قُلتَ، قال: إنَّهم لا يَعقِلونَ شيئًا، قال لي خَليلي، قال: قُلتُ: مَن خَليلُكَ؟ قال النَّبيُّ صلَّى اللهُ عليه وسلَّم: يا أبا ذَرٍّ، أتُبصِرُ أُحُدًا؟ قال: فنَظَرتُ إلى الشَّمسِ ما بَقيَ مِنَ النَّهارِ، وأنا أُرى أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يُرسِلُني في حاجةٍ له، قُلتُ: نَعَم، قال: ما أُحِبُّ أنَّ لي مِثلَ أُحُدٍ ذَهَبًا، أُنفِقُه كُلَّه، إلَّا ثَلاثةَ دَنانيرَ، وإنَّ هؤلاء لا يَعقِلونَ، إنَّما يَجمَعونَ الدُّنيا، لا واللهِ لا أسألُهم دُنيا، ولا أستَفتيهم عن دينٍ، حتَّى ألقى اللهَ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (992) مطولاً باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"cacHzxPr","merged":5,"otherRefs":["تخريج المسند لشعيب 21485 (صحيح)","صحيح مسلم 992 (صحيح)","تاريخ الإسلام 3/410 (صحيح)"]},{"id":"س-03021","fp":"d757bf069d41","stateId":757,"easy":"إذا مت وتركت كنزاً لم تؤد حقه ← يأتي يوم القيامة شجاعاً أقرع يطوقك","cause":"مَن قال في عبادِ اللهِ هكذا وهكذا وهكذا، وقليلٌ ما هُم، ما من رَجُلٍ يموتُ فيَترُكُ غَنمًا، أو إبلًا، أو بَقرًا لم يُؤَدِّ زَكاتَها","result":"إلَّا جاءَتْ يومَ القِيامةِ أعظَمَ ما تكونُ وأسمَنَ، حتى تَطأَهُ بأظلافِها، وتَنطَحَه بقُرونِها، حتى يُقْضى بينَ الناسِ، ثُم تَعودُ أُولَاها على أُخْراها","explicit":true,"star":true,"similar":["س-02960","س-05073","س-06144","س-06155","س-05161","س-06148","س-06157","س-07438","س-07473","س-06145"],"ref":"تخريج المسند لشعيب 21351","srcLabel":"متفق عليه","text":["أتَيْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ وهو في ظِلِّ الكَعبةِ، فقال: همُ الأخسَرونَ ورَبِّ الكَعبةِ، همُ الأخسَرونَ ورَبِّ الكَعبةِ، فأخَذَني غَمٌّ وجعَلْتُ أتنَفَّسُ، قال: قُلْتُ: هذا شَرُّ حدَثَ فيَّ، قال: قُلْتُ: مَن هُم فِداكَ أبي وأُمِّي؟ قال: الأكثَرونَ، إلَّا ",["مَن قال في عبادِ اللهِ هكذا وهكذا وهكذا، وقليلٌ ما هُم، ما من رَجُلٍ يموتُ فيَترُكُ غَنمًا، أو إبلًا، أو بَقرًا لم يُؤَدِّ زَكاتَها؛ ",1],["إلَّا جاءَتْ يومَ القِيامةِ أعظَمَ ما تكونُ وأسمَنَ، حتى تَطأَهُ بأظلافِها، وتَنطَحَه بقُرونِها، حتى يُقْضى بينَ الناسِ، ثُم تَعودُ أُولَاها على أُخْراها",2],"، وقال ابنُ نُمَيرٍ: كلَّما نَفِدَتْ أُخْراها عادَتْ عليه أُولاها."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6638)، ومسلم (990)، والترمذي (617)، والنسائي (2440)، وأحمد (21351) واللفظ له","bab":"إيمان › الوعيد","dorar":"BkA0OGrD","merged":3,"otherRefs":["صحيح الترمذي 617 (صحيح)","حلية الأولياء 7/421 (صحيح)"]},{"id":"س-06282","fp":"79b074d94c77","stateId":757,"easy":"إذا كنت صاحب إبل أو بقر أو غنم لا تؤدي زكاتها ← تأتي يوم القيامة أعظم ما كانت فتطؤك","cause":"ما مِن صاحِبِ إبِلٍ ولا بَقَرٍ ولا غَنَمٍ لا يُؤَدِّي زَكاتَها","result":"إلَّا جاءَت يَومَ القيامةِ أعظَمَ ما كانَت وأسمَنَه، تَنطَحُه بقُرونِها وتَطَؤُه بأظلافِها، كُلَّما نَفِدَت أُخراها عادَت عليه أُولاها، حتَّى يُقضى بينَ النَّاسِ","explicit":true,"star":true,"similar":["س-05192"],"ref":"صحيح مسلم 990","srcLabel":"البخاري","text":["انتَهَيتُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم وهو جالِسٌ في ظِلِّ الكَعبةِ، فلَمَّا رَآني قال: هُمُ الأخسَرونَ ورَبِّ الكَعبةِ! قال: فجِئتُ حتَّى جَلَستُ، فلَم أتَقارَّ أن قُمتُ فقُلتُ: يا رَسولَ اللهِ، فِداكَ أبي وأُمِّي، مَن هُم؟ قال: هُمُ الأكثَرونَ أموالًا، إلَّا مَن قال هَكَذا وهَكَذا وهَكَذا، مِن بينَ يَدَيه ومِن خَلفِه وعَن يَمينِه وعَن شِمالِه، وقَليلٌ ما هُم، ",["ما مِن صاحِبِ إبِلٍ ولا بَقَرٍ ولا غَنَمٍ لا يُؤَدِّي زَكاتَها",1]," ",["إلَّا جاءَت يَومَ القيامةِ أعظَمَ ما كانَت وأسمَنَه، تَنطَحُه بقُرونِها وتَطَؤُه بأظلافِها، كُلَّما نَفِدَت أُخراها عادَت عليه أُولاها، حتَّى يُقضى بينَ النَّاسِ",2],". [وفي روايةٍ]: انتَهَيتُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم وهو جالِسٌ في ظِلِّ الكَعبةِ، فذَكَرَ نَحوَ حَديثِ وكيعٍ، غيرَ أنَّه قال: والذي نَفسي بيَدِه ما على الأرضِ رَجُلٌ يَموتُ فيَدَعُ إبِلًا أو بَقَرًا أو غَنَمًا لَم يُؤَدِّ زَكاتَها."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1460) باختلاف يسير","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"idPGCs5y","merged":3,"otherRefs":["صحيح البخاري 1460 (صحيح)","صحيح مسلم 988 (صحيح)"]},{"id":"س-07743","fp":"8a5486bf62dd","stateId":757,"easy":"إذا كنت صاحب إبل لا تؤدي زكاتها ← يُبطح لها بقاع قرقر فتطؤك","cause":"وما مِن صاحِبِ إبِلٍ لا يُؤَدِّي زَكاتَها","result":"إلَّا بُطِحَ لها بقاعٍ قَرقَرٍ كَأوفَرِ ما كانَت تَستَنُّ عليه، كُلَّما مَضى عليه أُخراها رُدَّت عليه أولاها، حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ","explicit":true,"star":true,"similar":["س-07744"],"ref":"صحيح مسلم 987","srcLabel":"مسلم","text":["ما مِن صاحِبِ كَنزٍ لا يُؤَدِّي زَكاتَه إلَّا أُحميَ عليه في نارِ جَهَنَّمَ، فيُجعَلُ صَفائِحَ، فيُكوى بها جَنباه وجَبينُه حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ، ",["وما مِن صاحِبِ إبِلٍ لا يُؤَدِّي زَكاتَها",1]," ",["إلَّا بُطِحَ لها بقاعٍ قَرقَرٍ كَأوفَرِ ما كانَت تَستَنُّ عليه، كُلَّما مَضى عليه أُخراها رُدَّت عليه أولاها، حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ",2],"، وما مِن صاحِبِ غَنَمٍ لا يُؤَدِّي زَكاتَها إلَّا بُطِحَ لها بقاعٍ قَرقَرٍ كَأوفَرِ ما كانَت فتَطَؤُه بأظلافِها وتَنطَحُه بقُرونِها، ليس فيها عَقصاءُ ولا جَلحاءُ، كُلَّما مَضى عليه أُخراها رُدَّت عليه أولاها، حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ ممَّا تَعُدُّونَ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ. قال سُهَيلٌ: فلا أدري أذَكَرَ البَقَرَ أم لا، قالوا: فالخَيلُ؟ يا رَسولَ اللهِ، قال: الخَيلُ في نَواصيها -أو قال، الخَيلُ مَعقودٌ في نَواصيها. قال سُهَيلٌ: أنا أشُكُّ- الخَيرُ إلى يَومِ القيامةِ، الخَيلُ ثَلاثةٌ: فهي لرَجُلٍ أجرٌ، ولرَجُلٍ سِترٌ، ولرَجُلٍ وِزرٌ؛ فأمَّا التي هي له أجرٌ: فالرَّجُلُ يَتَّخِذُها في سَبيلِ اللهِ ويُعِدُّها له، فلا تُغَيِّبُ شيئًا في بُطونِها إلَّا كَتَبَ اللهُ له أجرًا، ولو رَعاها في مَرجٍ، ما أكَلَت مِن شيءٍ إلَّا كَتَبَ اللهُ له بها أجرًا، ولو سَقاها مِن نَهرٍ، كانَ له بكُلِّ قَطرةٍ تُغَيِّبُها في بُطونِها أجرٌ، حتَّى ذَكَرَ الأجرَ في أبوالِها وأرواثِها، ولَوِ استَنَّت شَرَفًا أو شَرَفَينِ، كُتِبَ له بكُلِّ خُطوةٍ تَخطوها أجرٌ، وأمَّا الذي هي له سِترٌ: فالرَّجُلُ يَتَّخِذُها تَكَرُّمًا وتَجَمُّلًا، ولا يَنسى حَقَّ ظُهورِها وبُطونِها في عُسرِها ويُسرِها، وأمَّا الذي عليه وِزرٌ فالذي يَتَّخِذُها أشَرًا وبَطَرًا وبَذَخًا ورياءَ النَّاسِ، فذاك الذي هي عليه وِزرٌ، قالوا: فالحُمُرُ يا رَسولَ اللهِ؟ قال: ما أنزَلَ اللهُ عليَّ فيها شيئًا إلَّا هذه الآيةَ الجامِعةَ الفاذَّةَ: {فمَنْ يَعمَلْ مِثقالَ ذَرَّةٍ خَيرًا يَرَهُ * ومَن يَعمَلْ مِثقالَ ذَرَّةٍ شَرًّا يَرَهُ} [الزلزلة: 7-8]. [وفي روايةٍ]: بَدَلَ عَقصاءُ: عَضباءُ، وقال: فيُكوى بها جَنبُه وظَهرُه، ولَم يَذكُرْ: جَبينُه. [وفي روايةٍ]: إذا لَم يُؤَدِّ المَرءُ حَقَّ اللهِ، أوِ الصَّدَقةَ في إبِلِه، وساقَ الحَديثَ بنَحوِ حَديثِ سُهَيلٍ عن أبيه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (987) مطولاً","bab":"قرآن › أسباب النزول","dorar":"1IlMX4Z5","merged":4,"otherRefs":["تخريج المسند لشعيب 8977 (صحيح)","تخريج المسند لشعيب 7563 (صحيح)","صحيح مسلم 987 (صحيح)"]},{"id":"س-07744","fp":"a8560adf7618","stateId":757,"easy":"إذا كنت صاحب غنم لا تؤدي زكاتها ← يُبطح لها بقاع قرقر فتطؤك وتنطحك","cause":"وما مِن صاحِبِ غَنَمٍ لا يُؤَدِّي زَكاتَها","result":"إلَّا بُطِحَ لها بقاعٍ قَرقَرٍ كَأوفَرِ ما كانَت فتَطَؤُه بأظلافِها وتَنطَحُه بقُرونِها، ليس فيها عَقصاءُ ولا جَلحاءُ، كُلَّما مَضى عليه أُخراها رُدَّت عليه أولاها، حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ ممَّا تَعُدُّونَ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ","explicit":true,"repOf":"س-07743","ref":"صحيح مسلم 987","text":["ما مِن صاحِبِ كَنزٍ لا يُؤَدِّي زَكاتَه إلَّا أُحميَ عليه في نارِ جَهَنَّمَ، فيُجعَلُ صَفائِحَ، فيُكوى بها جَنباه وجَبينُه حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ، وما مِن صاحِبِ إبِلٍ لا يُؤَدِّي زَكاتَها إلَّا بُطِحَ لها بقاعٍ قَرقَرٍ كَأوفَرِ ما كانَت تَستَنُّ عليه، كُلَّما مَضى عليه أُخراها رُدَّت عليه أولاها، حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ، ",["وما مِن صاحِبِ غَنَمٍ لا يُؤَدِّي زَكاتَها",1]," ",["إلَّا بُطِحَ لها بقاعٍ قَرقَرٍ كَأوفَرِ ما كانَت فتَطَؤُه بأظلافِها وتَنطَحُه بقُرونِها، ليس فيها عَقصاءُ ولا جَلحاءُ، كُلَّما مَضى عليه أُخراها رُدَّت عليه أولاها، حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ ممَّا تَعُدُّونَ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ",2],". قال سُهَيلٌ: فلا أدري أذَكَرَ البَقَرَ أم لا، قالوا: فالخَيلُ؟ يا رَسولَ اللهِ، قال: الخَيلُ في نَواصيها -أو قال، الخَيلُ مَعقودٌ في نَواصيها. قال سُهَيلٌ: أنا أشُكُّ- الخَيرُ إلى يَومِ القيامةِ، الخَيلُ ثَلاثةٌ: فهي لرَجُلٍ أجرٌ، ولرَجُلٍ سِترٌ، ولرَجُلٍ وِزرٌ؛ فأمَّا التي هي له أجرٌ: فالرَّجُلُ يَتَّخِذُها في سَبيلِ اللهِ ويُعِدُّها له، فلا تُغَيِّبُ شيئًا في بُطونِها إلَّا كَتَبَ اللهُ له أجرًا، ولو رَعاها في مَرجٍ، ما أكَلَت مِن شيءٍ إلَّا كَتَبَ اللهُ له بها أجرًا، ولو سَقاها مِن نَهرٍ، كانَ له بكُلِّ قَطرةٍ تُغَيِّبُها في بُطونِها أجرٌ، حتَّى ذَكَرَ الأجرَ في أبوالِها وأرواثِها، ولَوِ استَنَّت شَرَفًا أو شَرَفَينِ، كُتِبَ له بكُلِّ خُطوةٍ تَخطوها أجرٌ، وأمَّا الذي هي له سِترٌ: فالرَّجُلُ يَتَّخِذُها تَكَرُّمًا وتَجَمُّلًا، ولا يَنسى حَقَّ ظُهورِها وبُطونِها في عُسرِها ويُسرِها، وأمَّا الذي عليه وِزرٌ فالذي يَتَّخِذُها أشَرًا وبَطَرًا وبَذَخًا ورياءَ النَّاسِ، فذاك الذي هي عليه وِزرٌ، قالوا: فالحُمُرُ يا رَسولَ اللهِ؟ قال: ما أنزَلَ اللهُ عليَّ فيها شيئًا إلَّا هذه الآيةَ الجامِعةَ الفاذَّةَ: {فمَنْ يَعمَلْ مِثقالَ ذَرَّةٍ خَيرًا يَرَهُ * ومَن يَعمَلْ مِثقالَ ذَرَّةٍ شَرًّا يَرَهُ} [الزلزلة: 7-8]. [وفي روايةٍ]: بَدَلَ عَقصاءُ: عَضباءُ، وقال: فيُكوى بها جَنبُه وظَهرُه، ولَم يَذكُرْ: جَبينُه. [وفي روايةٍ]: إذا لَم يُؤَدِّ المَرءُ حَقَّ اللهِ، أوِ الصَّدَقةَ في إبِلِه، وساقَ الحَديثَ بنَحوِ حَديثِ سُهَيلٍ عن أبيه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (987) مطولاً","bab":"قرآن › أسباب النزول","dorar":"1IlMX4Z5","merged":4,"otherRefs":["تخريج المسند لشعيب 8977 (صحيح)","تخريج المسند لشعيب 7563 (صحيح)","صحيح مسلم 987 (صحيح)"]},{"id":"س-06137","fp":"e78df74075b7","stateId":757,"easy":"إذا تركت بعدك كنزاً ← يُمثّل لك يوم القيامة شجاعاً أقرع يتبعك","cause":"مَن تَرَك بَعدَه كَنزًا","result":"مُثِّل له يَومَ القِيامةِ شُجاعًا أقرَعَ له زَبيبَتانِ يُتْبِعُ فاه، فيَقولُ: وَيلَكَ! ما لَكَ؟ فيَقولُ: أنا كَنزُكَ الَّذي تَرَكْتَه بَعدَكَ، فلا يَزالُ يَتبَعُه حتَّى يُلقِمَه يَدَه، فيَقضَمُها، ثمَّ يُتبِعُه سائرَ جَسَدِه","explicit":true,"similar":["س-06135"],"ref":"المستدرك على الصحيحين 1452","srcLabel":"مسلم","text":[["مَن تَرَك بَعدَه كَنزًا",1]," ",["مُثِّل له يَومَ القِيامةِ شُجاعًا أقرَعَ له زَبيبَتانِ يُتْبِعُ فاه، فيَقولُ: وَيلَكَ! ما لَكَ؟ فيَقولُ: أنا كَنزُكَ الَّذي تَرَكْتَه بَعدَكَ، فلا يَزالُ يَتبَعُه حتَّى يُلقِمَه يَدَه، فيَقضَمُها، ثمَّ يُتبِعُه سائرَ جَسَدِه",2],"."],"grade":"صحيح","narrator":"ثوبان","muhaddith":"صحيح على شرط مسلم، وله شاهد صحيح على شرط مسلم","bab":"زكاة › عقوبة مانع الزكاة","dorar":"HG3O8Mr1","merged":3,"otherRefs":["مختصر زوائد البزار 1/371 (صحيح)","صحيح الموارد 668 (صحيح)"]},{"id":"س-07742","fp":"c5ecb114da0b","stateId":757,"easy":"إذا كنت صاحب كنز لا تؤدي زكاته ← يُحمى عليك في نار جهنم فيُجعل صفائح يُكوى بها جنبك","cause":"ما مِن صاحِبِ كَنزٍ لا يُؤَدِّي زَكاتَه","result":"إلَّا أُحميَ عليه في نارِ جَهَنَّمَ، فيُجعَلُ صَفائِحَ، فيُكوى بها جَنباه وجَبينُه حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ","explicit":true,"similar":["س-07739","س-03887","س-03897"],"ref":"صحيح مسلم 987","srcLabel":"مسلم","text":[["ما مِن صاحِبِ كَنزٍ لا يُؤَدِّي زَكاتَه",1]," ",["إلَّا أُحميَ عليه في نارِ جَهَنَّمَ، فيُجعَلُ صَفائِحَ، فيُكوى بها جَنباه وجَبينُه حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ،",2]," وإمَّا إلى النَّارِ، وما مِن صاحِبِ إبِلٍ لا يُؤَدِّي زَكاتَها إلَّا بُطِحَ لها بقاعٍ قَرقَرٍ كَأوفَرِ ما كانَت تَستَنُّ عليه، كُلَّما مَضى عليه أُخراها رُدَّت عليه أولاها، حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ، وما مِن صاحِبِ غَنَمٍ لا يُؤَدِّي زَكاتَها إلَّا بُطِحَ لها بقاعٍ قَرقَرٍ كَأوفَرِ ما كانَت فتَطَؤُه بأظلافِها وتَنطَحُه بقُرونِها، ليس فيها عَقصاءُ ولا جَلحاءُ، كُلَّما مَضى عليه أُخراها رُدَّت عليه أولاها، حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ ممَّا تَعُدُّونَ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ. قال سُهَيلٌ: فلا أدري أذَكَرَ البَقَرَ أم لا، قالوا: فالخَيلُ؟ يا رَسولَ اللهِ، قال: الخَيلُ في نَواصيها -أو قال، الخَيلُ مَعقودٌ في نَواصيها. قال سُهَيلٌ: أنا أشُكُّ- الخَيرُ إلى يَومِ القيامةِ، الخَيلُ ثَلاثةٌ: فهي لرَجُلٍ أجرٌ، ولرَجُلٍ سِترٌ، ولرَجُلٍ وِزرٌ؛ فأمَّا التي هي له أجرٌ: فالرَّجُلُ يَتَّخِذُها في سَبيلِ اللهِ ويُعِدُّها له، فلا تُغَيِّبُ شيئًا في بُطونِها إلَّا كَتَبَ اللهُ له أجرًا، ولو رَعاها في مَرجٍ، ما أكَلَت مِن شيءٍ إلَّا كَتَبَ اللهُ له بها أجرًا، ولو سَقاها مِن نَهرٍ، كانَ له بكُلِّ قَطرةٍ تُغَيِّبُها في بُطونِها أجرٌ، حتَّى ذَكَرَ الأجرَ في أبوالِها وأرواثِها، ولَوِ استَنَّت شَرَفًا أو شَرَفَينِ، كُتِبَ له بكُلِّ خُطوةٍ تَخطوها أجرٌ، وأمَّا الذي هي له سِترٌ: فالرَّجُلُ يَتَّخِذُها تَكَرُّمًا وتَجَمُّلًا، ولا يَنسى حَقَّ ظُهورِها وبُطونِها في عُسرِها ويُسرِها، وأمَّا الذي عليه وِزرٌ فالذي يَتَّخِذُها أشَرًا وبَطَرًا وبَذَخًا ورياءَ النَّاسِ، فذاك الذي هي عليه وِزرٌ، قالوا: فالحُمُرُ يا رَسولَ اللهِ؟ قال: ما أنزَلَ اللهُ عليَّ فيها شيئًا إلَّا هذه الآيةَ الجامِعةَ الفاذَّةَ: {فمَنْ يَعمَلْ مِثقالَ ذَرَّةٍ خَيرًا يَرَهُ * ومَن يَعمَلْ مِثقالَ ذَرَّةٍ شَرًّا يَرَهُ} [الزلزلة: 7-8]. [وفي روايةٍ]: بَدَلَ عَقصاءُ: عَضباءُ، وقال: فيُكوى بها جَنبُه وظَهرُه، ولَم يَذكُرْ: جَبينُه. [وفي روايةٍ]: إذا لَم يُؤَدِّ المَرءُ حَقَّ اللهِ، أوِ الصَّدَقةَ في إبِلِه، وساقَ الحَديثَ بنَحوِ حَديثِ سُهَيلٍ عن أبيه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (987) مطولاً","bab":"قرآن › أسباب النزول","dorar":"1IlMX4Z5","merged":3,"otherRefs":["تخريج المسند لشعيب 8977 (صحيح)","تخريج المسند لشعيب 7563 (صحيح)"]},{"id":"س-08375","fp":"0f33423ef6a3","stateId":757,"easy":"إذا أوكيت على ذهب أو فضة (فلم تنفقه في سبيل الله) ← فهو جمر عليك يوم القيامة","cause":"أيُّما ذهَبٍ أو فِضَّةٍ أُوكيَ عليه","result":"فهو جَمرٌ على صاحِبِه يومَ القِيامةِ حتى يُفرِغَه إفراغًا في سَبيلِ اللهِ","explicit":true,"ref":"تخريج المسند لشعيب 21528","srcLabel":"مسلم","text":["كُنْتُ مع أبي ذَرٍّ، وقد خرَجَ عَطاؤُه، ومعه جاريةٌ له، فجعَلَتْ تَقْضي حوائجَه، وقال مرَّةً: تَقْضي، قال: ففضَلَ معه فَضلٌ، قال: أحسَبُه قال: سَبعٌ، قال: فأمَرَها أنْ تَشتريَ بها فُلوسًا، قُلْتُ: يا أبا ذَرٍّ، لوِ ادَّخرْتَه للحاجةِ تَنوبُكَ، وللضيفِ يَأْتيكَ، فقال: إنَّ خَليلي عهِدَ إليَّ أنْ: ",["أيُّما ذهَبٍ أو فِضَّةٍ أُوكيَ عليه",1],"، ",["فهو جَمرٌ على صاحِبِه يومَ القِيامةِ حتى يُفرِغَه إفراغًا في سَبيلِ اللهِ",2],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (21528) واللفظ له، والبزار (3926)، والطبراني (2/151) (1634)","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"XHvMsNnO","merged":3,"otherRefs":["الصحيح المسند 266 (صحيح)","الزواجر عن اقتراف الكبائر 1/178 (صحيح)"]},{"id":"س-02960","fp":"d738ab0b66b8","stateId":757,"easy":"إذا كان لك مال فلم تؤدِّ حقه ← يُجعل يوم القيامة شجاعاً أقرع يطوقك","cause":"مَن كان له مالٌ فلم يُؤَدِّ حَقَّه","result":"جُعِلَ يَومَ القِيامَةِ شُجاعًا أَقرَعَ، لِفيهِ زَبيبَتان، يَتبَعُه حتى يَضَعَ يَدَه في فيهِ، فلا يَزالُ يَقضِمُها حتى يُقضى بيْنَ العِبادِ","explicit":true,"repOf":"س-03021","ref":"تخريج المسند لشعيب 7756","text":[["مَن كان له مالٌ فلم يُؤَدِّ حَقَّه",1],"؛ ",["جُعِلَ يَومَ القِيامَةِ شُجاعًا أَقرَعَ، لِفيهِ زَبيبَتان، يَتبَعُه حتى يَضَعَ يَدَه في فيهِ، فلا يَزالُ يَقضِمُها حتى يُقضى بيْنَ العِبادِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1403) باختلاف يسير، ومسلم (987) بمعناه مطولاً","bab":"إيمان › الوعيد","dorar":"NPiwNMl7"},{"id":"س-03892","fp":"b4bf42df506e","stateId":757,"easy":"إذا كنزت المال ولم تؤد زكاته ← فويل لك","cause":"مَن كَنَزَها فلم يُؤَدِّ زَكاتَها","result":"فوَيْلٌ له","explicit":true,"ref":"الأحاديث المختارة 13 / 173","srcLabel":"متفق عليه","text":["عن خالِدِ بنِ أَسلَمَ، قالَ: «خَرَجْنا معَ عَبْدِ اللهِ بنِ عُمَرَ نَمْشي فلَحِقَنا أعْرابيٌّ، فقالَ: أنت عَبْدُ اللهِ بنُ عُمَرَ؟ قالَ: نَعمْ، قالَ: سَألْتُ عنك فدُلِلْتُ عليك، فأَخْبِرْني: أَتَرِثُ العَمَّةُ؟ فقالَ ابنُ عُمَرَ: لا أَدْري، فقالَ: أنت لا تَدْري ولا نَدْري؟ قالَ: نَعمْ: اذْهَبْ إلى العُلَماءِ فاسْأَلْهم، فلمَّا أَدبَرَ قَبَّلَ يَدَيه، ثُمَّ قالَ: نِعْمَ ما قالَ أبو عَبْدِ الرَّحْمنِ يُسأَلُ عمَّا لا يَدْري! فقالَ: لا أَدْري، قالَ الأعْرابيُّ: قَوْلُ اللهِ عَزَّ وجَلَّ: {وَالَّذِينَ يَكْنِزُونَ الذَّهَبَ وَالْفِضَّةَ} فقالَ ابنُ عُمَرَ: ",["مَن كَنَزَها فلم يُؤَدِّ زَكاتَها",1],"، ",["فوَيْلٌ له",2]," إنَّما كانَ هذا قَبْلَ أن تُنزَلَ الزَّكاةُ، فلمَّا أُنزِلَتْ جَعَلَها اللهُ طُهْرةً، ثُمَّ الْتَفَتَ إليَّ، فقالَ: ما أُبالي لو كانَ عِنْدي مِثلُ أحُدٍ ذَهَبًا أَعلَمُ عَدَدَه أُزَكِّيه وأَعمَلُ فيه بطاعةِ اللهِ»."],"grade":"صحيح","narrator":"خالد بن أسلم","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"تفسير آيات › سورة التوبة","dorar":"2Wm4bqG5"},{"id":"س-04154","fp":"d03018f1ccab","stateId":757,"easy":"إذا كنزت الدنانير (من أهل المسألة) ← فهي كيّات عليك","cause":"هل ترَكَ مِن شَيءٍ؟ قالوا: ثَلاثَ دَنانيرَ","result":"ثَلاثُ كَيَّاتٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 16527","srcLabel":"البخاري","text":["كنتُ مع النَّبيِّ صلَّى اللهُ عليه وسَلَّمَ، فأُتيَ بِجِنازةٍ، فقالوا: يا نَبيَّ اللهِ، صَلِّ عليها. قال: هل ترَكَ شَيئًا؟ قالوا: لا. قال: هل ترَكَ عليه دَيْنًا؟ قالوا: لا. فصَلَّى عليه. ثم أُتيَ بِجِنازةٍ بَعدَ ذلك، فقال: هل ترَكَ عليه مِن دَيْنٍ؟ قالوا: لا. قال: ",["هل ترَكَ مِن شَيءٍ؟ قالوا: ثَلاثَ دَنانيرَ",1],". قال: ",["ثَلاثُ كَيَّاتٍ",2],". قال: فأُتيَ بِالثَّالِثةِ، فقال: هل ترَكَ عليه مِن دَيْنٍ؟ قالوا: نَعَمْ. قال: هل ترَكَ مِن شَيءٍ؟ قالوا: لا. قال: صَلُّوا على صاحِبِكم. فقال رَجُلٌ مِنَ الأنصارِ، يُقالُ له أبو قَتادةَ: يا رَسولَ اللهِ، علَيَّ دَيْنُهُ. فصَلَّى عليه."],"grade":"صحيح","narrator":"سلمة بن الأكوع","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (2289) باختلاف يسير","bab":"جنائز وموت › قضاء دين الميت","dorar":"kOYiMeon","merged":7,"otherRefs":["تخريج المسند لشعيب 22172 (صحيح)","تخريج المسند لشعيب 22221 (صحيح)","تخريج المسند لشعيب 22174 (صحيح)","إتحاف الخيرة المهرة 2/472 (صحيح)","تخريج المسند لشعيب 14688 (حسن)","تخريج المسند لشعيب 22180 (صحيح)"]},{"id":"س-05072","fp":"6241d2f74785","stateId":757,"easy":"إذا كان لك مال لم تعطِ حقه ← تطؤك الإبل بأخفافها والبقر والغنم يوم القيامة","cause":"المالُ الَّذي لم يُعْطَ الحقُّ منها","result":"فتطَأُ الإبلُ سيِّدَها بأخفافِها ويأتي البقرُ والغَنمُ فتطَأُ صاحبَها بأظلافِها وتنطَحُه بقرونِها","explicit":true,"ref":"تخريج صحيح ابن حبان 3254","srcLabel":"متفق عليه","text":["يأتي ",["المالُ الَّذي لم يُعْطَ الحقُّ منها",1]," ",["فتطَأُ الإبلُ سيِّدَها بأخفافِها ويأتي البقرُ والغَنمُ فتطَأُ صاحبَها بأظلافِها وتنطَحُه بقرونِها",2]," ويأتي الكنزُ شُجاعًا أقرَعَ فيَلقى صاحبَه فيفِرُّ منه ثمَّ يستقبِلُه ويفِرُّ منه فيقولُ: ما لي وما وما لك ؟ ! فيقولُ: أنا كَنزُك أنا كنزُك فيتلقَّاه صاحبُه بيدِه فيلقَمُ يدَه"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (1402، 6957) مفرقاً بنحوه","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"XRvWQ6wA"},{"id":"س-05073","fp":"2db12a8be710","stateId":757,"easy":"إذا كنزت المال ولم تؤدِّ حقه ← يأتي يوم القيامة شجاعاً أقرع يلاحقك","cause":"ويأتي الكنزُ","result":"شُجاعًا أقرَعَ فيَلقى صاحبَه فيفِرُّ منه ثمَّ يستقبِلُه ويفِرُّ منه فيقولُ: ما لي وما وما لك ؟ ! فيقولُ: أنا كَنزُك أنا كنزُك فيتلقَّاه صاحبُه بيدِه فيلقَمُ يدَه","explicit":true,"repOf":"س-03021","ref":"تخريج صحيح ابن حبان 3254","text":["يأتي المالُ الَّذي لم يُعْطَ الحقُّ منها فتطَأُ الإبلُ سيِّدَها بأخفافِها ويأتي البقرُ والغَنمُ فتطَأُ صاحبَها بأظلافِها وتنطَحُه بقرونِها ",["ويأتي الكنزُ",1]," ",["شُجاعًا أقرَعَ فيَلقى صاحبَه فيفِرُّ منه ثمَّ يستقبِلُه ويفِرُّ منه فيقولُ: ما لي وما وما لك ؟ ! فيقولُ: أنا كَنزُك أنا كنزُك فيتلقَّاه صاحبُه بيدِه فيلقَمُ يدَه",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (1402، 6957) مفرقاً بنحوه","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"XRvWQ6wA"},{"id":"س-06135","fp":"12f553a07abd","stateId":757,"easy":"إذا تركت كنزاً (لم تؤدِّ حقه) ← يُمثّل لك يوم القيامة شجاعاً أقرع يتبعك","cause":"مَن ترَكَ كَنزًا","result":"فإنَّه يُمثَّلُ له يَومَ القِيامةِ شُجاعًا أقرعَ يَتبَعُهُ، له زَبيبَتانِ، فما زالَ يَطلُبُه، يَقولُ: وَيلَكَ ما أنتَ","explicit":true,"repOf":"س-06137","ref":"تخريج المسند لشعيب 10344","text":[["مَن ترَكَ كَنزًا؛ ",1],["فإنَّه يُمثَّلُ له يَومَ القِيامةِ شُجاعًا أقرعَ يَتبَعُهُ، له زَبيبَتانِ، فما زالَ يَطلُبُه، يَقولُ: وَيلَكَ ما أنتَ",2],"؟ قال: يَقولُ: أنا كَنزُكَ الذي ترَكتَ بَعدَكَ. قال: فيُلقِمُهُ يَدَهُ فيَقضَمُها، ثم يُتبِعُهُ سائرَ جَسدِهِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6957) باختلاف يسير، ومسلم (987) بمعناه مطولاً","bab":"زكاة › عقوبة مانع الزكاة","dorar":"Ky1gWEHY"},{"id":"س-06143","fp":"10368f0ca7aa","stateId":757,"easy":"إذا لم تعطِ حق إبلك وبقرك وغنمك ← تطؤك بأخفافها وأظلافها يوم القيامة","cause":"الإبلُ الَّتي لم تُعطِ الحقَّ منها","result":"تطَأُ صاحبَها بأخفافِها وتأتي البقرُ والغنمُ تطَأُ صاحبَها بأظلافِها وتَنطحُهُ بقرونِها","explicit":true,"similar":["س-06133"],"ref":"صحيح ابن ماجه 1457","srcLabel":"متفق عليه","text":["تأتي ",["الإبلُ الَّتي لم تُعطِ الحقَّ منها",1]," ",["تطَأُ صاحبَها بأخفافِها وتأتي البقرُ والغنمُ تطَأُ صاحبَها بأظلافِها وتَنطحُهُ بقرونِها",2]," ويأتي الكَنزُ شجاعًا أقرعَ فيَلقى صاحبَهُ يومَ القيامةِ فيَفرُّ منهُ صاحبُهُ مرَّتينِ ثمَّ يستَقبلُهُ فيفرُّ فيقولُ ما لي ولَكَ فيقولُ أنا كَنزُكَ أنا كَنزُكَ فيتقيهِ بيدِهِ فَيلقَمُها"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه البخاري (1402)، ومسلم (987)، والنسائي (2448)، وابن ماجه (1786) واللفظ له، وأحمد (8965)","bab":"زكاة › عقوبة مانع الزكاة","dorar":"6oRWVpKj"},{"id":"س-06144","fp":"4fc950d76ba5","stateId":757,"easy":"إذا كنزت المال ← يأتي يوم القيامة شجاعاً أقرع يلاحقك","cause":"ويأتي الكَنزُ","result":"شجاعًا أقرعَ فيَلقى صاحبَهُ يومَ القيامةِ فيَفرُّ منهُ صاحبُهُ مرَّتينِ ثمَّ يستَقبلُهُ فيفرُّ فيقولُ ما لي ولَكَ فيقولُ أنا كَنزُكَ أنا كَنزُكَ فيتقيهِ بيدِهِ فَيلقَمُها","explicit":true,"repOf":"س-03021","ref":"صحيح ابن ماجه 1457","text":["تأتي الإبلُ الَّتي لم تُعطِ الحقَّ منها تطَأُ صاحبَها بأخفافِها وتأتي البقرُ والغنمُ تطَأُ صاحبَها بأظلافِها وتَنطحُهُ بقرونِها ",["ويأتي الكَنزُ",1]," ",["شجاعًا أقرعَ فيَلقى صاحبَهُ يومَ القيامةِ فيَفرُّ منهُ صاحبُهُ مرَّتينِ ثمَّ يستَقبلُهُ فيفرُّ فيقولُ ما لي ولَكَ فيقولُ أنا كَنزُكَ أنا كَنزُكَ فيتقيهِ بيدِهِ فَيلقَمُها",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه البخاري (1402)، ومسلم (987)، والنسائي (2448)، وابن ماجه (1786) واللفظ له، وأحمد (8965)","bab":"زكاة › عقوبة مانع الزكاة","dorar":"6oRWVpKj"},{"id":"س-06155","fp":"02d080d8fc8f","stateId":757,"easy":"إذا آتاك الله مالاً فلم تؤدِّ زكاته ← يُمثّل لك يوم القيامة شجاعاً أقرع","cause":"مَنْ آتاهُ اللهُ مالًا فلَمْ يؤَدِ زكاتَهُ","result":"مُثِّلَ له يومَ القيامَةِ شجاعًا أقرَعَ لَهُ زبيبتانِ يطوِّقُهُ يومَ القيامَةِ ثُمَّ يأخُذُ بلِهْزِمَتَيْهِ","explicit":true,"repOf":"س-03021","ref":"تخريج مشكلة الفقر 60","text":[["مَنْ آتاهُ اللهُ مالًا فلَمْ يؤَدِ زكاتَهُ",1]," ",["مُثِّلَ له يومَ القيامَةِ شجاعًا أقرَعَ لَهُ زبيبتانِ يطوِّقُهُ يومَ القيامَةِ ثُمَّ يأخُذُ بلِهْزِمَتَيْهِ",2]," يعني بِشِدْقَيْهِ ثُمَّ يقولُ : أنا مالُكَ أنا كنزُكَ ثُمَّ تلا النبىُّ : ولَا يَحْسَبَنَّ الَّذِينَ يَبْخَلُونَ بِمَا آتاهُمُ اللهُ مِنْ فَضْلِهِ هُوَ خَيْرًا لَهُمْ بَلْ هُوَ شَرٌّ لَهُمْ سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ القيامَةِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1403) باختلاف يسير.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"rXyxhxTV"},{"id":"س-07739","fp":"ac06a4578321","stateId":757,"easy":"إذا كنت صاحب ذهب أو فضة لا تؤدي حقها ← تُصفّح لك يوم القيامة صفائح من نار يُكوى بها","cause":"ما مِن صاحِبِ ذَهَبٍ ولا فِضَّةٍ لا يُؤَدِّي مِنها حَقَّها","result":"إلَّا إذا كانَ يَومُ القيامةِ صُفِّحَت له صَفائِحُ مِن نارٍ، فأُحميَ عليها في نارِ جَهَنَّمَ، فيُكوى بها جَنبُه وجَبينُه وظَهرُه، كُلَّما بَرَدَت أُعيدَت له، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ","explicit":true,"repOf":"س-07742","ref":"صحيح مسلم 987","text":[["ما مِن صاحِبِ ذَهَبٍ ولا فِضَّةٍ لا يُؤَدِّي مِنها حَقَّها",1]," ",["إلَّا إذا كانَ يَومُ القيامةِ صُفِّحَت له صَفائِحُ مِن نارٍ، فأُحميَ عليها في نارِ جَهَنَّمَ، فيُكوى بها جَنبُه وجَبينُه وظَهرُه، كُلَّما بَرَدَت أُعيدَت له، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ",2]," سَنةٍ، حتَّى يُقضى بينَ العِبادِ، فيَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ. قيلَ: يا رَسولَ اللهِ، فالإبِلُ؟ قال: ولا صاحِبُ إبِلٍ لا يُؤَدِّي مِنها حَقَّها -ومِن حَقِّها حَلَبُها يَومَ وِردِها- إلَّا إذا كانَ يَومُ القيامةِ بُطِحَ لها بقاعٍ قَرقَرٍ أوفَرَ ما كانَت، لا يَفقِدُ مِنها فصيلًا واحِدًا، تَطَؤُه بأخفافِها وتَعَضُّه بأفواهِها، كُلَّما مَرَّ عليه أُولاها رُدَّ عليه أُخراها، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، حتَّى يُقضى بينَ العِبادِ، فيَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ. قيلَ: يا رَسولَ اللهِ، فالبَقَرُ والغَنَمُ؟ قال: ولا صاحِبُ بَقَرٍ ولا غَنَمٍ لا يُؤَدِّي مِنها حَقَّها إلَّا إذا كانَ يَومُ القيامةِ بُطِحَ لها بقاعٍ قَرقَرٍ، لا يَفقِدُ مِنها شيئًا، ليس فيها عَقصاءُ ولا جَلحاءُ ولا عَضباءُ، تَنطَحُه بقُرونِها وتَطَؤُه بأظلافِها، كُلَّما مَرَّ عليه أولاها رُدَّ عليه أُخراها، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، حتَّى يُقضى بينَ العِبادِ، فيَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ. قيلَ: يا رَسولَ اللهِ، فالخَيلُ؟ قال: الخَيلُ ثَلاثةٌ: هي لرَجُلٍ وِزرٌ، وهي لرَجُلٍ سِترٌ، وهي لرَجُلٍ أجرٌ؛ فأمَّا التي هي له وِزرٌ فرَجُلٌ رَبَطَها رياءً وفَخرًا ونِواءً على أهلِ الإسلامِ، فهي له وِزرٌ، وأمَّا التي هي له سِترٌ فرَجُلٌ رَبَطَها في سَبيلِ اللهِ، ثُمَّ لَم يَنسَ حَقَّ اللهِ في ظُهورِها ولا رِقابِها، فهي له سِترٌ، وأمَّا التي هي له أجرٌ فرَجُلٌ رَبَطَها في سَبيلِ اللهِ لأهلِ الإسلامِ في مَرجٍ ورَوضةٍ، فما أكَلَت مِن ذلك المَرجِ أوِ الرَّوضةِ مِن شَيءٍ إلَّا كُتِبَ له عَدَدَ ما أكَلَت حَسَناتٌ، وكُتِبَ له عَدَدَ أرواثِها وأبوالِها حَسَناتٌ، ولا تَقطَعُ طِوَلَها فاستَنَّت شَرَفًا أو شَرَفَينِ، إلَّا كَتَبَ اللهُ له عَدَدَ آثارِها وأرواثِها حَسَناتٍ، ولا مَرَّ بها صاحِبُها على نَهرٍ، فشَرِبَت منه ولا يُريدُ أن يَسقيَها؛ إلَّا كَتَبَ اللهُ له عَدَدَ ما شَرِبَت حَسَناتٍ. قيلَ: يا رَسولَ اللهِ، فالحُمُرُ؟ قال: ما أُنزِلَ عليَّ في الحُمُرِ شَيءٌ إلَّا هذه الآيةُ الفاذَّةُ الجامِعةُ: {فمَن يَعمَلْ مِثقالَ ذَرَّةٍ خَيرًا يَرَهُ * ومَن يَعمَلْ مِثقالَ ذَرَّةٍ شَرًّا يَرَهُ}. [الزلزلة: 7-8]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2371) مختصراً، ومسلم (987) واللفظ له","bab":"قرآن › أسباب النزول","dorar":"J4xobANc"},{"id":"س-03887","fp":"6a08d0b593f5","stateId":757,"easy":"إذا كان لك ذهب أو فضة لم تؤد زكاتها ← تُجعل يوم القيامة صفائح من نار يُكوى بها جنبك","cause":"مَن كانت لَه ذَهَبٌ أو فضَّةٌ لم يؤدِّ ما فيها","result":"جُعِلَت لَه يومَ القيامةِ صفائحَ من نارٍ فوُضِعَت علَى جنبِهِ وظَهْرِهِ وجبهتِهِ، حتَّى يُقضَي بينَ النَّاسِ، ثمَّ يَرى سبيلَهُ","explicit":true,"repOf":"س-07742","ref":"المحلى 6/68","text":[["مَن كانت لَه ذَهَبٌ أو فضَّةٌ لم يؤدِّ ما فيها",1]," ",["جُعِلَت لَه يومَ القيامةِ صفائحَ من نارٍ فوُضِعَت علَى جنبِهِ وظَهْرِهِ وجبهتِهِ، حتَّى يُقضَي بينَ النَّاسِ، ثمَّ يَرى سبيلَهُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"احتج به ، وقال في المقدمة: (لم نحتج إلا بخبر صحيح من رواية الثقات مسند)","takhrij":"أخرجه مسلم (987) مطولاً باختلاف يسير","bab":"تفسير آيات › سورة التوبة","dorar":"rLa9dzNS"},{"id":"س-03895","fp":"5c941ccba027","stateId":757,"easy":"إذا كنت صاحب نعم لم تعط حقها ← تُسلّط عليك يوم القيامة فتخبط وجهك بأخفافها","cause":"إذا ما رَبُّ النَّعَمِ لم يُعطِ حَقَّها","result":"تُسَلَّطُ عليه يَومَ القيامةِ، فتَخبِطُ وجهَه بأخفافِها","explicit":true,"ref":"صحيح البخاري 6957","srcLabel":"مسلم","text":["يَكونُ كَنزُ أحَدِكُم يَومَ القيامةِ شُجاعًا أقرَعَ، يَفِرُّ منه صاحِبُه، فيَطلُبُه ويقولُ: أنا كَنزُك، قال: واللهِ لَن يَزالَ يَطلُبُه حتَّى يَبسُطَ يَدَه فيُلقِمَها فاه، وقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["إذا ما رَبُّ النَّعَمِ لم يُعطِ حَقَّها",1]," ",["تُسَلَّطُ عليه يَومَ القيامةِ، فتَخبِطُ وجهَه بأخفافِها",2],"، وقال بَعضُ النَّاسِ: في رَجُلٍ له إبِلٌ، فخافَ أن تَجِبَ عليه الصَّدَقةُ، فباعَها بإبِلٍ مِثلِها أو بغَنَمٍ أو ببَقَرٍ أو بدَراهمَ؛ فِرارًا مِنَ الصَّدَقةِ بيَومٍ احتيالًا، فلا بَأسَ عليه. وهو يقولُ: إن زَكَّى إبِلَه قَبلَ أن يَحولَ الحَولُ بيَومٍ أو بسِتَّةٍ جازَت عنه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (987) بمعناه","bab":"تفسير آيات › سورة التوبة","dorar":"jLEE4Cvv"},{"id":"س-06140","fp":"a03bf50873bb","stateId":757,"easy":"إذا لم تؤدِّ زكاة مالك ← تُحمى عليك صفائح في نار جهنم فيُكوى بها جنبك","cause":"ما مِن عبدٍ لا يؤدِّي زَكاةَ مالِهِ","result":"إلَّا أتيَ بِهِ وبمالِهِ فأُحْميَ عليهِ صَفائحُ في نارِ جَهَنَّمَ، فتُكْوى بِهِ جَنباهُ وجبينُهُ وظَهْرُهُ، حتَّى يَحكُمَ اللَّهُ بينَ عبادِهِ يومًا مقدارُهُ ألفَ سنَةٍ مِمَّا تعدُّونَ، ثمَّ يرى سبيلَهُ، إمَّا","explicit":true,"similar":["س-07468"],"ref":"صحيح ابن خزيمة 4/ 14","srcLabel":"مسلم","text":[["ما مِن عبدٍ لا يؤدِّي زَكاةَ مالِهِ",1]," ",["إلَّا أتيَ بِهِ وبمالِهِ فأُحْميَ عليهِ صَفائحُ في نارِ جَهَنَّمَ، فتُكْوى بِهِ جَنباهُ وجبينُهُ وظَهْرُهُ، حتَّى يَحكُمَ اللَّهُ بينَ عبادِهِ يومًا مقدارُهُ ألفَ سنَةٍ مِمَّا تعدُّونَ، ثمَّ يرى سبيلَهُ، إمَّا",2]," إلى الجنَّةِ، وإمَّا إلى النَّارِ ولا عَبدٍ لا يؤدِّي صدقةَ إبلِهِ إلَّا أتيَ بِهِ، وبإبلِهِ علَى أوفرَ ما كانت فيبطحُ لَها بِقاعٍ قَرقرٍ فتسيرُ علَيهِ كلَّما مَضَى آخرُها رُدَّ أوَّلُها حتَّى يحكُمَ اللَّهُ بينَ عبادِهِ في يومٍ كانَ مِقدارُهُ ألفَ سنةٍ مِمَّا تَعدُّونَ، ثمَّ يرَى سبيلَهُ إمَّا إلى الجنَّةِ، وإمَّا إلى النَّارِ ولا عَبدٍ لا يؤدِّي صَدقةَ غنمِهِ إلَّا أتيَ بِهِ وبغَنمِهِ على أوفرَ ما كانَت فيبطَحُ لَها بِقاعٍ قرقرٍ فتسيرُ عليهِ كلَّما مضَى عنهُ آخرُها ردَّ أوَّلُها تطأَهُ بأظلافِها، وتنطحُهُ بقرونِها ليسَ فيها عقصاءُ، ولا جلحاءُ حتَّى يحكمَ اللَّهُ بينَ عبادِهِ في يومٍ كانَ مقدارُهُ ألفَ سنةٍ ممَّا تعدُّونَ، ثمَّ يرى سبيلَهُ إمَّا إلى الجنَّةِ وإمَّا إلى النَّارِ قالوا: يا رسولَ اللَّهِ الخيلُ قالَ: الخيلُ معقودٌ في نواصيها الخيرُ إلى يومِ القيامةِ، والخيلُ لثلاثةٍ هيَ لرجلٍ أجرٌ، ولرجلٍ سترٌ، وعلى رجلٍ وزرٌ فذكرَ الحديثَ بطولِهِ قالوا: الحمرُ يا رسولَ اللَّهِ قالَ: ما أنزلَ اللَّهُ عليَّ فيها شيئًا إلَّا هذِهِ الآيةَ الجامعةَ الفاذَّةَ {فَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُ وَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُ} . الجلحاءُ: التي لَيس لها قرنٌ . والعَقصاءُ: المكسورةُ القَرنِ[وفي روايةٍ]: قال في كلِّها: في يومٍ كان مِقدارُهُ خمسينَ ألفَ سنةٍ مِمَّا تعدُّونَ، وقالَ أيضًا: ثمَّ تستنُّ عليهِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (987)، وأحمد (8977)، وأبو عوانة في ((المستخرج)) (3370) بنحوه.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"0QHtvoc0"},{"id":"س-06141","fp":"bbd4bd8923bc","stateId":757,"easy":"إذا لم تؤدِّ صدقة إبلك ← تأتي يوم القيامة أوفر ما كانت فتطؤك","cause":"ولا عَبدٍ لا يؤدِّي صدقةَ إبلِهِ","result":"إلَّا أتيَ بِهِ، وبإبلِهِ علَى أوفرَ ما كانت فيبطحُ لَها بِقاعٍ قَرقرٍ فتسيرُ علَيهِ كلَّما مَضَى آخرُها رُدَّ أوَّلُها حتَّى يحكُمَ اللَّهُ بينَ عبادِهِ في يومٍ كانَ مِقدارُهُ ألفَ سنةٍ مِمَّا تَعدُّونَ، ثمَّ يرَى سبيلَهُ إمَّا إلى الجنَّةِ، وإمَّا إلى النَّارِ","explicit":true,"similar":["س-06142"],"ref":"صحيح ابن خزيمة 4/ 14","srcLabel":"مسلم","text":["ما مِن عبدٍ لا يؤدِّي زَكاةَ مالِهِ إلَّا أتيَ بِهِ وبمالِهِ فأُحْميَ عليهِ صَفائحُ في نارِ جَهَنَّمَ، فتُكْوى بِهِ جَنباهُ وجبينُهُ وظَهْرُهُ، حتَّى يَحكُمَ اللَّهُ بينَ عبادِهِ يومًا مقدارُهُ ألفَ سنَةٍ مِمَّا تعدُّونَ، ثمَّ يرى سبيلَهُ، إمَّا إلى الجنَّةِ، وإمَّا إلى النَّارِ ",["ولا عَبدٍ لا يؤدِّي صدقةَ إبلِهِ",1]," ",["إلَّا أتيَ بِهِ، وبإبلِهِ علَى أوفرَ ما كانت فيبطحُ لَها بِقاعٍ قَرقرٍ فتسيرُ علَيهِ كلَّما مَضَى آخرُها رُدَّ أوَّلُها حتَّى يحكُمَ اللَّهُ بينَ عبادِهِ في يومٍ كانَ مِقدارُهُ ألفَ سنةٍ مِمَّا تَعدُّونَ، ثمَّ يرَى سبيلَهُ إمَّا إلى الجنَّةِ، وإمَّا إلى النَّارِ",2]," ولا عَبدٍ لا يؤدِّي صَدقةَ غنمِهِ إلَّا أتيَ بِهِ وبغَنمِهِ على أوفرَ ما كانَت فيبطَحُ لَها بِقاعٍ قرقرٍ فتسيرُ عليهِ كلَّما مضَى عنهُ آخرُها ردَّ أوَّلُها تطأَهُ بأظلافِها، وتنطحُهُ بقرونِها ليسَ فيها عقصاءُ، ولا جلحاءُ حتَّى يحكمَ اللَّهُ بينَ عبادِهِ في يومٍ كانَ مقدارُهُ ألفَ سنةٍ ممَّا تعدُّونَ، ثمَّ يرى سبيلَهُ إمَّا إلى الجنَّةِ وإمَّا إلى النَّارِ قالوا: يا رسولَ اللَّهِ الخيلُ قالَ: الخيلُ معقودٌ في نواصيها الخيرُ إلى يومِ القيامةِ، والخيلُ لثلاثةٍ هيَ لرجلٍ أجرٌ، ولرجلٍ سترٌ، وعلى رجلٍ وزرٌ فذكرَ الحديثَ بطولِهِ قالوا: الحمرُ يا رسولَ اللَّهِ قالَ: ما أنزلَ اللَّهُ عليَّ فيها شيئًا إلَّا هذِهِ الآيةَ الجامعةَ الفاذَّةَ {فَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُ وَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُ} . الجلحاءُ: التي لَيس لها قرنٌ . والعَقصاءُ: المكسورةُ القَرنِ[وفي روايةٍ]: قال في كلِّها: في يومٍ كان مِقدارُهُ خمسينَ ألفَ سنةٍ مِمَّا تعدُّونَ، وقالَ أيضًا: ثمَّ تستنُّ عليهِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (987)، وأحمد (8977)، وأبو عوانة في ((المستخرج)) (3370) بنحوه.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"0QHtvoc0"},{"id":"س-06142","fp":"3486eda42af0","stateId":757,"easy":"إذا لم تؤدِّ صدقة غنمك ← تأتي يوم القيامة أوفر ما كانت فتطؤك وتنطحك","cause":"ولا عَبدٍ لا يؤدِّي صَدقةَ غنمِهِ","result":"إلَّا أتيَ بِهِ وبغَنمِهِ على أوفرَ ما كانَت فيبطَحُ لَها بِقاعٍ قرقرٍ فتسيرُ عليهِ كلَّما مضَى عنهُ آخرُها ردَّ أوَّلُها تطأَهُ بأظلافِها، وتنطحُهُ بقرونِها ليسَ فيها عقصاءُ، ولا جلحاءُ حتَّى يحكمَ اللَّهُ بينَ عبادِهِ في يومٍ كانَ مقدارُهُ ألفَ سنةٍ ممَّا تعدُّونَ، ثمَّ يرى سبيلَهُ إمَّا إلى الجنَّةِ وإمَّا إلى النَّارِ","explicit":true,"repOf":"س-06141","ref":"صحيح ابن خزيمة 4/ 14","text":["ما مِن عبدٍ لا يؤدِّي زَكاةَ مالِهِ إلَّا أتيَ بِهِ وبمالِهِ فأُحْميَ عليهِ صَفائحُ في نارِ جَهَنَّمَ، فتُكْوى بِهِ جَنباهُ وجبينُهُ وظَهْرُهُ، حتَّى يَحكُمَ اللَّهُ بينَ عبادِهِ يومًا مقدارُهُ ألفَ سنَةٍ مِمَّا تعدُّونَ، ثمَّ يرى سبيلَهُ، إمَّا إلى الجنَّةِ، وإمَّا إلى النَّارِ ولا عَبدٍ لا يؤدِّي صدقةَ إبلِهِ إلَّا أتيَ بِهِ، وبإبلِهِ علَى أوفرَ ما كانت فيبطحُ لَها بِقاعٍ قَرقرٍ فتسيرُ علَيهِ كلَّما مَضَى آخرُها رُدَّ أوَّلُها حتَّى يحكُمَ اللَّهُ بينَ عبادِهِ في يومٍ كانَ مِقدارُهُ ألفَ سنةٍ مِمَّا تَعدُّونَ، ثمَّ يرَى سبيلَهُ إمَّا إلى الجنَّةِ، وإمَّا إلى النَّارِ ",["ولا عَبدٍ لا يؤدِّي صَدقةَ غنمِهِ",1]," ",["إلَّا أتيَ بِهِ وبغَنمِهِ على أوفرَ ما كانَت فيبطَحُ لَها بِقاعٍ قرقرٍ فتسيرُ عليهِ كلَّما مضَى عنهُ آخرُها ردَّ أوَّلُها تطأَهُ بأظلافِها، وتنطحُهُ بقرونِها ليسَ فيها عقصاءُ، ولا جلحاءُ حتَّى يحكمَ اللَّهُ بينَ عبادِهِ في يومٍ كانَ مقدارُهُ ألفَ سنةٍ ممَّا تعدُّونَ، ثمَّ يرى سبيلَهُ إمَّا إلى الجنَّةِ وإمَّا إلى النَّارِ",2]," قالوا: يا رسولَ اللَّهِ الخيلُ قالَ: الخيلُ معقودٌ في نواصيها الخيرُ إلى يومِ القيامةِ، والخيلُ لثلاثةٍ هيَ لرجلٍ أجرٌ، ولرجلٍ سترٌ، وعلى رجلٍ وزرٌ فذكرَ الحديثَ بطولِهِ قالوا: الحمرُ يا رسولَ اللَّهِ قالَ: ما أنزلَ اللَّهُ عليَّ فيها شيئًا إلَّا هذِهِ الآيةَ الجامعةَ الفاذَّةَ {فَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُ وَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُ} . الجلحاءُ: التي لَيس لها قرنٌ . والعَقصاءُ: المكسورةُ القَرنِ[وفي روايةٍ]: قال في كلِّها: في يومٍ كان مِقدارُهُ خمسينَ ألفَ سنةٍ مِمَّا تعدُّونَ، وقالَ أيضًا: ثمَّ تستنُّ عليهِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (987)، وأحمد (8977)، وأبو عوانة في ((المستخرج)) (3370) بنحوه.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"0QHtvoc0"},{"id":"س-07443","fp":"7474de4cae40","stateId":757,"easy":"إذا كان لك مال لا تؤدي زكاته ← تُحمى عليك صفائح في جهنم","cause":"ما مِن عبدٍ لَهِ مالٌ لا يؤدِّي زَكاتَهُ","result":"إلَّا جُمِعَ يومَ القيامةِ تُحمَى عليهِ صفائحُ في جَهَنَّمَ، وَكويَ بِها جنبُهُ، وظَهْرُهُ حتَّى يقضيَ اللَّهُ بينَ عبادِهِ في يومٍ كانَ مِقدارُهُ خمسينَ ألفَ سنةٍ مِمَّا تعدُّونَ، ثمَّ يَرى سبيلَهُ، إمَّا إلى الجنَّةِ، وإمَّا إلى النَّارِ","explicit":true,"ref":"صحيح ابن خزيمة 4/ 51","srcLabel":"مسلم","text":[["ما مِن عبدٍ لَهِ مالٌ لا يؤدِّي زَكاتَهُ",1]," ",["إلَّا جُمِعَ يومَ القيامةِ تُحمَى عليهِ صفائحُ في جَهَنَّمَ، وَكويَ بِها جنبُهُ، وظَهْرُهُ حتَّى يقضيَ اللَّهُ بينَ عبادِهِ في يومٍ كانَ مِقدارُهُ خمسينَ ألفَ سنةٍ مِمَّا تعدُّونَ، ثمَّ يَرى سبيلَهُ، إمَّا إلى الجنَّةِ، وإمَّا إلى النَّارِ",2],"، وذَكَرَ الحديثَ بطولِهِ في قصَّةِ الإبلِ والغنمِ . قالَ: قيلَ: يا رسولَ اللَّهِ: والخيلُ قالَ: الخيلُ معقودٌ في نواصيها الخيرُ إلى يومِ القيامةِ، والخيلُ لثلاثةٍ: هيَ لرجلٍ أجرٌ، ولرجلٍ سِترٌ، وعلى رجلٍ وزرٌ، فأمَّا الَّذي هيَ لَهُ أجرٌ، فالَّذي يتَّخذُها في سبيلِ اللَّهِ، ويعدُّها لَهُ لا يغيبُ في بطونِها شيئًا إلَّا كتبَ لَهُ بِها أجرٌ، ولو عَرضَ مرجًا أو مرجينِ فرعاها صاحبُها فيهِ كتبَ لَهُ مِمَّا غيَّبت في بطونِها أجرٌ، ولوِ استنَّت شَرفًا أو شرفينِ، كُتِبَ لَهُ بِكُلِّ خطوةٍ خطاها أجرٌ، ولو عرضَ نَهَرٌ فسقاها بِهِ، كانت لَهُ بِكُلِّ قطرةٍ غُيِّبَت في بطونِها منهُ أجرٌ، حتَّى ذَكَرَ الأجرَ في أرواثِها وأبوالِها، وأمَّا الَّتي هيَ لَهُ سترٌ فالَّذي يتَّخذُها تعفُّفًا وتجمُّلًا وتستُّرًا، ولا يحبِسُ حقَّ ظُهورِها وبطونِها في يُسْرِها وعُسْرِها، وأمَّا الَّذي عليهِ وزرٌ فالَّذي يتَّخذُها أشَرًا وبطرًا وبَذخًا عليهِم قالوا: فالحُمرُ يا رسولَ اللَّهِ؟ قالَ: ما أنزَلَ اللَّهُ عليَّ فيها شيئًا إلَّا هذِهِ الآيةَ الجامِعةَ الفاذَّةَ: {فَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُ، وَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُ} [الزَّلزلةُ: 8]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (987)، وأحمد (8977)، وأبو عوانة في ((المستخرج)) (3370) بنحوه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"DFO0OKiF"},{"id":"س-07468","fp":"0f0c7afdc098","stateId":757,"easy":"إذا لم تؤدِّ زكاة مالك ← يُجعل يوم القيامة صفائح من نار يُكوى بها جنبك","cause":"ما مِن رَجُلٍ لا يُؤَدِّي زَكاةَ مالِه","result":"إلَّا جُعِلَ يَومَ القِيامَةِ صَفائِحَ مِن نارٍ، يُكوى بِها جَنبُه وجَبهَتُه وظَهرُه، في يَومٍ كان مِقدارُه خَمسينَ أَلْفَ سَنَةٍ، حتى يُقضَى بَينَ النَّاسِ، ثم يُرى سَبيلَه","explicit":true,"repOf":"س-06140","ref":"تخريج المسند لشعيب 7720","text":[["ما مِن رَجُلٍ لا يُؤَدِّي زَكاةَ مالِه",1]," ",["إلَّا جُعِلَ يَومَ القِيامَةِ صَفائِحَ مِن نارٍ، يُكوى بِها جَنبُه وجَبهَتُه وظَهرُه، في يَومٍ كان مِقدارُه خَمسينَ أَلْفَ سَنَةٍ، حتى يُقضَى بَينَ النَّاسِ، ثم يُرى سَبيلَه",2],"، وإنْ كانت إبِلًا إلَّا بُطِحَ لَها بِقاعٍ قَرقَرٍ في يَومٍ كان مِقدارُه خَمسين أَلْفَ سَنَةٍ، تَطَؤُه بأَخفافِها -حسِبْتُه قال: وتَعَضُّه بأَفواهِها- يَرِدُ أَوَّلُها عن آخِرِها، حتى يُقضى بيْنَ النَّاسِ، ثم يُرى سَبيلَه، وإنْ كانت غَنَمًا فكمِثْلِ ذلك، إلَّا أنَّها تَنطَحُه بِقُرونِها، وتَطَؤُه بأَظْلافِها."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (987)، وأبو داود (1658)، وأحمد (7720) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"sEBp3H2I"},{"id":"س-05193","fp":"e89872f771fe","stateId":757,"easy":"إذا كنت صاحب كنز لا تؤدي حقه ← يأتي كنزك يوم القيامة شجاعاً أقرع يتبعك","cause":"ولا صاحِبِ كَنزٍ لا يَفعَلُ فيه حَقَّه","result":"إلَّا جاءَ كَنزُه يَومَ القيامةِ شُجاعًا أقرَعَ، يَتبَعُه فاتِحًا فاه، فإذا أتاه فرَّ منه، فيُناديه: خُذْ كَنزَك الذي خَبَأتَه، فأنا عنه غَنيٌّ، فإذا رَأى أن لا بُدَّ منه سَلَك يَدَه في فيه، فيَقضَمُها قَضمَ الفَحلِ","explicit":true,"ref":"صحيح مسلم 988","srcLabel":"النسائي","text":["ما مِن صاحِبِ إبِلٍ لا يَفعَلُ فيها حَقَّها، إلَّا جاءَت يَومَ القيامةِ أكثَرَ ما كانَت قَطُّ، وقَعَدَ لها بقاعٍ قَرقَرٍ تَستَنُّ عليه بقَوائِمِها وأخفافِها، ولا صاحِبِ بَقَرٍ لا يَفعَلُ فيها حَقَّها، إلَّا جاءَت يَومَ القيامةِ أكثَرَ ما كانَت، وقَعَدَ لها بقاعٍ قَرقَرٍ تَنطَحُه بقُرونِها، وتَطَؤُه بقَوائِمِها، ولا صاحِبِ غَنَمٍ لا يَفعَلُ فيها حَقَّها، إلَّا جاءَت يَومَ القيامةِ أكثَرَ ما كانَت، وقَعَدَ لها بقاعٍ قَرقَرٍ تَنطَحُه بقُرونِها وتَطَؤُه بأظلافِها، ليس فيها جَمَّاءُ ولا مُنكَسِرٌ قَرنُها، ",["ولا صاحِبِ كَنزٍ لا يَفعَلُ فيه حَقَّه",1],"، ",["إلَّا جاءَ كَنزُه يَومَ القيامةِ شُجاعًا أقرَعَ، يَتبَعُه فاتِحًا فاه، فإذا أتاه فرَّ منه، فيُناديه: خُذْ كَنزَك الذي خَبَأتَه، فأنا عنه غَنيٌّ، فإذا رَأى أن لا بُدَّ منه سَلَك يَدَه في فيه، فيَقضَمُها قَضمَ الفَحلِ",2],". قال أبو الزُّبَيرِ: سَمِعتُ عُبَيدَ بنَ عُمَيرٍ يقولُ هذا القَولَ، ثُمَّ سَألنا جابِرَ بنَ عبدِ اللهِ عن ذلك فقال مِثلَ قَولِ عُبَيدِ بنِ عُمَيرٍ. وقال أبو الزُّبَيرِ: سَمِعتُ عُبَيدَ بنَ عُمَيرٍ يقولُ: قال رَجُلٌ: يا رَسولَ اللهِ، ما حَقُّ الإبِلِ؟ قال: حَلَبُها على الماءِ، وإعارةُ دَلوِها، وإعارةُ فحلِها، ومَنيحَتُها، وحَملٌ عليها في سَبيلِ اللهِ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه النسائي (2454) بلفظه، وأحمد (14442)، والدارمي (1658) كلاهما باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"GdeF1WiP","merged":7,"otherRefs":["صحيح البخاري 6957 (صحيح)","صحيح ابن خزيمة 4/ 18 (صحيح)","صحيح ابن خزيمة 4/ 16 (صحيح)","صحيح مسلم 988 (صحيح)","صحيح الجامع 2902 (صحيح)","تخريج المسند لشعيب 6448 (صحيح)"]},{"id":"ق-0495","fp":"f8e1ab50b28f","stateId":757,"easy":"كنز الذهب والفضة وترك الإنفاق في سبيل الله ← عذاب أليم (الكيّ بها)","cause":"كنز الذهب والفضة وترك الإنفاق في سبيل الله","result":"عذاب أليم (الكيّ بها)","explicit":true,"ref":"سورة التوبة: 34–35","srcLabel":"القرآن الكريم","quran":{"s":9,"from":34,"to":35,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنَّ كَثِيرًا مِنَ الْأَحْبَارِ وَالرُّهْبَانِ لَيَأْكُلُونَ أَمْوَالَ النَّاسِ بِالْبَاطِلِ وَيَصُدُّونَ عَنْ سَبِيلِ اللَّهِ وَالَّذِينَ يَكْنِزُونَ الذَّهَبَ وَالْفِضَّةَ وَلَا يُنْفِقُونَهَا فِي سَبِيلِ اللَّهِ فَبَشِّرْهُمْ بِعَذَابٍ أَلِيمٍ (34) يَوْمَ يُحْمَى عَلَيْهَا فِي نَارِ جَهَنَّمَ فَتُكْوَى بِهَا جِبَاهُهُمْ وَجُنُوبُهُمْ وَظُهُورُهُمْ هَذَا مَا كَنَزْتُمْ لِأَنْفُسِكُمْ فَذُوقُوا مَا كُنْتُمْ تَكْنِزُونَ (35)","hl":[[159,455,1]]}},{"id":"ق-1127","fp":"a53fe51ce9b2","stateId":757,"easy":"الشرك ومنع الزكاة والكفر بالآخرة ← الويل","cause":"الشرك ومنع الزكاة والكفر بالآخرة","result":"الويل","explicit":true,"ref":"سورة فصلت: 6–7","srcLabel":"القرآن الكريم","quran":{"s":41,"from":6,"to":7,"text":"قُلْ إِنَّمَا أَنَا بَشَرٌ مِثْلُكُمْ يُوحَى إِلَيَّ أَنَّمَا إِلَهُكُمْ إِلَهٌ وَاحِدٌ فَاسْتَقِيمُوا إِلَيْهِ وَاسْتَغْفِرُوهُ وَوَيْلٌ لِلْمُشْرِكِينَ (6) الَّذِينَ لَا يُؤْتُونَ الزَّكَاةَ وَهُمْ بِالْآخِرَةِ هُمْ كَافِرُونَ (7)","hl":[[129,228,1]]}},{"id":"س-06136","fp":"abe54fec6908","stateId":757,"easy":"إذا كانت لك إبل لا تعطي حقها ← تأتي يوم القيامة كأغذّ ما كانت فتطؤك","cause":"مَن كانت له إبِلٌ لا يُعطي حَقَّها في نَجدَتِها، ورِسلِها","result":"فإنَّها تَأتي يَومَ القيامةِ كأغَذِّ ما كانت، وأكبَرِهِ، وأسمَنِهِ، وآشَرِهِ، ثم يُبطَحُ لها بقاعٍ قَرقَرٍ، فتَطَؤهُ بأخفافِها، إذا جاوَزَتْهُ أُخراها؛ أُعيدَتْ عليه أُولاها، في يَومٍ كان مِقدارُهُ خَمسينَ ألْفَ سَنةٍ، حتى يُقضى بَينَ النَّاسِ فيَرى سَبيلَهُ","explicit":true,"ref":"تخريج المسند لشعيب 10350","srcLabel":"أبو داود","text":["فمَرَّ رَجُلٌ مِن بني عامِرِ بنِ صَعصَعةَ، فقيل له: هذا أكثَرُ عامِريٍّ نادى مالًا. فقال أبو هُرَيرةَ: رُدُّوهُ إليَّ. فرَدُّوهُ عليه، فقال: نُبِّئتُ أنَّكَ ذو مالٍ كثيرٍ. فقال العامِريُّ: إيْ واللهِ؛ إنَّ لي لمِئةً حُمْرًا، ومِئةً أدماءَ، حتى عَدَّ مِن ألوانِ الإبِلِ، وأفنانِ الرَّقيقِ، ورباطِ الخَيلِ، فقال أبو هُرَيرةَ: إيَّاكَ، وأخفافَ الإبِلِ، وأظلافَ الغَنَمِ، يُرَدِّدُ ذلك عليه، حتى جعَلَ لَونُ العامِريِّ يتغَيَّرُ، أو يتلَوَّنُ، فقال: ما ذاك يا أبا هُرَيرةَ؟ قال: سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["مَن كانت له إبِلٌ لا يُعطي حَقَّها في نَجدَتِها، ورِسلِها",1],". قُلنا: يا رسولَ اللهِ، ما نَجدَتُها ورِسلُها؟ قال: في عُسرِها ويُسرِها؛ ",["فإنَّها تَأتي يَومَ القيامةِ كأغَذِّ ما كانت، وأكبَرِهِ، وأسمَنِهِ، وآشَرِهِ، ثم يُبطَحُ لها بقاعٍ قَرقَرٍ، فتَطَؤهُ بأخفافِها، إذا جاوَزَتْهُ أُخراها؛ أُعيدَتْ عليه أُولاها، في يَومٍ كان مِقدارُهُ خَمسينَ ألْفَ سَنةٍ، حتى يُقضى بَينَ النَّاسِ فيَرى سَبيلَهُ",2],"، وإذا كانت له بَقَرٌ لا يُعطي حَقَّها في نَجدَتِها، ورِسلِها؛ فإنَّها تَأتي يَومَ القيامةِ كأغَذِّ ما كانت، وأكبَرِهِ، وأسمَنِهِ، وآشَرِهِ، ثم يُبطَحُ لها بقاعٍ قَرقَرٍ، فتَطَؤهُ كُلُّ ذاتِ ظِلفٍ بظِلفِها، وتَنطَحُهُ كُلُّ ذاتِ قَرنٍ بقَرنِها، إذا جاوَزَتْهُ أُخراها أُعيدَتْ عليه أُولاها، في يَومٍ كان مِقدارُهُ خَمسينَ ألْفَ سَنةٍ، حتى يُقضى بَينَ النَّاسِ، حتى يَرى  سَبيلَهُ، وإذا كانت له غَنَمٌ لا يُعطي حَقَّها في نَجدَتِها ورِسلِها؛ فإنَّها تَأتي يَومَ القِيامةِ كأغَذِّ ما كانتْ، وأكبَرِهِ، وأسمَنِهِ، وآشَرِهِ، ثم يُبطَحُ لها بقاعٍ قَرقَرٍ، فتَطَؤهُ كُلُّ ذاتِ ظِلفٍ بظِلفِها، وتَنطَحُهُ كُلُّ ذاتِ قَرنٍ بقَرنِها -يَعني ليس فيها عَقصاءُ، ولا عَضباءُ- إذا جاوَزَتْهُ أُخراها أُعيدَتْ أُولاها، في يَومٍ كان مِقدارُهُ خَمسينَ ألْفَ سَنةٍ، حتى يُقضى بَينَ النَّاسِ، فيَرى سَبيلَهُ. فقال العامِريُّ: وما حَقُّ الإبِلِ يا أبا هُرَيرةَ؟ قال: أنْ تُعطيَ الكريمةَ، وتَمنَحَ الغَزيرةَ، وتُفقِرَ الظَّهرَ، وتَسقيَ اللَّبَنَ، وتُطرِقَ الفَحلَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1660)، والنسائي (2442)، وأحمد (10350) واللفظ له","bab":"زكاة › عقوبة مانع الزكاة","dorar":"CwOwzfnG","merged":4,"otherRefs":["مجمع الزوائد 3/67 (حسن)","المستدرك على الصحيحين 1484 (صحيح)","صحيح ابن خزيمة 4/ 73 (صحيح)"]},{"id":"س-06158","fp":"2de60697a10f","stateId":757,"easy":"إذا لم تؤدِّ زكاة مالك ← فهو كنز تُعذّب به","cause":"كلَّ مالٍ لا تُؤدَّى زكاتُه","result":"فهو كنزٌ يُعذَّبُ به صاحبُه","explicit":true,"ref":"مجموع فتاوى ابن باز 31/14","srcLabel":"مجموع فتاوى ابن باز","text":["[حديثُ أن ",["كلَّ مالٍ لا تُؤدَّى زكاتُه",1]," ",["فهو كنزٌ يُعذَّبُ به صاحبُه",2],"]"],"grade":"صحيح","muhaddith":"صحيح","bab":"زكاة › عقوبة مانع الزكاة","dorar":"xUZRZIn0","merged":2,"otherRefs":["تخريج شرح السنة 5/477 (حسن)"]},{"id":"س-02964","fp":"c13a66a09a79","stateId":757,"easy":"إذا كنزت المال (تركت دينارين ممن يسأل الناس) ← فهما كيّتان","cause":"فتَرَكَ دينارَينِ","result":"كَيَّتانِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 22172","srcLabel":"أحمد","text":["سَمِعتُ أبا الجَعدِ يُحدِّثُ -قال هاشمٌ في حديثِه: أبو الجَعدِ مَولًى لبَني ضُبَيعةَ- عن أبي أُمامةَ، أنَّ رَجُلًا مِن أهلِ الصُّفَّةِ تُوُفِّيَ وتَرَكَ دينارًا، فقال رسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ له: كَيَّةٌ، قال: ثُمَّ تُوُفِّيَ آخَرُ ",["فتَرَكَ دينارَينِ",1],"، فقال رسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ: ",["كَيَّتانِ",2],"."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه أحمد (22172) واللفظ له، وابن أبي شيبة (12147)، والطبراني (8/311) (8011)","bab":"إيمان › الوعيد","dorar":"NqLm6JMN","merged":12,"otherRefs":["صحيح الترغيب 935 (صحيح)","تخريج المسند لشعيب 3843 (حسن)","تخريج المسند لشاكر 6/40 (صحيح)","السلسلة الصحيحة 2637 (حسن)","مجمع الزوائد 10/243 (صحيح)","تخريج المسند لشعيب 16/253 (صحيح)","صحيح الترغيب 801 (صحيح)","صحيح الموارد 2102 (صحيح)","الصحيح المسند 876 (حسن)","تخريج المسند لشعيب 9538 (صحيح)","الترغيب والترهيب 2/86 (حسن)"]},{"id":"س-03889","fp":"72ca36456961","stateId":757,"easy":"إذا منعت الزكاة ← يُجعل مالك صفائح يُكوى بها","cause":"وأنَّ مانعَ الزكاةِ","result":"يُجعلُ له مالُه صفائحَ يُكوى به","explicit":true,"ref":"فتح الباري لابن رجب 3/436","srcLabel":"فتح الباري لابن رجب","text":[["وأنَّ مانعَ الزكاةِ",1]," ",["يُجعلُ له مالُه صفائحَ يُكوى به",2]," ."],"grade":"صحيح","muhaddith":"صحيح.","bab":"تفسير آيات › سورة التوبة","dorar":"s2Zfx2ls"},{"id":"س-03897","fp":"89eb909e1535","stateId":757,"easy":"إذا كان لك ذهب لا تؤدي ما فيه ← يُجعل لك يوم القيامة صفائح من نار يُكوى بها","cause":"ما من صاحبِ ذَهبٍ لا يؤدِّي ما فيها","result":"إلَّا جعلَ لَهُ يومَ القيامةِ صفائحُ من نارٍ يُكوى بِها","explicit":true,"repOf":"س-07742","ref":"المحلى 6/80","text":[["ما من صاحبِ ذَهبٍ لا يؤدِّي ما فيها",1]," ",["إلَّا جعلَ لَهُ يومَ القيامةِ صفائحُ من نارٍ يُكوى بِها",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"تفسير آيات › سورة التوبة","dorar":"xs3uGIVd"},{"id":"س-04871","fp":"ff2992a6b0eb","stateId":757,"easy":"إذا منعت الزكاة ← تُعذب يوم القيامة بالمال الذي بخلت بزكاته","cause":"مانعُ الزكاةِ","result":"يعذبُ يومَ القيامةِ بالمالِ الذي بخلِ بزكاتِه","explicit":true,"ref":"فتاوى نور على الدرب لابن باز 4/114","srcLabel":"فتاوى نور على الدرب لابن باز","text":[["مانعُ الزكاةِ",1]," ",["يعذبُ يومَ القيامةِ بالمالِ الذي بخلِ بزكاتِه",2],"."],"grade":"صحيح","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"vOoaB8Mi"},{"id":"س-05161","fp":"cde360743cb8","stateId":757,"easy":"إذا كان لك مال لا تؤدي حقه ← يُجعل طوقاً في عنقك شجاعاً أقرع","cause":"ما مِن رجُلٍ لَهُ مالٌ ، لا يؤدِّي حقَّ مالِهِ","result":"إلَّا جعلَ لَهُ طوقًا في عنقِهِ ، شُجاعٌ أقرَعُ ، وَهوَ يفِرُّ منْهُ ، وَهوَ يتبعُه","explicit":true,"repOf":"س-03021","ref":"صحيح النسائي 2440","text":[["ما مِن رجُلٍ لَهُ مالٌ ، لا يؤدِّي حقَّ مالِهِ ،",1]," ",["إلَّا جعلَ لَهُ طوقًا في عنقِهِ ، شُجاعٌ أقرَعُ ، وَهوَ يفِرُّ منْهُ ، وَهوَ يتبعُه ",2],". ثمَّ قرأَ مِصداقَهُ من كتابِ اللَّهِ عزَّ وجلَّ وَلَا تَحْسِبَنَّ الَّذِينَ يَبْخَلُونَ بِمَا آتَاهُمُ اللَّهُ مِنْ فَضْلِهِ هُوَ خَيْرًا لَهُمْ بَلْ هُوَ شَرٌّ لَهُمْ سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ  الآيةَ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3012) بنحوه مطولاً، والنسائي (2441) واللفظ له، وابن ماجه (1784) بنحوه، وأحمد (3577) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"EMSGK2NO"},{"id":"س-05192","fp":"f3f40dc8c3a4","stateId":757,"easy":"إذا كنت صاحب إبل لا تؤدي حقها ← تأتي يوم القيامة أكثر ما كانت فتطؤك","cause":"ما مِن صاحِبِ إبِلٍ لا يَفعَلُ فيها حَقَّها","result":"إلَّا جاءَت يَومَ القيامةِ أكثَرَ ما كانَت قَطُّ، وقَعَدَ لها بقاعٍ قَرقَرٍ تَستَنُّ عليه بقَوائِمِها وأخفافِها","explicit":true,"repOf":"س-06282","ref":"صحيح مسلم 988","text":[["ما مِن صاحِبِ إبِلٍ لا يَفعَلُ فيها حَقَّها",1],"، ",["إلَّا جاءَت يَومَ القيامةِ أكثَرَ ما كانَت قَطُّ، وقَعَدَ لها بقاعٍ قَرقَرٍ تَستَنُّ عليه بقَوائِمِها وأخفافِها",2],"، ولا صاحِبِ بَقَرٍ لا يَفعَلُ فيها حَقَّها، إلَّا جاءَت يَومَ القيامةِ أكثَرَ ما كانَت، وقَعَدَ لها بقاعٍ قَرقَرٍ تَنطَحُه بقُرونِها، وتَطَؤُه بقَوائِمِها، ولا صاحِبِ غَنَمٍ لا يَفعَلُ فيها حَقَّها، إلَّا جاءَت يَومَ القيامةِ أكثَرَ ما كانَت، وقَعَدَ لها بقاعٍ قَرقَرٍ تَنطَحُه بقُرونِها وتَطَؤُه بأظلافِها، ليس فيها جَمَّاءُ ولا مُنكَسِرٌ قَرنُها، ولا صاحِبِ كَنزٍ لا يَفعَلُ فيه حَقَّه، إلَّا جاءَ كَنزُه يَومَ القيامةِ شُجاعًا أقرَعَ، يَتبَعُه فاتِحًا فاه، فإذا أتاه فرَّ منه، فيُناديه: خُذْ كَنزَك الذي خَبَأتَه، فأنا عنه غَنيٌّ، فإذا رَأى أن لا بُدَّ منه سَلَك يَدَه في فيه، فيَقضَمُها قَضمَ الفَحلِ. قال أبو الزُّبَيرِ: سَمِعتُ عُبَيدَ بنَ عُمَيرٍ يقولُ هذا القَولَ، ثُمَّ سَألنا جابِرَ بنَ عبدِ اللهِ عن ذلك فقال مِثلَ قَولِ عُبَيدِ بنِ عُمَيرٍ. وقال أبو الزُّبَيرِ: سَمِعتُ عُبَيدَ بنَ عُمَيرٍ يقولُ: قال رَجُلٌ: يا رَسولَ اللهِ، ما حَقُّ الإبِلِ؟ قال: حَلَبُها على الماءِ، وإعارةُ دَلوِها، وإعارةُ فحلِها، ومَنيحَتُها، وحَملٌ عليها في سَبيلِ اللهِ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه النسائي (2454) بلفظه، وأحمد (14442)، والدارمي (1658) كلاهما باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"GdeF1WiP"},{"id":"س-06147","fp":"d4409b1d9582","stateId":757,"easy":"إذا رفعت الدنانير والدراهم لا تعدها لغريم ولا تنفقها في سبيل الله ← فهي كنز تُكوى به","cause":"ومَن رَفَع دَنانيرَ ودَراهِمَ أو تِبرًا أو فِضَّةً لا يَعُدُّها لغَريمٍ","result":"ولا يُنفِقُها في سَبيلِ اللهِ فهو كَنزٌ يُكوَى به يَومَ القِيامةِ","explicit":true,"ref":"المستدرك على الصحيحين 1449","srcLabel":"أحمد","text":["في الإِبِلِ صَدَقَتُها، وفي الغَنَمِ صَدَقَتُها، وفي البَقَرِ صَدَقَتُها، وفي البُرِّ صَدَقَتُه، ",["ومَن رَفَع دَنانيرَ ودَراهِمَ أو تِبرًا أو فِضَّةً لا يَعُدُّها لغَريمٍ، ",1],["ولا يُنفِقُها في سَبيلِ اللهِ فهو كَنزٌ يُكوَى به يَومَ القِيامةِ",2],"."],"grade":"صحيح","narrator":"أبو ذر","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (21557)، وابن أبي شيبة (10700)، والدارقطني (1933) واللفظ لهم.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"a0V37BJc"},{"id":"س-06148","fp":"7e593a58e48f","stateId":757,"easy":"إذا لم تؤدِّ زكاة مالك ← يجعل الله في عنقك يوم القيامة شجاعاً","cause":"ما مِن رجُلٍ لَا يؤدِّي زَكاةَ مالِهِ","result":"إلَّا جعلَ اللَّهُ يومَ القيامةِ في عُنقِهِ شجاعًا ، ثمَّ قرأَ علَينا مصداقَهُ من كتابِ اللَّهِ : (وَلَا يَحْسَبَنَّ الَّذِينَ يَبْخَلُونَ بِمَا آتَاهُمُ اللَّهُ مِنْ فَضْلِهِ) الآيةَ","explicit":true,"repOf":"س-03021","ref":"صحيح الترمذي 3012","text":[["ما مِن رجُلٍ لَا يؤدِّي زَكاةَ مالِهِ",1]," ",["إلَّا جعلَ اللَّهُ يومَ القيامةِ في عُنقِهِ شجاعًا ، ثمَّ قرأَ علَينا مصداقَهُ من كتابِ اللَّهِ : (وَلَا يَحْسَبَنَّ الَّذِينَ يَبْخَلُونَ بِمَا آتَاهُمُ اللَّهُ مِنْ فَضْلِهِ) الآيةَ ",2],"، وقالَ مرَّةً : قرأَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ مِصداقَهُ : ( سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ) ومن اقتطعَ مالَ أخيهِ المسلمِ بيَمينٍ لقيَ اللَّهَ وَهوَ علَيهِ غضبانُ ، ثمَّ قَرأَ رسولُ اللَّهِ مِصداقَهُ من كتابِ اللَّهِ : (إِنَّ الَّذِينَ يَشْتَرُونَ بعَهْدِ اللَّهِ)"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3012) واللفظ له، والنسائي (2441)، وأحمد (3577) بنحوه، وابن ماجه (1784) مختصراً","bab":"زكاة › عقوبة مانع الزكاة","dorar":"cew4VdCg"},{"id":"س-06150","fp":"94f548e0fffa","stateId":757,"easy":"إذا لم تؤدِّ زكاة حليك ← يسوّرك الله بسوارين من نار","cause":"أَتُعطِين زكاةَ هذا ؟ قالت : لا","result":"أَيَسُرُّكِ أن يُسَوِّرَكِ اللهُ بهما يومَ القيامةِ بسِوَارَينِ من نارٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-04968"],"ref":"البدر المنير 5/565","srcLabel":"أبو داود","text":["أنَّ امرأةً أتتْ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ومعَها ابنةٌ لها ، وفي يدِ ابنَتِها مَسَكَتانِ غَليظتانِ من ذَهَبٍ ، فقال لها : ",["أَتُعطِين زكاةَ هذا ؟ قالت : لا",1]," ، قال : ",["أَيَسُرُّكِ أن يُسَوِّرَكِ اللهُ بهما يومَ القيامةِ بسِوَارَينِ من نارٍ",2]," ؟ قال : فخلَعَتْهُما فَأَلْقَتْهُما إلى رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ وقالت : هُما للهِ ولرسولِه"],"grade":"صحيح","narrator":"[جد عمرو بن شعيب]","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1563) بلفظه، والنسائي (2479) باختلاف يسير، والترمذي (637) بلفظ مقارب.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"jkNgriu0","merged":9,"otherRefs":["إرواء الغليل 3/296 (حسن)","صحيح الترغيب 770 (صحيح)","تخريج المسند لشاكر 11/124 (صحيح)","عمدة القاري 9/49 (صحيح)","فتاوى نور على الدرب لابن باز 15/150 (صحيح)","البدر المنير 5/564 (صحيح)","مجموع فتاوى ابن عثيمين 547/18 (حسن)","مجموع فتاوى ابن باز 125/4 (صحيح)"]},{"id":"س-06157","fp":"a02a237f502c","stateId":757,"easy":"إذا لم تؤدِّ زكاة كنزك ← تُعذّب به يوم القيامة في يوم مقداره خمسون ألف سنة","cause":"الذين لا يُؤدُّون زكاتَها","result":"يُعذَّبون بها يومَ القيامةِ في يومٍ كان مِقدارُه خمسينَ ألفَ سنةٍ","explicit":true,"repOf":"س-03021","ref":"مجموع فتاوى ابن باز 12/9","text":["[أحاديثُ أن أهلَ الأموالِ ",["الذين لا يُؤدُّون زكاتَها",1]," ",["يُعذَّبون بها يومَ القيامةِ في يومٍ كان مِقدارُه خمسينَ ألفَ سنةٍ",2],"]"],"grade":"صحيح","muhaddith":"صحيحة","bab":"زكاة › عقوبة مانع الزكاة","dorar":"lYjsUo8P"},{"id":"س-07438","fp":"76ce67a4106e","stateId":757,"easy":"إذا لم تؤدِّ زكاتك ← يُجعل لك يوم القيامة شجاع يُطوّق في عنقك","cause":"ما مِن رجلٍ لا يؤدِّي زَكاتَهُ","result":"إلَّا جُعِلَ لَهُ يومَ القيامةِ شجاعٌ طوِّقَ في عنقِهِ يومَ القيامةِ","explicit":true,"repOf":"س-03021","ref":"صحيح ابن خزيمة 4/ 17","text":[["ما مِن رجلٍ لا يؤدِّي زَكاتَهُ",1],"، ",["إلَّا جُعِلَ لَهُ يومَ القيامةِ شجاعٌ طوِّقَ في عنقِهِ يومَ القيامةِ",2]," ثمَّ قرأَ علَينا النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ مصداقَهُ مِن كتابِ اللَّهِ {سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ} [آل عمران: 180]"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البيهقي (7304) بلفظه، والنسائي (2441)، وأحمد (3577) بنحوه","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"YH9fAVPr"},{"id":"س-07459","fp":"df34e625130c","stateId":757,"easy":"إذا منعت زكاة مالك ← يُجعل لك شجاع أقرع يتبعك يقول: أنا كنزك","cause":"لا يمنعُ عبدٌ زكاةَ مالِهِ","result":"إلا جُعِلَ له شجاعٌ أقرعُ يتْبَعُهُ يفرُّ منهُ وهو يَتْبَعُهُ فيقولُ : أنا كنزُكَ ، ثم قرأَ عبدُ اللهِ مصداقَه في كتابِ اللهِ","explicit":true,"ref":"تخريج المسند لشاكر 5/200","srcLabel":"الترمذي","text":[["لا يمنعُ عبدٌ زكاةَ مالِهِ",1]," ",["إلا جُعِلَ له شجاعٌ أقرعُ يتْبَعُهُ يفرُّ منهُ وهو يَتْبَعُهُ فيقولُ : أنا كنزُكَ ، ثم قرأَ عبدُ اللهِ مصداقَه في كتابِ اللهِ ",2],"{ سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ } قالَ سفيانُ مرةً : يُطَوِّقُهُ في عنقِه"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (3577)، واللفظ له، والترمذي (3012)، وابن ماجه (1784)، باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"H5mmEuGt"},{"id":"س-07473","fp":"f4795b963b3f","stateId":757,"easy":"إذا لم تؤدِّ زكاة مالك ← يُجعل يوم القيامة شجاعاً أقرع يتبعك","cause":"ما من رَجلٍ لا يُؤدِّي زكاةَ مالِه","result":"إلَّا جُعِلَ له يومَ القيامةِ شُجاعًا أقرَعَ، يَفِرُّ منه، ويَتبَعُه، حتى يُطوَّقَ به عُنُقُه، ثُم قرَأَ علينا النَّبيُّ صلَّى اللهُ عليه وسلَّمَ","explicit":true,"repOf":"س-03021","ref":"تخريج مشكل الآثار 6147","text":[["ما من رَجلٍ لا يُؤدِّي زكاةَ مالِه",1]," ",["إلَّا جُعِلَ له يومَ القيامةِ شُجاعًا أقرَعَ، يَفِرُّ منه، ويَتبَعُه، حتى يُطوَّقَ به عُنُقُه، ثُم قرَأَ علينا النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",2],"{سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ} [آل عمران: 180]."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (6147) بلفظه، والنسائي (2441)، وابن ماجه (1784) كلاهما باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"AfODdjMg"},{"id":"س-04968","fp":"ee92fb42ec10","stateId":757,"easy":"إذا لم تؤدِّ زكاة حليك ← فهي حسبك من النار","cause":"أَتُؤَدِّين زَكاتَهُنَّ؟ فقُلتُ: لا","result":"هي حَسبُكِ منَ النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-06150","ref":"المستدرك على الصحيحين 1455","text":["عنْ عَبدِ اللهِ بنِ شَدَّادِ بنِ الهادِ، قالَ: دَخَلْنا على عائشةَ زَوجِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فقالتْ: دَخَل عَلَيَّ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فرأى في يَدِي سِخابًا من وَرِقٍ، فقالَ: ما هذا يا عائشةُ؟ فقلت: صَنعتُهُنَّ أتزَيَّنُ لكَ فيهِنَّ يا رَسولَ اللهِ، فقالَ: ",["أَتُؤَدِّين زَكاتَهُنَّ؟ فقُلتُ: لا",1],"، أو ما شاءَ اللهُ من ذلكَ. قالَ: ",["هي حَسبُكِ منَ النَّارِ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه البيهقي في ((السنن الصغير)) (1202) بلفظه، وأبو داود (1565)، والدارقطني (1951) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"vIPBs2LU","merged":2,"otherRefs":["الزواجر عن اقتراف الكبائر 1/171 (صحيح)"]},{"id":"س-05648","fp":"e513d44ecc59","stateId":757,"easy":"إذا لبستِ الذهب (بلا زكاة) ← يُخاف عليك اللهب (أثر أبي هريرة)","cause":"تَلْبَسي الذَّهَبَ","result":"فإنِّي أخافُ عليكِ اللَّهَبَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج شرح السنة 12/71","srcLabel":"البيهقي","text":["أنَّ أبا هُريرةَ كانَ يقولُ لابنتِهِ: لا ",["تَلْبَسي الذَّهَبَ",1],"؛ ",["فإنِّي أخافُ عليكِ اللَّهَبَ",2],"."],"grade":"صحيح","narrator":"محمد بن سيرين","muhaddith":"إسناده صحيح","takhrij":"أخرجه عبد الرزاق (19938)، والبيهقي في ((شعب الإيمان)) (5781)، وأبو نعيم في ((حلية الأولياء)) (1/ 380) واللفظ لهم.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"OlZZPDlW"},{"id":"س-06145","fp":"2abe069b4706","stateId":757,"easy":"إذا كان لك مال لم تؤدِّ زكاته ← تُطوّقه يوم القيامة شجاعاً أقرع يقول: أنا مالك","cause":"مَن كان له مالٌ لم يؤدِّ زكاتَه","result":"طُوِّقَه يومَ القيامةِ شجاعًا أقرعَ ينقُرُ رأسَه فيقولُ أنا مالُك الذي كنتَ تبخلُ به سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ","explicit":true,"repOf":"س-03021","ref":"مجمع الزوائد 6/332","text":["عن عبدِ اللهِ يعنِي ابنَ مسعودٍ في قولٍه  سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ  قال يُطوَّقُ شجاعًا أقرعَ بفِيه زبيبتانِ يَنقُرُ رأسَه فيقولُ مالِي ومالَك فيقولُ أنا مالُك الذي بخلتَ به ، وفي روايةٍ عن عبدِ اللهِ أيضًا قال ",["مَن كان له مالٌ لم يؤدِّ زكاتَه ",1],["طُوِّقَه يومَ القيامةِ شجاعًا أقرعَ ينقُرُ رأسَه فيقولُ أنا مالُك الذي كنتَ تبخلُ به  سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ",2]],"grade":"حسن","narrator":"[شقيق بن سلمة]","muhaddith":"[روي] بأسانيد ورجال أحدها ثقات","takhrij":"أخرجه الطبراني (9/ 230) (9125) واللفظ له، والحاكم في ((مستدركه)) (3205)، وابن أبي شيبة في ((مصنفه)) (10698)كلاهما باختلاف يسير، وابن خزيمة في ((صحيحه)) (2256) بمعناه.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"DahJ883I"},{"id":"س-06133","fp":"c29c299fa49b","stateId":757,"easy":"إذا لم تعطِ الإبل حقها ← تطؤك بأخفافها","cause":"إذا هيَ لم يُعْطِ فيها حقَّها","result":"تَطَؤُهُ بأخْفافِها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-06143","ref":"صحيح الجامع 2902","text":["تأتي الإبلُ على ربِّها على خيرِ ما كانتْ ، ",["إذا هيَ لم يُعْطِ فيها حقَّها",1]," ، ",["تَطَؤُهُ بأخْفافِها",2]," ، وتأتي الغَنمُ على ربِّها على خيرِ ما كانتْ ، إذا لمْ يُعْطِ فيها حقَّها ، تَطَؤُهُ بأظْلافِها ، وتنطَحُه بِقُرُونِها ، ومن حقِّها أن تُحلَبَ على الماءِ ، ألا لا يَأْتِيَنَّ أحدُكم يَومَ القيامةِ بِبعيرٍ يَحملُهُ على رقَبتِه ، له رُغاءٌ ، فيقولُ : يا محمدُ ! فأقولُ : لا أملِكُ لك شيئًا قد بَلَّغتُ ، ألا لا يَأْتِيَنَّ أحدُكم يَومَ القيامةِ بِشاةٍ يحملُها على رقبتِه لها يُعارٌ ، فيقولُ : يا محمدُ ! فأقولُ : لا أملكُ لك شيئًا قد بَلَّغتُ ، ويكونُ كنزُ أحدِكم يومَ القيامةِ شُجاعًا أقرَعَ ، يَفِرُّ منه صاحبُه ، ويطلُبُه : أنا كَنزُكَ ، فلا يزالُ حتى يُلْقِمَهُ  إِصْبَعَهُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1402)، ومسلم (987) باختلاف يسير.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"CIymNJ8J"},{"id":"س-06134","fp":"372b7ecb214d","stateId":757,"easy":"إذا لم تعطِ الغنم حقها ← تطؤك بأظلافها وتنطحك بقرونها","cause":"إذا لمْ يُعْطِ فيها حقَّها","result":"تَطَؤُهُ بأظْلافِها ، وتنطَحُه بِقُرُونِها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الجامع 2902","srcLabel":"متفق عليه","text":["تأتي الإبلُ على ربِّها على خيرِ ما كانتْ ، إذا هيَ لم يُعْطِ فيها حقَّها ، تَطَؤُهُ بأخْفافِها ، وتأتي الغَنمُ على ربِّها على خيرِ ما كانتْ ، ",["إذا لمْ يُعْطِ فيها حقَّها",1]," ، ",["تَطَؤُهُ بأظْلافِها ، وتنطَحُه بِقُرُونِها",2]," ، ومن حقِّها أن تُحلَبَ على الماءِ ، ألا لا يَأْتِيَنَّ أحدُكم يَومَ القيامةِ بِبعيرٍ يَحملُهُ على رقَبتِه ، له رُغاءٌ ، فيقولُ : يا محمدُ ! فأقولُ : لا أملِكُ لك شيئًا قد بَلَّغتُ ، ألا لا يَأْتِيَنَّ أحدُكم يَومَ القيامةِ بِشاةٍ يحملُها على رقبتِه لها يُعارٌ ، فيقولُ : يا محمدُ ! فأقولُ : لا أملكُ لك شيئًا قد بَلَّغتُ ، ويكونُ كنزُ أحدِكم يومَ القيامةِ شُجاعًا أقرَعَ ، يَفِرُّ منه صاحبُه ، ويطلُبُه : أنا كَنزُكَ ، فلا يزالُ حتى يُلْقِمَهُ  إِصْبَعَهُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1402)، ومسلم (987) باختلاف يسير.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"CIymNJ8J"},{"id":"س-07403","fp":"5ef57b053f93","stateId":758,"easy":"إذا سألك ذو رحمك فضلاً فبخلت عليه ← يخرج الله لك من جهنم حية تتلمظ","cause":"ما من ذي رحمٍ يأتي ذا رَحِمَهِ فيسألُه فَضلًا أعطاه اللهُ إياه فيبخلُ علَيهِ","result":"إلَّا أخرج اللهُ لهُ من جهنَّمَ حيَّةً يُقال : لها ( شُجاعٌ ) يَتلمَّظُ ، فيطوَّقُ بهِ","explicit":true,"ref":"صحيح الترغيب 896","srcLabel":"الطبراني","text":[["ما من ذي رحمٍ يأتي ذا رَحِمَهِ فيسألُه فَضلًا أعطاه اللهُ إياه فيبخلُ علَيهِ",1]," ، ",["إلَّا أخرج اللهُ لهُ من جهنَّمَ حيَّةً يُقال : لها ( شُجاعٌ ) يَتلمَّظُ ، فيطوَّقُ بهِ",2]],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"حسن صحيح","takhrij":"أخرجه الطبراني (2/ 322) (2343) واللفظ له.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"v8ZFsGkl"},{"id":"س-05378","fp":"92114cb2ff28","stateId":758,"easy":"إذا منعت فضول الماء لتمنع به الكلأ ← يمنعك الله فضل رحمته يوم القيامة","cause":"مَن منعَ فضولَ الماءِ ليَمنعَ بِهِ الكلأَ","result":"منعَهُ اللَّهُ فَضلَ رحمتِهِ يومَ القيامةِ","explicit":true,"similar":["س-05244"],"ref":"الأم 5/99","srcLabel":"متفق عليه","text":[["مَن منعَ فضولَ الماءِ ليَمنعَ بِهِ الكلأَ",1]," ",["منعَهُ اللَّهُ فَضلَ رحمتِهِ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الشافعي في ((الأم)) (5/99). والنهي عن منع فضل الماء أخرجه البخاري (2354)، ومسلم (1566)","bab":"رقائق وزهد › الجزاء من جنس العمل","dorar":"3XMClQaK"},{"id":"ق-0194","fp":"966b9fd757ac","stateId":758,"easy":"البخل بما آتى الله من فضله ← شرّ لصاحبه ويطوَّق ما بخل به يوم القيامة","cause":"البخل بما آتى الله من فضله","result":"شرّ لصاحبه ويطوَّق ما بخل به يوم القيامة","explicit":true,"ref":"سورة آل عمران: 180","srcLabel":"القرآن الكريم","quran":{"s":3,"from":180,"to":180,"text":"وَلَا يَحْسَبَنَّ الَّذِينَ يَبْخَلُونَ بِمَا آتَاهُمُ اللَّهُ مِنْ فَضْلِهِ هُوَ خَيْرًا لَهُمْ بَلْ هُوَ شَرٌّ لَهُمْ سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ وَلِلَّهِ مِيرَاثُ السَّمَاوَاتِ وَالْأَرْضِ وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ (180)","hl":[[0,172,1]]}},{"id":"ق-0216","fp":"6d33f9e5b41d","stateId":758,"easy":"البخل والأمر به وكتمان فضل الله ← عذاب مهين","cause":"البخل والأمر به وكتمان فضل الله","result":"عذاب مهين","explicit":true,"ref":"سورة النساء: 37","srcLabel":"القرآن الكريم","quran":{"s":4,"from":37,"to":37,"text":"الَّذِينَ يَبْخَلُونَ وَيَأْمُرُونَ النَّاسَ بِالْبُخْلِ وَيَكْتُمُونَ مَا آتَاهُمُ اللَّهُ مِنْ فَضْلِهِ وَأَعْتَدْنَا لِلْكَافِرِينَ عَذَابًا مُهِينًا (37)","hl":[[0,152,1]]}},{"id":"ق-1375","fp":"0a5fcef4251f","stateId":758,"easy":"عدم الإيمان بالله العظيم وترك الحضّ على طعام المسكين ← الكتاب بالشمال والغلّ والجحيم والسلسلة ولا حميم","cause":"عدم الإيمان بالله العظيم وترك الحضّ على طعام المسكين","result":"الكتاب بالشمال والغلّ والجحيم والسلسلة ولا حميم","explicit":true,"ref":"سورة الحاقة: 25–37","srcLabel":"القرآن الكريم","quran":{"s":69,"from":25,"to":37,"text":"وَأَمَّا مَنْ أُوتِيَ كِتَابَهُ بِشِمَالِهِ فَيَقُولُ يَا لَيْتَنِي لَمْ أُوتَ كِتَابِيَهْ (25) وَلَمْ أَدْرِ مَا حِسَابِيَهْ (26) يَا لَيْتَهَا كَانَتِ الْقَاضِيَةَ (27) مَا أَغْنَى عَنِّي مَالِيَهْ (28) هَلَكَ عَنِّي سُلْطَانِيَهْ (29) خُذُوهُ فَغُلُّوهُ (30) ثُمَّ الْجَحِيمَ صَلُّوهُ (31) ثُمَّ فِي سِلْسِلَةٍ ذَرْعُهَا سَبْعُونَ ذِرَاعًا فَاسْلُكُوهُ (32) إِنَّهُ كَانَ لَا يُؤْمِنُ بِاللَّهِ الْعَظِيمِ (33) وَلَا يَحُضُّ عَلَى طَعَامِ الْمِسْكِينِ (34) فَلَيْسَ لَهُ الْيَوْمَ هَاهُنَا حَمِيمٌ (35) وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍ (36) لَا يَأْكُلُهُ إِلَّا الْخَاطِئُونَ (37)","hl":[[0,582,1]]}},{"id":"ق-1376","fp":"65ab605738aa","stateId":758,"easy":"الإدبار والتولي وجمع المال ومنع حقه ← لظى نزّاعة للشوى","cause":"الإدبار والتولي وجمع المال ومنع حقه","result":"لظى نزّاعة للشوى","explicit":true,"ref":"سورة المعارج: 15–18","srcLabel":"القرآن الكريم","quran":{"s":70,"from":15,"to":18,"text":"كَلَّا إِنَّهَا لَظَى (15) نَزَّاعَةً لِلشَّوَى (16) تَدْعُو مَنْ أَدْبَرَ وَتَوَلَّى (17) وَجَمَعَ فَأَوْعَى (18)","hl":[[0,109,1]]}},{"id":"س-07407","fp":"e5a812e47e13","stateId":758,"easy":"إذا أغلقت بابك دون جارك وضننت عليه بمالك ← يتعلق بك يوم القيامة","cause":"أغلقَ بابَهُ وضنَّ عني بمالِهِ","result":"وإنَّ الرجلَ ليتعلَّقُ بجارِهِ يوم القيامةِ","explicit":true,"otherNeedIds":[13],"ref":"مسند عمر 1/109","srcLabel":"أبو داود","text":[". . . وأخذتم أذنابَ البقرِ ورضيتم بالزرعِ وتركتم الجهادَ . . . . . ",["وإنَّ الرجلَ ليتعلَّقُ بجارِهِ يوم القيامةِ",2]," إنَّ هذا ",["أغلقَ بابَهُ وضنَّ عني بمالِهِ",1]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3462)، وأحمد (4825) مختصراً باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"XvyiANDN","merged":3,"otherRefs":["السلسلة الصحيحة 2646 (حسن)","الجامع الصغير 6497 (صحيح)"]},{"id":"س-05244","fp":"652b6a7819f8","stateId":758,"easy":"إذا منعت فضل الماء لتمنع به فضل الكلأ ← يمنعك الله فضله يوم القيامة","cause":"مَن منَعَ فَضلَ الماءِ ليَمنَعَ به فَضلَ الكَلأِ","result":"منَعَه اللهُ فَضلَه يومَ القِيامةِ","explicit":true,"repOf":"س-05378","ref":"تخريج المسند لشعيب 6722","text":["أنَّ عبدَ اللهِ بنَ عَمرٍو كتَبَ إلى عاملٍ له على أرضٍ له: أنْ لا تَمنَعَ فَضلَ مائِكَ؛ فإنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن منَعَ فَضلَ الماءِ ليَمنَعَ به فَضلَ الكَلأِ؛ ",1],["منَعَه اللهُ فَضلَه يومَ القِيامةِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (6722) واللفظ له، والطبراني في (13/650) (14576)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"vjBM9HxN","merged":2,"otherRefs":["صحيح الترغيب 897 (حسن)"]},{"id":"س-04950","fp":"aef21b196cc7","stateId":758,"easy":"إذا سألك مولاك من فضل عندك فمنعته ← يُدعى لك يوم القيامة فضلك شجاعاً أقرع","cause":"لا يَسأَلُ رَجُلٌ مَوْلاه من فَضلٍ هو عندَه فيمنَعَه إيَّاه","result":"إلَّا دُعِيَ له يومَ القيامةِ فضلُه الذي مَنَعَه شُجاعًا أقرَعَ","explicit":true,"ref":"تخريج سنن أبي داود 5139","srcLabel":"أبو داود","text":["قُلتُ: يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، مَن أبَرُّ؟ قال: أُمَّك، ثمَّ أمَّكَ، ثمَّ أمَّكَ، ثمَّ أباكَ، ثُمَّ الأقربَ فالأقربَ. وقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["لا يَسأَلُ رَجُلٌ مَوْلاه من فَضلٍ هو عندَه فيمنَعَه إيَّاه،",1]," ",["إلَّا دُعِيَ له يومَ القيامةِ فضلُه الذي مَنَعَه شُجاعًا أقرَعَ",2],"."],"grade":"صحيح","narrator":"معاوية بن حيدة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (5139)، واللفظ له، والترمذي (1897)، وأحمد (20028) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ynYrA3Ou"},{"id":"س-05043","fp":"f218e8cace4b","stateId":758,"easy":"إذا ادخرت التمر وخبأته بخلاً ← أما تخشى أن يُخسف به في نار جهنم","cause":"ما عندي إلَّا صُبْرٌ من تمرٍ خبأتُهُ لكَ","result":"أما تخشَى أن يُخسَفَ به في نارِ جهنَّمَ","explicit":true,"similar":["س-06278"],"ref":"معجم الشيوخ 1/285","srcLabel":"البيهقي","text":["أطعِمنا يا بلالُ قالَ : يا رسولَ اللَّهِ ",["ما عندي إلَّا صُبْرٌ من تمرٍ خبأتُهُ لكَ",1]," قال ",["أما تخشَى أن يُخسَفَ به في نارِ جهنَّمَ",2]," أنفِقْ يا بلالُ ولا تَخشَ مِن ذي العرشِ إقلالًا"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"محفوظ من حديث مفضل عن الأعمش","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (1466)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"acQl79uU"},{"id":"س-05383","fp":"6b0fd3c1af4d","stateId":758,"easy":"إذا منعت فضل مائك أو كلئك ← يمنعك الله فضله يوم القيامة","cause":"مَن مَنَعَ فَضلَ مائِهِ أو فَضلَ كَلَئِهِ","result":"مَنَعَه اللهُ فَضلَه يَومَ القيامَةِ","explicit":true,"ref":"تخريج المسند لشاكر 10/155","srcLabel":"أحمد","text":[["مَن مَنَعَ فَضلَ مائِهِ أو فَضلَ كَلَئِهِ",1]," ",["مَنَعَه اللهُ فَضلَه يَومَ القيامَةِ",2]],"grade":"صحيح","narrator":"[جد عمرو بن شعيب]","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6673) واللفظ له، والطبراني في ((الأوسط)) (1195) بنحوه مع زيادة في أوله، وابن زنجويه في ((الأموال)) (1093) باختلاف يسير.","bab":"رقائق وزهد › الجزاء من جنس العمل","dorar":"p4NbkOJo"},{"id":"س-06278","fp":"020b8bc8ee65","stateId":758,"easy":"إذا ادخرت الطعام بخلاً ← أما تخشى أن يُجعل لك بخار في نار جهنم","cause":"ادَّخَرْتُه لك","result":"أما تخشى أن يُجعَل لك بخارٌ في نارِ جهنَّمَ","explicit":true,"repOf":"س-05043","ref":"صحيح الترغيب 922","text":["ما هذا يا بلالُ ! . قال : ",["ادَّخَرْتُه لك",1]," يا رسولَ اللهِ ! قال : ",["أما تخشى أن يُجعَل لك بخارٌ في نارِ جهنَّمَ",2]," ؟ ! أَنفِقْ يا بلالُ ! و لا تخشَ من ذي العرشِ إقْلالًا"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه مطولاً الطبراني (1/342) (1028) واللفظ له، وأبو نعيم في ((حلية الأولياء)) (2/280)، والبيهقي في ((شعب الإيمان)) (1345) باختلاف يسير.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"D8XjFyAh"},{"id":"س-06317","fp":"12ecce15b6b5","stateId":758,"easy":"إذا ادخرت لأضيافك بخلاً على المحتاج ← أما تخشى أن يفور له بخار في جهنم","cause":"أعدُّ ذلِكَ لأضيافِكَ","result":"أمَّا تخشَى أن يفورَ لهُ بخارٌ في نارِ جهنَّمَ","explicit":true,"ref":"صحيح الترغيب 921","srcLabel":"الطبراني","text":["ما هذا يا بِلالُ ؟ . قال : ",["أعدُّ ذلِكَ لأضيافِكَ",1]," . قالَ : ",["أمَّا تخشَى أن يفورَ لهُ بخارٌ في نارِ جهنَّمَ",2]," ؟ ! أنفِقْ بلالُ ! و لا تَخشَ من ذيِ العرشِ إقلالًا"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح لغيره","takhrij":"أخرجه البزار (1978)، والطبراني (1/340) (1023)، وأبو نعيم في ((حلية الأولياء)) (1/149) باختلاف يسير","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"0TkO360q"},{"id":"س-07324","fp":"04077ce4a802","stateId":758,"easy":"إذا بخلت بما آتاك الله ← تُطوّق به يوم القيامة ثعباناً ينقر رأسك","cause":"سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ","result":"يَجيئُهُ ثُعبانٌ، فيَنقُرُ رأسَهُ، ثُمَّ يتطَوَّقُ في عُنقِهِ، ثُمَّ يقولُ: أنا مالُكَ الَّذي بَخِلْتَ به","explicit":true,"ref":"المستدرك على الصحيحين 3211","srcLabel":"الحاكم","text":["عنْ عبدِ اللهِ بنِ مسعودٍ في قولِهِ: {",["سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ",1],"} [آل عمران: 180]، قالَ: قالَ عبدُ اللهِ: ",["يَجيئُهُ ثُعبانٌ، فيَنقُرُ رأسَهُ، ثُمَّ يتطَوَّقُ في عُنقِهِ، ثُمَّ يقولُ: أنا مالُكَ الَّذي بَخِلْتَ به",2],"."],"grade":"صحيح","narrator":"أبو وائل","muhaddith":"صحيح على شرط الشيخين","bab":"فتن › فتنة المال","dorar":"qKDiaUaR"},{"id":"س-05218","fp":"f1807496feaa","stateId":758,"easy":"إذا ادخرت لغد بخلاً ← تخشى أن ترى له بخاراً في جهنم","cause":"شيءٌ ادَّخَرْتُهُ لِغَدٍ","result":"أَمَا تَخْشَى أن تَرَى له غَدًا بُخَارًا في نارِ جهنمَ يومَ القيامةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"هداية الرواة 1826","srcLabel":"الطبراني","text":["أن النبيَّ - صلَّى اللهُ عليهِ وسلَّم - دخل على بلالٍ وعنده صُبْرَةٌ من تَمْرٍ، فقال : ما هذا يا بلالُ ؟ !، قال : ",["شيءٌ ادَّخَرْتُهُ لِغَدٍ",1],"، فقال : ",["أَمَا تَخْشَى أن تَرَى له غَدًا بُخَارًا في نارِ جهنمَ يومَ القيامةِ",2]," ؟ ! أَنْفِقْ بلالُ ! ولا تَخْشَ من ذِي العرشِ إِقْلالًا"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (3067) بلفظه، والطبراني (10/ 155) (10300)، والبزار (1978)، والحارث بن أبي أسامة كما في ((بغية الباحث)) (941) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"b9nTN8iW","merged":2,"otherRefs":["إتحاف الخيرة المهرة 4/ 177 (حسن)"]},{"id":"س-01712","fp":"58d9bcd2d875","stateId":758,"easy":"إذا سُئلت بوجه الله فرددت السائل وأنت قادر ← تقف يوم القيامة وليس على وجهك جلد ولا لحم","cause":"من سُئِلَ بوجْهِ اللهِ فردَّ سائلَهُ وهو يَقدرُ","result":"وقفَ يومَ القيامةِ وليس على وجهِهِ جلدٌ ولا لحمٌ ولا عظمَ يَتقعقعُ","explicit":true,"ref":"الإصابة في تمييز الصحابة 1/434","srcLabel":"الطبراني","text":["عن أبي أمامةَ الباهليِّ أنَّ رسولَ اللهِ صلَّى اللهِ عليْهِ وآلِه وسلَّمَ قال لأصحابِهِ : ألَا أُحدِّثُكم عنِ الخَضرِ ؟ قالوا : بلى يا رسولَ اللهِ ، قال : بينما هو ذاتَ يومٍ يَمشي في سوقِ بني إسرائيلَ أبصرَهُ رجلٌ مكاتبٌ ، فقال : تصدَّقْ عليَّ باركَ اللهُ فيك ، قال الخضرُ : آمنْتُ باللهِ ما شاء اللهُ من أمرٍ يكنْ . ما عندي من شيءٍ أُعطيكَهُ ، فقال المسكينُ : أسألُكَ بوجهِ اللهِ لما تصدقْتَ عليَّ فإنِّي نظرْتُ السماحةَ في وجهِكَ ، ورجوْتُ البركةَ عِندَكَ ، فقال الخضرُ : آمنْتُ باللهِ ما عندي شيءٌ أُعطيكَهُ إلَّا أن تأخذَني فتَبيعَني فقال المسكينُ : وهل يستقيمُ هذا ؟ قال : نعم الحقَّ أقولُ : لقد سألتَني بأمرٍ عظيمٍ أما إنِّي لا أُخيبُكَ بوجهِ ربِّي بِعْني . قال : فقدَّمَهُ إلى السوقِ فباعَهُ بأربعِمائةِ درهمٍ فمكثَ عِندَ المُشتري زمانًا لا يَستعملُهُ في شيءٍ ، فقال له إنَّكَ إنَّما اشتريتَني الْتماسَ خيرٍ عندي فأوصِني بعملٍ ، قال : أكرَهُ أنْ أشقَّ عليكَ إنَّكَ شيخٌ كبيرٌ ضعيفٌ قال ليس يشقُّ عليَّ قال فقمْ فانقلْ هذه الحجارةَ وكان لا ينقلُها دونَ ستةِ نفرٍ في يومٍ فخرجَ الرجلُ لبعضِ حاجتِهِ ثم انصرفَ ، وقد نقلَ الحجارةَ في ساعةٍ فقال : أحسنْتَ وأجملْتَ وأطقْتَ ما لم أركَ تُطيقُهُ ، قال : ثم عرضَ للرجلِ سفرٌ ، فقال إنِّي أحسبُكَ أمينًا ، فاخلُفْني في أهلي خلافةً حسنةً . قال : نعم وأوصني بعملٍ قال : إنِّي أكرَهُ أن أشقَّ عليك قال : ليس يشقُّ عليَّ ، قال فاضربْ منَ اللبنِ لبَيتي حتى أقدمَ عليك ، قال ومرَّ الرجلُ لسفرِهِ ، ثم رجع وقد شيَّدَ بناءَهُ ، فقال : أسألُكَ بوجهِ اللهِ ما سبيلُكَ ؟ وما أمرُكَ ؟ قال سألتَني بوجهِ اللهِ ووجهِ اللهِ أوقعَني في العبوديةِ ، فقال الخَضِرُ : سأخبرُكَ من أنا ، أنا الخضرُ الذي سمعْتَ به ، سألَني مسكينٌ صدقةً ، فلم يكنْ عندي شيءٌ أعطيهِ فسألَني بوجهِ اللهِ ، فمكنْتُهُ من رَقبتي فباعَني وأخبرُكَ أنَّهُ ",["من سُئِلَ بوجْهِ اللهِ فردَّ سائلَهُ وهو يَقدرُ",1]," ",["وقفَ يومَ القيامةِ وليس على وجهِهِ جلدٌ ولا لحمٌ ولا عظمَ يَتقعقعُ",2]," ، فقال الرجلُ آمنْتُ باللهِ شققْتُ عليك يا نبيَّ اللهِ ولم أعلمْ ، قال : لا بأسَ أحسنْتَ وأبقيْتَ فقال الرجلُ : بأبي وأمي يا نبيَّ اللهِ احكمْ في أهلي ومالي بما شئْتَ ، أوِ اخترْ فأُخلِّي سبيلَكَ ، قال : أحبُّ أن تخليَ سبيلي ، فأعبدَ ربِّي . قال فخلَّى سبيلَهُ ، فقال الخضرُ : الحمدُ للهِ الذي أوقعَني في العبوديةِ ثم نجَّاني منها"],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"إسناده حسن لولا عنعنة بقية","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (1877)، والطبراني (8/132) (7530)، وابن عدي في ((الكامل في الضعفاء)) (2/76) باختلاف يسير.","bab":"أنبياء › الخضر","dorar":"LF1eFm1g"},{"id":"س-03847","fp":"90f02d24527d","stateId":758,"easy":"إذا سألك ابن عمك من فضلك فمنعته ← يمنعك الله فضله يوم القيامة","cause":"أيما رجلٍ أتاه ابنُ عمِّه يسألُه من فضلِه ، فمنعه","result":"منعه اللهُ فضلَه يومَ القيامةِ","explicit":true,"ref":"صحيح الترغيب 897","srcLabel":"أحمد","text":[["أيما رجلٍ أتاه ابنُ عمِّه يسألُه من فضلِه ، فمنعه ، ",1],["منعه اللهُ فضلَه يومَ القيامةِ ",2],"[ومَن مَنَعَ فَضلَ الماءِ ليَمنَعَ به فَضلَ الكَلأِ، مَنَعَه اللهُ فَضلَه يَومَ القيامةِ]"],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (6673) مختصراً باختلاف يسير، والطبراني في ((المعجم الأوسط)) (1195) باختلاف يسير","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"VO3fkAqL"},{"id":"س-06127","fp":"72a3e74ad101","stateId":758,"easy":"إذا كثر مالك ← فويل لك إلا أن تنفقه هكذا وهكذا","cause":"لمُكثِرينَ","result":"ويلٌ ل","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الترغيب 3262","srcLabel":"ابن ماجه","text":[["ويلٌ ل",2],["لمُكثِرينَ ",1],"[يعني حديث: ويلٌ للمُكثِرينَ، إلَّا مَن قالَ بالمالِ هكذا، وهكذا، وهكذا، وهكذا)، أرْبَعٌ: عن يَمينِه، وعن شِمالِه، ومِن قُدَّامِه، ومِن وَرائِه.]"],"grade":"صحيح","narrator":"[أبو سعيد الخدري]","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (4129)، واللفظ له، وأحمد (11491)، وأبو يعلى (1083)، بنحوه.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"frKRd3Wy"},{"id":"س-07329","fp":"ff756cdc4abf","stateId":758,"easy":"إذا جمعت المال ولم تقدّم خيراً ← يُمضى بك إلى النار","cause":"جمعتهُ وثمَّرتهُ فتركتهُ أكثرُ ما كان","result":"فإذا عبدٌ لم يقدِّمْ خيرًا فيُمضى به إلى النارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"التذكرة للقرطبي 265","srcLabel":"الترمذي","text":["يجاءُ بابنِ آدمَ يومَ القيامةِ فيوقَفُ بين يديِ اللهِ تعالى فيقولُ لهُ : أعطيتُك وخوَّلتُك وأنعمتُ عليك ، فماذا صنعتَ ؟ فيقولُ : يا ربِّ ",["جمعتهُ وثمَّرتهُ فتركتهُ أكثرُ ما كان",1]," فارجعْني آتيكَ به فيقولُ اللهُ تعالى : أرِني ما قدَّمتَ فيقولُ : ",["فإذا عبدٌ لم يقدِّمْ خيرًا فيُمضى به إلى النارِ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2427) باختلاف يسير، وأبو يعلى (4121)، وأبو نعيم في ((حلية الأولياء)) (6/310) بنحوه","bab":"فتن › فتنة المال","dorar":"EEu0wxP8"},{"id":"س-03018","fp":"54ba0ce6efd6","stateId":758,"easy":"إذا سألك مولاك فضل مالك فلم تعطه ← يُجعل يوم القيامة شجاعاً أقرع","cause":"مَن سَأَلَه مَولاه فَضلَ مالِه فلمْ يُعطِهْ","result":"جُعِلَ يومَ القيامةِ شُجاعًا أقرَعَ","explicit":true,"ref":"تخريج المسند لشعيب 20020","srcLabel":"أبو داود","text":[["مَن سَأَلَه مَولاه فَضلَ مالِه فلمْ يُعطِهْ",1],"، ",["جُعِلَ يومَ القيامةِ شُجاعًا أقرَعَ",2],"."],"grade":"حسن","narrator":"معاوية بن حيدة القشيري","muhaddith":"إسناده حسن","takhrij":"أخرجه أبو داود (5139)، والنسائي (2566)، وأحمد (20020) واللفظ له","bab":"إيمان › الوعيد","dorar":"XVQhl4Ss"},{"id":"س-02977","fp":"fc38e8411041","stateId":759,"easy":"إذا كذبت على النبي ﷺ ← تلج النار","cause":"مَن كَذَب عَلَيَّ","result":"يَلِجِ النَّارَ","explicit":true,"ref":"المستدرك على الصحيحين 8029","srcLabel":"مسلم","text":["لمَّا افتَتَح رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ مَكَّةَ أتاه ناسٌ مِن قُرَيشٍ، فقالوا: إنَّه قدْ لَحِقَ بكَ ناسٌ مِن مَوالينا وأرِقَّائِنا، ليْس لهم رَغبةٌ في الدِّينِ إلَّا فِرارًا مِن مَواشينا وزَرعِنا، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: واللهِ يا مَعشَرَ قُرَيشٍ، لَتُقيمُنَّ الصَّلاةَ، ولَتُؤْتُنَّ الزَّكاةَ، أو لَأَبْعَثَنَّ عليكم رَجُلًا فيَضرِبُ أعناقَكُم على الدِّينِ، ثمَّ قالَ: أنا أو خاصِفُ النَّعلِ، قال عَلِيٌّ: وأنا أخصِفُ نَعْلَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، ثمَّ قال عَلِيٌّ: سَمِعتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["مَن كَذَب عَلَيَّ",1]," ",["يَلِجِ النَّارَ",2],"."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح على شرط مسلم","bab":"إيمان › الوعيد","dorar":"ueGxtwVP"},{"id":"س-05178","fp":"e588224eb165","stateId":759,"easy":"إذا أدركت الفتن فلم تتقِ الله ولم تأمر بالمعروف وكذبت على النبي ﷺ ← فتبوأ مقعدك من النار","cause":"فمن أدرك ذلك مِنْكم فلْيَتَّقِ اللهَ ولْيَأمُرْ بالمعروفِ ولْيَنْهَ عن المنكَرِ، ومَن كَذَب عَلَيَّ مُتعَمِّدًا","result":"فلْيتبَوَّأْ مَقعَدَه مِنَ النَّارِ","explicit":true,"ref":"تخريج المسند لشاكر 5/257","srcLabel":"الترمذي","text":["جمَعَنا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم ونحن أربَعونَ، قال عبدُ اللهِ: فكُنتُ مِن آخِرِ مَن أتاه فقال: إنَّكم مُصيِبون ومَنصورون ومفتوحٌ لكم، ",["فمن أدرك ذلك مِنْكم فلْيَتَّقِ اللهَ ولْيَأمُرْ بالمعروفِ ولْيَنْهَ عن المنكَرِ، ومَن كَذَب عَلَيَّ مُتعَمِّدًا ",1],["فلْيتبَوَّأْ مَقعَدَه مِنَ النَّارِ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (2257) باختلاف يسير، وابن ماجه (30) مختصراً","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"9ptYiwKC"},{"id":"س-04980","fp":"c89c33cf0474","stateId":759,"easy":"إذا قلت في القرآن برأيك ← فتبوأ مقعدك من النار","cause":"ومَن قالَ في القُرْآنِ برَأيِه","result":"فلْيَتَبوَّأْ مَقعَدَه مِن النَّارِ","explicit":true,"ref":"الأحكام الوسطى 4/ 339","srcLabel":"الأحكام الوسطى","text":["\"اتَّقوا الحَديثَ عنِّي إلَّا ما عَلِمْتُم، فمَن كَذَبَ علَيَّ مُتَعمِّدًا فلْيَتَبوَّأْ مَقعَدَه مِن النَّارِ، ",["ومَن قالَ في القُرْآنِ برَأيِه ",1],["فلْيَتَبوَّأْ مَقعَدَه مِن النَّارِ\"",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"0CdBJsP2"},{"id":"س-08317","fp":"b098955ec573","stateId":759,"easy":"إذا كذبت على النبي ﷺ متعمداً ← فتبوأ مقعدك من النار","cause":"من كذب عليَّ مُتعمِّدًا","result":"فلْيتبوَّأْ مَقعدَه من النَّارِ","explicit":true,"star":true,"similar":["س-08354","س-03006","س-04955","س-05097","س-03011","س-03057","س-04208","س-08345","س-03763","س-03098","س-00507","س-02575","س-04226","س-04247","س-04305","س-05077","س-05081","س-05240"],"ref":"سنن الترمذي 3715","srcLabel":"متفق عليه","text":["لما كان يومُ الحُدَيبيةِ ، خرج إلينا ناسٌ من المشركين ، فيهم سُهَيلُ بنُ عَمرو ، وأُناسٌ من رؤساءِ المشركين ، فقالوا : يا رسولَ اللهِ ! خرج إليك ناسٌ من أبنائِنا وإخواننا وأرِقَّائِنا ، وليس لهم ثقةٌ في الدِّين ، وإنما خرجوا فرارًا من أموالنا وضياعِنا ، فارْدُدْهم إلينا ، فإن لم يكن لهم فقهٌ في الدِّين سنُفَقِّهُهم ، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ يا معشرَ قريشٍ ! لتنتهُنَّ أو ليبعثَنَّ اللهُ عليكم من يضرب رقابَكم بالسيفِ على الدِّينِ ، قد امتحن اللهُ قلوبَهم على الإيمانِ . قالوا : من هو يا رسولَ اللهِ ؟ فقال له أبو بكرٍ : من هو يا رسولَ اللهِ ؟ وقال عمرُ : من هو يا رسولَ اللهِ ؟ قال : هو خاصفُ النَّعلِ . وكان أعطى عليًّا نعلَه يخصفُها ، قال : ثم التفت إلينا عليٌّ ، فقال : إنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال : ",["من كذب عليَّ مُتعمِّدًا ",1],["فلْيتبوَّأْ مَقعدَه من النَّارِ",2]],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"حسن صحيح غريب لا نعرفه إلا من حديث ربعي عن علي","takhrij":"أخرجه أحمد بن حنبل في ((فضائل الصحابة)) (1105)، باختلاف يسير، وأصله في البخاري (106)، ومسلم (1)","bab":"مناقب وفضائل › علي بن أبي طالب","dorar":"hdVa4t7B","merged":25,"otherRefs":["نخب الافكار 13/517 (صحيح)","الوهم والإيهام 5/313 (صحيح)","تخريج المسند لشعيب 12800 (صحيح)","تخريج المسند لشعيب 6592 (صحيح)","صحيح أبي داود 3651 (صحيح)","تخريج المسند لشعيب 11092 (صحيح)","تخريج المسند لشعيب 19266 (صحيح)","تخريج سير أعلام النبلاء 9/186 (صحيح)","تخريج المسند لشعيب 1089 (حسن)","تخريج المسند لشعيب 11536 (صحيح)","صحيح البخاري 107 (صحيح)","الأحاديث المختارة 1088 (صحيح)","مسند أبي بكر الصديق 593 (صحيح)","تخريج مشكل الآثار 409 (صحيح)","صحيح البخاري 110 (صحيح)","تخريج المسند لشعيب 12764 (صحيح)","تخريج سير أعلام النبلاء 1/43 (صحيح)","الأحكام الوسطى 4/ 339 (صحيح)","تخريج صحيح ابن حبان 6256 (صحيح)","تخريج المسند لشعيب 1428 (صحيح)","تخريج المسند لشعيب 18202 (صحيح)","تخريج مشكل الآثار 387 (صحيح)","تخريج المسند لشعيب 17431 (صحيح)","صحيح ابن حبان 4804 (صحيح)"]},{"id":"س-08354","fp":"cb8d0b4e5f9e","stateId":759,"easy":"إذا كذبت على النبي ﷺ ← تلج النار","cause":"لا تَكْذِبوا عَلَيَّ","result":"فإنَّه مَنْ يَكذِبْ عَلَيَّ يَلِجِ النَّارَ","explicit":true,"repOf":"س-08317","ref":"المستدرك على الصحيحين 2651","text":["لمَّا افتَتَحَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ مكَّةَ أَتاهُ ناسٌ مِن قريشٍ، فقالوا: يا مُحمَّدُ، إنَّا حُلفاؤكَ وقَومُكَ، وإنَّه لَحِقَ بكَ أَرِقَّاؤنا، ليس لهُم رَغبةٌ في الإسلامِ، وإنَّما فَرُّوا مِن العملِ، فارْدُدْهُم علينا، فشاوَرَ أبا بكرٍ في أمْرِهِم، فقالَ: صَدَقوا يا رسولَ اللهِ، فقالَ لعُمَرَ: ما تَرى؟ فقالَ مِثلَ قولِ أبي بكرٍ، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا مَعشرَ قريشٍ، ليَبْعَثَنَّ اللهُ عليكم رَجلًا منكم، امْتَحَنَ اللهُ قلبَهُ للإيمانِ، يَضرِبُ رِقابَكُم على الدِّينِ، فقالَ أبو بكرٍ: أنا هو يا رسولَ اللهِ؟ قالَ: لا، قالَ عُمَرُ: أنا هو يا رسولَ اللهِ؟ قالَ: لا، ولكنَّه خاصِفُ النَّعلِ في المسجدِ -وقد كان أَلْقى نَعْلَه إلى عَليٍّ يَخصِفُها- ثُمَّ قالَ: أما إنِّي سَمِعْتُه يقولُ: ",["لا تَكْذِبوا عَلَيَّ",1],"؛ ",["فإنَّه مَنْ يَكذِبْ عَلَيَّ يَلِجِ النَّارَ",2],"."],"grade":"صحيح","narrator":"علي","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه البخاري (106)، ومسلم (1)، والترمذي (2660) جميعهم مختصرا.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"7aVrZFI2","merged":2,"otherRefs":["تخريج المسند لشعيب 1000 (صحيح)"]},{"id":"س-03006","fp":"c9bdddf4d9a7","stateId":759,"easy":"إذا كذبت على النبي ﷺ متعمداً ← فتبوأ مقعدك من النار","cause":"مَن كَذَبَ عليَّ","result":"فليَتَبَوَّأْ مَقْعَدَه مِن النَّارِ، مُتعمِّدًا، حدَّثَنا به هكذا مرَّتينِ، وحدَّثَنا به مرةً أخرى","explicit":true,"repOf":"س-08317","ref":"تخريج المسند لشعيب 12800","text":[["مَن كَذَبَ عليَّ ",1],["فليَتَبَوَّأْ مَقْعَدَه مِن النَّارِ، مُتعمِّدًا، حدَّثَنا به هكذا مرَّتينِ، وحدَّثَنا به مرةً أخرى",2],"، فقال: قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: مَن كَذَبَ عليَّ مُتعمِّدًا فليَتَبَوَّأْ مَقْعَدَه مِن النَّارِ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (108)، ومسلم (2)، والترمذي (2661)، والنسائي في ((السنن الكبرى)) (5914)، وابن ماجه (32)، وأحمد (12800) واللفظ له","bab":"إيمان › الوعيد","dorar":"it24KoZu"},{"id":"س-04302","fp":"b23e3e628c1c","stateId":759,"easy":"إذا حدّثت عن النبي ﷺ فكذبت ← تبوأت مقعدك من النار","cause":"مَن حَدَّثَ عنِّي بحَديثٍ فكَذَبَ","result":"تَبَوَّأَ مَقعَدَه مِن النَّارِ","explicit":true,"ref":"الأحاديث المختارة 833","srcLabel":"البخاري","text":["«",["مَن حَدَّثَ عنِّي بحَديثٍ فكَذَبَ، ",1],["تَبَوَّأَ مَقعَدَه مِن النَّارِ»",2],"."],"grade":"صحيح","narrator":"طلحة بن عبيد الله","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"QpAiYEbA"},{"id":"س-04955","fp":"15c4333b35b2","stateId":759,"easy":"إذا كذبت على النبي ﷺ ← فليشهد جنبك مضجعاً من النار","cause":"مَن كذَبَ علَيَّ","result":"فليَشهَدْ لجَنبِه مَضجَعًا مِن النَّارِ","explicit":true,"repOf":"س-08317","ref":"تخريج سير أعلام النبلاء 2/451","text":["قُلتُ لأبي قَتادةَ: ما لك لا تُحدِّثُ عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ كما يُحدِّثُ عنه النَّاسُ؟ فقال: سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن كذَبَ علَيَّ، ",1],["فليَشهَدْ لجَنبِه مَضجَعًا مِن النَّارِ",2],"."],"grade":"صحيح","narrator":"أبو قتادة","muhaddith":"متواتر","takhrij":"أخرجه الشافعي في ((الرسالة)) (1093) بلفظ: فليتلمس لجنبه. والبخاري في ((الأدب المفرد))(904) بلفظ: فليسهل لجنبه ، والبيهقي في ((معرفة السنن والآثار))(142) بلفظ:فليلتمس لجنبه .","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"fDXQYm1S"},{"id":"س-05097","fp":"6cb563093689","stateId":759,"easy":"إذا قلت على النبي ﷺ باطلاً أو ما لم يقل ← تبوأت مقعدك من النار","cause":"لا يَقولُ أحَدٌ علَيَّ باطِلًا، أو ما لم أقُلْ","result":"إلَّا تَبَوَّأَ مَقعَدَهُ مِنَ النَّارِ","explicit":true,"repOf":"س-08317","ref":"تخريج المسند لشعيب 16524","text":[["لا يَقولُ أحَدٌ علَيَّ باطِلًا، أو ما لم أقُلْ،",1]," ",["إلَّا تَبَوَّأَ مَقعَدَهُ مِنَ النَّارِ",2],"."],"grade":"صحيح","narrator":"سلمة بن الأكوع","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (109) مختصراً، وأحمد (16524) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ra6pCOx2"},{"id":"س-03011","fp":"a89d898a4d62","stateId":759,"easy":"إذا كذبت على النبي ﷺ متعمداً ← فتبوأ مقعدك من النار","cause":"فمَن كتَب عنِّي شيئًا فلْيَمْحُه\"، وقال: \"حدِّثوا عنِّي، ومَن كذَب عليَّ مُتعمِّدًا","result":"فلْيَتبوَّأْ مَقعَدَه منَ النَّارِ","explicit":true,"repOf":"س-08317","ref":"تخريج المسند لشعيب 11344","text":["\"لا تَكتُبوا عنِّي شيئًا إلَّا القُرآنَ، ",["فمَن كتَب عنِّي شيئًا فلْيَمْحُه\"، وقال: \"حدِّثوا عنِّي، ومَن كذَب عليَّ مُتعمِّدًا ",1],["فلْيَتبوَّأْ مَقعَدَه منَ النَّارِ\"",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (3004) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"GImi4yuq"},{"id":"س-03057","fp":"c1f871d39a28","stateId":759,"easy":"إذا تعمدت الكذب على النبي ﷺ ← فتبوأ مقعدك من النار","cause":"مَن تَعَمَّدَ عليَّ كَذِبًا","result":"فليَتَبَوَّأْ مَقعَدَه مِنَ النَّارِ","explicit":true,"repOf":"س-08317","ref":"صحيح البخاري 108","text":["إنَّه لَيَمنَعُني أن أُحَدِّثَكُم حَديثًا كَثيرًا أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم قال: ",["مَن تَعَمَّدَ عليَّ كَذِبًا ",1],["فليَتَبَوَّأْ مَقعَدَه مِنَ النَّارِ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2) واللفظ له، وأحمد (12110)، والدارمي (241) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"SoBGWWJg"},{"id":"س-04208","fp":"47e39c329a13","stateId":759,"easy":"إذا كذبت على النبي ﷺ متعمداً ← فلتلج النار","cause":"فمَن كذَبَ عليَّ مُتعمِّدًا","result":"فلْيَلِجِ النارَ","explicit":true,"repOf":"س-08317","ref":"تخريج سير أعلام النبلاء 5/410","text":["لا تَكذِبوا عليَّ، ",["فمَن كذَبَ عليَّ مُتعمِّدًا",1]," ",["فلْيَلِجِ النارَ",2],"."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"متواتر","takhrij":"أخرجه الذهبي في ((سير أعلام النبلاء)) (5/ 410)، ومسلم (1)، وأحمد (629) بلفظه.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"xe5DH6ag"},{"id":"س-08345","fp":"3e2fef353e50","stateId":759,"easy":"إذا قلت على النبي ﷺ ما لم يقل ← فتبوأ مقعدك من النار","cause":"مَن قال علَيَّ ما لَمْ أقُلْ","result":"فلْيتبوَّأْ مَقعدَه مِن النَّارِ","explicit":true,"repOf":"س-08317","ref":"تخريج صحيح ابن حبان 6982","text":["قال عبدُ اللهِ بنُ الزُّبيرِ لأبيه : يا أبتِ حدِّثْني عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم حتَّى أُحدِّثَ عنكَ فإنَّ كلَّ أبناءِ الصَّحابةِ يُحدِّثُ عن أبيه قال : يا بنيَّ ما مِن أحَدٍ صحِب رسولَ اللهِ صلَّى اللهُ عليه وسلَّم بصُحبةٍ إلَّا وقد صحِبْتُه مِثْلَها أو أفضلَ ولقد علِمْتَ يا بُنيَّ أنَّ أمَّكَ أسماءَ بنتَ أبي بكرٍ كانت تحتي ولقد علِمْتَ أنَّ عائشةَ بنتَ أبي بكرٍ خالتُك ولقد علِمْتَ أنَّ أمِّي صفيَّةُ بنتُ عبدِ المطَّلبِ وأنَّ أخوالي حمزةُ بنُ عبدِ المُطَّلبِ وأبو طالبٍ والعبَّاسُ وأنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ابنُ خالي ولقد علِمْتَ أنَّ عمَّتي خديجةُ بنتُ خُوَيلدٍ وكانت تحتَه وأنَّ ابنتَها فاطمةُ بنتُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم ولقد علِمْتَ أنَّ أمَّه صلَّى اللهُ عليه وسلَّم آمنةُ بنتُ وهبِ بنِ عبدِ مَنافِ بنِ زُهرةَ وأنَّ أمَّ صفيَّةَ وحمزةَ هالةُ بنتُ وهبِ بنِ عبدِ مَنافِ بنِ زُهرةَ ولقد صحِبْتُه بأحسَنِ صُحبةٍ والحمدُ للهِ ولقد سمِعْتُه صلَّى اللهُ عليه وسلَّم يقولُ : ( ",["مَن قال علَيَّ ما لَمْ أقُلْ ",1],["فلْيتبوَّأْ مَقعدَه مِن النَّارِ )",2]],"grade":"صحيح","narrator":"الزبير بن العوام","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (6982)، والحاكم (5656) بلفظه، والدارمي (239)، والطحاوي في ((شرح مشكل الآثار)) (389) مختصرا.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"jNHPgFuA","merged":8,"otherRefs":["مجمع الزوائد 1/149 (حسن)","تخريج المسند لشعيب 22639 (صحيح)","المستدرك على الصحيحين 384 (صحيح)","تخريج المسند لشعيب 6591 (صحيح)","الصحيح المسند 1336 (حسن)","تخريج المسند لشعيب 22538 (حسن)","تخريج المسند لشاكر 1/232 (صحيح)"]},{"id":"س-03763","fp":"db554ce8a223","stateId":759,"easy":"إذا افتريت على النبي ﷺ ← فتبوأ بيتاً في جهنم","cause":"فمَن عقَل شيئًا فلْيُحَدِّثْ به، ومَنِ افتَرى علَيَّ","result":"فلْيَتبوَّأْ بيتًا، أو مَقعَدًا في جَهنَّمَ","explicit":true,"repOf":"س-08317","ref":"تخريج مشكل الآثار 412","text":["أنَّ وَداعةَ الحَمْديَّ حدَّثهُ: أنَّه كان بجَنْبِ مالِكِ بنِ عُبادةَ أبي موسى الغافِقيِّ، وعُقْبةُ بنُ عامرٍ يَقُصُّ يقولُ: قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقال مالِكٌ: إنَّ صاحبَكم هذا غافلٌ، أو هالِكٌ، إنَّ النَّبيَّ عليه السَّلامُ عهِد إلينا في حَجَّةِ الوَداعِ، فقال: عليكم بالقُرآنِ، وإنَّكم ستَرجِعونَ إلى قومٍ يَشتَهونَ الحديثَ عنِّي، ",["فمَن عقَل شيئًا فلْيُحَدِّثْ به، ومَنِ افتَرى علَيَّ؛ ",1],["فلْيَتبوَّأْ بيتًا، أو مَقعَدًا في جَهنَّمَ",2],"."],"grade":"حسن","narrator":"مالك بن عبادة (أبو موسى الغافقي)","muhaddith":"[فيه] وداعة الحمدي: لم يوثقه غير ابن حبان، وترجم له البخاري وابن أبي حاتم فلم يذكرا فيه جرحا ولا تعديلا، وباقي رجاله ثقات","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار))  (412) والطبراني ((19/ 296)) (658) واللفظ لهما، والدولابي في ((الكنى والأسماء)) (331) باختلاف يسير","bab":"اعتصام بالسنة › نقل السنة وروايتها","dorar":"B1ePxERu"},{"id":"س-03098","fp":"80dbc53da29c","stateId":759,"easy":"إذا كذبت على النبي ﷺ متعمداً ← فتبوأ مضجعك من النار","cause":"مَن كَذَبَ عليَّ كَذبةً مُتَعَمِّدًا","result":"فليَتَبَوَّأ مَضجَعًا مِنَ النَّارِ - أو بَيتًا في جَهَنَّمَ","explicit":true,"repOf":"س-08317","ref":"تخريج المسند لشعيب 15482","text":[["مَن كَذَبَ عليَّ كَذبةً مُتَعَمِّدًا ",1],["فليَتَبَوَّأ مَضجَعًا مِنَ النَّارِ - أو بَيتًا في جَهَنَّمَ -",2],"."],"grade":"صحيح","narrator":"قيس بن سعد بن عبادة","muhaddith":"صحيح لغيره","bab":"إيمان › الوعيد","dorar":"7kKtTdWj","merged":2,"otherRefs":["تخريج المسند لشعيب 11350 (صحيح)"]},{"id":"س-00507","fp":"6f9ff605096f","stateId":759,"easy":"إذا كذبت على النبي ﷺ متعمداً ← فتبوأ مقعدك من النار","cause":"من أدَمٍ في نحوٍ من أربعينَ رجلًا فقال : إنكم مفتوحٌ عليكم منصورونَ ومصيبونَ فمَن أدرَك ذلكَ منكمْ فليتقِ اللهَ وليأمرْ بالمعروفِ وليَنهَ عن المنكرِ وليصلْ رَحِمَه من كذب علَيَّ مُتعمِّدًا","result":"فليتبوأْ مقعدَه من النارِ ومثلُ الذي يُعينُ قومَه على غيرِ الحقِّ كمثلِ بعيرٍ رديٍّ في بئرٍ فهو ينزعُ منها بذَنبِه","explicit":true,"repOf":"س-08317","ref":"تخريج المسند لشاكر 5/306","text":["انتهيت إلى النبيِّ صلَّى اللهُ عليهِ وسلمَ  وهو في قُبَّةٍ حمراءَ قال عبدُ الملكِ : ",["من أدَمٍ في نحوٍ من أربعينَ رجلًا فقال : إنكم مفتوحٌ عليكم منصورونَ ومصيبونَ فمَن أدرَك ذلكَ منكمْ فليتقِ اللهَ وليأمرْ بالمعروفِ وليَنهَ عن المنكرِ وليصلْ رَحِمَه من كذب علَيَّ مُتعمِّدًا ",1],["فليتبوأْ مقعدَه من النارِ ومثلُ الذي يُعينُ قومَه على غيرِ الحقِّ كمثلِ بعيرٍ رديٍّ في بئرٍ فهو ينزعُ منها بذَنبِه",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (3801) واللفظ له، والبزار (2013) مختصراً، وأبو يعلى (5304) باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"2fFiwMmF"},{"id":"س-02575","fp":"d7c61cfb9844","stateId":759,"easy":"إذا كذبت على النبي ﷺ ← يُبنى لك بيت في جهنم","cause":"مَن كَذَبَ عليَّ","result":"بُنِي له بَيْتٌ في جهنَّم","explicit":true,"repOf":"س-08317","ref":"الكبائر للذهبي 154","text":[["مَن كَذَبَ عليَّ ",1],["بُنِي له بَيْتٌ في جهنَّم",2],"."],"grade":"صحيح","narrator":"[أبو قرصافة]","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((الكبير)) (3/ 18) (2516)، والدولابي في ((الكنى والأسماء)) (292)، وابن بشران في ((أماليه-الجزء الأول)) (944) بنحوه تامًا.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"WBncKZH1"},{"id":"س-02931","fp":"25de72e05555","stateId":759,"easy":"إذا قلت في القرآن بغير علم ← تأتي يوم القيامة ملجماً بلجام من نار","cause":"ومَنْ قال في القرآنِ بغيرِ عِلْمٍ","result":"جاء يومَ القيامةِ مُلَجَّمًا بِلِجَامٍ من نارٍ","explicit":true,"ref":"المطالب العالية 3/313","srcLabel":"الطبراني","text":["مَنْ سُئِلَ عن عِلْمٍ فَكَتَمَهُ جاء يومَ القِيامَةَ مُلْجَمًا بِلِجَامٍ من نارٍ ، ",["ومَنْ قال في القرآنِ بغيرِ عِلْمٍ ",1],["جاء يومَ القيامةِ مُلَجَّمًا بِلِجَامٍ من نارٍ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه أبو يعلى (2585)، والطبراني (11/145) (11310)، والخطيب في ((تاريخ بغداد)) (7/406)","bab":"إيمان › الوعيد","dorar":"fJuPyeGb"},{"id":"س-03065","fp":"bdf78505d6b4","stateId":759,"easy":"إذا قلت في القرآن بغير علم ← فتبوأ مقعدك من النار","cause":"مَن قالَ في القُرآنِ بغَيرِ علمٍ","result":"فَليَتبوَّأ مَقعدَهُ منَ النَّارِ","explicit":true,"ref":"سنن الترمذي 2950","srcLabel":"الترمذي","text":[["مَن قالَ في القُرآنِ بغَيرِ علمٍ ، ",1],["فَليَتبوَّأ مَقعدَهُ منَ النَّارِ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"حسن صحيح","takhrij":"أخرجه الترمذي (2950)، والنسائي في ((السنن الكبرى)) (8085)، وأحمد (2069)","bab":"إيمان › الوعيد","dorar":"39HVdaND"},{"id":"س-04226","fp":"1217b31b9c88","stateId":759,"easy":"إذا كذبت على النبي ﷺ ← ففي النار","cause":"من كذب عليَّ","result":"فهو في النَّارِ","explicit":true,"repOf":"س-08317","ref":"مسند الفاروق 2/623","text":["كنَّا إذا قلنا لعمرَ : حدِّثْنا عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم قال : أخافُ أن أزيدَ حرفًا أو أنقُصَ حرفًا ، إنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال : ",["من كذب عليَّ ",1],["فهو في النَّارِ",2]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"غريب من هذا الوجه ، وله طرق عن رسول الله صلى الله عليه وسلم متواترة","takhrij":"أخرجه أحمد (326)، وأبو طاهر السلفي في ((المشيخة البغدادية)) (2681) كلاهما مطولا بلفظه، والعقيلي في ((الضعفاء الكبير)) (2/ 45) بنحوه .","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"zdoA4Nv1"},{"id":"س-04247","fp":"3dfed511bf10","stateId":759,"easy":"إذا كذبت على النبي ﷺ ← فتبوأ بيتك من جهنم","cause":"مَن كذَب علَيَّ","result":"فلْيَتبوَّأْ بيتَهُ مِن جَهنَّمَ، وسمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: الحَريرُ والذَّهَبُ حرامٌ على ذُكورِ أُمَّتي، حِلٌّ لإنَاثِهم","explicit":true,"repOf":"س-08317","ref":"تخريج مشكل الآثار 416","text":["عن هِشامِ بنِ أبي رُقَيَّةَ اللَّخْميِّ، قال سمِعْتُ مَسْلَمةَ بنَ مُخَلَّدٍ، يقولُ لِعُقْبةَ بنِ عامرٍ: قُمْ فحدِّثِ النَّاسَ بما سمِعْتَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقام عُقْبةُ فقال: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن كذَب علَيَّ؛ ",1],["فلْيَتبوَّأْ بيتَهُ مِن جَهنَّمَ، وسمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: الحَريرُ والذَّهَبُ حرامٌ على ذُكورِ أُمَّتي، حِلٌّ لإنَاثِهم",2],"."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (416)، وأحمد (17431) باختلاف يسير، وابن حبان (5436) مختصرا.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"3wkfiYCa"},{"id":"س-04305","fp":"b680cd14b32c","stateId":759,"easy":"إذا قلت على النبي ﷺ ما لم يقل أو ادعيت لغير أبيك ← فتبوأ بيتاً في النار","cause":"مَن يَقُلْ عليَّ ما لم أقُلْ أوِ ادَّعى إلى غَيرِ أبيه وانتَمى إلى غَيرِ مَواليه","result":"فليَتَبَوَّأْ بَينَ عَينَي جَهَنَّمَ مَقعَدًا","explicit":true,"repOf":"س-08317","ref":"يقظة أولي الاعتبار 82","text":[["مَن يَقُلْ عليَّ ما لم أقُلْ أوِ ادَّعى إلى غَيرِ أبيه وانتَمى إلى غَيرِ مَواليه ",1],["فليَتَبَوَّأْ بَينَ عَينَي جَهَنَّمَ مَقعَدًا",2],"، قيل: يا رَسولَ اللهِ، وهَل لها مِن عَينَينِ؟! قال: نَعَم، أمَا سَمِعتُمُ اللَّهَ يَقولُ: {إِذَا رَأَتْهُمْ مِنْ مَكَانٍ بَعِيدٍ}"],"grade":"صحيح","narrator":"رجل من الصحابة","muhaddith":"[صحيح]","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"ljQsicab"},{"id":"س-05077","fp":"953f0c269628","stateId":759,"easy":"إذا كذبت على النبي ﷺ متعمداً ← فتبوأ بيتاً في جهنم","cause":"مَن كذَب علَيَّ مُتعمِّدًا","result":"فلْيتبوَّأْ بيتًا مِن جهنَّمَ ) وسمِعْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم يقولُ : ( رجُلٌ مِن أمَّتي يقومُ مِن اللَّيلِ يُعالِجُ نفسَه إلى الطَّهورِ وعليكم عُقَدٌ فإذا وضَّأ يدَيْهِ انحلَّتْ","explicit":true,"repOf":"س-08317","ref":"تخريج صحيح ابن حبان 1052","text":["لا أقولُ اليومَ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّم ما لَمْ يقُلْ سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ : ( ",["مَن كذَب علَيَّ مُتعمِّدًا ",1],["فلْيتبوَّأْ بيتًا مِن جهنَّمَ ) وسمِعْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم يقولُ : ( رجُلٌ مِن أمَّتي يقومُ مِن اللَّيلِ يُعالِجُ نفسَه إلى الطَّهورِ وعليكم عُقَدٌ فإذا وضَّأ يدَيْهِ انحلَّتْ",2]," عُقدةٌ فإذا وضَّأ وجهَه انحلَّتْ عُقدةٌ وإذا مسَح رأسَه انحلَّتْ عُقدةٌ وإذا وضَّأ رجلَيْهِ انحلَّتْ عُقدةٌ فيقولُ اللهُ جلَّ وعلا للَّذي وراءَ الحجابِ : انظُروا إلى عبدي هذا يُعالِجُ نفسَه لِيسأَلَني ما سأَلني عبدِي هذا فهو له ما سأَلني عبدي هذا فهو له )"],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (17457، 17458) مفرقاً باختلاف يسير، وأبو يعلى (1751) بنحوه دون حديث: \"رجل من أمتي\"، والطبراني (17/305) (843) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ndghLtOP"},{"id":"س-05081","fp":"5ba6a0b0aef8","stateId":759,"easy":"إذا كذبت على النبي ﷺ ← يُبنى لك بيت في النار","cause":"إنَّ الَّذي يَكذِبُ عليَّ","result":"يُبنَى له بَيتٌ في النَّارِ","explicit":true,"repOf":"س-08317","ref":"تخريج المسند لشعيب 5798","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["إنَّ الَّذي يَكذِبُ عليَّ",1]," ",["يُبنَى له بَيتٌ في النَّارِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (5798)، وابن أبي شيبة (26769)، وعبد بن حميد (736)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"aUrpti9h"},{"id":"س-05240","fp":"935d4340bd11","stateId":759,"easy":"إذا حدّثت عن النبي ﷺ ما لم يقل ← فتبوأ بيتاً في النار","cause":"مَن حَدَّث عني ما لم أقُلْ أو قَصَر عن شَيءٍ أمَرْتُ به","result":"فلْيَتبَوَّأْ بيتًا في النَّارِ","explicit":true,"repOf":"س-08317","ref":"الضعفاء الكبير 1/203","text":[["مَن حَدَّث عني ما لم أقُلْ أو قَصَر عن شَيءٍ أمَرْتُ به، ",1],["فلْيَتبَوَّأْ بيتًا في النَّارِ",2],"."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"ثابت من غير هذا الوجه","takhrij":"أخرجه الترمذي في ((العلل الكبير)) (631)، وأبو يعلى (73)، والطبراني في ((الأوسط)) (2838) جميعا بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"vGHrw2uo"},{"id":"س-03027","fp":"0b98496a7c82","stateId":760,"easy":"إذا تحلمت كذباً ← تُكلّف أن تعقد شعيرة","cause":"ومَن تحلَّمَ","result":"كُلِّفَ أنْ يَعقِدَ شَعيرةً","explicit":true,"ref":"تخريج سنن أبي داود 5024","srcLabel":"أبو داود","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قال: مَن صوَّرَ صُورةً عذَّبَه اللهُ بها يومَ القيامةِ حتى يَنفُخَ فيها، وليس بنافِخٍ، ",["ومَن تحلَّمَ",1]," ",["كُلِّفَ أنْ يَعقِدَ شَعيرةً",2],"، ومَن استَمَعَ إلى حَديثِ قَومٍ يَفِرُّون به منه، صُبَّ في أُذُنِه الآنُكُ يومَ القيامةِ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (5024) واللفظ له، وأحمد (1866)، وابن حبان (5685) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"yjg5dgGL","merged":3,"otherRefs":["تخريج المسند لشعيب 1070 (حسن)","صحيح الجامع 6139 (صحيح)"]},{"id":"س-04295","fp":"2a7b4306eaa4","stateId":760,"easy":"إذا حلفت عند المنبر النبوي يميناً آثمة ولو على سواك ← وجبت لك النار","cause":"لا يحلِفُ عندَ هذا المنبرِ عبدٌ ولا أمةٌ على يمينٍ آثمةٍ ولو على سواكٍ رطبٍ","result":"إلَّا وجبت لَهُ النَّارُ","explicit":true,"star":true,"similar":["س-05153","س-00632","س-04993","س-04927"],"ref":"الكبائر للذهبي 231","srcLabel":"البخاري","text":["حديثُ تغليظِ إثْمِ الحالِفِ كاذبًا بعد العَصْرِ [يعني حديث: ثَلَاثَةٌ لا يُكَلِّمُهُمُ اللَّهُ يَومَ القِيَامَةِ، وَلَا يَنْظُرُ إِلَيْهِمْ: رَجُلٌ حَلَفَ علَى سِلْعَةٍ لقَدْ أَعْطَى بهَا أَكْثَرَ ممَّا أَعْطَى، وَهو كَاذِبٌ، وَرَجُلٌ حَلَفَ علَى يَمِينٍ كَاذِبَةٍ بَعْدَ العَصْرِ؛ لِيَقْتَطِعَ بهَا مَالَ رَجُلٍ مُسْلِمٍ، وَرَجُلٌ مَنَعَ فَضْلَ مَاءٍ، فيَقولُ اللَّهُ: اليومَ أَمْنَعُكَ فَضْلِي كما مَنَعْتَ فَضْلَ ما لَمْ تَعْمَلْ يَدَاكَ.]                                   حديثُ تغليظِ إثْمِ الحالِفِ كاذبًا عند مِنْبَر رسولِ اللهِ صلَّى الله عليه وسلَّم. [يعني حديث: ",["لا يحلِفُ عندَ هذا المنبرِ عبدٌ ولا أمةٌ على يمينٍ آثمةٍ ولو على سواكٍ رطبٍ",1]," ",["إلَّا وجبت لَهُ النَّارُ",2],"]"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7446)، وأبو داود (3474)، وأحمد (10226) واللفظ لهم تامًا.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"GBTEmKxm","merged":2,"otherRefs":["معرفة السنن والآثار 20036 (حسن)"]},{"id":"س-00317","fp":"fdfa9ae336ea","stateId":760,"easy":"إذا تحريت الكذب ← تُكتب عند الله كذاباً ويهديك إلى النار","cause":"وإنَّ الكَذِبَ فُجورٌ","result":"وإنَّ الفُجورَ يَهدي إلى النَّارِ، وإنَّ العَبدَ لَيَتَحَرَّى الكَذِبَ حتَّى يُكتَبَ كَذَّابًا","explicit":true,"otherNeedIds":[27],"ref":"صحيح مسلم 2607","srcLabel":"البخاري","text":["إنَّ الصِّدقَ برٌّ، وإنَّ البِرَّ يَهدي إلى الجَنَّةِ، وإنَّ العَبدَ لَيَتَحَرَّى الصِّدقَ حتَّى يُكتَبَ عِندَ اللهِ صِدِّيقًا، ",["وإنَّ الكَذِبَ فُجورٌ",1],"، ",["وإنَّ الفُجورَ يَهدي إلى النَّارِ، وإنَّ العَبدَ لَيَتَحَرَّى الكَذِبَ حتَّى يُكتَبَ كَذَّابًا",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6094) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"iOeH5RT5"},{"id":"س-00417","fp":"6e2b1956d44d","stateId":760,"easy":"إذا ادعيت رؤيا لم ترها ← تُكلّف يوم القيامة أن تعقد بين شعيرتين","cause":"الَّذي يُرِي عينَيْه في المنامِ ما لم يَرَ","result":"يُكلَّفُ يومَ القيامةِ أنْ يعقِدَ بيْنَ شَعيرتينِ","explicit":true,"similar":["س-02950"],"ref":"تخريج صحيح ابن حبان 6057","srcLabel":"البخاري","text":[["الَّذي يُرِي عينَيْه في المنامِ ما لم يَرَ",1]," ",["يُكلَّفُ يومَ القيامةِ أنْ يعقِدَ بيْنَ شَعيرتينِ",2]," والَّذي يستمِعُ حديثَ قومٍ وهم له كارهونَ يُصَبُّ في أُذنِه الآنُكُ يومَ القيامةِ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (7042) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"TlQS3qid"},{"id":"س-02585","fp":"cc8d91fb479e","stateId":760,"easy":"إذا تحلمت حلماً كاذباً ← تُكلّف أن تعقد بين شعيرتين وتُعذب","cause":"ومَن تحلَّم حُلمًا كاذبًا","result":"كُلِّف أنْ يعقِدَ بيْنَ شَعيرتَيْنِ ويُعذَّبُ على ذلك","explicit":true,"similar":["س-02588"],"ref":"تخريج صحيح ابن حبان 5685","srcLabel":"متفق عليه","text":["مَن صوَّر صورةً فإنَّه يُعذَّبُ حتَّى ينفُخَ فيها الرُّوحَ وليس بنافخٍ فيها الرُّوحَ ",["ومَن تحلَّم حُلمًا كاذبًا",1]," ",["كُلِّف أنْ يعقِدَ بيْنَ شَعيرتَيْنِ ويُعذَّبُ على ذلك",2],"، ومَن استمَع إلى قومٍ وهم له كارهون صُبَّ في أُذنَيْه الآنُكُ يومَ القيامةِ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه البخاري (7042)، ومسلم (2110) باختلاف يسير","bab":"إيمان › أعمال تنافي الإيمان","dorar":"GxHcF46d"},{"id":"س-02588","fp":"2158a8be609d","stateId":760,"easy":"إذا تحلمت كاذباً ← تُعذّب حتى تعقد بين طرفي شعيرة ولست بعاقد","cause":"ومَن تحَلَّمَ كاذِبًا","result":"دُفِعَ إليه شَعيرةٌ، وعُذِّبَ حتى يَعقِدَ بَينَ طَرَفَيْها، وليس بعاقِدٍ","explicit":true,"repOf":"س-02585","ref":"تخريج المسند لشعيب 10549","text":["مَن صوَّرَ صورةً؛ عُذِّبَ يَومَ القيامةِ حتى يَنفُخَ فيها الرُّوحَ، وليس بنافِخٍ فيها، ومَنِ استمَعَ إلى حَديثِ قَومٍ ولا يُعجِبُهم أنْ يَستَمِعَ حَديثَهم، أُذيبَ في أُذُنِهِ الآنُكُ، ",["ومَن تحَلَّمَ كاذِبًا",1],"؛ ",["دُفِعَ إليه شَعيرةٌ، وعُذِّبَ حتى يَعقِدَ بَينَ طَرَفَيْها، وليس بعاقِدٍ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه النسائي (5360) مختصراً، وأحمد (10549) واللفظ له. وأخرجه البخاري معلقاً موقوفاً مختصراً بصيغة الجزم بعد حديث (7042)","bab":"إيمان › أعمال تنافي الإيمان","dorar":"9znVjq2s"},{"id":"س-00196","fp":"a0e13b7bf1ee","stateId":760,"easy":"إذا كذبت ← يهديك الكذب إلى الفجور","cause":"الكذبَ","result":"يهدِي إلى الفجورِ","explicit":true,"similar":["س-04223","س-02954"],"ref":"الجامع الصغير 2591","srcLabel":"ابن ماجه","text":["إِنَّما هما اثنتانِ الكلامُ والهديُ ، فأحسنُ الكلامِ كلامُ اللهِ ، وأحسنُ الهدْيِ هديُ محمدٍ ، ألَا وإيَّاكم ومحدَثاتِ الأمورِ ، فإِنَّ شرَّ الأمورِ مُحْدَثاتُها ، وكُلَّ محدَثَةٍ بدعةٌ ، وكُلَّ بِدْعَةٍ ضلالَةٌ ، ألَا لَا يَطولَنَّ عليكم الأمَدُ فتقسو قلوبُكُم ، ألَا إِنَّ كُلَّ ما هو آتٍ قريبٌ ، وإِنَّما البعيدُ ما ليس بآتٍ ، ألَا إِنَّما الشَّقِيُّ مَنْ شقِيَ في بطنِ أُمِّهِ ، والسعيدُ مَنْ وُعِظَ بِغَيْرِهِ ، ألَا إِنَّ قتالَ المؤمِنِ كفْرٌ ، وسبابَهُ فسوقٌ ، ولَا يَحِلُ لمسلِمٍ أنْ يهجُرَ أخاهُ فوقَ ثلاثٍ ، ألَا وإيَّاكم و",["الكذبَ",1]," ، فإِنَّ الكذبَ لا يصلُحُ لَا بالجدِّ ، ولَا بالْهَزْلِ ، ولَا يعِدُ الرجلُ صَبِيَّهُ ولَا يفِي ، وإِنَّ الكذِبَ ",["يهدِي إلى الفجورِ",2]," ، وإِنَّ الفجورَ يهدي إلى النارِ ، وإِنَّ الصدقَ يهدي إلى البرِ ، وإِنَّ البرَّ يهدي إلى الجنَّةِ ، وإِنَّه يقالُ للصادقِ : صدقَ وبَرَّ ، ويقالُ للكاذِبِ : كذَبَ وفجرَ ، ألَا وإِنَّ العبدَ يكذِبُ حتى يُكْتَبَ عندَ اللهِ كذابًا"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (46) واللفظ له، والطبراني (9/99) (8520) باختلاف يسير، والبيهقي في ((شعب الإيمان)) (4787) مختصراً باختلاف يسير","bab":"آداب الكلام › الصدق وما جاء فيه","dorar":"UhkJzNNf","merged":11,"otherRefs":["بدائع الفوائد 1/68 (صحيح)","الأحاديث المختارة 67 (صحيح)","شفاء العليل 1/105 (صحيح)","صحيح الأدب المفرد 298 (صحيح)","المستدرك على الصحيحين 445 (صحيح)","تخريج المسند لشاكر 1/31 (صحيح)","تخريج المسند لشاكر 1/38 (صحيح)","تخريج المسند لشاكر 1/41 (صحيح)","صحيح الأدب المفرد 557 (صحيح)","شرح ثلاثيات المسند 1/234 (حسن)"]},{"id":"س-05153","fp":"18176b0761b7","stateId":760,"easy":"إذا حلفت على المنبر النبوي يميناً آثمة ← فتبوأ مقعدك من النار","cause":"مَن حَلَف على مِنبَري هذا على يَمينٍ آثِمةٍ","result":"فليَتبَوَّأْ مَقعَدَه منَ النَّارِ","explicit":true,"repOf":"س-04295","ref":"المستدرك على الصحيحين 8020","text":[["مَن حَلَف على مِنبَري هذا على يَمينٍ آثِمةٍ ",1],["فليَتبَوَّأْ مَقعَدَه منَ النَّارِ -",2],"أو قالَ: إلَّا وَجَبَت له النَّارُ-، ولو على سِواكٍ أخضَرَ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح الإسناد","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"UBbGS5bs","merged":4,"otherRefs":["المحلى 8/37 (صحيح)","تخريج المسند لشعيب 19912 (صحيح)","تخريج سنن أبي داود 3242 (صحيح)"]},{"id":"س-02950","fp":"3b12c8290b16","stateId":760,"easy":"إذا ادعيت رؤيا لم ترها ← تُكلّف أن تعقد شعيرة","cause":"و منْ أَرَى عينيهِ في المنامِ ما لمْ يرَ","result":"كُلِّفُ أنْ يعقدَ شعيرةً","explicit":true,"repOf":"س-00417","ref":"الجامع الصغير 8407","text":["من استمعَ إلى حديثَ قومٍ،  و همْ لهُ كارهونَ،  صُبَّ في أذنيهِ الآنُكُ،  ",["و منْ أَرَى عينيهِ في المنامِ ما لمْ يرَ",1]," ",["كُلِّفُ أنْ يعقدَ شعيرةً",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن","takhrij":"أخرجه الطبراني (11/248) (11637) باختلاف يسير، وأخرجه البخاري (7042) بنحوه","bab":"إيمان › الوعيد","dorar":"ZgG06Mm9"},{"id":"س-05014","fp":"deb6403a7600","stateId":760,"easy":"إذا مكرت وخدعت ← فالمكر والخديعة في النار","cause":"المكرُ و الخَديعةُ","result":"في النَّارِ","explicit":true,"ref":"صحيح الجامع 6725","srcLabel":"ابن عدي","text":[["المكرُ و الخَديعةُ",1]," ",["في النَّارِ",2]],"grade":"صحيح","narrator":"قيس بن سعد","muhaddith":"صحيح","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (2/161) مطولاً، والديلمي في ((الفردوس)) (6658) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"bHpx61Mf","merged":3,"otherRefs":["صحيح الجامع 6726 (حسن)","فتح الباري لابن حجر 4/417 (حسن)"]},{"id":"س-02925","fp":"27afd3f530ff","stateId":760,"easy":"إذا كذبت في حلمك ← تُكلّف يوم القيامة عقد شعيرة","cause":"مَنْ كَذَبَ فِي حُلْمِهِ","result":"كُلِّفَ يَوْمَ القيامَةِ عقْدَ شعيرةٍ","explicit":true,"ref":"صحيح الجامع 6520","srcLabel":"صحيح الجامع","text":[["مَنْ كَذَبَ فِي حُلْمِهِ ، ",1],["كُلِّفَ يَوْمَ القيامَةِ عقْدَ شعيرةٍ",2]],"grade":"صحيح","narrator":"علي بن أبي طالب وعبدالله بن عباس","muhaddith":"صحيح","bab":"إيمان › الوعيد","dorar":"rgvTouZx","merged":2,"otherRefs":["تخريج المسند لشعيب 1088 (حسن)"]},{"id":"س-05147","fp":"c50f07ed136c","stateId":760,"easy":"إذا شهدت زوراً ← لا تزول قدماك حتى يوجب الله لك النار","cause":"شاهِدُ الزُّورِ لا تَزولُ قَدَماهُ","result":"حتَّى يُوجِبَ اللهُ لهما النَّارَ","explicit":true,"similar":["س-02935","س-04908"],"ref":"المستدرك على الصحيحين 7238","srcLabel":"الطبراني","text":[["شاهِدُ الزُّورِ لا تَزولُ قَدَماهُ ",1],["حتَّى يُوجِبَ اللهُ لهما النَّارَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني  (13/ 131)، (13802) بلفظه، والحار ث بن أبي أسامة كما في ((بغية الباحث)) للهيثمي (465)، وأبو يعلى الموصلي (5672) كلاهما بزيادة في لفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"4IkEmkCU","merged":2,"otherRefs":["الترغيب والترهيب 3/227 (صحيح)"]},{"id":"س-00632","fp":"0bb0b338f0a4","stateId":760,"easy":"إذا حلفت على منبر النبي ﷺ يميناً آثمة ← وجبت لك النار ولو على قضيب أراك","cause":"من حلفَ على منبري بيمينٍ آثِمةٍ","result":"وجبت له النار وإن كانَ قضيبًا من أراكٍ","explicit":true,"repOf":"س-04295","ref":"المحلى 9/497","text":[["من حلفَ على منبري بيمينٍ آثِمةٍ ",1],["وجبت له النار وإن كانَ قضيبًا من أراكٍ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"آداب عامة › ضرب الأمثال","dorar":"G8ZqIjHC"},{"id":"س-02935","fp":"de33c54a4718","stateId":760,"easy":"إذا شهدت زوراً ← لا تفارق قدماك الأرض حتى تُقذف في النار","cause":"شاهدُ الزُّورِ","result":"ولا تفارقُ قدماه على الأرضِ حتَّى يُقذفَ به في النَّارِ","explicit":true,"repOf":"س-05147","ref":"الترغيب والترهيب 3/227","text":["إنَّ الطَّيرَ لتضرِبُ بمناقيرِها وتُحرِّك أذنابِها من هولِ يومِ القيامةِ وما يتكلَّمُ به ",["شاهدُ الزُّورِ",1]," ",["ولا تفارقُ قدماه على الأرضِ حتَّى يُقذفَ به في النَّارِ",2]],"grade":"صحيح","narrator":"[عبدالله بن عمر]","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((الأوسط)) (7616)، وابن المقريء في ((معجمه)) (1304)، والعقيلي في ((الضعفاء)) (6440) واللفظ لهم.","bab":"إيمان › الوعيد","dorar":"oQjYTAuE"},{"id":"س-02936","fp":"0853e6c52322","stateId":760,"easy":"إذا كنت ذا وجهين في الدنيا ← تأتي يوم القيامة ولك وجهان من نار","cause":"ذو الوجهَيْن في الدُّنيا","result":"يأتي يومَ القيامةِ ، وله وجهان من نارٍ","explicit":true,"ref":"الترغيب والترهيب 4/57","srcLabel":"الطبراني","text":[["ذو الوجهَيْن في الدُّنيا",1]," ",["يأتي يومَ القيامةِ ، وله وجهان من نارٍ",2]],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((الأوسط)) (6278) بلفظه.","bab":"إيمان › الوعيد","dorar":"US0urbA2"},{"id":"س-02990","fp":"3152537433f2","stateId":760,"easy":"إذا كان لك وجهان في الدنيا ← يكون لك يوم القيامة لسانان من نار","cause":"مَنْ كان لهُ وجْهانِ في الدنيا","result":"كان لهُ يومَ القيامةِ لِسانانِ من نارٍ","explicit":true,"ref":"صحيح الترغيب 2949","srcLabel":"أبو داود","text":[["مَنْ كان لهُ وجْهانِ في الدنيا ؛ ",1],["كان لهُ يومَ القيامةِ لِسانانِ من نارٍ",2]],"grade":"صحيح","narrator":"عمار بن ياسر","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (4873) واللفظ له، والدارمي (2764)، وأبو يعلى (1620).","bab":"إيمان › الوعيد","dorar":"me9z3Vlu"},{"id":"س-02992","fp":"c263bbc35094","stateId":760,"easy":"إذا كنت ذا لسانين ← يجعل الله لك يوم القيامة لسانين من نار","cause":"من كان ذا لسانَين","result":"جعل اللهُ له يومَ القيامةِ لسانَين من نارٍ","explicit":true,"ref":"صحيح الترغيب 2950","srcLabel":"الطبراني","text":[["من كان ذا لسانَين ؛ ",1],["جعل اللهُ له يومَ القيامةِ لسانَين من نارٍ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن أبي الدنيا في ((ذم الغيبة والنميمة)) (144)، وابن أبي عاصم في ((الزهد)) (217)، والطبراني في ((المعجم الأوسط)) (8885) واللفظ له","bab":"إيمان › الوعيد","dorar":"9a1TOqcu"},{"id":"س-04223","fp":"b62df9293922","stateId":760,"easy":"إذا كذبت ← فجرت، وإذا فجرت كفرت، وإذا كفرت دخلت النار","cause":"الكذِبُ إذا كذَبَ العبدُ فجَرَ ، وإذا فجرَ كفَرَ","result":"وإذا كفَرَ دخلَ","explicit":true,"repOf":"س-00196","otherNeedIds":[22],"ref":"تخريج المسند لشاكر 10/126","text":["أنَّ رجلًا جاءَ إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ : يا رسولَ اللَّهِ ما عَملُ الجنَّةِ ؟ قالَ : الصِّدقُ ، وإذا صدَقَ العبدُ بَرَّ ، وإذا بَرَّ آمَنَ ، وإذا آمَنَ دخلَ الجنَّةَ ، قالَ : يا رسولَ اللَّهِ ، ما عمَلُ النَّارِ ؟ قالَ : ",["الكذِبُ إذا كذَبَ العبدُ فجَرَ ، وإذا فجرَ كفَرَ",1]," ، ",["وإذا كفَرَ دخلَ",2]," يعني النَّارَ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو يعلى كما في ((إتحاف الخيرة المهرة)) للبوصيري (6/85) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"DAP2yanO"},{"id":"س-04908","fp":"46a042ff7a46","stateId":760,"easy":"إذا شهدت زوراً ← تجب لك النار","cause":"شاهِدِ الزُّورِ","result":"حتى تَجِبَ له النَّارُ","explicit":true,"repOf":"س-05147","ref":"الكبائر للذهبي 198","text":["لا تزولُ قَدَما ",["شاهِدِ الزُّورِ",1]," يَوْمَ القيامَةِ ",["حتى تَجِبَ له النَّارُ",2],"."],"grade":"صحيح","narrator":"[عبدالله بن عمر]","muhaddith":"ثابت","takhrij":"أخرجه ابن ماجة (2373)، والحاكم (7042)، والطبراني في ((الأوسط)) (8367) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"hQotduK7"},{"id":"س-04993","fp":"908665cae09c","stateId":760,"easy":"إذا حلفت عند المنبر النبوي على يمين آثمة ولو على سواك ← تبوأت مقعدك من النار","cause":"لا يحلِفُ أحدٌ عندَ منبري هذا على يمينٍ آثِمةٍ ، ولو على سِواكٍ أخضرَ","result":"إلَّا تبوَّأَ مقعدَه منَ النَّارِ","explicit":true,"repOf":"س-04295","ref":"الصحيح المسند 206","text":[["لا يحلِفُ أحدٌ عندَ منبري هذا على يمينٍ آثِمةٍ ، ولو على سِواكٍ أخضرَ",1]," ",["إلَّا تبوَّأَ مقعدَه منَ النَّارِ",2]," أو وجبَت لَه النَّارُ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"6vevjhhS"},{"id":"س-02951","fp":"f3908d0476f0","stateId":760,"easy":"إذا شهدت شهادة يُستباح بها مال مسلم أو دمه ← فقد أوجبت النار","cause":"منْ شَهِدَ شهادةً يُستباحُ بها مَالُ امرئٍ مسلمٍ، أوْ يسفِكُ بها دمًا","result":"فقدْ أوجَبَ النارَ","explicit":true,"ref":"الجامع الصغير 8754","srcLabel":"الطبراني","text":[["منْ شَهِدَ شهادةً يُستباحُ بها مَالُ امرئٍ مسلمٍ،  أوْ يسفِكُ بها دمًا،  ",1],["فقدْ أوجَبَ النارَ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن","takhrij":"أخرجه الحارث في ((المسند)) (464)، وأبو يعلى (2751) مطولاً باختلاف يسير، والطبراني (11/216) (11541) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"IwmCW44Z","merged":2,"otherRefs":["النوافح العطرة 387 (حسن)"]},{"id":"س-02954","fp":"7ef79da69056","stateId":760,"easy":"إذا كذبت ← فالكذب عمل النار","cause":"الكذبُ","result":"و عملُ النارِ","explicit":true,"repOf":"س-00196","ref":"الجامع الصغير 5599","text":["عملُ الجنةِ الصدقُ، و إذا صدقَ العبدُ برَّ، و إذا برَّ آمنَ، و إذا آمنَ دخلَ الجنةَ، ",["و عملُ النارِ",2]," ",["الكذبُ",1],"، و إذا كذبَ العبدُ فجرَ، و إذا فجرَ كفرَ، و إذا كفرَ دخلَ النارَ"],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن","takhrij":"أخرجه أحمد (6641) واللفظ له.","bab":"إيمان › الوعيد","dorar":"Bd26lIOj"},{"id":"س-04828","fp":"6dfc2c9bb650","stateId":760,"easy":"إذا شهدت على مسلم شهادة لست لها أهلاً ← فتبوأ مقعدك من النار","cause":"من شَهِدَ علَى مسلِمٍ شَهادةً ليسَ لَها بأهْلٍ","result":"فليتبوَّأ مقعدَه من النَّارِ","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 2/193","srcLabel":"الزواجر عن اقتراف الكبائر","text":["عن ابنِ مسعودٍ قالَ : ",["من شَهِدَ علَى مسلِمٍ شَهادةً ليسَ لَها بأهْلٍ ",1],["فليتبوَّأ مقعدَه من النَّارِ",2]],"grade":"حسن","muhaddith":"إسناده حسن","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"7ZxthUFe"},{"id":"س-04927","fp":"66e2a68f31da","stateId":760,"easy":"إذا حلفت عند المنبر النبوي يميناً كاذبة تستحق بها مالاً ← يدخلك الله النار","cause":"أيُّما امْرئٍ مِن النَّاسِ حَلَفَ عِندَ مِنبَري هذا على يَمينٍ كاذِبةٍ يَستَحِقُّ بها حقَّ مُسلِمٍ","result":"أدخَلَه اللهُ النَّارَ، وإنْ على سِواكٍ أخضَرَ","explicit":true,"repOf":"س-04295","ref":"تخريج المسند لشعيب 15024","text":[["أيُّما امْرئٍ مِن النَّاسِ حَلَفَ عِندَ مِنبَري هذا على يَمينٍ كاذِبةٍ يَستَحِقُّ بها حقَّ مُسلِمٍ ",1],["أدخَلَه اللهُ النَّارَ، وإنْ على سِواكٍ أخضَرَ",2],"."],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"قوي","takhrij":"أخرجه أبو داود (3246)، وابن ماجه (2325) باختلاف يسير، وأحمد (15024) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"OjT9vqbn"},{"id":"س-04794","fp":"ee080a54f881","stateId":760,"easy":"إذا حلفت كاذباً في البيع ← فقد أوجبت على نفسك (الإثم)","cause":"يَتَبايَعَانِ شَاةً يَتَحالَفَانِ","result":"قد أوْجَبَ أحدَهُما","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[13],"ref":"تعجيل المنفعة 1/774","srcLabel":"ابن أبي خيثمة","text":["أنَّ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ مَرَّ بِرَجُلَيْنِ ",["يَتَبايَعَانِ شَاةً يَتَحالَفَانِ",1]," ، ثُمَّ مَرَّ بِالشَّاةِ وقد اشْتَرَاها الرجلُ ، فقال : ",["قد أوْجَبَ أحدَهُما",2]],"grade":"حسن","narrator":"ناسج الحضرمي","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن أبي خيثمة في ((التاريخ الكبير))، والخرائطي في ((مساوئ الأخلاق)) (112)، وابن سمعون في ((الأمالي)) (147)، والمخلص في ((المخلصيات)) (2359) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"vTQFp0xg"},{"id":"س-00206","fp":"7191d1c7f360","stateId":760,"easy":"إذا حدّثت بالكذب لتضحك القوم ← فويل لك ثم ويل لك","cause":"لَّذي يُحدِّثُ بالحديثِ ليُضحِكَ به القومَ فيكذِبُ ، ويلٌ له ، ويلٌ له","result":"ويلٌ ل","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"الترغيب والترهيب 4/56","srcLabel":"أبو داود","text":[["ويلٌ ل",2],["لَّذي يُحدِّثُ بالحديثِ ليُضحِكَ به القومَ فيكذِبُ ، ويلٌ له ، ويلٌ له",1]],"grade":"صحيح","narrator":"معاوية بن حيدة القشيري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (4990)، والترمذي (2315) واللفظ له، والنسائي في ((السنن الكبرى)) (11126)، وأحمد (20046).","bab":"آداب الكلام › المزاح والمداعبة","dorar":"bwhB14LN","merged":3,"otherRefs":["الجامع الصغير 9629 (صحيح)","تخريج المسند لشعيب 20021 (حسن)"]},{"id":"ق-1422","fp":"036d88f5c9b7","stateId":761,"easy":"السخرية بالمؤمنين ← يضحك منهم المؤمنون يوم القيامة","cause":"السخرية بالمؤمنين","result":"يضحك منهم المؤمنون يوم القيامة","explicit":true,"ref":"سورة المطففين: 29–36","srcLabel":"القرآن الكريم","quran":{"s":83,"from":29,"to":36,"text":"إِنَّ الَّذِينَ أَجْرَمُوا كَانُوا مِنَ الَّذِينَ آمَنُوا يَضْحَكُونَ (29) وَإِذَا مَرُّوا بِهِمْ يَتَغَامَزُونَ (30) وَإِذَا انْقَلَبُوا إِلَى أَهْلِهِمُ انْقَلَبُوا فَكِهِينَ (31) وَإِذَا رَأَوْهُمْ قَالُوا إِنَّ هَؤُلَاءِ لَضَالُّونَ (32) وَمَا أُرْسِلُوا عَلَيْهِمْ حَافِظِينَ (33) فَالْيَوْمَ الَّذِينَ آمَنُوا مِنَ الْكُفَّارِ يَضْحَكُونَ (34) عَلَى الْأَرَائِكِ يَنْظُرُونَ (35) هَلْ ثُوِّبَ الْكُفَّارُ مَا كَانُوا يَفْعَلُونَ (36)","hl":[[0,434,1]]}},{"id":"س-05121","fp":"c609cdb999ea","stateId":761,"easy":"إذا قذفت مملوكك بزنا وهو بريء ← يُقام عليك الحد يوم القيامة","cause":"مَن قذَف مملوكَهُ بزِنًا بَريئًا مِمَّا قال","result":"أقام عليه الحدَّ يومَ القِيامةِ","explicit":true,"star":true,"ref":"تخريج مشكل الآثار 192","srcLabel":"متفق عليه","text":["ثمَّ ذكَر بإسنادِهِ مِثْلَهُ، ولمْ يَقُلْ: بزِنًا، [يعني حديثَ: قال أبو القاسِمِ نبيُّ التَّوبةِ صلَّى اللهُ عليه وسلَّمَ: ",["مَن قذَف مملوكَهُ بزِنًا بَريئًا مِمَّا قال",1],"، ",["أقام عليه الحدَّ يومَ القِيامةِ",2],"، إلَّا أنْ يكونَ كما قال.]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح رجاله رجال الشيخين غير سويد بن نصر وهو ثقة","takhrij":"أخرجه الطحاوي في  ((شرح مشكل الآثار)) (191) واللفظ له، والبخاري (6858)، ومسلم (1660) كلاهما باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"qtNNe2K8","merged":6,"otherRefs":["تخريج المسند لشعيب 9567 (صحيح)","تخريج مشكل الآثار 190 (صحيح)","تخريج سنن الدارقطني 3126 (حسن)","صحيح الجامع 6463 (صحيح)","السنن الصغير للبيهقي 3/305 (صحيح)"]},{"id":"س-00418","fp":"d001222a923f","stateId":761,"easy":"إذا استمعت إلى حديث قوم وهم كارهون ← يُصب في أذنك الرصاص المذاب يوم القيامة","cause":"والَّذي يستمِعُ حديثَ قومٍ وهم له كارهونَ","result":"يُصَبُّ في أُذنِه الآنُكُ يومَ القيامةِ","explicit":true,"similar":["س-02587","س-03028"],"ref":"تخريج صحيح ابن حبان 6057","srcLabel":"البخاري","text":["الَّذي يُرِي عينَيْه في المنامِ ما لم يَرَ يُكلَّفُ يومَ القيامةِ أنْ يعقِدَ بيْنَ شَعيرتينِ ",["والَّذي يستمِعُ حديثَ قومٍ وهم له كارهونَ",1]," ",["يُصَبُّ في أُذنِه الآنُكُ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (7042) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"TlQS3qid"},{"id":"س-02587","fp":"9607fac8ec11","stateId":761,"easy":"إذا استمعت إلى حديث قوم لا يعجبهم ← يُذاب في أذنك الرصاص","cause":"ومَنِ استمَعَ إلى حَديثِ قَومٍ ولا يُعجِبُهم أنْ يَستَمِعَ حَديثَهم","result":"أُذيبَ في أُذُنِهِ الآنُكُ","explicit":true,"repOf":"س-00418","ref":"تخريج المسند لشعيب 10549","text":["مَن صوَّرَ صورةً؛ عُذِّبَ يَومَ القيامةِ حتى يَنفُخَ فيها الرُّوحَ، وليس بنافِخٍ فيها، ",["ومَنِ استمَعَ إلى حَديثِ قَومٍ ولا يُعجِبُهم أنْ يَستَمِعَ حَديثَهم",1],"، ",["أُذيبَ في أُذُنِهِ الآنُكُ",2],"، ومَن تحَلَّمَ كاذِبًا؛ دُفِعَ إليه شَعيرةٌ، وعُذِّبَ حتى يَعقِدَ بَينَ طَرَفَيْها، وليس بعاقِدٍ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه النسائي (5360) مختصراً، وأحمد (10549) واللفظ له. وأخرجه البخاري معلقاً موقوفاً مختصراً بصيغة الجزم بعد حديث (7042)","bab":"إيمان › أعمال تنافي الإيمان","dorar":"9znVjq2s"},{"id":"س-04953","fp":"c16ae948912b","stateId":761,"easy":"إذا قذفت عبدك بحد ← يُقام عليك يوم القيامة","cause":"مَن قذَفَ عبدَه بحَدٍّ","result":"أُقيمَ عليه يومَ القيامةِ","explicit":true,"ref":"تخريج سنن الدارقطني 3123","srcLabel":"متفق عليه","text":[["مَن قذَفَ عبدَه بحَدٍّ ",1],["أُقيمَ عليه يومَ القيامةِ",2],"، إلَّا أنْ يَكونَ كذلك."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الدارقطني (3123) بلفظه، والترمذي (1947) بلفظ مقارب، والبخاري (6858)، ومسلم (1660) كلاهما بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"t8eRDCOd"},{"id":"س-05478","fp":"5335d65ceba8","stateId":761,"easy":"إذا اكتسيت بالنيل من مسلم ← يكسوك الله من جهنم","cause":"و من كسى برجلٍ مسلمٍ","result":"فإنَّ اللهَ عزَّ وجلَّ يكسوه من جهنَّمَ","explicit":true,"similar":["س-05502","س-05495","س-05497","س-05503"],"ref":"صحيح الأدب المفرد 179","srcLabel":"البخاري","text":["من أكل بمسلمٍ أكلةً فإنَّ اللهَ يُطعِمُه مثلَها من جهنَّمَ ، ",["و من كسى برجلٍ مسلمٍ",1]," ، ",["فإنَّ اللهَ عزَّ وجلَّ يكسوه من جهنَّمَ",2]," ، و من قام برجلٍ مسلمٍ مقامَ رياءٍ و سُمعةٍ ؛ فإنَّ اللهَ يقوم به مَقامَ رياءٍ و سُمعةٍ يومَ القيامةِ"],"grade":"صحيح","narrator":"المستورد بن شداد","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4881)، وأحمد (18011) باختلاف يسير، والبخاري في ((الأدب المفرد)) (240) واللفظ له.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"q49Z61vr"},{"id":"س-00421","fp":"6a6d2272cb8b","stateId":761,"easy":"إذا أتيت بصلاة وصيام وزكاة وقد شتمت وقذفت وأكلت مال الناس ← تُعطى حسناتك لهم ثم تُطرح في النار","cause":"يأتي بصلاةٍ وصيامٍ وزكاةٍ، ويأتي قد شتَمَ عِرْضَ هذا، وقذَفَ هذا، وأكَلَ مالَ هذا، وضرَبَ هذا","result":"فيُقعَدُ فيَقتَصُّ هذا مِن حَسناتِه، وهذا مِن حَسناتِه، فإنْ فنِيَتْ حَسناتُه قبلَ أنْ يُقضَى ما عليه، أُخِذَ مِن خطاياهم، فطُرِحَ عليه، ثمَّ طُرِحَ في النَّارِ","explicit":true,"otherNeedIds":[52],"ref":"تخريج المسند لشعيب 8414","srcLabel":"مسلم","text":["أَتَدرونَ مَنِ المُفلِسُ؟ قالوا: المُفلِسُ فينا يا رسولَ اللهِ مَن لا دِرْهَمَ له ولا مَتاعَ، قال: المُفلِسُ مِن أُمَّتي يومَ القِيامةِ مَن ",["يأتي بصلاةٍ وصيامٍ وزكاةٍ، ويأتي قد شتَمَ عِرْضَ هذا، وقذَفَ هذا، وأكَلَ مالَ هذا، وضرَبَ هذا",1],"، ",["فيُقعَدُ فيَقتَصُّ هذا مِن حَسناتِه، وهذا مِن حَسناتِه، فإنْ فنِيَتْ حَسناتُه قبلَ أنْ يُقضَى ما عليه، أُخِذَ مِن خطاياهم، فطُرِحَ عليه، ثمَّ طُرِحَ في النَّارِ",2],". وقال عبدُ الرحمنِ -يعني ابنَ مَهْديٍّ-: فيُقَصُّ، وقال عبدُ الرحمنِ: قبلَ أنْ يَقْضي ما عليه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2581)، والترمذي (2418)، وأحمد (8414) واللفظ له","bab":"آداب عامة › الأخلاق المذمومة","dorar":"ahFo9eHU"},{"id":"س-03028","fp":"536ac1b42668","stateId":761,"easy":"إذا استمعت إلى حديث قوم يفرون منك ← يُصب في أذنك الرصاص يوم القيامة","cause":"ومَن استَمَعَ إلى حَديثِ قَومٍ يَفِرُّون به منه","result":"صُبَّ في أُذُنِه الآنُكُ يومَ القيامةِ","explicit":true,"repOf":"س-00418","ref":"تخريج سنن أبي داود 5024","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قال: مَن صوَّرَ صُورةً عذَّبَه اللهُ بها يومَ القيامةِ حتى يَنفُخَ فيها، وليس بنافِخٍ، ومَن تحلَّمَ كُلِّفَ أنْ يَعقِدَ شَعيرةً، ",["ومَن استَمَعَ إلى حَديثِ قَومٍ يَفِرُّون به منه",1],"، ",["صُبَّ في أُذُنِه الآنُكُ يومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (5024) واللفظ له، وأحمد (1866)، وابن حبان (5685) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"yjg5dgGL","merged":6,"otherRefs":["تخريج صحيح ابن حبان 5685 (صحيح)","الجامع الصغير 8407 (حسن)","تخريج المسند لشاكر 5/130 (صحيح)","صحيح الأدب المفرد 883 (صحيح)","صحيح الجامع 6370 (صحيح)"]},{"id":"ق-0517","fp":"154611ac63a2","stateId":761,"easy":"السخرية من المتصدقين ← سخرية الله منهم وعذاب أليم","cause":"السخرية من المتصدقين","result":"سخرية الله منهم وعذاب أليم","explicit":true,"ref":"سورة التوبة: 79","srcLabel":"القرآن الكريم","quran":{"s":9,"from":79,"to":79,"text":"الَّذِينَ يَلْمِزُونَ الْمُطَّوِّعِينَ مِنَ الْمُؤْمِنِينَ فِي الصَّدَقَاتِ وَالَّذِينَ لَا يَجِدُونَ إِلَّا جُهْدَهُمْ فَيَسْخَرُونَ مِنْهُمْ سَخِرَ اللَّهُ مِنْهُمْ وَلَهُمْ عَذَابٌ أَلِيمٌ (79)","hl":[[0,191,1]]}},{"id":"ق-1459","fp":"57a2b70cf911","stateId":761,"easy":"الهمز واللمز وجمع المال وتعديده ظناً أنه يخلّده ← الويل والنبذ في الحطمة","cause":"الهمز واللمز وجمع المال وتعديده ظناً أنه يخلّده","result":"الويل والنبذ في الحطمة","explicit":true,"ref":"سورة الهمزة: 1–9","srcLabel":"القرآن الكريم","quran":{"s":104,"from":1,"to":9,"text":"وَيْلٌ لِكُلِّ هُمَزَةٍ لُمَزَةٍ (1) الَّذِي جَمَعَ مَالًا وَعَدَّدَهُ (2) يَحْسَبُ أَنَّ مَالَهُ أَخْلَدَهُ (3) كَلَّا لَيُنْبَذَنَّ فِي الْحُطَمَةِ (4) وَمَا أَدْرَاكَ مَا الْحُطَمَةُ (5) نَارُ اللَّهِ الْمُوقَدَةُ (6) الَّتِي تَطَّلِعُ عَلَى الْأَفْئِدَةِ (7) إِنَّهَا عَلَيْهِمْ مُؤْصَدَةٌ (8) فِي عَمَدٍ مُمَدَّدَةٍ (9)","hl":[[0,320,1]]}},{"id":"س-00433","fp":"f862962423c4","stateId":761,"easy":"إذا شنت مسلماً بكلمة بغير حق ← يشينك الله بها في النار يوم القيامة","cause":"مَن شانَ على مُسلِمٍ كَلمةً يُشينُهُ بها بغيرِ حقٍّ","result":"أشانَهُ اللهُ بها في النَّارِ يومَ القيامةِ","explicit":true,"ref":"المستدرك على الصحيحين 8106","srcLabel":"ابن أبي الدنيا","text":[["مَن شانَ على مُسلِمٍ كَلمةً يُشينُهُ بها بغيرِ حقٍّ، ",1],["أشانَهُ اللهُ بها في النَّارِ يومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"أبو ذر","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن أبي الدنيا في ((ذم الغيبة والنميمة)) (120)، وأبو الشيخ في ((التوبيخ والتنبيه)) (138) واللفظ لهما.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"FD4GEbOb","merged":2,"otherRefs":["الجامع الصغير 8420 (حسن)"]},{"id":"س-05085","fp":"01a9e23f42f6","stateId":761,"easy":"إذا قلت في مؤمن ما ليس فيه ← يسكنك الله ردغة الخبال حتى تخرج مما قلت","cause":"ومَن قال في مؤْمِنٍ ما ليس فيه","result":"أَسْكَنَه اللهُ رَدْغةَ الخَبَالِ حتى يَخرُجَ ممَّا قالَ","explicit":true,"ref":"تخريج المسند لشعيب 5385","srcLabel":"أبو داود","text":["خرَجْنا حُجَّاجًا عَشَرةً مِن أهلِ الشَّامِ، حتى أَتَيْنا مكَّةَ، فذَكَر الحديثَ، قال: فأَتَيْناهُ، فخَرَج إلينا -يعني: ابنَ عُمرَ، فقال: سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقول: مَن حالَتْ شَفاعَتُه دُونَ حدٍّ مِن حُدودِ اللهِ عزَّ وجلَّ، فقد ضادَّ اللهَ أَمْرَه، ومَن مات وعليه دَيْنٌ، فليس بالدِّينارِ ولا بالدِّرهمِ، ولكنَّها الحسَناتُ والسَّيِّئاتُ، ومَن خاصَمَ في باطِلٍ وهو يَعْلَمُه، لم يَزَلْ في سَخَطِ اللهِ حتى يَنزِعَ، ",["ومَن قال في مؤْمِنٍ ما ليس فيه، ",1],["أَسْكَنَه اللهُ رَدْغةَ الخَبَالِ حتى يَخرُجَ ممَّا قالَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3597)، وأحمد (5385) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"jwOzDMmj","merged":2,"otherRefs":["السلسلة الصحيحة 437 (صحيح)"]},{"id":"س-05502","fp":"9dbf5575ae1a","stateId":761,"easy":"إذا أكلت برجل مسلم أكلة (بالنيل منه) ← يطعمك الله مثلها من جهنم","cause":"مَنْ أكل برَجلٍ مُسلمٍ أكْلَةً","result":"فإنَّ اللهَ يُطعِمُهُ مِثلَها من جهنَّمَ","explicit":true,"repOf":"س-05478","ref":"صحيح الجامع 6083","text":[["مَنْ أكل برَجلٍ مُسلمٍ أكْلَةً ، ",1],["فإنَّ اللهَ يُطعِمُهُ مِثلَها من جهنَّمَ ، ",2],"ومَنِ اكْتسَى برَجلٍ مُسلمٍ ثوْبًا ، فإنَّ اللهَ يَكسُوهُ مِثلَهُ من جهنَّمَ ، ومَنْ قامَ برَجلٍ مُسلمٍ مَقامَ سُمْعةٍ ورِياءٍ ، فإنَّ اللهَ يقومُ بهِ مَقامَ سُمعةٍ ورِياءٍ يومَ القيامةِ"],"grade":"صحيح","narrator":"المستورد بن شداد","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4881)، وأحمد (18011) باختلاف يسير.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"SeBidggI","merged":2,"otherRefs":["صحيح الأدب المفرد 179 (صحيح)"]},{"id":"س-01191","fp":"698b99091b2d","stateId":761,"easy":"إذا قذفت مؤمناً أو مؤمنة ← يحبسك الله في ردغة الخبال (عصارة أهل النار)","cause":"ومن قَفَا مؤمنًا أو مؤمنةً","result":"حبسهُ اللهُ في رَدْغَةِ الخَبَالِ عصارةِ أهلِ النارِ","explicit":true,"similar":["س-01198"],"ref":"تخريج المسند لشاكر 7/255","srcLabel":"أحمد","text":["عن أيوب بن سلمان رجل من أهل صنعاء قال: كنَّا بمكةَ فجلسنا إلى عطاءٍ الخراسانيِّ إلى جنبِ جدارِ المسجدِ فلم نسألْه ولم يُحدِّثْنا قال ثم جلسنا إلى ابنِ عمرَ مثلَ مجلسِكم هذا فلمْ نسألْه ولم يُحدِّثْنا قال فقال ما بالُكم لا تتكلَّمونَ ولا تذكرونَ اللهَ قولوا اللهُ أكبرُ والحمدُ للهِ وسبحانَ اللهِ وبحمدِهِ بواحدةٍ عشرًا وبعشرٍ مائةً من زادَ زادهُ اللهُ ومن سكتَ غُفِرَ لهُ ألا أُخبرُكم بخمسٍ سمعتهنَّ من رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ؟ قالوا : بَلَى قال من حالتْ شفاعتُهُ دونَ حَدٍّ من حدودِ اللهِ فهو مُضَادُّ اللهِ في أمرِهِ ومن أعانَ على خصومةٍ بغيرِ حقٍّ فهو مُستظلٌّ في سخطِ اللهِ حتى يتركَ ",["ومن قَفَا مؤمنًا أو مؤمنةً",1]," ",["حبسهُ اللهُ في رَدْغَةِ الخَبَالِ عصارةِ أهلِ النارِ",2]," ومن ماتَ وعليهِ دَيْنٌ أُخِذَ لصاحبِه من حسناتِه لا دينارَ ثَمَّ ولا درهمَ وركعتا الفجرِ، حافظوا عليهما فإنَّهما من الفضائلِ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (5544)","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"2sGjBDac"},{"id":"س-01198","fp":"6ea42b470416","stateId":761,"easy":"إذا بهتّ مؤمناً أو مؤمنة ← يحبسك الله في ردغة الخبال حتى تخرج مما قلت","cause":"ومَن بهَت مؤمنًا أو مؤمنةً","result":"حبَسه اللهُ في رَدْغةِ الخَبالِ يومَ القيامةِ حتَّى يخرُجَ ممَّا قال وليس بخارجٍ","explicit":true,"repOf":"س-01191","ref":"مجمع الزوائد 10/94","text":["مَن قال سُبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ واللهُ أكبَرُ كُتِبَتْ له بكلِّ حرفٍ عَشْرُ حسناتٍ ومَن أعان على خصومةِ باطلٍ لم يزَلْ في سَخَطِ اللهِ حتَّى ينزِعَ ومَن حالت شفاعتُه دونَ حدٍّ مِن حدودِ اللهِ فقد ضادَّ اللهَ في أمرِه ",["ومَن بهَت مؤمنًا أو مؤمنةً ",1],["حبَسه اللهُ في رَدْغةِ الخَبالِ يومَ القيامةِ حتَّى يخرُجَ ممَّا قال وليس بخارجٍ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"رجاله رجال الصحيح غير محمد بن منصور الطوسي وهو ثقة","takhrij":"أخرجه أبو داود (3597)، وأحمد (5544) باختلاف يسير، وابن ماجه (2320) مختصراً","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"A31kGr3M"},{"id":"س-03792","fp":"4fec2036ae12","stateId":761,"easy":"إذا قذفت أمتك بالزنا وهي بريئة ← تجلدك يوم القيامة","cause":"قال أو قالتْ لِوَليدتِها: يا زانيةُ، ولم تَطَّلِعْ منها على زِنًا","result":"جلَدَتْها وَليدتُها يَومَ القيامةِ","explicit":true,"ref":"المستدرك على الصحيحين 8321","srcLabel":"ابن عساكر","text":["عن عُمرِو بنِ العاصِ رَضيَ اللهُ عنه: أنَّه زارَ عمَّةً له، فدَعَت له بطَعامٍ، فأبْطَأَت الجاريةُ، فقالت: ألَا تَسْتعجِلي يا زانيةُ! فقال عُمرٌو: سُبحانَ اللهِ! لَقدْ قُلتِ أمرًا عظيمًا، هلِ اطَّلعْتِ منها على زِنًا؟ قالت: لا واللهِ، فقال عَمرٌو رَضيَ اللهُ عنه: إنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: أيُّما عَبدٍ أو امرأةٍ ",["قال أو قالتْ لِوَليدتِها: يا زانيةُ، ولم تَطَّلِعْ منها على زِنًا",1],"؛ ",["جلَدَتْها وَليدتُها يَومَ القيامةِ",2],"؛ لأنَّه لا حَدَّ لهنَّ في الدُّنيا."],"grade":"صحيح","narrator":"عمرو بن العاص","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن عساكر في ((تاريخه)) (46/ 181) بنحوه.","bab":"بر وصلة › إكرام الزائر","dorar":"eE5ormSs"},{"id":"س-04581","fp":"a7674a6a5492","stateId":761,"easy":"إذا أشعت على مسلم كلمة وهو بريء منها تشينه بها ← كان حقاً على الله أن يذيبك في النار","cause":"وأَيُّما رجلٍ أشاع على رجلٍ مسلمٍ بكَلِمَةٍ وهو منها بريءٌ يُشِينُه بها في الدنيا","result":"كان حَقًّا على اللهِ أن يُدْنِيَه يومَ القيامةِ في النارِ ، حتى يَأْتِيَ بإنفاذِ ما قال","explicit":true,"ref":"الجامع الصغير 2951","srcLabel":"الطبراني","text":["أَيُّما رجلٍ حالت شفاعتُه دونَ حَدٍّ من حدودِ اللهِ تعالى ، لم يَزَلْ في سَخَطِ اللهِ تعالى حتى يَنْزِعَ ، وأَيُّما رجلٍ شَدَّ غضبًا على مسلمٍ في خصومةٍ لا عِلْمَ له بها ، فقد عاند اللهَ حَقَّهُ ، وحَرَصَ ، على سَخَطِهِ ، وعليه لعنةُ اللهِ المتتابِعَةُ إلى يومِ القيامةِ ، ",["وأَيُّما رجلٍ أشاع على رجلٍ مسلمٍ بكَلِمَةٍ وهو منها بريءٌ يُشِينُه بها في الدنيا ؛ ",1],["كان حَقًّا على اللهِ أن يُدْنِيَه يومَ القيامةِ في النارِ ، حتى يَأْتِيَ بإنفاذِ ما قال",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه الطبراني كما في ((الجامع الصغير)) للسيوطي (1/260)","bab":"حدود › الحث على إقامة الحدود","dorar":"sPYe1Im7"},{"id":"س-04874","fp":"51dc2cabb5c9","stateId":761,"easy":"إذا ذكرت امرءاً بما ليس فيه لتعيبه ← يحبسك الله في نار جهنم حتى تأتي بنفاذ ما قلت","cause":"مَن ذكر امْرَءًا بما ليس فيه ليَعِيبَه","result":"حبسه اللهُ في نارِ جهنمَ ، حتى يأتيَ بنَفَاذِ ما قال","explicit":true,"ref":"الجامع الصغير 8657","srcLabel":"الطبراني","text":[["مَن ذكر امْرَءًا بما ليس فيه ليَعِيبَه ، ",1],["حبسه اللهُ في نارِ جهنمَ ، حتى يأتيَ بنَفَاذِ ما قال",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (8936) واللفظ له، وأبو الشيخ في ((التوبيخ والتنبيه)) (128)، وابن عدي في ((الكامل في الضعفاء)) (7/297)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"A57j8MkR"},{"id":"س-05126","fp":"6fd5932161d6","stateId":761,"easy":"إذا هجوت رجلاً فهجوت القبيلة بأسرها ← تكون من أشد الناس عذاباً يوم القيامة","cause":"يومَ القِيامةِ رجُلٌ هجَا رجُلًا، فهَجا القَبيلةَ بأَسْرِها","result":"أشدُّ النَّاسِ عذابًا","explicit":true,"ref":"تخريج مشكل الآثار 9","srcLabel":"ابن حبان","text":[["أشدُّ النَّاسِ عذابًا",2],[" يومَ القِيامةِ رجُلٌ هجَا رجُلًا، فهَجا القَبيلةَ بأَسْرِها",1],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (9) واللفظ له، وابن ماجة (3761)، وابن حبان (5785) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"xpBJIwII"},{"id":"س-05495","fp":"d52e4e2cf732","stateId":761,"easy":"إذا أكلت بالنيل من مسلم أكلة ← يطعمك الله بها أكلة من نار جهنم","cause":"مَن أكَلَ بمُسْلِمٍ أكلَةً","result":"أطعَمَهُ اللهُ بها أكْلَةً مِن نارِ جهَنَّمَ يومَ القيامةِ","explicit":true,"repOf":"س-05478","ref":"المستدرك على الصحيحين 7362","text":[["مَن أكَلَ بمُسْلِمٍ أكلَةً، ",1],["أطعَمَهُ اللهُ بها أكْلَةً مِن نارِ جهَنَّمَ يومَ القيامةِ، ",2],"ومَن أقامَ بمُسلِمٍ مُقامَ سُمْعةٍ، أقامَهُ اللهُ يومَ القِيامةِ مُقامَ سُمعةٍ ورِياءٍ، ومَنِ اكتسى بمُسلِمٍ ثَوبًا كَساهُ اللهُ ثوبًا مِن نارٍ يومَ القِيامةِ."],"grade":"صحيح","narrator":"المستورد بن شداد","muhaddith":"صحيح الإسناد","bab":"رقائق وزهد › الرياء والسمعة","dorar":"9Kg2tmyU"},{"id":"س-05497","fp":"12e9569af682","stateId":761,"easy":"إذا اكتسيت بالنيل من مسلم ثوباً ← يكسوك الله ثوباً من نار يوم القيامة","cause":"ومَنِ اكتسى بمُسلِمٍ ثَوبًا","result":"كَساهُ اللهُ ثوبًا مِن نارٍ يومَ القِيامةِ","explicit":true,"repOf":"س-05478","ref":"المستدرك على الصحيحين 7362","text":["مَن أكَلَ بمُسْلِمٍ أكلَةً، أطعَمَهُ اللهُ بها أكْلَةً مِن نارِ جهَنَّمَ يومَ القيامةِ، ومَن أقامَ بمُسلِمٍ مُقامَ سُمْعةٍ، أقامَهُ اللهُ يومَ القِيامةِ مُقامَ سُمعةٍ ورِياءٍ، ",["ومَنِ اكتسى بمُسلِمٍ ثَوبًا ",1],["كَساهُ اللهُ ثوبًا مِن نارٍ يومَ القِيامةِ",2],"."],"grade":"صحيح","narrator":"المستورد بن شداد","muhaddith":"صحيح الإسناد","bab":"رقائق وزهد › الرياء والسمعة","dorar":"9Kg2tmyU"},{"id":"س-05503","fp":"581b62bef2c1","stateId":761,"easy":"إذا اكتسيت برجل مسلم ثوباً ← يكسوك الله مثله من جهنم","cause":"ومَنِ اكْتسَى برَجلٍ مُسلمٍ ثوْبًا","result":"فإنَّ اللهَ يَكسُوهُ مِثلَهُ","explicit":true,"repOf":"س-05478","ref":"صحيح الجامع 6083","text":["مَنْ أكل برَجلٍ مُسلمٍ أكْلَةً ، فإنَّ اللهَ يُطعِمُهُ مِثلَها من جهنَّمَ ، ",["ومَنِ اكْتسَى برَجلٍ مُسلمٍ ثوْبًا ، ",1],["فإنَّ اللهَ يَكسُوهُ مِثلَهُ ",2],"من جهنَّمَ ، ومَنْ قامَ برَجلٍ مُسلمٍ مَقامَ سُمْعةٍ ورِياءٍ ، فإنَّ اللهَ يقومُ بهِ مَقامَ سُمعةٍ ورِياءٍ يومَ القيامةِ"],"grade":"صحيح","narrator":"المستورد بن شداد","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4881)، وأحمد (18011) باختلاف يسير.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"SeBidggI"},{"id":"س-04224","fp":"3ec94e211b7d","stateId":761,"easy":"إذا آذيتِ جيرانك بلسانك ولو صليتِ وصمتِ ← فأنتِ من أهل النار","cause":"وتُؤذي جيرانَها بلسانِها","result":"هي من أهلِ النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[60,67,41],"ref":"السلسلة الصحيحة 1/369","srcLabel":"أحمد","text":["قيل للنبيِّ صلَّى اللهُ عليهِ وسلَّمَ : يا رسولَ اللهِ إنَّ فلانةً تقومُ الليلَ وتصومُ النهارَ وتفعلُ وتصدَّقُ ",["وتُؤذي جيرانَها بلسانِها",1]," فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ : لا خيرَ فيها ",["هي من أهلِ النَّارِ",2]," قال : وفلانةٌ تُصلِّي المكتوبةَ وتصدّقُ بأثوارٍ من الأقِطِ ولا تُؤذي أحدًا فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ : هي من أهلِ الجنَّةِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (9675)، والبزار (9713)، وابن حبان (5764) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"dbvXsh4A","merged":5,"otherRefs":["صحيح الترغيب 2560 (صحيح)","صحيح الأدب المفرد 88 (صحيح)","تخريج صحيح ابن حبان 5764 (صحيح)"]},{"id":"س-02801","fp":"978067d6b8fe","stateId":761,"easy":"إذا رميت مسلماً بشيء تريد شينه ← يحبسك الله على جسر جهنم حتى تخرج مما قلت","cause":"ومَن قَفَى مُسلمًا بشيءٍ يُريدُ شَينَه به","result":"حبَسَه اللهُ على جِسرِ جَهنَّمَ حتى يَخرُجَ ممَّا قال","explicit":true,"ref":"تخريج شرح السنة 3527","srcLabel":"أبو داود","text":["مَن حَمى مُؤمنًا من مُنافقٍ يَعيبُه، بعَثَ اللهُ مَلَكًا يَحمي لَحمَه يومَ القيامةِ مِن نارِ جَهنَّمَ، ",["ومَن قَفَى مُسلمًا بشيءٍ يُريدُ شَينَه به، ",1],["حبَسَه اللهُ على جِسرِ جَهنَّمَ حتى يَخرُجَ ممَّا قال",2],"."],"grade":"حسن","narrator":"معاذ بن أنس","muhaddith":"إسماعيل بن يحيى المعافري لم يوثقه غير ابن حبان، وباقي رجاله ثقات.","takhrij":"أخرجه الطبراني (433) (20/ 194) واللفظ له، وأبو داود (4883)، وأحمد (15649) باختلاف يسير.","bab":"إيمان › النفاق","dorar":"iku4DJoR"},{"id":"س-03001","fp":"9135f266e0f9","stateId":761,"easy":"إذا أكلت لحم أخيك في الدنيا (اغتبته) ← يُقرّب إليك يوم القيامة فيقال: كله ميتاً","cause":"مَن أكَل لحمَ أخيه في الدنيا","result":"قُرِّب إليه يومَ القيامةِ فيُقالُ له كُلْه ميتًا كما أكَلتَه حيًّا فيأكُلُه فيَكلَحُ ويَصيحُ","explicit":true,"ref":"الكبائر لابن عبدالوهاب 42","srcLabel":"الطبراني","text":[["مَن أكَل لحمَ أخيه في الدنيا",1]," ",["قُرِّب إليه يومَ القيامةِ فيُقالُ له كُلْه ميتًا كما أكَلتَه حيًّا فيأكُلُه فيَكلَحُ ويَصيحُ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن أبي الدنيا في ((الصمت)) (178)، وأبو يعلى كما في ((إتحاف الخيرة المهرة)) للبوصيري (6/75)، والطبراني في ((المعجم الأوسط)) (1656) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"KoYbcT6o"},{"id":"س-04875","fp":"e112ca6f2d54","stateId":761,"easy":"إذا زنّيت أمة لم ترها تزني ← يجلدك الله يوم القيامة بسوط من نار","cause":"من زنَّى أَمَةً لم يَرَها تزني","result":"جلَدَه الله يومَ القيامة بسَوطٍ مِن نارٍ","explicit":true,"ref":"الجامع الصغير 8705","srcLabel":"أحمد","text":[["من زنَّى أَمَةً لم يَرَها تزني، ",1],["جلَدَه الله يومَ القيامة بسَوطٍ مِن نارٍ",2],"."],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"حسن","takhrij":"أخرجه أحمد (21375)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"VJuzdJfk"},{"id":"س-04903","fp":"5ae87abb7c03","stateId":761,"easy":"إذا قذفت ذمياً ← يُقام عليك الحد يوم القيامة بسياط من نار","cause":"من قذَفَ ذمِّيًا","result":"حُدَّ لَه يومَ القيامةِ بِسياطٍ من نارٍ","explicit":true,"ref":"الجامع الصغير 8902","srcLabel":"ابن حبان","text":[["من قذَفَ ذمِّيًا، ",1],["حُدَّ لَه يومَ القيامةِ بِسياطٍ من نارٍ",2]],"grade":"حسن","narrator":"واثلة بن الأسقع الليثي أبو فسيلة","muhaddith":"حسن","takhrij":"أخرجه ابن حبان في ((المجروحين)) (2/ 289)، والطبراني (22/ 57) (135)، وابن عدي في ((الكامل في الضعفاء)) (7/ 367) بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"4PWRSRjE"},{"id":"س-07453","fp":"d6fa37a131cd","stateId":761,"easy":"إذا أكلت لحوم الناس ووقعت في أعراضهم ← تخمش وجهك وصدرك بأظفار من نحاس","cause":"الذينَ يأكلونَ لُحُومَ الناسِ ، ويَقَعُونَ في أَعْرَاضِهِمْ","result":"بِقومٍ لهُمْ أَظْفَارٌ من نُحاسٍ ، يَخْمُشُونَ وُجُوهَهُمْ وصُدُورَهُمْ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح الترغيب 2839","srcLabel":"أبو داود","text":["َلمَّا عُرِجَ بي مَرَرْتُ ",["بِقومٍ لهُمْ أَظْفَارٌ من نُحاسٍ ، يَخْمُشُونَ وُجُوهَهُمْ وصُدُورَهُمْ",2]," ، فقُلْتُ : مَنْ هؤلاءِ يا جبريلُ ؟ قال : هؤلاءِ ",["الذينَ يأكلونَ لُحُومَ الناسِ ، ويَقَعُونَ في أَعْرَاضِهِمْ",1]," ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4878) واللفظ له، وأحمد (13340).","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"myy669P0","merged":3,"otherRefs":["الأحكام الوسطى 4/ 263 (صحيح)","مجموع فتاوى ابن باز 381/8 (صحيح)"]},{"id":"س-04565","fp":"ba2ea037a15e","stateId":761,"easy":"إذا أكلت لحوم الناس (اغتبتهم) ← يسيل فوك قيحاً ودماً في النار","cause":"كان يأكلُ لحمَ الناسِ","result":"ورجلٌ يسيلُ فوه قيحًا ودمًا","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"مجمع الزوائد 1/213","srcLabel":"الطبراني","text":["أربعةٌ يُؤذونَ أهلَ النارِ على ما بهم من الأذَى يسعونَ بينَ الحميمِ والجحيمِ يدعونَ بالويلِ والثبورِ يقولُ أهلُ النارِ بعضُهم لبعضٍ ما بالُ هؤلاءِ قد آذونا على ما بنا من الأذَى قال فرجلٌ مغلقٌ عليه تابوتٌ من جمرٍ ورجلٌ يجرُّ أمعاءَه ",["ورجلٌ يسيلُ فوه قيحًا ودمًا",2]," ورجلٌ يأكلُ لحمَه قال فيُقالُ لصاحبِ التابوتِ ما بالُ الأبعدِ قد آذانا على ما بنا من الأذَى قال فيقولُ إن الأبعدَ مات وفي عنقِه أموالُ الناسِ ما يجدُ لها قضاءً أو وفاءً ثم قال للذي يجرُّ أمعاءَه ما بالُ الأبعدِ قد آذانا على ما بنا من الأذَى فقال إن الأبعدَ كان لا يُبالِي أينَ أصاب البولُ منه لا يغسلُه ثم قال للذي يسيلُ فوه قيحًا ودمًا ما بالُ الأبعدِ قد آذانا على ما بنا من الأذَى فيقولُ إن الأبعدَ ",["كان يأكلُ لحمَ الناسِ",1]],"grade":"حسن","narrator":"شفي بن ماتع الأصبحي","muhaddith":"رجاله موثقون","takhrij":"أخرجه ابن المبارك في ((الزهد)) (2/94)، وابن أبي الدنيا في ((صفة النار)) (229)، والطبراني (7/311) (7226) باختلاف يسير.","bab":"جهنم › صفة عذاب أهل النار","dorar":"SXiXxY4A"},{"id":"س-06327","fp":"c7925585f0a6","stateId":762,"easy":"إذا أكثرتن اللعن وكفرتن العشير ← تكنّ أكثر أهل النار","cause":"تُكثِرْنَ اللَّعنَ وتكفُرْنَ العشيرَ","result":"أراكنَّ أكثَرَ أهلِ النَّارِ","explicit":true,"star":true,"similar":["س-01334"],"otherNeedIds":[37],"ref":"تخريج صحيح ابن حبان 5744","srcLabel":"متفق عليه","text":["خرَج رسولُ اللهِ صلَّى اللهُ عليه وسلَّم في أضحى أو فِطْرٍ إلى المُصلَّى فصلَّى ثمَّ انصرَف فقام فوعَظ النَّاسَ وأمَرهم بالصَّدقةِ قال: ( أيُّها النَّاسُ تصدَّقوا ) ثمَّ انصرَف فمرَّ على النِّساءِ فقال: ( يا معشرَ النِّساءِ تصدَّقْنَ فإنِّي ",["أراكنَّ أكثَرَ أهلِ النَّارِ",2]," ) فقُلْنَ: ولمَ ذلك يا رسولَ اللهِ ؟ قال: ( ",["تُكثِرْنَ اللَّعنَ وتكفُرْنَ العشيرَ",1]," ما رأَيْتُ مِن ناقصاتِ عقلٍ ودِينٍ أذهَبَ لِلُبِّ الرَّجُلِ الحازمِ مِن إحداكنَّ يا معشرَ النِّساءِ ) فقُلْنُ له: ما نقصانُ دِينِنا وعقلِنا يا رسولَ اللهِ ؟ قال: ( أليس شَهادةُ المرأةِ مِثْلَ نصفِ شَهادةِ الرَّجُلِ ) قُلْنَ: بلى قال: ( فذاك نُقصانُ عقلِها أوَليسَتْ إذا حاضتِ المرأةُ لم تُصَلِّ ولم تَصُمْ ) ؟ قُلْنَ: بلى قال ( فذاك نُقصانُ دِينِها ) ثمَّ انصرَف رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فلمَّا صار إلى منزلِه جاءتْ زينبُ امرأةُ عبدِ اللهِ بنِ مسعودٍ تستأذِنُ عليه فقيل: يا رسولَ اللهِ هذه زينبُ تستأذِنُ عليك فقال: ( أيُّ الزَّيانبِ ) ؟ قيل: امرأةُ عبدِ اللهِ بنِ مسعودٍ قال: ( نَعم ائذَنوا لها ) فأذِن لها فقالت: يا نبيَّ اللهِ إنَّك أمَرْتَنا اليومَ بالصَّدقةِ وكان عندي حُلِيٌّ فأرَدْتُ أنْ أتصدَّقَ فزعَم ابنُ مسعودٍ أنَّه وولَدَه أحقُّ مَن تصدَّقْتُ به عليهم فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ( صدَق زوجُك وولَدُك أحقُّ مَن تصدَّقْتِ به عليهم )"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه البخاري (1462) باختلاف يسير، ومسلم (80) دون ذكر لفظه","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"0z0NtOOk","merged":7,"otherRefs":["صحيح مسلم 80 (صحيح)","تخريج صحيح ابن حبان 7479 (صحيح)","صحيح ابن حبان 3323 (صحيح)","تخريج المسند لشعيب 4151 (صحيح)","المستدرك على الصحيحين 9008 (صحيح)","المستدرك على الصحيحين 2810 (صحيح)"]},{"id":"س-04195","fp":"caabfab03241","stateId":762,"easy":"إذا كفرت العشير وأنكرت الإحسان ← تكونين من أكثر أهل النار","cause":"يكفُرْنَ العشيرَ ويكفُرْنَ الإحسانَ","result":"رأَيْتُ أكثرَ أهلِها النِّساءَ","explicit":true,"star":true,"ref":"صحيح ابن حبان 2853","srcLabel":"متفق عليه","text":["خسَفت الشَّمسُ على عهدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فصلَّى رسولُ اللهِ صلَّى اللهُ عليه وسلَّم والنَّاسُ معه فقام قيامًا طويلًا نحوًا مِن سورةِ البقرةِ ثمَّ ركَع ركوعًا طويلًا ثمَّ رفَع فقام قيامًا طويلًا وهو دونَ القيامِ الأوَّلِ ثمَّ ركَع ركوعًا طويلًا وهو دونَ الرُّكوعِ الأوَّلِ ثمَّ سجَد ثمَّ قام قيامًا طويلًا دونَ القيامِ الأوَّلِ ثمَّ ركَع ركوعًا طويلًا وهو دونَ الرُّكوعِ الأوَّلِ ثمَّ سجَد ثمَّ قام قيامًا طويلًا دونَ القيامِ الأوَّلِ ثمَّ ركَع ركوعًا طويلًا وهو دونَ الرُّكوعِ الأوَّلِ ثمَّ رفَع فقام قيامًا طويلًا وهو دونَ القيامِ الأوَّلِ ثمَّ ركَع ركوعًا طويلًا وهو دونَ الرُّكوعِ الأوَّلِ ثمَّ سجَد ثمَّ انصرَف وقد تجلَّتِ الشَّمسُ فقال: ( إنَّ الشَّمسَ والقمرَ آيتانِ مِن آياتِ اللهِ لا يخسفانِ لموتِ أحدٍ ولا لحياتِه فإذا رأَيْتُم ذلك فاذكُروا اللهَ ) فقالوا: يا رسولَ اللهِ رأَيْناك تناوَلْتَ شيئًا في مقامِك هذا ثمَّ رأَيْناك تكعكَعْتَ قال: ( إنِّي رأَيْتُ الجنَّةَ أو أُريتُ الجنَّةَ فتناوَلْتُ منه عُنقودًا ولو أخَذْتُه لأكَلْتُم منه ما بقيتِ الدُّنيا ورأَيْتُ النَّارَ فلم أرَ كاليومِ منظرًا قطُّ و",["رأَيْتُ أكثرَ أهلِها النِّساءَ",2]," ) \nقالوا: بمَ يا رسولَ اللهِ ؟ قال: ( بكفرِهنَّ ) قيل: يكفُرْنَ باللهِ ؟ قال: ( ",["يكفُرْنَ العشيرَ ويكفُرْنَ الإحسانَ",1]," لو أحسَنْتَ إلى إحداهنَّ الدَّهرَ ثمَّ رأَتْ منك شيئًا قالت: واللهِ ما رأَيْتُ منك خيرًا قطُّ )"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (1052)، ومسلم (907) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"EQxsZEVP","merged":2,"otherRefs":["تخريج مشكل الآثار 851 (صحيح)"]},{"id":"س-05915","fp":"7b7cd9b8cdd9","stateId":762,"easy":"إذا أطلقت فمك وفرجك ← فهما أكثر ما يدخل الناس النار","cause":"الفَمُ والفَرْجُ","result":"أكثَرِ ما يُدخِلُ النَّاسَ النَّارَ","explicit":true,"ref":"المستدرك على الصحيحين 8132","srcLabel":"الترمذي","text":["سُئِلَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ عنْ أكثرِ ما يُدخِلُ النَّاسَ الجنَّةَ، قالَ: التَّقْوى وحُسْنُ الخُلُقِ، وسُئِلَ عنْ ",["أكثَرِ ما يُدخِلُ النَّاسَ النَّارَ",2],"، فقال: الأجْوفانِ: ",["الفَمُ والفَرْجُ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (2004)، وابن ماجة (4246)، وأحمد (7907) باختلاف يسير.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"NpzBpE76","merged":7,"otherRefs":["صحيح ابن حبان 476 (صحيح)","صحيح ابن ماجه 3443 (حسن)","تخريج المسند لشعيب 7907 (حسن)","تخريج المسند لشعيب 9096 (حسن)","صحيح الأدب المفرد 222 (حسن)","تخريج المسند لشعيب 9696 (حسن)"]},{"id":"س-04554","fp":"3322c84d26c5","stateId":762,"easy":"إذا تكلمت بكلمة لا تلقي لها بالاً (من سخط الله) ← تهوي بها في النار","cause":"إنَّ الرَّجُلَ لَيتكَلَّمُ بالكَلمةِ، وما يَرى أنَّها تَبلُغُ حيثُ بلَغَتْ","result":"يَهوي بها في النَّارِ سَبعينَ خَريفًا","explicit":true,"ref":"تخريج المسند لشعيب 10895","srcLabel":"الترمذي","text":[["إنَّ الرَّجُلَ لَيتكَلَّمُ بالكَلمةِ، وما يَرى أنَّها تَبلُغُ حيثُ بلَغَتْ",1],"، ",["يَهوي بها في النَّارِ سَبعينَ خَريفًا",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2314)، وابن ماجه (3970)، وأحمد (10895) واللفظ له","bab":"جهنم › شدة نار جهنم وبعد قعرها","dorar":"0fp2L05u","merged":4,"otherRefs":["المستدرك على الصحيحين 8994 (صحيح)","صحيح ابن ماجه 3221 (صحيح)","تخريج المسند لشعيب 7958 (صحيح)"]},{"id":"س-00298","fp":"7e48a059f7f0","stateId":762,"easy":"إذا ملأ الله أذنيك من ثناء الناس شراً ← فأنت من أهل النار","cause":"من ملأَ أذُنَيْهِ من ثَناءِ النَّاسِ شرًّا وَهوَ يسمَعُ","result":"وأَهْلُ النَّارِ","explicit":true,"ref":"مصباح الزجاجة 4/243","srcLabel":"ابن ماجه","text":["أَهْلُ الجنَّةِ مَن ملأَ اللَّهُ أذُنَيْهِ من ثَناءِ النَّاسِ خيرًا وَهوَ يسمعُ، ",["وأَهْلُ النَّارِ",2]," ",["من ملأَ أذُنَيْهِ من ثَناءِ النَّاسِ شرًّا وَهوَ يسمَعُ",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح رجاله ثقات","takhrij":"أخرجه ابن ماجه (4224) واللفظ له، والطبراني (12/ 170) (12787)، وأبو نعيم في ((حلية الأولياء)) (3/ 80) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"4ipX0kYA"},{"id":"س-00375","fp":"7b1f1a1a9a2f","stateId":762,"easy":"إذا تكلمت بكلمة تضحك بها جلساءك (بسوء) ← تهوي بها أبعد من الثريا","cause":"لَيتكلَّمُ بالكلمةِ يُضحِكُ بها جُلساءَه","result":"يهوِي بها مِن أبعدَ مِن الثُّريَّا","explicit":true,"similar":["س-06860"],"ref":"صحيح ابن حبان 5716","srcLabel":"أحمد","text":["إنَّ الرَّجُلَ ",["لَيتكلَّمُ بالكلمةِ يُضحِكُ بها جُلساءَه",1]," ",["يهوِي بها مِن أبعدَ مِن الثُّريَّا",2]," )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (9220)، والبزار (8732)، وابن عدي في ((الكامل في الضعفاء)) (3/225) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"vInQWYQ7"},{"id":"س-03487","fp":"f3ec36675f32","stateId":762,"easy":"إذا حلفت أن الله لا يغفر لفلان ← يغفر الله له ويحبط عملك","cause":"فحَلَفَ رجلٌ أنه لا يُغْفَرَ له","result":"فغَفَرَ اللهُ للمذنِبِ وسخِطَ على المُتَأَلِّي","explicit":true,"otherNeedIds":[52],"ref":"عارضة الأحوذي 4/320","srcLabel":"عارضة الأحوذي","text":["إنَّ رجلًا كانَ عاصِيًا ",["فحَلَفَ رجلٌ أنه لا يُغْفَرَ له",1]," ",["فغَفَرَ اللهُ للمذنِبِ وسخِطَ على المُتَأَلِّي",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"VTiJHb7a"},{"id":"س-04332","fp":"06fdd6e11f13","stateId":762,"easy":"إذا أفشت المرأة الأمانة وألحفت في السؤال وبخلت إذا سُئلت ← تكون من أكثر أهل النار","cause":"إنِ ائتُمِنَّ أفْشَيْنَ، وإنْ سَألْنَ ألْحَفْنَ، وإذا سُئِلنَ بَخَلْنَ، وإذا أُعطِينَ لم يَشكُرْنَ","result":"وأكثَرُ مَن رأيْتُ فيها مِنَ النِّساءِ","explicit":true,"ref":"المستدرك على الصحيحين 9014","srcLabel":"أحمد","text":["بيْنا نحنُ مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في صَلاةِ الظُّهرِ والنَّاسُ في الصُّفوفِ خلْفَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فرَأيْنا رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَتناوَلُ شَيئًا، فجَعَل يَتناوَلُه، فتَأخَّر وتَأخَّرَ النَّاسُ، ثمَّ تَأخَّر الثَّانيةَ فتَأخَّر النَّاسُ، فقُلتُ: يا رَسولَ اللهِ، رَأيْناك صَنعتَ اليومَ شَيئًا ما كُنتَ تَصنَعُه في الصَّلاةِ، فقال: إنَّه عُرِضَت علَيَّ الجنَّةُ بما فيها مِنَ الزَّهْرةِ والنَّضرةِ، فتَناوَلْتُ قِطفًا مِن عِنَبِها، ولوْ أخذْتُه لَأكَلَ منه مَن بيْن السَّماءِ والأرضِ لا يَنقُصُونه، فحِيلَ بيْني وبيْنه. وعُرِضَت علَيَّ النَّارُ، فلمَّا وجَدْتُ سَفْعَتَها تَأخَّرْتُ عنها، ",["وأكثَرُ مَن رأيْتُ فيها مِنَ النِّساءِ",2],"، ",["إنِ ائتُمِنَّ أفْشَيْنَ، وإنْ سَألْنَ ألْحَفْنَ، وإذا سُئِلنَ بَخَلْنَ، وإذا أُعطِينَ لم يَشكُرْنَ",1],"، ورأيْتُ فيها عَمْرَو بنَ لُحَيٍّ يجُرُّ قُصْبَه في النَّارِ، وأشْبَهُ مَن رأيْتُ به مَعبَدُ بنُ أكثَمَ الخُزاعيُّ، فقال مَعبَدٌ: يا رَسولَ اللهِ، أتَخْشَى علَيَّ مِن شَبَهِه؛ فإنَّه والدٌ؟ فقال: لا، أنتَ مُؤمِنٌ وهو كافرٌ، وهو أوَّلُ مَن حمَلَ العرَبَ على عِبادةِ الأصنامِ."],"grade":"صحيح","narrator":"أبو  بن كعب","muhaddith":"صحيح الإسناد ولم يخرجاه","takhrij":"أخرجه أحمد (21251)، والضياء في ((المختارة)) (1194) بنحوه.","bab":"جنة › صفة الجنة","dorar":"wzocmYYZ"},{"id":"س-08255","fp":"4547dbf17469","stateId":762,"easy":"إذا قلت لأحد «والله لا يغفر الله لك» ← أوبقت دنياك وآخرتك","cause":"واللهِ لا يغفِرُ اللهُ لك","result":"لَتكلَّم بكلمةٍ أوبقَتْ دنياه وآخِرتَه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[52,11,13],"ref":"صحيح ابن حبان 5712","srcLabel":"أبو داود","text":["[عن] ضمضم بن جوس، قال: دخَلْتُ مسجدَ الرَّسولِ صلَّى اللهُ عليه وسلَّم فإذا أنا بشيخٍ مُصفِّرٍ رأسَه برَّاقِ الثَّنايا معه رجُلٌ أدعَجُ جميلُ الوجهِ شابٌّ فقال الشَّيخُ: يا يَماميُّ تَعالَ لا تقولَنَّ لرجُلٍ أبدًا: لا يغفِرُ اللهُ لك واللهِ لا يُدخِلُك اللهُ الجنَّةَ أبدًا قُلْتُ: ومَن أنتَ يرحَمُك اللهُ ؟ قال: أنا أبو هُريرةَ قُلْتُ: إنَّ هذه لَكلمةٌ يقولُها أحدُنا لبعضِ أهلِه أو لخادمِه إذا غضِب عليها قال: فلا تَقُلْها إنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( كان رجُلانِ مِن بني إسرائيلَ متواخيَيْنِ أحدُهما مُجتهِدٌ في العبادةِ والآخَرُ مُذنِبٌ فأبصَر المُجتهدُ المُذنِبَ على ذنبٍ فقال له: أقصِرْ فقال له: خَلِّني وربِّي قال: وكان يُعيدُ ذلك عليه ويقولُ: خَلِّني وربِّي حتَّى وجَده يومًا على ذنبٍ فاستعظَمه فقال وَيْحَك أقصِرْ قال خَلِّني وربِّي أبُعِثْتَ عليَّ رقيبًا ؟ ! فقال: ",["واللهِ لا يغفِرُ اللهُ لك",1]," أبدًا أو قال: لا يُدخِلُك اللهُ الجنَّةَ أبدًا فبُعِث إليهما ملَكٌ فقبَض أرواحَهما فاجتمَعا عندَه جلَّ وعلا فقال ربُّنا للمُجتهِدِ: أكُنْتَ عالِمًا أم كُنْتَ قادرًا على ما في يدي أم تحظُرُ رحمتي على عبدي ؟ اذهَبْ إلى الجنَّةِ يُريدُ المُذنِبَ وقال للآخَرِ: اذهبَوا به إلى النَّارِ فوالَّذي نفسي بيدِه ",["لَتكلَّم بكلمةٍ أوبقَتْ دنياه وآخِرتَه",2]," )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (4901)، وأحمد (8292)، والبزار (9418) واللفظ لهم جميعا.","bab":"مناقب وفضائل › أبو هريرة","dorar":"7dykX84Y","merged":7,"otherRefs":["إتحاف الخيرة المهرة 2/210 (حسن)","تخريج شرح الطحاوية 299 (صحيح)","تخريج شرح السنة 4188 (حسن)","صحيح مسلم 2621 (صحيح)","تخريج الإحياء للعراقي 3/429 (حسن)","إتحاف الخيرة المهرة 6/475 (صحيح)"]},{"id":"س-00357","fp":"af60b89a1d8b","stateId":762,"easy":"إذا قلت كلمة لتضحك بها الناس (بباطل) ← تهوي بها في النار أبعد مما بين السماء والأرض","cause":"ليقولُ الكَلِمةَ لا يقولُها إلَّا ليُضحِكَ بها النَّاسَ","result":"يَهْوي بها أبعَدَ ممَّا بين السَّماءِ والأرضِ","explicit":true,"ref":"هداية الرواة 4/381","srcLabel":"البيهقي","text":["إنَّ العبدَ ",["ليقولُ الكَلِمةَ لا يقولُها إلَّا ليُضحِكَ بها النَّاسَ",1]," ",["يَهْوي بها أبعَدَ ممَّا بين السَّماءِ والأرضِ",2],"، وإنَّه وَعَدتْه لَيَزِلُّ عن لِسانِه أشَدُّ ممَّا يَزِلُّ عن قَدَمِه."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه ابن المبارك في ((المسند)) (18)، والخرائطي في ((مكارم الأخلاق)) (407)، والبيهقي في ((شعب الإيمان)) (4492) جميعهم بلفظه.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"j6cTn2mi"},{"id":"س-04027","fp":"f44f570b1118","stateId":762,"easy":"إذا قلت لأحد «لا يغفر الله لك» ← قد يُغفر له وتوجب على نفسك النار","cause":"فغضب فقال : لا يغفرُ اللهُ لك","result":"وأنت فقد أوجبتُ لك النارَ","explicit":true,"otherNeedIds":[52],"ref":"تخريج الإحياء للعراقي 4/187","srcLabel":"أبو داود","text":["إنَّ رجليْنِ من بني إسرائيلَ تواخيَا في اللهِ فكان أحدُهما يُسرفُ على نفسِه وكان الآخرُ عابدًا وكان يَعِظُه ويزجرُه فكان يقول : دعني وربِّي أَبُعِثْتَ عليَّ رقيبًا حتى رآهُ ذاتَ يومٍ على كبيرةٍ ",["فغضب فقال : لا يغفرُ اللهُ لك",1]," قال : فيقول الله تعالَى يوم القيامةِ : أيستطيعُ أحدٌ أن يحظُرَ رحمتي على عبادي اذهب أنت فقد غفرتُ لك ثم يقول للعابدِ : ",["وأنت فقد أوجبتُ لك النارَ",2]," قال : فوالذي نفسي بيدِه لقد تكلَّمَ بكلمةٍ أهلكتْ دنياهُ وآخرتَه ."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده جيد","takhrij":"أخرجه أبو داود (4901)، وأحمد (8292)، وابن حبان (5712)،  جميعا بنحوه مطولا .","bab":"توبة › سعة رحمة الله تعالى وأنها سبقت غضبه","dorar":"zUxdKIsa"},{"id":"س-06860","fp":"a34583b8d7d8","stateId":762,"easy":"إذا تكلمت بالكلمة تضحك بها القوم (بباطل) ← تسقط بها أبعد من السماء","cause":"أنْ يَتَكَلَّمَ بِالكَلِمَةِ يُضْحِكُ بِها القومَ","result":"فَيَسْقُطُ بِها أَبْعَدَ مِنَ السَّماءِ","explicit":true,"repOf":"س-00375","ref":"صحيح الترغيب 2877","text":["أَلا هل عَسَى رجلٌ مِنكمْ ",["أنْ يَتَكَلَّمَ بِالكَلِمَةِ يُضْحِكُ بِها القومَ",1]," ؛ ",["فَيَسْقُطُ بِها أَبْعَدَ مِنَ السَّماءِ",2]," ، ألا عَسَى رجلٌ مِنكمْ أنْ يَتَكَلَّمَ بِالكَلِمَةِ يُضْحِكُ بِها أصحابَهُ ؛ فيسخط اللهُ بِها عليهِ ؛ لا يرضَى عنهُ حتى يدخلهُ النارَ ."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"لم نقف عليه إلا في ((الترغيب والترهيب)) للمنذري (3/ 344).","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"HIfAivTx"},{"id":"س-01880","fp":"9b2fe1d96e23","stateId":762,"easy":"إذا أطلقت لسانك ← تُكب في النار على منخريك بحصائده","cause":"حصائدُ ألسنَتِهمْ","result":"هل يَكُبُّ النَّاسَ على مَناخِرِهم في جهنَّمَ إلَّا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"مختصر المقاصد 596","srcLabel":"الترمذي","text":["الصَّومُ جُنَّةٌ [يعني حديث: بيْنَما نحن مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في غزوةِ تَبوكَ وقد أَصابَنا الحَرُّ، فتفَرَّقَ القومُ حتَّى نَظرتُ، فإذا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ أقرَبَهُم مِنِّي. قالَ: فدَنوتُ منه فقلتُ: يا رسولَ اللهِ، أَنبِئْني بعملٍ يُدخِلُني الجنَّةَ ويُباعِدُني مِنَ النَّارِ. قالَ: «لقد سألتَ عنْ عظيمٍ، وإنَّه ليَسيرٌ على مَنْ يَسَّرَهُ اللهُ عليه؛ تَعبدُ اللهَ ولا تُشركُ به شيئًا، وتُقيمُ الصَّلاةَ المكتوبةَ، وتُؤتي الزَّكاةَ المفروضةَ، وتَصومُ رمضانَ». قالَ: «وإنْ شئتَ أنبأتُكَ بأبوابِ الجنَّةِ». قلتُ: أجَلْ يا رسولَ اللهِ. قالَ: «الصَّومُ جُنَّةٌ، والصَّدقةُ تُكفِّرُ الخطيئةَ، وقيامُ الرَّجلِ في جوفِ اللَّيلِ يَبتغي وجهَ اللهِ». قالَ: ثُمَّ قَرَأَ هذه الآيةَ: {تَتَجَافَى جُنُوبُهُمْ عَنِ الْمَضَاجِعِ يَدْعُونَ رَبَّهُمْ خَوْفًا وَطَمَعًا وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ} [السجدة: 16] قالَ: «وإنْ شئتَ أنبأتُكَ برأسِ الأمرِ وعمودِهِ وذُروةِ سَنامِهِ» . قالَ: قلتُ: أجَلْ يا رسولَ اللهِ. قالَ: «أمَّا رأسُ الأمرِ فالإسلامُ، وأمَّا عمودُهُ فالصَّلاةُ، وأمَّا ذُروةُ سَنامِهِ فالجهادُ في سبيلِ اللهِ، وإنْ شئتَ أنبأتُكَ بأمْلَكِ ذلك كُلِّهِ». قالَ: فسَكَتَ، فإذا راكبانِ يُوضِعانِ قِبَلَنا، فخَشيتُ أنْ يَشغلاهُ عنْ حاجتي. قالَ: فقلتُ: ما هو يا رسولَ اللهِ؟ قالَ: فأَهْوَى بإصبَعِهِ إلى فيهِ. قالَ: فقلتُ: يا رسولَ اللهِ، وإنَّا لنُؤاخذُ بما نقولُ بألسِنَتِنا؟ قالَ: «ثَكِلتكَ أمُّكَ ابنَ جَبلٍ، ",["هل يَكُبُّ النَّاسَ على مَناخِرِهم في جهنَّمَ إلَّا",2]," ",["حصائدُ ألسنَتِهمْ",1],"؟».]"],"grade":"صحيح","narrator":"[معاذ بن جبل]","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (5/ 12)، والنسائي (2224 )، وابن ماجة (3973 )","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"snTBq0Xu","merged":6,"otherRefs":["البحر الزخار 6/273 (حسن)","مجمع الزوائد 10/303 (حسن)","الترغيب والترهيب 4/23 (صحيح)","الأحكام الشرعية الكبرى 3/156 (صحيح)","صحيح الترمذي 2616 (صحيح)"]},{"id":"س-01334","fp":"b95f4095c955","stateId":762,"easy":"إذا أكثرتن اللعن وكفرتن العشير ← تكنّ أكثر أهل النار","cause":"بكثرةِ لَعْنِكُنَّ وكُفرِكُنَّ العَشيرَ","result":"فإني رأيتُكُنَّ أكْثرَ أهلِ النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-06327","ref":"تخريج مشكل الآثار 2728","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ خطَبَ فوعَظَ، ثمَّ قال: يا مَعشرَ النِّساءِ، تَصدَّقْنَ ",["فإني رأيتُكُنَّ أكْثرَ أهلِ النَّارِ",2],"، فقالت له امرأةٌ: ولِمَ ذاك يا رسولَ اللهِ؟ قال: ",["بكثرةِ لَعْنِكُنَّ وكُفرِكُنَّ العَشيرَ",1],"، وما رأيْتُ من ناقصاتِ عقلٍ ودِينٍ أغلبَ لِألبابِ ذَوِي الرأْيِ منكُنَّ، فقالتِ امرأةٌ: يا رسولَ اللهِ، وما نُقصانُ عُقولِنا ودِينِنا؟ قال: شَهادةُ امرأتَيْنِ منكُنَّ بشَهادةِ رجُلٍ، ونُقصانُ دِينِكُنَّ الحَيْضةُ: تمكُثُ إحداكُنَّ الثلاثَ والأربعَ لا تُصلِّي."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (2728) واللفظ له، والترمذي (2613)، والنسائي في الكبرى (9226)، وابن أبي عاصم في ((السنة)) (956) باختلاف يسير","bab":"نكاح › عشرة النساء","dorar":"svZdHtPH"},{"id":"س-04949","fp":"4826462fa521","stateId":763,"easy":"إذا ظللت تسأل الناس ← تأتي يوم القيامة وليس في وجهك مزعة لحم","cause":"لا يَزالُ الرَّجُلُ يسأَلُ النَّاسَ","result":"حتى يأْتيَ يومَ القِيامةِ وليْسَ في وجهِهِ مُزْعةُ لحْمٍ","explicit":true,"star":true,"ref":"تخريج مشكل الآثار 1022","srcLabel":"متفق عليه","text":[["لا يَزالُ الرَّجُلُ يسأَلُ النَّاسَ",1]," ",["حتى يأْتيَ يومَ القِيامةِ وليْسَ في وجهِهِ مُزْعةُ لحْمٍ",2],"، وقال: إنَّ الشَّمسَ تَدْنو حتى يبلُغَ العَرَقُ نِصفَ الأُذُنِ، فبَيْنا هُم كذلك، استَغاثوا بآدَمَ صلَّى اللهُ عليه وسلَّمَ فيقولُ: لسْتُ صاحبَ ذاكَ، ثمَّ بموسى صلَّى اللهُ عليه وسلَّمَ، فيقولُ ذلك، ثمَّ بمحمَّدٍ صلَّى اللهُ عليه وعليهم أجمَعينَ فيَشفَعُ لِيقُضَى بيْنَ الخَلْقِ، فيَمْشي حتى يأخُذَ بحَلْقةِ الجَنَّةِ، فيَومَئِذٍ يبعَثُهُ اللهُ مَقامًا محمودًا، يحمَدُهُ أهلُ الجَمعِ كلُّهم."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1474، 1475) باختلاف يسير، ومسلم (1040) مختصراً باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"7v5iODoE","merged":5,"otherRefs":["مسند عمر 1/15 (صحيح)","صحيح النسائي 2584 (صحيح)","حلية الأولياء 3/192 (صحيح)","صحيح مسلم 1040 (صحيح)"]},{"id":"س-04239","fp":"800629cc3468","stateId":763,"easy":"إذا سألت الناس بلا حاجة فخرجت بها ← فما هي لك إلا نار","cause":"لَيسأَلُني المَسأَلةَ، فأُعْطيها إيَّاه، فيَخرُجُ بها مُتَأَبِّطُها","result":"وما هي لهم إلَّا نارٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-05013"],"ref":"تخريج المسند لشعيب 11123","srcLabel":"البخاري","text":["قال عمرُ: يا رسولَ اللهِ، سمِعْتُ فُلانًا يقولُ خَيرًا، ذكَر أنَّكَ أَعطَيْتَه دينارَيْنِ، قال: \"لكنْ فُلانٌ لا يقولُ ذلك، ولا يُثْني به، لقد أَعطَيْتُه ما بيْنَ العَشَرةِ إلى المِئَةِ -أو قال: إلى المِئَتيْنِ- وإنَّ أَحَدَهم ",["لَيسأَلُني المَسأَلةَ، فأُعْطيها إيَّاه، فيَخرُجُ بها مُتَأَبِّطُها",1],"، ",["وما هي لهم إلَّا نارٌ",2],"\"، قال عمرُ: يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فلمَ تُعْطيهم؟ قال: \"إنَّهم يأبَوْنَ إلَّا أنْ يَسأَلوني، ويأْبى اللهُ لي البُخْلَ\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه أحمد (11123) واللفظ له، والبزار (224)، وأبو يعلى (1327)","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"VQcCCCeA","merged":6,"otherRefs":["مسند عمر 1/3 (صحيح)","الترغيب والترهيب 2/48 (صحيح)","المستدرك على الصحيحين 144 (صحيح)","تخريج مشكل الآثار 5936 (صحيح)","صحيح ابن حبان 3265 (صحيح)"]},{"id":"س-04301","fp":"568dda8ea46f","stateId":763,"easy":"إذا سألت عن ظهر غنى ← استكثرت بها من رضف جهنم","cause":"مَن سألَ مَسْألةً عن ظَهْرِ غِنًى","result":"اسْتَكْثَرَ بها مِن رَضْفِ جَهَنَّمَ","explicit":true,"star":true,"similar":["س-03056","س-05224","س-02993"],"ref":"الأحاديث المختارة 519","srcLabel":"البخاري","text":["«",["مَن سألَ مَسْألةً عن ظَهْرِ غِنًى",1]," ",["اسْتَكْثَرَ بها مِن رَضْفِ جَهَنَّمَ",2],"، قالوا: ما ظَهْرُ غِنًى؟ قالَ: عَشاءٌ»."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"emjn9sZf"},{"id":"س-03056","fp":"2bd16ed20500","stateId":763,"easy":"إذا سألت وأنت تجد غنى ← فإنما تستكثر من النار","cause":"مَن سألَ مسألةً، وَهوَ يجدُ عنها غَناءً","result":"فإنَّما يستَكْثرُ منَ النَّارِ","explicit":true,"repOf":"س-04301","ref":"صحيح ابن خزيمة 2391","text":[["مَن سألَ مسألةً، وَهوَ يجدُ عنها غَناءً ",1],["فإنَّما يستَكْثرُ منَ النَّارِ ",2],". قيلَ يا رسولَ اللَّهِ وما الغَناءُ الَّذي لا ينبغي معَهُ المسألةُ ؟ قالَ : أن يَكونَ لهُ شِبعُ يومٍ وليلةٍ أو ليلةٍ ويومٍ ."],"grade":"صحيح","narrator":"سهل ابن الحنظلية الأنصاري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أبو عبيد في ((الأموال)) (1737) باختلاف يسير، وأبو داود (1629)، وأحمد (17625) مطولًا.","bab":"إيمان › الوعيد","dorar":"JN6Mc5Ax"},{"id":"س-03089","fp":"cca8bd6b7d85","stateId":763,"easy":"إذا سألت الناس ولك ما يغنيك ← تأتي يوم القيامة ومسألتك في وجهك خموش","cause":"مَن سَألَ الناسَ ولَه ما يُغنِيهِ","result":"جاءَ يَومَ القيامةِ ومسألَتُه في وَجهِه خُموشٌ، أو خُدوشٌ، أو كُدوحٌ","explicit":true,"similar":["س-02995","س-03076","س-03077","س-06211","س-06212","س-02974"],"ref":"تخريج شرح السنة 1600","srcLabel":"أبو داود","text":[["مَن سَألَ الناسَ ولَه ما يُغنِيهِ",1],"، ",["جاءَ يَومَ القيامةِ ومسألَتُه في وَجهِه خُموشٌ، أو خُدوشٌ، أو كُدوحٌ",2],". قيلَ: يا رَسولَ اللهِ، وما يُغنِيهِ؟ قال: خَمسونَ دِرهمًا أو قيمَتُها مِنَ الذَّهَبِ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1626)، والترمذي (650) واللفظ له، والنسائي (2592)","bab":"إيمان › الوعيد","dorar":"UPOykHt7","merged":6,"otherRefs":["صحيح أبي داود 1626 (صحيح)","مسند عمر 1/23 (صحيح)","صحيح النسائي 2591 (صحيح)","السلسلة الصحيحة 499 (صحيح)","صحيح ابن ماجه 1502 (صحيح)"]},{"id":"س-02929","fp":"74619a75b858","stateId":763,"easy":"إذا سألت الناس من غير فقر ← فكأنما تأكل الجمر","cause":"من سأل من فقرٍ","result":"فكأنما يأكلُ الجمرَ","explicit":true,"similar":["س-02937"],"otherNeedIds":[3],"ref":"الزواجر عن اقتراف الكبائر 1/184","srcLabel":"الزواجر عن اقتراف الكبائر","text":[["من سأل من فقرٍ",1]," ",["فكأنما يأكلُ الجمرَ",2]," ، وفي روايةِ البيهقيِّ : الذي يسألُ الناسَ من غيرِ حاجةٍ كمثلِ الذي يلتقطُ الجمرَ"],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"إيمان › الوعيد","dorar":"8NFkPC8S","merged":5,"otherRefs":["صحيح ابن خزيمة 4/ 168 (صحيح)","تخريج المسند لشعيب 17509 (صحيح)","تخريج صحيح ابن حبان 3393 (صحيح)","تخريج المسند لشعيب 7163 (صحيح)"]},{"id":"س-05233","fp":"ede867d3b438","stateId":763,"easy":"إذا أخلقت وجهك بالسؤال ← تأتي وليس في وجهك مزعة لحم","cause":"أَخلقُوها بالسؤالِ","result":"ليستْ في وجوهِهمْ مُزعةٌ مِنْ لحمٍ","explicit":true,"ref":"النوافح العطرة 285","srcLabel":"متفق عليه","text":["ليجيئنَّ أقوامٌ يومَ القيامةِ ",["ليستْ في وجوهِهمْ مُزعةٌ مِنْ لحمٍ",2]," قدْ ",["أَخلقُوها بالسؤالِ",1]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن","takhrij":"أخرجه الطبراني (12/310) (13207) دون قوله: \"بالسؤال\"، وأصله في صحيح البخاري (1474)، ومسلم (1040)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"P7m4xMDc"},{"id":"س-00472","fp":"a7e9c92ede52","stateId":763,"easy":"إذا سألت وعندك ما يغنيك ← فإنما تستكثر من نار جهنم","cause":"مَن سَألَ وعنْدَه ما يُغْنيه","result":"فإنَّما يَسْتكثِرُ مِن نارِ جَهَنَّمَ","explicit":true,"ref":"الصحيح المسند 461","srcLabel":"الصحيح المسند","text":["أنَّ عُيَيْنةَ والأَقرَعَ سَألا رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ شَيئًا، فأمَرَ مُعاوِيةَ أن يَكتُبَ به لهما، ففَعَلَ، وخَتَمَها رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، وأمَرَ بدَفْعِه إليهما، فأمَّا عُيَيْنةُ فقالَ: ما فيه؟ قالَ: فيه الَّذي أمَرْتَ به، فقَبِلَه وعَقَدَه في عِمامتِه، وكانَ أَحكَمَ الرَّجُلَينِ، وأمَّا الأَقرَعُ فقالَ: أَحمِلُ صَحيفةً لا أَدْري ما فيها، كصَحيفةِ المُتَلَمِّسِ؟ فأَخبَرَ مُعاوِيةُ رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ بقَوْلِهما، وخَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ في حاجتِه، فمَرَّ ببَعيرٍ مُناخٍ على بابِ المَسجِدِ مِن أوَّلِ النَّهارِ، ثُمَّ مَرَّ به آخِرَ النَّهارِ وهو على حالِه، فقالَ: أين صاحِبُ هذا البَعيرِ؟ فابْتُغِيَ، فلم يوجَدْ، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ: اتَّقوا اللهَ في هذه البَهائِمِ، ثُمَّ ارْكَبوها صِحاحًا، وارْكَبوها سِمانًا، كالمُتَسخِّطِ آنِفًا، إنَّه ",["مَن سَألَ وعنْدَه ما يُغْنيه، ",1],["فإنَّما يَسْتكثِرُ مِن نارِ جَهَنَّمَ",2],"، قالوا يا رَسولَ اللهِ: وما يُغْنيه؟ قالَ: ما يُغَدِّيه أو يُعَشِّيه."],"grade":"صحيح","narrator":"سهل ابن الحنظلية الأنصاري","muhaddith":"صحيح","bab":"آداب عامة › الرفق بالحيوان والطير ونحوهما","dorar":"FsqHGIcm","merged":3,"otherRefs":["صحيح الترغيب 805 (صحيح)","صحيح أبي داود 1629 (صحيح)"]},{"id":"س-02995","fp":"4a7e5a5e1985","stateId":763,"easy":"إذا سألت مسألة وأنت عنها غني ← تأتي يوم القيامة كدوحاً في وجهك","cause":"من سأل مسألةً وهو عنها غَنِيٌّ","result":"جاءت يومَ القيامةِ كُدُوحًا في وجهِه","explicit":true,"repOf":"س-03089","ref":"تخريج المسند لشاكر 6/200","text":[["من سأل مسألةً وهو عنها غَنِيٌّ",1]," ",["جاءت يومَ القيامةِ كُدُوحًا في وجهِه",2]," ولا تَحِلُّ الصدقةُ لمن له خمسونَ درهمًا أو عِوضُها من الذهبِ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1626)، والترمذي (650)، والنسائي (2592)، وابن ماجه (1840)، وأحمد (4440) واللفظ له","bab":"إيمان › الوعيد","dorar":"6PdEQMZq","merged":3,"otherRefs":["عمدة القاري 9/71 (صحيح)","صحيح الترغيب 800 (صحيح)"]},{"id":"س-03075","fp":"d1afdd8c638d","stateId":763,"easy":"إذا سألت الناس ← فالمسائل كدّ تكدّ بها وجهك","cause":"المَسَائِلَ","result":"كَدٌّ يكدُّ بها الرجلُ وجهَه","explicit":true,"ref":"مسند عمر 1/16","srcLabel":"الترمذي","text":["عن سَمُرةَ بنِ جُندبٍ قال قال رسولُ اللهِ صلَّى اللهُ عليهِ وسلمَ  إنَّ ",["المَسَائِلَ",1]," ",["كَدٌّ يكدُّ بها الرجلُ وجهَه",2]," إلا أن يسألَ ذا سلطانٍ أو في أمرٍ لا بُدَّ منه قال وقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلمَ  مسألةُ الرجلِ شَينٌ يومَ القيامةِ في وجهِه خدوشٌ أو كدوحٌ"],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (681)، والنسائي (2600)، وأحمد (20106) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"sIyNMl6o","merged":3,"otherRefs":["حلية الأولياء 7/418 (صحيح)","تخريج المسند لشعيب 20219 (صحيح)"]},{"id":"س-03054","fp":"da7613faa0e3","stateId":763,"easy":"إذا سألت الناس لتثري مالك ← فإنما هو جمر من النار","cause":"مَنْ سألَ الناسَ لِيُثْرِيَ مالهُ","result":"فإنَّما هو رَضْفٌ مِنَ النارِ يَتَلَهَّبُهُ","explicit":true,"similar":["س-03081"],"ref":"صحيح الموارد 703","srcLabel":"ابن حبان","text":[["مَنْ سألَ الناسَ لِيُثْرِيَ مالهُ ؛ ",1],["فإنَّما هو رَضْفٌ مِنَ النارِ يَتَلَهَّبُهُ ، ",2],"مَنْ شاءَ فَلِيُقِلَّ ، ومَنْ شاءَ فَلِيُكْثِرْ"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن حبان (3391) واللفظ له، وتمام في ((الفوائد)) (1771)، وابن عساكر في ((تاريخ دمشق)) (52/48)","bab":"إيمان › الوعيد","dorar":"kpfjJ6ue","merged":2,"otherRefs":["مسند الفاروق 1/254 (صحيح)"]},{"id":"س-03086","fp":"c7f7747a9bb1","stateId":763,"easy":"إذا سألت بلا حاجة نزلت بك ← تأتي يوم القيامة وليس على وجهك مزعة لحم","cause":"مَن سأَل في غيرِ حاجةٍ نزَلَتْ به أو عِيالٍ لا يُطيقُهم","result":"جاء يومَ القيامةِ ووَجْهُه ليس عليه مُزْعَةُ لَحْمٍ","explicit":true,"ref":"الضعفاء الكبير 1/214","srcLabel":"البيهقي","text":[["مَن سأَل في غيرِ حاجةٍ نزَلَتْ به أو عِيالٍ لا يُطيقُهم",1],"، ",["جاء يومَ القيامةِ ووَجْهُه ليس عليه مُزْعَةُ لَحْمٍ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"يروى بغير هذا اللفظ من وجه ثابت","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (3526)، والطبري في ((تهذيب الآثار-مسند عمر)) (21) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"K6gKtlqq","merged":2,"otherRefs":["الترغيب والترهيب 2/32 (صحيح)"]},{"id":"س-03090","fp":"9d02939adcbd","stateId":763,"easy":"إذا سألت الناس لتثري مالك ← تكون خموشاً في وجهك ورضفاً تأكله من جهنم","cause":"ومَن سألَ الناسَ لِيُثريَ به مالَه","result":"كانَ خُموشًا في وَجهِه يَومَ القيامةِ، ورَضْفًا يأكُلُه مِن جَهنَّمَ","explicit":true,"otherNeedIds":[3],"ref":"تخريج شرح السنة 1623","srcLabel":"الترمذي","text":["سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ في حَجَّةِ الوَداعِ وهو واقِفٌ بعَرَفةَ، أتاه أعرابيٌّ، فأخَذَ بطَرفِ رِدائِه، فسألَه إيَّاه، فأَعْطاه وذهَبَ، فعِندَ ذلك حُرِّمَتِ المَسألةُ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّ المَسألةَ لا تَحِلُّ لِغَنيٍّ، ولا لِذي مِرَّةٍ سَويٍّ، إلَّا لِذي فَقرٍ مُدقِعٍ، أو غُرمٍ مُفظِعٍ، ",["ومَن سألَ الناسَ لِيُثريَ به مالَه",1],"، ",["كانَ خُموشًا في وَجهِه يَومَ القيامةِ، ورَضْفًا يأكُلُه مِن جَهنَّمَ",2],"، فمَن شاءَ فلْيُقِلَّ، ومَن شاءَ فليُكثِرْ."],"grade":"صحيح","narrator":"حبشي بن جنادة السلولي","muhaddith":"[صحيح]","takhrij":"أخرجه البغوي في ((شرح السنة)) (1623)، والترمذي (653) بلفظه، والطبراني (4/ 14) (3504) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"gTlTJg1U","merged":2,"otherRefs":["صحيح الترغيب 802 (صحيح)"]},{"id":"س-02937","fp":"3eb6dc6bf87c","stateId":763,"easy":"إذا سألت بغير فقر ← فإنما تأكل النار","cause":"من سأل بغيرِ فقرٍ","result":"فإنما يأكلُ النارَ","explicit":true,"repOf":"س-02929","ref":"النوافح العطرة 383","text":[["من سأل بغيرِ فقرٍ ",1],["فإنما يأكلُ النارَ",2]],"grade":"صحيح","muhaddith":"رجاله رجال الصحيح","bab":"إيمان › الوعيد","dorar":"8fDjY2Je"},{"id":"س-03076","fp":"8261cb8c873a","stateId":763,"easy":"إذا سألت الناس ← تأتي يوم القيامة وفي وجهك خدوش","cause":"مسألةُ الرجلِ","result":"شَينٌ يومَ القيامةِ في وجهِه خدوشٌ أو كدوحٌ","explicit":true,"repOf":"س-03089","ref":"مسند عمر 1/16","text":["عن سَمُرةَ بنِ جُندبٍ قال قال رسولُ اللهِ صلَّى اللهُ عليهِ وسلمَ  إنَّ المَسَائِلَ كَدٌّ يكدُّ بها الرجلُ وجهَه إلا أن يسألَ ذا سلطانٍ أو في أمرٍ لا بُدَّ منه قال وقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلمَ  ",["مسألةُ الرجلِ",1]," ",["شَينٌ يومَ القيامةِ في وجهِه خدوشٌ أو كدوحٌ",2]],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (681)، والنسائي (2600)، وأحمد (20106) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"sIyNMl6o"},{"id":"س-03077","fp":"ab9bcf0e74c2","stateId":763,"easy":"إذا سألت وأنت غني ← فهو شين في وجهك يوم القيامة","cause":"مسألةُ الغَنيِّ","result":"شَيْنٌ في وجهِهِ يومَ القيامةِ","explicit":true,"repOf":"س-03089","ref":"مسند عمر 1/25","text":[["مسألةُ الغَنيِّ",1]," ",["شَيْنٌ في وجهِهِ يومَ القيامةِ",2]," أو خَموشٌ"],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (19821) مختصراً، والبزار (3572)، والطبراني (18/175) (400) مطولاً باختلاف يسير، والطبري في ((مسند عمر)) (35) واللفظ له.","bab":"إيمان › الوعيد","dorar":"Wz6PknEF"},{"id":"س-03081","fp":"763152e294ea","stateId":763,"easy":"إذا سألت الناس لتثري مالك ← فإنما هو حجارة محماة من النار","cause":"من سأل النَّاسَ ليُثريَ مالَه","result":"فإنَّما هي رَضْفٌ من النَّارِ مُلهِبةٌ فمن شاء فليُقِلَّ ومن شاء فليُكثِرْ","explicit":true,"repOf":"س-03054","ref":"الترغيب والترهيب 2/35","text":[["من سأل النَّاسَ ليُثريَ مالَه ",1],["فإنَّما هي رَضْفٌ من النَّارِ مُلهِبةٌ فمن شاء فليُقِلَّ ومن شاء فليُكثِرْ",2]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن حبان (3391)، وتمام في ((الفوائد)) (1771)، وابن عساكر في ((تاريخ دمشق)) (52/48) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"CaRWmmAP"},{"id":"س-05224","fp":"7980406e34cc","stateId":763,"easy":"إذا سألت الناس عن ظهر غنى ← فإنما تستكثر من جمر جهنم","cause":"من يسألُ الناسَ عن ظهرِ غنًى","result":"فإنما يستكثرُ من جمرِ جهنمَ","explicit":true,"repOf":"س-04301","ref":"مسند عمر 1/25","text":["عن سهلِ بنِ الحنظليةَ أنه سمع رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يقولُ ",["من يسألُ الناسَ عن ظهرِ غنًى ",1],["فإنما يستكثرُ من جمرِ جهنمَ",2]," قلتُ يا رسولَ اللهِ ما ظهرُ الغِنى قال أن يعلمَ أن عندَ أهلِه ما يُغدِّيهم أو يُعشِّيهِم قال أبو كبشةَ لا أسألُ بعد هذا أحدًا"],"grade":"صحيح","narrator":"سهل ابن الحنظلية الأنصاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن زنجويه في ((الأموال)) (2077) واللفظ له، والطبراني في ((الشاميين)) (584) بلفظه مطولًا، وأبو داود (1629) بنحوه مطولًا.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"IK9N9Y8o"},{"id":"س-06211","fp":"742e9809282d","stateId":763,"easy":"إذا سألت الناس ← تكون المسألة كدوحاً في وجهك يوم القيامة","cause":"المسألةُ","result":"كُدُوحٌ في وجْهِ صاحِبِها يَومَ القيامةِ","explicit":true,"repOf":"س-03089","ref":"تخريج المسند لشعيب 5680","text":[["المسألةُ",1]," ",["كُدُوحٌ في وجْهِ صاحِبِها يَومَ القيامةِ",2],"، فمَن شاء فلْيَسْتَبْقِ على وجْهِه، وأَهْوَنُ المسألةِ مَسألةُ ذِي الرَّحِمِ تَسألُه في حاجةٍ، وخَيْرُ المَسألةِ المسألةُ عن ظَهرِ غِنًى، وابْدَأْ بمَن تَعُولُ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (5680)، والبيهقي في ((شعب الإيمان)) (3510)","bab":"سؤال › من تحل له المسألة","dorar":"pfS7gLvb"},{"id":"س-06212","fp":"dea874edaa68","stateId":763,"easy":"إذا سألت ولك ما يغنيك ← تأتي يوم القيامة وفي وجهك شين أو خدوش","cause":"لا يَسألُ عبدٌ مسألةً وله ما يُغنيهِ","result":"إلَّا جاءتْ شَيْنًا، أو كُدوحًا، أو خُدوشًا في وجهِهِ يومَ القِيامةِ","explicit":true,"repOf":"س-03089","ref":"تخريج مشكل الآثار 489","text":["فذكَر بإسنادِهِ مِثْلَهُ. غيْرَ أنَّه قال: كُدوحًا في وجهِهِ، ولمْ يشُكَّ. [يعني حديثَ: ",["لا يَسألُ عبدٌ مسألةً وله ما يُغنيهِ",1]," ",["إلَّا جاءتْ شَيْنًا، أو كُدوحًا، أو خُدوشًا في وجهِهِ يومَ القِيامةِ",2],"، قيلَ: يا رسولَ اللهِ، وما غِناهُ؟ قال: خمسونَ دِرهمًا، أو حِسابُها منَ الذَّهَبِ.]"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1626)، والترمذي (650)، والنسائي (2592) باختلاف يسير","bab":"سؤال › من تحل له المسألة","dorar":"VmRopH5w"},{"id":"س-05013","fp":"e654b0c41412","stateId":763,"easy":"إذا سألت بلا حاجة ← فلا تحمل في حضنك إلا النار","cause":"إِنَّ الرجلَ يأتينِي مِنكمْ ، فَيَسْأَلُنِي","result":"فَأُعْطِيهِ ، فَيَنْطَلِقُ وما يَحْمِلُ في حُضْنِهِ إلَّا النارَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04239","ref":"صحيح الموارد 700","text":[["إِنَّ الرجلَ يأتينِي مِنكمْ ، فَيَسْأَلُنِي ",1],["فَأُعْطِيهِ ، فَيَنْطَلِقُ وما يَحْمِلُ في حُضْنِهِ إلَّا النارَ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (2504)، وعبد بن حميد (1111)، وابن أبي شيبة كما في ((المطالب العالية)) (938) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"J831sCnX","merged":2,"otherRefs":["صحيح الترغيب 842 (صحيح)"]},{"id":"س-02974","fp":"4b230dda81a5","stateId":763,"easy":"إذا سألت الناس وأنت غني ← تأتي يوم القيامة وفي وجهك كدوح وخدوش","cause":"مَن سألَ الناسَ وهو غَنيٌّ","result":"جاء يومَ القيامةِ وفي وَجهِه كُدوحٌ وخُدوشٌ","explicit":true,"repOf":"س-03089","ref":"تخريج سنن الدارقطني 2002","text":[["مَن سألَ الناسَ وهو غَنيٌّ ",1],["جاء يومَ القيامةِ وفي وَجهِه كُدوحٌ وخُدوشٌ",2],"، فقيلَ: يا رسولَ اللهِ، ما غِناهُ؟ قال: أرْبعونَ دِرهمًا أو قِيمَتُها ذَهَبًا."],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"حسن","takhrij":"أخرجه أبو داود (1626)، والترمذي (650)، والنسائي (2592) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"MzhAJMFi"},{"id":"س-02993","fp":"a3edb170a6b3","stateId":763,"easy":"إذا سألت عن غنى ← فإنما تسأل جمراً","cause":"من سألَ عن ظهرِ غِنى","result":"فإنّما يسأَلُ جمرًا فليستقلّ أو ليستكثِر","explicit":true,"repOf":"س-04301","ref":"تخريج الإحياء للعراقي 4/263","text":[["من سألَ عن ظهرِ غِنى ",1],["فإنّما يسأَلُ جمرًا فليستقلّ أو ليستكثِر",2]," قالوا : وما ظهرُ غنى ؟ قال : عشاءُ ليلتهِ"],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"إسناده حسن","takhrij":"أخرجه عبدالله بن أحمد في ((زوائد المسند)) (1253)، والعقيلي في ((الضعفاء الكبير)) (1/223)، والطبراني في ((المعجم الأوسط)) (7078) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"71jRdqsW"},{"id":"س-03254","fp":"14373f97af2d","stateId":764,"easy":"إذا أدركت أبويك أو أحدهما فلم تبرهما فمت فدخلت النار ← أبعدك الله","cause":"ومن أدركَ أبويْهِ ، أو أحدَهما ، فلم يَبَرَّهما","result":"فماتَ ، فدخلَ النارَ ، فأبعدَهُ اللهُ","explicit":true,"star":true,"ref":"موارد الظمآن 2/900","srcLabel":"مسلم","text":["أنَّ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ صعدَ المنبَرَ ، فقال : آمينَ ، آمينَ ، آمينَ ، قيلَ : يا رسولَ اللهِ ، إنكَ صعدتَ المنبَرَ ، فقلتُ آمينَ ، آمينَ ، آمينَ ، فقال : إنَّ جبريلَ عليهِ السلامُ أتاني ، فقالَ لي : من أدركَ شهرَ رمضانَ فلم يُغفرْ لهُ ، فدخلَ النارَ فأبعدَهُ اللهُ ، قلْ : آمينَ ، فقلتُ : آمينَ ، ",["ومن أدركَ أبويْهِ ، أو أحدَهما ، فلم يَبَرَّهما",1]," ، ",["فماتَ ، فدخلَ النارَ ، فأبعدَهُ اللهُ",2]," ، قلْ : آمينَ ، فقلتُ : آمينَ ، ومن ذُكِرْتَ عندَهُ ، فلم يُصَلِّ عليكَ ، فماتَ ، فدخلَ النارَ ، فأبعدَهُ اللهُ ، قلْ آمينَ ، فقلتُ : آمينَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"في صحيح مسلم منه ما يتعلق ببر الوالدين بنحوه فقط","takhrij":"أخرجه ابن خزيمة (1888)، وابن حبان (907)، والطبراني في ((المعجم الأوسط)) (8131) باختلاف يسير. وقوله: \"ومن أدرك أبويه أو أحدهما فلم يبرهما فمات فدخل النار فأبعده الله\" أخرجه مسلم (2551) بلفظ مقارب","bab":"استغفار › أسباب المغفرة","dorar":"wrNPaZCt","merged":5,"otherRefs":["السلسلة الصحيحة 515 (صحيح)","صحيح الترغيب 2543 (صحيح)","صحيح الموارد 2024 (صحيح)","تخريج المسند لشعيب 20330 (صحيح)"]},{"id":"س-03816","fp":"b0e761a54b2e","stateId":764,"easy":"إذا تصارمت مع أخيك فوق ثلاثة أيام فمتما على ذلك ← هلكتما","cause":"ما مِن رجلَيْنِ يتصارمانِ فَوقَ ثلاثةِ أيامٍ فيَهلَكُ أحدُهما فماتا وهُما على ذلكَ مِن الصَّرامةِ","result":"إلَّا هلَكا جميعًا","explicit":true,"star":true,"ref":"صحيح الأدب المفرد 94","srcLabel":"البخاري","text":["كان ثَوبانُ يقولُ ",["ما مِن رجلَيْنِ يتصارمانِ فَوقَ ثلاثةِ أيامٍ فيَهلَكُ أحدُهما فماتا وهُما على ذلكَ مِن الصَّرامةِ",1]," ",["إلَّا هلَكا جميعًا",2]," وما مِن جارٍ يظلمُ جارَهُ ويقهرُهُ حتَّى يحملَهُ ذلكَ على أن يخرجَ مِن منزلِهِ إلَّا هلكَ"],"grade":"صحيح","narrator":"أبو عامر الحمصي","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (127) واللفظ له.","bab":"بر وصلة › حق الجار والوصاة به","dorar":"b6FAOS6n"},{"id":"س-04304","fp":"515ec8e0c033","stateId":764,"easy":"إذا أصبحت ساخطاً لوالديك ← يصبح لك بابان مفتوحان من النار","cause":"ومَن أَصبَحَ ساخِطًا لوالِدَيه","result":"أَصبَحَ له بابانِ مَفْتوحانِ مِن النَّارِ","explicit":true,"ref":"الأحاديث المختارة 11 / 228","srcLabel":"متفق عليه","text":["«مَن أَمْسى مُرْضِيًا لوالِدَيه -أَحسَبُه- أَصبَحَ له بابانِ مَفْتوحانِ إلى الجنَّةِ، ",["ومَن أَصبَحَ ساخِطًا لوالِدَيه",1]," ",["أَصبَحَ له بابانِ مَفْتوحانِ مِن النَّارِ",2],"، وإن واحِدٌ فواحِدٌ، فقالَ رَجُلٌ: يا رَسولَ اللهِ، وإن ظَلَماه؟ قالَ: وإن ظَلَماه، وإن ظَلَماه، ثَلاثَ مَرَّاتٍ»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"l8AJolNy"},{"id":"س-04988","fp":"5e3423532979","stateId":764,"easy":"إذا هجرت أخاك فوق ثلاث فمت ← دخلت النار","cause":"فمَن هجرَ أخاهُ فوقَ ثلاثٍ فماتَ","result":"دخلَ النَّارَ","explicit":true,"similar":["س-05278"],"ref":"الصحيح المسند 1307","srcLabel":"أبو داود","text":["لا يحلُّ لِمُسلِمٍ أن يَهجُرَ أخاهُ فوقَ ثلاثٍ، ",["فمَن هجرَ أخاهُ فوقَ ثلاثٍ فماتَ ",1],["دخلَ النَّارَ ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (4914) واللفظ له، وأحمد (9092)، والنسائي في ((الكبرى)) (9116) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"X5q5P22p","merged":2,"otherRefs":["فيض القدير 6/ 234 (صحيح)"]},{"id":"س-00256","fp":"431c8807ee40","stateId":764,"easy":"إذا اعتذر إليك أخوك فلم تقبل ← لن ترد على النبي ﷺ الحوض","cause":"ومَن تُنُصِّلَ إليه فلم يَقْبَلْ","result":"فلن يَرِدَ عَلَىَّ الحَوْضَ","explicit":true,"similar":["س-06112"],"ref":"الجامع الصغير 3124","srcLabel":"الحاكم","text":["بِرُّوا آباءَكم تَبَرَّكم أبناؤُكم ، وعِفُّوا عن النساءِ ، تَعِفَّ نساؤُكم ، ",["ومَن تُنُصِّلَ إليه فلم يَقْبَلْ ",1],["فلن يَرِدَ عَلَىَّ الحَوْضَ",2],"."],"grade":"صحيح","narrator":"جابر","muhaddith":"صحيح","takhrij":"أخرجه العقيلي في ((الضعفاء)) (3/ 249)، والحاكم (7259) كلاهما بلفظه، والطبراني في ((المعجم الأوسط)) (1029) مختصرا ببعض لفظه.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"jQMsjCC7"},{"id":"س-03849","fp":"b3441989e4e2","stateId":764,"easy":"إذا قطعت رحمك ← تشهد عليك بالقطيعة يوم القيامة","cause":"إن كان قطعها","result":"وعليه بقطيعةٍ","explicit":true,"otherNeedIds":[44],"ref":"صحيح الأدب المفرد 54","srcLabel":"البخاري (الأدب المفرد)","text":["عن ابنِ عباسٍ أنه قال احفظوا أنسابَكم تصلوا أرحامَكم فإنه لا بعد بالرحمِ إذا قربت وإن كانت بعيدةً ولا قُربَ بها إذا بعدت وإن كانت قريبةً وكلُّ رحمٍ آتيةٌ يومَ القيامةِ أمام صاحبِها تشهدُ له بصلةٍ إن كان وصلها ",["وعليه بقطيعةٍ",2]," ",["إن كان قطعها",1]],"grade":"صحيح","muhaddith":"صحيح الإسناد وصح مرفوعا","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"woiNIi8Y"},{"id":"س-05278","fp":"a31575b5f4ae","stateId":764,"easy":"إذا هجرت أخاك فوق ثلاث ← فأنت في النار إلا أن يتداركك الله برحمته","cause":"مَن هَجَرَ أخاه فوقَ ثَلاثٍ","result":"فهو في النَّارِ إلَّا أن يَتَدارَكَه اللهُ برَحمَتِه","explicit":true,"repOf":"س-04988","ref":"تنبيه الغافلين 185","text":["«",["مَن هَجَرَ أخاه فوقَ ثَلاثٍ ",1],["فهو في النَّارِ إلَّا أن يَتَدارَكَه اللهُ برَحمَتِه»",2]],"grade":"صحيح","narrator":"فضالة بن عبيد","muhaddith":"رجاله رجال الصحيح.","takhrij":"أخرجه ابن أبي شيبة (25371)، والطبراني في ((الكبير)) (18/ 315) (815) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Cp6ZjIgC"},{"id":"س-06112","fp":"96f30d2b5bd6","stateId":764,"easy":"إذا أتاك أخوك معتذراً فلم تقبل ← لن ترد على النبي ﷺ الحوض","cause":"ومَنْ أتاهُ أخوهُ مُتَنَصِّلًا فلْيَقْبَلْ ذلِكَ منْهُ ، مُحِقًّا كانَ أوْ مُبْطِلًا","result":"فإِنْ لم يَفْعَلْ لَمْ يَرِدْ عَلَيَّ الحوْضَ","explicit":true,"repOf":"س-00256","ref":"الجامع الصغير 5424","text":["عِفُّوا عنِ نساءِ الناسِ تعِفَّ نساؤُكم ، وبِرُّوا آباءَكُم تبرَّكُمْ أبناؤُكُمْ ، ",["ومَنْ أتاهُ أخوهُ مُتَنَصِّلًا فلْيَقْبَلْ ذلِكَ منْهُ ، مُحِقًّا كانَ أوْ مُبْطِلًا ، ",1],["فإِنْ لم يَفْعَلْ لَمْ يَرِدْ عَلَيَّ الحوْضَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الحاكم في ((مستدركه)) (7258)، والشجري في ((أماليه)) (1982) واللفظ لهما.","bab":"رقائق وزهد › مكارم الأخلاق والعفو عمن ظلم","dorar":"B4Sv4Ht8"},{"id":"س-04217","fp":"9302202bfe2d","stateId":764,"easy":"إذا أمسيت عاصياً لله في والديك ← يصبح لك بابان مفتوحان من النار","cause":"ومن أمسَى عاصيًا للهِ في والدَيهِ","result":"أصبَحَ لهُ بابانِ مفتوحانِ من النَّارِ","explicit":true,"ref":"لسان الميزان 5/39","srcLabel":"البيهقي","text":["مَن أصبَحَ مُطيعًا للهِ في والِدَيهِ : أصبح لهُ بابانِ مَفتوحانِ مِن الجنَّةِ ، وإن كانَ واحدًا فواحدٌ ، ",["ومن أمسَى عاصيًا للهِ في والدَيهِ",1]," : ",["أصبَحَ لهُ بابانِ مفتوحانِ من النَّارِ",2]," ، وإن كانَ واحدًا فواحدٌ ، قال الرَّجلُ : وإن ظلَماهُ ؟ قال : وإن ظَلماهُ ، وإن ظَلماهُ ، وإن ظَلَماهُ"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"رجاله ثقات أثبات، غير عبد الله بن يحيى السرخسي، فهو آفته","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (7916)، وابن عساكر في ((تاريخ دمشق)) (33/365) باختلاف يسير.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"2XPIzW9C"},{"id":"س-05509","fp":"2b79e1954255","stateId":765,"easy":"إذا شاققت المسلمين ← يشقق الله عليك يوم القيامة","cause":"ومَن يُشاقِقْ","result":"يَشقُقِ اللهُ عليه يَومَ القيامةِ","explicit":true,"ref":"صحيح البخاري 7152","srcLabel":"البيهقي","text":["شَهِدتُ صَفوانَ وجُندَبًا وأصحابَه وهو يوصيهم، فقالوا: هل سَمِعتَ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم شيئًا؟ قال: سَمِعتُه يقولُ: مَن سَمَّعَ سَمَّعَ اللهُ به يَومَ القيامةِ، قال: ",["ومَن يُشاقِقْ",1]," ",["يَشقُقِ اللهُ عليه يَومَ القيامةِ",2],"، فقالوا: أوصِنا، فقال: إنَّ أوَّلَ ما يُنتِنُ مِنَ الإنسانِ بَطنُه، فمَنِ استَطاعَ أن لا يَأكُلَ إلَّا طَيِّبًا فليَفعَلْ، ومَنِ استَطاعَ أن لا يُحالَ بينَه وبينَ الجَنَّةِ بمِلءِ كَفِّه مِن دَمٍ أهراقَه فليَفعَلْ."],"grade":"صحيح","narrator":"جندب بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (5369)، وابن الحداد في ((جامع الصحيحين)) (2227)، والبغوي في ((معجم الصحابة)) (362) واللفظ لهم.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"kVcAd8Nq","merged":3,"otherRefs":["صحيح الجامع 6304 (صحيح)","المستدرك على الصحيحين 2380 (صحيح)"]},{"id":"س-02531","fp":"dcd5f5c6fda2","stateId":765,"easy":"إذا كنت ضعيفاً لا عزم لك تابعاً لا تبتغي أهلاً ولا مالاً ← فأنت من أهل النار","cause":"الضَّعيفُ الذي لا زَبْرَ له، الذينَ هُم فيكُم تَبَعًا، لا يَبتَغونَ أهلًا ولا مالًا، والخائِنُ الذي لا يَخفى له طَمَعٌ وإن دَقَّ إلَّا خانَه، ورَجُلٌ لا يُصبِحُ ولا يُمسي إلَّا وهو يُخادِعُكَ عن أهلِكَ ومالِكَ","result":"وأهلُ النَّارِ خَمسةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح مسلم 2865","srcLabel":"أبو داود","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال ذاتَ يَومٍ في خُطبَتِه: ألا إنَّ رَبِّي أمَرَني أن أُعَلِّمَكُم ما جَهِلتُم ممَّا عَلَّمَني يَومي هذا: كُلُّ مالٍ نَحَلتُه عَبدًا حَلالٌ، وإنِّي خَلَقتُ عِبادي حُنَفاءَ كُلَّهُم، وإنَّهُم أتَتْهمُ الشَّياطينُ فاجتالَتْهم عن دينِهم، وحَرَّمَت عليهم ما أحلَلتُ لهم، وأمَرَتْهم أن يُشرِكوا بي ما لَم أُنزِلْ به سُلطانًا، وإنَّ اللَّهَ نَظَرَ إلى أهلِ الأرضِ فمَقَتَهُم عَرَبَهُم وعَجَمَهُم إلَّا بَقايا مِن أهلِ الكِتابِ، وقال: إنَّما بَعَثتُكَ لأبتَليَكَ وأبتَليَ بكَ، وأنزَلتُ عليكَ كِتابًا لا يَغسِلُه الماءُ، تَقرَؤُه نائِمًا ويَقظانَ. وإنَّ اللَّهَ أمَرَني أن أُحَرِّقَ قُرَيشًا، فقُلتُ: رَبِّ، إذن يَثلَغوا رَأسي فيَدَعوه خُبزةً! قال: استَخرِجْهم كما استَخرَجوكَ، واغزُهم نُغزِكَ، وأنفِقْ فسَنُنفِقُ عليكَ، وابعَثْ جَيشًا نَبعَث خَمسةً مِثلَه، وقاتِلْ بمَن أطاعَكَ مَن عَصاكَ. قال: وأهلُ الجَنَّةِ ثَلاثةٌ: ذو سُلطانٍ مُقسِطٌ مُتَصَدِّقٌ موفَّقٌ، ورَجُلٌ رَحيمٌ رَقيقُ القَلبِ لكُلِّ ذي قُربى ومُسلِمٍ، وعَفيفٌ مُتَعَفِّفٌ ذو عيالٍ. قال: ",["وأهلُ النَّارِ خَمسةٌ",2],[": الضَّعيفُ الذي لا زَبْرَ له، الذينَ هُم فيكُم تَبَعًا، لا يَبتَغونَ أهلًا ولا مالًا، والخائِنُ الذي لا يَخفى له طَمَعٌ وإن دَقَّ إلَّا خانَه، ورَجُلٌ لا يُصبِحُ ولا يُمسي إلَّا وهو يُخادِعُكَ عن أهلِكَ ومالِكَ،",1]," وذَكَرَ البُخلَ -أوِ الكَذِبَ- والشِّنظيرُ الفَحَّاشُ. [وفي روايةٍ] لَم يُذكَر: وأنفِقْ فسَنُنفِقُ عليكَ. [وفي روايةٍ] لَم يُذكَر: كُلُّ مالٍ نَحَلتُه عَبدًا حَلالٌ. وفي روايةٍ: قامَ فينا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم ذاتَ يَومٍ خَطيبًا، فقال: إنَّ اللَّهَ أمَرَني... وساقَ الحَديثَ. وزادَ فيه: وإنَّ اللَّهَ أوحى إليَّ أن تَواضَعوا حتَّى لا يَفخَرَ أحَدٌ على أحَدٍ، ولا يَبغي أحَدٌ على أحَدٍ، وقال في حَديثِه: وهم فيكُم تَبَعًا، لا يَبغونَ أهلًا ولا مالًا. فقُلتُ [قتادة]: فيَكونُ ذلك يا أبا عبدِ اللهِ؟ قال: نَعَم، واللَّهِ لقد أدرَكتُهم في الجاهِليَّةِ، وإنَّ الرَّجُلَ لَيَرعى على الحَيِّ، ما به إلَّا وليدَتُهم، يَطَؤُها."],"grade":"صحيح","narrator":"عياض بن حمار","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (17484)، وابن حبان (653)، والطبراني في ((المعجم الكبير)) (17/ 358) (987)، وأبو داود الطيالسي (1175)، باختلاف يسير.","bab":"إيمان › أعمال الجن والشياطين","dorar":"wCEWyYoh","merged":2,"otherRefs":["تخريج صحيح ابن حبان 653 (صحيح)"]},{"id":"س-08335","fp":"f6029fd6e063","stateId":765,"easy":"إذا أثنى عليك المؤمنون شراً ← وجبت لك النار","cause":"ومَن أثنَيتُم عليه شَرًّا","result":"وجَبَت له النَّارُ","explicit":true,"star":true,"similar":["س-04117"],"ref":"صحيح مسلم 949","srcLabel":"متفق عليه","text":["مُرَّ بجِنازةٍ فأُثنيَ عليها خَيرًا، فقال نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّم: وجَبَت، وجَبَت، وجَبَت، ومُرَّ بجِنازةٍ فأُثنيَ عليها شَرًّا، فقال نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّم: وجَبَت، وجَبَت، وجَبَت، قال عُمَرُ: فِدًى لكَ أبي وأُمِّي، مُرَّ بجِنازةٍ، فأُثنيَ عليها خَيرٌ، فقُلتَ: وجَبَت، وجَبَت، وجَبَت، ومُرَّ بجِنازةٍ، فأُثنيَ عليها شَرٌّ، فقُلتَ: وجَبَت، وجَبَت، وجَبَت، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: مَن أثنَيتُم عليه خَيرًا وجَبَت له الجَنَّةُ، ",["ومَن أثنَيتُم عليه شَرًّا ",1],["وجَبَت له النَّارُ",2],"، أنتُم شُهَداءُ اللهِ في الأرضِ، أنتُم شُهَداءُ اللهِ في الأرضِ، أنتُم شُهَداءُ اللهِ في الأرضِ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1367)، ومسلم (949).","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"6C8bFfIJ","merged":11,"otherRefs":["مجموع الفتاوى 28/371 (صحيح)","شرح الطحاوية 378 (صحيح)","تخريج المسند لشعيب 10076 (صحيح)","صحيح البخاري 2642 (صحيح)","تخريج المسند لشعيب 13996 (صحيح)","صحيح النسائي 1932 (صحيح)","تخريج المسند لشعيب 10471 (صحيح)","تخريج المسند لشعيب 10836 (صحيح)","تخريج المسند لشعيب 10013 (صحيح)","تخريج المسند لشعيب 7552 (صحيح)"]},{"id":"س-05275","fp":"6d2d8f09d8d8","stateId":765,"easy":"إذا قطعت سدرة (يستظل بها الناس) ← يصوّب الله رأسك في النار","cause":"مَن قَطَعَ سِدْرةً","result":"صَوَّبَ اللهُ رَأسَه في النَّارِ","explicit":true,"star":true,"similar":["س-04805"],"ref":"الأحاديث المختارة 9 / 237","srcLabel":"متفق عليه","text":["«",["مَن قَطَعَ سِدْرةً",1]," ",["صَوَّبَ اللهُ رَأسَه في النَّارِ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن حبشي الخثعمي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"qAKlUB9R","merged":2,"otherRefs":["صحيح الجامع 4299 (صحيح)"]},{"id":"س-02301","fp":"261ca54f8b70","stateId":765,"easy":"إذا ساء خلقك ← قد يبلغ بك أسفل جهنم","cause":"وإنَّه لَيَبلُغُ بسُوءِ خُلُقِه","result":"أسفَلَ جَهَنَّمَ","explicit":true,"similar":["س-03082"],"ref":"الأحاديث المختارة 1812","srcLabel":"البخاري","text":["«إنَّ العَبْدَ لَيَبْلُغُ بحُسْنِ خُلُقِه عَظيمَ دَرَجاتِ الآخِرةِ وشَرَفَ المنازِلِ، وإنَّه لضَعيفُ العبادةِ، ",["وإنَّه لَيَبلُغُ بسُوءِ خُلُقِه",1]," ",["أسفَلَ جَهَنَّمَ",2]," وهو عابِدٌ»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Kwct6BL4"},{"id":"س-08425","fp":"bc6155c91630","stateId":765,"easy":"إذا نظرت في كتاب أخيك بغير إذنه ← فكأنما تنظر في النار","cause":"ومَن نظَرَ في كتابِ أخيهِ بغيرِ إذنِهِ","result":"فكأنَّما يَنظُرُ في النَّارِ","explicit":true,"similar":["س-05064"],"ref":"المستدرك على الصحيحين 7916","srcLabel":"عبد بن حميد","text":["عنْ مُحمَّدِ بنِ كعْبٍ القُرَظِيِّ، قالَ: شَهِدْتُ عُمَرَ بنَ عبدِ العزيزِ وهو أميرٌ علينا بالمدينةِ للوَليدِ بنِ عبدِ المَلِكِ، وهو شابٌّ غليظٌ مُمتلِئُ الجِسْمِ، فلَمَّا استُخْلِفَ أتَيتُه بخُناصِرَةَ، فدَخلْتُ عليهِ وقد قاسَى ما قاسَى، فإذا هو قدْ تغيَّرَتْ حالتُهُ عمَّا كان، ثُمَّ ذَكَرَ الحديثَ. \n وزادَ فيهِ: ",["ومَن نظَرَ في كتابِ أخيهِ بغيرِ إذنِهِ، ",1],["فكأنَّما يَنظُرُ في النَّارِ، ",2],"ومَن أحَبَّ أنْ يكونَ أقوى النَّاسِ فلْيَتوكَّلْ على اللهِ، ومَن أحَبَّ أنْ يكونَ أكرَمَ النَّاسِ فلْيَتَّقِ اللهَ عزَّ وجلَّ، ومَن أحَبَّ أنْ يكونَ أغْنى النَّاسِ فلْيَكُنْ بما في يَدِ اللهِ أوثَقَ ممَّا في يَدِهِ.\n وقالَ: أفأُنَبِّئُكُم بشَرٍّ مِن هذا؟ قالوا: نعَمْ يا رسولَ اللهِ، قالَ: مَن لا يُقيلُ عثْرَةً، ولا يَقبَلُ مَعذرةً، ولا يَغفِرُ ذنْبًا، أفأُنبِّئُكُم بشَرٍّ مِن هذا؟ قالوا: نعَمْ يا رسولَ الله. قالَ: مَن لا يُرجَى خَيرُه، ولا يُؤمَنُ شَرُّه. إنَّ عِيسى ابنَ مريمَ صلَواتُ اللهِ عليه قامَ في بني إسرائيلَ، فقالَ: يا بَني إسرائيلَ، لا تتَكَلَّموا بالحكمةِ عندَ الجاهلِ فتَظْلِموها، ولا تَمْنَعوها أهْلَها فتَظْلِموهُم، ولا تَظْلِموا ظالِمًا، ولا تُكافِئوا ظالِمًا؛ فيَبْطُلَ فضْلُكُم عندَ رَبِّكم، يا بَني إسرائيلَ، الأمْرُ ثَلاثٌ: أمْرٌ تَبيَّنَ غَيُّهُ فاجْتَنِبوه، وأمْرٌ اختُلِفَ فيه فرُدُّوهُ إلى اللهِ عزَّ وجلَّ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه عبد بن حميد ((المنتخب من مسنده)) (675)، ابن أبي أسامة ((مسند الحارث)) (1070)، وأبو طاهر المخلص في ((المخلصيات)) (21) بنحوه","bab":"مناقب وفضائل › فضائل جمع من الصحابة والتابعين","dorar":"phOdyaJA","merged":3,"otherRefs":["الجامع الصغير 8450 (حسن)","النوافح العطرة 360 (حسن)"]},{"id":"س-02945","fp":"2a1e7415d3b6","stateId":765,"easy":"إذا أتيت قوماً فقالوا لك «قحطاً» (لسوء فعلك) ← فقحطاً لك يوم القيامة","cause":"وإذا أتى الرجلُ القومَ فقالوا لهُ : قَحْطًا","result":"فقَحْطًا لهُ يومَ القيامةِ","explicit":true,"otherNeedIds":[44],"ref":"الجامع الصغير 340","srcLabel":"أحمد","text":["إذا أتى الرجلُ القومَ فقالوا لهُ: مرحبًا ، فمرحبًا بهِ يومَ القيامةِ يومَ يلقى ربَّهُ ، ",["وإذا أتى الرجلُ القومَ فقالوا لهُ : قَحْطًا",1]," ، ",["فقَحْطًا لهُ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"الضحاك بن قيس","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (8/ 298)\n(8136)، والحاكم (6235)، وأحمد في ((الزهد)) (1375) جميعهم باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"ccFZ9N5U"},{"id":"س-04805","fp":"3fbc93d817a6","stateId":765,"easy":"إذا قطعت السدر (الذي يُنتفع به) ← تُصب في النار على رأسك","cause":"إنَّ الَّذينَ يقطعونَ السِّدْرَ","result":"يُصبُّونَ في النَّارِ على رُؤوسِهمْ صبًّا","explicit":true,"repOf":"س-05275","ref":"صحيح الجامع 1696","text":[["إنَّ الَّذينَ يقطعونَ السِّدْرَ",1]," ",["يُصبُّونَ في النَّارِ على رُؤوسِهمْ صبًّا",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه البيهقي (12105) واللفظ له، وأخرجه الطحاوي في ((شرح مشكل الآثار)) (2976)، والطبراني في ((المعجم الأوسط)) (5615) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ZXZTdNeB"},{"id":"س-05277","fp":"8f4cced69bfd","stateId":765,"easy":"إذا قطعت سدرة ← يصب الله عليك العذاب صباً","cause":"مَن قَطَعَ سِدرةً","result":"صَبَّ اللهُ عليه العَذابَ فوقَ رَأسِه صَبًّا","explicit":true,"ref":"العلل المتناهية 2/167","srcLabel":"العلل المتناهية","text":[["مَن قَطَعَ سِدرةً ",1],["صَبَّ اللهُ عليه العَذابَ فوقَ رَأسِه صَبًّا",2]],"grade":"صحيح","narrator":"الزبير","muhaddith":"ليس فيه حديث صحيح","takhrij":"لم نقف عليه إلا عند ابن الجوزي في ((العلل المتناهية)) (1090).","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"OVYU7KVP"},{"id":"س-03082","fp":"658c01c6fced","stateId":765,"easy":"إذا ساء خلقك ← قد تبلغ أسفل دركات جهنم","cause":"وإنَّ العبدَ ليبلغُ مِنْ سوءِ خُلقِهِ","result":"أسفلَ درَكِ جهنمَ","explicit":true,"repOf":"س-02301","ref":"إتقان ما يحسن 2/517","text":["أنَّ العبدَ ليبلُغُ بحُسنِ خلقِهِ درجاتِ الآخرةِ وشرفَ المنازلِ وإنهُ لضعيفُ العبادةِ ",["وإنَّ العبدَ ليبلغُ مِنْ سوءِ خُلقِهِ",1]," ",["أسفلَ درَكِ جهنمَ",2]," وإنهُ لقويُّ العبادةِ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده جيد","bab":"إيمان › الوعيد","dorar":"0fh6pc4W"},{"id":"س-04117","fp":"f708d939c2f9","stateId":765,"easy":"إذا أثنى عليك المؤمنون شراً لفظاظتك ← وجبت لك النار","cause":"بئسَ المَرْءُ ما عَلِمْنا؛ إنْ كان لفظًّا غليظًا","result":"وَجَبَتْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-08335","ref":"المستدرك على الصحيحين 3102","text":["كنتُ مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في جِنازةٍ فينا في بني سَلِمَةَ، وأنا أمْشي إلى جنبِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ رَجلٌ: نِعْمَ المَرْءُ ما عَلِمْنا؛ إنْ كان لعَفيفًا مُسلمًا، إنْ كان. فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «أنتَ الَّذي تقولُ؟». قالَ: يا رسولَ اللهِ، ذاك بَدا لنا، واللهُ أعلمُ بالسَّرائرِ. فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «وَجَبَتْ». قالَ: وكنَّا معه في جِنازةِ رَجلٍ مِن بني حارِثَةَ -أوْ مِن بني عبدِ الأشْهَلِ- فقالَ رَجلٌ: ",["بئسَ المَرْءُ ما عَلِمْنا؛ إنْ كان لفظًّا غليظًا",1],"، إنْ كان، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «أنتَ الَّذي تقولُ؟». قالَ: يا رسولَ اللهِ، اللهُ أعلمُ بالسَّرائرِ، فأمَّا الَّذي بَدا لنا منه فذاك، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «",["وَجَبَتْ",2],"». ثُمَّ تلا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: {وَكَذَلِكَ جَعَلْنَاكُمْ أُمَّةً وَسَطًا لِتَكُونُوا شُهَدَاءَ عَلَى النَّاسِ وَيَكُونَ الرَّسُولُ عَلَيْكُمْ شَهِيدًا} [البقرة: 143]."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح الإسناد","bab":"جنائز وموت › الثناء على الجنازة والعكس","dorar":"c2FVgvzE"},{"id":"س-04118","fp":"5548bca70758","stateId":765,"easy":"إذا ذمّك الصالحون بحق ← وجبت لك النار","cause":"فكأَنَّ الناسَ نالوا منه","result":"وجبَتْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 7/3","srcLabel":"أبو داود","text":["كنَّا عندَ النبيِّ صلَّى اللهُ عليه وسلَّم فَأُتِي بِجَنَازَةٍ فأَثْنى الناسُ علَيْهَا خَيْرًا فقال النبيُّ صلَّى اللهُ عليه وسلَّم وجَبَتْ ثمَّ أُتِي بِأُخْرَى ",["فكأَنَّ الناسَ نالوا منه",1]," فقال النبيُّ صلَّى اللهُ عليه وسلَّم ",["وجبَتْ",2]," فقال أصحابُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم أُتِيَ بفلانٍ فقال وجبَتْ وأُتِي بفلانٍ فقال وجَبَتْ فقال عمرُ بِأَبي أَنْتَ وَأُمِّي أُتِيَ بِفُلانٍ فأَثْنَى الناسُ عليه خيرًا فقلْتَ وجبَتْ ثمَّ أُتِيَ بفلانٍ فأَثْنَى الناسُ عليه شرًّا فقلْتَ وجبَتْ فقال أُتِي بِأَخِيكُمْ فشهدتُّمْ بما شَهِدتُّم فوجبَتْ شهادَتُكُمْ ثمَّ أُتِي بأخيكم فلانٌ فشَهِدتُّم بما شَهِدتُّم فوَجَبَتْ شهادَتُكُمْ أنتم شهداءُ اللهِ في الأرضِ بَعْضُكُمْ على بعْضٍ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أبو داود (3233)، والنسائي (1933)، وابن ماجه (1492)، وأحمد (7552) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (2515) واللفظ له","bab":"جنائز وموت › الثناء على الجنازة والعكس","dorar":"GsOZucda"},{"id":"س-05064","fp":"7c7431d2c394","stateId":765,"easy":"إذا نظرت في كتاب أخيك بغير إذنه ← فكأنما نظرت في النار","cause":"مَن نظَر في كتابِ أخيه بغيرِ إذنِه فكأنَّه نظَر","result":"في النارِ","explicit":true,"repOf":"س-08425","ref":"إتحاف الخيرة المهرة 6/139","text":[["مَن نظَر في كتابِ أخيه بغيرِ إذنِه فكأنَّه نظَر ",1],["في النارِ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده رجاله ثقات","takhrij":"أخرجه مطولاً عبدالله بن أحمد في ((زوائد الزهد)) (1707)، والعقيلي في ((الضعفاء الكبير)) (4/340)، وابن حبان في ((المجروحين)) (2/348) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"rC2VTUl7"},{"id":"س-08015","fp":"db086a89cb77","stateId":766,"easy":"إذا كانت لك زوجتان فملت إلى إحداهما ← تجيء يوم القيامة يجرّ أحد شقيك ساقطاً","cause":"مَن كانت له امرَأَتان يَميلُ لِإحداهما على الأُخرى","result":"جاء يَومَ القِيامَةِ يَجُرُّ أَحدَ شِقَّيْه ساقِطًا أو مائِلًا","explicit":true,"similar":["س-08029"],"ref":"تخريج المسند لشعيب 7936","srcLabel":"النسائي","text":[["مَن كانت له امرَأَتان يَميلُ لِإحداهما على الأُخرى؛ ",1],["جاء يَومَ القِيامَةِ يَجُرُّ أَحدَ شِقَّيْه ساقِطًا أو مائِلًا",2],". شَكَّ يَزيدُ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه النسائي (3942)، وابن ماجه (1969)، وأحمد (7936) واللفظ له","bab":"مظالم › تحريم الظلم","dorar":"IIcqHOfM","merged":3,"otherRefs":["تخريج مشكل الآثار 234 (صحيح)","تخريج المسند لشعيب 10090 (صحيح)"]},{"id":"س-08029","fp":"98677d0ea00f","stateId":766,"easy":"إذا كانت لك زوجتان فملت إلى إحداهما ← تجيء يوم القيامة وشقك مائل","cause":"مَنْ كانَتْ لهُ امْرَأَتَانِ فمالَ إلى إحداهُما","result":"جاء يومَ القيامةِ وشِقُّهُ مائِلٌ","explicit":true,"repOf":"س-08015","ref":"بلوغ المرام 315","text":[["مَنْ كانَتْ لهُ امْرَأَتَانِ فمالَ إلى إحداهُما ",1],["جاء يومَ القيامةِ وشِقُّهُ مائِلٌ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2133) واللفظ له، والترمذي (1141)، والنسائي (3942)، وابن ماجه (1969)، وأحمد (7936)","bab":"مظالم › تحريم الظلم","dorar":"yaoSMFWl","merged":2,"otherRefs":["إرواء الغليل 2017 (صحيح)"]},{"id":"س-02928","fp":"013383ae5fc8","stateId":766,"easy":"إذا كانت لك امرأتان فلم تعدل بينهما ← تأتي يوم القيامة وشقك مائل","cause":"إذا كانت عندَ الرجلِ امرأتانِ ، فلم يعدلْ بينَهما","result":"جاء يومَ القيامةِ وشقُّه مائلٌ أو ساقطٌ","explicit":true,"ref":"البدر المنير 8/37","srcLabel":"الترمذي","text":[["إذا كانت عندَ الرجلِ امرأتانِ ، فلم يعدلْ بينَهما ، ",1],["جاء يومَ القيامةِ وشقُّه مائلٌ أو ساقطٌ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1141)، والحاكم (2759)","bab":"إيمان › الوعيد","dorar":"nYHKAhrY"},{"id":"س-02930","fp":"e18217c611f1","stateId":766,"easy":"إذا عصت المرأة زوجها أو أممت قوماً وهم كارهون ← تكون من أشد الناس عذاباً","cause":"اثنانِ : امرأةٌ عصَت زوجَها، وإمامُ قومٍ وَهُم لَه كارِهونَ","result":"أشدُّ النَّاسِ عذابًا","explicit":true,"star":true,"ref":"صحيح الترمذي 359","srcLabel":"الترمذي","text":["عَنْ عَمْرِو بْنِ الْحَارِثِ بْنِ الْمُصْطَلِقِ، قَالَ: كانَ يقالُ : ",["أشدُّ النَّاسِ عذابًا",2],[" اثنانِ : امرأةٌ عصَت زوجَها، وإمامُ قومٍ وَهُم لَه كارِهونَ",1]],"grade":"صحيح","narrator":"زياد بن أبي الجعد","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (359) واللفظ له، وابن أبي شيبة (4133) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"dLK84GsI"},{"id":"س-02947","fp":"14312fef8dd3","stateId":766,"easy":"إذا استلحقت نسباً ليس منك ← يحتّك الله حتّ الورق","cause":"منِ استلْحَقَ شيئًا ليسَ منهُ","result":"حَتَّهُ اللهُ حَتَّ الورقِ","explicit":true,"star":true,"ref":"الجامع الصغير 8405","srcLabel":"الدينوري","text":[["منِ استلْحَقَ شيئًا ليسَ منهُ،  ",1],["حَتَّهُ اللهُ حَتَّ الورقِ",2]],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"صحيح","takhrij":"أخرجه الدينوري في ((المجالسة وجواهر العلم)) (1390) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"jOAUpglZ"},{"id":"س-02957","fp":"fcec2be65cad","stateId":766,"easy":"إذا توليت غير مواليك ← فتبوأ مقعدك من النار","cause":"مَن تولَّى إلى غيرِ مواليه","result":"فلْيتبوَّأْ مقعدَه مِن النَّارِ","explicit":true,"ref":"صحيح ابن حبان 4327","srcLabel":"الطبري","text":[["مَن تولَّى إلى غيرِ مواليه ",1],["فلْيتبوَّأْ مقعدَه مِن النَّارِ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الطبري في ((تهذيب الآثار-مسند علي)) (341) بلفظ مقارب، وابن عساكر في ((تاريخ دمشق)) (14/360) وزاد في أوله: «من قال علي ما لم أقل فليتبوأ بيتا في النار»","bab":"إيمان › الوعيد","dorar":"YRuTdJId"},{"id":"س-05007","fp":"bc63a04209c0","stateId":766,"easy":"إذا مت وأنت عبد آبق ← دخلت النار","cause":"أيُّما عبدٍ ماتَ في إباقِهِ","result":"دخلَ النَّارَ","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 2/83","srcLabel":"الطبراني","text":[["أيُّما عبدٍ ماتَ في إباقِهِ",1]," ",["دخلَ النَّارَ",2]," وإن قُتِلَ في سبيلِ اللَّهِ"],"grade":"صحيح","narrator":"[جابر بن عبدالله]","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((الأوسط)) (9232) بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ptCE7oQG"},{"id":"س-05947","fp":"c2a6964e4ec1","stateId":766,"easy":"إذا كفرت المرأة حق زوجها وضيعته ← تكون من أصحاب النار","cause":"كُفرَهُنَّ لحَقِّ الزَّوجِ وتَضييعَهُنَّ لحَقِّه","result":"إنَّ النِّساءَ هم أصحابُ النَّارِ","explicit":true,"otherNeedIds":[37],"ref":"مجمع الزوائد 4/317","srcLabel":"أحمد","text":["اقْرَؤوا القُرآنَ، فإذا قَرَأتُموه، فلا تَستَكبِروا به، ولا تَغْلوا فيه، ولا تَجْفوا عنه، ولا تأْكُلوا به، وقال: ",["إنَّ النِّساءَ هم أصحابُ النَّارِ",2],"، فقال رَجُلٌ: يا رسولَ اللهِ، أليس أُمَّهاتُنا وأَخَواتُنا وبَناتُنا، فذَكَرَ ",["كُفرَهُنَّ لحَقِّ الزَّوجِ وتَضييعَهُنَّ لحَقِّه",1],"."],"grade":"حسن","narrator":"عبدالرحمن بن شبل","muhaddith":"له طرق ورجاله ثقات","takhrij":"أخرجه أحمد (15568)، وأبو يعلى (1518)، والطحاوي في ((شرح معاني الآثار)) (4296) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (2574) واللفظ له.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"0hDYsiys"}]}