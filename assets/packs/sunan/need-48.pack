{"schema":1,"kind":"sunan-chunk","version":"sunan-c56d7b8d0f22","needId":48,"stateIds":[503,504,505,506,507,508,509,510],"items":[{"id":"س-06662","fp":"24022f8e1358","stateId":503,"easy":"إذا لانت مناكبك في الصلاة ← تكون من خيار الناس","cause":"أَلْيَنُكُم مَنَاكِبَ في الصلاةِ","result":"خِيَارُكُم","explicit":true,"ref":"هداية الرواة 1056","srcLabel":"أبو داود","text":[["خِيَارُكُم",2],[" أَلْيَنُكُم مَنَاكِبَ في الصلاةِ",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (672)، والبزار (5195) واللفظ لهما، وابن خزيمة (1566)","bab":"صلاة الجماعة والإمامة › إقامة الصفوف ووصلها وفضائلها","dorar":"AYekIpZH"},{"id":"س-00287","fp":"3fcde96dd0a8","stateId":503,"easy":"إذا حسنت أخلاقك ← تكون من خيار الناس","cause":"أحاسنُكم أخلاقًا","result":"خيارُكم","explicit":true,"star":true,"ref":"صحيح الجامع 3259","srcLabel":"متفق عليه","text":["خيارُكم أحاسِنُكم أخلاقًا [يعني حديث: إنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم لم يكُنْ فاحشًا ولا مُتفحِّشًا وكان يقولُ : ( ",["خيارُكم",2],[" أحاسنُكم أخلاقًا )",1],"]"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6035)، ومسلم (2321) مطولاً","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"cKDomDZc","merged":4,"otherRefs":["السلسلة الصحيحة 1846 (صحيح)","صحيح الجامع 3260 (صحيح)","الأحاديث المختارة 11 / 404 (صحيح)"]},{"id":"س-00350","fp":"336044785962","stateId":503,"easy":"إذا حسنت أخلاقك ← تكون من خيار الأمة","cause":"أحاسِنُهُم أخلاقًا","result":"وخيارُ أُمَّتي","explicit":true,"ref":"صحيح الأدب المفرد 982","srcLabel":"البخاري","text":["شرارُ أُمَّتي الثَّرثَارونَ ، والمتشدِّقُونَ ، المتفَيهِقونَ ، ",["وخيارُ أُمَّتي",2]," ",["أحاسِنُهُم أخلاقًا",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (8822)، والبخاري في ((الأدب المفرد)) (1308) باختلاف يسير، والبزار (9442) مطولاً باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"MSYlziSI"},{"id":"س-08359","fp":"d7cafce66a1b","stateId":503,"easy":"إذا كان قلبك نقياً ولسانك صادقاً ← تكون من أفضل الناس","cause":"مَخْمومُ القَلْبِ، صَدوقُ اللِّسانِ","result":"أيُّ النَّاسِ أَفضَلُ","explicit":true,"otherNeedIds":[19,45],"ref":"علل ابن أبي حاتم 1873","srcLabel":"علل ابن أبي حاتم","text":["حَديثٌ رَواه يَحْيى بنُ حَمْزةَ، عن زَيدِ بنِ واقِدٍ، عن مُغيثِ بنِ سُمَيٍّ، عن عَبْدِ اللهِ بنِ عَمْرٍو، قالَ: قيلَ: يا رَسولَ اللهِ، ",["أيُّ النَّاسِ أَفضَلُ",2],"؟ قالَ: ",["مَخْمومُ القَلْبِ، صَدوقُ اللِّسانِ",1],"، قالوا: صَدوقَ اللِّسانِ نَعرَفُ، فما مَخْمومُ القَلْبِ؟ قالَ: هو التَّقيُّ النَّقيُّ؛ لا إثْمَ فيه ولا غِلَّ ولا حَسَدَ، قالوا: مَن يَليه يا رَسولَ اللهِ؟ قالَ: الَّذي يَشنَأُ الدُّنْيا، ويُحِبُّ الآخِرةَ، قالوا: ما نَعرِفُ هذا فينا إلَّا رافِع مَوْلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فمَن يَليه؟ قالَ: مُؤمِنٌ في خُلُقٍ حَسَنٍ؟"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"هذا حَديثٌ صحيحٌ حَسَنٌ، وزَيدٌ مَحَلُّه الصِّدْقُ، وكانَ يَرى رَأيَ القَدَرِ.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"DVKeUG7W","merged":6,"otherRefs":["الترغيب والترهيب 4/51 (صحيح)","السلسلة الصحيحة 948 (حسن)","تخريج الإحياء للعراقي 4/271 (صحيح)","هداية الرواة 5149 (صحيح)","تخريج الإحياء للعراقي 3/18 (صحيح)"]},{"id":"س-00265","fp":"2002d4b6f600","stateId":503,"easy":"إذا حسن خلقك ← تكون من خير الناس إسلاماً","cause":"أحسَنُهم خُلُقًا","result":"وإنَّ خَيرَ النَّاسِ إسلامًا","explicit":true,"similar":["س-05644"],"otherNeedIds":[17],"ref":"تخريج المسند لشعيب 20943","srcLabel":"أحمد","text":["كنتُ جالِسًا في مَجلِسٍ فيهِ رَسولُ اللهِ صلَّى اللهُ عليهِ وسَلَّمَ وأبي سَمُرَةُ جالِسٌ أمامي، فقالَ رَسولُ اللهِ صلَّى اللهُ عليهِ وسَلَّمَ: إنَّ الفُحشَ، وَالتَّفَحُّشَ ليسا مِنَ الإسلامِ في شَيءٍ، ",["وإنَّ خَيرَ النَّاسِ إسلامًا",2]," ",["أحسَنُهم خُلُقًا",1],"، قالَ ابنُ أبي شَيبةَ في حَديثِهِ: زَكريَّا بنِ أبي يَحيى، عن عِمرانَ بنِ رِياحٍ."],"grade":"صحيح","narrator":"جابر بن سمرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه عبدالله بن أحمد في ((زوائد المسند)) (20943) واللفظ له، وابن أبي شيبة (25825)، وأبو يعلى (7468)","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"QWDFiKNi"},{"id":"س-02370","fp":"add8f774c19b","stateId":503,"easy":"إذا سلم المسلمون من لسانك ويدك ← فأنت خير المسلمين","cause":"مَن سَلِمَ المُسلِمونَ مِن لسانِه ويَدِه","result":"أيُّ المُسلِمينَ خَيرٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"similar":["س-01679"],"ref":"صحيح مسلم 40","srcLabel":"البخاري","text":["إنَّ رَجُلًا سَألَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم ",["أيُّ المُسلِمينَ خَيرٌ",2],"؟ قال: ",["مَن سَلِمَ المُسلِمونَ مِن لسانِه ويَدِه.",1]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (10) مطولاً دون ذكر السؤال","bab":"إسلام › حرمة المسلم","dorar":"AsvSV4Cc"},{"id":"س-01679","fp":"397bfd848d88","stateId":503,"easy":"إذا سلم الناس من لسانك ويدك ← فأنت أسلم المؤمنين","cause":"مَن سلِمَ النَّاسُ من لسانِهِ ويدِهِ","result":"فأيُّ المؤمنينَ أسلَمُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-02370","ref":"النوافح العطرة 227","text":["قُلِ الحقَّ وإن كان مُرًّا [يعني حديث: دخَلتُ علَى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وهو في المسجِدِ جالِسٌ، فاغتَنَمتُ خلوتَهُ، وحدَهُ، فجلَستُ إليهِ، فقالَ : أبا ذَرٍّ ! إن لِلمَسجِد تَحيَّةً، وإنَّ تحيَّتَهُ ركعتان فقُم فاركَعهما، قالَ : فقُمت فركَعتُها ثم عُدتُ فجلَستُ إليهِ، فقُلتُ : يا رسولَ اللهِ ! إنَّكَ أمَرتَني بالصَّلاةِ فما الصَّلاةُ ؟ قال : خيرٌ موضوعٌ استكثِرْ أو استَقِلَّ. قلتُ : يا رسولَ اللهِ ! فأيُّ الأعمالِ أفضَلُ ؟ قال : إيمانٌ باللَّهِ عزَّ وجلَّ، وجهادٌ في سبيلِهِ، قال : قلتُ : يا رسولَ اللهِ ! فأيُّ المؤمنينَ أكمَلُهم إيمانًا ؟ قالَ : أحسَنُهُم خُلُقًا. قالَ : قلتُ : يا رسولَ اللَّهِ ! ",["فأيُّ المؤمنينَ أسلَمُ",2]," ؟ قالَ : ",["مَن سلِمَ النَّاسُ من لسانِهِ ويدِهِ",1],". قال : قلتُ : يا رسولَ اللَّهِ ! فأيُّ الهجرةِ أفضَلُ ؟ قال : مَن هجرَ السَّيِّئاتِ. قالَ : قُلتُ : يا رسولَ اللهِ ! فأيُّ الصَّلاةِ أفضَلُ ؟ قال : طولُ القنوتِ . قال : قلتُ : يا رسولَ اللهِ ! فما الصِّيامُ ؟ قالَ : فرضٌ مَجزيٌّ ، وعندَ اللهِ أضعافٌ كثيرةٌ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ الجهادِ أفضَلُ ؟ قالَ : مَن عُقِرَ جوادُهُ وأهريقَ دمُهُ. قال : قُلتُ : يا رسولَ اللهِ ! فأيُّ الرِّقابِ أفضَلُ ؟ قالَ : أغلاها ثَمنًا وأنفَسُها عندَ ربِّها. قالَ : قلتُ : يا رسولَ اللهِ ! فأيُّ الصَّدقةِ أفضَلُ ؟ قال : جُهدٌ مِن مُقِلٍّ يُسَرُّ إلى فقيرٍ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ آيةٍ مِمَّا أنزلَ اللهُ عزَّ وجلَّ عليكَ أعظَمُ ؟ قال : آيةُ الكُرسيِّ. ثُمَّ قالَ : يا أبا ذَرٍّ ! ما السَّماواتُ السَّبعُ معَ الكُرسيِّ إلا كَحلقَةٍ مُلقاةٍ بأرضِ فلاةٍ، وفَضلُ العَرشِ على الكُرسيِّ كفَضلِ الفَلاةِ علَى الحَلقَةِ. قلتُ : يا رسولَ اللهِ ! كم الأنبياءُ ؟ قال : مائةُ ألفٍ وأربعةٌ وعِشرونَ ألفًا. قلتُ : يا رسولَ اللهِ ! كم الرُّسلِ ؟ قالَ : ثلاثُمائةٍ وثلاثَةُ عشرَ جَمًّا غفيرًا. قلتُ : كثيرٌ طيِّبٌ، قلتُ : يا رسولَ اللهِ ! مَن كان أوَّلُهمْ ؟ قال : آدَمُ. قلتُ : يا رسولَ اللهِ ! أنَبيٌّ مُرسَلٌ ؟ قال : نعَم، خلقَهُ اللهُ بيدِهِ، ونفخَ فيهِ مِن روحِهِ، ثُمَّ سوَّاهُ قِبَلًا. وقال أحمدُ بنُ أنَسٍ ثُمَّ كلَّمهُ قِبَلًا. ثُمَّ قالَ : يا أبا ذَرٍّ ! أربعةٌ سُريانيُّونَ؛ آدَمُ، وشيثُ، وخَنوخُ - وهو إدريسُ، وهم أوَّلُ مَن خطَّ بالقلَمِ - ونوحٌ. وأربعةٌ من العَربِ؛ هودٌ، وصالِحٌ، وشُعَيبٌ، ونبيُّكَ يا أبا ذَرٍّ. قال : قلتُ : يا رسولَ اللهِ ! كَم كتابٌ أنزلَهُ اللَّهُ تعالى ؟ قال : مائةُ كتابٍ وأربعةُ كتُبٍ، أنزلَ علَى شيثَ خَمسونَ صحيفَةً، وأنزلَ علَى خَنوخَ ثلاثونَ صَحيفةً، وأنزلَ على إبراهيمَ عشرَ صحائفَ، وأنزلَ على موسَى قبلَ التَّوراةِ عَشرَ صحائفَ، وأنزلَ التَّوراةَ والإنجيلَ والزَّبورَ والفُرقانَ. قال : قلتُ : يا رسولَ اللهِ ! فَما كانَت صُحفُ إبراهيمَ ؟ قالَ : كانَت أمثالًا كلُّها : أيُّها الملِكُ المسلَّطُ المبتَلَى المغرورُ، فإنِّي لم أبعثْكَ لتجمَعَ الدُّنيا بعضَها إلى بعضٍ، ولكن بعثتُكَ لترُدَّ عنِّي دعوةَ المظلومِ، فإنِّي لا أردُّها ولَو كانَت مِن كافِرٍ. وكانَت فيها أمثالٌ : علَى العاقِلِ ما لَم يكُن مغلوبًا علَى عقلِهِ أن تكونَ له ساعاتٌ؛ ساعَةٌ يُناجي فيها ربَّهُ عزَّ وجلَّ، وساعةٌ يحاسِبُ فيها نفسَهُ، وساعَةٌ يفكِّرُ فيها في صُنعِ اللَّهِ عزَّ وجلَّ، وساعةٌ يخلو فيها بحاجتِهِ من المطعَمِ والمشرَبِ، وعلى العاقلِ أن لا يكون ظاعِنًا إلَّا لثلاثٍ؛ تزوُّدٍ لمعادٍ، أو مرمَّةٍ لمعاشٍ، أو لذَّةٍ في غيرِ محرَّمٍ، وعلى العاقِلِ أن يكونَ بصيرًا بزمانِهِ، مقبِلًا على شأنِهِ، حافِظًا للسانِهِ، ومن حسَبَ كلامَهُ من عمَلِهِ قلَّ كلامُهُ إلا فيما يعنيهِ. قلتُ : يا رسولَ اللَّهِ ! فما كان صحُفُ موسَى عليهِ السَّلامُ ؟ قال : كانَت عبرًا كلَّها، عجبتُ لمن أيقنَ بالموتِ ثُمَّ هو يفرَحُ، عجبتُ لمن أيقنَ بالنَّارِ وهو يضحَكُ، عجبتُ لمن أيقنَ للقدرِ ثم هو ينصَبُ، عجبتُ لمن رأى الدُّنيا وتقلُّبَها ثُمَّ اطمأنَّ إليها، عجِبتُ لمن أيقنَ بالحسابِ غدًا ثُمَّ لا يعمَلُ. قلتُ : يا رسولَ اللهِ ! أوصِني. قال : أوصيكَ بتقوى اللهِ فإنَّهُ رأسُ الأمرِ كلِّهِ، قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بتلاوَةِ القرآنِ فإنَّهُ نور لكَ في الأرضِ وذكرٌ لكَ في السَّماءِ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : إيَّاكَ وكثرةَ الضَّحِكِ فإنَّهُ يُميتُ القَلبَ، ويَذهَبُ بنورِ الوَجهِ، قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : عليكَ بالصَّمتِ إلَّا مِن خيرٍ، فإنَّهُ مطردَةٌ للشَّيطانِ عنكَ، وعونٌ لكَ علَى أمر دينِكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بالجهادِ فإنَّهُ رهبانيَّةُ أمَّتي. قلتُ : يا رسولَ اللهِ ! زِدني. قال : حبُّ المساكينِ وجالِسهُم. قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : انظُر إلى مَن تحتَكَ ولا تنظُر إلى مَن فوقكَ فإنَّهُ أجدَرُ أن لا تَزدَري نِعمةَ اللهِ عندكَ. قلتُ : زِدني يا رسولَ اللهِ ! قال : صِلْ قرابَتَكَ وإن قَطعوكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : لا تَخَف في اللَّهِ تعالى لَومَةَ لائمٍ. قلتُ : يا رسولَ اللهِ ! زِدني. قالَ : قُل الحقَّ وإن كان مُرًّا. قلتُ : يا رسولَ اللهِ ! زِدني. قال : يردُّكَ عن النَّاسِ ما تعرفُ من نفسِكَ، ولا تجِد عليهِم فيما تأتي، وكفَى به عيبًا أن تعرِفَ من النَّاسِ ما تجهَلُ من نفسِكَ، أو تجِدُ عليهِم فيما تأتي. ثُمَّ ضربَ بيدِهِ علَى صدري، فقالَ : يا أبا ذَرٍّ ! لا عقلَ كالتَّدبيرِ، ولا ورعَ كالكَفِّ، ولا حسَبَ كحُسنِ الخُلُقِ، قلتُ : يارسولَ اللهِ ! هل لي في الدُّنيا شَيءٌ مِمَّا أنزلَ اللهُ عليكَ مِمَّا كان في صحُفِ إبراهيمَ وموسَى ؟ قال : يا أبا ذَرٍّ ! اقرَأ : ? قَد أفلَحَ مَن تزَكَّى? إلى آخرِ السُّورَةِ]"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مطولاً أحمد (21415)، والبزار (3966) باختلاف يسير، وابن حبان (361) واللفظ له","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"wZID7EAR"},{"id":"س-01859","fp":"2fa41f4bc683","stateId":503,"easy":"إذا رُجي خيرك وأُمن شرك ← فأنت من خير الناس","cause":"خيرُكُم مَن يُرجَى خيرُهُ ويُؤمَنُ شرُّهُ","result":"ألا أخبرُكُم بخيرِكُم من شرِّكم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[41],"ref":"صحيح الترمذي 2263","srcLabel":"الترمذي","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وقفَ على أُناسٍ جُلوسٍ، فقالَ: ",["ألا أخبرُكُم بخيرِكُم من شرِّكم",2]," ؟ قالَ: فسَكَتوا، فقالَ ذلِكَ ثلاثَ مرَّاتٍ، فقالَ رجلٌ: بلَى يا رسولَ اللَّهِ، أخبِرنا بخيرِنا من شرِّنا، قالَ: ",["خيرُكُم مَن يُرجَى خيرُهُ ويُؤمَنُ شرُّهُ",1],"، وشرُّكم من لا يُرجَى خيرُهُ ولا يُؤمَنُ شرُّهُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2263) واللفظ له، وأحمد (8812) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"M2qxrNNK"},{"id":"س-05644","fp":"62198b153c5d","stateId":503,"easy":"إذا كنت مؤمناً حسن الخلق ← فأنت من خير الناس","cause":"مُؤمِنٌ في خُلُقٍ حَسَنٍ","result":"فمَن على أثَرِه؟ قال: مُؤمِنٌ في خُلُقٍ حَسَنٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-00265","ref":"الترغيب والترهيب 4/51","text":["قُلنا: يا نَبيَّ اللهِ، مَن خَيرُ الناسِ؟ قال: ذو القَلبِ المَخْمومِ، واللِّسانِ الصَّادِقِ. قال: يا نَبيَّ اللهِ، قد عَرَفْنا اللِّسانَ الصَّادِقَ، فما القَلبُ المَخْمومُ؟ قال: التَّقيُّ، النَّقيُّ، الذي لا إثْمَ فيه، ولا بَغيَ، ولا حسَدَ. قال: قُلْنا: يا رسولَ اللهِ، فمَن على أثَرِه؟ قال: الذي يَشنَأُ الدُّنيا، ويُحِبُّ الآخِرةَ. قُلْنا: ما نَعرِفُ هذا فينا إلَّا رافِع مَولى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، ",["فمَن على أثَرِه؟ قال: مُؤمِنٌ في خُلُقٍ حَسَنٍ",2],". قُلْنا: أمَّا هذه ففينا."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن ماجه (4216) مختصراً باختلاف يسير، والطبراني في ((مسند الشاميين)) (1218)، والبيهقي في ((شعب الإيمان)) (4800) باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"DlFBxAkz"},{"id":"س-00242","fp":"76fb738b4813","stateId":503,"easy":"إذا حسنت أخلاقك ← تكون من خيار الناس","cause":"أحاسِنَكُم أخلاقًا","result":"إنَّ مِن خيارِكُم","explicit":true,"star":true,"similar":["س-00259"],"ref":"صحيح مسلم 2321","srcLabel":"البخاري","text":["عن مَسروقٍ، قال: دَخَلنا على عبدِ اللهِ بنِ عَمرٍو حينَ قدِمَ مُعاويةُ إلى الكوفةِ، فذَكَرَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: لَم يَكُنْ فاحِشًا ولا مُتَفَحِّشًا، وقال: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["إنَّ مِن خيارِكُم",2]," ",["أحاسِنَكُم أخلاقًا",1],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6029) بلفظه، والترمذي (1975) بنحوه.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"RTaxg9nv"},{"id":"س-00259","fp":"de733dfd4b29","stateId":503,"easy":"إذا حسنت أخلاقك ← تكون من خيار الناس","cause":"أحاسِنُكم أخلاقًا","result":"ألَا أُنبِئُكم بخيارِكم","explicit":true,"repOf":"س-00242","ref":"تخريج المسند لشعيب 8822","text":["ألَا أُنبِئُكم بشِرارِكم؟ فقال: همُ الثرْثارون المُتشدِّقون، ",["ألَا أُنبِئُكم بخيارِكم",2],"؟ ",["أحاسِنُكم أخلاقًا",1],"."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (8822) واللفظ له، والبخاري في ((الأدب المفرد)) (1308)، والبزار (9442) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"rwuLWLQH"},{"id":"س-07389","fp":"e4fff6ca4541","stateId":504,"easy":"إذا أحسنت القضاء ← تكون من خيار الناس","cause":"أحسَنُكُم قَضاءً","result":"فإنَّ مِن خَيرِكُم","explicit":true,"star":true,"similar":["س-07380","س-00322","س-07386"],"otherNeedIds":[2],"ref":"صحيح مسلم 1601","srcLabel":"متفق عليه","text":["كان لرَجُلٍ على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم حَقٌّ، فأغلَظَ له، فهَمَّ به أصحابُ النَّبيِّ صلَّى اللهُ عليه وسلَّم، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: إنَّ لصاحِبِ الحَقِّ مَقالًا، فقال لهم: اشتَروا له سِنًّا، فأعطوه إيَّاه، فقالوا: إنَّا لا نَجِدُ إلَّا سِنًّا هو خَيرٌ مِن سِنِّه، قال: فاشتَروه، فأعطوه إيَّاه؛ ",["فإنَّ مِن خَيرِكُم",2],"، أو خَيرَكُم ",["أحسَنُكُم قَضاءً",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2305)، ومسلم (1601).","bab":"فضائل النبي وصفته ودلائل النبوة › أخلاق النبي","dorar":"gPBnJ5rl","merged":4,"otherRefs":["صحيح البخاري 2606 (صحيح)","صحيح مسلم 1601 (صحيح)","مختصر المقاصد 207 (صحيح)"]},{"id":"س-07380","fp":"48f50c0c3c90","stateId":504,"easy":"إذا أحسنت القضاء (رد الدين) ← تكون من خيار الناس","cause":"أحسَنَهم قَضاءً","result":"فإنَّ مِن خيارِ النَّاسِ","explicit":true,"repOf":"س-07389","otherNeedIds":[2],"ref":"صحيح البخاري 2392","text":["أنَّ رَجُلًا أتى النَّبيَّ صلَّى اللهُ عليه وسلَّم يَتَقاضاه بَعيرًا، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أعطوه، فقالوا: ما نَجِدُ إلَّا سِنًّا أفضَلَ مِن سِنِّه، فقال الرَّجُلُ: أوفَيتَني أوفاك اللهُ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أعطوه؛ ",["فإنَّ مِن خيارِ النَّاسِ",2]," ",["أحسَنَهم قَضاءً",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1601) باختلاف يسير دون قوله: \"فقال الرجل: أوفيتني أوفاك الله\"","bab":"فضائل النبي وصفته ودلائل النبوة › أخلاق النبي","dorar":"gbROrJ1e","merged":2,"otherRefs":["صحيح مسلم 1600 (صحيح)"]},{"id":"س-07384","fp":"a86cccece2bf","stateId":504,"easy":"إذا أعطيت صاحب الحق حقه ← فخيار الناس أحسنهم قضاءً","cause":"أعطِه إيَّاه","result":"فإنَّ خيارَ النَّاسِ أحسنُهم قضاءً","explicit":true,"ref":"التمهيد 4/58","srcLabel":"مسلم","text":["عن أبي رافعٍ مولَى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم قال : استسلف رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بكَرًا ، فجاءته إبلٌ من إبلِ الصَّدقةِ ، قال أبو رافعٍ : فأمرني رسولُ اللهِ صلَّى اللهُ عليه وسلَّم أن أقضيَ الرَّجلَ بكَرَه ، فقلتُ : لم أجِدْ في الإبل إلَّا جملًا خيارًا رَباعِيًا ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ",["أعطِه إيَّاه ",1],["فإنَّ خيارَ النَّاسِ أحسنُهم قضاءً",2]],"grade":"صحيح","narrator":"أبو رافع مولى رسول الله صلى الله عليه وسلم","muhaddith":"ثابت","takhrij":"أخرجه مسلم (1600)، وأبو داود (3346)، والترمذي (1318) جميعهم بلفظه.","bab":"فضائل النبي وصفته ودلائل النبوة › أخلاق النبي","dorar":"4sSMaKtr","merged":2,"otherRefs":["الأم 1/252 (صحيح)"]},{"id":"س-00322","fp":"128a94ee1da7","stateId":504,"easy":"إذا أحسنت القضاء (سداد الدين) ← تكون من أفضل الناس","cause":"أحسَنُكُم قَضاءً","result":"أفضَلُكُم","explicit":true,"repOf":"س-07389","ref":"صحيح البخاري 2609","text":["عَنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم أنَّه أخَذَ سِنًّا، فجاءَ صاحِبُه يَتَقاضاه، فقالوا له: فقال: إنَّ لصاحِبِ الحَقِّ مَقالًا، ثُمَّ قَضاه أفضَلَ مِن سِنِّه، وقال: ",["أفضَلُكُم",2]," ",["أحسَنُكُم قَضاءً",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1601) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"JCCnTnT1"},{"id":"س-07382","fp":"f31aa138ec97","stateId":504,"easy":"إذا رددت الدين بأفضل منه ← تكون من خيار الناس","cause":"أعطوه سِنًّا مِثلَ سِنِّه، قالوا: يا رَسولَ اللهِ، إلَّا أمثَلَ مِن سِنِّه، فقال: أعطوه","result":"فإنَّ مِن خَيرِكُم أحسَنَكُم قَضاءً","explicit":true,"ref":"صحيح البخاري 2306","srcLabel":"مسلم","text":["أنَّ رَجُلًا أتى النَّبيَّ صلَّى اللهُ عليه وسلَّم يَتَقاضاه، فأغلَظَ فهَمَّ به أصحابُه، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: دَعوه؛ فإنَّ لصاحِبِ الحَقِّ مَقالًا، ثُمَّ قال: ",["أعطوه سِنًّا مِثلَ سِنِّه، قالوا: يا رَسولَ اللهِ، إلَّا أمثَلَ مِن سِنِّه، فقال: أعطوه؛ ",1],["فإنَّ مِن خَيرِكُم أحسَنَكُم قَضاءً",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1601) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › أخلاق النبي","dorar":"G1N1pK1h"},{"id":"س-07386","fp":"eebd1f825da6","stateId":504,"easy":"إذا أحسنت قضاء دينك ← تكون من خير القوم","cause":"فأَحسَنَ قَضائي","result":"إنَّ خَيرَ القَومِ خَيرُهم قَضاءً","explicit":true,"repOf":"س-07389","otherNeedIds":[2,45],"ref":"تخريج المسند لشعيب 17149","text":["بِعْتُ مِنَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ بَكْرًا، فأَتَيْتُه أَتقاضاهُ، فقلْتُ: يا رسولَ اللهِ، اقْضِني ثَمَنَ بَكْري. فقال: أجَلْ، لا أَقْضِيكها إلَّا لُجَيْنِيَّةً. قال: فقَضاني، ",["فأَحسَنَ قَضائي",1],". قال: وجاءَه أعْرابيٌّ، فقال: يا رسولَ اللهِ، اقْضِني بَكْري، فأَعْطاهُ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يَومَئذٍ جَمَلًا قد أَسَنَّ، فقال: يا رسولَ اللهِ، هذا خَيرٌ مِن بَكْري، قال: فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["إنَّ خَيرَ القَومِ خَيرُهم قَضاءً",2],"."],"grade":"صحيح","narrator":"العرباض بن سارية","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (4619)، وابن ماجه (2286)، وأحمد (17149) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › أخلاق النبي","dorar":"HIERauNe","merged":14,"otherRefs":["مذكرة الأصول 444 (صحيح)","إرواء الغليل 5/224 (صحيح)","صحيح ابن ماجه 1982 (صحيح)","صحيح ابن ماجه 1866 (صحيح)","المحلى 8/77 (صحيح)","صحيح ابن ماجه 1865 (صحيح)","صحيح البخاري 2393 (صحيح)","السنن الكبرى للبيهقي 6/21 (صحيح)","حلية الأولياء 8/310 (صحيح)","صحيح ابن خزيمة 4/ 86 (صحيح)","المستدرك على الصحيحين 2263 (صحيح)","صحيح الترمذي 1316 (صحيح)","صحيح مسلم 1600 (صحيح)"]},{"id":"س-07381","fp":"a03c9159ee27","stateId":504,"easy":"إذا أحسنت القضاء ← فأنت من خير المسلمين","cause":"أعطِه","result":"فإن خيرَ المسلمين أحسنُهم قضاءً","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح النسائي 4631","srcLabel":"مسلم","text":["أن رسولَ اللهِ صلى الله عليه وسلم  استسْلَفْ مِن رجلٍ بَكْرًا ، فأتاه ، يتقاضاه بَكْرَه ، فقال لرجلٍ : انطلقْ فابْتَعْ له بَكْرًا. فأتاه، فقال : ما أصبتُ إلا بَكْرًا رَباعِيًا خيارًا . فقال : ",["أعطِه؛ ",1],["فإن خيرَ المسلمين أحسنُهم قضاءً",2],"."],"grade":"صحيح","narrator":"أبو رافع مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1600)، وأبو داود (3346)، والترمذي (1318) واللفظ لهم.","bab":"فضائل النبي وصفته ودلائل النبوة › أخلاق النبي","dorar":"Jd1XREi8"},{"id":"س-06105","fp":"1580f9904f7f","stateId":504,"easy":"إذا كنت من المطيّبين (الموفين بالعهد) ← تكون من خيار عباد الله","cause":"المطيِّبُونَ","result":"إنَّ خيارَ عبادِ اللهِ من هذه الأمةِ","explicit":true,"ref":"مجمع الزوائد 4/143","srcLabel":"الطبراني","text":["اسْتَسْلَفَ النبيُّ صلَّى اللهُ عليه وسلَّم من رجلٍ تمرَ لَوْنٍ فلَمَّا جاءَهُ يتَقَاضَاهُ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ليس عندَنا اليومَ من شيءٍ فلَوْ تَأَخَّرْتَ عَنَّا حتى يَأْتِيَنَا شيءٌ فَنَقْضِيَكَ فقال الرجلُ واغَدْرَاهُ فتَذَمَّرَ له عمرُ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم دعْهُ يا عمرُ فإنَّ لصاحِبِ الحقِّ مقالًا انطلِقْ إلى خولَةَ بنتِ حكيمٍ الأنصارِيَةِ فالْتَمِسُوا عندَها تَمْرًا فانَطَلَقُوا فقالَتْ يا رسولَ اللهِ ما عندي إلا تمرُ ذخيرةٍ فأخبرَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فقال خذُوا فاقْضُوا فلَمَّا قَضَوْهُ أقبلَ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقال اسْتَوْفَيْتَ قال نعَمْ قَدْ أوْفَيْتَ وأطَبْتَ فقال النبيُّ صلَّى اللهُ عليه وسلَّم ",["إنَّ خيارَ عبادِ اللهِ من هذه الأمةِ",2]," ",["المطيِّبُونَ",1]],"grade":"صحيح","narrator":"أبو حميد الساعدي","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه البغوي في ((معجم الصحابة)) (1897)، والطبراني في ((المعجم الصغير)) (1045)، وأبو نعيم في ((حلية الأولياء)) (10/289) باختلاف يسير.","bab":"رقائق وزهد › معيشة النبي صلى الله عليه وسلم","dorar":"J86qg15R"},{"id":"س-07547","fp":"74add8538c30","stateId":504,"easy":"إذا أوفيت بالعهد وطابت سريرتك ← تكون من خيار عباد الله يوم القيامة","cause":"الموفونَ المطيِّبونَ","result":"أولئِكَ خيارُ عبادِ اللَّهِ عندَ اللَّهِ يومَ القيامةِ","explicit":true,"ref":"الصحيح المسند 1625","srcLabel":"أحمد","text":["ابتاعَ رسولُ اللَّهِ - صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ - من رجلٍ منَ الأعرابِ جزورًا - أو جزائرَ - بوسقٍ من تمرِ الذَّخرةِ ، وتمرُ الذَّخرةِ العَجوةُ ، فرجعَ بِهِ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وعلى آلِهِ وسلَّمَ إلى بيتِهِ ، والتُمسَ لَهُ التَّمرَ ، فلم يَجِدْهُ ، فخرجَ إليهِ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وعلى آلِهِ وسلَّمَ ، فقالَ لَهُ: يا عبدَ اللَّهِ ، إنَّا قد ابتَعنا منكَ جزورًا - أو جزائرَ - بوَسقٍ من تمرِ الذَّخرةِ ، فالتَمسناهُ ، فلَم نَجِدْهُ قالَ: فقالَ الأعرابيُّ: وا غُدَراهُ قالت: فنَهَمَهُ النَّاسُ ، وقالوا: قاتلَكَ اللَّهُ ، أيغدِرُ رسولُ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ ؟ فقالَت فقالَ رسولُ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ: دعوهُ ، فإنَّ لِصاحبِ الحقِّ مقالًا. ثمَّ عادَ لَهُ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وعلى آلِهِ وسلَّمَ فقالَ يا عبدَ اللَّهِ إنَّا ابتَعنا منكَ جزائرَكَ ونحنُ نظنُّ أنَّ عندَنا ما سمَّينا لَكَ ، فالتَمسناهُ ، فلم نَجِدْهُ فقالَ الأعرابيُّ: واغُدراهُ ، فنَهَمَهُ النَّاسُ ، وقالوا: قاتلَكَ اللَّهُ أيغدِرُ رسولُ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ ؟ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: دَعوهُ ، فإنَّ لصاحبِ الحقِّ مقالًا فردَّدَ ذلِكَ رسولُ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ مرَّتينِ ، أو ثلاثًا ، فلمَّا رآهُ لا يفقَهُ عنهُ ، قالَ لرجلٍ مِن أصحابِهِ: اذهب إلى خُوَيْلةَ بنتِ حَكيمِ بنِ أميَّةَ ، فقل لَها: رسولُ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ يقولُ لَكِ: إن كانَ عندَكِ وَسقٌ من تمرِ الذَّخرةِ ، فأسلِفيناهُ حتَّى نؤدِّيَهُ إليكِ إن شاءَ اللَّهُ. فذَهَبَ إليها الرَّجلُ ، ثمَّ رجعَ ، فقالَ: قالت: نعَم ، هوَ عِندي يا رسولَ اللَّهِ ، فابعَث من يقبضُهُ ، فقالَ رسولُ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ للرَّجلِ: اذهب بِهِ ، فأوفِهِ الَّذي لَهُ قالَ: فذَهَبَ بِهِ ، فأوفاهُ الَّذي لَهُ. قالت: فمرَّ الأعرابيُّ برسولِ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ في أصحابِهِ وَهوَ جالسٌ ، فقالَ: جزاكَ اللَّهُ خيرًا ، فقد أوفيتَ وأطيَبتَ. قالت: فقالَ رسولُ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ: ",["أولئِكَ خيارُ عبادِ اللَّهِ عندَ اللَّهِ يومَ القيامةِ",2]," ",["الموفونَ المطيِّبونَ",1]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (26312)، والبزار (88)، وأبو الشيخ في ((أخلاق النبي وآدابه)) (76) واللفظ لهم.","bab":"فضائل النبي وصفته ودلائل النبوة › حسن شمائله ووفاء عهده صلى الله عليه وسلم","dorar":"5bqzH2tc"},{"id":"س-07385","fp":"0e2fe63c8391","stateId":504,"easy":"إذا وفّيت بالقرض ← فكذلك يفعل عباد الله الموفون","cause":"فاسْتَقْرَضَهَا تَمْرًا فَقَضَاهُ","result":"كذلِكَ يَفْعَلُ عبادُ اللهِ الموفونَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 4/143","srcLabel":"البيهقي","text":["جاء يهوديٌّ يَتَقَاضَى النبيَّ صلَّى اللهُ عليه وسلَّم تمرًا فأغْلَظَ للنبيِّ صلَّى اللهُ عليه وسلَّم فهمَّ بِهِ أصحابُهُ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ما قدَّسَ اللهُ أوْ ما يَرْحَمُ اللهُ أُمَّةً لا يَأْخُذُونَ للضعيفِ منهم حقَّهُ غَيْرَ مُتَعْتَعٍ ثُمَّ أَرْسَلَ إِلَى خولَةَ بنتِ حكيمٍ ",["فاسْتَقْرَضَهَا تَمْرًا فَقَضَاهُ",1]," ثُمَّ قال النبيُّ صلَّى اللهُ عليه وسلَّم ",["كذلِكَ يَفْعَلُ عبادُ اللهِ الموفونَ",2]," أمَا إنه قدْ كان عندَنَا تمرُ ولكنَّهُ قد كان خيرًا"],"grade":"صحيح","narrator":"عبدالله بن أبي سفيان","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (10717)، والضياء في ((الأحاديث المختارة)) (393) واللفظ لهما.","bab":"فضائل النبي وصفته ودلائل النبوة › أخلاق النبي","dorar":"VatlmqYF"},{"id":"س-07094","fp":"bdd649a698e9","stateId":505,"easy":"إذا تعلمت القرآن وعلّمته ← تكون من خير الناس","cause":"مَن تَعَلَّمَ القُرآنَ وعَلَّمَه","result":"خَيرُكُم","explicit":true,"star":true,"otherNeedIds":[18],"ref":"صحيح البخاري 5027","srcLabel":"أبو داود","text":[["خَيرُكُم",2],[" مَن تَعَلَّمَ القُرآنَ وعَلَّمَه",1],". قال: وأقرَأ أبو عبدِ الرَّحمَنِ في إمرةِ عُثمانَ، حتَّى كان الحَجَّاجُ قال: وذاك الذي أقعَدَني مَقعَدي هذا."],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"[صحيح]","takhrij":"أخرجه أبو داود (1452) مختصرا والترمذي (2907) وأحمد (412) باختلاف يسير.","bab":"علم › تعليم الناس وفضل ذلك","dorar":"ymYWjzdb","merged":7,"otherRefs":["صحيح ابن ماجه 177 (صحيح)","تخريج مشكل الآثار 5120 (صحيح)","تخريج مشكل الآثار 5128 (حسن)","تخريج المسند لشعيب 500 (صحيح)","تخريج مشكل الآثار 5124 (صحيح)","تخريج صحيح ابن حبان 118 (صحيح)"]},{"id":"س-05995","fp":"fe3d73387999","stateId":505,"easy":"إذا فقهت في الدين ← تكون من خير الناس","cause":"خيرُهم في الإسلامِ إذا فَقِهوا","result":"خيرُ الناسِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"تخريج مشكل الآثار 2055","srcLabel":"مسلم","text":["ثم ذَكَرَ بإسنادِه نحوَه،  [يعني حديثَ: سُئِلَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ عن أكرَمِ الناسِ، قال: أتْقاهم، قالوا: يا رسولَ اللهِ، ليس عن هذا نسأَلُكَ، فقال: يُوسُفُ بنُ يعقوبَ نبيٌّ ابنُ نبيٍّ ابنِ نبيٍّ ابنِ خليلِ الرحمنِ، فقالوا: ليس عن هذا نسأَلُكَ، قال: فعن مَعادِنِ العَرَبِ تَسأَلوني؟، قالوا: نَعَمْ، قال: ",["خيرُ الناسِ",2],[" خيرُهم في الإسلامِ إذا فَقِهوا",1],".]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (2054) واللفظ له، ومسلم (2378)، وأحمد (9568) كلاهما باختلاف يسير.","bab":"رقائق وزهد › تقوى الله","dorar":"bJEuWT5I"},{"id":"س-06006","fp":"04e83d83aea6","stateId":505,"easy":"إذا قرأت القرآن واتقيت الله وأمرت بالمعروف ونهيت عن المنكر ووصلت رحمك ← فأنت خير الناس","cause":"خَيرُ النَّاسِ أقرؤهُم وأتقاهُم للهِ ، وآمرُهُم بالمعروفِ ، وأنهاهُم عنِ المنكرِ ، وأوصلُهُم للرَّحمِ","result":"أيُّ النَّاسِ خَيرٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"عمدة التفسير 1/401","srcLabel":"أحمد","text":["قامَ رجلٌ إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ وَهوَ علَى المنبرِ ، فقالَ : يا رسولَ اللَّهِ ، ",["أيُّ النَّاسِ خَيرٌ ",2],"؟ فقالَ : ",["خَيرُ النَّاسِ أقرؤهُم وأتقاهُم للهِ ، وآمرُهُم بالمعروفِ ، وأنهاهُم عنِ المنكرِ ، وأوصلُهُم للرَّحمِ",1]],"grade":"صحيح","narrator":"درة بنت أبي لهب","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (27434)، واللفظ له، والطبراني (24/ 257/ 657)، باختلاف يسير.","bab":"رقائق وزهد › تقوى الله","dorar":"B0HLmCVk","merged":2,"otherRefs":["تخريج الإحياء للعراقي 2/269 (حسن)"]},{"id":"س-05977","fp":"bb05bff906a4","stateId":505,"easy":"إذا كنت خيّراً في الجاهلية ثم فقهت في الإسلام ← تكون من خيار المسلمين","cause":"إذا فَقِهوا","result":"فَخِيارُكُمْ في الجاهليةِ خِيارُكُمْ في الإسلامِ","explicit":true,"star":true,"otherNeedIds":[18],"ref":"صحيح الأدب المفرد 96","srcLabel":"البخاري","text":["سُئِلَ رسولُ اللهِ صلَّى اللهُ عليهِ و سلَّمَ : أيُّ الناسِ أَكْرَمُ ؟ قال : أَكْرَمُهُمْ عندَ اللهِ أَتْقَاهُمْ . قالوا : ليس عن هذا نَسْأَلُكَ ، قال : فَأَكْرَمُ الناسِ و في روايةٍ : إنَّهُ الكريمُ ابنُ الكريمِ يُوسُفُ نَبِيُّ اللهِ ابْنُ نبيِّ اللهِ ابنِ نبيِّ اللهِ ابنِ خَلِيلِ اللهِ . قالوا : ليس عن ذلكَ نَسْأَلُكَ ، قال : فَعَنْ مَعَادِنِ العَرَبِ تَسْأَلونِي ؟ قالوا : نَعَمْ ، قال : ",["فَخِيارُكُمْ في الجاهليةِ خِيارُكُمْ في الإسلامِ",2]," ",["إذا فَقِهوا",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (129) واللفظ له، والدارمي (229)، وأبو يعلى (6562) باختلاف يسير.","bab":"رقائق وزهد › تقوى الله","dorar":"JiuLQTTP","merged":4,"otherRefs":["تخريج المسند لشعيب 16928 (صحيح)","صحيح الجامع 6796 (صحيح)","صحيح الجامع 2916 (صحيح)"]},{"id":"س-07015","fp":"af52771d5ed5","stateId":505,"easy":"إذا سألت عما يعنيك ← تكون من خير النساء","cause":"لَمَنَ تسألُ عما يعنيها","result":"إنَّ خيركنَّ","explicit":true,"star":true,"otherNeedIds":[18],"ref":"موافقة الخبر الخبر 2/28","srcLabel":"مسلم","text":["دخلت أمُّ سليمٍ رضيَ اللهُ عنها على النبيِّ صلَّى اللهُ عليْهِ وسلَّمَ فقالَتْ : يا رسولَ اللهِ المرأةُ ترى في منامها ما يرى الرجلُ ، فقالَتْ أمُّ سلمةَ رضيَ اللهُ عنها : تربتْ يداكِ يا أمَّ سليمٍ فضحتِ النساءَ : فقال النبيُّ صلَّى اللهُ عليْهِ وسلَّمَ منتصرًا لأمِّ سليمٍ : بل أنتِ تربتْ يداكِ ، ",["إنَّ خيركنَّ",2]," ",["لَمَنَ تسألُ عما يعنيها",1]," ، إذ رأتِ الماءَ فلتغتسل فقالَتْ أمُّ سلمةَ : وهل للنساءِ ماءٌ ؟ قال : نعم فمن أين يُشبههنَّ الولدُ ؟ إنَّما هن شقائقُ الرجالِ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن غريب","takhrij":"أخرجه مسلم (310) بلفظ مقارب","bab":"علم › الحث على طلب العلم","dorar":"3jwYrbvI"},{"id":"س-05398","fp":"71ef32089664","stateId":505,"easy":"إذا فقهت في الدين وعملت ← فأنت من أفضل الناس","cause":"أفضلُهم عملًا إذا فَقُهوا في دينِهِم","result":"أيُّ النَّاسِ أفضلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"المستدرك على الصحيحين 3836","srcLabel":"الترمذي","text":["عنِ ابنِ مسعودٍ رَضيَ اللهُ عنه: {وَجَعَلْنَا فِي قُلُوبِ الَّذِينَ اتَّبَعُوهُ رَأْفَةً وَرَحْمَةً وَرَهْبَانِيَّةً ابْتَدَعُوهَا مَا كَتَبْنَاهَا عَلَيْهِمْ إِلَّا ابْتِغَاءَ رِضْوَانِ اللَّهِ فَمَا رَعَوْهَا حَقَّ رِعَايَتِهَا فَآتَيْنَا الَّذِينَ آمَنُوا مِنْهُمْ أَجْرَهُمْ وَكَثِيرٌ مِنْهُمْ فَاسِقُونَ} [الحديد: 27]. قالُ ابنُ مسعودٍ: قالَ لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «يا عبدَ اللهِ بنَ مسعودٍ». فقلتُ: لبَّيكَ يا رسولَ اللهِ، ثلاثَ مِرارٍ، قالَ: «هل تَدري أيُّ عُرى الإيمانِ أوثقُ؟». قلتُ: اللهُ ورسولُهُ أعْلمُ. قالَ: «أَوثقُ الإيمانِ الوَلايةُ في اللهِ بالحبِّ فيه والبُغضِ فيه، يا عبدَ اللهِ بنَ مسعودٍ». قلتُ: لبَّيكَ يا رسولَ اللهِ، ثلاثَ مِرارٍ، قالَ: «هل تَدري ",["أيُّ النَّاسِ أفضلُ",2],"؟». قلتُ: اللهُ ورسولُهُ أعْلمُ. قالَ: «فإنَّ أفضلَ النَّاسِ ",["أفضلُهم عملًا إذا فَقُهوا في دينِهِم",1],"، يا عبدَ اللهِ بنَ مسعودٍ»، قلتُ: لبَّيكَ وسَعديْكَ، ثلاثَ مِرارٍ، قالَ: «هل تَدري أيُّ النَّاسِ أَعلمُ؟». قلتُ: اللهُ ورسولُهُ أعْلمُ. قالَ: «فإنَّ أعلمَ النَّاسِ أبصرُهُم بالحقِّ إذا اختلفتِ النَّاسُ، وإن كان مُقصِّرًا في العملِ، وإن كان يَزحَفُ على استِهِ، واختلفَ مَنْ كان قبْلَنا على اثنتينِ وسبعينَ فِرقةً، نجا منها ثلاثٌ، وهَلَكَ سائرُها، فرقةٌ أذَتِ الملوكَ وقاتلَتْهُم على دينِ اللهِ وعيسى ابنِ مريمَ حتَّى قُتِلوا، وفرقةٌ لمْ يَكنْ لهم طاقةٌ بموازاةِ الملوكِ، فأقاموا بيْنَ ظَهرانيْ قومِهِم، فدَعَوْهم إلى دينِ اللهِ ودينِ عيسى ابنِ مريمَ فقتَلَتْهم الملوكُ، ونشَرَتْهم بالمناشيرِ، وفرقةٌ لمْ يكنْ لهم طاقةٌ بموازاةِ الملوكِ ولا بالمقامِ بيْنَ ظَهرانيْ قومِهِم يَدْعوهم إلى اللهِ وإلى دينِ عيسى ابنِ مريمَ، فساحوا في الجبالِ، وتَرهَّبوا فيها، فهُم الَّذين قالَ اللهُ: {وَرَهْبَانِيَّةً ابْتَدَعُوهَا مَا كَتَبْنَاهَا عَلَيْهِمْ إِلَّا ابْتِغَاءَ رِضْوَانِ اللَّهِ فَمَا رَعَوْهَا حَقَّ رِعَايَتِهَا} [الحديد: 27] إلى قولِهِ: {فَاسِقُونَ}، فالمؤمنونَ الَّذين آمنوا بي وصدَّقوني، والفاسقون الَّذين كَفروا بي، وجَحدوا بي»."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الحكيم الترمذي في ((نوادر الأصول)) (39)، والشاشي (772) كلاهما باختلاف يسير، والطبراني في ((الأوسط)) (4479) مختصرا ببعض لفظه.","bab":"رقائق وزهد › الحب في الله","dorar":"eLTo5QoE"},{"id":"س-03831","fp":"b396c0c4b228","stateId":505,"easy":"إذا فقهت في الدين ووصلت رحمك ← فأنت من خير الناس","cause":"أفقهُهُم في دينِ اللهِ وأوصَلُهم لرَحِمِه","result":"مَن خيرُ النَّاسِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"مجمع الزوائد 9/261","srcLabel":"أحمد","text":["كنْتُ عند عائشةَ فدخَل النَّبيُّ صلَّى اللهُ عليه وسلَّم فقال ائتوني بوَضوءٍ قالت فابتَدَرْتُ أنا وعائشةُ الكوزَ فبدَرْتُها فأخَذْتُه أنا فتوضَّأ فرفَع إليَّ عينَه أو بصرَه قال أنتِ منِّي وأنا مِنكِ قالت فأُتِيَ برجلٍ فقال ما أنا فَعَلْتُه إنَّما قيل لي قالت وكان يسألُه على المِنبرِ ",["مَن خيرُ النَّاسِ",2]," فقال ",["أفقهُهُم في دينِ اللهِ وأوصَلُهم لرَحِمِه",1]," وذكَر شَريكٌ شيئين آخَرَين فلم أحفَظْهما"],"grade":"حسن","narrator":"درة بنت أبي لهب","muhaddith":"رجاله ثقات","takhrij":"أخرجه أحمد (24387)، والطحاوي في ((شرح مشكل الآثار)) (5212) كلاهما باختلاف يسير، وابن أبي عاصم في ((الآحاد والمثاني)) (3167) بنحوه.","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"71rIl6NG"},{"id":"س-08413","fp":"7291b3cd0f9c","stateId":506,"easy":"إذا أطعمت الطعام ← تكون من خيار الناس","cause":"مَن أطعَمَ الطَّعامَ","result":"خيارُكُم","explicit":true,"similar":["س-01618"],"ref":"الأربعون البلدانية 151","srcLabel":"أحمد","text":["قال عُمَر لصُهَيبٍ رَضِيَ اللهُ عنهما: أيُّ رَجُلٍ لولا خِصالٌ ثَلاثٌ فيك؟ قال: وما هنَّ؟ قال: اكتنَيتَ وليسَ لك وَلَدٌ، وأُنميتَ إلى العَرَبِ وأنتَ مِنَ الرُّومِ، وفيك سَرَفٌ في الطَّعامِ. قال: أمَّا قَولُك: اكتَنَيت ولم يولَدْ لي، فإنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم كَنَّاني \"أبا يَحيى\" وأمَّا قَولُك: إنِّي انتَمَيتُ إلى العَرَبِ، وأنتَ مِنَ الرُّومِ؛ فإنِّي رَجُلٌ مِنَ النَّمرِ بنِ قاسِطٍ، سَبَتني الرُّومُ مِنَ الموصِلِ بَعدَ إذ أنا غُلامٌ قد عَرَفتُ نِسبَتي.\nوأمَّا قَولُك: فيك سَرَفٌ في الطَّعامِ فإنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: \"",["خيارُكُم",2],[" مَن أطعَمَ الطَّعامَ\"",1]],"grade":"صحيح","narrator":"صهيب الرومي","muhaddith":"محفوظ.","takhrij":"أخرجه ابن عساكر في ((معجمه)) (1014) واللفظ له، وأحمد (23926) بنحوه، وابن ماجة (3738) مختصرًا.","bab":"مناقب وفضائل › فضائل العرب","dorar":"7zoOGmVE","merged":2,"otherRefs":["صحيح الترغيب 948 (صحيح)"]},{"id":"س-01618","fp":"2f3e8241bad9","stateId":506,"easy":"إذا أطعمت الطعام ← تكون من خير الناس","cause":"مَن أطعَمَ الطَّعامَ","result":"إنَّ خَيرَكم","explicit":true,"repOf":"س-08413","ref":"المستدرك على الصحيحين 7948","text":["عنْ عُمَرَ بنِ الخَطَّابِ رَضيَ اللهُ عنه، أنَّه قال لصُهَيبٍ: إنَّكَ لَرَجلٌ لوْلا خِصالٌ ثَلاثةٌ، قالَ: وما هُنَّ؟ قالَ: اكتَنَيتَ وليْس لكَ وَلَدٌ، وانتَمَيتَ إلى العَرَبِ وأنتَ رَجُلٌ مِنَ الرُّومِ، وفيكَ سَرَفٌ في الطَّعامِ. قالَ: يا أميرَ المُؤمِنين، أمَّا قَولُكَ: اكتَنَيتَ وليْس لكَ وَلَدٌ، فإنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ كَنَّاني أبا يَحيى، وأمَّا قَولُكَ: انتَمَيتَ إلى العَرَبِ وأنتَ رَجُلٌ منَ الرُّومِ، فإنِّي رَجُلٌ منَ النَّمِرِ بنِ قاسِطٍ، استُبِيتُ منَ المَوصِلِ بعْدَ أنْ كُنتُ غُلامًا قدْ عَرَفتُ أهْلي ونَسَبي، وأمَّا قَولُكَ: فيكَ سَرَفٌ في الطَّعامِ، فإنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["إنَّ خَيرَكم",2],[" مَن أطعَمَ الطَّعامَ",1],"."],"grade":"صحيح","narrator":"صهيب","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن ماجه (3738)، وأحمد (18942) بنحوه.","bab":"أطعمة › إطعام الطعام","dorar":"PeHyl7PY"},{"id":"س-04060","fp":"a4a1be79d93e","stateId":506,"easy":"إذا دافعت عن عشيرتك ما لم تأثم ← تكون من خير الناس","cause":"المدافعُ عن عشيرتِهِ ما لم يأثَمْ","result":"خيرُكمُ","explicit":true,"ref":"هداية الرواة 4/405","srcLabel":"أبو داود","text":["خطبَنا رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ ",["خيرُكمُ",2],[" المدافعُ عن عشيرتِهِ ما لم يأثَمْ",1]],"grade":"حسن","narrator":"سراقة بن مالك","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه أبو داود (5120)، والطبراني في ((المعجم الأوسط)) (6993)، وأبو نعيم في ((معرفة الصحابة)) (3599)","bab":"جمعة › خطبة النبي صلى الله عليه وسلم","dorar":"jbpu72fW"},{"id":"س-08092","fp":"6a599da74046","stateId":506,"easy":"إذا كنت في نعمك تكرم ضيفك وتعطي حقها ← فأنت من خير الناس","cause":"بادٍ في نَعَمِهِ يَقْرِي ضَيفَهُ، ويُعطي حَقَّهُ","result":"ومِثلُ آخَرَ","explicit":true,"ref":"تخريج المسند لشعيب 1987","srcLabel":"أحمد","text":["قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يَومَ خطَبَ النَّاسَ بتَبوكَ: ما في النَّاسِ مِثلُ رَجُلٍ آخِذٍ بِرَأْسِ فَرَسِهِ، يُجاهِدُ في سَبيلِ اللهِ عَزَّ وجَلَّ، ويَجتَنِبُ شُرورَ النَّاسِ، ",["ومِثلُ آخَرَ",2]," ",["بادٍ في نَعَمِهِ يَقْرِي ضَيفَهُ، ويُعطي حَقَّهُ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (1987) واللفظ له، والطحاوي في ((شرح مشكل الآثار)) (5546)، والطبراني (12/212) (12924)","bab":"مغازي › غزوة تبوك","dorar":"U7QE8SSA"},{"id":"س-04005","fp":"396fbf72ae9d","stateId":507,"easy":"إذا ابتُليت فتبت ← تكون من خيار الناس","cause":"كلُّ مُفتَّنٍ توَّابٌ","result":"خيارُكم","explicit":true,"ref":"شرح كتاب الشهاب 553","srcLabel":"البيهقي","text":[["خيارُكم",2],[" كلُّ مُفتَّنٍ توَّابٌ",1]],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"إسناده قوي","takhrij":"أخرجه البزار (700)، والقضاعي في ((مسند الشهاب)) (1271)، والبيهقي في ((شعب الإيمان)) (7121)","bab":"توبة › الحض على التوبة","dorar":"HEfQ29Rs"},{"id":"س-05610","fp":"b305e3119c12","stateId":507,"easy":"إذا كنت مؤمناً خفيف المؤونة ذا حظ من الصلاة تحسن عبادة الله في السر ← تكون من أغبط الناس","cause":"لَمُؤمِنٌ خَفيفُ الحاذِ، ذو حَظٍّ مِن الصَّلاةِ، أحسَنَ عِبادةَ اللهِ، والطَّاعةَ في السِّرِّ، غامِضًا في النَّاسِ، لا يُشارُ إليهِ بالأصابِعِ، وكانَ رِزقُه كَفافًا، فصَبَرَ على ذلِكَ","result":"إنَّ أغبَطَ النَّاسِ عندي","explicit":true,"otherNeedIds":[5],"ref":"المستدرك على الصحيحين 7344","srcLabel":"الحاكم","text":[["إنَّ أغبَطَ النَّاسِ عندي",2]," ",["لَمُؤمِنٌ خَفيفُ الحاذِ، ذو حَظٍّ مِن الصَّلاةِ، أحسَنَ عِبادةَ اللهِ، والطَّاعةَ في السِّرِّ، غامِضًا في النَّاسِ، لا يُشارُ إليهِ بالأصابِعِ، وكانَ رِزقُه كَفافًا، فصَبَرَ على ذلِكَ",1],"، ثمَّ نفَضَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بإصبعِهِ وقال: عُجِّلَتْ مَنِيَّتُه، وقَلَّتْ بَواكِيهِ، وقَلَّ تُراثُه."],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"إسناد للشاميين صحيح عندهم","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"Rh5tVvjX","merged":2,"otherRefs":["الجامع الصغير 1201 (صحيح)"]},{"id":"س-01027","fp":"1841b59c3c9c","stateId":507,"easy":"إذا كنت إذا رُئيت ذُكر الله ← تكون من خيار عباد الله","cause":"الَّذين إذا رُؤوا ذُكِر اللهُ","result":"خيارُ عبادِ اللهِ","explicit":true,"similar":["س-04869"],"ref":"مجمع الزوائد 8/96","srcLabel":"أحمد","text":[["خيارُ عبادِ اللهِ",2],"  ",["الَّذين  إذا رُؤوا ذُكِر اللهُ",1]," وشرارُ عبادِ اللهِ المشَّاؤونَ بالنَّميمةِ المُفرِّقونَ بينَ الأحبَّةِ الباغونَ للبُرآءِ العنت"],"grade":"صحيح","narrator":"عبدالرحمن بن غنم","muhaddith":"فيه شهر بن حوشب وبقية رجاله رجال الصحيح","takhrij":"أخرجه أحمد (17998) بلفظه، وأبو نعيم الأصبهاني في ((معرفة الصحابة)) (4700) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"jzX084L3"},{"id":"س-03811","fp":"a6455bdcf1b5","stateId":507,"easy":"إذا كنت ورعاً ← تكون من أعبد الناس","cause":"كُنْ وَرِعًا","result":"تَكُنْ من أَعْبَدِ الناسِ","explicit":true,"ref":"صحيح الجامع 7833","srcLabel":"الترمذي","text":["يا أبا هريرةَ ! ",["كُنْ وَرِعًا",1]," ",["تَكُنْ من أَعْبَدِ الناسِ",2]," ، وارْضَ بما قسم اللهُ لكَ تَكُن من أَغْنَى الناسِ ، وأَحِبَّ للمسلمينَ والمؤمنينَ ما تُحِبُّ لنفسِكَ وأهلِ بيتِكَ ، واكْرَهْ لهم ما تَكْرَهُ لنفسِكَ وأهلِ بيتِكَ تَكُنْ مؤمنًا ، وجاوِرْ مَن جاوَرْتَ بإحسانٍ تَكُنْ مُسْلِمًا ، وإياكَ وكثرةَ الضَّحِكِ ؛ فإنَّ كَثْرَةَ الضَّحِكِ فسادُ القلبِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2305)، وابن ماجه (4217)، وأحمد (8095) باختلاف يسير","bab":"بر وصلة › حق الجار والوصاة به","dorar":"8idzJ5Is"},{"id":"س-01700","fp":"9c33982bc1ed","stateId":507,"easy":"إذا أكثرت ذكر الموت وأحسنت الاستعداد له ← فأنت أكيس المؤمنين","cause":"أكثَرُهم للموتِ ذِكرًا وأحسَنُهم له استعدادًا","result":"فأيُّ المُؤمنينَ أكيَسُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"المستدرك على الصحيحين 8848","srcLabel":"الحاكم","text":["عن عَطاءِ بنِ أبي رَباحٍ، قال: كُنتُ مع عبدِ اللهِ بنِ عُمرَ، فأتاهُ فتًى يَسألُه عن إسدالِ العِمامةِ، فقال ابنُ عُمرَ: سأُخبِرُك عن ذلكَ بعِلمٍ إنْ شاء اللهُ: كُنتُ عاشرَ عَشَرةٍ في مَسجدِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ: أبو بَكرٍ، وعُمرُ، وعُثمانُ، وعلِيٌّ، وابنُ مَسعودٍ، وحُذَيفةُ، وابنُ عَوفٍ، وأبو سَعيدٍ الخُدْريُّ رَضيَ اللهُ عنهم، فجاء فتًى مِنَ الأنصارِ فسَلَّم على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ ثمَّ جلَسَ، فقال: يا رَسولَ اللهِ، أيُّ المُؤمنينَ أفضلُ؟ قال: أحسَنُهم خُلقًا، قال: ",["فأيُّ المُؤمنينَ أكيَسُ",2],"؟ قال: ",["أكثَرُهم للموتِ ذِكرًا وأحسَنُهم له استعدادًا",1]," قبْلَ أنْ يَنزِلَ بهم، أولئكَ مِنَ الأكياسِ، ثمَّ سَكَت الفَتى. وأقبَلَ عليه النَّبيُّ صلَّى اللهُ عليه وسلَّمَ، فقال: يا مَعشَرَ المهاجِرين، خمسٌ إنِ ابتُلِيتُم بهنَّ، ونزَلَ فيكم، أعوذُ باللهِ أنْ تُدْرِكُوهنَّ: لم تَظهَرِ الفاحشةُ في قومٍ قطُّ حتَّى يَعمَلوها إلَّا ظَهَر فيهم الطَّاعونُ والأوجاعُ الَّتي لم تكُنْ مَضَت في أسلافِهم، ولم يَنقُصوا المِكيالَ والميزانَ إلَّا أُخِذوا بالسِّنينَ وشِدَّةِ المؤْنةِ وجَوْرِ السُّلطانِ عليهم، ولم يَمنَعوا زكاةَ أموالِهم إلَّا مُنِعوا القطْرَ مِنَ السَّماءِ، ولوْلا البهائمُ لم يُمْطَروا، ولم يَنقُضوا عهْدَ اللهِ وعهْدَ رَسولِه إلَّا سُلِّطَ عليهم عدُوُّهم مِن غيرِهم وأَخَذوا بعضَ ما كان في أيْديهم، وما لم يَحكُمْ أئمَّتُهم بكتابِ اللهِ إلَّا ألْقى اللهُ بأسهُمٍ بيْنهم. ثمَّ أمَرَ عبدَ الرَّحمنِ بنَ عَوفٍ يَتجهَّزُ لسَرِيَّةٍ بَعَثه عليها، وأصبَحَ عبْدُ الرَّحمنِ قدِ اعتَمَّ بعِمامةٍ مِن كَرابيسَ سَوداءَ، فأدْناه النَّبيُّ صلَّى اللهُ عليه وسلَّمَ، ثمَّ نَقَضه وعمَّمه بعِمامةٍ بَيضاءَ، وأرسَلَ مِن خلْفِه أربعَ أصابعَ أو نحْوَ ذلكَ، وقال: هكذا يا ابنَ عَوفٍ اعتَمَّ؛ فإنَّه أعرَبُ وأحسَنُ. ثمَّ أمَرَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ بِلالًا أنْ يَدفَعَ إليه اللِّواءَ، فحَمِد اللهَ وصلَّى على النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، ثمَّ قال: خُذِ ابنَ عَوفٍ فاغْزُوا جميعًا في سَبيلِ اللهِ، فقاتِلوا مَن كَفَر باللهِ، لا تَغُلُّوا ولا تَغدِروا، ولا تُمثِّلوا، ولا تَقْتُلوا وَليدًا، فهذا عهْدُ اللهِ وسِيرةُ نبيِّه صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح الإسناد، ولم يخرجاه","bab":"أقضية وأحكام › الحكم بالكتاب والسنة ثم باجتهاد الحاكم، والخطأ معذور","dorar":"uPcbS7uR","merged":2,"otherRefs":["الفتوحات الربانية 4/51 (حسن)"]},{"id":"س-04807","fp":"e10d4eae5e36","stateId":507,"easy":"إذا كنت ضعيفاً مستضعفاً لو أقسمت على الله لأبرك ← فأنت من خير عباد الله","cause":"الضعيفُ المستضْعَفُ ، ذو الطِّمرَينِ ، لايُؤبَه له ، لو أقسمَ على اللهِ لأَبَرَّه","result":"ألا أخبركم بخيرِ عبادِ اللهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[29],"ref":"صحيح الترغيب 2904","srcLabel":"أحمد","text":["أَلا أُخبرُكم بشرِّ عبادِ الله ؟ الفَظُّ المستكبرُ . ",["ألا أخبركم بخيرِ عبادِ اللهِ",2]," ؟ ",["الضعيفُ المستضْعَفُ ، ذو الطِّمرَينِ ، لايُؤبَه له ، لو أقسمَ على اللهِ لأَبَرَّه",1]," ."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (23457) في أوله قصة، باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"lLdXwiyY"},{"id":"س-04869","fp":"f43ddda23c0f","stateId":507,"easy":"إذا كنت إذا رُئيت ذُكر الله ← فأنت من خيار الناس","cause":"خياركم الذين إذا رءوا ذكر الله عز وجل","result":"ألَا أُنبِّئُكم بخِيارِكم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-01027","ref":"صحيح ابن ماجه 3/349","text":[["ألَا أُنبِّئُكم بخِيارِكم",2],"؟ قالوا: بلى يا رسولَ الله! قال: ",["خياركم الذين إذا رءوا ذكر الله عز وجل",1]],"grade":"صحيح","narrator":"أسماء بنت يزيد أم سلمة الأنصارية","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (4119)، وأحمد (27599)، والطبراني (24/ 167) (423)، والبيهقي في ((الشعب)) (10596) واللفظ لهم جميعا.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"JimA7mlw"},{"id":"س-05643","fp":"2d2cf0b41197","stateId":507,"easy":"إذا شنئت الدنيا وأحببت الآخرة ← فأنت من خير الناس","cause":"الذي يَشنَأُ الدُّنيا، ويُحِبُّ الآخِرةَ","result":"فمَن على أثَرِه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"الترغيب والترهيب 4/51","srcLabel":"ابن ماجه","text":["قُلنا: يا نَبيَّ اللهِ، مَن خَيرُ الناسِ؟ قال: ذو القَلبِ المَخْمومِ، واللِّسانِ الصَّادِقِ. قال: يا نَبيَّ اللهِ، قد عَرَفْنا اللِّسانَ الصَّادِقَ، فما القَلبُ المَخْمومُ؟ قال: التَّقيُّ، النَّقيُّ، الذي لا إثْمَ فيه، ولا بَغيَ، ولا حسَدَ. قال: قُلْنا: يا رسولَ اللهِ، فمَن على أثَرِه؟ قال: ",["الذي يَشنَأُ الدُّنيا، ويُحِبُّ الآخِرةَ",1],". قُلْنا: ما نَعرِفُ هذا فينا إلَّا رافِع مَولى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، ",["فمَن على أثَرِه",2],"؟ قال: مُؤمِنٌ في خُلُقٍ حَسَنٍ. قُلْنا: أمَّا هذه ففينا."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن ماجه (4216) مختصراً باختلاف يسير، والطبراني في ((مسند الشاميين)) (1218)، والبيهقي في ((شعب الإيمان)) (4800) باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"DlFBxAkz"},{"id":"س-02210","fp":"1e4a0402562a","stateId":508,"easy":"إذا طال عمرك وحسن عملك ← تكون من خيار الناس","cause":"أطولُكم أعمارًا وأحسَنُكم أعمالًا","result":"خيارُكم","explicit":true,"ref":"مجمع الزوائد 10/206","srcLabel":"أحمد","text":["ألَا أُنَبِّئُكم بخيرِكم قالوا بلى يا رسولَ اللهِ قال ",["خيارُكم",2],[" أطولُكم أعمارًا وأحسَنُكم أعمالًا",1]," وفي روايةٍ أحسَنُكم أخلاقًا بَدَلَ أعمالًا"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (7212)، وابن حبان (2981)، والبيهقي (6766) باختلاف يسير. والرواية: أخرجها أحمد (9235)، والبزار (8559)، وابن حبان (484)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"sz4E5z8S"},{"id":"س-02170","fp":"214e7a37f185","stateId":508,"easy":"إذا طال عمرك وحسن خلقك ← فأنت من خيار الناس","cause":"أطوَلُكم أعمارًا ، وأحسَنُكُم أخلاقًا","result":"ألا أخبرُكم بخيارِكُم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[36],"ref":"صحيح الترغيب 2651","srcLabel":"أحمد","text":[["ألا أخبرُكم بخيارِكُم",2]," ؟ . قالوا : بلَى يا رسولَ اللهِ ! قال : ",["أطوَلُكم أعمارًا ، وأحسَنُكُم أخلاقًا",1]," ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن حبان (484) واللفظ له، وأخرجه أحمد (9235) باختلاف يسير، والبيهقي (6766) بلفظ: \"وأحسنكم أعمالا\"","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"eGXlM5jX"},{"id":"س-00777","fp":"100352ef0235","stateId":508,"easy":"إذا طال عمرك وحسن عملك ← فأنت من خير الناس","cause":"مَن طالَ عُمرُه وحَسُنَ عَمَلُه","result":"أيُّ النَّاسِ خَيْرٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"similar":["س-04971"],"otherNeedIds":[36],"ref":"الأحاديث المختارة 9 / 84","srcLabel":"متفق عليه","text":["«جاءَ أعْرابِيَّانِ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يَسْأَلانِه، فقالَ أحَدُهما: يا رَسولَ اللهِ ",["أيُّ النَّاسِ خَيْرٌ",2],"؟ قالَ: ",["مَن طالَ عُمرُه وحَسُنَ عَمَلُه",1],"، قالَ: وقالَ الآخَرُ: يا رَسولَ اللهِ إنَّ شَرائِعَ الإسْلامِ قد كَثُرَتْ، فأَخْبِرْني مِنها بأمْرٍ أتَشَبَّثُ به، قالَ: لا يَزالُ لِسانُك رَطْبًا مِن ذِكْرِ اللهِ عَزَّ وجَلَّ»."],"grade":"صحيح","narrator":"عبدالله بن بسر المازني","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"5kQwg7gX","merged":7,"otherRefs":["السلسلة الصحيحة 4/452 (صحيح)","تخريج شرح السنة 1245 (صحيح)","الأحاديث المختارة 9 / 83 (صحيح)","صحيح الجامع 3297 (صحيح)","المستدرك على الصحيحين 1273 (صحيح)","تخريج المسند لشعيب 20480 (حسن)"]},{"id":"س-04971","fp":"a472c85f3b6a","stateId":508,"easy":"إذا طال عمرك وحسن عملك ← فأنت من خيار الناس","cause":"خِيارُكُم أطوَلُكُم أعمارًا، وأحسَنُكُم عَمَلًا","result":"ألَا أُنَبِّئُكُم بخِياركِمُ من شِراِرُكم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-00777","otherNeedIds":[36],"ref":"المستدرك على الصحيحين 1272","text":[["ألَا أُنَبِّئُكُم بخِياركِمُ من شِراِرُكم",2],"؟ قالوا: بلى، قالَ: ",["خِيارُكُم أطوَلُكُم أعمارًا، وأحسَنُكُم عَمَلًا",1],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح على شرط الشيخين [وله شاهد صحيح على شرط مسلم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"3VAfnD2b"},{"id":"س-00927","fp":"507894d4eb00","stateId":509,"easy":"إذا أكثرت ذكر الله ← تكون من أفضل العباد درجة يوم القيامة","cause":"درجةً عندَ اللهِ يومَ القيامَةِ الذاكرونَ اللهَ كثيرًا","result":"أفضلُ العبادةِ","explicit":true,"ref":"الجامع الصغير 1273","srcLabel":"الترمذي","text":[["أفضلُ العبادةِ",2],[" درجةً عندَ اللهِ يومَ القيامَةِ الذاكرونَ اللهَ كثيرًا ",1],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3376)، وأحمد (3376)، وأبو يعلى (1401) جميعا مطولا، والبيهقي في ((شعب الإيمان)) (583) مختصرا.","bab":"أدعية وأذكار › فضل الذكر","dorar":"63PdcrRO"},{"id":"س-00830","fp":"162a97448e86","stateId":509,"easy":"إذا أكثرت الحمد ← تكون من خير عباد الله يوم القيامة","cause":"الحمَّادونَ","result":"خيرَ عبادِ اللهِ تبارك وتعالى يومَ القيامةِ","explicit":true,"otherNeedIds":[65],"ref":"السلسلة الصحيحة 4/113","srcLabel":"أحمد","text":["أنه قال إني لَأُحدِّثُكَ بالحديثِ اليومَ ، لِينفعَك اللهُ عزَّ وجلَّ به بعدَ اليومِ ، اعلمْ أنَّ ",["خيرَ عبادِ اللهِ تبارك وتعالى يومَ القيامةِ",2]," ",["الحمَّادونَ",1]," ، واعلمْ أنه لن تزالَ طائفةٌ من أهلِ الإسلامِ يُقاتِلون على الحقِّ ، ظاهرين على من ناوَاهم ، حتى يقاتِلوا الدَّجَّالَ ، واعلمْ أنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ قد أعمر أهلَه في العشرِ . فلم تنزلْ آيةٌ تنسخُ ذلك . ولم ينهَ عنه رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ حتى مضى لوجهِه ، ارتأَى كلُّ امرئٍ ، بعدُ ، ما شاء أن يَرتئِيَ"],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"إسناده صحيح رجاله رجال الشيخين","takhrij":"أخرجه وأحمد (19895)، واللفظ له، والطبراني في ((المعجم الكبير)) (18/ 124) (254)،، والطبري في ((تهذيب الآثار -مسند عمر-)) (1161)،  واللفظ لهما مختصرا.","bab":"أدعية وأذكار › فضل التحميد والتسبيح والدعاء","dorar":"k8XSfZ2W","merged":3,"otherRefs":["السلسلة الصحيحة 1584 (صحيح)","مجمع الزوائد 10/98 (صحيح)"]},{"id":"س-06523","fp":"4ea84bf47fcc","stateId":510,"easy":"إذا غزوت في سبيل الله أو اعتزلت تعبد ربك ← تكون من أفضل الناس","cause":"رَجُلانِ: رَجُلٌ غَزا في سَبيلِ اللهِ حتى يَهبِطَ مَوضِعًا يَسوءُ العَدُوَّ، ورَجُلٌ بناحيةِ الباديةِ يُقيمُ الصَّلَواتِ الخَمسَ، ويُؤَدِّي حَقَّ مالِه، ويَعبُدُ رَبَّهُ حتى يَأتيَهُ اليَقينُ، فجثا على رُكبَتَيْهِ قال: آنتَ سمِعتَهُ مِن رسولِ اللهِ صلَّى اللهُ","result":"أفضَلُ النَّاسِ","explicit":true,"ref":"تخريج المسند لشعيب 10766","srcLabel":"البخاري","text":[["أفضَلُ النَّاسِ",2],[" رَجُلانِ: رَجُلٌ غَزا في سَبيلِ اللهِ حتى يَهبِطَ مَوضِعًا يَسوءُ العَدُوَّ، ورَجُلٌ بناحيةِ الباديةِ يُقيمُ الصَّلَواتِ الخَمسَ، ويُؤَدِّي حَقَّ مالِه، ويَعبُدُ رَبَّهُ حتى يَأتيَهُ اليَقينُ، فجثا على رُكبَتَيْهِ قال: آنتَ سمِعتَهُ مِن رسولِ اللهِ صلَّى اللهُ",1]," عليه وسلَّمَ يا أبا هُرَيرةَ يَقولُهُ؟ قال: نَعَمْ. فأتى باديَتَهُ، فأقامَ بها."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (10766) واللفظ له، والبخاري في ((التاريخ الكبير)) (4/235) ولم يسق لفظه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"KvMV18zz"},{"id":"س-04397","fp":"736be7a2105f","stateId":510,"easy":"إذا كنت على متن فرس تخيف العدو ويخيفك ← تكون من خير الناس منزلة","cause":"منزلةً رجُلٌ علَى مَتنِ فَرسٍ يُخيفُ العدُوَّ ويُخيفونَه","result":"خيرُ النَّاسِ","explicit":true,"ref":"صحيح الترغيب 1228","srcLabel":"صحيح الترغيب","text":[["خيرُ النَّاسِ",2],[" منزلةً رجُلٌ علَى مَتنِ فَرسٍ يُخيفُ العدُوَّ ويُخيفونَه ",1],"."],"grade":"صحيح","narrator":"أم مبشر الأنصارية","muhaddith":"صحيح لغيره","bab":"جهاد › الشجاعة في الحرب والجبن","dorar":"kJ218Ewx"},{"id":"س-04455","fp":"9a41f04f8ba2","stateId":510,"easy":"إذا جاهدت بنفسك ومالك ← تكون أفضل الناس","cause":"مُؤمِنٌ يُجاهِدُ بنَفسِه ومالِه في سَبيلِ اللهِ","result":"أيُّ النَّاسِ أفضَلُ يا رَسولَ اللهِ","explicit":true,"star":true,"otherNeedIds":[45],"ref":"صحيح مسلم 1888","srcLabel":"البخاري","text":["قال رَجُلٌ: ",["أيُّ النَّاسِ أفضَلُ يا رَسولَ اللهِ",2],"؟ قال: ",["مُؤمِنٌ يُجاهِدُ بنَفسِه ومالِه في سَبيلِ اللهِ",1],"، قال: ثُمَّ مَن؟ قال: ثُمَّ رَجُلٌ مُعتَزِلٌ في شِعبٍ مِنَ الشِّعابِ يَعبُدُ رَبَّه ويَدَعُ النَّاسَ مِن شَرِّه. وفي روايةٍ: بهذا الإسنادِ، فقال: ورَجُلٌ في شِعبٍ، ولم يَقُلْ: ثُمَّ رَجُلٌ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6494) باختلاف يسير","bab":"جهاد › فضل الجهاد","dorar":"oILSQmu9","merged":6,"otherRefs":["صحيح مسلم 1888 (صحيح)","تخريج المسند لشعيب 11535 (صحيح)","صحيح البخاري 6494 (صحيح)","صحيح ابن ماجه 3228 (صحيح)","تخريج المسند لشعيب 18051 (صحيح)"]},{"id":"س-04494","fp":"70f05e78e921","stateId":510,"easy":"إذا أمسكت برأس فرسك في سبيل الله ← تكون خير الناس منزلة","cause":"قال: قُلنا: بَلى يا رَسولَ اللهِ. قال: رَجُلٌ مُمسِكٌ برَأسِ فرَسٍ في سَبيلِ اللهِ حَتَّى يَموتَ أو يُقتَلَ","result":"ألا أُحَدِّثُكُم بخَيرِ النَّاسِ مَنزِلةً، فذَكَرَه يَعني حَديثَ: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم جاءَ -أو خَرَجَ عليهم- وهُم جُلوسٌ","explicit":true,"ref":"تخريج المسند لشعيب 2928","srcLabel":"أحمد","text":["عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم: خَرَجَ عليهم وهُم جُلوسٌ، فقال: ",["ألا أُحَدِّثُكُم بخَيرِ النَّاسِ مَنزِلةً، فذَكَرَه [يَعني حَديثَ: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم جاءَ -أو خَرَجَ عليهم- وهُم جُلوسٌ،",2]," فقال: ألا أُحَدِّثُكُم بخَيرِ النَّاسِ مَنزِلًا؟",[" قال: قُلنا: بَلى يا رَسولَ اللهِ. قال: رَجُلٌ مُمسِكٌ برَأسِ فرَسٍ في سَبيلِ اللهِ حَتَّى يَموتَ أو يُقتَلَ",1],"، ثُمَّ قال: ألا أُخبِرُكُم بالذي يَليه؟ قُلنا: بَلى يا رَسولَ اللهِ. قال: امرُؤٌ مُعتَزِلٌ في شِعبٍ يُقيمُ الصَّلاةَ، ويُؤتي الزَّكاةَ، ويَعتَزِلُ شُرورَ النَّاسِ، ثُمَّ قال: ألا أُخبِرُكُم بشَرِّ النَّاسِ مَنزِلًا؟ قال: قُلنا: بَلى يا رَسولَ اللهِ. قال: الذي يُسأَلُ باللهِ، ولا يُعطي به]."],"grade":"صحيح","narrator":"ابن عباس","muhaddith":"إسناده صحيح","bab":"جهاد › فضل الجهاد","dorar":"FW652v5E","merged":8,"otherRefs":["صحيح ابن حبان 604 (صحيح)","تخريج المسند لشعيب 10779 (صحيح)","المصابيح في الأحاديث المتواترة 604 (صحيح)","تخريج صحيح ابن حبان 605 (صحيح)","الأحكام الوسطى 4/ 338 (صحيح)","السلسلة الصحيحة 255 (صحيح)","تخريج المسند لشعيب 9142 (صحيح)"]},{"id":"س-06177","fp":"54edcf2dc8bb","stateId":510,"easy":"إذا اعتزلت الفتن في ماشيتك تؤدي حقها وتعبد ربك ← فأنت من خير الناس فيها","cause":"رجلٌ في ماشِيَتِه ؛ يُؤَدِّي حَقَّها ويعبدُ ربَّه ، ورجلٌ أَخَذَ برأسِ فَرَسِه ؛ يُخِيفُ الْعَدُوَّ ويُخَوِّفُونَه","result":"مَن خَيْرُ الناسِ فيها","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"star":true,"otherNeedIds":[59],"ref":"هداية الرواة 5327","srcLabel":"الترمذي","text":["عن أُمِّ مالكٍ البَهْزِيَّةِ ، أنها قالت : ذَكَرَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فتنةً ، فقَرَّبَها قلتُ : ",["مَن خَيْرُ الناسِ فيها",2]," ؟ ! قال : ",["رجلٌ في ماشِيَتِه ؛ يُؤَدِّي حَقَّها ويعبدُ ربَّه ، ورجلٌ أَخَذَ برأسِ فَرَسِه ؛ يُخِيفُ الْعَدُوَّ ويُخَوِّفُونَه",1]," ."],"grade":"صحيح","narrator":"أم مالك البهزية","muhaddith":"له شاهد فهو به صحيح","takhrij":"أخرجه الترمذي (2177) باختلاف يسير، وابن أبي الدنيا في ((العزلة والانفراد)) (152)، والطبراني (25/150) (362) بنحوه","bab":"زكاة › فرض الزكاة","dorar":"SmDkqFB5"}]}