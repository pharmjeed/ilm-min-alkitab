{"schema":1,"kind":"sunan-chunk","version":"sunan-b53213585e2f","needId":15,"stateIds":[107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125],"items":[{"id":"س-02473","fp":"051dd8ed0176","stateId":107,"easy":"إذا آمنت بالشهادتين والبعث والقدر ← يصح إيمانك","cause":"حتَّى يُؤمِنَ بأرْبَعٍ: شَهادةِ أنْ لا إلهَ إلَّا اللهُ، وأنِّي رَسولُ اللهِ، بَعَثَني بالحَقِّ، وحتَّى يُؤمِنَ بالبَعْثِ بَعْدَ المَوْتِ، وحتَّى يُؤمِنَ بالقَدَرِ كُلِّه","result":"لا يُؤمِنُ عَبْدٌ","explicit":true,"star":true,"ref":"الأحاديث المختارة 440","srcLabel":"البخاري","text":["«",["لا يُؤمِنُ عَبْدٌ",2]," ",["حتَّى يُؤمِنَ بأرْبَعٍ: شَهادةِ أنْ لا إلهَ إلَّا اللهُ، وأنِّي رَسولُ اللهِ، بَعَثَني بالحَقِّ، وحتَّى يُؤمِنَ بالبَعْثِ بَعْدَ المَوْتِ، وحتَّى يُؤمِنَ بالقَدَرِ كُلِّه",1],"»."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"إسلام › فضل الشهادتين","dorar":"uO3wjL6B","merged":3,"otherRefs":["تخريج سير أعلام النبلاء 10/158 (صحيح)","الأحاديث المختارة 441 (صحيح)"]},{"id":"س-05962","fp":"4df65d7d8a6b","stateId":107,"easy":"إذا آمنت بالله وحده وبالقدر خيره وشره ← تبلغ التقوى والعلم","cause":"تُؤمِنَ باللهِ وَحْدَه، وتُؤمِنَ بالقَدَرِ خَيْرِه وشَرِّه","result":"لن تَتَّقيَ اللهَ ولن تَبلُغَ العِلمَ حتَّى","explicit":true,"star":true,"similar":["س-07944"],"otherNeedIds":[16],"ref":"الأحاديث المختارة 8 / 351","srcLabel":"متفق عليه","text":["«سألْتُ الوَليدَ بنَ عُبادةَ بنِ الصَّامِتِ، كيف كانَ في وَصِيَّةِ أبيك؟ قالَ: حينَ حَضَرَتْه الوَفاةُ دَعاني فقالَ لي: يا بُنَيَّ اتَّقِ اللهَ، واعْلَمْ أنَّك ",["لن تَتَّقيَ اللهَ ولن تَبلُغَ العِلمَ حتَّى",2]," ",["تُؤمِنَ باللهِ وَحْدَه، وتُؤمِنَ بالقَدَرِ خَيْرِه وشَرِّه",1],"، قُلْتُ: يا أبة وكيف أُؤمِنُ بالقَدَرِ خَيْرِه وشَرِّه؟ فقالَ: تَعلَمُ أنَّ ما أصابَك لم يكنْ ليُخْطِئَك، وما أَخْطَأَك لم يكنْ ليُصيبَك؛ هذا القَدَرُ، فإن مِتَّ على غَيْرِ هذا دَخَلْتَ النَّارَ، سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: (إنَّ أوَّلَ ما خَلَقَ اللهُ القَلَمُ فقالَ: اكْتُبْ، فقالَ: أي رَبِّ وما أَكتُبُ؟ قالَ: القَدَرَ، فجَرى القَلَمُ في تلك السَّاعةِ ما كانَ وما هو كائِنٌ إلى الأبَدِ»)."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الوصايا النافعة","dorar":"BBHstt9N","merged":2,"otherRefs":["تاريخ الطبري 1/32 (صحيح)"]},{"id":"س-02597","fp":"1c20959ea70e","stateId":107,"easy":"إذا قلت «مُطرنا بفضل الله ورحمته» ← فأنت مؤمن بالله كافر بالكوكب","cause":"مَن قال: مُطِرنا بفَضلِ اللهِ ورَحمَتِه","result":"فذلك مُؤمِنٌ بي كافِرٌ بالكَوكَبِ","explicit":true,"star":true,"apply":{"k":"say","t":"«مُطرنا بفضل الله ورحمته»"},"similar":["س-07456"],"otherNeedIds":[13],"ref":"صحيح البخاري 1038","srcLabel":"مسلم","text":["صَلَّى لَنا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم صَلاةَ الصُّبحِ بالحُدَيبيةِ على إثرِ سَماءٍ كانَت مِنَ اللَّيلةِ، فلَمَّا انصَرَفَ النَّبيُّ صلَّى اللهُ عليه وسلَّم أقبَلَ على النَّاسِ، فقال: هل تَدرونَ ماذا قال رَبُّكُم؟ قالوا: اللهُ ورَسولُه أعلَمُ، قال: أصبَحَ مِن عِبادي مُؤمِنٌ بي وكافِرٌ، فأمَّا ",["مَن قال: مُطِرنا بفَضلِ اللهِ ورَحمَتِه",1],"، ",["فذلك مُؤمِنٌ بي كافِرٌ بالكَوكَبِ",2],"، وأمَّا مَن قال: بنَوءِ كَذا وكَذا، فذلك كافِرٌ بي مُؤمِنٌ بالكَوكَبِ."],"grade":"صحيح","narrator":"زيد بن خالد الجهني","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (71) باختلاف يسير","bab":"إيمان › أعمال تنافي الإيمان","dorar":"VrjzJDWE","merged":2,"otherRefs":["صحيح النسائي 1524 (صحيح)"]},{"id":"س-01740","fp":"147185cc0b2c","stateId":107,"easy":"إذا رضيت بالله رباً وبالإسلام ديناً وبمحمد رسولاً ← تذوق طعم الإيمان","cause":"مَنْ رَضِىَ باللهِ ربًّا ، و بِالإسلامِ دِينًا ، و بِمُحمدٍ رسولًا","result":"ذاقَ طعمَ الإِيمانِ","explicit":true,"star":true,"ref":"صحيح الجامع 3425","srcLabel":"مسلم","text":[["ذاقَ طعمَ الإِيمانِ",2]," ",["مَنْ رَضِىَ باللهِ ربًّا ، و بِالإسلامِ دِينًا ، و بِمُحمدٍ رسولًا",1]],"grade":"صحيح","narrator":"العباس بن عبدالمطلب","muhaddith":"صحيح","takhrij":"أخرجه مسلم (34)","bab":"أنبياء › محمد","dorar":"0fOe4T9z"},{"id":"س-07224","fp":"1f4a9bf37778","stateId":107,"easy":"إذا كرهت وسوسة الشيطان في قلبك وتعاظمتها ← فذاك صريح الإيمان","cause":"لو خَرَّ مِن السَّماءِ فتخطَفُه الطَّيرُ كان أحَبَّ إليه مِن أنْ يتكلَّمَ","result":"ذاك صريحُ الإيمانِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج صحيح ابن حبان 149","srcLabel":"مسلم","text":["أتَيْتُ سُعَيْرَ بنَ الخِمْسِ أسأَلُه عن حديثِ الوسوسةِ فلَمْ يُحدِّثْني فأدبَرْتُ أبكي ثمَّ لقيني فقال: تَعالَ، حدَّثَنا مُغيرةُ عن إبراهيمَ عن علقمةَ عن عبدِ اللهِ قال: سأَلْنا رسولَ اللهِ صلَّى اللهُ عليه وسلَّم عن الرَّجُلِ يجِدُ الشَّيءَ ",["لو خَرَّ مِن السَّماءِ فتخطَفُه الطَّيرُ كان أحَبَّ إليه مِن أنْ يتكلَّمَ",1]," قال: ( ",["ذاك صريحُ الإيمانِ",2]," )"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (133) مختصراً بلفظ: \"تلك محض الإيمان\"","bab":"علم › حسن السؤال ونصح العالم","dorar":"YtmGD3ID","merged":17,"otherRefs":["تخريج كتاب السنة 659 (صحيح)","تخريج كتاب السنة 655 (حسن)","مجمع الزوائد 1/38 (صحيح)","رفع البأس عن حديث النفس 37 (صحيح)","صحيح مسلم 132 (صحيح)","تخريج المسند لشعيب 9694 (صحيح)","صحيح ابن حبان 145 (صحيح)","تخريج المسند لشعيب 9876 (صحيح)","تخريج المسند لشعيب 24752 (صحيح)","تخريج كتاب السنة 654 (صحيح)","شرح البخاري لابن الملقن 33/40 (حسن)","تخريج صحيح ابن حبان 148 (صحيح)","تخريج كتاب السنة 657 (صحيح)","صحيح أبي داود 5111 (صحيح)","صحيح مسلم 133 (صحيح)","تخريج كتاب السنة 656 (حسن)"]},{"id":"س-07456","fp":"cbcaad3823c3","stateId":107,"easy":"إذا قلت «مُطرنا برحمة الله وفضله» ← فأنت مؤمن بالله كافر بالكوكب","cause":"مَن قال: مُطِرنا برَحمةِ اللهِ وبرِزقِ اللهِ وبفَضلِ اللهِ","result":"فهو مُؤمِنٌ بي، كافِرٌ بالكَوكَبِ، وأمَّا","explicit":true,"apply":{"k":"say","t":"«مُطرنا برحمة الله وفضله»"},"repOf":"س-02597","ref":"صحيح البخاري 4147","text":["خَرَجنا مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم عامَ الحُدَيبيةِ، فأصابَنا مَطَرٌ ذاتَ لَيلةٍ، فصَلَّى لَنا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم الصُّبحَ، ثُمَّ أقبَلَ علينا فقال: أتَدرونَ ماذا قال رَبُّكُم؟ قُلنا: اللهُ ورَسولُه أعلَمُ، فقال: قال اللهُ: أصبَحَ مِن عِبادي مُؤمِنٌ بي وكافِرٌ بي، فأمَّا ",["مَن قال: مُطِرنا برَحمةِ اللهِ وبرِزقِ اللهِ وبفَضلِ اللهِ، ",1],["فهو مُؤمِنٌ بي، كافِرٌ بالكَوكَبِ، وأمَّا ",2],"مَن قال: مُطِرنا بنَجمِ كَذا، فهو مُؤمِنٌ بالكَوكَبِ كافِرٌ بي"],"grade":"صحيح","narrator":"زيد بن خالد الجهني","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (71)، وأبو داود (3906)، وابن منده في ((الإيمان)) (504)، وابن بشران في ((أمالي)) (915) واللفظ لهم.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"MFufkCYO"},{"id":"س-07073","fp":"9472d28c7c39","stateId":107,"easy":"إذا آمنت بالوحي ولم ترَ النبي ﷺ ← فإيمانك من أعجب الإيمان","cause":"قَومٌ يَأتونَ بَعدَكُم يَجِدونَ صُحُفًا يُؤمِنونَ بِها","result":"أَيُّ الخلقِ أعجَبُ إليكُم إيمانًا","explicit":true,"otherNeedIds":[41,40],"ref":"فتح المغيث 2/156","srcLabel":"فتح المغيث","text":[["أَيُّ الخلقِ أعجَبُ إليكُم إيمانًا",2]," ؟ قالوا : الملائكَةُ . قال : وكيفَ لا يُؤمِنونَ وهم عِندَ رِبِّهِمْ ؟ وذكروا الأنبياءَ ، قال : وكيفَ لا يُؤمِنونَ والوحيُ يُنزَلُ عليهِمْ ؟ قالوا : نَحنُ ، قال : وكيفَ لا تؤمِنونَ وأنا بين أَظهُرِكُم ؟ قالوا : فمَن يا رَسولَ اللهِ ؟ قال : ",["قَومٌ يَأتونَ بَعدَكُم يَجِدونَ صُحُفًا يُؤمِنونَ بِها",1]],"grade":"صحيح","muhaddith":"صحيح","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"VjE4c0a0","merged":6,"otherRefs":["الأمالي المطلقة 42 (حسن)","الاستذكار 1/229 (حسن)","الأمالي المطلقة 40 (حسن)","السلسلة الصحيحة 3215 (حسن)","السلسلة الصحيحة 7/906 (حسن)"]},{"id":"س-07944","fp":"b4a59479b08d","stateId":107,"easy":"إذا آمنت بالقدر خيره وشره ← تذوق طعم الإيمان وتبلغ حقيقة العلم","cause":"حتَّى تُؤمِنَ بالقدَرِ خَيرِه وشَرِّه","result":"إنَّك لنْ تطعَمَ طعمَ الإيمانِ، ولنْ تبلُغَ حَقَّ حقيقةِ العلمِ","explicit":true,"repOf":"س-05962","otherNeedIds":[16],"ref":"إتحاف الخيرة المهرة 1/173","text":["دخلْتُ على عُبادةَ بنِ الصَّامتِ وهو مريضٌ يُتخيَّلُ فيه الموتُ -أو يتبيَّنُ- فقلْتُ: يا أبتاهُ، أوصِني واجتهِدْ لي، فقال: أجْلِسوني. فلمَّا أجْلَسوه قال: يا بُنَيَّ، ",["إنَّك لنْ تطعَمَ طعمَ الإيمانِ، ولنْ تبلُغَ حَقَّ حقيقةِ العلمِ",2]," ",["حتَّى تُؤمِنَ بالقدَرِ خَيرِه وشَرِّه",1],". قلْتُ: يا أبتاهُ، وكيف لي أعلَمُ ما خيرُ القدَرِ مِن شَرِّه؟ قال: تعلَمُ أنَّ ما أخطَأَك لم يكُنْ ليُصيبَك، وما أصابَكَ لم يكُنْ ليُخطِئَك. يا بُنَيَّ، إنِّي سمِعْتُ رسولَ اللهِ صَلَّى اللهُ عليه وسلَّمَ يقولُ: إنَّ أوَّلَ ما خلَقَ اللهُ عَزَّ وجَلَّ القلمُ، قال: اكتُبْ. فجَرى في تلك السَّاعةِ بما هو كائنٌ إلى يومِ القيامةِ. يا بُنَيَّ، إنْ مِتَّ ولستَ على ذلك دخلْتَ النَّارَ."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"إسناده صحيح رجاله ثقات","takhrij":"أخرجه أحمد (22705)، وابن أبي عاصم في ((السنة)) (111)، والفريابي في ((القدر)) (77)، والطبراني في ((المعجم الأوسط)) (6318) واللفظ لهم جميعا.","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"meWChdUh","merged":6,"otherRefs":["تخريج المسند لشعيب 6703 (صحيح)","تخريج كتاب السنة 133 (حسن)","صحيح الترمذي 2144 (صحيح)","القضاء والقدر 204 (صحيح)","الأحاديث المختارة 8 / 352 (صحيح)"]},{"id":"ق-0059","fp":"8fd56c34716c","stateId":107,"easy":"خصال البر: الإيمان وإيتاء المال على حبّه والصلاة والزكاة والوفاء بالعهد والصبر ← الصدق والتقوى","cause":"خصال البر: الإيمان وإيتاء المال على حبّه والصلاة والزكاة والوفاء بالعهد والصبر","result":"الصدق والتقوى","explicit":true,"ref":"سورة البقرة: 177","srcLabel":"القرآن الكريم","quran":{"s":2,"from":177,"to":177,"text":"لَيْسَ الْبِرَّ أَنْ تُوَلُّوا وُجُوهَكُمْ قِبَلَ الْمَشْرِقِ وَالْمَغْرِبِ وَلَكِنَّ الْبِرَّ مَنْ آمَنَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَالْمَلَائِكَةِ وَالْكِتَابِ وَالنَّبِيِّينَ وَآتَى الْمَالَ عَلَى حُبِّهِ ذَوِي الْقُرْبَى وَالْيَتَامَى وَالْمَسَاكِينَ وَابْنَ السَّبِيلِ وَالسَّائِلِينَ وَفِي الرِّقَابِ وَأَقَامَ الصَّلَاةَ وَآتَى الزَّكَاةَ وَالْمُوفُونَ بِعَهْدِهِمْ إِذَا عَاهَدُوا وَالصَّابِرِينَ فِي الْبَأْسَاءِ وَالضَّرَّاءِ وَحِينَ الْبَأْسِ أُولَئِكَ الَّذِينَ صَدَقُوا وَأُولَئِكَ هُمُ الْمُتَّقُونَ (177)","hl":[[95,518,1]]}},{"id":"ق-0228","fp":"823b9ff5998b","stateId":107,"easy":"تحكيم الرسول والرضا والتسليم ← تحقق الإيمان","cause":"تحكيم الرسول والرضا والتسليم","result":"تحقق الإيمان","explicit":true,"ref":"سورة النساء: 65","srcLabel":"القرآن الكريم","quran":{"s":4,"from":65,"to":65,"text":"فَلَا وَرَبِّكَ لَا يُؤْمِنُونَ حَتَّى يُحَكِّمُوكَ فِيمَا شَجَرَ بَيْنَهُمْ ثُمَّ لَا يَجِدُوا فِي أَنْفُسِهِمْ حَرَجًا مِمَّا قَضَيْتَ وَيُسَلِّمُوا تَسْلِيمًا (65)","hl":[[0,161,1]]}},{"id":"ق-0385","fp":"26a9df07159b","stateId":107,"easy":"اتباع الصراط المستقيم وترك السبل ← عدم التفرق والتقوى","cause":"اتباع الصراط المستقيم وترك السبل","result":"عدم التفرق والتقوى","explicit":true,"otherNeedIds":[13],"ref":"سورة الأنعام: 153","srcLabel":"القرآن الكريم","quran":{"s":6,"from":153,"to":153,"text":"وَأَنَّ هَذَا صِرَاطِي مُسْتَقِيمًا فَاتَّبِعُوهُ وَلَا تَتَّبِعُوا السُّبُلَ فَتَفَرَّقَ بِكُمْ عَنْ سَبِيلِهِ ذَلِكُمْ وَصَّاكُمْ بِهِ لَعَلَّكُمْ تَتَّقُونَ (153)","hl":[[0,159,1]]}},{"id":"س-03188","fp":"b77c7c866b79","stateId":107,"easy":"إذا أسلمت ولو لأجل الدنيا ← لا يمسي حتى يكون الإسلام أحب إليك منها","cause":"يسلمُ للشيءِ من الدنيا لا يُسلمُ إلا له","result":"فما يُمسِي حتى يكونَ الإسلامُ أحبَّ إليه من الدنيا وما فيها","explicit":true,"ref":"مجمع الزوائد 3/107","srcLabel":"أحمد","text":["إن كان الرجلُ ليأتِي رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ",["يسلمُ للشيءِ من الدنيا لا يُسلمُ إلا له",1]," ",["فما يُمسِي حتى يكونَ الإسلامُ أحبَّ إليه من الدنيا وما فيها",2]," وفي روايةٍ إن كان الرجلُ ليسألُ النبيَّ صلَّى اللهُ عليه وسلَّم الشيءَ للدنيا فيسلمُ له . . . . . . . ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أبو يعلى (3750) واللفظ له، وأحمد (12050)، وأبو نعيم في ((حلية الأولياء)) (10/ 381) باختلاف يسير.","bab":"إيمان › دعوة الكافر إلى الإسلام","dorar":"RM05YVcs","merged":2,"otherRefs":["تخريج المسند لشعيب 12050 (صحيح)"]},{"id":"س-07681","fp":"e481e56f30e0","stateId":107,"easy":"إذا آمنت بالقدر وأيقنت أن ما أصابك لم يكن ليخطئك ← تجد طعم الإيمان","cause":"حتى تؤمنَ بالقدرِ , وتعلمَ أن ما أصابَك لم يكنْ لِيخطِئَك , وما أخطأك لم يكنْ ليصيبَك","result":"إنك لن تجدَ طعمَ الإيمانِ","explicit":true,"otherNeedIds":[5],"ref":"مجموع فتاوى ابن باز 89/8","srcLabel":"مجموع فتاوى ابن باز","text":["عن عبادةَ بنِ الصامتِ رضِيَ اللهُ عنه أنه قال لابنِه : ",["إنك لن تجدَ طعمَ الإيمانِ",2]," ",["حتى تؤمنَ بالقدرِ , وتعلمَ أن ما أصابَك لم يكنْ لِيخطِئَك , وما أخطأك لم يكنْ ليصيبَك",1]," , جفَّتِ الأقلامُ وطُويَت الصحفُ"],"grade":"صحيح","muhaddith":"[ثابت]","bab":"قدر › كل شيء بقدر","dorar":"kODLqlzV"},{"id":"س-01503","fp":"c22a8467f457","stateId":107,"easy":"إذا شهدت أن لا إله إلا الله ← خلعت الأنداد","cause":"يقولُ أشهدُ أن لا إلهَ إلا اللهُ","result":"خلعَ الأندادَ","explicit":true,"ref":"مجمع الزوائد 1/340","srcLabel":"الطبراني","text":["أن رسولَ اللهِ صلَّى اللهُ عليه وسلَّم كان في سفرٍ فسمع مؤذنًا ",["يقولُ أشهدُ أن لا إلهَ إلا اللهُ",1]," فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["خلعَ الأندادَ",2]," فقال أشهدُ أن محمدًا رسولُ اللهِ فقال خرج من النارِ ثم قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم تجدونه صاحبَ مِعْزًى معزبًا أو صاحبَ كلابٍ"],"grade":"حسن","narrator":"وهب بن عبدالله السوائي أبو جحيفة","muhaddith":"رجاله ثقات","takhrij":"أخرجه البزار (4225) واللفظ له، والطبراني في ((الدعاء)) (477) بنحوه.","bab":"أذان › فضل التأذين","dorar":"GG3T2ERU"},{"id":"س-01504","fp":"b8d876d4b6e0","stateId":107,"easy":"إذا شهدت الشهادتين ← خرجت من الشرك","cause":"أشهدُ أن لا إلهَ إلا اللهُ أشهدُ أن محمدًا رسولُ اللهِ","result":"خرج من الشركِ","explicit":true,"ref":"مجمع الزوائد 1/340","srcLabel":"البزار","text":["كنَّا معَ النبيِّ صلَّى اللهُ عليه وسلَّم في سفرٍ فسمع رجلًا يقولُ اللهُ أكبرُ اللهُ أكبرُ ",["أشهدُ أن لا إلهَ إلا اللهُ أشهدُ أن محمدًا رسولُ اللهِ",1]," فقال ",["خرج من الشركِ",2]],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"رجاله ثقات","takhrij":"أخرجه البزار، كما في ((كشف الأستار)) (359) واللفظ له","bab":"أذان › فضل التأذين","dorar":"AcVoaJgS"},{"id":"س-03215","fp":"62890d9d5353","stateId":107,"easy":"إذا آمنت بالنبي ﷺ ولم تره ← فأنت من إخوانه الذين ودّ لقاءهم","cause":"الذين آمنوا ، و لم يروْني","result":"ودِدْتُ أني لقيتُ إخواني","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[41],"ref":"صحيح الجامع 7108","srcLabel":"صحيح الجامع","text":[["ودِدْتُ أني لقيتُ إخواني",2]," ، ",["الذين آمنوا ، و لم يروْني",1]],"grade":"صحيح","narrator":"أنس بن مالك وأبو هريرة","muhaddith":"صحيح","bab":"إيمان › فضل الإيمان","dorar":"jNevOonL"},{"id":"س-02763","fp":"acab000038d0","stateId":107,"easy":"إذا آمنت بالنبي ﷺ ولم تره وعملت بما في المصحف ← فأنت من أفضل أهل الإيمان","cause":"فيُؤْمِنونَ بي ولم يَرَوْني، ويَجِدُون الوَرَقَ المُعَلَّقَ، فيَعمَلُون بما فيه","result":"فهؤلاءِ أفضَلُ أهْلِ الإيمانِ إيمانًا","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[41],"ref":"المستدرك على الصحيحين 7188","srcLabel":"أبو يعلى","text":["كُنْتُ معَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ جالسًا، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: أتدْرُونَ أيُّ أهْلِ الإيمانِ أفضَلُ إيمانًا؟ قالوا: يا رسولَ اللهِ، الملائكةُ؟ قالَ: هُمْ كذلكَ، ويحِقُّ ذلكَ لهم، وما يَمْنَعُهم وقدْ أنزَلَهم اللهُ المنزلةَ الَّتي أنْزَلَهم بها؟ بلْ غَيْرُهم، قالوا: يا رسولَ اللهِ، فالأنبياءُ الَّذين أكَرَمَهُم اللهُ تعالَى بالنُّبُوَّةِ والرِّسالةِ؟ قالَ: هُم كذلكَ، وحُقَّ لهُم، بلْ غَيْرُهم، قالَ: قُلْنا: يا رسولَ اللهِ، فمَنْ هُم؟ قالَ: أقوامٌ يأْتونَ مِن بَعْدي في أصلابِ الرِّجالِ، ",["فيُؤْمِنونَ بي ولم يَرَوْني، ويَجِدُون الوَرَقَ المُعَلَّقَ، فيَعمَلُون بما فيه",1],"، ",["فهؤلاءِ أفضَلُ أهْلِ الإيمانِ إيمانًا",2],"."],"grade":"صحيح","narrator":"عمر","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو يعلى في ((مسنده)) (160)، وابن عساكر في ((تاريخه)) (58/ 255) باختلاف يسير، وذكره الثعلبي في ((تفسيره)) (3/ 79).","bab":"إيمان › الملائكة","dorar":"J8ZtbEnD"},{"id":"س-07258","fp":"6dab47c531dc","stateId":108,"easy":"إذا جلست تذكر الله وتحمده ← يزداد إيمانك","cause":"فيذْكرانِ اللَّهَ تعالى ويحمدانِهِ","result":"نؤمِنُ ساعةً","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"فتح الباري لابن حجر 1/63","srcLabel":"فتح الباري لابن حجر","text":["عن الأسودِ بنِ هلالٍ قالَ قالَ لي معاذُ بنُ جبلٍ اجلِس بنا ",["نؤمِنُ ساعةً",2]," وفي روايةٍ لَهما كانَ معاذُ بنُ جبلٍ يقولُ للرَّجلِ من إخوانِهِ اجلس بنا نؤمنُ ساعةً فيجلِسانِ ",["فيذْكرانِ اللَّهَ تعالى ويحمدانِهِ",1]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"علم › فضل مجالس العلم والذكر","dorar":"39GjmxF5"},{"id":"س-05626","fp":"c286e14374f4","stateId":108,"easy":"إذا جالست الذاكرين ← يزيد إيمانك (أثر ابن مسعود)","cause":"ومجالستُهم","result":"زيادةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"مجمع الزوائد 2/192","srcLabel":"مجمع الزوائد","text":["عن عبدِ اللَّهِ بنِ مسعودٍ أنَّهُ كانَ يقولُ إذا قعدَ إنَّكم في ممرِّ اللَّيلِ والنَّهارِ في آجالٍ منقوضةٍ وأعمالٍ محفوظةٍ والموتُ يأتي بغتةً فمن زرعَ خيرًا يوشِكُ أن يحصدَ رغبةً ومن زرعَ شرًّا يوشكُ أن يحصدَ ندامةً ولكلِّ زارعٍ ما زرعَ لا يسبقُ بطيءٌ بحظِّهِ ولا يدركُ حريصٌ بحرصهِ ما لم يقدَّر لهُ فمن أعطيَ خيرًا فاللَّهُ أعطاهُ ومن وُقيَ شرًّا فاللَّهُ وقاهُ المتَّقونَ سادةٌ والفقهاءُ قادةٌ ",["ومجالستُهم",1]," ",["زيادةٌ",2]],"grade":"حسن","muhaddith":"رجاله موثقون","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"PnV6D4wI","merged":2,"otherRefs":["كشف الخفاء 2/83 (حسن)"]},{"id":"س-00755","fp":"efcc106c8007","stateId":109,"easy":"إذا شعرت أن إيمانك يبلى ← فاسأل الله أن يجدّده في قلبك","cause":"فاسْألُوا اللهَ تعالَى : أنْ يُجَدِّدَ الإيمانَ في قُلوبِكمْ","result":"إنَّ الإيمانَ لَيَخْلَقُ في جَوْفِ أحدِكُمْ كَما يَخلَقُ الثّوبُ","explicit":true,"star":true,"ref":"صحيح الجامع 1590","srcLabel":"الحاكم","text":[["إنَّ الإيمانَ لَيَخْلَقُ في جَوْفِ أحدِكُمْ كَما يَخلَقُ الثّوبُ",2]," ، ",["فاسْألُوا اللهَ تعالَى : أنْ يُجَدِّدَ الإيمانَ في قُلوبِكمْ",1]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (14/70) (14668)، والحاكم (5)، والديلمي في ((الفردوس)) (387) باختلاف يسير","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"snw02ZOE"},{"id":"س-06602","fp":"6bb4f787e772","stateId":110,"easy":"إذا صليت ← فالصلاة برهان","cause":"الصلاةُ","result":"برهانٌ","explicit":true,"star":true,"ref":"تخريج سنن الترمذي 2/513","srcLabel":"الترمذي","text":["عن كعبِ بنِ عُجرةَ قال : قال لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : أعيذُكَ باللهِ يا كعبُ بنَ عُجرةَ مِن أمراءٍ يكونونَ مِن بعدي ، فمَن غَشى أبوابَهم فصدَّقهم في كذبِهم وأعانَهم على ظلمِهم فليس مِني ولستُ منه ، ولا يَرِدُ عليَّ الحوضَ ، ومَن غَشى أبوابَهم أو لم يَغشَ فلم يصدِّقْهم في كذبِهم ولم يُعِنْهم على ظلمِهم فهو مِني وأنا منه ، وسيرِدُ عليَّ الحوضَ . يا كعبُ بنَ عُجرةَ ! ",["الصلاةُ",1]," ",["برهانٌ",2]," ، والصومُ جُنَّةٌ حصينةٌ ، والصدقةُ تُطفِئُ الخطيئةَ كما يُطفِئُ الماءُ النارَ . يا كعبُ بنَ عُجرةَ ! إنه لا يَربو لحمٌ نبَت مِن سُحتٍ إلا كانَتِ النارُ أَولى به ."],"grade":"صحيح","narrator":"كعب بن عجرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (614) بلفظه، والنسائي (4207)، والطبراني (19/ 105) (212) بنحوه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"AS7E5T0c","merged":3,"otherRefs":["تخريج المسند لشعيب 22909 (صحيح)","المستدرك على الصحيحين 7358 (صحيح)"]},{"id":"س-06743","fp":"16188739c73a","stateId":110,"easy":"إذا أحسنت الصلاة والصوم ← يزيد إيمانك","cause":"إذا عمِلْنا الصلاةَ والصومَ فأحسنَّا","result":"زيادتُهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[19],"ref":"الأباطيل والمناكير 2/197","srcLabel":"الأباطيل والمناكير","text":["الإيمانُ يزيدُ وينقصُ أمَّا ",["زيادتُهُ",2]," ",["إذا عمِلْنا الصلاةَ والصومَ فأحسنَّا",1]," ونقصانَهُ إذا عصيْنَا ولمْ نعملِ الصلاةَ والصومَ"],"grade":"حسن","narrator":"معاذ بن جبل","muhaddith":"حسن","takhrij":"أورده الجورقاني في ((الأباطيل والمناكير)) (2/197)","bab":"صيام › فضل الصيام","dorar":"2RBWXmQe"},{"id":"س-03890","fp":"b2dddb4c0af1","stateId":111,"easy":"إذا رأيت الرجل يعتاد المسجد ← فاشهد له بالإيمان","cause":"إذا رَأيتُمُ الرَّجُلَ يَعتادُ المَسجِدَ","result":"فاشهَدوا عليه بالإيمانِ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 865","srcLabel":"الترمذي","text":[["إذا رَأيتُمُ الرَّجُلَ يَعتادُ المَسجِدَ",1]," ",["فاشهَدوا عليه بالإيمانِ",2],"، قالَ اللهُ عزَّ وجلَّ: {إِنَّمَا ‌يَعْمُرُ ‌مَسَاجِدَ اللَّهِ مَنْ آمَنَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ} [التوبة: 18]."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[صحيح]","takhrij":"أخرجه الترمذي (3093)، وابن ماجه (802)، وأحمد (11651)، والدارمي (1259) جميعا بلفظه مطولا.","bab":"تفسير آيات › سورة التوبة","dorar":"EmKMR25P","merged":2,"otherRefs":["صحيح ابن حبان 1721 (صحيح)"]},{"id":"س-02295","fp":"868859bc7e23","stateId":111,"easy":"إذا لزمت المسجد ← يُشهد لك بالإيمان","cause":"يَلزمُ المسجدَ","result":"فلا تحَرَّجوا أنْ تشْهَدوا أنَّه مؤمنٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"المستدرك على الصحيحين 3322","srcLabel":"الترمذي","text":["«إذا رأيتُم الرَّجلَ ",["يَلزمُ المسجدَ",1],"، ",["فلا تحَرَّجوا أنْ تشْهَدوا أنَّه مؤمنٌ",2],"؛ فإنَّ اللهَ يقولُ: {إِنَّمَا يَعْمُرُ مَسَاجِدَ اللَّهِ مَنْ آمَنَ بِاللَّهِ} [التوبة: 18]»."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (3093)، وابن ماجه (802)، وأحمد (11651)، والدارمي (1259) جميعا بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"HN9j58Th"},{"id":"س-00963","fp":"acf78dd92958","stateId":112,"easy":"إذا تطهرت ← فالطهور شطر الإيمان","cause":"الطُّهورُ","result":"شَطرُ الإيمانِ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 22909","srcLabel":"مسلم","text":[["الطُّهورُ ",1],["شَطرُ الإيمانِ",2],"، فذَكَرَ مِثلَه [أي: حَديثَ: الطُّهورُ شَطرُ الإيمانِ، والحَمدُ لله تملأُ الميزانَ، وسُبحانَ الله والحَمدُ لله واللهُ أكبَرُ تملأُ ما بين السَّماءِ والأرضِ، والصَّلاةُ نورٌ، والصَّدَقةُ بُرهانٌ، والصَّبرُ ضِياءٌ، والقُرآنُ حُجَّةٌ لك أو عليك. كلُّ النَّاسِ يغدو؛ فبائِعٌ نَفسَه فمُعتِقُها أو مُوبِقُها]، إلَّا أنَّه قال: الصَّلاةُ بُرهانٌ، والصَّدَقةُ نورٌ."],"grade":"صحيح","narrator":"أبو مالك الأشعري","muhaddith":"صحيح","takhrij":"أخرجه مسلم (223)، والترمذي (3517)، والنسائي (2437)، وأحمد (22909) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"nu8DvRlD"},{"id":"س-01442","fp":"ac7ec2878a6d","stateId":112,"easy":"إذا توضأت ← فالوضوء نصف الإيمان","cause":"والوُضوءُ","result":"نِصفُ الإيمانِ","explicit":true,"ref":"تخريج المسند لشعيب 23099","srcLabel":"الترمذي","text":["عن جُرَيٍّ قال: التَقَى رَجُلانِ من بَني سُلَيمٍ من أصْحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقال أحَدُهما لصاحِبِه: سَمِعتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ يقولُ: سُبْحانَ اللهِ نِصفُ الميزانِ، والحَمدُ للهِ يَملُؤه، واللهُ أكبَرُ يَملَأُ ما بيْنَ السَّماءِ والأرضِ، والصَّومُ نِصفُ الصَّبرِ، ",["والوُضوءُ",1]," ",["نِصفُ الإيمانِ",2],"."],"grade":"صحيح","narrator":"رجل من الصحابة","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (3519)، وأحمد (23099) واللفظ له","bab":"وضوء › فضل الوضوء","dorar":"RV1HMD6N","merged":5,"otherRefs":["الجامع الصغير 4619 (صحيح)","تخريج المسند لشعيب 23139 (صحيح)","تخريج المسند لشعيب 23160 (صحيح)","علل ابن أبي حاتم 142 (حسن)"]},{"id":"س-00839","fp":"024630f1f27a","stateId":112,"easy":"إذا أسبغت الوضوء ← فهو شطر الإيمان","cause":"إسباغُ الوضوءِ","result":"شطرُ الإيمانِ","explicit":true,"ref":"صحيح الترغيب 189","srcLabel":"الترمذي","text":[["إسباغُ الوضوءِ ",1],["شطرُ الإيمانِ",2]," و الحمدُ للهِ تملأ الميزانَ ، و سبحان اللهِ و الحمدُ للهِ تملآنِ أو تملأ ما بين السماءِ و الأرضِ ، و الصلاةُ نورٌ ، و الصدقةُ برهانٌ ، و الصبرُ ضياءٌ ، و القرآنُ حُجَّةٌ لك أو عليك ، كلُّ الناسِ يَغدو ، فبائعٌ نفسَه ، فمُعتِقُها أو موبِقُها"],"grade":"صحيح","narrator":"أبو مالك الأشعري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3517)، والنسائي (2437)، وابن ماجه (280) باختلاف يسير.","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"XLyeA0GQ","merged":2,"otherRefs":["صحيح الجامع 7152 (صحيح)"]},{"id":"س-02047","fp":"9ef852a9a87d","stateId":112,"easy":"إذا حافظت على الوضوء ← فهو علامة إيمانك","cause":"يحافِظَ علَى الوُضوءِ","result":"إلَّا مُؤمِنٌ","explicit":true,"ref":"صحيح الترغيب 379","srcLabel":"ابن ماجه","text":["استَقيموا و لَن تُحْصُوا ، و اعلَموا أنَّ خيرَ أعمالِكُم الصَّلاةَ ، و لَن ",["يحافِظَ علَى الوُضوءِ",1]," ",["إلَّا مُؤمِنٌ",2]],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (277)، وأحمد (22378)، والدارمي (681)، وابن المبارك في ((الزهد والرقائق)) (1040) واللفظ لهم.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"WryGcU0k","merged":2,"otherRefs":["كفاية المستقنع لأدلة المقنع 248 (صحيح)"]},{"id":"ق-0020","fp":"46506a2aa983","stateId":113,"easy":"أخذ الكتاب بقوة وذكر ما فيه ← التقوى","cause":"أخذ الكتاب بقوة وذكر ما فيه","result":"التقوى","explicit":true,"star":true,"similar":["ق-0442"],"ref":"سورة البقرة: 63","srcLabel":"القرآن الكريم","quran":{"s":2,"from":63,"to":63,"text":"وَإِذْ أَخَذْنَا مِيثَاقَكُمْ وَرَفَعْنَا فَوْقَكُمُ الطُّورَ خُذُوا مَا آتَيْنَاكُمْ بِقُوَّةٍ وَاذْكُرُوا مَا فِيهِ لَعَلَّكُمْ تَتَّقُونَ (63)","hl":[[62,140,1]]}},{"id":"ق-0040","fp":"d6a90e18ef1c","stateId":113,"easy":"تلاوة الكتاب حق تلاوته ← الإيمان به","cause":"تلاوة الكتاب حق تلاوته","result":"الإيمان به","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"star":true,"ref":"سورة البقرة: 121","srcLabel":"القرآن الكريم","quran":{"s":2,"from":121,"to":121,"text":"الَّذِينَ آتَيْنَاهُمُ الْكِتَابَ يَتْلُونَهُ حَقَّ تِلَاوَتِهِ أُولَئِكَ يُؤْمِنُونَ بِهِ وَمَنْ يَكْفُرْ بِهِ فَأُولَئِكَ هُمُ الْخَاسِرُونَ (121)","hl":[[0,91,1]]}},{"id":"ق-0442","fp":"dc08a8a38b74","stateId":113,"easy":"أخذ الكتاب بقوة وذكر ما فيه ← التقوى","cause":"أخذ الكتاب بقوة وذكر ما فيه","result":"التقوى","explicit":true,"repOf":"ق-0020","ref":"سورة الأعراف: 171","quran":{"s":7,"from":171,"to":171,"text":"وَإِذْ نَتَقْنَا الْجَبَلَ فَوْقَهُمْ كَأَنَّهُ ظُلَّةٌ وَظَنُّوا أَنَّهُ وَاقِعٌ بِهِمْ خُذُوا مَا آتَيْنَاكُمْ بِقُوَّةٍ وَاذْكُرُوا مَا فِيهِ لَعَلَّكُمْ تَتَّقُونَ (171)","hl":[[89,167,1]]}},{"id":"ق-0449","fp":"901ea77f0176","stateId":113,"easy":"تلاوة آيات الله وسماعها ← زيادة الإيمان","cause":"تلاوة آيات الله وسماعها","result":"زيادة الإيمان","explicit":true,"ref":"سورة الأنفال: 2","srcLabel":"القرآن الكريم","quran":{"s":8,"from":2,"to":2,"text":"إِنَّمَا الْمُؤْمِنُونَ الَّذِينَ إِذَا ذُكِرَ اللَّهُ وَجِلَتْ قُلُوبُهُمْ وَإِذَا تُلِيَتْ عَلَيْهِمْ آيَاتُهُ زَادَتْهُمْ إِيمَانًا وَعَلَى رَبِّهِمْ يَتَوَكَّلُونَ (2)","hl":[[76,134,1]]}},{"id":"ق-0539","fp":"8d9fe52f1f1c","stateId":113,"easy":"الإيمان عند نزول القرآن ← زيادة الإيمان والاستبشار","cause":"الإيمان عند نزول القرآن","result":"زيادة الإيمان والاستبشار","explicit":true,"otherNeedIds":[6],"ref":"سورة التوبة: 124","srcLabel":"القرآن الكريم","quran":{"s":9,"from":124,"to":124,"text":"وَإِذَا مَا أُنْزِلَتْ سُورَةٌ فَمِنْهُمْ مَنْ يَقُولُ أَيُّكُمْ زَادَتْهُ هَذِهِ إِيمَانًا فَأَمَّا الَّذِينَ آمَنُوا فَزَادَتْهُمْ إِيمَانًا وَهُمْ يَسْتَبْشِرُونَ (124)","hl":[[92,165,1]]}},{"id":"ق-0776","fp":"622d4d32f7d2","stateId":113,"easy":"القرآن ووعيده ← التقوى والذكر","cause":"القرآن ووعيده","result":"التقوى والذكر","explicit":true,"ref":"سورة طه: 113","srcLabel":"القرآن الكريم","quran":{"s":20,"from":113,"to":113,"text":"وَكَذَلِكَ أَنْزَلْنَاهُ قُرْآنًا عَرَبِيًّا وَصَرَّفْنَا فِيهِ مِنَ الْوَعِيدِ لَعَلَّهُمْ يَتَّقُونَ أَوْ يُحْدِثُ لَهُمْ ذِكْرًا (113)","hl":[[0,107,1]]}},{"id":"ق-1085","fp":"db205ee38b61","stateId":113,"easy":"القرآن وأمثاله ← التذكر والتقوى","cause":"القرآن وأمثاله","result":"التذكر والتقوى","explicit":true,"ref":"سورة الزمر: 28","srcLabel":"القرآن الكريم","quran":{"s":39,"from":28,"to":28,"text":"قُرْآنًا عَرَبِيًّا غَيْرَ ذِي عِوَجٍ لَعَلَّهُمْ يَتَّقُونَ (28)","hl":[[0,60,1]]}},{"id":"س-07653","fp":"2f3175b2d80c","stateId":113,"easy":"إذا قرأت في ركعتي الفجر «قل يا أيها الكافرون» ← فأنت عبد عرف ربه","cause":"فقرَأ في الرَّكعةِ الأولى قُلْ يَا أَيُّهَا الْكَافِرُونَ","result":"هذا عبدٌ عرَف ربَّه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«قل يا أيها الكافرون»"},"similar":["س-07654"],"ref":"صحيح ابن حبان 2460","srcLabel":"البيهقي","text":["أنَّ رجلًا قام فركَع ركعتَيِ الفجرِ ",["فقرَأ في الرَّكعةِ الأولى {قُلْ يَا أَيُّهَا الْكَافِرُونَ",1],"} [الكافرون: 1] حتَّى انقضَتِ السُّورةُ فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ( ",["هذا عبدٌ عرَف ربَّه",2]," ) وقرَأ في الآخِرةِ {قُلْ هُوَ اللَّهُ أَحَدٌ} [الإخلاص: 1] حتَّى انقضَتِ السُّورةُ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( هذا عبدٌ آمَن بربِّه ) فقال طلحةُ: فأنا أستحبُّ أنْ أقرَأَ بهاتَيْنِ السُّورتَيْنِ في هاتَيْنِ الرَّكعتَيْنِ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الطحاوي في ((معاني الآثار)) (1774)، وابن بشران في ((أماليه-الجزء الأول)) (389)، والبيهقي في ((شعب الإيمان)) (2294) باختلاف يسير.","bab":"فضائل سور وآيات › سورة الإخلاص","dorar":"7dLNw39x","merged":2,"otherRefs":["نتائج الأفكار 1/489 (حسن)"]},{"id":"س-07654","fp":"99d1222d8e2e","stateId":113,"easy":"إذا قرأت في ركعتي الفجر «قل هو الله أحد» ← فأنت عبد آمن بربه","cause":"وقرَأ في الآخِرةِ قُلْ هُوَ اللَّهُ أَحَدٌ","result":"هذا عبدٌ آمَن بربِّه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«قل هو الله أحد»"},"repOf":"س-07653","ref":"صحيح ابن حبان 2460","text":["أنَّ رجلًا قام فركَع ركعتَيِ الفجرِ فقرَأ في الرَّكعةِ الأولى {قُلْ يَا أَيُّهَا الْكَافِرُونَ} [الكافرون: 1] حتَّى انقضَتِ السُّورةُ فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ( هذا عبدٌ عرَف ربَّه ) ",["وقرَأ في الآخِرةِ {قُلْ هُوَ اللَّهُ أَحَدٌ",1],"} [الإخلاص: 1] حتَّى انقضَتِ السُّورةُ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( ",["هذا عبدٌ آمَن بربِّه",2]," ) فقال طلحةُ: فأنا أستحبُّ أنْ أقرَأَ بهاتَيْنِ السُّورتَيْنِ في هاتَيْنِ الرَّكعتَيْنِ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الطحاوي في ((معاني الآثار)) (1774)، وابن بشران في ((أماليه-الجزء الأول)) (389)، والبيهقي في ((شعب الإيمان)) (2294) باختلاف يسير.","bab":"فضائل سور وآيات › سورة الإخلاص","dorar":"7dLNw39x","merged":2,"otherRefs":["نتائج الأفكار 1/489 (حسن)"]},{"id":"س-00572","fp":"2a6c6fa34ff6","stateId":113,"easy":"إذا أوتيت الإيمان دون القرآن ← فمثلك كالتمرة طيبة الطعم بلا ريح","cause":"مَن أُعطي الإيمانَ ولم يُعطَ القرآنَ","result":"كمَثَلِ التَّمرةِ طيِّبةِ الطَّعمِ ولا ريحَ لها","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"تخريج صحيح ابن حبان 121","srcLabel":"متفق عليه","text":["مَثَلُ مَن أُعطي القرآنَ والإيمانَ كمثَلِ أُترُجَّةٍ طيِّبِ الطَّعمِ طيِّبِ الرِّيحِ ومَثَلُ مَن لم يُعطَ القرآنَ ولم يُعطَ الإيمانَ كمَثَلِ الحنظلةِ مُرَّةِ الطَّعمِ لا ريحَ لها ومَثلُ ",["مَن أُعطي الإيمانَ ولم يُعطَ القرآنَ",1]," ",["كمَثَلِ التَّمرةِ طيِّبةِ الطَّعمِ ولا ريحَ لها",2]," ومَثَلُ مَن أُعطي القرآنَ ولم يُعطَ الإيمانَ كمَثَلِ الرَّيحانةِ مُرَّةِ الطَّعمِ طيِّبةِ الرِّيحِ"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (5020)، ومسلم (797)، والترمذي (2865)، والنسائي (5038)، وابن حبان (403) واللفظ لهم.","bab":"آداب عامة › ضرب الأمثال","dorar":"EfJmTtpI"},{"id":"س-06510","fp":"b8efca78edf6","stateId":114,"easy":"إذا تصدقت ← فالصدقة برهان إيمانك","cause":"والصدقة","result":"برهان","explicit":true,"star":true,"ref":"الأحكام الشرعية الكبرى 3/156","srcLabel":"النسائي","text":["أقبلنا مع رسول الله صلى الله عليه وسلم من غزوة تبوك قال فلما رأيته خالياً قلت يا رسول الله أخبرني بعمل يدخلني الجنة قال بخ لقد سألت عن عظيم وهو يسير على من يسر الله عليه تقيم الصلاة المكتوبة وتؤدي الزكاة المفروضة وتلقى الله لا تشرك به شيئاً أولا أدلك على رأس الأمر وعموده وذروة سنامه فأما رأس الأمر من أسلم يسلم وأما عموده فالصلاة وأما ذروة سنامه فالجهاد في سبيل الله أولا أدلك على أبواب الخير الصوم جنة ",["والصدقة",1]," ",["برهان",2]," وقيام العبد في جوف الليل يكفر كل خطيئة وتلا هذه الآية {تتجافى جنوبهم عن المضاجع يدعون ربهم خوفاً وطمعاً ومما رزقناهم ينفقون} أولا أدلك على أملك ذلك كله لله قال وأشار رسول الله صلى الله عليه وسلم بيده إلى لسانه قال قلت يا رسول الله وإنا لنؤاخذ بما نتكلم به قال ثكلتك أمك يا معاذ وهل يكب الناس على مناخرهم إلا حصائد ألسنتهم"],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي شيبة (30950)، وابن نصر في ((قيام الليل)) (صـ35) واللفظ لهما، والنسائي في ((الإغراب)) (92) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"hLyXOkA4","merged":6,"otherRefs":["صحيح الترغيب 189 (صحيح)","تخريج المسند لشعيب 22909 (صحيح)","مجمع الزوائد 10/239 (حسن)","صحيح الموارد 2166 (صحيح)","عارضة الأحوذي 2/145 (صحيح)"]},{"id":"س-06176","fp":"d1af866ad0c1","stateId":114,"easy":"إذا عبدت الله وحده وأديت زكاة مالك ← تذوق طعم الإيمان","cause":"مَنْ عَبَدَ اللهَ وحْدَهُ ، و علمَ أنْ لا إلهَ إلَّا اللهُ ، و أَعْطَى زَكَاةَ مالِهِ طَيِّبَةً بِها نفسُهُ ، رَافِدَةً عليهِ كلَّ عَامٍ ، و لمْ يعطَ الهَرِمَةَ ، و لاالدَّرِنَةَ ، و لا المَرِيضَةَ ، و لا الشَّرَطَ اللَّئِيمَةَ ، و لكنْ من وسَطِ أَمْوَالِكُمْ ، فإنَّ اللهَ لمْ يَسْأَلْكُمْ خَيْرَهُ","result":"ثَلاثٌ مَنْ فَعَلهُنَّ فقد طَعِمَ طَعْمَ الإيمانِ","explicit":true,"otherNeedIds":[5],"ref":"صحيح الترغيب 750","srcLabel":"أبو داود","text":[["ثَلاثٌ مَنْ فَعَلهُنَّ فقد طَعِمَ طَعْمَ الإيمانِ ",2],":",[" مَنْ عَبَدَ اللهَ وحْدَهُ ، و علمَ أنْ لا إلهَ إلَّا اللهُ ، و أَعْطَى زَكَاةَ مالِهِ طَيِّبَةً بِها نفسُهُ ، رَافِدَةً عليهِ كلَّ عَامٍ ، و لمْ يعطَ الهَرِمَةَ ، و لاالدَّرِنَةَ ، و لا المَرِيضَةَ ، و لا الشَّرَطَ اللَّئِيمَةَ ، و لكنْ من وسَطِ أَمْوَالِكُمْ ، فإنَّ اللهَ لمْ يَسْأَلْكُمْ خَيْرَهُ",1]," ، و لمْ يَأْمُرْكُمْ بِشرِّهِ"],"grade":"صحيح","narrator":"عبدالله بن معاوية الغاضري","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (1582)، وأبو نعيم في ((معرفة الصحابة)) (4528)، والبيهقي (7525) باختلاف يسير.","bab":"زكاة › فرض الزكاة","dorar":"79ZOKBZO","merged":2,"otherRefs":["صحيح الجامع 3041 (صحيح)"]},{"id":"س-06160","fp":"a30f36e2ee9d","stateId":114,"easy":"إذا أديت زكاة مالك ← فهو من تمام إسلامك","cause":"أن تُؤدُّوا زكاةَ أموالِكم","result":"إنَّ من تمامِ إسلامِكم","explicit":true,"ref":"السلسلة الصحيحة 3232","srcLabel":"الطبراني","text":[["إنَّ من تمامِ إسلامِكم",2]," ",["أن تُؤدُّوا زكاةَ أموالِكم",1]],"grade":"حسن","narrator":"علقمة بن ناجية الخزاعي","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني ((18/ 8)) (6) وابن أبي عاصم في ((الآحاد والمثاني)) (2334) واللفظ لهما، وابن قانع في ((معجم الصحابة)) ((2/ 285)) بنحوه","bab":"زكاة › فرض الزكاة","dorar":"esw58Omj"},{"id":"س-00118","fp":"66deb4db6259","stateId":114,"easy":"إذا أنفقت مع الإقتار وبذلت السلام للعالم وأنصفت من نفسك ← فهي من الإيمان","cause":"ثلاثٌ","result":"من الإيمانِ الإنفاقُ من الإقتارِ وبذلُ السَّلامِ للعالَمِ والأنصافُ من نفسِك","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"مجمع الزوائد 1/61","srcLabel":"البخاري","text":[["ثلاثٌ ",1],["من الإيمانِ الإنفاقُ من الإقتارِ وبذلُ السَّلامِ للعالَمِ والأنصافُ من نفسِك",2]],"grade":"صحيح","narrator":"عمار بن ياسر","muhaddith":"رجاله رجال الصحيح إلا أن شيخ البزار لم أر من ذكره وهو الحسن بن عبد الله الكوفي","takhrij":"أخرجه البخاري معلقاً قبل حديث (28)، وأخرجه موصولاً ابن أبي شيبة (31080)، والبزار (1396) باختلاف يسير.","bab":"آداب السلام › إفشاء السلام","dorar":"Jwzpn4NW"},{"id":"ق-0063","fp":"fbb8294151ba","stateId":115,"easy":"الصيام ← التقوى","cause":"الصيام","result":"التقوى","explicit":true,"star":true,"ref":"سورة البقرة: 183","srcLabel":"القرآن الكريم","quran":{"s":2,"from":183,"to":183,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا كُتِبَ عَلَيْكُمُ الصِّيَامُ كَمَا كُتِبَ عَلَى الَّذِينَ مِنْ قَبْلِكُمْ لَعَلَّكُمْ تَتَّقُونَ (183)","hl":[[0,127,1]]}},{"id":"س-05566","fp":"770db0c4b6a0","stateId":116,"easy":"إذا جاهدت بنفسك ومالك أو اعتزلت تعبد الله ← تكون من أكمل المؤمنين","cause":"الَّذي يُجاهِدُ في سبيلِ اللهِ بنفسِهِ ومالِهِ، ورَجلٌ يَعبُدُ اللهَ في شِعْبٍ مِنَ الشِّعَبِ، فقد كَفى النَّاسَ شَرَّهُ","result":"أيُّ المؤمنينَ أَكْملُ إيمانًا","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 2425","srcLabel":"متفق عليه","text":["عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ أنَّه سُئلَ: ",["أيُّ المؤمنينَ أَكْملُ إيمانًا",2],"؟ قالَ: ",["الَّذي يُجاهِدُ في سبيلِ اللهِ بنفسِهِ ومالِهِ، ورَجلٌ يَعبُدُ اللهَ في شِعْبٍ مِنَ الشِّعَبِ، فقد كَفى النَّاسَ شَرَّهُ",1],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (2485) بلفظه، والبخاري (6494)، ومسلم (1888) كلاهما بلفظ مقارب.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"Pdy04MFf"},{"id":"ق-1252","fp":"053b843cd246","stateId":116,"easy":"الإيمان بلا ارتياب والجهاد بالمال والنفس ← الصدق","cause":"الإيمان بلا ارتياب والجهاد بالمال والنفس","result":"الصدق","explicit":true,"ref":"سورة الحجرات: 15","srcLabel":"القرآن الكريم","quran":{"s":49,"from":15,"to":15,"text":"إِنَّمَا الْمُؤْمِنُونَ الَّذِينَ آمَنُوا بِاللَّهِ وَرَسُولِهِ ثُمَّ لَمْ يَرْتَابُوا وَجَاهَدُوا بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ فِي سَبِيلِ اللَّهِ أُولَئِكَ هُمُ الصَّادِقُونَ (15)","hl":[[24,178,1]]}},{"id":"ق-1318","fp":"f3f55a142cc7","stateId":116,"easy":"الهجرة وابتغاء فضل الله ورضوانه ونصرة الله ورسوله ← الصدق","cause":"الهجرة وابتغاء فضل الله ورضوانه ونصرة الله ورسوله","result":"الصدق","explicit":true,"ref":"سورة الحشر: 8","srcLabel":"القرآن الكريم","quran":{"s":59,"from":8,"to":8,"text":"لِلْفُقَرَاءِ الْمُهَاجِرِينَ الَّذِينَ أُخْرِجُوا مِنْ دِيَارِهِمْ وَأَمْوَالِهِمْ يَبْتَغُونَ فَضْلًا مِنَ اللَّهِ وَرِضْوَانًا وَيَنْصُرُونَ اللَّهَ وَرَسُولَهُ أُولَئِكَ هُمُ الصَّادِقُونَ (8)","hl":[[0,192,1]]}},{"id":"س-02781","fp":"7c18744f1f4f","stateId":117,"easy":"إذا غرت على أهلك ← فالغيرة من الإيمان","cause":"الغَيْرَةُ","result":"منَ الإيمانِ والْمِذَاءُ من النفاقِ","explicit":true,"star":true,"otherNeedIds":[20],"ref":"مجمع الزوائد 4/330","srcLabel":"البزار","text":[["الغَيْرَةُ ",1],["منَ الإيمانِ والْمِذَاءُ من النفاقِ",2]," قال قلتُ ما المذاءُ قال الذي لا يغارُ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"فيه أبو مرجوم وبقية رجاله رجال الصحيح","takhrij":"أخرجه البزار كما في ((مجمع الزوائد)) للهيثمي (4/330) واللفظ له، ومحمد بن نصر المروزي في ((تعظيم قدر الصلاة)) (490)، والديلمي في ((الفردوس)) (4326).","bab":"إيمان › النفاق","dorar":"8YkN4yyZ","merged":3,"otherRefs":["الأحكام الوسطى 3/ 173 (صحيح)","شرح كتاب الشهاب 278 (حسن)"]},{"id":"س-05999","fp":"f55939f71d4d","stateId":117,"easy":"إذا رزقك الله امرأة صالحة ← أعانك على شطر دينك","cause":"مَنْ رَزَقَه اللهُ امرأةً صالحةً","result":"فقد أَعانَه على شَطْرِ دينِه، فليَتَّقِ اللهَ في الشَّطرِ الباقي","explicit":true,"otherNeedIds":[35],"ref":"المستدرك على الصحيحين 2718","srcLabel":"الطبراني","text":[["مَنْ رَزَقَه اللهُ امرأةً صالحةً؛ ",1],["فقد أَعانَه على شَطْرِ دينِه، فليَتَّقِ اللهَ في الشَّطرِ الباقي",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (972)، والبيهقي في ((شعب الإيمان)) (5101) باختلاف يسير، وأبو يعلى (4349) بمعناه","bab":"رقائق وزهد › تقوى الله","dorar":"vYoNHCqu"},{"id":"س-05991","fp":"91012dd282c5","stateId":117,"easy":"إذا تزوجت ← استكملت نصف الدين، فاتقِ الله في النصف الباقي","cause":"إذا تَزَوَّجَ العبدُ","result":"فقدِ اسْتكمَلَ نِصْفَ الدِّينِ ، فلْيَتَّقِ اللهَ في النِّصفِ الباقِي","explicit":true,"ref":"صحيح الجامع 430","srcLabel":"البيهقي","text":[["إذا تَزَوَّجَ العبدُ ",1],["فقدِ اسْتكمَلَ نِصْفَ الدِّينِ ، فلْيَتَّقِ اللهَ في النِّصفِ الباقِي",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (5486)، والخطيب في ((موضح أوهام الجمع والتفريق)) (2/67) باختلاف يسير.","bab":"رقائق وزهد › تقوى الله","dorar":"WhoLw79M","merged":2,"otherRefs":["صحيح الجامع 6148 (حسن)"]},{"id":"س-01311","fp":"46da792fa9f6","stateId":117,"easy":"إذا أدّت المرأة حق زوجها ← تجد حلاوة الإيمان","cause":"حَتَّى تؤدِّيَ حقَّ زَوْجِهَا","result":"ولا تجِدُ امرأةٌ حَلَاوَةَ الْإِيمانِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"otherNeedIds":[35],"ref":"مجمع الزوائد 4/312","srcLabel":"أحمد","text":["أنَّهُ أَتَى الشامَ فرأَى النصارى يسجُدُونَ لِأَحْبَارِهِمْ وعُلَمَائِهِمْ وفُقَهائِهِمْ فقال لِأَيِّ شيءٍ تفعلونَ هذا قالوا هذِهِ تحيَّةُ الأنبياءِ قُلْنَا فنحْنُ أحقُّ أنْ نصنَعَ بِنَبِيِّنَا صلَّى اللهُ عليه وسلَّم فلمَّا قدِمَ علَى النبيِّ صلَّى اللهُ عليه وسلَّم سجَدَ فقَالَ ما هذا يا معاذُ قال إني أتيتُ الشامَ فرأيْتُ النصارى يسجدونَ لِأَساقِفَتِهِمْ وقِسِّيسِيهِمْ ورهبانِهم وبطارِقَتِهم ورأيتُ اليهودَ يسجدونَ لأحبارِهِم وفقهائِهِم وعلمائِهِم فقلْتُ أيُّ شيءٍ تصنعونَ هذا وتفعلونَ هذا قالوا هذِهِ تَحِيَّةُ الأنبياءِ قلتُ فنحنُ أحقُّ أن نصنعَ بِنَبِيِّنَا فقالَ نبيُّ اللهِ صلَّى اللهُ عليه وسلَّم إِنَّهُمْ كذَبُوا عَلَى أنبيائِهِم كَمَا حَرَّفُوا كِتَابَهُمْ وَلَوْ أَمَرْتُ أَحَدًا أَنْ يسجدَ لِأَحدٍ لَأَمَرْتُ المرأةَ أنْ تَسْجُدَ لِزَوْجِهَا مِنْ عِظَمِ حقِّهِ ",["ولا تجِدُ امرأةٌ حَلَاوَةَ الْإِيمانِ",2]," ",["حَتَّى تؤدِّيَ حقَّ زَوْجِهَا",1]," وَلَوْ سألَها نَفْسَها وهِيَ على ظهرِ قَتَبٍ"],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الحاكم (7325) بلفظه، وأحمد (21986) مختصرا، والشاشي (1332) بنحوه.","bab":"نكاح › حق الزوج على المرأة","dorar":"eOx53mi6"},{"id":"س-05356","fp":"809f7ef93e22","stateId":118,"easy":"إذا صبرت ← فالصبر نصف الإيمان","cause":"الصَّبرُ","result":"نِصفُ الإيمانِ","explicit":true,"star":true,"otherNeedIds":[14],"ref":"المستدرك على الصحيحين 3711","srcLabel":"أحمد","text":["عنْ أبي ظَبيانَ قالَ: كنَّا نَعرِضُ المصاحفَ عندَ عَلقمةَ، فقَرَأَ هذه الآيةَ: (إنَّ في ذَلِكَ لَآيَاتٍ لِلْمُوقِنِينَ) فقالَ: قالَ عبدُ اللهِ: اليقينُ الإيمانُ كُلُّهُ، وقَرَأَ هذه الآيةَ: {إِنَّ فِي ذَلِكَ لَآيَاتٍ لِكُلِّ صَبَّارٍ شَكُورٍ} [إبراهيم: 5] قالَ: فقالَ عبدُ اللهِ: ",["الصَّبرُ ",1],["نِصفُ الإيمانِ",2],"."],"grade":"صحيح","narrator":"علقمة بن قيس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه وكيع في ((الزهد)) (203)، وعبد الله بن أحمد في ((السنة)) (817)، والبيهقي في ((شعب الإبمان)) (9266) جميعهم بزيادة في لفظه.","bab":"رقائق وزهد › التوكل واليقين","dorar":"PSQ0JCgZ","merged":3,"otherRefs":["المتجر الرابح 293 (صحيح)","إرشاد الساري 1/88 (صحيح)"]},{"id":"س-03862","fp":"3d241fccebf0","stateId":119,"easy":"إذا أحببت لأخيك ما تحب لنفسك ← يكمل إيمانك","cause":"حتى يُحبَّ لأخيه المسلمِ ما يحبُّ لنفسِه","result":"لا يؤمنُ عبدٌ","explicit":true,"star":true,"ref":"مجمع الزوائد 1/100","srcLabel":"متفق عليه","text":["كنت جالسًا ورجلٌ عندَ النبيِّ صلَّى اللهُ عليه وسلَّم فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : لا يؤمنُ عبدٌ ",["حتى يُحبَّ لأخيه المسلمِ ما يحبُّ لنفسِه",1]," قال أنسٌ : فخرجت أنا والرجلُ إلى السوقِ فإذا سلعةٌ تُباعُ فساومته فقال : بثلاثينَ فنظر الرجلُ فقال : قد أخذتُها بأربعينَ فقال صاحبُها : ما يحملُك على هذا وأنا أعطيكُها بأقلَّ من هذا ثم نظر أيضًا فقال : قد أخذتُها بخمسينَ فقال صاحبُها : ما يحملك على هذا وأنا أعطيكُها بأقلَّ من هذا قال : إني سمعت رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ : ",["لا يؤمنُ عبدٌ",2]," حتى يحبَّ لأخيه ما يحبُّ لنفسِه وأنا أرَى أنه صالحٌ بخمسينَ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه البزار (7548). وقوله: \"لا يؤمنُ عبدٌ حتى يُحبَّ لأخيه المسلمِ ما يحبُّ لنفسِه\" أخرجه البخاري (13)، ومسلم (45) باختلاف يسير","bab":"تجارة › أخلاقيات التجارة","dorar":"WMzh9WsP","merged":3,"otherRefs":["تخريج المسند لشعيب 13874 (صحيح)","تخريج المسند لشعيب 13875 (صحيح)"]},{"id":"س-00336","fp":"aa3b418aef1a","stateId":119,"easy":"إذا أحببت للناس ما تحب لنفسك من الخير ← تبلغ حقيقة الإيمان","cause":"حتَّى يُحِبَّ للنَّاسِ ما يُحِبُّ لنَفْسِه مِن الخَيْرِ","result":"لا يَبلُغُ العَبْدُ حَقيقةَ الإيمانِ","explicit":true,"star":true,"ref":"الأحاديث المختارة 2525","srcLabel":"متفق عليه","text":["«",["لا يَبلُغُ العَبْدُ حَقيقةَ الإيمانِ",2]," ",["حتَّى يُحِبَّ للنَّاسِ ما يُحِبُّ لنَفْسِه مِن الخَيْرِ",1],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"KHN9Tnz7"},{"id":"س-03813","fp":"3eb84253bb77","stateId":119,"easy":"إذا أحببت للمسلمين ما تحب لنفسك وكرهت لهم ما تكره ← تكن مؤمناً","cause":"وأَحِبَّ للمسلمينَ والمؤمنينَ ما تُحِبُّ لنفسِكَ وأهلِ بيتِكَ ، واكْرَهْ لهم ما تَكْرَهُ لنفسِكَ وأهلِ بيتِكَ","result":"تَكُنْ مؤمنًا","explicit":true,"ref":"صحيح الجامع 7833","srcLabel":"الترمذي","text":["يا أبا هريرةَ ! كُنْ وَرِعًا تَكُنْ من أَعْبَدِ الناسِ ، وارْضَ بما قسم اللهُ لكَ تَكُن من أَغْنَى الناسِ ، ",["وأَحِبَّ للمسلمينَ والمؤمنينَ ما تُحِبُّ لنفسِكَ وأهلِ بيتِكَ ، واكْرَهْ لهم ما تَكْرَهُ لنفسِكَ وأهلِ بيتِكَ ",1],["تَكُنْ مؤمنًا",2]," ، وجاوِرْ مَن جاوَرْتَ بإحسانٍ تَكُنْ مُسْلِمًا ، وإياكَ وكثرةَ الضَّحِكِ ؛ فإنَّ كَثْرَةَ الضَّحِكِ فسادُ القلبِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2305)، وابن ماجه (4217)، وأحمد (8095) باختلاف يسير","bab":"بر وصلة › حق الجار والوصاة به","dorar":"8idzJ5Is"},{"id":"س-03814","fp":"14e8f4cd1a87","stateId":119,"easy":"إذا أحسنت جوار من جاورت ← تكن مسلماً","cause":"وجاوِرْ مَن جاوَرْتَ بإحسانٍ","result":"تَكُنْ مُسْلِمًا","explicit":true,"ref":"صحيح الجامع 7833","srcLabel":"الترمذي","text":["يا أبا هريرةَ ! كُنْ وَرِعًا تَكُنْ من أَعْبَدِ الناسِ ، وارْضَ بما قسم اللهُ لكَ تَكُن من أَغْنَى الناسِ ، وأَحِبَّ للمسلمينَ والمؤمنينَ ما تُحِبُّ لنفسِكَ وأهلِ بيتِكَ ، واكْرَهْ لهم ما تَكْرَهُ لنفسِكَ وأهلِ بيتِكَ تَكُنْ مؤمنًا ، ",["وجاوِرْ مَن جاوَرْتَ بإحسانٍ",1]," ",["تَكُنْ مُسْلِمًا",2]," ، وإياكَ وكثرةَ الضَّحِكِ ؛ فإنَّ كَثْرَةَ الضَّحِكِ فسادُ القلبِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2305)، وابن ماجه (4217)، وأحمد (8095) باختلاف يسير","bab":"بر وصلة › حق الجار والوصاة به","dorar":"8idzJ5Is"},{"id":"س-02130","fp":"a45b52ff134e","stateId":119,"easy":"إذا كنت تؤمن بالله واليوم الآخر ← فأحسن إلى جارك","cause":"فلْيُحسِنْ إلى جارِه","result":"كان يؤمِنُ بالله واليومِ الآخِرِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"similar":["س-00214"],"otherNeedIds":[36],"ref":"تخريج مشكل الآثار 2779","srcLabel":"متفق عليه","text":["ثمَّ ذكَرَ مِثْلَهُ [أي: حَديثَ: من كان يؤمِنُ باللهِ عزَّ وجَلَّ واليومِ الآخِرِ فلْيُكرِمْ ضَيفَه, ومن كان يؤمِنُ باللهِ واليَومِ الآخِرِ ",["فلْيُحسِنْ إلى جارِه",1],"، ومن ",["كان يؤمِنُ بالله واليومِ الآخِرِ",2]," فلْيَقُلْ خَيرًا أو لِيَصمُتْ] وزاد في الضَّيفِ: جائزتُهُ يومٌ وليلةٌ، والضِّيافةُ ثلاثةُ أيَّامٍ، فما كان بَعدَ ذلك فهو صَدقةٌ، ولا يَحِلُّ له أنْ يُقيمَ عندَهُ حتَّى يُحرِجَهُ."],"grade":"صحيح","narrator":"أبو شريح العدوي خويلد بن عمرو","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6019، 6135) مفرقاً باختلاف يسير، ومسلم (48) مختصراً باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"WB5Q954B"},{"id":"س-00213","fp":"7fc95680b004","stateId":119,"easy":"إذا كنت تؤمن بالله واليوم الآخر ← فأكرم ضيفك","cause":"فليُكرِمْ ضَيْفَه","result":"كانَ يُؤمِنُ باللهِ واليَومِ الآخِرِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"otherNeedIds":[36],"ref":"المستدرك على الصحيحين 7992","srcLabel":"الطبراني","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قالَ: مَن كانَ يُؤمِنُ باللهِ واليَومِ الآخِرِ ",["فليُكرِمْ ضَيْفَه",1],"، ومَن ",["كانَ يُؤمِنُ باللهِ واليَومِ الآخِرِ",2]," فليُكرِمْ جارَه، ومَن كانَ يُؤمِنُ باللهِ واليَومِ الآخِرِ فلا يَدخُلِ الحَمَّامَ إلَّا بمِئْزَرٍ، ومَن كانَ يُؤمِنُ باللهِ واليَومِ الآخِرِ مِن نِسائِكُم فلا تَدخُلِ الحَمَّاماتِ.\n فرُفِعَ الحَديثُ إلى عُمَرَ بنِ عَبدِ العَزيزِ، فكَتَب إلى أبي بَكرِ بنِ مُحمَّدِ بنِ عَمرِو بنِ حَزمٍ: أنْ سَلْ مُحمَّدَ بنَ ثابِتٍ عنْ هذا الحَديثِ، ويَكتُبُ بما قالَ، ففَعَل، فكَتَب عُمَرُ بنُ عَبدِ العَزيزِ: أنْ تُمنَعَ النِّساءُ الحَمَّاماتِ."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني في ((الكبير)) (4/ 124) (3873)، والبيهقي في ((الشعب)) (7379)، والباغندي في ((مسند عمر بن عبد العزيز)) (94) باختلاف يسير.","bab":"آداب المجلس › إكرام الضيف","dorar":"pThO4grj","merged":6,"otherRefs":["صحيح ابن ماجه 2979 (صحيح)","صحيح الترغيب 819 (صحيح)","صحيح الأدب المفرد 569 (صحيح)","تخريج مشكل الآثار 2779 (صحيح)","تخريج المسند لشعيب 11726 (صحيح)"]},{"id":"س-00214","fp":"855662721cdb","stateId":119,"easy":"إذا كنت تؤمن بالله واليوم الآخر ← فأكرم جارك","cause":"فليُكرِمْ جارَه","result":"كانَ يُؤمِنُ باللهِ واليَومِ الآخِرِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-02130","otherNeedIds":[36],"ref":"المستدرك على الصحيحين 7992","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قالَ: مَن كانَ يُؤمِنُ باللهِ واليَومِ الآخِرِ فليُكرِمْ ضَيْفَه، ومَن كانَ يُؤمِنُ باللهِ واليَومِ الآخِرِ ",["فليُكرِمْ جارَه",1],"، ومَن ",["كانَ يُؤمِنُ باللهِ واليَومِ الآخِرِ",2]," فلا يَدخُلِ الحَمَّامَ إلَّا بمِئْزَرٍ، ومَن كانَ يُؤمِنُ باللهِ واليَومِ الآخِرِ مِن نِسائِكُم فلا تَدخُلِ الحَمَّاماتِ.\n فرُفِعَ الحَديثُ إلى عُمَرَ بنِ عَبدِ العَزيزِ، فكَتَب إلى أبي بَكرِ بنِ مُحمَّدِ بنِ عَمرِو بنِ حَزمٍ: أنْ سَلْ مُحمَّدَ بنَ ثابِتٍ عنْ هذا الحَديثِ، ويَكتُبُ بما قالَ، ففَعَل، فكَتَب عُمَرُ بنُ عَبدِ العَزيزِ: أنْ تُمنَعَ النِّساءُ الحَمَّاماتِ."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني في ((الكبير)) (4/ 124) (3873)، والبيهقي في ((الشعب)) (7379)، والباغندي في ((مسند عمر بن عبد العزيز)) (94) باختلاف يسير.","bab":"آداب المجلس › إكرام الضيف","dorar":"pThO4grj","merged":3,"otherRefs":["صحيح الأدب المفرد 569 (صحيح)","علل ابن أبي حاتم 2309 (صحيح)"]},{"id":"س-00217","fp":"8f05fd554fc8","stateId":119,"easy":"إذا كنت تؤمن بالله واليوم الآخر ← فاتقِ الله وأكرم جارك","cause":"فليَتَّقِ اللهَ، وليُكرِمْ جارَه، ومَن كان يُؤمِنُ باللهِ واليَومِ الآخِرِ فليَتَّقِ اللهَ، وليُكرِمْ ضَيفَه، ومَن كان يُؤمِنُ باللهِ واليَومِ الآخِرِ فليَتَّقِ اللهَ، وليَقُلْ حَقًّا أو ليَسكُتْ","result":"مَن كان يُؤمِنُ باللهِ واليَومِ الآخِرِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"otherNeedIds":[36],"ref":"تخريج المسند لشعيب 20285","srcLabel":"أحمد","text":["«",["مَن كان يُؤمِنُ باللهِ واليَومِ الآخِرِ",2]," ",["فليَتَّقِ اللهَ، وليُكرِمْ جارَه، ومَن كان يُؤمِنُ باللهِ واليَومِ الآخِرِ فليَتَّقِ اللهَ، وليُكرِمْ ضَيفَه، ومَن كان يُؤمِنُ باللهِ واليَومِ الآخِرِ فليَتَّقِ اللهَ، وليَقُلْ حَقًّا أو ليَسكُتْ",1],"»"],"grade":"صحيح","narrator":"رجال من أصحاب النبي","muhaddith":"إسناده صحيح","bab":"آداب المجلس › إكرام الضيف","dorar":"pkUu5SO1"},{"id":"س-00228","fp":"5d8704d8de32","stateId":119,"easy":"إذا رحمت الناس عامة ← يكمل إيمانك","cause":"رحمةُ النَّاسِ رحمةُ العامَّةِ","result":"لَن تؤمِنوا حتَّى","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"فتح الباري لابن حجر 10/453","srcLabel":"فتح الباري لابن حجر","text":[["لَن تؤمِنوا حتَّى",2]," تَرحموا قالوا كلُّنا رَحيمٌ يا رسولَ اللَّهِ قالَ إنَّهُ ليسَ برحمةِ أحدِكُم صاحبَهُ ولكنا ",["رحمةُ النَّاسِ رحمةُ العامَّةِ",1]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"رجاله ثقات","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"ojBsqjWW"},{"id":"س-05427","fp":"9382c2e46140","stateId":120,"easy":"إذا استحييت ← فالحياء من الإيمان","cause":"الحياءُ","result":"من الإيمانِ","explicit":true,"star":true,"similar":["س-05433"],"ref":"مختصر المقاصد 395","srcLabel":"مختصر المقاصد","text":[["الحياءُ ",1],["من الإيمانِ ",2],"[حديث ابن عمر: مَرَّ النبيُّ صَلَّى اللهُ عليه وسلَّمَ علَى رَجُلٍ، وهو يُعَاتِبُ أخَاهُ في الحَيَاءِ، يقولُ: إنَّكَ لَتَسْتَحْيِي، حتَّى كَأنَّهُ يقولُ: قدْ أضَرَّ بكَ، فَقالَ رَسولُ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ: دَعْهُ، فإنَّ الحَيَاءَ مِنَ الإيمَانِ.]             [وحديث أبي هريرة: الحياءُ من الإيمانِ، والإيمانُ في الجنةِ، والبَذاءُ من الجفاءِ، والجفاءُ في النارِ]"],"grade":"صحيح","narrator":"[ابن عمر وأبو هريرة]","muhaddith":"صحيح","bab":"رقائق وزهد › الحياء","dorar":"ukdi4vqC","merged":10,"otherRefs":["صحيح الأدب المفرد 466 (صحيح)","صحيح ابن ماجه 48 (صحيح)","السلسلة الصحيحة 4/370 (صحيح)","صحيح مسلم 35 (صحيح)","تخريج صحيح ابن حبان 181 (صحيح)","السلسلة الصحيحة 495 (صحيح)","التمهيد 9/232 (صحيح)","تخريج المسند لشاكر 9/123 (صحيح)","السلسلة الصحيحة 1828 (صحيح)"]},{"id":"ق-0088","fp":"80f8f59d8b7e","stateId":120,"easy":"العفو عن الحق ← القرب من التقوى","cause":"العفو عن الحق","result":"القرب من التقوى","explicit":true,"star":true,"ref":"سورة البقرة: 237","srcLabel":"القرآن الكريم","quran":{"s":2,"from":237,"to":237,"text":"وَإِنْ طَلَّقْتُمُوهُنَّ مِنْ قَبْلِ أَنْ تَمَسُّوهُنَّ وَقَدْ فَرَضْتُمْ لَهُنَّ فَرِيضَةً فَنِصْفُ مَا فَرَضْتُمْ إِلَّا أَنْ يَعْفُونَ أَوْ يَعْفُوَ الَّذِي بِيَدِهِ عُقْدَةُ النِّكَاحِ وَأَنْ تَعْفُوا أَقْرَبُ لِلتَّقْوَى وَلَا تَنْسَوُا الْفَضْلَ بَيْنَكُمْ إِنَّ اللَّهَ بِمَا تَعْمَلُونَ بَصِيرٌ (237)","hl":[[189,225,1]]}},{"id":"ق-0285","fp":"b0e728b221a6","stateId":120,"easy":"العدل ولو مع من نبغض ← القرب من التقوى","cause":"العدل ولو مع من نبغض","result":"القرب من التقوى","explicit":true,"star":true,"ref":"سورة المائدة: 8","srcLabel":"القرآن الكريم","quran":{"s":5,"from":8,"to":8,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا كُونُوا قَوَّامِينَ لِلَّهِ شُهَدَاءَ بِالْقِسْطِ وَلَا يَجْرِمَنَّكُمْ شَنَآنُ قَوْمٍ عَلَى أَلَّا تَعْدِلُوا اعْدِلُوا هُوَ أَقْرَبُ لِلتَّقْوَى وَاتَّقُوا اللَّهَ إِنَّ اللَّهَ خَبِيرٌ بِمَا تَعْمَلُونَ (8)","hl":[[142,177,1]]}},{"id":"ق-1244","fp":"01afeeab0ddc","stateId":120,"easy":"غضّ الصوت عند رسول الله ﷺ ← امتحان القلب للتقوى ومغفرة وأجر عظيم","cause":"غضّ الصوت عند رسول الله ﷺ","result":"امتحان القلب للتقوى ومغفرة وأجر عظيم","explicit":true,"star":true,"otherNeedIds":[11,40],"ref":"سورة الحجرات: 3","srcLabel":"القرآن الكريم","quran":{"s":49,"from":3,"to":3,"text":"إِنَّ الَّذِينَ يَغُضُّونَ أَصْوَاتَهُمْ عِنْدَ رَسُولِ اللَّهِ أُولَئِكَ الَّذِينَ امْتَحَنَ اللَّهُ قُلُوبَهُمْ لِلتَّقْوَى لَهُمْ مَغْفِرَةٌ وَأَجْرٌ عَظِيمٌ (3)","hl":[[0,160,1]]}},{"id":"س-05561","fp":"90f1427e3fbe","stateId":120,"easy":"إذا تواضعت في هيئتك (البذاذة) ← فهي من الإيمان","cause":"البذاذةَ","result":"من الإيمانِ","explicit":true,"star":true,"ref":"تخريج رياض الصالحين 517","srcLabel":"أبو داود","text":["ذَكَرَ أصحابُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم يومًا عندَه الدُّنيا، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: \"أَلَا تَسمَعون؟ أَلَا تَسمَعون؟ إنَّ ",["البذاذةَ",1]," ",["من الإيمانِ",2],"، إنَّ البذاذةَ من الإيمانِ."],"grade":"صحيح","narrator":"أبو أمامة إياس بن ثعلبة الحارثي","muhaddith":"صحيح","takhrij":"أخرجه من طرق أبو داود (4161) واللفظ له، وابن ماجه (4118)، وأحمد (00/58)","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"xPMaNfcJ","merged":4,"otherRefs":["تخريج مشكل الآثار 1531 (حسن)","تخريج مشكل الآثار 3036 (حسن)","صحيح ابن ماجه 3340 (صحيح)"]},{"id":"س-00304","fp":"ddb606b9becb","stateId":120,"easy":"إذا حسنت أخلاقك مع الفقه في الدين ← تكون من خير الناس إسلاماً","cause":"إسلامًا أحسَنُكم أخلاقًا إذا فَقُهُوا","result":"خيرُكم","explicit":true,"ref":"التنوير شرح الجامع الصغير 6/39","srcLabel":"البخاري","text":[["خيرُكم",2],[" إسلامًا أحسَنُكم أخلاقًا إذا فَقُهُوا",1],"."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (10022)،والبخاري في ((الأدب المفرد)) (833)، وابن حبان (833) واللفظ لهم.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"dfvP3Gac"},{"id":"س-05436","fp":"cab63582653f","stateId":120,"easy":"إذا كنت قليل الكلام حيياً ← فهما شعبتان من الإيمان","cause":"العِيُّ والحَياءُ شُعْبَتانِ","result":"مِنَ الإيمانِ","explicit":true,"ref":"المستدرك على الصحيحين 171","srcLabel":"الترمذي","text":[["«العِيُّ والحَياءُ شُعْبَتانِ ",1],["مِنَ الإيمانِ",2],"، والبَذاءُ والجَفاءُ شُعْبَتانِ مِنَ النِّفاقِ»."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح على شرط الشيخين وله شاهد صحيح على شرطهما","takhrij":"أخرجه الترمذي (2027)، وأحمد (22312)، والطحاوي في ((شرح مشكل الآثار)) (2983) واللفظ لهم.","bab":"رقائق وزهد › الحياء","dorar":"2G1tBHMo","merged":3,"otherRefs":["صحيح الجامع 3201 (صحيح)","صحيح الترغيب 2629 (صحيح)"]},{"id":"س-00138","fp":"dc78724f5f29","stateId":120,"easy":"إذا أنصفت من نفسك وأنفقت مع قلة ذات اليد وبذلت السلام للناس ← استكملت الإيمان","cause":"إنصافٌ من نفسِه ، والإنفاقُ من الإقتارِ ، وبذلُ السلامِ للعالَمِ","result":"ثلاثٌ من كنَّ فيه فقد استكمل الإيمانَ","explicit":true,"ref":"لوائح الأنوار السنية 2/308","srcLabel":"لوائح الأنوار السنية","text":["عن عمارِ بنِ ياسرٍ أنه قال : ",["ثلاثٌ من كنَّ فيه فقد استكمل الإيمانَ ",2],":",[" إنصافٌ من نفسِه ، والإنفاقُ من الإقتارِ ، وبذلُ السلامِ للعالَمِ",1]],"grade":"صحيح","muhaddith":"صحيح","bab":"آداب السلام › إفشاء السلام","dorar":"srgwuP9m","merged":2,"otherRefs":["عمدة القاري 1/312 (صحيح)"]},{"id":"س-00262","fp":"f74ce7e4b1ff","stateId":120,"easy":"إذا حسن خلقك ← فهو أفضل الإيمان","cause":"خُلُقٌ حسَنٌ","result":"أَفضَلِ الإيمانِ","explicit":true,"otherNeedIds":[41],"ref":"تخريج المسند لشعيب 28/253","srcLabel":"أحمد","text":["أنَّه صلَّى اللهُ عليه وسلَّمَ قال في ",["أَفضَلِ الإيمانِ",2],": ",["خُلُقٌ حسَنٌ",1],"."],"grade":"صحيح","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (19435)، وابن أبي شيبة في ((المسند)) (757)، وعبد بن حميد (300) مطولاً من حديث عمرو بن عبسة رضي الله عنه.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"7IupxjHv","merged":2,"otherRefs":["تخريج شرح السنة 3469 (حسن)"]},{"id":"س-01324","fp":"33207811d4b4","stateId":120,"easy":"إذا حسن خلقك وكنت خيّراً لأهلك ← تكون من أكمل المؤمنين إيماناً","cause":"إيمانًا أَحْسَنُهُم خُلُقًا ، وخِيَارُهُم خِيَارُهُم لنِسَائِهِم","result":"أَكْمَلُ المؤمنينَ","explicit":true,"ref":"آداب الزفاف 199","srcLabel":"أبو داود","text":[["أَكْمَلُ المؤمنينَ",2],[" إيمانًا أَحْسَنُهُم خُلُقًا ، وخِيَارُهُم خِيَارُهُم لنِسَائِهِم ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن الإسناد وشطره الأول صحيح","takhrij":"أخرجه أبو داود (4682)، والترمذي (1162)، وأحمد (2/ 250) واللفظ له.","bab":"نكاح › عشرة النساء","dorar":"RRAV5mNy","merged":2,"otherRefs":["السلسلة الصحيحة 284 (صحيح)"]},{"id":"س-01552","fp":"a182fb2f2475","stateId":120,"easy":"إذا حفظت العهد والوفاء ← فهو من الإيمان","cause":"حسنَ العهدِ","result":"من الإيمانِ","explicit":true,"ref":"السلسلة الصحيحة 1/424","srcLabel":"الحاكم","text":["جاءت عجوزٌ إلى النبيِّ صلَّى اللهُ عليهِ وسلَّمَ وهو عندي فقال لها رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ : من أنتِ ؟ قالت : أنا جثَّامةُ المُزنيَّةُ فقال : بل أنتِ حسَّانةُ المُزنيَّةُ كيف أنتُم ؟ كيف حالكم ؟ كيف كنتُم بعدنا ؟ قالت بخيرٍ بأبي أنت وأمِّي يا رسولَ اللهِ فلما خرجتُ قلتُ : يا رسولَ اللهِ تُقبِلْ على هذه العجوزِ هذا الإقبالَ فقال : إنها كانت تأتينا زمنَ خديجةَ وإنَّ ",["حسنَ العهدِ",1]," ",["من الإيمانِ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (40)، والبيهقي (9122)، وابن الأعرابي (774) واللفظ لهم جميعا.","bab":"أسماء › من غير النبي اسمه","dorar":"uMBCXy5u","merged":2,"otherRefs":["تخريج سير أعلام النبلاء 2/165 (حسن)"]},{"id":"س-05433","fp":"8b9aef776d73","stateId":120,"easy":"إذا استحييت ← فالحياء خلق الإسلام","cause":"الحَياءُ","result":"و خُلُقُ الإسلامِ","explicit":true,"repOf":"س-05427","ref":"السلسلة الصحيحة 940","text":["إِنَّ لِكلِّ دِينٍ خُلُقًا ، ",["و خُلُقُ الإسلامِ",2]," ",["الحَياءُ",1]],"grade":"صحيح","narrator":"عبدالله بن عباس وأنس بن مالك","muhaddith":"صحيح بمجموع طرقه","bab":"رقائق وزهد › الحياء","dorar":"9ySdpIKp","merged":2,"otherRefs":["صحيح ابن ماجه 3390 (حسن)"]},{"id":"س-00404","fp":"eb3fa29d12bf","stateId":120,"easy":"إذا تركت الكذب في المزاح والجدال ولو كنت صادقاً ← يكمل إيمانك","cause":"حتَّى يتركَ الكَذبَ في المِزاحةِ ، والمِراءَ وإنْ كان صِدْقًا","result":"لا يُؤمنُ العبدُ الإيمانَ كلَّهُ","explicit":true,"ref":"صحيح الترغيب 2939","srcLabel":"أحمد","text":[["لا يُؤمنُ العبدُ الإيمانَ كلَّهُ",2]," ",["حتَّى يتركَ الكَذبَ في المِزاحةِ ، والمِراءَ وإنْ كان صِدْقًا",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (8630)، وابن أبي الدنيا في ((مكارم الأخلاق)) (138)، والطبراني في ((المعجم الأوسط)) (5103) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"hksBL4l0"},{"id":"س-00405","fp":"775fda5af124","stateId":120,"easy":"إذا تركت المزاح الكاذب والجدال ولو كنت محقاً ← تبلغ صريح الإيمان","cause":"حتَّى يدعَ المِزاحَ والكَذِبَ ، ويدَعَ المِراءَ وإن كان مُحقًّا","result":"لا يبلغُ العبدُ صريحَ الإيمانِ","explicit":true,"ref":"صحيح الترغيب 2940","srcLabel":"الطبراني","text":[["لا يبلغُ العبدُ صريحَ الإيمانِ",2]," ",["حتَّى يدعَ المِزاحَ والكَذِبَ ، ويدَعَ المِراءَ وإن كان مُحقًّا",1]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني في ((الشاميين)) (2115)، وتمام في ((فوائده)) (1606)، وأبو نعيم في ((حلية الأولياء)) (5/ 176) باختلاف يسير.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"JULEiC65"},{"id":"س-04695","fp":"716c814904c8","stateId":120,"easy":"إذا حسن خلقك وأكثرت ذكر الموت والاستعداد له ← تكون من أفضل المؤمنين وأكيسهم","cause":"أحسنهُم خُلُقا ، وأكيسُهم أكثرهُم للموتِ ذكْرا وأحسنُهم له استعْدادا ، أولئكَ الأكياسُ","result":"أفضلُ المؤمنينَ","explicit":true,"ref":"السلسلة الصحيحة 1384","srcLabel":"ابن ماجه","text":[["أفضلُ المؤمنينَ",2],[" أحسنهُم خُلُقا ، وأكيسُهم أكثرهُم للموتِ ذكْرا وأحسنُهم له استعْدادا ، أولئكَ الأكياسُ",1]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"حسن بمجموع الطرق أما الجملة الأولى فهي صحيحة","takhrij":"أخرجه ابن ماجه (4259)، والبزار (6175)، وابن حبان في ((المجروحين)) (1/489) باختلاف يسير.","bab":"رقائق وزهد › أي المؤمنين خير","dorar":"AVP5T8f6"},{"id":"س-05425","fp":"34890b9dd1ca","stateId":120,"easy":"إذا كنت حيياً عفيفاً قليل الكلام فقيهاً ← فهي من الإيمان تزيد في الآخرة","cause":"إِنَّ الحَياءَ والعَفَافُ والعِيَّ – عِيُّ اللِّسانِ ، لا عِيُّ القلبِ ، والفقهُ","result":"مِنَ الإيمانِ ، وإنَّهُنَّ يَزِدْنَ في الآخرةِ ، ويُنْقِصْنَ مِنَ الدنيا ، وما يَزِدْنَ في الآخرةِ أكثرُ مِمَّا يُنْقِصْنَ مِنَ الدنيا","explicit":true,"otherNeedIds":[40],"ref":"صحيح الترغيب 2630","srcLabel":"الطبراني","text":["بَلْ هو الدِّينُ كلُّهُ . ثُمَّ قال رسولُ اللهِ : ",["إِنَّ الحَياءَ والعَفَافُ والعِيَّ – عِيُّ اللِّسانِ ، لا عِيُّ القلبِ ، والفقهُ",1]," ",["مِنَ الإيمانِ ، وإنَّهُنَّ يَزِدْنَ في الآخرةِ ، ويُنْقِصْنَ مِنَ الدنيا ، وما يَزِدْنَ في الآخرةِ أكثرُ مِمَّا يُنْقِصْنَ مِنَ الدنيا",2]," . وإِنَّ الشُّحَّ والعَجْزَ والبَذَاءَ مِنَ النِّفَاقِ ، وإنَّهُنَّ يَزِدْنَ في الدنيا ، ويَنْقُصْنَ مِنَ الآخرةِ ، وما يَنْقُصْنَ مِنَ الآخرةِ أكثرُ مِمَّا يَزِدْنَ في الدنيا ."],"grade":"صحيح","narrator":"قرة بن إياس المزني","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني (63) (19/ 29)، وابن أبي الدنيا في ((مكارم الأخلاق)) (87)، والفسوي في ((المعرفة والتاريخ)) (1/ 311)، وأبو نعيم في ((حلية الأولياء)) (3/ 125)، والبيهقي (20845)،  جميعا بنحوه","bab":"رقائق وزهد › الحياء","dorar":"KaSiy8WL"},{"id":"س-05786","fp":"82cd5ce770b0","stateId":120,"easy":"إذا لبست المتواضع من الثياب (الصوف) ← تجد حلاوة الإيمان","cause":"عليكم بلِباسِ الصُّوفِ","result":"تَجِدوا حلاوةَ الإيمانِ في قلوبِكم","explicit":true,"ref":"الجامع الصغير 5556","srcLabel":"الحاكم","text":[["عليكم بلِباسِ الصُّوفِ",1]," ، ",["تَجِدوا حلاوةَ الإيمانِ في قلوبِكم",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (77)، والبيهقي في ((شعب الإيمان)) (6150) واللفظ لهما، وابن بشران في ((الأمالي)) (52) مطولا.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"tCaTkCB5"},{"id":"س-06033","fp":"6f80cbd82430","stateId":120,"easy":"إذا صبرت وسمحت ← فهو أفضل الإيمان","cause":"الصَّبرُ و السَّماحةُ","result":"أفضلُ الإيمانِ","explicit":true,"ref":"صحيح الجامع 1097","srcLabel":"أخرجه","text":[["أفضلُ الإيمانِ",2],[" الصَّبرُ و السَّماحةُ",1]],"grade":"صحيح","narrator":"عبيد بن عمير","muhaddith":"صحيح","takhrij":"أخرجه أخرجه ابن نصر في ((تعظيم قدر الصلاة)) (643)","bab":"رقائق وزهد › فضل الصبر","dorar":"Owb2cVpT"},{"id":"س-08288","fp":"1c5d81c2eb0d","stateId":120,"easy":"إذا تركت الفحش ← فالفحش لو كان رجلاً لكان رجل سوء","cause":"إِيَّاكِ و الفُحْشَ","result":"فإنَّ الفُحْشَ لَوْ كان رجلًا لكَانَ رَجُلَ سَوْءٍء","explicit":true,"ref":"السلسلة الصحيحة 537","srcLabel":"ابن أبي الدنيا","text":["يا عائشةُ ",["إِيَّاكِ و الفُحْشَ",1]," ، إِيَّاكِ و الفُحْشَ ، ",["فإنَّ الفُحْشَ لَوْ كان رجلًا لكَانَ رَجُلَ سَوْءٍء",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"ثابت حسن على أقل الدرجات","takhrij":"أخرجه ابن أبي الدنيا في ((مكارم الأخلاق)) (89)، والخرائطي في ((مكارم الأخلاق)) (314) آخره في أثناء حديث، والعقيلي في ((الضعفاء الكبير)) (3/85) واللفظ له","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"kfJFPcyW"},{"id":"س-02806","fp":"efdbb995b66f","stateId":120,"easy":"إذا كظمت غيظك لله ← يملأ الله جوفك إيماناً","cause":"ما كظَمها عبدٌ للَّهِ","result":"إلَّا ملأَ جوفَه إيمانًا","explicit":true,"otherNeedIds":[8],"ref":"تفسير القرآن العظيم 2/102","srcLabel":"أحمد","text":["مَن أنظَرَ مُعسِرًا أو وضعَ لهُ وقاهُ اللهُ مِن فَيْحِ جهنَّمَ ألا إنَّ عملَ الجنَّةِ حَزنٌ بِرَبوةٍ ثلاثًا ألا إنَّ عملَ النَّارِ سَهلٌ بسَهوةٍ والسَّعيدُ مَن وُقيَ الفِتنَ وما مِن جرعةٍ أحبَّ إلى اللهِ من جَرعةِ غَيظٍ يكظِمُها عبدٌ ",["ما كظَمها عبدٌ للَّهِ",1]," ",["إلَّا ملأَ جوفَه إيمانًا",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن","takhrij":"أخرجه أحمد (3015) واللفظ له، وابن أبي الدنيا في ((اصطناع المعروف)) (165)","bab":"إيمان › الوعد","dorar":"eyGjjS8f"},{"id":"س-02129","fp":"928b66669396","stateId":120,"easy":"إذا كنت تؤمن بالله واليوم الآخر ← فقل خيراً أو اصمت","cause":"فلْيَقُلْ خَيرًا أو لِيَصمُتْ","result":"كان يؤمِنُ باللهِ واليَومِ الآخِرِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"تخريج مشكل الآثار 2779","srcLabel":"متفق عليه","text":["ثمَّ ذكَرَ مِثْلَهُ [أي: حَديثَ: من كان يؤمِنُ باللهِ عزَّ وجَلَّ واليومِ الآخِرِ فلْيُكرِمْ ضَيفَه, ومن ",["كان يؤمِنُ باللهِ واليَومِ الآخِرِ",2]," فلْيُحسِنْ إلى جارِه، ومن كان يؤمِنُ بالله واليومِ الآخِرِ ",["فلْيَقُلْ خَيرًا أو لِيَصمُتْ",1],"] وزاد في الضَّيفِ: جائزتُهُ يومٌ وليلةٌ، والضِّيافةُ ثلاثةُ أيَّامٍ، فما كان بَعدَ ذلك فهو صَدقةٌ، ولا يَحِلُّ له أنْ يُقيمَ عندَهُ حتَّى يُحرِجَهُ."],"grade":"صحيح","narrator":"أبو شريح العدوي خويلد بن عمرو","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6019، 6135) مفرقاً باختلاف يسير، ومسلم (48) مختصراً باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"WB5Q954B","merged":2,"otherRefs":["صحيح الأدب المفرد 569 (صحيح)"]},{"id":"س-01678","fp":"877762f0ed6e","stateId":120,"easy":"إذا حسن خلقك ← تكون أكمل المؤمنين إيماناً","cause":"أحسَنُهُم خُلُقًا","result":"فأيُّ المؤمنينَ أكمَلُهم إيمانًا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[41],"ref":"النوافح العطرة 227","srcLabel":"أحمد","text":["قُلِ الحقَّ وإن كان مُرًّا [يعني حديث: دخَلتُ علَى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وهو في المسجِدِ جالِسٌ، فاغتَنَمتُ خلوتَهُ، وحدَهُ، فجلَستُ إليهِ، فقالَ : أبا ذَرٍّ ! إن لِلمَسجِد تَحيَّةً، وإنَّ تحيَّتَهُ ركعتان فقُم فاركَعهما، قالَ : فقُمت فركَعتُها ثم عُدتُ فجلَستُ إليهِ، فقُلتُ : يا رسولَ اللهِ ! إنَّكَ أمَرتَني بالصَّلاةِ فما الصَّلاةُ ؟ قال : خيرٌ موضوعٌ استكثِرْ أو استَقِلَّ. قلتُ : يا رسولَ اللهِ ! فأيُّ الأعمالِ أفضَلُ ؟ قال : إيمانٌ باللَّهِ عزَّ وجلَّ، وجهادٌ في سبيلِهِ، قال : قلتُ : يا رسولَ اللهِ ! ",["فأيُّ المؤمنينَ أكمَلُهم إيمانًا",2]," ؟ قالَ : ",["أحسَنُهُم خُلُقًا",1],". قالَ : قلتُ : يا رسولَ اللَّهِ ! فأيُّ المؤمنينَ أسلَمُ ؟ قالَ : مَن سلِمَ النَّاسُ من لسانِهِ ويدِهِ. قال : قلتُ : يا رسولَ اللَّهِ ! فأيُّ الهجرةِ أفضَلُ ؟ قال : مَن هجرَ السَّيِّئاتِ. قالَ : قُلتُ : يا رسولَ اللهِ ! فأيُّ الصَّلاةِ أفضَلُ ؟ قال : طولُ القنوتِ . قال : قلتُ : يا رسولَ اللهِ ! فما الصِّيامُ ؟ قالَ : فرضٌ مَجزيٌّ ، وعندَ اللهِ أضعافٌ كثيرةٌ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ الجهادِ أفضَلُ ؟ قالَ : مَن عُقِرَ جوادُهُ وأهريقَ دمُهُ. قال : قُلتُ : يا رسولَ اللهِ ! فأيُّ الرِّقابِ أفضَلُ ؟ قالَ : أغلاها ثَمنًا وأنفَسُها عندَ ربِّها. قالَ : قلتُ : يا رسولَ اللهِ ! فأيُّ الصَّدقةِ أفضَلُ ؟ قال : جُهدٌ مِن مُقِلٍّ يُسَرُّ إلى فقيرٍ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ آيةٍ مِمَّا أنزلَ اللهُ عزَّ وجلَّ عليكَ أعظَمُ ؟ قال : آيةُ الكُرسيِّ. ثُمَّ قالَ : يا أبا ذَرٍّ ! ما السَّماواتُ السَّبعُ معَ الكُرسيِّ إلا كَحلقَةٍ مُلقاةٍ بأرضِ فلاةٍ، وفَضلُ العَرشِ على الكُرسيِّ كفَضلِ الفَلاةِ علَى الحَلقَةِ. قلتُ : يا رسولَ اللهِ ! كم الأنبياءُ ؟ قال : مائةُ ألفٍ وأربعةٌ وعِشرونَ ألفًا. قلتُ : يا رسولَ اللهِ ! كم الرُّسلِ ؟ قالَ : ثلاثُمائةٍ وثلاثَةُ عشرَ جَمًّا غفيرًا. قلتُ : كثيرٌ طيِّبٌ، قلتُ : يا رسولَ اللهِ ! مَن كان أوَّلُهمْ ؟ قال : آدَمُ. قلتُ : يا رسولَ اللهِ ! أنَبيٌّ مُرسَلٌ ؟ قال : نعَم، خلقَهُ اللهُ بيدِهِ، ونفخَ فيهِ مِن روحِهِ، ثُمَّ سوَّاهُ قِبَلًا. وقال أحمدُ بنُ أنَسٍ ثُمَّ كلَّمهُ قِبَلًا. ثُمَّ قالَ : يا أبا ذَرٍّ ! أربعةٌ سُريانيُّونَ؛ آدَمُ، وشيثُ، وخَنوخُ - وهو إدريسُ، وهم أوَّلُ مَن خطَّ بالقلَمِ - ونوحٌ. وأربعةٌ من العَربِ؛ هودٌ، وصالِحٌ، وشُعَيبٌ، ونبيُّكَ يا أبا ذَرٍّ. قال : قلتُ : يا رسولَ اللهِ ! كَم كتابٌ أنزلَهُ اللَّهُ تعالى ؟ قال : مائةُ كتابٍ وأربعةُ كتُبٍ، أنزلَ علَى شيثَ خَمسونَ صحيفَةً، وأنزلَ علَى خَنوخَ ثلاثونَ صَحيفةً، وأنزلَ على إبراهيمَ عشرَ صحائفَ، وأنزلَ على موسَى قبلَ التَّوراةِ عَشرَ صحائفَ، وأنزلَ التَّوراةَ والإنجيلَ والزَّبورَ والفُرقانَ. قال : قلتُ : يا رسولَ اللهِ ! فَما كانَت صُحفُ إبراهيمَ ؟ قالَ : كانَت أمثالًا كلُّها : أيُّها الملِكُ المسلَّطُ المبتَلَى المغرورُ، فإنِّي لم أبعثْكَ لتجمَعَ الدُّنيا بعضَها إلى بعضٍ، ولكن بعثتُكَ لترُدَّ عنِّي دعوةَ المظلومِ، فإنِّي لا أردُّها ولَو كانَت مِن كافِرٍ. وكانَت فيها أمثالٌ : علَى العاقِلِ ما لَم يكُن مغلوبًا علَى عقلِهِ أن تكونَ له ساعاتٌ؛ ساعَةٌ يُناجي فيها ربَّهُ عزَّ وجلَّ، وساعةٌ يحاسِبُ فيها نفسَهُ، وساعَةٌ يفكِّرُ فيها في صُنعِ اللَّهِ عزَّ وجلَّ، وساعةٌ يخلو فيها بحاجتِهِ من المطعَمِ والمشرَبِ، وعلى العاقلِ أن لا يكون ظاعِنًا إلَّا لثلاثٍ؛ تزوُّدٍ لمعادٍ، أو مرمَّةٍ لمعاشٍ، أو لذَّةٍ في غيرِ محرَّمٍ، وعلى العاقِلِ أن يكونَ بصيرًا بزمانِهِ، مقبِلًا على شأنِهِ، حافِظًا للسانِهِ، ومن حسَبَ كلامَهُ من عمَلِهِ قلَّ كلامُهُ إلا فيما يعنيهِ. قلتُ : يا رسولَ اللَّهِ ! فما كان صحُفُ موسَى عليهِ السَّلامُ ؟ قال : كانَت عبرًا كلَّها، عجبتُ لمن أيقنَ بالموتِ ثُمَّ هو يفرَحُ، عجبتُ لمن أيقنَ بالنَّارِ وهو يضحَكُ، عجبتُ لمن أيقنَ للقدرِ ثم هو ينصَبُ، عجبتُ لمن رأى الدُّنيا وتقلُّبَها ثُمَّ اطمأنَّ إليها، عجِبتُ لمن أيقنَ بالحسابِ غدًا ثُمَّ لا يعمَلُ. قلتُ : يا رسولَ اللهِ ! أوصِني. قال : أوصيكَ بتقوى اللهِ فإنَّهُ رأسُ الأمرِ كلِّهِ، قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بتلاوَةِ القرآنِ فإنَّهُ نور لكَ في الأرضِ وذكرٌ لكَ في السَّماءِ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : إيَّاكَ وكثرةَ الضَّحِكِ فإنَّهُ يُميتُ القَلبَ، ويَذهَبُ بنورِ الوَجهِ، قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : عليكَ بالصَّمتِ إلَّا مِن خيرٍ، فإنَّهُ مطردَةٌ للشَّيطانِ عنكَ، وعونٌ لكَ علَى أمر دينِكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بالجهادِ فإنَّهُ رهبانيَّةُ أمَّتي. قلتُ : يا رسولَ اللهِ ! زِدني. قال : حبُّ المساكينِ وجالِسهُم. قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : انظُر إلى مَن تحتَكَ ولا تنظُر إلى مَن فوقكَ فإنَّهُ أجدَرُ أن لا تَزدَري نِعمةَ اللهِ عندكَ. قلتُ : زِدني يا رسولَ اللهِ ! قال : صِلْ قرابَتَكَ وإن قَطعوكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : لا تَخَف في اللَّهِ تعالى لَومَةَ لائمٍ. قلتُ : يا رسولَ اللهِ ! زِدني. قالَ : قُل الحقَّ وإن كان مُرًّا. قلتُ : يا رسولَ اللهِ ! زِدني. قال : يردُّكَ عن النَّاسِ ما تعرفُ من نفسِكَ، ولا تجِد عليهِم فيما تأتي، وكفَى به عيبًا أن تعرِفَ من النَّاسِ ما تجهَلُ من نفسِكَ، أو تجِدُ عليهِم فيما تأتي. ثُمَّ ضربَ بيدِهِ علَى صدري، فقالَ : يا أبا ذَرٍّ ! لا عقلَ كالتَّدبيرِ، ولا ورعَ كالكَفِّ، ولا حسَبَ كحُسنِ الخُلُقِ، قلتُ : يارسولَ اللهِ ! هل لي في الدُّنيا شَيءٌ مِمَّا أنزلَ اللهُ عليكَ مِمَّا كان في صحُفِ إبراهيمَ وموسَى ؟ قال : يا أبا ذَرٍّ ! اقرَأ : ? قَد أفلَحَ مَن تزَكَّى? إلى آخرِ السُّورَةِ]"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مطولاً أحمد (21415)، والبزار (3966) باختلاف يسير، وابن حبان (361) واللفظ له","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"wZID7EAR","merged":7,"otherRefs":["الفتوحات الربانية 4/51 (حسن)","تخريج شرح السنة 1/39 (صحيح)","الأحاديث المختارة 2210 (صحيح)","الحديث لابن عبدالوهاب 1/555 (صحيح)","المستدرك على الصحيحين 8848 (صحيح)","صحيح الجامع 1129 (صحيح)"]},{"id":"ق-0723","fp":"ea1a54ff43f8","stateId":121,"easy":"العلم وسماع القرآن ← السجود والبكاء وزيادة الخشوع","cause":"العلم وسماع القرآن","result":"السجود والبكاء وزيادة الخشوع","explicit":true,"star":true,"ref":"سورة الإسراء: 107–109","srcLabel":"القرآن الكريم","quran":{"s":17,"from":107,"to":109,"text":"قُلْ آمِنُوا بِهِ أَوْ لَا تُؤْمِنُوا إِنَّ الَّذِينَ أُوتُوا الْعِلْمَ مِنْ قَبْلِهِ إِذَا يُتْلَى عَلَيْهِمْ يَخِرُّونَ لِلْأَذْقَانِ سُجَّدًا (107) وَيَقُولُونَ سُبْحَانَ رَبِّنَا إِنْ كَانَ وَعْدُ رَبِّنَا لَمَفْعُولًا (108) وَيَخِرُّونَ لِلْأَذْقَانِ يَبْكُونَ وَيَزِيدُهُمْ خُشُوعًا (109)","hl":[[38,288,1]]}},{"id":"ق-1027","fp":"6d1ae320a3fb","stateId":121,"easy":"العلم ← خشية الله","cause":"العلم","result":"خشية الله","explicit":true,"otherNeedIds":[16],"ref":"سورة فاطر: 28","srcLabel":"القرآن الكريم","quran":{"s":35,"from":28,"to":28,"text":"وَمِنَ النَّاسِ وَالدَّوَابِّ وَالْأَنْعَامِ مُخْتَلِفٌ أَلْوَانُهُ كَذَلِكَ إِنَّمَا يَخْشَى اللَّهَ مِنْ عِبَادِهِ الْعُلَمَاءُ إِنَّ اللَّهَ عَزِيزٌ غَفُورٌ (28)","hl":[[77,129,1]]}},{"id":"س-02789","fp":"02ca3a66be3f","stateId":121,"easy":"إذا اجتمع فيك حسن السمت والفقه في الدين ← فلست منافقاً","cause":"حُسْنُ سَمْتٍ، ولا فِقْهٌ في الدِّينِ","result":"خَصْلتانِ لا يَجْتَمِعانِ في مُنافِقٍ","explicit":true,"otherNeedIds":[16],"ref":"الأحكام الوسطى 1/ 90","srcLabel":"الترمذي","text":[["خَصْلتانِ لا يَجْتَمِعانِ في مُنافِقٍ",2],": ",["حُسْنُ سَمْتٍ، ولا فِقْهٌ في الدِّينِ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه الترمذي (2684)، والعقيلي في ((الضعفاء الكبير)) (2/ 24)، والطبراني في ((المعجم الأوسط)) (8010) بلفظه.","bab":"إيمان › النفاق","dorar":"5qgZh1Qq"},{"id":"س-07022","fp":"29e290ade32a","stateId":121,"easy":"إذا تعلمت الإيمان ثم القرآن ← يزداد إيمانك","cause":"فتعلَّمنا الإيمانَ قبلَ أن نتعَلَّمَ القرآنَ ثمَّ تعلَّمنا القرآنَ","result":"فازدَدنا بِه إيمانًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الصحيح المسند 273","srcLabel":"الصحيح المسند","text":["كُنَّا معَ النَّبِيِّ - صلَّى اللَّهُ عليهِ وعلى آلِهِ وسلَّمَ - ونحنُ فتيانٌ حَزاوِرَةٌ ، ",["فتعلَّمنا الإيمانَ قبلَ أن نتعَلَّمَ القرآنَ ثمَّ تعلَّمنا القرآنَ",1]," ",["فازدَدنا بِه إيمانًا",2]," ."],"grade":"صحيح","narrator":"جندب بن عبدالله","muhaddith":"صحيح","bab":"علم › الحث على طلب العلم","dorar":"El8Txvx6"},{"id":"س-03177","fp":"e51eefca496a","stateId":122,"easy":"إذا صار النبي ﷺ أحب إليك من أهلك ومالك والناس أجمعين ← يكمل إيمانك","cause":"حتَّى أكونَ أحَبَّ إليه مِن أهلِه ومالِه والنَّاسِ أجمَعينَ","result":"لا يُؤمِنُ عَبدٌ","explicit":true,"star":true,"similar":["س-01748","س-01771"],"ref":"صحيح مسلم 44","srcLabel":"البخاري","text":[["لا يُؤمِنُ عَبدٌ",2]," (وفي حَديثِ عبدِ الوارِثِ: الرَّجُلُ)، ",["حتَّى أكونَ أحَبَّ إليه مِن أهلِه ومالِه والنَّاسِ أجمَعينَ",1],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (15) باختلاف يسير","bab":"إيمان › حب الرسول","dorar":"WpLQKgPO"},{"id":"ق-1316","fp":"6dda7b1553d5","stateId":122,"easy":"ترك موادّة من حادّ الله ورسوله ولو كانوا أقرب الأقارب ← كتابة الإيمان في القلب والتأييد بروح منه والجنات ورضا الله والفلاح","cause":"ترك موادّة من حادّ الله ورسوله ولو كانوا أقرب الأقارب","result":"كتابة الإيمان في القلب والتأييد بروح منه والجنات ورضا الله والفلاح","explicit":true,"star":true,"otherNeedIds":[24,55,22,46],"ref":"سورة المجادلة: 22","srcLabel":"القرآن الكريم","quran":{"s":58,"from":22,"to":22,"text":"لَا تَجِدُ قَوْمًا يُؤْمِنُونَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ يُوَادُّونَ مَنْ حَادَّ اللَّهَ وَرَسُولَهُ وَلَوْ كَانُوا آبَاءَهُمْ أَوْ أَبْنَاءَهُمْ أَوْ إِخْوَانَهُمْ أَوْ عَشِيرَتَهُمْ أُولَئِكَ كَتَبَ فِي قُلُوبِهِمُ الْإِيمَانَ وَأَيَّدَهُمْ بِرُوحٍ مِنْهُ وَيُدْخِلُهُمْ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا رَضِيَ اللَّهُ عَنْهُمْ وَرَضُوا عَنْهُ أُولَئِكَ حِزْبُ اللَّهِ أَلَا إِنَّ حِزْبَ اللَّهِ هُمُ الْمُفْلِحُونَ (22)","hl":[[0,452,1]]}},{"id":"س-05397","fp":"56865f48928f","stateId":122,"easy":"إذا واليت في الله وأحببت فيه وأبغضت فيه ← فهي أوثق عرى الإيمان","cause":"الوَلايةُ في اللهِ بالحبِّ فيه والبُغضِ فيه","result":"أيُّ عُرى الإيمانِ أوثقُ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 3836","srcLabel":"الترمذي","text":["عنِ ابنِ مسعودٍ رَضيَ اللهُ عنه: {وَجَعَلْنَا فِي قُلُوبِ الَّذِينَ اتَّبَعُوهُ رَأْفَةً وَرَحْمَةً وَرَهْبَانِيَّةً ابْتَدَعُوهَا مَا كَتَبْنَاهَا عَلَيْهِمْ إِلَّا ابْتِغَاءَ رِضْوَانِ اللَّهِ فَمَا رَعَوْهَا حَقَّ رِعَايَتِهَا فَآتَيْنَا الَّذِينَ آمَنُوا مِنْهُمْ أَجْرَهُمْ وَكَثِيرٌ مِنْهُمْ فَاسِقُونَ} [الحديد: 27]. قالُ ابنُ مسعودٍ: قالَ لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «يا عبدَ اللهِ بنَ مسعودٍ». فقلتُ: لبَّيكَ يا رسولَ اللهِ، ثلاثَ مِرارٍ، قالَ: «هل تَدري ",["أيُّ عُرى الإيمانِ أوثقُ",2],"؟». قلتُ: اللهُ ورسولُهُ أعْلمُ. قالَ: «أَوثقُ الإيمانِ ",["الوَلايةُ في اللهِ بالحبِّ فيه والبُغضِ فيه",1],"، يا عبدَ اللهِ بنَ مسعودٍ». قلتُ: لبَّيكَ يا رسولَ اللهِ، ثلاثَ مِرارٍ، قالَ: «هل تَدري أيُّ النَّاسِ أفضلُ؟». قلتُ: اللهُ ورسولُهُ أعْلمُ. قالَ: «فإنَّ أفضلَ النَّاسِ أفضلُهم عملًا إذا فَقُهوا في دينِهِم، يا عبدَ اللهِ بنَ مسعودٍ»، قلتُ: لبَّيكَ وسَعديْكَ، ثلاثَ مِرارٍ، قالَ: «هل تَدري أيُّ النَّاسِ أَعلمُ؟». قلتُ: اللهُ ورسولُهُ أعْلمُ. قالَ: «فإنَّ أعلمَ النَّاسِ أبصرُهُم بالحقِّ إذا اختلفتِ النَّاسُ، وإن كان مُقصِّرًا في العملِ، وإن كان يَزحَفُ على استِهِ، واختلفَ مَنْ كان قبْلَنا على اثنتينِ وسبعينَ فِرقةً، نجا منها ثلاثٌ، وهَلَكَ سائرُها، فرقةٌ أذَتِ الملوكَ وقاتلَتْهُم على دينِ اللهِ وعيسى ابنِ مريمَ حتَّى قُتِلوا، وفرقةٌ لمْ يَكنْ لهم طاقةٌ بموازاةِ الملوكِ، فأقاموا بيْنَ ظَهرانيْ قومِهِم، فدَعَوْهم إلى دينِ اللهِ ودينِ عيسى ابنِ مريمَ فقتَلَتْهم الملوكُ، ونشَرَتْهم بالمناشيرِ، وفرقةٌ لمْ يكنْ لهم طاقةٌ بموازاةِ الملوكِ ولا بالمقامِ بيْنَ ظَهرانيْ قومِهِم يَدْعوهم إلى اللهِ وإلى دينِ عيسى ابنِ مريمَ، فساحوا في الجبالِ، وتَرهَّبوا فيها، فهُم الَّذين قالَ اللهُ: {وَرَهْبَانِيَّةً ابْتَدَعُوهَا مَا كَتَبْنَاهَا عَلَيْهِمْ إِلَّا ابْتِغَاءَ رِضْوَانِ اللَّهِ فَمَا رَعَوْهَا حَقَّ رِعَايَتِهَا} [الحديد: 27] إلى قولِهِ: {فَاسِقُونَ}، فالمؤمنونَ الَّذين آمنوا بي وصدَّقوني، والفاسقون الَّذين كَفروا بي، وجَحدوا بي»."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الحكيم الترمذي في ((نوادر الأصول)) (39)، والشاشي (772) كلاهما باختلاف يسير، والطبراني في ((الأوسط)) (4479) مختصرا ببعض لفظه.","bab":"رقائق وزهد › الحب في الله","dorar":"eLTo5QoE","merged":5,"otherRefs":["صحيح الجامع 2539 (صحيح)","فتاوى صديق خان 69 (صحيح)","الجامع الصغير 2241 (صحيح)","هداية الرواة 4/440 (حسن)"]},{"id":"س-00130","fp":"1de189ba63fb","stateId":122,"easy":"إذا تحاببتم ← يكمل إيمانكم (ولا تؤمنوا حتى تحابوا)","cause":"حتى تحابُّوا","result":"ولا تؤمِنوا","explicit":true,"otherNeedIds":[55],"ref":"الجامع الصغير 4154","srcLabel":"الترمذي","text":["دبَّ إليكم داءُ الأُمَمِ: الحسَدُ والبَغضاءُ، هي الحالِقةُ حالِقةُ الدِّينِ لا حالِقةُ الشَّعرِ، والذي نفسي بيَدِه، لا تدخُلوا الجنَّةَ حتى تُؤمِنوا، ",["ولا تؤمِنوا",2]," ",["حتى تحابُّوا",1],"، أفلا أنبِّئُكم بشيءٍ إذا فعَلْتُموه تحابَبْتُم؟ أفشُوا السَّلامَ بينكم."],"grade":"صحيح","narrator":"الزبير بن العوام","muhaddith":"صحيح","takhrij":"أخرجه أحمد (1412)، والبيهقي (21107)  واللفظ لهما، والترمذي (2510) باختلاف يسير.","bab":"آداب السلام › إفشاء السلام","dorar":"6qVilY5D","merged":4,"otherRefs":["صحيح الجامع 7081 (صحيح)","صحيح الأدب المفرد 751 (صحيح)","تخريج المسند لشعيب 10431 (صحيح)"]},{"id":"س-04741","fp":"c1fd84a0f908","stateId":122,"easy":"إذا أعطيت لله ومنعت لله وأحببت لله وأبغضت لله ← استكملت الإيمان","cause":"مَن أَعْطى للهِ تعالى، ومنَعَ للهِ تعالى، وأَحَبَّ للهِ تعالى، وأَبغَضَ للهِ تعالى، وأَنكَحَ للهِ تعالى","result":"فقدِ استَكمَلَ إيمانَه","explicit":true,"ref":"تخريج المسند لشعيب 15617","srcLabel":"الترمذي","text":[["مَن أَعْطى للهِ تعالى، ومنَعَ للهِ تعالى، وأَحَبَّ للهِ تعالى، وأَبغَضَ للهِ تعالى، وأَنكَحَ للهِ تعالى؛ ",1],["فقدِ استَكمَلَ إيمانَه",2],"."],"grade":"صحيح","narrator":"معاذ بن أنس","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (2521)، وأحمد (15638)","bab":"رقائق وزهد › الإخلاص","dorar":"4Zt3xYhV","merged":4,"otherRefs":["صحيح الترغيب 3029 (صحيح)","المستدرك على الصحيحين 2731 (صحيح)","تخريج شرح السنة 3469 (حسن)"]},{"id":"س-01748","fp":"56ecaf1ed8f5","stateId":122,"easy":"إذا صار النبي ﷺ أحب إليك من ولدك ووالدك ← يكمل إيمانك","cause":"حتَّى أَكونَ أَحبَّ إليه مِن ولدِهِ ووالدِهِ","result":"لا يؤمنُ أحدُكُم","explicit":true,"repOf":"س-03177","ref":"المستدرك على الصحيحين 3851","text":["عنْ فاطمةَ بنتِ عُتبةَ بنِ ربيعةَ بنِ عبدٍ شمسٍ، أنَّ أبا حُذَيْفةَ بنَ عُتبةَ رَضيَ اللهُ عنه، أَتى بها وبهندِ بنتِ عُتبةَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، تُبايعُهُ فقالتْ: أَخَذَ علينا فشَرَطَ علينا، قالتْ: قلتُ له: يا ابنَ عمِّ، هل عَلِمْتَ في قومِكَ مِن هذه العاهاتِ أوِ الهنَاتِ شيئًا؟ قالَ أبو حُذَيْفةَ: إيهًا فبايعيهِ، فإنَّ بهذا يُبايِعُ وهكذا يَشترطُ، فقالتْ هندٌ: لا أُبايعُكَ على السَّرقةِ، إنِّي أَسرِقُ مِن مالِ زوجي، فكَفَّ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ يدَهُ، وكفَّتْ يدَها حتَّى أَرسَلَ إلى أبي سُفيانَ فتَحلَّلَ لها منه، فقالَ أبو سُفيانَ: أمَّا الرَّطْبُ فنَعَمْ، وأمَّا اليابسُ فلا ولا نِعمةَ. قالتْ: فبايعناهُ. ثُمَّ قالتْ فاطمةُ: ما كانت قُبَّةٌ أَبغضَ إليَّ مِن قُبَّتِكَ، ولا أُحبُّ أنْ يُبيحَها اللهُ وما فيها، واللهِ ما مِن قُبَّةٍ أحبُّ إليَّ أنْ يُعمِّرَها اللهُ ويُبارِكَ فيها مِن قُبَّتِكَ. فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «وأيضًا واللهِ ",["لا يؤمنُ أحدُكُم",2]," ",["حتَّى أَكونَ أَحبَّ إليه مِن ولدِهِ ووالدِهِ",1],"»."],"grade":"صحيح","narrator":"فاطمة بنت عتبة بن ربيعة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني (24/ 364) (904)، وأبو نعيم في ((معرفة الصحابة)) (6739)، وابن عساكر في ((تاريخه)) (13852) جميعا مختصرا.","bab":"أيمان › الحلف بالله وصفاته وكلماته","dorar":"uyuQAjmF","merged":3,"otherRefs":["تخريج المسند لشعيب 18961 (صحيح)","تخريج المسند لشعيب 13152 (صحيح)"]},{"id":"س-03178","fp":"d55741725b71","stateId":122,"easy":"إذا أحببت آل النبي ﷺ لله ولرسوله ← يدخل الإيمان قلبك","cause":"حتى يُحِبَّكم للهِ ولرسولِهِ","result":"لا يَدْخُلُ قلبَ رجلٍ الإيمانُ","explicit":true,"ref":"سنن الترمذي 3758","srcLabel":"النسائي","text":["أن العباسَ بنَ عبدِ المُطَّلِبِ، دخل على رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّم مُغْضَبًا وأنَا عنده، فقال : ما أَغْضَبَكَ ؟ قال : يا رسولَ اللهِ ! ما لنا ولِقريشٍ ! إذا تَلَاقَوْا بينهم، تَلَاقَوْا بوجوهٍ مُبَشِّرَةٍ، وإذا لَقُونَا، لَقُونَا بغيرِ ذلك، قال : فغَضِبَ رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم حتى احْمَرَّ وجهُه، ثم قال : والذي نفسي بيدِهِ، ",["لا يَدْخُلُ قلبَ رجلٍ الإيمانُ",2]," ",["حتى يُحِبَّكم للهِ ولرسولِهِ",1],"، ثم قال : يا أَيُّها الناسُ ! من آذى عَمِّي فقد آذاني، فإنما عَمُّ الرجلِ صِنْوُ أبيهِ"],"grade":"صحيح","narrator":"عبدالمطلب بن ربيعة بن الحارث","muhaddith":"حسن صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (8120)، والطبراني (20/ 284) (672) كلاهما بلفظه، وأحمد (17516) بنحوه .","bab":"إيمان › حب الرسول","dorar":"WWwB6Kfe","merged":3,"otherRefs":["تخريج المسند لشاكر 3/206 (صحيح)","تخريج المسند لشاكر 3/210 (صحيح)"]},{"id":"س-00718","fp":"97da6111298c","stateId":122,"easy":"إذا أحببت لله وأبغضت لله وأعملت لسانك بالذكر ← فهو أفضل الإيمان","cause":"أنْ تُحِبَّ للهِ، وتُبغِضَ في اللهِ، وتُعمِلَ لِسانَكَ في ذِكرٍ","result":"أفضلُ الإيمانِ","explicit":true,"ref":"تخريج المسند لشعيب 22132","srcLabel":"أحمد","text":["أنَّه سَأَلَ رسولَ اللهِ صَلَّى اللهُ عليه وسلَّمَ عن أفضلِ الإيمانِ، قال: ",["أفضلُ الإيمانِ",2],[" أنْ تُحِبَّ للهِ، وتُبغِضَ في اللهِ، وتُعمِلَ لِسانَكَ في ذِكرٍ",1],"، قال: وماذا يا رسولَ اللهِ؟ قال: وأنْ تُحِبَّ للنَّاسِ ما تُحِبُّ لنَفْسِكَ، وتَكرَهَ لهم ما تَكرَهُ لنَفْسِكَ، وأنْ تَقولَ خيرًا أو تَصمُتَ."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (22132) واللفظ له، والبيهقي في ((شعب الإيمان)) (579)","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"R6Y6bI1m"},{"id":"س-05401","fp":"15301f0afa27","stateId":122,"easy":"إذا أحببت أحداً لا تحبه إلا لله ← فهو من الإيمان","cause":"أن يحِبَّ الرَّجلُ رجلًا لا يُحبُّه إلَّا للهِ","result":"إنَّ من الإيمانِ","explicit":true,"ref":"الترغيب والترهيب 4/80","srcLabel":"الطبراني","text":[["إنَّ من الإيمانِ",2]," ",["أن يحِبَّ الرَّجلُ رجلًا لا يُحبُّه إلَّا للهِ",1]," من غيرِ مالٍ أعطاه فذلك الإيمانُ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (7214)","bab":"رقائق وزهد › الحب في الله","dorar":"cz92TlxX"},{"id":"س-08336","fp":"6aeda155eadc","stateId":122,"easy":"إذا أحببت الأنصار ← فهو آية إيمانك","cause":"حبُّ الأنصارِ","result":"آيةُ الإيمانِ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"similar":["س-08349"],"otherNeedIds":[20],"ref":"عمدة القاري 16/95","srcLabel":"عمدة القاري","text":["أنه صلَّى اللهُ عليهِ وسلَّمَ قال ",["آيةُ الإيمانِ",2]," ",["حبُّ الأنصارِ",1]," وآيةُ المنافقِ بُغضُ الأنصارِ"],"grade":"صحيح","muhaddith":"صحيح","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"aVzlKEJr","merged":6,"otherRefs":["الرسالة الوازعة للمعتدين 371 (صحيح)","تخريج المسند لشعيب 13607 (صحيح)","مجمع الزوائد 10/32 (صحيح)","صحيح النسائي 5034 (صحيح)","صحيح مسلم 74 (صحيح)"]},{"id":"س-03180","fp":"4d4df11b3e51","stateId":122,"easy":"إذا أحببت العرب ← فهو من الإيمان","cause":"حبُّ العربِ","result":"إيمانٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"حلية الأولياء 2/378","srcLabel":"البزار","text":[["حبُّ العربِ",1]," ",["إيمانٌ",2]," ، وبغضُّ العربِ كفرٌ ، فمن أحبَّ العربَ فقد أحبَّني ، ومن أبغضَ العربَ فقد أبغضني"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"غريب من حديث ثابت عن أنس تفرد به الهيثم بن جماز","takhrij":"أخرجه البزار (6997) بنحوه، والعقيلي في ((الضعفاء الكبير)) (4/355) باختلاف يسير، وأبو نعيم في ((حلية الأولياء)) (2/333) واللفظ له","bab":"إيمان › حب الرسول","dorar":"EboA4xY3","merged":2,"otherRefs":["المستدرك على الصحيحين 7193 (صحيح)"]},{"id":"س-01771","fp":"58156987566a","stateId":122,"easy":"إذا كان النبي ﷺ أحب إليك من نفسك ← يكمل إيمانك","cause":"حتَّى أكونَ أحَبَّ إليك مِن نَفسِك","result":"الآنَ يا عُمَرُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-03177","ref":"صحيح البخاري 6632","text":["كُنَّا مع النَّبيِّ صلَّى اللهُ عليه وسلَّم وهو آخِذٌ بيَدِ عُمَرَ بنِ الخَطَّابِ، فقال له عُمَرُ: يا رَسولَ اللهِ، لَأنتَ أحَبُّ إليَّ مِن كُلِّ شَيءٍ إلَّا مِن نَفسي، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: لا، والذي نَفسي بيَدِه، ",["حتَّى أكونَ أحَبَّ إليك مِن نَفسِك",1],"، فقال له عُمَرُ: فإنَّه الآنَ، واللهِ لَأنتَ أحَبُّ إليَّ مِن نَفسي، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ",["الآنَ يا عُمَرُ",2],"."],"grade":"صحيح","narrator":"عبدالله بن هشام","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (22503)، والبزار (3459)، والطبراني في ((المعجم الأوسط)) (317) جميعا باختلاف يسير .","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"Vip84Zn6"},{"id":"س-08349","fp":"05be9d189a84","stateId":122,"easy":"إذا أحببت الأنصار ← فحبهم إيمان وبغضهم نفاق","cause":"حُبُّهُم","result":"إيمانٌ وبُغْضُهم نِفاقٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"repOf":"س-08336","otherNeedIds":[20],"ref":"تخريج المسند لشعيب 23847","text":["إنَّ هذا الحَيَّ مِن الأنصارِ مِحْنةٌ، ",["حُبُّهُم",1]," ",["إيمانٌ وبُغْضُهم نِفاقٌ",2],". قال عَفَّانُ: وقد حدَّثَنا به مَرَّةً وليس فيه شَكٌّ، أمَلَّه علَيَّ أوَّلًا على الصِّحَّةِ."],"grade":"صحيح","narrator":"سعد بن عبادة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (23847) واللفظ له، وابن أبي شيبة (33026)، والبزار (3736)","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"bsubDN4Y"},{"id":"س-08372","fp":"1f7459b0523c","stateId":122,"easy":"إذا اجتمع في قلبك حب أبي بكر وعمر وعثمان وعلي ← فهو قلب مؤمن","cause":"حُبُّ هؤلاءِ الأربعةِ","result":"إلَّا في قلْبِ مُؤْمِنٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"otherNeedIds":[20],"ref":"إتحاف الخيرة المهرة 7/159","srcLabel":"إتحاف الخيرة المهرة","text":["لا يجتمِعُ ",["حُبُّ هؤلاءِ الأربعةِ",1]," ",["إلَّا في قلْبِ مُؤْمِنٍ",2],": أبو بكرٍ، وعمرُ، وعُثمانُ، وعليٌّ رضِيَ اللهُ عنهما."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"رواته ثقات","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"kurUAkQs"},{"id":"س-08392","fp":"8383f8941217","stateId":123,"easy":"إذا سرّتك حسنتك وساءتك سيئتك ← فأنت مؤمن","cause":"ومَن سَرَّتْه حَسَنتُه، وساءتْه سيِّئتُه","result":"فهو مؤمنٌ","explicit":true,"star":true,"similar":["س-07156","س-02342","س-08360"],"ref":"تخريج مشكل الآثار 3708","srcLabel":"البخاري","text":["عن ابن عمر أنَّ عُمَرَ بنَ الخطَّابِ خَطَبَ النَّاسَ بالجابِيةِ، فقال: قام فينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ خَطيبًا مَقامي هذا فيكم، فقال: استَوصوا بأصحابي خيرًا، ثُمَّ الذين يَلونَهم، ثُمَّ يَفشُو الكَذِبُ، حتى إنَّ الرَّجُلَ ليَبدَأُ بالشَّهادةِ قبلَ أنْ يُسأَلَها، وباليَمينِ قبلَ أنْ يُسأَلَها، فمَن أرادَ منكم بُحبوحةَ الجنَّةِ؛ فليَلزَمِ الجَماعةَ؛ فإنَّ الشَّيطانَ مع الواحدِ، وهو مِن الاثنَينِ أبعدُ، ولا يَخلوَنَّ أحدُكم بامرأةٍ؛ فإنَّ الشَّيطانَ ثالثُهما، ",["ومَن سَرَّتْه حَسَنتُه، وساءتْه سيِّئتُه؛ ",1],["فهو مؤمنٌ",2],"، هكذا حَدَّثَنا محمَّدُ بنُ عليٍّ هذا الحديثَ، فقال فيه: بُحبوحةُ الجنَّةِ، قال: وقال عبدُ اللهِ، وقال غيرُه -كأنَّه يَعني غير محمَّدِ بنِ سُوقةَ-: بَحبَحةُ الجنَّةِ."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح على شرح البخاري","takhrij":"أخرجه أحمد (114)، وابن حبان (7254)، والحاكم (387) مطولاً باختلاف يسير","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"DzdB7trU","merged":13,"otherRefs":["صحيح الجامع 5611 (صحيح)","فيض القدير 6/ 153 (صحيح)","الأحاديث المختارة 8 / 198 (صحيح)","صحيح الجامع 6294 (صحيح)","تخريج المسند لشعيب 15696 (صحيح)","المستدرك على الصحيحين 392 (صحيح)","تخريج مشكل الآثار 3719 (صحيح)","تخريج مشكل الآثار 3711 (حسن)","المستدرك على الصحيحين 395 (صحيح)","تخريج شرح السنة 9 / 27 (صحيح)","الأحاديث المختارة 155 (صحيح)","الأحاديث المختارة 157 (صحيح)"]},{"id":"ق-0006","fp":"e4a06348ecd5","stateId":123,"easy":"عبادة الله ← التقوى","cause":"عبادة الله","result":"التقوى","explicit":true,"star":true,"ref":"سورة البقرة: 21","srcLabel":"القرآن الكريم","quran":{"s":2,"from":21,"to":21,"text":"يَا أَيُّهَا النَّاسُ اعْبُدُوا رَبَّكُمُ الَّذِي خَلَقَكُمْ وَالَّذِينَ مِنْ قَبْلِكُمْ لَعَلَّكُمْ تَتَّقُونَ (21)","hl":[[0,111,1]]}},{"id":"ق-0811","fp":"d2daecb1d430","stateId":123,"easy":"تعظيم شعائر الله ← من تقوى القلوب","cause":"تعظيم شعائر الله","result":"من تقوى القلوب","explicit":true,"star":true,"ref":"سورة الحج: 32","srcLabel":"القرآن الكريم","quran":{"s":22,"from":32,"to":32,"text":"ذَلِكَ وَمَنْ يُعَظِّمْ شَعَائِرَ اللَّهِ فَإِنَّهَا مِنْ تَقْوَى الْقُلُوبِ (32)","hl":[[7,76,1]]}},{"id":"س-07156","fp":"c9b3f505be8b","stateId":123,"easy":"إذا سرّتك حسنتك وساءتك سيئتك ← فأنت مؤمن","cause":"إذا سَرَّتْكَ حَسَنَتُكَ وساءَتْكَ سَيِّئَتُكَ","result":"فأنتَ مُؤمِنٌ","explicit":true,"repOf":"س-08392","ref":"المستدرك على الصحيحين 33","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ سأَلَهُ رَجُلٌ، فقالَ: يا رسولَ اللهِ، ما الإيمانُ؟ قالَ: «",["إذا سَرَّتْكَ حَسَنَتُكَ وساءَتْكَ سَيِّئَتُكَ",1]," ",["فأنتَ مُؤمِنٌ",2],"». فقالَ: يا رسولَ اللهِ، ما الإثْمُ؟ قالَ: «إذا حَكَّ في صَدْرِكَ شَيْءٌ فَدَعْهُ»."],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"[صحيح متصل على شرط الشيخين]","takhrij":"أخرجه أحمد (22166)، والحارث بن أبي أسامة في مسنده كما في ((بغية الباحث)) (11) بلفظه، والطبراني (8/ 117) (7540) باختلاف يسير.","bab":"علم › حسن السؤال ونصح العالم","dorar":"FH0S1sVd","merged":4,"otherRefs":["السلسلة الصحيحة 550 (صحيح)","الصحيح المسند 489 (صحيح)","هداية الرواة 42 (صحيح)"]},{"id":"س-02354","fp":"3b0f769d2655","stateId":123,"easy":"إذا كرهت سيئتك وفرحت بحسنتك ← فأنت مؤمن","cause":"مَن عَمِلَ سَيِّئَةً فكَرِهَها حين يَعْملُ، وَعَمِلَ حَسَنةً فَسُرَّ بها","result":"فهو مُؤمِنٌ","explicit":true,"ref":"المستدرك على الصحيحين 32","srcLabel":"البيهقي","text":["«",["مَن عَمِلَ سَيِّئَةً فكَرِهَها حين يَعْملُ، وَعَمِلَ حَسَنةً فَسُرَّ بها ",1],["فهو مُؤمِنٌ»",2],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح على شرطهما","takhrij":"أخرجه الروياني في ((المسند)) (579)، والبيهقي في ((شعب الإيمان)) (6597) واللفظ لهما.","bab":"إحسان › الحسنات والسيئات","dorar":"jrvhQSDx","merged":2,"otherRefs":["تخريج المسند لشعيب 19565 (صحيح)"]},{"id":"س-02342","fp":"f3267823051c","stateId":123,"easy":"إذا سرّتك حسناتك وساءتك سيئاتك ← فأنت مؤمن","cause":"إذا سرَّتْكَ حَسناتُكَ وساءَتْكَ سيِّئاتُكَ","result":"فأنتَ مُؤمِنٌ","explicit":true,"repOf":"س-08392","ref":"صحيح ابن حبان 176","text":["قال رجُلٌ : يا رسولَ اللهِ ما الإيمانُ ؟ قال : ( ",["إذا سرَّتْكَ حَسناتُكَ وساءَتْكَ سيِّئاتُكَ",1]," ",["فأنتَ مُؤمِنٌ",2]," ) قال : يا رسولَ اللهِ فما الإثمُ ؟ قال : ( إذا حاك في قلبِكَ شيءٌ فدَعْه )"],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن المبارك في ((الزهد والرقائق)) (825)، والروياني في ((المسند)) (1255)، والطبراني (8/ 117) (7539) واللفظ لهم.","bab":"إحسان › الحسنات والسيئات","dorar":"8QffgtQl"},{"id":"س-05456","fp":"b5a12b2fd946","stateId":123,"easy":"إذا تركت النظرة المحرمة خوفاً من الله ← يثيبك إيماناً تجد حلاوته في قلبك","cause":"فمَن تَرَكها مِن خَوفِ اللهِ","result":"أثابَه جَلَّ وعزَّ إيمانًا يَجِدُ حَلاوتَه في قَلبِه","explicit":true,"otherNeedIds":[5],"ref":"المستدرك على الصحيحين 8088","srcLabel":"الحاكم","text":["النَّظرةُ سَهمٌ من سِهامِ إبليسَ مَسمومةٌ، ",["فمَن تَرَكها مِن خَوفِ اللهِ ",1],["أثابَه جَلَّ وعزَّ إيمانًا يَجِدُ حَلاوتَه في قَلبِه",2],"."],"grade":"صحيح","narrator":"حذيفة","muhaddith":"صحيح الإسناد","bab":"رقائق وزهد › الخوف من الله","dorar":"Ouatggm5"},{"id":"س-05596","fp":"276729a05998","stateId":123,"easy":"إذا أردت الآخرة فتركت زينة الدنيا ← فقد استحييت من الله حق الحياء","cause":"ومَن أرادَ الآخرةَ ترَكَ زِينةَ الدُّنْيا، ومَن فعَلَ ذلكَ","result":"فقدِ استَحْيَا مِن اللهِ حَقَّ الحياءِ","explicit":true,"ref":"المستدرك على الصحيحين 8128","srcLabel":"الترمذي","text":["استَحْيُوا مِن اللهِ حَقَّ الحياءِ، فقُلْنا: يا نَبيَّ اللهِ إنَّا لِنَسْتحْيي، قالَ: ليْسَ ذلكَ، ولكِنْ مَن استَحْيا مِن اللهِ حَقَّ الحياءِ، فلْيَحْفَظِ الرَّأْسَ وما حَوى، والبَطْنَ وما وَعَى، ولْيَذْكُرِ الموتَ والبِلى، ",["ومَن أرادَ الآخرةَ ترَكَ زِينةَ الدُّنْيا، ومَن فعَلَ ذلكَ ",1],["فقدِ استَحْيَا مِن اللهِ حَقَّ الحياءِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (2458)، والبزار (2025)، وأبو يعلى الموصلي (5047) جميعهم بلفظه.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"paoPHAS2"},{"id":"س-08360","fp":"766f013de48e","stateId":123,"easy":"إذا ساءتك سيئتك وسرّتك حسنتك ← فأنت مؤمن","cause":"ومَن كانَ مِنكم تَسوءُه سَيِّئةٌ وتَسُرُّه حَسَنةٌ","result":"فهو مُؤمِنٌ","explicit":true,"repOf":"س-08392","ref":"الأحكام الوسطى 2/ 374","text":["خَطَبَ عُمَرُ النَّاسَ بالجابِيةِ فقالَ: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قامَ في مِثلِ مَقامي هذا، قالَ: \"أَحسِنوا إلى أصْحابي، ثُمَّ الَّذين يَلونَهم، ثُمَّ الَّذين يَلونَهم، ثُمَّ الَّذين يَلونَهم، ثُمَّ يَفْشو الكَذِبُ حتَّى إنَّ الرَّجُلَ لَيَحلِفُ على اليَمينِ قَبْلَ أن يُسْتحْلَفَ، ويَشهَدُ على الشَّهادةِ قَبْلَ أن يُسْتَشهَدَ عليها، فمَن أرادَ مِنكم أن يَنالَ بُحْبوحةَ الجَنَّةِ فليَلزَمِ الجَماعةَ؛ فإنَّ الشَّيْطانَ معَ الواحِدِ، وهو مِن الاثْنَينِ أَبعَدُ، أَلَا لا يَخْلُوَنَّ رَجُلٌ بامْرَأةٍ؛ فإنَّ الشَّيْطانَ ثالِثُهما، أَلَا ",["ومَن كانَ مِنكم تَسوءُه سَيِّئةٌ وتَسُرُّه حَسَنةٌ ",1],["فهو مُؤمِنٌ",2],"."],"grade":"صحيح","narrator":"جابر بن سمرة","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أحمد (177)، والنسائي في ((السنن الكبرى)) (9175)، واللفظ له، وابن ماجه (2363) بنحوه","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"1DWAxZtJ"},{"id":"س-03808","fp":"427a10a0ac6e","stateId":123,"easy":"إذا استقام قلبك ← يستقيم إيمانك","cause":"حتى يَسْتَقِيمَ قلبُهُ","result":"لا يَسْتَقِيمُ إِيمانُ عبدٍ","explicit":true,"ref":"صحيح الترغيب 2865","srcLabel":"أحمد","text":[["لا يَسْتَقِيمُ إِيمانُ عبدٍ",2]," ",["حتى يَسْتَقِيمَ قلبُهُ",1]," ، ولا يَسْتَقِيمُ قلبُهُ حتى يَسْتَقِيمَ لسانُهُ ، ولا يدخلُ الجنةَ رجلٌ لا يَأْمَنُ جارُهُ بَوَائِقَهُ ."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"أخرجه أحمد (13048)، وابن أبي الدنيا في ((الصمت)) (9) واللفظ لهما، والقضاعي في ((مسند الشهاب)) (887) بلفظه مختصرًا.","bab":"بر وصلة › حق الجار والوصاة به","dorar":"PcpzO09G"},{"id":"س-05534","fp":"b99086e63b50","stateId":123,"easy":"إذا حفظت رأسك وبطنك وذكرت الموت وتركت زينة الدنيا ← فقد استحييت من الله حق الحياء","cause":"أن تحفَظ الرَّأسَ ، وما وَعى ، وتحفَظَ البَطنَ ، وما حوَى ، ولتَذكرِ الموتَ والبِلى ، ومَن أرادَ الآخرةَ ترَكَ زينةَ الدُّنيا","result":"فمَن فَعلَ ذلِكَ فقدَ استحيا يعني : منَ اللَّهِ حقَّ الحياءِ","explicit":true,"ref":"صحيح الترمذي 2458","srcLabel":"الترمذي","text":["استَحيوا منَ اللَّهِ حقَّ الحياءِ ، قُلنا : يا رسولَ اللَّهِ إنَّا لنَستحيي والحمد لله ، قالَ : ليسَ ذاكَ ، ولَكِنَّ الاستحياءَ منَ اللَّهِ حقَّ الحياءِ ",["أن تحفَظ الرَّأسَ ، وما وَعى ، وتحفَظَ البَطنَ ، وما حوَى ، ولتَذكرِ الموتَ والبِلى ، ومَن أرادَ الآخرةَ ترَكَ زينةَ الدُّنيا",1]," ، ",["فمَن فَعلَ ذلِكَ فقدَ استحيا يعني : منَ اللَّهِ حقَّ الحياءِ",2]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"حسن","takhrij":"أخرجه الترمذي (2458) واللفظ له، وأحمد (3671)","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"pePO798j"},{"id":"س-06935","fp":"8f3a86e9d03d","stateId":123,"easy":"إذا علمت أن الله معك حيثما كنت ← فهو أفضل الإيمان","cause":"أن تعلمَ أنَّ اللَّهَ معَكَ حيثُما كنتُ","result":"أفضلُ الإيمانِ","explicit":true,"ref":"مجموع الفتاوى 3/140","srcLabel":"مجموع الفتاوى","text":[["أفضلُ الإيمانِ",2],[" أن تعلمَ أنَّ اللَّهَ معَكَ حيثُما كنتُ",1]],"grade":"حسن","muhaddith":"حسن","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"SY49PdxK"},{"id":"ق-0188","fp":"5457c61f571e","stateId":124,"easy":"قول «حسبنا الله ونعم الوكيل» عند التخويف ← زيادة الإيمان والانقلاب بنعمة وفضل لم يمسسهم سوء ورضوان الله","cause":"قول «حسبنا الله ونعم الوكيل» عند التخويف","result":"زيادة الإيمان والانقلاب بنعمة وفضل لم يمسسهم سوء ورضوان الله","explicit":true,"star":true,"apply":{"k":"say","t":"«حسبنا الله ونعم الوكيل»"},"otherNeedIds":[30,4,22],"ref":"سورة آل عمران: 173–174","srcLabel":"القرآن الكريم","quran":{"s":3,"from":173,"to":174,"text":"الَّذِينَ قَالَ لَهُمُ النَّاسُ إِنَّ النَّاسَ قَدْ جَمَعُوا لَكُمْ فَاخْشَوْهُمْ فَزَادَهُمْ إِيمَانًا وَقَالُوا حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ (173) فَانْقَلَبُوا بِنِعْمَةٍ مِنَ اللَّهِ وَفَضْلٍ لَمْ يَمْسَسْهُمْ سُوءٌ وَاتَّبَعُوا رِضْوَانَ اللَّهِ وَاللَّهُ ذُو فَضْلٍ عَظِيمٍ (174)","hl":[[0,288,1]]}},{"id":"ق-0987","fp":"e0aded56b7f0","stateId":124,"easy":"اليقين بوعد الله عند الشدة ← زيادة الإيمان والتسليم","cause":"اليقين بوعد الله عند الشدة","result":"زيادة الإيمان والتسليم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الأحزاب: 22","srcLabel":"القرآن الكريم","quran":{"s":33,"from":22,"to":22,"text":"وَلَمَّا رَأَى الْمُؤْمِنُونَ الْأَحْزَابَ قَالُوا هَذَا مَا وَعَدَنَا اللَّهُ وَرَسُولُهُ وَصَدَقَ اللَّهُ وَرَسُولُهُ وَمَا زَادَهُمْ إِلَّا إِيمَانًا وَتَسْلِيمًا (22)","hl":[[0,165,1]]}},{"id":"س-07721","fp":"55abd55b450b","stateId":124,"easy":"إذا قلت «سمعنا وأطعنا وسلّمنا» لأمر الله ← يلقي الله الإيمان في قلبك","cause":"قولوا: سمِعْنا وأطَعْنا وسلَّمْنا","result":"فألقى اللهُ الإيمانَ في قلوبِهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«سمعنا وأطعنا وسلّمنا»"},"otherNeedIds":[11],"ref":"تخريج صحيح ابن حبان 5069","srcLabel":"مسلم","text":["لمَّا نزَلت هذه الآيةُ {إِنْ تُبْدُوا مَا فِي أَنْفُسِكُمْ أَوْ تُخْفُوهُ يُحَاسِبْكُمْ بِهِ اللَّهُ} [البقرة: 284] دخَل قلوبَهم منها شيءٌ لم يدخُلْه مِن شيءٍ فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ( ",["قولوا: سمِعْنا وأطَعْنا وسلَّمْنا",1]," ) ",["فألقى اللهُ الإيمانَ في قلوبِهم",2]," فأنزَل اللهُ: {آمَنَ الرَّسُولُ بِمَا أُنْزِلَ إِلَيْهِ مِنْ رَبِّهِ وَالْمُؤْمِنُونَ} [البقرة: 285] الآيةَ وقال: {رَبَّنَا لَا تُؤَاخِذْنَا إِنْ نَسِينَا أَوْ أَخْطَأْنَا} [البقرة: 286] ( قال: قد فعَلْتُ ) {رَبَّنَا وَلَا تَحْمِلْ عَلَيْنَا إِصْرًا كَمَا حَمَلْتَهُ عَلَى الَّذِينَ مِنْ قَبْلِنَا} [البقرة: 286] ( قال: قد فعَلْتُ )"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (126) باختلاف يسير","bab":"قرآن › أسباب النزول","dorar":"CT5USTwM","merged":2,"otherRefs":["حلية الأولياء 7/115 (صحيح)"]},{"id":"س-07429","fp":"e5d119234f00","stateId":125,"easy":"إذا جاهدت المنكر بلسانك ← فأنت مؤمن","cause":"ومَن جاهَدهم بلسانِه","result":"فهو مُؤمِنٌ","explicit":true,"star":true,"similar":["س-01723","س-02482"],"ref":"صحيح ابن حبان 177","srcLabel":"مسلم","text":["( سيكونُ أُمَراءُ مِن بعدي يقولونَ ما لا يفعَلونَ ويفعَلونَ ما لا يُؤمَرونَ فمَن جاهَدهم بيدِه ",["فهو مُؤمِنٌ",2]," ",["ومَن جاهَدهم بلسانِه",1]," فهو مُؤمِنٌ ومَن جاهَدهم بقلبِه فهو مُؤمِنٌ لا إيمانَ بعدَه ) قال عطاءٌ : فحين سمِعْتُ الحديثَ منه انطلَقْتُ به إلى عبدِ اللهِ بنِ عُمَرَ فأخبَرْتُه فقال : أنتَ سمِعْتَ ابنَ مسعودٍ يقولُ هذا ؟ كالمُدخِلِ عليه في حديثِه - قال عطاءٌ : فقُلْتُ : هو مريضٌ فما يمنَعُكَ أنْ تعُودَه ؟ قال : فانطلِقْ بنا إليه فانطلَق وانطلَقْتُ معه فسأَله عن شكواه ثمَّ سأَله عنِ الحديثِ قال : فخرَج ابنُ عُمَرَ وهو يُقلِّبُ كفَّه وهو يقولُ : ما كان ابنُ أمِّ عبدٍ يكذِبُ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّم"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (50) بلفظ مقارب","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"DswT1hKk","merged":3,"otherRefs":["صحيح ابن حبان 6193 (صحيح)","صحيح الجامع 5790 (صحيح)"]},{"id":"س-01723","fp":"657ee5a438e1","stateId":125,"easy":"إذا جاهدت المنكر بيدك ← فأنت مؤمن","cause":"فمَن جاهَدهم بيدِه","result":"فهو مُؤمِنٌ","explicit":true,"repOf":"س-07429","ref":"صحيح ابن حبان 6193","text":["ما كان مِن نبيٍّ إلَّا كان له حَواريُّونَ يَهدونَ بهَدْيِه ويستنُّونَ بسنَّتِه ثمَّ يكونُ مِن بعدِهم أقوامٌ يقولونَ ما لا يفعَلونَ ويفعَلونَ ما يُنكِرونَ ",["فمَن جاهَدهم بيدِه",1]," ",["فهو مُؤمِنٌ",2]," ومَن جاهَدهم بلسانِه فهو مُؤمِنٌ ومَن جاهَدهم بقلبِه فهو مُؤمِنٌ ليس وراءَ ذلك مِن الإيمانِ مِثقالُ حبَّةٍ مِن خَردلٍ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (50) مطولاً باختلاف يسير","bab":"أنبياء › عام","dorar":"t0H9Y4oK"},{"id":"س-01724","fp":"65664c7b0aac","stateId":125,"easy":"إذا جاهدت المنكر بقلبك ← فأنت مؤمن، وليس وراء ذلك من الإيمان شيء","cause":"ومَن جاهَدهم بقلبِه","result":"فهو مُؤمِنٌ ليس وراءَ ذلك مِن الإيمانِ مِثقالُ حبَّةٍ مِن خَردلٍ","explicit":true,"ref":"صحيح ابن حبان 6193","srcLabel":"مسلم","text":["ما كان مِن نبيٍّ إلَّا كان له حَواريُّونَ يَهدونَ بهَدْيِه ويستنُّونَ بسنَّتِه ثمَّ يكونُ مِن بعدِهم أقوامٌ يقولونَ ما لا يفعَلونَ ويفعَلونَ ما يُنكِرونَ فمَن جاهَدهم بيدِه فهو مُؤمِنٌ ومَن جاهَدهم بلسانِه فهو مُؤمِنٌ ",["ومَن جاهَدهم بقلبِه ",1],["فهو مُؤمِنٌ ليس وراءَ ذلك مِن الإيمانِ مِثقالُ حبَّةٍ مِن خَردلٍ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (50) مطولاً باختلاف يسير","bab":"أنبياء › عام","dorar":"t0H9Y4oK"},{"id":"س-07362","fp":"b7c90891937b","stateId":125,"easy":"إذا أمرت بالمعروف ونهيت عن المنكر ← يستجيب الله دعاءك وينصرك","cause":"مُرُوا بالمعروفِ وانهَوْا عن المنكَرِ","result":"قبْلَ أنْ تدعوني فلا أجيبَكم وتسألوني فلا أُعطيَكم وتستنصروني فلا أنصرَكم","explicit":true,"otherNeedIds":[29],"ref":"صحيح ابن حبان 290","srcLabel":"أحمد","text":["دخَل علَيَّ النَّبيُّ صلَّى اللهُ عليه وسلَّم فعرَفْتُ في وجهِه أنْ قد حضَره شيءٌ فتوضَّأ وما كلَّم أحدًا ثمَّ خرَج فلصِقْتُ بالحجرةِ أسمَعُ ما يقولُ فقعَد على المنبرِ فحمِد اللهَ وأثنى عليه ثمَّ قال: ( يا أيُّها النَّاسُ إنَّ اللهَ تبارَك تعالى يقولُ لكم: ",["مُرُوا بالمعروفِ وانهَوْا عن المنكَرِ",1]," ",["قبْلَ أنْ تدعوني فلا أجيبَكم وتسألوني فلا أُعطيَكم وتستنصروني فلا أنصرَكم",2]," ) فما زاد عليهم حتَّى نزَل"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الطبراني في ((الأوسط)) (6665)، وابن أبي الدنيا في ((الأمر بالمعروف)) (7) باختلاف يسير، وأحمد (25255) بنحوه.","bab":"فضائل النبي وصفته ودلائل النبوة › أحوال النبي","dorar":"uiTotDJA","merged":2,"otherRefs":["تخريج المسند لشعيب 25255 (حسن)"]},{"id":"س-07011","fp":"424ef62d517b","stateId":125,"easy":"إذا رأيت منكراً فلم تستطع إلا الإنكار بقلبك ← فذلك أضعف الإيمان","cause":"فبقَلْبِه","result":"وذلك أَضعَفُ الإيمانِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشعيب 11073","srcLabel":"مسلم","text":["أَخرَج مَرْوانُ المِنبَرَ في يومِ عيدٍ، ولم يكُنْ يَخرُجْ به، وبدَأ بالخُطبةِ قبْلَ الصلاةِ، ولم يكُنْ يَبدَأُ بها، قال: فقام رجُلٌ فقال: يا مَرْوانُ، خالَفْتَ السُّنَّةَ، أَخرَجْتَ المِنبَرَ في  يومِ عيدٍ، ولم يَكُ يُخرَجُ به في يومِ عيدٍ، وبدَأْتَ بالخُطبةِ قبْلَ الصلاةِ، ولم يكُنْ يُبدَأُ بها، قال: فقال أبو سعيدٍ الخُدْريُّ: مَن هذا؟ قالوا: فُلانُ بنُ فُلانٍ، قال: فقال أبو سعيدٍ: أمَّا هذا، فقد قَضى ما عليه، سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: \"مَن رأَى منكم مُنكَرًا فإنِ اسْتَطاع أنْ يُغيِّرَه بيَدِه فلْيَفعَلْ\"، وقال مرَّةً: \"فلْيُغيِّرْه بيَدِه، فإنْ لم يَستَطِعْ بيَدِه فبلِسانِه، فإنْ لم يَستَطِعْ بلِسانِه ",["فبقَلْبِه",1],"، ",["وذلك أَضعَفُ الإيمانِ",2],"\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (49)، وأبو داود (1140)، والترمذي (2172)، والنسائي (5009)، وابن ماجه (1275)، وأحمد (11073) واللفظ له","bab":"علم › الحث على الأخذ بالسنة","dorar":"64qbFomQ","merged":3,"otherRefs":["صحيح مسلم 49 (صحيح)","تخريج صحيح ابن حبان 306 (صحيح)"]},{"id":"س-02482","fp":"84415329ae10","stateId":125,"easy":"إذا جاهدت المنكر بلسانك أو قلبك ← فأنت مؤمن","cause":"فمَن جاهَدَهم بلسانِه","result":"فهو مؤمنٌ ومَن جاهَدَهم بقلبِه فهو مؤمنٌ لا إيمانَ بعدَه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-07429","ref":"إتحاف الخيرة المهرة 8/44","text":["إنه سيكونُ عليكم بعدي أمراءُ: يقولونَ ما لا يفعلونَ  ويفعلونَ ما لا يؤمَرونَ  ",["فمَن جاهَدَهم بلسانِه",1]," ",["فهو مؤمنٌ  ومَن جاهَدَهم بقلبِه فهو مؤمنٌ  لا إيمانَ بعدَه",2]," فحدَّثتُ بذلك ابنَ عُمرَ  فقال لي: أنت سمِعتَه منَ ابنِ مسعودٍ ؟ فقلتُ: نعَم  وهو شاكي فما يمنعُكَ أن تعودَه ؟ فانطلَقْنا فدخَلْنا عليه فسأله ابنُ عُمرَ عن شكواه  ثم قال: حديثًا حدَّثنا هذا عنكَ  فقال ابنُ مسعودٍ: نعَم  فحدَّثتُه به فلما خرَجْنا  قال لي ابنُ عُمرَ: ما كان ابنُ أمِّ عبدٍ ليكذبَ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّم"],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"رواته ثقات","takhrij":"أخرجه مسدد كما في ((إتحاف الخيرة المهرة)) للبوصيري (8/44) واللفظ له، وأخرجه مسلم (50) بلفظ مقارب","bab":"إمامة وخلافة › الإنكار على الأمراء فيما خالفوا الشرع فيه","dorar":"szfihIW0"}]}