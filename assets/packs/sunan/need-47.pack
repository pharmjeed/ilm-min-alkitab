{"schema":1,"kind":"sunan-chunk","version":"sunan-3f5fd6b9930a","needId":47,"stateIds":[475,476,477,478,479,480,481,482,483,484,485,486,487,488,489,490,491,492,493,494,495,496,497,498,499,500,501,502],"items":[{"id":"ق-0450","fp":"55a53a406520","stateId":475,"easy":"وجل القلب عند ذكر الله والتوكل وإقامة الصلاة والإنفاق ← الإيمان الحق ودرجات عند الله ومغفرة ورزق كريم","cause":"وجل القلب عند ذكر الله والتوكل وإقامة الصلاة والإنفاق","result":"الإيمان الحق ودرجات عند الله ومغفرة ورزق كريم","explicit":true,"star":true,"otherNeedIds":[11,1],"ref":"سورة الأنفال: 2–4","srcLabel":"القرآن الكريم","quran":{"s":8,"from":2,"to":4,"text":"إِنَّمَا الْمُؤْمِنُونَ الَّذِينَ إِذَا ذُكِرَ اللَّهُ وَجِلَتْ قُلُوبُهُمْ وَإِذَا تُلِيَتْ عَلَيْهِمْ آيَاتُهُ زَادَتْهُمْ إِيمَانًا وَعَلَى رَبِّهِمْ يَتَوَكَّلُونَ (2) الَّذِينَ يُقِيمُونَ الصَّلَاةَ وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ (3) أُولَئِكَ هُمُ الْمُؤْمِنُونَ حَقًّا لَهُمْ دَرَجَاتٌ عِنْدَ رَبِّهِمْ وَمَغْفِرَةٌ وَرِزْقٌ كَرِيمٌ (4)","hl":[[0,343,1]]}},{"id":"ق-0770","fp":"af9f3205ea4b","stateId":475,"easy":"إتيان الله مؤمناً قد عمل الصالحات (التزكّي) ← الدرجات العلى وجنات عدن","cause":"إتيان الله مؤمناً قد عمل الصالحات (التزكّي)","result":"الدرجات العلى وجنات عدن","explicit":true,"star":true,"otherNeedIds":[68],"ref":"سورة طه: 75–76","srcLabel":"القرآن الكريم","quran":{"s":20,"from":75,"to":76,"text":"وَمَنْ يَأْتِهِ مُؤْمِنًا قَدْ عَمِلَ الصَّالِحَاتِ فَأُولَئِكَ لَهُمُ الدَّرَجَاتُ الْعُلَى (75) جَنَّاتُ عَدْنٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا وَذَلِكَ جَزَاءُ مَنْ تَزَكَّى (76)","hl":[[0,198,1]]}},{"id":"ق-1302","fp":"dc4b4af196fb","stateId":475,"easy":"الإيمان بالله ورسله ← منزلة الصدّيقين والشهداء والأجر والنور","cause":"الإيمان بالله ورسله","result":"منزلة الصدّيقين والشهداء والأجر والنور","explicit":true,"otherNeedIds":[65],"ref":"سورة الحديد: 19","srcLabel":"القرآن الكريم","quran":{"s":57,"from":19,"to":19,"text":"وَالَّذِينَ آمَنُوا بِاللَّهِ وَرُسُلِهِ أُولَئِكَ هُمُ الصِّدِّيقُونَ وَالشُّهَدَاءُ عِنْدَ رَبِّهِمْ لَهُمْ أَجْرُهُمْ وَنُورُهُمْ وَالَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا أُولَئِكَ أَصْحَابُ الْجَحِيمِ (19)","hl":[[0,132,1]]}},{"id":"س-03196","fp":"66c869c02042","stateId":475,"easy":"إذا آمنت بالنبي ﷺ ولم تره وآمنت بما في الكتاب ← تكون من أعظم الخلق منزلة عند الله","cause":"قومٌ يأتونَ بعدَكم يُؤمِنونَ بي ولم يرَوْني يجِدونَ الوَرَقَ المُعلَّقَ فيُؤمِنونَ به","result":"أولئك أعظمُ الخلقِ عندَ اللهِ منزلةً أو أعظمُ الخلقِ إيمانًا عندَ اللهِ يومَ القيامةِ","explicit":true,"ref":"مجمع الزوائد 10/68","srcLabel":"الحاكم","text":["أخبِروني بأعظمِ الخلقِ عندَ اللهِ منزلةً يومَ القيامةِ قالوا الملائكةُ قال وما يمنَعُهم مع قربِهم من ربِّهم بل غيرُهم قالوا الأنبياءُ قال وما يمنَعُهم والوحيُ ينزِلُ عليهم بل غيرُهم قالوا فأخبِرْنا يا رسولَ اللهِ قال ",["قومٌ يأتونَ بعدَكم يُؤمِنونَ بي ولم يرَوْني يجِدونَ الوَرَقَ المُعلَّقَ فيُؤمِنونَ به",1]," ",["أولئك أعظمُ الخلقِ عندَ اللهِ منزلةً أو أعظمُ الخلقِ إيمانًا عندَ اللهِ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"أحد إسنادي البزار المرفوع حسن المنهال بن بحر وثقه أبو حاتم وفيه خلاف وبقية رجاله رجال الصحيح","takhrij":"أخرجه البزار (289) واللفظ له، والحاكم (6993)، وأبو يعلى (160) بنحوه.","bab":"إيمان › فضل الإيمان","dorar":"3lw5WBJd"},{"id":"س-00878","fp":"92b1bdc66947","stateId":476,"easy":"إذا كبّرت أربعاً وثلاثين وسبّحت وحمدت ثلاثاً وثلاثين عند نومك ← فهو خير لك من خادم","cause":"إذا أخَذتُما مَضاجِعَكُما أن تُكَبِّرا اللهَ أربَعًا وثَلاثينَ، وتُسَبِّحاه ثَلاثًا وثَلاثينَ، وتَحمَداه ثَلاثًا وثَلاثينَ","result":"فهو خَيرٌ لَكُما مِن خادِمٍ","explicit":true,"star":true,"apply":{"k":"count","t":"أربعاً وثلاثين"},"similar":["س-00741","س-01011","س-01037"],"otherNeedIds":[55,16],"ref":"صحيح مسلم 2727","srcLabel":"البخاري","text":["أنَّ فاطِمةَ اشتَكَت ما تَلقى مِنَ الرَّحى في يَدِها، وأتى النَّبيَّ صلَّى اللهُ عليه وسلَّم سَبيٌ، فانطَلَقَت، فلم تَجِدْه، ولَقيَت عائِشةَ، فأخبَرَتها فلَمَّا جاءَ النَّبيُّ صلَّى اللهُ عليه وسلَّم أخبَرَتْه عائِشةُ بمَجيءِ فاطِمةَ إليها، فجاءَ النَّبيُّ صلَّى اللهُ عليه وسلَّم إلينا، وقد أخَذنا مَضاجِعَنا، فذَهَبنا نَقومُ فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: على مَكانِكُما، فقَعَدَ بينَنا حتَّى وجَدتُ بَردَ قدَمِه على صَدري، ثُمَّ قال: ألا أُعَلِّمُكُما خَيرًا ممَّا سَألتُما، ",["إذا أخَذتُما مَضاجِعَكُما أن تُكَبِّرا اللهَ أربَعًا وثَلاثينَ، وتُسَبِّحاه ثَلاثًا وثَلاثينَ، وتَحمَداه ثَلاثًا وثَلاثينَ",1],"؛ ",["فهو خَيرٌ لَكُما مِن خادِمٍ",2],". وفي حَديثِ مُعاذٍ: أخَذتُما مَضجَعَكُما مِنَ اللَّيلِ. وزادَ في الحَديثِ قال عَليٌّ: ما تَرَكتُه مُنذُ سَمِعتُه مِنَ النَّبيِّ صلَّى اللهُ عليه وسلَّم، قيلَ له: ولا لَيلةَ صِفِّينَ؟ قال: ولا لَيلةَ صِفِّينَ. وفي حَديثِ عَطاءٍ، عن مُجاهِدٍ، عَنِ ابنِ أبي لَيلى، قال: قُلتُ له: ولا لَيلةَ صِفِّينَ."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3113)، وأحمد (1141)، وابن حبان (5524) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"3WMfBHOl","merged":11,"otherRefs":["صحيح الجامع 2619 (صحيح)","تخريج صحيح ابن حبان 5524 (صحيح)","صحيح البخاري 3113 (صحيح)","صحيح البخاري 3705 (صحيح)","حلية الأولياء 4/393 (صحيح)","صحيح البخاري 6318 (صحيح)","تخريج المسند لشعيب 740 (صحيح)","صحيح البخاري 5361 (صحيح)","تخريج المسند لشاكر 2/214 (صحيح)","نخب الافكار 12/285 (صحيح)"]},{"id":"س-01022","fp":"9bc87a230261","stateId":476,"easy":"إذا سبّحت وكبّرت وحمدت دبر كل صلاة ثلاثاً وثلاثين ← تدرك من سبقك وتسبق من بعدك","cause":"تُسَبِّحونَ، وتُكَبِّرونَ، وتَحمَدونَ، دُبُرَ كُلِّ صَلاةٍ ثَلاثًا وثَلاثينَ مَرَّةً","result":"تُدرِكونَ به مَن سَبَقَكُم وتَسبِقونَ به مَن بَعدَكُم، ولا يَكونُ أحَدٌ أفضَلَ مِنكُم إلَّا مَن صَنَعَ مِثلَ ما صَنَعتُم","explicit":true,"star":true,"apply":{"k":"count","t":"ثلاثاً وثلاثين · الوقت: دبر كل صلاة"},"similar":["س-06413","س-07173"],"ref":"صحيح مسلم 595","srcLabel":"البخاري","text":["أنَّ فُقَراءَ المُهاجِرينَ أتَوا رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فقالوا: ذَهَبَ أهلُ الدُّثورِ بالدَّرَجاتِ العُلى، والنَّعيمِ المُقيمِ، فقال: وما ذاكَ؟ قالوا: يُصَلُّونَ كما نُصَلِّي، ويَصومونَ كما نَصومُ، ويَتَصَدَّقونَ ولا نَتَصَدَّقُ، ويُعتِقونَ ولا نُعتِقُ، فقال رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم: أفلا أُعَلِّمُكُم شيئًا ",["تُدرِكونَ به مَن سَبَقَكُم وتَسبِقونَ به مَن بَعدَكُم، ولا يَكونُ أحَدٌ أفضَلَ مِنكُم إلَّا مَن صَنَعَ مِثلَ ما صَنَعتُم",2],"؟ قالوا: بَلى، يا رَسولُ اللهِ، قال: ",["تُسَبِّحونَ، وتُكَبِّرونَ، وتَحمَدونَ، دُبُرَ كُلِّ صَلاةٍ ثَلاثًا وثَلاثينَ مَرَّةً",1],". قال أبو صالِحٍ: فرَجَعَ فُقَراءُ المُهاجِرينَ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقالوا: سَمِعَ إخوانُنا أهلُ الأموالِ بما فعَلنا، ففَعَلوا مِثلَه، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ذلك فضلُ اللهِ يُؤتيه مَن يَشاءُ. وزادَ غَيرُ قُتَيبةَ في هذا الحَديثِ عَنِ اللَّيثِ، عَنِ ابنِ عَجلانَ، قال سُمَيٌّ: فحَدَّثتُ بَعضَ أهلي هذا الحَديثَ، فقال: وهِمتَ، إنَّما قال: تُسَبِّحُ اللَّهَ ثَلاثًا وثَلاثينَ، وتَحمَدُ اللَّهَ ثَلاثًا وثَلاثينَ، وتُكَبِّرُ اللَّهَ ثَلاثًا وثَلاثينَ، فرَجَعتُ إلى أبي صالِحٍ فقُلتُ له ذلك، فأخَذَ بيَدي فقال: اللهُ أكبَرُ، وسُبحانَ اللهِ، والحَمدُ للَّهِ، اللهُ أكبَرُ، وسُبحانَ اللهِ، والحَمدُ للَّهِ، حتَّى تَبلُغَ مِن جَميعِهنَّ ثَلاثةً وثَلاثينَ. [وفي روايةٍ]: ذَهَبَ أهلُ الدُّثورِ بالدَّرَجاتِ العُلى، والنَّعيمِ المُقيمِ،... بمِثلِ حَديثِ قُتَيبةَ، عَنِ اللَّيثِ، إلَّا أنَّه أدرَجَ في حَديثِ أبي هُرَيرةَ قَولَ أبي صالِحٍ، ثُمَّ رَجَعَ فُقَراءُ المُهاجِرينَ إلى آخِرِ الحَديثِ. [وفي روايةٍ]: وزادَ في الحَديثِ: يقولُ سُهَيلٌ: إحدى عَشرةَ، إحدى عَشرةَ، فجَميعُ ذلك كُلِّه ثَلاثةٌ وثَلاثونَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (843) مختصراً باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"A4dC6rPH","merged":7,"otherRefs":["صحيح الجامع 217 (صحيح)","تخريج المسند لشعيب 21411 (صحيح)","تخريج الإحياء للعراقي 1/398 (حسن)","صحيح ابن ماجه 764 (صحيح)","البحر الزخار 15/366 (حسن)","تخريج شرح السنة 719 (حسن)"]},{"id":"س-00979","fp":"88d35bed4eba","stateId":476,"easy":"إذا أكثرت ذكر الله ← تكون من المفرّدين السابقين","cause":"الذَّاكِرون اللهَ كثيرًا","result":"سبَقَ المُفَرِّدونَ","explicit":true,"star":true,"similar":["س-01109"],"ref":"تخريج المسند لشعيب 9332","srcLabel":"متفق عليه","text":["كان النَّبيُّ صلَّى اللهُ عليه وسلَّمَ يَسيرُ في طَريقِ مكةَ، فأتى على جُمدانَ، فقال: هذا جُمدانُ، سيروا، ",["سبَقَ المُفَرِّدونَ",2],". قالوا: وما المُفَرِّدونَ؟ قال: ",["الذَّاكِرون اللهَ كثيرًا",1],". ثم قال: اللَّهمَّ اغْفِرْ للمُحَلِّقينَ. قالوا: والمُقَصِّرينَ؟ قال: اللَّهمَّ اغْفِرْ للمُحَلِّقينَ. قالوا: والمُقَصِّرينَ؟ قال: والمُقَصِّرينَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1728) مختصراً، ومسلم (1302، 2676) مفرقاً باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"KxJyYBF0","merged":2,"otherRefs":["تخريج صحيح ابن حبان 858 (صحيح)"]},{"id":"س-06413","fp":"b8d27528f0ec","stateId":476,"easy":"إذا سبّحت وحمدت وكبّرت خلف كل صلاة ثلاثاً وثلاثين ← تدرك من سبقك ولا يدركك من بعدك","cause":"تُسَبِّحونَ وتَحمَدونَ وتُكَبِّرونَ خَلفَ كُلِّ صَلاةٍ ثَلاثًا وثَلاثينَ","result":"أدرَكتُم مَن سَبَقَكُم، ولم يُدرِكْكُم أحَدٌ بَعدَكُم، وكُنتُم خَيرَ مَن أنتُم بينَ ظَهرانَيه إلَّا مَن عَمِلَ مِثلَه","explicit":true,"apply":{"k":"count","t":"ثلاثاً وثلاثين"},"repOf":"س-01022","otherNeedIds":[49],"ref":"صحيح البخاري 843","text":["جاءَ الفُقَراءُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم، فقالوا: ذَهَبَ أهلُ الدُّثورِ مِنَ الأموالِ بالدَّرَجاتِ العُلا، والنَّعيمِ المُقيمِ؛ يُصَلُّونَ كما نُصَلِّي، ويَصومونَ كما نَصومُ، ولَهم فضلٌ مِن أموالٍ يَحُجُّونَ بها، ويَعتَمِرونَ، ويُجاهِدونَ، ويَتَصَدَّقونَ، قال: ألا أُحَدِّثُكُم إن أخَذتُم ",["أدرَكتُم مَن سَبَقَكُم، ولم يُدرِكْكُم أحَدٌ بَعدَكُم، وكُنتُم خَيرَ مَن أنتُم بينَ ظَهرانَيه إلَّا مَن عَمِلَ مِثلَه",2],"؟ ",["تُسَبِّحونَ وتَحمَدونَ وتُكَبِّرونَ خَلفَ كُلِّ صَلاةٍ ثَلاثًا وثَلاثينَ",1],"، فاختَلَفنا بينَنا، فقال بَعضُنا: نُسَبِّحُ ثَلاثًا وثَلاثينَ، ونَحمَدُ ثَلاثًا وثَلاثينَ، ونُكَبِّرُ أربَعًا وثَلاثينَ، فرَجَعتُ إليه، فقال: تَقولُ: سُبحانَ اللهِ، والحَمدُ للَّهِ، واللهُ أكبَرُ، حتَّى يَكونَ منهنَّ كُلِّهنَّ ثَلاثًا وثَلاثينَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (843)، ومسلم (595)","bab":"صلاة › أدعية دبر الصلوات","dorar":"mmlTPFRh","merged":2,"otherRefs":["صحيح ابن خزيمة 1/ 729 (صحيح)"]},{"id":"س-00860","fp":"6c0619b8506c","stateId":476,"easy":"إذا سبّحت مئة دبر كل صلاة ← تدرك من سبقك ولا يلحقك من بعدك","cause":"التَّسبيحَ المائةَ في دبرِ كلِّ صلاةٍ","result":"أدرَكتُم بِهِ من سبقَكم ولم يَلحقْكُم مَن بعدَكم","explicit":true,"star":true,"apply":{"k":"time","t":"دبر كل صلاة"},"otherNeedIds":[49],"ref":"مجموع الفتاوى 11/127","srcLabel":"مسلم","text":["أنَّ الفقراءَ قالوا لَه: يا رسولَ اللَّهِ ذَهبَ أَهلُ الدُّثورِ بالأجورِ. يصلُّونَ كما نصلِّي ويصومونَ كما نصومُ ولَهم فضولُ أموالٍ يتصدَّقونَ بِها ولا نتصدَّقُ فقال: ألا أعلِّمُكم شيئًا؟ إذا فعلتُموهُ ",["أدرَكتُم بِهِ من سبقَكم ولم يَلحقْكُم مَن بعدَكم",2]," إلَّا من عملَ مثلَ عملِكم فعلَّمَهم ",["التَّسبيحَ المائةَ في دبرِ كلِّ صلاةٍ",1],". فجاءوا إليْهِ فقالوا: إنَّ إخوانَنا من الأغنياءِ سمِعوا ذلِكَ ففعلوهُ فقال: ذلِكَ فضلُ اللَّهِ يؤتيهِ مَن يشاءُ"],"grade":"صحيح","muhaddith":"هذه الزيادة في صحيح مسلم من مراسيل أبي صالح","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"9qpyCmqa"},{"id":"س-00943","fp":"3ae719b35b2d","stateId":476,"easy":"إذا قلت صباحاً ومساءً «سبحان الله العظيم وبحمده» مئة ← لا يوافي أحد من الخلائق بمثل ما وافيت","cause":"مَن قال حينَ يُصبِحُ : سُبحانَ اللهِ العظيمِ وبحَمْدِه مِئةَ مرَّةٍ وإذا أمسى كذلكَ","result":"لَمْ يُوافِ أحَدٌ مِن الخلائقِ بمِثْلِ ما وافى","explicit":true,"apply":{"k":"say","t":"«سبحان الله العظيم وبحمده» · الوقت: صباحاً ومساءً"},"ref":"صحيح ابن حبان 860","srcLabel":"مسلم","text":[["مَن قال حينَ يُصبِحُ : سُبحانَ اللهِ العظيمِ وبحَمْدِه مِئةَ مرَّةٍ وإذا أمسى كذلكَ",1]," ",["لَمْ يُوافِ أحَدٌ مِن الخلائقِ بمِثْلِ ما وافى",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (2692)، والترمذي (3469)، وأحمد (8835)، والنسائي في ((عمل اليوم والليلة)) (568) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"Nq1MctFN"},{"id":"س-01058","fp":"f75a3246c7f2","stateId":476,"easy":"إذا قلت «سبحان الله والحمد لله ولا إله إلا الله والله أكبر» ← فهي من أطيب الكلام","cause":"سُبحانَ اللهِ، والحَمدُ للهِ، ولا إلهَ إلَّا اللهُ، واللهُ أكبرُ","result":"أربعٌ مِن أطيَبِ الكَلامِ","explicit":true,"apply":{"k":"say","t":"«سبحان الله والحمد لله ولا إله إلا الله والله أكبر»"},"ref":"تخريج المسند لشعيب 20126","srcLabel":"مسلم","text":["إذا حَدَّثتُكَ حديثًا، فلا تَزيدَنَّ عليَّ، وقال: ",["أربعٌ مِن أطيَبِ الكَلامِ",2],"، وهنَّ مِن القُرآنِ، لا يَضُرُّكَ بأيِّهنَّ بَدَأتَ: ",["سُبحانَ اللهِ، والحَمدُ للهِ، ولا إلهَ إلَّا اللهُ، واللهُ أكبرُ",1],"، ثم قال: لا تُسمِّيَنَّ غُلامَكَ أفلحَ، ولا نَجِيحًا، ولا رَباحًا، ولا يَسارًا."],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"إسناده صحيح إن كان هلال بن يساف سمعه من سمرة، وسماعه منه  محتمل جدا","takhrij":"أخرجه مسلم (2137) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"Apn2Vkku"},{"id":"س-01078","fp":"1c735927377f","stateId":476,"easy":"إذا جلست في مجالس الذكر ← فهي رياض الجنة","cause":"مَجالسِ الذِّكرِ","result":"رياضِ الجنَّةِ","explicit":true,"otherNeedIds":[67],"ref":"المستدرك على الصحيحين 1844","srcLabel":"الحاكم","text":["خَرَجَ علينا النَّبيُّ صلَّى اللهُ عليه وسلَّمَ، فقالَ: يا أَيُّها النَّاسُ، إنَّ للهِ سَرايا مِنَ الملائكةِ تَحِلُّ وتَقِفُ على ",["مَجالسِ الذِّكرِ",1]," في الأرضِ، فارتَعوا في ",["رياضِ الجنَّةِ",2],"، قالوا: وأين رياضُ الجنَّةِ يا رسولَ اللهِ؟ قالَ: مَجالِسُ الذِّكرِ، فاغْدوا ورُوحوا في ذِكْرِ اللهِ، وذكِّروهُ أنفُسَكم، مَنْ كان يُحِبُّ أنْ يَعلَمَ مَنزِلتَهُ عندَ اللهِ فليَنظُرْ كيف مَنزِلةُ اللهِ عندَهُ؛ فإنَّ اللهَ يُنزِلُ العبدَ منه حيثُ أَنزلَهُ مِن نفسِهِ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح الإسناد","bab":"أدعية وأذكار › فضل الذكر","dorar":"10bUAbx3","merged":4,"otherRefs":["تخريج المسند لشاكر 10/137 (صحيح)","إتحاف الخيرة المهرة 6/382 (حسن)","الكامل في الضعفاء 7/311 (صحيح)"]},{"id":"س-00879","fp":"a1a6a423b16b","stateId":476,"easy":"إذا قلت دبر الصبح «لا إله إلا الله وحده...» ← تكون يومئذ من أفضل أهل الأرض عملاً","cause":"مَن قال دُبَرَ صَلاةِ الغَداةِ: لا إلهَ إلَّا اللهُ وَحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ يُحيي ويُميتُ وهو على كُلِّ شَيءٍ قَديرٌ مِئةَ مَرَّةٍ قَبلَ أنْ يَثنيَ رِجلَيْه","result":"كان يَومَئِذٍ مِن أفضَلِ أهلِ الأرضِ عَمَلًا، إلَّا مَن قال مِثلَ ما قال، أو زادَ على ما قال","explicit":true,"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ وَحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ يُحيي ويُميتُ وهو على كُلِّ شَيءٍ قَدير»"},"ref":"الترغيب والترهيب 1/225","srcLabel":"الطبراني","text":[["مَن قال دُبَرَ صَلاةِ الغَداةِ: لا إلهَ إلَّا اللهُ وَحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ يُحيي ويُميتُ وهو على كُلِّ شَيءٍ قَديرٌ مِئةَ مَرَّةٍ قَبلَ أنْ يَثنيَ رِجلَيْه",1]," ",["كان يَومَئِذٍ مِن أفضَلِ أهلِ الأرضِ عَمَلًا، إلَّا مَن قال مِثلَ ما قال، أو زادَ على ما قال",2],". [وفي لَفظٍ:] مَن قال بَعدَ صَلاةِ الصُّبحِ وهو ثانٍ رِجلَيْه قَبلَ أنْ يَتكَلَّمَ: لا إلهَ إلَّا اللهُ وَحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ يُحيي ويُميتُ، بيَدِه الخَيرُ وهو على كُلِّ شَيءٍ قَديرٌ عَشْرَ مَرَّاتٍ كَتَبَ اللهُ له بكُلِّ مَرَّةٍ عَشْرَ حَسَناتٍ، ومَحا عنه عَشْرَ سَيِّئاتٍ، ورَفَعَ له عَشْرَ دَرَجاتٍ، وكُنَّ له في يَومِه ذلك حِرزًا مِن كُلِّ مَكروهٍ، وحَرَسًا مِنَ الشَّيطانِ الرَّجيمِ، وكان له بكُلِّ مَرَّةٍ عِتقُ رَقَبةٍ مِن وَلَدِ إسْماعيلَ، ثَمَنُ كُلِّ رَقَبةٍ اثْنا عَشَرَ ألْفًا، ولم يَلحَقْه يَومَئِذٍ ذَنبٌ إلَّا الشِّركَ باللهِ، ومَن قال ذلك بَعدَ صَلاةِ المَغرِبِ كان له مِثلُ ذلك."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (7200)، وابن السني في ((عمل اليوم والليلة)) (142) باختلاف يسير. والرواية أخرجه الطبراني في ((مسند الشاميين)) (23) واللفظ له، وابن عساكر في ((تاريخ دمشق)) (38/100) من حديث أبي الدرداء رضي الله عنه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"qKcJf4m7"},{"id":"س-00882","fp":"7a1d078935a1","stateId":476,"easy":"إذا رُزقت لساناً ذاكراً وقلباً شاكراً وزوجة مؤمنة ← فهو أفضل ما تقتني","cause":"لسانٌ ذاكرٌ وقلبٌ شاكرٌ وزوجةٌ مؤمنةٌ تُعينُه على إيمانِه","result":"أفضلُه","explicit":true,"similar":["س-00894"],"otherNeedIds":[55],"ref":"الترغيب والترهيب 2/328","srcLabel":"الترمذي","text":["لمَّا نزلت {وَالَّذِينَ يَكْنِزُونَ الذَّهَبَ وَالْفِضَّةَ وَلَا يُنْفِقُونَهَا فِي سَبِيلِ اللَّهِ فَبَشِّرْهُمْ بِعَذَابٍ أَلِيمٍ } قال كنَّا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّم في بعضِ أسفارِه فقال بعضُ أصحابِه أُنزِلتْ في الذَّهبِ والفضَّةِ لو علمنا أيَّ المالِ خيرٌ فنتَّخِذَه فقال ",["أفضلُه",2]," ",["لسانٌ ذاكرٌ وقلبٌ شاكرٌ وزوجةٌ مؤمنةٌ تُعينُه على إيمانِه",1]],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (3094) بلفظه، وابن ماجه (1856)، وأحمد (22392) كلاهما بلفظ مقارب.","bab":"أدعية وأذكار › فضل الذكر","dorar":"TA3zfuXa"},{"id":"س-01109","fp":"42c6e335b29a","stateId":476,"easy":"إذا لهجت بذكر الله ← تكون من المفرّدين السابقين","cause":"الذين يهتِرون بذكرِ اللهِ","result":"سبقَ المُفرِّدونَ","explicit":true,"repOf":"س-00979","otherNeedIds":[11,65],"ref":"ذخيرة الحفاظ 3/1481","text":["سِيروا ",["سبقَ المُفرِّدونَ",2]," ، قالوا : يا رسولَ اللهِ وما المُفرِّدونَ ؟ قال : ",["الذين يهتِرون بذكرِ اللهِ",1]," يضعُ الذكرُ عنهم أوزارَهم أو خطاياهم فيأتون يومَ القيامةِ خِفافًا"],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح من [ طريق آخر ]","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (5/15) واللفظ له، وابن شاهين في ((الترغيب في فضائل الأعمال)) (169)","bab":"أدعية وأذكار › فضل الذكر","dorar":"oTtR7oJi"},{"id":"س-01116","fp":"922e7283ad40","stateId":476,"easy":"إذا قلت صباحاً «لا إله إلا الله وحده...» ← تُرفع لك عشر درجات وتعدل عتق أربع رقاب","cause":"مَن قالَ إذا أصبحَ لا إلَهَ إلَّا اللَّهُ وحدَهُ لا شريكَ لَهُ ، لَهُ الملكُ ولَهُ الحمدُ ، وَهوَ على كلِّ شيءٍ قديرٌ عشرَ مرَّاتٍ كَتب اللَّه بِهِنَّ عشرُ حسَناتٍ ، ومحا بِهِنَّ عشرُ سيِّئاتٍ","result":"ورفع له بِهنَّ عشرَ درجاتٍ وَكُنَّ لَهُ عِدلَ عتاقةِ أربعِ رقابٍ وَكُنَّ لَهُ حرسًا حتَّى يُمسيَ ومن قالَهُنَّ إذا صلَّى المغربَ دُبُرَ صلاتِهِ فمِثلُ ذلكَ حتَّى يُصبحَ","explicit":true,"apply":{"k":"say","t":"«لا إلَهَ إلَّا اللَّهُ وحدَهُ لا شريكَ لَهُ ، لَهُ الملكُ ولَهُ الحمدُ ، وَهوَ على كلِّ شيءٍ قدير» · الوقت: في الصباح"},"otherNeedIds":[49],"ref":"الترغيب والترهيب 1/224","srcLabel":"الترمذي","text":[["مَن قالَ إذا أصبحَ لا إلَهَ إلَّا اللَّهُ وحدَهُ لا شريكَ لَهُ ، لَهُ الملكُ ولَهُ الحمدُ ، وَهوَ على كلِّ شيءٍ قديرٌ عشرَ مرَّاتٍ كَتب اللَّه بِهِنَّ عشرُ حسَناتٍ ، ومحا بِهِنَّ عشرُ سيِّئاتٍ ",1],["ورفع له بِهنَّ عشرَ درجاتٍ وَكُنَّ لَهُ عِدلَ عتاقةِ أربعِ رقابٍ وَكُنَّ لَهُ حرسًا حتَّى يُمسيَ ومن قالَهُنَّ إذا صلَّى المغربَ دُبُرَ صلاتِهِ فمِثلُ ذلكَ حتَّى يُصبحَ",2]," وفي روايةٍ لهُ وكُنَّ لهُ عِدلَ عشرِ رقابٍ"],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (3553)، والنسائي في ((الكبرى)) (9861)، والطحاوي في ((مشكل الآثار)) (3906) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"NXJZaOQ5"},{"id":"س-01248","fp":"616a529eeb22","stateId":476,"easy":"إذا أكثرت من «لا حول ولا قوة إلا بالله» ← فهي كنز من تحت العرش","cause":"أُكثِرَ من قولِ: لا حَولَ ولا قُوَّةَ إلَّا باللهِ","result":"فإنَّهُنَّ من كَنزٍ تحتَ العَرشِ","explicit":true,"apply":{"k":"say","t":"«لا حول ولا قوة إلا بالله»"},"ref":"تخريج المسند لشعيب 21415","srcLabel":"أحمد","text":["أمَرَني خَليلي صلَّى اللهُ عليه وسلَّمَ بسَبعٍ: أمَرَني بحُبِّ المَساكينِ، والدُّنُوِّ منهم، وأمَرَني أنْ أنظُرَ إلى مَن هو دوني، ولا أنظُرَ إلى مَن هو فَوْقي، وأمَرَني أنْ أصِلَ الرحِمَ وإنْ أدبَرَتْ، وأمَرَني ألَّا أسأَلَ أحَدًا شيئًا، وأمَرَني أنْ أقولَ بالحقِّ، وإنْ كان مُرًّا، وأمَرَني ألَّا أخافَ في اللهِ لَومةَ لائمٍ، وأمَرَني أنْ ",["أُكثِرَ من قولِ: لا حَولَ ولا قُوَّةَ إلَّا باللهِ",1],"؛ ",["فإنَّهُنَّ من كَنزٍ تحتَ العَرشِ",2],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (21415) واللفظ له، والحارث في ((المسند)) (467)، وابن حبان (449)","bab":"أدعية وأذكار › فضل لا حول ولا قوة إلا بالله","dorar":"M7B7Svcb"},{"id":"س-01210","fp":"a50e16921862","stateId":476,"easy":"إذا كبّرت الله مئة بالغداة ومئة بالعشي ← لا يأتي أحد يومئذ بأكثر مما أتيت إلا من زاد","cause":"ومن كَبَّرَ اللهَ مائةً بالغداةِ ، ومائةً بالعشيِّ","result":"لم يأتِ في ذلك اليومِ أَحَدٌ بأكثرَ ممَّا أَتَى بهِ إلَّا من قال مثلَ ما قال ، أو زاد على ما قال","explicit":true,"ref":"سنن الترمذي 3471","srcLabel":"أبو الفضل","text":["من سبحَ اللهَ مائةً بالغداةِ ، ومائةً بالعشيِّ ، كان كمن حجَّ مائةَ حجةٍ ، ومن حمد اللهَ مائةً بالغداةِ ، ومائةً بالعشيِّ ، كان كمن حمل على مائةِ فرسٍ في سبيلِ اللهِ – أو قال - : غزا مائةَ غزوةٍ . ومن هلَّلَ اللهَ مائةً بالغداةِ ، ومائةً بالعشيِّ ، كان كمن أعتقَ مائةَ رقبةٍ من ولدِ إسماعيلَ . ",["ومن كَبَّرَ اللهَ مائةً بالغداةِ ، ومائةً بالعشيِّ",1]," ، ",["لم يأتِ في ذلك اليومِ أَحَدٌ بأكثرَ ممَّا أَتَى بهِ إلَّا من قال مثلَ ما قال ، أو زاد على ما قال",2]],"grade":"حسن","narrator":"[جد عمرو بن شعيب]","muhaddith":"حسن غريب","takhrij":"أخرجه أبو الفضل البغدادي  في ((حديث الزهري)) (701)","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"dzswlZPl"},{"id":"س-07247","fp":"c8268f2212f2","stateId":476,"easy":"إذا جالست الذاكرين ← فهم من أمر الله النبي ﷺ أن يصبر نفسه معهم","cause":"قومًا يذْكُرون اللهَ","result":"الحمدُ للهِ الذي جعل في أُمَّتي من أَمَرني أنْ أصبِرَ نَفْسِي معهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[26],"ref":"مجمع الزوائد 7/24","srcLabel":"أبو نعيم","text":["نزلَتْ هذِهِ الآيَةُ على النبيِّ صلَّى اللهُ عليه وسلَّم وهو في بعْضِ أبياتِهِ  وَاصْبِرْ نَفْسَكَ مَعَ الَّذِينَ يَدْعُونَ رَبَّهُمْ بِالْغَدَاةِ وَالْعَشِيِّ  خرج يلتمسُ فوجد ",["قومًا يذْكُرون اللهَ",1]," منهم ثائِرُ الرأسِ وحافِ الجلدِ وذو الثوبِ الواحدِ فلما رآهم جلس معهم فقال ",["الحمدُ للهِ الذي جعل في أُمَّتي من أَمَرني أنْ أصبِرَ نَفْسِي معهم",2]],"grade":"صحيح","narrator":"عبدالرحمن بن سهل","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أبو نعيم في ((معرفة الصحابة)) (4617) واللفظ له، والطبري (15/ 238)، وابن كثير (5/ 153) بنحوه.","bab":"علم › فضل مجالس العلم والذكر","dorar":"kv0LNe9S"},{"id":"س-00741","fp":"9e0912d06725","stateId":476,"easy":"إذا سبّحت وحمدت وكبّرت عند النوم (33-33-34) ← فهو خير لك من خادم","cause":"إذا أخَذْتُما مضاجِعَكما تقولانِ ثلاثًا وثلاثينَ وثلاثًا وثلاثينَ وأربعًا وثلاثينَ : تسبيحةً وتحميدةً وتكبيرةً","result":"ما هو خيرٌ لكما مِن خادمٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"عند النوم"},"repOf":"س-00878","otherNeedIds":[55],"ref":"تخريج صحيح ابن حبان 6922","text":["شكَت لي فاطمةُ مِن الطَّحينَ فقُلْتُ : لو أتَيْتِ أباكِ فسأَلْتِيه خادمًا قال : فأتَتِ النَّبيَّ صلَّى اللهُ عليه وسلَّم فلَمْ تُصادِفْه فرجَعَتْ مكانَها فلمَّا جاء أُخبِر فأتانا وعلينا قَطيفةٌ إذا لبِسناها طُولًا خرَجَتْ منها جنوبُنا وإذا لبِسناها عَرْضًا خرَجَتْ منها أقدامُنا ورؤوسُنا قال : ( يا فاطمةُ أُخبِرْتُ أنَّكِ جِئْتِ فهل كانت لكِ حاجةٌ ) ؟ قالت : لا قُلْتُ : بلى شكَتْ إليَّ مِن الطَّحينِ فقُلْتُ : لو أتَيْتِ أباكِ فسأَلْتِيه خادمًا فقال : ( أفلا أدُلُّكما على ",["ما هو خيرٌ لكما مِن خادمٍ",2]," ؟ ",["إذا أخَذْتُما مضاجِعَكما تقولانِ ثلاثًا وثلاثينَ وثلاثًا وثلاثينَ وأربعًا وثلاثينَ : تسبيحةً وتحميدةً وتكبيرةً",1]," )"],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه ابن حبان (6922)، واللفظ له، والبخاري (3705)، ومسلم (2727)، وأبو داود (5062)، بلفظ مقارب.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"ElHA9ke7","merged":2,"otherRefs":["صحيح الترمذي 3408 (صحيح)"]},{"id":"س-08180","fp":"caec9da8ee10","stateId":476,"easy":"إذا اجتمعت مع إخوانك تذكرون الله ← فهي مجالس تتباهى بها الملائكة","cause":"تعالَ نُؤمنْ ساعةً","result":"المجالسَ التي تَتباهى بها الملائكةُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[26],"ref":"إتقان ما يحسن 1/40","srcLabel":"إتقان ما يحسن","text":["كان عبدُ اللهِ بنُ رواحةَ إذا لقيَ الرجلَ مِنْ أصحابِ رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ قال ",["تعالَ نُؤمنْ ساعةً",1]," فقال قال تعالَ نؤمْن ساعةً فقالالرجلٍ فجاءَ إلى النبيِّ صلَّى اللهُ عليهِ وسلَّمَ فقال يا رسولَ اللهِ ألا ترى إلى ابنِ رواحةَ يرغبُ عنْ إيمانِكَ إلى إيمانِ ساعةٍ فقال النبيُّ صلَّى اللهُ عليهِ وسلَّمَ يرحمُ اللهُ ابنَ رواحةَ إنهُ يحبُّ ",["المجالسَ التي تَتباهى بها الملائكةُ",2]],"grade":"حسن","muhaddith":"إسناده حسن","bab":"ملائكة › أعمال الملائكة","dorar":"m5x4kdcJ"},{"id":"س-00894","fp":"c7a244d373f7","stateId":476,"easy":"إذا اتخذت قلباً شاكراً ولساناً ذاكراً وزوجة مؤمنة ← فهو خير ما تتخذ","cause":"قَلبًا شاكرًا، ولِسانًا ذاكرًا وزَوجةً مُؤْمِنَةً تعينُ أحدَكُم علَى أمرِ الآخِرةِ","result":"أيَّ المالِ نتَّخذُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-00882","otherNeedIds":[55],"ref":"صحيح ابن ماجه 1517","text":["يا رسولَ اللَّهِ ",["أيَّ المالِ نتَّخذُ",2]," فَقالَ ليتَّخِذْ أحدُكُم ",["قَلبًا شاكرًا، ولِسانًا ذاكرًا وزَوجةً مُؤْمِنَةً تعينُ أحدَكُم علَى أمرِ الآخِرةِ",1]],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجة (1856) واللفظ له، والترمذي (3094)، وأحمد (22392) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"IX1X7iaz"},{"id":"س-01011","fp":"74744bb985d9","stateId":476,"easy":"إذا كبّرت وسبّحت وحمدت دبر كل صلاة ← فهو خير لكِ من الخادم","cause":"تُكَبِّرنَ اللَّهَ على إثرِ كلِّ صلاةٍ ثلاثًا وثلاثينَ تَكْبيرةً ، وثلاثًا وثلاثينَ تَسبيحةً ، وثلاثًا وثلاثينَ تَحميدةً ، ولا إلَهَ إلَّا اللَّهُ وحدَهُ لا شريكَ لَهُ ، لَهُ الملكُ ولَهُ الحمدُ ، وَهوَ علَى كلِّ شيءٍ قديرٌ","result":"ما هوَ خيرٌ لَكُنَّ من ذلِكَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"دبر كل صلاة"},"repOf":"س-00878","otherNeedIds":[55],"ref":"صحيح أبي داود 2987","text":["أنَّها قالَت : أصابَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ سبيًا ، فذَهَبتُ أَنا وأختي ، وفاطمةُ بنتُ رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ ، فشَكَونا إليهِ ما نحنُ فيهِ ، وسألناهُ أن يأمرَ لَنا بشَيءٍ منَ السَّبيِ ، فقالَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ : سبقَكُنَّ يتامَى بدرٍ ، لَكِن سأدلُّكنَّ على ",["ما هوَ خيرٌ لَكُنَّ من ذلِكَ",2]," : ",["تُكَبِّرنَ اللَّهَ على إثرِ كلِّ صلاةٍ ثلاثًا وثلاثينَ تَكْبيرةً ، وثلاثًا وثلاثينَ تَسبيحةً ، وثلاثًا وثلاثينَ تَحميدةً ، ولا إلَهَ إلَّا اللَّهُ وحدَهُ لا شريكَ لَهُ ، لَهُ الملكُ ولَهُ الحمدُ ، وَهوَ علَى كلِّ شيءٍ قديرٌ",1]],"grade":"صحيح","narrator":"أم الحكم أو ضباعة ابنتا الزبير بن عبدالمطلب","muhaddith":"صحيح","takhrij":"أخرجه أبو داوود (2987)، والطحاوي في ((شرح معاني الآثار)) (5417) واللفظ لهما، وابن الأثير في ((أسد الغابة)) (7/ 319)باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"6CHXTXyx"},{"id":"س-01037","fp":"dec421318e93","stateId":476,"easy":"إذا كبّرت وسبّحت وحمدت دبر كل صلاة عشراً ← فهو خير مما سألت","cause":"كبِّرا في دُبرِ كلِّ صلاةٍ عَشرًا وسبِّحا عَشرًا واحمَدا عَشرًا","result":"خيرٍ مِمَّا سأَلتُما","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"دبر كل صلاة"},"repOf":"س-00878","otherNeedIds":[55],"ref":"نخب الافكار 12/288","text":["أنَّهُ قالَ لفاطِمةَ رضيَ اللَّهُ عَنها ذاتَ يومٍ: قد جاءَ اللَّهُ أباكِ بسَعَةٍ ورقيقٍ فأْتيهِ فاستَخدِميهِ فأتَتهُ فذكرَت ذلكَ لهُ فقالَ: واللَّهِ لا أعطيكُما وأدَعُ أهلَ الصُّفَّةِ تُطوَى بُطونُهم ولا أجِدُ ما أنفِقُ عليهِم ولكِن أبيعُها وأنفِقُ عليهِم ألا أدلُّكُما علَى ",["خيرٍ مِمَّا سأَلتُما",2],"؟ علَّمَنيهِ جِبريلُ صلَّى اللَّهُ عليهِ وسلَّمَ: ",["كبِّرا في دُبرِ كلِّ صلاةٍ عَشرًا وسبِّحا عَشرًا واحمَدا عَشرًا",1]," وإذا أويتُما إلى فراشِكُما"],"grade":"صحيح","narrator":"علي","muhaddith":"طريقه صحيح","takhrij":"أخرجه الطحاوي في ((شرح معاني الآثار)) (5210) واللفظ له، وأبو داود (2988)، وأحمد (838) مطولا.","bab":"أدعية وأذكار › فضل الذكر","dorar":"dTS0TMJN"},{"id":"س-07173","fp":"573ccd218075","stateId":476,"easy":"إذا سبحت وحمدت وكبرت دبر كل صلاة ← تدرك من سبقك وتسبق من بعدك","cause":"دُبُرَ كلِّ صلاةٍ ثلاثًا وثلاثين تسبيحةً وثلاثًا وثلاثين تحميدةً وأربعًا وثلاثين تكبيرةً","result":"ألَا أدُلُّك على شيءٍ إذا أنت فعَلْتَه لم يَسْبِقْكَ أحَدٌ كان قَبلَك ولم يُدْرِكْكَ أحَدٌ بعدَك إلَّا مَن فعَل مِثلَ الَّذي تفعَلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"دبر كل صلاة"},"repOf":"س-01022","ref":"مجمع الزوائد 10/103","text":["أتَيْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم فقلتُ يا رسولَ اللهِ ذهَب الأغنياءُ بالدُّنيا والآخِرةِ نُصَلِّي ويُصَلُّون ونصومُ ويصومون ويتصَدَّقون ولا نتصدَّقُ قال ",["ألَا أدُلُّك على شيءٍ إذا أنت فعَلْتَه لم يَسْبِقْكَ أحَدٌ كان قَبلَك ولم يُدْرِكْكَ أحَدٌ بعدَك إلَّا مَن فعَل مِثلَ الَّذي تفعَلُ",2]," ",["دُبُرَ كلِّ صلاةٍ ثلاثًا وثلاثين تسبيحةً وثلاثًا وثلاثين تحميدةً وأربعًا وثلاثين تكبيرةً",1]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"[روي] بأسانيد وأحد أسانيد الطبراني رجاله رجال الصحيح","takhrij":"أخرجه أحمد (21757)","bab":"علم › حسن السؤال ونصح العالم","dorar":"g89YRTkp"},{"id":"س-01032","fp":"80cc690ffcbd","stateId":476,"easy":"إذا ذكرت الله بين الغافلين ← فأنت بمنزلة الصابر بين الفارين","cause":"ذاكِرُ اللهِ في الغافِلينَ","result":"بمَنزِلةِ الصَّابِرِ في الفارِّينَ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"فتح الغفار 2201/4","srcLabel":"الطبراني","text":[["ذاكِرُ اللهِ في الغافِلينَ",1]," ",["بمَنزِلةِ الصَّابِرِ في الفارِّينَ",2],"."],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"إسناده لا بأس به.","takhrij":"أخرجه البزار (1759)، والطبراني (10/19) (9797) واللفظ له، وأبو نعيم في ((حلية الأولياء)) (4/268)","bab":"أدعية وأذكار › فضل الذكر","dorar":"Hi6h5oUB"},{"id":"س-00672","fp":"82c9b87ad5fa","stateId":477,"easy":"إذا قلت «اللهم أنت ربي وأنا عبدك ظلمت نفسي واعترفت بذنبي...» ← فهو أوفق الدعاء","cause":"أنْ يَقولَ الرَّجُلُ: اللَّهمَّ أنتَ رَبِّي، وأنا عَبدُكَ، ظلَمتُ نَفْسي واعتَرَفتُ بذَنبي","result":"إنَّ أوفَقَ الدُّعاءِ","explicit":true,"star":true,"apply":{"k":"say","t":"«اللهم أنت ربي وأنا عبدك ظلمت نفسي واعترفت بذنبي...»"},"otherNeedIds":[11],"ref":"تخريج المسند لشعيب 10682","srcLabel":"البخاري","text":[["إنَّ أوفَقَ الدُّعاءِ",2]," ",["أنْ يَقولَ الرَّجُلُ: اللَّهمَّ أنتَ رَبِّي، وأنا عَبدُكَ، ظلَمتُ نَفْسي واعتَرَفتُ بذَنبي",1],"، يا رَبِّ، فاغفِرْ لي ذَنبي، إنَّكَ أنتَ رَبِّي، إنَّه لا يَغفِرُ الذُّنوبَ إلَّا أنتَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (10682) واللفظ له، والبخاري في ((الأدب المفرد)) (667)، والديلمي في ((الفردوس)) (1493)","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"NEYwVNgw"},{"id":"س-00827","fp":"cb4430a44519","stateId":477,"easy":"إذا سألت الله أن يعيذك من عذاب النار والقبر ← كان خيراً لك وأفضل","cause":"سألتِ اللهَ أنْ يُعيذَكِ من عذابٍ في النارِ أو من عذابٍ في القبْرِ","result":"كان خيرًا وأفضلَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"تخريج كتاب السنة 262","srcLabel":"مسلم","text":["اللهُمَّ متِّعْنِي بِزوْجِي رسولِ اللهِ وبأبِي أبِي سُفيانَ وبِأخِي مُعاويةَ فقال النبيُّ : لقدْ سألْتِ اللهَ لِآجالٍ مَضروبةٍ وآثارٍ مَعدودةٍ و أرْزاقٍ مَقسومَةٍ لنْ يُعجِّلَ شيئًا قبلَ مَحِلِّهِ أوْ يُؤخِّرَ شيئًا عن أجَلِهِ ولو ",["سألتِ اللهَ أنْ يُعيذَكِ من عذابٍ في النارِ أو من عذابٍ في القبْرِ",1]," ",["كان خيرًا وأفضلَ",2]," قال : و ذُكِرَ عندَهُ القِرَدَةُ والخنازِيرُ هُنَّ مَسْخٌ قال : إنَّ اللهَ تعالَى لمْ يَمْسخْ شيئًا فجَعلَ له نسْلًا ولا عَقِبًا ، وكانتِ القِرَدةُ والخنازيرُ قبْلَ ذلِكَ"],"grade":"صحيح","narrator":"أم حبيبة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2663)، وأحمد (4254)، والنسائي في ((السنن الكبرى)) (10094)، وابن أبي عاصم في ((السنة)) (262) واللفظ له،  من حديث عبدالله بمسعود .","bab":"أدعية وأذكار › دعوات النبي صلى الله عليه وسلم","dorar":"9yj6FlRC"},{"id":"س-00834","fp":"1e10c7b151b8","stateId":477,"easy":"إذا دعوت ← فالدعاء مخ العبادة","cause":"الدُّعاءُ","result":"مُخُّ العِبادةِ","explicit":true,"similar":["س-04694"],"ref":"فتح البيان 12/ 205","srcLabel":"الترمذي","text":[["الدُّعاءُ",1]," ",["مُخُّ العِبادةِ",2],"."],"grade":"صحيح","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3371)، والطبراني في ((الدعاء)) (8) واللفظ لهما.","bab":"أدعية وأذكار › فضل التحميد والتسبيح والدعاء","dorar":"ntbpcyda"},{"id":"س-04694","fp":"e9d145704210","stateId":477,"easy":"إذا دعوت ← فالدعاء أفضل العبادة","cause":"الدعاءُ","result":"أفضلُ العبادةِ","explicit":true,"repOf":"س-00834","otherNeedIds":[29],"ref":"صحيح الجامع 1122","text":[["أفضلُ العبادةِ",2]," ",["الدعاءُ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عباس وأبو الدرداء وأبو هريرة","muhaddith":"صحيح","bab":"رقائق وزهد › أي الأعمال أفضل","dorar":"x9sEXUZv"},{"id":"س-02312","fp":"e1fac966566d","stateId":477,"easy":"إذا صليت على النبي ﷺ مرة ← يصلي الله عليك عشراً ويحط عنك عشر خطيئات","cause":"من صلَّى صلاةً واحِدةً صلَّى اللهُ عليه عَشْرَ صَلَواتٍ","result":"وحَطَّ عنه عَشْرَ خَطيئاتٍ","explicit":true,"star":true,"otherNeedIds":[11],"ref":"الأحاديث المختارة 1566","srcLabel":"البخاري","text":["«",["من صلَّى صلاةً واحِدةً صلَّى اللهُ عليه عَشْرَ صَلَواتٍ، ",1],["وحَطَّ عنه عَشْرَ خَطيئاتٍ",2],".\nاللَّفظُ واحِدٌ، وفي روايةٍ: وحُطَّت»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"VNM17Mhl"},{"id":"س-03751","fp":"38be801208b8","stateId":478,"easy":"إذا صلّت المرأة في بيتها ← فبيتها خير لها","cause":"وبُيوتُهُنَّ","result":"خَيرٌ لهُنَّ","explicit":true,"star":true,"similar":["س-06219"],"ref":"تخريج المسند لشعيب 5468","srcLabel":"متفق عليه","text":["لا تَمْنَعوا نِساءَكُمُ المَساجِدَ، ",["وبُيوتُهُنَّ",1]," ",["خَيرٌ لهُنَّ",2],". قال: فقال ابنٌ لعبدِ اللهِ بنِ عُمرَ: بلَى، واللهِ لَنَمْنَعُهُنَّ! فقال ابنُ عُمرَ: تَسمَعُني أُحَدِّثُ عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وتَقولُ ما تَقولُ؟!."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه البخاري (900)، وابن ماجه (16) بنحوه مختصراً، ومسلم (442) أوله في أثناء حديث، وأبو داود (567) مختصراً، وأحمد (5468) واللفظ له","bab":"اعتصام بالسنة › مخالفة السنة","dorar":"kulxXyES","merged":3,"otherRefs":["عمدة القاري 5/389 (صحيح)","تخريج المسند لشعيب 5471 (صحيح)"]},{"id":"س-02277","fp":"5562aba6b838","stateId":478,"easy":"إذا صليت الضحى حين ترمض الفصال ← فهي صلاة الأوابين","cause":"حينَ تَرمُضُ الفِصالُ","result":"صَلاةَ الأوَّابينَ","explicit":true,"star":true,"apply":{"k":"time","t":"الضحى"},"similar":["س-01481","س-05809"],"ref":"تخريج المسند لشعيب 19319","srcLabel":"مسلم","text":["أنَّ زَيدَ بنَ أرقَمَ رَأى ناسًا يُصلُّونَ في مسجدِ قُباءَ مِن الضُّحى، فقال: أمَا لقد عَلِموا أنَّ الصَّلاةَ في غيرِ هذه السَّاعةِ أفضلُ؛ إنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال: إنَّ ",["صَلاةَ الأوَّابينَ",2]," ",["حينَ تَرمُضُ الفِصالُ",1],"."],"grade":"صحيح","narrator":"زيد بن أرقم","muhaddith":"إسناده على شرط مسلم","takhrij":"أخرجه مسلم (748)، وأحمد (19319) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"N4Itf8DR","merged":3,"otherRefs":["صحيح مسلم 748 (صحيح)","تخريج المسند لشعيب 19347 (صحيح)"]},{"id":"س-07014","fp":"01a738779038","stateId":478,"easy":"إذا لم تنم حتى توتر ← فأنت حازم","cause":"الذي لا ينامُ حتى يُوترُ","result":"حازمٌ","explicit":true,"star":true,"ref":"تخريج المسند لشاكر 3/35","srcLabel":"البخاري","text":["عن سعدِ بنِ أبي وقاصٍ أنَّهُ كان يُصلِّي العشاءَ الآخرةَ في مسجدِ رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ثم يُوترُ بواحدةٍ لا يزيدُ عليها قال : فيقالُ لهُ : أتُوترُ بواحدةٍ لا تزيدُ عليها يا أبا إسحقٍ فيقولُ : نعم إني سمعتُ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يقولُ : ",["الذي لا ينامُ حتى يُوترُ",1]," ",["حازمٌ",2]],"grade":"صحيح","narrator":"سعد بن أبي وقاص.","muhaddith":"إسناده صحيح","takhrij":"أخرجه الضياء المقدسي في ((المختارة)) (1049) واللفظ له، والبخاري (6356)، وعبد الرزاق (4642) مختصرًا.","bab":"علم › الحث على الأخذ بالسنة","dorar":"GJhjDMWD"},{"id":"س-04689","fp":"4a58d0a34ded","stateId":478,"easy":"إذا صليت من الليل ← تكون رجلاً صالحاً","cause":"لو كان يُصَلِّي مِنَ اللَّيلِ","result":"إنَّ عَبدَ اللهِ رَجُلٌ صالِحٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"صحيح البخاري 7028","srcLabel":"متفق عليه","text":["إنَّ رِجالًا مِن أصحابِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم كانوا يَرَونَ الرُّؤيا على عَهدِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فيَقُصُّونَها على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فيَقولُ فيها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم ما شاءَ اللهُ، وأنا غُلامٌ حَديثُ السِّنِّ، وبَيتي المَسجِدُ قَبلَ أن أنكِحَ، فقُلتُ في نَفسي: لو كان فيكَ خَيرٌ لَرَأيتَ مِثلَ ما يَرى هؤلاء، فلَمَّا اضطَجَعتُ ذاتَ لَيلةٍ قُلتُ: اللهُمَّ إن كُنتَ تَعلَمُ فيَّ خَيرًا فأرِني رُؤيا، فبينَما أنا كَذلك إذ جاءَني مَلَكانِ في يَدِ كُلِّ واحِدٍ منهما مِقمعةٌ مِن حَديدٍ، يُقبِلانِ بي إلى جَهَنَّمَ، وأنا بينَهما أدعو اللهَ: اللهُمَّ إنِّي أعوذُ بكَ مِن جَهَنَّمَ، ثُمَّ أُراني لَقيَني مَلَكٌ في يَدِه مِقمعةٌ مِن حَديدٍ، فقال: لَن تُراعَ، نِعمَ الرَّجُلُ أنتَ لو كُنتَ تُكثِرُ الصَّلاةَ. فانطَلَقوا بي حتَّى وقَفوا بي على شَفيرِ جَهَنَّمَ، فإذا هي مَطويَّةٌ كَطَيِّ البِئرِ، له قُرونٌ كَقَرنِ البِئرِ، بينَ كُلِّ قَرنَينِ مَلَكٌ بيَدِه مِقمعةٌ مِن حَديدٍ، وأرى فيها رِجالًا مُعَلَّقينَ بالسَّلاسِلِ، رُؤوسُهم أسفَلَهم، عَرَفتُ فيها رِجالًا مِن قُرَيشٍ، فانصَرَفوا بي عن ذاتِ اليَمينِ. فقَصَصتُها على حَفصةَ، فقَصَّتها حَفصةُ على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["إنَّ عَبدَ اللهِ رَجُلٌ صالِحٌ",2],"، ",["لو كان يُصَلِّي مِنَ اللَّيلِ",1],"، فقال نافِعٌ: فلَم يَزَلْ بَعدَ ذلك يُكثِرُ الصَّلاةَ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"من أفراد البخاري على مسلم","bab":"رؤيا › تأويل الرؤيا","dorar":"LYz1lAgq","merged":4,"otherRefs":["صحيح مسلم 2479 (صحيح)","صحيح البخاري 1156 (صحيح)","شرح البخاري لابن الملقن 5/516 (حسن)"]},{"id":"ق-0718","fp":"db874a6f1d57","stateId":478,"easy":"التهجد بالقرآن ليلاً ← المقام المحمود","cause":"التهجد بالقرآن ليلاً","result":"المقام المحمود","explicit":true,"ref":"سورة الإسراء: 79","srcLabel":"القرآن الكريم","quran":{"s":17,"from":79,"to":79,"text":"وَمِنَ اللَّيْلِ فَتَهَجَّدْ بِهِ نَافِلَةً لَكَ عَسَى أَنْ يَبْعَثَكَ رَبُّكَ مَقَامًا مَحْمُودًا (79)","hl":[[0,98,1]]}},{"id":"ق-1074","fp":"3628685f4bf5","stateId":478,"easy":"قيام الليل ساجداً وقائماً مع الخوف والرجاء والعلم ← الرفعة (لا يستوون)","cause":"قيام الليل ساجداً وقائماً مع الخوف والرجاء والعلم","result":"الرفعة (لا يستوون)","explicit":true,"apply":{"k":"time","t":"في السجود، في الليل"},"otherNeedIds":[18],"ref":"سورة الزمر: 9","srcLabel":"القرآن الكريم","quran":{"s":39,"from":9,"to":9,"text":"أَمَّنْ هُوَ قَانِتٌ آنَاءَ اللَّيْلِ سَاجِدًا وَقَائِمًا يَحْذَرُ الْآخِرَةَ وَيَرْجُو رَحْمَةَ رَبِّهِ قُلْ هَلْ يَسْتَوِي الَّذِينَ يَعْلَمُونَ وَالَّذِينَ لَا يَعْلَمُونَ إِنَّمَا يَتَذَكَّرُ أُولُو الْأَلْبَابِ (9)","hl":[[0,174,1]]}},{"id":"س-08361","fp":"0edb7ccfb402","stateId":478,"easy":"إذا سجدت لله سجدة ← يرفعك الله بها درجة ويحط عنك خطيئة ويكتب لك حسنة","cause":"ما مِن عبدٍ يسجدُ للَّهِ سجدةً","result":"إلَّا رفعَهُ اللَّهُ بِها درجةً، وَحطَّ عنهُ بِها خطيئةً، وَكَتبَ لَهُ بِها حَسنةً","explicit":true,"similar":["س-03602","س-03274","س-06537","س-03350","س-06571"],"otherNeedIds":[11,45],"ref":"الصحيح المسند 271","srcLabel":"أحمد","text":["عن الأحنف بن قيس قال: دخَلتُ بيتَ المقدِسِ، فوَجدتُ فيهِ رجلًا يُكْثرُ السُّجودَ، ووجدتُ في نَفسي مِن ذلِكَ، فلمَّا انصرفَ قلتُ : أتَدري على شَفعٍ انصرفتَ أم على وِترٍ ؟ قالَ: إن أَكُ لا أدري، فإنَّ اللَّهَ عزَّ وجلَّ يَدري، ثمَّ قالَ: أخبرَني حِبِّي أبو القاسِمِ صلَّى اللَّه عليهِ وعلَى آلِهِ وسلَّمَ. ثمَّ بَكَى، ثمَّ قالَ: أخبرَني حبِّي أبو القاسِمِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ. ثمَّ بَكَى، ثمَّ قالَ: أخبرَني حِبِّي أبو القاسِمِ صلَّى اللَّهُ عليهِ وعلى آلِهِ وسلَّمَ، أنَّهُ قالَ: ",["ما مِن عبدٍ يسجدُ للَّهِ سجدةً،",1]," ",["إلَّا رفعَهُ اللَّهُ بِها درجةً، وَحطَّ عنهُ بِها خطيئةً، وَكَتبَ لَهُ بِها حَسنةً",2],". قالَ: قلتُ: أخبِرني مَن أنتَ يرحَمُكَ اللَّهُ ؟ قالَ: أَنا أبو ذرٍّ، صاحبُ رسولِ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ.قال فتقاصَرَت إلى نفسي."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (21452)، والدارمي (1502)، وعبد الرزاق (3561)، والمروزي في ((تعظيم قدر الصلاة)) (288) بلفظه.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"7FiyhOK8","merged":5,"otherRefs":["الأحاديث المختارة 8 / 322 (صحيح)","المجموع للنووي 4/50 (صحيح)","صحيح الجامع 5742 (صحيح)","صحيح ابن خزيمة 1/ 418 (صحيح)"]},{"id":"س-04495","fp":"676d33da1093","stateId":478,"easy":"إذا اعتزلت في شعب تقيم الصلاة وتؤتي الزكاة وتعتزل شرور الناس ← تكون في المنزلة التي تلي المجاهد","cause":"امرُؤٌ مُعتَزِلٌ في شِعبٍ يُقيمُ الصَّلاةَ، ويُؤتي الزَّكاةَ، ويَعتَزِلُ شُرورَ النَّاسِ","result":"ألا أُخبِرُكُم بالذي يَليه","explicit":true,"ref":"تخريج المسند لشعيب 2928","srcLabel":"أحمد","text":["عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم: خَرَجَ عليهم وهُم جُلوسٌ، فقال: ألا أُحَدِّثُكُم بخَيرِ النَّاسِ مَنزِلةً، فذَكَرَه [يَعني حَديثَ: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم جاءَ -أو خَرَجَ عليهم- وهُم جُلوسٌ، فقال: ألا أُحَدِّثُكُم بخَيرِ النَّاسِ مَنزِلًا؟ قال: قُلنا: بَلى يا رَسولَ اللهِ. قال: رَجُلٌ مُمسِكٌ برَأسِ فرَسٍ في سَبيلِ اللهِ حَتَّى يَموتَ أو يُقتَلَ، ثُمَّ قال: ",["ألا أُخبِرُكُم بالذي يَليه",2],"؟ قُلنا: بَلى يا رَسولَ اللهِ. قال: ",["امرُؤٌ مُعتَزِلٌ في شِعبٍ يُقيمُ الصَّلاةَ، ويُؤتي الزَّكاةَ، ويَعتَزِلُ شُرورَ النَّاسِ",1],"، ثُمَّ قال: ألا أُخبِرُكُم بشَرِّ النَّاسِ مَنزِلًا؟ قال: قُلنا: بَلى يا رَسولَ اللهِ. قال: الذي يُسأَلُ باللهِ، ولا يُعطي به]."],"grade":"صحيح","narrator":"ابن عباس","muhaddith":"إسناده صحيح","bab":"جهاد › فضل الجهاد","dorar":"FW652v5E","merged":4,"otherRefs":["تخريج صحيح ابن حبان 605 (صحيح)","السلسلة الصحيحة 255 (صحيح)","تخريج المسند لشعيب 9142 (صحيح)"]},{"id":"س-06219","fp":"d14eb23113ff","stateId":478,"easy":"إذا صلّت المرأة في بيتها ← فهو خير لها من حجرتها","cause":"لأنْ تصليَ المرأةُ في بيتها","result":"خيرٌ لها منْ أنْ تصليَ في حجرتِها","explicit":true,"repOf":"س-03751","ref":"الجامع الصغير 7190","text":[["لأنْ تصليَ المرأةُ في بيتها",1]," ",["خيرٌ لها منْ أنْ تصليَ في حجرتِها",2],"،  و لأنْ تصليَ في حجرتِها خيرٌ [ لها ] من أنْ تصليَ في الدارِ،  ولأن تصليَ في الدارِ خيرٌ لها منْ أنْ تصليَ في المسجدِ"],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"حسن","takhrij":"أخرجه البخاري في ((التاريخ الكبير)) (8/265) مختصراً، وأبو بكر الشافعي في ((الغيلانيات)) (770)، والبيهقي (5571) واللفظ لهما","bab":"ستر العورة › وجوب سترها","dorar":"LING3Zk8"},{"id":"س-01481","fp":"1253a9ddb81a","stateId":478,"easy":"إذا صليت الضحى ← فهي صلاة الأوابين","cause":"صلاةَ الضُّحى","result":"فإنَّها صلاةُ الأوَّابينَ","explicit":true,"apply":{"k":"time","t":"الضحى"},"repOf":"س-02277","ref":"الضعفاء الكبير 1/148","text":["يا أَنَسُ، أسبِغِ الوضوءَ يَزِدْ في عُمُرِكَ، وصَلِّ مِن اللَّيلِ والنَّهارِ ما استطَعْتَ يُحِبَّكَ الحَفَظَةُ، وصَلِّ ",["صلاةَ الضُّحى",1],"؛ ",["فإنَّها صلاةُ الأوَّابينَ",2],"، فإنِ استطَعْتَ ألَّا تنامَ إلَّا على طهارةٍ، فإنَّكَ إن مِتَّ مِتَّ شهيدًا، وسلِّمْ على أهلِ بيتِكَ يكثُرْ خيرُ بيتِكَ، ووقِّرِ الكبيرَ، وارحَمِ الصَّغيرَ، تُرافِقْني في الجنَّةِ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"ليس لهذا المتن عن أنس إسناد صحيح","takhrij":"أخرجه البزار (7396)، وأبو يعلى (4183)، والعقيلي في ((الضعفاء الكبير)) (1/148) واللفظ له","bab":"وضوء › فضل الوضوء","dorar":"CfQ83tTb","merged":3,"otherRefs":["المستدرك على الصحيحين 1198 (صحيح)","صحيح الجامع 3827 (صحيح)"]},{"id":"س-03602","fp":"f16d3897c881","stateId":478,"easy":"إذا سجدت لله سجدة ← يرفعك بها درجة ويحط عنك خطيئة","cause":"أنَّك لن تَسجُدَ للهِ سَجْدةً","result":"إلَّا رَفَعَ اللهُ لك بِها دَرَجةً، وحَطَّ عنك بِها خَطيئةً","explicit":true,"repOf":"س-08361","otherNeedIds":[11],"ref":"الصحيح المسند 488","text":["أَنشَأَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ غَزْوةً، فأَتَيْتُه فقُلْتُ: يا رَسولَ اللهِ، ادْعُ اللهَ لي بالشَّهادةِ، فقالَ: «اللَّهُمَّ سَلِّمْهم وغَنِّمْهم»، قالَ: فسَلِمْنا وغَنِمْنا، قالَ: ثُمَّ أَنشَأَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ غَزْوًا ثانِيًا، فأَتَيْتُه فقُلْتُ: يا رَسولَ اللهِ، ادْعُ اللهَ لي بالشَّهادةِ، فقالَ: «اللَّهُمَّ سَلِّمْهم وغَنِّمْهم»، قالَ: ثُمَّ أَنشَأَ غَزْوًا ثالِثًا، فأَتَيْتُه فقُلْتُ: يا رَسولَ اللهِ، إنِّي أَتَيْتُك مَرَّتَينِ قَبْلَ مَرَّتي هذه فسَألْتُك أن تَدْعوَ اللهَ لي بالشَّهادةِ، فدَعَوْتَ اللهَ عَزَّ وجَلَّ أن يُسَلِّمَنا ويُغَنِّمَنا، فسَلَّمَنا وغَنَّمَنا، يا رَسولَ اللهِ، فادْعُ اللهَ لي بالشَّهادةِ، فقالَ: «اللَّهُمَّ سَلِّمْهم وغَنِّمْهم»، قالَ: فسَلِمْنا وغَنِمْنا، ثُمَّ أَتَيْتُه فقُلْتُ: يا رَسولَ اللهِ، مُرْني بعَمَلٍ، قالَ: «عليك بالصَّوْمِ؛ فإنَّه لامِثلَ له»، قالَ: فما رُئِيَ أبو أُمامةَ ولا امْرَأتُه ولا خادِمُه إلَّا صُيَّامًا قالَ: فكانَ إذا رُئِيَ في دارِهم دُخانٌ بالنَّهارِ قيلَ: اعْتَراهم ضَيْف، نَزَلَ بِهم نازِلٌ، قالَ: فلَبِثَ بِذلك ما شاءَ اللهُ، ثُمَّ أَتَيْتُه فقُلْتُ: يا رَسولَ اللهِ، أَمَرْتَنا بالصِّيامِ، فأَرْجو أن يكونَ قد بارَكَ اللهُ لنا فيه يا رَسولَ اللهِ، فمُرْني بعَمَلٍ آخَرَ، قالَ: «اعْلَمْ ",["أنَّك لن تَسجُدَ للهِ سَجْدةً",1]," ",["إلَّا رَفَعَ اللهُ لك بِها دَرَجةً، وحَطَّ عنك بِها خَطيئةً",2],"»."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه أحمد (22140)، وعبد الرزاق (7899)، وابن حبان (146)، والطبراني (8/ 91) (7463) واللفظ لهم.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"bD6UQIb3","merged":3,"otherRefs":["تخريج المسند لشعيب 22220 (صحيح)","تخريج المسند لشعيب 22195 (صحيح)"]},{"id":"س-05809","fp":"b11f7c1dbd4f","stateId":478,"easy":"إذا صليت ركعتي الضحى ← فهي صلاة الأوابين","cause":"رَكعَتَيِ الضُّحى","result":"فإنَّها صَلاةُ الأوَّابينَ","explicit":true,"apply":{"k":"time","t":"الضحى"},"repOf":"س-02277","ref":"تخريج المسند لشعيب 10559","text":["أوصاني خَليلي صلَّى اللهُ عليه وسلَّمَ بثلاثٍ، ولستُ بتارِكِهِنَّ في سَفَرٍ ولا حَضَرٍ: ألَّا أنامَ إلَّا على وِترٍ، وأنْ أصومَ ثلاثةَ أيَّامٍ مِن كُلِّ شَهرٍ، وألَّا أدَعَ ",["رَكعَتَيِ الضُّحى",1],"؛ ",["فإنَّها صَلاةُ الأوَّابينَ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (10559) واللفظ له، والدارمي (1745) باختلاف يسير، وابن أبي شيبة (7884) مختصراً","bab":"رقائق وزهد › الوصايا النافعة","dorar":"mijWQasT","merged":3,"otherRefs":["تخريج المسند لشعيب 7596 (صحيح)","صحيح الترغيب 664 (صحيح)"]},{"id":"س-02319","fp":"d98677881ac1","stateId":478,"easy":"إذا استيقظت ليلاً وأيقظت أهلك فصليتما ركعتين ← تُكتبان من الذاكرين الله كثيراً","cause":"من استيقظ من الليل ‌فأيقظ ‌أهله فصليا ركعتين جميعا","result":"كتب ليلتئذ من الذاكرين الله كثيرا والذاكرات","explicit":true,"apply":{"k":"count","t":"ركعتين · الوقت: عند الاستيقاظ"},"ref":"روضة الطالبين 1/338","srcLabel":"روضة الطالبين","text":["حديث إيقاظِ المَرءِ أهلَه لصَلاةِ اللَّيلِ [يعني حديث: ",["من استيقظ من الليل ‌فأيقظ ‌أهله فصليا ركعتين جميعا",1]," ",["كتب ليلتئذ من الذاكرين الله كثيرا والذاكرات",2],"]"],"grade":"صحيح","narrator":"[أبو سعيد الخدري وأبو هريرة]","muhaddith":"[صحيح]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"lpLK23pY","merged":2,"otherRefs":["الفتوحات الربانية 1/121 (صحيح)"]},{"id":"س-01891","fp":"b233ad67c68f","stateId":478,"easy":"إذا أكثرت السجود ← يرفعك الله بكل سجدة درجة","cause":"أكثِرْ من السجودِ","result":"فإنَّهُ ليس من مسلمٍ يسجدُ للهِ تبارك و تعالَى سجدةً إلا رفعَه اللهُ تبارك و تعالَى بها درجةً في الجنةِ ، وحطَّ عنه بها خطيئةً","explicit":true,"apply":{"k":"time","t":"في السجود"},"similar":["س-03403"],"otherNeedIds":[11],"ref":"السلسلة الصحيحة 1519","srcLabel":"ابن ماجه","text":["يا أبا فاطمةَ ! ",["أكثِرْ من السجودِ",1]," ، ",["فإنَّهُ ليس من مسلمٍ يسجدُ للهِ تبارك و تعالَى سجدةً إلا رفعَه اللهُ تبارك و تعالَى بها درجةً [ في الجنةِ ، وحطَّ عنه بها خطيئةً",2]," ]"],"grade":"صحيح","narrator":"أبو فاطمة الإيادي","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (1422)، وأحمد (15528) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"u3uSzFbQ"},{"id":"س-03274","fp":"304f9e7610f3","stateId":478,"easy":"إذا ركعت ركعة أو سجدت سجدة ← يرفعك الله بها درجة ويحط عنك خطيئة","cause":"مَن رَكَعَ رَكعةً أو سَجَدَ سَجدةً","result":"رَفَعَ اللهُ له بها دَرَجةً، وحَطَّ عنه بها خَطيئةً","explicit":true,"repOf":"س-08361","otherNeedIds":[11],"ref":"الترغيب والترهيب 1/194","text":["عن مطرف رضي الله عنه قال: قَعَدتُ إلى نَفَرٍ مِن قُرَيشٍ، فجاءَ رَجُلٌ فجَعَلَ يُصلِّي ويَرفَعُ ويَسجُدُ ولا يَقعُدُ، فقُلتُ: واللهِ ما أرى هذا يَدري يَنصَرِفُ على شَفْعٍ أو وِتْرٍ. فقالوا: ألَا نَقومُ إليه فنَقولَ له؟ قال: فقُمتُ فقُلتُ له: يا عَبدَ اللهِ ما أراكَ تَدري تَنصَرِفُ على شَفعٍ أو على وِتْرٍ. قال: ولكِنَّ اللهَ يَدْري، وسَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: مَن سَجَدَ للهِ سَجدةً، كَتَبَ اللهُ له بها حَسَنةً، وحَطَّ عنه بها خَطيئةً، ورَفَعَ له بها دَرَجةً. فقُلتُ: مَن أنتَ؟ فقال: أبو ذَرٍّ. فرَجَعتُ إلى أصحابي فقُلتُ: جَزاكُمُ اللهُ مِن جُلساءَ شَرًّا، أمَرتُموني أنْ أُعلِّمَ رَجُلًا مِن أصحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ. وفي رِوايةٍ: فرَأيتُه يُطيلُ القيامَ ويُكثِرُ الرُّكوعَ والسُّجودَ، فذَكَرتُ ذلك له، فقال: ما آلوْتُ أنْ أُحسِنَ؛ إنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["مَن رَكَعَ رَكعةً أو سَجَدَ سَجدةً، ",1],["رَفَعَ اللهُ له بها دَرَجةً، وحَطَّ عنه بها خَطيئةً",2],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"هو بمجموع طرقه حسن أو صحيح","takhrij":"أخرجه أحمد (21308)، وأبو يوسف في ((الآثار)) (173)، والمروزي في ((تعظيم قدر الصلاة)) (287)، والطحاوي في ((شرح معاني الآثار)) (2730) واللفظ لهم.","bab":"استغفار › أسباب المغفرة","dorar":"1YdLkG7s"},{"id":"س-03403","fp":"9f3a981c5e11","stateId":478,"easy":"إذا أكثرت السجود لله ← يرفعك الله بكل سجدة درجة ويحط خطيئة","cause":"عليك بكَثرةِ السُّجودِ للَّهِ","result":"فإنَّك لا تَسجُدُ للَّهِ سَجدةً إلَّا رَفَعَك اللهُ بها دَرَجةً، وحَطَّ عَنك بها خَطيئةً","explicit":true,"apply":{"k":"time","t":"في السجود"},"repOf":"س-01891","otherNeedIds":[11,67],"ref":"صحيح مسلم 488","text":["[عن] مَعدانَ بنِ أبي طَلحةَ اليَعمَريِّ، قال: لَقيتُ ثَوبانَ مَولى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقُلتُ: أخبِرْني بعَمَلٍ أعمَلُه يُدخِلُني اللهُ به الجَنَّةَ؟ أو قال: قُلتُ: بأحَبِّ الأعمالِ إلى اللهِ، فسَكَتَ. ثُمَّ سَألتُه فسَكَتَ. ثُمَّ سَألتُه الثَّالِثةَ فقال: سَألتُ عن ذلك رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: ",["عليك بكَثرةِ السُّجودِ للَّهِ",1],"؛ ",["فإنَّك لا تَسجُدُ للَّهِ سَجدةً إلَّا رَفَعَك اللهُ بها دَرَجةً، وحَطَّ عَنك بها خَطيئةً",2],"."],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم وأبو الدرداء","muhaddith":"[صحيح]","takhrij":"أخرجه الترمذي (388)، وابن ماجه (1423)، وأحمد (22377) واللفظ لهم.","bab":"استغفار › أسباب المغفرة","dorar":"R3GjcgDM"},{"id":"س-06537","fp":"d5b2ed424647","stateId":478,"easy":"إذا ركعت ركعة أو سجدت سجدة ← تُرفع بها درجة وتُحط عنك خطيئة","cause":"مَن ركَعَ رَكعةً، أو سجَدَ سَجدةً؛ رُفِعَ بها دَرجةً","result":"وحُطَّتْ عنه بها خَطيئةٌ","explicit":true,"repOf":"س-08361","otherNeedIds":[11],"ref":"تخريج المسند لشعيب 21308","text":["عنِ المُخارِقِ، قال: خرَجْنا حُجَّاجًا، فلمَّا بلَغْنا الرَّبَذةَ قُلْتُ لأصْحابي: تَقدَّموا، وتَخلَّفْتُ، فأتَيْتُ أبا ذَرٍّ، وهو يُصلِّي، فرَأيْتُه يُطيلُ القيامَ، ويُكثِرُ الركوعَ والسجودَ، فذكَرْتُ ذلك له، فقال: ما ألَوْتُ أنْ أُحسِنَ، إنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن ركَعَ رَكعةً، أو سجَدَ سَجدةً؛ رُفِعَ بها دَرجةً، ",1],["وحُطَّتْ عنه بها خَطيئةٌ",2],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (21308) واللفظ له، والطحاوي في ((شرح معاني الآثار)) (2730)، والبيهقي (4883)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"jCZJBoOh"},{"id":"س-06593","fp":"5c1ee3e4dac4","stateId":478,"easy":"إذا صليت في فلاة فأتممت وضوءها وركوعها وسجودها ← تبلغ صلاتك خمسين درجة","cause":"فإذا صلّاها بِأرضِ فلاةٍ ، فأَتَمَّ وُضوءَها و رُكوعَها و سُجودَها","result":"بَلغتْ صلاتُهُ خمسينَ درجَةً","explicit":true,"ref":"صحيح الجامع 3824","srcLabel":"ابن ماجه","text":["صلاةُ الرجلِ في جَماعةٍ تَزيدُ على صلاتِه وحدَهُ خمسًا وعِشرينَ درجةً ، ",["فإذا صلّاها بِأرضِ فلاةٍ ، فأَتَمَّ وُضوءَها و رُكوعَها و سُجودَها",1]," ، ",["بَلغتْ صلاتُهُ خمسينَ درجَةً",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (788)، وابن حبان (2055)، والحاكم (753)، والبيهقي في ((شعب الإيمان)) (2572) بلفظه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"oSV90ZQ9"},{"id":"س-06713","fp":"d98a33fd8db4","stateId":478,"easy":"إذا صليت النافلة في بيتك ← فهو خير صلاتك","cause":"في بيتِهِ","result":"خَيرُ صلاةِ المرءِ","explicit":true,"ref":"صحيح ابن خزيمة 2/ 363","srcLabel":"ابن خزيمة","text":[["خَيرُ صلاةِ المرءِ",2]," ",["في بيتِهِ",1]," إلَّا المَكْتوبةَ. [وفي روايةٍ]: أفضلُ صلاتِكُم في بيوتِكُم إلَّا المَكْتوبةَ"],"grade":"صحيح","narrator":"زيد بن ثابت","muhaddith":"أخرجه في صحيحه","bab":"صلاة الجماعة والإمامة › فضل صلاة الجماعة","dorar":"CeP3gcwL"},{"id":"س-06723","fp":"7c93eae91a5c","stateId":478,"easy":"إذا تطوعت في بيتك ← يزيد على تطوعك عند الناس كفضل الجماعة على الفرد","cause":"تَطَوُّعُ الرجُلِ في بَيتِه","result":"يَزِيدُ على تَطَوُّعِه عند الناسِ ، كَفضْلِ صلاةِ الرجُلِ في جماعةٍ على صلاتِه وحدَهُ","explicit":true,"ref":"صحيح الجامع 2953","srcLabel":"البيهقي","text":[["تَطَوُّعُ الرجُلِ في بَيتِه",1]," ",["يَزِيدُ على تَطَوُّعِه عند الناسِ ، كَفضْلِ صلاةِ الرجُلِ في جماعةٍ على صلاتِه وحدَهُ",2]],"grade":"صحيح","narrator":"رجل","muhaddith":"صحيح","takhrij":"أخرجه عبد الرزاق (4835)، وابن أبي شيبة (6455) واللفظ لهما، والبيهقي في ((شعب الإيمان)) (2989) بنحوه.","bab":"صلاة الجماعة والإمامة › فضل صلاة الجماعة","dorar":"ceAoRIKK"},{"id":"س-03350","fp":"e9d128455d09","stateId":478,"easy":"إذا سجدت لله سجدة ← يرفعك الله بها درجة ويحط عنك خطيئة","cause":"قلتُ: يا رسولَ اللهِ، أَخبِرْني بعمَلٍ أَستَقيمُ عليه وأعمَلُ، قال: عليكَ بالسُّجودِ","result":"فإنَّهُ لا تسجُدُ للهِ سَجدةً إلَّا رفَعَكَ اللهُ بها درجةً، وحَطَّ عنكَ بها خطيئةً","explicit":true,"repOf":"س-08361","otherNeedIds":[11],"ref":"الفتح الرباني 5/2646","text":[["قلتُ: يا رسولَ اللهِ، أَخبِرْني بعمَلٍ أَستَقيمُ عليه وأعمَلُ، قال: عليكَ بالسُّجودِ؛ ",1],["فإنَّهُ لا تسجُدُ للهِ سَجدةً إلَّا رفَعَكَ اللهُ بها درجةً، وحَطَّ عنكَ بها خطيئةً",2],". ولَفْظُ أحمدَ أنَّه قال له: يا أبا فاطمةَ، إنْ أَرَدْتَ أنْ تَلْقاني فأَكثِرِ السُّجودَ."],"grade":"حسن","narrator":"أبو فاطمة الإيادي","muhaddith":"إسناده جيد","takhrij":"أخرجه ابن ماجه (1422)، وأحمد (15527) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"jWKY6ADA"},{"id":"س-06453","fp":"b9b95134f488","stateId":478,"easy":"إذا وضعت يمينك على شمالك في الصلاة ← فهو من أخلاق النبيين","cause":"وضْعُ اليَمينِ على الشِّمالِ في الصلاةِ","result":"من أخلاقِ النبيينَ","explicit":true,"ref":"البدر المنير 3/511","srcLabel":"ابن أبي شيبة","text":["عن أبي الدرداءِ : ",["من أخلاقِ النبيينَ",2]," صلَّى اللهُ عليهم وسلَّمَ ",["وضْعُ اليَمينِ على الشِّمالِ في الصلاةِ",1]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"إسناده جيد","takhrij":"أخرجه ابن أبي شيبة (3957) واللفظ له.","bab":"صلاة › صفة صلاة النبي صلى الله عليه وسلم","dorar":"JWdMW0A0"},{"id":"س-06571","fp":"5a1bb6481d97","stateId":478,"easy":"إذا ركعت أو سجدت ← يرفعك الله بها درجة ويحط عنك خطيئة","cause":"ما منها سجدةٌ أو ركعةٌ","result":"إلا رفَعه اللهُ بها درجةً ، وحطَّ عنه بها خطيئةً","explicit":true,"repOf":"س-08361","otherNeedIds":[11],"ref":"إتحاف الخيرة المهرة 2/351","text":["عن أبي ذرٍّ : أنه كان يَركَعُ ويسجُدُ ويَرفَعُ ويَسجُدُ ، فعاب ذلك عليه رجلٌ لا أعرِفُه ، فقال : ",["ما منها سجدةٌ أو ركعةٌ",1]," ",["إلا رفَعه اللهُ بها درجةً ، وحطَّ عنه بها خطيئةً",2]],"grade":"حسن","muhaddith":"رجاله ثقات","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"ANNCCRfB"},{"id":"س-06733","fp":"5262f86f8fad","stateId":478,"easy":"إذا حافظت على الصلاة ← فهي عمود الدين","cause":"الصَّلاةَ","result":"وعمودِهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الترمذي 2616","srcLabel":"الترمذي","text":["كنتُ معَ النَّبيِّ صلَّى اللَّهُ علَيهِ وسلَّمَ في سفَرٍ ، فأصبَحتُ يومًا قريبًا منهُ ونحنُ نَسيرُ ، فقلتُ : يا رسولَ اللَّهِ أخبرني بعمَلٍ يُدخِلُني الجنَّةَ ويباعِدُني من النَّارِ ، قالَ : لقد سألتَني عَن عظيمٍ ، وإنَّهُ ليسيرٌ على من يسَّرَهُ اللَّهُ علَيهِ ، تعبدُ اللَّهَ ولا تشرِكْ بِهِ شيئًا ، وتُقيمُ ",["الصَّلاةَ",1]," ، وتُؤتي الزَّكاةَ ، وتصومُ رمضانَ ، وتحجُّ البيتَ ، ثمَّ قالَ : ألا أدلُّكَ على أبوابِ الخيرِ : الصَّومُ جُنَّةٌ ، والصَّدَقةُ تُطفي الخطيئةَ كما يُطفئُ الماءُ النَّارَ ، وصلاةُ الرَّجلِ من جوفِ اللَّيلِ قالَ : ثمَّ تلا  تَتَجَافَى جُنُوبُهُمْ عَنِ الْمَضَاجِعِ يَدْعُونَ رَبَّهُمْ  ، حتَّى بلغَ يَعْمَلُونَ ، ثمَّ قالَ : ألا أخبرُكَ بِرَأسِ الأَمرِ كلِّهِ ",["وعمودِهِ",2]," ، وذِروةِ سَنامِهِ ؟ قلتُ : بلى يا رسولَ اللَّهِ ، قالَ : رأسُ الأمرِ الإسلامُ ، وعمودُهُ الصَّلاةُ ، وذروةُ سَنامِهِ الجِهادُ ، ثمَّ قالَ : ألا أخبرُكَ بملاكِ ذلِكَ كلِّهِ ؟ قُلتُ : بلَى يا رسولَ اللَّهِ ، قال : فأخذَ بلِسانِهِ قالَ : كُفَّ عليكَ هذا ، فقُلتُ : يا نبيَّ اللَّهِ ، وإنَّا لمؤاخَذونَ بما نتَكَلَّمُ بِهِ ؟ فقالَ : ثَكِلَتكَ أمُّكَ يا معاذُ ، وَهَل يَكُبُّ النَّاسَ في النَّارِ على وجوهِهِم أو على مَناخرِهِم إلَّا حَصائدُ ألسنتِهِم ."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2616) بلفظه، وابن ماجه (3973)، وأحمد (22068) كلاهما باختلاف يسير.","bab":"صيام › فضل الصيام","dorar":"dad0NMIP","merged":3,"otherRefs":["مجموع فتاوى ابن باز 235/10 (صحيح)","الجامع الصغير 4357 (صحيح)"]},{"id":"س-00508","fp":"b301a0591bf5","stateId":478,"easy":"إذا صليت بالليل ← ففضلها على صلاة النهار كفضل صدقة السر على العلانية","cause":"صلاةِ اللَّيلِ","result":"على صلاةِ النَّهارِ كفضلِ صَدقةِ السِّرِّ على صدقةِ العلانيةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"الترغيب والترهيب 1/293","srcLabel":"الطبراني","text":["فَضلُ ",["صلاةِ اللَّيلِ",1]," ",["على صلاةِ النَّهارِ كفضلِ صَدقةِ السِّرِّ على صدقةِ العلانيةِ",2]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني (10/221) (10382)، وأبو نعيم في ((حلية الأولياء)) (4/167)، والبيهقي في ((شعب الإيمان)) (3098)","bab":"آداب عامة › ضرب الأمثال","dorar":"iMaJGGmE"},{"id":"س-00633","fp":"78b1b886bf78","stateId":478,"easy":"إذا صليت النافلة في بيتك ← ففضلها على صلاتك أمام الناس كفضل الفريضة على التطوع","cause":"فَضلُ صلاةِ الرَّجُلِ في بيتِه","result":"على صَلاتِه حيثُ يَراهُ النَّاسُ كفَضلِ الفَريضةِ علَى التطوُّعِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"الترغيب والترهيب 1/213","srcLabel":"الطبراني","text":[["فَضلُ صلاةِ الرَّجُلِ في بيتِه",1]," ",["على صَلاتِه حيثُ يَراهُ النَّاسُ كفَضلِ الفَريضةِ علَى التطوُّعِ",2]],"grade":"حسن","narrator":"رجل من الصحابة","muhaddith":"إسناده جيد إن شاء الله تعالى","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (2989) بلفظه، والطبراني في ((المعجم الكبير)) (8/ 46) (7322) باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"oCM0bXiv"},{"id":"س-08100","fp":"8868564f881c","stateId":479,"easy":"إذا أحسنت الوضوء وأتيت المسجد لا تريد إلا الصلاة ← تُرفع بكل خطوة درجة","cause":"إذا تَوضَّأ فأحسَنَ الوُضوءَ، ثُمَّ أتى المَسجِدَ لا يُريدُ إلَّا الصَّلاةَ","result":"لا يَنهَزُه إلَّا الصَّلاةُ- لَم يَخطُ خَطوةً إلَّا رُفِعَ بها دَرَجةً، أو حُطَّت عنه بها خَطيئةٌ، والمَلائِكةُ تُصَلِّي على أحَدِكُم ما دامَ في مُصَلَّاه الذي يُصَلِّي فيه: اللهُمَّ صَلِّ عليه، اللهُمَّ ارحَمْه","explicit":true,"star":true,"similar":["س-07970","س-01463"],"otherNeedIds":[11,24],"ref":"صحيح البخاري 2119","srcLabel":"متفق عليه","text":["صَلاةُ أحَدِكُم في جَماعةٍ تَزيدُ على صَلاتِه في سوقِه وبَيتِه بِضعًا وعِشرينَ دَرَجةً؛ وذلك بأنَّه ",["إذا تَوضَّأ فأحسَنَ الوُضوءَ، ثُمَّ أتى المَسجِدَ لا يُريدُ إلَّا الصَّلاةَ، ",1],["لا يَنهَزُه إلَّا الصَّلاةُ- لَم يَخطُ خَطوةً إلَّا رُفِعَ بها دَرَجةً، أو حُطَّت عنه بها خَطيئةٌ، والمَلائِكةُ تُصَلِّي على أحَدِكُم ما دامَ في مُصَلَّاه الذي يُصَلِّي فيه: اللهُمَّ صَلِّ عليه، اللهُمَّ ارحَمْه،",2]," ما لم يُحدِثْ فيه، ما لم يُؤذِ فيه. وقال: أحَدُكُم في صَلاةٍ ما كانَتِ الصَّلاةُ تَحبِسُه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2119)، ومسلم (649)","bab":"ملائكة › أعمال الملائكة","dorar":"BG6JGYAa","merged":2,"otherRefs":["صحيح البخاري 647 (صحيح)"]},{"id":"س-03739","fp":"096f23deceb6","stateId":479,"easy":"إذا أحسنت الطهور ثم عمدت إلى المسجد فصليت ← تُرفع لك بكل خطوة درجة وتُحط خطيئة","cause":"وما من رجُلٍ يتطَهَّرُ، فيحسِنُ الطُّهورَ، فيعمَدُ إلى المسجدِ، فيصلِّي فيهِ، فما يخطو خطوةً","result":"إلَّا رفعَ اللَّهُ لَهُ بِها دَرجةً، وحطَّ عنهُ بِها خطيئةً","explicit":true,"otherNeedIds":[11],"ref":"صحيح ابن ماجه 638","srcLabel":"مسلم","text":["مَن سرَّهُ أن يَلقى اللَّهَ عزَّ وجَلَّ غدًا مُسلِمًا، فليُحافظ علَى هؤلاءِ الصَّلَواتِ الخَمسِ حيثُ يُنادى بِهِنَّ، فإنَّهنَّ مِن سُنَنِ الهدى، وإنَّ اللَّهَ شرَعَ لنبيِّكم صلَّى اللَّهُ عليهِ وسلَّمَ سُنَنَ الهدى، ولعَمري، لو أنَّ كُلَّكُم صلَّى في بيتِهِ، لترَكْتُمْ سنَّةَ نبيِّكم، ولَو ترَكْتُمْ سُنَّةَ نبيِّكُم لضلَلتُمْ، ولقَد رأيتُنا وما يتخَلَّفُ عنها إلَّا مُنافقٌ مَعلومُ النِّفاقِ، ولقَد رَأيتُ الرَّجلَ يُهادى بَينَ الرَّجُلَيْنِ حتَّى يَدخُلَ في الصَّفِّ، ",["وما من رجُلٍ يتطَهَّرُ، فيحسِنُ الطُّهورَ، فيعمَدُ إلى المسجدِ، فيصلِّي فيهِ، فما يخطو خطوةً، ",1],["إلَّا رفعَ اللَّهُ لَهُ بِها دَرجةً، وحطَّ عنهُ بِها خطيئةً",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (777) واللفظ له، وأخرجه مسلم (654) بلفظ مقارب","bab":"اعتصام بالسنة › لزوم السنة","dorar":"IDu69JHL"},{"id":"س-07002","fp":"ae3a01c8cce8","stateId":479,"easy":"إذا أحسنت الوضوء ثم أتيت المسجد فخطوت ← تُرفع لك درجة أو تُحط خطيئة أو تُكتب حسنة","cause":"ما مِن رَجُلٍ يَتوضَّأُ، فيُحسِنُ الوُضوءَ، ثُمَّ يأْتي مَسجدًا مِن المَساجدِ، فيَخطو خُطوةً","result":"إلَّا رُفِعَ بها دَرجةً، أو حُطَّ عنه بها خَطيئةً، أو كُتِبَتْ له بها حسنةً\"، حتى إنْ كنَّا لَنُقارِبُ بينَ الخُطى، \"وإنَّ فَضلَ صلاةِ الرَّجُلِ في جَماعةٍ على صلاتِه وَحده، بخَمسٍ","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"otherNeedIds":[11,45],"ref":"تخريج المسند لشعيب 3623","srcLabel":"مسلم","text":["مَن سَرَّه أنْ يَلقى اللهَ عزَّ وجلَّ غدًا مُسلمًا؛ فلْيُحافِظْ على هؤلاء الصَّلواتِ المَكتوباتِ حيث يُنادى بهنَّ؛ فإنِّهنَّ مِن سُنَنِ الهُدى، وإنَّ اللهَ عزَّ وجلَّ شرَعَ لنبيِّكم سُنَنَ الهُدى، وما منكم إلَّا وله مَسجدٌ في بيتِه، ولو صلَّيْتُم في بُيوتِكم، كما يُصلِّي هذا المُتخلِّفُ في بيتِه؛ لترَكْتم سُنَّةَ نبيِّكم، ولو ترَكْتم سُنَّةَ نبيِّكم لضلَلْتم، ولقد رأَيْتُني وما يَتخلَّفُ عنها إلَّا مُنافقٌ مَعلومٌ نِفاقُه، ولقد رأَيْتُ الرَّجُلَ يُهادَى بينَ الرَّجُلَينِ حتى يُقامَ في الصَّفِّ، وقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: \"",["ما مِن رَجُلٍ يَتوضَّأُ، فيُحسِنُ الوُضوءَ، ثُمَّ يأْتي مَسجدًا مِن المَساجدِ، فيَخطو خُطوةً؛",1]," ",["إلَّا رُفِعَ بها دَرجةً، أو حُطَّ عنه بها خَطيئةً، أو كُتِبَتْ له بها حسنةً\"، حتى إنْ كنَّا لَنُقارِبُ بينَ الخُطى، \"وإنَّ فَضلَ صلاةِ الرَّجُلِ في جَماعةٍ على صلاتِه وَحده، بخَمسٍ",2]," وعشرينَ دَرجةً\"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه مسلم (654)، وأبو داود (550)، والنسائي (849)، وابن ماجه (777) مختصراً، وأحمد (3623) واللفظ له","bab":"علم › الحث على الأخذ بالسنة","dorar":"DwsVWYgX"},{"id":"س-07970","fp":"9db7625591f5","stateId":479,"easy":"إذا أحسنت الوضوء ثم أتيت المسجد لا يدفعك إلا الصلاة ← تُرفع لك بكل خطوة درجة وتُحط خطيئة","cause":"إذَا تَوَضَّأَ فأحْسَنَ الوُضُوءَ ، ثُمَّ أَتَى المَسْجِدَ لا يَنْهَزُهُ إلَّا الصَّلَاةُ، لا يُرِيدُ إلَّا الصَّلَاةَ","result":"فَلَمْ يَخْطُ خَطْوَةً إلَّا رُفِعَ له بهَا دَرَجَةٌ، وَحُطَّ عنْه بهَا خَطِيئَةٌ، حتَّى يَدْخُلَ المَسْجِدَ","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"repOf":"س-08100","otherNeedIds":[11],"ref":"عارضة الأحوذي 6/304","text":["حديث  أنَّهُ لا يخطو خطوةً إلا كتب اللهُ لهُ بها حسنةً ومحا عنهُ بها سيئةً ورفعَه بها درجةً [يعني حديث: قالَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ: صَلَاةُ الرَّجُلِ في جَمَاعَةٍ تَزِيدُ علَى صَلَاتِهِ في بَيْتِهِ، وَصَلَاتِهِ في سُوقِهِ، بضْعًا وَعِشْرِينَ دَرَجَةً، وَذلكَ أنَّ أَحَدَهُمْ ",["إذَا تَوَضَّأَ فأحْسَنَ الوُضُوءَ ، ثُمَّ أَتَى المَسْجِدَ لا يَنْهَزُهُ إلَّا الصَّلَاةُ، لا يُرِيدُ إلَّا الصَّلَاةَ",1],"، ",["فَلَمْ يَخْطُ خَطْوَةً إلَّا رُفِعَ له بهَا دَرَجَةٌ، وَحُطَّ عنْه بهَا خَطِيئَةٌ، حتَّى يَدْخُلَ المَسْجِدَ",2],"، فَإِذَا دَخَلَ المَسْجِدَ كانَ في الصَّلَاةِ ما كَانَتِ الصَّلَاةُ هي تَحْبِسُهُ، وَالْمَلَائِكَةُ يُصَلُّونَ علَى أَحَدِكُمْ ما دَامَ في مَجْلِسِهِ الذي صَلَّى فيه يقولونَ: اللَّهُمَّ ارْحَمْهُ، اللَّهُمَّ اغْفِرْ له، اللَّهُمَّ تُبْ عليه، ما لَمْ يُؤْذِ فِيهِ، ما لَمْ يُحْدِثْ فِيهِ.]"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"صحيح","bab":"مساجد ومواضع الصلاة › فضل من غدا إلى المسجد أو راح","dorar":"HzQfmfaA","merged":3,"otherRefs":["صحيح الترمذي 603 (صحيح)","صحيح ابن خزيمة 3/ 22 (صحيح)"]},{"id":"س-01463","fp":"693339f31991","stateId":479,"easy":"إذا أحسنت الوضوء ثم خرجت إلى الصلاة لا يخرجك غيرها ← تُرفع لك بكل خطوة درجة وتُحط خطيئة","cause":"إذا توضَّأَ الرَّجلُ فأحسَنَ الوضوءَ ثمَّ خرجَ إلى الصَّلاةِ لا يخرِجُه غيرُها لا يخطو خُطوةً إلَّا رفعَه بِها درجةً","result":"وحطَّ عنهُ خطيئةً","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"repOf":"س-08100","otherNeedIds":[11],"ref":"حلية الأولياء 7/237","text":[["إذا توضَّأَ الرَّجلُ فأحسَنَ الوضوءَ ثمَّ خرجَ إلى الصَّلاةِ لا يخرِجُه غيرُها لا يخطو خُطوةً إلَّا رفعَه بِها درجةً ",1],["وحطَّ عنهُ خطيئةً",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"مشهور ثابت من حديث شعبة والأعمش","takhrij":"أخرجه أبو نعيم في ((حلية الأولياء)) (5/60)","bab":"وضوء › فضل الوضوء","dorar":"uK78tDbI"},{"id":"س-06726","fp":"a7d43e333871","stateId":479,"easy":"إذا مشيت إلى الجماعة ← فلو علم المتخلف ما لك لأتاها ولو حبواً","cause":"الماشي إليها","result":"لو يعلَمُ هذا المتخلِّفُ عنِ الصَّلاةِ في الجماعةِ ما لِهَذا الماشي إليها لأتاها ولو حَبوًا على يديهِ ورجلَيهِ","explicit":true,"ref":"الترغيب والترهيب 1/201","srcLabel":"الطبراني","text":[["لو يعلَمُ هذا المتخلِّفُ عنِ الصَّلاةِ في الجماعةِ ما لِهَذا الماشي إليها لأتاها ولو حَبوًا على يديهِ ورجلَيهِ",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني (8/267) (7886) مطولاً","bab":"صلاة الجماعة والإمامة › فضل صلاة الجماعة","dorar":"Hfk1sPcn"},{"id":"س-05796","fp":"6527e55ed3f4","stateId":479,"easy":"إذا كانت دارك قريبة من المسجد ← ففضل البعيد عليك كفضل الغازي على القاعد","cause":"الدارِ القريبةِ منَ المسجدِ","result":"كفضلِ الغازي على القاعدِ","explicit":true,"ref":"الجامع الصغير 5837","srcLabel":"أحمد","text":["فضلُ ",["الدارِ القريبةِ منَ المسجدِ",1]," على الدارِ الشاسعةِ، ",["كفضلِ الغازي على القاعدِ",2]],"grade":"حسن","narrator":"حذيفة بن اليمان","muhaddith":"حسن","takhrij":"أخرجه أحمد (23287)، والديلمي في ((الفردوس)) (4354) واللفظ لهما، والعدني كما في ((إتحاف الخيرة المهرة)) للبوصيري (2/59) باختلاف يسير","bab":"رقائق وزهد › الوصايا النافعة","dorar":"uSqwced8"},{"id":"س-07968","fp":"efa8d36a98eb","stateId":479,"easy":"إذا خطوت إلى المسجد ← يرفعك الله بكل خطوة درجة ويحط خطيئة","cause":"وإنَّكَ لن تخطوَ خطوةً","result":"إلا رفَعَكَ اللهُ بها درجةً ، وحَطَّ عنكَ بها خطيئةً","explicit":true,"otherNeedIds":[11],"ref":"إتحاف الخيرة المهرة 2/30","srcLabel":"ابن المبارك","text":["لَقيَني الزبيرُ وأنا أريدُ المسجدَ قلتُ ، : أين تريدُ ؟ فقال : أريدُ المسجدَ ، فقال : أقصِرْ فإنَّكَ في صلاةٍ ، ",["وإنَّكَ لن تخطوَ خطوةً",1]," ",["إلا رفَعَكَ اللهُ بها درجةً ، وحَطَّ عنكَ بها خطيئةً",2]],"grade":"حسن","narrator":"سفيان بن زياد","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن المبارك في ((الزهد)) (9)، وابن أبي شيبة (7485)، والخطيب البغدادي في ((المتفق والمفترق)) (2/ 112) باختلاف يسير.","bab":"مساجد ومواضع الصلاة › فضل من غدا إلى المسجد أو راح","dorar":"ipfYjgij"},{"id":"س-05811","fp":"9082429f41fc","stateId":479,"easy":"إذا مشيت إلى الصلاة ← لك بكل خطوة درجة","cause":"بكلِّ خُطوةٍ","result":"درجةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشعيب 14611","srcLabel":"مسلم","text":["أسمِعَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ في كَثرةِ خُطا الرَّجلِ إلى المسجِدِ شيئًا؟ فقال: همَمْنا أنْ ننتَقِلَ من دورِنا إلى المدينةِ لقُربِ المسجِدِ، فزجَرَنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ عن ذلك، وقال: لا تُعْروا المدينةَ؛ فإنَّ لكم فَضيلةً على مَن عندَ المسجِدِ ",["بكلِّ خُطوةٍ",1]," ",["درجةٌ",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه مسلم (664)، وأحمد (14611) واللفظ له","bab":"رقائق وزهد › الوصايا النافعة","dorar":"OWMVky9a","merged":2,"otherRefs":["صحيح الجامع 2161 (صحيح)"]},{"id":"س-06484","fp":"49b4002ff1dd","stateId":480,"easy":"إذا علمت فضل الصف المقدم ← لاستهمت عليه","cause":"الصَّفِّ المُقَدَّمِ","result":"لَاسْتَهَمُوا","explicit":true,"star":true,"similar":["س-02156","س-02008"],"ref":"فتح الباري لابن حجر 56/2","srcLabel":"متفق عليه","text":["لو يَعلَمونَ ما في الصُّبحِ والعِشاءِ [ لَأَتَوْهُما ولو حَبْوًا، ولو يَعْلَمُونَ ما في ",["الصَّفِّ المُقَدَّمِ",1]," ",["لَاسْتَهَمُوا",2],".]"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"ثابت","takhrij":"أخرجه البخاري (2689)، ومسلم (437)، والنسائي (540) بنحوه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"NOPGsCWt"},{"id":"س-06639","fp":"1be71de35c72","stateId":480,"easy":"إذا صليت في الصف المقدم ← فهو على مثل صف الملائكة","cause":"الصَّفَّ المُقدَّمَ","result":"على مِثلِ صَفِّ المَلائِكةِ، ولو تَعلَمونَ فَضيلتَه لابْتَدَرْتُموه","explicit":true,"star":true,"ref":"الأحاديث المختارة 1196","srcLabel":"البخاري","text":["«كُنْتُ معَ أُبَيِّ بنِ كَعْبٍ في مَرَضِه، فسَمِعَ المُناديَ بالأذانِ، فقالَ: الأذانُ هذا أو الإقامةُ؟ فقُلْنا: الإقامةُ، فقالَ: ما تَنْتَظِرونَ؟ أَلَا تَنْهَضونَ إلى صَلاتِكم؟ فقُلْنا: ما بِنا إلَّا مَكانُك، فقالَ: لا تَفعَلوا قُوموا، إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ صلَّى بِنا صَلاةَ الفَجْرِ، فلمَّا سلَّمَ أَقبَلَ على القَوْمِ بوَجْهِه، فقالَ: أَشاهِدٌ فُلانٌ، حتَّى دَعا ثَلاثةً كلُّهم في مَنازِلِهم لم يَحْضُروا، فقالَ: إنَّ أَثقَلَ الصَّلاةِ على المُنافِقينَ صَلاةُ الفَجْرِ والعِشاءِ، ولو يَعلَمونَ ما فيهما لَأَتَوْهما ولو حَبْوًا، واعْلَمْ أنَّ صَلاتَك معَ رَجُلٍ أَفضَلُ مِن صَلاتِك وَحْدَك، وأنَّ صَلاتَك معَ رَجُلَينِ أَفضَلُ مِن صَلاتِك معَ رَجُلٍ، وما كانَ أَكثَرَ فهو أَحَبُّ إلى اللهِ، أَلَا وإنَّ ",["الصَّفَّ المُقدَّمَ",1]," ",["على مِثلِ صَفِّ المَلائِكةِ، ولو تَعلَمونَ فَضيلتَه لابْتَدَرْتُموه",2],"، أَلَا وإنَّ صَلاةَ الجَماعةِ تَفضُلُ على صِلاةِ الرَّجُلِ وَحْدَه أرْبَعًا وعِشْرينَ أو خَمْسًا وعِشْرينَ دَرَجةً»."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"EGIRXhcj"},{"id":"س-02156","fp":"37e2b6e6a487","stateId":480,"easy":"إذا علمت فضل الصف المقدم ← لتسابقت عليه بالقرعة","cause":"الصَّفِّ المُقدَّمِ","result":"لَكانَت قُرعةً","explicit":true,"repOf":"س-06484","ref":"صحيح مسلم 439","text":["لَو تَعلَمونَ -أو يَعلَمونَ- ما في ",["الصَّفِّ المُقدَّمِ",1]," ",["لَكانَت قُرعةً",2],". وقال ابنُ حَربٍ: الصَّفِّ الأوَّلِ ما كانَت إلَّا قُرعةً."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (439)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"vTfwdgIJ"},{"id":"س-06675","fp":"58e535a73d95","stateId":480,"easy":"إذا صلّت النساء في آخر الصفوف ← فهو خير صفوفهن","cause":"النِّساءِ في الصَّلاةِ آخِرُها","result":"وخَيرُ صُفوفِ","explicit":true,"ref":"تخريج المسند لشعيب 10290","srcLabel":"مسلم","text":["أحسِنوا إقامةَ الصُّفوفِ في الصَّلاةِ، خَيرُ صُفوفِ الرِّجالِ في الصَّلاةِ أوَّلُها، وشَرُّها آخِرُها، ",["وخَيرُ صُفوفِ",2]," ",["النِّساءِ في الصَّلاةِ آخِرُها",1],"، وشَرُّها أوَّلُها."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (440)، وأبو داود (678)، والترمذي (224)، والنسائي (820)، وابن ماجه (1000)، وأحمد (10290) واللفظ له","bab":"صلاة الجماعة والإمامة › إقامة الصفوف ووصلها وفضائلها","dorar":"ueI16PMV"},{"id":"س-08162","fp":"6f55c68b38ef","stateId":480,"easy":"إذا سددت فرجة في الصف ← يرفعك الله بها درجة","cause":"ومَن سدَّ فرجةً","result":"رفعَهُ اللَّهُ بِها درجةً","explicit":true,"otherNeedIds":[67],"ref":"صحيح ابن ماجه 821","srcLabel":"ابن ماجه","text":["إنَّ اللَّهَ وملائِكتَهُ يُصَلُّونَ على الَّذينَ يَصِلونَ الصُّفوفَ، ",["ومَن سدَّ فرجةً ",1],["رفعَهُ اللَّهُ بِها درجةً",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (995)، وأحمد (24587)","bab":"ملائكة › أعمال الملائكة","dorar":"d4PuHbxM","merged":3,"otherRefs":["السلسلة الصحيحة 1892 (صحيح)","صحيح الترغيب 505 (صحيح)"]},{"id":"س-06665","fp":"70417c9ead90","stateId":480,"easy":"إذا صليت في الصف الأول ← يصلي عليك النبي ﷺ ثلاثاً","cause":"على الصَّفِّ الأوَّلِ المُقدَّمِ","result":"كان يُصلِّي على الصَّفِّ الأوَّلِ المُقدَّمِ ثلاثًا وعلى الثَّاني مرَّةً","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"similar":["س-06667"],"otherNeedIds":[24],"ref":"تخريج صحيح ابن حبان 2158","srcLabel":"النسائي","text":["عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم: أنَّه ",["كان يُصلِّي على الصَّفِّ الأوَّلِ المُقدَّمِ ثلاثًا وعلى الثَّاني مرَّةً",2]],"grade":"صحيح","narrator":"العرباض بن سارية","muhaddith":"صحيح","takhrij":"أخرجه النسائي (817)، وأحمد (17157)، وابن أبي شيبة (3813)، وابن حبان (2158) واللفظ لهم جميعا.","bab":"صلاة الجماعة والإمامة › إقامة الصفوف ووصلها وفضائلها","dorar":"pGl3CYiO","merged":3,"otherRefs":["تخريج المسند لشعيب 17157 (صحيح)","تخريج المسند لشعيب 17162 (صحيح)"]},{"id":"س-06667","fp":"14c8955eadc3","stateId":480,"easy":"إذا صليت في الصف المقدم ← يستغفر لك النبي ﷺ ثلاثاً","cause":"للصَّفِّ المُقَدَّمِ","result":"كان يَستغفِرُ للصَّفِّ المُقَدَّمِ ثلاثَ مِرارٍ، وللثاني مرَّةً","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"repOf":"س-06665","otherNeedIds":[11],"ref":"تخريج المسند لشعيب 17148","text":["أنَّ رسولَ  اللهِ صلَّى اللهُ عليه وسلَّمَ ",["كان يَستغفِرُ للصَّفِّ المُقَدَّمِ ثلاثَ مِرارٍ، وللثاني مرَّةً",2],"."],"grade":"صحيح","narrator":"العرباض بن سارية","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (996)، وأحمد (17148) واللفظ له","bab":"صلاة الجماعة والإمامة › إقامة الصفوف ووصلها وفضائلها","dorar":"TndOQq4r","merged":3,"otherRefs":["صحيح الترغيب 490 (صحيح)","الترغيب والترهيب 1/230 (صحيح)"]},{"id":"س-08115","fp":"a54556ac0991","stateId":480,"easy":"إذا وصلت صفاً ← يرفعك الله به درجة وتذر عليك الملائكة البر","cause":"ولا يَصلُ عَبدٌ صفًّا","result":"إلَّا رفعَهُ اللَّهُ بِهِ درجةً وذرَتْ عليهِ الملائِكَةُ منَ البِرِّ","explicit":true,"ref":"الترغيب والترهيب 1/235","srcLabel":"الطبراني","text":["إنَّ اللَّهَ وملائِكَتَهُ يصلُّونَ على الَّذينَ يصلونَ الصُّفوفَ ، ",["ولا يَصلُ عَبدٌ صفًّا",1]," ",["إلَّا رفعَهُ اللَّهُ بِهِ درجةً وذرَتْ عليهِ الملائِكَةُ منَ البِرِّ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"لا بأس بإسناده","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (3771)","bab":"ملائكة › أعمال الملائكة","dorar":"NjcWFsGm"},{"id":"س-02008","fp":"a5216a7c0efb","stateId":480,"easy":"إذا علمت ما في الصف الأول ← لاستهمت عليه","cause":"الصَّفِّ الأوَّلِ","result":"ما كانَ إلَّا قُرعةً","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-06484","ref":"صحيح ابن خزيمة 3/ 74","text":["لَو يعلَمونَ أو تعلمونَ ما في ",["الصَّفِّ الأوَّلِ",1]," ",["ما كانَ إلَّا قُرعةً",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (2689)، ومسلم (437)، والنسائي (540) بنحوه تامًا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"cRwYXUXi"},{"id":"س-06635","fp":"eaedd1aa6ac2","stateId":481,"easy":"إذا علمت ما في الفجر والعشاء ← لأتيتهما ولو حبواً","cause":"صَلاةُ الفَجْرِ والعِشاءِ","result":"ولو يَعلَمونَ ما فيهما لَأَتَوْهما ولو حَبْوًا","explicit":true,"star":true,"similar":["س-00746","س-05091"],"ref":"الأحاديث المختارة 1196","srcLabel":"البخاري","text":["«كُنْتُ معَ أُبَيِّ بنِ كَعْبٍ في مَرَضِه، فسَمِعَ المُناديَ بالأذانِ، فقالَ: الأذانُ هذا أو الإقامةُ؟ فقُلْنا: الإقامةُ، فقالَ: ما تَنْتَظِرونَ؟ أَلَا تَنْهَضونَ إلى صَلاتِكم؟ فقُلْنا: ما بِنا إلَّا مَكانُك، فقالَ: لا تَفعَلوا قُوموا، إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ صلَّى بِنا صَلاةَ الفَجْرِ، فلمَّا سلَّمَ أَقبَلَ على القَوْمِ بوَجْهِه، فقالَ: أَشاهِدٌ فُلانٌ، حتَّى دَعا ثَلاثةً كلُّهم في مَنازِلِهم لم يَحْضُروا، فقالَ: إنَّ أَثقَلَ الصَّلاةِ على المُنافِقينَ ",["صَلاةُ الفَجْرِ والعِشاءِ",1],"، ",["ولو يَعلَمونَ ما فيهما لَأَتَوْهما ولو حَبْوًا",2],"، واعْلَمْ أنَّ صَلاتَك معَ رَجُلٍ أَفضَلُ مِن صَلاتِك وَحْدَك، وأنَّ صَلاتَك معَ رَجُلَينِ أَفضَلُ مِن صَلاتِك معَ رَجُلٍ، وما كانَ أَكثَرَ فهو أَحَبُّ إلى اللهِ، أَلَا وإنَّ الصَّفَّ المُقدَّمَ على مِثلِ صَفِّ المَلائِكةِ، ولو تَعلَمونَ فَضيلتَه لابْتَدَرْتُموه، أَلَا وإنَّ صَلاةَ الجَماعةِ تَفضُلُ على صِلاةِ الرَّجُلِ وَحْدَه أرْبَعًا وعِشْرينَ أو خَمْسًا وعِشْرينَ دَرَجةً»."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"EGIRXhcj","merged":12,"otherRefs":["تخريج المسند لشعيب 21266 (حسن)","صحيح البخاري 657 (صحيح)","تخريج المسند لشعيب 8890 (صحيح)","تخريج المسند لشعيب 12533 (صحيح)","تخريج المسند لشعيب 21272 (حسن)","المستدرك على الصحيحين 831 (صحيح)","تخريج مشكل الآثار 995 (صحيح)","صحيح الجامع 5340 (صحيح)","صحيح ابن خزيمة 3/ 11 (صحيح)","صحيح ابن خزيمة 3/ 18 (صحيح)","الأحاديث المختارة 1198 (صحيح)"]},{"id":"س-06640","fp":"d03ea4b82779","stateId":481,"easy":"إذا صليت في جماعة ← تفضل صلاتك وحدك بأربع أو خمس وعشرين","cause":"أَلَا وإنَّ صَلاةَ الجَماعةِ","result":"تَفضُلُ على صِلاةِ الرَّجُلِ وَحْدَه أرْبَعًا وعِشْرينَ أو خَمْسًا وعِشْرينَ دَرَجةً","explicit":true,"star":true,"similar":["س-08128","س-06575","س-06590","س-08110","س-02228","س-01982"],"otherNeedIds":[45],"ref":"الأحاديث المختارة 1196","srcLabel":"البخاري","text":["«كُنْتُ معَ أُبَيِّ بنِ كَعْبٍ في مَرَضِه، فسَمِعَ المُناديَ بالأذانِ، فقالَ: الأذانُ هذا أو الإقامةُ؟ فقُلْنا: الإقامةُ، فقالَ: ما تَنْتَظِرونَ؟ أَلَا تَنْهَضونَ إلى صَلاتِكم؟ فقُلْنا: ما بِنا إلَّا مَكانُك، فقالَ: لا تَفعَلوا قُوموا، إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ صلَّى بِنا صَلاةَ الفَجْرِ، فلمَّا سلَّمَ أَقبَلَ على القَوْمِ بوَجْهِه، فقالَ: أَشاهِدٌ فُلانٌ، حتَّى دَعا ثَلاثةً كلُّهم في مَنازِلِهم لم يَحْضُروا، فقالَ: إنَّ أَثقَلَ الصَّلاةِ على المُنافِقينَ صَلاةُ الفَجْرِ والعِشاءِ، ولو يَعلَمونَ ما فيهما لَأَتَوْهما ولو حَبْوًا، واعْلَمْ أنَّ صَلاتَك معَ رَجُلٍ أَفضَلُ مِن صَلاتِك وَحْدَك، وأنَّ صَلاتَك معَ رَجُلَينِ أَفضَلُ مِن صَلاتِك معَ رَجُلٍ، وما كانَ أَكثَرَ فهو أَحَبُّ إلى اللهِ، أَلَا وإنَّ الصَّفَّ المُقدَّمَ على مِثلِ صَفِّ المَلائِكةِ، ولو تَعلَمونَ فَضيلتَه لابْتَدَرْتُموه، ",["أَلَا وإنَّ صَلاةَ الجَماعةِ",1]," ",["تَفضُلُ على صِلاةِ الرَّجُلِ وَحْدَه أرْبَعًا وعِشْرينَ أو خَمْسًا وعِشْرينَ دَرَجةً",2],"»."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"EGIRXhcj","merged":15,"otherRefs":["تخريج المسند لشعيب 5779 (صحيح)","أعلام الموقعين 2/274 (صحيح)","صحيح النسائي 838 (صحيح)","المحلى 4/191 (صحيح)","صحيح مسلم 650 (صحيح)","تخريج المسند لشعيب 9860 (صحيح)","صحيح ابن خزيمة 3/ 22 (صحيح)","إتحاف الخيرة المهرة 2/134 (صحيح)","صحيح ابن ماجه 648 (صحيح)","صحيح الجامع 3824 (صحيح)","صحيح البخاري 645 (صحيح)","أطراف الغرائب 2/360 (صحيح)","صحيح ابن خزيمة 3/ 6 (صحيح)","عارضة الأحوذي 6/304 (صحيح)"]},{"id":"س-08128","fp":"6c96ba9acbd4","stateId":481,"easy":"إذا صليت في الجماعة ← تفضل صلاتك وحدك بخمسة وعشرين جزءاً","cause":"صلاةُ الجمْعِ","result":"تفضل صلاةُ الجمْعِ، على صلاةِ أحدِكم وحده بخمسةٍ وعشرين جزءًا","explicit":true,"repOf":"س-06640","otherNeedIds":[49],"ref":"صحيح النسائي 485","text":[["تفضل صلاةُ الجمْعِ، على صلاةِ أحدِكم وحده بخمسةٍ وعشرين جزءًا",2],"، ويجتمع ملائكةُ الليلِ والنهار في صلاة الفجرِ، واقرؤوا إن شئتُم { وَقُرْآنَ الْفَجْرِ إِنَّ قُرْآنَ الْفَجْرِ كَانَ مَشْهُودًا}"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (486) واللفظ له، وأخرجه البخاري (648)، ومسلم (649) باختلاف يسير","bab":"ملائكة › أعمال الملائكة","dorar":"CcAutxY8","merged":7,"otherRefs":["صحيح الجامع 4215 (صحيح)","تخريج المسند لشعيب 10798 (صحيح)","معرفة السنن والآثار 5615 (صحيح)","تخريج سير أعلام النبلاء 9/230 (صحيح)","شرح السنة 2/364 (صحيح)","التمهيد 14/137 (صحيح)"]},{"id":"س-06575","fp":"8dfa5bd0cd78","stateId":481,"easy":"إذا صليت في الجماعة ← تفضل صلاتك وحدك بخمس وعشرين","cause":"تَفْضُلُ الصَّلاةُ في الـجَميعِ","result":"على صَلاةِ الرَّجُلِ وَحْدَه خَـمْسًا وعشرين","explicit":true,"repOf":"س-06640","ref":"تخريج المسند لشعيب 7185","text":[["تَفْضُلُ الصَّلاةُ في الـجَميعِ",1]," ",["على صَلاةِ الرَّجُلِ وَحْدَه خَـمْسًا وعشرين",2],"، وتَـجْتَمِعُ مَلائكةُ اللَّيلِ وملائكةُ النَّهارِ في صَلاةِ الفَجْرِ، ثم يَقولُ أَبو هريرةَ: اقْرَؤوا إنْ شِئْتُم: {وَقُرْآنَ الْفَجْرِ إنَّ قُرْآنَ الْفَجْرِ كَانَ مَشْهُودًا} [الإسراء: 78]."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (648)، ومسلم (649) باختلاف يسير","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"rQ4cy58E","merged":4,"otherRefs":["الصحيح المسند 835 (صحيح)","تخريج المسند لشعيب 10299 (صحيح)","تخريج المسند لشعيب 4323 (صحيح)"]},{"id":"س-06590","fp":"bd228807bf80","stateId":481,"easy":"إذا صليت في جماعة ← تزيد على صلاتك وحدك بخمس وعشرين درجة، وفي الفلاة أكثر","cause":"صلاةُ الرجلِ في جماعةٍ تَزِيدُ على صلاتِهِ وحْدَهُ بخمسٍ و عشرينَ درجةً","result":"فإنْ صَلاها بِأرضِ قِيٍّ فَأَتَمَّ رُكُوعَها ، و سُجُودَها ، تُكْتَبُ صلاتُهُ بِخمسينَ درجةً","explicit":true,"repOf":"س-06640","ref":"صحيح الترغيب 413","text":[["صلاةُ الرجلِ في جماعةٍ تَزِيدُ على صلاتِهِ وحْدَهُ بخمسٍ و عشرينَ درجةً ، ",1],["فإنْ صَلاها بِأرضِ قِيٍّ فَأَتَمَّ رُكُوعَها ، و سُجُودَها ، تُكْتَبُ صلاتُهُ بِخمسينَ درجةً",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (1749) بلفظه، والبخاري (646)، وأبو داود (560)، وابن ماجه (788) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"zTIrpgsb"},{"id":"س-07548","fp":"faeb0ef78b31","stateId":481,"easy":"إذا جلست في المساجد ← فهي رياض الجنة","cause":"المساجِدِ","result":"رِياضِ الجَنَّةِ","explicit":true,"apply":{"k":"time","t":"في السجود"},"otherNeedIds":[67],"ref":"تخريج المسند لشعيب 9154","srcLabel":"متفق عليه","text":["مِثْلَ حَديثِ خُبَيْبٍ، عن حَفْصٍ لم يَزِدْ ولم يَنقُصْ. [أي حديثِ: إنَّ مِنبَري على حَوْضي، وإنَّ ما بيْنَ مِنبَري وبيْنَ بَيْتي رَوْضةٌ مِن ",["رِياضِ الجَنَّةِ",2],"، وصَلاةٌ في مَسْجِدي كألْفِ صَلاةٍ فيما سِواهُ من ",["المساجِدِ",1],"، إلَّا المَسجِدَ الحَرامَ]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1196،1190)، ومسلم (1391، 1394) مفرقاً باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › خصائصه صلى الله عليه وسلم","dorar":"HpgN8uFl"},{"id":"س-08110","fp":"5ed72429f398","stateId":481,"easy":"إذا صليت في الجماعة ← تفضل صلاتك وحدك بخمسة وعشرين جزءاً","cause":"تَفضُلُ صَلاةُ الجَميعِ","result":"صَلاةَ أحَدِكُم وحدَه بخَمسٍ وعِشرينَ جُزءًا","explicit":true,"repOf":"س-06640","ref":"صحيح البخاري 648","text":[["تَفضُلُ صَلاةُ الجَميعِ",1]," ",["صَلاةَ أحَدِكُم وحدَه بخَمسٍ وعِشرينَ جُزءًا",2],"، وتَجتَمِعُ مَلائِكةُ اللَّيلِ ومَلائِكةُ النَّهارِ في صَلاةِ الفَجرِ، ثُمَّ يقولُ أبو هُرَيرةَ: فاقرَؤوا إن شِئتُم: {إنَّ قُرآنَ الفَجرِ كان مَشهودًا} [الإسراء: 78] قال شُعَيبٌ: وحدَّثَني نافِعٌ عن عبدِ اللهِ بنِ عُمَرَ، قال: تَفضُلُها بسَبعٍ وعِشرينَ دَرَجةً."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (648، 649)، ومسلم (649)","bab":"ملائكة › أعمال الملائكة","dorar":"87ZAQj9P"},{"id":"س-01893","fp":"13cd5bbc1a8f","stateId":481,"easy":"إذا شددت الرحال إلى المسجد النبوي والكعبة ← فهما خير ما رُكبت إليه الرواحل","cause":"مسجدِي هذا ، و البَيْتُ العَتِيقُ","result":"إِنَّ خَيْرَ ما رُكِبَتْ إليهِ الرَّوَاحِلُ","explicit":true,"ref":"السلسلة الصحيحة 1648","srcLabel":"مسلم","text":[["إِنَّ خَيْرَ ما رُكِبَتْ إليهِ الرَّوَاحِلُ",2]," ",["مسجدِي هذا ، و البَيْتُ العَتِيقُ",1]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد في ((المسند)) (3/350) واللفظ له، والنسائي في ((الكبرى)) (6/411) باختلاف يسير، وابن حبان (4/495) واللفظ له أيضاً.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Qpk0b6G4"},{"id":"س-08187","fp":"cdb4a93fb09f","stateId":481,"easy":"إذا بكّرت إلى الجمعة ← تكتبك الملائكة في السابقين","cause":"الأوَّلَ فالأوَّلَ","result":"كانَ على كلِّ بابٍ مِن أبوابِ المسجِدِ ملائِكَةٌ ، يَكْتُبونَ","explicit":true,"similar":["س-02773","س-05453","س-01972","س-01996"],"ref":"صحيح النسائي 1385","srcLabel":"النسائي","text":["إذا كانَ يومُ الجمُعةِ ، ",["كانَ على كلِّ بابٍ مِن أبوابِ المسجِدِ ملائِكَةٌ ، يَكْتُبونَ",2]," النَّاسَ علَى مَنازلِهِم ؛ ",["الأوَّلَ فالأوَّلَ",1]," ، فإذا خرجَ الإمامُ طوَيتِ الصُّحُفُ ، واستَمعوا الخطبةَ ، فالمُهَجِّرُ إلى الصَّلاةِ كالمُهْدي بدَنةً ، ثمَّ الَّذي يَليهِ كالمُهْدي بقَرةً ، ثمَّ الَّذي يليهِ كالمُهْدي كَبشًا . حتَّى ذَكَرَ الدَّجاجةَ والبيضَةَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (1386) واللفظ له، وابن ماجه (1092)، وأحمد (7258)","bab":"ملائكة › أعمال الملائكة","dorar":"ubXTZGfP","merged":7,"otherRefs":["تخريج المسند لشعيب 10646 (صحيح)","إتحاف الخيرة المهرة 2/280 (حسن)","تخريج المسند لشاكر 16/218 (حسن)","الترغيب والترهيب 1/344 (حسن)","صحيح الجامع 2909 (صحيح)","صحيح الجامع 774 (صحيح)"]},{"id":"س-06654","fp":"fe2601baa77a","stateId":481,"easy":"إذا انتظرت العشاء ← فأبشر فإنها نعمة الله عليك","cause":"أعتَمَ بالصَّلاةِ حتَّى ابهارَّ اللَّيلُ، ثُمَّ خَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فصَلَّى بهِم","result":"وأبشِروا أنَّ مِن نِعمةِ اللهِ علَيكُم أنَّه ليس مِنَ النَّاسِ أحَدٌ يُصَلِّي هذه السَّاعةَ غَيرُكُم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[6],"ref":"صحيح مسلم 641","srcLabel":"البخاري","text":["كُنتُ أنا وأصحابي الذينَ قدِموا مَعي في السَّفينةِ نُزولًا في بَقيعِ بُطحانَ، ورَسولُ اللهِ صلَّى اللهُ عليه وسلَّم بالمَدينةِ، فكان يَتَناوبُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم عِندَ صَلاةِ العِشاءِ كُلَّ لَيلةٍ نَفَرٌ منهم، قال أبو موسى: فوافَقنا رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم أنا وأصحابي ولَه بَعضُ الشُّغلِ في أمرِه، حتَّى ",["أعتَمَ بالصَّلاةِ حتَّى ابهارَّ اللَّيلُ، ثُمَّ خَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فصَلَّى بهِم",1],"، فلَمَّا قَضى صَلاتَه قال لمَن حَضَرَه: على رِسلِكُم، أُعلمُكُم، ",["وأبشِروا أنَّ مِن نِعمةِ اللهِ علَيكُم أنَّه ليس مِنَ النَّاسِ أحَدٌ يُصَلِّي هذه السَّاعةَ غَيرُكُم",2],"، أو قال: ما صَلَّى هذه السَّاعةَ أحَدٌ غَيرُكُم، لا نَدري أيَّ الكَلِمَتَينِ قال، قال أبو موسى: فرَجَعنا فرِحينَ بما سَمِعنا مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (567) باختلاف يسير","bab":"صلاة › مواقيت الصلاة","dorar":"p5JHumQg"},{"id":"س-01497","fp":"1ccbc8a195c4","stateId":481,"easy":"إذا شهدت الصلاة في الجماعة ← تُكتب لك خمس وعشرون صلاة ويُكفّر ما بينهما","cause":"و شاهِدُ الصلاةِ","result":"يُكتَبُ له خَمسٌ و عِشرُونَ صَلاةً ، و يُكَفَّرُ عنهُ ما بَينَهُما","explicit":true,"similar":["س-01500"],"otherNeedIds":[11,45],"ref":"صحيح الجامع 6644","srcLabel":"أبو داود","text":["المُؤَذِّنُ يُغفَرُ له مَدَى صَوتِه ، و يَشهدُ له كُلُّ رَطْبٍ و يابِسٍ ، ",["و شاهِدُ الصلاةِ",1]," ",["يُكتَبُ له خَمسٌ و عِشرُونَ صَلاةً ، و يُكَفَّرُ عنهُ ما بَينَهُما",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (515) واللفظ له، والنسائي (645)، وابن ماجه (724)، وأحمد (9317)","bab":"أذان › فضل التأذين","dorar":"zVT7UuAj","merged":2,"otherRefs":["الترغيب والترهيب 1/143 (صحيح)"]},{"id":"س-06544","fp":"ef69c8ed5822","stateId":481,"easy":"إذا صليت الصبح يوم الجمعة في جماعة ← فهي أفضل الصلوات","cause":"صَلاةُ الصُّبْحِ يَوْمَ الجُمُعةِ في جَماعةٍ","result":"إنَّ أَفضَلَ الصَّلَواتِ","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"otherNeedIds":[45],"ref":"الأحكام الوسطى 2/ 114","srcLabel":"الطبراني","text":[["إنَّ أَفضَلَ الصَّلَواتِ",2]," ",["صَلاةُ الصُّبْحِ يَوْمَ الجُمُعةِ في جَماعةٍ",1],"، وما أَحسَبُه شَهِدَها مِنكم إلَّا مَغْفورٌ له."],"grade":"صحيح","narrator":"أبو عبيدة بن الجراح","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه البزار (1279) واللفظ له، والطبراني في ((الأوسط)) (184)، وأبو نعيم في ((معرفة الصحابة)) (592) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"4QFV1DL1","merged":2,"otherRefs":["الجامع الصغير 7650 (حسن)"]},{"id":"س-06658","fp":"92fde9cf2253","stateId":481,"easy":"إذا أخّرت العشاء ← فقد فُضّلتم بها على سائر الأمم","cause":"أعتِموا بهذه الصَّلاةِ","result":"فإنَّكم قدْ فُضِّلْتُمْ بها على سائرِ الأُمَمِ؛ لمْ تُصَلِّها أُمَّةٌ قَبْلَكم","explicit":true,"ref":"تخريج مشكل الآثار 993","srcLabel":"أبو داود","text":["بَقَيْنا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ في صلاةِ العَتَمَةِ ليلةً، فتأخَّر بها حتى ظنَّ الظَّانُّ أنَّه قدْ صلَّى، أو ليْسَ بخارجٍ، ثمَّ إنَّه خرَج. فقال له قائلٌ: لقدْ ظنَنَّا أنَّكَ صلَّيْتَ، أو لسْتَ بخارجٍ، فقال نبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["أعتِموا بهذه الصَّلاةِ",1],"، ",["فإنَّكم قدْ فُضِّلْتُمْ بها على سائرِ الأُمَمِ؛ لمْ تُصَلِّها أُمَّةٌ قَبْلَكم",2],"."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (993) بلفظه، وأبو داود (421)، وأحمد (22066 ) كلاهما باختلاف يسير.","bab":"صلاة › مواقيت الصلاة","dorar":"dGvCGiVG","merged":2,"otherRefs":["تخريج سنن أبي داود 421 (صحيح)"]},{"id":"س-07965","fp":"9f7ab29e21d9","stateId":481,"easy":"إذا قممت المسجد (نظفته) ← يُعرف قدرك عند الله (من واقعة)","cause":"كان يَقُمُّ المَسجِدَ","result":"دُلُّوني على قَبرِه","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[63],"ref":"صحيح البخاري 458","srcLabel":"مسلم","text":["أنَّ رَجُلًا أسودَ -أوِ امرَأةً سَوداءَ- ",["كان يَقُمُّ المَسجِدَ",1]," فماتَ، فسَألَ النَّبيُّ صلَّى اللهُ عليه وسلَّم عنه، فقالوا: ماتَ، قال: أفلا كُنتُم آذَنتُموني به؟ ",["دُلُّوني على قَبرِه -",2],"أو قال قَبرِها- فأتى قَبرَها فصَلَّى عليها."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (956) باختلاف يسير.","bab":"مساجد ومواضع الصلاة › العناية بالمسجد","dorar":"ppuQz5P0"},{"id":"س-00746","fp":"b92e624b381e","stateId":481,"easy":"إذا علمت ما في العشاء والصبح ← لأتيتهما ولو حبواً","cause":"صلاةِ العَتَمةِ، وصلاةِ الصبْحِ","result":"لأَتَوْهما ولو حَبْوًا","explicit":true,"repOf":"س-06635","ref":"تخريج المسند لشعيب 24506","text":["لو أنَّ الناسَ يَعلَمونَ ما في ",["صلاةِ العَتَمةِ، وصلاةِ الصبْحِ",1],"، ",["لأَتَوْهما ولو حَبْوًا",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (386)، وأحمد (24506) واللفظ لهما، وابن ماجه (796) باختلاف يسير","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"2Ed0zrFX"},{"id":"س-02228","fp":"76a189f62ee5","stateId":481,"easy":"إذا صليت في الجماعة ← تفضل صلاتك وحدك ببضع وعشرين درجة","cause":"صَلاةِ الرجلِ في الجماعةِ","result":"فضلُ صَلاةِ الرجلِ في الجماعةِ على صلاتِهِ وحْدَهُ بِضْعٌ و عِشْرُونَ درجةً","explicit":true,"repOf":"س-06640","ref":"صحيح الترغيب 405","text":[["فضلُ صَلاةِ الرجلِ في الجماعةِ على صلاتِهِ وحْدَهُ بِضْعٌ و عِشْرُونَ درجةً",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه أحمد (3564)، وابن أبي شيبة في ((المسند)) (190)، وأبو يعلى (4995)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"7KMPU9ov"},{"id":"س-06711","fp":"92b92165e2e3","stateId":481,"easy":"إذا صليت مع رجل يؤمك ← فهي أزكى عند الله من صلاة أربعة فرادى","cause":"صلاةُ رجلينِ يؤمُّ أحدُهما صاحبَه","result":"أزكى عندَ اللَّهِ من صلاةِ أربعةٍ تَتْرَى","explicit":true,"ref":"الجامع الصغير 5085","srcLabel":"الحاكم","text":[["صلاةُ رجلينِ يؤمُّ أحدُهما صاحبَه",1]," ",["أزكى عندَ اللَّهِ من صلاةِ أربعةٍ تَتْرَى",2],", وصلاةُ أربعةٍ يؤمُّهم أحدُهم أزكى عندَ اللَّهِ من صلاةِ ثمانيةٍ تترى, وصلاةُ ثمانيةٍ يؤمُّهم أحدُهم أزكى عندَ اللَّهِ من صلاةِ مائةٍ تترى"],"grade":"صحيح","narrator":"قباث بن أشيم الليثي","muhaddith":"صحيح","takhrij":"أخرجه البزار كما في ((كشف الأستار)) للهيثمي (461)، والطبراني (19/ 36)، (73)، والحاكم (6626) جميعهم بلفظه.","bab":"صلاة الجماعة والإمامة › فضل صلاة الجماعة","dorar":"iy9W79mW"},{"id":"س-08106","fp":"5ca58ff0b257","stateId":481,"easy":"إذا أقمت للصلاة في الفلاة ← يصلي معك ملكاك","cause":"فإن أقامَ","result":"صلَّى معَه مَلَكَاه","explicit":true,"ref":"صحيح الترغيب 414","srcLabel":"الطبراني","text":["إذا كان الرَّجلُ بأَرضِ قِيٍّ فحانَتِ الصَّلاةُ ، فلْيتوضَّأْ ، و إن لَم يجد ماءً فليتيَمَّمْ ، ",["فإن أقامَ",1]," ",["صلَّى معَه مَلَكَاه",2]," ، و إن أذَّنَ و أقام صلَّى خلفَه من جُنودِ اللهِ ما لا يُرى طَرَفاهُ"],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (6/249) (6120)، والبيهقي (1982)","bab":"ملائكة › أعمال الملائكة","dorar":"KbIZdCgk"},{"id":"س-08107","fp":"cff98ab816f6","stateId":481,"easy":"إذا أذنت وأقمت في الفلاة ← يصلي خلفك من جنود الله ما لا يُرى طرفاه","cause":"و إن أذَّنَ و أقام","result":"صلَّى خلفَه من جُنودِ اللهِ ما لا يُرى طَرَفاهُ","explicit":true,"ref":"صحيح الترغيب 414","srcLabel":"الطبراني","text":["إذا كان الرَّجلُ بأَرضِ قِيٍّ فحانَتِ الصَّلاةُ ، فلْيتوضَّأْ ، و إن لَم يجد ماءً فليتيَمَّمْ ، فإن أقامَ صلَّى معَه مَلَكَاه ، ",["و إن أذَّنَ و أقام",1]," ",["صلَّى خلفَه من جُنودِ اللهِ ما لا يُرى طَرَفاهُ",2]],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (6/249) (6120)، والبيهقي (1982)","bab":"ملائكة › أعمال الملائكة","dorar":"KbIZdCgk"},{"id":"س-07707","fp":"e549b3ae1266","stateId":481,"easy":"إذا انتظرت الصلاة ← تكون من الذاكرين في ساعة الغفلة","cause":"يَنتظِرونَ الصَّلاةَ","result":"أمَا إنَّه ليس مِن أهلِ هذه الأَديانِ أحدٌ يذكُرُ اللهَ هذه السَّاعةَ غيرُكم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[6],"ref":"تخريج المسند لشعيب 3760","srcLabel":"النسائي","text":["أخَّرَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ صلاةَ العِشاءِ، ثُمَّ خرَجَ إلى المسجدِ، فإذا النَّاسُ ",["يَنتظِرونَ الصَّلاةَ",1],"، قال: \"",["أمَا إنَّه ليس مِن أهلِ هذه الأَديانِ أحدٌ يذكُرُ اللهَ هذه السَّاعةَ غيرُكم",2],"\"، قال: وأُنزِلَ هؤلاء الآياتُ: {لَيْسُوا سَوَاءً مِنْ أَهْلِ الْكِتَابِ}، حتى بلَغَ: {وَمَا يَفْعَلُوا مِنْ خَيْرٍ فَلَنْ يُكْفَرُوهُ وَاللَّهُ عَلِيمٌ بِالْمُتَّقِينَ} [آل عمران: 113-115]."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (11073)، وأحمد (3760) واللفظ له","bab":"قرآن › أسباب النزول","dorar":"GywlAsft","merged":2,"otherRefs":["الصحيح المسند 844 (حسن)"]},{"id":"س-02773","fp":"4e50ba51044d","stateId":481,"easy":"إذا سبقت إلى الجمعة ← تكتبك الملائكة الأول فالأول","cause":"السَّابِقَ، والثَّاني، والثَّالثَ","result":"إنَّ المَلائكةَ تَجيءُ يَومَ الجُمُعةِ، فتَقعُدُ على أبوابِ المَسجِدِ، فيَكتُبون","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-08187","ref":"تخريج المسند لشعيب 10271","text":[["إنَّ المَلائكةَ تَجيءُ يَومَ الجُمُعةِ، فتَقعُدُ على أبوابِ المَسجِدِ، فيَكتُبون",2]," ",["السَّابِقَ، والثَّاني، والثَّالثَ",1],"، والنَّاسَ، على مَنازِلِهم، حتى يَخرُجَ الإمامُ، فإذا خرَجَ الإمامُ طُويتِ الصُّحُفُ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"المرفوع منه صحيح","takhrij":"أخرجه النسائي (1385)، وابن ماجه (1092) باختلاف يسير، وأصله في صحيح البخاري (881)، ومسلم (850)","bab":"إيمان › الملائكة","dorar":"L3accNAX","merged":4,"otherRefs":["تخريج المسند لشعيب 22242 (صحيح)","صحيح الترغيب 710 (حسن)","صحيح الجامع 1958 (حسن)"]},{"id":"س-06515","fp":"bb8551736154","stateId":481,"easy":"إذا أدركت التكبيرة الأولى ← فهي صفوة الصلاة","cause":"التكبيرةُ الأولى","result":"وصفْوةُ الصلاةِ","explicit":true,"similar":["س-06592"],"ref":"الجامع الصغير 7299","srcLabel":"الجامع الصغير","text":["لِكُلِّ شيءٍ صفوةٌ ، ",["وصفْوةُ الصلاةِ",2]," ",["التكبيرةُ الأولى",1]],"grade":"حسن","narrator":"أبو هريرة وعبدالله بن أبي أوفى","muhaddith":"حسن","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"ldpDzjkm"},{"id":"س-06592","fp":"3c1fad53e6f5","stateId":481,"easy":"إذا أدركت التكبيرة الأولى ← فهي أنفة الصلاة (أولها وخيرها)","cause":"التَّكبيرةُ الأُولَى","result":"أنفَةَ الصَّلاةِ","explicit":true,"repOf":"س-06515","ref":"المطالب العالية 1/204","text":["إنَّ لكلِّ شيءٍ أنفَةٌ ، وإنَّ ",["أنفَةَ الصَّلاةِ",2]," ",["التَّكبيرةُ الأُولَى",1]," ، فحافِظُوا علَيها . قال أبو عبيدٍ : فحدَّثتُ بهِ رجاءَ بنَ حَيوةَ فقال : حدَّثتْني أُمُّ الدَّرداءِ ، عن أبي الدَّرداءِ"],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن أبي شيبة (3137)، والبيهقي في ((شعب الإيمان)) (2648) واللفظ لهما، والطبراني في ((مسند الشاميين)) (2114) باختلاف يسير","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"NmhavNNV"},{"id":"س-05453","fp":"0ba0aa54c318","stateId":481,"easy":"إذا بكّرت يوم الجمعة ← يكتبك الملكان الأول فالأول","cause":"الأَوَّلَ فالأَوَّلَ","result":"مَلَكانِ، يَكتُبان","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-08187","ref":"تخريج المسند لشعيب 7687","text":["لا تَطلُعُ الشَّمسُ ولا تَغرُبُ على يَومٍ أَفضَلَ مِن يَومِ الجُمُعَةِ، وما مِن دابَّةٍ إلَّا تَفزَعُ لِيومِ الجُمُعَةِ، إلَّا هذَيْنِ الثَّقلَيْنِ مِن الجِنِّ والإنسِ، على كُلِّ بابٍ مِن أَبوابِ المَسجِدِ ",["مَلَكانِ، يَكتُبان",2]," ",["الأَوَّلَ فالأَوَّلَ",1],"، فكرَجُلٍ قدَّمَ بَدَنةً، وكرَجُلٍ قدَّمَ بَقَرةً، وكرَجُلٍ قدَّمَ شاةً، وكرَجُلٍ قدَّمَ طائِرًا، وكرَجُلٍ قدَّمَ بَيضَةً، فإذا قعَدَ الإمامُ طُوِيَتِ الصُّحُفُ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه النسائي (1387)، وأحمد (7687) واللفظ له","bab":"رقائق وزهد › الخوف من الله","dorar":"OEV3f6vm","merged":4,"otherRefs":["صحيح ابن خزيمة 3/ 250 (صحيح)","تخريج المسند لشعيب 9896 (صحيح)","صحيح مسلم 850 (صحيح)"]},{"id":"س-05091","fp":"81c0dae24f70","stateId":481,"easy":"إذا علمت ما في العشاء والصبح ← لأتيتهما ولو حبواً","cause":"العِشاءَ والصُّبحَ","result":"لأتَوْهما ولو حَبْوًا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-06635","ref":"تخريج المسند لشعيب 10217","text":["لو جُعِلَ لِأحدِهم -أو لِأحدِكم- مِرماتانِ حَسَنَتانِ، أو عَرقٌ مِن شاةٍ سَمينةٍ؛ لَأتَوْها أجمعون، ولو يَعلَمون ما فيهما -يَعني ",["العِشاءَ والصُّبحَ",1],"- ",["لأتَوْهما ولو حَبْوًا",2],"، ولقد همَمتُ أن آمُرَ رَجُلًا يُصَلِّي بالنَّاسِ، ثم آتيَ أقوامًا يتخَلَّفون عنها -أو عن الصَّلاةِ- فأُحرِّقَ عليهم."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (644، 657) مفرقاً، ومسلم (651) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"guoSpHsf","merged":2,"otherRefs":["فتح الباري لابن حجر 56/2 (صحيح)"]},{"id":"س-06572","fp":"64c5f45f293d","stateId":481,"easy":"إذا صليت العصر والصبح ← تشهد لك الملائكة: أتيناهم وهم يصلون","cause":"صلاةِ العصرِ وصلاةِ الصبحِ","result":"أتيناهم وهم يصلونَ ، وترَكناهم وهم يصلونَ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[26],"ref":"إتحاف الخيرة المهرة 2/134","srcLabel":"ابن أبي عمر","text":["تجتمِعُ ملائكةُ الليلِ وملائكةُ النهارِ في ",["صلاةِ  العصرِ وصلاةِ الصبحِ",1]," ، فتَصعَدُ ملائكةُ النهارِ في صلاةِ العصرِ ، وتَبقى فيكم ملائكةُ الليلِ ، وتَصعَدُ ملائكةُ الليلِ في صلاةِ الصبحِ ، وتَبقى فيكم ملائكةُ النهارِ ، ويقولونَ : ",["أتيناهم وهم يصلونَ ، وترَكناهم وهم يصلونَ",2]," ، وترَكنا فيهم رجلًا لم يُصِبْه خيرٌ قَطُّ ، ولا بلاءٌ قَطُّ إلا علِم أنه مِنكَ ، فيقولُ : ابتَلوا عبدي - أو زيدوا عبدي - قال سفيانُ : لا أدري بأيتِهِما بدَأ قال : فيبتَلونَه ثم يقولُ : ابتَلوه فيُبتَلى ثم يقولُ : ابتَلوه - وهو أعلمُ - فيقولونَ : انتَهى البلاءُ أي ربِّ ، ثم يقولُ : زيدوه فيُزادُ ، ثم يقولُ : زيدوه فيُزادُ ، ثم يقولُ : زيدوه ، فيُزادُ ، ثم يقولُ : زيدوه - وهو أعلمُ - فيقولونَ : انتَهى المزيدُ أي ربِّ فيقولُ : كيف رأيتم عبدي في البلاءِ ، وكيف رأيتُموه في الرخاءِ ؟ فتقولُ : أي ربِّ أصبَرَ عبدٍ وأشكَرَه ، فيقولُ : اكتُبوا عبدي ممن لا يبدلُ ، ولا يغيرُ حتى يَلقاني"],"grade":"صحيح","narrator":"رجل من الصحابة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي عمر كما في ((المطالب العالية)) (3140) واللفظ له.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"A4MDMuDY","merged":5,"otherRefs":["تخريج صحيح ابن حبان 1736 (صحيح)","تخريج المسند لشعيب 8538 (صحيح)","تخريج المسند لشعيب 9151 (صحيح)","صحيح البخاري 7429 (صحيح)"]},{"id":"س-01982","fp":"935f5a217187","stateId":481,"easy":"إذا صليت في الجماعة ← تفضل صلاتك وحدك بخمس وعشرين درجة","cause":"صَلاةِ الرَّجُلِ في الجَميعِ","result":"فضلُ صَلاةِ الرَّجُلِ في الجَميعِ على صَلاتِه وَحدَه خَمسٌ وعشرونَ دَرجةً","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-06640","ref":"تخريج المسند لشعيب 4158","text":[["فضلُ صَلاةِ الرَّجُلِ في الجَميعِ على صَلاتِه وَحدَه خَمسٌ وعشرونَ دَرجةً",2],". قال حَجَّاجٌ: ولم يَرفَعْه شُعبَةُ لي، وقد رَفَعَه لغيري، قال: أنا أَهابُ أنْ أرفَعَه؛ لأنَّ عبدَ اللهِ قلَّما كان يَرفَعُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه أحمد (4158) واللفظ له، والبزار (2057)، وابن خزيمة (1470)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"ecFdkntm","merged":2,"otherRefs":["صحيح ابن ماجه 646 (صحيح)"]},{"id":"س-02746","fp":"4674d78564b1","stateId":481,"easy":"إذا صليت الفجر ← تشهده ملائكة الليل والنهار","cause":"وَقُرْءَانَ الْفَجْرِ","result":"تشهدُهُ ملائِكَةُ اللَّيلِ وملائِكَةُ النَّهارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[26],"ref":"الصحيح المسند 1418","srcLabel":"الترمذي","text":["عنِ النَّبيِّ - صلَّى اللَّهُ عليهِ وعلَى آلِه وسلَّمَ - في قولِهِ تعالى : ",["وَقُرْءَانَ الْفَجْرِ",1]," إِنَّ قُرْآنَ الْفَجْرِ كَانَ مَشْهُودًا : ",["تشهدُهُ ملائِكَةُ اللَّيلِ وملائِكَةُ النَّهارِ",2]," ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه الترمذي (3135)، وابن ماجة (670)، والحاكم (763) باختلاف يسير.","bab":"إيمان › الملائكة","dorar":"cbWady98","merged":2,"otherRefs":["المستدرك على الصحيحين 858 (صحيح)"]},{"id":"س-01500","fp":"41f173adde0e","stateId":481,"easy":"إذا شهدت الصلاة (جماعة) ← فلك خمس وعشرون درجة","cause":"والشاهِدُ","result":"عليه خمسةُ وعشرين درجةً","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-01497","ref":"تخريج المسند لشاكر 14/40","text":["إنَّ المؤذِّنَ يُغفرُ لَه مدى صَوتِه ويُصَدِّقُه كلَ رطبٍ ويابسٍ سَمِعَهُ ",["والشاهِدُ",1]," ",["عليه خمسةُ وعشرين درجةً",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (515)، وابن ماجه (724) باختلاف يسير","bab":"أذان › فضل التأذين","dorar":"nw839obf"},{"id":"س-01972","fp":"1d64337e0613","stateId":481,"easy":"إذا بكّرت إلى الجمعة ← تكتبك الملائكة في صحفها","cause":"يَكتُبونَ النَّاسَ","result":"تَقعُدُ الملائكةُ يومَ الجُمعةِ على أبْوابِ المسجدِ، معهم الصُّحفُ يَكتُبونَ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-08187","ref":"تخريج المسند لشعيب 22268","text":[["تَقعُدُ الملائكةُ يومَ الجُمعةِ على أبْوابِ المسجدِ، معهم الصُّحفُ يَكتُبونَ",2],[" النَّاسَ",1],"، فإذا خَرَجَ الإمامُ طُوِيَتِ الصُّحفُ، قُلتُ: يا أبا أُمامةَ، ليس لمَن جاء بعدَ خُروجِ الإمامِ جُمعةٌ؟ قال: بلى، ولكنْ ليس ممَّن يُكتَبُ في الصُّحفِ."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (22268) واللفظ له، والطبراني (8/339) (8085)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"s5LE6SCI"},{"id":"س-01996","fp":"55c6d3c5899b","stateId":481,"easy":"إذا بكّرت إلى الجمعة ← تكتبك الملائكة","cause":"مَجيءَ النَّاسِ","result":"تُبعَثُ الملائِكَةُ على أبوابِ المسجدِ يومَ الجمعةِ يَكْتبونَ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-08187","ref":"صحيح ابن خزيمة 3/ 250","text":[["تُبعَثُ الملائِكَةُ على أبوابِ المسجدِ يومَ الجمعةِ يَكْتبونَ",2]," ",["مَجيءَ النَّاسِ",1],"، فإذا خرجَ الإمامُ طُوِيَتِ الصُّحفُ، ورُفِعَتِ الأقلامُ، فتَقولُ الملائِكَةُ بعضُهُم لبَعضٍ: ما حبسَ فلانًا؟ فتقولُ الملائِكَةُ: اللَّهمَّ إن كانَ ضالًّا فاهدِهِ، وإن كانَ مَريضًا فاشفِهِ، وإن كانَ عائلًا فأغنِهِ. [وفي روايةٍ]: تقعدُ الملائِكَةُ على أبوابِ المسجدِ. وقالَ أيضًا: يقولُ بعضُهُم لبعضٍ: اللَّهمَّ إن كانَ ضالًّا فاهدِهِ، وإن كانَ... إلى آخرِهِ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البيهقي (5930)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"0g3dbqR7"},{"id":"س-00928","fp":"3405c6d82662","stateId":481,"easy":"إذا أذّنت ← فلو يعلم الناس ما فيه لتضاربوا عليه بالسيوف","cause":"التَّأْذِينِ","result":"لتَضارَبُوا عليه بِالسُّيُوفِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"الجامع الصغير 7485","srcLabel":"أحمد","text":["لو يَعلمُ الناسُ ما لَهُمْ في ",["التَّأْذِينِ",1]," ، ",["لتَضارَبُوا عليه بِالسُّيُوفِ",2]],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"حسن","takhrij":"أخرجه أحمد (11241 واللفظ له، وعبد بن حميد (932)، والديلمي في ((الفردوس)) (5046) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"gsS4cLYI"},{"id":"س-08217","fp":"14c31992300c","stateId":481,"easy":"إذا شهدت الصلاة مع الجماعة ← تشهد لك الملائكة: جئناهم وهم يصلون وتركناهم وهم يصلون","cause":"فشَهِدوا معَكُمُ الصَّلاةَ جميعًا","result":"جئنا وَهُم يصلُّونَ وترَكْناهم يُصلُّونَ","explicit":true,"star":true,"otherNeedIds":[26],"ref":"صحيح ابن خزيمة 1/ 420","srcLabel":"متفق عليه","text":["إنَّ للَّهِ ملائِكَةً يتَعاقبونَ فيكم فإذا كانَ صلاةُ الفَجرِ نزلت ملائِكَةُ النَّهارِ ",["فشَهِدوا معَكُمُ الصَّلاةَ جميعًا",1]," ثمَّ صعِدَت ملائِكَةُ اللَّيلِ ومَكَثت معَكُم ملائِكَةُ النَّهارِ فيسألُهُم ربُّهم وَهوَ أعلمُ بِهِم: ما ترَكْتُمْ عبادي يصنَعونَ قالَ فيقولونَ ",["جئنا وَهُم يصلُّونَ وترَكْناهم يُصلُّونَ",2]," فإذا كانَ صلاةُ العصرِ نزلَت ملائِكَةُ اللَّيلِ فشَهِدوا معَكُمُ الصَّلاةَ جميعًا ثُمَّ صعِدت ملائِكَةُ النَّهارِ ومَكَثت معَكُم ملائِكَةُ اللَّيلِ قالَ: فيسألُهُم ربُّهم وَهوَ أعلمُ بِهِم فيقولُ ما ترَكْتُمْ عبادي يصنَعونَ قالَ فيقولونَ جِئنا وَهُم يصلُّونَ وترَكْناهم وَهُم يُصلُّونَ قالَ فحَسِبْتُ أنَّهم يقولونَ فاغفِر لَهُم يومَ الدِّينِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (7429)، ومسلم (632)، والنسائي (485) بنحوه.","bab":"ملائكة › أعمال الملائكة","dorar":"5VyFpBJE","merged":3,"otherRefs":["شرح رياض الصالحين لابن عثيمين 5/532 (صحيح)","حلية الأولياء 7/379 (صحيح)"]},{"id":"س-01408","fp":"0fb2a5d9ca15","stateId":482,"easy":"إذا قمت إلى الصلاة (بعد الوضوء) ← يرفع الله درجتك وإن قعدت قعدت سالماً","cause":"فإذا قامَ إلى الصَّلاةِ","result":"رفعَ اللهُ درجتَهُ ، و إنْ قَعَدَ قَعَدَ سالِمًا","explicit":true,"star":true,"apply":{"k":"time","t":"بعد الوضوء"},"ref":"صحيح الترغيب 187","srcLabel":"أحمد","text":["أيُّما رجلٍ قامَ إلى وضُوئِهِ يُرِيدُ الصَّلاةَ ، ثُمَّ غَسَلَ كَفَّيْهِ ، نزلَتْ كلُّ خطيئةٍ من كَفَّيْهِ مع أولِ قَطْرَةٍ ، فإذا مَضْمَضَ و اسْتَنْشَقَ و اسْتَنْثَرَ ، نزلَتْ خَطِيئَتُهُ من لسانِهِ و شَفَتَيْهِ مع أولِ قَطْرَةٍ ، فإذا غَسَلَ يديْهِ إلى المِرْفَقَيْنِ ، و رِجْلَيْهِ إلى الكعبيْنِ ، سَلِمَ من كلِّ ذَنْبٍ كَهَيْئَتِه يومَ ولَدَتْهُ أمُّهُ ( قال : ) ",["فإذا قامَ إلى الصَّلاةِ",1]," ",["رفعَ اللهُ درجتَهُ ، و إنْ قَعَدَ قَعَدَ سالِمًا",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (22267) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (4397) بنحوه","bab":"وضوء › صفة الوضوء","dorar":"llT4ZOIe"},{"id":"س-02061","fp":"bc8f9e470970","stateId":482,"easy":"إذا اغتسلت يوم الجمعة ← تبقى في طهارة إلى الجمعة الأخرى","cause":"مَنِ اغتَسَل يَومَ الجمُعَةِ","result":"كان في طَهارَةٍ إلى الجمُعَةِ الأُخرى","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"ref":"تحفة المحتاج 1/512","srcLabel":"ابن حبان","text":[["مَنِ اغتَسَل يَومَ الجمُعَةِ",1]," ",["كان في طَهارَةٍ إلى الجمُعَةِ الأُخرى",2]],"grade":"صحيح","narrator":"أبو قتادة","muhaddith":"صحيح أو حسن [كما اشترط على نفسه في المقدمة]","takhrij":"أخرجه ابن خزيمة (1760)، وابن حبان (1222) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (8180) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"GR7pmelI"},{"id":"س-05866","fp":"814dabd5fee4","stateId":482,"easy":"إذا تخللت في الوضوء والطعام ← فحبذا أنت","cause":"المتخلِّلونَ من أمَّتي في الوضوءِ والطعامِ","result":"حبَّذَا","explicit":true,"similar":["س-01417"],"ref":"شرح كتاب الشهاب 577","srcLabel":"أحمد","text":[["حبَّذَا",2]," ",["المتخلِّلونَ من أمَّتي في الوضوءِ والطعامِ",1]],"grade":"حسن","narrator":"أبو أيوب الأنصاري","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (23527)، وعبد بن حميد (217) باختلاف يسير، والطبراني (4/177) (4061) مطولاً باختلاف يسير","bab":"رقائق وزهد › الوصايا النافعة","dorar":"dwW9Sqzw"},{"id":"س-01417","fp":"0dd14b54b27b","stateId":482,"easy":"إذا تخللت في الوضوء ومن الطعام ← فحبذا أنت","cause":"المتخلِّلونَ بالوضوءِ، والمتخلِّلونَ منَ الطَّعامِ","result":"حبَّذا المتخلِّلونَ من أمَّتي","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-05866","ref":"الزواجر عن اقتراف الكبائر 2/127","text":["خرجَ علينا رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ: ",["حبَّذا المتخلِّلونَ من أمَّتي",2],". قالوا: وما المتخلِّلونَ يا رسولَ اللَّهِ؟ قالَ: ",["المتخلِّلونَ بالوضوءِ، والمتخلِّلونَ منَ الطَّعامِ",1]],"grade":"حسن","narrator":"[أبو أيوب الأنصاري]","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه أحمد (23527)، وابن أبي شيبة (97)، وعبد بن حميد (217) باختلاف يسير.","bab":"وضوء › صفة الوضوء","dorar":"wSD67t9X"},{"id":"س-07550","fp":"4a1df03869bf","stateId":483,"easy":"إذا قرأت الفاتحة ← فهي أعظم سورة في القرآن","cause":"الحمدُ للهِ ربِّ العالَمِينَ","result":"أعظمَ سورةٍ في القُرآنِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"read","t":"الفاتحة"},"similar":["س-07092"],"ref":"تخريج مشكل الآثار 1207","srcLabel":"البخاري","text":["عن أبي سعيدِ بنِ المُعَلَّى الأنصاريِّ: أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ دعاهُ وهو يُصلِّي فصلَّى، ثمَّ أتاهُ فقال: ما منَعكَ أنْ تُجيبَني إذْ دعَوْتُكَ؟ قال: إنِّي كُنْتُ أُصلِّي، قال: ألمْ يَقُلِ اللهُ عزَّ وجلَّ: {يَا أَيُّهَا الَّذِينَ آمَنُوا اسْتَجِيبُوا لِلَّهِ وَلِلرَّسُولِ إِذَا دَعَاكُمْ} [الأنفال: 24] الآيةَ، ثمَّ قال: ألَا أُعلِّمُكَ ",["أعظمَ سورةٍ في القُرآنِ",2],"؟ فكأنَّه نَسِيَها أو نُسِّيَ، قُلْتُ: يا رسولَ اللهِ: الذي قُلْتَ، قال: ",["الحمدُ للهِ ربِّ العالَمِينَ",1],"، هي السَّبْعُ المَثاني والقُرآنُ العظيمُ الذي أُوتيتُهُ."],"grade":"صحيح","narrator":"أبو سعيد بن المعلى","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه البخاري (4474) باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › خصائصه صلى الله عليه وسلم","dorar":"7Ctw2FjN","merged":4,"otherRefs":["صحيح ابن ماجه 3067 (صحيح)","صحيح الجامع 2592 (صحيح)","صحيح البخاري 5006 (صحيح)"]},{"id":"س-07092","fp":"29b5763b38a2","stateId":483,"easy":"إذا قرأت الفاتحة ← فهي أفضل القرآن","cause":"فتَلا عليه: {الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ} الفاتحة: 2","result":"ألا أُخبِرُكَ بأفضلِ القرآنِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"read","t":"الفاتحة"},"repOf":"س-07550","ref":"المستدرك على الصحيحين 2082","text":["كان النَّبيُّ صلَّى اللهُ عليه وسلَّمَ في مَسيرٍ فنَزَلَ ونَزَلَ رَجلٌ إلى جانبِهِ، قالَ: فالتفتَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ، فقالَ: ",["ألا أُخبِرُكَ بأفضلِ القرآنِ،",2]," قالَ:",[" فتَلا عليه: {الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ} [الفاتحة: 2].",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه النسائي في ((الكبرى)) (7957) باختلاف يسير، وابن حبان (774)، والبيهقي في ((شعب الإيمان)) (2144) بنحوه","bab":"علم › تعليم الناس وفضل ذلك","dorar":"z25pAM3D"},{"id":"س-03136","fp":"5837f97256a2","stateId":483,"easy":"إذا قرأت آية الكرسي ← فهي أعظم آية في القرآن","cause":"اللهُ لا إلهَ إلا هوَ الحيُّ القيُّومُ","result":"أيُّ آيةٍ في القرآنِ أعظمُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"read","t":"آية الكرسي"},"ref":"إتحاف الخيرة المهرة 6/183","srcLabel":"أحمد","text":["كان رجلٌ مِن أصحابِ النبيِّ صلَّى اللهُ عليه وسلَّم يحدِّثُ الناسَ حتى يكثُرَ عليه ، فيحدِّثُ الناسَ مِن فوقِ بيتٍ ، فصعِد فوقَ بيتٍ فحدَّثهم ، قال : إنَّ اللهَ تعالى إذا أحَبَّ عبدًا في السماءِ أنزَل حبَّه إلى ملائكتِه فنادى منادٍ : إنَّ اللهَ , تعالى , قد أحَبَّ فلانًا فأحِبُّوه ، فينزِلُ حبُّه إلى أهلِ الأرضِ ، وإذا أبغَض عبدًا في السماءِ أنزَل بُغضَه إلى الملائكةِ فنادى منادٍ : إنَّ اللهَ قد أبغَض فلانًا فأبغِضوه ، فينزِلُ بُغضُه إلى أهلِ الأرضِ ، وقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ",["أيُّ آيةٍ في القرآنِ أعظمُ",2]," ؟ فقال رجلٌ : ",["اللهُ لا إلهَ إلا هوَ الحيُّ القيُّومُ",1]," فضرَب بيدِه بين كتِفي حتى وجَدتُ بَردَها بين ثديَيَّ فقال لي : لِيَهنِكَ أبا المُنذِرِ العلمُ ، والذي نفسُ محمدٍ صلَّى اللهُ عليه وسلَّم بيدِه إنَّ لها لسانًا وشَفَتَينِ تُقَدِّسُ الرحمنَ , عزَّ وجلَّ , عندَ العرشِ"],"grade":"صحيح","narrator":"رجل من الصحابة","muhaddith":"إسناده صحيح، وله شاهد","takhrij":"أخرجه أحمد (20588) بلفظه، ومسدد كما في ((إتحاف الخيرة)) للبوصيري (5632) باختلاف يسير، وابن أبي شيبة (27043) مختصرا.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"FgNS6MOK","merged":4,"otherRefs":["تخريج سنن أبي داود 4003 (صحيح)","المستدرك على الصحيحين 3156 (صحيح)","تخريج المسند لشعيب 20588 (صحيح)"]},{"id":"س-00756","fp":"fcd38e6c4c49","stateId":483,"easy":"إذا قرأت آخر سورة البقرة ← فهما من كنز تحت العرش","cause":"اقرؤوا هاتينِ الآيتينِ اللَّتينِ في آخرِ سورةِ البقرةِ","result":"فإنَّ ربِّي أعطانيهما من تحتِ العرشِ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"apply":{"k":"read","t":"آخر سورة البقرة"},"ref":"صحيح الجامع 1172","srcLabel":"أحمد","text":[["اقرؤوا هاتينِ الآيتينِ اللَّتينِ في آخرِ سورةِ البقرةِ",1]," ",["فإنَّ ربِّي أعطانيهما من تحتِ العرشِ",2]],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17445) بلفظه، وأبو يعلى الموصلي (1735)، والروياني (169) كلاهما باختلاف يسير.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"K2LH2UXq"},{"id":"س-02167","fp":"4052ef9a1aca","stateId":483,"easy":"إذا قرأت المعوذتين ← فلن تقرأ بمثلهما","cause":"قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ و قُلْ أَعُوذُ بِرَبِّ النَّاسِ","result":"ولَنْ تقرأَ بِمِثْلِهما","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"read","t":"المعوذتين"},"otherNeedIds":[31],"ref":"صحيح الترغيب 1486","srcLabel":"النسائي","text":["اقرأْ يا جَابِرُ ! . فقُلْتُ : وما أقرأُ بأبي أنتَ وأمِّي ؟ قال :  ",["قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ  و  قُلْ أَعُوذُ بِرَبِّ النَّاسِ",1],"  فَقرأْتُهُما. فقال : اقرأْ بِهما ، ",["ولَنْ تقرأَ بِمِثْلِهما",2]," ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"حسن صحيح","takhrij":"أخرجه النسائي (5441)، وابن حبان (796)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"3LTA1sCW"},{"id":"س-00764","fp":"b484077f1209","stateId":483,"easy":"إذا قرأت خاتمة سورة البقرة ← فهي مما اصطفى الله به نبيه","cause":"اقرؤوا هاتينِ الآيتينِ من آخرِ سورةِ البقرةِ { آمَنَ الرَّسُولُ } إلى خاتمتِها","result":"فإن اللهَ اصطفى بها محمدًا","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"apply":{"k":"read","t":"خاتمة سورة البقرة"},"ref":"فتح القدير 1/462","srcLabel":"أحمد","text":[["اقرؤوا هاتينِ الآيتينِ من آخرِ سورةِ البقرةِ { آمَنَ الرَّسُولُ } إلى خاتمتِها",1]," ",["فإن اللهَ اصطفى بها محمدًا",2]],"grade":"حسن","narrator":"عقبة بن عامر","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني (17/ 283)، (781) بلفظه، وأحمد (17445)، وأبو يعلى الموصلي (1735) كلاهما بنحوه.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"ZU5MVOoU"},{"id":"س-08233","fp":"70837fda84a0","stateId":483,"easy":"إذا أكثرت قراءة «قل هو الله أحد» ← تنالك كرامة عظيمة (من واقعة)","cause":"بكثرةِ قراءتِه {قل هو اللهُ أَحَدٌ}، كان يقرؤها قائمًا وقاعدًا وراقِدًا وماشيًا","result":"ومع جِبريلَ سبعون ألفَ مَلَكٍ، فصلَّى على معاويةَ بنِ معاويةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«قل هو الله أحد»"},"otherNeedIds":[24],"ref":"سبل الهدى والرشاد 8/373","srcLabel":"سبل الهدى والرشاد","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم كان غازيًا تبوكَ، فأتاه جبريلُ صلَّى اللهُ عليه وسلَّم، فقال: يا محمَّدُ، هل لك في جِنازةِ مُعاويةَ بنِ معاويةَ المُزَنيِّ؟ قال: «نعم»، فقال جبريلُ بيده: هكذا، ففرَجَ له عن الجبالِ والآكامِ، فجاء رسولُ اللهِ صلَّى اللهُ عليه وسلَّم يمشي ومعه جبريلُ عليه السَّلامُ، ",["ومع جِبريلَ سبعون ألفَ مَلَكٍ، فصلَّى على معاويةَ بنِ معاويةَ",2],"، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم لجِبريلَ عليه السَّلامُ: «بمَ بَلَغ معاويةُ هذا؟»، قال: ",["بكثرةِ قراءتِه {قل هو اللهُ أَحَدٌ}، كان يقرؤها قائمًا وقاعدًا وراقِدًا وماشيًا",1],"، فهذا بلَغ به ما بلَغ."],"grade":"حسن","narrator":"[الحسن البصري]","muhaddith":"[فيه] صدقة بن أبي سهل، وبقية رجاله ثقات.","bab":"ملائكة › أعمال الملائكة","dorar":"UElTpodT"},{"id":"س-02547","fp":"a4da2b5bf03e","stateId":483,"easy":"إذا قرأت آية الكرسي ← فهي سيدة آي القرآن","cause":"آيةُ الكُرسيِّ","result":"سيِّدُ آيِ القرآنِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"apply":{"k":"read","t":"آية الكرسي"},"ref":"المستدرك على الصحيحين 2085","srcLabel":"الترمذي","text":["سورةُ البقرةِ فيها آيةٌ ",["سيِّدُ آيِ القرآنِ",2],"، لا تُقرأُ في بيتٍ وفيه شيطانٌ إلَّا خَرَجَ منه؛ ",["آيةُ الكُرسيِّ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (2878)، وعبد الرزاق (6019)، والحميدي (1024) باختلاف يسير.","bab":"إيمان › أعمال الجن والشياطين","dorar":"YeycQpNI","merged":2,"otherRefs":["المستدرك على الصحيحين 3071 (صحيح)"]},{"id":"س-06253","fp":"583f5551bdb7","stateId":483,"easy":"إذا قرأت الإخلاص والمعوذتين ← فلم ينزل مثلهن","cause":"قُلْ هُوَ اللهُ أَحَدٌ } و{ قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ } و{ وَقُلْ أَعُوذُ بِرَبِّ النَّاسِ","result":"ألا أُعلِّمُكَ سُوَرًا ما أُنْزلتْ في التوراةِ ولا في الزبورِ ولا في الإنجيلِ ولا في الفرقانِ مثلهنَّ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"read","t":"الإخلاص والمعوذتين"},"otherNeedIds":[31],"ref":"السلسلة الصحيحة 6/859","srcLabel":"السلسلة الصحيحة","text":["يا عقبةُ بنَ عامرٍ صِلْ من قطعَكَ وأَعْطِ من حَرَمَكَ واعْفُ عمَّن ظلمَكَ قال ثم أتيتُ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ فقال لي يا عقبةُ بنَ عامرٍ املُكْ لسانَكَ وابْكِ على خطيئتِكَ وليَسَعَكَ بيتُكَ قال ثم لقيتُ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ فقال لي يا عقبةُ بنَ عامرٍ ",["ألا أُعلِّمُكَ سُوَرًا ما أُنْزلتْ في التوراةِ ولا في الزبورِ ولا في الإنجيلِ ولا في الفرقانِ مثلهنَّ",2]," لا يأتيَنَّ عليكَ ليلةٌ إلا قرأتَهُنَّ فيها { ",["قُلْ هُوَ اللهُ أَحَدٌ } و{ قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ } و{ وَقُلْ أَعُوذُ بِرَبِّ النَّاسِ",1]," }"],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"إسناده صحيح","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"CyWEr8Ay"},{"id":"س-01686","fp":"10def0221edd","stateId":483,"easy":"إذا قرأت آية الكرسي ← فهي أعظم آية","cause":"آيةُ الكُرسيِّ","result":"فأيُّ آيةٍ مِمَّا أنزلَ اللهُ عزَّ وجلَّ عليكَ أعظَمُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"read","t":"آية الكرسي"},"ref":"النوافح العطرة 227","srcLabel":"أحمد","text":["قُلِ الحقَّ وإن كان مُرًّا [يعني حديث: دخَلتُ علَى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وهو في المسجِدِ جالِسٌ، فاغتَنَمتُ خلوتَهُ، وحدَهُ، فجلَستُ إليهِ، فقالَ : أبا ذَرٍّ ! إن لِلمَسجِد تَحيَّةً، وإنَّ تحيَّتَهُ ركعتان فقُم فاركَعهما، قالَ : فقُمت فركَعتُها ثم عُدتُ فجلَستُ إليهِ، فقُلتُ : يا رسولَ اللهِ ! إنَّكَ أمَرتَني بالصَّلاةِ فما الصَّلاةُ ؟ قال : خيرٌ موضوعٌ استكثِرْ أو استَقِلَّ. قلتُ : يا رسولَ اللهِ ! فأيُّ الأعمالِ أفضَلُ ؟ قال : إيمانٌ باللَّهِ عزَّ وجلَّ، وجهادٌ في سبيلِهِ، قال : قلتُ : يا رسولَ اللهِ ! فأيُّ المؤمنينَ أكمَلُهم إيمانًا ؟ قالَ : أحسَنُهُم خُلُقًا. قالَ : قلتُ : يا رسولَ اللَّهِ ! فأيُّ المؤمنينَ أسلَمُ ؟ قالَ : مَن سلِمَ النَّاسُ من لسانِهِ ويدِهِ. قال : قلتُ : يا رسولَ اللَّهِ ! فأيُّ الهجرةِ أفضَلُ ؟ قال : مَن هجرَ السَّيِّئاتِ. قالَ : قُلتُ : يا رسولَ اللهِ ! فأيُّ الصَّلاةِ أفضَلُ ؟ قال : طولُ القنوتِ . قال : قلتُ : يا رسولَ اللهِ ! فما الصِّيامُ ؟ قالَ : فرضٌ مَجزيٌّ ، وعندَ اللهِ أضعافٌ كثيرةٌ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ الجهادِ أفضَلُ ؟ قالَ : مَن عُقِرَ جوادُهُ وأهريقَ دمُهُ. قال : قُلتُ : يا رسولَ اللهِ ! فأيُّ الرِّقابِ أفضَلُ ؟ قالَ : أغلاها ثَمنًا وأنفَسُها عندَ ربِّها. قالَ : قلتُ : يا رسولَ اللهِ ! فأيُّ الصَّدقةِ أفضَلُ ؟ قال : جُهدٌ مِن مُقِلٍّ يُسَرُّ إلى فقيرٍ. قال : قلتُ : يا رسولَ اللهِ ! ",["فأيُّ آيةٍ مِمَّا أنزلَ اللهُ عزَّ وجلَّ عليكَ أعظَمُ",2]," ؟ قال : ",["آيةُ الكُرسيِّ",1],". ثُمَّ قالَ : يا أبا ذَرٍّ ! ما السَّماواتُ السَّبعُ معَ الكُرسيِّ إلا كَحلقَةٍ مُلقاةٍ بأرضِ فلاةٍ، وفَضلُ العَرشِ على الكُرسيِّ كفَضلِ الفَلاةِ علَى الحَلقَةِ. قلتُ : يا رسولَ اللهِ ! كم الأنبياءُ ؟ قال : مائةُ ألفٍ وأربعةٌ وعِشرونَ ألفًا. قلتُ : يا رسولَ اللهِ ! كم الرُّسلِ ؟ قالَ : ثلاثُمائةٍ وثلاثَةُ عشرَ جَمًّا غفيرًا. قلتُ : كثيرٌ طيِّبٌ، قلتُ : يا رسولَ اللهِ ! مَن كان أوَّلُهمْ ؟ قال : آدَمُ. قلتُ : يا رسولَ اللهِ ! أنَبيٌّ مُرسَلٌ ؟ قال : نعَم، خلقَهُ اللهُ بيدِهِ، ونفخَ فيهِ مِن روحِهِ، ثُمَّ سوَّاهُ قِبَلًا. وقال أحمدُ بنُ أنَسٍ ثُمَّ كلَّمهُ قِبَلًا. ثُمَّ قالَ : يا أبا ذَرٍّ ! أربعةٌ سُريانيُّونَ؛ آدَمُ، وشيثُ، وخَنوخُ - وهو إدريسُ، وهم أوَّلُ مَن خطَّ بالقلَمِ - ونوحٌ. وأربعةٌ من العَربِ؛ هودٌ، وصالِحٌ، وشُعَيبٌ، ونبيُّكَ يا أبا ذَرٍّ. قال : قلتُ : يا رسولَ اللهِ ! كَم كتابٌ أنزلَهُ اللَّهُ تعالى ؟ قال : مائةُ كتابٍ وأربعةُ كتُبٍ، أنزلَ علَى شيثَ خَمسونَ صحيفَةً، وأنزلَ علَى خَنوخَ ثلاثونَ صَحيفةً، وأنزلَ على إبراهيمَ عشرَ صحائفَ، وأنزلَ على موسَى قبلَ التَّوراةِ عَشرَ صحائفَ، وأنزلَ التَّوراةَ والإنجيلَ والزَّبورَ والفُرقانَ. قال : قلتُ : يا رسولَ اللهِ ! فَما كانَت صُحفُ إبراهيمَ ؟ قالَ : كانَت أمثالًا كلُّها : أيُّها الملِكُ المسلَّطُ المبتَلَى المغرورُ، فإنِّي لم أبعثْكَ لتجمَعَ الدُّنيا بعضَها إلى بعضٍ، ولكن بعثتُكَ لترُدَّ عنِّي دعوةَ المظلومِ، فإنِّي لا أردُّها ولَو كانَت مِن كافِرٍ. وكانَت فيها أمثالٌ : علَى العاقِلِ ما لَم يكُن مغلوبًا علَى عقلِهِ أن تكونَ له ساعاتٌ؛ ساعَةٌ يُناجي فيها ربَّهُ عزَّ وجلَّ، وساعةٌ يحاسِبُ فيها نفسَهُ، وساعَةٌ يفكِّرُ فيها في صُنعِ اللَّهِ عزَّ وجلَّ، وساعةٌ يخلو فيها بحاجتِهِ من المطعَمِ والمشرَبِ، وعلى العاقلِ أن لا يكون ظاعِنًا إلَّا لثلاثٍ؛ تزوُّدٍ لمعادٍ، أو مرمَّةٍ لمعاشٍ، أو لذَّةٍ في غيرِ محرَّمٍ، وعلى العاقِلِ أن يكونَ بصيرًا بزمانِهِ، مقبِلًا على شأنِهِ، حافِظًا للسانِهِ، ومن حسَبَ كلامَهُ من عمَلِهِ قلَّ كلامُهُ إلا فيما يعنيهِ. قلتُ : يا رسولَ اللَّهِ ! فما كان صحُفُ موسَى عليهِ السَّلامُ ؟ قال : كانَت عبرًا كلَّها، عجبتُ لمن أيقنَ بالموتِ ثُمَّ هو يفرَحُ، عجبتُ لمن أيقنَ بالنَّارِ وهو يضحَكُ، عجبتُ لمن أيقنَ للقدرِ ثم هو ينصَبُ، عجبتُ لمن رأى الدُّنيا وتقلُّبَها ثُمَّ اطمأنَّ إليها، عجِبتُ لمن أيقنَ بالحسابِ غدًا ثُمَّ لا يعمَلُ. قلتُ : يا رسولَ اللهِ ! أوصِني. قال : أوصيكَ بتقوى اللهِ فإنَّهُ رأسُ الأمرِ كلِّهِ، قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بتلاوَةِ القرآنِ فإنَّهُ نور لكَ في الأرضِ وذكرٌ لكَ في السَّماءِ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : إيَّاكَ وكثرةَ الضَّحِكِ فإنَّهُ يُميتُ القَلبَ، ويَذهَبُ بنورِ الوَجهِ، قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : عليكَ بالصَّمتِ إلَّا مِن خيرٍ، فإنَّهُ مطردَةٌ للشَّيطانِ عنكَ، وعونٌ لكَ علَى أمر دينِكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بالجهادِ فإنَّهُ رهبانيَّةُ أمَّتي. قلتُ : يا رسولَ اللهِ ! زِدني. قال : حبُّ المساكينِ وجالِسهُم. قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : انظُر إلى مَن تحتَكَ ولا تنظُر إلى مَن فوقكَ فإنَّهُ أجدَرُ أن لا تَزدَري نِعمةَ اللهِ عندكَ. قلتُ : زِدني يا رسولَ اللهِ ! قال : صِلْ قرابَتَكَ وإن قَطعوكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : لا تَخَف في اللَّهِ تعالى لَومَةَ لائمٍ. قلتُ : يا رسولَ اللهِ ! زِدني. قالَ : قُل الحقَّ وإن كان مُرًّا. قلتُ : يا رسولَ اللهِ ! زِدني. قال : يردُّكَ عن النَّاسِ ما تعرفُ من نفسِكَ، ولا تجِد عليهِم فيما تأتي، وكفَى به عيبًا أن تعرِفَ من النَّاسِ ما تجهَلُ من نفسِكَ، أو تجِدُ عليهِم فيما تأتي. ثُمَّ ضربَ بيدِهِ علَى صدري، فقالَ : يا أبا ذَرٍّ ! لا عقلَ كالتَّدبيرِ، ولا ورعَ كالكَفِّ، ولا حسَبَ كحُسنِ الخُلُقِ، قلتُ : يارسولَ اللهِ ! هل لي في الدُّنيا شَيءٌ مِمَّا أنزلَ اللهُ عليكَ مِمَّا كان في صحُفِ إبراهيمَ وموسَى ؟ قال : يا أبا ذَرٍّ ! اقرَأ : ? قَد أفلَحَ مَن تزَكَّى? إلى آخرِ السُّورَةِ]"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مطولاً أحمد (21415)، والبزار (3966) باختلاف يسير، وابن حبان (361) واللفظ له","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"wZID7EAR"},{"id":"س-08184","fp":"d37b9f9bb9e7","stateId":484,"easy":"إذا مهرت بالقرآن ← تكون مع السفرة الكرام البررة","cause":"الماهِرُ بالقُرآنِ","result":"مع السَّفَرةِ الكِرامِ البَرَرةِ","explicit":true,"star":true,"ref":"صحيح مسلم 798","srcLabel":"متفق عليه","text":[["الماهِرُ بالقُرآنِ",1]," ",["مع السَّفَرةِ الكِرامِ البَرَرةِ",2],"، والذي يَقرَأُ القُرآنَ ويَتَتَعتَعُ فيه وهو عليه شاقٌّ، له أجرانِ. [وفي روايةٍ]: والذي يَقرَأُ وهو يَشتَدُّ عليه له أجرانِ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4937)، ومسلم (798).","bab":"ملائكة › أعمال الملائكة","dorar":"lEMzVaI6","merged":7,"otherRefs":["معالم التنزيل (تفسير البغوي) 1/61 (صحيح)","تخريج المسند لشعيب 25365 (صحيح)","تخريج المسند لشعيب 24634 (صحيح)","صحيح الترمذي 2904 (صحيح)","صحيح الجامع 5497 (صحيح)","صحيح البخاري 4937 (صحيح)"]},{"id":"س-07695","fp":"e957949017e5","stateId":484,"easy":"إذا زيّنت القرآن بصوتك ← فالصوت الحسن يزيد القرآن حسناً","cause":"زيِّنُوا القرآنَ بأصواتِكم","result":"فإِنَّ الصوتَ الحسنَ يَزيدُ القرآنَ حُسْنًا","explicit":true,"star":true,"ref":"صحيح الجامع 3581","srcLabel":"البخاري","text":[["زيِّنُوا القرآنَ بأصواتِكم",1]," ؛ ",["فإِنَّ الصوتَ الحسنَ يَزيدُ القرآنَ حُسْنًا",2]],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح","takhrij":"أخرجه البخاري معلقاً قبل حديث (7544)، وأخرجه موصولاً أبو داود (1468)، والنسائي (1015)، وابن ماجه (1342)، وأحمد (18517) مختصرا، والحاكم (2125) واللفظ له.","bab":"قرآن › آداب الناس كلهم مع القرآن","dorar":"uz6WEQqG"},{"id":"س-02673","fp":"1d7314b47607","stateId":484,"easy":"إذا أعطاك الله القرآن فقمت به آناء الليل والنهار ← فهو مما يُتنافس فيه","cause":"رَجُلٌ أعطاه اللهُ عَزَّ وجَلَّ القُرآنَ، فهو يَقومُ به آناءَ اللَّيلِ وآناءَ النَّهارِ، ويَتَّبِعُ ما فيه","result":"لا تَنافُسَ بَينَكُم إلَّا في اثنَتَينِ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 16966","srcLabel":"أحمد","text":["«",["لا تَنافُسَ بَينَكُم إلَّا في اثنَتَينِ",2],": ",["رَجُلٌ أعطاه اللهُ عَزَّ وجَلَّ القُرآنَ، فهو يَقومُ به آناءَ اللَّيلِ وآناءَ النَّهارِ، ويَتَّبِعُ ما فيه",1],"، فيَقولُ رَجُلٌ: لَو أنَّ اللهَ تَعالى أعطاني مِثلَ ما أعطى فُلانًا، فأقومَ به كما يَقومُ به، ورَجُلٌ أعطاه اللهُ مالًا فهو يُنفِقُ ويَتَصَدَّقُ، فيَقولُ رَجُلٌ: لَو أنَّ اللهَ أعطاني مِثلَ ما أعطى فُلانًا فأتَصَدَّقَ به». فقال رَجُلٌ: يا رَسولَ اللهِ، أرَأيتَكَ النَّجدةَ تَكونُ في الرَّجُلِ... وسَقَطَ باقي الحَديثِ."],"grade":"صحيح","narrator":"يزيد بن الأخنس","muhaddith":"صحيح لغيره","bab":"إيمان › الاحتساب والنية","dorar":"C3hr7q6f","merged":8,"otherRefs":["مجموع الفتاوى 12/375 (صحيح)","مجمع الزوائد 3/111 (حسن)","تخريج المسند لشاكر 9/158 (صحيح)","تخريج المسند لشعيب 5618 (صحيح)","تخريج المسند لشعيب 10215 (صحيح)","تخريج مشكل الآثار 463 (صحيح)","صحيح الترغيب 634 (حسن)"]},{"id":"س-07799","fp":"aaa4639adfab","stateId":484,"easy":"إذا أعطاك الله حفظ كتابه ← فلا تظن أن أحداً أُعطي أفضل منك","cause":"مَن أعطاه اللهُ تعالى حِفْظَ كتابِه","result":"فظَنَّ أنَّ أحدًا أُعطِيَ أفضَلَ ممَّا أُعطِيَ؛ فقد غَلِطَ أعظَمَ النِّعَمِ","explicit":true,"star":true,"ref":"التنوير شرح الجامع الصغير 10/122","srcLabel":"البخاري","text":[["مَن أعطاه اللهُ تعالى حِفْظَ كتابِه",1],"، ",["فظَنَّ أنَّ أحدًا أُعطِيَ أفضَلَ ممَّا أُعطِيَ؛ فقد غَلِطَ أعظَمَ النِّعَمِ",2],"."],"grade":"حسن","narrator":"رجاء الغنوي","muhaddith":"اختلف في رجاء فقيل هو صحابي فلا إرسال في حديثه وقيل من ثقات التابعين","takhrij":"أخرجه البخاري في ((التاريخ الكبير)) (3/ 311)، والبيهقي في ((شعب الإيمان)) (2355) بلفظه.","bab":"قرآن › تعلم القرآن وتعليمه","dorar":"ZMvrQnMT"},{"id":"س-07168","fp":"e44b89a1932e","stateId":484,"easy":"إذا قرأت القرآن قراءة يُرى فيها أنك تخشى الله ← فأنت أحسن الناس صوتاً بالقرآن","cause":"مَن إذا سَمِعْتَهُ يقرأُ ؛ أُرِيتَ أنه يَخْشَى اللهَ","result":"أَحْسَنُ صوتًا للقرآنِ وأَحْسَنُ قراءةً","explicit":true,"star":true,"otherNeedIds":[19],"ref":"هداية الرواة 2150","srcLabel":"الدارمي","text":["سُئِلَ النبيُّ - صلَّى اللهُ عليهِ وسلَّم - : أَيُّ الناسِ ",["أَحْسَنُ صوتًا للقرآنِ وأَحْسَنُ قراءةً",2]," ؟ قال : ",["مَن إذا سَمِعْتَهُ يقرأُ ؛ أُرِيتَ أنه يَخْشَى اللهَ",1]],"grade":"صحيح","narrator":"طاووس بن كيسان اليماني","muhaddith":"صحيح لغيره","takhrij":"أخرجه الدارمي (3532) واللفظ له، وعبد الرزاق (4185)، وابن أبي شيبة (8834) باختلاف يسير.","bab":"علم › حسن السؤال ونصح العالم","dorar":"oEXGKTNp","merged":2,"otherRefs":["صحيح الجامع 2202 (صحيح)"]},{"id":"س-02248","fp":"039798b306b5","stateId":484,"easy":"إذا حملت القرآن ← تكون من عرفاء أهل الجنة يوم القيامة","cause":"حمَلةُ القرآنِ","result":"عرفاءُ أهلِ الجنةِ يومَ القيامةِ","explicit":true,"ref":"النوافح العطرة 127","srcLabel":"الطبراني","text":[["حمَلةُ القرآنِ",1]," ",["عرفاءُ أهلِ الجنةِ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"الحسين بن علي بن أبي طالب","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (3/132) (2899) واللفظ له، وابن الجوزي في ((الموضوعات)) (1/253) مختصراً","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"FPqPIMme"},{"id":"س-02078","fp":"9ac2892625ac","stateId":484,"easy":"إذا قرأت القرآن من حفظك ← فهو ألف درجة","cause":"قراءةُ الرجلِ في غيرِ المصحفِ","result":"ألفُ درجةٍ","explicit":true,"ref":"مجمع الزوائد 7/168","srcLabel":"مجمع الزوائد","text":[["قراءةُ الرجلِ في غيرِ المصحفِ",1]," ",["ألفُ درجةٍ",2]," وقراءتُهُ في المصحفِ تضاعَفُ علَى ذلِكَ ألْفَيْ درجةٍ"],"grade":"حسن","narrator":"أوس بن أبي أوس وقيل أوس بن أوس والد عمرو","muhaddith":"فيه أبو سعيد بن عون وبقية رجاله ثقات","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"6YxZ83nd"},{"id":"س-02079","fp":"ddf6c1898689","stateId":484,"easy":"إذا قرأته في المصحف ← يُضاعف ألفي درجة","cause":"وقراءتُهُ في المصحفِ","result":"تضاعَفُ علَى ذلِكَ ألْفَيْ درجةٍ","explicit":true,"ref":"مجمع الزوائد 7/168","srcLabel":"مجمع الزوائد","text":["قراءةُ الرجلِ في غيرِ المصحفِ ألفُ درجةٍ ",["وقراءتُهُ في المصحفِ",1]," ",["تضاعَفُ علَى ذلِكَ ألْفَيْ درجةٍ",2]],"grade":"حسن","narrator":"أوس بن أبي أوس وقيل أوس بن أوس والد عمرو","muhaddith":"فيه أبو سعيد بن عون وبقية رجاله ثقات","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"6YxZ83nd"},{"id":"س-07816","fp":"18e7703db52c","stateId":484,"easy":"إذا تلوت القرآن في بيتك ← يتراءى لأهل السماء كما تتراءى النجوم لأهل الأرض","cause":"البيتَ لَيُتْلَى فيه القرآنُ","result":"فيتراءَى لأهل السماءِ كما تتراءَى النجومُ لأهل الأرضِ","explicit":true,"ref":"السلسلة الصحيحة 3112","srcLabel":"أحمد","text":["اجعلوا من صلاتِكم في بيوتِكم ، ولا تجعَلوها عليكم قبورًا ، كما اتخذتِ اليهودُ والنصارى في بيوتهم قبورًا ، وإنَّ ",["البيتَ لَيُتْلَى فيه القرآنُ",1]," ؛ ",["فيتراءَى لأهل السماءِ كما تتراءَى النجومُ لأهل الأرضِ",2]],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده جيد","takhrij":"أخرجه أحمد (24411)، والفريابي في ((فضائل القرآن)) (35) واللفظ له، وأبو يعلى (4867)","bab":"قرآن › فضل قراءة القرآن","dorar":"NtdI26ei"},{"id":"س-00570","fp":"c72fa885f762","stateId":484,"easy":"إذا أوتيت القرآن والإيمان ← فمثلك كالأترجة طيبة الطعم والريح","cause":"مَن أُعطي القرآنَ والإيمانَ","result":"كمثَلِ أُترُجَّةٍ طيِّبِ الطَّعمِ طيِّبِ الرِّيحِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"otherNeedIds":[18],"ref":"تخريج صحيح ابن حبان 121","srcLabel":"متفق عليه","text":["مَثَلُ ",["مَن أُعطي القرآنَ والإيمانَ",1]," ",["كمثَلِ أُترُجَّةٍ طيِّبِ الطَّعمِ طيِّبِ الرِّيحِ",2]," ومَثَلُ مَن لم يُعطَ القرآنَ ولم يُعطَ الإيمانَ كمَثَلِ الحنظلةِ مُرَّةِ الطَّعمِ لا ريحَ لها ومَثلُ مَن أُعطي الإيمانَ ولم يُعطَ القرآنَ كمَثَلِ التَّمرةِ طيِّبةِ الطَّعمِ ولا ريحَ لها ومَثَلُ مَن أُعطي القرآنَ ولم يُعطَ الإيمانَ كمَثَلِ الرَّيحانةِ مُرَّةِ الطَّعمِ طيِّبةِ الرِّيحِ"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (5020)، ومسلم (797)، والترمذي (2865)، والنسائي (5038)، وابن حبان (403) واللفظ لهم.","bab":"آداب عامة › ضرب الأمثال","dorar":"EfJmTtpI"},{"id":"س-01823","fp":"201279548bf2","stateId":485,"easy":"إذا أعطيت ← فاليد العليا أفضل من السفلى","cause":"اليَدَ العُليا","result":"أفضَلُ مِنَ اليَدِ السُّفلى","explicit":true,"star":true,"similar":["س-05965"],"otherNeedIds":[43],"ref":"صحيح مسلم 1042","srcLabel":"متفق عليه","text":["لأن يَغدوَ أحَدُكُم فيَحطِبَ على ظَهرِه، فيَتَصَدَّقَ به ويَستَغنيَ به مِنَ النَّاسِ: خَيرٌ له مِن أن يَسألَ رَجُلًا أعطاه أو مَنَعَه ذلك؛ فإنَّ ",["اليَدَ العُليا",1]," ",["أفضَلُ مِنَ اليَدِ السُّفلى",2],"، وابدَأْ بمَن تَعولُ. [وفي روايةٍ]: واللهِ لأن يَغدوَ أحَدُكُم فيَحطِبَ على ظَهرِه فيَبيعَه بمِثلِه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2074) بمعناه مختصراً، ومسلم (1042).","bab":"إجارة › كسب الرجل وعمله بيده","dorar":"EhwmfBNf","merged":2,"otherRefs":["صحيح الجامع 5046 (صحيح)"]},{"id":"س-01824","fp":"c0c0350cabb9","stateId":485,"easy":"إذا كان مالك صالحاً وأنت صالح ← فنعم المال","cause":"المالُ الصَّالحُ للمَرءِ الصَّالحِ","result":"نِعْمَ المالُ","explicit":true,"star":true,"ref":"صحيح الأدب المفرد 229","srcLabel":"البخاري","text":["يا عَمرُو، إنِّي أُريدُ أن أَبعثَك على جَيشٍ فيُغنِمَك اللهُ، وأَرغَبَ لك رغبةً منَ المالِ صالحةً، قُلتُ: إنِّي لم أُسلِمْ رغبةً في المالِ، إنَّما أَسلَمْتُ رغبةً في الإسلامِ، فَأكونَ معَ رَسولِ اللهِ، فَقال: يا عمرُو،‍ ",["نِعْمَ المالُ",2],[" الصَّالحُ للمَرءِ الصَّالحِ",1],"."],"grade":"صحيح","narrator":"عمرو بن العاص","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (299)، والحاكم (2130)، والبيهقي في ((شعب الإيمان)) (1248)","bab":"إجارة › كسب الرجل وعمله بيده","dorar":"HdU4qpN2"},{"id":"ق-1296","fp":"b12ce91338f6","stateId":485,"easy":"السبق بالإنفاق والجهاد وقت الشدة ← أعظم درجة","cause":"السبق بالإنفاق والجهاد وقت الشدة","result":"أعظم درجة","explicit":true,"star":true,"ref":"سورة الحديد: 10","srcLabel":"القرآن الكريم","quran":{"s":57,"from":10,"to":10,"text":"وَمَا لَكُمْ أَلَّا تُنْفِقُوا فِي سَبِيلِ اللَّهِ وَلِلَّهِ مِيرَاثُ السَّمَاوَاتِ وَالْأَرْضِ لَا يَسْتَوِي مِنْكُمْ مَنْ أَنْفَقَ مِنْ قَبْلِ الْفَتْحِ وَقَاتَلَ أُولَئِكَ أَعْظَمُ دَرَجَةً مِنَ الَّذِينَ أَنْفَقُوا مِنْ بَعْدُ وَقَاتَلُوا وَكُلًّا وَعَدَ اللَّهُ الْحُسْنَى وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ (10)","hl":[[96,277,1]]}},{"id":"س-02674","fp":"a91860fab5b2","stateId":485,"easy":"إذا أعطاك الله مالاً فأنفقته وتصدقت ← فهو مما يُتنافس فيه","cause":"ورَجُلٌ أعطاه اللهُ مالًا فهو يُنفِقُ ويَتَصَدَّقُ","result":"لا تَنافُسَ بَينَكُم إلَّا في اثنَتَينِ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 16966","srcLabel":"أحمد","text":["«",["لا تَنافُسَ بَينَكُم إلَّا في اثنَتَينِ",2],": رَجُلٌ أعطاه اللهُ عَزَّ وجَلَّ القُرآنَ، فهو يَقومُ به آناءَ اللَّيلِ وآناءَ النَّهارِ، ويَتَّبِعُ ما فيه، فيَقولُ رَجُلٌ: لَو أنَّ اللهَ تَعالى أعطاني مِثلَ ما أعطى فُلانًا، فأقومَ به كما يَقومُ به، ",["ورَجُلٌ أعطاه اللهُ مالًا فهو يُنفِقُ ويَتَصَدَّقُ",1],"، فيَقولُ رَجُلٌ: لَو أنَّ اللهَ أعطاني مِثلَ ما أعطى فُلانًا فأتَصَدَّقَ به». فقال رَجُلٌ: يا رَسولَ اللهِ، أرَأيتَكَ النَّجدةَ تَكونُ في الرَّجُلِ... وسَقَطَ باقي الحَديثِ."],"grade":"صحيح","narrator":"يزيد بن الأخنس","muhaddith":"صحيح لغيره","bab":"إيمان › الاحتساب والنية","dorar":"C3hr7q6f","merged":3,"otherRefs":["صحيح البخاري 1409 (صحيح)","صحيح الترغيب 634 (حسن)"]},{"id":"س-02628","fp":"df1661bd4104","stateId":485,"easy":"إذا أعطاك الله مالاً وعلماً فاتقيت فيه ربك ووصلت رحمك ← فأنت بأرفع المنازل","cause":"رجلٌ أعطاهُ اللَّهُ مالًا وعِلمًا فهو يتَّقي في مالِه ربَّهُ ويصلُ فيه رحمَه ويعلمُ للَّهِ فيه حقَّه","result":"فهذا بأرفعِ المنازلِ","explicit":true,"ref":"فتاوى نور على الدرب لابن باز 18/266","srcLabel":"فتاوى نور على الدرب لابن باز","text":["الدُّنيا لأربَعةٍ ",["رجلٌ أعطاهُ اللَّهُ مالًا وعِلمًا فهو يتَّقي في مالِه ربَّهُ ويصلُ فيه رحمَه ويعلمُ للَّهِ فيه حقَّه",1]," ",["فهذا بأرفعِ المنازلِ",2]," ورجلٌ أعطاهُ اللَّهُ علمًا ولم يعطَ مالًا فكان يقولُ لو كان لي من المالِ مثلَ فلانٍ لعملتُ فيه مثلَ عملِه قال هذا بنيَّتِه فَهُم في الأجرِ سواءٌ"],"grade":"صحيح","muhaddith":"صحيح","bab":"إيمان › الاحتساب والنية","dorar":"DB8eA9e3"},{"id":"س-05965","fp":"b23cb33a3fa8","stateId":485,"easy":"إذا أعطيت ← فيدك العليا هي المعطية","cause":"اليَدَ العُليا","result":"خيرٌ هي المُنطيةُ","explicit":true,"repOf":"س-01823","otherNeedIds":[5],"ref":"سبل الهدى والرشاد 2/102","text":["أنَّ عَطِيَّةَ السَّعديِّ رَضِيَ اللهُ تعالى عنه قال: قَدِمتُ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فلمَّا رآني قال: ما أغناك اللهُ فلا تسألِ النَّاسَ؛ فإنَّ ",["اليَدَ العُليا",1]," ",["خيرٌ هي المُنطيةُ",2],"، واليَدُ السُّفلى هي المُنطاةُ، وإنَّ مالَ اللهِ مَسؤولٌ ومُنطًى. قال: فكَلَّمَنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بلُغَتِنا."],"grade":"صحيح","narrator":"عطية السعدي","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (8143) بلفظه، وأحمد (17983)، وعبد الرزاق (16406) كلاهما مختصرا.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"qFHGsihv"},{"id":"س-08322","fp":"7f27876925fa","stateId":485,"easy":"إذا عملت بيدك وتصدقت في سبيل الله ← فأنتِ خيرهن","cause":"كانت صنَّاعًا تُعينُ بما تصنعُ في سبيلِ اللَّهِ","result":"خيرُكنَّ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"در السحابة 259","srcLabel":"البزار","text":["حديثُ ",["خيرُكنَّ",2]," أطولُكنَّ يدًا.. وفيهِ لأنَّها ",["كانت صنَّاعًا تُعينُ بما تصنعُ في سبيلِ اللَّهِ",1]," [يعني حديث: أنَّ عمرَ كبَّر على زينبَ بنتِ جَحْشٍ أربعًا ثمَّ أرسَل إلى أزواجِ النَّبيِّ صلَّى اللهُ عليه وسلَّم مَن يُدخِلُ هذه قبرَها فقُلْنَ مَن كان يدخُلُ عليها في حياتِها ثمَّ قال عمرُ كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ أسرعُكنَّ بي لُحوقًا أطولُكُنَّ يدًا فكُنَّ يتطاوَلْنَ بأيديهنَّ وإنَّما كان ذلك لأنَّها كانت صنَاعًا تُعينُ بما تصنَعُ في سبيلِ اللهِ]"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده رجاله رجال الصحيح","takhrij":"أخرجه البزار (241) بلفظه، والطحاوي في ((شرح مشكل الآثار)) (209) بنحوه، وكلاهما مطولا وفي أوله قصة .","bab":"مناقب وفضائل › فضائل أزواج النبي صلى الله عليه وسلم","dorar":"xi33nOr5"},{"id":"س-06393","fp":"84b47e492de8","stateId":485,"easy":"إذا تصدقت بيمينك وأخفيتها عن شمالك ← فأنت أشد من الريح","cause":"ابنُ آدَمَ، يتصَدَّقُ بيَمينِه ويُخْفيها مِن شِمالِه","result":"فهل مِن خَلْقِك شيءٌ أشَدُّ مِن الرِّيحِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"الأحاديث المختارة 2149","srcLabel":"البخاري","text":["«لَمَّا خلق اللهُ تبارك وتعالى الأرضَ جَعَلَت تَميدُ، فخَلَق الجِبالَ، فألقاها عليها فاستقَرَّت، فتعَجَّبَت المَلائِكةُ مِن خَلقِ الجِبالِ، فقالت: يا رَبِّ، هل مِن خَلْقِك شيءٌ أشَدُّ مِن الجبالِ؟ قال: نَعَم، الحديدُ، قالت: يا رَبِّ، فهل مِن خَلْقِك شَيءٌ أشَدُّ مِنَ الحديدِ؟ قال: نَعَم، النَّارُ، قالت: يا رَبِّ، فهل مِن خَلْقِك شيءٌ أشَدُّ مِنَ النَّارِ؟ قال: نَعَم، الماءُ، قالت: يا رَبِّ، فهل مِن خَلْقِك شَيءٌ أشَدُّ مِن الماءِ؟ قال: نَعَم، الرِّيحُ، قالت: يا رَبِّ، ",["فهل مِن خَلْقِك شيءٌ أشَدُّ مِن الرِّيحِ؟",2]," قال: نَعَم، ",["ابنُ آدَمَ، يتصَدَّقُ بيَمينِه ويُخْفيها مِن شِمالِه",1],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"J6GpdItp"},{"id":"س-06322","fp":"af2c5584557a","stateId":485,"easy":"إذا كنتِ أصنع النساء بيديك (تعملين وتتصدقين) ← فأنتِ خيرهن","cause":"أصنعُكنَّ يدَينِ","result":"خيرُكُنَّ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"در السحابة 259","srcLabel":"ابن أبي شيبة","text":["كانَ للنَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ تِسعُ نسوةٍ فقالَ يومًا ",["خيرُكُنَّ",2]," أطولُكنَّ يدًا فكانت كلُّ واحدةٍ تضعُ يدَها على الجدارِ فقالَ لستُ أعني ذلك ولكن ",["أصنعُكنَّ يدَينِ",1]],"grade":"حسن","narrator":"أبو برزة الأسلمي نضلة بن عبيد","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن أبي شيبة كما في ((إتحاف الخيرة المهرة)) للبوصيري (3/38)، وأبو يعلى (7430)، والروياني في ((المسند)) (1317) باختلاف يسير","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"UwqA0BGd"},{"id":"س-07076","fp":"3bb8d14d6235","stateId":485,"easy":"إذا صليت ثم زكّيت ← فهي أفضل درجات الإسلام","cause":"قال : الصَّلاةُ . قال : ثمَّ أيُّ ؟ قال : الزَّكاةُ","result":"أيُّ درجاتِ الإسلامِ أفضلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح الترغيب 753","srcLabel":"الطبراني","text":["أنَّ ابنَ مسعودٍ كان عندَه غلامٌ يقرأُ في المُصحفِ ، وعندَهُ أصحابُهُ ، فجاءَ رجلٌ يُقالُ لهُ : حَضرمةُ ، فقال : يا أبا عبدِ الرَّحمنِ ! ",["أيُّ درجاتِ الإسلامِ أفضلُ",2]," ؟ ",["قال : الصَّلاةُ . قال : ثمَّ أيُّ ؟ قال : الزَّكاةُ",1]],"grade":"حسن","narrator":"زر بن حبيش","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (10/ 25) (9824) واللفظ له تامًا، وابن نصر المروزي في ((تعظيم قدر الصلاة)) (935) بلفظه دون ذكر: الزكاة، وزاد: من لم يصل فلا دين له.","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"NcdZjBbC"},{"id":"س-07209","fp":"7022da9742c6","stateId":485,"easy":"إذا أعتقت أنفس الرقاب وأغلاها ← فهي أفضل الرقاب","cause":"أكثرُها ثمنًا وأنفسُها عند أهلِها","result":"أفضلِ الرقابِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"البدر المنير 7/274","srcLabel":"مالك","text":["أنه صلَّى اللهُ عليهِ وسلمَ  سُئِل عن ",["أفضلِ الرقابِ",2]," فقال : ",["أكثرُها ثمنًا وأنفسُها عند أهلِها",1]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه مالك (2890)، وإسماعيل القاضي في ((مسند حديث مالك)) (2)، والأبهري في ((فوائده)) (34) جميعا باختلاف يسير.","bab":"علم › حسن السؤال ونصح العالم","dorar":"LKP5LFC6"},{"id":"س-06760","fp":"0a1c20807261","stateId":486,"easy":"إذا صمت ثلاثة أيام من كل شهر ← فهو صيام حسن","cause":"ثلاثةُ أيَّامٍ مِن كلِّ شهرٍ","result":"صيامٌ حسَنٌ","explicit":true,"star":true,"ref":"تخريج صحيح ابن حبان 3649","srcLabel":"مسلم","text":["أنَّ عثمانَ بنَ أبي العاصِ دعا بلبنٍ ليسقيَه فقال مُطرِّفٌ: إنِّي صائمٌ فقال عثمانُ: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( الصِّيامُ جُنَّةٌ كجُنَّةِ أحدِكم مِن القتالِ ) وسمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( ",["صيامٌ حسَنٌ",2]," ",["ثلاثةُ أيَّامٍ مِن كلِّ شهرٍ",1]," )"],"grade":"صحيح","narrator":"عثمان بن أبي العاص الثقفي","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن حبان (3649)، والبيهقي في ((شعب الإيمان)) (3295) واللفظ لهما، وابن أبي شيبة (8984) با ختلاف يسير، والنسائي في ((السنن الكبرى)) (2732) مختصرا.","bab":"صيام › فضل الصيام","dorar":"FBSz3SXV","merged":2,"otherRefs":["تخريج المسند لشعيب 17909 (صحيح)"]},{"id":"س-06753","fp":"73608995b898","stateId":486,"easy":"إذا صمت عاشوراء ورمضان ← فهما ما كان النبي ﷺ يتحرى فضلهما","cause":"يَومَ عاشوراءَ، وهذا الشَّهرَ","result":"فضَّلَه على غيرِه","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"apply":{"k":"time","t":"في رمضان"},"ref":"صحيح البخاري 2006","srcLabel":"متفق عليه","text":["ما رَأيتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم يَتَحَرَّى صيامَ يَومٍ ",["فضَّلَه على غيرِه",2]," إلَّا هذا اليَومَ؛ ",["يَومَ عاشوراءَ، وهذا الشَّهرَ",1],". يَعني شَهرَ رَمَضانَ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2006) واللفظ له، ومسلم (1132)","bab":"صيام › فضل الصيام","dorar":"YsL2RR3y","merged":5,"otherRefs":["تخريج المسند لشعيب 2854 (صحيح)","صحيح النسائي 2369 (صحيح)","تخريج المسند لشاكر 5/159 (صحيح)","مجمع الزوائد 3/189 (حسن)"]},{"id":"س-07215","fp":"b706f60a0e4f","stateId":486,"easy":"إذا صمت عاشوراء ← فهو يوم يُطلب فضله","cause":"صيامِ يَومِ عاشوراءَ","result":"يَطلُبُ فضلَه على الأيَّامِ إلَّا هذا اليومَ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"صحيح مسلم 1132","srcLabel":"البخاري","text":["سَمِعَ ابنَ عَبَّاسٍ رَضيَ اللهُ عنهما، وسُئِلَ عن ",["صيامِ يَومِ عاشوراءَ",1]," فقال: ما عَلِمتُ أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم صامَ يَومًا ",["يَطلُبُ فضلَه على الأيَّامِ إلَّا هذا اليومَ",2],"، ولا شَهرًا إلَّا هذا الشَّهرَ، يَعني: رَمَضانَ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2006) باختلاف يسير","bab":"علم › حسن السؤال ونصح العالم","dorar":"SBTG1dDc"},{"id":"س-03210","fp":"a716ea44aefd","stateId":486,"easy":"إذا أعددت في رمضان القوة للعبادة ← فهو خير شهر للمسلمين","cause":"لِمَا يُعِدُّ المُؤمِنون فيه مِنَ القوَّةِ للعِبادةِ","result":"ما أَتى على المُسلِمينَ شَهرٌ خَيرٌ لهُم مِن رَمضانَ","explicit":true,"apply":{"k":"time","t":"في رمضان"},"ref":"تخريج المسند لشاكر 16/158","srcLabel":"أحمد","text":[["ما أَتى على المُسلِمينَ شَهرٌ خَيرٌ لهُم مِن رَمضانَ",2],"، ولا أَتى على المُنافِقينَ شَهرٌ شَرٌّ مِن رمضانَ؛ وذلكَ ",["لِمَا يُعِدُّ المُؤمِنون فيه مِنَ القوَّةِ للعِبادةِ",1],"، وما يُعِدُّ فيه المُنافِقون مِن غَفَلاتِ النَّاسِ وعَوَراتِهِم، هو غُنْمُ [المُؤمِنِ] يَغتَنِمُه الفاجِرُ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (8870)، وابن أبي شيبة (8968)، وابن خزيمة (1884) باختلاف يسير","bab":"إيمان › فضل الإيمان","dorar":"H2i8R9ez"},{"id":"س-07134","fp":"93438530d718","stateId":486,"easy":"إذا صمت شعبان ← فهو لتعظيم رمضان","cause":"شعبانُ لتعظيمِ رمضانَ","result":"أيُّ الصَّومِ أفضلُ بعد رمضانَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"الترغيب والترهيب 2/131","srcLabel":"الترمذي","text":["سُئل النَّبيُّ صلَّى اللهُ عليه وسلَّم ",["أيُّ الصَّومِ أفضلُ بعد رمضانَ",2]," قال ",["شعبانُ لتعظيمِ رمضانَ",1]," قال فأيُّ الصَّدقةِ أفضلُ قال صدقةٌ في رمضانَ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (663) واللفظ له، والبزار (6890)، والبيهقي (8780)","bab":"علم › حسن السؤال ونصح العالم","dorar":"ueFlqYZ0"},{"id":"س-04381","fp":"ae9b563f99b4","stateId":486,"easy":"إذا صمت بعد رمضان ← فأنت كالكارّ بعد الفارّ","cause":"الصائمُ بعدَ رمضانَ","result":"كالكارِّ بعدَ الفارِّ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"apply":{"k":"time","t":"في رمضان"},"ref":"الجامع الصغير 5107","srcLabel":"البيهقي","text":[["الصائمُ بعدَ رمضانَ",1]," ",["كالكارِّ بعدَ الفارِّ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (3462)، وفي ((فضائل الأوقات)) (162) واللفظ له.","bab":"جهاد › التولي والفرار من الزحف","dorar":"59v6o0dX"},{"id":"س-07128","fp":"bbcdc1db2829","stateId":486,"easy":"إذا صمت في السفر بلا مشقة ← فالصوم أفضل","cause":"ومَن صام","result":"فالصَّومُ أفضَلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"إرشاد الفقيه 281/1","srcLabel":"الضياء","text":["سُئِلَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم عنِ الصَّومِ في السَّفَرِ فقال: مَن أفطَر فرُخصةٌ، ",["ومَن صام",1]," ",["فالصَّومُ أفضَلُ",2],"."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده رجاله كلهم ثقات","takhrij":"أخرجه الضياء في ((المختارة)) (2307)، وأبو حفص الكناني كما في ((سلسلة الأحاديث الضعيفة)) للألباني (932)، والذهبي في ((سير أعلام النبلاء)) (16/ 484) جميعا بلفظه.","bab":"علم › حسن السؤال ونصح العالم","dorar":"0qSWkz8E"},{"id":"س-04365","fp":"db90bb450506","stateId":487,"easy":"إذا حجت المرأة حجاً مبروراً ← فهو أحسن جهادها","cause":"حجُّ البيتِ ، حجٌّ مبرورٌ","result":"ولَكُنَّ أحسنُ الجِهادِ وأجملُه","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"star":true,"otherNeedIds":[49],"ref":"صحيح النسائي 2627","srcLabel":"البخاري","text":["يا رسولَ اللَّهِ ! ألا نَخرجُ فنجاهدَ معَك ، فإنِّي لا أرَى عملًا في القرآنِ أفضلَ منَ الجِهادِ ؟ ! قالَ : لا ، ",["ولَكُنَّ أحسنُ الجِهادِ وأجملُه",2]," ، ",["حجُّ البيتِ ، حجٌّ مبرورٌ",1]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1861)، والنسائي (2628) واللفظ له، وابن ماجه (2901)، وأحمد (24497)","bab":"جهاد › الترغيب في الجهاد","dorar":"6F0gx4bp","merged":2,"otherRefs":["صحيح الجامع 5160 (صحيح)"]},{"id":"س-04398","fp":"4849616de5f7","stateId":487,"easy":"إذا حججت ← فهو أفضل جهاد للضعيف","cause":"الحجُّ","result":"أفضَلُ جهادٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"star":true,"ref":"الزواجر عن اقتراف الكبائر 1/205","srcLabel":"الزواجر عن اقتراف الكبائر","text":["إنِّي جبانٌ وإنِّي ضعيفٌ ، فقالَ : هلُمَّ إلى جهادٍ لا شَوكةَ فيهِ ",["الحجُّ",1]," ",["أفضَلُ جهادٍ",2]," وحجٌّ مبرورٌ جِهادُ الكبيرِ والضَّعيفِ والمرأةِ"],"grade":"صحيح","muhaddith":"صحيح أو حسن","bab":"جهاد › الشجاعة في الحرب والجبن","dorar":"kno59xQJ","merged":2,"otherRefs":["صحيح البخاري 1520 (صحيح)"]},{"id":"س-07198","fp":"4dcd37789e15","stateId":487,"easy":"إذا اعتمرت ← فهو أفضل","cause":"وأنْ تعتمِروا","result":"هوَ أفضلُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سنن الترمذي 931","srcLabel":"أحمد","text":["أنَّ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ سُئلَ عنِ العمرةِ أواجبةٌ هيَ ؟ قال : لا، ",["وأنْ تعتمِروا",1]," ",["هوَ أفضلُ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"حسن صحيح","takhrij":"أخرجه أحمد (14397)، وابن خزيمة (3068) بلفظه.","bab":"علم › حسن السؤال ونصح العالم","dorar":"gqXN9GMM"},{"id":"س-00225","fp":"4de82b13e078","stateId":487,"easy":"إذا حججت ← فالحج من سبيل الله","cause":"فإنَّ الحجَّ","result":"من سبيلِ اللهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"إرواء الغليل 1587","srcLabel":"أبو داود","text":["يا رسولَ اللهِ إنَّ أبا مَعقلٍ جعل ناضحةً في سبيلِ اللهِ . فقال : ارْكبيه ",["فإنَّ الحجَّ",1]," ",["من سبيلِ اللهِ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1990)، وابن خزيمة (3077)، والحاكم (1779) مطولا بنحوه.","bab":"آداب المجلس › الركوب على الدابة","dorar":"0jhz261x"},{"id":"س-07236","fp":"87dc34090054","stateId":487,"easy":"إذا رفعت صوتك بالتلبية ونحرت ← فهو أفضل الحج","cause":"العجُّ والثُّجُّ","result":"ما بالُ الحجِّ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح الترغيب 1138","srcLabel":"الترمذي","text":[["ما بالُ الحجِّ",2]," ؟ قال : ",["العجُّ والثُّجُّ",1]],"grade":"حسن","narrator":"أبو بكر الصديق","muhaddith":"حسن لغيره","takhrij":"أخرجه الترمذي (827)، وابن ماجة (2924)، والدارمي (1837) باختلاف يسير.","bab":"علم › سؤال العالم عما لا يعلم","dorar":"sR9m8h14"},{"id":"س-04523","fp":"893c48d1c094","stateId":488,"easy":"إذا استُشهدت ← تتمنى أن تُقتل عشر مرات لما ترى من فضل الشهادة","cause":"فأُقْتَلَ في سبيلِك عَشْرَ مِرَارٍ","result":"لِمَا يَرَى من فضلِ الشهادةِ","explicit":true,"star":true,"similar":["س-02880","س-02219"],"ref":"صحيح الجامع 7996","srcLabel":"مسلم","text":["يُؤْتَى بالرجلِ يومَ القيامةِ من أهلِ الجنةِ ، فيقولُ له : يا ابنَ آدمَ ! كيف وَجَدْتَ مَنْزِلَكَ ؟ فيقولُ : أَيْ رَبِّ ! خيرُ مَنْزِلٍ ، فيقولُ : سَلْ وتَمَنَّ ، فيقولُ : يا ربِّ ما أسألُ ولا أَتَمَنَّى إلَّا أن تَرُدَّنِي إلى الدنيا ، ",["فأُقْتَلَ في سبيلِك عَشْرَ مِرَارٍ",1]," ، ",["لِمَا يَرَى من فضلِ الشهادةِ",2]," ، ويُؤْتَى بالرجلِ من أهلِ النارِ ، فيقولُ له : يا ابنَ آدمَ ! كيف وَجَدْتَ مَنْزِلَكَ ؟ فيقولُ : أَيْ رَبِّ ! شَرُّ مَنْزِلٍ ، فيقولُ له : أَتَفْتَدِي منه بطِلَاعِ الأرضِ ذهبًا ؟ فيقولُ : أَيْ رَبِّ ! نعم ، فيقولُ : كَذَبْتَ قد سألتُكَ أَقَلَّ من ذلك وأَيْسَرَ ، فلم تفعلْ فيُرَدُّ إلى النارِ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2805)، والنسائي (3160) مختصراً، وأحمد (13162) واللفظ له","bab":"جهاد › فضل الشهيد","dorar":"TsXcFLkC","merged":7,"otherRefs":["تخريج صحيح ابن حبان 4661 (صحيح)","تخريج المسند لشعيب 13628 (صحيح)","السلسلة الصحيحة 5/269 (صحيح)","صحيح البخاري 2795 (صحيح)","صحيح الترغيب 1357 (صحيح)","صحيح الجامع 5638 (صحيح)"]},{"id":"س-06756","fp":"38f7e9b7ebb1","stateId":488,"easy":"إذا خرجت مجاهداً ← فلا عمل يعدل الجهاد","cause":"إذا خَرَجَ المُجاهِدُ","result":"عَمَلٍ يَعدِلُ الجِهادَ، قال: لا أجِدُه","explicit":true,"star":true,"otherNeedIds":[49],"ref":"صحيح البخاري 2785","srcLabel":"مسلم","text":["جاءَ رَجُلٌ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: دُلَّني على ",["عَمَلٍ يَعدِلُ الجِهادَ، قال: لا أجِدُه",2],"، قال: هل تَستَطيعُ ",["إذا خَرَجَ المُجاهِدُ",1]," أن تَدخُلَ مَسجِدَكَ فتَقومَ ولا تَفتُرَ، وتَصومَ ولا تُفطِرَ؟ قال: ومَن يَستَطيعُ ذلك؟! قال أبو هُرَيرةَ: إنَّ فرَسَ المُجاهِدِ لَيَستَنُّ في طِوَلِه، فيُكتَبُ له حَسَناتٍ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1878) بنحوه","bab":"صيام › فضل الصيام","dorar":"3YqKddoM","merged":3,"otherRefs":["لطائف المعارف 436 (صحيح)","تخريج المسند لشاكر 16/224 (صحيح)"]},{"id":"س-02880","fp":"00802d4cf96b","stateId":488,"easy":"إذا استُشهدت ← تتمنى أن ترجع فتُقتل لما ترى من فضل الشهادة","cause":"الشَّهيدُ","result":"يسُرُّه أنْ يَرجِعَ إلى الدُّنيا، فيُقتَلَ؛ لِمَا يرَى مِنْ فضلِ الشَّهادةِ","explicit":true,"repOf":"س-04523","ref":"تخريج المسند لشعيب 12557","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال: ما مِنْ نَفْسٍ تموتُ لها عندَ اللهِ خيرٌ، فيَسُرُّها أنْ تَرجِعَ إلى الدُّنيا، إلَّا ",["الشَّهيدُ",1],"؛ فإنَّ الشَّهيدَ ",["يسُرُّه أنْ يَرجِعَ إلى الدُّنيا، فيُقتَلَ؛ لِمَا يرَى مِنْ فضلِ الشَّهادةِ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (2795)، ومسلم (1877)، والترمذي (1643)، وأحمد (12557) واللفظ له","bab":"إيمان › الوعد","dorar":"s7OKMw7P"},{"id":"س-02614","fp":"1d2e83ffbfc9","stateId":488,"easy":"إذا جاهدت في سبيل الله ← فلها من الفضل كما بين السماء والأرض","cause":"وهي: الجِهادُ في سبيلِ اللهِ","result":"والرابعةُ لها منَ الفضْلِ كما بيْنَ السَّماءِ إلى الأرضِ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 11102","srcLabel":"مسلم","text":["أخَذ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بيَدي فقال: \"يا أبا سعيدٍ، ثلاثةٌ مَن قالهُنَّ: دخَل الجَنَّةَ\"، قُلتُ: ما هُنَّ يا رسولَ اللهِ؟ قال: \"مَن رضِي باللهِ ربًّا، وبالإسلامِ دِينًا، وبمحمَّدٍ رسولًا\"، ثُم قال: \"يا أبا سعيدٍ، ",["والرابعةُ لها منَ الفضْلِ كما بيْنَ السَّماءِ إلى الأرضِ",2],"، ",["وهي: الجِهادُ في سبيلِ اللهِ",1],"\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1884) باختلاف يسير","bab":"إيمان › الأمر بالإيمان بالله تعالى ورسوله وشرائع الدين","dorar":"oGO1vDwH"},{"id":"س-06799","fp":"c32de3d8f60c","stateId":488,"easy":"إذا بلغت العدو بسهم ← فلك درجة في الجنة","cause":"مَن بَلَغَ بسَهمٍ","result":"فله درجةٌ في الجَنَّةِ","explicit":true,"similar":["س-02899","س-04430","س-06813"],"otherNeedIds":[67],"ref":"تخريج المسند لشعيب 17022","srcLabel":"مسلم","text":["حاصَرْنا مع نَبيِّ اللهِ صلَّى اللهُ عليه وسلَّمَ حِصنَ الطائفِ، فسمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن بَلَغَ بسَهمٍ ",1],["فله درجةٌ في الجَنَّةِ",2],". قال: فبلَّغْتُ يَومَئذٍ ستَّةَ عَشَرَ سَهمًا، فسمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: مَن رَمى بسَهمٍ في سبيلِ اللهِ عزَّ وجلَّ فهو عِدْلُ مُحَرَّرٍ، ومَن شابَ شَيْبةً في سبيلِ اللهِ، كانت له نورًا يَومَ القيامةِ، وأَيُّما رجُلٍ مُسلِمٍ أَعتَقَ رجُلًا مُسلِمًا، فإنَّ اللهَ عزَّ وجلَّ جاعِلٌ وَفاءَ كلِّ عَظْمٍ مِن عِظامِه عَظْمًا مِن عِظامِ مُحَرِّرِه مِنَ النارِ، وأَيُّما امْرأةٍ مُسلِمةٍ أَعتَقَتِ امْرأةً مُسلِمةً، فإنَّ اللهَ عزَّ وجلَّ جاعِلٌ وَفاءَ كلِّ عَظْمٍ مِن عِظامِها عَظْمًا مِن عِظامِ مُحَرِّرِها مِنَ النارِ."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أبو داود (3966) مختصرا بنحوه، والترمذي (1638) مختصرا، والنسائي (3145) مختصرا باختلاف يسير، وأحمد (17022) واللفظ له","bab":"عتق وولاء › فضل العتق","dorar":"hWvbEIGM"},{"id":"ق-0238","fp":"018c8c5958a9","stateId":488,"easy":"الجهاد في سبيل الله بالمال والنفس ← درجات ومغفرة ورحمة وأجر عظيم","cause":"الجهاد في سبيل الله بالمال والنفس","result":"درجات ومغفرة ورحمة وأجر عظيم","explicit":true,"otherNeedIds":[11,24],"ref":"سورة النساء: 95–96","srcLabel":"القرآن الكريم","quran":{"s":4,"from":95,"to":96,"text":"لَا يَسْتَوِي الْقَاعِدُونَ مِنَ الْمُؤْمِنِينَ غَيْرُ أُولِي الضَّرَرِ وَالْمُجَاهِدُونَ فِي سَبِيلِ اللَّهِ بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ فَضَّلَ اللَّهُ الْمُجَاهِدِينَ بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ عَلَى الْقَاعِدِينَ دَرَجَةً وَكُلًّا وَعَدَ اللَّهُ الْحُسْنَى وَفَضَّلَ اللَّهُ الْمُجَاهِدِينَ عَلَى الْقَاعِدِينَ أَجْرًا عَظِيمًا (95) دَرَجَاتٍ مِنْهُ وَمَغْفِرَةً وَرَحْمَةً وَكَانَ اللَّهُ غَفُورًا رَحِيمًا (96)","hl":[[141,418,1]]}},{"id":"ق-0489","fp":"3888401b13b2","stateId":488,"easy":"الإيمان والهجرة والجهاد في سبيل الله بالمال والنفس ← أعظم درجة والفوز ورحمة ورضوان وجنات فيها نعيم مقيم","cause":"الإيمان والهجرة والجهاد في سبيل الله بالمال والنفس","result":"أعظم درجة والفوز ورحمة ورضوان وجنات فيها نعيم مقيم","explicit":true,"otherNeedIds":[53,23,67],"ref":"سورة التوبة: 20–22","srcLabel":"القرآن الكريم","quran":{"s":9,"from":20,"to":22,"text":"الَّذِينَ آمَنُوا وَهَاجَرُوا وَجَاهَدُوا فِي سَبِيلِ اللَّهِ بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ أَعْظَمُ دَرَجَةً عِنْدَ اللَّهِ وَأُولَئِكَ هُمُ الْفَائِزُونَ (20) يُبَشِّرُهُمْ رَبُّهُمْ بِرَحْمَةٍ مِنْهُ وَرِضْوَانٍ وَجَنَّاتٍ لَهُمْ فِيهَا نَعِيمٌ مُقِيمٌ (21) خَالِدِينَ فِيهَا أَبَدًا إِنَّ اللَّهَ عِنْدَهُ أَجْرٌ عَظِيمٌ (22)","hl":[[0,325,1]]}},{"id":"س-02899","fp":"a4eff0ffd5ba","stateId":488,"easy":"إذا بلغت العدو بسهم ← يرفعك الله به درجة","cause":"من بَلغَ العدوَّ بسَهْمٍ","result":"رفعَهُ اللَّهُ بِهِ درجةً","explicit":true,"repOf":"س-06799","ref":"صحيح النسائي 3144","text":["مَن شابَ شيبةً في الإسلامِ في سبيلِ اللَّهِ تعالى ، كانت لَهُ نورًا يومَ القيامَةِ . قال له : حدِّثنا عنِ النَّبيِّ واحذَر قالَ : سَمِعْتُهُ يقولُ : ارموا ",["من بَلغَ العدوَّ بسَهْمٍ",1]," ",["رفعَهُ اللَّهُ بِهِ درجةً",2]," . قالَ ابنُ النَّحَّامِ : يا رسولَ اللَّهِ ، وما الدَّرجةُ ؟ قالَ : أما إنَّها ليسَت بعُتبةِ أُمِّكَ ، ولَكِن ما بينَ الدَّرجتينِ مائةُ عامٍ"],"grade":"صحيح","narrator":"كعب بن مرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1634)، والنسائي (3144) واللفظ له","bab":"إيمان › الوعد","dorar":"m9Cex6FX","merged":2,"otherRefs":["تخريج المسند لشعيب 18063 (حسن)"]},{"id":"س-04400","fp":"27b27ba17e00","stateId":488,"easy":"إذا كنت مؤمناً جيد الإيمان فلقيت العدو حتى قُتلت ← يرفع الناس إليك أعينهم يوم القيامة","cause":"رجلٌ مؤمنٌ جيِّدُ الإيمانِ لقي العدوَّ حتَّى قتِل","result":"فذاك الَّذي يرفعُ النَّاسُ إليه أعينَهم يومَ القيامةِ","explicit":true,"otherNeedIds":[62,68],"ref":"الترغيب والترهيب 2/284","srcLabel":"الترمذي","text":["الشُّهداءُ أربعةٌ ",["رجلٌ مؤمنٌ جيِّدُ الإيمانِ لقي العدوَّ حتَّى قتِل",1]," ",["فذاك الَّذي يرفعُ النَّاسُ إليه أعينَهم يومَ القيامةِ",2]," هكذا ورفع رأسَه حتَّى وقعت قلنسوتَه فلا أدري قلنسوةَ عمرَ أراد أم قلنسوةَ النَّبيِّ صلَّى اللهُ عليه وسلَّم قال ورجلٌ مؤمنٌ جيِّدُ الإيمانِ لقي العدوَّ فكأنَّما ضُرِب جلدُه بشوْكِ طلحٍ من الجُبنِ أتاه سهمُ غرْبٍ فهو في الدَّرجةِ الثَّانيةِ ورجلٌ مؤمنٌ خلَط عملًا صالحًا وآخرَ سيِّئًا لقي العدوَّ فصدق اللهَ حتَّى قُتِل فذاك في الدَّرجةِ الثَّالثةِ ورجلٌ مؤمنٌ أسرف على نفسِه لقي العدوَّ فصدق اللهَ حتَّى قُتِل فذلك في الدَّرجةِ الأولَى"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (1644)، وأحمد (150)، وعبد بن حميد في ((المنتخب)) (27)، وابن أبي عاصم في الجهاد (187 ) باختلاف يسير","bab":"جهاد › الشجاعة في الحرب والجبن","dorar":"JjJ9jqmc","merged":2,"otherRefs":["تخريج المسند لشاكر 1/89 (حسن)"]},{"id":"س-04403","fp":"43c8dc40e9ad","stateId":488,"easy":"إذا أسرفت على نفسك ثم صدقت الله حتى قُتلت ← تكون في الدرجة الأولى","cause":"ورجلٌ مؤمنٌ أسرف على نفسِه لقي العدوَّ فصدق اللهَ حتَّى قُتِل","result":"فذلك في الدَّرجةِ الأولَى","explicit":true,"similar":["س-04402"],"otherNeedIds":[11,68],"ref":"الترغيب والترهيب 2/284","srcLabel":"الترمذي","text":["الشُّهداءُ أربعةٌ رجلٌ مؤمنٌ جيِّدُ الإيمانِ لقي العدوَّ حتَّى قتِل فذاك الَّذي يرفعُ النَّاسُ إليه أعينَهم يومَ القيامةِ هكذا ورفع رأسَه حتَّى وقعت قلنسوتَه فلا أدري قلنسوةَ عمرَ أراد أم قلنسوةَ النَّبيِّ صلَّى اللهُ عليه وسلَّم قال ورجلٌ مؤمنٌ جيِّدُ الإيمانِ لقي العدوَّ فكأنَّما ضُرِب جلدُه بشوْكِ طلحٍ من الجُبنِ أتاه سهمُ غرْبٍ فهو في الدَّرجةِ الثَّانيةِ ورجلٌ مؤمنٌ خلَط عملًا صالحًا وآخرَ سيِّئًا لقي العدوَّ فصدق اللهَ حتَّى قُتِل فذاك في الدَّرجةِ الثَّالثةِ ",["ورجلٌ مؤمنٌ أسرف على نفسِه لقي العدوَّ فصدق اللهَ حتَّى قُتِل",1]," ",["فذلك في الدَّرجةِ الأولَى",2]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (1644)، وأحمد (150)، وعبد بن حميد في ((المنتخب)) (27)، وابن أبي عاصم في الجهاد (187 ) باختلاف يسير","bab":"جهاد › الشجاعة في الحرب والجبن","dorar":"JjJ9jqmc","merged":2,"otherRefs":["تخريج المسند لشاكر 1/89 (حسن)"]},{"id":"س-06243","fp":"edd795be67a2","stateId":488,"easy":"إذا جاهدت بسيفك ولسانك ← فكأنما ترمي أعداء الله بالنبل","cause":"إنَّ المؤمنَ يُجاهِدُ بسَيفِهِ ولسانِهِ","result":"لَكأنَّ ما تَرْمونَهُمْ بهِ مِن نَضْحِ النَّبْلِ","explicit":true,"otherNeedIds":[25],"ref":"تخريج شرح السنة 3409","srcLabel":"أحمد","text":["أنَّهُ قالَ للنَّبيِّ صلَّى اللهُ عليه وسلَّمَ: إنَّ اللَّهَ قدْ أنزَلَ في الشِّعرِ ما أنزَلَ، فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",["إنَّ المؤمنَ يُجاهِدُ بسَيفِهِ ولسانِهِ",1],"، والَّذي نَفْسي بيدِهِ ",["لَكأنَّ ما تَرْمونَهُمْ بهِ مِن نَضْحِ النَّبْلِ",2],"."],"grade":"صحيح","narrator":"كعب بن مالك","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (27174)، وابن حبان (4707)، والطبراني في ((المعجم الكبير)) (11/ 5) (4707) باختلاف يسير.","bab":"شعر › هجاء المشركين والأمر به","dorar":"b4r9kMAK","merged":2,"otherRefs":["هداية الرواة 4724 (صحيح)"]},{"id":"س-01693","fp":"9c24067c9ee6","stateId":488,"easy":"إذا جاهدت ← فالجهاد رهبانية الأمة","cause":"عليكَ بالجهادِ","result":"فإنَّهُ رهبانيَّةُ أمَّتي","explicit":true,"similar":["س-02251","س-00915"],"ref":"النوافح العطرة 227","srcLabel":"أحمد","text":["قُلِ الحقَّ وإن كان مُرًّا [يعني حديث: دخَلتُ علَى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وهو في المسجِدِ جالِسٌ، فاغتَنَمتُ خلوتَهُ، وحدَهُ، فجلَستُ إليهِ، فقالَ : أبا ذَرٍّ ! إن لِلمَسجِد تَحيَّةً، وإنَّ تحيَّتَهُ ركعتان فقُم فاركَعهما، قالَ : فقُمت فركَعتُها ثم عُدتُ فجلَستُ إليهِ، فقُلتُ : يا رسولَ اللهِ ! إنَّكَ أمَرتَني بالصَّلاةِ فما الصَّلاةُ ؟ قال : خيرٌ موضوعٌ استكثِرْ أو استَقِلَّ. قلتُ : يا رسولَ اللهِ ! فأيُّ الأعمالِ أفضَلُ ؟ قال : إيمانٌ باللَّهِ عزَّ وجلَّ، وجهادٌ في سبيلِهِ، قال : قلتُ : يا رسولَ اللهِ ! فأيُّ المؤمنينَ أكمَلُهم إيمانًا ؟ قالَ : أحسَنُهُم خُلُقًا. قالَ : قلتُ : يا رسولَ اللَّهِ ! فأيُّ المؤمنينَ أسلَمُ ؟ قالَ : مَن سلِمَ النَّاسُ من لسانِهِ ويدِهِ. قال : قلتُ : يا رسولَ اللَّهِ ! فأيُّ الهجرةِ أفضَلُ ؟ قال : مَن هجرَ السَّيِّئاتِ. قالَ : قُلتُ : يا رسولَ اللهِ ! فأيُّ الصَّلاةِ أفضَلُ ؟ قال : طولُ القنوتِ . قال : قلتُ : يا رسولَ اللهِ ! فما الصِّيامُ ؟ قالَ : فرضٌ مَجزيٌّ ، وعندَ اللهِ أضعافٌ كثيرةٌ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ الجهادِ أفضَلُ ؟ قالَ : مَن عُقِرَ جوادُهُ وأهريقَ دمُهُ. قال : قُلتُ : يا رسولَ اللهِ ! فأيُّ الرِّقابِ أفضَلُ ؟ قالَ : أغلاها ثَمنًا وأنفَسُها عندَ ربِّها. قالَ : قلتُ : يا رسولَ اللهِ ! فأيُّ الصَّدقةِ أفضَلُ ؟ قال : جُهدٌ مِن مُقِلٍّ يُسَرُّ إلى فقيرٍ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ آيةٍ مِمَّا أنزلَ اللهُ عزَّ وجلَّ عليكَ أعظَمُ ؟ قال : آيةُ الكُرسيِّ. ثُمَّ قالَ : يا أبا ذَرٍّ ! ما السَّماواتُ السَّبعُ معَ الكُرسيِّ إلا كَحلقَةٍ مُلقاةٍ بأرضِ فلاةٍ، وفَضلُ العَرشِ على الكُرسيِّ كفَضلِ الفَلاةِ علَى الحَلقَةِ. قلتُ : يا رسولَ اللهِ ! كم الأنبياءُ ؟ قال : مائةُ ألفٍ وأربعةٌ وعِشرونَ ألفًا. قلتُ : يا رسولَ اللهِ ! كم الرُّسلِ ؟ قالَ : ثلاثُمائةٍ وثلاثَةُ عشرَ جَمًّا غفيرًا. قلتُ : كثيرٌ طيِّبٌ، قلتُ : يا رسولَ اللهِ ! مَن كان أوَّلُهمْ ؟ قال : آدَمُ. قلتُ : يا رسولَ اللهِ ! أنَبيٌّ مُرسَلٌ ؟ قال : نعَم، خلقَهُ اللهُ بيدِهِ، ونفخَ فيهِ مِن روحِهِ، ثُمَّ سوَّاهُ قِبَلًا. وقال أحمدُ بنُ أنَسٍ ثُمَّ كلَّمهُ قِبَلًا. ثُمَّ قالَ : يا أبا ذَرٍّ ! أربعةٌ سُريانيُّونَ؛ آدَمُ، وشيثُ، وخَنوخُ - وهو إدريسُ، وهم أوَّلُ مَن خطَّ بالقلَمِ - ونوحٌ. وأربعةٌ من العَربِ؛ هودٌ، وصالِحٌ، وشُعَيبٌ، ونبيُّكَ يا أبا ذَرٍّ. قال : قلتُ : يا رسولَ اللهِ ! كَم كتابٌ أنزلَهُ اللَّهُ تعالى ؟ قال : مائةُ كتابٍ وأربعةُ كتُبٍ، أنزلَ علَى شيثَ خَمسونَ صحيفَةً، وأنزلَ علَى خَنوخَ ثلاثونَ صَحيفةً، وأنزلَ على إبراهيمَ عشرَ صحائفَ، وأنزلَ على موسَى قبلَ التَّوراةِ عَشرَ صحائفَ، وأنزلَ التَّوراةَ والإنجيلَ والزَّبورَ والفُرقانَ. قال : قلتُ : يا رسولَ اللهِ ! فَما كانَت صُحفُ إبراهيمَ ؟ قالَ : كانَت أمثالًا كلُّها : أيُّها الملِكُ المسلَّطُ المبتَلَى المغرورُ، فإنِّي لم أبعثْكَ لتجمَعَ الدُّنيا بعضَها إلى بعضٍ، ولكن بعثتُكَ لترُدَّ عنِّي دعوةَ المظلومِ، فإنِّي لا أردُّها ولَو كانَت مِن كافِرٍ. وكانَت فيها أمثالٌ : علَى العاقِلِ ما لَم يكُن مغلوبًا علَى عقلِهِ أن تكونَ له ساعاتٌ؛ ساعَةٌ يُناجي فيها ربَّهُ عزَّ وجلَّ، وساعةٌ يحاسِبُ فيها نفسَهُ، وساعَةٌ يفكِّرُ فيها في صُنعِ اللَّهِ عزَّ وجلَّ، وساعةٌ يخلو فيها بحاجتِهِ من المطعَمِ والمشرَبِ، وعلى العاقلِ أن لا يكون ظاعِنًا إلَّا لثلاثٍ؛ تزوُّدٍ لمعادٍ، أو مرمَّةٍ لمعاشٍ، أو لذَّةٍ في غيرِ محرَّمٍ، وعلى العاقِلِ أن يكونَ بصيرًا بزمانِهِ، مقبِلًا على شأنِهِ، حافِظًا للسانِهِ، ومن حسَبَ كلامَهُ من عمَلِهِ قلَّ كلامُهُ إلا فيما يعنيهِ. قلتُ : يا رسولَ اللَّهِ ! فما كان صحُفُ موسَى عليهِ السَّلامُ ؟ قال : كانَت عبرًا كلَّها، عجبتُ لمن أيقنَ بالموتِ ثُمَّ هو يفرَحُ، عجبتُ لمن أيقنَ بالنَّارِ وهو يضحَكُ، عجبتُ لمن أيقنَ للقدرِ ثم هو ينصَبُ، عجبتُ لمن رأى الدُّنيا وتقلُّبَها ثُمَّ اطمأنَّ إليها، عجِبتُ لمن أيقنَ بالحسابِ غدًا ثُمَّ لا يعمَلُ. قلتُ : يا رسولَ اللهِ ! أوصِني. قال : أوصيكَ بتقوى اللهِ فإنَّهُ رأسُ الأمرِ كلِّهِ، قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بتلاوَةِ القرآنِ فإنَّهُ نور لكَ في الأرضِ وذكرٌ لكَ في السَّماءِ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : إيَّاكَ وكثرةَ الضَّحِكِ فإنَّهُ يُميتُ القَلبَ، ويَذهَبُ بنورِ الوَجهِ، قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : عليكَ بالصَّمتِ إلَّا مِن خيرٍ، فإنَّهُ مطردَةٌ للشَّيطانِ عنكَ، وعونٌ لكَ علَى أمر دينِكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : ",["عليكَ بالجهادِ",1]," ",["فإنَّهُ رهبانيَّةُ أمَّتي",2],". قلتُ : يا رسولَ اللهِ ! زِدني. قال : حبُّ المساكينِ وجالِسهُم. قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : انظُر إلى مَن تحتَكَ ولا تنظُر إلى مَن فوقكَ فإنَّهُ أجدَرُ أن لا تَزدَري نِعمةَ اللهِ عندكَ. قلتُ : زِدني يا رسولَ اللهِ ! قال : صِلْ قرابَتَكَ وإن قَطعوكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : لا تَخَف في اللَّهِ تعالى لَومَةَ لائمٍ. قلتُ : يا رسولَ اللهِ ! زِدني. قالَ : قُل الحقَّ وإن كان مُرًّا. قلتُ : يا رسولَ اللهِ ! زِدني. قال : يردُّكَ عن النَّاسِ ما تعرفُ من نفسِكَ، ولا تجِد عليهِم فيما تأتي، وكفَى به عيبًا أن تعرِفَ من النَّاسِ ما تجهَلُ من نفسِكَ، أو تجِدُ عليهِم فيما تأتي. ثُمَّ ضربَ بيدِهِ علَى صدري، فقالَ : يا أبا ذَرٍّ ! لا عقلَ كالتَّدبيرِ، ولا ورعَ كالكَفِّ، ولا حسَبَ كحُسنِ الخُلُقِ، قلتُ : يارسولَ اللهِ ! هل لي في الدُّنيا شَيءٌ مِمَّا أنزلَ اللهُ عليكَ مِمَّا كان في صحُفِ إبراهيمَ وموسَى ؟ قال : يا أبا ذَرٍّ ! اقرَأ : ? قَد أفلَحَ مَن تزَكَّى? إلى آخرِ السُّورَةِ]"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مطولاً أحمد (21415)، والبزار (3966) باختلاف يسير، وابن حبان (361) واللفظ له","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"wZID7EAR"},{"id":"س-02251","fp":"1edcf16e8549","stateId":488,"easy":"إذا جاهدت في سبيل الله ← فهو رهبانية هذه الأمة","cause":"الجهادُ في سبيلِ اللهِ","result":"ورهبانيةُ هذه الأمةِ","explicit":true,"repOf":"س-01693","ref":"مجمع الزوائد 5/281","text":["إنَّ لكلِّ أُمَّةٍ رهبانيةٌ ",["ورهبانيةُ هذه الأمةِ",2]," ",["الجهادُ في سبيلِ اللهِ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"فيه زيد العمي وبقية رجاله رجال الصحيح","takhrij":"أخرجه أبو يعلى (4204)، وابن المبارك في ((الجهاد)) (16)، وابن أبي عاصم في ((الجهاد)) (33) واللفظ لهم.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"cpTDLsOb"},{"id":"س-04362","fp":"f0ea89e275de","stateId":488,"easy":"إذا جاهدت في سبيل الله ← فهو سياحة الأمة","cause":"الجهادُ في سبيلِ اللهِ","result":"سياحةَ أُمَّتي","explicit":true,"ref":"تخريج سنن أبي داود 2486","srcLabel":"الحاكم","text":["أنَّ رجُلًا قال: يا رسولَ اللهِ، ائذَنْ لي بالسياحةِ، قال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: إنَّ ",["سياحةَ أُمَّتي",2]," ",["الجهادُ في سبيلِ اللهِ",1],"."],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني (8/215) (7760)، والحاكم (2398)، والبيهقي (18976) باختلاف يسير","bab":"جهاد › الترغيب في الجهاد","dorar":"6zQHjDPU"},{"id":"س-04401","fp":"ff99a8f13d9a","stateId":488,"easy":"إذا لقيت العدو وأنت جبان فقُتلت ← تكون في الدرجة الثانية","cause":"ورجلٌ مؤمنٌ جيِّدُ الإيمانِ لقي العدوَّ فكأنَّما ضُرِب جلدُه بشوْكِ طلحٍ من الجُبنِ أتاه سهمُ غرْبٍ","result":"فهو في الدَّرجةِ الثَّانيةِ","explicit":true,"ref":"الترغيب والترهيب 2/284","srcLabel":"الترمذي","text":["الشُّهداءُ أربعةٌ رجلٌ مؤمنٌ جيِّدُ الإيمانِ لقي العدوَّ حتَّى قتِل فذاك الَّذي يرفعُ النَّاسُ إليه أعينَهم يومَ القيامةِ هكذا ورفع رأسَه حتَّى وقعت قلنسوتَه فلا أدري قلنسوةَ عمرَ أراد أم قلنسوةَ النَّبيِّ صلَّى اللهُ عليه وسلَّم قال ",["ورجلٌ مؤمنٌ جيِّدُ الإيمانِ لقي العدوَّ فكأنَّما ضُرِب جلدُه بشوْكِ طلحٍ من الجُبنِ أتاه سهمُ غرْبٍ",1]," ",["فهو في الدَّرجةِ الثَّانيةِ",2]," ورجلٌ مؤمنٌ خلَط عملًا صالحًا وآخرَ سيِّئًا لقي العدوَّ فصدق اللهَ حتَّى قُتِل فذاك في الدَّرجةِ الثَّالثةِ ورجلٌ مؤمنٌ أسرف على نفسِه لقي العدوَّ فصدق اللهَ حتَّى قُتِل فذلك في الدَّرجةِ الأولَى"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (1644)، وأحمد (150)، وعبد بن حميد في ((المنتخب)) (27)، وابن أبي عاصم في الجهاد (187 ) باختلاف يسير","bab":"جهاد › الشجاعة في الحرب والجبن","dorar":"JjJ9jqmc"},{"id":"س-04402","fp":"d71e7d8a6c90","stateId":488,"easy":"إذا خلطت عملاً صالحاً وسيئاً ثم صدقت الله حتى قُتلت ← تكون في الدرجة الثالثة","cause":"ورجلٌ مؤمنٌ خلَط عملًا صالحًا وآخرَ سيِّئًا لقي العدوَّ فصدق اللهَ حتَّى قُتِل","result":"فذاك في الدَّرجةِ الثَّالثةِ","explicit":true,"repOf":"س-04403","otherNeedIds":[11],"ref":"الترغيب والترهيب 2/284","text":["الشُّهداءُ أربعةٌ رجلٌ مؤمنٌ جيِّدُ الإيمانِ لقي العدوَّ حتَّى قتِل فذاك الَّذي يرفعُ النَّاسُ إليه أعينَهم يومَ القيامةِ هكذا ورفع رأسَه حتَّى وقعت قلنسوتَه فلا أدري قلنسوةَ عمرَ أراد أم قلنسوةَ النَّبيِّ صلَّى اللهُ عليه وسلَّم قال ورجلٌ مؤمنٌ جيِّدُ الإيمانِ لقي العدوَّ فكأنَّما ضُرِب جلدُه بشوْكِ طلحٍ من الجُبنِ أتاه سهمُ غرْبٍ فهو في الدَّرجةِ الثَّانيةِ ",["ورجلٌ مؤمنٌ خلَط عملًا صالحًا وآخرَ سيِّئًا لقي العدوَّ فصدق اللهَ حتَّى قُتِل",1]," ",["فذاك في الدَّرجةِ الثَّالثةِ",2]," ورجلٌ مؤمنٌ أسرف على نفسِه لقي العدوَّ فصدق اللهَ حتَّى قُتِل فذلك في الدَّرجةِ الأولَى"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (1644)، وأحمد (150)، وعبد بن حميد في ((المنتخب)) (27)، وابن أبي عاصم في الجهاد (187 ) باختلاف يسير","bab":"جهاد › الشجاعة في الحرب والجبن","dorar":"JjJ9jqmc"},{"id":"س-04430","fp":"e6f4f25003c0","stateId":488,"easy":"إذا بلغت العدو بسهم ← يرفع الله لك درجة","cause":"مَنْ بَلَغَ العَدُوَّ بِسَهْمٍ","result":"رفعَ اللهُ لهُ درجةً","explicit":true,"repOf":"س-06799","ref":"صحيح الموارد 1369","text":[["مَنْ بَلَغَ العَدُوَّ بِسَهْمٍ ؛ ",1],["رفعَ اللهُ لهُ درجةً ",2],". فقال لهُ عَبْدُ الرحمنِ بْنُ النَّحَّامِ : يا رسولَ اللهِ ! وما الدَّرَجَةُ ؟ قال : أَما إِنَّها ليسَتْ بِعَتَبَةِ أُمِّكَ ! ما بين الدَّرَجَتَيْنِ مئةُ عامٍ"],"grade":"صحيح","narrator":"كعب بن مرة","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان كما في ((موارد الظمآن)) للهيثمي (1643) واللفظ له، وأخرجه النسائي (3144)، وأحمد (18063) باختلاف يسير","bab":"جهاد › فضل الجهاد","dorar":"FboUDpLn"},{"id":"س-04443","fp":"c6532247142a","stateId":488,"easy":"إذا جاهدت في سبيل الله ← فهو ذروة سنام الإسلام","cause":"الجهادُ في سبيلِ اللهِ","result":"ذِرْوَةُ سَنامِ الإسلامِ","explicit":true,"similar":["س-06735"],"ref":"الجامع الصغير 4305","srcLabel":"الطبراني","text":[["ذِرْوَةُ سَنامِ الإسلامِ",2]," : ",["الجهادُ في سبيلِ اللهِ",1]," ، لا ينالُه إلا أَفْضَلُهُم"],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (8/ 223) (7885) واللفظ له.","bab":"جهاد › فضل الجهاد","dorar":"fb9NtMeb"},{"id":"س-04728","fp":"b5f2c7334e94","stateId":488,"easy":"إذا قُتلت في سبيل الله ← فلا مثل لذلك","cause":"للقتلِ في سبيلِ اللهِ","result":"لا مِثلٌ","explicit":true,"ref":"الاستذكار 4/112","srcLabel":"مالك","text":["كان رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ جالسًا ، وقبرٌ يُحفرُ بالمدينةِ ، فاطَّلعَ رجلٌ في القبرِ ، فقال : بِئسَ مضجعُ المؤمنِ ، فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ : بِئسَ ما قلتَ ، فقال الرجلُ : إنِّي لم أُردَّ هذا يا رسولَ اللهِ ، إنَّما أردتُ القتلَ في سبيلِ اللهِ ، فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ : ",["لا مِثلٌ",2]," ",["للقتلِ في سبيلِ اللهِ",1]," ، ما على الأرضِ بقعةٌ هي أحبُّ إلَّي أنْ يكونَ قَبري بها منها ، ثلاثَ مراتٍ ، يعني : المدينةَ"],"grade":"صحيح","narrator":"يحيى بن سعيد","muhaddith":"لا أحفظ له سنداً ومعناه محفوظ في الأحاديث المرفوعة","takhrij":"أخرجه مالك (1678) واللفظ له.","bab":"رقائق وزهد › الإخلاص","dorar":"EI24KXZI"},{"id":"س-06395","fp":"7c9e29fdaa06","stateId":488,"easy":"إذا قدّمت ظل فسطاط أو خادماً أو فحلاً في سبيل الله ← فهي أفضل الصدقات","cause":"ظِلُّ فُسطاطٍ في سَبيلِ اللهِ عَزَّ وجَلَّ، أو مِنحةُ خادِمٍ في سَبيلِ اللهِ، أو طَروقةُ فحلٍ في سَبيلِ اللهِ","result":"أفضَلُ الصَّدَقاتِ","explicit":true,"ref":"فيض القدير 2/ 40","srcLabel":"فيض القدير","text":[["أفضَلُ الصَّدَقاتِ",2]," ",["ظِلُّ فُسطاطٍ في سَبيلِ اللهِ عَزَّ وجَلَّ، أو مِنحةُ خادِمٍ في سَبيلِ اللهِ، أو طَروقةُ فحلٍ في سَبيلِ اللهِ",1]],"grade":"صحيح","narrator":"أبو أمامة، وعدي بن حاتم","muhaddith":"[صحيح]","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"vGZNhotL"},{"id":"س-06813","fp":"8ccbdae6d6bf","stateId":488,"easy":"إذا بلغت العدو بسهم في سبيل الله ← فلك درجة في الجنة","cause":"مَن بَلَغَ بسَهمٍ في سَبيلِ اللهِ عَزَّ وجَلَّ","result":"فلَه دَرَجةٌ في الجَنَّةِ، فبَلَغتُ يَومَئِذٍ سِتَّةَ عَشَرَ سَهمًا","explicit":true,"repOf":"س-06799","otherNeedIds":[67],"ref":"تخريج المسند لشعيب 19428","text":["حاصَرنا مَعَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم حِصنَ الطَّائِفِ أو قَصرَ الطَّائِفِ، فقال: «",["مَن بَلَغَ بسَهمٍ في سَبيلِ اللهِ عَزَّ وجَلَّ، ",1],["فلَه دَرَجةٌ في الجَنَّةِ»، فبَلَغتُ يَومَئِذٍ سِتَّةَ عَشَرَ سَهمًا",2],". «ومَن رَمى بسَهمٍ في سَبيلِ اللهِ عَزَّ وجَلَّ، فهو له عَدلُ مُحَرَّرٍ، ومَن أصابَه شَيبٌ في سَبيلِ اللهِ عَزَّ وجَلَّ فهو له نورٌ يَومَ القيامةِ، وأيُّما رَجُلٍ أعتَقَ رَجُلًا مُسلِمًا، جَعَلَ اللهُ عَزَّ وجَلَّ وِقاءَ كُلِّ عَظمٍ مِن عِظامِه عَظمًا مِن عِظامِ مُحَرَّرِه مِنَ النَّارِ. وأيُّما امرَأةٍ مُسلِمةٍ أعتَقَتِ امرَأةً مُسلِمةً؛ فإنَّ اللهَ عَزَّ وجَلَّ جاعِلٌ وِقاءَ كُلِّ عَظمٍ مِن عِظامِها عَظمًا مِن عِظامِ مُحَرَّرِها مِنَ النَّارِ»"],"grade":"صحيح","narrator":"أبو نجيح السلمي","muhaddith":"إسناده صحيح","bab":"عتق وولاء › فضل العتق","dorar":"n9mz7kuy"},{"id":"س-00915","fp":"0ac57b62fc8e","stateId":488,"easy":"إذا جاهدت ← فالجهاد رهبانية الإسلام","cause":"علَيْكَ بِالجِهَادِ","result":"فَإِنَّها رَهْبَانِيَّةُ الإسلامِ","explicit":true,"repOf":"س-01693","ref":"مجمع الزوائد 4/218","text":["أنَّ رجلًا جاءَهُ فقال أَوْصِني فقال سألْتَنِي عمَّا سألْتُ عنه رسولَ اللهِ صلَّى اللهُ عليه وسلَّم مِنْ قبلِكَ أُوصيكَ بِتَقْوَى اللهِ فَإِنَّهُ رأْسُ كُلِّ شيءٍ و",["علَيْكَ بِالجِهَادِ",1]," ",["فَإِنَّها رَهْبَانِيَّةُ الإسلامِ",2]," وعَلَيْكَ بذِكرِ اللهِ وتلاوةِ القرآنِ فإنَّهُ رُوحُكَ في السماءِ وذكرُكَ في الأرضِ"],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"رجاله ثقات","takhrij":"أخرجه أحمد (11774) واللفظ له، والطبراني في ((الصغير)) (949)، والبيهقي في ((الآداب)) (835) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"PYQoHjdn","merged":2,"otherRefs":["صحيح الجامع 2543 (حسن)"]},{"id":"س-00535","fp":"cb741b0ef31c","stateId":488,"easy":"إذا غزوت في البحر ← ففضلك على غازي البر كفضله على القاعد","cause":"غازِي البحرِ","result":"كفَضْلِ غازِي البَرِّ على القاعِدِ في أهلِه ومالِه","explicit":true,"ref":"الجامع الصغير 5855","srcLabel":"ابن ماجة","text":["فَضْلُ ",["غازِي البحرِ",1]," على غازِي البَرِّ ",["كفَضْلِ غازِي البَرِّ على القاعِدِ في أهلِه ومالِه",2]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"حسن","takhrij":"أخرجه ابن ماجة (2777)، وابن عدي في ((الكامل)) (6/ 401) بنحوه مطولًا.","bab":"آداب عامة › ضرب الأمثال","dorar":"7RYZ2jat"},{"id":"س-01793","fp":"43af1f27a94c","stateId":488,"easy":"إذا غزا زوجك ← فلن تبلغي بعبادتك عُشر عمله","cause":"انطلق زوجي غازيًا","result":"لو طُوِّقتِيه ؛ ما بلغتِ العُشرَ من عملِه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح الترغيب 1321","srcLabel":"أحمد","text":["إنَّ امرأةً أتته فقالت : يا رسولَ اللهِ ! ",["انطلق زوجي غازيًا",1]," ، وكنتُ أقتدي بصلاتِه إذا صلى ، وبفعلِه كلِّه ، فأَخبِرْني بعملٍ يبلِّغُني عملَه حتى يرجعَ . قال لها : أتستطيعينَ أن تقومي ولا تقعدي ، وتصومي ولا تُفطِري ، وتذكَّري اللهَ تعالى ولا تَفتُري حتى يرجعَ ؟ . قالت : ما أُطيقُ هذا يا رسولَ اللهِ ! فقال : والذي نفسي بيده ",["لو طُوِّقتِيه ؛ ما بلغتِ العُشرَ من عملِه",2]," ."],"grade":"صحيح","narrator":"معاذ بن أنس","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (15633)، والطبراني في ((المعجم الكبير)) (20/ 196) (441)، وابن أبي العز السفار في ((الأربعين في الجهاد)) (12) باختلاف يسير.","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"sigEhYcc"},{"id":"س-02334","fp":"9ead67696790","stateId":488,"easy":"إذا غزوت غزوة في سبيل الله ← فقد أديت إلى الله جميع طاعته","cause":"مَن غَزا غَزوةً في سَبيلِ اللهِ","result":"فقد أدَّى إلى اللهِ عَزَّ وجَلَّ جَميعَ طاعَتِه","explicit":true,"ref":"مشارع الأشواق 166","srcLabel":"مشارع الأشواق","text":[["مَن غَزا غَزوةً في سَبيلِ اللهِ",1]," ",["فقد أدَّى إلى اللهِ عَزَّ وجَلَّ جَميعَ طاعَتِه",2]," {فمَن شاءَ فليُؤمِنْ ومَن شاءَ فليَكفُرْ}"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"JPgJtUsf"},{"id":"س-06242","fp":"7b397817e0ee","stateId":488,"easy":"إذا نصرت الحق بشعرك ← فهو أسرع في أعدائه من النبل","cause":"خلُّوا بَني الكفَّارِ عن سبيلِهْ","result":"فلَهوَ أسرَعُ فيهم من نَضحِ النَّبلِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح النسائي 2873","srcLabel":"الترمذي","text":["أنَّ النَّبيَّ صلَّى اللَّهُ علَيهِ وسلَّمَ دخلَ مَكَّةَ في عُمرةِ القضاءِ ، وعبدُ اللَّهِ بنُ رواحةَ يَمشي بينَ يديهِ وَهوَ يقولُ : \n",["خلُّوا بَني الكفَّارِ عن سبيلِهْ",1]," . . . اليومَ نضربُكُم على تنزيلِهْ \nضربًا يزيلُ الهامَ عن مقيلِهْ . . . ويُذهلُ الخليلَ عن خليلِهْ \n . فقالَ لَهُ عمرُ : يا ابنَ رواحةَ ، بينَ يدَي رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ ، وفي حرَمِ اللَّهِ عزَّ وجلَّ تقولُ الشِّعرَ ؟ فقالَ النَّبيُّ صلَّى اللَّهُ علَيهِ وسلَّمَ : خلِّ عنهُ ، ",["فلَهوَ أسرَعُ فيهم من نَضحِ النَّبلِ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه النسائي (2873) واللفظ له، وأخرجه الترمذي (2847) باختلاف يسير","bab":"شعر › هجاء المشركين والأمر به","dorar":"hfPH8JJX"},{"id":"س-06312","fp":"ec349628ef54","stateId":488,"easy":"إذا تركت الحيوان حتى يكبر فحملت عليه في سبيل الله ← فهو خير من ذبحه صغيراً","cause":"وأن تَترُكَه حتَّى يكونَ بَكْرًا، فتَحمِلَ عليه في سَبيلِ الله، أو تُعطيَه أَرْملةً","result":"خَيْرٌ مِن أن تَذبَحَه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأحكام الوسطى 4/ 138","srcLabel":"النسائي","text":["قالوا: يا رَسولَ اللهِ، الفَرَعُ؟ قالَ: \"الفَرَعُ حَقٌّ، ",["وأن تَترُكَه حتَّى يكونَ بَكْرًا، فتَحمِلَ عليه في سَبيلِ الله، أو تُعطيَه أَرْملةً",1],"- ",["خَيْرٌ مِن أن تَذبَحَه",2]," فتُلصِقَ لَحْمَه بوَبَرِه فتُكفِئَ إناءَك وتُوَلِّهَ ناقتَك\"، قالوا: يا رسولَ اللهِ، العَتيرةُ؟ قالَ: \"والعَتيرةُ حَقٌّ\"."],"grade":"صحيح","narrator":"جد عمرو بن شعيب وزيد بن أسلم","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (4537) واللفظ له، وعبد الرزاق (7995)، والبيهقي في ((السنن الصغير)) (1848) بنحوه من طريق جد عمرو بن شعيب","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"VSsSqvNy"},{"id":"س-02219","fp":"155b71a84cc9","stateId":488,"easy":"إذا استُشهدت ← تتمنى أن ترجع فتقتل عشر مرات لما ترى من الكرامة","cause":"الشَّهيدِ","result":"فإنَّهُ يحبُّ أن يَرجِعَ إلى الدُّنيا يقولُ حتَّى أُقتَلَ عشرَ مرَّاتٍ في سَبيلِ اللَّهِ مِمَّا يَرى مِمَّا أعطاهُ اللَّهُ منَ الكَرامةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-04523","ref":"صحيح الترمذي 1661","text":["ما مِن أحَدٍ من أهلِ الجنَّةِ يَسرُّهُ أن يرجِعَ إلى الدُّنيا غيرُ ",["الشَّهيدِ",1]," ",["فإنَّهُ يحبُّ أن يَرجِعَ إلى الدُّنيا يقولُ حتَّى أُقتَلَ عشرَ مرَّاتٍ في سَبيلِ اللَّهِ مِمَّا يَرى مِمَّا أعطاهُ اللَّهُ منَ الكَرامةِ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه البخاري (2817)، ومسلم (1877)، والترمذي (1661) واللفظ له، وأحمد (12003)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"1xvqbOUP","merged":2,"otherRefs":["تخريج المسند لشعيب 13926 (صحيح)"]},{"id":"س-00580","fp":"b330c8d3987d","stateId":488,"easy":"إذا غزوت في البحر ← تكون كالملوك على الأسرّة","cause":"يرَكَبُ قَومٌ مِن أُمَّتي ثَبَجَ البحرِ","result":"هُمُ المُلوكُ على الأَسِرَّةِ، أو: كالمُلوكِ على الأَسِرَّةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"similar":["س-07372"],"ref":"تخريج المسند لشعيب 13520","srcLabel":"متفق عليه","text":[["يرَكَبُ قَومٌ مِن أُمَّتي ثَبَجَ البحرِ",1]," -أو: ثَبَجَ هذا البحرِ- ",["هُمُ المُلوكُ على الأَسِرَّةِ، أو: كالمُلوكِ على الأَسِرَّةِ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (2788، 2789)، ومسلم (1912)، والترمذي (1645)، والنسائي (3171) مطولاً، وأحمد (13520) واللفظ له","bab":"آداب عامة › ضرب الأمثال","dorar":"FiFN8N4C"},{"id":"س-04448","fp":"7da07b38e827","stateId":488,"easy":"إذا حرست في أرض خوف ← فهي أفضل من ليلة القدر","cause":"حارِسٌ حَرَسَ في أرضِ خوفٍ، لعلَّه أنْ لا يَرجِعَ إلى أَهلِهِ","result":"بليلةٍ أَفضلَ مِن ليلةِ القَدْرِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[49],"ref":"المستدرك على الصحيحين 2459","srcLabel":"البخاري","text":["ألا أُنبِّئُكُم ",["بليلةٍ أَفضلَ مِن ليلةِ القَدْرِ",2],"؟ ",["حارِسٌ حَرَسَ في أرضِ خوفٍ، لعلَّه أنْ لا يَرجِعَ إلى أَهلِهِ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح على شرط البخاري","takhrij":"أخرجه النسائي في ((الكبرى)) (8817)، والروياني (1420)، والبيهقي (18488) جميعهم بلفظه.","bab":"جهاد › فضل الجهاد","dorar":"OpHWRUsy"},{"id":"س-07372","fp":"9750053c488c","stateId":488,"easy":"إذا غزوت في البحر ← فمثلك كالملوك على الأسرّة","cause":"يركبونَ هذا البَحرَ الأخضَرَ غزاةً في سَبيلِ اللهِ","result":"مَثَلُهم كمَثَلِ الملوكِ على الأَسِرَّةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-00580","ref":"تخريج المسند لشعيب 13791","text":["دخل رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم على ابنةِ مِلْحانَ، فاتَّكأَ عندها... فذكَرَ معناه [أي ذكَرَ معنى حديثِ: اتَّكأَ رَسولُ الله صلَّى اللهُ عليه وسلَّم عندَ ابنةِ مِلْحانَ، قال: فرفَعَ رأسَه فضَحِكَ، فقالت: مِمَّ ضَحِكْتَ يا رسولَ اللهِ؟! فقال: مِن أُناسٍ من أمَّتي ",["يركبونَ هذا البَحرَ الأخضَرَ غزاةً في سَبيلِ اللهِ",1],"، ",["مَثَلُهم كمَثَلِ الملوكِ على الأَسِرَّةِ",2],"، قالت: ادْعُ اللهَ يا رَسولَ اللهِ أن يجعَلَني منهم، فقال: اللَّهمَّ اجعَلْها منهم. فنَكَحَت عُبادةَ بنَ الصَّامِتِ، قال: فرَكِبَت في البَحرِ مع ابنةِ قَرَظةَ، حتى إذا هي قَفَلَت رَكِبَت دابَّةً لها بالسَّاحِلِ، فوقَصَت بها فسَقَطَت فماتَت]."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (1912)، وأحمد (13791) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › أحوال النبي","dorar":"aTrB1EQ5"},{"id":"س-06735","fp":"10940e582909","stateId":488,"easy":"إذا جاهدت ← فهو ذروة سنام الإسلام","cause":"الجِهادُ","result":"وذِروةِ سَنامِهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-04443","ref":"صحيح الترمذي 2616","text":["كنتُ معَ النَّبيِّ صلَّى اللَّهُ علَيهِ وسلَّمَ في سفَرٍ ، فأصبَحتُ يومًا قريبًا منهُ ونحنُ نَسيرُ ، فقلتُ : يا رسولَ اللَّهِ أخبرني بعمَلٍ يُدخِلُني الجنَّةَ ويباعِدُني من النَّارِ ، قالَ : لقد سألتَني عَن عظيمٍ ، وإنَّهُ ليسيرٌ على من يسَّرَهُ اللَّهُ علَيهِ ، تعبدُ اللَّهَ ولا تشرِكْ بِهِ شيئًا ، وتُقيمُ الصَّلاةَ ، وتُؤتي الزَّكاةَ ، وتصومُ رمضانَ ، وتحجُّ البيتَ ، ثمَّ قالَ : ألا أدلُّكَ على أبوابِ الخيرِ : الصَّومُ جُنَّةٌ ، والصَّدَقةُ تُطفي الخطيئةَ كما يُطفئُ الماءُ النَّارَ ، وصلاةُ الرَّجلِ من جوفِ اللَّيلِ قالَ : ثمَّ تلا  تَتَجَافَى جُنُوبُهُمْ عَنِ الْمَضَاجِعِ يَدْعُونَ رَبَّهُمْ  ، حتَّى بلغَ يَعْمَلُونَ ، ثمَّ قالَ : ألا أخبرُكَ بِرَأسِ الأَمرِ كلِّهِ وعمودِهِ ، ",["وذِروةِ سَنامِهِ",2]," ؟ قلتُ : بلى يا رسولَ اللَّهِ ، قالَ : رأسُ الأمرِ الإسلامُ ، وعمودُهُ الصَّلاةُ ، وذروةُ سَنامِهِ ",["الجِهادُ",1]," ، ثمَّ قالَ : ألا أخبرُكَ بملاكِ ذلِكَ كلِّهِ ؟ قُلتُ : بلَى يا رسولَ اللَّهِ ، قال : فأخذَ بلِسانِهِ قالَ : كُفَّ عليكَ هذا ، فقُلتُ : يا نبيَّ اللَّهِ ، وإنَّا لمؤاخَذونَ بما نتَكَلَّمُ بِهِ ؟ فقالَ : ثَكِلَتكَ أمُّكَ يا معاذُ ، وَهَل يَكُبُّ النَّاسَ في النَّارِ على وجوهِهِم أو على مَناخرِهِم إلَّا حَصائدُ ألسنتِهِم ."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2616) بلفظه، وابن ماجه (3973)، وأحمد (22068) كلاهما باختلاف يسير.","bab":"صيام › فضل الصيام","dorar":"dad0NMIP","merged":4,"otherRefs":["تسديد القوس 2/200 (صحيح)","مجموع فتاوى ابن باز 235/10 (صحيح)","الجامع الصغير 4357 (صحيح)"]},{"id":"س-07902","fp":"7797a1b0dc96","stateId":489,"easy":"إذا كتمت مصائبك ← فهو تمام البر","cause":"كِتمانُ المصائبِ","result":"تمامُ البرِّ","explicit":true,"star":true,"otherNeedIds":[9],"ref":"إتحاف الخيرة المهرة 2/429","srcLabel":"ابن حبان","text":[["تمامُ البرِّ",2]," ",["كِتمانُ المصائبِ",1]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"سنده صحيح","takhrij":"أخرجه أبو يعلى في ((المعجم)) (104)، وابن حبان في ((المجروحين)) (2/ 120)، وابن عدي في ((الكامل في الضعفاء)) (3/ 233) بلفظه.","bab":"مريض › فضل المرض والنوائب","dorar":"0eSzRSva"},{"id":"س-03294","fp":"cdb2aaef54d5","stateId":489,"easy":"إذا أصابك صداع أو شوكة أو أذى ← يرفعك الله بها يوم القيامة درجة ويكفّر ذنوبك","cause":"صُداعُ المؤمنِ ، أو شوكةٌ يُشاكُها ، أو شيءٌ يُؤذيه","result":"يرفعُه اللهُ بها يومً القيامةٍ درجةً ، ويُكفِّرُ عنه بها ذنوبَه","explicit":true,"otherNeedIds":[11,9],"ref":"صحيح الترغيب 3434","srcLabel":"البيهقي","text":[["صُداعُ المؤمنِ ، أو شوكةٌ يُشاكُها ، أو شيءٌ يُؤذيه",1]," ؛ ",["يرفعُه اللهُ بها يومً القيامةٍ درجةً ، ويُكفِّرُ عنه بها ذنوبَه",2]," ."],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"حسن","takhrij":"أخرجه ابن أبي الدنيا في ((المرض والكفارات)) (180)، والبيهقي في ((شعب الإيمان)) (9409)، والديلمي في ((الفردوس)) (3773) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"XeiKxIbE","merged":2,"otherRefs":["المتجر الرابح 302 (حسن)"]},{"id":"س-01870","fp":"d71aa36d3055","stateId":490,"easy":"إذا أعطيت عطيتك لأقاربك (أخوالك) ← فهو أعظم لأجرك","cause":"لو أعطَيتِها أخوالَكِ","result":"كان أعظَمَ لأجرِكِ","explicit":true,"star":true,"otherNeedIds":[39],"ref":"صحيح البخاري 2592","srcLabel":"مسلم","text":["أنَّها أعتَقَت وليدةً ولَم تَستَأذِنِ النَّبيَّ صلَّى اللهُ عليه وسلَّم، فلَمَّا كان يَومُها الذي يَدورُ عليها فيه، قالت: أشَعَرتَ يا رَسولَ اللهِ أنِّي أعتَقتُ وليدَتي؟ قال: أوفَعَلتِ؟ قالت: نَعَم، قال: أما إنَّكِ ",["لو أعطَيتِها أخوالَكِ",1]," ",["كان أعظَمَ لأجرِكِ",2],"."],"grade":"صحيح","narrator":"ميمونة بنت الحارث أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (999)، والنسائي في ((السنن الكبرى)) (4910)، وأبو يعلى (7109)، وابن حبان (236) واللفظ لهم.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"tCTkrgUS"},{"id":"س-03784","fp":"23bfc2d75ee2","stateId":490,"easy":"إذا أكرمت يتيماً في بيتك ← فهو خير البيوت","cause":"بيتٌ فيه يتيمٌ مكرمٌ","result":"خيرُ بُيوتِكم","explicit":true,"star":true,"otherNeedIds":[37],"ref":"الإرشاد 1/435","srcLabel":"الخرائطي","text":[["خيرُ بُيوتِكم",2]," ",["بيتٌ فيه يتيمٌ مكرمٌ",1]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"صحيح","takhrij":"أخرجه الخرائطي في ((مكارم الأخلاق)) (660)، والقضاعي في ((مسند الشهاب)) (1249) واللفظ لهما، وابن عدي في ((الكامل في الضعفاء)) (1/341)","bab":"بر وصلة › إعالة اليتيم والضعيف وفضلها","dorar":"fpCWLivr"},{"id":"س-07959","fp":"fc640cbae0fc","stateId":490,"easy":"إذا أمطت الأذى عن الطريق ← فهو من محاسن الأعمال","cause":"إماطَةُ الأذَى عنِ الطريقِ","result":"في مَحاسِنِ أعمالِها","explicit":true,"star":true,"otherNeedIds":[45],"ref":"صحيح الجامع 4003","srcLabel":"مسلم","text":["عُرِضَتْ عليَّ أُمَّتِي بأعمالِها ، حَسَنِها وسيِّئِها ، فرأيتُ ",["في مَحاسِنِ أعمالِها",2]," ",["إماطَةُ الأذَى عنِ الطريقِ",1]," ، ورأيتُ في سيِّئِ أعمالِها النُّخاعةَ في المسجدِ لمْ تُدفَنْ"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مسلم (553) باختلاف يسير","bab":"مساجد ومواضع الصلاة › البزاق في المسجد","dorar":"rYrwp2Yh","merged":2,"otherRefs":["تخريج صحيح ابن حبان 1640 (صحيح)"]},{"id":"س-03798","fp":"702f7a8d4a54","stateId":490,"easy":"إذا أكرمت ذا الشيبة المسلم وحامل القرآن والسلطان العادل ← فهو من إجلال الله","cause":"إكْرامَ ذي الشَّيْبةِ المُسلِمِ، وحامِلِ القُرْآنِ غَيْرِ الغالي فيه والجافي عنه، وإكرامَ ذي السُّلْطانِ المُقسِطِ","result":"إنَّ مِن إجْلالِ اللهِ","explicit":true,"star":true,"otherNeedIds":[23],"ref":"الأحكام الوسطى 2/378","srcLabel":"أبو داود","text":[["إنَّ مِن إجْلالِ اللهِ",2]," ",["إكْرامَ ذي الشَّيْبةِ المُسلِمِ، وحامِلِ القُرْآنِ غَيْرِ الغالي فيه والجافي عنه، وإكرامَ ذي السُّلْطانِ المُقسِطِ",1],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (4843)، وابن خزيمة (3316)، والبيهقي (16736) جميعهم بلفظه.","bab":"بر وصلة › توقير الكبير ورحمة الصغير","dorar":"1NZmammC","merged":2,"otherRefs":["صحيح الأدب المفرد 274 (حسن)"]},{"id":"س-07063","fp":"d8baefc2193c","stateId":490,"easy":"إذا قال جيرانك إنك محسن ← فأنت محسن","cause":"سَلْ جيرانَكَ، فإنْ قالوا: إنَّكَ مُحسِنٌ","result":"فأنت مُحسِنٌ","explicit":true,"otherNeedIds":[41],"ref":"المستدرك على الصحيحين 1417","srcLabel":"البيهقي","text":["جاء رَجُلٌ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: يا رَسولَ اللهِ، دُلَّني على عَمَلٍ إذا أنا عَمِلتُ به دَخَلتُ الجَنَّةَ. قالَ: كُنْ مُحسِنًا قالَ: كيف أعلَمُ أنِّي مُحسِنٌ؟ قالَ: ",["سَلْ جيرانَكَ، فإنْ قالوا: إنَّكَ مُحسِنٌ",1],"؛ ",["فأنت مُحسِنٌ",2],"، وإنْ قالوا: إنَّكَ مُسيءٌ؛ فأنت مُسيءٌ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه البيهقي في ((الشعب)) (9120)، وقوام السنة في ((الترغيب والترهيب)) (871)، والويزر ابن الجراح في ((حديثه)) (121) واللفظ لهم.","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"MlJdVu4G"},{"id":"س-07159","fp":"cd7554a7e329","stateId":490,"easy":"إذا تكلمت بمعروف أو نهيت عن منكر ← فهو خير من السكوت","cause":"تَكلَّمَ بمَعْروفٍ وتَنْهى عن مُنكَرٍ","result":"خَيْرٌ مِن أن تَسكُتَ","explicit":true,"ref":"الصحيح المسند 1641","srcLabel":"أحمد","text":["إنَّ بَشيرًا سألَ النَّبيَّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ: أَصومُ يَوْمَ الجُمُعةِ، ولا أُكلِّمُ ذلك اليَوْمَ أحَدًا؟ فقالَ النَّبيُّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ: «لا تَصُمْ يَوْمَ الجُمُعةِ إلَّا في أيَّامٍ هو أحَدُها، أو في شَهْرٍ، وأمَّا أنْ لا تُكَلِّمَ أحَدًا فلَعَمْري لَأنْ ",["تَكلَّمَ بمَعْروفٍ وتَنْهى عن مُنكَرٍ",1]," ",["خَيْرٌ مِن أن تَسكُتَ",2],"»."],"grade":"صحيح","narrator":"ليلى امرأة بشير بن الخصاصية","muhaddith":"صحيح","takhrij":"أخرجه أحمد (21954)، وعبد بن حميد (427)، وابن أبي عاصم في ((الآحاد والمثاني)) (3426) واللفظ لهم.","bab":"علم › حسن السؤال ونصح العالم","dorar":"cCQFLaCU"},{"id":"س-08314","fp":"59150ef0c649","stateId":490,"easy":"إذا مشيت خلف الجنازة ← ففضلك على من يمشي أمامها كفضل الجماعة على الفرد","cause":"فَضلَ الرَّجلِ يَمشي خلفَ الجنازةِ ، على الَّذي يمشي أمامَها","result":"كفَضلِ صلاةِ الجماعةِ على صلاةِ الفذِّ","explicit":true,"ref":"نخب الافكار 7/256","srcLabel":"محمد","text":["كُنتُ أمشي في جِنازةٍ فيها أبو بَكْرٍ وعمرُ وعليٌّ فَكانَ أبو بَكْرٍ وعمرَ رضيَ اللَّهُ عنهما يمشيانِ أمامَها ، وعليٌّ يمشي خَلفَها يدي في يدِهِ . فقالَ عليٌّ رضيَ اللَّهُ عنهُ أمَّا إنَّ ",["فَضلَ الرَّجلِ يَمشي خلفَ الجنازةِ ، على الَّذي يمشي أمامَها",1]," ، ",["كفَضلِ صلاةِ الجماعةِ على صلاةِ الفذِّ",2]," ، وإنَّهما ليَعلمانِ من ذلِكَ مثلَ الَّذي أعلمُ ، ولَكِنَّهما سَهْلانِ يُسَهِّلانِ على النَّاسِ"],"grade":"صحيح","narrator":"عبدالرحمن بن أبزى","muhaddith":"طريقه صحيح","takhrij":"أخرجه محمد بن الحسن في ((الحجة على أهل المدينة)) (1/ 370)، وعبد الرزاق (6263)، وابن أبي شيبة (11239)، والبزار (497) واللفظ لهم جميعا.","bab":"مناقب وفضائل › علي بن أبي طالب","dorar":"QDFxaqCt"},{"id":"س-02288","fp":"2b2c2d30c5b7","stateId":490,"easy":"إذا أتممت المعروف ← فهو خير من ابتدائه","cause":"استِتمامُ المعروفِ","result":"خَيرٌ مِن ابتِدائِه","explicit":true,"ref":"أطراف الغرائب 1/330","srcLabel":"أطراف الغرائب","text":["حديث: ",["استِتمامُ المعروفِ",1]," ",["خَيرٌ مِن ابتِدائِه",2],"."],"grade":"حسن","narrator":"جابر بن عبد الله","muhaddith":"[غريب من حديث أبي الزبير عنه، تفرد به عبد الرحمن بن قيس أبو معاوية الأنصاري عن صالح عنه]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"x7oTN92U"},{"id":"س-01863","fp":"98c953bcb48b","stateId":490,"easy":"إذا أنكرت المنكر في آخر الزمان ← تُعطى مثل أجور أول الأمة","cause":"يُنكرون المنكرَ","result":"يُعطوْنَ مثلَ أجورِ أوَّلِهم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"السلسلة الصحيحة 1700","srcLabel":"السلسلة الصحيحة","text":["إنَّ من أُمَّتِي قومًا ",["يُعطوْنَ مثلَ أجورِ أوَّلِهم",2]," ، ",["يُنكرون المنكرَ",1]],"grade":"صحيح","narrator":"من سمع النبي صلى الله عليه وسلم","muhaddith":"إسناده صحيح أو جيد رجاله كلهم رجال الصحيح","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"fVITz6Fy"},{"id":"س-00338","fp":"6f8a178082e0","stateId":491,"easy":"إذا حسن خلقك ← تبلغ درجة الصوم والصلاة","cause":"وإنَّ حُسْنَ الخُلُقِ","result":"لَيَبلُغُ دَرَجةَ الصَّومِ والصَّلاةِ","explicit":true,"star":true,"similar":["س-02293"],"ref":"الأحاديث المختارة 2210","srcLabel":"البخاري","text":["«أكمَلُ النَّاسِ إيمانًا أحسَنُهم خُلُقًا، ",["وإنَّ حُسْنَ الخُلُقِ",1]," ",["لَيَبلُغُ دَرَجةَ الصَّومِ والصَّلاةِ",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"VFpXZT5b","merged":2,"otherRefs":["البحر الزخار 10/36 (حسن)"]},{"id":"س-02300","fp":"283f06ff88c2","stateId":491,"easy":"إذا حسن خلقك ← تبلغ عظيم درجات الآخرة وشرف المنازل","cause":"إنَّ العَبْدَ لَيَبْلُغُ بحُسْنِ خُلُقِه","result":"عَظيمَ دَرَجاتِ الآخِرةِ وشَرَفَ المنازِلِ","explicit":true,"star":true,"otherNeedIds":[43],"ref":"الأحاديث المختارة 1812","srcLabel":"البخاري","text":["«",["إنَّ العَبْدَ لَيَبْلُغُ بحُسْنِ خُلُقِه",1]," ",["عَظيمَ دَرَجاتِ الآخِرةِ وشَرَفَ المنازِلِ",2],"، وإنَّه لضَعيفُ العبادةِ، وإنَّه لَيَبلُغُ بسُوءِ خُلُقِه أسفَلَ جَهَنَّمَ وهو عابِدٌ»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Kwct6BL4","merged":2,"otherRefs":["إتقان ما يحسن 2/517 (حسن)"]},{"id":"س-07234","fp":"857db7fe6408","stateId":491,"easy":"إذا حسن خلقك ← فهو البر","cause":"حُسنُ الخُلُقِ","result":"البِرِّ","explicit":true,"ref":"تخريج مشكل الآثار 2138","srcLabel":"مسلم","text":["أَقَمتُ مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ بالمَدينةِ سَنَةً ما يَمنَعُني منَ الهِجرَةِ إلَّا المسأَلةَ، فإنَّ أحدَنا كان إذا هاجَرَ لم يَسأَلْ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ عن شَيءٍ، قال: فسأَلتُه عنِ ",["البِرِّ",2]," والإثمِ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: البِرُّ ",["حُسنُ الخُلُقِ",1],"، والإثمُ ما حاكَ في نَفسِكَ، وكَرِهتَ أنْ يَطَّلِعَ الناسُ عليه."],"grade":"صحيح","narrator":"النواس بن سمعان الأنصاري","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2553) باختلاف يسير","bab":"علم › سؤال العالم عما لا يعلم","dorar":"4gX9Q14H","merged":2,"otherRefs":["صحيح الأدب المفرد 226 (صحيح)"]},{"id":"س-02293","fp":"7e7b11718243","stateId":491,"easy":"إذا حسن خلقك ← يبلغك الله درجة الصوم والصلاة","cause":"إنَّ اللهَ لَيُبَلِّغُ العَبْدَ بِحُسْنِ خُلُقِهِ","result":"دَرَجةَ الصَّوْمِ والصَّلاةِ","explicit":true,"repOf":"س-00338","ref":"المستدرك على الصحيحين 201","text":["«",["إنَّ اللهَ لَيُبَلِّغُ العَبْدَ بِحُسْنِ خُلُقِهِ ",1],["دَرَجةَ الصَّوْمِ والصَّلاةِ»",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح على شرط مسلم]","takhrij":"أخرجه ابن عدي في ((الكامل)) (4/ 11)، والطبراني في ((الأوسط)) (6283)، والخرائطي في ((مكارم الأخلاق)) (52) بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Ptrbr77T"},{"id":"س-00312","fp":"a11b706bb9f9","stateId":491,"easy":"إذا حسن خلقك ← تدرك درجات الصائم القائم الظمآن في الهواجر","cause":"إنَّ الرجلَ لَيُدركُ بحسنِ الخُلُقِ","result":"درجاتِ الصائمِ القائمِ الظمآنِ في الهواجرِ","explicit":true,"similar":["س-00311","س-00273","س-02291","س-02329"],"ref":"السلسلة الصحيحة 2/421","srcLabel":"البخاري","text":[["إنَّ الرجلَ لَيُدركُ بحسنِ الخُلُقِ ",1],["درجاتِ الصائمِ القائمِ الظمآنِ في الهواجرِ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه الخرائطي في ((مكارم الأخلاق)) (52) واللفظ له،، وابن عدي في ((الكامل)) (5/ 16)  والبخاري في ((الأدب المفرد)) (284) بلفظ قريب.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"qWCU5v4Q"},{"id":"س-00311","fp":"58dd4f62bf9c","stateId":491,"easy":"إذا حسن خلقك ← تدرك درجة الصائم القائم","cause":"إِنَّ المؤمِنَ ليُدْرِكُ بِحُسْنِ الخلُقِ","result":"درجَةَ القائِمِ الصائِمِ","explicit":true,"repOf":"س-00312","ref":"صحيح الجامع 1932","text":[["إِنَّ المؤمِنَ ليُدْرِكُ بِحُسْنِ الخلُقِ ",1],["درجَةَ القائِمِ الصائِمِ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4798)، وأحمد (24355) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"kLiAcqg9","merged":3,"otherRefs":["تخريج صحيح ابن حبان 480 (صحيح)","تخريج المسند لشعيب 25013 (صحيح)"]},{"id":"س-00273","fp":"29a073fc1908","stateId":491,"easy":"إذا حسن خلقك ← تدرك درجات قائم الليل","cause":"إنَّ المُؤمِنَ يُدرِكُ بحُسنِ خُلُقِه","result":"دَرَجاتِ قائِمِ اللَّيلِ","explicit":true,"repOf":"س-00312","ref":"تخريج المسند لشعيب 24355","text":[["إنَّ المُؤمِنَ يُدرِكُ بحُسنِ خُلُقِه ",1],["دَرَجاتِ قائِمِ اللَّيلِ",2],"، صائِمِ النَّهارِ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (4798)، وأحمد (24355) واللفظ له","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"dY0JD5zn"},{"id":"س-00330","fp":"e537c5fcf4d2","stateId":491,"easy":"إذا حسن خلقك وكرمت طبيعتك ← تدرك درجة الصوّام القوّام","cause":"بحُسنِ خُلقِه، وكَرَمِ ضَريبتِه","result":"لَيدرِكُ درجةَ الصَّوَّامِ القوَّامِ بآياتِ اللهِ","explicit":true,"ref":"تخريج المسند لشعيب 6648","srcLabel":"أحمد","text":["يقولُ: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: إنَّ المسلمَ المُسدَّدَ ",["لَيدرِكُ درجةَ الصَّوَّامِ القوَّامِ بآياتِ اللهِ",2],"، ",["بحُسنِ خُلقِه، وكَرَمِ ضَريبتِه",1],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (6648)، والخرائطي في ((مكارم الأخلاق)) (53)، والطبراني (14/108) (14726)","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"md42RCik"},{"id":"س-02291","fp":"c12fa37eaa43","stateId":491,"easy":"إذا حسن خلقك ← تدرك درجات قائم الليل صائم النهار","cause":"إنَّ الرَّجُلَ لَيُدْرِكُ بِحُسْنِ خُلُقِهِ","result":"دَرجاتِ قائمِ اللَّيْلِ صائمِ النَّهارِ","explicit":true,"repOf":"س-00312","ref":"المستدرك على الصحيحين 200","text":["«",["إنَّ الرَّجُلَ لَيُدْرِكُ بِحُسْنِ خُلُقِهِ ",1],["دَرجاتِ قائمِ اللَّيْلِ صائمِ النَّهارِ»",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (10/ 365) بلفظه، وأبو داود (4798) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Sh4KCzjm"},{"id":"س-02329","fp":"c1d0804c624d","stateId":491,"easy":"إذا حسن خلقك ← تدرك درجة القائم بالليل الظامئ في الهواجر","cause":"إنَّ الرَّجُلَ ليُدرِكُ بحُسنِ خُلُقِه","result":"درجةَ القائمِ باللَّيلِ الظَّامِئِ بالهَواجِرِ","explicit":true,"repOf":"س-00312","ref":"فيض القدير 2/ 238","text":[["إنَّ الرَّجُلَ ليُدرِكُ بحُسنِ خُلُقِه ",1],["درجةَ القائمِ باللَّيلِ الظَّامِئِ بالهَواجِرِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه الطبراني في ((الأوسط)) (6283)، والخرائطي في ((مكارم الأخلاق)) (52) باختلاف يسير، والحاكم (200) بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"IY48YpJE"},{"id":"س-00282","fp":"11a8431dc7c3","stateId":492,"easy":"إذا عفوت عمن ظلمك وأعطيت من حرمك ووصلت من قطعك ← فهي خير أخلاق أهل الدنيا والآخرة","cause":"تعفو عمَّن ظلَمك، وتُعطي مَن حرَمك، وتَصِلُ مَن قطَعك","result":"ألا أدُلُّكم على خيرِ أخلاقِ أهلِ الدُّنيا والآخرةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"المصابيح في الأحاديث المتواترة 603","srcLabel":"المصابيح في الأحاديث المتواترة","text":[["ألا أدُلُّكم على خيرِ أخلاقِ أهلِ الدُّنيا والآخرةِ",2],"؟",[" تعفو عمَّن ظلَمك، وتُعطي مَن حرَمك، وتَصِلُ مَن قطَعك",1]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"8JYhLVYF"},{"id":"س-04679","fp":"11f66b23ea5a","stateId":492,"easy":"إذا أُصبت في جسدك فعفوت ← يرفعك الله درجة ويحط عنك خطيئة","cause":"ما من مُسلِمٍ يُصابُ بشَيءٍ في جسَدِهِ، فيَتصَدَّقُ بهِ","result":"إلَّا رفَعَهُ اللهُ به درجَةً، وحَطَّ عنهُ بها خطيئةً","explicit":true,"otherNeedIds":[11],"ref":"تخريج المسند لشعيب 27534","srcLabel":"الترمذي","text":["كسَرَ رجلٌ من قريشٍ سِنَّ رجُلٍ من الأنصارِ، فاستَعْدَى عليه معاويةَ، فقالَ القُرَشيُّ: إنَّ هذا داقٌّ سِنِّي، قال معاويةُ: كلَّا إنَّا سنُرْضيهِ. قالَ: فلمَّا ألَحَّ عليه الأنصاريُّ، قال معاويةُ: شأنُكَ بصاحِبِكَ، وأبو الدَّرْداءِ جالسٌ، فقالَ أبو الدَّرْداءِ: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["ما من مُسلِمٍ يُصابُ بشَيءٍ في جسَدِهِ، فيَتصَدَّقُ بهِ،",1]," ",["إلَّا رفَعَهُ اللهُ به درجَةً، وحَطَّ عنهُ بها خطيئةً",2],". قالَ: فقالَ الأنصاريُّ: أأَنتَ سمِعْتَ هذا من رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ قال: نعَمْ. سَمِعَتْهُ أُذُنايَ، ووعاهُ قَلْبي، يعني فعَفا عنهُ."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"المرفوع منه صحيح لغيره","takhrij":"أخرجه الترمذي (1393)، وابن ماجه (2693)، وأحمد (27534) واللفظ له","bab":"ديات وقصاص › القصاص في كسر السن","dorar":"JEOyJsS4","merged":2,"otherRefs":["المتجر الرابح 276 (حسن)"]},{"id":"س-00334","fp":"b9da25d2523c","stateId":492,"easy":"إذا عفوت عمن ظلمك وأعطيت من حرمك ووصلت من قطعك ← يُشرف لك البنيان وتُرفع لك الدرجات","cause":"فلْيَعْفُ عمَّنْ ظلَمَهُ، ويُعْطِ مَنْ حَرَمَهُ، ويَصِلْ مَنْ قَطَعهُ","result":"مَنْ سَرَّهُ أنْ يُشرِفَ له البُنيانُ، وتُرفعَ له الدَّرجاتُ","explicit":true,"ref":"المستدرك على الصحيحين 3202","srcLabel":"الحاكم","text":["«",["مَنْ سَرَّهُ أنْ يُشرِفَ له البُنيانُ، وتُرفعَ له الدَّرجاتُ، ",2],["فلْيَعْفُ عمَّنْ ظلَمَهُ، ويُعْطِ مَنْ حَرَمَهُ، ويَصِلْ مَنْ قَطَعهُ»",1],"."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"صحيح الإسناد","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"aZvErsrx"},{"id":"س-04739","fp":"ef8b034fde70","stateId":492,"easy":"إذا كظمت غيظك ابتغاء وجه الله ← فلا جرعة أفضل عند الله منها","cause":"جَرعَةِ غَيظٍ، يَكظِمُها ابتِغاءَ وَجهِ اللهِ","result":"ما تَجَرَّعَ عبدٌ جَرعَةً أفضَلَ عندَ اللهِ","explicit":true,"otherNeedIds":[8],"ref":"تخريج المسند لشعيب 6114","srcLabel":"أحمد","text":[["ما تَجَرَّعَ عبدٌ جَرعَةً أفضَلَ عندَ اللهِ",2]," عزَّ وجلَّ من ",["جَرعَةِ غَيظٍ، يَكظِمُها ابتِغاءَ وَجهِ اللهِ",1]," تَعالى."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (6114) واللفظ له، والطبراني (13/249) (13994)، والضياء في ((الأحاديث المختارة)) (268)","bab":"رقائق وزهد › الإخلاص","dorar":"lQfxaIXA"},{"id":"س-06113","fp":"5deaad94d22a","stateId":492,"easy":"إذا وصلت من قطعك وأعطيت من حرمك وصفحت عمن ظلمك ← فهي أفضل الفضائل","cause":"أن تصِلَ من قطعكَ، وتُعطيَ من حَرَمَك، وتصفَحَ عمَّنَ ظلمَكَ","result":"أفضلُ الفضائل","explicit":true,"similar":["س-03846"],"otherNeedIds":[41],"ref":"الجامع الصغير 1281","srcLabel":"أحمد","text":[["أفضلُ الفضائل",2]," ",["أن تصِلَ من قطعكَ، وتُعطيَ من حَرَمَك، وتصفَحَ عمَّنَ ظلمَكَ",1]],"grade":"صحيح","narrator":"معاذ بن أنس","muhaddith":"صحيح","takhrij":"أخرجه الخرائطي في ((مكارم الأخلاق)) (295) واللفظ له، وأخرجه أحمد (15618)، والطبراني (20/188) (414) باختلاف يسير","bab":"رقائق وزهد › مكارم الأخلاق والعفو عمن ظلم","dorar":"CGFqG6fX"},{"id":"س-07723","fp":"32aa3ca3f59e","stateId":492,"easy":"إذا آثرت أخاك على نفسك ← فأنت ممن مدحهم الله","cause":"إنَّ أخي فلانًا وعيالَهُ أحوجُ إلى هذا مِنَّا","result":"فنَزَلَتْ: وَيُؤْثِرُونَ عَلَى أَنْفُسِهِمْ وَلَوْ كَانَ بِهِمْ خَصَاصَةٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[23],"ref":"المستدرك على الصحيحين 3845","srcLabel":"البيهقي","text":["عنِ ابنِ عُمَرَ رَضيَ اللهُ عنهُما، قالَ: أُهدِيَ رَجلٌ مِن أصحابِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ رأسَ شاةٍ، فقالَ: ",["إنَّ أخي فلانًا وعيالَهُ أحوجُ إلى هذا مِنَّا",1],". قالَ: فبَعَثَ إليه فلمْ يَزلْ يَبعثُ إليه واحدًا إلى آخرَ حتَّى تَداوَلها سبعةَ أبياتٍ حتَّى رَجعتْ إلى الأوَّلِ، ",["فنَزَلَتْ: {وَيُؤْثِرُونَ عَلَى أَنْفُسِهِمْ وَلَوْ كَانَ بِهِمْ خَصَاصَةٌ",2],"} [الحشر: 9] إلى آخرِ الآيةِ."],"grade":"صحيح","narrator":"محارب بن دثار","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي  في ((الشعب)) (3479)، والواحدي في ((أسباب النزول)) (810 ) واللفظ لهما.","bab":"قرآن › أسباب النزول","dorar":"eZPEpSDy"},{"id":"س-03846","fp":"94d02f5e872e","stateId":492,"easy":"إذا وصلت من قطعك وأعطيت من حرمك وأعرضت عمن ظلمك ← فهي فواضل الأعمال","cause":"صِلْ مَنْ قَطَعَكَ وأَعْطِ مَنْ حرمَكَ وأَعْرِضْ عمن ظلَمَكَ","result":"أخبرْني بفواضِلِ الأعمالِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-06113","ref":"مجمع الزوائد 8/191","text":["قال ثم لقيتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم فأخذْتُ بيدِهِ فقُلْتُ يا رسولَ اللهِ ",["أخبرْني بفواضِلِ الأعمالِ",2]," فقال يا عُقْبَةُ ",["صِلْ مَنْ قَطَعَكَ وأَعْطِ مَنْ حرمَكَ وأَعْرِضْ عمن ظلَمَكَ",1]," وفي روايةٍ واعْفُ عمن ظلَمَكَ"],"grade":"حسن","narrator":"عقبة بن عامر","muhaddith":"أحد إسنادي أحمد رجاله ثقات","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"LPRu8Pan"},{"id":"س-03677","fp":"c0e6f931aae4","stateId":493,"easy":"إذا صدقت ← تُكتب عند الله صديقاً","cause":"إن العبد ليصدق","result":"فيكتب عند الله صديقا","explicit":true,"star":true,"ref":"شفاء العليل 1/105","srcLabel":"مسلم","text":["[ عن عبد الله بن مسعود ] أنه كان يجيء كل يوم خميس يقوم قائما لا يجلس فيقول إنما هما اثنتان فأحسن الهدي هدي محمد وأصدق الحديث كتاب الله وشر الأمور محدثاتها وكل محدث ضلالة إن الشقي من شقي في بطن أمه وإن السعيد من وعظ بغيره ألا فلا يطولن عليكم الأمد ولا يلهينكم الأمل فإن كل ما هو آت قريب وإنما البعيد ما ليس آتيا وإن من شرار الناس بطال النهار جيفة الليل وإن قتل المؤمن كفر وإن سبًابه فسوق ولا يحل لمسلم أن يهجر أخاه فوق ثلاث ألا إن شر الروايا روايا الكذب وإنه لا يصلح من الكذب جد ولا هزل ولا أن يعد الرجل صبيه ثم لا ينجزه ألا وإن الكذب يهدي إلى الفجور وإن الفجور يهدي إلى النار وإن الصدق يهدي إلى البر وإن البر يهدي إلى الجنة وإن الصادق يقال له صدق وبر وإن الكاذب يقال له كذب وفجر وإني سمعت رسول اللهِ صلى الله عليه وسلم يقول ",["إن العبد ليصدق",1]," ",["فيكتب عند الله صديقا",2]," وإنه ليكذب حتى يكتب عند الله كذابًا ألا هل تدرون ما العضة هي النميمة التي تفسد بين الناس"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"متواتر","takhrij":"أخرجه ابن ماجه (46)، وعبدالرزاق (20076)، والطبراني (9/100) (8522) باختلاف يسير. وقوله: \"الشقي من شقي في بطن أمه وإن السعيد من وعظ بغيره\" أخرجه مسلم (2645)","bab":"اعتصام بالسنة › الأمر بالتمسك بها","dorar":"EmP7nGwk","merged":6,"otherRefs":["صحيح مسلم 2607 (صحيح)","تخريج المسند لشاكر 5/343 (صحيح)","صحيح الأدب المفرد 298 (صحيح)","المستدرك على الصحيحين 445 (صحيح)","تخريج المسند لشعيب 4160 (صحيح)"]},{"id":"س-00343","fp":"49e84db0e9df","stateId":493,"easy":"إذا لزمت الاقتصاد والتؤدة والسمت الحسن ← فهي جزء من أربعة وعشرين جزءاً من النبوة","cause":"الاقْتِصادُ والتُّؤَدةُ والسَّمْتُ الحَسَنُ","result":"جُزْءٌ مِن أرْبَعةٍ وعِشْرينَ جُزْءًا مِن النُّبُوَّةِ","explicit":true,"star":true,"similar":["س-00342","س-06115"],"ref":"الأحاديث المختارة 9 / 404","srcLabel":"متفق عليه","text":["«",["الاقْتِصادُ والتُّؤَدةُ والسَّمْتُ الحَسَنُ",1]," ",["جُزْءٌ مِن أرْبَعةٍ وعِشْرينَ جُزْءًا مِن النُّبُوَّةِ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن سرجس المزني","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"CGJ7MYTN","merged":2,"otherRefs":["صحيح الجامع 3010 (صحيح)"]},{"id":"س-00337","fp":"887741edb9e2","stateId":493,"easy":"إذا حسن سمتك ← فهو جزء من خمسة وسبعين جزءاً من النبوة","cause":"السَّمْتُ الحَسَنُ","result":"جُزءٌ مِن خَمسةٍ وسَبعينَ جُزءًا مِنَ النُّبُوَّةِ","explicit":true,"ref":"الأحاديث المختارة 2209","srcLabel":"البخاري","text":["«",["السَّمْتُ الحَسَنُ",1]," ",["جُزءٌ مِن خَمسةٍ وسَبعينَ جُزءًا مِنَ النُّبُوَّةِ",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"OPuSkvik"},{"id":"س-00341","fp":"fbe9f9601a06","stateId":493,"easy":"إذا كنت أشكر الناس للناس ← تكون أشكرهم لله","cause":"أَشكَرُكم للنَّاسِ","result":"أَشكَرُكم للهِ عَزَّ وجَلَّ","explicit":true,"similar":["س-00260"],"otherNeedIds":[41],"ref":"الأحاديث المختارة 1492","srcLabel":"البخاري","text":["«",["أَشكَرُكم للهِ عَزَّ وجَلَّ",2]," ",["أَشكَرُكم للنَّاسِ",1],"»."],"grade":"صحيح","narrator":"الأشعث بن قيس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"8mgFqGlo"},{"id":"س-00342","fp":"d20fbc1af4ef","stateId":493,"easy":"إذا لزمت الهدي الصالح والسمت الصالح والاقتصاد ← فهي جزء من النبوة","cause":"الهَدْيَ الصَّالِحَ والسَّمْتَ الصَّالِحَ والاقْتِصادَ","result":"جُزْءٌ مِن خَمْسةٍ وعِشْرينَ جُزْءًا مِن النُّبُوَّةِ","explicit":true,"repOf":"س-00343","ref":"الأحاديث المختارة 9 / 534","text":["«إنَّ ",["الهَدْيَ الصَّالِحَ والسَّمْتَ الصَّالِحَ والاقْتِصادَ",1]," ",["جُزْءٌ مِن خَمْسةٍ وعِشْرينَ جُزْءًا مِن النُّبُوَّةِ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"VQQBcEnr"},{"id":"س-00260","fp":"5cc77dcd29a6","stateId":493,"easy":"إذا شكرت الناس ← تكون من أشكر الناس لله","cause":"أشكَرُهم للنَّاسِ","result":"إنَّ أشكرَ النَّاسِ للهِ","explicit":true,"repOf":"س-00341","otherNeedIds":[41],"ref":"تخريج المسند لشعيب 21846","text":[["إنَّ أشكرَ النَّاسِ للهِ",2]," ",["أشكَرُهم للنَّاسِ",1],"."],"grade":"صحيح","narrator":"الأشعث بن قيس","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (21847) واللفظ له، والطيالسي (1144) باختلاف يسير، وابن أبي الدنيا في ((اصطناع المعروف)) (131) بنحوه","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"4Y4vTEwJ"},{"id":"س-00278","fp":"d409b99282f5","stateId":493,"easy":"إذا أخفيت صدقتك وكتمت مصائبك وأمراضك ← فهي من كنوز البر","cause":"إخْفاءُ الصَّدَقةِ، وكِتْمانُ المَصائِبِ والأمْراضِ","result":"مِن كُنوزِ البِرِّ","explicit":true,"otherNeedIds":[9],"ref":"الأحكام الوسطى 4/ 228","srcLabel":"الأحكام الوسطى","text":["\"",["مِن كُنوزِ البِرِّ",2]," ",["إخْفاءُ الصَّدَقةِ، وكِتْمانُ المَصائِبِ والأمْراضِ",1],"، ومَن بَثَّ فلم يَصبِرْ\"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"g4LTiS03"},{"id":"س-00283","fp":"54415d8a14dd","stateId":493,"easy":"إذا حسن هديك في آخر الزمان ← فهو خير من بعض العمل","cause":"حُسنَ الهَديِ في آخرِ الزمانِ","result":"خيرٌ من بعضِ العملِ","explicit":true,"ref":"فتح الباري لابن حجر 10/526","srcLabel":"فتح الباري لابن حجر","text":["[ أن ] ابنَ مسعودٍ قال : اعلَموا أنَّ ",["حُسنَ الهَديِ في آخرِ الزمانِ",1]," ",["خيرٌ من بعضِ العملِ",2]],"grade":"صحيح","narrator":"زيد بن وهب الجهني","muhaddith":"إسناده صحيح","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"lCedbhZ3"},{"id":"س-05006","fp":"175121e4f2df","stateId":493,"easy":"إذا أطعمت الطعام وأفشيت السلام وصليت والناس نيام ← فهي درجات","cause":"فإطعامُ الطَّعامِ، وإفشاءُ السَّلامِ، والصَّلاةُ باللَّيلِ والنَّاسُ نيامٌ","result":"وثلاثٌ دَرجاتٌ","explicit":true,"similar":["س-01387"],"ref":"المصابيح في الأحاديث المتواترة 608","srcLabel":"المصابيح في الأحاديث المتواترة","text":["ثلاثٌ مُهلِكاتٌ، وثلاثٌ مُنجياتٌ، وثلاثٌ كفَّاراتٌ، ",["وثلاثٌ دَرجاتٌ",2],"؛ فأمَّا المُهلِكاتُ: فشُحٌّ مُطاعٌ، وهوًى مُتَّبَعٌ، وإعجابُ المرءِ بنفسِه، وأمَّا المُنجياتُ: العَدلُ بالغَضَبِ والرِّضا، والقَصدُ في الفَقرِ والغِنى، وخَشيةُ اللهِ في السِّرِّ والعلانيةِ، وأمَّا الكفَّاراتُ: فانتِظارُ الصَّلاةِ بَعدَ الصَّلاةِ، وإسباغُ الوُضوءِ في السَّبَراتِ، ونَقلُ الأقدامِ إلى الجماعاتِ، وأمَّا الدَّرجاتُ: ",["فإطعامُ الطَّعامِ، وإفشاءُ السَّلامِ، والصَّلاةُ باللَّيلِ والنَّاسُ نيامٌ",1]],"grade":"صحيح","muhaddith":"هذه مجموعة هنا، وأكثر رواياتها متفرقة، وكلها متواترة","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"AFzHsVLC"},{"id":"س-08041","fp":"124ff37b546e","stateId":493,"easy":"إذا تواضعت لله في الدنيا ← يرفعك الله يوم القيامة","cause":"من تَواضعَ لله في الدنيا","result":"رفعَه اللهُ يومَ القيامةِ","explicit":true,"ref":"صحيح الترغيب 3733","srcLabel":"البيهقي","text":["يا جريرُ ! تواضَعْ لله ، فإنه ",["من تَواضعَ لله في الدنيا ",1],["رفعَه اللهُ يومَ القيامةِ",2]," يا جريرُ هل تدري ما الظُّلُماتُ يومَ القيامةِ ؟ قلتُ : لا أدري قال : ظُلْمُ الناسِ بينهم ، ثم أخذ عُوَيدًا لا أكاد أراه بين إصبعَيه فقال : يا جريرُ ! لو طلبتَ في الجنَّةِ مثلَ هذا لم تجدْه قلتُ : يا أبا عبدِ اللهِ ! فأين النخلُ والشَّجرُ ؟ قال : أصولُها الُّلؤلؤُ والذَّهبُ ، أعلاه الثَّمَرُ ."],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن أبي شيبة (35808)، وهناد في ((الزهد)) (98)، والبيهقي في ((البعث والنشور)) (858) باختلاف يسير.","bab":"مظالم › تحريم الظلم","dorar":"QMmlwx4a"},{"id":"س-06115","fp":"35b59c721cef","stateId":493,"easy":"إذا لزمت الهدي الصالح والسمت الصالح ← فهما جزء من سبعين جزءاً من النبوة","cause":"الهديَ الصالحَ ، و السَّمتَ الصالحَ","result":"جزءٌ من سبعين جزءًا من النُّبوَّةِ","explicit":true,"repOf":"س-00343","ref":"صحيح الجامع 1992","text":["إنَّ ",["الهديَ الصالحَ ، و السَّمتَ الصالحَ",1]," ، ",["جزءٌ من سبعين جزءًا من النُّبوَّةِ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن","takhrij":"أخرجه أبو داود (4776)، وأحمد (2698)","bab":"رقائق وزهد › مكارم الأخلاق والعفو عمن ظلم","dorar":"5QaZaeO2"},{"id":"س-01387","fp":"939656c8028a","stateId":493,"easy":"إذا أطعمت الطعام وألنت الكلام وصليت والناس نيام ← فهي الدرجات","cause":"إطعامُ الطَّعامِ، ولِينُ الكلامِ، والصَّلاةُ والنَّاسُ نِيَامٌ","result":"وما الدَّرجاتُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-05006","ref":"تخريج شرح السنة 4/37","text":["احْتَبَسَ عَلَيْنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ذاتَ غَداةٍ عَنْ صلاةِ الصُّبحِ حتَّى كِدْنا نَتَراءَى قَرْنَ الشَّمسِ، فخرَجَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ سريعًا، فثوَّبَ بالصَّلاةِ، وصلَّى وتجوَّزَ في صلاتِهِ، فلمَّا سلَّمَ قال: كما أنتُمْ على مَصَافِّكُمْ، ثُمَّ أقبَلَ إلينا فقالَ: إنِّي سأُحدِّثُكُمْ ما حَبَسَني عنكُمُ الغَداةَ، إنِّي قُمتُ مِنَ اللَّيلِ، فصلَّيْتُ ما قُدِّرَ لي، فنعَسْتُ في صلاتي حتَّى اسْتَثْقَلْتُ، (ووَقَعَ في مُسنَدِ أحمدَ استيقَظْتُ وهو تحريفٌ)، فإذا أنا بربِّي عزَّ وجَلَّ في أحسَنِ صورةٍ، قالَ: يا مُحمَّدُ أتَدْري فِيمَ يختصِمُ الملأُ الأعلى؟ قُلتُ: لا أَدْري يا ربِّ، قالَ: يا مُحمَّدُ، فِيمَ يختصِمُ الملأُ الأعلى؟ قُلتُ: لا أَدْري رَبِّ، فرأيتُهُ وَضَعَ كَفَّهُ بَينَ كَتِفَيَّ حتَّى وجدتُ بَرْدَ أنامِلِهِ بَينَ صَدْري، فتجلَّى لي كُلُّ شيءٍ، وعرَفْتُ، فقالَ: يا مُحمَّدُ، فِيمَ يختصِمُ الملأُ الأعلى؟ قُلتُ: في الكفَّاراتِ، قال: وما الكفَّاراتُ؟ قُلتُ: نَقْلُ الأقدامِ إلى الجَماعاتِ، وجُلوسٌ في المساجِدِ بَعدَ الصَّلاةِ، وإسباغُ الوُضوءِ عِندَ الكريهاتِ، قالَ: ",["وما الدَّرجاتُ",2],"؟ قُلتُ: ",["إطعامُ الطَّعامِ، ولِينُ الكلامِ، والصَّلاةُ والنَّاسُ نِيَامٌ",1],"، قالَ: سَلْ، قُلتُ: اللَّهمَّ إنِّي أسألُكَ فِعْلَ الخيراتِ وتَرْكَ المُنكَراتِ، وحُبَّ المساكينِ، وأنْ تغفِرَ لي وترحمَني، وإذا أردتَ فتنةً في قَومٍ، فتوفَّني غَيرَ مفتونٍ، وأسألُكَ حُبَّكَ وحُبَّ مَن يُحِبُّكَ، وحُبَّ عمَلٍ يُقرِّبُني إلى حُبِّكَ، وقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّها حَقٌّ، فادْرُسُوها وتعلَّموها."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (3235)، وأحمد (22109) كلاهما بلفظه، والطبراني (20/ 109)، (216) باختلاف يسير.","bab":"وضوء › إسباغ الوضوء","dorar":"AkMFqQCK","merged":9,"otherRefs":["أحكام القرآن لابن العربي 4/72 (حسن)","صحيح الترغيب 618 (صحيح)","السلسلة الصحيحة 3169 (صحيح)","هداية الرواة 693 (صحيح)","تخريج شرح السنة 925 (صحيح)","أطراف الغرائب 1/163 (صحيح)","صحيح الترغيب 453 (حسن)","صحيح الترغيب 408 (صحيح)"]},{"id":"س-00249","fp":"d85bb93b6568","stateId":493,"easy":"إذا تورّعت ← فلا يعدل الورع شيء","cause":"وذُكر عندَهُ آخرُ بِرِعَةٍ","result":"لا يُعدَلُ بالرِّعةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"الجامع الصغير 9955","srcLabel":"الترمذي","text":["لا يَعْدِلُ بالرِّعَةِ [يعني حديث: ذُكر رجلٌ عندَ النبيِّ صلَّى اللهُ عليهِ وسلَّمَ بعبادَةٍ واجتهادٍ، ",["وذُكر عندَهُ آخرُ بِرِعَةٍ",1]," فقال النَّبيُّ صلَّى اللهُ عليهِ وسلَّمَ: ",["لا يُعدَلُ بالرِّعةِ",2]," .]"],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"حسن","takhrij":"أخرجه الترمذي (2519)، والدارقطني في ((المؤتلف والمختلف)) (1/ 209)، والبيهقي في ((الزهد الكبير)) (831) واللفظ لهم.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"kLMX83We"},{"id":"ق-1312","fp":"7d06ea029189","stateId":494,"easy":"الإيمان والعلم ← رفع الدرجات","cause":"الإيمان والعلم","result":"رفع الدرجات","explicit":true,"star":true,"otherNeedIds":[18],"ref":"سورة المجادلة: 11","srcLabel":"القرآن الكريم","quran":{"s":58,"from":11,"to":11,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا قِيلَ لَكُمْ تَفَسَّحُوا فِي الْمَجَالِسِ فَافْسَحُوا يَفْسَحِ اللَّهُ لَكُمْ وَإِذَا قِيلَ انْشُزُوا فَانْشُزُوا يَرْفَعِ اللَّهُ الَّذِينَ آمَنُوا مِنْكُمْ وَالَّذِينَ أُوتُوا الْعِلْمَ دَرَجَاتٍ وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ (11)","hl":[[151,234,1]]}},{"id":"س-08174","fp":"1e4fb8e4aa23","stateId":494,"easy":"إذا كنت عالماً ← ففضلك على العابد كفضل النبي ﷺ على أدنى الصحابة","cause":"فضلُ العالمِ علَى العابدِ","result":"كفضلي علَى أدناكُم","explicit":true,"otherNeedIds":[18],"ref":"الترغيب والترهيب 1/80","srcLabel":"الترمذي","text":["ذُكرَ لرسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ رجلانِ أحدُهُما عابدٌ والآخرُ عالمٌ ، فقالَ عليهِ أفضلُ الصلاةِ والسَّلامِ : ",["فضلُ العالمِ علَى العابدِ",1]," ",["كفضلي علَى أدناكُم",2]," ثمَّ قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : إنَّ اللَّهَ وملائكتَهُ وأهلَ السَّماواتِ والأرضِ حتَّى النَّملةَ في جُحرِها ، وحتَّى الحوتَ ليصلُّونَ علَى مُعلِّمِ النَّاسِ الخيرَ"],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (2685)، وتمام في ((فوائده)) (1243) باختلاف يسير، والطبراني (8/278) (7911) مختصراً.","bab":"ملائكة › أعمال الملائكة","dorar":"E9oPRle0","merged":2,"otherRefs":["صحيح الترغيب 81 (حسن)"]},{"id":"س-07020","fp":"78b5e216601a","stateId":494,"easy":"إذا طلبت العلم ← ففضل العلم أحب من فضل العبادة","cause":"فَضْلُ العِلْمِ","result":"أَحَبُّ إليَّ مِنْ فَضْلِ العِبادَةِ","explicit":true,"ref":"المستدرك على الصحيحين 319","srcLabel":"البيهقي","text":["نحو: [«",["فَضْلُ العِلْمِ",1]," ",["أَحَبُّ إليَّ مِنْ فَضْلِ العِبادَةِ",2],"، وخَيْرُ دينِكُمُ الوَرَعُ»."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أبو بكر الإسماعيلي في ((معجم أسامي شيوخه)) (1/ 355)، والبيهقي في ((الآداب)) (830) بلفظه.","bab":"علم › الحث على طلب العلم","dorar":"RQpiPWzk"},{"id":"س-07516","fp":"59718c740d62","stateId":494,"easy":"إذا كنت عالماً أو شهيداً ← تشفع يوم القيامة بعد الأنبياء","cause":"ثُمَّ العُلَماءُ ثمَّ الشُّهَداءُ","result":"يَشفَعُ يَومَ القيامةِ ثَلاثةٌ","explicit":true,"otherNeedIds":[18,65],"ref":"فيض القدير 6/ 462","srcLabel":"فيض القدير","text":[["يَشفَعُ يَومَ القيامةِ ثَلاثةٌ",2],": الأنبياءُ ",["ثُمَّ العُلَماءُ ثمَّ الشُّهَداءُ",1]],"grade":"حسن","narrator":"عثمان بن عفان","muhaddith":"رمز السيوطي لحسنه وهو عليه رد فقد أعله ابن عدي والعقيلي","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"gO2Sww7l","merged":2,"otherRefs":["النوافح العطرة 480 (حسن)"]},{"id":"س-07101","fp":"e22c1c80d810","stateId":494,"easy":"إذا كتبت العلم ← يرجح حبر العلماء بدم الشهداء","cause":"حبرُ العلماءِ","result":"بدمِ الشُّهداءِ فرجحَ عليهِم","explicit":true,"otherNeedIds":[18],"ref":"تاريخ بغداد 2/190","srcLabel":"ابن الجوزي","text":["وُزنَ ",["حبرُ العلماءِ",1]," ",["بدمِ الشُّهداءِ فرجحَ عليهِم",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"رجاله ثقات غير محمد بن الحسن، وأرى الحديث مما صنعت يداه","takhrij":"أخرجه ابن الجوزي في ((العلل المتناهية)) (83)","bab":"علم › تعليم الناس وفضل ذلك","dorar":"ijsZNODd"},{"id":"س-07256","fp":"0725fd9a279f","stateId":494,"easy":"إذا صليت وقرأت القرآن وتذاكرت الحلال والحرام ← فذاك ميراث النبي ﷺ","cause":"قَومًا يُصَلُّونَ، وقَومًا يَقرَؤونَ القُرآنَ، وقَومًا يَتَذاكَرونَ الحَلالَ والحَرامَ","result":"فذاكَ مِيراثُ مُحمدٍ صلَّى اللهُ عليه وسلَّمَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[18],"ref":"الترغيب والترهيب 1/82","srcLabel":"الطبراني","text":["عن أبي هُرَيرةَ رَضيَ اللهُ عنه أنَّه مَرَّ بسوقِ المَدينةِ فوَقَفَ عليها، فقال: يا أهلَ السُّوقِ، ما أعجَزَكم! قالوا: وما ذاكَ يا أبا هُرَيرةَ؟ قال: ذاكَ مِيراثُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يُقسَمُ وأنتم هاهنا، ألَا تَذهَبونَ فتَأخُذونَ نَصيبَكم منه؟ قالوا: وأينَ هو؟ قال: في المَسجِدِ. فخَرَجوا سِراعًا، ووَقَفَ أبو هُرَيرةَ لهم حتى رَجَعوا، فقال لهم: ما لكم؟ فقالوا: يا أبا هُرَيرةَ، قد أتَيْنا المَسجِدَ فدَخَلْنا فيه فلم نَرَ فيه شَيئًا يُقسَمُ. فقال لهم أبو هُرَيرةَ: وما رَأيتُم في المَسجِدِ أحَدًا؟ قالوا: بلى، رَأيْنا ",["قَومًا يُصَلُّونَ، وقَومًا يَقرَؤونَ القُرآنَ، وقَومًا يَتَذاكَرونَ الحَلالَ والحَرامَ",1],". فقال لهم أبو هُرَيرةَ: وَيْحَكم! ",["فذاكَ مِيراثُ مُحمدٍ صلَّى اللهُ عليه وسلَّمَ",2],"."],"grade":"حسن","narrator":"[عبدالله الرومي]","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((الأوسط)) (1429) بلفظه.","bab":"علم › فضل مجالس العلم والذكر","dorar":"6WsAm5LE"},{"id":"س-00558","fp":"90f29c865641","stateId":494,"easy":"إذا كنت عالماً ← فأنت من مصابيح الأرض وورثة الأنبياء","cause":"العلماءُ","result":"مَصابيحُ الأرضِ ، و خُلَفَاءُ الأنبياءِ ، و ورَثَتِي ووَرَثَةُ الأنبياءِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[18],"ref":"كشف الخفاء 2/84","srcLabel":"ابن عدي","text":[["العلماءُ",1]," ",["مَصابيحُ الأرضِ ، و خُلَفَاءُ الأنبياءِ ، و ورَثَتِي ووَرَثَةُ الأنبياءِ",2]],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح","takhrij":"أخرجه ابن عدي كما في ((الجامع الصغير)) للسيوطي (5703)، والرافعي في ((التدوين في أخبار قزوين)) (2/128)","bab":"آداب عامة › ضرب الأمثال","dorar":"1hG6lk0e"},{"id":"س-07257","fp":"8286b289ebb7","stateId":494,"easy":"إذا جالست مجلساً تُذكر فيه الحكمة ← فنعم المجلس","cause":"المجلسُ الذي تُذكرُ فيه الحكمةُ","result":"نِعمَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"مجمع الزوائد 1/172","srcLabel":"الطبراني","text":["عن ابنِ مسعودٍ قال ",["نِعمَ",2]," ",["المجلسُ الذي تُذكرُ فيه الحكمةُ",1]],"grade":"حسن","narrator":"[عون بن عبدالله بن عتبة]","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((الكبير)) (9/ 188) (8925) باختلاف يسير، والدارمي (295)، وابن عبد البر في ((جامع بيان العلم)) (218) باختلاف يسير تامًا.","bab":"علم › فضل مجالس العلم والذكر","dorar":"7GMDZl77"},{"id":"س-08429","fp":"a2c7b415a76d","stateId":495,"easy":"إذا آويت النبي ﷺ ونصرته ← فلك الجنة","cause":"تُؤْووني وتَمْنَعوني","result":"قالَ: الجنَّةُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"المستدرك على الصحيحين 4305","srcLabel":"مسلم","text":["قالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ للنُّقَباءِ منَ الأنْصارِ: «",["تُؤْووني وتَمْنَعوني",1],"؟» قالوا: نعمْ، فما لنا؟ ",["قالَ: «الجنَّةُ",2],"»"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح على شرط مسلم","bab":"مناقب وفضائل › فضائل جمع من الصحابة والتابعين","dorar":"ge1ikhys"},{"id":"س-05403","fp":"ac888b756978","stateId":495,"easy":"إذا ازددت أخاً في الله ← تزداد به درجة","cause":"ما ازداد مسلمٌ أخًا في اللهِ","result":"إلا ازداد به درجةً","explicit":true,"ref":"إتحاف الخيرة المهرة 8/259","srcLabel":"إتحاف الخيرة المهرة","text":["عنِ الحسنِ قال: ",["ما ازداد مسلمٌ أخًا في اللهِ",1]," ",["إلا ازداد به درجةً",2]],"grade":"حسن","narrator":"حميد بن أبي حميد الطويل","muhaddith":"مقطوع ورواته ثقات","bab":"رقائق وزهد › الحب في الله","dorar":"c0ESrAqj"},{"id":"ق-0080","fp":"aff7457ee511","stateId":496,"easy":"التقوى ← العلو فوق الكافرين يوم القيامة والرزق بغير حساب","cause":"التقوى","result":"العلو فوق الكافرين يوم القيامة والرزق بغير حساب","explicit":true,"star":true,"otherNeedIds":[1],"ref":"سورة البقرة: 212","srcLabel":"القرآن الكريم","quran":{"s":2,"from":212,"to":212,"text":"زُيِّنَ لِلَّذِينَ كَفَرُوا الْحَيَاةُ الدُّنْيَا وَيَسْخَرُونَ مِنَ الَّذِينَ آمَنُوا وَالَّذِينَ اتَّقَوْا فَوْقَهُمْ يَوْمَ الْقِيَامَةِ وَاللَّهُ يَرْزُقُ مَنْ يَشَاءُ بِغَيْرِ حِسَابٍ (212)","hl":[[87,188,1]]}},{"id":"ق-0184","fp":"75313459e791","stateId":496,"easy":"اتباع رضوان الله ← درجات عند الله","cause":"اتباع رضوان الله","result":"درجات عند الله","explicit":true,"star":true,"otherNeedIds":[23],"ref":"سورة آل عمران: 162–163","srcLabel":"القرآن الكريم","quran":{"s":3,"from":162,"to":163,"text":"أَفَمَنِ اتَّبَعَ رِضْوَانَ اللَّهِ كَمَنْ بَاءَ بِسَخَطٍ مِنَ اللَّهِ وَمَأْوَاهُ جَهَنَّمُ وَبِئْسَ الْمَصِيرُ (162) هُمْ دَرَجَاتٌ عِنْدَ اللَّهِ وَاللَّهُ بَصِيرٌ بِمَا يَعْمَلُونَ (163)","hl":[[0,148,1]]}},{"id":"ق-1250","fp":"b1136f45dd13","stateId":496,"easy":"التقوى ← الكرامة عند الله","cause":"التقوى","result":"الكرامة عند الله","explicit":true,"star":true,"otherNeedIds":[23],"ref":"سورة الحجرات: 13","srcLabel":"القرآن الكريم","quran":{"s":49,"from":13,"to":13,"text":"يَا أَيُّهَا النَّاسُ إِنَّا خَلَقْنَاكُمْ مِنْ ذَكَرٍ وَأُنْثَى وَجَعَلْنَاكُمْ شُعُوبًا وَقَبَائِلَ لِتَعَارَفُوا إِنَّ أَكْرَمَكُمْ عِنْدَ اللَّهِ أَتْقَاكُمْ إِنَّ اللَّهَ عَلِيمٌ خَبِيرٌ (13)","hl":[[116,161,1]]}},{"id":"ق-1360","fp":"21bb88c1d5e0","stateId":496,"easy":"العفة والتصديق بكلمات الله والقنوت ← الاصطفاء والكرامة","cause":"العفة والتصديق بكلمات الله والقنوت","result":"الاصطفاء والكرامة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"سورة التحريم: 12","srcLabel":"القرآن الكريم","quran":{"s":66,"from":12,"to":12,"text":"وَمَرْيَمَ ابْنَتَ عِمْرَانَ الَّتِي أَحْصَنَتْ فَرْجَهَا فَنَفَخْنَا فِيهِ مِنْ رُوحِنَا وَصَدَّقَتْ بِكَلِمَاتِ رَبِّهَا وَكُتُبِهِ وَكَانَتْ مِنَ الْقَانِتِينَ (12)","hl":[[0,162,1]]}},{"id":"س-05571","fp":"aec30df19ab6","stateId":496,"easy":"إذا أكثرت ذكر الموت وأحسنت الاستعداد له ← فأنت من الأكياس وذهبت بشرف الدنيا والآخرة","cause":"أكثَرُهم للموتِ ذِكرًا أحسَنُهم له استعدادًا","result":"أولئك هم الأكياسُ، ذهبوا بشَرَفِ الدُّنيا والأُخرى","explicit":true,"otherNeedIds":[43],"ref":"المصابيح في الأحاديث المتواترة 586","srcLabel":"المصابيح في الأحاديث المتواترة","text":[["أكثَرُهم للموتِ ذِكرًا أحسَنُهم له استعدادًا",1]," قَبلَ نزولِ الموتِ، ",["أولئك هم الأكياسُ، ذهبوا بشَرَفِ الدُّنيا والأُخرى",2]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"HCauYd98","merged":3,"otherRefs":["الترغيب والترهيب 4/197 (حسن)","تخريج الإحياء للعراقي 5/194 (حسن)"]},{"id":"س-00384","fp":"7775409208c3","stateId":496,"easy":"إذا هجرت المعاصي وأنت حاضر في بلدك ← فهي أشد بلية وأعظم أجراً","cause":"وأمَّا هِجرةُ الحاضرِ","result":"فهي أشدُّهما بَليَّةً، وأعظمُهما أَجرًا","explicit":true,"ref":"تخريج المسند لشعيب 6792","srcLabel":"أبو داود","text":["إيَّاكم والشُّحَّ؛ فإنَّه أهلَكَ مَن كان قبلَكم، أمَرَهم بالظُّلمِ فظلَموا، وأمَرَهم بالقَطيعةِ فقطَعوا، وأمَرَهم بالفُجورِ ففجَروا، وإيَّاكم والظُّلمَ؛ فإنَّ الظُّلمَ ظُلماتٌ يومَ القيامةِ، وإيَّاكم والفُحشَ؛ فإنَّ اللهَ لا يحِبُّ الفُحشَ ولا التَّفحُّشَ، قال: فقام إليه رَجُلٌ، فقال: يا رسولَ اللهِ، أَيُّ المُسلمينَ أفضلُ؟ قال: مَن سلِمَ المُسلمونَ مِن لِسانِه ويدِه، قال: فقام هو أو آخَرُ، فقال: يا رسولَ اللهِ، أَيُّ الجهادِ أفضلُ؟ قال: مَن عُقِرَ جَوادُه، وأُهريقَ دَمُه.\n[قال عبدُ اللهِ بنُ أحمدَ]: قال أبي: وقال يزيدُ بنُ هارونَ في حديثِه: ثُمَّ ناداه هذا أو غيرُه، فقال: يا رسولَ اللهِ، أَيُّ الهِجرةِ أفضلُ؟ قال: أنْ تهجُرَ ما كرِهَ ربُّكَ، وهما هِجرتانِ: هِجرةٌ لِلبادي، وهِجرةٌ لِلحاضرِ، فأمَّا هِجرةُ البادي: فيُطيعُ إذا أُمِرَ، ويُجيبُ إذا دُعيَ، ",["وأمَّا هِجرةُ الحاضرِ",1],": ",["فهي أشدُّهما بَليَّةً، وأعظمُهما أَجرًا",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1698)، والنسائي في ((السنن الكبرى)) (11583) مختصراً، وأحمد (6792) واللفظ له","bab":"آداب عامة › الأخلاق المذمومة","dorar":"V9A7Jpxn","merged":2,"otherRefs":["تخريج صحيح ابن حبان 4863 (صحيح)"]},{"id":"س-04482","fp":"a85b4955fa89","stateId":496,"easy":"إذا حاسبت نفسك وعملت لما بعد الموت ← فأنت الكيّس","cause":"من دانَ نفسَه وعملَ لما بعد الموتِ","result":"والكيّسُ","explicit":true,"otherNeedIds":[53],"ref":"مجموع الفتاوى 14/460","srcLabel":"مجموع الفتاوى","text":["المجاهدُ منْ جاهدَ نفسَه في ذاتِ اللهِ ، ",["والكيّسُ",2]," ",["من دانَ نفسَه وعملَ لما بعد الموتِ",1]," ، والعاجزُ من أتبعَ نفسَه هواها وتمنى على اللهِ"],"grade":"صحيح","muhaddith":"ثابت","bab":"جهاد › فضل الجهاد","dorar":"Guxupdvm","merged":2,"otherRefs":["الجامع الصغير 6450 (صحيح)"]},{"id":"س-04342","fp":"46c6a42d5422","stateId":496,"easy":"إذا هجرت ما نهى الله عنه ← تكون من أفضل المهاجرين","cause":"من هجر ما نهى اللهُ تعالى عنه","result":"وأفضلُ المهاجرين","explicit":true,"ref":"صحيح الجامع 1129","srcLabel":"الطبراني","text":["أفضلُ المؤمنينَ إسلامًا من سَلِمَ المسلمونَ من لسانِه و يدِه ، وأفضلُ المؤمنينَ إيمانًا أحسنُهم خُلقًا ؛ ",["وأفضلُ المهاجرين",2]," ",["من هجر ما نهى اللهُ تعالى عنه",1]," ، و أفضلُ الجهادِ من جاهد نفسَه في ذاتِ اللهِ عزَّ و جلَّ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه محمد بن نصر المروزي في ((تعظيم قدر الصلاة)) (639)، والطبراني (13/596) (14512) باختلاف يسير.","bab":"جهاد › أي الجهاد أفضل","dorar":"R6IaIkMh"},{"id":"س-05452","fp":"c7a405b4d718","stateId":496,"easy":"إذا عدلت في الغضب والرضا واقتصدت في الفقر والغنى وخشيت الله في السر والعلانية ← فقد أوتيت مثل ما أوتي آل داود","cause":"العَدلُ في الغَضبِ والرِّضا، والقَصدُ في الفَقرِ والغِنى، وخَشيةُ اللهِ في السِّرِّ والعلانيةِ","result":"فقد أوتيَ مِثلَ ما أوتيَ آلُ داودَ","explicit":true,"ref":"المصابيح في الأحاديث المتواترة 608","srcLabel":"المصابيح في الأحاديث المتواترة","text":["ثلاثٌ مَن أوتيَهنَّ ",["فقد أوتيَ مِثلَ ما أوتيَ آلُ داودَ",2],": ",["العَدلُ في الغَضبِ والرِّضا، والقَصدُ في الفَقرِ والغِنى، وخَشيةُ اللهِ في السِّرِّ والعلانيةِ",1]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"رقائق وزهد › الخوف من الله","dorar":"JTkEsVvb"},{"id":"س-06008","fp":"723eed1a413b","stateId":496,"easy":"إذا اتقيت ← فالتقى أكيس الكيس","cause":"التُّقَى","result":"أكيسَ الكيِّسَ","explicit":true,"ref":"فتح الباري لابن حجر 13/68","srcLabel":"البيهقي","text":["لما صالح الحسنُ بنُ عليٍّ معاويةَ قال له معاويةُ قم فتكلم فقام فحمدَ اللهَ وأثنى عليه ثم قال أما بعدُ فإنَّ ",["أكيسَ الكيِّسَ",2]," ",["التُّقَى",1]," وإن أعجزَ العجزِ الفجورُ ألا وإنَّ هذا الأمرَ الذي اختلفتُ فيه أنا ومعاويةُ حقٌّ لامرئٍ كان أحقَّ به مني أو حقٌّ لي تركتُه لإرادةِ إصلاحِ المسلمين وحقنِ دمائِهم وإن أدري لعلَّهُ فتنةٌ لكم ومتاعٌ إلى حينٍ ثم استغفرَ ونزل"],"grade":"صحيح","narrator":"الشعبي عامر بن شراحيل","muhaddith":"محفوظ","takhrij":"أخرجه سعيد بن منصور في ((السنن)) (6092)، والبيهقي (17157) باختلاف يسير، وابن أبي شيبة (38527) بنحوه","bab":"رقائق وزهد › تقوى الله","dorar":"lkwHFKDI"},{"id":"س-07201","fp":"aad56a926263","stateId":496,"easy":"إذا صمت وصليت وتصدقت وأنت تخاف ألا يُقبل منك ← فأنت من المسارعين في الخيرات","cause":"الَّذينَ يصومونَ ويصلُّونَ ويتصدَّقونَ ، وَهُم يخافونَ أن لا تُقبَلَ منهُم","result":"أُولَئِكَ يُسَارِعُونَ فِي الْخَيْرَاتِ وَهُمْ لَهَا سَابِقُونَ","explicit":true,"otherNeedIds":[19],"ref":"صحيح الترمذي 3175","srcLabel":"الترمذي","text":["سألتُ رسولَ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ عن هذِهِ الآيةِ  وَالَّذِينَ يُؤْتُونَ مَا آتَوْا وَقُلُوبُهُمْ وَجِلَةٌ  قالت عائشةُ : أَهُمُ الَّذينَ يشربونَ الخمرَ ويسرِقونَ قالَ لا يا بنتَ الصِّدِّيقِ ، ولَكِنَّهمُ ",["الَّذينَ يصومونَ ويصلُّونَ ويتصدَّقونَ ، وَهُم يخافونَ أن لا تُقبَلَ منهُم",1]," ",["أُولَئِكَ يُسَارِعُونَ فِي الْخَيْرَاتِ وَهُمْ لَهَا سَابِقُونَ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3175) واللفظ له، وابن ماجه (4198)","bab":"علم › حسن السؤال ونصح العالم","dorar":"arhv5yQj"},{"id":"س-00914","fp":"3e2577553178","stateId":496,"easy":"إذا لزمت تقوى الله ← فهي رأس كل شيء","cause":"بِتَقْوَى اللهِ","result":"فَإِنَّهُ رأْسُ كُلِّ شيءٍ","explicit":true,"ref":"مجمع الزوائد 4/218","srcLabel":"أحمد","text":["أنَّ رجلًا جاءَهُ فقال أَوْصِني فقال سألْتَنِي عمَّا سألْتُ عنه رسولَ اللهِ صلَّى اللهُ عليه وسلَّم مِنْ قبلِكَ أُوصيكَ ",["بِتَقْوَى اللهِ",1]," ",["فَإِنَّهُ رأْسُ كُلِّ شيءٍ",2]," وعلَيْكَ بِالجِهَادِ فَإِنَّها رَهْبَانِيَّةُ الإسلامِ وعَلَيْكَ بذِكرِ اللهِ وتلاوةِ القرآنِ فإنَّهُ رُوحُكَ في السماءِ وذكرُكَ في الأرضِ"],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"رجاله ثقات","takhrij":"أخرجه أحمد (11774) واللفظ له، والطبراني في ((الصغير)) (949)، والبيهقي في ((الآداب)) (835) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"PYQoHjdn","merged":2,"otherRefs":["صحيح الجامع 2543 (حسن)"]},{"id":"س-05585","fp":"770d46746ae9","stateId":496,"easy":"إذا نظفت ثوبك ورضيت باليسير ← فهو من كرامتك على الله","cause":"نقاءُ ثوبِه ورضاه باليسيرِ","result":"مِن كرامةِ المؤمنِ على اللهِ","explicit":true,"otherNeedIds":[5],"ref":"مجمع الزوائد 5/135","srcLabel":"الطبراني","text":[["مِن كرامةِ المؤمنِ على اللهِ",2]," ",["نقاءُ ثوبِه ورضاه باليسيرِ",1]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"فيه عباد بن كثير وجرول بن حنفل وبقية رجاله ثقات","takhrij":"أخرجه الطبراني (12/395) (13458)، وأبو نعيم في ((حلية الأولياء)) (2/7) باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"9LlE3Xzr"},{"id":"س-06007","fp":"da902a8e3eee","stateId":496,"easy":"إذا كنت تقياً ← فأنت من آل محمد ﷺ (بالمعنى العام)","cause":"كلُّ تقيٍّ","result":"آلُ محمَّدٍ","explicit":true,"ref":"مختصر المقاصد 3","srcLabel":"الطبراني","text":[["آلُ محمَّدٍ",2]," ",["كلُّ تقيٍّ",1],"."],"grade":"حسن","narrator":"[أنس بن مالك]","muhaddith":"حسن لغيره","takhrij":"أخرجه البيهقي في ((الكبرى)) (2/ 83)، والطبراني في ((الأوسط)) (3/ 338)، و((الصغير)) (1/ 199). مع اختلاف يسير في اللفظ.","bab":"رقائق وزهد › تقوى الله","dorar":"uQ6qGuXZ"},{"id":"س-05583","fp":"a731bb093ba4","stateId":496,"easy":"إذا أكثرت ذكر الموت وتركت كثيراً مما تشتهي ← تبلغ منزلة عالية","cause":"هل كان يُكثِرُ ذِكرَ الموتِ ؟ . قالوا : لا . قال : فهل كان يدَعُ كثيرًا ممَّا يشتهي","result":"ما بلغ صاحبُكم كثيرًا ممَّا تذهبون إليه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[19],"ref":"الترغيب والترهيب 4/197","srcLabel":"الطبراني","text":["مات رجلٌ من أصحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّم ، فجعل أصحابُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم يُثنون عليه ، ويذكُرون من عبادتِه ورسولُ اللهِ صلَّى اللهُ عليه وسلَّم ساكتٌ ، فلمَّا سكتوا قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ",["هل كان يُكثِرُ ذِكرَ الموتِ ؟ . قالوا : لا . قال : فهل كان يدَعُ كثيرًا ممَّا يشتهي",1]," ؟ قالوا : لا . قال : ",["ما بلغ صاحبُكم كثيرًا ممَّا تذهبون إليه",2]],"grade":"حسن","narrator":"سهل بن سعد الساعدي","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني (5941) (6/ 185) بلفظه","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"2Yw5a4L6"},{"id":"س-05993","fp":"e4a400d31dba","stateId":496,"easy":"إذا كنت ذا تقى ← أحبك النبي ﷺ","cause":"ذا تُقًى","result":"ما أحبَّ رسولُ اللهِ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"مجمع الزوائد 10/277","srcLabel":"أحمد","text":[["ما أحبَّ رسولُ اللهِ",2]," صلَّى اللَّهُ عليه وسلَّم إلَّا ",["ذا تُقًى",1]],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده حسن","takhrij":"أخرجه أبو يعلى (4552) واللفظ له، وأحمد (24400)، والطبراني في ((المعجم الأوسط)) (535) بنحوه.","bab":"رقائق وزهد › تقوى الله","dorar":"HyL0lux6"},{"id":"س-05374","fp":"d31e3a9b422b","stateId":496,"easy":"إذا أحسنت الظن بالله ← فهو من عبادة الله","cause":"حُسنَ الظَّنِّ باللهِ","result":"مِن عِبادةِ اللهِ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 7813","srcLabel":"مسلم","text":["إنَّ ",["حُسنَ الظَّنِّ باللهِ",1]," تَعالَى ",["مِن عِبادةِ اللهِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أبو داود (4993)، والترمذي (3604)، وأحمد (7956) باختلاف يسير.","bab":"رقائق وزهد › التوكل واليقين","dorar":"QAm2wpFM","merged":3,"otherRefs":["صحيح ابن حبان 631 (صحيح)","تخريج المسند لشاكر 15/184 (صحيح)"]},{"id":"س-02199","fp":"dc83c8abe89b","stateId":496,"easy":"إذا انتظرت الفرج ← فهو عبادة","cause":"انتظارُ الفرَجِ","result":"عبادةٌ","explicit":true,"otherNeedIds":[4],"ref":"مختصر المقاصد 175","srcLabel":"البيهقي","text":[["انتظارُ الفرَجِ",1]," ",["عبادةٌ",2],"."],"grade":"حسن","narrator":"[أنس بن مالك]","muhaddith":"حسن","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (3264) البيهقي في ((شعب الإيمان)) (9534)، والخطيب البغدادي في ((تاريخ بغداد)) (2/ 536) جميعهم بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"0uSCmcsW"},{"id":"س-00136","fp":"5e67db0fbff7","stateId":497,"easy":"إذا بدأت بالسلام ← فأنت أفضل","cause":"أيُّهما بَدَأَ","result":"فهو أفْضلُ","explicit":true,"star":true,"otherNeedIds":[41],"ref":"صحيح الترغيب 2704","srcLabel":"البخاري","text":["يُسَلِّمُ الرَّاكِبُ على الماشِي ، والماشِي على القاعدِ ، والماشيانِ ",["أيُّهما بَدَأَ",1]," ",["فهو أفْضلُ",2]," ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (983)، والبزار كما في ((إتحاف الخيرة المهرة)) للبوصيري (6/38)، وابن حبان (498) واللفظ له.","bab":"آداب السلام › إفشاء السلام","dorar":"mtAPdJ6c","merged":3,"otherRefs":["فتح الباري لابن حجر 11/18 (صحيح)","إتحاف الخيرة المهرة 6/38 (صحيح)"]},{"id":"س-00137","fp":"9dd3e31d1907","stateId":497,"easy":"إذا مررت بقوم فسلّمت عليهم فردوا ← لك عليهم فضل درجة لتذكيرك إياهم","cause":"فإنَّ الرجلَ المسلمَ إذا مَرَّ بقومٍ فسلَّمَ عليهم ، فردُّوا عليه","result":"كان لهُ عليهم فضلُ درجةٍ بتذكيرِهِ إيَّاهُمُ السلامَ","explicit":true,"star":true,"ref":"صحيح الجامع 3697","srcLabel":"البخاري","text":["السلامُ اسمٌ من أسماءِ اللهِ وضَعَهُ اللهُ في الأرضِ ، فأفْشُوهُ بينَكمْ ، ",["فإنَّ الرجلَ المسلمَ إذا مَرَّ بقومٍ فسلَّمَ عليهم ، فردُّوا عليه",1]," ؛ ",["كان لهُ عليهم فضلُ درجةٍ بتذكيرِهِ إيَّاهُمُ السلامَ",2]," ، فإنْ لمْ يرُدُّوا عليه رَدَّ عليه مَنْ هوَ خيرٌ مِنهمْ وأطْيبُ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (1039 )، والبزار (1771 )، والطبراني في ((المعجم الكبير)) (10/ 182) ( 10391 )","bab":"آداب السلام › إفشاء السلام","dorar":"Ri4ICRaT"},{"id":"س-00158","fp":"86c6a810ddf3","stateId":497,"easy":"إذا بدأت بالسلام ← تكون خير المتلاقيين","cause":"الذي يَبدَأُ بالسَّلامِ","result":"وخَيرُهما","explicit":true,"star":true,"otherNeedIds":[41],"ref":"صحيح مسلم 2560","srcLabel":"البخاري","text":["لا يَحِلُّ لمُسلِمٍ أن يَهجُرَ أخاه فوقَ ثَلاثِ لَيالٍ، يَلتَقيانِ فيُعرِضُ هذا ويُعرِضُ هذا، ",["وخَيرُهما",2]," ",["الذي يَبدَأُ بالسَّلامِ",1],". وفي روايةٍ: إلَّا قَولَه: فيُعرِضُ هذا، ويُعرِضُ هذا؛ فإنَّهم جَميعًا قالوا في حَديثِهم غيرَ مالِكٍ: فيَصُدُّ هذا، ويَصُدُّ هذا."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6077)، وأبو داود (4911)، وابن حبان (5669) واللفظ لهم.","bab":"آداب السلام › فضل السلام والرد عليه","dorar":"wRU6KH1w"},{"id":"س-00219","fp":"bdc7746d9a23","stateId":497,"easy":"إذا وسّعت المجلس ← فخير المجالس أوسعها","cause":"أوسَعُها","result":"خيرُ المجالسِ","explicit":true,"ref":"تخريج رياض الصالحين 831","srcLabel":"أبو داود","text":["خيرُ المَجالسِ ",["أوسَعُها",1]," [يعني حديث: أُوذنَ أبو سعيدٍ بجنازةٍ في قومِه فكأنه تخلَّف حتى أخذ الناسُ مجالسَهم فلما رآهُ القومُ تسرَّبوا عنه فقام بعضُهم ليجلسَ في مجلسِه فقال : ألا إني سمعتُ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يقول : ",["خيرُ المجالسِ",2]," أوسعُها ثم تنحَّى فجلس في مكان واسعٍ]"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4820)، وأحمد (11663) واللفظ له","bab":"آداب المجلس › التفسح في المجالس","dorar":"1SYG4uuV","merged":3,"otherRefs":["تخريج المسند لشعيب 11137 (صحيح)","المستدرك على الصحيحين 7914 (صحيح)"]},{"id":"س-01262","fp":"f07636c1a746","stateId":497,"easy":"إذا تحنيت وتعطرت واستكت وتزوجت ← فهي من سنن المرسلين","cause":"الحنَّاءُ والتَّعطُّرُ والسِّواكُ والنِّكاحُ","result":"أربعٌ من سننِ المرسلين","explicit":true,"ref":"الترغيب والترهيب 3/90","srcLabel":"الترمذي","text":[["أربعٌ من سننِ المرسلين",2]," ",["الحنَّاءُ والتَّعطُّرُ والسِّواكُ والنِّكاحُ",1]," وقال بعضُ الرُّواةِ الحياءُ"],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (1080)، وأحمد (23628) باختلاف يسير.","bab":"نكاح › الحث على التزويج","dorar":"9xd8CPYl","merged":2,"otherRefs":["الجامع الصغير 913 (حسن)"]},{"id":"س-04609","fp":"5d2f52db7da8","stateId":497,"easy":"إذا وقفت على قبر من تعرفه فسلّمت عليه ← يرد الله عليه روحه فيرد عليك السلام","cause":"إذا وَقَفَ على قَبرِ الرَّجلِ، فسَلَّم عليه وهو يَعرِفُه في الدُّنيا","result":"فإنَّ اللهَ يَرُدُّ عليه رُوحَه، فيَرُدُّ عليه السَّلامَ","explicit":true,"ref":"فتاوى نور على الدرب لابن عثيمين 6/246","srcLabel":"فتاوى نور على الدرب لابن عثيمين","text":["أنَّ الرَّجلَ ",["إذا وَقَفَ على قَبرِ الرَّجلِ، فسَلَّم عليه وهو يَعرِفُه في الدُّنيا",1],"؛ ",["فإنَّ اللهَ يَرُدُّ عليه رُوحَه، فيَرُدُّ عليه السَّلامَ",2],"."],"grade":"صحيح","muhaddith":"صححه ابن عبد البر، وذكره ابن القيم في كتاب الروح ولم يتعقبه","bab":"دفن ومقابر › أحوال الميت في القبر","dorar":"y5RuLs2l","merged":2,"otherRefs":["الأحكام الوسطى 2/152 (صحيح)"]},{"id":"س-05431","fp":"0909dc599523","stateId":497,"easy":"إذا تحليت بالحياء والحلم واحتجمت واستكت وتعطرت ← فهي من سنن المرسلين","cause":"الحياءُ والحِلمُ والحِجامةُ والسِّواكُ والتعطُّرُ","result":"خمسٌ من سُننِ المُرسَلينَ","explicit":true,"ref":"مسند ابن عباس 1/513","srcLabel":"مسند ابن عباس","text":[["خمسٌ من سُننِ المُرسَلينَ",2]," ",["الحياءُ والحِلمُ والحِجامةُ والسِّواكُ والتعطُّرُ",1]],"grade":"صحيح","narrator":"يزيد الخطمي والد عبدالله","muhaddith":"إسناده صحيح","bab":"رقائق وزهد › الحياء","dorar":"1Ua4ZG5O"},{"id":"س-01545","fp":"2a8756f16b56","stateId":497,"easy":"إذا سميت الحارث أو همام ← فهي أصدق الأسماء","cause":"الحارثُ وهمَّامُ","result":"أصدقُ الأسماءِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"جامع الرسائل لابن تيمية 2/201","srcLabel":"جامع الرسائل لابن تيمية","text":[["أصدقُ الأسماءِ",2]," ",["الحارثُ وهمَّامُ",1]],"grade":"صحيح","muhaddith":"صحيح","bab":"أسماء › الأسماء المستحبة","dorar":"bAZGUCHO"},{"id":"س-04359","fp":"7b4ba1fafcdf","stateId":497,"easy":"إذا رميت وأدبت فرسك ولاعبت أهلك وتعلمت السباحة ← فهي من اللهو المحمود","cause":"مَشْيُ الرَّجُلِ بَيْنَ الغرَضَيْنِ وتأديبُه فرَسَه ومُلاعَبَتُه أهلَه وتعلُّمُ السِّباحةِ","result":"إلَّا أربعَ خِصالٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تهذيب التهذيب 2/44","srcLabel":"البيهقي","text":["حديث  في فَضلِ الرَّميِ [يعني حديث: عن عَطاءِ بنِ أبي رَباحٍ قال رأَيْتُ جابرَ بنَ عبدِ اللهِ وجابرَ بنَ عُمَيرٍ الأنصاريَّ يرتَمِيانِ فمَلَّ أحَدُهما فجلَس فقال له الآخَرُ كسِلْتَ سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ كلُّ شيءٍ ليس مِن ذِكْرِ اللهِ فهو لَهْوٌ وسَهْوٌ ",["إلَّا أربعَ خِصالٍ",2],": ",["مَشْيُ الرَّجُلِ بَيْنَ الغرَضَيْنِ وتأديبُه فرَسَه ومُلاعَبَتُه أهلَه وتعلُّمُ السِّباحةِ",1],"]"],"grade":"صحيح","narrator":"جابر بن عبد الله [وجابر بن عمير]","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو نعيم الأصبهاني في ((رياضة الأبدان)) (19)، والبيهقي (19770) كلاهما به تاما.","bab":"جهاد › الترغيب في الجهاد","dorar":"If9nvOvS"},{"id":"س-01858","fp":"43e7c6613252","stateId":498,"easy":"إذا أديت شهادتك قبل أن تُسألها ← تكون خير الشهداء","cause":"مَن أدَّى شَهادتَهُ قبلَ أن يُسْألَها","result":"خَيرُ الشُّهداءِ","explicit":true,"star":true,"similar":["س-07100"],"ref":"صحيح الترمذي 2297","srcLabel":"مسلم","text":[["خَيرُ الشُّهداءِ",2]," ",["مَن أدَّى شَهادتَهُ قبلَ أن يُسْألَها",1]],"grade":"صحيح","narrator":"زيد بن خالد الجهني","muhaddith":"صحيح [لغيره]","takhrij":"أخرجه الترمذي (2297) واللفظ له، وأخرجه مسلم (1719) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"KIH5WFKO"},{"id":"س-02049","fp":"6dd3be37f729","stateId":498,"easy":"إذا شهدت بالحق قبل أن تُسأل ← فهي خير الشهادة","cause":"ما شهِد به صاحبُها قبل أن يُسأَلَها","result":"خيرُ الشهادةِ","explicit":true,"ref":"صحيح الجامع 3276","srcLabel":"مسلم","text":[["خيرُ الشهادةِ",2]," ",["ما شهِد به صاحبُها قبل أن يُسأَلَها",1]],"grade":"صحيح","narrator":"زيد بن خالد الجهني","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (5/232) (5184) باختلاف يسير، وأخرجه مسلم (1719) بنحوه","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"RTf3L3UU"},{"id":"س-05385","fp":"5015aa7f6f8b","stateId":498,"easy":"إذا أجللت سلطان الله ← يجلّك الله يوم القيامة","cause":"مَن أَجَلَّ سلطانَ اللهِ","result":"أَجَلَّه اللهُ يومَ القيامةِ","explicit":true,"ref":"صحيح الجامع 5951","srcLabel":"الترمذي","text":[["مَن أَجَلَّ سلطانَ اللهِ ، ",1],["أَجَلَّه اللهُ يومَ القيامةِ",2]],"grade":"حسن","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"حسن","takhrij":"أخرجه مرفوعاً الترمذي (2224) بمعناه، وأحمد (20433) مطولاً باختلاف يسير، وأخرجه موقوفاً ابن أبي عاصم في ((السنة)) (1025) واللفظ له.","bab":"رقائق وزهد › الجزاء من جنس العمل","dorar":"DeenmGlt"},{"id":"س-07100","fp":"25ade612a687","stateId":498,"easy":"إذا أديت شهادتك قبل أن تُسألها ← فأنت خير الشهداء","cause":"الَّذي يأتي بشهادتِه قبل أن يُسأَلَها","result":"ألا أُخبرُكم بخيرِ الشُّهداءِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-01858","ref":"التمهيد 17/293","text":[["ألا أُخبرُكم بخيرِ الشُّهداءِ",2]," ؟ ",["الَّذي يأتي بشهادتِه قبل أن يُسأَلَها",1]," أو يُخبِرُ شهادتَه قبل أن يُسأَلَها"],"grade":"صحيح","narrator":"زيد بن خالد الجهني","muhaddith":"صحيح ثابت","takhrij":"أخرجه مسلم (1719) باختلاف يسير","bab":"علم › تعليم الناس وفضل ذلك","dorar":"TmnMpSCk"},{"id":"س-08080","fp":"b7c62209bdfe","stateId":498,"easy":"إذا عاقبت من تحت يدك دون ذنوبهم ← كان فضلاً لك عليهم","cause":"فإنْ كان عِقابُك إيَّاهُم دُونَ ذُنُوبِهمْ","result":"كان فَضْلًا لكَ عليهِم","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح الترغيب 3606","srcLabel":"الترمذي","text":["أنَّ رجلاً مِنْ أصْحابِ رسولهِ الله - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جلسَ بينَ يديْهِ، فقال: يا رسولَ الله! إنَّ لي مَمْلوكين يكذِّبونَني وَيخونونني وَيعْصونَني، وأضْرِبُهم وأشْتُمهمْ، فكيفَ أنا منهم؟ فقالَ له رسولُ الله - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: يُحسَبُ ما خانُوك وعَصَوكَ وكذَّبُوك وعِقابُك إيَّاهُم ، ",["فإنْ كان عِقابُك إيَّاهُم دُونَ ذُنُوبِهمْ",1]," ؛ ",["كان فَضْلًا لكَ ( عليهِم",2]," ) وإنْ كان عِقابُك إيَّاهم بقدرِ ذُنوبِهمْ ؛ كان كَفَافًا ولا لكَ ولا عليكَ ، وإنْْ كان عِقابُك إيَّاهُم فَوقَ ذُنُوبِهِمُ اقْتُصَّ لهمْ مِنكَ الفَضلُ الذِي بَقِيَ قِبَلَكَ فجَعلَ الرجلُ يبْكِي بين يَدَيْ رسولِ اللهِ ويَهتِفُ فقال رسولُ اللهِ مالَكَ ؟ ما تَقرأُ كتابَ اللهِ \"ونَضَعُ الموازِين القِسطَ ليومِ القيامةِ فلا تظلمُ نفسٌ شيئًا وإن كان مثقالَ حبةٍ من خردلِ أتينا بها وكفى بنا حاسِبين\" ؟ فقال الرجلُ يا رسولَ الله ! ما أجِدُ شيئًا خيرًا من فِراقِ هؤلاءِ – يعني عَبِيدَهُ ( إنِّي ) أُشْهِدُكَ أنَّهم كلَّهم أحْرَارٌ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3165)، وأحمد (26401) باختلاف يسير","bab":"مظالم › قصاص المظالم","dorar":"C83DM1UR"},{"id":"س-05994","fp":"62fa2391ca69","stateId":499,"easy":"إذا كنت كتابياً آمنت بنبيك ثم بمحمد ﷺ أو عبداً أدى حق الله ومواليه ← فلك أجرك مرتين","cause":"رَجُلٌ من أهلِ الكتابِ آمَنَ بنَبيِّه، ثم أدَرَكَه النَّبيُّ صلَّى اللهُ عليه وسلَّمَ فآمَنَ به واتَّبعَه، فله أجرانِ، وعبدٌ مملوكٌ يُؤدِّي حقَّ اللهِ تعالى وحقَّ سيِّدِه عليه، فله أجرانِ، ورَجُلٌ له أَمَةٌ فغذَّاها فأحسَنَ غِذاءَها، ثم أدَّبَها فأحسَنَ أدَبَها، ثم أعتَقَها وتزوَّجَها، فله أجرانِ","result":"ثلاثةٌ يُؤتَوْنَ أجْرَهم مرَّتينِ","explicit":true,"star":true,"similar":["س-06806"],"ref":"تخريج مشكل الآثار 1971","srcLabel":"متفق عليه","text":["ثم ذَكَرَ مِثلَه، غيرَ أنَّه قال: ومُؤمِنُ أهلِ الكتابِ، ولم يذكُرْ كلامَ الشَّعْبيِّ الذي في آخِرِه، [يعني حديثَ: أنبَأَنا صالحُ بنُ صالحٍ الهَمْدانيُّ، قال: كنتُ عندَ الشَّعْبيِّ فجاءَه رَجُلٌ من أهلِ خُراسانَ، فقال: يا أبا عَمرٍو، إنَّ مَن قِبَلَنا من أهلِ خُراسانَ يقولونَ: إذا أعتَقَ الرَّجُلُ أَمَتَه ثم تزوَّجَها فهو كالراكبِ بَدَنتَه؟ قال الشَّعْبيُّ: أخبَرَني أبو بُرْدةَ بنُ أبي موسى، عن أبيه أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال: ",["ثلاثةٌ يُؤتَوْنَ أجْرَهم مرَّتينِ",2],":",[" رَجُلٌ من أهلِ الكتابِ آمَنَ بنَبيِّه، ثم أدَرَكَه النَّبيُّ صلَّى اللهُ عليه وسلَّمَ فآمَنَ به واتَّبعَه، فله أجرانِ، وعبدٌ مملوكٌ يُؤدِّي حقَّ اللهِ تعالى وحقَّ سيِّدِه عليه، فله أجرانِ، ورَجُلٌ له أَمَةٌ فغذَّاها فأحسَنَ غِذاءَها، ثم أدَّبَها فأحسَنَ أدَبَها، ثم أعتَقَها وتزوَّجَها، فله أجرانِ",1],"، ثم قال الشَّعْبيُّ للخُراسانيِّ: خُذْ هذا الحديثَ بغيرِ شَيءٍ، فقد كان الرَّجُلُ يرحَلُ إلى المدينةِ فيما هو أَدْنى منه.]"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6294) مختصراً بلفظ مقارب، ومسلم (2016) بلفظ مقارب","bab":"رقائق وزهد › تقوى الله","dorar":"SR134p8c","merged":4,"otherRefs":["صحيح الترمذي 1116 (صحيح)","تخريج المسند لشعيب 19634 (صحيح)","الجامع الصغير 928 (حسن)"]},{"id":"س-06806","fp":"f4e4437b052f","stateId":499,"easy":"إذا كنت كتابياً آمنت بنبيك وبمحمد ﷺ أو مملوكاً أدى حق ربه ومواليه ← فلك أجران","cause":"وأيُّما رَجُلٍ مِن أهلِ الكِتابِ آمَنَ بنَبيِّه وآمَنَ بي","result":"فلَه أجرانِ، وأيُّما مَملوكٍ أدَّى حَقَّ مَواليه وحَقَّ رَبِّه، فلَه أجرانِ","explicit":true,"repOf":"س-05994","ref":"صحيح البخاري 5083","text":["أيُّما رَجُلٍ كانَت عِندَه وليدةٌ، فعَلَّمَها فأحسَنَ تَعليمَها، وأدَّبَها فأحسَنَ تَأديبَها، ثُمَّ أعتَقَها وتَزَوَّجَها؛ فلَه أجرانِ، ",["وأيُّما رَجُلٍ مِن أهلِ الكِتابِ آمَنَ بنَبيِّه وآمَنَ بي، ",1],["فلَه أجرانِ، وأيُّما مَملوكٍ أدَّى حَقَّ مَواليه وحَقَّ رَبِّه، فلَه أجرانِ",2],". وقال أبو بكرٍ عن أبي حَصِينٍ عن أبي بُردةَ عن أبيه، عن النَّبي صلَّى اللهُ عليه وسلَّم: «أعتَقَها ثم أصدَقَها»"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (154) باختلاف يسير","bab":"عتق وولاء › فضل العتق","dorar":"kC1rG6nX","merged":3,"otherRefs":["تفسير الطبري 13/3/300 (صحيح)","تخريج مشكل الآثار 1969 (صحيح)"]},{"id":"س-03186","fp":"4bd8067ca0f6","stateId":499,"easy":"إذا أسلمت من أهل الكتاب ← يؤتك الله أجرك مرتين","cause":"وأَسْلِمْ","result":"يُؤْتِكَ اللَّهُ أجْرَكَ مَرَّتَيْنِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"أضواء البيان 3/577","srcLabel":"أضواء البيان","text":["حديثُ هِرَقلَ لقد أمِر أمرُ ابنِ أبي كَبشةَ إنه لَيَخافُه ملِكُ بني الأصفَرِ [يعني حديث: انْطَلَقْتُ في المُدَّةِ الَّتي كَانَتْ بَيْنِي وبيْنَ رَسولِ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ، قَالَ: فَبيْنَا أنَا بالشَّأْمِ، إذْ جِيءَ بكِتَابٍ مِنَ النبيِّ صَلَّى اللهُ عليه وسلَّمَ إلى هِرَقْلَ ، قَالَ: وكانَ دَحْيَةُ الكَلْبِيُّ جَاءَ به، فَدَفَعَهُ إلى عَظِيمِ بُصْرَى، فَدَفَعَهُ عَظِيمُ بُصْرَى إلى هِرَقْلَ ، قَالَ: فَقَالَ هِرَقْلُ: هلْ هَا هُنَا أحَدٌ مِن قَوْمِ هذا الرَّجُلِ الذي يَزْعُمُ أنَّه نَبِيٌّ؟ فَقالوا: نَعَمْ، قَالَ: فَدُعِيتُ في نَفَرٍ مِن قُرَيْشٍ، فَدَخَلْنَا علَى هِرَقْلَ فَأُجْلِسْنَا بيْنَ يَدَيْهِ، فَقَالَ: أيُّكُمْ أقْرَبُ نَسَبًا مِن هذا الرَّجُلِ الذي يَزْعُمُ أنَّه نَبِيٌّ؟ فَقَالَ أبو سُفْيَانَ: فَقُلتُ: أنَا، فأجْلَسُونِي بيْنَ يَدَيْهِ، وأَجْلَسُوا أصْحَابِي خَلْفِي، ثُمَّ دَعَا بتَرْجُمَانِهِ، فَقَالَ: قُلْ لهمْ: إنِّي سَائِلٌ هذا عن هذا الرَّجُلِ الذي يَزْعُمُ أنَّه نَبِيٌّ، فإنْ كَذَبَنِي فَكَذِّبُوهُ، قَالَ أبو سُفْيَانَ: وايْمُ اللَّهِ ، لَوْلَا أنْ يُؤْثِرُوا عَلَيَّ الكَذِبَ لَكَذَبْتُ، ثُمَّ قَالَ: لِتَرْجُمَانِهِ، سَلْهُ كيفَ حَسَبُهُ فِيكُمْ؟ قَالَ: قُلتُ: هو فِينَا ذُو حَسَبٍ، قَالَ: فَهلْ كانَ مِن آبَائِهِ مَلِكٌ؟ قَالَ: قُلتُ: لَا، قَالَ: فَهلْ كُنْتُمْ تَتَّهِمُونَهُ بالكَذِبِ قَبْلَ أنْ يَقُولَ ما قَالَ؟ قُلتُ: لَا، قَالَ: أيَتَّبِعُهُ أشْرَافُ النَّاسِ أمْ ضُعَفَاؤُهُمْ؟ قَالَ: قُلتُ: بَلْ ضُعَفَاؤُهُمْ، قَالَ: يَزِيدُونَ أوْ يَنْقُصُونَ؟ قَالَ: قُلتُ لا بَلْ يَزِيدُونَ، قَالَ: هلْ يَرْتَدُّ أحَدٌ منهمْ عن دِينِهِ بَعْدَ أنْ يَدْخُلَ فيه سَخْطَةً له؟ قَالَ: قُلتُ: لَا، قَالَ: فَهلْ قَاتَلْتُمُوهُ؟ قَالَ: قُلتُ: نَعَمْ، قَالَ: فَكيفَ كانَ قِتَالُكُمْ إيَّاهُ؟ قَالَ: قُلتُ: تَكُونُ الحَرْبُ بيْنَنَا وبيْنَهُ سِجَالًا يُصِيبُ مِنَّا ونُصِيبُ منه، قَالَ: فَهلْ يَغْدِرُ؟ قَالَ: قُلتُ: لَا، ونَحْنُ منه في هذِه المُدَّةِ لا نَدْرِي ما هو صَانِعٌ فِيهَا، قَالَ: واللَّهِ ما أمْكَنَنِي مِن كَلِمَةٍ أُدْخِلُ فِيهَا شيئًا غيرَ هذِه، قَالَ: فَهلْ قَالَ هذا القَوْلَ أحَدٌ قَبْلَهُ؟ قُلتُ: لَا، ثُمَّ قَالَ لِتُرْجُمَانِهِ: قُلْ له: إنِّي سَأَلْتُكَ عن حَسَبِهِ فِيكُمْ، فَزَعَمْتَ أنَّه فِيكُمْ ذُو حَسَبٍ، وكَذلكَ الرُّسُلُ تُبْعَثُ في أحْسَابِ قَوْمِهَا، وسَأَلْتُكَ: هلْ كانَ في آبَائِهِ مَلِكٌ، فَزَعَمْتَ أنْ لَا، فَقُلتُ: لو كانَ مِن آبَائِهِ مَلِكٌ، قُلتُ: رَجُلٌ يَطْلُبُ مُلْكَ آبَائِهِ، وسَأَلْتُكَ عن أتْبَاعِهِ أضُعَفَاؤُهُمْ أمْ أشْرَافُهُمْ، فَقُلْتَ: بَلْ ضُعَفَاؤُهُمْ، وهُمْ أتْبَاعُ الرُّسُلِ ، وسَأَلْتُكَ: هلْ كُنْتُمْ تَتَّهِمُونَهُ بالكَذِبِ قَبْلَ أنْ يَقُولَ ما قَالَ، فَزَعَمْتَ أنْ لَا، فَعَرَفْتُ أنَّه لَمْ يَكُنْ لِيَدَعَ الكَذِبَ علَى النَّاسِ، ثُمَّ يَذْهَبَ فَيَكْذِبَ علَى اللَّهِ، وسَأَلْتُكَ هلْ يَرْتَدُّ أحَدٌ منهمْ عن دِينِهِ بَعْدَ أنْ يَدْخُلَ فيه سَخْطَةً له، فَزَعَمْتَ أنْ لَا، وكَذلكَ الإيمَانُ إذَا خَالَطَ بَشَاشَةَ القُلُوبِ، وسَأَلْتُكَ هلْ يَزِيدُونَ أمْ يَنْقُصُونَ، فَزَعَمْتَ أنَّهُمْ يُزِيدُونَ وكَذلكَ الإيمَانُ حتَّى يَتِمَّ، وسَأَلْتُكَ: هلْ قَاتَلْتُمُوهُ فَزَعَمْتَ أنَّكُمْ قَاتَلْتُمُوهُ، فَتَكُونُ الحَرْبُ بيْنَكُمْ وبيْنَهُ سِجَالًا يَنَالُ مِنكُم وتَنَالُونَ منه، وكَذلكَ الرُّسُلُ تُبْتَلَى ثُمَّ تَكُونُ لهمُ العَاقِبَةُ، وسَأَلْتُكَ هلْ يَغْدِرُ فَزَعَمْتَ أنَّه لا يَغْدِرُ، وكَذلكَ الرُّسُلُ لا تَغْدِرُ، وسَأَلْتُكَ: هلْ قَالَ أحَدٌ هذا القَوْلَ قَبْلَهُ، فَزَعَمْتَ أنْ لَا، فَقُلتُ: لو كانَ قَالَ هذا القَوْلَ أحَدٌ قَبْلَهُ، قُلتُ: رَجُلٌ ائْتَمَّ بقَوْلٍ قيلَ قَبْلَهُ، قَالَ: ثُمَّ قَالَ: بمَ يَأْمُرُكُمْ؟ قَالَ: قُلتُ: يَأْمُرُنَا بالصَّلَاةِ والزَّكَاةِ والصِّلَةِ والعَفَافِ، قَالَ: إنْ يَكُ ما تَقُولُ فيه حَقًّا، فإنَّه نَبِيٌّ، وقدْ كُنْتُ أعْلَمُ أنَّه خَارِجٌ، ولَمْ أكُ أظُنُّهُ مِنكُمْ، ولو أنِّي أعْلَمُ أنِّي أخْلُصُ إلَيْهِ لَأَحْبَبْتُ لِقَاءَهُ، ولو كُنْتُ عِنْدَهُ لَغَسَلْتُ عن قَدَمَيْهِ، ولَيَبْلُغَنَّ مُلْكُهُ ما تَحْتَ قَدَمَيَّ، قَالَ: ثُمَّ دَعَا بكِتَابِ رَسولِ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ فَقَرَأَهُ: فَإِذَا فيه بسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ مِن مُحَمَّدٍ رَسولِ اللَّهِ إلى هِرَقْلَ عَظِيمِ الرُّومِ ، سَلَامٌ علَى مَنِ اتَّبَعَ الهُدَى، أمَّا بَعْدُ: فإنِّي أدْعُوكَ بدِعَايَةِ الإسْلَامِ، أسْلِمْ تَسْلَمْ، ",["وأَسْلِمْ",1]," ",["يُؤْتِكَ اللَّهُ أجْرَكَ مَرَّتَيْنِ",2],"، فإنْ تَوَلَّيْتَ فإنَّ عَلَيْكَ إثْمَ الأرِيسِيِّينَ ، و: {يَا أهْلَ الكِتَابِ تَعَالَوْا إلى كَلِمَةٍ سَوَاءٍ بيْنَنَا وبيْنَكُمْ، أنْ لا نَعْبُدَ إلَّا اللَّهَ} إلى قَوْلِهِ: {اشْهَدُوا بأنَّا مُسْلِمُونَ} فَلَمَّا فَرَغَ مِن قِرَاءَةِ الكِتَابِ، ارْتَفَعَتِ الأصْوَاتُ عِنْدَهُ وكَثُرَ اللَّغَطُ ، وأُمِرَ بنَا فَأُخْرِجْنَا، قَالَ: فَقُلتُ لأصْحَابِي حِينَ خَرَجْنَا: لقَدْ أمِرَ أمْرُ ابْنِ أبِي كَبْشَةَ، إنَّه لَيَخَافُهُ مَلِكُ بَنِي الأصْفَرِ، فَما زِلْتُ مُوقِنًا بأَمْرِ رَسولِ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ أنَّه سَيَظْهَرُ حتَّى أدْخَلَ اللَّهُ عَلَيَّ الإسْلَامَ، قَالَ الزُّهْرِيُّ: فَدَعَا هِرَقْلُ عُظَمَاءَ الرُّومِ فَجَمعهُمْ في دَارٍ له، فَقَالَ: يا مَعْشَرَ الرُّومِ، هلْ لَكُمْ في الفلاحِ والرَّشَدِ آخِرَ الأبَدِ، وأَنْ يَثْبُتَ لَكُمْ مُلْكُكُمْ، قَالَ: فَحَاصُوا حَيْصَةَ حُمُرِ الوَحْشِ إلى الأبْوَابِ، فَوَجَدُوهَا قدْ غُلِّقَتْ، فَقَالَ: عَلَيَّ بهِمْ، فَدَعَا بهِمْ فَقَالَ: إنِّي إنَّما اخْتَبَرْتُ شِدَّتَكُمْ علَى دِينِكُمْ، فقَدْ رَأَيْتُ مِنْكُمُ الذي أحْبَبْتُ فَسَجَدُوا له ورَضُوا عنْه.]"],"grade":"صحيح","narrator":"[أبو سفيان بن حرب]","muhaddith":"صحيح","bab":"إيمان › دعوة الكافر إلى الإسلام","dorar":"t0gRurVe"},{"id":"س-06301","fp":"65642c1e8fc8","stateId":499,"easy":"إذا أنفقت المرأة على زوجها وأيتام في حجرها ← فلها أجران: القرابة والصدقة","cause":"تعولانِ أزواجَهُما ويتامى في حُجورِهِما","result":"لَهُما أجرانِ أجرُ القرابةِ، وأجرُ الصَّدقةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[37],"ref":"صحيح ابن خزيمة 4/ 180","srcLabel":"ابن خزيمة","text":["أمرَنا رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ بالصَّدقةِ، وقالَ: تصدَّقنَ يا معشرَ النِّساءِ، ولَو من حليِّكنَّ قالت: وَكُنتُ أعولُ عبدَ اللَّهِ، وبَناتي في حِجري، فقلتُ لعبدِ اللَّهِ: ائتِ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ فسَلهُ، هل يَجزي ذلِكَ عَني أن أوجبَهُ عنكُم معَ الصَّدقةِ؟ قالَ: لا بلِ ائتيهِ، فسليهِ قالت: فأتيتُهُ، فجلَستُ عندَ البابِ، وَكانَت قد أُلْقيَت عليهِ المَهابةُ، فوجَدتُ امرأةً منَ الأنصارِ حاجتُها مثلُ حاجتي، فخرجَ علَينا بلالٌ، فقلنا: سَلهُ ولا تحدِّث رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ مَن نحنُ، فقالَ: امرأتانِ ",["تعولانِ أزواجَهُما ويتامى في حُجورِهِما",1],"، أيجزي ذلِكَ عنهما منَ الصَّدقةِ؟ فقالَ لَهُ: من هما؟ قالَ: زينبُ وامرأةٌ منَ الأنصارِ قالَ: أيُّ الزَّيانبِ؟ قالَ: امرأةُ عبدِ اللَّهِ بنِ مسعودٍ، وامرأةٌ منَ الأنصارِ قالَ: نَعم ",["لَهُما أجرانِ أجرُ القرابةِ، وأجرُ الصَّدقةِ",2]," [وفي روايةٍ]: قالَت: أتانا النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ ونحنُ بالمسجدِ، فقالَ: يا معشرَ النِّساءِ تصدَّقنَ، ولَو مِن حليِّكنَّ، ثمَّ ذَكَرَ نحوَهُ معنى واحدٍ"],"grade":"صحيح","narrator":"زينب، امرأة عبدالله بن مسعود","muhaddith":"أخرجه في صحيحه","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"21oxPwLE","merged":4,"otherRefs":["صحيح البخاري 1466 (صحيح)","تفسير القرطبي 10/279 (صحيح)","تخريج المسند لشعيب 16083 (صحيح)"]},{"id":"س-01277","fp":"5b5c38aadede","stateId":499,"easy":"إذا أعتقت جاريتك وتزوجتها ← فلك أجران","cause":"مَن أعتقَ جاريتَهُ وتزوَّجَها","result":"كانَ لَهُ أجرانِ","explicit":true,"star":true,"similar":["س-02881","س-06775"],"ref":"صحيح أبي داود 2053","srcLabel":"متفق عليه","text":[["مَن أعتقَ جاريتَهُ وتزوَّجَها ",1],["كانَ لَهُ أجرانِ",2]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2053) واللفظ له، وأخرجه البخاري (5083)، ومسلم (154) مطولاً","bab":"نكاح › الحث على التزويج","dorar":"ZgOYKzW7","merged":2,"otherRefs":["صحيح النسائي 3345 (صحيح)"]},{"id":"س-02881","fp":"aff2cc1b714b","stateId":499,"easy":"إذا أعتقت أمتك ثم تزوجتها بمهر جديد ← فلك أجران","cause":"إذا أعتَقَ الرَّجُلُ أمَتَه، ثُمَّ تَزوَّجَها بمَهرٍ جَديدٍ","result":"كان له أجْرانِ","explicit":true,"repOf":"س-01277","ref":"تخريج المسند لشعيب 19656","text":[["إذا أعتَقَ الرَّجُلُ أمَتَه، ثُمَّ تَزوَّجَها بمَهرٍ جَديدٍ، ",1],["كان له أجْرانِ",2],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (5083)، ومسلم (154)، والنسائي (3344)، وابن ماجه (1956) مطولاً بنحوه، وأحمد (19656) واللفظ له","bab":"إيمان › الوعد","dorar":"pZXqMreF"},{"id":"س-06775","fp":"114a04f7f5df","stateId":499,"easy":"إذا أعتقت جاريتك ثم تزوجتها ← فلك أجران","cause":"يُعتِقُ جاريَتَه، ثُمَّ يَتَزَوَّجُها","result":"له أجرانِ","explicit":true,"repOf":"س-01277","ref":"صحيح مسلم 154","text":["قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم في الذي ",["يُعتِقُ جاريَتَه، ثُمَّ يَتَزَوَّجُها",1],": ",["له أجرانِ",2],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2544) مطولاً باختلاف يسير","bab":"عتق وولاء › الإحسان إلى العبيد","dorar":"J1QrsDcM"},{"id":"س-06777","fp":"507ce68a503d","stateId":499,"easy":"إذا كانت لك جارية فأحسنت إليها ثم أعتقتها وتزوجتها ← فلك أجران","cause":"مَن كانَت له جاريةٌ فَعالَها فأحسَنَ إليها، ثُمَّ أعتَقَها وتَزَوَّجَها","result":"كان له أجرانِ","explicit":true,"star":true,"similar":["س-06790","س-06805"],"ref":"صحيح البخاري 2544","srcLabel":"متفق عليه","text":[["مَن كانَت له جاريةٌ فَعالَها فأحسَنَ إليها، ثُمَّ أعتَقَها وتَزَوَّجَها، ",1],["كان له أجرانِ",2],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2544)، ومسلم (154)","bab":"عتق وولاء › الإحسان إلى العبيد","dorar":"Zx6VLMpw"},{"id":"س-06790","fp":"2c12832701ae","stateId":499,"easy":"إذا أدّبت أمتك وعلّمتها فأحسنت ثم أعتقتها وتزوجتها ← فلك أجران","cause":"إذا أدَّبَ الرَّجُلُ أمَتَه فأحسَنَ تَأديبَها، وعَلَّمَها فأحسَنَ تَعليمَها، ثُمَّ أعتَقَها فتَزَوَّجَها","result":"كان له أجرانِ، وإذا آمَنَ بعيسى، ثُمَّ آمَنَ بي، فلَه أجرانِ، والعَبدُ إذا اتَّقى رَبَّه وأطاعَ مَواليَه فلَه أجرانِ","explicit":true,"repOf":"س-06777","ref":"صحيح البخاري 3446","text":[["إذا أدَّبَ الرَّجُلُ أمَتَه فأحسَنَ تَأديبَها، وعَلَّمَها فأحسَنَ تَعليمَها، ثُمَّ أعتَقَها فتَزَوَّجَها، ",1],["كان له أجرانِ، وإذا آمَنَ بعيسى، ثُمَّ آمَنَ بي، فلَه أجرانِ، والعَبدُ إذا اتَّقى رَبَّه وأطاعَ مَواليَه فلَه أجرانِ",2],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3446)، ومسلم (154)","bab":"عتق وولاء › فضل العتق","dorar":"TsFutkyo"},{"id":"س-06805","fp":"b3cfc7856a4b","stateId":499,"easy":"إذا علّمت جاريتك وأدّبتها فأحسنت ثم أعتقتها وتزوجتها ← فلك أجران","cause":"أيُّما رَجُلٍ كانَت عِندَه وليدةٌ، فعَلَّمَها فأحسَنَ تَعليمَها، وأدَّبَها فأحسَنَ تَأديبَها، ثُمَّ أعتَقَها وتَزَوَّجَها","result":"فلَه أجرانِ","explicit":true,"repOf":"س-06777","ref":"صحيح البخاري 5083","text":[["أيُّما رَجُلٍ كانَت عِندَه وليدةٌ، فعَلَّمَها فأحسَنَ تَعليمَها، وأدَّبَها فأحسَنَ تَأديبَها، ثُمَّ أعتَقَها وتَزَوَّجَها؛ ",1],["فلَه أجرانِ، ",2],"وأيُّما رَجُلٍ مِن أهلِ الكِتابِ آمَنَ بنَبيِّه وآمَنَ بي، فلَه أجرانِ، وأيُّما مَملوكٍ أدَّى حَقَّ مَواليه وحَقَّ رَبِّه، فلَه أجرانِ. وقال أبو بكرٍ عن أبي حَصِينٍ عن أبي بُردةَ عن أبيه، عن النَّبي صلَّى اللهُ عليه وسلَّم: «أعتَقَها ثم أصدَقَها»"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (154) باختلاف يسير","bab":"عتق وولاء › فضل العتق","dorar":"kC1rG6nX","merged":2,"otherRefs":["تخريج مشكل الآثار 1969 (صحيح)"]},{"id":"س-04364","fp":"87fb850c122f","stateId":499,"easy":"إذا كنت عبداً مملوكاً مصلحاً ← فلك أجران","cause":"للعَبدِ المَملوكِ المُصلِحِ","result":"أجرانِ","explicit":true,"star":true,"ref":"صحيح مسلم 1665","srcLabel":"متفق عليه","text":[["للعَبدِ المَملوكِ المُصلِحِ",1]," ",["أجرانِ",2],". والذي نَفسُ أبي هُرَيرةَ بيَدِه، لَولا الجِهادُ في سَبيلِ اللهِ، والحَجُّ، وبرُّ أُمِّي، لأحبَبتُ أن أموتَ وأنا مَملوكٌ. قال: وبَلَغَنا أنَّ أبا هُرَيرةَ لَم يَكُنْ يَحُجُّ حتَّى ماتَت أُمُّه لصُحبَتِها. قال أبو الطَّاهِرِ في حَديثِه: للعَبدِ المُصلِحِ، ولَم يَذكُرِ المَملوك."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2548)، ومسلم (1665).","bab":"جهاد › الترغيب في الجهاد","dorar":"BTwBf45N","merged":5,"otherRefs":["تخريج المسند لشعيب 7428 (صحيح)","صحيح الأدب المفرد 152 (صحيح)","صحيح البخاري 2551 (صحيح)","تخريج مشكل الآثار 1969 (صحيح)"]},{"id":"س-02214","fp":"02c3fd9ef6c8","stateId":499,"easy":"إذا تصدقت المرأة على زوجها وأيتام في حجرها ← فلها أجران: أجر القرابة وأجر الصدقة","cause":"أتُجزِئُ الصَّدَقةُ عنهما على أزواجِهما، وعلى أيتامٍ في حُجورِهما","result":"لهما أجرانِ: أجرُ القَرابةِ، وأجرُ الصَّدَقةِ","explicit":true,"otherNeedIds":[37],"ref":"صحيح مسلم 1000","srcLabel":"متفق عليه","text":["تَصَدَّقنَ يا مَعشَرَ النِّساءِ، ولو مِن حُليِّكُنَّ، قالت: فرَجَعتُ إلى عبدِ اللهِ فقُلتُ: إنَّك رَجُلٌ خَفيفُ ذاتِ اليَدِ، وإنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قد أمَرَنا بالصَّدَقةِ، فأْتِه فاسأَلْه، فإن كانَ ذلك يَجزي عَنِّي وإلَّا صَرَفتُها إلى غيرِكُم، قالت: فقال لي عبدُ اللهِ: بَلِ ائتيه أنتِ، قالت: فانطَلَقتُ، فإذا امرَأةٌ مِنَ الأنصارِ ببابِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم حاجَتي حاجَتُها، قالت: وكانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم قد أُلقيَت عليه المَهابةُ، قالت: فخَرَجَ علينا بلالٌ فقُلنا له: ائتِ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فأخبِرْه أنَّ امرَأتَينِ بالبابِ تَسألانِك: ",["أتُجزِئُ الصَّدَقةُ عنهما على أزواجِهما، وعلى أيتامٍ في حُجورِهما",1],"؟ ولا تُخبِرْه مَن نَحنُ، قالت: فدَخَلَ بلالٌ على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم فسَألَه، فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: مَن هُما؟ فقال: امرَأةٌ مِنَ الأنصارِ وزَينَبُ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أيُّ الزَّيانِبِ؟ قال: امرَأةُ عبدِ اللهِ، فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["لهما أجرانِ: أجرُ القَرابةِ، وأجرُ الصَّدَقةِ",2],". [وفي روايةٍ]: تَصَدَّقنَ، ولو مِن حُليِّكُنَّ، وساقَ الحَديثَ."],"grade":"صحيح","narrator":"زينب امرأة عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1466)، ومسلم (1000).","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Q3ZhWrf5","merged":2,"otherRefs":["تخريج المسند لشعيب 27048 (صحيح)"]},{"id":"س-02875","fp":"26b0fa95e4eb","stateId":499,"easy":"إذا أطاع العبد ربه وسيده ← فله أجران","cause":"إذا أَطاعَ العبدُ ربَّه وسيِّدَه","result":"فله أجرانِ","explicit":true,"similar":["س-02034","س-02112"],"ref":"تخريج المسند لشعيب 8537","srcLabel":"مسلم","text":[["إذا أَطاعَ العبدُ ربَّه وسيِّدَه ",1],["فله أجرانِ",2],". قال: فلمَّا أُعتِقَ أبو رافعٍ بَكَى، فقيلَ له: ما يُبْكيكَ؟ قال: كان لي أجرانِ فذهَبَ أحدُهما."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (1666) بنحوه، وأحمد (8537) واللفظ له","bab":"إيمان › الوعد","dorar":"N27iVIzh","merged":3,"otherRefs":["تخريج المسند لشعيب 10298 (صحيح)","تخريج المسند لشعيب 9992 (صحيح)"]},{"id":"س-02034","fp":"fba2f74f80ba","stateId":499,"easy":"إذا نصح العبد سيده وأحسن عبادة ربه ← فله أجره مرتين","cause":"العَبدُ إذا نَصَحَ سَيِّدَه، وأحسَنَ عِبادةَ رَبِّه","result":"كان له أجرُه مَرَّتَينِ","explicit":true,"repOf":"س-02875","ref":"صحيح البخاري 2546","text":[["العَبدُ إذا نَصَحَ سَيِّدَه، وأحسَنَ عِبادةَ رَبِّه",1],"، ",["كان له أجرُه مَرَّتَينِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2546)، ومسلم (1664)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"pSt94PLf"},{"id":"س-02112","fp":"d99e74a9c9fc","stateId":499,"easy":"إذا نصح العبد لسيده وأحسن عبادة ربه ← فله أجران","cause":"إذا نَصَحَ العبدُ لسيِّدِه، وأحسَنَ عِبادَةَ رَبِّه","result":"كان له من الأجْرِ مرَّتَينِ","explicit":true,"repOf":"س-02875","ref":"تخريج المسند لشعيب 5784","text":[["إذا نَصَحَ العبدُ لسيِّدِه، وأحسَنَ عِبادَةَ رَبِّه، ",1],["كان له من الأجْرِ مرَّتَينِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (2550)، ومسلم (1664)، وأبو داود (5169)، وأحمد (5784) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"9ytYMHTH"},{"id":"س-02168","fp":"926ca80800f9","stateId":499,"easy":"إذا أطعت الله وأديت حق سيدك ← فنعمّا لك","cause":"أنْ يُطِيعَ اللهَ ، ويُؤَدِّيَ حقَّ سيدِه","result":"نِعِمَّا لِأَحَدِهمْ","explicit":true,"star":true,"ref":"صحيح الترغيب 1884","srcLabel":"متفق عليه","text":[["نِعِمَّا لِأَحَدِهمْ",2]," ",["أنْ يُطِيعَ اللهَ ، ويُؤَدِّيَ حقَّ سيدِه",1]," . يعني المَمْلوكَ ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1985) واللفظ له، وأخرجه البخاري (2549) باختلاف يسير، ومسلم (1667) بنحوه","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"ZSDamoIe"},{"id":"س-02238","fp":"2469f052941c","stateId":499,"easy":"إذا أحسنت عبادة ربك ونصحت لسيدك ← فنعمّا لك","cause":"يُحْسِنُ عبادَةَ ربِّهِ وينصحُ لسيدِهِ","result":"نِعِّمَّا له","explicit":true,"ref":"صحيح الجامع 6777","srcLabel":"متفق عليه","text":["نِعِمَّا لِمَمْلُوكٍ يُتَوَفَّى ",["يُحْسِنُ عبادَةَ ربِّهِ وينصحُ لسيدِهِ",1]," ، ",["نِعِّمَّا له",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (2549) بنحوه، ومسلم (1667) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"yYET97WS"},{"id":"س-02114","fp":"31c43e531e6e","stateId":499,"easy":"إذا توفيت وأنت عبد تحسن عبادة الله وصحبة سيدك ← فنعمّا لك","cause":"أنْ يُتَوَفَّى بِحُسنِ عِبادَةِ اللهِ وصَحابَةِ سَيِّدِه","result":"نِعِمَّا له","explicit":true,"ref":"تخريج المسند لشعيب 8233","srcLabel":"مسلم","text":["نِعِمَّا لِلمَمْلوكِ ",["أنْ يُتَوَفَّى بِحُسنِ عِبادَةِ اللهِ وصَحابَةِ سَيِّدِه",1],"، ",["نِعِمَّا له",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (1667)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"5wrHG55H"},{"id":"س-07291","fp":"d77a022bf33a","stateId":500,"easy":"إذا أخذت بالأيسر ← فخير دينكم أيسره","cause":"أيسَرُه","result":"خيرُ دينِكم","explicit":true,"star":true,"ref":"مجمع الزوائد 9/362","srcLabel":"البخاري","text":["أخَذ النَّبيُّ صلَّى اللهُ عليه وسلَّم بيدي حتَّى صعِد أُحُدًا ثمَّ أشرَف على المدينةِ فقال وَيحُ أُمِّها قريةً يدَعُها أهلُها أَعْمَرَ ما تكونُ يأتيها الدَّجَّالُ فيجِدُ على كل نَقْبٍ مِن أنقابِها مَلَكًا مُصْلِتًا ثمَّ انحدَر حتَّى أتى المسجدَ فإذا هو برجلٍ قائمٍ يُصَلِّي فقال تُراه عبدَ اللهِ بنَ قَيسٍ إنَّه لأوَّاهٌ حليمٌ قلْتُ يا رسولَ اللهِ ألَا أُبَشِّرُه قال احذَرْ لا تُسْمِعْه فتُهْلِكَه ثمَّ انحدَر فلمَّا انتهَيْنا إلى المسجدِ فوجَدْنا بُرَيدةَ الأسلميَّ على بابٍ مِن أبوابِ المسجدِ وكان في المسجدِ رجلٌ يُطيلُ الصَّلاةَ وكان بُرَيدةُ صاحبَ مُزاحاتٍ فقال يا مِحْجَنُ ألا تُصَلِّي كما يُصَلِّي سَكَبةُ فلم يرُدَّ عليه شيئًا ورجَع فلمَّا أتى بيتَه قال خيرُ دينِنا ",["أيسَرُه",1]," ",["خيرُ دينِكم",2]," أيسَرُه خيرُ دينِكم أيسَرُه خيرُ دينِكم أيسَرُه"],"grade":"صحيح","narrator":"محجن بن الأدرع","muhaddith":"رجاله رجال الصحيح غير رجاء بن أبي رجاء وقد وثقه ابن حبان","takhrij":"أخرجه  الطبراني (20/ 296)\n) (704) واللفظ له، وأحمد (18976) والبخاري في ((الأدب المفرد)) (341)  بنحوه","bab":"فتن › ظهور الفتن","dorar":"M9nHRVvb","merged":7,"otherRefs":["إتحاف الخيرة المهرة 1/111 (صحيح)","إتحاف الخيرة المهرة 1/112 (صحيح)","فتح الباري لابن حجر 1/116 (صحيح)","عمدة التفسير 1/223 (صحيح)","تخريج المسند لشعيب 20349 (حسن)","مجمع الزوائد 3/311 (صحيح)"]},{"id":"ق-0378","fp":"9a0befb77d5d","stateId":500,"easy":"العمل ← درجات بحسبه","cause":"العمل","result":"درجات بحسبه","explicit":true,"star":true,"similar":["ق-1196"],"ref":"سورة الأنعام: 132","srcLabel":"القرآن الكريم","quran":{"s":6,"from":132,"to":132,"text":"وَلِكُلٍّ دَرَجَاتٌ مِمَّا عَمِلُوا وَمَا رَبُّكَ بِغَافِلٍ عَمَّا يَعْمَلُونَ (132)","hl":[[0,35,1]]}},{"id":"ق-1196","fp":"1cdca54e22e2","stateId":500,"easy":"العمل ← درجات بحسبه وتوفية بلا ظلم","cause":"العمل","result":"درجات بحسبه وتوفية بلا ظلم","explicit":true,"repOf":"ق-0378","ref":"سورة الأحقاف: 19","quran":{"s":46,"from":19,"to":19,"text":"وَلِكُلٍّ دَرَجَاتٌ مِمَّا عَمِلُوا وَلِيُوَفِّيَهُمْ أَعْمَالَهُمْ وَهُمْ لَا يُظْلَمُونَ (19)","hl":[[0,90,1]]}},{"id":"س-01270","fp":"05fa78fe040f","stateId":500,"easy":"إذا أتيت الحلال ← فهو من أماثل أعمالك","cause":"فأتَيْتُ بعضَ أَزْواجي فأصَبْتُها، فكذلك فافْعَلوا","result":"فإنَّه من أماثِلِ أعمالِكم إتيانُ الحَلالِ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[20],"ref":"تخريج المسند لشعيب 29/ 557","srcLabel":"أحمد","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ جالِسًا في أصحابِه فدخَلَ، ثُم خرَجَ وقدِ اغتسَلَ، فقُلْنا: يا رسولَ اللهِ، قد كان شيءٌ، قال: أجَلْ، مرَّتْ بي فُلانةُ، فوقَعَ في قَلْبي شَهوةُ النساءِ، ",["فأتَيْتُ بعضَ أَزْواجي فأصَبْتُها، فكذلك فافْعَلوا",1],"؛ ",["فإنَّه من أماثِلِ أعمالِكم إتيانُ الحَلالِ",2],"."],"grade":"صحيح","narrator":"أبو كبشة الأنماري","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد بعد حديث (18027) واللفظ له، والطبراني (22/338) (848)، وأبو نعيم في ((حلية الأولياء)) (2/20)","bab":"نكاح › الحث على التزويج","dorar":"nIIBYS9h"},{"id":"س-01895","fp":"adc5ade3b8c6","stateId":500,"easy":"إذا عملت بيدك في دارك ← فأنت عامل من عمال الله (أثر)","cause":"عمل مع عمَّاله في دارِه","result":"كان عاملًا من عمَّالِ اللهِ عزَّ وجلَّ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"صحيح الأدب المفرد 349","srcLabel":"البخاري","text":["قال عبدُ اللهِ بنُ عَمرو لابنِ أخٍ له أيَعملُ عمَّالُك ؟ قال : لا أدري ! قال : أما لو كنتَ ثَقَفِيًّا لعلمتَ ما يعملُ عُمَّالك ، ثم التفت إلينا فقال : إنَّ الرجلَ إذا ",["عمل مع عمَّاله في دارِه",1]," ( وقال أبو عاصم مرة : في ماله ) ",["كان عاملًا من عمَّالِ اللهِ عزَّ وجلَّ",2]],"grade":"صحيح","narrator":"نافع بن عاصم","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (448) بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"YexDhQsI"},{"id":"س-06646","fp":"17b254b2c402","stateId":500,"easy":"إذا شحب وجهك أو اغبرّت قدمك في عمل تبتغي به الجنة ← فهو كالجهاد في سبيل الله","cause":"كَجِهادٍ في سَبيلِ اللهِ عَزَّ وجَلَّ","result":"ما شَحُبَ وجهٌ ولا اغبَرَّت قدَمٌ في عَمَلٍ تُبتَغى به دَرَجاتُ الجَنَّةِ بَعدَ الصَّلاةِ المَفروضةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"مشارع الأشواق 346","srcLabel":"أحمد","text":["والذي نَفسُ مُحَمَّدٍ بيَدِه ",["ما شَحُبَ وجهٌ ولا اغبَرَّت قدَمٌ في عَمَلٍ تُبتَغى به دَرَجاتُ الجَنَّةِ بَعدَ الصَّلاةِ المَفروضةِ",2],"، ",["كَجِهادٍ في سَبيلِ اللهِ عَزَّ وجَلَّ",1],"، ولا ثَقُلَ ميزانُ عَبدٍ كَدابَّةٍ تُنفَقُ له في سَبيلِ اللهِ أو يُحمَلُ عليها في سَبيلِ اللهِ عَزَّ وجَلَّ"],"grade":"حسن","narrator":"معاذ بن جبل","muhaddith":"إسناده حسن","takhrij":"أخرجه عبد بن حميد (113)، وأبو الفرج المقرئ في ((الأربعين)) (9) بلفظه، وأحمد (22122) مطولا.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"Fdi77gbH"},{"id":"س-00862","fp":"81a8d42ea8c5","stateId":501,"easy":"إذا طال عمرك في الإسلام تسبح وتكبر وتهلل ← فلا أحد أفضل عند الله منك","cause":"مُؤمِنٍ يُعمَّرُ في الإسْلامِ لتَسْبيحِه وتَكْبيرِه وتَهْليلِه","result":"ليس أحَدٌ أَفضَلَ عنْدَ اللهِ مِن","explicit":true,"star":true,"otherNeedIds":[36],"ref":"الأحاديث المختارة 830","srcLabel":"البخاري","text":["«أنَّ نَفَرًا مِن بَني عُذْرةَ ثَلاثةً أَتَوا النَّبيَّ صلَّى اللهُ عليه وسلَّمَ فأَسْلَموا، قالَ: فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: مَن يَكْفيهم؟ قالَ طَلْحةُ: أنا، قالَ: فكانوا عنْدَ طَلْحةَ، فبَعَثَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ بَعْثًا، فخَرَجَ فيه أحَدُهم فاسْتُشْهِدَ، قالَ: ثُمَّ بَعَثَ بَعْثًا فخَرَجَ فيهم آخَرُ فاسْتُشْهِدَ، قالَ: ثُمَّ ماتَ الثَّالِثُ على فِراشِه، قالَ: قالَ طَلْحةُ: فرَأيْتُ هؤلاء الثَّلاثةَ الَّذين كانوا عنْدي في الجنَّةِ، فرَأيْتُ المَيِّتَ على فِراشِه أمامَهم، ورَأيْتُ الَّذي اسْتُشْهِدَ أخيرًا يَليه، ورَأيْتُ الَّذي اسْتُشْهِدَ أَوَّلَهم آخِرَهم، قالَ: فدَخَلَني مِن ذلك، قالَ: فأتَيْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ فذَكَرْتُ ذلك له، قالَ: فقالَ: وما أَنْكَرْتَ مِن ذلك؟ ",["ليس أحَدٌ أَفضَلَ عنْدَ اللهِ مِن",2]," ",["مُؤمِنٍ يُعمَّرُ في الإسْلامِ لتَسْبيحِه وتَكْبيرِه وتَهْليلِه",1],"»."],"grade":"صحيح","narrator":"عبد الله بن شداد","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"zj5TYD9o"},{"id":"س-00548","fp":"4fb893340630","stateId":501,"easy":"إذا عشت بعد أخيك أربعين ليلة تصلي ← فما يُدريك ما بلغت بك صلاتك","cause":"ثمَّ عُمِّرَ الآخرُ بعدَهُ أربَعينَ ليلةً","result":"فما يُدريكُم ماذا بلغَت بِهِ صلاتُهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"صحيح ابن خزيمة 1/ 413","srcLabel":"ابن خزيمة","text":["سَمِعْتُ سعدًا وَناسًا مِن أصحابِ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولونَ: كانَ رجلانِ أخَوانِ في عَهْدِ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ، وَكانَ أحدُهُما أفضلَ منَ الآخرِ، فتوُفِّيَ الَّذي هوَ أفضلُهُما، ",["ثمَّ عُمِّرَ الآخرُ بعدَهُ أربَعينَ ليلةً",1]," ثمَّ توُفِّيَ، فذُكِرَ لرَسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فضيلةُ الأوَّلِ على الآخَرِ، فقالَ: ألم يَكُن يصلِّي؟ قالوا: بلَى يا رسولَ اللَّهِ، وَكانَ لا بأسَ بِهِ قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: ",["فما يُدريكُم ماذا بلغَت بِهِ صلاتُهُ",2],"؟ إنَّما مَثلُ الصَّلاةِ كمَثلِ نَهَرٍ جارٍ ببابِ رجلٍ غَمرٍ عذبٍ يقتحمُ فيهِ كلَّ يومٍ خمسَ مرَّاتٍ فما ترونَ ذلِكَ يُبقي مِن درنِهِ لا تَدرونَ ماذا بلغَت بِهِ صلاتُهُ"],"grade":"صحيح","narrator":"سعد بن أبي وقاص وناس من أصحاب رسول الله","muhaddith":"أخرجه في صحيحه","bab":"آداب عامة › ضرب الأمثال","dorar":"b4WGGPe6"},{"id":"س-03297","fp":"fd47fa9458e3","stateId":501,"easy":"إذا شبت في الإسلام شيبة ← يرفعك الله بها درجة وتُمحى سيئة وتُكتب حسنة","cause":"ما شابَ رجلٌ في الإسلامِ شيبةً","result":"إلَّا رفعَهُ اللَّهُ بِها دَرجةً ومُحِيَت عنهُ بِها سيِّئةٌ وَكُتِبَت لَهُ بِها حسنةٌ","explicit":true,"star":true,"otherNeedIds":[11,45,65],"ref":"تخريج المسند لشاكر 11/143","srcLabel":"أبو داود","text":["نَهَى رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ عن نَتفِ الشَّيبِ وقالَ : هوَ نورُ المؤمنِ وقالَ ",["ما شابَ رجلٌ في الإسلامِ شيبةً",1]," ",["إلَّا رفعَهُ اللَّهُ بِها دَرجةً ومُحِيَت عنهُ بِها سيِّئةٌ وَكُتِبَت لَهُ بِها حسنةٌ",2]],"grade":"صحيح","narrator":"[جد عمرو بن شعيب]","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6937) واللفظ له، وأبو داود (4202) بنحوه، والترمذي (2821) مختصرا.","bab":"استغفار › أسباب المغفرة","dorar":"NrlcbTZo","merged":2,"otherRefs":["تخريج المسند لشاكر 11/160 (صحيح)"]},{"id":"س-06589","fp":"4a31b35fe04e","stateId":501,"easy":"إذا عشت سنة بعد أخيك فصمت وصليت ← فما بينكما أبعد مما بين السماء والأرض","cause":"قد مَكَثَ هذا بعدَهُ سَنَةً قالوا بلى قال وأَدْرَكَ رَمَضَانَ فَصامَ وصلَّى كذا وكذا من سَجْدَةٍ في السَّنَةِ","result":"فما بينَهُما أَبْعَدُ مِمَّا بين السَّماءِ والأرضِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[36],"ref":"صحيح ابن ماجه 3185","srcLabel":"أحمد","text":["أنَّ رَجُلَيْنِ من بَلِيٍّ قَدِما على رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ وكان إِسْلامُهُما جَمِيعًا فكانَ أحدُهُما أَشَدَّ اجْتِهادًا مِنَ الآخَرِ فَغَزَا المُجْتَهِدُ مِنْهُما فَاسْتُشْهِدَ ثُمَّ مَكَثَ الآخَرُ بعدَهُ سَنَةً ثُمَّ تُوُفِّيَ قال طلحةُ فَرأيْتُ في المنامِ بَيْنا أنا عندَ بابِ الجنةِ إذا أنا بِهما فَخَرَجَ خَارِجٌ مِنَ الجنةِ فَأَذِنَ لِلَّذِي تُوُفِّيَ الآخِرَ مِنْهُما ثُمَّ خرجَ فَأَذِنَ لِلَّذِي اسْتُشْهِدَ ثُمَّ رجعَ إِلَيَّ فقال ارْجِعْ فإنَّكَ لمْ يَأْنِ لكَ بَعْدُ فَأصبحَ طلحةُ يُحَدِّثُ بهِ الناسَ فَعَجِبُوا لِذلكَ فَبَلَغَ ذلكَ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ وحَدَّثُوهُ الحَدِيثَ فقال من أَيِّ ذلكَ تَعْجَبُونَ فَقَالوا يا رسولَ اللهِ هذا كان أَشَدَّ الرجلَيْنِ اجْتِهادًا ثُمَّ اسْتُشْهِدَ، ودخلَ هذا الآخِرُ الجنةَ قبلَهُ فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ أَليسَ ",["قد مَكَثَ هذا بعدَهُ سَنَةً قالوا بلى قال وأَدْرَكَ رَمَضَانَ فَصامَ وصلَّى كذا وكذا من سَجْدَةٍ في السَّنَةِ",1]," قالوا بلى قال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ",["فما بينَهُما أَبْعَدُ مِمَّا بين السَّماءِ والأرضِ",2]],"grade":"صحيح","narrator":"طلحة بن عبيدالله","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجة (3925) واللفظ له، وأحمد (1403)، وابن حبان (2982) باختلاف يسير","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"30qLhhBJ","merged":6,"otherRefs":["صحيح ابن حبان 2982 (صحيح)","صحيح الجامع 1316 (صحيح)","تخريج مشكل الآثار 2313 (صحيح)","صحيح الترغيب 371 (صحيح)","مجموع الشروح الفقهية. 51/19 (حسن)"]},{"id":"س-06482","fp":"a23b3096510c","stateId":501,"easy":"إذا عشت بعد أخيك فصمت وصليت ← قد تسبق الشهيد بعملك","cause":"قد صام بعدَه رمضانَ، وصلى ستةَ آلافِ ركعةٍ، أو كذا وكذا ركعةً صلاةَ السَّنَةِ","result":"فرأيْتُ المؤخَّرَ منهما، أُدخل قبل الشهيدِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[36],"ref":"تخريج المسند لشاكر 16/170","srcLabel":"أحمد","text":["كان رجلانِ من بَلِيٍّ حَيٍّ  من قُضاعةَ أسلَما مع النبيِّ صلَى اللهُ عَليهِ وسلمَ، واستُشهد أحدُهما، وأُخِّر الآخَرُ سَنَةً، قال طَلْحَةُ بنُ عُبَيْدِ اللهِ: فأُريتُ الجَنَّةَ، ",["فرأيْتُ المؤخَّرَ منهما، أُدخل قبل الشهيدِ",2],"، فتعجبتُ لذلك، فأصبحْتُ، فذكرْتُ ذلكَ لِلنَّبِيِّ صلَّى اللهُ عليهِ وسلَّمَ، أو ذُكر  ذلِك لرسولِ الله صلَّى اللهُ عليهِ وسلَّمَ، فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ: أليسَ ",["قد صام بعدَه رمضانَ، وصلى ستةَ آلافِ ركعةٍ، أو كذا وكذا ركعةً صلاةَ السَّنَةِ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (8399) واللفظ له، والبزار (929)، والعقيلي في ((الضعفاء الكبير)) (4/149)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"kHheLmoY","merged":2,"otherRefs":["الأحاديث المختارة 826 (صحيح)"]},{"id":"س-01586","fp":"8acc962b2b44","stateId":502,"easy":"إذا ضحّيت ← فلك بكل شعرة حسنة","cause":"الأضاحي","result":"بكُلِّ شَعرةٍ حسنةٌ","explicit":true,"ref":"المستدرك على الصحيحين 3512","srcLabel":"ابن ماجه","text":["قُلنا: يا رسولَ اللهِ، ما هذه ",["الأضاحي",1],"؟ قالَ: «سُنَّةُ أبيكُم إبراهيمَ». قالَ: قُلنا: فما لنا مِنْها؟ قالَ: «",["بكُلِّ شَعرةٍ حسنةٌ",2],"». قُلنا: يا رسولَ اللهِ، فالصُّوفُ؟ قالَ: «فكُلُّ شَعرةٍ مِنَ الصُّوفِ حسنةٌ»."],"grade":"صحيح","narrator":"زيد بن أرقم","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن ماجه (3127)، وأحمد (19283) بلفظه.","bab":"أضاحي › سنة الأضحية","dorar":"GyrDS4xC"},{"id":"س-01587","fp":"4ee4e4473361","stateId":502,"easy":"إذا وجّهت أضحيتك إلى القبلة ← يكون دمها وفرثها وصوفها حسنات في ميزانك","cause":"ما من عبدٍ توجَّهَ بأُضْحيَتِهِ إلى القبلةِ","result":"إلَّا كانَ دمُها وفرثُها وصوفُها حسَناتٍ مُحضراتٍ في ميزانِهِ يومَ القيامةِ فإنَّ الدَّمَ وإن وقعَ في التُّرابِ فإنَّما يقعُ في حِرزِ اللَّهِ حتَّى يوفيَهُ صاحبَهُ يومَ القيامةِ","explicit":true,"otherNeedIds":[65,31],"ref":"التمهيد 23/193","srcLabel":"عبد الرزاق","text":["عن عائشةَ قالَت يا أيُّها النَّاسُ ضحُّوا وطيبوا بِها أنفُسًا فإنِّي سَمِعْتُ رسول اللَّه صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ ",["ما من عبدٍ توجَّهَ بأُضْحيَتِهِ إلى القبلةِ",1]," ",["إلَّا كانَ دمُها وفرثُها وصوفُها حسَناتٍ مُحضراتٍ في ميزانِهِ يومَ القيامةِ فإنَّ الدَّمَ وإن وقعَ في التُّرابِ فإنَّما يقعُ في حِرزِ اللَّهِ حتَّى يوفيَهُ صاحبَهُ يومَ القيامةِ",2]],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"حسن","takhrij":"أخرجه عبد الرزاق (8167)، والخطيب في ((موضح الأوهام)) (2/ 274) باختلاف يسير.","bab":"أضاحي › سنة الأضحية","dorar":"mhxtETuX"},{"id":"س-01937","fp":"b25031ac0cab","stateId":502,"easy":"إذا ضحيت بالأغلى والأسمن ← فهي أفضل الأضاحي","cause":"أغلاهَا و أسمنُها","result":"إنَّ أفضلَ الضحايا","explicit":true,"star":true,"ref":"الجامع الصغير 2205","srcLabel":"أحمد","text":[["إنَّ أفضلَ الضحايا",2]," ",["أغلاهَا و أسمنُها",1]],"grade":"صحيح","narrator":"رجل","muhaddith":"صحيح","takhrij":"أخرجه أحمد (15494)، والحاكم (7561)، وابن سعد في ((الطبقات الكبرى)) (7/ 423) واللفظ لهم جميعا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Lhkh5lLq"},{"id":"س-02178","fp":"6f2b9e8c2834","stateId":502,"easy":"إذا ضحيت بالبيضاء (العفراء) ← فهي أزكى عند الله","cause":"دمُ عفْراءَ","result":"أزْكَى عند اللهِ من دَمِ سَوْدَاوَيْنِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"صحيح الجامع 3392","srcLabel":"الطبراني","text":[["دمُ عفْراءَ",1]," ",["أزْكَى عند اللهِ من دَمِ سَوْدَاوَيْنِ",2]],"grade":"حسن","narrator":"[كبيرة] بنت سفيان","muhaddith":"حسن","takhrij":"أخرجه أبو نعيم في ((معرفة الصحابة)) (7822) بلفظه تامًا، والطبراني في ((المعجم الكبير)) (25/ 15) (9) باختلاف يسير تامًا، وابن أبي خيثمة في ((تاريخه-السفر الثاني)) (3602) بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"ocn6ouLq"},{"id":"س-03829","fp":"2bceb1a6a028","stateId":502,"easy":"إذا ضحيت ← فلا نفقة بعد صلة الرحم أعظم من إهراق الدم","cause":"إِهْراقِ الدَّمِ","result":"ما من نفقَةٍ بعدَ صلةِ الرَّحمِ أعظمُ عندَ اللَّهِ من","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[45],"ref":"التمهيد 23/192","srcLabel":"مالك","text":[["ما من نفقَةٍ بعدَ صلةِ الرَّحمِ أعظمُ عندَ اللَّهِ من",2]," ",["إِهْراقِ الدَّمِ",1]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن","takhrij":"أخرجه ابن المظفر في ((غرائب مالك)) (30)، والخطيب البغدادي في ((تاريخ بغداد)) ( 3/ 272)، وابن عبد البر في ((الاستذكار)) (5/ 230)،  وابن أبي يعلى في ((طبقات الحنابلة)) (1/ 307) جميعا بلفظه","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"qk370jBZ"}]}