{"schema":1,"kind":"sunan-chunk","version":"sunan-c56d7b8d0f22","needId":20,"stateIds":[186,187,188,189],"items":[{"id":"س-01278","fp":"187fe51404c9","stateId":186,"easy":"إذا لم تستطع الزواج فعليك بالصوم ← فإنه يكسر شهوتك","cause":"ومن لم يستَطِعْ منكُم فعلَيهِ بالصَّومِ","result":"فإنَّهُ لَهُ وِجاءٌ","explicit":true,"star":true,"similar":["س-01260","س-01265","س-03734"],"ref":"صحيح أبي داود 2046","srcLabel":"متفق عليه","text":["قالَ : إنِّي لأَمشي معَ عبدِ اللَّهِ بنِ مسعودٍ بمنًى إذ لقيَهُ عُثمانُ فاستَخلاهُ فلمَّا رأى عبدُ اللَّهِ ، أن ليسَت لَهُ حاجةٌ قالَ لي : تعالَ يا عَلقمةُ فَجِئْتُ فقالَ لَهُ : عُثمانُ ألا نزوِّجُكَ يا أبا عبدِ الرَّحمنِ بجاريةٍ بِكْرٍ لعلَّهُ يرجِعُ إليكَ من نفسِكَ ما كنتَ تعهَدُ ، فقالَ عبدُ اللَّهِ : لئن قُلتَ ذاكَ لقَد سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ يقولُ : منِ استَطاعَ منكمُ الباءةَ فليتزوَّجْ ، فإنَّهُ أغضُّ للبصرِ ، وأحصنُ للفرجِ ، ",["ومن لم يستَطِعْ منكُم فعلَيهِ بالصَّومِ",1]," ، ",["فإنَّهُ لَهُ وِجاءٌ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2046 ) واللفظ له ، والبخاري (5065) ومسلم (1400) بنحوه","bab":"نكاح › الحث على التزويج","dorar":"Uga8vwjK","merged":6,"otherRefs":["صحيح الترمذي 1081 (صحيح)","تخريج المسند لشاكر 1/204 (صحيح)","البحر الزخار 4/299 (صحيح)","مجمع الزوائد 4/255 (حسن)","صحيح النسائي 2238 (صحيح)"]},{"id":"س-01260","fp":"ca0b3cd6812a","stateId":186,"easy":"إذا لم تستطع الزواج فصم ← فالصوم يكسر شهوتك","cause":"ومن لم يستطِعْ ، فليَصُمْ","result":"فإنَّ الصَّومَ ، وِجاؤُهُ ، أو وِجاءٌ لَهُ","explicit":true,"repOf":"س-01278","ref":"تخريج المسند لشاكر 6/135","text":["أنَّ ابنَ مسعودٍ ، لقيَهُ عثمانُ بعَرفاتٍ ، فخلا بِهِ ، فحدَّثَهُ ، ثمَّ إنَّ عُثمانَ قالَ لابنِ مسعودٍ : هل لَكَ في فَتاةٍ أزوِّجُكَها ؟ ، فدعا عبدُ اللَّهِ بنُ مسعودٍ ، عَلقمةَ ، فحدَّثَ أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ : مَنِ استطاعَ منكمُ الباءةَ فَليتزوَّج ، فإنَّهُ أغضُّ للبصَرِ ، وأحصَنُ للفرجِ ، ",["ومن لم يستطِعْ ، فليَصُمْ",1]," ، ",["فإنَّ الصَّومَ ، وِجاؤُهُ ، أو وِجاءٌ لَهُ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (2240) باختلاف يسير، والبخاري (5065) ومسلم (1400) بنحوه","bab":"نكاح › الحث على التزويج","dorar":"PletFDKN","merged":3,"otherRefs":["تخريج المسند لشاكر 6/53 (صحيح)","الأحاديث المختارة 1853 (صحيح)"]},{"id":"س-01265","fp":"e71f31b24826","stateId":186,"easy":"إذا لم تستطع الزواج فصم ← فالصوم يكسر شهوتك","cause":"ومَن لم يستطِعْ منكم الباءةَ فلْيصُمْ","result":"فإنَّه له وجاءٌ وهو الإخصاءُ","explicit":true,"repOf":"س-01278","ref":"صحيح ابن حبان 4026","text":["بينا أنا وابنُ مسعودٍ نمشي بالمدينةِ قال: فلقي عثمانَ بنَ عفَّانَ فأخَذ بيدِه قال: فقاما وتنحَّيْتُ عنهما فلمَّا رأى عبدُ اللهِ أنْ ليس له حاجةٌ يُسِرُّها قال: ادنُ علقمةُ قال: فانتهَيْتُ إليه وهو يقولُ: ألا نُزوِّجُك يا عبدَ اللهِ جاريةً لعلَّها أنْ تُذكِّرَك ما فاتك ؟ قال: فقال عبدُ اللهِ: لئنْ قُلْتَ ذلك فإنَّا قد كنَّا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّم شبابًا فقال لنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( مَن استطاع منكم الباءةَ فلْيتزوَّجْ فإنَّه أغضُّ للبصرِ وأحصَنُ للفَرْجِ ",["ومَن لم يستطِعْ منكم الباءةَ فلْيصُمْ ",1],["فإنَّه له وجاءٌ ) وهو الإخصاءُ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (5065)، ومسلم (1400) بلفظ مقارب","bab":"نكاح › الحث على التزويج","dorar":"GgNLAYjy"},{"id":"س-01289","fp":"535190c850d0","stateId":186,"easy":"إذا كنت قادراً فتزوج، وإلا فصم ← فالصوم يكسر الشهوة ويقطعها","cause":"من كان ذا طَوْلٍ منكم فليتَزَوَّجْ، ومن لا فلْيَصُمْ","result":"فإنَّ الصَّومَ وِجاءٌ ومَحْسَمةٌ للعِرْقِ","explicit":true,"similar":["س-05960","س-01279","س-01280"],"ref":"الأحاديث المختارة 1726","srcLabel":"البخاري","text":["«",["من كان ذا طَوْلٍ منكم فليتَزَوَّجْ، ومن لا فلْيَصُمْ؛ ",1],["فإنَّ الصَّومَ وِجاءٌ ومَحْسَمةٌ للعِرْقِ»",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"نكاح › الحث على التزويج","dorar":"DilBiAO0"},{"id":"س-05960","fp":"b0ab333dae15","stateId":186,"easy":"إذا كنت قادراً فانكح، وإلا فصم ← فالصوم يكسر شهوتك ويقطعها","cause":"من كان عِنْدَه طَوْلٌ فلْيَنكِحْ","result":"وإلَّا فعليه بالصَّومِ؛ فإنَّه وِجاءٌ ومَحْسَمةٌ للعِرْقِ","explicit":true,"repOf":"س-01289","ref":"الأحاديث المختارة 1725","text":["«خرج النَّبيُّ صلَّى اللهُ عليه وسلَّم إلى المسجِدِ وفيه فِتْيةٌ مِن أصحابِه، فقال: ",["من كان عِنْدَه طَوْلٌ فلْيَنكِحْ، ",1],["وإلَّا فعليه بالصَّومِ؛ فإنَّه وِجاءٌ ومَحْسَمةٌ للعِرْقِ»",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"رقائق وزهد › الوصايا النافعة","dorar":"XQwkF37X"},{"id":"س-01279","fp":"acda513a874e","stateId":186,"easy":"إذا استطعت الزواج فتزوج، وإلا فصم ← فالصوم يكسر شهوتك","cause":"مَنِ استَطاعَ منكمُ الباءةَ فليَتَزَوَّجْ، ومَن لم يَستَطِعْ","result":"فعليه بالصَّومِ؛ فإنَّه له وِجاءٌ","explicit":true,"repOf":"س-01289","ref":"صحيح البخاري 5065","text":["كُنتُ مع عبدِ اللهِ، فلَقيَه عُثمانُ بمِنًى، فقال: يا أبا عبدِ الرَّحمَنِ، إنَّ لي إليك حاجةً، فخَلَوَا، فقال عُثمانُ: هل لك يا أبا عبدِ الرَّحمَنِ في أن نُزَوِّجَك بكرًا، تُذَكِّرُك ما كُنتَ تَعهَدُ؟ فلَمَّا رَأى عبدُ اللهِ أن ليس له حاجةٌ إلى هذا أشارَ إليَّ، فقال: يا عَلقَمةُ، فانتَهَيتُ إليه وهو يقولُ: أما لَئِن قُلتَ ذلك لقد قال لَنا النَّبيُّ صلَّى اللهُ عليه وسلَّم: يا مَعشَرَ الشَّبابِ، ",["مَنِ استَطاعَ منكمُ الباءةَ فليَتَزَوَّجْ، ومَن لم يَستَطِعْ ",1],["فعليه بالصَّومِ؛ فإنَّه له وِجاءٌ",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1400) باختلاف يسير","bab":"نكاح › الحث على التزويج","dorar":"Wcj9su8J"},{"id":"س-05938","fp":"5a7bcbf763e7","stateId":186,"easy":"إذا صمت ← فالصيام يكسر الشهوة","cause":"الصيامُ","result":"خِصاءُ أُمَّتي","explicit":true,"similar":["س-06742"],"ref":"السلسلة الصحيحة 1830","srcLabel":"أحمد","text":["خِصاءُ أُمَّتي ",["الصيامُ",1]," [ يعني حديث: أنَّ رجُلًا جاء إلى النبيِّ صلَّى اللهُ عليه وسلَّمَ، فقال: يا رسولَ اللهِ، أتأذَنُ لي أختصي، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["خِصاءُ أُمَّتي",2]," الصِّيامُ والقِيامُ.]"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرجه أحمد (6612)، والطبراني (14/82) (14692)، وابن عدي في ((الكامل في الضعفاء)) (2/450) مطولاً","bab":"رقائق وزهد › الوصايا النافعة","dorar":"9WNTtVvu","merged":2,"otherRefs":["صحيح الجامع 3228 (صحيح)"]},{"id":"س-01280","fp":"f74c6f02028a","stateId":186,"easy":"إذا استطعت الزواج فانكح، وإلا فصم ← فالصوم يكسر شهوتك","cause":"منِ استطاعَ منكم الطّوْلَ فلْينكِحْ أو فلْيتزوَّجْ وإلا","result":"فعليه بالصَّومِ فإنه له وِجاءٌ","explicit":true,"repOf":"س-01289","ref":"السلسلة الصحيحة 5/498","text":["يا معشرَ الشَّبابِ ",["منِ استطاعَ منكم الطّوْلَ فلْينكِحْ أو فلْيتزوَّجْ وإلا ",1],["فعليه بالصَّومِ فإنه له وِجاءٌ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح","takhrij":"أخرجه البزار (6932) واللفظ له، والطبراني في ((المعجم الأوسط)) (8203)، وتمام في ((الفوائد)) (1269)","bab":"نكاح › الحث على التزويج","dorar":"iKUgG0gu"},{"id":"س-03734","fp":"26157b073ceb","stateId":186,"easy":"إذا لم تجد ما تتزوج به فعليك بالصيام ← فهو يكسر شهوتك","cause":"و مَنْ لمْ يَجِدْ فَعليهِ بِالصِّيامِ","result":"فإنَّ الصَّوْمَ لهُ وِجَاءٌ","explicit":true,"repOf":"س-01278","ref":"السلسلة الصحيحة 2383","text":["النِّكَاحُ من سُنَّتِي فمَنْ لمْ يَعْمَلْ بِسُنَّتِي فَليسَ مِنِّي ، و تَزَوَّجُوا ؛ فإني مُكَاثِرٌ بِكُمُ الأُمَمَ ، و مَنْ كان ذَا طَوْلٍ فَلْيَنْكِحْ ، ",["و مَنْ لمْ يَجِدْ فَعليهِ بِالصِّيامِ",1],"، ",["فإنَّ الصَّوْمَ لهُ وِجَاءٌ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (1846) واللفظ له، والديلمي في ((الفردوس)) (6920) مختصراً.","bab":"اعتصام بالسنة › لزوم السنة","dorar":"wPZsfmaw"},{"id":"س-06742","fp":"def73322e345","stateId":186,"easy":"إذا صمت ← يقطع الصوم شهوة النكاح","cause":"بالصِّيامِ","result":"فإنَّه مجفَرةٌ","explicit":true,"repOf":"س-05938","ref":"تخريج الإحياء للعراقي 3/51","text":["أنَّهُ قال: يا رسولَ اللَّهِ إنِّي رجلٌ تَشقُّ عليَّ هذِهِ العزوبةُ في المغازي فتأذَنُ لي يا رسول اللَّه في الخِصاءِ فأختَصي؟ فقال: لا، ولَكِن عليكَ يا ابنَ مظعونٍ ",["بالصِّيامِ",1],"، ",["فإنَّه مجفَرةٌ",2]],"grade":"حسن","narrator":"عثمان بن مظعون","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن سعد في ((الطبقات الكبرى)) (3/ 395) والطبراني (9/ 38) (8320) والبيهقي في ((شعب الإيمان)) (3324) باختلاف يسير.","bab":"صيام › فضل الصيام","dorar":"nPnEVIub"},{"id":"س-07145","fp":"2bc7cc9bedbf","stateId":186,"easy":"إذا اشتدت شهوتك فصم وسل الله من فضله ← يعفّك","cause":"صُمْ، وسَلِ اللهَ مِن فَضْلِه","result":"يَستأذِنُه في الخِصاءِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-02212"],"ref":"تخريج المسند لشعيب 15105","srcLabel":"أحمد","text":["أنَّ رَجُلًا شابًّا أتى النَّبيَّ صلَّى اللهُ عليه وسَلَّم ",["يَستأذِنُه في الخِصاءِ",2],"، فقال: ",["صُمْ، وسَلِ اللهَ مِن فَضْلِه",1],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (15105) واللفظ له، وابن المبارك في ((الزهد)) (1107)","bab":"علم › حسن السؤال ونصح العالم","dorar":"gEdB6cqk"},{"id":"س-02212","fp":"f75a16d92b3e","stateId":186,"easy":"إذا اشتدت شهوتك ولم تستطع الزواج فصم واسأل الله من فضله ← يعفّك","cause":"صُمْ واسْأَلِ اللهَ مِنْ فَضْلِهِ","result":"ائذن لِّي في الْخِصَاءِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-07145","ref":"مجمع الزوائد 4/256","text":["جاء شابٌّ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقال يا رسولَ اللهِ ",["ائذن لِّي في الْخِصَاءِ",2]," قال ",["صُمْ واسْأَلِ اللهَ مِنْ فَضْلِهِ",1]],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"[فيه] رجل عن جابر وبقية رجاله ثقات","takhrij":"أخرجه أحمد (15036) بلفظه، وحسين المروزي في ((زياداته على الزهد)) لابن المبارك (1107) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"MY8sKzdv"},{"id":"س-01264","fp":"2ce5a4685c45","stateId":187,"easy":"إذا استطعت الزواج فتزوجت ← يكون أغضّ لبصرك وأحصن لفرجك","cause":"مَن استطاع منكم الباءةَ فلْيتزوَّجْ","result":"فإنَّه أغضُّ للبصرِ وأحصَنُ للفَرْجِ","explicit":true,"star":true,"ref":"صحيح ابن حبان 4026","srcLabel":"متفق عليه","text":["بينا أنا وابنُ مسعودٍ نمشي بالمدينةِ قال: فلقي عثمانَ بنَ عفَّانَ فأخَذ بيدِه قال: فقاما وتنحَّيْتُ عنهما فلمَّا رأى عبدُ اللهِ أنْ ليس له حاجةٌ يُسِرُّها قال: ادنُ علقمةُ قال: فانتهَيْتُ إليه وهو يقولُ: ألا نُزوِّجُك يا عبدَ اللهِ جاريةً لعلَّها أنْ تُذكِّرَك ما فاتك ؟ قال: فقال عبدُ اللهِ: لئنْ قُلْتَ ذلك فإنَّا قد كنَّا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّم شبابًا فقال لنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( ",["مَن استطاع منكم الباءةَ فلْيتزوَّجْ ",1],["فإنَّه أغضُّ للبصرِ وأحصَنُ للفَرْجِ ",2],"ومَن لم يستطِعْ منكم الباءةَ فلْيصُمْ فإنَّه له وجاءٌ ) وهو الإخصاءُ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (5065)، ومسلم (1400) بلفظ مقارب","bab":"نكاح › الحث على التزويج","dorar":"GgNLAYjy","merged":4,"otherRefs":["تخريج المسند لشاكر 6/135 (صحيح)","صحيح أبي داود 2046 (صحيح)","تخريج المسند لشاكر 6/53 (صحيح)"]},{"id":"س-05772","fp":"43799b6f0277","stateId":187,"easy":"إذا تزوجت ← يكون أغضّ لبصرك وأحصن لفرجك","cause":"عليكم بالباءةِ","result":"فإنَّهُ أغضُّ للبَصَرِ ، وأحصَنُ للفرَجِ","explicit":true,"similar":["س-01259"],"ref":"صحيح النسائي 2238","srcLabel":"متفق عليه","text":["خرَجنا معَ رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ ، ونَحنُ شبابٌ لا نَقدرُ على شَيءٍ ، قالَ : يا مَعشرَ الشَّبابِ ، ",["عليكم بالباءةِ",1]," ، ",["فإنَّهُ أغضُّ للبَصَرِ ، وأحصَنُ للفرَجِ",2]," ، ومن لم يستَطِعْ فعلَيهِ بالصَّومِ فإنَّهُ لَهُ وِجاءٌ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه النسائي (2239) واللفظ له، وأخرجه البخاري (5066)، ومسلم (1400) باختلاف يسير","bab":"رقائق وزهد › الوصايا النافعة","dorar":"tfyONPMC","merged":2,"otherRefs":["صحيح الترمذي 1081 (صحيح)"]},{"id":"س-01259","fp":"a3e2e045f5b6","stateId":187,"easy":"إذا كنت قادراً فتزوجت ← يكون أغضّ لبصرك وأحصن لفرجك","cause":"مَن كانَ منكُم ذا طَوْلٍ فليتزوَّجْ","result":"فإِنَّهُ أَغَضُّ للطَّرْفِ وأَحَصَنُ للفَرْجِ","explicit":true,"repOf":"س-05772","ref":"تخريج المسند لشاكر 1/204","text":["كُنتُ مع ابنِ مسعودٍ وهوَ عندَ عثمانَ رضي اللهُ عنه فقالَ لهُ عثمانُ رضي اللهُ عنه: ما بَقِيَ للنِّسَاءِ منكَ قالَ فلمَّا ذكرتُ النساءَ قال ابنُ مسعود: اُدنُ يا علقمةُ قالَ: وأنا رجلٌ شابٌ فقال عثمانُ رضي اللهُ عنه: خرجَ رسولُ الله صلَّى اللهُ عليه وسلَّم على فتيةٍ من المُهاجِرينَ فقالَ: ",["مَن كانَ منكُم ذا طَوْلٍ فليتزوَّجْ ",1],["فإِنَّهُ أَغَضُّ للطَّرْفِ وأَحَصَنُ للفَرْجِ ",2],"ومَنْ لا فإنَّ الصَّوْمَ لَهُ وِجَاءٌ"],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (2243)، والبزار (400)، والشاشي (361) جميعهم بألفاظ مقاربة.","bab":"نكاح › الحث على التزويج","dorar":"A1YxPYtf","merged":2,"otherRefs":["صحيح النسائي 3206 (صحيح)"]},{"id":"س-01288","fp":"135f8c2ed0c6","stateId":187,"easy":"إذا تزوجت في شبابك ← يصيح شيطانك: عصم مني دينه","cause":"أيُّما شابٍّ تزَوَّجَ في حداثةِ سنِّهِ","result":"عجَّ شيطانُهُ يا ويلَه عصمَ منِّي دينَهُ","explicit":true,"otherNeedIds":[31],"ref":"أطراف الغرائب 1/299","srcLabel":"أطراف الغرائب","text":["حديث: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["أيُّما شابٍّ تزَوَّجَ [في حداثةِ سنِّهِ",1]," ",["عجَّ شيطانُهُ يا ويلَه عصمَ منِّي دينَهُ",2],"]"],"grade":"حسن","narrator":"جابر بن عبد الله","muhaddith":"غريب من حديث عبيد الله بن عمر عن صالح مولى التوأمة، وتفرد به أبو الوليد خالد بن إسماعيل المخزومي عنه","bab":"نكاح › الحث على التزويج","dorar":"JgVp7gEA"},{"id":"س-08320","fp":"96f66f465f6c","stateId":188,"easy":"إذا أعجبتك امرأة فأتِ أهلك ← فإن مع زوجتك مثل ما معها","cause":"فليأتِ أَهلَه","result":"فإنَّ معَها مِثلَ الَّذي معَها","explicit":true,"star":true,"similar":["س-05806","س-01351"],"ref":"صحيح الترمذي 1158","srcLabel":"مسلم","text":["أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ رأَى امرأةً ، فدخلَ على زينَبَ ، فقضى حاجتَه وخرجَ وقالَ : إنَّ المرأةَ إذا أقبَلَت أقبَلَت في صورةِ شيطانٍ ، فإذا رأى أحدُكم امرَأةً فأعجبَتهُ ، ",["فليأتِ أَهلَه",1]," ، ",["فإنَّ معَها مِثلَ الَّذي معَها",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1158) واللفظ له، وأخرجه مسلم (1403) بلفظ مقارب","bab":"مناقب وفضائل › فضائل أزواج النبي صلى الله عليه وسلم","dorar":"nUkrISDe","merged":3,"otherRefs":["صحيح الجامع 1940 (صحيح)","صحيح أبي داود 2151 (صحيح)"]},{"id":"س-05806","fp":"a47d46d92a9f","stateId":188,"easy":"إذا رأيت امرأة أعجبتك فارجع إلى أهلك ← فإن معهم مثل ما معها","cause":"إذا رأى أحدُكم المرأةَ الَّتي تُعجِبُه فلْيرجِعْ إلى أهلِه حتَّى يقَعَ بهم","result":"فإنَّ ذلك معهم","explicit":true,"repOf":"س-08320","ref":"صحيح ابن حبان 5573","text":[["إذا رأى أحدُكم المرأةَ الَّتي تُعجِبُه فلْيرجِعْ إلى أهلِه حتَّى يقَعَ بهم ",1],["فإنَّ ذلك معهم",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (1403)، وأبو داود (2151)، والترمذي (1158) بنحوه.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"VgzAztSI"},{"id":"س-05812","fp":"6bb19a3221d8","stateId":188,"easy":"إذا أعجبتك امرأة فوقعت في نفسك فأتِ زوجتك ← يرد ذلك ما في نفسك","cause":"إذا أحدُكُم أعجَبَتْه المرأةُ، فوَقَعَت في نَفْسِه، فلْيَعْمِدْ إلى امْرأتِه، فلْيُواقِعْها","result":"فإنَّ ذلك يَرُدُّ مِن نَفْسِه","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 14744","srcLabel":"مسلم","text":[["إذا أحدُكُم أعجَبَتْه المرأةُ، فوَقَعَت في نَفْسِه، فلْيَعْمِدْ إلى امْرأتِه، فلْيُواقِعْها؛ ",1],["فإنَّ ذلك يَرُدُّ مِن نَفْسِه",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح لغيره","takhrij":"أخرجه مسلم (1403)، وأبو داود (2151)، والترمذي (1158)، والنسائي في ((السنن الكبرى)) (9121) بنحوه، وأحمد (14744) واللفظ له","bab":"رقائق وزهد › الوصايا النافعة","dorar":"to5Sv6A7"},{"id":"س-06110","fp":"825079fe7b80","stateId":188,"easy":"إذا عففت عن نساء الناس ← تعفّ نساؤك","cause":"عِفُّوا عنِ نساءِ الناسِ","result":"تعِفَّ نساؤُكم","explicit":true,"otherNeedIds":[37],"ref":"الجامع الصغير 5424","srcLabel":"الحاكم","text":[["عِفُّوا عنِ نساءِ الناسِ",1]," ",["تعِفَّ نساؤُكم",2]," ، وبِرُّوا آباءَكُم تبرَّكُمْ أبناؤُكُمْ ، ومَنْ أتاهُ أخوهُ مُتَنَصِّلًا فلْيَقْبَلْ ذلِكَ منْهُ ، مُحِقًّا كانَ أوْ مُبْطِلًا ، فإِنْ لم يَفْعَلْ لَمْ يَرِدْ عَلَيَّ الحوْضَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الحاكم في ((مستدركه)) (7258)، والشجري في ((أماليه)) (1982) واللفظ لهما.","bab":"رقائق وزهد › مكارم الأخلاق والعفو عمن ظلم","dorar":"B4Sv4Ht8","merged":2,"otherRefs":["الجامع الصغير 3124 (صحيح)"]},{"id":"س-07589","fp":"4335958afc19","stateId":188,"easy":"إذا افتُتنت بالنساء ← فهي أضر الفتن على الرجال","cause":"مِنَ النِّساءِ","result":"فِتنةً أضَرَّ على الرِّجالِ","explicit":true,"ref":"صحيح مسلم 2741","srcLabel":"مسلم","text":["ما تَرَكتُ بَعدي في النَّاسِ ",["فِتنةً أضَرَّ على الرِّجالِ",2]," ",["مِنَ النِّساءِ",1],"."],"grade":"صحيح","narrator":"أسامة بن زيد وسعيد بن زيد بن عمرو بن نفيل","muhaddith":"[صحيح]","bab":"فضائل النبي وصفته ودلائل النبوة › شفقته على أمته","dorar":"804vIvAp","merged":2,"otherRefs":["تخريج المسند لشعيب 21829 (صحيح)"]},{"id":"س-04082","fp":"fc1bc919a058","stateId":188,"easy":"إذا دخلت على النساء اللاتي غاب أزواجهن ← فالشيطان يجري منك مجرى الدم","cause":"لاَ تلجوا على المغيباتِ","result":"فإنَّ الشَّيطانَ يجري من أحدِكم مجرى الدَّمِ","explicit":true,"otherNeedIds":[34],"ref":"صحيح الترمذي 1172","srcLabel":"الترمذي","text":[["لاَ تلجوا على المغيباتِ",1],". ",["فإنَّ الشَّيطانَ يجري من أحدِكم مجرى الدَّمِ",2],". قلنا ومنْكَ؟ قالَ: ومنِّي، ولَكنَّ اللَّهَ أعانني عليْهِ، فأسلمُ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أحمد (14324) بلفظه، والترمذي (1172)، والدارمي (2824) كلاهما باختلاف يسير.","bab":"جن › صفة إبليس وجنوده","dorar":"OKKbWnfT"},{"id":"س-03592","fp":"f1e65c98c050","stateId":188,"easy":"إذا وقعت عينك على حرام فلا تتبعها نظرة ثانية ← فالأولى لك والثانية عليك","cause":"لا تُتبِعِ النَّظرةَ","result":"الأُولى لكَ، والآخِرةُ عليكَ","explicit":true,"ref":"تخريج مشكل الآثار 1867","srcLabel":"أبو داود","text":[["لا تُتبِعِ النَّظرةَ",1]," النَّظرةَ، ",["الأُولى لكَ، والآخِرةُ عليكَ",2],"."],"grade":"حسن","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"حسن","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (1867)، وأحمد (22974) واللفظ لهما، وأبو داود (2149) باختلاف يسير.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"zPZ8RV1P"},{"id":"س-07562","fp":"9aa3d0681f37","stateId":188,"easy":"إذا راودتك نفسك على الزنا فتذكّر أنك لا ترضاه لأمك وأختك ← يبغّضه الله إليك","cause":"أتحبُّه لأُمِّكَ","result":"فلم يكن شيءٌ أبغضَ إليه منه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج الإحياء للعراقي 2/411","srcLabel":"الطبراني","text":["أنَّ غلامًا شابًّا أتى النبيَّ صلَّى اللهُ عليهِ وسلَّم فقال : يا نبيَّ اللهِ أتأذنُ لي في الزنا ؟ فصاح الناسُ به , فقال النبيُّ صلَّى اللهُ عليهِ وسلَّم قَرِّبوهُ , ادْنُ فدنا حتى جلس بين يديْهِ , فقال النبيُّ عليه الصلاةُ والسلامُ : ",["أتحبُّه لأُمِّكَ",1]," فقال : لا , جعلني اللهُ فداك , قال : كذلك الناسُ لا يُحبُّونَه لِأمَّهاتِهم , أتحبُّه لابنتِك ؟ قال : لا ، جعلني اللهُ فداك قال : كذلك الناسُ لا يُحبُّونَه لبناتِهم , أتحبُّه لأختِك ؟ وزاد ابنُ عوفٍ حتى ذكر العمَّةَ والخالةَ , وهو يقولُ في كلِّ واحدٍ لا , جعلني اللهُ فداك , وهو صلَّى اللهُ عليهِ وسلَّم يقولُ كذلك الناسُ لا يُحبُّونَه , وقالا جميعًا في حديثِهما – أعني ابنَ عوفٍ والراوي الآخرَ - : فوضع رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم يدَه على صدرِه وقال : اللهمَّ طهِّرْ قلبَه واغفر ذنبَه وحصِّنْ فَرْجَه ",["فلم يكن شيءٌ أبغضَ إليه منه",2]," ."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"إسناده جيد رجاله رجال الصحيح","takhrij":"أخرجه الطبراني (8/ 162) (7679)، وابن عدي في ((الكامل في الضعفاء)) (3/ 393)، والبيهقي في ((شعب الإيمان)) (5415) واللفظ لهم.","bab":"فضائل النبي وصفته ودلائل النبوة › دعاء النبي لبعض الناس","dorar":"JQw55PqR"},{"id":"س-01351","fp":"2b1e762ab274","stateId":188,"easy":"إذا أعجبتك امرأة فأتِ أهلك ← فإن معهن مثل الذي معها (أثر ابن مسعود)","cause":"فلْيُواطئْ أهلَه","result":"من رأى منكم امرأةً فأعجبَتْه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-08320","ref":"إرواء الغليل 6/199","text":["قال عبدُ اللهِ ",["من رأى منكم امرأةً فأعجبَتْه",2]," ",["فلْيُواطئْ أهلَه",1]," فإنَّ الذي معهنَّ مثلُ الذي معهنَّ"],"grade":"حسن","narrator":"عبدالله بن حلام","muhaddith":"رجاله ثقات رجال الشيخين غير ابن حلام","takhrij":"أخرجه ابن أبي شيبة (17201) بلفظه.","bab":"نكاح › عشرة النساء","dorar":"tXDZt2E9"},{"id":"س-00492","fp":"055e80ca39b0","stateId":189,"easy":"إذا اتقيت الشبهات ← استبرأت لدينك وعرضك","cause":"فمَنِ اتَّقى الشُّبُهاتِ","result":"استَبرَأ لدينِه وعِرضِه","explicit":true,"star":true,"ref":"صحيح مسلم 1599","srcLabel":"متفق عليه","text":["سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ -وأهوى النُّعمانُ بإصبَعَيه إلى أُذُنَيه-: إنَّ الحَلالَ بَيِّنٌ، وإنَّ الحَرامَ بَيِّنٌ، وبينَهما مُشتَبِهاتٌ لا يَعلَمُهنَّ كَثيرٌ مِنَ النَّاسِ، ",["فمَنِ اتَّقى الشُّبُهاتِ",1]," ",["استَبرَأ لدينِه وعِرضِه",2],"، ومَن وقَعَ في الشُّبُهاتِ وقَعَ في الحَرامِ، كالرَّاعي يَرعى حَولَ الحِمى، يوشِكُ أن يَرتَعَ فيه، ألا وإنَّ لكُلِّ مَلِكٍ حِمًى، ألا وإنَّ حِمى اللهِ مَحارِمُه، ألا وإنَّ في الجَسَدِ مُضغةً إذا صَلَحَت صَلَحَ الجَسَدُ كُلُّه، وإذا فسَدَت فسَدَ الجَسَدُ كُلُّه، ألا وهي القَلبُ."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (52)، ومسلم (1599).","bab":"آداب عامة › ضرب الأمثال","dorar":"3ItFLlck","merged":2,"otherRefs":["حلية الأولياء 8/144 (صحيح)"]},{"id":"س-05299","fp":"006b3fe56017","stateId":189,"easy":"إذا تركت الشبهات استبراءً لدينك وعرضك ← فقد سلمت","cause":"فمن ترَكَها استبراءً لدينِهِ وعرضِهِ","result":"فقد سلمَ","explicit":true,"star":true,"ref":"غاية المرام 20","srcLabel":"متفق عليه","text":["الحلالُ بيِّنٌ والحرامُ بيِّنٌ، وبينَ ذلِكَ أمورٌ مشتبِهاتٌ، لا يدري كثيرٌ منَ النَّاسِ أمنَ الحلالِ هيَ أم منَ الحرامِ، ",["فمن ترَكَها استبراءً لدينِهِ وعرضِهِ ",1],["فقد سلمَ",2]," ، ومن واقعَ شيئًا منها، يوشِكُ أن يواقعَ الحرامَ، كما أنَّ من يرعى حولَ الحِمى أوشكَ أن يواقعَهُ، ألا وإنَّ لِكُلِّ ملِكٍ حمًى، إلَّا وإنَّ حمى اللَّهِ محارمُهُ"],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"صحيح","takhrij":"أخرجه البخاري (52)، ومسلم (1599) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مواقعة الحدود وانتهاك المحارم","dorar":"3VStef4M"},{"id":"س-05300","fp":"38cd99acd55f","stateId":189,"easy":"إذا تركت ما اشتبه عليك من الإثم ← كنت لما استبان أترك","cause":"فمَن تَرَك ما شُبِّهَ عليه مِنَ الإثمِ","result":"كان لما استَبانَ أترَكَ","explicit":true,"star":true,"ref":"صحيح البخاري 2051","srcLabel":"مسلم","text":["الحَلالُ بَيِّنٌ، والحَرامُ بَيِّنٌ، وبينَهما أُمورٌ مُشتَبِهةٌ، ",["فمَن تَرَك ما شُبِّهَ عليه مِنَ الإثمِ ",1],["كان لما استَبانَ أترَكَ، ",2],"ومَنِ اجتَرَأ على ما يَشُكُّ فيه مِنَ الإثمِ أوشَك أن يواقِعَ ما استَبانَ، والمَعاصي حِمى اللهِ، مَن يَرتَعْ حَولَ الحِمى يوشِكْ أن يواقِعَه."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1599) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مواقعة الحدود وانتهاك المحارم","dorar":"kbZKWXl6"},{"id":"س-04061","fp":"ca5f6a74d80e","stateId":189,"easy":"إذا طلبت العفة ← يعفّك الله","cause":"مَنِ استَعَفَّ","result":"يُعِفَّه اللهُ","explicit":true,"otherNeedIds":[5],"ref":"تخريج المسند لشعيب 11401","srcLabel":"أحمد","text":["عن هلالِ بنِ حِصنٍ قال: نزَلْتُ على أبي سعيدٍ الخُدْريِّ فضمَّني وإيَّاه المَجلِسُ، قال: فحدَّث أنَّه أَصبَح ذاتَ يومٍ، وقد عصَب على بَطنِه حَجَرًا منَ الجوعِ، فقالت له امرأتُه أو أُمُّه: ائْتِ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ فاسأَلْه فاسأَلْه، فقد أَتاه فُلانٌ فسأَله، فأَعْطاه، وأَتاه فُلانٌ فسأَله، فأَعْطاه، فقال: قُلتُ: حتى أَلتَمِسَ شيئًا، قال: فالتَمسْتُ فأتَيْتُه، -قال حجَّاجٌ: فلم أَجِدْ شيئًا فأتَيْتُه- وهو يخطُبُ، فأَدرَكْتُ من قولِه وهو يقولُ: \"",["مَنِ استَعَفَّ",1]," ",["يُعِفَّه اللهُ",2],"، ومَنِ استَغْنى يُغْنِه اللهُ، ومَن سأَلنا إمَّا أنْ نَبذُلَ له، وإمَّا أنْ نواسِيَه، -أبو حَمْزةَ الشَّاكُّ- ومَن يَستَعِفُّ عنَّا أو يَستَغْني، أَحَبُّ إلينا ممَّن يسأَلُنا\"، قال: فرجَعْتُ فما سأَلْتُه شيئًا، فما زال اللهُ عزَّ وجلَّ يرزُقُنا حتى ما أَعلَمُ في الأنصارِ أهلَ بيتٍ أكثرَ أموالًا منَّا."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (11401) واللفظ له، والطيالسي (2325)، وابن أبي شيبة (10792)","bab":"جمعة › خطبة النبي صلى الله عليه وسلم","dorar":"BHgqqF8I","merged":12,"otherRefs":["صحيح ابن حبان 3399 (صحيح)","عمدة القاري 9/72 (صحيح)","نخب الافكار 8/18 (صحيح)","تخريج المسند لشعيب 10989 (صحيح)","تخريج المسند لشعيب 11435 (صحيح)","صحيح البخاري 6470 (صحيح)","صحيح البخاري 1469 (صحيح)","السلسلة الصحيحة 2314 (صحيح)","عمدة التفسير 1/329 (صحيح)","صحيح ابن حبان 3398 (صحيح)","تخريج المسند لشعيب 15578 (صحيح)"]},{"id":"ق-0607","fp":"4c058b132688","stateId":189,"easy":"الإخلاص لله ← صرف السوء والفحشاء","cause":"الإخلاص لله","result":"صرف السوء والفحشاء","explicit":true,"otherNeedIds":[31],"ref":"سورة يوسف: 24","srcLabel":"القرآن الكريم","quran":{"s":12,"from":24,"to":24,"text":"وَلَقَدْ هَمَّتْ بِهِ وَهَمَّ بِهَا لَوْلَا أَنْ رَأَى بُرْهَانَ رَبِّهِ كَذَلِكَ لِنَصْرِفَ عَنْهُ السُّوءَ وَالْفَحْشَاءَ إِنَّهُ مِنْ عِبَادِنَا الْمُخْلَصِينَ (24)","hl":[[73,162,1]]}},{"id":"ق-0948","fp":"c6b4bd6778a4","stateId":189,"easy":"إقامة الصلاة ← الانتهاء عن الفحشاء والمنكر","cause":"إقامة الصلاة","result":"الانتهاء عن الفحشاء والمنكر","explicit":true,"ref":"سورة العنكبوت: 45","srcLabel":"القرآن الكريم","quran":{"s":29,"from":45,"to":45,"text":"اتْلُ مَا أُوحِيَ إِلَيْكَ مِنَ الْكِتَابِ وَأَقِمِ الصَّلَاةَ إِنَّ الصَّلَاةَ تَنْهَى عَنِ الْفَحْشَاءِ وَالْمُنْكَرِ وَلَذِكْرُ اللَّهِ أَكْبَرُ وَاللَّهُ يَعْلَمُ مَا تَصْنَعُونَ (45)","hl":[[63,119,1]]}},{"id":"س-05523","fp":"4ba81598fe92","stateId":189,"easy":"إذا خرجت تسعى على نفسك لتعفّها ← فأنت في سبيل الله","cause":"خَرَجَ يَسعى على نَفسِه يُعِفُّها","result":"فهو في سَبيلِ اللهِ","explicit":true,"otherNeedIds":[49],"ref":"حسن الأسوة بما ثبت في النسوة 564","srcLabel":"الطبراني","text":["مَرَّ على النَّبيِّ صلَّى اللهُ عليه وسلَّم رَجُلٌ فرَأى أصحابُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم مِن جَلَدِه ونَشاطِه، فقالوا: يا رَسولَ اللهِ، لو كان هذا في سَبيلِ اللهِ! فقال رسولُ اللهِ: إن كان خَرَجَ يَسعى على ولدِه صِغارًا فهو في سَبيل اللهِ، وإن كان خَرَجَ يَسعى على أبَوينِ شَيخَينِ كَبيرَينِ فهو في سَبيلِ اللهِ، وإن كان ",["خَرَجَ يَسعى على نَفسِه يُعِفُّها",1]," ",["فهو في سَبيلِ اللهِ",2],"، وإن كان خَرَجَ يَسعى رياءً ومُفاخَرةً فهو في سَبيلِ الشَّيطانِ"],"grade":"صحيح","narrator":"كعب بن عجرة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((الأوسط)) (6835)، وبحشل في ((تاريخ واسط)) (صـ162) واللفظ لهما.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"yhlIFCs7"},{"id":"س-07580","fp":"eb5d75849985","stateId":189,"easy":"إذا اتبعت شهوات الغي في بطنك وفرجك ← فهي أخوف ما يُخاف عليك","cause":"شهواتِ الْغَيِّ في بطونِكم وفروجِكم","result":"إنَّما أَخْشَى عَلَيْكُم","explicit":true,"otherNeedIds":[13],"ref":"مجمع الزوائد 7/309","srcLabel":"أحمد","text":[["إنَّما أَخْشَى عَلَيْكُم",2]," ",["شهواتِ الْغَيِّ في بطونِكم وفروجِكم",1]," ومُضِلَّاتِ الْفِتَنِ وفي رِوَايَةٍ وَمُضِلَّاتِ الهوَى"],"grade":"صحيح","narrator":"أبو برزة الأسلمي نضلة بن عبيد","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه البزار (3844) واللفظ له، وأحمد (19773)، والطبراني في ((المعجم الصغير)) (511) كلاهما باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › شفقته على أمته","dorar":"epm12Ksv"},{"id":"س-05298","fp":"5876a20008dc","stateId":189,"easy":"إذا اجتنبت الشبهات ← فهو أوفر لدينك","cause":"ومَنِ اجْتَنَبَهُنَّ","result":"فهوَ أوْفَرُ لِدِينِهِ ، كَمَرْتَعٍ إلى جَنْبِ حِمَى ، أوْشَكَ يَقَعُ فيهِ ، لِكلِّ مَلَكٍ حِمًى ، وحِمَى اللهِ الحَرَامُ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"otherNeedIds":[42,19],"ref":"السلسلة الصحيحة 3361","srcLabel":"الطبراني","text":["الحَلالُ بَيِّنٌ ، والحَرَامُ بَيِّنٌ ، وبينَ ذلكَ شُبُهاتٌ ، فمَنْ أوْقَعَ بِهنَّ ؛ فهوَ قَمِنٌ أنْ يَأْثَمَ ، ",["ومَنِ اجْتَنَبَهُنَّ ؛ ",1],["فهوَ أوْفَرُ لِدِينِهِ ، كَمَرْتَعٍ إلى جَنْبِ حِمَى ، أوْشَكَ يَقَعُ فيهِ ، لِكلِّ مَلَكٍ حِمًى ، وحِمَى اللهِ الحَرَامُ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده عزيز صحيح رجاله ثقات","takhrij":"أخرجه الطبراني في ((المعجم الكبير )) (10/ 333) (10824 )،وابن عساكر في ((تاريخ دمشق )) (20/ 4)","bab":"رقائق وزهد › الترهيب من مواقعة الحدود وانتهاك المحارم","dorar":"vkxsHFjW","merged":5,"otherRefs":["حلية الأولياء 4/298 (صحيح)","حلية الأولياء 5/121 (صحيح)","صحيح الجامع 152 (صحيح)","الفتح الرباني 4/1818 (صحيح)"]},{"id":"س-05868","fp":"59af178686ce","stateId":189,"easy":"إذا أردت أمراً تعتصم به فاملك لسانك ← تسلم","cause":"أَملكْ عليك هذا وأشار إلى لسانِه","result":"أخبِرْني بأمرٍ أعتصمُ به","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"المتجر الرابح 315","srcLabel":"أحمد","text":["أنه قال لرسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ: ",["أخبِرْني بأمرٍ أعتصمُ به",2]," فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ: ",["أَملكْ عليك هذا وأشار إلى لسانِه.",1]],"grade":"حسن","narrator":"الحارث بن هشام","muhaddith":"إسناده جيد","takhrij":"أخرجه الطبراني (3/ 260) (3348)، وأبو أحمد الحاكم في ((الأسامي والكنى)) (5/ 218)، وأبو طاهر المخلص في ((المخلصيات)) (2321) واللفظ لهم جميعا.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"urGL4cyn"}]}