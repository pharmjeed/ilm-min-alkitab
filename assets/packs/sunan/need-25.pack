{"schema":1,"kind":"sunan-chunk","version":"sunan-50a61695a4db","needId":25,"stateIds":[219,220,221,222,223],"items":[{"id":"س-00865","fp":"30486c7beaa9","stateId":219,"easy":"إذا ظننت بالله ظناً ← فهو عند ظنك","cause":"ظَنِّ عَبدي بي","result":"أنا عِندَ ظَنِّ عَبدي بي","explicit":true,"star":true,"otherNeedIds":[47],"ref":"صحيح مسلم 2675","srcLabel":"متفق عليه","text":["يقولُ اللهُ عزَّ وجلَّ: ",["أنا عِندَ ظَنِّ عَبدي بي",2],"، وأنا معهُ حينَ يَذكُرُني، إن ذَكَرَني في نَفسِه ذَكَرتُه في نَفسي، وإن ذَكَرَني في مَلَإٍ ذَكَرتُه في مَلَإٍ هُم خَيرٌ منهم، وإن تَقَرَّبَ مِنِّي شِبرًا تَقَرَّبتُ إليه ذِراعًا، وإن تَقَرَّبَ إلَيَّ ذِراعًا تَقَرَّبتُ منه باعًا، وإن أتاني يَمشي أتَيتُه هَرولةً. وفي روايةٍ: بهذا الإسنادِ، ولَم يَذكُرْ: وإن تَقَرَّبَ إلَيَّ ذِراعًا تَقَرَّبتُ منه باعًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7405)، ومسلم (2675).","bab":"أدعية وأذكار › فضل الذكر","dorar":"CgGdDKn0","merged":6,"otherRefs":["تخريج المسند لشعيب 10909 (صحيح)","تخريج المسند لشعيب 7422 (صحيح)","السلسلة الصحيحة 2942 (صحيح)","تخريج المسند لشعيب 16017 (صحيح)","تخريج صحيح ابن حبان 641 (صحيح)"]},{"id":"س-00868","fp":"8d3c3d383f24","stateId":219,"easy":"إذا ذكرت الله في جمع ← يذكرك في جمع خير منهم","cause":"وإن ذَكَرَني في مَلَإٍ","result":"ذَكَرتُه في مَلَإٍ هُم خَيرٌ منهم","explicit":true,"star":true,"ref":"صحيح مسلم 2675","srcLabel":"متفق عليه","text":["يقولُ اللهُ عزَّ وجلَّ: أنا عِندَ ظَنِّ عَبدي بي، وأنا معهُ حينَ يَذكُرُني، إن ذَكَرَني في نَفسِه ذَكَرتُه في نَفسي، ",["وإن ذَكَرَني في مَلَإٍ",1]," ",["ذَكَرتُه في مَلَإٍ هُم خَيرٌ منهم",2],"، وإن تَقَرَّبَ مِنِّي شِبرًا تَقَرَّبتُ إليه ذِراعًا، وإن تَقَرَّبَ إلَيَّ ذِراعًا تَقَرَّبتُ منه باعًا، وإن أتاني يَمشي أتَيتُه هَرولةً. وفي روايةٍ: بهذا الإسنادِ، ولَم يَذكُرْ: وإن تَقَرَّبَ إلَيَّ ذِراعًا تَقَرَّبتُ منه باعًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7405)، ومسلم (2675).","bab":"أدعية وأذكار › فضل الذكر","dorar":"CgGdDKn0","merged":7,"otherRefs":["الجامع الصغير 6042 (صحيح)","تخريج صحيح ابن حبان 328 (صحيح)","تخريج المسند لشعيب 12405 (صحيح)","تخريج المسند لشعيب 7422 (صحيح)","صحيح الترغيب 1489 (صحيح)","الأحاديث المختارة 10 / 214 (حسن)"]},{"id":"س-00867","fp":"137575175993","stateId":219,"easy":"إذا ذكرت الله في نفسك ← يذكرك في نفسه","cause":"إن ذَكَرَني في نَفسِه","result":"ذَكَرتُه في نَفسي","explicit":true,"star":true,"similar":["س-01087","ق-0049","س-01049","س-00939"],"ref":"صحيح مسلم 2675","srcLabel":"متفق عليه","text":["يقولُ اللهُ عزَّ وجلَّ: أنا عِندَ ظَنِّ عَبدي بي، وأنا معهُ حينَ يَذكُرُني، ",["إن ذَكَرَني في نَفسِه",1]," ",["ذَكَرتُه في نَفسي",2],"، وإن ذَكَرَني في مَلَإٍ ذَكَرتُه في مَلَإٍ هُم خَيرٌ منهم، وإن تَقَرَّبَ مِنِّي شِبرًا تَقَرَّبتُ إليه ذِراعًا، وإن تَقَرَّبَ إلَيَّ ذِراعًا تَقَرَّبتُ منه باعًا، وإن أتاني يَمشي أتَيتُه هَرولةً. وفي روايةٍ: بهذا الإسنادِ، ولَم يَذكُرْ: وإن تَقَرَّبَ إلَيَّ ذِراعًا تَقَرَّبتُ منه باعًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7405)، ومسلم (2675).","bab":"أدعية وأذكار › فضل الذكر","dorar":"CgGdDKn0","merged":3,"otherRefs":["تخريج صحيح ابن حبان 328 (صحيح)","تخريج المسند لشعيب 7422 (صحيح)"]},{"id":"س-01051","fp":"ad977eb1fcb1","stateId":219,"easy":"إذا ذكرت الله ← فهو معك","cause":"حين يَذْكُرُني","result":"أنا مع عَبْدي","explicit":true,"star":true,"similar":["س-00708"],"ref":"تخريج المسند لشعيب 7422","srcLabel":"متفق عليه","text":["يَقولُ اللهُ عزَّ وجلَّ: ",["أنا مع عَبْدي",2]," ",["حين يَذْكُرُني",1],"، فإنْ ذكَرَني في نَفْسِه ذكَرْتُه في نَفْسي، وإنْ ذكَرَني في مَلَإٍ، ذكَرْتُه في مَلَإٍ هُم خَيْرٌ مِنهم، وإن اقترَبَ إليَّ شِبْرًا اقترَبْتُ إليه ذِراعًا، فإنِ اقترَبَ إليَّ ذِراعًا اقترَبْتُ إليه باعًا، فإنْ أتاني يَـمْشي أتَيْتُه هَرْوَلةً، وقال ابنُ نُـمَيْرٍ في حَديثِه: أنا عِنْدَ ظَنِّ عَبْدي بي، وأنا معَه حين يَذْكُرُني."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (7405)، ومسلم (2675)، والترمذي (3603)، والنسائي في ((السنن الكبرى)) (7730)، وابن ماجه (3822)، وأحمد (7422) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"24Sg0grd"},{"id":"س-01087","fp":"4fa3fc8fb3f6","stateId":219,"easy":"إذا ذكرت الله في نفسك ← يذكرك في نفسه","cause":"مَن ذَكَرَ اللهَ تعالَى في نفْسِه","result":"ذَكَرُه اللهُ تعالَى في نفْسِه","explicit":true,"repOf":"س-00867","ref":"المستدرك على الصحيحين 7834","text":[["مَن ذَكَرَ اللهَ تعالَى في نفْسِه ",1],["ذَكَرُه اللهُ تعالَى في نفْسِه، ",2],"ومَن ذَكَرَ اللهَ في مَلأٍ ذَكَرَه اللهُ في مَلَأٍ هُم أكثَرُ مِن الملأِ الَّذينَ ذَكَرهُ فيهم وأطَيَبُ، ومَن تقرَّبَ إلى اللهِ شِبرًا تقرَّبَ اللهُ منه ذِراعًا، ومَن تقَرَّبَ مِن اللهِ ذِراعًا تَقرَّبَ اللهُ منه باعًا، ومَن أتى اللهَ مَشْيًا أتاهُ هَرْولةً، ومَن أتى اللهَ هَرْولةً أتاهُ اللهُ سَعْيًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه مسلم (2675)، وأحمد (10619)، وابن حبان (376) مختصرًا.","bab":"أدعية وأذكار › فضل الذكر","dorar":"Ncgb3lTT"},{"id":"س-01088","fp":"3533a3c0690a","stateId":219,"easy":"إذا ذكرت الله في ملأ ← يذكرك في ملأ أكثر وأطيب","cause":"ومَن ذَكَرَ اللهَ في مَلأٍ","result":"ذَكَرَه اللهُ في مَلَأٍ هُم أكثَرُ مِن الملأِ الَّذينَ ذَكَرهُ فيهم وأطَيَبُ","explicit":true,"ref":"المستدرك على الصحيحين 7834","srcLabel":"مسلم","text":["مَن ذَكَرَ اللهَ تعالَى في نفْسِه ذَكَرُه اللهُ تعالَى في نفْسِه، ",["ومَن ذَكَرَ اللهَ في مَلأٍ ",1],["ذَكَرَه اللهُ في مَلَأٍ هُم أكثَرُ مِن الملأِ الَّذينَ ذَكَرهُ فيهم وأطَيَبُ، ",2],"ومَن تقرَّبَ إلى اللهِ شِبرًا تقرَّبَ اللهُ منه ذِراعًا، ومَن تقَرَّبَ مِن اللهِ ذِراعًا تَقرَّبَ اللهُ منه باعًا، ومَن أتى اللهَ مَشْيًا أتاهُ هَرْولةً، ومَن أتى اللهَ هَرْولةً أتاهُ اللهُ سَعْيًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه مسلم (2675)، وأحمد (10619)، وابن حبان (376) مختصرًا.","bab":"أدعية وأذكار › فضل الذكر","dorar":"Ncgb3lTT"},{"id":"س-01164","fp":"56700c500754","stateId":219,"easy":"إذا سبّحت وحمدت وهلّلت ← يتعطفن حول العرش يذكّرن بك","cause":"التَّسبيحَ، والتَّحميدَ، والتَّهليلَ","result":"إنَّهنَّ ليَتعَطَّفنَ حولَ العرشِ، لهُنَّ دَوِيٌّ كدَوِيِّ النَّحلِ، يُذَكِّرنَ بصاحبِهِنَّ، أفلا يُحِبُّ أَحدُكُم أنْ يكونَ له عندَ اللهِ مَنْ يُذكِّرُه به","explicit":true,"similar":["س-01080"],"ref":"المستدرك على الصحيحين 1879","srcLabel":"مسلم","text":["إنَّ مِن جَلالِ اللهِ ممَّا يَذكُرونَ ",["التَّسبيحَ، والتَّحميدَ، والتَّهليلَ",1],"، ",["إنَّهنَّ ليَتعَطَّفنَ حولَ العرشِ، لهُنَّ دَوِيٌّ كدَوِيِّ النَّحلِ، يُذَكِّرنَ بصاحبِهِنَّ، أفلا يُحِبُّ أَحدُكُم أنْ يكونَ له عندَ اللهِ مَنْ يُذكِّرُه به",2],"؟"],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"على شرط مسلم","bab":"أدعية وأذكار › فضل الذكر","dorar":"OV40197b"},{"id":"ق-0049","fp":"bef99be6b687","stateId":219,"easy":"ذكر الله ← أن يذكرك الله","cause":"ذكر الله","result":"أن يذكرك الله","explicit":true,"repOf":"س-00867","ref":"سورة البقرة: 152","quran":{"s":2,"from":152,"to":152,"text":"فَاذْكُرُونِي أَذْكُرْكُمْ وَاشْكُرُوا لِي وَلَا تَكْفُرُونِ (152)","hl":[[0,26,1]]}},{"id":"س-01049","fp":"4e22ccdca62e","stateId":219,"easy":"إذا ذكرت الله في نفسك ← يذكرك في نفسه","cause":"إنْ ذكَرْتَني في نفْسِكَ","result":"ذكَرْتُكَ في نفْسي","explicit":true,"repOf":"س-00867","ref":"تخريج المسند لشعيب 12405","text":["قال اللهُ: يا ابنَ آدَمَ، ",["إنْ ذكَرْتَني في نفْسِكَ",1]," ",["ذكَرْتُكَ في نفْسي",2],"، وإنْ ذكَرْتَني في ملأٍ ذكَرْتُكَ في ملأٍ منَ الملائكةِ، أو في ملأٍ خَيرٍ منهم، وإنْ دنَوْتَ منِّي شِبرًا، دنَوْتُ منكَ ذِراعًا، وإنْ دنَوْتَ منِّي ذِراعًا، دنَوْتُ منكَ باعًا، وإنْ أتَيْتَني تَمْشي، أتَيْتُكَ أُهروِلُ، قال قَتادةُ: فاللهُ عزَّ وجلَّ أسرَعُ بالمَغفِرةِ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (12405) واللفظ له، ومعمر في ((جامعه)) (20575)، وعبد بن حميد (1167)","bab":"أدعية وأذكار › فضل الذكر","dorar":"yRciTMef","merged":3,"otherRefs":["الجامع الصغير 6042 (صحيح)","صحيح الترغيب 1489 (صحيح)"]},{"id":"س-00708","fp":"085704b246f9","stateId":219,"easy":"إذا ذكرت الله ← يكون معك","cause":"إذَا ذَكَرْتَنِي","result":"وَأَنَا مَعَكَ","explicit":true,"repOf":"س-01051","otherNeedIds":[24],"ref":"صحيح الجامع 4325","text":["قال اللهُ تعالى : عبدي أنا عندَ ظنِّكَ بِي ، ",["وَأَنَا مَعَكَ",2]," ",["إذَا ذَكَرْتَنِي",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (1828)","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"57Vof6RN","merged":2,"otherRefs":["السلسلة الصحيحة 2012 (صحيح)"]},{"id":"س-05367","fp":"7f0634116369","stateId":219,"easy":"إذا أحسنت الظن بالله ← يعطيك ظنك","cause":"يُحْسِنُ عبدٌ باللهِ الظَّنَّ","result":"إلَّا أعطاه ظَنَّه","explicit":true,"otherNeedIds":[47],"ref":"مجمع الزوائد 10/151","srcLabel":"أبو داود","text":["عن عبدِ اللهِ يعني ابنَ مسعودٍ قال والَّذي لا إلهَ إلَّا هو لا ",["يُحْسِنُ عبدٌ باللهِ الظَّنَّ",1]," ",["إلَّا أعطاه ظَنَّه",2]," وذاك بأنَّ الخيرَ في يدِه"],"grade":"صحيح","narrator":"[خيثمة بن عبدالرحمن]","muhaddith":"رجاله رجال الصحيح إلا أن الأعمش لم يدرك ابن مسعود","takhrij":"أخرجه الطبراني ((9/ 154)) (8772) بلفظه، وابن المبارك في (( الزهد )) (1033) وأبو داود في ((الزهد)) (121) بنحوه","bab":"رقائق وزهد › التوكل واليقين","dorar":"QDGQJbdi","merged":2,"otherRefs":["المتجر الرابح 338 (صحيح)"]},{"id":"س-00923","fp":"086e49f534cd","stateId":219,"easy":"إذا جلست في مجالس الذكر ← تحيط بكم الملائكة إلى عنان السماء","cause":"مجالسَ الذِّكرِ","result":"فيحيطون بهم إلى عنانِ السَّماءِ","explicit":true,"otherNeedIds":[23],"ref":"مجموع فتاوى ابن باز 26/57","srcLabel":"أحمد","text":["إنَّ للهِ ملائكةً سيَّاحينَ يلتمسون ",["مجالسَ الذِّكرِ",1],"، فإذا وجدوها تنادوْا هلمُّوا إلى حاجتِكم ",["فيحيطون بهم إلى عنانِ السَّماءِ",2],"، ويسمعون منهم أذكارَهم وأعمالَهم الطيبةَ، ثم إذا عرجوا سألهم اللهُ عما وجدوا، وهو أعلمُ سبحانه وتعالى، فيخبرونَه بما شاهدوا"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"صحيح","takhrij":"أخرجه أحمد (7424)، والطبراني في ((الدعاء)) (1894) بنحوه، والبزار (9149) مختصرًا.","bab":"أدعية وأذكار › فضل الذكر","dorar":"YdfCFvOr"},{"id":"س-00939","fp":"14f9e4dbb59c","stateId":219,"easy":"إذا ذكرت الله في نفسك ← يذكرك في ملأ من الملائكة","cause":"لا يذكُرني عبدٌ في نفسِهِ","result":"إلا ذَكرتُه في ملإٍ من ملائِكتي، ولا يذكرُني في ملإٍ، إلا ذَكرتُه في الرَّفيقِ الأعلَى","explicit":true,"repOf":"س-00867","ref":"الجامع الصغير 6041","text":["قالَ اللَّه تعالى : ",["لا يذكُرني عبدٌ في نفسِهِ",1]," ",["إلا ذَكرتُه في ملإٍ من ملائِكتي، ولا يذكرُني في ملإٍ، إلا ذَكرتُه في الرَّفيقِ الأعلَى",2]],"grade":"صحيح","narrator":"معاذ بن أنس","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (20/ 182) (391) واللفظ له.","bab":"أدعية وأذكار › فضل الذكر","dorar":"CDyXXfek"},{"id":"س-01050","fp":"cccafee87a4b","stateId":219,"easy":"إذا ذكرت جلال الله بالتسبيح والتحميد والتكبير والتهليل ← يتعاطفن حول العرش يذكّرن بك","cause":"الذين يَذكُرونَ مِن جَلالِ اللهِ مِن تَسبيحِه، وتَحميدِه، وتَكبيرِه، وتَهليلِه","result":"يَتعاطَفنَ حولَ العَرشِ، لهنَّ دَويٌّ كدَويِّ النَّحلِ، يُذكِّرْنَ بصاحِبِهنَّ، ألَا يُحِبُّ أحدُكم أنْ لَا يَزالُ له عندَ اللهِ شيءٌ يُذَكِّرُ به","explicit":true,"ref":"تخريج المسند لشعيب 18362","srcLabel":"ابن ماجه","text":[["الذين يَذكُرونَ مِن جَلالِ اللهِ مِن تَسبيحِه، وتَحميدِه، وتَكبيرِه، وتَهليلِه",1],"، ",["يَتعاطَفنَ حولَ العَرشِ، لهنَّ دَويٌّ كدَويِّ النَّحلِ، يُذكِّرْنَ بصاحِبِهنَّ، ألَا يُحِبُّ أحدُكم أنْ لَا يَزالُ له عندَ اللهِ شيءٌ يُذَكِّرُ به",2],"؟"],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (3809)، وأحمد (18362) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"erBi77fL"},{"id":"س-05380","fp":"f8b5772747c4","stateId":219,"easy":"إذا ظننت بالله خيراً ← فلك الخير","cause":"ظَنِّ عَبدي بي ، إنْ خيرًا","result":"فَخيرٌ","explicit":true,"otherNeedIds":[48],"ref":"السلسلة الصحيحة 1663","srcLabel":"أحمد","text":["إنَّ اللهَ تعالى يقولُ : أنا عندَ ",["ظَنِّ عَبدي بي ، إنْ خيرًا",1]," ",["فَخيرٌ",2]," ، و إنْ شَرًّا فَشَرٌّ"],"grade":"صحيح","narrator":"واثلة بن الأسقع.","muhaddith":"إسناده صحيح بلفظ آخر","takhrij":"أخرجه أحمد (16979)، وابن أبي الدنيا في ((حسن الظن بالله)) (2)، وابن حبان (1643)، والطبراني في ((المعجم الأوسط)) (7951) بلفظه وفيه قصة.","bab":"رقائق وزهد › الجزاء من جنس العمل","dorar":"U4pADjjQ"},{"id":"س-05845","fp":"8f14d417e946","stateId":219,"easy":"إذا أحسنت الظن بربك ← فهو عند ظنك","cause":"أحسِنوا يا أيُّها النَّاسُ برَبِّ العالَمينَ الظَّنَّ","result":"فإنَّ الرَّبَّ عند ظنِّ عبدِه به","explicit":true,"otherNeedIds":[47],"ref":"المصابيح في الأحاديث المتواترة 582","srcLabel":"السنة","text":[["أحسِنوا يا أيُّها النَّاسُ برَبِّ العالَمينَ الظَّنَّ",1],"؛ ",["فإنَّ الرَّبَّ عند ظنِّ عبدِه به",2]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"رقائق وزهد › الوصايا النافعة","dorar":"RJvIiFPw"},{"id":"س-00916","fp":"bb5107ad66c0","stateId":219,"easy":"إذا لزمت ذكر الله وتلاوة القرآن ← يكون روحك في السماء وذكرك في الأرض","cause":"عَلَيْكَ بذِكرِ اللهِ وتلاوةِ القرآنِ","result":"فإنَّهُ رُوحُكَ في السماءِ وذكرُكَ في الأرضِ","explicit":true,"ref":"مجمع الزوائد 4/218","srcLabel":"أحمد","text":["أنَّ رجلًا جاءَهُ فقال أَوْصِني فقال سألْتَنِي عمَّا سألْتُ عنه رسولَ اللهِ صلَّى اللهُ عليه وسلَّم مِنْ قبلِكَ أُوصيكَ بِتَقْوَى اللهِ فَإِنَّهُ رأْسُ كُلِّ شيءٍ وعلَيْكَ بِالجِهَادِ فَإِنَّها رَهْبَانِيَّةُ الإسلامِ و",["عَلَيْكَ بذِكرِ اللهِ وتلاوةِ القرآنِ",1]," ",["فإنَّهُ رُوحُكَ في السماءِ وذكرُكَ في الأرضِ",2]],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"رجاله ثقات","takhrij":"أخرجه أحمد (11774) واللفظ له، والطبراني في ((الصغير)) (949)، والبيهقي في ((الآداب)) (835) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"PYQoHjdn","merged":2,"otherRefs":["صحيح الجامع 2543 (حسن)"]},{"id":"س-08163","fp":"4c5e18a398f7","stateId":219,"easy":"إذا جلست في مجالس الذكر ← تجلس معك الملائكة","cause":"مجالسَ الذِّكرِ","result":"فإذا وجدوا مجلِسَ ذِكرٍ جلسوا معهم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[23],"ref":"اجتماع الجيوش الإسلامية 50","srcLabel":"متفق عليه","text":["إنَّ للهِ ملائكةً سيَّارةً. يتِّبعونَ ",["مجالسَ الذِّكرِ",1]," . ",["فإذا وجدوا مجلِسَ ذِكرٍ جلسوا معهم",2],". وإذا تفرَّقوا صعِدوا إلى ربِّهِم"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده على شرط مسلم وأصله عنده","takhrij":"أخرجه البخاري (6408)، ومسلم (2689) بنحوه","bab":"ملائكة › أعمال الملائكة","dorar":"xgBQi3D7"},{"id":"س-01080","fp":"fe7e14c10d8d","stateId":219,"easy":"إذا حمدت وسبحت وكبرت وهللت ← تتعاطف كلماتك حول العرش تذكّر بك","cause":"التَّحميدِ، والتَّسبيحِ، والتَّكبيرِ، والتَّهليلِ","result":"يَتعاطَفْنَ حولَ العَرشِ، لهُنَّ دَوِيٌّ كدَوِيِّ النَّحلِ يَقُلنَ لصاحِبِهِنَّ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-01164","ref":"المستدرك على الصحيحين 1865","text":["الَّذين يَذكُرونَ اللهَ مِن جلالِ اللهِ ",["التَّحميدِ، والتَّسبيحِ، والتَّكبيرِ، والتَّهليلِ",1],"؛ ",["يَتعاطَفْنَ حولَ العَرشِ، لهُنَّ دَوِيٌّ كدَوِيِّ النَّحلِ يَقُلنَ لصاحِبِهِنَّ",2],"، ألا يُحِبُّ أَحدُكُم أنْ يكونَ له عندَ الرَّحمنِ شيءٌ يَذكُرُهُ به؟"],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"صحيح الإسناد","bab":"أدعية وأذكار › فضل الذكر","dorar":"jjxIcCOt","merged":2,"otherRefs":["صحيح الترغيب 1568 (صحيح)"]},{"id":"س-07901","fp":"a4ccfe1f9102","stateId":219,"easy":"إذا مرضت ← يذكرك الله","cause":"أتحبون ألا تمرضوا","result":"وما خيرُ أحدِكم ألا يذكرَه اللهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[9],"ref":"المتجر الرابح 297","srcLabel":"ابن أبي الدنيا","text":["عن رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ أنه قال لأصحابِه: ",["أتحبون ألا تمرضوا",1],"؟ قالوا: واللهِ إنا لنحبُّ العافيةَ فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ",["وما خيرُ أحدِكم ألا يذكرَه اللهُ",2],"."],"grade":"حسن","narrator":"عبدالله بن خبيب","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه ابن أبي الدنيا في ((المرض والكفارات)) (243) واللفظ له.","bab":"مريض › فضل المرض والنوائب","dorar":"E9HLaM4U"},{"id":"س-00869","fp":"0b54c3df6fb2","stateId":220,"easy":"إذا تقربت إلى الله شبراً ← يتقرب إليك ذراعاً","cause":"وإن تَقَرَّبَ مِنِّي شِبرًا","result":"تَقَرَّبتُ إليه ذِراعًا","explicit":true,"star":true,"similar":["س-03159","س-01052"],"ref":"صحيح مسلم 2675","srcLabel":"متفق عليه","text":["يقولُ اللهُ عزَّ وجلَّ: أنا عِندَ ظَنِّ عَبدي بي، وأنا معهُ حينَ يَذكُرُني، إن ذَكَرَني في نَفسِه ذَكَرتُه في نَفسي، وإن ذَكَرَني في مَلَإٍ ذَكَرتُه في مَلَإٍ هُم خَيرٌ منهم، ",["وإن تَقَرَّبَ مِنِّي شِبرًا",1]," ",["تَقَرَّبتُ إليه ذِراعًا",2],"، وإن تَقَرَّبَ إلَيَّ ذِراعًا تَقَرَّبتُ منه باعًا، وإن أتاني يَمشي أتَيتُه هَرولةً. وفي روايةٍ: بهذا الإسنادِ، ولَم يَذكُرْ: وإن تَقَرَّبَ إلَيَّ ذِراعًا تَقَرَّبتُ منه باعًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7405)، ومسلم (2675).","bab":"أدعية وأذكار › فضل الذكر","dorar":"CgGdDKn0","merged":6,"otherRefs":["تخريج المسند لشعيب 21374 (صحيح)","تخريج المسند لشعيب 12405 (صحيح)","المستدرك على الصحيحين 7834 (صحيح)","صحيح الجامع 4304 (صحيح)","صحيح البخاري 7536 (صحيح)"]},{"id":"س-03159","fp":"8e621bae5598","stateId":220,"easy":"إذا تقربت من الله شبراً ← يتقرب منك ذراعاً، وذراعاً يتقرب باعاً","cause":"ومَن تَقَرَّبَ مِنِّي شِبرًا","result":"تَقَرَّبتُ منه ذِراعًا، ومَن تَقَرَّبَ مِنِّي ذِراعًا تَقَرَّبتُ منه باعًا، ومَن أتاني يَمشي أتَيتُه هَرولةً","explicit":true,"repOf":"س-00869","ref":"صحيح مسلم 2687","text":["يقولُ اللهُ عَزَّ وجَلَّ: مَن جاءَ بالحَسَنةِ فله عَشرُ أمثالِها وأزيدُ، ومَن جاءَ بالسَّيِّئةِ فجَزاؤُه سَيِّئةٌ مِثلُها أو أغفِرُ، ",["ومَن تَقَرَّبَ مِنِّي شِبرًا",1]," ",["تَقَرَّبتُ منه ذِراعًا، ومَن تَقَرَّبَ مِنِّي ذِراعًا تَقَرَّبتُ منه باعًا، ومَن أتاني يَمشي أتَيتُه هَرولةً",2],"، ومَن لَقيَني بقُرابِ الأرضِ خَطيئةً لا يُشرِكُ بي شيئًا لَقيتُه بمِثلِها مَغفِرةً. وفي روايةٍ: فله عَشرُ أمثالِها، أو أزيدُ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"إيمان › توحيد الأسماء والصفات","dorar":"D1po7pkJ","merged":8,"otherRefs":["تخريج المسند لشعيب 10909 (صحيح)","تخريج المسند لشعيب 14013 (صحيح)","مجمع الزوائد 10/200 (صحيح)","صحيح مسلم 2675 (صحيح)","صحيح الجامع 4304 (صحيح)","صحيح البخاري 7536 (صحيح)","مجمع الزوائد 10/199 (صحيح)"]},{"id":"س-03833","fp":"6c1aed030830","stateId":220,"easy":"إذا وصلت الرحم ← يصلك الله","cause":"مَن وصَلَكِ","result":"أنْ أصِلَ مَن وصَلَكِ","explicit":true,"star":true,"similar":["س-07458"],"otherNeedIds":[35,24],"ref":"تخريج المسند لشعيب 9871","srcLabel":"البخاري","text":["إنَّ الرَّحِمَ شِجنَةٌ مِن الرَّحمنِ، تَقولُ: يا رَبِّ إنِّي قُطِعتُ، يا رَبِّ إنِّي ظُلِمتُ، يا رَبِّ إنِّي أُسيءَ إليَّ، يا رَبِّ، يا رَبِّ، فيُجيبُها رَبُّها عزَّ وجلَّ، فيَقولُ: أمَا تَرضَيْنَ ",["أنْ أصِلَ مَن وصَلَكِ",2],"، وأقطَعَ مَن قطَعَكِ؟ حدَّثَناه أبو الوَليدِ، قال: حدَّثَنا شُعبةُ، عن محمدِ بنِ عَبدِ الجَبَّارِ، قال: سمِعتُ محمدَ بنَ كَعبٍ يَقولُ: سمِعتُ أبا هُرَيرةَ يَقولُ: سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: إنَّ الرَّحِمَ.. فذكَرَ الحَديثَ. وقال عَفَّانُ في حَديثِه: محمدُ بنُ عبدِ الجَبَّارِ مِن الأنصارِ، قال: سمِعتُ محمدَ بنَ كَعبٍ القُرَظيَّ قال: سمِعتُ أبا هُرَيرةَ يَقولُ: سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ.."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5988) بمعناه، وأحمد (9871) واللفظ له","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"Lsmkixfj","merged":12,"otherRefs":["الأربعون الصغرى 73 (صحيح)","صحيح البخاري 4830 (صحيح)","تخريج صحيح ابن حبان 444 (صحيح)","تخريج المسند لشعيب 2953 (صحيح)","المستدرك على الصحيحين 7494 (صحيح)","المستدرك على الصحيحين 3046 (صحيح)","تخريج صحيح ابن حبان 442 (صحيح)","المستدرك على الصحيحين 7479 (صحيح)","صحيح الأدب المفرد 46 (حسن)","السلسلة الصحيحة 1602 (حسن)","صحيح الأدب المفرد 40 (صحيح)"]},{"id":"س-07371","fp":"87f1ecda6294","stateId":220,"easy":"إذا قمت إلى الصلاة ← فأنت تناجي ربك","cause":"إذا قامَ إلى الصَّلاةِ","result":"فإنَّه يُناجي ربَّه","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 12959","srcLabel":"متفق عليه","text":["رَأى نُخامةً في قِبْلةِ المسجِدِ، فشَقَّ عليه حتى عَرَفْنا ذاكَ في وَجْهِه فحَكَّه، وقال: إنَّ أحَدَكُم أو المَرءَ ",["إذا قامَ إلى الصَّلاةِ",1],"، ",["فإنَّه يُناجي ربَّه",2]," -أو رَبُّه بينَه وبينَ القِبْلةِ-، فلْيَبْزُقْ إذا بَزَقَ عن يَسارِه، أو تحتَ قَدَمِه وأومَأَ هكذا كأنَّه في ثَوبِه، قال: وكُنَّا نقولُ لحُمَيدٍ فيقولُ: سُبحانَ اللهِ مَن هو يَعني النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، ولا يَزيدُنا عليه."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (405)، ومسلم (551)، وأحمد (13889) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › أحوال النبي","dorar":"3nRONkfp","merged":9,"otherRefs":["تخريج المسند لشاكر 7/63 (صحيح)","صحيح مسلم 551 (صحيح)","صحيح الجامع 752 (صحيح)","صحيح البخاري 413 (صحيح)","تخريج صحيح ابن حبان 1783 (صحيح)","تخريج المسند لشعيب 13451 (صحيح)","تخريج المسند لشعيب 4877 (صحيح)","صحيح البخاري 416 (صحيح)"]},{"id":"س-00870","fp":"1778351a84e9","stateId":220,"easy":"إذا أتيت الله تمشي ← يأتيك هرولة","cause":"وإن أتاني يَمشي","result":"أتَيتُه هَرولةً","explicit":true,"star":true,"similar":["س-00954"],"ref":"صحيح مسلم 2675","srcLabel":"متفق عليه","text":["يقولُ اللهُ عزَّ وجلَّ: أنا عِندَ ظَنِّ عَبدي بي، وأنا معهُ حينَ يَذكُرُني، إن ذَكَرَني في نَفسِه ذَكَرتُه في نَفسي، وإن ذَكَرَني في مَلَإٍ ذَكَرتُه في مَلَإٍ هُم خَيرٌ منهم، وإن تَقَرَّبَ مِنِّي شِبرًا تَقَرَّبتُ إليه ذِراعًا، وإن تَقَرَّبَ إلَيَّ ذِراعًا تَقَرَّبتُ منه باعًا، ",["وإن أتاني يَمشي",1]," ",["أتَيتُه هَرولةً",2],". وفي روايةٍ: بهذا الإسنادِ، ولَم يَذكُرْ: وإن تَقَرَّبَ إلَيَّ ذِراعًا تَقَرَّبتُ منه باعًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7405)، ومسلم (2675).","bab":"أدعية وأذكار › فضل الذكر","dorar":"CgGdDKn0","merged":3,"otherRefs":["تخريج المسند لشعيب 7422 (صحيح)","صحيح الجامع 8141 (صحيح)"]},{"id":"س-01052","fp":"84fd1593c496","stateId":220,"easy":"إذا اقتربت إلى الله شبراً ← يقترب إليك ذراعاً","cause":"وإن اقترَبَ إليَّ شِبْرًا","result":"اقترَبْتُ إليه ذِراعًا","explicit":true,"repOf":"س-00869","ref":"تخريج المسند لشعيب 7422","text":["يَقولُ اللهُ عزَّ وجلَّ: أنا مع عَبْدي حين يَذْكُرُني، فإنْ ذكَرَني في نَفْسِه ذكَرْتُه في نَفْسي، وإنْ ذكَرَني في مَلَإٍ، ذكَرْتُه في مَلَإٍ هُم خَيْرٌ مِنهم، ",["وإن اقترَبَ إليَّ شِبْرًا",1]," ",["اقترَبْتُ إليه ذِراعًا",2],"، فإنِ اقترَبَ إليَّ ذِراعًا اقترَبْتُ إليه باعًا، فإنْ أتاني يَـمْشي أتَيْتُه هَرْوَلةً، وقال ابنُ نُـمَيْرٍ في حَديثِه: أنا عِنْدَ ظَنِّ عَبْدي بي، وأنا معَه حين يَذْكُرُني."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (7405)، ومسلم (2675)، والترمذي (3603)، والنسائي في ((السنن الكبرى)) (7730)، وابن ماجه (3822)، وأحمد (7422) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"24Sg0grd","merged":3,"otherRefs":["تخريج صحيح ابن حبان 328 (صحيح)","صحيح الجامع 8141 (صحيح)"]},{"id":"س-00279","fp":"4cb5c45097bf","stateId":220,"easy":"إذا عفوت ← تكون أقرب إلى الله","cause":"أيُّهما عَفا","result":"فهو أَقرَبُ إلى اللهِ عَزَّ وجَلَّ","explicit":true,"star":true,"ref":"الأحاديث المختارة 11 / 245","srcLabel":"متفق عليه","text":["عن ابنِ عبَّاسٍ: «{وَأَنْ تَعْفُوا أَقْرَبُ لِلتَّقْوَى}، قالَ: ",["أيُّهما عَفا",1]," ",["فهو أَقرَبُ إلى اللهِ عَزَّ وجَلَّ",2],"»."],"grade":"صحيح","narrator":"عطاء","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"ajOf3QZE"},{"id":"س-00954","fp":"ecfc538c4aa7","stateId":220,"easy":"إذا جئت الله تمشي ← يأتيك هرولة","cause":"ومَن جاءني يمشي","result":"جِئْتُه أُهَروِلُ","explicit":true,"repOf":"س-00870","ref":"تخريج صحيح ابن حبان 328","text":["الكبرياءُ ردائي والعظمةُ إزاري فمَن نازَعني في واحدةٍ منهما قذَفْتُه في النَّارِ ومَن اقتَرَب إليَّ شبرًا اقترَبْتُ منه ذراعًا ومَن اقتَرَب منِّي ذراعًا اقترَبْتُ منه باعًا ",["ومَن جاءني يمشي",1]," ",["جِئْتُه أُهَروِلُ",2]," ومَن جاءني يُهروِلُ جِئْتُه أسعى ومَن ذكَرني في نفسِه ذكَرْتُه في نفسي ومَن ذكَرني في ملأٍ ذكَرْتُه في ملأٍ أكثَرَ منهم وأطيَبَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حديث صحيح إسناده قوي","takhrij":"أخرجه البخاري (7405) مختصراً بلفظ مقارب، ومسلم (2620، 2675) مفرقاً بنحوه من حديث أبي هريرة وأبي سعيد الخدري رضي الله عنهما","bab":"أدعية وأذكار › فضل الذكر","dorar":"VsMBRNQH"},{"id":"س-01053","fp":"a327d3c271af","stateId":220,"easy":"إذا اقتربت إليه ذراعاً ← يقترب إليك باعاً","cause":"فإنِ اقترَبَ إليَّ ذِراعًا","result":"اقترَبْتُ إليه باعًا","explicit":true,"ref":"تخريج المسند لشعيب 7422","srcLabel":"متفق عليه","text":["يَقولُ اللهُ عزَّ وجلَّ: أنا مع عَبْدي حين يَذْكُرُني، فإنْ ذكَرَني في نَفْسِه ذكَرْتُه في نَفْسي، وإنْ ذكَرَني في مَلَإٍ، ذكَرْتُه في مَلَإٍ هُم خَيْرٌ مِنهم، وإن اقترَبَ إليَّ شِبْرًا اقترَبْتُ إليه ذِراعًا، ",["فإنِ اقترَبَ إليَّ ذِراعًا",1]," ",["اقترَبْتُ إليه باعًا",2],"، فإنْ أتاني يَـمْشي أتَيْتُه هَرْوَلةً، وقال ابنُ نُـمَيْرٍ في حَديثِه: أنا عِنْدَ ظَنِّ عَبْدي بي، وأنا معَه حين يَذْكُرُني."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (7405)، ومسلم (2675)، والترمذي (3603)، والنسائي في ((السنن الكبرى)) (7730)، وابن ماجه (3822)، وأحمد (7422) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"24Sg0grd"},{"id":"س-03883","fp":"9c7d67bc93ac","stateId":220,"easy":"إذا قمت في جوف الليل الآخر ← فهو أقرب ما يكون الرب من عبده","cause":"جوفُ الليلِ الآخِرُ","result":"أقرَبَ ما يكونُ الربُّ عزَّ وجلَّ مِن العبدِ","explicit":true,"apply":{"k":"time","t":"في الليل"},"otherNeedIds":[28],"ref":"تخريج مشكل الآثار 3971","srcLabel":"البخاري","text":["قال لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّ ",["أقرَبَ ما يكونُ الربُّ عزَّ وجلَّ مِن العبدِ",2]," ",["جوفُ الليلِ الآخِرُ",1],"، فإنِ استطعتَ أنْ تكونَ ممَّن يذكُرُ اللهَ عزَّ وجلَّ في تلك الساعةِ، فافعَلْ؛ فإنَّ الصَّلاةَ محضورةٌ مشهودةٌ إلى طلوعِ الشَّمسِ، فإذا طلَعتْ فإنَّها تطلُعُ بينَ قَرْنَيْ شيطانٍ، وهي ساعةُ صلاةِ الكفَّارِ؛ فدَعِ الصَّلاةَ حتى تَرتفِعَ ويَذهَبَ شُعاعُها -قال معاويةُ: وأمَّا ضَمْرَةُ فقال: حتى تَرتفِعَ قِيدَ رُمحٍ- ثمَّ الصَّلاةُ محضورةٌ مشهودةٌ إلى أنْ يَنتصِفَ النهارُ، وإنَّها ساعةُ تُفتَحُ أبوابُ جهنَّمَ وتُسْجَرُ؛ فدَعِ الصَّلاةَ حتى يَفِيءَ الفَيْءُ، ثمَّ الصَّلاةُ محضورةٌ مشهودةٌ إلى غروبِ الشَّمسِ، فإنَّها تغرُبُ بينَ قَرْنَيْ شيطانٍ، وهي ساعةُ صلاةِ الكفَّارِ."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"إسناده صحيح على شرط البخاري.","takhrij":"أخرجه الطحاوي (922)، واللفظ له، والنسائي (572)، وابن المنذر في ((الأوسط)) (1832)، باختلاف يسير.","bab":"تراويح وتهجد وقيام ليل › فضل قيام الليل","dorar":"mS0KZha8"},{"id":"س-03960","fp":"4a5825abb502","stateId":220,"easy":"إذا بررت أمك ← فلا عمل أقرب إلى الله منه","cause":"مِن برِّ الوالدةِ","result":"لا أعلمُ عملًا أقربَ إلى اللهِ عزَّ وجلَّ","explicit":true,"otherNeedIds":[35],"ref":"صحيح الأدب المفرد 4","srcLabel":"البخاري","text":["عن ابنِ عبَّاسٍ أنَّهُ أتاهُ رجلٌ فقال إنِّي خطبتُ امرأةً فأبَتْ أن تَنكِحَني وخطبَها غَيري فأحبَّتْ أن تنكِحَهُ فغِرْتُ علَيها فقتلتُها فهلْ لي مِن تَوبةٍ قال أُمُّكَ حيَّةٌ قال لا قال تُبْ إلى اللهِ عزَّ وجلَّ وتقرَّبْ إليهِ ما استطعتَ [ قال عطاءُ بنُ يسارٍ ] فذهبتُ فسألتُ ابنَ عبَّاسٍ لِمَ سألتَهُ عن حياةِ أُمِّهِ فقال إنِّي ",["لا أعلمُ عملًا أقربَ إلى اللهِ عزَّ وجلَّ",2]," ",["مِن برِّ الوالدةِ",1]],"grade":"صحيح","narrator":"عطاء بن يسار","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (4) ، واللالكائي في ((شرح أصول الاعتقاد)) (1957) ، وابن الجوزي في ((التبصرة)) (1/ 190) جميعا بلفظه .","bab":"توبة › الحض على التوبة","dorar":"2Snkxt6j"},{"id":"س-01089","fp":"456ec44b1188","stateId":220,"easy":"إذا تقربت من الله ذراعاً ← يتقرب منك باعاً","cause":"ومَن تقَرَّبَ مِن اللهِ ذِراعًا","result":"تَقرَّبَ اللهُ منه باعًا","explicit":true,"ref":"المستدرك على الصحيحين 7834","srcLabel":"مسلم","text":["مَن ذَكَرَ اللهَ تعالَى في نفْسِه ذَكَرُه اللهُ تعالَى في نفْسِه، ومَن ذَكَرَ اللهَ في مَلأٍ ذَكَرَه اللهُ في مَلَأٍ هُم أكثَرُ مِن الملأِ الَّذينَ ذَكَرهُ فيهم وأطَيَبُ، ومَن تقرَّبَ إلى اللهِ شِبرًا تقرَّبَ اللهُ منه ذِراعًا، ",["ومَن تقَرَّبَ مِن اللهِ ذِراعًا",1]," ",["تَقرَّبَ اللهُ منه باعًا",2],"، ومَن أتى اللهَ مَشْيًا أتاهُ هَرْولةً، ومَن أتى اللهَ هَرْولةً أتاهُ اللهُ سَعْيًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه مسلم (2675)، وأحمد (10619)، وابن حبان (376) مختصرًا.","bab":"أدعية وأذكار › فضل الذكر","dorar":"Ncgb3lTT","merged":2,"otherRefs":["تخريج المسند لشعيب 21374 (صحيح)"]},{"id":"س-00037","fp":"f08deb77035c","stateId":220,"easy":"إذا سجدت ← تكون أقرب ما تكون من ربك فأكثر الدعاء","cause":"من ربِّهِ عزَّ وجلَّ وَهوَ ساجدٌ فأَكثروا الدُّعاءَ","result":"أقربُ ما يَكونُ العبدُ","explicit":true,"similar":["س-06504"],"otherNeedIds":[28],"ref":"صحيح النسائي 1136","srcLabel":"مسلم","text":[["أقربُ ما يَكونُ العبدُ",2],[" من ربِّهِ عزَّ وجلَّ وَهوَ ساجدٌ فأَكثروا الدُّعاءَ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (482)","bab":"آداب الدعاء › استجابة الدعاء","dorar":"toy1SCP7"},{"id":"س-01092","fp":"6f1548813a1f","stateId":220,"easy":"إذا دنوت من الله شبراً ← يدنو منك ذراعاً","cause":"إنْ دَنَوْتَ مِنِّي شِبرًا","result":"دَنَوْتُ منكَ ذِراعًا","explicit":true,"ref":"المستدرك على الصحيحين 7833","srcLabel":"مسلم","text":["قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يقولُ اللهُ عزَّ وجلَّ: ابنَ آدمَ، ",["إنْ دَنَوْتَ مِنِّي شِبرًا",1]," ",["دَنَوْتُ منكَ ذِراعًا",2],"، وإنْ دَنَوتَ مِنِّي ذِراعًا دَنوْتُ منكَ باعًا، ابنَ آدَمَ، إنْ حَدَّثْتَ نفْسَكَ بحَسَنةٍ فلَمْ تعْمَلْها كتَبْتُها لكَ حَسنةً، وإنْ عمِلْتَها كَتَبْتُها لكَ عشْرًا، وإنْ هَمَمْتَ بسَيِّئةٍ فحَجَزَكَ عنْها هَيْبَتي كَتَبْتُها لكَ حَسنةً، وإنْ عَمِلْتَها كتَبْتُها سيِّئةً واحدةً."],"grade":"صحيح","narrator":"أبو ذر","muhaddith":"صحيح الإسناد","takhrij":"أخرجه مسلم (2687)، وابن ماجه (3821)، والبزار (3988)، والطبراني في ((المعجم الأوسط)) (1714) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"c1RSotrC"},{"id":"س-01093","fp":"e3d193d8cd4c","stateId":220,"easy":"إذا دنوت منه ذراعاً ← يدنو منك باعاً","cause":"وإنْ دَنَوتَ مِنِّي ذِراعًا","result":"دَنوْتُ منكَ باعًا","explicit":true,"ref":"المستدرك على الصحيحين 7833","srcLabel":"مسلم","text":["قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يقولُ اللهُ عزَّ وجلَّ: ابنَ آدمَ، إنْ دَنَوْتَ مِنِّي شِبرًا دَنَوْتُ منكَ ذِراعًا، ",["وإنْ دَنَوتَ مِنِّي ذِراعًا",1]," ",["دَنوْتُ منكَ باعًا",2],"، ابنَ آدَمَ، إنْ حَدَّثْتَ نفْسَكَ بحَسَنةٍ فلَمْ تعْمَلْها كتَبْتُها لكَ حَسنةً، وإنْ عمِلْتَها كَتَبْتُها لكَ عشْرًا، وإنْ هَمَمْتَ بسَيِّئةٍ فحَجَزَكَ عنْها هَيْبَتي كَتَبْتُها لكَ حَسنةً، وإنْ عَمِلْتَها كتَبْتُها سيِّئةً واحدةً."],"grade":"صحيح","narrator":"أبو ذر","muhaddith":"صحيح الإسناد","takhrij":"أخرجه مسلم (2687)، وابن ماجه (3821)، والبزار (3988)، والطبراني في ((المعجم الأوسط)) (1714) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"c1RSotrC"},{"id":"ق-1449","fp":"109c74669b72","stateId":220,"easy":"السجود ← القرب من الله","cause":"السجود","result":"القرب من الله","explicit":true,"apply":{"k":"time","t":"في السجود"},"ref":"سورة العلق: 19","srcLabel":"القرآن الكريم","quran":{"s":96,"from":19,"to":19,"text":"كَلَّا لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبْ (19)","hl":[[20,41,1]]}},{"id":"س-06584","fp":"b2a742da2d5c","stateId":220,"easy":"إذا صليت ← فالصلاة قربان","cause":"والصَّلاةُ","result":"قُربانٌ","explicit":true,"ref":"المستدرك على الصحيحين 8522","srcLabel":"السنة","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قال لكَعبِ بنِ عُجْرةَ: أعاذَكَ اللهُ يا كعْبُ مِن إمارةِ السُّفهاءِ، قال: وما إمارةُ السُّفهاءِ يا رَسولَ اللهِ؟ قال: أُمراءُ يكونونَ بعْدي، لا يَهْدُون بهَدْيي، ولا يَسْتنُّون بسُنَّتي، فمَن صَدَّقهم بكَذِبِهم وأعانَهم على ظُلمِهم، فأولئكَ ليْسوا منِّي، ولسْتُ منهم، ولا يَرِدُون علَيَّ حَوْضي، ومَن لم يُصدِّقْهم بكَذِبِهم ولم يُعِنْهم على ظُلمِهم، فأولئكَ منِّي وأنا منْهم، وسيَرِدُون علَيَّ حَوْضي. يا كَعْبُ بنَ عُجْرةَ، الصَّومُ جُنَّةٌ، والصَّدقةُ تُطفِئُ الخطيئةَ، ",["والصَّلاةُ",1]," ",["قُربانٌ",2],"، أو قال: بُرهانٌ. يا كَعْبُ بنَ عُجْرةَ، لا يَدخُلُ الجنَّةَ لحْمٌ نبَتَ مِن سُحتٍ أبدًا، النَّارُ أَولى به. يا كَعْبُ بنَ عُجْرةَ، النَّاسُ غاديانِ؛ فمُبتاعٌ نفْسَه فمُعتِقُها، أو قال: فمُوبِقُها."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح الإسناد، ولم يخرجاه","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"0TB3rhhe","merged":5,"otherRefs":["صحيح الموارد 2166 (صحيح)","صحيح الترغيب 866 (صحيح)","تخريج صحيح ابن حبان 1723 (صحيح)","تخريج المسند لشعيب 15284 (صحيح)"]},{"id":"س-02229","fp":"f890a420603d","stateId":220,"easy":"إذا قمت الليل ← فهو دأب الصالحين وقربة إلى الله ومنهاة عن الإثم","cause":"عليكُم بقيامِ اللَّيلِ","result":"فإنَّهُ دَأْبُ الصَّالِحينَ قبلَكُم ، و قُربةٌ إلى اللهِ تعالى ومَنهاةٌ عن الإثمِ و تَكفيرٌ للسِّيِّئاتِ ، ومَطردةٌ للدَّاءِ عن الجسَدِ","explicit":true,"apply":{"k":"time","t":"في الليل"},"otherNeedIds":[11,18,33],"ref":"صحيح الجامع 4079","srcLabel":"السنة","text":[["عليكُم بقيامِ اللَّيلِ ، ",1],["فإنَّهُ دَأْبُ الصَّالِحينَ قبلَكُم ، و قُربةٌ إلى اللهِ تعالى ومَنهاةٌ عن الإثمِ و تَكفيرٌ للسِّيِّئاتِ ، ومَطردةٌ للدَّاءِ عن الجسَدِ",2]],"grade":"صحيح","narrator":"بلال وأبو أمامة وأبو الدرداء وسلمان وجابر بن عبدالله","muhaddith":"صحيح","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"1CsdkLV1","merged":4,"otherRefs":["تخريج الإحياء للعراقي 1/466 (حسن)","تمام المنة 244 (صحيح)","الأحكام الوسطى 2/53 (صحيح)"]},{"id":"س-02163","fp":"3188004fa983","stateId":220,"easy":"إذا جاهدت في سبيل الله ← فهو أقرب العمل إلى الله","cause":"الجهادُ في سبيلِ اللهِ","result":"أقربُ العملِ إلى اللهِ عزَّ وجلَّ","explicit":true,"otherNeedIds":[40],"ref":"السلسلة الصحيحة 3938","srcLabel":"البخاري","text":[["أقربُ العملِ إلى اللهِ عزَّ وجلَّ",2]," : ",["الجهادُ في سبيلِ اللهِ",1]," ، ولا يُقارِبُه شيءٌ ؛ [ إلَّا من كان مثلَ هذا ، وأشار النَّبيُّ صلَّى اللهُ عليه وسلَّم إلى قائمٍ لا يفترُ من قيامٍ وصيامٍ ]"],"grade":"حسن","narrator":"فضالة بن عبيد","muhaddith":"إسناده حسن","takhrij":"أخرجه البخاري في ((التاريخ الكبير)) (4/ 152) واللفظ له، والحاكم في ((معرفة علوم الحديث)) (صـ232) بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"hRpPXWAX"},{"id":"س-00134","fp":"f9f4038a950d","stateId":220,"easy":"إذا بدأت بالسلام ← تكون أولى الناس بالله","cause":"مَن بدأهُم بالسَّلامِ","result":"إنَّ أولَى النَّاسِ باللَّهِ تَعالى","explicit":true,"similar":["س-00161","س-03698"],"ref":"الصحيح المسند 477","srcLabel":"أبو داود","text":[["إنَّ أولَى النَّاسِ باللَّهِ تَعالى",2]," ",["مَن بدأهُم بالسَّلامِ",1]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5197)، وابن مردويه في ((مجالسه)) (7)، والبيهقي في ((شعب الإيمان)) (8787) واللفظ لهم، وأحمد (22192) بنحوه.","bab":"آداب السلام › إفشاء السلام","dorar":"avIklvTE","merged":2,"otherRefs":["الآداب الشرعية 1/401 (حسن)"]},{"id":"س-05909","fp":"f1d58ed9245c","stateId":220,"easy":"إذا لزمت القرآن ← فلن ترجع إلى الله بشيء أحب إليه منه","cause":"شيءٍ خَرَجَ منه؛ يعني القرآنَ","result":"لن تَرجِعوا إلى اللهِ بشيءٍ أَحبَّ إليه مِن","explicit":true,"similar":["س-04693"],"otherNeedIds":[41,40],"ref":"المستدرك على الصحيحين 3696","srcLabel":"البيهقي","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ تلا: {إِنَّ الَّذِينَ كَفَرُوا بِالذِّكْرِ لَمَّا جَاءَهُمْ وَإِنَّهُ لَكِتَابٌ عَزِيزٌ (41) لَّا يَأْتِيهِ الْبَاطِلُ مِن بَيْنِ يَدَيْهِ وَلَا مِنْ خَلْفِهِ تَنزِيلٌ مِّنْ حَكِيمٍ حَمِيدٍ} [فصلت: 41، 42] فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «إنَّكم ",["لن تَرجِعوا إلى اللهِ بشيءٍ أَحبَّ إليه مِن",2]," ",["شيءٍ خَرَجَ منه»؛ يعني القرآنَ",1],"."],"grade":"صحيح","narrator":"عقبة بن عامر الجهني","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((الأسماء والصفات)) (502) بلفظه.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"Yl20i0nk","merged":2,"otherRefs":["هداية الرواة 2/84 (حسن)"]},{"id":"س-06504","fp":"263035b03e29","stateId":220,"easy":"إذا سجدت ← تكون أقرب ما تكون من ربك","cause":"وهو ساجدٌ","result":"العبدَ أقربُ ما يكونُ من ربِّهِ","explicit":true,"repOf":"س-00037","otherNeedIds":[28],"ref":"مجموع الفتاوى 11/540","text":["بأنَّ ",["العبدَ أقربُ ما يكونُ من ربِّهِ",2]," ",["وهو ساجدٌ",1]],"grade":"صحيح","muhaddith":"ثابت","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"SQKExNYJ","merged":2,"otherRefs":["صحيح الجامع 1174 (صحيح)"]},{"id":"س-06676","fp":"1f36f54bcf62","stateId":220,"easy":"إذا وصلت صفاً ← يصلك الله","cause":"ومَن وصَلَ صفًّا","result":"وصَلَه اللهُ","explicit":true,"ref":"تخريج سنن أبي داود 666","srcLabel":"أبو داود","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال: أَقيموا الصُّفوفَ، وحاذُوا بينَ المَناكِبِ، وسُدُّوا الخَلَلَ، ولِينوا بأَيدي إخوانِكم -لم يقُلْ عيسى: بأَيدي إخوانِكم-، ولا تَذَروا فُرُجاتٍ للشيطانِ، ",["ومَن وصَلَ صفًّا ",1],["وصَلَه اللهُ، ",2],"ومَن قطَعَ صفًّا قطَعَه اللهُ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (666)، وأحمد (5724)، والطبراني (13/ 319) (14113) بلفظه.","bab":"صلاة الجماعة والإمامة › إقامة الصفوف ووصلها وفضائلها","dorar":"i7rw8Xc6","merged":2,"otherRefs":["صحيح الجامع 1187 (صحيح)"]},{"id":"س-06853","fp":"d9750a3fd085","stateId":220,"easy":"إذا صلّت المرأة في قعر بيتها ← تكون أقرب ما تكون من وجه ربها","cause":"وَهيَ في قَعرِ بيتِها","result":"وأقرَبُ ما تَكونُ مِن وجهِ ربِّها","explicit":true,"otherNeedIds":[41],"ref":"المحلى 4/201","srcLabel":"الترمذي","text":["إنَّما المرأةُ عَورةٌ فإذا خرجَت استشرَفَها الشَّيطانُ ، ",["وأقرَبُ ما تَكونُ مِن وجهِ ربِّها",2]," ",["وَهيَ في قَعرِ بيتِها",1]," صلاةُ المرأةِ في مَخدعِها أفضلُ من صلاتِها في بيتِها ، وصلاتُها في بيتِها أفضلُ من صلاتِها في حُجرتِها"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"احتج به ، وقال في المقدمة: (لم نحتج إلا بخبر صحيح من رواية الثقات مسند)","takhrij":"أخرجه الترمذي (1173)، وابن حبان (5598) مختصراً، وابن خزيمة (1685، 1690) مفرقاً","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"bCwOJksE","merged":2,"otherRefs":["مجمع الزوائد 2/38 (حسن)"]},{"id":"س-00161","fp":"d48d84aeff7e","stateId":220,"easy":"إذا بدأت بالسلام ← تكون أولى بالله","cause":"يبدأُ بالسَّلامِ","result":"أَولاَهُما باللَّهِ","explicit":true,"repOf":"س-00134","ref":"صحيح الترمذي 2694","text":["قيلَ يا رسولَ اللَّهِ ! الرَّجُلانِ يلتقيانِ ، أيُّهما ",["يبدأُ بالسَّلامِ",1]," ؟ فقالَ : ",["أَولاَهُما باللَّهِ",2],"."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5197)، وأحمد (22192) بمعناه، والترمذي (2694) واللفظ له","bab":"آداب السلام › فضل السلام والرد عليه","dorar":"hrpx2qnX"},{"id":"س-01003","fp":"a33e6bb02b3e","stateId":220,"easy":"إذا أديت الفرائض ← فهي أحب ما تتقرب به إلى الله","cause":"وما تقَرَّب إليَّ عَبْدي بمِثْلِ أداءِ ما افتَرَضْتُ عليه","result":"وما تقَرَّب إليَّ عَبْدي بمِثْلِ أداءِ ما افتَرَضْتُ عليه","explicit":true,"ref":"الفتاوى الكبرى 1/206","srcLabel":"السنة","text":["عن النَّبيِّ صلَّى اللهُ عليه وسلَّم أنَّه قال: يقولُ اللهُ تعالى: مَن عادى لي وَلِيًّا فقد بارَزَني بالمحارَبةِ، ",["وما تقَرَّب إليَّ عَبْدي بمِثْلِ أداءِ ما افتَرَضْتُ عليه",2],"، ولا يزالُ عَبْدي يتقَرَّبُ إليَّ بالنَّوافِلِ حتَّى أُحِبَّه، فإذا أحبَبْتُه كُنتُ سَمْعَه الذي يَسمَعُ به، وبَصَرَه الذي يُبصِرُ به، ويدَه التي يَبطِشُ بها، ورِجْلَه التي يمشي بها. فبي يَسْمَعُ، وبي يُبصِرُ، وبي يَبطِشُ، وبي يَمْشي، ولَئِنْ سَأَلني لأُعطِيَنَّه، ولئِنْ استعاذَني لأُعيذَنَّه، وما ترَدَّدْتُ في شَيءٍ أنا فاعِلُه ترَدُّدي في قَبْضِ نَفْسِ عَبْديَ المؤمِنِ؛ يَكرَهُ الموتَ وأكرَهُ مَساءَتَه، ولا بُدَّ له منه»"],"grade":"صحيح","muhaddith":"صحيح","bab":"أدعية وأذكار › فضل الذكر","dorar":"wJbFCjFe"},{"id":"س-03698","fp":"b1b883b6cbb8","stateId":220,"easy":"إذا بدأت بالسلام ← تكون أولى بالله ورسوله","cause":"مَن بَدَأَ بالسَّلامِ","result":"فهو أَولى باللهِ وبرَسولِه","explicit":true,"repOf":"س-00134","ref":"تخريج المسند لشعيب 22279","text":[["مَن بَدَأَ بالسَّلامِ ",1],["فهو أَولى باللهِ وبرَسولِه",2],"."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5197)، والترمذي (2694)، وأحمد (22279) واللفظ له","bab":"اعتصام بالسنة › لزوم السنة","dorar":"SQeuzgLx"},{"id":"س-04693","fp":"39c9b7bfe564","stateId":220,"easy":"إذا لزمت القرآن ← فلا ترجع إلى الله بشيء أفضل منه","cause":"القُرآنَ","result":"إنَّكم لا ترجِعون إلى الله تعالى بشيءٍ أفضَلَ ممَّا خرج منه","explicit":true,"repOf":"س-05909","otherNeedIds":[41],"ref":"الجامع الصغير 2528","text":[["إنَّكم لا ترجِعون إلى الله تعالى بشيءٍ أفضَلَ ممَّا خرج منه",2],"، يعني ",["القُرآنَ",1],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (2065)، والبيهقي في ((الأسماء والصفات)) (503)","bab":"رقائق وزهد › أي الأعمال أفضل","dorar":"n1yJdeUr"},{"id":"س-06106","fp":"0e3e1223da72","stateId":220,"easy":"إذا أحببت المساكين وقرّبتهم ولم تردّهم ولو بشق تمرة ← يقرّبك الله يوم القيامة","cause":"لا ترُدِّي المِسكينَ ولو بشِقِّ تَمرةٍ، يا عائشةُ، أحِبِّي المساكينَ، وقَرِّبيهم","result":"فإنَّ اللهَ يقرِّبُكِ يومَ القيامَةِ","explicit":true,"otherNeedIds":[53],"ref":"صحيح الترمذي 2352","srcLabel":"الترمذي","text":["اللَّهمَّ أَحيِني مِسكينًا، وأَمِتْني مِسكينًا، واحشُرني في زُمرةِ المساكينِ يومَ القيامَةِ، فقالَت عائِشةُ: لِمَ يا رسولَ اللهِ؟ قال: إنَّهم يَدخُلون الجنَّةَ قبلَ أغنيائِهم بأربعين خريفًا، يا عَائشةُ، ",["لا ترُدِّي المِسكينَ ولو بشِقِّ تَمرةٍ، يا عائشةُ، أحِبِّي المساكينَ، وقَرِّبيهم؛ ",1],["فإنَّ اللهَ يقرِّبُكِ يومَ القيامَةِ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2352)، وابن الجوزي في ((الموضوعات)) (3/142) واللفظ لهما، والبيهقي (13530) باختلاف يسير.","bab":"رقائق وزهد › معيشة النبي صلى الله عليه وسلم","dorar":"lZXofWHa"},{"id":"س-07930","fp":"932c94cdc254","stateId":220,"easy":"إذا عدت المريض ← وجدت الله عنده","cause":"لو عُدْتَه","result":"لَوجَدْتَني","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-02296"],"otherNeedIds":[40],"ref":"تخريج صحيح ابن حبان 944","srcLabel":"مسلم","text":["يقولُ اللهُ جلَّ وعلا للعبدِ يومَ القيامةِ : يا ابنَ آدَمَ مرِضْتُ فلَمْ تَعُدْني فيقولُ يا ربِّ كيفَ أعُودُكَ وأنتَ ربُّ العالَمينَ ؟ فيقولُ : أمَا علِمْتَ أنَّ عبدي فلانًا مرِض فلَمْ تَعُدْه أمَا علِمْتَ أنَّكَ ",["لو عُدْتَه",1]," ",["لَوجَدْتَني",2]," ويقولُ : يا ابنَ آدَمَ استسقَيْتُكَ فلَمْ تسقِني ؟ فيقولُ : يا ربِّ كيف أسقيكَ وأنتَ ربُّ العالَمينَ ؟ فيقولُ : أمَا علِمْتَ أنَّ عبدي فلانًا استسقاك فلَمْ تسقِه ؟ أمَا علِمْتَ أنَّك لو سقَيْتَه لَوجَدْتَ ذلكَ عندي يا ابنَ آدَمَ استطعَمْتُكَ فلَمْ تُطعِمْني فيقولُ : يا ربِّ وكيفَ أُطعِمُكَ وأنتَ ربُّ العالَمينَ ؟ فيقولُ : ألَمْ تعلَمْ أنَّ عبدي فلانًا استطعَمكَ فلَمْ تُطعِمْه أمَا لو أنَّكَ أطعَمْتَه لَوجَدْتَ ذلكَ عندي"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (2569) باختلاف يسير","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"gz3WxKb8","merged":2,"otherRefs":["مجموع فتاوى ابن باز 67/3 (صحيح)"]},{"id":"س-00666","fp":"95d81ae62755","stateId":220,"easy":"إذا صليت ← فأنت تناجي ربك","cause":"المُصلِّيَ","result":"يُناجي ربَّهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج سير أعلام النبلاء 14/ 165","srcLabel":"النسائي","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ خرَجَ على النَّاسِ وهُمْ يُصلُّونَ، وقد عَلَتْ أصواتُهُمْ بالقراءةِ، فقال: إنَّ ",["المُصلِّيَ",1]," ",["يُناجي ربَّهُ",2],"؛ فَلْينظُرْ بما يُناجيهِ بهِ، ولا يَجهَرْ بعضُكُمْ على بعضٍ بالقرآنِ."],"grade":"صحيح","narrator":"فروة بن عمرو البياضي","muhaddith":"إسناده صحيح","takhrij":"أخرجه مالك (1/80) واللفظ له، وأخرجه أحمد (19022)، والنسائي في ((السنن الكبرى)) (3364) باختلاف يسير","bab":"أدعية وأذكار › استحباب خفض الصوت بالذكر","dorar":"hwM56XFL","merged":3,"otherRefs":["الاستذكار 1/479 (حسن)","فتاوى نور على الدرب لابن باز 11/324 (صحيح)"]},{"id":"س-02624","fp":"3c4404966ac6","stateId":220,"easy":"إذا أطعمت الجائع ← وجدت ذلك عند الله","cause":"ولو أطعمتَه","result":"لوجدتَ ذلك عندِي","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[40],"ref":"مجموع فتاوى ابن باز 67/3","srcLabel":"السنة","text":["قولُ اللهِ سبحانَه لعبدِه: مرضتُ فلم تعُدْني، وجُعتُ فلم تُطعمْني ... أما علمتَ أنك لو عُدتَه لوجدتنِي عندَه، ",["ولو أطعمتَه",1]," ",["لوجدتَ ذلك عندِي",2],"؟"],"grade":"صحيح","muhaddith":"صحيح","bab":"إيمان › الاحتساب والنية","dorar":"8q9TCZsd"},{"id":"س-06653","fp":"e3ed964080fc","stateId":220,"easy":"إذا صليت في جوف الليل الآخر ← فهي أقرب ساعة إلى الله","cause":"جَوفُ اللَّيلِ الآخرُ ، فَصلِّ ما بدا لَكَ حتَّى تصلِّيَ الصُّبحَ","result":"ساعةٍ أقرَبُ إلى اللَّهِ عزَّ وجلَّ مِن أُخرى","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"في الليل"},"ref":"صحيح النسائي 583","srcLabel":"النسائي","text":["أتيتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فقلتُ : يا رسولَ اللَّهِ ! مَن أسلمَ معَكَ ؟ قالَ : ( حرٌّ وعبدٌ ) قلتُ : هل مِن ",["ساعةٍ أقرَبُ إلى اللَّهِ عزَّ وجلَّ مِن أُخرى",2]," ؟ قالَ : نعَم . ",["جَوفُ اللَّيلِ الآخرُ ، فَصلِّ ما بدا لَكَ حتَّى تصلِّيَ الصُّبحَ",1]," ، ثمَّ انتَهِ حتَّى تطلعَ الشَّمسُ وما دامَت - وقالَ أيُّوبُ : فما دامت - كأنَّها حَجَفةٌ حتَّى تنتشرَ ، ثمَّ صلِّ ما بدا لَكَ حتَّى يقومَ العمودُ على ظلِّهِ ، ثمَّ انتَهِ حتَّى تزولَ الشَّمسُ ؛ فإنَّ جَهَنَّمَ تُسجَرُ نصفَ النَّهارِ ، ثمَّ صلِّ ما بدا لَكَ حتَّى تصلى العصرَ ، ثمَّ انتَهِ حتَّى تغربَ الشَّمسُ ؛ فإنَّها تغرُبُ بينَ قرنَي شيطانٍ وتطلعُ بينَ قرني شيطانٍ"],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (584) واللفظ له، وابن ماجه (1364)، وأحمد (17067)","bab":"صلاة › مواقيت الصلاة","dorar":"YrR5VBMt"},{"id":"س-07458","fp":"2546c6198a91","stateId":220,"easy":"إذا وصلت الرحم ← وصلك الله","cause":"من وصلَها","result":"وتقطَعُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03833","otherNeedIds":[35],"ref":"تخريج المسند لشاكر 11/45","text":["توضَعُ الرَّحمُ يومَ القيامةِ لَها حَجنةٌ كحَجنةِ المغزلِ تَكَلَّمُ بلسانٍ طلقٍ ذلقٍ فتصِلُ ",["من وصلَها",1]," ",["وتقطَعُ",2]," من قطعَها وقالَ عفَّانُ : المغزلُ وقالَ : بألسنةٍ لَها"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي شيبة (25902)، والطبراني (13/601) (14518)، والحاكم (7288) باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"COg3EXIZ"},{"id":"س-02296","fp":"d1f4b3fa8ee0","stateId":220,"easy":"إذا عدت المريض ← وجدت الله عنده","cause":"يَمرَضُ عَبْدي؛ فلو عِيدَ","result":"عِيدَ لي","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-07930","otherNeedIds":[41],"ref":"علل ابن أبي حاتم 1985","text":["حَديثٌ رَواه أبو صالِحٍ كاتِبُ اللَّيْثِ، عن اللَّيْثِ، عن عُبَيْدِ اللهِ بنِ أبي جَعْفَرٍ، عن صَفْوانَ بنِ سُلَيْمٍ، عن زَيدِ بنِ حُبابٍ، عن أبي سَعيدٍ مَوْلى أبي لَيْثٍ، عن أبي هُرَيْرةَ: أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم قالَ: قالَ اللهُ عَزَّ وجَلَّ: مَرِضْتُ فلم يَعُدْني عِبادي، وظَمِئْتُ فلم يَسْقِني عِبادي، قالَ: أنت يا رَبِّ؟! قالَ: نَعمْ: ",["يَمرَضُ عَبْدي؛ فلو عِيدَ",1]," ",["عِيدَ لي",2],"، ويَعطَشُ عَبْدي؛ فلو سُقِيَ سُقِيَ لي؟"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"قالُ أبو صالِحٍ: زَيدُ بنُ حُبابٍ، وغَيْرُه يقولُ: زَيدُ بنُ عَتَّابٍ، ومِنهم مَن يقولُ: زَيدُ بنُ أبي عَتَّابٍ، والصَّحيحُ: زَيدُ بنُ أبي عَتَّابٍ، وهو شَيْخٌ حِجازيٌّ، رَوى عنه الحِجازِيُّونَ.","takhrij":"أخرجه أحمد (9242)، والطبراني في ((الأوسط)) (8722) كلاهما بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"JpDsF2P4"},{"id":"س-02297","fp":"1554cd96f4a9","stateId":220,"easy":"إذا سقيت العطشان ← وجدت ذلك عند الله","cause":"ويَعطَشُ عَبْدي؛ فلو سُقِيَ","result":"سُقِيَ لي","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"otherNeedIds":[41],"ref":"علل ابن أبي حاتم 1985","srcLabel":"أحمد","text":["حَديثٌ رَواه أبو صالِحٍ كاتِبُ اللَّيْثِ، عن اللَّيْثِ، عن عُبَيْدِ اللهِ بنِ أبي جَعْفَرٍ، عن صَفْوانَ بنِ سُلَيْمٍ، عن زَيدِ بنِ حُبابٍ، عن أبي سَعيدٍ مَوْلى أبي لَيْثٍ، عن أبي هُرَيْرةَ: أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم قالَ: قالَ اللهُ عَزَّ وجَلَّ: مَرِضْتُ فلم يَعُدْني عِبادي، وظَمِئْتُ فلم يَسْقِني عِبادي، قالَ: أنت يا رَبِّ؟! قالَ: نَعمْ: يَمرَضُ عَبْدي؛ فلو عِيدَ عِيدَ لي، ",["ويَعطَشُ عَبْدي؛ فلو سُقِيَ",1]," ",["سُقِيَ لي",2],"؟"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"قالُ أبو صالِحٍ: زَيدُ بنُ حُبابٍ، وغَيْرُه يقولُ: زَيدُ بنُ عَتَّابٍ، ومِنهم مَن يقولُ: زَيدُ بنُ أبي عَتَّابٍ، والصَّحيحُ: زَيدُ بنُ أبي عَتَّابٍ، وهو شَيْخٌ حِجازيٌّ، رَوى عنه الحِجازِيُّونَ.","takhrij":"أخرجه أحمد (9242)، والطبراني في ((الأوسط)) (8722) كلاهما بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"JpDsF2P4"},{"id":"س-08225","fp":"defb38503f1b","stateId":221,"easy":"إذا استكت ثم قمت تقرأ ← يقوم الملك خلفك يستمع ويدنو","cause":"أُمِرْنا بالسِّواكِ","result":"أتاه المَلَكُ فقامَ خَلْفَه يَسْتمِعُ القُرآنَ، ويَدْنو، فلا يَزالُ يَسْتمِعُ ويَدْنو حتَّى يَضَعَ فاه على فيه، لا يَقرَأُ آيةً إلَّا كانَتْ في جَوْفِ المَلَكِ","explicit":true,"star":true,"otherNeedIds":[44],"ref":"الأحاديث المختارة 580","srcLabel":"البخاري","text":["«عن أبي عبد الرحمن السلمي، عن علي قال: ",["أُمِرْنا بالسِّواكِ",1],"، وقالَ: إنَّ العَبْدَ إذا قامَ يُصَلِّي ",["أتاه المَلَكُ فقامَ خَلْفَه يَسْتمِعُ القُرآنَ، ويَدْنو، فلا يَزالُ يَسْتمِعُ ويَدْنو حتَّى يَضَعَ فاه على فيه، لا يَقرَأُ آيةً إلَّا كانَتْ في جَوْفِ المَلَكِ",2],"»."],"grade":"صحيح","narrator":"أبو عبدالرحمن السلمي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"ملائكة › أعمال الملائكة","dorar":"FTIDI1Hd","merged":2,"otherRefs":["فيض القدير 4/ 225 (صحيح)"]},{"id":"س-03660","fp":"cd0e830519be","stateId":221,"easy":"إذا استكت ثم قرأت ← تقع قراءتك في فم الملك","cause":"يَأمُرُ بالسِّواكِ","result":"إلَّا وَقَعَتْ في فِي المَلَكِ","explicit":true,"star":true,"otherNeedIds":[44],"ref":"الأحاديث المختارة 581","srcLabel":"البخاري","text":["«أنَّه كانَ ",["يَأمُرُ بالسِّواكِ",1],"، ويَقولُ: الرَّجُلُ إذا قامَ في الصَّلاةِ [ .. ] ",["إلَّا وَقَعَتْ في فِي المَلَكِ",2],"، قالَ: قُلْتُ: هو عن النَّبيِّ صلَّى اللهُ عليه وسلَّمَ؟ قالَ: نَعمْ»."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"nFHVXChV"},{"id":"س-07367","fp":"56b3f8a8ed06","stateId":221,"easy":"إذا صليت ← فلا تضع أذى بين يديك فإن الله قِبَل وجهك","cause":"فلا توجِّهوا شيئًا مِنَ الأذَى بينَ أيديكُم","result":"فإنَّ اللَّهَ عزَّ وجلَّ بينَ أيديكُم في صلاتِكُم","explicit":true,"star":true,"ref":"صحيح ابن خزيمة 2/ 132","srcLabel":"متفق عليه","text":["رأى رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ نخامةً في قبلةِ المسجدِ، فاستبرأَها بعودٍ معَهُ، ثمَّ أقبلَ على القومِ، يعرفونَ الغضبَ في وجهِهِ، فقالَ: أيُّكم صاحبُ هذِهِ النُّخامةِ؟ فسَكَتوا، فقالَ: أيحبُّ أحدُكُم إذا قامَ يصلِّي أن يَستقبِلَهُ رجلٌ فيتنخَّعُ في وجهِهِ؟ فقالوا: لا قالَ: ",["فإنَّ اللَّهَ عزَّ وجلَّ بينَ أيديكُم في صلاتِكُم",2],"، ",["فلا توجِّهوا شيئًا مِنَ الأذَى بينَ أيديكُم",1],"، ولَكِن عَن يسارِ أحدِكُم أو تحتَ قدمِهِ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (408)، ومسلم (548) بنحوه.","bab":"فضائل النبي وصفته ودلائل النبوة › أحوال النبي","dorar":"E7pVz2nY"},{"id":"س-07694","fp":"243b950fbc3f","stateId":221,"easy":"إذا تغنّيت بالقرآن ← يستمع الله لك","cause":"يَتغنَّى بالقُرْآنِ","result":"ما يَأذَنُ اللهُ عزَّ وجلَّ لشَيءٍ ما يَأذَنُ لنَبيٍّ","explicit":true,"star":true,"similar":["س-01728"],"ref":"تخريج مشكل الآثار 1302","srcLabel":"متفق عليه","text":[["ما يَأذَنُ اللهُ عزَّ وجلَّ لشَيءٍ ما يَأذَنُ لنَبيٍّ",2]," ",["يَتغنَّى بالقُرْآنِ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (5023)، ومسلم (792) باختلاف يسير","bab":"قرآن › آداب الناس كلهم مع القرآن","dorar":"EvWqT2fK"},{"id":"س-08221","fp":"47009c71b42c","stateId":221,"easy":"إذا قرأت القرآن ← تدنو الملائكة لصوتك","cause":"اقْرَأْ يا ابنَ حُضَيرٍ","result":"ذلك المَلائِكةُ دَنَوا لصَوْتِك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-08112"],"ref":"الأحاديث المختارة 1464","srcLabel":"البخاري","text":["«قَرأْتُ اللَّيْلةَ سورةَ البَقَرةِ وفَرَسٌ له مَرْبوطٌ، ويَحْيى ابني مُضْطَجِعٌ قَريبٌ مِنِّي وهو غُلامٌ، فجالَتْ جَوْلةً فقُلْتُ: ليس لي هَمٌّ إلَّا ابني، فسَكَنَتْ، ثُمَّ قَرَأْتُ فجالَتِ الفَرَسُ، فقُمْتُ ليس لي هَمٌّ إلَّا ابني، ثُمَّ قَرَأْتُ فجالَتِ الفَرَسُ، فرَفَعْتُ رأسي فإذا شيءٌ كهَيْئةِ الظُّلَّةِ في مِثلِ المَصابيحِ مُقبِلٌ مِن السَّماءِ، فهالَتْني فسَكَنْتُ، فلمَّا أَصْبَحْتُ غَدَوْتُ على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فأَخبَرْتُه، فقالَ: اقْرَأْ يا أبا يَحْيى، قُلْتُ: قد قَرَأْتُ يا رَسولَ اللهِ فجالَتِ الفَرَسُ، فقُمْتُ وليس لي هَمٌّ إلَّا ابني، قالَ: قالَ: اقْرَأْ يا أبا يَحْيى، قُلْتُ: قد قَرَأْتُ يا رَسولَ اللهِ، فجالَتِ الفَرَسُ، وليس لي هَمٌّ إلَّا ابني، فقالَ: ",["اقْرَأْ يا ابنَ حُضَيرٍ",1],"، قالَ: قد قَرَأْتُ، فرَفَعْتُ رأسي فإذا كهَيْئةِ الظُّلَّةِ فيها مَصابيحُ فهالَتْني، فقالَ: ",["ذلك المَلائِكةُ دَنَوا لصَوْتِك",2],"، ولو قَرَأْتَ حتَّى تُصبِحَ لأَصبَحَ النَّاسُ يَنظُرونَ إليهم!»."],"grade":"صحيح","narrator":"أسيد بن حضير","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"ملائكة › أعمال الملائكة","dorar":"MbBzygQ2","merged":4,"otherRefs":["تخريج صحيح ابن حبان 779 (صحيح)","المستدرك على الصحيحين 2061 (صحيح)","شرح السنة 3/26 (صحيح)"]},{"id":"س-03612","fp":"d619bb43598e","stateId":221,"easy":"إذا قمت تصلي ← يقبل الله عليك بوجهه","cause":"الرَّجُلَ إذا قامَ يُصَلِّي","result":"أَقبَلَ اللهُ عليه بوجهِه","explicit":true,"ref":"شرح ابن ماجه لمغلطاي 3/654","srcLabel":"ابن ماجه","text":["أنَّه رأى شَبَثَ بنَ رِبعيٍّ بَزَقَ بين يديْهِ، فقال: يا شَبَثُ، لا تَبزُقْ بين يديْكَ؛ فإنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم كان يَنهى عن ذلك، وقال: إنَّ ",["الرَّجُلَ إذا قامَ يُصَلِّي",1]," ",["أَقبَلَ اللهُ عليه بوجهِه",2],"، حتى يَنقلِبَ أو يُحدِثَ حَدَثَ سوءٍ."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (1023) واللفظ له، وابن خزيمة (924) والبزار (2889) بنحوه","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"b4PecsXh","merged":4,"otherRefs":["مختصر الصواعق المرسلة 419 (صحيح)","السلسلة الصحيحة 1062 (صحيح)","طرح التثريب 2/382 (صحيح)"]},{"id":"س-01728","fp":"0efda1e004e0","stateId":221,"easy":"إذا تغنّيت بالقرآن (حسّنت صوتك به) ← يأذن الله لك ويستمع","cause":"يَتَغَنَّى بالقُرآنِ","result":"ما أذِنَ اللهُ لشيءٍ ما أذِنَ لنَبيٍّ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"repOf":"س-07694","ref":"صحيح مسلم 792","text":[["ما أذِنَ اللهُ لشيءٍ ما أذِنَ لنَبيٍّ",2]," ",["يَتَغَنَّى بالقُرآنِ",1],". [وفي روايةٍ]: كما يَأذَنُ لنَبيٍّ يَتَغَنَّى بالقُرآنِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5023)، ومسلم (792).","bab":"أنبياء › عام","dorar":"oJzEzpRe"},{"id":"س-08112","fp":"630cb3356b78","stateId":221,"easy":"إذا قرأت القرآن ← تستمع لك الملائكة","cause":"أقرَأُ في مِربَدي","result":"تلك المَلائِكةُ كانَت تَستَمِعُ لَكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-08221","ref":"صحيح مسلم 796","text":["أنَّ أُسَيدَ بنَ حُضَيرٍ بينَما هو لَيلةً يَقرَأُ في مِربَدِه إذ جالَت فرَسُه، فقَرَأ ثُمَّ جالَت أُخرى، فقَرَأ ثُمَّ جالَت أيضًا، قال أُسَيدٌ: فخَشيتُ أن تَطَأ يَحيى، فقُمتُ إليها فإذا مِثلُ الظُّلَّةِ فوقَ رَأسي فيها أمثالُ السُّرُجِ، عَرَجَت في الجَوِّ حتَّى ما أراها، قال: فغَدَوتُ على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقُلتُ: يا رَسولَ اللهِ بينَما أنا البارِحةَ مِن جَوفِ اللَّيلِ ",["أقرَأُ في مِربَدي",1],"، إذ جالَت فرَسي، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: اقرَأِ ابنَ حُضَيرٍ، قال: فقَرَأتُ، ثُمَّ جالَت أيضًا، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: اقرَأِ ابنَ حُضَيرٍ، قال: فقَرَأتُ، ثُمَّ جالَت أيضًا، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: اقرَأِ ابنَ حُضَيرٍ، قال: فانصَرَفتُ، وكان يَحيى قَريبًا منها، خَشيتُ أن تَطَأهُ، فرَأيتُ مِثلَ الظُّلَّةِ فيها أمثالُ السُّرُجِ عَرَجَت في الجَوِّ حتَّى ما أراها، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["تلك المَلائِكةُ كانَت تَستَمِعُ لَكَ",2],"، ولو قَرَأتَ لأصبَحَت يَراها النَّاسُ ما تَستَتِرُ منهم!"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري معلقاً بصيغة الجزم بعد حديث (5018) من حديث أسيد بن حضير رضي الله عنه","bab":"ملائكة › أعمال الملائكة","dorar":"c3pOevdG"},{"id":"س-00890","fp":"727038530d06","stateId":221,"easy":"إذا صليت ولم تلتفت ← ينصب الله وجهه لوجهك","cause":"ما لم يَلتفِتْ","result":"إنَّ اللهَ يَنصُبُ وجهَه لوجهِ عبدِه في صلاتِه","explicit":true,"similar":["س-06470"],"ref":"سنن الترمذي 2863","srcLabel":"أحمد","text":["إنَّ اللَّهَ أمرَ يحيى بنَ زَكَريَّا بخمسِ كلماتٍ أن يعملَ بِها ، ويأمرَ بني إسرائيل أن يعمَلوا بِها ، وإنَّهُ كادَ أن يُبْطِئَ بِها فقال عيسى: إنَّ اللهَ أمَرَك بخَمسِ كلماتٍ؛ لِتَعمَلَ بها وتَأمُرَ بَني إسرائيلَ أن يَعمَلوا بها، فإمَّا أن تَأمُرَهم، وإمَّا أنْ آمُرَهم، فقال يحيى: أخشى إن سبَقتَني بها أن يُخسَفَ بي أو أُعذَّبَ، فجمَع النَّاسَ في بيتِ المقدِسِ، فامتَلَأ المسجدُ وقعَدوا على الشُّرُفِ، فقال: \"إنَّ اللهَ أمَرني بخَمسِ كلماتٍ أن أَعمَلَ بِهنَّ، وآمرُكم أن تَعمَلوا بهنَّ: أوَّلُهنَّ أن تَعبُدوا اللهَ ولا تُشرِكوا به شيئًا، وإنَّ مَثلَ مَن أشرَك باللهِ كمثَلِ رجلٍ اشترى عبدًا مِن خالصِ مالِه بذهَبٍ أو ورِقٍ، فقال: هذه داري وهذا عمَلي، فاعمَلْ وأدِّ إليَّ، فكان يعمَلُ ويُؤدِّي إلى غيرِ سيِّدِه، فأيُّكم يَرضى أن يكونَ عبدُه كذلك؟! وإنَّ الله أمركم بالصَّلاة، فإذا صَلَّيتُم فلا تَلتَفِتوا؛ ف",["إنَّ اللهَ يَنصُبُ وجهَه لوجهِ عبدِه في صلاتِه",2]," ",["ما لم يَلتفِتْ",1],"، وآمرُكم بالصِّيامِ؛ فإنَّ مَثلَ ذلك كمثَلِ رجلٍ في عِصابةٍ معَه صُرَّةٌ فيها مِسكٌ، فكلَّهم يَعجَبُ أو يُعجِبُه ريحُها، وإنَّ ريحَ الصَّائمِ أطيبُ عندَ اللهِ مِن ريحِ المسكِ، وآمرُكم بالصَّدقةِ؛ فإنَّ مثَلَ ذلك كمثَلِ رجلٍ أسَره العدوُّ، فأوثَقوا يدَه إلى عنُقِه، وقدَّموه لِيَضرِبوا عُنقَه، فقال: أنا أَفْديه منكم بالقليلِ والكثيرِ، ففدَى نفسَه منهم، وآمُركم أن تَذكُروا اللهَ؛ فإنَّ مَثلَ ذلك كمَثلِ رجلٍ خرَج العدوُّ في أثَرِه سِراعًا حتَّى إذا أتى على حِصنٍ حَصينٍ، فأحرَز نفسَه منهم، كذلك العبدُ لا يُحرِزُ نفسَه مِن الشَّيطانِ إلَّا بذِكْرِ اللهِ\". قال النَّبيُّ صلَّى اللهُ علَيه وسلَّم: وأَنا آمرُكُم بخَمسٍ اللَّهُ أمرَني بِهِنَّ، السَّمعُ والطَّاعةُ والجِهادُ والهجرةُ والجمَاعةُ، فإنَّهُ مَن فارقَ الجماعةَ قيدَ شبرٍ فقد خلَعَ رِبقةَ الإسلامِ من عُنقِهِ إلَّا أن يراجِعَ، ومن ادَّعى دَعوى الجاهليَّةِ فإنَّهُ من جُثى جَهَنَّم، فقالَ رجلٌ: يا رسولَ اللَّهِ وإن صلَّى وصامَ؟ فقالَ: وإن صلَّى وصامَ، فادعوا بدَعوى اللَّهِ الَّذي سمَّاكمُ المسلِمينَ المؤمنينَ، عبادَ اللَّهِ"],"grade":"صحيح","narrator":"الحارث بن الحارث الأشعري","muhaddith":"حسن صحيح غريب","takhrij":"أخرجه أحمد (17170)، وابن خزيمة (930) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"p7zymDIJ","merged":2,"otherRefs":["جامع العلوم والحكم 1/130 (صحيح)"]},{"id":"س-02743","fp":"c0fbddc5ad14","stateId":221,"easy":"إذا قرأت القرآن بصوت حسن ← تستمع لك الملائكة","cause":"كان يَقرأُ وهو على ظَهرِ بيتِه","result":"فإنَّما هو ملَكٌ استَمَعَ القرآنَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 2060","srcLabel":"مسلم","text":["نحو [أنَّه ",["كان يَقرأُ وهو على ظَهرِ بيتِه",1],"، وهو حَسَنُ الصَّوتِ، فجاءَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: بيْنا أَقرأُ إذ غَشِيَني شيءٌ كالسَّحابِ والمرأةُ في البيتِ والفَرَسُ في الدَّارِ، فتخَوَّفتُ أنْ تَسقُطَ المرأةُ، وتَنفلِتَ الفَرَسُ فانصرفتُ، فقالَ له رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: اقرأْ يا أُسَيدُ؛ ",["فإنَّما هو ملَكٌ استَمَعَ القرآنَ",2],"] وقالَ فيه: قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: اقرأْ أُسَيدُ، اقرأْ أُسَيدُ؛ فإنَّ ذلك ملَكُ يَستمِعُ القرآنَ."],"grade":"صحيح","narrator":"أسيد بن حضير","muhaddith":"صحيح على شرط الشيخين\n وله شاهد على شرط مسلم","takhrij":"أخرجه البزار في ((مسنده)) (3209)، والفريابي في ((فضائل القرآن)) (96)، وأبو نعيم في ((معرفة الصحابة)) (880) واللفظ لهم.","bab":"إيمان › الملائكة","dorar":"MJ5abpir"},{"id":"س-06693","fp":"578abdfc6efa","stateId":221,"easy":"إذا صليت ولم تلتفت ← يبقى الله مقبلاً عليك","cause":"ما لم يَلتَفِتْ، فإذا صرَفَ وَجهَه، انصَرَفَ عنه","result":"لا يَزالُ اللهُ عزَّ وجلَّ مُقبِلًا على العَبدِ في صلاتِه","explicit":true,"ref":"تخريج المسند لشعيب 21508","srcLabel":"أبو داود","text":[["لا يَزالُ اللهُ عزَّ وجلَّ مُقبِلًا على العَبدِ في صلاتِه",2]," ",["ما لم يَلتَفِتْ، فإذا صرَفَ وَجهَه، انصَرَفَ عنه",1],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (909)، والنسائي (1195)، وأحمد (21508) واللفظ له","bab":"صلاة الجماعة والإمامة › الخشوع في الصلاة","dorar":"sRJM9DOF","merged":2,"otherRefs":["تخريج سنن أبي داود 909 (صحيح)"]},{"id":"س-06840","fp":"b9926a4c0b7a","stateId":221,"easy":"إذا أحسنت الوضوء ثم قمت إلى الصلاة ← يقبل الله عليك بوجهه","cause":"إذا توضَّأ فأحسنَ الوضوءَ ، ثمَّ قام إلى الصَّلاةِ","result":"أقبلَ اللهُ عليه بوَجههِ","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"otherNeedIds":[55,9],"ref":"مختصر الصواعق المرسلة 419","srcLabel":"السنة","text":["إنَّ العبدَ ",["إذا توضَّأ فأحسنَ الوضوءَ ، ثمَّ قام إلى الصَّلاةِ",1]," ",["أقبلَ اللهُ عليه بوَجههِ",2]," فلا ينصرِفَ عنه حتَّى ينصرفَ أو يُحدِثَ حدَثَ سوءٍ"],"grade":"صحيح","muhaddith":"صحيح","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"uhoHNHW3","merged":2,"otherRefs":["تخريج المسند لشعيب 22069 (صحيح)"]},{"id":"س-08152","fp":"6ded4dd0886f","stateId":221,"easy":"إذا استكت ثم قرأت ← يضع الملك فاه على فيك فيدخل جوفه ما تقرأ","cause":"فَلْيَسْتَكْ","result":"وضعَ مَلَكٌ فَاهُ على فيهِ ، و لا يخرجُ من فيهِ شيءٌ إلَّا دخلَ فَمَ المَلَكِ","explicit":true,"otherNeedIds":[44],"ref":"صحيح الجامع 720","srcLabel":"البيهقي","text":["إذا قامَ أحدُكُمْ يصلِّي مِنَ الليلِ، ",["فَلْيَسْتَكْ",1],"، فإنَّ أحدَكُمْ إذا قرأَ في صلاتِهِ، ",["وضعَ مَلَكٌ فَاهُ على فيهِ ، و لا يخرجُ من فيهِ شيءٌ إلَّا دخلَ فَمَ المَلَكِ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أبو نعيم كما في ((البدر المنير)) لابن الملقن (2/22)، والبيهقي في ((شعب الإيمان)) (2117) واللفظ له.","bab":"ملائكة › أعمال الملائكة","dorar":"3P1MlkxC","merged":2,"otherRefs":["عمدة القاري 6/262 (حسن)"]},{"id":"س-00912","fp":"d64a068d1dbd","stateId":221,"easy":"إذا قلت «لا إله إلا الله وحده لا شريك له...» ← يفتق الله لها السماء حتى ينظر إلى قائلها","cause":"ما قال عبدٌ قطُّ لا إلهَ إلَّا اللهُ وحدَه لا شريكَ له له الملكُ وله الحمدُ وهو على كلِّ شيءٍ قديرٍ مخلصًا بها روحُه مُصدِّقًا بها قلبُه ناطقًا بها لسانُه","result":"إلَّا فتَق اللهُ عزَّ وجلَّ له السَّماءَ فتقًا حتَّى ينظرَ إلى قائلِها من الأرضِ وحقٌّ لعبدٍ نظر اللهُ إليه أن يُعطيَه سؤلَه","explicit":true,"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ وحدَه لا شريكَ له له الملكُ وله الحمدُ وهو على كلِّ شيءٍ قديرٍ مخلصًا بها روحُه مُصدِّقًا بها قلبُه ناطقًا بها لسانُه إلَّا فتَق اللهُ عزَّ وجلَّ له السَّماءَ فتقًا حتَّى ينظرَ إلى قائلِها من الأرضِ وحقٌّ لعبدٍ نظر اللهُ إليه أن يُعطيَه سؤلَه»"},"otherNeedIds":[28],"ref":"الترغيب والترهيب 2/344","srcLabel":"النسائي","text":[["ما قال عبدٌ قطُّ لا إلهَ إلَّا اللهُ وحدَه لا شريكَ له له الملكُ وله الحمدُ وهو على كلِّ شيءٍ قديرٍ مخلصًا بها روحُه مُصدِّقًا بها قلبُه ناطقًا بها لسانُه",1]," ",["إلَّا فتَق اللهُ عزَّ وجلَّ له السَّماءَ فتقًا حتَّى ينظرَ إلى قائلِها من الأرضِ وحقٌّ لعبدٍ نظر اللهُ إليه أن يُعطيَه سؤلَه",2]],"grade":"صحيح","narrator":"رجلان من أصحاب النبي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9772) بلفظه، وابن خزيمة في التوحيد (2/905)، وأبو نعيم الأصبهاني في ((معرفة الصحابة)) (7312) كلاهما باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"bpY6YPhm"},{"id":"س-06470","fp":"4c9e1803c983","stateId":221,"easy":"إذا صليت فلم تلتفت ← ينصب الله وجهه لوجهك","cause":"فإذا نَصَبْتُم وُجوهَكُم فَلا تَلتَفِتوا","result":"فإنَّ اللهَ يَنصِبُ وَجْهَه لِوَجهِ عَبدِه حينَ يُصلِّي لَه، فلا يَصرِفْ عنه وَجْهَه حتَّى يَكونَ العَبدُ هو يَنصرِفُ","explicit":true,"repOf":"س-00890","ref":"صحيح ابن خزيمة 930","text":["أنَّ النَّبيَّ صلَّى اللهُ عليهِ وسلَّم حَدَّثَهم، قال: إنَّ اللهَ عزَّ وجلَّ أمَرَ يَحيى بنَ زَكريَّا بِخَمسِ كَلماتٍ يَعمَلُ بِهنَّ، ويَأمُرُ بَني إسرائيلَ أن يَعمَلوا بهِنَّ، قال: فكان يُبَطِّئُ بهنَّ، فقال له عيسى: إنَّك أُمِرْتَ بِخَمسِ كَلِماتٍ تَعمَلُ بِهِنَّ وتَأمُرُ بَني إسرائيلَ أنْ يَعمَلوا بِهنَّ، فإمَّا أن تَأمُرَهم بِهنَّ، وإمَّا أن أَقومَ فآمُرَهم بِهنَّ، قال يَحْيى: إنَّك إنْ تَسبِقْني بِهنَّ أَخافُ أن أُعذَّبَ أو يُخسفَ بي! فجَمَعَ بَني إسرائيلَ في بَيتِ المَقدِسِ حتَّى امتلَأَ المَسجِدُ، حتَّى جَلَسَ النَّاسُ عَلى الشُّرُفاتِ، فوَعَظ النَّاسَ، ثمَّ قال: إنَّ اللهَ عزَّ وجلَّ أَمَرَني بِخَمسِ كَلماتٍ أَعمَلُ بهنَّ وآمُرُكم أنْ تَعمَلوا بهنَّ؛ أُولاهنَّ أنْ لا تُشرِكوا باللهِ شَيئًا؛ فإنَّ مَن أَشركَ باللهِ مَثَلُه كَمثَلِ رَجلٍ اشتَرى عَبدًا مِن خالِصِ مالِه بِذَهَبٍ أو وَرِقٍ، ثمَّ قال لَه: هذه داري وعَمَلي، فاعمَلْ لي وَأدِّ إليَّ عَمَلَك، فجَعَلَ يَعمَلُ ويُؤدِّي عَمَلَه إلى سَيِّدِه، فأيُّكم يُحِبُّ أن يَكونَ له عَبدٌ كَذلك؛ يُؤدِّي عَمَلَه لِغيرِ سَيِّدِه؟! وأنَّ اللهَ هوَ خَلَقكُم ورَزَقَكم، فَلا تُشرِكوا باللهِ شَيئًا، وقال: إنَّ اللهَ عزَّ وجلَّ أَمرَكم بِالصَّلاةِ، ",["فإذا نَصَبْتُم وُجوهَكُم فَلا تَلتَفِتوا",1],"؛ ",["فإنَّ اللهَ يَنصِبُ وَجْهَه لِوَجهِ عَبدِه حينَ يُصلِّي لَه، فلا يَصرِفْ عنه وَجْهَه حتَّى يَكونَ العَبدُ هو يَنصرِفُ",2],"... وذَكَرَ الحَديثَ بِطولِه."],"grade":"صحيح","narrator":"الحارث بن الحارث الأشعري","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني في ((مسند الشاميين)) (2870) بلفظ مقارب، والترمذي (2863)، وأحمد (17800) بنحوه","bab":"صلاة › فرض الصلاة","dorar":"tJmtQiCL"},{"id":"س-06964","fp":"13d1c7cfef73","stateId":221,"easy":"إذا صليت ولم تصرف وجهك ← يقبل الله عليك بوجهه","cause":"ما لم يصرف وجهَهُ عنْهُ","result":"فاللَّهُ يُقبِلُ عليْهِ بوجهِهِ","explicit":true,"ref":"مختصر الصواعق المرسلة 418","srcLabel":"السنة","text":[["فاللَّهُ يُقبِلُ عليْهِ بوجهِهِ",2]," ",["ما لم يصرف وجهَهُ عنْهُ",1]],"grade":"صحيح","muhaddith":"صحيح","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"vGZj5ANv"},{"id":"س-07698","fp":"3c4adabb83d9","stateId":221,"easy":"إذا جهرت بالقرآن بصوت حسن ← يستمع الله إليك أشد الاستماع","cause":"الرَّجُلِ الحسَنِ الصَّوتِ بالقرآنِ يجهَرُ بِه","result":"للَّهُ أشدُ أَذَنًا","explicit":true,"ref":"الجامع الصغير 7177","srcLabel":"أحمد","text":[["للَّهُ أشدُ أَذَنًا",2]," إلى ",["الرَّجُلِ الحسَنِ الصَّوتِ بالقرآنِ يجهَرُ بِه",1]," من صاحبِ القيْنةِ إلى قَينتِه"],"grade":"صحيح","narrator":"فضالة بن عبيد","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجة (1340) واللفظ له، وأحمد (23947)، وابن حبان (754) دون قوله: يجهر به.","bab":"قرآن › آداب معلم القرآن ومتعلمه","dorar":"jRfXOO9C"},{"id":"س-08189","fp":"f031f3833f57","stateId":221,"easy":"إذا أحسنت الوضوء واستكت ثم صليت ← يطيف بك الملك ويدنو منك","cause":"فَأحسنَ الوُضُوءَ واسْتَنَّ ، ثُمَّ قامَ فَصلَّى","result":"أَطَافَ بهِ المَلَكُ ودَنا مِنْهُ ؛ حتى يَضَعَ فَاهُ على فيهِ ، فما يقرأُ إلَّا في فيهِ","explicit":true,"otherNeedIds":[44],"ref":"صحيح الجامع 723","srcLabel":"السنة","text":["إذا قامَ الرجلُ يَتَوَضَّأُ لَيْلا أوْ نَهارًا ",["فَأحسنَ الوُضُوءَ واسْتَنَّ ، ثُمَّ قامَ فَصلَّى",1]," ",["أَطَافَ بهِ المَلَكُ ودَنا مِنْهُ ؛ حتى يَضَعَ فَاهُ على فيهِ ، فما يقرأُ إلَّا في فيهِ",2]," ، وإذا لمْ يَسْتَنَّ أَطَافَ بهِ ، ولا يَضَعُ فَاهُ على فيهِ"],"grade":"صحيح","narrator":"ابن شهاب وعلي بن أبي طالب","muhaddith":"صحيح","bab":"ملائكة › أعمال الملائكة","dorar":"dRM4uiRO"},{"id":"س-01172","fp":"5df00f3580bb","stateId":221,"easy":"إذا قلت «سبحان الله» ← يقول الله: صدقت","cause":"إذا قُلْتَ: سُبحانَ اللهِ","result":"قال اللهُ: صدَقْتَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"apply":{"k":"say","t":"«سبحان الله»"},"otherNeedIds":[28,11],"ref":"الأحاديث المختارة 1613","srcLabel":"البخاري","text":["«جاء أعرابيٌّ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم فقال: يا رَسولَ اللهِ عَلِّمْني خيرًا، فأخذ النَّبيُّ صلَّى اللهُ عليه وسلَّم بيَدِه، فقال: قُلْ: سُبحانَ اللهِ، والحَمْدُ للهِ، ولا إلهَ إلَّا اللهُ، واللهُ أكبَرُ، قال: فعَقَد الأعرابيُّ على يَدِه، ثُمَّ مضى فتفَكَّرَ ثُمَّ رجَعَ، فتَبَسَّمَ النَّبيُّ صلَّى اللهُ عليه وسلَّم وقال: تفَكَّرَ البائِسُ! فجاء فقال: يا رَسولَ اللهِ، سُبحانَ اللهِ والحَمدُ للهِ ولا إلهَ إلَّا اللهُ واللهُ أكبَرُ، هذه لله، فما لي؟ فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: يا أعرابيُّ، ",["إذا قُلْتَ: سُبحانَ اللهِ",1],"، ",["قال اللهُ: صدَقْتَ",2],"، وإذا قُلْتَ: الحَمْدُ للهِ، قال اللهُ: صدَقْتَ، وإذا قُلْتَ: لا إلهَ إلَّا اللهُ، قال اللهُ: صدَقْتَ، وإذا قُلْتَ: اللهُ أكبَرُ، قال اللهُ: صدَقْتَ، فإذا قُلْتَ: اللَّهُمَّ اغفِرْ لي، قال اللهُ: فعَلْتُ، فإذا قُلْتَ: اللَّهُمَّ ارحَمْني، قال اللهُ: فعَلْتُ، وإذا قُلْتَ: اللَّهُمَّ ارزُقْني، قال اللهُ: قد فعَلْتُ. قال: فعقَدَ الأعرابيُّ على سَبعٍ في يَدِه، ثُمَّ وَلَّى»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"أدعية وأذكار › فضل الذكر","dorar":"Pr5NlKVo","merged":2,"otherRefs":["صحيح الترغيب 1564 (حسن)"]},{"id":"س-06939","fp":"e0fe7780f262","stateId":221,"easy":"إذا قرأت «الحمد لله رب العالمين» في صلاتك ← يقول الله: حمدني عبدي","cause":"الحَمدُ للَّهِ رَبِّ العالَمينَ","result":"قال اللهُ تَعالى: حَمِدَني عَبدي","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"apply":{"k":"say","t":"«الحمد لله رب العالمين»"},"ref":"صحيح مسلم 395","srcLabel":"متفق عليه","text":["مَن صَلَّى صَلاةً لَم يَقرَأْ فيها بأُمِّ القُرآنِ فهي خِداجٌ ثَلاثًا غَيرُ تَمامٍ. فقيلَ لأبي هُرَيرةَ: إنَّا نَكونُ وراءَ الإمامِ، فقال: اقرَأْ بها في نَفسِك؛ فإنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: قال اللهُ تَعالى: قَسَمتُ الصَّلاةَ بَيني وبينَ عَبدي نِصفَينِ، ولعَبدي ما سَألَ، فإذا قال العَبدُ: {",["الحَمدُ للَّهِ رَبِّ العالَمينَ",1],"}، ",["قال اللهُ تَعالى: حَمِدَني عَبدي",2],"، وإذا قال: {الرَّحمَنِ الرَّحيمِ}، قال اللهُ تَعالى: أثنى عليَّ عَبدي، وإذا قال: {مالِكِ يَومِ الدِّينِ}، قال: مَجَّدَني عَبدي، وقال مَرَّةً فوَّضَ إلَيَّ عَبدي، فإذا قال: {إيَّاك نَعبُدُ وإيَّاك نَستَعينُ} قال: هذا بَيني وبينَ عَبدي، ولعَبدي ما سَألَ، فإذا قال: {اهدِنا الصِّراطَ المُستَقيمَ صِراطَ الذينَ أنعَمتَ عليهم غيرِ المَغضوبِ عليهم ولا الضَّالِّينَ} قال: هذا لعَبدي، ولعَبدي ما سَألَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"pI0s2ud8","merged":2,"otherRefs":["صحيح ابن ماجه 3066 (صحيح)"]},{"id":"س-01218","fp":"0ec48e8138d9","stateId":221,"easy":"إذا أكثرت من «لا إله إلا الله» و«سبحان الله وبحمده» ← يستبشر الله بهما ويكثر ولوجهما عليه","cause":"أمَّا اللَّتانِ أُوصِيكَ بهِما","result":"فيستبشِرُ اللهُ بِهِما وصالِحُ خَلقِه ، وهما يُكثرانِ الوُلوجَ على اللهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«لا إله إلا الله» ثم «سبحان الله وبحمده»"},"ref":"صحيح الترغيب 1543","srcLabel":"النسائي","text":["قال نوحٌ لابنِهِ : إنِّي مُوصِيكَ بوصيَّةٍ وقاصِرُها لكي لا تنساها ؛ أُوصِيك باثنتَيْنِ ، وأنهاك عن اثنتيْنِ : ",["أمَّا اللَّتانِ أُوصِيكَ بهِما",1]," ؛ ",["فيستبشِرُ اللهُ بِهِما وصالِحُ خَلقِه ، وهما يُكثرانِ الوُلوجَ على اللهِ",2]," : أُوصِيك ب ( لا إلهَ إلَّا اللهُ ) ؛ فإنَّ السَّمواتِ والأرضِ لَو كانَتا حلقةً قَصمَتْهُما ، ولَو كانَتا في كفَّةٍ وزنتْهُما . وأُوصِيك ب ( سُبحانَ اللهِ وبِحَمدِه ) ؛ فإنَّهُما صلاةُ الخَلقِ ، وبهما يُرْزَقُ الخلقُ ،  وَإِنْ مِنْ شَيْءٍ إِلَّا يُسَبِّحُ بِحَمْدِهِ وَلَكِنْ لَا تَفْقَهُونَ تَسْبِيحَهُمْ إِنَّهُ كَانَ حَلِيمًا غَفُورًا  . وأمَّا اللَّتانِ أنهاك عَنهُما ؛ فيحتَجبُ اللهُ منهُما وصالِحُ خلقِه : أنهاكَ عن الشِّركِ والكِبْرِ ."],"grade":"صحيح","narrator":"رجل من الأنصار","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10600)، واللفظ له.","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"cBhXOPuB"},{"id":"س-04386","fp":"14d9adb1e3cf","stateId":222,"easy":"إذا أقمت الصلوات الخمس وصمت رمضان محتسباً ← تكون من أولياء الله","cause":"المُصلُّونَ، مَن يُقيمُ الصَّلاةَ الخمْسَ الَّتي كُتِبْنَ عليهِ، ويَصومُ رمَضانَ يَحتسِبُ صَوْمَه، يَرى أنَّه عليه حَقٌّ، ويُعطِي زكاةَ مالِه يَحتسِبُها، ويَجتنِبُ الكبائرَ الَّتي نَهى اللهُ عنها","result":"أولياءَ اللهِ","explicit":true,"star":true,"apply":{"k":"time","t":"في رمضان"},"ref":"المستدرك على الصحيحين 7875","srcLabel":"البيهقي","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال في حَجَّةِ الوداعِ: ألَا إنَّ ",["أولياءَ اللهِ",2]," ",["المُصلُّونَ، مَن يُقيمُ الصَّلاةَ الخمْسَ الَّتي كُتِبْنَ عليهِ، ويَصومُ رمَضانَ يَحتسِبُ صَوْمَه، يَرى أنَّه عليه حَقٌّ، ويُعطِي زكاةَ مالِه يَحتسِبُها، ويَجتنِبُ الكبائرَ الَّتي نَهى اللهُ عنها",1],".\n ثمَّ إنَّ رجُلًا سَألَه، فقالَ: يا رسولَ اللهِ، ما الكبائرُ؟ فقالَ: هي تِسعٌ: إشراكٌ باللهِ، وقتلُ نفْسِ المؤمنِ بغيرِ حَقٍّ، وفِرارُ يومِ الزَّحْفِ، وأكْلُ مالِ اليتيمِ، وأكلُ الرِّبا، وقذْفُ المُحصَنةِ، وعقوقُ الوالِدَيْنِ المُسلِمَيْنِ، واستحلالُ البيتِ الحرامِ قبْلتِكُم أحياءً وأمواتًا، ثمَّ قالَ: لا يَموتُ رجُلٌ لم يَعمَلْ هذه الكبائرَ، ويُقيمُ الصَّلاةَ، ويُؤتِي الزَّكاةَ؛ إلَّا كانَ معَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ في دارٍ أبوابُها مَصاريعُ مِن ذَهَبٍ."],"grade":"صحيح","narrator":"عمير","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي (6804)، والطحاوي في ((شرح مشكل الآثار)) (898)، واللالكائي في ((شرح أصول الاعتقاد)) (1913) جميعا باختلاف يسير.","bab":"جهاد › التولي والفرار من الزحف","dorar":"4leoYzs5","merged":3,"otherRefs":["تخريج مشكل الآثار 898 (حسن)","مشارع الأشواق 969 (حسن)"]},{"id":"س-06936","fp":"2e7e8b5fe78c","stateId":222,"easy":"إذا أحسنت الوضوء في بيتك ثم أتيت المسجد ← فأنت زائر الله وحق عليه أن يكرمك","cause":"مَنْ تَوَضَّأَ في بيتِهِ فَأَحْسَنَ الوَضوءَ ثمَّ أَتَى المسجِدَ","result":"فهو زَائِرُ اللهِ وحَقٌّ على المَزُورِ أنْ يُكْرِمَ الزائِرَ","explicit":true,"star":true,"otherNeedIds":[22],"ref":"مجمع الزوائد 4/34","srcLabel":"السنة","text":[["مَنْ تَوَضَّأَ في بيتِهِ فَأَحْسَنَ الوَضوءَ ثمَّ أَتَى المسجِدَ ",1],["فهو زَائِرُ اللهِ وحَقٌّ على المَزُورِ أنْ يُكْرِمَ الزائِرَ",2]],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"أحد إسناديه رجاله رجال الصحيح","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"lAtdDXDA"},{"id":"س-05382","fp":"4625d02e7e50","stateId":222,"easy":"إذا أردت أن تعلم ما لك عند الله ← فانظر ما لله عندك","cause":"فلْيَنظُرْ ما للهِ عندَهُ","result":"مَنْ أرادَ أنْ يعَلَمَ مَا لَهُ عندَ اللهِ","explicit":true,"star":true,"similar":["س-01079"],"ref":"صحيح الجامع 6006","srcLabel":"السنة","text":[["مَنْ أرادَ أنْ يعَلَمَ مَا لَهُ عندَ اللهِ ، ",2],["فلْيَنظُرْ ما للهِ عندَهُ",1]],"grade":"حسن","narrator":"أنس بن مالك وأبو هريرة وسمرة بن جندب","muhaddith":"حسن","bab":"رقائق وزهد › الجزاء من جنس العمل","dorar":"KscsHQbx","merged":2,"otherRefs":["حلية الأولياء 6/189 (حسن)"]},{"id":"س-06959","fp":"d5654451d584","stateId":222,"easy":"إذا أويت إلى الله (إلى مجلس الذكر) ← يؤويك الله","cause":"فأوى إلى اللهِ","result":"فآواه اللهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"time","t":"عند النوم"},"ref":"صحيح مسلم 2176","srcLabel":"السنة","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم بينَما هو جالِسٌ في المَسجِدِ والنَّاسُ معهُ، إذ أقبَلَ نَفَرٌ ثَلاثةٌ، فأقبَلَ اثنانِ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، وذَهَبَ واحِدٌ، قال: فوقَفا على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فأمَّا أحَدُهما فرَأى فُرجةً في الحَلقةِ فجَلَسَ فيها، وأمَّا الآخَرُ فجَلَسَ خَلفَهُم، وأمَّا الثَّالِثُ فأدبَرَ ذاهِبًا، فلَمَّا فرَغَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم قال: ألا أُخبِرُكُم عَنِ النَّفَرِ الثَّلاثةِ؟ أمَّا أحَدُهم ",["فأوى إلى اللهِ",1],"، ",["فآواه اللهُ",2],"، وأمَّا الآخَرُ فاستَحيا، فاستَحيا اللهُ منه، وأمَّا الآخَرُ فأعرَضَ، فأعرَضَ اللهُ عنه."],"grade":"صحيح","narrator":"أبو واقد الليثي","muhaddith":"[صحيح]","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"KoGQui4z","merged":2,"otherRefs":["تفسير القرآن العظيم 8/73 (صحيح)"]},{"id":"س-01476","fp":"4f49527f6aeb","stateId":222,"easy":"إذا توضأت ثم خرجت إلى المسجد ← فأنت زائر الله وحق على المزور أن يكرم زائره","cause":"إذا توضأَ الرجلُ المسلمُ ثمَّ خرجَ إلى المسجدِ","result":"فهوَ زائرُ اللهِ عز وجل وحقٌّ على المَزورِ أنْ يُكرِمَ زائرَهُ","explicit":true,"otherNeedIds":[22],"ref":"إتقان ما يحسن 2/532","srcLabel":"الطبراني","text":[["إذا توضأَ الرجلُ المسلمُ ثمَّ خرجَ إلى المسجدِ ",1],["فهوَ زائرُ اللهِ عز وجل وحقٌّ على المَزورِ أنْ يُكرِمَ زائرَهُ",2]],"grade":"حسن","narrator":"سلمان الفارسي","muhaddith":"إسناده جيد","takhrij":"أخرجه الطبراني (6/253) (6139) باختلاف يسير.","bab":"وضوء › فضل الوضوء","dorar":"IByG8fIh"},{"id":"س-03788","fp":"c8342b96ba31","stateId":222,"easy":"إذا قعدت في المسجد ← فقد زرت الله وحق على المزور إكرام زائره","cause":"من قعد في المسجدِ","result":"فقد زار اللهَ تعالى : وحقٌّ على المزورِ إكرامُ زائرِه","explicit":true,"otherNeedIds":[22],"ref":"إصلاح المساجد 169","srcLabel":"الطبراني","text":[["من قعد في المسجدِ ",1],["فقد زار اللهَ تعالى : وحقٌّ على المزورِ إكرامُ زائرِه",2]],"grade":"حسن","narrator":"سلمان الفارسي","muhaddith":"حسن","takhrij":"أخرجه الطبراني (6/ 253) (6139)، وابن صيداوي في ((معجم الشيوخ)) (ص324)، وابن بشران في ((الأمالي)) (1566) بنحوه.","bab":"بر وصلة › إكرام الزائر","dorar":"dcmVYzOq"},{"id":"س-08028","fp":"b4489183eff1","stateId":222,"easy":"إذا رددت المظالم إلى أهلها (وتقربت إلى الله) ← يكون سمعك وبصرك","cause":"حتى يَرُدَّ تِلْكَ الظَّلامَةَ إلى أهلِهِا","result":"فَأَكُونُ سَمْعَهُ الذي يسمعُ بِه، وأَكُونُ بَصَرَهُ الذي يُبْصِرُ بِه، ويكونُ من أوْلِيائِي وأَصْفيائِي, ويكونُ جَارِي مع النَّبيينَ والصِّدِّيقِينَ والشُّهَدَاءِ في الجنةِ","explicit":true,"otherNeedIds":[56],"ref":"جامع العلوم والحكم 2/333","srcLabel":"أبو نعيم","text":["إِنَّ اللهَ تَعالَى أوْحَى إِلَيَّ: يا أَخَا المرسلينَ ، ويا أَخَا المُنْذِرِينَ أنْذِرْ قَوْمَكَ أنْ لا يَدْخُلوا بَيْتًا من بُيُوتِي ولأَحَدٍ عندَهُمْ مَظْلِمَةٌ، فإني أَلْعَنَهُ ما دَامَ قائِمًا بين يَدَيَّ يصلَّى ",["حتى يَرُدَّ تِلْكَ الظَّلامَةَ إلى أهلِهِا",1],"، ",["فَأَكُونُ سَمْعَهُ الذي يسمعُ بِه، وأَكُونُ بَصَرَهُ الذي يُبْصِرُ بِه، ويكونُ من أوْلِيائِي وأَصْفيائِي, ويكونُ جَارِي مع النَّبيينَ والصِّدِّيقِينَ والشُّهَدَاءِ في الجنةِ",2]," ."],"grade":"حسن","narrator":"حذيفة بن اليمان","muhaddith":"إسناده جيد وهو غريب جدا","takhrij":"أخرجه أبو نعيم في ((حلية الأولياء)) ((6/ 116)) واللفظ له، وابن عساكر في ((تاريخ دمشق)) ((65/ 44)) بنحوه.","bab":"مظالم › تحريم الظلم","dorar":"ZaiwmmZL"},{"id":"س-07791","fp":"436e0e8c1e20","stateId":222,"easy":"إذا كنت من أهل القرآن ← فأنت من أهل الله وخاصته","cause":"هُم أَهْلُ القرآنِ","result":"أَهْلُ اللَّهِ وخاصَّتُهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[41,21],"ref":"الصحيح المسند 77","srcLabel":"السنة","text":["إنَّ للَّهِ أَهْلينَ منَ النَّاس قالوا : يا رسولَ اللَّهِ ، مَن هُم ؟ قالَ : ",["هُم أَهْلُ القرآنِ",1]," ، ",["أَهْلُ اللَّهِ وخاصَّتُهُ",2]," ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","bab":"قرآن › تعلم القرآن وتعليمه","dorar":"xIrEFGhZ","merged":2,"otherRefs":["صحيح الجامع 2165 (صحيح)"]},{"id":"س-01079","fp":"874048ba52c3","stateId":222,"easy":"إذا أردت أن تعلم منزلتك عند الله ← فانظر منزلة الله عندك","cause":"فليَنظُرْ كيف مَنزِلةُ اللهِ عندَهُ؛ فإنَّ اللهَ يُنزِلُ العبدَ منه حيثُ أَنزلَهُ مِن نفسِهِ","result":"مَنْ كان يُحِبُّ أنْ يَعلَمَ مَنزِلتَهُ عندَ اللهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-05382","ref":"المستدرك على الصحيحين 1844","text":["خَرَجَ علينا النَّبيُّ صلَّى اللهُ عليه وسلَّمَ، فقالَ: يا أَيُّها النَّاسُ، إنَّ للهِ سَرايا مِنَ الملائكةِ تَحِلُّ وتَقِفُ على مَجالسِ الذِّكرِ في الأرضِ، فارتَعوا في رياضِ الجنَّةِ، قالوا: وأين رياضُ الجنَّةِ يا رسولَ اللهِ؟ قالَ: مَجالِسُ الذِّكرِ، فاغْدوا ورُوحوا في ذِكْرِ اللهِ، وذكِّروهُ أنفُسَكم، ",["مَنْ كان يُحِبُّ أنْ يَعلَمَ مَنزِلتَهُ عندَ اللهِ ",2],["فليَنظُرْ كيف مَنزِلةُ اللهِ عندَهُ؛ فإنَّ اللهَ يُنزِلُ العبدَ منه حيثُ أَنزلَهُ مِن نفسِهِ",1],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح الإسناد","bab":"أدعية وأذكار › فضل الذكر","dorar":"10bUAbx3"},{"id":"س-03154","fp":"13bc8cb46bde","stateId":222,"easy":"إذا كان قلبك ليّناً وادعاً ← يسع معرفة الله ومحبته","cause":"قلبُ عَبدي المؤمنِ اللينِ الوادعِ","result":"ووسعَني","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"إتقان ما يحسن 2/515","srcLabel":"السنة","text":["قال اللهُ تعالى لمْ تسعْني سَمائِي ولا أرضِي ",["ووسعَني",2]," ",["قلبُ عَبدي المؤمنِ اللينِ الوادعِ",1]],"grade":"حسن","muhaddith":"له شاهد حسن","bab":"إيمان › توحيد الأسماء والصفات","dorar":"Q1ZprZDF"},{"id":"س-01589","fp":"2b1396b2155f","stateId":223,"easy":"إذا أكلت الثوم ← فلا تقترب من الملائكة والمصلين","cause":"فيها ريحُ الثُّومِ","result":"ومعي ملَكٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"star":true,"ref":"تخريج صحيح ابن حبان 2094","srcLabel":"مسلم","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم أُتي بقصعةٍ مِن ثريدٍ فيها ثومٌ فلم يأكُلْ منها وأرسَل إلى أبي أيُّوبَ وكان أبو أيُّوبَ يضَعُ يدَه حيثُ يرى يدَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم وضَع يدَه فلمَّا لم يرَ أثرَ يدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم لم يأكُلْ فأتى رسولَ اللهِ صلَّى اللهُ عليه وسلَّم فقال له: إنِّي لم أرَ أثرَ يدِك فيها فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( ",["فيها ريحُ الثُّومِ",1]," ",["ومعي ملَكٌ",2]," )"],"grade":"صحيح","narrator":"جابر بن سمرة","muhaddith":"إسناده حسن على شرط مسلم","takhrij":"أخرجه ابن حبان (2094) بلفظه، والترمذي (1807)، وأحمد (20898)، والحاكم (5938) جميعهم باختلاف يسير.","bab":"أطعمة › أكل الثوم والبصل والكراث","dorar":"qawVGF8D"},{"id":"س-01593","fp":"e41cc26a852d","stateId":223,"easy":"إذا أكلت ما له ريح كريهة ← تتأذى منه الملائكة","cause":"وإنه يأتيني [ مَن أُناجي ] من الملائكةِ","result":"فأكرهُ أن يشَمُّوا ريحَها","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"السلسلة الصحيحة 6/664","srcLabel":"مسلم","text":[["وإنه يأتيني [ مَن أُناجي ] من الملائكةِ",1]," ، ",["فأكرهُ أن يشَمُّوا ريحَها",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن خزيمة (1667) بلفظه، ومسلم (565)، وأبو داود (3823)، وابن حبان (2085) جميعا مطولا بنحوه.","bab":"أطعمة › أكل الثوم والبصل والكراث","dorar":"CtVX2OWP"},{"id":"س-01594","fp":"f700bed2f2b3","stateId":223,"easy":"إذا أكلت البصل ← تتأذى منه الملائكة","cause":"إنَّ فيه بَصَلًا","result":"مِن أجْلِ المَلَكِ الذي يَأتيني","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[30],"ref":"تخريج المسند لشعيب 23570","srcLabel":"أحمد","text":["أنَّ نبيَّ اللهِ صلَّى اللهُ عليه وسلَّمَ نَزَلَ في بيتِنا الأسفَلِ، وكُنتُ في الغُرْفةِ، فأُهريقَ ماءٌ في الغُرْفةِ، فقُمتُ أنا وأُمُّ أيُّوبَ بقَطيفةٍ لنا نَتَّبِعُ الماءَ؛ شَفَقةَ أنْ يَخلُصَ الماءُ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فنَزَلتُ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وأنا مُشفِقٌ، فقُلتُ: يا رسولَ اللهِ، إنَّه ليس يَنبَغي أنْ نكونَ فَوقَك، انتَقِلْ إلى الغُرْفةِ، فأمَرَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ بمَتاعِه فنُقِلَ، ومَتاعُه قَليلٌ، فقُلتُ: يا رسولَ اللهِ، كُنتَ تُرسِلُ إلَيَّ بالطَّعامِ، فأنظُرُ فإذا رَأيتُ أثَرَ أصابِعِكَ وَضَعتُ يَدي فيه، حتى إذا كان هذا الطَّعامُ الذي أرسَلتَ به إلَيَّ، فنَظَرتُ فيه فلمْ أرَ فيه أثَرَ أصابِعِكَ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: أجَلْ؛ ",["إنَّ فيه بَصَلًا",1],"، فكَرِهتُ أنْ آكُلَه ",["مِن أجْلِ المَلَكِ الذي يَأتيني",2],"، وأمَّا أنتُم فكُلوهُ."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (23570) واللفظ له، وابن أبي عاصم في ((الآحاد والمثاني)) (1885)، والشاشي في ((المسند)) (1134)","bab":"أطعمة › أكل الثوم والبصل والكراث","dorar":"XBrJYSzp"},{"id":"س-01595","fp":"3e45a06e9d89","stateId":223,"easy":"إذا أكلت البصل والكراث ← فاستحيِ من الملائكة","cause":"طَعامٍ مِن خُضْرةٍ، فيه بَصَلٌ أو كُرَّاثٌ","result":"أستَحْيِي مِن مَلائكةِ اللَّهِ تَعالَى","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"المستدرك على الصحيحين 7391","srcLabel":"ابن حبان","text":["أنَّه أرسَلَ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ ب",["طَعامٍ مِن خُضْرةٍ، فيه بَصَلٌ أو كُرَّاثٌ",1],"، فلم يَرَ فيه أثَرَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فأبى أنْ يأكُلَهُ، فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ما يَمنَعُكَ أنْ تَأكُلَ؟ قالَ: لم أرَ أثَرَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["أستَحْيِي مِن مَلائكةِ اللَّهِ تَعالَى",2],"، وليْسَ بِمُحَرَّمٍ."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه ابن خزيمة (1670)، وابن حبان (2092)، والطبراني في ((الكبير)) (4/ 157) (3996) باختلاف يسير.","bab":"أطعمة › أكل الثوم والبصل والكراث","dorar":"O99UuQ3K"}]}