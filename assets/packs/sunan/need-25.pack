{"schema":1,"kind":"sunan-chunk","version":"sunan-98a69b4361e7","needId":25,"stateIds":[261,262,263,264,265],"items":[{"id":"س-08116","fp":"a10f7f36da1e","stateId":261,"easy":"إذا شُتمت فسكتّ ← يرد عنك ملك، فإذا رددت حضر الشيطان","cause":"كان يَشتُمُني وأنتَ جالِسٌ","result":"إنَّه كان معك مَلَكٌ يَرُدُّ عنك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[8,34,26,4],"ref":"مجمع الزوائد 8/192","srcLabel":"مسلم","text":["أنَّ رَجُلًا شَتَمَ أبا بَكرٍ والنَّبيُّ صلَّى اللهُ عليه وسلَّم جالِسٌ، فجَعَلَ النَّبيُّ صلَّى اللهُ عليه وسلَّم يَعجَبُ ويَبتَسِمُ، فلمَّا أكثَرَ رَدَّ عليه بعضَ قَولِه، فغَضِبَ النَّبيُّ صلَّى اللهُ عليه وسلَّم وقامَ، فلَحِقَه أبو بَكرٍ، فقال: يا رسولَ اللهِ، ",["كان يَشتُمُني وأنتَ جالِسٌ",1],"، فلمَّا رَدَدتُ عليه بعضَ قَولِه، غَضِبتَ وقُمتَ! قال: ",["إنَّه كان معك مَلَكٌ يَرُدُّ عنك",2],"، فلمَّا رَدَدتَ عليه بعضَ قَولِه، وَقَعَ الشَّيطانُ، فلم أكُنْ لِأَقعُدَ مع الشَّيطانِ، ثم قال: يا أبا بَكرٍ، ثلاثٌ كُلُّهن حَقٌّ: ما مِن عَبدٍ ظُلِمَ بمَظلَمَةٍ فيُغْضي عنها للهِ عزَّ وجلَّ، إلَّا أعزَّ اللهُ بها نَصْرَه، وما فَتَحَ رَجُلٌ بابَ عَطيَّةٍ يُريدُ بها صِلَةً، إلَّا زادَه بها كثْرَةً، وما فَتَحَ بابَ مَسأَلةٍ يُريدُ بها كثْرَةً، إلَّا زادَه اللهُ بها قِلَّةً."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (9624) بلفظه، ومسلم (2588)، والترمذي (2029) بنحوه.","bab":"ملائكة › أعمال الملائكة","dorar":"LZZkcHK6","merged":7,"otherRefs":["تخريج سنن أبي داود 4897 (حسن)","إتحاف الخيرة المهرة 6/71 (حسن)","تخريج شرح السنة 3586 (حسن)","مجمع الزوائد 8/78 (صحيح)","سبل السلام 4/298 (صحيح)","الفروع لابن مفلح 10/ 121 (حسن)"]},{"id":"ق-0707","fp":"1408ce45be90","stateId":261,"easy":"قتل المظلوم ← نصرة الله لوليّه","cause":"قتل المظلوم","result":"نصرة الله لوليّه","explicit":true,"ref":"سورة الإسراء: 33","srcLabel":"القرآن الكريم","quran":{"s":17,"from":33,"to":33,"text":"وَلَا تَقْتُلُوا النَّفْسَ الَّتِي حَرَّمَ اللَّهُ إِلَّا بِالْحَقِّ وَمَنْ قُتِلَ مَظْلُومًا فَقَدْ جَعَلْنَا لِوَلِيِّهِ سُلْطَانًا فَلَا يُسْرِفْ فِي الْقَتْلِ إِنَّهُ كَانَ مَنْصُورًا (33)","hl":[[69,94,1],[94,133,2],[133,163,1],[163,187,2]]}},{"id":"ق-0816","fp":"d70b63ac7ccd","stateId":261,"easy":"الظلم الواقع على المؤمنين وإخراجهم بغير حق ← نصر الله لهم","cause":"الظلم الواقع على المؤمنين وإخراجهم بغير حق","result":"نصر الله لهم","explicit":true,"ref":"سورة الحج: 39","srcLabel":"القرآن الكريم","quran":{"s":22,"from":39,"to":39,"text":"أُذِنَ لِلَّذِينَ يُقَاتَلُونَ بِأَنَّهُمْ ظُلِمُوا وَإِنَّ اللَّهَ عَلَى نَصْرِهِمْ لَقَدِيرٌ (39)","hl":[[0,52,1],[52,94,2]]}},{"id":"ق-0829","fp":"5f164b49d52b","stateId":261,"easy":"البغي على من انتصر بمثل ما عوقب به (المظلوم) ← نصر الله له","cause":"البغي على من انتصر بمثل ما عوقب به (المظلوم)","result":"نصر الله له","explicit":true,"ref":"سورة الحج: 60","srcLabel":"القرآن الكريم","quran":{"s":22,"from":60,"to":60,"text":"ذَلِكَ وَمَنْ عَاقَبَ بِمِثْلِ مَا عُوقِبَ بِهِ ثُمَّ بُغِيَ عَلَيْهِ لَيَنْصُرَنَّهُ اللَّهُ إِنَّ اللَّهَ لَعَفُوٌّ غَفُورٌ (60)","hl":[[7,70,1],[70,93,2]]}},{"id":"س-00638","fp":"7b3d5b432a3c","stateId":261,"easy":"إذا وصلت من قطعك وحلمت على من جهل عليك وأحسنت إلى من أساء ← لا يزال معك من الله ظهير","cause":"أصِلُهم ويَقطَعوني، وأحلُمُ عنهم ويَجهَلون علَيَّ، وأُحسِنُ إليهم ويُسيئون إليَّ","result":"ولا يَزالُ معكَ مِن اللهِ ظَهيرٌ عليهم مادمتَ على ذلك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[37],"ref":"تخريج المسند لشعيب 9343","srcLabel":"مسلم","text":["أتى رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ رَجُلٌ، فقال: يا رسولَ اللهِ، إنَّ لي قَرابةً ",["أصِلُهم ويَقطَعوني، وأحلُمُ عنهم ويَجهَلون علَيَّ، وأُحسِنُ إليهم ويُسيئون إليَّ",1],". فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنْ كان كما تَقولُ؛ لكأنَّما تُسِفُّهم المَلَّ، ",["ولا يَزالُ معكَ مِن اللهِ ظَهيرٌ عليهم مادمتَ على ذلك",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2558)، وأحمد (9343) واللفظ له","bab":"آداب عامة › ضرب الأمثال","dorar":"FHf4RWJE","merged":4,"otherRefs":["تخريج صحيح ابن حبان 450 (صحيح)","صحيح الأدب المفرد 37 (صحيح)","تخريج صحيح ابن حبان 451 (صحيح)"]},{"id":"س-05384","fp":"5b6600d8f530","stateId":261,"easy":"إذا نصرت أخاك في غيبته وأنت قادر ← ينصرك الله في الدنيا والآخرة","cause":"مَنْ نَصَرَ أخَاهُ بالغيبِ وهو يَسْتِطيعُ نَصْرَهُ","result":"نصرَهُ اللهُ في الدُّنْيا والآخرةِ","explicit":true,"otherNeedIds":[43],"ref":"مجمع الزوائد 7/270","srcLabel":"الطبراني","text":[["مَنْ نَصَرَ أخَاهُ بالغيبِ وهو يَسْتِطيعُ نَصْرَهُ ",1],["نصرَهُ اللهُ في الدُّنْيا والآخرةِ",2]],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"أحد أسانيده رجاله رجال الصحيح","takhrij":"أخرجه البزار (3542)، والطبراني (337) (18/ 154)، وأبو نعيم في ((حلية الأولياء)) (3/ 25)، والقضاعي في ((مسند الشهاب)) (475) واللفظ لهم جميعا.","bab":"رقائق وزهد › الجزاء من جنس العمل","dorar":"SPx6jvPg","merged":2,"otherRefs":["صحيح الجامع 6574 (حسن)"]},{"id":"س-04912","fp":"c854d8589c38","stateId":261,"easy":"إذا نصرت مسلماً يُنتقص من عرضه ← ينصرك الله في موطن تحب فيه نصرته","cause":"ومَا منْ أحدٍ ينصرُ مسلمًا في موطنٍ يُنتَقَصُ فيهِ منْ عرضِهِ، ويُنتَهكُ فيهِ منْ حُرمَتِهِ","result":"إِلاَّ نَصَرَهُ الله فِي مَوْطِنٍ يُحِبُّ فِيهِ نصرته","explicit":true,"ref":"الجامع الصغير 7983","srcLabel":"أبو داود","text":["ما من امرئٍ يخذلُ امرأً مسلمًا في موطنٍ يُنتَقَصُ فيهِ مِنْ عرضِهِ،  ويُنتهكُ فيهِ مِنْ حُرمَتِهِ،  إلَّا خَذَلَهُ اللهُ تعالى في موطنٍ يُحبُّ فيهِ نُصرتَهُ،  ",["ومَا منْ أحدٍ ينصرُ مسلمًا في موطنٍ يُنتَقَصُ فيهِ منْ عرضِهِ،  ويُنتَهكُ فيهِ منْ حُرمَتِهِ",1],"،  ",["إِلاَّ نَصَرَهُ الله فِي مَوْطِنٍ يُحِبُّ فِيهِ نصرته",2]],"grade":"صحيح","narrator":"جابر بن عبدالله وأبو طلحة بن سهل","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4884)، وأحمد (16368)، وابن المبارك في ((الزهد)) (696) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"4TsI8DKj"},{"id":"س-08169","fp":"576bc129798f","stateId":261,"easy":"إذا أخذت بالفضل ووصلت أقاربك وإن أساؤوا ← لا يزال معك ظهير من الله","cause":"خُذْ بالفَضلِ وصِلْهم","result":"لَن يَزالَ معَكَ ظهيرٌ منَ اللهِ عزَّ وجَلَّ ما كنتَ على ذلك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[37],"ref":"تخريج المسند لشاكر 10/173","srcLabel":"أحمد","text":["جاء رجُلٌ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقال يا رسولَ اللهِ إنَّ لي ذَوِي أرحامٍ أصِلُ ويَقطَعوني وأعفُو ويَظلِمونَ وأُحسِنُ ويُسيئونَ أفأُكافِئُهم قال لا إِذَنْ تُترَكونَ جميعًا ولكِنْ ",["خُذْ بالفَضلِ وصِلْهم",1]," فإنَّه ",["لَن يَزالَ معَكَ ظهيرٌ منَ اللهِ عزَّ وجَلَّ ما كنتَ على ذلك",2]],"grade":"صحيح","narrator":"[جد عمرو بن شعيب]","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6942) واللفظ له، وهناد في ((الزهد)) ((2/ 492)) ، والطوسي في ((الأربعون)) (23) باختلاف يسير.","bab":"ملائكة › أعمال الملائكة","dorar":"JdI5VgwA"},{"id":"س-05352","fp":"1e4059cadc40","stateId":262,"easy":"إذا دعا الضعفاء وأخلصوا وصلّوا ← ينصر الله بهم الأمة","cause":"بضَعيفِها؛ بدَعوتِهِم وصَلاتِهِم وإخلاصِهِم","result":"إنَّما يَنصُرُ اللهُ هذه الأُمَّةَ","explicit":true,"star":true,"ref":"تخريج رياض الصالحين 1/ 118","srcLabel":"البخاري","text":["عن مُصعَبِ بنِ سعدٍ عن أبيه، أنَّه ظنَّ أنَّ له فضلًا على مَن دُونَهُ من أصحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّم، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ",["إنَّما يَنصُرُ اللهُ هذه الأُمَّةَ",2]," ",["بضَعيفِها؛ بدَعوتِهِم وصَلاتِهِم وإخلاصِهِم",1],"."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (3178) واللفظ له، وأخرجه البخاري (2896) باختلاف يسير","bab":"رقائق وزهد › التوكل واليقين","dorar":"LDQXfCxf","merged":3,"otherRefs":["تسديد القوس 1/421 (صحيح)","صحيح الترغيب 3205 (صحيح)"]},{"id":"س-06016","fp":"50077256c115","stateId":262,"easy":"إذا صبرت ← فالنصر مع الصبر","cause":"معَ الصَّبْرِ","result":"وأنَّ النَّصْرَ","explicit":true,"star":true,"otherNeedIds":[16],"ref":"الأحاديث المختارة 10 / 24","srcLabel":"متفق عليه","text":["«كُنْتُ رَديفَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: يا غُلامُ، أو يا بُنَيَّ، أَلَا أُعَلِّمُك كَلِماتٍ يَنفَعُك اللهُ بِهنَّ؟ فقُلْتُ: بَلى، فقالَ: احْفَظِ اللهَ يَحفَظْك، احْفَظِ اللهَ تَجِدْه أمامَك، تَعرَّفْ إليه في الرَّخاءِ يَعرِفْك في الشِّدَّةِ، إذا سَألْتَ فاسْأَلِ اللهَ، وإذا اسْتَعَنْتَ فاسْتَعِنْ باللهِ، قد جَفَّ القَلَمُ بما هو كائِنٌ، فلو أنَّ الخَلْقَ كلَّهم جَميعًا أرادوا أن يَنفَعوك بشيءٍ لم يَقْضِه اللهُ لك لم يَقدِروا عليه، وإن أرادوا أن يَضُرُّوك بشيءٍ لم يَقْضِه اللهُ عليك لم يَقدِروا عليه، اعْمَلْ للهِ بالشُّكْرِ واليَقينِ، واعْلَمْ أنَّ الصَّبْرَ على ما تَكرَهُ خَيْرٌ كَثيرٌ، ",["وأنَّ النَّصْرَ",2]," ",["معَ الصَّبْرِ",1],"، وأنَّ الفَرَجَ معَ الكَرْبِ، وأنَّ معَ العُسْرِ يُسْرًا»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › تقوى الله","dorar":"Zz7qGbDv","merged":2,"otherRefs":["تخريج رياض الصالحين 62 (صحيح)"]},{"id":"ق-0081","fp":"39ef3cc1c954","stateId":262,"easy":"الصبر على البأساء والضراء والزلزلة ← نصر الله القريب ودخول الجنة","cause":"الصبر على البأساء والضراء والزلزلة","result":"نصر الله القريب ودخول الجنة","explicit":true,"star":true,"otherNeedIds":[67],"ref":"سورة البقرة: 214","srcLabel":"القرآن الكريم","quran":{"s":2,"from":214,"to":214,"text":"أَمْ حَسِبْتُمْ أَنْ تَدْخُلُوا الْجَنَّةَ وَلَمَّا يَأْتِكُمْ مَثَلُ الَّذِينَ خَلَوْا مِنْ قَبْلِكُمْ مَسَّتْهُمُ الْبَأْسَاءُ وَالضَّرَّاءُ وَزُلْزِلُوا حَتَّى يَقُولَ الرَّسُولُ وَالَّذِينَ آمَنُوا مَعَهُ مَتَى نَصْرُ اللَّهِ أَلَا إِنَّ نَصْرَ اللَّهِ قَرِيبٌ (214)","hl":[[0,16,1],[16,42,2],[42,230,1],[230,264,2]]}},{"id":"ق-0090","fp":"0f4780541f16","stateId":262,"easy":"الصبر مع اليقين بلقاء الله ← غلبة الفئة القليلة للكثيرة ومعية الله","cause":"الصبر مع اليقين بلقاء الله","result":"غلبة الفئة القليلة للكثيرة ومعية الله","explicit":true,"star":true,"otherNeedIds":[43],"ref":"سورة البقرة: 249","srcLabel":"القرآن الكريم","quran":{"s":2,"from":249,"to":249,"text":"فَلَمَّا فَصَلَ طَالُوتُ بِالْجُنُودِ قَالَ إِنَّ اللَّهَ مُبْتَلِيكُمْ بِنَهَرٍ فَمَنْ شَرِبَ مِنْهُ فَلَيْسَ مِنِّي وَمَنْ لَمْ يَطْعَمْهُ فَإِنَّهُ مِنِّي إِلَّا مَنِ اغْتَرَفَ غُرْفَةً بِيَدِهِ فَشَرِبُوا مِنْهُ إِلَّا قَلِيلًا مِنْهُمْ فَلَمَّا جَاوَزَهُ هُوَ وَالَّذِينَ آمَنُوا مَعَهُ قَالُوا لَا طَاقَةَ لَنَا الْيَوْمَ بِجَالُوتَ وَجُنُودِهِ قَالَ الَّذِينَ يَظُنُّونَ أَنَّهُمْ مُلَاقُو اللَّهِ كَمْ مِنْ فِئَةٍ قَلِيلَةٍ غَلَبَتْ فِئَةً كَثِيرَةً بِإِذْنِ اللَّهِ وَاللَّهُ مَعَ الصَّابِرِينَ (249)","hl":[[351,405,1],[405,489,2],[489,503,1]]}},{"id":"ق-0159","fp":"d076ea6a5bae","stateId":262,"easy":"الصبر والتقوى ← إمداد الله بالملائكة","cause":"الصبر والتقوى","result":"إمداد الله بالملائكة","explicit":true,"ref":"سورة آل عمران: 125","srcLabel":"القرآن الكريم","quran":{"s":3,"from":125,"to":125,"text":"بَلَى إِنْ تَصْبِرُوا وَتَتَّقُوا وَيَأْتُوكُمْ مِنْ فَوْرِهِمْ هَذَا يُمْدِدْكُمْ رَبُّكُمْ بِخَمْسَةِ آلَافٍ مِنَ الْمَلَائِكَةِ مُسَوِّمِينَ (125)","hl":[[0,70,1],[70,143,2]]}},{"id":"ق-0181","fp":"2253a57d31e0","stateId":262,"easy":"نيل نصر الله والتوكل عليه ← لا غالب لكم","cause":"نيل نصر الله والتوكل عليه","result":"لا غالب لكم","explicit":true,"ref":"سورة آل عمران: 160","srcLabel":"القرآن الكريم","quran":{"s":3,"from":160,"to":160,"text":"إِنْ يَنْصُرْكُمُ اللَّهُ فَلَا غَالِبَ لَكُمْ وَإِنْ يَخْذُلْكُمْ فَمَنْ ذَا الَّذِي يَنْصُرُكُمْ مِنْ بَعْدِهِ وَعَلَى اللَّهِ فَلْيَتَوَكَّلِ الْمُؤْمِنُونَ (160)","hl":[[0,26,1],[26,46,2],[46,159,1]]}},{"id":"ق-0265","fp":"52df92d1c44f","stateId":262,"easy":"الإيمان ← لا سبيل للكافرين على المؤمنين","cause":"الإيمان","result":"لا سبيل للكافرين على المؤمنين","explicit":true,"similar":["ق-0967"],"otherNeedIds":[43],"ref":"سورة النساء: 141","srcLabel":"القرآن الكريم","quran":{"s":4,"from":141,"to":141,"text":"الَّذِينَ يَتَرَبَّصُونَ بِكُمْ فَإِنْ كَانَ لَكُمْ فَتْحٌ مِنَ اللَّهِ قَالُوا أَلَمْ نَكُنْ مَعَكُمْ وَإِنْ كَانَ لِلْكَافِرِينَ نَصِيبٌ قَالُوا أَلَمْ نَسْتَحْوِذْ عَلَيْكُمْ وَنَمْنَعْكُمْ مِنَ الْمُؤْمِنِينَ فَاللَّهُ يَحْكُمُ بَيْنَكُمْ يَوْمَ الْقِيَامَةِ وَلَنْ يَجْعَلَ اللَّهُ لِلْكَافِرِينَ عَلَى الْمُؤْمِنِينَ سَبِيلًا (141)","hl":[[263,301,2],[301,323,1],[323,331,2]]}},{"id":"ق-0295","fp":"6ae567568af9","stateId":262,"easy":"الإقدام مع التوكل على الله ← الغلبة","cause":"الإقدام مع التوكل على الله","result":"الغلبة","explicit":true,"otherNeedIds":[43],"ref":"سورة المائدة: 23","srcLabel":"القرآن الكريم","quran":{"s":5,"from":23,"to":23,"text":"قَالَ رَجُلَانِ مِنَ الَّذِينَ يَخَافُونَ أَنْعَمَ اللَّهُ عَلَيْهِمَا ادْخُلُوا عَلَيْهِمُ الْبَابَ فَإِذَا دَخَلْتُمُوهُ فَإِنَّكُمْ غَالِبُونَ وَعَلَى اللَّهِ فَتَوَكَّلُوا إِنْ كُنْتُمْ مُؤْمِنِينَ (23)","hl":[[71,123,1],[123,145,2],[145,201,1]]}},{"id":"ق-0476","fp":"976eb707f1f6","stateId":262,"easy":"الصبر ← غلبة القليل للكثير","cause":"الصبر","result":"غلبة القليل للكثير","explicit":true,"otherNeedIds":[43],"ref":"سورة الأنفال: 65","srcLabel":"القرآن الكريم","quran":{"s":8,"from":65,"to":65,"text":"يَا أَيُّهَا النَّبِيُّ حَرِّضِ الْمُؤْمِنِينَ عَلَى الْقِتَالِ إِنْ يَكُنْ مِنْكُمْ عِشْرُونَ صَابِرُونَ يَغْلِبُوا مِائَتَيْنِ وَإِنْ يَكُنْ مِنْكُمْ مِائَةٌ يَغْلِبُوا أَلْفًا مِنَ الَّذِينَ كَفَرُوا بِأَنَّهُمْ قَوْمٌ لَا يَفْقَهُونَ (65)","hl":[[64,106,1],[106,128,2]]}},{"id":"ق-0477","fp":"e83e3c392d8c","stateId":262,"easy":"الصبر ← الغلبة بإذن الله ومعية الله","cause":"الصبر","result":"الغلبة بإذن الله ومعية الله","explicit":true,"otherNeedIds":[43],"ref":"سورة الأنفال: 66","srcLabel":"القرآن الكريم","quran":{"s":8,"from":66,"to":66,"text":"الْآنَ خَفَّفَ اللَّهُ عَنْكُمْ وَعَلِمَ أَنَّ فِيكُمْ ضَعْفًا فَإِنْ يَكُنْ مِنْكُمْ مِائَةٌ صَابِرَةٌ يَغْلِبُوا مِائَتَيْنِ وَإِنْ يَكُنْ مِنْكُمْ أَلْفٌ يَغْلِبُوا أَلْفَيْنِ بِإِذْنِ اللَّهِ وَاللَّهُ مَعَ الصَّابِرِينَ (66)","hl":[[63,104,1],[104,126,2],[126,157,1],[157,210,2],[210,224,1]]}},{"id":"ق-0486","fp":"ef01de6ba549","stateId":262,"easy":"قتال الناكثين المعتدين ← نصر الله وخزي العدو وشفاء صدور المؤمنين وذهاب غيظ قلوبهم","cause":"قتال الناكثين المعتدين","result":"نصر الله وخزي العدو وشفاء صدور المؤمنين وذهاب غيظ قلوبهم","explicit":true,"otherNeedIds":[5],"ref":"سورة التوبة: 14–15","srcLabel":"القرآن الكريم","quran":{"s":9,"from":14,"to":15,"text":"قَاتِلُوهُمْ يُعَذِّبْهُمُ اللَّهُ بِأَيْدِيكُمْ وَيُخْزِهِمْ وَيَنْصُرْكُمْ عَلَيْهِمْ وَيَشْفِ صُدُورَ قَوْمٍ مُؤْمِنِينَ (14) وَيُذْهِبْ غَيْظَ قُلُوبِهِمْ وَيَتُوبُ اللَّهُ عَلَى مَنْ يَشَاءُ وَاللَّهُ عَلِيمٌ حَكِيمٌ (15)","hl":[[0,13,1],[13,158,2]]}},{"id":"ق-0566","fp":"3c107b3cb60d","stateId":262,"easy":"التوكل على الله والدعاء بالنجاة من الظالمين ← النجاة","cause":"التوكل على الله والدعاء بالنجاة من الظالمين","result":"النجاة","explicit":true,"otherNeedIds":[29],"ref":"سورة يونس: 84–86","srcLabel":"القرآن الكريم","quran":{"s":10,"from":84,"to":86,"text":"وَقَالَ مُوسَى يَا قَوْمِ إِنْ كُنْتُمْ آمَنْتُمْ بِاللَّهِ فَعَلَيْهِ تَوَكَّلُوا إِنْ كُنْتُمْ مُسْلِمِينَ (84) فَقَالُوا عَلَى اللَّهِ تَوَكَّلْنَا رَبَّنَا لَا تَجْعَلْنَا فِتْنَةً لِلْقَوْمِ الظَّالِمِينَ (85) وَنَجِّنَا بِرَحْمَتِكَ مِنَ الْقَوْمِ الْكَافِرِينَ (86)","hl":[[26,267,1]]}},{"id":"ق-0616","fp":"90de9527bdc6","stateId":262,"easy":"الصبر حتى تبلغ الشدة غايتها ← مجيء النصر والنجاة","cause":"الصبر حتى تبلغ الشدة غايتها","result":"مجيء النصر والنجاة","explicit":true,"otherNeedIds":[4],"ref":"سورة يوسف: 110","srcLabel":"القرآن الكريم","quran":{"s":12,"from":110,"to":110,"text":"حَتَّى إِذَا اسْتَيْأَسَ الرُّسُلُ وَظَنُّوا أَنَّهُمْ قَدْ كُذِبُوا جَاءَهُمْ نَصْرُنَا فَنُجِّيَ مَنْ نَشَاءُ وَلَا يُرَدُّ بَأْسُنَا عَنِ الْقَوْمِ الْمُجْرِمِينَ (110)","hl":[[0,69,1],[69,111,2]]}},{"id":"ق-0814","fp":"dd3d37cc9efd","stateId":262,"easy":"الإيمان ← دفاع الله عنهم","cause":"الإيمان","result":"دفاع الله عنهم","explicit":true,"otherNeedIds":[32],"ref":"سورة الحج: 38","srcLabel":"القرآن الكريم","quran":{"s":22,"from":38,"to":38,"text":"إِنَّ اللَّهَ يُدَافِعُ عَنِ الَّذِينَ آمَنُوا إِنَّ اللَّهَ لَا يُحِبُّ كُلَّ خَوَّانٍ كَفُورٍ (38)","hl":[[0,23,2],[23,46,1]]}},{"id":"ق-0817","fp":"1de44afedced","stateId":262,"easy":"نصرة دين الله: إقامة الصلاة وإيتاء الزكاة والأمر بالمعروف والنهي عن المنكر عند التمكين ← نصر الله القوي العزيز","cause":"نصرة دين الله: إقامة الصلاة وإيتاء الزكاة والأمر بالمعروف والنهي عن المنكر عند التمكين","result":"نصر الله القوي العزيز","explicit":true,"otherNeedIds":[43],"ref":"سورة الحج: 40–41","srcLabel":"القرآن الكريم","quran":{"s":22,"from":40,"to":41,"text":"الَّذِينَ أُخْرِجُوا مِنْ دِيَارِهِمْ بِغَيْرِ حَقٍّ إِلَّا أَنْ يَقُولُوا رَبُّنَا اللَّهُ وَلَوْلَا دَفْعُ اللَّهِ النَّاسَ بَعْضَهُمْ بِبَعْضٍ لَهُدِّمَتْ صَوَامِعُ وَبِيَعٌ وَصَلَوَاتٌ وَمَسَاجِدُ يُذْكَرُ فِيهَا اسْمُ اللَّهِ كَثِيرًا وَلَيَنْصُرَنَّ اللَّهُ مَنْ يَنْصُرُهُ إِنَّ اللَّهَ لَقَوِيٌّ عَزِيزٌ (40) الَّذِينَ إِنْ مَكَّنَّاهُمْ فِي الْأَرْضِ أَقَامُوا الصَّلَاةَ وَآتَوُا الزَّكَاةَ وَأَمَرُوا بِالْمَعْرُوفِ وَنَهَوْا عَنِ الْمُنْكَرِ وَلِلَّهِ عَاقِبَةُ الْأُمُورِ (41)","hl":[[240,263,2],[263,280,1],[280,311,2],[311,453,1]]}},{"id":"ق-0967","fp":"588268b7df74","stateId":262,"easy":"الإيمان ← نصر المؤمنين حقاً على الله","cause":"الإيمان","result":"نصر المؤمنين حقاً على الله","explicit":true,"repOf":"ق-0265","ref":"سورة الروم: 47","quran":{"s":30,"from":47,"to":47,"text":"وَلَقَدْ أَرْسَلْنَا مِنْ قَبْلِكَ رُسُلًا إِلَى قَوْمِهِمْ فَجَاءُوهُمْ بِالْبَيِّنَاتِ فَانْتَقَمْنَا مِنَ الَّذِينَ أَجْرَمُوا وَكَانَ حَقًّا عَلَيْنَا نَصْرُ الْمُؤْمِنِينَ (47)","hl":[[130,161,2],[161,176,1]]}},{"id":"ق-0989","fp":"27127f4eecaf","stateId":262,"easy":"الإيمان والثبات ← كفاية الله المؤمنين القتال وردّ العدو بغيظه","cause":"الإيمان والثبات","result":"كفاية الله المؤمنين القتال وردّ العدو بغيظه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[31],"ref":"سورة الأحزاب: 25","srcLabel":"القرآن الكريم","quran":{"s":33,"from":25,"to":25,"text":"وَرَدَّ اللَّهُ الَّذِينَ كَفَرُوا بِغَيْظِهِمْ لَمْ يَنَالُوا خَيْرًا وَكَفَى اللَّهُ الْمُؤْمِنِينَ الْقِتَالَ وَكَانَ اللَّهُ قَوِيًّا عَزِيزًا (25)","hl":[[0,112,2],[112,146,1]]}},{"id":"ق-1056","fp":"33da667f4d4a","stateId":262,"easy":"الجندية لله ونصرة دينه ← النصر والغلبة","cause":"الجندية لله ونصرة دينه","result":"النصر والغلبة","explicit":true,"otherNeedIds":[43],"ref":"سورة الصافات: 171–173","srcLabel":"القرآن الكريم","quran":{"s":37,"from":171,"to":173,"text":"وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا الْمُرْسَلِينَ (171) إِنَّهُمْ لَهُمُ الْمَنْصُورُونَ (172) وَإِنَّ جُنْدَنَا لَهُمُ الْغَالِبُونَ (173)","hl":[[0,64,1],[64,96,2],[96,121,1],[121,141,2]]}},{"id":"ق-1117","fp":"4d61a15d1892","stateId":262,"easy":"الإيمان ← نصر الله في الحياة الدنيا ويوم يقوم الأشهاد","cause":"الإيمان","result":"نصر الله في الحياة الدنيا ويوم يقوم الأشهاد","explicit":true,"ref":"سورة غافر: 51","srcLabel":"القرآن الكريم","quran":{"s":40,"from":51,"to":51,"text":"إِنَّا لَنَنْصُرُ رُسُلَنَا وَالَّذِينَ آمَنُوا فِي الْحَيَاةِ الدُّنْيَا وَيَوْمَ يَقُومُ الْأَشْهَادُ (51)","hl":[[0,17,2],[17,48,1],[48,103,2]]}},{"id":"ق-1207","fp":"e43512d1871a","stateId":262,"easy":"نصرة دين الله ← نصر الله وتثبيت الأقدام","cause":"نصرة دين الله","result":"نصر الله وتثبيت الأقدام","explicit":true,"otherNeedIds":[16],"ref":"سورة محمد: 7","srcLabel":"القرآن الكريم","quran":{"s":47,"from":7,"to":7,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ تَنْصُرُوا اللَّهَ يَنْصُرْكُمْ وَيُثَبِّتْ أَقْدَامَكُمْ (7)","hl":[[31,55,1],[55,93,2]]}},{"id":"ق-1240","fp":"09876dac45b0","stateId":262,"easy":"الإيمان والثبات عند اللقاء ← تولّي الكافرين الأدبار بلا وليّ ولا نصير (سنة الله)","cause":"الإيمان والثبات عند اللقاء","result":"تولّي الكافرين الأدبار بلا وليّ ولا نصير (سنة الله)","explicit":true,"otherNeedIds":[43],"ref":"سورة الفتح: 22–23","srcLabel":"القرآن الكريم","quran":{"s":48,"from":22,"to":23,"text":"وَلَوْ قَاتَلَكُمُ الَّذِينَ كَفَرُوا لَوَلَّوُا الْأَدْبَارَ ثُمَّ لَا يَجِدُونَ وَلِيًّا وَلَا نَصِيرًا (22) سُنَّةَ اللَّهِ الَّتِي قَدْ خَلَتْ مِنْ قَبْلُ وَلَنْ تَجِدَ لِسُنَّةِ اللَّهِ تَبْدِيلًا (23)","hl":[[0,38,1],[38,105,2],[105,201,1]]}},{"id":"ق-1331","fp":"cab338344575","stateId":262,"easy":"نصرة دين الله ← التأييد على العدو والظهور","cause":"نصرة دين الله","result":"التأييد على العدو والظهور","explicit":true,"otherNeedIds":[43],"ref":"سورة الصف: 14","srcLabel":"القرآن الكريم","quran":{"s":61,"from":14,"to":14,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا كُونُوا أَنْصَارَ اللَّهِ كَمَا قَالَ عِيسَى ابْنُ مَرْيَمَ لِلْحَوَارِيِّينَ مَنْ أَنْصَارِي إِلَى اللَّهِ قَالَ الْحَوَارِيُّونَ نَحْنُ أَنْصَارُ اللَّهِ فَآمَنَتْ طَائِفَةٌ مِنْ بَنِي إِسْرَائِيلَ وَكَفَرَتْ طَائِفَةٌ فَأَيَّدْنَا الَّذِينَ آمَنُوا عَلَى عَدُوِّهِمْ فَأَصْبَحُوا ظَاهِرِينَ (14)","hl":[[31,252,1],[252,324,2]]}},{"id":"س-06985","fp":"35d041c31984","stateId":262,"easy":"إذا سجدت تقول «يا حي يا قيوم» في الشدة ← يفتح الله عليك (من واقعة بدر)","cause":"ساجِدٌ يَقولُ: يا حَيُّ يا قَيُّومُ","result":"ففَتَح اللهُ عليه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«يا حي يا قيوم»"},"otherNeedIds":[29],"ref":"الأحاديث المختارة 738","srcLabel":"البخاري","text":["«قاتَلْتُ يَوْمَ بَدْرٍ قِتالًا، ثُمَّ جِئْتُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم فإذا هو ",["ساجِدٌ يَقولُ: يا حَيُّ يا قَيُّومُ",1],"، ثُمَّ ذَهَبْتُ فقاتَلْتُ، ثُمَّ جِئْتُ، فإذا النَّبيُّ صلَّى اللهُ عليه وسلَّم ساجِدٌ يَقولُ: يا حَيُّ يا قَيُّومُ، قالَ: ",["ففَتَح اللهُ عليه",2],"»."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"g2i7xPpn"},{"id":"س-04458","fp":"b7e7a1068f03","stateId":262,"easy":"إذا جاهدت في سبيل الله ← يمدّك الله بأضعاف جيشك","cause":"وابعَثْ جيشًا","result":"نبعَثْ خمسةً أمثالَهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج صحيح ابن حبان 653","srcLabel":"مسلم","text":["إنَّ اللهَ أمَرني أنْ أُعلِّمَكم ما جهِلْتُم ممَّا علَّمني يومي هذا : إنَّ كلَّ ما أنحَلْتُه عبدي حلالٌ وإنِّي خلَقْتُ عبادي حُنفاءَ كلَّهم وإنَّه أتَتْهم الشَّياطينُ فاجتالَتْهم عن دِينِهم وحرَّمتْ عليهم ما أحلَلْتُ لهم فأمَرَتْهم أنْ يُشرِكوا بي ما لم أُنزِّلْ به سُلطانًا وإنَّ اللهَ اطَّلَع إلى أهلِ الأرضِ فمقَتهم عرَبَهم وعجَمَهم غيرَ بقايا مِن أهلِ الكتابِ فقال : يا مُحمَّدُ إنَّما بعَثْتُك لِأبتليَك وأبتليَ بك وأُنزِلَ عليك كتابًا لا يغسِلُه الماءُ تقرَؤُه يقظانَ ونائمًا وإنَّ اللهَ جلَّ وعلا أمَرني أنْ أُخبِرَ قُريشًا فقُلْتُ : إذَنْ يثلَغوا رأسي فيترُكوه خُبزةً قال فاستخرِجْهم كما استخرَجوك واغزُهم يستَغْزُوك وأنفِقْ يُنفَقْ عليك ",["وابعَثْ جيشًا",1]," ",["نبعَثْ خمسةً أمثالَهم",2]," وقاتِلْ بمَنْ أطاعك مَنْ عصاك وقال : أصحابُ الجنَّةِ ثلاثةٌ : إمامٌ مُقسِطٌ مُصَّدِّقٌ موفَّقٌ ورجُلٌ رحيمٌ رقيقُ القلبِ بكلِّ ذي قُربى ومسلمٍ ورجُلٌ عفيفٌ فقيرٌ مُصَّدِّقٌ وقال : أصحابُ النَّارِ خمسةٌ : رجُلٌ جائرٌ لا يخفَى له طمَعٌ وإنْ دقَّ ورجُلٌ لا يُمسي ولا يُصبِحُ إلَّا وهو يُخادِعُك عن أهلِك ومالِك، والضَّعيفُ الَّذينَ هم فيكم تَبَعٌ لا يَبْغُونَ أهلًا ولا مالًا ) فقال له رجُلٌ : يا أبا عبدِ اللهِ أمِنَ الموالي هو أو مِن العرَبِ ؟ قال : هو التَّابعةُ يكونُ للرَّجُلِ فيُصيبُ مِن حُرمتِه سِفاحًا غيرَ نكاحٍ"],"grade":"صحيح","narrator":"عياض بن حمار","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (653)، واللفظ له، ومسلم (2865)، وأحمد (17484)، والطبراني في ((المعجم الكبير)) (17/ 358) (987)، وأبو داود الطيالسي (1175)، باختلاف يسير.","bab":"جهاد › فضل الجهاد","dorar":"P770CDJd","merged":2,"otherRefs":["صحيح ابن حبان 654 (صحيح)"]},{"id":"س-00085","fp":"6d3f37e47811","stateId":262,"easy":"إذا دعا المستضعفون ← ينصر الله بدعائهم المسلمين","cause":"بدعاءِ المُستَضعَفِينَ","result":"إنما يَنصرُ اللهُ المسلمين","explicit":true,"otherNeedIds":[29],"ref":"مجمع الزوائد 5/332","srcLabel":"مجمع الزوائد","text":[["إنما يَنصرُ اللهُ المسلمين",2]," ",["بدعاءِ المُستَضعَفِينَ",1]],"grade":"حسن","narrator":"سعد بن أبي وقاص","muhaddith":"[فيه] علي بن سعيد الرازي قال الدارقطني ليس بذاك , وقال يونس كان يحفظ ويفهم , وبقية رجاله ثقات","bab":"آداب الدعاء › استجابة الدعاء","dorar":"OSNDDUun"},{"id":"س-01805","fp":"320d29932c76","stateId":262,"easy":"إذا لم تغلّ الأمة ← لا يقيم الله لها عدواً","cause":"إنْ لم تَغُلَّ أُمَّتي","result":"لم يُقِمْ لهم عَدُوًّا أبَدًا","explicit":true,"ref":"الترغيب والترهيب 2/271","srcLabel":"الطبراني","text":[["إنْ لم تَغُلَّ أُمَّتي",1]," ",["لم يُقِمْ لهم عَدُوًّا أبَدًا",2],". قال أبو ذَرٍّ لِحَبيبِ بنِ مَسلَمةَ: هل يَثبُتُ لكمُ العَدُوُّ حَلْبَ شاةٍ؟ قال: نَعَمْ، وثَلاثَ شياهٍ غُزُرٍ. قال أبو ذَرٍّ: غَلَلتُم ورَبِّ الكَعبةِ."],"grade":"حسن","narrator":"أبو ذر","muhaddith":"إسناده جيد","takhrij":"أخرجه الطبراني في ((الأوسط)) (8108)، وإسحاق بن راهويه كما في ((المطالب العالية)) (2078) واللفظ لهما، والدولابي في ((الكنى والأسماء)) (1940) مختصرًا.","bab":"أيمان › لفظ اليمين وما يحلف به","dorar":"VxwkWsM8"},{"id":"س-04353","fp":"303f6e1aabf7","stateId":262,"easy":"إذا أخّرت القتال حتى تزول الشمس ← تهب الريح وينزل النصر (من فعل النبي ﷺ)","cause":"أخَّرَ القتالَ حتَّى تزولَ الشَّمسُ","result":"وتَهبَّ الرِّيحُ وينزلُ النَّصرُ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"صحيح دلائل النبوة 530","srcLabel":"أبو داود","text":["أنَّ عمرَ بنَ الخطَّابِ رضيَ اللَّهُ عنهُ شاورَ الهُرمُزانَ في أصبَهانَ وفارسَ وأذربيجانَ فقال يا أميرَ المؤمنينَ أصبَهانُ الرَّأسُ وفارسُ وأذربيجانَ الجناحانِ فإذا قطعتَ إحدى الجناحينِ فالرَّأسُ بالجناحِ وإن قطعتَ الرَّأسَ وقعَ الجناحانِ فابدأ بأصبَهانَ فدخلَ عمرُ بنُ الخطَّابِ المسجدَ فإذا هوَ بالنُّعمانِ بنِ مقرِّنٍ يصلِّي فانتظرَهُ حتَّى قضى صلاتَه فقال لَهُ إنِّي مستعملُكَ فقال أمَّا جابيًا فلا وأمَّا غازيًا فنعم قال فإنَّكَ غازٍ فسرَّحَهُ وبعثَ إلى أَهلِ الكوفةِ أن يمدُّوهُ ويلحقوا بِهِ وفيهم حذيفةُ بنُ اليمانِ والمغيرةُ بنُ شعبةَ والزُّبيرُ بنُ العوَّامِ والأشعثُ بنُ قيسٍ وعمرو بنُ معدي كرِبَ وعبدُ اللَّهِ بنُ عمرٍو فأتاهمُ النُّعمانُ وبينَه وبينَهم نَهرٌ فبعثَ إليهمُ المغيرةَ بنَ شعبةَ رسولًا وملِكُهم ذو الحاجبينِ فاستشارَ أصحابَهُ فقال ما ترونَ أقعدُ لَهم في هيئةِ الحربِ أو في هيئةِ الملِكِ وبَهجتِه فجلسَ في هيئةِ الملِكِ وبَهجتِه على سريرِه ووضعَ التَّاجَ على رأسِه وحولَه سماطينِ عليهم ثيابُ الدِّيباجِ والقرطِ والأسورةِ فجاءَ المغيرةُ بنُ شعبةَ فأخذَ بضبعيهِ وبيدِه الرُّمحُ والتُّرسُ والنَّاسُ حولَه سماطينِ على بساطٍ لهُ فجعلَ يطعنُه برمحِه فخرَّقَه لِكي يتطيَّروا فقال لهُ ذو الحاجبينِ إنَّكم يا معشرَ العربِ أصابَكم جوعٌ شديدٌ وجَهدٌ فخرجتُمْ فإن شئتُم مِرْناكم ورجعتُم إلى بلادِكم فتَكلَّمَ المغيرةُ فحمدَ اللَّهَ وأثنى عليهِ وقالَ إنَّا كنَّا معشرَ العربِ نأكلُ الجيفةَ والميتةَ وَكانَ النَّاسُ يطؤونا ولا نطأُهم فابتعثَ اللَّهُ منَّا رسولًا في شرفٍ منَّا أوسطَنا وأصدَقنا حديثًا وإنَّهُ قد وعدنا أنَّ ها هنا ستفتحُ علينا وقد وجدنا جميعَ ما وعدنا حقًّا وإنِّي لأرى ها هنا بزَّةً وَهيئةً ما أرى من معي بذاهبينَ حتَّى يأخذوهُ فقال المغيرةُ فقالت لي نفسي لو جمعتَ جراميزَك فوثبتَ وثبةً فجلستُ معَه على السَّريرِ إذ وجدتُ غفلةً فزجرني وجعلوا يحثُّونَه فقلتُ أرأيتُم إن كنتُ أنا استحمقتُ فإنَّ هذا لا يفعلُ بالرُّسلِ وإنَّا لا نفعلُ هذا برسلِكم إذا أتونا فقال إن شئتُم قطعتُم إلينا وإن شئتُم قطعنا إليكم فقلتُ بل نقطعُ إليكم فقطعنا إليهم وصاففناهم فتسلسلوا كلُّ سبعةٍ في سلسلةٍ وخمسةٌ في سلسلةٍ حتَّى لا يفِرُّوا قال فرامونا حتَّى أسرعوا فينا فقال المغيرةُ للنُّعمانِ إنَّ القومَ قد أسرعوا فينا فاحمِل فقال إنَّكَ ذو مناقبٍ وقد شَهدتُ معَ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وعلى آلِهِ وسلَّمَ ولَكنِّي أنا شَهدتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وعلى آلِهِ وسلَّمَ إذا لم يقاتل أوَّلَ النَّهارِ ",["أخَّرَ القتالَ حتَّى تزولَ الشَّمسُ",1]," ",["وتَهبَّ الرِّيحُ وينزلُ النَّصرُ",2]," فقال النُّعمانُ يا أيُّها النَّاسُ اهتزَّ ثلاثُ هزَّاتٍ فأمَّا الهزَّةُ الأولى فليقضِ الرَّجلُ حاجتَه وأمَّا الثَّانيةُ فلينظرِ الرَّجلُ في سلاحِه وسيفِه وأمَّا الثَّالثةُ فإنِّي حاملٌ فاحملوا فإن قُتِلَ أحدٌ فلا يلوي أحدٌ على أحدٍ وإن قتلتُ فلا تلووا عليَّ وإنِّي داعٍ اللَّهَ بدعوةٍ فعزمتُ على كلِّ امرئٍ منكم لمَا أمَّنَ عليها فقال اللَّهمَّ ارزقِ اليومَ النُّعمانَ شَهادةً تَنصُرُ المسلمينَ وافتح عليهم فأمَّنَ القومُ وَهزَّ لواءَه ثلاثَ مرَّاتٍ ثمَّ حملَ فَكانَ أوَّلَ صريعٍ رضيَ اللَّهُ عنهُ فذَكرتُ وصيَّتَهُ فلم ألوِ عليهِ وأعلمتُ مَكانَه فَكنَّا إذا قتلنا رجلًا منهم شغلَ عنَّا أصحابُه يجرُّونَه ووقعَ ذو الحاجبينِ من بغلتِهِ الشَّهباءِ فانشقَّ بطنُهُ وفتحَ اللَّهُ على المسلمينَ فأتيتُ النُّعمانَ وبِه رمقٌ فأتيتُه بماءٍ فجعلتُ أصبُّهُ على وجهِه أغسلُ التُّرابَ عن وجهِه فقال من هذا فقلتُ معقلُ بنُ يسارٍ فقال ما فعلَ النَّاسُ فقلتُ فتحَ اللَّهُ عليهم فقال الحمدُ للَّهِ اكتبوا بذلِكَ إلى عمرَ وفاضت نفسُهُ فاجتمعَ النَّاسُ إلى الأشعثِ بنِ قيسٍ فقال فأتينا أمَّ ولدِهِ فقلنا هل عَهدَ إليكَ عَهدًا قالت لا إلَّا سفيطٌ لهُ في كتابٌ فقرأتُه فإذا فيهِ إن قُتِلَ فلانٌ ففلانٌ وإن قُتِلَ فلانٌ ففلانٌ"],"grade":"صحيح","narrator":"النعمان بن مقرن","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (5279)، وابن أبي شيبة (36056) واللفظ لهما، وأبو داود (2655)، والترمذي (1613) بنحوه مختصرا.","bab":"جهاد › الترغيب في الجهاد","dorar":"CWygaKxk"},{"id":"س-07420","fp":"53fd121ed315","stateId":263,"easy":"إذا لزمت الجماعة ← فيد الله على الجماعة","cause":"على الجماعةِ","result":"فإنَّ يدَ اللهِ على الجماعةِ","explicit":true,"star":true,"otherNeedIds":[15],"ref":"الأحكام الشرعية الصغرى 493","srcLabel":"مسلم","text":["رأيتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم وهو على المنبرِ يخطبُ النَّاسَ فقال : إنَّها ستكونُ بعدي هنَّاتٌ وهنَّاتٌ ، فمن رأيتموه فارق الجماعةَ أو يريدُ تفريقَ أمرِ أمَّةِ محمَّدٍ كائنًا من كان ، فاقتُلوه ",["فإنَّ يدَ اللهِ على الجماعةِ",2]," ، وإنَّ الشَّيطانَ مع من فارق الجماعةَ يركُضُ"],"grade":"صحيح","narrator":"عرفجة [بن شراحيل أو شريح أو شريك أو ضريح أو أسعد]","muhaddith":"[أشار في المقدمة أنه صحيح الإسناد]","takhrij":"أخرجه النسائي (4020) وابن حبان (4577) باختلاف يسير وأخرجه مسلم  (1852) وأبو داود (4762) مختصرا بنحوه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"YQK2rhuB","merged":9,"otherRefs":["تخريج صحيح ابن حبان 4577 (صحيح)","هداية الرواة 171 (صحيح)","صحيح الترغيب 2131 (صحيح)","نيل الأوطار 9/231 (صحيح)","صحيح الجامع 1848 (صحيح)","مجمع الزوائد 5/221 (حسن)","مجمع الزوائد 5/224 (حسن)","فيض القدير 2/ 245 (صحيح)"]},{"id":"ق-0014","fp":"361496c31693","stateId":263,"easy":"الاستعانة بالصبر والصلاة مع الخشوع واليقين بلقاء الله ← العون وخفّة الطاعة","cause":"الاستعانة بالصبر والصلاة مع الخشوع واليقين بلقاء الله","result":"العون وخفّة الطاعة","explicit":true,"star":true,"otherNeedIds":[54],"ref":"سورة البقرة: 45–46","srcLabel":"القرآن الكريم","quran":{"s":2,"from":45,"to":46,"text":"وَاسْتَعِينُوا بِالصَّبْرِ وَالصَّلَاةِ وَإِنَّهَا لَكَبِيرَةٌ إِلَّا عَلَى الْخَاشِعِينَ (45) الَّذِينَ يَظُنُّونَ أَنَّهُمْ مُلَاقُو رَبِّهِمْ وَأَنَّهُمْ إِلَيْهِ رَاجِعُونَ (46)","hl":[[0,176,1]]}},{"id":"ق-0050","fp":"bf5bb09fb532","stateId":263,"easy":"الاستعانة بالصبر والصلاة ← معية الله للصابرين","cause":"الاستعانة بالصبر والصلاة","result":"معية الله للصابرين","explicit":true,"star":true,"otherNeedIds":[4],"ref":"سورة البقرة: 153","srcLabel":"القرآن الكريم","quran":{"s":2,"from":153,"to":153,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اسْتَعِينُوا بِالصَّبْرِ وَالصَّلَاةِ إِنَّ اللَّهَ مَعَ الصَّابِرِينَ (153)","hl":[[0,69,1],[69,87,2],[87,101,1]]}},{"id":"ق-0070","fp":"2bb5a64543a2","stateId":263,"easy":"التقوى ← معية الله","cause":"التقوى","result":"معية الله","explicit":true,"similar":["ق-0496","ق-0538","ق-1187"],"ref":"سورة البقرة: 194","srcLabel":"القرآن الكريم","quran":{"s":2,"from":194,"to":194,"text":"الشَّهْرُ الْحَرَامُ بِالشَّهْرِ الْحَرَامِ وَالْحُرُمَاتُ قِصَاصٌ فَمَنِ اعْتَدَى عَلَيْكُمْ فَاعْتَدُوا عَلَيْهِ بِمِثْلِ مَا اعْتَدَى عَلَيْكُمْ وَاتَّقُوا اللَّهَ وَاعْلَمُوا أَنَّ اللَّهَ مَعَ الْمُتَّقِينَ (194)","hl":[[148,167,1],[167,197,2],[197,211,1]]}},{"id":"ق-0093","fp":"83be81fc55c5","stateId":263,"easy":"الإيمان ← ولاية الله والإخراج من الظلمات إلى النور","cause":"الإيمان","result":"ولاية الله والإخراج من الظلمات إلى النور","explicit":true,"otherNeedIds":[15],"ref":"سورة البقرة: 257","srcLabel":"القرآن الكريم","quran":{"s":2,"from":257,"to":257,"text":"اللَّهُ وَلِيُّ الَّذِينَ آمَنُوا يُخْرِجُهُمْ مِنَ الظُّلُمَاتِ إِلَى النُّورِ وَالَّذِينَ كَفَرُوا أَوْلِيَاؤُهُمُ الطَّاغُوتُ يُخْرِجُونَهُمْ مِنَ النُّورِ إِلَى الظُّلُمَاتِ أُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ (257)","hl":[[0,15,2],[15,34,1],[34,79,2]]}},{"id":"ق-0136","fp":"2390bc4488f5","stateId":263,"easy":"الإيمان واتباع ملة إبراهيم والنبي ﷺ ← ولاية الله","cause":"الإيمان واتباع ملة إبراهيم والنبي ﷺ","result":"ولاية الله","explicit":true,"ref":"سورة آل عمران: 68","srcLabel":"القرآن الكريم","quran":{"s":3,"from":68,"to":68,"text":"إِنَّ أَوْلَى النَّاسِ بِإِبْرَاهِيمَ لَلَّذِينَ اتَّبَعُوهُ وَهَذَا النَّبِيُّ وَالَّذِينَ آمَنُوا وَاللَّهُ وَلِيُّ الْمُؤْمِنِينَ (68)","hl":[[0,100,1],[100,117,2],[117,132,1]]}},{"id":"ق-0288","fp":"4ce76c7880bc","stateId":263,"easy":"إقامة الصلاة وإيتاء الزكاة والإيمان بالرسل ونصرتهم وإقراض الله قرضاً حسناً ← معية الله وتكفير السيئات ودخول الجنات","cause":"إقامة الصلاة وإيتاء الزكاة والإيمان بالرسل ونصرتهم وإقراض الله قرضاً حسناً","result":"معية الله وتكفير السيئات ودخول الجنات","explicit":true,"otherNeedIds":[11,67],"ref":"سورة المائدة: 12","srcLabel":"القرآن الكريم","quran":{"s":5,"from":12,"to":12,"text":"وَلَقَدْ أَخَذَ اللَّهُ مِيثَاقَ بَنِي إِسْرَائِيلَ وَبَعَثْنَا مِنْهُمُ اثْنَيْ عَشَرَ نَقِيبًا وَقَالَ اللَّهُ إِنِّي مَعَكُمْ لَئِنْ أَقَمْتُمُ الصَّلَاةَ وَآتَيْتُمُ الزَّكَاةَ وَآمَنْتُمْ بِرُسُلِي وَعَزَّرْتُمُوهُمْ وَأَقْرَضْتُمُ اللَّهَ قَرْضًا حَسَنًا لَأُكَفِّرَنَّ عَنْكُمْ سَيِّئَاتِكُمْ وَلَأُدْخِلَنَّكُمْ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ فَمَنْ كَفَرَ بَعْدَ ذَلِكَ مِنْكُمْ فَقَدْ ضَلَّ سَوَاءَ السَّبِيلِ (12)","hl":[[97,113,1],[113,128,2],[128,261,1],[261,364,2]]}},{"id":"ق-0446","fp":"edb0c15f0880","stateId":263,"easy":"الصلاح ← ولاية الله","cause":"الصلاح","result":"ولاية الله","explicit":true,"ref":"سورة الأعراف: 196","srcLabel":"القرآن الكريم","quran":{"s":7,"from":196,"to":196,"text":"إِنَّ وَلِيِّيَ اللَّهُ الَّذِي نَزَّلَ الْكِتَابَ وَهُوَ يَتَوَلَّى الصَّالِحِينَ (196)","hl":[[51,68,2],[68,82,1]]}},{"id":"ق-0456","fp":"547d9607ad23","stateId":263,"easy":"الإيمان ← معية الله","cause":"الإيمان","result":"معية الله","explicit":true,"similar":["ق-1210"],"ref":"سورة الأنفال: 19","srcLabel":"القرآن الكريم","quran":{"s":8,"from":19,"to":19,"text":"إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ وَإِنْ تَنْتَهُوا فَهُوَ خَيْرٌ لَكُمْ وَإِنْ تَعُودُوا نَعُدْ وَلَنْ تُغْنِيَ عَنْكُمْ فِئَتُكُمْ شَيْئًا وَلَوْ كَثُرَتْ وَأَنَّ اللَّهَ مَعَ الْمُؤْمِنِينَ (19)","hl":[[170,190,2],[190,205,1]]}},{"id":"ق-0467","fp":"b11202f62a67","stateId":263,"easy":"الصبر ← معية الله","cause":"الصبر","result":"معية الله","explicit":true,"ref":"سورة الأنفال: 46","srcLabel":"القرآن الكريم","quran":{"s":8,"from":46,"to":46,"text":"وَأَطِيعُوا اللَّهَ وَرَسُولَهُ وَلَا تَنَازَعُوا فَتَفْشَلُوا وَتَذْهَبَ رِيحُكُمْ وَاصْبِرُوا إِنَّ اللَّهَ مَعَ الصَّابِرِينَ (46)","hl":[[84,96,1],[96,114,2],[114,128,1]]}},{"id":"ق-0496","fp":"f6496b8788f0","stateId":263,"easy":"التقوى ← معية الله","cause":"التقوى","result":"معية الله","explicit":true,"repOf":"ق-0070","ref":"سورة التوبة: 36","quran":{"s":9,"from":36,"to":36,"text":"إِنَّ عِدَّةَ الشُّهُورِ عِنْدَ اللَّهِ اثْنَا عَشَرَ شَهْرًا فِي كِتَابِ اللَّهِ يَوْمَ خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ مِنْهَا أَرْبَعَةٌ حُرُمٌ ذَلِكَ الدِّينُ الْقَيِّمُ فَلَا تَظْلِمُوا فِيهِنَّ أَنْفُسَكُمْ وَقَاتِلُوا الْمُشْرِكِينَ كَافَّةً كَمَا يُقَاتِلُونَكُمْ كَافَّةً وَاعْلَمُوا أَنَّ اللَّهَ مَعَ الْمُتَّقِينَ (36)","hl":[[282,294,1],[294,312,2],[312,326,1]]}},{"id":"ق-0538","fp":"d96a8abd1654","stateId":263,"easy":"التقوى ← معية الله","cause":"التقوى","result":"معية الله","explicit":true,"repOf":"ق-0070","ref":"سورة التوبة: 123","quran":{"s":9,"from":123,"to":123,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا قَاتِلُوا الَّذِينَ يَلُونَكُمْ مِنَ الْكُفَّارِ وَلْيَجِدُوا فِيكُمْ غِلْظَةً وَاعْلَمُوا أَنَّ اللَّهَ مَعَ الْمُتَّقِينَ (123)","hl":[[110,122,1],[122,140,2],[140,154,1]]}},{"id":"ق-0691","fp":"ab95fe5cd672","stateId":263,"easy":"الصبر والتقوى والإحسان ← معية الله وذهاب الحزن والضيق","cause":"الصبر والتقوى والإحسان","result":"معية الله وذهاب الحزن والضيق","explicit":true,"otherNeedIds":[5],"ref":"سورة النحل: 127–128","srcLabel":"القرآن الكريم","quran":{"s":16,"from":127,"to":128,"text":"وَاصْبِرْ وَمَا صَبْرُكَ إِلَّا بِاللَّهِ وَلَا تَحْزَنْ عَلَيْهِمْ وَلَا تَكُ فِي ضَيْقٍ مِمَّا يَمْكُرُونَ (127) إِنَّ اللَّهَ مَعَ الَّذِينَ اتَّقَوْا وَالَّذِينَ هُمْ مُحْسِنُونَ (128)","hl":[[0,42,1],[42,108,2],[108,115,1],[115,133,2],[133,182,1]]}},{"id":"ق-0762","fp":"4b78223f6bad","stateId":263,"easy":"القيام بأمر الله وعدم الفتور عن ذكره ← معية الله وسمعه ورؤيته وذهاب الخوف","cause":"القيام بأمر الله وعدم الفتور عن ذكره","result":"معية الله وسمعه ورؤيته وذهاب الخوف","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[6],"ref":"سورة طه: 42–46","srcLabel":"القرآن الكريم","quran":{"s":20,"from":42,"to":46,"text":"اذْهَبْ أَنْتَ وَأَخُوكَ بِآيَاتِي وَلَا تَنِيَا فِي ذِكْرِي (42) اذْهَبَا إِلَى فِرْعَوْنَ إِنَّهُ طَغَى (43) فَقُولَا لَهُ قَوْلًا لَيِّنًا لَعَلَّهُ يَتَذَكَّرُ أَوْ يَخْشَى (44) قَالَا رَبَّنَا إِنَّنَا نَخَافُ أَنْ يَفْرُطَ عَلَيْنَا أَوْ أَنْ يَطْغَى (45) قَالَ لَا تَخَافَا إِنَّنِي مَعَكُمَا أَسْمَعُ وَأَرَى (46)","hl":[[35,262,1],[262,316,2]]}},{"id":"ق-0832","fp":"e4d16a823397","stateId":263,"easy":"الاعتصام بالله ← ولاية الله ونصرته","cause":"الاعتصام بالله","result":"ولاية الله ونصرته","explicit":true,"ref":"سورة الحج: 78","srcLabel":"القرآن الكريم","quran":{"s":22,"from":78,"to":78,"text":"وَجَاهِدُوا فِي اللَّهِ حَقَّ جِهَادِهِ هُوَ اجْتَبَاكُمْ وَمَا جَعَلَ عَلَيْكُمْ فِي الدِّينِ مِنْ حَرَجٍ مِلَّةَ أَبِيكُمْ إِبْرَاهِيمَ هُوَ سَمَّاكُمُ الْمُسْلِمِينَ مِنْ قَبْلُ وَفِي هَذَا لِيَكُونَ الرَّسُولُ شَهِيدًا عَلَيْكُمْ وَتَكُونُوا شُهَدَاءَ عَلَى النَّاسِ فَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ وَاعْتَصِمُوا بِاللَّهِ هُوَ مَوْلَاكُمْ فَنِعْمَ الْمَوْلَى وَنِعْمَ النَّصِيرُ (78)","hl":[[313,337,1],[337,393,2]]}},{"id":"ق-1187","fp":"f967d6f8b96b","stateId":263,"easy":"التقوى ← ولاية الله","cause":"التقوى","result":"ولاية الله","explicit":true,"repOf":"ق-0070","ref":"سورة الجاثية: 19","quran":{"s":45,"from":19,"to":19,"text":"إِنَّهُمْ لَنْ يُغْنُوا عَنْكَ مِنَ اللَّهِ شَيْئًا وَإِنَّ الظَّالِمِينَ بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ وَاللَّهُ وَلِيُّ الْمُتَّقِينَ (19)","hl":[[104,121,2],[121,135,1]]}},{"id":"ق-1210","fp":"fa89fff16335","stateId":263,"easy":"الإيمان ← ولاية الله","cause":"الإيمان","result":"ولاية الله","explicit":true,"repOf":"ق-0456","ref":"سورة محمد: 11","quran":{"s":47,"from":11,"to":11,"text":"ذَلِكَ بِأَنَّ اللَّهَ مَوْلَى الَّذِينَ آمَنُوا وَأَنَّ الْكَافِرِينَ لَا مَوْلَى لَهُمْ (11)","hl":[[0,7,1],[7,30,2],[30,48,1]]}},{"id":"س-07935","fp":"ef9ab81f1c5b","stateId":263,"easy":"إذا جاهدت في سبيل الله ← تكون في ضمان الله","cause":"من جاهدَ في سبيلِ اللَّهِ","result":"كانَ ضامنًا على اللَّهِ","explicit":true,"ref":"المهذب في اختصار السنن 7/3720","srcLabel":"أحمد","text":["عن عبدِ اللَّهِ بنِ عمرٍو أنَّهُ مرَّ بمعاذِ بنِ جبلٍ وَهوَ قاعدٌ على بابِهِ يُشيرُ بيدِهِ كأنَّهُ يحدِّثُ نفسَهُ فقالَ لَهُ عبدُ اللَّهِ ما شأنُكَ يا أبا عبدِ الرَّحمنِ تحدِّثُ نفسَكَ قالَ وما لي يريدُ عدوُّ اللَّهِ أن يلهيَني عن كلامٍ سَمِعْتُه من رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ تُكابدُ دَهْرَكَ الآنَ في بيتِكَ ألا تخرجُ إلى المجلِسِ فتحدِّثُ وأنا سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ ",["من جاهدَ في سبيلِ اللَّهِ",1]," ",["كانَ ضامنًا على اللَّهِ",2]," ومن جلسَ في بيتِهِ لا يغتابُ أحدًا بسوءٍ كانَ ضامنًا على اللَّهِ ومن عادَ مريضًا كانَ ضامنًا على اللَّهِ ومن غدا إلى المسجدِ أو راحَ كانَ ضامنًا على اللَّهِ ومن دخلَ على إمامٍ يعزِّرُهُ كانَ ضامنًا على اللَّهِ فيريدُ عدوُّ اللَّهِ أن يُخْرِجَني من بيتي إلى المجلِسِ"],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (22093)، وابن حبان (372) مختصراً، والبيهقي (19009) واللفظ له","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"vON96BFm","merged":3,"otherRefs":["السلسلة الصحيحة 7/1149 (صحيح)","صحيح الترغيب 1268 (صحيح)"]},{"id":"س-08003","fp":"6c1a5bbb7ba9","stateId":263,"easy":"إذا كنت قاضياً ولم تجُر ← يكون الله معك","cause":"ما لمْ يَجُرْ","result":"إنَّ اللهَ تعالى معَ القاضِي","explicit":true,"otherNeedIds":[54],"ref":"الجامع الصغير 1798","srcLabel":"الترمذي","text":[["إنَّ اللهَ تعالى معَ القاضِي",2]," ",["ما لمْ يَجُرْ",1],"،  فإذا جَارَ تَبَرَّأَ منهُ،  وألْزَمَهُ الشيطانُ"],"grade":"صحيح","narrator":"عبدالله بن أبي أوفى","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1330)، وابن ماجه (2312) باختلاف يسير","bab":"مظالم › تحريم الظلم","dorar":"M1BDeNQE","merged":3,"otherRefs":["المستدرك على الصحيحين 7221 (صحيح)","فيض القدير 5/ 492 (حسن)"]},{"id":"س-00705","fp":"34d261cd34cb","stateId":263,"easy":"إذا خلوت في سفرك بذكر الله ← يكون رديفك ملك","cause":"ما من راكبٍ يخلو في مسيرِه باللهِ و ذِكرِه","result":"إلا كان رَدْفَه ملَكٌ","explicit":true,"otherNeedIds":[31],"ref":"صحيح الجامع 5706","srcLabel":"الطبراني","text":[["ما من راكبٍ يخلو في مسيرِه باللهِ و ذِكرِه",1]," ، ",["إلا كان رَدْفَه ملَكٌ",2]," ، و لا يخلو بشعرِه و نحوه ، إلا كان رَدفَه شيطانٌ"],"grade":"حسن","narrator":"عقبة بن عامر","muhaddith":"حسن","takhrij":"أخرجه الطبراني (17/324) (895) باختلاف يسير","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"iohSczX5","merged":2,"otherRefs":["الترغيب والترهيب 4/111 (حسن)"]},{"id":"س-01524","fp":"72d81e4edca3","stateId":263,"easy":"إذا أذّنت ← فيد الله عليك حتى تفرغ","cause":"المُؤذِّنِ حتى يفرُغَ مِنْ أذانِهِ","result":"يدُ اللهِ على","explicit":true,"ref":"المجروحين 2/136","srcLabel":"ابن حبان","text":[["يدُ اللهِ على",2]," ",["المُؤذِّنِ حتى يفرُغَ مِنْ أذانِهِ",1]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"هذا أنكر شيء حدث به عبد السلام بن صالح","takhrij":"أخرجه ابن حبان في ((المجروحين)) (2/79) واللفظ له، والطبراني في ((المعجم الأوسط)) (1987)، وابن عدي في ((الكامل في الضعفاء)) (5/49) باختلاف يسير مطولاً.","bab":"أذان › فضل التأذين","dorar":"qZVr1L0D"},{"id":"س-03859","fp":"9a0916b3d33e","stateId":263,"easy":"إذا أسلمت ← فوليّك الله ورسوله","cause":"وأسلمنا","result":"فمن وَليُّنا قالَ اللَّهُ ورسولُهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الصحيح المسند 1071","srcLabel":"أحمد","text":["عن عبدِ اللَّهِ بنِ فيروزَ الدَّيلميِّ عن أبيهِ أنَّهم أسلموا وكانَ فيمن أسلمَ فبعثوا وفدَهم إلى رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وعلى آلِهِ وسلَّمَ ببيعتِهم وإسلامِهم فقبِلَ ذلكَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وعلى آلِهِ وسلَّمَ منهم فقالوا يا رسولَ اللَّهِ نحنُ مَن قد عرفتَ وجئنا من حيثُ قد علِمتَ ",["وأسلمنا",1]," ",["فمن وَليُّنا قالَ اللَّهُ ورسولُهُ",2]," قالوا حسْبُنا رضيناهُ"],"grade":"صحيح","narrator":"فيروز الديلمي","muhaddith":"صحيح","takhrij":"أخرجه أحمد (18037) واللفظ له، وأبو يعلى (6825)، وابن عساكر (49/ 17) بنحوه.","bab":"بيعة › مبايعة الإمام","dorar":"RZ2vi5Hi"},{"id":"س-07916","fp":"477e097dbf59","stateId":263,"easy":"إذا كنت في المسجد أو عند مريض أو في جنازة أو بيتك ← فأنت في ضمان الله","cause":"في مَسجدِ جَماعةٍ ، وعندَ مَريضٍ ، أو في جِنازةٍ ، أو في بيتِه ، أو عِند إمامٍ مُقسِطٍ يُعزِّرُه و يوقِّرُه ، أو في مَشهدِ جِهادٍ","result":"المؤمِنُ ضامنٌ على اللهِ تعالى","explicit":true,"otherNeedIds":[31],"ref":"صحيح الترغيب 328","srcLabel":"الطبراني","text":["سِتُّ مجالِسَ ، ",["المؤمِنُ ضامنٌ على اللهِ تعالى",2]," ما كانَ في شَيءٍ منها : ",["في مَسجدِ جَماعةٍ ، وعندَ مَريضٍ ، أو في جِنازةٍ ، أو في بيتِه ، أو عِند إمامٍ مُقسِطٍ يُعزِّرُه و يوقِّرُه ، أو في مَشهدِ جِهادٍ",1]],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن لغيره","takhrij":"أخرجه عبد بن حميد في ((المسند)) (337)، والبزار كما في ((الترغيب والترهيب)) للمنذري (1/137)، والطبراني (14/60) (14655)","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"oL83SRwz"},{"id":"س-01672","fp":"4d553b29c897","stateId":263,"easy":"إذا قضيت بين الناس ولم تجُر عمداً ← فالله معك","cause":"ما لم يَحِفْ عمدًا","result":"اللهُ مع القاضي","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"otherNeedIds":[54],"ref":"تخريج العواصم والقواصم 1/ 198","srcLabel":"أحمد","text":["أمَرَني النَّبيُّ صلَّى اللهُ عليه وسلَّمَ أنْ أقضِيَ بين قومٍ، فقُلتُ: ما أحسَنُ أنْ أقضِيَ يا رسولَ اللهِ؟ قال: ",["اللهُ مع القاضي",2]," ",["ما لم يَحِفْ عمدًا",1],"."],"grade":"حسن","narrator":"معقل بن يسار","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (20305) واللفظ له، والطبراني (20/230) (540)، والحاكم (6470)","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"szvQf2Bc"},{"id":"س-01051","fp":"ad977eb1fcb1","stateId":263,"easy":"إذا ذكرت الله ← فهو معك","cause":"حين يَذْكُرُني","result":"أنا مع عَبْدي","explicit":true,"similar":["س-00708"],"ref":"تخريج المسند لشعيب 7422","srcLabel":"متفق عليه","text":["يَقولُ اللهُ عزَّ وجلَّ: ",["أنا مع عَبْدي",2]," ",["حين يَذْكُرُني",1],"، فإنْ ذكَرَني في نَفْسِه ذكَرْتُه في نَفْسي، وإنْ ذكَرَني في مَلَإٍ، ذكَرْتُه في مَلَإٍ هُم خَيْرٌ مِنهم، وإن اقترَبَ إليَّ شِبْرًا اقترَبْتُ إليه ذِراعًا، فإنِ اقترَبَ إليَّ ذِراعًا اقترَبْتُ إليه باعًا، فإنْ أتاني يَـمْشي أتَيْتُه هَرْوَلةً، وقال ابنُ نُـمَيْرٍ في حَديثِه: أنا عِنْدَ ظَنِّ عَبْدي بي، وأنا معَه حين يَذْكُرُني."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (7405)، ومسلم (2675)، والترمذي (3603)، والنسائي في ((السنن الكبرى)) (7730)، وابن ماجه (3822)، وأحمد (7422) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"24Sg0grd"},{"id":"س-00708","fp":"085704b246f9","stateId":263,"easy":"إذا ذكرت الله ← يكون معك","cause":"إذَا ذَكَرْتَنِي","result":"وَأَنَا مَعَكَ","explicit":true,"repOf":"س-01051","ref":"صحيح الجامع 4325","text":["قال اللهُ تعالى : عبدي أنا عندَ ظنِّكَ بِي ، ",["وَأَنَا مَعَكَ",2]," ",["إذَا ذَكَرْتَنِي",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (1828)","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"57Vof6RN","merged":2,"otherRefs":["السلسلة الصحيحة 2012 (صحيح)"]},{"id":"ق-0468","fp":"874f85e56501","stateId":264,"easy":"التوكل على الله ← عزة الله وحكمته تكفيه","cause":"التوكل على الله","result":"عزة الله وحكمته تكفيه","explicit":true,"star":true,"ref":"سورة الأنفال: 49","srcLabel":"القرآن الكريم","quran":{"s":8,"from":49,"to":49,"text":"إِذْ يَقُولُ الْمُنَافِقُونَ وَالَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ غَرَّ هَؤُلَاءِ دِينُهُمْ وَمَنْ يَتَوَكَّلْ عَلَى اللَّهِ فَإِنَّ اللَّهَ عَزِيزٌ حَكِيمٌ (49)","hl":[[90,123,1],[123,154,2]]}},{"id":"ق-0475","fp":"a4e28c6a19b2","stateId":264,"easy":"التوكل على الله عند خوف الخديعة ← حسبُه الله وتأييده بنصره وبالمؤمنين","cause":"التوكل على الله عند خوف الخديعة","result":"حسبُه الله وتأييده بنصره وبالمؤمنين","explicit":true,"star":true,"otherNeedIds":[31],"ref":"سورة الأنفال: 61–62","srcLabel":"القرآن الكريم","quran":{"s":8,"from":61,"to":62,"text":"وَإِنْ جَنَحُوا لِلسَّلْمِ فَاجْنَحْ لَهَا وَتَوَكَّلْ عَلَى اللَّهِ إِنَّهُ هُوَ السَّمِيعُ الْعَلِيمُ (61) وَإِنْ يُرِيدُوا أَنْ يَخْدَعُوكَ فَإِنَّ حَسْبَكَ اللَّهُ هُوَ الَّذِي أَيَّدَكَ بِنَصْرِهِ وَبِالْمُؤْمِنِينَ (62)","hl":[[43,143,1],[143,220,2]]}},{"id":"ق-0542","fp":"298809b2d37f","stateId":264,"easy":"قول «حسبي الله لا إله إلا هو عليه توكلت» عند تولّي الناس ← كفاية الله","cause":"قول «حسبي الله لا إله إلا هو عليه توكلت» عند تولّي الناس","result":"كفاية الله","explicit":true,"star":true,"apply":{"k":"say","t":"«حسبي الله لا إله إلا هو عليه توكلت»"},"otherNeedIds":[4],"ref":"سورة التوبة: 129","srcLabel":"القرآن الكريم","quran":{"s":9,"from":129,"to":129,"text":"فَإِنْ تَوَلَّوْا فَقُلْ حَسْبِيَ اللَّهُ لَا إِلَهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ (129)","hl":[[0,119,1]]}},{"id":"ق-0661","fp":"1c0ea48831f9","stateId":264,"easy":"الصدع بأمر الله والإعراض عن المشركين ← كفاية الله المستهزئين","cause":"الصدع بأمر الله والإعراض عن المشركين","result":"كفاية الله المستهزئين","explicit":true,"otherNeedIds":[31],"ref":"سورة الحجر: 94–95","srcLabel":"القرآن الكريم","quran":{"s":15,"from":94,"to":95,"text":"فَاصْدَعْ بِمَا تُؤْمَرُ وَأَعْرِضْ عَنِ الْمُشْرِكِينَ (94) إِنَّا كَفَيْنَاكَ الْمُسْتَهْزِئِينَ (95)","hl":[[0,61,1],[61,98,2]]}},{"id":"ق-0984","fp":"fcd5ec86f4a6","stateId":264,"easy":"التوكل على الله ← كفاية الله وكيلاً","cause":"التوكل على الله","result":"كفاية الله وكيلاً","explicit":true,"similar":["ق-1089","ق-1351"],"ref":"سورة الأحزاب: 3","srcLabel":"القرآن الكريم","quran":{"s":33,"from":3,"to":3,"text":"وَتَوَكَّلْ عَلَى اللَّهِ وَكَفَى بِاللَّهِ وَكِيلًا (3)","hl":[[0,26,1],[26,52,2]]}},{"id":"ق-1088","fp":"c04e71524876","stateId":264,"easy":"العبودية لله ← كفاية الله عبده","cause":"العبودية لله","result":"كفاية الله عبده","explicit":true,"otherNeedIds":[31],"ref":"سورة الزمر: 36","srcLabel":"القرآن الكريم","quran":{"s":39,"from":36,"to":36,"text":"أَلَيْسَ اللَّهُ بِكَافٍ عَبْدَهُ وَيُخَوِّفُونَكَ بِالَّذِينَ مِنْ دُونِهِ وَمَنْ يُضْلِلِ اللَّهُ فَمَا لَهُ مِنْ هَادٍ (36)","hl":[[0,24,2],[24,33,1]]}},{"id":"ق-1089","fp":"043c88a71c84","stateId":264,"easy":"التوكل على الله وقول «حسبي الله» ← كفاية الله","cause":"التوكل على الله وقول «حسبي الله»","result":"كفاية الله","explicit":true,"apply":{"k":"say","t":"«حسبي الله»"},"repOf":"ق-0984","ref":"سورة الزمر: 38","quran":{"s":39,"from":38,"to":38,"text":"وَلَئِنْ سَأَلْتَهُمْ مَنْ خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ لَيَقُولُنَّ اللَّهُ قُلْ أَفَرَأَيْتُمْ مَا تَدْعُونَ مِنْ دُونِ اللَّهِ إِنْ أَرَادَنِيَ اللَّهُ بِضُرٍّ هَلْ هُنَّ كَاشِفَاتُ ضُرِّهِ أَوْ أَرَادَنِي بِرَحْمَةٍ هَلْ هُنَّ مُمْسِكَاتُ رَحْمَتِهِ قُلْ حَسْبِيَ اللَّهُ عَلَيْهِ يَتَوَكَّلُ الْمُتَوَكِّلُونَ (38)","hl":[[258,318,1]]}},{"id":"ق-1351","fp":"79fb9d658254","stateId":264,"easy":"التوكل على الله ← كفاية الله (فهو حسبه)","cause":"التوكل على الله","result":"كفاية الله (فهو حسبه)","explicit":true,"repOf":"ق-0984","otherNeedIds":[4],"ref":"سورة الطلاق: 3","quran":{"s":65,"from":3,"to":3,"text":"وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ وَمَنْ يَتَوَكَّلْ عَلَى اللَّهِ فَهُوَ حَسْبُهُ إِنَّ اللَّهَ بَالِغُ أَمْرِهِ قَدْ جَعَلَ اللَّهُ لِكُلِّ شَيْءٍ قَدْرًا (3)","hl":[[40,73,1],[73,88,2]]}},{"id":"س-06908","fp":"fafb3ca6698e","stateId":264,"easy":"إذا صليت أربع ركعات أول النهار ← يكفيك الله آخره","cause":"ارْكَعْ لي أَرْبَعَ رَكَعاتٍ من أولِ النهارِ","result":"أَكْفِكَ آخِرَهُ","explicit":true,"apply":{"k":"count","t":"أربع ركعات"},"similar":["س-02094"],"otherNeedIds":[4],"ref":"هداية الرواة 1265","srcLabel":"الترمذي","text":["قال رسولُ اللهِ - صلَّى اللهُ عليهِ وسلَّم -، عنِ اللهِ – تبارك وتعالى -، أنه قال : يا ابنَ آدمَ ! ",["ارْكَعْ لي أَرْبَعَ رَكَعاتٍ من أولِ النهارِ",1]," ؛ ",["أَكْفِكَ آخِرَهُ",2]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (475)، وأبو نعيم في ((حلية الأولياء)) (5/137)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"lpn5jyCk","merged":4,"otherRefs":["صحيح ابن حبان 2533 (صحيح)","تخريج المسند لشعيب 27480 (صحيح)","إتحاف الخيرة المهرة 2/402 (صحيح)"]},{"id":"س-01663","fp":"ce3950853a1e","stateId":264,"easy":"إذا خلصت نيتك في الحق ولو على نفسك ← يكفيك الله ما بينك وبين الناس","cause":"فمن خلصَتْ نيَّتَه في الحقِّ ، ولو على نفسه","result":"كفاه اللهُ ما بينه وبين الناسِ","explicit":true,"otherNeedIds":[41],"ref":"منهاج السنة 6/71","srcLabel":"البيهقي","text":["كتب عمرُ بنُ الخطابِ رضي اللهُ عنه إلى أبي موسى الأشعريِّ : أما بعدُ فإنَّ القضاءَ فريضةٌ محكمةٌ ، وسُنَّةٌ مُتَّبعةٌ ، فافْهم إذا أُدلَى إليك ، فإنه لا ينفع تكلُّمٌ بحقٍّ لا نفاذَ له ، آسِ بين الناسِ في مجلسِك ووجهِك وقضائِك ، حتى لا يطمع شريفٌ في حَيْفِك ، ولا ييأسُ ضعيفٌ من عدلِك . البيِّنةُ على من ادَّعى ، واليمينُ على من أنكر ، والصلحُ جائزٌ بين المسلمين ، إلا صلحًا أحلَّ حرامًا ، أو حرَّم حلالًا . ومن ادَّعى حقًّا غائبًا فامدُدْ له أمدًا ينتهي إليه ، فإن جاء ببينةٍ فأَعطِه حقَّه ، وإن أعجزَه ذلك استحللتَ عليه القضيةَ ، فإنَّ ذلك هو أبلغُ في العُذرِ ، وأجلى للعَمى ، ولا يمنعك قضاءٌ قضيتَه اليومَ فراجعتَ فيه رأيَك فهُديت فيه لرُشدِك أن تراجعَ الحقَّ ، فإنَّ الحقَّ قديمٌ ، وليس يُبطلُه شيءٌ ، ومراجعةُ الحقِّ خيرٌ من التَّمادي في الباطل . والمسلمون عدولٌ بعضُهم على بعضٍ ، إلا مُجرَّبًا عليه شهادةَ زورٍ ، أو مجلودًا في حدٍّ ، أو ظنينًا في ولاءٍ أو نسبٍ ؛ فإنَّ اللهَ تولَّى من العبادِ السرائرَ ، وستر عليهم الحدودَ إلا بالبينات والأيمانِ . ثم الفهمَ الفهمَ فيما أُدليَ إليك وفيما ورد عليك ، مما ليس في قرآنٍ ولا سُنَّةٍ ، ثم قايِسِ الأمورَ عند ذلك ، ثم اعرف الأمثالَ ، ثم اعمد فيما ترى إلى أحبِّها إلى اللهِ وأشبهِها بالحقِّ . وإياك والغضبَ والقلقَ والضجرَ والتأذِّي بالخصومِ ؛ فإنَّ القضاءَ في مواطنِ الحقِّ مما يوجب اللهُ به الأجرَ ، ويحسنُ به الذَّخرُ ، ",["فمن خلصَتْ نيَّتَه في الحقِّ ، ولو على نفسه",1]," ، ",["كفاه اللهُ ما بينه وبين الناسِ",2]," ، ومن تزيَّنَ بما ليس في نفسِه شانَه اللهُ عزَّ وجلَّ ؛ فإنَّ اللهَ عزَّ وجلَّ لا يقبلُ من العبدِ إلا ما كان له خالصًا ، فما ظنُّك بثوابٍ عند اللهِ في عاجلِ رزقِه وخزائنِ رحمتِه"],"grade":"صحيح","narrator":"جعفر بن برقان","muhaddith":"إسناده ثابت","takhrij":"أخرجه البيهقي (20567)، والدارقطني (4471) باختلاف يسير.","bab":"أقضية وأحكام › الاجتهاد في الحكم","dorar":"eQyJvIYr"},{"id":"س-02094","fp":"204aa032cd6b","stateId":264,"easy":"إذا صليت أربع ركعات أول النهار ← يكفيك الله آخره","cause":"اكفِني أولَ النهارِ بأربعِ ركعاتٍ","result":"أكفِكَ بهِنَّ آخرَ يومِكَ","explicit":true,"apply":{"k":"count","t":"أربع ركعات"},"repOf":"س-06908","ref":"كشف اللثام 3/610","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: إنَّ اللهَ عزَّ وجلَّ يقولُ: يا ابنَ آدمَ!",[" اكفِني أولَ النهارِ بأربعِ ركعاتٍ ",1],["أكفِكَ بهِنَّ آخرَ يومِكَ",2]],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد  (17390) وابن عساكر في ((تاريخه)) (62/ 188) واللفظ لهما ، وأبو يعلى  (1757) بمعناه .","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"L5wp7PjU"},{"id":"س-05137","fp":"9d4fb5e5227c","stateId":264,"easy":"إذا التمست رضا الله ولو بسخط الناس ← يكفيك الله مؤونة الناس","cause":"مَن التمَس رضا اللهِ بسخَطِ الناسِ","result":"كفاه اللهُ مَؤُونةَ الناسِ","explicit":true,"similar":["س-06923","س-06951"],"ref":"تخريج زاد المعاد 3/14","srcLabel":"الترمذي","text":["أنَّها كتَبتْ إلى معاويةَ: سلامٌ عليك، أمَّا بعدُ، فإنِّي سَمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن التمَس رضا اللهِ بسخَطِ الناسِ، ",1],["كفاه اللهُ مَؤُونةَ الناسِ، ",2],"ومَن التمَس رضا الناسِ بسخَطِ اللهِ، وكَله اللهُ إلى الناسِ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (2414) واللفظ له، وابن حبان (276)، وإسحاق بن راهويه في ((المسند)) (1175) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"XEUnQjM4"},{"id":"س-06437","fp":"c8b324b91eb7","stateId":264,"easy":"إذا توكلت على الله ← يكفيك","cause":"ومن توكَّل عليَّ","result":"كفَيْتُه","explicit":true,"ref":"الترغيب والترهيب 4/333","srcLabel":"البزار","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم أُتِي بفرَسٍ يجعلُ كلَّ خطوٍ منه أقصَى بصرِه ، فسار وسار معه جبريلُ عليه السَّلامُ ، فأتَى على قومٍ يزرَعون في يومٍ ويحصُدون في يومٍ كلَّما حصدوا عاد كما كان ، فقال : يا جبريلُ من هؤلاء ؟ قال : هؤلاء المجاهدون في سبيلِ اللهِ ، تُضاعَفُ لهم الحسنةُ بسبعِمائةِ ضِعفٍ وما أنفقوا من شيءٍ فهو يُخلِفُه ، ثمَّ أتَى على قومٍ تُرضَخُ رءوسُهم بالصَّخرِ كلَّما رُضِخت عادت كما كانت ، ولا يفتُرُ عنهم من ذلك شيءٌ ، قال : يا جبريلُ من هؤلاء ؟ قال : هؤلاء الَّذين تثاقلت رءوسُهم عن الصَّلاةِ ، ثمَّ أتَى على قومٍ على أدبارِهم رِقاعٌ ، وعلى أقبالِهم رِقاعٌ يسرَحون كما تسرَحُ الأنعامُ إلى الضَّريعِ والزَّقُّومِ ورِضفِ جهنَّمَ قال : ما هؤلاء يا جبريلُ ؟ قال هؤلاء الَّذين لا يُؤدُّون صدقاتِ أموالِهم ، وما ظلمهم اللهُ ، وما اللهُ بظلَّامٍ للعبيدِ . ثمَّ أتَى على رجلٍ قد جمع حِزمةً عظيمةً لا يستطيعُ حملَها وهو يريدُ أن يزيدَ عليها ، قال : يا جبريلُ ما هذا ؟ قال : هذا رجلٌ من أمَّتِك عليه أمانةُ النَّاسِ لا يستطيعُ أداءَها وهو يريدُ أن يزيدَ عليها ، ثمَّ أتَى على قومٍ تُقرَضُ شِفاهُهم وألسنتُهم بمقاريضَ من حديدٍ ، كلَّما قُرِضتْ عادت كما كانت ، لا يفتُرُ عنهم من ذلك شيءٌ ، قال : يا جبريلُ ما هؤلاء ؟ قال : خطباءُ الفِتنةِ ، ثمَّ أتَى على جُحرٍ صغيرٍ يخرُجُ منه ثوْرٌ عظيمٌ فيُريدُ الثَّورُ أن يدخُلَ من حيث خرج فلا يستطيعُ ، قال : ما هذا يا جبريلُ ؟ قال : هذا الرَّجلُ يتكلَّمُ بالكلمةِ العظيمةِ فيندَمُ عليها فيُريدُ أن يرُدَّها فلا يستطيعُ ، ثمَّ أتَى على وادٍ فوجد ريحًا طيِّبةً ووجد ريحَ مِسكٍ مع صوتٍ ، فقال : ما هذا ؟ قال : صوتُ الجنَّةِ تقولُ : يا ربِّ ائتِني بأهلي وبما وعدتَني فقد كثُر غرسي وحريري وسُندسي وإستبرقي وعبقريِّي ومرجاني وفضَّتي وذهبي وأكوابي وصِحافي وأباريقي وفواكهي وعسلي ومائي ولبني وخمري ، ائتِني بما وعدتَني . قال : لك كلُّ مسلمٍ ومسلمةٍ ومؤمنٍ ومؤمنةٍ ، ومن آمن بي وبرسلي ، وعمِل صالحًا ولم يُشرِكْ بي شيئًا ، ولم يتَّخِذْ من دوني أندادًا فهو آمِنٌ ، ومن سألني أعطيتُه ، ومن أقرضني جزيْتُه ، ",["ومن توكَّل عليَّ",1]," ",["كفَيْتُه",2]," ، إنِّي أنا اللهُ لا إلهَ إلَّا أنا ، لا خُلْفَ لميعادي ، قد أفلح المؤمنون ، تبارك اللهُ أحسنُ الخالقين ، فقالت : قد رَضيتُ ، ثمَّ أتَى على وادٍ فسمِع صوتًا مُنكَرًا ، فقال : يا جبريلُ ما هذا الصَّوتُ ؟ قال : هذا صوتُ جهنَّمَ تقولُ : يا ربِّ ائتِني بأهلي وبما وعدتَني فقد كثُرت سلاسلي وأغلالي وسعيري وحميمي وغَسَّاقي وغسليني ، وقد بعُد قعري ، واشتدَّ حرِّي ، ائتِني بما وعدتَني ، قال : لك كلُّ مشركٍ ومشركةٍ ، وخبيثٍ وخبيثةٍ ، وكلُّ جبَّارٍ لا يُؤمِنُ بيومِ الحسابِ ، قالت : قد رضِيتُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه البزار (9518)، وابن أبي حاتم في ((التفسير)) (13521) باختلاف يسير، والطبري في ((التفسير)) (14/424) على الشك في راويه أبو هريرة أو غيره","bab":"صلاة › تارك الصلاة","dorar":"CrAPhgwx"},{"id":"س-06923","fp":"d1dcf390049d","stateId":264,"easy":"إذا أرضيت الله بسخط الناس ← يكفيك الله الناس","cause":"من أرْضى اللهَ بسخَطِ الناسِ","result":"كفاه اللهُ الناسَ","explicit":true,"repOf":"س-05137","ref":"السلسلة الصحيحة 2311","text":[["من أرْضى اللهَ بسخَطِ الناسِ ، ",1],["كفاه اللهُ الناسَ",2]," ، و من أسخط اللهَ بِرضى الناسِ ، وكلَه اللهُ إلى الناسِ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2414) بنحوه، وعبد بن حميد في ((المسند)) (1522)، وابن حبان (277) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"jYc1CQfF"},{"id":"س-06951","fp":"89e5d123e0db","stateId":264,"easy":"إذا أسخطت الناس برضا الله ← يكفيك الله مؤونة الناس","cause":"و مَنْ أسخَطَ الناسَ برضا اللهِ","result":"كفاهُ اللهُ مُؤْنَةَ الناسِ","explicit":true,"repOf":"س-05137","ref":"صحيح الجامع 6010","text":["مَنْ أرْضَى الناسَ بسخَطِ اللهِ وكَلَهُ اللهُ إلى الناسِ ، ",["و مَنْ أسخَطَ الناسَ برضا اللهِ ",1],["كفاهُ اللهُ مُؤْنَةَ الناسِ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2414) بنحوه، وعبد بن حميد في ((المسند)) (1522)، وابن حبان (277) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"HO2G0FrH"},{"id":"س-04735","fp":"0333a63f2269","stateId":264,"easy":"إذا أحسنت فيما بينك وبين الله ← يكفيك الله ما بينك وبين الناس","cause":"منْ أحسنَ فيما بينهُ و بينَ اللهِ","result":"كفاهُ اللهُ ما بينهُ و بينَ الناسِ","explicit":true,"otherNeedIds":[41],"ref":"الجامع الصغير 8320","srcLabel":"الحاكم","text":[["منْ أحسنَ فيما بينهُ و بينَ اللهِ،  ",1],["كفاهُ اللهُ ما بينهُ و بينَ الناسِ",2],"،  و منْ أصلحَ سريرتَهُ أصلحَ اللهُ علانيتَهُ"],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن","takhrij":"لم نقف عليه إلا عند الحاكم في ((التاريخ)) كما في ((الجامع الصغير)) (‌‌12135).","bab":"رقائق وزهد › الإخلاص","dorar":"6NwxqCb1"},{"id":"س-05592","fp":"560b9ccbd5d1","stateId":264,"easy":"إذا انقطعت إلى الله ← يكفيك كل مؤونة ويرزقك من حيث لا تحتسب","cause":"من انقطعَ إلى اللهِ عزَّ وجلَّ","result":"كفاه اللهُ كلَّ مئونةٍ ورزقه من حيث لا يحتسبُ","explicit":true,"otherNeedIds":[1],"ref":"المتجر الرابح 333","srcLabel":"الطبراني","text":[["من انقطعَ إلى اللهِ عزَّ وجلَّ ",1],["كفاه اللهُ كلَّ مئونةٍ ورزقه من حيث لا يحتسبُ",2]," ومن انقطع إلى الدنيا وَكَلهُ اللهُ إليها."],"grade":"حسن","narrator":"عمران بن الحصين","muhaddith":"إسناده حسن إن صح سماع الحسن من عمران","takhrij":"أخرجه ابن أبي الدنيا في ((الفرج بعد الشدة)) (26)، والطبراني في ((المعجم الأوسط)) (3359)، والبيهقي في ((شعب الإيمان)) (1076)","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"bVIRYHAI"},{"id":"س-05368","fp":"7570365b5b88","stateId":265,"easy":"إذا احتجت ← تأتيك المعونة من الله على قدر المؤونة","cause":"عَلَى قَدْرِ المؤُونَةِ","result":"إنَّ المعونَةَ تَأْتِي مِنَ اللهِ","explicit":true,"star":true,"ref":"مجمع الزوائد 4/327","srcLabel":"البخاري","text":[["إنَّ المعونَةَ تَأْتِي مِنَ اللهِ",2]," ",["عَلَى قَدْرِ المؤُونَةِ",1]," وَإِنَّ الصبْرَ يَأْتِي مِنْ اللهِ عَلَى قَدْرِ البَلَاءِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"فيه صادق بن عمار قال البخاري لا يتابع على حديثه ، وبقية رجاله رجال الصحيح","takhrij":"أخرجه البزار (8878) واللفظ له، وأخرجه الحارث كما في ((بغية الباحث)) للهيثمي (423)، والبيهقي في ((شعب الإيمان)) (9956) باختلاف يسير","bab":"رقائق وزهد › التوكل واليقين","dorar":"ns5MeHg5","merged":4,"otherRefs":["شرح كتاب الشهاب 211 (حسن)","صحيح الجامع 3001 (صحيح)","صحيح الجامع 1919 (صحيح)"]},{"id":"س-07253","fp":"6be4f9d7b57c","stateId":265,"easy":"إذا كنت في عون أخيك ← يكون الله في عونك","cause":"ما كان العَبْدُ في عَوْنِ أَخيه","result":"واللهُ في عَوْنِ العَبْدِ","explicit":true,"star":true,"similar":["س-02045"],"otherNeedIds":[54],"ref":"تخريج المسند لشعيب 7427","srcLabel":"مسلم","text":["مَن نفَّسَ عن مُؤْمنٍ كُرْبَةً مِن كُرَبِ الدُّنيا؛ نفَّسَ اللهُ عَنه كُرْبَةً مِن كُرَبِ يَوْمِ القِيامَةِ، ومَن ستَرَ مُسْلمًا ستَرَه اللهُ في الدُّنيا والآخِرَةِ، ومَن يسَّرَ على مُعْسِرٍ يسَّرَ اللهُ عليه في الدُّنيا والآخِرَةِ، ",["واللهُ في عَوْنِ العَبْدِ",2]," ",["ما كان العَبْدُ في عَوْنِ أَخيه",1],"، ومَن سلَكَ طَريقًا يَلْتَمِسُ فيه عِلْمًا سهَّلَ اللهُ له به طَريقًا إلى الجنةِ، وما اجتمَعَ قَوْمٌ في بَيْتٍ مِن بُيوتِ اللهِ يَتْلُون كِتابَ اللهِ، ويَتَدارَسُونه بَيْنَهم؛ إلَّا نزلَتْ عليهم السَّكِينَةُ، وغشِيَتْهم الرَّحْـمةُ، وحفَّتْهم الـمَلائِكةُ، وذكَرَهم اللهُ عزَّ وجلَّ فيمَن عِندَه، ومَن أبْطَأَ به عَمَلُه، لَـمْ يُسْرِعْ به نَسَبُه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (2699) باختلاف يسير","bab":"علم › فضل مجالس العلم والذكر","dorar":"hv3Ejh53","merged":4,"otherRefs":["عمدة القاري 12/405 (صحيح)","السلسلة الصحيحة 2362 (صحيح)","صحيح البخاري 2442 (صحيح)"]},{"id":"س-05769","fp":"e0458b72d691","stateId":265,"easy":"إذا أُعطيت الإمارة من غير مسألة ← تُعان عليها","cause":"أُعطيتَها عن غيرِ مَسألةٍ","result":"أُعِنتَ عليها","explicit":true,"star":true,"ref":"صحيح البخاري 7147","srcLabel":"مسلم","text":["قال لي رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: يا عَبدَ الرَّحمَنِ بنَ سَمُرةَ، لا تَسألِ الإمارةَ، فإن أُعطيتَها عن مَسألةٍ وُكِلتَ إليها، وإن ",["أُعطيتَها عن غيرِ مَسألةٍ",1]," ",["أُعِنتَ عليها",2],"، وإذا حَلَفتَ على يَمينٍ فرَأيتَ غَيرَها خَيرًا منها، فأْتِ الذي هو خَيرٌ، وكَفِّرْ عن يَمينِكَ."],"grade":"صحيح","narrator":"عبدالرحمن بن سمرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1652) باختلاف يسير","bab":"رقائق وزهد › الوصايا النافعة","dorar":"2HzJm5NS","merged":2,"otherRefs":["صحيح مسلم 1652 (صحيح)"]},{"id":"ق-0918","fp":"6f6bc564ec03","stateId":265,"easy":"سؤال الله العون ← شدّ العضد والسلطان والغلبة","cause":"سؤال الله العون","result":"شدّ العضد والسلطان والغلبة","explicit":true,"otherNeedIds":[29],"ref":"سورة القصص: 35","srcLabel":"القرآن الكريم","quran":{"s":28,"from":35,"to":35,"text":"قَالَ سَنَشُدُّ عَضُدَكَ بِأَخِيكَ وَنَجْعَلُ لَكُمَا سُلْطَانًا فَلَا يَصِلُونَ إِلَيْكُمَا بِآيَاتِنَا أَنْتُمَا وَمَنِ اتَّبَعَكُمَا الْغَالِبُونَ (35)","hl":[[0,6,1],[6,149,2]]}},{"id":"س-06789","fp":"8e69e1aaa41e","stateId":265,"easy":"إذا جاهدت أو كاتبت تريد الأداء أو تزوجت للعفاف ← فحق على الله عونك","cause":"المُجاهِدُ في سَبيلِ اللهِ -وفي رِوايةٍ: (الغازي في سَبيلِ اللهِ)- والمُكاتَبُ الذي يُريدُ الأداءَ، والنَّاكِحُ الذي يُريدُ التَّعَفُّفَ","result":"ثَلاثةٌ كُلُّهم حَقٌّ على اللهِ عَونُه","explicit":true,"similar":["س-01291","س-06784"],"otherNeedIds":[37,2],"ref":"مجموع الشروح الفقهية. 135/30","srcLabel":"النسائي","text":[["ثَلاثةٌ كُلُّهم حَقٌّ على اللهِ عَونُه",2],":",[" المُجاهِدُ في سَبيلِ اللهِ -وفي رِوايةٍ: (الغازي في سَبيلِ اللهِ)- والمُكاتَبُ الذي يُريدُ الأداءَ، والنَّاكِحُ الذي يُريدُ التَّعَفُّفَ.",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (3120)، وابن ماجه (2518)، وأحمد (9631) باختلاف يسير.","bab":"عتق وولاء › المكاتب","dorar":"6YavJDhz","merged":5,"otherRefs":["البدر المنير 7/432 (صحيح)","المستدرك على الصحيحين 2899 (صحيح)","صحيح الجامع 3050 (حسن)","حاشية بلوغ المرام لابن باز 765 (صحيح)"]},{"id":"س-01291","fp":"a3b13bc3bfd6","stateId":265,"easy":"إذا تزوجت تريد العفاف ← فحق على الله عونك","cause":"مِنهمُ: النَّاكِحُ يُريدُ العَفافَ","result":"ثَلاثةٌ حَقٌّ على اللهِ عَونُهم","explicit":true,"repOf":"س-06789","otherNeedIds":[37],"ref":"مجموع الشروح الفقهية. 87/2","text":[["ثَلاثةٌ حَقٌّ على اللهِ عَونُهم",2],"،",[" مِنهمُ: النَّاكِحُ يُريدُ العَفافَ.",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1655)، والنسائي (3218)، والبيهقي (21638) بلفظه وفيه زيادة.","bab":"نكاح › الحث على التزويج","dorar":"gbrnLAN9","merged":2,"otherRefs":["فتاوى نور على الدرب لابن باز 20/24 (صحيح)"]},{"id":"س-00475","fp":"ff2798822f43","stateId":265,"easy":"إذا أخذت ديناً وأنت تنوي أداءه ← يعينك الله","cause":"مَن أخَذَ دَيْنًا وهو يُريدُ أن يُؤَدِّيَه","result":"أعانَه اللهُ","explicit":true,"otherNeedIds":[2],"ref":"الأحكام الوسطى 3/284","srcLabel":"النسائي","text":["عن عُبَيْدِ اللهِ بنِ عَبْدِ اللهِ بنِ عُتْبةَ: أنَّ مَيْمونةَ زَوْجَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ اسْتَدانَتْ، فقيلَ لها: يا أُمَّ المُؤْمِنينَ تَسْتَدينينَ، وليس عنْدَك وَفاءٌ، قالَتْ: إنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: \"",["مَن أخَذَ دَيْنًا وهو يُريدُ أن يُؤَدِّيَه ",1],["أعانَه اللهُ\"",2],"."],"grade":"صحيح","narrator":"ميمونة","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه النسائي (4687)، والطحاوي في ((مشكل الآثار)) (4286)، وأبو نعيم في ((تاريخ أصبهان)) (2/ 208) واللفظ لهم.","bab":"آداب عامة › المباحات من الأفعال والأقوال","dorar":"h69n3Oa1"},{"id":"س-02045","fp":"afb377c28b45","stateId":265,"easy":"إذا كنت في حاجة أخيك ← يكون الله في حاجتك","cause":"ما دامَ في حاجةِ أَخيهِ","result":"لا يَزالُ اللهُ في حاجةِ العَبدِ","explicit":true,"repOf":"س-07253","otherNeedIds":[54],"ref":"صحيح الترغيب 2619","text":[["لا يَزالُ اللهُ في حاجةِ العَبدِ",2]," ",["ما دامَ في حاجةِ أَخيهِ",1]],"grade":"صحيح","narrator":"زيد بن ثابت","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني (5/118) (4801)، وأبو نعيم في ((معرفة الصحابة)) (2921)، والديلمي في ((الفردوس)) (7560) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"BZhfvJ9e"},{"id":"س-04963","fp":"ec402df5069c","stateId":265,"easy":"إذا كنت شريكاً لم تخن صاحبك ← يكون الله ثالثكما (بالبركة)","cause":"ما لم يَخُنْ أحدُهما صاحبَه","result":"أنا ثالثُ الشَّريكينِ","explicit":true,"otherNeedIds":[1],"ref":"فتاوى نور على الدرب لابن عثيمين 9/186","srcLabel":"فتاوى نور على الدرب لابن عثيمين","text":["إِنَّ اللهَ تَعَالَى يَقُولُ: ",["أنا ثالثُ الشَّريكينِ",2]," ",["ما لم يَخُنْ أحدُهما صاحبَه",1],"، فإذا خانَه خرَجْتُ مِن بيْنِهما."],"grade":"صحيح","muhaddith":"[ثابت]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Y0rSZk8R"},{"id":"س-05902","fp":"f8a7aa79e58e","stateId":265,"easy":"إذا تعرّفت إلى الله في الرخاء ← يعرفك في الشدة","cause":"تَعرَّفْ إلى اللهِ في الرَّخاءِ","result":"يَعرِفْكَ في الشِّدَّةِ","explicit":true,"otherNeedIds":[4],"ref":"تخريج رياض الصالحين 62","srcLabel":"الترمذي","text":["\"كنتُ خلْفَ النَّبيِّ صلَّى اللهُ عليه وسلَّم يومًا فقال: \"يا غلامُ إني أُعلِّمُك كلماتٍ: \"احفَظِ اللهَ يَحفظْكَ احفَظِ اللهَ تَجدْهُ تُجاهَك، إذا سألْتَ فاسأَلِ اللهَ، وإذا استعنْتَ فاستعِنْ باللهِ، واعلَمْ: أنَّ الأُمَّةَ لو اجتمَعَتْ على أنْ يَنْفَعوكَ بشَيءٍ، لم يَنْفَعوكَ إلَّا بشَيءٍ قد كتبَهُ اللهُ لك، وإنِ اجْتمعوا على أنْ يَضُروكَ بشَيءٍ، لم يَضُروكَ إلَّا بشَيءٍ قد كتبَهُ اللهُ عليك، رُفِعَتِ الأقلامُ، وجَفَّتِ الصُّحُفُ\".\nوفي روايَةٍ: \"احفَظِ اللهَ تَجدْهُ أمامَكَ، ",["تَعرَّفْ إلى اللهِ في الرَّخاءِ",1]," ",["يَعرِفْكَ في الشِّدَّةِ",2],"، واعلَمْ أنَّ ما أخْطأَكَ لم يكنْ ليُصيبَكَ، وما أصابكَ لم يكنْ لِيُخْطِئَكَ، واعلَمْ أنَّ النصرَ مع الصبرِ، وأنَّ الفَرَجَ مع الكرْبِ، وأنَّ مع العُسرِ يُسرًا\"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (2516) بنحوه، وأحمد (2803) باختلاف يسير","bab":"رقائق وزهد › الوصايا النافعة","dorar":"RfGVBGbj"},{"id":"س-06784","fp":"28756bca138c","stateId":265,"easy":"إذا غزوت أو تزوجت أو كاتبت أو حججت ← فحق على الله عونك","cause":"الغازِي ، والْمُتَزَوِّجُ ، والْمُكَاتَبُ ، والحاجُّ","result":"أَرْبَعٌ حَقٌّ على اللهِ تعالى عَوْنُهم","explicit":true,"repOf":"س-06789","ref":"الجامع الصغير 908","text":[["أَرْبَعٌ حَقٌّ على اللهِ تعالى عَوْنُهم ",2],"،",[" الغازِي ، والْمُتَزَوِّجُ ، والْمُكَاتَبُ ، والحاجُّ .",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (3120)، والترمذي (1655)، وابن ماجه (2518)، وأحمد (7410) جميعهم بنحوه.","bab":"عتق وولاء › المكاتب","dorar":"kjGvO1jf"},{"id":"س-06861","fp":"d706e0edde27","stateId":265,"easy":"إذا تزوجت تلتمس العفاف عن الحرام ← فحق على الله عونك","cause":"مَنْ نَكحَ التِماسَ العَفافِ عمَّا حرَّمَ اللهُ","result":"حَقٌّ علَى اللهِ عونُ","explicit":true,"otherNeedIds":[37,20],"ref":"صحيح الجامع 3152","srcLabel":"ابن عدي","text":[["حَقٌّ علَى اللهِ عونُ",2]," ",["مَنْ نَكحَ التِماسَ العَفافِ عمَّا حرَّمَ اللهُ",1]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (7/265)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"IZ4ToUmQ"},{"id":"س-08232","fp":"4d89c44bd267","stateId":265,"easy":"إذا ضللت في فلاة ← فنادِ «يا عباد الله أعينوا»","cause":"فليُنادِ: يا عِبادَ اللهِ أعينوا","result":"فإذا أصابَ أحَدُكُم عَرجةً بأرضِ فلاةٍ","explicit":true,"ref":"الابتهاج 38","srcLabel":"البيهقي","text":["«إنَّ للهِ تَعالى مَلائِكةً في الأرضِ سِوى الحَفَظةِ يَكتُبونَ ما يَسقُطُ مِن ورَقِ الشَّجَرِ، ",["فإذا أصابَ أحَدُكُم عَرجةً بأرضِ فلاةٍ",2]," ",["فليُنادِ: يا عِبادَ اللهِ أعينوا",1],"»."],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن.","takhrij":"أخرجه البزار كما في ((كشف الأستار)) للهيثمي (3128)، والبيهقي في ((شعب الإيمان)) (7697) واللفظ لهما.","bab":"ملائكة › أعمال الملائكة","dorar":"8QgiJvU4"},{"id":"س-00226","fp":"0eac7e4a68b7","stateId":265,"easy":"إذا ركبت دابتك فاذكر اسم الله عليها ← فإنما يحملك الله","cause":"واذكُروا اسمَ اللهِ عليهنَّ كما أُمِرتُم","result":"فإنَّما يَحمِلُ اللهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"في السفر"},"otherNeedIds":[54],"ref":"تخريج المسند لشعيب 17939","srcLabel":"أحمد","text":["حَمَلَنا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم على إبِلٍ مِن إبِلِ الصَّدَقةِ ضِعافٍ إلى الحَجِّ، قال: فقُلنا له: يا رَسولَ اللهِ، إنَّ هذه الإبِلَ ضِعافٌ نَخشى أن لا تَحمِلَنا. قال: فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: «ما مِن بَعيرٍ إلَّا في ذِروتِه شَيطانٌ، فاركَبوهُنَّ، ",["واذكُروا اسمَ اللهِ عليهنَّ كما أُمِرتُم",1],"، ثُمَّ امتَهِنوهُنَّ لأنفُسِكُم؛ ",["فإنَّما يَحمِلُ اللهُ",2],"»."],"grade":"حسن","narrator":"أبو لاس الخزاعي","muhaddith":"إسناده حسن","bab":"آداب المجلس › الركوب على الدابة","dorar":"GUoWYlK4"}]}