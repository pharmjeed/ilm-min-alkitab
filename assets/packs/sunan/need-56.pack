{"schema":1,"kind":"sunan-chunk","version":"sunan-2420572879fb","needId":56,"stateIds":[593,594,595,596,597,598,599,600,601,602,603,604,605,606],"items":[{"id":"ق-0079","fp":"d7378ee8a057","stateId":593,"easy":"تبديل نعمة الله كفراً ← شدة العقاب","cause":"تبديل نعمة الله كفراً","result":"شدة العقاب","explicit":true,"ref":"سورة البقرة: 211","srcLabel":"القرآن الكريم","quran":{"s":2,"from":211,"to":211,"text":"سَلْ بَنِي إِسْرَائِيلَ كَمْ آتَيْنَاهُمْ مِنْ آيَةٍ بَيِّنَةٍ وَمَنْ يُبَدِّلْ نِعْمَةَ اللَّهِ مِنْ بَعْدِ مَا جَاءَتْهُ فَإِنَّ اللَّهَ شَدِيدُ الْعِقَابِ (211)","hl":[[63,157,1]]}},{"id":"ق-0714","fp":"665aed71bb19","stateId":593,"easy":"الإعراض وكفران النجاة ← الخسف أو الحاصب أو الإغراق","cause":"الإعراض وكفران النجاة","result":"الخسف أو الحاصب أو الإغراق","explicit":true,"ref":"سورة الإسراء: 67–69","srcLabel":"القرآن الكريم","quran":{"s":17,"from":67,"to":69,"text":"وَإِذَا مَسَّكُمُ الضُّرُّ فِي الْبَحْرِ ضَلَّ مَنْ تَدْعُونَ إِلَّا إِيَّاهُ فَلَمَّا نَجَّاكُمْ إِلَى الْبَرِّ أَعْرَضْتُمْ وَكَانَ الْإِنْسَانُ كَفُورًا (67) أَفَأَمِنْتُمْ أَنْ يَخْسِفَ بِكُمْ جَانِبَ الْبَرِّ أَوْ يُرْسِلَ عَلَيْكُمْ حَاصِبًا ثُمَّ لَا تَجِدُوا لَكُمْ وَكِيلًا (68) أَمْ أَمِنْتُمْ أَنْ يُعِيدَكُمْ فِيهِ تَارَةً أُخْرَى فَيُرْسِلَ عَلَيْكُمْ قَاصِفًا مِنَ الرِّيحِ فَيُغْرِقَكُمْ بِمَا كَفَرْتُمْ ثُمَّ لَا تَجِدُوا لَكُمْ عَلَيْنَا بِهِ تَبِيعًا (69)","hl":[[78,469,1]]}},{"id":"ق-1011","fp":"5ed50a6bdbe6","stateId":593,"easy":"البطر وظلم النفس ← التمزيق كل ممزق وجعلهم أحاديث","cause":"البطر وظلم النفس","result":"التمزيق كل ممزق وجعلهم أحاديث","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[60],"ref":"سورة سبأ: 19","srcLabel":"القرآن الكريم","quran":{"s":34,"from":19,"to":19,"text":"فَقَالُوا رَبَّنَا بَاعِدْ بَيْنَ أَسْفَارِنَا وَظَلَمُوا أَنْفُسَهُمْ فَجَعَلْنَاهُمْ أَحَادِيثَ وَمَزَّقْنَاهُمْ كُلَّ مُمَزَّقٍ إِنَّ فِي ذَلِكَ لَآيَاتٍ لِكُلِّ صَبَّارٍ شَكُورٍ (19)","hl":[[0,130,1]]}},{"id":"ق-1177","fp":"b90ccd60c5a0","stateId":593,"easy":"العلوّ والإسراف (فرعون وقومه) ← الإغراق وسلب النعم وتوريثها قوماً آخرين","cause":"العلوّ والإسراف (فرعون وقومه)","result":"الإغراق وسلب النعم وتوريثها قوماً آخرين","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[3],"ref":"سورة الدخان: 25–29","srcLabel":"القرآن الكريم","quran":{"s":44,"from":25,"to":29,"text":"كَمْ تَرَكُوا مِنْ جَنَّاتٍ وَعُيُونٍ (25) وَزُرُوعٍ وَمَقَامٍ كَرِيمٍ (26) وَنَعْمَةٍ كَانُوا فِيهَا فَاكِهِينَ (27) كَذَلِكَ وَأَوْرَثْنَاهَا قَوْمًا آخَرِينَ (28) فَمَا بَكَتْ عَلَيْهِمُ السَّمَاءُ وَالْأَرْضُ وَمَا كَانُوا مُنْظَرِينَ (29)","hl":[[0,238,1]]}},{"id":"س-06887","fp":"4c7c4e5842c6","stateId":593,"easy":"إذا جحدت نعمة الله ← يصيّرك الله إلى ما كنت (من قصة الأبرص والأقرع والأعمى)","cause":"فقال: إنَّما ورِثتُ هذا المالَ كابِرًا عن كابِرٍ","result":"إن كُنتَ كاذِبًا فصَيَّرَك اللهُ إلى ما كُنتَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[3],"ref":"صحيح مسلم 2964","srcLabel":"البخاري","text":["إنَّ ثَلاثةً في بَني إسرائيلَ: أبرَصَ، وأقرَعَ، وأعمى، فأرادَ اللهُ أن يَبتَليَهم، فبَعَثَ إليهم مَلَكًا، فأتى الأبرَصَ، فقال: أيُّ شيءٍ أحَبُّ إلَيك؟ قال: لَونٌ حَسَنٌ، وجِلدٌ حَسَنٌ، ويَذهَبُ عَنِّي الذي قد قَذِرَني النَّاسُ، قال: فمَسَحَه فذَهَبَ عنه قَذَرُه، وأُعطيَ لَونًا حَسَنًا وجِلدًا حَسَنًا، قال: فأيُّ المالِ أحَبُّ إلَيك؟ قال: الإبِلُ أو قال البَقَرُ، شَكَّ إسحاقُ، إلَّا أنَّ الأبرَصَ أوِ الأقرَعَ، قال أحَدُهما: الإبِلُ، وقال الآخَرُ: البَقَرُ، قال: فأُعطيَ ناقةً عُشَراءَ، فقال: بارَك اللهُ لك فيها، قال: فأتى الأقرَعَ، فقال: أيُّ شيءٍ أحَبُّ إلَيك؟ قال: شَعَرٌ حَسَنٌ، ويَذهَبُ عَنِّي هذا الذي قد قَذِرَني النَّاسُ، قال: فمَسَحَه فذَهَبَ عنه، وأُعطيَ شَعَرًا حَسَنًا، قال: فأيُّ المالِ أحَبُّ إلَيك؟ قال: البَقَرُ، فأُعطيَ بَقَرةً حامِلًا، فقال: بارَك اللهُ لك فيها، قال: فأتى الأعمى، فقال: أيُّ شيءٍ أحَبُّ إلَيك؟ قال: أن يَرُدَّ اللهُ إلَيَّ بَصَري، فأُبصِرَ به النَّاسَ، قال: فمَسَحَه فرَدَّ اللهُ إليه بَصَرَه، قال: فأيُّ المالِ أحَبُّ إلَيك؟ قال: الغَنَمُ، فأُعطيَ شاةً والِدًا، فأُنتِجَ هذانِ وولَّدَ هذا، قال: فكانَ لهذا وادٍ مِنَ الإبِلِ، ولهذا وادٍ مِنَ البَقَرِ، ولهذا وادٍ مِنَ الغَنَمِ. قال: ثُمَّ إنَّه أتى الأبرَصَ في صورَتِه وهَيئَتِه، فقال: رَجُلٌ مِسكينٌ، قدِ انقَطَعَت بيَ الحِبالُ في سَفَري، فلا بَلاغَ لي اليومَ إلَّا باللهِ ثُمَّ بك، أسألُك بالذي أعطاك اللَّونَ الحَسَنَ والجِلدَ الحَسَنَ والمالَ، بَعيرًا أتَبَلَّغُ عليه في سَفَري، فقال: الحُقوقُ كَثيرةٌ، فقال له: كَأنِّي أعرِفُك، ألَم تَكُنْ أبرَصَ يَقذَرُك النَّاسُ؟ فقيرًا فأعطاك اللهُ؟ ",["فقال: إنَّما ورِثتُ هذا المالَ كابِرًا عن كابِرٍ",1],"، فقال: ",["إن كُنتَ كاذِبًا فصَيَّرَك اللهُ إلى ما كُنتَ",2],". قال: وأتى الأقرَعَ في صورَتِه، فقال له مِثلَ ما قال لهذا، ورَدَّ عليه مِثلَ ما رَدَّ على هذا، فقال: إن كُنتَ كاذِبًا فصَيَّرَك اللهُ إلى ما كُنتَ، قال: وأتى الأعمى في صورَتِه وهَيئَتِه، فقال: رَجُلٌ مِسكينٌ وابنُ سَبيلٍ، انقَطَعَت بيَ الحِبالُ في سَفَري، فلا بَلاغَ لي اليومَ إلَّا باللهِ، ثُمَّ بك، أسألُك بالذي رَدَّ عليك بَصَرَك شاةً أتَبَلَّغُ بها في سَفَري، فقال: قد كُنتُ أعمى فرَدَّ اللهُ إلَيَّ بَصَري، فخُذْ ما شِئتَ، ودَعْ ما شِئتَ، فواللهِ لا أجهَدُك اليومَ شيئًا أخَذتَه للَّهِ، فقال: أمسِكْ مالَك، فإنَّما ابتُليتُم فقد رُضيَ عَنك وسُخِطَ على صاحِبَيك."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3464) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"xELD1ioR"},{"id":"س-03902","fp":"6cd305a886c9","stateId":593,"easy":"إذا كفرت النعم ← تحل بك النقم","cause":"إيَّاكم وكُفرَ النِّعمِ","result":"فتَحِلَّ بكم النِّقمُ","explicit":true,"otherNeedIds":[3],"ref":"المستدرك على الصحيحين 3725","srcLabel":"الخطيب","text":["قالَ: خرَجْنا مع عَليِّ بنِ أبي طالبٍ حين توجَّهَ إلى معاويةَ بنِ أبي سُفيانَ قالَ: وجَريرُ بنُ سَهْمٍ التَّيْميُّ أمامَهُ يقولُ:\nيا فَرَسي سِيري، وأُمِّي الشَّاما ... واقْطَعِي الأحْقافَ والأعْلامَا\nوقاتِلي مَنْ خالَفَ الإماما ... إنِّي لأَرْجو إنْ لَقِينا العامَا\nجَمْعَ بني أُميَّةَ الطِّغاما ... أنْ نَقتُلَ القاضيَ والهُمامَا\nوأنْ نُزِيلَ مِن رِجالٍ هامَا\nفلمَّا وصَلْنا إلى المدائنِ قالَ جريرٌ:\nعَفَتِ الرِّياحُ على رُسومِ ديارِهِم ... فكأنَّهم كانوا على مِيعادِ\nقالَ: فقالَ لي عَليٌّ: كيف قلتَ يا أخا بني تَميمٍ؟ قالَ: فردَّ عليه البيتَ فقالَ عَليٌّ: ألا قلتَ: {كَمْ تَرَكُوا مِن جَنَّاتٍ وَعُيُونٍ (25) وَزُرُوعٍ وَمَقَامٍ كَرِيمٍ (26) وَنَعْمَةٍ كَانُوا فِيهَا فَاكِهِينَ (27) كَذَلِكَ وَأَوْرَثْنَاهَا قَوْمًا آخَرِينَ} [الدخان: 25- 28]، أيْ أخي، هؤلاء كانوا وارثينَ، فأصبحوا مَوْروثينَ، إنَّ هؤلاء كفروا النِّعَمَ فحلَّتْ بهم النِّقَمُ. ثُمَّ قالَ: ",["إيَّاكم وكُفرَ النِّعمِ",1]," ",["فتَحِلَّ بكم النِّقمُ",2],". قالَ أبو حاتمٍ: قلتُ لمُحمَّدِ بنِ يزيدَ بنِ سِنانٍ: جدُّكَ سِنانٌ كان كبيرَ السِّنِّ، أَدركَ عَليًّا؟ قالَ: نَعَمْ، شَهِدَ معه المشاهِدَ."],"grade":"صحيح","narrator":"سنان بن يزيد","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الخطيب في ((تاريخ بغداد)) (10/ 294) باختلاف يسير.","bab":"تفسير آيات › سورة الدخان","dorar":"AFgurSpN"},{"id":"س-07734","fp":"ed86b60d3ddf","stateId":593,"easy":"إذا بدّلت نعمة الله كفراً ← يقطع الله دابرك","cause":"الَّذِينَ بَدَّلُوا نِعْمَتَ اللَّهِ كُفْرًا","result":"فقطع اللهُ دابرَهم يومَ بدرٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 7/47","srcLabel":"الحاكم","text":["عن عليٍّ: (",["الَّذِينَ بَدَّلُوا نِعْمَتَ اللَّهِ كُفْرًا",1]," وَأَحَلُّوا قَوْمَهُمْ دَارَ الْبَوَارِ) الآية قال نزلت في الأفخرِينَ من بني مخزومٍ وبني أميةَ ",["فقطع اللهُ دابرَهم يومَ بدرٍ",2]," وأما بنو أميةَ فمُتِّعوا إلى حينٍ"],"grade":"حسن","narrator":"عمرو ذي مر","muhaddith":"فيه عمرو ذو مر ولم يرو عنه غير أبي إسحاق السبيعي وبقية رجاله ثقات","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (776) بلفظه، والطبري في ((جامع البيان)) (13/ 675)، والحاكم (3343) كلاهما بنحوه .","bab":"قرآن › أسباب النزول","dorar":"fLUI6uGa"},{"id":"ق-1156","fp":"cf26be78ca96","stateId":594,"easy":"كسب الأيدي من الذنوب ← المصيبة (ويعفو عن كثير)","cause":"كسب الأيدي من الذنوب","result":"المصيبة (ويعفو عن كثير)","explicit":true,"ref":"سورة الشورى: 30","srcLabel":"القرآن الكريم","quran":{"s":42,"from":30,"to":30,"text":"وَمَا أَصَابَكُمْ مِنْ مُصِيبَةٍ فَبِمَا كَسَبَتْ أَيْدِيكُمْ وَيَعْفُو عَنْ كَثِيرٍ (30)","hl":[[0,84,1]]}},{"id":"ق-0185","fp":"2e31fe320642","stateId":594,"easy":"مخالفة الأمر والمعصية ← المصيبة والهزيمة (هو من عند أنفسكم)","cause":"مخالفة الأمر والمعصية","result":"المصيبة والهزيمة (هو من عند أنفسكم)","explicit":true,"star":true,"otherNeedIds":[44],"ref":"سورة آل عمران: 165","srcLabel":"القرآن الكريم","quran":{"s":3,"from":165,"to":165,"text":"أَوَلَمَّا أَصَابَتْكُمْ مُصِيبَةٌ قَدْ أَصَبْتُمْ مِثْلَيْهَا قُلْتُمْ أَنَّى هَذَا قُلْ هُوَ مِنْ عِنْدِ أَنْفُسِكُمْ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ (165)","hl":[[0,119,1]]}},{"id":"ق-0226","fp":"10e821698127","stateId":594,"easy":"الإعراض عن حكم الله ورسوله ← المصيبة بما قدمت الأيدي","cause":"الإعراض عن حكم الله ورسوله","result":"المصيبة بما قدمت الأيدي","explicit":true,"star":true,"ref":"سورة النساء: 62","srcLabel":"القرآن الكريم","quran":{"s":4,"from":62,"to":62,"text":"فَكَيْفَ إِذَا أَصَابَتْهُمْ مُصِيبَةٌ بِمَا قَدَّمَتْ أَيْدِيهِمْ ثُمَّ جَاءُوكَ يَحْلِفُونَ بِاللَّهِ إِنْ أَرَدْنَا إِلَّا إِحْسَانًا وَتَوْفِيقًا (62)","hl":[[0,66,1]]}},{"id":"ق-0232","fp":"fd4a3eea2aad","stateId":594,"easy":"ذنب العبد (من نفسه) ← السيئة والمصيبة","cause":"ذنب العبد (من نفسه)","result":"السيئة والمصيبة","explicit":true,"star":true,"ref":"سورة النساء: 79","srcLabel":"القرآن الكريم","quran":{"s":4,"from":79,"to":79,"text":"مَا أَصَابَكَ مِنْ حَسَنَةٍ فَمِنَ اللَّهِ وَمَا أَصَابَكَ مِنْ سَيِّئَةٍ فَمِنْ نَفْسِكَ وَأَرْسَلْنَاكَ لِلنَّاسِ رَسُولًا وَكَفَى بِاللَّهِ شَهِيدًا (79)","hl":[[43,89,1]]}},{"id":"ق-0294","fp":"bf7648bdb975","stateId":594,"easy":"الذنوب مع دعوى القرب من الله ← التعذيب بها","cause":"الذنوب مع دعوى القرب من الله","result":"التعذيب بها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"سورة المائدة: 18","srcLabel":"القرآن الكريم","quran":{"s":5,"from":18,"to":18,"text":"وَقَالَتِ الْيَهُودُ وَالنَّصَارَى نَحْنُ أَبْنَاءُ اللَّهِ وَأَحِبَّاؤُهُ قُلْ فَلِمَ يُعَذِّبُكُمْ بِذُنُوبِكُمْ بَلْ أَنْتُمْ بَشَرٌ مِمَّنْ خَلَقَ يَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَإِلَيْهِ الْمَصِيرُ (18)","hl":[[75,114,1]]}},{"id":"ق-0312","fp":"054051523b21","stateId":594,"easy":"التولي عن حكم الله ← الإصابة ببعض الذنوب","cause":"التولي عن حكم الله","result":"الإصابة ببعض الذنوب","explicit":true,"star":true,"ref":"سورة المائدة: 49","srcLabel":"القرآن الكريم","quran":{"s":5,"from":49,"to":49,"text":"وَأَنِ احْكُمْ بَيْنَهُمْ بِمَا أَنْزَلَ اللَّهُ وَلَا تَتَّبِعْ أَهْوَاءَهُمْ وَاحْذَرْهُمْ أَنْ يَفْتِنُوكَ عَنْ بَعْضِ مَا أَنْزَلَ اللَّهُ إِلَيْكَ فَإِنْ تَوَلَّوْا فَاعْلَمْ أَنَّمَا يُرِيدُ اللَّهُ أَنْ يُصِيبَهُمْ بِبَعْضِ ذُنُوبِهِمْ وَإِنَّ كَثِيرًا مِنَ النَّاسِ لَفَاسِقُونَ (49)","hl":[[152,242,1]]}},{"id":"ق-0345","fp":"41645c49663b","stateId":594,"easy":"الذنوب مع التمكين والنعمة ← الإهلاك واستبدال قرن آخر","cause":"الذنوب مع التمكين والنعمة","result":"الإهلاك واستبدال قرن آخر","explicit":true,"ref":"سورة الأنعام: 6","srcLabel":"القرآن الكريم","quran":{"s":6,"from":6,"to":6,"text":"أَلَمْ يَرَوْا كَمْ أَهْلَكْنَا مِنْ قَبْلِهِمْ مِنْ قَرْنٍ مَكَّنَّاهُمْ فِي الْأَرْضِ مَا لَمْ نُمَكِّنْ لَكُمْ وَأَرْسَلْنَا السَّمَاءَ عَلَيْهِمْ مِدْرَارًا وَجَعَلْنَا الْأَنْهَارَ تَجْرِي مِنْ تَحْتِهِمْ فَأَهْلَكْنَاهُمْ بِذُنُوبِهِمْ وَأَنْشَأْنَا مِنْ بَعْدِهِمْ قَرْنًا آخَرِينَ (6)","hl":[[210,288,1]]}},{"id":"ق-0419","fp":"19a35f989bf7","stateId":594,"easy":"الذنوب ← الإصابة بها والطبع على القلوب","cause":"الذنوب","result":"الإصابة بها والطبع على القلوب","explicit":true,"otherNeedIds":[21],"ref":"سورة الأعراف: 100","srcLabel":"القرآن الكريم","quran":{"s":7,"from":100,"to":100,"text":"أَوَلَمْ يَهْدِ لِلَّذِينَ يَرِثُونَ الْأَرْضَ مِنْ بَعْدِ أَهْلِهَا أَنْ لَوْ نَشَاءُ أَصَبْنَاهُمْ بِذُنُوبِهِمْ وَنَطْبَعُ عَلَى قُلُوبِهِمْ فَهُمْ لَا يَسْمَعُونَ (100)","hl":[[69,166,1]]}},{"id":"ق-0694","fp":"09ecd3c69c7e","stateId":594,"easy":"الإساءة ← وبالها على النفس","cause":"الإساءة","result":"وبالها على النفس","explicit":true,"ref":"سورة الإسراء: 7","srcLabel":"القرآن الكريم","quran":{"s":17,"from":7,"to":7,"text":"إِنْ أَحْسَنْتُمْ أَحْسَنْتُمْ لِأَنْفُسِكُمْ وَإِنْ أَسَأْتُمْ فَلَهَا فَإِذَا جَاءَ وَعْدُ الْآخِرَةِ لِيَسُوءُوا وُجُوهَكُمْ وَلِيَدْخُلُوا الْمَسْجِدَ كَمَا دَخَلُوهُ أَوَّلَ مَرَّةٍ وَلِيُتَبِّرُوا مَا عَلَوْا تَتْبِيرًا (7)","hl":[[46,71,1]]}},{"id":"ق-0920","fp":"f9bf79644c36","stateId":594,"easy":"ما قدمت الأيدي ← المصيبة","cause":"ما قدمت الأيدي","result":"المصيبة","explicit":true,"similar":["ق-0957","ق-1164"],"ref":"سورة القصص: 47","srcLabel":"القرآن الكريم","quran":{"s":28,"from":47,"to":47,"text":"وَلَوْلَا أَنْ تُصِيبَهُمْ مُصِيبَةٌ بِمَا قَدَّمَتْ أَيْدِيهِمْ فَيَقُولُوا رَبَّنَا لَوْلَا أَرْسَلْتَ إِلَيْنَا رَسُولًا فَنَتَّبِعَ آيَاتِكَ وَنَكُونَ مِنَ الْمُؤْمِنِينَ (47)","hl":[[0,64,1]]}},{"id":"ق-0946","fp":"44947f78c84d","stateId":594,"easy":"الاستكبار والذنوب ← أخذ كلٍّ بذنبه: حاصب وصيحة وخسف وإغراق","cause":"الاستكبار والذنوب","result":"أخذ كلٍّ بذنبه: حاصب وصيحة وخسف وإغراق","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة العنكبوت: 40","srcLabel":"القرآن الكريم","quran":{"s":29,"from":40,"to":40,"text":"فَكُلًّا أَخَذْنَا بِذَنْبِهِ فَمِنْهُمْ مَنْ أَرْسَلْنَا عَلَيْهِ حَاصِبًا وَمِنْهُمْ مَنْ أَخَذَتْهُ الصَّيْحَةُ وَمِنْهُمْ مَنْ خَسَفْنَا بِهِ الْأَرْضَ وَمِنْهُمْ مَنْ أَغْرَقْنَا وَمَا كَانَ اللَّهُ لِيَظْلِمَهُمْ وَلَكِنْ كَانُوا أَنْفُسَهُمْ يَظْلِمُونَ (40)","hl":[[0,260,1]]}},{"id":"ق-0957","fp":"37b11eded901","stateId":594,"easy":"ما قدمت الأيدي ← السيئة تصيبهم","cause":"ما قدمت الأيدي","result":"السيئة تصيبهم","explicit":true,"repOf":"ق-0920","ref":"سورة الروم: 36","quran":{"s":30,"from":36,"to":36,"text":"وَإِذَا أَذَقْنَا النَّاسَ رَحْمَةً فَرِحُوا بِهَا وَإِنْ تُصِبْهُمْ سَيِّئَةٌ بِمَا قَدَّمَتْ أَيْدِيهِمْ إِذَا هُمْ يَقْنَطُونَ (36)","hl":[[51,106,1]]}},{"id":"ق-0961","fp":"3145bccd4201","stateId":594,"easy":"كسب أيدي الناس من الذنوب ← ظهور الفساد في البر والبحر","cause":"كسب أيدي الناس من الذنوب","result":"ظهور الفساد في البر والبحر","explicit":true,"otherNeedIds":[3],"ref":"سورة الروم: 41","srcLabel":"القرآن الكريم","quran":{"s":30,"from":41,"to":41,"text":"ظَهَرَ الْفَسَادُ فِي الْبَرِّ وَالْبَحْرِ بِمَا كَسَبَتْ أَيْدِي النَّاسِ لِيُذِيقَهُمْ بَعْضَ الَّذِي عَمِلُوا لَعَلَّهُمْ يَرْجِعُونَ (41)","hl":[[0,136,1]]}},{"id":"ق-0981","fp":"638764cd5e2c","stateId":594,"easy":"المعصية ← العذاب الأدنى دون الأكبر ليرجعوا","cause":"المعصية","result":"العذاب الأدنى دون الأكبر ليرجعوا","explicit":true,"ref":"سورة السجدة: 21","srcLabel":"القرآن الكريم","quran":{"s":32,"from":21,"to":21,"text":"وَلَنُذِيقَنَّهُمْ مِنَ الْعَذَابِ الْأَدْنَى دُونَ الْعَذَابِ الْأَكْبَرِ لَعَلَّهُمْ يَرْجِعُونَ (21)","hl":[[0,98,1]]}},{"id":"ق-1157","fp":"706a4b37f642","stateId":594,"easy":"الكسب السيئ ← الإيباق (الإهلاك) في البحر","cause":"الكسب السيئ","result":"الإيباق (الإهلاك) في البحر","explicit":true,"ref":"سورة الشورى: 34","srcLabel":"القرآن الكريم","quran":{"s":42,"from":34,"to":34,"text":"أَوْ يُوبِقْهُنَّ بِمَا كَسَبُوا وَيَعْفُ عَنْ كَثِيرٍ (34)","hl":[[0,54,1]]}},{"id":"ق-1164","fp":"2a539a97f025","stateId":594,"easy":"ما قدمت الأيدي ← السيئة تصيبهم","cause":"ما قدمت الأيدي","result":"السيئة تصيبهم","explicit":true,"repOf":"ق-0920","ref":"سورة الشورى: 48","quran":{"s":42,"from":48,"to":48,"text":"فَإِنْ أَعْرَضُوا فَمَا أَرْسَلْنَاكَ عَلَيْهِمْ حَفِيظًا إِنْ عَلَيْكَ إِلَّا الْبَلَاغُ وَإِنَّا إِذَا أَذَقْنَا الْإِنْسَانَ مِنَّا رَحْمَةً فَرِحَ بِهَا وَإِنْ تُصِبْهُمْ سَيِّئَةٌ بِمَا قَدَّمَتْ أَيْدِيهِمْ فَإِنَّ الْإِنْسَانَ كَفُورٌ (48)","hl":[[157,212,1]]}},{"id":"ق-1380","fp":"71e17953ea5c","stateId":594,"easy":"الخطايا ← الإغراق ودخول النار بلا أنصار","cause":"الخطايا","result":"الإغراق ودخول النار بلا أنصار","explicit":true,"otherNeedIds":[69,64],"ref":"سورة نوح: 25","srcLabel":"القرآن الكريم","quran":{"s":71,"from":25,"to":25,"text":"مِمَّا خَطِيئَاتِهِمْ أُغْرِقُوا فَأُدْخِلُوا نَارًا فَلَمْ يَجِدُوا لَهُمْ مِنْ دُونِ اللَّهِ أَنْصَارًا (25)","hl":[[0,105,1]]}},{"id":"س-00516","fp":"25de884cfcb4","stateId":594,"easy":"إذا استهنت بمحقرات الذنوب ← تجتمع عليك حتى تهلكك","cause":"إيَّاكُم ومحقَّراتِ الذُّنوبِ","result":"فإنَّهنَّ يجتَمعنَ على الرَّجلِ حتَّى يُهْلِكْنَه","explicit":true,"otherNeedIds":[13],"ref":"صحيح الترغيب 2470","srcLabel":"أحمد","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ قال : ",["إيَّاكُم ومحقَّراتِ الذُّنوبِ ، ",1],["فإنَّهنَّ يجتَمعنَ على الرَّجلِ حتَّى يُهْلِكْنَه",2]," وإنَّ رسولَ اللهِ ضرَبَ لهنَّ مثلًا : كمَثلِ قومٍ نزَلوا أرضَ فلاةٍ ، فحضَر صَنيعُ القَومِ ، فجعَل الرَّجلُ ينطَلقُ فيجيءُ بالعودِ ، والرَّجلُ يَجيءُ بالعودِ ، حتَّى جمعوا سَوادًا ، وأجَّجوا نارًا ، وأنضَجوا ما قذَفوا فيها"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (3818)، والطبراني (10/261) (10500)، والبيهقي في ((شعب الإيمان)) (7263) باختلاف يسير","bab":"آداب عامة › ضرب الأمثال","dorar":"5ZPXSuXC","merged":2,"otherRefs":["الجامع الصغير 2902 (حسن)"]},{"id":"س-07749","fp":"f310f2b8405e","stateId":594,"easy":"إذا آثرت الدنيا على أمر الله ← تُعاقب","cause":"مِن أَخْذِهِمُ الفِداءَ","result":"عُوقِبوا بما صنَعوا يومَ بَدْرٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح أسباب النزول 61","srcLabel":"مسلم","text":["حدَّثني عمرُ بنُ الخطَّابِ رَضِيَ اللهُ عنه، قال: لمَّا كان يومُ بَدْرٍ، قال: نظر النبيُّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ إلى أصحابِهِ وهُمْ ثلاثُ مئةٍ ونَيِّفٌ، ونظر إلى المشركينَ فإذا هُمْ ألفٌ وزيادةٌ، فاستقبَلَ النبيُّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ القِبلةَ، ثم مَدَّ يديْهِ وعليه رِداؤُهُ وإزارُهُ، ثم قال: اللَّهمَّ أينَ ما وَعَدْتَني؟ اللَّهمَّ أَنْجِزْ لي ما وَعَدْتَني، اللَّهمَّ إنَّكَ إنْ تُهلِكْ هذهِ العِصابةَ مِن أهلِ الإسلامِ، فلا تُعْبَدُ في الأرضِ أبدًا، قال: فما زال يَستَغيثُ ربَّهُ عزَّ وجلَّ ويَدْعوه حتى سَقَطَ رِداؤُهُ، فأتاهُ أبو بكرٍ رَضِيَ اللهُ عنه، فأخذ رِداءَهُ فرَدَّاهُ، ثم الْتَزَمَهُ مِن وَرائِهِ، ثم قال: يا نَبيَّ اللهِ، كَفاكَ مُناشَدَتُكَ ربَّكَ؛ فإنَّهُ سيُنْجِزُ لكَ ما وَعَدَكَ، وأنزل اللهُ عزَّ وجلَّ: {إِذْ تَسْتَغِيثُونَ رَبَّكُمْ فَاسْتَجَابَ لَكُمْ أَنِّي مُمِدُّكُمْ بِأَلْفٍ مِنَ الْمَلَائِكَةِ مُرْدِفِينَ} [الأنفال: 9]، فلمَّا كان يومئذٍ والْتَقَوْا، فهزم اللهُ عزَّ وجلَّ المشركينَ، فقُتِلَ مِنهُم سبعونَ رجُلًا، وأُسِرَ منهم سبعونَ رجُلًا، فاستشار رسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ أبا بكرٍ وعليًّا وعُمرَ رَضِيَ اللهُ عنهم، فقال أبو بكرٍ رَضِيَ اللهُ عنه: يا رسولَ اللهِ، هؤلاءِ بَنو العَمِّ والعشيرةِ والإخوانِ؛ فإنِّي أرى أنْ تأخُذَ منهُمُ الفِديةَ، فيكونَ ما أخَذْنا منهم قُوَّةً لنا على الكُفَّارِ، وعسى اللهُ أنْ يَهديَهم؛ فيكونوا لنا عَضُدًا، فقال رسولُ اللهِ صلَّى اللهُ عليه وعلى آلِهِ وسلَّمَ: ما ترى يا بنَ الخطَّابِ؟ قلتُ: واللهِ، ما أرى ما رأى أبو بكرٍ، ولكنِّي أرى أنْ تُمَكِّنَني مِن فُلانٍ -قريبًا لعُمرَ- فأضرِبَ عُنُقَهُ، وتُمَكِّنَ عليًّا رَضِيَ اللهُ عنه مِن عَقيلٍ فيضرِبَ عُنُقَهُ، وتُمَكِّنَ حمزةَ مِن فُلانٍ أخيه فيضرِبَ عُنُقَهُ؛ حتى يعلَمَ اللهُ أنَّه ليستْ في قُلوبِنا هَوادَةٌ للمشركينَ، هؤلاءِ صَناديدُهم وأئمَّتُهم وقادتُهم، فهَوِيَ رسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ ما قال أبو بكرٍ رَضِيَ اللهُ عنه، ولم يَهْوَ ما قلتُ؛ فأخَذَ مِنهُمُ الفِداءَ، فلمَّا أنْ كان مِنَ الغَدِ قال عمرُ رَضِيَ اللهُ عنه: غَدَوْتُ إلى رسولِ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، فإذا هو قاعدٌ وأبو بكرٍ رَضِيَ اللهُ عنه، وإذا هما يبكيانِ، فقلتُ: يا رسولَ اللهِ، أَخبِرْني ماذا يُبكيكَ أنتَ وصاحبَكَ، فإنْ وجدْتُ بُكاءً بكيْتُ، وإنْ لم أجِدْ تَباكَيْتُ لبكائِكما، قال: فقال النبيُّ صلَّى اللهُ عليه وعلى آلِهِ وسلَّمَ: الذي عَرَضَ عليَّ أَصحابُكَ مِنَ الفِداءِ، لقد عُرِضَ عليَّ عذابُهم أَدْنَى مِن هذهِ الشَّجرةِ -لشجرةٍ قريبةٍ-، وأنزل اللهُ عزَّ وجلَّ: {مَا كَانَ لِنَبِيٍّ أَنْ يَكونَ لَهُ أَسْرَى حَتَّى يُثْخِنَ فِي الْأَرْضِ} [الأنفال: 67] إلى قولِهِ: {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ لَمَسَّكُمْ فِيمَا أَخَذْتُمْ} [الأنفال: 68] مِنَ الفِداءِ، ثُمَّ أحَلَّ اللهُ لهُمُ الغنائِمَ، فلمَّا كان يومُ أُحُدٍ مِنَ العامِ المُقْبِلِ ",["عُوقِبوا بما صنَعوا يومَ بَدْرٍ",2]," ",["مِن أَخْذِهِمُ الفِداءَ",1],"، فقُتِلَ مِنهُم سبعونَ، وفَرَّ أصحابُ النبيِّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ عَنِ النبيِّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، وكُسِرَتْ رَباعِيَتُهُ، وهُشِّمَتِ البَيْضةُ على رأسِهِ، وسال الدَّمُ على وجهِهِ، وأنزل اللهُ عزَّ وجلَّ: {أَوَلَمَّا أَصَابَتْكُمْ مُصِيبَةٌ قَدْ أَصَبْتُمْ مِثْلَيْهَا} [آل عمران: 165] بأخْذِكُمُ الفِداءَ."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه مسلم (1763) باختلاف يسير.","bab":"قرآن › أسباب النزول","dorar":"FGoysDoa"},{"id":"س-03470","fp":"08207db1399a","stateId":594,"easy":"إذا ظهرت المعاصي في الأمة ← يعمهم الله بعذاب من عنده","cause":"إذا ظَهَرتِ المعاصي في أمَّتي","result":"عمَّهمُ اللَّهُ بعذابٍ من عندِهِ","explicit":true,"otherNeedIds":[69],"ref":"بذل الماعون 129","srcLabel":"أحمد","text":[["إذا ظَهَرتِ المعاصي في أمَّتي ",1],["عمَّهمُ اللَّهُ بعذابٍ من عندِهِ",2]," فقلتُ : يا رسولَ اللَّهِ أما فيهِم صالِحونَ ؟ قال : بلَى يصيبُهم ما أصابَ النَّاسُ ثُمَّ يصيرونَ إلى مغفِرةٍ من اللَّهِ ورضوانٍ"],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (26638)، والطبراني (23/325) (747) باختلاف يسير.","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"ppygNXk6"},{"id":"س-04010","fp":"c0aa98e6af5c","stateId":594,"easy":"إذا اعترفت بالذنوب ولم تتب ← فلن يعذب الله أمة حتى يُعذر إليها","cause":"يَعترِفون بالذُّنوبِ ولا يَتوبون","result":"ولنْ يُعذِّبَ اللهُ تعالَى أُمَّةً حتَّى يَعذِرَ","explicit":true,"ref":"المستدرك على الصحيحين 8772","srcLabel":"نعيم","text":["لنْ تَبلُغوا بخيرٍ ما اسْتَغنى أهلُ بَدْوِكم عن أهلِ حَضرِكم، قال: ولَتَسُوقَنَّهم السِّنينُ والسِّناتُ حتَّى يَكونوا معكم في الدِّيارِ، ولا تَمْنَعوا منهم لكَثرةِ مَن يَسْتَنُّ عليكم، قال: يَقولون: طالَما جُعْنا وشَبِعْتم، وطالَما شَقِينا ونَعِمتُم، فواسُونا اليومَ، ولَنَسْتصْعِبَنَّ بكم الأرضَ، حتَّى يَغبِطَ أهلُ حَضرِكم مِن استصعابِ الأرضِ. قال: ولَتَمِيلَنَّ بكم الأرضُ مَيْلةً، يَهلِكُ منها مَن هَلَك، ويَبْقى مَن بَقِي حتَّى تَعْنُوا الرِّقابُ، ثمَّ تَهدَأُ بكم الأرضُ بعْدَ ذلكَ حتَّى يَندَمَ المُعتِقون، قال: ثمَّ تَميلُ بكم الأرضُ مِن بعدِ ذلكَ مَيلةً أُخرى، فيَهلِكُ فيها مَن هَلَكَ، ويَبْقى مَن بَقِي، فيَقولُون: ربَّنا نُعتِقُ، ربَّنا نُعتِقُ، فيُكذِّبُهم اللهُ: كذَبْتُم كذَبْتُم، أنا أُعتِقُ. قال: ولَيُبْتَلَينَّ أُخْرياتُ هذه الأُمَّةِ بالرَّجفِ؛ فإنْ تابوا تابَ اللهُ عليهم، قال: وإنْ عادوا أعاد اللهُ عليهم بالرَّجفِ والقذْفِ والخسْفِ والمسْخِ والصَّواعقِ، فإذا قِيل: هَلَك النَّاسُ، هَلَك النَّاسُ، هَلَك النَّاسُ، فقدْ هَلَكوا، ",["ولنْ يُعذِّبَ اللهُ تعالَى أُمَّةً حتَّى يَعذِرَ",2],"، قالوا: وما عُذرُها؟ قال: ",["يَعترِفون بالذُّنوبِ ولا يَتوبون",1],"، ولَتَطْمَئنَّ بالقلوبِ بما فِيها مِن بِرِّها وفُجورِها كما تَطْمَئنُّ الشَّجرةُ بما فيها، حتَّى لا يَستطيعَ مُحسِنٌ أنْ يَزدادَ إحسانًا، ولا يَستطيعَ مُسِيءٌ استعتابًا، وذلك بأنَّ اللهَ عزَّ وجلَّ قال: {كَلَّا بَلْ رَانَ عَلَى قُلُوبِهِمْ مَا كَانُوا يَكْسِبُونَ} [المطففين:14]"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح الإسناد، ولم يخرجاه","takhrij":"أخرجه نعيم بن حماد في ((الفتن)) (685) ببعض لفظه.","bab":"توبة › الحض على التوبة","dorar":"unIdEOfM"},{"id":"س-00559","fp":"2bc0a8e04802","stateId":594,"easy":"إذا غيّرتم (أحدثتم) ← يبعث الله عليكم من يلحاكم كما يُلحى القضيب","cause":"فإذا غيَّرتُم","result":"بعثَ اللهُ عليكُم مَن يَلحاكُم كما يُلحَى القَضيبُ","explicit":true,"ref":"فتح الباري لابن حجر 13/125","srcLabel":"أحمد","text":["يا معشرَ قريشٍ إنَّكم أهلُ هذا الأمرِ ما لم تُحدِثوا ",["فإذا غيَّرتُم",1]," ",["بعثَ اللهُ عليكُم مَن يَلحاكُم كما يُلحَى القَضيبُ",2]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"رجاله ثقات لكن عبيد الله لم يدرك عم أبيه","takhrij":"أخرجه أحمد (4380)، وأبو يعلى (5024)، والطبراني في ((المعجم الأوسط)) (8513) مطولاً باختلاف يسير","bab":"آداب عامة › ضرب الأمثال","dorar":"1Q7kB8ZU"},{"id":"س-03759","fp":"7081ff31a179","stateId":594,"easy":"إذا أنكرت زمانك ← فبما غيّرتم من أعمالكم","cause":"فبِما غيَّرتُم من أعمالِكم","result":"ما أنكرتم من زمانِكم","explicit":true,"ref":"مجمع الزوائد 10/234","srcLabel":"الطبراني","text":[["ما أنكرتم من زمانِكم",2]," ",["فبِما غيَّرتُم من أعمالِكم",1]," فإن يكُ خيرًا فواهًا واهًا وإن يكُ شرًّا فآهًا آهًا هكذا سمعت من نبيِّكم صلَّى اللهُ عليه وسلَّم"],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((الشاميين)) (26)، والبيهقي في ((الزهد الكبير)) (709)، وأبو نعيم في ((الحلية)) (5/ 249) واللفظ لهم.","bab":"اعتصام بالسنة › نقل السنة وروايتها","dorar":"ejteHFHo"},{"id":"س-04825","fp":"f295a33b5c68","stateId":594,"easy":"إذا عملت السيئات في زمن البلاء ← فهي الهلكة","cause":"أن تعمَلَ السَّيِّئاتِ في زمانِ البلاءِ","result":"إنَّ الهَلَكةَ","explicit":true,"ref":"مجمع الزوائد 10/239","srcLabel":"سعيد","text":["سمِعْتُ النُّعمانَ بنَ بَشيرٍ وهو يخطُبُ بحِمْصَ وهو يقولُ ألَا ",["إنَّ الهَلَكةَ",2]," ",["أن تعمَلَ السَّيِّئاتِ في زمانِ البلاءِ",1]],"grade":"حسن","narrator":"الوليد بن أيمن الألهاني","muhaddith":"إسناده حسن","takhrij":"أخرجه سعيد بن منصور في ((السنن)) (5567)، وابن أبي الدنيا في ((العقوبات)) (327) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"P3ZIzrZf"},{"id":"س-08057","fp":"d879a2cab3de","stateId":594,"easy":"إذا أصابتك نكبة ← فبذنب (وما يعفو الله أكثر)","cause":"بذنبٍ","result":"لا يُصِيبُ عبدًا نَكْبَةٌ ، فما فوقَها أو دونَها إلا","explicit":true,"otherNeedIds":[9],"ref":"صحيح الجامع 7732","srcLabel":"الترمذي","text":[["لا يُصِيبُ  عبدًا نَكْبَةٌ ، فما فوقَها أو دونَها إلا",2]," ",["بذنبٍ",1]," ، وما يَعْفُو اللهُ عنه أَكْثَرُ"],"grade":"حسن","narrator":"أبو موسى الأشعري","muhaddith":"حسن","takhrij":"أخرجه الترمذي (3252) بزيادة قصة في أوله","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"sA3NmLDj"},{"id":"س-03493","fp":"6e0efd375af8","stateId":594,"easy":"إذا اختلج عرقك أو عينك ← فبذنب، وما يدفع الله أكثر","cause":"بذنبٍ","result":"ما اختلجَ عِرْقٌ و لا عَينٌ إلا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[13],"ref":"الجامع الصغير 7778","srcLabel":"الطبراني","text":[["ما اختلجَ عِرْقٌ و لا عَينٌ إلا",2]," ",["بذنبٍ",1],"، و ما يدفعُ اللهُ عنهُ أكثرُ"],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الصغير)) (1053)، وأبو نعيم الأصبهاني في تاريخ أصبهان (2/217) كلاهما بلفظه.","bab":"استغفار › مكفرات الذنوب","dorar":"R5VQntes"},{"id":"س-04009","fp":"567834369496","stateId":594,"easy":"إذا عاد الناس إلى المعاصي ← أعاد الله عليهم العذاب","cause":"وإنْ عادوا","result":"أعاد اللهُ عليهم بالرَّجفِ والقذْفِ والخسْفِ والمسْخِ والصَّواعقِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"المستدرك على الصحيحين 8772","srcLabel":"نعيم","text":["لنْ تَبلُغوا بخيرٍ ما اسْتَغنى أهلُ بَدْوِكم عن أهلِ حَضرِكم، قال: ولَتَسُوقَنَّهم السِّنينُ والسِّناتُ حتَّى يَكونوا معكم في الدِّيارِ، ولا تَمْنَعوا منهم لكَثرةِ مَن يَسْتَنُّ عليكم، قال: يَقولون: طالَما جُعْنا وشَبِعْتم، وطالَما شَقِينا ونَعِمتُم، فواسُونا اليومَ، ولَنَسْتصْعِبَنَّ بكم الأرضَ، حتَّى يَغبِطَ أهلُ حَضرِكم مِن استصعابِ الأرضِ. قال: ولَتَمِيلَنَّ بكم الأرضُ مَيْلةً، يَهلِكُ منها مَن هَلَك، ويَبْقى مَن بَقِي حتَّى تَعْنُوا الرِّقابُ، ثمَّ تَهدَأُ بكم الأرضُ بعْدَ ذلكَ حتَّى يَندَمَ المُعتِقون، قال: ثمَّ تَميلُ بكم الأرضُ مِن بعدِ ذلكَ مَيلةً أُخرى، فيَهلِكُ فيها مَن هَلَكَ، ويَبْقى مَن بَقِي، فيَقولُون: ربَّنا نُعتِقُ، ربَّنا نُعتِقُ، فيُكذِّبُهم اللهُ: كذَبْتُم كذَبْتُم، أنا أُعتِقُ. قال: ولَيُبْتَلَينَّ أُخْرياتُ هذه الأُمَّةِ بالرَّجفِ؛ فإنْ تابوا تابَ اللهُ عليهم، قال: ",["وإنْ عادوا",1]," ",["أعاد اللهُ عليهم بالرَّجفِ والقذْفِ والخسْفِ والمسْخِ والصَّواعقِ",2],"، فإذا قِيل: هَلَك النَّاسُ، هَلَك النَّاسُ، هَلَك النَّاسُ، فقدْ هَلَكوا، ولنْ يُعذِّبَ اللهُ تعالَى أُمَّةً حتَّى يَعذِرَ، قالوا: وما عُذرُها؟ قال: يَعترِفون بالذُّنوبِ ولا يَتوبون، ولَتَطْمَئنَّ بالقلوبِ بما فِيها مِن بِرِّها وفُجورِها كما تَطْمَئنُّ الشَّجرةُ بما فيها، حتَّى لا يَستطيعَ مُحسِنٌ أنْ يَزدادَ إحسانًا، ولا يَستطيعَ مُسِيءٌ استعتابًا، وذلك بأنَّ اللهَ عزَّ وجلَّ قال: {كَلَّا بَلْ رَانَ عَلَى قُلُوبِهِمْ مَا كَانُوا يَكْسِبُونَ} [المطففين:14]"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح الإسناد، ولم يخرجاه","takhrij":"أخرجه نعيم بن حماد في ((الفتن)) (685) ببعض لفظه.","bab":"توبة › الحض على التوبة","dorar":"unIdEOfM"},{"id":"س-01757","fp":"85bd01ccb5b8","stateId":595,"easy":"إذا قطعت رحماً أو حلفت يميناً فاجرة ← ترى وباله قبل أن تموت","cause":"من قطع رَحِمًا ، أو حلف على يمينٍ فاجرةٍ","result":"رأى وبالَه قبل أن يموتَ","explicit":true,"star":true,"ref":"صحيح الجامع 6475","srcLabel":"البخاري","text":[["من قطع رَحِمًا ، أو حلف على يمينٍ فاجرةٍ ، ",1],["رأى وبالَه قبل أن يموتَ",2]],"grade":"صحيح","narrator":"القاسم بن عبدالرحمن","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((التاريخ الكبير)) (6/207)","bab":"أيمان › تعظيم شأن الأيمان","dorar":"ULMvrA6m"},{"id":"س-08075","fp":"6372b5a58b1c","stateId":595,"easy":"إذا قطعت ود أبيك ← يطفئ الله نورك","cause":"احفَظ وُدَّ أبيكَ ، لا تقطعهُ","result":"فيُطْفِئَ اللَّهُ نورَكَ","explicit":true,"ref":"الفتوحات الربانية 4/106","srcLabel":"البخاري","text":[["احفَظ وُدَّ أبيكَ ، لا تقطعهُ",1]," ",["فيُطْفِئَ اللَّهُ نورَكَ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (40)، والطبراني في ((المعجم الأوسط)) (8633)، والبيهقي في ((شعب الإيمان)) (7898)","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"Hd5O4Lzj"},{"id":"س-05100","fp":"cc24562eaddc","stateId":595,"easy":"إذا بغيت أو قطعت رحمك ← فلا ذنب أحرى بتعجيل العقوبة في الدنيا مع ما يُدخر في الآخرة","cause":"بَغْيٍ، أو قَطيعةِ رَحِمٍ","result":"ما مِن ذَنبٍ أحْرى أنْ يُعَجَّلَ لِصاحِبِهِ العُقوبةُ مع ما يُؤَخَّرُ له في الآخِرَةِ","explicit":true,"similar":["س-04802"],"otherNeedIds":[60,70],"ref":"تخريج المسند لشعيب 20374","srcLabel":"أبو داود","text":[["ما مِن ذَنبٍ أحْرى أنْ يُعَجَّلَ لِصاحِبِهِ العُقوبةُ مع ما يُؤَخَّرُ له في الآخِرَةِ",2],"، مِن ",["بَغْيٍ، أو قَطيعةِ رَحِمٍ",1],"، قال وَكيعٌ: أنْ يُعَجِّلَ اللهُ، وقالَ يَزيدُ: يُعَجِّلُ اللهُ، وقالَ: مع ما يَدَّخِرُ له."],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4902)، والترمذي (2511)، وابن ماجه (4211)، وأحمد (20374) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"UuoYCl8S","merged":7,"otherRefs":["تخريج مشكل الآثار 5998 (صحيح)","صحيح الأدب المفرد 459 (صحيح)","صحيح الجامع 2810 (صحيح)","تخريج المسند لشعيب 20380 (صحيح)","المستدرك على الصحيحين 7496 (صحيح)","صحيح الأدب المفرد 687 (صحيح)"]},{"id":"س-01755","fp":"a1eea1ca3c3f","stateId":595,"easy":"إذا حلفت يميناً فاجرة ← تدع الديار بلاقع","cause":"واليمينُ الفاجرةُ","result":"تدَعُ الدِّيارَ بَلاقِعَ","explicit":true,"similar":["س-05247"],"otherNeedIds":[3],"ref":"السلسلة الصحيحة 2/670","srcLabel":"الطبراني","text":["ثلاثٌ مَن كنَّ فيه رأى وبالَهنَّ قبل موتِه فذكرَهن وفي آخرِهن ",["واليمينُ الفاجرةُ",1]," ",["تدَعُ الدِّيارَ بَلاقِعَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (1092)، والقضاعي في ((مسند الشهاب)) (255)، والبيهقي (20364) مطولاً بنحوه","bab":"أيمان › تعظيم شأن الأيمان","dorar":"BogJovW6","merged":3,"otherRefs":["شرح مسند أبي حنيفة 535 (حسن)","صحيح الترغيب 1836 (حسن)"]},{"id":"س-04802","fp":"eb30c5a18866","stateId":595,"easy":"إذا بغيت أو قطعت رحمك ← فلا شيء أعجل عقوبة منهما","cause":"البَغْيِ و قَطِيعَةِ الرَّحِمِ","result":"و ليس شيءٌ أَعْجَلَ عِقَابًا","explicit":true,"repOf":"س-05100","ref":"السلسلة الصحيحة 978","text":["ليس شيءٌ أُطِيعَ اللهُ فيهِ أَعْجَلَ ثَوَابًا من صِلَةِ الرَّحِمِ ، ",["و ليس شيءٌ أَعْجَلَ عِقَابًا",2]," مِنَ ",["البَغْيِ و قَطِيعَةِ الرَّحِمِ",1]," ، و اليَمِينُ الفَاجِرَةُ تَدَعُ الدِّيارَ بَلا قِعَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"ثابت بجموع الطرق","takhrij":"أخرجه أبو نعيم في ((مسند أبي حنيفة)) (ص243) باختلاف يسير، والقضاعي في ((مسند الشهاب)) (255) مختصراً، والبيهقي (20364) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"3PzvX6VT","merged":3,"otherRefs":["شرح مسند أبي حنيفة 535 (حسن)","فيض القدير 1017 (حسن)"]},{"id":"س-05155","fp":"966aa29e2f09","stateId":595,"easy":"إذا عققت والديك ← يعجّل الله لك العقوبة في حياتك قبل مماتك","cause":"عُقوقَ الوالِدَيْنِ","result":"يُعجِّلُه لِصاحبِه في الحياةِ قبْلَ المماتِ","explicit":true,"ref":"المستدرك على الصحيحين 7469","srcLabel":"البيهقي","text":["كُلُّ الذُّنوبِ يُؤخِّرُ اللهُ ما شاءَ مِنها إلى يومِ القِيامةِ إلَّا ",["عُقوقَ الوالِدَيْنِ",1],"؛ فإنَّ اللهَ تَعالَى ",["يُعجِّلُه لِصاحبِه في الحياةِ قبْلَ المماتِ",2],"."],"grade":"صحيح","narrator":"أبو بكرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه يعقوب بن سفيان الفسوي في ((مشيخته)) (14)، وقوام السنة الأصفهاني في ((الترغيب والترهيب)) (468)، والبيهقي في ((شعب الإيمان)) (7505) مطولا، وجميعا بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"FbFOvRiV"},{"id":"س-08035","fp":"3f4caa37538d","stateId":595,"easy":"إذا بغيت ولو على جبل ← لدُكّ الباغي","cause":"بغَى على جبلٍ","result":"لدُكَّ الباغي","explicit":true,"ref":"صحيح الأدب المفرد 457","srcLabel":"البخاري (الأدب المفرد)","text":["عن ابنِ عبَّاسٍ قال لو أنَّ جبلًا ",["بغَى على جبلٍ",1]," ",["لدُكَّ الباغي",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"مظالم › تحريم الظلم","dorar":"kBpK8fAt"},{"id":"س-08044","fp":"0276b16b02f6","stateId":595,"easy":"إذا بغيت ← فإنما بغيك على نفسك","cause":"لا تَبْغِ ولا [تعنْ] باغِيًا","result":"إنَّما بَغْيُكم على أنْفُسِكم","explicit":true,"ref":"المستدرك على الصحيحين 3340","srcLabel":"البيهقي","text":[["لا تَبْغِ ولا [تعنْ] باغِيًا",1],"؛ فإنَّ اللهَ يقولُ: {",["إنَّما بَغْيُكم على أنْفُسِكم",2],"}."],"grade":"صحيح","narrator":"أبو بكرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (6244) بلفظه.","bab":"مظالم › تحريم الظلم","dorar":"jTLbDpxR"},{"id":"س-08070","fp":"f6544fb35119","stateId":595,"easy":"إذا قطعت رحمك أو خنت أو كذبت ← فلا ذنب أجدر بتعجيل العقوبة","cause":"قطيعةِ الرَّحِمِ ، والخيانةِ ، والكذبِ","result":"ما من ذنبٍ أجدرُ أن يُعجِّلَ اللهُ تعالى لصاحبِه العقوبةَ في الدنيا ، مع ما يَدِّخِرُه له في الآخرةِ","explicit":true,"otherNeedIds":[70],"ref":"صحيح الجامع 5705","srcLabel":"أبو داود","text":[["ما من ذنبٍ أجدرُ أن يُعجِّلَ اللهُ تعالى لصاحبِه العقوبةَ في الدنيا ، مع ما يَدِّخِرُه له في الآخرةِ",2]," من ",["قطيعةِ الرَّحِمِ ، والخيانةِ ، والكذبِ",1]," ، وإنَّ أَعجلَ الطاعةِ ثوابًا لصلَةُ الرَّحِمِ ، حتى إنَّ أهلَ البيتِ ليكونوا فجَرةً ، فتنمو أموالُهم ، ويكثُرُ عددُهم ، إذا تواصَلوا"],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4902)، والترمذي (2511)، وابن ماجه (4211)، وأحمد (20374) مختصراً، وابن حبان (440، 455) مفرقاً باختلاف يسير.","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"YEtGOzfj"},{"id":"س-05247","fp":"d49bb4a516f4","stateId":595,"easy":"إذا حلفت يميناً غموساً ← تدع الديار بلاقع","cause":"اليَمينُ الغَموسُ","result":"تدَعُ الدِّيارَ بَلاقِعَ","explicit":true,"repOf":"س-01755","otherNeedIds":[3],"ref":"تخريج شرح السنة 1/85","text":[["اليَمينُ الغَموسُ",1]," ",["تدَعُ الدِّيارَ بَلاقِعَ",2],"."],"grade":"حسن","narrator":"واثلة بن الأسقع الليثي أبو فسيلة","muhaddith":"حسن","takhrij":"أخرجه خيثمة الأطرابلسي في (( المنتخب من الفوائد)) (ص 70) بلفظه، والدولابي في (( الكنى والأسماء)) (2072)، والخطيب في (( تلخيص المتشابه في الرسم )) (2/ 702)  كلاهما بلفظه وزادا : ((الْكَاذِبَةُ))","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"NaxarNaA"},{"id":"س-03899","fp":"14b8b2482fbd","stateId":595,"easy":"إذا قطعت رحمك وأسأت جوارها ← قد تعجّل لك العقوبة (من قصة)","cause":"فقَطَعوا رَحِمَه، وأساؤوا مُجاوَرَتَه","result":"تَهَوَّرَ القَليبُ بمَن كان عليها وعلى مَن كانَ فيها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[29],"ref":"فضائل الأوقات 12","srcLabel":"البيهقي","text":["بَينا نحن عِندَ عُمَرَ بنِ الخَطَّابِ رَضيَ اللهُ عنه في يَومٍ يَعرِضُ فيه الدِّيوانَ إذْ مَرَّ به رَجُلٌ أعمى، أعرَجُ، قد عَنَّى قائِدَه، فقالَ عُمَرُ حين رآه وأعجَبَه شَأنُه: مَن يَعرِفُ هذا؟ قال رَجُلٌ مِنَ القَومِ: هذا رَجُلٌ مِن بَني صَبغاءَ، بَهلةَ بَريقٍ، قال: وما بَريقٌ؟ قال: رَجُلٌ مِن أهلِ اليَمَنِ؟ قال: أشاهِدٌ هو؟ قال: نَعَمْ. فأُتيَ به عُمَرُ فقال: ما شَأنُكَ وشَأنُ بَني صَبغاءَ؟ قال: إنَّ بَني صَبغاءَ كانوا اثنَيْ عَشَرَ رَجُلًا، وإنَّهم جاوَروني في الجاهليَّةِ، فجَعَلوا يَأكُلونَ مالي، ويَشتِمونَ عِرْضي، وأنا أشتَهيهم، وناشَدتُهمُ اللهَ والرَّحِمَ، فأبَوْا علَيَّ، فأمهَلتُهم حتى إذا كان الشَّهرُ الحَرامُ دَعَوتُ اللهَ عليهم، وقُلتُ: \nاللَّهمَّ أدعوكَ دُعاءً جاهِدَا *** اقتُلْ بَني صَبغاءَ إلَّا واحِدًا\nثم اضرِبِ الرَّجُلَ فذَره قاعِدَا *** أعمى إذا ما قيدَ عَنَّى القائِدا\nفلم يَحُلِ الحَولُ حتى هَلَكوا غَيرَ واحِدٍ، وهو هذا كما ترى قد عَنَّى قائِدَه. فقالَ عُمَرُ: سُبحانَ اللهِ! إنَّ في هذا لَعِبَرًا وعَجَبًا. فقالَ رَجُلٌ آخَرُ مِنَ القَومِ: ألَا أُحَدِّثُكَ يا أميرَ المُؤمِنينَ مِثلَ هذا وأعجَبَ منه؟ فقال: بلى. قال: فإنَّ رِجالًا مِن خُزاعةَ جاوَروا رَجُلًا منهم، ",["فقَطَعوا رَحِمَه، وأساؤوا مُجاوَرَتَه",1],"، وإنَّه ناشَدَهمُ اللهَ والرَّحِمَ إلَّا أعفَوْه مِمَّا يَكرَهُ، فأبَوْا عليه، فأمهَلَهم حتى إذا جاءَ الشَّهرُ الحَرامُ دعا عليهم فقالَ:\nاللَّهمَّ رَبَّ كُلِّ آمِنٍ وخائِفْ *** وسامِعًا هُتافَ كُلِّ هاتِفْ\nإنَّ الخُزاعِيَّ أبا تَقاصُفْ *** لم يُعطِني الحَقَّ ولم يُناصِفْ\nفاجمَعْ له الأحِبَّةَ ‌[الألاطف]* بَني قِرانٍ ثَمَّ والنَّواصِفْ\nاجمَعْهم في جَوفِ كُلِّ راجِفْ\nقال: فبَينا هم عِندَ قَليبٍ يَنزِفونَها، فمنهم مَن هو فيها، ومنهم مَن هو فَوقَها ",["تَهَوَّرَ القَليبُ بمَن كان عليها وعلى مَن كانَ فيها",2],"، وصارَتْ قُبورُهم حتى الساعةِ، قال عُمَرُ: سُبحانَ اللهِ! إنَّ في هذا لَعِبرةً وعَجَبًا، فقالَ رَجُلٌ مِنَ القَومِ آخَرُ: يا أميرَ المُؤمِنينَ ألَا أُخبِرُكَ بمِثلِ هذا وأعجَبَ منه؟ قال: بلى. قال: فإنَّ رَجُلًا مِن هُذَيلٍ وَرِثَ فَخِذَه التي هو فيها، حتى لم يَبقَ منهم أحَدٌ غَيرُه، فجَمَعَ مالًا كَثيرًا فعَمَدَ إلى رَهطٍ مِن قَومِه، يُقالُ لهم: بَنو المُؤَمَّلِ، فجاوَرَهم لِيَمنَعوه، ولِيرُدُّوا عليه ماشِيَتَه، وإنَّهم حَسَدوه على مالِه ونَفَسوه مالَه، فجَعَلوا يَأكُلونَ مِن مالِه، ويَشتِمونَ عِرضَه، وأنَّه ناشَدَهمُ اللهَ والرَّحِمَ إلَّا عَدَلوا عنه ما يَكرَه، فأبَوْا عليه، فجَعَلَ رَجُلٌ منهم يُقالُ له: رَباحٌ، أو رياحٌ، يُكَلِّمُهم فيه، ويَقولُ: يا بَني المُؤَمَّلِ، ابنُ عَمَّتِكمُ اختارَ مُجاوَرَتَكم على مَن سِواكم، فأحسِنوا مُجاوَرَتَه، فأبَوْا عليه، فأمهَلَهم حتى إذا كانَ الشَّهرُ الحَرامُ دعا عليهم، فقال:\nاللَّهمَّ أزِلْ عَنِّي بَني المُؤَمَّلِ *** وارْمِ على أقفائِهم بمَنكِلِ\nبصَخرةٍ أو عَرضِ جَيشٍ جَحفَلِ *** إلَّا رَباحًا إنَّه لم يَفعَلِ\nقال: فبَينَما هم ذاتَ يَومٍ نُزولٌ إلى أصلِ جَبَلٍ انحَطَّتْ عليهم صَخرةٌ مِنَ الجَبَلِ، لا تَمُرُّ بشَيءٍ إلَّا طَحَنَتْه، حتى مَرَّتْ بأبياتِهم فطَحَنَتْها طَحنةً واحِدةً، إلَّا رَباحًا الذي استَثْناهُ. فقال: سُبحانَ اللهِ! إنَّ في هذا لَعِبرةً وعَجَبًا. فقالَ رَجُلٌ مِنَ القَومِ: ألَا أُخبِرُكَ يا أميرَ المُؤمِنينَ مِثلَه وأعجَبَ منه؟ قال: بلى. قال: فإنَّ رَجُلًا مِن جُهَينةَ جاوَرَ قَومًا مِن بَني ضَمرةَ في الجاهليَّةِ، وكانَ رَجُلٌ مِن بَني ضَمرةَ يُقالُ له: ريشةُ، يَعدو عليه، فلا يَزالُ يَنحَرُ بَعيرًا مِن إبِلِه وإنَّه كَلَّمَ قَومَه فيه، فقالوا: إنَّا خَلَعْناه، فانظُرْ أنْ نَقتُلَه. فلَمَّا رآه لا يَنتَهي أمهَلَه حتى إذا كانَ الشَّهرُ الحَرامُ دَعا عليه، فقالَ:\nأصادِقٌ ريشةُ بلا ضَمرةْ *** أنْ يُسيِّرَ اللهُ عليه قَدَرَهْ\nأمَا يَزالُ شارِفٌ أو بَكْرَةْ *** يَطعُنُ منها في سَواءِ الثُّغرةْ\nبصارِمٍ ذي رَونَقٍ أو شَفرةْ *** اللَّهمَّ إنْ كان بَعدي فَجرَهْ\nفاجعَلْ أمامَ العَينِ منه حَذرَهْ *** يَأكُلُه حتى يُوافى الحُفرةْ\nفسَلَّطَ الله عليه أكَلةً فأكَلَتْه حتى ماتَ قَبلَ الحَولِ. فقالَ عُمَرُ: سُبحانَ اللهِ! إنَّ في هذا لَعِبرةً وعَجَبًا، وإنْ كانَ اللهُ لَيَصنَعُ هذا بالناسِ في جاهليَّتِهم لِيَنزِعَ بَعضَهم مِن بَعضٍ، فلَمَّا أتى اللهُ بالإسلامِ أخَّرَ اللهُ العُقوبةَ إلى يَومِ القِيامةِ، وذلك أنَّ اللهَ تَعالى قالَ: {إِنَّ يَوْمَ الْفَصْلِ مِيقَاتُهُمْ أَجْمَعِينَ} [الدخان: 40]، {بَلِ السَّاعَةُ مَوْعِدُهُمْ وَالسَّاعَةُ أَدْهَى وَأَمَرُّ} [القمر: 46]، وقال: {وَلَوْ يُؤَاخِذُ اللَّهُ النَّاسَ بِظُلْمِهِمْ مَا تَرَكَ عَلَيْهَا مِنْ دَابَّةٍ وَلَكِنْ يُؤَخِّرُهُمْ إِلَى أَجَلٍ مُسَمًّى} [النحل: 61]."],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (3529) واللفظ له، وابن أبي الدنيا في ((مجابو الدعوة)) (20)، وابن عساكر في ((فضل رجب)) (4) بنحوه.","bab":"تفسير آيات › سورة الدخان","dorar":"5hVa44Z0"},{"id":"س-03900","fp":"0b7dbc4c563a","stateId":595,"easy":"إذا أكلت مال قريبك وشتمت عرضه ← قد تعجّل لك العقوبة (من قصة)","cause":"فجَعَلوا يَأكُلونَ مِن مالِه، ويَشتِمونَ عِرضَه","result":"انحَطَّتْ عليهم صَخرةٌ مِنَ الجَبَلِ، لا تَمُرُّ بشَيءٍ إلَّا طَحَنَتْه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[29],"ref":"فضائل الأوقات 12","srcLabel":"البيهقي","text":["بَينا نحن عِندَ عُمَرَ بنِ الخَطَّابِ رَضيَ اللهُ عنه في يَومٍ يَعرِضُ فيه الدِّيوانَ إذْ مَرَّ به رَجُلٌ أعمى، أعرَجُ، قد عَنَّى قائِدَه، فقالَ عُمَرُ حين رآه وأعجَبَه شَأنُه: مَن يَعرِفُ هذا؟ قال رَجُلٌ مِنَ القَومِ: هذا رَجُلٌ مِن بَني صَبغاءَ، بَهلةَ بَريقٍ، قال: وما بَريقٌ؟ قال: رَجُلٌ مِن أهلِ اليَمَنِ؟ قال: أشاهِدٌ هو؟ قال: نَعَمْ. فأُتيَ به عُمَرُ فقال: ما شَأنُكَ وشَأنُ بَني صَبغاءَ؟ قال: إنَّ بَني صَبغاءَ كانوا اثنَيْ عَشَرَ رَجُلًا، وإنَّهم جاوَروني في الجاهليَّةِ، فجَعَلوا يَأكُلونَ مالي، ويَشتِمونَ عِرْضي، وأنا أشتَهيهم، وناشَدتُهمُ اللهَ والرَّحِمَ، فأبَوْا علَيَّ، فأمهَلتُهم حتى إذا كان الشَّهرُ الحَرامُ دَعَوتُ اللهَ عليهم، وقُلتُ: \nاللَّهمَّ أدعوكَ دُعاءً جاهِدَا *** اقتُلْ بَني صَبغاءَ إلَّا واحِدًا\nثم اضرِبِ الرَّجُلَ فذَره قاعِدَا *** أعمى إذا ما قيدَ عَنَّى القائِدا\nفلم يَحُلِ الحَولُ حتى هَلَكوا غَيرَ واحِدٍ، وهو هذا كما ترى قد عَنَّى قائِدَه. فقالَ عُمَرُ: سُبحانَ اللهِ! إنَّ في هذا لَعِبَرًا وعَجَبًا. فقالَ رَجُلٌ آخَرُ مِنَ القَومِ: ألَا أُحَدِّثُكَ يا أميرَ المُؤمِنينَ مِثلَ هذا وأعجَبَ منه؟ فقال: بلى. قال: فإنَّ رِجالًا مِن خُزاعةَ جاوَروا رَجُلًا منهم، فقَطَعوا رَحِمَه، وأساؤوا مُجاوَرَتَه، وإنَّه ناشَدَهمُ اللهَ والرَّحِمَ إلَّا أعفَوْه مِمَّا يَكرَهُ، فأبَوْا عليه، فأمهَلَهم حتى إذا جاءَ الشَّهرُ الحَرامُ دعا عليهم فقالَ:\nاللَّهمَّ رَبَّ كُلِّ آمِنٍ وخائِفْ *** وسامِعًا هُتافَ كُلِّ هاتِفْ\nإنَّ الخُزاعِيَّ أبا تَقاصُفْ *** لم يُعطِني الحَقَّ ولم يُناصِفْ\nفاجمَعْ له الأحِبَّةَ ‌[الألاطف]* بَني قِرانٍ ثَمَّ والنَّواصِفْ\nاجمَعْهم في جَوفِ كُلِّ راجِفْ\nقال: فبَينا هم عِندَ قَليبٍ يَنزِفونَها، فمنهم مَن هو فيها، ومنهم مَن هو فَوقَها تَهَوَّرَ القَليبُ بمَن كان عليها وعلى مَن كانَ فيها، وصارَتْ قُبورُهم حتى الساعةِ، قال عُمَرُ: سُبحانَ اللهِ! إنَّ في هذا لَعِبرةً وعَجَبًا، فقالَ رَجُلٌ مِنَ القَومِ آخَرُ: يا أميرَ المُؤمِنينَ ألَا أُخبِرُكَ بمِثلِ هذا وأعجَبَ منه؟ قال: بلى. قال: فإنَّ رَجُلًا مِن هُذَيلٍ وَرِثَ فَخِذَه التي هو فيها، حتى لم يَبقَ منهم أحَدٌ غَيرُه، فجَمَعَ مالًا كَثيرًا فعَمَدَ إلى رَهطٍ مِن قَومِه، يُقالُ لهم: بَنو المُؤَمَّلِ، فجاوَرَهم لِيَمنَعوه، ولِيرُدُّوا عليه ماشِيَتَه، وإنَّهم حَسَدوه على مالِه ونَفَسوه مالَه، ",["فجَعَلوا يَأكُلونَ مِن مالِه، ويَشتِمونَ عِرضَه",1],"، وأنَّه ناشَدَهمُ اللهَ والرَّحِمَ إلَّا عَدَلوا عنه ما يَكرَه، فأبَوْا عليه، فجَعَلَ رَجُلٌ منهم يُقالُ له: رَباحٌ، أو رياحٌ، يُكَلِّمُهم فيه، ويَقولُ: يا بَني المُؤَمَّلِ، ابنُ عَمَّتِكمُ اختارَ مُجاوَرَتَكم على مَن سِواكم، فأحسِنوا مُجاوَرَتَه، فأبَوْا عليه، فأمهَلَهم حتى إذا كانَ الشَّهرُ الحَرامُ دعا عليهم، فقال:\nاللَّهمَّ أزِلْ عَنِّي بَني المُؤَمَّلِ *** وارْمِ على أقفائِهم بمَنكِلِ\nبصَخرةٍ أو عَرضِ جَيشٍ جَحفَلِ *** إلَّا رَباحًا إنَّه لم يَفعَلِ\nقال: فبَينَما هم ذاتَ يَومٍ نُزولٌ إلى أصلِ جَبَلٍ ",["انحَطَّتْ عليهم صَخرةٌ مِنَ الجَبَلِ، لا تَمُرُّ بشَيءٍ إلَّا طَحَنَتْه",2],"، حتى مَرَّتْ بأبياتِهم فطَحَنَتْها طَحنةً واحِدةً، إلَّا رَباحًا الذي استَثْناهُ. فقال: سُبحانَ اللهِ! إنَّ في هذا لَعِبرةً وعَجَبًا. فقالَ رَجُلٌ مِنَ القَومِ: ألَا أُخبِرُكَ يا أميرَ المُؤمِنينَ مِثلَه وأعجَبَ منه؟ قال: بلى. قال: فإنَّ رَجُلًا مِن جُهَينةَ جاوَرَ قَومًا مِن بَني ضَمرةَ في الجاهليَّةِ، وكانَ رَجُلٌ مِن بَني ضَمرةَ يُقالُ له: ريشةُ، يَعدو عليه، فلا يَزالُ يَنحَرُ بَعيرًا مِن إبِلِه وإنَّه كَلَّمَ قَومَه فيه، فقالوا: إنَّا خَلَعْناه، فانظُرْ أنْ نَقتُلَه. فلَمَّا رآه لا يَنتَهي أمهَلَه حتى إذا كانَ الشَّهرُ الحَرامُ دَعا عليه، فقالَ:\nأصادِقٌ ريشةُ بلا ضَمرةْ *** أنْ يُسيِّرَ اللهُ عليه قَدَرَهْ\nأمَا يَزالُ شارِفٌ أو بَكْرَةْ *** يَطعُنُ منها في سَواءِ الثُّغرةْ\nبصارِمٍ ذي رَونَقٍ أو شَفرةْ *** اللَّهمَّ إنْ كان بَعدي فَجرَهْ\nفاجعَلْ أمامَ العَينِ منه حَذرَهْ *** يَأكُلُه حتى يُوافى الحُفرةْ\nفسَلَّطَ الله عليه أكَلةً فأكَلَتْه حتى ماتَ قَبلَ الحَولِ. فقالَ عُمَرُ: سُبحانَ اللهِ! إنَّ في هذا لَعِبرةً وعَجَبًا، وإنْ كانَ اللهُ لَيَصنَعُ هذا بالناسِ في جاهليَّتِهم لِيَنزِعَ بَعضَهم مِن بَعضٍ، فلَمَّا أتى اللهُ بالإسلامِ أخَّرَ اللهُ العُقوبةَ إلى يَومِ القِيامةِ، وذلك أنَّ اللهَ تَعالى قالَ: {إِنَّ يَوْمَ الْفَصْلِ مِيقَاتُهُمْ أَجْمَعِينَ} [الدخان: 40]، {بَلِ السَّاعَةُ مَوْعِدُهُمْ وَالسَّاعَةُ أَدْهَى وَأَمَرُّ} [القمر: 46]، وقال: {وَلَوْ يُؤَاخِذُ اللَّهُ النَّاسَ بِظُلْمِهِمْ مَا تَرَكَ عَلَيْهَا مِنْ دَابَّةٍ وَلَكِنْ يُؤَخِّرُهُمْ إِلَى أَجَلٍ مُسَمًّى} [النحل: 61]."],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (3529) واللفظ له، وابن أبي الدنيا في ((مجابو الدعوة)) (20)، وابن عساكر في ((فضل رجب)) (4) بنحوه.","bab":"تفسير آيات › سورة الدخان","dorar":"5hVa44Z0"},{"id":"س-03901","fp":"cc88f22c02e1","stateId":595,"easy":"إذا ظلمت قريبك ← قد يسلّط الله عليك ما يهلكك (من قصة)","cause":"فلا يَزالُ يَنحَرُ بَعيرًا مِن إبِلِه","result":"فسَلَّطَ الله عليه أكَلةً فأكَلَتْه حتى ماتَ قَبلَ الحَولِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"فضائل الأوقات 12","srcLabel":"البيهقي","text":["بَينا نحن عِندَ عُمَرَ بنِ الخَطَّابِ رَضيَ اللهُ عنه في يَومٍ يَعرِضُ فيه الدِّيوانَ إذْ مَرَّ به رَجُلٌ أعمى، أعرَجُ، قد عَنَّى قائِدَه، فقالَ عُمَرُ حين رآه وأعجَبَه شَأنُه: مَن يَعرِفُ هذا؟ قال رَجُلٌ مِنَ القَومِ: هذا رَجُلٌ مِن بَني صَبغاءَ، بَهلةَ بَريقٍ، قال: وما بَريقٌ؟ قال: رَجُلٌ مِن أهلِ اليَمَنِ؟ قال: أشاهِدٌ هو؟ قال: نَعَمْ. فأُتيَ به عُمَرُ فقال: ما شَأنُكَ وشَأنُ بَني صَبغاءَ؟ قال: إنَّ بَني صَبغاءَ كانوا اثنَيْ عَشَرَ رَجُلًا، وإنَّهم جاوَروني في الجاهليَّةِ، فجَعَلوا يَأكُلونَ مالي، ويَشتِمونَ عِرْضي، وأنا أشتَهيهم، وناشَدتُهمُ اللهَ والرَّحِمَ، فأبَوْا علَيَّ، فأمهَلتُهم حتى إذا كان الشَّهرُ الحَرامُ دَعَوتُ اللهَ عليهم، وقُلتُ: \nاللَّهمَّ أدعوكَ دُعاءً جاهِدَا *** اقتُلْ بَني صَبغاءَ إلَّا واحِدًا\nثم اضرِبِ الرَّجُلَ فذَره قاعِدَا *** أعمى إذا ما قيدَ عَنَّى القائِدا\nفلم يَحُلِ الحَولُ حتى هَلَكوا غَيرَ واحِدٍ، وهو هذا كما ترى قد عَنَّى قائِدَه. فقالَ عُمَرُ: سُبحانَ اللهِ! إنَّ في هذا لَعِبَرًا وعَجَبًا. فقالَ رَجُلٌ آخَرُ مِنَ القَومِ: ألَا أُحَدِّثُكَ يا أميرَ المُؤمِنينَ مِثلَ هذا وأعجَبَ منه؟ فقال: بلى. قال: فإنَّ رِجالًا مِن خُزاعةَ جاوَروا رَجُلًا منهم، فقَطَعوا رَحِمَه، وأساؤوا مُجاوَرَتَه، وإنَّه ناشَدَهمُ اللهَ والرَّحِمَ إلَّا أعفَوْه مِمَّا يَكرَهُ، فأبَوْا عليه، فأمهَلَهم حتى إذا جاءَ الشَّهرُ الحَرامُ دعا عليهم فقالَ:\nاللَّهمَّ رَبَّ كُلِّ آمِنٍ وخائِفْ *** وسامِعًا هُتافَ كُلِّ هاتِفْ\nإنَّ الخُزاعِيَّ أبا تَقاصُفْ *** لم يُعطِني الحَقَّ ولم يُناصِفْ\nفاجمَعْ له الأحِبَّةَ ‌[الألاطف]* بَني قِرانٍ ثَمَّ والنَّواصِفْ\nاجمَعْهم في جَوفِ كُلِّ راجِفْ\nقال: فبَينا هم عِندَ قَليبٍ يَنزِفونَها، فمنهم مَن هو فيها، ومنهم مَن هو فَوقَها تَهَوَّرَ القَليبُ بمَن كان عليها وعلى مَن كانَ فيها، وصارَتْ قُبورُهم حتى الساعةِ، قال عُمَرُ: سُبحانَ اللهِ! إنَّ في هذا لَعِبرةً وعَجَبًا، فقالَ رَجُلٌ مِنَ القَومِ آخَرُ: يا أميرَ المُؤمِنينَ ألَا أُخبِرُكَ بمِثلِ هذا وأعجَبَ منه؟ قال: بلى. قال: فإنَّ رَجُلًا مِن هُذَيلٍ وَرِثَ فَخِذَه التي هو فيها، حتى لم يَبقَ منهم أحَدٌ غَيرُه، فجَمَعَ مالًا كَثيرًا فعَمَدَ إلى رَهطٍ مِن قَومِه، يُقالُ لهم: بَنو المُؤَمَّلِ، فجاوَرَهم لِيَمنَعوه، ولِيرُدُّوا عليه ماشِيَتَه، وإنَّهم حَسَدوه على مالِه ونَفَسوه مالَه، فجَعَلوا يَأكُلونَ مِن مالِه، ويَشتِمونَ عِرضَه، وأنَّه ناشَدَهمُ اللهَ والرَّحِمَ إلَّا عَدَلوا عنه ما يَكرَه، فأبَوْا عليه، فجَعَلَ رَجُلٌ منهم يُقالُ له: رَباحٌ، أو رياحٌ، يُكَلِّمُهم فيه، ويَقولُ: يا بَني المُؤَمَّلِ، ابنُ عَمَّتِكمُ اختارَ مُجاوَرَتَكم على مَن سِواكم، فأحسِنوا مُجاوَرَتَه، فأبَوْا عليه، فأمهَلَهم حتى إذا كانَ الشَّهرُ الحَرامُ دعا عليهم، فقال:\nاللَّهمَّ أزِلْ عَنِّي بَني المُؤَمَّلِ *** وارْمِ على أقفائِهم بمَنكِلِ\nبصَخرةٍ أو عَرضِ جَيشٍ جَحفَلِ *** إلَّا رَباحًا إنَّه لم يَفعَلِ\nقال: فبَينَما هم ذاتَ يَومٍ نُزولٌ إلى أصلِ جَبَلٍ انحَطَّتْ عليهم صَخرةٌ مِنَ الجَبَلِ، لا تَمُرُّ بشَيءٍ إلَّا طَحَنَتْه، حتى مَرَّتْ بأبياتِهم فطَحَنَتْها طَحنةً واحِدةً، إلَّا رَباحًا الذي استَثْناهُ. فقال: سُبحانَ اللهِ! إنَّ في هذا لَعِبرةً وعَجَبًا. فقالَ رَجُلٌ مِنَ القَومِ: ألَا أُخبِرُكَ يا أميرَ المُؤمِنينَ مِثلَه وأعجَبَ منه؟ قال: بلى. قال: فإنَّ رَجُلًا مِن جُهَينةَ جاوَرَ قَومًا مِن بَني ضَمرةَ في الجاهليَّةِ، وكانَ رَجُلٌ مِن بَني ضَمرةَ يُقالُ له: ريشةُ، يَعدو عليه، ",["فلا يَزالُ يَنحَرُ بَعيرًا مِن إبِلِه",1]," وإنَّه كَلَّمَ قَومَه فيه، فقالوا: إنَّا خَلَعْناه، فانظُرْ أنْ نَقتُلَه. فلَمَّا رآه لا يَنتَهي أمهَلَه حتى إذا كانَ الشَّهرُ الحَرامُ دَعا عليه، فقالَ:\nأصادِقٌ ريشةُ بلا ضَمرةْ *** أنْ يُسيِّرَ اللهُ عليه قَدَرَهْ\nأمَا يَزالُ شارِفٌ أو بَكْرَةْ *** يَطعُنُ منها في سَواءِ الثُّغرةْ\nبصارِمٍ ذي رَونَقٍ أو شَفرةْ *** اللَّهمَّ إنْ كان بَعدي فَجرَهْ\nفاجعَلْ أمامَ العَينِ منه حَذرَهْ *** يَأكُلُه حتى يُوافى الحُفرةْ\n",["فسَلَّطَ الله عليه أكَلةً فأكَلَتْه حتى ماتَ قَبلَ الحَولِ",2],". فقالَ عُمَرُ: سُبحانَ اللهِ! إنَّ في هذا لَعِبرةً وعَجَبًا، وإنْ كانَ اللهُ لَيَصنَعُ هذا بالناسِ في جاهليَّتِهم لِيَنزِعَ بَعضَهم مِن بَعضٍ، فلَمَّا أتى اللهُ بالإسلامِ أخَّرَ اللهُ العُقوبةَ إلى يَومِ القِيامةِ، وذلك أنَّ اللهَ تَعالى قالَ: {إِنَّ يَوْمَ الْفَصْلِ مِيقَاتُهُمْ أَجْمَعِينَ} [الدخان: 40]، {بَلِ السَّاعَةُ مَوْعِدُهُمْ وَالسَّاعَةُ أَدْهَى وَأَمَرُّ} [القمر: 46]، وقال: {وَلَوْ يُؤَاخِذُ اللَّهُ النَّاسَ بِظُلْمِهِمْ مَا تَرَكَ عَلَيْهَا مِنْ دَابَّةٍ وَلَكِنْ يُؤَخِّرُهُمْ إِلَى أَجَلٍ مُسَمًّى} [النحل: 61]."],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (3529) واللفظ له، وابن أبي الدنيا في ((مجابو الدعوة)) (20)، وابن عساكر في ((فضل رجب)) (4) بنحوه.","bab":"تفسير آيات › سورة الدخان","dorar":"5hVa44Z0"},{"id":"س-08435","fp":"7ce097ddeb14","stateId":596,"easy":"إذا ظلمت ← فاتقِ دعوة المظلوم فليس بينها وبين الله حجاب","cause":"اتَّقِ دعوةَ المظلومِ","result":"فإنَّها ليسَ بينَها وبينَ اللَّهِ حجابٌ","explicit":true,"star":true,"similar":["س-08045","س-05577","س-08026","س-08036"],"otherNeedIds":[29],"ref":"صحيح ابن خزيمة 4/ 101","srcLabel":"متفق عليه","text":["أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ لمَّا بعثَ معاذًا إلى اليمَنِ واليًا قالَ: إنَّكَ تأتي قَومًا مِن أَهْلَ كتابٍ، فادعُهُم إلى شَهادةِ أن لا إلَهَ إلَّا اللَّهُ، وأنِّي رسولُ اللَّهِ، فإذا هُم أطاعوا لذلِكَ فأعلِمهُم أنَّ اللَّهَ افترضَ عليهم خمسَ صلواتٍ في يومٍ وليلةٍ، فإن هم أطاعوا لذلِكَ، فأعلِمهُم أنَّ اللَّهَ افترضَ عليهم صدقةً في أموالِهِم تُؤخَذُ من أغنيائِهِم فتردُّ في فقرائِهِم فإن هم أطاعوا لذلِكَ، فإيَّاكَ وَكَرائمَ أموالِهِم، و",["اتَّقِ دعوةَ المظلومِ",1],"، ",["فإنَّها ليسَ بينَها وبينَ اللَّهِ حجابٌ",2]," . [وفي روايةٍ]: إنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ بعثَ معاذَ بنَ جبلٍ إلى اليمنِ فقالَ: ادعُهُم إلى شَهادةِ أن لا إلَهَ إلَّا اللَّهُ، وأنِّي رسولُ اللَّهِ، فإن هم أجابوا لذلِكَ، فأخبِرهُم أنَّ اللَّهَ افترضَ عليهم"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (4090)، ومسلم (19)، وأبو داود (1584) بلفظ مقارب","bab":"مناقب وفضائل › معاذ بن جبل","dorar":"QFwi9ZkE","merged":3,"otherRefs":["الفتح الرباني 1/402 (صحيح)","صحيح البخاري 4347 (صحيح)"]},{"id":"س-04924","fp":"f54961e6ac84","stateId":596,"easy":"إذا أخذت أموال الناس تريد إتلافها ← يتلفك الله","cause":"ومَن أخَذَها يُريدُ -يَعني- تَلَفَها","result":"أتلَفَه اللهُ","explicit":true,"star":true,"otherNeedIds":[3],"ref":"تخريج المسند لشعيب 9407","srcLabel":"البخاري","text":["مَن أخَذَ أموالَ النَّاسِ يُريدُ أداءَها، أدَّى اللهُ عنه، ",["ومَن أخَذَها يُريدُ -يَعني- تَلَفَها",1],"، ",["أتلَفَه اللهُ",2]," عزَّ وجلَّ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (2387) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"m1Lb2310"},{"id":"س-05268","fp":"c5b1ab25a79b","stateId":596,"easy":"إذا احتكرت على المسلمين طعامهم ← يضربك الله بالجذام والإفلاس","cause":"مِن احْتَكَرَ على المُسلِمينَ طَعامَهم","result":"ضَرَبَه اللهُ بالجُذامِ والفالِجِ","explicit":true,"star":true,"ref":"الأحاديث المختارة 263","srcLabel":"البخاري","text":["«خَرَجَ عُمَرُ بنُ الخَطَّابِ مِن المَسجِدِ فرأى طَعامًا مَزْبورًا، فقالَ: ما هذا الطَّعامُ؟ فقالوا: هذا طَعامٌ جُلِبَ إلينا، قالَ: بارَكَ اللهُ فيه وفيمَن جَلَبَه، قالوا: يا أميرَ المُؤمِنينَ، فإنَّه قد احْتُكِرَ، قالَ: مَن احْتَكَرَه؟ قالوا: فَرُّوخٌ مَوْلى عُثْمانَ، ومَوْلًى لعُمَرَ، فدَعاهما فقالَ: ما حَمَلَكما على احْتِكارِ طَعامِ المُسلِمينَ؟ فقالا: يا أميرَ المُؤمِنينَ نَشْتَري بأمْوالِنا ونَبيعُ في السُّوقِ، قالَ: فإنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["مِن احْتَكَرَ على المُسلِمينَ طَعامَهم",1]," ",["ضَرَبَه اللهُ بالجُذامِ والفالِجِ",2],".\nوقالَ: أمَّا فَرُّوخٌ فإنَّه قالَ: واللهِ لا أَبيعُ طَعامًا بَعْدَه ولا أَشْتَريه فتَحَوَّلَ إلى البَزِّ، وأمَّا مَوْلى عُمَرَ فثَبَتَ.\nقالَ أبو يَحْيى المَكِيُّ: فرَأيْتُه مَخْدوجًا مَجْذومًا»."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"mGIQkkDT"},{"id":"س-07553","fp":"4ef3278de869","stateId":596,"easy":"إذا وليت أمر الأمة فشققت عليهم ← يشقق الله عليك","cause":"مَن وليَ مِن أمرِ أُمَّتي شيئًا فشَقَّ عليهم","result":"فاشقُقْ عليه","explicit":true,"otherNeedIds":[60],"ref":"صحيح مسلم 1828","srcLabel":"متفق عليه","text":["أتَيتُ عائِشةَ أسألُها عن شَيءٍ، فقالت: مِمَّن أنتَ؟ فقُلتُ: رَجُلٌ مِن أهلِ مِصرَ، فقالت: كيفَ كان صاحِبُكُم لَكُم في غَزاتِكُم هذه؟ فقال: ما نَقَمنا منه شيئًا، إن كان لَيَموتُ للرَّجُلِ مِنَّا البَعيرُ فيُعطيه البَعيرَ، والعَبدُ فيُعطيه العَبدَ، ويَحتاجُ إلى النَّفَقةِ فيُعطيه النَّفَقةَ، فقالت: أما إنَّه لا يَمنَعُني الذي فعَلَ في مُحَمَّدِ بنِ أبي بَكرٍ أخي أن أُخبِرَكَ ما سَمِعتُ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ في بَيتي هذا: اللَّهُمَّ ",["مَن وليَ مِن أمرِ أُمَّتي شيئًا فشَقَّ عليهم",1]," ",["فاشقُقْ عليه",2],"، ومَن وليَ مِن أمرِ أُمَّتي شيئًا فرَفَقَ بهِم فارفُقْ به."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"فضائل النبي وصفته ودلائل النبوة › دعاء النبي لبعض الناس","dorar":"QcPWwUvF"},{"id":"س-08045","fp":"cbf75e8f0cac","stateId":596,"easy":"إذا ظلمت ← فاتقِ دعوة المظلوم ولو كان كافراً","cause":"اتَّقوا دَعوةَ المَظْلومِ وإن كانَ كافِرًا","result":"فإنَّه ليس دونَه حِجابٌ","explicit":true,"repOf":"س-08435","otherNeedIds":[29],"ref":"الأحاديث المختارة 2747","text":["«",["اتَّقوا دَعوةَ المَظْلومِ وإن كانَ كافِرًا؛ ",1],["فإنَّه ليس دونَه حِجابٌ»",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"مظالم › تحريم الظلم","dorar":"gy8yWcpg"},{"id":"س-00454","fp":"2d4671bbbff9","stateId":596,"easy":"إذا ماطلت وأنت واجد ← يحل عرضك وعقوبتك","cause":"ليُّ الواجِدِ","result":"ظُلمٌ يُحِلُّ عِرْضَه وعُقوبَتُه","explicit":true,"otherNeedIds":[44],"ref":"نيل المرام 394","srcLabel":"نيل المرام","text":["«",["ليُّ الواجِدِ",1]," ",["ظُلمٌ يُحِلُّ عِرْضَه وعُقوبَتُه",2],"»"],"grade":"صحيح","muhaddith":"ثابت.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"csMVnFlv","merged":2,"otherRefs":["الجامع الصغير 7724 (صحيح)"]},{"id":"س-05577","fp":"68e372e5609b","stateId":596,"easy":"إذا ظلمت ← فاحذر دعوة المظلوم فإنها تُستجاب","cause":"دعواتِ المظلومِ","result":"فإنَّها تُستجابُ","explicit":true,"repOf":"س-08435","otherNeedIds":[29],"ref":"المطالب العالية 3/347","text":["شهدتُّ أبَا الدرداءِ رضي اللهُ عنه حينَ حضَرَهُ المَوْتُ ، فقالَ: إني محدِّثُكم حديثًا سمعتُه من رسولِ الله صلَّى اللهُ عليه وسلَّم يقولُ: اعبدِ اللهَ – تعالى – كأنكَ تراهُ ، فإن لم تكن تراهُ فإنه يراكَ ، وعُدَّ نفسَكَ في المَوْتَى ، واتَّقِ ",["دعواتِ المظلومِ",1]," ",["فإنَّها تُستجابُ",2]," ، ومن استطاع منكم أن يشهدَ العِشَاءَ الآخرةَ وصلاةَ الغداةِ في جماعةٍ فليفعلْ ولو حَبْوًا"],"grade":"صحيح","narrator":"رجل من النخع","muhaddith":"صحيح لولا المبهم","takhrij":"أخرجه ابن عساكر في ((تاريخ دمشق)) (68/ 112) باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"icCrh1nl","merged":2,"otherRefs":["الترغيب والترهيب 4/202 (صحيح)"]},{"id":"س-08026","fp":"92c22d16844f","stateId":596,"easy":"إذا ظلمت ← فاتقِ دعوة المظلوم فإنها تصعد إلى السماء كأنها شرارة","cause":"اتَّقُوا دعوةَ المظلومِ","result":"فإنَّها تَصْعَدُ إلى السَّماءِ كأنَّها شَرَارَةٌ","explicit":true,"repOf":"س-08435","otherNeedIds":[29],"ref":"صحيح الترغيب 2228","text":[["اتَّقُوا دعوةَ المظلومِ ؛ ",1],["فإنَّها تَصْعَدُ إلى السَّماءِ كأنَّها شَرَارَةٌ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (81)، والديلمي (307)","bab":"مظالم › تحريم الظلم","dorar":"sB3HOK4r"},{"id":"س-01621","fp":"f645a70bee6e","stateId":596,"easy":"إذا شبعت وجارك جائع ← يعاقبك الله (من قصة يعقوب)","cause":"وذبحتَ أنت وأهلُك شاةً فأكلتموها ولم تطعِموه","result":"أتدري لم أذهبتُ بصرَك وحنَيْتُ ظهرَك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[23],"ref":"الترغيب والترهيب 3/316","srcLabel":"الحاكم","text":["أنَّ رجلًا قال ليعقوبَ عليه السَّلامُ ما الَّذي أذهب بصرَك وحنَى ظهرَك قال أمَّا الَّذي أذهب بصري فالبكاءُ على يوسفَ وأمَّا الَّذي حنَى ظهري فالحزنُ على أخيه بنيامينَ فأتاه جبريلُ عليه السَّلامُ فقال أتشكو اللهَ عزَّ وجلَّ قال إنَّما أشكو بثِّي وحُزني إلى اللهِ قال جبريلُ عليه السَّلامُ اللهُ أعلمُ بما قلتَ منك قال ثمَّ انطلق جبريلُ عليه السَّلامُ ودخل يعقوبُ عليه السَّلامُ بيتَه فقال أيْ ربِّ أما ترحمُ الشَّيخَ الكبيرَ أذهبتَ بصري وحنَيْتَ ظهري فاردُدْ عليَّ ريحانتَيَّ فأشُمَّهما شمَّةً واحدةً ثمَّ اصنَعْ بي بعد ما شئتَ فأتاه جبريلُ فقال يا يعقوبُ إنَّ اللهَ عزَّ وجلَّ يُقرِئُك السَّلامَ ويقولُ أبشِرْ فإنَّهما لو كانا ميِّتَيْن لنشرتُهما لك لأُقِرَّ بهما عينَك ويقولُ لك يا يعقوبُ ",["أتدري لم أذهبتُ بصرَك وحنَيْتُ ظهرَك",2]," ولِمَ فعل إخوةُ يوسفَ بيوسفَ ما فعلوه قال لا قال إنَّه أتاك يتيمٌ مسكينٌ وهو صائمٌ جائعٌ ",["وذبحتَ أنت وأهلُك شاةً فأكلتموها ولم تطعِموه",1]," ويقولُ إنِّي لم أحبَّ شيئًا من خلقي حبِّي اليتامَى والمساكينَ فاصنَعْ طعامًا وادْعُ المساكينَ قال أنسٌ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فكان يعقوبُ كلَّما أمسَى نادَى مناديه من كان صائمًا فليحضُرْ طعامَ يعقوبَ وإذا أصبح نادَى مناديه من كان مُفطرًا فليفطِرْ على طعامِ يعقوبَ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((الأوسط)) (6/170)، ووالحاكم (2/378)، والبيهقي في ((الشعب)) (3/230) باختلاف يسير.","bab":"أطعمة › إطعام الطعام","dorar":"DmIQUj0a"},{"id":"س-04835","fp":"372575ce34c7","stateId":596,"easy":"إذا أضررت بأحد ← يضرّ الله بك","cause":"من ضارَّ","result":"ضارَّ اللهُ به","explicit":true,"ref":"صحيح الجامع 6372","srcLabel":"أبو داود","text":[["من ضارَّ ، ",1],["ضارَّ اللهُ به",2]," ، و من شاقَّ ، شاقَّ اللهُ عليه"],"grade":"حسن","narrator":"أبو صرمة مالك بن قيس المازني","muhaddith":"حسن","takhrij":"أخرجه أبو داود (3635)، والترمذي (1940) واللفظ له، وابن ماجه (2342)، وأحمد (15755)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"mRTQPa2f"},{"id":"س-08036","fp":"69f90839d90a","stateId":596,"easy":"إذا ظلمت ← فاتقِ دعوة المظلوم فإنما يسأل الله حقه","cause":"اتَّقِ دعوةَ المظلومِ","result":"فإنَّما يسألُ اللهَ حقَّه ، وإنَّ اللهَ لم يمنعْ ذا حقٍّ حقَّه","explicit":true,"repOf":"س-08435","ref":"حلية الأولياء 3/235","text":["يا عليُّ ! ",["اتَّقِ دعوةَ المظلومِ ، ",1],["فإنَّما يسألُ اللهَ حقَّه ، وإنَّ اللهَ لم يمنعْ ذا حقٍّ حقَّه",2]],"grade":"حسن","narrator":"علي بن علي بن أبي طالب","muhaddith":"غريب من حديث جعفر بن محمد عن آبائه متصلا تفرد به منصور عن صالح عنه","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (7464) والخطيب في ((الموضح)) (223) والديلمي في ((مسند الفردوس)) كما في ((الغرائب الملتقطة)) (1047) باختلاف يسير.","bab":"مظالم › تحريم الظلم","dorar":"07da3Syq"},{"id":"س-07336","fp":"2ad0e4a112d3","stateId":597,"easy":"إذا تعلقت بالدينار والدرهم ← أهلكا من قبلكم وهما مهلكاكم","cause":"إنَّ هذا الدِّينارَ و الدِّرْهَمَ","result":"أَهْلكَا مَنْ كان قبلَكُمْ ، و هُما مُهْلِكَاكُمْ","explicit":true,"star":true,"ref":"السلسلة الصحيحة 1703","srcLabel":"مسلم","text":[["إنَّ هذا الدِّينارَ و الدِّرْهَمَ",1]," ",["أَهْلكَا مَنْ كان قبلَكُمْ ، و هُما مُهْلِكَاكُمْ",2]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه المخلص في ((المخلصيات)) (2368) واللفظ له، وأخرجه ابن حبان (694)، والطبراني في ((المعجم الأوسط)) (2022) باختلاف يسير","bab":"فتن › فتنة المال","dorar":"2INriEJr","merged":3,"otherRefs":["صحيح الجامع 2245 (صحيح)","صحيح الترغيب 3258 (صحيح)"]},{"id":"س-00275","fp":"411aa20b3990","stateId":597,"easy":"إذا أكلت طعام البخيل ← فهو داء","cause":"طَعامُ البَخيلِ","result":"داءٌ","explicit":true,"ref":"الأحكام الوسطى 4/ 146","srcLabel":"الأحكام الوسطى","text":[["طَعامُ البَخيلِ",1]," ",["داءٌ",2],"، وطَعامُ السَّخِيِّ شِفاءٌ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"S4rnQbbf"},{"id":"س-00383","fp":"066f31b337f5","stateId":597,"easy":"إذا شححت ← فالشح أهلك من قبلكم أمرهم بالظلم والقطيعة والفجور","cause":"إيَّاكم والشُّحَّ","result":"فإنَّه أهلَكَ مَن كان قبلَكم، أمَرَهم بالظُّلمِ فظلَموا، وأمَرَهم بالقَطيعةِ فقطَعوا، وأمَرَهم بالفُجورِ ففجَروا، وإيَّاكم والظُّلمَ؛ فإنَّ الظُّلمَ ظُلماتٌ يومَ القيامةِ، وإيَّاكم والفُحشَ؛ فإنَّ اللهَ لا يحِبُّ الفُحشَ","explicit":true,"similar":["س-00440"],"otherNeedIds":[13,27],"ref":"تخريج المسند لشعيب 6792","srcLabel":"أبو داود","text":[["إيَّاكم والشُّحَّ؛ ",1],["فإنَّه أهلَكَ مَن كان قبلَكم، أمَرَهم بالظُّلمِ فظلَموا، وأمَرَهم بالقَطيعةِ فقطَعوا، وأمَرَهم بالفُجورِ ففجَروا، وإيَّاكم والظُّلمَ؛ فإنَّ الظُّلمَ ظُلماتٌ يومَ القيامةِ، وإيَّاكم والفُحشَ؛ فإنَّ اللهَ لا يحِبُّ الفُحشَ",2]," ولا التَّفحُّشَ، قال: فقام إليه رَجُلٌ، فقال: يا رسولَ اللهِ، أَيُّ المُسلمينَ أفضلُ؟ قال: مَن سلِمَ المُسلمونَ مِن لِسانِه ويدِه، قال: فقام هو أو آخَرُ، فقال: يا رسولَ اللهِ، أَيُّ الجهادِ أفضلُ؟ قال: مَن عُقِرَ جَوادُه، وأُهريقَ دَمُه.\n[قال عبدُ اللهِ بنُ أحمدَ]: قال أبي: وقال يزيدُ بنُ هارونَ في حديثِه: ثُمَّ ناداه هذا أو غيرُه، فقال: يا رسولَ اللهِ، أَيُّ الهِجرةِ أفضلُ؟ قال: أنْ تهجُرَ ما كرِهَ ربُّكَ، وهما هِجرتانِ: هِجرةٌ لِلبادي، وهِجرةٌ لِلحاضرِ، فأمَّا هِجرةُ البادي: فيُطيعُ إذا أُمِرَ، ويُجيبُ إذا دُعيَ، وأمَّا هِجرةُ الحاضرِ: فهي أشدُّهما بَليَّةً، وأعظمُهما أَجرًا."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1698)، والنسائي في ((السنن الكبرى)) (11583) مختصراً، وأحمد (6792) واللفظ له","bab":"آداب عامة › الأخلاق المذمومة","dorar":"V9A7Jpxn"},{"id":"س-00411","fp":"23be03d6ecaf","stateId":597,"easy":"إذا بخلت ← فالبخل دعا قوماً فمنعوا زكاتهم وقطعوا أرحامهم وسفكوا دماءهم","cause":"إياكم والبخلُ","result":"فإنَّ البخلَ دعا قومًا فمنعوا زكاتَهم ودعاهم فقطعوا أرحامَهم ودعاهم فسفكوا دماءَهم","explicit":true,"ref":"مسند عمر 1/105","srcLabel":"أحمد","text":[["إياكم والبخلُ ",1],["فإنَّ البخلَ دعا قومًا فمنعوا زكاتَهم ودعاهم فقطعوا أرحامَهم ودعاهم فسفكوا دماءَهم",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (9569)، وابن حبان (5177) بنحوه.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"bYiKzVmY"},{"id":"س-00440","fp":"f0dea4864e6a","stateId":597,"easy":"إذا شححت ← فالشح أهلك الأمم قبلكم","cause":"إياكم والشحُّ","result":"فإنَّهُ أهلكَ من كان قبلكم من الأممِ دعاهم فسفكوا دماءَهم ودعاهم فقتلوا أولادَهم","explicit":true,"repOf":"س-00383","ref":"مسند عمر 1/105","text":[["إياكم والشحُّ ",1],["فإنَّهُ أهلكَ من كان قبلكم من الأممِ دعاهم فسفكوا دماءَهم ودعاهم فقتلوا أولادَهم",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (9569)، وابن حبان (5177) بنحوه.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"T83o0cjd"},{"id":"س-01603","fp":"d6a433ff2b69","stateId":597,"easy":"إذا دعوت الأغنياء ومنعت الفقراء ← فطعامك شر الطعام","cause":"يُدعَى إليها من يَأْبَاها ويُمنعُ منها من يَأْتِيها","result":"شَرُّ الطعامِ طعامُ الوليمةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"otherNeedIds":[13],"ref":"إرواء الغليل 7/4","srcLabel":"متفق عليه","text":["كان أبو هريرةَ يُدْعَى إلى طعامٍ فيذهبُ إليهِ ونذهبُ معهُ فيُنادي ",["شَرُّ الطعامِ طعامُ الوليمةِ",2]," ",["يُدعَى إليها من يَأْبَاها ويُمنعُ منها من يَأْتِيها",1]],"grade":"حسن","narrator":"ميمون بن ميسرة","muhaddith":"رجاله ثقات معروفون غير ميمون بن ميسرة","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (3016) واللفظ له، وسعيد بن منصور في ((سننه)) (526) بنحوه، والبخاري (5177)، ومسلم (1432) وزادا:\"فمن لم يجب فقد عصى الله ورسوله\".","bab":"أطعمة › إجابة الدعوة","dorar":"FZjzjNSa"},{"id":"س-01774","fp":"f20d855a90d8","stateId":598,"easy":"إذا تبخترت في مشيتك ← يغضب الله عليك وقد يخسف بك","cause":"يتبَختَرُ بَينَ بُردَيْنِ","result":"فغضِبَ اللهُ عليه، فأمَرَ الأرضَ فبلَعَتْهُ، فوالذي نَفْسي بيَدِهِ؛ إنَّهُ ليتجَلجَلُ إلى يَومِ القيامةِ","explicit":true,"star":true,"otherNeedIds":[64],"ref":"تخريج المسند لشعيب 10455","srcLabel":"متفق عليه","text":["بينا رَجُلٌ ممَّن كان قَبلَكم، ",["يتبَختَرُ بَينَ بُردَيْنِ",1],"، ",["فغضِبَ اللهُ عليه، فأمَرَ الأرضَ فبلَعَتْهُ، فوالذي نَفْسي بيَدِهِ؛ إنَّهُ ليتجَلجَلُ إلى يَومِ القيامةِ",2],". اذهَبْ أيُّها الرَّجُلُ إلى يَومِ القيامةِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه من طرق البخاري (5789)، ومسلم (2088)، والنسائي في ((السنن الكبرى)) (9679)، وأحمد (10455) واللفظ له","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"m4ThKEwB"},{"id":"س-04818","fp":"7ac09e4f93d1","stateId":598,"easy":"إذا دعوت على نفسك أو أولادك أو مالك ← قد توافق ساعة إجابة فيُستجاب لك","cause":"لا تَدعوا على أنفُسِكُم، ولا تَدعوا على أولادِكُم، ولا تَدعوا على أموالِكُم","result":"لا توافِقوا مِنَ اللهِ ساعةً يُسألُ فيها عَطاءٌ فيَستَجيبُ لَكُم","explicit":true,"star":true,"ref":"صحيح مسلم 3009","srcLabel":"مسلم","text":["سِرنا مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةِ بَطنِ بواطٍ، وهو يَطلُبُ المَجديَّ بنَ عَمرٍو الجُهَنيَّ، وكان النَّاضِحُ يَعتَقِبُه مِنَّا الخَمسةُ والسِّتَّةُ والسَّبعةُ، فدارَت عُقبةُ رَجُلٍ مِنَ الأنصارِ على ناضِحٍ له، فأناخَه فرَكِبَه، ثُمَّ بَعَثَه فتَلَدَّنَ عليه بَعضَ التَّلَدُّنِ، فقال له: شَأ، لَعَنَكَ اللهُ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: مَن هذا اللَّاعِنُ بَعيرَه؟ قال: أنا، يا رَسولَ اللهِ، قال: انزِلْ عنه، فلا تَصحَبنا بمَلعونٍ، ",["لا تَدعوا على أنفُسِكُم، ولا تَدعوا على أولادِكُم، ولا تَدعوا على أموالِكُم",1],"، ",["لا توافِقوا مِنَ اللهِ ساعةً يُسألُ فيها عَطاءٌ فيَستَجيبُ لَكُم",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (3009).","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"1sojxw0Q"},{"id":"س-08249","fp":"97c939f0c25e","stateId":598,"easy":"إذا مشيت معجباً بنفسك ← قد يخسف الله بك","cause":"يَمشي في حُلَّةٍ قد أَعجَبتْهُ نفسُه","result":"خَسف اللهُ تعالى بهِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[64,27],"ref":"المطالب العالية 4/221","srcLabel":"مسلم","text":["دخلتِ امرأَةٌ النَّارَ في هِرَّةٍ . . الحَديثَ . وفيه : [ ويَشْهَدُ ] على ذلكَ أبو بكرٍ وعمرُ وليسَ ثَمَّةَ أبو بكرٍ ولا عُمرُ قال صلَّى اللهُ عليهِ وسلَّمَ : وبينَما رجلٌ في غَنمِه إذْ جاءهُ الذئْبُ ، فأخذ شاةً . . الحديثَ . وفيه : ويَشْهدُ علَى ذلكَ أبو بَكرٍ وعُمَرُ رضيَ الله عنهُما مِثلَهُ . وبينَما رجلٌ راكِبٌ بَقرةً . . الحديثُ . وفيه : ويَشْهدُ على ذلكَ أبو بكرٍ وعمرُ ، وليسَ ثَمَّةَ أبو بكرٍ ولا عمرُ رضيَ الله عنهُما . قال : وبينَما رُجلٌ ",["يَمشي في حُلَّةٍ قد أَعجَبتْهُ نفسُه",1]," ",["خَسف اللهُ تعالى بهِ",2]," . . الحديثَ . قال : وفيهِ : يَشْهَدُ علَى ذلكَ أبو بكرٍ وعمرُ وليسَ ثَمَّةَ أبو بَكرٍ ولا عُمرُ رضيَ اللهُ عنهُما ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أصله في الصحيح وغيره متفرقا","takhrij":"أخرجه مسلم (2619)، وابن ماجه (4256)، وأحمد (7547)  مقتصرا على قصة الهرة دون بقية الحديث","bab":"مناقب وفضائل › أبو بكر الصديق","dorar":"vKXlyWhw","merged":15,"otherRefs":["السلسلة الصحيحة 4/12 (حسن)","صحيح الجامع 2875 (صحيح)","مجمع الزوائد 5/129 (صحيح)","تخريج المسند لشعيب 7074 (صحيح)","صحيح مسلم 2088 (صحيح)","اجتماع الجيوش الإسلامية 52 (صحيح)","تخريج المسند لشعيب 10383 (صحيح)","تخريج المسند لشعيب 11356 (صحيح)","أحكام القرآن لابن العربي 3/530 (صحيح)","صحيح الترمذي 2491 (صحيح)","الترغيب والترهيب 4/41 (صحيح)","تنبيه الغافلين 216 (صحيح)","تخريج صحيح ابن حبان 5684 (صحيح)"]},{"id":"س-05694","fp":"11947567b997","stateId":598,"easy":"إذا دعت عليك أمك ← قد تُستجاب (من قصة جريج)","cause":"يا ربِّ أمي وصلاتي، فأقبَل على صلاتِه","result":"اللهم لا تُمِتْه حتى يَرى أو ينظُرَ في وُجوهِ المومِساتِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[44],"ref":"الآداب للبيهقي 477","srcLabel":"متفق عليه","text":["لم يتكلَّمْ في المهدِ إلا ثلاثةٌ : عيسى بنُ مريمَ، قال : وكان في بني إسرائيلَ رجلٌ يُقالُ له : جُرَيجٌ وكان عابدًا، فابتَنى صومَعةً فجعَل يصلِّي فيها، فأتَتْه أمُّه فقالتْ : يا جُرَيْجُ، فقال : ",["يا ربِّ أمي وصلاتي، فأقبَل على صلاتِه",1]," فانصرفَتْ، ثم جاءَتْ يومًا آخَرَ ففعَل مثلَ ذلك، ثم جاءتْه يومًا ثالثًا ففعَل مثلَ ذلك، فقالتْ أمُّه : ",["اللهم لا تُمِتْه حتى يَرى أو ينظُرَ في وُجوهِ المومِساتِ",2]," . قال : فذكَر يومًا بنو إسرائيلَ جُرَيجًا وفضلَه فقالتْ بغِيٌّ من بَغايا بني إسرائيلَ : إن شئتُم لأفتنَنَّه لكم، فقالوا : قد شئنا، فانطلقَتْ فتعرضَتْ لجُرَيجٍ فلم يلتفِتْ إليها، فأتَتْ راعيًا وكان يأوي إلى صومعَةِ جُرَيجٍ بغنمِه فأمكنَتْه من نفسِها فحملَتْ فولدَتْ غُلامًا، فقالتْ : هو من جُرَيجٍ، فأتاه بنو إسرائيلَ فضرَبوه وشتَموه وهدَموا صَومعتَه، فقال : ما شأنُكم ؟ فقالوا : زنَيتَ بهذه البغِيِّ وولدَتْ غُلامًا . قال : فأينَ الغُلامُ ؟ قال : فجيءَ به فقام وصلَّى ودعا ثم انصرَف إلى الغُلامِ فطعَنه بإصبَعِه وقال : باللهِ يا غُلامُ مَن أبوك ؟ قال : أبي الراعي . قال : فوثَب الناسُ إليه فجعَلوا يُقَبِّلونَه وقالوا : نبني صومعتَك من ذهبٍ . قال : لا حاجةَ لي في ذلك ابنوها كما كانتْ . قال : وبينا امرأةٌ جالسةٌ وفي حَجرِها ابنٌ لها تُرضِعُه إذ مرَّ بها راكبٌ ذو شارَةٍ، فقالتْ : اللهم اجعَلِ ابني مثلَ هذا، فترَك ثديَها ثم أقبَل إلى الراكبِ فنظَر إليه فقال : اللهم لا تجعَلْني مثلَ هذا، ثم أقبَل على ثديِها يمُصُّه . قال أبو هُرَيرَةَ : لكأني أنظُرُ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم يحكي مصَّه ووضْعَ إصبَعِه في فيه فجعَل يمُصُّها . ثم مرَّ بأَمةٍ معَها الناسُ تضرِبُها فقالتْ : اللهم لا تجعَلْ ابني مثلَ هذه، فترَك ثديَها ثم نظَر إليها وقال : اللهم اجعَلْني مثلَها . فعِندَ ذلك تراجَعا الحديثَ فقالتْ : خلفي أي بني مرَّ بي الراكبُ ذو شارَةٍ فقلتُ : اللهم اجعَلِ ابني مثلَ هذا، قلتَ : اللهم لا تجعلني مثلَه، ثم مرَّ بي هذه الأَمةُ فقلتُ : اللهم لا تجعَلِ ابني مثلَ هذه الأَمةِ، فقلتُ : اللهم اجعَلْني مثلَها . فقال : يا أُمَّتاه إن الراكبَ الذي مرَّ بكِ جبَّارٌ فدعوتِ اللهَ أن يجعلَني مثلَه، فقلتُ : اللهم لا تجعَلْني مثلَه . وهذه يقولونَ سَرقَتْ، ولم تسرِقْ، وزنَتْ، ولم تزْنِ وهي تقولُ : حسبيَ اللهُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (3436)، ومسلم (2550)، وأحمد (8071)، والبيهقي في ((الآداب)) (764) واللفظ له","bab":"رقائق وزهد › الكبر والتواضع","dorar":"in6ZBEq7","merged":2,"otherRefs":["صحيح البخاري 3436 (صحيح)"]},{"id":"س-08284","fp":"551b1d85e4ec","stateId":598,"easy":"إذا لعنت راحلتك ← تُترك (فإنها ملعونة)","cause":"لعَنَتْ راحلتَها","result":"ضَعُوا عنها فإنَّها ملعونةٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج صحيح ابن حبان 5741","srcLabel":"مسلم","text":["بيْنَما رسولُ اللهِ صلَّى اللهُ عليه وسلَّم في بعضِ أسفارِه إذ سمِع لعنةً فقال: مَن هذا ؟ فقيل: هذه فلانةُ ",["لعَنَتْ راحلتَها",1]," فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( ",["ضَعُوا عنها فإنَّها ملعونةٌ",2]," ) قال: فوُضِع عنها قال عِمرانُ: فكأنِّي أنظُرُ إليها ناقةً وَرْقاءَ"],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2595) باختلاف يسير","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"Oyb1qz9H","merged":2,"otherRefs":["تخريج صحيح ابن حبان 5740 (صحيح)"]},{"id":"س-00394","fp":"f3d7e56dc8d3","stateId":598,"easy":"إذا أظهرت الشماتة بأخيك ← يرحمه الله ويبتليك","cause":"لا تُظهِرِ الشَّماتةَ على أخيك","result":"فيَرحَمُه اللهُ ويَبْتَليك","explicit":true,"similar":["س-03166"],"ref":"الأحكام الوسطى 4/ 248","srcLabel":"الترمذي","text":["\"",["لا تُظهِرِ الشَّماتةَ على أخيك",1],"؛ ",["فيَرحَمُه اللهُ ويَبْتَليك",2],"\"."],"grade":"صحيح","narrator":"واثلة بن الأسقع الليثي أبو فسيلة","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه الترمذي (2506)، والطبراني في ((الأوسط)) (3739)، وابن الأعرابي في ((معجمه)) (1612) واللفظ لهم.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"AeCSUW0f","merged":2,"otherRefs":["الترغيب والترهيب 3/287 (صحيح)"]},{"id":"س-05190","fp":"214a0734f698","stateId":598,"easy":"إذا سببت الموتى ← فأنت كالمشرف على الهلكة","cause":"سِبابُ الميِّتِ وقال مرَّةً الموتى","result":"كالمُشرِفَ على الهَلَكةِ","explicit":true,"otherNeedIds":[13],"ref":"مجمع الزوائد 8/79","srcLabel":"الطبراني","text":[["سِبابُ الميِّتِ وقال مرَّةً الموتى",1]," ",["كالمُشرِفَ على الهَلَكةِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه البزار كما في ((سلسلة الأحاديث الصحيحة)) للألباني (4/377)، والطبراني (13/527) (14411) واللفظ له، والديلمي في ((الفردوس)) (3530).","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"LvYZfmmE","merged":2,"otherRefs":["الجامع الصغير 4597 (صحيح)"]},{"id":"س-00281","fp":"eb049f4910ad","stateId":598,"easy":"إذا عنفت ← فالخرق شؤم","cause":"وإنَّ الخُرقَ","result":"شُؤمٌ","explicit":true,"ref":"المصابيح في الأحاديث المتواترة 592","srcLabel":"المصابيح في الأحاديث المتواترة","text":["إنَّ الرِّفقَ يُمنٌ، ",["وإنَّ الخُرقَ",1]," ",["شُؤمٌ",2],"، وإنَّ اللهَ إذا أراد بأهلِ بَيتٍ خيرًا أدخل عليهم بابَ الرِّفقِ؛ وإنَّ الرِّفقَ لم يكُنْ في شيءٍ إلَّا زانه، وإنَّ الخُرقَ لم يكُنْ في شيءٍ إلَّا شانه"],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"l5YQX3WT"},{"id":"س-00611","fp":"c75d4d7352d7","stateId":598,"easy":"إذا ختلت الدنيا بالدين ولبست للناس جلود الضأن ← يبعث الله عليك فتنة تدع الحليم حيران","cause":"يختلونَ الدُّنيا بالدِّينِ يَلبسونَ للنَّاسِ جلودَ الضَّأنِ منَ اللِّينِ ، ألسنتُهُم أحلَى منَ العسلِ ، وقلوبُهُم قلوبُ الذِّئابِ","result":"لأبعثنَّ علَى أولئِكَ منهُم فتنةً تدعُ الحليمَ حيرانَ","explicit":true,"otherNeedIds":[33],"ref":"الترغيب والترهيب 1/50","srcLabel":"الترمذي","text":["يخرجُ في آخرِ الزَّمانِ رجالٌ ",["يختلونَ الدُّنيا بالدِّينِ يَلبسونَ للنَّاسِ جلودَ الضَّأنِ منَ اللِّينِ ، ألسنتُهُم أحلَى منَ العسلِ ، وقلوبُهُم قلوبُ الذِّئابِ",1]," ، يقولُ اللَّهُ عزَّ وجلَّ : أبي يغترُّونَ ، أم عليَّ يجترِئونَ ؟ فبي حلفتُ ",["لأبعثنَّ علَى أولئِكَ منهُم فتنةً تدعُ الحليمَ حيرانَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (2404)، وابن المبارك في ((الزهد والرقائق)) (50)، وهناد في ((الزهد)) (2/437) باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"pP8JNQUb"},{"id":"س-07397","fp":"15e458c8df57","stateId":598,"easy":"إذا دعوت بتعجيل العقوبة في الدنيا ← قد تهلك (فلا تدعُ بها)","cause":"اللَّهُمَّ ما كُنتَ مُعاقِبي به في الآخِرةِ فعَجِّلْه لي في الدُّنيا","result":"قد خَفَتَ فصارَ مِثلَ الفَرخِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[35,29],"ref":"صحيح مسلم 2688","srcLabel":"النسائي","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم عادَ رَجُلًا مِنَ المُسلِمينَ ",["قد خَفَتَ فصارَ مِثلَ الفَرخِ",2],"، فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: هل كُنتَ تَدعو بشَيءٍ، أو تَسألُه إيَّاهُ؟ قال: نَعَم، كُنتُ أقولُ: ",["اللَّهُمَّ ما كُنتَ مُعاقِبي به في الآخِرةِ فعَجِّلْه لي في الدُّنيا",1],"، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: سُبحانَ اللهِ! لا تُطيقُه -أو لا تَستَطيعُه- أفلا قُلتَ: اللَّهُمَّ آتِنا في الدُّنيا حَسَنةً، وفي الآخِرةِ حَسَنةً، وقِنا عَذابَ النَّارِ، قال: فدَعا اللهَ له، فشَفاهُ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه عبد بن حميد (1397)، والنسائي في ((السنن الكبرى)) (10825)، وأبو يعلى (3759) جميعهم باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › إجابة دعاء النبي","dorar":"4t47yqMQ","merged":3,"otherRefs":["تخريج المسند لشعيب 14067 (صحيح)","علل ابن أبي حاتم 2071 (صحيح)"]},{"id":"س-03166","fp":"ec61cedb8fc9","stateId":598,"easy":"إذا أظهرت الشماتة بأخيك ← يعافيه الله ويبتليك","cause":"لا تُظْهِرِ الشَّماتةَ بأخيكَ","result":"فيُعافيَهُ اللَّهُ ويَبتليَكَ","explicit":true,"repOf":"س-00394","ref":"النقد الصحيح للعلائي 40","text":[["لا تُظْهِرِ الشَّماتةَ بأخيكَ",1],"؛ ",["فيُعافيَهُ اللَّهُ ويَبتليَكَ",2],"."],"grade":"حسن","narrator":"واثلة بن الأسقع الليثي أبو فسيلة","muhaddith":"[حسن غريب]","takhrij":"أخرجه الخرائطي في ((اعتلال القلوب)) (813) واللفظ له، وأخرجه الترمذي (2506)، والطبراني (22/53) (127) باختلاف يسير","bab":"إيمان › توحيد الأسماء والصفات","dorar":"bLr6o4Lg","merged":2,"otherRefs":["مختصر المقاصد 1184 (حسن)"]},{"id":"س-00509","fp":"30b0447a7b30","stateId":598,"easy":"إذا كان لسانك أحلى من العسل وقلبك أمرّ من الصبر ← يبعث الله عليك فتنة تدع الحليم حيران","cause":"ألسِنَتُهم أحْلى مِن العسَلِ، وقُلوبُهم أمَرُّ مِن الصَّبْرِ","result":"لَأُتِيحَنَّهم فِتنةً تدَعُ الحليمَ منهم حَيرانًا","explicit":true,"otherNeedIds":[33],"ref":"سنن الترمذي 2405","srcLabel":"الطبراني","text":["إنَّ اللهَ تعالى قال: لقد خلَقْتُ خلْقًا ",["ألسِنَتُهم أحْلى مِن العسَلِ، وقُلوبُهم أمَرُّ مِن الصَّبْرِ",1],"، فَبِي حلَفْتُ: ",["لَأُتِيحَنَّهم فِتنةً تدَعُ الحليمَ منهم حَيرانًا",2],"؛ فَبِي يغترُّونَ أمْ عليَّ يجْتَرِئونَ؟!"],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن غريب","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (8931)، والديلمي في ((الفردوس)) (4473) باختلاف يسير","bab":"آداب عامة › ضرب الأمثال","dorar":"C1R0AY3s"},{"id":"س-04858","fp":"64d9d0b4cc6b","stateId":598,"easy":"إذا لعنت ناقتك ← قد يُستجاب فيها","cause":"فلعَن رجلٌ ناقةً","result":"أخِّرْها فقد أُجِبْتَ فيها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 8/80","srcLabel":"النسائي","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّم في مسيرٍ ",["فلعَن رجلٌ ناقةً",1]," فقال أين صاحبُ النَّاقةِ فقال الرَّجلُ أنا فقال ",["أخِّرْها فقد أُجِبْتَ فيها",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (8815)، وأحمد (9522) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"sQHL6AFT"},{"id":"س-04902","fp":"e4d6d7c675c5","stateId":598,"easy":"إذا عيّرت أخاك بذنب ← لا تموت حتى تعمله","cause":"من عيَّرَ أخاهُ بِذَنبٍ","result":"لَمْ يَمُتْ حتَّى يعمَلَه","explicit":true,"ref":"الجامع الصغير 8850","srcLabel":"الترمذي","text":[["من عيَّرَ أخاهُ بِذَنبٍ ",1],["لَمْ يَمُتْ حتَّى يعمَلَه",2]],"grade":"حسن","narrator":"معاذ بن جبل","muhaddith":"حسن","takhrij":"أخرجه الترمذي (2505)، والطبراني في ((الأوسط)) (7244) واللفظ لهما، والبيهقي في ((الشعب)) (6356) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"mbofCiH0"},{"id":"س-00648","fp":"5f0214d941a4","stateId":598,"easy":"إذا سببت المسلم ← فأنت كالمشرف على الهلكة","cause":"سِبابُ المُسلمِ","result":"كالمُشرِفِ على الهَلَكةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"otherNeedIds":[13],"ref":"تنبيه الغافلين 198","srcLabel":"البزار","text":["«",["سِبابُ المُسلمِ",1]," ",["كالمُشرِفِ على الهَلَكةِ",2],"»"],"grade":"حسن","narrator":"عبد الله بن عمرو","muhaddith":"إسناده جيد.","takhrij":"أخرجه البزار كما في ((كشف الأستار)) (2036) واللفظ له.","bab":"آداب عامة › ضرب الأمثال","dorar":"WLpFWcAp"},{"id":"ق-0071","fp":"e58e0984b704","stateId":599,"easy":"ترك الإنفاق في سبيل الله ← التهلكة","cause":"ترك الإنفاق في سبيل الله","result":"التهلكة","explicit":true,"star":true,"ref":"سورة البقرة: 195","srcLabel":"القرآن الكريم","quran":{"s":2,"from":195,"to":195,"text":"وَأَنْفِقُوا فِي سَبِيلِ اللَّهِ وَلَا تُلْقُوا بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ وَأَحْسِنُوا إِنَّ اللَّهَ يُحِبُّ الْمُحْسِنِينَ (195)","hl":[[0,81,1]]}},{"id":"ق-0491","fp":"b13bb72e1fb0","stateId":599,"easy":"تقديم محبة الأهل والمال والتجارة على الله ورسوله والجهاد ← التربص بأمر الله والحرمان من الهداية","cause":"تقديم محبة الأهل والمال والتجارة على الله ورسوله والجهاد","result":"التربص بأمر الله والحرمان من الهداية","explicit":true,"star":true,"otherNeedIds":[21],"ref":"سورة التوبة: 24","srcLabel":"القرآن الكريم","quran":{"s":9,"from":24,"to":24,"text":"قُلْ إِنْ كَانَ آبَاؤُكُمْ وَأَبْنَاؤُكُمْ وَإِخْوَانُكُمْ وَأَزْوَاجُكُمْ وَعَشِيرَتُكُمْ وَأَمْوَالٌ اقْتَرَفْتُمُوهَا وَتِجَارَةٌ تَخْشَوْنَ كَسَادَهَا وَمَسَاكِنُ تَرْضَوْنَهَا أَحَبَّ إِلَيْكُمْ مِنَ اللَّهِ وَرَسُولِهِ وَجِهَادٍ فِي سَبِيلِهِ فَتَرَبَّصُوا حَتَّى يَأْتِيَ اللَّهُ بِأَمْرِهِ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الْفَاسِقِينَ (24)","hl":[[5,343,1]]}},{"id":"س-05215","fp":"3e7394de95c1","stateId":599,"easy":"إذا وصلت شعرك (اتخذت القُصة) ← فبه هلكت بنو إسرائيل","cause":"اتَّخذَ هذِهِ نساؤُهُم","result":"إنَّما هلَكَت بنو إسرائيلَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"غاية المرام 100","srcLabel":"مسلم","text":["قدمَ معاويةُ المدينةَ، آخرَ قَدمةٍ قدمَها، فخطبَنا فأخرجَ كَبَّةً من شَعرٍ قالَ : ما كُنتُ أرى أحدًا يفعلُ هذا غيرَ اليَهودِ إنَّ النبي سمَّاهُ الزُّورَ. يعني الواصِلةَ في الشَّعرِ وفي روايَةٍ أنَّهُ قال لأهلِ المدينَةِ أينَ عُلَماؤُكُم ؟ سَمِعْتُ رسولَ اللَّهِ ينهَى عَن مثلِ هذِهِ، ويقولُ ",["إنَّما هلَكَت بنو إسرائيلَ",2]," حينَ ",["اتَّخذَ هذِهِ نساؤُهُم",1]],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"صحيح","takhrij":"أخرجه أحمد (16934)، وابن الجعد في ((مسنده)) (94) كلاهما بلفظه دون قوله: ((في الشعر))، ومسلم (2127) بلفظ مقارب .","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"mFeyM2Uk","merged":3,"otherRefs":["صحيح البخاري 5932 (صحيح)","صحيح النسائي 5260 (صحيح)"]},{"id":"س-07738","fp":"73c3ea5bb2fa","stateId":599,"easy":"إذا قُتل نبي أو خليفة ← قُتل به خلق كثير","cause":"لم يُقتَلْ نبيٌّ فيما مضى","result":"إلَّا قُتِل به سبعونَ ألفَ مقاتلٍ كلُّهم يُقتَلُ به ولا قُتِل خليفةٌ قطُّ إلَّا قُتِل به خمسةٌ وثلاثونَ ألفَ مقاتلٍ كلُّهم يُقتَلُ به","explicit":true,"otherNeedIds":[13],"ref":"مجمع الزوائد 9/95","srcLabel":"البخاري","text":["أقبَل عبدُ اللهِ بنُ سلامٍ وعثمانُ محصورٌ فانطَلَق فدخَل عليه فوسَّعوا له حتَّى دخَل فقال السَّلامُ عليك يا أميرَ المؤمنينَ فقال وعليك السَّلامُ ما جاء بك يا عبدَ اللهِ بنَ سلامٍ قال قد جِئْتُ لأثبُتَ حتَّى أستشهِدَ أو يفتَحَ اللهُ لك ولا أرى هؤلاءِ القومَ إلَّا قاتِلوك فإن يقتُلوك فذاك خيرٌ لك وشرٌّ لهم فقال عثمانُ أسأَلُك بالَّذي لي عليك من الحقِّ لَمَا خرَجْتَ إليهم خيرًا يسوقُه اللهُ بك وشرًّا يدفَعُه بك اللهُ فسمِع وأطاع فخرَج عليهم فلمَّا رأَوْه اجتَمَعوا وظنُّوا أنَّه قد جاءهم ببعضِ ما يُسَرُّونَ به فقام خطيبًا فحمِد اللهَ وأثنى عليه ثُمَّ قال أمَّا بعدُ فإنَّ اللهَ عزَّ وجلَّ بعَث محمَّدًا صلَّى اللَّهُ عليه وسلَّم بشيرًا ونذيرًا يُبشِّرُ بالجنَّةِ مَن أطاعه ويُنذِرُ بالنَّارِ مَن عصاه وأظهَر مَن اتَّبَعه على الدِّينِ كلِّه ولو كرِه المشركونَ ثُمَّ اختار له المساكنَ فاختار له المدينةَ فجعَلها دارَ الهجرةِ وجعَلها دارَ الإيمانِ فواللهِ ما زالتِ الملائكةُ حافِّينَ بالمدينةِ مذ قدِمها رسولُ اللهِ صلَّى اللَّهُ عليه وسلَّم إلى اليومِ وما زال سيفُ اللهِ مغمودًا عنكم مذ قدِمها رسولُ اللهِ صلَّى اللَّهُ عليه وسلَّم إلى اليوم ثُمَّ قال إنَّ اللهَ بعَث محمَّدًا صلَّى اللَّهُ عليه وسلَّم بالحقِّ فمَنِ اهتدى فإنَّما يهتَدي بهدى اللهِ ومَن ضلَّ فإنَّما يضِلُّ بعدِ البيانِ والحجَّةِ وإنَّه ",["لم يُقتَلْ نبيٌّ فيما مضى",1]," ",["إلَّا قُتِل به سبعونَ ألفَ مقاتلٍ كلُّهم يُقتَلُ به ولا قُتِل خليفةٌ قطُّ إلَّا قُتِل به خمسةٌ وثلاثونَ ألفَ مقاتلٍ كلُّهم يُقتَلُ به",2]," فلا تعجَلوا على هذا الشَّيخِ بقتلٍ فواللهِ لا يقتُلُه رجلٌ منكم إلَّا لقي اللهَ يومَ القيامةِ ويدُه مقطوعةٌ مشلولةٌ واعلَموا أنَّه ليس لولدٍ على والدٍ حقٌّ إلَّا ولهذا الشَّيخِ عليكم مثلُه قال فقالوا كذَبَتِ اليهودُ كذَبَتِ اليهودُ فقال كذَبْتُم واللهِ وأنتم آثِمون ما أنا بيهوديٍّ وإنِّي لأحدُ المسلمينَ يعلَمُ اللهُ بذلك ورسولُه والمؤمنونَ وقد أنزَل اللهُ في القرآنِ {قُلْ كَفَى بِاللَّهِ شَهِيدًا بَيْنِي وَبَيْنَكُمْ وَمَنْ عِنْدَهُ عِلْمُ الْكِتَابِ} وقد أنزَل الآيةَ الأخرى { قُلْ أَرَأَيْتُمْ إِنْ كَانَ مِنْ عِنْدِ اللَّهِ وَكَفَرْتُمْ بِهِ وَشَهِدَ شَاهِدٌ مِنْ بَنِي إِسْرَائِيلَ عَلَى مِثْلِهِ فَآمَنَ وَاسْتَكْبَرْتُمْ} قال فقاموا فدخَلوا على عثمانَ فذبَحوه كما يُذبَحُ الحُلَّانُ قال شُعَيبٌ فقُلْتُ لعبدِ الملكِ بنِ عُمَيرٍ ما الحُلَّانُ قال الحَمَلُ قال وقد قال عثمانُ لكَثيرِ بنِ الصَّلْتِ يا كَثيرُ أنا واللهِ مقتولٌ غدًا قال بل يُعلِي اللهُ كعبَك ويكبِتُ عدوَّك قال ثُمَّ أعادها الثَّالثةَ فقال مثلَ ذلك قال عمَّ يقولُ يا أميرَ المؤمنينَ قال رأَيْتُ رسولَ اللهِ صلَّى اللَّهُ عليه وسلَّم ومعه أبو بكرٍ وعمرُ فقال لي يا عثمانُ أنت عندَنا غدًا وأنت مقتولٌ غدًا فأنا واللهِ مقتولٌ قال فقُتِل فخرَج عبدُ اللهِ بنِ سلامٍ إلى القومِ قبلَ أن يتفرَّقوا فقال يا أهلَ مصرَ يا قتلةَ عثمانَ قتَلْتُم أميرَ المؤمنينَ أمَا واللهِ لا يزالُ عهدٌ منكوثٌ ودمٌ مسفوحٌ ومالٌ مقسومٌ لا سُقِيتُم"],"grade":"حسن","narrator":"محمد بن يوسف بن عبدالله بن سلام","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني (13/ 155) (379) بلفظه، والبخاري في ((التاريخ الكبير)) (1/ 262)، وابن شبة في ((تاريخ المدينة)) (4/ 1227) مختصرا.","bab":"قرآن › أسباب النزول","dorar":"Vu1gdwiq"},{"id":"س-05918","fp":"c91ea93a7cc6","stateId":599,"easy":"إذا لم تزوجوا من ترضون دينه وخلقه ← تكن فتنة في الأرض وفساد عريض","cause":"إلَّا تَفْعَلوا","result":"تَكنْ فِتنةٌ في الأرضِ وفسادٌ عَريضٌ","explicit":true,"otherNeedIds":[38],"ref":"المستدرك على الصحيحين 2732","srcLabel":"الترمذي","text":["إذا أَتاكُم مَنْ تَرْضَوْنَ خُلُقَه ودينَه، فأَنكِحوهُ، ",["إلَّا تَفْعَلوا",1],"؛ ",["تَكنْ فِتنةٌ في الأرضِ وفسادٌ عَريضٌ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن ماجه (1967) بلفظه، والترمذي (1084)، والطبراني في ((المعجم الأوسط)) (2695) بنحوه","bab":"رقائق وزهد › الوصايا النافعة","dorar":"cjkNUsHm"},{"id":"س-01293","fp":"46d4fd6da1a1","stateId":599,"easy":"إذا قتلت حية البيوت قبل إنذارها ← قد يصيبك ضرر (من واقعة)","cause":"فطَعَنَ الحيَّةَ فمَاتَتْ","result":"وماتَ الرجلُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 4-51","srcLabel":"الطبراني","text":["أنَّ رجلًا كان حديثَ عهدٍ بُعُرْسٍ فبعثَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم بعْثًا وبعَثَ فيهم ذلِكَ الرجلَ فلمَّا جاءَ القومُ تعجَّلَ إلى أهلِهِ فإذا هو بامرأَتِهِ قائمَةٍ على بابِها فدخلَتْهُ غَيَرَةٌ فهيَّأَ إِلَيْها الرمْحَ لِيَطْعَنَها فقالَتْ لا تعْجَلْ وانظُرْ ما في البيتِ فدخلَ البيتَ فإِذَا هو بحيَّةٍ مُنطَوِيَةٍ علَى فراشِها ",["فطَعَنَ الحيَّةَ فمَاتَتْ",1]," ",["وماتَ الرجلُ",2]," فبلَغَ ذلكَ النبيَّ صلَّى اللهُ عليه وسلَّم فقال إنَّ لهذِهِ البيوتِ عوامِرَ مِنَ الجِنِّ ونَهَى عنْ قَتْلِهِنَّ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (4528) واللفظ له، والطحاوي في ((شرح مشكل الآثار)) (2936) مختصرا.","bab":"نكاح › الغيرة","dorar":"cJE25aO8"},{"id":"س-01725","fp":"70346027ba69","stateId":599,"easy":"إذا تعلقت بالمخلوق دون الله ← تطول محنتك (من قصة يوسف)","cause":"اذكُرْني عندَ ربِّك","result":"ما لبِث","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح ابن حبان 6206","srcLabel":"النسائي","text":["رحِم اللهُ يوسُفَ لولا الكلمةُ الَّتي قالها : ",["اذكُرْني عندَ ربِّك",1]," ",["ما لبِث",2]," في السِّجنِ ما لبِث ورحِم اللهُ لوطًا إنْ كان لَيأوي إلى رُكنٍ شديدٍ إذ قال لقومِه : {لَوْ أَنَّ لِي بِكُمْ قُوَّةً أَوْ آوِي إِلَى رُكْنٍ شَدِيدٍ} [هود: 80]، قال : فما بعَث اللهُ نَبيًّا بعدَه إلَّا في ثَروةٍ مِن قومِه"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (8391)، والنسائي في ((السنن الكبرى)) (10984)، وابن أبي حاتم في ((التفسير)) (11634) بنحوه.","bab":"أنبياء › عام","dorar":"kkdiaJjL"},{"id":"س-01737","fp":"d218de8857fa","stateId":599,"easy":"إذا أعجبت بكثرتكم ← تُعاقبون (من قصة)","cause":"أعجَبَته أُمَّتُه","result":"فماتَ في ثَلاثٍ سَبعونَ ألفًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 18933","srcLabel":"أحمد","text":["إنَّ نَبيًّا كان فيمَن كان قَبلَكُم ",["أعجَبَته أُمَّتُه",1],"، فقال: لَن يَرومَ هؤلاء شَيءٌ! فأوحى اللهُ إليه: أن خَيِّرْهم بَينَ إحدى ثَلاثٍ: إمَّا أن أُسَلِّطَ عليهم عَدوًّا مِن غَيرِهم فيَستَبيحَهم، أوِ الجوعَ، أوِ المَوتَ، قال: فقالوا: أمَّا القَتلُ أوِ الجوعُ فلا طاقةَ لَنا به، ولَكِنِ المَوتُ، قال: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: «",["فماتَ في ثَلاثٍ سَبعونَ ألفًا",2],"»، قال: فقال: فأنا أقولُ الآنَ: اللهُمَّ بكَ أُحاوِلُ، وبكَ أصولُ، وبكَ أُقاتِلُ"],"grade":"صحيح","narrator":"صهيب بن سنان","muhaddith":"إسناده صحيح","bab":"أنبياء › عام","dorar":"OyeQOXkP"},{"id":"س-05966","fp":"cff8154fd1fc","stateId":599,"easy":"إذا نظرت إلى فرج زوجتك (على رواية ضعيفة) ← يورث العمى","cause":"يَنظُرْ إلى فرجِها","result":"فإنَّ ذلك يورِثُ العَمى","explicit":true,"ref":"سبل الهدى والرشاد 12/135","srcLabel":"ابن حبان","text":["«إذا جامَعَ أحَدُكُم زَوجَتَه أو جاريَتَه فلا ",["يَنظُرْ إلى فرجِها",1],"؛ ",["فإنَّ ذلك يورِثُ العَمى",2],"»"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده جيد.","takhrij":"أخرجه ابن حبان في ((المجروحين)) (1/ 231)، وابن عدي في ((الكامل في الضعفاء)) (2/ 265)، والبيهقي (13671)، وابن عساكر في ((تاريخ دمشق)) (46/ 303)، وابن الجوزي في ((الموضوعات)) (2/ 271) جميعا بلفظه","bab":"رقائق وزهد › الوصايا النافعة","dorar":"0bQeMCym"},{"id":"س-07733","fp":"c557ab372304","stateId":599,"easy":"إذا وعدت ولم تستثنِ «إن شاء الله» ← قد تُحرم حاجتك (من واقعة)","cause":"فقالَ : غدًا أجِيبُكُم ولم يَسْتَثْنِ","result":"فمَكَثَ خمسَ عشرَةَ ليلةً لا يُحْدِثُ اللهُ إليهِ في ذلكَ وحيًا","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[10],"ref":"موافقة الخبر الخبر 2/70","srcLabel":"الترمذي","text":["عن ابنِ عباسٍ رضيَ اللهُ عنهمَا أنَّ مُشْرِكِي قريشٍ بعثوا النَّضْرَ بنَ الحارثِ ، وعقْبَةَ بنَ أبي مُعَيْطٍ إلى أحبَارِ اليهودِ بالمدينةِ فقالوا لهُمْ : سَلُوهُمْ عن أَمْرِهِ وأَخْبِروهم خَبَرَهُ وصِفُوا لهم مَقَالَتَه ، فإنهم أهلُ الكتابِ الأولِّ ، وعندَهُمْ علْمٌ ما ليسَ عندنَا من علمِ الأنبياءِ ، فقَدِمَا المدينةَ فسألا أحبارَ اليهودِ عنهُ ، وأخبرُوهم بمَا يقولُ ، فقالوا لهُم : سَلُوهُ عن ثلاثٍ فإنْ أخْبَرَكُم بهنَّ فهوَ نبيٌّ مرسَلٌ ، وإلا فهوَ رجلٌ مُتَقَوِّلٌ ، سلُوهُ عن فِتْيَةٍ ذهبوا في الدهْرِ الأوَّلِ ما كانَ من أمرِهِم ؟ فإنَّهُم كانَ لهمْ حديثٌ عجِيبٌ ، وسلُوهُ عن رجلٍ طوَّافٍ طافَ مشارِقَ الأرضِ ومغارِبَها ما كان نَبَؤُهُ ؟ وسلُوهُ عن الرُّوحِ ماهُوَ ؟ فانْطَلَقَا فقَدِمَا مكةَ فقالا : يا معشَرَ قريشٍ قدْ جئْنَاكُم بفَصْلِ ما بينكم وبينَ محمدٍ ، أمَرَنَا أحبارُ اليهودِ أنْ نسْأَلَهُ عن ثلاثٍ ، فذكَرَ القصَّةَ ، فجاءوا إلى رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ فسأَلُوهُ عن ذلكَ ",["فقالَ : غدًا أجِيبُكُم ولم يَسْتَثْنِ",1]," ، ",["فمَكَثَ خمسَ عشرَةَ ليلةً لا يُحْدِثُ اللهُ إليهِ في ذلكَ وحيًا",2]," ، ولا يأتِيهِ جبريلُ صلَّى اللهُ عليهِ وسلَّمَ ، حتَّى أحْزَنَ ذلكَ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ، وأَرْجَفَ بهِ أهلُ مكةَ ، فقالُوا : وعَدَنَا أنْ يجيبَنَا غدًا وقدْ مَضَتْ خمسِ عشرةَ ليلةً ، أصبحْنَا منْها اليومَ لا يخبِرُنَا عمَّا سأَلنَاهُ عنهُ ، فنزلَ عليهِ جبريلُ بسورةِ الكهفِ ، فعَاتَبَهُ في أوَّلِهَا على حزْنِهِ عليهمْ ثمَّ أخبَرَهُ بخبَرِ أهلِ الكهفِ ، وأخبَرَهُ عن الرجلِ الطوَّافِ ، ونزلَ قولُهُ تعالى : { وَيَسْأَلُونَكَ عَنِ الرُّوحِ } الآيةَ"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"غريب، لولا هذا المبهم لكان سنده حسنا","takhrij":"أخرجه الترمذي (3140)، وأحمد (2309) مختصرا، والبيهقي في ((دلائل النبوة)) (2/ 269) باختلاف يسير.","bab":"قرآن › أسباب النزول","dorar":"SsKsa3Mi"},{"id":"س-01709","fp":"aa3b0875f77c","stateId":599,"easy":"إذا عجزت ← فإن الله يلوم على العجز","cause":"علَى العجزِ","result":"إنَّ اللَّهَ يلومُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"عمدة التفسير 1/441","srcLabel":"عمدة التفسير","text":["أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ قضَى بينَ رجُلَيْنِ فقالَ المقضيُّ عليهِ لما أدبرَ : حسبيَ اللَّهُ ونعمَ الوَكيلُ . فقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ : ردُّوا عليَّ الرَّجلَ . فقالَ : ما قلتَ ؟ . قالَ : قلتُ : حسبيَ اللَّهُ ونعمَ الوَكيلُ . فقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ : ",["إنَّ اللَّهَ يلومُ",2]," ",["علَى العجزِ",1]," ، ولَكِن عليكَ بالكَيسِ ، فإذا غلبَكَ أمرٌ فقُلْ : حسبيَ اللَّهُ ونعمَ الوَكيلُ"],"grade":"صحيح","narrator":"عوف بن مالك الأشجعي","muhaddith":"إسناده صحيح","bab":"أقضية وأحكام › قضايا حكم فيها النبي صلى الله عليه وسلم","dorar":"crgAnxGW"},{"id":"س-01179","fp":"09401edbf38e","stateId":599,"easy":"إذا ضيّعت التسبيح ← فما صيد صيد ولا قطعت شجرة إلا بتضييعه","cause":"بتَضييعٍ مِنَ التَّسبيحِ","result":"ما صِيدَ صَيدٌ ولا قُطِعَت شَجَرةٌ إلَّا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"فيض القدير 5/ 452","srcLabel":"أبو نعيم","text":[["ما صِيدَ صَيدٌ ولا قُطِعَت شَجَرةٌ إلَّا",2]," ",["بتَضييعٍ مِنَ التَّسبيحِ",1]],"grade":"حسن","narrator":"أبو هريرةَ","muhaddith":"رمز السيوطي لحسنه غير صواب","takhrij":"أخرجه أبو نعيم في ((حلية الأولياء)) (9663)، والديلمي في ((مسند الفردوس)) كما في (الغرائب الملتقطة) لابن حجر (ص: 2333)، باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"6bA1JkKb"},{"id":"ق-0870","fp":"4a7747feb02a","stateId":600,"easy":"مخالفة أمر الرسول ﷺ ← فتنة أو عذاب أليم","cause":"مخالفة أمر الرسول ﷺ","result":"فتنة أو عذاب أليم","explicit":true,"otherNeedIds":[70,21],"ref":"سورة النور: 63","srcLabel":"القرآن الكريم","quran":{"s":24,"from":63,"to":63,"text":"لَا تَجْعَلُوا دُعَاءَ الرَّسُولِ بَيْنَكُمْ كَدُعَاءِ بَعْضِكُمْ بَعْضًا قَدْ يَعْلَمُ اللَّهُ الَّذِينَ يَتَسَلَّلُونَ مِنْكُمْ لِوَاذًا فَلْيَحْذَرِ الَّذِينَ يُخَالِفُونَ عَنْ أَمْرِهِ أَنْ تُصِيبَهُمْ فِتْنَةٌ أَوْ يُصِيبَهُمْ عَذَابٌ أَلِيمٌ (63)","hl":[[139,247,1]]}},{"id":"س-03641","fp":"278ab58e435c","stateId":600,"easy":"إذا عصيت أمر النبي ﷺ ← ترى ما تكره (من واقعة)","cause":"فعصاه فتيانِ","result":"فكِلاهما رأى ما يكرَه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشاكر 8/117","srcLabel":"الطبراني","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلمَ  نزل العقيقَ فنهى عن طُرُوقِ النساءِ الليلةَ التي يأتي فيها ",["فعصاه فتيانِ",1]," ",["فكِلاهما رأى ما يكرَه",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه البزار والطبراني كما في ((مجمع الزوائد)) للهيثمي (4/333)","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"LcGtYl1E","merged":3,"otherRefs":["الإفصاح عن أحاديث النكاح 175 (حسن)","تخريج الإحياء للعراقي 2/59 (حسن)"]},{"id":"س-03584","fp":"79f079532e7f","stateId":600,"easy":"إذا رفضت الأكل باليمين كبراً ← قد تُعاقب (من واقعة)","cause":"قال : لا أستطيعُ","result":"لا استطَعْتَ فما رفَعها إلى فيه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"صحيح ابن حبان 6513","srcLabel":"مسلم","text":["أنَّ رجُلًا كان يأكُلُ عندَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم بشِمالِه فقال له النَّبيُّ صلَّى اللهُ عليه وسلَّم : ( كُلْ بيمينِك ) ",["قال : لا أستطيعُ",1]," فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم : ) ",["لا استطَعْتَ ) فما رفَعها إلى فيه",2]],"grade":"صحيح","narrator":"سلمة بن الأكوع","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم  (2021) بزيادة \"ما منعه إلا الكبر\"  وأحمد (16530) والدارمي (2075) باختلاف يسير.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"M5UkYgfq","merged":3,"otherRefs":["صحيح مسلم 2021 (صحيح)","زاد المعاد 2/369 (صحيح)"]},{"id":"س-00821","fp":"101b804b4606","stateId":600,"easy":"إذا رفضت السنة كبراً ← قد تُعاقب في الدنيا (من واقعة)","cause":"يَأكُلُ بِشِمالِهِ، فقال: كُلْ بِيَمينِكَ. فقال: لا أستَطيعُ","result":"لا استَطَعتَ. قال: فما وصَلَتْ يَمينُهُ إلى فَمِهِ بَعدُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 16499","srcLabel":"مسلم","text":["سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسَلَّمَ يَقولُ لِرَجُلٍ يُقالُ له: بُسْرُ، ابنُ راعي العيرِ، أبصَرَهُ ",["يَأكُلُ بِشِمالِهِ، فقال: كُلْ بِيَمينِكَ. فقال: لا أستَطيعُ",1],". فقال: ",["لا استَطَعتَ. قال: فما وصَلَتْ يَمينُهُ إلى فَمِهِ بَعدُ",2],". وقال أبو النَّضْرِ في حَديثِهِ: ابنُ راعي العيرِ مِن أشْجَعَ."],"grade":"صحيح","narrator":"سلمة بن الأكوع","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (16499) واللفظ له، وعبد بن حميد (388)، وأبو عوانة في ((المستخرج)) (8249)","bab":"أدعية وأذكار › دعاء النبي على بعض الأشخاص والأشياء والأمور","dorar":"HgTBzdnW","merged":2,"otherRefs":["تخريج صحيح ابن حبان 6512 (صحيح)"]},{"id":"س-03714","fp":"769663ae84fd","stateId":600,"easy":"إذا أكلت بشمالك ← قد يصيبك سوء (من واقعة)","cause":"تأكُلُ بشِمالِها","result":"فأصابَها طاعونٌ فماتَتْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"فتح الباري لابن حجر 9/433","srcLabel":"البيهقي","text":["أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ رأى سُبَيعَةَ الأسْلَميَّةَ ",["تأكُلُ بشِمالِها",1]," فقالَ: أخذَها داءُ غزَّةَ. فقالَ: إنَّ بها قُرحةً. قالَ: وإن. فمرَّت بغَزَّةَ ",["فأصابَها طاعونٌ فماتَتْ",2]],"grade":"حسن","narrator":"عقبة بن عامر","muhaddith":"إسناده حسن","takhrij":"أخرجه البيهقي في ((دلائل النبوة)) (6/ 239) بنحوه ، والروياني في ((مسنده)) (270) مقتصرا على أوله .","bab":"اعتصام بالسنة › لزوم السنة","dorar":"x9kkLK6P"},{"id":"س-06655","fp":"a3b17baba086","stateId":601,"easy":"إذا تخلّف أهل بيت عن الجماعة ← هم النبي ﷺ أن يحرقها عليهم","cause":"تخَلَّفَ أهلوها عن هذه الصَّلاةِ","result":"فأُضرِمُها عليهم بالنِّيرانِ","explicit":true,"star":true,"otherNeedIds":[13,28],"ref":"تخريج المسند لشعيب 10935","srcLabel":"متفق عليه","text":["أخَّرَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ صَلاةَ العِشاءِ، حتى تهَوَّرَ اللَّيلُ، فذهَبَ ثُلُثُهُ أو قَرابَتُهُ، ثم خرَجَ إلى المَسجِدِ، فإذا النَّاسُ عِزون، وإذا هم قَليلٌ، قال: فغضِبَ غَضَبًا ما أعلَمُ أنِّي رأيتُه غضِبَ غَضَبًا قَطُّ أشَدَّ منه، ثم قال: لو أنَّ رَجُلًا دعا النَّاسَ إلى عَرْقٍ أو مِرماتَيْنِ؛ أتَوْهُ لذلك، ولم يتخَلَّفوا، وهم يتخَلَّفون عن هذه الصَّلاةِ، لقد همَمتُ أنْ آمُرَ رَجُلًا يُصَلِّي بالنَّاسِ، وأتتَبَّعَ هذه الدُّورَ التي ",["تخَلَّفَ أهلوها عن هذه الصَّلاةِ",1]," ",["فأُضرِمُها عليهم بالنِّيرانِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (644)، ومسلم (651)، وأبو داود (548)، والترمذي (217)، والنسائي (848)، وابن ماجه (791) بنحوه، وأحمد (10935) واللفظ له","bab":"صلاة › مواقيت الصلاة","dorar":"0lEgv25O","merged":20,"otherRefs":["تخريج المسند لشعيب 10803 (صحيح)","صحيح مسلم 651 (صحيح)","تخريج المسند لشعيب 8890 (صحيح)","صحيح ابن خزيمة 3/ 16 (صحيح)","صحيح الترمذي 217 (صحيح)","تخريج المسند لشعيب 10217 (صحيح)","تخريج مشكل الآثار 5874 (حسن)","صحيح البخاري 644 (صحيح)","مجمع الزوائد 2/46 (صحيح)","الأحاديث المختارة 1310 (صحيح)","صحيح أبي داود 549 (صحيح)","المحلى 4/250 (صحيح)","تخريج المسند لشعيب 7328 (صحيح)","المستدرك على الصحيحين 822 (صحيح)","تخريج المسند لشعيب 8903 (صحيح)","تخريج صحيح ابن حبان 2097 (صحيح)","تخريج المسند لشعيب 3743 (صحيح)","الفتح الرباني 7/3324 (صحيح)","الصحيح المسند 887 (صحيح)"]},{"id":"س-04812","fp":"0f8c3ba27cca","stateId":601,"easy":"إذا رفعت رأسك قبل الإمام ← أما تخشى أن يجعل الله رأسك رأس حمار","cause":"إذا رَفَعَ رَأسَه قَبلَ الإمامِ","result":"أن يَجعَلَ اللهُ رَأسَه رَأسَ حِمارٍ؟! أو يَجعَلَ اللهُ صورَتَه صورةَ حِمارٍ","explicit":true,"star":true,"ref":"صحيح البخاري 691","srcLabel":"مسلم","text":["أما يَخشى أحَدُكُم -أو: لا يَخشى أحَدُكُم- ",["إذا رَفَعَ رَأسَه قَبلَ الإمامِ",1]," ",["أن يَجعَلَ اللهُ رَأسَه رَأسَ حِمارٍ؟! أو يَجعَلَ اللهُ صورَتَه صورةَ حِمارٍ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (427) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Sz583dCX","merged":6,"otherRefs":["صحيح مسلم 427 (صحيح)","الزواجر عن اقتراف الكبائر 1/146 (حسن)","تخريج المسند لشعيب 7535 (صحيح)","التمهيد 24/365 (صحيح)","صحيح أبي داود 623 (صحيح)"]},{"id":"س-06695","fp":"b73f90057da1","stateId":601,"easy":"إذا صليت وأنت ناعس ← قد تذهب تستغفر فتسب نفسك","cause":"إذا وجَدَ أحَدُكُم النَّومَ وهو يُصلِّي","result":"عسى أنْ يَذهَبَ يَستَغْفِرُ اللهَ فيَسُبَّ نَفْسَه","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 26231","srcLabel":"مسلم","text":[["إذا وجَدَ أحَدُكُم النَّومَ وهو يُصلِّي",1]," فليَرْقُدْ حتى يَذهَبَ نَومُه، إنَّ أحَدَكُم ",["عسى أنْ يَذهَبَ يَستَغْفِرُ اللهَ فيَسُبَّ نَفْسَه",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (26231) واللفظ له، والدارمي (1383)، والطحاوي في ((شرح مشكل الآثار)) (3436)","bab":"صلاة الجماعة والإمامة › الخشوع في الصلاة","dorar":"F4sfbdr2"},{"id":"س-03593","fp":"042faeb3380b","stateId":601,"easy":"إذا رفعت بصرك إلى السماء في صلاتك ← يوشك أن يُخطف بصرك","cause":"يرفعونَ أبصارَهُم إلى السَّماءِ في صلاتِهِم","result":"لينتَهُنَّ عن ذلِكَ أو لتُخطَفنَّ أبصارُهُم","explicit":true,"similar":["س-06691","س-03069"],"ref":"صحيح ابن خزيمة 1/ 535","srcLabel":"ابن خزيمة","text":["ما بالُ أقوامٍ ",["يرفعونَ أبصارَهُم إلى السَّماءِ في صلاتِهِم",1],"، فاشتدَّ قولُهُ في ذلِكَ حتَّى قالَ: ",["لينتَهُنَّ عن ذلِكَ أو لتُخطَفنَّ أبصارُهُم",2]," [وفي روايةٍ] بمثلِهِ سواءً غيرَ أنَّهُ قال: فاشتَدَّ قولُ النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ في ذلِكَ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أخرجه في صحيحه","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"1a3s75rx","merged":8,"otherRefs":["صحيح الترغيب 551 (صحيح)","درء تعارض العقل والنقل 7/24 (صحيح)","تخريج المسند لشعيب 8802 (صحيح)","صحيح ابن ماجه 863 (صحيح)","صحيح الجامع 5479 (صحيح)","أصل صفة الصلاة 1/234 (صحيح)","مجمع الزوائد 10/170 (صحيح)"]},{"id":"س-06429","fp":"9584e1590cf7","stateId":601,"easy":"إذا حضرت الصلاة بغير طهور ← تلبّس على الناس صلاتهم","cause":"يَحْضُرونَ معَنا الصَّلاةَ بغَيْرِ طُهورٍ","result":"أولئك الَّذين يَلبِسونَ علينا صَلاتَنا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأحاديث المختارة 1497","srcLabel":"البخاري","text":["«صلَّى رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ الفَجْرَ فقَرَأَ فيهما بالرُّومِ، فالْتَبَسَ عليه في القِراءةِ، فلمَّا صلَّى قالَ: ما بالُ رِجالٍ ",["يَحْضُرونَ معَنا الصَّلاةَ بغَيْرِ طُهورٍ",1],"، ",["أولئك الَّذين يَلبِسونَ علينا صَلاتَنا",2],"، مَن شَهِدَ معَنا الصَّلاةَ فلْيُحسِنِ الطُّهورَ»."],"grade":"صحيح","narrator":"رجل من أصحاب النبي صلى الله عليه وسلم","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"صلاة › الوضوء والتطهر للصلاة","dorar":"CouhXOF1"},{"id":"س-06691","fp":"66bd867f8004","stateId":601,"easy":"إذا رفعت بصرك إلى السماء في الصلاة ← تخشى أن يُخطف","cause":"تَرْفَعُوا أَبْصارَكُمْ إلى السَّماءِ","result":"مَخَافَةَ أنْ تَلْتَمِعَ","explicit":true,"repOf":"س-03593","ref":"صحيح الموارد 399","text":["لا ",["تَرْفَعُوا أَبْصارَكُمْ إلى السَّماءِ",1]," ؛ ",["مَخَافَةَ أنْ تَلْتَمِعَ",2]," ، يعني : في الصلاةِ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (1043)، وابن حبان كما في ((موارد الظمآن)) للهيثمي (477) واللفظ له، والطبراني (12/287) (13139)","bab":"صلاة الجماعة والإمامة › الخشوع في الصلاة","dorar":"IstSIzal","merged":3,"otherRefs":["الصحيح المسند 1472 (صحيح)","تخريج المسند لشعيب 20876 (صحيح)"]},{"id":"س-01388","fp":"2fe307519373","stateId":601,"easy":"إذا لم تحسن الوضوء ← يلبّس على الإمام قراءته","cause":"يُصَلُّون معنا لا يُحسِنون الوضوءَ","result":"إنَّه يُلَبَّسُ علينا القرآنَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سبل الهدى والرشاد 8/503","srcLabel":"أحمد","text":["«صلَّى بنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم صلاةً، فقرأ فيها سورةَ الرُّومِ فتردَّد في آيةٍ، فلمَّا انصَرَف قال: «",["إنَّه يُلَبَّسُ علينا القرآنَ",2],"، إنَّ أقوامًا منكم ",["يُصَلُّون معنا لا يُحسِنون الوضوءَ",1],"، فمن شَهِد الصَّلاةَ معنا فليُحسِنِ الوُضوءَ»"],"grade":"صحيح","narrator":"أبو روح الكلاعي","muhaddith":"[رجاله] رجال الصحيح","takhrij":"أخرجه أحمد (15874)، وابن قانع في ((معجم الصحابة)) (1/ 346) بنحوه.","bab":"وضوء › إسباغ الوضوء","dorar":"o4oO1LJb","merged":3,"otherRefs":["الأحكام الوسطى 1/ 385 (صحيح)","تخريج زاد المعاد 1/202 (حسن)"]},{"id":"س-05031","fp":"d1d949f196a6","stateId":601,"easy":"إذا نشدت الضالة في المسجد ← لا وجدتها","cause":"مَن دَعا إلى الجَمَلِ الأحمَرِ","result":"لا وجَدتَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح مسلم 569","srcLabel":"ابن ماجه","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم لَمَّا صَلَّى قامَ رَجُلٌ فقال: ",["مَن دَعا إلى الجَمَلِ الأحمَرِ",1],"؟ فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ",["لا وجَدتَ",2],"، إنَّما بُنيَتِ المَساجِدُ لِما بُنيَت له."],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"[صحيح]","takhrij":"أخرجه ابن ماجه (765)، وأحمد (23044)، وابن حبان (1652) واللفظ لهم جميعا.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Gi2BtrCi"},{"id":"س-05053","fp":"8cbf1af8987a","stateId":601,"easy":"إذا تركت الجمعة بلا عذر ← لا جمع الله شملك ولا بارك لك في أمرك","cause":"من ترَكَها من غيرِ عذرٍ معَ إمامٍ عادلٍ أو إمامٍ جائرٍ","result":"فلا جمعَ اللَّهُ لَه شملَه ولا بورِك لَه في أمرِه ألا ولا صلاةَ لَه ألا ولا حجَّ لَه ألا ولا برَّ لَه ألا ولا صدقةَ لَه","explicit":true,"otherNeedIds":[52],"ref":"مجمع الزوائد 2/172","srcLabel":"الطبراني","text":["خطَبَنا النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ ذاتَ يومٍ فقالَ إنَّ اللَّهَ كتبَ عليكمُ الجمعةَ في مقامي هذا في ساعتي هذِه في شَهري هذا في عامي هذا إلى يومِ القيامةِ ",["من ترَكَها من غيرِ عذرٍ معَ إمامٍ عادلٍ أو إمامٍ جائرٍ",1]," ",["فلا جمعَ اللَّهُ لَه شملَه ولا بورِك لَه في أمرِه ألا ولا صلاةَ لَه ألا ولا حجَّ لَه ألا ولا برَّ لَه ألا ولا صدقةَ لَه",2]],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"فيه موسى بن عطية الباهلي ولم أجد من ترجمه وبقية رجاله ثقات","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (7246)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"4Aq9K7g5"},{"id":"س-03069","fp":"8e65818fc160","stateId":601,"easy":"إذا رفعت بصرك إلى السماء في الصلاة ← قد يُخطف بصرك","cause":"رفعِ أبصارِهم عِندَ الدعاءِ إلى السماءِ","result":"حتى لتُخطفَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03593","ref":"المحلى 4/16","text":["ليَنتهينَّ أناسٌ عن ",["رفعِ أبصارِهم عِندَ الدعاءِ إلى السماءِ",1]," ",["حتى لتُخطفَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"احتج به ، وقال في المقدمة: (لم نحتج إلا بخبر صحيح من رواية الثقات مسند)","takhrij":"أخرجه مسلم (429) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"IsEpd4hV"},{"id":"س-01383","fp":"a20e11e1e113","stateId":601,"easy":"إذا لم تنظّف أظفارك ← يُوهم الإمام في صلاته","cause":"ورُفْغُ أحدِكم بين ظفرِهِ وأنملتِهِ","result":"ما لي لا أوهَمُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-01469"],"ref":"فتح الباري لابن حجر 10/357","srcLabel":"الطبراني","text":["صلَّى النبيُّ صلَّى اللهُ عليْهِ وسلَّمَ فأوْهمَ فيها ، فسُئِلَ فقال : ",["ما لي لا أوهَمُ",2]," ",["ورُفْغُ أحدِكم بين ظفرِهِ وأنملتِهِ",1]],"grade":"حسن","narrator":"قيس بن أبي حازم","muhaddith":"رجاله ثقات مع إرساله ، وقد وصله الطبراني من وجه آخر","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (2/ 221)، والبيهقي في ((شعب الإيمان)) (2511) كلاهما بلفظ مقارب.","bab":"وضوء › إسباغ الوضوء","dorar":"mB0PH1cY"},{"id":"س-01469","fp":"778c5eb0e0f6","stateId":601,"easy":"إذا لم تتنظف ← يُوهم الإمام في صلاته","cause":"فذَكَرَ الرَّفْغَ، ومعنى قَولِه: إنَّكم لستُم بمُتنَظِّفينَ","result":"فأوهَمَ فيها، فقال: وما يَمنَعُني","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-01383","ref":"تخريج المسند لشعيب 23125","text":["عن رَجُلٍ مِن أصْحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، عن النَّبيِّ صلَّى اللهُ عليه وسلَّمَ أنَّه صلَّى الصُّبحَ، فقَرَأَ فيها بالرُّومِ ",["فأوهَمَ فيها، فقال: وما يَمنَعُني",2],". قال شُعْبةُ: ",["فذَكَرَ الرَّفْغَ، ومعنى قَولِه: إنَّكم لستُم بمُتنَظِّفينَ",1],"."],"grade":"حسن","narrator":"رجل من الصحابة","muhaddith":"إسناده حسن.","takhrij":"أخرجه أحمد (23125)، والضياء في ((الأحاديث المختارة)) (1498)","bab":"وضوء › فضل الوضوء","dorar":"t41Ex6I6"},{"id":"س-07964","fp":"26b763e31f33","stateId":601,"easy":"إذا نشدت ضالة في المسجد ← لا ردها الله عليك","cause":"مَن يَنشُدُ ضالَّةً في المَسجِدِ","result":"لا رَدَّها اللهُ عليك","explicit":true,"star":true,"ref":"الأحكام الوسطى 1/ 295","srcLabel":"الترمذي","text":["إذا رَأيْتُم مَن يَبيعُ أو يَبْتاعُ في المَسجِدِ فقولوا: لا أَربَحَ اللهُ تِجارتَك، وإذا رَأيْتُم ",["مَن يَنشُدُ ضالَّةً في المَسجِدِ",1]," فقولوا: ",["لا رَدَّها اللهُ عليك",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه الترمذي (1321)، والدارمي (1441)، والنسائي في ((السنن الكبرى)) (9933) بلفظه.","bab":"مساجد ومواضع الصلاة › العناية بالمسجد","dorar":"E145Lb51","merged":4,"otherRefs":["صحيح النسائي 716 (صحيح)","تخريج المسند لشاكر 16/242 (صحيح)","معرفة السنن والآثار 19735 (صحيح)"]},{"id":"س-05768","fp":"8f3225c28ac1","stateId":602,"easy":"إذا أُعطيت الإمارة عن مسألة ← وُكلت إليها","cause":"أُعطيتَها عن مَسألةٍ","result":"وُكِلتَ إليها","explicit":true,"star":true,"ref":"صحيح البخاري 7147","srcLabel":"مسلم","text":["قال لي رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: يا عَبدَ الرَّحمَنِ بنَ سَمُرةَ، لا تَسألِ الإمارةَ، فإن ",["أُعطيتَها عن مَسألةٍ",1]," ",["وُكِلتَ إليها",2],"، وإن أُعطيتَها عن غيرِ مَسألةٍ أُعِنتَ عليها، وإذا حَلَفتَ على يَمينٍ فرَأيتَ غَيرَها خَيرًا منها، فأْتِ الذي هو خَيرٌ، وكَفِّرْ عن يَمينِكَ."],"grade":"صحيح","narrator":"عبدالرحمن بن سمرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1652) باختلاف يسير","bab":"رقائق وزهد › الوصايا النافعة","dorar":"2HzJm5NS","merged":2,"otherRefs":["صحيح مسلم 1652 (صحيح)"]},{"id":"س-00413","fp":"89d3c597a759","stateId":602,"easy":"إذا لزمت أبواب السلطان ← افتُتنت","cause":"ومن أتى السلطانَ","result":"افتُتِنَ","explicit":true,"ref":"التمهيد 18/144","srcLabel":"الترمذي","text":["مَنْ لزِمَ الباديةَ جفا [يعني حديث: من سكنَ الباديةَ جفَا، ومنِ اتَّبع الصيدَ غفِلَ، ",["ومن أتى السلطانَ",1]," ",["افتُتِنَ",2],".]"],"grade":"صحيح","narrator":"[عبدالله بن عباس]","muhaddith":"صحيح","takhrij":"أخرجه أبو داوود (2859)، وأحمد (3362)بلفظه، والترمذي (2256)باختلاف يسير.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"7jRjv7NN","merged":2,"otherRefs":["صحيح الجامع 6296 (صحيح)"]},{"id":"س-01668","fp":"290211973ed1","stateId":602,"easy":"إذا توليت القضاء ← فقد ذُبحت بغير سكين","cause":"من تولَّى القضاءَ","result":"فقد ذُبِحَ بغيرِ سكينٍ","explicit":true,"similar":["س-01675"],"ref":"مجموع فتاوى ابن باز 209/23","srcLabel":"مجموع فتاوى ابن باز","text":[["من تولَّى القضاءَ",1]," ",["فقد ذُبِحَ بغيرِ سكينٍ",2]],"grade":"حسن","muhaddith":"لا بأس به جيد ومعروف","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"tYytKcxy"},{"id":"س-01675","fp":"969c26c792ed","stateId":602,"easy":"إذا وُلّيت القضاء ← فقد ذُبحت بغير سكين","cause":"مَنْ وُلِّيَ للقضاءِ","result":"فقد ذُبحَ بغيرِ سِكِّينٍ","explicit":true,"repOf":"س-01668","ref":"البدر المنير 9/547","text":[["مَنْ وُلِّيَ للقضاءِ",1]," ",["فقد ذُبحَ بغيرِ سِكِّينٍ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه أبو داود (3571) واللفظ له، والترمذي (1325) مطولاً","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"LcP3nqIB"},{"id":"س-01674","fp":"258c902b56de","stateId":602,"easy":"إذا وليت القضاء ← فقد ذُبحت بغير سكين","cause":"من ولِيَ القَضَاءَ أو جُعِلَ قاضيًا بين النَّاسِ","result":"فقدْ ذُبِحَ بغيرِ سِكِّينٍ","explicit":true,"ref":"صحيح الترغيب 2171","srcLabel":"أبو داود","text":[["من ولِيَ القَضَاءَ أو جُعِلَ قاضيًا بين النَّاسِ ؛ ",1],["فقدْ ذُبِحَ بغيرِ سِكِّينٍ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه أبو داود (3571) مختصراً، والترمذي (1325) واللفظ له","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"p1T3mOjf"},{"id":"س-00593","fp":"64868885da4c","stateId":602,"easy":"إذا جُعلت قاضياً ← فكأنما ذُبحت بغير سكين","cause":"مَن جُعِلَ قاضِيًا","result":"فكأنَّما ذُبِحَ بغيرِ سِكِّينٍ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 7213","srcLabel":"أبو داود","text":[["مَن جُعِلَ قاضِيًا",1]," ",["فكأنَّما ذُبِحَ بغيرِ سِكِّينٍ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داود (3571)، وابن ماجة (2308)، وأحمد (7145) باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"OPcCSTJx","merged":2,"otherRefs":["حاشية الإلمام لابن عبد الهادي 638 (حسن)"]},{"id":"س-02491","fp":"262047e9aca4","stateId":602,"easy":"إذا سألت الولاية أو حرصت عليها ← لا تُولّاها","cause":"أحدًا سأَله ولا أحدًا حرَص عليه","result":"لا نُولِّي على هذا العملِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح ابن حبان 4481","srcLabel":"مسلم","text":["دخَلْتُ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّم أنا ورجلانِ مِن بني عمِّي فقال أحدُ الرَّجُلينِ: يا رسولَ اللهِ أمِّرْنا على بعضِ ما ولَّاك اللهُ وقال الآخَرُ مِثْلَ ذلك فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ( إنَّا واللهِ ",["لا نُولِّي على هذا العملِ",2]," ",["أحدًا سأَله ولا أحدًا حرَص عليه",1]," )"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (1733)، وأبو يعلى (7320)، وابن أبي شيبة (32541)، وابن الجارود في ((المنتقى)) (372) واللفظ لهم.","bab":"إمامة وخلافة › تولية الولاة وغيرهم","dorar":"YHIk9K7r","merged":2,"otherRefs":["صحيح البخاري 7149 (صحيح)"]},{"id":"س-05158","fp":"9e4a60aac06c","stateId":602,"easy":"إذا وليت أمر الناس ← توشك أن تتمنى أنك خررت من الثريا","cause":"يَلِ مِن أمرِ النَّاسِ شيئًا","result":"لَيُوشِكُ رَجُلٌ أنْ يتمَنَّى أنَّه خَرَّ مِن الثُّرَيَّا","explicit":true,"otherNeedIds":[70],"ref":"المستدرك على الصحيحين 7210","srcLabel":"أحمد","text":["عن يَزِيدَ بْنِ شَرِيكٍ، أنَّ الضَّحَّاكَ بنَ قَيْسٍ بعَثَ معه بكُسْوةٍ إلى مَرْوانَ بنِ الحَكَمِ، فقال مَرْوانُ للبَوَّابِ: انظُرْ مَن بالبابِ؟ قالَ: أبو هُرَيرةَ، فأذِنَ له، فقالَ: يا أبا هُرَيرةَ، حَدِّثْنا شيئًا سَمِعْتَه مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، قالَ: سَمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["لَيُوشِكُ رَجُلٌ أنْ يتمَنَّى أنَّه خَرَّ مِن الثُّرَيَّا",2]," ولَمْ ",["يَلِ مِن أمرِ النَّاسِ شيئًا",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (10927)، والبزار (9629) باختلاف يسير، وابن حبان (4483) بنحوه دون ذكر قصته","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"4IjtsCwZ"},{"id":"س-05928","fp":"de232a3bb155","stateId":602,"easy":"إذا لزمت أبواب السلطان ← فقد أصبح صعباً هبوطاً","cause":"وأبوابَ السلطانِ","result":"فإِنَّه قَدْ أصبحَ صعبًا هُبُوطًا","explicit":true,"ref":"صحيح الجامع 2672","srcLabel":"البيهقي","text":["إيَّاكم ",["وأبوابَ السلطانِ",1]," ؛ ",["فإِنَّه قَدْ أصبحَ صعبًا هُبُوطًا",2]],"grade":"صحيح","narrator":"رجل من بني سليم","muhaddith":"صحيح","takhrij":"أخرجه البيهقي (8959)، وأبو نعيم في ((معرفة الصحابة)) (5072)، وابن عساكر في ((تاريخ دمشق)) (9970) جميعا بلفظه.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"4qFf8Ql5"},{"id":"س-07265","fp":"3b22c6cbc9ca","stateId":602,"easy":"إذا أخذت الإمارة بغير حقها ← تكون عليك حسرة يوم القيامة","cause":"لمن أخذها بغيرِ حقِّها","result":"تكون عليه حسرةً يومَ القيامةِ","explicit":true,"ref":"مجمع الزوائد 5/203","srcLabel":"ابن حبان","text":["أنه قال عند النبيِّ صلَّى اللهُ عليه وسلَّمَ بئس الشيءُ الإمارةُ فقال النبيُّ صلَّى اللهُ عليه وسلَّمَ نعمَ الشيءِ الإمارةُ لمن أخذها بحقِّها وبئس الشيءُ الإمارةُ ",["لمن أخذها بغيرِ حقِّها",1]," ",["تكون عليه حسرةً يومَ القيامةِ",2]],"grade":"صحيح","narrator":"زيد بن ثابت","muhaddith":"[فيه] حفص بن عمر بن الصباح الرقي وثقه ابن حبان ، وبقية رجاله رجال الصحيح","takhrij":"أخرجه الطبراني (4831) (5/ 127) واللفظ له.","bab":"فتن › أمراء الجور","dorar":"ceMOHYQV"},{"id":"س-03073","fp":"74f23b386d10","stateId":602,"easy":"إذا حرصت على الإمارة ← تكون ندامة وحسرة عليك يوم القيامة","cause":"الإمارَةِ","result":"وإِنَّها ستكونُ ندامَةً وحسرَةً يومَ القيامَةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الجامع 2304","srcLabel":"البخاري","text":["إِنَّكم ستَحْرِصُونَ علَى ",["الإمارَةِ",1]," ، ",["وإِنَّها ستكونُ ندامَةً وحسرَةً يومَ القيامَةِ",2]," ، فنِعْمَ الْمُرِضَعَةُ ، وبئستِ الفاطِمَةُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (7148)، والنسائي (4211)، وأحمد (9791) واللفظ لهم.","bab":"إيمان › الوعيد","dorar":"YSwMypwZ","merged":3,"otherRefs":["صحيح النسائي 4222 (صحيح)","تخريج المسند لشعيب 10162 (صحيح)"]},{"id":"س-02495","fp":"381c6d3dba69","stateId":602,"easy":"إذا سألت العمل ← لا يُستعان بك","cause":"مَن سَأَلَناه","result":"إنَّا لا نَستعينُ في عملِنا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 19741","srcLabel":"النسائي","text":["عن أبي موسى الأشعَريِّ قال: أتاني ناسٌ مِن الأشعَريِّينَ فقالوا: اذهَبْ معنا إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؛ فإنَّ لنا حاجةً، قال: فقُمتُ معهم، فقالوا: يا رسولَ اللهِ، استعِنْ بنا في عملِكَ، فاعتَذَرتُ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ ممَّا قالوا، وقُلتُ: لم أدْرِ ما حاجتُهم، فصَدَّقَني رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ وعذَرَني، وقال: ",["إنَّا لا نَستعينُ في عملِنا",2]," ",["مَن سَأَلَناه",1],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه النسائي (5382)، وأحمد (19741) واللفظ له","bab":"إمامة وخلافة › تولية الولاة وغيرهم","dorar":"mFbKYviy"},{"id":"س-08408","fp":"166133e212f0","stateId":603,"easy":"إذا دخلت مساكن الظالمين فادخلها باكياً ← حذراً أن يصيبك مثل ما أصابهم","cause":"لا تَدخُلوا مَساكِنَ الذينَ ظَلَموا أنفُسَهُم، إلَّا أن تَكونوا باكينَ","result":"حَذَرًا أن يُصيبَكُم مِثلُ ما أصابَهُم","explicit":true,"star":true,"ref":"صحيح مسلم 2980","srcLabel":"البخاري","text":["مَرَرنا مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم على الحِجرِ، فقال لَنا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["لا تَدخُلوا مَساكِنَ الذينَ ظَلَموا أنفُسَهُم، إلَّا أن تَكونوا باكينَ",1],"؛ ",["حَذَرًا أن يُصيبَكُم مِثلُ ما أصابَهُم",2],"، ثُمَّ زَجَرَ فأسرَعَ حتَّى خَلَّفَها."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3380، 3381) مفرقاً باختلاف يسير","bab":"مناقب وفضائل › فضائل أماكن متعددة من الأرض وما ورد ذمه","dorar":"az5WHIeY","merged":5,"otherRefs":["صحيح البخاري 4419 (صحيح)","صحيح البخاري 3380 (صحيح)","تخريج المسند لشعيب 5645 (صحيح)","حلية الأولياء 5/124 (صحيح)"]},{"id":"س-07399","fp":"048e0bc88b34","stateId":603,"easy":"إذا كنت في قوم نزل بهم الخسف ← تُبعث على نيتك","cause":"وفيهم أسواقُهم ومَن ليس منهم","result":"ثُمَّ يُبعَثونَ على نيَّاتِهم","explicit":true,"star":true,"otherNeedIds":[51],"ref":"صحيح البخاري 2118","srcLabel":"متفق عليه","text":["يَغزو جَيشٌ الكَعبةَ، فإذا كانوا ببَيداءَ مِنَ الأرضِ يُخسَفُ بأوَّلِهم وآخِرِهم. قالت: قُلتُ: يا رَسولَ اللهِ، كيفَ يُخسَفُ بأوَّلِهم وآخِرِهم ",["وفيهم أسواقُهم ومَن ليس منهم",1],"؟ قال: يُخسَفُ بأوَّلِهم وآخِرِهم، ",["ثُمَّ يُبعَثونَ على نيَّاتِهم",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2118)، ومسلم (2884)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"a5YVgrjE","merged":4,"otherRefs":["تخريج صحيح ابن حبان 7314 (صحيح)","تخريج صحيح ابن حبان 6755 (صحيح)","فيض القدير 2/ 202 (صحيح)"]},{"id":"س-07478","fp":"b29c32806be0","stateId":603,"easy":"إذا خرجت مكرهاً مع قوم أُهلكوا ← تُبعث على نيتك يوم القيامة","cause":"كيْف بمَن يَخرُجُ كارهًا","result":"ولكنَّه يُبعَثُ على نيَّتِه يَومَ القيامةِ","explicit":true,"otherNeedIds":[51,65,19],"ref":"المستدرك على الصحيحين 8541","srcLabel":"مسلم","text":["عن عُبيدِ اللهِ بنِ القِبْطيَّةِ، قال: دخَلَ الحارثُ بنُ أبي رَبيعةَ وعبدُ اللهِ بنُ صَفْوانَ وأنا معهما على أُمِّ سَلَمةَ رَضيَ اللهُ عنها، فسَألاها عن الجيشِ الَّذي يُخسَفُ به، وكان ذلكَ في أيَّامِ ابنِ الزُّبيرِ، فقالت أُمُّ سَلَمةَ رَضيَ اللهُ عنها: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: يَعوُذُ عائذٌ بالحرمِ، فيُبعَثُ إليه بجيشٍ، فإذا كانوا ببَيْداءَ مِنَ الأرضِ يُخسَفُ بهم، فقُلتُ: يا رَسولَ اللهِ، ",["كيْف بمَن يَخرُجُ كارهًا",1],"؟ قال: يُخسَفُ به معهم، ",["ولكنَّه يُبعَثُ على نيَّتِه يَومَ القيامةِ",2],"، ثمَّ قالت: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يَعوُذُ عائذٌ بالبيتِ."],"grade":"صحيح","narrator":"أم سلمة","muhaddith":"صحيح الإسناد على شرط الشيخين، ولم يخرجاه","takhrij":"أخرجه مسلم (2882)، وأحمد (26487) كلاهما باختلاف يسير، وأبو داوود (4289) بعضه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"mdVAel0R","merged":4,"otherRefs":["تخريج صحيح ابن حبان 6756 (صحيح)","صحيح الجامع 7465 (صحيح)","صحيح أبي داود 4289 (صحيح)"]},{"id":"س-08054","fp":"9d97c7ea71af","stateId":603,"easy":"إذا كان أحد يُقتل ظلماً فلا تحضر مكانه ← لئلا تنزل السخطة فتصيبك","cause":"فلا تحضُروا مكانَه","result":"فلعَلَّه يُقتَلُ ظُلمًا فتَنزِلُ السُّخطةُ فتُصيبُكم","explicit":true,"otherNeedIds":[28],"ref":"فيض القدير 636","srcLabel":"فيض القدير","text":["إذا رأيتُم الرَّجُلَ يُقتَلُ صَبرًا ",["فلا تحضُروا مكانَه",1]," ",["فلعَلَّه يُقتَلُ ظُلمًا فتَنزِلُ السُّخطةُ فتُصيبُكم",2],"."],"grade":"حسن","narrator":"خرشة بن الحارث","muhaddith":"حسن.","bab":"مظالم › تحريم الظلم","dorar":"mwBZK1EO"},{"id":"س-07295","fp":"2ec9bf1a162b","stateId":603,"easy":"إذا تعرضت للفتن ← تنسفك (أثر حذيفة)","cause":"شَخِصَ منها أحدٌ","result":"إلَّا نَسَفَتْه كما يَنسِفُ السَّيلُ الدَّمِنَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"المستدرك على الصحيحين 8605","srcLabel":"معمر","text":["عن حُذَيفةَ، قال: إيَّاكَ والفِتَنَ، لا يَشخَصْ لها أحدٌ، فواللهِ ما ",["شَخِصَ منها أحدٌ",1]," ",["إلَّا نَسَفَتْه كما يَنسِفُ السَّيلُ الدَّمِنَ",2],"، إنَّها مُشْبِهةٌ مُقْبِلةٌ، حتَّى يَقولَ الجاهلُ: هذه تُشبِهُ مُقْبِلةٌ، وتَتبيَّنُ مُدْبِرةً، فإذا رأيْتُموها، فاحْتُموا في بُيوتِكم، واكْسِروا سُيوفَكم، وقَطِّعوا أوْتارَكم، وغَطُّوا وُجوهَكم."],"grade":"صحيح","narrator":"عمارة بن عبد","muhaddith":"صحيح الإسناد، ولم يخرجاه","takhrij":"أخرجه معمر بن راشد في ((الجامع)) (20740)، وعبد الرزاق (21817)، ونعيم بن حماد في ((الفتن)) (343) جميعا باختلاف يسير.","bab":"فتن › ظهور الفتن","dorar":"Nmx8Hwsn"},{"id":"س-05202","fp":"0e67ea6e481a","stateId":604,"easy":"إذا تداويت بحرام ← لم يجعل الله لك فيه شفاء","cause":"من تداوى بحرامٍ","result":"لم يجعلِ اللهُ له فيه شفاءً","explicit":true,"ref":"السلسلة الصحيحة 2881","srcLabel":"أبو نعيم","text":[["من تداوى بحرامٍ ",1],["لم يجعلِ اللهُ له فيه شفاءً",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن بجموع الطرق","takhrij":"أخرجه أبو نعيم في ((الطب النبوي)) (53)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"TqMn9LWI"},{"id":"س-06773","fp":"44392371e60e","stateId":604,"easy":"إذا تداويت بحرام ← فالله لم يجعل شفاءكم فيما حرّم عليكم","cause":"في حرامٍ","result":"إنَّ اللهَ لم يجعَلْ شفاءَكم","explicit":true,"ref":"صحيح ابن حبان 1391","srcLabel":"ابن حبان","text":["قالت أمُّ سَلمةَ: اشتكتِ ابنةٌ لي فنبَذْتُ لها في كوزٍ فدخَل النَّبيُّ صلَّى اللهُ عليه وسلَّم وهو يغلي فقال: ( ما هذا ) ؟ فقالت: إنَّ ابنتي اشتكتْ فنبَذْنا لها هذا فقال صلَّى اللهُ عليه وسلَّم: ( ",["إنَّ اللهَ لم يجعَلْ شفاءَكم",2]," ",["في حرامٍ",1]," )"],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"أخرجه في صحيحه","bab":"طهارة › النبيذ","dorar":"W94yIC7Q","merged":2,"otherRefs":["إرشاد الساري 8/328 (صحيح)"]},{"id":"س-03646","fp":"79100f145f66","stateId":604,"easy":"إذا اكتويت ← فما أفلحت ولا أنجحت (أثر عمران)","cause":"حتى اكتَويتُ","result":"فما أفلحتُ ولا أنجحتُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"الاستذكار 7/422","srcLabel":"مسلم","text":["سمعت النبيَّ صلَّى اللهُ عليهِ وسلمَ  يَنهَى عن الكيِّ ، قال : فما زال البلاءُ بي ",["حتى اكتَويتُ",1]," ، ",["فما أفلحتُ ولا أنجحتُ ،",2]," قال عمرانُ : وكان يُسلِّمُ علَيَّ ، فلما اكتويتُ ، فقدتُ ذلكَ ثم راجعَه بعدَ ذلكَ السلامَ"],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3865)، والترمذي (2049)، وابن ماجه (3490) باختلاف يسير دون قوله عمران. وقول عمران أخرجه مسلم (1226) بلفظ مقارب","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"WVvYefMV","merged":8,"otherRefs":["صحيح ابن ماجه 2828 (صحيح)","المجموع للنووي 9/63 (صحيح)","الصحيح المسند 1022 (صحيح)","تخريج المسند لشعيب 19989 (صحيح)","تخريج المسند لشعيب 20004 (صحيح)","تخريج سنن أبي داود 3865 (صحيح)","تخريج زاد المعاد 4/59 (صحيح)"]},{"id":"س-05319","fp":"05951187be2c","stateId":604,"easy":"إذا علّقت تميمة ← فلا أتم الله لك","cause":"من تعلَّقَ تميمةً","result":"فلا أتمَّ اللهُ له","explicit":true,"ref":"فتاوى نور على الدرب لابن باز 1/341","srcLabel":"أحمد","text":[["من تعلَّقَ تميمةً ",1],["فلا أتمَّ اللهُ له ",2],"ومن تعلقَ ودعةً فلا ودعَ اللهُ له وفي روايةٍ عنه أنه قال: من تعلَّقَ تميمةً فقد أشرك."],"grade":"صحيح","narrator":"[عقبة بن عامر ]","muhaddith":"ثابت","takhrij":"أخرجه أحمد (17404)، وأبو يعلى (1759)، والطبراني في ((مسند الشاميين)) (234)","bab":"رقائق وزهد › التوكل واليقين","dorar":"ySo0C7r5"},{"id":"س-05320","fp":"8fd65e44ca31","stateId":604,"easy":"إذا علّقت ودعة ← فلا ودع الله لك","cause":"ومن تعلقَ ودعةً","result":"فلا ودعَ اللهُ له","explicit":true,"ref":"فتاوى نور على الدرب لابن باز 1/341","srcLabel":"أحمد","text":["من تعلَّقَ تميمةً فلا أتمَّ اللهُ له ",["ومن تعلقَ ودعةً ",1],["فلا ودعَ اللهُ له",2]," وفي روايةٍ عنه أنه قال: من تعلَّقَ تميمةً فقد أشرك."],"grade":"صحيح","narrator":"[عقبة بن عامر ]","muhaddith":"ثابت","takhrij":"أخرجه أحمد (17404)، وأبو يعلى (1759)، والطبراني في ((مسند الشاميين)) (234)","bab":"رقائق وزهد › التوكل واليقين","dorar":"ySo0C7r5"},{"id":"س-05370","fp":"04716012f056","stateId":604,"easy":"إذا تطيرت ← فالطيرة على من تطير","cause":"مَن تطيَّر","result":"والطِّيَرةُ على","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح ابن حبان 6123","srcLabel":"متفق عليه","text":["لا طِيَرةَ ",["والطِّيَرةُ على",2]," ",["مَن تطيَّر",1]," وإنْ تَكُ في شيءٍ ففي الدَّارِ والفرَسِ والمرأةِ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (2323) واللفظ له، والبخاري (5756)، ومسلم (2224) باختلاف يسير.","bab":"رقائق وزهد › التوكل واليقين","dorar":"ltiDNP07"},{"id":"س-03614","fp":"5af62df6c512","stateId":605,"easy":"إذا أرضعت وأنت حامل (الغيل) ← يضر الولد حتى يُسقطه عن فرسه كبيراً","cause":"لا تقتُلوا أولادَكُم سرًّا","result":"فإنَّ قتلَ الغَيلِ يدرِكُ الفارسَ فيُدَعْثرُهُ عن ظَهْرِ فرسِهِ","explicit":true,"star":true,"ref":"نخب الافكار 10/465","srcLabel":"أبو داود","text":[["لا تقتُلوا أولادَكُم سرًّا ",1],["فإنَّ قتلَ الغَيلِ يدرِكُ الفارسَ فيُدَعْثرُهُ عن ظَهْرِ فرسِهِ",2]],"grade":"صحيح","narrator":"أسماء بنت يزيد أم سلمة الأنصارية","muhaddith":"طريقه صحيح","takhrij":"أخرجه أبو داود (3881) واللفظ له، وابن ماجه (2012)، وأحمد (27590) باختلاف يسير","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"7hhavOl5","merged":2,"otherRefs":["صحيح الجامع 7391 (حسن)"]},{"id":"س-05123","fp":"0e08ccf0b183","stateId":605,"easy":"إذا شربت قائماً ← فلو علمت ما في جوفك لاستقأت","cause":"يَشرَبُ قائمًا","result":"ما في جَوفِه لاستَقاءَ","explicit":true,"star":true,"otherNeedIds":[13,35],"ref":"تخريج مشكل الآثار 2100","srcLabel":"مسلم","text":["لو يَعلَمُ الذي ",["يَشرَبُ قائمًا",1]," ",["ما في جَوفِه لاستَقاءَ",2],"، فبَلَغَ ذلك عليَّ بنَ أبي طالبٍ رضِيَ اللهُ عنه، فقام فشَرِبَ قائمًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (2100) واللفظ له، ومسلم (2026) بمعناه، وأحمد (7808) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"gev9mY8F","merged":2,"otherRefs":["تخريج المسند لشعيب 7808 (صحيح)"]},{"id":"س-05773","fp":"3867bb835c42","stateId":605,"easy":"إذا بتّ وفي يدك ريح الطعام (غمر) فأصابك شيء ← فلا تلومن إلا نفسك","cause":"يبيتُ و في يدِه رِيحُ غِمرٍ","result":"لا يلومنَّ امرؤٌ إلا نفسَه","explicit":true,"similar":["س-05903"],"otherNeedIds":[34],"ref":"صحيح الجامع 2658","srcLabel":"ابن ماجة","text":["ألا ",["لا يلومنَّ امرؤٌ إلا نفسَه",2]," ؛ ",["يبيتُ و في يدِه رِيحُ غِمرٍ",1]],"grade":"صحيح","narrator":"فاطمة بنت رسول الله صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجة (3296)، وأبو يعلى (6748) واللفظ لهما.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"UpMOM4ea"},{"id":"س-05800","fp":"4ac1c18cf28b","stateId":605,"easy":"إذا أطلت الجلوس في الشمس ← تُبلي الثوب وتنتن الريح وتظهر الداء الدفين","cause":"إيَّاكمْ و الجلوسَ في الشمسِ","result":"فإنها تبُلِي الثوبَ، و تُنتنُ الريحَ، و تُظهِرُ الداءَ الدفينَ","explicit":true,"ref":"الجامع الصغير 2907","srcLabel":"الحاكم","text":[["إيَّاكمْ و الجلوسَ في الشمسِ،  ",1],["فإنها تبُلِي الثوبَ،  و تُنتنُ الريحَ،  و تُظهِرُ الداءَ الدفينَ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (8264)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"XNs3QU7j"},{"id":"س-05903","fp":"a59a02d68e89","stateId":605,"easy":"إذا نمت وفي يدك غمر ولم تغسله فأصابك شيء ← فلا تلومن إلا نفسك","cause":"مَن نامَ وفي يَدِه غَمرٌ، ولم يَغسِلْه","result":"فأصابَه شَيءٌ، فلا يَلومَنَّ إلَّا نَفْسَه","explicit":true,"repOf":"س-05773","ref":"تخريج سنن أبي داود 3852","text":["قال: قال رَسولُ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ: ",["مَن نامَ وفي يَدِه غَمرٌ، ولم يَغسِلْه، ",1],["فأصابَه شَيءٌ، فلا يَلومَنَّ إلَّا نَفْسَه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (1859) مطولاً باختلاف يسير، وأحمد (7569)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"sHqxvb8a"},{"id":"س-06192","fp":"748cfc4a06f1","stateId":605,"easy":"إذا تركت الخلال ← يوهن أسنانك","cause":"تَرْكُ الخِلالِ","result":"يوهِنُ الأسنانَ","explicit":true,"ref":"إرواء الغليل 1974","srcLabel":"الطبراني","text":["[ عنِ ] ابنِ عُمَرَ: ",["تَرْكُ الخِلالِ",1]," ",["يوهِنُ الأسنانَ",2]],"grade":"صحيح","narrator":"محمد بن سيرين","muhaddith":"صحيح","takhrij":"أخرجه أبو نعيم في ((الطب النبوي)) (331)، والمستغفري في ((الطب النبوي)) (461) واللفظ لهما، والطبراني في ((المعجم الكبير)) (12/ 265) (13065) بنحوه.","bab":"زينة اللباس › اللباس الحسن والنظافة","dorar":"7eF0DlJT"},{"id":"س-05950","fp":"c645379e898e","stateId":605,"easy":"إذا قاربت الوباء (القرف) ← فقد يكون منه التلف","cause":"القَرَفِ","result":"التَّلَفَ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"سفر السعادة 281","srcLabel":"سفر السعادة","text":["أنَّ من ",["القَرَفِ",1]," ",["التَّلَفَ",2]],"grade":"صحيح","muhaddith":"ثابت","bab":"رقائق وزهد › الوصايا النافعة","dorar":"Zyd9SG41"},{"id":"س-05220","fp":"e35b74ab4177","stateId":606,"easy":"إذا خذفت (رميت الحصى بين الأصابع) ← قد تكسر السن وتفقأ العين","cause":"يَخذِفُ","result":"قد تَكسِرُ السِّنَّ، وتَفقَأُ العَينَ","explicit":true,"ref":"صحيح البخاري 5479","srcLabel":"مسلم","text":["أنَّه رَأى رَجُلًا ",["يَخذِفُ",1],"، فقال له: لا تَخذِفْ؛ فإنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم نَهى عَنِ الخَذفِ -أو كان يَكرَهُ الخَذفَ- وقال: إنَّه لا يُصادُ به صَيدٌ ولا يُنكى به عَدوٌّ، ولَكِنَّها ",["قد تَكسِرُ السِّنَّ، وتَفقَأُ العَينَ",2],". ثُمَّ رَآهُ بَعدَ ذلك يَخذِفُ، فقال له: أُحَدِّثُكَ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم أنَّه نَهى عَنِ الخَذفِ -أو كَرِهَ الخَذفَ- وأنتَ تَخذِفُ! لا أُكَلِّمُكَ كَذا وكَذا."],"grade":"صحيح","narrator":"عبدالله بن مغفل","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1954)، وابن ماجة (3226)، وابن حبان (5949) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"1pzELIPm"},{"id":"س-05111","fp":"5cb13749624b","stateId":606,"easy":"إذا اطلع أحد على بيتك بغير إذنك ← فلا جناح عليك","cause":"اطَّلَعَ- بِغَيْرِ إذْنِك","result":"ففقَأْتَ عَيْنَه؛ ما كان عليك جُناحٌ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 7313","srcLabel":"متفق عليه","text":["لو أنَّ رَجُلًا اطَّلَعَ -وقال مرَّةً: لو أنَّ امْرَأً ",["اطَّلَعَ- بِغَيْرِ إذْنِك",1],"، فخذَفْتَه بِـحَصاةٍ ",["ففقَأْتَ عَيْنَه؛ ما كان عليك جُناحٌ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6888)، ومسلم (2158) بلفظ مقارب","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"hlKsY48f","merged":8,"otherRefs":["إرواء الغليل 7/284 (صحيح)","صحيح البخاري 6888 (صحيح)","صحيح النسائي 4876 (صحيح)","تخريج المسند لشعيب 9525 (صحيح)","تخريج سنن الدارقطني 4274 (صحيح)","تخريج صحيح ابن حبان 6003 (صحيح)","تخريج مشكل الآثار 932 (حسن)"]},{"id":"س-05774","fp":"993c6655fab0","stateId":606,"easy":"إذا خذفت ← تكسر السن وتفقأ العين ولا تنكي العدو","cause":"إياكم والخذْفَ","result":"فإِنَّها تَكْسِرُ السِّنَّ ، وتَفْقَأُ العَيْنَ ، ولَا تُنْكِي العدُوَّ","explicit":true,"ref":"صحيح الجامع 2676","srcLabel":"مسلم","text":[["إياكم والخذْفَ ، ",1],["فإِنَّها تَكْسِرُ السِّنَّ ، وتَفْقَأُ العَيْنَ ، ولَا تُنْكِي العدُوَّ",2]],"grade":"صحيح","narrator":"عبدالله بن مغفل","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (18/ 227) (566) واللفظ له، ومسلم (1954)، وابن ماجة (3226) بنحوه مطولًا.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"wb1u52gk"},{"id":"س-05124","fp":"4d4a25d1e71d","stateId":606,"easy":"إذا اطلعت في بيت غيرك بغير إذن ← تستحق فقء عينك","cause":"فأَلقَم عيْنَيْهِ خَصاصةَ البابِ","result":"أمَا إنَّكَ لو ثبَتَّ لَفقَأْتُ عيْنَكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج مشكل الآثار 937","srcLabel":"متفق عليه","text":["أنَّ أعرابيًّا أتى رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ ",["فأَلقَم عيْنَيْهِ خَصاصةَ البابِ",1],"، فبَصُر به رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فأخَذ سَهمًا، أو عودًا مُحدَّدًا، وجاء به لِيفقَأَ عيْنَ الأعرابيِّ، فانقمَع الأعرابيُّ، وذهَب، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["أمَا إنَّكَ لو ثبَتَّ لَفقَأْتُ عيْنَكَ",2],"."],"grade":"صحيح","narrator":"أنس","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (937) واللفظ له، والبخاري (6242)، ومسلم (2157) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"6E1VcZU3","merged":3,"otherRefs":["صحيح الأدب المفرد 815 (صحيح)","الأحاديث المختارة 1531 (صحيح)"]},{"id":"س-00223","fp":"dfa409f095f7","stateId":606,"easy":"إذا لعنت دابتك ← لا تركبها","cause":"ركِبَتْ جَملًا، فلعَنَتْه","result":"لا تَرْكَبيهِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[13],"ref":"تخريج المسند لشعيب 25074","srcLabel":"أحمد","text":["أنَّها ",["ركِبَتْ جَملًا، فلعَنَتْه",1],"، فقال لها النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",["لا تَرْكَبيهِ",2],"."],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (25074) واللفظ له، وأبو يعلى (4735)","bab":"آداب المجلس › الركوب على الدابة","dorar":"tjchn3hK"}]}