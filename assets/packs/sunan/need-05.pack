{"schema":1,"kind":"sunan-chunk","version":"sunan-c56d7b8d0f22","needId":5,"stateIds":[34,35,36,37,38],"items":[{"id":"س-08207","fp":"a787a4aad3c7","stateId":34,"easy":"إذا قرأت القرآن ← تنزل السكينة عند قراءتك","cause":"اقرَأْ فُلانُ","result":"فإنَّها السَّكينةُ تَنَزَّلَت عِندَ القُرآنِ، أو تَنَزَّلَت للقُرآنِ","explicit":true,"star":true,"similar":["س-08376"],"ref":"صحيح مسلم 795","srcLabel":"البخاري","text":["قَرَأ رَجُلٌ الكَهفَ، وفي الدَّارِ دابَّةٌ، فجَعَلَت تَنفِرُ فنَظَرَ فإذا ضَبابةٌ أو سَحابةٌ قد غَشيَتْه، قال: فذَكَرَ ذلك للنَّبيِّ صلَّى اللهُ عليه وسلَّم، فقال: ",["اقرَأْ فُلانُ؛ ",1],["فإنَّها السَّكينةُ تَنَزَّلَت عِندَ القُرآنِ، أو تَنَزَّلَت للقُرآنِ",2],". [وفي روايةٍ]: سَمِعتُ البَراءَ يقولُ: فذَكَرا نَحوَه، غيرَ أنَّهُما قالا: تَنقُزُ."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3614)، وأحمد (18474) كلاهما بلفظه، والترمذي (2885) بنحوه .","bab":"ملائكة › أعمال الملائكة","dorar":"CZBoTcN1","merged":3,"otherRefs":["تخريج المسند لشعيب 18509 (صحيح)","صحيح البخاري 3614 (صحيح)"]},{"id":"س-08376","fp":"1fd4b331162e","stateId":34,"easy":"إذا قرأت القرآن ← تتنزل عليك السكينة (من واقعة)","cause":"يَقرَأُ","result":"تلك السَّكينةُ تَنزَّلَتْ لِلقُرآنِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-08207","ref":"تخريج المسند لشعيب 18591","text":["كان رَجُلٌ ",["يَقرَأُ",1]," في دارِه سورةَ الكَهفِ، وإلى جانِبِه  حِصانٌ له مَربوطٌ بشَطَنَينِ، حتى غَشيَتْه سَحابةٌ، فجَعَلَتْ تَدنو وتَدنو، حتى جَعَلَ فَرسُه يَنفِرُ منها! قال الرَّجُلُ: فعَجِبتُ لذلك، فلمَّا أصبَحَ أَتى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فذَكَرَ ذلك له وقَصَّ عليه، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",["تلك السَّكينةُ تَنزَّلَتْ لِلقُرآنِ",2],"."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (5011)، ومسلم (795) باختلاف يسير","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"ZRJksOhh","merged":6,"otherRefs":["تخريج صحيح ابن حبان 769 (صحيح)","تخريج المسند لشعيب 18637 (صحيح)","صحيح البخاري 5011 (صحيح)","حلية الأولياء 4/378 (صحيح)","صحيح الترمذي 2885 (صحيح)"]},{"id":"س-00743","fp":"49fba0c51ea1","stateId":34,"easy":"إذا اجتمعتم في بيت من بيوت الله تتلون القرآن وتتدارسونه ← تنزل عليكم السكينة وتغشاكم الرحمة وتحفّكم الملائكة ويذكركم الله","cause":"ما مِن قَومٍ يَجتمِعون في بَيتٍ مِن بُيوتِ اللهِ عزَّ وجلَّ، يَقْرَؤون ويتَعَلَّمون كِتابَ اللهِ عزَّ وجلَّ، يتَدارَسونه بَينَهم","result":"إلَّا حفَّتْ بهم الملائكةُ، وغشيَتْهم الرَّحمةُ، وذكَرَهم اللهُ فيمَن عِندَه","explicit":true,"star":true,"otherNeedIds":[24,26],"ref":"تخريج المسند لشعيب 9274","srcLabel":"مسلم","text":[["ما مِن قَومٍ يَجتمِعون في بَيتٍ مِن بُيوتِ اللهِ عزَّ وجلَّ، يَقْرَؤون ويتَعَلَّمون كِتابَ اللهِ عزَّ وجلَّ، يتَدارَسونه بَينَهم،",1]," ",["إلَّا حفَّتْ بهم الملائكةُ، وغشيَتْهم الرَّحمةُ، وذكَرَهم اللهُ فيمَن عِندَه",2],"، وما مِن رَجُلٍ يَسلُكُ طَريقًا يَلتَمِسُ به العِلْمَ، إلَّا سهَّلَ له به -أو سهَّلَ به- طَريقًا [إلى] الجنَّةِ، ومَن يُبطِئُ به عَمَلُه، لا يُسرِعُ به نَسَبُه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (2699)، والترمذي (2945)، وابن ماجه (225) مطولاً، وأبو داود (1455) مختصراً، وأحمد (9274) واللفظ له","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"n1MoFiZb"},{"id":"ق-0493","fp":"6c551d700396","stateId":34,"easy":"الإيمان والثبات مع الرسول ← السكينة والجنود وتعذيب الكافرين","cause":"الإيمان والثبات مع الرسول","result":"السكينة والجنود وتعذيب الكافرين","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[25],"ref":"سورة التوبة: 26","srcLabel":"القرآن الكريم","quran":{"s":9,"from":26,"to":26,"text":"ثُمَّ أَنْزَلَ اللَّهُ سَكِينَتَهُ عَلَى رَسُولِهِ وَعَلَى الْمُؤْمِنِينَ وَأَنْزَلَ جُنُودًا لَمْ تَرَوْهَا وَعَذَّبَ الَّذِينَ كَفَرُوا وَذَلِكَ جَزَاءُ الْكَافِرِينَ (26)","hl":[[0,168,1]]}},{"id":"ق-0499","fp":"4d90e6c1945b","stateId":34,"easy":"اليقين بمعية الله عند الخوف ← السكينة والتأييد بجنود وعلوّ كلمة الله","cause":"اليقين بمعية الله عند الخوف","result":"السكينة والتأييد بجنود وعلوّ كلمة الله","explicit":true,"star":true,"otherNeedIds":[25,6],"ref":"سورة التوبة: 40","srcLabel":"القرآن الكريم","quran":{"s":9,"from":40,"to":40,"text":"إِلَّا تَنْصُرُوهُ فَقَدْ نَصَرَهُ اللَّهُ إِذْ أَخْرَجَهُ الَّذِينَ كَفَرُوا ثَانِيَ اثْنَيْنِ إِذْ هُمَا فِي الْغَارِ إِذْ يَقُولُ لِصَاحِبِهِ لَا تَحْزَنْ إِنَّ اللَّهَ مَعَنَا فَأَنْزَلَ اللَّهُ سَكِينَتَهُ عَلَيْهِ وَأَيَّدَهُ بِجُنُودٍ لَمْ تَرَوْهَا وَجَعَلَ كَلِمَةَ الَّذِينَ كَفَرُوا السُّفْلَى وَكَلِمَةُ اللَّهِ هِيَ الْعُلْيَا وَاللَّهُ عَزِيزٌ حَكِيمٌ (40)","hl":[[120,339,1]]}},{"id":"ق-0628","fp":"83b340f8e671","stateId":34,"easy":"ذكر الله ← طمأنينة القلب","cause":"ذكر الله","result":"طمأنينة القلب","explicit":true,"ref":"سورة الرعد: 28","srcLabel":"القرآن الكريم","quran":{"s":13,"from":28,"to":28,"text":"الَّذِينَ آمَنُوا وَتَطْمَئِنُّ قُلُوبُهُمْ بِذِكْرِ اللَّهِ أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ (28)","hl":[[0,106,1]]}},{"id":"ق-1229","fp":"cee44b690ddf","stateId":34,"easy":"الإيمان ← إنزال السكينة وزيادة الإيمان ودخول الجنات وتكفير السيئات","cause":"الإيمان","result":"إنزال السكينة وزيادة الإيمان ودخول الجنات وتكفير السيئات","explicit":true,"otherNeedIds":[17,67,11],"ref":"سورة الفتح: 4–5","srcLabel":"القرآن الكريم","quran":{"s":48,"from":4,"to":5,"text":"هُوَ الَّذِي أَنْزَلَ السَّكِينَةَ فِي قُلُوبِ الْمُؤْمِنِينَ لِيَزْدَادُوا إِيمَانًا مَعَ إِيمَانِهِمْ وَلِلَّهِ جُنُودُ السَّمَاوَاتِ وَالْأَرْضِ وَكَانَ اللَّهُ عَلِيمًا حَكِيمًا (4) لِيُدْخِلَ الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا وَيُكَفِّرَ عَنْهُمْ سَيِّئَاتِهِمْ وَكَانَ ذَلِكَ عِنْدَ اللَّهِ فَوْزًا عَظِيمًا (5)","hl":[[0,374,1]]}},{"id":"ق-1241","fp":"761fc14f4021","stateId":34,"easy":"الإيمان ← السكينة ولزوم كلمة التقوى","cause":"الإيمان","result":"السكينة ولزوم كلمة التقوى","explicit":true,"otherNeedIds":[17],"ref":"سورة الفتح: 26","srcLabel":"القرآن الكريم","quran":{"s":48,"from":26,"to":26,"text":"إِذْ جَعَلَ الَّذِينَ كَفَرُوا فِي قُلُوبِهِمُ الْحَمِيَّةَ حَمِيَّةَ الْجَاهِلِيَّةِ فَأَنْزَلَ اللَّهُ سَكِينَتَهُ عَلَى رَسُولِهِ وَعَلَى الْمُؤْمِنِينَ وَأَلْزَمَهُمْ كَلِمَةَ التَّقْوَى وَكَانُوا أَحَقَّ بِهَا وَأَهْلَهَا وَكَانَ اللَّهُ بِكُلِّ شَيْءٍ عَلِيمًا (26)","hl":[[86,226,1]]}},{"id":"س-00300","fp":"4e1887a2cdbf","stateId":34,"easy":"إذا تركت ما يُريبك إلى ما لا يُريبك ← تجد الطمأنينة، فالصدق طمأنينة والكذب ريبة","cause":"دَعْ ما يُريبُكَ، إلى ما لا يُريبُكَ","result":"فإنَّ الصِّدقَ طُمَأنينةٌ، وإنَّ الكَذِبَ ريبةٌ","explicit":true,"similar":["س-08267"],"ref":"تخريج المسند لشعيب 1727","srcLabel":"الترمذي","text":["قلتُ لِلحَسَنِ بنِ علِيٍّ: ما تَذكُرُ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ قال: أذكُرُ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أنِّي أخَذتُ تَمْرةً مِن تَمْرِ الصَّدَقةِ، فجعَلتُها في فيَّ، قال: فنزَعَها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بِلُعابِها، فجعَلَها في التَّمْرِ. فقيل: يا رَسولَ اللهِ، ما كان عليكَ مِن هذه التَّمْرةِ لهذا الصَّبيِّ؟ قال: إنَّا آلَ محمدٍ لا تَحِلُّ لنا الصَّدَقةُ. قال: وكان يَقولُ: ",["دَعْ ما يُريبُكَ، إلى ما لا يُريبُكَ؛ ",1],["فإنَّ الصِّدقَ طُمَأنينةٌ، وإنَّ الكَذِبَ ريبةٌ",2],". قال: وكان يُعلِّمُنا هذا الدُّعاءَ: اللَّهمَّ اهدِني فيمَن هدَيتَ، وعافِني فيمَن عافَيتَ، وتوَلَّني فيمَن توَلَّيتَ، وبارِكْ لي فيما أعطَيتَ، وقِني شَرَّ ما قضَيتَ، إنَّكَ تَقضي، ولا يُقضى عليكَ، إنَّهُ لا يَذِلُّ مَن والَيتَ. قال شُعبةُ: وأظُنُّهُ قد قال هذه أيضًا: تبارَكتَ رَبَّنا وتَعالَيتَ. قال شُعبةُ: وقد حدَّثَني مَن سمِعَ هذه منه. ثم إنَّ شُعبةَ حدَّثَ بهذا الحَديثِ مَخرَجَهُ إلى المَهديِّ بَعدَ مَوتِ أبيهِ، فلم يَشُكَّ في (تبارَكتَ وتَعالَيتَ) فقلتُ لِشُعبةَ: إنَّكَ تَشُكُّ فيه؟ فقال: ليس فيه شَكٌّ."],"grade":"صحيح","narrator":"الحسن بن علي","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (2518)، والنسائي (5711) مختصراً، وأحمد (1727) واللفظ له","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"LOkXAAy5"},{"id":"س-08267","fp":"175b2b11c0cf","stateId":34,"easy":"إذا تركت ما يُريبك ← تجد الطمأنينة، فالخير طمأنينة والشر ريبة","cause":"دَعْ ما يَريبُكَ إلى ما لا يَريبُكَ","result":"الخيرُ طُمأنينةٌ والشَّرُّ رِيبةٌ","explicit":true,"repOf":"س-00300","ref":"تخريج صحيح ابن حبان 722","text":["( ",["دَعْ ما يَريبُكَ إلى ما لا يَريبُكَ",1]," ) قال ( ",["الخيرُ طُمأنينةٌ والشَّرُّ رِيبةٌ",2]," ) \nوأُتِي النَّبيُّ صلَّى اللهُ عليه وسلَّم بشيءٍ مِن تمرِ الصَّدقةِ فأخَذْتُ تمرةً فألقَيْتُها في فِيَّ فأخَذها بلُعابِها حتَّى أعادها في التَّمرِ فقيل له : يا رسولَ اللهِ ما كان عليكَ مِن هذه التَّمرةِ مِن هذا الصَّبيِّ ؟ فقال : ( إنَّا آلَ مُحمَّدٍ لا يحِلُّ لنا الصَّدقةُ ) \nوسمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يدعو بهذا الدُّعاءِ : ( اللَّهمَّ اهدِنا فيمَنْ هدَيْتَ وعافِنا فيمَنْ عافَيْتَ وتولَّنا فيمَنْ تولَّيْتَ وبارِكْ لنا فيما أعطَيْتَ وقِنا شرَّ ما قضَيْتَ إنَّك تَقضي ولا يُقضَى عليكَ إنَّه لا يذِلُّ مَن والَيْتَ تبارَكْتَ وتعالَيْتَ )"],"grade":"صحيح","narrator":"الحسن بن علي","muhaddith":"صحيح","takhrij":"أخرجه النسائي (5711) مختصراً، وأحمد (1723) مطولاً باختلاف يسير","bab":"مناقب وفضائل › أهل البيت صلوات الله عليهم","dorar":"9BsjJHss"},{"id":"س-02830","fp":"54c12cc1b699","stateId":34,"easy":"إذا كظمت غيظك وأنت قادر على إنفاذه ← يملأ الله قلبك أمناً وإيماناً","cause":"مَن كَظَمَ غيظًا وهو يَقْدِرُ على إنفاذِهِ","result":"ملأ اللهُ قَلْبَهُ أَمْنًا وإيمانًا","explicit":true,"otherNeedIds":[6,17],"ref":"الجامع الصغير 8978","srcLabel":"عبد الرزاق","text":[["مَن كَظَمَ غيظًا وهو يَقْدِرُ على إنفاذِهِ ",1],["ملأ اللهُ قَلْبَهُ أَمْنًا وإيمانًا",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه عبد الرزاق في ((تفسيره)) (458)، والطبري في ((تفسيره)) (6/ 59)، والعقيلي في ((الضعفاء)) (3/ 102) واللفظ لهم.","bab":"إيمان › الوعد","dorar":"gSg4boQ1"},{"id":"س-05861","fp":"3f6b43d1d19b","stateId":34,"easy":"إذا وثقت بثواب الله ← لا يضرك ما يمسك من أذى","cause":"مَنْ وَثَقَ بالثوابِ منَ اللهِ عزَّ وجلَّ","result":"لم يضرُّهُ مَسُّ الأذَى","explicit":true,"otherNeedIds":[16],"ref":"مجمع الزوائد 7/269","srcLabel":"الطبراني","text":["أنَّ جدَّهُ عميرُ بنُ حبيبِ بنِ حِمَاشَةَ وكان قَدْ أدرَكَ النبيَّ صلَّى اللهُ عليه وسلَّم عندَ احتلامِهِ أوصى ولَدَهُ فقال يا بُنَيَّ إياكَ ومُجَالَسَةَ السفهاءِ فإنَّ مجالَسَتِهِمْ داءٌ ومَنْ يَحْلُمْ عن السفيهِ يُسَرُّ ومن يُجِبْهُ يندمُ ومن لا يَرْضَى بالقليلِ مِمَّا يَأْتِي به السفيهُ يَرْضَى بالكثيرِ وإذا أرادَ أحدُكم أنْ يأمرَ بالمعروفِ أو يَنْهَى عنِ المنكَرِ فلْيُوَطِّنْ نَفْسَهُ على الصبرِ على الأذى ويثِقَ بالثوابِ مِنَ اللهِ تعالى فإنَّهُ ",["مَنْ وَثَقَ بالثوابِ منَ اللهِ عزَّ وجلَّ ",1],["لم يضرُّهُ مَسُّ الأذَى",2]],"grade":"حسن","narrator":"أبو جعفر الخطمي","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (2258)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"tBHB78bF"},{"id":"س-07761","fp":"f0eb85668a92","stateId":34,"easy":"إذا لم تخلط إيمانك بشرك ← فلك الأمن والهداية فتطمئن نفسك","cause":"أيُّنا لَم يَظلِمْ نَفسَه","result":"إنَّ الشِّركَ لَظُلمٌ عَظيمٌ، فطابَت أنفُسُهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"فتح البيان 10/ 283","srcLabel":"فتح البيان","text":["أنَّها لَمَّا نَزَلَت: (ولَم يَلبسوا إيمانَهم بظُلمٍ) شَقَّ ذلك على الصَّحابةِ وقالوا: ",["أيُّنا لَم يَظلِمْ نَفسَه",1],"؟ فأنزَلَ اللهُ {",["إنَّ الشِّركَ لَظُلمٌ عَظيمٌ}، فطابَت أنفُسُهم",2],"."],"grade":"صحيح","muhaddith":"صحيح","bab":"قرآن › أسباب النزول","dorar":"8Kq5Z7Gf"},{"id":"س-07824","fp":"cb55b62bea32","stateId":34,"easy":"إذا قرأت القرآن نهاراً وبتّ سالماً ليلاً ← تظل ذاكراً وتبيت سالماً (من واقعة)","cause":"يقرأُ المصحفَ بالنهارِ ويبيتُ بالليلِ","result":"أنَّ ابنَك يظَلُّ ذاكرًا ويبيتُ سالِمًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[31],"ref":"تخريج المسند لشاكر 10/111","srcLabel":"أيو","text":["أنَّ رجلًا أتَى النبيَّ صلَّى اللهُ عليه وسلَّم بابنٍ له فقالَ: يا رسولَ اللهِ إنَّ ابنِي هذا ",["يقرأُ المصحفَ بالنهارِ ويبيتُ بالليلِ",1]," فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ما تنقِمُ ",["أنَّ ابنَك يظَلُّ ذاكرًا ويبيتُ سالِمًا",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أيو يعلى كما في ((إتحاف الخيرة المهرة)) للبوصيري (6/340) باختلاف يسير","bab":"قرآن › فضل قراءة القرآن","dorar":"T7s7qtUc"},{"id":"س-07917","fp":"d49f69e07433","stateId":34,"easy":"إذا دخلت على مريض فطمأنته على أجله ← يطيب نفسه، ولا يردّ ذلك قدراً","cause":"إذا دخلتُمْ على المريضِ فنفِّسوا له في أجَلهِ","result":"فإنَّ ذلك لا يردُّ شيئًا ويطيِّبُ نفسَهُ","explicit":true,"ref":"هداية الرواة 2/171","srcLabel":"الترمذي","text":[["إذا دخلتُمْ على المريضِ فنفِّسوا له في أجَلهِ",1]," ",["فإنَّ ذلك لا يردُّ شيئًا ويطيِّبُ نفسَهُ",2]],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه الترمذي (2087)، وابن ماجه (1438)، والطبراني في ((الدعاء)) (1087)، والبيهقي في ((شعب الإيمان)) (9213) باختلاف يسير","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"bNRNfAgy"},{"id":"س-00929","fp":"f1bded4fd3e1","stateId":34,"easy":"إذا جلست في مجالس الذكر ← تنزل عليك السكينة وتحفّك الملائكة وتغشاك الرحمة ويذكرك الله","cause":"مجالسُ الذِّكْرِ","result":"تنزلُ عليهم السكينةُ ، وتَحُفُّ بهم الملائكةُ ، وتَغْشاهم الرحمةُ ، وَيَذْكرهم اللهُ على عرشِه","explicit":true,"otherNeedIds":[24,26],"ref":"الجامع الصغير 8150","srcLabel":"مسلم","text":[["مجالسُ الذِّكْرِ",1]," ",["تنزلُ عليهم السكينةُ ، وتَحُفُّ بهم الملائكةُ ، وتَغْشاهم الرحمةُ ، وَيَذْكرهم اللهُ على عرشِه",2]],"grade":"حسن","narrator":"أبو سعيد الخدري وأبو هريرة","muhaddith":"حسن","takhrij":"أخرجه الخطيب في ((تاريخ بغداد)) \n((4/ 216))، وأبو نعيم في ((حلية الأولياء)) ((5/ 118):) بلفظه، ومسلم (2700)، والترمذي (3378) بمعناه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"8rztlqJh"},{"id":"س-02478","fp":"cda901bc27fa","stateId":35,"easy":"إذا صمت ثلاثة أيام من كل شهر ← يذهب ما في صدرك من غلّ وضيق","cause":"صِيامُ ثَلاثةِ أيَّامٍ مِن الشَّهْرِ","result":"يُذهِبْنَ وَحَرَ الصَّدْرِ","explicit":true,"star":true,"similar":["س-02477"],"ref":"الصحيح المسند 1458","srcLabel":"الصحيح المسند","text":["كُنْتُ معَ مُطَرِّفٍ في سوقِ الإبِلِ، فجاءَه أعْرابيٌّ معَه قِطْعةُ أَديمٍ أو جِرابٍ، فقالَ: مَن يَقرَأُ -أو فيكم مَن يَقرَأُ- قُلْتُ: نَعمْ، فأَخَذْتُه، فإذا فيه «بِسْمِ اللهِ الرَّحْمنِ الرَّحيمِ، مِن مُحمَّدٍ رَسولِ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ لِبَني زُهَيْرِ بنِ أُقَيْشٍ -حَيٍّ مِن عُكلٍ- إنَّهم إن شَهِدوا أنْ لا إلهَ إلَّا اللهُ وأنَّ مُحمَّدًا رَسولُ اللهِ، وفارَقوا المُشرِكينَ، وأَقَرُّوا بالخُمُسِ في غَنائِمِهم، وسَهْمِ النَّبيِّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ وصَفِيِّه فإنَّهم آمِنونَ بأمانِ اللهِ ورَسولِه»، فقالَ له بعضُ القَوْمِ: هل سَمِعْتَ مِن رَسولِ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ شَيئًا تُحَدِّثُناه؟ قالَ: نَعمْ، قالوا: فحَدِّثْنا رَحِمَك اللهُ، قالَ: سَمِعْتُه يقولُ: «مَن سَرَّه أن يَذهَبَ كَثيرٌ مِن وَحَرِ صَدْرِه فلْيَصُمْ شَهْرَ الصَّبْرِ أو ثَلاثةَ أيَّامٍ مِن كلِّ شَهْرٍ»، فقالَ له القَوْمُ -أو بعضُهم- أَأنت سَمِعْتَ هذا مِن رَسولِ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ؟ فقالَ: أَلَا أَراكم تَتَّهِموني أن أَكذِبَ على رَسولِ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ؟ وقالَ إسْماعيلُ مَرَّةً: تَخافونَ واللهِ، لا حَدَّثْتُكم حَديثًا سائِرَ اليَوْمِ، ثُمَّ انْطَلَقَ.\nحَدَّثَنا سُفْيانُ بنُ عُيَيْنةَ، عن هارونَ بنِ رِئابٍ، عن ابنِ الشِّخِّيرِ، عن رَجُلٍ مِن بَني أُقَيْشٍ قالَ: معَه كِتابُ النَّبيِّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ...، قالَ: «",["صِيامُ ثَلاثةِ أيَّامٍ مِن الشَّهْرِ",1]," ",["يُذهِبْنَ وَحَرَ الصَّدْرِ",2],"»."],"grade":"صحيح","narrator":"رجل من بني أقيش","muhaddith":"صحيح","bab":"إسلام › قتال الناس حتى يسلموا","dorar":"SKHaD80L","merged":7,"otherRefs":["صحيح الموارد 785 (صحيح)","الصحيح المسند 2/422 (صحيح)","تخريج المسند لشعيب 23077 (صحيح)","صحيح النسائي 2384 (صحيح)","تخريج صحيح ابن حبان 6557 (صحيح)","صحيح النسائي 2385 (صحيح)"]},{"id":"ق-0374","fp":"82f6ccc9f827","stateId":35,"easy":"الإسلام والاهتداء ← انشراح الصدر","cause":"الإسلام والاهتداء","result":"انشراح الصدر","explicit":true,"star":true,"ref":"سورة الأنعام: 125","srcLabel":"القرآن الكريم","quran":{"s":6,"from":125,"to":125,"text":"فَمَنْ يُرِدِ اللَّهُ أَنْ يَهْدِيَهُ يَشْرَحْ صَدْرَهُ لِلْإِسْلَامِ وَمَنْ يُرِدْ أَنْ يُضِلَّهُ يَجْعَلْ صَدْرَهُ ضَيِّقًا حَرَجًا كَأَنَّمَا يَصَّعَّدُ فِي السَّمَاءِ كَذَلِكَ يَجْعَلُ اللَّهُ الرِّجْسَ عَلَى الَّذِينَ لَا يُؤْمِنُونَ (125)","hl":[[0,69,1]]}},{"id":"ق-0558","fp":"000375f1b86f","stateId":35,"easy":"القرآن (الأخذ بموعظته) ← شفاء لما في الصدور وهدى ورحمة","cause":"القرآن (الأخذ بموعظته)","result":"شفاء لما في الصدور وهدى ورحمة","explicit":true,"otherNeedIds":[15,24],"ref":"سورة يونس: 57","srcLabel":"القرآن الكريم","quran":{"s":10,"from":57,"to":57,"text":"يَا أَيُّهَا النَّاسُ قَدْ جَاءَتْكُمْ مَوْعِظَةٌ مِنْ رَبِّكُمْ وَشِفَاءٌ لِمَا فِي الصُّدُورِ وَهُدًى وَرَحْمَةٌ لِلْمُؤْمِنِينَ (57)","hl":[[22,130,1]]}},{"id":"ق-0662","fp":"ebf1abe33939","stateId":35,"easy":"التسبيح بحمد الله والسجود والعبادة حتى اليقين ← علاج ضيق الصدر مما يقوله الناس","cause":"التسبيح بحمد الله والسجود والعبادة حتى اليقين","result":"علاج ضيق الصدر مما يقوله الناس","explicit":true,"apply":{"k":"time","t":"في السجود"},"ref":"سورة الحجر: 97–99","srcLabel":"القرآن الكريم","quran":{"s":15,"from":97,"to":99,"text":"وَلَقَدْ نَعْلَمُ أَنَّكَ يَضِيقُ صَدْرُكَ بِمَا يَقُولُونَ (97) فَسَبِّحْ بِحَمْدِ رَبِّكَ وَكُنْ مِنَ السَّاجِدِينَ (98) وَاعْبُدْ رَبَّكَ حَتَّى يَأْتِيَكَ الْيَقِينُ (99)","hl":[[0,169,1]]}},{"id":"ق-1377","fp":"eccf13a5a35f","stateId":35,"easy":"المداومة على الصلاة والحق المعلوم في المال والتصديق بيوم الدين والإشفاق من عذاب الله وحفظ الفرج ورعاية الأمانة والعهد والقيام بالشهادة ← السلامة من الهلع والجزع والمنع، والإكرام في الجنات","cause":"المداومة على الصلاة والحق المعلوم في المال والتصديق بيوم الدين والإشفاق من عذاب الله وحفظ الفرج ورعاية الأمانة والعهد والقيام بالشهادة","result":"السلامة من الهلع والجزع والمنع، والإكرام في الجنات","explicit":true,"otherNeedIds":[67],"ref":"سورة المعارج: 19–35","srcLabel":"القرآن الكريم","quran":{"s":70,"from":19,"to":35,"text":"إِنَّ الْإِنْسَانَ خُلِقَ هَلُوعًا (19) إِذَا مَسَّهُ الشَّرُّ جَزُوعًا (20) وَإِذَا مَسَّهُ الْخَيْرُ مَنُوعًا (21) إِلَّا الْمُصَلِّينَ (22) الَّذِينَ هُمْ عَلَى صَلَاتِهِمْ دَائِمُونَ (23) وَالَّذِينَ فِي أَمْوَالِهِمْ حَقٌّ مَعْلُومٌ (24) لِلسَّائِلِ وَالْمَحْرُومِ (25) وَالَّذِينَ يُصَدِّقُونَ بِيَوْمِ الدِّينِ (26) وَالَّذِينَ هُمْ مِنْ عَذَابِ رَبِّهِمْ مُشْفِقُونَ (27) إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍ (28) وَالَّذِينَ هُمْ لِفُرُوجِهِمْ حَافِظُونَ (29) إِلَّا عَلَى أَزْوَاجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَانُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ (30) فَمَنِ ابْتَغَى وَرَاءَ ذَلِكَ فَأُولَئِكَ هُمُ الْعَادُونَ (31) وَالَّذِينَ هُمْ لِأَمَانَاتِهِمْ وَعَهْدِهِمْ رَاعُونَ (32) وَالَّذِينَ هُمْ بِشَهَادَاتِهِمْ قَائِمُونَ (33) وَالَّذِينَ هُمْ عَلَى صَلَاتِهِمْ يُحَافِظُونَ (34) أُولَئِكَ فِي جَنَّاتٍ مُكْرَمُونَ (35)","hl":[[0,830,1]]}},{"id":"س-00628","fp":"9716b787c3b0","stateId":35,"easy":"إذا تصدّقت ← ينشرح صدرك وتنبسط نفسك (مثَل البخيل والمتصدق)","cause":"فجَعَلَ المُتَصَدِّقُ كُلَّما تَصَدَّقَ بصَدَقةٍ","result":"انبَسَطَت عنه، حتَّى تَغشى أنامِلَه وتَعفوَ أثَرَه","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"صحيح البخاري 5797","srcLabel":"متفق عليه","text":["ضَرَبَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم مَثَلَ البَخيلِ والمُتَصَدِّقِ كَمَثَلِ رَجُلَينِ عليهما جُبَّتانِ مِن حَديدٍ، قدِ اضطُرَّت أيديهما إلى ثُديِّهما وتَراقيهما، ",["فجَعَلَ المُتَصَدِّقُ كُلَّما تَصَدَّقَ بصَدَقةٍ",1]," ",["انبَسَطَت عنه، حتَّى تَغشى أنامِلَه وتَعفوَ أثَرَه",2],"، وجَعَلَ البَخيلُ كُلَّما هَمَّ بصَدَقةٍ قَلَصَت، وأخَذَت كُلُّ حَلقةٍ بمَكانِها، قال أبو هُرَيرةَ: فأنا رَأيتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ بإصبَعِه هَكَذا في جَيبِه، فلو رَأيتَه يوسِّعُها ولا تَتَوسَّعُ! تابَعَه ابنُ طاوُسٍ، عن أبيه، وأبو الزِّنادِ، عَنِ الأعرَجِ: في الجُبَّتَينِ، وقال حَنظَلةُ: سَمِعتُ طاوُسًا: سَمِعتُ أبا هُرَيرةَ، يقولُ: جُبَّتانِ، وقال جَعفَرُ بنُ حَيَّانَ، عَنِ الأعرَجِ: جُبَّتانِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5797) واللفظ له، ومسلم (1021)","bab":"آداب عامة › ضرب الأمثال","dorar":"znbOnuwT","merged":9,"otherRefs":["صحيح البخاري 2917 (صحيح)","صحيح ابن حبان 3313 (صحيح)","تخريج صحيح ابن حبان 3332 (صحيح)","تخريج المسند لشعيب 7483 (صحيح)","صحيح ابن خزيمة 4/ 162 (صحيح)","صحيح الجامع 5826 (صحيح)","صحيح الترغيب 870 (صحيح)","معجم الشيوخ 1/445 (صحيح)"]},{"id":"س-02477","fp":"d372e21b4a1c","stateId":35,"easy":"إذا صمت رمضان وثلاثة أيام من كل شهر ← يذهب كثير من وحر صدرك (غيظه وغلّه)","cause":"فلْيَصُمْ شَهْرَ الصَّبْرِ أو ثَلاثةَ أيَّامٍ مِن كلِّ شَهْرٍ","result":"مَن سَرَّه أن يَذهَبَ كَثيرٌ مِن وَحَرِ صَدْرِه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"في رمضان"},"repOf":"س-02478","ref":"الصحيح المسند 1458","text":["كُنْتُ معَ مُطَرِّفٍ في سوقِ الإبِلِ، فجاءَه أعْرابيٌّ معَه قِطْعةُ أَديمٍ أو جِرابٍ، فقالَ: مَن يَقرَأُ -أو فيكم مَن يَقرَأُ- قُلْتُ: نَعمْ، فأَخَذْتُه، فإذا فيه «بِسْمِ اللهِ الرَّحْمنِ الرَّحيمِ، مِن مُحمَّدٍ رَسولِ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ لِبَني زُهَيْرِ بنِ أُقَيْشٍ -حَيٍّ مِن عُكلٍ- إنَّهم إن شَهِدوا أنْ لا إلهَ إلَّا اللهُ وأنَّ مُحمَّدًا رَسولُ اللهِ، وفارَقوا المُشرِكينَ، وأَقَرُّوا بالخُمُسِ في غَنائِمِهم، وسَهْمِ النَّبيِّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ وصَفِيِّه فإنَّهم آمِنونَ بأمانِ اللهِ ورَسولِه»، فقالَ له بعضُ القَوْمِ: هل سَمِعْتَ مِن رَسولِ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ شَيئًا تُحَدِّثُناه؟ قالَ: نَعمْ، قالوا: فحَدِّثْنا رَحِمَك اللهُ، قالَ: سَمِعْتُه يقولُ: «",["مَن سَرَّه أن يَذهَبَ كَثيرٌ مِن وَحَرِ صَدْرِه ",2],["فلْيَصُمْ شَهْرَ الصَّبْرِ أو ثَلاثةَ أيَّامٍ مِن كلِّ شَهْرٍ»",1],"، فقالَ له القَوْمُ -أو بعضُهم- أَأنت سَمِعْتَ هذا مِن رَسولِ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ؟ فقالَ: أَلَا أَراكم تَتَّهِموني أن أَكذِبَ على رَسولِ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ؟ وقالَ إسْماعيلُ مَرَّةً: تَخافونَ واللهِ، لا حَدَّثْتُكم حَديثًا سائِرَ اليَوْمِ، ثُمَّ انْطَلَقَ.\nحَدَّثَنا سُفْيانُ بنُ عُيَيْنةَ، عن هارونَ بنِ رِئابٍ، عن ابنِ الشِّخِّيرِ، عن رَجُلٍ مِن بَني أُقَيْشٍ قالَ: معَه كِتابُ النَّبيِّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ...، قالَ: «صِيامُ ثَلاثةِ أيَّامٍ مِن الشَّهْرِ يُذهِبْنَ وَحَرَ الصَّدْرِ»."],"grade":"صحيح","narrator":"رجل من بني أقيش","muhaddith":"صحيح","bab":"إسلام › قتال الناس حتى يسلموا","dorar":"SKHaD80L"},{"id":"س-07325","fp":"846d47c6c82c","stateId":36,"easy":"إذا استغنى قلبك ← فهذا هو الغنى الحقيقي","cause":"غِنى القلبِ","result":"إنَّما الغِنى","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 8142","srcLabel":"البخاري","text":["يا أبا ذَرٍّ، أترَى كَثرةَ المالِ هُو الغِنَى؟ قلْتُ: نعَمْ -يا رسولَ اللهِ- هو الغِنَى، قالَ: وتَرَى أنَّ قِلَّةَ المالِ هو الفَقْرَ؟ قلْتُ: نعمْ -يا رسولَ اللهِ- هو الفَقْرُ، قالَ: ليْس كذلِكَ؛ ",["إنَّما الغِنى",2]," ",["غِنى القلبِ",1],"، والفقرُ فقْرُ القلبِ.\n ثمَّ سألَنِي رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ عنْ رجُلٍ مِن قُرَيشٍ، فقال: تَعرِفُ فلانًا؟ قلْتُ: نعَمْ يا رسولَ اللهِ، قال: فكيفَ تَراهُ؟ قلْتُ: إذا سَأَلَ أُعْطِيَ، وإذا حَضَرَ دخَلَ، قالَ: ثمَّ سأَلَنِي عنْ رجُلٍ مِن أهْلِ الصُّفَّةِ، فقالَ: هلْ تَعرِفُ فُلانًا؟ قلْتُ: لا، يا رسولَ اللهِ، قالَ: فما زالَ يُحلِّيهِ ويَنْعَتُه حتَّى عَرَفْتُه، قالَ: قلْتُ: نعمْ يا رسولَ اللهِ، قالَ: فكيفَ تَراهُ؟ قلْتُ: رجُلٌ مِسكينٌ مِن أهْلِ المَسجِدِ. قالَ: هو خَيْرٌ مِن طِلاعِ الأرضِ مِثلَ الآخَرِ، قلْتُ: يا رسولَ اللهِ، أفلا يُعطَى مِن بعضِ ما يُعطَى الآخَرُ؟ قالَ: إنْ يُعطَ فهو أهْلُهُ، وإنْ يُصرَفْ عنه فقَدْ أُعْطِيَ حَسَنةً."],"grade":"صحيح","narrator":"أبو ذر","muhaddith":"صحيح على شرط البخاري","takhrij":"أخرجه الطبراني (2/ 154) (1643) واللفظ لهم، والنسائي في ((السنن الكبرى)) (11785)، وابن حبان (3632) مطولا.","bab":"فتن › فتنة المال","dorar":"uoBAZi3u","merged":5,"otherRefs":["صحيح الترغيب 1701 (صحيح)","تخريج المسند لشعيب 10958 (صحيح)","صحيح الجامع 7816 (صحيح)","الأحاديث المختارة 2532 (صحيح)"]},{"id":"س-06002","fp":"a1d80efe8242","stateId":36,"easy":"إذا اتقيت الله ← فالصحة لك خير من الغنى","cause":"والصَّحَّةِ لمَنِ اتَّقى","result":"خيرٌ مِنَ الغِنى","explicit":true,"star":true,"otherNeedIds":[35],"ref":"المستدرك على الصحيحين 2163","srcLabel":"البخاري","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ خَرَجَ عليهم وعليه أَثَرُ غُسلٍ وهو طَيِّبُ النَّفسِ، قالَ: فظَننَّا أنَّه أَلَمَّ بأهلِه، فقلنا: يا رسولَ اللهِ، نراكَ أَصبحتَ طيِّبَ النَّفسِ، قالَ: أجَلْ، والحمدُ للهِ. قالَ: ثُمَّ ذَكَرَ الغِنى، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: لا بَأسَ بالغِنى لمَنِ اتَّقى، ",["والصَّحَّةِ لمَنِ اتَّقى",1]," ",["خيرٌ مِنَ الغِنى",2],"، وطيبُ النَّفسِ مِنَ النَّعيمِ."],"grade":"صحيح","narrator":"[يسار بن عبدالله الجهني]","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الحاكم (2131)، والبخاري في ((الأدب المفرد)) (301)، والبيهقي في ((شعب الإيمان)) (1188) بلفظه.","bab":"رقائق وزهد › تقوى الله","dorar":"ysRXgWTH","merged":4,"otherRefs":["هداية الرواة 5220 (صحيح)","صحيح ابن ماجه 1754 (صحيح)","صحيح الأدب المفرد 231 (صحيح)"]},{"id":"س-07596","fp":"87ab07f55a4f","stateId":36,"easy":"إذا كنت مؤمناً ← فكل ما يقضيه الله لك خير","cause":"للمُؤمِنِ","result":"إنَّ اللهَ عَزَّ وجَلَّ لا يَقْضي له قَضاءً إلَّا كان خَيرًا له","explicit":true,"star":true,"otherNeedIds":[55],"ref":"الأحاديث المختارة 1818","srcLabel":"البخاري","text":["«تبسَّم رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم فقُلْتُ: يا رَسولَ اللهِ، مِمَّ ضَحِكْتَ؟ قال: عَجَبًا ",["للمُؤمِنِ",1]," ",["إنَّ اللهَ عَزَّ وجَلَّ لا يَقْضي له قَضاءً إلَّا كان خَيرًا له",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"فضائل النبي وصفته ودلائل النبوة › ضحك النبي صلى الله عليه وسلم وتبسمه","dorar":"EvzH5nJt","merged":4,"otherRefs":["تخريج المسند لشعيب 12160 (صحيح)","تفسير القرآن العظيم 5/181 (صحيح)","الأحاديث المختارة 1817 (صحيح)"]},{"id":"س-05658","fp":"d33ce4ed0474","stateId":36,"easy":"إذا أصبحت معافى آمناً عندك قوت يومك ← فكأنما مُلّكت الدنيا كلها","cause":"مَن أصبَحَ مِنكُم مُعافًى في جَسَدِه آمِنًا في سِربه عِندَه قوتُ يَومِه","result":"فكَأنَّما حيزَت له الدُّنيا بحَذافيرِها","explicit":true,"star":true,"apply":{"k":"time","t":"في الصباح"},"ref":"فتح البيان 3/ 387","srcLabel":"البخاري","text":[["مَن أصبَحَ مِنكُم مُعافًى في جَسَدِه آمِنًا في سِربه عِندَه قوتُ يَومِه، ",1],["فكَأنَّما حيزَت له الدُّنيا بحَذافيرِها",2],"."],"grade":"صحيح","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (4141)، والبخاري في ((الأدب المفرد)) (300)، والبيهقي في ((الزهد الكبير)) (105) بلفظه.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"AHRpRDc2"},{"id":"س-05595","fp":"a3d7407c495b","stateId":36,"easy":"إذا نظرت إلى من هو أسفل منك ← لا تحتقر نعمة الله عليك","cause":"انْظُروا إلى مَن هو أَسْفَلَ مِنكم، ولا تَنْظُروا إلى مَن هو فَوْقَكم","result":"فإنَّه أَجْدَرُ أنْ لا تَزْدَروا نِعْمَةَ اللهِ","explicit":true,"star":true,"similar":["س-01694"],"ref":"تخريج المسند لشعيب 7449","srcLabel":"مسلم","text":[["انْظُروا إلى مَن هو أَسْفَلَ مِنكم، ولا تَنْظُروا إلى مَن هو فَوْقَكم",1],"؛ ",["فإنَّه أَجْدَرُ أنْ لا تَزْدَروا نِعْمَةَ اللهِ",2],"، قال أَبو مُعاوِيَةَ: عَليكم."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (2963) باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"WNf03yBz","merged":2,"otherRefs":["تخريج صحيح ابن حبان 713 (صحيح)"]},{"id":"ق-0781","fp":"f29fb97fda3c","stateId":36,"easy":"الصبر والتسبيح بحمد الله قبل طلوع الشمس وقبل غروبها وآناء الليل وأطراف النهار ← الرضا","cause":"الصبر والتسبيح بحمد الله قبل طلوع الشمس وقبل غروبها وآناء الليل وأطراف النهار","result":"الرضا","explicit":true,"ref":"سورة طه: 130","srcLabel":"القرآن الكريم","quran":{"s":20,"from":130,"to":130,"text":"فَاصْبِرْ عَلَى مَا يَقُولُونَ وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ غُرُوبِهَا وَمِنْ آنَاءِ اللَّيْلِ فَسَبِّحْ وَأَطْرَافَ النَّهَارِ لَعَلَّكَ تَرْضَى (130)","hl":[[0,177,1]]}},{"id":"ق-1305","fp":"3baf4db85008","stateId":36,"easy":"الإيمان بأن المصائب مكتوبة (القدر) ← لا أسى على ما فات ولا فرح بطر بما أتى","cause":"الإيمان بأن المصائب مكتوبة (القدر)","result":"لا أسى على ما فات ولا فرح بطر بما أتى","explicit":true,"otherNeedIds":[9],"ref":"سورة الحديد: 22–23","srcLabel":"القرآن الكريم","quran":{"s":57,"from":22,"to":23,"text":"مَا أَصَابَ مِنْ مُصِيبَةٍ فِي الْأَرْضِ وَلَا فِي أَنْفُسِكُمْ إِلَّا فِي كِتَابٍ مِنْ قَبْلِ أَنْ نَبْرَأَهَا إِنَّ ذَلِكَ عَلَى اللَّهِ يَسِيرٌ (22) لِكَيْلَا تَأْسَوْا عَلَى مَا فَاتَكُمْ وَلَا تَفْرَحُوا بِمَا آتَاكُمْ وَاللَّهُ لَا يُحِبُّ كُلَّ مُخْتَالٍ فَخُورٍ (23)","hl":[[0,223,1]]}},{"id":"س-05539","fp":"22c35c8beab9","stateId":36,"easy":"إذا قنعت بالقليل الكافي ← فهو خير من الكثير الملهي","cause":"ما قلَّ وكفَى","result":"خيرٌ ممَّا كثُرَ وألهَى","explicit":true,"otherNeedIds":[55],"ref":"صحيح الترغيب 3167","srcLabel":"أحمد","text":["ما طلعَتْ شمسٌ قطُّ إلَّا بُعِثَ بجنبَتَيْها ملَكانِ ، إنَّهما ليُسمِعانِ أهلَ الأرضِ إلَّا الثَّقلَيْنِ يا أيُّها النَّاسُ ! هلمُّوا إلى ربِّكُم ، فإنَّ ",["ما قلَّ وكفَى",1]," ",["خيرٌ ممَّا كثُرَ وألهَى",2]," وما غربَتْ شمسٌ قطُّ إلَّا وبُعِثَ بجنبَتَيْها ملَكانِ يناديانِ اللَّهمَّ عجِّلْ لمُنفِقٍ خلفًا وعجِّلْ لمُمسكٍ تلفًا ما من يومٍ طلعَتْ شمسُهُ إلَّا وكان بجنبَتَيْها ملَكانِ يناديانِ نداءً يسمعُهُ ما خلقَ اللهُ كلُّهُم غيرَ الثَّقلَيْنِ يا أيُّها النَّاسُ هلمُّوا إلى ربِّكُم إنَّ ما قلَّ وكفَى خيرٌ ممَّا كثُرَ وألهَى ولا آبَتِ الشَّمسُ إلَّا وكان بجنبَتَيْها ملَكانِ يناديانِ نداءً يسمعُهُ خَلْقُ اللهِ كلُّهُم غيرَ الثَّقلَيْنِ اللَّهمَّ أعطِ مُنفقًا خلفًا وأعطِ مُمسكًا تلفًا وأنزلَ اللهُ في ذلكَ قرآنًا في قَولِ الملَكَيْنِ يا أيُّها النَّاسُ هلمُّوا إلى ربِّكُم في سورةِ يونسَ  وَاللهُ يَدْعُو إِلَى دَارِ السَّلَامِ وَيَهْدِي مَنْ يَشَاءُ إِلَى صِرَاطٍ مُسْتَقِيمٍ  وأنزلَ اللهُ في قولِهِما اللَّهمَّ أعطِ مُنفقًا خلفًا وأعطِ مُمسكًا تلفًا  وَاللَّيْلِ إِذَا يَغْشَى وَالنَّهَارِ إِذَا تَجَلَّى وَمَا خَلَقَ الذَّكَرَ وَالْأُنْثَى  إلى قولِهِ لِلْعُسْرَى . ."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه أحمد (21721)، وابن حبان (686) مختصراً، والبيهقي في ((شعب الإيمان)) (3412) باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"GAdRie7k","merged":4,"otherRefs":["المقاصد الحسنة 391 (صحيح)","الترغيب والترهيب 4/155 (صحيح)","مجمع الزوائد 10/258 (صحيح)"]},{"id":"س-04738","fp":"ccf8d3b7aa7a","stateId":36,"easy":"إذا كانت الآخرة نيتك ← يجمع الله لك أمرك ويجعل غناك في قلبك وتأتيك الدنيا وهي راغمة","cause":"ومَن كانتِ الآخِرةُ نيَّتَه","result":"جمَع اللهُ له أمرَه وجعَل غِناه في قلبِه وأَتَتْه الدُّنيا وهي راغمةٌ","explicit":true,"similar":["س-05640","س-05543","س-05654","س-05526"],"otherNeedIds":[1],"ref":"تخريج صحيح ابن حبان 680","srcLabel":"الترمذي","text":["خرَج زيدُ بنُ ثابتٍ مِن عندِ مَروانَ نِصفَ النَّهارِ قال : قُلْتُ : ما بعَث إليه هذه السَّاعةَ إلَّا لشيءٍ سأَله عنه فسأَلْتُه فقال : سأَلَنا عن أشياءَ سمِعْناها مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ : ( نضَّر اللهُ امرأً سمِع منَّا حديثًا فبلَّغه غيرَه فرُبَّ حاملِ فقهٍ إلى مَن هو أفقَهُ منه ورُبَّ حاملِ فقهٍ ليس بفقيهٍ ثلاثٌ لا يغِلُّ عليهنَّ قلبُ مسلمٍ : إخلاصُ العملِ للهِ ومُناصحةُ ولاةِ الأمرِ ولزومُ الجماعةِ فإنَّ دعوتَهم تُحيطُ مِن ورائِهم ومَن كانتِ الدُّنيا نيَّتَه فرَّق اللهُ عليه أمرَه وجعَل فقرَه بيْنَ عينَيْهِ ولَمْ يأتِه مِن الدُّنيا إلَّا ما كُتِب له ",["ومَن كانتِ الآخِرةُ نيَّتَه ",1],["جمَع اللهُ له أمرَه وجعَل غِناه في قلبِه وأَتَتْه الدُّنيا وهي راغمةٌ )",2]],"grade":"صحيح","narrator":"زيد بن ثابت","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (21590)، والدارمي (236)، وابن حبان (680) واللفظ لهم، والترمذي (2656) مختصرا.","bab":"رقائق وزهد › الإخلاص","dorar":"7FZMgWMb","merged":3,"otherRefs":["هداية الرواة 5250 (صحيح)","صحيح الترغيب 3169 (صحيح)"]},{"id":"س-05527","fp":"cc21fce34532","stateId":36,"easy":"إذا حفظت الأمانة وصدقت الحديث وحسن خلقك وعففت في طعامك ← فلا يضرك ما فاتك من الدنيا","cause":"حِفْظُ أَمانَةٍ ، و صِدْقُ حَدِيثٍ ، و حُسْنُ خَلِيقَةٍ ، و عِفَّةٌ في طُعْمَةٍ","result":"فلا عليكَ ما فَاتَكَ مِنَ الدنيا","explicit":true,"ref":"السلسلة الصحيحة 733","srcLabel":"أحمد","text":["أربعٌ إذا كُنَّ فيكَ ",["فلا عليكَ ما فَاتَكَ مِنَ الدنيا",2]," ، ",["حِفْظُ أَمانَةٍ ، و صِدْقُ حَدِيثٍ ، و حُسْنُ خَلِيقَةٍ ، و عِفَّةٌ في طُعْمَةٍ",1]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه أحمد (6652)، وابن وهب في ((الجامع)) (546)","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"samX4bhq","merged":2,"otherRefs":["صحيح الجامع 873 (صحيح)"]},{"id":"س-05552","fp":"a31a7af35aa7","stateId":36,"easy":"إذا قلّ مالك ← قلّ حسابك","cause":"ويكرَهُ قلَّةَ المالِ","result":"وقلَّةُ المالِ أقلُّ للحسابِ","explicit":true,"otherNeedIds":[1],"ref":"مجمع الزوائد 2/324","srcLabel":"أحمد","text":["أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ اثنتانِ يكرَهُهما ابنُ آدمَ الموتُ والموتُ خيرٌ للمؤمنينَ منَ الفتنةِ ",["ويكرَهُ قلَّةَ المالِ",1]," ",["وقلَّةُ المالِ أقلُّ للحسابِ",2]],"grade":"صحيح","narrator":"محمود بن لبيد الأنصاري","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (26325)، والبغوي في ((شرح السنة)) (4066)، وأبو نعيم في ((معرفة الصحابة)) (6114) بلفظه.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"i7MV4jHo","merged":2,"otherRefs":["صحيح الجامع 139 (صحيح)"]},{"id":"س-05640","fp":"eaf5434ad219","stateId":36,"easy":"إذا كانت الآخرة نيتك ← يجعل الله غناك في قلبك ويكفيك أمرك وتأتيك الدنيا راغمة","cause":"ومَن تَكُنِ الآخِرةُ نِيَّتَه","result":"يَجعَلِ اللهُ غِناهُ في قَلبِه ويَكفيه ضَيعَتَه، وتأتيه الدُّنيا وهي راغِمةٌ","explicit":true,"repOf":"س-04738","otherNeedIds":[1],"ref":"الترغيب والترهيب 4/162","text":["رَحِمَ اللهُ مَن سَمِعَ مَقالَتي حتى يُبَلِّغَها غَيرَه: ثَلاثٌ لا يَغِلُّ عليهِنَّ قَلبُ امرِئٍ مُسلِمٍ: إخلاصُ العَمَلِ للهِ، والنُّصحُ لِأئِمَّةِ المُسلِمينَ، واللُّزومُ لِجَماعَتِهم، فإنَّ دُعاءَهم يُحيطُ مِن وَرائِهم، إنَّه مَن تَكُنِ الدُّنيا نِيَّتَه يَجعَلِ اللهُ فَقرَه بَينَ عَينَيْه، ويُشَتِّتُ عليه ضَيعَتَه، ولا يأتيه منها إلَّا ما كُتِبَ له، ",["ومَن تَكُنِ الآخِرةُ نِيَّتَه ",1],["يَجعَلِ اللهُ غِناهُ في قَلبِه ويَكفيه ضَيعَتَه، وتأتيه الدُّنيا وهي راغِمةٌ",2],"."],"grade":"صحيح","narrator":"زيد بن ثابت","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (3660) باختلاف يسير دون قوله: \"ثلاث لا يغل ...\"، وابن ماجه (230، 4105) مفرقاً باختلاف يسير، وأحمد (21590) باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"jihas9WH","merged":2,"otherRefs":["صحيح الترغيب 3168 (صحيح)"]},{"id":"س-00875","fp":"1159ab5dbc50","stateId":36,"easy":"إذا رُزقت قلباً شاكراً ولساناً ذاكراً وزوجة صالحة ← فهو خير ما يكنزه الناس","cause":"قلبٌ شاكرٌ و لسانٌ ذاكرٌ و زوجةٌ صالحةٌ تُعينُك على أمرِ دنياك و دينِك","result":"خيرٌ ما اكْتَنَزَ الناسُ","explicit":true,"otherNeedIds":[37],"ref":"صحيح الجامع 4409","srcLabel":"صحيح الجامع","text":[["قلبٌ شاكرٌ و لسانٌ ذاكرٌ و زوجةٌ صالحةٌ تُعينُك على أمرِ دنياك و دينِك",1]," ",["خيرٌ ما اكْتَنَزَ  الناسُ",2]],"grade":"صحيح","narrator":"أبو أمامة وثوبان وعلي بن أبي طالب","muhaddith":"صحيح","bab":"أدعية وأذكار › فضل الذكر","dorar":"xOOx7IuL"},{"id":"س-01694","fp":"8a9b36afad8b","stateId":36,"easy":"إذا نظرت إلى من هو دونك لا إلى من فوقك ← لا تحتقر نعمة الله عليك","cause":"مَن تحتَكَ ولا تنظُر إلى مَن فوقكَ","result":"فإنَّهُ أجدَرُ أن لا تَزدَري نِعمةَ اللهِ عندكَ","explicit":true,"repOf":"س-05595","ref":"النوافح العطرة 227","text":["قُلِ الحقَّ وإن كان مُرًّا [يعني حديث: دخَلتُ علَى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وهو في المسجِدِ جالِسٌ، فاغتَنَمتُ خلوتَهُ، وحدَهُ، فجلَستُ إليهِ، فقالَ : أبا ذَرٍّ ! إن لِلمَسجِد تَحيَّةً، وإنَّ تحيَّتَهُ ركعتان فقُم فاركَعهما، قالَ : فقُمت فركَعتُها ثم عُدتُ فجلَستُ إليهِ، فقُلتُ : يا رسولَ اللهِ ! إنَّكَ أمَرتَني بالصَّلاةِ فما الصَّلاةُ ؟ قال : خيرٌ موضوعٌ استكثِرْ أو استَقِلَّ. قلتُ : يا رسولَ اللهِ ! فأيُّ الأعمالِ أفضَلُ ؟ قال : إيمانٌ باللَّهِ عزَّ وجلَّ، وجهادٌ في سبيلِهِ، قال : قلتُ : يا رسولَ اللهِ ! فأيُّ المؤمنينَ أكمَلُهم إيمانًا ؟ قالَ : أحسَنُهُم خُلُقًا. قالَ : قلتُ : يا رسولَ اللَّهِ ! فأيُّ المؤمنينَ أسلَمُ ؟ قالَ : مَن سلِمَ النَّاسُ من لسانِهِ ويدِهِ. قال : قلتُ : يا رسولَ اللَّهِ ! فأيُّ الهجرةِ أفضَلُ ؟ قال : مَن هجرَ السَّيِّئاتِ. قالَ : قُلتُ : يا رسولَ اللهِ ! فأيُّ الصَّلاةِ أفضَلُ ؟ قال : طولُ القنوتِ . قال : قلتُ : يا رسولَ اللهِ ! فما الصِّيامُ ؟ قالَ : فرضٌ مَجزيٌّ ، وعندَ اللهِ أضعافٌ كثيرةٌ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ الجهادِ أفضَلُ ؟ قالَ : مَن عُقِرَ جوادُهُ وأهريقَ دمُهُ. قال : قُلتُ : يا رسولَ اللهِ ! فأيُّ الرِّقابِ أفضَلُ ؟ قالَ : أغلاها ثَمنًا وأنفَسُها عندَ ربِّها. قالَ : قلتُ : يا رسولَ اللهِ ! فأيُّ الصَّدقةِ أفضَلُ ؟ قال : جُهدٌ مِن مُقِلٍّ يُسَرُّ إلى فقيرٍ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ آيةٍ مِمَّا أنزلَ اللهُ عزَّ وجلَّ عليكَ أعظَمُ ؟ قال : آيةُ الكُرسيِّ. ثُمَّ قالَ : يا أبا ذَرٍّ ! ما السَّماواتُ السَّبعُ معَ الكُرسيِّ إلا كَحلقَةٍ مُلقاةٍ بأرضِ فلاةٍ، وفَضلُ العَرشِ على الكُرسيِّ كفَضلِ الفَلاةِ علَى الحَلقَةِ. قلتُ : يا رسولَ اللهِ ! كم الأنبياءُ ؟ قال : مائةُ ألفٍ وأربعةٌ وعِشرونَ ألفًا. قلتُ : يا رسولَ اللهِ ! كم الرُّسلِ ؟ قالَ : ثلاثُمائةٍ وثلاثَةُ عشرَ جَمًّا غفيرًا. قلتُ : كثيرٌ طيِّبٌ، قلتُ : يا رسولَ اللهِ ! مَن كان أوَّلُهمْ ؟ قال : آدَمُ. قلتُ : يا رسولَ اللهِ ! أنَبيٌّ مُرسَلٌ ؟ قال : نعَم، خلقَهُ اللهُ بيدِهِ، ونفخَ فيهِ مِن روحِهِ، ثُمَّ سوَّاهُ قِبَلًا. وقال أحمدُ بنُ أنَسٍ ثُمَّ كلَّمهُ قِبَلًا. ثُمَّ قالَ : يا أبا ذَرٍّ ! أربعةٌ سُريانيُّونَ؛ آدَمُ، وشيثُ، وخَنوخُ - وهو إدريسُ، وهم أوَّلُ مَن خطَّ بالقلَمِ - ونوحٌ. وأربعةٌ من العَربِ؛ هودٌ، وصالِحٌ، وشُعَيبٌ، ونبيُّكَ يا أبا ذَرٍّ. قال : قلتُ : يا رسولَ اللهِ ! كَم كتابٌ أنزلَهُ اللَّهُ تعالى ؟ قال : مائةُ كتابٍ وأربعةُ كتُبٍ، أنزلَ علَى شيثَ خَمسونَ صحيفَةً، وأنزلَ علَى خَنوخَ ثلاثونَ صَحيفةً، وأنزلَ على إبراهيمَ عشرَ صحائفَ، وأنزلَ على موسَى قبلَ التَّوراةِ عَشرَ صحائفَ، وأنزلَ التَّوراةَ والإنجيلَ والزَّبورَ والفُرقانَ. قال : قلتُ : يا رسولَ اللهِ ! فَما كانَت صُحفُ إبراهيمَ ؟ قالَ : كانَت أمثالًا كلُّها : أيُّها الملِكُ المسلَّطُ المبتَلَى المغرورُ، فإنِّي لم أبعثْكَ لتجمَعَ الدُّنيا بعضَها إلى بعضٍ، ولكن بعثتُكَ لترُدَّ عنِّي دعوةَ المظلومِ، فإنِّي لا أردُّها ولَو كانَت مِن كافِرٍ. وكانَت فيها أمثالٌ : علَى العاقِلِ ما لَم يكُن مغلوبًا علَى عقلِهِ أن تكونَ له ساعاتٌ؛ ساعَةٌ يُناجي فيها ربَّهُ عزَّ وجلَّ، وساعةٌ يحاسِبُ فيها نفسَهُ، وساعَةٌ يفكِّرُ فيها في صُنعِ اللَّهِ عزَّ وجلَّ، وساعةٌ يخلو فيها بحاجتِهِ من المطعَمِ والمشرَبِ، وعلى العاقلِ أن لا يكون ظاعِنًا إلَّا لثلاثٍ؛ تزوُّدٍ لمعادٍ، أو مرمَّةٍ لمعاشٍ، أو لذَّةٍ في غيرِ محرَّمٍ، وعلى العاقِلِ أن يكونَ بصيرًا بزمانِهِ، مقبِلًا على شأنِهِ، حافِظًا للسانِهِ، ومن حسَبَ كلامَهُ من عمَلِهِ قلَّ كلامُهُ إلا فيما يعنيهِ. قلتُ : يا رسولَ اللَّهِ ! فما كان صحُفُ موسَى عليهِ السَّلامُ ؟ قال : كانَت عبرًا كلَّها، عجبتُ لمن أيقنَ بالموتِ ثُمَّ هو يفرَحُ، عجبتُ لمن أيقنَ بالنَّارِ وهو يضحَكُ، عجبتُ لمن أيقنَ للقدرِ ثم هو ينصَبُ، عجبتُ لمن رأى الدُّنيا وتقلُّبَها ثُمَّ اطمأنَّ إليها، عجِبتُ لمن أيقنَ بالحسابِ غدًا ثُمَّ لا يعمَلُ. قلتُ : يا رسولَ اللهِ ! أوصِني. قال : أوصيكَ بتقوى اللهِ فإنَّهُ رأسُ الأمرِ كلِّهِ، قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بتلاوَةِ القرآنِ فإنَّهُ نور لكَ في الأرضِ وذكرٌ لكَ في السَّماءِ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : إيَّاكَ وكثرةَ الضَّحِكِ فإنَّهُ يُميتُ القَلبَ، ويَذهَبُ بنورِ الوَجهِ، قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : عليكَ بالصَّمتِ إلَّا مِن خيرٍ، فإنَّهُ مطردَةٌ للشَّيطانِ عنكَ، وعونٌ لكَ علَى أمر دينِكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بالجهادِ فإنَّهُ رهبانيَّةُ أمَّتي. قلتُ : يا رسولَ اللهِ ! زِدني. قال : حبُّ المساكينِ وجالِسهُم. قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : انظُر إلى ",["مَن تحتَكَ ولا تنظُر إلى مَن فوقكَ ",1],["فإنَّهُ أجدَرُ أن لا تَزدَري نِعمةَ اللهِ عندكَ",2],". قلتُ : زِدني يا رسولَ اللهِ ! قال : صِلْ قرابَتَكَ وإن قَطعوكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : لا تَخَف في اللَّهِ تعالى لَومَةَ لائمٍ. قلتُ : يا رسولَ اللهِ ! زِدني. قالَ : قُل الحقَّ وإن كان مُرًّا. قلتُ : يا رسولَ اللهِ ! زِدني. قال : يردُّكَ عن النَّاسِ ما تعرفُ من نفسِكَ، ولا تجِد عليهِم فيما تأتي، وكفَى به عيبًا أن تعرِفَ من النَّاسِ ما تجهَلُ من نفسِكَ، أو تجِدُ عليهِم فيما تأتي. ثُمَّ ضربَ بيدِهِ علَى صدري، فقالَ : يا أبا ذَرٍّ ! لا عقلَ كالتَّدبيرِ، ولا ورعَ كالكَفِّ، ولا حسَبَ كحُسنِ الخُلُقِ، قلتُ : يارسولَ اللهِ ! هل لي في الدُّنيا شَيءٌ مِمَّا أنزلَ اللهُ عليكَ مِمَّا كان في صحُفِ إبراهيمَ وموسَى ؟ قال : يا أبا ذَرٍّ ! اقرَأ : ? قَد أفلَحَ مَن تزَكَّى? إلى آخرِ السُّورَةِ]"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مطولاً أحمد (21415)، والبزار (3966) باختلاف يسير، وابن حبان (361) واللفظ له","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"wZID7EAR"},{"id":"س-03812","fp":"29647b2f8e27","stateId":36,"easy":"إذا رضيت بما قسم الله لك ← تكن من أغنى الناس","cause":"وارْضَ بما قسم اللهُ لكَ","result":"تَكُن من أَغْنَى الناسِ","explicit":true,"ref":"صحيح الجامع 7833","srcLabel":"الترمذي","text":["يا أبا هريرةَ ! كُنْ وَرِعًا تَكُنْ من أَعْبَدِ الناسِ ، ",["وارْضَ بما قسم اللهُ لكَ",1]," ",["تَكُن من أَغْنَى الناسِ",2]," ، وأَحِبَّ للمسلمينَ والمؤمنينَ ما تُحِبُّ لنفسِكَ وأهلِ بيتِكَ ، واكْرَهْ لهم ما تَكْرَهُ لنفسِكَ وأهلِ بيتِكَ تَكُنْ مؤمنًا ، وجاوِرْ مَن جاوَرْتَ بإحسانٍ تَكُنْ مُسْلِمًا ، وإياكَ وكثرةَ الضَّحِكِ ؛ فإنَّ كَثْرَةَ الضَّحِكِ فسادُ القلبِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2305)، وابن ماجه (4217)، وأحمد (8095) باختلاف يسير","bab":"بر وصلة › حق الجار والوصاة به","dorar":"8idzJ5Is"},{"id":"س-05462","fp":"c07145219ce0","stateId":36,"easy":"إذا يئست مما في أيدي الناس ← تعيش غنياً","cause":"و ايْأَسْ مِمَّا في أيْدِي الناسِ","result":"تَعِشْ غنيًّا","explicit":true,"ref":"صحيح الجامع 3776","srcLabel":"الطبراني","text":["صلِّ صلاةَ مُودِّعٍ كأنَّكَ تَراهُ ، فإنْ كُنتَ لا تَراهُ فإنَّه يَراكَ ، ",["و ايْأَسْ مِمَّا في أيْدِي الناسِ",1]," ",["تَعِشْ غنيًّا",2]," ، و إيَّاكَ وما يُعتَذَرُ مِنهُ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (4427)، والبيهقي في ((الزهد الكبير)) (528)، وابن عساكر في ((معجم الشيوخ)) (323) واللفظ له.","bab":"رقائق وزهد › الخوف من الله","dorar":"kYTiQmaD"},{"id":"س-05543","fp":"3d7c0ceeda8a","stateId":36,"easy":"إذا كانت الآخرة همّك ← يجعل الله غناك في قلبك ويجمع أمرك وتأتيك الدنيا صاغرة","cause":"ومن كانت الآخرةُ هِمَّتَه وسدَمَه ، ولها شَخِصٌ ، وإياها ينوي","result":"جعل اللهُ عزَّ وجلَّ الغِنى في قلبِه ، وجمع عليه ضَيعتَه وأتَتْه الدُّنيا وهي صاغرةٌ","explicit":true,"repOf":"س-04738","otherNeedIds":[1],"ref":"صحيح الترغيب 1707","text":["من كانت الدنيا همَّتَه وسدَمَه ، ولها شَخِصٌ ، وإياها ينوي ؛ جعل اللهُ الفقرَ بين عينَيه ، وشتَّتَ عليه ضَيعتَه ، ولم يأْتِه منها إلا ما كُتب له منها ، ",["ومن كانت الآخرةُ هِمَّتَه وسدَمَه ، ولها شَخِصٌ ، وإياها ينوي ؛ ",1],["جعل اللهُ عزَّ وجلَّ الغِنى في قلبِه ، وجمع عليه ضَيعتَه وأتَتْه الدُّنيا وهي صاغرةٌ ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن أبي الدنيا في ((الزهد)) (333)، وابن أبي عاصم في ((الزهد)) (165)، وابن حبان في ((المجروحين)) (1/328) باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"d2CDkmco"},{"id":"س-05551","fp":"8687f42a5a45","stateId":36,"easy":"إذا رُزقت قليلاً تؤدي شكره ← فهو خير من كثير لا تطيق شكره","cause":"قليلٌ يُؤدي شكرُه","result":"خيرٌ من كثيرٍ لا يُطيقُه","explicit":true,"otherNeedIds":[1],"ref":"النوافح العطرة 228","srcLabel":"الطبراني","text":[["قليلٌ يُؤدي شكرُه",1]," ",["خيرٌ من كثيرٍ لا يُطيقُه",2]],"grade":"صحيح","narrator":"ثعلبة بن حاطب الأنصاري","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي عاصم في ((الآحاد والمثاني)) (2253)، والطبراني (8/260) (7873)، وأبو نعيم في ((معرفة الصحابة)) (1404) مطولاً","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"JKliXo6o"},{"id":"س-05601","fp":"1f4c6ade012f","stateId":36,"easy":"إذا أقللت الدخول على الأغنياء ← لا تحتقر نعم الله عليك","cause":"أَقِلُّوا الدُّخولَ على الأغنِياءِ","result":"فإنَّه أحرَى ألَّا تَزدَروا نِعَمَ اللهِ عزَّ وجلَّ","explicit":true,"ref":"المستدرك على الصحيحين 8082","srcLabel":"البيهقي","text":[["أَقِلُّوا الدُّخولَ على الأغنِياءِ",1],"؛ ",["فإنَّه أحرَى ألَّا تَزدَروا نِعَمَ اللهِ عزَّ وجلَّ",2],"."],"grade":"صحيح","narrator":"عبدالله بن الشخير","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (9806)، والعقيلي في ((الضعفاء الكبير)) (3/  327)، وأبو طاهر السلفي في ((الطيوريات)) (854) باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"P9uoAfII"},{"id":"س-05616","fp":"6bf8c8b5b377","stateId":36,"easy":"إذا كان الغنى في قلبك ← لا يضرك ما لقيت من الدنيا","cause":"مَن كان الغِنَى في قلبِه","result":"فلا يَضُرُّه ما لَقِيَ من الدنيا","explicit":true,"ref":"صحيح الجامع 7816","srcLabel":"النسائي","text":["يا أبا ذَرٍّ ! أَتَرَى أنَّ كثرةَ المالِ هو الغِنَى ؟ إنما الغِنَى غِنَى القلبِ ، والفقرُ فقرُ القلبِ ، ",["مَن كان الغِنَى في قلبِه ، ",1],["فلا يَضُرُّه ما لَقِيَ من الدنيا ، ",2],"ومَن كان الفقرُ في قلبِه ، فلا يُغْنِيهِ ما أُكْثِرَ له في الدنيا ، وإنما يَضُرُّ نَفْسَه شُحُّها"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) كما في ((تحفة الأشراف)) للمزي (9/157)، وابن حبان (685)، والطبراني (2/154) (1643) باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"CDrZRPvv"},{"id":"س-05632","fp":"6093626f12a5","stateId":36,"easy":"إذا كرهت الموت ← فاعلم أن الموت خير للمؤمن من الفتنة","cause":"يكرهُ الموتَ","result":"و الموتُ خيرٌ له من الفتنةِ","explicit":true,"ref":"صحيح الجامع 139","srcLabel":"أحمد","text":["اثنتان يكرههما ابنُ آدمَ : ",["يكرهُ الموتَ",1]," ، ",["و الموتُ خيرٌ له من الفتنةِ",2]," ، و يكرهُ قلَّةَ المالِ ، و قِلَّةُ المالِ أقلُّ للحسابِ"],"grade":"صحيح","narrator":"محمود بن لبيد الأنصاري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (23674)، وأبو نعيم في ((معرفة الصحابة)) (6114)، والداني في ((السنن الواردة في الفتن)) (36)","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"LAgYa62a"},{"id":"س-05633","fp":"abc3162302f5","stateId":36,"easy":"إذا رُزقت الكفاف ← فهو خير الرزق","cause":"الكَفافُ","result":"خيرُ الرِّزقِ","explicit":true,"ref":"صحيح الجامع 3275","srcLabel":"أحمد","text":[["خيرُ الرِّزقِ",2]," ",["الكَفافُ",1]],"grade":"صحيح","narrator":"زياد بن جبير","muhaddith":"صحيح","takhrij":"أخرجه أحمد في ((الزهد)) كما في ((كنز العمال)) (7097) واللفظ له.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"xpZHZODs"},{"id":"س-05634","fp":"70f7b13971bb","stateId":36,"easy":"إذا جعل الله غناك في قلبك ← فقد أفلحت","cause":"فمَن جعلَ اللهُ غناه في قلبِه","result":"فقد أفلحَ","explicit":true,"otherNeedIds":[53],"ref":"أعلام الموقعين 2/161","srcLabel":"أعلام الموقعين","text":["عن معاذَ أنه قالَ كيف تصنعون َبثلاثٍ دنيا تقطعُ أعناقَكم ، وزلةِ عالمٍ ، وجدالِ منافقٍ بالقرآنِ ؛ فأما العالمُ فإن اهتدى فلا تقلدُوه دينَكم وإن افتتنَ فلا تقطعوا منه إياسَكم فإن المؤمنَ يفتتنُ ثم يتوبُ ، وأما القرآنُ فإن له منارًا كمنارِ الطريقِ لا يخفى على أحدٍ فما علمْتُم منه فلا تسألوا عنه أحدًا ، وما لم تعلموا فكِلوه إلى عالمِه ، وأما الدنيا ",["فمَن جعلَ اللهُ غناه في قلبِه",1]," ",["فقد أفلحَ",2]," ومن لا فليست بنافعتِه دنياه"],"grade":"صحيح","muhaddith":"صحيح","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"ICVvecU7"},{"id":"س-05654","fp":"aa1df78cedcf","stateId":36,"easy":"إذا كان همّك الآخرة ← يجمع الله شملك ويجعل غناك في قلبك وتأتيك الدنيا راغمة","cause":"مَن كانَ هَمُّه الآخِرةَ","result":"جَمَعَ اللهُ شَمْلَه، وجَعَلَ غِناه في قَلْبِه، وأَتَتْه الدُّنْيا وهي راغِمةٌ","explicit":true,"repOf":"س-04738","otherNeedIds":[1],"ref":"الصحيح المسند 351","text":["أنَّ زَيدَ بنَ ثابِتٍ خَرَجَ مِن عنْدِ مَرْوانَ نَحْوًا مِن نِصْفِ النَّهارِ، فقُلْنا: ما بَعَثَ إليه السَّاعةَ إلَّا لشيءٍ سَألَه عنه، فقُمْتُ إليه، فسَألْتُه، فقالَ: أجَلْ، سَألَنا عن أشْياءَ سَمِعْتُها مِن رَسولِ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ يقولُ: «نَضَّرَ اللهُ امْرَأً سَمِعَ مِنَّا حَديثًا فحَفِظَه حتَّى يُبَلِّغَه غَيْرَه؛ فإنَّه رُبَّ حامِلِ فِقْهٍ ليس بفَقيهٍ، ورُبَّ حامِلِ فِقْهٍ إلى مَن هو أَفقَهُ مِنه، ثَلاثُ خِصالٍ لا يُغِلُّ عليهن قَلْبُ مُسلِمٍ أبَدًا: إخْلاصُ العَمَلِ للهِ، ومُناصَحةُ وُلاةِ الأمْرِ، ولُزومُ الجَماعةِ؛ فإنَّ دَعْوتُهم تُحيطُ مِن وَرائِهم»، وقالَ: «",["مَن كانَ هَمُّه الآخِرةَ ",1],["جَمَعَ اللهُ شَمْلَه، وجَعَلَ غِناه في قَلْبِه، وأَتَتْه الدُّنْيا وهي راغِمةٌ، ",2],"ومَن كانَت نِيَّتُه الدُّنْيا فَرَّقَ اللهُ عليه ضَيعتَه، وجَعَلَ فَقْرَه بَيْنَ عَيْنَيه، ولم يَأتِه مِن الدُّنْيا إلَّا ما كُتِبَ له»، وسَألْنا عن الصَّلاةِ الوُسْطى وهي الظُّهْرُ."],"grade":"صحيح","narrator":"زيد بن ثابت","muhaddith":"صحيح","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"WqH1UqRw"},{"id":"س-05791","fp":"37d5feec40b9","stateId":36,"easy":"إذا اغتنيت بالقرآن ← فهو غنى لا فقر بعده","cause":"القرآنُ","result":"غِنًى لا فقرَ بعدَه، و لا غِنَى دونَه","explicit":true,"otherNeedIds":[1],"ref":"الجامع الصغير 6165","srcLabel":"الطبراني","text":[["القرآنُ",1]," ",["غِنًى لا فقرَ بعدَه،  و لا غِنَى دونَه",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (1/ 255) (738)، والقضاعي في ((مسند الشهاب)) (276 )، والبيهقي في ((شعب الإيمان)) (2376 )","bab":"رقائق وزهد › الوصايا النافعة","dorar":"GqxqPA5q"},{"id":"س-06581","fp":"27d9f088c5ab","stateId":36,"easy":"إذا أقمت الصلاة ← تجد فيها راحتك","cause":"بالصلاةِ","result":"فأرِحْنا","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"تخريج مشكل الآثار 5549","srcLabel":"أبو داود","text":["عن عبدِ اللهِ بنِ محمَّدِ بنِ الحَنَفيَّةِ قال: دخَلْتُ مع أبي على صِهْرٍ لنا منَ الأنصارِ، فحضَرَتِ الصلاةُ، فقال: يا جاريَتي، [ائْتيني] بوَضوءٍ لعَلِّي أتوضَّأُ فأستَريحَ، فرآنا أنْكَرْنا ذلك، أو فكأنَّه رآنا أنْكَرْنا ذلك، فقال: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: قُمْ يا بلالُ ",["فأرِحْنا",2]," ",["بالصلاةِ",1],"."],"grade":"صحيح","narrator":"صهر محمد بن الحنفية","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4986)، وأحمد (23154)، والطحاوي في ((مشكل الآثار)) (5549) واللفظ لهم.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"CYPNPXE5","merged":7,"otherRefs":["الكافي الشاف 15 (حسن)","الآداب الشرعية 2/380 (حسن)","تخريج العواصم والقواصم 6/ 24 (صحيح)","تخريج زاد المعاد 1/256 (صحيح)","تخريج الإحياء للعراقي 1/224 (صحيح)","صحيح أبي داود 4985 (صحيح)"]},{"id":"س-08428","fp":"fd33c50367b6","stateId":36,"easy":"إذا أردت أن تكون أغنى الناس ← فكن بما في يد الله أوثق منك بما في يدك","cause":"فلْيَكُنْ بما في يَدِ اللهِ أوثَقَ ممَّا في يَدِهِ","result":"ومَن أحَبَّ أنْ يكونَ أغْنى النَّاسِ","explicit":true,"otherNeedIds":[1],"ref":"المستدرك على الصحيحين 7916","srcLabel":"عبد بن حميد","text":["عنْ مُحمَّدِ بنِ كعْبٍ القُرَظِيِّ، قالَ: شَهِدْتُ عُمَرَ بنَ عبدِ العزيزِ وهو أميرٌ علينا بالمدينةِ للوَليدِ بنِ عبدِ المَلِكِ، وهو شابٌّ غليظٌ مُمتلِئُ الجِسْمِ، فلَمَّا استُخْلِفَ أتَيتُه بخُناصِرَةَ، فدَخلْتُ عليهِ وقد قاسَى ما قاسَى، فإذا هو قدْ تغيَّرَتْ حالتُهُ عمَّا كان، ثُمَّ ذَكَرَ الحديثَ. \n وزادَ فيهِ: ومَن نظَرَ في كتابِ أخيهِ بغيرِ إذنِهِ، فكأنَّما يَنظُرُ في النَّارِ، ومَن أحَبَّ أنْ يكونَ أقوى النَّاسِ فلْيَتوكَّلْ على اللهِ، ومَن أحَبَّ أنْ يكونَ أكرَمَ النَّاسِ فلْيَتَّقِ اللهَ عزَّ وجلَّ، ",["ومَن أحَبَّ أنْ يكونَ أغْنى النَّاسِ",2]," ",["فلْيَكُنْ بما في يَدِ اللهِ أوثَقَ ممَّا في يَدِهِ",1],".\n وقالَ: أفأُنَبِّئُكُم بشَرٍّ مِن هذا؟ قالوا: نعَمْ يا رسولَ اللهِ، قالَ: مَن لا يُقيلُ عثْرَةً، ولا يَقبَلُ مَعذرةً، ولا يَغفِرُ ذنْبًا، أفأُنبِّئُكُم بشَرٍّ مِن هذا؟ قالوا: نعَمْ يا رسولَ الله. قالَ: مَن لا يُرجَى خَيرُه، ولا يُؤمَنُ شَرُّه. إنَّ عِيسى ابنَ مريمَ صلَواتُ اللهِ عليه قامَ في بني إسرائيلَ، فقالَ: يا بَني إسرائيلَ، لا تتَكَلَّموا بالحكمةِ عندَ الجاهلِ فتَظْلِموها، ولا تَمْنَعوها أهْلَها فتَظْلِموهُم، ولا تَظْلِموا ظالِمًا، ولا تُكافِئوا ظالِمًا؛ فيَبْطُلَ فضْلُكُم عندَ رَبِّكم، يا بَني إسرائيلَ، الأمْرُ ثَلاثٌ: أمْرٌ تَبيَّنَ غَيُّهُ فاجْتَنِبوه، وأمْرٌ اختُلِفَ فيه فرُدُّوهُ إلى اللهِ عزَّ وجلَّ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه عبد بن حميد ((المنتخب من مسنده)) (675)، ابن أبي أسامة ((مسند الحارث)) (1070)، وأبو طاهر المخلص في ((المخلصيات)) (21) بنحوه","bab":"مناقب وفضائل › فضائل جمع من الصحابة والتابعين","dorar":"phOdyaJA"},{"id":"س-01633","fp":"537e8497db2c","stateId":36,"easy":"إذا قنعت بما رزقك الله ← استغنيت عن الدَّين والحاجة (من أثر سلمان)","cause":"الحمدُ للهِ الذي قنَّعنا بما رزقنا","result":"لو قُنِّعتَ بما رزقَك لم تكنْ مطهرتِي مرهونةً","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[1],"ref":"مجمع الزوائد 8/182","srcLabel":"أحمد","text":["دخلت أنا وصاحبٌ لي إلى سلمانَ الفارسيِّ فقال سلمانُ لولا أن رسولَ اللهِ صلَّى اللهُ عليه وسلَّم نهَى عن التكلفِ لتكلفتُ لكم ثم جاء بخبزٍ وملحٍ فقال صاحبي لو كان في مِلحِنا صعترٌ فبعث سلمانُ بمطهرتِه فرَهَنها ثم جاء بصعترٍ فلما أكلنا قال صاحبِي ",["الحمدُ للهِ الذي قنَّعنا بما رزقنا",1]," فقال سلمانُ ",["لو قُنِّعتَ بما رزقَك لم تكنْ مطهرتِي مرهونةً",2]],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"رجاله رجال الصحيح غير محمد بن منصور الطوسي وهو ثقة","takhrij":"أخرجه أحمد (23733) مختصرا والطبراني (6/ 235) (6085) والحاكم (7146) باختلاف يسير","bab":"أطعمة › طعام الضيف","dorar":"XEmbQhD6"},{"id":"س-05526","fp":"c9688a5a7a24","stateId":36,"easy":"إذا كانت الآخرة نيتك ← يجعل الله غناك في قلبك ويجمع عليك أمرك","cause":"ومن تكُنِ الآخرةُ نيَّتَه","result":"جعل اللهُ تعالَى غناه في قلبِه وجمع عليه ضَيْعتَه","explicit":true,"repOf":"س-04738","otherNeedIds":[1],"ref":"تخريج الإحياء للعراقي 5/88","text":["من كانت الدُّنيا نيَّتَه جعل اللهُ فقرَه بين عينَيْه ",["ومن تكُنِ الآخرةُ نيَّتَه ",1],["جعل اللهُ تعالَى غناه في قلبِه وجمع عليه ضَيْعتَه ",2],". . ."],"grade":"حسن","narrator":"زيد بن ثابت","muhaddith":"إسناده جيد","takhrij":"أخرجه ابن ماجه (4105) باختلاف يسير، وأحمد (21590) مطولاً باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"AWonDD1q"},{"id":"س-05550","fp":"c5b08a200a73","stateId":36,"easy":"إذا زهدت ← فالزهد غنى الأبد","cause":"والزُهدُ","result":"غِنَى الأبَدِ","explicit":true,"ref":"مختصر المقاصد 575","srcLabel":"الديلمي","text":["الصبرُ مِفتاحُ الفَرَجِ , ",["والزُهدُ",1]," ",["غِنَى الأبَدِ",2]],"grade":"حسن","narrator":"[الحسين بن علي بن أبي طالب]","muhaddith":"حسن لغيره","takhrij":"أخرجه الديلمي في ((الفردوس)) (3844)","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"14dhbZAD"},{"id":"س-00952","fp":"7799a4fb0443","stateId":36,"easy":"إذا رضيت بما أوتيت ← تكون أغنى عباد الله","cause":"الَّذي يَرضى بما يُؤتَى","result":"فأيُّ عبادِك أغنى","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح ابن حبان 6217","srcLabel":"متفق عليه","text":["سأَل موسى ربَّه عن ستِّ خِصالٍ كان يظُنُّ أنَّها له خالصةٌ والسَّابعةُ لم يكُنْ موسى يُحِبُّها قال : يا ربِّ أيُّ عبادِك أتقى ؟ قال الَّذي يذكُرُ ولا يَنسى قال : فأيُّ عبادِك أهدى ؟ قال : الَّذي يتَّبِعُ الهُدى قال : فأيُّ عبادِك أحكَمُ ؟ قال : الَّذي يحكُمُ للنَّاسِ كما يحكُمُ لنفسِه قال : فأيُّ عبادِك أعلَمُ ؟ قال : عالمٌ لا يشبَعُ مِن العِلمِ يجمَعُ عِلمَ النَّاسِ إلى عِلمِه قال فأيُّ عبادِك أعَزُّ ؟ قال : الَّذي إذا قدَر غفَر قال : ",["فأيُّ عبادِك أغنى",2]," ؟ قال : ",["الَّذي يَرضى بما يُؤتَى",1]," قال : فأيُّ عبادِك أفقَرُ ؟ قال : صاحبٌ منقوصٌ ) قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ( ليس الغِنى عن ظَهْرٍ إنَّما الغِنى غِنى النَّفسِ وإذا أراد اللهُ بعبدٍ خيرًا جعَل غناه في نفسِه وتُقاهُ في قلبِه وإذا أراد اللهُ بعبدٍ شرًّا جعَل فقرَه بيْنَ عينَيْهِ )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن عساكر في ((تاريخ دمشق)) (61/ 134) بلفظه، والبخاري (6446)، ومسلم (1051) كلاهما مختصرا ببعض لفظه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"BWzqJ8PQ"},{"id":"س-05388","fp":"a295fbc129d5","stateId":37,"easy":"إذا أحببت المرء لله، وكان الله ورسوله أحب إليك مما سواهما ← تجد طعم الإيمان","cause":"مَن كانَ يُحِبُّ المَرءَ لا يُحِبُّه إلَّا للَّهِ، ومَن كانَ اللهُ ورَسولُه أحَبَّ إليه ممَّا سِواهما، ومَن كانَ أن يُلقى في النَّارِ أحَبَّ إليه مِن أن يَرجِعَ في الكُفرِ بَعدَ أن أنقَذَه اللهُ منه","result":"ثَلاثٌ مَن كُنَّ فيه وجَدَ طَعمَ الإيمانِ","explicit":true,"star":true,"otherNeedIds":[17],"ref":"صحيح مسلم 43","srcLabel":"متفق عليه","text":[["ثَلاثٌ مَن كُنَّ فيه وجَدَ طَعمَ الإيمانِ",2],": ",["مَن كانَ يُحِبُّ المَرءَ لا يُحِبُّه إلَّا للَّهِ، ومَن كانَ اللهُ ورَسولُه أحَبَّ إليه ممَّا سِواهما، ومَن كانَ أن يُلقى في النَّارِ أحَبَّ إليه مِن أن يَرجِعَ في الكُفرِ بَعدَ أن أنقَذَه اللهُ منه",1],". وفي روايةٍ: مِن أن يَرجِعَ يَهوديًّا أو نَصرانيًّا."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (16)، ومسلم (43).","bab":"رقائق وزهد › الحب في الله","dorar":"7cLw5YFU","merged":3,"otherRefs":["تخريج المسند لشاكر 15/118 (صحيح)","صحيح البخاري 6041 (صحيح)"]},{"id":"س-04760","fp":"0579b0e66a0d","stateId":37,"easy":"إذا أحببت الله ورسوله أكثر من كل شيء وأحببت وأبغضت في الله ← تجد حلاوة الإيمان","cause":"أنْ يَكُونَ اللهُ عزَّ وجلَّ ورسولُهُ أحبَّ إليهِ مِمَّا سِوَاهُما . وأنْ يُحِبَّ في اللهِ ويُبْغِضَ في اللهِ. وأنْ تُوقَدَ نارٌ عَظِيمَةٌ فَيَقَعَ فيها ؛ أحبَّ إليهِ من أنْ يُشْرِكَ باللهِ شيئًا","result":"وجدَ بِهنَّ حَلاوَةَ الإيمانِ وطَعْمَهُ","explicit":true,"otherNeedIds":[17],"ref":"السلسلة الصحيحة 3423","srcLabel":"متفق عليه","text":["ثَلاثٌ مَنْ كُنَّ فيهِ ؛ ",["وجدَ بِهنَّ حَلاوَةَ الإيمانِ وطَعْمَهُ",2]," : ",["أنْ يَكُونَ اللهُ عزَّ وجلَّ ورسولُهُ أحبَّ إليهِ مِمَّا سِوَاهُما . وأنْ يُحِبَّ في اللهِ ويُبْغِضَ في اللهِ. وأنْ تُوقَدَ نارٌ عَظِيمَةٌ فَيَقَعَ فيها ؛ أحبَّ إليهِ من أنْ يُشْرِكَ باللهِ شيئًا",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح رجاله ثقات رجال مسلم","takhrij":"أخرجه البخاري (16)، ومسلم (43)، والترمذي (2624)، والنسائي (4987) واللفظ له، وابن ماجه (4033)، وأحمد (12021).","bab":"رقائق وزهد › البغض في الله","dorar":"LNw6Lg5I"},{"id":"ق-1083","fp":"8a3187ab343f","stateId":37,"easy":"خشية الله عند سماع القرآن ← لين الجلود والقلوب إلى ذكر الله (هدى الله)","cause":"خشية الله عند سماع القرآن","result":"لين الجلود والقلوب إلى ذكر الله (هدى الله)","explicit":true,"otherNeedIds":[19,15],"ref":"سورة الزمر: 23","srcLabel":"القرآن الكريم","quran":{"s":39,"from":23,"to":23,"text":"اللَّهُ نَزَّلَ أَحْسَنَ الْحَدِيثِ كِتَابًا مُتَشَابِهًا مَثَانِيَ تَقْشَعِرُّ مِنْهُ جُلُودُ الَّذِينَ يَخْشَوْنَ رَبَّهُمْ ثُمَّ تَلِينُ جُلُودُهُمْ وَقُلُوبُهُمْ إِلَى ذِكْرِ اللَّهِ ذَلِكَ هُدَى اللَّهِ يَهْدِي بِهِ مَنْ يَشَاءُ وَمَنْ يُضْلِلِ اللَّهُ فَمَا لَهُ مِنْ هَادٍ (23)","hl":[[0,233,1]]}},{"id":"س-05587","fp":"3c633cf3c764","stateId":37,"easy":"إذا زهدت في الدنيا ← يرتاح قلبك وبدنك","cause":"الزهدُ في الدنيا","result":"يريحُ القلبَ والبدنَ","explicit":true,"ref":"شرح كتاب الشهاب 428","srcLabel":"القضاعي","text":[["الزهدُ في الدنيا",1]," ",["يريحُ القلبَ والبدنَ",2]," والرغبةُ فيها تكثرُ الهمَّ والحزنَ والبطالةُ تقسِّي القلبَ"],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"إسناده حسن","takhrij":"أخرجه القضاعي في ((مسند الشهاب)) (278 )","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"Jxm2JwlN"},{"id":"س-07318","fp":"c7ab2383ee14","stateId":37,"easy":"إذا لم تُعطَ فتبطر ولم تُمنع فتسأل ← فأنت من خير الأمة","cause":"الذينَ لمْ يُعطُوا فيَبطُروا، و لمْ يُمنعُوا فيسألوا","result":"خيرُ أمتي","explicit":true,"otherNeedIds":[47],"ref":"الجامع الصغير 4038","srcLabel":"المحاملي","text":[["خيرُ أمتي",2]," ",["الذينَ لمْ يُعطُوا فيَبطُروا،  و لمْ يُمنعُوا فيسألوا",1]],"grade":"حسن","narrator":"الجذع الأنصاري","muhaddith":"حسن","takhrij":"أخرجه المحاملي في ((الأمالي)) (476) واللفظ له.","bab":"فتن › فتنة المال","dorar":"OPA9D2KQ"},{"id":"س-00905","fp":"1cf4bec14ccc","stateId":38,"easy":"إذا استيقظت فتوضأت وصليت ← تصبح نشيطاً طيّب النفس","cause":"فإن هو توضأ و قام إلى الصلاةِ","result":"أصبح نشيطًا قد أصاب خيرًا ، و قد انحلَّتْ عُقَدُه كلُّها","explicit":true,"apply":{"k":"time","t":"عند الاستيقاظ"},"otherNeedIds":[31],"ref":"صحيح الترغيب 648","srcLabel":"أحمد","text":["ما من مسلمٍ ذكرٍ و لا أنثى ينامُ إلا و عليه جريرٌ معقودٌ ، ",["فإن هو توضأ و قام إلى الصلاةِ",1]," ",["أصبح نشيطًا قد أصاب خيرًا ، و قد انحلَّتْ عُقَدُه كلُّها",2]," ، و إن استيقظ و لم يذكرِ اللهَ أصبح و عُقَدُه عليه ، و أصبح ثقيلًا كسلانَ ، و لم يُصِبْ خيرًا"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أحمد (14387)، وأبو يعلى (2298)، وابن خزيمة (1133) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"y7GpftJm"},{"id":"س-04088","fp":"94f24827f76c","stateId":38,"easy":"إذا استيقظت فذكرت الله وتوضأت وصليت ← تصبح نشيطاً طيّب النفس","cause":"فإنِ استَيقَظَ فذَكَرَ اللهَ انحَلَّت عُقدةٌ، فإن تَوضَّأ انحَلَّت عُقدةٌ، فإن صَلَّى انحَلَّت عُقدُه كُلُّها","result":"فأصبَحَ نَشيطًا طَيِّبَ النَّفسِ","explicit":true,"star":true,"apply":{"k":"time","t":"عند الاستيقاظ"},"otherNeedIds":[31,7],"ref":"صحيح البخاري 3269","srcLabel":"مسلم","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، قال: يَعقِدُ الشَّيطانُ على قافيةِ رَأسِ أحَدِكُم إذا هو نامَ ثَلاثَ عُقدٍ، يَضرِبُ كُلَّ عُقدةٍ مَكانَها: عليك لَيلٌ طَويلٌ فارقُدْ، ",["فإنِ استَيقَظَ فذَكَرَ اللهَ انحَلَّت عُقدةٌ، فإن تَوضَّأ انحَلَّت عُقدةٌ، فإن صَلَّى انحَلَّت عُقدُه كُلُّها",1],"، ",["فأصبَحَ نَشيطًا طَيِّبَ النَّفسِ",2],"، وإلَّا أصبَحَ خَبيثَ النَّفسِ كَسلانَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (776) باختلاف يسير","bab":"جن › صفة إبليس وجنوده","dorar":"Vqe3YouH","merged":7,"otherRefs":["تخريج المسند لشعيب 7308 (صحيح)","تخريج مشكل الآثار 340 (صحيح)","تخريج المسند لشعيب 10453 (صحيح)","صحيح ابن خزيمة 2/ 310 (صحيح)","صحيح مسلم 776 (صحيح)","صحيح ابن ماجه 1102 (صحيح)"]},{"id":"س-01161","fp":"07c3662f2f1b","stateId":38,"easy":"إذا قمت من الليل فتوضأت وصليت ← تصبح خفيفاً طيّب النفس، ومن نام حتى الصبح أصبح ثقيلاً","cause":"وإنْ قام وتوضَّأ حُلَّتْ عُقدةٌ أُخْرى، فإذا هو صلَّى حُلَّتْ عُقَدُه كلُّها","result":"وأصبَح خَفيفًا طيِّبَ النفْسِ، وإنْ هو نام حتى يُصبِحَ أصبَح عليه عُقَدٌ، وأصبَح وهو ثَقيلٌ خَبيثَ النفْسِ","explicit":true,"apply":{"k":"time","t":"في الليل"},"ref":"تخريج مشكل الآثار 341","srcLabel":"متفق عليه","text":["إنَّ للشَّيطانِ عندَ رأسِ أحَدِكم حَبلًا فيه ثلاثُ عُقَدٍ، فإذا استيقَظ، ووحَّد اللهَ حُلَّتْ عُقدةٌ، ",["وإنْ قام وتوضَّأ حُلَّتْ عُقدةٌ أُخْرى، فإذا هو صلَّى حُلَّتْ عُقَدُه كلُّها، ",1],["وأصبَح خَفيفًا طيِّبَ النفْسِ، وإنْ هو نام حتى يُصبِحَ أصبَح عليه عُقَدٌ، وأصبَح وهو ثَقيلٌ خَبيثَ النفْسِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الطحاوي في  ((شرح مشكل الآثار)) (341) واللفظ له، والبخاري (1142)، ومسلم (776) كلاهما بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"lDEVgjKC"},{"id":"س-00897","fp":"c985bc51536a","stateId":38,"easy":"إذا استيقظت فذكرت الله وتوضأت وصليت ← تصبح نشيطاً قد أصبت خيراً","cause":"فإنِ استيقظَ فذَكَرَ اللَّهَ","result":"انحلَّت عقدةٌ ، وإن هوَ توضَّأَ ثمَّ قامَ إلى الصَّلاةِ ؛ أصبحَ نشيطًا قد أصابَ خيرًا وقدِ انحلَّت عقَدُهُ كلُّها","explicit":true,"star":true,"apply":{"k":"time","t":"عند الاستيقاظ"},"otherNeedIds":[31],"ref":"صحيح الموارد 147","srcLabel":"أحمد","text":["ما مِن مسلمٍ ذَكَرٍ ولا أنثى يَنامُ إلَّا وعليهِ جريرٌ معقودٌ ، [ ",["فإنِ استيقظَ فذَكَرَ اللَّهَ",1]," ",["انحلَّت عقدةٌ ] ، وإن هوَ توضَّأَ ثمَّ قامَ إلى الصَّلاةِ ؛ أصبحَ نشيطًا قد أصابَ خيرًا وقدِ انحلَّت عقَدُهُ كلُّها",2]," ، وإن أصبحَ ولم يذكرِ اللَّهَ أصبحَ وعقدُهُ عليهِ ، وأصبحَ ثقيلًا كَسلانًا لم يصب خيرًا"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أحمد (14387)، وأبو يعلى (2298)، وابن حبان (2556) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"xUYwZb0N","merged":4,"otherRefs":["صحيح ابن خزيمة 2/ 311 (صحيح)","مجمع الزوائد 2/264 (صحيح)","صحيح النسائي 1606 (صحيح)"]}]}