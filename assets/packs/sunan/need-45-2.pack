{"schema":1,"kind":"sunan-chunk","version":"sunan-cb5af5731a1c","needId":45,"stateIds":[439,440,441,442,443,444,445,446,447,448,449,450,451,452,453,454,455,456,457,458,459,460,461,462,463,464,465,466],"items":[{"id":"س-02357","fp":"905969977658","stateId":439,"easy":"إذا حججت راكباً ← لك بكل خطوة لراحلتك سبعون حسنة","cause":"للحاجِّ الرَّاكِبِ","result":"بكُلِّ خُطوةٍ تَخطوها راحِلَتُه سَبعونَ حَسَنةً","explicit":true,"ref":"الفروع لابن مفلح 2/ 457","srcLabel":"الطبراني","text":["عَن ابنِ عَبَّاسٍ أنَّه قال لبَنيه: يا بَنيَّ اخرُجوا مِن مَكَّةَ حاجِّينَ مُشاةً، فإنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: \"",["للحاجِّ الرَّاكِبِ",1]," ",["بكُلِّ خُطوةٍ تَخطوها راحِلَتُه سَبعونَ حَسَنةً",2],"، ولِلماشي بكُلِّ خُطوةٍ يَخطوها سَبعُمِائةِ حَسَنةٍ\"."],"grade":"صحيح","narrator":"ابن عباس","muhaddith":"صحيح","takhrij":"أخرجه الفاكهي في ((أخبار مكة)) (832)، والطبراني (12/ 75)، (12522) كلاهما بلفظه، وابن خزيمة (2791) بنحوه.","bab":"إحسان › الحسنات والسيئات","dorar":"eoUlweUU"},{"id":"س-02822","fp":"30e0659b1689","stateId":439,"easy":"إذا خرجت من بيتك حاجاً ← لا تخطو راحلتك خطوة إلا كُتبت لك حسنة أو حُطت سيئة","cause":"فإنَّ له حينَ يخرُجُ مِن بيتِه","result":"أنَّ راحلتَه لا تخطو خُطوةً إلَّا كُتِب له بها حَسنةٌ أو حُطَّت عنه بها خطيئةٌ","explicit":true,"apply":{"k":"time","t":"عند الخروج من البيت"},"otherNeedIds":[11],"ref":"شرح البخاري لابن الملقن 12/123","srcLabel":"ابن حبان","text":["حديثُ أنَّ لمن حلقَ رأسَهُ بكلِّ شعرةٍ سقطتْ من رأسِهِ نورًا يومَ القيامةِ [يعني حديث: جاء رجُلٌ مِن الأنصارِ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم فقال : يا رسولَ اللهِ كلماتٌ أسأَلُ عنهنَّ قال : ( اجلِسْ ) وجاء رجُلٌ مِن ثَقيفٍ فقال : يا رسولَ اللهِ كلماتٌ أسأَلُ عنهنَّ فقال صلَّى اللهُ عليه وسلَّم : ( سبَقكَ الأنصاريُّ ) فقال الأنصاريُّ : إنَّه رجُلٌ غريبٌ وإنَّ للغريبِ حقًّا فابدَأْ به فأقبَل على الثَّقَفيِّ فقال : ( إنْ شِئْتَ أجبَتْكُ عمَّا كُنْتَ تسأَلُ وإنْ شِئْتَ سأَلْتَني وأُخبِرُكَ ) فقال : يا رسولَ اللهِ بل أجِبْني عمَّا كُنْتُ أسأَلُكَ قال : ( جِئْتَ تسأَلُني عنِ الرُّكوعِ والسُّجودِ والصَّلاةِ والصَّومِ ) فقال : لا والَّذي بعَثك بالحقِّ ما أخطَأْتَ ممَّا كان في نفسي شيئًا قال : ( فإذا ركَعْتَ فضَعْ راحتَيْكَ على رُكبَتْيكَ ثمَّ فرِّجْ بَيْنَ أصابعِكَ ثمَّ امكُثْ حتَّى يأخُذَ كلُّ عضوٍ مأخَذَه وإذا سجَدْتَ فمَكِّنْ جبهتَكَ ولا تنقُرْ نَقْرًا وصَلِّ أوَّلَ النَّهارِ وآخِرَه ) فقال : يا نَبيَّ اللهِ فإنْ أنا صلَّيْتُ بَيْنَهما ؟ قال : ( فأنتَ إذًا مُصلِّي وصُمْ مِن كلِّ شهرٍ ثلاثَ عَشْرةَ وأربعَ عَشْرةَ وخمسَ عَشْرةَ ) فقام الثَّقفيُّ ثمَّ أقبَل على الأنصاريِّ فقال : ( إنْ شِئْتَ أخبَرْتُكَ عمَّا جِئْتَ تسأَلُ وإنْ شِئْتَ سأَلْتَني فأُخبِرُكَ ) فقال : لا يا نَبيَّ اللهِ أخبِرْني عمَّا جِئْتُ أسأَلُكَ قال : ( جِئْتَ تسأَلُني عنِ الحاجِّ ما له حينَ يخرُجُ مِن بيتِه وما له حينَ يقومُ بعرَفاتٍ وما له حينَ يرمي الجِمارَ وما له حينَ يحلِقُ رأسَه وما له حينَ يقضي آخِرَ طوافٍ بالبيتِ ) فقال : يا نَبيَّ اللهِ والَّذي بعَثك بالحقِّ ما أخطَأْتَ ممَّا كان في نفسي شيئًا قال : ( ",["فإنَّ له حينَ يخرُجُ مِن بيتِه",1]," ",["أنَّ راحلتَه لا تخطو خُطوةً إلَّا كُتِب له بها حَسنةٌ أو حُطَّت عنه بها خطيئةٌ",2]," فإذا وقَف بعرَفةَ فإنَّ اللهَ عزَّ وجلَّ ينزِلُ إلى السَّماءِ الدُّنيا فيقولُ : انظُروا إلى عبادي شُعْثًا غُبْرًا اشهَدوا أنِّي قد غفَرْتُ لهم ذُنوبَهم وإنْ كان عدَدَ قَطْرِ السَّماءِ ورَمْلِ عالجٍ وإذا رمى الجِمارَ لا يدري أحَدٌ ما له حتَّى يُوفَّاه يومَ القيامةِ وإذا حلَق رأسَه فله بكلِّ شَعرةٍ سقَطَتْ مِن رأسِه نورٌ يومَ القيامةِ وإذا قضى آخِرَ طوافِه بالبيتِ خرَج مِن ذنوبِه كيومَ ولَدَتْه أُمُّه )]"],"grade":"صحيح","narrator":"[عبدالله بن عمر]","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (1887) بلفظه تامًا، وعبد الرزاق (8830)، والبيهقي في ((الدلائل)) (6/ 293) بنحوه تامًا.","bab":"إيمان › الوعد","dorar":"gtGMMaGB"},{"id":"س-02824","fp":"9d8d87584c5c","stateId":439,"easy":"إذا رميت الجمار ← لا يعلم أحد ما لك حتى توفاه يوم القيامة","cause":"وإذا رمى الجِمارَ","result":"لا يدري أحَدٌ ما له حتَّى يُوفَّاه يومَ القيامةِ","explicit":true,"ref":"شرح البخاري لابن الملقن 12/123","srcLabel":"ابن حبان","text":["حديثُ أنَّ لمن حلقَ رأسَهُ بكلِّ شعرةٍ سقطتْ من رأسِهِ نورًا يومَ القيامةِ [يعني حديث: جاء رجُلٌ مِن الأنصارِ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم فقال : يا رسولَ اللهِ كلماتٌ أسأَلُ عنهنَّ قال : ( اجلِسْ ) وجاء رجُلٌ مِن ثَقيفٍ فقال : يا رسولَ اللهِ كلماتٌ أسأَلُ عنهنَّ فقال صلَّى اللهُ عليه وسلَّم : ( سبَقكَ الأنصاريُّ ) فقال الأنصاريُّ : إنَّه رجُلٌ غريبٌ وإنَّ للغريبِ حقًّا فابدَأْ به فأقبَل على الثَّقَفيِّ فقال : ( إنْ شِئْتَ أجبَتْكُ عمَّا كُنْتَ تسأَلُ وإنْ شِئْتَ سأَلْتَني وأُخبِرُكَ ) فقال : يا رسولَ اللهِ بل أجِبْني عمَّا كُنْتُ أسأَلُكَ قال : ( جِئْتَ تسأَلُني عنِ الرُّكوعِ والسُّجودِ والصَّلاةِ والصَّومِ ) فقال : لا والَّذي بعَثك بالحقِّ ما أخطَأْتَ ممَّا كان في نفسي شيئًا قال : ( فإذا ركَعْتَ فضَعْ راحتَيْكَ على رُكبَتْيكَ ثمَّ فرِّجْ بَيْنَ أصابعِكَ ثمَّ امكُثْ حتَّى يأخُذَ كلُّ عضوٍ مأخَذَه وإذا سجَدْتَ فمَكِّنْ جبهتَكَ ولا تنقُرْ نَقْرًا وصَلِّ أوَّلَ النَّهارِ وآخِرَه ) فقال : يا نَبيَّ اللهِ فإنْ أنا صلَّيْتُ بَيْنَهما ؟ قال : ( فأنتَ إذًا مُصلِّي وصُمْ مِن كلِّ شهرٍ ثلاثَ عَشْرةَ وأربعَ عَشْرةَ وخمسَ عَشْرةَ ) فقام الثَّقفيُّ ثمَّ أقبَل على الأنصاريِّ فقال : ( إنْ شِئْتَ أخبَرْتُكَ عمَّا جِئْتَ تسأَلُ وإنْ شِئْتَ سأَلْتَني فأُخبِرُكَ ) فقال : لا يا نَبيَّ اللهِ أخبِرْني عمَّا جِئْتُ أسأَلُكَ قال : ( جِئْتَ تسأَلُني عنِ الحاجِّ ما له حينَ يخرُجُ مِن بيتِه وما له حينَ يقومُ بعرَفاتٍ وما له حينَ يرمي الجِمارَ وما له حينَ يحلِقُ رأسَه وما له حينَ يقضي آخِرَ طوافٍ بالبيتِ ) فقال : يا نَبيَّ اللهِ والَّذي بعَثك بالحقِّ ما أخطَأْتَ ممَّا كان في نفسي شيئًا قال : ( فإنَّ له حينَ يخرُجُ مِن بيتِه أنَّ راحلتَه لا تخطو خُطوةً إلَّا كُتِب له بها حَسنةٌ أو حُطَّت عنه بها خطيئةٌ فإذا وقَف بعرَفةَ فإنَّ اللهَ عزَّ وجلَّ ينزِلُ إلى السَّماءِ الدُّنيا فيقولُ : انظُروا إلى عبادي شُعْثًا غُبْرًا اشهَدوا أنِّي قد غفَرْتُ لهم ذُنوبَهم وإنْ كان عدَدَ قَطْرِ السَّماءِ ورَمْلِ عالجٍ ",["وإذا رمى الجِمارَ",1]," ",["لا يدري أحَدٌ ما له حتَّى يُوفَّاه يومَ القيامةِ",2]," وإذا حلَق رأسَه فله بكلِّ شَعرةٍ سقَطَتْ مِن رأسِه نورٌ يومَ القيامةِ وإذا قضى آخِرَ طوافِه بالبيتِ خرَج مِن ذنوبِه كيومَ ولَدَتْه أُمُّه )]"],"grade":"صحيح","narrator":"[عبدالله بن عمر]","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (1887) بلفظه تامًا، وعبد الرزاق (8830)، والبيهقي في ((الدلائل)) (6/ 293) بنحوه تامًا.","bab":"إيمان › الوعد","dorar":"gtGMMaGB"},{"id":"س-02355","fp":"abc1521a1463","stateId":439,"easy":"إذا حججت راكباً ← لك بكل خطوة تخطوها راحلتك سبعون حسنة","cause":"للحاجِّ الرَّاكِبِ بِكلِّ خُطْوةٍ تَخْطوها راحِلتُه","result":"سَبْعينَ حَسَنةً","explicit":true,"star":true,"ref":"الأحاديث المختارة 10 / 52","srcLabel":"متفق عليه","text":["«قالَ ابنُ عبَّاسٍ لبَنيه: يا بَنِيَّ اخْرُجوا مِن مَكَّةَ مُشاةً، حتَّى تَرجِعوا إلى مَكَّةَ مُشاةً؛ فإنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: إنَّ ",["للحاجِّ الرَّاكِبِ بِكلِّ خُطْوةٍ تَخْطوها راحِلتُه",1]," ",["سَبْعينَ حَسَنةً",2],"، ولِلماشي سَبْعُمِئةِ حَسَنةٍ مِن حَسَناتِ الحَرَمِ، قيلَ: يا رَسولَ اللهِ، وما حَسَناتُ الحَرَمِ؟ قالَ: الحَسَنةُ بمِئةِ ألْفِ حَسَنةٍ»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إحسان › الحسنات والسيئات","dorar":"FBf78Vim"},{"id":"س-07514","fp":"f98b0f022a6a","stateId":439,"easy":"إذا استلمت الحجر الأسود ← يشهد لك يوم القيامة","cause":"اسْتَلَمَه","result":"إنَّ لِهذا الحَجَرِ لِسانًا وشَفتَينِ يَشهَدُ لِمَن اسْتَلَمَه يَوْمَ القِيامةِ بحَقٍّ","explicit":true,"star":true,"otherNeedIds":[65],"ref":"الأحاديث المختارة 10 / 204","srcLabel":"متفق عليه","text":["«",["إنَّ لِهذا الحَجَرِ لِسانًا وشَفتَينِ يَشهَدُ لِمَن اسْتَلَمَه يَوْمَ القِيامةِ بحَقٍّ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"J2H3vaAp"},{"id":"س-04576","fp":"de2b5e9c0cd6","stateId":439,"easy":"إذا حججت بصبيك ← فلك أجر","cause":"رفعت امرأةٌ صبيًّا","result":"ولكِ أجرٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-07226"],"ref":"حجة النبي 45","srcLabel":"مسلم","text":["قال جابرٌ رضيَ اللهُ تعالَى عنهُ : إنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّم مكث [ بالمدينةِ ] تسعَ سنين لم يحجَّ . ثم أذَّنَ في الناسِ في العاشرةِ : أنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّم حاجٌّ [ هذا العامَ ] . فقدم المدينةَ بشرٌ كثيرٌ ( وفي روايةٍ : فلم يبق أحدٌ يقدرُ أن يأتيَ راكبًا أو راجلًا إلا قَدِمَ ) [ فتدارك الناسُ ليخرجوا معهُ ] كلُّهم يلتمسُ أن يَأْتَمَّ برسولِ اللهِ صلَّى اللهُ عليهِ وسلَّم ويعملَ مثلَ عملِه . [ وقال جابرٌ رضيَ اللهُ عنهُ : سمعتُ – قال الراوي : أحسبُه رُفِعَ إلى النبيِّ صلَّى اللهُ عليهِ وسلَّم ، ( وفي روايةٍ قال : خطَبَنا رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم ) فقال : مَهِلُّ أهلِ المدينةِ من ذي الحليفةِ ، و [ مَهِلُّ أهلِ ] الطريقِ الآخرِ الجحفةُ ، ومَهِلُّ أهلِ العراقِ من ذاتِ عرقٍ ومَهِلُّ أهلِ نجدٍ من قرنٍ ، ومَهِلُّ أهلِ اليمنِ من يلملمَ ] . [ قال فخرج رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم ] [ لخمسٍ بَقَيْنَ من ذي القعدةِ أو أربعٍ ] . [ وساق هديًا ] . فخرجنا معه [ معنا النساءُ والولدانُ ] . حتى أتينا ذا الحليفَةَ فولدتْ أسماءُ بنتُ عميسٍ محمدَ بنَ أبي بكرٍ . فأرسلت إلى رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّم : كيف أصنعُ ؟ [ ف ] قال : اغتَسِلي واستثفري بثوبٍ وأحْرِمي . فصلى رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم في المسجدِ [ وهو صامتٌ ] . ثم ركب القصواءَ حتى إذا استوت به ناقتُه على البيداءِ [ أهلَّ بالحجِّ ( وفي روايةٍ : أفرد الحجَّ ) هو وأصحابُه ] . [ قال جابرٌ ] : فنظرتُ إلى مَدِّ بصري [ من ] بين يديهِ من راكبٍ وماشٍ ، وعن يمينِه مثلَ ذلك ، وعن يسارِه مثلَ ذلك ، ومن خلفِه مثلَ ذلك ، ورسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم بين أَظْهُرِنا وعليه ينزلُ القرآنُ ، وهو يعرفُ تأويلَه ، وما عمل بهِ من شيٍء عمِلْنا به . فأَهَلَّ بالتوحيدِ : لبيكَ اللهمَّ لبيكَ ، لبيكَ لا شريكَ لك لبيكَ ، إنَّ الحمدَ والنعمةَ لك والمُلْكُ ، لا شريكَ لك . وأهلُ الناسِ بهذا الذي يُهِلُّونَ به ، ( وفي روايةٍ : ولبَّى الناسُ [ والناسُ يزيدون ] [ لبيكَ ذا المعارجِ لبيكَ ذا الفواصلِ ] فلم يَرُدَّ رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم عليهم شيئًا منه . ولزم رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم تلبِيَتَه . قال جابرٌ : [ ونحنُ نقولُ [ لبيكَ اللهمَّ ] لبيكَ بالحجِّ ] [ نصرخُ صراخًا ] لسنا ننوي إلا الحجَّ [ مفردًا ] [ لا نخلطُه بعمرةٍ ] ( وفي روايةٍ : لسنا نعرفُ العمرةَ ) وفي أخرى : أَهْلَلْنَا أصحابَ النبيِّ صلَّى اللهُ عليهِ وسلَّم بالحجِّ خالصًا ليس معهُ غيرُه ، خالصًا وحدَه ) [ قال : وأقبلت عائشةُ بعمرةٍ حتى إذا كانت ب ( ( سَرَفَ ) ) عركتْ ] . حتى إذا أتينا البيتَ معَهُ [ صُبْحَ رابعةٍ مضتْ من ذي الحجةِ ] ( وفي روايةٍ : دخلنا مكةَ عند ارتفاعِ الضحى ) فأتى النبيُّ صلَّى اللهُ عليهِ وسلَّم بابَ المسجدِ فأناخ راحلتَه ثم دخل المسجدَ ، ف ) استلمَ الركنَ ( وفي روايةٍ : الحجرَ الأسودَ ) [ ثم مضى عن يمينِه ] . فرَمَلَ [ حتى عاد إليهِ ] ثلاثًا ، ومشى أربعًا [ على هينتِه ] . ثم نفذ إلى مقامِ إبراهيمَ عليه السلامُ فقرأ ( وَاتَّخِذُوْا مِنْ مَقَامِ إِبْرَاهِيمَ مُصَلَّى ) ، [ ورفع صوتَه يُسْمِعُ الناسَ ] . فجعل المقامَ بينَه وبين البيتِ . [ فصلى ركعتينِ ] . [ قال ] : فكان يقرأُ في الركعتينِ : ( قُلْ هُوَ اللهُ أَحَدٌ ) و ( قُلْ يَا أَيُّهَا الْكَافِرُونَ ) ( وفي روايةٍ : قُلْ يَا أَيُّهَا الْكَافِرُونَ و قُلْ هُوَ اللهُ أَحَدٌ ) . [ ثم ذهب إلى زمزمَ فشرب منها ، وصبَّ على رأسِه ] . ثم رجع إلى الركنِ فاستلمَه . ثم خرج من البابِ ( وفي روايةٍ : بابِ الصفا ) إلى الصفا . فلما دنا من الصفا قرأ : ( إِنَّ الصَّفَا وَالْمَرْوَةَ مِنْ شَعَائِرِ اللَّهِ ) أبدأُ ( وفي روايةٍ : نبدأُ ) بما بدأ اللهُ به ، فبدأَ بالصفا فرقى عليهِ حتى رأى البيتَ . فاستقبل القِبلةَ فوحَّدَ اللهَ وكبَّرَه [ ثلاثًا ] و [ حمدَه ] وقال : لا إلهَ إلا اللهُ وحدَه لا شريكَ لهُ ، له المُلْكُ وله الحمدُ [ يُحْيِي ويُمِيتُ ] ، وهو على كلِّ شيٍء قديرٌ ، لا إلهَ إلا اللهُ وحدَه [ لا شريكَ له ] ، أنجزَ وعدَه ، ونصر عبدَه ، وهزم الأحزابَ وحدَه ، ثم دعا بين ذلك ، وقال مثلَ هذا ثلاثَ مراتٍ . ثم نزل [ ماشيًا ] إلى المروةِ ، حتى إذا انصبَّتْ قدماهُ في بطنِ الوادي سعى ، حتى إذا صعَدْنا [ يعني ] [ الشِّقَّ الآخرَ ] مشى حتى أتى المروةَ [ فرقى عليها حتى نظرَ إلى البيتِ ] ففعل على المروةِ كما فعل على الصفا . حتى إذا كان آخرَ طوافِه ( وفي روايةٍ : كان السابعَ ) على المروةِ فقال : [ يا أيها الناسُ ] لو أني استقبلتُ من أمري ما استدبرتُ لم أَسُقِ الهَدْيَ و [ ل ] جعلتُها عمرةً ، فمن كان منكم معَهُ هَدْيٌ فليُحِلَّ وليجعَلْها عمرةً ، ( وفي روايةٍ : فقال : أحِلُّوا من إحرامِكم ، فطوفوا بالبيتِ ، وبين الصفا والمروةِ وقصرُوا ، وأقيموا حلالًا . حتى إذا كان يومَ الترويةِ فأهِلُّوا بالحجِّ واجعلوا التي قدِمْتُمْ بها متعةً ) . فقام سراقةُ بنُ مالكِ بنُ جعشمٍ ( وهو في أسفلِ المروةَ ) فقال : يا رسولَ اللهِ [ أرأيتَ عُمْرَتَنا ( وفي لفظٍ : مُتْعَتَنا ) هذه ] [أ]لعامِنا هذا أم لأبدِ [ الأبدِ ] ؟ [ قال ] فشبَّك رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم أصابعَه واحدةً في أخرى وقال : دخلتِ العمرةُ في الحجِّ [ إلى يومِ القيامةِ ] لا بل لأبدِ الأبدِ ، [ لا بل لأبدِ الأبدِ ] ، [ ثلاثَ مراتٍ ] . [ قال : يا رسولَ اللهِ بيِّنْ لنا دِينَنا كأنَّا خُلِقْنا الآن ، فيما العملُ اليومَ ؟ أفيما جفَّت به الأقلامُ وجرَتْ به المقاديرُ أفيما نستقبلُ ؟ قال : لا بل فيما جفَّتْ به الأقلامُ وجرَتْ به المقاديرُ . قال : ففيم العملُ [ إذن ] ؟ قال : اعملوا فكلٌّ مُيَسَّرٌ ] ، ( لِمَا خُلِقَ له ] . ( قال جابرٌ : فأُمِرْنَا إذا حَلَلْنَا أن نُهْدِيَ ، ويجتمعُ النفرُ منا في الهديةِ ] [ كلُّ سبعةٍ منا في بدنةٍ ] [ فمن لم يكن معَه هديٌ ، فليصم ثلاثةَ أيامٍ وسبعةً إذا رجع إلى أهلِه ] . [ قال : فقلنا : حَلَّ ماذا ؟ قال : الحِلُّ كلُّه ] . [ قال : فكبُرَ ذلك علينا ، وضاقت به صدُورُنا ] . [ قال : فخرجنا إلى البطحاءِ ، قال : فجعل الرجلُ يقول : عهدي بأهلي اليومَ ] . [ قال : فتذاكَرْنا بيننا فقلنا : خرجنا حُجَّاجًا لا نُرِيدُ إلا الحجَّ ، ولا ننوي غيرَه ، حتى إذا لم يكن بيننا وبين عرفةَ إلا أربعٌ ] ( وفي روايةٍ : خمسَ [ ليالٍ ] أمرنا أن نُفْضِي إلى نسائِنا فنأتيَ عرفةَ تقطرُ مذاكيرُنا المنيَّ [ من النساءِ ] ، قال : يقولُ جابرٌ بيدِه ، ( قال الرواي ) : كأني أنظرُ إلى قولِه بيدِه يُحرِّكُها ، [ قالوا : كيف نجعلُها متعةً وقد سمَّيْنا الحجَّ ؟ ] . قال : [ فبلغ ذلك النبيَّ صلَّى اللهُ عليهِ وسلَّم فما ندري أشيٌء بلغَه من السماءِ . أم شيءٌ بلغَه من قِبَلِ السماءِ ] . [ فقام ] [ فخطب الناسَ فحمد اللهَ وأثنى عليهِ ] فقال : [ أباللهِ تُعلموني أيها الناسُ ! ؟ ] قد علمتُم أني أتقاكُم للهِ وأصدَقُكم وأبرُّكم ، [ افعلوا ما آمُرُكم به فإني ] لولا هَدْيِي لحللتُ لكم كما تُحِلُّونَ [ ولكن لا يحلُّ مني حرامٌ حتى يبلغَ الهَدْيُ مَحِلَّهُ ] ولو استقبلتُ من أمري ما استدبرتُ لم أَسُقِ الهَدْيَ ، فحُلُّوا ] . [ قال : فواقعنا النساءَ وتطيَّبْنَا بالطِّيبِ ولبسنا ثيابَنا ] [ وسمِعْنا وأطعنا ] . فحلَّ الناسُ كلُّهم وقصَّرُوا إلا النبيَّ صلَّى اللهُ عليهِ وسلَّم ومن كان معه هديٌ ] . [ قال : وليس مع أحدٍ منهم هديٌ غيرَ النبيِّ صلَّى اللهُ عليهِ وسلَّم وطلحةَ ] . وقدم علي [ من سعايَتِه ] من اليمنِ ببدنِ النبيِّ ص . فوجد فاطمةَ رضيَ اللهُ عنها ممن حلَّ : [ ترجَّلَتْ ] ولبست ثيابًا صبيغًا واكتحلتْ ، فأنكرَ ذلك عليها ، [ وقال : من أمرَكِ بهذا ؟ ! ] ، فقالت أبي أمرَنِي بهذا . قال : فكان عليٌّ يقول بالعراقِ : فذهبتُ إلى رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّم محرشًا على فاطمةَ للذي صنعتْ مستفتيًا لرسولِ اللهِ صلَّى اللهُ عليهِ وسلَّم فيما ذكرتُ عنه ، فأخبرتُه أني أنكرتُ ذلك عليها [ فقالت : أبي أمرَني بهذا ] فقال : صدقتْ ، صدقتْ ، [ صدقتْ ] [ أنا أمرتُها به ] . قال جابرٌ : وقال لعليٍّ : ماذا قلتَ حين فُرِضَ الحجُّ ؟ قال قلتُ : اللهمَّ إني أُهِلُّ بما    أهلَّ به رسولُ اللهِ ص . قال : فإنَّ معيَ الهديَ فلا تحلُّ ، [ وامكث حرامًا كما أنت ] . قال : فكان جماعةُ الهديِ الذي قدم به عليٌّ من اليمنِ ، والذي أتى به النبيُّ صلَّى اللهُ عليهِ وسلَّم [ من المدينةِ ] مائةَ [ بدنةٍ ] . قال : فحلَّ الناسُ كلُّهم وقصرُوا ، إلا النبيَّ صلَّى اللهُ عليهِ وسلَّم ومن كان معه هديٌ . فلما كان يومُ الترويةِ [ وجعلنا مكةَ بظهرٍ ] توجهوا إلى مِنى فأهِلُّوا بالحجِّ [ من البطحاءِ ] . [ قال : ثم دخل رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم على عائشةَ رضيَ اللهُ عنها فوجدها تبكي فقال : ما شأنُكِ ؟ قالت : شأني أني قد حِضْتُ ، وقد حلَّ الناسُ ولم أحلُلْ ، ولم أَطُفْ بالبيتِ ، والناسُ يذهبون إلى الحجِّ الآن ، فقال : إنَّ هذا أمرٌ كتبَه اللهُ على بناتِ آدمَ ، فاغتسلي ثم أهِلِّي بالحجِّ [ ثم حُجِّي واصنعي ما يصنعُ الحاجُّ غيرَ أن لا تطوفي بالبيتِ ولا تصلي ] ففعلتْ ] . ( وفي روايةٍ : فنسكتِ المناسكَ كلَّها غيرَ أنها لم تَطُفْ بالبيتِ ) وركب رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم وصلى بها ( يعني مِنَى ، وفي روايةٍ : بنا ) الظهرَ والعصرَ والمغربِ والعشاءِ والفجرِ . ثم مكث قليلًا حتى طلعتِ الشمسُ وأمر بقُبَّةٍ [ له ] من شعرٍ تُضْرَبُ له بنَمِرَةَ . فسار رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم ولا تشكُّ قريشٌ إلا أنَّهُ واقفٌ عند المشعرِ الحرامِ [ بالمزدلفةِ ] [ ويكونُ منزلُه ثم ] كما كانت قريشٌ تصنعُ في الجاهليةِ – فأجاز رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم حتى أتى عرفةَ فوجد القُبَّةَ قد ضُرِبَتْ له بنَمِرَةَ ، فنزل بها . حتى إذا زاغتِ الشمسُ أمر بالقصواءِ فرُحِّلَتْ له ، ف [ ركب حتى ] أتى بطنَ الوادي . فخطب الناسَ وقال : إنَّ دماءَكم وأموالَكم حرامٌ عليكم ، كحُرْمَةِ يومِكم هذا ، في شهرِكم هذا ، في بلدِكم هذا ، ألا [ و ] [ إنَّ ] كلَّ شيٍء من أمرِ الجاهليةِ تحت قدمي [ هاتين ] موضوعٌ ، ودماءُ الجاهليةِ موضوعةٌ ، وإنَّ أولَ دمٍ أضعُ من دمائِنا دمَ ابنِ ربيعةَ بنِ الحارثِ [ ابنِ عبدِ المطلبِ ] – كان مسترضعًا في بني سعدٍ فقتَلَتْه هذيلٌ - . وربا الجاهليةِ موضوعٌ ، وأولُ ربًا أضعُ رِبَانَا : ربا العباسِ بنِ عبدِ المطلبِ فإنَّهُ موضوعٌ كلُّه فاتّقوا اللهَ في النساءِ ، فإنكم أخذتموهنَّ بأمانِ [ ة ] اللهِ واستحللتُم فروجهنَّ بكلمةِ اللهِ و [ إنَّ ] لكم عليهنَّ أن لا يُوطِئْنَ فُرُشَكُمْ أحدًا تكرهونَه ، فإن فعلْنَ ذلك فاضربوهنَّ ضربًا غيرَ مبرِّحٍ ولهنَّ عليكم رزقُهُنَّ وكسوتُهُنَّ بالمعروفِ ، و [ إني ] قد تركتُ فيكم ما لن تضلُّوا بعدُ إن اعتصمتُم به كتابَ اللهِ وأنتم تسألون ( وفي لفظٍ مسؤولونَ ) عني ، فما أنتم قائلون ؟ قالوا : نشهدُ أنك قد بلَّغْتَ [ رسالاتِ ربكَ ] وأدَّيْتَ ، ونصحتَ [ لأُمَّتِكَ ، وقضيتَ الذي عليك ] فقال بأصبعِه السبابةِ يرفعُها إلى السماءِ ويُنْكِتُها إلى الناسِ : اللهمَّ اشهد ، اللهمَّ اشهدْ . ثم أذَّنَ [ بلالٌ ] [ بنداءٍ واحدٍ ] ، ثم أقام فصلى الظهرَ ، ثم أقام فصلى العصرَ ، ولم يُصَلِّ بينهما شيئًا ، ثم ركب رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم [ القصواءَ ] حتى أتى الموقفَ فجعل بطنَ ناقتِه القصواءَ إلى الصخراتِ ، وجعل حبلَ المشاةِ بين يديهِ ، واستقبلَ القِبلةَ . فلم يزل واقفًا حتى غربتِ الشمسُ وذهبت الصُّفرةُ قليلًا حتى غاب القرصُ . [ وقال : وقفتُ ههنا وعرفةُ كلُّها موقفٌ ] . وأردف أسامةَ [ ابنَ زيدٍ ] خلفَه . ودفع رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم ( وفي روايةٍ : أفاض وعليه السكينةُ : ) وقد شنق للقصواءِ الزمامَ ، حتى إنَّ رأسَها ليُصيبُ مورِكَ رَحْلَه ويقول بيدِه اليمنى [ هكذا : وأشار بباطنِ كفِّهِ إلى السماءِ ] أيها الناسُ السكينةُ السكينةُ . كلما أتى حبلًا من الحبالِ أرخى لها قليلًا حتى تصعدَ حتى أتى المزدلفةَ فصلى بها [ فجمع بين ] المغربِ والعشاءِ ، بأذانٍ واحدٍ وإقامتينِ . ولم يُسَبِّحْ بينهما شيئًا . ثم اضطجع رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم حتى طلع الفجرُ وصلى الفجرَ حين تبيَّنَ له الفجرُ ، بأذانٍ وإقامةٍ . ثم ركب القصواءَ حتى أتى المشعرَ الحرامَ [ فرقى عليه ] . فاستقبلَ القِبلةَ ، فدعاه ( وفي لفظٍ : فحمد اللهَ ) وكبَّرَه وهلَّلَه ووحَّدَه . فلم يزل واقفًا حتى أسفرَ جدًّا . ( وقال : وقفتُ ههنا ، والمزدلفةُ كلُّها موقفٌ ) . فدفع [ من جمعٍ ] قبل أن تطلعَ الشمسُ [ وعليه السكينةُ ] . وأردف الفضلَ بنَ عباسٍ – وكان رجلًا حسنَ الشعرِ أبيضَ وسيمًا - ، فلما دفع رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم مرَّتْ به ظُعُنٌ تَجْرِينَ ، فطفق الفضلُ ينظرُ إليهنَّ ، فوضع رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم يدَه على وجهِ الفضلِ ، فحوَّلَ الفضلُ وجهَه إلى الشِّقِّ الآخرِ ، فحوَّلَ رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم يدَه من الشقِّ الآخرِ على وجهِ الفضلِ ، يصرفُ وجهَه من الشقِّ الآخرِ ينظرُ ! حتى أتى بطنَ مُحَسِّرٍ ، فحرك قليلًا [ وقال : عليكم السكينةَ ] . ثم سلك الطريقَ الوسطى التي تخرجُ [ ك ] على الجمرةِ الكبرى [ حتى أتى الجمرةَ التي ] عند الشجرةِ ، فرماها [ ضُحًى ] بسبعِ حصياتٍ ، يُكبِّرُ مع كلِّ حصاةٍ منها ، مثل حصى الخذفِ [ ف ] رمى من بطنِ الوادي [ وهو على راحلتِه [ وهو ] يقول : لِتَأْخُذوا مناسِكَكم ، فإني لا أدري لعلِّي لا أحجُّ بعد حجَّتي هذه ] . [ قال : ورمى بعدَ يومِ النحرِ [ في سائرِ أيامِ التشريقِ ] إذا زالتِ الشمسُ ] . [ ولقيَه سراقةُ وهو يرمي جمرةَ العقبةِ ، فقال : يا رسولَ اللهِ ، ألنا هذه خاصةً ؟ قال : لا ، بل لأبدٍ ] . ثم انصرف إلى المنحرِ فنحر ثلاثًا وستين [ بدنةً ] بيدِه ، ثم أعطى عليًّا فنحر ما غَبَرَ [ يقول : ما بقيَ ] ، وأشرَكَه في هدْيِهِ . ثم أمر من كلِّ بدنةٍ ببضعةٍ فجُعِلَتْ في قِدْرٍ فطُبِخَتْ فأكلا من لحمِها ، وشربا من مَرَقِها . ( وفي روايةٍ قال : نحر رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم عن نسائِه بقرةً ) . ( وفي أخرى قال : فنحرنا البعيرَ ( وفي أخرى : نحر البعيرَ ) عن سبعةٍ ، والبقرةَ عن سبعةٍ ) ( وفي روايةٍ خامسةٍ عنه قال : فاشتركنا في الجزورِ سبعةً ، فقال له رجلٌ : أرأيتَ البقرةَ أيُشْتَرَكُ فيها ؟ فقال ما هيَ إلا من البُدْنِ ) ( وفي روايةٍ : قال جابرٌ : كنا لا نأكلُ من البُدْنِ إلا ثلاثَ مِنًى ، فأرخص لنا رسولُ اللهِ ص ، قال : كُلُوا وتزوَّدُوا ) . قال : فأكلنا وتزوَّدْنا ] ، [ حتى بَلَغْنَا بها المدينةَ ] ( وفي روايةٍ : نحر رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم [ فحلق ] ، وجلس [ بمنى يومَ النحرِ ] للناسِ ، فما سُئِلَ [ يومئذٍ ] عن شيٍء [ قُدِّمَ قبلَ شيٍء ] إلا قال : لا حرجَ ، لا حرجَ . حتى جاءَه رجلٌ فقال : حلقتُ قبلَ أن أنحرَ ؟ قال : لا حرجَ . ثم جاء آخرُ فقال : حلقتُ قبل أن أرمي ؟ قال : لا حرجَ . [ ثم جاءَه آخرُ فقال : طُفْتُ قبل أن أرمي ؟ قال لا حرج ] . [ قال آخرُ : طُفْتُ قبل أن أذبحَ ، قال : اذبح ولا حرجَ ] . [ ثم جاءَه آخرُ فقال : إني نحرتُ قبل أن أرميَ ؟ قال : [ ارْمِ و ] لا حرج ] . ثم قال نبيُّ اللهِ ص : قد نحرتُ ههنا ، ومِنَى كلُّها منحرٌ . [ وكلُّ فِجاجِ مكةَ طريقٌ ومنحرٌ ] . [ فانحروا من رِحالِكُم ] . [ وقال جابرٌ رضيَ اللهُ عنه : خَطَبَنا صلَّى اللهُ عليهِ وسلَّم يومَ النحرِ فقال : أيُّ يومٍ أعظمُ حُرْمةً ؟ فقالوا : يومُنا هذا ، قال : فأيُّ شهرٍ أعظمُ حُرْمَةً ؟ قالوا : شهرُنا هذا ، قال : أيُّ بلدٍ أعظمُ حُرْمَةً ؟ قالوا بلدُنا هذا ، قال : فإنَّ دماءَكم وأموالَكم عليكم حرامٌ كحُرْمَةِ يومكم هذا في بلدِكم هذا في شهرِكم هذا ، هل بلَّغْتُ ؟ قالوا : نعم . قال : اللهمَّ اشهدْ ] . ثم ركب رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم فأفاض إلى البيتِ [ فطافوا ولم يطوفوا بين الصفا والمروةِ ] . فصلى بمكةَ الظهرَ . فأتى بني عبدِ المطلبِ [ وهم ] يسقون على زمزمَ فقال : انزعوا بني عبدِ المطلبِ ، فلولا أن يَغْلِبَكُمُ الناسُ على سِقَايَتِكُمْ لنزعتُ معكم ، فناولوهُ دَلْوًا فشرب منهُ . [ وقال جابرٌ رضيَ اللهُ عنهُ : وإنَّ عائشةَ حاضت فنسكتِ المناسكَ كلَّها غيرَ أنها لم تَطُفْ بالبيتِ ] . [ قال : حتى إذا طهرت طافت بالكعبةِ والصفا والمروةِ ، ثم قال : قد حللتِ من حجِّكِ وعمرتِكِ جميعًا ] ، [ قالت : يا رسولَ اللهِ أتنطلقون بحجٍّ وعمرةٍ وأنطلقُ بحجٍّ ؟ ] [ قال : إنَّ لكِ مثلَ ما لهم ] . [ فقالت : إني أجدُ في نفسي أني لم أَطُفْ بالبيتِ حتى حججتُ ] . [ قال : وكان رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم رجلًا سهلًا إذا هويَتِ الشيءَ تابعَها عليه ] [ قال : فاذهب بها يا عبدَ الرحمنِ فأَعْمِرْها من التنعيمِ [ فاعتمرت بعد الحجِّ ] [ ثم أقبلت ] وذلك ليلةَ الحصبةِ ] . [ وقال جابرٌ : طاف رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم بالبيتِ في حجةِ الوداعِ على راحلتِه يستلمُ الحجرَ بمحجَنِه لأن يراهُ الناسُ ، وليُشْرِفَ ، وليسألوهُ ، فإنَّ الناسَ غشُوهُ ] . [ وقال : ",["رفعت امرأةٌ صبيًّا",1]," لها إلى رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّم فقالت يا رسولَ اللهِ ألهذا حجٌّ ؟ قال : نعم ، ",["ولكِ أجرٌ",2]," ]"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"مدار رواية جابر على سبعة من ثقات أصحابه الأكابر، و الأصل الذي اعتمدنا عليه إنما هو من صحيح مسلم","takhrij":"أخرجه مسلم (1218) مطولا بنحوه","bab":"حج › حجة النبي صلى الله عليه وسلم","dorar":"6XJIqDXb","merged":13,"otherRefs":["صحيح مسلم 1336 (صحيح)","القبس 2/541 (صحيح)","صحيح أبي داود 1736 (صحيح)","صحيح ابن خزيمة 4/ 586 (صحيح)","إتحاف الخيرة المهرة 3/161 (حسن)","تخريج صحيح ابن حبان 3798 (صحيح)","الجواهر والدرر 2/946 (صحيح)","صحيح النسائي 2648 (صحيح)","تخريج المسند لشعيب 2610 (صحيح)","تخريج مشكل الآثار 2561 (صحيح)","تخريج مشكل الآثار 2556 (صحيح)"]},{"id":"س-00723","fp":"f4f6b277a5fe","stateId":439,"easy":"إذا لبّيت ← يلبي معك ما عن يمينك وشمالك من شجر وحجر","cause":"ما من مُؤمِنٍ يُلَبِّي","result":"إلَّا لَبَّى ما عنْ يَمينِه، وعنْ شِمالِه، من شَجَرٍ وحَجَرٍ حتَّى تَنقَطِعَ الأرضُ من ها هُنا وها هُنا","explicit":true,"ref":"المستدرك على الصحيحين 1677","srcLabel":"الترمذي","text":[["ما من مُؤمِنٍ يُلَبِّي",1]," ",["إلَّا لَبَّى ما عنْ يَمينِه، وعنْ شِمالِه، من شَجَرٍ وحَجَرٍ حتَّى تَنقَطِعَ الأرضُ من ها هُنا وها هُنا",2],"، عنْ يَمينِه، وعنْ شِمالِه."],"grade":"صحيح","narrator":"سهل بن سعد","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه الترمذي (828)، وابن ماجه (2921) باختلاف يسير.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"5sbj07No","merged":3,"otherRefs":["الصحيح المسند 468 (صحيح)","فيض القدير 5/ 499 (صحيح)"]},{"id":"س-07226","fp":"b64abd75395f","stateId":439,"easy":"إذا حججت بصبيك ← فلك أجر","cause":"عن صَبيٍّ: هل لهذا من حَجٍّ","result":"ولكِ أجْرٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04576","ref":"تخريج مشكل الآثار 2555","text":["أنَّ امرأةً سألتِ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ ",["عن صَبيٍّ: هل لهذا من حَجٍّ",1],"؟ قال: نَعَمْ، ",["ولكِ أجْرٌ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (1336) باختلاف يسير","bab":"علم › حسن السؤال ونصح العالم","dorar":"z9f3opSz"},{"id":"س-00522","fp":"9598f31895b9","stateId":439,"easy":"إذا حججت ولم تكن حججت ← فهي خير من عشر غزوات","cause":"حجَّةٌ لمن لم يحجَّ","result":"خيرٌ من عشرِ غزواتٍ","explicit":true,"otherNeedIds":[49],"ref":"الترغيب والترهيب 2/269","srcLabel":"ابن حبان","text":[["حجَّةٌ لمن لم يحجَّ",1]," ",["خيرٌ من عشرِ غزواتٍ",2]," وغزوةٌ لمن قد حجَّ خيرٌ من عشرِ حججٍ وغزوةٌ في البحرِ خيرٌ من عشرِ غزواتٍ في البرِّ ومن أجاز البحرَ فكأنَّما أجاز الأوديةَ كلَّها والمائدُ فيه كالمتشحِّطِ في دمِه"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن حبان في ((المجروحين)) (1/461)، والطبراني (13/654) (14581) واللفظ له، والبيهقي (8928)","bab":"آداب عامة › ضرب الأمثال","dorar":"Ws53xUp3"},{"id":"س-02345","fp":"561320fa9643","stateId":439,"easy":"إذا حججت من مكة ماشياً حتى ترجع ← يكتب الله لك بكل خطوة سبعمئة حسنة من حسنات الحرم","cause":"مَن حَجَّ من مَكَّةَ ماشِيًا حتَّى يَرجِعَ إلى مَكَّةَ","result":"كَتَب اللهُ له بكلِّ خُطوةٍ سَبْعَمِئَةِ حَسَنةٍ، كلُّ حَسَنةٍ مِثلُ حَسَناتِ الحَرَمِ قيل: وما حَسَناتُ الحَرَمِ","explicit":true,"similar":["س-02356"],"ref":"المستدرك على الصحيحين 1713","srcLabel":"البيهقي","text":["مَرِض ابنُ عَبَّاسٍ مَرَضًا شَديدًا، فدَعَا وَلَدَه فجَمَعَهُم، فقالَ: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["مَن حَجَّ من مَكَّةَ ماشِيًا حتَّى يَرجِعَ إلى مَكَّةَ ",1],["كَتَب اللهُ له بكلِّ خُطوةٍ سَبْعَمِئَةِ حَسَنةٍ، كلُّ حَسَنةٍ مِثلُ حَسَناتِ الحَرَمِ قيل: وما حَسَناتُ الحَرَمِ",2],"؟ قالَ: بكلِّ حَسَنةٍ مِئَةُ ألفِ حَسَنةٍ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن خزيمة (2791)، والبيهقي (20107) واللفظ لهما","bab":"إحسان › الحسنات والسيئات","dorar":"Ub0UgH1W"},{"id":"س-03247","fp":"7343f00c41e9","stateId":439,"easy":"إذا قصدت البيت الحرام ← لا تضع ناقتك خفاً ولا ترفعه إلا كُتبت لك حسنة ومُحيت سيئة","cause":"إنَّ مَن أمَّ البَيتَ","result":"لا تضعُ ناقتُهُ خُفًّا ولا ترفعُهُ إلَّا كُتِبَ لَه بهِ حسنةٌ ومُحِيَ عنهُ خَطيئةٌ","explicit":true,"otherNeedIds":[11],"ref":"الزواجر عن اقتراف الكبائر 1/205","srcLabel":"الزواجر عن اقتراف الكبائر","text":[["إنَّ مَن أمَّ البَيتَ",1]," ",["لا تضعُ ناقتُهُ خُفًّا ولا ترفعُهُ إلَّا كُتِبَ لَه بهِ حسنةٌ ومُحِيَ عنهُ خَطيئةٌ",2]," ، وإنَّ ركعتَي الطَّوافِ كَعِتقِ رقبةٍ مِن بَني إسماعيلَ والسَّعيَ كَعِتقِ سبعينَ رقبةً ، والوقوفَ تُغفَرُ بهِ الذُّنوبُ ، وإن كانت بعدَدِ الرَّملِ أو كقَطرِ المطرِ ، أو كزَبَدِ البحرِ ، وبكلِّ حصاةٍ مِن الجِمارِ تكفيرُ كبيرةٍ مِن الموبِقاتِ والنَّحرَ مَذخورٌ عندَ اللهِ ، وبكلِّ شعرةٍ حُلِقَت حسنةٌ ومَحوُ خَطيئةٍ ، وبالطَّوافِ بعدَ ذلكَ يضعُ مَلكٌ يدَيهِ بينَ كتفَيهِ فَيقولُ : اعمَل فيما استُقبِلَ ، فقَد غُفِرَ لكَ ما مضَى"],"grade":"صحيح","muhaddith":"صحيح أو حسن","bab":"استغفار › أسباب المغفرة","dorar":"JXahJfeA"},{"id":"س-03358","fp":"c09ca895d17d","stateId":439,"easy":"إذا طفت بالبيت ← لا ترفع قدماً ولا تضعها إلا كتب الله لك حسنة وحط عنك خطيئة","cause":"من طافَ بالبيتِ","result":"لم يرفعْ قدَمًا ؛ ولم يضعْ قدمًا ؛ إلا كَتبَ اللهُ له حسنةً ، وحَطَّ عنه خطِيئةً ، وكَتبَ له درجةً","explicit":true,"otherNeedIds":[47],"ref":"صحيح الترغيب 1139","srcLabel":"الترمذي","text":[["من طافَ بالبيتِ ؛ ",1],["لم يرفعْ قدَمًا ؛ ولم يضعْ قدمًا ؛ إلا كَتبَ اللهُ له حسنةً ، وحَطَّ عنه خطِيئةً ، وكَتبَ له درجةً",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (959)، وأحمد (4462) مطولاً باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"im77BlPo"},{"id":"س-03368","fp":"14cc716307b1","stateId":439,"easy":"إذا حججت ← لا ترفع راحلتك رجلاً إلا كُتبت لك حسنة أو مُحيت سيئة أو رُفعت درجة","cause":"ما ترفعُ إبلُ الحاجِّ رِجْلًا ولا تضَعُ يدًا","result":"إلَّا كتب اللهُ بها حسنةً أو محا عنه سيِّئةً أو رفع بها درجةً","explicit":true,"otherNeedIds":[11],"ref":"الترغيب والترهيب 2/168","srcLabel":"ابن حبان","text":[["ما ترفعُ إبلُ الحاجِّ رِجْلًا ولا تضَعُ يدًا",1]," ",["إلَّا كتب اللهُ بها حسنةً أو محا عنه سيِّئةً أو رفع بها درجةً",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن حبان كما في ((الترغيب والترهيب)) للمنذري (2/107)، والبيهقي في ((شعب الإيمان)) (4116)","bab":"استغفار › أسباب المغفرة","dorar":"Xp2iNFZT"},{"id":"س-04434","fp":"39a65e339b0a","stateId":439,"easy":"إذا خرجت حاجاً فمت ← يكتب الله لك أجر الحاج إلى يوم القيامة","cause":"من خرج حاجًّا فمات","result":"كتب اللهُ له أجرَ الحاجِّ إلى يومِ القيامةِ","explicit":true,"otherNeedIds":[49],"ref":"صحيح الترغيب 1267","srcLabel":"الطبراني","text":[["من خرج حاجًّا فمات ؛ ",1],["كتب اللهُ له أجرَ الحاجِّ إلى يومِ القيامةِ ، ",2],"ومن خرج معتمرًا فمات ، كتب اللهُ له أجرَ المعتمِرِ إلى يومِ القيامةِ ، ومن خرج غازيًا فمات ، كتب اللهُ له أجرَ الغازى إلى يومِ القيامةِ ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو يعلى (6357)، والطبراني في ((المعجم الأوسط)) (5321) باختلاف يسير، والبيهقي في ((شعب الإيمان)) (4100) مختصراً.","bab":"جهاد › فضل الجهاد","dorar":"D5ffhXg9"},{"id":"س-04435","fp":"af3ac1392d69","stateId":439,"easy":"إذا خرجت معتمراً فمت ← يكتب الله لك أجر المعتمر إلى يوم القيامة","cause":"ومن خرج معتمرًا فمات","result":"كتب اللهُ له أجرَ المعتمِرِ إلى يومِ القيامةِ","explicit":true,"ref":"صحيح الترغيب 1267","srcLabel":"الطبراني","text":["من خرج حاجًّا فمات ؛ كتب اللهُ له أجرَ الحاجِّ إلى يومِ القيامةِ ، ",["ومن خرج معتمرًا فمات ، ",1],["كتب اللهُ له أجرَ المعتمِرِ إلى يومِ القيامةِ ، ",2],"ومن خرج غازيًا فمات ، كتب اللهُ له أجرَ الغازى إلى يومِ القيامةِ ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو يعلى (6357)، والطبراني في ((المعجم الأوسط)) (5321) باختلاف يسير، والبيهقي في ((شعب الإيمان)) (4100) مختصراً.","bab":"جهاد › فضل الجهاد","dorar":"D5ffhXg9"},{"id":"س-04492","fp":"c579b47d6f83","stateId":439,"easy":"إذا حججت ← فهي خير من مئة غزوة","cause":"حَجَّةٌ","result":"خَيرٌ مِن مِائةِ غَزوةٍ","explicit":true,"similar":["س-02323"],"ref":"مشارع الأشواق 218","srcLabel":"سعيد","text":["قال: كان يُقالُ: ",["حَجَّةٌ ",1],["خَيرٌ مِن مِائةِ غَزوةٍ",2],"، وغَزوةٌ خَيرٌ مِن مِائةِ حَجَّةٍ."],"grade":"صحيح","narrator":"أبو العالية","muhaddith":"إسناده صحيح","takhrij":"أخرجه سعيد بن منصور في ((سننه - الفرائض إلى الجهاد)) (2345) بلفظه.","bab":"جهاد › فضل الجهاد","dorar":"xwS9J3L3"},{"id":"س-04572","fp":"71ac82d98e55","stateId":439,"easy":"إذا حلقت رأسك في الحج ← لك بكل شعرة حسنة وتُمحى عنك خطيئة","cause":"وأما حلاقُكَ رأسَك","result":"فإنَّ لك بكلِّ شعرةٍ حلقتَها حسنةٌ وتُمحى عنك بها خطيئةٌ","explicit":true,"otherNeedIds":[11],"ref":"المتجر الرابح 157","srcLabel":"ابن حبان","text":[["وأما حلاقُكَ رأسَك: ",1],["فإنَّ لك بكلِّ شعرةٍ حلقتَها حسنةٌ وتُمحى عنك بها خطيئةٌ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (1887) واللفظ له، والطبراني (12/ 425) (13566)، وعبد الرزاق (8830)، والبهقي في ((دلائل النبوة))  (6/ 293) بنحوه.","bab":"حج › الحلق والتقصير","dorar":"yu4qGc5x"},{"id":"س-02323","fp":"058d2022a499","stateId":439,"easy":"إذا حججت ← فهي خير من أربعين غزوة","cause":"حَجَّةٌ","result":"خَيرٌ مِن أربَعينَ غَزوةً","explicit":true,"repOf":"س-04492","ref":"مشارع الأشواق 215","text":[["حَجَّةٌ ",1],["خَيرٌ مِن أربَعينَ غَزوةً",2],"، وغَزوةٌ خَيرٌ مِن أربَعينَ حَجَّةً، يَقولُ: إذا حَجَّ الرَّجُلُ حَجَّةَ الإسلامِ، فغَزوُه خَيرٌ له مِن أربَعينَ حَجَّةً، وحَجَّةٌ الإسلامِ خَيرٌ مِن أربَعينَ غَزوةً."],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"رجاله ثقات","takhrij":"أخرجه البزار كما في ((كشف الأستار)) للهيثمي (1651) بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"u5XLurZj"},{"id":"س-03502","fp":"3f3ebd409f92","stateId":439,"easy":"إذا طفت بالبيت أسبوعاً تحصيه ← يُكتب لك بكل خطوة حسنة ويُكفّر سيئة وتُرفع درجة","cause":"مَن طافَ بهذا البَيتِ أُسبوعًا يُحْصِيه","result":"كُتِب له بكُلِّ خُطوةٍ حسَنةٌ، وكُفِّر عنه سَيِّئةٌ، ورُفِعَتْ له دَرَجةٌ، وكان عِدْلَ عِتْقِ رَقَبةٍ","explicit":true,"otherNeedIds":[11,47],"ref":"تخريج المسند لشعيب 5701","srcLabel":"الترمذي","text":["قلْتُ لابنِ عُمرَ: أَراكَ تُزاحِمُ على هَذَينِ الرُّكنَينِ؟ قال: إنْ أَفعَلْ؛ فقد سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: إنَّ مَسْحَهُما يَحُطَّانِ الخَطايَا.\nقال: وسمِعتُه يقولُ: ",["مَن طافَ بهذا البَيتِ أُسبوعًا يُحْصِيه، ",1],["كُتِب له بكُلِّ خُطوةٍ حسَنةٌ، وكُفِّر عنه سَيِّئةٌ، ورُفِعَتْ له دَرَجةٌ، وكان عِدْلَ عِتْقِ رَقَبةٍ",2],"."],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن","takhrij":"أخرجه الترمذي (959)، وأحمد (5701) واللفظ له","bab":"استغفار › مكفرات الذنوب","dorar":"se2IWkst"},{"id":"س-04491","fp":"c5ced610bde0","stateId":439,"easy":"إذا حججت قبل أن تغزو ← فهي خير من عشر غزوات","cause":"حَجَّةٌ قَبلَ غَزوةٍ","result":"خَيرٌ مِن عَشرِ غَزَواتٍ","explicit":true,"ref":"مشارع الأشواق 216","srcLabel":"ابن المبارك","text":["عَن عَبدِ الرَّحمَنِ بنِ غَنمٍ الأشعَريِّ أنَّه قال: ",["حَجَّةٌ قَبلَ غَزوةٍ ",1],["خَيرٌ مِن عَشرِ غَزَواتٍ",2],"، وغَزوةٌ بَعدَ حَجَّةٍ خَيرٌ مِن ثَمانينَ حَجَّةً"],"grade":"حسن","muhaddith":"رجاله ثقات","takhrij":"أخرجه ابن المبارك في ((الجهاد)) (170) بلفظه.","bab":"جهاد › فضل الجهاد","dorar":"a8JBWeHe"},{"id":"س-06831","fp":"ad0ebe9eb253","stateId":439,"easy":"إذا خرجت من بيتك تؤم البيت الحرام ← لك بكل وطأة لراحلتك حسنة وتُمحى سيئة","cause":"أما خروجُك من بيتِك تؤُمُّ البيتَ الحرامَ","result":"فإنَّ لك بكلِّ وطأَةٍ تطؤها راحلتُك يكتبُ اللهُ لك بها حسنةً ، ويمحو عنك سيئةً","explicit":true,"apply":{"k":"time","t":"عند الخروج من البيت"},"otherNeedIds":[11],"ref":"صحيح الجامع 1360","srcLabel":"الطبراني","text":[["أما خروجُك من بيتِك تؤُمُّ البيتَ الحرامَ ؛ ",1],["فإنَّ لك بكلِّ وطأَةٍ تطؤها راحلتُك يكتبُ اللهُ لك بها حسنةً ، ويمحو عنك سيئةً ",2],". وأما وقوفُك بعرفةَ ؛ فإنَّ اللهَ عزَّ وجلَّ ينزلُ إلى السماءِ الدنيا فيباهي بهم الملائكةَ ، فيقولُ : هؤلاءِ عبادي جاؤوني شُعثًا غُبرًا من كلِّ فجٍّ عميقٍ ، يرجون رحمتي ويخافون عذابي ولم يروني ، فكيف لو رأوني ؟ فلو كان عليك مثلُ رملِ عالجٍ أو مثلُ أيامِ الدنيا أو مثلُ قطرِ السماءِ ذنوبًا غسلها اللهُ عنك . وأما رميُك الجمارَ فإنه مَدخورٌ لك . و أما حلقُك رأسَك فإنَّ لك بكلِّ شعرةٍ تسقطُ حسنةً ، فإذا طُفتَ بالبيت خرجتَ من ذنوبِك كيومِ ولدتْك أمُّك"],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((الكبير)) (12/ 426) واللفظ له، وعبد الرزاق (5/ 14).","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"Beoz5LJl"},{"id":"س-07177","fp":"943a2e4dd07a","stateId":439,"easy":"إذا قرنت الحج والعمرة ← ترجع بأجرين","cause":"لبَّى بالعُمرةِ والحجِّ","result":"يرجِعُ بأجرَينِ ، وتَرجِعونَ أنتُم بأجرٍ واحدٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"نخب الافكار 9/205","srcLabel":"الطحاوي","text":["حجَجْنا وفينا رجلٌ أعجميٌّ ، ف",["لبَّى بالعُمرةِ والحجِّ",1]," ، فعِبنا ذلِكَ عليهِ فسألْنا ابنَ عمرَ فقُلنا: إنَّ رجلًا منَّا لبَّى بالعمرةِ والحجِّ فما كفَّارتُهُ ؟ قالَ: ",["يرجِعُ بأجرَينِ ، وتَرجِعونَ أنتُم بأجرٍ واحدٍ",2]],"grade":"صحيح","narrator":"كثير بن جمهان","muhaddith":"طريقه صحيح","takhrij":"أخرجه الطحاوي في ((معاني الآثار)) (3696)، وابن أبي شيبة (14507) واللفظ لهما، وابن حزم في ((المحلى)) (7/ 170) بنحوه.","bab":"علم › حسن السؤال ونصح العالم","dorar":"GIyF1dPT"},{"id":"س-02356","fp":"8413fad9b9da","stateId":439,"easy":"إذا حججت ماشياً ← لك بكل خطوة سبعمائة حسنة من حسنات الحرم","cause":"ولِلماشي","result":"سَبْعُمِئةِ حَسَنةٍ مِن حَسَناتِ الحَرَمِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-02345","ref":"الأحاديث المختارة 10 / 52","text":["«قالَ ابنُ عبَّاسٍ لبَنيه: يا بَنِيَّ اخْرُجوا مِن مَكَّةَ مُشاةً، حتَّى تَرجِعوا إلى مَكَّةَ مُشاةً؛ فإنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: إنَّ للحاجِّ الرَّاكِبِ بِكلِّ خُطْوةٍ تَخْطوها راحِلتُه سَبْعينَ حَسَنةً، ",["ولِلماشي",1]," ",["سَبْعُمِئةِ حَسَنةٍ مِن حَسَناتِ الحَرَمِ",2],"، قيلَ: يا رَسولَ اللهِ، وما حَسَناتُ الحَرَمِ؟ قالَ: الحَسَنةُ بمِئةِ ألْفِ حَسَنةٍ»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إحسان › الحسنات والسيئات","dorar":"FBf78Vim","merged":2,"otherRefs":["الفروع لابن مفلح 2/ 457 (صحيح)"]},{"id":"س-02870","fp":"7f6bda701551","stateId":439,"easy":"إذا رميت الجمار ← تجد ذلك عند ربك أحوج ما تكون إليه","cause":"رميِ الجمارِ","result":"تجدُ ذلك عند ربك أحوجَ ما تكونُ إليهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"المتجر الرابح 157","srcLabel":"الطبراني","text":["أن رجلًا سأل النبيَّ صلَّى اللهُ عليهِ وسلَّمَ عن ",["رميِ الجمارِ",1]," ما لنا فيه؟ فسمعتُه يقولُ: ",["تجدُ ذلك عند ربك أحوجَ ما تكونُ إليهِ",2],"."],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (4147) واللفظ له، وأبو نعيم في ((حلية الأولياء)) (5/28)","bab":"إيمان › الوعد","dorar":"lxyeGXyD"},{"id":"س-02632","fp":"3118e9d888ec","stateId":439,"easy":"إذا أنفقت في عمرتك ← فأجرك على قدر نفقتك ونصبك","cause":"على قَدرِ نَفَقَتِكِ","result":"أجرُكِ في عُمْرَتِكِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 1755","srcLabel":"متفق عليه","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قالَ لها في عُمْرَتِها: إنَّما ",["أجرُكِ في عُمْرَتِكِ",2]," ",["على قَدرِ نَفَقَتِكِ",1],"."],"grade":"صحيح","narrator":"عائشة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (316)، ومسلم (1211) بنحوه.","bab":"إيمان › الاحتساب والنية","dorar":"v3iQTPhz"},{"id":"س-04648","fp":"05c6290fd59f","stateId":440,"easy":"إذا رابطت يوماً وليلة ← فهو أفضل من صيام شهر وقيامه","cause":"رِباطُ يومٍ وليلةٍ","result":"أفْضَلُ مِن صِيامِ شَهرٍ وقيامِه","explicit":true,"star":true,"similar":["س-04640","س-04638"],"ref":"تخريج المسند لشعيب 23735","srcLabel":"مسلم","text":[["رِباطُ يومٍ وليلةٍ ",1],["أفْضَلُ مِن صِيامِ شَهرٍ وقيامِه",2],"، صائِمًا لا يُفطِرُ، وقائِمًا لا يَفْتُرُ، وإنْ ماتَ مُرابِطًا جَرى عليه كصالِحِ عَمَلِه حتى يُبعَثَ، ووُقِيَ عَذابَ القَبرِ."],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1913)، والترمذي (1665)، وأحمد (23735) واللفظ له","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"jKL4dp03","merged":4,"otherRefs":["صحيح الجامع 3483 (صحيح)","الكافي الشاف 66 (صحيح)","صحيح الجامع 3480 (صحيح)"]},{"id":"س-04640","fp":"8a1be638af6b","stateId":440,"easy":"إذا رابطت يوماً وليلة ← فلك أجر صيام شهر وقيامه ويجري عليك عملك إن مت مرابطاً","cause":"مَن رابَطَ يومًا و لَيلَةً في سَبيلِ اللهِ","result":"كان له كَأجْرِ صِيامِ شهرٍ و قِيامِه ، و مَن ماتَ مُرابِطًا جَرَى له مِثلُ ذلكَ الأَجْرِ ، و أُجْرِيَ عليه الرِّزقُ ، و أمن الفِتَانَ","explicit":true,"repOf":"س-04648","otherNeedIds":[49,50,63],"ref":"صحيح الجامع 6259","text":[["مَن رابَطَ يومًا و لَيلَةً في سَبيلِ اللهِ ، ",1],["كان له كَأجْرِ صِيامِ شهرٍ و قِيامِه ، و مَن ماتَ مُرابِطًا جَرَى له مِثلُ ذلكَ الأَجْرِ ، و أُجْرِيَ عليه الرِّزقُ ، و أمن الفِتَانَ",2]],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (4361) واللفظ له، وأحمد (23728) باختلاف يسير، ومسلم (1913) بنحوه.","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"3Tas6F29","merged":2,"otherRefs":["صحيح النسائي 3168 (صحيح)"]},{"id":"س-04438","fp":"5f73afa2af29","stateId":440,"easy":"إذا رابطت يوماً في سبيل الله ← فهو خير من الدنيا وما عليها","cause":"رِباطُ يَومٍ في سَبيلِ اللهِ","result":"خَيرٌ مِنَ الدُّنيا وما عليها","explicit":true,"similar":["س-02190"],"ref":"صحيح البخاري 2892","srcLabel":"مسلم","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: ",["رِباطُ يَومٍ في سَبيلِ اللهِ ",1],["خَيرٌ مِنَ الدُّنيا وما عليها",2],"، ومَوضِعُ سَوطِ أحَدِكُم مِنَ الجَنَّةِ خَيرٌ مِنَ الدُّنيا وما عليها، والرَّوحةُ يَروحُها العَبدُ في سَبيلِ اللهِ أوِ الغَدوةُ خَيرٌ مِنَ الدُّنيا وما عليها."],"grade":"صحيح","narrator":"سهل بن سعد الساعدي","muhaddith":"[صحيح]","takhrij":"أخرجه الترمذي (1664)، وأحمد (22872) باختلاف يسير، ومسلم (1881) مختصرًا.","bab":"جهاد › فضل الجهاد","dorar":"eAT0whZN"},{"id":"س-04638","fp":"3a51b0a7aedf","stateId":440,"easy":"إذا رابطت يوماً وليلة في سبيل الله ← فلك أجر صيام شهر وقيامه","cause":"مَن رابطَ يومًا وليلةً في سبيلِ اللَّهِ","result":"كانَ لَهُ كأجرِ صيامِ شَهْرٍ وقيامِهِ","explicit":true,"repOf":"س-04648","otherNeedIds":[49],"ref":"صحيح النسائي 3167","text":[["مَن رابطَ يومًا وليلةً في سبيلِ اللَّهِ ",1],["كانَ لَهُ كأجرِ صيامِ شَهْرٍ وقيامِهِ ، ",2],"ومَن ماتَ مرابطًا أُجْريَ لَهُ مثلُ ذلِكَ منَ الأجرِ ، وأُجْريَ علَيهِ الرِّزقُ ، وأمِنَ منَ الفتَّانِ"],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (4361) واللفظ له، وأحمد (23728) باختلاف يسير، ومسلم (1913) بنحوه.","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"Q1d5EY3C"},{"id":"س-02190","fp":"942e9a069536","stateId":440,"easy":"إذا رابطت يوماً في سبيل الله ← فهو خير من ألف يوم فيما سواه","cause":"رِباطُ يومٍ في سبيلِ اللَّهِ تعالى","result":"خيرٌ مِن ألفِ يومٍ فيما سواهُ منَ المَنازلِ","explicit":true,"repOf":"س-04438","ref":"تخريج المسند لشاكر 1/232","text":["أيُّها النَّاسُ ، إنِّي كتمتُكُم حديثًا سَمِعْتُهُ من رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ، كراهيةَ تفرُّقِكُم عنِّي ، ثمَّ بدا لي أن أحدِّثَكُموهُ ليَختارَ امرؤٌ لنفسِهِ ما بدا لَهُ ، سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ : ",["رِباطُ يومٍ في سبيلِ اللَّهِ تعالى ",1],["خيرٌ مِن ألفِ يومٍ فيما سواهُ منَ المَنازلِ",2]],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (470)، والترمذي (1667)، والدارمي (2468) جميعا بلفظه، والنسائي (3169) مختصرا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"xJjkkgL8","merged":3,"otherRefs":["صحيح ابن حبان 4609 (صحيح)","المستدرك على الصحيحين 2672 (صحيح)"]},{"id":"س-02889","fp":"631613868f41","stateId":440,"easy":"إذا حرست ليلة في سبيل الله ← فهي أفضل من ألف ليلة يُقام ليلها","cause":"حَرَسُ ليلةٍ في سبيلِ اللهِ","result":"أَفضلُ مِن ألفِ ليلةٍ يُقامُ لَيلُها","explicit":true,"ref":"المستدرك على الصحيحين 2461","srcLabel":"ابن ماجه","text":["قالَ عُثمانُ بنُ عَفَّانَ رَضيَ اللهُ عنه، وهو يَخطُبُ على المِنبرِ: إنِّي أُحدِّثُكم حَديثًا لمْ يَمنعني أنْ أُحدِّثَكُم به إلَّا الضِّنُّ بِكُم، سَمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["حَرَسُ ليلةٍ في سبيلِ اللهِ ",1],["أَفضلُ مِن ألفِ ليلةٍ يُقامُ لَيلُها",2],"، ويُصامُ نَهارُها."],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (463)، والطبراني (1/ 91)، (145) كلاهما بلفظه، وابن ماجه (2766) باختلاف يسير.","bab":"إيمان › الوعد","dorar":"brrYU3Ua","merged":2,"otherRefs":["الأحاديث المختارة 361 (صحيح)"]},{"id":"س-02241","fp":"f1b488061b89","stateId":440,"easy":"إذا رابطت يوماً في سبيل الله ← فهو أفضل من ألف يوم فيما سواه","cause":"رباطُ يومٍ في سبيلِ اللهِ","result":"أفضل ُمن ألفِ يومٍ فيما سواه فليرابِطْ امرؤٌ كيفَ شاءَ هل بلَّغْتُ","explicit":true,"similar":["س-04487"],"ref":"تخريج المسند لشاكر 1/218","srcLabel":"تخريج المسند لشاكر","text":["سمعتُ عثمانَ بمِنًى يقولُ: يا أيُّهَا الناسُ إنِّي أحدِّثُكُم حديثًا سمعتُهُ من رسولِ الله صلَّى اللهُ عليه وسلَّم يقول: ",["رباطُ يومٍ في سبيلِ اللهِ ",1],["أفضل ُمن ألفِ يومٍ فيما سواه فليرابِطْ امرؤٌ كيفَ شاءَ هل بلَّغْتُ",2]," قالوا: نعم قال: اللهمَّ اشهدْ"],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"إسناده صحيح","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"KXDauE7p"},{"id":"س-02908","fp":"4eeb536417e1","stateId":440,"easy":"إذا رابطت شهراً ← فهو خير من صيام دهر","cause":"رباطُ شهرٍ","result":"خيرٌ من صيامِ دهرٍ","explicit":true,"ref":"صحيح الجامع 3479","srcLabel":"الطبراني","text":[["رباطُ شهرٍ ",1],["خيرٌ من صيامِ دهرٍ ",2],"، ومَنْ ماتَ مرابِطًا فِي سبيلِ اللهِ أمِنَ مِنَ الفزَعِ الأَكْبَرِ ، وغُدِيَ عليْهِ برزقِهِ ، ورِيحَ مِنَ الجنةِ ، ويَجْرِي عليه أجرُ المرابِطِ ، حتى يبعَثَهُ اللهُ"],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه الطبراني كما في ((مجمع الزوائد)) للهيثمي (5/293)","bab":"إيمان › الوعد","dorar":"zjkF0Rdo"},{"id":"س-04487","fp":"7625b165f0e3","stateId":440,"easy":"إذا رابطت يوماً في سبيل الله ← فهو أفضل من ألف يوم مما سواه","cause":"إنَّ رِباطَ يومٍ في سبيلِ اللهِ","result":"أفضَلُ مِن ألفِ يومٍ ممَّا سِواهُ","explicit":true,"repOf":"س-02241","ref":"تخريج المسند لشعيب 477","text":["أنَّ عثمانَ قال: أيُّها الناسُ، هَجِّروا فإنِّي مُهَجِّرٌ. فهجَّرَ الناسُ، ثمَّ قال: أيُّها الناسُ، إنِّي مُحدِّثُكم بحديثٍ ما تكلَّمتُ به منذُ سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ إلى يومي هذا، قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["إنَّ رِباطَ يومٍ في سبيلِ اللهِ ",1],["أفضَلُ مِن ألفِ يومٍ ممَّا سِواهُ",2],"، فلْيُرابِطِ امرؤٌ حيثُ شاءَ، هل بلَّغتُكم؟ قالوا: نَعَم. قال: اللهمَّ اشهَدْ."],"grade":"حسن","narrator":"عثمان بن عفان","muhaddith":"حسن","takhrij":"أخرجه عبدالله بن أحمد في ((زوائد المسند)) (477) واللفظ له، وابن أبي شيبة (19803)، وعبد بن حميد (51)","bab":"جهاد › فضل الجهاد","dorar":"ne1FOWYa"},{"id":"س-04493","fp":"f2cac1ca5a84","stateId":440,"easy":"إذا رابطت ليلة تحرس المسلمين ← فلك أجر من خلفك ممن صام وصلى","cause":"مَن رابَطَ لَيلةً حارِسًا مِن وراءِ المُسلمينَ","result":"كان له أجرُ مَن خَلفه مِمَّن صامَ وصَلَّى","explicit":true,"ref":"فتح البيان 2/ 411","srcLabel":"الطبراني","text":["سُئِلَ رَسولُ اللهِ صَلَّى اللهُ عليه وآله وسَلَّمَ عَن أجرِ الرَّابطِ، فقال: ",["مَن رابَطَ لَيلةً حارِسًا مِن وراءِ المُسلمينَ ",1],["كان له أجرُ مَن خَلفه مِمَّن صامَ وصَلَّى",2],"."],"grade":"حسن","narrator":"أنس","muhaddith":"إسناده جيد","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (8059)، والدارقطني في ((الأفراد)) (7)، وابن الجوزي في ((العلل المتناهية)) (954) بلفظه.","bab":"جهاد › فضل الجهاد","dorar":"0DWbJfff"},{"id":"س-07745","fp":"9b5c6e02ef69","stateId":441,"easy":"إذا اتخذت الخيل في سبيل الله وأعددتها ← لا تغيّب شيئاً في بطونها إلا كتب الله لك أجراً","cause":"فالرَّجُلُ يَتَّخِذُها في سَبيلِ اللهِ ويُعِدُّها له","result":"فلا تُغَيِّبُ شيئًا في بُطونِها إلَّا كَتَبَ اللهُ له أجرًا، ولو رَعاها في مَرجٍ، ما أكَلَت مِن شيءٍ إلَّا كَتَبَ اللهُ له بها أجرًا، ولو سَقاها مِن نَهرٍ، كانَ له بكُلِّ قَطرةٍ تُغَيِّبُها في بُطونِها أجرٌ، حتَّى ذَكَرَ الأجرَ في أبوالِها وأرواثِها، ولَوِ استَنَّت شَرَفًا أو شَرَفَينِ، كُتِبَ له بكُلِّ خُطوةٍ تَخطوها أجرٌ","explicit":true,"star":true,"similar":["س-06088","س-06146","س-07444"],"ref":"صحيح مسلم 987","srcLabel":"مسلم","text":["ما مِن صاحِبِ كَنزٍ لا يُؤَدِّي زَكاتَه إلَّا أُحميَ عليه في نارِ جَهَنَّمَ، فيُجعَلُ صَفائِحَ، فيُكوى بها جَنباه وجَبينُه حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ، وما مِن صاحِبِ إبِلٍ لا يُؤَدِّي زَكاتَها إلَّا بُطِحَ لها بقاعٍ قَرقَرٍ كَأوفَرِ ما كانَت تَستَنُّ عليه، كُلَّما مَضى عليه أُخراها رُدَّت عليه أولاها، حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ، وما مِن صاحِبِ غَنَمٍ لا يُؤَدِّي زَكاتَها إلَّا بُطِحَ لها بقاعٍ قَرقَرٍ كَأوفَرِ ما كانَت فتَطَؤُه بأظلافِها وتَنطَحُه بقُرونِها، ليس فيها عَقصاءُ ولا جَلحاءُ، كُلَّما مَضى عليه أُخراها رُدَّت عليه أولاها، حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ ممَّا تَعُدُّونَ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ. قال سُهَيلٌ: فلا أدري أذَكَرَ البَقَرَ أم لا، قالوا: فالخَيلُ؟ يا رَسولَ اللهِ، قال: الخَيلُ في نَواصيها -أو قال، الخَيلُ مَعقودٌ في نَواصيها. قال سُهَيلٌ: أنا أشُكُّ- الخَيرُ إلى يَومِ القيامةِ، الخَيلُ ثَلاثةٌ: فهي لرَجُلٍ أجرٌ، ولرَجُلٍ سِترٌ، ولرَجُلٍ وِزرٌ؛ فأمَّا التي هي له أجرٌ: ",["فالرَّجُلُ يَتَّخِذُها في سَبيلِ اللهِ ويُعِدُّها له",1],"، ",["فلا تُغَيِّبُ شيئًا في بُطونِها إلَّا كَتَبَ اللهُ له أجرًا، ولو رَعاها في مَرجٍ، ما أكَلَت مِن شيءٍ إلَّا كَتَبَ اللهُ له بها أجرًا، ولو سَقاها مِن نَهرٍ، كانَ له بكُلِّ قَطرةٍ تُغَيِّبُها في بُطونِها أجرٌ، حتَّى ذَكَرَ الأجرَ في أبوالِها وأرواثِها، ولَوِ استَنَّت شَرَفًا أو شَرَفَينِ، كُتِبَ له بكُلِّ خُطوةٍ تَخطوها أجرٌ",2],"، وأمَّا الذي هي له سِترٌ: فالرَّجُلُ يَتَّخِذُها تَكَرُّمًا وتَجَمُّلًا، ولا يَنسى حَقَّ ظُهورِها وبُطونِها في عُسرِها ويُسرِها، وأمَّا الذي عليه وِزرٌ فالذي يَتَّخِذُها أشَرًا وبَطَرًا وبَذَخًا ورياءَ النَّاسِ، فذاك الذي هي عليه وِزرٌ، قالوا: فالحُمُرُ يا رَسولَ اللهِ؟ قال: ما أنزَلَ اللهُ عليَّ فيها شيئًا إلَّا هذه الآيةَ الجامِعةَ الفاذَّةَ: {فمَنْ يَعمَلْ مِثقالَ ذَرَّةٍ خَيرًا يَرَهُ * ومَن يَعمَلْ مِثقالَ ذَرَّةٍ شَرًّا يَرَهُ} [الزلزلة: 7-8]. [وفي روايةٍ]: بَدَلَ عَقصاءُ: عَضباءُ، وقال: فيُكوى بها جَنبُه وظَهرُه، ولَم يَذكُرْ: جَبينُه. [وفي روايةٍ]: إذا لَم يُؤَدِّ المَرءُ حَقَّ اللهِ، أوِ الصَّدَقةَ في إبِلِه، وساقَ الحَديثَ بنَحوِ حَديثِ سُهَيلٍ عن أبيه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (987) مطولاً","bab":"قرآن › أسباب النزول","dorar":"1IlMX4Z5","merged":3,"otherRefs":["صحيح البخاري 2371 (صحيح)","تخريج المسند لشعيب 7563 (صحيح)"]},{"id":"س-04369","fp":"4c25550805a7","stateId":441,"easy":"إذا احتبست فرساً في سبيل الله إيماناً وتصديقاً ← يكون شبعه وريه وروثه وبوله حسنات في ميزانك","cause":"مَنِ احتَبَس فرَسًا في سبيلِ اللهِ ، إيمانًا باللهِ ، وتصديقًا بوعدِه","result":"كان شِبَعُهُ ، ورِيُّهُ ، و روَثُه ، وبولُه ، حسناتٍ في ميزانِه يومَ القيامةِ","explicit":true,"star":true,"similar":["س-05038"],"otherNeedIds":[65],"ref":"صحيح الجامع 5967","srcLabel":"البخاري","text":[["مَنِ احتَبَس فرَسًا في سبيلِ اللهِ ، إيمانًا باللهِ ، وتصديقًا بوعدِه ، ",1],["كان شِبَعُهُ ، ورِيُّهُ ، و روَثُه ، وبولُه ، حسناتٍ في ميزانِه يومَ القيامةِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (2853) باختلاف يسير","bab":"جهاد › الترغيب في الجهاد","dorar":"mdao92uP"},{"id":"س-06088","fp":"dc2ee1e4b4a9","stateId":441,"easy":"إذا احتبست الخيل في سبيل الله ← يُكتب لك بكل ما غيّبت في بطونها أجر","cause":"فالَّذي يحتبِسُها في سبيلِ اللَّهِ، فيتَّخذُها لَهُ","result":"ولا تُغيِّبُ في بطونِها شيئًا إلَّا كتبَ لَهُ بِكلِّ شيءٍ غيَّبَت في بطونِها أجرٌ","explicit":true,"repOf":"س-07745","ref":"صحيح النسائي 3564","text":["الخيلُ معقودٌ في نواصيها الخيرُ إلى يومِ القيامةِ الخيلُ ثلاثةٌ فَهيَ لرجلٍ أجرٌ، وَهيَ لرجلٍ سترٌ، وَهيَ على رجلٍ وزرٌ، فأمَّا الذى هيَ لَهُ أجرٌ ",["فالَّذي يحتبِسُها في سبيلِ اللَّهِ، فيتَّخذُها لَهُ",1]," ",["ولا تُغيِّبُ في بطونِها شيئًا إلَّا كتبَ لَهُ بِكلِّ شيءٍ غيَّبَت في بطونِها أجرٌ",2],"، ولو عرضَ لَها مرجٌ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (987) بنحوه، وأخرجه البخاري (2860 ) من قوله : الخيل ثلاثة،","bab":"رقائق وزهد › ما فيه البركة","dorar":"UXCpAGol"},{"id":"س-06093","fp":"ccb51c9312df","stateId":441,"easy":"إذا ارتبطت الخيل في سبيل الله ← يكون لك أجر حتى أرواثها","cause":"فمن ارتبطها في سبيلِ اللهِ","result":"فإنها لا تُغَيِّبُ في بطونها شيئًا إلا كان له أجرٌ ؛ حتى ذكر أرْواثَهَا وأبوالَها ، ولاتَعْدو فى وادٍ شوطًا أو شوطَين ؛ إلا كان في ميزانِه","explicit":true,"ref":"صحيح الترغيب 1242","srcLabel":"متفق عليه","text":["الخيلُ معقودٌ في نواصيها الخيرُ إلى يومِ القيامةِ ، والخيلُ ثلاثةٌ : خيلُ أجرٍ ، وخيلُ وِزرٍ ، وخيلُ سِترٍ . فأما خيلُ سِترٍ ؛ فمَنِ اتَّخذها تعفُّفًا وتكرُّمًا وتجمُّلًا ، ولم ينْسَ حقَّ ظهورِها وبطونِها في عُسْرِه ويُسْرِه . وأما خيلُ الأجرِ ؛ ",["فمن ارتبطها في سبيلِ اللهِ",1]," ؛ ",["فإنها لا تُغَيِّبُ في بطونها شيئًا إلا كان له أجرٌ ؛ حتى ذكر أرْواثَهَا وأبوالَها ، ولاتَعْدو فى وادٍ شوطًا أو شوطَين ؛ إلا كان في ميزانِه",2]," . وأما خيلُ الوِزرِ ؛ فمن ارتبطها تبذُّخًا على الناسِ ؛ فإنها لا تُغَيِّبُ في بطونِها شيئًا إلا كان وزرًا عليه ، حتى ذكر أرْواثَها وأبوالَها ، ولا تعْدو في وادٍ شوطًا أو شوطَينِ إلا كان عليه وِزرٌ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (987) بنحوه، وأخرجه البخاري (2860 ) من قوله : الخيل ثلاثة،","bab":"رقائق وزهد › ما فيه البركة","dorar":"0jGXloqJ"},{"id":"س-07740","fp":"539e9295365a","stateId":441,"easy":"إذا ربطت الخيل في سبيل الله لأهل الإسلام ← يُكتب لك بعدد ما أكلت حسنات","cause":"فرَجُلٌ رَبَطَها في سَبيلِ اللهِ لأهلِ الإسلامِ","result":"فما أكَلَت مِن ذلك المَرجِ أوِ الرَّوضةِ مِن شَيءٍ إلَّا كُتِبَ له عَدَدَ ما أكَلَت حَسَناتٌ، وكُتِبَ له عَدَدَ أرواثِها وأبوالِها حَسَناتٌ، ولا تَقطَعُ طِوَلَها فاستَنَّت شَرَفًا أو شَرَفَينِ، إلَّا كَتَبَ اللهُ له عَدَدَ آثارِها وأرواثِها حَسَناتٍ، ولا مَرَّ بها صاحِبُها على نَهرٍ، فشَرِبَت منه ولا يُريدُ أن يَسقيَها؛ إلَّا كَتَبَ اللهُ له عَدَدَ ما شَرِبَت حَسَناتٍ","explicit":true,"ref":"صحيح مسلم 987","srcLabel":"متفق عليه","text":["ما مِن صاحِبِ ذَهَبٍ ولا فِضَّةٍ لا يُؤَدِّي مِنها حَقَّها إلَّا إذا كانَ يَومُ القيامةِ صُفِّحَت له صَفائِحُ مِن نارٍ، فأُحميَ عليها في نارِ جَهَنَّمَ، فيُكوى بها جَنبُه وجَبينُه وظَهرُه، كُلَّما بَرَدَت أُعيدَت له، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، حتَّى يُقضى بينَ العِبادِ، فيَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ. قيلَ: يا رَسولَ اللهِ، فالإبِلُ؟ قال: ولا صاحِبُ إبِلٍ لا يُؤَدِّي مِنها حَقَّها -ومِن حَقِّها حَلَبُها يَومَ وِردِها- إلَّا إذا كانَ يَومُ القيامةِ بُطِحَ لها بقاعٍ قَرقَرٍ أوفَرَ ما كانَت، لا يَفقِدُ مِنها فصيلًا واحِدًا، تَطَؤُه بأخفافِها وتَعَضُّه بأفواهِها، كُلَّما مَرَّ عليه أُولاها رُدَّ عليه أُخراها، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، حتَّى يُقضى بينَ العِبادِ، فيَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ. قيلَ: يا رَسولَ اللهِ، فالبَقَرُ والغَنَمُ؟ قال: ولا صاحِبُ بَقَرٍ ولا غَنَمٍ لا يُؤَدِّي مِنها حَقَّها إلَّا إذا كانَ يَومُ القيامةِ بُطِحَ لها بقاعٍ قَرقَرٍ، لا يَفقِدُ مِنها شيئًا، ليس فيها عَقصاءُ ولا جَلحاءُ ولا عَضباءُ، تَنطَحُه بقُرونِها وتَطَؤُه بأظلافِها، كُلَّما مَرَّ عليه أولاها رُدَّ عليه أُخراها، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، حتَّى يُقضى بينَ العِبادِ، فيَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ. قيلَ: يا رَسولَ اللهِ، فالخَيلُ؟ قال: الخَيلُ ثَلاثةٌ: هي لرَجُلٍ وِزرٌ، وهي لرَجُلٍ سِترٌ، وهي لرَجُلٍ أجرٌ؛ فأمَّا التي هي له وِزرٌ فرَجُلٌ رَبَطَها رياءً وفَخرًا ونِواءً على أهلِ الإسلامِ، فهي له وِزرٌ، وأمَّا التي هي له سِترٌ فرَجُلٌ رَبَطَها في سَبيلِ اللهِ، ثُمَّ لَم يَنسَ حَقَّ اللهِ في ظُهورِها ولا رِقابِها، فهي له سِترٌ، وأمَّا التي هي له أجرٌ ",["فرَجُلٌ رَبَطَها في سَبيلِ اللهِ لأهلِ الإسلامِ",1]," في مَرجٍ ورَوضةٍ، ",["فما أكَلَت مِن ذلك المَرجِ أوِ الرَّوضةِ مِن شَيءٍ إلَّا كُتِبَ له عَدَدَ ما أكَلَت حَسَناتٌ، وكُتِبَ له عَدَدَ أرواثِها وأبوالِها حَسَناتٌ، ولا تَقطَعُ طِوَلَها فاستَنَّت شَرَفًا أو شَرَفَينِ، إلَّا كَتَبَ اللهُ له عَدَدَ آثارِها وأرواثِها حَسَناتٍ، ولا مَرَّ بها صاحِبُها على نَهرٍ، فشَرِبَت منه ولا يُريدُ أن يَسقيَها؛ إلَّا كَتَبَ اللهُ له عَدَدَ ما شَرِبَت حَسَناتٍ",2],". قيلَ: يا رَسولَ اللهِ، فالحُمُرُ؟ قال: ما أُنزِلَ عليَّ في الحُمُرِ شَيءٌ إلَّا هذه الآيةُ الفاذَّةُ الجامِعةُ: {فمَن يَعمَلْ مِثقالَ ذَرَّةٍ خَيرًا يَرَهُ * ومَن يَعمَلْ مِثقالَ ذَرَّةٍ شَرًّا يَرَهُ}. [الزلزلة: 7-8]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2371) مختصراً، ومسلم (987) واللفظ له","bab":"قرآن › أسباب النزول","dorar":"J4xobANc"},{"id":"س-06757","fp":"5084170d1213","stateId":441,"easy":"إذا ربطت فرس الجهاد ← يُكتب لك حسنات بما يستنّ في طوله","cause":"فرَسَ المُجاهِدِ لَيَستَنُّ في طِوَلِه","result":"فيُكتَبُ له حَسَناتٍ","explicit":true,"ref":"صحيح البخاري 2785","srcLabel":"مسلم","text":["جاءَ رَجُلٌ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: دُلَّني على عَمَلٍ يَعدِلُ الجِهادَ، قال: لا أجِدُه، قال: هل تَستَطيعُ إذا خَرَجَ المُجاهِدُ أن تَدخُلَ مَسجِدَكَ فتَقومَ ولا تَفتُرَ، وتَصومَ ولا تُفطِرَ؟ قال: ومَن يَستَطيعُ ذلك؟! قال أبو هُرَيرةَ: إنَّ ",["فرَسَ المُجاهِدِ لَيَستَنُّ في طِوَلِه",1],"، ",["فيُكتَبُ له حَسَناتٍ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1878) بنحوه","bab":"صيام › فضل الصيام","dorar":"3YqKddoM","merged":2,"otherRefs":["تخريج المسند لشاكر 16/224 (صحيح)"]},{"id":"س-06146","fp":"c063ee970f4b","stateId":441,"easy":"إذا اتخذت الخيل وحبستها في سبيل الله ← فما غيّبت في بطونها أجر لك","cause":"الذي يَتَّخِذُها ويَحبِسُها في سبيلِ اللهِ","result":"فما غيَّبَتْ في بُطونِها أجرٌ، ولوِ اسْتَنَّتْ منه شَرَفًا أو شَرَفَيْن كان له بكلِّ خُطوةٍ خَطاها أَجرٌ، ولو عرَضَ له نهرٌ فسقاها منه، كان له بكلِّ قَطرةٍ غيَّبَتْه في بُطونِها أَجرٌ، حتى ذكَرَ الأجرَ في أرواثِها وأبوالِها","explicit":true,"repOf":"س-07745","ref":"تخريج المسند لشعيب 8977","text":["ما مِن صاحِبٍ كَنزٍ لا يؤدِّي زكاةَ مالِه، إلَّا جيءَ به يومَ القيامةِ وبكَنزِه، فيُحمَى عليه صَفائحَ في نارِ جهنَّمَ، فيُكوى بها جبينُه وجنبُه وظهرُه، حتى يَحكُمَ اللهُ بينَ عبادِه في يومٍ كان مِقدارُه خمسينَ ألفَ سَنةٍ ممَّا تَعُدُّون، ثمَّ يَرى سَبيلَه؛ إمَّا إلى الجنَّةِ، وإمَّا إلى النَّارِ، وما مِن صاحِبِ إبلٍ لا يؤدِّي زكاتَها، إلَّا جيءَ به يومَ القيامةِ وبإبلِه كأَوفَرِ ما كانت عليه، فيُبطَحُ لها بِقاعٍ قَرْقَرٍ، كلَّما مضى أُخراها عاد عليه أُولاها، حتى يَحكُمَ اللهُ بينَ عبادِه في يومٍ كان مِقدارُه خمسينَ ألفَ سَنةٍ ممَّا تَعُدُّون، ثمَّ يَرى سَبيلَه؛ إمَّا إلى الجنَّةِ، وإمَّا إلى النَّارِ، وما مِن صاحِبِ غَنمٍ لا يؤدِّي زكاتَها، إلَّا جيءَ به وبغَنَمِه يومَ القيامةِ كأَوفَرِ ما كانت، فيُبطَحُ لها بِقاعٍ قَرْقَرٍ، فتَطَؤه بأَظْلافِها، وتَنطَحُه بقرونِها، كلَّما مَضَتْ أُخراها رُدَّتْ عليه أُولاها، حتى يَحكُمَ اللهُ بينَ عبادِه في يومٍ كان مِقدارُه خمسينَ ألفَ سَنةٍ ممَّا تَعُدُّون، ثمَّ يَرى سَبيلَه؛ إمَّا إلى الجنَّةِ، وإمَّا إلى النَّارِ. قيل: يا رسولَ اللهِ، فالخيلُ؟ قال: الخيلُ مَعْقودٌ بنواصيها الخيرُ إلى يومِ القيامةِ، والخيلُ ثلاثةٌ: فهي لرجُلٍ أَجرٌ، وهي لرجُلٍ سِترٌ، وهي على رجُلٍ وِزرٌ؛ فأمَّا الذي هي له أَجرٌ، ",["الذي يَتَّخِذُها ويَحبِسُها في سبيلِ اللهِ",1],"، ",["فما غيَّبَتْ في بُطونِها أجرٌ، ولوِ اسْتَنَّتْ منه شَرَفًا أو شَرَفَيْن كان له بكلِّ خُطوةٍ خَطاها أَجرٌ، ولو عرَضَ له نهرٌ فسقاها منه، كان له بكلِّ قَطرةٍ غيَّبَتْه في بُطونِها أَجرٌ، حتى ذكَرَ الأجرَ في أرواثِها وأبوالِها",2],"، وأمَّا الذي هي له سِترٌ، فرجُلٌ يتَّخِذُها تَعَفُّفًا وتَجَمُّلًا وتَكَرُّمًا، ولا يَنسى حقَّها في ظهورِها وبُطونِها، في عُسرِها ويُسرِها، وأمَّا الذي هي عليه وِزرٌ، فرجُلٌ يتَّخِذُها أَشَرًا وبَطَرًا ورِئاءَ الناسِ، وبَذَخًا عليهم. قيل: يا رسولَ اللهِ، فالحُمُرُ؟ قال: ما أُنزِلَ علَيَّ فيها شيءٌ إلَّا هذه الآيةُ الجامعةُ الفاذَّةُ: {مَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهْ * وَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهْ} [الزلزلة: 7-8]."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (987)، وأبو داود (1658)، وأحمد (8977) واللفظ له","bab":"زكاة › عقوبة مانع الزكاة","dorar":"XrtAHbWi"},{"id":"س-07444","fp":"6dbcb81ad3ce","stateId":441,"easy":"إذا اتخذت الخيل في سبيل الله وأعددتها ← لا تغيّب في بطونها شيئاً إلا كُتب لك به أجر","cause":"فالَّذي يتَّخذُها في سبيلِ اللَّهِ، ويعدُّها لَهُ","result":"لا يغيبُ في بطونِها شيئًا إلَّا كتبَ لَهُ بِها أجرٌ، ولو عَرضَ مرجًا أو مرجينِ فرعاها صاحبُها فيهِ كتبَ لَهُ مِمَّا غيَّبت في بطونِها أجرٌ، ولوِ استنَّت شَرفًا أو شرفينِ، كُتِبَ لَهُ بِكُلِّ خطوةٍ خطاها أجرٌ","explicit":true,"repOf":"س-07745","ref":"صحيح ابن خزيمة 4/ 51","text":["ما مِن عبدٍ لَهِ مالٌ لا يؤدِّي زَكاتَهُ إلَّا جُمِعَ يومَ القيامةِ تُحمَى عليهِ صفائحُ في جَهَنَّمَ، وَكويَ بِها جنبُهُ، وظَهْرُهُ حتَّى يقضيَ اللَّهُ بينَ عبادِهِ في يومٍ كانَ مِقدارُهُ خمسينَ ألفَ سنةٍ مِمَّا تعدُّونَ، ثمَّ يَرى سبيلَهُ، إمَّا إلى الجنَّةِ، وإمَّا إلى النَّارِ، وذَكَرَ الحديثَ بطولِهِ في قصَّةِ الإبلِ والغنمِ . قالَ: قيلَ: يا رسولَ اللَّهِ: والخيلُ قالَ: الخيلُ معقودٌ في نواصيها الخيرُ إلى يومِ القيامةِ، والخيلُ لثلاثةٍ: هيَ لرجلٍ أجرٌ، ولرجلٍ سِترٌ، وعلى رجلٍ وزرٌ، فأمَّا الَّذي هيَ لَهُ أجرٌ، ",["فالَّذي يتَّخذُها في سبيلِ اللَّهِ، ويعدُّها لَهُ",1]," ",["لا يغيبُ في بطونِها شيئًا إلَّا كتبَ لَهُ بِها أجرٌ، ولو عَرضَ مرجًا أو مرجينِ فرعاها صاحبُها فيهِ كتبَ لَهُ مِمَّا غيَّبت في بطونِها أجرٌ، ولوِ استنَّت شَرفًا أو شرفينِ، كُتِبَ لَهُ بِكُلِّ خطوةٍ خطاها أجرٌ",2],"، ولو عرضَ نَهَرٌ فسقاها بِهِ، كانت لَهُ بِكُلِّ قطرةٍ غُيِّبَت في بطونِها منهُ أجرٌ، حتَّى ذَكَرَ الأجرَ في أرواثِها وأبوالِها، وأمَّا الَّتي هيَ لَهُ سترٌ فالَّذي يتَّخذُها تعفُّفًا وتجمُّلًا وتستُّرًا، ولا يحبِسُ حقَّ ظُهورِها وبطونِها في يُسْرِها وعُسْرِها، وأمَّا الَّذي عليهِ وزرٌ فالَّذي يتَّخذُها أشَرًا وبطرًا وبَذخًا عليهِم قالوا: فالحُمرُ يا رسولَ اللَّهِ؟ قالَ: ما أنزَلَ اللَّهُ عليَّ فيها شيئًا إلَّا هذِهِ الآيةَ الجامِعةَ الفاذَّةَ: {فَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُ، وَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُ} [الزَّلزلةُ: 8]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (987)، وأحمد (8977)، وأبو عوانة في ((المستخرج)) (3370) بنحوه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"DFO0OKiF"},{"id":"س-04838","fp":"ccb993f7d127","stateId":441,"easy":"إذا ارتبطت فرساً في سبيل الله ← فثمنه وركوبه وعاريته وعلفه أجر","cause":"فرسٌ يرتبطُه الرجلُ في سبيلِ اللهِ عزَّ وجلَّ","result":"فثمنُه أجرٌ ، وركوبُه أجرٌ ، وعاريتُه أجرٌ ، وعلَفُه أجرٌ","explicit":true,"ref":"صحيح الترغيب 1243","srcLabel":"أحمد","text":["الخيلُ ثلاثةٌ : ",["فرسٌ يرتبطُه الرجلُ في سبيلِ اللهِ عزَّ وجلَّ",1]," ، ",["فثمنُه أجرٌ ، وركوبُه أجرٌ ، وعاريتُه أجرٌ ، [ وعلَفُه أجرٌ",2]," ] . وفرسٌ يغالق عليه الرجلُ ويراهِنُ ، فثمنُه وِزرٌ ، [ وعلفُه وزرٌ ] ، وركوبُه وزرٌ . وفرسٌ للبَطْنةِ ، فعسى أن يكونَ سِدادًا من الفقرِ إن شاء اللهُ ."],"grade":"صحيح","narrator":"رجل من الأنصار","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي شيبة (993 ) في ((المسند))، وأحمد (23230 )،والحارث ابن أبي أسامة كما في ((بغية الباحث عن زوائد مسند الحارث)) (649 )،وأبو نعيم في ((معرفة الصحابة)) (7153 )","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"NaVEVj05","merged":2,"otherRefs":["مجمع الزوائد 5/263 (صحيح)"]},{"id":"س-04349","fp":"db4075471125","stateId":441,"easy":"إذا ارتبطت فرساً في سبيل الله وعلفته بيدك ← فلك بكل حبة حسنة","cause":"منِ ارتبطَ فَرَسًا في سبيلِ اللهِ ، ثُمَّ عالَجَ عَلَفَهُ بيدِهِ","result":"كان لَهُ بكلِّ حبَّةٍ حسنَةٌ","explicit":true,"ref":"صحيح الجامع 6008","srcLabel":"ابن ماجه","text":[["منِ ارتبطَ فَرَسًا في سبيلِ اللهِ ، ثُمَّ عالَجَ عَلَفَهُ بيدِهِ ، ",1],["كان لَهُ بكلِّ حبَّةٍ حسنَةٌ",2]],"grade":"صحيح","narrator":"تميم الداري","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (2791) واللفظ له، وأحمد (16955)","bab":"جهاد › الترغيب في الجهاد","dorar":"DAhU7UUR"},{"id":"س-04350","fp":"fa2bc8fbfaa0","stateId":441,"easy":"إذا نقّيت لفرسك الشعير وعلّقته عليه ← يكتب الله لك بكل حبة حسنة","cause":"ما من امرئٍ مسلمٍ يُنَقِّي لفرسِه شعيرًا ، ثم يُعَلِّقُه عليه","result":"إلا كتب اللهُ له بكلِّ حبَّةٍ حسنةً","explicit":true,"ref":"صحيح الجامع 5688","srcLabel":"ابن ماجه","text":[["ما من امرئٍ مسلمٍ يُنَقِّي لفرسِه شعيرًا ، ثم يُعَلِّقُه عليه",1]," ",["إلا كتب اللهُ له بكلِّ حبَّةٍ حسنةً",2]],"grade":"صحيح","narrator":"تميم الداري","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (2791)، وأحمد (16955) واللفظ له","bab":"جهاد › الترغيب في الجهاد","dorar":"TDnEOB7Z"},{"id":"س-06089","fp":"42eb4c656b7e","stateId":441,"easy":"إذا أنفقت على الخيل ← فأنت كالباسط كفه بالصدقة","cause":"والمنْفِقُ على الخيْلِ","result":"كالباسِطِ كفَّهُ بالنفقةِ لا يَقبِضُها","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"similar":["س-00514"],"ref":"صحيح الجامع 3349","srcLabel":"مسلم","text":["الخيرُ معقودٌ بِنواصِي الخيْلِ إلى يومِ القيامةِ ، ",["والمنْفِقُ على الخيْلِ",1]," ",["كالباسِطِ كفَّهُ بالنفقةِ لا يَقبِضُها",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (3088 )، وأخرج مسلم (987) الفقرة الأولى الخير....بنحوه","bab":"رقائق وزهد › ما فيه البركة","dorar":"U5Xpr2Jy"},{"id":"س-05038","fp":"5a0742c87c23","stateId":441,"easy":"إذا ربطت فرساً في سبيل الله ← فعلفه وروثه وبوله حسنات لك","cause":"فالذي يرتبطُ في سبيلِ اللهِ","result":"فعلفُه و روثُه و بولُه , و ذكر ما شاء اللهُ - يعني إنَّ كلَّ ذلك له حسناتٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-04369","otherNeedIds":[65],"ref":"غاية المرام 392","text":["الخيلُ ثلاثةٌ : فرس ٌللرحمنِ . وفرسٌ للإنسانِ , و فرسٌ للشيطانِ . فأما فرسُ الرحمنِ ",["فالذي يرتبطُ في سبيلِ اللهِ",1]," ، ",["فعلفُه و روثُه و بولُه , و ذكر ما شاء اللهُ - يعني إنَّ كلَّ ذلك له حسناتٌ",2]," - و أما فرسُ الشيطانِ فالذي يُقامَرُ أو يُراهَنُ عليه . و أما فرسُ الإنسانِ فالذي يرتبطُه الإنسانُ يلتمسُ بطنَها - أي للنتاجِ - فهى سترٌ من فقرٍ"],"grade":"صحيح","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"TGiGIY8T","merged":2,"otherRefs":["صحيح الجامع 3350 (صحيح)"]},{"id":"س-00514","fp":"4773db9506db","stateId":441,"easy":"إذا أنفقت على خيلك في سبيل الله ← فأنت كالباسط يده بالصدقة","cause":"المُنْفِقُ على الخَيْلِ","result":"كَالباسِطِ يَدَهُ بِالصَّدَقَةِ ، لا يَقْبِضُها","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-06089","ref":"صحيح الترغيب 1246","text":[["المُنْفِقُ على الخَيْلِ",1]," ",["كَالباسِطِ يَدَهُ بِالصَّدَقَةِ ، لا يَقْبِضُها",2]," ."],"grade":"صحيح","narrator":"سهل ابن الحنظلية الأنصاري","muhaddith":"صحيح لغيره","takhrij":"أخرجه الحاكم (2455) واللفظ له، وابن أبي شيبة (19873) مطولًا، وأبو داود (4089) في أثناء حديث طويل.","bab":"آداب عامة › ضرب الأمثال","dorar":"GeWkiwLO"},{"id":"س-01976","fp":"5e2f8a21e8f3","stateId":442,"easy":"إذا جهّزت غازياً في سبيل الله ← لك مثل أجره من غير أن ينقص منه شيء","cause":"ومَن جَهَّزَ غازيًا في سَبيلِ اللهِ","result":"كان له -أو: كُتِبَ له- مِثلُ أجرِ الغازي في أنَّه لا يَنقُصُ مِن أجرِ الغازي شيئًا","explicit":true,"star":true,"otherNeedIds":[49],"ref":"تخريج المسند لشعيب 21676","srcLabel":"متفق عليه","text":["مَن فَطَّرَ صائمًا، كان له -أو: كُتِبَ له- مِثلُ أجرِ الصَّائمِ، مِن غيرِ أنْ يَنقُصَ مِن أجرِ الصَّائمِ شيئًا، ",["ومَن جَهَّزَ غازيًا في سَبيلِ اللهِ، ",1],["كان له -أو: كُتِبَ له- مِثلُ أجرِ الغازي في أنَّه لا يَنقُصُ مِن أجرِ الغازي شيئًا",2],"."],"grade":"صحيح","narrator":"زيد بن خالد الجهني","muhaddith":"الشطر الأول من الحديث حسن لغيره، والشطر الثاني صحيح","takhrij":"أخرجه البخاري (2843)، ومسلم (1895)، وأبو داود (2509)، والنسائي (3180) مختصراً، والترمذي (807، 1628) مفرقاً، وابن ماجه (1746، 2759) مفرقاً، وأحمد (21676) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"xyjD4Mxc"},{"id":"س-00673","fp":"1e7793d88486","stateId":442,"easy":"إذا خرج أحدكما وخلف الآخر في أهله بخير ← فالأجر بينكما","cause":"لِيَنبَعِثْ من كُلِّ رَجُلينِ أحَدُهما","result":"والأجْرُ بيْنَهما","explicit":true,"ref":"تخريج المسند لشعيب 11867","srcLabel":"مسلم","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم بَعَثَ بَعثًا إلى بَني لِحْيانَ من بَني هُذَيلٍ -قال رَوحٌ: من هُذَيلٍ- قال: ",["لِيَنبَعِثْ من كُلِّ رَجُلينِ أحَدُهما",1],"، ",["والأجْرُ بيْنَهما",2],"، ثُمَّ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: اللَّهُمَّ بارِكْ لنا في مُدِّنا وصاعِنا، واجْعَلْ مع البَرَكةِ بَرَكَتينِ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناداه صحيحان على شرط مسلم","takhrij":"أخرجه مسلم (1896)، وأحمد (11867) واللفظ له","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"kmdBBWlT"},{"id":"س-02141","fp":"ca7e167361aa","stateId":442,"easy":"إذا شيّعت مجاهداً وأعنته على رحله ← فهو خير من الدنيا وما فيها","cause":"لأَنْ أُشيِّعَ مُجاهِدًا في سبيلِ اللهِ فأَكْفِهِ على رَحْلِه غَدْوةً أوْ رَوْحةً","result":"أَحبُّ إليَّ مِنَ الدُّنيا وما فيها","explicit":true,"ref":"المستدرك على الصحيحين 2514","srcLabel":"أحمد","text":[["لأَنْ أُشيِّعَ مُجاهِدًا في سبيلِ اللهِ فأَكْفِهِ على رَحْلِه غَدْوةً أوْ رَوْحةً",1],"؛ ",["أَحبُّ إليَّ مِنَ الدُّنيا وما فيها",2],"."],"grade":"صحيح","narrator":"معاذ بن أنس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داوود (2824)،أحمد (15643)، والبيهقي (18618) واللفظ لهم.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"8Lo4JrEF"},{"id":"س-04354","fp":"eb320fa7dda9","stateId":442,"easy":"إذا جهّزت غيرك للغزو ← فلك أجرك وأجر الغازي","cause":"و للجاعِلِ","result":"أجرُهُ و أجرُ الغازِي","explicit":true,"otherNeedIds":[49],"ref":"الجامع الصغير 7327","srcLabel":"أبو داود","text":["للغازِي أجرُهُ،  ",["و للجاعِلِ",1]," ",["أجرُهُ و أجرُ الغازِي",2]],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن","takhrij":"أخرجه أبو داود (2526)، وأحمد (6624)","bab":"جهاد › الترغيب في الجهاد","dorar":"6r0jqFAe"},{"id":"س-04748","fp":"181908072e71","stateId":443,"easy":"إذا جُرحت في سبيل الله ← تلقى الله لونه لون الدم وريحه ريح المسك","cause":"ما منكم مِن أحدٍ يُجرَحُ في سَبيلِ اللهِ","result":"إلَّا لَقيَ اللهَ كهَيْئَتِه يَومَ جُرِحَ، لَونُه لَونُ دَمٍ، وريحُه ريحُ مِسْكٍ","explicit":true,"otherNeedIds":[65],"ref":"تخريج المسند لشعيب 9188","srcLabel":"متفق عليه","text":[["ما منكم مِن أحدٍ يُجرَحُ في سَبيلِ اللهِ",1],"، واللهُ أعلَمُ بمَن يُجرَحُ في سَبيلِه؛ ",["إلَّا لَقيَ اللهَ كهَيْئَتِه يَومَ جُرِحَ، لَونُه لَونُ دَمٍ، وريحُه ريحُ مِسْكٍ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (5533)، ومسلم (1876)، والترمذي (1656)، والنسائي (3147)، وابن ماجه (2795)، وأحمد (9188) واللفظ له","bab":"رقائق وزهد › الإخلاص","dorar":"DyMVmgp3"},{"id":"ق-0241","fp":"29f245119461","stateId":443,"easy":"الخروج مهاجراً إلى الله ورسوله ثم الموت ← وقوع الأجر على الله","cause":"الخروج مهاجراً إلى الله ورسوله ثم الموت","result":"وقوع الأجر على الله","explicit":true,"similar":["س-08332"],"ref":"سورة النساء: 100","srcLabel":"القرآن الكريم","quran":{"s":4,"from":100,"to":100,"text":"وَمَنْ يُهَاجِرْ فِي سَبِيلِ اللَّهِ يَجِدْ فِي الْأَرْضِ مُرَاغَمًا كَثِيرًا وَسَعَةً وَمَنْ يَخْرُجْ مِنْ بَيْتِهِ مُهَاجِرًا إِلَى اللَّهِ وَرَسُولِهِ ثُمَّ يُدْرِكْهُ الْمَوْتُ فَقَدْ وَقَعَ أَجْرُهُ عَلَى اللَّهِ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا (100)","hl":[[87,251,1]]}},{"id":"س-01974","fp":"3c110f493de3","stateId":443,"easy":"إذا سألت الله الشهادة مخلصاً ← يعطيك أجر شهيد ولو مت على فراشك","cause":"ومَن سَأَلَ اللهَ الشَّهادةَ مُخلِصًا","result":"أعطاه اللهُ أجرَ شَهيدٍ وإنْ مات على فِراشِه","explicit":true,"otherNeedIds":[49,62],"ref":"تخريج المسند لشعيب 22110","srcLabel":"أبو داود","text":["مَن جُرِحَ جُرحًا في سَبيلِ اللهِ، جاء يومَ القيامةِ لَونُه لَونُ الزَّعفَرانِ، ورِيحُه رِيحُ المِسكِ، عليه طابَعُ الشُّهَداءِ، ",["ومَن سَأَلَ اللهَ الشَّهادةَ مُخلِصًا، ",1],["أعطاه اللهُ أجرَ شَهيدٍ وإنْ مات على فِراشِه، ",2],"ومَن قاتَلَ في سَبيلِ اللهِ فُواقَ ناقةٍ، وَجَبَتْ له الجنَّةُ."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2541)، والترمذي (1657)، والنسائي (3141)، وابن ماجه (2792)، وأحمد (22110) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"iOg93jm2"},{"id":"س-04436","fp":"4ffa818a903a","stateId":443,"easy":"إذا خرجت غازياً فمت ← يكتب الله لك أجر الغازي إلى يوم القيامة","cause":"ومن خرج غازيًا فمات","result":"كتب اللهُ له أجرَ الغازى إلى يومِ القيامةِ","explicit":true,"ref":"صحيح الترغيب 1267","srcLabel":"الطبراني","text":["من خرج حاجًّا فمات ؛ كتب اللهُ له أجرَ الحاجِّ إلى يومِ القيامةِ ، ومن خرج معتمرًا فمات ، كتب اللهُ له أجرَ المعتمِرِ إلى يومِ القيامةِ ، ",["ومن خرج غازيًا فمات ، ",1],["كتب اللهُ له أجرَ الغازى إلى يومِ القيامةِ ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو يعلى (6357)، والطبراني في ((المعجم الأوسط)) (5321) باختلاف يسير، والبيهقي في ((شعب الإيمان)) (4100) مختصراً.","bab":"جهاد › فضل الجهاد","dorar":"D5ffhXg9"},{"id":"س-04446","fp":"9b3fd80af0a9","stateId":443,"easy":"إذا سألت الله الشهادة صادقاً ثم مت أو قُتلت ← فلك أجر شهيد","cause":"ومَن سأَل اللهَ القتلَ مِن نفسِه صادقًا، ثمَّ مات أو قُتِل","result":"فإنَّ له أجرَ شهيدٍ، زاد ابنُ المُصفَّى مِن هنا","explicit":true,"similar":["س-04459","س-04517"],"otherNeedIds":[49,62],"ref":"تخريج سنن أبي داود 2541","srcLabel":"أبو داود","text":["أنَّه سَمِع رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: مَن قاتَلَ في سبيلِ اللهِ فُواقَ ناقةٍ فقد وجَبتْ له الجنَّةُ، ",["ومَن سأَل اللهَ القتلَ مِن نفسِه صادقًا، ثمَّ مات أو قُتِل، ",1],["فإنَّ له أجرَ شهيدٍ، زاد ابنُ المُصفَّى مِن هنا: ",2],"ومَن جُرِح جُرحًا في سبيلِ اللهِ، أو نُكِب نَكبةً، فإنَّها تجيءُ يومَ القيامةِ كأَغزَرِ ما كانتْ: لونُها لونُ الزَّعفرانِ، وريحُها ريحُ المِسكِ، ومَن خرَجَ به خُراجٌ في سبيلِ اللهِ، فإنَّ عليه طابَعَ الشُّهداءِ."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2541) بلفظه، والترمذي (1657)، وابن ماجه (2792) كلاهما ببعض لفظه.","bab":"جهاد › فضل الجهاد","dorar":"P7OCEhu7"},{"id":"س-04459","fp":"016e56133029","stateId":443,"easy":"إذا سألت الله القتل في سبيله صادقاً ثم مت ← فلك أجر الشهداء","cause":"ومَن سَأَلَ اللهَ القَتلَ مِن عندِ نَفْسِه صادقًا، ثُمَّ مات أو قُتِلَ","result":"فله أجرُ الشُّهَداءِ","explicit":true,"repOf":"س-04446","otherNeedIds":[62],"ref":"تخريج المسند لشعيب 22116","text":["أنَّه سَمِعَ رسولَ اللهِ صَلَّى اللهُ عليه وسلَّمَ يقولُ: مَن جاهَدَ في سَبيلِ اللهِ -وقال رَوحٌ: قاتَلَ في سَبيلِ اللهِ- مِن رَجُلٍ مُسلِمٍ فُواقَ ناقةٍ، فقد وَجَبَتْ له الجنَّةُ، ",["ومَن سَأَلَ اللهَ القَتلَ مِن عندِ نَفْسِه صادقًا، ثُمَّ مات أو قُتِلَ، ",1],["فله أجرُ الشُّهَداءِ، ",2],"ومَن جُرِحَ جُرحًا في سَبيلِ اللهِ أو نُكِبَ نَكبةً، فإنَّها تَجيءُ يومَ القيامةِ كأغزرِ ما كانتْ -وقال عبدُ الرَّزَّاقِ: كأغرِّ، ورَوحٌ: كأغزرِ، وحَجَّاجٌ: كأعزِّ ما كانتْ- لَونُها كالزَّعفَرانِ، ورِيحُها كالمِسكِ، ومَن جُرِحَ في سَبيلِ اللهِ، فعليه طابَعُ الشُّهَداءِ."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2541)، والترمذي (1657)، والنسائي (3141) باختلاف يسير، وابن ماجه (2792) مختصراً، وأحمد (22116) واللفظ له","bab":"جهاد › فضل الجهاد","dorar":"JjJkfDcT"},{"id":"س-04468","fp":"9e17edb6e951","stateId":443,"easy":"إذا خرجت في سبيل الله فسقطت عن دابتك فمت ← وقع أجرك على الله","cause":"مَنْ خَرَجَ في سبيلِ اللهِ، فخَرَّ عنْ دابَّتِه، فماتَ","result":"فقد وَقَعَ أَجرُهُ على اللهِ","explicit":true,"ref":"المستدرك على الصحيحين 2480","srcLabel":"الحاكم","text":["مَنْ خَرَجَ مِن بيتِه مُجاهِدًا في سبيلِ اللهِ -قالَ: ثُمَّ ضَمَّ أَصابِعَهُ الثَّلاثَ- وأين المجاهدونَ في سبيلِ اللهِ؟ ",["مَنْ خَرَجَ في سبيلِ اللهِ، فخَرَّ عنْ دابَّتِه، فماتَ",1],"؛ ",["فقد وَقَعَ أَجرُهُ على اللهِ",2],"، وإنْ لَدَغَتْهُ دابَّةٌ فماتَ؛ فقد وَقَعَ أَجرُهُ على اللهِ، ومَنْ ماتَ حَتْفَ أَنفِهِ -قالَ: وإنَّها لكلمةٌ ما سَمِعْتُها مِن أَحَدٍ مِنَ العربِ أوَّلَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؛ يعني: بحَتفِ أَنفِهِ على فِراشِهِ- فقد وَقَعَ أَجرُهُ على اللهِ، ومَنْ قُتِلَ قَعْصًا؛ فقد استَوْجَبَ الجنَّةَ."],"grade":"صحيح","narrator":"عبدالله بن عتيك","muhaddith":"صحيح الإسناد","bab":"جهاد › فضل الجهاد","dorar":"fcQtrsbj"},{"id":"س-04469","fp":"c398ef0896c3","stateId":443,"easy":"إذا خرجت في سبيل الله فلدغتك دابة فمت ← وقع أجرك على الله","cause":"وإنْ لَدَغَتْهُ دابَّةٌ فماتَ","result":"فقد وَقَعَ أَجرُهُ على اللهِ","explicit":true,"ref":"المستدرك على الصحيحين 2480","srcLabel":"الحاكم","text":["مَنْ خَرَجَ مِن بيتِه مُجاهِدًا في سبيلِ اللهِ -قالَ: ثُمَّ ضَمَّ أَصابِعَهُ الثَّلاثَ- وأين المجاهدونَ في سبيلِ اللهِ؟ مَنْ خَرَجَ في سبيلِ اللهِ، فخَرَّ عنْ دابَّتِه، فماتَ؛ فقد وَقَعَ أَجرُهُ على اللهِ، ",["وإنْ لَدَغَتْهُ دابَّةٌ فماتَ",1],"؛ ",["فقد وَقَعَ أَجرُهُ على اللهِ",2],"، ومَنْ ماتَ حَتْفَ أَنفِهِ -قالَ: وإنَّها لكلمةٌ ما سَمِعْتُها مِن أَحَدٍ مِنَ العربِ أوَّلَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؛ يعني: بحَتفِ أَنفِهِ على فِراشِهِ- فقد وَقَعَ أَجرُهُ على اللهِ، ومَنْ قُتِلَ قَعْصًا؛ فقد استَوْجَبَ الجنَّةَ."],"grade":"صحيح","narrator":"عبدالله بن عتيك","muhaddith":"صحيح الإسناد","bab":"جهاد › فضل الجهاد","dorar":"fcQtrsbj"},{"id":"س-04470","fp":"0f87c615bfab","stateId":443,"easy":"إذا خرجت في سبيل الله فمت على فراشك ← وقع أجرك على الله","cause":"ومَنْ ماتَ حَتْفَ أَنفِهِ -قالَ: وإنَّها لكلمةٌ ما سَمِعْتُها مِن أَحَدٍ مِنَ العربِ أوَّلَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؛ يعني: بحَتفِ أَنفِهِ على فِراشِهِ","result":"فقد وَقَعَ أَجرُهُ على اللهِ","explicit":true,"apply":{"k":"time","t":"عند النوم"},"ref":"المستدرك على الصحيحين 2480","srcLabel":"الحاكم","text":["مَنْ خَرَجَ مِن بيتِه مُجاهِدًا في سبيلِ اللهِ -قالَ: ثُمَّ ضَمَّ أَصابِعَهُ الثَّلاثَ- وأين المجاهدونَ في سبيلِ اللهِ؟ مَنْ خَرَجَ في سبيلِ اللهِ، فخَرَّ عنْ دابَّتِه، فماتَ؛ فقد وَقَعَ أَجرُهُ على اللهِ، وإنْ لَدَغَتْهُ دابَّةٌ فماتَ؛ فقد وَقَعَ أَجرُهُ على اللهِ، ",["ومَنْ ماتَ حَتْفَ أَنفِهِ -قالَ: وإنَّها لكلمةٌ ما سَمِعْتُها مِن أَحَدٍ مِنَ العربِ أوَّلَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؛ يعني: بحَتفِ أَنفِهِ على فِراشِهِ- ",1],["فقد وَقَعَ أَجرُهُ على اللهِ، ",2],"ومَنْ قُتِلَ قَعْصًا؛ فقد استَوْجَبَ الجنَّةَ."],"grade":"صحيح","narrator":"عبدالله بن عتيك","muhaddith":"صحيح الإسناد","bab":"جهاد › فضل الجهاد","dorar":"fcQtrsbj"},{"id":"س-04480","fp":"01404bdd5356","stateId":443,"easy":"إذا سُفك دمك وعُقر جوادك ← تكون من أفضل الشهداء","cause":"من سُفِكَ دمُهُ ، و عُقِرَ جَوَادُهُ","result":"أفضلُ الشهداءِ","explicit":true,"ref":"السلسلة الصحيحة 1504","srcLabel":"أحمد","text":[["أفضلُ الشهداءِ",2],[" ، من سُفِكَ دمُهُ ، و عُقِرَ جَوَادُهُ",1]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرجه أحمد (22342)، والطبراني (8/259) (7871) باختلاف يسير.","bab":"جهاد › فضل الجهاد","dorar":"gRdSPQ6z"},{"id":"س-04517","fp":"d597d1f71d3b","stateId":443,"easy":"إذا سألت الله الشهادة صادقاً ← فلك أجر شهيد","cause":"ومَن سألَ اللهَ الشَّهادةَ صادِقًا مِن نَفْسِه","result":"فله أجْرُ شَهيدٍ","explicit":true,"repOf":"س-04446","otherNeedIds":[49,62],"ref":"الفتوحات الربانية 5/45","text":["مَن قاتَلَ فُواقَ ناقةٍ وَجَبتْ له الجنَّةُ، ",["ومَن سألَ اللهَ الشَّهادةَ صادِقًا مِن نَفْسِه ",1],["فله أجْرُ شَهيدٍ",2],"."],"grade":"صحيح","muhaddith":"صحيح","bab":"جهاد › فضل الشهيد","dorar":"E3KXOmSh"},{"id":"س-08332","fp":"e17619a93fbe","stateId":443,"easy":"إذا خرجت مهاجراً إلى الله ورسوله ثم أدركك الموت ← فقد وقع أجرك على الله","cause":"وَمَنْ يَخْرُجْ مِنْ بَيْتِهِ مُهَاجِرًا إِلَى اللهِ وَرَسُولِهِ ثُمَّ يُدْرِكْهُ الْمَوْتُ","result":"فَقَدْ وَقَعَ أَجْرُهُ عَلَى اللهِ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا","explicit":true,"repOf":"ق-0241","ref":"السلسلة الصحيحة 3218","text":["هاجر خالدُ بنُ حزامٍ إلى أرضِ الحبشةِ ، فنهشَتْهُ حيَّةٌ في الطريقِ فمات ، فنزلت فيه :  ",["وَمَنْ يَخْرُجْ مِنْ بَيْتِهِ مُهَاجِرًا إِلَى اللهِ وَرَسُولِهِ ثُمَّ يُدْرِكْهُ الْمَوْتُ ",1],["فَقَدْ وَقَعَ أَجْرُهُ عَلَى اللهِ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا  ",2],"[ النساء : 100 ] قال الزبيرُ بنُ العوامِ : وكنتُ أتوقَّعُه وأنتظرُ قُدومَه وأنا بأرضِ الحبشةِ ، فما أحزَنَنِي شيءٌ حُزنِي على وفاتِه حين بلغَني ؛ لأنَّهُ قلَّ أحدٌ ممن هاجر من قريشٍ إلا معه بعضُ أهلِه أو ذي رحمِه ، ولم يكن معي أحدٌ من بني أسدِ بنِ عبدِ العُزَّى ، ولا أرجو غيرَه"],"grade":"حسن","narrator":"الزبير بن العوام","muhaddith":"إسناده حسن رجاله ثقات","takhrij":"أخرجه ابن أبي حاتم في ((التفسير)) (5888)","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"XwJ4kIbM"},{"id":"س-02059","fp":"6b2b750b727a","stateId":443,"easy":"إذا هاجرت ← فلا مثل للهجرة","cause":"عليك بالهجرةِ، فإنه لا مثلَ لها","result":"حدِّثني بعملٍ أستقيم عليه وأعملُه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح النسائي 4178","srcLabel":"النسائي","text":["يا رسولَ اللهِ ! ",["حدِّثني بعملٍ أستقيم عليه وأعملُه !",2]," قال له رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ : ",["عليك بالهجرةِ، فإنه لا مثلَ لها",1]],"grade":"صحيح","narrator":"أبو فاطمة الإيادي","muhaddith":"حسن صحيح","takhrij":"أخرجه النسائي (4167)، وابن أبي عاصم في ((الآحاد والمثاني))(973)، والطبراني (809) في أثناء حديث.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"WZOmJAvb"},{"id":"س-04404","fp":"34ccbe190b06","stateId":443,"easy":"إذا ثبتّ في الصف ولم تلتفت حتى تُقتل ← فأنت من أفضل الشهداء","cause":"الذي يَلقى العَدوَّ في الصَّفِّ، فإذا واجَهوا عَدوَّهم لَم يَلتَفِتْ يَمينًا ولا شِمالًا، واضِعًا سَيفَه على عاتِقِه، يقولُ: اللهُمَّ إنِّي أجَرتُك نَفسي اليَومَ بما أسلَفتُ في الأيَّامِ الخاليةِ، فيُقتَلُ عِندَ ذلك، فذلك مِنَ الشُّهَداءِ الذينَ يتلبَّطون في الغُرَفِ العُلا مِنَ الجَنَّةِ حَيثُ شاؤوا.","result":"ألا أُخبرُكُم بأفضَلِ الشُّهَداءِ عِندَ اللهِ عَزَّ وجَلَّ مَنزِلةً يَومَ القيامةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[62,47],"ref":"مشارع الأشواق 775","srcLabel":"الطبراني","text":["مختصرًا [",["ألا أُخبرُكُم بأفضَلِ الشُّهَداءِ عِندَ اللهِ عَزَّ وجَلَّ مَنزِلةً يَومَ القيامةِ",2],"؟",[" الذي يَلقى العَدوَّ في الصَّفِّ، فإذا واجَهوا عَدوَّهم لَم يَلتَفِتْ يَمينًا ولا شِمالًا، واضِعًا سَيفَه على عاتِقِه، يقولُ: اللهُمَّ إنِّي أجَرتُك نَفسي اليَومَ بما أسلَفتُ في الأيَّامِ الخاليةِ، فيُقتَلُ عِندَ ذلك، فذلك مِنَ الشُّهَداءِ الذينَ يتلبَّطون في الغُرَفِ العُلا مِنَ الجَنَّةِ حَيثُ شاؤوا].",1]],"grade":"حسن","narrator":"أبو سعيد","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (4131)، والخطيب البغدادي في (المتفق والمفترق)) (3/ 1758) كلاهما بنحوه .","bab":"جهاد › الشجاعة في الحرب والجبن","dorar":"WKTdcro5"},{"id":"س-01436","fp":"2498c37b5bdc","stateId":444,"easy":"إذا رميت بسهم في سبيل الله أصبت أو أخطأت ← فلك من الأجر كعتق رقبة","cause":"أيُّما رَجُلٍ رَمى بسَهمٍ في سَبيلِ اللهِ عزَّ وجلَّ","result":"فبَلَغَ، مُخطِئًا أو مُصيبًا، فله مِن الأجْرِ كرَقبةٍ يُعتِقُها مِن وَلدِ إسماعيلَ","explicit":true,"otherNeedIds":[49],"ref":"تخريج المسند لشعيب 19439","srcLabel":"النسائي","text":[["أيُّما رَجُلٍ رَمى بسَهمٍ في سَبيلِ اللهِ عزَّ وجلَّ، ",1],["فبَلَغَ، مُخطِئًا أو مُصيبًا، فله مِن الأجْرِ كرَقبةٍ يُعتِقُها مِن وَلدِ إسماعيلَ، ",2],"وأيُّما رَجُلٍ شاب شَيبةً في سَبيلِ اللهِ، فهي له نورٌ، وأيُّما رَجُلٍ مُسلِمٍ أعتَقَ رَجُلًا مُسلِمًا، فكلُّ عُضوٍ مِن المُعتَقِ بعُضوٍ مِن المُعتِقِ فِداءٌ له مِن النَّارِ، وأيُّما امرأةٍ مُسلِمةٍ أعتَقَتِ امرأةً مُسلِمةً، فكلُّ عُضوٍ مِن المُعتَقةِ بعُضوٍ مِن المُعتِقةِ فِداءٌ لها مِن النَّارِ، وأيُّما رَجُلٍ مُسلِمٍ قَدَّمَ للهِ عزَّ وجلَّ مِن صُلبِه ثلاثةً لم يَبلُغوا الحِنثَ، أو امرأةٍ، فهم له سُترةٌ مِن النَّارِ، وأيُّما رَجُلٍ قام إلى وُضوءٍ يُريدُ الصَّلاةَ، فأحصى الوُضوءَ إلى أماكنِه، سَلِمَ مِن كلِّ ذَنبٍ أو خَطيئةٍ له، فإنْ قام إلى الصَّلاةِ، رَفَعَه اللهُ عزَّ وجلَّ بها دَرجةً، وإنْ قَعَدَ، قَعَدَ سالمًا. فقال شُرَحبيلُ بنُ السِّمطِ: آنتَ سَمِعتَ هذا الحديثَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يا ابنَ عَبَسةَ؟ قال: نَعَمْ، والذي لا إلهَ إلَّا هو، لو أنِّي لم أسمَعْ هذا الحديثَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ غيرَ مَرَّةٍ أو مَرَّتَينِ أو ثلاثٍ أو أربعٍ أو خَمسٍ أو ستٍّ أو سَبعٍ -فانتَهى عندَ سَبعٍ-، ما حَلَفتُ -يَعني ما بالَيتُ- ألَّا أُحدِّثَ به أحَدًا مِن النَّاسِ، ولكنِّي واللهِ ما أدري عَددَ ما سَمِعتُه مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح دون قوله: \"من ولد إسماعيل\"","takhrij":"أخرجه النسائي (3142) مختصراً، وأحمد (19439) واللفظ له","bab":"وضوء › فضل الوضوء","dorar":"LicciAss"},{"id":"س-02126","fp":"176ec48bb8b1","stateId":444,"easy":"إذا رحت في سبيل الله ← فهو خير من الدنيا وما فيها","cause":"رَوْحةٌ في سَبيلِ اللهِ","result":"خَيرٌ مِنَ الدُّنيا وما فيها","explicit":true,"star":true,"similar":["س-04339","س-02035","س-04452","س-02339","س-04497","س-04498"],"ref":"تخريج المسند لشعيب 15570","srcLabel":"متفق عليه","text":[["رَوْحةٌ في سَبيلِ اللهِ ",1],["خَيرٌ مِنَ الدُّنيا وما فيها",2],"... فذكَرَ مَعناهُ. [أي مَعْنى حديثِ: لَغَدْوةٌ في سَبيلِ اللهِ -أو رَوْحةٌ- خَيرٌ من الدُّنيا وما فيها، ولَمَوضِعُ سَوطِ أحَدِكم في الجَنَّةِ خَيرٌ من الدُّنيا وما فيها]"],"grade":"صحيح","narrator":"سهل بن سعد الساعدي","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6415) باختلاف يسير، ومسلم (1881) مختصراً","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"HeCoNXc7","merged":2,"otherRefs":["تخريج المسند لشعيب 22858 (صحيح)"]},{"id":"س-04339","fp":"c8997626e293","stateId":444,"easy":"إذا غدوت أو رحت في سبيل الله ← فهو خير من الدنيا وما فيها","cause":"غَدوةٌ في سَبيلِ اللهِ أو رَوحةٌ","result":"خَيرٌ مِنَ الدُّنيا وما فيها","explicit":true,"repOf":"س-02126","ref":"صحيح البخاري 6567","text":["أنَّ أُمَّ حارِثةَ أتَت رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، وقد هَلَكَ حارِثةُ يَومَ بَدرٍ؛ أصابَه غَربُ سَهمٍ، فقالت: يا رَسولَ اللهِ، قد عَلِمتَ مَوقِعَ حارِثةَ مِن قَلبي، فإن كان في الجَنَّةِ لَم أبكِ عليه، وإلَّا سَوفَ تَرى ما أصنَعُ؟ فقال لَها: هَبِلتِ! أجَنَّةٌ واحِدةٌ هي؟ إنَّها جِنانٌ كَثيرةٌ، وإنَّه في الفِردَوسِ الأعلى. وقال: ",["غَدوةٌ في سَبيلِ اللهِ أو رَوحةٌ ",1],["خَيرٌ مِنَ الدُّنيا وما فيها",2],"، ولَقابُ قَوسِ أحَدِكُم -أو مَوضِعُ قدَمٍ- مِنَ الجَنَّةِ خَيرٌ مِنَ الدُّنيا وما فيها، ولو أنَّ امرَأةً مِن نِساءِ أهلِ الجَنَّةِ اطَّلَعَت إلى الأرضِ لَأضاءَت ما بينَهما، ولَمَلَأت ما بينَهما ريحًا، ولَنَصيفُها -يَعني الخِمارَ- خَيرٌ مِنَ الدُّنيا وما فيها."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1880) مختصراً باختلاف يسير","bab":"جنة › نساء الجنة","dorar":"gxBWRoxf","merged":3,"otherRefs":["صحيح النسائي 3118 (صحيح)","صحيح البخاري 2892 (صحيح)"]},{"id":"س-04489","fp":"2196b8ae33d8","stateId":444,"easy":"إذا رحت في سبيل الله ← يكون لك ما أصابك من الغبار مسكاً يوم القيامة","cause":"من راح رَوحةً في سَبيلِ اللهِ","result":"كان له مِثْلُ ما أصابه مِنَ الغُبارِ له مِسْكٌ يومَ القيامةِ","explicit":true,"similar":["س-00501"],"ref":"الأحاديث المختارة 2192","srcLabel":"البخاري","text":["«",["من راح رَوحةً في سَبيلِ اللهِ ",1],["كان له مِثْلُ ما أصابه مِنَ الغُبارِ له مِسْكٌ يومَ القيامةِ»",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"جهاد › فضل الجهاد","dorar":"atplZDFO"},{"id":"س-04414","fp":"b141786a4105","stateId":444,"easy":"إذا ابتغيت وجه الله وأطعت الإمام وأنفقت الكريمة وياسرت الشريك ← فنومك ويقظتك أجر كله","cause":"مَنِ ابتغى وَجهَ اللهِ، وأَطاعَ الإمامَ، وأَنفَقَ الكَريمَةَ، وياسَرَ الشَّريكَ، واجْتَنَبَ الفَسادَ","result":"فإنَّ نَومَهُ ونُبْهَه أَجرٌ كُلُّه، وأمَّا","explicit":true,"ref":"المستدرك على الصحيحين 2470","srcLabel":"مسلم","text":["الغَزوُ غَزْوانِ؛ فأمَّا ",["مَنِ ابتغى وَجهَ اللهِ، وأَطاعَ الإمامَ، وأَنفَقَ الكَريمَةَ، وياسَرَ الشَّريكَ، واجْتَنَبَ الفَسادَ؛ ",1],["فإنَّ نَومَهُ ونُبْهَه أَجرٌ كُلُّه، وأمَّا ",2],"مَنْ غَزا فَخْرًا ورياءً وسُمْعةً وعَصى الإمامَ، وأَفسَدَ في الأرضِ؛ فإنَّه لن يَرجِعَ بكَفافٍ."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أبو داوود (2515)، والنسائي (4195)، وأحمد (7182)، والبيهقي (22042) ثلاثتهم بلفظه.","bab":"جهاد › النية في القتال والغزو","dorar":"yscD087C","merged":2,"otherRefs":["السلسلة الصحيحة 1990 (حسن)"]},{"id":"س-02035","fp":"6de40f7640b3","stateId":444,"easy":"إذا غدوت أو رحت في سبيل الله ← فهو خير من الدنيا وما فيها","cause":"لَرَوحةٌ في سَبيلِ اللهِ أو غَدوةٌ","result":"خَيرٌ مِنَ الدُّنيا وما فيها","explicit":true,"repOf":"س-02126","ref":"صحيح البخاري 2796","text":[["لَرَوحةٌ في سَبيلِ اللهِ أو غَدوةٌ ",1],["خَيرٌ مِنَ الدُّنيا وما فيها",2],"، ولَقابُ قَوسِ أحَدِكُم مِنَ الجَنَّةِ، أو مَوضِعُ قِيدٍ -يَعني سَوطَه- خَيرٌ مِنَ الدُّنيا وما فيها، ولو أنَّ امرأةً مِن أهلِ الجَنَّةِ اطَّلَعَت إلى أهلِ الأرضِ لَأضاءَت ما بينَهما، ولَمَلَأته ريحًا، ولَنَصيفُها على رَأسِها خَيرٌ مِنَ الدُّنيا وما فيها."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (12436) وأبو يعلى (3775)، واللفظ لهم، ومسلم (1880) مختصرا","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"kUXOsRLy"},{"id":"ق-0187","fp":"59ee078b9ac1","stateId":444,"easy":"الاستجابة لله والرسول بعد القرح مع الإحسان والتقوى ← أجر عظيم","cause":"الاستجابة لله والرسول بعد القرح مع الإحسان والتقوى","result":"أجر عظيم","explicit":true,"ref":"سورة آل عمران: 172","srcLabel":"القرآن الكريم","quran":{"s":3,"from":172,"to":172,"text":"الَّذِينَ اسْتَجَابُوا لِلَّهِ وَالرَّسُولِ مِنْ بَعْدِ مَا أَصَابَهُمُ الْقَرْحُ لِلَّذِينَ أَحْسَنُوا مِنْهُمْ وَاتَّقَوْا أَجْرٌ عَظِيمٌ (172)","hl":[[0,139,1]]}},{"id":"ق-0231","fp":"a34ecfef6d7c","stateId":444,"easy":"القتال في سبيل الله (قُتل أو غلب) ← أجر عظيم","cause":"القتال في سبيل الله (قُتل أو غلب)","result":"أجر عظيم","explicit":true,"ref":"سورة النساء: 74","srcLabel":"القرآن الكريم","quran":{"s":4,"from":74,"to":74,"text":"فَلْيُقَاتِلْ فِي سَبِيلِ اللَّهِ الَّذِينَ يَشْرُونَ الْحَيَاةَ الدُّنْيَا بِالْآخِرَةِ وَمَنْ يُقَاتِلْ فِي سَبِيلِ اللَّهِ فَيُقْتَلْ أَوْ يَغْلِبْ فَسَوْفَ نُؤْتِيهِ أَجْرًا عَظِيمًا (74)","hl":[[89,186,1]]}},{"id":"ق-0537","fp":"421cf0493ec3","stateId":444,"easy":"تحمّل الظمأ والنصب والجوع في سبيل الله والنفقة فيه ← يُكتب به عمل صالح ولا يضيع أجر المحسنين","cause":"تحمّل الظمأ والنصب والجوع في سبيل الله والنفقة فيه","result":"يُكتب به عمل صالح ولا يضيع أجر المحسنين","explicit":true,"ref":"سورة التوبة: 120–121","srcLabel":"القرآن الكريم","quran":{"s":9,"from":120,"to":121,"text":"مَا كَانَ لِأَهْلِ الْمَدِينَةِ وَمَنْ حَوْلَهُمْ مِنَ الْأَعْرَابِ أَنْ يَتَخَلَّفُوا عَنْ رَسُولِ اللَّهِ وَلَا يَرْغَبُوا بِأَنْفُسِهِمْ عَنْ نَفْسِهِ ذَلِكَ بِأَنَّهُمْ لَا يُصِيبُهُمْ ظَمَأٌ وَلَا نَصَبٌ وَلَا مَخْمَصَةٌ فِي سَبِيلِ اللَّهِ وَلَا يَطَئُونَ مَوْطِئًا يَغِيظُ الْكُفَّارَ وَلَا يَنَالُونَ مِنْ عَدُوٍّ نَيْلًا إِلَّا كُتِبَ لَهُمْ بِهِ عَمَلٌ صَالِحٌ إِنَّ اللَّهَ لَا يُضِيعُ أَجْرَ الْمُحْسِنِينَ (120) وَلَا يُنْفِقُونَ نَفَقَةً صَغِيرَةً وَلَا كَبِيرَةً وَلَا يَقْطَعُونَ وَادِيًا إِلَّا كُتِبَ لَهُمْ لِيَجْزِيَهُمُ اللَّهُ أَحْسَنَ مَا كَانُوا يَعْمَلُونَ (121)","hl":[[154,581,1]]}},{"id":"ق-1206","fp":"826ad3d20497","stateId":444,"easy":"القتل في سبيل الله ← لا تضل أعمالهم وهدايتهم وإصلاح بالهم ودخول الجنة","cause":"القتل في سبيل الله","result":"لا تضل أعمالهم وهدايتهم وإصلاح بالهم ودخول الجنة","explicit":true,"otherNeedIds":[5,67],"ref":"سورة محمد: 4–6","srcLabel":"القرآن الكريم","quran":{"s":47,"from":4,"to":6,"text":"فَإِذَا لَقِيتُمُ الَّذِينَ كَفَرُوا فَضَرْبَ الرِّقَابِ حَتَّى إِذَا أَثْخَنْتُمُوهُمْ فَشُدُّوا الْوَثَاقَ فَإِمَّا مَنًّا بَعْدُ وَإِمَّا فِدَاءً حَتَّى تَضَعَ الْحَرْبُ أَوْزَارَهَا ذَلِكَ وَلَوْ يَشَاءُ اللَّهُ لَانْتَصَرَ مِنْهُمْ وَلَكِنْ لِيَبْلُوَ بَعْضَكُمْ بِبَعْضٍ وَالَّذِينَ قُتِلُوا فِي سَبِيلِ اللَّهِ فَلَنْ يُضِلَّ أَعْمَالَهُمْ (4) سَيَهْدِيهِمْ وَيُصْلِحُ بَالَهُمْ (5) وَيُدْخِلُهُمُ الْجَنَّةَ عَرَّفَهَا لَهُمْ (6)","hl":[[277,433,1]]}},{"id":"ق-1235","fp":"b801480b01e3","stateId":444,"easy":"الطاعة عند الدعوة إلى الجهاد ← أجر حسن","cause":"الطاعة عند الدعوة إلى الجهاد","result":"أجر حسن","explicit":true,"ref":"سورة الفتح: 16","srcLabel":"القرآن الكريم","quran":{"s":48,"from":16,"to":16,"text":"قُلْ لِلْمُخَلَّفِينَ مِنَ الْأَعْرَابِ سَتُدْعَوْنَ إِلَى قَوْمٍ أُولِي بَأْسٍ شَدِيدٍ تُقَاتِلُونَهُمْ أَوْ يُسْلِمُونَ فَإِنْ تُطِيعُوا يُؤْتِكُمُ اللَّهُ أَجْرًا حَسَنًا وَإِنْ تَتَوَلَّوْا كَمَا تَوَلَّيْتُمْ مِنْ قَبْلُ يُعَذِّبْكُمْ عَذَابًا أَلِيمًا (16)","hl":[[122,174,1]]}},{"id":"س-04452","fp":"c0a0544e6a94","stateId":444,"easy":"إذا غدوت أو رحت في سبيل الله ← فهو خير من الدنيا وما فيها","cause":"لَغَدْوةٌ أو رَوْحَةٌ","result":"خيرٌ من الدنيا وما فيها","explicit":true,"repOf":"س-02126","ref":"تخريج المسند لشاكر 4/90","text":["إنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ بعث إلى مُؤتةَ فاستعملَ زيدًا فإن قُتِلَ زيدٌ فجعفرٌ فإن قُتِلَ جعفرٌ فابنُ رواحةَ فتخلَّفَ ابنُ رواحةَ فجمعَ مع رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ فرآه فقال : ما خلَّفكَ؟ قال : أجمعُ معك قال : ",["لَغَدْوةٌ أو رَوْحَةٌ ",1],["خيرٌ من الدنيا وما فيها",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي شيبة (19649)، والطيالسي (2822) باختلاف يسير، وأبو يعلى (2506) مختصرًا.","bab":"جهاد › فضل الجهاد","dorar":"5WksJCVX","merged":2,"otherRefs":["تخريج المسند لشعيب 15570 (صحيح)"]},{"id":"س-00523","fp":"da2312b30e3a","stateId":444,"easy":"إذا غزوت وقد حججت ← فهي خير من عشر حجج","cause":"وغزوةٌ لمن قد حجَّ","result":"خيرٌ من عشرِ حججٍ","explicit":true,"otherNeedIds":[49],"ref":"الترغيب والترهيب 2/269","srcLabel":"ابن حبان","text":["حجَّةٌ لمن لم يحجَّ خيرٌ من عشرِ غزواتٍ ",["وغزوةٌ لمن قد حجَّ",1]," ",["خيرٌ من عشرِ حججٍ",2]," وغزوةٌ في البحرِ خيرٌ من عشرِ غزواتٍ في البرِّ ومن أجاز البحرَ فكأنَّما أجاز الأوديةَ كلَّها والمائدُ فيه كالمتشحِّطِ في دمِه"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن حبان في ((المجروحين)) (1/461)، والطبراني (13/654) (14581) واللفظ له، والبيهقي (8928)","bab":"آداب عامة › ضرب الأمثال","dorar":"Ws53xUp3"},{"id":"س-00524","fp":"dda145213707","stateId":444,"easy":"إذا غزوت في البحر ← فهي خير من عشر غزوات في البر","cause":"وغزوةٌ في البحرِ","result":"خيرٌ من عشرِ غزواتٍ في البرِّ","explicit":true,"otherNeedIds":[49],"ref":"الترغيب والترهيب 2/269","srcLabel":"ابن حبان","text":["حجَّةٌ لمن لم يحجَّ خيرٌ من عشرِ غزواتٍ وغزوةٌ لمن قد حجَّ خيرٌ من عشرِ حججٍ ",["وغزوةٌ في البحرِ",1]," ",["خيرٌ من عشرِ غزواتٍ في البرِّ",2]," ومن أجاز البحرَ فكأنَّما أجاز الأوديةَ كلَّها والمائدُ فيه كالمتشحِّطِ في دمِه"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن حبان في ((المجروحين)) (1/461)، والطبراني (13/654) (14581) واللفظ له، والبيهقي (8928)","bab":"آداب عامة › ضرب الأمثال","dorar":"Ws53xUp3"},{"id":"س-02339","fp":"0e553e8f3127","stateId":444,"easy":"إذا غدوت في سبيل الله ← فهو خير من الدنيا وما فيها","cause":"غَدوةٌ في سَبيلِ اللهِ","result":"خَيرٌ مِنَ الدُّنيا وما فيها","explicit":true,"repOf":"س-02126","ref":"تخريج المسند لشعيب 22858","text":["رَوحةٌ في سَبيلِ اللهِ، فذَكَرَ مَعناهُ [أي مَعنى: ",["غَدوةٌ في سَبيلِ اللهِ ",1],["خَيرٌ مِنَ الدُّنيا وما فيها",2],"، ورَوحةٌ في سَبيلِ اللهِ خَيرٌ مِنَ الدُّنيا وما فيها، ومَوضِعُ سَوطٍ في الجَنَّةِ خَيرٌ مِنَ الدُّنيا وما فيها]."],"grade":"صحيح","narrator":"سهل بن سعد","muhaddith":"إسناده صحيح على شرط الشيخين","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Ko0vUxEa"},{"id":"س-04473","fp":"d45c220d58ed","stateId":444,"easy":"إذا وقفت في الصف للقتال ← فهو خير من صلاتك ستين سنة","cause":"ولَمَقامُ أحدِكم في الصفِّ","result":"خيرٌ من صلاتِه ستِّين سنةً","explicit":true,"similar":["س-04475","س-08258","س-04360"],"ref":"صحيح الترغيب 1302","srcLabel":"الطبراني","text":[["ولَمَقامُ أحدِكم في الصفِّ ",1],["خيرٌ من صلاتِه ستِّين سنةً ",2],"."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني (8/257) (7868) مطولاً","bab":"جهاد › فضل الجهاد","dorar":"MskADHCX"},{"id":"س-04475","fp":"2084dd24cb2b","stateId":444,"easy":"إذا قمت ساعة في الصف للقتال في سبيل الله ← فهو خير من قيام ستين سنة","cause":"قِيامُ ساعةٍ في الصَّفِّ للقتالِ في سبيلِ اللهِ","result":"خيرٌ من قيامِ سِتِّينِ سَنَةً","explicit":true,"repOf":"س-04473","ref":"صحيح الجامع 4429","text":[["قِيامُ ساعةٍ في الصَّفِّ للقتالِ في سبيلِ اللهِ ",1],["خيرٌ من قيامِ سِتِّينِ سَنَةً",2]],"grade":"صحيح","narrator":"أبو هريرة وأبو سعيد الخدري وجابر بن عبدالله","muhaddith":"صحيح","bab":"جهاد › فضل الجهاد","dorar":"1YMdUHAV"},{"id":"س-04497","fp":"cb72e2bdf73c","stateId":444,"easy":"إذا رحت في سبيل الله ← فهو خير من الدنيا وما عليها","cause":"رَوحةٌ في سَبيلِ اللهِ","result":"خَيرٌ مِنَ الدُّنيا وما عليها","explicit":true,"repOf":"س-02126","ref":"تخريج المسند لشعيب 17535","text":["«هَل بَلَّغتُ؟» فظَنَنَّا أنَّه يُريدُنا، فقُلنا: نَعَم. ثُمَّ أعادَه ثَلاثَ مَرَّاتٍ، وقال فيما يَقولُ: ",["«رَوحةٌ في سَبيلِ اللهِ ",1],["خَيرٌ مِنَ الدُّنيا وما عليها",2],"، وغَدوةٌ في سَبيلِ اللهِ خَيرٌ مِنَ الدُّنيا وما عليها، وإنَّ المُؤمِنَ على المُؤمِنِ حَرامٌ: عِرضُه ومالُه ونَفسُه، حَرَّمه كما حَرَّمَ هذا اليَومَ»."],"grade":"صحيح","narrator":"سفيان بن وهب الخولاني","muhaddith":"صحيح لغيره","bab":"جهاد › فضل الجهاد","dorar":"9C5fxLST"},{"id":"س-04498","fp":"c5986cc18156","stateId":444,"easy":"إذا غدوت في سبيل الله ← فهو خير من الدنيا وما عليها","cause":"وغَدوةٌ في سَبيلِ اللهِ","result":"خَيرٌ مِنَ الدُّنيا وما عليها","explicit":true,"repOf":"س-02126","ref":"تخريج المسند لشعيب 17535","text":["«هَل بَلَّغتُ؟» فظَنَنَّا أنَّه يُريدُنا، فقُلنا: نَعَم. ثُمَّ أعادَه ثَلاثَ مَرَّاتٍ، وقال فيما يَقولُ: «رَوحةٌ في سَبيلِ اللهِ خَيرٌ مِنَ الدُّنيا وما عليها، ",["وغَدوةٌ في سَبيلِ اللهِ ",1],["خَيرٌ مِنَ الدُّنيا وما عليها",2],"، وإنَّ المُؤمِنَ على المُؤمِنِ حَرامٌ: عِرضُه ومالُه ونَفسُه، حَرَّمه كما حَرَّمَ هذا اليَومَ»."],"grade":"صحيح","narrator":"سفيان بن وهب الخولاني","muhaddith":"صحيح لغيره","bab":"جهاد › فضل الجهاد","dorar":"9C5fxLST"},{"id":"س-08258","fp":"0c6fa2922432","stateId":444,"easy":"إذا وقفت ساعة في سبيل الله ← فهو خير من قيام ليلة القدر عند الحجر الأسود","cause":"موقِفُ ساعةٍ في سبيلِ اللهِ","result":"خيرٌ مِن قيامِ ليلةِ القدرِ عندَ الحجَرِ الأسودِ","explicit":true,"repOf":"س-04473","otherNeedIds":[49],"ref":"تخريج صحيح ابن حبان 4603","text":["أنَّه كان في الرِّباطِ ففزِعوا إلى السَّاحلِ ثمَّ قيل: لا بأسَ فانصرَف النَّاسُ وأبو هُريرةَ واقفٌ فمرَّ به إنسانٌ فقال: ما يوقِفُك يا أبا هُريرةَ فقال: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["( موقِفُ ساعةٍ في سبيلِ اللهِ ",1],["خيرٌ مِن قيامِ ليلةِ القدرِ عندَ الحجَرِ الأسودِ )",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (4603)، وعباس الترقفي في ((حديثه)) (15)، والبيهقي في ((شعب الإيمان)) (3981) جميعا بلفظه.","bab":"مناقب وفضائل › أبو هريرة","dorar":"6qnsb6ng"},{"id":"س-00501","fp":"50db68e6ea3c","stateId":444,"easy":"إذا غدوت أو رحت في سبيل الله ← يكون لك مثل ما أصابك من الغبار مسكاً يوم القيامة","cause":"من راح رَوْحتَه في سبيلِ اللهِ","result":"كان له بمثلِ ما أصابه من الغبارِ مِسكًا يومَ القيامةِ","explicit":true,"repOf":"س-04489","ref":"السلسلة الصحيحة 2338","text":[["من راح رَوْحتَه في سبيلِ اللهِ ، ",1],["كان له بمثلِ ما أصابه من الغبارِ مِسكًا يومَ القيامةِ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن ماجه (2775)، والبزار (7517)، والطبراني في ((المعجم الأوسط)) (1359) باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"gS93iUWV"},{"id":"س-04360","fp":"de67d98ca40b","stateId":444,"easy":"إذا وقفت في سبيل الله ← فهو خير من عبادتك في أهلك ستين سنة","cause":"مُقامُ أحدِكم -يَعني في سَبيلِ اللهِ","result":"خَيرٌ مِن عِبادَةِ أحدِكم في أهلِه سِتِّين سَنةً","explicit":true,"repOf":"س-04473","ref":"تخريج المسند لشعيب 9762","text":["أنَّ رَجُلًا مِن أصحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ مَرَّ بشِعْبٍ فيه عَينٌ عَذبةٌ، قال: فأَعجَبَه، يَعني طيبُ الشِّعبِ، فقال: لو أقمتُ هاهنا وخلَوتُ. ثم قال: لا، حتى أسأَلَ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ. فسأَلَه، فقال: ",["مُقامُ أحدِكم -يَعني في سَبيلِ اللهِ- ",1],["خَيرٌ مِن عِبادَةِ أحدِكم في أهلِه سِتِّين سَنةً",2],"، أمَا تُحِبُّون أنْ يَغفِرَ اللهُ لكم، وتَدخُلونَ الجنَّةَ؟ جاهِدوا في سَبيلِ اللهِ، مَن قاتَلَ في سَبيلِ اللهِ فُواقَ ناقةٍ، وجَبَتْ له الجنَّةُ."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه الترمذي (1650)، وأحمد (9762) واللفظ له","bab":"جهاد › الترغيب في الجهاد","dorar":"iTudkKHZ"},{"id":"س-08091","fp":"d21e32b207c5","stateId":444,"easy":"إذا غزوت وقد حججت ← فهي أفضل من أربعين حجة","cause":"غَزوَةٌ لمَن قد حَجَّ","result":"أفضَلُ من أرْبَعينَ حَجَّةً","explicit":true,"otherNeedIds":[49],"ref":"تخريج المراسيل لأبي داود 304","srcLabel":"أبو داود","text":["أكثَرَ المُسْتأذِنونَ إلى الحَجِّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَومَ غَزوَةِ تَبوكَ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["غَزوَةٌ لمَن قد حَجَّ ",1],["أفضَلُ من أرْبَعينَ حَجَّةً",2],"."],"grade":"حسن","narrator":"مكحول","muhaddith":"رجاله ثقات وإسماعيل بن عياش: صدوق في روايته عن أهل بلده وهذا منها فإن هشام بن الغاز دمشقي","takhrij":"أخرجه أبو داود في ((المراسيل)) (304)","bab":"مغازي › غزوة تبوك","dorar":"3o0wTTUf"},{"id":"س-02015","fp":"4c620177a051","stateId":444,"easy":"إذا غزوت فلم تصب غنيمة ← تم لك أجرك","cause":"فإنْ لمْ يُصيبوا غَنيمةً","result":"تَمَّ لهم أَجرُهُم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"المستدرك على الصحيحين 2449","srcLabel":"مسلم","text":["ما مِن غازِيةٍ تَغْزو في سَبيلِ اللهِ، فيُصيبونَ غَنيمةً؛ إلَّا تَعَجَّلوا ثُلُثي أَجرِهم مِنَ الآخرةِ، ويَبْقى لهُم الثُّلثُ، ",["فإنْ لمْ يُصيبوا غَنيمةً",1],"؛ ",["تَمَّ لهم أَجرُهُم",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه مسلم (1906)، وأبو داود (2497)، وأحمد (3125) جميعهم بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"fEHlgtHz"},{"id":"س-04415","fp":"de8e35b4dcde","stateId":444,"easy":"إذا غزوت فأخفقت وأُصبت ← تم أجرك","cause":"وما من غازيةٍ أو سريَّةٍ تُخفِقُ وتُصاب","result":"إلا تمَّ أجرُهم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الترغيب 1337","srcLabel":"مسلم","text":["ما من غازيةٍ أو سريَّةٍ تغزو في سبيلِ اللهِ فيسلمون ويصيبون ؛ إلا [ كانوا قد ] تعجَّلوا ثُلُثَي أجرِهم ، ",["وما من غازيةٍ أو سريَّةٍ تُخفِقُ وتُصاب ؛ ",1],["إلا تمَّ أجرُهم ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1906) باختلاف يسير.","bab":"جهاد › النية في القتال والغزو","dorar":"G3tfSqWN"},{"id":"س-00639","fp":"cd2c0ea0162b","stateId":444,"easy":"إذا غزوت وأخذت الجُعل ← فلك أجرك كأم موسى ترضع ولدها وتأخذ أجرها","cause":"الذين يَغْزون من أُمَّتي وَيَأْخُذون الْجُعَلَ","result":"مَثَلُ أُمِّ موسى تُرضِعُ وَلَدَها وَتَأخُذُ أجْرَها","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"تخريج المراسيل لأبي داود 332","srcLabel":"أبو داود","text":["مَثَلُ ",["الذين يَغْزون من أُمَّتي وَيَأْخُذون الْجُعَلَ",1]," -يعني يَتَقَوَّوْن على عَدُوِّهم- ",["مَثَلُ أُمِّ موسى تُرضِعُ وَلَدَها وَتَأخُذُ أجْرَها",2],"."],"grade":"حسن","narrator":"جبير بن نفير","muhaddith":"رجاله ثقات غير معدان فإنه لم يوثق","takhrij":"أخرجه ابن أبي شيبة (19881)، وأبو داود في ((المراسيل)) (332)، والبيهقي (18296)","bab":"آداب عامة › ضرب الأمثال","dorar":"WdLEOEAz"},{"id":"س-08321","fp":"694681b04428","stateId":445,"easy":"إذا أعطيت أقاربك (أخوالك) بدل العتق ← كان أعظم لأجرك","cause":"لو كنتِ أعطيتِها أخوالَكِ","result":"كانَ أعظَمَ لأجرِكِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[41,47,39],"ref":"صحيح أبي داود 1690","srcLabel":"متفق عليه","text":["عن ميمونةَ ، زوجِ النَّبيِّ صلَّى اللَّهُ علَيهِ وسلَّمَ قالَ : كانت لي جاريةٌ فأعتقتُها ، فدخلَ عليَّ النَّبيُّ صلَّى اللَّهُ علَيهِ وسلَّمَ ، فأخبرتُهُ ، فقالَ : آجرَكِ اللَّهُ ، أما إنَّكِ ",["لو كنتِ أعطيتِها أخوالَكِ",1]," ",["كانَ أعظَمَ لأجرِكِ",2]],"grade":"صحيح","narrator":"ميمونة بنت الحارث أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1690)، والنسائي في ((السنن الكبرى)) (4911) واللفظ لهما، والبخاري (2592)، ومسلم (999)، وابن حبان (236) بنحوه.","bab":"مناقب وفضائل › فضائل أزواج النبي صلى الله عليه وسلم","dorar":"lTFkH96P","merged":4,"otherRefs":["مجمع الزوائد 8/156 (صحيح)","المحلى 9/337 (صحيح)","شرح معاني الآثار 4/353 (صحيح)"]},{"id":"س-08071","fp":"f20bfb7a2553","stateId":445,"easy":"إذا وصلت رحمك ← فهي أعجل الطاعة ثواباً","cause":"لصلَةُ الرَّحِمِ","result":"وإنَّ أَعجلَ الطاعةِ ثوابًا","explicit":true,"otherNeedIds":[39],"ref":"صحيح الجامع 5705","srcLabel":"أبو داود","text":["ما من ذنبٍ أجدرُ أن يُعجِّلَ اللهُ تعالى لصاحبِه العقوبةَ في الدنيا ، مع ما يَدِّخِرُه له في الآخرةِ من قطيعةِ الرَّحِمِ ، والخيانةِ ، والكذبِ ، ",["وإنَّ أَعجلَ الطاعةِ ثوابًا",2]," ",["لصلَةُ الرَّحِمِ",1]," ، حتى إنَّ أهلَ البيتِ ليكونوا فجَرةً ، فتنمو أموالُهم ، ويكثُرُ عددُهم ، إذا تواصَلوا"],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4902)، والترمذي (2511)، وابن ماجه (4211)، وأحمد (20374) مختصراً، وابن حبان (440، 455) مفرقاً باختلاف يسير.","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"YEtGOzfj","merged":4,"otherRefs":["شرح مسند أبي حنيفة 535 (حسن)","فيض القدير 1017 (حسن)","السلسلة الصحيحة 978 (صحيح)"]},{"id":"س-06262","fp":"5580013f80d3","stateId":445,"easy":"إذا تصدقت على ذي رحمك ← فهي صدقة وصلة","cause":"صدَقتُكَ على المسلمينَ صدَقةٌ وعلى ذي الرَّحِمِ","result":"صدَقةٌ وصِلةٌ","explicit":true,"similar":["س-02001"],"ref":"حلية الأولياء 8/205","srcLabel":"الترمذي","text":[["صدَقتُكَ على المسلمينَ صدَقةٌ وعلى ذي الرَّحِمِ ",1],["صدَقةٌ وصِلةٌ",2]],"grade":"صحيح","narrator":"سلمان بن عامر الضبي","muhaddith":"ثابت مشهور","takhrij":"أخرجه الترمذي (658) والنسائي (2582) وأبو طاهر السلفي في ((الأربعون البلدانية)) (ص105) باختلاف يسير.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"BDevY4OO","merged":2,"otherRefs":["صحيح الجامع 3763 (صحيح)"]},{"id":"س-02001","fp":"cf70f43f5a14","stateId":445,"easy":"إذا تصدقت على قريبك ← فلك أجران: صدقة وصلة","cause":"الصَّدقةُ على المِسكينِ","result":"صدقةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-06262","ref":"صحيح ابن خزيمة 3/ 482","text":[["الصَّدقةُ على المِسكينِ ",1],["صدقةٌ",2],"، وَهيَ على القَريبِ صدَقتانِ، صدقةٌ، وصلةٌ وقالَ صلَّى اللَّهُ عليهِ وسلَّمَ: إذا أفطرَ أحدُكُم فليفطِرْ على تمرٍ، فإنهُ بركةٌ فإن لم يجد فماءٌ، فإنَّهُ طَهورٌ وقالَ صلَّى اللَّهُ عليهِ وسلَّمَ: اذبَحوا عنِ الغُلامِ عقيقتَهُ، وأَميطوا عنهُ الأذَى، وأَهْريقوا عنهُ دمًا [وفي روايةٍ]: قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: إذا أفطرَ أحدُكُم فليُفطِر على تمرٍ، فإن لم يجد فليُفطِر على ماءٍ، فإنَّهُ طَهورٌ. ولم [تذكر] قصَّةُ الصَّدقةِ ولا العقيقةِ."],"grade":"صحيح","narrator":"سلمان بن عامر الضبي","muhaddith":"أخرجه في صحيحه","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"0fP7SpFp","merged":4,"otherRefs":["تخريج المسند لشعيب 16235 (صحيح)","تخريج المسند لشعيب 17883 (صحيح)","تخريج المسند لشعيب 17877 (صحيح)"]},{"id":"س-04718","fp":"f1aae3dfa052","stateId":446,"easy":"إذا أنفقت نفقة تبتغي وجه الله ← تؤجر حتى في اللقمة تضعها في فم امرأتك","cause":"ولَستَ تُنفِقُ نَفَقةً تَبتَغي بها وجهَ اللهِ","result":"إلَّا أُجِرتَ بها، حتَّى اللُّقمةُ تَجعَلُها في في امرَأتِكَ","explicit":true,"star":true,"otherNeedIds":[37,47],"ref":"صحيح مسلم 1628","srcLabel":"البخاري","text":["عادَني رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم في حَجَّةِ الوداعِ مِن وجَعٍ أشفَيتُ منه على المَوتِ، فقُلتُ: يا رَسولَ اللهِ، بَلَغَني ما تَرى مِنَ الوجَعِ، وأنا ذو مالٍ، ولا يَرِثُني إلَّا ابنةٌ لي واحِدةٌ، أفَأتَصَدَّقُ بثُلُثَي مالي؟ قال: لا، قال: قُلتُ: أفَأتَصَدَّقُ بشَطرِه؟ قال: لا، الثُّلُثُ، والثُّلُثُ كَثيرٌ، إنَّكَ أن تَذَرَ ورَثَتَكَ أغنياءَ خَيرٌ مِن أن تَذَرَهُم عالةً يَتَكَفَّفونَ النَّاسَ، ",["ولَستَ تُنفِقُ نَفَقةً تَبتَغي بها وجهَ اللهِ",1]," ",["إلَّا أُجِرتَ بها، حتَّى اللُّقمةُ تَجعَلُها في في امرَأتِكَ",2],"، قال: قُلتُ: يا رَسولَ اللهِ، أُخَلَّفُ بَعدَ أصحابي! قال: إنَّكَ لَن تُخَلَّفَ فتَعمَلَ عَمَلًا تَبتَغي به وجهَ اللهِ إلَّا ازدَدتَ به دَرَجةً ورِفعةً، ولَعَلَّكَ تُخَلَّفُ حتَّى يُنفَعَ بكَ أقوامٌ، ويُضَرَّ بكَ آخَرونَ، اللَّهُمَّ أمضِ لأصحابي هِجرَتَهُم ولا تَرُدَّهُم على أعقابِهم، لَكِنِ البائِسُ سَعدُ بنُ خَولةَ! قال: رَثى له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم مِن أن توفِّيَ بمَكَّةَ. [وفي روايةٍ]: ولَم يَذكُرْ قَولَ النَّبيِّ صلَّى اللهُ عليه وسلَّم في سَعدِ بنِ خَولةَ، غيرَ أنَّه قال: وكان يَكرَهُ أن يَموتَ بالأرضِ التي هاجَرَ منها."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4409)، والترمذي (2116)، وأحمد (1546) واللفظ لهم.","bab":"رقائق وزهد › الإخلاص","dorar":"IohMWWm6","merged":7,"otherRefs":["تخريج صحيح ابن حبان 7261 (صحيح)","صحيح أبي داود 2864 (صحيح)","مجموع الفتاوى 10/31 (صحيح)","صحيح البخاري 5354 (صحيح)","تخريج المسند لشاكر 3/46 (صحيح)","تخريج المسند لشاكر 3/73 (صحيح)"]},{"id":"س-02650","fp":"a903285886d7","stateId":446,"easy":"إذا أنفقت على أهلك محتسباً ← فهي لك صدقة","cause":"إذا أنفَقَ المُسلِمُ نَفَقةً على أهلِه وهو يَحتَسِبُها","result":"كانَت له صَدَقةً","explicit":true,"ref":"صحيح البخاري 5351","srcLabel":"متفق عليه","text":[["إذا أنفَقَ المُسلِمُ نَفَقةً على أهلِه وهو يَحتَسِبُها، ",1],["كانَت له صَدَقةً",2],"."],"grade":"صحيح","narrator":"أبو مسعود عقبة بن عمرو","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5351)، ومسلم (1002)","bab":"إيمان › الاحتساب والنية","dorar":"avBRrUuU","merged":4,"otherRefs":["صحيح مسلم 1002 (صحيح)","صحيح الأدب المفرد 576 (صحيح)","مجموع الفتاوى 32/212 (صحيح)"]},{"id":"س-07952","fp":"acc908f9f6ca","stateId":446,"easy":"إذا أنفقت على نفسك أو أهلك أو عدت مريضاً ← فالحسنة بعشر أمثالها","cause":"ومَن أَنفَقَ على نفْسِه أو على أهْلِه أو عادَ مَريضًا","result":"فالحَسَنةُ بعَشْرِ أمْثالِها","explicit":true,"ref":"الأحاديث المختارة 1117","srcLabel":"البخاري","text":["«دَخَلْنا على أبي عُبَيْدةَ بنِ الجَرَّاحِ نَعودُه ووَجْهُه مِن قِبَلِ الجِدارِ، وامْرَأتُه تُحَيْفةُ جالِسةٌ، فقُلْتُ: كيف باتَ أبو عُبَيْدةَ؟ فقالَتْ: باتَ بأجْرٍ، فسَمِعَ قَوْلَها، فقالَ: ما باتَ بأجْرٍ، وأَقبَلَ بوَجْهِه، فقالَ: أَلَا تَسْألوني عمَّا قُلْتُ؟ فقالوا: أَمَا أَعجَبَنا ما قُلْتَ، فكيف نَسأَلُك عنه؟ فقالَ: إنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: مَن أَنفَقَ نَفَقةً فاضِلةً في سَبيلِ اللهِ فبِسبعِمِئةٍ، ",["ومَن أَنفَقَ على نفْسِه أو على أهْلِه أو عادَ مَريضًا",1]," ",["فالحَسَنةُ بعَشْرِ أمْثالِها",2],"»."],"grade":"صحيح","narrator":"أبو عبيدة بن الجراح","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"XrzbQVCG"},{"id":"س-01306","fp":"52fce1a2ce11","stateId":446,"easy":"إذا أطعمت نفسك ← فهو لك صدقة","cause":"وما أطعمتَ نفْسَكَ","result":"فهو لكَ صدَقَةٌ","explicit":true,"ref":"صحيح الجامع 5535","srcLabel":"النسائي","text":["ما أطعمْتَ زوجتَكَ فهو لَكَ صدَقَةٌ ، وما أطعَمْتَ ولدَكَ فهو لَكَ صدَقَةٌ ، وما أطعَمْتَ خادِمَكَ فهو لَكَ صدقةٌ ، ",["وما أطعمتَ نفْسَكَ",1]," ",["فهو لكَ صدَقَةٌ",2]],"grade":"صحيح","narrator":"المقدام بن معدي كرب","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9185)، وأحمد (17179) باختلاف يسير، والطبراني في ((مسند الشاميين)) (1124) واللفظ له","bab":"نكاح › حسن العشرة بين الأزواج","dorar":"Kk33914x","merged":2,"otherRefs":["صحيح الأدب المفرد 143 (صحيح)"]},{"id":"س-06347","fp":"befa4120128c","stateId":446,"easy":"إذا أنفقت على نفسك نفقة تستعف بها ← فهي صدقة","cause":"مَن أنفقَ على نفسِهِ نفقَةً يستَعِفُّ بها","result":"فهي صدَقَةٌ","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 2/65","srcLabel":"الطبراني","text":[["مَن أنفقَ على نفسِهِ نفقَةً يستَعِفُّ بها ",1],["فهي صدَقَةٌ ، ",2],"مَن أنفَقَ على امرأتِهِ وولدِهِ وأهلِ بيتِهِ فهيَ صَدقَةٌ"],"grade":"حسن","narrator":"[أبو أمامة الباهلي]","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (3897) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (2/7).","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"xZktfFbP"},{"id":"س-06360","fp":"0772c0ba8146","stateId":446,"easy":"إذا أنفقت على أهلك ← فهي أعظم أجراً من سائر النفقات","cause":"الذي أنفقْتَهُ على أهلِكَ","result":"أعظمُهما أجرًا","explicit":true,"star":true,"otherNeedIds":[37,47],"ref":"صحيح الجامع 3398","srcLabel":"مسلم","text":["دينارٌ أنفقْتَهُ في سبيلِ اللهِ ، ودينارٌ أنفقتَهُ في رقَبَةٍ ، و دينارٌ تصدقْتَ بِهِ على مسكينٍ ، ودينارٌ أنفقتَهُ على أهلِكَ ، ",["أعظمُهما أجرًا",2]," ",["الذي أنفقْتَهُ على أهلِكَ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (995)","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"IVmUUpRz","merged":3,"otherRefs":["صحيح الجامع 878 (صحيح)","تخريج المسند لشعيب 10119 (صحيح)"]},{"id":"س-06356","fp":"dc3becbce84c","stateId":446,"easy":"إذا أنفقت على عيالك ← فهي صدقة","cause":"و إنَّ نفقَتَكَ على عِيالِكَ","result":"صدقةٌ","explicit":true,"star":true,"similar":["س-01821","س-06074","س-05917","س-06348"],"otherNeedIds":[37],"ref":"صحيح الجامع 3081","srcLabel":"متفق عليه","text":["الثُّلُثُ و الثُّلُثُ كثيرٌ ، إنَّ صدَقتَكَ من مالِكَ صدقةٌ ، ",["و إنَّ نفقَتَكَ على عِيالِكَ",1]," ",["صدقةٌ",2]," ، و إنَّ ما تأْكلُ امرأتُكَ من مالِكَ صدقةٌ ، و إنَّكَ أنْ تدَعَ أهلَكَ بِخيرٍ خيرٌ من أنْ تدَعَهمْ يتَكَفَّفُونَ النّاسَ"],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1295)، ومسلم (1628)، وأبو داود (2864)، والترمذي (2116) واللفظ لهم.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"8T526meL"},{"id":"س-06330","fp":"2beff74183e6","stateId":446,"easy":"إذا أنفقت على عيال صغار تعفّهم وتغنيهم ← فلا أحد أعظم أجراً منك","cause":"وأيُّ رجلٍ","result":"أعظَمُ أجرًا مِن رجلٍ يُنفِقُ على عيالٍ له صغارٍ يُعِفُّهم اللهُ به ويُغنيهم اللهُ به","explicit":true,"otherNeedIds":[1],"ref":"تخريج صحيح ابن حبان 4242","srcLabel":"مسلم","text":["أفضلُ دينارٍ دينارٌ يُنفِقُه الرَّجلُ على عيالِه ودينارٌ يُنفِقُه الرَّجلُ على دابَّتِه في سبيلِ اللهِ ودينارٌ يُنفِقُه رجلٌ على أصحابِه في سبيلِ اللهِ ) \nقال أبو قِلابةَ: بدَأ بالعيالِ ثمَّ قال: ",["وأيُّ رجلٍ ",1],["أعظَمُ أجرًا مِن رجلٍ يُنفِقُ على عيالٍ له صغارٍ يُعِفُّهم اللهُ به ويُغنيهم اللهُ به",2]],"grade":"صحيح","narrator":"ثوبان","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن حبان (4242)، والترمذي (1966) واللفظ لهما، ومسلم (994) باختلاف يسير.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"ngqZjkJs","merged":2,"otherRefs":["المقاصد الحسنة 424 (صحيح)"]},{"id":"س-00108","fp":"5b0b9989a021","stateId":446,"easy":"إذا كسبت مالاً حلالاً فأطعمت نفسك وكسوتها ومن دونك ← يكون لك زكاة","cause":"أيُّما رجلٍ كسَب مالًا مِن حلالٍ، فأطعَم نفسَه","result":"وكساها فمَن دونَه مِن خلقِ اللهِ تعالى ؛ فإنها له زكاةٌ","explicit":true,"ref":"الجامع الصغير 2935","srcLabel":"مسلم","text":[["أيُّما رجلٍ كسَب مالًا مِن حلالٍ، فأطعَم نفسَه، ",1],["وكساها فمَن دونَه مِن خلقِ اللهِ تعالى ؛ فإنها له زكاةٌ،  ",2],"وأيُّما رجلٍ مسلمٍ لم تكُنْ له صدقةٌ فليقُلْ في دعائِه : اللهم صلِّ على محمدٍ عبدِكَ ورسولِكَ،  وصلِّ على المؤمنينَ والمؤمناتِ، والمسلمينَ والمسلماتِ، فإنَّها له زكاةٌ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (4236) دون قوله:(( وأيما رجل مسلم...))، والحاكم (7352)، والبيهقي في ((شعب الإيمان)) (1176) جميعا بلفظه.","bab":"آداب الدعاء › الصلاة على النبي صلى الله عليه وسلم في الدعاء","dorar":"VxUOWs9Q"},{"id":"س-01821","fp":"a3f4cfe551a6","stateId":446,"easy":"إذا أنفقت على نفسك وأهلك وولدك وخادمك ← فهو صدقة","cause":"وَمَا أنَفَقَ الرَّجُلُ عَلَى نَفْسِهِ ، وأهْلِهِ ، ووَلَدِهِ ، وخادِمِهِ","result":"فهو صدقَةٌ","explicit":true,"repOf":"س-06356","otherNeedIds":[37],"ref":"صحيح الجامع 5660","text":["ما كسَبَ الرُّجُلُ كسْبًا أَطْيَبَ مِنْ عَمَلِ يَدِهِ ، ",["وَمَا أنَفَقَ الرَّجُلُ عَلَى نَفْسِهِ ، وأهْلِهِ ، ووَلَدِهِ ، وخادِمِهِ",1]," ، ",["فهو صدقَةٌ",2]],"grade":"صحيح","narrator":"المقدام بن معدي كرب","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (2138) واللفظ له، وأحمد (17190) مختصراً","bab":"إجارة › كسب الرجل وعمله بيده","dorar":"pD60CbUZ","merged":3,"otherRefs":["الجامع الصغير 7825 (حسن)","صحيح البخاري 55 (صحيح)"]},{"id":"س-06074","fp":"13e3dce17ff6","stateId":446,"easy":"إذا أنفقت على نفسك وأهلك ← تُكتب لك صدقة","cause":"وما أنفَقَ المسلِمُ من نفقتِه على نفسِه وأهلِه","result":"كُتِب له بها صَدَقةٌ","explicit":true,"repOf":"س-06356","otherNeedIds":[37],"ref":"عارضة الأحوذي 3/325","text":["كلُّ معروفٍ صدقَةٌ [",["وما أنفَقَ المسلِمُ من نفقتِه على نفسِه وأهلِه",1],"، ",["كُتِب له بها صَدَقةٌ",2],"، وما وقى به المرءُ المسلِمُ عِرضَه كُتِب له به صَدَقةٌ، وكُلُّ نَفَقةٍ أنفقها المسلِمُ فعلى اللهِ خَلَفُها ضامِنًا، إلَّا نَفَقةً في بنيانٍ أو معصيةٍ\". قال: فقلتُ لابنِ المنكَدِرِ: ما قولُه: \"وما وقى به المرءُ المُسلِمُ عِرضَه\"؟ قال: أن يعطِيَ الشَّاعِرَ وذا اللِّسانِ]"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه البيهقي (21172), وعبد بن حميد في ((مسنده)) (1081), وابن عدي في ((الكامل))  (8/ 180) واللفظ لهم.","bab":"رقائق وزهد › ما جاء في فعل الخير","dorar":"s0svCHUS","merged":3,"otherRefs":["المستدرك على الصحيحين 2346 (صحيح)","تخريج شرح السنة 1646 (صحيح)"]},{"id":"س-07688","fp":"3040c2ae46c6","stateId":446,"easy":"إذا أنفقت ديناراً على عيالك ← فهو أعظم أجراً من غيره","cause":"دِينارِ يُنفِقُه على عِيالِه","result":"ليْس دِينارٌ يُنفِقُه رجُلٌ بأعظَمَ أجرًا","explicit":true,"otherNeedIds":[37,47],"ref":"المستدرك على الصحيحين 8610","srcLabel":"الحاكم","text":["إنَّ ربِّي زَوى لي الأرضَ، حتَّى رَأيتُ مَشارِقَها ومَغاربَها، وأعْطاني الكَنزينِ الأحمرَ والأبيضَ، وإنَّ أُمَّتي سيَبلُغُ مُلكُها ما زَوى لي منها، وإنِّي سَألتُ ربِّي لِأُمَّتي ألَّا يُهلِكَها بسَنةٍ عامَّةٍ فأعْطانِيها، وسَألتُه ألَّا يُسلِّطَ عليهم عدُوًّا مِن غيرِهم، فأعْطانِيها، وسَألتُه ألَّا يُذِيقَ بعْضَهم بأْسَ بعضٍ فمَنَعْنِيها، وقال: يا محمَّدُ، إنِّي إذا قضَيتُ قَضاءً لم يُرَدَّ؛ إنِّي أعْطَيْتُك لِأُمَّتِك ألَّا أُهْلِكَها بسَنةٍ عامَّةٍ، ولا أُظهِرَ عليهم عدُوًّا مِن غيْرِهم، فيَسْتبيحَهم بعامَّةٍ، ولوِ اجتَمَع مَن بأقطارِها حتَّى يكونَ بعضُهم هو يُهلِكُ بعضًا، هو يَسْبي بعضًا، وإنِّي لا أخافُ على أُمَّتي إلَّا الأئمَّةَ المُضِلِّين، ولنْ تقومَ السَّاعةُ حتَّى تَلحَقَ قَبائلُ مِن أُمَّتي بالمشْرِكين، وحتَّى تَعبُدَ قَبائلُ مِن أُمَّتي الأوثانَ، وإذا وُضِع السَّيفُ في أُمَّتي، لم يُرفَعْ عنها إلى يَومِ القيامةِ. وأنَّه قال كلَّ ما يُوجَدُ في مائةِ سَنةٍ، وسيَخرُجُ في أُمَّتي كذَّابون ثَلاثون، كلُّهم يَزعُمُ أنَّه نَبيٌّ، وأنا خاتمُ الأنبياءِ، لا نَبيَّ بَعْدي، ولكنْ لا تَزالُ في أُمَّتي طائفةٌ يُقاتِلون على الحقِّ ظاهِرِين، لا يَضُرُّهم مَن خَذَلَهم، حتَّى يَأتيَ أمرُ اللهِ. قال: وزعَمَ أنَّه لا يَنزِعُ رجُلٌ مِن أهلِ الجنَّةِ مِن ثَمرِها شَيئًا إلَّا أخْلَفَ اللهُ مَكانَها مِثلَها، وأنه قال: ",["ليْس دِينارٌ يُنفِقُه رجُلٌ بأعظَمَ أجرًا",2]," مِن ",["دِينارِ يُنفِقُه على عِيالِه",1],"، ثمَّ دِينارٌ يُنفِقُه على فَرَسهِ في سَبيلِ اللهِ، ثمَّ دِينارٌ يُنفِقُه على أصحابِه في سَبيلِ اللهِ. قال: وزعَمَ أنَّ نَبيَّ اللهِ صلَّى اللهُ عليه وسلَّمَ عظَّمَ شأْنَ المسألةِ، وأنَّه إذا كان يَومُ القيامةِ جاء أهلُ الجاهليَّةِ يَحمِلون أوثانَهم على ظُهورِهم، فيَسْألُهم ربُّهم عزَّ وجلَّ: ما كُنتُم تَعبُدون؟ فيَقولُون: ربَّنا، لم تُرسِلْ إلينا رسولًا، ولم يَأْتِنا أمرٌ، ولوْ أرسَلْتَ إلينا رَسولًا لَكُنَّا أطوَعَ عِبادِكَ لكَ، فيَقولُ لهم ربُّهم: أرأيتُم إنْ أمَرْتُكم بأمرٍ، أتُطِيعوني؟ قال: فيَقولُون: نعمْ. قال: فيَأخُذُ مَواثيقَهم على ذلكَ، فيَأمُرُهم أنْ يَعمَدوا لِجَهنَّمَ فيَدْخُلونَها، قال: فيَنطَلِقون، حتَّى إذا جاؤوها رَأَوا لها تَغيُّظًا وزَفيرًا، فهابُوا فرَجَعوا إلى ربِّهم، فقالوا: ربَّنا فَرِقْنا منها، فيَقولُ: ألمْ تُعْطوني مَواثيقَكُم لَتُطِيعوني، اعْمَدوا لها فادْخُلوا، فيَنطَلِقون حتَّى إذا رَأَوها فَرِقوا فرَجَعوا، فقالوا: ربَّنا، لا نَستطيعُ أنْ نَدخُلَها، قال: فيَقولُ: ادْخُلوها داخِرينَ، قال: فقال نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ: لوْ دَخَلوها أوَّلَ مرَّةٍ كانت عليهم بَرْدًا وسَلامًا."],"grade":"صحيح","narrator":"ثوبان","muhaddith":"صحيح على شرط الشيخين، ولم يخرجاه بهذه السياقة","bab":"قدر › وقوع قدر الله وقضائه","dorar":"kWv97jSt","merged":3,"otherRefs":["تخريج المسند لشعيب 22380 (صحيح)","تخريج صحيح ابن حبان 4242 (صحيح)"]},{"id":"س-01305","fp":"58845ca5abe1","stateId":446,"easy":"إذا أطعمت خادمك ← فهو لك صدقة","cause":"وما أطعَمْتَ خادِمَكَ","result":"فهو لَكَ صدقةٌ","explicit":true,"similar":["س-01303","س-01304","س-01331","س-06377"],"otherNeedIds":[37],"ref":"صحيح الجامع 5535","srcLabel":"النسائي","text":["ما أطعمْتَ زوجتَكَ فهو لَكَ صدَقَةٌ ، وما أطعَمْتَ ولدَكَ فهو لَكَ صدَقَةٌ ، ",["وما أطعَمْتَ خادِمَكَ",1]," ",["فهو لَكَ صدقةٌ",2]," ، وما أطعمتَ نفْسَكَ فهو لكَ صدَقَةٌ"],"grade":"صحيح","narrator":"المقدام بن معدي كرب","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9185)، وأحمد (17179) باختلاف يسير، والطبراني في ((مسند الشاميين)) (1124) واللفظ له","bab":"نكاح › حسن العشرة بين الأزواج","dorar":"Kk33914x","merged":2,"otherRefs":["صحيح الأدب المفرد 143 (صحيح)"]},{"id":"س-01303","fp":"b2f3901baa12","stateId":446,"easy":"إذا أطعمت زوجتك ← فهو لك صدقة","cause":"ما أطعمْتَ زوجتَكَ","result":"فهو لَكَ صدَقَةٌ","explicit":true,"repOf":"س-01305","otherNeedIds":[37],"ref":"صحيح الجامع 5535","text":[["ما أطعمْتَ زوجتَكَ",1]," ",["فهو لَكَ صدَقَةٌ",2]," ، وما أطعَمْتَ ولدَكَ فهو لَكَ صدَقَةٌ ، وما أطعَمْتَ خادِمَكَ فهو لَكَ صدقةٌ ، وما أطعمتَ نفْسَكَ فهو لكَ صدَقَةٌ"],"grade":"صحيح","narrator":"المقدام بن معدي كرب","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9185)، وأحمد (17179) باختلاف يسير، والطبراني في ((مسند الشاميين)) (1124) واللفظ له","bab":"نكاح › حسن العشرة بين الأزواج","dorar":"Kk33914x"},{"id":"س-01304","fp":"34315a2f8411","stateId":446,"easy":"إذا أطعمت ولدك ← فهو لك صدقة","cause":"وما أطعَمْتَ ولدَكَ","result":"فهو لَكَ صدَقَةٌ","explicit":true,"repOf":"س-01305","otherNeedIds":[37],"ref":"صحيح الجامع 5535","text":["ما أطعمْتَ زوجتَكَ فهو لَكَ صدَقَةٌ ، ",["وما أطعَمْتَ ولدَكَ",1]," ",["فهو لَكَ صدَقَةٌ",2]," ، وما أطعَمْتَ خادِمَكَ فهو لَكَ صدقةٌ ، وما أطعمتَ نفْسَكَ فهو لكَ صدَقَةٌ"],"grade":"صحيح","narrator":"المقدام بن معدي كرب","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9185)، وأحمد (17179) باختلاف يسير، والطبراني في ((مسند الشاميين)) (1124) واللفظ له","bab":"نكاح › حسن العشرة بين الأزواج","dorar":"Kk33914x"},{"id":"س-01331","fp":"4d7a4f22a92a","stateId":446,"easy":"إذا أعطيت زوجتك ← فهو صدقة","cause":"ما أَعْطى الرَّجلَ امرأتَه","result":"فهو صَدَقةٌ","explicit":true,"repOf":"س-01305","otherNeedIds":[37],"ref":"تخريج المسند لشعيب 17617","text":[["ما أَعْطى الرَّجلَ امرأتَه",1],"، ",["فهو صَدَقةٌ",2],"."],"grade":"صحيح","narrator":"عمرو بن أمية","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9184) بنحوه، وأحمد (17617) واللفظ له","bab":"نكاح › عشرة النساء","dorar":"IDWYn6OX"},{"id":"س-01951","fp":"303906b749ef","stateId":446,"easy":"إذا أنفقت على أولادك ← فلك فيهم أجر ما أنفقت","cause":"فإنِّي أُنفِقُ عليهم","result":"لكِ فيهم أجرٌ ما أنفَقْتِ عليهم","explicit":true,"similar":["س-06401","س-02873"],"otherNeedIds":[37],"ref":"صحيح ابن حبان 4246","srcLabel":"ابن حبان","text":["قُلْتُ لرسولِ اللهِ صلَّى اللهُ عليه وسلَّم: هل لي مِن أجرٍ في بني أبي سلَمةَ ؟ ",["فإنِّي أُنفِقُ عليهم",1]," وإنَّما هم بنيَّ، فلَسْتُ بتاركتِهم هكذا وهكذا ـ تقولُ: كان لي أجرٌ أو لم يكُنْ ؟ ـ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( نَعم ",["لكِ فيهم أجرٌ ما أنفَقْتِ عليهم",2]," )"],"grade":"صحيح","narrator":"أم سلمة","muhaddith":"أخرجه في صحيحه","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"8pLCpt9i"},{"id":"س-05917","fp":"fbab068bd1c7","stateId":446,"easy":"إذا أنفقت على أهلك وولدك وخادمك ← فهي صدقة","cause":"فإنَّ نفقَتَكَ على أهلِكَ وولدِكَ وخادِمِكَ","result":"صدقَةٌ","explicit":true,"repOf":"س-06356","ref":"المستدرك على الصحيحين 3159","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ سَأَلَ البَراءَ بنَ عازِبٍ فقالَ: «يا بَراءُ، كيف نفَقَتُكَ على أهلِكَ؟» قالَ: وكان مُوسِّعًا على أهلِهِ، فقالَ: يا رسولَ اللهِ، ما أحْسِبُها. قالَ: ",["«فإنَّ نفقَتَكَ على أهلِكَ وولدِكَ وخادِمِكَ ",1],["صدقَةٌ",2],"، فلا تُتْبِعْ ذلك مَنًّا ولا أذًى»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح الإسناد","takhrij":"لم نقف عليه إلا عند الحاكم في ((المستدرك ))(3118)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"KlXzyqtX"},{"id":"س-06287","fp":"141ab2d77915","stateId":446,"easy":"إذا صنعت شيئاً لأهلك ← فهو صدقة عليهم","cause":"كُلُّ ما صنَعْتَ إلى أهلِك","result":"فهو صدقةٌ عليهم","explicit":true,"otherNeedIds":[37],"ref":"صحيح ابن حبان 4237","srcLabel":"النسائي","text":["مرَّ عثمانُ بنُ عفَّانَ ـ أو عبدُ الرَّحمنِ بنُ عوفٍ ـ بمِرْطٍ فاستغلاه، فمرَّ به عمرُو بنُ أميَّةَ فاشتراه وكساه امرأتَه سُخيلةَ بنتَ عبيدةَ بنِ الحارثِ بنِ المطَّلبِ فمرَّ به عثمانُ ـ أو عبدُ الرَّحمنِ ـ فقال: ما فعَل المِرطُ الَّذي ابتَعْتَ ؟ قال عمرٌو: تصدَّقْتُ به على سُخيلةَ بنتِ عُبيدةَ بنِ الحارثِ فقال: أوَ",["كُلُّ ما صنَعْتَ إلى أهلِك",1]," صدقةٌ ؟ قال عمرٌو: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ ذلك فذكَر ما قال عمرٌو لرسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقال صلَّى اللهُ عليه وسلَّم: ( صدَق عمرٌو، كلُّ ما صنَعْتَ إلى أهلِك ",["فهو صدقةٌ عليهم",2]," )"],"grade":"صحيح","narrator":"عمرو بن أمية","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو يعلى (6877)، وابن عساكر في ((تاريخ دمشق)) (45/ 419) جميعًا بلفظه، وأخرجه أحمد (17617)، والنسائي في ((السنن الكبرى)) (9140) كلاهما بنحوه مختصرًا دون القصة في أوله","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"o4gxRw0l"},{"id":"س-06377","fp":"f8afc8fa0cd1","stateId":446,"easy":"إذا أعطيت أهلك ← فهو لك صدقة","cause":"ما أعطى الرجلُ أهلَه","result":"فهو له صدقةٌ","explicit":true,"repOf":"س-01305","ref":"صحيح الترغيب 1962","text":[["ما أعطى الرجلُ أهلَه",1]," ؛ ",["فهو له صدقةٌ",2]],"grade":"صحيح","narrator":"عمرو بن أمية","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9184)، وأحمد (17617) بمعناه","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"CrqqwuH9"},{"id":"س-06401","fp":"132801752bd2","stateId":446,"easy":"إذا أنفقت على أولادك ← فلك أجر ما أنفقت","cause":"أنفِقي عليهم","result":"فإنَّ لَكِ في ذلك أجرَ ما أنفَقتِ عليهم","explicit":true,"repOf":"س-01951","ref":"تخريج المسند لشعيب 16086","text":["عن رائِطةَ امرَأةِ عَبدِ اللهِ بنِ مَسعودٍ، وأُمِّ ولَدِه -وكانَتِ امرَأةً صَناعَ اليَدِ- قال: فكانَت تُنفِقُ عليه وعَلى ولَدِه مِن صَنعَتِها، قالت: فقُلتُ لعَبدِ اللهِ بنِ مَسعودٍ: لَقد شَغَلْتَني أنتَ وولَدُكَ عنِ الصَّدَقةِ، فما أستَطيعُ أن أتَصَدَّقَ بشَيءٍ، فقال لها عَبدُ اللهِ: واللهِ ما أُحِبُّ -إن لم يَكُنْ في ذلك أجرٌ- أن تَفعَلي، فأتَت رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فقالت: يا رَسولَ اللهِ، إنِّي امرَأةٌ ذاتُ صَنعةٍ أبيعُ مِنها، وليس لي ولا لولَدي ولا لزَوجي نَفَقةٌ غَيرُها، وقد شَغَلوني عنِ الصَّدَقةِ، فما أستَطيعُ أن أتَصَدَّقَ بشَيءٍ، فهَل لي مِن أجرٍ فيما أنفَقتُ؟ قال: فقال لها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: «",["أنفِقي عليهم؛ ",1],["فإنَّ لَكِ في ذلك أجرَ ما أنفَقتِ عليهم»",2]],"grade":"صحيح","narrator":"رائطة، امرأة عبد الله","muhaddith":"صحيح","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"Tl9Z2Eeo"},{"id":"س-02873","fp":"ee715964e5f1","stateId":446,"easy":"إذا أنفقت على أيتامك أو زوجك ← فلك أجر ما أنفقت","cause":"فهل لي في النَّفقةِ عليهم مِن أجرٍ","result":"لك أجرٌ ما أنفَقْتِ عليهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-01951","otherNeedIds":[37],"ref":"تخريج صحيح ابن حبان 4247","text":["عن رَيطةَ امرأةِ عبدِ اللهِ بنِ مسعودٍ أمِّ ولدِه: وكانتِ امرأةً صَنَاعًا وليس لعبدِ اللهِ بنِ مسعودٍ مالٌ، وكانت تُنفِقُ عليه وعلى ولدِه مِن ثمرةِ صنعتِها وقالت: واللهِ لقد شغَلْتَني أنتَ وولدُك عن الصَّدقةِ فما أستطيعُ أنْ أتصدَّقَ معكم فقال: ما أُحِبُّ ـ إنْ لم يكُنْ لك في ذلك أجرٌ ـ أنْ تفعَلي فسأَل رسولَ اللهِ صلَّى اللهُ عليه وسلَّم هو وهي، فقالت: يا رسولَ اللهِ إنِّي امرأةٌ ولي صَنْعةٌ فأبيعُ منها وليس لي ولا لزوجي ولا لولدي شيءٌ وشغَلوني فلا أتصدَّقُ، ",["فهل لي في النَّفقةِ عليهم مِن أجرٍ",1]," ؟ فقال: ( لكِ في ذ",["لك أجرٌ ما أنفَقْتِ عليهم",2]," فأنفِقي عليهم )"],"grade":"صحيح","narrator":"ريطة امرأة عبدالله بن مسعود أم ولده","muhaddith":"إسناده صحيح","bab":"إيمان › الوعد","dorar":"aotuglcW","merged":4,"otherRefs":["صحيح البخاري 1467 (صحيح)","صحيح البخاري 5369 (صحيح)","تخريج المسند لشعيب 16085 (صحيح)"]},{"id":"س-06348","fp":"398e0400592c","stateId":446,"easy":"إذا أنفقت على امرأتك وولدك وأهل بيتك ← فهي صدقة","cause":"مَن أنفَقَ على امرأتِهِ وولدِهِ وأهلِ بيتِهِ","result":"فهيَ صَدقَةٌ","explicit":true,"repOf":"س-06356","ref":"الزواجر عن اقتراف الكبائر 2/65","text":["مَن أنفقَ على نفسِهِ نفقَةً يستَعِفُّ بها فهي صدَقَةٌ ، ",["مَن أنفَقَ على امرأتِهِ وولدِهِ وأهلِ بيتِهِ ",1],["فهيَ صَدقَةٌ",2]],"grade":"حسن","narrator":"[أبو أمامة الباهلي]","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (3897) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (2/7).","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"xZktfFbP"},{"id":"س-02843","fp":"f4900d21c1fc","stateId":447,"easy":"إذا مسحت رأس يتيم لله ← لك بكل شعرة مرت عليها يدك حسنات","cause":"مَن مَسَحَ رَأسَ يَتيمٍ لم يَمسَحْه إلَّا للهِ","result":"كان له بكلِّ شَعرةٍ مَرَّتْ عليها يدُه حَسناتٌ","explicit":true,"ref":"تخريج المسند لشعيب 22153","srcLabel":"أحمد","text":["أنَّ رسولَ اللهِ صَلَّى اللهُ عليه وسلَّمَ قال: ",["مَن مَسَحَ رَأسَ يَتيمٍ لم يَمسَحْه إلَّا للهِ، ",1],["كان له بكلِّ شَعرةٍ مَرَّتْ عليها يدُه حَسناتٌ، ",2],"ومَن أحسَنَ إلى يَتيمةٍ أو يَتيمٍ عندَه، كنتُ أنا وهو في الجنَّةِ كهاتَينِ، وقَرَنَ بيْنَ إصبَعَيه: السَّبَّابةِ والوُسطى."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح لغيره دون الشطر الأول منه بقصة المسح على رأس اليتيم","takhrij":"أخرجه أحمد (22153) واللفظ له، والطبراني (8/239) (7821)، وأبو نعيم في ((حلية الأولياء)) (8/179)","bab":"إيمان › الوعد","dorar":"awBDh4rc"},{"id":"س-02631","fp":"4c4168015b5f","stateId":447,"easy":"إذا جامعت أهلك ← فهو صدقة","cause":"وفي مُباضَعَتِكَ أهلَكَ","result":"صَدَقةٌ","explicit":true,"ref":"تخريج المسند لشعيب 21469","srcLabel":"الترمذي","text":["قيلَ للنَّبيِّ صلَّى اللهُ عليه وسلَّمَ: ذهَبَ أهلُ الأموالِ بالأجْرِ، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: إنَّ فيكَ صَدَقةً كَثيرةً، فذكَرَ فَضلَ سَمعِكَ، وفَضلَ بَصرِكَ، قال: ",["وفي مُباضَعَتِكَ أهلَكَ ",1],["صَدَقةٌ",2],"، فقال أبو ذَرٍّ: أيُؤجَرُ أحَدُنا في شَهوتِه؟ قال: أرَأيْتَ لو وضَعْتَه في غيرِ حِلٍّ أكان عليكَ وِزرٌ؟ قال: نَعَمْ، قال: أفتَحتَسِبونَ بالشَرِّ، ولا تَحتَسِبونَ بالخَيرِ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1956) بنحوه، وأحمد (21469) واللفظ له","bab":"إيمان › الاحتساب والنية","dorar":"Din6A3c8"},{"id":"س-01347","fp":"de43547e2ba2","stateId":447,"easy":"إذا سقيت زوجتك الماء ← تؤجر","cause":"إذا سقَى الرجلُ امرأتَه الماءَ","result":"أُجِرَ","explicit":true,"star":true,"similar":["س-07013"],"ref":"صحيح الجامع 602","srcLabel":"البخاري","text":[["إذا سقَى الرجلُ امرأتَه الماءَ ",1],["أُجِرَ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17195)، والبخاري في ((التاريخ الكبير)) (3/179) واللفظ له من حديث العرباض بن سارية رضي الله عنه","bab":"نكاح › عشرة النساء","dorar":"iQh1uRfq"},{"id":"س-01282","fp":"01d787de3876","stateId":447,"easy":"إذا وضعت شهوتك في الحلال ← يكون لك فيها أجر","cause":"إذا وضعها في الحلالِ","result":"كان له [ فيها ] أجرٌ","explicit":true,"ref":"آداب الزفاف 65","srcLabel":"مسلم","text":["أنَّ ناسًا من أصحابِ النبيِّ صلَّى اللهُ عليه وسلَّم قالوا للنبيِّ صلَّى اللهُ عليه وسلَّم : يا رسولَ اللهِ ! ذهب أهلُ الدُّثورِ بالأجورِ ، يُصَلُّون كما نصلي ، ويصومون كما نصومُ ، ويتصدقون بفضولِ أموالِهِم ، قال : أَوَلَيْس قد جعل اللهُ لكم ما تَصَدَّقُون ؟ إن بكلِّ تسبيحةٍ صدقةً ، [ وبكلِّ تكبيرةٍ صدقةً ، وبكلِّ تهليلةٍ صدقةً ، وبكلِّ تحميدةٍ صدقةً ] ، وأمرٌ بالمعروفِ صدقةٌ ، ونهيٌ عن منكرٍ صدقةٌ ، وفي بُضْعِ أحدِكم صدقةٌ ! قالوا : يا رسولَ اللهِ ! أيأتي أحدُنا شهوتَه ويكونُ له فيها أجرٌ ؟ ! قال : أرأيتم لو وضعها في حرامٍ أكان عليه فيها وزرٌ ؟ [ قالوا : بلى ، قال : ] فكذلك ",["إذا وضعها في الحلالِ",1]," ",["كان له [ فيها ] أجرٌ",2]," ، [ وذكر أشياءَ : صدقةً ، صدقةً ، ثم قال : ويُجْزِئُ من هذا كلِّه ركعتا الضُّحَى ] ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"أخرجه مسلم والزيادات كلها له،وإسنادها صحيح على شرط مسلم، وللنسائي الزيادة الأخيرة","takhrij":"أخرجه مسلم (720، 1006) مفرقاً باختلاف يسير","bab":"نكاح › الحث على التزويج","dorar":"miAsobHq","merged":2,"otherRefs":["صحيح الأدب المفرد 167 (صحيح)"]},{"id":"س-03457","fp":"2c1a78fad522","stateId":447,"easy":"إذا جامعت زوجتك ← فلك أجر","cause":"في جِماعِكَ زَوْجَتَكَ","result":"أَجْرٌ","explicit":true,"otherNeedIds":[37],"ref":"السلسلة الصحيحة 575","srcLabel":"مسلم","text":["على كلِّ نَفْسٍ كلَّ يَوْمٍ طَلَعَتْ فيهِ الشمسُ صدقةٌ مِنْهُ على نفسِهِ ، قُلْتُ يا رسولَ اللهِ من أين نَتَصَدَّقُ و ليس لَنا أَمْوَالٌ ؟ قال : لِأنَّ من أبوابِ الصَّدَقَةِ التَّكْبيرَ ، و سُبحانَ اللهِ ، و الحمدُ للهِ ، و لا إلهَ إلَّا اللهُ ،وَ أَسْتَغْفِرُ اللهَ ، و تَأْمُرُ بالمعروفِ ، و تَنْهَى عَنِ المنكرِ، و تَعْزِلُ الشَّوْكَةَ عن طَرِيقِ الناسِ و العظمَةَ و الحَجَرَ ، و تَهْدِي الأَعْمَى ، و تُسْمِعُ الأَصَمَّ و الأَبْكَمَ حتى يَفْقَهَ ، و تُدِلُّ المُسْتَدِلَّ على حاجَةٍ لهُ قد عَلِمْتَ مكانَها ، و تَسْعَى بِشِدَّةِ ساقَيْكَ إلى اللَّهْفَانِ المُسْتَغِيثِ ، و تَرْفَعُ بِشِدَّةِ ذِرَاعَيْكَ مع الضَّعِيفِ ، كلُّ ذلكَ من أبوابِ الصَّدَقَةِ مِنْكَ على نَفْسِكَ ، و لكَ ",["في جِماعِكَ زَوْجَتَكَ",1]," ",["أَجْرٌ",2]," ، قال أبو ذَرٍّ : كَيْفَ لي أَجْرٌ في شَهْوَتِي ؟ فقال : أرأيْتَ لَوْ كان لكَ ولَدٌ فَأَدْرَكَ ورَجَوْتَ خَيْرَهُ ، فماتَ أَكُنْتَ تَحْتَسِبُ ُ؟ قُلْتُ : نَعَمْ ، قال : فَأنتَ خَلَقْتَهُ ؟ قال : بَلْ اللهُ خلقَهُ ، قال : فَأنتَ هَدَيْتَهُ ؟ قال : بَلْ اللهُ هَدَاهُ ، قال : فَأنتَ تَرْزُقُهُ ؟ قال : بَلْ اللهُ كان يَرْزُقُهُ ، قال : كَذلكَ فَضَعْهُ في حَلالِه و جَنِّبْهُ حَرَامَهُ ، فإنْ شاءَ اللهُ أَحْياهُ ، وإنْ شاءَ أَماتَهُ ، و لكَ أَجْرٌ"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9027)، وأحمد (21484) باختلاف يسير","bab":"استغفار › فضل الاستغفار","dorar":"a8m5cxDp","merged":2,"otherRefs":["تخريج صحيح ابن حبان 4192 (صحيح)"]},{"id":"س-08094","fp":"e1c4998213cb","stateId":447,"easy":"إذا يسّرت النكاح ← فهو خير النكاح","cause":"أيسرُه","result":"خيرُ النِّكاحِ","explicit":true,"ref":"تخريج صحيح ابن حبان 4072","srcLabel":"ابن حبان","text":[["خيرُ النِّكاحِ",2],[" أيسرُه",1]," ) وقال النَّبيُّ لرجلٍ: ( أترضى أنْ أُزوِّجَك فلانةَ ) ؟ قال: نَعم قال لها: ( أترضَيْنَ أنْ أُزوِّجَكِ فلانًا ) ؟ قالت: نَعم، فزوَّجها صلَّى اللهُ عليه وسلَّم ولم يفرِضْ صداقًا فدخَل بها فلم يُعطِها شيئًا فلمَّا حضَرتْه الوفاةُ قال: إنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم زوَّجني فلانةَ ولم أُعطِها شيئًا وقد أعطَيْتُها سهمي مِن خيبرَ فكان له سهمٌ بخيبرَ فأخَذتْه فباعتْه فبلَغ مئةَ ألفٍ"],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"إسناده صحيح","bab":"مغازي › غزوة خيبر","dorar":"mjmGXjh9"},{"id":"س-01318","fp":"e60ea6739013","stateId":447,"easy":"إذا حملت المرأة من زوجها وهو عنها راضٍ ← فلها مثل أجر الصائم القائم المجاهد","cause":"إِذَا كانَتْ حَامِلًا مِنَ زوجِها وهو عنها راضٍ","result":"أنَّ لَها مثلُ أجرِ الصائمِ القائمِ في سبيلِ اللهِ","explicit":true,"ref":"مجمع الزوائد 4/307","srcLabel":"الطبراني","text":["أنَّ سلامةَ حاضنةَ إبراهيمَ بنِ النبيِّ صلَّى اللهُ عليه وسلَّم قالتْ يا رسولَ اللهِ تبشرُ الرجالَ بكلِّ خيرٍ ولا تبشرُ النساءَ قال أصُوَيْحِبَاتِكِ دَسَسْنَكَ لهذا قالتْ أجلْ هُنَّ أَمَرْنَنِي قال أَفَمَا تَرْضَى إحْدَاكُنَّ أَنَّها ",["إِذَا كانَتْ حَامِلًا مِنَ زوجِها وهو عنها راضٍ",1]," ",["أنَّ لَها مثلُ أجرِ الصائمِ القائمِ في سبيلِ اللهِ",2]," فإذا أصابَها الطَّلْقُ لم يَعْلَمْ أَهْلُ السماءِ وأهلُ الأرضِ ما أُخْفِيَ لها من قُرَّةِ أَعْيُنٍ فَإِذَا وَضَعَتْ لم يَخْرُجْ مِنْهَا جُرْعَةٌ مِنْ لَبَنِهَا وَلَمْ يمصَّ مصةً إلا كان لها بكلِّ جرعةٍ وبكلِّ مصةٍ حسنةٌ فإنْ أسهَرَهَا ليلةً كان لها مثلُ أجرِ سبعينَ رقبةً تُعْتِقُهُنَّ في سبيلِ اللهِ سلامةً يعْني لِمَنْ أَعْنَى بِهَذِهِ الْمُتَنَعِّمَاتِ الصَّالِحَاتِ المطِيعَاتِ اللَّاتِي لَا يَكَفُرْنَ العشيرَ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"فيه عمار بن نصير وبقية رجاله ثقات","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6733)، وابن الجوزي في ((الموضوعات)) (1284) كلاهما بلفظه، والبلاذري في ((أنساب الأشراف)) (919) مختصرا ببعض لفظه.","bab":"نكاح › حق الزوج على المرأة","dorar":"EVR3qUG1"},{"id":"س-01319","fp":"70050127d9ad","stateId":447,"easy":"إذا أرضعت ← فلها بكل جرعة ومصة حسنة","cause":"فَإِذَا وَضَعَتْ لم يَخْرُجْ مِنْهَا جُرْعَةٌ مِنْ لَبَنِهَا وَلَمْ يمصَّ مصةً","result":"إلا كان لها بكلِّ جرعةٍ وبكلِّ مصةٍ حسنةٌ","explicit":true,"ref":"مجمع الزوائد 4/307","srcLabel":"الطبراني","text":["أنَّ سلامةَ حاضنةَ إبراهيمَ بنِ النبيِّ صلَّى اللهُ عليه وسلَّم قالتْ يا رسولَ اللهِ تبشرُ الرجالَ بكلِّ خيرٍ ولا تبشرُ النساءَ قال أصُوَيْحِبَاتِكِ دَسَسْنَكَ لهذا قالتْ أجلْ هُنَّ أَمَرْنَنِي قال أَفَمَا تَرْضَى إحْدَاكُنَّ أَنَّها إِذَا كانَتْ حَامِلًا مِنَ زوجِها وهو عنها راضٍ أنَّ لَها مثلُ أجرِ الصائمِ القائمِ في سبيلِ اللهِ فإذا أصابَها الطَّلْقُ لم يَعْلَمْ أَهْلُ السماءِ وأهلُ الأرضِ ما أُخْفِيَ لها من قُرَّةِ أَعْيُنٍ ",["فَإِذَا وَضَعَتْ لم يَخْرُجْ مِنْهَا جُرْعَةٌ مِنْ لَبَنِهَا وَلَمْ يمصَّ مصةً",1]," ",["إلا كان لها بكلِّ جرعةٍ وبكلِّ مصةٍ حسنةٌ",2]," فإنْ أسهَرَهَا ليلةً كان لها مثلُ أجرِ سبعينَ رقبةً تُعْتِقُهُنَّ في سبيلِ اللهِ سلامةً يعْني لِمَنْ أَعْنَى بِهَذِهِ الْمُتَنَعِّمَاتِ الصَّالِحَاتِ المطِيعَاتِ اللَّاتِي لَا يَكَفُرْنَ العشيرَ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"فيه عمار بن نصير وبقية رجاله ثقات","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6733)، وابن الجوزي في ((الموضوعات)) (1284) كلاهما بلفظه، والبلاذري في ((أنساب الأشراف)) (919) مختصرا ببعض لفظه.","bab":"نكاح › حق الزوج على المرأة","dorar":"EVR3qUG1"},{"id":"س-01320","fp":"3331561262ba","stateId":447,"easy":"إذا أسهرها رضيعها ليلة ← فلها مثل أجر عتق سبعين رقبة","cause":"فإنْ أسهَرَهَا ليلةً","result":"كان لها مثلُ أجرِ سبعينَ رقبةً تُعْتِقُهُنَّ في سبيلِ اللهِ","explicit":true,"otherNeedIds":[49],"ref":"مجمع الزوائد 4/307","srcLabel":"الطبراني","text":["أنَّ سلامةَ حاضنةَ إبراهيمَ بنِ النبيِّ صلَّى اللهُ عليه وسلَّم قالتْ يا رسولَ اللهِ تبشرُ الرجالَ بكلِّ خيرٍ ولا تبشرُ النساءَ قال أصُوَيْحِبَاتِكِ دَسَسْنَكَ لهذا قالتْ أجلْ هُنَّ أَمَرْنَنِي قال أَفَمَا تَرْضَى إحْدَاكُنَّ أَنَّها إِذَا كانَتْ حَامِلًا مِنَ زوجِها وهو عنها راضٍ أنَّ لَها مثلُ أجرِ الصائمِ القائمِ في سبيلِ اللهِ فإذا أصابَها الطَّلْقُ لم يَعْلَمْ أَهْلُ السماءِ وأهلُ الأرضِ ما أُخْفِيَ لها من قُرَّةِ أَعْيُنٍ فَإِذَا وَضَعَتْ لم يَخْرُجْ مِنْهَا جُرْعَةٌ مِنْ لَبَنِهَا وَلَمْ يمصَّ مصةً إلا كان لها بكلِّ جرعةٍ وبكلِّ مصةٍ حسنةٌ ",["فإنْ أسهَرَهَا ليلةً",1]," ",["كان لها مثلُ أجرِ سبعينَ رقبةً تُعْتِقُهُنَّ في سبيلِ اللهِ",2]," سلامةً يعْني لِمَنْ أَعْنَى بِهَذِهِ الْمُتَنَعِّمَاتِ الصَّالِحَاتِ المطِيعَاتِ اللَّاتِي لَا يَكَفُرْنَ العشيرَ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"فيه عمار بن نصير وبقية رجاله ثقات","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6733)، وابن الجوزي في ((الموضوعات)) (1284) كلاهما بلفظه، والبلاذري في ((أنساب الأشراف)) (919) مختصرا ببعض لفظه.","bab":"نكاح › حق الزوج على المرأة","dorar":"EVR3qUG1"},{"id":"س-07013","fp":"98e22c8ae553","stateId":447,"easy":"إذا سقيت امرأتك الماء ← تؤجر","cause":"إنَّ الرجلَ إذا سقى امرأتَه من الماءِ","result":"أُجِرَ قال : فأتيتُها فسقيتُها","explicit":true,"repOf":"س-01347","ref":"صحيح الترغيب 1963","text":[["إنَّ الرجلَ إذا سقى امرأتَه من الماءِ ",1],["أُجِرَ قال : فأتيتُها فسقيتُها ",2],"، وحدَّثتُها بما سمعتُ من رسولِ اللهِ ."],"grade":"حسن","narrator":"العرباض بن سارية","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (17155) واللفظ له، وابن أبي شيبة في ((المسند)) (891)، والطبراني (18/258) (646) باختلاف يسير","bab":"علم › الحث على الأخذ بالسنة","dorar":"3fQN17z9"},{"id":"س-06267","fp":"b0e383c0764e","stateId":447,"easy":"إذا أنفقت على أيتام أقاربك ← فلك كفلان","cause":"لإحداهُما فضلُ مالٍ وفي حَجرِها بنو أخٍ لها أيتامٌ ، وقالت الأخرى : إنَّ لي فضلَ مالٍ ، ولي زوجٌ خفيفُ ذاتِ اليدِ","result":"لهما : كِفلان","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[37],"ref":"مختصر زوائد البزار 1/395","srcLabel":"النسائي","text":["انطلقتْ أمُّ عبدِ الله وامرأةُ عبدِ اللهِ إلى النبيِّ صلَّى اللهُ عليهِ وسلَّمَ كلُّ واحدةٍ منهما تكتمُ صاحبتَها أمرَها ، فأتتا الحجرةَ فقالتا لبلالٍ : ائتِ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ فقل : إنَّ امرأتين ",["لإحداهُما فضلُ مالٍ وفي حَجرِها بنو أخٍ لها أيتامٌ ، وقالت الأخرى : إنَّ لي فضلَ مالٍ ، ولي زوجٌ خفيفُ ذاتِ اليدِ",1]," ، فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ",["لهما : كِفلان",2]," كِفلان – يعني : بصدقتِهما على ما ذكرتا"],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"إسناده حسن","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9203)، وابن زنجويه في ((الأموال)) (1338) باختلاف يسير، والبزار (1542) واللفظ له","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"qgaIeVgv"},{"id":"س-01989","fp":"bfa3a8ffb4b0","stateId":447,"easy":"إذا أتيت أهلك (بالحلال) ← تؤجر","cause":"غِشْيانَ أَهلِه","result":"فكذلك يُؤجَرُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[37],"ref":"تخريج المسند لشعيب 21427","srcLabel":"أحمد","text":["عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ أنَّه ذكَرَ أشياءَ يُؤجَرُ فيها الرَّجلُ، حتى ذكَرَ لي ",["غِشْيانَ أَهلِه",1],"، فقالوا: يا رسولَ اللهِ، أيُؤجَرُ في شَهوتِه يُصيبُها؟ قال: أرَأيْتَ لو كان آثِمًا، أليس كان يكونُ عليه الوِزرُ؟ فقالوا: نَعَمْ، قال: ",["فكذلك يُؤجَرُ",2],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (21427) واللفظ له، والطيالسي (473)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"YsiJw2cH"},{"id":"س-03262","fp":"d5ada7ae41d0","stateId":448,"easy":"إذا أصابتك شوكة ← يكتب الله لك بها حسنة ويحط عنك خطيئة","cause":"ما من شيءٍ يُصيبُ المؤمن ، حتى الشَّوْكةَ تُصيبُهُ","result":"إلَّا كَتبَ اللهُ لهُ بِها حَسنةً ، و حَطَّ عنْهُ بِها خطِيئةً","explicit":true,"star":true,"otherNeedIds":[11],"ref":"صحيح الجامع 5723","srcLabel":"متفق عليه","text":[["ما من شيءٍ يُصيبُ المؤمن ، حتى الشَّوْكةَ تُصيبُهُ ،",1]," ",["إلَّا كَتبَ اللهُ لهُ بِها حَسنةً ، و حَطَّ عنْهُ بِها خطِيئةً",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5640) مختصراً بنحوه، ومسلم (2572) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"dsnXSkbC"},{"id":"س-03271","fp":"c3ed778610d2","stateId":448,"easy":"إذا أصابتك شوكة فما فوقها ← تُكتب لك درجة وتُمحى عنك خطيئة","cause":"ما مِن مُسلِمٍ يُشاكُ شَوكةً فما فوقَها","result":"إلَّا كُتِبَت له بها دَرَجةٌ، ومُحيَت عنه بها خَطيئةٌ","explicit":true,"star":true,"otherNeedIds":[47,11],"ref":"صحيح مسلم 2572","srcLabel":"البخاري","text":["دَخَلَ شَبابٌ مِن قُرَيشٍ على عائِشةَ وهي بمِنًى، وهم يَضحَكونَ، فقالت: ما يُضحِكُكُم؟ قالوا: فُلانٌ خَرَّ على طُنُبِ فُسطاطٍ، فكادَت عُنُقُه أو عَينُه أن تَذهَبَ، فقالت: لا تَضحَكوا، فإنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: ",["ما مِن مُسلِمٍ يُشاكُ شَوكةً فما فوقَها",1]," ",["إلَّا كُتِبَت له بها دَرَجةٌ، ومُحيَت عنه بها خَطيئةٌ",2],"."],"grade":"صحيح","narrator":"عائشة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5640), والترمذي (965)، مختصرا بدون القصة في أوله، وأبو داود الطيالسي (1477) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"5I84Z3bJ"},{"id":"س-07311","fp":"de8153cc4693","stateId":448,"easy":"إذا وقعت في نار الدجال (صابراً) ← وجب أجرك وحُط وزرك","cause":"ومَن وقَع في نارِه","result":"وجَب أجرُه وحُطَّ وِزرُه","explicit":true,"similar":["س-07414"],"otherNeedIds":[11],"ref":"شرح مشكل الآثار 14/377","srcLabel":"متفق عليه","text":["ثم يَخرُجُ الدجَّالُ معَه نهرُ ماءٍ باردٍ فمَن وقَع في نهرِه وجَب وِزرُه وحُطَّ أجرُه ",["ومَن وقَع في نارِه",1]," ",["وجَب أجرُه وحُطَّ وِزرُه",2]],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4244) وأحمد (23429) بنحوه مطولا، وأصله في البخاري (3450) ومسلم (2935)","bab":"فتن › فتنة الدجال","dorar":"9HPlLMJA"},{"id":"س-07912","fp":"faa8b8925303","stateId":448,"easy":"إذا أصابتك الحمى ← تجري حسناتك ما اختلج عليك قدم أو ضرب عرق","cause":"الحُمَّى","result":"تَجْري الحَسَناتُ على صاحِبِها ما اخْتَلَجَ عليه قَدَمٌ أو ضَرَبَ عليه عِرْقٌ","explicit":true,"otherNeedIds":[9],"ref":"الأحاديث المختارة 1270","srcLabel":"البخاري","text":["«يا رَسولَ اللهِ، ما جَزاءُ ",["الحُمَّى",1],"؟ قالَ: ",["تَجْري الحَسَناتُ على صاحِبِها ما اخْتَلَجَ عليه قَدَمٌ أو ضَرَبَ عليه عِرْقٌ",2],"، فقالَ -يَعْني أُبَيًّا-: اللَّهُمَّ إنِّي أَسأَلُك حُمَّى لا تَمنَعُني خُروجًا في سَبيلِك، ولا خُروجًا إلى بَيْتِك، ولا مَسجِدِ نَبِيِّك صلَّى اللهُ عليه وسلَّمَ، فلم يُمَسَّ أُبَيٌّ قَطُّ إلَّا وبه حُمًّى»."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"مريض › فضل المرض والنوائب","dorar":"tiOgQrQH"},{"id":"ق-0600","fp":"122b94b4c036","stateId":448,"easy":"الصبر ← لا يضيع أجر المحسنين","cause":"الصبر","result":"لا يضيع أجر المحسنين","explicit":true,"similar":["ق-0614"],"ref":"سورة هود: 115","srcLabel":"القرآن الكريم","quran":{"s":11,"from":115,"to":115,"text":"وَاصْبِرْ فَإِنَّ اللَّهَ لَا يُضِيعُ أَجْرَ الْمُحْسِنِينَ (115)","hl":[[0,59,1]]}},{"id":"ق-0614","fp":"dbe193a3b552","stateId":448,"easy":"التقوى والصبر ← لا يضيع الله الأجر (العزّ بعد البلاء)","cause":"التقوى والصبر","result":"لا يضيع الله الأجر (العزّ بعد البلاء)","explicit":true,"repOf":"ق-0600","otherNeedIds":[43,4],"ref":"سورة يوسف: 90","quran":{"s":12,"from":90,"to":90,"text":"قَالُوا أَإِنَّكَ لَأَنْتَ يُوسُفُ قَالَ أَنَا يُوسُفُ وَهَذَا أَخِي قَدْ مَنَّ اللَّهُ عَلَيْنَا إِنَّهُ مَنْ يَتَّقِ وَيَصْبِرْ فَإِنَّ اللَّهَ لَا يُضِيعُ أَجْرَ الْمُحْسِنِينَ (90)","hl":[[69,179,1]]}},{"id":"ق-0677","fp":"c404ae7e7604","stateId":448,"easy":"الصبر على الوفاء بعهد الله وإيثار ما عنده ← الجزاء بأحسن العمل وما عند الله باقٍ","cause":"الصبر على الوفاء بعهد الله وإيثار ما عنده","result":"الجزاء بأحسن العمل وما عند الله باقٍ","explicit":true,"ref":"سورة النحل: 95–96","srcLabel":"القرآن الكريم","quran":{"s":16,"from":95,"to":96,"text":"وَلَا تَشْتَرُوا بِعَهْدِ اللَّهِ ثَمَنًا قَلِيلًا إِنَّمَا عِنْدَ اللَّهِ هُوَ خَيْرٌ لَكُمْ إِنْ كُنْتُمْ تَعْلَمُونَ (95) مَا عِنْدَكُمْ يَنْفَدُ وَمَا عِنْدَ اللَّهِ بَاقٍ وَلَنَجْزِيَنَّ الَّذِينَ صَبَرُوا أَجْرَهُمْ بِأَحْسَنِ مَا كَانُوا يَعْمَلُونَ (96)","hl":[[0,256,1]]}},{"id":"ق-0922","fp":"93fa5e551655","stateId":448,"easy":"الصبر ودرء السيئة بالحسنة والإنفاق والإعراض عن اللغو ← الأجر مرتين","cause":"الصبر ودرء السيئة بالحسنة والإنفاق والإعراض عن اللغو","result":"الأجر مرتين","explicit":true,"ref":"سورة القصص: 54–55","srcLabel":"القرآن الكريم","quran":{"s":28,"from":54,"to":55,"text":"أُولَئِكَ يُؤْتَوْنَ أَجْرَهُمْ مَرَّتَيْنِ بِمَا صَبَرُوا وَيَدْرَءُونَ بِالْحَسَنَةِ السَّيِّئَةَ وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ (54) وَإِذَا سَمِعُوا اللَّغْوَ أَعْرَضُوا عَنْهُ وَقَالُوا لَنَا أَعْمَالُنَا وَلَكُمْ أَعْمَالُكُمْ سَلَامٌ عَلَيْكُمْ لَا نَبْتَغِي الْجَاهِلِينَ (55)","hl":[[0,283,1]]}},{"id":"ق-0928","fp":"84be32c1c448","stateId":448,"easy":"الإيمان والعمل الصالح والصبر ← ثواب الله خير","cause":"الإيمان والعمل الصالح والصبر","result":"ثواب الله خير","explicit":true,"ref":"سورة القصص: 80","srcLabel":"القرآن الكريم","quran":{"s":28,"from":80,"to":80,"text":"وَقَالَ الَّذِينَ أُوتُوا الْعِلْمَ وَيْلَكُمْ ثَوَابُ اللَّهِ خَيْرٌ لِمَنْ آمَنَ وَعَمِلَ صَالِحًا وَلَا يُلَقَّاهَا إِلَّا الصَّابِرُونَ (80)","hl":[[47,139,1]]}},{"id":"ق-1076","fp":"b2c371812eba","stateId":448,"easy":"الصبر ← توفية الأجر بغير حساب","cause":"الصبر","result":"توفية الأجر بغير حساب","explicit":true,"similar":["س-07704"],"ref":"سورة الزمر: 10","srcLabel":"القرآن الكريم","quran":{"s":39,"from":10,"to":10,"text":"قُلْ يَا عِبَادِ الَّذِينَ آمَنُوا اتَّقُوا رَبَّكُمْ لِلَّذِينَ أَحْسَنُوا فِي هَذِهِ الدُّنْيَا حَسَنَةٌ وَأَرْضُ اللَّهِ وَاسِعَةٌ إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُمْ بِغَيْرِ حِسَابٍ (10)","hl":[[134,193,1]]}},{"id":"س-07414","fp":"e69fa9d2baaa","stateId":448,"easy":"إذا دخلت نار الدجال ← وجب أجرك وحُط وزرك","cause":"ومَن دخل نارَه","result":"وَجَب أَجْرُه ، وحُطَّ وِزْرُه","explicit":true,"repOf":"س-07311","otherNeedIds":[11],"ref":"صحيح الجامع 8049","text":["يَخْرُجُ الدجالُ ومعه نهرٌ ونارٌ ، فمَن دخل نهَره وجب وِزْرُه وحُطَّ أَجْرُه ، ",["ومَن دخل نارَه",1],"  ",["وَجَب أَجْرُه ، وحُطَّ وِزْرُه",2]," ، ثم إنما هي قيامُ الساعةِ"],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4244) واللفظ له مطولا، وأحمد (23430) والطيالسي (438) بنحوه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"APTioUTw","merged":2,"otherRefs":["تخريج المسند لشعيب 23425 (حسن)"]},{"id":"س-05676","fp":"63cf8379e87f","stateId":448,"easy":"إذا خالطت الناس وصبرت على أذاهم ← فأنت أعظم أجراً ممن لا يخالطهم","cause":"المُؤمِنُ الذي يُخالِطُ النَّاسَ ويَصبِرُ على أذاهم","result":"أعظَمُ أجْرًا مِن الذي لا يُخالِطُ النَّاسَ ولا يَصبِرُ على أذاهم","explicit":true,"similar":["س-06035"],"otherNeedIds":[41],"ref":"تخريج المسند لشعيب 23098","srcLabel":"الترمذي","text":["عن يَحْيى بنِ وَثَّابٍ، عن رَجُلٍ مِن أصْحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ -قال: أظُنُّه ابنَ عُمَرَ، عن النَّبيِّ صلَّى اللهُ عليه وسلَّمَ قال: ",["المُؤمِنُ الذي يُخالِطُ النَّاسَ ويَصبِرُ على أذاهم",1],"، ",["أعظَمُ أجْرًا مِن الذي لا يُخالِطُ النَّاسَ ولا يَصبِرُ على أذاهم",2],"."],"grade":"صحيح","narrator":"رجال من الصحابة","muhaddith":"إسناده صحيح،","takhrij":"أخرجه الترمذي (2507)، وابن ماجه (4032)، وأحمد (23098) واللفظ له","bab":"رقائق وزهد › الصبر على البلاء","dorar":"s9pjZ1zC"},{"id":"س-06035","fp":"a24e8e3636b4","stateId":448,"easy":"إذا خالطت الناس وصبرت على أذاهم ← فأنت خير ممن لا يخالطهم","cause":"المسلِمُ إذا كانَ مخالطًا النَّاسَ ويصبِرُ على أذاهم","result":"خيرٌ منَ المسلمِ الَّذي لا يخالطُ النَّاسَ ولا يصبرُ على أذاهم","explicit":true,"repOf":"س-05676","ref":"صحيح الترمذي 2507","text":[["المسلِمُ إذا كانَ مخالطًا النَّاسَ ويصبِرُ على أذاهم ",1],["خيرٌ منَ المسلمِ الَّذي لا يخالطُ النَّاسَ ولا يصبرُ على أذاهم",2]],"grade":"صحيح","narrator":"شيخ من أصحاب النبي صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2507)، وابن أبي شيبة في ((الأدب)) (19)، وهناد في ((الزهد)) (2/ 588) واللفظ لهم.","bab":"رقائق وزهد › فضل الصبر","dorar":"XZIALo74"},{"id":"س-06043","fp":"30956c53fbee","stateId":448,"easy":"إذا صبرت في الطاعون ببلدك ← فلك أجر شهيد","cause":"ومَنْ صَبَرَ فيهِ","result":"كانَ لَهُ أجرُ شهيدٍ","explicit":true,"otherNeedIds":[49,62],"ref":"صحيح الجامع 4277","srcLabel":"أحمد","text":["الفارُّ مِنَ الطاعُونِ كالفارِّ مِنَ الزَّحْفِ ، ",["ومَنْ صَبَرَ فيهِ ",1],["كانَ لَهُ أجرُ شهيدٍ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أحمد (14918)، والطبري في ((تهذيب الآثار)) (93)، والطبراني في ((المعجم الأوسط)) (3193) باختلاف يسير.","bab":"رقائق وزهد › فضل الصبر","dorar":"UyDx8Pkb"},{"id":"س-07704","fp":"10185594c81f","stateId":448,"easy":"إذا صبرت ← توفّى أجرك بغير حساب","cause":"قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( ربِّ زِدْ أمَّتي ) فنزَلت: إِنَّمَا","result":"إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُمْ بِغَيْرِ حِسَابٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-1076","ref":"صحيح ابن حبان 4648","text":["لمَّا نزَلت: {مَثَلُ الَّذِينَ يُنْفِقُونَ أَمْوَالَهُمْ فِي سَبِيلِ اللَّهِ كَمَثَلِ حَبَّةٍ أَنْبَتَتْ سَبْعَ سَنَابِلَ فِي كُلِّ سُنْبُلَةٍ مِائَةُ حَبَّةٍ وَاللَّهُ يُضَاعِفُ لِمَنْ يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ} [البقرة: 261] قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( ربِّ زِدْ أمَّتي ) فنزَلت: {مَنْ ذَا الَّذِي يُقْرِضُ اللَّهَ قَرْضًا حَسَنًا فَيُضَاعِفَهُ لَهُ أَضْعَافًا كَثِيرَةً} [البقرة: 245] ",["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( ربِّ زِدْ أمَّتي ) فنزَلت: {",1],["إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُمْ بِغَيْرِ حِسَابٍ",2],"} [الزمر: 10]"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن أبي حاتم في ((التفسير)) (2435)، والطبراني في ((المعجم الأوسط)) (5645)، والبيهقي في ((شعب الإيمان)) (3318) باختلاف يسير","bab":"قرآن › أسباب النزول","dorar":"LGm5VEnJ"},{"id":"س-05752","fp":"1d4fce16da41","stateId":449,"easy":"إذا غلبك النوم عن صلاة الليل فصليتها بين الشروق والظهر ← يُكتب لك أجرها ونومك صدقة","cause":"ما من امرئٍ تكونُ له صلاةٌ بليلٍ فغلبَه عليها نومٌ فيصلي ما بين طلوعِ الشمسِ إلى صلاةِ الظهرِ","result":"إلا كتبَ اللهُ له أجرَ صلاتِه وكان نومُه صدقةً عليه","explicit":true,"ref":"أحكام القرآن لابن العربي 3/449","srcLabel":"أبو داود","text":[["ما من امرئٍ تكونُ له صلاةٌ بليلٍ فغلبَه عليها نومٌ فيصلي ما بين طلوعِ الشمسِ إلى صلاةِ الظهرِ",1]," ",["إلا كتبَ اللهُ له أجرَ صلاتِه وكان نومُه صدقةً عليه",2],"."],"grade":"صحيح","narrator":"[عائشة أم المؤمنين]","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1314)، والنسائي (1784)، وأحمد (24441) باختلاف يسير، وأورده ابن العربي في ((أحكام القرآن)) (6/169) واللفظ له","bab":"رقائق وزهد › النية","dorar":"II3iv8O7","merged":4,"otherRefs":["تخريج المسند لشعيب 25464 (حسن)","تخريج الإحياء للعراقي 1/466 (صحيح)","فيض القدير 5/ 472 (صحيح)"]},{"id":"س-06417","fp":"9bdcb3d94d8f","stateId":449,"easy":"إذا أويت إلى فراشك تنوي قيام الليل فغلبك النوم ← يُكتب لك ما نويت ونومك صدقة","cause":"مَن أتى فراشَه وَهوَ ينوي أن يقومَ يصلِّي منَ اللَّيلِ ، فغلَبتهُ عيناهُ حتَّى أصبحَ","result":"كُتِبَ لَه ما نَوى وَكانَ نومُهُ صدقةً عليهِ من ربِّهِ ، عزَّ وجلَّ","explicit":true,"apply":{"k":"time","t":"عند النوم، في الليل"},"similar":["س-05750","س-05758"],"ref":"صحيح النسائي 1786","srcLabel":"النسائي","text":[["مَن أتى فراشَه وَهوَ ينوي أن يقومَ يصلِّي منَ اللَّيلِ ، فغلَبتهُ عيناهُ حتَّى أصبحَ ",1],["كُتِبَ لَه ما نَوى وَكانَ نومُهُ صدقةً عليهِ من ربِّهِ ، عزَّ وجلَّ",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه النسائي (1787)، وابن ماجه (1344)","bab":"صلاة › النية في الأعمال","dorar":"mutBY1tC","merged":2,"otherRefs":["خلاصة الأحكام للنووي 1/587 (صحيح)"]},{"id":"س-01990","fp":"9d889382bd15","stateId":449,"easy":"إذا كان لك قيام من الليل فنمت عنه ← يُكتب لك أجره ونومك صدقة عليك","cause":"ما من رَجُلٍ تكونُ له ساعةٌ من اللَّيلِ يَقومُها فيَنامُ عنها","result":"إلَّا كُتِبَ له أجْرُ صَلاتِه، وكان نَومُه عليه صَدَقةً، تُصُدِّقَ به عليه","explicit":true,"ref":"تخريج المسند لشعيب 24341","srcLabel":"أبو داود","text":[["ما من رَجُلٍ تكونُ له ساعةٌ من اللَّيلِ يَقومُها فيَنامُ عنها،",1]," ",["إلَّا كُتِبَ له أجْرُ صَلاتِه، وكان نَومُه عليه صَدَقةً، تُصُدِّقَ به عليه",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (1314)، والنسائي (1784)، وأحمد (24341) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"qnkrumVD"},{"id":"س-05750","fp":"bd446a035a21","stateId":449,"easy":"إذا نويت قيام ساعة من الليل فغلبك النوم ← يكون نومك صدقة ويُكتب لك ما نويت","cause":"من حَدَّث نفسَه بساعةٍ من الليلٍ يُصَلِّيها فغَلَبَتْهُ عَيْنُه فنام","result":"كان نومُه صدقةً عليه، وكُتِبَ له مِثْلُ ما أراد أن يُصَلِّيَ","explicit":true,"repOf":"س-06417","ref":"صحيح ابن خزيمة 1173","text":[["من حَدَّث نفسَه بساعةٍ من الليلٍ يُصَلِّيها فغَلَبَتْهُ عَيْنُه فنام، ",1],["كان نومُه صدقةً عليه، وكُتِبَ له مِثْلُ ما أراد أن يُصَلِّيَ ",2],"."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه النسائي (1787)، وابن ماجة (1344)، وابن حبان (2588) باختلاف يسير.","bab":"رقائق وزهد › النية","dorar":"qXs5MJQV"},{"id":"س-05754","fp":"7c4cbe9e9e68","stateId":449,"easy":"إذا نمت عن صلاة الليل ← يكون نومك صدقة ويُكتب لك أجرها","cause":"من كانت لَه صلاةٌ صلَّاها منَ اللَّيلِ ، فَنامَ عنها كانَ ذلِك صدقةً تصدَّقَ اللَّهُ عزَّ وجلَّ عليهِ","result":"وَكتبَ لَه أجرَ صلاتِهِ","explicit":true,"apply":{"k":"time","t":"عند النوم"},"similar":["س-05755"],"ref":"صحيح النسائي 1784","srcLabel":"النسائي","text":[["من كانت لَه صلاةٌ صلَّاها منَ اللَّيلِ ، فَنامَ عنها كانَ ذلِك صدقةً تصدَّقَ اللَّهُ عزَّ وجلَّ عليهِ ، ",1],["وَكتبَ لَه أجرَ صلاتِهِ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه النسائي (1785) واللفظ له، وأحمد (24341)","bab":"رقائق وزهد › النية","dorar":"wMLT9j3o"},{"id":"س-05755","fp":"ee30823701d8","stateId":449,"easy":"إذا نويت صلاة الليل فنسيت ونمت ← يكون نومك صدقة ويُكتب لك ما نويت","cause":"ليس عبدٌ يريدُ صلاةً – وقال مَرَّةً : من الليلِ -، ثم يَنْسَى فينامُ","result":"إلا كان نومُه صدقةً عليه من اللهِ وكُتِبَ له ما نَوَى","explicit":true,"repOf":"س-05754","ref":"صحيح ابن خزيمة 1175","text":[["ليس عبدٌ يريدُ صلاةً – وقال مَرَّةً : من الليلِ -، ثم يَنْسَى فينامُ",1]," ",["إلا كان نومُه صدقةً عليه من اللهِ وكُتِبَ له ما نَوَى",2]," ."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (1787)، وابن ماجة (1344)، وابن حبان (2588) باختلاف يسير.","bab":"رقائق وزهد › النية","dorar":"OWWb4WuP"},{"id":"س-05758","fp":"8c42ca68bf12","stateId":449,"easy":"إذا نويت قيام ساعة من الليل فنمت عنها ← يكون نومك صدقة ويُكتب لك أجرها","cause":"ما مِن عبدٍ يحدِّثُ نفسَهُ بقيامِ ساعةٍ منَ اللَّيلِ فَيَنامُ عنها","result":"إلَّا كانَ نومُهُ صدقةً تصدَّقَ اللَّهُ بِها عليهِ ، وَكُتبَ لَهُ أجرُ ما نوى","explicit":true,"repOf":"س-06417","ref":"الترغيب والترهيب 1/281","text":[["ما مِن عبدٍ يحدِّثُ نفسَهُ بقيامِ ساعةٍ منَ اللَّيلِ فَيَنامُ عنها",1]," ",["إلَّا كانَ نومُهُ صدقةً تصدَّقَ اللَّهُ بِها عليهِ ، وَكُتبَ لَهُ أجرُ ما نوى",2]],"grade":"صحيح","narrator":"أبو ذر الغفاري أو أبو الدرداء","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن المبارك في ((الزهد)) (1239)، وعبد الرزاق (4224)، وابن خزيمة (1174) جميعهم بلفظ مقارب.","bab":"رقائق وزهد › النية","dorar":"KdJwH6gm"},{"id":"س-02834","fp":"b93db630c140","stateId":449,"easy":"إذا سافرت أو مرضت ← يكتب الله لك مثل ما كنت تعمل مقيماً صحيحاً","cause":"إذا سافَر ابنُ آدَمَ أو مرِض","result":"كتَب اللهُ له مِن الأجرِ مثلَ ما كان يعمَلُ وهو مُقيمٌ صحيحٌ","explicit":true,"star":true,"apply":{"k":"time","t":"في السفر"},"ref":"صحيح ابن حبان 2929","srcLabel":"البخاري","text":[["إذا سافَر ابنُ آدَمَ أو مرِض ",1],["كتَب اللهُ له مِن الأجرِ مثلَ ما كان يعمَلُ وهو مُقيمٌ صحيحٌ",2]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (2996) باختلاف يسير","bab":"إيمان › الوعد","dorar":"GrsR8diM"},{"id":"س-07906","fp":"295cf16c687f","stateId":449,"easy":"إذا مرضت أو سافرت ← يُكتب لك من الأجر ما كنت تعمل مقيماً صحيحاً","cause":"إنَّ العبدَ المُسلِمَ إذا مَرِضَ أو سافَرَ","result":"كُتِبَ له مِن الأجْرِ كما كان يَعمَلُ مُقيمًا صَحيحًا","explicit":true,"star":true,"apply":{"k":"time","t":"في السفر"},"similar":["س-07896","س-08195"],"otherNeedIds":[9],"ref":"تخريج المسند لشعيب 19753","srcLabel":"البخاري","text":["سَمِعتُ أبا بُرْدةَ بنَ أبي موسى وهو يقولُ ليَزيدَ بنِ أبي كَبشةَ، واصطَحَبا في سَفرٍ، فكان يَزيدُ يَصومُ في السَّفرِ، فقال له أبو بُرْدةَ: سَمِعتُ أبا موسى مِرارًا يقولُ: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["إنَّ العبدَ المُسلِمَ إذا مَرِضَ أو سافَرَ ",1],["كُتِبَ له مِن الأجْرِ كما كان يَعمَلُ مُقيمًا صَحيحًا",2],". قال محمَّدٌ: -يَعني ابنَ يَزيدَ- كَتَبَ اللهُ له مِثلَ ما كان يَعمَلُ مُقيمًا صَحيحًا."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه البخاري (2996)، وأحمد (19753) واللفظ له","bab":"مريض › فضل المرض والنوائب","dorar":"bJyQODXJ","merged":2,"otherRefs":["صحيح الجامع 799 (صحيح)"]},{"id":"س-03352","fp":"d82229de7c83","stateId":449,"easy":"إذا ابتلاك الله في جسدك ← يُكتب لك ما كنت تعمل في صحتك","cause":"ما مِن مُسلمٍ ابتلاهُ اللهُ في جَسدِه","result":"إلَّا كُتِبَ لهُ ما كان يعملُ في صِحَّتِهِ ، ما كان مَريضًا فإن عافاهُ أراه","explicit":true,"star":true,"similar":["س-05666"],"otherNeedIds":[9],"ref":"صحيح الأدب المفرد 386","srcLabel":"البخاري","text":[["ما مِن مُسلمٍ ابتلاهُ اللهُ في جَسدِه",1]," ",["إلَّا كُتِبَ لهُ ما كان يعملُ في صِحَّتِهِ ، ما كان مَريضًا فإن عافاهُ أراه",2]," قال عسَلَه وفي روايةٍ : وإن قبضَه غُفِرَ لهُ ، وإن شَفاه عسَلَهُ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"حسن صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (501) واللفظ له، وابن أبي الدنيا في ((المرض والكفارات)) (178)، وابن عساكر في ((معجم الشيوخ)) (1485)","bab":"استغفار › أسباب المغفرة","dorar":"w75IBaxi"},{"id":"س-05688","fp":"f0ea7748e8f4","stateId":449,"easy":"إذا شغلك المرض عن عمل كنت تعمله ← يُكتب لك أجره ما دمت في مرضك","cause":"إذا شُغِلَ العَبدُ عَن عَمَلٍ كان يَعمَلُه مَرَضٌ","result":"ابتَلاه اللهُ به كُتِبَ له أجرُ ذلك العَمَلِ ما دامَ في وِثاقِ مَرَضِه","explicit":true,"star":true,"otherNeedIds":[9],"ref":"النفح الشذي 4/163","srcLabel":"البخاري","text":[["إذا شُغِلَ العَبدُ عَن عَمَلٍ كان يَعمَلُه مَرَضٌ ",1],["ابتَلاه اللهُ به كُتِبَ له أجرُ ذلك العَمَلِ ما دامَ في وِثاقِ مَرَضِه",2],"."],"grade":"صحيح","muhaddith":"[ثابت]","takhrij":"أخرجه البخاري (2996)، وأبو داود (3091)، وأحمد (19679) بنحوه.","bab":"رقائق وزهد › الصبر على البلاء","dorar":"FbhkHLXr"},{"id":"س-07896","fp":"7ed41040157f","stateId":449,"easy":"إذا مرضت أو سافرت ← يُكتب لك ما كنت تعمل صحيحاً مقيماً","cause":"إذا مَرِضَ العبدُ أوْ سافرَ","result":"كُتِبَ لهُ من العملِ ما كان يَعْملُ وهو صحيحٌ مُقيمٌ","explicit":true,"apply":{"k":"time","t":"في السفر"},"repOf":"س-07906","ref":"مجموع الفتاوى 10/441","text":[["إذا مَرِضَ العبدُ أوْ سافرَ ",1],["كُتِبَ لهُ من العملِ ما كان يَعْملُ وهو صحيحٌ مُقيمٌ",2],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح","takhrij":"أخرجه البخاري (2996)","bab":"مريض › فضل المرض والنوائب","dorar":"PTxggni5"},{"id":"س-07898","fp":"9ab55d0bf4ee","stateId":449,"easy":"إذا شغلك مرض أو سفر عن عمل صالح ← يُكتب لك كصالح ما كنت تعمل","cause":"إذا كان العَبدُ يَعمَلُ عَمَلًا صالِحًا فشَغَلَه عنْ ذلكَ مَرَضٌ، أو سَفَرٌ","result":"كُتِب له كصالِحِ ما كان يَعمَلُ وهو صَحيحٌ مُقيمٌ","explicit":true,"similar":["س-07907"],"ref":"المستدرك على الصحيحين 1279","srcLabel":"البخاري","text":["سَمِعتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ غَيرَ مَرَّةٍ ولا مَرَّتَين، يَقولُ: ",["إذا كان العَبدُ يَعمَلُ عَمَلًا صالِحًا فشَغَلَه عنْ ذلكَ مَرَضٌ، أو سَفَرٌ؛ ",1],["كُتِب له كصالِحِ ما كان يَعمَلُ وهو صَحيحٌ مُقيمٌ",2],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح على شرط البخاري","takhrij":"أخرجه البخاري (2996)، وأبو داود (3091)، وأحمد (19679) واللفظ لهم.","bab":"مريض › فضل المرض والنوائب","dorar":"zFqTyOaZ"},{"id":"س-08195","fp":"5b31adae479c","stateId":449,"easy":"إذا مرضت ← يُكتب لك مثل ما كنت تعمل صحيحاً","cause":"ما من أحد يمرضُ","result":"إلا كُتِبَ له مثلُ ما كان يعملُ و هو صحيحٌ","explicit":true,"repOf":"س-07906","ref":"صحيح الأدب المفرد 385","text":[["ما من أحد يمرضُ",1]," ",["إلا كُتِبَ له مثلُ ما كان يعملُ و هو صحيحٌ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (500) بلفظه، وأحمد (6482)، والدارمي (2812) كلاهما بمعناه.","bab":"ملائكة › أعمال الملائكة","dorar":"UA6YFhLZ"},{"id":"س-07907","fp":"20f60b8f5e3f","stateId":449,"easy":"إذا شغلك مرض أو سفر عن عملك ← يُكتب لك صالح ما كنت تعمل","cause":"مَن كان يَعمَلُ عَمَلًا، فيَشغَلُه عنه مَرَضٌ أو سَفَرٌ","result":"كُتِبُ له صالِحُ ما كان يَعمَلُ وهو صحيحٌ مُقيمٌ","explicit":true,"repOf":"س-07898","ref":"تخريج مشكل الآثار 2214","text":["سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ لا مرَّةً ولا مرَّتينِ يقولُ: ",["مَن كان يَعمَلُ عَمَلًا، فيَشغَلُه عنه مَرَضٌ أو سَفَرٌ، ",1],["كُتِبُ له صالِحُ ما كان يَعمَلُ وهو صحيحٌ مُقيمٌ",2],"."],"grade":"حسن","narrator":"أبو موسى","muhaddith":"إسناده حسن","takhrij":"أخرجه البخاري (2996) باختلاف يسير","bab":"مريض › فضل المرض والنوائب","dorar":"tsy11Aik"},{"id":"س-08157","fp":"d01cf8368a15","stateId":449,"easy":"إذا كنت على عبادة حسنة ثم مرضت ← يُكتب لك مثل عملك وأنت صحيح","cause":"إذا كانَ على طريقةٍ حسَنةٍ منَ العبادةِ ، ثمَّ مرِضَ","result":"اكتُب لَهُ مثلَ عملِهِ إذا كانَ طليقًا","explicit":true,"otherNeedIds":[9],"ref":"تخريج المسند لشاكر 11/120","srcLabel":"البيهقي","text":["إنَّ العبدَ ",["إذا كانَ على طريقةٍ حسَنةٍ منَ العبادةِ ، ثمَّ مرِضَ",1]," ، قيلَ للملَكِ الموَكَّلِ بِهِ : ",["اكتُب لَهُ مثلَ عملِهِ إذا كانَ طليقًا",2]," ، حتَّى أُطْلِقَهُ ، أو أَكْفِتَهُ إليَّ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه عبدالرزاق (20308)، والدارقطني في ((الأفراد)) كما في ((أطراف الغرائب والأفراد)) لابن طاهر المقدسي (4/20)، والبيهقي (6784)","bab":"ملائكة › أعمال الملائكة","dorar":"EpZsnJsc","merged":2,"otherRefs":["تخريج المسند لشعيب 6916 (صحيح)"]},{"id":"س-04121","fp":"60c9e2b1ec5b","stateId":449,"easy":"إذا حبسك المرض أو غيره عن عملك ← يُكتب لك أجر عملك","cause":"من منعَه اللهُ وحبسَه عن عملِه بمرضٍ أو غيرِه","result":"فإنه يكتبُ له أجرَ عملِه","explicit":true,"otherNeedIds":[9],"ref":"شرح البخاري لابن بطال 3/102","srcLabel":"شرح البخاري لابن بطال","text":["[ الأثرُ ] عن النبيِّ صلَّى اللهُ عليه وسلم أنه ",["من منعَه اللهُ وحبسَه عن عملِه بمرضٍ أو غيرِه ، ",1],["فإنه يكتبُ له أجرَ عملِه",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"جنائز وموت › الصبر على الأمراض والآلام والمصائب","dorar":"AkVHmCk4"},{"id":"س-05668","fp":"ba9aba200df8","stateId":449,"easy":"إذا ابتُليت في جسدك ← يقول الله: اكتبوا لعبدي أفضل ما كان يعمل في صحته","cause":"ما من مُسلِمٍ يُبتلى في جسَدِه","result":"إلَّا قال اللهُ لملائكتِه: اكتُبوا لعبدي أفضَلَ ما كان يعمَلُ في صِحَّتِه","explicit":true,"otherNeedIds":[9],"ref":"المصابيح في الأحاديث المتواترة 616","srcLabel":"المصابيح في الأحاديث المتواترة","text":[["ما من مُسلِمٍ يُبتلى في جسَدِه",1]," ",["إلَّا قال اللهُ لملائكتِه: اكتُبوا لعبدي أفضَلَ ما كان يعمَلُ في صِحَّتِه",2]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"رقائق وزهد › الصبر على البلاء","dorar":"NWBteIrM"},{"id":"س-08167","fp":"3b665ab8c397","stateId":449,"easy":"إذا اشتكيت (مرضت) ← يقول الله: اكتبوا له أفضل ما كان يعمل صحيحاً","cause":"إذا اشتَكَى العبدُ المسلمُ","result":"قال اللهُ تعالى للذين يكتُبونَ : اُكتُبوا له أفضلَ ما كان يعملُ إذا كان طَلِقًا حتى أُطْلِقَه","explicit":true,"apply":{"k":"time","t":"عند المرض والوجع"},"otherNeedIds":[9],"ref":"السلسلة الصحيحة 1232","srcLabel":"أحمد","text":[["إذا اشتَكَى العبدُ المسلمُ ",1],["قال اللهُ تعالى للذين يكتُبونَ : اُكتُبوا له أفضلَ ما كان يعملُ إذا كان طَلِقًا حتى أُطْلِقَه",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6916)، والبزار (2413)، وأبو نعيم في ((حلية الأولياء)) (8/309) باختلاف يسير.","bab":"ملائكة › أعمال الملائكة","dorar":"v2jb8Qzt"},{"id":"س-05666","fp":"fed608592582","stateId":449,"easy":"إذا ابتُليت في جسدك ← يكتب الله لك كل عمل صالح كنت تعمله في صحتك","cause":"ما من مُسلِمٍ يُبتلى ببلاءٍ في جَسَدِه","result":"إلَّا كَتَبَ الله له في مَرَضِه كُلَّ عَمَلٍ صالِحٍ كان يَعمَلُه في صِحَّتِه","explicit":true,"repOf":"س-03352","ref":"تخريج مشكل الآثار 2213","text":[["ما من مُسلِمٍ يُبتلى ببلاءٍ في جَسَدِه",1]," ",["إلَّا كَتَبَ الله له في مَرَضِه كُلَّ عَمَلٍ صالِحٍ كان يَعمَلُه في صِحَّتِه",2],"."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"قوي بشاهده","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (2213) بلفظه، وأخرجه البيهقي في ((شعب الإيمان)) (9465))، والعقيلي في ((الضعفاء الكبير)) (2/ 170))، وابن عساكر في ((تاريخ دمشق)) (6/ 3) جميعًا باختلاف يسير","bab":"رقائق وزهد › الصبر على البلاء","dorar":"6vlaQPZ7"},{"id":"س-04425","fp":"9cbe20513014","stateId":449,"easy":"إذا حبسك العذر عن الخير ← فأنت مع العاملين في الأجر","cause":"حَبَسَهم العُذْرُ","result":"ما سِرْتُم مَسيرًا، ولا قَطَعْتُم وادِيًا إلَّا كانوا معَكم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[49,9],"ref":"الأحكام الوسطى 2/359","srcLabel":"الأحكام الوسطى","text":["[أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ رَجَعَ مِن غَزْوةِ تَبوكَ فقالَ: \"إنَّ بالمَدينةِ أقْوامًا ",["ما سِرْتُم مَسيرًا، ولا قَطَعْتُم وادِيًا إلَّا كانوا معَكم",2],"\"، قالوا: يا رَسولَ اللهِ، وهُمْ بالمَدينةِ؟! قالَ: \"وهُمْ بالمَدينةِ، ",["حَبَسَهم العُذْرُ",1],"\"]. زادَ أبو داوُدَ: \"ولا أَنفَقْتُم مِن نَفَقةٍ\"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","bab":"جهاد › النية في القتال والغزو","dorar":"J07ptGfa","merged":11,"otherRefs":["صحيح ابن ماجه 2250 (صحيح)","صحيح الجامع 2036 (صحيح)","تخريج المسند لشعيب 14675 (صحيح)","صحيح مسلم 1911 (صحيح)","تخريج سنن أبي داود 2508 (صحيح)","صحيح البخاري 2839 (صحيح)","تخريج صحيح ابن حبان 4714 (صحيح)","صحيح الجامع 1575 (صحيح)","تخريج صحيح ابن حبان 4731 (صحيح)","حلية الأولياء 8/291 (صحيح)"]},{"id":"س-02814","fp":"ab6be5fb6c00","stateId":450,"easy":"إذا قعدت حتى تُدفن الجنازة ← فلك قيراطان مثل الجبال","cause":"ومن قَعَد حتى يُدفن","result":"فله قيراطان، قالوا يا رسولَ اللهِ مِثلُ قراريطَنَا هذهِ؟ قالَ لا بلْ مثلُ أُحُدٍ أو أعظَمُ مِن أُحُدٍ","explicit":true,"ref":"صحيح الترغيب 3502","srcLabel":"أحمد","text":["من صلَّى على جِنَازة فله قِيراط، ",["ومن قَعَد حتى يُدفن",1]," ",["فله قيراطان، قالوا يا رسولَ اللهِ مِثلُ قراريطَنَا هذهِ؟ قالَ لا بلْ مثلُ أُحُدٍ أو أعظَمُ مِن أُحُدٍ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (6305)، والطبراني في ((المعجم الأوسط)) (8487) باختلاف يسير","bab":"إيمان › الوعد","dorar":"ZmS81CPH"},{"id":"س-02644","fp":"58416e2fa488","stateId":450,"easy":"إذا تبعت الجنازة ثم رجعت قبل الدفن ← ترجع بقيراط","cause":"فإنْ رجَعَ قَبلَ أنْ توضَعَ في القَبرِ","result":"فإنَّه يَرجِعُ بقيراطٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشعيب 10391","srcLabel":"متفق عليه","text":["مَن تَبِعَ جِنازةَ مُسلِمٍ احتِسابًا، وكان معها حتى يُصَلَّى عليها، ويُفرَغَ مِن دَفنِها؛ فإنَّهُ يَرجِعُ مِنَ الأجْرِ بقيراطَيْنِ، كُلُّ قيراطٍ مِثلُ أُحُدٍ، ومَن صلَّى عليها ورجَعَ قَبلَ أنْ تُدفَنَ؛ فإنَّهُ يَرجِعُ بقيراطٍ. قال إسحاقُ: إيمانًا واحتسابًا. وقال: ",["فإنْ رجَعَ قَبلَ أنْ توضَعَ في القَبرِ؛ ",1],["فإنَّه يَرجِعُ بقيراطٍ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (47)، ومسلم (945)، وأبو داود (3168)، والترمذي (1040)، وابن ماجه (1539) بنحوه، والنسائي (1996) مختصراً، وأحمد (10391) واللفظ له","bab":"إيمان › الاحتساب والنية","dorar":"kRzVhsTX"},{"id":"س-02278","fp":"c93f61caa2d5","stateId":450,"easy":"إذا مشيت مع الجنازة حتى تُدفن ← فلك قيراطان كل قيراط مثل أحد","cause":"ومَن مَشى مع الجِنازةِ حتى تُدفَنَ؛ -وقال مَرَّةً: حتى يُدفَنَ","result":"كان له مِن الأجرِ قيراطانِ، والقيراطُ مِثلُ أُحُدٍ","explicit":true,"ref":"تخريج المسند لشعيب 18597","srcLabel":"الطحاوي","text":["نحو حديث: [مَن تَبِعَ جِنازةً حتى يُصلِّيَ عليها؛ كان له مِن الأجرِ قيراطٌ، ",["ومَن مَشى مع الجِنازةِ حتى تُدفَنَ؛ -وقال مَرَّةً: حتى  يُدفَنَ- ",1],["كان له مِن الأجرِ قيراطانِ، والقيراطُ مِثلُ أُحُدٍ",2],".]"],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"[إسناده صحيح]","takhrij":"أخرجه الطحاوي في \"شرح مشكل الآثار\" (1264)، وأخرجه ابن الأثير في \"أسد الغابة\" 1/205","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"WZH5x71G"},{"id":"س-08260","fp":"7f54f0811479","stateId":450,"easy":"إذا صليت على جنازة ← فلك قيراط","cause":"مَن صلَّى على جِنازةً","result":"فله قِيراطٌ","explicit":true,"star":true,"similar":["س-08263","س-00510","س-08261","س-01958","س-08256","س-00586","س-00587","س-00588","س-01957","س-02109","س-02120","س-02643","س-06999","س-08257","س-08259","س-08262","س-01993","س-02131","س-07148","س-02235","س-00498","س-01591","س-01592","س-01983","س-01986","س-02055"],"ref":"تخريج المسند لشعيب 9016","srcLabel":"متفق عليه","text":[["مَن صلَّى على جِنازةً ",1],["فله قِيراطٌ، ",2],"ومَن صلَّى عليها وتَبِعَها فله قيراطانِ. فقالَ له عبدُ اللهِ بنُ عُمرَ: انظُرْ ما تُحدِّثُ به يا أبا هُرَيرةَ؛ فإنَّك تُكثِرُ الحديثَ عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فأخَذَ بيَدِه، فذهَبَ به إلى عائشةَ، فصدَّقَتْ أبا هُرَيرةَ، فقال أبو هُرَيرةَ: واللهِ يا أبا عبدِ الرحمنِ، ما كان يَشغَلُني عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ الصَّفْقُ في الأسواقِ، ما كان يُهِمُّني مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ إلَّا كلمةٌ يُعَلِّمُنيها، أو لُقمةٌ يُلقِمُنيها."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (47)، ومسلم (945)، وأبو داود (3168)، والترمذي (1040)، والنسائي (1997)، وابن ماجه (1539)، وأحمد (9016) واللفظ له","bab":"مناقب وفضائل › أبو هريرة","dorar":"zsPVnK9G","merged":8,"otherRefs":["صحيح الجامع 6353 (صحيح)","تخريج المسند لشعيب 7353 (صحيح)","علل الدارقطني 1892 (حسن)","صحيح الترغيب 3502 (صحيح)","تخريج المسند لشعيب 10468 (صحيح)","تخريج المسند لشعيب 7188 (صحيح)","صحيح مسلم 945 (صحيح)"]},{"id":"س-08263","fp":"25dbe18b1ca0","stateId":450,"easy":"إذا تبعت جنازة فصليت عليها ← فلك قيراط، وإن شهدت دفنها فقيراطان","cause":"مَن تبِعَ جِنازةً فصَلَّى عليها","result":"فله قِيراطٌ، وإنْ شهِدَ دَفنَها فله قِيراطانِ","explicit":true,"repOf":"س-08260","ref":"المستدرك على الصحيحين 6308","text":["عنِ ابنِ عُمَرَ رَضيَ اللهُ عنهما، أنَّه مرَّ بأبي هُرَيرةَ رَضيَ اللهُ عنه وهو يُحدِّثُ عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ: مَن تبِعَ جِنازةً فله قِيراطٌ، فإنْ شهِدَ دَفنَها فله قِيراطانِ، القِيراطُ أعظَمُ مِن أُحدٍ فقالَ ابنُ عُمرَ: يا أبا هِرٍّ، انظُرْ ما تُحدِّثُ عنْ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقامَ إليه أبو هُرَيرةَ حتَّى انطلَقَ إلى عائشةَ رَضيَ اللهُ عنها، فقالَ لها: يا أمَّ المُؤمِنينَ، أنشُدُكِ اللهَ، أسمِعْتِ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["مَن تبِعَ جِنازةً فصَلَّى عليها ",1],["فله قِيراطٌ، وإنْ شهِدَ دَفنَها فله قِيراطانِ",2],"؟ فقالَتِ: اللَّهمَّ نعمْ، فقالَ أبو هُرَيرةَ: إنَّه لم يكُنْ يَشغَلُنا عنْ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ غَرسٌ، ولا صَفقٌ بالأسْواقِ، إنَّما كنْتُ أطلُبُ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ كَلِمةً يُعلِّمُنيها أو أكْلةً يُطْعِمُنيها. فقالَ ابنُ عُمَرَ: يا أبا هُرَيرةَ، كنْتَ ألزَمَنا لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وأعلَمَنا بحَديثِه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (4453) بنحوه، وهو عند البخاري (47)، ومسلم (53) دون ذكر قصته","bab":"مناقب وفضائل › أبو هريرة","dorar":"kkY3BeGd","merged":5,"otherRefs":["تخريج المسند لشعيب 10758 (صحيح)","صحيح الجامع 6137 (حسن)","تخريج المسند لشعيب 18597 (صحيح)","تخريج مشكل الآثار 1262 (صحيح)"]},{"id":"س-00510","fp":"c0ec48fd1cf8","stateId":450,"easy":"إذا شهدت الجنازة حتى يُصلّى عليها ← فلك قيراط","cause":"مَن شَهِدَ الجِنازةَ حتَّى يُصَلَّى عليها","result":"فلَه قيراطٌ","explicit":true,"repOf":"س-08260","ref":"صحيح مسلم 945","text":[["مَن شَهِدَ الجِنازةَ حتَّى يُصَلَّى عليها ",1],["فلَه قيراطٌ، ",2],"ومَن شَهِدَها حتَّى تُدفَنَ فلَه قيراطانِ، قيلَ: وما القيراطانِ؟ قال: مِثلُ الجَبَلَينِ العَظيمَينِ انتَهى حَديثُ أبي الطَّاهِرِ. وزادَ الآخَرانِ، قال ابنُ شِهابٍ: قال سالِمُ بنُ عبدِ اللهِ بنِ عُمَرَ: وكانَ ابنُ عُمَرَ، يُصَلِّي عليها ثُمَّ يَنصَرِفُ، فلَمَّا بَلَغَه حَديثُ أبي هُرَيرةَ، قال: لقد ضَيَّعنا قَراريطَ كَثيرةً. [وفي روايةٍ]: عَنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم إلى قَولِه: الجَبَلَينِ العَظيمَينِ، ولَم يَذكُرا ما بَعدَه [وفي روايةٍ]: وفي حَديثِ عبدِ الأعلى: حتَّى يُفرَغَ مِنها. وفي حَديثِ عبدِ الرَّزَّاقِ: حتَّى توضَعَ في اللَّحدِ. [وفي روايةٍ]: وقال: ومَنِ اتَّبَعَها حتَّى تُدفَنَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (47) بنحوه. وقول ابن عمر أخرجه البخاري (1324) باختلاف يسير","bab":"آداب عامة › ضرب الأمثال","dorar":"rYKPNAY2","merged":3,"otherRefs":["تخريج المسند لشعيب 11920 (صحيح)","تخريج مشكل الآثار 1266 (صحيح)"]},{"id":"س-08261","fp":"4b945a6d8575","stateId":450,"easy":"إذا صليت عليها وتبعتها ← فلك قيراطان","cause":"ومَن صلَّى عليها وتَبِعَها","result":"فله قيراطانِ","explicit":true,"repOf":"س-08260","ref":"تخريج المسند لشعيب 9016","text":["مَن صلَّى على جِنازةً فله قِيراطٌ، ",["ومَن صلَّى عليها وتَبِعَها ",1],["فله قيراطانِ",2],". فقالَ له عبدُ اللهِ بنُ عُمرَ: انظُرْ ما تُحدِّثُ به يا أبا هُرَيرةَ؛ فإنَّك تُكثِرُ الحديثَ عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فأخَذَ بيَدِه، فذهَبَ به إلى عائشةَ، فصدَّقَتْ أبا هُرَيرةَ، فقال أبو هُرَيرةَ: واللهِ يا أبا عبدِ الرحمنِ، ما كان يَشغَلُني عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ الصَّفْقُ في الأسواقِ، ما كان يُهِمُّني مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ إلَّا كلمةٌ يُعَلِّمُنيها، أو لُقمةٌ يُلقِمُنيها."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (47)، ومسلم (945)، وأبو داود (3168)، والترمذي (1040)، والنسائي (1997)، وابن ماجه (1539)، وأحمد (9016) واللفظ له","bab":"مناقب وفضائل › أبو هريرة","dorar":"zsPVnK9G","merged":3,"otherRefs":["علل الدارقطني 1892 (حسن)","صحيح مسلم 945 (صحيح)"]},{"id":"س-01958","fp":"255facb70978","stateId":450,"easy":"إذا صليت عليها ولم تتبعها ← فلك قيراط مثل أحد","cause":"ومن صلَّى ولَم يَتبَعها","result":"فلَه قيراطٌ مِثلُ أُحُدٍ","explicit":true,"repOf":"س-08260","ref":"تخريج المسند لشعيب 7690","text":["مَن صلَّى على جِنازَةٍ فاتَّبَعَها؛ فلَه قيراطان مِثلُ أُحُدٍ، ",["ومن صلَّى ولَم يَتبَعها؛ ",1],["فلَه قيراطٌ مِثلُ أُحُدٍ",2],". قال ابنُ بَكرٍ: القيراطُ مِثلُ أُحُدٍ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (47)، ومسلم (945)، وأبو داود (3168)، والترمذي (1040)، والنسائي (1997)، وابن ماجه (1539)، وأحمد (7690) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"UmqBlAIy","merged":2,"otherRefs":["تخريج المسند لشعيب 11152 (صحيح)"]},{"id":"س-08256","fp":"87594a4b08a8","stateId":450,"easy":"إذا خرجت مع جنازة من بيتها وصليت عليها وتبعتها حتى الدفن ← فلك قيراطان كل قيراط مثل أحد","cause":"مَن خَرَجَ مع جِنازةٍ مِن بَيتِها، وصَلَّى عليها، ثُمَّ تَبِعَها حتَّى تُدفَنَ","result":"كان له قيراطانِ مِن أجرٍ، كُلُّ قيراطٍ مِثلُ أُحُدٍ","explicit":true,"repOf":"س-08260","ref":"صحيح مسلم 945","text":["أنَّه كان قاعِدًا عِندَ عبدِ اللهِ بنِ عُمَرَ إذ طَلَعَ خَبَّابٌ صاحِبُ المَقصورةِ، فقال: يا عَبدَ اللهِ بنَ عُمَرَ: ألا تَسمَعُ ما يقولُ أبو هُرَيرةَ، أنَّه سَمِعَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["مَن خَرَجَ مع جِنازةٍ مِن بَيتِها، وصَلَّى عليها، ثُمَّ تَبِعَها حتَّى تُدفَنَ، ",1],["كان له قيراطانِ مِن أجرٍ، كُلُّ قيراطٍ مِثلُ أُحُدٍ، ",2],"ومَن صَلَّى عليها، ثُمَّ رَجَعَ، كان له مِنَ الأجرِ مِثلُ أُحُدٍ، فأرسَلَ ابنُ عُمَرَ خَبَّابًا إلى عائِشةَ يَسألُها عن قَولِ أبي هُرَيرةَ، ثُمَّ يَرجِعُ إليه فيُخبِرُه ما قالت: وأخَذَ ابنُ عُمَرَ قَبضةً مِن حَصى المَسجِدِ يُقَلِّبُها في يَدِه، حتَّى رَجَعَ إليه الرَّسولُ، فقال: قالت عائِشةُ: صَدَقَ أبو هُرَيرةَ، فضَرَبَ ابنُ عُمَرَ بالحَصى الذي كان في يَدِه الأرضَ، ثُمَّ قال: لقد فرَّطنا في قَراريطَ كَثيرةٍ!"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1325) مختصراً. وقول ابن عمر: \"لقد فرطنا في قراريط كثيرة\" أخرجه البخاري (1324)","bab":"مناقب وفضائل › أبو هريرة","dorar":"YxD0sSP7","merged":2,"otherRefs":["تخريج صحيح ابن حبان 3079 (صحيح)"]},{"id":"س-00511","fp":"8d219c215389","stateId":450,"easy":"إذا شهدتها حتى تُدفن ← فلك قيراطان","cause":"ومَن شَهِدَها حتَّى تُدفَنَ","result":"فلَه قيراطانِ، قيلَ: وما القيراطانِ","explicit":true,"star":true,"ref":"صحيح مسلم 945","srcLabel":"البخاري","text":["مَن شَهِدَ الجِنازةَ حتَّى يُصَلَّى عليها فلَه قيراطٌ، ",["ومَن شَهِدَها حتَّى تُدفَنَ ",1],["فلَه قيراطانِ، قيلَ: وما القيراطانِ",2],"؟ قال: مِثلُ الجَبَلَينِ العَظيمَينِ انتَهى حَديثُ أبي الطَّاهِرِ. وزادَ الآخَرانِ، قال ابنُ شِهابٍ: قال سالِمُ بنُ عبدِ اللهِ بنِ عُمَرَ: وكانَ ابنُ عُمَرَ، يُصَلِّي عليها ثُمَّ يَنصَرِفُ، فلَمَّا بَلَغَه حَديثُ أبي هُرَيرةَ، قال: لقد ضَيَّعنا قَراريطَ كَثيرةً. [وفي روايةٍ]: عَنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم إلى قَولِه: الجَبَلَينِ العَظيمَينِ، ولَم يَذكُرا ما بَعدَه [وفي روايةٍ]: وفي حَديثِ عبدِ الأعلى: حتَّى يُفرَغَ مِنها. وفي حَديثِ عبدِ الرَّزَّاقِ: حتَّى توضَعَ في اللَّحدِ. [وفي روايةٍ]: وقال: ومَنِ اتَّبَعَها حتَّى تُدفَنَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (47) بنحوه. وقول ابن عمر أخرجه البخاري (1324) باختلاف يسير","bab":"آداب عامة › ضرب الأمثال","dorar":"rYKPNAY2"},{"id":"س-00520","fp":"4a0920646e94","stateId":450,"easy":"إذا انتظرت الجنازة حتى توضع في اللحد ← فلك قيراطان مثل الجبلين العظيمين","cause":"ومَنِ انتظرها حتى تُوضَعَ فى اللحدِ","result":"فله قِيراطانِ ، والقِيراطانِ مِثْلُ الجَبَلَيْنِ العَظِيمَيْنِ","explicit":true,"star":true,"similar":["س-07006"],"ref":"صحيح الجامع 6353","srcLabel":"متفق عليه","text":["مَن صلى على جَنازةٍ فله قِيراطٌ ، ",["ومَنِ انتظرها حتى تُوضَعَ فى اللحدِ ، ",1],["فله قِيراطانِ ، والقِيراطانِ مِثْلُ الجَبَلَيْنِ العَظِيمَيْنِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (1994)، وأحمد (7775) واللفظ لهما، وأخرجه البخاري (1325)، ومسلم (945) باختلاف يسير","bab":"آداب عامة › ضرب الأمثال","dorar":"LtBL2AQz"},{"id":"س-00586","fp":"bd8cad05883d","stateId":450,"easy":"إذا مشيت مع جنازة حتى يُفرغ منها ← فلك قيراطان","cause":"مَن مشَى مع جِنازةٍ حتى تفرُغَ","result":"فله قيراطانِ","explicit":true,"repOf":"س-08260","ref":"تخريج مشكل الآثار 1263","text":[["مَن مشَى مع جِنازةٍ حتى تفرُغَ ",1],["فله قيراطانِ، ",2],"ومَن رجَع قبْلَ أنْ يفرُغَ منها، فله قيراطٌ، قال: قُلْنا: يا رسولَ اللهِ، وما القيراطُ؟ قال: مِثْلُ أُحُدٍ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في  ((شرح مشكل الآثار)) (1263) واللفظ له، والبخاري (47)، ومسلم (945) كلاهما بنحوه.","bab":"آداب عامة › ضرب الأمثال","dorar":"9MOUcth1"},{"id":"س-00587","fp":"e4b5cbf6a360","stateId":450,"easy":"إذا رجعت قبل أن يُفرغ منها ← فلك قيراط","cause":"ومَن رجَع قبْلَ أنْ يفرُغَ منها","result":"فله قيراطٌ، قال: قُلْنا: يا رسولَ اللهِ، وما القيراطُ","explicit":true,"repOf":"س-08260","ref":"تخريج مشكل الآثار 1263","text":["مَن مشَى مع جِنازةٍ حتى تفرُغَ فله قيراطانِ، ",["ومَن رجَع قبْلَ أنْ يفرُغَ منها، ",1],["فله قيراطٌ، قال: قُلْنا: يا رسولَ اللهِ، وما القيراطُ",2],"؟ قال: مِثْلُ أُحُدٍ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في  ((شرح مشكل الآثار)) (1263) واللفظ له، والبخاري (47)، ومسلم (945) كلاهما بنحوه.","bab":"آداب عامة › ضرب الأمثال","dorar":"9MOUcth1"},{"id":"س-00588","fp":"0d4d5494b700","stateId":450,"easy":"إذا تبعت جنازة من أهلها حتى صليت عليها ← فلك قيراط، وحتى دفنها قيراطان مثل أحد","cause":"مَن جاء جِنازةً فتَبِعها مِن أهلِها حتى يُصلِّيَ عليها","result":"فله قيراطٌ، وإنْ مضَى معها حتى تُدْفَنَ، فله قيراطانِ مِثْلُ أُحُدٍ","explicit":true,"repOf":"س-08260","ref":"تخريج مشكل الآثار 1261","text":["مِثْلَهُ، وزاد: قيل: يا رسولَ اللهِ، وما القيراطانِ؟ قال: مِثْلُ الجَبَلَيْنِ العظيمَيْنِ. [يعني حديثَ: ",["مَن جاء جِنازةً فتَبِعها مِن أهلِها حتى يُصلِّيَ عليها، ",1],["فله قيراطٌ، وإنْ مضَى معها حتى تُدْفَنَ، فله قيراطانِ مِثْلُ أُحُدٍ",2],".]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الطحاوي في  ((شرح مشكل الآثار)) (1261) واللفظ له, والبخاري (1325)، ومسلم (945) كلاهما باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"gxKNRg1O"},{"id":"س-01883","fp":"d04158936a34","stateId":450,"easy":"إذا أتيت جنازة في أهلها ← فلك قيراط، فإن اتبعتها فقيراط، فإن صليت عليها فقيراط","cause":"مَنْ أَتَى جَنَازَةً في أهْلِهَا","result":"فَلَهُ قيراطٌ فإِنِ اتَّبَعَها فلَهُ قيراطٌ فإِنْ صلَّى علَيْهَا فلَهُ قيراطٌ فإِنْ انتظَرها حتى تُدْفَنَ فَلَهُ قِيرَاطٌ","explicit":true,"star":true,"ref":"مجمع الزوائد 3/33","srcLabel":"متفق عليه","text":[["مَنْ أَتَى جَنَازَةً في أهْلِهَا ",1],["فَلَهُ قيراطٌ فإِنِ اتَّبَعَها فلَهُ قيراطٌ فإِنْ صلَّى علَيْهَا فلَهُ قيراطٌ فإِنْ انتظَرها حتى تُدْفَنَ فَلَهُ قِيرَاطٌ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"فيه معدي بن سليمان وبقية رجاله رجال الصحيح","takhrij":"أخرجه البخاري (1325)، ومسلم (945)، وأبو داود (3168)، والترمذي (1040)، والنسائي (1997)، وابن ماجه (1539)، وأحمد (7188) مختصراً بمعناه، والبزار (8387) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"yhLQYOjw"},{"id":"س-01957","fp":"223cc390e196","stateId":450,"easy":"إذا صليت على جنازة واتبعتها ← فلك قيراطان مثل أحد","cause":"مَن صلَّى على جِنازَةٍ فاتَّبَعَها","result":"فلَه قيراطان مِثلُ أُحُدٍ","explicit":true,"repOf":"س-08260","ref":"تخريج المسند لشعيب 7690","text":[["مَن صلَّى على جِنازَةٍ فاتَّبَعَها؛ ",1],["فلَه قيراطان مِثلُ أُحُدٍ، ",2],"ومن صلَّى ولَم يَتبَعها؛ فلَه قيراطٌ مِثلُ أُحُدٍ. قال ابنُ بَكرٍ: القيراطُ مِثلُ أُحُدٍ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (47)، ومسلم (945)، وأبو داود (3168)، والترمذي (1040)، والنسائي (1997)، وابن ماجه (1539)، وأحمد (7690) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"UmqBlAIy"},{"id":"س-02108","fp":"57df65e1e326","stateId":450,"easy":"إذا تبعت جنازة مسلم إيماناً واحتساباً حتى تُوضع في القبر ← ترجع بقيراطين مثل أحد","cause":"مَن اتَّبَع جنازةَ مسلمٍ إيمانًا واحتسابًا حتَّى يُصلِّيَ عليها ثمَّ يقعُدُ حتَّى يوضَعَ في قبرِه","result":"فإنَّه يرجِعُ وله قيراطانِ مِن الأجرِ وهما مِثلُ أُحُدٍ","explicit":true,"similar":["س-02642"],"ref":"تخريج صحيح ابن حبان 3080","srcLabel":"متفق عليه","text":[["مَن اتَّبَع جنازةَ مسلمٍ إيمانًا واحتسابًا حتَّى يُصلِّيَ عليها ثمَّ يقعُدُ حتَّى يوضَعَ في قبرِه ",1],["فإنَّه يرجِعُ وله قيراطانِ مِن الأجرِ وهما مِثلُ أُحُدٍ ",2],"ومَن صلَّى عليها ثمَّ رجَع قبْلَ أنْ يوضَعَ في القبرِ فله قيراطٌ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (3080) بلفظه، والبخاري (47) بلفظ مقارب، ومسلم (945)، والنسائي (5032) كلاهما بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"jOkLcNVc"},{"id":"س-02109","fp":"61885cd0de8f","stateId":450,"easy":"إذا صليت عليها ثم رجعت قبل الدفن ← فلك قيراط","cause":"ومَن صلَّى عليها ثمَّ رجَع قبْلَ أنْ يوضَعَ في القبرِ","result":"فله قيراطٌ","explicit":true,"repOf":"س-08260","ref":"تخريج صحيح ابن حبان 3080","text":["مَن اتَّبَع جنازةَ مسلمٍ إيمانًا واحتسابًا حتَّى يُصلِّيَ عليها ثمَّ يقعُدُ حتَّى يوضَعَ في قبرِه فإنَّه يرجِعُ وله قيراطانِ مِن الأجرِ وهما مِثلُ أُحُدٍ ",["ومَن صلَّى عليها ثمَّ رجَع قبْلَ أنْ يوضَعَ في القبرِ ",1],["فله قيراطٌ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (3080) بلفظه، والبخاري (47) بلفظ مقارب، ومسلم (945)، والنسائي (5032) كلاهما بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"jOkLcNVc"},{"id":"س-02120","fp":"28ed5aa20d07","stateId":450,"easy":"إذا اتبعت الجنازة حتى يُفرغ من شأنها ← فلك قيراطان أصغرهما مثل أحد","cause":"ومَنِ اتبَعَها حتى يُفْرَغَ مِن شَأْنِـها","result":"فلَه قِيراطانِ، أَصْغَرُهما أو أَحَدُهما مِثْلُ أُحُدٍ","explicit":true,"repOf":"س-08260","ref":"تخريج المسند لشعيب 7353","text":["مَن صلَّى على جَنازَةٍ فلَه قِيراطٌ، ",["ومَنِ اتبَعَها حتى يُفْرَغَ مِن شَأْنِـها ",1],["فلَه قِيراطانِ، أَصْغَرُهما أو أَحَدُهما مِثْلُ أُحُدٍ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (47)، ومسلم (945)، وأبو داود (3168)، والترمذي (1040)، والنسائي (1997)، وابن ماجه (1539)، وأحمد (7353) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"msBRtuYb"},{"id":"س-02642","fp":"dd0b666ec8ac","stateId":450,"easy":"إذا تبعت جنازة مسلم احتساباً حتى يُصلى عليها ويُدفن ← ترجع بقيراطين","cause":"مَن تَبِعَ جِنازةَ مُسلِمٍ احتِسابًا","result":"وكان معها حتى يُصَلَّى عليها، ويُفرَغَ مِن دَفنِها؛ فإنَّهُ يَرجِعُ مِنَ الأجْرِ بقيراطَيْنِ، كُلُّ قيراطٍ مِثلُ أُحُدٍ","explicit":true,"repOf":"س-02108","ref":"تخريج المسند لشعيب 10391","text":[["مَن تَبِعَ جِنازةَ مُسلِمٍ احتِسابًا، ",1],["وكان معها حتى يُصَلَّى عليها، ويُفرَغَ مِن دَفنِها؛ فإنَّهُ يَرجِعُ مِنَ الأجْرِ بقيراطَيْنِ، كُلُّ قيراطٍ مِثلُ أُحُدٍ، ",2],"ومَن صلَّى عليها ورجَعَ قَبلَ أنْ تُدفَنَ؛ فإنَّهُ يَرجِعُ بقيراطٍ. قال إسحاقُ: إيمانًا واحتسابًا. وقال: فإنْ رجَعَ قَبلَ أنْ توضَعَ في القَبرِ؛ فإنَّه يَرجِعُ بقيراطٍ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (47)، ومسلم (945)، وأبو داود (3168)، والترمذي (1040)، وابن ماجه (1539) بنحوه، والنسائي (1996) مختصراً، وأحمد (10391) واللفظ له","bab":"إيمان › الاحتساب والنية","dorar":"kRzVhsTX"},{"id":"س-02643","fp":"551ad1d6d231","stateId":450,"easy":"إذا صليت عليها ورجعت قبل الدفن ← ترجع بقيراط","cause":"ومَن صلَّى عليها ورجَعَ قَبلَ أنْ تُدفَنَ","result":"فإنَّهُ يَرجِعُ بقيراطٍ","explicit":true,"repOf":"س-08260","ref":"تخريج المسند لشعيب 10391","text":["مَن تَبِعَ جِنازةَ مُسلِمٍ احتِسابًا، وكان معها حتى يُصَلَّى عليها، ويُفرَغَ مِن دَفنِها؛ فإنَّهُ يَرجِعُ مِنَ الأجْرِ بقيراطَيْنِ، كُلُّ قيراطٍ مِثلُ أُحُدٍ، ",["ومَن صلَّى عليها ورجَعَ قَبلَ أنْ تُدفَنَ؛ ",1],["فإنَّهُ يَرجِعُ بقيراطٍ",2],". قال إسحاقُ: إيمانًا واحتسابًا. وقال: فإنْ رجَعَ قَبلَ أنْ توضَعَ في القَبرِ؛ فإنَّه يَرجِعُ بقيراطٍ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (47)، ومسلم (945)، وأبو داود (3168)، والترمذي (1040)، وابن ماجه (1539) بنحوه، والنسائي (1996) مختصراً، وأحمد (10391) واللفظ له","bab":"إيمان › الاحتساب والنية","dorar":"kRzVhsTX"},{"id":"س-03693","fp":"2317aa77742d","stateId":450,"easy":"إذا تبعت جنازة فحملتها وحثوت في قبرها وقعدت حتى يؤذن لك ← ترجع بقيراطين","cause":"مَن تَبِعَ جِنازةً فحمَلَ مِن عُلُوِّها، وحثَا في قَبرِها، وقعَدَ حتى يُؤذَنَ له","result":"آبَ بقيراطَيْنِ مِن الأجرِ، كُلُّ قيراطٍ مِثلُ أُحُدٍ","explicit":true,"ref":"تخريج المسند لشعيب 10875","srcLabel":"متفق عليه","text":[["مَن تَبِعَ جِنازةً فحمَلَ مِن عُلُوِّها، وحثَا في قَبرِها، وقعَدَ حتى يُؤذَنَ له؛ ",1],["آبَ بقيراطَيْنِ مِن الأجرِ، كُلُّ قيراطٍ مِثلُ أُحُدٍ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (47)، ومسلم (945)، وأبو داود (3168)، والترمذي (1040)، والنسائي (1997)، وابن ماجه (1539) بنحوه، وأحمد (10875) واللفظ له","bab":"اعتصام بالسنة › لزوم السنة","dorar":"HsVknMuD"},{"id":"س-06999","fp":"0686bd526b8a","stateId":450,"easy":"إذا تبعت الجنازة حتى يُقضى دفنها ← فلك قيراطان أصغرهما مثل أحد","cause":"ومَن تَبِعَها حتى يُقضى دَفنُها","result":"فله قيراطانِ، أحدُهما -أو أصغَرُهما- مِثلُ أُحُدٍ","explicit":true,"repOf":"س-08260","ref":"تخريج المسند لشعيب 10468","text":["مَن صلَّى على جِنازةٍ فله قيراطٌ، ",["ومَن تَبِعَها حتى يُقضى دَفنُها، ",1],["فله قيراطانِ، أحدُهما -أو أصغَرُهما- مِثلُ أُحُدٍ",2],". قال أبو سَلَمةَ: فذكَرتُ لابنِ عُمَرَ، فتعاظَمَهُ، فأرسَلَ إلى عائِشةَ، فقالتْ: صدَقَ أبو هُرَيرةَ. فقال ابنُ عُمَرَ: لقد فرَّطْنا في قَراريطَ كَثيرةٍ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (47)، ومسلم (945)، وأبو داود (3168)، والترمذي (1040)، والنسائي (1997)، وابن ماجه (1539)، وأحمد (10468) واللفظ له","bab":"علم › الحث على الأخذ بالسنة","dorar":"ZNDf5qxX"},{"id":"س-07006","fp":"288fb0506818","stateId":450,"easy":"إذا انتظرت حتى يُفرغ من الجنازة ← فلك قيراطان","cause":"ومَن انتظَرَ حتى يُفْرَغَ منها","result":"فلَهُ قِيراطان، قالوا: وما القِيراطان","explicit":true,"repOf":"س-00520","ref":"تخريج المسند لشعيب 7188","text":["مَن صَلَّى على جَنَازَةٍ فلَهُ قِيراطٌ، ",["ومَن انتظَرَ حتى يُفْرَغَ منها ",1],["فلَهُ قِيراطان، قالوا: وما القِيراطان",2],"؟ قال: مِثْلُ الـجَبَلَينِ العَظيمَينِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (1325)، ومسلم (945) باختلاف يسير","bab":"علم › الحث على الأخذ بالسنة","dorar":"BnAgqCez"},{"id":"س-08257","fp":"d34b87226086","stateId":450,"easy":"إذا صليت عليها ثم رجعت ← فلك أجر مثل أحد","cause":"ومَن صَلَّى عليها، ثُمَّ رَجَعَ","result":"كان له مِنَ الأجرِ مِثلُ أُحُدٍ","explicit":true,"repOf":"س-08260","ref":"صحيح مسلم 945","text":["أنَّه كان قاعِدًا عِندَ عبدِ اللهِ بنِ عُمَرَ إذ طَلَعَ خَبَّابٌ صاحِبُ المَقصورةِ، فقال: يا عَبدَ اللهِ بنَ عُمَرَ: ألا تَسمَعُ ما يقولُ أبو هُرَيرةَ، أنَّه سَمِعَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: مَن خَرَجَ مع جِنازةٍ مِن بَيتِها، وصَلَّى عليها، ثُمَّ تَبِعَها حتَّى تُدفَنَ، كان له قيراطانِ مِن أجرٍ، كُلُّ قيراطٍ مِثلُ أُحُدٍ، ",["ومَن صَلَّى عليها، ثُمَّ رَجَعَ، ",1],["كان له مِنَ الأجرِ مِثلُ أُحُدٍ",2],"، فأرسَلَ ابنُ عُمَرَ خَبَّابًا إلى عائِشةَ يَسألُها عن قَولِ أبي هُرَيرةَ، ثُمَّ يَرجِعُ إليه فيُخبِرُه ما قالت: وأخَذَ ابنُ عُمَرَ قَبضةً مِن حَصى المَسجِدِ يُقَلِّبُها في يَدِه، حتَّى رَجَعَ إليه الرَّسولُ، فقال: قالت عائِشةُ: صَدَقَ أبو هُرَيرةَ، فضَرَبَ ابنُ عُمَرَ بالحَصى الذي كان في يَدِه الأرضَ، ثُمَّ قال: لقد فرَّطنا في قَراريطَ كَثيرةٍ!"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1325) مختصراً. وقول ابن عمر: \"لقد فرطنا في قراريط كثيرة\" أخرجه البخاري (1324)","bab":"مناقب وفضائل › أبو هريرة","dorar":"YxD0sSP7"},{"id":"س-08259","fp":"e66c2d34ef8d","stateId":450,"easy":"إذا رجعت بعد الصلاة على الجنازة ولم تتبعها ← فلك قيراط مثل أحد","cause":"ومَن رجَع عنها بعدما يُصلِّي ولم يتبَعْها","result":"كان له قيراطٌ مثلُ أُحدٍ","explicit":true,"apply":{"k":"time","t":"دبر كل صلاة"},"repOf":"س-08260","ref":"تخريج صحيح ابن حبان 3079","text":["أنَّه كان قاعدًا مع ابنِ عمرَ فاطَّلَع صاحبُ المقصورةِ قال: يا عبدَ اللهِ بنَ عمرَ ألَا تسمَعُ ما يقولُ أبو هُرَيرة ؟ إنَّه سمِع رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( مَن تبِع جنازةً مِن بيتِها حتَّى يُصلِّيَ عليها ثمَّ تبِعها حتَّى يدفنَها كان له قيراطانِ كلُّ قيراطٍ مثلُ أُحُدٍ ",["ومَن رجَع عنها بعدما يُصلِّي ولم يتبَعْها ",1],["كان له قيراطٌ مثلُ أُحدٍ )",2]," \nفقال ابنُ عمرَ اذهَبْ إلى عائشةَ فسَلْها عن قولِ أبي هُرَيرةَ ثمَّ ارجِعْ إليَّ فأخبِرْني بما قالت، قال: وأخَذ ابنُ عمرَ قبضةً مِن حصاةٍ فجعَل يُقلِّبُها بيدِه حتَّى رجَع الرَّسولُ فقال: قالت: صدَق أبو هُرَيرةَ فرمى ابنُ عمرَ الحصى إلى الأرضِ مِن يدِه وقال: لقد فرَّطْنا في قراريطَ كثيرةٍ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده حسن على شرط مسلم","takhrij":"أخرجه ابن حبان (3079) واللفظ له، والبخاري (47)، ومسلم (945كلاهما بنحوه.","bab":"مناقب وفضائل › أبو هريرة","dorar":"lajYmZ7u"},{"id":"س-08262","fp":"119c0330cb51","stateId":450,"easy":"إذا تبعت جنازة ← فلك قيراط، وإن شهدت دفنها فقيراطان أعظم من أحد","cause":"مَن تبِعَ جِنازةً","result":"فله قِيراطٌ، فإنْ شهِدَ دَفنَها فله قِيراطانِ، القِيراطُ أعظَمُ مِن أُحدٍ","explicit":true,"repOf":"س-08260","ref":"المستدرك على الصحيحين 6308","text":["عنِ ابنِ عُمَرَ رَضيَ اللهُ عنهما، أنَّه مرَّ بأبي هُرَيرةَ رَضيَ اللهُ عنه وهو يُحدِّثُ عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ: ",["مَن تبِعَ جِنازةً ",1],["فله قِيراطٌ، فإنْ شهِدَ دَفنَها فله قِيراطانِ، القِيراطُ أعظَمُ مِن أُحدٍ",2]," فقالَ ابنُ عُمرَ: يا أبا هِرٍّ، انظُرْ ما تُحدِّثُ عنْ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقامَ إليه أبو هُرَيرةَ حتَّى انطلَقَ إلى عائشةَ رَضيَ اللهُ عنها، فقالَ لها: يا أمَّ المُؤمِنينَ، أنشُدُكِ اللهَ، أسمِعْتِ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: مَن تبِعَ جِنازةً فصَلَّى عليها فله قِيراطٌ، وإنْ شهِدَ دَفنَها فله قِيراطانِ؟ فقالَتِ: اللَّهمَّ نعمْ، فقالَ أبو هُرَيرةَ: إنَّه لم يكُنْ يَشغَلُنا عنْ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ غَرسٌ، ولا صَفقٌ بالأسْواقِ، إنَّما كنْتُ أطلُبُ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ كَلِمةً يُعلِّمُنيها أو أكْلةً يُطْعِمُنيها. فقالَ ابنُ عُمَرَ: يا أبا هُرَيرةَ، كنْتَ ألزَمَنا لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وأعلَمَنا بحَديثِه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (4453) بنحوه، وهو عند البخاري (47)، ومسلم (53) دون ذكر قصته","bab":"مناقب وفضائل › أبو هريرة","dorar":"kkY3BeGd"},{"id":"س-01993","fp":"df109025b75f","stateId":450,"easy":"إذا انتظرت حتى يُقضى دفن الجنازة ← فلك قيراطان","cause":"ومَنِ انتظَر حتى يُقْضى دَفْنُها","result":"فله قيراطانِ","explicit":true,"repOf":"س-08260","ref":"تخريج مشكل الآثار 1266","text":["مَنِ اتَّبَع جِنازةً حتى يُصَلَّى عليها، فله قيراطٌ، ",["ومَنِ انتظَر حتى يُقْضى دَفْنُها، ",1],["فله قيراطانِ",2],". قيل: وما القيراطانِ يا رسولَ اللهِ؟ قال: أصغَرُهما مِثْلُ أُحُدٍ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح بطرقه","takhrij":"أخرجه مسلم (945) بنحوه","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"KR4wEYk8","merged":2,"otherRefs":["تخريج المسند لشعيب 10758 (صحيح)"]},{"id":"س-02131","fp":"89817c9ff877","stateId":450,"easy":"إذا صليت على جنازة ← فلك قيراط، فإن انتظرت الدفن فقيراطان","cause":"مَن صلَّى على جِنازةٍ، أو قال: مَن مشَى مع جِنازةٍ","result":"فله قيراطٌ، فإنِ انتظَر حتى تُدْفَنَ، فله قيراطانِ، والقيراطانِ مِثْلُ الجَبَلَيْنِ العظيمَيْنِ","explicit":true,"repOf":"س-08260","ref":"تخريج مشكل الآثار 1265","text":[["مَن صلَّى على جِنازةٍ، أو قال: مَن مشَى مع جِنازةٍ، ",1],["فله قيراطٌ، فإنِ انتظَر حتى تُدْفَنَ، فله قيراطانِ، والقيراطانِ مِثْلُ الجَبَلَيْنِ العظيمَيْنِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (945) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"c6jFvrl4"},{"id":"س-07148","fp":"ce83f0e0bfe2","stateId":450,"easy":"إذا صليت على جنازة ← فلك قيراط، وإن شهدت دفنها فقيراطان","cause":"مَن صَلَّى على جِنازةٍ","result":"فله قيراطٌ، فإنْ شَهِدَ دَفنَها فله قيراطانِ، فسُئِلَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ عن ذلك القيراطِ","explicit":true,"repOf":"س-08260","ref":"تخريج المسند لشعيب 22455","text":[["مَن صَلَّى على جِنازةٍ ",1],["فله قيراطٌ، فإنْ شَهِدَ دَفنَها فله قيراطانِ، فسُئِلَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ عن ذلك القيراطِ",2],"، فقال: مِثلُ أُحُدٍ."],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه مسلم (946)، وابن ماجه (1540)، وأحمد (22455) واللفظ له","bab":"علم › حسن السؤال ونصح العالم","dorar":"LUQTRVMP"},{"id":"س-02235","fp":"28ab5b22205d","stateId":450,"easy":"إذا تبعت الجنازة فصليت عليها وقعدت حتى يُفرغ من دفنها ← فلك قيراطان كل واحد أعظم من أحد","cause":"ومَنْ تبِعَها فصلَّى عليْها ، ثُمَّ قعَدَ حتَّى فرَغَ منْها ومِنْ دَفْنِها","result":"فَلَهُ قيراطانِ مِنَ الأجْرِ ، كُلُّ واحدٍ منها أعظمٌ مِنْ أُحُدٍ","explicit":true,"repOf":"س-08260","ref":"صحيح الجامع 6137","text":["مَنْ تَبِعَ جنازَةً فصَلَّى عليْها ، ثُمَّ انصرفَ ، فلَهُ قيراطٌ منَ الأجرِ ، ",["ومَنْ تبِعَها فصلَّى عليْها ، ثُمَّ قعَدَ حتَّى فرَغَ منْها ومِنْ دَفْنِها ، ",1],["فَلَهُ قيراطانِ مِنَ الأجْرِ ، كُلُّ واحدٍ منها أعظمٌ مِنْ أُحُدٍ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه النسائي (1997) باختلاف يسير، وأخرجه البخاري (47)، ومسلم (945) بنحوه","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Q5nYTAxz"},{"id":"س-00498","fp":"5fc557407df9","stateId":450,"easy":"إذا صليت على جنازة ← فلك قيراط، وإن شهدت دفنها فقيراطان","cause":"مَن صلَّى علَى جِنازةٍ","result":"فلَه قيراطٌ ومن شَهِدَها حتَّى تُدفَنَ فلَه قيراطانِ والَّذي نفسُ محمَّدٍ بيدِه القيراطُ أعظَمُ من أُحُدٍ هذا","explicit":true,"repOf":"س-08260","ref":"صحيح ابن ماجه 1261","text":[["مَن صلَّى علَى جِنازةٍ ",1],["فلَه قيراطٌ ومن شَهِدَها حتَّى تُدفَنَ فلَه قيراطانِ والَّذي نفسُ محمَّدٍ بيدِه القيراطُ أعظَمُ من أُحُدٍ هذا",2]],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"صحيح","bab":"آداب عامة › ضرب الأمثال","dorar":"qKzdzlji"},{"id":"س-01591","fp":"35f6586bfdd6","stateId":450,"easy":"إذا تبعت جنازة حتى يُصلّى عليها ويُفرغ منها ← فلك قيراطان","cause":"مَن تَبِعَ جِنازةً حتى يُصلَّى عليها، ويُفرَغَ منها","result":"فله قيراطانِ","explicit":true,"repOf":"س-08260","ref":"تخريج المسند لشعيب 35/129","text":["وزادَ في هذه الرِّوايةِ: [أيْ في رِوايةِ: ",["مَن تَبِعَ جِنازةً حتى يُصلَّى عليها، ويُفرَغَ منها، ",1],["فله قيراطانِ، ",2],"ومَن تَبِعَها حتى يُصلَّى عليها، فله قيراطٌ، والذي نفْسُ محمَّدٍ بيَدِه، لَهو أثقَلُ في ميزانِه من أُحُدٍ]: ومَن أكَلَ من هذه البَقْلةِ الخَبيثةِ، فلا يَقرَبَنَّ مسجِدَنا."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (1541)، وأحمد (21201) مختصراً، والطبراني في ((المعجم الأوسط)) (554) باختلاف يسير","bab":"أطعمة › أكل الثوم والبصل والكراث","dorar":"PBsXdKCQ"},{"id":"س-01592","fp":"d9e99ff2cc2c","stateId":450,"easy":"إذا تبعتها حتى يُصلّى عليها ← فلك قيراط أثقل في ميزانك من أحد","cause":"ومَن تَبِعَها حتى يُصلَّى عليها","result":"فله قيراطٌ، والذي نفْسُ محمَّدٍ بيَدِه، لَهو أثقَلُ في ميزانِه","explicit":true,"repOf":"س-08260","otherNeedIds":[65],"ref":"تخريج المسند لشعيب 35/129","text":["وزادَ في هذه الرِّوايةِ: [أيْ في رِوايةِ: مَن تَبِعَ جِنازةً حتى يُصلَّى عليها، ويُفرَغَ منها، فله قيراطانِ، ",["ومَن تَبِعَها حتى يُصلَّى عليها، ",1],["فله قيراطٌ، والذي نفْسُ محمَّدٍ بيَدِه، لَهو أثقَلُ في ميزانِه ",2],"من أُحُدٍ]: ومَن أكَلَ من هذه البَقْلةِ الخَبيثةِ، فلا يَقرَبَنَّ مسجِدَنا."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (1541)، وأحمد (21201) مختصراً، والطبراني في ((المعجم الأوسط)) (554) باختلاف يسير","bab":"أطعمة › أكل الثوم والبصل والكراث","dorar":"PBsXdKCQ"},{"id":"س-01925","fp":"11d30a1d1aa2","stateId":450,"easy":"إذا أوذنت بجنازة فعزّيت أهلها ← يكتب الله لك قيراطاً، وإن شيعتها فقيراطان","cause":"مَنْ أُوْذِنَ بجنازةٍ فأتى أهلَهَا فعزَّاهُم","result":"كَتَبَ اللهُ لَهُ قِيراطًا فإنْ شيعَهَا كتبَ اللهُ لَهُ قيراطَينِ فإنْ صلَّى عليها كتبَ اللهُ لَهُ ثلاثةَ قراريطٍ فإنْ شَهِدَ دفنَهَا كتبَ اللهُ لَهُ أربعةَ قراريطٍ القيراطُ مثلَ أُحُدٍ","explicit":true,"ref":"عمدة القاري 1/424","srcLabel":"ابن حبان","text":[["مَنْ أُوْذِنَ بجنازةٍ فأتى أهلَهَا فعزَّاهُم ",1],["كَتَبَ اللهُ لَهُ قِيراطًا فإنْ شيعَهَا كتبَ اللهُ لَهُ قيراطَينِ فإنْ صلَّى عليها كتبَ اللهُ لَهُ ثلاثةَ قراريطٍ فإنْ شَهِدَ دفنَهَا كتبَ اللهُ لَهُ أربعةَ قراريطٍ القيراطُ مثلَ أُحُدٍ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"في السنن الصحاح","takhrij":"أخرجه ابن حبان في ((المجروحين)) (2/296)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Gr3eB5cY"},{"id":"س-01966","fp":"731eda82e44c","stateId":450,"easy":"إذا مضيت مع الجنازة ← فلك قيراطان مثل أحد","cause":"ومَن مَضى معها","result":"فله قيراطانِ مِثلَ أُحُدٍ","explicit":true,"ref":"تخريج المسند لشعيب 11920","srcLabel":"أحمد","text":["مَن جاءَ جِنازةً في أهْلِها فتَبِعَها حتى يُصَلَّى عليها فله قيراطٌ، ",["ومَن مَضى معها ",1],["فله قيراطانِ مِثلَ أُحُدٍ",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (11920) واللفظ له، وابن أبي شيبة (11740)، والبزار كما في ((مجمع الزوائد)) للهيثمي (3/32)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"XKUmaMYE"},{"id":"س-01983","fp":"edfa2cb6fa13","stateId":450,"easy":"إذا تبعت جنازة حتى يُصلّى عليها ← فلك قيراط","cause":"مَن تَبِعَ جِنازَةً حتى يُصلَّى عليها","result":"فإنَّ له قيراطًا، فسُئِلَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم عن القيراطِ","explicit":true,"repOf":"س-08260","ref":"تخريج المسند لشعيب 4650","text":[["مَن تَبِعَ جِنازَةً حتى يُصلَّى عليها، ",1],["فإنَّ له قيراطًا، فسُئِلَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم عن القيراطِ",2],"؟ فقال: مِثلُ أُحُدٍ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (4650) واللفظ له، وابن أبي شيبة (11741) مختصراً، والطبراني في ((المعجم الأوسط)) (8487) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"wYe4lzcy"},{"id":"س-01986","fp":"57f7d2bf74ef","stateId":450,"easy":"إذا صليت عليها ولم تشيعها ← فلك قيراط مثل أحد","cause":"ومَن صلَّى عليها ولم يُشيِّعْها","result":"كان له قيراطٌ، والقيراطُ مِثلُ أُحُدٍ","explicit":true,"repOf":"س-08260","ref":"تخريج المسند لشعيب 11152","text":["\"من صلَّى على جِنازةٍ وشيَّعها، كان له قيراطانِ، ",["ومَن صلَّى عليها ولم يُشيِّعْها، ",1],["كان له قيراطٌ، والقيراطُ مِثلُ أُحُدٍ\"",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (11152) واللفظ له، وابن أبي شيبة (11740)، والبزار كما في ((مجمع الزوائد)) للهيثمي (3/32)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Xl3MNQ9r"},{"id":"س-02055","fp":"1baf3bebea51","stateId":450,"easy":"إذا تبعت جنازة حتى يُفرغ منها ← فلك قيراطان، وإن رجعت قبل فقيراط","cause":"مَنْ تَبِعَ جنازَةً حتى يُفْرَغَ منها","result":"فلَهُ قيراطانِ ، فإِنْ رجعَ قبلَ أنْ يُفْرَغَ منها ، فله قيراطٌ","explicit":true,"repOf":"س-08260","ref":"صحيح الجامع 6136","text":[["مَنْ تَبِعَ جنازَةً حتى يُفْرَغَ منها ، ",1],["فلَهُ قيراطانِ ، فإِنْ رجعَ قبلَ أنْ يُفْرَغَ منها ، فله قيراطٌ",2]],"grade":"صحيح","narrator":"عبدالله بن مغفل","muhaddith":"صحيح","takhrij":"أخرجه النسائي (1941) بلفظه، وأحمد (20575)، والروياني (878) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"ZsgixUFS"},{"id":"س-08373","fp":"76c034c3739f","stateId":450,"easy":"إذا مشيت خلف الجنازة ← فهو أفضل من المشي أمامها","cause":"المشيُ خلفَها","result":"أفضلُ منَ المَشيِ أمامَها","explicit":true,"ref":"نخب الافكار 7/256","srcLabel":"أحمد","text":["قلتُ لَعليِّ بنِ أبي طالبٍ رضيَ اللَّهُ عنهُ ، ما تَقولُ في المشيِ أمامَ الجنازةِ ؟ فقالَ عليُّ رضيَ اللَّهُ عنهُ: ",["المشيُ خلفَها ",1],["أفضلُ منَ المَشيِ أمامَها ",2],"، كفَضلِ المَكْتوبةِ على التَّطوُّعِ . قُلتُ ، ما لي أرى  بَكْرٍ وعمرَ رضيَ اللَّهُ عنهما يَمشيانِ أمامَها ، فقالَ: إنَّهما يَكْرَهانِ أن يُحْرِجا النَّاسَ"],"grade":"صحيح","narrator":"عمرو بن حريث","muhaddith":"طريقه صحيح","takhrij":"أخرجه الطحاوي في ((معاني الآثار)) (2761) واللفظ له، وأحمد (754)، والحارث في ((مسنده)) (249) في أثناء حديث طويل.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"02b0tOLH"},{"id":"س-00208","fp":"48ebf878cdaf","stateId":451,"easy":"إذا أضفت ضيفاً فوق ثلاثة أيام ← فهو صدقة","cause":"للضَّيفِ على من نزل به من الحقِّ ثلاثٌ ، فما زاد","result":"فهو صدقةٌ","explicit":true,"similar":["س-03791","س-01931","س-01934","س-06316","س-06354"],"ref":"صحيح الترغيب 2590","srcLabel":"أحمد","text":[["للضَّيفِ على من نزل به من الحقِّ ثلاثٌ ، فما زاد",1]," ",["فهو صدقةٌ",2]," ، وعلى الضَّيفِ أن يرتحِلَ ؛ لا يُؤَثّمُ أهلَ المنزلِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (7873) مختصراً، والبزار (9674)، وأبو يعلي (6134) باختلاف يسير.","bab":"آداب المجلس › إكرام الضيف","dorar":"ltgl9y0P"},{"id":"س-03791","fp":"ec530df0c83b","stateId":451,"easy":"إذا أضفت فوق الثلاث ← فهو صدقة","cause":"فما زاد على ذلك","result":"فهو صَدَقةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-00208","ref":"تخريج المسند لشعيب 11325","text":["\"الضِّيافةُ ثلاثٌ، ",["فما زاد على ذلك",1]," ",["فهو صَدَقةٌ",2],"\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (11325) واللفظ له، وعبد بن حميد (868)، والبزار (6)","bab":"بر وصلة › إكرام الزائر","dorar":"hi9uwq5I"},{"id":"س-01931","fp":"5a6b89b7623d","stateId":451,"easy":"إذا أضفت ضيفك فوق ثلاثة أيام ← فهو صدقة","cause":"فما زاد","result":"فهو صدقةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-00208","ref":"الجامع الصغير 5222","text":["الضيافةُ ثلاثةُ أيامٍ ، ",["فما زاد",1]," ",["فهو صدقةٌ",2]," ، وعلى الضيفِ أن يَتَحَوَّلَ بعد ثلاثةِ أيامٍ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3749 )،وأحمد (7860 )، وأبو يعلى (5890 )","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"EMSAT2AR","merged":2,"otherRefs":["صحيح الترغيب 2595 (صحيح)"]},{"id":"س-01934","fp":"d8cf83e5a1b6","stateId":451,"easy":"إذا أضفت فوق ثلاث ليال ← فهو صدقة","cause":"فما سوى ذلكَ","result":"فهو صدقةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-00208","ref":"الجامع الصغير 5221","text":["الضيافةُ ثلاثُ ليالٍ حقٌّ لازمٌ،  ",["فما سوى ذلكَ",1]," ",["فهو صدقةٌ",2]],"grade":"صحيح","narrator":"التلب بن ثعلبة التميمي","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (2/ 63) (1297)، إبراهيم الحربي في ((إكرام الضيف)) (123) بلفظه، والروياني في ((المسند)) (1461)، وابن قانع في ((معجم الصحابة)) (1/ 112) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"XkDfcV0q","merged":2,"otherRefs":["التمهيد 21/48 (حسن)"]},{"id":"س-06291","fp":"128d3ebf9d67","stateId":451,"easy":"إذا أطال الضيف فوق ثلاث ← فما أنفقت عليه صدقة","cause":"فما جَلَسَ بعْدَ ذلك","result":"فهو عليه صَدَقةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشعيب 11726","srcLabel":"أحمد","text":["مَن كان يُؤمِنُ باللهِ واليَومِ الآخِرِ، فلْيُكرِمْ ضَيفَه قالَها ثلاثًا، قال: وما كَرامةُ الضَّيفِ يا رسولَ اللهِ؟ قال: ثلاثةُ أيَّامٍ، ",["فما جَلَسَ بعْدَ ذلك",1]," ",["فهو عليه صَدَقةٌ",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (11726) واللفظ له، والحربي في ((إكرام الضيف)) (35) مختصراً، والبزار كما في ((مجمع الزوائد)) للهيثمي (8/179) باختلاف يسير","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"X794lWGA"},{"id":"س-06316","fp":"d46bee3b92ff","stateId":451,"easy":"إذا أضفت بعد الثلاث ← فهو صدقة","cause":"فما كان بعدَ ذلكَ","result":"فَصَدَقَةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-00208","ref":"صحيح الترغيب 2593","text":["الضِّيافَةُ ثلاثَةُ أيامٍ حقٌّ لازِمٌ ، ",["فما كان بعدَ ذلكَ",1]," ",["فَصَدَقَةٌ",2]],"grade":"صحيح","narrator":"التلب بن ثعلبة التميمي","muhaddith":"صحيح لغيره","takhrij":"أخرجه الحربي في ((إكرام الضيف)) (123)، والروياني في ((مسنده)) (1461)، والطبراني (2/63) (1297) واللفظ له","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"k2XFfP2P"},{"id":"س-06354","fp":"88fc26e11da8","stateId":451,"easy":"إذا أضفت فوق الثلاث ← فهو صدقة","cause":"فما ورَاءها","result":"فهوَ صدقةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-00208","ref":"صحيح الموارد 1736","text":["الضِّيافَةُ ثلاثَةُ أيامٍ ؛ ",["فما ورَاءها",1]," ",["فهوَ صدقةٌ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه أبو داود (3749)، وأحمد (8630) باختلاف يسير، وابن حبان (5284) واللفظ له.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"1jhTj6hY"},{"id":"س-01281","fp":"7cb91419adca","stateId":452,"easy":"إذا أمرت بالمعروف ← فهو صدقة","cause":"وأمرٌ بالمعروفِ","result":"صدقةٌ","explicit":true,"similar":["س-06085"],"ref":"آداب الزفاف 65","srcLabel":"مسلم","text":["أنَّ ناسًا من أصحابِ النبيِّ صلَّى اللهُ عليه وسلَّم قالوا للنبيِّ صلَّى اللهُ عليه وسلَّم : يا رسولَ اللهِ ! ذهب أهلُ الدُّثورِ بالأجورِ ، يُصَلُّون كما نصلي ، ويصومون كما نصومُ ، ويتصدقون بفضولِ أموالِهِم ، قال : أَوَلَيْس قد جعل اللهُ لكم ما تَصَدَّقُون ؟ إن بكلِّ تسبيحةٍ صدقةً ، [ وبكلِّ تكبيرةٍ صدقةً ، وبكلِّ تهليلةٍ صدقةً ، وبكلِّ تحميدةٍ صدقةً ] ، ",["وأمرٌ بالمعروفِ",1]," ",["صدقةٌ",2]," ، ونهيٌ عن منكرٍ صدقةٌ ، وفي بُضْعِ أحدِكم صدقةٌ ! قالوا : يا رسولَ اللهِ ! أيأتي أحدُنا شهوتَه ويكونُ له فيها أجرٌ ؟ ! قال : أرأيتم لو وضعها في حرامٍ أكان عليه فيها وزرٌ ؟ [ قالوا : بلى ، قال : ] فكذلك إذا وضعها في الحلالِ كان له [ فيها ] أجرٌ ، [ وذكر أشياءَ : صدقةً ، صدقةً ، ثم قال : ويُجْزِئُ من هذا كلِّه ركعتا الضُّحَى ] ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"أخرجه مسلم والزيادات كلها له،وإسنادها صحيح على شرط مسلم، وللنسائي الزيادة الأخيرة","takhrij":"أخرجه مسلم (720، 1006) مفرقاً باختلاف يسير","bab":"نكاح › الحث على التزويج","dorar":"miAsobHq","merged":2,"otherRefs":["صحيح مسلم 720 (صحيح)"]},{"id":"س-05775","fp":"f7be1919f593","stateId":452,"easy":"إذا أصلحت ذات البين ← فهو أفضل من درجة الصلاة والصيام والصدقة (النافلة)","cause":"قالوا : بلى يا رسولَ اللهِ . قال : إصلاحُ ذاتِ البَيْنِ فإنَّ فسادَ ذاتِ البَيْنِ هي الحالِقَةُ . لا أقولُ : إنها تَحْلِقُ الشَّعْرَ ولكن تَحْلِقُ الدِّينَ","result":"أَلَا أَدُلُّكُم على أَفْضَلَ من درجةِ الصلاةِ والصيامِ والصدقةِ","explicit":true,"otherNeedIds":[41,47],"ref":"غاية المرام 414","srcLabel":"أبو داود","text":[["أَلَا أَدُلُّكُم على أَفْضَلَ من درجةِ الصلاةِ والصيامِ والصدقةِ ",2],"؟",[" قالوا : بلى يا رسولَ اللهِ . قال : إصلاحُ ذاتِ البَيْنِ فإنَّ فسادَ ذاتِ البَيْنِ هي الحالِقَةُ . لا أقولُ : إنها تَحْلِقُ الشَّعْرَ ولكن تَحْلِقُ الدِّينَ",1]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4919)، والترمذي (2509) باختلاف يسير، وأحمد (6/ 444).","bab":"رقائق وزهد › الوصايا النافعة","dorar":"d0i5H327","merged":6,"otherRefs":["صحيح الأدب المفرد 319 (صحيح)","سنن الترمذي 2509 (صحيح)","صحيح الأدب المفرد 303 (صحيح)","البحر الزخار 10/46 (صحيح)","الترغيب والترهيب 3/405 (صحيح)"]},{"id":"ق-0247","fp":"a2b717b7bf73","stateId":452,"easy":"الأمر بالصدقة والمعروف والإصلاح بين الناس ابتغاء مرضاة الله ← أجر عظيم","cause":"الأمر بالصدقة والمعروف والإصلاح بين الناس ابتغاء مرضاة الله","result":"أجر عظيم","explicit":true,"ref":"سورة النساء: 114","srcLabel":"القرآن الكريم","quran":{"s":4,"from":114,"to":114,"text":"لَا خَيْرَ فِي كَثِيرٍ مِنْ نَجْوَاهُمْ إِلَّا مَنْ أَمَرَ بِصَدَقَةٍ أَوْ مَعْرُوفٍ أَوْ إِصْلَاحٍ بَيْنَ النَّاسِ وَمَنْ يَفْعَلْ ذَلِكَ ابْتِغَاءَ مَرْضَاتِ اللَّهِ فَسَوْفَ نُؤْتِيهِ أَجْرًا عَظِيمًا (114)","hl":[[0,203,1]]}},{"id":"س-00958","fp":"9522adad1638","stateId":452,"easy":"إذا نهيت عن المنكر ← فهو صدقة","cause":"وإنَّ نَهيَكَ عَنِ المنكَرَ","result":"صَدَقةٌ","explicit":true,"similar":["س-06086"],"ref":"تخريج المسند لشعيب 8354","srcLabel":"متفق عليه","text":["على كلِّ سُلامَى مِنِ ابنِ آدمَ صدَقةٌ حين يُصبِحُ، فشَقَّ ذلك على المسلمينَ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّ سَلامَكَ على عبادِ اللهِ صَدقةٌ، وإماطتَكَ الأذى عَنِ الطريقِ صَدَقةٌ، وإنَّ أَمْرَكَ بالمعروفِ صَدَقةٌ، ",["وإنَّ نَهيَكَ عَنِ المنكَرَ",1]," ",["صَدَقةٌ",2],"، وحَدَّثَ أشياءَ مِن نحوِ هذا لم أَحفَظْها."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن لغيره","takhrij":"أخرجه البخاري (2989)، ومسلم (1009) بنحوه، وأحمد (8354) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"OsBtFBHr"},{"id":"س-06085","fp":"2a48408e160b","stateId":452,"easy":"إذا أمرت بالمعروف ← فهو صدقة","cause":"وإنَّ أَمْرَك بالمعروفِ","result":"صدقةٌ","explicit":true,"repOf":"س-01281","ref":"صحيح الترغيب 2686","text":["إنَّ تبسُّمُك في وجهِ أخيك يُكْتَبُ لك به صدقةٌ ، ( وإنَّ إفراغَك من دَلْوِكَ فى دَلْوِ أخيك يُكْتَبُ لك به صدقةٌ ( ، وإماطتَك الأذى عن الطريقِ يُكْتَبُ لك به صدقةٌ ، ",["وإنَّ أَمْرَك بالمعروفِ",1]," ",["صدقةٌ",2]," ، ( ونَهْيَك عن المنكرِ يُكْتَبُ لك به صدقةٌ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه البزار (6096، 6097) مفرقاً، والطبراني في ((المعجم الأوسط)) (8342) باختلاف يسير","bab":"رقائق وزهد › ما جاء في فعل الخير","dorar":"5Vs1sEoO","merged":2,"otherRefs":["تخريج المسند لشعيب 8354 (حسن)"]},{"id":"س-05776","fp":"4fa9ae2b6b56","stateId":452,"easy":"إذا أصلحت بين الناس ← فهي صدقة يحب الله موضعها","cause":"تُصلِحُ بين النَّاسِ","result":"فإنَّها صدقةٌ يُحبُّ اللهُ موضعَها","explicit":true,"similar":["س-05926"],"ref":"الترغيب والترهيب 3/406","srcLabel":"البيهقي","text":["ألا أدلُّك على صدقةٍ يحبُّها اللهُ موضعَها قال قلتُ بأبي وأمَّي قال ",["تُصلِحُ بين النَّاسِ ",1],["فإنَّها صدقةٌ يُحبُّ اللهُ موضعَها",2]],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه قوام السنة في ((الترغيب الترهيب)) (180) واللفظ له، والطيالسي (599)، والبيهقي في ((الشعب)) (10583) بنحوه.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"xlE0KBhw"},{"id":"س-06086","fp":"e6adf5fd59f1","stateId":452,"easy":"إذا نهيت عن المنكر ← يُكتب لك صدقة","cause":"ونَهْيَك عن المنكرِ","result":"يُكْتَبُ لك به صدقةٌ","explicit":true,"repOf":"س-00958","ref":"صحيح الترغيب 2686","text":["إنَّ تبسُّمُك في وجهِ أخيك يُكْتَبُ لك به صدقةٌ ، ( وإنَّ إفراغَك من دَلْوِكَ فى دَلْوِ أخيك يُكْتَبُ لك به صدقةٌ ( ، وإماطتَك الأذى عن الطريقِ يُكْتَبُ لك به صدقةٌ ، وإنَّ أَمْرَك بالمعروفِ صدقةٌ ، ( ",["ونَهْيَك عن المنكرِ",1]," ",["يُكْتَبُ لك به صدقةٌ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه البزار (6096، 6097) مفرقاً، والطبراني في ((المعجم الأوسط)) (8342) باختلاف يسير","bab":"رقائق وزهد › ما جاء في فعل الخير","dorar":"5Vs1sEoO"},{"id":"س-05926","fp":"67a2fc3ad443","stateId":452,"easy":"إذا أصلحت بين الناس إذا تفاسدوا ← فهي تجارة رابحة","cause":"صِلْ بين الناسِ إذا تفاسدوا ، وقرِّبْ بينهم إذا تباعَدوا","result":"ألا أدُلُّك على تجارةٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-05776","otherNeedIds":[41],"ref":"صحيح الترغيب 2818","text":[["ألا أدُلُّك على تجارةٍ",2]," ؟ . قال : بلى . قال : ",["صِلْ بين الناسِ إذا تفاسدوا ، وقرِّبْ بينهم إذا تباعَدوا",1]," ."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن لغيره","takhrij":"أخرجه البزار كما في ((كشف الأستار)) للهيثمي (2060) واللفظ له، والرافعي في ((التدوين)) (4/163) باختلاف يسير","bab":"رقائق وزهد › الوصايا النافعة","dorar":"Qyr0cWmE"},{"id":"س-02686","fp":"c4d6717d4fd8","stateId":453,"easy":"إذا خدمت إخوانك الصائمين في السفر ← تذهب بالأجر","cause":"وكان المُفطرونَ يتعمَّلون ويشتوون","result":"ذهب المُفطرونَ بالأجرِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مسند ابن عباس 1/106","srcLabel":"متفق عليه","text":["خرجنا مع رسولِ اللهِ صلَّى اللهُ عليه وسلم في سفرٍ يعني في شهرِ رمضانَ فمنا الصائمُ ومنَّا المُفطِرُ وكان الصائمُ أفضلَ في أنفسِنا من المُفطرِ ",["وكان المُفطرونَ يتعمَّلون ويشتوون",1]," قال فذُكِرَ ذلك لرسولِ اللهِ صلَّى اللهُ عليه وسلم فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["ذهب المُفطرونَ بالأجرِ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (2890)، ومسلم (1119)، وأبو داود (2405) بمعناه.","bab":"إيمان › الدين يسر","dorar":"zgP7WIjE"},{"id":"س-02617","fp":"374d7f207872","stateId":453,"easy":"إذا أعنت ضائعاً أو صنعت لأخرق ← فهو صدقة","cause":"تُعينُ ضائِعًا، أو تَصنَعُ لِأخرَقَ","result":"فإنْ لم أستَطِعْ ذلك","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"تخريج المسند لشعيب 10878","srcLabel":"متفق عليه","text":["أنَّ رَجُلًا، أتى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فقال: يا رسولَ اللهِ، أيُّ الأعمالِ أفضَلُ؟ قال: الإيمانُ باللهِ، والجِهادُ في سَبيلِ اللهِ. قال: فإنْ لم أستَطِعْ ذلك؟ قال: ",["تُعينُ ضائِعًا، أو تَصنَعُ لِأخرَقَ",1],". قال: ",["فإنْ لم أستَطِعْ ذلك",2],"؟ قال: احبِسْ نَفْسَكَ عن الشَّرِّ؛ فإنَّها صَدَقةٌ تَصَدَّقُ بها على نَفْسِكَ."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه البخاري (1519)، ومسلم (83)، والترمذي (1658)، والنسائي (2624) أوله في أثناء حديث، وأحمد (10878) واللفظ له","bab":"إيمان › الأمر بالإيمان بالله تعالى ورسوله وشرائع الدين","dorar":"66cc0zkA"},{"id":"س-02833","fp":"dfaa44f4598e","stateId":453,"easy":"إذا خففت عن خادمك من عمله ← فهو أجر لك في ميزانك يوم القيامة","cause":"ما خفَّفتَ عن خادمِك مِن عَملِه","result":"فَهوَ أجرٌ لَك في موازينِك يومَ القيامةِ","explicit":true,"ref":"الجامع الصغير 7880","srcLabel":"ابن حبان","text":[["ما خفَّفتَ عن خادمِك مِن عَملِه",1]," ",["فَهوَ أجرٌ لَك في موازينِك يومَ القيامةِ",2]],"grade":"صحيح","narrator":"عمرو بن حريث المصري","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (4314)، والبيهقي في ((شعب الإيمان)) (8226)، وعبد بن حميد في ((المسند)) (284)، بلفظه ولم يذكروا فيه يوم القيامة","bab":"إيمان › الوعد","dorar":"fxvWuDHL","merged":2,"otherRefs":["صحيح ابن حبان 4314 (صحيح)"]},{"id":"س-06389","fp":"43e15529682f","stateId":453,"easy":"إذا مشيت بحق أخيك إليه لتقضيه ← فلك به صدقة","cause":"مَن مَشى بحَقِّه إلى أخيه ليَقْضيَه","result":"فله به صَدَقةٌ","explicit":true,"ref":"الأحاديث المختارة 10 / 148","srcLabel":"متفق عليه","text":["«",["مَن مَشى بحَقِّه إلى أخيه ليَقْضيَه ",1],["فله به صَدَقةٌ، ",2],"ومَن أَرْشَدَ ابنَ السَّبيلِ فله به صَدَقةٌ، ومَن أماطَ الأَذى عن الطَّريقِ فله به صَدَقةٌ، ومَن أعانَ على حَمْلِ دابَّةٍ فله به صَدَقةٌ، وكلُّ مَعْروفٍ صَدَقةٌ»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"4zIHcc3E"},{"id":"س-06390","fp":"0972293107d6","stateId":453,"easy":"إذا أرشدت ابن السبيل ← فلك به صدقة","cause":"ومَن أَرْشَدَ ابنَ السَّبيلِ","result":"فله به صَدَقةٌ","explicit":true,"ref":"الأحاديث المختارة 10 / 148","srcLabel":"متفق عليه","text":["«مَن مَشى بحَقِّه إلى أخيه ليَقْضيَه فله به صَدَقةٌ، ",["ومَن أَرْشَدَ ابنَ السَّبيلِ ",1],["فله به صَدَقةٌ، ",2],"ومَن أماطَ الأَذى عن الطَّريقِ فله به صَدَقةٌ، ومَن أعانَ على حَمْلِ دابَّةٍ فله به صَدَقةٌ، وكلُّ مَعْروفٍ صَدَقةٌ»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"4zIHcc3E"},{"id":"س-06391","fp":"11627763ac8e","stateId":453,"easy":"إذا أمطت الأذى عن الطريق ← فلك به صدقة","cause":"ومَن أماطَ الأَذى عن الطَّريقِ","result":"فله به صَدَقةٌ","explicit":true,"similar":["س-06084","س-07185"],"ref":"الأحاديث المختارة 10 / 148","srcLabel":"متفق عليه","text":["«مَن مَشى بحَقِّه إلى أخيه ليَقْضيَه فله به صَدَقةٌ، ومَن أَرْشَدَ ابنَ السَّبيلِ فله به صَدَقةٌ، ",["ومَن أماطَ الأَذى عن الطَّريقِ ",1],["فله به صَدَقةٌ، ",2],"ومَن أعانَ على حَمْلِ دابَّةٍ فله به صَدَقةٌ، وكلُّ مَعْروفٍ صَدَقةٌ»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"4zIHcc3E"},{"id":"س-06392","fp":"d02a2edf3599","stateId":453,"easy":"إذا أعنت على حمل دابة ← فلك به صدقة وكل معروف صدقة","cause":"ومَن أعانَ على حَمْلِ دابَّةٍ","result":"فله به صَدَقةٌ، وكلُّ مَعْروفٍ صَدَقةٌ","explicit":true,"ref":"الأحاديث المختارة 10 / 148","srcLabel":"متفق عليه","text":["«مَن مَشى بحَقِّه إلى أخيه ليَقْضيَه فله به صَدَقةٌ، ومَن أَرْشَدَ ابنَ السَّبيلِ فله به صَدَقةٌ، ومَن أماطَ الأَذى عن الطَّريقِ فله به صَدَقةٌ، ",["ومَن أعانَ على حَمْلِ دابَّةٍ ",1],["فله به صَدَقةٌ، وكلُّ مَعْروفٍ صَدَقةٌ»",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"4zIHcc3E"},{"id":"س-05434","fp":"d7c4b974178f","stateId":453,"easy":"إذا عملت معروفاً ← فالمعروف كله صدقة","cause":"المعروفُ كلُّهُ","result":"صدقةٌ","explicit":true,"similar":["س-06073"],"ref":"معجم الشيوخ 1/114","srcLabel":"مسلم","text":[["المعروفُ كلُّهُ ",1],["صدقةٌ ",2],"، وإنَّ اللَّهَ عزَّ وجلَّ صانعٌ كلَّ صانعٍ وصنعتِهِ ، وإنَّ آخرَ ما تعلَّقَ بِهِ أَهْلُ الجاهليَّةِ مِن كلامِ النُّبوَّةِ : إذا لَم تستَحي فاصنعْ ما شئتَ"],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح من حديث أبي مالك سعد بن طارق","takhrij":"أخرجه المحاملي في ((الأمالي)) (325) واللفظ له، وأحمد (23441)مختصرا، ومسلم (1005) الفقرة الأولى","bab":"رقائق وزهد › الحياء","dorar":"KkDCscTJ"},{"id":"س-06382","fp":"8626d5ceeb11","stateId":453,"easy":"إذا سلّمت وأمرت بالمعروف ونهيت عن المنكر وأمطت الأذى ← فكل ذلك صدقة","cause":"تسليمُه علَى من لقيَ صدقةٌ وأمرُه بالمعروفِ صدقةٌ ونَهيُه عنِ المنكرِ صدقةٌ وإماطتُه الأذى عنِ الطَّريقِ صدقةٌ وبضعةُ أهلِه","result":"صدقةٌ","explicit":true,"ref":"صحيح أبي داود 1285","srcLabel":"مسلم","text":["يصبحُ علَى كلِّ سلامى منَ ابنِ آدمَ صدقةٌ ",["تسليمُه علَى من لقيَ صدقةٌ وأمرُه بالمعروفِ صدقةٌ ونَهيُه عنِ المنكرِ صدقةٌ وإماطتُه الأذى عنِ الطَّريقِ صدقةٌ وبضعةُ أهلِه",1]," ",["صدقةٌ",2]," ويجزئُ من ذلِك كلِّهِ رَكعتانِ منَ الضُّحى قالَ أبو داودَ وحديثُ عبَّادٍ أتمُّ ولم يذكر مسدَّدٌ الأمرَ والنَّهيَ زادَ في حديثِه وقالَ كذا وَكذا وزادَ ابنُ منيعٍ في حديثِه قالوا يا رسولَ اللَّهِ أحدنا يقضي شَهوتَه وتَكونُ لَه صدقةٌ قالَ أرأيتَ لَو وضعَها في غيرِ حلِّها ألم يَكن يأثمُ"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مسلم (720)، وأبو داود (1285) واللفظ له، وأحمد (21475)","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"uWgwA59f"},{"id":"س-06073","fp":"b82d20f497b4","stateId":453,"easy":"إذا عملت معروفاً ← فكل معروف صدقة","cause":"كلُّ معروفٍ","result":"صدقَةٌ","explicit":true,"repOf":"س-05434","ref":"عارضة الأحوذي 3/325","text":[["كلُّ معروفٍ ",1],["صدقَةٌ ",2],"[وما أنفَقَ المسلِمُ من نفقتِه على نفسِه وأهلِه، كُتِب له بها صَدَقةٌ، وما وقى به المرءُ المسلِمُ عِرضَه كُتِب له به صَدَقةٌ، وكُلُّ نَفَقةٍ أنفقها المسلِمُ فعلى اللهِ خَلَفُها ضامِنًا، إلَّا نَفَقةً في بنيانٍ أو معصيةٍ\". قال: فقلتُ لابنِ المنكَدِرِ: ما قولُه: \"وما وقى به المرءُ المُسلِمُ عِرضَه\"؟ قال: أن يعطِيَ الشَّاعِرَ وذا اللِّسانِ]"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه البيهقي (21172), وعبد بن حميد في ((مسنده)) (1081), وابن عدي في ((الكامل))  (8/ 180) واللفظ لهم.","bab":"رقائق وزهد › ما جاء في فعل الخير","dorar":"s0svCHUS","merged":9,"otherRefs":["النوافح العطرة 141 (صحيح)","الجامع الصغير 5024 (صحيح)","صحيح الترغيب 2595 (صحيح)","المستدرك على الصحيحين 2346 (صحيح)","المصابيح في الأحاديث المتواترة 611 (صحيح)","تخريج مشكل الآثار 5478 (حسن)","تخريج شرح السنة 6/142 (صحيح)","تخريج شرح السنة 1646 (صحيح)"]},{"id":"س-01855","fp":"11d4de300847","stateId":453,"easy":"إذا خدمت الناس في السفر ← تذهب بالأجر","cause":"فتَحَزَّمَ المُفطِرونَ وعَمِلوا","result":"ذَهَبَ المُفطِرونَ اليومَ بالأجرِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-00478"],"ref":"صحيح مسلم 1119","srcLabel":"متفق عليه","text":["كان رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم في سَفَرٍ، فصامَ بَعضٌ، وأفطَرَ بَعضٌ، ",["فتَحَزَّمَ المُفطِرونَ وعَمِلوا",1],"، وضَعُفَ الصُّوامُ عن بَعضِ العَمَلِ، قال: فقال في ذلك: ",["ذَهَبَ المُفطِرونَ اليومَ بالأجرِ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2890) بمعناه، ومسلم (1119) واللفظ له","bab":"إحسان › الأخذ بالرخصة","dorar":"tJd9TpPi"},{"id":"س-06084","fp":"c32e7f7f6b5d","stateId":453,"easy":"إذا أمطت الأذى عن الطريق ← يُكتب لك صدقة","cause":"وإماطتَك الأذى عن الطريقِ","result":"يُكْتَبُ لك به صدقةٌ","explicit":true,"repOf":"س-06391","ref":"صحيح الترغيب 2686","text":["إنَّ تبسُّمُك في وجهِ أخيك يُكْتَبُ لك به صدقةٌ ، ( وإنَّ إفراغَك من دَلْوِكَ فى دَلْوِ أخيك يُكْتَبُ لك به صدقةٌ ( ، ",["وإماطتَك الأذى عن الطريقِ",1]," ",["يُكْتَبُ لك به صدقةٌ",2]," ، وإنَّ أَمْرَك بالمعروفِ صدقةٌ ، ( ونَهْيَك عن المنكرِ يُكْتَبُ لك به صدقةٌ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه البزار (6096، 6097) مفرقاً، والطبراني في ((المعجم الأوسط)) (8342) باختلاف يسير","bab":"رقائق وزهد › ما جاء في فعل الخير","dorar":"5Vs1sEoO","merged":2,"otherRefs":["السلسلة الصحيحة 1558 (صحيح)"]},{"id":"س-01332","fp":"09b5f41b3227","stateId":453,"easy":"إذا رفعت العظم عن الطريق ← فهو صدقة","cause":"رَفْعُكَ العَظمَ عنِ الطريقِ","result":"صَدَقةٌ","explicit":true,"ref":"تخريج المسند لشعيب 21363","srcLabel":"الترمذي","text":["قُلْتُ: يا رسولَ اللهِ، ذهَبَ الأغنياءُ بالأجْرِ، يُصلُّونَ ويَصومونَ، ويَحُجُّونَ، قال: وأنتُم تُصلُّونَ، وتَصومونَ، وتَحُجُّونَ، قُلْتُ: يَتصَدَّقونَ ولا نَتصَدَّقُ، قال: وأنتَ فيكَ صَدقةٌ: ",["رَفْعُكَ العَظمَ عنِ الطريقِ ",1],["صَدَقةٌ",2],"، وهِدايتُكَ الطريقَ صَدَقةٌ، وعَونُكَ الضعيفَ بفَضلِ قُوَّتِكَ صَدَقةٌ، وبَيانُكَ عنِ الأرْثَمِ صَدَقةٌ، ومُباضَعَتُكَ امرأتَكَ صَدَقةٌ، قال: قُلْتُ: يا رسولَ اللهِ، نَأْتي شَهوتَنا ونُؤجَرُ؟ قال: أرَأيْتَ لو جعَلْتَه في حَرامٍ، أكُنْتَ تَأثَمُ؟ قال: قُلْتُ: نَعَمْ، قال: فتَحتَسِبونَ بالشرِّ، ولا تَحتَسِبونَ بالخَيرِ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1956) بنحوه، وأحمد (21363) واللفظ له","bab":"نكاح › عشرة النساء","dorar":"FML8qOwB"},{"id":"س-01333","fp":"08a9a4015d48","stateId":453,"easy":"إذا أفصحت عن الأرثم (العاجز عن الكلام) ← فهو صدقة","cause":"وبَيانُكَ عنِ الأرْثَمِ","result":"صَدَقةٌ","explicit":true,"ref":"تخريج المسند لشعيب 21363","srcLabel":"الترمذي","text":["قُلْتُ: يا رسولَ اللهِ، ذهَبَ الأغنياءُ بالأجْرِ، يُصلُّونَ ويَصومونَ، ويَحُجُّونَ، قال: وأنتُم تُصلُّونَ، وتَصومونَ، وتَحُجُّونَ، قُلْتُ: يَتصَدَّقونَ ولا نَتصَدَّقُ، قال: وأنتَ فيكَ صَدقةٌ: رَفْعُكَ العَظمَ عنِ الطريقِ صَدَقةٌ، وهِدايتُكَ الطريقَ صَدَقةٌ، وعَونُكَ الضعيفَ بفَضلِ قُوَّتِكَ صَدَقةٌ، ",["وبَيانُكَ عنِ الأرْثَمِ",1]," ",["صَدَقةٌ",2],"، ومُباضَعَتُكَ امرأتَكَ صَدَقةٌ، قال: قُلْتُ: يا رسولَ اللهِ، نَأْتي شَهوتَنا ونُؤجَرُ؟ قال: أرَأيْتَ لو جعَلْتَه في حَرامٍ، أكُنْتَ تَأثَمُ؟ قال: قُلْتُ: نَعَمْ، قال: فتَحتَسِبونَ بالشرِّ، ولا تَحتَسِبونَ بالخَيرِ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1956) بنحوه، وأحمد (21363) واللفظ له","bab":"نكاح › عشرة النساء","dorar":"FML8qOwB"},{"id":"س-01867","fp":"401579a5fb1f","stateId":453,"easy":"إذا أبصرت لضعيف البصر ← فهو لك صدقة","cause":"وبَصرُك لِلرَّجلِ الردِيءِ البَصَرِ لكَ","result":"صدَقَةٌ","explicit":true,"ref":"صحيح الترغيب 2685","srcLabel":"الترمذي","text":[["وبَصرُك لِلرَّجلِ الردِيءِ البَصَرِ لكَ ",1],["صدَقَةٌ",2]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1956)، والطوسي في ((مختصر الأحكام)) (1547)، وابن حبان (529) جميعهم بلفظه بتمامه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"LtH1f4C2"},{"id":"س-06082","fp":"b82820e1e760","stateId":453,"easy":"إذا تبسمت في وجه أخيك ← يُكتب لك صدقة","cause":"إنَّ تبسُّمُك في وجهِ أخيك يُكْتَبُ لك به","result":"صدقةٌ","explicit":true,"ref":"صحيح الترغيب 2686","srcLabel":"الطبراني","text":[["إنَّ تبسُّمُك في وجهِ أخيك يُكْتَبُ لك به ",1],["صدقةٌ ",2],"، ( وإنَّ إفراغَك من دَلْوِكَ فى دَلْوِ أخيك يُكْتَبُ لك به صدقةٌ ( ، وإماطتَك الأذى عن الطريقِ يُكْتَبُ لك به صدقةٌ ، وإنَّ أَمْرَك بالمعروفِ صدقةٌ ، ( ونَهْيَك عن المنكرِ يُكْتَبُ لك به صدقةٌ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه البزار (6096، 6097) مفرقاً، والطبراني في ((المعجم الأوسط)) (8342) باختلاف يسير","bab":"رقائق وزهد › ما جاء في فعل الخير","dorar":"5Vs1sEoO"},{"id":"س-06083","fp":"f4ce53aae3c9","stateId":453,"easy":"إذا أفرغت من دلوك في دلو أخيك ← يُكتب لك صدقة","cause":"وإنَّ إفراغَك من دَلْوِكَ فى دَلْوِ أخيك","result":"يُكْتَبُ لك به صدقةٌ","explicit":true,"ref":"صحيح الترغيب 2686","srcLabel":"الطبراني","text":["إنَّ تبسُّمُك في وجهِ أخيك يُكْتَبُ لك به صدقةٌ ، ( ",["وإنَّ إفراغَك من دَلْوِكَ فى دَلْوِ أخيك",1]," ",["يُكْتَبُ لك به صدقةٌ",2]," ( ، وإماطتَك الأذى عن الطريقِ يُكْتَبُ لك به صدقةٌ ، وإنَّ أَمْرَك بالمعروفِ صدقةٌ ، ( ونَهْيَك عن المنكرِ يُكْتَبُ لك به صدقةٌ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه البزار (6096، 6097) مفرقاً، والطبراني في ((المعجم الأوسط)) (8342) باختلاف يسير","bab":"رقائق وزهد › ما جاء في فعل الخير","dorar":"5Vs1sEoO"},{"id":"س-06353","fp":"b88e81a0fc06","stateId":453,"easy":"إذا صنعت معروفاً إلى غني أو فقير ← فهو صدقة","cause":"كلُّ مَعْرُوفٍ صَنَعْتَهُ إلى غَنِيٍّ أوْ فَقِيرٍ فهوَ","result":"صَدَقَةٌ","explicit":true,"ref":"السلسلة الصحيحة 2040","srcLabel":"السلسلة الصحيحة","text":[["كلُّ مَعْرُوفٍ صَنَعْتَهُ إلى غَنِيٍّ أوْ فَقِيرٍ فهوَ ",1],["صَدَقَةٌ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود وجابر بن عبدالله","muhaddith":"صحيح","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"4yG9K0Hv"},{"id":"س-07928","fp":"dda85baec0c0","stateId":453,"easy":"إذا أمطت الأذى وأرشدت الضال ونهيت عن المنكر ← فكلها صدقة","cause":"إماطتُك الأذَى عن الطريقِ صدقةٌ وإرشادُك الرجلَ الطريقَ صدقةٌ ونهيُك عن المنكرِ صدقةٌ وعيادتُك المريضَ صدقةٌ واتباعُك الجنازةَ","result":"صدقةٌ","explicit":true,"ref":"مجمع الزوائد 3/107","srcLabel":"إسحق","text":["على كلِّ مسلمٍ في كلِّ يومٍ صدقةٌ فقال رجلٌ مَن يطيقُ هذا يا رسولَ اللهِ قال ",["إماطتُك الأذَى عن الطريقِ صدقةٌ وإرشادُك الرجلَ الطريقَ صدقةٌ ونهيُك عن المنكرِ صدقةٌ وعيادتُك المريضَ صدقةٌ واتباعُك الجنازةَ",1]," ",["صدقةٌ",2]," وردُّ المسلمِ على المسلمِ السلامَ صدقةٌ وفي روايةٍ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم الإنسانُ ثلاثمائةٍ وستونَ عظمًا أو ستةٌ وثلاثونَ سُلامَى عليه في كلِّ يومٍ صدقةٌ قالوا يا رسولَ اللهِ فمَن لم يجدْ قال يأمرُ بالمعروفِ وينهَى عن المنكرِ قالوا فمَن لم يستطعْ قال يرفعُ عَظمًا من الطريقِ قالوا فمَن لم يستطعْ قال فليُهدِ سبيلًا قالوا فمن لم يستطعْ قال فليعِنْ ضعيفًا قالوا فمَن لم يستطعْ ذلك قال فليدعِ الناسَ من شرِّه"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه إسحق بن راهويه في ((المسند)) (245) باختلاف يسير، والبزار (9817) واللفظ له، ومحمد بن نصر المروزي في ((تعظيم قدر الصلاة)) (805) مختصراً. والرواية أخرجها البزار (9200)","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"ngrYGFkZ"},{"id":"س-07945","fp":"31710344fd0b","stateId":453,"easy":"إذا أمطت الأذى عن الطريق ← تُكتب لك حسنة ومن كُتبت له حسنة دخل الجنة","cause":"مَن أماط أذًى عنِ الطريقِ","result":"كُتِب له حسنةٌ ، ومَن كُتِب له حسنةٌ دخَل الجنةَ","explicit":true,"otherNeedIds":[67,51],"ref":"إتحاف الخيرة المهرة 2/171","srcLabel":"مسدد","text":["أنَّ رجلًا كان إذا صلَّى جهَر بقراءتِه ، وإنَّ معاذَ بنَ جبلٍ فقَده فقال : أين الذي كان يوقِظُ الوسنانَ ، ويوحِشُ الشيطانَ ؟ قالوا : اشتَكى ، فخرَج يعودُه ومعَه رجلٌ ، فكان معاذٌ إذا مرَّ بأذًى في الطريقِ تناوَله فأخَذه ، وكان الرجلُ يسبقُ معاذًا إذا رأى الأذى ، فيأخُذُه فيُنَحِّيه عنِ الطريقِ ، فقال له معاذٌ : ما حمَلَكَ على ما تَصنَعُ ؟ قال : الذي رأيتُكَ تَصنَعُ . قال : فقال له معاذٌ : ",["مَن أماط أذًى عنِ الطريقِ",1]," ",["كُتِب له حسنةٌ ، ومَن كُتِب له حسنةٌ دخَل الجنةَ",2]],"grade":"حسن","narrator":"محمد بن حبان الأنصاري","muhaddith":"إسناده رجاله ثقات","takhrij":"أخرجه مسدد كما في ((إتحاف الخيرة)) بلفظه، وهناد بن السري في ((الزهد)) (2/ 523) باختلاف يسير، وابن أبي شيبة (3695) مختصرا.","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"qhiB0kjY","merged":3,"otherRefs":["النوافح العطرة 365 (حسن)","صحيح الأدب المفرد 461 (حسن)"]},{"id":"س-06081","fp":"9dd81b0416e5","stateId":453,"easy":"إذا رفعت حجراً من الطريق ← تُكتب لك حسنة ومن كانت له حسنة دخل الجنة","cause":"من رفعَ حجرًا منَ الطَّريقِ","result":"كتبت لهُ حسنةٌ ومن كانت لهُ حسنةٌ دخلَ الجنَّة","explicit":true,"otherNeedIds":[67],"ref":"مجمع الزوائد 3/138","srcLabel":"الطبراني","text":["كانَ معاذٌ يمشي ورجلٌ معهُ فرفعَ حجرًا منَ الطَّريقِ فقالَ ما هذا قالَ سمعتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ ",["من رفعَ حجرًا منَ الطَّريقِ",1]," ",["كتبت لهُ حسنةٌ ومن كانت لهُ حسنةٌ دخلَ الجنَّة",2]],"grade":"حسن","narrator":"معاذ بن جبل","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (20/ 101) (198)، والبيهقي في ((شعب الإيمان)) (10660) واللفظ لهما، وابن أبي شيبة في ((الأدب)) (111) بنحوه.","bab":"رقائق وزهد › ما جاء في فعل الخير","dorar":"BPc1pHIu","merged":2,"otherRefs":["صحيح الجامع 6265 (حسن)"]},{"id":"س-00478","fp":"33414ee4bf18","stateId":453,"easy":"إذا خدمت إخوانك في السفر ← تذهب بالأجر","cause":"وقامَ المفطِرونَ ، فضرَبوا الأبنيةَ ، وسَقوا الرِّكابَ","result":"ذَهَبَ المفطِرونَ بالأَجْرِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-01855","ref":"نخب الافكار 8/357","text":["خرجنا معَ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ في سفرٍ ، فنزَلنا في يومٍ شديدِ الحرِّ ، فمنَّا الصَّائمُ ، ومنَّا المفطِرُ ، فنزلنا منزلًا في يومٍ حارٍّ وأَكْثرُنا ظلًّا صاحِبُ الكساءِ ، ومنَّا مَن يسترُ الشَّمسَ بيدِهِ ، فسَقطَ الصُّوَّامُ ، ",["وقامَ المفطِرونَ ، فضرَبوا الأبنيةَ ، وسَقوا الرِّكابَ",1]," . فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: ",["ذَهَبَ المفطِرونَ بالأَجْرِ",2]," اليومَ"],"grade":"صحيح","narrator":"أنس","muhaddith":"طريقه صحيح","bab":"آداب عامة › المباحات من الأفعال والأقوال","dorar":"qx4dpG9Q"},{"id":"س-02236","fp":"592a43fa14e7","stateId":453,"easy":"إذا أزلت من طريق المسلمين ما يؤذيهم ← يكتب الله لك به حسنة","cause":"مَنْ أخرجَ مِنْ طريقِ المسلمينَ شيئًا يُؤْذِيهم","result":"كتبَ اللهُ لَهُ بِهِ حسَنَةً","explicit":true,"ref":"صحيح الجامع 5985","srcLabel":"الطبراني","text":[["مَنْ أخرجَ مِنْ طريقِ المسلمينَ شيئًا يُؤْذِيهم ، ",1],["كتبَ اللهُ لَهُ بِهِ حسَنَةً ، ",2],"ومَنْ كَتَبَ لَهُ عندَهُ حسنَةً أدْخَلَهُ بِها الجنَّةَ"],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (32)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"y3cJvS1l"},{"id":"س-06079","fp":"eab0efaf058e","stateId":453,"easy":"إذا هديت السبيل وأمطت الأذى وعبّرت عن الأعجمي ← تُؤجر","cause":"في هدايتِه السَّبيلَ وفي إماطتِه الأذى عنِ الطَّريقِ وفي تعبيرِه بلسانِهِ عنِ الأعجميِّ وفي إتيانِه أَهلَه","result":"إنَّ المؤمنَ ليؤجَرُ","explicit":true,"ref":"الأمالي المطلقة 117","srcLabel":"الطبراني","text":[["إنَّ المؤمنَ ليؤجَرُ",2]," ",["في هدايتِه السَّبيلَ وفي إماطتِه الأذى عنِ الطَّريقِ وفي تعبيرِه بلسانِهِ عنِ الأعجميِّ وفي إتيانِه أَهلَه",1]," حتَّى أنَّهُ ليؤجر في السِّلعةِ تكونُ في طرفِ ثوبِه فيلتمسُها فتخطئُها كفُّهُ فيخفِقُ لَها فؤادُه فتُرَدُّ عليهِ ويُكتبُ لَه أجرُهُ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"أخرجه البزار (6927)، والطبراني في ((المعجم الأوسط)) (3530)، والبيهقي في ((شعب الإيمان)) (9479) باختلاف يسير","bab":"رقائق وزهد › ما جاء في فعل الخير","dorar":"9UmyItxP"},{"id":"س-07139","fp":"1a6f31bbf846","stateId":453,"easy":"إذا نحّيت الأذى عن طريق المسلمين ← تنتفع به","cause":"نَحِّ الأذى عن طريقِ المُسلِمينَ","result":"دُلَّني على عمَلٍ أنتفِعُ به","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح ابن حبان 541","srcLabel":"مسلم","text":["قُلْتُ: يا رسولَ اللهِ ",["دُلَّني على عمَلٍ أنتفِعُ به",2]," قال: ",["( نَحِّ الأذى عن طريقِ المُسلِمينَ )",1]],"grade":"صحيح","narrator":"أبو برزة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (2618) بلفظ: \"اعزل الأذى\"","bab":"علم › حسن السؤال ونصح العالم","dorar":"t8gB2ZrT"},{"id":"س-07185","fp":"0d34a33e419b","stateId":453,"easy":"إذا أمطت الأذى عن الطريق ← فهو لك صدقة","cause":"أمِطِ الأذى عن الطَّريقِ؛ فهو لك صَدقةٌ","result":"مُرْني بعملٍ أعمَلُه، فقال","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-06391","ref":"تخريج المسند لشعيب 19795","text":["وقُلتُ لرسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا رسولَ اللهِ، ",["مُرْني بعملٍ أعمَلُه، فقال",2],": ",["أمِطِ الأذى عن الطَّريقِ؛ فهو لك صَدقةٌ.",1]],"grade":"حسن","narrator":"أبو برزة الأسلمي نضلة بن عبيد","muhaddith":"إسناده حسن","takhrij":"أخرجه مسلم (2618) باختلاف يسير","bab":"علم › حسن السؤال ونصح العالم","dorar":"6XjfhS5M"},{"id":"س-06332","fp":"2da2eccb9ce5","stateId":454,"easy":"إذا شفعت لأخيك ← تؤجر","cause":"اشفَعوا","result":"تُؤجَروا","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 19667","srcLabel":"متفق عليه","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ إذا جاءه السَّائلُ أو ذو الحاجةِ قال: ",["اشفَعوا ",1],["تُؤجَروا",2],"، وليَقضِ اللهُ عزَّ وجلَّ على لِسانِ رسولِه ما شاء، وقال: المؤمنُ لِلمؤمنِ كالبُنْيانِ، يَشُدُّ بعضُه بعضًا، وقال: الخازنُ الأمينُ الذي يُؤدِّي ما أُمِرَ به طَيِّبةً به نَفْسُه أحَدُ المُتصدِّقينَ."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (1432، 2446، 2260) مفرقاً، ومسلم (2627، 2585، 1023) مفرقاً، وأبو داود (5133، 1684) مفرقاً مختصراً، والترمذي (2672، 1928) مفرقاً مختصراً، والنسائي (2560) مختصراً، وأحمد (19667) واللفظ له","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"ehUblHHg","merged":7,"otherRefs":["صحيح البخاري 1432 (صحيح)","صحيح البخاري 7476 (صحيح)","الصحيح المسند 1122 (صحيح)","تخريج صحيح ابن حبان 531 (صحيح)","تخريج سنن أبي داود 5132 (صحيح)","صحيح البخاري 6026 (صحيح)"]},{"id":"س-05897","fp":"6059438d33e9","stateId":454,"easy":"إذا كنت خيراً لصاحبك وجارك ← تكون خير الأصحاب والجيران عند الله","cause":"عند اللهِ خَيرُهم لصاحبِهِ، وخَيرُ الجيرانِ عند اللهِ خَيرُهم لجارِهِ","result":"خَيرُ الأصحابِ","explicit":true,"ref":"تخريج المسند لشعيب 6566","srcLabel":"مسلم","text":["عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أنَّه قال: ",["خَيرُ الأصحابِ",2],[" عند اللهِ خَيرُهم لصاحبِهِ، وخَيرُ الجيرانِ عند اللهِ خَيرُهم لجارِهِ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده قوي على شرط مسلم","takhrij":"أخرجه الترمذي (1944)، وأحمد (6566) واللفظ له","bab":"رقائق وزهد › الوصايا النافعة","dorar":"rqnEGzWY","merged":2,"otherRefs":["مجموع الشروح الفقهية. 181/30 (صحيح)"]},{"id":"ق-0234","fp":"eab9906296ad","stateId":454,"easy":"الشفاعة الحسنة ← نصيب منها","cause":"الشفاعة الحسنة","result":"نصيب منها","explicit":true,"ref":"سورة النساء: 85","srcLabel":"القرآن الكريم","quran":{"s":4,"from":85,"to":85,"text":"مَنْ يَشْفَعْ شَفَاعَةً حَسَنَةً يَكُنْ لَهُ نَصِيبٌ مِنْهَا وَمَنْ يَشْفَعْ شَفَاعَةً سَيِّئَةً يَكُنْ لَهُ كِفْلٌ مِنْهَا وَكَانَ اللَّهُ عَلَى كُلِّ شَيْءٍ مُقِيتًا (85)","hl":[[0,61,1]]}},{"id":"ق-0300","fp":"8352a8dbc9c7","stateId":454,"easy":"إحياء نفس ← كأنما أحيا الناس جميعاً","cause":"إحياء نفس","result":"كأنما أحيا الناس جميعاً","explicit":true,"ref":"سورة المائدة: 32","srcLabel":"القرآن الكريم","quran":{"s":5,"from":32,"to":32,"text":"مِنْ أَجْلِ ذَلِكَ كَتَبْنَا عَلَى بَنِي إِسْرَائِيلَ أَنَّهُ مَنْ قَتَلَ نَفْسًا بِغَيْرِ نَفْسٍ أَوْ فَسَادٍ فِي الْأَرْضِ فَكَأَنَّمَا قَتَلَ النَّاسَ جَمِيعًا وَمَنْ أَحْيَاهَا فَكَأَنَّمَا أَحْيَا النَّاسَ جَمِيعًا وَلَقَدْ جَاءَتْهُمْ رُسُلُنَا بِالْبَيِّنَاتِ ثُمَّ إِنَّ كَثِيرًا مِنْهُمْ بَعْدَ ذَلِكَ فِي الْأَرْضِ لَمُسْرِفُونَ (32)","hl":[[163,219,1]]}},{"id":"ق-0693","fp":"31b070efa0bb","stateId":454,"easy":"الإحسان ← نفعه للنفس","cause":"الإحسان","result":"نفعه للنفس","explicit":true,"ref":"سورة الإسراء: 7","srcLabel":"القرآن الكريم","quran":{"s":17,"from":7,"to":7,"text":"إِنْ أَحْسَنْتُمْ أَحْسَنْتُمْ لِأَنْفُسِكُمْ وَإِنْ أَسَأْتُمْ فَلَهَا فَإِذَا جَاءَ وَعْدُ الْآخِرَةِ لِيَسُوءُوا وُجُوهَكُمْ وَلِيَدْخُلُوا الْمَسْجِدَ كَمَا دَخَلُوهُ أَوَّلَ مَرَّةٍ وَلِيُتَبِّرُوا مَا عَلَوْا تَتْبِيرًا (7)","hl":[[0,45,1]]}},{"id":"ق-1288","fp":"dacb8f6d0a6b","stateId":454,"easy":"الإحسان ← الإحسان من الله","cause":"الإحسان","result":"الإحسان من الله","explicit":true,"ref":"سورة الرحمن: 60","srcLabel":"القرآن الكريم","quran":{"s":55,"from":60,"to":60,"text":"هَلْ جَزَاءُ الْإِحْسَانِ إِلَّا الْإِحْسَانُ (60)","hl":[[0,45,1]]}},{"id":"س-06254","fp":"38b892e5f94a","stateId":454,"easy":"إذا أنظرت معسراً ← فلك بكل يوم مثلاه صدقة","cause":"من أنظر معسرًا","result":"فله بكلِّ يومٍ مثلَيه صدقةٌ","explicit":true,"ref":"السلسلة الصحيحة 1/170","srcLabel":"ابن ماجه","text":[["من أنظر معسرًا ",1],["فله بكلِّ يومٍ مثلَيه صدقةٌ",2]," قال : ثم سمعتُه يقول من أنظَر مُعسرًا فله بكلِّ يومٍ مِثلَيه صدقةٌ قلت : سمعتُك يا رسولَ اللهِ تقول من أنظر مُعسرًا فله بكلِّ يومٍ مِثلِه صدقةُ ثم سمعتُك تقول : من أنظر مُعسرًا فله بكلِّ يومٍ مثلَيه صدقةٌ قال : له بكلِّ يومٍ صدقةٌ قبلَ أن يَحلَّ الدَّينُ فإذا حلَّ الدَّينُ فأنظَرَه فله بكلِّ يومٍ مثلَيهِ صدقةٌ"],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (2418) مختصراً، وأحمد (23046) واللفظ له","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"zaPLR99S","merged":3,"otherRefs":["صحيح ابن ماجه 1977 (صحيح)","المهذب في اختصار السنن 4/2128 (صحيح)"]},{"id":"س-06271","fp":"1542c311eeb5","stateId":454,"easy":"إذا أنظرت المدين بعد حلول الدين ← فلك بكل يوم مثله صدقة","cause":"فإن أنظرَهُ بعدَ الحلِّ","result":"فلَهُ بِكلِّ يومٍ مثلِهِ صدقةٌ","explicit":true,"ref":"المهذب في اختصار السنن 4/2128","srcLabel":"ابن ماجه","text":["من أنظرَ مُعسرًا فإنَّ لَهُ بِكلِّ يومٍ مثلِهِ صدقةً، قلتُ: يا رسولَ اللَّهِ بِكلِّ يومٍ صدقةٌ , ثمَّ قلتُ لَهُ بِكلِّ يومٍ مثلِهِ صدقةٌ, قالَ لَهُ: بِكلِّ يومٍ صدقةٌ ما لم يحلَّ الدَّينُ، فإذا حلَّ الدَّينُ ",["فإن أنظرَهُ بعدَ الحلِّ",1]," ",["فلَهُ بِكلِّ يومٍ مثلِهِ صدقةٌ",2]],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"إسناده صحيح ولم يخرجوه","takhrij":"أخرجه ابن ماجه (2418) مختصراً، وأحمد (23046) باختلاف يسير، والبيهقي (11295) واللفظ له","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"UX2rZ1dU"},{"id":"س-02440","fp":"302340ef8bea","stateId":455,"easy":"إذا أطعمت الطعام وألنت الكلام وسمحت وحسن خلقك ← فهو أهون عليك وأفضل","cause":"إطعامُ الطعامِ ، ولِينُ الكلامِ ، والسماحةُ ، وحسنُ الخلُقِ","result":"وأهونُ عليكَ مِن ذلك","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"إتحاف الخيرة المهرة 1/63","srcLabel":"البخاري","text":["بينما أنا عندَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم ، إذ جاء رجلٌ ، فقال : يا رسولَ اللهِ ، أيُّ الأعمالِ أفضلُ ؟ قال : إيمانٌ باللهِ ، وتصديقٌ به ، وجهادٌ في سبيلِ اللهِ ، وحجٌّ مبرورٌ ، فلما ولَّى الرجلُ ، قال : وأهونُ عليكَ مِن ذلك ، قال : ",["إطعامُ الطعامِ ، ولِينُ الكلامِ ، والسماحةُ ، وحسنُ الخلُقِ",1]," . قال : فلما ولَّى الرجلُ ، قال : ",["وأهونُ عليكَ مِن ذلك",2]," ، قال : لا تتَّهِمِ اللهَ في شيءٍ قَضاه عليكَ"],"grade":"حسن","narrator":"عبادة بن الصامت","muhaddith":"روي بإسنادين أحدهما حسن","takhrij":"أخرجه البخاري ((خلق أفعال العباد)) (ص52)، وابن أبي عاصم في ((الجهاد)) (25)، والطبراني في ((مكارم الأخلاق)) (154) بنحوه.","bab":"إسلام › فضل الشهادتين","dorar":"MUwBqfun"},{"id":"س-03209","fp":"77f1eb2fbe34","stateId":455,"easy":"إذا كففت شرك عن الناس ← فهي صدقة منك على نفسك","cause":"تدعُ الناسَ من الشرِّ","result":"فإنها صدقةٌ؛ تصدَّق بها على نفسِكَ","explicit":true,"star":true,"ref":"صحيح الأدب المفرد 162","srcLabel":"متفق عليه","text":["عن النَّبيِّ صلَّى اللهُ عليه وسلَّم قيل: (وفي رواية عنه أنَّه سأَلَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ) أيُّ الأعمالِ خيرٌ ؟ (وفي الرواية الأخرى: أي العمل أفضلُ ؟) قالَ إيمانٌ بالله و جهادٌ في سبيلِه قيل : و في الأخرى : قال : فأيُّ الرِّقابِ أفضلُ ؟ قال : أغلاها ثمنًا، و أنفَسُها عند أهلِها قال : أفرأيتَ إن لم أستطعْ بعضَ العملِ ؟ قال : فتُعينُ صانعًا، أو تصنع لأَخْرقٍ . قال : أفرأيتَ إن ضعُفتُ ؟ قال : ",["تدعُ الناسَ من الشرِّ",1],"؛ ",["فإنها صدقةٌ؛ تصدَّق بها على نفسِكَ",2]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (220، 305)، وأخرجه في الصحيح (2518)، ومسلم (84) باختلاف يسير","bab":"إيمان › فضل الإيمان","dorar":"TPs4Y6z3","merged":5,"otherRefs":["تخريج المسند لشعيب 10878 (حسن)","تخريج المسند لشعيب 21500 (صحيح)","صحيح البخاري 2518 (صحيح)","الترغيب والترهيب 2/63 (صحيح)"]},{"id":"س-00234","fp":"f8b063725034","stateId":455,"easy":"إذا قلت كلمة طيبة ← فهي صدقة","cause":"الكلمةُ الطيبةُ","result":"صدقةٌ","explicit":true,"star":true,"similar":["س-00236"],"ref":"المقاصد الحسنة 378","srcLabel":"متفق عليه","text":[["الكلمةُ الطيبةُ ",1],["صدقةٌ ",2],"[يعني حديث: كُلُّ سُلامَى مِنَ النَّاسِ عليه صَدَقَةٌ، كُلَّ يَومٍ تَطْلُعُ فيه الشَّمْسُ، قالَ: تَعْدِلُ بيْنَ الاثْنَيْنِ صَدَقَةٌ، وتُعِينُ الرَّجُلَ في دابَّتِهِ فَتَحْمِلُهُ عليها، أوْ تَرْفَعُ له عليها مَتاعَهُ صَدَقَةٌ، قالَ: والْكَلِمَةُ الطَّيِّبَةُ صَدَقَةٌ، وكُلُّ خُطْوَةٍ تَمْشِيها إلى الصَّلاةِ صَدَقَةٌ، وتُمِيطُ الأذَى عَنِ الطَّرِيقِ صَدَقَةٌ.]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2989)، ومسلم (1009) مطولاً.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"nOHaDbsE","merged":2,"otherRefs":["صحيح ابن خزيمة 3/ 24 (صحيح)"]},{"id":"س-00236","fp":"c58cf7720244","stateId":455,"easy":"إذا قلت كلمة طيبة ← فهي صدقة","cause":"والْكَلِمَةُ الطَّيِّبَةُ","result":"صَدَقَةٌ","explicit":true,"repOf":"س-00234","ref":"المقاصد الحسنة 378","text":["الكلمةُ الطيبةُ صدقةٌ [يعني حديث: كُلُّ سُلامَى مِنَ النَّاسِ عليه صَدَقَةٌ، كُلَّ يَومٍ تَطْلُعُ فيه الشَّمْسُ، قالَ: تَعْدِلُ بيْنَ الاثْنَيْنِ صَدَقَةٌ، وتُعِينُ الرَّجُلَ في دابَّتِهِ فَتَحْمِلُهُ عليها، أوْ تَرْفَعُ له عليها مَتاعَهُ صَدَقَةٌ، قالَ: ",["والْكَلِمَةُ الطَّيِّبَةُ ",1],["صَدَقَةٌ",2],"، وكُلُّ خُطْوَةٍ تَمْشِيها إلى الصَّلاةِ صَدَقَةٌ، وتُمِيطُ الأذَى عَنِ الطَّرِيقِ صَدَقَةٌ.]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2989)، ومسلم (1009) مطولاً.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"nOHaDbsE"},{"id":"ق-0098","fp":"66defda5c953","stateId":455,"easy":"القول المعروف والمغفرة للسائل ← خير من صدقة يتبعها أذى","cause":"القول المعروف والمغفرة للسائل","result":"خير من صدقة يتبعها أذى","explicit":true,"star":true,"ref":"سورة البقرة: 263","srcLabel":"القرآن الكريم","quran":{"s":2,"from":263,"to":263,"text":"قَوْلٌ مَعْرُوفٌ وَمَغْفِرَةٌ خَيْرٌ مِنْ صَدَقَةٍ يَتْبَعُهَا أَذًى وَاللَّهُ غَنِيٌّ حَلِيمٌ (263)","hl":[[0,68,1]]}},{"id":"ق-0988","fp":"a511e6a85c8a","stateId":455,"easy":"الصدق في عهد الله ← جزاء الصادقين بصدقهم","cause":"الصدق في عهد الله","result":"جزاء الصادقين بصدقهم","explicit":true,"ref":"سورة الأحزاب: 23–24","srcLabel":"القرآن الكريم","quran":{"s":33,"from":23,"to":24,"text":"مِنَ الْمُؤْمِنِينَ رِجَالٌ صَدَقُوا مَا عَاهَدُوا اللَّهَ عَلَيْهِ فَمِنْهُمْ مَنْ قَضَى نَحْبَهُ وَمِنْهُمْ مَنْ يَنْتَظِرُ وَمَا بَدَّلُوا تَبْدِيلًا (23) لِيَجْزِيَ اللَّهُ الصَّادِقِينَ بِصِدْقِهِمْ وَيُعَذِّبَ الْمُنَافِقِينَ إِنْ شَاءَ أَوْ يَتُوبَ عَلَيْهِمْ إِنَّ اللَّهَ كَانَ غَفُورًا رَحِيمًا (24)","hl":[[0,203,1]]}},{"id":"ق-1159","fp":"56e796b783ff","stateId":455,"easy":"العفو والإصلاح ← أجره على الله","cause":"العفو والإصلاح","result":"أجره على الله","explicit":true,"ref":"سورة الشورى: 40","srcLabel":"القرآن الكريم","quran":{"s":42,"from":40,"to":40,"text":"وَجَزَاءُ سَيِّئَةٍ سَيِّئَةٌ مِثْلُهَا فَمَنْ عَفَا وَأَصْلَحَ فَأَجْرُهُ عَلَى اللَّهِ إِنَّهُ لَا يُحِبُّ الظَّالِمِينَ (40)","hl":[[40,88,1]]}},{"id":"ق-1232","fp":"6697ba913c1f","stateId":455,"easy":"الوفاء بعهد الله ← أجر عظيم","cause":"الوفاء بعهد الله","result":"أجر عظيم","explicit":true,"ref":"سورة الفتح: 10","srcLabel":"القرآن الكريم","quran":{"s":48,"from":10,"to":10,"text":"إِنَّ الَّذِينَ يُبَايِعُونَكَ إِنَّمَا يُبَايِعُونَ اللَّهَ يَدُ اللَّهِ فَوْقَ أَيْدِيهِمْ فَمَنْ نَكَثَ فَإِنَّمَا يَنْكُثُ عَلَى نَفْسِهِ وَمَنْ أَوْفَى بِمَا عَاهَدَ عَلَيْهُ اللَّهَ فَسَيُؤْتِيهِ أَجْرًا عَظِيمًا (10)","hl":[[142,218,1]]}},{"id":"س-07545","fp":"c882029fcabf","stateId":455,"easy":"إذا شتمك أحد بما فيك فلم تعيّره بما فيه ← يكون لك أجره وعليه إثمه","cause":"وإنِ امرُؤٌ شَتَمَكَ وعَيَّرَكَ بأمرٍ يَعلَمُه فيكَ","result":"فلا تُعَيِّرْه بأمرٍ تَعلَمُه فيه، فيَكونَ لَكَ أجرُه، وعليه إثمُه، ولا تَشتُمَنَّ أحَدًا","explicit":true,"similar":["س-00168"],"ref":"تخريج المسند لشعيب 20632","srcLabel":"أحمد","text":["عن جابِرِ بنِ سُلَيمٍ، أو سُلَيمِ بنِ جابِرٍ، قال: أتَيتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم، فإذا هو جالِسٌ مَعَ أصحابِه، قال: فقُلتُ: أيُّكُمُ النَّبيُّ؟ قال: فإمَّا أن يَكونَ أومَأ إلى نَفسِه، وإمَّا أن يَكونَ أشارَ إليه القَومُ، قال: فإذا هو مُحتَبٍ ببُردةٍ، قد وقَعَ هُدبُها على قدَمَيه، قال: فقُلتُ: يا رَسولَ اللهِ، أجفو عن أشياءَ فعَلِّمْني، قال: «اتَّقِ اللهَ ولا تَحقِرَنَّ مِنَ المَعروفِ شَيئًا، ولَو أن تُفرِغَ مِن دَلوِكَ في إناءِ المُستَسقي، وإيَّاكَ والمَخيلةَ؛ فإنَّ اللهَ لا يُحِبُّ المَخيلةَ، ",["وإنِ امرُؤٌ شَتَمَكَ وعَيَّرَكَ بأمرٍ يَعلَمُه فيكَ، ",1],["فلا تُعَيِّرْه بأمرٍ تَعلَمُه فيه، فيَكونَ لَكَ أجرُه، وعليه إثمُه، ولا تَشتُمَنَّ أحَدًا»",2]],"grade":"صحيح","narrator":"جابر بن سليم، أو سليم بن جابر","muhaddith":"صحيح","bab":"فضائل النبي وصفته ودلائل النبوة › تواضعه صلى الله عليه وسلم","dorar":"9hjuiYVd","merged":3,"otherRefs":["تخريج صحيح ابن حبان 521 (صحيح)","السلسلة الصحيحة 770 (صحيح)"]},{"id":"س-01596","fp":"8b066d8a530e","stateId":455,"easy":"إذا صنع إليك أحد معروفاً فكافئه ← فإن لم تجد فادعُ له حتى ترى أنك كافأته","cause":"و مَنْ صَنَعَ إليكُمْ معروفًا فَكَافِئُوهُ","result":"فإنْ لمْ تجدُوا ما تكافِئونَهُ، فادْعُوا لهُ حتى تَرَوْا أنَّكُمْ قدْ كافَأْتُمُوهُ","explicit":true,"otherNeedIds":[41],"ref":"الجامع الصغير 8392","srcLabel":"أبو داود","text":["منِ استعاذَ باللهِ فأَعِيذُوهُ،  و منْ سألَكمْ باللهِ فأَعْطُوهُ،  و مَنْ دَعَاكُمْ فأَجِيبُوهُ،  ",["و مَنْ صَنَعَ إليكُمْ معروفًا فَكَافِئُوهُ",1],"،  ",["فإنْ لمْ تجدُوا ما تكافِئونَهُ،  فادْعُوا لهُ حتى تَرَوْا أنَّكُمْ قدْ كافَأْتُمُوهُ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5109)، والنسائي (2567)، وأحمد (5365) باختلاف يسير","bab":"أطعمة › إجابة الدعوة","dorar":"GcCMKbVX","merged":2,"otherRefs":["المستدرك على الصحيحين 1522 (صحيح)"]},{"id":"س-04716","fp":"21808262db26","stateId":455,"easy":"إذا كظمت غيظك ابتغاء وجه الله ← فلا جرعة أعظم أجراً منها","cause":"جَرعةِ غيظٍ كظمَها عبدٌ ابتغاءَ وجهِ اللَّهِ","result":"ما مِن جَرعةٍ أعظمُ أجرًا عندَ اللَّهِ","explicit":true,"otherNeedIds":[8,23],"ref":"صحيح ابن ماجه 3396","srcLabel":"ابن ماجه","text":[["ما مِن جَرعةٍ أعظمُ أجرًا عندَ اللَّهِ",2],"، من ",["جَرعةِ غيظٍ كظمَها عبدٌ ابتغاءَ وجهِ اللَّهِ",1]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (4189)، والضياء في ((الأحاديث المختارة)) (269) واللفظ لهما، والطبراني في ((المعجم الأوسط)) (7282) باختلاف يسير.","bab":"رقائق وزهد › الإخلاص","dorar":"rX10TiPQ","merged":2,"otherRefs":["تفسير القرآن العظيم 2/102 (حسن)"]},{"id":"س-00168","fp":"57959e9c1f4b","stateId":455,"easy":"إذا سبك أحد بما فيك فلم تسبه بما فيه ← يكون أجره لك ووزره عليه","cause":"وإن سَبَّكَ رَجُلٌ بشَيءٍ يَعلَمُه فيكَ، وأنتَ تَعلَمُ فيه نَحوَه، فلا تَسُبَّه","result":"فيَكونَ أجرُه لَكَ، ووِزرُه عليه","explicit":true,"repOf":"س-07545","ref":"تخريج المسند لشعيب 15955","text":["«إنَّ عليكَ السَّلامَ تَحيَّةُ المَوتى، إنَّ عليكَ السَّلامَ تَحيَّةُ المَوتى، إنَّ عليكَ السَّلامَ تَحيَّةُ المَوتى، سَلامٌ عليكُم، سَلامٌ عليكُم» مَرَّتَينِ أو ثَلاثًا، هَكَذا قال. سَألتُ عنِ الإزارِ؟ فقُلتُ: أينَ أتَّزِرُ؟ فأقنَعَ ظَهرَه بعَظمِ ساقِه، وقال: «هاهُنا اتَّزِرْ، فإن أبَيتَ فهاهُنا أسفَلَ مِن ذلك، فإن أبَيتَ فهاهُنا فوقَ الكَعبَينِ، فإن أبَيتَ فإنَّ اللهَ عَزَّ وجَلَّ لا يُحِبُّ كُلَّ مُختالٍ فخورٍ» قال: وسَألتُه عنِ المَعروفِ؟ فقال: «لا تَحقِرَنَّ مِنَ المَعروفِ شَيئًا، ولَو أن تُعطيَ صِلةَ الحَبلِ، ولَو أن تُعطيَ شِسعَ النَّعلِ، ولَو أن تَنزِعَ مِن دَلوِكَ في إناءِ المُستَسقي، ولَو أن تُنَحِّيَ الشَّيءَ مِن طَريقِ النَّاسِ يُؤذيهم، ولَو أن تَلقى أخاكَ ووَجهُكَ إليه مُنطَلِقٌ، ولَو أن تَلقى أخاكَ فتُسَلِّمَ عليه، ولَو أن تُؤنِسَ الوَحشانَ في الأرضِ، ",["وإن سَبَّكَ رَجُلٌ بشَيءٍ يَعلَمُه فيكَ، وأنتَ تَعلَمُ فيه نَحوَه، فلا تَسُبَّه",1],"؛ ",["فيَكونَ أجرُه لَكَ، ووِزرُه عليه",2],"، وما سَرَّ أُذُنَكَ أن تَسمَعَه فاعمَلْ به، وما ساءَ أُذُنَكَ أن تَسمَعَه فاجتَنِبْه»."],"grade":"صحيح","narrator":"رجل من قوم أبي تميمة الهجيمي","muhaddith":"إسناده صحيح","bab":"آداب السلام › كيفية السلام","dorar":"Gyr63hi4"},{"id":"س-00255","fp":"0108f4de31bf","stateId":455,"easy":"إذا داريت الناس ← فهو صدقة","cause":"مُداراةُ النَّاسِ","result":"صدقةٌ","explicit":true,"ref":"صحيح ابن حبان 471","srcLabel":"الطبراني","text":[["مُداراةُ النَّاسِ ",1],["صدقةٌ",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (463)، وابن عدي في ((الكامل في الضعفاء)) (2/335)، والبيهقي في ((شعب الإيمان)) (8445)","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"5NanDBAo"},{"id":"س-00248","fp":"8cf3ed579cc0","stateId":455,"easy":"إذا سبك أحد بما يعلم منك فلم تسبه بما تعلم منه ← يكون أجر ذلك لك ووباله عليه","cause":"إذا سبَّكَ رجلٌ بما يعلمُ منكَ","result":"فلا تسبَّهُ بما تعلمُ منهُ ، فيكونُ أجرُ ذلكَ لكَ ووبَالُهُ عليهِ","explicit":true,"ref":"الجامع الصغير 665","srcLabel":"أحمد","text":[["إذا سبَّكَ رجلٌ بما يعلمُ منكَ ، ",1],["فلا تسبَّهُ بما تعلمُ منهُ ، فيكونُ أجرُ ذلكَ لكَ ووبَالُهُ عليهِ",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن","takhrij":"أخرجه أحمد بن منيع كما في ((الجامع الصغير)) للسيوطي (1/51)","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"71tSsmBo"},{"id":"س-04506","fp":"9f1013aa8c34","stateId":455,"easy":"إذا عفوت عن الناس ← تكون ممن أجره على الله فيدخل الجنة","cause":"العافونَ عنِ النَّاسِ","result":"ليَقُمْ مَن أجرُه علَى اللَّهِ فيدخُلِ الجنَّةَ","explicit":true,"otherNeedIds":[67],"ref":"البدور السافرة 135","srcLabel":"الطبراني","text":["إذا وَقفَ العبادُ للحسابِ جاءَ قومٌ واضِعي سيوفِهم علَى رقابِهم تَقطرُ دمًا فازدَحَموا علَى بابِ الجنَّةِ فقيلَ مَن هؤلاءِ قيلَ الشُّهداءُ كانوا أحياءَ مُرزَقينَ ثمَّ ينادي مُنادٍ ليَقُم مَن أجرُهُ علَى اللَّهِ فيدخُلِ الجنَّةَ قيل ومَن ذا الَّذي أجرُهُ علَى اللَّهَ قال ",["العافونَ عنِ النَّاسِ",1]," ثمَّ ينادي الثَّانيةَ ",["ليَقُمْ مَن أجرُه علَى اللَّهِ فيدخُلِ الجنَّةَ",2]," قالَ ومن ذا الَّذي أجرُه علَى اللَّهِ قالَ العافونَ عنِ النَّاسِ ثمَّ يُنادي الثَّالثةَ ليَقُمْ مَن أجرُهُ علَى اللَّهِ فيَدخُلِ الجنَّةَ ، فقامَ كذا وَكذا ألفًا فدَخلوها بغيرِ حِسابٍ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (1998)، وأبو نعيم في ((حلية الأولياء)) (6/187)","bab":"جهاد › فضل الشهيد","dorar":"d31paP0s"},{"id":"س-08079","fp":"72a016a1d415","stateId":455,"easy":"إذا تتاركتم المظالم بينكم ← فثوابكم على الله","cause":"تَتاركوا المظالمَ بينَكم","result":"وثوابُكم عليَّ","explicit":true,"ref":"البدور السافرة 294","srcLabel":"الطبراني","text":["إذا التَقى الخلائقُ يومَ القيامةِ فأُدخِلَ أهلُ الجنةِ الجنةَ ، وأهلُ النارِ النارَ نادى مُناديًا : يا أهلَ الجَمعِ ",["تَتاركوا المظالمَ بينَكم",1]," ",["وثوابُكم عليَّ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (5144)، والخطيب في ((موضح أوهام الجمع والتفريق)) (1/198) باختلاف يسير.","bab":"مظالم › قصاص المظالم","dorar":"dn6sWWHe"},{"id":"س-07158","fp":"92bdee8bf05e","stateId":455,"easy":"إذا دعوت لمن أحسن إليك وأثنيت عليه ← تنال مثل أجره","cause":"ما دَعَوْتُمُ اللهَ لهُم، وأَثْنَيْتُم عليهِم","result":"قال: لا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"similar":["س-07181"],"otherNeedIds":[49],"ref":"الصحيح المسند 113","srcLabel":"مسلم","text":["عن أَنَسٍ، أنَّ المُهاجِرينَ قالوا: يا رسولَ اللهِ، ذَهَبَتِ الأنصارُ بالأجرِ كُلِّهِ، ",["قال: لا",2],"، ",["ما دَعَوْتُمُ اللهَ لهُم، وأَثْنَيْتُم عليهِم",1],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح على شرط مسلم","bab":"علم › حسن السؤال ونصح العالم","dorar":"WmbmCHkV","merged":2,"otherRefs":["الفتوحات الربانية 5/249 (صحيح)"]},{"id":"س-07181","fp":"91e7cfbd3aba","stateId":455,"easy":"إذا أثنيت على من أحسن إليك ودعوت له ← لا يذهب بالأجر كله","cause":"ما أثنَيتُم عليهم به، ودَعَوتُمُ اللهَ لهم","result":"أنْ يَذهَبوا بالأجرِ كُلِّه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-07158","otherNeedIds":[49],"ref":"تخريج المسند لشعيب 13122","text":["قالت المُهاجِرونَ: يا رسولَ اللهِ، ما رَأينا مِثْلَ قومٍ قَدِمنا عليهم أحسَنَ بَذلًا مِن كثيرٍ، ولا أحسَنَ مُواساةً في قليلٍ، قد كَفَوْنا المَؤونةَ، وأشْرَكونا في المَهْنَأِ، فقد خَشينا ",["أنْ يَذهَبوا بالأجرِ كُلِّه،",2]," قال: فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: كلَّا ",["ما أثنَيتُم عليهم به، ودَعَوتُمُ اللهَ لهم",1],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (4812)، والترمذي (2487)، والنسائي في ((السنن الكبرى)) (10009)، وأحمد (13122) واللفظ له","bab":"علم › حسن السؤال ونصح العالم","dorar":"sIFLYLYI","merged":2,"otherRefs":["الأحاديث المختارة 1930 (صحيح)"]},{"id":"س-08418","fp":"02b2965ce00e","stateId":455,"easy":"إذا أثنيت على من أحسن إليك ودعوت له ← فذاك بذاك","cause":"تُثنون عليهم ، و تَدْعون لهم","result":"فذاك بذاك","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[49],"ref":"صحيح الترغيب 977","srcLabel":"أحمد","text":["قال المهاجرون : يا رسولَ اللهِ ذهب الأنصارُ بالأجرِ كلِّه ! ما رأينا قومًا أحسنَ بذلًا لكثيرٍ ، ولا أحسنَ مواساةٍ في قليلٍ منهم ، و لقد كفونا المؤْنةَ . قال : أليس ",["تُثنون عليهم ، و تَدْعون لهم",1]," ؟ قالوا : بلى . قال : ",["فذاك بذاك",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه أحمد (13122)، وأبو يعلى (3780)، والطبراني في ((المعجم الأوسط)) (7292) باختلاف يسير.","bab":"مناقب وفضائل › فضائل المهاجرين ومناقبهم","dorar":"yjObMCVD"},{"id":"س-02351","fp":"1ad120ffd226","stateId":456,"easy":"إذا دعوت إلى هدى ← لك مثل أجور من تبعك لا ينقص من أجورهم شيء","cause":"مَن دعا إلى هُدًى","result":"كان له من الأجرِ مِثْلُ أجورِ مَن تَبِعَه ، لا يَنْقُصُ ذلك من أجورِهِم شيئًا","explicit":true,"star":true,"ref":"صحيح الجامع 6234","srcLabel":"مسلم","text":[["مَن دعا إلى هُدًى ، ",1],["كان له من الأجرِ مِثْلُ أجورِ مَن تَبِعَه ، لا يَنْقُصُ ذلك من أجورِهِم شيئًا ، ",2],"ومَن دعا إلى ضلالةٍ ، كان عليه من الإثمِ ، مِثْلُ آثامِ مَن تَبِعَه ، لا يَنْقُصُ ذلك من آثامِهِم شيئًا"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2674)","bab":"إحسان › الحسنات والسيئات","dorar":"GB4lzl61"},{"id":"س-05075","fp":"cd5e9c1fb00c","stateId":456,"easy":"إذا سننت في الإسلام سنة حسنة فعُمل بها ← لك أجرها وأجر من عمل بها بعدك","cause":"مَن سنَّ في الإسلامِ سُنَّةً حسَنةً فعُمِل بها مِن بعدِه","result":"كان له أجرُها وأجرُ مَن يعمَلُ بها مِن بعدِه","explicit":true,"star":true,"otherNeedIds":[50],"ref":"تخريج صحيح ابن حبان 3308","srcLabel":"مسلم","text":["كنَّا عندَ النَّبيِّ صلَّى اللهُ عليه وسلَّم مِن صدرِ النَّهارِ فجاء قومٌ حفاةٌ عراةٌ مُجتابِي النِّمارِ عليهم سيوفٌ، عامَّتُهم مِن مُضَرَ بل كلُّهم مِن مُضَرَ فرأَيْتُ وجهَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم تغيَّر لِما رأى منهم مِن الفاقةِ قال: فدخَل فأمَر بلالًا فأذَّن ثمَّ أقام فخرَج فصلَّى ثمَّ قال: ({يَا أَيُّهَا النَّاسُ اتَّقُوا رَبَّكُمُ الَّذِي خَلَقَكُمْ مِنْ نَفْسٍ وَاحِدَةٍ وَخَلَقَ مِنْهَا زَوْجَهَا وَبَثَّ مِنْهُمَا رِجَالًا كَثِيرًا وَنِسَاءً وَاتَّقُوا اللَّهَ الَّذِي تَسَاءَلُونَ بِهِ وَالْأَرْحَامَ إِنَّ اللَّهَ كَانَ عَلَيْكُمْ رَقِيبًا} [النساء: 1]، {اتَّقُوا اللَّهَ وَلْتَنْظُرْ نَفْسٌ مَا قَدَّمَتْ لِغَدٍ} [الحشر: 18] يتصدَّقُ امرؤٌ مِن دينارِه ومِن درهمِه ومِن ثوبِه ومِن صاعِ بُرِّه ومِن صاعِ شعيرِه ) حتَّى ذكَر شِقَّ تمرةٍ فجاء رجلٌ منِ الأنصارِ بصُرَّةٍ كادت تعجِزُ كفَّاه بل قد عجَزَت ثمَّ تتابَع النَّاسُ حتَّى رأَيْتُ بينَ يدَيْ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم كَوْمَيْنِ مِن الثِّيابِ والطَّعامِ فلقد رأَيْتُ وجهَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم تهلَّل حتَّى كأنَّه مُذْهَبةٌ ثمَّ قال: ( ",["مَن سنَّ في الإسلامِ سُنَّةً حسَنةً فعُمِل بها مِن بعدِه ",1],["كان له أجرُها وأجرُ مَن يعمَلُ بها مِن بعدِه ",2],"ومَن سنَّ سُنَّةً سيِّئةً فعُمِل بها مِن بعدِه كان عليه وِزْرُها ووِزْرُ مَن عمِل بها مِن بعدِه )"],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن حبان (3308) بلفظه،  ومسلم (1017)، والنسائي (2554)، وأحمد (19174) جميعا بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"DCtXBo5K"},{"id":"ق-0277","fp":"a8c839aa951a","stateId":456,"easy":"الرسوخ في العلم والإيمان وإقامة الصلاة وإيتاء الزكاة ← أجر عظيم","cause":"الرسوخ في العلم والإيمان وإقامة الصلاة وإيتاء الزكاة","result":"أجر عظيم","explicit":true,"star":true,"ref":"سورة النساء: 162","srcLabel":"القرآن الكريم","quran":{"s":4,"from":162,"to":162,"text":"لَكِنِ الرَّاسِخُونَ فِي الْعِلْمِ مِنْهُمْ وَالْمُؤْمِنُونَ يُؤْمِنُونَ بِمَا أُنْزِلَ إِلَيْكَ وَمَا أُنْزِلَ مِنْ قَبْلِكَ وَالْمُقِيمِينَ الصَّلَاةَ وَالْمُؤْتُونَ الزَّكَاةَ وَالْمُؤْمِنُونَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ أُولَئِكَ سَنُؤْتِيهِمْ أَجْرًا عَظِيمًا (162)","hl":[[0,267,1]]}},{"id":"س-07085","fp":"fefddbd110ac","stateId":456,"easy":"إذا تعلمت العلم ← فتعليمه حسنة وطلبه عبادة ومذاكرته تسبيح","cause":"عليكُم بالعِلمِ","result":"فإنَّ تعليمَهُ حسَنةٌ وطلبَهُ عبادةٌ ومذاكرتَهُ تسبيحٌ والبحثَ عنْهُ جِهادٌ","explicit":true,"star":true,"otherNeedIds":[18],"ref":"نقض المنطق 4/92","srcLabel":"نقض المنطق","text":["عن معاذٍ ",["عليكُم بالعِلمِ",1],". ",["فإنَّ تعليمَهُ حسَنةٌ وطلبَهُ عبادةٌ ومذاكرتَهُ تسبيحٌ والبحثَ عنْهُ جِهادٌ",2]," وتعليمَهُ لمن لا يعلمُهُ صدقةٌ وبذلَهُ لأَهلِهِ قُربةٌ"],"grade":"صحيح","muhaddith":"محفوظ","bab":"علم › تعليم الناس وفضل ذلك","dorar":"FjoVVxVo"},{"id":"س-07969","fp":"2e192ed422df","stateId":456,"easy":"إذا غدوت إلى المسجد لتتعلم خيراً أو تعلّمه ← فلك أجر حاج تامّ حجته","cause":"من غدا إلى مسجدٍ لا يريدُ إلا أن يتعلَّمَ خيرًا أو يُعلِّمَه","result":"كان له كأجرِ حاجٍّ ، تامًّا حجَّتُه","explicit":true,"otherNeedIds":[49],"ref":"صحيح الترغيب 86","srcLabel":"ابن حبان","text":[["من غدا إلى مسجدٍ لا يريدُ إلا أن يتعلَّمَ خيرًا أو يُعلِّمَه ، ",1],["كان له كأجرِ حاجٍّ ، تامًّا حجَّتُه",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"حسن صحيح","takhrij":"أخرجه ابن حبان في ((المجروحين)) (2/156)، والطبراني (8/111) (7473)، وأبو نعيم في ((حلية الأولياء)) (6/97) مطولاً.","bab":"مساجد ومواضع الصلاة › فضل من غدا إلى المسجد أو راح","dorar":"7KFVmsU9"},{"id":"س-02084","fp":"d958c2b9c912","stateId":456,"easy":"إذا طلبت علماً فأدركته ← يكتب الله لك كفلين من الأجر","cause":"مَن طلَبَ عِلمًا فأدركَهُ","result":"كتبَ اللَّهُ لهُ كِفلَينِ منَ الأجْرِ","explicit":true,"ref":"مطلع البدرين 32","srcLabel":"ابن حبان","text":[["مَن طلَبَ عِلمًا فأدركَهُ ",1],["كتبَ اللَّهُ لهُ كِفلَينِ منَ الأجْرِ ",2],"ومن طلبَ عِلْمًا فلم يدركْهُ كتبَ اللَّهُ لهُ كفلًا منَ الأجرِ"],"grade":"حسن","narrator":"واثلة بن الأسقع الليثي أبو فسيلة","muhaddith":"رجاله موثقون","takhrij":"أخرجه الدارمي (335)، وابن حبان في ((المجروحين)) (2/294)، والطبراني (22/68) (165) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"prYoUFIP"},{"id":"س-02085","fp":"67c4fb5f22cc","stateId":456,"easy":"إذا طلبت علماً فلم تدركه ← يكتب الله لك كفلاً من الأجر","cause":"ومن طلبَ عِلْمًا فلم يدركْهُ","result":"كتبَ اللَّهُ لهُ كفلًا منَ الأجرِ","explicit":true,"ref":"مطلع البدرين 32","srcLabel":"ابن حبان","text":["مَن طلَبَ عِلمًا فأدركَهُ كتبَ اللَّهُ لهُ كِفلَينِ منَ الأجْرِ ",["ومن طلبَ عِلْمًا فلم يدركْهُ",1]," ",["كتبَ اللَّهُ لهُ كفلًا منَ الأجرِ",2]],"grade":"حسن","narrator":"واثلة بن الأسقع الليثي أبو فسيلة","muhaddith":"رجاله موثقون","takhrij":"أخرجه الدارمي (335)، وابن حبان في ((المجروحين)) (2/294)، والطبراني (22/68) (165) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"prYoUFIP"},{"id":"س-06992","fp":"43310c3db688","stateId":456,"easy":"إذا رددت علينا المسائل (العلم) ← فأجر آخرها كأجر أولها","cause":"رُدُّوا علينا المسائلَ","result":"فإن أجرَ آخرِها كأجرِ أولِها","explicit":true,"ref":"مجمع الزوائد 1/166","srcLabel":"الطبراني","text":["عن فَضالةَ بنِ عُبيدٍ أنه كان إذا أتاه أصحابُه قال تدارسوا وأبشروا وزيدوا زادكم اللهُ خيرًا وأحبَّكم وأحبَّ مَن يُحبُّكم ",["رُدُّوا علينا المسائلَ",1]," ",["فإن أجرَ آخرِها كأجرِ أولِها",2]," اخلطوا حديثَكم بالاستغفارِ"],"grade":"حسن","narrator":"يونس بن ميسرة.","muhaddith":"رجاله موثقون","takhrij":"أخرجه الطبراني في ((الكبير)) (18/ 299) (767)، وابن عساكر في ((تاريخ دمشق)) (48/ 304) واللفظ لهما.","bab":"عقيدة › التفاؤل","dorar":"VQ0h5Rvi"},{"id":"س-06995","fp":"63c27c0dbd04","stateId":456,"easy":"إذا أحييت سنة أُميتت ← لك من الأجر مثل من عمل بها من غير أن ينقص من أجورهم","cause":"مَنْ أحْيا سُنَّةً من سُنَّتِي قدْ أُمِيتَتْ بَعدِي","result":"فإنَّ لهُ من الأجرِ مِثلَ مَنْ عَمِلَ بِها من غَيرِ أنْ يَنْقُصَ من أُجُورِهِمْ شيئٌ","explicit":true,"otherNeedIds":[50],"ref":"سنن الترمذي 2677","srcLabel":"ابن ماجه","text":["أنَّ النبيَّ صلَّى اللهُ عليه وسَلَّمَ قال لِبِلالِ بنِ الحارِثِ اعْلَمْ قال : ما أعْلَمُ يا رسولَ اللهِ ؟ قال إنَّهُ ",["مَنْ أحْيا سُنَّةً من سُنَّتِي قدْ أُمِيتَتْ بَعدِي ",1],["فإنَّ لهُ من الأجرِ مِثلَ مَنْ عَمِلَ بِها من غَيرِ أنْ يَنْقُصَ من أُجُورِهِمْ شيئٌ",2]," ومَنِ ابْتدَعَ بِدعةً ضَلالَةً لا يَرْضَاها اللهُ ورسولُهُ كان عليه مِثلُ آثامِ مَن عَمِلَ بِها لا يُنقِصُ ذلِك من أوزارِ الناسِ ( في روايةٍ من آثامِ النَّاسِ ) شيئًا"],"grade":"حسن","narrator":"عمرو بن عوف المزني","muhaddith":"حسن","takhrij":"أخرجه ابن عدي في ((الكامل)) (7/ 193) واللفظ له ، وابن ماجه (210) ، والطبراني (17/ 16) (10) كلاهما بنحوه .","bab":"علم › الحث على الأخذ بالسنة","dorar":"x6C86RhP"},{"id":"س-07087","fp":"39a6af7df966","stateId":456,"easy":"إذا كنت عالماً أو متعلماً ← فأنتما شريكان في الخير","cause":"العالمُ والمتعلمُ","result":"شَرِيكانِ في الخيرِ","explicit":true,"otherNeedIds":[18],"ref":"الجامع الصغير 5638","srcLabel":"الطبراني","text":[["العالمُ والمتعلمُ",1]," ",["شَرِيكانِ في الخيرِ",2]," ، وسائرُ الناسِ لا خَيْرَ فيه"],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((الشاميين)) (2218)، والقضاعي في ((مسند الشهاب)) (279)، وأبو علي الصدفي في ((معجمه)) (صـ257) باختلاف يسير.","bab":"علم › تعليم الناس وفضل ذلك","dorar":"uHmsz0sG"},{"id":"س-02098","fp":"c75c76d990ee","stateId":457,"easy":"إذا تحاب رجلان ← فأفضلهما أشدهما حباً لصاحبه","cause":"ما تحابَّ رجلانِ قَطُّ","result":"إلا كان أفضَلُهما أشدَّهما حبًّا إلى صاحبِه","explicit":true,"star":true,"ref":"إتحاف الخيرة المهرة 6/109","srcLabel":"البخاري","text":[["ما تحابَّ رجلانِ قَطُّ",1]," ",["إلا كان أفضَلُهما أشدَّهما حبًّا إلى صاحبِه",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن","takhrij":"أخرجه الطيالسي في ((المسند)) (2166)، والبخاري في ((الأدب المفرد)) (544)، والبزار (6869) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"ljbuXOYK"},{"id":"س-02318","fp":"94a50dafeecd","stateId":457,"easy":"إذا أحببت أخاك في الله وأخبرته ← فلك أجر","cause":"إنِّي أُحِبُّك في اللهِ","result":"إنَّ ذلك لِمْن ذَكَرَه أَجْرٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأحاديث المختارة 9 / 408","srcLabel":"متفق عليه","text":["«قُلْتُ لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنِّي أُحِبُّ أبا ذَرٍّ، قالَ: فأَعْلَمْتَه ذلك؟ فقُلْتُ: لا، قالَ: فأَعْلِمْه، فلَقيْتُ أبا ذَرٍّ فقُلْتُ: ",["إنِّي أُحِبُّك في اللهِ",1],"، فقالَ: أَحَبَّك الَّذي أَحْبَبْتَني له، فرَجَعْتُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فأَخْبَرْتُه، فقالَ: أَمَا ",["إنَّ ذلك لِمْن ذَكَرَه أَجْرٌ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن سرجس المزني","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"zLyWkPEi"},{"id":"س-02146","fp":"504ec4115cf5","stateId":457,"easy":"إذا تحاببتما في الله ← فأفضلكما أشدكما حباً لصاحبه","cause":"ما تَحابَّ رَجلانِ في اللهِ تعالَى","result":"إلَّا كان أفضَلُهما أشَدَّ حُبًّا لصاحِبِه","explicit":true,"ref":"المستدرك على الصحيحين 7529","srcLabel":"الطبراني","text":[["ما تَحابَّ رَجلانِ في اللهِ تعالَى،",1]," ",["إلَّا كان أفضَلُهما أشَدَّ حُبًّا لصاحِبِه",2],"."],"grade":"صحيح","narrator":"أنس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطيالسي (2166)، وأبو يعلى (3419)، والطبراني في ((الأوسط)) (2899) واللفظ لهم.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"33FEmdLn","merged":2,"otherRefs":["صحيح الجامع 5594 (صحيح)"]},{"id":"ق-0033","fp":"ec9c52431fbe","stateId":458,"easy":"الإيمان والتقوى ← مثوبة من عند الله خير","cause":"الإيمان والتقوى","result":"مثوبة من عند الله خير","explicit":true,"star":true,"ref":"سورة البقرة: 103","srcLabel":"القرآن الكريم","quran":{"s":2,"from":103,"to":103,"text":"وَلَوْ أَنَّهُمْ آمَنُوا وَاتَّقَوْا لَمَثُوبَةٌ مِنْ عِنْدِ اللَّهِ خَيْرٌ لَوْ كَانُوا يَعْلَمُونَ (103)","hl":[[0,100,1]]}},{"id":"ق-0073","fp":"db53b545e6c4","stateId":458,"easy":"فعل الخير والتزود بالتقوى ← يعلمه الله ويجازي به، وخير الزاد التقوى","cause":"فعل الخير والتزود بالتقوى","result":"يعلمه الله ويجازي به، وخير الزاد التقوى","explicit":true,"star":true,"ref":"سورة البقرة: 197","srcLabel":"القرآن الكريم","quran":{"s":2,"from":197,"to":197,"text":"الْحَجُّ أَشْهُرٌ مَعْلُومَاتٌ فَمَنْ فَرَضَ فِيهِنَّ الْحَجَّ فَلَا رَفَثَ وَلَا فُسُوقَ وَلَا جِدَالَ فِي الْحَجِّ وَمَا تَفْعَلُوا مِنْ خَيْرٍ يَعْلَمْهُ اللَّهُ وَتَزَوَّدُوا فَإِنَّ خَيْرَ الزَّادِ التَّقْوَى وَاتَّقُونِ يَا أُولِي الْأَلْبَابِ (197)","hl":[[117,213,1]]}},{"id":"ق-0192","fp":"b29c91bda6ea","stateId":458,"easy":"الإيمان والتقوى ← أجر عظيم","cause":"الإيمان والتقوى","result":"أجر عظيم","explicit":true,"star":true,"ref":"سورة آل عمران: 179","srcLabel":"القرآن الكريم","quran":{"s":3,"from":179,"to":179,"text":"مَا كَانَ اللَّهُ لِيَذَرَ الْمُؤْمِنِينَ عَلَى مَا أَنْتُمْ عَلَيْهِ حَتَّى يَمِيزَ الْخَبِيثَ مِنَ الطَّيِّبِ وَمَا كَانَ اللَّهُ لِيُطْلِعَكُمْ عَلَى الْغَيْبِ وَلَكِنَّ اللَّهَ يَجْتَبِي مِنْ رُسُلِهِ مَنْ يَشَاءُ فَآمِنُوا بِاللَّهِ وَرُسُلِهِ وَإِنْ تُؤْمِنُوا وَتَتَّقُوا فَلَكُمْ أَجْرٌ عَظِيمٌ (179)","hl":[[249,302,1]]}},{"id":"ق-0201","fp":"f5d8c510c4aa","stateId":458,"easy":"الإيمان والخشوع لله وعدم بيع آياته بثمن قليل ← الأجر عند الله","cause":"الإيمان والخشوع لله وعدم بيع آياته بثمن قليل","result":"الأجر عند الله","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"سورة آل عمران: 199","srcLabel":"القرآن الكريم","quran":{"s":3,"from":199,"to":199,"text":"وَإِنَّ مِنْ أَهْلِ الْكِتَابِ لَمَنْ يُؤْمِنُ بِاللَّهِ وَمَا أُنْزِلَ إِلَيْكُمْ وَمَا أُنْزِلَ إِلَيْهِمْ خَاشِعِينَ لِلَّهِ لَا يَشْتَرُونَ بِآيَاتِ اللَّهِ ثَمَنًا قَلِيلًا أُولَئِكَ لَهُمْ أَجْرُهُمْ عِنْدَ رَبِّهِمْ إِنَّ اللَّهَ سَرِيعُ الْحِسَابِ (199)","hl":[[0,222,1]]}},{"id":"ق-0256","fp":"eb28077613fe","stateId":458,"easy":"الإحسان والتقوى ← يجازي الله به","cause":"الإحسان والتقوى","result":"يجازي الله به","explicit":true,"ref":"سورة النساء: 128","srcLabel":"القرآن الكريم","quran":{"s":4,"from":128,"to":128,"text":"وَإِنِ امْرَأَةٌ خَافَتْ مِنْ بَعْلِهَا نُشُوزًا أَوْ إِعْرَاضًا فَلَا جُنَاحَ عَلَيْهِمَا أَنْ يُصْلِحَا بَيْنَهُمَا صُلْحًا وَالصُّلْحُ خَيْرٌ وَأُحْضِرَتِ الْأَنْفُسُ الشُّحَّ وَإِنْ تُحْسِنُوا وَتَتَّقُوا فَإِنَّ اللَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًا (128)","hl":[[179,257,1]]}},{"id":"ق-0837","fp":"fef15e6afdb3","stateId":458,"easy":"خشية الله والإيمان بآياته وترك الشرك والإنفاق مع وجل القلب ← المسارعة في الخيرات والسبق إليها","cause":"خشية الله والإيمان بآياته وترك الشرك والإنفاق مع وجل القلب","result":"المسارعة في الخيرات والسبق إليها","explicit":true,"otherNeedIds":[17],"ref":"سورة المؤمنون: 57–61","srcLabel":"القرآن الكريم","quran":{"s":23,"from":57,"to":61,"text":"إِنَّ الَّذِينَ هُمْ مِنْ خَشْيَةِ رَبِّهِمْ مُشْفِقُونَ (57) وَالَّذِينَ هُمْ بِآيَاتِ رَبِّهِمْ يُؤْمِنُونَ (58) وَالَّذِينَ هُمْ بِرَبِّهِمْ لَا يُشْرِكُونَ (59) وَالَّذِينَ يُؤْتُونَ مَا آتَوْا وَقُلُوبُهُمْ وَجِلَةٌ أَنَّهُمْ إِلَى رَبِّهِمْ رَاجِعُونَ (60) أُولَئِكَ يُسَارِعُونَ فِي الْخَيْرَاتِ وَهُمْ لَهَا سَابِقُونَ (61)","hl":[[0,326,1]]}},{"id":"ق-0990","fp":"19588bf7a27a","stateId":458,"easy":"إرادة الله ورسوله والدار الآخرة (الإحسان) ← أجر عظيم","cause":"إرادة الله ورسوله والدار الآخرة (الإحسان)","result":"أجر عظيم","explicit":true,"ref":"سورة الأحزاب: 29","srcLabel":"القرآن الكريم","quran":{"s":33,"from":29,"to":29,"text":"وَإِنْ كُنْتُنَّ تُرِدْنَ اللَّهَ وَرَسُولَهُ وَالدَّارَ الْآخِرَةَ فَإِنَّ اللَّهَ أَعَدَّ لِلْمُحْسِنَاتِ مِنْكُنَّ أَجْرًا عَظِيمًا (29)","hl":[[0,134,1]]}},{"id":"ق-1025","fp":"8e9c65fd5ddb","stateId":458,"easy":"التزكّي ← نفعه لنفسه","cause":"التزكّي","result":"نفعه لنفسه","explicit":true,"otherNeedIds":[19],"ref":"سورة فاطر: 18","srcLabel":"القرآن الكريم","quran":{"s":35,"from":18,"to":18,"text":"وَلَا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَى وَإِنْ تَدْعُ مُثْقَلَةٌ إِلَى حِمْلِهَا لَا يُحْمَلْ مِنْهُ شَيْءٌ وَلَوْ كَانَ ذَا قُرْبَى إِنَّمَا تُنْذِرُ الَّذِينَ يَخْشَوْنَ رَبَّهُمْ بِالْغَيْبِ وَأَقَامُوا الصَّلَاةَ وَمَنْ تَزَكَّى فَإِنَّمَا يَتَزَكَّى لِنَفْسِهِ وَإِلَى اللَّهِ الْمَصِيرُ (18)","hl":[[215,290,1]]}},{"id":"ق-1226","fp":"10cc4098510c","stateId":458,"easy":"الإيمان والتقوى ← إيتاء الأجور","cause":"الإيمان والتقوى","result":"إيتاء الأجور","explicit":true,"ref":"سورة محمد: 36","srcLabel":"القرآن الكريم","quran":{"s":47,"from":36,"to":36,"text":"إِنَّمَا الْحَيَاةُ الدُّنْيَا لَعِبٌ وَلَهْوٌ وَإِنْ تُؤْمِنُوا وَتَتَّقُوا يُؤْتِكُمْ أُجُورَكُمْ وَلَا يَسْأَلْكُمْ أَمْوَالَكُمْ (36)","hl":[[47,132,1]]}},{"id":"س-05622","fp":"07aacfb34b38","stateId":458,"easy":"إذا تزودت من الدنيا للآخرة ← ينفعك في الآخرة","cause":"مَن يتزوَّدْ من الدُّنيا","result":"ينفَعْه في الآخرةِ","explicit":true,"ref":"مجمع الزوائد 10/314","srcLabel":"مجمع الزوائد","text":[["مَن يتزوَّدْ من الدُّنيا ",1],["ينفَعْه في الآخرةِ",2]],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"رجاله رجال الصحيح","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"q9nemUvW","merged":2,"otherRefs":["عمدة التفسير 1/246 (صحيح)"]},{"id":"س-07172","fp":"db9e4f889afb","stateId":458,"easy":"إذا أمسكت عن الحرام (كف عنها) ← فهو خير لك من مائة ناقة","cause":"ولأَن تُمْسِكَ عنها","result":"خيرٌ لك مِن مائةِ ناقةٍ كُلِّها سودُ الحَدَقِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الترغيب والترهيب 1/257","srcLabel":"أحمد","text":["سأَلتُ النبي صلَّى اللَّهُ عليهِ وسلَّمَ عن مَسحِ الحصَى في الصلاة فقالَ : واحدةٌ ",["ولأَن تُمْسِكَ عنها",1]," ",["خيرٌ لك مِن مائةِ ناقةٍ كُلِّها سودُ الحَدَقِ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أحمد (14554)، وابن خزيمة (897)، والطحاوي في ((شرح مشكل الآثار)) (1433) باختلاف يسير.","bab":"علم › حسن السؤال ونصح العالم","dorar":"ljxLREz0"},{"id":"ق-1158","fp":"93ba5067380b","stateId":458,"easy":"الإيمان والتوكل واجتناب الكبائر والفواحش والمغفرة عند الغضب والاستجابة لله وإقامة الصلاة والشورى والإنفاق ← ما عند الله خير وأبقى","cause":"الإيمان والتوكل واجتناب الكبائر والفواحش والمغفرة عند الغضب والاستجابة لله وإقامة الصلاة والشورى والإنفاق","result":"ما عند الله خير وأبقى","explicit":true,"star":true,"otherNeedIds":[67],"ref":"سورة الشورى: 36–39","srcLabel":"القرآن الكريم","quran":{"s":42,"from":36,"to":39,"text":"فَمَا أُوتِيتُمْ مِنْ شَيْءٍ فَمَتَاعُ الْحَيَاةِ الدُّنْيَا وَمَا عِنْدَ اللَّهِ خَيْرٌ وَأَبْقَى لِلَّذِينَ آمَنُوا وَعَلَى رَبِّهِمْ يَتَوَكَّلُونَ (36) وَالَّذِينَ يَجْتَنِبُونَ كَبَائِرَ الْإِثْمِ وَالْفَوَاحِشَ وَإِذَا مَا غَضِبُوا هُمْ يَغْفِرُونَ (37) وَالَّذِينَ اسْتَجَابُوا لِرَبِّهِمْ وَأَقَامُوا الصَّلَاةَ وَأَمْرُهُمْ شُورَى بَيْنَهُمْ وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ (38) وَالَّذِينَ إِذَا أَصَابَهُمُ الْبَغْيُ هُمْ يَنْتَصِرُونَ (39)","hl":[[61,449,1]]}},{"id":"س-00149","fp":"048c3ec0d6da","stateId":459,"easy":"إذا سلّمت على مجلس ذكر ← تكون شريكهم فيما يصيبون","cause":"فقُلِ السَّلامُ عليكم","result":"فإنَّك شريكُهم فيما يُصيبون في ذلك المجلسِ","explicit":true,"star":true,"ref":"الترغيب والترهيب 3/370","srcLabel":"البخاري","text":["عن أبيه رضِي اللهُ عنه قال يا بُنيَّ إذا كنتَ في مجلسٍ ترجو خيرَه فعجَّلت بك حاجةٌ ",["فقُلِ السَّلامُ عليكم",1]," ",["فإنَّك شريكُهم فيما يُصيبون في ذلك المجلسِ",2]],"grade":"صحيح","narrator":"معاوية بن قرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (19/ 25) (52)، وأبو نعيم في ((حلية الأولياء)) (2/ 301) واللفظ لهما، والبخاري في ((الأدب المفرد)) (1009) بنحوه.","bab":"آداب السلام › إفشاء السلام","dorar":"91niTgcu"},{"id":"س-00151","fp":"99f24efee32b","stateId":459,"easy":"إذا بدأت القوم بالسلام ← يكون لك الأجر","cause":"فابْدَأْهم بالسَّلامِ","result":"يكونُ لك الأجْرُ","explicit":true,"star":true,"ref":"الأحاديث المختارة 1495","srcLabel":"البخاري","text":["«أنَّ الأغَرَّ -وهو رَجُلٌ مِن مُزَيْنةَ- كانَتْ له صُحْبةٌ معَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، كانَتْ له أَوْسُقٌ مِن تَمْرٍ على رَجُلٍ مِن بَني عَمْرِو بنِ عَوْفٍ، فاخْتَلَفَ إليه مِرارًا، قالَ: فجِئْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فأَرسَلَ معي أبا بَكْرٍ الصِّدِّيقَ رَضِيَ اللهُ عنه قالَ: وكلُّ مَن لَقينا سَلَّموا علينا، فقالَ أبو بَكْرٍ رَضِيَ اللهُ عنه: أَلَا أرى النَّاسَ يَبْدَؤونَك بالسَّلامِ فيكونَ لهم الأجْرُ، ",["فابْدَأْهم بالسَّلامِ",1]," ",["يكونُ لك الأجْرُ",2],"»."],"grade":"صحيح","narrator":"أغر بن يسار المزني","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"آداب السلام › إفشاء السلام","dorar":"u1gI62fO"},{"id":"س-07347","fp":"21312db3a1a6","stateId":459,"easy":"إذا سلّمت على أخيك فرد عليك ← اشتركتما في الأجر","cause":"فليسلِّم علَيهِ","result":"فإن ردَّ علَيهِ فقدِ اشترَكا في الأجرِ","explicit":true,"star":true,"otherNeedIds":[41],"ref":"فتح الباري لابن حجر 10/511","srcLabel":"البخاري","text":[". .فإن مرَّتْ بي ثلاثةٌ فلقيَهُ ",["فليسلِّم علَيهِ",1]," ، ",["فإن ردَّ علَيهِ فقدِ اشترَكا في الأجرِ",2]," ، وإن لم يردَّ علَيهِ فقد باءَ بالإثْمِ وخرجَ المسلِّمُ منَ الهِجرةِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4912)، والبخاري في ((الأدب المفرد)) (414)، والخرائطي في ((مساويء الأخلاق)) (528) باختلاف يسير.","bab":"فتن › كراهية الاختلاف","dorar":"dgA8LEMe"},{"id":"س-00957","fp":"e293d9f86277","stateId":459,"easy":"إذا سلّمت على عباد الله ← فهو صدقة","cause":"إنَّ سَلامَكَ على عبادِ اللهِ","result":"صَدقةٌ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 8354","srcLabel":"متفق عليه","text":["على كلِّ سُلامَى مِنِ ابنِ آدمَ صدَقةٌ حين يُصبِحُ، فشَقَّ ذلك على المسلمينَ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["إنَّ سَلامَكَ على عبادِ اللهِ ",1],["صَدقةٌ",2],"، وإماطتَكَ الأذى عَنِ الطريقِ صَدَقةٌ، وإنَّ أَمْرَكَ بالمعروفِ صَدَقةٌ، وإنَّ نَهيَكَ عَنِ المنكَرَ صَدَقةٌ، وحَدَّثَ أشياءَ مِن نحوِ هذا لم أَحفَظْها."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن لغيره","takhrij":"أخرجه البخاري (2989)، ومسلم (1009) بنحوه، وأحمد (8354) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"OsBtFBHr"},{"id":"س-00160","fp":"62885e3230bc","stateId":459,"easy":"إذا سبقت إلى السلام ← تنال فضل القوم","cause":"لا يسبِقُك إلى السَّلامِ أحدٌ","result":"ما يُصِيبُ القومَ عليك من الفضلِ","explicit":true,"star":true,"ref":"مجمع الزوائد 8/35","srcLabel":"الطبراني","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّم أمَر لي بجزءٍ من ثمرٍ عندَ رجلٍ من الأنصارِ فمطَلني به فكلَّمْتُ فيه رسولَ اللهِ صلَّى اللهُ عليه وسلَّم فقال اغدُ معه يا أبا بكرٍ فخُذْ له ثمرَه فوعَدني أبو بكرٍ المسجدَ إذا صلَّيْنا الصُّبحَ فوجَدْتُه حيثُ وعَدني فانطَلَقْنا فكلَّما رأى أبا بكرٍ رجلٌ من بعيدٍ سلَّم عليه فقال أبو بكرٍ أما ترى ",["ما يُصِيبُ القومَ عليك من الفضلِ",2]," ",["لا يسبِقُك إلى السَّلامِ أحدٌ",1]," فكُنَّا إذا طلَع الرَّجلُ بادَرْناه بالسَّلامِ قبلَ أن يُسلِّمَ علينا"],"grade":"صحيح","narrator":"الأغر المزني أبو مالك","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه بنحوه أبو القاسم البغوي في ((معجم الصحابة)) (95)، والطبراني (1/300) (880) باختلاف يسير، وأبو نعيم في ((معرفة الصحابة)) (1046) مختصرا بنحوه","bab":"آداب السلام › فضل السلام والرد عليه","dorar":"gQRaYNgf"},{"id":"س-00163","fp":"3b7f5e8b734c","stateId":459,"easy":"إذا قلت «السلام عليكم» ← تُكتب لك عشر حسنات","cause":"من قال : السلامُ عليكم","result":"كُتِبَتْ له عشرُ حسناتٍ","explicit":true,"apply":{"k":"say","t":"«السلام عليكم»"},"similar":["س-00164","س-00171","س-00172","س-00119"],"ref":"صحيح الترغيب 2711","srcLabel":"الطبراني","text":[["من قال : ( السلامُ عليكم ) ",1],["كُتِبَتْ له عشرُ حسناتٍ ، ",2],"ومن قال : ( السلامُ عليكم ورحمةُ اللهِ ) كُتِبت له عشرون حسنةً ، ومن قال : ( السلامُ عليكم ورحمةُ الله وبركاتُه ) كُتِبَتْ له ثلاثونَ حسنةً ."],"grade":"صحيح","narrator":"سهل بن حنيف","muhaddith":"صحيح لغيره","takhrij":"أخرجه عبد بن حميد (469) واللفظ له، وابن أبي شيبة في ((المسند)) (56)، والطبراني (6/75) (5563) باختلاف يسير","bab":"آداب السلام › كيفية السلام","dorar":"yGMkidbi"},{"id":"س-00164","fp":"b0b592114fb6","stateId":459,"easy":"إذا قلت «السلام عليكم ورحمة الله» ← تُكتب لك عشرون حسنة","cause":"ومن قال : السلامُ عليكم ورحمةُ اللهِ","result":"كُتِبت له عشرون حسنةً","explicit":true,"apply":{"k":"say","t":"«السلام عليكم ورحمة الله»"},"repOf":"س-00163","ref":"صحيح الترغيب 2711","text":["من قال : ( السلامُ عليكم ) كُتِبَتْ له عشرُ حسناتٍ ، ",["ومن قال : ( السلامُ عليكم ورحمةُ اللهِ ) ",1],["كُتِبت له عشرون حسنةً ، ",2],"ومن قال : ( السلامُ عليكم ورحمةُ الله وبركاتُه ) كُتِبَتْ له ثلاثونَ حسنةً ."],"grade":"صحيح","narrator":"سهل بن حنيف","muhaddith":"صحيح لغيره","takhrij":"أخرجه عبد بن حميد (469) واللفظ له، وابن أبي شيبة في ((المسند)) (56)، والطبراني (6/75) (5563) باختلاف يسير","bab":"آداب السلام › كيفية السلام","dorar":"yGMkidbi"},{"id":"س-00165","fp":"06e558b294fd","stateId":459,"easy":"إذا قلت «السلام عليكم ورحمة الله وبركاته» ← تُكتب لك ثلاثون حسنة","cause":"ومن قال : السلامُ عليكم ورحمةُ الله وبركاتُه","result":"كُتِبَتْ له ثلاثونَ حسنةً","explicit":true,"apply":{"k":"say","t":"«السلام عليكم ورحمة الله وبركاته»"},"similar":["س-02024","س-00169"],"ref":"صحيح الترغيب 2711","srcLabel":"الطبراني","text":["من قال : ( السلامُ عليكم ) كُتِبَتْ له عشرُ حسناتٍ ، ومن قال : ( السلامُ عليكم ورحمةُ اللهِ ) كُتِبت له عشرون حسنةً ، ",["ومن قال : ( السلامُ عليكم ورحمةُ الله وبركاتُه ) ",1],["كُتِبَتْ له ثلاثونَ حسنةً ",2],"."],"grade":"صحيح","narrator":"سهل بن حنيف","muhaddith":"صحيح لغيره","takhrij":"أخرجه عبد بن حميد (469) واللفظ له، وابن أبي شيبة في ((المسند)) (56)، والطبراني (6/75) (5563) باختلاف يسير","bab":"آداب السلام › كيفية السلام","dorar":"yGMkidbi"},{"id":"س-00286","fp":"8ee1ef768e2b","stateId":459,"easy":"إذا سلّمت على الناس بوجه طليق ← فهو من الصدقة","cause":"أن تُسلِّمَ على النَّاسِ وأنت طليقُ الوَجهِ","result":"مِن الصَّدقةِ","explicit":true,"ref":"صحيح الترغيب 2683","srcLabel":"البيهقي","text":[["مِن الصَّدقةِ",2]," ",["أن تُسلِّمَ على النَّاسِ وأنت طليقُ الوَجهِ",1]," ."],"grade":"صحيح","narrator":"الحسن البصري","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن أبي الدنيا في ((اصطناع المعروف)) (26) واللفظ له، والبيهقي في ((شعب الإيمان)) (8053)","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"lFwJOS0U"},{"id":"س-01942","fp":"b0a01f403ef4","stateId":459,"easy":"إذا قتلت حية ← فلك سبع حسنات","cause":"مَن قتلَ حيَّةً","result":"فلَه سَبعُ حسناتٍ","explicit":true,"ref":"الجامع الصغير 8890","srcLabel":"أحمد","text":[["مَن قتلَ حيَّةً ",1],["فلَه سَبعُ حسناتٍ ",2],"ومَن قتلَ وَزَغةً فلَهُ حَسَنةٌ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه أحمد (3984)، والطبراني (10/258) (10492) مطولاً، وابن حبان (5630) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"nNuldEGp"},{"id":"س-01943","fp":"845500ae17dd","stateId":459,"easy":"إذا قتلت وزغة ← فلك حسنة","cause":"ومَن قتلَ وَزَغةً","result":"فلَهُ حَسَنةٌ","explicit":true,"ref":"الجامع الصغير 8890","srcLabel":"أحمد","text":["مَن قتلَ حيَّةً فلَه سَبعُ حسناتٍ ",["ومَن قتلَ وَزَغةً ",1],["فلَهُ حَسَنةٌ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه أحمد (3984)، والطبراني (10/258) (10492) مطولاً، وابن حبان (5630) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"nNuldEGp"},{"id":"س-03313","fp":"ba4d2d120994","stateId":459,"easy":"إذا لم تستقبل القبلة ولم تستدبرها عند قضاء الحاجة ← تُكتب لك حسنة وتُمحى سيئة","cause":"من لم يستقبلِ القِبلةَ ، و لم يستدْبِرْها في الغائطِ","result":"كُتِبَ له حسنةٌ ، و مُحِيَ عنه سيئةٌ","explicit":true,"otherNeedIds":[11],"ref":"صحيح الترغيب 151","srcLabel":"الطبراني","text":[["من لم يستقبلِ القِبلةَ ، و لم يستدْبِرْها في الغائطِ ",1],["كُتِبَ له حسنةٌ ، و مُحِيَ عنه سيئةٌ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (1321)","bab":"استغفار › أسباب المغفرة","dorar":"o8nhoUEO"},{"id":"س-04253","fp":"3578ce3a2af0","stateId":459,"easy":"إذا سلّم أحدكما ورد الآخر ← اشتركتما في الأجر","cause":"فسَلَّمَ أحدُهُما على الآخَرِ، فرَدَّ عليهِ الآخَرُ السَّلامَ","result":"اشتَرَكا في الأجْرِ","explicit":true,"ref":"المستدرك على الصحيحين 7497","srcLabel":"الطبراني","text":["لا تَحِلُّ الهجْرةُ فوقَ ثَلاثةِ أيَّامٍ، فإنِ الْتَقَيَا، ",["فسَلَّمَ أحدُهُما على الآخَرِ، فرَدَّ عليهِ الآخَرُ السَّلامَ",1],"؛ ",["اشتَرَكا في الأجْرِ",2],"، وإنْ أبى الآخَرُ أنْ يَرُدَّ السَّلامَ بَرِئَ هذا مِن الإثْمِ، وَباءَ بهِ الآخَرُ، وأحسَبُه قالَ: وإنْ ماتَا وهُمَا مُتهاجِرانِ، لا يَجْتمعانِ في الجَنَّةِ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (8930) واللفظ له، وأبو الشيخ الأصبهاني ((التوبيخ والتنبيه)) (43) بنحوه","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"xPtMObCc"},{"id":"س-06774","fp":"56673942b124","stateId":459,"easy":"إذا حلفت على شيء ورأيت غيره خيراً فتركته ← فكفارته تركه ومعها حسنة","cause":"فَكَفَّارَتُهُ تَرَكُهُ","result":"ومَعَ الكَفَّارَةِ حسنةُ","explicit":true,"ref":"صحيح الموارد 997","srcLabel":"ابن حبان","text":["مَنْ حَلَفَ على مُلْكِ يَمِينِهِ أنْ يَضْرِبَهُ ؛ ",["فَكَفَّارَتُهُ تَرَكُهُ",1]," ، ",["ومَعَ الكَفَّارَةِ حسنةُ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (4344) واللفظ له، والطحاوي في ((شرح مشكل الآثار)) (664)، والمخلص في ((المخلصيات)) (283) بنحوه","bab":"عتق وولاء › الإحسان إلى العبيد","dorar":"bMIeTuHD"},{"id":"س-07797","fp":"eac0108bcfeb","stateId":459,"easy":"إذا أجبت السلام ← فلك أجر","cause":"فمَن أجاب السَّلامَ","result":"كان له","explicit":true,"ref":"مجمع الزوائد 8/39","srcLabel":"أحمد","text":["تعلَّموا القرآنَ فإذا علِمْتُموه فلا تغلُوا فيه ولا تجفُوا عنه ولا تأكُلوا به ولا تستكثِروا به ثُمَّ قال إنَّ التُّجَّارَ همُ الفُجَّارُ قالوا يا رسولَ اللهِ أليس قد أحلَّ اللهُ البيعَ وحرَّم الرِّبا قال بلى ولكنَّهم يحلِفونَ ويأثَمونَ ثُمَّ قال إنَّ الفُسَّاقَ هم أهلُ النَّارِ قالوا يا رسولَ اللهِ مَن الفُسَّاقُ قال النِّساءُ قالوا أو ليس أمَّهاتِنا وبناتِنا وأخواتِنا قال بلى ولكنَّهنَّ إذا أُعطِينَ لم يشكُرْنَ وإن ابتُلِينَ لم يصبِرْنَ ثُمَّ قال يُسلِّمُ الرِّاكبُ على الرَّاجلِ والرَّاجلُ على الجالسِ والأقلُّ على الأكثرِ ",["فمَن أجاب السَّلامَ ",1],["كان له",2]," ومَن لم يُجِبْ فلا شيءَ له"],"grade":"صحيح","narrator":"عبدالرحمن بن شبل","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (15704)، وعبد بن حميد في ((مسنده)) (314)، والبيهقي (2362)","bab":"قرآن › تعلم القرآن وتعليمه","dorar":"1qQvD5R8"},{"id":"س-00171","fp":"2554fc0b8830","stateId":459,"easy":"إذا قلت «السلام عليكم» ← تُكتب لك عشر حسنات","cause":"فقالَ : السَّلامُ عليكُم","result":"عشرٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«السلام عليكم»"},"repOf":"س-00163","ref":"الصحيح المسند 1024","text":["جاءَ رجلٌ إلى النَّبيِّ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ ",["فقالَ : السَّلامُ عليكُم",1]," ، فردَّ عليهِ السَّلامَ ، ثمَّ جلَسَ ، فقالَ النَّبيُّ صلَّى اللَّه عليهِ وعلَى آلِهِ وسلَّمَ : ",["عشرٌ",2]," ثمَّ جاءَ آخرُ فقالَ : السَّلامُ عليكُم ورحمةُ اللَّهِ ، فَردَّ عليهِ السَّلامُ فجلَسَ ، فقالَ : عِشرون ثمَّ جاءَ آخرُ فَقالَ : السَّلامُ عليكُم ورحمةُ اللَّهِ وبرَكاتُهُ ، فردَّ عليهِ السلام فجَلسَ ، فقالَ : ثَلاثونَ ."],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"حسن على شرط مسلم","takhrij":"أخرجه أبو داود (5195)، والترمذي (2689)، وأحمد (19962)، والنسائي في ((السنن الكبرى)) (10169) باختلاف يسير","bab":"آداب السلام › كيفية رد السلام","dorar":"10s5WKhc","merged":3,"otherRefs":["شعب الإيمان 6/2955 (حسن)","صحيح الترمذي 2689 (صحيح)"]},{"id":"س-00172","fp":"d08b1287847b","stateId":459,"easy":"إذا قلت «السلام عليكم ورحمة الله» ← تُكتب لك عشرون حسنة","cause":"فقالَ : السَّلامُ عليكُم ورحمةُ اللَّهِ","result":"فقالَ : عِشرون","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«السلام عليكم ورحمة الله»"},"repOf":"س-00163","ref":"الصحيح المسند 1024","text":["جاءَ رجلٌ إلى النَّبيِّ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ فقالَ : السَّلامُ عليكُم ، فردَّ عليهِ السَّلامَ ، ثمَّ جلَسَ ، فقالَ النَّبيُّ صلَّى اللَّه عليهِ وعلَى آلِهِ وسلَّمَ : عشرٌ ثمَّ جاءَ آخرُ ",["فقالَ : السَّلامُ عليكُم ورحمةُ اللَّهِ",1]," ، فَردَّ عليهِ السَّلامُ فجلَسَ ، ",["فقالَ : عِشرون",2]," ثمَّ جاءَ آخرُ فَقالَ : السَّلامُ عليكُم ورحمةُ اللَّهِ وبرَكاتُهُ ، فردَّ عليهِ السلام فجَلسَ ، فقالَ : ثَلاثونَ ."],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"حسن على شرط مسلم","takhrij":"أخرجه أبو داود (5195)، والترمذي (2689)، وأحمد (19962)، والنسائي في ((السنن الكبرى)) (10169) باختلاف يسير","bab":"آداب السلام › كيفية رد السلام","dorar":"10s5WKhc","merged":3,"otherRefs":["شعب الإيمان 6/2955 (حسن)","صحيح الترمذي 2689 (صحيح)"]},{"id":"س-00119","fp":"b1e248e717c7","stateId":459,"easy":"إذا قلت «السلام عليكم ورحمة الله» ← تُكتب لك عشرون حسنة","cause":"السَّلامُ عليكُم ورحمةُ اللهِ فقالَ: عِشرونَ حسنةً. فمرَّ رجلٌ آخرُ فقال : السَّلامُ عليكُم و رحمةُ اللهِ و بركاتُه","result":"عشرُ حَسناتٍ فمرَّ رجلٌ آخرُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«السلام عليكم ورحمة الله»"},"repOf":"س-00163","ref":"صحيح الأدب المفرد 757","text":["أنَّ رجلًا مرَّ على رسولِ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ وهوَ في مَجلِسٍ فقال السَّلامُ عليكُم فقالَ ",["عشرُ حَسناتٍ فمرَّ رجلٌ آخرُ",2]," فقالَ:",[" السَّلامُ عليكُم ورحمةُ اللهِ فقالَ: عِشرونَ حسنةً. فمرَّ رجلٌ آخرُ فقال : السَّلامُ عليكُم و رحمةُ اللهِ و بركاتُه ",1],"، فقالَ : ثلاثونَ حَسَنةً فقامَ رجلٌ من المجلِسِ و لَم يُسَلِّمْ ، فقال رسولُ اللهِ صلَّى عليهِ و سلم ما أوشَكَ ما نَسيَ صاحبُكم ! إذا جاء أحدُكُم المجلِسَ فليُسَلِّمْ ؛ فإن بَدا لهُ أن يجلسَ فليجلِسْ ، و إذا قامَ- و في روايةٍ : فإن جلَسَ ثمَّ بدا لهُ أن يقومَ قبلَ أن يتفرَّقَ المجلِسُ- فليُسَلِّمْ ، ما الأُولَى بأحقَّ مِنَ الآخرةِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (986) واللفظ له، وأخرجه أبو داود (5208)، والترمذي (2706) مختصراً باختلاف يسير","bab":"آداب السلام › إفشاء السلام","dorar":"mEay7hip"},{"id":"س-00120","fp":"a941aeebbd40","stateId":459,"easy":"إذا زدت في السلام «وبركاته» ← تفضل الناس بأجر كثير","cause":"فيقولون : السلامُ عليكم ورحمةُ اللهِ وبركاتُه","result":"فضلَنا الناسُ اليومَ بزيادةٍ كثيرةٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"صحيح الأدب المفرد 758","srcLabel":"البخاري","text":["كنت رَديفَ أبي بكرٍ ، فيمرُّ على القومِ فيقول : السلامُ عليكم ، فيقولون : السلامُ عليكم ورحمةُ اللهِ ، ويقول : السلامُ عليكم ورحمةُ اللهِ ، ",["فيقولون : السلامُ عليكم ورحمةُ اللهِ وبركاتُه",1]," ، فقال أبو بكرٍ : ",["فضلَنا الناسُ اليومَ بزيادةٍ كثيرةٍ",2]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (987) واللفظ له.","bab":"آداب السلام › إفشاء السلام","dorar":"ngNfCsWf"},{"id":"س-00146","fp":"aa644858b205","stateId":459,"easy":"إذا رددت السلام ← فهو لك","cause":"فمَن أجابَ السَّلامَ","result":"فهوَ لهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح الأدب المفرد 763","srcLabel":"البخاري","text":["ليُسَلِّمِ الرَّاكبُ على الرَّاجِلِ ، و ليُسَلِّمِ الرَّاجلُ على القاعدِ ، و ليُسَلِّمِ الأقَلُّ على الأكثرِ ، ",["فمَن أجابَ السَّلامَ",1]," ",["فهوَ لهُ",2]," ، ومَن لَم يُجِبْ فلا شيءَ لهُ"],"grade":"صحيح","narrator":"عبدالرحمن بن شبل","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد))، وأبو ذر الهروي في ((جزء فيه أحاديثه)) واللفظ لهما، وعبد بن حميد (314)، وابن عساكر (34/ 425) بلفظه مطولا.","bab":"آداب السلام › إفشاء السلام","dorar":"7oQ2nnNM"},{"id":"س-02020","fp":"4d447a30ccc8","stateId":459,"easy":"إذا قتلت الوزغ في الضربة الأولى ← فلك كذا وكذا حسنة","cause":"مَن قَتَلَ وَزَغًا في الضَّرْبةِ الأُولى","result":"فله كَذا وكَذا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"اللطائف من دقائق المعارف 773","srcLabel":"مسلم","text":[["مَن قَتَلَ وَزَغًا في الضَّرْبةِ الأُولى",1]," ",["فله كَذا وكَذا",2],"، وفي الثَّانيةِ كَذا، وفي الثَّالثةِ كَذا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2240)، وأبو داود (5263)، وابن ماجة (3229) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"T5PUgohn"},{"id":"س-02024","fp":"342319ec8b7d","stateId":459,"easy":"إذا قلت «السلام عليكم ورحمة الله وبركاته» ← تُكتب لك ثلاثون حسنة","cause":"السَّلامُ عليكم ورَحْمةُ اللهِ وبَرَكاتُه","result":"ثَلاثونَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«السلام عليكم ورحمة الله وبركاته»"},"repOf":"س-00165","ref":"الأحكام الوسطى 4/ 216","text":["كنَّا عنْدَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فجاءَ رَجُلٌ فسَلَّمَ، فقالَ: السَّلامُ عليكم، فرَدَّ عليه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، قالَ: \"عِشْرونَ\"، ثُمَّ جَلَسَ، ثُمَّ جاءَ آخَرُ، فقالَ: السَّلامُ عليكم ورَحْمةُ اللهِ، فرَدَّ عليه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، وقالَ: \"عِشْرونَ\"، ثُمَّ جَلَسَ وجاءَ آخَرُ، فقالَ: ",["السَّلامُ عليكم ورَحْمةُ اللهِ وبَرَكاتُه",1],"، فرَدَّ عليه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، وقالَ: \"",["ثَلاثونَ",2],"\"."],"grade":"صحيح","narrator":"عمران بن حصين","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10097) واللفظ له، وأبو داود (5195)، والترمذي (2689) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"yZhS2ZFa","merged":4,"otherRefs":["شعب الإيمان 6/2955 (حسن)","صحيح الترمذي 2689 (صحيح)","الصحيح المسند 1024 (صحيح)"]},{"id":"س-01605","fp":"6a0d21fffefe","stateId":459,"easy":"إذا أصبت طعاماً فكل باسم الله وبركته ← (أدب نبوي)","cause":"فضَرَبتُم بأيْدِيكم؛ فكُلُوا باسمِ اللهِ وبرَكةِ اللهِ","result":"إذا أصَبْتُم مثْلَ هذا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[1],"ref":"المستدرك على الصحيحين 7280","srcLabel":"ابن حبان","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ وأبا بَكْرٍ وعُمَرَ رَضيَ اللهُ عنهُما أتَوْا بَيتَ أبي أيُّوبَ، فلمَّا أكَلُوا وشَبِعُوا، قال النَّبِيُّ صلَّى اللهُ عليه وسلَّمَ: خُبْزٌ، ولحْمٌ، وتَمْرٌ، وبُسْرٌ، ورُطَبٌ، ",["إذا أصَبْتُم مثْلَ هذا",2]," ",["فضَرَبتُم بأيْدِيكم؛ فكُلُوا باسمِ اللهِ وبرَكةِ اللهِ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو يعلى (250)، وابن حبان (5216)، والطبراني في ((المعجم الأوسط)) مطولا","bab":"أطعمة › إجابة الدعوة","dorar":"i2Vkw7sG"},{"id":"س-00169","fp":"9ecebc6a393d","stateId":459,"easy":"إذا قلت «السلام عليكم ورحمة الله وبركاته ومغفرته» ← تُكتب لك أربعون حسنة","cause":"السَّلامُ عليكُم ورحمةُ اللَّهِ وبرَكاتُه ومغفرتُه","result":"أربعونَ هَكذا تَكونُ الفضائلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«السلام عليكم ورحمة الله وبركاته ومغفرته»"},"repOf":"س-00165","ref":"هداية الرواة 4/314","text":["ثمَّ أتى آخَرُ فقالَ ",["السَّلامُ عليكُم ورحمةُ اللَّهِ وبرَكاتُه ومغفرتُه",1]," فقالَ ",["أربعونَ هَكذا تَكونُ الفضائلُ",2]],"grade":"حسن","narrator":"معاذ بن أنس","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه أبو داود (5196)، والطبراني (20/182) (390)، والبيهقي في ((شعب الإيمان)) (8876) باختلاف يسير.","bab":"آداب السلام › كيفية رد السلام","dorar":"gemgQFOD"},{"id":"س-03418","fp":"4db9f67323d9","stateId":459,"easy":"إذا قتلت الوزغ ← يكتب الله لك حسنة ويمحو سيئة","cause":"يكتُبُ اللهُ بقتلِها","result":"الحسنَةَ ويمحو بها السيئةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[11],"ref":"مجمع الزوائد 4-50","srcLabel":"الطبراني","text":["خرجْتُ إلى زيدِ بنِ ثابِتٍ فخرجَ إلَيَّ مُبْرِزًا بيدِهِ الرُّمْحَ فقلْتُ يا أبا خارِجَةَ ما بالُ الرمحِ هذه الساعَةَ قال كنتُ أطلُبُ هذه الدابَّةَ الخَبِيثَةَ التي ",["يكتُبُ اللهُ بقتلِها",1]," ",["الحسنَةَ ويمحو بها السيئةَ",2]," وهي الوزَغُ"],"grade":"حسن","narrator":"عقبة بن فاكهة","muhaddith":"فيه عبد الرحمن بن الفاكه تفرد عنه أبو جعفر الخطمي وبقية رجاله ثقات","takhrij":"أخرجه الطبراني  (5/ 106)، (4738) بلفظه.","bab":"استغفار › أسباب المغفرة","dorar":"v3g2uVtH"},{"id":"س-03674","fp":"4a658badab0e","stateId":460,"easy":"إذا أمرت بتقوى الله وعدلت (وأنت إمام) ← فلك بذلك أجر","cause":"فإن أمَرَ بتَقوى اللهِ وعَدَلَ","result":"فإنَّ له بذلك أجرًا","explicit":true,"star":true,"ref":"صحيح البخاري 2957","srcLabel":"متفق عليه","text":["مَن أطاعَني فقد أطاعَ اللهَ، ومَن عَصاني فقد عَصى اللهَ، ومَن يُطِعِ الأميرَ فقد أطاعَني، ومَن يَعصِ الأميرَ فقد عَصاني، وإنَّما الإمامُ جُنَّةٌ يُقاتَلُ مِن ورائِه ويُتَّقى به، ",["فإن أمَرَ بتَقوى اللهِ وعَدَلَ",1]," ",["فإنَّ له بذلك أجرًا",2],"، وإن قال بغَيرِه فإنَّ عليه منه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2957)، ومسلم (1835)","bab":"اعتصام بالسنة › الأمر بالتمسك بالكتاب والسنة","dorar":"50wib7r4","merged":2,"otherRefs":["صحيح الجامع 2322 (صحيح)"]},{"id":"س-00235","fp":"46ec0cadaa78","stateId":460,"easy":"إذا عدلت بين اثنين ← فهو صدقة","cause":"تَعْدِلُ بيْنَ الاثْنَيْنِ","result":"صَدَقَةٌ","explicit":true,"star":true,"ref":"المقاصد الحسنة 378","srcLabel":"متفق عليه","text":["الكلمةُ الطيبةُ صدقةٌ [يعني حديث: كُلُّ سُلامَى مِنَ النَّاسِ عليه صَدَقَةٌ، كُلَّ يَومٍ تَطْلُعُ فيه الشَّمْسُ، قالَ: ",["تَعْدِلُ بيْنَ الاثْنَيْنِ ",1],["صَدَقَةٌ",2],"، وتُعِينُ الرَّجُلَ في دابَّتِهِ فَتَحْمِلُهُ عليها، أوْ تَرْفَعُ له عليها مَتاعَهُ صَدَقَةٌ، قالَ: والْكَلِمَةُ الطَّيِّبَةُ صَدَقَةٌ، وكُلُّ خُطْوَةٍ تَمْشِيها إلى الصَّلاةِ صَدَقَةٌ، وتُمِيطُ الأذَى عَنِ الطَّرِيقِ صَدَقَةٌ.]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2989)، ومسلم (1009) مطولاً.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"nOHaDbsE"},{"id":"س-02886","fp":"ae0b6d84e3fa","stateId":460,"easy":"إذا حكمت فاجتهدت فأصبت ← فلك أجران، وإن أخطأت فأجر","cause":"إذا حكَم الحاكمُ فاجتَهَد، فأصاب","result":"فله أجْرانِ، وإذا حكَمَ، فاجتَهَد، فأخطَأ، فله أجْرٌ","explicit":true,"star":true,"similar":["س-01702"],"ref":"تخريج مشكل الآثار 753","srcLabel":"الطحاوي","text":[["إذا حكَم الحاكمُ فاجتَهَد، فأصاب، ",1],["فله أجْرانِ، وإذا حكَمَ، فاجتَهَد، فأخطَأ، فله أجْرٌ",2],"، قال: فحدَّثْتُ بهذا الحديثِ أبا بكْرِ بنَ حَزْمٍ فقال: هكذا حدَّثني أبو سَلَمةَ بنُ عبدِ الرحمنِ، عن أبي هُرَيْرةَ."],"grade":"صحيح","narrator":"عمرو بن العاص وأبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","bab":"إيمان › الوعد","dorar":"6SzJZ03q","merged":6,"otherRefs":["صحيح مسلم 1716 (صحيح)","الروضة الندية 2/256 (صحيح)","فتاوى صديق خان 800 (صحيح)","تخريج سنن الدارقطني 4464 (صحيح)","تخريج المسند لشعيب 17816 (صحيح)"]},{"id":"س-07523","fp":"0ac9d995f6d0","stateId":460,"easy":"إذا أصبت في الحكم ← فلك عشرة أجور","cause":"إنْ أصَبْتَ","result":"فلكَ عَشْرُ أُجورٍ","explicit":true,"ref":"المستدرك على الصحيحين 7199","srcLabel":"أحمد","text":["أنَّ رجُلَيْنِ اختَصَما إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فقال لعَمْرٍو: اقْضِ بيْنهما، فقالَ: أقضِي بيْنَهما وأنتَ حاضِرٌ يا رسولَ اللهِ؟ قالَ: نعمْ، على أنَّكَ ",["إنْ أصَبْتَ",1]," ",["فلكَ عَشْرُ أُجورٍ",2],"، وإنِ اجْتهَدْتَ فأخطأْتَ فلكَ أجْرٌ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح الإسناد بهذه السياقة","takhrij":"أخرجه أحمد (6755)، والطبراني في ((الأوسط)) (8988)، والدارقطني (4457) جميعهم بلفظه مقارب.","bab":"فضائل النبي وصفته ودلائل النبوة › اختصام المؤمنين إليه صلى الله عليه وسلم وحكمه عليهم","dorar":"xCmj0mst","merged":2,"otherRefs":["فتاوى صديق خان 48 (صحيح)"]},{"id":"س-07710","fp":"e5c8e56fd05d","stateId":460,"easy":"إذا قسمت بالعدل ← ففيه تقوى الله وطاعته","cause":"فقَسَمَهُ على السَّواءِ","result":"كان فيه تقوى اللهِ وطاعتُهُ وطاعةُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، وصلاحُ ذاتِ البَيْنِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[23],"ref":"المستدرك على الصحيحين 3301","srcLabel":"مسلم","text":["عنْ أبي أُمامَةَ، عنْ عُبادةَ بنِ الصَّامتِ رَضيَ اللهُ عنه، قالَ: سألتُهُ عنِ الأنفالِ، قالَ: فينا يومَ بدْرٍ نَزَلَتْ، كان النَّاسُ على ثلاثِ منازلَ، ثُلثٌ يُقاتِلُ العَدُوَّ، وثُلثٌ يَجمعُ المتاعَ، ويأخُذُ الأُسارى، وثُلثٌ عند الخيمةِ، يحرُسُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فلمَّا جَمَعَ المتاعَ اختلَفوا فيه، فقالَ الَّذينَ جَمَعوهُ وأخَذوهُ، قد نَفَّلَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ كُلَّ امرئٍ منَّا ما أصابَ فهو لنا دُونَكُم. وقالَ الَّذين يُقاتِلونَ العدُوَّ ويطلبُونَهُ: واللهِ لولا نحن ما أصبْتُموهُ، فنحن شَغَلْنا القومَ عنكم. وقالَ الحرَسُ: واللهِ ما أنتم بأحقَّ منه منَّا، لقد رأيْتُنا أنْ نُقاتلَ العدُوَّ حين منَحَنا اللهُ أكتافَهُم أنْ نأخُذَ المتاعَ حين لمْ يكنْ أَحَدٌ يُمنعُ دونهُ ولكنَّا خِفْنا غِرَّةَ العدُوِّ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقُمْنا دونهُ. قالَ: فانْتَزَعَها اللهُ مِن أيْدينا، فجَعَلَه إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، ",["فقَسَمَهُ على السَّواءِ",1],"، لمْ يكنْ فيه يومئذٍ خُمُسٌ، ",["كان فيه تقوى اللهِ وطاعتُهُ وطاعةُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، وصلاحُ ذاتِ البَيْنِ",2],"."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه البيهقي (12840) بلفظه، وأحمد (22747) مختصرا","bab":"قرآن › أسباب النزول","dorar":"3cLwsIHn"},{"id":"س-01702","fp":"81fdc14bfd88","stateId":460,"easy":"إذا اجتهدت فأصبت ← فلك أجران","cause":"المُصيبُ في اجتِهادِه","result":"له أجرانِ","explicit":true,"repOf":"س-02886","ref":"يقظة أولي الاعتبار 209","text":["[",["المُصيبُ في اجتِهادِه",1]," ",["له أجرانِ",2],"، والمُخطِئُ له أجرٌ]"],"grade":"صحيح","muhaddith":"[صحيح]","bab":"أقضية وأحكام › الحكم بالكتاب والسنة ثم باجتهاد الحاكم، والخطأ معذور","dorar":"Xwp3GDLl"},{"id":"س-01703","fp":"aa6e138c1eda","stateId":460,"easy":"إذا اجتهدت فأخطأت ← فلك أجر","cause":"والمُخطِئُ","result":"له أجرٌ","explicit":true,"ref":"يقظة أولي الاعتبار 209","srcLabel":"يقظة أولي الاعتبار","text":["[المُصيبُ في اجتِهادِه له أجرانِ، ",["والمُخطِئُ",1]," ",["له أجرٌ",2],"]"],"grade":"صحيح","muhaddith":"[صحيح]","bab":"أقضية وأحكام › الحكم بالكتاب والسنة ثم باجتهاد الحاكم، والخطأ معذور","dorar":"Xwp3GDLl"},{"id":"س-07264","fp":"306cbddec42d","stateId":460,"easy":"إذا أخذت الإمارة بحقها ← فنعم الشيء هي","cause":"لمن أخذها بحقِّها","result":"نعمَ الشيءِ الإمارةُ","explicit":true,"ref":"مجمع الزوائد 5/203","srcLabel":"ابن حبان","text":["أنه قال عند النبيِّ صلَّى اللهُ عليه وسلَّمَ بئس الشيءُ الإمارةُ فقال النبيُّ صلَّى اللهُ عليه وسلَّمَ ",["نعمَ الشيءِ الإمارةُ",2]," ",["لمن أخذها بحقِّها",1]," وبئس الشيءُ الإمارةُ لمن أخذها بغيرِ حقِّها تكون عليه حسرةً يومَ القيامةِ"],"grade":"صحيح","narrator":"زيد بن ثابت","muhaddith":"[فيه] حفص بن عمر بن الصباح الرقي وثقه ابن حبان ، وبقية رجاله رجال الصحيح","takhrij":"أخرجه الطبراني (4831) (5/ 127) واللفظ له.","bab":"فتن › أمراء الجور","dorar":"ceMOHYQV"},{"id":"س-07848","fp":"a1a3feeb9e82","stateId":460,"easy":"إذا أطعت أمراءك فيما أمروا به من الحق ← يؤجرون وتؤجر","cause":"أَطِيعوا أمراءَكم مهما كان فإن أمروكم بشيءٍ مِمَّا جئتُكم به","result":"فإنهم يُؤْجَرُونَ عليه وتُؤْجَرُونَ عليه","explicit":true,"ref":"تخريج كتاب السنة 1048","srcLabel":"الطبراني","text":[["أَطِيعوا أمراءَكم مهما كان فإن أمروكم بشيءٍ مِمَّا جئتُكم به",1]," ",["فإنهم يُؤْجَرُونَ عليه وتُؤْجَرُونَ عليه",2]," ذلك بأنكم إذا لَقِيتُم ربَّكم قلتم : ربَّنا لا ظُلْمَ فيقولُ : لا ظُلْمَ فيقولونَ : ربَّنا أَرْسَلْتَ إلينا رُسُلًا فأَطَعْناهم واستُخْلِفَتْ علينا خُلَفاءُ فأَطَعْناهم وأُمِّرَتْ علينا أمراءَ فأَطَعْناهم فيقولُ : صَدَقْتُم هو عليهِم وأنتم منه بَراءٌ"],"grade":"صحيح","narrator":"المقدام بن معدي كرب","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (1048) واللفظ له، والطبراني (20/278) (658)، والبيهقي (17069) باختلاف يسير.","bab":"قيامة › الحساب والقصاص","dorar":"BR8RctwP"},{"id":"س-00319","fp":"a7c9e47ac5e5","stateId":460,"easy":"إذا كنت سلطاناً عادلاً ← يومك أفضل من عبادة سبعين سنة","cause":"ليومٌ من سلطانٍ عادلٍ","result":"أفضلُ من عبادةِ سبعين سنةً","explicit":true,"similar":["س-04587"],"ref":"تخريج الإحياء للعراقي 1/235","srcLabel":"الطبراني","text":[["ليومٌ من سلطانٍ عادلٍ ",1],["أفضلُ من عبادةِ سبعين سنةً ",2],"."],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن بلفظ ستين","takhrij":"أخرجه الطبراني (11/ 337)، (11932)، وأبو نعيم الأصبهاني في ((فضيلة العادلين)) (16)، والبيهقي (16727) جميعهم بنحوه.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"aw0KTZdA"},{"id":"س-01666","fp":"c6c618f6e6f4","stateId":460,"easy":"إذا اجتهدت في القضاء فأصبت ← فلك عشرة أجور، وإن أخطأت فأجر أو أجران","cause":"إذا قَضَى القاضي فاجتَهَدَ فأصابَ","result":"فلَهُ عشرةُ أجورٍ ، وإذا اجتَهَدَ فأخطأَ كانَ لَهُ أجرٌ أو أجرانِ","explicit":true,"ref":"تخريج المسند لشاكر 11/34","srcLabel":"أحمد","text":[["إذا قَضَى القاضي فاجتَهَدَ فأصابَ ",1],["فلَهُ عشرةُ أجورٍ ، وإذا اجتَهَدَ فأخطأَ كانَ لَهُ أجرٌ أو أجرانِ",2]],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (6755) واللفظ له، والطبراني في ((المعجم الأوسط)) (8988)","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"fGMa55TU"},{"id":"س-04587","fp":"dc603873815f","stateId":460,"easy":"إذا كنت إماماً عادلاً ← يومك أفضل من عبادة ستين سنة","cause":"يَوْمٌ من إمامٍ عَادِلٍ","result":"أفضلُ من عِبادَةِ سِتِّينَ سَنَةً","explicit":true,"repOf":"س-00319","ref":"الفتح الرباني 11/5421","text":[["يَوْمٌ من إمامٍ عَادِلٍ ",1],["أفضلُ من عِبادَةِ سِتِّينَ سَنَةً ",2],"، وحَدٌّ يُقَامُ في الأرضِ بحقِّهِ أَزْكَى فيها من مَطَرِ أربعينَ صباحًا"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني (11/337) (11932)، والبيهقي (17092)، وابن عساكر في ((معجم الشيوخ)) (1192)","bab":"حدود › الحث على إقامة الحدود","dorar":"qQxzyl6G"},{"id":"س-01825","fp":"101097de9c3b","stateId":461,"easy":"إذا عملت بيدك ونصحت ← فهو خير الكسب","cause":"كسبُ يدِ العاملِ إذا نصحَ","result":"خيرُ الكسبِ","explicit":true,"star":true,"ref":"تخريج المسند لشاكر 16/175","srcLabel":"أحمد","text":[["خيرُ الكسبِ",2],[" كسبُ يدِ العاملِ إذا نصحَ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (8393) واللفظ له، وأبو نعيم في ((تاريخ أصبهان)) (1/419)، والبيهقي في ((شعب الإيمان)) (1236)","bab":"إجارة › كسب الرجل وعمله بيده","dorar":"SzA7IBzP","merged":2,"otherRefs":["تخريج المسند لشعيب 8691 (حسن)"]},{"id":"س-06214","fp":"334876ce72d7","stateId":461,"easy":"إذا قبلت العطية وأنت محتاج ← فلست بأقل أجراً من المعطي","cause":"الذي يَقْبَلُ إذا كانَ مُحتاجًا","result":"بأعظمَ أجرًا","explicit":true,"ref":"الجامع الصغير 7745","srcLabel":"الطبراني","text":["ما الذي يعطي منْ سَعَةٍ،  ",["بأعظمَ أجرًا",2]," منَ ",["الذي يَقْبَلُ إذا كانَ مُحتاجًا",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (8235)، وأبو نعيم الأصبهاني في ((حلية الأولياء)) (8/245) بلفظه","bab":"سؤال › من تحل له المسألة","dorar":"xKiDH4k4"},{"id":"س-04032","fp":"fb35a14184d4","stateId":462,"easy":"إذا أحسنت إسلامك ← تُكتب كل حسنة تعملها بعشر أمثالها إلى سبعمئة ضعف","cause":"إذا أحسَنَ أحَدُكُم إسلامَه","result":"فكُلُّ حَسَنةٍ يَعمَلُها تُكتَبُ بعَشرِ أمثالِها إلى سَبعِ مِئةِ ضِعفٍ، وكُلُّ سَيِّئةٍ يَعمَلُها تُكتَبُ بمِثلِها حتَّى يَلقى اللهَ","explicit":true,"star":true,"similar":["س-04035"],"ref":"صحيح مسلم 129","srcLabel":"متفق عليه","text":["قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: قال اللهُ عزَّ وجلَّ: إذا تَحَدَّثَ عَبدي بأن يَعمَلَ حَسَنةً فأنا أكتُبُها له حَسَنةً ما لَم يَعمَلْ، فإذا عَمِلَها فأنا أكتُبُها بعَشرِ أمثالِها، وإذا تَحَدَّثَ بأن يَعمَلَ سَيِّئةً فأنا أغفِرُها له ما لَم يَعمَلْها، فإذا عَمِلَها فأنا أكتُبُها له بمِثلِها. وقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: قالتِ الملائِكةُ: رَبِّ، ذاك عَبدُك يُريدُ أن يَعمَلَ سَيِّئةً، وهو أبصَرُ به، فقال: ارقُبوه فإن عَمِلَها فاكتُبوها له بمِثلِها، وإن تَرَكَها فاكتُبوها له حَسَنةً، إنَّما تَرَكَها مِن جَرَّايَ. وقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["إذا أحسَنَ أحَدُكُم إسلامَه",1],"، ",["فكُلُّ حَسَنةٍ يَعمَلُها تُكتَبُ بعَشرِ أمثالِها إلى سَبعِ مِئةِ ضِعفٍ، وكُلُّ سَيِّئةٍ يَعمَلُها تُكتَبُ بمِثلِها حتَّى يَلقى اللهَ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (42)، ومسلم (129).","bab":"توبة › سعة رحمة الله تعالى وأنها سبقت غضبه","dorar":"2jngWHp5"},{"id":"س-04033","fp":"4e24b0b7e3cf","stateId":462,"easy":"إذا أسلمت فحسن إسلامك ← يكتب الله لك كل حسنة قدمتها ويمحو كل سيئة","cause":"إذا أسلمَ العبدُ ، فَحَسُنَ إِسْلامُهُ","result":"كتب اللهُ لهُ كلَّ حسنةٍ كان أَزْلَفَها ، و مُحِيَتْ عنهُ كلُّ سَيِّئَةٍ كان أَزْلَفَها ، ثُمَّ كان بعدَ ذلكَ القِصاصُ ، الحسنةُ بِعشرَةِ أَمْثَالِها إلى سبعِ مِائَةِ ضِعْفٍ ، و السَّيِّئَةُ","explicit":true,"star":true,"otherNeedIds":[11],"ref":"السلسلة الصحيحة 247","srcLabel":"البخاري","text":[["إذا أسلمَ العبدُ ، فَحَسُنَ إِسْلامُهُ ، ",1],["كتب اللهُ لهُ كلَّ حسنةٍ كان أَزْلَفَها ، و مُحِيَتْ عنهُ كلُّ سَيِّئَةٍ كان أَزْلَفَها ، ثُمَّ كان بعدَ ذلكَ القِصاصُ ، الحسنةُ بِعشرَةِ أَمْثَالِها إلى سبعِ مِائَةِ ضِعْفٍ ، و السَّيِّئَةُ",2]," بِمِثْلِها إِلَّا أنْ يَتجاوزَ اللهُ عزَّ وجلَّ عَنْها"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري معلقاً بصيغة الجزم (41)، وأخرجه موصولاً النسائي (4998) واللفظ له","bab":"توبة › سعة رحمة الله تعالى وأنها سبقت غضبه","dorar":"4WWyXQJO"},{"id":"س-04035","fp":"6764b468c7bb","stateId":462,"easy":"إذا أحسنت إسلامك ← تُكتب حسنتك عشراً إلى سبعمئة ضعف والسيئة بمثلها","cause":"إذا أحسنَ أحدُكمْ إِسلامَه فكُلُّ حسنةٍ يَعمَلُها","result":"يُكتَبُ لهُ عشَرَةُ أمْثالِها ، إلى سَبعِمائةِ ضِعفٍ ، وكُلُّ سيِّئةٍ يَعملُها يُكتَبُ لهُ مِثلُها حتى يلْقَى اللهَ","explicit":true,"repOf":"س-04032","ref":"صحيح الجامع 287","text":[["إذا أحسنَ أحدُكمْ إِسلامَه فكُلُّ حسنةٍ يَعمَلُها ",1],["يُكتَبُ لهُ عشَرَةُ أمْثالِها ، إلى سَبعِمائةِ ضِعفٍ ، وكُلُّ سيِّئةٍ يَعملُها يُكتَبُ لهُ مِثلُها حتى يلْقَى اللهَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (42)، ومسلم (129)","bab":"توبة › سعة رحمة الله تعالى وأنها سبقت غضبه","dorar":"fMWG7wx7"},{"id":"س-02353","fp":"0d4ecf4bebe3","stateId":462,"easy":"إذا هممت بحسنة ← تُكتب لك حسنة","cause":"إذا هَمَّ عبدي بحَسنةٍ","result":"فاكتُبوها له حسنةً","explicit":true,"star":true,"ref":"صحيح الترمذي 3073","srcLabel":"متفق عليه","text":["قال اللهُ عزَّ وجلَّ -وقولُهُ الحقُّ-: ",["إذا هَمَّ عبدي بحَسنةٍ",1]," ",["فاكتُبوها له حسنةً",2],"، فإنْ عمِلَها فاكتُبوها له بعَشْرِ أمثالِها، وإذا هَمَّ بسيِّئةٍ فلا تكتُبوها، فإنْ عمِلَها فاكتُبوها بمِثْلِها، فإنْ ترَكَها -وربَّما قال: فإنْ لم يعمَلْ بها- فاكتُبوها له حسنةً، ثمَّ قرَأَ: {مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ عَشْرُ أَمْثَالِهَا} [الأنعام: 160]."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (7501)، ومسلم (128)، والترمذي (3073) واللفظ له، والنسائي في ((السنن الكبرى)) (11181)، وأحمد (7296)","bab":"إحسان › الحسنات والسيئات","dorar":"glleG7F9","merged":5,"otherRefs":["صحيح ابن حبان 381 (صحيح)","تخريج مشكل الآثار 1641 (صحيح)","تخريج صحيح ابن حبان 380 (صحيح)","معجم الشيوخ 2/690 (صحيح)"]},{"id":"س-02630","fp":"baecdf16a664","stateId":462,"easy":"إذا عملت الحسنة ← يكتبها الله عشراً إلى سبعمائة إلى أضعاف كثيرة","cause":"وإنْ عَمِلَها","result":"كتَبَها اللهُ عَشْرًا، إلى سَبعِمِئةٍ، إلى أَضعافٍ كَثيرَةٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشعيب 2827","srcLabel":"متفق عليه","text":["عن ابنِ عبَّاسٍ، يَرويه عن النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، يَرويه عن رَبِّه عزَّ وجلَّ، قال: إنَّ اللهَ كتَبَ الحَسَناتِ والسَّيِّئاتِ، فمَن هَمَّ بِحَسَنةٍ فلم يَعمَلْها؛ كتَبَ اللهُ عِندَه حَسَنةً كامِلةً، ",["وإنْ عَمِلَها",1],"، ",["كتَبَها اللهُ عَشْرًا، إلى سَبعِمِئةٍ، إلى أَضعافٍ كَثيرَةٍ",2],"، أو: إلى ما شاء اللهُ أنْ يُضاعِفَ، ومَن هَمَّ بِسَيِّئةٍ فلم يَعمَلْها، كتَبَها اللهُ له عِندَه حَسَنةً كامِلةً، فإنْ عَمِلَها؛ كتَبَها اللهُ سَيِّئةً واحِدةً."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6491)، ومسلم (131)، والنسائي في ((السنن الكبرى)) (7670)، وأحمد (2827) واللفظ له","bab":"إيمان › الاحتساب والنية","dorar":"C8FCYQQv"},{"id":"س-02152","fp":"ac74c1ecd7c7","stateId":462,"easy":"إذا هممت بسيئة فلم تعملها ← يكتبها الله حسنة كاملة","cause":"وإن هَمَّ بسَيِّئةٍ فلَم يَعمَلْها","result":"كَتَبَها اللهُ عِندَه حَسَنةً كامِلةً","explicit":true,"star":true,"similar":["س-02150","س-01364"],"otherNeedIds":[11],"ref":"صحيح مسلم 131","srcLabel":"البخاري","text":["عَن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم فيما يَروي عن رَبِّه تَبارَك وتَعالى، قال: إنَّ اللهَ كَتَبَ الحَسَناتِ والسَّيِّئاتِ، ثُمَّ بَيَّنَ ذلك، فمَن هَمَّ بحَسَنةٍ فلَم يَعمَلْها كَتَبَها اللهُ عِندَه حَسَنةً كامِلةً، وإن هَمَّ بها فعَمِلَها كَتَبَها اللهُ عزَّ وجلَّ عِندَه عَشرَ حَسَناتٍ إلى سَبعِ مِئةِ ضِعفٍ إلى أضعافٍ كَثيرةٍ، ",["وإن هَمَّ بسَيِّئةٍ فلَم يَعمَلْها",1]," ",["كَتَبَها اللهُ عِندَه حَسَنةً كامِلةً",2],"، وإن هَمَّ بها فعَمِلَها كَتَبَها اللهُ سَيِّئةً واحِدةً. وفي روايةٍ: وزادَ: ومَحاها اللهُ، ولا يَهلِكُ على اللهِ إلَّا هالِكٌ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6491) باختلاف يسير دون الرواية المذكورة","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"t0Rdnrkn","merged":3,"otherRefs":["شرح البخاري لابن عثيمين 7/561 (صحيح)","تخريج المسند لشعيب 2827 (صحيح)"]},{"id":"س-02132","fp":"b5e41e004d04","stateId":462,"easy":"إذا هممت بسيئة فتركتها ← تُكتب لك حسنة","cause":"وإنْ هو تَرَكَها","result":"فاكتُبوها حَسَنةً","explicit":true,"star":true,"similar":["س-05070"],"ref":"تخريج مشكل الآثار 1641","srcLabel":"متفق عليه","text":["قال اللهُ عزَّ وجلَّ: إذا همَّ عَبدي بحَسَنةٍ فلم يَعمَلْها فاكتُبوها حَسَنةً، فإنْ عَمِلَها فاكتُبوها عَشْرًا، وإذا همَّ عَبدي بسيِّئةٍ فلم يَعمَلْها فلا تَكتُبوها، فإنْ عَمِلَها فاكتُبوها بمِثلِها، ",["وإنْ هو تَرَكَها",1]," ",["فاكتُبوها حَسَنةً",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (7501)، ومسلم (128) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"UvZwoCsT","merged":2,"otherRefs":["معجم الشيوخ 2/690 (صحيح)"]},{"id":"س-02150","fp":"75559a94a5a6","stateId":462,"easy":"إذا هممت بحسنة فلم تعملها ← يكتبها الله حسنة كاملة","cause":"فمَن هَمَّ بحَسَنةٍ فلَم يَعمَلْها","result":"كَتَبَها اللهُ عِندَه حَسَنةً كامِلةً","explicit":true,"repOf":"س-02152","ref":"صحيح مسلم 131","text":["عَن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم فيما يَروي عن رَبِّه تَبارَك وتَعالى، قال: إنَّ اللهَ كَتَبَ الحَسَناتِ والسَّيِّئاتِ، ثُمَّ بَيَّنَ ذلك، ",["فمَن هَمَّ بحَسَنةٍ فلَم يَعمَلْها",1]," ",["كَتَبَها اللهُ عِندَه حَسَنةً كامِلةً",2],"، وإن هَمَّ بها فعَمِلَها كَتَبَها اللهُ عزَّ وجلَّ عِندَه عَشرَ حَسَناتٍ إلى سَبعِ مِئةِ ضِعفٍ إلى أضعافٍ كَثيرةٍ، وإن هَمَّ بسَيِّئةٍ فلَم يَعمَلْها كَتَبَها اللهُ عِندَه حَسَنةً كامِلةً، وإن هَمَّ بها فعَمِلَها كَتَبَها اللهُ سَيِّئةً واحِدةً. وفي روايةٍ: وزادَ: ومَحاها اللهُ، ولا يَهلِكُ على اللهِ إلَّا هالِكٌ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6491) باختلاف يسير دون الرواية المذكورة","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"t0Rdnrkn","merged":2,"otherRefs":["تخريج المسند لشعيب 2827 (صحيح)"]},{"id":"س-02151","fp":"917c4183df4d","stateId":462,"easy":"إذا هممت بها فعملتها ← يكتبها الله عشر حسنات إلى سبعمئة ضعف","cause":"وإن هَمَّ بها فعَمِلَها","result":"كَتَبَها اللهُ عزَّ وجلَّ عِندَه عَشرَ حَسَناتٍ إلى سَبعِ مِئةِ ضِعفٍ إلى أضعافٍ كَثيرةٍ","explicit":true,"star":true,"similar":["س-00299","س-01914","س-04720","س-05761","س-01095","س-06879","س-07616"],"ref":"صحيح مسلم 131","srcLabel":"البخاري","text":["عَن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم فيما يَروي عن رَبِّه تَبارَك وتَعالى، قال: إنَّ اللهَ كَتَبَ الحَسَناتِ والسَّيِّئاتِ، ثُمَّ بَيَّنَ ذلك، فمَن هَمَّ بحَسَنةٍ فلَم يَعمَلْها كَتَبَها اللهُ عِندَه حَسَنةً كامِلةً، ",["وإن هَمَّ بها فعَمِلَها",1]," ",["كَتَبَها اللهُ عزَّ وجلَّ عِندَه عَشرَ حَسَناتٍ إلى سَبعِ مِئةِ ضِعفٍ إلى أضعافٍ كَثيرةٍ",2],"، وإن هَمَّ بسَيِّئةٍ فلَم يَعمَلْها كَتَبَها اللهُ عِندَه حَسَنةً كامِلةً، وإن هَمَّ بها فعَمِلَها كَتَبَها اللهُ سَيِّئةً واحِدةً. وفي روايةٍ: وزادَ: ومَحاها اللهُ، ولا يَهلِكُ على اللهِ إلَّا هالِكٌ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6491) باختلاف يسير دون الرواية المذكورة","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"t0Rdnrkn","merged":2,"otherRefs":["تخريج مشكل الآثار 1641 (صحيح)"]},{"id":"س-00299","fp":"8adb2e86c17e","stateId":462,"easy":"إذا عملت حسنة ← تُجزى بعشر حسنات إلى سبعمئة ضعف","cause":"كلُّ حسنةٍ عمِلها ابنُ آدَمَ","result":"جزَيْتُه بها عشْرَ حسناتٍ إلى سبعِمئةِ ضِعفٍ","explicit":true,"repOf":"س-02151","ref":"تخريج صحيح ابن حبان 3416","text":["قال اللهُ تبارَك وتعالى: ",["كلُّ حسنةٍ عمِلها ابنُ آدَمَ",1]," ",["جزَيْتُه بها عشْرَ حسناتٍ إلى سبعِمئةِ ضِعفٍ",2]," إلَّا الصيامَ فهو لي وأنا أجزي به، الصِّيامُ جُنَّةٌ فمَن كان صائمًا فلا يرفُثْ ولا يجهَلْ فإنِ امرؤٌ شتَمه أو آذاه فليقُلْ: إنِّي صائمٌ إنِّي صائمٌ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (1894)، ومسلم (1151) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"17weRxjI"},{"id":"س-01364","fp":"ad4f8bb72124","stateId":462,"easy":"إذا هممت بسيئة فلم تعملها ← تُكتب لك حسنة","cause":"إذا همَّ عبدي بسيِّئةٍ فلم يعمَلْها","result":"فاكتُبوها له حسنةً","explicit":true,"repOf":"س-02152","ref":"صحيح ابن حبان 381","text":[["إذا همَّ عبدي بسيِّئةٍ فلم يعمَلْها",1]," ",["فاكتُبوها له حسنةً",2]," فإنْ عمِلها فاكتُبوها له سيِّئةً فإنْ تاب منها فامحوها عنه وإذا همَّ عبدي بحسنةٍ فلم يعمَلْها فاكتُبوها له حسنةً فإنْ عمِلها فاكتُبوها له بعشَرةِ أمثالِها إلى سبعِمئةِ ضِعْفٍ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (7501)، ومسلم (128) بمعناه","bab":"نية › النية في العبادات","dorar":"X0fEzP4v"},{"id":"س-01913","fp":"2ae1cba63053","stateId":462,"easy":"إذا هممت بحسنة ولم تعملها ← تُكتب لك حسنة","cause":"إذا هَمَّ عَبدي بحَسَنةٍ ولم يَعمَلْها","result":"كَتَبتُها له حَسَنةً","explicit":true,"similar":["س-02341","س-04029","س-05760","س-01094","س-07615","س-06263","س-06367"],"ref":"صحيح مسلم 128","srcLabel":"متفق عليه","text":["عَن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم قال: قال اللهُ عَزَّ وجَلَّ: ",["إذا هَمَّ عَبدي بحَسَنةٍ ولم يَعمَلْها",1]," ",["كَتَبتُها له حَسَنةً",2],"، فإن عَمِلَها كَتَبتُها عَشرَ حَسَناتٍ إلى سَبعِ مِئةِ ضِعفٍ، وإذا هَمَّ بسَيِّئةٍ ولم يَعمَلْها، لم أكتُبْها عليه، فإن عَمِلَها كَتَبتُها سَيِّئةً واحِدةً."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7501)، ومسلم (128).","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"353iVh24"},{"id":"س-01914","fp":"43e1a526ee6d","stateId":462,"easy":"إذا عملتها ← تُكتب لك عشر حسنات إلى سبعمئة ضعف","cause":"فإن عَمِلَها","result":"كَتَبتُها عَشرَ حَسَناتٍ إلى سَبعِ مِئةِ ضِعفٍ","explicit":true,"repOf":"س-02151","ref":"صحيح مسلم 128","text":["عَن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم قال: قال اللهُ عَزَّ وجَلَّ: إذا هَمَّ عَبدي بحَسَنةٍ ولم يَعمَلْها كَتَبتُها له حَسَنةً، ",["فإن عَمِلَها",1]," ",["كَتَبتُها عَشرَ حَسَناتٍ إلى سَبعِ مِئةِ ضِعفٍ",2],"، وإذا هَمَّ بسَيِّئةٍ ولم يَعمَلْها، لم أكتُبْها عليه، فإن عَمِلَها كَتَبتُها سَيِّئةً واحِدةً."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7501)، ومسلم (128).","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"353iVh24"},{"id":"س-02341","fp":"ee6d7263eb28","stateId":462,"easy":"إذا هممت بحسنة فلم تعملها ← تُكتب لك حسنة، فإن عملتها فعشر إلى سبعمئة ضعف","cause":"إذا هَمَّ عبدِي بِحسَنَةٍ و لمْ يَعملْها كتَبتُها لهُ حسنةً","result":"فإنْ عمِلَها كتبتُها لهُ عشرَ حسناتٍ ، إلى سَبعِمائةِ ضِعفٍ ، و إذا هَمَّ بِسيِّئةٍ و لمْ يعملْها لمْ أكْتُبْها عليه ، فإنْ عمِلَها كتبتُها سيِّئةً و احِدةً","explicit":true,"repOf":"س-01913","ref":"صحيح الجامع 4306","text":["قال اللهُ تعالَى : ",["إذا هَمَّ عبدِي بِحسَنَةٍ و لمْ يَعملْها كتَبتُها لهُ حسنةً ، ",1],["فإنْ عمِلَها كتبتُها لهُ عشرَ حسناتٍ ، إلى سَبعِمائةِ ضِعفٍ ، و إذا هَمَّ بِسيِّئةٍ و لمْ يعملْها لمْ أكْتُبْها عليه ، فإنْ عمِلَها كتبتُها سيِّئةً و احِدةً",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (7501)، ومسلم (128) واللفظ له","bab":"إحسان › الحسنات والسيئات","dorar":"qCzav3rW"},{"id":"س-02343","fp":"cafeba91a73c","stateId":462,"easy":"إذا هممت بحسنة فعملتها ← تُكتب عشراً","cause":"إنْ هَمَّ بِحَسَنةٍ فعَمِلَها","result":"كُتِبَتْ عَشرًا","explicit":true,"similar":["س-04232"],"ref":"تخريج المسند لشعيب 2001","srcLabel":"متفق عليه","text":[["إنْ هَمَّ بِحَسَنةٍ فعَمِلَها",1],"، ",["كُتِبَتْ عَشرًا",2],"، وإنْ لم يَعمَلْها، كُتِبَتْ حَسَنةً، وإنْ هَمَّ بِسَيِّئةِ فعَمِلَها، كُتِبَتْ سَيِّئةً، وإنْ لم يَعمَلْها، كُتِبَتْ حَسَنةً."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6491)، ومسلم (131)، والنسائي في ((السنن الكبرى)) (7670)، وأحمد (2001) واللفظ له","bab":"إحسان › الحسنات والسيئات","dorar":"7CiN2Tyb"},{"id":"س-03157","fp":"067525f54fb9","stateId":462,"easy":"إذا جئت بالحسنة ← فلك عشر أمثالها وأزيد","cause":"مَن جاءَ بالحَسَنةِ","result":"فله عَشرُ أمثالِها وأزيدُ","explicit":true,"similar":["س-04037","ق-0389","س-06264","س-06368","س-04030"],"ref":"صحيح مسلم 2687","srcLabel":"متفق عليه","text":["يقولُ اللهُ عَزَّ وجَلَّ: ",["مَن جاءَ بالحَسَنةِ",1]," ",["فله عَشرُ أمثالِها وأزيدُ",2],"، ومَن جاءَ بالسَّيِّئةِ فجَزاؤُه سَيِّئةٌ مِثلُها أو أغفِرُ، ومَن تَقَرَّبَ مِنِّي شِبرًا تَقَرَّبتُ منه ذِراعًا، ومَن تَقَرَّبَ مِنِّي ذِراعًا تَقَرَّبتُ منه باعًا، ومَن أتاني يَمشي أتَيتُه هَرولةً، ومَن لَقيَني بقُرابِ الأرضِ خَطيئةً لا يُشرِكُ بي شيئًا لَقيتُه بمِثلِها مَغفِرةً. وفي روايةٍ: فله عَشرُ أمثالِها، أو أزيدُ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"إيمان › توحيد الأسماء والصفات","dorar":"D1po7pkJ"},{"id":"س-04029","fp":"38259467e515","stateId":462,"easy":"إذا حدّثت نفسك بحسنة ← يكتبها الله لك حسنة ما لم تعملها","cause":"إذا تَحَدَّثَ عَبدي بأن يَعمَلَ حَسَنةً","result":"فأنا أكتُبُها له حَسَنةً ما لَم يَعمَلْ","explicit":true,"repOf":"س-01913","ref":"صحيح مسلم 129","text":["قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: قال اللهُ عزَّ وجلَّ: ",["إذا تَحَدَّثَ عَبدي بأن يَعمَلَ حَسَنةً",1]," ",["فأنا أكتُبُها له حَسَنةً ما لَم يَعمَلْ",2],"، فإذا عَمِلَها فأنا أكتُبُها بعَشرِ أمثالِها، وإذا تَحَدَّثَ بأن يَعمَلَ سَيِّئةً فأنا أغفِرُها له ما لَم يَعمَلْها، فإذا عَمِلَها فأنا أكتُبُها له بمِثلِها. وقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: قالتِ الملائِكةُ: رَبِّ، ذاك عَبدُك يُريدُ أن يَعمَلَ سَيِّئةً، وهو أبصَرُ به، فقال: ارقُبوه فإن عَمِلَها فاكتُبوها له بمِثلِها، وإن تَرَكَها فاكتُبوها له حَسَنةً، إنَّما تَرَكَها مِن جَرَّايَ. وقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: إذا أحسَنَ أحَدُكُم إسلامَه، فكُلُّ حَسَنةٍ يَعمَلُها تُكتَبُ بعَشرِ أمثالِها إلى سَبعِ مِئةِ ضِعفٍ، وكُلُّ سَيِّئةٍ يَعمَلُها تُكتَبُ بمِثلِها حتَّى يَلقى اللهَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (42)، ومسلم (129).","bab":"توبة › سعة رحمة الله تعالى وأنها سبقت غضبه","dorar":"2jngWHp5"},{"id":"س-04720","fp":"8f70a9778e8e","stateId":462,"easy":"إذا عملت حسنة ← تُكتب لك عشر حسنات إلى سبعمئة ضعف","cause":"ما مِن حسَنةٍ عملَها ابنُ آدمَ","result":"إلَّا كتبَ لَهُ عشرُ حسَناتٍ إلى سَبعِ مائةِ ضعفٍ ، قالَ اللَّهُ عزَّ وجلَّ : إلَّا الصِّيامَ فإنَّهُ لي ، وأَنا أجزي بِهِ يدَعُ شَهْوتَهُ وطعامَهُ مِن أَجلي ، الصِّيامُ","explicit":true,"repOf":"س-02151","ref":"صحيح النسائي 2214","text":[["ما مِن حسَنةٍ عملَها ابنُ آدمَ",1]," ",["إلَّا كتبَ لَهُ عشرُ حسَناتٍ إلى سَبعِ مائةِ ضعفٍ ، قالَ اللَّهُ عزَّ وجلَّ : إلَّا الصِّيامَ فإنَّهُ لي ، وأَنا أجزي بِهِ يدَعُ شَهْوتَهُ وطعامَهُ مِن أَجلي ، الصِّيامُ",2]," جنَّةٌ . للصَّائمِ فرحَتانِ : فرحةٌ عندَ فطرِهِ ، وفَرحةٌ عندَ لقاءِ ربِّهِ . ولَخُلوفُ فَمِ الصَّائمِ أطيَبُ عندَ اللَّهِ مِن ريحِ المِسكِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1894)، ومسلم (1151)، والترمذي (764)، والنسائي (2215) واللفظ له، وابن ماجه (1638)، وأحمد (7195)","bab":"رقائق وزهد › الإخلاص","dorar":"CvWOa9i5"},{"id":"س-05070","fp":"811b12aad02a","stateId":462,"easy":"إذا هممت بسيئة فتركتها ← تُكتب لك حسنة","cause":"وإذا همَّ عبدي بسيِّئةٍ فلا تكتُبوها بمثلِها فإنْ ترَكها","result":"فاكتُبوها حسنةً","explicit":true,"repOf":"س-02132","otherNeedIds":[11],"ref":"تخريج صحيح ابن حبان 380","text":["قال اللهُ تبارَك وتعالى: إذا همَّ عبدي بحسنةٍ فاكتُبوها حسنةً فإذا عمِلها فاكتُبوها بعَشْرِ أمثالِها ",["وإذا همَّ عبدي بسيِّئةٍ فلا تكتُبوها بمثلِها فإنْ ترَكها",1]," ",["فاكتُبوها حسنةً",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (7501)، ومسلم (128) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"dbUIGJQA"},{"id":"س-05760","fp":"79a5367461d7","stateId":462,"easy":"إذا أردت أن تعمل حسنة فلم تعملها ← تُكتب لك حسنة","cause":"وإذا أرادَ أن يَعمَلَ حَسَنةً فلَم يَعمَلْها","result":"فاكتُبوها له حَسَنةً","explicit":true,"repOf":"س-01913","ref":"صحيح البخاري 7501","text":["يقولُ اللهُ: إذا أرادَ عَبدي أن يَعمَلَ سَيِّئةً فلا تَكتُبوها عليه حتَّى يَعمَلَها، فإن عَمِلَها فاكتُبوها بمِثلِها، وإن تَرَكَها مِن أجلي فاكتُبوها له حَسَنةً، ",["وإذا أرادَ أن يَعمَلَ حَسَنةً فلَم يَعمَلْها",1]," ",["فاكتُبوها له حَسَنةً",2],"، فإن عَمِلَها فاكتُبوها له بعَشرِ أمثالِها إلى سَبعِ مِئةِ ضِعفٍ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7501)، ومسلم (128)","bab":"رقائق وزهد › النية","dorar":"Xip7zc21"},{"id":"س-05761","fp":"3e3e1d5bf601","stateId":462,"easy":"إذا عملتها ← تُكتب لك بعشر أمثالها إلى سبعمئة ضعف","cause":"حَسَنةً، فإن عَمِلَها","result":"فاكتُبوها له بعَشرِ أمثالِها إلى سَبعِ مِئةِ ضِعفٍ","explicit":true,"repOf":"س-02151","ref":"صحيح البخاري 7501","text":["يقولُ اللهُ: إذا أرادَ عَبدي أن يَعمَلَ سَيِّئةً فلا تَكتُبوها عليه حتَّى يَعمَلَها، فإن عَمِلَها فاكتُبوها بمِثلِها، وإن تَرَكَها مِن أجلي فاكتُبوها له حَسَنةً، وإذا أرادَ أن يَعمَلَ حَسَنةً فلَم يَعمَلْها فاكتُبوها له ",["حَسَنةً، فإن عَمِلَها",1]," ",["فاكتُبوها له بعَشرِ أمثالِها إلى سَبعِ مِئةِ ضِعفٍ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7501)، ومسلم (128)","bab":"رقائق وزهد › النية","dorar":"Xip7zc21"},{"id":"س-01094","fp":"1c3e0d10ba1b","stateId":462,"easy":"إذا حدّثت نفسك بحسنة فلم تعملها ← تُكتب لك حسنة","cause":"إنْ حَدَّثْتَ نفْسَكَ بحَسَنةٍ فلَمْ تعْمَلْها","result":"كتَبْتُها لكَ حَسنةً","explicit":true,"repOf":"س-01913","ref":"المستدرك على الصحيحين 7833","text":["قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يقولُ اللهُ عزَّ وجلَّ: ابنَ آدمَ، إنْ دَنَوْتَ مِنِّي شِبرًا دَنَوْتُ منكَ ذِراعًا، وإنْ دَنَوتَ مِنِّي ذِراعًا دَنوْتُ منكَ باعًا، ابنَ آدَمَ، ",["إنْ حَدَّثْتَ نفْسَكَ بحَسَنةٍ فلَمْ تعْمَلْها",1]," ",["كتَبْتُها لكَ حَسنةً",2],"، وإنْ عمِلْتَها كَتَبْتُها لكَ عشْرًا، وإنْ هَمَمْتَ بسَيِّئةٍ فحَجَزَكَ عنْها هَيْبَتي كَتَبْتُها لكَ حَسنةً، وإنْ عَمِلْتَها كتَبْتُها سيِّئةً واحدةً."],"grade":"صحيح","narrator":"أبو ذر","muhaddith":"صحيح الإسناد","takhrij":"أخرجه مسلم (2687)، وابن ماجه (3821)، والبزار (3988)، والطبراني في ((المعجم الأوسط)) (1714) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"c1RSotrC"},{"id":"س-01095","fp":"21bfa2aa48f8","stateId":462,"easy":"إذا عملتها ← تُكتب لك عشراً","cause":"وإنْ عمِلْتَها","result":"كَتَبْتُها لكَ عشْرًا","explicit":true,"repOf":"س-02151","ref":"المستدرك على الصحيحين 7833","text":["قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يقولُ اللهُ عزَّ وجلَّ: ابنَ آدمَ، إنْ دَنَوْتَ مِنِّي شِبرًا دَنَوْتُ منكَ ذِراعًا، وإنْ دَنَوتَ مِنِّي ذِراعًا دَنوْتُ منكَ باعًا، ابنَ آدَمَ، إنْ حَدَّثْتَ نفْسَكَ بحَسَنةٍ فلَمْ تعْمَلْها كتَبْتُها لكَ حَسنةً، ",["وإنْ عمِلْتَها",1]," ",["كَتَبْتُها لكَ عشْرًا",2],"، وإنْ هَمَمْتَ بسَيِّئةٍ فحَجَزَكَ عنْها هَيْبَتي كَتَبْتُها لكَ حَسنةً، وإنْ عَمِلْتَها كتَبْتُها سيِّئةً واحدةً."],"grade":"صحيح","narrator":"أبو ذر","muhaddith":"صحيح الإسناد","takhrij":"أخرجه مسلم (2687)، وابن ماجه (3821)، والبزار (3988)، والطبراني في ((المعجم الأوسط)) (1714) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"c1RSotrC"},{"id":"س-04037","fp":"b66b2d1f3780","stateId":462,"easy":"إذا عملت حسنة ← فلك عشر أمثالها","cause":"مَنْ عمِلَ حسنةً","result":"فلهُ عشرُ أمثالِها","explicit":true,"repOf":"س-03157","ref":"صحيح الجامع 8141","text":["يقولُ اللهُ تعالَى : ",["مَنْ عمِلَ حسنةً ، ",1],["فلهُ عشرُ أمثالِها ",2],". وأَزيدُ ، ومَنْ عمِلَ سيِّئةً فجزاؤُها مِثلُها ، أوْ أغفِرُ ، ومَنْ عمِلَ قُرابَ الأرضِ خطيئةً ، ثمَّ لَقِيَنِي لا يُشرِكُ بي شيئًا جعلتُ لهُ مِثلَها مَغفرِةً ، ومَنِ اقترَبَ إلىَّ شِبرًا ، اقْتربتُ إليه ذِراعًا ، ومَنِ اقترَبَ إليَّ ذِراعًا ، اقتربتُ إليه باعًا ، ومَنْ أتانِي يمشِي ، أتيتُهُ هرْولَةً"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2687)، وابن ماجه (3821)، وأحمد (21488) واللفظ له","bab":"توبة › سعة رحمة الله تعالى وأنها سبقت غضبه","dorar":"EG5gkzcM"},{"id":"ق-0218","fp":"4fb300fe152d","stateId":462,"easy":"فعل الحسنة ← مضاعفتها وأجر عظيم من لدن الله","cause":"فعل الحسنة","result":"مضاعفتها وأجر عظيم من لدن الله","explicit":true,"ref":"سورة النساء: 40","srcLabel":"القرآن الكريم","quran":{"s":4,"from":40,"to":40,"text":"إِنَّ اللَّهَ لَا يَظْلِمُ مِثْقَالَ ذَرَّةٍ وَإِنْ تَكُ حَسَنَةً يُضَاعِفْهَا وَيُؤْتِ مِنْ لَدُنْهُ أَجْرًا عَظِيمًا (40)","hl":[[45,118,1]]}},{"id":"ق-0389","fp":"a5e1dbc20e93","stateId":462,"easy":"المجيء بالحسنة ← عشر أمثالها","cause":"المجيء بالحسنة","result":"عشر أمثالها","explicit":true,"repOf":"س-03157","ref":"سورة الأنعام: 160","quran":{"s":6,"from":160,"to":160,"text":"مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ عَشْرُ أَمْثَالِهَا وَمَنْ جَاءَ بِالسَّيِّئَةِ فَلَا يُجْزَى إِلَّا مِثْلَهَا وَهُمْ لَا يُظْلَمُونَ (160)","hl":[[0,52,1]]}},{"id":"ق-0908","fp":"26b2bbcce9c7","stateId":462,"easy":"المجيء بالحسنة ← خير منها والأمن من فزع يومئذ","cause":"المجيء بالحسنة","result":"خير منها والأمن من فزع يومئذ","explicit":true,"similar":["ق-0931"],"otherNeedIds":[65],"ref":"سورة النمل: 89","srcLabel":"القرآن الكريم","quran":{"s":27,"from":89,"to":89,"text":"مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ خَيْرٌ مِنْهَا وَهُمْ مِنْ فَزَعٍ يَوْمَئِذٍ آمِنُونَ (89)","hl":[[0,85,1]]}},{"id":"ق-0931","fp":"b48f3f9a960f","stateId":462,"easy":"المجيء بالحسنة ← خير منها","cause":"المجيء بالحسنة","result":"خير منها","explicit":true,"repOf":"ق-0908","ref":"سورة القصص: 84","quran":{"s":28,"from":84,"to":84,"text":"مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ خَيْرٌ مِنْهَا وَمَنْ جَاءَ بِالسَّيِّئَةِ فَلَا يُجْزَى الَّذِينَ عَمِلُوا السَّيِّئَاتِ إِلَّا مَا كَانُوا يَعْمَلُونَ (84)","hl":[[0,47,1]]}},{"id":"ق-1152","fp":"9e5727c15fb0","stateId":462,"easy":"اقتراف الحسنة ← زيادة الحُسن فيها وشكر الله","cause":"اقتراف الحسنة","result":"زيادة الحُسن فيها وشكر الله","explicit":true,"ref":"سورة الشورى: 23","srcLabel":"القرآن الكريم","quran":{"s":42,"from":23,"to":23,"text":"ذَلِكَ الَّذِي يُبَشِّرُ اللَّهُ عِبَادَهُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ قُلْ لَا أَسْأَلُكُمْ عَلَيْهِ أَجْرًا إِلَّا الْمَوَدَّةَ فِي الْقُرْبَى وَمَنْ يَقْتَرِفْ حَسَنَةً نَزِدْ لَهُ فِيهَا حُسْنًا إِنَّ اللَّهَ غَفُورٌ شَكُورٌ (23)","hl":[[160,243,1]]}},{"id":"س-06264","fp":"9a21c8dbe864","stateId":462,"easy":"إذا عملت حسنة ← فبعشر أمثالها","cause":"ومن عمل حسنةً","result":"فبعشرِ أمثالِها","explicit":true,"repOf":"س-03157","ref":"مجمع الزوائد 1/26","text":["الأعمالُ ستةٌ والناسُ أربعةٌ فموجبتانِ ومثلٌ بمثلٍ وحسنةٌ بعشرِ أمثالِها وحسنةٌ بسبعمائةِ ضعفٍ فأما الموجبتانِ فمن مات لا يشركُ باللهِ شيئًا دخل الجنةََ ومن مات يشركُ باللهِ شيئًا دخل النارَ وأما مثلٌ بمثلٍ فمَن همَّ بحسنةٍ حتى يُشعِرَها قلبَه ويعلمُها اللهُ منه كُتِبت له حسنةٌ ومن عمِل سيئةً كُتِبَت عليه سيئةٌ ",["ومن عمل حسنةً",1]," ",["فبعشرِ أمثالِها",2]," ومن أنفقَ في سبيلِ اللهِ فحسنةٌ بسبعمائةٍ ، وأما الناسُ فموسَّعٌ عليه في الدنيا مقتورٌ عليه في الآخرةِ ومقتورٌ عليه في الدنيا وموسعٌ عليه في الآخرةِ"],"grade":"صحيح","narrator":"خريم بن فاتك الأسدي","muhaddith":"رجاله رجال الصحيح إلا أنه قال عن الركين بن الربيع عن رجل عن خريم وقال الطبراني عن الركين بن الربيع عن أبيه عن عمه يسير بن عميلة ورجاله ثقات","takhrij":"أخرجه أحمد (18920)، وابن حبان (6171)، والطبراني (4/206) (4151) باختلاف يسير.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"vWLW9M9R","merged":4,"otherRefs":["صحيح ابن خزيمة 3/ 349 (صحيح)","صحيح الترغيب 978 (صحيح)","تخريج المسند لشعيب 21315 (صحيح)"]},{"id":"س-07615","fp":"b995f637b414","stateId":462,"easy":"إذا هممت بحسنة فلم تعملها ← تُكتب لك حسنة","cause":"ومَن هَمَّ بحَسَنةٍ فلَم يَعمَلْها","result":"كُتِبَت له حَسَنةً","explicit":true,"repOf":"س-01913","ref":"صحيح مسلم 162","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: أُتيتُ بالبُراقِ، وهو دابَّةٌ أبيَضُ طَويلٌ فوقَ الحِمارِ، ودونَ البَغلِ، يَضَعُ حافِرَه عِندَ مُنتَهى طَرْفِه، قال: فرَكِبتُه حتَّى أتَيتُ بَيتَ المَقدِسِ، قال: فرَبَطتُه بالحَلقةِ التي يَربِطُ به الأنبياءُ، قال: ثُمَّ دَخَلتُ المَسجِدَ، فصَلَّيتُ فيه رَكعَتَينِ، ثُمَّ خَرَجتُ فجاءَني جِبريلُ عليه السَّلامُ بإناءٍ مِن خَمرٍ، وإناءٍ مِن لَبَنٍ، فاختَرتُ اللَّبَنَ، فقال جِبريلُ صلَّى اللهُ عليه وسلَّم: اختَرتَ الفِطرةَ، ثُمَّ عُرِجَ بنا إلى السَّماءِ، فاستَفتَحَ جِبريلُ، فقيلَ: مَنَ أنتَ؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لَنا، فإذا أنا بآدَمَ، فرَحَّبَ بي، ودَعا لي بخَيرٍ، ثُمَّ عُرِجَ بنا إلى السَّماءِ الثَّانيةِ، فاستَفتَحَ جِبريلُ عليه السَّلامُ، فقيلَ: مَنَ أنتَ؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لَنا، فإذا أنا بابنَيِ الخالةِ عيسى ابنِ مَريَمَ، ويَحيى بنِ زَكَريَّا، صَلَواتُ اللهِ عليهما، فرَحَّبا ودَعَوا لي بخَيرٍ، ثُمَّ عَرَجَ بي إلى السَّماءِ الثَّالِثةِ، فاستَفتَحَ جِبريلُ، فقيلَ: مَنَ أنتَ؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ صلَّى اللهُ عليه وسلَّم، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لَنا، فإذا أنا بيوسُفَ صلَّى اللهُ عليه وسلَّم، إذا هو قد أُعطيَ شَطرَ الحُسنِ، فرَحَّبَ ودَعا لي بخَيرٍ، ثُمَّ عُرِجَ بنا إلى السَّماءِ الرَّابِعةِ، فاستَفتَحَ جِبريلُ عليه السَّلامُ، قيلَ: مَن هذا؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ، قال: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لنا فإذا أنا بإدريسَ، فرَحَّبَ ودَعا لي بخَيرٍ، قال اللهُ عزَّ وجلَّ: {ورَفَعناه مَكانًا عَليًّا} [مريم: 57]، ثُمَّ عُرِجَ بنا إلى السَّماءِ الخامِسةِ، فاستَفتَحَ جِبريلُ، قيلَ: مَن هذا؟ فقال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لنا فإذا أنا بهارونَ صلَّى اللهُ عليه وسلَّم، فرَحَّبَ ودَعا لي بخَيرٍ، ثُمَّ عُرِجَ بنا إلى السَّماءِ السَّادِسةِ، فاستَفتَحَ جِبريلُ عليه السَّلامُ، قيلَ: مَن هذا؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لَنا، فإذا أنا بموسى صلَّى اللهُ عليه وسلَّم، فرَحَّبَ ودَعا لي بخَيرٍ، ثُمَّ عُرِجَ بنا إلى السَّماءِ السَّابِعةِ، فاستَفتَحَ جِبريلُ، فقيلَ: مَن هذا؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ صلَّى اللهُ عليه وسلَّم، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لنا فإذا أنا بإبراهيمَ صلَّى اللهُ عليه وسلَّم مُسنِدًا ظَهرَه إلى البَيتِ المَعمورِ، وإذا هو يَدخُلُه كُلَّ يَومٍ سَبعونَ ألفَ مَلَكٍ لا يَعودونَ إليه، ثُمَّ ذَهَبَ بي إلى السِّدرةِ المُنتَهى، وإذا ورَقُها كَآذانِ الفيَلةِ، وإذا ثَمَرُها كالقِلالِ، قال: فلَمَّا غَشيَها مِن أمرِ اللهِ ما غَشيَ تَغَيَّرَت، فما أحَدٌ مِن خَلقِ اللهِ يَستَطيعُ أن يَنعَتَها مِن حُسنِها، فأوحى اللهُ إلَيَّ ما أوحى، ففَرَضَ عليَّ خَمسينَ صَلاةً في كُلِّ يَومٍ ولَيلةٍ، فنَزَلتُ إلى موسى صلَّى اللهُ عليه وسلَّم، فقال: ما فرَضَ رَبُّك على أُمَّتِك؟ قُلتُ: خَمسينَ صَلاةً، قال: ارجِعْ إلى رَبِّك فاسألْه التَّخفيفَ؛ فإنَّ أُمَّتَك لا يُطيقونَ ذلك، فإنِّي قد بَلَوتُ بَني إسرائيلَ وخَبَرتُهم، قال: فرَجَعتُ إلى رَبِّي، فقُلتُ: يا رَبِّ، خَفِّفْ على أُمَّتي، فحَطَّ عَنِّي خَمسًا، فرَجَعتُ إلى موسى، فقُلتُ: حَطَّ عَنِّي خَمسًا، قال: إنَّ أُمَّتَك لا يُطيقونَ ذلك، فارجِعْ إلى رَبِّك فاسألْه التَّخفيفَ، قال: فلَم أزَلْ أرجِعُ بينَ رَبِّي تَبارَك وتَعالى وبينَ موسى عليه السَّلامُ، حتَّى قال: يا مُحَمَّدُ، إنَّهنَّ خَمسُ صَلَواتٍ كُلَّ يَومٍ ولَيلةٍ، لكُلِّ صَلاةٍ عَشرٌ، فذلك خَمسونَ صَلاةً، ",["ومَن هَمَّ بحَسَنةٍ فلَم يَعمَلْها",1]," ",["كُتِبَت له حَسَنةً",2],"، فإن عَمِلَها كُتِبَت له عَشرًا، ومَن هَمَّ بسَيِّئةٍ فلَم يَعمَلْها لَم تُكتَبْ شيئًا، فإن عَمِلَها كُتِبَت سَيِّئةً واحِدةً، قال: فنَزَلتُ حتَّى انتَهَيتُ إلى موسى صلَّى اللهُ عليه وسلَّم، فأخبَرتُه، فقال: ارجِعْ إلى رَبِّك فاسألْه التَّخفيفَ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: فقُلتُ: قد رَجَعتُ إلى رَبِّي حتَّى استَحيَيتُ منه."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه أبو محمد البغوي في ((شرح السنة)) (3753) بلفظه، والنسائي (450) بنحوه مطولا، وأبو يعلى (3375) مختصرا ببعض لفظه،","bab":"فضائل النبي وصفته ودلائل النبوة › معجزات النبي","dorar":"jwUaVu3q","merged":3,"otherRefs":["تخريج صحيح ابن حبان 6171 (صحيح)","حلية الأولياء 2/349 (صحيح)"]},{"id":"س-04232","fp":"95b903bd9386","stateId":462,"easy":"إذا هممت بحسنة فعملتها ← تُكتب لك عشرة أمثالها","cause":"ومَن هَمَّ بحسَنةٍ فعمِلها","result":"كُتِبَتْ له عَشَرةُ أمثالِها","explicit":true,"repOf":"س-02343","ref":"تخريج صحيح ابن حبان 6171","text":["النَّاسُ أربعةٌ والأعمالُ ستَّةٌ مُوجبتانِ ومِثْلٌ بمِثْلٍ وحسَنةٌ بعَشْرِ أمثالِها وحسَنةٌ بسَبْعِمئةِ ضِعْفٍ والنَّاسُ موسَّعٌ عليه في الدُّنيا والآخرةِ وموسَّعٌ عليه في الدُّنيا مَقتورٌ عليه في الآخرةِ ومَقتورٌ عليه في الدُّنيا موسَّعٌ عليه في الآخرةِ ومَقتورٌ عليه في الدُّنيا والآخرةِ وشَقيٌّ في الدُّنيا وشَقيٌّ في الآخرةِ والمُوجِبتانِ : مَن قال لا إلهَ إلَّا اللهُ أو قال : مؤمنًا باللهِ دخَل الجنَّةَ ومَن مات وهو يُشرِكُ باللهِ دخَل النَّارَ ",["ومَن هَمَّ بحسَنةٍ فعمِلها",1]," ",["كُتِبَتْ له عَشَرةُ أمثالِها",2]," ومَن هَمَّ بحسَنةٍ فلم يعمَلْها كُتِبَتْ له حسَنةٌ ومَن هَمَّ بسيِّئةٍ فلم يعمَلْها كُتِبَتْ له حسَنةٌ ومَن هَمَّ بسيِّئةٍ فعمِلها كُتِبَتْ له سيِّئةٌ واحدةٌ غيرُ مضعَّفةٍ ومَن أنفَق نفقةً فاضلةً في سبيلِ اللهِ فبِسَبْعِمِئةِ ضِعْفٍ"],"grade":"صحيح","narrator":"خريم بن فاتك الأسدي","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (6171) واللفظ له، وابن أبي شيبة في ((مسنده)) (743)، وابن ابي عاصم في ((الآحاد والمثاني)) (1047)، والطبراني (4/ 205)(4151) جميعهم باختلاف يسير .","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"0BwkAjc5"},{"id":"س-06263","fp":"2da4232e528a","stateId":462,"easy":"إذا هممت بحسنة حتى يشعر بها قلبك ← تُكتب لك حسنة","cause":"فمَن همَّ بحسنةٍ حتى يُشعِرَها قلبَه ويعلمُها اللهُ منه","result":"كُتِبت له حسنةٌ","explicit":true,"repOf":"س-01913","ref":"مجمع الزوائد 1/26","text":["الأعمالُ ستةٌ والناسُ أربعةٌ فموجبتانِ ومثلٌ بمثلٍ وحسنةٌ بعشرِ أمثالِها وحسنةٌ بسبعمائةِ ضعفٍ فأما الموجبتانِ فمن مات لا يشركُ باللهِ شيئًا دخل الجنةََ ومن مات يشركُ باللهِ شيئًا دخل النارَ وأما مثلٌ بمثلٍ ",["فمَن همَّ بحسنةٍ حتى يُشعِرَها قلبَه ويعلمُها اللهُ منه",1]," ",["كُتِبت له حسنةٌ",2]," ومن عمِل سيئةً كُتِبَت عليه سيئةٌ ومن عمل حسنةً فبعشرِ أمثالِها ومن أنفقَ في سبيلِ اللهِ فحسنةٌ بسبعمائةٍ ، وأما الناسُ فموسَّعٌ عليه في الدنيا مقتورٌ عليه في الآخرةِ ومقتورٌ عليه في الدنيا وموسعٌ عليه في الآخرةِ"],"grade":"صحيح","narrator":"خريم بن فاتك الأسدي","muhaddith":"رجاله رجال الصحيح إلا أنه قال عن الركين بن الربيع عن رجل عن خريم وقال الطبراني عن الركين بن الربيع عن أبيه عن عمه يسير بن عميلة ورجاله ثقات","takhrij":"أخرجه أحمد (18920)، وابن حبان (6171)، والطبراني (4/206) (4151) باختلاف يسير.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"vWLW9M9R"},{"id":"س-06367","fp":"c8a1fef65868","stateId":462,"easy":"إذا هممت بحسنة فلم تعملها وقد أشعرها قلبك وحرصت عليها ← تُكتب لك حسنة","cause":"ومَن همَّ بحسنةٍ فلَم يعملْها ، فعلِمَ اللَّهُ أنَّهُ قد أشعرَها قلبَه وحرصَ علَيها","result":"كُتبَت لَهُ حسنةً","explicit":true,"repOf":"س-01913","ref":"عمدة التفسير 1/846","text":["النَّاسُ أربعةٌ ، والعمَّالُ ستَّةٌ . فالنَّاسُ موسَّعٌ لَهُ في الدُّنيا والآخرةِ ، وموسَّعٌ لَهُ في الدُّنيا مقتورٌ عليهِ في الآخرةِ ، ومقتورٌ عليهِ في الدُّنيا موسَّعٌ لَهُ في الآخرةِ ، وشقيٌ في الدُّنيا والآخرةِ . والأعمالُ موجبتانِ ، ومثلٌ بمثلٍ ، وعشرةُ أضعافٍ ، وسبعُمائةِ ضعفٍ ؛ فالموجبتانِ مَن ماتَ مسلمًا مؤمنًا لا يشرِكُ باللَّهِ شيئًا وجبَتْ لَهُ الجنَّةُ ، ومَن ماتَ كافرًا وجبَتْ لَهُ النَّارُ . ",["ومَن همَّ بحسنةٍ فلَم يعملْها ، فعلِمَ اللَّهُ أنَّهُ قد أشعرَها قلبَه وحرصَ علَيها",1]," ، ",["كُتبَت لَهُ حسنةً",2]," . ومَن همَّ بسيِّئةٍ لم تُكْتَب عليهِ ، ومَن عمِلَها كُتبَت واحدةً ولم تُضاعَف عليهِ . ومَن عملَ حسنةً كانت له بعشرةِ أمثالِها . ومَن أنفقَ نفقةً في سبيلِ اللَّهِ ، عزَّ وجلَّ ، كانت لَهُ بسبعِمائةِ ضعفٍ"],"grade":"صحيح","narrator":"خريم بن فاتك الأسدي","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي شيبة في ((مسنده)) (743)، وابن ابي عاصم في ((الآحاد والمثاني)) (1047)، وابن حبان (4630) جميعهم باختلاف يسير .","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"mVsonKjD"},{"id":"س-06368","fp":"43ad3443a89d","stateId":462,"easy":"إذا عملت حسنة ← تكون لك بعشرة أمثالها","cause":"ومَن عملَ حسنةً","result":"كانت له بعشرةِ أمثالِها","explicit":true,"repOf":"س-03157","ref":"عمدة التفسير 1/846","text":["النَّاسُ أربعةٌ ، والعمَّالُ ستَّةٌ . فالنَّاسُ موسَّعٌ لَهُ في الدُّنيا والآخرةِ ، وموسَّعٌ لَهُ في الدُّنيا مقتورٌ عليهِ في الآخرةِ ، ومقتورٌ عليهِ في الدُّنيا موسَّعٌ لَهُ في الآخرةِ ، وشقيٌ في الدُّنيا والآخرةِ . والأعمالُ موجبتانِ ، ومثلٌ بمثلٍ ، وعشرةُ أضعافٍ ، وسبعُمائةِ ضعفٍ ؛ فالموجبتانِ مَن ماتَ مسلمًا مؤمنًا لا يشرِكُ باللَّهِ شيئًا وجبَتْ لَهُ الجنَّةُ ، ومَن ماتَ كافرًا وجبَتْ لَهُ النَّارُ . ومَن همَّ بحسنةٍ فلَم يعملْها ، فعلِمَ اللَّهُ أنَّهُ قد أشعرَها قلبَه وحرصَ علَيها ، كُتبَت لَهُ حسنةً . ومَن همَّ بسيِّئةٍ لم تُكْتَب عليهِ ، ومَن عمِلَها كُتبَت واحدةً ولم تُضاعَف عليهِ . ",["ومَن عملَ حسنةً",1]," ",["كانت له بعشرةِ أمثالِها",2]," . ومَن أنفقَ نفقةً في سبيلِ اللَّهِ ، عزَّ وجلَّ ، كانت لَهُ بسبعِمائةِ ضعفٍ"],"grade":"صحيح","narrator":"خريم بن فاتك الأسدي","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي شيبة في ((مسنده)) (743)، وابن ابي عاصم في ((الآحاد والمثاني)) (1047)، وابن حبان (4630) جميعهم باختلاف يسير .","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"mVsonKjD"},{"id":"س-06879","fp":"d906793459cc","stateId":462,"easy":"إذا هممت بحسنة فعملتها ← تُكتب عشر أمثالها إلى سبعمئة ضعف إلى أضعاف كثيرة","cause":"حسنةً ، فإن عمِلها","result":"كُتِبتْ له عشرَ أمثالِها ، إلى سبعِمائةِ ضعفٍ إلى أضعافٍ كثيرةٍ","explicit":true,"repOf":"س-02151","ref":"حلية الأولياء 2/349","text":["عن النَّبيِّ صلَّى اللهُ عليه وسلَّم فيما يروي عن ربِّه عزَّ وجلَّ ، قال : إنَّ ربَّكم تعالَى رحيمٌ ؛ من همَّ بحسنةٍ فلم يعملْها كُتِبتْ له ",["حسنةً ، فإن عمِلها",1]," ",["كُتِبتْ له عشرَ أمثالِها ، إلى سبعِمائةِ ضعفٍ إلى أضعافٍ كثيرةٍ",2]," ، ومن همَّ بسيِّئةٍ فلم يعملْها كُتِبتْ له حسنةً ، فإن عمِلها كُتِبتْ عليه واحدةً أو يمحوها ، ولا يهلِكُ على اللهِ عزَّ وجلَّ إلَّا هالكٌ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي الدنيا في ((التوبة)) (26)، والطبراني (12/ 161) (12760) واللفظ لهما.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"CxNQv4ZM"},{"id":"س-07616","fp":"02bd02d84963","stateId":462,"easy":"إذا عملتها ← تُكتب لك عشراً","cause":"حَسَنةً، فإن عَمِلَها","result":"كُتِبَت له عَشرًا","explicit":true,"repOf":"س-02151","ref":"صحيح مسلم 162","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: أُتيتُ بالبُراقِ، وهو دابَّةٌ أبيَضُ طَويلٌ فوقَ الحِمارِ، ودونَ البَغلِ، يَضَعُ حافِرَه عِندَ مُنتَهى طَرْفِه، قال: فرَكِبتُه حتَّى أتَيتُ بَيتَ المَقدِسِ، قال: فرَبَطتُه بالحَلقةِ التي يَربِطُ به الأنبياءُ، قال: ثُمَّ دَخَلتُ المَسجِدَ، فصَلَّيتُ فيه رَكعَتَينِ، ثُمَّ خَرَجتُ فجاءَني جِبريلُ عليه السَّلامُ بإناءٍ مِن خَمرٍ، وإناءٍ مِن لَبَنٍ، فاختَرتُ اللَّبَنَ، فقال جِبريلُ صلَّى اللهُ عليه وسلَّم: اختَرتَ الفِطرةَ، ثُمَّ عُرِجَ بنا إلى السَّماءِ، فاستَفتَحَ جِبريلُ، فقيلَ: مَنَ أنتَ؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لَنا، فإذا أنا بآدَمَ، فرَحَّبَ بي، ودَعا لي بخَيرٍ، ثُمَّ عُرِجَ بنا إلى السَّماءِ الثَّانيةِ، فاستَفتَحَ جِبريلُ عليه السَّلامُ، فقيلَ: مَنَ أنتَ؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لَنا، فإذا أنا بابنَيِ الخالةِ عيسى ابنِ مَريَمَ، ويَحيى بنِ زَكَريَّا، صَلَواتُ اللهِ عليهما، فرَحَّبا ودَعَوا لي بخَيرٍ، ثُمَّ عَرَجَ بي إلى السَّماءِ الثَّالِثةِ، فاستَفتَحَ جِبريلُ، فقيلَ: مَنَ أنتَ؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ صلَّى اللهُ عليه وسلَّم، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لَنا، فإذا أنا بيوسُفَ صلَّى اللهُ عليه وسلَّم، إذا هو قد أُعطيَ شَطرَ الحُسنِ، فرَحَّبَ ودَعا لي بخَيرٍ، ثُمَّ عُرِجَ بنا إلى السَّماءِ الرَّابِعةِ، فاستَفتَحَ جِبريلُ عليه السَّلامُ، قيلَ: مَن هذا؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ، قال: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لنا فإذا أنا بإدريسَ، فرَحَّبَ ودَعا لي بخَيرٍ، قال اللهُ عزَّ وجلَّ: {ورَفَعناه مَكانًا عَليًّا} [مريم: 57]، ثُمَّ عُرِجَ بنا إلى السَّماءِ الخامِسةِ، فاستَفتَحَ جِبريلُ، قيلَ: مَن هذا؟ فقال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لنا فإذا أنا بهارونَ صلَّى اللهُ عليه وسلَّم، فرَحَّبَ ودَعا لي بخَيرٍ، ثُمَّ عُرِجَ بنا إلى السَّماءِ السَّادِسةِ، فاستَفتَحَ جِبريلُ عليه السَّلامُ، قيلَ: مَن هذا؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لَنا، فإذا أنا بموسى صلَّى اللهُ عليه وسلَّم، فرَحَّبَ ودَعا لي بخَيرٍ، ثُمَّ عُرِجَ بنا إلى السَّماءِ السَّابِعةِ، فاستَفتَحَ جِبريلُ، فقيلَ: مَن هذا؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ صلَّى اللهُ عليه وسلَّم، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لنا فإذا أنا بإبراهيمَ صلَّى اللهُ عليه وسلَّم مُسنِدًا ظَهرَه إلى البَيتِ المَعمورِ، وإذا هو يَدخُلُه كُلَّ يَومٍ سَبعونَ ألفَ مَلَكٍ لا يَعودونَ إليه، ثُمَّ ذَهَبَ بي إلى السِّدرةِ المُنتَهى، وإذا ورَقُها كَآذانِ الفيَلةِ، وإذا ثَمَرُها كالقِلالِ، قال: فلَمَّا غَشيَها مِن أمرِ اللهِ ما غَشيَ تَغَيَّرَت، فما أحَدٌ مِن خَلقِ اللهِ يَستَطيعُ أن يَنعَتَها مِن حُسنِها، فأوحى اللهُ إلَيَّ ما أوحى، ففَرَضَ عليَّ خَمسينَ صَلاةً في كُلِّ يَومٍ ولَيلةٍ، فنَزَلتُ إلى موسى صلَّى اللهُ عليه وسلَّم، فقال: ما فرَضَ رَبُّك على أُمَّتِك؟ قُلتُ: خَمسينَ صَلاةً، قال: ارجِعْ إلى رَبِّك فاسألْه التَّخفيفَ؛ فإنَّ أُمَّتَك لا يُطيقونَ ذلك، فإنِّي قد بَلَوتُ بَني إسرائيلَ وخَبَرتُهم، قال: فرَجَعتُ إلى رَبِّي، فقُلتُ: يا رَبِّ، خَفِّفْ على أُمَّتي، فحَطَّ عَنِّي خَمسًا، فرَجَعتُ إلى موسى، فقُلتُ: حَطَّ عَنِّي خَمسًا، قال: إنَّ أُمَّتَك لا يُطيقونَ ذلك، فارجِعْ إلى رَبِّك فاسألْه التَّخفيفَ، قال: فلَم أزَلْ أرجِعُ بينَ رَبِّي تَبارَك وتَعالى وبينَ موسى عليه السَّلامُ، حتَّى قال: يا مُحَمَّدُ، إنَّهنَّ خَمسُ صَلَواتٍ كُلَّ يَومٍ ولَيلةٍ، لكُلِّ صَلاةٍ عَشرٌ، فذلك خَمسونَ صَلاةً، ومَن هَمَّ بحَسَنةٍ فلَم يَعمَلْها كُتِبَت له ",["حَسَنةً، فإن عَمِلَها",1]," ",["كُتِبَت له عَشرًا",2],"، ومَن هَمَّ بسَيِّئةٍ فلَم يَعمَلْها لَم تُكتَبْ شيئًا، فإن عَمِلَها كُتِبَت سَيِّئةً واحِدةً، قال: فنَزَلتُ حتَّى انتَهَيتُ إلى موسى صلَّى اللهُ عليه وسلَّم، فأخبَرتُه، فقال: ارجِعْ إلى رَبِّك فاسألْه التَّخفيفَ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: فقُلتُ: قد رَجَعتُ إلى رَبِّي حتَّى استَحيَيتُ منه."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه أبو محمد البغوي في ((شرح السنة)) (3753) بلفظه، والنسائي (450) بنحوه مطولا، وأبو يعلى (3375) مختصرا ببعض لفظه،","bab":"فضائل النبي وصفته ودلائل النبوة › معجزات النبي","dorar":"jwUaVu3q"},{"id":"س-04030","fp":"1dcf6e372082","stateId":462,"easy":"إذا عملت الحسنة ← يكتبها الله بعشر أمثالها","cause":"فإذا عَمِلَها","result":"فأنا أكتُبُها بعَشرِ أمثالِها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03157","ref":"صحيح مسلم 129","text":["قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: قال اللهُ عزَّ وجلَّ: إذا تَحَدَّثَ عَبدي بأن يَعمَلَ حَسَنةً فأنا أكتُبُها له حَسَنةً ما لَم يَعمَلْ، ",["فإذا عَمِلَها",1]," ",["فأنا أكتُبُها بعَشرِ أمثالِها",2],"، وإذا تَحَدَّثَ بأن يَعمَلَ سَيِّئةً فأنا أغفِرُها له ما لَم يَعمَلْها، فإذا عَمِلَها فأنا أكتُبُها له بمِثلِها. وقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: قالتِ الملائِكةُ: رَبِّ، ذاك عَبدُك يُريدُ أن يَعمَلَ سَيِّئةً، وهو أبصَرُ به، فقال: ارقُبوه فإن عَمِلَها فاكتُبوها له بمِثلِها، وإن تَرَكَها فاكتُبوها له حَسَنةً، إنَّما تَرَكَها مِن جَرَّايَ. وقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: إذا أحسَنَ أحَدُكُم إسلامَه، فكُلُّ حَسَنةٍ يَعمَلُها تُكتَبُ بعَشرِ أمثالِها إلى سَبعِ مِئةِ ضِعفٍ، وكُلُّ سَيِّئةٍ يَعمَلُها تُكتَبُ بمِثلِها حتَّى يَلقى اللهَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (42)، ومسلم (129).","bab":"توبة › سعة رحمة الله تعالى وأنها سبقت غضبه","dorar":"2jngWHp5","merged":4,"otherRefs":["صحيح الترمذي 3073 (صحيح)","تخريج صحيح ابن حبان 380 (صحيح)","معجم الشيوخ 2/690 (صحيح)"]},{"id":"س-02685","fp":"682891e05fa2","stateId":463,"easy":"إذا تكلفت من العمل ما تطيق ← فالله لا يمل حتى تملّوا","cause":"اكْلُفُوا من العملِ ما لكم بهِ طاقةٌ","result":"اللهَ لا يَمَلُّ حتى تَمَلُّوا","explicit":true,"ref":"الاستذكار 2/84","srcLabel":"مالك","text":["سمع امرأةً من الليلِ تُصلِّي ، فقال : من هذه ؟ فقيل : الحولاءُ بنتُ تويتٍ لا تنامُ الليلَ ، فكرهَ ذلك رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ حتى عُرِفَتِ الكراهيةُ في وجهِهِ ، ثم قال : إنَّ ",["اللهَ لا يَمَلُّ حتى تَمَلُّوا",2]," ، ",["اكْلُفُوا من العملِ ما لكم بهِ طاقةٌ",1]],"grade":"صحيح","narrator":"إسماعيل بن أبي حكيم","muhaddith":"صحيح مسند","takhrij":"أخرجه مالك (1/118)","bab":"إيمان › الدين يسر","dorar":"2L0PEQwr"},{"id":"س-07575","fp":"88ddc04a6ea5","stateId":463,"easy":"إذا تكلفت من الأعمال ما تطيق ← فالله لا يمل حتى تملّوا","cause":"فاكْلَفوا مِنَ الأعمالِ ما تُطيقونَ","result":"فإنَّ اللهَ لا يَمَلُّ حتى تَمَلُّوا","explicit":true,"star":true,"similar":["س-03134"],"ref":"تخريج المسند لشعيب 26307","srcLabel":"متفق عليه","text":["كان النَّاسُ يُصَلُّونَ في مسجِدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في رَمَضانَ باللَّيلِ أوْزاعًا، يَكونُ مع الرَّجُلِ الشَّيءُ مِنَ القُرآنِ، فيكونُ معه النَّفَرُ الخَمسةُ، أوِ السِّتَّةُ، أو أقَلُّ مِن ذلك أو أكثَرُ، يُصَلُّونَ بصَلاتِه، قالَتْ: فأمَرَني رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ لَيلةً مِن ذلك أنْ أنْصِبَ له حَصيرًا على بابِ حُجْرَتي، ففعَلتُ، فخرَجَ إليهِ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بَعدَ أنْ صلَّى العِشاءَ الآخِرةَ، قالَتْ: فاجتَمَعَ إليه مَن في المسجِدِ، فصلَّى بهم رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ لَيلًا طَويلًا، ثم انصَرَفَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فدخَلَ، وترَكَ الحَصيرَ على حالِه، فلمَّا أصبَحَ النَّاسُ تَحَدَّثوا بِصلاةِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ بمَن كان معه في المسجِدِ تلك اللَّيلةَ، قالَتْ: وأمْسى المسجِدُ راجًّا بِالنَّاسِ، فصلَّى بهم رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ العِشاءَ الآخِرةَ، ثم دخَلَ بَيتَه وثبَتَ النَّاسُ، قالَتْ: فقال لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ما شَأنُ النَّاسِ يا عائِشةُ؟ قالَتْ: فقُلتُ له: يا رسولَ اللهِ، سمِعَ النَّاسُ بِصَلاتِكَ البارِحةَ بمَن كان في المسجِدِ، فحشَدوا لذلك؛ لتُصَلِّيَ بهم، قالَتْ: فقال: اطْوِ عنَّا حَصيرَكِ يا عائِشةُ، قالَتْ: ففَعَلتُ، وباتَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ غَيرَ غافِلٍ، وثبَتَ النَّاسُ مَكانَهُم حتى خرَجَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ إلى الصُّبحِ، فقالَتْ: فقال: أيُّها النَّاسُ، أمَا واللهِ ما بِتُّ -والحَمدُ للهِ- لَيلَتي هذه غافِلًا، وما خَفِيَ علَيَّ مَكانُكُم، ولكنِّي تَخوَّفتُ أنْ يُفتَرَضَ عليكم؛ ",["فاكْلَفوا مِنَ الأعمالِ ما تُطيقونَ",1],"؛ ",["فإنَّ اللهَ لا يَمَلُّ حتى تَمَلُّوا",2],"، قال: وكانَتْ عائِشةُ تَقولُ: إنَّ أحَبَّ الأعمالِ إلى اللهِ أدْوَمُها، وإنْ قَلَّ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح لغيره","takhrij":"أخرجه البخاري (5861)، ومسلم (782)، وأبو داود (1368)، والترمذي (2856)، والنسائي (762) مختصراً، وأحمد (26307) واللفظ له.","bab":"فضائل النبي وصفته ودلائل النبوة › شفقته على أمته","dorar":"uov3XybL","merged":9,"otherRefs":["تخريج المسند لشعيب 24540 (صحيح)","صحيح ابن خزيمة 1626 (صحيح)","تخريج المسند لشعيب 25632 (صحيح)","تخريج المسند لشعيب 24322 (صحيح)","تخريج المسند لشعيب 24912 (صحيح)","صحيح ابن خزيمة 3/ 492 (صحيح)","تخريج المسند لشعيب 25772 (صحيح)","تفسير القرطبي 21/321 (صحيح)"]},{"id":"س-02181","fp":"20fa25387d50","stateId":463,"easy":"إذا تعبت وأنفقت في العبادة ← فأجرك على قدر تعبك ونفقتك","cause":"على قدْرِ نَصَبِك و نفقتِك","result":"إنَّ لك من الأجرِ","explicit":true,"similar":["س-02208"],"ref":"صحيح الجامع 2160","srcLabel":"متفق عليه","text":[["إنَّ لك من الأجرِ",2]," ",["على قدْرِ نَصَبِك و نفقتِك",1]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (1733) بلفظه، والبخاري (1787)، ومسلم (1211)، وأحمد (24159) جميعا بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"LI57FcmG"},{"id":"س-02208","fp":"7ea3effbfa4d","stateId":463,"easy":"إذا تعبت وأنفقت ← فالأجر على قدر النصب والنفقة","cause":"علَى قَدْرِ نَفَقَتِكِ أوْ نَصَبِكِ","result":"الأجرُ على قدرِ النَّصبِ","explicit":true,"repOf":"س-02181","ref":"النوافح العطرة 19","text":[["الأجرُ على قدرِ النَّصبِ",2]," [يعني حديث: قالَتْ عَائِشَةُ رَضِيَ اللَّهُ عَنْهَا: يا رَسولَ اللَّهِ، يَصْدُرُ النَّاسُ بنُسُكَيْنِ، وأَصْدُرُ بنُسُكٍ؟ فقِيلَ لَهَا: انْتَظِرِي، فَإِذَا طَهُرْتِ، فَاخْرُجِي إلى التَّنْعِيمِ ، فأهِلِّي ثُمَّ ائْتِينَا بمَكَانِ كَذَا، ولَكِنَّهَا ",["علَى قَدْرِ نَفَقَتِكِ أوْ نَصَبِكِ",1],".]"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1211) بنحوه","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"HNLmXRQL"},{"id":"س-03134","fp":"4c55c0492c67","stateId":463,"easy":"إذا تكلفت من العمل ما تطيق ← فالله لا يمل حتى تملّوا","cause":"لِيَتَكَلَّفْ أحدُكم مِنَ العملِ ما يُطِيقُ","result":"فإِنَّ اللهَ تعالى لا يَملُّ ، حتى تملُّوا","explicit":true,"repOf":"س-07575","ref":"صحيح الجامع 5358","text":[["لِيَتَكَلَّفْ أحدُكم مِنَ العملِ ما يُطِيقُ",1]," ، ",["فإِنَّ اللهَ تعالى لا يَملُّ ، حتى تملُّوا",2]," ، وقارِبوا وسدِّدُوا"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه أبو نعيم في ((حلية الأولياء)) (9/20) باختلاف يسير، وأخرجه مسلم (782، 2818) مفرقاً بنحوه","bab":"إيمان › توحيد الأسماء والصفات","dorar":"tcmM8k0i"},{"id":"س-03111","fp":"af63e9970d93","stateId":463,"easy":"إذا لزمت القصد (الاعتدال) ← فالله لا يمل حتى تملّوا","cause":"عليكم بالقصدِ عليكم بالقصدِ","result":"فإنَّ اللهَ لا يمَلُّ حتَّى تمَلُّوا","explicit":true,"ref":"صحيح ابن حبان 357","srcLabel":"ابن ماجه","text":["مرَّ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم على رجلٍ قائمٍ يُصلِّي على صخرةٍ فأتى ناحيةَ مكَّةَ فمكَث مليًّا ثمَّ أقبَل فوجَد الرَّجلَ على حالِه يُصلِّي فجمَع يدَيهِ ثمَّ قال: ( أيُّها النَّاسُ ",["عليكم بالقصدِ عليكم بالقصدِ ",1],["فإنَّ اللهَ لا يمَلُّ حتَّى تمَلُّوا )",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن ماجه (4241)، وأبو يعلى (1796) كلاهما باختلاف يسير مطولًا، والطبراني في ((المعجم الأوسط)) (3729) مختصرًا بنحوه دون قوله: ((ا أيها الناس عليكم بالقصد ثلاثا))","bab":"إيمان › توحيد الأسماء والصفات","dorar":"ceV38S9g"},{"id":"س-05757","fp":"f33e7e432e20","stateId":464,"easy":"إذا نويت الصدقة ← فلك ما نويت","cause":"أخرَجَ دَنانيرَ يَتَصَدَّقُ بها","result":"لكَ ما نَويتَ يا يَزيدُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح البخاري 1422","srcLabel":"أحمد","text":["بايَعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم أنا وأبي وجَدِّي، وخَطَبَ عليَّ، فأنكَحَني وخاصَمتُ إليه، وكان أبي يَزيدُ ",["أخرَجَ دَنانيرَ يَتَصَدَّقُ بها",1],"، فوضَعَها عِندَ رَجُلٍ في المَسجِدِ، فجِئتُ فأخَذتُها، فأتَيتُه بها، فقال: واللهِ ما إيَّاكَ أرَدتُ، فخاصَمتُه إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: ",["لكَ ما نَويتَ يا يَزيدُ",2],"، ولَكَ ما أخَذتَ يا مَعنُ."],"grade":"صحيح","narrator":"معن بن يزيد","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (15860)، والدارمي (1678) باختلاف يسير، وأبو يعلى (1551) بنحوه.","bab":"رقائق وزهد › النية","dorar":"le5lmTku"},{"id":"س-05763","fp":"8f6fb27103ea","stateId":464,"easy":"إذا آتاك الله علماً ولم يؤتك مالاً فنويت الخير صادقاً ← فأنت والمنفق في الأجر سواء","cause":"آتاه اللهُ علمًا و لم يُؤْتِه مالًا و هو يقول : لو كان لي مثلُ هذا عملتُ فيه بمثلِ الذي يعملُ","result":"فهما في الأجر سواءٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح الترغيب 16","srcLabel":"الترمذي","text":["إنما الدنيا لأربعةِ نفرٍ ؛ عبدٌ رزقَه اللهُ مالًا و علمًا فهو يتَّقي فيه ربَّه ، و يصِلُ فيه رَحِمَه ، و يعلمُ للهِ فيه حقًّا ، فهذا بأفضلِ المنازلِ ، و عبدٌ رزقَه اللهُ علمًا ، و لم يرزقْه مالًا ، فهو صادقُ النَّيَّةِ ، يقولُ : لو أنَّ لي مالًا لعملتُ بعملِ فلانٍ ، فهو بنِيَّتِه ، فأجرُهما سواءٌ و عبدٌ رزقَه اللهُ مالًا ، و لم يرزقْه عِلمًا يخبِطُ في مالِه بغيرِ علمٍ ، و لا يتَّقي فيه ربَّه ، و لا يصِلُ فيه رَحِمَه ، و لا يعلمُ للهِ فيه حقًّا ، فهذا بأخبثِ المنازلِ ، و عبدٌ لم يرزقْه اللهُ مالًا و لا علمًا فهو يقولُ : لو أنَّ لي مالًا لعملتُ فيه بعملِ فلانٍ ، فهو بنيَّتِه ، فوزرُهما سواءٌ ) مثلَ هذه الأمةِ كمثلِ أربعةِ نفرٍ : رجلٌ آتاه اللهُ مالًا و علمًا فهو يعملُ بعلمِه في مالِه ؛ ينفقُه في حقِّه ، و رجلٌ ",["آتاه اللهُ علمًا و لم يُؤْتِه مالًا و هو يقول : لو كان لي مثلُ هذا عملتُ فيه بمثلِ الذي يعملُ",1]," ",["فهما في الأجر سواءٌ",2]," ، و رجلٌ آتاه اللهُ مالًا و لم يُؤتِه علمًا فهو يخبطُ في مالِه ينفقُه في غيرِ حقِّه ، و رجلٌ لم يؤْتِه اللهُ مالًا و لا علمًا ، و هو يقولُ : لو كان لي مثلُ هذا عملتُ فيه مثلَ الذي يعمل قال رسولُ اللهِ : فهما في الوزرِ سواءٌ"],"grade":"صحيح","narrator":"أبو كبشة الأنماري","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (2325) مطولاً واللفظ له، وأحمد (18031) مطولاً باختلاف يسير","bab":"رقائق وزهد › النية","dorar":"MhgfuyRo","merged":5,"otherRefs":["شرح مسلم لابن عثيمين 2/456 (صحيح)","فتاوى نور على الدرب لابن باز 18/266 (صحيح)","الفروع لابن مفلح 3/ 73 (حسن)","هداية الرواة 5217 (صحيح)"]},{"id":"ق-0259","fp":"fd500b95f1fa","stateId":464,"easy":"طلب الثواب من الله ← ثواب الدنيا والآخرة عنده","cause":"طلب الثواب من الله","result":"ثواب الدنيا والآخرة عنده","explicit":true,"star":true,"otherNeedIds":[1],"ref":"سورة النساء: 134","srcLabel":"القرآن الكريم","quran":{"s":4,"from":134,"to":134,"text":"مَنْ كَانَ يُرِيدُ ثَوَابَ الدُّنْيَا فَعِنْدَ اللَّهِ ثَوَابُ الدُّنْيَا وَالْآخِرَةِ وَكَانَ اللَّهُ سَمِيعًا بَصِيرًا (134)","hl":[[0,120,1]]}},{"id":"ق-1148","fp":"97261414464f","stateId":464,"easy":"إرادة حرث الآخرة ← الزيادة في الحرث","cause":"إرادة حرث الآخرة","result":"الزيادة في الحرث","explicit":true,"star":true,"ref":"سورة الشورى: 20","srcLabel":"القرآن الكريم","quran":{"s":42,"from":20,"to":20,"text":"مَنْ كَانَ يُرِيدُ حَرْثَ الْآخِرَةِ نَزِدْ لَهُ فِي حَرْثِهِ وَمَنْ كَانَ يُرِيدُ حَرْثَ الدُّنْيَا نُؤْتِهِ مِنْهَا وَمَا لَهُ فِي الْآخِرَةِ مِنْ نَصِيبٍ (20)","hl":[[0,62,1]]}},{"id":"س-04696","fp":"c1cd086fef05","stateId":464,"easy":"إذا عملت سراً فاطُّلع عليه فسرّك ← فلك أجران: أجر السر وأجر العلانية","cause":"يعملُ العملَ يسرُّه فإذا اطُّلِع عليه أعجبَه","result":"لكَ أجرانِ أجرُ السرِّ وأجرُ العلانيةِ","explicit":true,"ref":"مسند عمر 2/807","srcLabel":"أبو داود","text":["أنَّ رجلًا قال يا رسولَ اللهِ الرجلُ ",["يعملُ العملَ يسرُّه فإذا اطُّلِع عليه أعجبَه",1]," فقال النبيُّ صلَّى اللهُ عليهِ وسلَّمَ ",["لكَ أجرانِ أجرُ السرِّ وأجرُ العلانيةِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود الطيالسي في ((المسند)) (2552)، والبزار (8921) بلفظه.","bab":"رقائق وزهد › الإخلاص","dorar":"Ktt8DtGQ","merged":3,"otherRefs":["مجمع الزوائد 2/273 (صحيح)","صحيح ابن حبان 375 (صحيح)"]},{"id":"س-04701","fp":"6f7df0e77c97","stateId":464,"easy":"إذا نويت الخير ← فنية المؤمن خير من عمله","cause":"نيَّةُ المؤمنِ","result":"خيرٌ من عملِه","explicit":true,"ref":"النوافح العطرة 425","srcLabel":"الطبراني","text":[["نيَّةُ المؤمنِ ",1],["خيرٌ من عملِه ",2],"[وعملُ المنافقِ خيرٌ من نيَّتِه وكلٌّ يعمَلُ على نيَّتِه فإذا عمِل المؤمنُ عملًا ثار في قلبِه نورٌ]"],"grade":"حسن","narrator":"سهل بن سعد الساعدي","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني (6/185) (5942)، وأبو نعيم في ((حلية الأولياء)) (3/255)، والخطيب في ((تاريخ بغداد)) (9/237) مطولاً","bab":"رقائق وزهد › الإخلاص","dorar":"CiHmWhbJ"},{"id":"س-07855","fp":"520c4a74c8f1","stateId":464,"easy":"إذا عملت عملاً في السر ← يسرّه الله لك يوم القيامة فترى قرة عين","cause":"العبدُ يعمَلُ السِّرَّ","result":"أسَرَّه اللهُ له يومَ القيامةِ فيرى قُرَّةَ أعينٍ","explicit":true,"ref":"مجمع الزوائد 10/220","srcLabel":"الحاكم","text":["قال الرَّبُّ عَزَّ وجَلَّ يؤتى بحسناتِ العبدِ وسيِّئاتِه يومَ القيامةِ فيَقيضُ بعضَها ببعضٍ فإنْ بقِيَتْ حسنةٌ واحدةٌ أدخَله اللهُ الجَنَّةَ قال قلتُ فإنْ لم يبْقَ قال { أُولَئِكَ الَّذِينَ نَتَقَبَّلُ عَنْهُمْ أَحْسَنَ مَا عَمِلُوا وَنَتَجَاوَزُ عَنْ سَيِّئَاتِهِمْ فِي أَصْحَابِ الْجَنَّةِ } قال قلتُ أرأَيْتَ قولَه { فَلَا تَعْلَمُ نَفْسٌ مَا أُخْفِيَ لِهُمْ مِنْ قُرَّةِ أَعْيُنٍ } قال هو ",["العبدُ يعمَلُ السِّرَّ",1]," ",["أسَرَّه اللهُ له يومَ القيامةِ فيرى قُرَّةَ أعينٍ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده جيد","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (12/ 183) (12832)،والحاكم (7641 )، والبيهقي في ((شعب الإيمان)) (6515 )","bab":"قيامة › الحساب والقصاص","dorar":"8OMxOm6Y"},{"id":"س-03335","fp":"d95c71f2cb6b","stateId":465,"easy":"إذا علمت أن النعمة من الله ← يكتب لك شكرها قبل أن تحمده","cause":"ما أنعم اللهُ على عبدٍ نعمةً فعلِم أنَّها من اللهِ","result":"إلَّا كتب اللهُ له شُكرَها قبل أن يحمَدَه عليها وما أذنب عبدٌ ذنبًا فندِم عليه إلَّا كتب اللهُ له مغفرةً قبل أن يستغفِرَه وما اشترَى عبدٌ ثوبًا بدينارٍ أو نصفِ","explicit":true,"otherNeedIds":[11],"ref":"الترغيب والترهيب 3/134","srcLabel":"الحاكم","text":[["ما أنعم اللهُ على عبدٍ نعمةً فعلِم أنَّها من اللهِ",1]," ",["إلَّا كتب اللهُ له شُكرَها قبل أن يحمَدَه عليها وما أذنب عبدٌ ذنبًا فندِم عليه إلَّا كتب اللهُ له مغفرةً قبل أن يستغفِرَه وما اشترَى عبدٌ ثوبًا بدينارٍ أو نصفِ",2]," دينارٍ فلبِسه فحمِد اللهَ عزَّ وجلَّ إلَّا لم يبلُغْ رُكبتَيْه حتَّى يغفِرَ اللهُ له"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن أبي الدنيا في ((الشكر)) (47)، والطبراني في ((المعجم الأوسط)) (4503)، والحاكم (1894) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"coHj7sDm"},{"id":"س-00295","fp":"86d1bb4f7154","stateId":465,"easy":"إذا طعمت وشكرت ← قد تكون أعظم أجراً من صائم صابر","cause":"ربَّ طاعمٍ شاكرٍ","result":"أعظمُ أجرًا من صائمٍ صابرٍ","explicit":true,"ref":"شرح كتاب الشهاب 608","srcLabel":"ابن الأعرابي","text":[["ربَّ طاعمٍ شاكرٍ ",1],["أعظمُ أجرًا من صائمٍ صابرٍ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن الأعرابي في ((معجمه)) (1734)، والقضاعي في ((مسند الشهاب)) (1427).","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"TmO7Eo87"},{"id":"س-01907","fp":"6cc99b16ac19","stateId":465,"easy":"إذا عملت الخير ولو بعيداً ← لن يضيع الله من عملك شيئاً","cause":"فاعمَلْ مِن وراءِ البِحارِ","result":"اللهَ لَن يَتِرَكَ مِن عَمَلِكَ شيئًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"صحيح مسلم 1865","srcLabel":"البخاري","text":["أنَّ أعرابيًّا سَألَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم عَنِ الهِجرةِ، فقال: ويحَكَ، إنَّ شَأنَ الهِجرةِ لَشَديدٌ، فهل لكَ مِن إبِلٍ؟ قال: نَعَم، قال: فهل تُؤتي صَدَقَتَها؟ قال: نَعَم، قال: ",["فاعمَلْ مِن وراءِ البِحارِ",1],"؛ فإنَّ ",["اللهَ لَن يَتِرَكَ مِن عَمَلِكَ شيئًا",2],". وفي روايةٍ: غيرَ أنَّه قال: إنَّ اللهَ لَن يَتِرَكَ مِن عَمَلِكَ شيئًا. وزادَ في الحَديثِ قال: فهل تَحلُبُها يَومَ وِردِها؟ قال: نَعَم."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6165) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"I7FHXcTe","merged":3,"otherRefs":["تخريج المسند لشعيب 11105 (صحيح)","تخريج المسند لشعيب 11108 (صحيح)"]},{"id":"ق-0053","fp":"86a269cf721e","stateId":465,"easy":"التطوع بالخير ← شكر الله له","cause":"التطوع بالخير","result":"شكر الله له","explicit":true,"star":true,"ref":"سورة البقرة: 158","srcLabel":"القرآن الكريم","quran":{"s":2,"from":158,"to":158,"text":"إِنَّ الصَّفَا وَالْمَرْوَةَ مِنْ شَعَائِرِ اللَّهِ فَمَنْ حَجَّ الْبَيْتَ أَوِ اعْتَمَرَ فَلَا جُنَاحَ عَلَيْهِ أَنْ يَطَّوَّفَ بِهِمَا وَمَنْ تَطَوَّعَ خَيْرًا فَإِنَّ اللَّهَ شَاكِرٌ عَلِيمٌ (158)","hl":[[137,193,1]]}},{"id":"ق-0254","fp":"fea48c70fcee","stateId":465,"easy":"فعل الخير ← يعلمه الله ويجازي به","cause":"فعل الخير","result":"يعلمه الله ويجازي به","explicit":true,"star":true,"ref":"سورة النساء: 127","srcLabel":"القرآن الكريم","quran":{"s":4,"from":127,"to":127,"text":"وَيَسْتَفْتُونَكَ فِي النِّسَاءِ قُلِ اللَّهُ يُفْتِيكُمْ فِيهِنَّ وَمَا يُتْلَى عَلَيْكُمْ فِي الْكِتَابِ فِي يَتَامَى النِّسَاءِ اللَّاتِي لَا تُؤْتُونَهُنَّ مَا كُتِبَ لَهُنَّ وَتَرْغَبُونَ أَنْ تَنْكِحُوهُنَّ وَالْمُسْتَضْعَفِينَ مِنَ الْوِلْدَانِ وَأَنْ تَقُومُوا لِلْيَتَامَى بِالْقِسْطِ وَمَا تَفْعَلُوا مِنْ خَيْرٍ فَإِنَّ اللَّهَ كَانَ بِهِ عَلِيمًا (127)","hl":[[294,358,1]]}},{"id":"ق-0901","fp":"244b1d79b30d","stateId":465,"easy":"شكر فضل الله ← نفعه لنفسه","cause":"شكر فضل الله","result":"نفعه لنفسه","explicit":true,"similar":["ق-0972"],"otherNeedIds":[1],"ref":"سورة النمل: 40","srcLabel":"القرآن الكريم","quran":{"s":27,"from":40,"to":40,"text":"قَالَ الَّذِي عِنْدَهُ عِلْمٌ مِنَ الْكِتَابِ أَنَا آتِيكَ بِهِ قَبْلَ أَنْ يَرْتَدَّ إِلَيْكَ طَرْفُكَ فَلَمَّا رَآهُ مُسْتَقِرًّا عِنْدَهُ قَالَ هَذَا مِنْ فَضْلِ رَبِّي لِيَبْلُوَنِي أَأَشْكُرُ أَمْ أَكْفُرُ وَمَنْ شَكَرَ فَإِنَّمَا يَشْكُرُ لِنَفْسِهِ وَمَنْ كَفَرَ فَإِنَّ رَبِّي غَنِيٌّ كَرِيمٌ (40)","hl":[[141,255,1]]}},{"id":"ق-0934","fp":"49972af0d153","stateId":465,"easy":"المجاهدة ← نفعها للنفس","cause":"المجاهدة","result":"نفعها للنفس","explicit":true,"ref":"سورة العنكبوت: 6","srcLabel":"القرآن الكريم","quran":{"s":29,"from":6,"to":6,"text":"وَمَنْ جَاهَدَ فَإِنَّمَا يُجَاهِدُ لِنَفْسِهِ إِنَّ اللَّهَ لَغَنِيٌّ عَنِ الْعَالَمِينَ (6)","hl":[[0,89,1]]}},{"id":"ق-0964","fp":"55fa05b2d03b","stateId":465,"easy":"العمل الصالح ← يمهّد لنفسه ويجزيه الله من فضله","cause":"العمل الصالح","result":"يمهّد لنفسه ويجزيه الله من فضله","explicit":true,"ref":"سورة الروم: 44–45","srcLabel":"القرآن الكريم","quran":{"s":30,"from":44,"to":45,"text":"مَنْ كَفَرَ فَعَلَيْهِ كُفْرُهُ وَمَنْ عَمِلَ صَالِحًا فَلِأَنْفُسِهِمْ يَمْهَدُونَ (44) لِيَجْزِيَ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ مِنْ فَضْلِهِ إِنَّهُ لَا يُحِبُّ الْكَافِرِينَ (45)","hl":[[32,156,1]]}},{"id":"ق-0972","fp":"bd512555162c","stateId":465,"easy":"الشكر ← نفعه لنفسه","cause":"الشكر","result":"نفعه لنفسه","explicit":true,"repOf":"ق-0901","otherNeedIds":[1],"ref":"سورة لقمان: 12","quran":{"s":31,"from":12,"to":12,"text":"وَلَقَدْ آتَيْنَا لُقْمَانَ الْحِكْمَةَ أَنِ اشْكُرْ لِلَّهِ وَمَنْ يَشْكُرْ فَإِنَّمَا يَشْكُرُ لِنَفْسِهِ وَمَنْ كَفَرَ فَإِنَّ اللَّهَ غَنِيٌّ حَمِيدٌ (12)","hl":[[61,108,1]]}},{"id":"ق-1184","fp":"6808c92f8c52","stateId":465,"easy":"العمل الصالح ← نفعه لنفسه","cause":"العمل الصالح","result":"نفعه لنفسه","explicit":true,"ref":"سورة الجاثية: 15","srcLabel":"القرآن الكريم","quran":{"s":45,"from":15,"to":15,"text":"مَنْ عَمِلَ صَالِحًا فَلِنَفْسِهِ وَمَنْ أَسَاءَ فَعَلَيْهَا ثُمَّ إِلَى رَبِّكُمْ تُرْجَعُونَ (15)","hl":[[0,34,1]]}},{"id":"ق-1275","fp":"361deb9e69fc","stateId":465,"easy":"السعي ← يُرى ويُجزى الجزاء الأوفى","cause":"السعي","result":"يُرى ويُجزى الجزاء الأوفى","explicit":true,"ref":"سورة النجم: 39–41","srcLabel":"القرآن الكريم","quran":{"s":53,"from":39,"to":41,"text":"وَأَنْ لَيْسَ لِلْإِنْسَانِ إِلَّا مَا سَعَى (39) وَأَنَّ سَعْيَهُ سَوْفَ يُرَى (40) ثُمَّ يُجْزَاهُ الْجَزَاءَ الْأَوْفَى (41)","hl":[[0,122,1]]}},{"id":"ق-1453","fp":"4b32ad2ef5d0","stateId":465,"easy":"عمل مثقال ذرة خيراً ← يراه","cause":"عمل مثقال ذرة خيراً","result":"يراه","explicit":true,"ref":"سورة الزلزلة: 7","srcLabel":"القرآن الكريم","quran":{"s":99,"from":7,"to":7,"text":"فَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُ (7)","hl":[[0,48,1]]}},{"id":"س-03053","fp":"6e97f1fe6dc9","stateId":465,"easy":"إذا عملت عملاً وعدك الله عليه ثواباً ← فهو منجزه لك","cause":"من وعدَه اللهُ على عمل ثوابًا","result":"فهو مُنجِزُه له","explicit":true,"ref":"السلسلة الصحيحة 2463","srcLabel":"ابن أبي عاصم","text":[["من وعدَه اللهُ على عمل ثوابًا",1]," ، ",["فهو مُنجِزُه له",2]," ، و من وعدَه على عملٍ عقابًا فهو فيه بالخيارِ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"ثابت","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (960)، والبزار (6882)، وأبو يعلى (3316)","bab":"إيمان › الوعيد","dorar":"ijCh1t0k"},{"id":"س-04570","fp":"bac33f0ab8ae","stateId":465,"easy":"إذا أحسنت ← يثيبك الله مسلماً كنت أو كافراً","cause":"ما أحْسَنَ مُحسِنٌ مِن مُسلمٍ ولا كافرٍ","result":"إلَّا أثابَهُ اللهُ","explicit":true,"otherNeedIds":[1],"ref":"المستدرك على الصحيحين 3042","srcLabel":"ابن شاهين","text":["«",["ما أحْسَنَ مُحسِنٌ مِن مُسلمٍ ولا كافرٍ",1]," ",["إلَّا أثابَهُ اللهُ",2],"» قالَ: فقُلنا: يا رسولَ اللهِ، ما إثابَةُ الكافرِ؟ قالَ: «إنْ كان قد وَصَلَ رَحِمًا، أوْ تَصدَّقَ بصَدَقَةٍ أوْ عَمِلَ حَسَنةً أثابَهُ اللهُ المالَ والولَدَ والصِّحَّةَ وأشْباهَ ذلك». قالَ: فقلنا: ما إثابَتُه في الآخِرَةِ؟ فقالَ: «عَذابًا دون العَذابِ», قالَ: وقَرَأَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: {أَدْخِلُوا آلَ فِرْعَوْنَ أَشَدَّ الْعَذَابِ} [غافر: 46]. هكذا قرَأَهُ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ مَقْطوعةَ الألفِ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن شاهين في ((الترغيب)) (529) بلفظه، والبزار (1454)، والخرائطي في ((مكارم الأخلاق)) (132) كلاهما بلفظ مقارب.","bab":"جهنم › صفة عذاب أهل النار","dorar":"6FXwlrHe"},{"id":"س-01917","fp":"3e0392df0a8a","stateId":465,"easy":"إذا عملت خيراً ← يجزيك الله به","cause":"ما عمِلتَ مِن خَيرٍ","result":"جزَيتُكَ به","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-03473"],"ref":"حلية الأولياء 6/185","srcLabel":"الطبراني","text":["عن النبيِّ صلَّى اللهُ عليه وسلَّمَ فيما يَرْوي عن ربِّه عزَّ وجلَّ قال: أربعُ خِصالٍ؛ واحدةٌ فيما بيني وبينَكَ، وواحدةٌ فيما بينَكَ وبينَ عبادي، وواحدةٌ لي، وواحدةٌ لكَ. فأمَّا التي لي: فتَعبُدُني لا تشرِكُ بي شيئًا، وأمَّا التي لكَ عليَّ: ف",["ما عمِلتَ مِن خَيرٍ",1]," ",["جزَيتُكَ به",2],"، وأمَّا التي بيني وبينَكَ: فمِنكَ الدُّعاءُ، وعليَّ الإجابةُ، وأمَّا التي بينَكَ وبينَ عبادي تَرْضى لهم ما تَرْضى لنفْسِكَ."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"غريب من حديث الحسن تفرد به عنه صالح مرفوعا","takhrij":"أخرجه أبو يعلى (2757) بلفظه، والطبراني في ((الدعاء)) (16)، والبيهقي في ((شعب الإيمان)) (10671) كلاهما باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"TsvlE0Cn"},{"id":"س-03473","fp":"a0c84c18ad65","stateId":465,"easy":"إذا عملت عملاً ← يجزيك الله به","cause":"فما عملتَ منْ عملٍ","result":"جزيتُك بهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-01917","ref":"الجامع الصغير 6050","text":["قالَ اللهُ تعالى : يا ابنَ آدمَ ! ثلاثةٌ : واحدةٌ لي، وواحدةٌ لكَ، وواحدةٌ بيني وبينكَ . فأمَّا التي لي ؛ فتعبدُني لا تشركْ بي شيئًا، وأما التي لك ؛ ",["فما عملتَ منْ عملٍ",1]," ",["جزيتُك بهِ",2]," ؛ فإنْ أَغْفِرْ فأنا الغفورُ الرحيمُ، وأما التي بيني وبينكَ، فعليكَ الدعاءُ والمسألةُ، وعليَّ الاستجابةُ"],"grade":"حسن","narrator":"سلمان الفارسي","muhaddith":"حسن","takhrij":"أخرجه البزار (2523) والطبراني (6137) (6/ 253) والبيهقي في ((الأسماء والصفات)) (438) باختلاف يسير.","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"1eEbnlw4"},{"id":"س-07281","fp":"ec6ce5f222cb","stateId":466,"easy":"إذا عملت صالحاً في زمن الصبر ← فلك أجر خمسين رجلاً يعملون مثلك","cause":"للعاملِ فيهم","result":"أجرِ خمسينَ رجُلًا يعمَلونَ مِثلَ عمَلِه","explicit":true,"otherNeedIds":[49],"ref":"تخريج سنن أبي داود 4341","srcLabel":"الترمذي","text":["سألتُ أبا ثَعْلبةَ الخُشَنيَّ، فقلتُ: يا أبا ثَعْلبةَ، كيفَ تقولُ في هذه الآيةِ: {عَلَيْكُمْ أَنْفُسَكُمْ}؟ [المائدة: 105]، قال: أمَا واللهِ لقد سألتَ عنها خبيرًا، سألتُ عنها رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فقال: بل ائتَمِروا بالمعروفِ، وتناهَوْا عن المنكَرِ، حتى إذا رأيتَ شُحًّا مُطاعًا، وهوًى مُتَّبعًا، ودُنْيا مُؤثَرةً، وإعجابَ كلِّ ذي رأيٍ برأيِه، فعليكَ -يعني: بنفسِك- ودَعْ عنك العَوامَّ، فإنَّ من ورائِكم أيامَ الصبرِ، الصبرُ فيه مِثلُ قَبضٍ على الجمرِ، ",["للعاملِ فيهم",1]," مِثلُ ",["أجرِ خمسينَ رجُلًا يعمَلونَ مِثلَ عمَلِه",2],". وزادَني غيرُه: قال: يا رسولَ اللهِ: أجرُ خمسينَ منهم؟ قال: أجرُ خمسينَ منكم."],"grade":"حسن","narrator":"أبو ثعلبة الخشني","muhaddith":"حسن","takhrij":"أخرجه الترمذي (3058)، وابن ماجه (4014) باختلاف يسير","bab":"فتن › ظهور الفتن","dorar":"Hfng40xF"},{"id":"س-06031","fp":"7ecdba4524b7","stateId":466,"easy":"إذا عملت صالحاً في أيام الفتن والغربة ← فلك أجر خمسين رجلاً يعملون مثلك","cause":"للعاملِ فيهنَّ","result":"أجرِ خمسين رجلًا يعملون مثلَ عملِه","explicit":true,"star":true,"otherNeedIds":[49],"ref":"الترغيب والترهيب 4/132","srcLabel":"أبو داود","text":["في هذه الآيةِ :  عَلَيْكُمْ أَنْفُسَكُمْ  ؟ قال : أما واللهِ لقد سألتُ عنها خبيرًا ، سألتُ عنها رسولَ اللهِ صلَّى اللهُ عليه وسلَّم فقال : ائتمِروا بالمعروفِ ، وانتَهوا عن المنكرِ حتَّى إذا رأيتَ شُحًّا مُطاعًا وهوًى مُتَّبَعًا ودنيا مؤثِّرةً وإعجابَ كلِّ ذي رأيٍ برأيِه ، فعليك بنفسِك ، ودَعْ عنك العوامَ ، فإنَّ من ورائِكم أيَّامًا ، الصَّبرُ فيهنَّ مثلُ القبضِ على الجمرِ ",["للعاملِ فيهنَّ",1]," مثلُ ",["أجرِ خمسين رجلًا يعملون مثلَ عملِه",2]],"grade":"صحيح","narrator":"أبو ثعلبة الخشني","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (4341)، والترمذي (3058)، وابن ماجه (4014) باختلاف يسير","bab":"رقائق وزهد › فضل الصبر","dorar":"tCaDWGwI","merged":2,"otherRefs":["هداية الرواة 4/486 (حسن)"]},{"id":"س-03730","fp":"6ef2a27aadc2","stateId":466,"easy":"إذا اقتصدت في السنة ← فهو خير من الاجتهاد في البدعة","cause":"القصدُ في السُّنَّةِ","result":"خيرٌ من الاجتهادِ في البدعةِ","explicit":true,"ref":"صلاة التراويح 7","srcLabel":"صلاة التراويح","text":["قال عبدُ اللهِ بنُ مسعودٍ : ",["القصدُ في السُّنَّةِ ",1],["خيرٌ من الاجتهادِ في البدعةِ ",2],"."],"grade":"صحيح","muhaddith":"صحيح","bab":"اعتصام بالسنة › لزوم السنة","dorar":"4xkxHFVs"},{"id":"س-03738","fp":"e47093bfed14","stateId":466,"easy":"إذا تمسكت بالسنة عند فساد الأمة ← فلك أجر مئة شهيد","cause":"مَن تمسَّكَ بسنَّتي عندَ فسادِ أمَّتي","result":"فلهُ أجرُ مِائةِ شَهيدٍ","explicit":true,"otherNeedIds":[62],"ref":"الترغيب والترهيب 1/61","srcLabel":"البيهقي","text":[["مَن تمسَّكَ بسنَّتي عندَ فسادِ أمَّتي ",1],["فلهُ أجرُ مِائةِ شَهيدٍ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (2/327)، والبيهقي في ((الزهد الكبير)) (207)، وابن بشران في ((الأمالي)) (501)","bab":"اعتصام بالسنة › لزوم السنة","dorar":"XYZg8NgR"}]}