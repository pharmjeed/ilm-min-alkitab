{"schema":1,"kind":"sunan-chunk","version":"sunan-3f5fd6b9930a","needId":69,"stateIds":[730,731,732,733,734,735,736,737,738,739,740,741,742,743,744,745],"items":[{"id":"س-03009","fp":"ebe81335b454","stateId":730,"easy":"إذا مت وأنت تجعل لله نداً ← يدخلك الله النار","cause":"مَن مات وهو يَجعَلُ للهِ نِدًّا","result":"أدخَلَه اللهُ النَّارَ","explicit":true,"star":true,"similar":["س-04202","س-04238","س-04189"],"ref":"تخريج المسند لشعيب 4425","srcLabel":"متفق عليه","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ كَلِمةً، وأنا أقولُ أخرى؛ ",["مَن مات وهو يَجعَلُ للهِ نِدًّا، ",1],["أدخَلَه اللهُ النَّارَ",2],"، قال: وقال عبدُ اللهِ: وأنا أقولُ: مَن مات وهو لا يَجعَلُ للهِ نِدًّا، أدخَلَه اللهُ الجنَّةَ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (1238)، ومسلم (92) بنحوه، وأحمد (4425) واللفظ له","bab":"إيمان › الوعيد","dorar":"wFSNmwQS"},{"id":"س-04202","fp":"892df83ca96d","stateId":730,"easy":"إذا جعلت لله نداً ← يجعلك الله في النار","cause":"مَن جعَلَ للهِ نِدًّا","result":"جعَلَه اللهُ في النَّارِ","explicit":true,"repOf":"س-03009","ref":"تخريج المسند لشعيب 3865","text":["\"",["مَن جعَلَ للهِ نِدًّا؛ ",1],["جعَلَه اللهُ في النَّارِ\"",2],"، قال: وأُخرى أَقولُها، لم أسمَعْها منه: ومَن مات لا يجعَلُ للهِ نِدًّا؛ أدخَلَه اللهُ عزَّ وجلَّ الجنَّةَ، وإنَّ هذه الصَّلَواتِ كَفَّاراتٌ لما بينهنَّ ما اجتُنِبَ المَقتَلُ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6683) باختلاف يسير دون قوله: \"وإنَّ هذه الصَّلَواتِ كَفَّاراتٌ ...\"، ومسلم (92) بنحوه دون قوله: \"وإنَّ هذه الصَّلَواتِ كَفَّاراتٌ ...\"","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"R7EZbax3"},{"id":"س-04235","fp":"b6c1d90e764b","stateId":730,"easy":"إذا لقيت الله تشرك به ← يدخلك النار","cause":"لا يلقى اللهَ عبدٌ يُشرِك به","result":"إلَّا أدخَله النَّارَ وأنا أقولُ لا يلقى اللهَ عبدٌ لم يُشرِكْ به إلَّا أدخَله الجنَّةَ","explicit":true,"star":true,"similar":["س-03033","س-04199"],"ref":"تخريج صحيح ابن حبان 251","srcLabel":"متفق عليه","text":["كلمتانِ سمِعْتُ إحداهما مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم والأخرى أنا أقولُها، سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( ",["لا يلقى اللهَ عبدٌ يُشرِك به",1]," ",["إلَّا أدخَله النَّارَ وأنا أقولُ لا يلقى اللهَ عبدٌ لم يُشرِكْ به إلَّا أدخَله الجنَّةَ )",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (1238)، ومسلم (92) بلفظ مقارب","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"4HDEhcHq"},{"id":"س-04238","fp":"389691306dde","stateId":730,"easy":"إذا مت وأنت تجعل لله نداً ← دخلت النار","cause":"مَن مات وهو يجعَلُ للهِ نِدًّا","result":"دخَلَ النَّارَ، وأنا أقولُ","explicit":true,"repOf":"س-03009","ref":"تخريج المسند لشعيب 3552","text":["خَصْلتانِ -يعني إحداهما- سمِعْتُها مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، والأُخرى مِن نفْسي: \"",["مَن مات وهو يجعَلُ للهِ نِدًّا؛ ",1],["دخَلَ النَّارَ\"، وأنا أقولُ: ",2],"مَن مات وهو لا يَجعَلُ للهِ نِدًّا، ولا يُشرِكُ به شيئًا؛ دخَلَ الجنَّةَ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (1238)، ومسلم (92) بنحوه، وأحمد (3552) واللفظ له","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"A1nAA2XS"},{"id":"س-03033","fp":"971ab0a10e0c","stateId":730,"easy":"إذا لقيت الله تشرك به ← يدخلك النار","cause":"ومَن لَقِيَه يُشرِكُ به","result":"أدخَلَه النَّارَ","explicit":true,"repOf":"س-04235","ref":"مجموع رسائل العلائي 1/165","text":["مَن لَقِيَ اللهَ عزَّ وجلَّ لا يُشرِكُ به شَيئًا أدْخَلَه الجَنَّةَ، ",["ومَن لَقِيَه يُشرِكُ به ",1],["أدخَلَه النَّارَ",2],"."],"grade":"صحيح","narrator":"جابر","muhaddith":"إسناده على شرط مسلم","bab":"إيمان › الوعيد","dorar":"QQoyEuBE"},{"id":"س-04189","fp":"4f684f5d89fb","stateId":730,"easy":"إذا مت تجعل لله نداً ← أُدخلت النار","cause":"مَن ماتَ يَجعَلُ للَّهِ نِدًّا","result":"أُدخِلَ النَّارَ","explicit":true,"repOf":"س-03009","otherNeedIds":[22],"ref":"صحيح البخاري 6683","text":["قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم كَلِمةً، وقُلتُ أُخرى: ",["مَن ماتَ يَجعَلُ للَّهِ نِدًّا",1]," ",["أُدخِلَ النَّارَ",2],"، وقُلتُ أُخرى: مَن ماتَ لا يَجعَلُ للَّهِ نِدًّا أُدخِلَ الجَنَّةَ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (92) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"iQUU9FH0"},{"id":"س-04199","fp":"c0582af015d2","stateId":730,"easy":"إذا لقيت الله وأنت تشرك ← دخلت النار","cause":"ومَنْ لَقِيَ اللهَ عزَّ وجلَّ وهو يُشْرِكُ","result":"دَخَلَ النَّارَ","explicit":true,"repOf":"س-04235","ref":"تخريج المسند لشعيب 14711","text":["الموجِبَتانِ: مَنْ لَقِيَ اللهَ عزَّ وجَلَّ ولا يُشرِكُ به شَيئًا، دَخَلَ الجَنَّةَ، ",["ومَنْ لَقِيَ اللهَ عزَّ وجلَّ وهو يُشْرِكُ، ",1],["دَخَلَ النَّارَ",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه مسلم (93)، وأحمد (14711) واللفظ له","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"OmmbRwyz"},{"id":"س-04269","fp":"23d4266e7a26","stateId":730,"easy":"إذا مت تدعو من دون الله نداً ← دخلت النار","cause":"مَن ماتَ وهو يَدعو مِن دونِ اللهِ نِدًّا","result":"دَخَلَ النَّارَ، وقُلتُ أنا","explicit":true,"ref":"صحيح البخاري 4497","srcLabel":"مسلم","text":["قال النَّبيُّ صلَّى اللهُ عليه وسلَّم كَلِمةً وقُلتُ أُخرى، قال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ",["مَن ماتَ وهو يَدعو مِن دونِ اللهِ نِدًّا ",1],["دَخَلَ النَّارَ، وقُلتُ أنا: ",2],"مَن ماتَ وهو لا يَدعو للَّهِ نِدًّا دَخَلَ الجَنَّةَ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (92) بلفظ مقارب","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"H3qNJxlM"},{"id":"ق-0709","fp":"ba28b3e97d53","stateId":730,"easy":"الشرك بالله ← الإلقاء في جهنم ملوماً مدحوراً","cause":"الشرك بالله","result":"الإلقاء في جهنم ملوماً مدحوراً","explicit":true,"ref":"سورة الإسراء: 39","srcLabel":"القرآن الكريم","quran":{"s":17,"from":39,"to":39,"text":"ذَلِكَ مِمَّا أَوْحَى إِلَيْكَ رَبُّكَ مِنَ الْحِكْمَةِ وَلَا تَجْعَلْ مَعَ اللَّهِ إِلَهًا آخَرَ فَتُلْقَى فِي جَهَنَّمَ مَلُومًا مَدْحُورًا (39)","hl":[[56,141,1]]}},{"id":"ق-0787","fp":"ea5bccbd77e5","stateId":730,"easy":"ادعاء الألوهية والظلم ← جهنم","cause":"ادعاء الألوهية والظلم","result":"جهنم","explicit":true,"ref":"سورة الأنبياء: 29","srcLabel":"القرآن الكريم","quran":{"s":21,"from":29,"to":29,"text":"وَمَنْ يَقُلْ مِنْهُمْ إِنِّي إِلَهٌ مِنْ دُونِهِ فَذَلِكَ نَجْزِيهِ جَهَنَّمَ كَذَلِكَ نَجْزِي الظَّالِمِينَ (29)","hl":[[0,109,1]]}},{"id":"ق-1073","fp":"dd24d2534d60","stateId":730,"easy":"نسيان الله عند النعمة والشرك بعد كشف الضر ← أصحاب النار","cause":"نسيان الله عند النعمة والشرك بعد كشف الضر","result":"أصحاب النار","explicit":true,"ref":"سورة الزمر: 8","srcLabel":"القرآن الكريم","quran":{"s":39,"from":8,"to":8,"text":"وَإِذَا مَسَّ الْإِنْسَانَ ضُرٌّ دَعَا رَبَّهُ مُنِيبًا إِلَيْهِ ثُمَّ إِذَا خَوَّلَهُ نِعْمَةً مِنْهُ نَسِيَ مَا كَانَ يَدْعُو إِلَيْهِ مِنْ قَبْلُ وَجَعَلَ لِلَّهِ أَنْدَادًا لِيُضِلَّ عَنْ سَبِيلِهِ قُلْ تَمَتَّعْ بِكُفْرِكَ قَلِيلًا إِنَّكَ مِنْ أَصْحَابِ النَّارِ (8)","hl":[[0,268,1]]}},{"id":"س-04231","fp":"bd4af8d14d32","stateId":730,"easy":"إذا مت تشرك بالله ← دخلت النار","cause":"ومَن مات وهو يُشرِكُ باللهِ","result":"دخَل النَّارَ","explicit":true,"similar":["س-03066"],"ref":"تخريج صحيح ابن حبان 6171","srcLabel":"ابن حبان","text":["النَّاسُ أربعةٌ والأعمالُ ستَّةٌ مُوجبتانِ ومِثْلٌ بمِثْلٍ وحسَنةٌ بعَشْرِ أمثالِها وحسَنةٌ بسَبْعِمئةِ ضِعْفٍ والنَّاسُ موسَّعٌ عليه في الدُّنيا والآخرةِ وموسَّعٌ عليه في الدُّنيا مَقتورٌ عليه في الآخرةِ ومَقتورٌ عليه في الدُّنيا موسَّعٌ عليه في الآخرةِ ومَقتورٌ عليه في الدُّنيا والآخرةِ وشَقيٌّ في الدُّنيا وشَقيٌّ في الآخرةِ والمُوجِبتانِ : مَن قال لا إلهَ إلَّا اللهُ أو قال : مؤمنًا باللهِ دخَل الجنَّةَ ",["ومَن مات وهو يُشرِكُ باللهِ ",1],["دخَل النَّارَ",2]," ومَن هَمَّ بحسَنةٍ فعمِلها كُتِبَتْ له عَشَرةُ أمثالِها ومَن هَمَّ بحسَنةٍ فلم يعمَلْها كُتِبَتْ له حسَنةٌ ومَن هَمَّ بسيِّئةٍ فلم يعمَلْها كُتِبَتْ له حسَنةٌ ومَن هَمَّ بسيِّئةٍ فعمِلها كُتِبَتْ له سيِّئةٌ واحدةٌ غيرُ مضعَّفةٍ ومَن أنفَق نفقةً فاضلةً في سبيلِ اللهِ فبِسَبْعِمِئةِ ضِعْفٍ"],"grade":"صحيح","narrator":"خريم بن فاتك الأسدي","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (6171) واللفظ له، وابن أبي شيبة في ((مسنده)) (743)، وابن ابي عاصم في ((الآحاد والمثاني)) (1047)، والطبراني (4/ 205)(4151) جميعهم باختلاف يسير .","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"0BwkAjc5","merged":4,"otherRefs":["تخريج المسند لشاكر 5/223 (صحيح)","تخريج المسند لشعيب 4232 (صحيح)","مجمع الزوائد 1/26 (صحيح)"]},{"id":"س-03066","fp":"cff6c0475377","stateId":730,"easy":"إذا مت تشرك بالله ← تدخل النار ويحرم الله عليك الجنة","cause":"إنَّ من مات يُشركُ باللهِ","result":"دخل النارَ وحرَّمَ اللهُ عليهِ الجنةَ ومأواهُ النارُ","explicit":true,"repOf":"س-04231","otherNeedIds":[71],"ref":"عارضة الأحوذي 2/300","text":[["إنَّ من مات يُشركُ باللهِ",1]," ",["دخل النارَ وحرَّمَ اللهُ عليهِ الجنةَ ومأواهُ النارُ",2]],"grade":"صحيح","muhaddith":"ثابت","bab":"إيمان › الوعيد","dorar":"6NPYUg99"},{"id":"س-04308","fp":"9b534993d230","stateId":730,"easy":"إذا جعلت مع الله إلهاً آخر أو كنت جباراً أو قتلت نفساً بغير حق ← تنطلق بك النار","cause":"بمَن جَعَل مَعَ اللهِ إلهًا آخَرَ، وبكُلِّ جَبَّارٍ عنيدٍ، ومَن قَتَل نَفسًا بغَيرِ نَفسٍ","result":"فتَنطَلقُ بهم قَبلَ سائِرِ النَّاسِ بخَمسِمائةِ عامٍ","explicit":true,"similar":["س-05738"],"ref":"يقظة أولي الاعتبار 140","srcLabel":"أحمد","text":["يَخرُجُ عُنُقٌ مِنَ النَّارِ يَومَ القيامةِ فيُكَلِّمُ بلسانٍ طَلقٍ ذَلقٍ، لها عَينانِ تُبصِرُ بهما، ولها لسانٌ تَكَلَّمُ به، فيَقولُ: إنِّي أُمِرتُ ",["بمَن جَعَل مَعَ اللهِ إلهًا آخَرَ، وبكُلِّ جَبَّارٍ عنيدٍ، ومَن قَتَل نَفسًا بغَيرِ نَفسٍ",1],"، ",["فتَنطَلقُ بهم قَبلَ سائِرِ النَّاسِ بخَمسِمائةِ عامٍ.",2]," وفي رِوايةٍ: فتَنطَوي عليهم فتَقذِفُهم في جَهَنَّمَ"],"grade":"صحيح","narrator":"أبو سعيد","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (11354)، وابن أبي شيبة (35278)، وأبو يعلى (1146) بنحوه.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"yL8EqKit"},{"id":"س-05738","fp":"3f93932bea1a","stateId":730,"easy":"إذا كنت جباراً أو جعلت مع الله إلهاً أو قتلت نفساً ← يخرج عنق من النار يلتقطك","cause":"بكلِّ جبَّارٍ، وبمَن جعَل مع اللهِ إلَهًا آخَرَ، وبمَن قتَل نفْسًا بغيرِ نفْسٍ","result":"يَخرُجُ عُنُقٌ منَ النَّارِ","explicit":true,"repOf":"س-04308","ref":"تخريج المسند لشعيب 11354","text":["\"",["يَخرُجُ عُنُقٌ منَ النَّارِ",2]," يتكَلَّمُ يقولُ: وُكِّلتُ اليومَ بثلاثةٍ: ",["بكلِّ جبَّارٍ، وبمَن جعَل مع اللهِ إلَهًا آخَرَ، وبمَن قتَل نفْسًا بغيرِ نفْسٍ",1],"، فيَنْطَوي عليهم، فيَقذِفُهم في غَمَراتِ جَهَنَّمَ\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"بعضه صحيح لغيره","takhrij":"أخرجه أحمد (11354) واللفظ له، وابن أبي شيبة (35278)، وعبد بن حميد (894)","bab":"رقائق وزهد › الكبر والتواضع","dorar":"qLoo1zv4"},{"id":"س-03860","fp":"a4528d119627","stateId":730,"easy":"إذا بقيت على الشرك ← تكون حصباً للنار","cause":"وإِنَّا نَرْغَبُ بِكَ عَمَّا أَنْتَ فِيهِ","result":"أنْ تَكُونَ حَصَبًا لِلنَّارِ غَدًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[22],"ref":"مجمع الزوائد 6/45","srcLabel":"أحمد","text":["خَرَجْنَا في حُجَّاجِ قَوْمِنَا من المُشْرِكِينَ وقَدْ صَلَّيْنَا فُقِّهْنَا معنا البراءُ بنُ مَعْرُورٍ كبيرُنَا وسَيِّدُنَا فَلمَّا تَوَجَّهْنَا لِسَفَرِنَا وخَرَجْنَا من المَدِينَةِ قال البَرَاءُ لنا يا هؤلاءِ إنِّي قَدْ رَأَيْتُ - واللهِ - رَأْيًا وإِنِّي - واللهِ - ما أَدْرِي تُوَافِقُونِي عليْه أَمْ لا ؟ قُلْنَا لَهُ ومَا ذَاكَ؟ قال إنِّي قَدْ رَأَيْتُ أنْ لا أَدَعَ هذه البِنْيَةَ مِنِّي بِظَهْرٍ - يَعْنِي الكَعْبَةَ - وأَنْ أُصَلِّيَ إِلَيْهَا قال فَقُلْنَا واللهِ ما بَلَغَنَا أَنَّ نَبِيَّنَا صلَّى اللهُ عليه وسلَّمَ يُصَلِّي إِلَّا إلى الشَّامِ ومَا نُرِيدُ أنْ نُخالِفَهُ قال فَقُلْنَا لَكِنَّا لا نَفْعَلُ قال وكُنَّا إِذَا حَضَرَتِ الصَّلَاةُ صَلَّيْنَا إلى الشَّامِ وصَلَّى إلى الكَعْبَةِ حتى قَدِمْنَا مَكَّةَ قال أَخِي وقَدْ كُنَّا قَدْ عَتَبْنَا عليْه ما صَنَعَ وأَبَى إِلَّا الإِقَامَةَ عليْه فَلمَّا قَدِمْنَا مَكَّةَ قال يا ابنَ أَخِي انْطَلِقْ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ حتى أَسْأَلَهُ عَمَّا صَنَعْتُ في سَفَرِي هذا فَإِنَّهُ واللهِ قَدْ وقَعَ في نَفْسِي مِنْهُ شيءٌ لِمَا رَأَيْتُ من خِلَافِكُمْ إِيَّايَ فِيهِ قال فَخَرَجْنَا نَسْأَلُ عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وكُنَّا لا نَعْرِفُهُ لَمْ نَرَهُ من قَبْلُ فَلَقِيَنَا رَجُلٌ من أَهْلِ مَكَّةَ فَسَأَلْنَاهُ عن رسولِ اللهِ صَلَّى اللهُ عليْه وسَلَّمَ فقال هل تَعْرِفَانِهِ؟ قُلْنَا لا قال فهل تَعْرِفَانِ العَبَّاسَ بنَ عَبْدِ المُطَّلِبِ عَمَّهُ؟ قُلْنَا نَعَمْ قال وقَدْ كُنَّا نَعْرِفُ العَبَّاسَ كَانَ لا يَزَالُ يَقْدَمُ عَلَيْنَا تاجِرًا قال فَادْخُلَا المَسْجِدَ فَهُوَ الرَّجُلُ الجَالِسُ مع العَبَّاسِ قال فَدَخَلْنَا المَسْجِدَ فإذا العَبَّاسُ جَالِسٌ ورَسُولُ اللهِ صلَّى اللهُ عليه وسلَّمَ مَعَهُ جَالِسٌ فَسَلَّمْنَا ثمَّ جَلَسْنَا إليه فقال النبيُّ صلَّى اللهُ عليه وسلَّمَ لِلْعَبَّاسِ هل تَعْرِفُ هَذَيْنِ الرَّجُلَيْنِ يا أَبا الفَضْلِ؟ قال نَعَمْ هذا البَرَاءُ بنُ مَعْرُورٍ سَيِّدُ قَوْمِهِ وهَذَا كَعْبُ بنُ مَالِكٍ قال فَوَاللَّهِ ما أَنْسَى قَوْلَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ الشَّاعِرُ؟ قال نَعَمْ قال فقال البَرَاءُ بنُ مَعْرُورٍ يا نَبِيَّ اللهِ إنِّي خَرَجْتُ في سَفَرِي هذا وقَدْ هَدَانِي اللهُ لِلْإِسْلَامِ فَجَعَلْتُ لا أَجْعَلُ هذه البِنْيَةَ مِنِّي بِظَهْرٍ فَصَلَّيْتُ إِلَيْهَا وقَدْ خالَفَنِي أَصْحابِي في ذلك حتى وقَعَ في نَفْسِي من ذلك شيءٌ فَمَا تَرَى يا رسولَ اللَّهِ؟ قال لقد كُنْتَ على قِبْلَةٍ لَوْ صَبَرْتَ عَلَيْهَا قال فَرَجَعَ البَرَاءُ إلى قِبْلَةِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فَصَلَّى مَعَنَا إلى الشَّامِ قال وأَهْلُهُ يُصَلُّونَ إلى الكَعْبَةِ حتى مَاتَ ولَيْسَ كَذَلِكَ كَمَا قَالُوا نَحْنُ أَعْلَمُ بِهِ مِنْهُمْ\nقَالَ وخَرَجْنَا إلى الحَجِّ فَوَاعَدْنَا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ العَقَبَةَ في أَوْسَطِ أَيَّامِ التَّشْرِيقِ فَلمَّا فَرَغْنَا من الحجِّ وكانَتِ الليْلَةُ التي وعَدْنَا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ ومعنا عبدُ اللهِ بنُ عَمْرِو بنِ حرامٍ أَبُو جَابِرٍ سَيِّدٌ من سَادَتِنَا وكُنَّا نَكْتُمُ من قَوْمِنَا من المُشْرِكِينَ أَمْرَنَا فكَلَّمْنَاهُ فقُلْنَا لهُ يا أبا جَابِرٍ إِنَّكَ سَيِّدٌ من سَادَتِنَا وشَرِيفٌ من أَشْرَافِنَا ",["وإِنَّا نَرْغَبُ بِكَ عَمَّا أَنْتَ فِيهِ",1]," ",["أنْ تَكُونَ حَصَبًا لِلنَّارِ غَدًا",2]," ثمَّ دَعَوْتُهُ إلى الإِسْلَامِ وأَخْبَرْتُهُ بِمِيعَادِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فَأَسْلَمَ وشَهِدَ مَعَنَا العَقَبَةَ وكَانَ نَقِيبًا\nقَالَ فَنِمْنَا تِلْكَ اللَّيْلَةَ مع قَوْمِنَا في رِحالِنَا حتى إِذَا مَضَى ثُلُثُ اللَّيْلِ خَرَجْنَا من رِحالِنَا لِمِيعَادِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ نَتَسَلَّلُ مُسْتَخْفِينَ تَسَلُّلَ القَطَا حتى اجْتَمَعْنَا في الشِّعْبِ عِنْدَ العَقَبَةِ ونحن سَبْعُونَ رَجُلًا مَعَهُمُ امْرَأَتانِ من نِسَائِهِمْ نَسِيبَةُ بِنْتُ كَعْبٍ أُمُّ عُمَارَةَ إِحْدَى نِسَاءِ بَنِي مَازِنِ بنِ النَّجَّارِ وأَسْمَاءُ ابْنَةُ عَمْرِو بنِ عَدِيِّ بنِ ثَابِتٍ إِحْدَى نِسَاءِ بَنِي سَلَمَةَ وهِيَ أُمُّ مَنِيعٍ فَاجْتَمَعْنَا بِالشِّعْبِ نَنْتَظِرُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ حتى جَاءَنَا ومَعَهُ يَوْمَئِذٍ عَمُّهُ العَبَّاسُ بنُ عَبْدِ المُطَّلِبِ وهُوَ يَوْمَئِذٍ على دِينِ قَوْمِهِ إِلَّا أَنَّهُ أَحَبَّ أنْ يَحْضُرَ أَمْرَ ابنِ أَخِيهِ يَتَوَثَّقُ لَهُ فَلمَّا جَلَسْنَا كَانَ العَبَّاسُ بنُ عَبْدِ المُطَّلِبِ أَوَّلَ مَنْ تَكَلَّمَ فقال يا مَعْشَرَ الخَزْرَجِ - وكَانَتِ العَرَبُ مِمَّا يُسَمُّونَ هذا الحَيَّ من الأَنْصارِ الخَزْرَجَ أَوْسَهَا وخَزْرَجَهَا - إِنَّ مُحَمَّدًا مِنَّا حَيْثُ قَدْ عَلِمْتُمْ وقَدْ مَنَعْنَاهُ من قَوْمِنَا مِمَّنْ هو على مِثْلِ رَأْيِنَا فِيهِ وهُوَ في عِزٍّ من قَوْمِهِ ومَنْعَةٍ في بَلَدِهِ قال فَقُلْنَا قَدْ سَمِعْنَا ما قُلْتَ فَتَكَلَّمْ يا رسولَ اللهِ فَخُذْ لِرَبِّكَ ولِنَفْسِكَ ما أَحْبَبْتَ فَتَكَلَّمَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فَتَلَا ودَعَا إلى اللهِ عزَّ وجلَّ ورَغَّبَ في الإِسْلَامِ قال أُبايِعُكُمْ على أنْ تَمْنَعُونِي مِمَّا تَمْنَعُونَ مِنْهُ نِسَاءَكُمْ وأَبْنَاءَكُمْ قال فَأَخَذَ البَرَاءُ بنُ مَعْرُورٍ بِيَدِهِ ثمَّ قال نَعَمْ والَّذِي بَعَثَكَ بِالْحَقِّ لِنَمْنَعَنَّكَ مِمَّا نَمْنَعُ مِنْهُ أَزْرَنَا فَبايِعْنَا يا رسولَ اللهِ فَنَحْنُ واللهِ أَهْلُ الحُرُوبِ وأَهْلُ الحَلْقَةِ ورِثْنَاهَا كَابِرًا عن كَابِرٍ قال فَاعْتَرَضَ القَوْلَ - والْبَرَاءُ يُكَلِّمُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ أَبُو الهَيْثَمِ بنُ التَّيِّهَانِ حَلِيفُ بَنِي عَبْدِ الأَشْهَلِ فقال يا رسولَ اللهِ إِنَّ بَيْنَنَا وبَيْنَ الرِّجَالِ حِبالًا وإِنَّا قَاطِعُوهَا - وهِيَ العُهُودُ - فهل عَسَيْتَ إِنْ نَحْنُ فَعَلْنَا ذَلِكَ وأَظْهَرَكَ اللهُ عزَّ وجلَّ أنْ تَرْجِعَ وتَدَعَنَا؟ قال فَتَبَسَّمَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فقال بَلِ الدَّمَ الدَّمَ والْهَدْمَ الهَدْمَ أَنْتُمْ مِنِّي وأَنَا مِنْكُمْ أُحارِبُ مَنْ حارَبْتُمْ وأُسَالِمُ مَنْ سَالَمْتُمْ وَقَالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ أَخْرِجُوا إِلَيَّ مِنْكُمْ اثْنَيْ عَشَرَ نَقِيبًا مِنْكُمْ يَكُونُونَ على قَوْمِهِمْ فَأَخْرَجُوا مِنْهُمُ اثْنَيْ عَشَرَ نَقِيبًا مِنْهُمْ تِسْعَةٌ من الخَزْرَجِ وثَلَاثَةٌ من الأَوْسِ وَأَمَّا مَعْبَدُ بنُ كَعْبٍ فَحَدَّثَنِي في حَدِيثُهُ عن أَخِيهِ عن أَبِيهِ كَعْبِ بنِ مَالِكٍ قال كَانَ أَوَّلَ مَنْ ضَرَبَ على يَدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ البَرَاءُ بنُ مَعْرُورٍ ثمَّ تَبايَعَ القَوْمُ فَلمَّا بايَعْنَا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ صَرَخَ الشَّيْطَانُ من رَأْسِ العَقَبَةِ بِأَنْفَذِ صَوْتٍ سَمِعْتُهُ يا أَهْلَ الجَباجِبِ - والْجَباجِبُ المَنَازِلُ - هل لَكُمْ في مُذَمَّمٍ والصُّباةُ مَعَهُ قَدْ أَجْمَعُوا على حَرْبِكُمْ؟ قال عليُّ يَعْنِي ابنَ إسْحاقَ ما يقولُ عَدُوُّ اللهِ مُحَمَّدٌ قال فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ هذا أَزَبُّ العَقَبَةِ هذا ابنُ أَزْيَبَ اسْمَعْ أَيْ عَدُوَّ اللهِ أَمَا واللهِ لَأَفْرُغَنَّ لَكَ ثمَّ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ارْفَعُوا إِلَيَّ رِحالَكُمْ قال فقال لَهُ العَبَّاسُ بنُ عُبادَةَ بنِ نَضْلَةَ والَّذِي بَعَثَكَ بِالْحَقِّ لَئِنْ شِئْتَ لَنَمِيلَنَّ على أَهْلِ مِنًى غَدًا بِأَسْيافِنَا قال فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ لَمْ أُؤْمَرْ بِذَلِكَ قال فَرَجَعْنَا فَنِمْنَا حتى أَصْبَحْنَا فَلمَّا أَصْبَحْنَا غَدَتْ عَلَيْنَا جُلَّةُ قُرَيْشٍ حتى جَاءُونَا في منازِلِنَا فقالُوا يا مَعْشَرَ الخَزْرَجِ إنَّه قَدْ بَلَغَنَا أَنَّكُمْ قَدْ جِئْتُمْ إلى صاحِبِنَا هذا تَسْتَخْرِجُونَهُ من بينِ أَيْدِينَا وتُبايِعُونَهُ على حَرْبِنَا واللهِ إنَّه ما من العَرَبِ أَحَدٌ أَبْغَضُ إلَيْنَا أنْ تَنْشَبَ الحَرْبُ بَيْنَنَا وبَيْنَهُمْ مِنْكُمْ قال فَنَبْعَثُ من هُنَالِكَ من مُشْرِكِي قَوْمِنَا يَحْلِفُونَ لَهُمْ بِاللهِ ما كان من هذا من شَيْءٍ ومَا عَلِمْنَاهُ وقَدْ صدَقُوا لَمْ يعلمُوا ما كَانَ مِنَّا قال فَبَعْضُنَا يَنْظُرُ إلى بَعْضٍ قال وقَامَ القَوْمُ وفِيهِمُ الحارِثُ بنُ هِشَامِ بنِ المُغِيرَةِ وعَلَيْهِ نَعْلَانِ جَدِيدَانِ قال فَقُلْتُ كَلِمَةً كَأَنِّي أُرِيدُ أنْ أُشْرِكُ القَوْمَ بها فِيما قالُوا ما تسْتَطِيعُ يا أبا جابِرٍ وأنت سَيِّدٌ من سَادَاتِنَا أنْ تَتَّخِذَ نَعْلَيْنِ مثلَ نَعْلَيْ هذا الفَتَى من قُرَيْشٍ؟ قال فَسمِعَهَا الحارِثُ فَخَلَعَهُمَا ثمَّ رَمَى بِهِمَا إِلَيَّ قال واللهِ لَتَنْتَعِلَنَّهُمَا قال يقولُ أَبُو جَابِرٍ أَحْفَظْتَ - واللهِ - الفَتَى ارْدُدْ عليْه نَعْلَيْهِ قال فَقُلْتُ واللهِ لا أَرُدُّهُمَا قال ووَاللَّهِ صالِحٌ لَئِنْ صَدَقَ الفَأْلُ لَأَسْلُبَنَّهُ فَهذَا حَدِيثُ ابنِ مَالِكٍ عَنِ العَقَبَةِ ومَا حَضَرَ مِنْهَا"],"grade":"صحيح","narrator":"كعب بن مالك","muhaddith":"رجاله رجال الصحيح غير ابن إسحاق وقد صرح بالسماع","takhrij":"أخرجه أحمد (15798) واللفظ له، وأبو نعيم في ((معرفة الصحابة)) (1081) باختلاف يسير، وابن حبان (7011) بنحوه.","bab":"بيعة › مبايعة الإمام","dorar":"svQcExLh"},{"id":"س-03768","fp":"1383bae23baf","stateId":730,"easy":"إذا أبيت إلا الشرك ← لن ينفعك فداء الأرض يوم القيامة","cause":"أن لا تُشرِكَ -أحسِبُه قال: ولا أُدخِلَك النَّارَ- فأبَيتَ إلَّا الشِّركَ","result":"لأهونِ أهلِ النَّارِ عَذابًا: لو كانَت لك الدُّنيا وما فيها أكُنتَ مُفتَديًا بها","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[22],"ref":"صحيح مسلم 2805","srcLabel":"متفق عليه","text":["يقولُ اللهُ تَبارَك وتَعالى ",["لأهونِ أهلِ النَّارِ عَذابًا: لو كانَت لك الدُّنيا وما فيها أكُنتَ مُفتَديًا بها",2],"؟ فيَقولُ: نَعَم، فيَقولُ: قد أرَدتُ مِنك أهونَ مِن هذا، وأنتَ في صُلبِ آدَمَ: ",["أن لا تُشرِكَ -أحسِبُه قال: ولا أُدخِلَك النَّارَ- فأبَيتَ إلَّا الشِّركَ",1],". وفي روايةٍ: عَنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم بمِثلِه، إلَّا قَولَه: ولا أُدخِلَك النَّارَ؛ فإنَّه لَم يَذكُرْه."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3334)، ومسلم (2805) .","bab":"الكفر والشرك › ذم الشرك وما ورد فيه من العقوبة","dorar":"FymQXk5O","merged":3,"otherRefs":["صحيح الجامع 8123 (صحيح)","صحيح البخاري 6557 (صحيح)"]},{"id":"س-03150","fp":"d723f08ef0dd","stateId":730,"easy":"إذا عبدت غير الله ← تتساقط في النار","cause":"كان يَعبُدُ صَنمًا ولا وَثنًا ولا صُورةً","result":"إلَّا ذَهَبوا حتَّى يَتَساقطوا في النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"similar":["س-03164","س-08192"],"otherNeedIds":[22],"ref":"المستدرك على الصحيحين 8962","srcLabel":"متفق عليه","text":["قلْتُ: يا رَسولَ اللهِ، هل نَرى ربَّنا يَومَ القيامةِ؟ قال: هلْ تُضارُّون في رُؤيةِ الشَّمسِ بالظَّهيرةِ صَحْوًا ليْس فيها سِحابٌ؟ فقُلْنا: لا يا رَسولَ اللهِ، قال: فهلْ تُضارُّون في رُؤيةِ القمرِ في لَيلةِ البدْرِ صَحْوًا ليْس فيه سِحابٌ؟ قالوا: لا، قال: ما تُضارُّون في رُؤيتِه يَومَ القيامةِ إلَّا كما تُضارُّون في رُؤيةِ أحدِهما، إذا كان يَومُ القيامةِ نادى مُنادٍ: ألَا لِتَلحَقْ كلُّ أُمَّةٍ بما كانت تَعبُدُ، فلا يَبْقى أحدٌ ",["كان يَعبُدُ صَنمًا ولا وَثنًا ولا صُورةً",1],"؛ ",["إلَّا ذَهَبوا حتَّى يَتَساقطوا في النَّارِ",2],"، ويَبْقى مَن كان يَعبُدُ اللهَ وحْدَه مِن بَرٍّ وفاجرٍ وغَبَراتِ أهلِ الكتابِ، ثمَّ تَعرِضُ جَهنَّمُ كأنَّها سَرابٌ يَحطِمُ بعضُها بعضًا، ثمَّ يُدْعى اليهودُ فيَقولُ: ماذا كُنتُم تَعبُدون؟ فيَقولُون: عُزَيرًا ابنَ اللهِ، فيَقولُ: كذَبْتُم؛ ما اتَّخَذَ اللهُ مِن صاحبةٍ ولا ولَدٍ، فما تُرِيدون؟ فيَقولُون: أيْ ربَّنا، ظَمِئْنا، فيَقولُ: أفلَا تَرِدُون، فيَذهَبون حتَّى يَتساقَطوا في النَّارِ. ثمَّ يُدْعى النَّصارى، فيَقولُ: ماذا كُنتُم تَعبُدون؟ فيَقولُون: المسيحُ ابنُ اللهِ، فيَقولُ: كذَبْتُم، ما اتَّخَذَ اللهُ مِن صاحبةٍ ولا ولَدٍ، فماذا تُرِيدون؟ فيَقولُون: أيْ ربَّنا، ظَمِئْنا، اسْقِنا، فيَقولُ: أفلَا تَرِدون، فيَذهَبون حتَّى يَتساقَطوا في النَّارِ، فيَبْقى مَن كان يَعبُدُ اللهَ وحْدَه مِن بَرٍّ وفاجرٍ. ثمَّ يَتبدَّى اللهُ لنا في صُورةٍ غيرِ صُورتِه الَّتي كنَّا رَأيْناهُ فيه أوَّلَ مرَّةٍ، فيَقولُ: أيُّها النَّاسُ، لَحِقَت كلُّ أُمَّةٍ بما كانت تَعبُدُ وبَقِيتُم، فلا يُكلِّمُه يومئذٍ إلَّا الأنبياءُ، يَقولُون: فارَقْنا النَّاسَ في الدُّنيا ونحنُ كنَّا إلى صُحبتِهم فيها أحوَجَ، لَحِقَت كلُّ أُمَّةٍ بما كانت تَعبُدُ، ونحنُ نَنتظِرُ ربَّنا الَّذي كنَّا نَعبُدُ، فيَقولُ: أنا ربُّكم، فيَقولُون: نَعوذُ باللهِ منكَ، فيَقولُ: هلْ بيْنكم وبيْن اللهِ مِن آيةٍ تَعرِفونها؟ فيَقولُون: نعمْ، فيُكشَفُ عن ساقٍ، فيَخِرُّ ساجدًا أجْمَعون، ولا يَبْقى أحدٌ كان يَسجُدُ في الدُّنيا سُمعةً ولا رِياءً ولا نِفاقًا، إلَّا على ظَهرِه طبَقٌ واحدٌ، كلَّما أراد أنْ يَسجُدَ خرَّ على قَفاهُ. قال: ثمَّ يَرفَعُ بَرُّنا ومُسِيئُنا، وقدْ عاد لنا في صُورتِه الَّتي رأيْناه فيها أوَّلَ مرَّةٍ، فيَقولُ: أنا ربُّكم، فيَقولُون: نعمْ، أنتَ ربُّنا، ثلاثَ مرَّاتٍ، ثمَّ يُضرَبُ الجِسرُ على جَهنَّمَ، قُلْنا: وما الجِسرُ يا رَسولَ اللهِ، بأبِينا أنتَ وأُمِّنا؟ قال: دَحْضٌ مَزِلَّةٌ، لها كَلاليبُ وخَطاطيفُ وحَسَكةٌ، بنَجْدٍ عَقيقٍ، يُقالُ لها: السَّعدانُ، فيَمُرُّ المؤمنُ كلَمْحِ البرْقِ، وكالطَّرْفِ، وكالرِّيحِ، وكالطَّيرِ، وكأجاوِدِ الخيْلِ والمراكِبِ، فناجٍ مُسَلَّمٌ، ومَخدوشٌ مُرسَلٌ، ومُكَرْدَسٌ في نارِ جَهنَّمَ، والَّذي نَفْسي بيَدِه، ما أحدُكم بأشدَّ منا شِدَّةً في الحقِّ يَراه مِنَ المُؤمنينَ في إخوانِهم إذا رَأَوهم قدْ خَلَصوا مِنَ النَّارِ، يَقولُون: أيْ ربَّنا، إخوانُنا كانوا يُصَلُّون معنا، ويَصومون معنا، ويَحُجُّون معنا، ويُجاهِدون معنا، قدْ أخَذَتْهم النَّارُ، فيَقولُ اللهُ تَبارك وتعالَى: اذْهَبوا، فمَن عرَفْتُم صُورتَه فأخْرِجوه، وتُحرَّمُ صُورتُهم على النَّارِ، فيَجِدُ الرَّجلَ قدْ أخَذَتْه النَّارُ إلى قَدَمَيه، وإلى أنصافِ ساقيْه، وإلى رُكبَتَيْه، وإلى حِقْوَيْه، فيَخرُجون منها بشَرًا، ثمَّ يَعودون فيَتكلَّمون، فلا يَزالُ يَقولُ لهم حتَّى يَقولَ: اذْهَبوا، فأخْرِجوا مَن وجَدْتُم في قَلبِه مِثقالَ ذرَّةٍ مِن خَيرٍ فأخْرِجوه. فكان أبو سَعيدٍ إذا حدَّث بهذا الحديثِ، يَقولُ: إنْ لم تُصَدِّقوا فاقْرَؤوا {إِنَّ اللَّهَ لَا يَظْلِمُ مِثْقَالَ ذَرَّةٍ وَإِنْ تَكُ حَسَنَةً يُضَاعِفْهَا وَيُؤْتِ مِنْ لَدُنْهُ أَجْرًا عَظِيمًا} [النساء: 40]، فيَقولُون: ربَّنا، لم نَذَرْ فيها خَيرًا، فيَقولُ: هلْ بقِيَ إلَّا أرحمُ الرَّاحمينَ؟ قدْ شَفَعَت الملائكةُ وشَفَع الأنبياءُ، فهلْ بَقِيَ إلَّا أرحَمُ الرَّاحمينَ؟ قال: فيَأخُذُ قَبْضةً مِنَ النَّارِ، فيُخرِجُ قومًا قدْ عادُوا حُمَمةً، لم يَعمَلوا له عمَلَ خَيرٍ قطُّ، فيُطرَحون في نَهرٍ يُقالُ له: نَهرُ الحياةِ، فيَنبُتون فيه -والَّذي نَفْسي بيَدِه- كما تَنبُتُ الحِبَّةُ في حَمِيلِ السَّيلِ، ألمْ تَرَوها وما يَلِيها مِن الظِّلِّ أصفَرَ، وما يَلِيها مِنَ الشَّمسِ أخضَرَ؟ قال: قُلْنا: يا رَسولَ اللهِ، كأنَّك تكونُ في الماشيةِ، قال: يَنبُتون كذلك، فيَخرُجون أمثالَ اللُّؤلؤِ، يُجعَلُ في رِقابِهم الخواتيمُ، ثمَّ يُرسَلون في الجنَّةِ، فيَقولُ أهلُ الجنَّةِ: هؤلاء الجَهنَّميون، هؤلاء الَّذين أخْرَجَهم مِنَ النَّارِ بغيرِ عَملٍ عَمِلوه ولا خَيرٍ قَدَّموه. يَقولُ اللهُ تعالَى: خُذوا، فلكمْ ما أخَذْتُم، فيَأخُذون حتَّى يَنتهَوا، ثمَّ يَقولُون: لنْ يُعطِينا اللهُ عزَّ وجلَّ ما أخَذْنا، فيَقولُ اللهُ تَبارك وتعالَى: فإنِّي أعْطَيْتُكم أفضَلَ ممَّا أخَذْتُم، فيَقولُون: ربَّنا، وما أفضَلُ مِن ذلكَ وممَّا أخَذْنا؟ فيَقولُ: رِضواني بلا سَخطٍ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح الإسناد ولم يخرجاه بهذه السياقة","takhrij":"أخرجه البخاري (7439)، ومسلم (183)، وأحمد (11127) جميعا بنحوه.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"9E4GpFz1"},{"id":"س-04524","fp":"079cae6aabcd","stateId":730,"easy":"إذا أبيت التوحيد وقد سُئلت ما هو أيسر منه ← تُرد إلى النار","cause":"قد سألتُكَ أَقَلَّ من ذلك وأَيْسَرَ ، فلم تفعلْ","result":"فيُرَدُّ إلى النارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح الجامع 7996","srcLabel":"مسلم","text":["يُؤْتَى بالرجلِ يومَ القيامةِ من أهلِ الجنةِ ، فيقولُ له : يا ابنَ آدمَ ! كيف وَجَدْتَ مَنْزِلَكَ ؟ فيقولُ : أَيْ رَبِّ ! خيرُ مَنْزِلٍ ، فيقولُ : سَلْ وتَمَنَّ ، فيقولُ : يا ربِّ ما أسألُ ولا أَتَمَنَّى إلَّا أن تَرُدَّنِي إلى الدنيا ، فأُقْتَلَ في سبيلِك عَشْرَ مِرَارٍ ، لِمَا يَرَى من فضلِ الشهادةِ ، ويُؤْتَى بالرجلِ من أهلِ النارِ ، فيقولُ له : يا ابنَ آدمَ ! كيف وَجَدْتَ مَنْزِلَكَ ؟ فيقولُ : أَيْ رَبِّ ! شَرُّ مَنْزِلٍ ، فيقولُ له : أَتَفْتَدِي منه بطِلَاعِ الأرضِ ذهبًا ؟ فيقولُ : أَيْ رَبِّ ! نعم ، فيقولُ : كَذَبْتَ ",["قد سألتُكَ أَقَلَّ من ذلك وأَيْسَرَ ، فلم تفعلْ",1]," ",["فيُرَدُّ إلى النارِ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2805)، والنسائي (3160) مختصراً، وأحمد (13162) واللفظ له","bab":"جهاد › فضل الشهيد","dorar":"TsXcFLkC"},{"id":"س-02582","fp":"fb1b87fff9d4","stateId":730,"easy":"إذا قرّبت لغير الله ولو ذباباً ← تدخل النار","cause":"فقرَّبَ ذبابًا","result":"فدخل النارَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[22],"ref":"شرح كتاب التوحيد لابن باز 100","srcLabel":"أحمد","text":["دخل الجنَّةَ رجلٌ في ذُبابٍ ودخل النارَ رجلٌ في ذُبابٍ قالوا: كيف ذلك يا رسولَ اللهِ؟ قال: مر رجلان على قومٍ لهم صنمٌ لا يجوزُه أحدٌ حتى يقربَ له شيئًا، فقالوا لأحدِهما: قربْ فقال: ليس عندي شيءٌ أقرِّبُ، قالوا له: قرِّبْ ولو ذُبابًا، ",["فقرَّبَ ذبابًا",1],"، فخلوا سبيلَه ",["فدخل النارَ",2],"، وقالوا للآخرِ: قرِّبْ فقال: ما كنتُ لأقرِّبَ لأحدٍ شيئًا دون اللهِ عزَّ وجلَّ فضربوا عنقَه فدخل الجنَّةَ."],"grade":"حسن","narrator":"[سلمان]","muhaddith":"إسناده جيد","takhrij":"أخرجه ابن أبي شيبة (33038)، وأحمد في ((الزهد)) (84)، وابن الأعرابي في ((معجم الشيوخ)) (1796)، وأبو نعيم في ((حلية الأولياء)) (1/ 203) واللفظ لهم.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"RI2lLIuE"},{"id":"س-02393","fp":"4823deb87473","stateId":730,"easy":"إذا تمردت على الله وأبيت أن تقول لا إله إلا الله ← تُعذّب","cause":"الماردُ المتمردُ، الذي يتمردُ على اللهِ وأبى أنْ يقولَ، لا إلهَ إلا اللهُ","result":"لا يعذبُ منْ عبادِه إلا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"الجامع الصغير 1818","srcLabel":"ابن ماجه","text":["إنَّ الله تعالى ",["لا يعذبُ منْ عبادِه إلا",2]," ",["الماردُ المتمردُ،  الذي يتمردُ على اللهِ وأبى أنْ يقولَ،  لا إلهَ إلا اللهُ",1]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (4297)، والعقيلي في ((الضعفاء الكبير)) (1/96)، والواحدي في ((التفسير الوسيط)) (367) مطولاً","bab":"إسلام › فضل الشهادتين","dorar":"oe6Hl90m"},{"id":"س-03164","fp":"0fe95cab0b4c","stateId":730,"easy":"إذا عبدت غير الله ← تتبع معبودك حتى يُقحمك النار","cause":"ما كانوا يَعبُدونَ","result":"فيَتبَعونَهم حتى يُقحِّمونَهم النَّارَ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-03150","ref":"تخريج المسند لشعيب 19654","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يَجمَعُ اللهُ عزَّ وجلَّ الأُمَمَ في صَعيدٍ واحدٍ يومَ القيامةِ، فإذا بَدا للهِ عزَّ وجلَّ أنْ يَصدَعَ بيْنَ خَلقِه، مَثَّلَ لكلِّ قَومٍ ",["ما كانوا يَعبُدونَ",1],"، ",["فيَتبَعونَهم حتى يُقحِّمونَهم النَّارَ",2],"، ثُمَّ يَأتينا ربُّنا عزَّ وجلَّ ونحن على مَكانٍ رَفيعٍ فيَقولُ: مَن أنتم؟ فنَقولُ: نحن المُسلِمونَ، فيَقولُ: ما تَنتظِرونَ؟ فيَقولونَ: نَنتظِرُ ربَّنا عزَّ وجلَّ، قال: فيَقولُ: وهل تَعرِفونَه إنْ رَأَيتُموه؟ فيَقولونَ: نَعَمْ، فيَقولُ: كيف تَعرِفونَه ولم تَرَوْه؟ فيَقولونَ: نَعَمْ، إنَّه لا عِدلَ له، فيَتجَلَّى لنا ضاحكًا، يقولُ: أبشِروا أيُّها المُسلِمونَ؛ فإنَّه ليس منكم أحَدٌ إلَّا جَعَلتُ مَكانَه في النَّارِ يهوديًّا أو نصرانيًّا."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"قوله: \"ليس منكم أحد إلا جعلت مكانه في النار يهوديا أو نصرانيا\" صحيح","takhrij":"أخرجه أحمد (19654) واللفظ له، والدارمي في ((الرد على الجهمية)) (180) باختلاف يسير، وابن خزيمة في ((التوحيد)) (2/577) مختصراً","bab":"إيمان › توحيد الأسماء والصفات","dorar":"ofp5NH1J"},{"id":"س-08192","fp":"e618f095ad8e","stateId":730,"easy":"إذا عبدت غير الله ← تتبع معبودك حتى يوردك النار","cause":"آلهتُهُم الَّتي كانوا يعبدونَها","result":"فيتبِعونَها حتَّى تُوردَهم النَّارُ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-03150","ref":"المطالب العالية 5/100","text":["إنَّ عبدَ اللهِ بنَ مسعودٍ رضيَ اللهُ عنهُ حدَّثَ عمرَ بنَ الخطَّابِ رضيَ اللهُ عنهُ هذا الحديثَ فقال : إذا حُشِرَ النَّاسُ يومَ القيامةِ قاموا أربعينَ ، على رؤوسِهِم الشَّمسُ ، شاخصةً أبصارُهُم إلى السَّماءِ ، ينتظرونَ الفصلَ ، كلُّ برٍّ منهُم وفاجرٍ ، لا يتكلمُ منهُم بشرٌ ، ثمَّ يُنادي مُنادٍ : أليسَ عدلًا من ربِّكُم الَّذي خلقَكُم وصوَّرَكُم ورزقَكُم ثمَّ عبدتُم غيرَهُ أن يُولِّي كلَّ قَومٍ ما تولَّوْا ؟ فيقولونَ : بلَى . فيُنادي بذلكَ ملَكٌ ثلاثَ مرَّاتٍ ، ثمَّ يُمَثَّلُ لكلِّ قَومٍ ",["آلهتُهُم الَّتي كانوا يعبدونَها",1]," ، ",["فيتبِعونَها حتَّى تُوردَهم النَّارُ",2]," ، فيبقَى المؤمنونَ والمنافقونَ ، فيخرُّ المؤمنونَ سُجَّدًا ، وتُدْمَجُ أصلابُ المنافقينَ فتكونُ عظمًا واحدًا كأنَّها صَيَاصِيُّ البقرِ ، ويخرُّونَ على أقْفيتِهِم ، فيقولُ اللهُ تعالى لهُم : ارفَعوا رؤوسَكُم إلى نورِكم بقدرِ أعمالِكُم ، فيرفعُ الرَّجلُ رأسَهُ ونورُهُ بينَ يدَيْهِ مثلُ الجبلِ ، ويرفعُ الرَّجلُ رأسَهُ ونورُهُ بينَ يدَيهِ مثلُ القصرِ ، ويرفعُ الرَّجلُ رأسَهُ ونورُهُ بينَ يدَيهِ مثلُ البَيتِ ، حتَّى ذكرَ مثلَ الشَّجرةِ ، فيمضونَ على الصِّراطِ كالبرقِ ، وكالرِّيحِ ، وكحضرِ الفرسِ ، وكاشتدادِ الرَّجلِ ، حتَّى يبقَى آخرَ النَّاسِ نورُهُ على إبهامِ رجلِهِ مثلُ السِّراجِ ، فأحيانًا يُضيءُ لهُ ، وأحيانًا يخفَى عليهِ ، فتنفثُ منهُ النَّارُ ، فلا يزالُ كذلكَ حتَّى يخرجَ فيقولُ : ما يدري أحدٌ ما نجا منهُ غَيري ، ولا أصابَ أحدٌ مثلَ ما أصبتَ ، إنَّما أصابَني حرُّها ونجَوتُ منها ، قال : فيُفتَحُ لهُ بابٌ من الجنَّةِ فيقولُ : يا ربِّ ، أدخِلْني هذا ، فيقولُ : عبدي لعلِّي إن أدخلتُكَ تسألْني غيرَهُ . قال : فيُدخِلُهُ ، فبَينا هوَ يعجبُ بما هوَ فيهِ إذ فُتِحَ لهُ بابٌ آخرُ ، فيستَحقِرُ في عَينِهِ الَّذي هوَ فيهِ ، فيقولُ : يا ربِّ ، أدخِلْني هذا . فيقولُ : أو لَم تزعُمْ أنَّكَ لا تسألْني غيرَهُ ، فيقولُ : وعزَّتِكَ وجلالِكَ لئن أدخلتَنِيهِ لا أسألُكَ غيرَهُ . قال : فيُدخِلُهُ حتَّى يُدْخِلَهُ أربعةَ أبوابٍ كلَّها يسألُها ، ثمَّ يستقبلُهُ رجلٌ مثلُ النُّورِ ، فإذا رآهُ هوَى يسجدُ لهُ فيقولُ : ما شأنُكَ ؟ فيقولُ : ألستَ بربِّي ؟ فيقولُ : إنَّما أنا قَهرمانٌ لكَ في الجنَّةِ [ من ] ألفِ قَهرمانٍ على ألفِ قصرٍ ، بينَ كلِّ قصرَيْنِ مسيرةُ ( ألفِ سنةٍ ) ، يُرَى أقصاها كما يُرَى أدناها ، ثمَّ يُفْتَحُ لهُ بابٌ من زَبرجَدةٍ خضراءَ ، فيها سبعونَ بابًا ، في كلِّ بابٍ منها أزواجٌ وسُرُرٌ ومناصفٌ ، فيقعدُ مع زوجتِهِ فتُناولُهُ الكأسَ ، فتقولُ : لأنتَ منذُ ناولتُكَ الكأسَ أحسنُ منكَ قبلَ ذلكَ بسبعينَ ضِعْفًا ، علَيها سبعونَ حُلَّةً ، ألوانُها شتَّى يُرَى مخُّ ساقِها ، ويلبسُ الرَّجلُ ثيابَهُ على كبدِها ، وكبدُها مِرْآتُهُ"],"grade":"صحيح","narrator":"قيس بن السكن وأبو عبيدة بن عبدالله","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبري في ((تفسيره)) (23/ 190) بلفظ قريب، وأورده البلوصيري في ((الإتحاف)) (7684) وعزاه لإسحاق.","bab":"ملائكة › أعمال الملائكة","dorar":"II3fMWHr"},{"id":"س-06898","fp":"c4575d14cb96","stateId":731,"easy":"إذا نازعت الله رداءه أو شككت في أمره أو قنطت من رحمته ← فلا يُسأل عنك","cause":"رجلٌ نازعَ اللهَ رِداءَه ؛ فإنَّ رداءَه الكِبرياءُ و إزارَه عِزُّهُ ، و رجلٌ شكَّ في أمرِ اللهِ ، و القَنُوطُ مِن رحمةِ اللهِ","result":"و ثلاثةٌ لا يُسْأَلُ عنهُم","explicit":true,"star":true,"ref":"صحيح الأدب المفرد 458","srcLabel":"البخاري","text":["ثلاثةٌ لا يُسأَلُ عنهم : رجلٌ فارَقَ الجماعةَ و عصَى إمامَه فماتَ عاصيًا ؛ فلا يُسأَلُ عنهُ ، و أَمَةٌ أو عبدٌ أَبَقَ مِن سيدِه ، و امرأةٌ غاب عنها زوجُها و كَفاها مَؤونةَ الدُّنيا فتبرَّجَت و تمرَّجت بعدَه ",["و ثلاثةٌ لا يُسْأَلُ عنهُم",2]," : ",["رجلٌ نازعَ اللهَ رِداءَه ؛ فإنَّ رداءَه الكِبرياءُ و إزارَه عِزُّهُ ، و رجلٌ شكَّ في أمرِ اللهِ ، و القَنُوطُ مِن رحمةِ اللهِ",1]],"grade":"صحيح","narrator":"فضالة بن عبيد","muhaddith":"صحيح","takhrij":"أخرجه أحمد (23988)، والبخاري في ((الأدب المفرد)) (590)، والبزار (3749) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"G0aZMJSZ","merged":3,"otherRefs":["تخريج المسند لشعيب 23943 (صحيح)","صحيح الجامع 3059 (صحيح)"]},{"id":"س-02609","fp":"23041eb3010a","stateId":731,"easy":"إذا سمعت بالنبي ﷺ ثم لم تؤمن به ← تكون من أهل النار","cause":"لا يسمعُ بي رجلٌ من هذه الأمَّةِ ، ولا يهوديٌّ ولا نصرانيٌّ ثمَّ لم يؤمِنْ بي","result":"إلَّا كان من أهلِ النَّارِ","explicit":true,"similar":["س-03002","س-02622","س-03031"],"otherNeedIds":[22],"ref":"السلسلة الصحيحة 157","srcLabel":"مسلم","text":["والَّذي نفسي بيدِه ",["لا يسمعُ بي رجلٌ من هذه الأمَّةِ ، ولا يهوديٌّ ولا نصرانيٌّ ثمَّ لم يؤمِنْ بي",1]," ",["إلَّا كان من أهلِ النَّارِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (153) باختلاف يسير","bab":"إيمان › الأمر بالإيمان بالله تعالى ورسوله وشرائع الدين","dorar":"XdieR8mY"},{"id":"س-02742","fp":"ffebb493ba0b","stateId":731,"easy":"إذا أبغضت الله ورسوله وعملت بالمعصية ← وجبت لك النار","cause":"كان يُبغِضُ اللهَ ورَسولَه، ويَعمَلُ بمَعصِيةِ اللهِ، ويَسعى فيها","result":"وَجَبَت، وَجَبَت","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[67],"ref":"المستدرك على الصحيحين 1415","srcLabel":"مسلم","text":["كُنتُ قاعِدًا مع النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فمَرت جِنازةٌ، فقالَ: ما هذه الجِنازةُ؟ قالوا: جِنازةُ فُلانٍ الفُلانيِّ، كان يُحِبُّ اللهَ ورَسولَه، ويَعمَلُ بطاعةِ اللهِ، ويَسعى فيها، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: وَجَبَت، وَجَبَت، وَجَبَت ومُرَّتْ بجِنازةٍ أخرى فقالَ: ما هذه الجِنازةُ؟ قالوا: جِنازةُ فُلانٍ الفُلانيِّ، ",["كان يُبغِضُ اللهَ ورَسولَه، ويَعمَلُ بمَعصِيةِ اللهِ، ويَسعى فيها",1],"، فقالَ: ",["وَجَبَت، وَجَبَت",2],"، وَجَبَت، فقالوا: يا رَسولَ اللهِ، قَولُكَ في الجِنازةِ، والثَّناءِ عليها، أُثنِيَ على الأوَّلِ خَيرٌ، وعلى الآخَرِ شَرٌّ فقُلتَ فيها: وَجَبَت، وَجَبَت، وَجَبَت، فقالَ: نَعَم يا أبا بَكرٍ، إنَّ للهِ مَلائكةً تَنطِقُ على ألسِنةِ بني آدَمَ بما في المَرءِ منَ الخَيرِ والشَّرِّ."],"grade":"صحيح","narrator":"أنس","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه مسلم (949)، وأحمد (12938)، والبيهقي في ((الشعب)) (8876) باختلاف يسير.","bab":"إيمان › الملائكة","dorar":"HLDFANZN","merged":10,"otherRefs":["تخريج مشكل الآثار 3305 (صحيح)","مجمع الزوائد 8/3 (صحيح)","الأحاديث المختارة 2697 (صحيح)","تخريج صحيح ابن حبان 3027 (صحيح)","تخريج المسند لشعيب 12837 (صحيح)","تخريج صحيح ابن حبان 3025 (صحيح)","تخريج صحيح ابن حبان 3023 (صحيح)","تخريج المسند لشعيب 13039 (صحيح)","تخريج مشكل الآثار 3301 (صحيح)"]},{"id":"ق-0007","fp":"62e47b1f50a1","stateId":731,"easy":"الكفر والتكذيب بآيات الله ← نار وقودها الناس والحجارة","cause":"الكفر والتكذيب بآيات الله","result":"نار وقودها الناس والحجارة","explicit":true,"similar":["ق-0012","ق-0034","ق-0120","ق-0223","ق-0287","ق-0332","ق-0387","ق-0400","ق-0827","ق-0942","ق-0955","ق-1183","ق-1303","ق-1343","ق-1437"],"ref":"سورة البقرة: 24","srcLabel":"القرآن الكريم","quran":{"s":2,"from":24,"to":24,"text":"فَإِنْ لَمْ تَفْعَلُوا وَلَنْ تَفْعَلُوا فَاتَّقُوا النَّارَ الَّتِي وَقُودُهَا النَّاسُ وَالْحِجَارَةُ أُعِدَّتْ لِلْكَافِرِينَ (24)","hl":[[41,128,1]]}},{"id":"ق-0012","fp":"2c2c97376e76","stateId":731,"easy":"الكفر والتكذيب بآيات الله ← الخلود في النار","cause":"الكفر والتكذيب بآيات الله","result":"الخلود في النار","explicit":true,"repOf":"ق-0007","ref":"سورة البقرة: 39","quran":{"s":2,"from":39,"to":39,"text":"وَالَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا أُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ (39)","hl":[[0,96,1]]}},{"id":"ق-0023","fp":"6c3a898e1c5d","stateId":731,"easy":"كسب السيئة حتى تحيط الخطيئة بصاحبها ← الخلود في النار","cause":"كسب السيئة حتى تحيط الخطيئة بصاحبها","result":"الخلود في النار","explicit":true,"ref":"سورة البقرة: 81","srcLabel":"القرآن الكريم","quran":{"s":2,"from":81,"to":81,"text":"بَلَى مَنْ كَسَبَ سَيِّئَةً وَأَحَاطَتْ بِهِ خَطِيئَتُهُ فَأُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ (81)","hl":[[6,110,1]]}},{"id":"ق-0034","fp":"b66631d90425","stateId":731,"easy":"الكفر والتكذيب بآيات الله ← عذاب أليم","cause":"الكفر والتكذيب بآيات الله","result":"عذاب أليم","explicit":true,"repOf":"ق-0007","ref":"سورة البقرة: 104","quran":{"s":2,"from":104,"to":104,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَقُولُوا رَاعِنَا وَقُولُوا انْظُرْنَا وَاسْمَعُوا وَلِلْكَافِرِينَ عَذَابٌ أَلِيمٌ (104)","hl":[[87,119,1]]}},{"id":"ق-0044","fp":"c7f8b4c32887","stateId":731,"easy":"الكفر ← متاع قليل ثم عذاب النار","cause":"الكفر","result":"متاع قليل ثم عذاب النار","explicit":true,"similar":["ق-0161","ق-0242","ق-0304","ق-0453","ق-0482","ق-0545","ق-0634","ق-0976","ق-0985","ق-1030","ق-1062","ق-1432"],"ref":"سورة البقرة: 126","srcLabel":"القرآن الكريم","quran":{"s":2,"from":126,"to":126,"text":"وَإِذْ قَالَ إِبْرَاهِيمُ رَبِّ اجْعَلْ هَذَا بَلَدًا آمِنًا وَارْزُقْ أَهْلَهُ مِنَ الثَّمَرَاتِ مَنْ آمَنَ مِنْهُمْ بِاللَّهِ وَالْيَوْمِ الْآخِرِ قَالَ وَمَنْ كَفَرَ فَأُمَتِّعُهُ قَلِيلًا ثُمَّ أَضْطَرُّهُ إِلَى عَذَابِ النَّارِ وَبِئْسَ الْمَصِيرُ (126)","hl":[[155,252,1]]}},{"id":"ق-0120","fp":"52827592a1a4","stateId":731,"easy":"الكفر والتكذيب بآيات الله ← عذاب شديد","cause":"الكفر والتكذيب بآيات الله","result":"عذاب شديد","explicit":true,"repOf":"ق-0007","ref":"سورة آل عمران: 4","quran":{"s":3,"from":4,"to":4,"text":"مِنْ قَبْلُ هُدًى لِلنَّاسِ وَأَنْزَلَ الْفُرْقَانَ إِنَّ الَّذِينَ كَفَرُوا بِآيَاتِ اللَّهِ لَهُمْ عَذَابٌ شَدِيدٌ وَاللَّهُ عَزِيزٌ ذُو انْتِقَامٍ (4)","hl":[[52,149,1]]}},{"id":"ق-0124","fp":"01d337029149","stateId":731,"easy":"الكفر بآيات الله ← سرعة الحساب","cause":"الكفر بآيات الله","result":"سرعة الحساب","explicit":true,"ref":"سورة آل عمران: 19","srcLabel":"القرآن الكريم","quran":{"s":3,"from":19,"to":19,"text":"إِنَّ الدِّينَ عِنْدَ اللَّهِ الْإِسْلَامُ وَمَا اخْتَلَفَ الَّذِينَ أُوتُوا الْكِتَابَ إِلَّا مِنْ بَعْدِ مَا جَاءَهُمُ الْعِلْمُ بَغْيًا بَيْنَهُمْ وَمَنْ يَكْفُرْ بِآيَاتِ اللَّهِ فَإِنَّ اللَّهَ سَرِيعُ الْحِسَابِ (19)","hl":[[150,217,1]]}},{"id":"ق-0126","fp":"08e00fac175f","stateId":731,"easy":"الكفر بآيات الله وقتل الأنبياء والآمرين بالقسط ← عذاب أليم وحبوط الأعمال ولا ناصرين","cause":"الكفر بآيات الله وقتل الأنبياء والآمرين بالقسط","result":"عذاب أليم وحبوط الأعمال ولا ناصرين","explicit":true,"otherNeedIds":[52],"ref":"سورة آل عمران: 21–22","srcLabel":"القرآن الكريم","quran":{"s":3,"from":21,"to":22,"text":"إِنَّ الَّذِينَ يَكْفُرُونَ بِآيَاتِ اللَّهِ وَيَقْتُلُونَ النَّبِيِّينَ بِغَيْرِ حَقٍّ وَيَقْتُلُونَ الَّذِينَ يَأْمُرُونَ بِالْقِسْطِ مِنَ النَّاسِ فَبَشِّرْهُمْ بِعَذَابٍ أَلِيمٍ (21) أُولَئِكَ الَّذِينَ حَبِطَتْ أَعْمَالُهُمْ فِي الدُّنْيَا وَالْآخِرَةِ وَمَا لَهُمْ مِنْ نَاصِرِينَ (22)","hl":[[0,286,1]]}},{"id":"ق-0133","fp":"bff5b8c0ff66","stateId":731,"easy":"الكفر ← عذاب شديد في الدنيا والآخرة ولا ناصرين","cause":"الكفر","result":"عذاب شديد في الدنيا والآخرة ولا ناصرين","explicit":true,"similar":["ق-1020","ق-1155"],"otherNeedIds":[61],"ref":"سورة آل عمران: 56","srcLabel":"القرآن الكريم","quran":{"s":3,"from":56,"to":56,"text":"فَأَمَّا الَّذِينَ كَفَرُوا فَأُعَذِّبُهُمْ عَذَابًا شَدِيدًا فِي الدُّنْيَا وَالْآخِرَةِ وَمَا لَهُمْ مِنْ نَاصِرِينَ (56)","hl":[[0,118,1]]}},{"id":"ق-0144","fp":"d049c389d7cc","stateId":731,"easy":"الموت على الكفر ← لا تقبل الفدية وعذاب أليم ولا ناصرين","cause":"الموت على الكفر","result":"لا تقبل الفدية وعذاب أليم ولا ناصرين","explicit":true,"similar":["ق-0209"],"ref":"سورة آل عمران: 91","srcLabel":"القرآن الكريم","quran":{"s":3,"from":91,"to":91,"text":"إِنَّ الَّذِينَ كَفَرُوا وَمَاتُوا وَهُمْ كُفَّارٌ فَلَنْ يُقْبَلَ مِنْ أَحَدِهِمْ مِلْءُ الْأَرْضِ ذَهَبًا وَلَوِ افْتَدَى بِهِ أُولَئِكَ لَهُمْ عَذَابٌ أَلِيمٌ وَمَا لَهُمْ مِنْ نَاصِرِينَ (91)","hl":[[0,190,1]]}},{"id":"ق-0156","fp":"0b016d5518f9","stateId":731,"easy":"الكفر ← لا تغني عنهم أموالهم ولا أولادهم وهم أصحاب النار","cause":"الكفر","result":"لا تغني عنهم أموالهم ولا أولادهم وهم أصحاب النار","explicit":true,"similar":["ق-1451"],"ref":"سورة آل عمران: 116","srcLabel":"القرآن الكريم","quran":{"s":3,"from":116,"to":116,"text":"إِنَّ الَّذِينَ كَفَرُوا لَنْ تُغْنِيَ عَنْهُمْ أَمْوَالُهُمْ وَلَا أَوْلَادُهُمْ مِنَ اللَّهِ شَيْئًا وَأُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ (116)","hl":[[0,156,1]]}},{"id":"ق-0161","fp":"8d47d0460539","stateId":731,"easy":"الكفر ← النار المعدّة للكافرين","cause":"الكفر","result":"النار المعدّة للكافرين","explicit":true,"repOf":"ق-0044","ref":"سورة آل عمران: 131","quran":{"s":3,"from":131,"to":131,"text":"وَاتَّقُوا النَّارَ الَّتِي أُعِدَّتْ لِلْكَافِرِينَ (131)","hl":[[0,52,1]]}},{"id":"ق-0189","fp":"5463b9f0da59","stateId":731,"easy":"المسارعة في الكفر ← لا حظّ في الآخرة وعذاب عظيم","cause":"المسارعة في الكفر","result":"لا حظّ في الآخرة وعذاب عظيم","explicit":true,"ref":"سورة آل عمران: 176","srcLabel":"القرآن الكريم","quran":{"s":3,"from":176,"to":176,"text":"وَلَا يَحْزُنْكَ الَّذِينَ يُسَارِعُونَ فِي الْكُفْرِ إِنَّهُمْ لَنْ يَضُرُّوا اللَّهَ شَيْئًا يُرِيدُ اللَّهُ أَلَّا يَجْعَلَ لَهُمْ حَظًّا فِي الْآخِرَةِ وَلَهُمْ عَذَابٌ عَظِيمٌ (176)","hl":[[17,180,1]]}},{"id":"ق-0190","fp":"f788740faff9","stateId":731,"easy":"شراء الكفر بالإيمان ← عذاب أليم","cause":"شراء الكفر بالإيمان","result":"عذاب أليم","explicit":true,"ref":"سورة آل عمران: 177","srcLabel":"القرآن الكريم","quran":{"s":3,"from":177,"to":177,"text":"إِنَّ الَّذِينَ اشْتَرَوُا الْكُفْرَ بِالْإِيمَانِ لَنْ يَضُرُّوا اللَّهَ شَيْئًا وَلَهُمْ عَذَابٌ أَلِيمٌ (177)","hl":[[0,106,1]]}},{"id":"ق-0195","fp":"f830dc9704f8","stateId":731,"easy":"سوء القول في الله وقتل الأنبياء ← عذاب الحريق بما قدمت الأيدي","cause":"سوء القول في الله وقتل الأنبياء","result":"عذاب الحريق بما قدمت الأيدي","explicit":true,"ref":"سورة آل عمران: 181–182","srcLabel":"القرآن الكريم","quran":{"s":3,"from":181,"to":182,"text":"لَقَدْ سَمِعَ اللَّهُ قَوْلَ الَّذِينَ قَالُوا إِنَّ اللَّهَ فَقِيرٌ وَنَحْنُ أَغْنِيَاءُ سَنَكْتُبُ مَا قَالُوا وَقَتْلَهُمُ الْأَنْبِيَاءَ بِغَيْرِ حَقٍّ وَنَقُولُ ذُوقُوا عَذَابَ الْحَرِيقِ (181) ذَلِكَ بِمَا قَدَّمَتْ أَيْدِيكُمْ وَأَنَّ اللَّهَ لَيْسَ بِظَلَّامٍ لِلْعَبِيدِ (182)","hl":[[0,279,1]]}},{"id":"ق-0209","fp":"fde2f549c692","stateId":731,"easy":"الموت على الكفر ← عذاب أليم","cause":"الموت على الكفر","result":"عذاب أليم","explicit":true,"repOf":"ق-0144","ref":"سورة النساء: 18","quran":{"s":4,"from":18,"to":18,"text":"وَلَيْسَتِ التَّوْبَةُ لِلَّذِينَ يَعْمَلُونَ السَّيِّئَاتِ حَتَّى إِذَا حَضَرَ أَحَدَهُمُ الْمَوْتُ قَالَ إِنِّي تُبْتُ الْآنَ وَلَا الَّذِينَ يَمُوتُونَ وَهُمْ كُفَّارٌ أُولَئِكَ أَعْتَدْنَا لَهُمْ عَذَابًا أَلِيمًا (18)","hl":[[134,217,1]]}},{"id":"ق-0223","fp":"c459da4c37c7","stateId":731,"easy":"الكفر بآيات الله ← نار تُبدَّل فيها الجلود","cause":"الكفر بآيات الله","result":"نار تُبدَّل فيها الجلود","explicit":true,"repOf":"ق-0007","ref":"سورة النساء: 56","quran":{"s":4,"from":56,"to":56,"text":"إِنَّ الَّذِينَ كَفَرُوا بِآيَاتِنَا سَوْفَ نُصْلِيهِمْ نَارًا كُلَّمَا نَضِجَتْ جُلُودُهُمْ بَدَّلْنَاهُمْ جُلُودًا غَيْرَهَا لِيَذُوقُوا الْعَذَابَ إِنَّ اللَّهَ كَانَ عَزِيزًا حَكِيمًا (56)","hl":[[0,187,1]]}},{"id":"ق-0242","fp":"6d6a4ead9177","stateId":731,"easy":"الكفر ← عذاب مهين","cause":"الكفر","result":"عذاب مهين","explicit":true,"repOf":"ق-0044","ref":"سورة النساء: 102","quran":{"s":4,"from":102,"to":102,"text":"وَإِذَا كُنْتَ فِيهِمْ فَأَقَمْتَ لَهُمُ الصَّلَاةَ فَلْتَقُمْ طَائِفَةٌ مِنْهُمْ مَعَكَ وَلْيَأْخُذُوا أَسْلِحَتَهُمْ فَإِذَا سَجَدُوا فَلْيَكُونُوا مِنْ وَرَائِكُمْ وَلْتَأْتِ طَائِفَةٌ أُخْرَى لَمْ يُصَلُّوا فَلْيُصَلُّوا مَعَكَ وَلْيَأْخُذُوا حِذْرَهُمْ وَأَسْلِحَتَهُمْ وَدَّ الَّذِينَ كَفَرُوا لَوْ تَغْفُلُونَ عَنْ أَسْلِحَتِكُمْ وَأَمْتِعَتِكُمْ فَيَمِيلُونَ عَلَيْكُمْ مَيْلَةً وَاحِدَةً وَلَا جُنَاحَ عَلَيْكُمْ إِنْ كَانَ بِكُمْ أَذًى مِنْ مَطَرٍ أَوْ كُنْتُمْ مَرْضَى أَنْ تَضَعُوا أَسْلِحَتَكُمْ وَخُذُوا حِذْرَكُمْ إِنَّ اللَّهَ أَعَدَّ لِلْكَافِرِينَ عَذَابًا مُهِينًا (102)","hl":[[543,583,1]]}},{"id":"ق-0287","fp":"47c47f767a02","stateId":731,"easy":"الكفر والتكذيب بآيات الله ← أصحاب الجحيم","cause":"الكفر والتكذيب بآيات الله","result":"أصحاب الجحيم","explicit":true,"repOf":"ق-0007","ref":"سورة المائدة: 10","quran":{"s":5,"from":10,"to":10,"text":"وَالَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا أُولَئِكَ أَصْحَابُ الْجَحِيمِ (10)","hl":[[0,75,1]]}},{"id":"ق-0304","fp":"65494952ebe8","stateId":731,"easy":"الكفر ← لا تُقبل فدية وعذاب أليم مقيم","cause":"الكفر","result":"لا تُقبل فدية وعذاب أليم مقيم","explicit":true,"repOf":"ق-0044","ref":"سورة المائدة: 36","quran":{"s":5,"from":36,"to":36,"text":"إِنَّ الَّذِينَ كَفَرُوا لَوْ أَنَّ لَهُمْ مَا فِي الْأَرْضِ جَمِيعًا وَمِثْلَهُ مَعَهُ لِيَفْتَدُوا بِهِ مِنْ عَذَابِ يَوْمِ الْقِيَامَةِ مَا تُقُبِّلَ مِنْهُمْ وَلَهُمْ عَذَابٌ أَلِيمٌ (36)","hl":[[0,186,1]]}},{"id":"ق-0332","fp":"72f2ca2c7012","stateId":731,"easy":"الكفر والتكذيب بآيات الله ← أصحاب الجحيم","cause":"الكفر والتكذيب بآيات الله","result":"أصحاب الجحيم","explicit":true,"repOf":"ق-0007","ref":"سورة المائدة: 86","quran":{"s":5,"from":86,"to":86,"text":"وَالَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا أُولَئِكَ أَصْحَابُ الْجَحِيمِ (86)","hl":[[0,75,1]]}},{"id":"ق-0343","fp":"bb3b25b44829","stateId":731,"easy":"الكفر بعد رؤية الآية ← عذاب لا يُعذَّبه أحد من العالمين","cause":"الكفر بعد رؤية الآية","result":"عذاب لا يُعذَّبه أحد من العالمين","explicit":true,"ref":"سورة المائدة: 115","srcLabel":"القرآن الكريم","quran":{"s":5,"from":115,"to":115,"text":"قَالَ اللَّهُ إِنِّي مُنَزِّلُهَا عَلَيْكُمْ فَمَنْ يَكْفُرْ بَعْدُ مِنْكُمْ فَإِنِّي أُعَذِّبُهُ عَذَابًا لَا أُعَذِّبُهُ أَحَدًا مِنَ الْعَالَمِينَ (115)","hl":[[45,149,1]]}},{"id":"ق-0357","fp":"8d6f5a76a1f4","stateId":731,"easy":"التكذيب بالآيات والفسق ← مسّ العذاب","cause":"التكذيب بالآيات والفسق","result":"مسّ العذاب","explicit":true,"similar":["ق-0765","ق-1236","ق-1238"],"ref":"سورة الأنعام: 49","srcLabel":"القرآن الكريم","quran":{"s":6,"from":49,"to":49,"text":"وَالَّذِينَ كَذَّبُوا بِآيَاتِنَا يَمَسُّهُمُ الْعَذَابُ بِمَا كَانُوا يَفْسُقُونَ (49)","hl":[[0,82,1]]}},{"id":"ق-0387","fp":"ea8db8b28616","stateId":731,"easy":"التكذيب بآيات الله والصدف عنها ← سوء العذاب","cause":"التكذيب بآيات الله والصدف عنها","result":"سوء العذاب","explicit":true,"repOf":"ق-0007","ref":"سورة الأنعام: 157","quran":{"s":6,"from":157,"to":157,"text":"أَوْ تَقُولُوا لَوْ أَنَّا أُنْزِلَ عَلَيْنَا الْكِتَابُ لَكُنَّا أَهْدَى مِنْهُمْ فَقَدْ جَاءَكُمْ بَيِّنَةٌ مِنْ رَبِّكُمْ وَهُدًى وَرَحْمَةٌ فَمَنْ أَظْلَمُ مِمَّنْ كَذَّبَ بِآيَاتِ اللَّهِ وَصَدَفَ عَنْهَا سَنَجْزِي الَّذِينَ يَصْدِفُونَ عَنْ آيَاتِنَا سُوءَ الْعَذَابِ بِمَا كَانُوا يَصْدِفُونَ (157)","hl":[[144,241,1]]}},{"id":"ق-0395","fp":"1f38bd53c3c5","stateId":731,"easy":"اتباع الشيطان ← جهنم","cause":"اتباع الشيطان","result":"جهنم","explicit":true,"similar":["ق-0712","ق-1070"],"ref":"سورة الأعراف: 18","srcLabel":"القرآن الكريم","quran":{"s":7,"from":18,"to":18,"text":"قَالَ اخْرُجْ مِنْهَا مَذْءُومًا مَدْحُورًا لَمَنْ تَبِعَكَ مِنْهُمْ لَأَمْلَأَنَّ جَهَنَّمَ مِنْكُمْ أَجْمَعِينَ (18)","hl":[[44,113,1]]}},{"id":"ق-0400","fp":"aa656edfa69f","stateId":731,"easy":"التكذيب بالآيات والاستكبار عنها ← الخلود في النار","cause":"التكذيب بالآيات والاستكبار عنها","result":"الخلود في النار","explicit":true,"repOf":"ق-0007","ref":"سورة الأعراف: 36","quran":{"s":7,"from":36,"to":36,"text":"وَالَّذِينَ كَذَّبُوا بِآيَاتِنَا وَاسْتَكْبَرُوا عَنْهَا أُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ (36)","hl":[[0,109,1]]}},{"id":"ق-0453","fp":"3fb71c2a33e1","stateId":731,"easy":"الكفر ← عذاب النار","cause":"الكفر","result":"عذاب النار","explicit":true,"repOf":"ق-0044","ref":"سورة الأنفال: 14","quran":{"s":8,"from":14,"to":14,"text":"ذَلِكُمْ فَذُوقُوهُ وَأَنَّ لِلْكَافِرِينَ عَذَابَ النَّارِ (14)","hl":[[28,59,1]]}},{"id":"ق-0461","fp":"aff822426cae","stateId":731,"easy":"الصد عن المسجد الحرام والكفر ← ذوق العذاب","cause":"الصد عن المسجد الحرام والكفر","result":"ذوق العذاب","explicit":true,"similar":["ق-0675"],"ref":"سورة الأنفال: 34–35","srcLabel":"القرآن الكريم","quran":{"s":8,"from":34,"to":35,"text":"وَمَا لَهُمْ أَلَّا يُعَذِّبَهُمُ اللَّهُ وَهُمْ يَصُدُّونَ عَنِ الْمَسْجِدِ الْحَرَامِ وَمَا كَانُوا أَوْلِيَاءَهُ إِنْ أَوْلِيَاؤُهُ إِلَّا الْمُتَّقُونَ وَلَكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ (34) وَمَا كَانَ صَلَاتُهُمْ عِنْدَ الْبَيْتِ إِلَّا مُكَاءً وَتَصْدِيَةً فَذُوقُوا الْعَذَابَ بِمَا كُنْتُمْ تَكْفُرُونَ (35)","hl":[[0,316,1]]}},{"id":"ق-0482","fp":"b2dbe31886e0","stateId":731,"easy":"التولي والكفر ← عذاب أليم","cause":"التولي والكفر","result":"عذاب أليم","explicit":true,"repOf":"ق-0044","ref":"سورة التوبة: 3","quran":{"s":9,"from":3,"to":3,"text":"وَأَذَانٌ مِنَ اللَّهِ وَرَسُولِهِ إِلَى النَّاسِ يَوْمَ الْحَجِّ الْأَكْبَرِ أَنَّ اللَّهَ بَرِيءٌ مِنَ الْمُشْرِكِينَ وَرَسُولُهُ فَإِنْ تُبْتُمْ فَهُوَ خَيْرٌ لَكُمْ وَإِنْ تَوَلَّيْتُمْ فَاعْلَمُوا أَنَّكُمْ غَيْرُ مُعْجِزِي اللَّهِ وَبَشِّرِ الَّذِينَ كَفَرُوا بِعَذَابٍ أَلِيمٍ (3)","hl":[[169,283,1]]}},{"id":"ق-0506","fp":"7c3d4ce4fbfc","stateId":731,"easy":"إيذاء النبي ﷺ ← عذاب أليم","cause":"إيذاء النبي ﷺ","result":"عذاب أليم","explicit":true,"ref":"سورة التوبة: 61","srcLabel":"القرآن الكريم","quran":{"s":9,"from":61,"to":61,"text":"وَمِنْهُمُ الَّذِينَ يُؤْذُونَ النَّبِيَّ وَيَقُولُونَ هُوَ أُذُنٌ قُلْ أُذُنُ خَيْرٍ لَكُمْ يُؤْمِنُ بِاللَّهِ وَيُؤْمِنُ لِلْمُؤْمِنِينَ وَرَحْمَةٌ لِلَّذِينَ آمَنُوا مِنْكُمْ وَالَّذِينَ يُؤْذُونَ رَسُولَ اللَّهِ لَهُمْ عَذَابٌ أَلِيمٌ (61)","hl":[[178,238,1]]}},{"id":"ق-0507","fp":"2d7ef58d19a5","stateId":731,"easy":"محادّة الله ورسوله ← نار جهنم خالداً فيها والخزي العظيم","cause":"محادّة الله ورسوله","result":"نار جهنم خالداً فيها والخزي العظيم","explicit":true,"ref":"سورة التوبة: 63","srcLabel":"القرآن الكريم","quran":{"s":9,"from":63,"to":63,"text":"أَلَمْ يَعْلَمُوا أَنَّهُ مَنْ يُحَادِدِ اللَّهَ وَرَسُولَهُ فَأَنَّ لَهُ نَارَ جَهَنَّمَ خَالِدًا فِيهَا ذَلِكَ الْخِزْيُ الْعَظِيمُ (63)","hl":[[26,133,1]]}},{"id":"ق-0545","fp":"bfafa876b30f","stateId":731,"easy":"الكفر ← شراب من حميم وعذاب أليم","cause":"الكفر","result":"شراب من حميم وعذاب أليم","explicit":true,"repOf":"ق-0044","ref":"سورة يونس: 4","quran":{"s":10,"from":4,"to":4,"text":"إِلَيْهِ مَرْجِعُكُمْ جَمِيعًا وَعْدَ اللَّهِ حَقًّا إِنَّهُ يَبْدَأُ الْخَلْقَ ثُمَّ يُعِيدُهُ لِيَجْزِيَ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ بِالْقِسْطِ وَالَّذِينَ كَفَرُوا لَهُمْ شَرَابٌ مِنْ حَمِيمٍ وَعَذَابٌ أَلِيمٌ بِمَا كَانُوا يَكْفُرُونَ (4)","hl":[[162,254,1]]}},{"id":"ق-0576","fp":"676a5f145f56","stateId":731,"easy":"التولي عن الاستغفار والتوبة ← عذاب يوم كبير","cause":"التولي عن الاستغفار والتوبة","result":"عذاب يوم كبير","explicit":true,"ref":"سورة هود: 3","srcLabel":"القرآن الكريم","quran":{"s":11,"from":3,"to":3,"text":"وَأَنِ اسْتَغْفِرُوا رَبَّكُمْ ثُمَّ تُوبُوا إِلَيْهِ يُمَتِّعْكُمْ مَتَاعًا حَسَنًا إِلَى أَجَلٍ مُسَمًّى وَيُؤْتِ كُلَّ ذِي فَضْلٍ فَضْلَهُ وَإِنْ تَوَلَّوْا فَإِنِّي أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ كَبِيرٍ (3)","hl":[[142,210,1]]}},{"id":"ق-0579","fp":"99e0a0eb89a7","stateId":731,"easy":"الكفر بالقرآن ← النار موعده","cause":"الكفر بالقرآن","result":"النار موعده","explicit":true,"ref":"سورة هود: 17","srcLabel":"القرآن الكريم","quran":{"s":11,"from":17,"to":17,"text":"أَفَمَنْ كَانَ عَلَى بَيِّنَةٍ مِنْ رَبِّهِ وَيَتْلُوهُ شَاهِدٌ مِنْهُ وَمِنْ قَبْلِهِ كِتَابُ مُوسَى إِمَامًا وَرَحْمَةً أُولَئِكَ يُؤْمِنُونَ بِهِ وَمَنْ يَكْفُرْ بِهِ مِنَ الْأَحْزَابِ فَالنَّارُ مَوْعِدُهُ فَلَا تَكُ فِي مِرْيَةٍ مِنْهُ إِنَّهُ الْحَقُّ مِنْ رَبِّكَ وَلَكِنَّ أَكْثَرَ النَّاسِ لَا يُؤْمِنُونَ (17)","hl":[[149,314,1]]}},{"id":"ق-0624","fp":"910d0d6a95b6","stateId":731,"easy":"عدم الاستجابة لله ← لا تقبل الفدية وسوء الحساب وجهنم","cause":"عدم الاستجابة لله","result":"لا تقبل الفدية وسوء الحساب وجهنم","explicit":true,"ref":"سورة الرعد: 18","srcLabel":"القرآن الكريم","quran":{"s":13,"from":18,"to":18,"text":"لِلَّذِينَ اسْتَجَابُوا لِرَبِّهِمُ الْحُسْنَى وَالَّذِينَ لَمْ يَسْتَجِيبُوا لَهُ لَوْ أَنَّ لَهُمْ مَا فِي الْأَرْضِ جَمِيعًا وَمِثْلَهُ مَعَهُ لَافْتَدَوْا بِهِ أُولَئِكَ لَهُمْ سُوءُ الْحِسَابِ وَمَأْوَاهُمْ جَهَنَّمُ وَبِئْسَ الْمِهَادُ (18)","hl":[[47,241,1]]}},{"id":"ق-0634","fp":"238b9cd71a77","stateId":731,"easy":"الكفر ← عقباهم النار","cause":"الكفر","result":"عقباهم النار","explicit":true,"repOf":"ق-0044","ref":"سورة الرعد: 35","quran":{"s":13,"from":35,"to":35,"text":"مَثَلُ الْجَنَّةِ الَّتِي وُعِدَ الْمُتَّقُونَ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ أُكُلُهَا دَائِمٌ وَظِلُّهَا تِلْكَ عُقْبَى الَّذِينَ اتَّقَوْا وَعُقْبَى الْكَافِرِينَ النَّارُ (35)","hl":[[147,179,1]]}},{"id":"ق-0650","fp":"8578dd3d3a98","stateId":731,"easy":"تبديل نعمة الله كفراً ← دار البوار جهنم","cause":"تبديل نعمة الله كفراً","result":"دار البوار جهنم","explicit":true,"otherNeedIds":[61],"ref":"سورة إبراهيم: 28–29","srcLabel":"القرآن الكريم","quran":{"s":14,"from":28,"to":29,"text":"أَلَمْ تَرَ إِلَى الَّذِينَ بَدَّلُوا نِعْمَتَ اللَّهِ كُفْرًا وَأَحَلُّوا قَوْمَهُمْ دَارَ الْبَوَارِ (28) جَهَنَّمَ يَصْلَوْنَهَا وَبِئْسَ الْقَرَارُ (29)","hl":[[0,151,1]]}},{"id":"ق-0675","fp":"ab5e53312a6c","stateId":731,"easy":"الكفر والصد عن سبيل الله ← زيادة عذاب فوق العذاب","cause":"الكفر والصد عن سبيل الله","result":"زيادة عذاب فوق العذاب","explicit":true,"repOf":"ق-0461","ref":"سورة النحل: 88","quran":{"s":16,"from":88,"to":88,"text":"الَّذِينَ كَفَرُوا وَصَدُّوا عَنْ سَبِيلِ اللَّهِ زِدْنَاهُمْ عَذَابًا فَوْقَ الْعَذَابِ بِمَا كَانُوا يُفْسِدُونَ (88)","hl":[[0,114,1]]}},{"id":"ق-0697","fp":"41424bfc5de1","stateId":731,"easy":"عدم الإيمان بالآخرة ← عذاب أليم","cause":"عدم الإيمان بالآخرة","result":"عذاب أليم","explicit":true,"ref":"سورة الإسراء: 10","srcLabel":"القرآن الكريم","quran":{"s":17,"from":10,"to":10,"text":"وَأَنَّ الَّذِينَ لَا يُؤْمِنُونَ بِالْآخِرَةِ أَعْتَدْنَا لَهُمْ عَذَابًا أَلِيمًا (10)","hl":[[8,83,1]]}},{"id":"ق-0712","fp":"2bdbc91cf421","stateId":731,"easy":"اتباع الشيطان ← جهنم جزاء موفوراً","cause":"اتباع الشيطان","result":"جهنم جزاء موفوراً","explicit":true,"repOf":"ق-0395","ref":"سورة الإسراء: 63","quran":{"s":17,"from":63,"to":63,"text":"قَالَ اذْهَبْ فَمَنْ تَبِعَكَ مِنْهُمْ فَإِنَّ جَهَنَّمَ جَزَاؤُكُمْ جَزَاءً مَوْفُورًا (63)","hl":[[14,87,1]]}},{"id":"ق-0721","fp":"c091fdc1abf6","stateId":731,"easy":"الكفر بالآيات وإنكار البعث ← الحشر على الوجوه عمياً وبكماً وصماً ومأواهم جهنم","cause":"الكفر بالآيات وإنكار البعث","result":"الحشر على الوجوه عمياً وبكماً وصماً ومأواهم جهنم","explicit":true,"ref":"سورة الإسراء: 97–98","srcLabel":"القرآن الكريم","quran":{"s":17,"from":97,"to":98,"text":"وَمَنْ يَهْدِ اللَّهُ فَهُوَ الْمُهْتَدِ وَمَنْ يُضْلِلْ فَلَنْ تَجِدَ لَهُمْ أَوْلِيَاءَ مِنْ دُونِهِ وَنَحْشُرُهُمْ يَوْمَ الْقِيَامَةِ عَلَى وُجُوهِهِمْ عُمْيًا وَبُكْمًا وَصُمًّا مَأْوَاهُمْ جَهَنَّمُ كُلَّمَا خَبَتْ زِدْنَاهُمْ سَعِيرًا (97) ذَلِكَ جَزَاؤُهُمْ بِأَنَّهُمْ كَفَرُوا بِآيَاتِنَا وَقَالُوا أَإِذَا كُنَّا عِظَامًا وَرُفَاتًا أَإِنَّا لَمَبْعُوثُونَ خَلْقًا جَدِيدًا (98)","hl":[[103,384,1]]}},{"id":"ق-0740","fp":"a44685216f82","stateId":731,"easy":"الكفر ← جهنم نُزلاً","cause":"الكفر","result":"جهنم نُزلاً","explicit":true,"similar":["ق-1100"],"ref":"سورة الكهف: 102","srcLabel":"القرآن الكريم","quran":{"s":18,"from":102,"to":102,"text":"أَفَحَسِبَ الَّذِينَ كَفَرُوا أَنْ يَتَّخِذُوا عِبَادِي مِنْ دُونِي أَوْلِيَاءَ إِنَّا أَعْتَدْنَا جَهَنَّمَ لِلْكَافِرِينَ نُزُلًا (102)","hl":[[80,131,1]]}},{"id":"ق-0746","fp":"4ed0c712225a","stateId":731,"easy":"الكفر ← ويل من مشهد يوم عظيم","cause":"الكفر","result":"ويل من مشهد يوم عظيم","explicit":true,"ref":"سورة مريم: 37","srcLabel":"القرآن الكريم","quran":{"s":19,"from":37,"to":37,"text":"فَاخْتَلَفَ الْأَحْزَابُ مِنْ بَيْنِهِمْ فَوَيْلٌ لِلَّذِينَ كَفَرُوا مِنْ مَشْهَدِ يَوْمٍ عَظِيمٍ (37)","hl":[[41,98,1]]}},{"id":"ق-0765","fp":"c4111a754805","stateId":731,"easy":"التكذيب والتولي ← العذاب","cause":"التكذيب والتولي","result":"العذاب","explicit":true,"repOf":"ق-0357","ref":"سورة طه: 48","quran":{"s":20,"from":48,"to":48,"text":"إِنَّا قَدْ أُوحِيَ إِلَيْنَا أَنَّ الْعَذَابَ عَلَى مَنْ كَذَّبَ وَتَوَلَّى (48)","hl":[[30,76,1]]}},{"id":"ق-0780","fp":"7e427093439b","stateId":731,"easy":"الإسراف وعدم الإيمان بآيات الله ← عذاب الآخرة أشد وأبقى","cause":"الإسراف وعدم الإيمان بآيات الله","result":"عذاب الآخرة أشد وأبقى","explicit":true,"ref":"سورة طه: 127","srcLabel":"القرآن الكريم","quran":{"s":20,"from":127,"to":127,"text":"وَكَذَلِكَ نَجْزِي مَنْ أَسْرَفَ وَلَمْ يُؤْمِنْ بِآيَاتِ رَبِّهِ وَلَعَذَابُ الْآخِرَةِ أَشَدُّ وَأَبْقَى (127)","hl":[[0,106,1]]}},{"id":"ق-0806","fp":"5f1b481a0461","stateId":731,"easy":"الكفر ← ثياب من نار والحميم ومقامع من حديد","cause":"الكفر","result":"ثياب من نار والحميم ومقامع من حديد","explicit":true,"ref":"سورة الحج: 19–22","srcLabel":"القرآن الكريم","quran":{"s":22,"from":19,"to":22,"text":"هَذَانِ خَصْمَانِ اخْتَصَمُوا فِي رَبِّهِمْ فَالَّذِينَ كَفَرُوا قُطِّعَتْ لَهُمْ ثِيَابٌ مِنْ نَارٍ يُصَبُّ مِنْ فَوْقِ رُءُوسِهِمُ الْحَمِيمُ (19) يُصْهَرُ بِهِ مَا فِي بُطُونِهِمْ وَالْجُلُودُ (20) وَلَهُمْ مَقَامِعُ مِنْ حَدِيدٍ (21) كُلَّمَا أَرَادُوا أَنْ يَخْرُجُوا مِنْهَا مِنْ غَمٍّ أُعِيدُوا فِيهَا وَذُوقُوا عَذَابَ الْحَرِيقِ (22)","hl":[[44,337,1]]}},{"id":"ق-0823","fp":"d46fdbe68a28","stateId":731,"easy":"السعي في إبطال آيات الله ← أصحاب الجحيم","cause":"السعي في إبطال آيات الله","result":"أصحاب الجحيم","explicit":true,"ref":"سورة الحج: 51","srcLabel":"القرآن الكريم","quran":{"s":22,"from":51,"to":51,"text":"وَالَّذِينَ سَعَوْا فِي آيَاتِنَا مُعَاجِزِينَ أُولَئِكَ أَصْحَابُ الْجَحِيمِ (51)","hl":[[0,77,1]]}},{"id":"ق-0827","fp":"0cad94c2f0ef","stateId":731,"easy":"الكفر والتكذيب بآيات الله ← عذاب مهين","cause":"الكفر والتكذيب بآيات الله","result":"عذاب مهين","explicit":true,"repOf":"ق-0007","ref":"سورة الحج: 57","quran":{"s":22,"from":57,"to":57,"text":"وَالَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا فَأُولَئِكَ لَهُمْ عَذَابٌ مُهِينٌ (57)","hl":[[0,79,1]]}},{"id":"ق-0871","fp":"49dd4c953f5a","stateId":731,"easy":"التكذيب بالساعة ← السعير","cause":"التكذيب بالساعة","result":"السعير","explicit":true,"ref":"سورة الفرقان: 11","srcLabel":"القرآن الكريم","quran":{"s":25,"from":11,"to":11,"text":"بَلْ كَذَّبُوا بِالسَّاعَةِ وَأَعْتَدْنَا لِمَنْ كَذَّبَ بِالسَّاعَةِ سَعِيرًا (11)","hl":[[28,78,1]]}},{"id":"ق-0890","fp":"1a5b19dfb4d4","stateId":731,"easy":"الغواية ← إبراز الجحيم","cause":"الغواية","result":"إبراز الجحيم","explicit":true,"ref":"سورة الشعراء: 91","srcLabel":"القرآن الكريم","quran":{"s":26,"from":91,"to":91,"text":"وَبُرِّزَتِ الْجَحِيمُ لِلْغَاوِينَ (91)","hl":[[0,35,1]]}},{"id":"ق-0907","fp":"deff100a96a5","stateId":731,"easy":"الظلم بالتكذيب ← وقوع القول عليهم","cause":"الظلم بالتكذيب","result":"وقوع القول عليهم","explicit":true,"ref":"سورة النمل: 85","srcLabel":"القرآن الكريم","quran":{"s":27,"from":85,"to":85,"text":"وَوَقَعَ الْقَوْلُ عَلَيْهِمْ بِمَا ظَلَمُوا فَهُمْ لَا يَنْطِقُونَ (85)","hl":[[0,67,1]]}},{"id":"ق-0942","fp":"4e5be44b6b0e","stateId":731,"easy":"الكفر بآيات الله ولقائه ← اليأس من رحمة الله وعذاب أليم","cause":"الكفر بآيات الله ولقائه","result":"اليأس من رحمة الله وعذاب أليم","explicit":true,"repOf":"ق-0007","otherNeedIds":[10],"ref":"سورة العنكبوت: 23","quran":{"s":29,"from":23,"to":23,"text":"وَالَّذِينَ كَفَرُوا بِآيَاتِ اللَّهِ وَلِقَائِهِ أُولَئِكَ يَئِسُوا مِنْ رَحْمَتِي وَأُولَئِكَ لَهُمْ عَذَابٌ أَلِيمٌ (23)","hl":[[0,118,1]]}},{"id":"ق-0955","fp":"6bdf52a513a0","stateId":731,"easy":"الكفر والتكذيب بآيات الله ← في العذاب محضرون","cause":"الكفر والتكذيب بآيات الله","result":"في العذاب محضرون","explicit":true,"repOf":"ق-0007","ref":"سورة الروم: 16","quran":{"s":30,"from":16,"to":16,"text":"وَأَمَّا الَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا وَلِقَاءِ الْآخِرَةِ فَأُولَئِكَ فِي الْعَذَابِ مُحْضَرُونَ (16)","hl":[[0,111,1]]}},{"id":"ق-0970","fp":"c80b00d375a4","stateId":731,"easy":"شراء لهو الحديث للإضلال والاستكبار عن آيات الله ← عذاب مهين وأليم","cause":"شراء لهو الحديث للإضلال والاستكبار عن آيات الله","result":"عذاب مهين وأليم","explicit":true,"ref":"سورة لقمان: 6–7","srcLabel":"القرآن الكريم","quran":{"s":31,"from":6,"to":7,"text":"وَمِنَ النَّاسِ مَنْ يَشْتَرِي لَهْوَ الْحَدِيثِ لِيُضِلَّ عَنْ سَبِيلِ اللَّهِ بِغَيْرِ عِلْمٍ وَيَتَّخِذَهَا هُزُوًا أُولَئِكَ لَهُمْ عَذَابٌ مُهِينٌ (6) وَإِذَا تُتْلَى عَلَيْهِ آيَاتُنَا وَلَّى مُسْتَكْبِرًا كَأَنْ لَمْ يَسْمَعْهَا كَأَنَّ فِي أُذُنَيْهِ وَقْرًا فَبَشِّرْهُ بِعَذَابٍ أَلِيمٍ (7)","hl":[[0,296,1]]}},{"id":"ق-0976","fp":"fcb16723add3","stateId":731,"easy":"الكفر ← متاع قليل ثم عذاب غليظ","cause":"الكفر","result":"متاع قليل ثم عذاب غليظ","explicit":true,"repOf":"ق-0044","ref":"سورة لقمان: 23–24","quran":{"s":31,"from":23,"to":24,"text":"وَمَنْ كَفَرَ فَلَا يَحْزُنْكَ كُفْرُهُ إِلَيْنَا مَرْجِعُهُمْ فَنُنَبِّئُهُمْ بِمَا عَمِلُوا إِنَّ اللَّهَ عَلِيمٌ بِذَاتِ الصُّدُورِ (23) نُمَتِّعُهُمْ قَلِيلًا ثُمَّ نَضْطَرُّهُمْ إِلَى عَذَابٍ غَلِيظٍ (24)","hl":[[0,204,1]]}},{"id":"ق-0985","fp":"91b40ddd078e","stateId":731,"easy":"الكفر ← عذاب أليم","cause":"الكفر","result":"عذاب أليم","explicit":true,"repOf":"ق-0044","ref":"سورة الأحزاب: 8","quran":{"s":33,"from":8,"to":8,"text":"لِيَسْأَلَ الصَّادِقِينَ عَنْ صِدْقِهِمْ وَأَعَدَّ لِلْكَافِرِينَ عَذَابًا أَلِيمًا (8)","hl":[[41,83,1]]}},{"id":"ق-1006","fp":"1265e2b61659","stateId":731,"easy":"السعي في إبطال آيات الله ← عذاب من رجز أليم","cause":"السعي في إبطال آيات الله","result":"عذاب من رجز أليم","explicit":true,"similar":["ق-1014"],"ref":"سورة سبأ: 5","srcLabel":"القرآن الكريم","quran":{"s":34,"from":5,"to":5,"text":"وَالَّذِينَ سَعَوْا فِي آيَاتِنَا مُعَاجِزِينَ أُولَئِكَ لَهُمْ عَذَابٌ مِنْ رِجْزٍ أَلِيمٌ (5)","hl":[[0,91,1]]}},{"id":"ق-1014","fp":"bd2e6970b007","stateId":731,"easy":"السعي في إبطال آيات الله ← الإحضار في العذاب","cause":"السعي في إبطال آيات الله","result":"الإحضار في العذاب","explicit":true,"repOf":"ق-1006","ref":"سورة سبأ: 38","quran":{"s":34,"from":38,"to":38,"text":"وَالَّذِينَ يَسْعَوْنَ فِي آيَاتِنَا مُعَاجِزِينَ أُولَئِكَ فِي الْعَذَابِ مُحْضَرُونَ (38)","hl":[[0,86,1]]}},{"id":"ق-1019","fp":"e7be0b1e7339","stateId":731,"easy":"اتباع الشيطان والدخول في حزبه ← أصحاب السعير","cause":"اتباع الشيطان والدخول في حزبه","result":"أصحاب السعير","explicit":true,"otherNeedIds":[34],"ref":"سورة فاطر: 6","srcLabel":"القرآن الكريم","quran":{"s":35,"from":6,"to":6,"text":"إِنَّ الشَّيْطَانَ لَكُمْ عَدُوٌّ فَاتَّخِذُوهُ عَدُوًّا إِنَّمَا يَدْعُو حِزْبَهُ لِيَكُونُوا مِنْ أَصْحَابِ السَّعِيرِ (6)","hl":[[0,120,1]]}},{"id":"ق-1020","fp":"c7e96bd912ba","stateId":731,"easy":"الكفر ← عذاب شديد","cause":"الكفر","result":"عذاب شديد","explicit":true,"repOf":"ق-0133","ref":"سورة فاطر: 7","quran":{"s":35,"from":7,"to":7,"text":"الَّذِينَ كَفَرُوا لَهُمْ عَذَابٌ شَدِيدٌ وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ مَغْفِرَةٌ وَأَجْرٌ كَبِيرٌ (7)","hl":[[0,41,1]]}},{"id":"ق-1030","fp":"7fcbe5794760","stateId":731,"easy":"الكفر ← نار جهنم لا يقضى عليهم ولا يخفف من عذابها","cause":"الكفر","result":"نار جهنم لا يقضى عليهم ولا يخفف من عذابها","explicit":true,"repOf":"ق-0044","ref":"سورة فاطر: 36","quran":{"s":35,"from":36,"to":36,"text":"وَالَّذِينَ كَفَرُوا لَهُمْ نَارُ جَهَنَّمَ لَا يُقْضَى عَلَيْهِمْ فَيَمُوتُوا وَلَا يُخَفَّفُ عَنْهُمْ مِنْ عَذَابِهَا كَذَلِكَ نَجْزِي كُلَّ كَفُورٍ (36)","hl":[[0,150,1]]}},{"id":"ق-1044","fp":"ddb794dc7249","stateId":731,"easy":"تقليد الآباء الضالين ← شجرة الزقوم والحميم والجحيم","cause":"تقليد الآباء الضالين","result":"شجرة الزقوم والحميم والجحيم","explicit":true,"ref":"سورة الصافات: 62–70","srcLabel":"القرآن الكريم","quran":{"s":37,"from":62,"to":70,"text":"أَذَلِكَ خَيْرٌ نُزُلًا أَمْ شَجَرَةُ الزَّقُّومِ (62) إِنَّا جَعَلْنَاهَا فِتْنَةً لِلظَّالِمِينَ (63) إِنَّهَا شَجَرَةٌ تَخْرُجُ فِي أَصْلِ الْجَحِيمِ (64) طَلْعُهَا كَأَنَّهُ رُءُوسُ الشَّيَاطِينِ (65) فَإِنَّهُمْ لَآكِلُونَ مِنْهَا فَمَالِئُونَ مِنْهَا الْبُطُونَ (66) ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِنْ حَمِيمٍ (67) ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى الْجَحِيمِ (68) إِنَّهُمْ أَلْفَوْا آبَاءَهُمْ ضَالِّينَ (69) فَهُمْ عَلَى آثَارِهِمْ يُهْرَعُونَ (70)","hl":[[0,460,1]]}},{"id":"ق-1052","fp":"e105493d1cc1","stateId":731,"easy":"التكذيب ← الإحضار للعذاب إلا المخلصين","cause":"التكذيب","result":"الإحضار للعذاب إلا المخلصين","explicit":true,"ref":"سورة الصافات: 127–128","srcLabel":"القرآن الكريم","quran":{"s":37,"from":127,"to":128,"text":"فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ (127) إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ (128)","hl":[[0,82,1]]}},{"id":"ق-1062","fp":"ff8c805dc427","stateId":731,"easy":"الكفر ← ويل من النار","cause":"الكفر","result":"ويل من النار","explicit":true,"repOf":"ق-0044","ref":"سورة ص: 27","quran":{"s":38,"from":27,"to":27,"text":"وَمَا خَلَقْنَا السَّمَاءَ وَالْأَرْضَ وَمَا بَيْنَهُمَا بَاطِلًا ذَلِكَ ظَنُّ الَّذِينَ كَفَرُوا فَوَيْلٌ لِلَّذِينَ كَفَرُوا مِنَ النَّارِ (27)","hl":[[98,140,1]]}},{"id":"ق-1070","fp":"ab3b607aa62f","stateId":731,"easy":"اتباع إبليس ← جهنم","cause":"اتباع إبليس","result":"جهنم","explicit":true,"repOf":"ق-0395","ref":"سورة ص: 85","quran":{"s":38,"from":85,"to":85,"text":"لَأَمْلَأَنَّ جَهَنَّمَ مِنْكَ وَمِمَّنْ تَبِعَكَ مِنْهُمْ أَجْمَعِينَ (85)","hl":[[0,70,1]]}},{"id":"ق-1086","fp":"5527f8220187","stateId":731,"easy":"الكذب على الله والتكذيب بالصدق ← مثوى في جهنم","cause":"الكذب على الله والتكذيب بالصدق","result":"مثوى في جهنم","explicit":true,"ref":"سورة الزمر: 32","srcLabel":"القرآن الكريم","quran":{"s":39,"from":32,"to":32,"text":"فَمَنْ أَظْلَمُ مِمَّنْ كَذَبَ عَلَى اللَّهِ وَكَذَّبَ بِالصِّدْقِ إِذْ جَاءَهُ أَلَيْسَ فِي جَهَنَّمَ مَثْوًى لِلْكَافِرِينَ (32)","hl":[[0,125,1]]}},{"id":"ق-1100","fp":"23bcabd5e8c1","stateId":731,"easy":"الكفر ← السَّوق إلى جهنم زمراً","cause":"الكفر","result":"السَّوق إلى جهنم زمراً","explicit":true,"repOf":"ق-0740","ref":"سورة الزمر: 71–72","quran":{"s":39,"from":71,"to":72,"text":"وَسِيقَ الَّذِينَ كَفَرُوا إِلَى جَهَنَّمَ زُمَرًا حَتَّى إِذَا جَاءُوهَا فُتِحَتْ أَبْوَابُهَا وَقَالَ لَهُمْ خَزَنَتُهَا أَلَمْ يَأْتِكُمْ رُسُلٌ مِنْكُمْ يَتْلُونَ عَلَيْكُمْ آيَاتِ رَبِّكُمْ وَيُنْذِرُونَكُمْ لِقَاءَ يَوْمِكُمْ هَذَا قَالُوا بَلَى وَلَكِنْ حَقَّتْ كَلِمَةُ الْعَذَابِ عَلَى الْكَافِرِينَ (71) قِيلَ ادْخُلُوا أَبْوَابَ جَهَنَّمَ خَالِدِينَ فِيهَا فَبِئْسَ مَثْوَى الْمُتَكَبِّرِينَ (72)","hl":[[0,402,1]]}},{"id":"ق-1116","fp":"400d40b133c7","stateId":731,"easy":"اتباع المستكبرين ← لا يغنون عنهم نصيباً من النار","cause":"اتباع المستكبرين","result":"لا يغنون عنهم نصيباً من النار","explicit":true,"otherNeedIds":[57],"ref":"سورة غافر: 47–48","srcLabel":"القرآن الكريم","quran":{"s":40,"from":47,"to":48,"text":"وَإِذْ يَتَحَاجُّونَ فِي النَّارِ فَيَقُولُ الضُّعَفَاءُ لِلَّذِينَ اسْتَكْبَرُوا إِنَّا كُنَّا لَكُمْ تَبَعًا فَهَلْ أَنْتُمْ مُغْنُونَ عَنَّا نَصِيبًا مِنَ النَّارِ (47) قَالَ الَّذِينَ اسْتَكْبَرُوا إِنَّا كُلٌّ فِيهَا إِنَّ اللَّهَ قَدْ حَكَمَ بَيْنَ الْعِبَادِ (48)","hl":[[0,265,1]]}},{"id":"ق-1123","fp":"33763b10417c","stateId":731,"easy":"الجدال في آيات الله والتكذيب بالكتاب ← الأغلال والسلاسل والسحب في الحميم والسجر في النار","cause":"الجدال في آيات الله والتكذيب بالكتاب","result":"الأغلال والسلاسل والسحب في الحميم والسجر في النار","explicit":true,"ref":"سورة غافر: 69–72","srcLabel":"القرآن الكريم","quran":{"s":40,"from":69,"to":72,"text":"أَلَمْ تَرَ إِلَى الَّذِينَ يُجَادِلُونَ فِي آيَاتِ اللَّهِ أَنَّى يُصْرَفُونَ (69) الَّذِينَ كَذَّبُوا بِالْكِتَابِ وَبِمَا أَرْسَلْنَا بِهِ رُسُلَنَا فَسَوْفَ يَعْلَمُونَ (70) إِذِ الْأَغْلَالُ فِي أَعْنَاقِهِمْ وَالسَّلَاسِلُ يُسْحَبُونَ (71) فِي الْحَمِيمِ ثُمَّ فِي النَّارِ يُسْجَرُونَ (72)","hl":[[0,291,1]]}},{"id":"ق-1134","fp":"fe6544edbc78","stateId":731,"easy":"اللغو في القرآن وجحود الآيات ← أسوأ الجزاء: النار دار الخلد","cause":"اللغو في القرآن وجحود الآيات","result":"أسوأ الجزاء: النار دار الخلد","explicit":true,"ref":"سورة فصلت: 26–28","srcLabel":"القرآن الكريم","quran":{"s":41,"from":26,"to":28,"text":"وَقَالَ الَّذِينَ كَفَرُوا لَا تَسْمَعُوا لِهَذَا الْقُرْآنِ وَالْغَوْا فِيهِ لَعَلَّكُمْ تَغْلِبُونَ (26) فَلَنُذِيقَنَّ الَّذِينَ كَفَرُوا عَذَابًا شَدِيدًا وَلَنَجْزِيَنَّهُمْ أَسْوَأَ الَّذِي كَانُوا يَعْمَلُونَ (27) ذَلِكَ جَزَاءُ أَعْدَاءِ اللَّهِ النَّارُ لَهُمْ فِيهَا دَارُ الْخُلْدِ جَزَاءً بِمَا كَانُوا بِآيَاتِنَا يَجْحَدُونَ (28)","hl":[[0,338,1]]}},{"id":"ق-1138","fp":"013a0ebdfc47","stateId":731,"easy":"الإلحاد في آيات الله والكفر بالذكر ← الإلقاء في النار","cause":"الإلحاد في آيات الله والكفر بالذكر","result":"الإلقاء في النار","explicit":true,"ref":"سورة فصلت: 40","srcLabel":"القرآن الكريم","quran":{"s":41,"from":40,"to":40,"text":"إِنَّ الَّذِينَ يُلْحِدُونَ فِي آيَاتِنَا لَا يَخْفَوْنَ عَلَيْنَا أَفَمَنْ يُلْقَى فِي النَّارِ خَيْرٌ أَمْ مَنْ يَأْتِي آمِنًا يَوْمَ الْقِيَامَةِ اعْمَلُوا مَا شِئْتُمْ إِنَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ (40)","hl":[[0,148,1]]}},{"id":"ق-1143","fp":"923afae988ba","stateId":731,"easy":"نسبة النعمة إلى النفس وإنكار الساعة بعد الرحمة ← عذاب غليظ","cause":"نسبة النعمة إلى النفس وإنكار الساعة بعد الرحمة","result":"عذاب غليظ","explicit":true,"ref":"سورة فصلت: 50","srcLabel":"القرآن الكريم","quran":{"s":41,"from":50,"to":50,"text":"وَلَئِنْ أَذَقْنَاهُ رَحْمَةً مِنَّا مِنْ بَعْدِ ضَرَّاءَ مَسَّتْهُ لَيَقُولَنَّ هَذَا لِي وَمَا أَظُنُّ السَّاعَةَ قَائِمَةً وَلَئِنْ رُجِعْتُ إِلَى رَبِّي إِنَّ لِي عِنْدَهُ لَلْحُسْنَى فَلَنُنَبِّئَنَّ الَّذِينَ كَفَرُوا بِمَا عَمِلُوا وَلَنُذِيقَنَّهُمْ مِنْ عَذَابٍ غَلِيظٍ (50)","hl":[[0,278,1]]}},{"id":"ق-1155","fp":"b6695cadda4f","stateId":731,"easy":"الكفر ← عذاب شديد","cause":"الكفر","result":"عذاب شديد","explicit":true,"repOf":"ق-0133","ref":"سورة الشورى: 26","quran":{"s":42,"from":26,"to":26,"text":"وَيَسْتَجِيبُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَيَزِيدُهُمْ مِنْ فَضْلِهِ وَالْكَافِرُونَ لَهُمْ عَذَابٌ شَدِيدٌ (26)","hl":[[85,123,1]]}},{"id":"ق-1183","fp":"29df5f37acd9","stateId":731,"easy":"الكفر بآيات الله ← عذاب من رجز أليم","cause":"الكفر بآيات الله","result":"عذاب من رجز أليم","explicit":true,"repOf":"ق-0007","ref":"سورة الجاثية: 11","quran":{"s":45,"from":11,"to":11,"text":"هَذَا هُدًى وَالَّذِينَ كَفَرُوا بِآيَاتِ رَبِّهِمْ لَهُمْ عَذَابٌ مِنْ رِجْزٍ أَلِيمٌ (11)","hl":[[12,86,1]]}},{"id":"ق-1213","fp":"5785aeabafd0","stateId":731,"easy":"الكفر ← تمتّع وأكل كالأنعام والنار مثوى لهم","cause":"الكفر","result":"تمتّع وأكل كالأنعام والنار مثوى لهم","explicit":true,"ref":"سورة محمد: 12","srcLabel":"القرآن الكريم","quran":{"s":47,"from":12,"to":12,"text":"إِنَّ اللَّهَ يُدْخِلُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ وَالَّذِينَ كَفَرُوا يَتَمَتَّعُونَ وَيَأْكُلُونَ كَمَا تَأْكُلُ الْأَنْعَامُ وَالنَّارُ مَثْوًى لَهُمْ (12)","hl":[[111,214,1]]}},{"id":"ق-1224","fp":"6beb6f35bd14","stateId":731,"easy":"الكفر والصد عن سبيل الله ثم الموت على الكفر ← لن يغفر الله لهم","cause":"الكفر والصد عن سبيل الله ثم الموت على الكفر","result":"لن يغفر الله لهم","explicit":true,"ref":"سورة محمد: 34","srcLabel":"القرآن الكريم","quran":{"s":47,"from":34,"to":34,"text":"إِنَّ الَّذِينَ كَفَرُوا وَصَدُّوا عَنْ سَبِيلِ اللَّهِ ثُمَّ مَاتُوا وَهُمْ كُفَّارٌ فَلَنْ يَغْفِرَ اللَّهُ لَهُمْ (34)","hl":[[0,116,1]]}},{"id":"ق-1234","fp":"9824e5a4153b","stateId":731,"easy":"عدم الإيمان بالله ورسوله ← السعير","cause":"عدم الإيمان بالله ورسوله","result":"السعير","explicit":true,"ref":"سورة الفتح: 13","srcLabel":"القرآن الكريم","quran":{"s":48,"from":13,"to":13,"text":"وَمَنْ لَمْ يُؤْمِنْ بِاللَّهِ وَرَسُولِهِ فَإِنَّا أَعْتَدْنَا لِلْكَافِرِينَ سَعِيرًا (13)","hl":[[0,87,1]]}},{"id":"ق-1236","fp":"724fc99b038d","stateId":731,"easy":"التولي ← عذاب أليم","cause":"التولي","result":"عذاب أليم","explicit":true,"repOf":"ق-0357","ref":"سورة الفتح: 16","quran":{"s":48,"from":16,"to":16,"text":"قُلْ لِلْمُخَلَّفِينَ مِنَ الْأَعْرَابِ سَتُدْعَوْنَ إِلَى قَوْمٍ أُولِي بَأْسٍ شَدِيدٍ تُقَاتِلُونَهُمْ أَوْ يُسْلِمُونَ فَإِنْ تُطِيعُوا يُؤْتِكُمُ اللَّهُ أَجْرًا حَسَنًا وَإِنْ تَتَوَلَّوْا كَمَا تَوَلَّيْتُمْ مِنْ قَبْلُ يُعَذِّبْكُمْ عَذَابًا أَلِيمًا (16)","hl":[[174,257,1]]}},{"id":"ق-1238","fp":"ca9d5c6cc76d","stateId":731,"easy":"التولي ← عذاب أليم","cause":"التولي","result":"عذاب أليم","explicit":true,"repOf":"ق-0357","ref":"سورة الفتح: 17","quran":{"s":48,"from":17,"to":17,"text":"لَيْسَ عَلَى الْأَعْمَى حَرَجٌ وَلَا عَلَى الْأَعْرَجِ حَرَجٌ وَلَا عَلَى الْمَرِيضِ حَرَجٌ وَمَنْ يُطِعِ اللَّهَ وَرَسُولَهُ يُدْخِلْهُ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ وَمَنْ يَتَوَلَّ يُعَذِّبْهُ عَذَابًا أَلِيمًا (17)","hl":[[182,228,1]]}},{"id":"ق-1255","fp":"0d44d9e56257","stateId":731,"easy":"الكفر والعناد ومنع الخير والاعتداء والريبة والشرك ← العذاب الشديد في جهنم","cause":"الكفر والعناد ومنع الخير والاعتداء والريبة والشرك","result":"العذاب الشديد في جهنم","explicit":true,"ref":"سورة ق: 24–26","srcLabel":"القرآن الكريم","quran":{"s":50,"from":24,"to":26,"text":"أَلْقِيَا فِي جَهَنَّمَ كُلَّ كَفَّارٍ عَنِيدٍ (24) مَنَّاعٍ لِلْخَيْرِ مُعْتَدٍ مُرِيبٍ (25) الَّذِي جَعَلَ مَعَ اللَّهِ إِلَهًا آخَرَ فَأَلْقِيَاهُ فِي الْعَذَابِ الشَّدِيدِ (26)","hl":[[0,175,1]]}},{"id":"ق-1267","fp":"99b96098f17f","stateId":731,"easy":"التكذيب والخوض واللعب ← الويل والدعّ إلى نار جهنم","cause":"التكذيب والخوض واللعب","result":"الويل والدعّ إلى نار جهنم","explicit":true,"ref":"سورة الطور: 11–16","srcLabel":"القرآن الكريم","quran":{"s":52,"from":11,"to":16,"text":"فَوَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ (11) الَّذِينَ هُمْ فِي خَوْضٍ يَلْعَبُونَ (12) يَوْمَ يُدَعُّونَ إِلَى نَارِ جَهَنَّمَ دَعًّا (13) هَذِهِ النَّارُ الَّتِي كُنْتُمْ بِهَا تُكَذِّبُونَ (14) أَفَسِحْرٌ هَذَا أَمْ أَنْتُمْ لَا تُبْصِرُونَ (15) اصْلَوْهَا فَاصْبِرُوا أَوْ لَا تَصْبِرُوا سَوَاءٌ عَلَيْكُمْ إِنَّمَا تُجْزَوْنَ مَا كُنْتُمْ تَعْمَلُونَ (16)","hl":[[0,352,1]]}},{"id":"ق-1303","fp":"d92c656927a2","stateId":731,"easy":"الكفر والتكذيب بآيات الله ← أصحاب الجحيم","cause":"الكفر والتكذيب بآيات الله","result":"أصحاب الجحيم","explicit":true,"repOf":"ق-0007","ref":"سورة الحديد: 19","quran":{"s":57,"from":19,"to":19,"text":"وَالَّذِينَ آمَنُوا بِاللَّهِ وَرُسُلِهِ أُولَئِكَ هُمُ الصِّدِّيقُونَ وَالشُّهَدَاءُ عِنْدَ رَبِّهِمْ لَهُمْ أَجْرُهُمْ وَنُورُهُمْ وَالَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا أُولَئِكَ أَصْحَابُ الْجَحِيمِ (19)","hl":[[133,208,1]]}},{"id":"ق-1343","fp":"0350e509e7e2","stateId":731,"easy":"الكفر والتكذيب بآيات الله ← الخلود في النار","cause":"الكفر والتكذيب بآيات الله","result":"الخلود في النار","explicit":true,"repOf":"ق-0007","ref":"سورة التغابن: 10","quran":{"s":64,"from":10,"to":10,"text":"وَالَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا أُولَئِكَ أَصْحَابُ النَّارِ خَالِدِينَ فِيهَا وَبِئْسَ الْمَصِيرُ (10)","hl":[[0,111,1]]}},{"id":"ق-1358","fp":"6c72f029dcc0","stateId":731,"easy":"الكفر وخيانة الدين ولو مع قرابة الصالحين ← لا تغني القرابة شيئاً ودخول النار","cause":"الكفر وخيانة الدين ولو مع قرابة الصالحين","result":"لا تغني القرابة شيئاً ودخول النار","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة التحريم: 10","srcLabel":"القرآن الكريم","quran":{"s":66,"from":10,"to":10,"text":"ضَرَبَ اللَّهُ مَثَلًا لِلَّذِينَ كَفَرُوا امْرَأَتَ نُوحٍ وَامْرَأَتَ لُوطٍ كَانَتَا تَحْتَ عَبْدَيْنِ مِنْ عِبَادِنَا صَالِحَيْنِ فَخَانَتَاهُمَا فَلَمْ يُغْنِيَا عَنْهُمَا مِنَ اللَّهِ شَيْئًا وَقِيلَ ادْخُلَا النَّارَ مَعَ الدَّاخِلِينَ (10)","hl":[[0,240,1]]}},{"id":"ق-1362","fp":"4925821370e4","stateId":731,"easy":"الكفر بالرب والتكذيب بالنذير وترك السمع والعقل ← عذاب جهنم والسعير والسُّحق","cause":"الكفر بالرب والتكذيب بالنذير وترك السمع والعقل","result":"عذاب جهنم والسعير والسُّحق","explicit":true,"ref":"سورة الملك: 6–11","srcLabel":"القرآن الكريم","quran":{"s":67,"from":6,"to":11,"text":"وَلِلَّذِينَ كَفَرُوا بِرَبِّهِمْ عَذَابُ جَهَنَّمَ وَبِئْسَ الْمَصِيرُ (6) إِذَا أُلْقُوا فِيهَا سَمِعُوا لَهَا شَهِيقًا وَهِيَ تَفُورُ (7) تَكَادُ تَمَيَّزُ مِنَ الْغَيْظِ كُلَّمَا أُلْقِيَ فِيهَا فَوْجٌ سَأَلَهُمْ خَزَنَتُهَا أَلَمْ يَأْتِكُمْ نَذِيرٌ (8) قَالُوا بَلَى قَدْ جَاءَنَا نَذِيرٌ فَكَذَّبْنَا وَقُلْنَا مَا نَزَّلَ اللَّهُ مِنْ شَيْءٍ إِنْ أَنْتُمْ إِلَّا فِي ضَلَالٍ كَبِيرٍ (9) وَقَالُوا لَوْ كُنَّا نَسْمَعُ أَوْ نَعْقِلُ مَا كُنَّا فِي أَصْحَابِ السَّعِيرِ (10) فَاعْتَرَفُوا بِذَنْبِهِمْ فَسُحْقًا لِأَصْحَابِ السَّعِيرِ (11)","hl":[[0,475,1]]}},{"id":"ق-1390","fp":"ac394f4e8471","stateId":731,"easy":"التكذيب مع الترف ← أنكال وجحيم وطعام ذو غصّة وعذاب أليم","cause":"التكذيب مع الترف","result":"أنكال وجحيم وطعام ذو غصّة وعذاب أليم","explicit":true,"ref":"سورة المزمل: 11–13","srcLabel":"القرآن الكريم","quran":{"s":73,"from":11,"to":13,"text":"وَذَرْنِي وَالْمُكَذِّبِينَ أُولِي النَّعْمَةِ وَمَهِّلْهُمْ قَلِيلًا (11) إِنَّ لَدَيْنَا أَنْكَالًا وَجَحِيمًا (12) وَطَعَامًا ذَا غُصَّةٍ وَعَذَابًا أَلِيمًا (13)","hl":[[0,160,1]]}},{"id":"ق-1394","fp":"d1eb4c388874","stateId":731,"easy":"العناد لآيات الله بعد النعم والاستكبار عنها ← الإرهاق صعوداً وسقر","cause":"العناد لآيات الله بعد النعم والاستكبار عنها","result":"الإرهاق صعوداً وسقر","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة المدثر: 11–26","srcLabel":"القرآن الكريم","quran":{"s":74,"from":11,"to":26,"text":"ذَرْنِي وَمَنْ خَلَقْتُ وَحِيدًا (11) وَجَعَلْتُ لَهُ مَالًا مَمْدُودًا (12) وَبَنِينَ شُهُودًا (13) وَمَهَّدْتُ لَهُ تَمْهِيدًا (14) ثُمَّ يَطْمَعُ أَنْ أَزِيدَ (15) كَلَّا إِنَّهُ كَانَ لِآيَاتِنَا عَنِيدًا (16) سَأُرْهِقُهُ صَعُودًا (17) إِنَّهُ فَكَّرَ وَقَدَّرَ (18) فَقُتِلَ كَيْفَ قَدَّرَ (19) ثُمَّ قُتِلَ كَيْفَ قَدَّرَ (20) ثُمَّ نَظَرَ (21) ثُمَّ عَبَسَ وَبَسَرَ (22) ثُمَّ أَدْبَرَ وَاسْتَكْبَرَ (23) فَقَالَ إِنْ هَذَا إِلَّا سِحْرٌ يُؤْثَرُ (24) إِنْ هَذَا إِلَّا قَوْلُ الْبَشَرِ (25) سَأُصْلِيهِ سَقَرَ (26)","hl":[[0,518,1]]}},{"id":"ق-1400","fp":"b9d3fa1fe78e","stateId":731,"easy":"الكفر ← سلاسل وأغلال وسعير","cause":"الكفر","result":"سلاسل وأغلال وسعير","explicit":true,"ref":"سورة الإنسان: 4","srcLabel":"القرآن الكريم","quran":{"s":76,"from":4,"to":4,"text":"إِنَّا أَعْتَدْنَا لِلْكَافِرِينَ سَلَاسِلَ وَأَغْلَالًا وَسَعِيرًا (4)","hl":[[7,67,1]]}},{"id":"ق-1404","fp":"93b045af68bf","stateId":731,"easy":"التكذيب ← ويل يومئذ","cause":"التكذيب","result":"ويل يومئذ","explicit":true,"ref":"سورة المرسلات: 15","srcLabel":"القرآن الكريم","quran":{"s":77,"from":15,"to":15,"text":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ (15)","hl":[[0,34,1]]}},{"id":"ق-1414","fp":"0487ea8f3b07","stateId":731,"easy":"الكفر والفجور ← غبرة وقترة على الوجوه","cause":"الكفر والفجور","result":"غبرة وقترة على الوجوه","explicit":true,"ref":"سورة عبس: 40–42","srcLabel":"القرآن الكريم","quran":{"s":80,"from":40,"to":42,"text":"وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ (40) تَرْهَقُهَا قَتَرَةٌ (41) أُولَئِكَ هُمُ الْكَفَرَةُ الْفَجَرَةُ (42)","hl":[[0,109,1]]}},{"id":"ق-1432","fp":"506c9d4eb5cd","stateId":731,"easy":"التولي والكفر ← العذاب الأكبر","cause":"التولي والكفر","result":"العذاب الأكبر","explicit":true,"repOf":"ق-0044","ref":"سورة الغاشية: 23–24","quran":{"s":88,"from":23,"to":24,"text":"إِلَّا مَنْ تَوَلَّى وَكَفَرَ (23) فَيُعَذِّبُهُ اللَّهُ الْعَذَابَ الْأَكْبَرَ (24)","hl":[[0,79,1]]}},{"id":"ق-1437","fp":"e4174ceff4a0","stateId":731,"easy":"الكفر بآيات الله ← أصحاب المشأمة عليهم نار مؤصدة","cause":"الكفر بآيات الله","result":"أصحاب المشأمة عليهم نار مؤصدة","explicit":true,"repOf":"ق-0007","ref":"سورة البلد: 19–20","quran":{"s":90,"from":19,"to":20,"text":"وَالَّذِينَ كَفَرُوا بِآيَاتِنَا هُمْ أَصْحَابُ الْمَشْأَمَةِ (19) عَلَيْهِمْ نَارٌ مُؤْصَدَةٌ (20)","hl":[[0,94,1]]}},{"id":"ق-1443","fp":"6b42f68bbba3","stateId":731,"easy":"التكذيب والتولي (الشقاء) ← النار تلظّى","cause":"التكذيب والتولي (الشقاء)","result":"النار تلظّى","explicit":true,"ref":"سورة الليل: 14–16","srcLabel":"القرآن الكريم","quran":{"s":92,"from":14,"to":16,"text":"فَأَنْذَرْتُكُمْ نَارًا تَلَظَّى (14) لَا يَصْلَاهَا إِلَّا الْأَشْقَى (15) الَّذِي كَذَّبَ وَتَوَلَّى (16)","hl":[[0,102,1]]}},{"id":"ق-1451","fp":"f7fd0981219f","stateId":731,"easy":"الكفر (أهل الكتاب والمشركون) ← نار جهنم خالدين فيها وهم شر البرية","cause":"الكفر (أهل الكتاب والمشركون)","result":"نار جهنم خالدين فيها وهم شر البرية","explicit":true,"repOf":"ق-0156","ref":"سورة البينة: 6","quran":{"s":98,"from":6,"to":6,"text":"إِنَّ الَّذِينَ كَفَرُوا مِنْ أَهْلِ الْكِتَابِ وَالْمُشْرِكِينَ فِي نَارِ جَهَنَّمَ خَالِدِينَ فِيهَا أُولَئِكَ هُمْ شَرُّ الْبَرِيَّةِ (6)","hl":[[0,136,1]]}},{"id":"ق-1464","fp":"6989d9b08d27","stateId":731,"easy":"معاداة الرسول وإيذاؤه ← التباب ولا يغني المال وصَلي النار","cause":"معاداة الرسول وإيذاؤه","result":"التباب ولا يغني المال وصَلي النار","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[57],"ref":"سورة المسد: 1–3","srcLabel":"القرآن الكريم","quran":{"s":111,"from":1,"to":3,"text":"تَبَّتْ يَدَا أَبِي لَهَبٍ وَتَبَّ (1) مَا أَغْنَى عَنْهُ مَالُهُ وَمَا كَسَبَ (2) سَيَصْلَى نَارًا ذَاتَ لَهَبٍ (3)","hl":[[0,26,1]]}},{"id":"س-03002","fp":"3cb04e871397","stateId":731,"easy":"إذا سمعت بالنبي ﷺ ثم لم تؤمن به ← تكون من أصحاب النار","cause":"لن يَسمَعَ بي أحدٌ مِن هذه الأمةِ ، ولا يهوديٌّ ، ولا نصرانيٌّ ، ثم لا يؤمِنُ بي","result":"إلا كان مِن أصحابِ النارِ","explicit":true,"repOf":"س-02609","otherNeedIds":[22],"ref":"إتحاف الخيرة المهرة 6/220","text":[["لن يَسمَعَ بي أحدٌ مِن هذه الأمةِ ، ولا يهوديٌّ ، ولا نصرانيٌّ ، ثم لا يؤمِنُ بي",1]," ، ",["إلا كان مِن أصحابِ النارِ",2]," ، قال : قلتُ : ما قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم شيئًا إلا كان في كتابِ اللهِ عزَّ وجلَّ ، قال : فوجَدتُ ومَن يَكفُرْ به منَ الأحزابِ فالنارُ مَوعِدُه"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح","bab":"إيمان › الوعيد","dorar":"M8TKALit","merged":2,"otherRefs":["صحيح مسلم 153 (صحيح)"]},{"id":"س-08270","fp":"f3366fc255b8","stateId":731,"easy":"إذا أبغضت أهل بيت النبي ﷺ ← يدخلك الله النار","cause":"لا يُبغِضُنا أهْلَ البَيتِ أحَدٌ","result":"إلَّا أدخَلَه اللهُ النَّارَ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"المستدرك على الصحيحين 4776","srcLabel":"مسلم","text":["«والَّذي نَفْسي بيَدِه ",["لا يُبغِضُنا أهْلَ البَيتِ أحَدٌ",1]," ",["إلَّا أدخَلَه اللهُ النَّارَ",2],"»."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه ابن حبان (6978) بلفظه، والبزار كما في ((كشف الأستار)) للهيثمي (3348) مطولا ، ، وابن المغازلي في ((مناقب علي)) (181)  كلاهما بلفظ مقارب.","bab":"مناقب وفضائل › أهل البيت صلوات الله عليهم","dorar":"03YR5yU3"},{"id":"س-02622","fp":"f3f9730352b2","stateId":731,"easy":"إذا سمعت بالنبي ﷺ ولم تؤمن به ← تدخل النار","cause":"ما مِن أَحَدٍ يَسمعُ بي مِن هذه الأُمَّةِ، ولا يهوديٌّ ولا نصرانيٌّ، ولا يُؤمنُ بي","result":"إلَّا دَخَلَ النَّارَ، فجَعَلْتُ أقولُ: أين تصْديقُها في كتابِ اللهِ وقُلْ ما سَمِعْتَ حدَّثَنا عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ إلَّا وجَدْتُ تصديقَها في القرآنِ","explicit":true,"repOf":"س-02609","ref":"المستدرك على الصحيحين 3351","text":["«",["ما مِن أَحَدٍ يَسمعُ بي مِن هذه الأُمَّةِ، ولا يهوديٌّ ولا نصرانيٌّ، ولا يُؤمنُ بي",1]," ",["إلَّا دَخَلَ النَّارَ، فجَعَلْتُ أقولُ: أين تصْديقُها في كتابِ اللهِ وقُلْ ما سَمِعْتَ حدَّثَنا عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ إلَّا وجَدْتُ تصديقَها في القرآنِ",2],"؟ حتَّى وجدتُ هذه الآيةَ: {وَمَنْ يَكْفُرْ بِهِ مِنَ الْأَحْزَابِ فَالنَّارُ مَوْعِدُهُ} [هود: 17] قالَ: الأحزابُ: المِلَلُ كُلُّها."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه ابن أبي حاتم كما في ((الدر المنثور ف)) (4/  411) مختصرا","bab":"إيمان › الأمر بالإيمان بالله تعالى ورسوله وشرائع الدين","dorar":"EkgFE4Em"},{"id":"س-03031","fp":"a2a46f21338a","stateId":731,"easy":"إذا سمعت بالنبي ﷺ ثم لم تسلم ← دخلت النار","cause":"مَن سمِعَ بي من يَهوديٍّ أو نَصْرانيٍّ، ثُمَّ لم يُسلِمْ","result":"دخَلَ النَّارَ","explicit":true,"repOf":"س-02609","ref":"تخريج سير أعلام النبلاء 10/330","text":[["مَن سمِعَ بي من يَهوديٍّ أو نَصْرانيٍّ، ثُمَّ لم يُسلِمْ، ",1],["دخَلَ النَّارَ",2],"."],"grade":"صحيح","narrator":"أبو موسى","muhaddith":"إسناده صحيح","takhrij":"أخرجه الذهبي في ((السير)) (10/ 330)، وأحمد (19536)، والنسائي في ((السنن الكبرى)) (11177)، وأبو بكر الشافعي في ((الغيلانيات)) (244) جميعهم بلفظه.","bab":"إيمان › الوعيد","dorar":"VjUgGVtd"},{"id":"س-06366","fp":"92240565859f","stateId":731,"easy":"إذا مت كافراً ← وجبت لك النار","cause":"ومَن ماتَ كافرًا","result":"وجبَتْ لَهُ النَّارُ","explicit":true,"ref":"عمدة التفسير 1/846","srcLabel":"ابن حبان","text":["النَّاسُ أربعةٌ ، والعمَّالُ ستَّةٌ . فالنَّاسُ موسَّعٌ لَهُ في الدُّنيا والآخرةِ ، وموسَّعٌ لَهُ في الدُّنيا مقتورٌ عليهِ في الآخرةِ ، ومقتورٌ عليهِ في الدُّنيا موسَّعٌ لَهُ في الآخرةِ ، وشقيٌ في الدُّنيا والآخرةِ . والأعمالُ موجبتانِ ، ومثلٌ بمثلٍ ، وعشرةُ أضعافٍ ، وسبعُمائةِ ضعفٍ ؛ فالموجبتانِ مَن ماتَ مسلمًا مؤمنًا لا يشرِكُ باللَّهِ شيئًا وجبَتْ لَهُ الجنَّةُ ، ",["ومَن ماتَ كافرًا ",1],["وجبَتْ لَهُ النَّارُ ",2],". ومَن همَّ بحسنةٍ فلَم يعملْها ، فعلِمَ اللَّهُ أنَّهُ قد أشعرَها قلبَه وحرصَ علَيها ، كُتبَت لَهُ حسنةً . ومَن همَّ بسيِّئةٍ لم تُكْتَب عليهِ ، ومَن عمِلَها كُتبَت واحدةً ولم تُضاعَف عليهِ . ومَن عملَ حسنةً كانت له بعشرةِ أمثالِها . ومَن أنفقَ نفقةً في سبيلِ اللَّهِ ، عزَّ وجلَّ ، كانت لَهُ بسبعِمائةِ ضعفٍ"],"grade":"صحيح","narrator":"خريم بن فاتك الأسدي","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي شيبة في ((مسنده)) (743)، وابن ابي عاصم في ((الآحاد والمثاني)) (1047)، وابن حبان (4630) جميعهم باختلاف يسير .","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"mVsonKjD"},{"id":"س-07659","fp":"f3e3f290e8f0","stateId":731,"easy":"إذا مت على غير الإيمان بالقدر ← تدخل النار","cause":"أَوصاني أبي رَحِمَه اللهُ فقال: يا بُنَيَّ، أُوصيكَ أنْ تُؤمِنَ بالقَدَرِ خَيرِه وشَرِّه","result":"فإنَّكَ إنْ لم تُؤمِنْ أدخَلَكَ اللهُ النَّارَ","explicit":true,"ref":"تخريج المسند لشعيب 22707","srcLabel":"أبو داود","text":[["أَوصاني أبي رَحِمَه اللهُ فقال: يا بُنَيَّ، أُوصيكَ أنْ تُؤمِنَ بالقَدَرِ خَيرِه وشَرِّه؛ ",1],["فإنَّكَ إنْ لم تُؤمِنْ أدخَلَكَ اللهُ النَّارَ",2],"، قال: وسَمِعتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ يقولُ: أوَّلُ ما خَلَقَ اللهُ القَلمُ، ثُمَّ قال له: اكتُبْ، قال: وما أكتُبُ؟ قال: القَدَرَ، قال: فكَتَبَ ما يَكونُ، وما هو كائنٌ إلى أنْ تَقومَ السَّاعةُ."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4700)، والترمذي (2155) باختلاف يسير، وأحمد (22707) واللفظ له","bab":"قدر › التكذيب بالقدر","dorar":"ucJ9mrW5"},{"id":"س-07884","fp":"f72dc009ef12","stateId":731,"easy":"إذا كذبت بالشفاعة ← فلا نصيب لك فيها","cause":"من كذَّبَ بالشَّفاعةِ","result":"فلا نصيبَ لَهُ فيها","explicit":true,"ref":"فتح الباري لابن حجر 11/434","srcLabel":"البيهقي","text":["عن أنسٍ قالَ : ",["من كذَّبَ بالشَّفاعةِ ",1],["فلا نصيبَ لَهُ فيها",2]],"grade":"صحيح","narrator":"سعيد بن منصور","muhaddith":"إسناده صحيح","takhrij":"أخرجه البيهقي في ((البعث والنشور)) (468) واللفظ له، والآجري في ((الشريعة)) (777) باختلاف يسير، وهناد في ((الزهد)) (189) مطولًا.","bab":"قيامة › الشفاعة","dorar":"KnHhLSFw"},{"id":"س-00808","fp":"93424e11e495","stateId":731,"easy":"إذا آذيت الله ورسوله ← تلتقطك النار من الصفوف","cause":"بمن آذى اللَّهَ تعالى ورسولَهُ","result":"فتلتقِطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسمِ فتُحبَسُ بهم في جهنَّمَ","explicit":true,"ref":"الدر المنثور 10/111","srcLabel":"الحاكم","text":["عنِ ابنِ عبَّاسٍ قالَ: إذا كانَ يومُ القيامةِ مُدَّتِ الأرضُ مدَّ الأديمِ، وزيدَ في سَعتِها كذا وَكذا، وجمعَ الخلائقُ بصعيدٍ واحدٍ جنُّهمُ وَ إنسُهم، فإذا كانَ ذلِكَ اليومَ قُبِضت هذِهِ السَّماءُ الدُّنيا عن أَهلِها على وجْهِ الأرضِ ولأَهلُ السَّماءِ وحدُهم أَكثرُ من أَهلِ الأرضِ جنِّهم وَ إنسِهم بضِعفٍ، فإذا نُثِروا على وجْهِ الأرض فزعوا إليهِم فيقولون: أفيكم ربُّنا؟ فيفزعونَ من قولِهم ويقولونَ: سبحانَ ربِّنا ليس فينا وهو آتٍ، ثُمَّ تُقاضُ السَّماءُ الثَّانيةُ ولأَهلُ السَّماءِ الثَّانيةِ وحدَهم أَكثرَ من أهل السَّماءِ الدُّنيا، ومن جميعِ أهل الأرضِ بضِعفٍ جنِّهم وَ إنسِهم، فإذا نُثِروا على وجهِ الأرض فزعَ إليهم أهلُ الأرضِ فيقولونَ: أفيكُم ربُّنا؟ فيفزعونَ من قولِهم ويقولونَ: سبحانَ ربِّنا ليسَ فينا وهو آتٍ، ثم تُقاضُ السَّمواتُ سماءً سماءً كلَّما قيضَت سماءٌ عن أهلِها كانت أكثرَ من أهل السَّمواتِ الَّتي تحتَها ومن جميعِ أَهلِ الأرضِ بضِعفٍ، فإذا نُثِروا على أهل الأرضِ يفزعَ إليْهم أَهلُ الأرضِ فيقولونَ لَهم: مثلُ ذلِكَ فيرجعونَ إليهم مثل ذلك حتَّى تقاضَ السَّماءُ السَّابعةُ فلَأَهلُ السَّماءِ السَّابعةِ أَكثرُ من أهلِ ستِّ سمواتٍ ومن جميعِ أهلِ الأرضِ بضِعفٍ، فيجيءُ اللَّهُ فيهم والأممُ جثًى صفوفٌ فينادي منادٍ ستعلمونَ اليومَ من أصحابُ الْكرمِ ليقُمِ الحمَّادونَ للَّهِ على كلِّ حالٍ فيقومونَ فيسرَحونَ إلى الجنَّةِ ثمَّ ينادي الثَّانيةَ ستعلمون اليومَ من أصحابُ الْكرمِ أينَ الَّذينَ كانت تَتَجَافَى جُنُوبُهُمْ عَنِ المَضَاجِعِ يَدْعُونَ رَبَّهُمْ خَوْفًا وَطَمَعًا وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ [السجدة آية: 16] فيقومونَ فيسرَحونَ إلى الجنَّةِ، قالَ: ثمَّ ينادي الثَّالثةَ ستعلمون اليومَ من أصحابُ الْكرَمِ أين الَّذينَ لَا تُلْهِيهِمْ تِجَارَةٌ وَلَا بَيْعٌ عَنْ ذِكْرِ اللَّهِ وَإِقَامِ الصَّلَاةِ وَإِيتَاءِ الزَّكَاةِ يَخَافُونَ يَوْمًا تَتَقَلَّبُ فِيهِ الْقُلُوبُ وَالْأَبْصَارُ [النور آية: 37] فيقومونَ فيسرَحونَ إلى الجنَّةِ فإذا أخذَ كلٌّ من هؤلاءِ ثلاثةٌ خرجَ عنُقٌ منَ النَّارِ فأشرفَ على الخلائقِ لَهُ عينانِ تبصِرانِ ولسانٌ فصيحٌ فيقولُ: إنِّي وُكِّلتُ منكُم بثلاثةٍ بِكلِّ جبَّارٍ عنيدٍ فتلتقطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسِمِ، فتجلِسُ بِهم في جَهنَّمَ ثمَّ تخرجُ ثانيةً فتقولُ إنِّي وُكِّلتُ منكُم ",["بمن آذى اللَّهَ تعالى ورسولَهُ",1],"، ",["فتلتقِطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسمِ فتُحبَسُ بهم في جهنَّمَ",2],"، ثم تخرجُ ثالثةً فتقولُ: إنِّي وُكِّلتُ بأصحابِ التَّصاويرِ فتَلقطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسمِ فتُحبَسُ بِهم في جَهنَّمَ فإذا أُخذَ من هؤلاءِ ثلاثةً ومن هؤلاءِ ثلاثةً نشِرتِ الصُّحفَ ووُضِعتِ الموازينَ ودُعيَ الخلائقُ للحسابِ"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن المبارك في ((الزهد والرقائق)) (2/101) واللفظ له، والحاكم (8699)، والحارث بن أبي أسامة كما في ((بغية الباحث)) (1122) بلفظ مقارب","bab":"أدعية وأذكار › حمد الله في كل الأحوال","dorar":"TsRrl1QY"},{"id":"س-07893","fp":"4c2770700ab4","stateId":731,"easy":"إذا كنت كافراً ← يتغشاك الموت يوم القيامة","cause":"وأمَّا الكافِرُ","result":"فيَتَغشَّاه المَوْتُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-03205","س-00545"],"ref":"الأحاديث المختارة 2695","srcLabel":"متفق عليه","text":["«حَدَّثَني نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنِّي لقائِمٌ أنْتَظِرُ أمَّتي تَعبُرُ الصِّراطَ إذ جاءَني عيسى، قالَ: فقالَ: هذه الأنْبِياءُ قد جاءَتْك يا مُحمَّدُ يَسْألونَ، أو قالَ: يَجْتَمِعونَ إليك ويَدْعونَ اللهَ عَزَّ وجَلَّ أن تُفرِّقَ بَيْنَ جَمْعِ الأُمَمِ إلى حيثُ يَشاءُ اللهُ؛ لِغَمِّ ما هُمْ فيه، فالخَلْقُ مُلجَمونَ في العَرَقِ، فأمَّا المُؤْمِنُ فهو عليه كالزُّكْمةِ، ",["وأمَّا الكافِرُ",1]," ",["فيَتَغشَّاه المَوْتُ",2],"، قالَ: قالَ عيسى: انْتَظِرْ حتَّى أرْجِعَ إليك، قالَ: فذَهَبَ نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ فقامَ تحتَ العَرْشِ، فلَقيَ ما لم يَلْقَ مَلَكٌ مُصْطَفًى، ولا نَبِيٌّ مُرسَلٌ، فأَوْحى اللهُ عَزَّ وجَلَّ إلى جِبْريلَ أن اذْهَبْ إلى مُحمَّدٍ صلَّى اللهُ عليه وسلَّمَ فقُلْ له: ارْفَعْ رأسَك، سَلْ تُعْطَه، واشْفَعْ تُشَفَّعْ، قالَ: فشُفِّعْتُ في أمَّتي أن أُخرِجَ مِن كلِّ تِسْعةٍ وتِسْعينَ إنْسانًا واحِدًا، قالَ: فما زِلْتُ أتَرَدَّدُ على رَبِّي عَزَّ وجَلَّ فلا أقومُ مِنه مَقامًا إلَّا شُفِّعْتُ حتَّى أعْطاني اللهُ مِن ذلك أن قالَ: يا مُحمَّدُ، أَدخِلْ مِن أمَّتِك مِن خَلْقِ اللهِ مَن شَهِدَ أنْ لا إلهَ إلَّا اللهُ يَوْمًا واحِدًا مُخلِصًا، وماتَ على ذلك»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"قيامة › الشفاعة","dorar":"RwPYP6i7"},{"id":"س-02618","fp":"38435534fef2","stateId":731,"easy":"إذا مت كافراً ← لا يُقبل منك ملء الأرض ذهباً فداءً","cause":"يُجاءُ بالكافرِ يَومَ القيامةِ","result":"فَلَنْ يُقْبَلَ مِنْ أَحَدِهِمْ مِلْءُ الْأَرْضِ ذَهَبًا وَلَوِ افْتَدَى بِهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج المسند لشعيب 13288","srcLabel":"مسلم","text":[["يُجاءُ بالكافرِ يَومَ القيامةِ",1],"، فيُقالُ له: أرأيْتَ لو كان لك مِلْءُ الأرضِ ذهَبًا، أكنتَ مُفْتَديًا به؟ فيقولُ: نعَمْ يا ربِّ. قال: فيُقالُ: لقد سُئلْتَ أيْسَرَ مِن ذلك. فذلك قَولُه عزَّ وجلَّ: {إِنَّ الَّذِينَ كَفَرُوا وَمَاتُوا وَهُمْ كُفَّارٌ ",["فَلَنْ يُقْبَلَ مِنْ أَحَدِهِمْ مِلْءُ الْأَرْضِ ذَهَبًا وَلَوِ افْتَدَى بِهِ",2],"} [آل عمران: 91]."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (2805)، وأحمد (13288) واللفظ له","bab":"إيمان › الأمر بالإيمان بالله تعالى ورسوله وشرائع الدين","dorar":"uF4Q4N8E"},{"id":"س-04107","fp":"53b049e5b126","stateId":731,"easy":"إذا لم تجب داعي الله ← يعاقبك أو يعذبك","cause":"ومن لم يجبهُ","result":"عاقبَهُ أو عذَّبَهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الترمذي 2861","srcLabel":"مسلم","text":["قالَ صلَّى رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ العشاءَ ثمَّ انصرفَ فاخذ بيدِ عبدِ اللَّهِ بنِ مسعودٍ حتَّى خرجَ بِهِ إلى بَطحاءِ مَكَّةَ فأجلسَهُ ثمَّ خطَّ علَيهِ خطًّا ثمَّ قالَ: لا تبرَحنَّ خطَّكَ فإنَّهُ سينتَهي إليكَ رجالٌ فلا تُكَلِّمهم فإنَّهم لا يُكَلِّمونَكَ، قالَ: ثمَّ مضى رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ حيثُ أرادَ، فبينا أَنا جالسٌ في خطِّي إذ أتاني رجالٌ كأنَّهمُ الزُّطُّ أشعارُهُم وأجسامُهُم لا أرى عورةً ولا أرى قِشرًا وينتَهونَ إليَّ، ولا يجاوزونَ الخطَّ ثمَّ يَصدرونَ إلى رسولِ اللَّهِ حتَّى إذا كانَ من آخرِ اللَّيلِ، لَكِن رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ قد جاءَني وأَنا جالسٌ، فقالَ: لقد أراني منذُ اللَّيلة ثمَّ دخلَ عليَّ في خطِّي فتوسَّدَ فخذي ورَقدَ وَكانَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ إذا رقدَ نفخَ، فبينا أَنا قاعدٌ ورسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ متوسِّدٌ فخذي إذا أَنا برجالٍ علَيهِم ثيابٌ بيضٌ اللَّهُ أعلمُ ما بِهِم منَ الجَمالِ فانتَهَوا إليَّ، فجلسَ طائفةٌ منهم عندَ رأسِ رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وطائفةٌ منهم عندَ رجليهِ ثمَّ قالوا بينَهُم: ما رَأينا عبدًا قطُّ أوتيَ مثلَ ما أوتيَ هذا النَّبيُّ صلَّى اللَّهُ علَيهِ وسلَّمَ إنَّ عينيهِ تَنامانِ وقلبُهُ يَقظانُ، اضربوا لَهُ مثلًا مثلُ سيِّدٍ بنى قصرًا ثمَّ جعلَ مائدة فدعا النَّاسَ إلى طعامِهِ وشرابِهِ، فمَن أجابَهُ أَكَلَ من طعامِهِ وشربَ من شرابِهِ ومن لم يجبهُ عاقبَهُ - أو قالَ: عذَّبَهُ - ثمَّ ارتفَعوا، واستيقَظَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ عندَ ذلِكَ فقالَ: سمعتَ ما قالَ هؤلاءِ؟ وَهَل تدري مَن هم؟ قلتُ: اللَّهُ ورسولُهُ أعلمُ، قالَ: همُ الملائِكَةُ، فتَدري ما المثلُ الَّذي ضرَبوه؟ قلتُ: اللَّهُ ورسولُهُ أعلمُ، قالَ: المثلُ الَّذي ضرَبوه الرَّحمنُ بنى الجنَّةَ ودعى إليها عِبادَه، فمن أجابَهُ دخلَ الجنَّةَ ",["ومن لم يجبهُ",1]," ",["عاقبَهُ أو عذَّبَهُ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"حسن صحيح","takhrij":"أخرجه الترمذي (2861) بلفظه، وقوام السنة في ((دلائل النبوة)) (65) باختلاف يسير، ومسلم (450) بنحوه.","bab":"جن › وفد الجن","dorar":"umsXQrcS"},{"id":"س-08350","fp":"9517871914f7","stateId":731,"easy":"إذا كذّبت بالحوض ← لا يسقيك الله منه","cause":"فمَن كذَّبَ به","result":"فلا سَقاهُ الله منه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج سنن أبي داود 4749","srcLabel":"أبو داود","text":["شَهِدتُ أبا بَرْزةَ دخَلَ على عُبيدِ اللهِ بنِ زيادٍ فحدَّثَني فُلانٌ -سمَّاه مُسلمٌ-، وكان في السِّماطِ: فلمَّا رآه عُبَيدُ اللهِ، قال: إنَّ مُحمَّديَّكم هذا الدَّحداحَ، ففَهِمَها الشَّيخُ، فقال: ما كنتُ أحسِبُ أنِّي أبْقى في قَومٍ يُعيِّروني بصُحبةِ مُحمَّدٍ صلَّى اللهُ عليه وسلَّمَ! فقال له عُبَيدُ اللهِ: إنَّ صُحبةَ مُحمَّدٍ صلَّى اللهُ عليه وسلَّمَ لك زَينٌ غيرُ شَينٍ، ثُمَّ قال: إنَّما بُعِثتُ إليكَ لِأسأَلَك عن الحَوضِ، سَمِعتَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يذكُرُ فيه شيئًا؟ قال أبو بَرْزةَ: نَعَمْ، لا مرَّةً، ولا ثِنْتَينِ، ولا ثلاثًا، ولا أرْبعًا، ولا خَمسًا، ",["فمَن كذَّبَ به",1]," ",["فلا سَقاهُ الله منه",2],"، ثُمَّ خرَجَ مُغضَبًا."],"grade":"صحيح","narrator":"أبو برزة الأسلمي نضلة بن عبيد","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4749) واللفظ له، وأحمد (19807) مختصرا، والبيهقي في ((البعث والنشور)) (154) بنحوه.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"IgYVwo6K","merged":4,"otherRefs":["تخريج كتاب السنة 720 (صحيح)","تخريج المسند لشعيب 19763 (صحيح)","تخريج المسند لشعيب 19779 (صحيح)"]},{"id":"س-02980","fp":"fb90076c12d5","stateId":731,"easy":"إذا أنكرت الصلوات الخمس ← تكون من أهل الضلال","cause":"قومٌ يَقولُون: إنْ كان أوَّلِيَّتُنا ضُلَّالًا ما بال خمْسُ صَلواتٍ في اليومِ واللَّيلةِ؟! إنَّما هو صَلاتانِ العصرُ والفجرُ، وقومٌ يَقولُون: إنَّما الإيمانٌ كلامٌ، وإنْ زَنى وإنْ قَتَل","result":"أهلَ دِينينِ مِن أُمَّةِ محمَّدٍ صلَّى اللهُ عليه وسلَّمَ في النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"المستدرك على الصحيحين 8514","srcLabel":"الحاكم","text":["عن حُذَيفةَ بنِ اليَمانِ، قال: إنِّي لَأعلَمُ ",["أهلَ دِينينِ مِن أُمَّةِ محمَّدٍ صلَّى اللهُ عليه وسلَّمَ في النَّارِ",2],": ",["قومٌ يَقولُون: إنْ كان أوَّلِيَّتُنا ضُلَّالًا ما بال خمْسُ صَلواتٍ في اليومِ واللَّيلةِ؟! إنَّما هو صَلاتانِ العصرُ والفجرُ، وقومٌ يَقولُون: إنَّما الإيمانٌ كلامٌ، وإنْ زَنى وإنْ قَتَل",1],"."],"grade":"صحيح","narrator":"ابن الديلمي","muhaddith":"صحيح على شرط الشيخين، ولم يخرجاه","bab":"إيمان › الوعيد","dorar":"NElFZPs0"},{"id":"س-03945","fp":"43e20e3d6fcb","stateId":731,"easy":"إذا كفرت ← تجيء يوم القيامة تحسب عملك شيئاً فلا تجده","cause":"وَالَّذِينَ كَفَرُوا أَعْمَالُهُمْ كَسَرَابٍ بِقِيعَةٍ","result":"وكذلكَ الكافرُ يَجيءُ يومَ القيامةِ وهو يحسِبُ أنَّ له عند اللهِ خيرًا فلا يجدُهُ، ويُدخلُهُ اللهُ النَّارَ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"otherNeedIds":[52],"ref":"المستدرك على الصحيحين 3556","srcLabel":"ابن أبي حاتم","text":["عنْ أُبيِّ بنِ كَعْبٍ رَضيَ اللهُ عنه في قولِ اللهِ عزَّ وجلَّ: {اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ} [النور: 35]، فقَرَأَ الآيةَ، ثُمَّ قالَ: {",["وَالَّذِينَ كَفَرُوا أَعْمَالُهُمْ كَسَرَابٍ بِقِيعَةٍ",1]," يَحْسَبُهُ الظَّمْآنُ مَاءً حَتَّى إِذَا جَاءَهُ لَمْ يَجِدْهُ شَيْئًا وَوَجَدَ اللَّهَ عِنْدَهُ فَوَفَّاهُ حِسَابَهُ وَاللَّهُ سَرِيعُ الْحِسَابِ} [النور: 39] قالَ: ",["وكذلكَ الكافرُ يَجيءُ يومَ القيامةِ وهو يحسِبُ أنَّ له عند اللهِ خيرًا فلا يجدُهُ، ويُدخلُهُ اللهُ النَّارَ",2],". قالَ: وضَرَبَ مثلًا آخرَ للكافرِ، فقالَ: {أَوْ كَظُلُمَاتٍ فِي بَحْرٍ لُجِّيٍّ يَغْشَاهُ مَوْجٌ مِنْ فَوْقِهِ مَوْجٌ مِنْ فَوْقِهِ سَحَابٌ ظُلُمَاتٌ بَعْضُهَا فَوْقَ بَعْضٍ إِذَا أَخْرَجَ يَدَهُ لَمْ يَكَدْ يَرَاهَا وَمَنْ لَمْ يَجْعَلِ اللَّهُ لَهُ نُورًا فَمَا لَهُ مِنْ نُورٍ} [النور: 40]، فهو ينقُلُهُ في خمسٍ مِنَ الظُّلَمِ؛ فكلامُهُ ظُلمةٌ، وعَملُهُ ظُلمةٌ، ومَدخلُهُ ظُلمةٌ، ومَخرجُهُ ظُلمةٌ، ومَصيرُهُ إلى الظُّلماتِ إلى النَّارِ يومَ القيامةِ."],"grade":"صحيح","narrator":"أبو العالية","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن أبي حاتم في ((التفسير)) (14667)، والطبري في ((جامع البيان)) (19/ 196) كلاهما مختصرا.","bab":"تفسير آيات › سورة النور","dorar":"bND77vuO"},{"id":"س-03205","fp":"c433e1497c08","stateId":731,"easy":"إذا كنت كافراً ← يلجمك العرق يوم القيامة","cause":"الكافرَ","result":"وإنَّهُم ليلقونَ من هولِ ذلك اليومِ شدَّةً حتى يُلجِمَ الكافرَ العرقُ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-07893","ref":"البدور السافرة 92","text":["لم يبلغْ ابنَ آدمَ شيئًا منذُ خلقَهُ اللهُ أشدَّ عليْهِ منَ الموتِ ، ثم إنَّ الموتَ أهونُ عليْهِ ممَّا بعدَهُ ، ",["وإنَّهُم ليلقونَ من هولِ ذلك اليومِ شدَّةً حتى يُلجِمَ الكافرَ العرقُ",2]," ، قيلَ له : فأينَ المؤمنونَ ؟ قال : على كراسيٍّ من ذهبٍ ويظللُ عليْهِم الغمامُ ، وما طولُ ذلك اليومِ عليْهِم إلا كساعةٍ من نهارٍ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده جيد","takhrij":"أخرجه أحمد (12566) مختصراً، والطبراني في ((المعجم الأوسط)) (1976)، وابن عدي في ((الكامل في الضعفاء)) (3/463) باختلاف يسير","bab":"إيمان › فضل الإيمان","dorar":"3RoIPsMu","merged":2,"otherRefs":["عمدة القاري 23/171 (حسن)"]},{"id":"س-00545","fp":"8e73049b7c15","stateId":731,"easy":"إذا مت كافراً ← يغشاك الموت (لا تحيا ولا تموت)","cause":"وأما الكافِرُ","result":"فيغشاهُ الموتُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-07893","ref":"تخريج العواصم والقواصم 8/ 424","text":["عن النَّبيِّ صلَّى اللهُ عليه وسلَّمَ في ذِكرِ الشَّفاعَةِ: أنَّ الخلْقَ يُلجَمون بالعَرَقِ في يومِ القيامَةِ، فأما المُؤمِنُ، فهو عليه كالزُّكْمةِ، ",["وأما الكافِرُ",1],"، ",["فيغشاهُ الموتُ",2],"."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حديث حسن","takhrij":"أخرجه أحمد (12824)، وابن خزيمة في ((التوحيد)) (2/616)، والضياء في ((الأحاديث المختارة)) (2695) مطولاً","bab":"آداب عامة › ضرب الأمثال","dorar":"iUwAGHPX"},{"id":"س-03931","fp":"e09403d813f7","stateId":731,"easy":"إذا كنت كافراً ← تُجمع لك سيئاتك حتى تُجزى بها يوم القيامة","cause":"وأمَّا الآخرونَ","result":"فيؤخَّرُ فيُجمَعُ ذلِكَ لَهُم حتَّى يُجزَوا بِهِ يومَ القيامةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الأمالي المطلقة 76","srcLabel":"الترمذي","text":["عن أبي بَكْرٍ الصِّدِّيقِ رضيَ اللَّهُ عنهُ قالَ كنتُ عندَ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فنزلت عليهِ هذِهِ الآيةُ مَنْ يَعْمَلْ سُوءًا يُجْزَ بِهِ فقالَ يا أبا بَكْرٍ ألا أقرئُكَ آيةً أُنْزِلَت عليَّ قلتُ بلى يا رسولَ اللَّهِ فأقرأَنيها فَما أعلمُ إلَّا أنِّي وجدتُ انقِصافًا في ظَهْري حتَّى تمطَّأتُ لَها فقُلتُ يا رسولَ اللَّهِ وأيُّنا لم يعمَل سوءً وإنَّا لَمُجزَونَ بما عمِلنا فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ أمَّا أنتَ يا أبا بَكْرٍ وأصحابُكَ المؤمِنونَ فتُجزَونَ بِهِ فيِ الدُّنيا حتَّى تَلقَوا اللَّهَ عزَّ وجلَّ وليسَت لَكُم ذنوبٌ ",["وأمَّا الآخرونَ",1]," ",["فيؤخَّرُ فيُجمَعُ ذلِكَ لَهُم حتَّى يُجزَوا بِهِ يومَ القيامةِ",2]],"grade":"حسن","narrator":"أبو بكر الصديق","muhaddith":"حسن غريب","takhrij":"أخرجه الترمذي (3039)، وعبد بن حميد (7)، والبزار (20) باختلاف يسير","bab":"تفسير آيات › سورة النساء","dorar":"xlo7f4uu"},{"id":"ق-1418","fp":"2a88914f8683","stateId":731,"easy":"التكذيب بيوم الدين والاعتداء والإثم ← الويل","cause":"التكذيب بيوم الدين والاعتداء والإثم","result":"الويل","explicit":true,"ref":"سورة المطففين: 10–13","srcLabel":"القرآن الكريم","quran":{"s":83,"from":10,"to":13,"text":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ (10) الَّذِينَ يُكَذِّبُونَ بِيَوْمِ الدِّينِ (11) وَمَا يُكَذِّبُ بِهِ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ (12) إِذَا تُتْلَى عَلَيْهِ آيَاتُنَا قَالَ أَسَاطِيرُ الْأَوَّلِينَ (13)","hl":[[0,205,1]]}},{"id":"س-02978","fp":"b38e4b8fae00","stateId":731,"easy":"إذا عبدت الله ثم لقيته وأنت مبغض لأهل بيت النبي ﷺ ← تدخل النار (على رواية)","cause":"فلو أنَّ رَجلًا صفَنَ بيْنَ الرُّكنِ والمَقامِ فصَلَّى، وصامَ، ثمَّ لَقيَ اللهَ وهو مُبغِضٌ لأهْلِ بَيتِ محمَّدٍ صلَّى اللهُ عليه وسلَّمَ","result":"دخَلَ النَّارَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"المستدرك على الصحيحين 4771","srcLabel":"مسلم","text":["يا بَني عَبدِ المطَّلِبِ، إنِّي سألْتُ اللهَ لكم ثَلاثًا: أنْ يُثبِّتَ قائمَكم، وأنْ يَهْديَ ضالَّكم، وأنْ يُعلِّمَ جاهِلَكم، وسألْتُ اللهَ أنْ يَجعَلَكم جُوَداءَ نُجَداءَ رُحَماءَ، ",["فلو أنَّ رَجلًا صفَنَ بيْنَ الرُّكنِ والمَقامِ فصَلَّى، وصامَ، ثمَّ لَقيَ اللهَ وهو مُبغِضٌ لأهْلِ بَيتِ محمَّدٍ صلَّى اللهُ عليه وسلَّمَ",1]," ",["دخَلَ النَّارَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه الطبراني (11412) (11/  176)، وابن أبي عاصم  (1546)،  وابن بشران (465)\n واللفظ لهم","bab":"إيمان › الوعيد","dorar":"wZjrPy5d"},{"id":"س-03929","fp":"29fcfe46460c","stateId":732,"easy":"إذا فتنت نفسك وتربصت وارتبت ← يُضرب بينك وبين المؤمنين بسور","cause":"فَتَنْتُمْ أَنْفُسَكُمْ وَتَرَبَّصْتُمْ وَارْتَبْتُمْ وَغَرَّتْكُمُ الْأَمَانِيُّ","result":"وقد ضُرِبَ بَيْنَهُمْ بِسُورٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[22],"ref":"المستدرك على الصحيحين 3557","srcLabel":"البيهقي","text":["خَرَجْنا على جِنازةٍ في بابِ دِمَشقَ معنا أبو أُمامةَ الباهِليُّ رَضيَ اللهُ عنه، فلمَّا صلَّى على الجِنازةِ، وأخذوا في دفْنِها، قالَ أبو أُمامةَ: يا أيُّها النَّاسُ، إنَّكم قد أَصبَحْتُم وأَمسَيْتُم في مَنزِلٍ تَقتسِمونَ فيه الحسناتِ والسَّيِّئاتِ، وتُوشِكونَ أنْ تَظعنوا منه إلى المَنزلِ الآخرِ، وهو هذا -يُشيرُ إلى القبرِ- بيتُ الوَحدةِ، وبيتُ الظُّلمةِ، وبيتُ الدُّودِ، وبيتُ الضِّيقِ إلَّا ما وَسَّعَ اللهُ، ثُمَّ تُنتقِلونَ منه إلى مَواطنِ يومِ القيامةِ، فإنَّكم لفي بعضِ تلك المواطنِ حتَّى يَغشى النَّاسَ أَمرٌ مِنْ أَمرِ اللهِ، فتَبيضُّ وجوهٌ وتَسودُّ وجوهٌ، ثُمَّ تَنتقِلونَ منه إلى مَنزِلٍ آخرَ فيَغشى النَّاسَ ظُلمةٌ شديدةٌ، ثُمَّ يُقسَمُ النُّورُ فيُعطى المؤمنُ نورًا، ويُتركُ الكافرُ والمنافقُ، فلا يُعطَيانِ شيئًا، وهو المَثلُ الَّذي ضَرَبَهُ اللهُ تَعالَى في كتابِهِ: {أَوْ كَظُلُمَاتٍ فِي بَحْرٍ لُجِّيٍّ يَغْشَاهُ مَوْجٌ مِنْ فَوْقِهِ مَوْجٌ مِنْ فَوْقِهِ سَحَابٌ ظُلُمَاتٌ بَعْضُهَا فَوْقَ بَعْضٍ إِذَا أَخْرَجَ يَدَهُ لَمْ يَكَدْ يَرَاهَا وَمَنْ لَمْ يَجْعَلِ اللَّهُ لَهُ نُورًا فَمَا لَهُ مِنْ نُورٍ (40)} [النور: 40]، ولا يَستضيءُ الكافرُ، والمنافقُ بنورِ المؤمنِ كما لا يَستضيءُ الأعمى ببَصرِ البَصيرِ، يقولُ المنافقُ للَّذين آمنوا: {انْظُرُونَا نَقْتَبِسْ مِنْ نُورِكُمْ قِيلَ ارْجِعُوا وَرَاءَكُمْ فَالْتَمِسُوا نُورًا} [الحديد: 13] وهي خُدعةُ اللهِ الَّتي خَدَعَ بها المنافقَ، قالَ اللهُ عزَّ وجلَّ: {يُخَادِعُونَ اللَّهَ وَهُوَ خَادِعُهُمْ} [النساء: 142]، فيَرجِعونَ إلى المكانِ الَّذي قُسِمَ فيه النُّورُ، فلا يَجدونَ شيئًا فيَنصرِفونَ إليهم، ",["وقد ضُرِبَ {بَيْنَهُمْ بِسُورٍ",2]," لَهُ بَابٌ بَاطِنُهُ فِيهِ الرَّحْمَةُ وَظَاهِرُهُ مِنْ قِبَلِهِ الْعَذَابُ (13) يُنَادُونَهُمْ أَلَمْ نَكُنْ مَعَكُمْ} [الحديد: 13، 14]؟ نُصلِّي صلاتَكُم ونَغزو مَغازيَكم؟ {قَالُوا بَلَى وَلَكِنَّكُمْ ",["فَتَنْتُمْ أَنْفُسَكُمْ وَتَرَبَّصْتُمْ وَارْتَبْتُمْ وَغَرَّتْكُمُ الْأَمَانِيُّ",1]," حَتَّى جَاءَ أَمْرُ اللَّهِ وَغَرَّكُمْ بِاللَّهِ الْغَرُورُ} [الحديد: 14]، تلا إلى قولِهِ: {وَبِئْسَ الْمَصِيرُ} [الحديد: 15]."],"grade":"صحيح","narrator":"سليم بن عامر","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((الأسماء والصفات)) (1015)، وابن أبي الدنيا في ((الأهوال)) (99) بلفظه.","bab":"تفسير آيات › سورة النساء","dorar":"hES7pZbO"},{"id":"س-05008","fp":"ff749ced9b0d","stateId":732,"easy":"إذا أحدثت بعد النبي ﷺ وارتددت ← تُحلّأ عن حوضه","cause":"بما أحدَثوا بَعدَك، إنَّهمُ ارتَدُّوا على أدبارِهمُ القَهقَرى","result":"فيُحَلَّؤونَ عنه","explicit":true,"star":true,"ref":"صحيح البخاري 6586","srcLabel":"البخاري","text":["يَرِدُ على الحَوضِ رِجالٌ مِن أصحابي، ",["فيُحَلَّؤونَ عنه",2],"، فأقولُ: يا رَبِّ، أصحابي، فيَقولُ: إنَّك لا عِلمَ لك ",["بما أحدَثوا بَعدَك، إنَّهمُ ارتَدُّوا على أدبارِهمُ القَهقَرى",1],". قال شُعَيبٌ عن الزُّهريِّ: كان أبو هُرَيرةَ يُحَدِّثُ عن النَّبيِّ صلَّى اللهُ عليه وسلَّم: فيُجْلَون. وقال عُقَيلٌ: فيُحَلَّؤون، وقال الزُّبَيديُّ عن الزُّهريِّ عن محمَّدِ بنِ عليٍّ عن عُبَيدِ اللهِ بنِ أبي رافعٍ عن أبي هُرَيرةَ عن النَّبيِّ صلَّى اللهُ عليه وسلَّم"],"grade":"صحيح","narrator":"أصحاب النبي صلى الله عليه وسلم","muhaddith":"[صحيح]","takhrij":"لم نقف عليه بهذا الإسناد إلا عند البخاري (6214).","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"KEJYpgjc"},{"id":"ق-0151","fp":"f5a09720a0ae","stateId":732,"easy":"الكفر بعد الإيمان ← اسوداد الوجه والعذاب","cause":"الكفر بعد الإيمان","result":"اسوداد الوجه والعذاب","explicit":true,"ref":"سورة آل عمران: 106","srcLabel":"القرآن الكريم","quran":{"s":3,"from":106,"to":106,"text":"يَوْمَ تَبْيَضُّ وُجُوهٌ وَتَسْوَدُّ وُجُوهٌ فَأَمَّا الَّذِينَ اسْوَدَّتْ وُجُوهُهُمْ أَكَفَرْتُمْ بَعْدَ إِيمَانِكُمْ فَذُوقُوا الْعَذَابَ بِمَا كُنْتُمْ تَكْفُرُونَ (106)","hl":[[45,167,1]]}},{"id":"ق-0262","fp":"93a036a4c14d","stateId":732,"easy":"النفاق ← عذاب أليم","cause":"النفاق","result":"عذاب أليم","explicit":true,"ref":"سورة النساء: 138","srcLabel":"القرآن الكريم","quran":{"s":4,"from":138,"to":138,"text":"بَشِّرِ الْمُنَافِقِينَ بِأَنَّ لَهُمْ عَذَابًا أَلِيمًا (138)","hl":[[0,56,1]]}},{"id":"ق-0267","fp":"63cd0b44755e","stateId":732,"easy":"النفاق ← الدرك الأسفل من النار ولا نصير","cause":"النفاق","result":"الدرك الأسفل من النار ولا نصير","explicit":true,"ref":"سورة النساء: 145","srcLabel":"القرآن الكريم","quran":{"s":4,"from":145,"to":145,"text":"إِنَّ الْمُنَافِقِينَ فِي الدَّرْكِ الْأَسْفَلِ مِنَ النَّارِ وَلَنْ تَجِدَ لَهُمْ نَصِيرًا (145)","hl":[[0,91,1]]}},{"id":"ق-0510","fp":"6b2f4a91ecd9","stateId":732,"easy":"النفاق والكفر ← نار جهنم ولعنة الله وعذاب مقيم","cause":"النفاق والكفر","result":"نار جهنم ولعنة الله وعذاب مقيم","explicit":true,"otherNeedIds":[28],"ref":"سورة التوبة: 68","srcLabel":"القرآن الكريم","quran":{"s":9,"from":68,"to":68,"text":"وَعَدَ اللَّهُ الْمُنَافِقِينَ وَالْمُنَافِقَاتِ وَالْكُفَّارَ نَارَ جَهَنَّمَ خَالِدِينَ فِيهَا هِيَ حَسْبُهُمْ وَلَعَنَهُمُ اللَّهُ وَلَهُمْ عَذَابٌ مُقِيمٌ (68)","hl":[[0,158,1]]}},{"id":"ق-0515","fp":"2766120dc065","stateId":732,"easy":"التولي عن التوبة ← عذاب أليم في الدنيا والآخرة ولا وليّ ولا نصير","cause":"التولي عن التوبة","result":"عذاب أليم في الدنيا والآخرة ولا وليّ ولا نصير","explicit":true,"otherNeedIds":[56,60],"ref":"سورة التوبة: 74","srcLabel":"القرآن الكريم","quran":{"s":9,"from":74,"to":74,"text":"يَحْلِفُونَ بِاللَّهِ مَا قَالُوا وَلَقَدْ قَالُوا كَلِمَةَ الْكُفْرِ وَكَفَرُوا بَعْدَ إِسْلَامِهِمْ وَهَمُّوا بِمَا لَمْ يَنَالُوا وَمَا نَقَمُوا إِلَّا أَنْ أَغْنَاهُمُ اللَّهُ وَرَسُولُهُ مِنْ فَضْلِهِ فَإِنْ يَتُوبُوا يَكُ خَيْرًا لَهُمْ وَإِنْ يَتَوَلَّوْا يُعَذِّبْهُمُ اللَّهُ عَذَابًا أَلِيمًا فِي الدُّنْيَا وَالْآخِرَةِ وَمَا لَهُمْ فِي الْأَرْضِ مِنْ وَلِيٍّ وَلَا نَصِيرٍ (74)","hl":[[243,384,1]]}},{"id":"ق-0519","fp":"7d9dbf16e60c","stateId":732,"easy":"الفرح بالتخلف عن الجهاد ← نار جهنم أشد حراً وبكاء كثير","cause":"الفرح بالتخلف عن الجهاد","result":"نار جهنم أشد حراً وبكاء كثير","explicit":true,"ref":"سورة التوبة: 81–82","srcLabel":"القرآن الكريم","quran":{"s":9,"from":81,"to":82,"text":"فَرِحَ الْمُخَلَّفُونَ بِمَقْعَدِهِمْ خِلَافَ رَسُولِ اللَّهِ وَكَرِهُوا أَنْ يُجَاهِدُوا بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ فِي سَبِيلِ اللَّهِ وَقَالُوا لَا تَنْفِرُوا فِي الْحَرِّ قُلْ نَارُ جَهَنَّمَ أَشَدُّ حَرًّا لَوْ كَانُوا يَفْقَهُونَ (81) فَلْيَضْحَكُوا قَلِيلًا وَلْيَبْكُوا كَثِيرًا جَزَاءً بِمَا كَانُوا يَكْسِبُونَ (82)","hl":[[0,324,1]]}},{"id":"ق-0522","fp":"eee1c5fd70a1","stateId":732,"easy":"النفاق ← رجس ومأواهم جهنم","cause":"النفاق","result":"رجس ومأواهم جهنم","explicit":true,"ref":"سورة التوبة: 95","srcLabel":"القرآن الكريم","quran":{"s":9,"from":95,"to":95,"text":"سَيَحْلِفُونَ بِاللَّهِ لَكُمْ إِذَا انْقَلَبْتُمْ إِلَيْهِمْ لِتُعْرِضُوا عَنْهُمْ فَأَعْرِضُوا عَنْهُمْ إِنَّهُمْ رِجْسٌ وَمَأْوَاهُمْ جَهَنَّمُ جَزَاءً بِمَا كَانُوا يَكْسِبُونَ (95)","hl":[[106,180,1]]}},{"id":"ق-0532","fp":"84f7e19e7e90","stateId":732,"easy":"تأسيس العمل على غير التقوى (الضرار والنفاق) ← الانهيار في نار جهنم","cause":"تأسيس العمل على غير التقوى (الضرار والنفاق)","result":"الانهيار في نار جهنم","explicit":true,"otherNeedIds":[52],"ref":"سورة التوبة: 109","srcLabel":"القرآن الكريم","quran":{"s":9,"from":109,"to":109,"text":"أَفَمَنْ أَسَّسَ بُنْيَانَهُ عَلَى تَقْوَى مِنَ اللَّهِ وَرِضْوَانٍ خَيْرٌ أَمْ مَنْ أَسَّسَ بُنْيَانَهُ عَلَى شَفَا جُرُفٍ هَارٍ فَانْهَارَ بِهِ فِي نَارِ جَهَنَّمَ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ (109)","hl":[[75,165,1]]}},{"id":"ق-1299","fp":"86b082016ec0","stateId":732,"easy":"النفاق: فتنة النفس والتربص والارتياب والاغترار بالأماني ← الحرمان من النور ولا تؤخذ فدية ومأواهم النار","cause":"النفاق: فتنة النفس والتربص والارتياب والاغترار بالأماني","result":"الحرمان من النور ولا تؤخذ فدية ومأواهم النار","explicit":true,"otherNeedIds":[71],"ref":"سورة الحديد: 13–15","srcLabel":"القرآن الكريم","quran":{"s":57,"from":13,"to":15,"text":"يَوْمَ يَقُولُ الْمُنَافِقُونَ وَالْمُنَافِقَاتُ لِلَّذِينَ آمَنُوا انْظُرُونَا نَقْتَبِسْ مِنْ نُورِكُمْ قِيلَ ارْجِعُوا وَرَاءَكُمْ فَالْتَمِسُوا نُورًا فَضُرِبَ بَيْنَهُمْ بِسُورٍ لَهُ بَابٌ بَاطِنُهُ فِيهِ الرَّحْمَةُ وَظَاهِرُهُ مِنْ قِبَلِهِ الْعَذَابُ (13) يُنَادُونَهُمْ أَلَمْ نَكُنْ مَعَكُمْ قَالُوا بَلَى وَلَكِنَّكُمْ فَتَنْتُمْ أَنْفُسَكُمْ وَتَرَبَّصْتُمْ وَارْتَبْتُمْ وَغَرَّتْكُمُ الْأَمَانِيُّ حَتَّى جَاءَ أَمْرُ اللَّهِ وَغَرَّكُمْ بِاللَّهِ الْغَرُورُ (14) فَالْيَوْمَ لَا يُؤْخَذُ مِنْكُمْ فِدْيَةٌ وَلَا مِنَ الَّذِينَ كَفَرُوا مَأْوَاكُمُ النَّارُ هِيَ مَوْلَاكُمْ وَبِئْسَ الْمَصِيرُ (15)","hl":[[0,608,1]]}},{"id":"س-03911","fp":"5b3f0c7f345e","stateId":732,"easy":"إذا نافقت ← فالمنافقون في الدرك الأسفل من النار","cause":"إنَّ المُنافِقينَ","result":"في الدَّركِ الأسفَلِ مِنَ النَّارِ","explicit":true,"otherNeedIds":[22],"ref":"صحيح البخاري 4602","srcLabel":"النسائي","text":["كُنَّا في حَلقةِ عبدِ اللهِ فجاءَ حُذَيفةُ حتَّى قامَ علينا فسَلَّمَ، ثُمَّ قال: لقد أُنزِلَ النِّفاقُ على قَومٍ خَيرٍ مِنكُم، قال الأسودُ: سُبحانَ اللهِ! إنَّ اللهَ يقولُ: {",["إنَّ المُنافِقينَ",1]," ",["في الدَّركِ الأسفَلِ مِنَ النَّارِ",2],"} [النساء: 145]، فتَبَسَّمَ عبدُ اللهِ، وجَلَسَ حُذَيفةُ في ناحيةِ المَسجِدِ، فقامَ عبدُ اللهِ فتَفَرَّقَ أصحابُه، فرَماني بالحَصى، فأتَيتُه، فقال حُذَيفةُ: عَجِبتُ مِن ضَحِكِه، وقد عَرَفَ ما قُلتُ، لقد أُنزِلَ النِّفاقُ على قَومٍ كانوا خَيرًا مِنكُم ثُمَّ تابوا، فتابَ اللهُ عليهم."],"grade":"صحيح","narrator":"الأسود بن يزيد","muhaddith":"[صحيح]","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (11532) باختلاف يسير، والبيهقي (16925) بنحوه مختصرا .","bab":"تفسير آيات › سورة النساء","dorar":"pab43FSU","merged":2,"otherRefs":["عمدة التفسير 1/592 (صحيح)"]},{"id":"س-02785","fp":"e1002423bf84","stateId":732,"easy":"إذا جاهدت وأنت منافق ← فأنت في النار، فالسيف لا يمحو النفاق","cause":"ورجلٌ منافقٌ جاهَد بنفسِه ومالِه في سبيلِ اللهِ","result":"فذلك في النَّارِ إنَّ السَّيفَ لا يمحو النِّفاقَ","explicit":true,"otherNeedIds":[22],"ref":"صحيح ابن حبان 4663","srcLabel":"أحمد","text":["القتلى ثلاثةٌ: رجلٌ مؤمنٌ جاهَد بنفسِه ومالِه في سبيلِ اللهِ حتَّى إذا لقي العدوَّ قاتَلهم حتَّى يُقتَلَ فذلك الشَّهيدُ الممتحَنُ في خيمةِ اللهِ تحتَ عرشِه ولا يفضُلُه النَّبيُّون إلَّا بفضلِ درجةِ النُّبوَّةِ، ورجلٌ مؤمنٌ قرَف على نفسِه مِن الذُّنوبِ والخطايا جاهَد بنفسِه ومالِه في سبيلِ اللهِ حتَّى إذا لقي العدوَّ قاتَل حتَّى قُتِل فتلك مَصْمَصةٌ محَتْ ذنوبَه وخطاياه، إنَّ السَّيفَ محَّاءٌ للخطايا وأُدخِل مِن أيِّ أبوابِ الجنَّةِ شاء فإنَّ لها ثمانيةَ أبوابٍ، ولجهنَّمَ سبعةَ أبوابٍ، وبعضُها أفضلُ مِن بعضٍ، ",["ورجلٌ منافقٌ جاهَد بنفسِه ومالِه في سبيلِ اللهِ",1]," حتَّى إذا لقي العدوَّ قاتَل حتَّى قُتِل ",["فذلك في النَّارِ إنَّ السَّيفَ لا يمحو النِّفاقَ",2]],"grade":"صحيح","narrator":"عتبة بن عبد السلمي","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (17657)، والطبراني (17/ 126) (311) كلاهما بلفظه، والدارمي (2455) بنحوه.","bab":"إيمان › النفاق","dorar":"3DmVqyKb"},{"id":"س-06829","fp":"ef325d2bd585","stateId":732,"easy":"إذا كنت منافقاً ← لا تستطيع أن تسجد يوم القيامة","cause":"كلُّ مُنافِقٍ","result":"فلا يَسْتَطِيعُ أنْ يَسْجُدَ","explicit":true,"otherNeedIds":[22],"ref":"السلسلة الصحيحة 584","srcLabel":"الدارمي","text":["إذا جَمَعَ اللهُ العِبادَ بصَعِيدٍ و احِدٍ نادَى مُنادٍ : يَلْحَقُ كلُّ قومٍ بِما كَانُوا يَعْبُدُونَ ، و يَبْقَى الناسُ على حالِهمْ ، فَيأتيهِمْ فيقولُ : ما بالُ الناسِ ذَهَبُوا و أنْتُمْ هاهُنا ‍‍‍‍‍‍‍‍‍‍‍‍ ؟ فَيقولونَ نَنْتَظِرُ إلهَنا ، فيقولُ هل تَعْرِفُونَهُ ؟ فَيقولونَ : إذا تَعَرَّفَ إِلَيْنا عَرَفْناهُ ، فَيَكْشِفُ لهُمْ عن ساقِهِ ، فَيَقَعُونَ سُجُودًا ، و ذلكَ لقولِ اللهِ تعالى : \" يومَ يُكْشَفُ عن ساقٍ و يُدْعَوْنَ إلى السُّجُودِ فلا يَسْتَطِيعُونَ \" ، و يَبْقَى ",["كلُّ مُنافِقٍ",1]," ، ",["فلا يَسْتَطِيعُ أنْ يَسْجُدَ",2]," ، ثُمَّ يَقُودُهُمْ إلى الجنةِ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده جيد","takhrij":"أخرجه الدارمي (2803) واللفظ له، وابن أبي عاصم في ((السنة)) (732)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"D9OWUm6s"},{"id":"س-01785","fp":"47142a58fce0","stateId":732,"easy":"إذا نافقت ← يُختم على فيك وتنطق جوارحك بعملك","cause":"وذلك المنافقُ","result":"فيختمُ على فيه ويقالُ لفخِذِه: انطِقي فينطقُ فخِذُه ولحمُه وعظامُه بعملِه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"إتحاف الخيرة المهرة 8/171","srcLabel":"متفق عليه","text":["يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّم  هل نَرى ربَّنا يومَ القيامةِ ؟ فقال: هل تُضارُّونَ في رؤيةِ الشمسِ في الظهيرةِ ليسَتْ في سحابةٍ ؟ قالوا: لا  قال: فهل تُضارُّونَ في رؤيةِ القمرِ ليلةَ البدرِ ليس في سحابةٍ ؟ قالوا: لا , قال  فوالذي نفسي بيدِه لا تُضارُّونَ في رؤيةِ ربِّكم إلا كما تُضارُّونَ في رؤيةِ أحدِهما  فيَلقى العبدُ ربَّه فيقولُ: أيْ فُل ألم أُكرِمْكَ  وأُسَوِّدْكَ  وأُزَوِّجْكَ  وأُسَخِّرْ لكَ الخيلَ والإبلَ وأذرَكَ ترأَسُ وتَربَعُ  قال: فيقولُ: بَلى يا ربِّ  قال: فيقولُ: فظننتَ أنكَ مُلاقِيَّ ؟ فيقولُ: لا فيقولُ: إني أنساكَ كما نَسيتَني ثم يَلقى الثانيَ فيقولُ  أيْ فُل ألم أُكرِمْكَ  وأُسَوِّدْكَ  وأُزَوِّجْكَ  وأُسَخِّرْ لكَ الخيلَ والإبلَ وأذرَكَ تَرأَسُ وتَربَعُ  قال: فيقولُ: بَلى يا ربِّ  قال: فيقولُ: فظننتَ أنكَ مُلاقِيَّ ؟ فيقولُ: لا , فيقولُ: فإني أنساكَ كما نَسيتَني  ثم يَلقى الثالثَ فيقول: أيْ فُل ألم أُكرِمْكَ  وأُسَوِّدْكَ  وأُزَوِّجْكَ  وأُسَخِّرْ لكَ الخيلَ والإبلَ وأذرَكَ تَرأَسُ وتَربَعُ ؟ فيقولُ: بَلى يا ربِّ فيقولُ: ظننتَ أنكَ مُلاقِيَّ ؟ فيقولُ: آمنتُ بكَ وبكتابِكَ وبرُسُلِكَ  وصلَّيتُ  وصُمتُ  وتصدَّقتُ  ويُثني بخيرٍ ما استَطاع قال: فيقولُ: فها هُنا إذًا  قال: ثم قال: ألا نبعثُ شاهدَنا عليكَ , فيفكرُ في نفسِه مَن ذا الذي يشهدُ عليَّ , ",["فيختمُ على فيه ويقالُ لفخِذِه: انطِقي فينطقُ فخِذُه ولحمُه وعظامُه بعملِه",2]," ما كان  وذلك ليعذرَ مِن نفسِه ",["وذلك المنافقُ",1],"  وذلك الذي يسخطُ اللهُ عليه ثم يُنادي منادٍ: ألا لتتبعْ كلُّ أمةٍ ما كانتْ تعبدُ مِن دونِ اللهِ فتتبعُ الشياطينَ والصلبَ أولياؤهم إلى جهنَّمَ قال: وبَقينا أيُّها المؤمنونَ فيأتينا ربُّنا  عزَّ وجلَّ  وهو ربُّنا وهو يُثيبُنا  فيقولَنَّ: علامَ هؤلاءِ ؟ فيقولونَ: نحن عبادُ اللهِ المؤمنينَ آمَنَّا باللهِ لا نُشرِكُ به شيئًا  وهذا مقامُنا حتى يأتيَنا ربُّنا  عزَّ وجلَّ  وهو ربُّنا وهو مُثبِتُنا  قال: ثم ينطلقُ حتى يأتيَ الجسرَ وعليه كلاليبُ مِن نارٍ تخطفُ الناسَ  فعندَ ذلك حلَّتِ الشفاعةُ ودعوى الرسلِ يومئذٍ: اللهم سلِّمْ  أي اللهم سلِّمْ  فإذا جاوَزوا الجسرَ فكلُّ مَن أنفَق زوجًا مما ملَكَتْ يمينُه منَ المالِ في سبيلِ اللهِ فكلُّ خزنةِ الجنةِ يدعونَه: يا عبدَ اللهِ  يا مسلمُ  هذا خيرٌ فتعالَ  قال: فقال أبو بكرٍ: يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّم  إنَّ هذا العبدَ لا تَوى عليه يدعُ بابًا ويلِجُ بابًا قال: فضرَبه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بيدِه ثم قال: والذي نفسُ محمدٍ بيدِه إني لأرجو أن تكونَ منهم"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سنده صحيح","takhrij":"أخرجه الحميدي (1178) واللفظ له، وأخرجه البخاري (6573) بنحوه، ومسلم (2968) باختلاف يسير","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"NJUioHng"},{"id":"س-04187","fp":"93d60f5de623","stateId":732,"easy":"إذا ارتددت على عقبيك ← تُساق إلى النار","cause":"إنَّهمْ ارْتدُّوا بعدَكَ على أدْبارِهِمْ القَهْقَرَى","result":"إلى النارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[22],"ref":"صحيح الجامع 2867","srcLabel":"البخاري","text":["بيْنما أنا نائِمٌ إذا زُمْرَةٌ ، حتى إذا عرَفْتُهُمْ ، خرَجَ رجلٌ من بيْنِي وبيْنِهِمْ فقال : هَلُمَّ ، قُلتُ : أيْنَ ؟ قال : إلى النارِ واللهِ ، قُلتُ : ما شأنُهُمْ ؟ قال : ",["إنَّهمْ ارْتدُّوا بعدَكَ على أدْبارِهِمْ القَهْقَرَى",1]," ، ثمَّ إذا زُمرةٌ ، حتى إذا عرَفتُهُمْ خرَجَ رجلٌ من بينِي وبينِهِمْ فقال : هلُمَّ ، قُلتُ : أيْنَ ؟ قال : ",["إلى النارِ",2]," ، قُلتُ : ما شأنُهُمْ ؟ قال : إنَّهمْ ارتَدُّوا بعدَكَ على أدْبارِهِمْ القَهْقَرَى ، فلا أُراهُ يَخلُصُ مِنهُمْ إلَّا مثْلُ هَمَلِ النَّعَمِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6587) واللفظ له، وأبو عوانة في ((المستخرج)) (10164)، وابن عبد البر في ((التمهيد)) (2/ 296) بنحوه.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"tWLctCbb"},{"id":"س-02786","fp":"fa59ed455ac8","stateId":732,"easy":"إذا نافقت ← يُطفأ نورك يوم القيامة","cause":"المُنافِقينَ","result":"ثُمَّ يُطفَأُ نورُ المُنافِقينَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-02798","س-08446"],"otherNeedIds":[22],"ref":"تخريج المسند لشعيب 14721","srcLabel":"أحمد","text":["نحنُ يومَ القيامةِ على كَوْمٍ فوقَ النَّاسِ، فيُدعى بالأُمَمِ بأَوْثانِها، وما كانت تَعبُدُ، الأوَّلَ، فالأوَّلَ، ثُمَّ يأتينا رَبُّنا عزَّ وجلَّ بعدَ ذلك، فيقولُ: ما تَنتظرون؟ فيقولونَ: نَنتَظِرُ ربَّنا عزَّ وجلَّ، فيقولُ: أنا رَبُّكُم، فيقولونَ: حتى نَنظُرَ إليه، قال: فيَتَجَلَّى لهم وهو يَضحَكُ، ويُعْطي كلَّ إنسانٍ منهم مُنافِقٍ ومُؤمِنٍ نورًا، وتَغْشاهُ ظُلْمةٌ، ثُمَّ يَتْبَعونَه معهم، المُنافِقون على جِسْرِ جَهنَّمَ، فيه كَلاليبُ وحَسَكٌ يَأخُذونَ مَنْ شاءَ، ",["ثُمَّ يُطفَأُ نورُ المُنافِقينَ",2],"، ويَنجو المُؤمِنونَ، فتَنْجو أوَّلُ زُمْرةٍ وُجوهُهم كالقَمَرِ ليلَةَ البَدْرِ، سَبعونَ ألفًا لا يُحاسَبونَ، ثُمَّ الذين يَلونَهم، كأَضْوَأِ نَجمٍ في السَّماءِ، ثُمَّ ذلك حتى تَحِلَّ الشفاعةُ، فيَشْفَعونَ حتى يَخْرُجَ مَن قال: لا إلهَ إلَّا اللهُ ممَّن في قلبِه ميزانُ شَعيرةٍ، فيُجْعَلُ بفِناءِ الجَنَّةِ، ويَجْعَلُ أهلَ الجَنَّةِ يُهْريقونَ عليهم مِن الماءِ، حتى يَنْبُتون نَباتَ الشَّيءِ في السَّيلِ، ويَذهَبُ حَرَقُهم، ثُمَّ يَسْألُ اللهَ عزَّ وجلَّ حتى يَجْعَلَ له الدُّنيا، وعَشَرةَ أمْثالِها."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أحمد (14721) واللفظ له، والدارمي في ((الرد على الجهمية)) (185) مختصراً، والطبراني في ((المعجم الأوسط)) (9075) باختلاف يسير","bab":"إيمان › النفاق","dorar":"UPme3nkI"},{"id":"س-02798","fp":"65df7a68eff8","stateId":732,"easy":"إذا نافقت ← يُطفأ نورك","cause":"المنافقُ","result":"فيُطفئُ نورَهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-02786","otherNeedIds":[22],"ref":"المستدرك على الصحيحين 3878","text":["عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهُما في قولِ اللهِ عزَّ وجلَّ: {يَوْمَ لَا يُخْزِي اللَّهُ النَّبِيَّ وَالَّذِينَ آمَنُوا مَعَهُ نُورُهُمْ يَسْعَى بَيْنَ أَيْدِيهِمْ وَبِأَيْمَانِهِمْ يَقُولُونَ رَبَّنَا أَتْمِمْ لَنَا نُورَنَا} [التحريم: 8] قالَ: ليس أَحَدٌ مِنَ الموحِّدينَ إلَّا يُعطى نورًا يومَ القيامةِ، فأمَّا ",["المنافقُ",1]," ",["فيُطفئُ نورَهُ",2],"، والمؤمنُ مُشفِقٌ ممَّا رَأى مِن إطفاءِ نورِ المنافقِ، فهو يقولُ: {رَبَّنَا أَتْمِمْ لَنَا نُورَنَا}."],"grade":"صحيح","narrator":"عكرمة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن أبي حاتم كما في ((تفسير)) لابن كثير (1/ 192) بلفظ مقارب.","bab":"إيمان › النفاق","dorar":"ozt0akKO"},{"id":"س-08193","fp":"4ca62cb15d5c","stateId":732,"easy":"إذا نافقت ← يُدمج صلبك فلا تستطيع السجود","cause":"المنافقينَ","result":"وتُدْمَجُ أصلابُ المنافقينَ فتكونُ عظمًا واحدًا كأنَّها صَيَاصِيُّ البقرِ ، ويخرُّونَ على أقْفيتِهِم","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"المطالب العالية 5/100","srcLabel":"الطبري","text":["إنَّ عبدَ اللهِ بنَ مسعودٍ رضيَ اللهُ عنهُ حدَّثَ عمرَ بنَ الخطَّابِ رضيَ اللهُ عنهُ هذا الحديثَ فقال : إذا حُشِرَ النَّاسُ يومَ القيامةِ قاموا أربعينَ ، على رؤوسِهِم الشَّمسُ ، شاخصةً أبصارُهُم إلى السَّماءِ ، ينتظرونَ الفصلَ ، كلُّ برٍّ منهُم وفاجرٍ ، لا يتكلمُ منهُم بشرٌ ، ثمَّ يُنادي مُنادٍ : أليسَ عدلًا من ربِّكُم الَّذي خلقَكُم وصوَّرَكُم ورزقَكُم ثمَّ عبدتُم غيرَهُ أن يُولِّي كلَّ قَومٍ ما تولَّوْا ؟ فيقولونَ : بلَى . فيُنادي بذلكَ ملَكٌ ثلاثَ مرَّاتٍ ، ثمَّ يُمَثَّلُ لكلِّ قَومٍ آلهتُهُم الَّتي كانوا يعبدونَها ، فيتبِعونَها حتَّى تُوردَهم النَّارُ ، فيبقَى المؤمنونَ والمنافقونَ ، فيخرُّ المؤمنونَ سُجَّدًا ، ",["وتُدْمَجُ أصلابُ المنافقينَ فتكونُ عظمًا واحدًا كأنَّها صَيَاصِيُّ البقرِ ، ويخرُّونَ على أقْفيتِهِم",2]," ، فيقولُ اللهُ تعالى لهُم : ارفَعوا رؤوسَكُم إلى نورِكم بقدرِ أعمالِكُم ، فيرفعُ الرَّجلُ رأسَهُ ونورُهُ بينَ يدَيْهِ مثلُ الجبلِ ، ويرفعُ الرَّجلُ رأسَهُ ونورُهُ بينَ يدَيهِ مثلُ القصرِ ، ويرفعُ الرَّجلُ رأسَهُ ونورُهُ بينَ يدَيهِ مثلُ البَيتِ ، حتَّى ذكرَ مثلَ الشَّجرةِ ، فيمضونَ على الصِّراطِ كالبرقِ ، وكالرِّيحِ ، وكحضرِ الفرسِ ، وكاشتدادِ الرَّجلِ ، حتَّى يبقَى آخرَ النَّاسِ نورُهُ على إبهامِ رجلِهِ مثلُ السِّراجِ ، فأحيانًا يُضيءُ لهُ ، وأحيانًا يخفَى عليهِ ، فتنفثُ منهُ النَّارُ ، فلا يزالُ كذلكَ حتَّى يخرجَ فيقولُ : ما يدري أحدٌ ما نجا منهُ غَيري ، ولا أصابَ أحدٌ مثلَ ما أصبتَ ، إنَّما أصابَني حرُّها ونجَوتُ منها ، قال : فيُفتَحُ لهُ بابٌ من الجنَّةِ فيقولُ : يا ربِّ ، أدخِلْني هذا ، فيقولُ : عبدي لعلِّي إن أدخلتُكَ تسألْني غيرَهُ . قال : فيُدخِلُهُ ، فبَينا هوَ يعجبُ بما هوَ فيهِ إذ فُتِحَ لهُ بابٌ آخرُ ، فيستَحقِرُ في عَينِهِ الَّذي هوَ فيهِ ، فيقولُ : يا ربِّ ، أدخِلْني هذا . فيقولُ : أو لَم تزعُمْ أنَّكَ لا تسألْني غيرَهُ ، فيقولُ : وعزَّتِكَ وجلالِكَ لئن أدخلتَنِيهِ لا أسألُكَ غيرَهُ . قال : فيُدخِلُهُ حتَّى يُدْخِلَهُ أربعةَ أبوابٍ كلَّها يسألُها ، ثمَّ يستقبلُهُ رجلٌ مثلُ النُّورِ ، فإذا رآهُ هوَى يسجدُ لهُ فيقولُ : ما شأنُكَ ؟ فيقولُ : ألستَ بربِّي ؟ فيقولُ : إنَّما أنا قَهرمانٌ لكَ في الجنَّةِ [ من ] ألفِ قَهرمانٍ على ألفِ قصرٍ ، بينَ كلِّ قصرَيْنِ مسيرةُ ( ألفِ سنةٍ ) ، يُرَى أقصاها كما يُرَى أدناها ، ثمَّ يُفْتَحُ لهُ بابٌ من زَبرجَدةٍ خضراءَ ، فيها سبعونَ بابًا ، في كلِّ بابٍ منها أزواجٌ وسُرُرٌ ومناصفٌ ، فيقعدُ مع زوجتِهِ فتُناولُهُ الكأسَ ، فتقولُ : لأنتَ منذُ ناولتُكَ الكأسَ أحسنُ منكَ قبلَ ذلكَ بسبعينَ ضِعْفًا ، علَيها سبعونَ حُلَّةً ، ألوانُها شتَّى يُرَى مخُّ ساقِها ، ويلبسُ الرَّجلُ ثيابَهُ على كبدِها ، وكبدُها مِرْآتُهُ"],"grade":"صحيح","narrator":"قيس بن السكن وأبو عبيدة بن عبدالله","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبري في ((تفسيره)) (23/ 190) بلفظ قريب، وأورده البلوصيري في ((الإتحاف)) (7684) وعزاه لإسحاق.","bab":"ملائكة › أعمال الملائكة","dorar":"II3fMWHr"},{"id":"س-08446","fp":"fe55ecab8dc9","stateId":732,"easy":"إذا نافقت ← تكون من أشد الناس عذاباً يوم القيامة","cause":"المُنافقونَ","result":"إنَّ أشدَّ النَّاسِ عذابًا يومَ القيامةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-02786","ref":"عمدة التفسير 1/756","text":["عن عبدِ اللَّهِ بنِ عمرٍو قالَ : ",["إنَّ أشدَّ النَّاسِ عذابًا يومَ القيامةِ",2]," ثلاثةٌ : ",["المُنافقونَ",1]," ، ومَن كفرَ مِن أصحابِ المائدةِ ، وآلُ فرعونَ"],"grade":"صحيح","narrator":"أبو المغيرة","muhaddith":"إسناده صحيح","bab":"نفاق › المنافق وما جاء فيه من الوعيد","dorar":"puHvtOE9"},{"id":"س-02792","fp":"9a2f03534741","stateId":733,"easy":"إذا نسيت الله ← ينساك يوم القيامة","cause":"كما نسِيتَني","result":"اليومَ أنساكَ","explicit":true,"star":true,"similar":["س-01784"],"ref":"تخريج صحيح ابن حبان 7445","srcLabel":"مسلم","text":["قال ناسٌ : يا رسولَ اللهِ هل نرى ربَّنا يومَ القيامةِ ؟ قال : ( هل تُضارُّونَ في رؤيةِ الشَّمسِ في يومٍ صائفٍ والسَّماءُ مُصْحيةٌ غيرُ مُتغيِّمةٍ ليس فيها سَحابةٌ ؟ ) قالوا : لا قال : ( فهل تُضارُّونَ في رؤيةِ القمرِ ليلةَ البدرِ والسَّماءُ مُصحِيَةٌ غيرُ مُتغيِّمةٍ ليس فيها سَحابةٌ ؟ ) قالوا : لا قال : ( فوالَّذي نفسي بيدِه كذلك لا تُضارُّونَ في رؤيةِ ربِّكم يومَ القيامةِ كما لا تُضارُّونَ في رؤيةِ واحدٍ منهما يَلْقَى العبدُ ربَّه يومَ القيامةِ فيقولُ اللهُ جلَّ وعلا : أيْ فُلُ ألَمْ أخلُقْكَ ؟ ألَمْ أجعَلْكَ سميعًا بصيرًا ؟ ألَمْ أُزوِّجْكَ ؟ ألَمْ أُكرِمْكَ ؟ ألَمْ أُسخِّرْ لكَ الخيلَ والإبلَ ؟ ألَمْ أُسوِّدْكَ وأذَرْكَ ترأَسُ وتربَعُ ؟ فيقولُ : بلى أيْ ربِّ فيقولُ : فظنَنْتَ أنَّكَ مُلاقِيَّ ؟ فيقولُ : لا يا ربِّ فيقولُ : ",["اليومَ أنساكَ",2]," ",["كما نسِيتَني",1]," \nقال : ويَلقاه الآخَرُ فيقولُ : أيْ فُلُ ؟ ألَمْ أخلُقْكَ ؟ ألَمْ أجعَلْكَ سميعًا بصيرًا ؟ ألَمْ أُزوِّجْكَ ؟ ألَمْ أُكرِمْكَ ؟ ألَمْ أُسخِّرْ لكَ الخيلَ والإبلَ ؟ ألَمْ أُسوِّدْكَ وأذَرْكَ ترأَسُ وتربَعُ فيقولُ : بلى يا ربِّ فيقولُ : فماذا أعدَدْتَ لي ؟ فيقولُ : آمَنْتُ بكَ وبكتابِكَ وبرسولِكَ وصدَّقْتُ وصلَّيْتُ وصُمْتُ فيقولُ : فها هنا إذًا ثمَّ يقولُ : ألَا نبعَثُ عليكَ قال : فيُفكِّرُ في نفسِه مَن هذا الَّذي يشهَدُ علَيَّ ؟ قال : وذلكَ المُنافِقُ الَّذي يغضَبُ اللهُ عليه وذلكَ لِيُعذِرَ مِن نفسِه فيُختَمُ على فيه ويُقالُ لِفخِذِه : انطِقي فتنطِقُ فخِذُه وعِظامُه وعصَبُه بما كان يعمَلُ \nثم يُنادي مُنادٍ ألَا اتَّبَعَتْ كلُّ أمَّةٍ ما كانت تعبُدُ فيتَّبِعُ عبَدَةُ الصَّليبِ الصَّليبَ وعبَدَةُ النَّارِ النَّارَ وعبَدَةُ الأوثانِ الأوثانَ وعبَدَةُ الشَّيطانِ الشَّيطانَ ويتَّبِعُ كلُّ طاغيةٍ طاغيتَها إلى جَهنَّمَ ونَبقى أيُّها المُؤمِنونَ ونحنُ المُؤمِنونَ فيأتينا ربُّنا تبارَك وتعالى ونحنُ قيامٌ فيقولُ : علامَ هؤلاءِ قيامٌ ؟ فنقولُ : نحنُ عبادُ اللهِ المُؤمِنونَ آمنَّا به ولَمْ نُشرِكْ به شيئًا وهذا مَقامُنا ولنْ نبرَحَ حتَّى يأتيَنا ربُّنا وهو ربُّنا وهو يُثبِّتُنا فيقولُ : وهل تعرِفونَه ؟ فنقولُ : سُبحانَه إذا اعترَف لنا عرَفْناه ) قال سُفيانُ : وها هنا كلمةٌ لا أقولُها لكم قال : فننطلِقُ حتَّى نأتيَ الجِسرَ وعليه خَطاطيفُ مِن نارٍ تخطَفُ النَّاسَ وعندَها حلَّتِ الشَّفاعةُ اللَّهمَّ سلِّمْ سلِّمْ اللَّهمَّ سلِّمْ سلِّمْ اللَّهمَّ سلِّمْ سلِّمْ فإذا جاوَز الجِسرَ فكلُّ مَن أنفَق زوجًا مِن المالِ ممَّا يملِكُ في سبيلِ اللهِ فكلُّ خَزَنةِ الجنَّةِ تدعوه : يا عبدَ اللهِ يا مُسلِمُ هذا خيرٌ فتَعالَ يا عبدَ اللهِ يا مُسلِمُ هذا خيرٌ فتَعالَ يا عبدَ اللهِ يا مُسلِمُ هذا خيرٌ فتَعالَ ) فقال أبو بكرٍ وهو إلى جَنْبِ النَّبيِّ صلَّى اللهُ عليه وسلَّم : ذاكَ عبدٌ لا توَى عليه يدَعُ بابًا ويلِجُ مِن آخَرَ فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم ومسَح مَنْكِبَيْهِ : ( إنِّي لَأرجو أنْ تكونَ منهم )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (7445) بلفظه، ومسلم (2968) بنحوه مطولا، وأبو داود (4730) مختصرا.","bab":"إيمان › النفاق","dorar":"7VzIqY2F","merged":3,"otherRefs":["تخريج صحيح ابن حبان 4642 (صحيح)","صحيح الجامع 7997 (صحيح)"]},{"id":"ق-0026","fp":"ba117486125b","stateId":733,"easy":"شراء الحياة الدنيا بالآخرة ← لا يخفف العذاب ولا نصرة","cause":"شراء الحياة الدنيا بالآخرة","result":"لا يخفف العذاب ولا نصرة","explicit":true,"ref":"سورة البقرة: 86","srcLabel":"القرآن الكريم","quran":{"s":2,"from":86,"to":86,"text":"أُولَئِكَ الَّذِينَ اشْتَرَوُا الْحَيَاةَ الدُّنْيَا بِالْآخِرَةِ فَلَا يُخَفَّفُ عَنْهُمُ الْعَذَابُ وَلَا هُمْ يُنْصَرُونَ (86)","hl":[[0,124,1]]}},{"id":"ق-0360","fp":"7a1983543199","stateId":733,"easy":"اتخاذ الدين لعباً ولهواً والاغترار بالدنيا ← الإبسال بما كسبوا وشراب من حميم وعذاب أليم","cause":"اتخاذ الدين لعباً ولهواً والاغترار بالدنيا","result":"الإبسال بما كسبوا وشراب من حميم وعذاب أليم","explicit":true,"ref":"سورة الأنعام: 70","srcLabel":"القرآن الكريم","quran":{"s":6,"from":70,"to":70,"text":"وَذَرِ الَّذِينَ اتَّخَذُوا دِينَهُمْ لَعِبًا وَلَهْوًا وَغَرَّتْهُمُ الْحَيَاةُ الدُّنْيَا وَذَكِّرْ بِهِ أَنْ تُبْسَلَ نَفْسٌ بِمَا كَسَبَتْ لَيْسَ لَهَا مِنْ دُونِ اللَّهِ وَلِيٌّ وَلَا شَفِيعٌ وَإِنْ تَعْدِلْ كُلَّ عَدْلٍ لَا يُؤْخَذْ مِنْهَا أُولَئِكَ الَّذِينَ أُبْسِلُوا بِمَا كَسَبُوا لَهُمْ شَرَابٌ مِنْ حَمِيمٍ وَعَذَابٌ أَلِيمٌ بِمَا كَانُوا يَكْفُرُونَ (70)","hl":[[0,364,1]]}},{"id":"ق-0444","fp":"0a68dc4afc48","stateId":733,"easy":"تعطيل القلب والسمع والبصر عن الحق (الغفلة) ← كالأنعام بل أضل وذُرئوا لجهنم","cause":"تعطيل القلب والسمع والبصر عن الحق (الغفلة)","result":"كالأنعام بل أضل وذُرئوا لجهنم","explicit":true,"otherNeedIds":[21],"ref":"سورة الأعراف: 179","srcLabel":"القرآن الكريم","quran":{"s":7,"from":179,"to":179,"text":"وَلَقَدْ ذَرَأْنَا لِجَهَنَّمَ كَثِيرًا مِنَ الْجِنِّ وَالْإِنْسِ لَهُمْ قُلُوبٌ لَا يَفْقَهُونَ بِهَا وَلَهُمْ أَعْيُنٌ لَا يُبْصِرُونَ بِهَا وَلَهُمْ آذَانٌ لَا يَسْمَعُونَ بِهَا أُولَئِكَ كَالْأَنْعَامِ بَلْ هُمْ أَضَلُّ أُولَئِكَ هُمُ الْغَافِلُونَ (179)","hl":[[0,252,1]]}},{"id":"ق-0546","fp":"1a0f50dee80a","stateId":733,"easy":"عدم رجاء لقاء الله والرضا بالحياة الدنيا والاطمئنان بها والغفلة عن الآيات ← مأواهم النار","cause":"عدم رجاء لقاء الله والرضا بالحياة الدنيا والاطمئنان بها والغفلة عن الآيات","result":"مأواهم النار","explicit":true,"ref":"سورة يونس: 7–8","srcLabel":"القرآن الكريم","quran":{"s":10,"from":7,"to":8,"text":"إِنَّ الَّذِينَ لَا يَرْجُونَ لِقَاءَنَا وَرَضُوا بِالْحَيَاةِ الدُّنْيَا وَاطْمَأَنُّوا بِهَا وَالَّذِينَ هُمْ عَنْ آيَاتِنَا غَافِلُونَ (7) أُولَئِكَ مَأْوَاهُمُ النَّارُ بِمَا كَانُوا يَكْسِبُونَ (8)","hl":[[0,198,1]]}},{"id":"ق-0701","fp":"b36b6a4468a0","stateId":733,"easy":"إرادة العاجلة وحدها ← يُعجَّل له ما شاء الله ثم جهنم مذموماً مدحوراً","cause":"إرادة العاجلة وحدها","result":"يُعجَّل له ما شاء الله ثم جهنم مذموماً مدحوراً","explicit":true,"ref":"سورة الإسراء: 18","srcLabel":"القرآن الكريم","quran":{"s":17,"from":18,"to":18,"text":"مَنْ كَانَ يُرِيدُ الْعَاجِلَةَ عَجَّلْنَا لَهُ فِيهَا مَا نَشَاءُ لِمَنْ نُرِيدُ ثُمَّ جَعَلْنَا لَهُ جَهَنَّمَ يَصْلَاهَا مَذْمُومًا مَدْحُورًا (18)","hl":[[0,145,1]]}},{"id":"ق-0715","fp":"0bd30a6b2893","stateId":733,"easy":"العمى عن الحق في الدنيا ← العمى في الآخرة وضلال السبيل","cause":"العمى عن الحق في الدنيا","result":"العمى في الآخرة وضلال السبيل","explicit":true,"otherNeedIds":[21],"ref":"سورة الإسراء: 72","srcLabel":"القرآن الكريم","quran":{"s":17,"from":72,"to":72,"text":"وَمَنْ كَانَ فِي هَذِهِ أَعْمَى فَهُوَ فِي الْآخِرَةِ أَعْمَى وَأَضَلُّ سَبِيلًا (72)","hl":[[0,80,1]]}},{"id":"ق-0773","fp":"cdc5b6fd2e2b","stateId":733,"easy":"الإعراض عن القرآن ← حمل الوزر يوم القيامة خالدين فيه","cause":"الإعراض عن القرآن","result":"حمل الوزر يوم القيامة خالدين فيه","explicit":true,"otherNeedIds":[13],"ref":"سورة طه: 100–101","srcLabel":"القرآن الكريم","quran":{"s":20,"from":100,"to":101,"text":"مَنْ أَعْرَضَ عَنْهُ فَإِنَّهُ يَحْمِلُ يَوْمَ الْقِيَامَةِ وِزْرًا (100) خَالِدِينَ فِيهِ وَسَاءَ لَهُمْ يَوْمَ الْقِيَامَةِ حِمْلًا (101)","hl":[[0,133,1]]}},{"id":"ق-0977","fp":"4b129cdabaeb","stateId":733,"easy":"نسيان لقاء الله ← نسيان الله لهم وعذاب الخلد","cause":"نسيان لقاء الله","result":"نسيان الله لهم وعذاب الخلد","explicit":true,"ref":"سورة السجدة: 14","srcLabel":"القرآن الكريم","quran":{"s":32,"from":14,"to":14,"text":"فَذُوقُوا بِمَا نَسِيتُمْ لِقَاءَ يَوْمِكُمْ هَذَا إِنَّا نَسِينَاكُمْ وَذُوقُوا عَذَابَ الْخُلْدِ بِمَا كُنْتُمْ تَعْمَلُونَ (14)","hl":[[0,125,1]]}},{"id":"ق-1190","fp":"ce4f19534f7f","stateId":733,"easy":"اتخاذ آيات الله هزواً والاغترار بالدنيا ونسيان لقاء الله ← نسيان الله لهم والنار ولا ناصرين","cause":"اتخاذ آيات الله هزواً والاغترار بالدنيا ونسيان لقاء الله","result":"نسيان الله لهم والنار ولا ناصرين","explicit":true,"ref":"سورة الجاثية: 33–35","srcLabel":"القرآن الكريم","quran":{"s":45,"from":33,"to":35,"text":"وَبَدَا لَهُمْ سَيِّئَاتُ مَا عَمِلُوا وَحَاقَ بِهِمْ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ (33) وَقِيلَ الْيَوْمَ نَنْسَاكُمْ كَمَا نَسِيتُمْ لِقَاءَ يَوْمِكُمْ هَذَا وَمَأْوَاكُمُ النَّارُ وَمَا لَكُمْ مِنْ نَاصِرِينَ (34) ذَلِكُمْ بِأَنَّكُمُ اتَّخَذْتُمْ آيَاتِ اللَّهِ هُزُوًا وَغَرَّتْكُمُ الْحَيَاةُ الدُّنْيَا فَالْيَوْمَ لَا يُخْرَجُونَ مِنْهَا وَلَا هُمْ يُسْتَعْتَبُونَ (35)","hl":[[0,375,1]]}},{"id":"ق-1387","fp":"4d022c588e6f","stateId":733,"easy":"الإعراض عن ذكر الله ← عذاب صَعَد","cause":"الإعراض عن ذكر الله","result":"عذاب صَعَد","explicit":true,"otherNeedIds":[10],"ref":"سورة الجن: 17","srcLabel":"القرآن الكريم","quran":{"s":72,"from":17,"to":17,"text":"لِنَفْتِنَهُمْ فِيهِ وَمَنْ يُعْرِضْ عَنْ ذِكْرِ رَبِّهِ يَسْلُكْهُ عَذَابًا صَعَدًا (17)","hl":[[21,84,1]]}},{"id":"ق-1397","fp":"07995884e98d","stateId":733,"easy":"حبّ العاجلة وترك الآخرة ← وجوه باسرة تظن أن يُفعل بها فاقرة","cause":"حبّ العاجلة وترك الآخرة","result":"وجوه باسرة تظن أن يُفعل بها فاقرة","explicit":true,"ref":"سورة القيامة: 20–21","srcLabel":"القرآن الكريم","quran":{"s":75,"from":20,"to":21,"text":"كَلَّا بَلْ تُحِبُّونَ الْعَاجِلَةَ (20) وَتَذَرُونَ الْآخِرَةَ (21)","hl":[[0,63,1]]}},{"id":"س-01784","fp":"93a3634d4d59","stateId":733,"easy":"إذا نسيت لقاء الله ← ينساك الله يوم القيامة","cause":"فظننتَ أنكَ مُلاقِيَّ ؟ فيقولُ: لا","result":"إني أنساكَ كما نَسيتَني","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-02792","ref":"إتحاف الخيرة المهرة 8/171","text":["يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّم  هل نَرى ربَّنا يومَ القيامةِ ؟ فقال: هل تُضارُّونَ في رؤيةِ الشمسِ في الظهيرةِ ليسَتْ في سحابةٍ ؟ قالوا: لا  قال: فهل تُضارُّونَ في رؤيةِ القمرِ ليلةَ البدرِ ليس في سحابةٍ ؟ قالوا: لا , قال  فوالذي نفسي بيدِه لا تُضارُّونَ في رؤيةِ ربِّكم إلا كما تُضارُّونَ في رؤيةِ أحدِهما  فيَلقى العبدُ ربَّه فيقولُ: أيْ فُل ألم أُكرِمْكَ  وأُسَوِّدْكَ  وأُزَوِّجْكَ  وأُسَخِّرْ لكَ الخيلَ والإبلَ وأذرَكَ ترأَسُ وتَربَعُ  قال: فيقولُ: بَلى يا ربِّ  قال: فيقولُ: ",["فظننتَ أنكَ مُلاقِيَّ ؟ فيقولُ: لا",1]," فيقولُ: ",["إني أنساكَ كما نَسيتَني",2]," ثم يَلقى الثانيَ فيقولُ  أيْ فُل ألم أُكرِمْكَ  وأُسَوِّدْكَ  وأُزَوِّجْكَ  وأُسَخِّرْ لكَ الخيلَ والإبلَ وأذرَكَ تَرأَسُ وتَربَعُ  قال: فيقولُ: بَلى يا ربِّ  قال: فيقولُ: فظننتَ أنكَ مُلاقِيَّ ؟ فيقولُ: لا , فيقولُ: فإني أنساكَ كما نَسيتَني  ثم يَلقى الثالثَ فيقول: أيْ فُل ألم أُكرِمْكَ  وأُسَوِّدْكَ  وأُزَوِّجْكَ  وأُسَخِّرْ لكَ الخيلَ والإبلَ وأذرَكَ تَرأَسُ وتَربَعُ ؟ فيقولُ: بَلى يا ربِّ فيقولُ: ظننتَ أنكَ مُلاقِيَّ ؟ فيقولُ: آمنتُ بكَ وبكتابِكَ وبرُسُلِكَ  وصلَّيتُ  وصُمتُ  وتصدَّقتُ  ويُثني بخيرٍ ما استَطاع قال: فيقولُ: فها هُنا إذًا  قال: ثم قال: ألا نبعثُ شاهدَنا عليكَ , فيفكرُ في نفسِه مَن ذا الذي يشهدُ عليَّ , فيختمُ على فيه ويقالُ لفخِذِه: انطِقي فينطقُ فخِذُه ولحمُه وعظامُه بعملِه ما كان  وذلك ليعذرَ مِن نفسِه وذلك المنافقُ  وذلك الذي يسخطُ اللهُ عليه ثم يُنادي منادٍ: ألا لتتبعْ كلُّ أمةٍ ما كانتْ تعبدُ مِن دونِ اللهِ فتتبعُ الشياطينَ والصلبَ أولياؤهم إلى جهنَّمَ قال: وبَقينا أيُّها المؤمنونَ فيأتينا ربُّنا  عزَّ وجلَّ  وهو ربُّنا وهو يُثيبُنا  فيقولَنَّ: علامَ هؤلاءِ ؟ فيقولونَ: نحن عبادُ اللهِ المؤمنينَ آمَنَّا باللهِ لا نُشرِكُ به شيئًا  وهذا مقامُنا حتى يأتيَنا ربُّنا  عزَّ وجلَّ  وهو ربُّنا وهو مُثبِتُنا  قال: ثم ينطلقُ حتى يأتيَ الجسرَ وعليه كلاليبُ مِن نارٍ تخطفُ الناسَ  فعندَ ذلك حلَّتِ الشفاعةُ ودعوى الرسلِ يومئذٍ: اللهم سلِّمْ  أي اللهم سلِّمْ  فإذا جاوَزوا الجسرَ فكلُّ مَن أنفَق زوجًا مما ملَكَتْ يمينُه منَ المالِ في سبيلِ اللهِ فكلُّ خزنةِ الجنةِ يدعونَه: يا عبدَ اللهِ  يا مسلمُ  هذا خيرٌ فتعالَ  قال: فقال أبو بكرٍ: يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّم  إنَّ هذا العبدَ لا تَوى عليه يدعُ بابًا ويلِجُ بابًا قال: فضرَبه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بيدِه ثم قال: والذي نفسُ محمدٍ بيدِه إني لأرجو أن تكونَ منهم"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سنده صحيح","takhrij":"أخرجه الحميدي (1178) واللفظ له، وأخرجه البخاري (6573) بنحوه، ومسلم (2968) باختلاف يسير","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"NJUioHng","merged":2,"otherRefs":["فتح الباري لابن حجر 11/456 (صحيح)"]},{"id":"ق-1429","fp":"5c4759fbff39","stateId":733,"easy":"تجنّب الذكرى (الشقاء) ← النار الكبرى لا يموت فيها ولا يحيى","cause":"تجنّب الذكرى (الشقاء)","result":"النار الكبرى لا يموت فيها ولا يحيى","explicit":true,"ref":"سورة الأعلى: 11–13","srcLabel":"القرآن الكريم","quran":{"s":87,"from":11,"to":13,"text":"وَيَتَجَنَّبُهَا الْأَشْقَى (11) الَّذِي يَصْلَى النَّارَ الْكُبْرَى (12) ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَى (13)","hl":[[0,112,1]]}},{"id":"ق-1424","fp":"3ae9be28f17c","stateId":733,"easy":"الغفلة واللهو والظن أن لا رجوع ← الكتاب وراء الظهر والثبور وصَلي السعير","cause":"الغفلة واللهو والظن أن لا رجوع","result":"الكتاب وراء الظهر والثبور وصَلي السعير","explicit":true,"ref":"سورة الانشقاق: 10–15","srcLabel":"القرآن الكريم","quran":{"s":84,"from":10,"to":15,"text":"وَأَمَّا مَنْ أُوتِيَ كِتَابَهُ وَرَاءَ ظَهْرِهِ (10) فَسَوْفَ يَدْعُو ثُبُورًا (11) وَيَصْلَى سَعِيرًا (12) إِنَّهُ كَانَ فِي أَهْلِهِ مَسْرُورًا (13) إِنَّهُ ظَنَّ أَنْ لَنْ يَحُورَ (14) بَلَى إِنَّ رَبَّهُ كَانَ بِهِ بَصِيرًا (15)","hl":[[0,228,1]]}},{"id":"س-01414","fp":"3b8b8d2938ba","stateId":734,"easy":"إذا لم تسبغ الوضوء ← فويل للأعقاب من النار","cause":"أسبِغوا الوُضوءَ","result":"وَيْلٌ لِلأَعْقابِ مِن النَّارِ","explicit":true,"star":true,"similar":["س-07207","س-01378"],"ref":"تخريج المسند لشعيب 9304","srcLabel":"متفق عليه","text":["كان أبو هُرَيرةَ يأتي على النَّاسِ وهم يتوضَّؤون في المَطْهَرةِ، فيَقولُ لهم: ",["أسبِغوا الوُضوءَ",1],"، أسبِغوا الوُضوءَ؛ فإنِّي سمِعتُ أبا القاسِمِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["وَيْلٌ لِلأَعْقابِ مِن النَّارِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (165)، ومسلم (242)، والترمذي (41)، والنسائي (110)، وابن ماجه (453)، وأحمد (9304) واللفظ له","bab":"وضوء › صفة الوضوء","dorar":"lkVRhEbq","merged":3,"otherRefs":["صحيح البخاري 165 (صحيح)","صحيح مسلم 242 (صحيح)"]},{"id":"س-06642","fp":"bf43eb260dc1","stateId":734,"easy":"إذا انتقصت من الصلوات استخفافاً ← لم يكن لك عند الله عهد","cause":"ومَن جاءَ بِهنَّ قد انْتَقَصَ مِنه شَيئًا اسْتِخْفافًا بحَقِّهنَّ","result":"لم يكنْ له عِنْدَ اللهِ عَهْدٌ؛ إن شاءَ عَذَّبَه، وإن شاءَ غَفَرَ له","explicit":true,"star":true,"ref":"الأحاديث المختارة 8 / 366","srcLabel":"متفق عليه","text":["«سألَ رَجُلٌ أبا مُحمَّدٍ -رَجُلًا مِن الأنْصارِ- عن الوِتْرِ، فقالَ: الوِتْرُ واجِبٌ كوُجوبِ الصَّلاةِ فأتى عُبادةَ فذَكَرَ ذلك له، فقالَ: كَذَبَ أبو مُحمَّدٍ، سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: (خَمْسُ صَلَواتٍ افْتَرَضَهنَّ اللهُ على عِبادِه، فمَن جاءَ بِهنَّ لم يَنْتَقِصْ مِنه شَيئًا اسْتِخْفافًا بحَقِّها فإنَّ اللهَ جاعِلٌ لهم يَوْمَ القِيامةِ عَهْدًا أن يُدخِلَه الجنَّةَ، ",["ومَن جاءَ بِهنَّ قد انْتَقَصَ مِنه شَيئًا اسْتِخْفافًا بحَقِّهنَّ",1]," ",["لم يكنْ له عِنْدَ اللهِ عَهْدٌ؛ إن شاءَ عَذَّبَه، وإن شاءَ غَفَرَ له",2],"»)."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"8iPRmKyK","merged":3,"otherRefs":["صحيح ابن حبان 1732 (صحيح)","تخريج صحيح ابن حبان 1731 (صحيح)"]},{"id":"س-07207","fp":"5de2dddd849a","stateId":734,"easy":"إذا لم تغسل عراقيبك في الوضوء ← فويل للعراقيب من النار","cause":"للعراقيبِ","result":"ويلٌ للعراقيبِ منَ النَّارِ","explicit":true,"repOf":"س-01414","ref":"تخريج المسند لشاكر 11/100","text":["سألتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ عن صلاةِ الرَّجلِ قاعدًا فقالَ : علَى النِّصفِ من صلاتِهِ قائمًا قالَ : وأبصرَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قومًا يتوضَّؤونَ لم يُتمُّوا الوضوءَ فقالَ : أسبِغوا يَعني الوضوءَ ",["ويلٌ للعراقيبِ منَ النَّارِ",2]," أو الأعقابِ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (735)، وأبو داود (950)، والنسائي (1659) واللفظ لهم، وأخرج عجزه أبو عوانة (688) واللفظ له.","bab":"علم › حسن السؤال ونصح العالم","dorar":"FfJu2Mbr","merged":3,"otherRefs":["صحيح ابن حبان 1059 (صحيح)","صحيح مسلم 242 (صحيح)"]},{"id":"س-07446","fp":"3ffa54d64f2f","stateId":734,"easy":"إذا أضعت الصلاة واتبعت الشهوات ← فسوف تلقى غياً","cause":"أضاعوا الصَّلاةَ، واتَّبعوا الشَّهواتِ","result":"فسوف يلقَوْنَ غيًّا","explicit":true,"star":true,"otherNeedIds":[52],"ref":"المستدرك على الصحيحين 3460","srcLabel":"البخاري","text":["سَمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، وتلا هذه الآيةَ: {فَخَلَفَ مِن بَعْدِهِمْ خَلْفٌ} [مريم: 59]، فقالَ صلَّى اللهُ عليه وسلَّمَ: «يكونُ خلْفٌ مِن بعدِ ستِّينَ سنةً ",["أضاعوا الصَّلاةَ، واتَّبعوا الشَّهواتِ",1]," ",["فسوف يلقَوْنَ غيًّا",2],"، ثُمَّ يكون خلْفٌ يَقرؤونَ القرآنَ، لا يعدو تَراقِيهُم، ويَقرأُ القرآنَ ثلاثةٌ: مؤمنٌ، ومنافقٌ، وفاجرٌ». قالَ بشيرٌ: فقلتُ للوليدِ: ما هؤلاء الثَّلاثةُ؟ فقالَ: المنافقُ كافرٌ، والفاجرُ يتَأَكَّلُ به، والمؤمنُ يُؤمنُ به."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (11340)، والبخاري في ((خلق أفعال العباد)) (117)، وابن حبان (755)، والطبراني في ((المعجم الأوسط)) (9330) جميعا بلفظه دون تلاوة الآية في أوله.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"3rGLN93d"},{"id":"س-01378","fp":"9ca0c16c42af","stateId":734,"easy":"إذا لم تغسل عقبيك في الوضوء ← فويل للأعقاب من النار","cause":"للأَعقابِ","result":"ويلٌ للأَعقابِ منَ النَّارِ","explicit":true,"repOf":"س-01414","ref":"صحيح ابن خزيمة 1/ 675","text":["صلَّى رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ بأصحابِهِ، ثمَّ جلسَ في طائفةٍ منهم، فدخلَ رجلٌ، فقامَ يصلِّي، فجعلَ يركعُ وينقرُ في سجودِهِ، فقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ: أترَونَ هذا، من ماتَ على هذا ماتَ على غيرِ ملَّةِ محمَّدٍ، ينقُرُ صلاتَهُ كما ينقُرُ الغرابُ الدَّمَ، إنَّما مَثلُ الَّذي يركعُ وينقرُ في سجودِهِ كالجائعِ لا يأكلُ إلَّا التَّمرةَ والتَّمرتينِ، فماذا تُغْنيانِ عنهُ، فأسبِغوا الوضوءَ، ",["ويلٌ للأَعقابِ منَ النَّارِ",2],"، أتمُّوا الرُّكوعَ والسُّجودَ. قالَ أبو صالِحٍ: فقلتُ لأبي عبدِ اللَّهِ الأشعريِّ: من حدَّثَكَ بِهَذا الحديثِ؟ فقالَ: أُمَراءُ الأجنادِ: عَمرُو بنُ العاصِ، وخالدُ بنُ الوليدِ، ويزيدُ بنُ أبي سُفيانَ، وشُرَحْبيلُ بنُ حَسنةَ، كلُّ هؤلاءِ سمعوهُ منَ النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ"],"grade":"صحيح","narrator":"عمرو بن العاص، وخالد بن الوليد، ويزيد بن أبي سفيان، وشرحبيل بن حسنة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن أبي عاصم في ((الآحاد والمثاني)) (494)، وأبو يعلى (7184)، والطبراني (4/ 115) (3840) واللفظ لهم.","bab":"وضوء › إسباغ الوضوء","dorar":"EdEJ7nD8","merged":29,"otherRefs":["تخريج المسند لشعيب 14392 (صحيح)","تخريج المسند لشعيب 25589 (صحيح)","الأوسط لابن المنذر 2/52 (صحيح)","تخريج المسند لشعيب 7816 (صحيح)","تخريج المسند لشعيب 9265 (صحيح)","تخريج المسند لشعيب 15195 (صحيح)","تخريج المسند لشعيب 6911 (صحيح)","صحيح النسائي 142 (صحيح)","مجموع الفتاوى 21/128 (صحيح)","صحيح مسلم 241 (صحيح)","عمدة القاري 2/361 (صحيح)","كشف اللثام 1/54 (صحيح)","تخريج المسند لشعيب 24813 (صحيح)","الأوسط لابن المنذر 2/51 (صحيح)","نخب الافكار 1/343 (صحيح)","تخريج المسند لشعيب 9304 (صحيح)","تخريج المسند لشعيب 9554 (صحيح)","تاريخ بغداد 6/4 (صحيح)","صحيح ابن ماجه 369 (صحيح)","صحيح الجامع 124 (صحيح)","صحيح الجامع 7132 (صحيح)","فتح البيان 3/ 364 (صحيح)","تخريج المسند لشعيب 17706 (صحيح)","الجامع الصغير 9625 (صحيح)","نخب الافكار 1/339 (حسن)","… و3 غيرها"]},{"id":"ق-0748","fp":"be2ae5a69410","stateId":734,"easy":"إضاعة الصلاة واتباع الشهوات ← لقاء الغيّ","cause":"إضاعة الصلاة واتباع الشهوات","result":"لقاء الغيّ","explicit":true,"star":true,"otherNeedIds":[21],"ref":"سورة مريم: 59","srcLabel":"القرآن الكريم","quran":{"s":19,"from":59,"to":59,"text":"فَخَلَفَ مِنْ بَعْدِهِمْ خَلْفٌ أَضَاعُوا الصَّلَاةَ وَاتَّبَعُوا الشَّهَوَاتِ فَسَوْفَ يَلْقَوْنَ غَيًّا (59)","hl":[[0,105,1]]}},{"id":"ق-1395","fp":"c52cb774af9d","stateId":734,"easy":"ترك الصلاة وترك إطعام المسكين والخوض مع الخائضين والتكذيب بيوم الدين ← سقر","cause":"ترك الصلاة وترك إطعام المسكين والخوض مع الخائضين والتكذيب بيوم الدين","result":"سقر","explicit":true,"star":true,"ref":"سورة المدثر: 38–47","srcLabel":"القرآن الكريم","quran":{"s":74,"from":38,"to":47,"text":"كُلُّ نَفْسٍ بِمَا كَسَبَتْ رَهِينَةٌ (38) إِلَّا أَصْحَابَ الْيَمِينِ (39) فِي جَنَّاتٍ يَتَسَاءَلُونَ (40) عَنِ الْمُجْرِمِينَ (41) مَا سَلَكَكُمْ فِي سَقَرَ (42) قَالُوا لَمْ نَكُ مِنَ الْمُصَلِّينَ (43) وَلَمْ نَكُ نُطْعِمُ الْمِسْكِينَ (44) وَكُنَّا نَخُوضُ مَعَ الْخَائِضِينَ (45) وَكُنَّا نُكَذِّبُ بِيَوْمِ الدِّينِ (46) حَتَّى أَتَانَا الْيَقِينُ (47)","hl":[[0,355,1]]}},{"id":"ق-1399","fp":"2b7cb37cf747","stateId":734,"easy":"ترك التصديق والصلاة والتكذيب والتولي والخيلاء ← الوعيد: أولى لك فأولى","cause":"ترك التصديق والصلاة والتكذيب والتولي والخيلاء","result":"الوعيد: أولى لك فأولى","explicit":true,"ref":"سورة القيامة: 31–35","srcLabel":"القرآن الكريم","quran":{"s":75,"from":31,"to":35,"text":"فَلَا صَدَّقَ وَلَا صَلَّى (31) وَلَكِنْ كَذَّبَ وَتَوَلَّى (32) ثُمَّ ذَهَبَ إِلَى أَهْلِهِ يَتَمَطَّى (33) أَوْلَى لَكَ فَأَوْلَى (34) ثُمَّ أَوْلَى لَكَ فَأَوْلَى (35)","hl":[[0,131,1]]}},{"id":"ق-1408","fp":"4887b10e1033","stateId":734,"easy":"ترك الركوع (الصلاة) ← ويل يومئذ","cause":"ترك الركوع (الصلاة)","result":"ويل يومئذ","explicit":true,"ref":"سورة المرسلات: 48–49","srcLabel":"القرآن الكريم","quran":{"s":77,"from":48,"to":49,"text":"وَإِذَا قِيلَ لَهُمُ ارْكَعُوا لَا يَرْكَعُونَ (48) وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ (49)","hl":[[0,86,1]]}},{"id":"ق-1448","fp":"26675e95602e","stateId":734,"easy":"النهي عن الصلاة والتكذيب والتولي ← السفع بالناصية","cause":"النهي عن الصلاة والتكذيب والتولي","result":"السفع بالناصية","explicit":true,"otherNeedIds":[61],"ref":"سورة العلق: 9–16","srcLabel":"القرآن الكريم","quran":{"s":96,"from":9,"to":16,"text":"أَرَأَيْتَ الَّذِي يَنْهَى (9) عَبْدًا إِذَا صَلَّى (10) أَرَأَيْتَ إِنْ كَانَ عَلَى الْهُدَى (11) أَوْ أَمَرَ بِالتَّقْوَى (12) أَرَأَيْتَ إِنْ كَذَّبَ وَتَوَلَّى (13) أَلَمْ يَعْلَمْ بِأَنَّ اللَّهَ يَرَى (14) كَلَّا لَئِنْ لَمْ يَنْتَهِ لَنَسْفَعًا بِالنَّاصِيَةِ (15) نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍ (16)","hl":[[0,301,1]]}},{"id":"ق-1462","fp":"078eb0f0b6e2","stateId":734,"easy":"السهو عن الصلاة والمراءاة ومنع الماعون ← الويل","cause":"السهو عن الصلاة والمراءاة ومنع الماعون","result":"الويل","explicit":true,"ref":"سورة الماعون: 4–7","srcLabel":"القرآن الكريم","quran":{"s":107,"from":4,"to":7,"text":"فَوَيْلٌ لِلْمُصَلِّينَ (4) الَّذِينَ هُمْ عَنْ صَلَاتِهِمْ سَاهُونَ (5) الَّذِينَ هُمْ يُرَاءُونَ (6) وَيَمْنَعُونَ الْمَاعُونَ (7)","hl":[[0,128,1]]}},{"id":"س-02982","fp":"ca969aefa574","stateId":734,"easy":"إذا تركت موضع شعرة من جنابة لم تغسلها ← يُفعل بك كذا وكذا في النار","cause":"مَن تَرَكَ مَوضِعَ شَعَرةٍ مِن جَنابةٍ لم يَغسِلْها","result":"فُعِلَ بِهذا كَذا وكَذا في النَّارِ","explicit":true,"ref":"الأحكام الوسطى 1/ 200","srcLabel":"الأحكام الوسطى","text":["\"",["مَن تَرَكَ مَوضِعَ شَعَرةٍ مِن جَنابةٍ لم يَغسِلْها",1]," ",["فُعِلَ بِهذا كَذا وكَذا في النَّارِ",2],"\"، قالَ علِيٌّ: فمِن ثَمَّ عادَيْتُ رأسي ثَلاثًا، وكانَ يَجُزُّ شَعَرَه."],"grade":"صحيح","narrator":"علي","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","bab":"إيمان › الوعيد","dorar":"G49Lkleq","merged":2,"otherRefs":["تحفة المحتاج 1/205 (صحيح)"]},{"id":"س-06466","fp":"395b10c63380","stateId":734,"easy":"إذا لم تأتِ بالصلوات ← فليس لك عند الله عهد، إن شاء عذبك","cause":"ومَن لم يَأتِ بِهنَّ","result":"فليس له عنْدَ اللهِ عَهْدٌ، إن شاءَ عَذَّبَه، وإن شاءَ أَدخَلَه الجَنَّةَ","explicit":true,"similar":["س-06497"],"ref":"تخريج مشكل الآثار 3172","srcLabel":"أبو داود","text":["عَنِ ابْنِ مُحَيْرِيزٍ، ذكَرَ رَجلٌ من أصحابِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يُقالُ له: أبو مُحمَّدٍ الوِترَ، فقال: إنَّه واجبٌ، فذكَرْتُ ذلك لعُبادةَ بنِ الصامِتِ، فقال: كذَبَ أبو محمَّدٍ، سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: خَمسُ صَلَواتٍ........ ثم ذكر بقية الحديث على مثل ما في حديثي مالك والليث [أي حديث: أنَّ رَجُلًا مِن بَني كِنانةَ يُدْعى المُخْدَجيَّ، سَمِعَ رَجُلًا بالشَّامِ يُدْعى أبا مُحمَّدٍ، يقولُ: إنَّ الوِتْرَ واجِبٌ، قالَ المُخْدَجيُّ: فرُحْتُ إلى عُبادةَ بنِ الصَّامِتِ، فاعتَرَضْتُه وهو رائحٌ إلى المسجِدِ، ، فأَخبَرْتُه، فأخبَرْتُه بالذي قال أبو محمَّدٍ فقالَ عُبادةُ: كَذَبَ أبو مُحمَّدٍ، سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: خَمْسُ صَلَواتٍ كَتَبَهنَّ اللهُ على العِبادِ، فمَن جاءَ بهنَّ لم يُضيِّعْ مِنهنَّ شَيئًا اسْتِخْفافًا بحَقِّهنَّ كانَ له عنْدَ اللهِ عَهْدٌ أن يُدخِلَه الجَنَّةَ، ",["ومَن لم يَأتِ بِهنَّ",1]," ",["فليس له عنْدَ اللهِ عَهْدٌ، إن شاءَ عَذَّبَه، وإن شاءَ أَدخَلَه الجَنَّةَ",2],"]"],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (3172) واللفظ له، وأبو داود (1420)، والنسائي (461)، والبيهقي (2257) باختلاف يسير تاما.","bab":"صلاة › فرض الصلاة","dorar":"kQFSxhUM","merged":2,"otherRefs":["تخريج المسند لشعيب 22693 (صحيح)"]},{"id":"س-03030","fp":"3a28d8417062","stateId":734,"easy":"إذا لم تقم الصلاة لوقتها ولم تقم حدها ← لم يكن لك عند الله عهد، إن شاء عذبك","cause":"ومَن لم يُقِمِ الصَّلاةَ لِوَقتِها، ولم يُقِمْ حَدَّها","result":"لم يكُنْ له به عندي عَهدٌ؛ إن شِئتُ أدخَلْتُه النَّارَ، وإن شِئتُ أدخَلْتُه الجنَّةَ","explicit":true,"ref":"تخريج مشكل الآثار 3174","srcLabel":"أحمد","text":["خرَجَ إلينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ذاتَ يومٍ ونحن في المسجِدِ، ثُم ذكَرَ مِثلَه. [أي: حَديثَ: خرج علينا رَسولُ الله صلَّى اللهُ عليه وسلَّم ونحن في المسجِدِ سَبعةٌ؛ مِنَّا ثلاثةٌ مِن عَرَبِنا، وأربعةٌ مِن مَوالينا، فقال: ما يُجلِسُكم هنا؟ قلنا: الصَّلاةُ. قال: فنَكَتَ بأُصبُعِه في الأرضِ ثمَّ نَكَسَ ساعةً، ثمَّ رفَعَ إلينا رأسَه فقال: تدرونَ ما يقولُ رَبُّكم؟ قُلْنا: اللهُ ورسولُه أعلَمُ. قال: إنَّه يقولُ: مَن صلَّى الصَّلاةَ لِوَقتِها، وأقام حَدَّها؛ كان له به على اللهِ عَهدٌ إذا جاءه؛ الجنَّةُ، ",["ومَن لم يُقِمِ الصَّلاةَ لِوَقتِها، ولم يُقِمْ حَدَّها، ",1],["لم يكُنْ له به عندي عَهدٌ؛ إن شِئتُ أدخَلْتُه النَّارَ، وإن شِئتُ أدخَلْتُه الجنَّةَ",2],"]"],"grade":"صحيح","narrator":"كعب","muhaddith":"إسناده صحيح على شرط الشيخين.","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (3173) بلفظه، وأحمد (18132)، والدارمي (1262)، والطبراني (19/ 143) (314) جميعا بنحوه.","bab":"إيمان › الوعيد","dorar":"iugaM2VX"},{"id":"س-06433","fp":"fff341333662","stateId":734,"easy":"إذا تركت الصلاة سكراً أربع مرات ← كان حقاً على الله أن يسقيك من طينة الخبال","cause":"ومَن ترَك الصلاةَ سُكْرًا أربعَ مرَّاتٍ","result":"كان حقًّا على اللهِ عزَّ وجَلَّ أنْ يَسقِيَه مِن طِينَةِ الخَبالِ قيل وما طِينَةُ الخَبالِ يا رسولَ اللهِ","explicit":true,"ref":"تخريج المسند لشاكر 10/143","srcLabel":"أحمد","text":["مَن ترَك الصلاةَ سُكْرًا مرَّةً واحِدَةً فكأنَّما كانَتْ له الدُّنيا وما عليها فسَلَبَها ",["ومَن ترَك الصلاةَ سُكْرًا أربعَ مرَّاتٍ ",1],["كان حقًّا على اللهِ عزَّ وجَلَّ أنْ يَسقِيَه مِن طِينَةِ الخَبالِ قيل وما طِينَةُ الخَبالِ يا رسولَ اللهِ",2]," قال عُصارَةُ أهلِ جَهَنَّمَ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6659)، والحاكم (7233) واللفظ لهما، والطبراني في ((المعجم الأوسط)) (6371) باختلاف يسير.","bab":"صلاة › تارك الصلاة","dorar":"EATgevil"},{"id":"س-06497","fp":"e6162239eaf8","stateId":734,"easy":"إذا لم تأتِ بالصلوات ← لم يكن لك عند الله عهد","cause":"ومَن لم يأتِ بِهِنَّ","result":"لم يَكُن لهُ عندَ اللَّهِ عهدًا إن شاءَ عذَّبَهُ وإن شاءَ رحِمَهُ","explicit":true,"repOf":"س-06466","ref":"تخريج كتاب السنة 967","text":["خمسُ صلَواتٍ كتبَهُنَّ اللَّهُ علَى عبادِهِ مَن جاءَ بِهِنَّ يومَ القيامةِ لم يضيِّعْ منهنَّ شيئًا استِخفافًا بحقِّهم كانَ لهُ عندَ اللَّهِ عَهدًا أن يُدْخِلَهُ الجنَّةَ ",["ومَن لم يأتِ بِهِنَّ",1]," ",["لم يَكُن لهُ عندَ اللَّهِ عهدًا إن شاءَ عذَّبَهُ وإن شاءَ رحِمَهُ",2]],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1420)، والنسائي (461)، وابن ماجه (1401)، وأحمد (22745) باختلاف يسير، وابن أبي عاصم في ((السنة)) (967) واللفظ له","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"9BjooeTE"},{"id":"س-06547","fp":"8cf1a4ca6a27","stateId":734,"easy":"إذا لم تفعل (لم تحافظ على الصلاة) ← فليس لك على الله عهد، إن شاء غفر لك وإن شاء عذبك","cause":"ومَن لم يَفعَلْ","result":"فليس على اللهِ عَهْدٌ؛ إن شاءَ غَفَرَ له، وإن شاءَ عَذَّبَه","explicit":true,"ref":"الأحكام الوسطى 1/ 247","srcLabel":"الأحكام الوسطى","text":["عن عَبْدِ اللهِ الصُّنابحيِّ، قالَ: زَعَمَ أبو مُحمَّدٍ أنَّ الوِتْرَ واجِبٌ، فقالَ عُبادةُ بنُ الصَّامِتِ: كَذَبَ أبو مُحمَّدٍ، أَشهَدُ أنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: \"خَمْسُ صَلَواتٍ افْتَرَضَهنَّ اللهُ عَزَّ وجَلَّ، مَن أَحسَنَ وُضوءَهنَّ، وصَلَّاهنَّ لوَقْتِهنَّ، وأَتَمَّ رُكوعَهنَّ وخُشوعَهنَّ، كانَ على اللهِ عَهْدٌ أن يَغفِرَ له، ",["ومَن لم يَفعَلْ",1]," ",["فليس على اللهِ عَهْدٌ؛ إن شاءَ غَفَرَ له، وإن شاءَ عَذَّبَه",2],"\"."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"DVkj448X"},{"id":"س-06626","fp":"a1ef7c10cb47","stateId":734,"easy":"إذا لم تصلِّ الصلاة لوقتها وضيعتها استخفافاً ← فلا عهد لك، إن شاء عذبك","cause":"ومَن لم يُصلِّها لوَقتِها، ولم يُحافِظْ عليها، وضَيَّعَها استِخفافًا بحَقِّها","result":"فلا عَهدَ له، إنْ شِئتُ عَذَّبتُه، وإنْ شِئتُ غَفَرتُ له","explicit":true,"ref":"تخريج المسند لشعيب 18132","srcLabel":"أحمد","text":["بينما أنا جالسٌ في مسجدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، مُسنِدي ظُهورِنا إلى قِبلةِ مسجدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، سبعةُ رَهطٍ، أربعةٌ مِن مَوالينا، وثلاثةٌ مِن عَرَبِنا، إذ خَرَجَ إلينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ صَلاةَ الظُّهرِ، حتى انتَهى إلينا، فقال: ما يُجلِسُكم هاهنا؟ قُلْنا: يا رسولَ اللهِ، نَنتظِرُ الصَّلاةَ، قال: فأرَمَّ قليلًا، ثُمَّ رَفَعَ رأسَه، فقال: أتَدرون ما يقولُ ربُّكم عزَّ وجلَّ؟ قال: قُلْنا: اللهُ ورسولُه أعلمُ، قال: فإنَّ ربَّكم عزَّ وجلَّ يقولُ: مَن صَلَّى الصَّلاةَ لوَقتِها، وحافَظَ عليها، ولم يُضيِّعْها استِخفافًا بحَقِّها؛ فله عليَّ عَهدٌ أنْ أُدخِلَه الجنَّةَ، ",["ومَن لم يُصلِّها لوَقتِها، ولم يُحافِظْ عليها، وضَيَّعَها استِخفافًا بحَقِّها",1],"؛ ",["فلا عَهدَ له، إنْ شِئتُ عَذَّبتُه، وإنْ شِئتُ غَفَرتُ له",2],"."],"grade":"صحيح","narrator":"كعب بن عجرة","muhaddith":"مرفوعه صحيح لغيره","takhrij":"أخرجه أحمد (18132) واللفظ له، والدارمي (1226)، والطبراني (19/142) (311)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"bpNDRbFU"},{"id":"س-06621","fp":"640c71227fb9","stateId":734,"easy":"إذا صمت وقمت وتركت الجماعة والجمعة ← فأنت في النار (أثر ابن عباس)","cause":"يصومُ النَّهارَ ويقومُ اللَّيلَ ولا يشهَد الجماعَةَ ولا الجمُعةَ","result":"هذا في النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الترغيب والترهيب 1/211","srcLabel":"الترمذي","text":["عنِ ابنِ عبَّاسٍ رضيَ اللَّهُ عنهما قال أنه سُئِلَ عن رجلٍ ",["يصومُ النَّهارَ ويقومُ اللَّيلَ ولا يشهَد الجماعَةَ ولا الجمُعةَ",1]," فقالَ ",["هذا في النَّارِ",2]],"grade":"صحيح","narrator":"مجاهد بن جبر المكي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (218)، وعبد الرزاق (1989)، وابن المنذر في ((الأوسط)) (1906) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"ZdzB7dzk","merged":3,"otherRefs":["مجموع فتاوى ابن باز 252/10 (صحيح)","تخريج سنن الترمذي 1/424 (صحيح)"]},{"id":"س-04564","fp":"c1db890b232a","stateId":734,"easy":"إذا لم تبالِ أين يصيبك البول ← تؤذي أهل النار بجر أمعائك","cause":"كان لا يُبالِي أينَ أصاب البولُ منه لا يغسلُه","result":"ورجلٌ يجرُّ أمعاءَه","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"مجمع الزوائد 1/213","srcLabel":"الطبراني","text":["أربعةٌ يُؤذونَ أهلَ النارِ على ما بهم من الأذَى يسعونَ بينَ الحميمِ والجحيمِ يدعونَ بالويلِ والثبورِ يقولُ أهلُ النارِ بعضُهم لبعضٍ ما بالُ هؤلاءِ قد آذونا على ما بنا من الأذَى قال فرجلٌ مغلقٌ عليه تابوتٌ من جمرٍ ",["ورجلٌ يجرُّ أمعاءَه",2]," ورجلٌ يسيلُ فوه قيحًا ودمًا ورجلٌ يأكلُ لحمَه قال فيُقالُ لصاحبِ التابوتِ ما بالُ الأبعدِ قد آذانا على ما بنا من الأذَى قال فيقولُ إن الأبعدَ مات وفي عنقِه أموالُ الناسِ ما يجدُ لها قضاءً أو وفاءً ثم قال للذي يجرُّ أمعاءَه ما بالُ الأبعدِ قد آذانا على ما بنا من الأذَى فقال إن الأبعدَ ",["كان لا يُبالِي أينَ أصاب البولُ منه لا يغسلُه",1]," ثم قال للذي يسيلُ فوه قيحًا ودمًا ما بالُ الأبعدِ قد آذانا على ما بنا من الأذَى فيقولُ إن الأبعدَ كان يأكلُ لحمَ الناسِ"],"grade":"حسن","narrator":"شفي بن ماتع الأصبحي","muhaddith":"رجاله موثقون","takhrij":"أخرجه ابن المبارك في ((الزهد)) (2/94)، وابن أبي الدنيا في ((صفة النار)) (229)، والطبراني (7/311) (7226) باختلاف يسير.","bab":"جهنم › صفة عذاب أهل النار","dorar":"SXiXxY4A"},{"id":"س-05128","fp":"b2a3dad74c22","stateId":734,"easy":"إذا لم تحافظ على الصلاة ← لا تكون لك نوراً ولا برهاناً ولا نجاة، وتكون يوم القيامة مع فرعون وقارون","cause":"ومَن لم يُحافِظْ عليها","result":"لم تكُنْ له نورًا ولا بُرهانًا ولا نَجاةً، وكان يومَ القيامةِ مع فِرعونَ، وقارونَ، وهامانَ، وأُبَيٍّ صاحبِ العِظامِ","explicit":true,"otherNeedIds":[57],"ref":"تخريج مشكل الآثار 3180","srcLabel":"أحمد","text":["ذكَرَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ الصَّلاةَ يومًا، فقال: مَن حافَظَ عليها كانت له نورًا وبُرهانًا ونَجاةً يومَ القيامةِ، ",["ومَن لم يُحافِظْ عليها، ",1],["لم تكُنْ له نورًا ولا بُرهانًا ولا نَجاةً، وكان يومَ القيامةِ مع فِرعونَ، وقارونَ، وهامانَ، وأُبَيٍّ صاحبِ العِظامِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6576)، والدارمي (2721)، وابن حبان (1467) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"QKOyihCm","merged":2,"otherRefs":["مجموع فتاوى ابن باز 234/10 (حسن)"]},{"id":"س-06493","fp":"18f76118ac5e","stateId":734,"easy":"إذا لم تحافظ على الصلوات ← فلا عهد لك عند الله","cause":"ومَنْ لمْ يُحافِظْ عليهِنَّ","result":"فلا عَهْدَ لهُ عِندي","explicit":true,"ref":"السلسلة الصحيحة 4033","srcLabel":"أبو داود","text":["قال اللهُ عزَّ وجلَّ : افْتَرَضْتُ على أمتِكَ خمسَ صَلَوَاتٍ ، وعهدْتُ عِندي عَهْدًا : أنَّهُ مَنْ حافَظَ عليهِنَّ لِوَقْتِهنَّ ؛ أَدْخَلْتُهُ الجنةَ ، ",["ومَنْ لمْ يُحافِظْ عليهِنَّ",1]," ؛ ",["فلا عَهْدَ لهُ عِندي",2]," ."],"grade":"صحيح","narrator":"أبو قتادة الحارث بن ربعي","muhaddith":"ثابت","takhrij":"أخرجه أبو داود (430)، وابن ماجه (1403) واللفظ له","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"F3YeisD9"},{"id":"س-04815","fp":"f73a927ebbc2","stateId":735,"easy":"إذا سرّك أن يقوم لك بنو آدم ← وجبت لك النار","cause":"من سرَّهُ أن يقومَ له بنو آدمَ","result":"وجبتْ له النَّارُ","explicit":true,"ref":"السلسلة الصحيحة 1/695","srcLabel":"أبو داود","text":["خرج معاويةُ فرآهم قيامًا لخروجِه فقال لهم : اجلِسوا فإنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ قال : ",["من سرَّهُ أن يقومَ له بنو آدمَ ",1],["وجبتْ له النَّارُ",2]],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"إسناده صحيح","takhrij":"أخرجه المخلص في ((المخلصيات)) (2955) واللفظ له، وأخرجه أبو داود (5229)، والترمذي (2755) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"SX1tqgVz"},{"id":"س-03070","fp":"eb37af490b84","stateId":735,"easy":"إذا سرّك أن يقوم لك الناس قياماً ← فتبوأ بيتاً من النار","cause":"مَن سَرَّهُ أن يَمْثُلَ لهُ عِبادُ اللهِ قيامًا","result":"فليتبَوَّأْ بيتًا مِنَ النَّارِ","explicit":true,"star":true,"ref":"صحيح الأدب المفرد 748","srcLabel":"البخاري","text":["[عن] أبي مجلز يَقُولُ: ‌إِنَّ ‌مُعَاوِيَةَ ‌خَرَجَ، وَعَبْدُ اللَّهِ بْنُ عَامِرٍ وَعَبْدُ اللَّهِ بْنُ الزُّبَيْرِ قُعُودٌ، فَقَامَ ابْنُ عَامِرٍ، وَقَعَدَ ابْنُ الزُّبَيْرِ، وَكَانَ أَرْزَنَهُمَا، قَالَ مُعَاوِيَةُ: قَالَ النبي صلى الله عليه وسلم: ",["مَن سَرَّهُ أن يَمْثُلَ لهُ عِبادُ اللهِ قيامًا ",1],["فليتبَوَّأْ بيتًا مِنَ النَّارِ",2]],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5229)، والترمذي (2755)، وأحمد (16918) بنحوه، والبخاري في ((الأدب المفرد)) (977) واللفظ له","bab":"إيمان › الوعيد","dorar":"xkDLiGsS","merged":7,"otherRefs":["صحيح الترمذي 2755 (صحيح)","الأحكام الوسطى 4/ 225 (صحيح)","تخريج المسند لشعيب 16918 (صحيح)","تخريج المسند لشعيب 16830 (صحيح)","تخريج مشكل الآثار 1127 (صحيح)","تخريج المسند لشعيب 16845 (صحيح)"]},{"id":"س-03130","fp":"787a909e353d","stateId":735,"easy":"إذا نازعت الله رداءه (الكبرياء) ← يقصمك","cause":"فَمَنْ نازعَني رِدائي","result":"قَصَمْتُهُ","explicit":true,"star":true,"otherNeedIds":[44],"ref":"المستدرك على الصحيحين 204","srcLabel":"مسلم","text":["عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فيما يَحْكي عنْ رَبِّه عزَّ وجلَّ، قالَ: «الكِبْرياءُ رِدائي، ",["فَمَنْ نازعَني رِدائي",1]," ",["قَصَمْتُهُ",2],"»."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أبو داود (4090)، وابن ماجة (4174)، وأحمد (7382) بنحوه.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"cCOPJdjd","merged":8,"otherRefs":["صحيح الترغيب 2898 (صحيح)","صحيح الجامع 4310 (صحيح)","صحيح مسلم 2620 (صحيح)","صحيح الأدب المفرد 429 (صحيح)","صحيح الجامع 4309 (صحيح)","الأحاديث المختارة 10 / 273 (صحيح)","مدح التواضع وذم الكبر 9 (حسن)"]},{"id":"س-00953","fp":"71911ba78b22","stateId":735,"easy":"إذا نازعت الله في الكبرياء أو العظمة ← يقذفك في النار","cause":"فمَن نازَعني في واحدةٍ منهما","result":"قذَفْتُه في النَّارِ","explicit":true,"star":true,"similar":["س-03113"],"ref":"تخريج صحيح ابن حبان 328","srcLabel":"متفق عليه","text":["الكبرياءُ ردائي والعظمةُ إزاري ",["فمَن نازَعني في واحدةٍ منهما",1]," ",["قذَفْتُه في النَّارِ",2]," ومَن اقتَرَب إليَّ شبرًا اقترَبْتُ منه ذراعًا ومَن اقتَرَب منِّي ذراعًا اقترَبْتُ منه باعًا ومَن جاءني يمشي جِئْتُه أُهَروِلُ ومَن جاءني يُهروِلُ جِئْتُه أسعى ومَن ذكَرني في نفسِه ذكَرْتُه في نفسي ومَن ذكَرني في ملأٍ ذكَرْتُه في ملأٍ أكثَرَ منهم وأطيَبَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حديث صحيح إسناده قوي","takhrij":"أخرجه البخاري (7405) مختصراً بلفظ مقارب، ومسلم (2620، 2675) مفرقاً بنحوه من حديث أبي هريرة وأبي سعيد الخدري رضي الله عنهما","bab":"أدعية وأذكار › فضل الذكر","dorar":"VsMBRNQH","merged":4,"otherRefs":["تخريج المسند لشعيب 7382 (صحيح)","السلسلة الصحيحة 541 (حسن)","صحيح ابن حبان 5671 (صحيح)"]},{"id":"س-05693","fp":"a410494a0ade","stateId":735,"easy":"إذا تكبرت ← تُحشر يوم القيامة أمثال الذر في صور الرجال يغشاك الذل","cause":"المُتَكَبِّرُونَ","result":"يُحْشَرُ المُتَكَبِّرُونَ يومَ القيامةِ أَمْثَالَ الذَّرِّ في صُوَرِ الرِّجَالِ يَغْشَاهُمُ الذُّلُّ من كلِّ مَكَانٍ يُساقُونَ إلى سِجْنٍ في جهنمَ يُسَمَّى : بُولَسَ تَعْلوهُمْ نارُ الأنْيارِ ، يُسْقَوْنَ من عُصارَةِ أهلِ النارِ طِينَةَ الخَبالِ","explicit":true,"otherNeedIds":[44],"ref":"سنن الترمذي 2492","srcLabel":"البخاري","text":[["يُحْشَرُ المُتَكَبِّرُونَ يومَ القيامةِ أَمْثَالَ الذَّرِّ في صُوَرِ الرِّجَالِ يَغْشَاهُمُ الذُّلُّ من كلِّ مَكَانٍ يُساقُونَ إلى سِجْنٍ في جهنمَ يُسَمَّى : بُولَسَ تَعْلوهُمْ نارُ الأنْيارِ ، يُسْقَوْنَ من عُصارَةِ أهلِ النارِ طِينَةَ الخَبالِ",2]],"grade":"صحيح","narrator":"[جد عمرو بن شعيب]","muhaddith":"حسن صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (557) واللفظ له، وأحمد (6677) باختلاف يسير والبيهقي في ((شعب الإيمان)) (7834) بنحوه","bab":"رقائق وزهد › الكبر والتواضع","dorar":"cJW1bjNm","merged":4,"otherRefs":["عمدة التفسير 1/136 (صحيح)","فتح البيان 7/ 228 (صحيح)","تخريج الإحياء للعراقي 3/415 (حسن)"]},{"id":"س-04967","fp":"fb72869608c6","stateId":735,"easy":"إذا كنت جعظرياً جواظاً مستكبراً جمّاعاً ← فأنت من أهل النار","cause":"جَعْظرِيٍّ جوَّاظٍ مُستكبرٍ جَمَّاعٍ، وأهلُ الجنَّةِ الضُّعفاءُ المغلوبونَ","result":"أهلُ النَّارِ كُلُّ","explicit":true,"similar":["س-04790"],"ref":"المستدرك على الصحيحين 3890","srcLabel":"مسلم","text":["عنْ عبدِ اللهِ بنِ عمرِو بنِ العاصِ، أنَّه تلا هذه الآيةَ: {مَنَّاعٍ لِلْخَيْرِ مُعْتَدٍ أَثِيمٍ (12) عُتُلٍّ بَعْدَ ذَلِكَ زَنِيمٍ} [القلم: 12، 13] فقالَ: سَمِعتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ يقولُ: «",["أهلُ النَّارِ كُلُّ",2],[" جَعْظرِيٍّ جوَّاظٍ مُستكبرٍ جَمَّاعٍ، وأهلُ الجنَّةِ الضُّعفاءُ المغلوبونَ»",1],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أحمد (6850)، وابن أبي الدنيا في ((التواضع والخمول)) (220)، والحارث بن أبي أسامة كما في ((بغية الباحث)) للهيثمي (1098) جميعهم باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"NK64BvWx","merged":4,"otherRefs":["تخريج المسند لشعيب 12476 (صحيح)","تخريج المسند لشعيب 17585 (صحيح)","يقظة أولي الاعتبار 112 (صحيح)"]},{"id":"س-05720","fp":"facc44284258","stateId":735,"easy":"إذا كان في قلبك مثقال حبة خردل من كبر ← يكبك الله على وجهك في النار","cause":"مَن كان في قلبِه مِثقالُ حَبَّةٍ مِن خَردلٍ مِن كِبرٍ","result":"أكَبَّه اللهُ على وَجهِه في النَّارِ","explicit":true,"similar":["س-05746"],"ref":"تخريج المسند لشعيب 7015","srcLabel":"البخاري","text":["التَقى عبدُ اللهِ بنُ عُمَرَ وعبدُ اللهِ بنُ عَمرِو بنِ العاصي على المَروَةَ، فتَحدَّثا، ثُمَّ مَضى عبدُ اللهِ بنُ عَمرٍو، وبَقيَ عبدُ اللهِ بنُ عُمَرَ يَبكي، فقال له رَجُلٌ: ما يُبكيكَ يا أبا عبدِ الرَّحمنِ؟ قال: هذا -يعني عبدَ اللهِ بنَ عَمرٍو- زعَمَ أنَّه سمِعَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن كان في قلبِه مِثقالُ حَبَّةٍ مِن خَردلٍ مِن كِبرٍ؛ ",1],["أكَبَّه اللهُ على وَجهِه في النَّارِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه أحمد (7015) واللفظ له، وابن أبي شيبة (27113)","bab":"رقائق وزهد › الكبر والتواضع","dorar":"KEHHjUkX"},{"id":"ق-0281","fp":"607514f86b72","stateId":735,"easy":"الاستنكاف والاستكبار عن عبادة الله ← عذاب أليم ولا وليّ ولا نصير","cause":"الاستنكاف والاستكبار عن عبادة الله","result":"عذاب أليم ولا وليّ ولا نصير","explicit":true,"ref":"سورة النساء: 173","srcLabel":"القرآن الكريم","quran":{"s":4,"from":173,"to":173,"text":"فَأَمَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَيُوَفِّيهِمْ أُجُورَهُمْ وَيَزِيدُهُمْ مِنْ فَضْلِهِ وَأَمَّا الَّذِينَ اسْتَنْكَفُوا وَاسْتَكْبَرُوا فَيُعَذِّبُهُمْ عَذَابًا أَلِيمًا وَلَا يَجِدُونَ لَهُمْ مِنْ دُونِ اللَّهِ وَلِيًّا وَلَا نَصِيرًا (173)","hl":[[107,255,1]]}},{"id":"ق-0666","fp":"6f3188a57d7e","stateId":735,"easy":"ظلم النفس والتكبر ← الخزي يوم القيامة ودخول أبواب جهنم","cause":"ظلم النفس والتكبر","result":"الخزي يوم القيامة ودخول أبواب جهنم","explicit":true,"otherNeedIds":[64],"ref":"سورة النحل: 27–29","srcLabel":"القرآن الكريم","quran":{"s":16,"from":27,"to":29,"text":"ثُمَّ يَوْمَ الْقِيَامَةِ يُخْزِيهِمْ وَيَقُولُ أَيْنَ شُرَكَائِيَ الَّذِينَ كُنْتُمْ تُشَاقُّونَ فِيهِمْ قَالَ الَّذِينَ أُوتُوا الْعِلْمَ إِنَّ الْخِزْيَ الْيَوْمَ وَالسُّوءَ عَلَى الْكَافِرِينَ (27) الَّذِينَ تَتَوَفَّاهُمُ الْمَلَائِكَةُ ظَالِمِي أَنْفُسِهِمْ فَأَلْقَوُا السَّلَمَ مَا كُنَّا نَعْمَلُ مِنْ سُوءٍ بَلَى إِنَّ اللَّهَ عَلِيمٌ بِمَا كُنْتُمْ تَعْمَلُونَ (28) فَادْخُلُوا أَبْوَابَ جَهَنَّمَ خَالِدِينَ فِيهَا فَلَبِئْسَ مَثْوَى الْمُتَكَبِّرِينَ (29)","hl":[[0,463,1]]}},{"id":"ق-1041","fp":"f6a152a7a3ad","stateId":735,"easy":"الاستكبار عن «لا إله إلا الله» والإجرام ← ذوق العذاب الأليم","cause":"الاستكبار عن «لا إله إلا الله» والإجرام","result":"ذوق العذاب الأليم","explicit":true,"ref":"سورة الصافات: 34–38","srcLabel":"القرآن الكريم","quran":{"s":37,"from":34,"to":38,"text":"إِنَّا كَذَلِكَ نَفْعَلُ بِالْمُجْرِمِينَ (34) إِنَّهُمْ كَانُوا إِذَا قِيلَ لَهُمْ لَا إِلَهَ إِلَّا اللَّهُ يَسْتَكْبِرُونَ (35) وَيَقُولُونَ أَئِنَّا لَتَارِكُو آلِهَتِنَا لِشَاعِرٍ مَجْنُونٍ (36) بَلْ جَاءَ بِالْحَقِّ وَصَدَّقَ الْمُرْسَلِينَ (37) إِنَّكُمْ لَذَائِقُو الْعَذَابِ الْأَلِيمِ (38)","hl":[[0,294,1]]}},{"id":"ق-1096","fp":"0c31388f45ae","stateId":735,"easy":"الكذب على الله والتكبر ← اسوداد الوجوه وجهنم","cause":"الكذب على الله والتكبر","result":"اسوداد الوجوه وجهنم","explicit":true,"ref":"سورة الزمر: 60","srcLabel":"القرآن الكريم","quran":{"s":39,"from":60,"to":60,"text":"وَيَوْمَ الْقِيَامَةِ تَرَى الَّذِينَ كَذَبُوا عَلَى اللَّهِ وُجُوهُهُمْ مُسْوَدَّةٌ أَلَيْسَ فِي جَهَنَّمَ مَثْوًى لِلْمُتَكَبِّرِينَ (60)","hl":[[0,134,1]]}},{"id":"ق-1121","fp":"2acda5c7e757","stateId":735,"easy":"الاستكبار عن عبادة الله ودعائه ← دخول جهنم داخرين","cause":"الاستكبار عن عبادة الله ودعائه","result":"دخول جهنم داخرين","explicit":true,"otherNeedIds":[30],"ref":"سورة غافر: 60","srcLabel":"القرآن الكريم","quran":{"s":40,"from":60,"to":60,"text":"وَقَالَ رَبُّكُمُ ادْعُونِي أَسْتَجِبْ لَكُمْ إِنَّ الَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِي سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ (60)","hl":[[46,128,1]]}},{"id":"ق-1124","fp":"a61e2302f3f3","stateId":735,"easy":"الفرح في الأرض بغير الحق والمرح ← جهنم مثوى المتكبرين","cause":"الفرح في الأرض بغير الحق والمرح","result":"جهنم مثوى المتكبرين","explicit":true,"ref":"سورة غافر: 75–76","srcLabel":"القرآن الكريم","quran":{"s":40,"from":75,"to":76,"text":"ذَلِكُمْ بِمَا كُنْتُمْ تَفْرَحُونَ فِي الْأَرْضِ بِغَيْرِ الْحَقِّ وَبِمَا كُنْتُمْ تَمْرَحُونَ (75) ادْخُلُوا أَبْوَابَ جَهَنَّمَ خَالِدِينَ فِيهَا فَبِئْسَ مَثْوَى الْمُتَكَبِّرِينَ (76)","hl":[[0,184,1]]}},{"id":"ق-1182","fp":"07519109f41c","stateId":735,"easy":"الإفك والإثم: سماع آيات الله ثم الإصرار مستكبراً واتخاذها هزواً ← ويل وعذاب أليم ومهين ومن ورائهم جهنم","cause":"الإفك والإثم: سماع آيات الله ثم الإصرار مستكبراً واتخاذها هزواً","result":"ويل وعذاب أليم ومهين ومن ورائهم جهنم","explicit":true,"ref":"سورة الجاثية: 7–10","srcLabel":"القرآن الكريم","quran":{"s":45,"from":7,"to":10,"text":"وَيْلٌ لِكُلِّ أَفَّاكٍ أَثِيمٍ (7) يَسْمَعُ آيَاتِ اللَّهِ تُتْلَى عَلَيْهِ ثُمَّ يُصِرُّ مُسْتَكْبِرًا كَأَنْ لَمْ يَسْمَعْهَا فَبَشِّرْهُ بِعَذَابٍ أَلِيمٍ (8) وَإِذَا عَلِمَ مِنْ آيَاتِنَا شَيْئًا اتَّخَذَهَا هُزُوًا أُولَئِكَ لَهُمْ عَذَابٌ مُهِينٌ (9) مِنْ وَرَائِهِمْ جَهَنَّمُ وَلَا يُغْنِي عَنْهُمْ مَا كَسَبُوا شَيْئًا وَلَا مَا اتَّخَذُوا مِنْ دُونِ اللَّهِ أَوْلِيَاءَ وَلَهُمْ عَذَابٌ عَظِيمٌ (10)","hl":[[0,405,1]]}},{"id":"ق-1197","fp":"09627483d15b","stateId":735,"easy":"الاستكبار في الأرض بغير الحق والفسق وإذهاب الطيبات في الدنيا ← عذاب الهُون","cause":"الاستكبار في الأرض بغير الحق والفسق وإذهاب الطيبات في الدنيا","result":"عذاب الهُون","explicit":true,"ref":"سورة الأحقاف: 20","srcLabel":"القرآن الكريم","quran":{"s":46,"from":20,"to":20,"text":"وَيَوْمَ يُعْرَضُ الَّذِينَ كَفَرُوا عَلَى النَّارِ أَذْهَبْتُمْ طَيِّبَاتِكُمْ فِي حَيَاتِكُمُ الدُّنْيَا وَاسْتَمْتَعْتُمْ بِهَا فَالْيَوْمَ تُجْزَوْنَ عَذَابَ الْهُونِ بِمَا كُنْتُمْ تَسْتَكْبِرُونَ فِي الْأَرْضِ بِغَيْرِ الْحَقِّ وَبِمَا كُنْتُمْ تَفْسُقُونَ (20)","hl":[[0,262,1]]}},{"id":"س-00360","fp":"3c5597f18f3c","stateId":735,"easy":"إذا انتسبت إلى آباء كفار تريد بهم عزاً ← تكون عاشرهم في النار","cause":"مَن انتسَبَ إلى تِسعةِ آباءٍ كُفَّارٍ يريدُ بهم عِزًّا وكَرَمًا","result":"كان عاشِرَهم في النَّارِ","explicit":true,"similar":["س-05266"],"ref":"الجامع الصغير 8515","srcLabel":"البخاري","text":[["مَن انتسَبَ إلى تِسعةِ آباءٍ كُفَّارٍ يريدُ بهم عِزًّا وكَرَمًا، ",1],["كان عاشِرَهم في النَّارِ",2],"."],"grade":"حسن","narrator":"أبو ريحانة","muhaddith":"حسن","takhrij":"أخرجه أحمد (17212)، والبخاري في ((التاريخ الكبير)) (3/ 270)، وأبو يعلى (1439) بلفظه.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"fR2tqn4o"},{"id":"س-05266","fp":"144bb10fef46","stateId":735,"easy":"إذا انتسبت إلى آبائك الكفار فخراً ← تكون عاشرهم في النار","cause":"المُنْتَمي -أو المُنْتَسِبُ- إلى تِسْعةٍ في النَّارِ","result":"فأنت عاشِرُهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-00360","ref":"الأحاديث المختارة 1241","text":["«انْتَسَبَ رَجُلانِ على عَهْدِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقالَ أَحَدُهما: أنا فُلانُ بنُ فُلانِ بنِ فُلانٍ، فمَن أنت لا أُمَّ لك؟ فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: انْتَسَبَ رَجُلانِ على عَهْدِ موسى صلَّى اللهُ عليه وسلَّمَ، فقالَ أحَدُهما: أنا فُلانُ بنُ فُلانٍ، حتَّى عَدَّ تِسْعةً، فمَن أنت لا أُمَّ لك؟ قالَ: أنا فُلانُ بنُ فُلانِ بنِ الإسْلامِ، قالَ: فأَوْحى اللهُ إلى موسى عليه السَّلامُ: إنَّ هذَينِ المُنْتَسِبَينِ؛ أمَّا أنت أيُّها ",["المُنْتَمي -أو المُنْتَسِبُ- إلى تِسْعةٍ في النَّارِ",1]," ",["فأنت عاشِرُهم",2],"، وأمَّا أنت يا هذا المُنْتَسِبُ إلى اثْنَينِ في الجنَّةِ فأنت ثالِثُهما في الجنَّةِ»."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"sCfhYTR3"},{"id":"س-05292","fp":"9b24cfee1cb2","stateId":735,"easy":"إذا جررت ثوبك خيلاء ← تطؤه في النار","cause":"مَن وَطِئَه مِنَ الخُيَلاءِ وطِئَه","result":"في النَّارِ","explicit":true,"ref":"تخريج المسند لشعيب 15607","srcLabel":"أحمد","text":["عن أسلَمَ، أنَّه سَمِعَ هُبَيبَ بنَ مُغْفِلٍ، صاحِبَ النَّبيِّ صلَّى اللهُ عليه وسلَّم، ورَأى رَجُلًا يَجُرُّ رِداءَه خَلفَه، ويَطَؤُه، فقال: سُبحانَ اللهِ! سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: ",["مَن وَطِئَه مِنَ الخُيَلاءِ وطِئَه ",1],["في النَّارِ",2]],"grade":"صحيح","narrator":"هبيب بن مغفل","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"wSvpJDma","merged":3,"otherRefs":["تخريج المسند لشعيب 15605 (صحيح)","تنبيه الغافلين 217 (حسن)"]},{"id":"س-04236","fp":"7163fbd83fe9","stateId":735,"easy":"إذا كنت جباراً عنيداً أو ادعيت مع الله إلهاً أو صوّرت ← يخرج عنق من النار يلتقطك","cause":"بكلِّ جبَّارٍ عَنيدٍ، وبكلِّ مَنِ ادَّعَى مع اللهِ إلهًا آخَرَ، والمُصَوِّرينَ","result":"يَخرُجُ عُنُقٌ مِنَ النَّارِ يومَ القيامةِ، له عينانِ يُبصِرُ بهما، وأُذُنانِ يَسمَعُ بهما، ولسانٌ يَنطِقُ به، فيقولُ: إنِّي وُكِّلتُ بثلاثةٍ","explicit":true,"ref":"تخريج المسند لشعيب 8430","srcLabel":"الترمذي","text":[["يَخرُجُ عُنُقٌ مِنَ النَّارِ يومَ القيامةِ، له عينانِ يُبصِرُ بهما، وأُذُنانِ يَسمَعُ بهما، ولسانٌ يَنطِقُ به، فيقولُ: إنِّي وُكِّلتُ بثلاثةٍ",2],": ",["بكلِّ جبَّارٍ عَنيدٍ، وبكلِّ مَنِ ادَّعَى مع اللهِ إلهًا آخَرَ، والمُصَوِّرينَ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الترمذي (2574)، وأحمد (8430) واللفظ له","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"qOGG1He7","merged":2,"otherRefs":["الصحيح المسند 1406 (صحيح)"]},{"id":"س-03113","fp":"15ed2b57148c","stateId":735,"easy":"إذا نازعت الله في العظمة أو الكبرياء ← يدخلك النار","cause":"فمَن نازَعني في شيءٍ منه","result":"أدخَلْتُه في النَّارِ","explicit":true,"repOf":"س-00953","ref":"صحيح ابن حبان 5672","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم عن اللهِ جلَّ وعلا: ( الكبرياءُ ردائي والعظمةُ إزاري ",["فمَن نازَعني في شيءٍ منه",1]," ",["أدخَلْتُه في النَّارِ",2]," )"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن ماجه (4175)، والبزار (5106)، وابن عدي في ((الكامل في الضعفاء)) (5/363) باختلاف يسير","bab":"إيمان › توحيد الأسماء والصفات","dorar":"Jnw9TKXy"},{"id":"س-03152","fp":"7cf2255e2b34","stateId":735,"easy":"إذا نازعت الله رداءه ← لا ينبغي لك أن تدخل الجنة","cause":"ومَنْ نازَعَ اللهَ رِداءَهُ الَّذي ينبغي له","result":"فإنَّ اللهَ يقولُ: لا ينبغي لمَنْ نازَعني أنْ أُدْخِله الجنَّةَ","explicit":true,"ref":"المستدرك على الصحيحين 3730","srcLabel":"البيهقي","text":["عنْ أبي هُريرةَ رَضيَ اللهُ عنه، رفَعَهُ قالَ: «إنَّ للهِ ثلاثةَ أثوابٍ؛ اتَّزرَ العِزَّةَ، وتَسرْبلَ الرَّحمةَ، وارتدى الكِبرياءَ، فمَنْ تعزَّزَ بغيرِ ما أعزَّهُ اللهُ، فذلك الَّذي يُقالُ له: {ذُقْ إِنَّكَ أَنتَ الْعَزِيزُ الْكَرِيمُ} [الدخان: 49]، ومَنْ رَحِمَ النَّاسَ رَحِمَهُ اللهُ، فذلك الَّذي تَسرْبلَ بسِربالِهِ الَّذي ينبغي له، ",["ومَنْ نازَعَ اللهَ رِداءَهُ الَّذي ينبغي له، ",1],["فإنَّ اللهَ يقولُ: لا ينبغي لمَنْ نازَعني أنْ أُدْخِله الجنَّةَ»",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن حجر في ((الغرائب الملتقطة)) (775) بنحوه، والبيهقي في ((شعب الإيمان)) (7810) بلفظ مقارب","bab":"إيمان › توحيد الأسماء والصفات","dorar":"8ogeNT4w"},{"id":"س-04788","fp":"0565ef6b4461","stateId":735,"easy":"إذا وطئت على إزارك خيلاء ← تطأ في نار جهنم","cause":"مَن وطِئَ على إزارِه خُيَلاءَ","result":"وَطِئَ في نارِ جَهَنَّمَ","explicit":true,"similar":["س-05712"],"ref":"تخريج المسند لشعيب 18078","srcLabel":"أحمد","text":["«",["مَن وطِئَ على إزارِه خُيَلاءَ",1]," ",["وَطِئَ في نارِ جَهَنَّمَ",2],"»."],"grade":"صحيح","narrator":"هبيب بن مغفل الغفاري","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"hOhaFrHS"},{"id":"س-05712","fp":"b7ba260ce27c","stateId":735,"easy":"إذا وطئت على إزارك خيلاء ← تطؤه في النار","cause":"من وُطِيءَ على إزارٍ خُيلاءَ","result":"وُطِئَه في النَّارِ","explicit":true,"repOf":"س-04788","ref":"صحيح الجامع 6592","text":[["من وُطِيءَ على إزارٍ خُيلاءَ ، ",1],["وُطِئَه في النَّارِ",2]],"grade":"صحيح","narrator":"هبيب بن مغفل الغفاري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (15607)، وأبو يعلى (1542)، والطبراني (22/206) (543) باختلاف يسير.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"qEPgQH2S"},{"id":"س-05746","fp":"88ecbe08b9c4","stateId":735,"easy":"إذا كان في قلبك مثقال حبة خردل من كبر ← يكبك الله لوجهك في النار","cause":"مَن كان في قَلبِه مِثقالُ حَبَّةِ خَردَلٍ مِن كِبرٍ","result":"كَبَّه اللهُ لوَجهِه في النَّارِ","explicit":true,"repOf":"س-05720","ref":"تنبيه الغافلين 225","text":["«",["مَن كان في قَلبِه مِثقالُ حَبَّةِ خَردَلٍ مِن كِبرٍ ",1],["كَبَّه اللهُ لوَجهِه في النَّارِ»",2],". وفي رِوايةٍ: «لا يَدخُلُ الجَنَّةَ إنسانٌ في قَلبِه مِثقالُ حَبَّةِ خَردَلٍ مِن كِبرٍ»."],"grade":"صحيح","narrator":"عبد الله بن عمرو","muhaddith":"رجاله رجال الصحيح.","takhrij":"أخرجه الطبراني في ((الشاميين)) (62)، والخرائطي في ((مساويء الأخلاق)) (581)، وأبو نعيم في ((معرفة الصحابة)) (4358) باختلاف يسير.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"RWnYVAeQ"},{"id":"س-07500","fp":"85f2f394211c","stateId":735,"easy":"إذا ظللت تذهب بنفسك (تتكبر) ← تُكتب في الجبارين فيصيبك ما أصابهم","cause":"لا يزالُ الرَّجلُ يذهبُ بنفسِه","result":"حتَّى يُكتَبَ في الجبَّارين فيُصيبَه ما أصابهم","explicit":true,"ref":"الترغيب والترهيب 4/43","srcLabel":"الترمذي","text":[["لا يزالُ الرَّجلُ يذهبُ بنفسِه",1]," ",["حتَّى يُكتَبَ في الجبَّارين فيُصيبَه ما أصابهم",2]],"grade":"صحيح","narrator":"سلمة بن الأكوع","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (2000) واللفظ له، وابن أبي الدنيا في ((التواضع والخمول)) (198)، والطبراني (7/21) (6254)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"6NqGhpUt"},{"id":"س-04215","fp":"c741f9675f74","stateId":735,"easy":"إذا كنت جباراً عنيداً ← فلك في جهنم وادٍ فيه بئر يقال لها هبهب","cause":"كلَّ جَبَّارٍ عَنِيدٍ","result":"إِنَّ في جهنمَ وادِيًا في الوَادِي بِئْرٌ يقالُ لها : هَبْهَبٌ حقٌّ على اللهِ أنْ يُسْكِنَهُ","explicit":true,"similar":["س-06001"],"ref":"الفتح الرباني 11/5425","srcLabel":"الحاكم","text":[["إِنَّ في جهنمَ وادِيًا في الوَادِي بِئْرٌ يقالُ لها : هَبْهَبٌ حقٌّ على اللهِ أنْ يُسْكِنَهُ",2]," ",["كلَّ جَبَّارٍ عَنِيدٍ",1]],"grade":"حسن","narrator":"أبو موسى الأشعري","muhaddith":"إسناده حسن","takhrij":"أخرجه الدارمي (2816)، والطبراني في ((المعجم الأوسط)) (3548)، والحاكم (8765) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"R7Bc9tI5","merged":3,"otherRefs":["هداية الرواة 5/231 (حسن)","الزواجر عن اقتراف الكبائر 2/115 (حسن)"]},{"id":"س-00807","fp":"58d40faf4475","stateId":735,"easy":"إذا كنت جباراً عنيداً ← تلتقطك النار يوم القيامة من الصفوف","cause":"بِكلِّ جبَّارٍ عنيدٍ","result":"فتلتقطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسِمِ، فتجلِسُ بِهم في جَهنَّمَ","explicit":true,"ref":"الدر المنثور 10/111","srcLabel":"الحاكم","text":["عنِ ابنِ عبَّاسٍ قالَ: إذا كانَ يومُ القيامةِ مُدَّتِ الأرضُ مدَّ الأديمِ، وزيدَ في سَعتِها كذا وَكذا، وجمعَ الخلائقُ بصعيدٍ واحدٍ جنُّهمُ وَ إنسُهم، فإذا كانَ ذلِكَ اليومَ قُبِضت هذِهِ السَّماءُ الدُّنيا عن أَهلِها على وجْهِ الأرضِ ولأَهلُ السَّماءِ وحدُهم أَكثرُ من أَهلِ الأرضِ جنِّهم وَ إنسِهم بضِعفٍ، فإذا نُثِروا على وجْهِ الأرض فزعوا إليهِم فيقولون: أفيكم ربُّنا؟ فيفزعونَ من قولِهم ويقولونَ: سبحانَ ربِّنا ليس فينا وهو آتٍ، ثُمَّ تُقاضُ السَّماءُ الثَّانيةُ ولأَهلُ السَّماءِ الثَّانيةِ وحدَهم أَكثرَ من أهل السَّماءِ الدُّنيا، ومن جميعِ أهل الأرضِ بضِعفٍ جنِّهم وَ إنسِهم، فإذا نُثِروا على وجهِ الأرض فزعَ إليهم أهلُ الأرضِ فيقولونَ: أفيكُم ربُّنا؟ فيفزعونَ من قولِهم ويقولونَ: سبحانَ ربِّنا ليسَ فينا وهو آتٍ، ثم تُقاضُ السَّمواتُ سماءً سماءً كلَّما قيضَت سماءٌ عن أهلِها كانت أكثرَ من أهل السَّمواتِ الَّتي تحتَها ومن جميعِ أَهلِ الأرضِ بضِعفٍ، فإذا نُثِروا على أهل الأرضِ يفزعَ إليْهم أَهلُ الأرضِ فيقولونَ لَهم: مثلُ ذلِكَ فيرجعونَ إليهم مثل ذلك حتَّى تقاضَ السَّماءُ السَّابعةُ فلَأَهلُ السَّماءِ السَّابعةِ أَكثرُ من أهلِ ستِّ سمواتٍ ومن جميعِ أهلِ الأرضِ بضِعفٍ، فيجيءُ اللَّهُ فيهم والأممُ جثًى صفوفٌ فينادي منادٍ ستعلمونَ اليومَ من أصحابُ الْكرمِ ليقُمِ الحمَّادونَ للَّهِ على كلِّ حالٍ فيقومونَ فيسرَحونَ إلى الجنَّةِ ثمَّ ينادي الثَّانيةَ ستعلمون اليومَ من أصحابُ الْكرمِ أينَ الَّذينَ كانت تَتَجَافَى جُنُوبُهُمْ عَنِ المَضَاجِعِ يَدْعُونَ رَبَّهُمْ خَوْفًا وَطَمَعًا وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ [السجدة آية: 16] فيقومونَ فيسرَحونَ إلى الجنَّةِ، قالَ: ثمَّ ينادي الثَّالثةَ ستعلمون اليومَ من أصحابُ الْكرَمِ أين الَّذينَ لَا تُلْهِيهِمْ تِجَارَةٌ وَلَا بَيْعٌ عَنْ ذِكْرِ اللَّهِ وَإِقَامِ الصَّلَاةِ وَإِيتَاءِ الزَّكَاةِ يَخَافُونَ يَوْمًا تَتَقَلَّبُ فِيهِ الْقُلُوبُ وَالْأَبْصَارُ [النور آية: 37] فيقومونَ فيسرَحونَ إلى الجنَّةِ فإذا أخذَ كلٌّ من هؤلاءِ ثلاثةٌ خرجَ عنُقٌ منَ النَّارِ فأشرفَ على الخلائقِ لَهُ عينانِ تبصِرانِ ولسانٌ فصيحٌ فيقولُ: إنِّي وُكِّلتُ منكُم بثلاثةٍ ",["بِكلِّ جبَّارٍ عنيدٍ",1]," ",["فتلتقطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسِمِ، فتجلِسُ بِهم في جَهنَّمَ",2]," ثمَّ تخرجُ ثانيةً فتقولُ إنِّي وُكِّلتُ منكُم بمن آذى اللَّهَ تعالى ورسولَهُ، فتلتقِطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسمِ فتُحبَسُ بهم في جهنَّمَ، ثم تخرجُ ثالثةً فتقولُ: إنِّي وُكِّلتُ بأصحابِ التَّصاويرِ فتَلقطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسمِ فتُحبَسُ بِهم في جَهنَّمَ فإذا أُخذَ من هؤلاءِ ثلاثةً ومن هؤلاءِ ثلاثةً نشِرتِ الصُّحفَ ووُضِعتِ الموازينَ ودُعيَ الخلائقُ للحسابِ"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن المبارك في ((الزهد والرقائق)) (2/101) واللفظ له، والحاكم (8699)، والحارث بن أبي أسامة كما في ((بغية الباحث)) (1122) بلفظ مقارب","bab":"أدعية وأذكار › حمد الله في كل الأحوال","dorar":"TsRrl1QY"},{"id":"س-05131","fp":"f1bcd642c92e","stateId":735,"easy":"إذا أحببت أن يقوم لك الرجال قياماً ← وجبت لك النار","cause":"مَن أحبَّ أنْ يستجِمَّ له الرِّجالُ قيامًا","result":"وجبَتْ له النَّارُ","explicit":true,"ref":"تخريج مشكل الآثار 1125","srcLabel":"أبو داود","text":[["مَن أحبَّ أنْ يستجِمَّ له الرِّجالُ قيامًا ",1],["وجبَتْ له النَّارُ",2],"."],"grade":"حسن","narrator":"معاوية بن أبي سفيان","muhaddith":"إسناده قوي","takhrij":"أخرجه أبو داود (5229)، والترمذي (2755)، وأحمد (16830) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Ui7QKSSY"},{"id":"س-04790","fp":"5bc3f6a11bd4","stateId":735,"easy":"إذا كنت عتلاً جوّاظاً مستكبراً ← فأنت من أهل النار","cause":"كُلُّ عُتُلٍّ جَوَّاظٍ مُستَكبِرٍ","result":"ألا أُخبِرُكُم بأهلِ النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-04967","ref":"صحيح مسلم 2853","text":["ألا أُخبِرُكُم بأهلِ الجَنَّةِ؟ قالوا: بَلى، قال صلَّى اللهُ عليه وسلَّم: كُلُّ ضَعيفٍ مُتَضَعِّفٍ، لو أقسَمَ على اللهِ لأبَرَّه، ثُمَّ قال: ",["ألا أُخبِرُكُم بأهلِ النَّارِ",2],"؟ قالوا: بَلى، قال: ",["كُلُّ عُتُلٍّ جَوَّاظٍ مُستَكبِرٍ",1],". وفي روايةٍ: بهذا الإسنادِ بمِثلِه، غيرَ أنَّه قال: ألا أدُلُّكُم."],"grade":"صحيح","narrator":"حارثة بن وهب الخزاعي","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4918)، والترمذي (2605)، وأحمد (18728) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"UwXLp5PX","merged":3,"otherRefs":["تخريج المسند لشعيب 23131 (صحيح)","صحيح الجامع 2594 (صحيح)"]},{"id":"س-02879","fp":"c04b6660a0fa","stateId":735,"easy":"إذا كنت جباراً متكبراً ← تدخل النار","cause":"الجَبَّارون والمُتكَبِّرون","result":"يا رَبِّ، ما لها يَدخُلُها","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"similar":["س-02967"],"ref":"تخريج المسند لشعيب 10588","srcLabel":"متفق عليه","text":["اختصَمَتِ الجنَّةُ والنَّارُ، فقالتِ الجنَّةُ: أي رَبِّ، ما لها يَدخُلُها ضُعفاءُ النَّاسِ وسَقَطُهم؟ وقالت النَّارُ: ",["يا رَبِّ، ما لها يَدخُلُها",2]," ",["الجَبَّارون والمُتكَبِّرون",1],"؟ قال للجنَّةِ: أنتِ رَحمَتي أُصيبُ بكِ مَن أشاءُ، وقال للنَّارِ: أنتِ عَذابي أُصيبُ بكِ مَن أشاءُ، ولكُلِّ واحِدةٍ منكما مِلؤُها. قال: فأمَّا الجنَّةُ؛ فإنَّ اللهَ عزَّ وجلَّ لا يَظلِمُ مِن خَلقِهِ أحدًا، وإنَّه يُنشِئُ لها مِن خَلقِهِ ما شاءَ، وأمَّا النَّارُ؛ فيُلقَوْن فيها، وتَقولُ: هل مِن مَزيدٍ؟ ويُلقَوْن فيها، وتَقولُ: هل مِن مَزيدٍ، حتى يَضَعَ رَبُّنا عزَّ وجلَّ فيها قَدَمَهُ، فهُنالك تَمتَلئُ ويَنزَوي بَعضُها إلى بَعضٍ، وتَقولُ: قَطْ قَطْ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (7449)، ومسلم (2846)، والنسائي في ((السنن الكبرى)) (7740)، وأحمد (10588) واللفظ له","bab":"إيمان › الوعد","dorar":"RBlv8xU3"},{"id":"س-02967","fp":"f255da2dbd77","stateId":735,"easy":"إذا كنت جباراً متكبراً ← تدخل النار","cause":"الجَبابرةُ والمُتكبِّرونَ والمُلوكُ والأشرافُ","result":"يا ربِّ، يَدخُلُني","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-02879","ref":"تخريج المسند لشعيب 11099","text":["\"افتَخَرتِ الجَنَّةُ والنَّارُ، فقالتِ النَّارُ: ",["يا ربِّ، يَدخُلُني",2]," ",["الجَبابرةُ والمُتكبِّرونَ والمُلوكُ والأشرافُ",1],"، وقالتِ الجَنَّةُ: أيْ ربِّ، يَدخُلُني الضُّعَفاءُ والفُقراءُ والمساكينُ، فيقولُ اللهُ تبارَك وتعالى للنَّارِ: أنتِ عَذابي أُصيبُ بكِ مَن أَشاءُ، وقال للجَنَّةِ: أنتِ رَحمَتي وسِعَتْ كلَّ شيءٍ، ولكلِّ واحدةٍ منكما مِلْؤُها، فيُلْقى في النَّارِ أهلُها، فتقولُ: هل من مَزيدٍ؟ قال: ويُلْقى فيها، وتقولُ: هل من مَزيدٍ؟ ويُلْقى فيها، وتقولُ: هل من مَزيدٍ؟ حتى يَأتِيَها تبارَك وتعالى، فيضَعُ قدَمَه عليها فتُزْوى، فتقولُ: قَدِي قَدِي، وأمَّا الجَنَّةُ فيَبْقى فيها أهلُها ما شاء اللهُ أنْ يَبْقى، فيُنشئُ اللهُ لها خَلْقًا ما يَشاءُ\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (11099) واللفظ له، وعبد بن حميد (906)، وأبو يعلى (1313)","bab":"إيمان › الوعيد","dorar":"Ezp3c6FA","merged":7,"otherRefs":["تخريج صحيح ابن حبان 7477 (صحيح)","التمهيد 5/10 (صحيح)","صحيح الجامع 185 (صحيح)","تخريج كتاب السنة 528 (صحيح)","تفسير الطبري 13/2/208 (صحيح)","صحيح مسلم 2846 (صحيح)"]},{"id":"س-06001","fp":"1f80c2b8e7e8","stateId":735,"easy":"إذا كنت جباراً ← حق على الله أن يسكنك وادياً في جهنم","cause":"كُلَّ جبارٍ","result":"في جهَنَّمَ وادٍ، وفي الوادي بِئْرٌ يُقالُ له: هَبْ هَبْ، حَقٌّ على اللهِ أنْ يُسكِنَها","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-04215","ref":"المستدرك على الصحيحين 8160","text":["عن مُحَمَّدِ بنَ واسِعٍ الأزْدِيِّ: دَخَلتُ على بلالِ بنِ أبي بُرْدةَ بنِ أبي مُوسى، فقُلْتُ: يا بِلالُ، إنَّ أباكَ حدَّثَني عنْ جَدِّكَ، عنْ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أنَّه قالَ: ",["في جهَنَّمَ وادٍ، وفي الوادي بِئْرٌ يُقالُ له: هَبْ هَبْ، حَقٌّ على اللهِ أنْ يُسكِنَها",2]," ",["كُلَّ جبارٍ",1],"؛ فاتَّقِ اللهَ لا تَسكُنْها."],"grade":"صحيح","narrator":"أبو موسى","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الدارمي (2858)، وأبو يعلى الموصلي (7249)، والعقيلي في ((الضعفاء)) (1/ 134) جميعهم بلفظه.","bab":"رقائق وزهد › تقوى الله","dorar":"UtBV2RM9"},{"id":"س-08146","fp":"2bba675e26c1","stateId":735,"easy":"إذا كنت مختالاً فخوراً ← تلتقطك النار بلسانها","cause":"كلُّ مُختالٍ فَخورٍ","result":"فتلتقطُهُم بلسانِها وتقذِفُهم في جوفِها","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"البدور السافرة 151","srcLabel":"أبو يعلى","text":["إذا جمعَ اللَّهُ النَّاسَ في صعيدٍ واحدٍ يومَ القيامةِ ، أقبلَتِ النَّارُ يركَبُ بعضُها بعضًا وخزنَتُها يَكفُّونَها وَهيَ تقولُ وعزَّةِ ربِّي ليُخلَّيَنَّ بيني وبينَ أزواجي أو لأغشَينَّ النَّاسَ عُنُقًا واحدَةً فيقولونَ ومَن أزواجُك فتقولُ ",["كلُّ مُختالٍ فَخورٍ",1]," ",["فتلتقطُهُم بلسانِها وتقذِفُهم في جوفِها",2]," ، ويَقضي اللَّهُ بينَ العبادِ"],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"رجاله ثقات","takhrij":"أخرجه أبو يعلى (1145) بنحوه","bab":"ملائكة › أعمال الملائكة","dorar":"pgvHJRA1"},{"id":"س-07243","fp":"a2230b487a46","stateId":735,"easy":"إذا أحببت أن يقوم الناس على رأسك ← فتبوأ مقعدك من النار","cause":"ما مِنْ رَجُلٍ يَكونُ على النَّاسِ، فَيقومُ على رَأْسِهِ الرِّجالُ، يُحِبُّ أَنْ تَكْثُرَ الخُصومُ عنده","result":"فيَدْخُلَ الجَنَّةَ","explicit":true,"ref":"المستدرك على الصحيحين 325","srcLabel":"البيهقي","text":["عنِ ابنِ بُرَيْدَةَ، أنَّ مُعاويةَ خَرَجَ مِنْ حَمَّامِ حِمْصَ، فقالَ لغُلامِهِ: ائْتِني بِسِبْتِيَّتَيَّ، فَلَبِسَهُما، ثُمَّ دَخَلَ مَسْجِدَ حِمْصَ، فَرَكَعَ رَكْعَتَيْنِ، فلمَّا فَرَغَ إذا هو بِناسٍ جُلوسٍ، فقالَ لَهُمْ: ما يُجْلِسُكُمْ؟ قالوا: صَلَّيْنا صلاةَ المَكْتوبَةِ، ثُمَّ قَصَّ القاصُّ، فلمَّا فَرَغَ قَعَدْنا نَتَذاكَرُ سُنَّةَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ. فقالَ مُعاويةُ: ما مِنْ رَجُلٍ أدْرَكَ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ أَقَلَّ حَديثًا عنه مِنِّي، إنِّي سَأُحَدِّثُكُمْ بخَصْلَتَيْنِ حَفِظْتُهُما مِنْ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ: «",["ما مِنْ رَجُلٍ يَكونُ على النَّاسِ، فَيقومُ على رَأْسِهِ الرِّجالُ، يُحِبُّ أَنْ تَكْثُرَ الخُصومُ عنده",1]," ",["فيَدْخُلَ الجَنَّةَ",2],"». قالَ: وكُنتُ مع النَّبيِّ صلَّى اللهُ عليه وسلَّمَ يومًا، فدَخَلَ المَسْجِدَ، فإذا هو بِقَوْمٍ في المَسْجِدِ قُعودٍ، فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: «ما يُقْعِدُكُمْ؟». قالوا: صَلَّيْنا الصَّلاةَ المَكْتوبَةَ، ثُمَّ قَعَدْنا نَتَذاكَرُ كِتابَ اللهِ وسُنَّةَ نَبِيِّهِ صلَّى اللهُ عليه وسلَّمَ. فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «إنَّ اللهَ إذا ذَكَرَ شَيْئًا تَعاظَمَ ذِكْرُهُ»."],"grade":"صحيح","narrator":"معاوية","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه البيهقي في ((المدخل إلى السنن الكبرى)) (418)، والديلمي كما في ((زهر الفردوس)) لابن حجر (651) واللفظ لهما.","bab":"علم › فضل مجالس العلم والذكر","dorar":"8qCl1cn9"},{"id":"س-07887","fp":"6d2047b77004","stateId":736,"easy":"إذا سجدت رياءً واتقاءً ← يجعل الله ظهرك طبقة واحدة يوم القيامة فلا تستطيع السجود","cause":"مَن كانَ يَسجُدُ اتِّقاءً ورياءً","result":"إلَّا جَعَلَ اللهُ ظَهرَه طَبَقةً واحِدةً، كُلَّما أرادَ أن يَسجُدَ خَرَّ على قَفاه","explicit":true,"star":true,"otherNeedIds":[52],"ref":"صحيح مسلم 183","srcLabel":"البخاري","text":["أنَّ ناسًا في زَمَنِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم قالوا: يا رَسولَ اللهِ، هل نَرى رَبَّنا يَومَ القيامةِ؟ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: نَعَم، قال: هل تُضارُّونَ في رُؤيةِ الشَّمسِ بالظَّهيرةِ صَحوًا ليس معها سَحابٌ؟ وهل تُضارُّونَ في رُؤيةِ القَمَرِ لَيلةَ البَدرِ صَحوًا ليس فيها سَحابٌ؟ قالوا: لا يا رَسولَ اللهِ، قال: ما تُضارُّونَ في رُؤيةِ اللهِ تَبارَك وتَعالى يَومَ القيامةِ إلَّا كما تُضارُّونَ في رُؤيةِ أحَدِهما، إذا كانَ يَومُ القيامةِ أذَّنَ مُؤَذِّنٌ: ليَتَّبِعْ كُلُّ أُمَّةٍ ما كانَت تَعبُدُ، فلا يَبقى أحَدٌ كانَ يَعبُدُ غيرَ اللهِ سُبحانَه مِنَ الأصنامِ والأنصابِ إلَّا يَتَساقَطونَ في النَّارِ، حتَّى إذا لَم يَبقَ إلَّا مَن كانَ يَعبُدُ اللهَ مِن بَرٍّ وفاجِرٍ وغُبَّرِ أهلِ الكِتابِ، فيُدعى اليَهودُ، فيُقالُ لهم: ما كُنتُم تَعبُدونَ؟ قالوا: كُنَّا نَعبُدُ عُزَيرَ ابنَ اللهِ، فيُقالُ: كَذَبتُم، ما اتَّخَذَ اللهُ مِن صاحِبةٍ ولا ولَدٍ، فماذا تَبغونَ؟ قالوا: عَطِشنا يا رَبَّنا، فاسقِنا، فيُشارُ إليهم، ألا تَرِدونَ؟ فيُحشَرونَ إلى النَّارِ كَأنَّها سَرابٌ يَحطِمُ بَعضُها بَعضًا، فيَتَساقَطونَ في النَّارِ، ثُمَّ يُدعى النَّصارى، فيُقالُ لهم: ما كُنتُم تَعبُدونَ؟ قالوا: كُنَّا نَعبُدُ المَسيحَ ابنَ اللهِ، فيُقالُ لهم، كَذَبتُم، ما اتَّخَذَ اللهُ مِن صاحِبةٍ ولا ولَدٍ، فيُقالُ لهم: ماذا تَبغونَ؟ فيَقولونَ: عَطِشنا يا رَبَّنا، فاسقِنا، قال: فيُشارُ إليهم، ألا تَرِدونَ؟ فيُحشَرونَ إلى جَهَنَّمَ كَأنَّها سَرابٌ يَحطِمُ بَعضُها بَعضًا، فيَتَساقَطونَ في النَّارِ، حتَّى إذا لَم يَبقَ إلَّا مَن كانَ يَعبُدُ اللهَ تَعالى مِن بَرٍّ وفاجِرٍ، أتاهم رَبُّ العالَمينَ سُبحانَه وتَعالى في أدنى صورةٍ مِنَ التي رَأوْه فيها، قال: فما تَنتَظِرونَ؟ تَتبَعُ كُلُّ أُمَّةٍ ما كانَت تَعبُدُ، قالوا: يا رَبَّنا، فارَقنا النَّاسَ في الدُّنيا أفقَرَ ما كُنَّا إليهم، ولَم نُصاحِبْهُم، فيَقولُ: أنا رَبُّكُم، فيَقولونَ: نَعوذُ باللهِ مِنك لا نُشرِكُ باللهِ شيئًا، مَرَّتَينِ أو ثَلاثًا، حتَّى إنَّ بَعضَهم لَيَكادُ أن يَنقَلِبَ، فيَقولُ: هل بينَكُم وبينَه آيةٌ فتَعرِفونَه بها؟ فيَقولونَ: نَعَم، فيُكشَفُ عن ساقٍ، فلا يَبقى مَن كانَ يَسجُدُ للَّهِ مِن تِلقاءِ نَفسِه إلَّا أذِنَ اللهُ له بالسُّجودِ، ولا يَبقى ",["مَن كانَ يَسجُدُ اتِّقاءً ورياءً",1]," ",["إلَّا جَعَلَ اللهُ ظَهرَه طَبَقةً واحِدةً، كُلَّما أرادَ أن يَسجُدَ خَرَّ على قَفاه",2],"، ثُمَّ يَرفَعونَ رُؤوسَهم وقد تَحَوَّلَ في صورَتِه التي رَأوْه فيها أوَّلَ مَرَّةٍ، فقال: أنا رَبُّكُم، فيَقولونَ: أنتَ رَبُّنا، ثُمَّ يُضرَبُ الجِسرُ على جَهَنَّمَ، وتَحِلُّ الشَّفاعةُ، ويقولونَ: اللهمَّ سَلِّمْ سَلِّمْ، قيلَ: يا رَسولَ اللهِ، وما الجِسرُ؟ قال: دَحضٌ مَزِلَّةٌ، فيه خَطاطيفُ وكَلاليبُ، وحَسَكٌ تَكونُ بنَجدٍ فيها شويكةٌ يُقالُ لها السَّعدانُ، فيَمُرُّ المُؤمِنونَ كَطَرفِ العَينِ، وكالبَرقِ، وكالرِّيحِ، وكالطَّيرِ، وكَأجاويدِ الخَيلِ والرِّكابِ؛ فناجٍ مُسَلَّمٌ، ومَخدوشٌ مُرسَلٌ، ومَكدوسٌ في نارِ جَهَنَّمَ، حتَّى إذا خَلَصَ المُؤمِنونَ مِنَ النَّارِ، فوالذي نَفسي بيَدِه، ما مِنكُم مِن أحَدٍ بأشَدَّ مُناشَدةً للَّهِ في استِقصاءِ الحَقِّ مِنَ المُؤمِنينَ للَّهِ يَومَ القيامةِ لإخوانِهمُ الذينَ في النَّارِ، يقولونَ: رَبَّنا كانوا يَصومونَ معنا ويُصَلُّونَ ويَحُجُّونَ، فيُقالُ لهم: أخرِجوا مَن عَرَفتُم، فتُحَرَّمُ صورُهم على النَّارِ، فيُخرِجونَ خَلقًا كَثيرًا قدِ أخَذَتِ النَّارُ إلى نِصفِ ساقَيه، وإلى رُكبَتَيه، ثُمَّ يقولونَ: رَبَّنا ما بَقيَ فيها أحَدٌ مِمَّن أمَرتَنا به، فيَقولُ: ارجِعوا فمَن وجَدتُم في قَلبِه مِثقالَ دينارٍ مِن خَيرٍ فأخرِجوه، فيُخرِجونَ خَلقًا كَثيرًا، ثُمَّ يقولونَ: رَبَّنا لَم نَذَرْ فيها أحَدًا مِمَّن أمَرتَنا، ثُمَّ يقولُ: ارجِعوا فمَن وجَدتُم في قَلبِه مِثقالَ نِصفِ دينارٍ مِن خَيرٍ فأخرِجوه، فيُخرِجونَ خَلقًا كَثيرًا، ثُمَّ يقولونَ: رَبَّنا لَم نَذَرْ فيها مِمَّن أمَرتَنا أحَدًا، ثُمَّ يقولُ: ارجِعوا فمَن وجَدتُم في قَلبِه مِثقالَ ذَرَّةٍ مِن خَيرٍ فأخرِجوه، فيُخرِجونَ خَلقًا كَثيرًا، ثُمَّ يقولونَ: رَبَّنا لَم نَذَرْ فيها خَيرًا. وكانَ أبو سَعيدٍ الخُدريُّ يقولُ: إن لَم تُصَدِّقوني بهذا الحَديثِ فاقرَؤوا إن شِئتُم: {إنَّ اللهَ لا يَظلِمُ مِثقالَ ذَرَّةٍ وإن تَكُ حَسَنةً يُضاعِفها ويُؤتِ مِن لَدُنْه أجرًا عَظيمًا} [النساء: 40]، فيَقولُ اللهُ عزَّ وجلَّ: شَفَعَتِ المَلائِكةُ، وشَفَعَ النَّبيُّونَ، وشَفَعَ المُؤمِنونَ، ولَم يَبقَ إلَّا أرحَمُ الرَّاحِمينَ، فيَقبِضُ قَبضةً مِنَ النَّارِ، فيُخرِجُ مِنها قَومًا لَم يَعمَلوا خَيرًا قَطُّ قد عادوا حُمَمًا، فيُلقيهم في نَهَرٍ في أفواهِ الجَنَّةِ، يُقالُ له: نَهَرُ الحَياةِ، فيَخرُجونَ كما تَخرُجُ الحِبَّةُ في حَميلِ السَّيلِ، ألا تَرَونَها تَكونُ إلى الحَجَرِ أو إلى الشَّجَرِ، ما يَكونُ إلى الشَّمسِ أُصَيفِرُ وأُخَيضِرُ، وما يَكونُ مِنها إلى الظِّلِّ يَكونُ أبيَضَ؟ فقالوا: يا رَسولَ اللهِ، كَأنَّك كُنتَ تَرعى بالباديةِ! قال: فيَخرُجونَ كاللُّؤلُؤِ في رِقابِهمُ الخَواتِمُ، يَعرِفُهم أهلُ الجَنَّةِ: هؤلاء عُتَقاءُ اللهِ الذينَ أدخَلَهمُ اللهُ الجَنَّةَ بغيرِ عَمَلٍ عَمِلوه، ولا خَيرٍ قدَّموه، ثُمَّ يقولُ: ادخُلوا الجَنَّةَ فما رَأيتُموه فهو لكم، فيَقولونَ: رَبَّنا، أعطَيتَنا ما لَم تُعطِ أحَدًا مِنَ العالَمينَ، فيَقولُ: لكم عِندي أفضَلُ مِن هذا، فيَقولونَ: يا رَبَّنا، أيُّ شيءٍ أفضَلُ مِن هذا؟ فيَقولُ: رِضايَ، فلا أسخَطُ علَيكُم بَعدَه أبَدًا. قال مُسلِمٌ: قَرَأتُ على عيسى بنِ حَمَّادٍ زُغبةَ المِصريِّ هذا الحَديثَ في الشَّفاعةِ، وقُلتُ له: أُحَدِّثُ بهذا الحَديثِ عَنك أنَّك سَمِعتَ مِنَ اللَّيثِ بنِ سَعدٍ، فقال: نَعَم، قُلتُ لعيسى بنِ حَمَّادٍ: أخبَرَكُمُ اللَّيثُ بنُ سَعدٍ، عن خالِدِ بنِ يَزيدَ، عن سَعيدِ بنِ أبي هِلالٍ، عن زَيدِ بنِ أسلَمَ، عن عَطاءِ بنِ يَسارٍ، عن أبي سَعيدٍ الخُدريِّ، أنَّه قال: قُلنا: يا رَسولَ اللهِ، أنَرى رَبَّنا؟ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: هل تُضارُّونَ في رُؤيةِ الشَّمسِ إذا كانَ يَومٌ صَحوٌ؟ قُلنا: لا، وسُقتُ الحَديثَ حتَّى انقَضى آخِرُه، وهو نَحوُ حَديثِ حَفصِ بنِ مَيسَرةَ، وزادَ بَعدَ قَولِه: بغيرِ عَمَلٍ عَمِلوه، ولا قدَمٍ قدَّموه، فيُقالُ لهم: لكم ما رَأيتُم ومِثلُه معهُ. قال أبو سَعيدٍ: بَلَغَني أنَّ الجِسرَ أدَقُّ مِنَ الشَّعرةِ، وأحَدُّ مِنَ السَّيفِ. وليسَ في حَديثِ اللَّيثِ، فيَقولونَ: رَبَّنا أعطَيتَنا ما لَم تُعطِ أحَدًا مِنَ العالَمينَ وما بَعدَه، فأقَرَّ به عيسى بنُ حَمَّادٍ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7439) باختلاف يسير","bab":"قيامة › الشفاعة","dorar":"KOAVhCFo","merged":5,"otherRefs":["المستدرك على الصحيحين 8962 (صحيح)","صحيح البخاري 4919 (صحيح)","تخريج كتاب السنة 634 (صحيح)","تخريج صحيح ابن حبان 7377 (صحيح)"]},{"id":"س-05488","fp":"2ac5e3a01df8","stateId":736,"easy":"إذا أنفقت ليُقال جواد ← تكون من أول من تُسعّر بهم النار","cause":"بل إنَّما أرَدْتَ أنْ يُقالَ: فلانٌ جَوَادٌ فقد قيل ذاك","result":"أولئك الثَّلاثةُ أوَّلُ خلقِ اللهِ تُسعَّرُ بهم النَّارُ يومَ القيامةِ","explicit":true,"otherNeedIds":[52],"ref":"تخريج صحيح ابن حبان 408","srcLabel":"مسلم","text":["أنَّه دخَل مسجدَ المدينةِ فإذا هو برجلٍ قد اجتمَع عليه النَّاسُ فقال: مَن هذا ؟ قالوا: أبو هُريرةَ قال: فدنَوْتُ منه حتَّى قعَدْتُ بينَ يديه وهو يُحدِّثُ النَّاسَ فلمَّا سكَت وخلا قُلْتُ له: أنشُدُكَ بحقِّي لَمَا حدَّثْتَني حديثًا سمِعْتَه عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم عقَلْتَه وعلِمْتَه فقال أبو هُريرةَ: أفعَلُ، لَأُحدِّثَنَّك حديثًا حدَّثَنيه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم عقَلْتُه وعلِمْتُه ثمَّ نشَغ أبو هُريرةَ نَشغةً فمكَث قليلًا ثمَّ أفاق فقال: لَأُحَدِّثَنَّك حديثًا حدَّثنيه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم وأنا وهو في هذا البيتِ ما معنا أحدٌ غيري وغيرُه ثمَّ نشَغ أبو هُريرةَ نَشغةً أخرى فمكَث كذلك ثمَّ أفاق فمسَح عن وجهِه فقال: أفعَلُ، لَأُحَدِّثَنَّك حديثًا حدَّثنيه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم وأنا وهو في هذا البيتِ ما معه أحدٌ غيري وغيرُه ثمَّ نشَغ نشغةً شديدةً ثمَّ مال خارًّا على وجهِه واشتدَّ به طويلًا ثمَّ أفاق فقال: حدَّثني رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( أنَّ اللهَ تبارَك وتعالى إذا كان يومُ القيامةِ ينزِلُ إلى العبادِ ليقضيَ بينَهم وكلُّ أمةٍ جاثيةٌ \nفأوَّلُ مَن يدعو به رجلٌ جمَع القرآنَ ورجلٌ يُقتَلُ في سبيلِ اللهِ ورجلٌ كثيرُ المالِ فيقولُ اللهُ تبارَك وتعالى للقارئِ: ألم أُعلِّمْكَ ما أنزَلْتُ على رسولي صلَّى اللهُ عليه وسلَّم ؟ قال: بلى يا ربِّ قال: فماذا عمِلْتَ فيما علِمْتَ ؟ قال: كُنْتُ أقومُ به آناءَ اللَّيلِ وآناءَ النَّهارِ فيقولُ اللهُ تبارَك وتعالى له: كذَبْتَ وتقولُ له الملائكةُ: كذَبْتَ ويقولُ اللهُ: بل أرَدْتَ أنْ يُقالَ: فلانٌ قارئٌ فقد قيل ذاك \nويُؤتَى بصاحبِ المالِ فيقولُ اللهُ له: ألم أُوسِّعْ عليك حتَّى لم أدَعْكَ تحتاجُ إلى أحدٍ ؟ قال: بلى يا ربِّ قال: فماذا عمِلْتَ فيما آتَيْتُك ؟ قال: كُنْتُ أصِلُ الرَّحِمَ وأتصدَّقُ ؟ فيقولُ اللهُ له: كذَبْتَ وتقولُ الملائكةُ له: كذَبْتَ ويقولُ اللهُ: ",["بل إنَّما أرَدْتَ أنْ يُقالَ: فلانٌ جَوَادٌ فقد قيل ذاك",1]," \nويُؤتَى بالَّذي قُتِل في سبيلِ اللهِ فيُقالُ له: في ماذا قُتِلْتَ ؟ فيقولُ: أُمِرْتُ بالجهادِ في سبيلِك فقاتَلْتُ حتَّى قُتِلْتُ فيقولُ اللهُ له: كذَبْتَ وتقولُ له الملائكةُ: كذَبْتَ ويقولُ اللهُ: بل أرَدْتَ أنْ يُقالَ: فلانٌ جريءٌ فقد قيل ذاك ) ثمَّ ضرَب رسولُ اللهِ صلَّى اللهُ عليه وسلَّم رُكبتي فقال: ( يا أبا هُريرةَ ",["أولئك الثَّلاثةُ أوَّلُ خلقِ اللهِ تُسعَّرُ بهم النَّارُ يومَ القيامةِ",2]," ) \nقال الوليدُ بنُ أبي الوليدِ: فأخبَرني عقبةُ أنَّ شُفَيًّا هو الَّذي دخَل على معاويةَ فأخبَره بهذا الخبرِ \nقال أبو عثمانَ الوليدُ: وحدَّثني العلاءُ بنُ أبي حكيمٍ أنَّه كان سيَّافًا لمعاويةَ قال: فدخَل عليه رجلٌ فحدَّثه بهذا عن أبي هُريرةَ فقال معاويةُ: قد فُعِل بهؤلاء مِثلُ هذا فكيف بِمَن بقي مِن النَّاسِ ؟ ثمَّ بكى معاويةُ بكاءً شديدًا حتَّى ظنَنَّا أنَّه هالكٌ وقُلْنا: قد جاءنا هذا الرَّجلُ بِشَرٍّ ثمَّ أفاق معاويةُ ومسَح عن وجهِه فقال: صدَق اللهُ ورسولُه {مَنْ كَانَ يُرِيدُ الْحَيَاةَ الدُّنْيَا وَزِينَتَهَا نُوَفِّ إِلَيْهِمْ أَعْمَالَهُمْ فِيهَا وَهُمْ فِيهَا لَا يُبْخَسُونَ * أُولَئِكَ الَّذِينَ لَيْسَ لَهُمْ فِي الْآخِرَةِ إِلَّا النَّارُ وَحَبِطَ مَا صَنَعُوا فِيهَا وَبَاطِلٌ مَا كَانُوا يَعْمَلُونَ} [هود: 15، 16]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (408) واللفظ له، ومسلم (1905) بنحوه مختصرا، والترمذي (2382) بنحوه.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"tBU37SCj","merged":5,"otherRefs":["اقتضاء العلم 107 (صحيح)","تاريخ الإسلام 7/102 (صحيح)","المستدرك على الصحيحين 2560 (صحيح)","صحيح النسائي 3137 (صحيح)"]},{"id":"س-05487","fp":"390a5f7a1d24","stateId":736,"easy":"إذا قرأت القرآن ليُقال قارئ ← تكون من الثلاثة الذين تُسعّر بهم النار أولاً","cause":"بل أرَدْتَ أنْ يُقالَ: فلانٌ قارئٌ فقد قيل ذاك","result":"أولئك الثَّلاثةُ أوَّلُ خلقِ اللهِ تُسعَّرُ بهم النَّارُ يومَ القيامةِ","explicit":true,"similar":["س-04424"],"otherNeedIds":[52],"ref":"تخريج صحيح ابن حبان 408","srcLabel":"مسلم","text":["أنَّه دخَل مسجدَ المدينةِ فإذا هو برجلٍ قد اجتمَع عليه النَّاسُ فقال: مَن هذا ؟ قالوا: أبو هُريرةَ قال: فدنَوْتُ منه حتَّى قعَدْتُ بينَ يديه وهو يُحدِّثُ النَّاسَ فلمَّا سكَت وخلا قُلْتُ له: أنشُدُكَ بحقِّي لَمَا حدَّثْتَني حديثًا سمِعْتَه عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم عقَلْتَه وعلِمْتَه فقال أبو هُريرةَ: أفعَلُ، لَأُحدِّثَنَّك حديثًا حدَّثَنيه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم عقَلْتُه وعلِمْتُه ثمَّ نشَغ أبو هُريرةَ نَشغةً فمكَث قليلًا ثمَّ أفاق فقال: لَأُحَدِّثَنَّك حديثًا حدَّثنيه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم وأنا وهو في هذا البيتِ ما معنا أحدٌ غيري وغيرُه ثمَّ نشَغ أبو هُريرةَ نَشغةً أخرى فمكَث كذلك ثمَّ أفاق فمسَح عن وجهِه فقال: أفعَلُ، لَأُحَدِّثَنَّك حديثًا حدَّثنيه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم وأنا وهو في هذا البيتِ ما معه أحدٌ غيري وغيرُه ثمَّ نشَغ نشغةً شديدةً ثمَّ مال خارًّا على وجهِه واشتدَّ به طويلًا ثمَّ أفاق فقال: حدَّثني رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( أنَّ اللهَ تبارَك وتعالى إذا كان يومُ القيامةِ ينزِلُ إلى العبادِ ليقضيَ بينَهم وكلُّ أمةٍ جاثيةٌ \nفأوَّلُ مَن يدعو به رجلٌ جمَع القرآنَ ورجلٌ يُقتَلُ في سبيلِ اللهِ ورجلٌ كثيرُ المالِ فيقولُ اللهُ تبارَك وتعالى للقارئِ: ألم أُعلِّمْكَ ما أنزَلْتُ على رسولي صلَّى اللهُ عليه وسلَّم ؟ قال: بلى يا ربِّ قال: فماذا عمِلْتَ فيما علِمْتَ ؟ قال: كُنْتُ أقومُ به آناءَ اللَّيلِ وآناءَ النَّهارِ فيقولُ اللهُ تبارَك وتعالى له: كذَبْتَ وتقولُ له الملائكةُ: كذَبْتَ ويقولُ اللهُ: ",["بل أرَدْتَ أنْ يُقالَ: فلانٌ قارئٌ فقد قيل ذاك",1]," \nويُؤتَى بصاحبِ المالِ فيقولُ اللهُ له: ألم أُوسِّعْ عليك حتَّى لم أدَعْكَ تحتاجُ إلى أحدٍ ؟ قال: بلى يا ربِّ قال: فماذا عمِلْتَ فيما آتَيْتُك ؟ قال: كُنْتُ أصِلُ الرَّحِمَ وأتصدَّقُ ؟ فيقولُ اللهُ له: كذَبْتَ وتقولُ الملائكةُ له: كذَبْتَ ويقولُ اللهُ: بل إنَّما أرَدْتَ أنْ يُقالَ: فلانٌ جَوَادٌ فقد قيل ذاك \nويُؤتَى بالَّذي قُتِل في سبيلِ اللهِ فيُقالُ له: في ماذا قُتِلْتَ ؟ فيقولُ: أُمِرْتُ بالجهادِ في سبيلِك فقاتَلْتُ حتَّى قُتِلْتُ فيقولُ اللهُ له: كذَبْتَ وتقولُ له الملائكةُ: كذَبْتَ ويقولُ اللهُ: بل أرَدْتَ أنْ يُقالَ: فلانٌ جريءٌ فقد قيل ذاك ) ثمَّ ضرَب رسولُ اللهِ صلَّى اللهُ عليه وسلَّم رُكبتي فقال: ( يا أبا هُريرةَ ",["أولئك الثَّلاثةُ أوَّلُ خلقِ اللهِ تُسعَّرُ بهم النَّارُ يومَ القيامةِ",2]," ) \nقال الوليدُ بنُ أبي الوليدِ: فأخبَرني عقبةُ أنَّ شُفَيًّا هو الَّذي دخَل على معاويةَ فأخبَره بهذا الخبرِ \nقال أبو عثمانَ الوليدُ: وحدَّثني العلاءُ بنُ أبي حكيمٍ أنَّه كان سيَّافًا لمعاويةَ قال: فدخَل عليه رجلٌ فحدَّثه بهذا عن أبي هُريرةَ فقال معاويةُ: قد فُعِل بهؤلاء مِثلُ هذا فكيف بِمَن بقي مِن النَّاسِ ؟ ثمَّ بكى معاويةُ بكاءً شديدًا حتَّى ظنَنَّا أنَّه هالكٌ وقُلْنا: قد جاءنا هذا الرَّجلُ بِشَرٍّ ثمَّ أفاق معاويةُ ومسَح عن وجهِه فقال: صدَق اللهُ ورسولُه {مَنْ كَانَ يُرِيدُ الْحَيَاةَ الدُّنْيَا وَزِينَتَهَا نُوَفِّ إِلَيْهِمْ أَعْمَالَهُمْ فِيهَا وَهُمْ فِيهَا لَا يُبْخَسُونَ * أُولَئِكَ الَّذِينَ لَيْسَ لَهُمْ فِي الْآخِرَةِ إِلَّا النَّارُ وَحَبِطَ مَا صَنَعُوا فِيهَا وَبَاطِلٌ مَا كَانُوا يَعْمَلُونَ} [هود: 15، 16]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (408) واللفظ له، ومسلم (1905) بنحوه مختصرا، والترمذي (2382) بنحوه.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"tBU37SCj","merged":4,"otherRefs":["تاريخ الإسلام 7/102 (صحيح)","المستدرك على الصحيحين 2560 (صحيح)","صحيح النسائي 3137 (صحيح)"]},{"id":"س-05489","fp":"88f398373f8a","stateId":736,"easy":"إذا قاتلت ليُقال جريء ← تكون من أول من تُسعّر بهم النار","cause":"بل أرَدْتَ أنْ يُقالَ: فلانٌ جريءٌ فقد قيل ذاك","result":"أولئك الثَّلاثةُ أوَّلُ خلقِ اللهِ تُسعَّرُ بهم النَّارُ يومَ القيامةِ","explicit":true,"otherNeedIds":[52],"ref":"تخريج صحيح ابن حبان 408","srcLabel":"مسلم","text":["أنَّه دخَل مسجدَ المدينةِ فإذا هو برجلٍ قد اجتمَع عليه النَّاسُ فقال: مَن هذا ؟ قالوا: أبو هُريرةَ قال: فدنَوْتُ منه حتَّى قعَدْتُ بينَ يديه وهو يُحدِّثُ النَّاسَ فلمَّا سكَت وخلا قُلْتُ له: أنشُدُكَ بحقِّي لَمَا حدَّثْتَني حديثًا سمِعْتَه عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم عقَلْتَه وعلِمْتَه فقال أبو هُريرةَ: أفعَلُ، لَأُحدِّثَنَّك حديثًا حدَّثَنيه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم عقَلْتُه وعلِمْتُه ثمَّ نشَغ أبو هُريرةَ نَشغةً فمكَث قليلًا ثمَّ أفاق فقال: لَأُحَدِّثَنَّك حديثًا حدَّثنيه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم وأنا وهو في هذا البيتِ ما معنا أحدٌ غيري وغيرُه ثمَّ نشَغ أبو هُريرةَ نَشغةً أخرى فمكَث كذلك ثمَّ أفاق فمسَح عن وجهِه فقال: أفعَلُ، لَأُحَدِّثَنَّك حديثًا حدَّثنيه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم وأنا وهو في هذا البيتِ ما معه أحدٌ غيري وغيرُه ثمَّ نشَغ نشغةً شديدةً ثمَّ مال خارًّا على وجهِه واشتدَّ به طويلًا ثمَّ أفاق فقال: حدَّثني رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( أنَّ اللهَ تبارَك وتعالى إذا كان يومُ القيامةِ ينزِلُ إلى العبادِ ليقضيَ بينَهم وكلُّ أمةٍ جاثيةٌ \nفأوَّلُ مَن يدعو به رجلٌ جمَع القرآنَ ورجلٌ يُقتَلُ في سبيلِ اللهِ ورجلٌ كثيرُ المالِ فيقولُ اللهُ تبارَك وتعالى للقارئِ: ألم أُعلِّمْكَ ما أنزَلْتُ على رسولي صلَّى اللهُ عليه وسلَّم ؟ قال: بلى يا ربِّ قال: فماذا عمِلْتَ فيما علِمْتَ ؟ قال: كُنْتُ أقومُ به آناءَ اللَّيلِ وآناءَ النَّهارِ فيقولُ اللهُ تبارَك وتعالى له: كذَبْتَ وتقولُ له الملائكةُ: كذَبْتَ ويقولُ اللهُ: بل أرَدْتَ أنْ يُقالَ: فلانٌ قارئٌ فقد قيل ذاك \nويُؤتَى بصاحبِ المالِ فيقولُ اللهُ له: ألم أُوسِّعْ عليك حتَّى لم أدَعْكَ تحتاجُ إلى أحدٍ ؟ قال: بلى يا ربِّ قال: فماذا عمِلْتَ فيما آتَيْتُك ؟ قال: كُنْتُ أصِلُ الرَّحِمَ وأتصدَّقُ ؟ فيقولُ اللهُ له: كذَبْتَ وتقولُ الملائكةُ له: كذَبْتَ ويقولُ اللهُ: بل إنَّما أرَدْتَ أنْ يُقالَ: فلانٌ جَوَادٌ فقد قيل ذاك \nويُؤتَى بالَّذي قُتِل في سبيلِ اللهِ فيُقالُ له: في ماذا قُتِلْتَ ؟ فيقولُ: أُمِرْتُ بالجهادِ في سبيلِك فقاتَلْتُ حتَّى قُتِلْتُ فيقولُ اللهُ له: كذَبْتَ وتقولُ له الملائكةُ: كذَبْتَ ويقولُ اللهُ: ",["بل أرَدْتَ أنْ يُقالَ: فلانٌ جريءٌ فقد قيل ذاك",1]," ) ثمَّ ضرَب رسولُ اللهِ صلَّى اللهُ عليه وسلَّم رُكبتي فقال: ( يا أبا هُريرةَ ",["أولئك الثَّلاثةُ أوَّلُ خلقِ اللهِ تُسعَّرُ بهم النَّارُ يومَ القيامةِ",2]," ) \nقال الوليدُ بنُ أبي الوليدِ: فأخبَرني عقبةُ أنَّ شُفَيًّا هو الَّذي دخَل على معاويةَ فأخبَره بهذا الخبرِ \nقال أبو عثمانَ الوليدُ: وحدَّثني العلاءُ بنُ أبي حكيمٍ أنَّه كان سيَّافًا لمعاويةَ قال: فدخَل عليه رجلٌ فحدَّثه بهذا عن أبي هُريرةَ فقال معاويةُ: قد فُعِل بهؤلاء مِثلُ هذا فكيف بِمَن بقي مِن النَّاسِ ؟ ثمَّ بكى معاويةُ بكاءً شديدًا حتَّى ظنَنَّا أنَّه هالكٌ وقُلْنا: قد جاءنا هذا الرَّجلُ بِشَرٍّ ثمَّ أفاق معاويةُ ومسَح عن وجهِه فقال: صدَق اللهُ ورسولُه {مَنْ كَانَ يُرِيدُ الْحَيَاةَ الدُّنْيَا وَزِينَتَهَا نُوَفِّ إِلَيْهِمْ أَعْمَالَهُمْ فِيهَا وَهُمْ فِيهَا لَا يُبْخَسُونَ * أُولَئِكَ الَّذِينَ لَيْسَ لَهُمْ فِي الْآخِرَةِ إِلَّا النَّارُ وَحَبِطَ مَا صَنَعُوا فِيهَا وَبَاطِلٌ مَا كَانُوا يَعْمَلُونَ} [هود: 15، 16]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (408) واللفظ له، ومسلم (1905) بنحوه مختصرا، والترمذي (2382) بنحوه.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"tBU37SCj","merged":4,"otherRefs":["تاريخ الإسلام 7/102 (صحيح)","المستدرك على الصحيحين 2560 (صحيح)","صحيح النسائي 3137 (صحيح)"]},{"id":"س-05479","fp":"ecf1965fb613","stateId":736,"easy":"إذا قمت بمسلم مقام رياء وسمعة ← يقوم الله بك مقام رياء وسمعة يوم القيامة","cause":"و من قام برجلٍ مسلمٍ مقامَ رياءٍ و سُمعةٍ","result":"فإنَّ اللهَ يقوم به مَقامَ رياءٍ و سُمعةٍ يومَ القيامةِ","explicit":true,"otherNeedIds":[44],"ref":"صحيح الأدب المفرد 179","srcLabel":"البخاري","text":["من أكل بمسلمٍ أكلةً فإنَّ اللهَ يُطعِمُه مثلَها من جهنَّمَ ، و من كسى برجلٍ مسلمٍ ، فإنَّ اللهَ عزَّ وجلَّ يكسوه من جهنَّمَ ، ",["و من قام برجلٍ مسلمٍ مقامَ رياءٍ و سُمعةٍ",1]," ؛ ",["فإنَّ اللهَ يقوم به مَقامَ رياءٍ و سُمعةٍ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"المستورد بن شداد","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4881)، وأحمد (18011) باختلاف يسير، والبخاري في ((الأدب المفرد)) (240) واللفظ له.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"q49Z61vr"},{"id":"س-05519","fp":"742b3a65bba4","stateId":736,"easy":"إذا تعلمت العلم لتباهي أو تماري أو تصرف الوجوه إليك ← فأنت في النار","cause":"مَن تَعلَّمَ العِلمَ ليُباهيَ به العُلَماءَ، أو ليُمارِيَ به السُّفَهاءَ، أو ليَصرِفَ به وُجوهَ النَّاسِ إليه","result":"فهو في النَّارِ","explicit":true,"similar":["س-02956","س-04268","س-05517","س-05518","س-03068"],"ref":"الأحاديث المختارة 2480","srcLabel":"متفق عليه","text":["«",["مَن تَعلَّمَ العِلمَ ليُباهيَ به العُلَماءَ، أو ليُمارِيَ به السُّفَهاءَ، أو ليَصرِفَ به وُجوهَ النَّاسِ إليه؛ ",1],["فهو في النَّارِ»",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الرياء والسمعة","dorar":"FKG4Hr1q"},{"id":"س-03046","fp":"7b897af79920","stateId":736,"easy":"إذا قرأت القرآن رياءً ← يقال يوم القيامة: اذهبوا به إلى النار","cause":"ربِّ علَّمْتَني الكتابَ، فقَرَأتُه آناءَ اللَّيلِ والنَّهارِ رجاءَ ثَوابِكَ، فيُقالُ: كَذَبْتَ إنَّما كنتَ تُصلِّي؛ ليُقالَ: إنَّكَ قارئٌ مُصَلٍّ، وقد قيلَ","result":"اذهبوا به إلى النَّارِ","explicit":true,"otherNeedIds":[52],"ref":"المستدرك على الصحيحين 2564","srcLabel":"مسلم","text":["أَوَّلُ النَّاسِ يَدخُلُ النَّارَ يومَ القيامةِ ثلاثةُ نَفَرٍ، يُؤتى بالرَّجلِ -أوْ قالَ: بأَحَدِهِم- فيقولُ: ",["ربِّ علَّمْتَني الكتابَ، فقَرَأتُه آناءَ اللَّيلِ والنَّهارِ رجاءَ ثَوابِكَ، فيُقالُ: كَذَبْتَ إنَّما كنتَ تُصلِّي؛ ليُقالَ: إنَّكَ قارئٌ مُصَلٍّ، وقد قيلَ",1],"، ",["اذهبوا به إلى النَّارِ",2],"، ثُمَّ يُؤتى بآخَرَ، فيقولُ ربِّ رزَقَتْنَي مالًا، فوَصَلتُ به الرَّحِمَ، وتَصدَّقتُ به على المساكينِ، وحَملْتُ ابنَ السبَّيلِ رَجاءَ ثَوابِكَ وجنَّتِكَ، فيُقالُ: كذَبْتَ، إنَّما كنتَ تَتصدَّقُ وتَصِلُ؛ ليُقالَ: إنَّه سَمْحٌ جَوادٌ، وقد قيلَ، اذهبوا به إلى النَّارِ، ثُمَّ يُجاءُ بالثَّالثِ فيقولُ: ربِّ، خَرجْتُ في سبيلِكَ، فقاتَلْتُ فيكَ حتَّى قُتِلتُ مُقبِلًا غيرَ مُدبِرٍ رجاءَ ثوابِكَ وجنَّتِكَ، فيُقالُ: كذَبْتَ، إنَّما كنتَ تُقاتلُ؛ ليُقالَ: إنَّكَ جريءٌ شُجاعٌ، وقد قيلَ، اذهبوا به إلى النَّارِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه مسلم (1905)، والنسائي (3137) بلفظ مقارب، والترمذي (2382) مطولا.","bab":"إيمان › الوعيد","dorar":"koMuDrs4"},{"id":"س-03047","fp":"39fb5cde84a7","stateId":736,"easy":"إذا أنفقت مالك رياءً ← يقال: اذهبوا به إلى النار","cause":"ربِّ رزَقَتْنَي مالًا، فوَصَلتُ به الرَّحِمَ، وتَصدَّقتُ به على المساكينِ، وحَملْتُ ابنَ السبَّيلِ رَجاءَ ثَوابِكَ وجنَّتِكَ، فيُقالُ: كذَبْتَ، إنَّما كنتَ تَتصدَّقُ وتَصِلُ؛ ليُقالَ: إنَّه سَمْحٌ جَوادٌ، وقد قيلَ","result":"اذهبوا به إلى النَّارِ","explicit":true,"otherNeedIds":[52],"ref":"المستدرك على الصحيحين 2564","srcLabel":"مسلم","text":["أَوَّلُ النَّاسِ يَدخُلُ النَّارَ يومَ القيامةِ ثلاثةُ نَفَرٍ، يُؤتى بالرَّجلِ -أوْ قالَ: بأَحَدِهِم- فيقولُ: ربِّ علَّمْتَني الكتابَ، فقَرَأتُه آناءَ اللَّيلِ والنَّهارِ رجاءَ ثَوابِكَ، فيُقالُ: كَذَبْتَ إنَّما كنتَ تُصلِّي؛ ليُقالَ: إنَّكَ قارئٌ مُصَلٍّ، وقد قيلَ، اذهبوا به إلى النَّارِ، ثُمَّ يُؤتى بآخَرَ، فيقولُ ",["ربِّ رزَقَتْنَي مالًا، فوَصَلتُ به الرَّحِمَ، وتَصدَّقتُ به على المساكينِ، وحَملْتُ ابنَ السبَّيلِ رَجاءَ ثَوابِكَ وجنَّتِكَ، فيُقالُ: كذَبْتَ، إنَّما كنتَ تَتصدَّقُ وتَصِلُ؛ ليُقالَ: إنَّه سَمْحٌ جَوادٌ، وقد قيلَ",1],"، ",["اذهبوا به إلى النَّارِ",2],"، ثُمَّ يُجاءُ بالثَّالثِ فيقولُ: ربِّ، خَرجْتُ في سبيلِكَ، فقاتَلْتُ فيكَ حتَّى قُتِلتُ مُقبِلًا غيرَ مُدبِرٍ رجاءَ ثوابِكَ وجنَّتِكَ، فيُقالُ: كذَبْتَ، إنَّما كنتَ تُقاتلُ؛ ليُقالَ: إنَّكَ جريءٌ شُجاعٌ، وقد قيلَ، اذهبوا به إلى النَّارِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه مسلم (1905)، والنسائي (3137) بلفظ مقارب، والترمذي (2382) مطولا.","bab":"إيمان › الوعيد","dorar":"koMuDrs4"},{"id":"س-03048","fp":"69defb52fceb","stateId":736,"easy":"إذا قاتلت رياءً ← يقال: اذهبوا به إلى النار","cause":"ربِّ، خَرجْتُ في سبيلِكَ، فقاتَلْتُ فيكَ حتَّى قُتِلتُ مُقبِلًا غيرَ مُدبِرٍ رجاءَ ثوابِكَ وجنَّتِكَ، فيُقالُ: كذَبْتَ، إنَّما كنتَ تُقاتلُ؛ ليُقالَ: إنَّكَ جريءٌ شُجاعٌ، وقد قيلَ","result":"اذهبوا به إلى النَّارِ","explicit":true,"otherNeedIds":[52],"ref":"المستدرك على الصحيحين 2564","srcLabel":"مسلم","text":["أَوَّلُ النَّاسِ يَدخُلُ النَّارَ يومَ القيامةِ ثلاثةُ نَفَرٍ، يُؤتى بالرَّجلِ -أوْ قالَ: بأَحَدِهِم- فيقولُ: ربِّ علَّمْتَني الكتابَ، فقَرَأتُه آناءَ اللَّيلِ والنَّهارِ رجاءَ ثَوابِكَ، فيُقالُ: كَذَبْتَ إنَّما كنتَ تُصلِّي؛ ليُقالَ: إنَّكَ قارئٌ مُصَلٍّ، وقد قيلَ، اذهبوا به إلى النَّارِ، ثُمَّ يُؤتى بآخَرَ، فيقولُ ربِّ رزَقَتْنَي مالًا، فوَصَلتُ به الرَّحِمَ، وتَصدَّقتُ به على المساكينِ، وحَملْتُ ابنَ السبَّيلِ رَجاءَ ثَوابِكَ وجنَّتِكَ، فيُقالُ: كذَبْتَ، إنَّما كنتَ تَتصدَّقُ وتَصِلُ؛ ليُقالَ: إنَّه سَمْحٌ جَوادٌ، وقد قيلَ، اذهبوا به إلى النَّارِ، ثُمَّ يُجاءُ بالثَّالثِ فيقولُ: ",["ربِّ، خَرجْتُ في سبيلِكَ، فقاتَلْتُ فيكَ حتَّى قُتِلتُ مُقبِلًا غيرَ مُدبِرٍ رجاءَ ثوابِكَ وجنَّتِكَ، فيُقالُ: كذَبْتَ، إنَّما كنتَ تُقاتلُ؛ ليُقالَ: إنَّكَ جريءٌ شُجاعٌ، وقد قيلَ",1],"، ",["اذهبوا به إلى النَّارِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه مسلم (1905)، والنسائي (3137) بلفظ مقارب، والترمذي (2382) مطولا.","bab":"إيمان › الوعيد","dorar":"koMuDrs4"},{"id":"ق-0197","fp":"68667cd55c6d","stateId":736,"easy":"الفرح بالباطل وحبّ الحمد بما لم يُفعل ← لا مفازة من العذاب وعذاب أليم","cause":"الفرح بالباطل وحبّ الحمد بما لم يُفعل","result":"لا مفازة من العذاب وعذاب أليم","explicit":true,"ref":"سورة آل عمران: 188","srcLabel":"القرآن الكريم","quran":{"s":3,"from":188,"to":188,"text":"لَا تَحْسَبَنَّ الَّذِينَ يَفْرَحُونَ بِمَا أَتَوْا وَيُحِبُّونَ أَنْ يُحْمَدُوا بِمَا لَمْ يَفْعَلُوا فَلَا تَحْسَبَنَّهُمْ بِمَفَازَةٍ مِنَ الْعَذَابِ وَلَهُمْ عَذَابٌ أَلِيمٌ (188)","hl":[[0,177,1]]}},{"id":"س-04424","fp":"415569af562f","stateId":736,"easy":"إذا طلبت العلم وقرأت القرآن ليُقال عالم أو قارئ ← تكون من أول من تُسعّر بهم النار","cause":"الذي طلب العلمَ وقرأ القرآنَ لغيرِ اللهِ ليقالَ: هو عالمٌ، ولِيقالَ له: قارئٌ","result":"إن أولَ مَن تُسعَّرُ بهم النارُ","explicit":true,"repOf":"س-05487","otherNeedIds":[52],"ref":"مجموع فتاوى ابن باز 307/2","text":["[",["إن أولَ مَن تُسعَّرُ بهم النارُ",2]," ثلاثةٌ: منهم: ",["الذي طلب العلمَ وقرأ القرآنَ لغيرِ اللهِ ليقالَ: هو عالمٌ، ولِيقالَ له: قارئٌ",1],"]"],"grade":"صحيح","muhaddith":"صحيح","bab":"جهاد › النية في القتال والغزو","dorar":"0ud2Xe3H","merged":2,"otherRefs":["زاد المعاد 3/80 (صحيح)"]},{"id":"س-02956","fp":"91891553effb","stateId":736,"easy":"إذا تعلمت العلم لتباهي العلماء أو تماري السفهاء أو تصرف الوجوه إليك ← فالنار النار","cause":"لا تَتعلَّموا العِلمَ لتُباهوا بِهِ العُلَماءَ، أو لتُماروا بِهِ السُّفَهاءَ، ولا لتَخيَّروا بِهِ المجالِسَ","result":"فمن فعلَ ذلك فالنَّارَ النَّارَ","explicit":true,"repOf":"س-05519","ref":"المصابيح في الأحاديث المتواترة 623","text":[["لا تَتعلَّموا العِلمَ لتُباهوا بِهِ العُلَماءَ، أو لتُماروا بِهِ السُّفَهاءَ، ولا لتَخيَّروا بِهِ المجالِسَ",1]," ",["فمن فعلَ ذلك فالنَّارَ النَّارَ",2]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"إيمان › الوعيد","dorar":"n9XBBvpi"},{"id":"س-04268","fp":"a72d1ff73254","stateId":736,"easy":"إذا تعلمت العلم للمباهاة أو المماراة أو صرف الوجوه ← يدخلك الله النار","cause":"مَنْ تعلَّمَ العلْمَ ليُباهِيَ بِهِ العلماءَ ، أوْ يُمارِيَ بِهِ السفهاءَ ، أوْ يصرِفَ بِهِ وجوهَ الناسِ إليه","result":"أدخَلَهُ اللهُ جهنَّمَ","explicit":true,"repOf":"س-05519","ref":"صحيح الجامع 6158","text":[["مَنْ تعلَّمَ العلْمَ ليُباهِيَ بِهِ العلماءَ ، أوْ يُمارِيَ بِهِ السفهاءَ ، أوْ يصرِفَ بِهِ وجوهَ الناسِ إليه ، ",1],["أدخَلَهُ اللهُ جهنَّمَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3664)، وأحمد (8457) بمعناه، وابن ماجه (260) باختلاف يسير.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"S9oVj6Om"},{"id":"س-05484","fp":"5c1ca2886544","stateId":736,"easy":"إذا ربطت الخيل رياءً وسمعة وفرحاً ومرحاً ← يكون شبعها وجوعها وريها وظمؤها خسراناً في ميزانك","cause":"ومَن ربَطَها رِياءً، وسُمْعةً، وفَرَحًا، ومَرَحًا","result":"فإنَّ شِبَعَها، وجوعَها، ورِيَّها، وظَمَأَها، وأَرْواثَها، وأَبْوالَها خُسْرانٌ في مَوازينِهِ يومَ القِيامَةِ","explicit":true,"ref":"تخريج المسند لشعيب 27574","srcLabel":"أحمد","text":["الخَيْلُ في نَواصِيها الخَيْرُ مَعْقودٌ أبَدًا إلى يومِ القيامَةِ، فمَنْ ربَطَها عُدَّةً في سَبيلِ اللهِ، وأنْفَقَ عليها احتِسابًا في سبيلِ اللهِ، فإنَّ شِبَعَها وجُوعَها، ورِيَّها، وظَمَأَها، وأَرْواثَها، وأبْوالَها فَلاحٌ في مَوازينِهِ يومَ القِيامةِ، ",["ومَن ربَطَها رِياءً، وسُمْعةً، وفَرَحًا، ومَرَحًا، ",1],["فإنَّ شِبَعَها، وجوعَها، ورِيَّها، وظَمَأَها، وأَرْواثَها، وأَبْوالَها خُسْرانٌ في مَوازينِهِ يومَ القِيامَةِ",2],"."],"grade":"صحيح","narrator":"أسماء بنت يزيد أم سلمة الأنصارية","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (27574) واللفظ له، وابن أبي شيبة (34172) مختصراً، وعبد بن حميد (1581) باختلاف يسير","bab":"رقائق وزهد › الرياء والسمعة","dorar":"gWcCzVJy"},{"id":"س-05493","fp":"e05e55e1508f","stateId":736,"easy":"إذا قاتلت مرائياً مكاثراً ← يبعثك الله مرائياً مكاثراً","cause":"وإنْ قاتلْتَ مُرائيًا مُكاثِرًا","result":"بَعَثَكَ اللهُ مُرائيًا مُكاثِرًا","explicit":true,"otherNeedIds":[52],"ref":"المستدرك على الصحيحين 2565","srcLabel":"أبو داود","text":["يا رسولَ اللهِ، أَخبِرني عنِ الجهادِ والغَزْوِ، فقالَ: يا عبدَ اللهِ بنَ عَمرٍو، إنْ قَاتلْتَ صابِرًا مُحتسِبًا؛ بَعَثَكَ اللهُ صابِرًا مُحتسِبًا، ",["وإنْ قاتلْتَ مُرائيًا مُكاثِرًا",1],"؛ ",["بَعَثَكَ اللهُ مُرائيًا مُكاثِرًا",2],"، يا عبدَ اللهِ بنَ عَمرٍو، على أَيِّ حالٍ قاتلْتَ أوْ قُتِلتَ؛ بَعَثَكَ اللهُ على تلك الحالِ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داود (2519)، والبيهقي (18588) كلاهما باختلاف يسير، وابن أبي الدنيا في ((محاسبة النفس)) (62) ببعض لفظه.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"f6sMT1kR"},{"id":"س-05511","fp":"ea8632dde2ff","stateId":736,"easy":"إذا راءيت بشيء من عملك في الدنيا ← يكلك الله إليه يوم القيامة","cause":"مَن رايا بشَيءٍ في الدُّنيا مِن عَمَلِه","result":"وَكَلَه اللهُ إليه يَومَ القيامةِ","explicit":true,"otherNeedIds":[52],"ref":"الترغيب والترهيب 1/50","srcLabel":"الترغيب والترهيب","text":["عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهما قالَ: ",["مَن رايا بشَيءٍ في الدُّنيا مِن عَمَلِه ",1],["وَكَلَه اللهُ إليه يَومَ القيامةِ",2],"، وقال: انظُرْ هل يُغني عنكَ شَيئًا."],"grade":"صحيح","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","bab":"رقائق وزهد › الرياء والسمعة","dorar":"4udUAISU"},{"id":"س-05517","fp":"5b3fb2210ce8","stateId":736,"easy":"إذا ابتغيت العلم لتباهي العلماء أو تماري السفهاء أو تُقبل الوجوه عليك ← فإلى النار","cause":"مَنِ ابْتَغَى العِلْمَ لِيُباهيَ به العُلَماءَ، أَوْ يُماريَ به السُّفَهاءَ، أَوْ يُقْبلَ أفْئِدةَ النَّاسِ إليهِ","result":"فَإلى النَّارِ","explicit":true,"repOf":"س-05519","ref":"المستدرك على الصحيحين 296","text":["«",["مَنِ ابْتَغَى العِلْمَ لِيُباهيَ به العُلَماءَ، أَوْ يُماريَ به السُّفَهاءَ، أَوْ يُقْبلَ أفْئِدةَ النَّاسِ إليهِ، ",1],["فَإلى النَّارِ»",2],"."],"grade":"صحيح","narrator":"كعب بن مالك","muhaddith":"[إسناده صحيح] لم يخرج الشيخان لإسحاق بن يحيى شيئا، وإنما جعلته شاهدا لما قدمت من شرطهما","takhrij":"أخرجه الطبراني (19/ 100) (199)، وابن أبي الدنيا في ((ذم الغيبة والنميمة)) (3)، وابن عدي في ((الكامل)) (1/ 541) باختلاف يسير.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"Jryb5cQl"},{"id":"س-05518","fp":"9597a5221b41","stateId":736,"easy":"إذا تعلمت العلم لتباهي به أو تماري أو تتخير المجالس ← فالنار النار","cause":"لا تَعَلَّموا العِلْم لِتُباهوا به العُلَماءَ أو تُماروا به السُّفَهاءَ، ولا لِتُحَبِّروا به المَجْلِسَ","result":"فَمَنْ فَعَلَ ذلك فالنَّارُ النَّارُ","explicit":true,"repOf":"س-05519","ref":"المستدرك على الصحيحين 293","text":["«",["لا تَعَلَّموا العِلْم لِتُباهوا به العُلَماءَ أو تُماروا به السُّفَهاءَ، ولا لِتُحَبِّروا به المَجْلِسَ",1],"؛ ",["فَمَنْ فَعَلَ ذلك فالنَّارُ النَّارُ",2],"»."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[إسناده صحيح]","bab":"رقائق وزهد › الرياء والسمعة","dorar":"1ZbVtuPG"},{"id":"س-05520","fp":"9f57c8a5a096","stateId":736,"easy":"إذا قرأت القرآن رياءً ← فلك في جهنم وادٍ تستعيذ منه جهنم كل يوم","cause":"للقُرَّاءِ المُرائينَ","result":"إنَّ في جهنَّمَ واديًا تستعيذُ منه كُلَّ يومٍ سبعينَ مرَّةً، أعدَّه اللهُ","explicit":true,"ref":"المصابيح في الأحاديث المتواترة 600","srcLabel":"المصابيح في الأحاديث المتواترة","text":[["إنَّ في جهنَّمَ واديًا تستعيذُ منه كُلَّ يومٍ سبعينَ مرَّةً، أعدَّه اللهُ",2]," ",["للقُرَّاءِ المُرائينَ",1]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"رقائق وزهد › الرياء والسمعة","dorar":"X7921jLv"},{"id":"س-05500","fp":"eb6e9a4d23b2","stateId":736,"easy":"إذا تعلمت علماً لغير الله أو أردت به غير الله ← فتبوأ مقعدك من النار","cause":"مَنْ تَعَلَّمَ عِلْمًا لغيرِ اللهِ ، أوْ أرادَ بهِ غيرَ اللهِ","result":"فَلْيَتَبَوَّأْ مَقْعَدَهُ مِنَ النارِ","explicit":true,"ref":"سنن الترمذي 2655","srcLabel":"الترمذي","text":[["مَنْ تَعَلَّمَ عِلْمًا لغيرِ اللهِ ، أوْ أرادَ بهِ غيرَ اللهِ ، ",1],["فَلْيَتَبَوَّأْ مَقْعَدَهُ مِنَ النارِ",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن غريب لا نعرفه من حديث أيوب غلا من هذا الوجه","takhrij":"أخرجه الترمذي (2655)، والنسائي في ((السنن الكبرى)) (5910)","bab":"رقائق وزهد › الرياء والسمعة","dorar":"kpMp7GcY","merged":2,"otherRefs":["أحاديث معلة 241 (حسن)"]},{"id":"س-03068","fp":"5590608abc6f","stateId":736,"easy":"إذا تعلمت العلم للمباهاة أو المماراة أو لتصرف الوجوه إليك ← ففي النار","cause":"لا تَعلَّموا العِلمَ لتباهوا بهِ العلماءَ أو لتُماروا بهِ السُّفَهاءَ أو لتصرِفوا وجوهَ النَّاسِ إليكم","result":"فمَن فعلَ ذلِكَ فَهوَ في النَّارِ","explicit":true,"repOf":"س-05519","ref":"صحيح ابن ماجه 210","text":[["لا تَعلَّموا العِلمَ لتباهوا بهِ العلماءَ أو لتُماروا بهِ السُّفَهاءَ أو لتصرِفوا وجوهَ النَّاسِ إليكم",1]," ",["فمَن فعلَ ذلِكَ فَهوَ في النَّارِ",2]],"grade":"حسن","narrator":"حذيفة بن اليمان","muhaddith":"حسن","takhrij":"أخرجه ابن ماجه (259) بلفظه، وابن قانع في ((معجم الصحابة)) (1/ 191)، والخطيب البغدادي في ((الجامع لأخلاق الراوي)) (21) كلاهما باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"RB09h0gH"},{"id":"س-04710","fp":"b26bfb40425e","stateId":736,"easy":"إذا عبدت الله رياءً ← يقال: لم يصعد إلي منه شيء، انطلقوا به إلى النار","cause":"وفرقةٌ تعبدُ اللهَ رياءً","result":"قال : لم يصعدْ إليَّ منه شيءٌ انطلقوا به إلى النارِ","explicit":true,"otherNeedIds":[52],"ref":"البدور السافرة 196","srcLabel":"الطبراني","text":["إذا كان آخرُ الزمانِ صارَتْ أُمتي ثلاثَ فرقٍ : فرقةٌ تعبدُ اللهَ خالصًا ، ",["وفرقةٌ تعبدُ اللهَ رياءً",1]," ، وفرقةٌ يعبدونَ اللهَ ليستأكِلوا به الناسَ ، فإذا جمعَهمُ اللهُ يومَ القيامةِ قال للذي كان يستأكلُ الناسَ : بعزَّتي وجَلالي ما أردْتَ بعبادَتي ؟ فيقولُ : وعزَّتِكَ وجلالِكَ أستأكلُ به الناسَ ، قال : لم ينفعْكَ ما جمعْتَ شيئًا تلجأُ إليه انطلِقوا به إلى النارِ ، ثم يقولُ للذي كان يعبدُ رياءً : بعزَّتي وجلالي ما أردْتَ بعبادتي ؟ قال : بعزتِكَ وجلالِكَ أردْتَ بعبادتِكَ رياءً للناسِ ",["قال : لم يصعدْ إليَّ منه شيءٌ انطلقوا به إلى النارِ",2]," ، ثم يقولُ للذي كان يعبدُهُ خالصًا ، بعزَّتي وجَلالي ما أردْتَ بعبادَتي ؟ قال : بعزتِكَ وجلالِكَ أنتَ أعلمُ بذلكَ مني أردْت به ذِكرَكَ ووجهَكَ ، قال : صدقَ عَبدي انطلِقوا به إلى الجنةِ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (5105)، والبيهقي في ((شعب الإيمان)) (6808) باختلاف يسير.","bab":"رقائق وزهد › الإخلاص","dorar":"ysnCCp7U"},{"id":"س-04711","fp":"2e7f3f577809","stateId":736,"easy":"إذا عبدت الله لتستأكل به الناس ← يقال: لم ينفعك ما جمعت، انطلقوا به إلى النار","cause":"وفرقةٌ يعبدونَ اللهَ ليستأكِلوا به الناسَ","result":"قال : لم ينفعْكَ ما جمعْتَ شيئًا تلجأُ إليه انطلِقوا به إلى النارِ","explicit":true,"ref":"البدور السافرة 196","srcLabel":"الطبراني","text":["إذا كان آخرُ الزمانِ صارَتْ أُمتي ثلاثَ فرقٍ : فرقةٌ تعبدُ اللهَ خالصًا ، وفرقةٌ تعبدُ اللهَ رياءً ، ",["وفرقةٌ يعبدونَ اللهَ ليستأكِلوا به الناسَ",1]," ، فإذا جمعَهمُ اللهُ يومَ القيامةِ قال للذي كان يستأكلُ الناسَ : بعزَّتي وجَلالي ما أردْتَ بعبادَتي ؟ فيقولُ : وعزَّتِكَ وجلالِكَ أستأكلُ به الناسَ ، ",["قال : لم ينفعْكَ ما جمعْتَ شيئًا تلجأُ إليه انطلِقوا به إلى النارِ",2]," ، ثم يقولُ للذي كان يعبدُ رياءً : بعزَّتي وجلالي ما أردْتَ بعبادتي ؟ قال : بعزتِكَ وجلالِكَ أردْتَ بعبادتِكَ رياءً للناسِ قال : لم يصعدْ إليَّ منه شيءٌ انطلقوا به إلى النارِ ، ثم يقولُ للذي كان يعبدُهُ خالصًا ، بعزَّتي وجَلالي ما أردْتَ بعبادَتي ؟ قال : بعزتِكَ وجلالِكَ أنتَ أعلمُ بذلكَ مني أردْت به ذِكرَكَ ووجهَكَ ، قال : صدقَ عَبدي انطلِقوا به إلى الجنةِ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (5105)، والبيهقي في ((شعب الإيمان)) (6808) باختلاف يسير.","bab":"رقائق وزهد › الإخلاص","dorar":"ysnCCp7U"},{"id":"س-05295","fp":"bda250c30f87","stateId":736,"easy":"إذا خطبت رياءً وسمعة ← يوقفك الله يوم القيامة موقف رياء وسمعة","cause":"مَن قامَ بخُطبةٍ لا يَلتَمِسُ بها إلَّا رياءً وسُمعةً","result":"أوقَفَه اللهُ عَزَّ وجَلَّ يَومَ القيامةِ مَوقِفَ رياءٍ وسُمعةٍ","explicit":true,"ref":"تخريج المسند لشعيب 16073","srcLabel":"أحمد","text":["«",["مَن قامَ بخُطبةٍ لا يَلتَمِسُ بها إلَّا رياءً وسُمعةً ",1],["أوقَفَه اللهُ عَزَّ وجَلَّ يَومَ القيامةِ مَوقِفَ رياءٍ وسُمعةٍ»",2]],"grade":"حسن","narrator":"بشير بن عقربة","muhaddith":"إسناده حسن","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"fbq687EV"},{"id":"س-05486","fp":"9477f681bd27","stateId":736,"easy":"إذا بارزت الله بالعظائم في الخلوة وتصنّعت للناس ← يذيقك الله أليم العذاب","cause":"كُنتُمْ إذا خلوتُمْ بارزتُموني بالعَظائمِ ، وإذا لقيتُمُ النَّاسَ لقيتُموهم مُخبتينَ تراءونَ النَّاسَ بخلافِ ما تُعطوني مِن قلوبِكُم ، هبتُمُ النَّاسَ ولم تَهابوني ، وأجللتُمُ النَّاسَ ولم تجلُّوني ، وترَكْتُمْ للنَّاسِ ، ولم تترُكوني","result":"اليومَ أذيقُكُمُ أليمَ العذابِ معَ ما حُرِمتُمْ منَ الثَّوابِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[52],"ref":"الترغيب والترهيب 1/55","srcLabel":"ابن حبان","text":["يُؤمَرُ يومَ القيامةِ بناسٍ منَ النَّاسِ إلى الجنَّةِ ، حتَّى إذا دنوا منها واستَنشَقوا ريحَها ، ونظروا إلى قصورِها وما أعدَّ اللَّهُ لأَهْلِها فيها نودوا : أنِ اصرِفوهم عَنها ، لا نَصيبَ لَهُم فيها ، فيرجعونَ بحَسرةٍ ما رجعَ الأوَّلونَ بمثلِها فيقولونَ : ربَّنا ، لو أَدخلتَنا النَّارَ قبلَ أن تُريَنا ما أرَيتَنا مِن ثوابِكَ وما أعددتَ فيها لأوليائِكَ كانَ أَهْوَنَ علينا قالَ : ذاكَ أردتُ بِكُم ",["كُنتُمْ إذا خلوتُمْ بارزتُموني بالعَظائمِ ، وإذا لقيتُمُ النَّاسَ لقيتُموهم مُخبتينَ تراءونَ النَّاسَ بخلافِ ما تُعطوني مِن قلوبِكُم ، هبتُمُ النَّاسَ ولم تَهابوني ، وأجللتُمُ النَّاسَ ولم تجلُّوني ، وترَكْتُمْ للنَّاسِ ، ولم تترُكوني",1]," ",["اليومَ أذيقُكُمُ أليمَ العذابِ معَ ما حُرِمتُمْ منَ الثَّوابِ",2]],"grade":"صحيح","narrator":"عدي بن حاتم الطائي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن حبان في ((المجروحين)) (2/416)، والطبراني (17/86) (199)","bab":"رقائق وزهد › الرياء والسمعة","dorar":"jV6l9qSx"},{"id":"س-04569","fp":"0b6f41573470","stateId":737,"easy":"إذا أمرت بالمعروف ولم تأته ونهيت عن المنكر وأتيته ← تُلقى في النار فتندلق أقتابك","cause":"كُنتُ آمُرُ بالمَعروفِ ولا آتيه، وأنهى عَنِ المُنكَرِ وآتيه","result":"فيُلقى في النَّارِ، فتَندَلِقُ أقتابُ بَطنِه، فيَدورُ بها كما يَدورُ الحِمارُ بالرَّحى","explicit":true,"star":true,"ref":"صحيح مسلم 2989","srcLabel":"متفق عليه","text":["قيلَ له: ألا تَدخُلُ على عُثمانَ فتُكَلِّمَه؟ فقال: أترَونَ أنِّي لا أُكَلِّمُه إلَّا أُسمِعُكُم؟ واللَّهِ لقد كَلَّمتُه فيما بَيني وبينَه، ما دونَ أن أفتَتِحَ أمرًا لا أُحِبُّ أن أكونَ أوَّلَ مَن فتَحَه، ولا أقولُ لأحَدٍ يَكونُ عليَّ أميرًا: إنَّه خَيرُ النَّاسِ بَعدَ ما سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: يُؤتى بالرَّجُلِ يَومَ القيامةِ، ",["فيُلقى في النَّارِ، فتَندَلِقُ أقتابُ بَطنِه، فيَدورُ بها كما يَدورُ الحِمارُ بالرَّحى",2],"، فيَجتَمِعُ إليه أهلُ النَّارِ، فيَقولونَ: يا فُلانُ ما لَكَ؟ ألَم تَكُنْ تَأمُرُ بالمَعروفِ، وتَنهى عَنِ المُنكَرِ؟ فيَقولُ: بَلى، قد ",["كُنتُ آمُرُ بالمَعروفِ ولا آتيه، وأنهى عَنِ المُنكَرِ وآتيه",1],". وفي روايةٍ: كُنَّا عِندَ أُسامةَ بنِ زَيدٍ، فقال رَجُلٌ: ما يَمنَعُكَ أن تَدخُلَ على عُثمانَ فتُكَلِّمَه فيما يَصنَعُ؟ وساقَ الحَديثَ، بمِثلِه."],"grade":"صحيح","narrator":"أسامة بن زيد","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3267)، ومسلم (2989).","bab":"جهنم › صفة عذاب أهل النار","dorar":"kLnPj7dF","merged":7,"otherRefs":["صحيح الترغيب 124 (صحيح)","المستدرك على الصحيحين 7205 (صحيح)","صحيح البخاري 7098 (صحيح)","صحيح البخاري 3267 (صحيح)","صحيح الجامع 8022 (صحيح)","الفتح الرباني 6/3089 (صحيح)"]},{"id":"س-05580","fp":"4e0bf5d3cb98","stateId":737,"easy":"إذا قلت ما لا تفعل ← تُكتب شهادة في عنقك تُسأل عنها يوم القيامة","cause":"تَقولونَ ما لا تَفعَلونَ","result":"فتُكتَبُ شَهادةً في أعناقِكُم، فتُسألونَ عَنها يَومَ القيامةِ","explicit":true,"ref":"صحيح مسلم 1050","srcLabel":"متفق عليه","text":["بَعَثَ أبو موسى الأشعَريُّ إلى قُرَّاءِ أهلِ البَصرةِ، فدَخَلَ عليه ثَلاثُ مِائةِ رَجُلٍ قد قَرَؤوا القُرآنَ، فقال: أنتُم خيارُ أهلِ البَصرةِ وقُرَّاؤُهم، فاتلوه، ولا يَطولَنَّ عليكُمُ الأمَدُ فتَقسوَ قُلوبُكُم كما قَسَت قُلوبُ مَن كان قَبلَكُم، وإنَّا كُنَّا نَقرَأُ سورةً كُنَّا نُشَبِّهُها في الطُّولِ والشِّدَّةِ ببَراءةَ، فأُنسيتُها، غيرَ أنِّي قد حَفِظتُ منها: لو كان لابنِ آدَمَ واديانِ مِن مالٍ لابتَغى واديًا ثالِثًا، ولا يَملأُ جَوفَ ابنِ آدَمَ إلَّا التُّرابُ، وكُنَّا نَقرَأُ سورةً كُنَّا نُشَبِّهُها بإحدى المُسَبِّحاتِ، فأُنسيتُها، غيرَ أنِّي حَفِظتُ منها: يا أيُّها الذينَ آمَنوا لمَ ",["تَقولونَ ما لا تَفعَلونَ",1],"، ",["فتُكتَبُ شَهادةً في أعناقِكُم، فتُسألونَ عَنها يَومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"أبو الأسود الديلي","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"u65Ireta"},{"id":"س-00556","fp":"22269078cc70","stateId":737,"easy":"إذا علّمت الناس وخالفت ما تنهاهم عنه ← تُقذف في النار يوم القيامة مع علماء السوء","cause":"إنِّي كنتُ أخالِفُ ما أنهاكم عنه","result":"يُؤتى بعُلَماءِ السُّوءِ يومَ القيامةِ فيُقذَفونَ في نارِ جهنَّمَ، فيدورُ أحدُهم في نارِ جهنَّمَ بقُصْبِه كما يدورُ الحِمارُ بالرَّحى","explicit":true,"ref":"المصابيح في الأحاديث المتواترة 626","srcLabel":"المصابيح في الأحاديث المتواترة","text":[["يُؤتى بعُلَماءِ السُّوءِ يومَ القيامةِ فيُقذَفونَ في نارِ جهنَّمَ، فيدورُ أحدُهم في نارِ جهنَّمَ بقُصْبِه كما يدورُ الحِمارُ بالرَّحى",2],"، فيقالُ له: يا وَيلَك! بك اهتَدَينا، فما بالُك؟! قال: ",["إنِّي كنتُ أخالِفُ ما أنهاكم عنه",1],"، وفي بَعضِ الرِّواياتِ: (برَجُل)، وفي بعضِها: (بالأميرِ)، وفي بعضِها: (بالوالي)"],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"آداب عامة › ضرب الأمثال","dorar":"RD8d0mJv"},{"id":"س-05284","fp":"d11b6f930243","stateId":737,"easy":"إذا قلت «قد قرأنا القرآن فمن أقرأ منا؟» عجباً ← فأولئك وقود النار","cause":"يقولون: قد قرأنا القرآنَ فمن أقرأُ منَّا؟ ومن أفقَهُ منَّا، ومن أعلَمُ منَّا","result":"وأولئك هم وَقودُ النَّارِ","explicit":true,"otherNeedIds":[21],"ref":"سبل الهدى والرشاد 10/131","srcLabel":"الطبراني","text":["«يظهَرُ الدِّينُ حتى يجاوِزَ البِحارَ، وتُخاضُ البِحارُ بالخيلِ في سبيلِ اللهِ، حتى يُرَدَّ الكُفرُ إلى مَوطِنِه، وليأتينَّ على النَّاسِ زمانٌ يتعَلَّمون فيه القُرآنَ يتعلَّمونه ويقرؤونه، ثمَّ ",["يقولون: قد قرأنا القرآنَ فمن أقرأُ منَّا؟ ومن أفقَهُ منَّا، ومن أعلَمُ منَّا",1],"؟»، ثمَّ التفَتَ إلى أصحابِه، فقال: «هل في أولئك من خيرٍ؟» قالوا: لا، قال: «أولئك منكم من هذه الأمَّةِ، ",["وأولئك هم وَقودُ النَّارِ",2],"»"],"grade":"حسن","narrator":"عمر بن الخطاب","muhaddith":"رجاله ثقات","takhrij":"أخرجه البزار (283)، والطبراني في ((الأوسط)) (6242) كلاهما بلفظ مقارب.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"S9WvdyoV","merged":3,"otherRefs":["السلسلة الصحيحة 3230 (حسن)","الترغيب والترهيب 1/105 (حسن)"]},{"id":"س-07501","fp":"94eab8c91a02","stateId":737,"easy":"إذا أمرت الناس بالبر ونسيت نفسك ← تُقرض شفتك ولسانك","cause":"يَأْمُرُونَ الناسَ بالبرِّ وينسونَ أَنْفُسَهُمْ","result":"تُقْرَضُ ألسنتُهُمْ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"مجمع الزوائد 7/279","srcLabel":"أحمد","text":["أتيتُ ليلَةَ أُسْرِيَ بي علَى رِجالٍ تُقْرَضُ شِفَاهُهُم بمقاريضَ من نارٍ قلْتُ مَنْ هَؤُلَاءِ يَا جبريلُ قال هؤلاءِ خطباءُ أمتِكَ الَّذِينَ ",["يَأْمُرُونَ الناسَ بالبرِّ وينسونَ أَنْفُسَهُمْ",1]," وهم يَتْلُونَ الْكِتابَ أفَلَا يعقِلونَ وفي روايةٍ ",["تُقْرَضُ ألسنتُهُمْ",2]," بِمقَارِيضَ من نارٍ أوْ قال من حديدٍ وفي روايةٍ أتيتُ على سماءِ الدنيا ليلةَ أُسْرِيَ بي فرأَيْتُ فيها رجالًا تُقْطَعُ ألسنتُهم وشفاهُهم . . . ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أحد أسانيد أبي يعلى رجاله رجال الصحيح","takhrij":"أخرجه أحمد (13445)، وأبو يعلى (3992) واللفظ له.\n\nوالرواية: أخرجها أبو يعلى (4160)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"sMWPyD9A","merged":3,"otherRefs":["صحيح الترغيب 125 (صحيح)","السلسلة الصحيحة 291 (صحيح)"]},{"id":"س-01554","fp":"8b34441e91ee","stateId":737,"easy":"إذا اغتررت بعلمك وقلت «من خير منا» ← فأنت من وقود النار","cause":"يقولونَ : قد قرأنا ، وعلِمنا فمَن هذا الَّذي هوَ خيرٌ منَّا","result":"وأولئِكَ هُم وقودُ النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"otherNeedIds":[21],"ref":"عمدة التفسير 1/356","srcLabel":"الطبراني","text":["بينَما نحنُ بمَكَّةَ ، قامَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ منَ اللَّيلِ فَنادى هل بلَّغتُ ، اللَّهمَّ هل بلَّغتُ ، ثلاثًا ، فقامَ عمرُ بنُ الخطَّابِ فقالَ : نعَم ، ثمَّ أصبحَ ، فقالَ النبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ : ليظهَرنَّ الإسلامُ حتَّى يُردَّ الكفرَ إلى مواطنِهِ ، ولتخوضُنَّ البحارَ بالإسلامِ ، وليأتينَّ على النَّاسِ زمانٌ يتعلَّمونَ القرآنَ ويقرئونَهُ ثمَّ ",["يقولونَ : قد قرأنا ، وعلِمنا فمَن هذا الَّذي هوَ خيرٌ منَّا",1]," ، فَهَل في أولئِكَ مِن خيرٍ ؟ قالوا : يا رسولَ اللَّهِ : فمَن أولئِكَ ؟ قالَ : أولئِكَ منكُم ، ",["وأولئِكَ هُم وقودُ النَّارِ",2]],"grade":"صحيح","narrator":"لبابة بنت الحارث أم الفضل","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (12/ 250) (13019)، وابن أبي حاتم في ((تفسيره)) (3229)، والفاكهي في ((أخبار مكة)) (1899) بنحوه.","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"5S0SzdW4","merged":2,"otherRefs":["الترغيب والترهيب 1/105 (حسن)"]},{"id":"س-03632","fp":"d918c1e47436","stateId":738,"easy":"إذا ظهر الزنا والربا في قرية ← فقد أحلّوا بأنفسهم عذاب الله","cause":"إذا ظَهَرَ الزِّنا والرِّبا في قريةٍ","result":"فقد أَحَلُّوا بأنفُسِهِم عذابَ اللهِ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 2295","srcLabel":"متفق عليه","text":["نَهى رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ أنْ تُشتَرى الثَّمرةُ حتَّى تَطْعَمَ، وقال: ",["إذا ظَهَرَ الزِّنا والرِّبا في قريةٍ، ",1],["فقد أَحَلُّوا بأنفُسِهِم عذابَ اللهِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (5033) واللفظ له، والبخاري (2246)، ومسلم (1537) مختصرا","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"XxR60PPu","merged":2,"otherRefs":["الترغيب والترهيب 3/265 (حسن)"]},{"id":"س-04561","fp":"1db8089e4a20","stateId":738,"easy":"إذا شربت المسكر ← عهد على الله أن يسقيك من طينة الخبال","cause":"لمن شربَ المُسْكِرَ","result":"أن يَسقيَهُ من طينةِ الخبالِ","explicit":true,"star":true,"ref":"صحيح النسائي 5725","srcLabel":"مسلم","text":["أنَّ رجلًا مِن جَيشانَ، وجَيشانُ منَ اليمنِ، قدمَ فسألَ رسولَ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ عن شرابٍ يَشربونَهُ بأرضِهِم، منَ الذُّرةِ يقالُ لَهُ المِزرُ، فقالَ النَّبيُّ صلَّى اللَّهُ علَيهِ وسلَّمَ: أمُسكِرٌ هوَ؟، قالَ: نعَم، قالَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ: كلُّ مسكرٍ حرامٌ، إنَّ اللَّهَ عزَّ وجلَّ عَهِدَ ",["لمن شربَ المُسْكِرَ",1],"، ",["أن يَسقيَهُ من طينةِ الخبالِ",2]," قالوا: يا رسولَ اللَّهِ وما طينةُ الخبالِ؟، قالَ: عَرَقُ أَهْلِ النَّارِ أو قالَ: عُصارةُ أَهْلِ النَّارِ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه النسائي (5709) واللفظ له، وأخرجه مسلم (2002) باختلاف يسير.","bab":"جهنم › صفة عذاب أهل النار","dorar":"N32Uayp1"},{"id":"ق-0850","fp":"6a00c91c035f","stateId":738,"easy":"حب شيوع الفاحشة في المؤمنين ← عذاب أليم في الدنيا والآخرة","cause":"حب شيوع الفاحشة في المؤمنين","result":"عذاب أليم في الدنيا والآخرة","explicit":true,"star":true,"otherNeedIds":[61],"ref":"سورة النور: 19","srcLabel":"القرآن الكريم","quran":{"s":24,"from":19,"to":19,"text":"إِنَّ الَّذِينَ يُحِبُّونَ أَنْ تَشِيعَ الْفَاحِشَةُ فِي الَّذِينَ آمَنُوا لَهُمْ عَذَابٌ أَلِيمٌ فِي الدُّنْيَا وَالْآخِرَةِ وَاللَّهُ يَعْلَمُ وَأَنْتُمْ لَا تَعْلَمُونَ (19)","hl":[[0,171,1]]}},{"id":"ق-0991","fp":"c3949d0fff6e","stateId":738,"easy":"الفاحشة ممن له مكانة وقدوة ← مضاعفة العذاب","cause":"الفاحشة ممن له مكانة وقدوة","result":"مضاعفة العذاب","explicit":true,"ref":"سورة الأحزاب: 30","srcLabel":"القرآن الكريم","quran":{"s":33,"from":30,"to":30,"text":"يَا نِسَاءَ النَّبِيِّ مَنْ يَأْتِ مِنْكُنَّ بِفَاحِشَةٍ مُبَيِّنَةٍ يُضَاعَفْ لَهَا الْعَذَابُ ضِعْفَيْنِ وَكَانَ ذَلِكَ عَلَى اللَّهِ يَسِيرًا (30)","hl":[[23,144,1]]}},{"id":"س-00197","fp":"42d68565ffa2","stateId":738,"easy":"إذا فجرت ← يهديك الفجور إلى النار","cause":"الفجورِ","result":"يهدي إلى النارِ","explicit":true,"ref":"الجامع الصغير 2591","srcLabel":"ابن ماجه","text":["إِنَّما هما اثنتانِ الكلامُ والهديُ ، فأحسنُ الكلامِ كلامُ اللهِ ، وأحسنُ الهدْيِ هديُ محمدٍ ، ألَا وإيَّاكم ومحدَثاتِ الأمورِ ، فإِنَّ شرَّ الأمورِ مُحْدَثاتُها ، وكُلَّ محدَثَةٍ بدعةٌ ، وكُلَّ بِدْعَةٍ ضلالَةٌ ، ألَا لَا يَطولَنَّ عليكم الأمَدُ فتقسو قلوبُكُم ، ألَا إِنَّ كُلَّ ما هو آتٍ قريبٌ ، وإِنَّما البعيدُ ما ليس بآتٍ ، ألَا إِنَّما الشَّقِيُّ مَنْ شقِيَ في بطنِ أُمِّهِ ، والسعيدُ مَنْ وُعِظَ بِغَيْرِهِ ، ألَا إِنَّ قتالَ المؤمِنِ كفْرٌ ، وسبابَهُ فسوقٌ ، ولَا يَحِلُ لمسلِمٍ أنْ يهجُرَ أخاهُ فوقَ ثلاثٍ ، ألَا وإيَّاكم والكذبَ ، فإِنَّ الكذبَ لا يصلُحُ لَا بالجدِّ ، ولَا بالْهَزْلِ ، ولَا يعِدُ الرجلُ صَبِيَّهُ ولَا يفِي ، وإِنَّ الكذِبَ يهدِي إلى ",["الفجورِ",1]," ، وإِنَّ الفجورَ ",["يهدي إلى النارِ",2]," ، وإِنَّ الصدقَ يهدي إلى البرِ ، وإِنَّ البرَّ يهدي إلى الجنَّةِ ، وإِنَّه يقالُ للصادقِ : صدقَ وبَرَّ ، ويقالُ للكاذِبِ : كذَبَ وفجرَ ، ألَا وإِنَّ العبدَ يكذِبُ حتى يُكْتَبَ عندَ اللهِ كذابًا"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (46) واللفظ له، والطبراني (9/99) (8520) باختلاف يسير، والبيهقي في ((شعب الإيمان)) (4787) مختصراً باختلاف يسير","bab":"آداب الكلام › الصدق وما جاء فيه","dorar":"UhkJzNNf","merged":4,"otherRefs":["صحيح مسلم 2607 (صحيح)","صحيح الأدب المفرد 298 (صحيح)","المستدرك على الصحيحين 445 (صحيح)"]},{"id":"س-00557","fp":"64a0e0f16a04","stateId":738,"easy":"إذا مت مدمناً للخمر ← تلقى الله كعابد وثن","cause":"من مات مُدمِنًا الخَمرَ","result":"لَقِي اللهَ تعالى وهو كعابدِ وَثَنٍ","explicit":true,"similar":["س-03755"],"ref":"المصابيح في الأحاديث المتواترة 622","srcLabel":"المصابيح في الأحاديث المتواترة","text":[["من مات مُدمِنًا الخَمرَ ",1],["لَقِي اللهَ تعالى وهو كعابدِ وَثَنٍ",2]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"آداب عامة › ضرب الأمثال","dorar":"DNbPLnKx","merged":3,"otherRefs":["صحيح الجامع 6549 (صحيح)","البحر الزخار 11/289 (صحيح)"]},{"id":"س-02706","fp":"5aed35e25633","stateId":738,"easy":"إذا مت مدمناً للخمر ← يسقيك الله من نهر الغوطة","cause":"ومَن ماتَ مُدْمِنَ الخَمْرِ","result":"سقاهُ اللهُ مِن نَهْرِ الغُوطةِ","explicit":true,"similar":["س-04566"],"ref":"المستدرك على الصحيحين 7439","srcLabel":"أحمد","text":["ثَلاثةٌ لا يَدخُلونَ الجنَّةَ: مُدْمِنُ الخَمْرِ، وقاطِعُ الرَّحِمِ، ومُصَدِّقٌ بالسِّحْرِ، ",["ومَن ماتَ مُدْمِنَ الخَمْرِ ",1],["سقاهُ اللهُ مِن نَهْرِ الغُوطةِ",2],"، قيل: وما نَهْرُ الغُوطةِ؟ قالَ: نَهْرٌ يَخْرُجُ مِن فُروجِ المُومساتِ، يُؤذي أهْلَ النَّار رِيحُ فُرُوجِهِم."],"grade":"صحيح","narrator":"أبو موسى","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (19569)، وابن حبان (5346)، والمخلص في ((المخلصيات)) (740) جميعهم بلفظه.","bab":"إيمان › السحر والنشرة والكهانة","dorar":"Ze7ME3QW","merged":2,"otherRefs":["مجمع الزوائد 5/77 (حسن)"]},{"id":"س-03755","fp":"dc3fd26e4106","stateId":738,"easy":"إذا لقيت الله مدمناً للخمر مستحلاً لها ← تلقاه كعابد وثن","cause":"من لقِيَ اللهَ مُدمنَ خمرٍ مُستحلًّا لشربِه","result":"لقيه كعابدِ وثنٍ","explicit":true,"repOf":"س-00557","ref":"الإلمام بأحاديث الأحكام 2/770","text":[["من لقِيَ اللهَ مُدمنَ خمرٍ مُستحلًّا لشربِه ، ",1],["لقيه كعابدِ وثنٍ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[اشترط في المقدمة أنه] صحيح على طريقة بعض أهل الحديث","takhrij":"أخرجه أحمد (2453)، وعبدالرزاق (17070)، والبزار (5085) باختلاف يسير","bab":"اعتصام بالسنة › من استحل الحرام أو حرم الحلال","dorar":"XATw0oYH"},{"id":"س-04206","fp":"4215ee565a30","stateId":738,"easy":"إذا سقيت الخمر صغيراً لا يعرف حلالها من حرامها ← يسقيك الله من طينة الخبال","cause":"ومَن سَقاهُ صَغيرًا لا يَعرِفُ حَلالَه مِن حَرامِه","result":"كان حَقًّا على اللهِ أنْ يَسقيَه مِن طينةِ الخَبالِ","explicit":true,"ref":"تخريج سنن أبي داود 3680","srcLabel":"البيهقي","text":["عنِ النَّبيِّ صلَّى اللَّهُ عليه وسلَّمَ قال: كُلُّ مُخمَّرٍ خَمرٌ، وكُلُّ مُسكِرٍ حَرامٌ، ومَن شَرِبَ مُسكِرًا بُخِسَتْ صَلاتُه أربَعينَ صَباحًا، فإنْ تابَ تابَ اللهُ عليه، فإنْ عادَ الرَّابِعةَ كان حَقًّا على اللهِ أنْ يَسقيَه مِن طينةِ الخَبالِ. قيل: وما طينةُ الخَبالِ يا رَسولَ اللَّهِ؟ قال: صَديدُ أهلِ النارِ، ",["ومَن سَقاهُ صَغيرًا لا يَعرِفُ حَلالَه مِن حَرامِه، ",1],["كان حَقًّا على اللهِ أنْ يَسقيَه مِن طينةِ الخَبالِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه البيهقي (17807)","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"4Br3CQG3"},{"id":"س-04566","fp":"33989ff444a3","stateId":738,"easy":"إذا مت وأنت تشرب الخمر ← يسقيك الله من طينة الخبال","cause":"لمَن مات وهو يشربُ الخمرَ","result":"أن يسقِيَه من طينةِ الخبالِ ، قيل : يا رسولَ اللهِ وما طينةُ الخبالِ","explicit":true,"repOf":"س-02706","ref":"مجموع فتاوى ابن باز 349/19","text":["إن على اللهِ عهدًا ",["لمَن مات وهو يشربُ الخمرَ",1]," ",["أن يسقِيَه من طينةِ الخبالِ ، قيل : يا رسولَ اللهِ وما طينةُ الخبالِ ؟",2]," قال : عصارةُ أهلِ النارِ أو قال : عرقُ أهلِ النارِ"],"grade":"صحيح","muhaddith":"صحيح","bab":"جهنم › صفة عذاب أهل النار","dorar":"ztSYdnYq"},{"id":"س-05236","fp":"b217b3d3bdb3","stateId":738,"easy":"إذا شربت الخمر بعد تحريمها ← يعطشك الله يوم القيامة","cause":"من شربها بعدما حرَّمتُها","result":"لأُعطِّشَنَّه يومَ القيامةِ","explicit":true,"similar":["س-02943"],"ref":"تفسير القرآن العظيم 3/178","srcLabel":"البيهقي","text":["عن عبدِ اللهِ بنِ عمرو قال إنَّ هذه الآيةَ التي في القرآنِ  يَا أَيُّهَا الَّذِينَ آمَنُوْا إِنَّمَا الْخَمْرُ وَالْمَيْسِرُ وَالْأَنْصَابُ وَالْأَزْلَامُ رِجْسٌ مِنْ عَمَلِ الشَّيْطَانِ فَاجْتَنِبُوهُ لَعَلَّكُمْ تُفْلِحُونَ  قال هيَ في التوراةِ إنَّ اللهَ أنزل الحقَّ ليُذْهِبَ به الباطلَ ويُبْطِلَ به اللعبَ والمزاميرَ والزفنَ والكباراتِ يعني البرابطَ والزماراتِ يعني به الدُّفَّ والطنابيرَ والشِّعْرَ والخمرَ مرةً لمن طعمَها أقسم اللهُ بيمينِه وعِزَّةِ حَيْلِه ",["من شربها بعدما حرَّمتُها",1]," ",["لأُعطِّشَنَّه يومَ القيامةِ",2]," ومن تركها بعدما حرَّمتُها لأسقِيَنَّهُ إياها في حظيرةِ القدسِ"],"grade":"صحيح","narrator":"عطاء بن يسار","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي حاتم في ((تفسيره)) (6744) ، والبيهقي في ((السنن الكبرى)) (21042) بنحوه ، والخطيب البغدادي في ((المتفق والمفترق)) (1665) مطولا .","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"0dlqHhJd"},{"id":"س-01312","fp":"677be84a1958","stateId":738,"easy":"إذا قعدت على فراش امرأة غاب زوجها ← يقيّض الله لك ثعباناً يوم القيامة","cause":"من قعَدَ على فراشِ مَغِيبةٍ","result":"قَيَّض اللهُ له ثُعبانًا يومَ القيامةِ","explicit":true,"ref":"الجامع الصغير 8945","srcLabel":"أحمد","text":[["من قعَدَ على فراشِ مَغِيبةٍ ",1],["قَيَّض اللهُ له ثُعبانًا يومَ القيامةِ",2]],"grade":"حسن","narrator":"أبو قتادة الحارث بن ربعي","muhaddith":"حسن","takhrij":"أخرجه أحمد (22557) باختلاف يسير، والطبراني (3/241) (3278)، وأبو نعيم في ((معرفة الصحابة)) (2002) واللفظ لهما","bab":"نكاح › حق الزوج على المرأة","dorar":"ySIKqLN6"},{"id":"س-02943","fp":"1271e1a38283","stateId":738,"easy":"إذا شربت الخمر ← تأتي عطشان يوم القيامة","cause":"مَنْ شربَ الخمرَ","result":"أَتى عطشانَ يومَ القيامةِ","explicit":true,"repOf":"س-05236","ref":"الجامع الصغير 8748","text":[["مَنْ شربَ الخمرَ،  ",1],["أَتى عطشانَ يومَ القيامةِ",2]],"grade":"حسن","narrator":"عبدالله بن عمرو وقيس بن سعد","muhaddith":"حسن","takhrij":"أخرجه أحمد (15482)، وأبو يعلى (1436)، وابن وهب في ((الجامع)) (77) بنحوه مطولًا.","bab":"إيمان › الوعيد","dorar":"NcvC8HUC"},{"id":"س-04307","fp":"443a6de3be8c","stateId":738,"easy":"إذا حبست العنب أيام القطاف لتبيعه لمن يتخذه خمراً ← فقد تقحمت النار على بصيرة","cause":"مَن حَبَس العِنَبَ أيَّامَ القِطافِ حتَّى يَبيعَه مِن يَهوديٍّ أو نَصرانيٍّ أو مِمَّن يَتَّخِذُه خَمرًا","result":"فقد تَقَحَّم النَّارَ على بَصيرةٍ","explicit":true,"ref":"الروضة الندية 2/99","srcLabel":"ابن حبان","text":["\"",["مَن حَبَس العِنَبَ أيَّامَ القِطافِ حتَّى يَبيعَه مِن يَهوديٍّ أو نَصرانيٍّ أو مِمَّن يَتَّخِذُه خَمرًا، ",1],["فقد تَقَحَّم النَّارَ على بَصيرةٍ\"",2]],"grade":"حسن","narrator":"بريدة","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((الأوسط)) (5356) واللفظ له، وابن حبان في ((المجروحين)) (1/286)، والبيهقي في ((شعب الإيمان)) (5230) بلفظ مقارب","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"GEpg8FEt"},{"id":"س-07418","fp":"52e81b0ea0e1","stateId":738,"easy":"إذا تزينت للحرام ← تُقرض جلودك بمقاريض من نار","cause":"الَّذين يتزيَّنون للزِّينةِ","result":"تُقرضُ جلودُهم بمقاريضَ من نارٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"الترغيب والترهيب 3/264","srcLabel":"البيهقي","text":["لمَّا عُرِج بي مررتُ برجالٍ ",["تُقرضُ جلودُهم بمقاريضَ من نارٍ",2]," فقلتُ من هؤلاء يا جبريلُ قال ",["الَّذين يتزيَّنون للزِّينةِ",1]," قال ثمَّ مررتُ بجُبٍّ مُنتِنِ الرِّيحِ فسمِعتُ فيه أصواتًا شديدةً فقلتُ من هؤلاء يا جبريلُ قال نساءٌ كنَّ يتزيَّنَّ للزِّينةِ ويفعلن ما لا يحِلُّ لهنَّ"],"grade":"صحيح","narrator":"راشد بن سعد","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الأصم في ((مصنفات أبي العباس الأصم)) (156)، والبيهقي في ((شعب الإيمان))، واللفظ لهما.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"6YFsqtac"},{"id":"س-07419","fp":"1dfc496785b9","stateId":738,"easy":"إذا تزينت المرأة للحرام وفعلت ما لا يحل ← تُعذّب","cause":"نساءٌ كنَّ يتزيَّنَّ للزِّينةِ ويفعلن ما لا يحِلُّ لهنَّ","result":"فسمِعتُ فيه أصواتًا شديدةً","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"الترغيب والترهيب 3/264","srcLabel":"البيهقي","text":["لمَّا عُرِج بي مررتُ برجالٍ تُقرضُ جلودُهم بمقاريضَ من نارٍ فقلتُ من هؤلاء يا جبريلُ قال الَّذين يتزيَّنون للزِّينةِ قال ثمَّ مررتُ بجُبٍّ مُنتِنِ الرِّيحِ ",["فسمِعتُ فيه أصواتًا شديدةً",2]," فقلتُ من هؤلاء يا جبريلُ قال ",["نساءٌ كنَّ يتزيَّنَّ للزِّينةِ ويفعلن ما لا يحِلُّ لهنَّ",1]],"grade":"صحيح","narrator":"راشد بن سعد","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الأصم في ((مصنفات أبي العباس الأصم)) (156)، والبيهقي في ((شعب الإيمان))، واللفظ لهما.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"6YFsqtac"},{"id":"س-05281","fp":"7afe6ab99ba5","stateId":738,"easy":"إذا جلست على فراش المغيبة ← ينهشك أسود من أساود يوم القيامة","cause":"يَجلسُ على فِراشِ المُغيبةِ","result":"مَثَلُ الذي يَنهَشُه أسوَدُ مِن أساوِدِ يَومِ القيامةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"حسن الأسوة بما ثبت في النسوة 532","srcLabel":"حسن الأسوة بما ثبت في النسوة","text":["مَثَلُ الذي ",["يَجلسُ على فِراشِ المُغيبةِ",1]," ",["مَثَلُ الذي يَنهَشُه أسوَدُ مِن أساوِدِ يَومِ القيامةِ",2]],"grade":"حسن","narrator":"عبداللهِ بن عمر","muhaddith":"رواته ثقات","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"SlPqZJUm","merged":2,"otherRefs":["إتحاف الخيرة المهرة 4/ 72 (حسن)"]},{"id":"س-05028","fp":"c3b7e1d72cc9","stateId":739,"easy":"إذا ضاهيت خلق الله (صوّرت) ← تكون من أشد الناس عذاباً يوم القيامة","cause":"عندَ اللَّهِ يومَ القيامةِ، الَّذينَ يُضاهونَ بخلقِ اللَّهِ","result":"أشدُّ النَّاسِ عذابًا","explicit":true,"star":true,"ref":"آداب الزفاف 113","srcLabel":"متفق عليه","text":["دخلَ عليَّ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ، وقد سَترتُ سَهْوةً لي بقِرامٍ فيهِ تماثيلُ ( وفي روايةٍ : فيه الخيلُ ذواتُ الأجنِحَةِ ) فلمَّا رآهُ هتَكَهُ وتلوَّنَ وجهُهُ وقالَ: يا عائشةُ ",["أشدُّ النَّاسِ عذابًا",2],[" عندَ اللَّهِ يومَ القيامةِ، الَّذينَ يُضاهونَ بخلقِ اللَّهِ (",1]," وفي روايةٍ: إنَّ أصحابَ هذِهِ الصُّوَرِ يعذَّبونَ، ويقالُ لَهُم: أحيوا ما خلقتُمْ، ثمَّ قالَ: إنَّ البيتَ الَّذي فيهِ الصُّوَرُ لا تدخلُهُ الملائِكَةُ ) قالَت عائشةُ: فقطَعناهُ فجعَلنا منهُ وسادةً أو وسادتَينِ فقَد رأيتُهُ متكِّئًا علَى إحداهما وفيها صورَةٌ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"أخرجه البخاري ومسلم والزيادة الأخيرة لأحمد سندها على شرط مسلم","takhrij":"أخرجه النسائي (5357)، وأحمد (26146) باختلاف يسير، وأخرجه البخاري (6109)، ومسلم (2107) مختصراً","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"NxSWgRXi","merged":8,"otherRefs":["نخب الافكار 13/458 (صحيح)","تخريج صحيح ابن حبان 5847 (صحيح)","صحيح النسائي 5372 (صحيح)","صحيح البخاري 6109 (صحيح)","صحيح مسلم 2107 (صحيح)","صحيح الجامع 999 (صحيح)","مجموع الفتاوى 29/370 (صحيح)"]},{"id":"س-05106","fp":"56d1151e4382","stateId":739,"easy":"إذا صوّرت صورة في الدنيا ← تُكلّف يوم القيامة أن تنفخ فيها الروح ولست بنافخ","cause":"مَن صوَّرَ صورَةً في الدُّنيا","result":"كُلِّفَ يَومَ القيامَةِ أنْ يَنفُخَ فيها الرُّوحَ، وليس بِنافِخٍ","explicit":true,"star":true,"similar":["س-05243"],"ref":"تخريج المسند لشعيب 3272","srcLabel":"متفق عليه","text":["أنَّه شهِدَ عبدَ اللهِ بنَ عبَّاسٍ أَفتى النَّاسَ، ولا يَذكُرُ في فُتياه رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ حتى جاءَ رَجُلٌ فقال: إنِّي رَجُلٌ عِراقيٌّ، وإنِّي أُصوِّرُ هذه التَّصاويرَ. فقال: ادنُه -مَرَّتَيْنِ أو ثَلاثًا- سمِعتُ محمدًا صلَّى اللهُ عليه وسلَّمَ، -أو قال: سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ- يَقولُ: ",["مَن صوَّرَ صورَةً في الدُّنيا؛ ",1],["كُلِّفَ يَومَ القيامَةِ أنْ يَنفُخَ فيها الرُّوحَ، وليس بِنافِخٍ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (5963)، ومسلم (2110)، والنسائي (5358)، وأحمد (3272) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"nIxHB5no","merged":8,"otherRefs":["تخريج صحيح ابن حبان 5848 (صحيح)","تخريج صحيح ابن حبان 5685 (صحيح)","تخريج المسند لشعيب 10549 (صحيح)","تخريج سنن أبي داود 5024 (صحيح)","صحيح الجامع 6371 (صحيح)","صحيح الجامع 6370 (صحيح)","مجموع الفتاوى 29/370 (صحيح)"]},{"id":"س-02755","fp":"590c6ae0aead","stateId":739,"easy":"إذا صوّرت ← تُعذّب يوم القيامة ويقال: أحيوا ما خلقتم","cause":"أصحابَ هذِهِ الصُّورِ","result":"يُعذَّبونَ يومَ القيامةِ فيقالُ أَحيوا ما خَلقتُمْ","explicit":true,"similar":["س-02721","س-03071","س-04921"],"ref":"نخب الافكار 13/466","srcLabel":"متفق عليه","text":["أنَّها اشترَت نُمرُقَةً فيها تَصاويرُ . فلمَّا رآها رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قامَ علَى البابِ، فلَم يدخُلْ، فعَرفتُ في وجهِهِ الكراهةَ . فقُلتُ: يا رسولَ اللَّهِ، أتوبُ إلى اللَّهِ، وإلى رسولِهِ، فماذا أذنَبتُ ؟ . فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: ما بالُ هذِهِ النُّمرقةِ ؟ قُلتُ: اشتريتُها لَكَ ; لتقعدَ علَيها، وتتوسَّدَها . فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: إنَّ ",["أصحابَ هذِهِ الصُّورِ",1]," ",["يُعذَّبونَ يومَ القيامةِ فيقالُ أَحيوا ما خَلقتُمْ",2]," . ثمَّ قالَ: إنَّ البيتَ الَّذي فيهِ تَصاويرُ لا تدخلُهُ الملائِكَةُ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"طريقه صحيح","takhrij":"أخرجه الطحاوي في ((شرح معاني الآثار)) (6930) واللفظ له، البخاري (2105)، ومسلم (2107) بنحوه.","bab":"إيمان › الملائكة","dorar":"kpMrzvos","merged":2,"otherRefs":["نخب الافكار 13/471 (صحيح)"]},{"id":"س-04234","fp":"73b19d477b48","stateId":739,"easy":"إذا صوّرت ← يعذبك الله بما صوّرت","cause":"المُصوِّرينَ لِما صوَّروا","result":"إنَّ اللهَ يُعذِّبُ","explicit":true,"ref":"تخريج صحيح ابن حبان 5846","srcLabel":"متفق عليه","text":["جاءه رجُلٌ فقال: إنِّي عمِلْتُ هذه التَّصاويرَ قال: فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ( ",["إنَّ اللهَ يُعذِّبُ",2]," ",["المُصوِّرينَ لِما صوَّروا",1]," ) قال: فذهَب الرَّجُلُ وزعَم أنَّ له عيالًا \nقال ابنُ عبَّاسٍ: لا تُصوِّرْ شيئًا فيه رُوحٌ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه البخاري (2225)، ومسلم (2110) بنحوه","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"gmD0vsrE","merged":2,"otherRefs":["صحيح الجامع 1899 (صحيح)"]},{"id":"س-02721","fp":"a24b40a9d096","stateId":739,"easy":"إذا صنعت الصورة ← تُعذّب يوم القيامة ويقال لك: أحيِ ما خلقت","cause":"مَن صَنَعَ الصُّورةَ","result":"يُعَذَّبُ يَومَ القيامةِ، يقولُ: أحيوا ما خَلَقتُم","explicit":true,"repOf":"س-02755","ref":"صحيح البخاري 3224","text":["حَشَوتُ للنَّبيِّ صلَّى اللهُ عليه وسلَّم وِسادةً فيها تَماثيلُ كَأنَّها نُمرُقةٌ، فجاءَ فقامَ بينَ البابَينِ وجَعَلَ يَتَغَيَّرُ وجهُه، فقُلتُ: ما لَنا يا رَسولَ اللهِ؟ قال: ما بالُ هذه الوِسادةِ؟ قالت: وِسادةٌ جَعَلتُها لكَ لتَضطَجِعَ عليها، قال: أما عَلِمتِ أنَّ المَلائِكةَ لا تَدخُلُ بَيتًا فيه صورةٌ، وأنَّ ",["مَن صَنَعَ الصُّورةَ",1]," ",["يُعَذَّبُ يَومَ القيامةِ، يقولُ: أحيوا ما خَلَقتُم",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3224)، ومسلم (2107)","bab":"إيمان › الملائكة","dorar":"EYTuErUP"},{"id":"س-03071","fp":"8495f24df594","stateId":739,"easy":"إذا صنعت الصور ← تُعذّب يوم القيامة ويقال: أحيوا ما خلقتم","cause":"مَن صَنَعَ الصُّوَرَ","result":"يُعَذَّبُ يَومَ القِيامَةِ فيُقالُ : أحْيُوا ما خَلَقْتُمْ","explicit":true,"repOf":"س-02755","ref":"صحيح الجامع 1330","text":["أمَا عَلِمتَ أنَّ الملائِكةَ لا تَدخُلُ بيتًا فيه صُورةٌ و أنَّ ",["مَن صَنَعَ الصُّوَرَ",1]," ",["يُعَذَّبُ يَومَ القِيامَةِ فيُقالُ : أحْيُوا ما خَلَقْتُمْ",2]," ؟"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه البخاري (3224)، ومسلم (2107) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"YHXL8Hay"},{"id":"س-04179","fp":"0a9c4fe4da72","stateId":739,"easy":"إذا صوّرت ← تكون من أشد أهل النار عذاباً","cause":"المصورينَ","result":"إنَّ من أشدِّ أهلِ النارِ عذابًا يومَ القيامةِ","explicit":true,"ref":"تخريج المسند لشاكر 6/59","srcLabel":"متفق عليه","text":[["إنَّ من أشدِّ أهلِ النارِ عذابًا يومَ القيامةِ",2]," ",["المصورينَ",1]," وقال وكيعٌ : أشدُّ الناسِ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (5950)، ومسلم (2109) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"tE9wlu76"},{"id":"س-04265","fp":"7d48f927b443","stateId":739,"easy":"إذا صوّرت ← ففي النار، ويُجعل لك بكل صورة نفس تعذبك","cause":"كلُّ مُصوِّرٍ","result":"في النَّارِ ، يُجْعَلُ له بكلِّ صورةٍ صوَّرها نفسٌ فتُعذِّبُه في جهنَّمَ","explicit":true,"ref":"صحيح الجامع 4554","srcLabel":"متفق عليه","text":[["كلُّ مُصوِّرٍ",1]," ",["في النَّارِ ، يُجْعَلُ له بكلِّ صورةٍ صوَّرها نفسٌ فتُعذِّبُه في جهنَّمَ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2110) واللفظ له، وأخرجه البخاري (2225) بنحوه","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"IX4Vq6iV"},{"id":"س-04921","fp":"5c410617d80e","stateId":739,"easy":"إذا صوّرت صورة ← يقال لك يوم القيامة: أحيِ ما خلقت","cause":"لا يُصوِّرُ عبدٌ صورَةً","result":"إلَّا قيلَ له يَومَ القيامَةِ: أحْيِ ما خَلَقتَ","explicit":true,"repOf":"س-02755","ref":"تخريج المسند لشعيب 6241","text":[["لا يُصوِّرُ عبدٌ صورَةً",1]," ",["إلَّا قيلَ له يَومَ القيامَةِ: أحْيِ ما خَلَقتَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5951)، ومسلم (2108)، والنسائي (5361) بنحوه، وأحمد (6241) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"EcTTaUV3"},{"id":"س-05243","fp":"bdfa3b4d1942","stateId":739,"easy":"إذا صوّرت صورة ← تُكلّف أن تنفخ فيها ولست بنافخ","cause":"مَن صَوَّرَ صورَةً","result":"عُذِّبَ -وقال حَفْصٌ مرَّةً: - كُلِّفَ أنْ يَنْفُخَ فيها، وليس بِنافِخٍ","explicit":true,"repOf":"س-05106","ref":"تخريج المسند لشعيب 6326","text":[["مَن صَوَّرَ صورَةً",1]," ",["عُذِّبَ -وقال حَفْصٌ مرَّةً: - كُلِّفَ أنْ يَنْفُخَ فيها، وليس بِنافِخٍ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"المرفوع منه صحيح","takhrij":"أخرجه أحمد (6326)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"EupNUz2A"},{"id":"س-00809","fp":"98d533ca1574","stateId":739,"easy":"إذا صوّرت ← تلتقطك النار من الصفوف","cause":"بأصحابِ التَّصاويرِ","result":"فتَلقطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسمِ فتُحبَسُ بِهم في جَهنَّمَ","explicit":true,"ref":"الدر المنثور 10/111","srcLabel":"الحاكم","text":["عنِ ابنِ عبَّاسٍ قالَ: إذا كانَ يومُ القيامةِ مُدَّتِ الأرضُ مدَّ الأديمِ، وزيدَ في سَعتِها كذا وَكذا، وجمعَ الخلائقُ بصعيدٍ واحدٍ جنُّهمُ وَ إنسُهم، فإذا كانَ ذلِكَ اليومَ قُبِضت هذِهِ السَّماءُ الدُّنيا عن أَهلِها على وجْهِ الأرضِ ولأَهلُ السَّماءِ وحدُهم أَكثرُ من أَهلِ الأرضِ جنِّهم وَ إنسِهم بضِعفٍ، فإذا نُثِروا على وجْهِ الأرض فزعوا إليهِم فيقولون: أفيكم ربُّنا؟ فيفزعونَ من قولِهم ويقولونَ: سبحانَ ربِّنا ليس فينا وهو آتٍ، ثُمَّ تُقاضُ السَّماءُ الثَّانيةُ ولأَهلُ السَّماءِ الثَّانيةِ وحدَهم أَكثرَ من أهل السَّماءِ الدُّنيا، ومن جميعِ أهل الأرضِ بضِعفٍ جنِّهم وَ إنسِهم، فإذا نُثِروا على وجهِ الأرض فزعَ إليهم أهلُ الأرضِ فيقولونَ: أفيكُم ربُّنا؟ فيفزعونَ من قولِهم ويقولونَ: سبحانَ ربِّنا ليسَ فينا وهو آتٍ، ثم تُقاضُ السَّمواتُ سماءً سماءً كلَّما قيضَت سماءٌ عن أهلِها كانت أكثرَ من أهل السَّمواتِ الَّتي تحتَها ومن جميعِ أَهلِ الأرضِ بضِعفٍ، فإذا نُثِروا على أهل الأرضِ يفزعَ إليْهم أَهلُ الأرضِ فيقولونَ لَهم: مثلُ ذلِكَ فيرجعونَ إليهم مثل ذلك حتَّى تقاضَ السَّماءُ السَّابعةُ فلَأَهلُ السَّماءِ السَّابعةِ أَكثرُ من أهلِ ستِّ سمواتٍ ومن جميعِ أهلِ الأرضِ بضِعفٍ، فيجيءُ اللَّهُ فيهم والأممُ جثًى صفوفٌ فينادي منادٍ ستعلمونَ اليومَ من أصحابُ الْكرمِ ليقُمِ الحمَّادونَ للَّهِ على كلِّ حالٍ فيقومونَ فيسرَحونَ إلى الجنَّةِ ثمَّ ينادي الثَّانيةَ ستعلمون اليومَ من أصحابُ الْكرمِ أينَ الَّذينَ كانت تَتَجَافَى جُنُوبُهُمْ عَنِ المَضَاجِعِ يَدْعُونَ رَبَّهُمْ خَوْفًا وَطَمَعًا وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ [السجدة آية: 16] فيقومونَ فيسرَحونَ إلى الجنَّةِ، قالَ: ثمَّ ينادي الثَّالثةَ ستعلمون اليومَ من أصحابُ الْكرَمِ أين الَّذينَ لَا تُلْهِيهِمْ تِجَارَةٌ وَلَا بَيْعٌ عَنْ ذِكْرِ اللَّهِ وَإِقَامِ الصَّلَاةِ وَإِيتَاءِ الزَّكَاةِ يَخَافُونَ يَوْمًا تَتَقَلَّبُ فِيهِ الْقُلُوبُ وَالْأَبْصَارُ [النور آية: 37] فيقومونَ فيسرَحونَ إلى الجنَّةِ فإذا أخذَ كلٌّ من هؤلاءِ ثلاثةٌ خرجَ عنُقٌ منَ النَّارِ فأشرفَ على الخلائقِ لَهُ عينانِ تبصِرانِ ولسانٌ فصيحٌ فيقولُ: إنِّي وُكِّلتُ منكُم بثلاثةٍ بِكلِّ جبَّارٍ عنيدٍ فتلتقطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسِمِ، فتجلِسُ بِهم في جَهنَّمَ ثمَّ تخرجُ ثانيةً فتقولُ إنِّي وُكِّلتُ منكُم بمن آذى اللَّهَ تعالى ورسولَهُ، فتلتقِطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسمِ فتُحبَسُ بهم في جهنَّمَ، ثم تخرجُ ثالثةً فتقولُ: إنِّي وُكِّلتُ ",["بأصحابِ التَّصاويرِ",1]," ",["فتَلقطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسمِ فتُحبَسُ بِهم في جَهنَّمَ",2]," فإذا أُخذَ من هؤلاءِ ثلاثةً ومن هؤلاءِ ثلاثةً نشِرتِ الصُّحفَ ووُضِعتِ الموازينَ ودُعيَ الخلائقُ للحسابِ"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن المبارك في ((الزهد والرقائق)) (2/101) واللفظ له، والحاكم (8699)، والحارث بن أبي أسامة كما في ((بغية الباحث)) (1122) بلفظ مقارب","bab":"أدعية وأذكار › حمد الله في كل الأحوال","dorar":"TsRrl1QY"},{"id":"س-03017","fp":"b9ae26a9c557","stateId":740,"easy":"إذا أسبلت أسفل الكعبين ← فهو في النار","cause":"ما كان أسفلَ من ذلك","result":"فهو في النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشعيب 11010","srcLabel":"مسلم","text":["حدَّثَنا محمَّدُ بنُ أبي عَديٍّ، عن شُعْبةَ، عنِ العَلاءِ بنِ عبدِ الرحمنِ، عن أبيه، أنَّه سمِع أبا سعيدٍ، سُئِلَ عنِ الإزارِ، فقال: على الخَبيرِ سقَطتَ، سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: \"إزْرةُ المُؤمِنِ إلى أنْصافِ السَّاقيْنِ، لا جُناحَ -أو لا حرَجَ- عليه فيما بيْنَه وبيْنَ الكَعبيْنِ، ",["ما كان أسفلَ من ذلك",1]," ",["فهو في النَّارِ",2],"، لا ينظُرُ اللهُ إلى مَن جرَّ إزارَه بَطَرًا\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أبو داود (4093)، والنسائي في ((السنن الكبرى)) (9716)، وابن ماجه (3573)، وأحمد (11010) واللفظ له","bab":"إيمان › الوعيد","dorar":"bHJRchRM","merged":4,"otherRefs":["تخريج صحيح ابن حبان 5450 (صحيح)","تخريج المسند لشعيب 7857 (صحيح)","تخريج المسند لشعيب 10555 (صحيح)"]},{"id":"س-06199","fp":"9735e3aa420a","stateId":740,"easy":"إذا لبست خاتم الذهب (للرجال) ← فقد جعلت جمرة من نار في يدك","cause":"خاتَمًا مِن ذَهَبٍ","result":"يَعمِدُ أحَدُكُم إلى جَمرةٍ مِن نارٍ فيَجعَلُها في يَدِه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-06187"],"ref":"صحيح مسلم 2090","srcLabel":"متفق عليه","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم رَأى ",["خاتَمًا مِن ذَهَبٍ",1]," في يَدِ رَجُلٍ، فنَزَعَه فطَرَحَه، وقال: ",["يَعمِدُ أحَدُكُم إلى جَمرةٍ مِن نارٍ فيَجعَلُها في يَدِه",2],"! فقيلَ للرَّجُلِ بَعدَ ما ذَهَبَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: خُذْ خاتِمَكَ انتَفِعْ به، قال: لا واللهِ، لا آخُذُه أبَدًا وقد طَرَحَه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"زينة اللباس › لبس الخاتم","dorar":"9RF11nzd","merged":3,"otherRefs":["فتاوى نور على الدرب لابن عثيمين 11/197 (صحيح)","تخريج صحيح ابن حبان 15 (صحيح)"]},{"id":"س-05166","fp":"1a5f16f5be87","stateId":740,"easy":"إذا لبست جبة محشوة بالحرير (للرجال) ← تكون طوقاً من نار يوم القيامة","cause":"جُبَّةٌ مُجَبِّيَةٌ بحرير","result":"طَوْقٌ من نارٍ يومَ القيامةِ","explicit":true,"ref":"السلسلة الصحيحة 2684","srcLabel":"الطبراني","text":[["طَوْقٌ من نارٍ يومَ القيامةِ",2]," قالهُ لِمَنْ رأى عليهِ ",["جُبَّةٌ مُجَبِّيَةٌ بحرير",1]],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"إسناده صحيح","takhrij":"أخرجه البزار (2659)، والطبراني (20/ 118)، (236) كلاهما بلفظه تاما.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"QAbtLB2j","merged":2,"otherRefs":["تنبيه الغافلين 288 (حسن)"]},{"id":"س-06187","fp":"46d1cfae79d0","stateId":740,"easy":"إذا لبست خاتم الذهب (للرجال) ← ففي يدك جمرة من نار","cause":"في يدِه خاتمٌ من ذهبٍ وجُبَّةٌ من حريرٍ","result":"كان في يدِك جمرةٌ من نارٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-06199","otherNeedIds":[13],"ref":"مجمع الزوائد 5/157","text":["أقبل رجلٌ من البحرينِ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فلم يردَّ عليهِ السلامَ وكان ",["في يدِه خاتمٌ من ذهبٍ وجُبَّةٌ من حريرٍ",1]," فانصرف الرجلُ محزونًا فشكا ذلك إلى امرأتِه فقالت له لعلَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ كرَه جُبَّتَك وخاتمَك فألقِهِما فألقاهما ثم غدا إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فردَّ عليه السلامَ فقال يا رسولَ اللهِ أتيتُك آنفًا فأعرضتَ عني قال ",["كان في يدِك جمرةٌ من نارٍ",2]," قال لقد جئتُ إذًا بجمرٍ كثيرٍ قال إنما جئتَ به ليس أغنى عنَّا من حجارةٍ الحرَّةِ ولكنَّهُ متاعُ الحياةِ الدنيا قال فما أتختَّمُ به قال حلقةٌ من ورِقٍ أو حديدٍ أو صفرٍ"],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"[فيه] أبو النجيب وثقه ابن حبان ورجاله ثقات","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (1022)، والنسائي (5206)، والطبراني في ((المعجم الأوسط)) (8664) باختلاف يسير.","bab":"زينة اللباس › إباحة الذهب والحرير للنساء دون الرجال","dorar":"dAPkPz7Q"},{"id":"س-04562","fp":"990e12a5a050","stateId":740,"easy":"إذا لبست الديباج (للرجال) ← تكون لبنته من نار","cause":"وعليه جُبَّةٌ لَبِنَتُها دِيباجٌ","result":"لَبِنَةُ من نارٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 5/144","srcLabel":"أحمد","text":["أنه دخل على رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ ",["وعليه جُبَّةٌ لَبِنَتُها دِيباجٌ",1]," فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ",["لَبِنَةُ من نارٍ",2]],"grade":"حسن","narrator":"رجل من الحي","muhaddith":"فيه علي بن عاصم بن صهيب وأنكر عليه كثرة الغلط وتماديه فيه وبقية رجاله ثقات","takhrij":"أخرجه أحمد (20683) واللفظ له.","bab":"جهنم › صفة عذاب أهل النار","dorar":"AmecHDnE"},{"id":"س-04245","fp":"7c042f572086","stateId":740,"easy":"إذا شربت في آنية الفضة ← إنما تجرجر في بطنك نار جهنم","cause":"إنَّ الذي يَشرَبُ في آنيةِ الفِضَّةِ","result":"إنَّما يُجَرجِرُ في بَطنِه نارَ جَهنَّمَ","explicit":true,"star":true,"similar":["س-00656"],"ref":"تخريج مشكل الآثار 1414","srcLabel":"متفق عليه","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قال: ",["إنَّ الذي يَشرَبُ في آنيةِ الفِضَّةِ",1]," ",["إنَّما يُجَرجِرُ في بَطنِه نارَ جَهنَّمَ",2],"."],"grade":"صحيح","narrator":"أم سلمة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (5634)، ومسلم (2065) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"S1ftlhx3","merged":5,"otherRefs":["صحيح مسلم 2065 (صحيح)","صحيح ابن ماجه 2774 (صحيح)","السلسلة الصحيحة 3417 (صحيح)","الاستذكار 7/355 (صحيح)"]},{"id":"س-08264","fp":"d751a41efbae","stateId":740,"easy":"إذا مسّ ثوبك الأرض (إسبالاً) ← فهو في النار","cause":"ما مَسَّ الأرضَ","result":"فهو في النَّارِ","explicit":true,"star":true,"similar":["س-03692"],"ref":"تخريج المسند لشعيب 5693","srcLabel":"أحمد","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ كَساهُ حُلَّةً سِيَراءَ، وكَسَا أُسامةَ قُبْطِيَّتَينِ، ثمَّ قال: ",["ما مَسَّ الأرضَ",1],"، ",["فهو في النَّارِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (5693)، وابن سعد في ((الطبقات الكبرى)) (5064)","bab":"مناقب وفضائل › أسامة بن زيد","dorar":"DS0hOU5y","merged":6,"otherRefs":["تخريج المسند لشعيب 26173 (صحيح)","إتحاف الخيرة المهرة 4/ 516 (حسن)","صحيح الجامع 5618 (صحيح)","السلسلة الصحيحة 2037 (صحيح)","تخريج المسند لشعيب 11487 (صحيح)"]},{"id":"س-04784","fp":"495823b7ddc2","stateId":740,"easy":"إذا لبست المعصفر (للرجال) ← تُعرّض نفسك للنار","cause":"مِلْحَفةٌ مُعَصْفَرةٌ","result":"يَستُرُ بَيْني وبَيْنَ هذه النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"الأحاديث المختارة 8 / 359","srcLabel":"متفق عليه","text":["«بَصُرَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ برَجُلٍ في مُؤَخَّرِ مَسجِدٍ، عليه ",["مِلْحَفةٌ مُعَصْفَرةٌ",1],"، فقالَ: (ألَا رَجُلٌ ",["يَستُرُ بَيْني وبَيْنَ هذه النَّارِ",2],"؟) ففَعَلَ ذلك رَجُلٌ»."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"YmjHMTQ1","merged":2,"otherRefs":["الأحاديث المختارة 8 / 359 (صحيح)"]},{"id":"س-06204","fp":"14f4cf33dd7d","stateId":740,"easy":"إذا أسبلت ثوبك أسفل الكعبين ← فهو في النار","cause":"ما كانَ أَسفَلَ مِن الكَعْبَينِ","result":"فهو في النَّارِ","explicit":true,"ref":"الصحيح المسند 1/347","srcLabel":"أبو داود","text":["إزْرةُ المُسلِمِ إلى نِصْفِ السَّاقِ ولا حَرَجَ -أو لا جُناحَ- فيما بَيْنَه وبَيْنَ الكَعْبَينِ، ",["ما كانَ أَسفَلَ مِن الكَعْبَينِ",1]," ",["فهو في النَّارِ",2],"، مَن جَرَّ إزارَه بَطَرًا لم يَنظُرِ اللهُ إليه."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"حسن على شرط مُسلِم","takhrij":"أخرجه أبو داود (4093)، وأحمد (11944)","bab":"زينة اللباس › ما نهي عنه من اللباس","dorar":"01NziWMJ","merged":2,"otherRefs":["تخريج المسند لشعيب 10461 (صحيح)"]},{"id":"س-00656","fp":"5cc40cbdc676","stateId":740,"easy":"إذا شربت في إناء فضة ← فكأنما تجرجر في بطنك ناراً","cause":"الذي يَشرَبُ في إناءِ فِضَّةٍ","result":"كَأنَّما يُجَرجِرُ في بَطنِه نارًا","explicit":true,"repOf":"س-04245","ref":"مجموع الشروح الفقهية. 89/17","text":["عَنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم قال في ",["الذي يَشرَبُ في إناءِ فِضَّةٍ",1],": ",["كَأنَّما يُجَرجِرُ في بَطنِه نارًا",2],"."],"grade":"صحيح","narrator":"عائشة","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (3415)، وأحمد (24662)، والبغوي كما في ((مسند ابن الجعد)) (1549) بلفظه.","bab":"آداب عامة › ضرب الأمثال","dorar":"uTD9W6DG"},{"id":"س-02578","fp":"8885d18afa66","stateId":740,"easy":"إذا تشبهت بالأعاجم في أعيادهم حتى تموت ← تُحشر معهم يوم القيامة","cause":"من بنَى ببلادِ الأعاجمِ ، فصنع نَيروزَهم ومهرجانَهم ، وتشبَّهَ بهم حتَّى يموتَ وهو كذلك","result":"حُشِرَ معهم يومَ القيامةِ","explicit":true,"ref":"اقتضاء الصراط المستقيم 1/513","srcLabel":"اقتضاء الصراط المستقيم","text":["عن عبدِ اللهِ بنِ عمرٍو قال : ",["من بنَى ببلادِ الأعاجمِ ، فصنع نَيروزَهم ومهرجانَهم ، وتشبَّهَ بهم حتَّى يموتَ وهو كذلك ، ",1],["حُشِرَ معهم يومَ القيامةِ",2]],"grade":"صحيح","narrator":"أبو المغيرة","muhaddith":"إسناده صحيح","bab":"إيمان › أعمال تنافي الإيمان","dorar":"k0GOi2nS"},{"id":"س-03692","fp":"aa4a63452790","stateId":740,"easy":"إذا مسّ ثوبك الأرض (إسبالاً) ← ففي النار","cause":"كُلُّ شَيءٍ مَسَّ الأرضَ من الثِّيابِ","result":"ففي النَّارِ","explicit":true,"repOf":"س-08264","ref":"تخريج المسند لشعيب 5727","text":["كَساني رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ قُبطيَّةً، وكَسا أُسامَةَ حُلَّةً سِيَراءَ، قال: فنَظَرَ فرَآني قد أسبَلْتُ، فجاءَ فأخَذَ بمَنْكِبي، وقال: يا ابنَ عُمَرَ، ",["كُلُّ شَيءٍ مَسَّ الأرضَ من الثِّيابِ",1]," ",["ففي النَّارِ",2],"، قال: فرَأيتُ ابنَ عُمَرَ يَتَّزِرُ إلى نِصفِ السَّاقِ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (5727) واللفظ له، وابن سعد في ((الطبقات الكبرى)) (5064) باختلاف يسير","bab":"اعتصام بالسنة › لزوم السنة","dorar":"GAT4HMwe"},{"id":"س-04171","fp":"a1d46b4830cd","stateId":740,"easy":"إذا تقلدت المرأة قلادة من ذهب (للتبرج) ← تُقلد مثلها من النار","cause":"أيما امرأةٍ تقلَّدت قلادةً من ذهبٍ قُلِّدَتْ في عنقها مثلَها من النارِ يومَ القيامةِ ، وأيما امرأةٍ جعلت في أذنها خرصًا من ذهبٍ","result":"جعل اللهُ في أذنها مثلَه من النارِ يومَ القيامةِ","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 1/171","srcLabel":"أبو داود","text":[["أيما امرأةٍ تقلَّدت قلادةً من ذهبٍ قُلِّدَتْ في عنقها مثلَها من النارِ يومَ القيامةِ ، وأيما امرأةٍ جعلت في أذنها خرصًا من ذهبٍ ",1],["جعل اللهُ في أذنها مثلَه من النارِ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"[أسماء بنت يزيد أم سلمة الأنصارية]","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4238) واللفظ له، والنسائي (5139)، وأحمد (27577) بنحوه.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"Qgw0mbdU"},{"id":"س-04287","fp":"6b22907d0213","stateId":740,"easy":"إذا أحببت أن تطوق حبيبك طوقاً من نار ← فطوّقه طوقاً من ذهب (للنساء بلا زكاة على رواية)","cause":"فليُطَوِّقْه طَوْقًا مِن ذَهَبٍ، ومَن أحَبَّ أنْ يُسَوِّرَ حَبيبَه سِوارًا مِن نارٍ فليُسَوِّرْه بسِوارٍ مِن ذَهَبٍ، ومَن أحَبَّ أنْ يُحلِّقَ حَبِيبَه حَلقةً مِن نارٍ، فليُحَلِّقْه حَلقةً مِن ذَهَبٍ","result":"مَن أحَبَّ أنْ يُطَوِّقَ حَبيبَه طَوقًا مِن نارٍ","explicit":true,"ref":"تخريج المسند لشاكر 16/177","srcLabel":"أبو داود","text":[["مَن أحَبَّ أنْ يُطَوِّقَ حَبيبَه طَوقًا مِن نارٍ، ",2],["فليُطَوِّقْه طَوْقًا مِن ذَهَبٍ، ومَن أحَبَّ أنْ يُسَوِّرَ حَبيبَه سِوارًا مِن نارٍ فليُسَوِّرْه بسِوارٍ مِن ذَهَبٍ، ومَن أحَبَّ أنْ يُحلِّقَ حَبِيبَه حَلقةً مِن نارٍ، فليُحَلِّقْه حَلقةً مِن ذَهَبٍ،",1]," ولكن عليكم بالفِضَّةِ، العَبوا بها لَعِبًا، العَبوا بها لَعِبًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4236)، وأحمد (8910) واللفظ له.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"0JjPlmp4"},{"id":"س-02938","fp":"39d5b44d3de1","stateId":740,"easy":"إذا تحلّت المرأة بذهب تظهره (للفتنة) ← تُعذّب به","cause":"تُحلَّى ذَهبًا تُظهِرُه","result":"إلَّا عُذِّبَتْ به","explicit":true,"ref":"هداية الرواة 4/225","srcLabel":"أبو داود","text":["يا مَعشَرَ النِّساءِ، أمَا لكُنَّ في الفِضَّةِ ما تَحَلَّينَ به، أمَا إنَّه ليس مِنكُنَّ امرَأةٌ ",["تُحلَّى ذَهبًا تُظهِرُه",1]," ",["إلَّا عُذِّبَتْ به",2],"."],"grade":"حسن","narrator":"أخت لحذيفة بن اليمان","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه أبو داود (4237) واللفظ له، والنسائي (5138)، وأحمد (27011)","bab":"إيمان › الوعيد","dorar":"tDz3fn1p","merged":2,"otherRefs":["النكت على المحرر 1/140 (حسن)"]},{"id":"س-02949","fp":"7404a8c158e6","stateId":740,"easy":"إذا صليت فارفع ثوبك عن الأرض (لا تسبل) ← فكل ما أصاب الأرض من ثوبك في النار","cause":"إذا صليتُم فارفَعُوا سُبُلَكُم","result":"فإنَّ كلَّ شيءٍ أصابَ الأرضَ منْ سُبُلِكُمْ فهوَ فِي النَّارِ","explicit":true,"ref":"الجامع الصغير 728","srcLabel":"الطبراني","text":[["إذا صليتُم فارفَعُوا سُبُلَكُم ، ",1],["فإنَّ كلَّ شيءٍ أصابَ الأرضَ منْ سُبُلِكُمْ فهوَ فِي النَّارِ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (11/ 261) (11677) واللفظ له، والبيهقي في ((شعب الإيمان)) (5722)، وأبو نعيم في ((تسمية ما روي عن الفضل)) (51) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"rszC3UZ2"},{"id":"س-04768","fp":"809e181b8819","stateId":740,"easy":"إذا خضبت بالسواد ← يسوّد الله وجهك يوم القيامة (على رواية)","cause":"من خضَب بالسوادِ","result":"سوَّد اللهُ وجهَه يومَ القيامةِ","explicit":true,"ref":"مجمع الزوائد 5/166","srcLabel":"أحمد","text":[["من خضَب بالسوادِ ",1],["سوَّد اللهُ وجهَه يومَ القيامةِ",2]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"فيه الوضين بن عطاء وثقه أحمد وابن معين وبقية رجاله ثقات","takhrij":"أخرجه ابن أبي عاصم كما في ((فتح الباري)) لابن حجر (10/355)، وابن عدي في ((الكامل في الضعفاء)) (3/222) واللفظ لهما، والطبراني في ((مسند الشاميين)) (652) باختلاف يسير","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"V9AGqFd4"},{"id":"س-02959","fp":"2de9bd803a24","stateId":740,"easy":"إذا افتتنت المرأة بالذهب والمعصفر ← فويل لها","cause":"لنِّساءِ مِن الأحمرينِ : الذَّهبِ والمُعصفَرِ","result":"وَيْلٌ ل","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح ابن حبان 5968","srcLabel":"البيهقي","text":[["وَيْلٌ ل",2],["لنِّساءِ مِن الأحمرينِ : الذَّهبِ والمُعصفَرِ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (5780) بلفظه.","bab":"إيمان › الوعيد","dorar":"pCLcSScB"},{"id":"س-06897","fp":"4ca8c215b95d","stateId":741,"easy":"إذا فارقت الجماعة وعصيت إمامك فمت عاصياً ← فلا يُسأل عنك (من الهالكين)","cause":"رجلٌ فارَقَ الجماعةَ و عصَى إمامَه فماتَ عاصيًا ؛ فلا يُسأَلُ عنهُ ، و أَمَةٌ أو عبدٌ أَبَقَ مِن سيدِه ، و امرأةٌ غاب عنها زوجُها و كَفاها مَؤونةَ الدُّنيا فتبرَّجَت و تمرَّجت بعدَه","result":"ثلاثةٌ لا يُسْأَلُ عنهُم","explicit":true,"star":true,"ref":"صحيح الأدب المفرد 458","srcLabel":"البخاري","text":["ثلاثةٌ لا يُسأَلُ عنهم : ",["رجلٌ فارَقَ الجماعةَ و عصَى إمامَه فماتَ عاصيًا ؛ فلا يُسأَلُ عنهُ ، و أَمَةٌ أو عبدٌ أَبَقَ مِن سيدِه ، و امرأةٌ غاب عنها زوجُها و كَفاها مَؤونةَ الدُّنيا فتبرَّجَت و تمرَّجت بعدَه",1]," و ",["ثلاثةٌ لا يُسْأَلُ عنهُم",2]," : رجلٌ نازعَ اللهَ رِداءَه ؛ فإنَّ رداءَه الكِبرياءُ و إزارَه عِزُّهُ ، و رجلٌ شكَّ في أمرِ اللهِ ، و القَنُوطُ مِن رحمةِ اللهِ"],"grade":"صحيح","narrator":"فضالة بن عبيد","muhaddith":"صحيح","takhrij":"أخرجه أحمد (23988)، والبخاري في ((الأدب المفرد)) (590)، والبزار (3749) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"G0aZMJSZ","merged":3,"otherRefs":["صحيح الجامع 3058 (صحيح)","تخريج المسند لشعيب 23943 (صحيح)"]},{"id":"س-06645","fp":"577b1f37c615","stateId":741,"easy":"إذا نكثت العهد فمت ناكثاً ← تأتي يوم القيامة لا حجة لك","cause":"ومَن نَكَثَ العَهْدَ فماتَ ناكِثًا للعَهْدِ","result":"جاءَ يَوْمَ القِيامةِ لا حُجَّةَ له","explicit":true,"ref":"الأحاديث المختارة 8 / 193","srcLabel":"متفق عليه","text":["«إنَّها ستَكونُ أُمَراءُ مِن بَعْدي يُصَلُّونَ الصَّلاةَ لوَقْتِها ويُؤَخِّرونَها عن وَقْتِها، فصَلُّوا معَهم؛ فإن صَلَّوها لوَقْتِها وصَلَّيْتُموها معَهم فلكم ولهم، وإن أخَّروها عن وَقْتِها فصَلُّوها معَهم، فلكم وعليهم، مَن فارَقَ الجَماعةَ ماتَ مِيتةً جاهِليَّةً، ",["ومَن نَكَثَ العَهْدَ فماتَ ناكِثًا للعَهْدِ ",1],["جاءَ يَوْمَ القِيامةِ لا حُجَّةَ له)",2],".\nلَفْظُ عَبْدِ الرَّزَّاقِ.\nولَفْظُ حَديثِ حَجَّاجٍ: أخْبَرَني عاصِمُ بنُ عُبَيْدِ اللهِ: أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قالَ: إنَّها ستَكونُ أُمَراءُ مِن بَعْدي يُصَلُّونَ الصَّلاةَ لغَيْرِ وَقْتِها، ويُؤَخِّرونَها عن وَقْتِها، فصَلُّوها معَهم؛ فإن صَلَّوْها لوَقْتِها وصَلَّيْتُموها معَهم فلكم ولهم، وإن صَلَّوها لغَيْرِ وَقْتِها وصَلَّيْتُموها معَهم فلكم وعليهم، مَن فارَقَ الجَماعةَ ماتَ مِيتةً جاهِليَّةً، ومَن نَكَثَ العَهْدَ فماتَ ناكِثًا للعَهْدِ جاءَ يَوْمَ القِيامةِ لا حُجَّةَ له»."],"grade":"صحيح","narrator":"عامر بن ربيعة","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"H5hyB60Z"},{"id":"س-05216","fp":"22ae428676ce","stateId":741,"easy":"إذا نكثت بيعتك ← فلا حجة لك","cause":"مَنْ نكث صفْقتَه","result":"فلا حُجَّةَ له","explicit":true,"ref":"تخريج كتاب السنة 1081","srcLabel":"مسلم","text":["لمَّا كان مِنْ أمرِ عبدِ اللهِ بنِ مُطيعٍ ما كان أتاه عبدُ اللهِ بنُ عمرَ وأنَا معه فأَلْقَى له وسادةً فقال ابنُ عمرَ : إني لم أَجِئْكَ لِأَجلسَ ولكن جِئْتُكَ لِأُحَدِّثَك حديثين سمِعتُهما مِنْ رسولِ اللهِ سمِعتُه يقولُ : ",["مَنْ نكث صفْقتَه ",1],["فلا حُجَّةَ له ",2],"ومَنْ مات وهو مُفارِقٌ للجماعةِ فَمَوْتُه مِيتةٌ جاهليةٌ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1851) بنحوه","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"GgBjQ37J"},{"id":"س-05835","fp":"0b08d3690664","stateId":741,"easy":"إذا فارقت الجماعة واستذللت الإمارة ← تلقى الله ولا حجة لك","cause":"مَنْ فارَقَ الجَماعَةَ، واسْتَذَلَّ الإمارَةَ","result":"لَقِيَ اللهَ ولا حُجَّةَ له عندَ اللَّهِ","explicit":true,"similar":["س-05900"],"ref":"المستدرك على الصحيحين 415","srcLabel":"الحاكم","text":["عنْ رِبْعِيِّ بنِ حِراشٍ، أنَّه أَتَى حُذَيْفَةَ بنَ اليَمانِ يَزورُهُ، وكانتْ أُخْتُهُ تَحْتَ حُذَيْفَةَ، فقالَ لهُ حُذَيْفَةُ: يا رِبْعِيُّ، ما فَعَلَ قَوْمُكَ؟ وَذلك زَمَنَ خَرَجَ النَّاسُ إلى عُثْمانَ، قالَ: قَدْ خَرَجَ مِنْهُمْ ناسٌ، قالَ: فَسَمَّى مِنْهُمْ، فقالَ حُذَيْفَةُ: سَمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: «",["مَنْ فارَقَ الجَماعَةَ، واسْتَذَلَّ الإمارَةَ ",1],["لَقِيَ اللهَ ولا حُجَّةَ له عندَ اللَّهِ»",2],"."],"grade":"صحيح","narrator":"حذيفة","muhaddith":"صحيح","bab":"رقائق وزهد › الوصايا النافعة","dorar":"AGUiuEqD","merged":2,"otherRefs":["المستدرك على الصحيحين 414 (صحيح)"]},{"id":"س-07674","fp":"0945638ac2b8","stateId":741,"easy":"إذا خلعت البيعة بعد عقدها في عنقك ← تلقى الله وليست لك حجة","cause":"فإنْ خلَعَها مِن بَعدِ عَقْدِها في عُنُقِه","result":"لَقيَ اللهَ تبارَك وتعالَى وليستْ له حُجَّةٌ","explicit":true,"ref":"تخريج المسند لشعيب 15696","srcLabel":"أحمد","text":["مَن مات وليست عليه طاعةٌ، مات مِيتةً جاهليَّةً، ",["فإنْ خلَعَها مِن بَعدِ عَقْدِها في عُنُقِه",1],"، ",["لَقيَ اللهَ تبارَك وتعالَى وليستْ له حُجَّةٌ",2],".\n ألَا لا يَخْلُوَنَّ رجُلٌ بامرأةٍ لا تَحِلُّ له؛ فإنَّ ثالثَهما الشَّيطانُ، إلَّا مَحْرَمٌ؛ فإنَّ الشَّيطانَ مع الواحدِ، وهو مِنَ الاثنَينِ أَبْعَدُ.\n مَن ساءَتْهُ سَيِّئتُه، وسَرَّتْهُ حسَنتُه فهو مؤْمِنٌ. قال حُسَينٌ: بعْدَ عَقْدِه إيَّاها في عُنُقِه."],"grade":"صحيح","narrator":"عامر بن ربيعة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (15696) واللفظ له، والروياني في ((المسند)) (1341)، والضياء في ((الأحاديث المختارة)) (230)","bab":"قدر › العمل بالخواتيم","dorar":"dR5FfB9U"},{"id":"س-05900","fp":"24afc2ed9d2a","stateId":741,"easy":"إذا خرجت من الجماعة واستذللت الإمارة ← تلقى الله ولا وجه لك عنده","cause":"مَن خَرَجَ مِن الجَماعةِ، واستَذَلَّ الإمارةَ","result":"لَقِيَ اللهَ ولا وَجْهَ له عندَه","explicit":true,"repOf":"س-05835","ref":"تخريج المسند لشعيب 23288","text":["عن رِبْعيٍّ، أنَّه أتَى حُذَيفةَ بنَ اليَمانِ بالمَدائِنِ يَزورهُ ويَزورُ أُختَه، قال: فقال حُذَيفةُ: ما فَعَلَ قَومُكَ يا رِبعيُّ؟ أخَرَجَ منهم أحَدٌ؟ قال: نَعَمْ، فسَمَّى نَفَرًا، وذلك في زَمَنِ خُروجِ النَّاسِ إلى عُثْمانَ، فقال حُذَيفةُ: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن خَرَجَ مِن الجَماعةِ، واستَذَلَّ الإمارةَ؛ ",1],["لَقِيَ اللهَ ولا وَجْهَ له عندَه",2],"."],"grade":"حسن","narrator":"حذيفة بن اليمان","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (23288) واللفظ له، والقضاعي في ((المسند)) (449)، والحاكم (410)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"zPU4BPhU","merged":2,"otherRefs":["تخريج المسند لشعيب 23452 (حسن)"]},{"id":"س-05252","fp":"cfb76f5be89a","stateId":741,"easy":"إذا أعطيت بيعة ثم نكثتها ← تلقى الله وليست معك يمينك","cause":"مَن أعطى بيعةً ثم نكَثَها","result":"لَقِيَ اللهَ وليست معه يمينُهُ","explicit":true,"ref":"إرشاد الساري 10/270","srcLabel":"الطبراني","text":[["مَن أعطى بيعةً ثم نكَثَها ",1],["لَقِيَ اللهَ وليست معه يمينُهُ",2],"."],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"إسناده جيد","takhrij":"لم نقف عليه إلا عند الطبراني في ((المعجم الأوسط)) (9106) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"otZPuySp"},{"id":"س-02559","fp":"8349460d996c","stateId":741,"easy":"إذا خلعت البيعة ← تلقى الله لا حجة لك","cause":"ومَن خَلَعَها يَوْمَ عَقْدِه إيَّاها","result":"لَقيَ اللهَ لا حُجَّةَ له","explicit":true,"star":true,"similar":["س-03857"],"ref":"الأحاديث المختارة 8 / 198","srcLabel":"متفق عليه","text":["«مَن ماتَ وليسَتْ عليه طاعةٌ ماتَ مِيتةً جاهِليَّةً، ",["ومَن خَلَعَها يَوْمَ عَقْدِه إيَّاها ",1],["لَقيَ اللهَ لا حُجَّةَ له",2],"، ألَا لا يَخْلُوَنَّ رَجُلٌ بامْرَأةٍ إلَّا امْرَأةٍ ذاتِ مَحْرَمٍ، فإنَّ الشَّيْطانَ ثالثُهما، وهو مِن الاثْنَينِ أبْعَدُ، ومَن سَرَّتْه حَسَنتُه وساءَتْه سَيِّئتُه فهو مُؤمِنٌ»)."],"grade":"صحيح","narrator":"عامر بن ربيعة","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إيمان › أعمال الجن والشياطين","dorar":"0MxCj6ym"},{"id":"س-02603","fp":"5ac0525c7d7c","stateId":741,"easy":"إذا فارقت أمتك أو ارتددت أعرابياً بعد هجرتك ← فلا حجة لك","cause":"مَنْ فارَقَ أُمَّتَهُ أَوْ عادَ أَعْرَابِيًّا بَعْدَ هِجْرَتِهِ","result":"فلا حُجَّةَ لهُ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 413","srcLabel":"متفق عليه","text":["«",["مَنْ فارَقَ أُمَّتَهُ أَوْ عادَ أَعْرَابِيًّا بَعْدَ هِجْرَتِهِ؛ ",1],["فلا حُجَّةَ لهُ»",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[إسناده صحيح]","takhrij":"أخرجه البخاري في ((التاريخ الكبير)) معلقا (2/ 23) باختلاف يسير، ومسلم (1851)، وأحمد (5551) كلاهما بنحوه.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"5x16B4YO"},{"id":"س-01630","fp":"83b82b029ebc","stateId":741,"easy":"إذا ابتدعت في الدين ← تجر قصبك في النار (من قصة عمرو بن لحي)","cause":"كان أوَّلَ مَن سَيَّبَ السَّوائِبَ","result":"رَأيتُ عَمرَو بنَ عامِرٍ الخُزاعيَّ يَجُرُّ قُصْبَه في النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-07499"],"otherNeedIds":[22],"ref":"صحيح البخاري 4623","srcLabel":"متفق عليه","text":["عَن سَعيدِ بنِ المُسَيِّبِ، قال: البَحيرةُ: التي يُمنَعُ دَرُّها للطَّواغيتِ، فلا يَحلُبُها أحَدٌ مِنَ النَّاسِ، والسَّائِبةُ: كانوا يُسَيِّبونَها لآلِهَتِهم، لا يُحمَلُ عليها شَيءٌ. قال: وقال أبو هُرَيرةَ: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["رَأيتُ عَمرَو بنَ عامِرٍ الخُزاعيَّ يَجُرُّ قُصْبَه في النَّارِ",2],"، ",["كان أوَّلَ مَن سَيَّبَ السَّوائِبَ",1],". والوَصيلةُ: النَّاقةُ البِكرُ، تُبَكِّرُ في أوَّلِ نِتاجِ الإبِلِ، ثُمَّ تُثَنِّي بَعدُ بأُنثى، وكانوا يُسَيِّبونَها لطَواغيتِهم، إن وصَلَت إحداهما بالأُخرى ليس بينَهما ذَكَرٌ. والحامِ: فحلُ الإبِلِ يَضرِبُ الضِّرابَ المَعدودَ، فإذا قَضى ضِرابَه ودَعُوه للطَّواغيتِ، وأعْفَوه مِنَ الحَملِ، فلَم يُحمَلْ عليه شَيءٌ، وسَمَّوه الحاميَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4623)، ومسلم (2856)","bab":"أطعمة › حلب الرجل الناقة وغيرها","dorar":"icY5HOpI","merged":3,"otherRefs":["تخريج صحيح ابن حبان 6260 (صحيح)","صحيح البخاري 4624 (صحيح)"]},{"id":"ق-0239","fp":"e71d13b8f6fc","stateId":741,"easy":"ترك الهجرة مع القدرة والرضا بالاستضعاف ← مأواهم جهنم","cause":"ترك الهجرة مع القدرة والرضا بالاستضعاف","result":"مأواهم جهنم","explicit":true,"ref":"سورة النساء: 97","srcLabel":"القرآن الكريم","quran":{"s":4,"from":97,"to":97,"text":"إِنَّ الَّذِينَ تَوَفَّاهُمُ الْمَلَائِكَةُ ظَالِمِي أَنْفُسِهِمْ قَالُوا فِيمَ كُنْتُمْ قَالُوا كُنَّا مُسْتَضْعَفِينَ فِي الْأَرْضِ قَالُوا أَلَمْ تَكُنْ أَرْضُ اللَّهِ وَاسِعَةً فَتُهَاجِرُوا فِيهَا فَأُولَئِكَ مَأْوَاهُمْ جَهَنَّمُ وَسَاءَتْ مَصِيرًا (97)","hl":[[0,254,1]]}},{"id":"ق-0498","fp":"7f3180961d26","stateId":741,"easy":"التثاقل عن الجهاد والرضا بالحياة الدنيا ← عذاب أليم واستبدال قوم غيرهم","cause":"التثاقل عن الجهاد والرضا بالحياة الدنيا","result":"عذاب أليم واستبدال قوم غيرهم","explicit":true,"otherNeedIds":[60],"ref":"سورة التوبة: 38–39","srcLabel":"القرآن الكريم","quran":{"s":9,"from":38,"to":39,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا مَا لَكُمْ إِذَا قِيلَ لَكُمُ انْفِرُوا فِي سَبِيلِ اللَّهِ اثَّاقَلْتُمْ إِلَى الْأَرْضِ أَرَضِيتُمْ بِالْحَيَاةِ الدُّنْيَا مِنَ الْآخِرَةِ فَمَا مَتَاعُ الْحَيَاةِ الدُّنْيَا فِي الْآخِرَةِ إِلَّا قَلِيلٌ (38) إِلَّا تَنْفِرُوا يُعَذِّبْكُمْ عَذَابًا أَلِيمًا وَيَسْتَبْدِلْ قَوْمًا غَيْرَكُمْ وَلَا تَضُرُّوهُ شَيْئًا وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ (39)","hl":[[31,389,1]]}},{"id":"س-01182","fp":"ca0f7c3897dd","stateId":741,"easy":"إذا دعوت بدعوى الجاهلية ← فأنت من جثا جهنم","cause":"ومَن دَعا بدَعوى الجاهِليَّةِ","result":"فهو مِن جُثا جَهَنَّمَ","explicit":true,"similar":["س-00892","س-04212"],"ref":"تخريج المسند لشعيب 17800","srcLabel":"أحمد","text":["إنَّ اللهَ أمَرَ يَحيى بنَ زَكَريَّا بخَمسِ كَلِماتٍ أن يَعمَلَ بهنَّ، وأن يَأمُرَ بَني إسرائيلَ أن يَعمَلوا بهنَّ، فكادَ أن يُبطِئَ، فقال له عيسى: إنَّكَ قد أُمِرتَ بخَمسِ كَلِماتٍ أن تَعمَلَ بهنَّ، وأن تَأمُرَ بَني إسرائيلَ أن يَعمَلوا بهنَّ، فإمَّا أن تُبَلِّغَهنَّ وإمَّا أُبَلِّغهنَّ، فقال له: يا أخي، إنِّي أخشى إن سَبَقتَني أن أُعَذَّبَ، أو يُخسَفَ بي، قال: فجَمَعَ يَحيى بَني إسرائيلَ في بَيتِ المَقدِسِ، حَتَّى امتَلَأ المَسجِدُ، وقُعِدَ على الشُّرَفِ، فحَمِدَ اللهَ، وأثنى عليه، ثُمَّ قال: إنَّ اللهَ أمَرَني بخَمسِ كَلِماتٍ أن أعمَلَ بهنَّ وآمُرَكُم أن تَعمَلوا بهنَّ: أوَّلُهنَّ: أن تَعبُدوا اللهَ ولا تُشرِكوا به شَيئًا؛ فإنَّ مَثَلَ ذلك مَثَلُ رَجُلٍ اشتَرى عَبدًا مِن خالِصِ مالِه بوَرِقٍ أو ذَهَبٍ، فجَعَلَ يَعمَلُ ويُؤَدِّي عَمَلَه إلى غَيرِ سَيِّدِه، فأيُّكُم يَسُرُّه أن يَكونَ عَبدُه كَذلك؟ وإنَّ اللهَ خَلَقَكُم ورَزَقَكُم فاعبُدوهُ ولا تُشرِكوا به شَيئًا، وآمُرُكُم بالصَّلاةِ؛ فإنَّ اللهَ يَنصِبُ وجهَه لوَجهِ عَبدِه ما لم يَلتَفِتْ، فإذا صَلَّيتُم فلا تَلتَفِتوا، وآمُرُكُم بالصِّيامِ؛ فإنَّ مَثَلَ ذلك كَمَثَلِ رَجُلٍ مَعَه صُرَّةٌ مِن مِسكٍ في عِصابةٍ، كُلُّهم يَجِدُ ريحَ المِسكِ، وإنَّ خُلوفَ فمِ الصَّائِمِ أطيَبُ عِندَ اللهِ مِن ريحِ المِسكِ، وآمُرُكُم بالصَّدَقةِ؛ فإنَّ مَثَلَ ذلك كَمَثَلِ رَجُلٍ أسَرَه العَدوُّ، فشَدُّوا يَدَيه إلى عُنُقِه، وقَرَّبوهُ ليَضرِبوا عُنُقَه، فقال: هَل لَكُم أن أفتَديَ نَفسي مِنكُم، فجَعَلَ يَفتَدي نَفسَه مِنهم بالقَليلِ والكَثيرِ، حَتَّى فكَّ نَفسَه، وآمُرُكُم بذِكرِ اللهِ كَثيرًا، وإنَّ مَثَلَ ذلك كَمَثَلِ رَجُلٍ طَلَبَه العَدوُّ سِراعًا في أثَرِه، فأتى حِصنًا حَصينًا، فتَحَصَّنَ فيه، وإنَّ العَبدَ أحصَنُ ما يَكونُ مِنَ الشَّيطانِ إذا كان في ذِكرِ اللهِ. قال: وقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: «أنا آمُرُكُم بخَمسٍ اللهُ أمَرَني بهنَّ: بالجَماعةِ، والسَّمعِ، والطَّاعةِ، والهجرةِ، والجِهادِ في سَبيلِ اللهِ؛ فإنَّه مَن خَرَجَ مِنَ الجَماعةِ قِيدَ شِبرٍ فقد خَلَعَ رِبقَ الإسلامِ مِن عُنُقِه إلى أن يَرجِعَ، ",["ومَن دَعا بدَعوى الجاهِليَّةِ ",1],["فهو مِن جُثا جَهَنَّمَ»",2],"، قالوا: يا رَسولَ اللهِ، وإن صامَ وصَلَّى؟ قال: «وإن صامَ وصَلَّى، وزَعَمَ أنَّه مُسلِمٌ، فادعوا المُسلِمينَ بما سَمَّاهُمُ المُسلِمينَ المُؤمِنينَ عِبادَ اللهِ»."],"grade":"صحيح","narrator":"الحارث الأشعري","muhaddith":"صحيح","bab":"أدعية وأذكار › فضل الذكر","dorar":"sHxpfooO","merged":3,"otherRefs":["تخريج صحيح ابن حبان 6233 (صحيح)","المستدرك على الصحيحين 8027 (صحيح)"]},{"id":"س-03857","fp":"c5707f6c5a28","stateId":741,"easy":"إذا خلعت يداً من طاعة ← تلقى الله يوم القيامة لا حجة لك","cause":"مَن خَلَعَ يَدًا مِن طاعةٍ","result":"لَقيَ اللهَ يَومَ القيامةِ لا حُجَّةَ له","explicit":true,"repOf":"س-02559","ref":"صحيح مسلم 1851","text":["جاءَ عبدُ اللهِ بنُ عُمَرَ إلى عبدِ اللهِ بنِ مُطيعٍ حينَ كان مِن أمرِ الحَرَّةِ ما كانَ، زَمَنَ يَزيدَ بنِ مُعاويةَ، فقال: اطرَحوا لأبي عبدِ الرَّحمَنِ وِسادةً، فقال: إنِّي لم آتِكَ لأجلِسَ، أتَيتُكَ لأُحَدِّثَكَ حَديثًا سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُه: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["مَن خَلَعَ يَدًا مِن طاعةٍ ",1],["لَقيَ اللهَ يَومَ القيامةِ لا حُجَّةَ له، ",2],"ومَن ماتَ وليسَ في عُنُقِه بَيعةٌ ماتَ مِيتةً جاهِليَّةً."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (5386)، وابن حبان (4578) بنحوه.","bab":"بيعة › مبايعة الإمام","dorar":"Hr2AYVCB","merged":3,"otherRefs":["تخريج المسند لشاكر 9/165 (صحيح)","تخريج المسند لشعيب 6048 (صحيح)"]},{"id":"س-03059","fp":"8a3cde13e5d5","stateId":741,"easy":"إذا شذذت عن الجماعة ← شذذت إلى النار","cause":"من شذَّ","result":"شذَّ إلى النَّارِ","explicit":true,"ref":"الفتح الرباني 10/4768","srcLabel":"الترمذي","text":[["من شذَّ ",1],["شذَّ إلى النَّارِ ",2],"[يعني حديث: لا تَجتَمِعُ أُمَّةُ محمدٍ على ضَلالَةٍ أبدًا وعليكم بالسَّوادِ الأعظَمِ فإنه مَن شَذَّ شَذَّ إلى النارِ]"],"grade":"صحيح","narrator":"[عبدالله بن عمر]","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2167)، وابن أبي عاصم في ((السنة)) (80)، والحاكم (391) جميعا بلفظه مطولا.","bab":"إيمان › الوعيد","dorar":"lFFty4UO","merged":2,"otherRefs":["نيل الأوطار 9/231 (صحيح)"]},{"id":"س-07587","fp":"f31b7d22c075","stateId":741,"easy":"إذا أحدثت بعد النبي ﷺ ← يُذهب بك ذات الشمال","cause":"ما أحدثوا بعدَك ، إنهم كانوا يمشون بعدَك القَهْقَرى على أعقابهم","result":"و يذهبُ بكم ذاتَ الشمالِ","explicit":true,"ref":"صحيح الترغيب 784","srcLabel":"البزار","text":["إني مُمسِكٌ بحُجَزِكم عن النَّارِ : هَلُمَّ عن النارِ ، و تغلبونَني ، تقاحَمون فيه تقاحُمَ الفراشِ أو الجنادِبِ ، فأوشك أن أُرسِلَ بحُجَزِكم ، و أنا فرطَكُم على الحوضِ ، فترِدُون عليَّ معًا و أشتاتًا ، فأعرفُكم بسِيماكم و أسمائِكم ، كما يَعرِف الرجلُ الغريبةَ من الإبلِ في إبلِه ، ",["و يذهبُ بكم ذاتَ الشمالِ",2]," ، و أناشدُ فيكم ربَّ العالمين فأقول : أي ربِّ أُمَّتي ! ! فيقول : يا محمدُ ! إنك لا تدري ",["ما أحدثوا بعدَك ، إنهم كانوا يمشون بعدَك القَهْقَرى على أعقابهم",1]," ، فلا أعرفنَّ أحدَكم يومَ القيامةِ يحمل شاةً لها ثُغاءٌ ، فينادي : يا محمدُ يا محمدُ ! فأقول لا أملِكُ لك شيئًا ، قد بلَّغتُك ، فلا أعرفنَّ أحدَكم يأتي يومَ القيامةِ يحمل بعيرًا له رُغاءٌ ، فينادي : يا محمدُ يا محمدُ ! فأقول : لا أملِك لك شيئًا ، قد بلَّغتُك ، فلا أعرفنَّ أحدَكم يأتى يومَ القيامةِ يحمل فرسًا له حَمْحَمَةٌ ، فينادى : يا محمدُ يا محمدُ ! فأقول : لا أملكُ لك شيئًا قد بلَّغتُك فلا أعرفنَّ أحدَكم يومَ القيامةِ يحمل سقاءً من آدمَ ينادى : يا محمدُ يا محمدُ ! فأقول : لا أملِكُ لك شيئًا ، قد بلَّغتُكَ"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"حسن صحيح","takhrij":"أخرجه البزار (204)، والشهاب في ((المسند)) (1130)، والرامهرمزي في ((أمثال الحديث)) (14) واللفظ لهم.","bab":"فضائل النبي وصفته ودلائل النبوة › شفقته على أمته","dorar":"ExmIAaN9","merged":2,"otherRefs":["السلسلة الصحيحة 2865 (حسن)"]},{"id":"س-00892","fp":"fc03fd98d683","stateId":741,"easy":"إذا ادعيت دعوى الجاهلية ← فأنت من جثى جهنم","cause":"ومن ادَّعى دَعوى الجاهليَّةِ","result":"فإنَّهُ من جُثى جَهَنَّم","explicit":true,"repOf":"س-01182","ref":"سنن الترمذي 2863","text":["إنَّ اللَّهَ أمرَ يحيى بنَ زَكَريَّا بخمسِ كلماتٍ أن يعملَ بِها ، ويأمرَ بني إسرائيل أن يعمَلوا بِها ، وإنَّهُ كادَ أن يُبْطِئَ بِها فقال عيسى: إنَّ اللهَ أمَرَك بخَمسِ كلماتٍ؛ لِتَعمَلَ بها وتَأمُرَ بَني إسرائيلَ أن يَعمَلوا بها، فإمَّا أن تَأمُرَهم، وإمَّا أنْ آمُرَهم، فقال يحيى: أخشى إن سبَقتَني بها أن يُخسَفَ بي أو أُعذَّبَ، فجمَع النَّاسَ في بيتِ المقدِسِ، فامتَلَأ المسجدُ وقعَدوا على الشُّرُفِ، فقال: \"إنَّ اللهَ أمَرني بخَمسِ كلماتٍ أن أَعمَلَ بِهنَّ، وآمرُكم أن تَعمَلوا بهنَّ: أوَّلُهنَّ أن تَعبُدوا اللهَ ولا تُشرِكوا به شيئًا، وإنَّ مَثلَ مَن أشرَك باللهِ كمثَلِ رجلٍ اشترى عبدًا مِن خالصِ مالِه بذهَبٍ أو ورِقٍ، فقال: هذه داري وهذا عمَلي، فاعمَلْ وأدِّ إليَّ، فكان يعمَلُ ويُؤدِّي إلى غيرِ سيِّدِه، فأيُّكم يَرضى أن يكونَ عبدُه كذلك؟! وإنَّ الله أمركم بالصَّلاة، فإذا صَلَّيتُم فلا تَلتَفِتوا؛ فإنَّ اللهَ يَنصُبُ وجهَه لوجهِ عبدِه في صلاتِه ما لم يَلتفِتْ، وآمرُكم بالصِّيامِ؛ فإنَّ مَثلَ ذلك كمثَلِ رجلٍ في عِصابةٍ معَه صُرَّةٌ فيها مِسكٌ، فكلَّهم يَعجَبُ أو يُعجِبُه ريحُها، وإنَّ ريحَ الصَّائمِ أطيبُ عندَ اللهِ مِن ريحِ المسكِ، وآمرُكم بالصَّدقةِ؛ فإنَّ مثَلَ ذلك كمثَلِ رجلٍ أسَره العدوُّ، فأوثَقوا يدَه إلى عنُقِه، وقدَّموه لِيَضرِبوا عُنقَه، فقال: أنا أَفْديه منكم بالقليلِ والكثيرِ، ففدَى نفسَه منهم، وآمُركم أن تَذكُروا اللهَ؛ فإنَّ مَثلَ ذلك كمَثلِ رجلٍ خرَج العدوُّ في أثَرِه سِراعًا حتَّى إذا أتى على حِصنٍ حَصينٍ، فأحرَز نفسَه منهم، كذلك العبدُ لا يُحرِزُ نفسَه مِن الشَّيطانِ إلَّا بذِكْرِ اللهِ\". قال النَّبيُّ صلَّى اللهُ علَيه وسلَّم: وأَنا آمرُكُم بخَمسٍ اللَّهُ أمرَني بِهِنَّ، السَّمعُ والطَّاعةُ والجِهادُ والهجرةُ والجمَاعةُ، فإنَّهُ مَن فارقَ الجماعةَ قيدَ شبرٍ فقد خلَعَ رِبقةَ الإسلامِ من عُنقِهِ إلَّا أن يراجِعَ، ",["ومن ادَّعى دَعوى الجاهليَّةِ",1]," ",["فإنَّهُ من جُثى جَهَنَّم",2],"، فقالَ رجلٌ: يا رسولَ اللَّهِ وإن صلَّى وصامَ؟ فقالَ: وإن صلَّى وصامَ، فادعوا بدَعوى اللَّهِ الَّذي سمَّاكمُ المسلِمينَ المؤمنينَ، عبادَ اللَّهِ"],"grade":"صحيح","narrator":"الحارث بن الحارث الأشعري","muhaddith":"حسن صحيح غريب","takhrij":"أخرجه أحمد (17170)، وابن خزيمة (930) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"p7zymDIJ"},{"id":"س-03721","fp":"19b75e9ef406","stateId":741,"easy":"إذا سمعت وعصيت ← فلا حجة لك","cause":"السَّامعَ العاصيَ","result":"لا حُجَّةَ له","explicit":true,"ref":"تخريج المسند لشعيب 16875","srcLabel":"الطبراني","text":["وإنَّ السَّامعَ المُطيعَ لا حُجَّةَ عليه، وإنَّ ",["السَّامعَ العاصيَ",1]," ",["لا حُجَّةَ له",2],"."],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (1056)، والطبراني (19/366) (861)","bab":"اعتصام بالسنة › لزوم السنة","dorar":"WZ20pwZQ"},{"id":"س-03732","fp":"0aa3dbc8c535","stateId":741,"easy":"إذا عصيت النبي ﷺ ← دخلت النار","cause":"ومَن عصاني","result":"دخَل النَّارَ","explicit":true,"ref":"مجمع الزوائد 10/73","srcLabel":"ابن حبان","text":["والَّذي نفسي بيدِه لتَدْخُلُنَّ الجَنَّةَ كُلُّكم إلَّا مَن أبى أو شرَد على اللهِ شِرادَ البعيرِ قيل يا رسولَ اللهِ ومَن أبى أن يدخُلَ الجَنَّةَ فقال مَن أطاعَني دخَل الجَنَّةَ ",["ومَن عصاني ",1],["دخَل النَّارَ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه ابن حبان (17)، والطبراني في ((المعجم الأوسط)) (808) باختلاف يسير","bab":"اعتصام بالسنة › لزوم السنة","dorar":"2nDXRKMp"},{"id":"س-04212","fp":"c2c5f663dcf2","stateId":741,"easy":"إذا دعوت بدعوى الجاهلية ← فأنت من جثى جهنم","cause":"مَن دَعا بدَعْوى الجاهِليَّةِ","result":"فإنَّه مِن جُثَى جَهَنَّمَ","explicit":true,"repOf":"س-01182","ref":"الأحكام الوسطى 4/ 269","text":["\"",["مَن دَعا بدَعْوى الجاهِليَّةِ ",1],["فإنَّه مِن جُثَى جَهَنَّمَ\"",2],"، فقالَ رَجُلٌ: يا رَسولَ اللهِ، وإن صامَ وصلَّى؟ قالَ: \"نَعمْ، وإن صامَ وصلَّى، فادْعوا بدَعْوةِ اللهِ الَّذي سَمَّاكم بِها المُسلِمينَ المُؤمِنينَ عِبادَ اللهِ\"."],"grade":"صحيح","narrator":"الحارث بن مالك الأشعري","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه النسائي ((السنن الكبرى)) (8815) واللفظ له، والترمذي (2863)، وأحمد (17170) مطولا","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"lEZVd2gn"},{"id":"س-07341","fp":"c462c66d5d45","stateId":741,"easy":"إذا اتبعت الأهواء وفارقت الجماعة ← تكون من الفرق الهالكة","cause":"وواحدةٌ في الجنةِ ، وهيَ الجماعةُ ، وإنَّهُ سيخرُجُ مِنْ أُمتي أقوامٌ تَجَارَى بِهمْ تلكَ الأهواءُ ، كما يَتجَارَى الكلَبُ بصاحبِهِ لاَ يبقَى منهُ عِرْقٌ ولاَ مَفْصِلٌ إلَّا دخلَهُ","result":"ثنتانِ وسبعونَ في النارِ","explicit":true,"ref":"الأحكام الشرعية الصغرى 96","srcLabel":"أبو داود","text":["ألاَ إنَّ مَنْ قبلكُمْ مِنْ أهلِ الكتابِ ، افترقوا على ثنتينِ وسبعينَ ملةً ، وإنَّ هذهِ الأمةَ ستفترقُ على ثلاثٍ وسبعينَ : ",["ثنتانِ وسبعونَ في النارِ ",2],"،",[" وواحدةٌ في الجنةِ ، وهيَ الجماعةُ ، وإنَّهُ سيخرُجُ مِنْ أُمتي أقوامٌ تَجَارَى بِهمْ تلكَ الأهواءُ ، كما يَتجَارَى الكلَبُ بصاحبِهِ لاَ يبقَى منهُ عِرْقٌ ولاَ مَفْصِلٌ إلَّا دخلَهُ",1]],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"[أشار في المقدمة أنه صحيح الإسناد]","takhrij":"أخرجه أبو داود (4597)، وأحمد (16937) باختلاف يسير","bab":"فتن › كراهية الاختلاف","dorar":"Ju2Kmaaj"},{"id":"س-07499","fp":"fdf0323044c3","stateId":741,"easy":"إذا غيّرت دين الله ← تجر قصبك في النار","cause":"أوَّلُ مَن غيَّر دينَ إسماعيلَ","result":"يجرُّ قصبه في النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-01630","otherNeedIds":[22],"ref":"عمدة التفسير 1/745","text":["سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ لأَكْثمَ بنِ الجونِ : يا أَكْثمُ ، رأيتُ عمرَو بنَ لُحيٍّ بنِ قَمعةَ بنِ خِندفَ ",["يجرُّ قصبه في النَّارِ",2]," ، فما رأيتُ رجلًا أشبَهَ برجلٍ منكَ بِهِ ، ولا بِهِ منكَ . فقالَ أَكْثمُ : تخشَى أن يَضرَّني شبَهُهُ يا رسولَ اللَّهِ ؟ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : لا إنَّكَ مُؤمنٌ وَهوَ كافرٌ ، إنَّهُ ",["أوَّلُ مَن غيَّر دينَ إسماعيلَ",1]," ، وبَحَّرَ البحيرةَ ، وسيَّبَ السَّائبةَ ، وحَمى الحاميَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (8787) مختصراً، وابن أبي عاصم في ((الأوائل)) (83)، والبزار (8991) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"OQdCRecS","merged":6,"otherRefs":["مجموع فتاوى ابن باز 181/5 (صحيح)","تخريج المسند لشعيب 4259 (صحيح)","صحيح ابن حبان 7490 (صحيح)","عمدة القاري 16/126 (صحيح)","صحيح الجامع 2024 (صحيح)"]},{"id":"س-03752","fp":"1095b3e175c7","stateId":741,"easy":"إذا أحدثت في الدين ← يُؤخذ بك ذات الشمال عن الحوض","cause":"ما أحدَثوا بَعدَك","result":"فيُؤْخَذُ بهِمْ ذَاتَ الشِّمَالِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[22],"ref":"المصابيح في الأحاديث المتواترة 637","srcLabel":"المصابيح في الأحاديث المتواترة","text":["لا تدري ",["ما أحدَثوا بَعدَك",1]," [حديث عبدالله بن مسعود: أنا فَرَطُكُمْ علَى الحَوْضِ، ولَيُرْفَعَنَّ مَعِي رِجالٌ مِنكُم ثُمَّ لَيُخْتَلَجُنَّ دُونِي، فأقُولُ: يا رَبِّ أصْحابِي، فيُقالُ: إنَّكَ لا تَدْرِي ما أحْدَثُوا بَعْدَكَ.] [وحديث سهل بن سعد وأبي سعيد الخدري: إنِّي فَرَطُكُمْ علَى الحَوْضِ، مَن مَرَّ عَلَيَّ شَرِبَ، ومَن شَرِبَ لَمْ يَظْمَأْ أبَدًا، لَيَرِدَنَّ عَلَيَّ أقْوامٌ أعْرِفُهُمْ ويَعْرِفُونِي، ثُمَّ يُحالُ بَيْنِي وبيْنَهُمْ. قالَ أبو حازِمٍ: فَسَمِعَنِي النُّعْمانُ بنُ أبِي عَيَّاشٍ، فقالَ: هَكَذا سَمِعْتَ مِن سَهْلٍ؟ فَقُلتُ: نَعَمْ، فقالَ: أشْهَدُ علَى أبِي سَعِيدٍ الخُدْرِيِّ، لَسَمِعْتُهُ وهو يَزِيدُ فيها: فأقُولُ إنَّهُمْ مِنِّي، فيُقالُ: إنَّكَ لا تَدْرِي ما أحْدَثُوا بَعْدَكَ، فأقُولُ: سُحْقًا سُحْقًا لِمَن غَيَّرَ بَعْدِي.]  [وحديث أنس بن مالك: لَيَرِدَنَّ عَلَيَّ ناسٌ مِن أصْحابِي الحَوْضَ، حتَّى عَرَفْتُهُمُ، اخْتُلِجُوا دُونِي، فأقُولُ: أصْحابِي! فيَقولُ: لا تَدْرِي ما أحْدَثُوا بَعْدَكَ.]                                       [وحديث ابن عباس: قَامَ فِينَا النبيُّ صَلَّى اللهُ عليه وسلَّمَ يَخْطُبُ، فَقالَ: إنَّكُمْ مَحْشُورُونَ حُفَاةً عُرَاةً غُرْلًا: {كما بَدَأْنَا أوَّلَ خَلْقٍ نُعِيدُهُ} [الأنبياء: 104] الآيَةَ، وإنَّ أوَّلَ الخَلَائِقِ يُكْسَى يَومَ القِيَامَةِ إبْرَاهِيمُ، وإنَّه سَيُجَاءُ برِجَالٍ مِن أُمَّتي ",["فيُؤْخَذُ بهِمْ ذَاتَ الشِّمَالِ",2],"، فأقُولُ: يا رَبِّ أصْحَابِي، فيَقولُ: إنَّكَ لا تَدْرِي ما أحْدَثُوا بَعْدَكَ، فأقُولُ كما قالَ العَبْدُ الصَّالِحُ: {وَكُنْتُ عليهم شَهِيدًا ما دُمْتُ فيهم} [المائدة: 117]- إلى قَوْلِهِ - {الحَكِيمُ} [البقرة: 32] قالَ: فيُقَالُ: إنَّهُمْ لَمْ يَزَالُوا مُرْتَدِّينَ علَى أعْقَابِهِمْ.] [وحديث أم سلمة: كُنْتُ أَسْمَعُ النَّاسَ يَذْكُرُونَ الحَوْضَ، وَلَمْ أَسْمَعْ ذلكَ مِن رَسولِ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، فَلَمَّا كانَ يَوْمًا مِن ذلكَ، وَالْجَارِيَةُ تَمْشُطُنِي، فَسَمِعْتُ رَسولَ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ يقولُ: أَيُّهَا النَّاسُ، فَقُلتُ لِلْجَارِيَةِ: اسْتَأْخِرِي عَنِّي، قالَتْ: إنَّما دَعَا الرِّجَالَ وَلَمْ يَدْعُ النِّسَاءَ، فَقُلتُ: إنِّي مِنَ النَّاسِ، فَقالَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ: إنِّي لَكُمْ فَرَطٌ علَى الحَوْضِ، فَإِيَّايَ لا يَأْتِيَنَّ أَحَدُكُمْ فيُذَبُّ عَنِّي كما يُذَبُّ البَعِيرُ الضَّالُّ ، فأقُولُ: فِيمَ هذا؟ فيُقَالُ: إنَّكَ لا تَدْرِي ما أَحْدَثُوا بَعْدَكَ، فأقُولُ: سُحْقًا. وفي رِوايَةٍ: كَانَتْ أُمُّ سَلَمَةَ تُحَدِّثُ، أنَّهَا سَمِعَتِ النَّبيَّ صَلَّى اللَّهُ عليه وَسَلَّمَ يقولُ علَى المِنْبَرِ، وَهي تَمْتَشِطُ: أَيُّهَا النَّاسُ، فَقالَتْ لِمَاشِطَتِهَا: كُفِّي رَأْسِي .]"],"grade":"صحيح","narrator":"[عبدالله بن مسعود وسهل بن سعد الساعدي وأبو سعيد الخدري وأنس بن مالك وعبدالله بن عباس وأم سلمة أم المؤمنين]","muhaddith":"متواتر معنى، وقيل: متواتر لفظًا أيضًا","bab":"اعتصام بالسنة › مخالفة السنة","dorar":"djhGMoKW","merged":17,"otherRefs":["تخريج المسند لشعيب 2281 (صحيح)","تخريج المسند لشعيب 2327 (صحيح)","تخريج المسند لشعيب 3850 (صحيح)","المصابيح في الأحاديث المتواترة 629 (صحيح)","صحيح البخاري 7049 (صحيح)","مجمع الزوائد 10/368 (صحيح)","صحيح مسلم 2304 (صحيح)","تخريج المسند لشعيب 15121 (صحيح)","صحيح البخاري 7048 (صحيح)","صحيح الجامع 1471 (صحيح)","فتح الباري لابن حجر 1/246 (صحيح)","صحيح مسلم 2297 (صحيح)","تخريج المسند لشعيب 20494 (صحيح)","تخريج المسند لشعيب 19/411 (صحيح)","تخريج المسند لشعيب 11996 (صحيح)","مجمع الزوائد 9/370 (حسن)"]},{"id":"س-04866","fp":"8f7570e3e19a","stateId":742,"easy":"إذا غبطت فاجراً بنعمة ← فإن له عند الله قاتلاً لا يموت (النار)","cause":"لا تغبِطنَّ فاجِرًا بنعمةٍ","result":"إنَّ لَه عندَ اللَّهِ قاتِلًا لا يموتُ","explicit":true,"star":true,"ref":"هداية الرواة 5/34","srcLabel":"الطبراني","text":[["لا تغبِطنَّ فاجِرًا بنعمةٍ",1]," فإنَّكَ لا تدري ما هوَ لاقٍ بعدَ موتِه ",["إنَّ لَه عندَ اللَّهِ قاتِلًا لا يموتُ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه عبدالله بن المبارك في ((المسند)) (269) واللفظ له، وأخرجه الطبراني في ((المعجم الأوسط)) (4067)، والبيهقي في ((شعب الإيمان)) (4542) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"QKoEB2wZ"},{"id":"س-05657","fp":"a52307275ad4","stateId":742,"easy":"إذا بنيت فوق الحاجة ← يكون وبالاً عليك يوم القيامة إلا ما لا بد منه","cause":"كلَّ بِناءٍ بُنِيَ","result":"وبالٌ على صاحِبِه يَوْمَ القِيامةِ إلَّا ما لا بُدَّ مِنه","explicit":true,"star":true,"ref":"الأحاديث المختارة 2746","srcLabel":"متفق عليه","text":["«أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ خَرَجَ فرأى قُبَّةً مُشرِفةً، فقالَ: ما هذه؟ فقالَ له أصْحابُه: هذه لرَجُلٍ مِن الأنْصارِ، قالَ: فسَكَتَ وجَعَلَها في نَفْسِه حتَّى إذا دَخَلَ صاحِبُها فسَلَّمَ على النَّاسِ أعْرَضَ عنه، وصَنَعَ ذلك به مِرارًا، حتَّى عَرَفَ الرَّجُلُ الغَضَبَ في وَجْهِه، والإعْراضَ عنه، فشَكا ذلك إلى أصْحابِه، فقالَ: واللهِ إنِّي لأُنكِرُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، ما أدْري ما حَدَثَ بي وما صَنَعْتُ؟\nقالوا: خَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فرأى قُبَّتَك، فسألَ عن هذه فأخْبَرْناه.\nفرَجَعَ الرَّجُلُ إلى قُبَّتِه فهَدَمَها حتَّى سَوَّاها بالأرْضِ، فخَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ذاتَ يَوْمٍ ولم يَرَها، فقالَ: ما فَعَلَتِ القُبَّةُ الَّتي كانَتْ هاهنا؟ قالوا: شَكا إلينا صاحِبُها إعْراضَك عنه، فأخْبَرْناه فهَدَمَها، فقالَ لنا: إنَّ ",["كلَّ بِناءٍ بُنِيَ",1]," ",["وبالٌ على صاحِبِه يَوْمَ القِيامةِ إلَّا ما لا بُدَّ مِنه",2]," [ … ]»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"orcYWem8","merged":5,"otherRefs":["صحيح الترغيب 1874 (صحيح)","الجامع الصغير 6270 (حسن)","صحيح ابن ماجه 3/362 (صحيح)","صحيح أبي داود 5237 (صحيح)"]},{"id":"س-07541","fp":"af1d3c793e18","stateId":742,"easy":"إذا شربت الماء البارد ← فهو من النعيم الذي تُسأل عنه","cause":"ثُمَّ أتاهم بماءٍ فشَرِبوا عليه","result":"هذا من النَّعيمِ الذي تُسأَلون عنه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"الأحاديث المختارة 179","srcLabel":"البخاري","text":["«خرج رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم عندَ الظَّهيرةِ فوَجَد أبا بكرٍ في المَسجِدِ، فقال: ما أخرَجَك هذه السَّاعةَ؟ قال: أخرَجَني الذي أخرَجَك يا رَسولَ اللهِ، وجاء عُمَر بنُ الخَطَّابِ، فقال: يا ابنَ الخَطَّابِ ما أخرَجَك؟ قال: أخرَجَني الذي أخرَجَكما يا رَسولَ اللهِ، فقعَدَ عُمَرُ وأقبل رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يحَدِّثُنا، ثُمَّ قال: هل بكما من قُوَّةٍ فتَنطَلِقا إلى هذا النَّخْلِ فتُصيبا طعامًا وشرابًا وظِلًّا؟ قُلْنا: نَعَم، قال: مُرُّوا بنا إلى مَنزِلِ ابنِ التَّيِّهانِ أبي الهَيثَمِ الأنصاريِّ، فتقدَّمَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم بَيْنَ أيدينا فسَلَّم، واستأذن ثلاثَ مَرَّاتٍ، وأمُّ الهيثمِ وراءَ البابِ تَسمَعُ الكلامَ وتريدُ أن يَزيدَها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم مِنَ السَّلامِ، فلمَّا أراد رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم أن ينصَرِفَ خرَجَت أمُّ الهيثَمِ تسعى خلْفَهم، فقالت: يا رَسولَ اللهِ قَدْ -واللهِ- سَمِعْتُ تَسليمَك، ولكِنِّي أرَدْتُ أن تزيدَنا من سَلامِك! فقال لها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم خيرًا. وقال أين أبو الهَيثَمِ؟ لا أَراه. قالت: هو قريبٌ، ذَهَب يستعْذِبُ لنا من الماءِ، ادخُلوا فإنَّه يأتي السَّاعةَ -إن شاء اللهُ- فبسَطَت لهم بِساطًا تحتَ شَجَرةٍ، فجاء أبو الهَيثَمِ، ففَرِحَ بهم، وقَرَّت عيناه بهم، وصَعِد نخلةً فصَرَم لهم أعذاقًا. قال: فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: حَسْبُك يا أبا الهَيْثَمِ، قال: يا رَسولَ اللهِ تأكُلون من بُسْرِه ومِن رُطَبِه ومِن تَذْنُوبِه، ",["ثُمَّ أتاهم بماءٍ فشَرِبوا عليه",1],". فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["هذا من النَّعيمِ الذي تُسأَلون عنه",2],"! وقام أبو الهَيثَمِ لِيَذبَحَ لهم شاةً، فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: إيَّاكَ واللَّبونَ، وقامت أمُّ الهيثَمِ تَعجِنُ لهم وتخبِزُ، ووضع رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم وأبو بَكرٍ وعُمَرُ رُؤوسَهم للقائِلةِ، فانتَبَهوا وقد أدرك طعامُهم، فوُضِع الطَّعامُ بَيْنَ أيديهم وأكَلوا وشَبِعوا، وحَمِدوا اللهَ، ورَدَّت عليهم أمُّ الهيثَمِ بَقِيَّةَ الأعذاقِ، فأكلوا مِن رُطَبِه ومِن تَذنُوبِه، فسَلَّم عليهم رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم ودعا لهم»."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم] وقال: لهذا الحديث شاهد في الصحيح من حديث أبي حازم، عن أبي هريرة. \nوعبد الله بن عيسى الخزاز، قال أبو زرعة الرازي: منكر الحديث وقد أخرج له الترمذي وأبو حاتم بن حبان.\nقُلْتُ: وإذا كانت هذه القصة صحيحة فروايتهما عن عمر أولى؛ لأنه كان مع النَّبيّ صلَّى اللهُ عليه وسلَّم . والله أعلم","bab":"فضائل النبي وصفته ودلائل النبوة › تبرك الناس به","dorar":"EV1lXjy4","merged":7,"otherRefs":["تخريج مشكل الآثار 471 (صحيح)","تخريج مشكل الآثار 469 (حسن)","صحيح النسائي 3641 (صحيح)","تخريج صحيح ابن حبان 3411 (صحيح)","تخريج المسند لشعيب 15206 (صحيح)","تخريج المسند لشعيب 14637 (صحيح)"]},{"id":"س-05600","fp":"ae7534273056","stateId":742,"easy":"إذا كنت أطول الناس شبعاً في الدنيا ← تكون أكثرهم جوعاً يوم القيامة","cause":"أطْوَلُ النَّاسِ شِبَعًا في الدُّنْيا","result":"أكثَرُهم جوعًا يومَ القيامةِ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 6707","srcLabel":"الطبراني","text":["سمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، يَقولُ: الدُّنيا سِجنُ المؤمِنِ وجنَّةُ الكافِرِ. وسمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، يَقولُ: ",["أطْوَلُ النَّاسِ شِبَعًا في الدُّنْيا",1]," ",["أكثَرُهم جوعًا يومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"سلمان","muhaddith":"غريب صحيح الإسناد","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (5257) بلفظه، والطبراني (6/ 268) (6183) باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"nJxkSD3T","merged":7,"otherRefs":["السلسلة الصحيحة 7/1117 (حسن)","مجمع الزوائد 10/326 (حسن)","هداية الرواة 5/16 (حسن)","فتح الغفار 1985/4 (حسن)","صحيح الترغيب 2137 (صحيح)","سبل السلام 4/272 (حسن)"]},{"id":"ق-1457","fp":"b61157362c14","stateId":742,"easy":"الالتهاء بالتكاثر حتى الموت ← رؤية الجحيم والسؤال عن النعيم","cause":"الالتهاء بالتكاثر حتى الموت","result":"رؤية الجحيم والسؤال عن النعيم","explicit":true,"otherNeedIds":[57],"ref":"سورة التكاثر: 1–8","srcLabel":"القرآن الكريم","quran":{"s":102,"from":1,"to":8,"text":"أَلْهَاكُمُ التَّكَاثُرُ (1) حَتَّى زُرْتُمُ الْمَقَابِرَ (2) كَلَّا سَوْفَ تَعْلَمُونَ (3) ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ (4) كَلَّا لَوْ تَعْلَمُونَ عِلْمَ الْيَقِينِ (5) لَتَرَوُنَّ الْجَحِيمَ (6) ثُمَّ لَتَرَوُنَّهَا عَيْنَ الْيَقِينِ (7) ثُمَّ لَتُسْأَلُنَّ يَوْمَئِذٍ عَنِ النَّعِيمِ (8)","hl":[[0,290,1]]}},{"id":"س-06107","fp":"eca3de16df80","stateId":742,"easy":"إذا أكلت حتى شبعت ← تُسأل عن النعمة يوم القيامة","cause":"فذبَح لهم شاةً، فأكَلوا، فلمَّا شبِعوا","result":"لَتُسأَلُنَّ عن هذه النِّعمةِ يومَ القِيامةِ، أخرَجكم من بُيوتِكمُ الجوعُ، ثمَّ لمْ ترجِعوا حتى أصبْتُم هذا النَّعيمَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج مشكل الآثار 474","srcLabel":"مسلم","text":["أنَّ رسولَ اللهِ عليه السَّلامُ خرَج يومًا، فإذا هو بأبي بكْرٍ وعمرَ فقال: ما أخرَجكما هذه السَّاعةَ؟ قالا: الجوعُ يا رسولَ اللهِ، قال: وأنا والذي بعَثني بالحقِّ أخرَجني الذي أخرَجكما؛ فقُومَا. فقاما معه، فأتى رجُلًا منَ الأنصارِ، فلمْ يكُنِ الرَّجُلُ ثَمَّتَ، وإذا امرأتُهُ، فلمَّا نظَرتْ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وأبي بكْرٍ وعمرَ، قالت: مَرحبًا وأهلًا، قال نبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ: أينَ فُلانٌ؟ قالت: انطلَق يستعذِبُ لنا الماءَ، قال: فبيْنَا هم كذلك، إذْ جاء الأنصاريُّ وعليه قِرْبةٌ من ماءٍ، فلمَّا نظَر إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ وإلى صاحبَيْهِ كبَّر، ثمَّ قال: اللهُ أكبرُ، ما أحَدٌ منَ النَّاسِ من ذكَرٍ وأُنْثى أكْرَمَ أضيافًا منِّي اليومَ، فعلَّق القِرْبةَ بكِرْنافةٍ، فانطلَق فجاء بعِذْقٍ فيه تَمرٌ ورُطَبٌ وبُسْرٌ، فوضَعه بيْنَ أيديهم، فقال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: لولا اجتنَيْتَهُ، قال: تخيَّروا على أعيُنِكم يا رسولَ اللهِ، ثمَّ أخَذ المُدْيةَ، فقال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إيَّاكَ والحَلوبَ، ",["فذبَح لهم شاةً، فأكَلوا، فلمَّا شبِعوا",1]," قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: والذي نفْسي بيدِهِ ",["لَتُسأَلُنَّ عن هذه النِّعمةِ يومَ القِيامةِ، أخرَجكم من بُيوتِكمُ الجوعُ، ثمَّ لمْ ترجِعوا حتى أصبْتُم هذا النَّعيمَ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":".صحيح","takhrij":"أخرجه الطحاوي في  ((شرح مشكل الآثار)) (474) واللفظ له، ومسلم (2038)، والترمذي (2369)","bab":"رقائق وزهد › معيشة النبي صلى الله عليه وسلم","dorar":"6aE9eEAp","merged":2,"otherRefs":["التمهيد 24/339 (صحيح)"]},{"id":"س-05531","fp":"1ff893b8e581","stateId":742,"easy":"إذا تمتعت بما فوق الإزار والخبز والظل والماء ← فهو فضل تُحاسب عليه يوم القيامة","cause":"ما فوقَ الإزارِ وخلفُ الخبزِ ، وظلُّ الحائطِ وجرَّةُ الماءِ","result":"فضلٌ يحاسبُ به أو يسألُ عنه المرءُ يومَ القيامةِ","explicit":true,"ref":"البدور السافرة 195","srcLabel":"البزار","text":[["ما فوقَ الإزارِ وخلفُ الخبزِ ، وظلُّ الحائطِ وجرَّةُ الماءِ",1]," ، ",["فضلٌ يحاسبُ به أو يسألُ عنه المرءُ يومَ القيامةِ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه البزار كما في ((كشف الأستار)) للهيثمي (3643)، وأبو نعيم في ((حلية الأولياء)) (4/100) واللفظ له، وأبو منصور الديلمي كما في ((الغرائب الملتقطة)) لابن حجر (2362)","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"NSG1jIJF","merged":2,"otherRefs":["الترغيب والترهيب 4/153 (حسن)"]},{"id":"س-00436","fp":"6024f658dcc7","stateId":742,"easy":"إذا أكثرت الشبع في الدنيا ← تكون من أطول الناس جوعاً يوم القيامة","cause":"أَكثرُكم شبعًا في دارِ الدُّنيا","result":"فإنَّ أطولَكم جوعًا يومَ القيامةِ","explicit":true,"ref":"صحيح ابن ماجه 2721","srcLabel":"الترمذي","text":["تجشَّأَ رجلٌ عندَ النَّبيِّ صلَّى اللَّهُ عليْهِ وسلَّمَ فقالَ كُفَّ جشاءَكَ عنَّا ",["فإنَّ أطولَكم جوعًا يومَ القيامةِ",2]," ",["أَكثرُكم شبعًا في دارِ الدُّنيا",1]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن","takhrij":"أخرجه الترمذي (2478)، وابن ماجه (3350) واللفظ له","bab":"آداب عامة › الأخلاق المذمومة","dorar":"KoSatFLC"},{"id":"س-05560","fp":"d8577ce505a9","stateId":742,"easy":"إذا خُدمت (وتنعمت) ← وقع عليك الحساب","cause":"فإذا خُدِمَ","result":"وقع عليه الحسابُ","explicit":true,"ref":"الجامع الصغير 5649","srcLabel":"البيهقي","text":["العبدُ من اللهِ ، وهو منه ، ما لم يُخْدَمْ ، ",["فإذا خُدِمَ",1]," ",["وقع عليه الحسابُ",2],"."],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"حسن","takhrij":"أخرجه المعافى بن عمران في ((الزهد)) (33)، وابن الأعرابي في ((الزهد)) (112) واللفظ لهما، والبيهقي في ((الشعب)) (9918) بنحوه.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"89WB4tOs"},{"id":"س-05569","fp":"75ab400e224a","stateId":742,"easy":"إذا تنعمت بنعمة ← تُسأل عنها يوم القيامة","cause":"ثمَّ دعا بماءٍ باردٍ فشربَ","result":"لتُسألُنَّ عن هذا يومَ القيامةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الصحيح المسند 1240","srcLabel":"أحمد","text":["خرَجَ رسولُ اللَّهِ _ صلَّى اللَّهُ عليهِ وعلى وآلِهِ وسلَّمَ _ ليلًا ، فمَرَّ بي ، فدعاني إليهِ ، فخرجتُ . ثمَّ مرَّ بأبي بكرٍ فدعاهُ فخرجَ إليهِ ، ثمَّ مرَّ بِعُمرَ فدعاهُ فخرجَ إليهِ ، فانطلقَ حتَّى دخلَ حائِطًا لبعضِ الأنصارِ فقالَ لصاحبِ الحائطِ : أطعِمنا بُسرًا ، فجاءَ بعِذْقٍ ، فوضعَهُ فأكلَ ، فأكلَ رسولُ اللَّهِ - صلَّى اللَّهُ عليهِ وعلى وآلِهِ وسلَّمَ - وأصحابُهُ ، ",["ثمَّ دعا بماءٍ باردٍ فشربَ",1]," فقالَ : ",["لتُسألُنَّ عن هذا يومَ القيامةِ .",2]," قالَ : فأخذَ عمرُ العِذقَ فضربَ بهِ الأرضَ حتَّى تناثرَ البُسرُ قِبَلَ رسولِ اللَّهِ - صلَّى اللَّهُ عليهِ وعلى وآلِهِ وسلَّمَ - ثمَّ قالَ : يا رسولَ اللَّهِ أئنَّا لمسئولونَ عن هذا يومَ القيامةِ ؟ قالَ ؟ نعَم ، إلاَّ من ثلاثٍ : خِرقةٍ كفَّ بها الرَّجلُ عورتَهُ، أو كِسرةٍ سدَّ بها جوعَهُ، أو جحرٍ يتدخَّلُ فيهِ منَ الحرِّ والقُرِّ ."],"grade":"حسن","narrator":"أبو عسيب مولى رسول الله صلى الله عليه وسلم","muhaddith":"حسن","takhrij":"أخرجه أحمد (20768) بلفظه، وأبو نعيم في ((معرفة الصحابة)) (6920)، والبيهقي في ((شعب الإيمان)) (4281) باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"h9zD5QiI","merged":2,"otherRefs":["البدور السافرة 195 (حسن)"]},{"id":"س-05609","fp":"4b45b252bd0f","stateId":742,"easy":"إذا أثقلت ظهرك بالدنيا ← لا تجوز العقبة الكؤود (أثر أبي الدرداء)","cause":"المُثْقَلون","result":"عَقَبةً كَؤُودًا، لا يَجُوزُها المُثْقَلون","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[65],"ref":"المستدرك على الصحيحين 8939","srcLabel":"ابن الأعرابي","text":["عن أمِّ الدَّرداءِ رَضيَ اللهُ عنها، قالت: قُلتُ لأبي الدَّرداءِ: ألَا تَبْتغي لِأضيافِكَ ما يَبْتغي الرِّجالُ لِأضيافِهم؟ فقال: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: إنَّ أمامَكم ",["عَقَبةً كَؤُودًا، لا يَجُوزُها المُثْقَلون",2],"، فأُحِبُّ أنْ أتخفَّفَ لِتلكَ العَقَبةِ."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح الإسناد ولم يخرجاه","takhrij":"أخرجه ابن الأعرابي في ((معجمه)) (515)، وتمام في ((فوائده)) (1642)، وأبو نعيم في ((الحلية)) (1/ 226) واللفظ لهم.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"fcOCbeyX","merged":5,"otherRefs":["صحيح الجامع 2001 (صحيح)","صحيح الترغيب 3176 (صحيح)","صحيح الترغيب 3177 (صحيح)","سبل الهدى والرشاد 7/161 (حسن)"]},{"id":"س-04948","fp":"a5221c91a049","stateId":743,"easy":"إذا كنت في قوم يُعمل فيهم بالمعاصي ويقدرون على التغيير فلم يغيروا ← يصيبهم الله بعقاب قبل أن يموتوا","cause":"ما من رجُلٍ يكونُ في قومٍ يُعمَلُ فيهم بالمعاصي يقدِرونَ على أنْ يُغيِّروا عليه، فلا يُغيِّروا","result":"إلَّا أصابَهم اللهُ بعذابٍ من قبلِ أنْ يموتوا","explicit":true,"ref":"تخريج سنن أبي داود 4339","srcLabel":"أبو داود","text":[["ما من رجُلٍ يكونُ في قومٍ يُعمَلُ فيهم بالمعاصي يقدِرونَ على أنْ يُغيِّروا عليه، فلا يُغيِّروا",1]," ",["إلَّا أصابَهم اللهُ بعذابٍ من قبلِ أنْ يموتوا",2],"."],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (4339)، ابن حبان (300)، والطبراني (2/ 332) (2382) بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"yl3xomfN"},{"id":"س-04180","fp":"8b6659eae6be","stateId":743,"easy":"إذا آتاك الله علماً فبخلت به أو اشتريت به ثمناً قليلاً ← تُلجم يوم القيامة بلجام من نار","cause":"مَن آتاهُ اللَّهُ عِلمًا فبخِلَ بهِ عن عبادِه وأخذَ عليهِ طَمَعًا واشتَرى بهِ ثمنًا","result":"فذلكَ يُلجَمُ يومَ القيامةِ بلِجامٍ مِن نارٍ ، ويُنادي مُنادٍ هذا الَّذي آتاهُ اللَّهُ عِلمًا فبَخلَ بهِ عن عِبادِهِ وأخذَ علَيهِ طمَعًا واشتَرى بهِ ثَمنًا وَكَذلِكَ حتَّى يُفرَغَ مِنَ الحسابِ","explicit":true,"ref":"البدور السافرة 96","srcLabel":"الطبراني","text":[["مَن آتاهُ اللَّهُ عِلمًا فبخِلَ بهِ عن عبادِه وأخذَ عليهِ طَمَعًا واشتَرى بهِ ثمنًا ",1],["فذلكَ يُلجَمُ يومَ القيامةِ بلِجامٍ مِن نارٍ ، ويُنادي مُنادٍ هذا الَّذي آتاهُ اللَّهُ عِلمًا فبَخلَ بهِ عن عِبادِهِ وأخذَ علَيهِ طمَعًا واشتَرى بهِ ثَمنًا وَكَذلِكَ حتَّى يُفرَغَ مِنَ الحسابِ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (7187) مطولا باختلاف يسير، وأبو يعلى (2585)، والعقيلي في ((الضعفاء الكبير)) (4/ 206) مختصرا.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"LELYX4lu"},{"id":"س-03669","fp":"72e90809d509","stateId":743,"easy":"إذا تعديت حدود الله وضيعت فرائضه ← فبئس الحامل للقرآن أنت","cause":"تعدى حُدودي وضيعَ فرائضِي","result":"فبئسَ الحاملُ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"أحاديث مختارة 150","srcLabel":"سنده صالح","text":["يمثلُ القرآنُ يومَ القيامةِ رجلًا فيقولُ حملَ هذا إياي ",["فبئسَ الحاملُ",2]," ",["تعدى حُدودي وضيعَ فرائضِي",1]],"grade":"حسن","narrator":"[جد عمرو بن شعيب]","muhaddith":"سنده صالح","bab":"اعتصام بالسنة › الأمر بالتمسك بالكتاب والسنة","dorar":"qxfDdGfL"},{"id":"س-07099","fp":"d4d5bd8c59ba","stateId":743,"easy":"إذا سُئلت عن علم فكتمته ← تأتي يوم القيامة ملجماً بلجام من نار","cause":"مَنْ سُئِلَ عَنْ عِلْمٍ فَكَتَمَهُ","result":"جيءَ به يَوْمَ القيامَةِ وقدْ أُلْجِمَ بِلِجامٍ مِنْ نارٍ","explicit":true,"similar":["س-04296","س-02932","س-02991","س-03063"],"ref":"المستدرك على الصحيحين 348","srcLabel":"أبو داود","text":["جاءَ الأَعْمَشُ إلى عَطاءٍ، فَسَألَهُ عنْ حَديثٍ فَحَدَّثَهُ، فقُلنا لهُ: تُحَدِّثُ هذا وهو عِراقيٌّ؟ قالَ: لأَنِّي سَمِعْتُ أبا هُرَيْرَةَ يُحَدِّثُ عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ قالَ: «",["مَنْ سُئِلَ عَنْ عِلْمٍ فَكَتَمَهُ",1]," ",["جيءَ به يَوْمَ القيامَةِ وقدْ أُلْجِمَ بِلِجامٍ مِنْ نارٍ",2],"»."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح على شرط الشيخين]","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) بلفظه (1613)، وأبو داود (3658)، والترمذي (2649) بنحوه.","bab":"علم › تعليم الناس وفضل ذلك","dorar":"HqCmSFqS","merged":4,"otherRefs":["المطالب العالية 3/313 (صحيح)","تخريج المسند لشعيب 10420 (صحيح)","تخريج سنن أبي داود 3658 (صحيح)"]},{"id":"س-04296","fp":"dd2575393c76","stateId":743,"easy":"إذا كتمت علماً ← يلجمك الله يوم القيامة بلجام من نار","cause":"مَنْ كَتَمَ عِلْمًا","result":"أَلْجَمَهُ اللهُ يومَ القيامَةِ بِلِجامٍ مِنْ نارٍ","explicit":true,"repOf":"س-07099","ref":"المستدرك على الصحيحين 350","text":["«",["مَنْ كَتَمَ عِلْمًا؛ ",1],["أَلْجَمَهُ اللهُ يومَ القيامَةِ بِلِجامٍ مِنْ نارٍ»",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح من حديث المصريين على شرط الشيخين","takhrij":"أخرجه ابن حبان (96) بلفظه، ونعيم بن حماد في زياداته على ((الزهد)) لابن المبارك (2/ 119)، والطبراني في ((الأوسط)) (5027) كلاهما باختلاف يسير.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"OBGYsqbj","merged":3,"otherRefs":["تخريج سير أعلام النبلاء 23/ 134 (صحيح)","تخريج صحيح ابن حبان 95 (صحيح)"]},{"id":"س-02932","fp":"6edd56597595","stateId":743,"easy":"إذا كتمت علماً عن أهله ← تُلجم يوم القيامة بلجام من نار","cause":"مَن كتم عِلْمًا على أهلِه","result":"أُلْجِمَ ، يومَ القيامةِ لِجَامًا","explicit":true,"repOf":"س-07099","ref":"صحيح الجامع 6517","text":[["مَن كتم عِلْمًا على أهلِه ، ",1],["أُلْجِمَ ، يومَ القيامةِ لِجَامًا ",2],"من نارٍ"],"grade":"صحيح","narrator":"عبدالله بن عمرو وابن مسعود","muhaddith":"صحيح","bab":"إيمان › الوعيد","dorar":"xTLXAzkM"},{"id":"س-02991","fp":"ccdb9cfd6f8d","stateId":743,"easy":"إذا حفظت علماً فكتمته ← تأتي يوم القيامة ملجماً بلجام من نار","cause":"ما من رجلٍ يَحْفَظُ عِلْمًا فَيَكْتُمُهُ","result":"إِلَّا أُتِيَ بهِ يومَ القيامةِ مُلْجومًا بِلِجَامٍ مِنَ النارِ","explicit":true,"repOf":"س-07099","ref":"صحيح الترغيب 120","text":[["ما من رجلٍ يَحْفَظُ عِلْمًا فَيَكْتُمُهُ ؛",1]," ",["إِلَّا أُتِيَ بهِ يومَ القيامةِ مُلْجومًا بِلِجَامٍ مِنَ النارِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (3658)، والترمذي (2649)، وأحمد (7571) بنحوه، وابن ماجه (261) واللفظ له","bab":"إيمان › الوعيد","dorar":"yGvUSiO4"},{"id":"س-03063","fp":"fcfd9c776a00","stateId":743,"easy":"إذا كتمت علماً عن أهله ← تُلجم بلجام من نار","cause":"من كتم علمًا عن أهلِه","result":"أُلْجِمَ بلجامٍ من نارٍ","explicit":true,"repOf":"س-07099","ref":"الكافي الشاف 62","text":[["من كتم علمًا عن أهلِه",1]," ",["أُلْجِمَ بلجامٍ من نارٍ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"رجاله ثقات لكن فيه رجل مبهم قيل أنه حجاج بن أرطأة","takhrij":"أخرجه أبو داود (3658)، والترمذي (2649)، وأحمد (10487) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"bPo8SbWx"},{"id":"س-07693","fp":"ec5e0d7d3e4d","stateId":743,"easy":"إذا قرأت آيات التفكر ولم تتفكر فيها ← فويل لك","cause":"لِمَن قرَأها ولم يتفكَّرْ فيها","result":"ويلٌ","explicit":true,"star":true,"otherNeedIds":[13],"ref":"تخريج صحيح ابن حبان 620","srcLabel":"مسلم","text":["عَنْ عَطَاءٍ، قَالَ: دخَلْتُ أنا وعُبيدُ بنُ عُميرٍ على عائشةَ فقالت لِعُبيدِ بنِ عُميرٍ : قد آن لك أنْ تزورَنا فقال : أقولُ يا أمَّهْ كما قال الأوَّلُ : زُرْ غِبًّا تزدَدْ حُبًّا قال : فقالت : دعُونا مِن رَطانتِكم هذه قال ابنُ عُميرٍ : أخبِرينا بأعجَبِ شيءٍ رأَيْتِه مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم قال : فسكَتَتْ ثمَّ قالت : لَمَّا كان ليلةٌ مِن اللَّيالي قال : ( يا عائشةُ ذَرِيني أتعبَّدِ اللَّيلةَ لربِّي ) قُلْتُ : واللهِ إنِّي لَأُحِبُّ قُرْبَك وأُحِبُّ ما سرَّك قالت : فقام فتطهَّر ثمَّ قام يُصَلِّي قالت : فلم يزَلْ يبكي حتَّى بَلَّ حجرَه قالت : ثمَّ بكى فلم يزَلْ يبكي حتَّى بَلَّ لِحيتَه قالت : ثمَّ بكى فلم يزَلْ يبكي حتَّى بَلَّ الأرضَ فجاء بلالٌ يُؤذِنُه بالصَّلاةِ فلمَّا رآه يبكي قال : يا رسولَ اللهِ لِمَ تَبكي وقد غفَر اللهُ لك ما تقدَّم وما تأخَّر ؟ قال : ( أفلا أكونُ عبدًا شكورًا لقد نزَلَتْ علَيَّ اللَّيلةَ آيةٌ، ",["ويلٌ",2]," ",["لِمَن قرَأها ولم يتفكَّرْ فيها",1]," {إِنَّ فِي خَلْقِ السَّمَوَاتِ وَالْأَرْضِ} [آل عمران: 190] ) الآيةَ كلَّها"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن حبان (620) واللفظ له، والطحاوي في ((مشكل الآثار)) (4618)، وأبو الشيخ في ((أخلاق النبي)) (544) بنحوه.","bab":"قرآن › آداب الناس كلهم مع القرآن","dorar":"O8dP8jdJ","merged":2,"otherRefs":["الترغيب والترهيب 2/316 (صحيح)"]},{"id":"س-03255","fp":"c25a7297dc98","stateId":743,"easy":"إذا ذُكر النبي ﷺ عندك فلم تصلِّ عليه فمت فدخلت النار ← أبعدك الله","cause":"ومن ذُكِرْتَ عندَهُ ، فلم يُصَلِّ عليكَ","result":"فماتَ ، فدخلَ النارَ ، فأبعدَهُ اللهُ","explicit":true,"star":true,"otherNeedIds":[28],"ref":"موارد الظمآن 2/900","srcLabel":"مسلم","text":["أنَّ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ صعدَ المنبَرَ ، فقال : آمينَ ، آمينَ ، آمينَ ، قيلَ : يا رسولَ اللهِ ، إنكَ صعدتَ المنبَرَ ، فقلتُ آمينَ ، آمينَ ، آمينَ ، فقال : إنَّ جبريلَ عليهِ السلامُ أتاني ، فقالَ لي : من أدركَ شهرَ رمضانَ فلم يُغفرْ لهُ ، فدخلَ النارَ فأبعدَهُ اللهُ ، قلْ : آمينَ ، فقلتُ : آمينَ ، ومن أدركَ أبويْهِ ، أو أحدَهما ، فلم يَبَرَّهما ، فماتَ ، فدخلَ النارَ ، فأبعدَهُ اللهُ ، قلْ : آمينَ ، فقلتُ : آمينَ ، ",["ومن ذُكِرْتَ عندَهُ ، فلم يُصَلِّ عليكَ",1]," ، ",["فماتَ ، فدخلَ النارَ ، فأبعدَهُ اللهُ",2]," ، قلْ آمينَ ، فقلتُ : آمينَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"في صحيح مسلم منه ما يتعلق ببر الوالدين بنحوه فقط","takhrij":"أخرجه ابن خزيمة (1888)، وابن حبان (907)، والطبراني في ((المعجم الأوسط)) (8131) باختلاف يسير. وقوله: \"ومن أدرك أبويه أو أحدهما فلم يبرهما فمات فدخل النار فأبعده الله\" أخرجه مسلم (2551) بلفظ مقارب","bab":"استغفار › أسباب المغفرة","dorar":"wrNPaZCt"},{"id":"س-07431","fp":"19bbcd9d0cc5","stateId":743,"easy":"إذا رأيت المنكر فلم تنكره ← يسألك الله يوم القيامة: ما منعك؟","cause":"ما منَعكَ إذا رأَيْتَ المُنكَرَ أنْ تُنكِرَه","result":"يسأَلُ العبدَ يومَ القيامةِ","explicit":true,"star":true,"ref":"صحيح ابن حبان 7368","srcLabel":"ابن ماجه","text":["إنَّ اللهَ جلَّ وعلا ",["يسأَلُ العبدَ يومَ القيامةِ",2]," حتَّى إنَّه لَيقولُ له : ",["ما منَعكَ إذا رأَيْتَ المُنكَرَ أنْ تُنكِرَه",1]," ؟ فإذا لقَّن اللهُ عبدًا حُجَّتَه يقولُ : يا ربِّ وثِقْتُ بكَ وفرِقْتُ مِن النَّاسِ أو فرِقْتُ مِن النَّاسِ ووثِقْتُ بكَ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن ماجه (4017)، وأحمد (11245) باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"DvOA3E7j","merged":4,"otherRefs":["تخريج العواصم والقواصم 5/ 351 (صحيح)","هداية الرواة 5081 (حسن)","صحيح الجامع 1818 (صحيح)"]},{"id":"س-04936","fp":"b154572394db","stateId":743,"easy":"إذا تعلمت القرآن ثم نسيته ← تلقى الله أجذم","cause":"ومَن تَعلَّمَ القُرآنَ ثُمَّ نَسيَه","result":"لَقيَ اللهَ وهو أجذَمُ","explicit":true,"similar":["س-03087"],"ref":"تخريج المسند لشعيب 22781","srcLabel":"أحمد","text":["ما مِن أميرِ عَشَرةٍ إلَّا جِيء به يومَ القِيامةِ مَغلولةً يدُه إلى عُنُقِه حتى يُطلِقَه الحَقُّ أو يُوبِقَه، ",["ومَن تَعلَّمَ القُرآنَ ثُمَّ نَسيَه، ",1],["لَقيَ اللهَ وهو أجذَمُ",2],"."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح لغيره دون قوله: \"ومن تعلم القرآن ... إلخ\"","takhrij":"أخرجه أحمد (22758)، وعبدالله بن أحمد في ((زوائد المسند)) (22781) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"CA2b8qvX","merged":2,"otherRefs":["تخريج المسند لشعيب 22456 (صحيح)"]},{"id":"س-05042","fp":"620763a861a8","stateId":743,"easy":"إذا اجترأت على الفتيا في الجد (المواريث) ← فأنت أجرأ على النار","cause":"أجرؤُكم على الجِدِّ","result":"أجرؤُكم على النارِ","explicit":true,"ref":"المحلى 9/282","srcLabel":"ابن المنذر","text":["أن عمرَ بنَ الخطابِ قال ",["أجرؤُكم على الجِدِّ",1]," ",["أجرؤُكم على النارِ",2]," وإنما يجترئُ على الجِدِّ من يجترئُ على النارِ"],"grade":"صحيح","narrator":"سعيد بن المسيب","muhaddith":"إسناده ثابت","takhrij":"أخرجه ابن المنذر في ((الأوسط)) (6824) مختصرا","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"9wEqRXwz","merged":2,"otherRefs":["إرواء الغليل 6/129 (حسن)"]},{"id":"س-02924","fp":"c965ec40e071","stateId":743,"easy":"إذا جعلت القرآن خلفك ← يسوقك إلى النار","cause":"ومَنْ جعلَهُ خلْفَهُ","result":"ساقَهُ إلى النارِ","explicit":true,"ref":"صحيح الجامع 4443","srcLabel":"صحيح الجامع","text":["القرآنُ شافع مُشفَّعٌ ، وماحِلٌ مصدَّقٌ ، مَنْ جعلَهُ أمامَهُ قادَهُ إلى الجنةِ ، ",["ومَنْ جعلَهُ خلْفَهُ",1]," ",["ساقَهُ إلى النارِ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله وابن مسعود","muhaddith":"صحيح","bab":"إيمان › الوعيد","dorar":"BSET0YTU"},{"id":"س-03087","fp":"c2286c3cea37","stateId":743,"easy":"إذا قرأت القرآن ثم نسيته ← تلقى الله يوم القيامة أجذم","cause":"ما من امرئٍ يقرأُ القرآنَ ثمَّ ينساه","result":"إلَّا لقي اللهَ يومَ القيامةِ أجذمَ","explicit":true,"repOf":"س-04936","ref":"الفتاوى لابن عبدالوهاب 47","text":["حديثُ الوعيدِ فيمَن حفِظ القرآنَ ثم نسِيَه [يعني حديث: ",["ما من امرئٍ يقرأُ القرآنَ ثمَّ ينساه",1]," ",["إلَّا لقي اللهَ يومَ القيامةِ أجذمَ",2],"]"],"grade":"صحيح","narrator":"[سعد بن عبادة]","muhaddith":"ثابت عند أهل الحديث","takhrij":"أخرجه أبو داوود (1474)، والبيهقي في ((الشعب)) (1818) واللفظ لهم.ا، وأحمد (22456) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"s0IwWOG2"},{"id":"س-06125","fp":"0276e0a32491","stateId":743,"easy":"إذا رأيت أمراً لله فيه مقال فلم تقل ← يقال لك يوم القيامة: ما منعك؟","cause":"أن يرى أمرًا للَّهِ فيهِ مقالٌ ، فلا يقولُ فيهِ","result":"فيقالُ لَهُ يومَ القيامةِ : ما منعَكَ أن تَكونَ","explicit":true,"similar":["س-06124"],"ref":"عمدة التفسير 1/701","srcLabel":"ابن ماجه","text":["لا يحقِرنَّ أحدُكُم نفسَهُ ",["أن يرى أمرًا للَّهِ فيهِ مقالٌ ، فلا يقولُ فيهِ",1]," ، ",["فيقالُ لَهُ يومَ القيامةِ : ما منعَكَ أن تَكونَ",2]," قلتَ فيَّ كذا وَكَذا ؟ فيقولُ : مخافةَ النَّاسِ . فيقولُ : إيَّايَ أحقُّ أن تخافَ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (4008)، وأحمد (11255) باختلاف يسير","bab":"رقائق وزهد › من أرضى الناس بسخط الله","dorar":"yaOrumDD"},{"id":"س-07864","fp":"9ae0aa0c16f2","stateId":743,"easy":"إذا دعوت إلى شيء ← تقف يوم القيامة لازماً لدعوتك","cause":"ما من داعٍ يدعو لشيءٍ","result":"إلا وقفَ يومَ القيامةِ لازِمًا لدعوتِهِ ما دعا إليه","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 1/98","srcLabel":"الزواجر عن اقتراف الكبائر","text":[["ما من داعٍ يدعو لشيءٍ",1]," ",["إلا وقفَ يومَ القيامةِ لازِمًا لدعوتِهِ ما دعا إليه",2]," وإن دعا رجلٌ رجلًا"],"grade":"صحيح","muhaddith":"صحيح","bab":"قيامة › الحساب والقصاص","dorar":"Z0QgHoah"},{"id":"س-05557","fp":"f4b1c98ad100","stateId":743,"easy":"إذا تعلمت علماً ولم تعمل به ← يكون وبالاً عليك يوم القيامة","cause":"كلُّ علمٍ","result":"وبالٌ على صاحبِه يومَ القيامةِ إلَّا مَن عملَ بِهِ","explicit":true,"otherNeedIds":[18],"ref":"الجامع الصغير 6270","srcLabel":"الطبراني","text":["كلُّ بُنيانٍ وبَالٌ على صاحبِه إلَّا ما كانَ هَكذا وأشارَ بِكفِّهِ، وَ",["كلُّ علمٍ",1]," ",["وبالٌ على صاحبِه يومَ القيامةِ إلَّا مَن عملَ بِهِ",2]],"grade":"حسن","narrator":"واثلة بن الأسقع الليثي أبو فسيلة","muhaddith":"حسن","takhrij":"أخرجه الطبراني (131) (22 / 55) بلفظه","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"fziZtAXd"},{"id":"س-06124","fp":"bdc70e108bd7","stateId":743,"easy":"إذا رأيت أمراً لله عليك فيه مقال ثم لم تقل ← يقول الله يوم القيامة: ما منعك أن تقول فيه؟","cause":"يرَى أمرًا للهِ عليهِ فيهِ مقالٌ ثُمَّ لا يقولُ فيهِ","result":"فيقولُ اللهُ عزَّ وجلَّ [ لهُ ] يومَ القيامةِ : ما منعَكَ أنْ تقولَ في كذا وكذا فيقولُ : خَشِيتُ الناسَ","explicit":true,"repOf":"س-06125","ref":"الفتح الرباني 11/5448","text":["لا يَحْقِرَنَّ أحدُكُمْ نفسَهُ ، قالوا : يا رسولَ اللهِ ، وكَيْفَ يَحقِرُ أحدُنا نفسَهُ ؟ قال : ",["يرَى أمرًا للهِ عليهِ فيهِ مقالٌ ثُمَّ لا يقولُ فيهِ",1]," ! ",["فيقولُ اللهُ عزَّ وجلَّ [ لهُ ] يومَ القيامةِ : ما منعَكَ أنْ تقولَ في كذا وكذا فيقولُ : خَشِيتُ الناسَ !",2]," قال : فأنا كُنْتُ أحقُّ أنْ تَخْشَى"],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"رجال إسناده ثقات","takhrij":"أخرجه ابن ماجه (4008) واللفظ له، وأحمد (11255) باختلاف يسير","bab":"رقائق وزهد › من أرضى الناس بسخط الله","dorar":"T1G1CynB"},{"id":"س-07691","fp":"54f60b21f9d5","stateId":743,"easy":"إذا تركت القرآن أو أعرضت عنه ← يُزج في قفاك إلى النار","cause":"ومن ترَكَهُ أو أعرضَ عنهُ","result":"زَجَّ في قفاهُ إلى النَّارِ","explicit":true,"ref":"الترغيب والترهيب 1/62","srcLabel":"الترغيب والترهيب","text":["عن عبدِ اللَّهِ بنِ مسعودٍ قالَ إنَّ هذا القرآنَ شافعٌ مشفَّعٌ ومنِ اتَّبعَهُ قادَهُ إلى الجنَّةِ ",["ومن ترَكَهُ أو أعرضَ عنهُ",1]," ( أو كلمةً نحوَها ) ",["زَجَّ في قفاهُ إلى النَّارِ",2]],"grade":"حسن","muhaddith":"[روي] مرفوعا من حديث جابر وإسناد المرفوع جيد","bab":"قرآن › آداب الناس كلهم مع القرآن","dorar":"V1VHEACZ"},{"id":"س-02999","fp":"250592c05b82","stateId":743,"easy":"إذا فسقت وأنت حامل للقرآن ← فالزبانية أسرع إليك من عبدة الأوثان","cause":"فسقةِ حملةِ القرآنِ","result":"لَلزبانيةُ أسرعُ إلى","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تنزيه الشريعة 1/270","srcLabel":"الديلمي","text":[["لَلزبانيةُ أسرعُ إلى",2]," ",["فسقةِ حملةِ القرآنِ",1]," منهم إلى عبدةِ الأوثانِ فيقولون يبدأُ بنا قبلَ عبدةِ الأوثانِ فيُقالُ لهم ليس مَنْ عَلِمَ كمن لا يعلمُ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"رجاله موثقون ما خلا موسى بن محمد بن كثير السيريني","takhrij":"أخرجه الديلمي في ((الفردوس)) (3376)، وابن الجوزي في ((الموضوعات)) (1/266) واللفظ له","bab":"إيمان › الوعيد","dorar":"h2dnMxKR"},{"id":"س-03663","fp":"1109c1a3bcfd","stateId":743,"easy":"إذا خالفت أمر القرآن ← يكبّك على صخرة في النار","cause":"قد كان حملَه فخالَف أمرَه","result":"حتَّى يَكبَّه على صخرةٍ في النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"المطالب العالية 4/73","srcLabel":"ابن أبي شيبة","text":["يتمثَّلُ القرآنُ يومَ القيامةِ ، فيُؤتى بالرَّجلِ ",["قد كان حملَه [ فخالَف أمرَه",1]," ] ، فيتمثَّلُ خصمُا دونَه ، قال : فيقولُ : يا ربِّ ، حَمَّلتَه إيَّايَ ، فشرُّ حاملٍ ، تعدَّى حدودي ، وضيَّع فرائِضي ، وركِب معصيتي ، وترَك طاعتي ، فما يزالُ يقذِفُ عليهِ بالحُجَجِ حتَّى يُقالَ : فشأنَك بهِ ، فيأخذُ بيدِه ما يُرسلُه ",["حتَّى يَكبَّه على صخرةٍ في النَّارِ",2]," ، ويُؤتى بالعَبدِ الصالِحِ قد كان حملَه فحفِظ أمرَه ، فيتمثَّلُ خصمًا دونَه فيقولُ : يا ربِّ ، حمَّلتَه إيَّايَ فكان خيرَ حاملٍ ، حفِظ حدودي ، وعمِلَ بفرائضي ، واجتَنب مَعصيتي ، وعمِل بطاعَتي ، وما يزالُ يقذفُ لهُ بالحُججِ حتَّى يُقالَ [ لهُ ] : شأنُك بهِ ، فيأخذُ بيدِه فما يُرسلُه حتَّى يكسوَه حُلَّةَ الإستَبرقِ ، ويَعقدَ عليهِ تاجَ الملكِ ، ويَسقيَه كأسَ الخَمرِ"],"grade":"حسن","narrator":"[جد عمرو بن شعيب]","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن أبي شيبة (30044) واللفظ له، وابن شاهين في ((الترغيب)) (207)، والخطيب في ((اقتضاء العلم)) (112) بنحوه.","bab":"اعتصام بالسنة › الأمر بالتمسك بالكتاب والسنة","dorar":"8ONK4OdI"},{"id":"س-03995","fp":"a388b011d401","stateId":744,"easy":"إذا سرقت فقُطعت ثم تبت ← تسبقك يدك إلى الجنة، وإن عدت تبعتها إلى النار","cause":"إذا قُطِعَتْ يَدُه وَقَعَتْ في النَّارِ، فإن عادَ","result":"تَبِعَها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الأحكام الوسطى 4/ 98","srcLabel":"عبد الرزاق","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قَطَعَ رَجُلًا، ثُمَّ أمَرَ به فحُسِمَ، ثُمَّ قالَ: \"تُبْ إلى اللهِ\"، قالَ: أَتوبُ إلى اللهِ، فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: \"",["إذا قُطِعَتْ يَدُه وَقَعَتْ في النَّارِ، فإن عادَ",1]," ",["تَبِعَها",2],"، وإن تابَ اسْتَشْلاها\".\nقالَ عَبْدُ الرَّزَّاقِ: يقولُ: اسْتَرْجَعَها."],"grade":"صحيح","narrator":"ابن المنكدر","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه عبد الرزاق (13585) واللفظ له","bab":"توبة › الحض على التوبة","dorar":"b6AtCVgU"},{"id":"س-03923","fp":"305f2e867677","stateId":744,"easy":"إذا نوقشت الحساب ← عُذبت","cause":"مَن حُوسِبَ","result":"عُذِّبَ","explicit":true,"star":true,"ref":"الصحيح المسند 1584","srcLabel":"متفق عليه","text":["قُلْتُ: يا رَسولَ اللهِ، إنِّي لَأَعلَمُ أَشَدَّ آيةٍ في كِتابِ اللهِ عَزَّ وجَلَّ، قالَ: «أيَّةُ آيةٍ يا عائِشةُ؟»، قالَتْ: قَوْلُ اللهِ تَعالى: {مَنْ يَعْمَلْ سُوءًا يُجْزَ بِهِ}، قالَ: «أَمَا عَلِمْتِ يا عائِشةُ أنَّ المُؤمِنَ تُصيبُه النَّكْبةُ أو الشَّوْكةُ فيُكافَأُ بأَسوَأِ عَمَلِه، و",["مَن حُوسِبَ",1]," ",["عُذِّبَ",2],"؟»، قالَتْ: أليس اللهُ يقولُ: {فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا}، قالَ: «ذاكم العَرْضُ يا عائِشةُ، مَن نُوقِشَ الحِسابَ عُذِّبَ»."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"حسن على شرط مُسلِم","takhrij":"أخرجه أبو داود (3093) واللفظ له، والبخاري (103)، ومسلم (2876) بنحوه.","bab":"تفسير آيات › سورة النساء","dorar":"UWkx5CGr","merged":3,"otherRefs":["صحيح البخاري 103 (صحيح)","تخريج المسند لشعيب 24958 (صحيح)"]},{"id":"س-07866","fp":"6efe5ea5e943","stateId":744,"easy":"إذا نوقشت الحساب ← هلكت","cause":"نوقشَ الحسابَ","result":"هلَكَ","explicit":true,"star":true,"ref":"الزواجر عن اقتراف الكبائر 2/242","srcLabel":"متفق عليه","text":["من ",["نوقشَ الحسابَ",1]," ",["هلَكَ",2]," [يعني حديث: ليسَ أحَدٌ يُحاسَبُ إلَّا هَلَكَ قالَتْ: قُلتُ: يا رَسولَ اللَّهِ جَعَلَنِي اللَّهُ فِداءَكَ، أليسَ يقولُ اللَّهُ عزَّ وجلَّ: {فَأَمَّا مَن أُوتِيَ كِتابَهُ بيَمِينِهِ فَسَوْفَ يُحاسَبُ حِسابًا يَسِيرًا} قالَ: ذاكَ العَرْضُ يُعْرَضُونَ ومَن نُوقِشَ الحِسابَ هَلَكَ.]"],"grade":"صحيح","narrator":"[عائشة أم المؤمنين]","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (4939) مطولاً، ومسلم (2876) واللفظ له","bab":"قيامة › الحساب والقصاص","dorar":"EdZcaJif","merged":2,"otherRefs":["تخريج كتاب السنة 885 (صحيح)"]},{"id":"س-03253","fp":"40a29f831d57","stateId":744,"easy":"إذا أدركت رمضان فلم يُغفر لك فدخلت النار ← أبعدك الله","cause":"من أدركَ شهرَ رمضانَ فلم يُغفرْ لهُ","result":"فدخلَ النارَ فأبعدَهُ اللهُ","explicit":true,"star":true,"otherNeedIds":[57],"ref":"موارد الظمآن 2/900","srcLabel":"مسلم","text":["أنَّ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ صعدَ المنبَرَ ، فقال : آمينَ ، آمينَ ، آمينَ ، قيلَ : يا رسولَ اللهِ ، إنكَ صعدتَ المنبَرَ ، فقلتُ آمينَ ، آمينَ ، آمينَ ، فقال : إنَّ جبريلَ عليهِ السلامُ أتاني ، فقالَ لي : ",["من أدركَ شهرَ رمضانَ فلم يُغفرْ لهُ ، ",1],["فدخلَ النارَ فأبعدَهُ اللهُ",2]," ، قلْ : آمينَ ، فقلتُ : آمينَ ، ومن أدركَ أبويْهِ ، أو أحدَهما ، فلم يَبَرَّهما ، فماتَ ، فدخلَ النارَ ، فأبعدَهُ اللهُ ، قلْ : آمينَ ، فقلتُ : آمينَ ، ومن ذُكِرْتَ عندَهُ ، فلم يُصَلِّ عليكَ ، فماتَ ، فدخلَ النارَ ، فأبعدَهُ اللهُ ، قلْ آمينَ ، فقلتُ : آمينَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"في صحيح مسلم منه ما يتعلق ببر الوالدين بنحوه فقط","takhrij":"أخرجه ابن خزيمة (1888)، وابن حبان (907)، والطبراني في ((المعجم الأوسط)) (8131) باختلاف يسير. وقوله: \"ومن أدرك أبويه أو أحدهما فلم يبرهما فمات فدخل النار فأبعده الله\" أخرجه مسلم (2551) بلفظ مقارب","bab":"استغفار › أسباب المغفرة","dorar":"wrNPaZCt"},{"id":"ق-0843","fp":"789b8447c043","stateId":744,"easy":"خفة الموازين ← خسران النفس والخلود في جهنم","cause":"خفة الموازين","result":"خسران النفس والخلود في جهنم","explicit":true,"star":true,"otherNeedIds":[57],"ref":"سورة المؤمنون: 103","srcLabel":"القرآن الكريم","quran":{"s":23,"from":103,"to":103,"text":"وَمَنْ خَفَّتْ مَوَازِينُهُ فَأُولَئِكَ الَّذِينَ خَسِرُوا أَنْفُسَهُمْ فِي جَهَنَّمَ خَالِدُونَ (103)","hl":[[0,96,1]]}},{"id":"ق-1456","fp":"2589a8c1f999","stateId":744,"easy":"خفة الموازين ← أمّه هاوية","cause":"خفة الموازين","result":"أمّه هاوية","explicit":true,"ref":"سورة القارعة: 8–9","srcLabel":"القرآن الكريم","quran":{"s":101,"from":8,"to":9,"text":"وَأَمَّا مَنْ خَفَّتْ مَوَازِينُهُ (8) فَأُمُّهُ هَاوِيَةٌ (9)","hl":[[0,58,1]]}},{"id":"س-06918","fp":"2961f8ebe365","stateId":744,"easy":"إذا أمنت الله في الدنيا ← يخيفك في الآخرة","cause":"إذا أمِنني في الدُّنيا","result":"أخفتُه في الآخرةِ","explicit":true,"ref":"الترغيب والترهيب 4/209","srcLabel":"ابن حبان","text":["عن النَّبيِّ صلَّى اللهُ عليه وسلَّم فيما يَروي عن ربِّه جلَّ وعلا أنَّه قال : وعِزَّتي لا أجمعُ على عبدي خوفَيْن وأمنَيْن : إذا خافني في الدُّنيا أمَّنتُه يومَ القيامةِ ، و",["إذا أمِنني في الدُّنيا",1]," ",["أخفتُه في الآخرةِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن حبان (640)، والبيهقي في ((شعب الإيمان)) (759) كلاهما بلفظه، والبزار (8029) باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"rtOiudlK","merged":2,"otherRefs":["السلسلة الصحيحة 742 (صحيح)"]},{"id":"س-07467","fp":"2e5239915b99","stateId":744,"easy":"إذا كنت يوم القيامة ← يكون عرقك على قدر عملك","cause":"فيكونونَ في العرَقِ كقَدْرِ أعمالِهم","result":"فمنهم مَن يأخُذُه إلى عقِبَيْهِ","explicit":true,"ref":"تخريج صحيح ابن حبان 7330","srcLabel":"الترمذي","text":["إذا كان يومُ القيامةِ أُدنِيَتِ الشَّمشُ مِن العبادِ حتَّى تكونَ قِيدَ مِيلٍ أو مِيلَيْنِ ) قال سُلَيمٌ : لا أدري أيَّ المِيلينَ يعني أمسافةَ الأرضِ أمِ المِيلَ الَّذي تُكحَلُ به العَينُ ؟ قال : ( فتصهَرُهم الشَّمسُ ",["فيكونونَ في العرَقِ كقَدْرِ أعمالِهم",1]," ",["فمنهم مَن يأخُذُه إلى عقِبَيْهِ",2]," ومنهم مَن يأخُذُه إلى رُكبتَيْهِ ومنهم مَن يأخُذُه إلى حِقْوَيْهِ ومنهم مَن يُلجِمُه إلجامًا ) قال : فرأَيْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم وهو يُشيرُ بيدِه إلى فيه يقولُ : ( يُلجِمُهم إلجامًا )"],"grade":"صحيح","narrator":"المقداد","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (2421)، وأحمد (23813)، وابن حبان (7330)، وابن المبارك في ((مسنده)) (95) جميعا بلفظه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"lGqSnh5r","merged":2,"otherRefs":["إتحاف الخيرة المهرة 8/165 (حسن)"]},{"id":"س-07796","fp":"fb74f2df1566","stateId":744,"easy":"إذا أُعطيتم فلم تشكروا وابتُليتم فلم تصبروا ← فالفساق هم أهل النار","cause":"إذا أُعطِينَ لم يشكُرْنَ وإن ابتُلِينَ لم يصبِرْنَ","result":"إنَّ الفُسَّاقَ هم أهلُ النَّارِ","explicit":true,"ref":"مجمع الزوائد 8/39","srcLabel":"أحمد","text":["تعلَّموا القرآنَ فإذا علِمْتُموه فلا تغلُوا فيه ولا تجفُوا عنه ولا تأكُلوا به ولا تستكثِروا به ثُمَّ قال إنَّ التُّجَّارَ همُ الفُجَّارُ قالوا يا رسولَ اللهِ أليس قد أحلَّ اللهُ البيعَ وحرَّم الرِّبا قال بلى ولكنَّهم يحلِفونَ ويأثَمونَ ثُمَّ قال ",["إنَّ الفُسَّاقَ هم أهلُ النَّارِ",2]," قالوا يا رسولَ اللهِ مَن الفُسَّاقُ قال النِّساءُ قالوا أو ليس أمَّهاتِنا وبناتِنا وأخواتِنا قال بلى ولكنَّهنَّ ",["إذا أُعطِينَ لم يشكُرْنَ وإن ابتُلِينَ لم يصبِرْنَ",1]," ثُمَّ قال يُسلِّمُ الرِّاكبُ على الرَّاجلِ والرَّاجلُ على الجالسِ والأقلُّ على الأكثرِ فمَن أجاب السَّلامَ كان له ومَن لم يُجِبْ فلا شيءَ له"],"grade":"صحيح","narrator":"عبدالرحمن بن شبل","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (15704)، وعبد بن حميد في ((مسنده)) (314)، والبيهقي (2362)","bab":"قرآن › تعلم القرآن وتعليمه","dorar":"1qQvD5R8","merged":2,"otherRefs":["تخريج المسند لشعيب 15531 (صحيح)"]},{"id":"س-01729","fp":"f3d913fc0b3c","stateId":744,"easy":"إذا لم تستحِ ← فاصنع ما شئت (فستُجزى)","cause":"إذا لم تستَحِ","result":"فافعَلْ ما شِئْتَ","explicit":true,"ref":"مجمع الزوائد 8/30","srcLabel":"أحمد","text":["إنَّ ممَّا أدرَك النَّاسُ من كلامِ النُّبوَّةِ الأولى ",["إذا لم تستَحِ",1]," ",["فافعَلْ ما شِئْتَ",2]," وفي روايةٍ إنَّ آخرَ ما تعلَّق به أهلُ الجاهليَّةِ من كلامِ النُّبوَّةِ الأولى"],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه البزار(2835) بلفظه، وأحمد (23254) باختلاف يسير، والطحاوي في ((شرح مشكل الاثار)) (1536) بنحوه","bab":"أنبياء › عام","dorar":"Ov3jOzyu"},{"id":"س-04851","fp":"dedda83a6a08","stateId":744,"easy":"إذا استصغرت الذنب ← فربما دخلت به النار","cause":"صغيرَ الذنبِ","result":"فربما به دخل النارَ","explicit":true,"ref":"الإعلام بفوائد عمدة الأحكام 4/307","srcLabel":"الإعلام بفوائد عمدة الأحكام","text":["لا يحقرن أحدُكم ",["صغيرَ الذنبِ",1]," ",["فربما به دخل النارَ",2]],"grade":"صحيح","muhaddith":"ثابت","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"2dZSQ4CW"},{"id":"س-05020","fp":"574c2da65b07","stateId":744,"easy":"إذا عصيت الله واجترأت على معصيته وخالفت طاعته ← قد تدخل النار من أهل القبلة","cause":"بِما عصَوا اللهَ واجْترَؤُا على معصيتِه ، وخالَفُوا طاعتَه","result":"يدخلُ من أهلِ هذه القِبلةِ النارَ مَن لا يُحصِي عددَهم إلا اللهُ","explicit":true,"ref":"صحيح الترغيب 3640","srcLabel":"الطبراني","text":[["يدخلُ من أهلِ هذه القِبلةِ النارَ مَن لا يُحصِي عددَهم إلا اللهُ",2]," ، ",["بِما عصَوا اللهَ واجْترَؤُا على معصيتِه ، وخالَفُوا طاعتَه",1]," ، فيُؤذنُ لِي في الشفاعةِ ، فأُثنِي على اللهِ ساجِدًا كما أُثنِي عليه قائِمًا ، فيُقالُ لِي : ارْفعْ رأسَكَ ، وسَلْ تُعْطَهْ ، واشْفعْ تُشَفَّعْ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"حسن صحيح","takhrij":"أخرجه الطبراني (13/455) (14315)، وفي ((المعجم الصغير)) (103)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"woJbWv0E"},{"id":"س-07214","fp":"af7ec56095f8","stateId":744,"easy":"إذا لم تعمل بطاعة ولم تترك لله معصية ← فلا يدخل النار إلا شقي","cause":"الَّذي لا يعمَلُ بطاعةٍ ، ولا يترُكُ للَّهِ معصيةً","result":"لا يدخُلُ النَّارَ إلَّا شقيٌّ","explicit":true,"ref":"تخريج المسند لشاكر 16/245","srcLabel":"ابن ماجه","text":[["لا يدخُلُ النَّارَ إلَّا شقيٌّ",2]," ، قيلَ : ومَنِ الشَّقيُّ ؟ قالَ : ",["الَّذي لا يعمَلُ بطاعةٍ ، ولا يترُكُ للَّهِ معصيةً",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (8594) بلفظه، وابن ماجه (4298) بلفظ مقارب.","bab":"علم › حسن السؤال ونصح العالم","dorar":"Y4k8y4Lo"},{"id":"س-02758","fp":"cfcc83ac05cd","stateId":744,"easy":"إذا ساءت أعمالك ← تخطفك كلاليب الصراط","cause":"بأَعمالِهم","result":"تَخطَفُ النَّاسَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشعيب 7927","srcLabel":"متفق عليه","text":["المعنى: أنَّ النَّاسَ قالوا لرسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا رسولَ اللهِ، هل نَرى رَبَّنا عزَّ وجلَّ يَومَ القِيامَةِ؟ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: هل تُضارُّون في القَمَرِ لَيلةَ البَدْرِ؟ قالوا: لا يا رسولَ اللهِ. قال: فهل تُضارُّون في الشَّمسِ ليس دونَها سَحابٌ؟ قالوا: لا. قال: فإنَّكم تَرَوْنه كذلك، يَجمَعُ اللهُ النَّاسَ يَومَ القِيامَةِ، فيُقالُ: مَن كان يَعبُدُ شَيئًا فليَتبَعْه، فيَتبَعُ مَن يَعبُدُ الشَّمسَ الشَّمسَ، ويَتبَعُ مَن يَعبُدُ القَمرَ القَمرَ، ويَتبَعُ مَن يَعبُدُ الطَّواغيتَ الطَّواغيتَ، وتَبقى هذه الأُمَّةُ فيها شافِعوها، أو مُنافِقوها -قال أبو كامِلٍ: شَكَّ إبراهيمُ- فيَأتيهم اللهُ عزَّ وجلَّ في صورَةٍ غَيرِ صورَتِه الَّتي يَعرِفون، فيَقولُ: أنا رَبُّكم. فيَقولون: نَعوذُ باللهِ مِنك، هذا مَكانُنا حتى يَأتِيَنا رَبُّنا، فإذا جاء رَبُّنا عَرَفْناه. فيَأتيهم اللهُ عزَّ وجلَّ في صورَتِه الَّتي يَعرِفون، فيَقولُ: أنا رَبُّكم. فيَقولون: أنت رَبُّنا. فيَتبَعونه. ويُضرَبُ الصِّراطُ بيْنَ ظَهرَيْ جَهنَّمَ، فأَكونُ أنا وأُمَّتي أَوَّلَ مَن يَجوزُه، ولا يتكَلَّمُ يَومَئذٍ إلَّا الرُّسلُ، ودَعوى الرُّسلِ يَومَئذٍ: اللَّهمَّ سَلِّمْ سَلِّمْ. وفي جَهنَّمَ كَلاليبُ مِثلُ شَوكِ السَّعْدانِ، هل رأَيتُم السَّعْدانَ؟ قالوا: نعم يا رسولَ اللهِ. قال: فإنَّها مِثلُ شَوكِ السَّعْدانِ، غَيرَ أنَّه لا يَعلَمُ قَدرَ عِظَمِها إلَّا اللهُ تَعالى، ",["تَخطَفُ النَّاسَ",2]," ",["بأَعمالِهم",1],"، فمِنهم الموبَقُ بِعَملِه -أو قال: الموثَقُ بِعَملِه أو المُخَردَلُ-، ومنهم المُجازى -قال أبو كامِلٍ في حَديثِهِ: شَكَّ إبراهيمُ- ومنهم المُخَردَلُ أو المُجازى ثم يتجَلَّى، حتى إذا فرَغَ اللهُ عزَّ وجلَّ مِن القَضاءِ بيْنَ العِبادِ، وأرادَ أنْ يُخرِجَ برَحمَتِه مَن أرادَ مِن أَهلِ النَّارِ أمَرَ الملائكةَ أنْ يُخرِجوا مِن النَّارِ مَن كان لا يُشرِكُ باللهِ شيئًا، ممَّن أرادَ اللهُ أنْ يَرحَمَه، ممَّن يَقولُ: لا إلهَ إلَّا اللهُ، فيَعرِفونَهم في النَّارِ، يَعرِفونَهم بأَثَرِ السُّجودِ، تَأكُلُ النَّارُ ابنَ آدَمَ إلَّا أَثَرَ السُّجودِ، وحرَّمَ اللهُ عزَّ وجلَّ على النَّارِ أنْ تَأكُلَ أَثَرَ السُّجودِ، فيَخرُجون مِن النَّارِ قد امتُحِشوا فيُصَبُّ عليهم ماءُ الحياةِ، فيَنبُتون كما تَنبُتُ الحبَّةُ -وقال أبو كامِلٍ: الحبَّةُ، أَيضًا- في حَميلِ السَّيلِ. ويَبقى رَجُلٌ مُقبِلٌ بوَجهِه على النَّارِ، وهو آخِرُ أَهلِ الجنَّةِ دُخولًا، فيَقولُ: أَيْ رَبِّ، اصرِفْ وَجهي عن النَّارِ؛ فإنَّه قد قشَبَني رِيحُها، وأحرَقَني دُخَانُها، فيَدعو اللهَ ما شاءَ أنْ يَدعُوَه، ثم يَقولُ اللهُ عزَّ وجلَّ: هل عسَيْتَ إنْ فُعِلَ ذلك بك أنْ تَسأَلَ غَيرَه؟ فيَقولُ: لا وعِزَّتِك لا أَسأَلُ غَيرَه. ويُعطي رَبَّه عزَّ وجلَّ مِن عُهودٍ ومَواثيقَ ما شاءَ، فيَصرِفُ اللهُ عزَّ وجلَّ وَجهَه عن النَّارِ، فإذا أقبَلَ على الجنَّةِ ورآها؛ سكَتَ ما شاء اللهُ أنْ يَسكُتَ، ثم يَقولُ: أَي رَبِّ، قَرِّبْني إلى بابِ الجنَّةِ، فيَقولُ اللهُ عزَّ وجلَّ له: أَلستَ قد أعطَيْتَ عُهودَك ومَواثيقَك أَلَّا تَسأَلَني غَيرَ ما أعطَيتُكَ؟ وَيْلَكَ يا ابنَ آدَمَ، ما أَغدَرَكَ! فيَقولُ: أَيْ رَبِّ، فيَدعو اللهَ، حتى يَقولَ له: فهل عسَيْتَ إنْ أُعطيتَ ذلك أنْ تَسأَلَ غَيرَه؟ فيَقولُ: لا وَعِزَّتِكَ لا أَسأَلُ غَيرَه. فيُعطي رَبَّه عزَّ وجلَّ ما شاء مِن عُهودٍ ومَواثيقَ، فيُقَدِّمُه إلى بابِ الجنَّةِ، فإذا قام على باب الجنَّةِ انفهَقَتْ له الجنَّةُ، فرأى ما فيها مِن الحِبَرَةِ والسُّرورِ، فيَسكُتُ ما شاء اللهُ أنْ يَسكُتَ، ثم يَقولُ: أَي رَبِّ، أَدخِلْني الجنَّةَ. فيَقولُ اللهُ عزَّ وجلَّ له: أليس قد أعطَيْتَ عُهودَك ومَواثيقَك أَلَّا تَسأَلَني غَيرَ ما أعطَيتُكَ؟ وَيْلَك يا ابنَ آدَمَ، ما أَغدَرَك! فيَقولُ: أَيْ رَبِّ، لا أَكونُ أَشقى خَلقِكَ، فلا يَزالُ يَدعو اللهَ، حتى يَضحَكَ اللهُ منه، فإذا ضحِكَ اللهُ عزَّ وجلَّ منه قال: ادخُلِ الجنَّةَ. فإذا دخَلَها قال اللهُ عزَّ وجلَّ له: تَمَنَّه. فيَسأَلُ رَبَّه عزَّ وجلَّ ويتمَنَّى، حتى إنَّ اللهَ عزَّ وجلَّ ليُذَكِّرُه، يَقولُ: مِن كذا وكذا، حتى إذا انقطَعَتْ به الأَمانِيُّ؛ قال اللهُ عزَّ وجلَّ له: لك ذلك ومِثلُه معه. قال عطاءُ بنُ يَزيدَ: وأبو سَعيدٍ الخُدرِيُّ مع أبي هُريرةَ، لا يَرُدُّ عليه مِن حَديثِه شَيئًا، حتى إذا حدَّثَ أبو هُريرةَ أنَّ اللهَ عزَّ وجلَّ قال لذلك الرَّجُلِ: ومِثلُه معه. قال أبو سعيدٍ: وعَشَرةُ أَمثالِه معه يا أبا هُريرةَ. قال أبو هُريرةَ: ما حفِظْتُ إلَّا قَولَه: ذلك لك ومِثلُه معه. قال أبو سعيدٍ: أَشهَدُ أنِّي حفِظْتُ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ قَولَه في ذلك الرَّجُلِ: لك عَشَرةُ أَمثالِه. قال أبو هُريرةَ: وذلك الرَّجُلُ آخِرُ أَهلِ الجنَّةِ دُخولًا."],"grade":"صحيح","narrator":"أبو هريرة وأبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (7437)، ومسلم (182) باختلاف يسير","bab":"إيمان › الملائكة","dorar":"xsDQipBf","merged":3,"otherRefs":["تخريج صحيح ابن حبان 7429 (صحيح)","فوائد الحنائي الحنائيات 2/865 (صحيح)"]},{"id":"س-02744","fp":"ba48fb0f4fcf","stateId":744,"easy":"إذا كثرت ذنوبك وخطاياك ← تحترق على الصراط","cause":"بذُنوبٍ وخَطايا","result":"يَحترِقون، فيكونونَ فَحْمًا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[13],"ref":"المستدرك على الصحيحين 8963","srcLabel":"متفق عليه","text":["يُجمَعُ النَّاسُ عِندَ جِسرِ جَهنَّمَ عليه حَسَكٌ وكَلاليبُ، ويَمُرُّ النَّاسُ؛ فيَمُرُّ منهم مِثلَ البرْقِ، وبعضُهم مِثلَ الفرَسِ المُضَمَّرِ، وبعضُهم يَسْعى، وبعضُهم يَمْشي، وبعضُهم يَزحَفُ، والملائكةُ بجَنبَتَيْه تقولُ: اللَّهمَّ سَلِّم سَلِّم، والكَلاليبُ تَخطِفُهم، قال: وأمَّا أهلُها الَّذين همْ أهلُها فلا يَموتونَ ولا يَحْيَون، وأمَّا أُناسٌ يُؤخَذون ",["بذُنوبٍ وخَطايا",1]," ",["يَحترِقون، فيكونونَ فَحْمًا",2],"، فيُؤخَذون ضِباراتٍ ضِباراتٍ، فيُقذَفون على نَهرٍ مِنَ الجنَّة، فيَنبُتون كما تَنبُتُ الحِبَّةُ في حَمِيلِ السَّيلِ، قال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: هلْ رأيْتُم السَّفعاءَ؟ ثمَّ إنَّهم بعْدُ يُؤذَن لهم، فيَدخُلون الجنَّةَ. قال أبو سَعيدٍ: فيُعطى أحدُهم مِثلَ الدُّنيا، قال: وعلى الصِّراطِ ثلاثُ شَجَراتٍ، فيكونُ آخِرُ مَن يَخرُجُ مِنَ النَّار على شَفَتِها، فيَقولُ: يا ربِّ، قَدِّمني إلى هذه الشَّجرةِ، أكونُ في ظِلِّها وآكُلُ مِن ثَمرِها، قال: فيَقولُ: عَهْدُك وذِمَّتُك أنْ تَسأَلَني غيْرَها، فيُحَوَّلُ إليها، ثمَّ يَرى أُخرى أحسَنَ منها، فيَقولُ مِثلَ ذلك، فيَقولُ: عَهْدُك وذِمَّتُك لا تَسأَلُني غيْرَها، فيَقولُ: عَهْدي وذِمَّتي لا أسْأَلُ غيْرَها، فيُحوَّلُ إليها، فيَرى أُخرى أحسَنَ منها، فيَقولُ: يا ربِّ، آكُلُ مِن ثَمرِها وأكونُ في ظِلِّها، فيُحوَّلُ إليها، قال: فيَسمَعُ أصواتَ النَّاسِ ويَرى سَوادَهم، فيَقولُ: يا ربِّ، أدْخِلْني الجنَّةَ. قال أبو سَعيدٍ: ثمَّ ذكَرَ على أثَرِه أصحابَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، ذكَرَها فقال أحدُهما: يُعطى مِثلَ الدُّنيا ومِثلَها معها، وقال آخَرُ: مِثلَ الدُّنيا وعشْرَ أمثالِها."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح على شرط مسلم ولم يخرجاه","takhrij":"أخرجه أحمد (11200)، وابن حبان (7379) كلاهما بنحوه، وأصل الحديث في صحيح البخاري (7439)، ومسلم (183) .","bab":"إيمان › الملائكة","dorar":"UBAehUKm"},{"id":"س-03219","fp":"2798c4e439e1","stateId":744,"easy":"إذا عصيت ← تُعذّب بذنوبك ما شاء الله ثم تخرج","cause":"بذُنوبهم","result":"يُعَذَّبونَ بذُنوبهم فيَكونونَ في النَّارِ ما شاءَ اللهُ أن يَكونوا","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"فتح البيان 7/ 145","srcLabel":"البخاري","text":["إنَّ ناسًا مِن أُمَّتي ",["يُعَذَّبونَ بذُنوبهم فيَكونونَ في النَّارِ ما شاءَ اللهُ أن يَكونوا",2],"، ثُمَّ يُعَيِّرُهم أهلُ الشِّركِ فيَقولونَ: ما نَرى ما كُنتُم فيه مِن تَصديقِكُم نَفعَكُم! فلا يَبقى أحَدٌ إلَّا أخرَجَه اللهُ مِنَ النَّارِ. ثُمَّ قَرَأ رَسولُ اللهِ صلَّى الله عليه وسلَّم هذه الآيةَ."],"grade":"صحيح","narrator":"جابر بن عبد الله","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (11207)، والطبراني في ((المعجم الأوسط)) (5146) بلفظه، والبخاري (6558) بنحوه.","bab":"إيمان › فضل الإيمان","dorar":"QheIfOLJ"},{"id":"س-03343","fp":"508e9a971f70","stateId":744,"easy":"إذا أصررت على الذنب وأنت تعلم ← فويل لك","cause":"للمُصِرِّينَ الذين يُصِرُّون على ما فَعلوا و هم يعلَمون","result":"و ويلٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[13],"ref":"السلسلة الصحيحة 482","srcLabel":"البخاري","text":["ارْحَموا تُرْحَموا ، و اغفِروا يغْفِرِ اللهُ لكم ، ",["و ويلٌ",2]," لأقماعِ القولِ ، و ويلٌ ",["للمُصِرِّينَ الذين يُصِرُّون على ما فَعلوا و هم يعلَمون",1]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6541)، والبخاري في ((الأدب المفرد)) (380)، والطبراني (13/651) (14579)","bab":"استغفار › أسباب المغفرة","dorar":"M1X8iz28"},{"id":"س-01797","fp":"4a088c41c5f0","stateId":744,"easy":"إذا عملت المنكر ← يلازمك يوم القيامة","cause":"وأمَّا المنكرَ","result":"فيقولُ إليكم إليكم وما يستطيعونَ لَهُ إلَّا لُزَومًا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"مجمع الزوائد 7/265","srcLabel":"أحمد","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم والَّذِي نَفْسُ محمدٍ بيدِهِ إنَّ المعروفَ والمنكَرَ لَخَلِيقَتَانِ يُنْصَبانِ للناسِ يومَ القيامةِ فأَمَّا المعروفُ فيُبَشِّرُ أصحابَهُ ويوعِدُهم الخيرَ ",["وأمَّا المنكرَ",1]," ",["فيقولُ إليكم إليكم وما يستطيعونَ لَهُ إلَّا لُزَومًا",2]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (19487)، والطيالسي (537)، وابن أبي الدنيا في ((اصطناع المعروف)) (16)، والطبراني في ((المعجم الأوسط)) (8925) واللفظ لهم.","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"36Ag1uXp"},{"id":"س-08230","fp":"cd457f216c69","stateId":744,"easy":"إذا أصبت الذنوب ← تأخذ منك النار على الصراط","cause":"بذُنوبٍ أصابها","result":"وتأخُذُ النَّارُ منه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[13],"ref":"المصابيح في الأحاديث المتواترة 599","srcLabel":"المصابيح في الأحاديث المتواترة","text":["إنَّ على جهنَّمَ جِسرًا أدَقَّ من الشَّعرِ وأحَدَّ من السَّيفِ، أعلاه نحوُ الجنَّةِ دَحْضٌ مَزَلَّةٌ، بجنبيه كلاليبُ وحسَكُ النَّارِ، يحشُرُ اللهُ به من يشاءُ من عبادِه، الزَّالُّون والزَّالَّاتُ يومئذٍ كثيرٌ، والملائكةُ بجانبَيه قيامٌ يُنادونَ: اللَّهُمَّ سَلِّم سَلِّم، فمن جاء بالحقِّ جاز، ويُعطَونَ النُّورَ يومَئذٍ على قَدرِ أعمالِهم وإيمانِهم، منهم من يمضي عليه كلَمحِ البَرقِ، ومنهم من يَمضي عليه كمَرِّ الرِّيحِ، ومنهم من يُعطى نورًا إلى موضِعِ قَدَميه، ومنهم من يحبو حبوًا ",["وتأخُذُ النَّارُ منه",2]," ",["بذُنوبٍ أصابها",1],"، وهي تحرِقُ من يشاءُ اللهُ منهم على قَدرِ ذُنوبِهم حتَّى ينجوَ، وتنجو أوَّلُ زُمرةٍ سبعونَ ألفًا لا حِسابَ عليهم ولا عذابَ، كأنَّ وُجوهَهم القَمَرُ ليلةَ البدرِ، والذين يلونَهم كأضوأِ نَجمٍ في السَّماءِ حتَّى يَبلُغوا إلى الجنَّةِ برحمةِ اللهِ تعالى"],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"ملائكة › أعمال الملائكة","dorar":"ftBFF8cJ"},{"id":"س-08231","fp":"43d24e8023dc","stateId":744,"easy":"إذا عصيت ← تحرقك النار على قدر ذنوبك","cause":"على قَدرِ ذُنوبِهم","result":"تحرِقُ من يشاءُ اللهُ منهم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[13],"ref":"المصابيح في الأحاديث المتواترة 599","srcLabel":"المصابيح في الأحاديث المتواترة","text":["إنَّ على جهنَّمَ جِسرًا أدَقَّ من الشَّعرِ وأحَدَّ من السَّيفِ، أعلاه نحوُ الجنَّةِ دَحْضٌ مَزَلَّةٌ، بجنبيه كلاليبُ وحسَكُ النَّارِ، يحشُرُ اللهُ به من يشاءُ من عبادِه، الزَّالُّون والزَّالَّاتُ يومئذٍ كثيرٌ، والملائكةُ بجانبَيه قيامٌ يُنادونَ: اللَّهُمَّ سَلِّم سَلِّم، فمن جاء بالحقِّ جاز، ويُعطَونَ النُّورَ يومَئذٍ على قَدرِ أعمالِهم وإيمانِهم، منهم من يمضي عليه كلَمحِ البَرقِ، ومنهم من يَمضي عليه كمَرِّ الرِّيحِ، ومنهم من يُعطى نورًا إلى موضِعِ قَدَميه، ومنهم من يحبو حبوًا وتأخُذُ النَّارُ منه بذُنوبٍ أصابها، وهي ",["تحرِقُ من يشاءُ اللهُ منهم",2]," ",["على قَدرِ ذُنوبِهم",1]," حتَّى ينجوَ، وتنجو أوَّلُ زُمرةٍ سبعونَ ألفًا لا حِسابَ عليهم ولا عذابَ، كأنَّ وُجوهَهم القَمَرُ ليلةَ البدرِ، والذين يلونَهم كأضوأِ نَجمٍ في السَّماءِ حتَّى يَبلُغوا إلى الجنَّةِ برحمةِ اللهِ تعالى"],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"ملائكة › أعمال الملائكة","dorar":"ftBFF8cJ"},{"id":"س-00215","fp":"b3f4766cd7ef","stateId":745,"easy":"إذا اضطجعت على وجهك ← فهي ضجعة أهل النار","cause":"مُنْبَطِحًا على وَجْهِه","result":"هذه ضِجْعةٌ أهْلِ النَّارِ","explicit":true,"star":true,"otherNeedIds":[27],"ref":"الأحاديث المختارة 8 / 136","srcLabel":"متفق عليه","text":["«أخْبَرَني أبي أنَّه ضافَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ معَ نَفَرٍ، فبِتْنا عِنْدَه فخَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يَطَّلِعُ فرآه ",["مُنْبَطِحًا على وَجْهِه",1],"، فرَكَضَه برِجْلِه فأيْقَظَه وقالَ: (",["هذه ضِجْعةٌ أهْلِ النَّارِ",2],")."],"grade":"صحيح","narrator":"طخفة الغفاري","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"آداب المجلس › إكرام الضيف","dorar":"UScEPddg"},{"id":"س-04567","fp":"486617217da9","stateId":745,"easy":"إذا نمت في المسجد منبطحاً على وجهك ← فهي نومة جهنمية","cause":"نائمٍ في المسجدِ مُنبطِحٍ على وَجهِه","result":"فإنَّها نَومةٌ جَهنَّميَّةٌ","explicit":true,"star":true,"otherNeedIds":[27],"ref":"تخريج المسند لشعيب 32/209","srcLabel":"البخاري","text":["مَرَّ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ على رَجُلٍ ",["نائمٍ في المسجدِ مُنبطِحٍ على وَجهِه",1],"، فضَرَبَه برِجلِه، وقال: قُمْ، واقعُدْ؛ ",["فإنَّها نَومةٌ جَهنَّميَّةٌ",2],"."],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن ماجه (3725) واللفظ له، والبخاري في ((الأدب المفرد)) (1188)","bab":"جهنم › صفة عذاب أهل النار","dorar":"LHZDGytQ"},{"id":"س-04194","fp":"4f359fdff585","stateId":745,"easy":"إذا تخطيت رقاب الناس يوم الجمعة ← فكالجار قصبه في النار","cause":"إنَّ الذي يَتخَطى رقابَ الناسِ يومَ الجمعةِ، و يفرقُ بين اثنينِ بعدَ خروجِ الإمامِ","result":"كالْجَارِّ قُصْبَهُ في النارِ","explicit":true,"ref":"الجامع الصغير 2085","srcLabel":"أحمد","text":[["إنَّ الذي يَتخَطى رقابَ الناسِ يومَ الجمعةِ، و يفرقُ بين اثنينِ بعدَ خروجِ الإمامِ",1],"،  ",["كالْجَارِّ قُصْبَهُ في النارِ",2]],"grade":"صحيح","narrator":"الأرقم بن أبي الأرقم","muhaddith":"صحيح","takhrij":"أخرجه أحمد (15447)، والطبراني في ((المعجم الكبير)) (1/ 307) (908)، والحاكم (6132) جميعهم بلفظه.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"CGI08d3s","merged":2,"otherRefs":["مختصر الأحكام 3/30 (حسن)"]},{"id":"س-07961","fp":"3652b878d359","stateId":745,"easy":"إذا تنخمت في القبلة ← تأتي يوم القيامة وهي في وجهك","cause":"صاحبُ النُّخامةِ في القِبلةِ","result":"يومَ القيامةِ، و هي في وجهِهِ","explicit":true,"ref":"الوهم والإيهام 5/680","srcLabel":"ابن حبان","text":["حديثُ الَّذي يبصُقُ في القِبلةِ [يعني حديث: يُبعثُ ",["صاحبُ النُّخامةِ في القِبلةِ",1]," ",["يومَ القيامةِ، و هي في وجهِهِ",2],"]"],"grade":"صحيح","narrator":"[عبدالله بن عمر]","muhaddith":"صحيح","takhrij":"أخرجه ابن خزيمة (1313)، وابن حبان (1638)، وابن الأعرابي في ((معجمه)) (2345) بنحوه.","bab":"مساجد ومواضع الصلاة › البزاق في المسجد","dorar":"7SOCsL4b","merged":2,"otherRefs":["صحيح الجامع 2910 (صحيح)"]},{"id":"س-01590","fp":"5c314999e0f8","stateId":745,"easy":"إذا تفلت تجاه القبلة ← تأتي يوم القيامة وتفلتك بين عينيك","cause":"مَن تَفَلَ تِجاهَ القِبلةِ","result":"جاءَ يَومَ القيامةِ تَفلُه بَينَ عَينَيْه","explicit":true,"ref":"تخريج سنن أبي داود 3824","srcLabel":"أبو داود","text":["أظُنُّه قال: عن رَسولِ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ قال: ",["مَن تَفَلَ تِجاهَ القِبلةِ ",1],["جاءَ يَومَ القيامةِ تَفلُه بَينَ عَينَيْه، ",2],"ومَن أكَلَ مِن هذه البَقلةِ الخَبيثةِ فلا يَقرَبَنَّ مَسجِدَنا ثَلاثًا."],"grade":"صحيح","narrator":"حذيفة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3824)، وابن خزيمة (1663)، والبيهقي (5121) واللفظ لهم.","bab":"أطعمة › أكل الثوم والبصل والكراث","dorar":"5iYlsrIn"},{"id":"س-04843","fp":"34d4e6cc49ae","stateId":745,"easy":"إذا تخطيت رقاب الناس يوم الجمعة ← اتخذت جسراً إلى جهنم","cause":"من تَخَطَّى رقابَ الناسِ يومَ الجمعةِ","result":"اتخَذ جِسْرًا إلى جهنمَ","explicit":true,"ref":"هداية الرواة 1337","srcLabel":"الترمذي","text":[["من تَخَطَّى رقابَ الناسِ يومَ الجمعةِ ؛ ",1],["اتخَذ جِسْرًا إلى جهنمَ",2]],"grade":"صحيح","narrator":"معاذ بن أنس","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (513)، وابن ماجه (1116) واللفظ لهما، وأحمد (15609) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"2nhcozGV"},{"id":"س-07957","fp":"1fd9887ec69a","stateId":745,"easy":"إذا بصقت في القبلة ولم تواريها ← تأتي يوم القيامة أحمى ما تكون بين عينيك","cause":"مَن بَصق في قبلةٍ ولم يوارِها","result":"جاءَت يومَ القيامةِ أحمى ما تَكونُ حتَّى تقَعَ بينَ عَينيهِ","explicit":true,"ref":"الترغيب والترهيب 1/161","srcLabel":"الطبراني","text":[["مَن بَصق في قبلةٍ ولم يوارِها ",1],["جاءَت يومَ القيامةِ أحمى ما تَكونُ حتَّى تقَعَ بينَ عَينيهِ",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني (8/293) (7960) باختلاف يسير.","bab":"مساجد ومواضع الصلاة › البزاق في المسجد","dorar":"G8fZp6G0"}]}