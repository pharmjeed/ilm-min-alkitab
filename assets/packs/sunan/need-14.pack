{"schema":1,"kind":"sunan-chunk","version":"sunan-b41390b43331","needId":14,"stateIds":[148,149,150,151,152],"items":[{"id":"ق-0221","fp":"67c53b8421af","stateId":148,"easy":"الشرك بالله ← لا يُغفر وهو إثم عظيم","cause":"الشرك بالله","result":"لا يُغفر وهو إثم عظيم","explicit":true,"star":true,"otherNeedIds":[69],"ref":"سورة النساء: 48","srcLabel":"القرآن الكريم","quran":{"s":4,"from":48,"to":48,"text":"إِنَّ اللَّهَ لَا يَغْفِرُ أَنْ يُشْرَكَ بِهِ وَيَغْفِرُ مَا دُونَ ذَلِكَ لِمَنْ يَشَاءُ وَمَنْ يُشْرِكْ بِاللَّهِ فَقَدِ افْتَرَى إِثْمًا عَظِيمًا (48)","hl":[[0,26,2],[26,115,1],[115,147,2]]}},{"id":"س-04054","fp":"2e53c998bb3f","stateId":148,"easy":"إذا مت كافراً أو قتلت مؤمناً متعمداً ← فهذا ما لا يُرجى غفرانه (وكل ذنب سواه عسى الله أن يغفره)","cause":"إلَّا الرجلُ يموتُ كافرًا ، أوْ الرجلُ يَقْتُلُ مُؤْمِنًا مُتَعَمِّدًا","result":"كلُّ ذَنْبٍ عَسَى اللهُ أنْ يَغْفِرَهُ","explicit":true,"similar":["س-03770"],"otherNeedIds":[69],"ref":"صحيح الترغيب 2445","srcLabel":"النسائي","text":[["كلُّ ذَنْبٍ عَسَى اللهُ أنْ يَغْفِرَهُ",2]," ؛ ",["إلَّا الرجلُ يموتُ كافرًا ، أوْ الرجلُ يَقْتُلُ مُؤْمِنًا مُتَعَمِّدًا",1]],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي (3984)، وأحمد (16907) واللفظ له","bab":"توبة › ما يقبل فيه التوبة وما لا يقبل","dorar":"JLQ1hr3p","merged":2,"otherRefs":["العواصم والقواصم 9/30 (حسن)"]},{"id":"س-04375","fp":"51d1d145b021","stateId":148,"easy":"إذا أشركت أو قتلت أو بهتّ مؤمناً أو فررت من الزحف أو حلفت يميناً غموساً ← فليس لهن كفارة","cause":"الشركُ بالله ، وقتلُ النَّفسِ بغير حقٍّ ، وبُهتُ مؤمنٍ ، والفرارُ من الزَّحفِ ، ويمينٌ صابرةٌ يقتطع بها مالًا بغير حقٍّ","result":"خمسٌ ليس لهنَّ كفارةٌ","explicit":true,"similar":["س-04388"],"ref":"صحيح الترغيب 1339","srcLabel":"أحمد","text":["من لقِيَ اللهَ لا يشرك به شيئًا ، وأدَّى زكاةَ مالِه طيِّبةً بها نفسُه محتسبًا ، وسمع وأطاع ؛ فله الجنّةُ – أو دخل الجنَّةَ - . و",["خمسٌ ليس لهنَّ كفارةٌ",2]," : ",["الشركُ بالله ، وقتلُ النَّفسِ بغير حقٍّ ، وبُهتُ مؤمنٍ ، والفرارُ من الزَّحفِ ، ويمينٌ صابرةٌ يقتطع بها مالًا بغير حقٍّ",1]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (8737) باختلاف يسير، والطبراني في ((مسند الشاميين)) (1183) مختصراً","bab":"جهاد › التولي والفرار من الزحف","dorar":"4tcDs32F","merged":2,"otherRefs":["صحيح الجامع 3247 (حسن)"]},{"id":"س-04388","fp":"4bb24627ddac","stateId":148,"easy":"إذا أشركت أو قتلت أو نهبت مؤمناً ← فهي من خمس ليس لهن كفارة","cause":"خمسٌ ليس لهنَّ","result":"كفَّارةٌ الشركُ باللهِ عزَّ وجلَّ وقتلُ النَّفسِ بغيرِ حقٍّ أو نهبُ مؤمنٍ أو الفرارُ من الزحفِ","explicit":true,"repOf":"س-04375","ref":"إرواء الغليل 5/26","text":[["خمسٌ ليس لهنَّ ",1],["كفَّارةٌ الشركُ باللهِ عزَّ وجلَّ وقتلُ النَّفسِ بغيرِ حقٍّ أو نهبُ مؤمنٍ أو الفرارُ من الزحفِ",2]," أو يمينٌ صابرةٌ يقتطعُ بها مالًا بغير حقٍّ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده جيد","takhrij":"أخرجه أحمد (8722) مطولاً، والديلمي في ((الفردوس)) (2977) واللفظ لهما، وابن أبي عاصم في ((الديات)) (ص16) مختصراً.","bab":"جهاد › التولي والفرار من الزحف","dorar":"yd10ofuE"},{"id":"س-03770","fp":"d8cac3aebb3d","stateId":148,"easy":"إذا أصبت دماً حراماً ← انقطع سيرك الصالح (وما زلت بخير قبله)","cause":"ما لم يُصِبْ دمًا حرامًا، فإذا أصابَ دمًا حرامًا بَلَّحَ","result":"لا يَزالُ المؤمِنُ مُعْنِقًا صالحًا","explicit":true,"repOf":"س-04054","ref":"صحيح أبي داود 4270","text":["كلُّ ذنْبٍ عسى اللهُ أن يغفِرَه، إلَّا مَن مات مُشركًا، أو مؤمِنٌ قتل مؤمِنًا مُتعمِّدًا. وعن عبادةَ بنِ الصامتِ رَضِيَ اللهُ عنه، عن رسولِ اللهِ صلَّى اللهُ عليه وعلى آلِهِ وسلَّمَ، أنه قال: مَن قتَل مؤمنًا؛ فاغتبَطَ بقتلِهِ، لم يقبَلِ اللهُ منه صرْفًا ولا عدلًا. وعن أبي الدرداءِ رَضِيَ اللهُ عنه، عن رسولِ اللهِ صلَّى اللهُ عليه وعلى آلِهِ وسلَّمَ، أنه قال: ",["لا يَزالُ المؤمِنُ مُعْنِقًا صالحًا",2]," ",["ما لم يُصِبْ دمًا حرامًا، فإذا أصابَ دمًا حرامًا بَلَّحَ",1],"."],"grade":"صحيح","narrator":"أبو الدرداء وعبادة بن الصامت","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4270)، وعبد الغني المقدسي في ((تحريم القتل)) (701) واللفظ لهما، والطبراني في ((الشاميين)) (1309) عن أبي الدرداء وحده، واللفظ لهم.","bab":"الكفر والشرك › ذم الشرك وما ورد فيه من العقوبة","dorar":"FUs9boL5","merged":2,"otherRefs":["صحيح البخاري 6862 (صحيح)"]},{"id":"س-08011","fp":"3355dc5c2c15","stateId":148,"easy":"إذا حلفت يميناً غموساً ← فهو ذنب ليس له كفارة","cause":"اليَمينَ الغَموسَ","result":"مِنَ الذَّنْبِ الَّذي ليْس له كَفَّارةٌ","explicit":true,"similar":["س-01760"],"ref":"المستدرك على الصحيحين 8019","srcLabel":"أحمد","text":["عنْ عَبدِ الله بنِ مَسعودٍ رَضيَ اللهُ عنه قالَ: كُنَّا نَعُدُّ ",["مِنَ الذَّنْبِ الَّذي ليْس له كَفَّارةٌ",2]," ",["اليَمينَ الغَموسَ",1],"، قيل: وما اليَمينُ الغَموسُ؟ قالَ: الرَّجُلُ يَقتَطِعُ بيَمينِه مالَ الرَّجُلِ."],"grade":"صحيح","narrator":"أبو العالية","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه ابن الجعد (1408)، والبيهقي (19911)، وأحمد بن منيع كما في ((المطالب العالية)) (1780) جميعا باختلاف يسير.","bab":"مظالم › تحريم الظلم","dorar":"m29KiueV"},{"id":"س-01760","fp":"b98c41c3562f","stateId":148,"easy":"إذا حلفت كاذباً لتأخذ مالاً بغير حق ← فليس لها كفارة","cause":"يَمينٌ صابِرةٌ لِيَقتَطِعَ بها مالًا بغَيرِ حَقٍّ","result":"ليس لها كَفَّارةٌ","explicit":true,"repOf":"س-08011","ref":"تنقيح التحقيق 5/56","text":[["ليس لها كَفَّارةٌ",2],": ",["يَمينٌ صابِرةٌ لِيَقتَطِعَ بها مالًا بغَيرِ حَقٍّ",1],"."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده جيِّدٌ","bab":"أيمان › تعظيم شأن الأيمان","dorar":"o2v6tw1m"},{"id":"س-03981","fp":"21208279c80d","stateId":149,"easy":"إذا ظلمت العباد ← فهو الذنب الذي لا يُترك حتى يُقتص منك","cause":"فظلمُ العبادِ بعضُهمِ بعضًا","result":"و أما الذي لا يُتركُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الجامع الصغير 4320","srcLabel":"ابن حبان","text":["ذنبٌ لا يغفرُ،  وذنبٌ لا يتركُ،  و ذنبٌ يغفرُ،  فأما الذي لا يغفرُ : فالشركُ باللهِ،  و أما الذي يُغفرُ فذنبُ العبدِ بينه و بينَ اللهِ عزَّ و جلَّ،  ",["و أما الذي لا يُتركُ",2]," : ",["فظلمُ العبادِ بعضُهمِ بعضًا",1]],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((الصغير)) (102)، وابن حبان في ((المجروحين)) (2/ 452)، والخطيب في ((تاريخ بغداد)) (5/ 547) واللفظ لهم.","bab":"توبة › الحض على التوبة","dorar":"aeocCyIX"},{"id":"س-03988","fp":"d3d31fcb479c","stateId":149,"easy":"إذا ظلمت أخاك ← فهو الذنب الذي تُجازى به","cause":"فظلْمُكَ أخاكَ","result":"وأمَّا الذنْبُ الذي يُجَازَى بِهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الجامع الصغير 4321","srcLabel":"الطبراني","text":["ذنبٌ يُغْفَرُ ، وذنبٌ لا يُغْفَرُ ، وذنبٌ يُجَازَى بِهِ ، فأمَّا الذنبُ الذي لَا يُغْفَرُ : فالشِّرْكُ باللهِ ، وأمَّا الذنْبُ الذى يُغْفَرُ : فعَمَلُكَ بينَكَ وبينَ ربِّكَ ، ",["وأمَّا الذنْبُ الذي يُجَازَى بِهِ",2]," : ",["فظلْمُكَ أخاكَ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (7595) باختلاف يسير","bab":"توبة › الحض على التوبة","dorar":"s3XdCCjy"},{"id":"س-07980","fp":"a0611ccdb273","stateId":149,"easy":"إذا ظلمت ← يأخذ الله للمظلوم منك ولو غُفر للأمة","cause":"المظالِمَ","result":"فإنِّي آخذُ للمظلومِ منه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-07585","otherNeedIds":[70],"ref":"الترغيب والترهيب 2/193","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم دعا لأمَّتِه عشِيَّةِ عرفةَ فأُجيب أنِّي قد غفرْتُ لهم ما خلا ",["المظالِمَ",1]," ",["فإنِّي آخذُ للمظلومِ منه",2]," قال أيْ ربِّ إن شئتَ أعطيتَ المظلومَ الجنَّةَ وغفرت للظَّالمِ فلم يُجِبْ عشِيَّةَ عرفةَ فلمَّا أصبح بالمزدلِفةِ أعاد فأُجيب إلى ما سأل قال فضحِك رسولُ اللهِ صلَّى اللهُ عليه وسلَّم أو قال تبسَّم فقال له أبو بكرٍ وعمرُ رضِي الله عنهما بأبي وأمِّي إنَّ هذه لساعةٌ ما كنتَ تضحكُ فيها فما الَّذي أضحكك أضحك اللهُ سِنَّك قال إنَّ عدوَّ اللهِ إبليسُ لمَّا علِم أنَّ اللهَ قد استجاب دعائي وغفر لأمَّتي أخذ التُّرابَ فجعل يحثوه على رأسِه ويدعو بالويلِ والثُّبورِ فأضحكني ما رأيتُ من جزعِه"],"grade":"صحيح","narrator":"عباس بن مرداس السلمي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن ماجه (3013)، وعبدالله بن أحمد في ((زوائد المسند)) (16207)، والبيهقي (9753) باختلاف يسير","bab":"مظالم › التخلص من الظلم","dorar":"sDPt82pG"},{"id":"س-07585","fp":"6440047c83ac","stateId":149,"easy":"إذا ظلمت الناس ← لا تُغفر لك مظالمهم يوم عرفة، فالله يأخذ للمظلوم","cause":"إلا ظُلْمَ بعضِهم بعضًا","result":"فإنه يأخذُ للمظلومِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-07980"],"otherNeedIds":[70],"ref":"القول المسدد 1/44","srcLabel":"ابن ماجه","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم دعا ربَّه عَشِيَّةَ عرفةَ بالمغفرةِ لأُمَّتِه وأنَّ اللهَ سبحانه وتعالى أجابه بالمغفرةِ لأُمَّتِه ",["إلا ظُلْمَ بعضِهم بعضًا",1]," ",["فإنه يأخذُ للمظلومِ",2]," من الظالمِ ؛ قال : فأعاد الدعاءَ ، فقال : أَيْ ربِّ ! إنك قادرٌ على أن تُثِيبَ المظلومَ خيرًا من مَظْلَمَتِه وتَغْفِرَ لهذا الظالمَ ، قال : فلم يُجِبْه تلك العَشِيَّةَ شيئًا ، فلما أصبح بالمزدلفةِ أعاد الدعاءَ . فأجابه اللهُ عز وجل : إني قد فعلتُ ، قال : فضَحِك رسولُ اللهِ صلَّى اللهُ عليه وسلَّم أو تَبَسَّم ، فقال أبو بكرٍ وعمرُ : واللهِ ! لقد ضَحِكْتَ في ساعةٍ ما كنتَ تضحكُ فيها ، فما أَضْحَكَكَ ؟ أَضْحَكَ اللهُ سِنَّك ! فقال ضَحِكْتُ أنَّ الخبيثَ إبليسَ حين عَلِمَ أن اللهَ عز وجل قد غفر لأُمَّتي واستجاب دعائي أَهْوَى يَحْثِي الترابَ على رأسِه ويدعو بالوَيْلِ والثُّبُورِ ، فضَحِكْتُ من الخبيثِ من جَزَعِهِ"],"grade":"حسن","narrator":"عباس بن مرداس السلمي","muhaddith":"قوي","takhrij":"أخرجه ابن ماجه (3013)، وعبدالله بن أحمد في ((زوائد المسند)) (16207)، والبيهقي (9753) باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › شفقته على أمته","dorar":"3uqzUXKf"},{"id":"س-03955","fp":"24adfb799f5f","stateId":149,"easy":"إذا مت وعليك دين لم تترك له قضاء ← فهو من أعظم الذنوب بعد الكبائر","cause":"أنْ يموتَ الرجُلُ وعلَيْهِ دَيْنٌ لا يَدَعُ لَهُ قضاءً","result":"إِنَّ أعظمَ الذنوبِ عندَ اللهِ أنْ يلقاهُ بِها عبدٌ بَعْدَ الكبائِرِ التي نَهَى اللهُ عنها","explicit":true,"otherNeedIds":[2],"ref":"الجامع الصغير 2200","srcLabel":"البخاري","text":[["إِنَّ أعظمَ الذنوبِ عندَ اللهِ أنْ يلقاهُ بِها عبدٌ بَعْدَ الكبائِرِ التي نَهَى اللهُ عنها",2]," ",["أنْ يموتَ الرجُلُ وعلَيْهِ دَيْنٌ لا يَدَعُ لَهُ قضاءً",1]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3342)، والبخاري في ((التاريخ الكبير)) (11/ 157)، والروياني في ((المسند)) (496)، وابن عدي في ((الكامل في الضعفاء)) (9/ 142) واللفظ لهم.","bab":"تفليس › حلول الدين على الميت","dorar":"w7izpiiQ"},{"id":"س-05294","fp":"15bba632cbbf","stateId":150,"easy":"إذا هجرت أخاك سنة ← فهو كسفك دمه","cause":"مَن هَجَرَ أخاه سَنةً","result":"فهو كَسَفكِ دَمِه","explicit":true,"otherNeedIds":[60],"ref":"تخريج المسند لشعيب 17935","srcLabel":"أحمد","text":["«",["مَن هَجَرَ أخاه سَنةً، ",1],["فهو كَسَفكِ دَمِه»",2],"."],"grade":"صحيح","narrator":"أبو خراش السلمي","muhaddith":"إسناده صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ea6VzBvb","merged":3,"otherRefs":["صحيح الجامع 7020 (صحيح)","العواصم والقواصم 9/392 (صحيح)"]},{"id":"س-05286","fp":"a4da8cfa6983","stateId":150,"easy":"إذا اعتذر إليك أخوك فلم تقبل ← عليك من الخطيئة مثل صاحب المكس","cause":"مَنِ اعتَذَرَ إليه أخوه بمَعذِرةٍ فلَم يَقبَلْها","result":"كان عليه مِنَ الخَطيئةِ مِثلُ صاحِبِ مَكسٍ","explicit":true,"ref":"فيض القدير 6/ 73","srcLabel":"فيض القدير","text":[["مَنِ اعتَذَرَ إليه أخوه بمَعذِرةٍ فلَم يَقبَلْها ",1],["كان عليه مِنَ الخَطيئةِ مِثلُ صاحِبِ مَكسٍ",2]],"grade":"حسن","narrator":"جودان","muhaddith":"[فيه] جودان اختلف في صحبته وجهله أبو حاتم وقال: لا صحبة له وباقي رجاله ثقات","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"bz8GfcF1"},{"id":"س-06730","fp":"4c1260be3f52","stateId":150,"easy":"إذا هجرت أخاك ← يُغفر لكل مسلم إلا أنتما حتى تصطلحا","cause":"المُتَهاجِرَينِ","result":"فيَغفِرُ اللهُ لكلِّ مُسلِمٍ أو لكلِّ مؤمِنٍ إلَّا المُتَهاجِرَينِ فيقولُ أخِّرْهما","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-06729"],"otherNeedIds":[57],"ref":"تخريج المسند لشاكر 16/155","srcLabel":"الترمذي","text":["كان أكثَرَ ما يَصومُ الاثنَينِ والخميسَ قال فقيل له قال فقال: إنَّ الأعمالَ تُعرَضُ كلَّ اثنَينِ وخمَيسٍ أو كلَّ يومِ اثنَينِ وخَميسٍ ",["فيَغفِرُ اللهُ لكلِّ مُسلِمٍ أو لكلِّ مؤمِنٍ إلَّا المُتَهاجِرَينِ فيقولُ أخِّرْهما",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (747) مختصراً، وابن ماجه (1740)، وأحمد (8361) واللفظ له.","bab":"صيام › صيامه صلى الله عليه وسلم","dorar":"AMY6ZaCy"},{"id":"س-06729","fp":"c7be1058f028","stateId":150,"easy":"إذا حملت الضغينة على أخيك ← تُرد عنك المغفرة حتى تتوب","cause":"أهلُ الضغائنِ","result":"ويُردُّ أهلُ الضغائنِ بضغائنهم حتى يتوبوا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-06730","otherNeedIds":[57],"ref":"المتجر الرابح 142","text":["إن النبيَّ صلَّى اللهُ عليهِ وسلَّمَ كان يصومُ الاثنينَ والخميسَ فقيل: يا رسولَ اللهِ إنك تصومُ الاثنينَ والخميسَ: فمن مستغفرٌ فيغفرَ له ومن تائبٌ فيتابَ عليه ",["ويُردُّ أهلُ الضغائنِ بضغائنهم حتى يتوبوا",2],"."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده جيد","takhrij":"أخرجه ابن ماجة (1740)، وأحمد (8361)، وابن حبان (5663) بنحوه.","bab":"صيام › صيامه صلى الله عليه وسلم","dorar":"X0dGKx5o"},{"id":"س-03961","fp":"a8bdb3209ab0","stateId":150,"easy":"إذا لم تغفر للناس ← لا يُغفر لك","cause":"ومَن لا يَغْفِرْ","result":"لا يُغْفَرْ له","explicit":true,"star":true,"ref":"صحيح الجامع 6600","srcLabel":"البخاري","text":["مَن لا يَرْحَمْ لا يُرْحَمْ ، ",["ومَن لا يَغْفِرْ",1]," ",["لا يُغْفَرْ له",2]," ، ومَن لا يَتُبْ لا يُتَبْ عليه"],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أحمد (19244)، والطبراني (2/ 351) (2475) واللفظ لهما، والبخاري (6013) مختصرا.","bab":"توبة › الحض على التوبة","dorar":"wKblKt12","merged":2,"otherRefs":["صحيح الترغيب 2466 (صحيح)"]},{"id":"س-04254","fp":"7eb13ce8689f","stateId":150,"easy":"إذا سلّمت فلم يرد عليك أخوك ← برئت من الإثم وباء هو به","cause":"وإنْ أبى الآخَرُ أنْ يَرُدَّ السَّلامَ","result":"بَرِئَ هذا مِن الإثْمِ، وَباءَ بهِ الآخَرُ","explicit":true,"ref":"المستدرك على الصحيحين 7497","srcLabel":"الطبراني","text":["لا تَحِلُّ الهجْرةُ فوقَ ثَلاثةِ أيَّامٍ، فإنِ الْتَقَيَا، فسَلَّمَ أحدُهُما على الآخَرِ، فرَدَّ عليهِ الآخَرُ السَّلامَ؛ اشتَرَكا في الأجْرِ، ",["وإنْ أبى الآخَرُ أنْ يَرُدَّ السَّلامَ",1]," ",["بَرِئَ هذا مِن الإثْمِ، وَباءَ بهِ الآخَرُ",2],"، وأحسَبُه قالَ: وإنْ ماتَا وهُمَا مُتهاجِرانِ، لا يَجْتمعانِ في الجَنَّةِ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (8930) واللفظ له، وأبو الشيخ الأصبهاني ((التوبيخ والتنبيه)) (43) بنحوه","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"xPtMObCc"},{"id":"س-04053","fp":"50b6084f2887","stateId":151,"easy":"إذا كنت صاحب بدعة ← يحجب الله عنك التوبة حتى تدعها","cause":"كلِّ صاحبِ بدعةٍ","result":"إنَّ اللهَ حجَب التَّوبةَ عن","explicit":true,"ref":"مجمع الزوائد 10/192","srcLabel":"الطبراني","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["إنَّ اللهَ حجَب التَّوبةَ عن",2]," ",["كلِّ صاحبِ بدعةٍ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"رجاله رجال الصحيح غير هارون بن موسى الفروي وهو ثقة","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (4202)، والبيهقي في ((شعب الإيمان)) (9457)، وابن الجوزي في ((العلل المتناهية)) (211) واللفظ له","bab":"توبة › ما يقبل فيه التوبة وما لا يقبل","dorar":"ocALUVy2","merged":2,"otherRefs":["الأحاديث المختارة 2054 (صحيح)"]},{"id":"س-01804","fp":"7870dafc31fb","stateId":151,"easy":"إذا قلت لأحد «والله لا يغفر الله لك» ← تتكلم بكلمة توبق دنياك وآخرتك","cause":"فقال: وَاللهِ لا يَغْفِرُ اللهُ لك، أَو لا يُدْخِلُكَ اللهُ الجَنَّةَ أَبَدًا","result":"لَتَكَلَّمَ بِكَلِمَةٍ أوْبَقَتْ دُنْياهُ وَآخِرَتَهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشاكر 16/127","srcLabel":"أبو داود","text":["عن ضمضم بن جوس اليمامي، قال: قال لي أَبو هُرَيْرَةَ: يا يَمامِيُّ، لا تَقولَنَّ لِرَجُلٍ: وَاللهِ لا يَغْفِرُ اللهُ لك، أو لا يُدْخِلُكَ اللهُ الجَنَّة أَبَدًا. قلتُ: يا أَبا هُرَيْرَةَ، إِنَّ هَذِهِ لكَلِمَةٌ يَقولُها أَحَدُنا لأَخيهِ وَصاحِبِهِ إِذا غَضِبَ. قال: فَلا تَقُلْها، فإِنِّي سَمِعْتُ النَّبِيَّ صلَّى اللهُ عليهِ وسلَّمَ يَقولُ:  كان في بني إِسْرَائيلَ رَجُلانِ، كان أَحَدُهُما مُجْتَهِدًا في الْعِبادَةِ، وكانَ الآخَرُ مُسْرِفًا على نَفْسِهِ، فكانا مُتَآخِيَيْنِ، فكان المجتهِدُ لا يزالُ يَرى الآخَرَ على ذَنْبٍ، فَيَقولُ: يا هَذا، أَقْصِرْ. فَيَقولُ: خَلِّني وَرَبِّي، أَبُعِثْتَ عليَّ  رَقيبًا؟  قَالَ:  إِلى أَن رَآهُ يَوْمًا على ذَنْبٍ اسْتَعْظَمَهُ، فقالَ لهُ: وَيْحَكَ، أَقْصِرْ. قال: خَلِّنِي وَرَبِّي، أَبُعِثْتَ عليَّ رقيبًا ، قال: ",["فقال: وَاللهِ لا يَغْفِرُ اللهُ لك، أَو لا يُدْخِلُكَ اللهُ الجَنَّةَ أَبَدًا",1],". قال أَحَدُهُما، قال: فبعث اللهُ إِلَيهِما مَلكًا، فقبض أَرْوَاحَهُما، واجْتَمَعا عندَهُ، فقال لِلْمُذْنِبِ: اذْهَبْ فادْخُلِ الجَنَّةَ برَحْمَتِي. وقال لِلآخَرِ: أَكُنْتَ بي عالِمًا، أَكُنْتَ على ما في يَدِي قادِرًا، اذْهَبُوا بهِ إِلَى النَّارِ . قال: فوالَّذي نفْسُ أبي الْقَاسمِ بِيَدِهِ، ",["لَتَكَلَّمَ بِكَلِمَةٍ أوْبَقَتْ دُنْياهُ وَآخِرَتَهُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4901)، وابن حبان (5712)، وابن المبارك في ((الزهد)) (900) بنحوه.","bab":"أيمان › لفظ اليمين وما يحلف به","dorar":"krK5rzjH","merged":3,"otherRefs":["تخريج شرح الطحاوية 299 (صحيح)","تخريج شرح السنة 4188 (حسن)"]},{"id":"س-05130","fp":"00cc7d54d762","stateId":151,"easy":"إذا أسأت في الإسلام ← تؤاخذ بالأول والآخر","cause":"مَن أساء في الإسلامِ","result":"أُخِذَ بالأَوَّلِ والآخِرِ","explicit":true,"star":true,"similar":["س-03541"],"ref":"تخريج مشكل الآثار 506","srcLabel":"متفق عليه","text":["قال النَّاسُ: يا رسولَ اللهِ، ثمَّ ذكَر مِثْلَهُ سَواءً. [يعني حديثَ: قال رجُلٌ: يا رسولَ اللهِ، أيُؤاخَذُ أحَدُنا بما عمِل في الجاهليَّةِ؟ فقال: مَن أحسَن في الإسلامِ لمْ يُؤاخَذْ بما عمِل في الجاهليَّةِ، و",["مَن أساء في الإسلامِ",1]," ",["أُخِذَ بالأَوَّلِ والآخِرِ",2],".]"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (6921)، ومسلم (120) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"NJJzACMW","merged":3,"otherRefs":["تخريج المسند لشاكر 5/213 (صحيح)","تخريج المسند لشاكر 6/70 (صحيح)"]},{"id":"س-05194","fp":"7011ffbf58e8","stateId":151,"easy":"إذا عملت ذنباً ستره الله ثم فضحت نفسك ← فلست من المعافَين (المجاهرون لا يُعافون)","cause":"أن يَعمَلَ الرَّجُلُ باللَّيلِ عَمَلًا، ثُمَّ يُصبِحَ وقد سَتَرَه اللهُ عليه، فيَقولَ: يا فُلانُ، عَمِلتُ البارِحةَ كَذا وكَذا، وقد باتَ يَستُرُه رَبُّه، ويُصبِحُ يَكشِفُ سِترَ اللهِ عنه","result":"كُلُّ أُمَّتي مُعافًى إلَّا المُجاهِرينَ","explicit":true,"star":true,"otherNeedIds":[44],"ref":"صحيح البخاري 6069","srcLabel":"مسلم","text":[["كُلُّ أُمَّتي مُعافًى إلَّا المُجاهِرينَ",2],"، وإنَّ مِنَ المُجاهَرةِ ",["أن يَعمَلَ الرَّجُلُ باللَّيلِ عَمَلًا، ثُمَّ يُصبِحَ وقد سَتَرَه اللهُ عليه، فيَقولَ: يا فُلانُ، عَمِلتُ البارِحةَ كَذا وكَذا، وقد باتَ يَستُرُه رَبُّه، ويُصبِحُ يَكشِفُ سِترَ اللهِ عنه",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2990) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"rKUGznuP","merged":4,"otherRefs":["صحيح مسلم 2990 (صحيح)","الجامع الصغير 6261 (صحيح)","صحيح الجامع 4512 (صحيح)"]},{"id":"س-03541","fp":"9942d1f843b2","stateId":151,"easy":"إذا أسأت في الإسلام ← تؤاخذ بما عملت قبله وبعده","cause":"ومَن أساءَ منكم في الإسلامِ","result":"أُخِذَ بما عَمِلَ في الشِّركِ والإسلامِ","explicit":true,"repOf":"س-05130","ref":"تخريج المسند لشعيب 4408","text":["قُلْنا: يا رسولَ اللهِ، أرَأَيتَ ما عَمِلْنا في الشِّركِ، نُؤاخَذُ به؟ قال: مَن أحسَنَ منكم في الإسلامِ، لم يُؤاخَذْ بما عَمِلَ في الشِّركِ، ",["ومَن أساءَ منكم في الإسلامِ، ",1],["أُخِذَ بما عَمِلَ في الشِّركِ والإسلامِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (120)، وابن ماجه (4242)، وأحمد (4408) واللفظ له","bab":"استغفار › مكفرات الذنوب","dorar":"MqY2X3Xp"},{"id":"س-03962","fp":"180404065e7e","stateId":151,"easy":"إذا لم تتب ← لا يُتاب عليك","cause":"ومَن لا يَتُبْ","result":"لا يُتَبْ عليه","explicit":true,"star":true,"ref":"صحيح الجامع 6600","srcLabel":"البخاري","text":["مَن لا يَرْحَمْ لا يُرْحَمْ ، ومَن لا يَغْفِرْ لا يُغْفَرْ له ، ",["ومَن لا يَتُبْ",1]," ",["لا يُتَبْ عليه",2]],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أحمد (19244)، والطبراني (2/ 351) (2475) واللفظ لهما، والبخاري (6013) مختصرا.","bab":"توبة › الحض على التوبة","dorar":"wKblKt12"},{"id":"س-03992","fp":"32b6b4054892","stateId":151,"easy":"إذا أذنبت فقلت «لا يغفره الله لي» ← فقد ألقيت بيدك إلى التهلكة","cause":"الرَّجلُ يُذنِبُ الذَّنبَ، فيقولُ: لا يَغفِرُهُ اللهُ لي","result":"وَلَا تُلْقُوا بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ","explicit":true,"similar":["س-07186"],"ref":"المستدرك على الصحيحين 3130","srcLabel":"أحمد","text":["عنِ البَراءِ رَضيَ اللهُ عنه، قالَ له رَجلٌ: يا أبا عُمارةَ: {",["وَلَا تُلْقُوا بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ",2],"} [البقرة: 195] أهُوَ الرَّجلُ يَلْقى العَدُوَّ فيُقاتِلُ حتَّى يُقْتلَ؟ قالَ: لا، ولكن هو ",["الرَّجلُ يُذنِبُ الذَّنبَ، فيقولُ: لا يَغفِرُهُ اللهُ لي",1],"."],"grade":"صحيح","narrator":"أبو إسحاق","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (6691) بلفظه، وأحمد (18477) باختلاف يسير.","bab":"توبة › الحض على التوبة","dorar":"czoTe64m","merged":4,"otherRefs":["صحيح أسباب النزول 35 (صحيح)","فتح الباري لابن حجر 8/33 (صحيح)","نيل المرام 110 (صحيح)"]},{"id":"س-07186","fp":"ee19cab2d0a9","stateId":151,"easy":"إذا أذنبت ثم ألقيت بيدك قائلاً «لا يُغفر لي» ← فهذه هي التهلكة","cause":"أنْ يُذنِبَ الرَّجُلُ الذَّنبَ، ثُمَّ يُلقي بيدَيْه يقولُ: لا يُغفَرُ لي","result":"إنَّما التَّهلُكةُ","explicit":true,"repOf":"س-03992","ref":"تخريج مشكل الآثار 12/103","text":["أنَّ رَجُلًا قال للبَراءِ: أحمِلُ على الكَتيبةِ في ألْفٍ بالسَّيفِ، مِنَ التَّهلُكةِ؟ قال: لا، ",["إنَّما التَّهلُكةُ",2]," ",["أنْ يُذنِبَ الرَّجُلُ الذَّنبَ، ثُمَّ يُلقي بيدَيْه يقولُ: لا يُغفَرُ لي",1],"."],"grade":"حسن","narrator":"أبو إسحاق","muhaddith":"رجاله ثقات رجال الشيخين.","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (12/ 103) بلفظه، وأحمد (18477)، والحاكم (3089) بنحوه.","bab":"علم › حسن السؤال ونصح العالم","dorar":"8bNugoV6"},{"id":"ق-1454","fp":"fa2fb539b30c","stateId":152,"easy":"عمل مثقال ذرة شراً ← يراه","cause":"عمل مثقال ذرة شراً","result":"يراه","explicit":true,"star":true,"ref":"سورة الزلزلة: 8","srcLabel":"القرآن الكريم","quran":{"s":99,"from":8,"to":8,"text":"وَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُ (8)","hl":[[0,41,1],[41,47,2]]}},{"id":"س-08037","fp":"6997536b65b3","stateId":152,"easy":"إذا استهنت بالمحقّرات ← فهي الموبقات يوم القيامة","cause":"بالمحَقِّراتِ","result":"وهي الموبِقاتُ يومَ القيامةِ","explicit":true,"star":true,"similar":["س-05052","س-04789"],"ref":"صحيح الترغيب 2221","srcLabel":"الحاكم","text":["إنَّ الشيطانَ قد يَئِسَ أن تُعبَدَ الأصنامُ في أرضِ العربِ ، ولكنه سَيرضى منكم بدونِ ذلك ",["بالمحَقِّراتِ",1]," ، ",["وهي الموبِقاتُ يومَ القيامةِ",2]," ، اتَّقوا الظُّلمَ ما استطعتُم ؛ فإنَّ العبدَ يَجيءُ بالحسناتِ يومَ القيامةِ يَرى أنها ستُنْجِيه ، فمازالَ عبدٌ يقومُ يقول : يا ربِّ ظلَمَني عبدُك مَظلَمَةً . فيقول : امْحُوا من حسناتِه . وما يزالُ كذلك حتى ما يَبْقى له حسنةٌ من الذُّنوبِ ، وإنَّ مَثَلَ ذلك كسَفْرٍ نزلوا بفلاةٍ من الأرضِ ليس معهم حطبٌ ، فتفرَّقُ القومُ ليحتَطِبوا فلم يَلْبَثوا أن حَطِبوا ، فأَعظَموا النَّارَ وطبَخوا ما أرادوا ، وكذلك الذُّنوبُ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو يعلى (5122)، والحاكم (2221)، والبيهقي في ((شعب الإيمان)) (7263) باختلاف يسير","bab":"مظالم › تحريم الظلم","dorar":"CJ5GF7rQ","merged":3,"otherRefs":["المستدرك على الصحيحين 2255 (صحيح)","تخريج شرح السنة 4203 (صحيح)"]},{"id":"س-03969","fp":"6a6012377f4e","stateId":152,"easy":"إذا أصررت على الصغيرة ← لم تعد صغيرة","cause":"معَ إصرارٍ","result":"ولا صغيرةَ","explicit":true,"ref":"الآداب الشرعية 1/153","srcLabel":"الطبري","text":["أنَّ رجلًا قالَ لابنِ عبَّاسٍ : كَم الكبائرُ ، أسَبعٌ هي ؟ قالَ : هيَ إلى سَبعِمائةٍ أقربُ منها إلى سبعٍ غيرَ أنَّهُ لا كبيرةَ معَ استِغفارٍ ",["ولا صغيرةَ",2]," ",["معَ إصرارٍ",1]],"grade":"صحيح","narrator":"سعيد بن جبير","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبري في ((جامع البيان)) (6/ 651)، وابن المنذر في ((التفسير)) (1670)، وابن أبي حاتم في ((التفسير)) (5217) واللفظ لهم جميعا.","bab":"توبة › الحض على التوبة","dorar":"VVQkUQf0","merged":2,"otherRefs":["أصول الفقه لابن مفلح 2/534 (صحيح)"]},{"id":"س-05052","fp":"77ad3e8a67f1","stateId":152,"easy":"إذا استهنت بصغائر الذنوب ← تهلكك","cause":"محقراتِ الذنوبِ متى يُؤخذُ بها صاحبُها","result":"تُهلِكُه","explicit":true,"repOf":"س-08037","otherNeedIds":[69],"ref":"مجمع الزوائد 10/231","text":["إياكم ومحقراتِ الذنوبِ فإن مثلَ محقراتِ الذنوبِ كقومٍ نزلوا بطنَ وادٍ فجاء ذا بعودٍ وجاء ذا بعودٍ حتى أنضجوا خُبزَتَهم وإن ",["محقراتِ الذنوبِ متى يُؤخذُ بها صاحبُها",1]," ",["تُهلِكُه",2]," وقال أبو حازمٍ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم قال أبو ضمرةَ ولا أحسبُه إلا عن سهلِ بنِ سعدٍ قال مثلِي ومثلُ الساعةِ كهاتينِ وفرَّق بينَ إصبعَيه الوسطَى والتي تلي الإبهامَ ثم قال مثلِي ومثلُ الساعةِ كمثلِ رجلٍ بعثه قومُه طليعةً فلما خشِيَ أن يُسبقَ ألاح بثوبِه أُتِيتم أُتِيتم ثم يقولُ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم أنا ذاك"],"grade":"صحيح","narrator":"سهل بن سعد الساعدي","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (22808)، والطبراني (6/166) (5872)، والبيهقي في ((شعب الإيمان)) (7267) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"bYp2e2Ql","merged":2,"otherRefs":["صحيح الجامع 2686 (صحيح)"]},{"id":"س-05066","fp":"12b38771e1ac","stateId":152,"easy":"إذا احتقرت الذنوب الصغيرة ← فإن لها من الله طالباً","cause":"إيَّاكِ ومُحقَّراتِ الأعمالِ","result":"فإنَّ لَها منَ اللَّهِ طالبًا","explicit":true,"ref":"مصباح الزجاجة 4/245","srcLabel":"النسائي","text":["قالَ لي رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: يا عائشةُ ",["إيَّاكِ ومُحقَّراتِ الأعمالِ، ",1],["فإنَّ لَها منَ اللَّهِ طالبًا",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح رجاله ثقات","takhrij":"أخرجه ابن ماجه، والنسائي في (السنن الكبرى) (11811)، وابن حبان (1871)، واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"yG08Elf9"},{"id":"س-04789","fp":"ad5d15161542","stateId":152,"easy":"إذا استهنت بالذنوب الصغيرة ← فقد كانت تُعدّ من الموبقات","cause":"أُمورًا هيَ أدَقُّ في أعيُنِكُم مِنَ الشَّعرِ","result":"كُنَّا نَعُدُّها على عَهدِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم الموبِقاتِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-08037","ref":"تخريج المسند لشعيب 15859","text":["قال عُبادةُ بنُ قُرطٍ: «إنَّكُم لَتَأتونَ ",["أُمورًا هيَ أدَقُّ في أعيُنِكُم مِنَ الشَّعرِ",1],"، ",["كُنَّا نَعُدُّها على عَهدِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم الموبِقاتِ",2],"» قال: فذُكِرَ ذلك لمُحَمَّدِ بنِ سيرينَ، فقال: «صَدَقَ، وأرى جَرَّ الإزارِ مِنها»."],"grade":"صحيح","narrator":"عبادة بن قرط","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"LZl7aYQC","merged":2,"otherRefs":["الصحيح المسند 541 (صحيح)"]}]}