{"schema":1,"kind":"sunan-chunk","version":"sunan-3f5fd6b9930a","needId":4,"stateIds":[28,29,30,31,32,33],"items":[{"id":"ق-0353","fp":"7c30463ffdef","stateId":28,"easy":"التضرع إلى الله عند البأساء والضراء ← رفع البلاء (غاية الابتلاء)","cause":"التضرع إلى الله عند البأساء والضراء","result":"رفع البلاء (غاية الابتلاء)","explicit":true,"ref":"سورة الأنعام: 42","srcLabel":"القرآن الكريم","quran":{"s":6,"from":42,"to":42,"text":"وَلَقَدْ أَرْسَلْنَا إِلَى أُمَمٍ مِنْ قَبْلِكَ فَأَخَذْنَاهُمْ بِالْبَأْسَاءِ وَالضَّرَّاءِ لَعَلَّهُمْ يَتَضَرَّعُونَ (42)","hl":[[48,119,1]]}},{"id":"ق-0359","fp":"8fe6f8853725","stateId":28,"easy":"دعاء الله تضرعاً وخفية عند الظلمات ← النجاة منها ومن كل كرب","cause":"دعاء الله تضرعاً وخفية عند الظلمات","result":"النجاة منها ومن كل كرب","explicit":true,"otherNeedIds":[29],"ref":"سورة الأنعام: 63–64","srcLabel":"القرآن الكريم","quran":{"s":6,"from":63,"to":64,"text":"قُلْ مَنْ يُنَجِّيكُمْ مِنْ ظُلُمَاتِ الْبَرِّ وَالْبَحْرِ تَدْعُونَهُ تَضَرُّعًا وَخُفْيَةً لَئِنْ أَنْجَانَا مِنْ هَذِهِ لَنَكُونَنَّ مِنَ الشَّاكِرِينَ (63) قُلِ اللَّهُ يُنَجِّيكُمْ مِنْهَا وَمِنْ كُلِّ كَرْبٍ ثُمَّ أَنْتُمْ تُشْرِكُونَ (64)","hl":[[0,213,1]]}},{"id":"ق-1054","fp":"1dbab6973a6f","stateId":28,"easy":"التسبيح (سابقة الذكر والعبادة) ← النجاة من الكرب (بطن الحوت)","cause":"التسبيح (سابقة الذكر والعبادة)","result":"النجاة من الكرب (بطن الحوت)","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[29],"ref":"سورة الصافات: 143–144","srcLabel":"القرآن الكريم","quran":{"s":37,"from":143,"to":144,"text":"فَلَوْلَا أَنَّهُ كَانَ مِنَ الْمُسَبِّحِينَ (143) لَلَبِثَ فِي بَطْنِهِ إِلَى يَوْمِ يُبْعَثُونَ (144)","hl":[[0,97,1]]}},{"id":"س-03156","fp":"3ca94b98c5b7","stateId":28,"easy":"إذا كُربت فقل «لا إله إلا الله العظيم الحليم...» ← (ذكر نبوي عند الكرب)","cause":"لا إلَهَ إلَّا اللهُ العَظيمُ الحَليمُ، لا إلَهَ إلَّا اللهُ رَبُّ العَرشِ العَظيمِ، لا إلَهَ إلَّا اللهُ رَبُّ السَّمَواتِ ورَبُّ الأرضِ ورَبُّ العَرشِ الكَريمِ","result":"كان يقولُ عِندَ الكَربِ","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"apply":{"k":"say","t":"«لا إلَهَ إلَّا اللهُ العَظيمُ الحَليمُ، لا إلَهَ إلَّا اللهُ رَبُّ العَرشِ العَظيمِ، لا إلَهَ إلَّا اللهُ رَبُّ السَّمَواتِ ورَبُّ الأرضِ ورَبُّ العَرشِ الكَريم»"},"similar":["س-00692","س-01127","س-07114"],"ref":"صحيح مسلم 2730","srcLabel":"البخاري","text":["أنَّ نَبيَّ اللهِ صلَّى اللهُ عليه وسلَّم ",["كان يقولُ عِندَ الكَربِ",2],": ",["لا إلَهَ إلَّا اللهُ العَظيمُ الحَليمُ، لا إلَهَ إلَّا اللهُ رَبُّ العَرشِ العَظيمِ، لا إلَهَ إلَّا اللهُ رَبُّ السَّمَواتِ ورَبُّ الأرضِ ورَبُّ العَرشِ الكَريمِ",1],". وفي روايةٍ: أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم كان يَدعو بهنَّ ويقولُهنَّ عِندَ الكَربِ، فذَكَرَ بمِثلِ حَديثِ مُعاذِ بنِ هِشامٍ، عن أبيه، عن قَتادةَ، غيرَ أنَّه قال: رَبُّ السَّمَواتِ والأرضِ. وفي روايةٍ: أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم كانَ إذا حَزَبَه أمرٌ، قال: فذَكَرَ بمِثلِ حَديثِ مُعاذٍ، عن أبيه. وزادَ معهُنَّ: لا إلَهَ إلَّا اللهُ رَبُّ العَرشِ الكَريمِ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6346) باختلاف يسير","bab":"إيمان › توحيد الأسماء والصفات","dorar":"9gq6zyAJ","merged":2,"otherRefs":["حلية الأولياء 2/254 (صحيح)"]},{"id":"س-00031","fp":"cf63fe3bea77","stateId":28,"easy":"إذا نزل بك كرب أو بلاء فدعوت بدعاء ذي النون ← يُفرَّج عنك","cause":"إذا نَزَلَ بأحَدٍ مِنكم","result":"كَرْبٌ أو بَلاءٌ مِن بَلاءِ الدُّنْيا ودَعا به فُرِّجَ عنه","explicit":true,"apply":{"k":"time","t":"عند الكرب والهم"},"similar":["س-00729"],"ref":"الأحكام الوسطى 4/ 326","srcLabel":"الترمذي","text":["\"دَعْوةُ ذي النُّونِ إذ دَعا بِها في بَطْنِ الحُوتِ: لا إلهَ إلَّا أنتَ سُبْحانَك إنِّي كنْتُ مِن الظَّالِمينَ؛ فإنَّه لن يَدْعوَ بِها مُسلِمٌ في شيءٍ قَطُّ إلَّا اسْتَجابَ له\".\n وفي طَريقٍ آخَرَ: \"",["إذا نَزَلَ بأحَدٍ مِنكم ",1],["كَرْبٌ أو بَلاءٌ مِن بَلاءِ الدُّنْيا ودَعا به فُرِّجَ عنه\"",2],"."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه الترمذي (3505)، والبزار (1163) باختلاف يسير، والنسائي ((السنن الكبرى)) (10417) واللفظ له","bab":"آداب الدعاء › استجابة الدعاء","dorar":"GqKGztFd"},{"id":"س-03151","fp":"fd49997a4cc5","stateId":28,"easy":"إذا كربك أمر فقل «توكلت على الحي الذي لا يموت...» ← (ذكر عُلّمه النبي ﷺ عند الكرب)","cause":"قُلْ: تَوكَّلتُ على الحيِّ الَّذي لا يموتُ، والحمدُ للهِ الَّذي لمْ يَتَّخذْ ولدًا، ولمْ يكنْ له شريكٌ في المُلكِ، ولمْ يكنْ له وليٌّ مِنَ الذُّلِّ، وكَبِّرْه تكبيرًا","result":"ما كَرَبَني أَمرٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"apply":{"k":"say","t":"«تَوكَّلتُ على الحيِّ الَّذي لا يموتُ، والحمدُ للهِ الَّذي لمْ يَتَّخذْ ولدًا، ولمْ يكنْ له شريكٌ في المُلكِ، ولمْ يكنْ له وليٌّ مِنَ الذُّلِّ، وكَبِّرْه تكبيرًا»"},"ref":"المستدرك على الصحيحين 1900","srcLabel":"الطبراني","text":[["ما كَرَبَني أَمرٌ",2]," إلَّا تَمثَّلَ لي جِبريلُ عليه السَّلامُ، فقالَ: يا مُحمَّدُ، ",["قُلْ: تَوكَّلتُ على الحيِّ الَّذي لا يموتُ، والحمدُ للهِ الَّذي لمْ يَتَّخذْ ولدًا، ولمْ يكنْ له شريكٌ في المُلكِ، ولمْ يكنْ له وليٌّ مِنَ الذُّلِّ، وكَبِّرْه تكبيرًا",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((الدعوات الكبير)) (185) واللفظ له، وأبو يعلى (6671)، والطبراني في ((الدعاء)) (1045) بنحوه مطولًا.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"ayeZOtup"},{"id":"س-05765","fp":"e7d285b896c3","stateId":28,"easy":"إذا نزل بك كرب أو جهد فقل «الله الله ربنا لا شريك له» ← (دعاء يُكشف به الكرب)","cause":"فقولوا اللَّهُ اللَّهُ ربُّنا لا شريكَ لَهُ","result":"إذا نزلَ بِكُم كربٌ أو جَهْدٌ أو لأواءُ","explicit":true,"apply":{"k":"say","t":"«الله الله ربنا لا شريك له» · الوقت: عند الكرب والهم"},"ref":"السلسلة الصحيحة 6/591","srcLabel":"الطبراني","text":["أنَّ رسولَ اللَّهِ صلَّى اللهُ علَيهِ وسلَّمَ أخذَ بِعُضادتيِ البابِ ونحنُ في البيتِ فقالَ يا بَني عبدالمطلب هل فيكم أحدٌ من غيرِكُم قالوا ابنُ أختٍ لَنا فقالَ ابنُ أختِ القومِ منهم ثمَّ قالَ يا بَني عبدالمطلب ",["إذا نزلَ بِكُم كربٌ أو جَهْدٌ أو لأواءُ",2]," ",["فقولوا اللَّهُ اللَّهُ ربُّنا لا شريكَ لَهُ",1]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"[رواته ثقات] غير صالح بن عبد الله وفي الميزان عبيد وكذا في اللسان ولم أره في الجرح والتعديل ولا في التاريخ الكبير والصغير","takhrij":"أخرجه الطبراني (12788) (12/ 170) واللفظ له، والبيهقي في ((شعب الإيمان)) (9750) باختلاف يسير، والعقيلي في ((الضعفاء الكبير)) (2/ 202) مختصرا.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"FGuKMUaB"},{"id":"س-06109","fp":"038412e65701","stateId":28,"easy":"إذا أصابتك مصيبة فاسأل الله وأكثر من «لا حول ولا قوة إلا بالله» ← يرد الله عليك ما فقدت (من واقعة)","cause":"فاسأَلِ اللهَ عزَّ وجلَّ","result":"فلمْ يَلبَثِ الرَّجلُ أنْ رُدَّ عليه إبلُهُ وابنُهُ أَوفرَ ما كانوا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«لا حول ولا قوة إلا بالله» · الوقت: عند المصيبة"},"otherNeedIds":[29],"ref":"المستدرك على الصحيحين 2019","srcLabel":"البيهقي","text":["أَتى رَجلٌ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ -وأُراهُ عوفَ بنَ مالكٍ- فقالَ: يا رسولَ اللهِ، إنَّ بَني فلانٍ أَغاروا عَلَيَّ، فذَهَبوا بابني وإِبِلي، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّ آلَ مُحمَّدٍ كذا وكذا أهلُ بيتٍ -وأَظنُّهُ قالَ تسعةَ أبياتٍ- ما فيهم صاعٌ مِن طعامٍ، ولا مُدٌّ مِن طعامٍ، ",["فاسأَلِ اللهَ عزَّ وجلَّ",1],"، قالَ: فرَجَعَ إلى امرأتِهِ، فقالتْ له: ما رَدَّ عليكَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ فأَخبرَها، قالَ: ",["فلمْ يَلبَثِ الرَّجلُ أنْ رُدَّ عليه إبلُهُ وابنُهُ أَوفرَ ما كانوا",2],"، فأَتى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ فأَخْبرَهُ، فقامَ على المِنبرِ، فحَمِدَ اللهَ، وأَثنى عليه، وأَمَرَهُم بمسألةِ اللهِ عزَّ وجلَّ والرَّغبةِ إليه، وقَرأَ عليهم: {وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مَخْرَجًا (2) وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ} [الطلاق: 2، 3]."],"grade":"صحيح","narrator":"عبدالله","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((دلائل النبوة)) (6/  106) واللفظ له، وقوام السنة في ((الترغيب والترهيب)) (658) بنحوه","bab":"رقائق وزهد › معيشة النبي صلى الله عليه وسلم","dorar":"LN9yfnUr"},{"id":"س-00692","fp":"84bf5507ccb0","stateId":28,"easy":"إذا نزل بك كرب فقل «لا إله إلا الله الكريم الحليم...» ← (ذكر الكرب، والفرج مرجوّ)","cause":"لا إلهَ إلَّا اللهُ الكَريمُ الحَليمُ، وسُبْحانَه وتَبارَكَ اللهُ رَبُّ العَرْشِ العَظيمِ، والحَمْدُ للهِ رَبِّ العالَمينَ","result":"إن نَزَلَ بي كَرْبٌ أو شَدائِدُ أَقولُهنَّ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ الكَريمُ الحَليمُ، وسُبْحانَه وتَبارَكَ اللهُ رَبُّ العَرْشِ العَظيمِ، والحَمْدُ للهِ رَبِّ العالَمين» · الوقت: عند الكرب والهم"},"repOf":"س-03156","ref":"الأحاديث المختارة 558","text":["«لَقَّنَني رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم هؤلاء الكَلِماتِ، وأمَرَني ",["إن نَزَلَ بي كَرْبٌ أو شَدائِدُ أَقولُهنَّ",2],": ",["لا إلهَ إلَّا اللهُ الكَريمُ الحَليمُ، وسُبْحانَه وتَبارَكَ اللهُ رَبُّ العَرْشِ العَظيمِ، والحَمْدُ للهِ رَبِّ العالَمينَ",1],"»."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"S4FmrOZz"},{"id":"س-01127","fp":"4571f2a7f813","stateId":28,"easy":"إذا كُربت فقل «لا إله إلا الله الحليم الكريم...» ← (ذكر نبوي عند الكرب)","cause":"لا إلَهَ إلَّا اللَّهُ الحليمُ الكريمُ سبحانَ اللَّهِ ربِّ العرشِ العظيمِ سبحانَ اللَّهِ ربِّ السَّمواتِ السَّبعِ وربِّ العرشِ الكريمِ","result":"كانَ يقولُ عندَ الكربِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«لا إلَهَ إلَّا اللَّهُ الحليمُ الكريمُ سبحانَ اللَّهِ ربِّ العرشِ العظيمِ سبحانَ اللَّهِ ربِّ السَّمواتِ السَّبعِ وربِّ العرشِ الكريم»"},"repOf":"س-03156","ref":"صحيح ابن ماجه 3147","text":[["كانَ يقولُ عندَ الكربِ",2]," ",["لا إلَهَ إلَّا اللَّهُ الحليمُ الكريمُ سبحانَ اللَّهِ ربِّ العرشِ العظيمِ سبحانَ اللَّهِ ربِّ السَّمواتِ السَّبعِ وربِّ العرشِ الكريمِ",1]," قالَ وَكيعٌ مرَّةً لا إلَهَ إلَّا اللَّهُ فيها كُلِّها"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (3883) واللفظ له، وأخرجه البخاري (6346)، ومسلم (2730) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"PTYSor5z"},{"id":"س-07114","fp":"5b71ab504199","stateId":28,"easy":"إذا كُربت فقل «لا إله إلا الله الحليم الكريم...» ← (كلمات عُلّمت عند الكرب)","cause":"لا إلهَ إلَّا اللهُ الحَليمُ الكَريمُ، سُبْحانَه تَبارَكَ اللهُ رَبُّ العَرْشِ العَظيمِ، الحَمْدُ للهِ رَبِّ العالَمينَ","result":"كَلِماتٍ أَقولُهنَّ عنْدَ الكَرْبِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ الحَليمُ الكَريمُ، سُبْحانَه تَبارَكَ اللهُ رَبُّ العَرْشِ العَظيمِ، الحَمْدُ للهِ رَبِّ العالَمين»"},"repOf":"س-03156","ref":"الأحاديث المختارة 560","text":["«عَلَّمَني رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["كَلِماتٍ أَقولُهنَّ عنْدَ الكَرْبِ",2]," إذا نَزَلَ بي، ما عَلَّمْتُهنَّ حَسَنًا ولا حُسَيْنًا، خَصَصْتُك بِهنَّ، إذا كَرَبَك أمْرٌ فقُلْ: ",["لا إلهَ إلَّا اللهُ الحَليمُ الكَريمُ، سُبْحانَه تَبارَكَ اللهُ رَبُّ العَرْشِ العَظيمِ، الحَمْدُ للهِ رَبِّ العالَمينَ",1],"»."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"علم › تعليم الناس وفضل ذلك","dorar":"OCJEybmf"},{"id":"س-06194","fp":"defc69a3fed3","stateId":28,"easy":"إذا حزبك أمر فصلِّ ← (فعل نبوي، والصلاة مفزع عند الشدة)","cause":"إذا حزبَهُ أمرٌ صلَّى","result":"حزبَهُ أمرٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)","خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"عمدة التفسير 1/110","srcLabel":"أبو داود","text":["رجعتُ إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ ، ليلةَ الأحزابِ وَهوَ مشتملٌ في شملةٍ يصلِّي وَكانَ ",["إذا ",1],["حزبَهُ أمرٌ",2],[" صلَّى",1]],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن نصر في ((تعظيم قدر الصلاة)) (212) بلفظه، وأبو داود (1319) وأحمد (23299) مختصرا","bab":"زينة اللباس › لباس رسول الله صلى الله عليه وسلم","dorar":"IM6bGPFO","merged":2,"otherRefs":["تخريج زاد المعاد 4/304 (صحيح)"]},{"id":"س-00729","fp":"f336895e91e5","stateId":28,"easy":"إذا نزل بك كرب أو بلاء فادعُ بدعوة ذي النون ← يفرّج الله عنك","cause":"دُعاءُ ذي النونِ : لَا إِلهَ إلَّا أَنتَ سُبْحَانَكَ إِنَّي كُنتُ مِنَ الظَّالِمِينَ","result":"أَلَا أُخْبِرُكُمْ بشيءٍ إذا نزلَ برجلٍ منكم كربٌ ، أو بلاءٌ ، مِنْ أمرِ الدنيا دعا بِهِ فَفُرِّجَ عنه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"عند الكرب والهم"},"repOf":"س-00031","ref":"صحيح الجامع 2605","text":[["أَلَا أُخْبِرُكُمْ  بشيءٍ إذا نزلَ برجلٍ منكم كربٌ ، أو بلاءٌ ، مِنْ أمرِ الدنيا دعا بِهِ فَفُرِّجَ عنه ",2],"؟",[" دُعاءُ ذي النونِ : لَا إِلهَ إلَّا أَنتَ سُبْحَانَكَ إِنَّي كُنتُ مِنَ الظَّالِمِينَ",1]],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي الدنيا في ((الفرج بعد الشدة)) (33)، والنسائي في ((السنن الكبرى)) (10416)، والبيهقي في ((الدعوات الكبير)) (186) واللفظ لهم.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"jLDKLLVu"},{"id":"س-00757","fp":"5b41a2492af2","stateId":28,"easy":"إذا كُربت فقل «اللهم رحمتك أرجو فلا تكلني إلى نفسي...» ← فهي دعوات المكروب","cause":"اللَّهمَّ رحمتَكَ أرجو ، فلا تَكِلني إلى نَفسي طرفةَ عينٍ ، وأصلِح لي شأني كُلَّهُ، لا إلَهَ إلَّا أنتَ","result":"دعواتُ المَكْروبِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«اللهم رحمتك أرجو فلا تكلني إلى نفسي...»"},"ref":"الكلم الطيب 121","srcLabel":"أبو داود","text":[["دعواتُ المَكْروبِ",2]," : ",["اللَّهمَّ رحمتَكَ أرجو ، فلا تَكِلني إلى نَفسي طرفةَ عينٍ ، وأصلِح لي شأني كُلَّهُ، لا إلَهَ إلَّا أنتَ",1]],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"أورده في صحيح الكلم الطيب","takhrij":"أخرجه أبو داود (5090) مطولاً واللفظ له، وأحمد (20430) مطولاً باختلاف يسير","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"ZQjVskCJ"},{"id":"س-03616","fp":"a64cc464bfbe","stateId":28,"easy":"إذا نزلت بأهلك شدة أو ضيق فأمرهم بالصلاة ← (فعل نبوي، والصلاة مفزع الشدة)","cause":"إذا نزلَت بأهلِهِ شدَّةٌ أو ضيقٌ","result":"أمرَهُم بالصَّلاةِ وتلا وَأْمُرْ أَهْلَكَ بِالصَّلَاةِ الآيةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[54],"ref":"الدر المنثور 10/252","srcLabel":"الطبراني","text":["كان النَّبِيُّ صلَّى اللَّهُ عليهِ وسلَّمَ ",["إذا نزلَت بأهلِهِ شدَّةٌ أو ضيقٌ",1]," ",["أمرَهُم بالصَّلاةِ وتلا وَأْمُرْ أَهْلَكَ بِالصَّلَاةِ الآيةَ",2]],"grade":"صحيح","narrator":"عبدالله بن سلام","muhaddith":"إسناده  صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (886)، وأبو نعيم في ((حلية الأولياء)) (8/ 176)، والبيهقي في ((شعب الإيمان)) (2911) واللفظ لهم جميعا.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"D6iXiwbC","merged":2,"otherRefs":["مجمع الزوائد 7/70 (حسن)"]},{"id":"س-03724","fp":"205a3c6fdbd4","stateId":28,"easy":"إذا اشتد بك الأمر فقل «اللهم لك الحمد وإليك المشتكى وأنت المستعان...» ← (دعاء موسى عند الشدة)","cause":"حِين جاوَزَ البحْرَ ببَني إسرائيلَ","result":"قُولوا: اللَّهُمَّ لكَ الحمْدُ، ولكَ المُشْتَكى، وأنتَ المُسْتعانُ، ولا حوْلَ ولا قُوَّةَ إلَّا باللهِ العلِيِّ العظيمِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«اللهم لك الحمد وإليك المشتكى وأنت المستعان...»"},"otherNeedIds":[29],"ref":"مجموع رسائل العلائي 1/347","srcLabel":"مجموع رسائل العلائي","text":["ألَا أُعَلِّمُكم الكلماتِ الَّتي تَكلَّمَ بها مُوسى عليه السَّلامُ ",["حِين جاوَزَ البحْرَ ببَني إسرائيلَ",1],"؟ فقُلْنا: بلى يا رَسولَ اللهِ. قال: ",["قُولوا: اللَّهُمَّ لكَ الحمْدُ، ولكَ المُشْتَكى، وأنتَ المُسْتعانُ، ولا حوْلَ ولا قُوَّةَ إلَّا باللهِ العلِيِّ العظيمِ",2],".\nقال عبْدُ اللهِ بنُ مَسعودٍ: فما ترَكْتُهنَّ مُنذُ سَمِعتُهنَّ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ."],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"إسناده جيد","bab":"اعتصام بالسنة › لزوم السنة","dorar":"MeQNMb7A"},{"id":"س-04704","fp":"a0b34b27212b","stateId":29,"easy":"إذا أديت الأمانة وثمّرت حق الأجير ثم توسلت به ← يفرّج الله عنك (من قصة الغار)","cause":"استَأجَرتُ أجيرًا بفَرَقِ أرُزٍّ، فلَمَّا قَضى عَمَلَه قال: أعطِني حَقِّي، فعَرَضتُ عليه حَقَّه فتَرَكَه ورَغِبَ عنه، فلَم أزَلْ أزرَعُه حتَّى جَمَعتُ منه بَقَرًا وراعيَها، فجاءَني فقال: اتَّقِ اللهَ ولا تَظلِمْني وأعطِني حَقِّي، فقُلتُ: اذهَبْ إلى ذلك البَقَرِ وراعيها، فقال: اتَّقِ اللهَ ولا تَهزَأْ بي، فقُلتُ: إنِّي لا أهزَأُ بك، فخُذْ ذلك البَقَرَ وراعيَها","result":"ففَرَجَ اللهُ عنهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[29],"ref":"صحيح البخاري 5974","srcLabel":"متفق عليه","text":["بينَما ثَلاثةُ نَفَرٍ يَتَماشَونَ أخَذَهمُ المَطَرُ، فمالوا إلى غارٍ في الجَبَلِ، فانحَطَّت على فَمِ غارِهم صَخرةٌ مِنَ الجَبَلِ فأطبَقَت عليهم، فقال بَعضُهم لبَعضٍ: انظُروا أعمالًا عَمِلتُموها للَّهِ صالِحةً، فادعوا اللهَ بها لَعَلَّه يَفرُجُها. فقال أحَدُهم: اللهُمَّ إنَّه كان لي والِدانِ شيخانِ كَبيرانِ، ولي صِبيةٌ صِغارٌ، كُنتُ أرعى عليهم، فإذا رُحتُ عليهم فحَلَبتُ بَدَأتُ بوالِدَيَّ أسقيهما قَبلَ ولَدي، وإنَّه ناءَ بيَ الشَّجَرُ، فما أتَيتُ حتَّى أمسَيتُ فوجَدتُهما قد ناما، فحَلَبتُ كما كُنتُ أحلُبُ، فجِئتُ بالحِلابِ فقُمتُ عِندَ رُؤوسِهما، أكرَهُ أن أوقِظَهما مِن نَومِهما، وأكرَهُ أن أبدَأَ بالصِّبيةِ قَبلَهما، والصِّبيةُ يَتَضاغَونَ عِندَ قدَمَيَّ، فلَم يَزَلْ ذلك دَأبي ودَأبَهم حتَّى طَلَعَ الفَجرُ، فإن كُنتَ تَعلَمُ أنِّي فعَلتُ ذلك ابتِغاءَ وَجهِك فافرُجْ لنا فُرجةً نَرى مِنها السَّماءَ. ففَرَجَ اللهُ لهم فُرجةً حتَّى يَرَونَ مِنها السَّماءَ. وقال الثَّاني: اللهُمَّ إنَّه كانَت لي ابنةُ عَمٍّ أُحِبُّها كَأشَدِّ ما يُحِبُّ الرِّجالُ النِّساءَ، فطَلَبتُ إليها نَفسَها، فأبَت حتَّى آتيَها بمِئةِ دينارٍ، فسَعَيتُ حتَّى جَمَعتُ مِئةَ دينارٍ فلَقيتُها بها، فلَمَّا قَعَدتُ بينَ رِجلَيها قالت: يا عَبدَ اللهِ، اتَّقِ اللهَ، ولا تَفتَحِ الخاتَمَ، فقُمتُ عَنها، اللهُمَّ فإن كُنتَ تَعلَمُ أنِّي قد فعَلتُ ذلك ابتِغاءَ وجهِك فافرُجْ لنا مِنها. ففَرَجَ لهم فُرجةً. وقال الآخَرُ: اللهُمَّ إنِّي كُنتُ ",["استَأجَرتُ أجيرًا بفَرَقِ أرُزٍّ، فلَمَّا قَضى عَمَلَه قال: أعطِني حَقِّي، فعَرَضتُ عليه حَقَّه فتَرَكَه ورَغِبَ عنه، فلَم أزَلْ أزرَعُه حتَّى جَمَعتُ منه بَقَرًا وراعيَها، فجاءَني فقال: اتَّقِ اللهَ ولا تَظلِمْني وأعطِني حَقِّي، فقُلتُ: اذهَبْ إلى ذلك البَقَرِ وراعيها، فقال: اتَّقِ اللهَ ولا تَهزَأْ بي، فقُلتُ: إنِّي لا أهزَأُ بك، فخُذْ ذلك البَقَرَ وراعيَها",1],"، فأخَذَه فانطَلَقَ بها، فإن كُنتَ تَعلَمُ أنِّي فعَلتُ ذلك ابتِغاءَ وجهِك فافرُجْ ما بَقيَ. ",["ففَرَجَ اللهُ عنهم",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5974)، ومسلم (2743).","bab":"رقائق وزهد › الإخلاص","dorar":"semOV0I6","merged":6,"otherRefs":["مجمع الزوائد 8/145 (صحيح)","مجمع الزوائد 8/146 (حسن)","مجمع الزوائد 8/143 (صحيح)","صحيح ابن حبان 897 (صحيح)","تخريج المسند لشعيب 5973 (صحيح)"]},{"id":"س-04703","fp":"a0c4471dbb00","stateId":29,"easy":"إذا تركت الحرام خوفاً من الله وقدرت عليه ثم توسلت به ← يفرّج الله عنك (من قصة الغار)","cause":"قالت: يا عَبدَ اللهِ، اتَّقِ اللهَ، ولا تَفتَحِ الخاتَمَ، فقُمتُ عَنها","result":"ففَرَجَ لهم فُرجةً","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[20],"ref":"صحيح البخاري 5974","srcLabel":"متفق عليه","text":["بينَما ثَلاثةُ نَفَرٍ يَتَماشَونَ أخَذَهمُ المَطَرُ، فمالوا إلى غارٍ في الجَبَلِ، فانحَطَّت على فَمِ غارِهم صَخرةٌ مِنَ الجَبَلِ فأطبَقَت عليهم، فقال بَعضُهم لبَعضٍ: انظُروا أعمالًا عَمِلتُموها للَّهِ صالِحةً، فادعوا اللهَ بها لَعَلَّه يَفرُجُها. فقال أحَدُهم: اللهُمَّ إنَّه كان لي والِدانِ شيخانِ كَبيرانِ، ولي صِبيةٌ صِغارٌ، كُنتُ أرعى عليهم، فإذا رُحتُ عليهم فحَلَبتُ بَدَأتُ بوالِدَيَّ أسقيهما قَبلَ ولَدي، وإنَّه ناءَ بيَ الشَّجَرُ، فما أتَيتُ حتَّى أمسَيتُ فوجَدتُهما قد ناما، فحَلَبتُ كما كُنتُ أحلُبُ، فجِئتُ بالحِلابِ فقُمتُ عِندَ رُؤوسِهما، أكرَهُ أن أوقِظَهما مِن نَومِهما، وأكرَهُ أن أبدَأَ بالصِّبيةِ قَبلَهما، والصِّبيةُ يَتَضاغَونَ عِندَ قدَمَيَّ، فلَم يَزَلْ ذلك دَأبي ودَأبَهم حتَّى طَلَعَ الفَجرُ، فإن كُنتَ تَعلَمُ أنِّي فعَلتُ ذلك ابتِغاءَ وَجهِك فافرُجْ لنا فُرجةً نَرى مِنها السَّماءَ. ففَرَجَ اللهُ لهم فُرجةً حتَّى يَرَونَ مِنها السَّماءَ. وقال الثَّاني: اللهُمَّ إنَّه كانَت لي ابنةُ عَمٍّ أُحِبُّها كَأشَدِّ ما يُحِبُّ الرِّجالُ النِّساءَ، فطَلَبتُ إليها نَفسَها، فأبَت حتَّى آتيَها بمِئةِ دينارٍ، فسَعَيتُ حتَّى جَمَعتُ مِئةَ دينارٍ فلَقيتُها بها، فلَمَّا قَعَدتُ بينَ رِجلَيها ",["قالت: يا عَبدَ اللهِ، اتَّقِ اللهَ، ولا تَفتَحِ الخاتَمَ، فقُمتُ عَنها",1],"، اللهُمَّ فإن كُنتَ تَعلَمُ أنِّي قد فعَلتُ ذلك ابتِغاءَ وجهِك فافرُجْ لنا مِنها. ",["ففَرَجَ لهم فُرجةً",2],". وقال الآخَرُ: اللهُمَّ إنِّي كُنتُ استَأجَرتُ أجيرًا بفَرَقِ أرُزٍّ، فلَمَّا قَضى عَمَلَه قال: أعطِني حَقِّي، فعَرَضتُ عليه حَقَّه فتَرَكَه ورَغِبَ عنه، فلَم أزَلْ أزرَعُه حتَّى جَمَعتُ منه بَقَرًا وراعيَها، فجاءَني فقال: اتَّقِ اللهَ ولا تَظلِمْني وأعطِني حَقِّي، فقُلتُ: اذهَبْ إلى ذلك البَقَرِ وراعيها، فقال: اتَّقِ اللهَ ولا تَهزَأْ بي، فقُلتُ: إنِّي لا أهزَأُ بك، فخُذْ ذلك البَقَرَ وراعيَها، فأخَذَه فانطَلَقَ بها، فإن كُنتَ تَعلَمُ أنِّي فعَلتُ ذلك ابتِغاءَ وجهِك فافرُجْ ما بَقيَ. ففَرَجَ اللهُ عنهم."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5974)، ومسلم (2743).","bab":"رقائق وزهد › الإخلاص","dorar":"semOV0I6","merged":5,"otherRefs":["مجمع الزوائد 8/146 (حسن)","مجمع الزوائد 8/143 (صحيح)","صحيح ابن حبان 897 (صحيح)","تخريج المسند لشعيب 5973 (صحيح)"]},{"id":"س-04707","fp":"d19b17d645e2","stateId":29,"easy":"إذا عملت ابتغاء وجه الله ثم توسلت به ← يفرّج الله عنك (من قصة الغار)","cause":"فإن كُنتَ تَعلَمُ أنِّي فعَلتُ ذلك ابتِغاءَ وجهِكَ فافرُجْ لَنا منها فُرجةً، ففَرَجَ لهم. وقال الآخَرُ: اللَّهمَّ إنِّي كُنتُ استَأجَرتُ أجيرًا بفَرَقِ أرُزٍّ، فلَمَّا قَضى عَمَلَه قال: أعطِني حَقِّي، فعَرَضتُ عليه فرَقَه فرَغِبَ عنه، فلم أزَلْ أزرَعُه حتَّى جَمَعتُ منه بَقَرًا ورِعاءَها، فجاءَني فقال: اتَّقِ اللهَ ولا تَظلِمْني حَقِّي، قُلتُ: اذهَبْ إلى تلك البَقَرِ ورِعائِها، فخُذْها، فقال: اتَّقِ اللهَ ولا تَستَهزِئْ بي، فقُلتُ: إنِّي لا أستَهزِئُ بكَ، خُذْ ذلك البَقَرَ ورِعاءَها، فأخَذَه فذَهَبَ به، فإن كُنتَ تَعلَمُ أنِّي فعَلتُ ذلك ابتِغاءَ وجهِكَ فافرُجْ لَنا ما بَقيَ","result":"ففَرَجَ اللهُ ما بَقيَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[29],"ref":"صحيح مسلم 2743","srcLabel":"متفق عليه","text":["بينَما ثَلاثةُ نَفَرٍ يَتَمَشَّونَ أخَذَهمُ المَطَرُ، فأَوَوا إلى غارٍ في جَبَلٍ، فانحَطَّت على فمِ غارِهم صَخرةٌ مِنَ الجَبَلِ، فانطَبَقَت عليهم، فقال بَعضُهم لبَعضٍ: انظُروا أعمالًا عَمِلتُموها صالِحةً للَّهِ، فادعوا اللهَ تَعالى بها؛ لَعَلَّ اللهَ يَفرُجُها عَنكُم، فقال أحَدُهم: اللَّهمَّ إنَّه كان لي والِدانِ شيخانِ كَبيرانِ، وامرَأتي، ولي صِبيةٌ صِغارٌ أرعى عليهم، فإذا أرَحتُ عليهم حَلَبتُ، فبَدَأتُ بوالِدَيَّ، فسَقَيتُهما قَبلَ بَنيَّ، وأنَّه نَأى بي ذاتَ يَومٍ الشَّجَرُ، فلم آتِ حتَّى أمسَيتُ، فوجَدتُهما قد ناما، فحَلَبتُ كما كُنتُ أحلُبُ، فجِئتُ بالحِلابِ، فقُمتُ عِندَ رُؤوسِهما أكرَهُ أن أوقِظَهما مِن نَومِهما، وأكرَهُ أن أسقيَ الصِّبيةَ قَبلَهما، والصِّبيةُ يَتَضاغَونَ عِندَ قدَمَيَّ، فلم يَزَلْ ذلك دَأبي ودَأبَهم حتَّى طَلَعَ الفَجرُ، فإن كُنتَ تَعلَمُ أنِّي فعَلتُ ذلك ابتِغاءَ وجهِكَ فافرُجْ لَنا منها فُرجةً نَرى منها السَّماءَ، ففَرَجَ اللهُ منها فُرجةً، فرَأوا منها السَّماءَ. وقال الآخَرُ: اللَّهمَّ إنَّه كانَت ليَ ابنةُ عَمٍّ أحبَبتُها كَأشَدِّ ما يُحِبُّ الرِّجالُ النِّساءَ، وطَلَبتُ إليها نَفسَها، فأبَت حتَّى آتيَها بمِئةِ دينارٍ، فتَعِبتُ حتَّى جَمَعتُ مِئةَ دينارٍ، فجِئتُها بها، فلَمَّا وقَعتُ بينَ رِجلَيها، قالت: يا عَبدَ اللهِ، اتَّقِ اللهَ، ولا تَفتَحِ الخاتَمَ إلَّا بحَقِّه، فقُمتُ عَنها، ",["فإن كُنتَ تَعلَمُ أنِّي فعَلتُ ذلك ابتِغاءَ وجهِكَ فافرُجْ لَنا منها فُرجةً، ففَرَجَ لهم. وقال الآخَرُ: اللَّهمَّ إنِّي كُنتُ استَأجَرتُ أجيرًا بفَرَقِ أرُزٍّ، فلَمَّا قَضى عَمَلَه قال: أعطِني حَقِّي، فعَرَضتُ عليه فرَقَه فرَغِبَ عنه، فلم أزَلْ أزرَعُه حتَّى جَمَعتُ منه بَقَرًا ورِعاءَها، فجاءَني فقال: اتَّقِ اللهَ ولا تَظلِمْني حَقِّي، قُلتُ: اذهَبْ إلى تلك البَقَرِ ورِعائِها، فخُذْها، فقال: اتَّقِ اللهَ ولا تَستَهزِئْ بي، فقُلتُ: إنِّي لا أستَهزِئُ بكَ، خُذْ ذلك البَقَرَ ورِعاءَها، فأخَذَه فذَهَبَ به، فإن كُنتَ تَعلَمُ أنِّي فعَلتُ ذلك ابتِغاءَ وجهِكَ فافرُجْ لَنا ما بَقيَ",1],"، ",["ففَرَجَ اللهُ ما بَقيَ",2],". وزادوا في حَديثِهم: وخَرَجوا يَمشونَ. وفي حَديثِ صالِحٍ: يَتَماشَونَ، إلَّا عُبَيدَ اللهِ فإنَّ في حَديثِه: وخَرَجوا، ولم يَذكُرْ بَعدَها شيئًا. وفي روايةٍ: أنَّ عَبدَ اللهِ بنَ عُمَرَ قال: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: انطَلَقَ ثَلاثةُ رَهطٍ مِمَّن كان قَبلَكُم، حتَّى آواهمُ المَبيتُ إلى غارٍ، واقتَصَّ الحَديثَ بمَعنى حَديثِ نافِعٍ، عَنِ ابنِ عُمَرَ، غيرَ أنَّه قال: قال رَجُلٌ منهم: اللَّهمَّ كان لي أبَوانِ شيخانِ كَبيرانِ، فكُنتُ لا أغبِقُ قَبلَهما أهلًا ولا مالًا، وقال: فامتَنَعَت مِنِّي حتَّى ألَمَّت بها سَنةٌ مِنَ السِّنينَ، فجاءَتني فأعطَيتُها عِشرينَ ومِئةَ دينارٍ، وقال: فثَمَّرتُ أجرَه حتَّى كَثُرَت منه الأموالُ، فارتَعَجَت، وقال: فخَرَجوا مِنَ الغارِ يَمشونَ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5974)، ومسلم (2743).","bab":"رقائق وزهد › الإخلاص","dorar":"QZADo5Ix","merged":5,"otherRefs":["الآداب للبيهقي 476 (صحيح)","صحيح البخاري 2215 (صحيح)","صحيح البخاري 2272 (صحيح)","الصحيح المسند 2/209 (صحيح)"]},{"id":"س-00190","fp":"66da68a9325f","stateId":29,"easy":"إذا صدقت ← نجوت (لا ينجيك إلا الصدق)","cause":"الصِّدقُ","result":"لا يُنجيكُم إلَّا","explicit":true,"star":true,"ref":"صحيح البخاري 3465","srcLabel":"مسلم","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: بينَما ثَلاثةُ نَفَرٍ مِمَّن كان قَبلَكُم يَمشونَ إذ أصابَهم مَطَرٌ، فأوَوا إلى غارٍ فانطَبَقَ عليهم، فقال بَعضُهم لبَعضٍ: إنَّه واللهِ يا هؤلاء ",["لا يُنجيكُم إلَّا",2]," ",["الصِّدقُ",1],"، فليَدعُ كُلُّ رَجُلٍ منكم بما يَعلَمُ أنَّه قد صَدَقَ فيه، فقال واحِدٌ منهم: اللهُمَّ إن كُنتَ تَعلَمُ أنَّه كان لي أجيرٌ عَمِلَ لي على فَرَقٍ مِن أرُزٍّ، فذَهَبَ وتَرَكَه، وأنِّي عَمَدتُ إلى ذلك الفَرَقِ فزَرَعتُه، فصارَ مِن أمرِه أنِّي اشتَرَيتُ منه بَقَرًا، وأنَّه أتاني يَطلُبُ أجرَه، فقُلتُ له: اعمِدْ إلى تلك البَقَرِ فسُقْها، فقال لي: إنَّما لي عِندَك فَرَقٌ مِن أرُزٍّ، فقُلتُ له: اعمِدْ إلى تلك البَقَرِ فإنَّها مِن ذلك الفَرَقِ، فساقَها، فإن كُنتَ تَعلَمُ أنِّي فعَلتُ ذلك مِن خَشيَتِك ففَرِّجْ عَنَّا، فانساحَت عنهمُ الصَّخرةُ، فقال الآخَرُ: اللهُمَّ إن كُنتَ تَعلَمُ أنَّه كان لي أبَوانِ شيخانِ كَبيرانِ، فكُنتُ آتيهما كُلَّ لَيلةٍ بلَبَنِ غَنَمٍ لي، فأبطَأتُ عليهما لَيلةً، فجِئتُ وقد رَقدا، وأهلي وعيالي يَتَضاغَونَ مِنَ الجوعِ، فكُنتُ لا أسقيهم حتَّى يَشرَبَ أبَوايَ، فكَرِهتُ أن أوقِظَهما، وكَرِهتُ أن أدَعَهما، فيَستَكِنَّا لشَربَتِهما، فلَم أزَلْ أنتَظِرُ حتَّى طَلَعَ الفَجرُ، فإن كُنتَ تَعلَمُ أنِّي فعَلتُ ذلك مِن خَشيَتِك ففَرِّجْ عَنَّا، فانساحَت عنهمُ الصَّخرةُ حتَّى نَظَروا إلى السَّماءِ، فقال الآخَرُ: اللهُمَّ إن كُنتَ تَعلَمُ أنَّه كان لي ابنةُ عَمٍّ مِن أحَبِّ النَّاسِ إليَّ، وأنِّي راودتُها عن نَفسِها فأبَت، إلَّا أن آتيَها بمِئةِ دينارٍ، فطَلَبتُها حتَّى قدَرتُ فأتَيتُها بها فدَفَعتُها إليها، فأمكَنَتني مِن نَفسِها، فلَمَّا قَعَدتُ بينَ رِجلَيها فقالت: اتَّقِ اللهَ ولا تَفُضَّ الخاتَمَ إلَّا بحَقِّه، فقُمتُ وتَرَكتُ المِئةَ دينارٍ، فإن كُنتَ تَعلَمُ أنِّي فعَلتُ ذلك مِن خَشيَتِك ففَرِّجْ عَنَّا، ففَرَّجَ اللهُ عنهم فخَرَجوا."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2743) باختلاف يسير","bab":"آداب الكلام › الصدق وما جاء فيه","dorar":"ux6gO3DD"},{"id":"س-00191","fp":"b6dec2abd88c","stateId":29,"easy":"إذا توسلت إلى الله بعمل صالح خالص من خشيته ← يفرّج عنك","cause":"فإن كُنتَ تَعلَمُ أنِّي فعَلتُ ذلك مِن خَشيَتِك ففَرِّجْ عَنَّا","result":"ففَرَّجَ اللهُ عنهم فخَرَجوا","explicit":true,"star":true,"similar":["س-04715"],"ref":"صحيح البخاري 3465","srcLabel":"مسلم","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: بينَما ثَلاثةُ نَفَرٍ مِمَّن كان قَبلَكُم يَمشونَ إذ أصابَهم مَطَرٌ، فأوَوا إلى غارٍ فانطَبَقَ عليهم، فقال بَعضُهم لبَعضٍ: إنَّه واللهِ يا هؤلاء لا يُنجيكُم إلَّا الصِّدقُ، فليَدعُ كُلُّ رَجُلٍ منكم بما يَعلَمُ أنَّه قد صَدَقَ فيه، فقال واحِدٌ منهم: اللهُمَّ إن كُنتَ تَعلَمُ أنَّه كان لي أجيرٌ عَمِلَ لي على فَرَقٍ مِن أرُزٍّ، فذَهَبَ وتَرَكَه، وأنِّي عَمَدتُ إلى ذلك الفَرَقِ فزَرَعتُه، فصارَ مِن أمرِه أنِّي اشتَرَيتُ منه بَقَرًا، وأنَّه أتاني يَطلُبُ أجرَه، فقُلتُ له: اعمِدْ إلى تلك البَقَرِ فسُقْها، فقال لي: إنَّما لي عِندَك فَرَقٌ مِن أرُزٍّ، فقُلتُ له: اعمِدْ إلى تلك البَقَرِ فإنَّها مِن ذلك الفَرَقِ، فساقَها، فإن كُنتَ تَعلَمُ أنِّي فعَلتُ ذلك مِن خَشيَتِك ففَرِّجْ عَنَّا، فانساحَت عنهمُ الصَّخرةُ، فقال الآخَرُ: اللهُمَّ إن كُنتَ تَعلَمُ أنَّه كان لي أبَوانِ شيخانِ كَبيرانِ، فكُنتُ آتيهما كُلَّ لَيلةٍ بلَبَنِ غَنَمٍ لي، فأبطَأتُ عليهما لَيلةً، فجِئتُ وقد رَقدا، وأهلي وعيالي يَتَضاغَونَ مِنَ الجوعِ، فكُنتُ لا أسقيهم حتَّى يَشرَبَ أبَوايَ، فكَرِهتُ أن أوقِظَهما، وكَرِهتُ أن أدَعَهما، فيَستَكِنَّا لشَربَتِهما، فلَم أزَلْ أنتَظِرُ حتَّى طَلَعَ الفَجرُ، ",["فإن كُنتَ تَعلَمُ أنِّي فعَلتُ ذلك مِن خَشيَتِك ففَرِّجْ عَنَّا",1],"، فانساحَت عنهمُ الصَّخرةُ حتَّى نَظَروا إلى السَّماءِ، فقال الآخَرُ: اللهُمَّ إن كُنتَ تَعلَمُ أنَّه كان لي ابنةُ عَمٍّ مِن أحَبِّ النَّاسِ إليَّ، وأنِّي راودتُها عن نَفسِها فأبَت، إلَّا أن آتيَها بمِئةِ دينارٍ، فطَلَبتُها حتَّى قدَرتُ فأتَيتُها بها فدَفَعتُها إليها، فأمكَنَتني مِن نَفسِها، فلَمَّا قَعَدتُ بينَ رِجلَيها فقالت: اتَّقِ اللهَ ولا تَفُضَّ الخاتَمَ إلَّا بحَقِّه، فقُمتُ وتَرَكتُ المِئةَ دينارٍ، فإن كُنتَ تَعلَمُ أنِّي فعَلتُ ذلك مِن خَشيَتِك ففَرِّجْ عَنَّا، ",["ففَرَّجَ اللهُ عنهم فخَرَجوا",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2743) باختلاف يسير","bab":"آداب الكلام › الصدق وما جاء فيه","dorar":"ux6gO3DD"},{"id":"س-04715","fp":"932905a0bacb","stateId":29,"easy":"إذا توسلت إلى الله بعمل صالح خالص ← يفرّج عنك","cause":"فإن كُنتَ تَعلَمُ أنِّي فعَلتُ ذلك ابتِغاءَ وجهِك فافرُجْ عَنَّا فُرجةً","result":"ففَرَجَ عنهمُ الثُّلُثَينِ","explicit":true,"repOf":"س-00191","ref":"صحيح البخاري 2215","text":["خَرَجَ ثَلاثةُ نَفَرٍ يَمشونَ فأصابَهمُ المَطَرُ، فدَخَلوا في غارٍ في جَبَلٍ، فانحَطَّت عليهم صَخرةٌ، قال: فقال بَعضُهم لبَعضٍ: ادعوا اللهَ بأفضَلِ عَمَلٍ عَمِلتُموه، فقال أحَدُهم: اللهُمَّ إنِّي كان لي أبَوانِ شيخانِ كَبيرانِ، فكُنتُ أخرُجُ فأرعى، ثُمَّ أجيءُ فأحلُبُ فأجيءُ بالحِلابِ، فآتي به أبَويَّ فيَشرَبانِ، ثُمَّ أسقي الصِّبيةَ وأهلي وامرَأتي، فاحتَبَستُ لَيلةً، فجِئتُ فإذا هُما نائِمانِ، قال: فكَرِهتُ أن أوقِظَهما، والصِّبيةُ يَتَضاغَونَ عِندَ رِجلَيَّ، فلَم يَزَلْ ذلك دَأبي ودَأبَهما حتَّى طَلَعَ الفَجرُ، اللهُمَّ إن كُنتَ تَعلَمُ أنِّي فعَلتُ ذلك ابتِغاءَ وجهِك فافرُجْ عَنَّا فُرجةً نَرى مِنها السَّماءَ، قال: ففُرِجَ عنهم، وقال الآخَرُ: اللهُمَّ إن كُنتَ تَعلَمُ أنِّي كُنتُ أُحِبُّ امرَأةً مِن بَناتِ عَمِّي كَأشَدِّ ما يُحِبُّ الرَّجُلُ النِّساءَ، فقالت: لا تَنالُ ذلك مِنها حتَّى تُعطيَها مِئةَ دينارٍ، فسَعَيتُ فيها حتَّى جَمَعتُها، فلَمَّا قَعَدتُ بينَ رِجلَيها قالت: اتَّقِ اللهَ ولا تَفُضَّ الخاتَمَ إلَّا بحَقِّه، فقُمتُ وتَرَكتُها، ",["فإن كُنتَ تَعلَمُ أنِّي فعَلتُ ذلك ابتِغاءَ وجهِك فافرُجْ عَنَّا فُرجةً",1],"، قال: ",["ففَرَجَ عنهمُ الثُّلُثَينِ",2],"، وقال الآخَرُ: اللهُمَّ إن كُنتَ تَعلَمُ أنِّي استَأجَرتُ أجيرًا بفَرَقٍ مِن ذُرةٍ فأعطَيتُه، وأبى ذاك أن يَأخُذَ، فعَمَدتُ إلى ذلك الفَرَقِ فزَرَعتُه، حتَّى اشتَرَيتُ منه بَقَرًا وراعيَها، ثُمَّ جاءَ فقال: يا عَبدَ اللهِ، أعطِني حَقِّي، فقُلتُ: انطَلِقْ إلى تلك البَقَرِ وراعيها فإنَّها لَك، فقال: أتَستَهزِئُ بي؟ قال: فقُلتُ: ما أستَهزِئُ بك، ولَكِنَّها لك، اللهُمَّ إن كُنتَ تَعلَمُ أنِّي فعَلتُ ذلك ابتِغاءَ وجهِك فافرُجْ عَنَّا فكُشِفَ عنهم."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2743) باختلاف يسير","bab":"رقائق وزهد › الإخلاص","dorar":"EkCgn3Dv"},{"id":"س-04702","fp":"65a78a5689db","stateId":29,"easy":"إذا بررت والديك وصبرت على خدمتهما ثم توسلت به ← يفرّج الله عنك (من قصة الغار)","cause":"فقُمتُ عِندَ رُؤوسِهما، أكرَهُ أن أوقِظَهما مِن نَومِهما، وأكرَهُ أن أبدَأَ بالصِّبيةِ قَبلَهما، والصِّبيةُ يَتَضاغَونَ عِندَ قدَمَيَّ، فلَم يَزَلْ ذلك دَأبي ودَأبَهم حتَّى طَلَعَ الفَجرُ","result":"ففَرَجَ اللهُ لهم فُرجةً حتَّى يَرَونَ مِنها السَّماءَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-02310"],"otherNeedIds":[37],"ref":"صحيح البخاري 5974","srcLabel":"متفق عليه","text":["بينَما ثَلاثةُ نَفَرٍ يَتَماشَونَ أخَذَهمُ المَطَرُ، فمالوا إلى غارٍ في الجَبَلِ، فانحَطَّت على فَمِ غارِهم صَخرةٌ مِنَ الجَبَلِ فأطبَقَت عليهم، فقال بَعضُهم لبَعضٍ: انظُروا أعمالًا عَمِلتُموها للَّهِ صالِحةً، فادعوا اللهَ بها لَعَلَّه يَفرُجُها. فقال أحَدُهم: اللهُمَّ إنَّه كان لي والِدانِ شيخانِ كَبيرانِ، ولي صِبيةٌ صِغارٌ، كُنتُ أرعى عليهم، فإذا رُحتُ عليهم فحَلَبتُ بَدَأتُ بوالِدَيَّ أسقيهما قَبلَ ولَدي، وإنَّه ناءَ بيَ الشَّجَرُ، فما أتَيتُ حتَّى أمسَيتُ فوجَدتُهما قد ناما، فحَلَبتُ كما كُنتُ أحلُبُ، فجِئتُ بالحِلابِ ",["فقُمتُ عِندَ رُؤوسِهما، أكرَهُ أن أوقِظَهما مِن نَومِهما، وأكرَهُ أن أبدَأَ بالصِّبيةِ قَبلَهما، والصِّبيةُ يَتَضاغَونَ عِندَ قدَمَيَّ، فلَم يَزَلْ ذلك دَأبي ودَأبَهم حتَّى طَلَعَ الفَجرُ",1],"، فإن كُنتَ تَعلَمُ أنِّي فعَلتُ ذلك ابتِغاءَ وَجهِك فافرُجْ لنا فُرجةً نَرى مِنها السَّماءَ. ",["ففَرَجَ اللهُ لهم فُرجةً حتَّى يَرَونَ مِنها السَّماءَ",2],". وقال الثَّاني: اللهُمَّ إنَّه كانَت لي ابنةُ عَمٍّ أُحِبُّها كَأشَدِّ ما يُحِبُّ الرِّجالُ النِّساءَ، فطَلَبتُ إليها نَفسَها، فأبَت حتَّى آتيَها بمِئةِ دينارٍ، فسَعَيتُ حتَّى جَمَعتُ مِئةَ دينارٍ فلَقيتُها بها، فلَمَّا قَعَدتُ بينَ رِجلَيها قالت: يا عَبدَ اللهِ، اتَّقِ اللهَ، ولا تَفتَحِ الخاتَمَ، فقُمتُ عَنها، اللهُمَّ فإن كُنتَ تَعلَمُ أنِّي قد فعَلتُ ذلك ابتِغاءَ وجهِك فافرُجْ لنا مِنها. ففَرَجَ لهم فُرجةً. وقال الآخَرُ: اللهُمَّ إنِّي كُنتُ استَأجَرتُ أجيرًا بفَرَقِ أرُزٍّ، فلَمَّا قَضى عَمَلَه قال: أعطِني حَقِّي، فعَرَضتُ عليه حَقَّه فتَرَكَه ورَغِبَ عنه، فلَم أزَلْ أزرَعُه حتَّى جَمَعتُ منه بَقَرًا وراعيَها، فجاءَني فقال: اتَّقِ اللهَ ولا تَظلِمْني وأعطِني حَقِّي، فقُلتُ: اذهَبْ إلى ذلك البَقَرِ وراعيها، فقال: اتَّقِ اللهَ ولا تَهزَأْ بي، فقُلتُ: إنِّي لا أهزَأُ بك، فخُذْ ذلك البَقَرَ وراعيَها، فأخَذَه فانطَلَقَ بها، فإن كُنتَ تَعلَمُ أنِّي فعَلتُ ذلك ابتِغاءَ وجهِك فافرُجْ ما بَقيَ. ففَرَجَ اللهُ عنهم."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5974)، ومسلم (2743).","bab":"رقائق وزهد › الإخلاص","dorar":"semOV0I6","merged":4,"otherRefs":["مجمع الزوائد 8/146 (حسن)","صحيح ابن حبان 897 (صحيح)","تخريج المسند لشعيب 5973 (صحيح)"]},{"id":"س-02309","fp":"adf3d7d58821","stateId":29,"easy":"إذا وقعت في شدة فتوسل إلى الله بأوثق أعمالك الصالحة ← يفرّج الله عنك (من قصة الغار)","cause":"فادعوا اللهَ بأوْثَقِ أعْمالِكم","result":"فزالَ الثُّلُثُ الآخَرُ وخَرَجوا يَتَماشَونَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[29],"ref":"الأحاديث المختارة 2461","srcLabel":"متفق عليه","text":["«خَرَجَ ثَلاثةٌ ممَّن كانَ قَبْلَكم يَرْتادونَ لأَهْليهم فأصابَتْهم السَّماءُ، فلَجؤوا إلى جَبَلٍ فوَقَعَ عليهم حَجَرٌ، فقالَ بعضُهم لبعضٍ: قد عَفا الأثَرُ ووَقَعَ الحَجَرُ ولا يَعلَمُ بمَكانِكم إلَّا اللهُ عَزَّ وجَلَّ؛ ",["فادعوا اللهَ بأوْثَقِ أعْمالِكم",1],".\nفقالَ أحَدُهم: اللَّهُمَّ إن كُنْتَ تَعلَمُ أنَّه كانَ لي والِدانِ، فكُنْتُ أحْلُبُ لهما في إنائِهما، فإذا أتَيْتُهما وهما نائِمانِ قُمْتُ قائِمًا حتَّى يَسْتَيْقِظا متى اسْتَيْقَظا، وكَرِهْتُ أن يَدورَ وسِنَتُهما في رُؤوسِهما، فإذا اسْتَيْقَظا شَرِبا، فإن كُنْتَ تَعلَمُ أنَّما فَعلَتُ ذلك رَجاءَ رَحْمتِك وخَشيةَ عَذابِك ففَرِّجْ عنَّا.\nقالَ: فزالَ ثُلُثُ الحَجَرِ.\nقالَ: وقالَ الآخَرُ: اللَّهُمَّ إن كُنْتَ تَعلَمُ أنَّها كانَت امْرَأةٌ تُعجِبُني، فأبَتْ أن تُمكِّنِّي مِن نَفْسِها حتَّى جَعَلْتُ لها جُعْلًا، فلمَّا أخَذْتُها وَفَّرْتُ لها نَفْسَها وجُعْلَها، فإن كُنْتَ تَعلَمُ أنَّما فَعَلْتُ ذلك خَشيةَ عَذابِك، ورَجاءَ رَحْمتِك، ففَرِّجْ عنَّا.\nقالَ: فزالَ ثُلُثٌ آخَرُ.\nوقالَ الثَّالِثُ: إن كُنْتَ تَعلَمُ أنِّي اسْتَأْجَرْتُ أجيرًا يَعمَلُ لي يَوْمًا فعَمِلَ، فلمَّا كانَ اللَّيلُ أعْطَيْتُه أجْرَه فسَخِطَه ولم يَأخُذْه، فأخَذْتُ أجْرَه ووَفَّرْتُ عليه، حتَّى كانَ مِن كلِّ المالِ، ثُمَّ أتاني يَطلُبُ أجْرَه فقُلْتُ: خُذْ هذا كلَّه لك، ولو شِئْتُ لم أُعْطِه إلَّا أجْرَه، فإن كُنْتَ تَعلَمُ أنَّما فَعَلْتُ ذلك رَجاءَ رَحْمتِك وخَشيةَ عَذابِك ففَرِّجْ عنَّا.\nقالَ: ",["فزالَ الثُّلُثُ الآخَرُ وخَرَجوا يَتَماشَونَ",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"6cWDxvni","merged":2,"otherRefs":["صحيح ابن حبان 971 (صحيح)"]},{"id":"س-02310","fp":"2a368eed8dfc","stateId":29,"easy":"إذا بررت والديك ثم توسلت به في شدتك ← يفرّج الله عنك (من قصة الغار)","cause":"كانَ لي والِدانِ، فكُنْتُ أحْلُبُ لهما في إنائِهما، فإذا أتَيْتُهما وهما نائِمانِ قُمْتُ قائِمًا حتَّى يَسْتَيْقِظا","result":"فزالَ ثُلُثُ الحَجَرِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04702","otherNeedIds":[37],"ref":"الأحاديث المختارة 2461","text":["«خَرَجَ ثَلاثةٌ ممَّن كانَ قَبْلَكم يَرْتادونَ لأَهْليهم فأصابَتْهم السَّماءُ، فلَجؤوا إلى جَبَلٍ فوَقَعَ عليهم حَجَرٌ، فقالَ بعضُهم لبعضٍ: قد عَفا الأثَرُ ووَقَعَ الحَجَرُ ولا يَعلَمُ بمَكانِكم إلَّا اللهُ عَزَّ وجَلَّ؛ فادعوا اللهَ بأوْثَقِ أعْمالِكم.\nفقالَ أحَدُهم: اللَّهُمَّ إن كُنْتَ تَعلَمُ أنَّه ",["كانَ لي والِدانِ، فكُنْتُ أحْلُبُ لهما في إنائِهما، فإذا أتَيْتُهما وهما نائِمانِ قُمْتُ قائِمًا حتَّى يَسْتَيْقِظا",1]," متى اسْتَيْقَظا، وكَرِهْتُ أن يَدورَ وسِنَتُهما في رُؤوسِهما، فإذا اسْتَيْقَظا شَرِبا، فإن كُنْتَ تَعلَمُ أنَّما فَعلَتُ ذلك رَجاءَ رَحْمتِك وخَشيةَ عَذابِك ففَرِّجْ عنَّا.\nقالَ: ",["فزالَ ثُلُثُ الحَجَرِ",2],".\nقالَ: وقالَ الآخَرُ: اللَّهُمَّ إن كُنْتَ تَعلَمُ أنَّها كانَت امْرَأةٌ تُعجِبُني، فأبَتْ أن تُمكِّنِّي مِن نَفْسِها حتَّى جَعَلْتُ لها جُعْلًا، فلمَّا أخَذْتُها وَفَّرْتُ لها نَفْسَها وجُعْلَها، فإن كُنْتَ تَعلَمُ أنَّما فَعَلْتُ ذلك خَشيةَ عَذابِك، ورَجاءَ رَحْمتِك، ففَرِّجْ عنَّا.\nقالَ: فزالَ ثُلُثٌ آخَرُ.\nوقالَ الثَّالِثُ: إن كُنْتَ تَعلَمُ أنِّي اسْتَأْجَرْتُ أجيرًا يَعمَلُ لي يَوْمًا فعَمِلَ، فلمَّا كانَ اللَّيلُ أعْطَيْتُه أجْرَه فسَخِطَه ولم يَأخُذْه، فأخَذْتُ أجْرَه ووَفَّرْتُ عليه، حتَّى كانَ مِن كلِّ المالِ، ثُمَّ أتاني يَطلُبُ أجْرَه فقُلْتُ: خُذْ هذا كلَّه لك، ولو شِئْتُ لم أُعْطِه إلَّا أجْرَه، فإن كُنْتَ تَعلَمُ أنَّما فَعَلْتُ ذلك رَجاءَ رَحْمتِك وخَشيةَ عَذابِك ففَرِّجْ عنَّا.\nقالَ: فزالَ الثُّلُثُ الآخَرُ وخَرَجوا يَتَماشَونَ»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"6cWDxvni","merged":2,"otherRefs":["مجمع الزوائد 8/143 (صحيح)"]},{"id":"س-07754","fp":"4489242e26c7","stateId":29,"easy":"إذا صدقت ولم تكذب في محنتك ← ينجيك الله بالصدق (من قصة كعب)","cause":"إنَّ اللهَ إنَّما أنجاني بالصِّدقِ","result":"أنجاني","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[11,53],"ref":"صحيح مسلم 2769","srcLabel":"البخاري","text":["ثُمَّ غَزا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم غَزوةَ تَبوكَ، وهو يُريدُ الرُّومَ ونَصارى العَرَبِ بالشَّامِ، قال ابنُ شِهابٍ: فأخبَرَني عبدُ الرَّحمَنِ بنُ عبدِ اللهِ بنِ كَعبِ بنِ مالِكٍ، أنَّ عَبدَ اللهِ بنَ كَعبٍ كان قائِدَ كَعبٍ، مِن بَنيه، حينَ عَميَ، قال: سَمِعتُ كَعبَ بنَ مالِكٍ يُحَدِّثُ حَديثَه حينَ تَخَلَّفَ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةِ تَبوكَ، قال كَعبُ بنُ مالِكٍ: لم أتَخَلَّفْ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةٍ غَزاها قَطُّ إلَّا في غَزوةِ تَبوكَ، غيرَ أنِّي قد تَخَلَّفتُ في غَزوةِ بَدرٍ ولم يُعاتِبْ أحَدًا تَخَلَّفَ عنه، إنَّما خَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم والمُسلِمونَ يُريدونَ عيرَ قُرَيشٍ، حتَّى جَمع اللهُ بينَهم وبينَ عَدوِّهِم على غيرِ ميعادٍ، ولقد شَهِدتُ مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم لَيلةَ العَقَبةِ، حينَ تَواثَقنا على الإسلامِ، وما أُحِبُّ أنَّ لي بها مَشهَدَ بَدرٍ، وإن كانَت بَدرٌ أذكَرَ في النَّاسِ منها، وكانَ مِن خَبَري حينَ تَخَلَّفتُ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةِ تَبوكَ أنِّي لم أكُنْ قَطُّ أقوى ولا أيسَرَ مِنِّي حينَ تَخَلَّفتُ عنه في تلك الغَزوةِ، واللهِ ما جَمَعتُ قَبلَها راحِلَتَينِ قَطُّ، حتَّى جَمَعتُهما في تلك الغَزوةِ، فغَزاها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم في حَرٍّ شَديدٍ واستَقبَلَ سَفَرًا بَعيدًا ومَفازًا، واستَقبَلَ عَدوًّا كَثيرًا، فجَلا للمُسلِمينَ أمرَهم ليَتَأهَّبوا أُهبةَ غَزوِهم، فأخبَرَهم بوجهِهمِ الذي يُريدُ، والمُسلِمونَ مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم كَثيرٌ، ولا يَجمَعُهم كِتابُ حافِظٍ، يُريدُ بذلك الدِّيوانَ، قال كَعبٌ: فقَلَّ رَجُلٌ يُريدُ أن يَتَغَيَّبَ، يَظُنُّ أنَّ ذلك سَيَخفى له، ما لم يَنزِلْ فيه وحيٌ مِنَ اللهِ عَزَّ وجَلَّ، وغَزا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم تلك الغَزوةَ حينَ طابَتِ الثِّمارُ والظِّلالُ، فأنا إليها أصعَرُ، فتَجَهَّزَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم والمُسلِمونَ معهُ، وطَفِقتُ أغدو لكَي أتَجَهَّزَ معهُم، فأرجِعُ ولم أقضِ شيئًا، وأقولُ في نَفسي: أنا قادِرٌ على ذلك إذا أرَدتُ، فلم يَزَلْ ذلك يَتَمادى بي حتَّى استَمَرَّ بالنَّاسِ الجِدُّ، فأصبَحَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم غاديًا والمُسلِمونَ معهُ، ولم أقضِ مِن جَهازي شيئًا، ثُمَّ غَدَوتُ فرَجَعتُ ولم أقضِ شيئًا، فلم يَزَلْ ذلك يَتَمادى بي حتَّى أسرَعوا وتَفارَطَ الغَزوُ، فهَمَمتُ أن أرتَحِلَ فأُدرِكَهم، فيا لَيتَني فعَلتُ، ثُمَّ لم يُقدَّرْ ذلك لي، فطَفِقتُ إذا خَرَجتُ في النَّاسِ بَعدَ خُروجِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم يَحزُنُني أنِّي لا أرى لي أُسوةً إلَّا رَجُلًا مَغموصًا عليه في النِّفاقِ، أو رَجُلًا مِمَّن عَذَرَ اللهُ مِنَ الضُّعَفاءِ، ولم يَذكُرْني رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم حتَّى بَلَغَ تَبوكَ، فقال وهو جالِسٌ في القَومِ بتَبوكَ: ما فعَلَ كَعبُ بنُ مالِكٍ؟ قال رَجُلٌ مِن بَني سَلِمةَ: يا رَسولَ اللهِ، حَبَسَه بُرداه والنَّظَرُ في عِطفَيه، فقال له مُعاذُ بنُ جَبَلٍ: بئسَ ما قُلتَ! واللهِ يا رَسولَ اللهِ، ما عَلِمنا عليه إلَّا خَيرًا، فسَكَتَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فبينَما هو على ذلك رَأى رَجُلًا مُبَيِّضًا يَزولُ به السَّرابُ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: كُنْ أبا خَيثَمةَ، فإذا هو أبو خَيثَمةَ الأنصاريُّ، وهو الذي تَصَدَّقَ بصاعِ التَّمرِ حينَ لَمَزَه المُنافِقونَ. فقال كَعبُ بنُ مالِكٍ: فلَمَّا بَلَغَني أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قد تَوجَّهَ قافِلًا مِن تَبوكَ حَضَرَني بَثِّي، فطَفِقتُ أتَذَكَّرُ الكَذِبَ وأقولُ: بمَ أخرُجُ مِن سَخَطِه غَدًا؟ وأستَعينُ على ذلك كُلَّ ذي رَأيٍ مِن أهلي، فلَمَّا قيلَ لي: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قد أظَلَّ قادِمًا زاحَ عَنِّي الباطِلُ، حتَّى عَرَفتُ أنِّي لَن أنجوَ منه بشيءٍ أبَدًا، فأجمَعتُ صِدقَه، وصَبَّحَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم قادِمًا، وكانَ إذا قدِمَ مِن سَفَرٍ بَدَأ بالمَسجِدِ فرَكَعَ فيه رَكعَتَينِ، ثُمَّ جَلَسَ للنَّاسِ، فلَمَّا فعَلَ ذلك جاءَه المُخَلَّفونَ، فطَفِقوا يَعتَذِرونَ إليه، ويَحلِفونَ له، وكانوا بضعةً وثَمانينَ رَجُلًا، فقَبِلَ منهم رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم عَلانيَتَهم، وبايَعَهم واستَغفَرَ لهم، ووكَلَ سَرائِرَهم إلى اللهِ، حتَّى جِئتُ، فلَمَّا سَلَّمتُ تَبَسَّمَ تَبَسُّمَ المُغضَبِ، ثُمَّ قال: تَعالَ، فجِئتُ أمشي حتَّى جَلَستُ بينَ يَدَيه، فقال لي: ما خَلَّفَكَ؟ ألَم تَكُنْ قدِ ابتَعتَ ظَهرَكَ؟ قال: قُلتُ: يا رَسولَ اللهِ، إنِّي، واللهِ لو جَلَستُ عِندَ غيرِكَ مِن أهلِ الدُّنيا لَرَأيتُ أنِّي سَأخرُجُ مِن سَخَطِه بعُذرٍ، ولقد أُعطيتُ جَدَلًا، ولَكِنِّي واللهِ لقد عَلِمتُ لَئِن حَدَّثتُكَ اليومَ حَديثَ كَذِبٍ تَرضى به عَنِّي لَيوشِكَنَّ اللهُ أن يُسخِطَكَ عليَّ، ولَئِن حَدَّثتُكَ حَديثَ صِدقٍ تَجِدُ عليَّ فيه، إنِّي لأرجو فيه عُقبى اللهِ، واللهِ ما كان لي عُذرٌ، واللهِ ما كُنتُ قَطُّ أقوى ولا أيسَرَ مِنِّي حينَ تَخَلَّفتُ عَنكَ، قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أمَّا هذا فقد صَدَقَ، فقُمْ حتَّى يَقضيَ اللهُ فيكَ، فقُمتُ، وثارَ رِجالٌ مِن بَني سَلِمةَ فاتَّبَعوني، فقالوا لي: واللهِ ما عَلِمناكَ أذنَبتَ ذَنبًا قَبلَ هذا، لقد عَجَزتَ في أن لا تَكونَ اعتَذَرتَ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم بما اعتَذَرَ به إليه المُخَلَّفونَ؛ فقد كان كافيَكَ ذَنبَكَ استِغفارُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم لَكَ. قال: فواللهِ ما زالوا يُؤَنِّبوني حتَّى أرَدتُ أن أرجِعَ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فأُكَذِّبَ نَفسي، قال ثُمَّ قُلتُ لهم: هل لَقيَ هذا مَعي مِن أحَدٍ؟ قالوا: نَعَم، لَقيَه معكَ رَجُلانِ، قالا مِثلَ ما قُلتَ، فقيلَ لهما مِثلَ ما قيلَ لَكَ، قال: قُلتُ: مَن هُما؟ قالوا: مُرارةُ بنُ الرَّبيعةِ العامِريُّ، وهِلالُ بنُ أُمَيَّةَ الواقِفيُّ، قال: فذَكَروا لي رَجُلَينِ صالِحَينِ قد شَهِدا بَدرًا، فيهما أُسوةٌ، قال: فمَضَيتُ حينَ ذَكَروهما لي. قال: ونَهى رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم المُسلِمينَ عن كَلامِنا -أيُّها الثَّلاثةُ- مِن بَينِ مَن تَخَلَّفَ عنه. قال: فاجتَنَبَنا النَّاسُ، وقال: تَغَيَّروا لَنا حتَّى تَنَكَّرَت لي في نَفسيَ الأرضُ، فما هي بالأرضِ التي أعرِفُ، فلَبِثنا على ذلك خَمسينَ لَيلةً، فأمَّا صاحِبايَ فاستَكانا وقَعَدا في بُيوتِهما يَبكيانِ، وأمَّا أنا فكُنتُ أشَبَّ القَومِ وأجلَدَهم، فكُنتُ أخرُجُ فأشهَدُ الصَّلاةَ وأطوفُ في الأسواقِ ولا يُكَلِّمُني أحَدٌ، وآتي رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم فأُسَلِّمُ عليه وهو في مَجلِسِه بَعدَ الصَّلاةِ، فأقولُ في نَفسي: هل حَرَّكَ شَفَتَيه برَدِّ السَّلامِ، أم لا؟ ثُمَّ أُصَلِّي قَريبًا منه وأُسارِقُه النَّظَرَ، فإذا أقبَلتُ على صَلاتي نَظَرَ إليَّ، وإذا التَفَتُّ نَحوه أعرَضَ عَنِّي، حتَّى إذا طالَ ذلك عليَّ مِن جَفوةِ المُسلِمينَ مَشيتُ حتَّى تَسَوَّرتُ جِدارَ حائِطِ أبي قَتادةَ، وهو ابنُ عَمِّي، وأحَبُّ النَّاسِ إليَّ، فسَلَّمتُ عليه، فواللهِ ما رَدَّ عليَّ السَّلامَ. فقُلتُ له: يا أبا قَتادةَ، أنشُدُكَ باللهِ هل تَعلَمَنَّ أنِّي أُحِبُّ اللهَ ورَسولَه؟ قال: فسَكَتَ، فعُدتُ فناشَدتُه، فسَكَتَ، فعُدتُ فناشَدتُه، فقال: اللهُ ورَسولُه أعلَمُ، ففاضَت عَينايَ وتَولَّيتُ حتَّى تَسَوَّرتُ الجِدارَ. فبينا أنا أمشي في سوقِ المَدينةِ إذا نَبَطيٌّ مِن نَبَطِ أهلِ الشَّامِ، مِمَّن قدِمَ بالطَّعامِ يَبيعُه بالمَدينةِ، يقولُ: مَن يَدُلُّ على كَعبِ بنِ مالِكٍ؟ قال: فطَفِقَ النَّاسُ يُشيرونَ له إليَّ، حتَّى جاءَني فدَفَعَ إليَّ كِتابًا مِن مَلِكِ غَسَّانَ، وكُنتُ كاتِبًا، فقَرَأتُه فإذا فيه: أمَّا بَعدُ؛ فإنَّه قد بَلَغَنا أنَّ صاحِبَكَ قد جَفاكَ، ولم يَجعَلْكَ اللهُ بدارِ هَوانٍ ولا مَضيَعةٍ، فالحَقْ بنا نُواسِكَ، قال: فقُلتُ حينَ قَرَأتُها: وهذه أيضًا مِنَ البَلاءِ، فتَيامَمتُ بها التَّنُّورَ فسَجَرتُها بها، حتَّى إذا مَضَت أربَعونَ مِنَ الخَمسينَ، واستَلبَثَ الوحيُ، إذا رَسولُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم يَأتيني، فقال: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَأمُرُكَ أن تَعتَزِلَ امرَأتَكَ، قال: فقُلتُ: أُطَلِّقُها أم ماذا أفعَلُ؟ قال: لا، بَلِ اعتَزِلها، فلا تَقرَبَنَّها، قال: فأرسَلَ إلى صاحِبَيَّ بمِثلِ ذلك، قال: فقُلتُ لامرَأتي: الحَقي بأهلِكِ فكوني عِندَهم حتَّى يَقضيَ اللهُ في هذا الأمرِ، قال: فجاءَتِ امرَأةُ هِلالِ بنِ أُمَيَّةَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فقالت له: يا رَسولَ اللهِ، إنَّ هِلالَ بنَ أُمَيَّةَ شيخٌ ضائِعٌ ليس له خادِمٌ، فهل تَكرَهُ أن أخدُمَه؟ قال: لا، ولَكِن لا يَقرَبَنَّكِ، فقالت: إنَّه واللهِ ما به حَرَكةٌ إلى شيءٍ، وواللهِ ما زالَ يَبكي مُنذُ كان مِن أمرِه ما كانَ إلى يَومِه هذا، قال: فقال لي بَعضُ أهلي: لَوِ استَأذَنتَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم في امرَأتِكَ؟ فقد أذِنَ لامرَأةِ هِلالِ بنِ أُمَيَّةَ أن تَخدُمَه، قال: فقُلتُ: لا أستَأذِنُ فيها رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، وما يُدريني ماذا يقولُ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم إذا استَأذَنتُه فيها، وأنا رَجُلٌ شابٌّ، قال: فلَبِثتُ بذلك عَشرَ لَيالٍ، فكَمُلَ لَنا خَمسونَ لَيلةً مِن حينَ نُهي عن كَلامِنا، قال: ثُمَّ صَلَّيتُ صَلاةَ الفَجرِ صَباحَ خَمسينَ لَيلةً على ظَهرِ بَيتٍ مِن بُيوتِنا، فبينا أنا جالِسٌ على الحالِ التي ذَكَرَ اللهُ عَزَّ وجَلَّ مِنَّا قد ضاقَت عليَّ نَفسي وضاقَت عليَّ الأرضُ بما رَحُبَت، سَمِعتُ صَوتَ صارِخٍ أوفى على سَلعٍ يقولُ بأعلى صَوتِه: يا كَعبَ بنَ مالِكٍ أبشِرْ، قال: فخَرَرتُ ساجِدًا وعَرَفتُ أنْ قد جاءَ فرَجٌ. قال: فآذَنَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم النَّاسَ بتَوبةِ اللهِ علينا، حينَ صَلَّى صَلاةَ الفَجرِ، فذَهَبَ النَّاسُ يُبَشِّرونَنا، فذَهَبَ قِبَلَ صاحِبَيَّ مُبَشِّرونَ، ورَكَضَ رَجُلٌ إليَّ فرَسًا، وسَعى ساعٍ مِن أسلَمَ قِبَلي، وأوفى الجَبَلَ، فكانَ الصَّوتُ أسرَعَ مِنَ الفَرَسِ، فلَمَّا جاءَني الذي سَمِعتُ صَوتَه يُبَشِّرُني فنَزَعتُ له ثَوبَيَّ فكَسَوتُهما إيَّاه ببِشارَتِه، واللهِ ما أملِكُ غَيرَهما يَومَئذٍ، واستَعَرتُ ثَوبَينِ فلَبِستُهما، فانطَلَقتُ أتَأمَّمُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَتَلَقَّاني النَّاسُ فوجًا فوجًا، يُهَنِّئوني بالتَّوبةِ ويقولونَ: لتَهنِئْكَ تَوبةُ اللهِ عليكَ! حتَّى دَخَلتُ المَسجِدَ، فإذا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم جالِسٌ في المَسجِدِ وحَوله النَّاسُ، فقامَ طَلحةُ بنُ عُبَيدِ اللهِ يُهَروِلُ حتَّى صافَحَني وهَنَّأني، واللهِ ما قامَ رَجُلٌ مِنَ المُهاجِرينَ غَيرُه. قال: فكانَ كَعبٌ لا يَنساها لطَلحةَ. قال كَعبٌ: فلَمَّا سَلَّمتُ على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم قال وهو يَبرُقُ وجهُه مِنَ السُّرورِ ويقولُ: أبشِرْ بخَيرِ يَومٍ مَرَّ عليكَ مُنذُ ولَدَتكَ أُمُّكَ، قال: فقُلتُ: أمِن عِندِكَ يا رَسولَ اللهِ أم مِن عِندِ اللهِ؟ فقال: لا، بَل مِن عِندِ اللهِ، وكانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم إذا سُرَّ استَنارَ وجهُه، كَأنَّ وجهَه قِطعةُ قَمَرٍ، قال: وكُنَّا نَعرِفُ ذلك، قال: فلَمَّا جَلَستُ بينَ يَدَيه قُلتُ: يا رَسولَ اللهِ، إنَّ مِن تَوبَتي أن أنخَلِعَ مِن مالي صَدَقةً إلى اللهِ وإلى رَسولِه صلَّى اللهُ عليه وسلَّم، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أمسِكْ بَعضَ مالِكَ فهو خَيرٌ لكَ، قال: فقُلتُ: فإنِّي أُمسِكُ سَهميَ الذي بخَيبَرَ، قال: وقُلتُ: يا رَسولَ اللهِ، ",["إنَّ اللهَ إنَّما ",1],["أنجاني",2],[" بالصِّدقِ",1],"، وإنَّ مِن تَوبَتي أن لا أُحَدِّثَ إلَّا صِدقًا ما بَقيتُ، قال: فواللهِ ما عَلِمتُ أنَّ أحَدًا مِنَ المُسلِمينَ أبلاه اللهُ في صِدقِ الحَديثِ مُنذُ ذَكَرتُ ذلك لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّم إلى يَومي هذا أحسَنَ ممَّا أبلاني اللهُ به، واللهِ ما تَعَمَّدتُ كَذبةً مُنذُ قُلتُ ذلك لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّم إلى يَومي هذا، وإنِّي لأرجو أن يَحفَظَني اللهُ فيما بَقيَ. قال: فأنزَلَ اللهُ عَزَّ وجَلَّ: {لقد تابَ اللهُ على النَّبيِّ والمُهاجِرينَ والأنصارِ الذينَ اتَّبَعوه في ساعةِ العُسرةِ مِن بَعدِ ما كادَ يَزيغُ قُلوبُ فريقٍ منهم ثُمَّ تابَ عليهم إنَّه بهم رَؤوفٌ رَحيمٌ وعلى الثَّلاثةِ الذينَ خُلِّفوا حتَّى إذا ضاقَت عليهمِ الأرضُ بما رَحُبَت وضاقَت عليهم أنفُسُهم} حتَّى بَلَغَ: {يا أيُّها الذينَ آمَنوا اتَّقوا اللهَ وكونوا مع الصَّادِقينَ}. قال كَعبٌ: واللهِ ما أنعَمَ اللهُ عليَّ مِن نِعمةٍ قَطُّ بَعدَ إذ هَداني اللهُ للإسلامِ أعظَمَ في نَفسي مِن صِدقي رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم أن لا أكونَ كَذَبتُه فأهلِكَ كما هَلَكَ الذينَ كَذَبوا، إنَّ اللهَ قال للذينَ كَذَبوا حينَ أنزَلَ الوحيَ شَرَّ ما قال لأحَدٍ. وقال اللهُ: {سَيَحلِفونَ باللهِ لَكُم إذا انقَلَبتُم إليهم لتُعرِضوا عنهم فأعرِضوا عنهم إنَّهم رِجسٌ ومَأواهم جَهَنَّمُ جَزاءً بما كانوا يَكسِبونَ يَحلِفونَ لَكُم لتَرضَوا عنهم فإن تَرضَوا عنهم فإنَّ اللهَ لا يَرضى عَنِ القَومِ الفاسِقينَ}. قال كَعبٌ: كُنَّا خُلِّفنا أيُّها الثَّلاثةُ عن أمرِ أولَئِكَ الذينَ قَبِلَ منهم رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم حينَ حَلَفوا له، فبايَعَهم واستَغفَرَ لهم، وأرجَأ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم أمرَنا حتَّى قَضى اللهُ فيه، فبِذلك قال اللهُ عَزَّ وجَلَّ: وعلى الثَّلاثةِ الذينَ خُلِّفوا، وليسَ الذي ذَكَرَ اللهُ ممَّا خُلِّفنا تَخَلُّفَنا عَنِ الغَزوِ، وإنَّما هو تَخليفُه إيَّانا، وإرجاؤُه أمرَنا، عَمَّن حَلَفَ له واعتَذَرَ إليه فقَبِلَ منه. وفي روايةٍ: أنَّ عُبَيدَ اللهِ بنَ كَعبِ بنِ مالِكٍ، وكانَ قائِدَ كَعبٍ حينَ عَميَ، قال: سَمِعتُ كَعبَ بنَ مالِكٍ يُحَدِّثُ حَديثَه حينَ تَخَلَّفَ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةِ تَبوكَ، وساقَ الحَديثَ. وزادَ فيه، على يونُسَ: فكانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم قَلَّما يُريدُ غَزوةً إلَّا ورَّى بغَيرِها، حتَّى كانَت تلك الغَزوةُ."],"grade":"صحيح","narrator":"كعب بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4418)، وأحمد (15789) باختلاف يسير، والنسائي في ((الكبرى)) (11168) بنحوه.","bab":"قرآن › أسباب النزول","dorar":"MuC2vFZU","merged":2,"otherRefs":["تخريج المسند لشعيب 15770 (صحيح)"]},{"id":"س-02629","fp":"e56918969ab4","stateId":29,"easy":"إذا عملت عملاً رجاء رحمة الله وخشية عذابه ثم توسلت به ← يفرّج الله كربك (من قصة الغار)","cause":"فإنْ كُنْتَ تعلَمُ أنِّي فعَلْتُ ذلكَ رجاءَ رحمتِكَ وخشيةَ عذابِكَ","result":"فزال ثُلُثُ الجَبلِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[29],"ref":"صحيح ابن حبان 971","srcLabel":"الطبراني","text":["خرَج ثلاثةٌ فيمَنْ كان قبْلَكم يرتادونَ لأهلِهم فأصابَتْهم السَّماءُ فلجَؤوا إلى جَبلٍ فوقَعَتْ عليهم صخرةٌ فقال بعضُهم لبعضٍ : عفا الأثَرُ ووقَع الحجَرُ ولا يعلَمُ مكانَكم إلَّا اللهُ ادعوا اللهَ بأوثَقِ أعمالِكم فقال أحدُهم : اللَّهمَّ إنْ كُنْتَ تعلَمُ أنَّه كانتِ امرأةٌ تُعجِبُني فطلَبْتُها فأبَتْ علَيَّ فجعَلْتُ لها جُعْلًا فلمَّا قرَّبَتْ نفسَها ترَكْتُها فإنْ كُنْتَ تعلَمُ أنِّي إنَّما فعَلْتُ ذلكَ رجاءَ رحمتِكَ وخشيةَ عذابِكَ فافرُجْ عنَّا ",["فزال ثُلُثُ الجَبلِ",2]," فقال الآخَرُ : اللَّهمَّ إنْ كُنْتَ تعلَمُ أنَّه كان لي والدانِ وكُنْتُ أحلُبُ لهما في إنائِهما فإذا أتَيْتُهما وهما نائمانِ قُمْتُ قائمًا حتَّى يستيقِظا فإذا استيقَظا شرِبا ",["فإنْ كُنْتَ تعلَمُ أنِّي فعَلْتُ ذلكَ رجاءَ رحمتِكَ وخشيةَ عذابِكَ",1]," فافرُجْ عنَّا فزال ثُلُثُ الحجَرِ فقال الثَّالثُ : اللَّهمَّ إنْ كُنْتَ تعلَمْ أنِّي استأجَرْتُ أجيرًا يومًا فعمِل لي نصفَ النَّهارِ فأعطَيْتُه أجرَه فتسخَّطه ولَمْ يأخُذْه فوفَّرْتُها عليه حتَّى صار مِن كلِّ المالِ ثمَّ جاء يطلُبُ أجرَه فقُلْتُ : خُذْ هذا كلَّه ولو شِئْتُ لَمْ أُعْطِه إلَّا أجرَه فإنْ كُنْتَ تعلَمُ أنِّي فعَلْتُ ذلكَ رجاءَ رحمتِكَ وخشيةَ عذابِكَ فافرُجْ عنَّا قال : فزال الحجَرُ وخرَجوا يتماشَوْنَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الطيالسي (2126)، وأبو عوانة (6006)، والطبراني في ((الدعاء)) (‌193) واللفظ لهم.","bab":"إيمان › الاحتساب والنية","dorar":"XzgEsALL"},{"id":"ق-0407","fp":"cc350798360f","stateId":30,"easy":"الإيمان مع نوح ← النجاة في الفلك","cause":"الإيمان مع نوح","result":"النجاة في الفلك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["ق-0561","ق-0939"],"ref":"سورة الأعراف: 64","srcLabel":"القرآن الكريم","quran":{"s":7,"from":64,"to":64,"text":"فَكَذَّبُوهُ فَأَنْجَيْنَاهُ وَالَّذِينَ مَعَهُ فِي الْفُلْكِ وَأَغْرَقْنَا الَّذِينَ كَذَّبُوا بِآيَاتِنَا إِنَّهُمْ كَانُوا قَوْمًا عَمِينَ (64)","hl":[[13,61,1]]}},{"id":"ق-0436","fp":"ecee0d11e14a","stateId":30,"easy":"النهي عن السوء ← النجاة من العذاب","cause":"النهي عن السوء","result":"النجاة من العذاب","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[31],"ref":"سورة الأعراف: 165","srcLabel":"القرآن الكريم","quran":{"s":7,"from":165,"to":165,"text":"فَلَمَّا نَسُوا مَا ذُكِّرُوا بِهِ أَنْجَيْنَا الَّذِينَ يَنْهَوْنَ عَنِ السُّوءِ وَأَخَذْنَا الَّذِينَ ظَلَمُوا بِعَذَابٍ بَئِيسٍ بِمَا كَانُوا يَفْسُقُونَ (165)","hl":[[35,81,1]]}},{"id":"ق-0561","fp":"0271443069e4","stateId":30,"easy":"الإيمان مع نوح ← النجاة والاستخلاف","cause":"الإيمان مع نوح","result":"النجاة والاستخلاف","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0407","otherNeedIds":[43],"ref":"سورة يونس: 73","quran":{"s":10,"from":73,"to":73,"text":"فَكَذَّبُوهُ فَنَجَّيْنَاهُ وَمَنْ مَعَهُ فِي الْفُلْكِ وَجَعَلْنَاهُمْ خَلَائِفَ وَأَغْرَقْنَا الَّذِينَ كَذَّبُوا بِآيَاتِنَا فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُنْذَرِينَ (73)","hl":[[13,81,1]]}},{"id":"ق-0570","fp":"a899f6ff84b7","stateId":30,"easy":"الإيمان قبل نزول العذاب (قوم يونس) ← كشف عذاب الخزي والتمتيع إلى حين","cause":"الإيمان قبل نزول العذاب (قوم يونس)","result":"كشف عذاب الخزي والتمتيع إلى حين","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[32],"ref":"سورة يونس: 98","srcLabel":"القرآن الكريم","quran":{"s":10,"from":98,"to":98,"text":"فَلَوْلَا كَانَتْ قَرْيَةٌ آمَنَتْ فَنَفَعَهَا إِيمَانُهَا إِلَّا قَوْمَ يُونُسَ لَمَّا آمَنُوا كَشَفْنَا عَنْهُمْ عَذَابَ الْخِزْيِ فِي الْحَيَاةِ الدُّنْيَا وَمَتَّعْنَاهُمْ إِلَى حِينٍ (98)","hl":[[0,187,1]]}},{"id":"ق-0572","fp":"6048d2c62f6d","stateId":30,"easy":"الإيمان ← نجاة المؤمنين حقاً على الله","cause":"الإيمان","result":"نجاة المؤمنين حقاً على الله","explicit":true,"otherNeedIds":[25],"ref":"سورة يونس: 103","srcLabel":"القرآن الكريم","quran":{"s":10,"from":103,"to":103,"text":"ثُمَّ نُنَجِّي رُسُلَنَا وَالَّذِينَ آمَنُوا كَذَلِكَ حَقًّا عَلَيْنَا نُنْجِ الْمُؤْمِنِينَ (103)","hl":[[0,92,1]]}},{"id":"ق-0585","fp":"6a1e8e1e6888","stateId":30,"easy":"الإيمان مع هود ← النجاة برحمة الله من عذاب غليظ","cause":"الإيمان مع هود","result":"النجاة برحمة الله من عذاب غليظ","explicit":true,"similar":["ق-0588","ق-0595","ق-1260"],"ref":"سورة هود: 58","srcLabel":"القرآن الكريم","quran":{"s":11,"from":58,"to":58,"text":"وَلَمَّا جَاءَ أَمْرُنَا نَجَّيْنَا هُودًا وَالَّذِينَ آمَنُوا مَعَهُ بِرَحْمَةٍ مِنَّا وَنَجَّيْنَاهُمْ مِنْ عَذَابٍ غَلِيظٍ (58)","hl":[[0,125,1]]}},{"id":"ق-0588","fp":"2e29f1dd3b91","stateId":30,"easy":"الإيمان مع صالح ← النجاة برحمة الله من خزي يومئذ","cause":"الإيمان مع صالح","result":"النجاة برحمة الله من خزي يومئذ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0585","ref":"سورة هود: 66","quran":{"s":11,"from":66,"to":66,"text":"فَلَمَّا جَاءَ أَمْرُنَا نَجَّيْنَا صَالِحًا وَالَّذِينَ آمَنُوا مَعَهُ بِرَحْمَةٍ مِنَّا وَمِنْ خِزْيِ يَوْمِئِذٍ إِنَّ رَبَّكَ هُوَ الْقَوِيُّ الْعَزِيزُ (66)","hl":[[0,114,1]]}},{"id":"ق-0595","fp":"5d7bf5ebd57d","stateId":30,"easy":"الإيمان مع شعيب ← النجاة برحمة الله","cause":"الإيمان مع شعيب","result":"النجاة برحمة الله","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0585","ref":"سورة هود: 94","quran":{"s":11,"from":94,"to":94,"text":"وَلَمَّا جَاءَ أَمْرُنَا نَجَّيْنَا شُعَيْبًا وَالَّذِينَ آمَنُوا مَعَهُ بِرَحْمَةٍ مِنَّا وَأَخَذَتِ الَّذِينَ ظَلَمُوا الصَّيْحَةُ فَأَصْبَحُوا فِي دِيَارِهِمْ جَاثِمِينَ (94)","hl":[[25,90,1]]}},{"id":"ق-0601","fp":"92dc094bb45b","stateId":30,"easy":"النهي عن الفساد في الأرض ← النجاة","cause":"النهي عن الفساد في الأرض","result":"النجاة","explicit":true,"otherNeedIds":[31],"ref":"سورة هود: 116","srcLabel":"القرآن الكريم","quran":{"s":11,"from":116,"to":116,"text":"فَلَوْلَا كَانَ مِنَ الْقُرُونِ مِنْ قَبْلِكُمْ أُولُو بَقِيَّةٍ يَنْهَوْنَ عَنِ الْفَسَادِ فِي الْأَرْضِ إِلَّا قَلِيلًا مِمَّنْ أَنْجَيْنَا مِنْهُمْ وَاتَّبَعَ الَّذِينَ ظَلَمُوا مَا أُتْرِفُوا فِيهِ وَكَانُوا مُجْرِمِينَ (116)","hl":[[0,150,1]]}},{"id":"ق-0783","fp":"5da0cf6db401","stateId":30,"easy":"الإيمان مع الرسل ← صدق الوعد والنجاة","cause":"الإيمان مع الرسل","result":"صدق الوعد والنجاة","explicit":true,"ref":"سورة الأنبياء: 9","srcLabel":"القرآن الكريم","quran":{"s":21,"from":9,"to":9,"text":"ثُمَّ صَدَقْنَاهُمُ الْوَعْدَ فَأَنْجَيْنَاهُمْ وَمَنْ نَشَاءُ وَأَهْلَكْنَا الْمُسْرِفِينَ (9)","hl":[[0,62,1]]}},{"id":"ق-0790","fp":"717340623a28","stateId":30,"easy":"الثبات على التوحيد أمام كيد القوم ← النجاة من النار وجعل الكائدين الأخسرين","cause":"الثبات على التوحيد أمام كيد القوم","result":"النجاة من النار وجعل الكائدين الأخسرين","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[31],"ref":"سورة الأنبياء: 68–70","srcLabel":"القرآن الكريم","quran":{"s":21,"from":68,"to":70,"text":"قَالُوا حَرِّقُوهُ وَانْصُرُوا آلِهَتَكُمْ إِنْ كُنْتُمْ فَاعِلِينَ (68) قُلْنَا يَا نَارُ كُونِي بَرْدًا وَسَلَامًا عَلَى إِبْرَاهِيمَ (69) وَأَرَادُوا بِهِ كَيْدًا فَجَعَلْنَاهُمُ الْأَخْسَرِينَ (70)","hl":[[0,196,1]]}},{"id":"ق-0792","fp":"702d09ed4b3e","stateId":30,"easy":"الصلاح ← النجاة من قرية السوء والدخول في رحمة الله","cause":"الصلاح","result":"النجاة من قرية السوء والدخول في رحمة الله","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[24],"ref":"سورة الأنبياء: 74–75","srcLabel":"القرآن الكريم","quran":{"s":21,"from":74,"to":75,"text":"وَلُوطًا آتَيْنَاهُ حُكْمًا وَعِلْمًا وَنَجَّيْنَاهُ مِنَ الْقَرْيَةِ الَّتِي كَانَتْ تَعْمَلُ الْخَبَائِثَ إِنَّهُمْ كَانُوا قَوْمَ سَوْءٍ فَاسِقِينَ (74) وَأَدْخَلْنَاهُ فِي رَحْمَتِنَا إِنَّهُ مِنَ الصَّالِحِينَ (75)","hl":[[38,214,1]]}},{"id":"ق-0904","fp":"6ee40e752ed9","stateId":30,"easy":"الإيمان والتقوى ← النجاة","cause":"الإيمان والتقوى","result":"النجاة","explicit":true,"similar":["ق-1131"],"ref":"سورة النمل: 53","srcLabel":"القرآن الكريم","quran":{"s":27,"from":53,"to":53,"text":"وَأَنْجَيْنَا الَّذِينَ آمَنُوا وَكَانُوا يَتَّقُونَ (53)","hl":[[0,52,1]]}},{"id":"ق-0939","fp":"73fca9f2454f","stateId":30,"easy":"الإيمان مع نوح ← النجاة في السفينة","cause":"الإيمان مع نوح","result":"النجاة في السفينة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0407","ref":"سورة العنكبوت: 15","quran":{"s":29,"from":15,"to":15,"text":"فَأَنْجَيْنَاهُ وَأَصْحَابَ السَّفِينَةِ وَجَعَلْنَاهَا آيَةً لِلْعَالَمِينَ (15)","hl":[[0,40,1]]}},{"id":"ق-1046","fp":"9ab24a76eeda","stateId":30,"easy":"الإخلاص لله ← النجاة من عاقبة المنذَرين","cause":"الإخلاص لله","result":"النجاة من عاقبة المنذَرين","explicit":true,"ref":"سورة الصافات: 74","srcLabel":"القرآن الكريم","quran":{"s":37,"from":74,"to":74,"text":"إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ (74)","hl":[[0,37,1]]}},{"id":"ق-1050","fp":"8ab7df133430","stateId":30,"easy":"التسليم لأمر الله في البلاء المبين (الإحسان) ← الفداء والثناء في الآخرين والسلام","cause":"التسليم لأمر الله في البلاء المبين (الإحسان)","result":"الفداء والثناء في الآخرين والسلام","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[45,41],"ref":"سورة الصافات: 103–111","srcLabel":"القرآن الكريم","quran":{"s":37,"from":103,"to":111,"text":"فَلَمَّا أَسْلَمَا وَتَلَّهُ لِلْجَبِينِ (103) وَنَادَيْنَاهُ أَنْ يَا إِبْرَاهِيمُ (104) قَدْ صَدَّقْتَ الرُّؤْيَا إِنَّا كَذَلِكَ نَجْزِي الْمُحْسِنِينَ (105) إِنَّ هَذَا لَهُوَ الْبَلَاءُ الْمُبِينُ (106) وَفَدَيْنَاهُ بِذِبْحٍ عَظِيمٍ (107) وَتَرَكْنَا عَلَيْهِ فِي الْآخِرِينَ (108) سَلَامٌ عَلَى إِبْرَاهِيمَ (109) كَذَلِكَ نَجْزِي الْمُحْسِنِينَ (110) إِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِنِينَ (111)","hl":[[0,397,1]]}},{"id":"ق-1051","fp":"b64b142f3c90","stateId":30,"easy":"الإحسان والإيمان ← النجاة من الكرب العظيم والنصر والغلبة والهداية والثناء","cause":"الإحسان والإيمان","result":"النجاة من الكرب العظيم والنصر والغلبة والهداية والثناء","explicit":true,"otherNeedIds":[25,43],"ref":"سورة الصافات: 114–122","srcLabel":"القرآن الكريم","quran":{"s":37,"from":114,"to":122,"text":"وَلَقَدْ مَنَنَّا عَلَى مُوسَى وَهَارُونَ (114) وَنَجَّيْنَاهُمَا وَقَوْمَهُمَا مِنَ الْكَرْبِ الْعَظِيمِ (115) وَنَصَرْنَاهُمْ فَكَانُوا هُمُ الْغَالِبِينَ (116) وَآتَيْنَاهُمَا الْكِتَابَ الْمُسْتَبِينَ (117) وَهَدَيْنَاهُمَا الصِّرَاطَ الْمُسْتَقِيمَ (118) وَتَرَكْنَا عَلَيْهِمَا فِي الْآخِرِينَ (119) سَلَامٌ عَلَى مُوسَى وَهَارُونَ (120) إِنَّا كَذَلِكَ نَجْزِي الْمُحْسِنِينَ (121) إِنَّهُمَا مِنْ عِبَادِنَا الْمُؤْمِنِينَ (122)","hl":[[0,430,1]]}},{"id":"ق-1053","fp":"b9a4205326b1","stateId":30,"easy":"الإيمان مع لوط ← النجاة وتدمير الآخرين","cause":"الإيمان مع لوط","result":"النجاة وتدمير الآخرين","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[61],"ref":"سورة الصافات: 133–136","srcLabel":"القرآن الكريم","quran":{"s":37,"from":133,"to":136,"text":"وَإِنَّ لُوطًا لَمِنَ الْمُرْسَلِينَ (133) إِذْ نَجَّيْنَاهُ وَأَهْلَهُ أَجْمَعِينَ (134) إِلَّا عَجُوزًا فِي الْغَابِرِينَ (135) ثُمَّ دَمَّرْنَا الْآخَرِينَ (136)","hl":[[0,158,1]]}},{"id":"ق-1131","fp":"be9f67c3e03e","stateId":30,"easy":"الإيمان والتقوى ← النجاة","cause":"الإيمان والتقوى","result":"النجاة","explicit":true,"repOf":"ق-0904","ref":"سورة فصلت: 18","quran":{"s":41,"from":18,"to":18,"text":"وَنَجَّيْنَا الَّذِينَ آمَنُوا وَكَانُوا يَتَّقُونَ (18)","hl":[[0,51,1]]}},{"id":"ق-1178","fp":"acf9961219cf","stateId":30,"easy":"الإيمان والصبر على الاستضعاف ← النجاة من العذاب المهين","cause":"الإيمان والصبر على الاستضعاف","result":"النجاة من العذاب المهين","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الدخان: 30–31","srcLabel":"القرآن الكريم","quran":{"s":44,"from":30,"to":31,"text":"وَلَقَدْ نَجَّيْنَا بَنِي إِسْرَائِيلَ مِنَ الْعَذَابِ الْمُهِينِ (30) مِنْ فِرْعَوْنَ إِنَّهُ كَانَ عَالِيًا مِنَ الْمُسْرِفِينَ (31)","hl":[[0,129,1]]}},{"id":"ق-1260","fp":"52ac9b6b4db8","stateId":30,"easy":"الإيمان ← النجاة من قرية العذاب","cause":"الإيمان","result":"النجاة من قرية العذاب","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0585","ref":"سورة الذاريات: 35","quran":{"s":51,"from":35,"to":35,"text":"فَأَخْرَجْنَا مَنْ كَانَ فِيهَا مِنَ الْمُؤْمِنِينَ (35)","hl":[[0,51,1]]}},{"id":"ق-1282","fp":"762f835668e9","stateId":30,"easy":"الشكر ← النجاة (نعمة من الله)","cause":"الشكر","result":"النجاة (نعمة من الله)","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة القمر: 34–35","srcLabel":"القرآن الكريم","quran":{"s":54,"from":34,"to":35,"text":"إِنَّا أَرْسَلْنَا عَلَيْهِمْ حَاصِبًا إِلَّا آلَ لُوطٍ نَجَّيْنَاهُمْ بِسَحَرٍ (34) نِعْمَةً مِنْ عِنْدِنَا كَذَلِكَ نَجْزِي مَنْ شَكَرَ (35)","hl":[[39,137,1]]}},{"id":"س-00775","fp":"e90a1839b104","stateId":31,"easy":"إذا جعلت دعاءك كله صلاة على النبي ﷺ ← تُكفى همّك ويُغفر ذنبك","cause":"أَجعَلُ لك صَلاتي كلَّها","result":"إذًا تُكْفى هَمَّك، ويُغفَرُ ذَنْبُك","explicit":true,"star":true,"otherNeedIds":[11],"ref":"الأحاديث المختارة 1185","srcLabel":"البخاري","text":["«كانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ إذا ذَهَبَ رُبُعُ اللَّيلِ قامَ فقالَ: أيُّها النَّاسُ اذْكُروا اللهَ، اذْكُروا اللهَ، جاءَتِ الرَّاجِفةُ تَتْبَعُها الرَّادِفةُ، جاءَ المَوْتُ بما فيه، جاءَ المَوْتُ بما فيه، جاءَ المَوْتُ بما فيه، قالَ أُبَيٌّ: قُلْتُ: يا رَسولَ اللهِ، إنِّي أُكثِرُ الصَّلاةَ عليك، فكم أَجعَلُ لك مِن صَلاتي؟ قالَ: ما شِئْتَ، قالَ: الرُّبُعَ؟ قالَ: ما شِئْتَ، وإن زِدْتَ فهو خَيْرٌ، قالَ: النِّصْفَ؟ قالَ: ما شِئْتَ، وإن زِدْتَ فهو خَيْرٌ، قالَ: الثُّلُثَينِ؟ قالَ: ما شِئْتَ، وإن زِدْتَ فهو خَيْرٌ، قالَ: ",["أَجعَلُ لك صَلاتي كلَّها",1],"؟ قالَ: ",["إذًا تُكْفى هَمَّك، ويُغفَرُ ذَنْبُك",2],"»."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"6yrcpvt2","merged":4,"otherRefs":["سنن الترمذي 2457 (صحيح)","فتح الباري لابن حجر 11/172 (حسن)","بذل الماعون 207 (حسن)"]},{"id":"س-07769","fp":"517dc4d4e25f","stateId":31,"easy":"إذا جاهدت في سبيل الله ← يذهب الله به عنك الهم والغم","cause":"وعليكم بالجِهادِ","result":"فإنَّه بابٌ مِن أبْوابِ الجنَّةِ، يُذهِبُ اللهُ به الغَمَّ والهَمَّ","explicit":true,"star":true,"similar":["س-04472"],"otherNeedIds":[67],"ref":"الأحاديث المختارة 8 / 296","srcLabel":"متفق عليه","text":["«خَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ إلى بَدْرٍ فلَقيَ بها العَدُوَّ، فلمَّا هَزَمَهم اللهُ اتَّبَعَتْهم طائِفةٌ مِن المُسلِمينَ يَقتُلونَهم، وأَحْدَقَتْ طائِفةٌ برَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ واسْتَوْلَتْ طائِفةٌ على النَّهْبِ والعَسْكَرِ، فلمَّا رَجَعَ الَّذين طَلَبوا العَدُوَّ قالوا: لنا النَّفَلُ نحن طَلَبْنا العَدُوَّ وبنا نَفاهم اللهُ وهَزَمَهم اللهُ، وقالَ الَّذين أَحْدَقوا برَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ: ما أنتم بأَحَقَّ بِه مِنَّا بلْ هو لنا؛ نحن أَحْدَقْنا برَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أن يَنالَه مِن العَدُوِّ غِرَّةٌ، وقالَ الَّذين اسْتَوْلَوا على العَسكَرِ والنَّهْبِ: ما أنتم بأَحَقَّ به مِنَّا بلْ هو لنا؛ نحن اسْتَوْلَيْنا عليه وأَحْرَزْناه، فأَنزَلَ اللهُ على رَسولِه: {يَسْأَلُونَكَ عَنِ الْأَنْفَالِ قُلِ الْأَنْفَالُ لِلَّهِ وَالرَّسُولِ فَاتَّقُوا اللَّهَ وَأَصْلِحُوا ذَاتَ بَيْنِكُمْ}، الآيةُ، وقَسَمَها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ عن فُواقٍ.\nوكانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يُنَفِّلُهم بادينَ الرُّبُعَ، وإذا قَفَلوا الثُّلُثَ.\nوأخَذَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ وَبَرةً مِن ظَهْرِ بَعيرِه فقالَ: ما يَحِلُّ لي مِن الفَيءِ قَدْرُ هذه الوَبَرةِ إلَّا الخُمُسُ) والخُمُسُ مَرْدودٌ عليكم، فأدُّوا الخَيْطَ والمِخْيَطَ، وإيَّاكم والغُلولَ؛ فإنَّه عارٌ على أهْلِه يَوْمَ القِيامةِ، ",["وعليكم بالجِهادِ",1],"؛ ",["فإنَّه بابٌ مِن أبْوابِ الجنَّةِ، يُذهِبُ اللهُ به الغَمَّ والهَمَّ",2],").\nوكانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يَكرَهُ النَّفَلَ ويقولُ: (يَرُدُّ قَوِيُّ القَوْمِ على ضَعيفِهم)»."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"قرآن › أسباب النزول","dorar":"1E8yTKKC","merged":4,"otherRefs":["المستدرك على الصحيحين 2439 (صحيح)","الأحاديث المختارة 8 / 294 (صحيح)","تخريج زاد المعاد 4/183 (صحيح)"]},{"id":"س-07230","fp":"bddec7f01e8b","stateId":31,"easy":"إذا جعلت صلاتك (دعاءك) كله على النبي ﷺ ← يكفيك الله همّ دنياك وآخرتك","cause":"جَعَلْتُ صَلاتي كلَّها عليك","result":"إذًا يَكْفيك اللهُ تَبارَكَ وتَعالى ما هَمَّك مِن دُنْياك وآخِرتِك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-02041"],"otherNeedIds":[11],"ref":"الأحاديث المختارة 1187","srcLabel":"البخاري","text":["«قالَ رَجُلٌ: يا رَسولَ اللهِ، أَرَأيْتَ إن ",["جَعَلْتُ صَلاتي كلَّها عليك",1],"؟ قالَ: ",["إذًا يَكْفيك اللهُ تَبارَكَ وتَعالى ما هَمَّك مِن دُنْياك وآخِرتِك",2],"»."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"علم › حسن السؤال ونصح العالم","dorar":"IztPmoYB"},{"id":"س-04472","fp":"3d9d8b01e29b","stateId":31,"easy":"إذا جاهدت في سبيل الله ← ينجّيك الله به من الهم والغم","cause":"و جَاهِدُوا في سبيلِ اللهِ","result":"فإنَّ الجِهادَ بابٌ من أبوابِ الجنةِ عَظِيمةٌ ، يُنَجِّي اللهُ تباركَ وتعالى بهِ مِنَ الهَمِّ و الغَمِّ","explicit":true,"repOf":"س-07769","otherNeedIds":[67],"ref":"السلسلة الصحيحة 1972","text":["وجَاهِدُوا الناسَ في اللهِ تباركَ وتعالى القَرِيبَ البَعِيدَ ، و لا تُبالوا في اللهِ لَوْمَةَ لائِمٍ ، و أَقِيمُوا حُدُودَ اللهِ في الحَضَرِ و السفرِ ، ",["و جَاهِدُوا في سبيلِ اللهِ",1]," ، ",["فإنَّ الجِهادَ بابٌ من أبوابِ الجنةِ عَظِيمةٌ ، يُنَجِّي اللهُ تباركَ وتعالى بهِ مِنَ الهَمِّ و الغَمِّ",2]],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرجه ابن ماجه (2540)، والبيهقي (18270) كلاهما مختصرا، وأحمد (22699) مطولا،","bab":"جهاد › فضل الجهاد","dorar":"aMJOvWrR","merged":3,"otherRefs":["مشارع الأشواق 179 (حسن)","صحيح الترغيب 1319 (صحيح)"]},{"id":"س-06817","fp":"aac5b6428631","stateId":31,"easy":"إذا أصابك همّ أو حزن فدعوت «اللهم إني عبدك ابن عبدك...» ← يذهب الله همّك ويبدله فرحاً","cause":"فقال : اللَّهمَّ إنِّي عَبدُك ، وابنُ عبدِك ، وابنُ أمتِك ، ناصِيَتي بيدِكَ ، ماضٍ فيَّ حكمُكَ ، عدْلٌ فيَّ قضاؤكَ ، أسألُكَ بكلِّ اسمٍ هوَ لكَ سمَّيتَ بهِ نفسَك ، أو أنزلْتَه في كتابِكَ ، أو علَّمتَه أحدًا من خلقِك ، أو استأثرتَ بهِ في علمِ الغيبِ عندَك ، أن تجعلَ القُرآنَ ربيعَ قلبي ، ونورَ صَدري ، وجَلاءَ حَزَني ، وذَهابَ هَمِّي","result":"إلَّا أذهبَ اللهُ عزَّ وجلَّ همَّهُ ، وأبدلَه مكانَ حَزنِه فرحًا","explicit":true,"apply":{"k":"say","t":"«اللهم إني عبدك ابن عبدك...» · الوقت: عند الكرب والهم"},"ref":"صحيح الترغيب 1822","srcLabel":"أحمد","text":["ما أصابَ أحدًا قطُّ همٌّ ولا حَزنٌ ",["فقال : ( اللَّهمَّ إنِّي عَبدُك ، وابنُ عبدِك ، وابنُ أمتِك ، ناصِيَتي بيدِكَ ، ماضٍ فيَّ حكمُكَ ، عدْلٌ فيَّ قضاؤكَ ، أسألُكَ بكلِّ اسمٍ هوَ لكَ سمَّيتَ بهِ نفسَك ، أو أنزلْتَه في كتابِكَ ، أو علَّمتَه أحدًا من خلقِك ، أو استأثرتَ بهِ في علمِ الغيبِ عندَك ، أن تجعلَ القُرآنَ ربيعَ قلبي ، ونورَ صَدري ، وجَلاءَ حَزَني ، وذَهابَ هَمِّي",1]," ) . ",["إلَّا أذهبَ اللهُ عزَّ وجلَّ همَّهُ ، وأبدلَه مكانَ حَزنِه فرحًا",2]," . قالوا : يا رسولَ اللهِ ! يَنبغي لنا أَن نتعلَّمَ هؤلاءِ الكلماتِ ؟ قال : أجَلْ ! ينبغي لمَن سمِعَهنَّ أن يتَعلمَهنَّ ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه أحمد (3712)، وابن حبان (972)، والطبراني (10/210) (10352) باختلاف يسير.","bab":"عقيدة › إثبات أسماء الله","dorar":"ZumVhevx","merged":2,"otherRefs":["تخريج صحيح ابن حبان 972 (صحيح)"]},{"id":"س-00944","fp":"65c04967eb92","stateId":31,"easy":"إذا أصابك غمّ أو كرب فقل «الله الله ربي لا أشرك به شيئاً» ← (دعاء الكرب) يُكشف به ما بك","cause":"فلْيقُلِ : اللهُ اللهُ ربِّي لا أُشرِكُ به شيئًا","result":"إذا أصاب أحَدَكم غَمٌّ أو كَرْبٌ","explicit":true,"apply":{"k":"say","t":"«الله الله ربي لا أشرك به شيئاً»"},"ref":"صحيح ابن حبان 864","srcLabel":"الطبراني","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم جمَع أهلَ بيتِه فقال : ( ",["إذا أصاب أحَدَكم غَمٌّ أو كَرْبٌ",2]," ",["فلْيقُلِ : اللهُ اللهُ ربِّي لا أُشرِكُ به شيئًا",1]," )"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الطبراني (5290) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"w9y13BMS"},{"id":"س-05355","fp":"6aad0698b64b","stateId":31,"easy":"إذا قلت صباحاً ومساءً «حسبي الله لا إله إلا هو...» ← يكفيك الله ما أهمّك من الدنيا والآخرة","cause":"مَن قال في كلِّ يومٍ حينَ يُصبِحُ وحينَ يُمْسي: حَسبيَ اللهُ لا إلهَ إلَّا هو، عليه تَوكَّلْتُ، وهو ربُّ العَرشِ العَظيمِ، سَبعَ مراتٍ","result":"كَفاه اللهُ ما أهَمَّه من أمرِ الدُّنيا والآخِرةِ","explicit":true,"apply":{"k":"say","t":"«حَسبيَ اللهُ لا إلهَ إلَّا هو، عليه تَوكَّلْتُ، وهو ربُّ العَرشِ العَظيمِ» · الوقت: صباحاً ومساءً"},"otherNeedIds":[25],"ref":"تخريج زاد المعاد 2/342","srcLabel":"ابن السني","text":[["مَن قال في كلِّ يومٍ حينَ يُصبِحُ وحينَ يُمْسي: حَسبيَ اللهُ لا إلهَ إلَّا هو، عليه تَوكَّلْتُ، وهو ربُّ العَرشِ العَظيمِ، سَبعَ مراتٍ، ",1],["كَفاه اللهُ ما أهَمَّه من أمرِ الدُّنيا والآخِرةِ",2],"."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن السني في ((عمل اليوم والليلة)) (71) باختلاف يسير.","bab":"رقائق وزهد › التوكل واليقين","dorar":"Ftqgc7p2"},{"id":"س-05582","fp":"c8994d924c13","stateId":31,"easy":"إذا جعلت همّك همّ الآخرة وحده ← يكفيك الله همّ دنياك","cause":"من جعل الهمومَ همًّا واحدًا همَّ المعادِ","result":"كفاه اللهُ همَّ دنياه","explicit":true,"otherNeedIds":[25],"ref":"الترغيب والترهيب 4/131","srcLabel":"ابن ماجه","text":[["من جعل الهمومَ همًّا واحدًا همَّ المعادِ ",1],["كفاه اللهُ همَّ دنياه ، ",2],"ومن تشعَّبتْ به الهمومُ أحوالَ الدُّنيا لم يُبالِ اللهُ عزَّ وجلَّ في أيِّ أوديَتِه هلَك"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن ماجه (257)، والبزار (1638)، والعقيلي في ((الضعفاء الكبير)) (4/309) باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"uNKVQMOt"},{"id":"س-05598","fp":"3a8542fe6e6d","stateId":31,"easy":"إذا جعلت همومك همّاً واحداً (الآخرة) ← يكفيك الله ما أهمّك من الدنيا والآخرة","cause":"مَن جعَلَ الهُمومَ هَمًّا واحدًا","result":"كَفاهُ اللهُ ما هَمَّهُ مِن أمْرِ الدُّنيا والآخرةِ","explicit":true,"otherNeedIds":[25],"ref":"المستدرك على الصحيحين 8147","srcLabel":"البيهقي","text":[["مَن جعَلَ الهُمومَ هَمًّا واحدًا، ",1],["كَفاهُ اللهُ ما هَمَّهُ مِن أمْرِ الدُّنيا والآخرةِ، ",2],"ومَن تَشاعَبَتْ به الهُمومُ، لم يُبالِ اللهُ في أيِّ أوديةِ الدُّنيا هَلَكَ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (9857) بلفظه، وابن أبي عاصم في ((الزهد)) (166) بلفظ مقارب.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"12DQQ4Fm"},{"id":"س-07102","fp":"d78f7beecc2f","stateId":31,"easy":"إذا دعوت بتلك الكلمات راجياً ما فيها ← يذهب الله حزنك ويطيل فرحك","cause":"من قالها التماسَ ما فيهن","result":"أذهبَ اللهُ عزَّ وجلَّ حُزنَه وأطال فرحَه","explicit":true,"ref":"السلسلة الصحيحة 1/386","srcLabel":"ابن السني","text":["فقولوهن وعلِّموهنَّ فإنَّ ",["من قالها التماسَ ما فيهن",1]," ",["أذهبَ اللهُ عزَّ وجلَّ حُزنَه وأطال فرحَه",2]," [ في حديث اللهمَّ إني عبدُك وابنُ عبدِك . . . ]"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح إلى فياض وشيخه عبد الله بن زبيد مستور ومثله يستشهد بحديثه إن شاء الله تعالى","takhrij":"أخرجه ابن السني في ((عمل اليوم والليلة)) (339) واللفظ له.","bab":"علم › تعليم الناس وفضل ذلك","dorar":"xp0AcRx4"},{"id":"س-03109","fp":"1f5a415c9dba","stateId":31,"easy":"إذا نزل بك هم أو غم فقل «يا حي يا قيوم برحمتك أستغيث» ← (ذكر نبوي، والفرج مرجوّ)","cause":"يا حيُّ يا قيُّومُ برحمتِك أستغيثُ","result":"إذا نزلَ بِه همٌّ أو غمٌّ","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"apply":{"k":"say","t":"«يا حي يا قيوم برحمتك أستغيث»"},"ref":"الجامع الصغير 6791","srcLabel":"الحاكم","text":["كانَ ",["إذا نزلَ بِه همٌّ أو غمٌّ",2]," قالَ ",["يا حيُّ يا قيُّومُ برحمتِك أستغيثُ",1]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي الدنيا في ((الفرج بعد الشدة)) (47)، والحاكم (1875)، واللفظ لهما، والبيهقي في ((شعب الإيمان)) (10231)، باختلاف يسير.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"6l9IW4KZ","merged":2,"otherRefs":["صحيح الجامع 4777 (صحيح)"]},{"id":"س-00660","fp":"614ad297d211","stateId":31,"easy":"إذا استعذت صباحاً ومساءً من الهم والحزن والعجز والكسل والبخل والدَّين ← يذهب الله همّك ويقضي دَينك","cause":"قل إذا أصبحتَ وإذا أمسيتَ اللَّهمَّ إنِّي أعوذُ بِك منَ الهمِّ والحزنِ وأعوذُ بِك منَ العجزِ والكسلِ وأعوذُ بِك منَ الجبنِ والبخلِ وأعوذُ بِك من غلبةِ الدَّينِ وقَهرِ الرِّجالِ","result":"فأذهبَ اللَّهُ همِّي وقضى عنِّي دَيني","explicit":true,"apply":{"k":"time","t":"صباحاً ومساءً"},"otherNeedIds":[2],"ref":"هداية الرواة 3/15","srcLabel":"أبو داود","text":["قالَ رجلٌ همومٌ لزِمتني وديونٌ يا رسولَ اللَّهِ قالَ أفلا أعلِّمُك كلامًا إذا قلتَه أذهبَ اللَّهُ همَّكَ وقضى عنكَ دَينَك قالَ قلتُ بلى قالَ ",["قل إذا أصبحتَ وإذا أمسيتَ اللَّهمَّ إنِّي أعوذُ بِك منَ الهمِّ والحزنِ وأعوذُ بِك منَ العجزِ والكسلِ وأعوذُ بِك منَ الجبنِ والبخلِ وأعوذُ بِك من غلبةِ الدَّينِ وقَهرِ الرِّجالِ",1]," قالَ ففعلتُ ذلِك ",["فأذهبَ اللَّهُ همِّي وقضى عنِّي دَيني",2]],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه أبو داود (1555)، والبيهقي في ((الدعوات الكبير)) (305) واللفظ لهما.","bab":"أدعية وأذكار › أذكار الصباح","dorar":"Ekeldkx6"},{"id":"س-00876","fp":"c0e4a37a1876","stateId":31,"easy":"إذا أصابك همّ أو غمّ أو مرض أو شدة فقلت «الله ربي لا شريك له» ← يكشف الله ذلك عنك","cause":"مَنْ أصابَهُ هَمٌّ أوْ غَمٌّ ، أوْ سُقْمٌ ، أَوْ شِدَّةٌ ، فقالَ : اللهُ رَبِّي ، لَا شريكَ لَهُ","result":"كَشَفَ ذلِكَ عَنْهُ","explicit":true,"apply":{"k":"say","t":"«الله ربي لا شريك له» · الوقت: عند الكرب والهم"},"otherNeedIds":[35],"ref":"صحيح الجامع 6040","srcLabel":"أحمد","text":[["مَنْ أصابَهُ هَمٌّ أوْ غَمٌّ ، أوْ سُقْمٌ ، أَوْ شِدَّةٌ ، فقالَ : اللهُ رَبِّي ، لَا شريكَ لَهُ",1]," ، ",["كَشَفَ ذلِكَ عَنْهُ",2]],"grade":"حسن","narrator":"أسماء بنت عميس","muhaddith":"حسن","takhrij":"أخرجه أحمد (27082) باختلاف يسير مختصراً، وابن أبي الدنيا في ((الفرج)) (48) باختلاف يسير، والطبراني (24/154) (396) واللفظ له.","bab":"أدعية وأذكار › فضل الذكر","dorar":"PoLhXVjF"},{"id":"س-02041","fp":"7fb364fe77de","stateId":31,"easy":"إذا جعلت دعاءك كله صلاة على النبي ﷺ ← يكفيك الله ما أهمك من دنياك وآخرتك","cause":"صلاتي كلَّها","result":"إذًا يَكفِيَكَ اللَّهُ ما أَهَمَّكَ من أمرِ دنياكَ وآخرتِكَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-07230","otherNeedIds":[25],"ref":"تحفة الذاكرين 56","text":["أنَّ رجُلًا قالَ : يا رسولَ اللَّهِ أجعَلُ ثُلُثَ صلاتي عليكَ ؟ قالَ : نعَم إن شئتَ قالَ : الثُّلُثينِ قالَ : نعَم إِن شئتَ . قالَ ",["صلاتي كلَّها",1]," ؟ قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : ",["إذًا يَكفِيَكَ اللَّهُ ما أَهَمَّكَ من أمرِ دنياكَ وآخرتِكَ",2]," ."],"grade":"حسن","narrator":"حبان بن منقذ بن عمرو الأنصاري","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (4/ 35) (3574)، وأبو نعيم في ((معرفة الصحابة)) (2292) واللفظ لهما، وابن أبي عاصم في ((الآحاد والمثاني)) (2122) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"w7jxnx8z"},{"id":"س-06017","fp":"e0f198c401a0","stateId":32,"easy":"إذا اشتد الكرب ← فالفرج معه","cause":"معَ الكَرْبِ","result":"وأنَّ الفَرَجَ","explicit":true,"star":true,"ref":"الأحاديث المختارة 10 / 24","srcLabel":"متفق عليه","text":["«كُنْتُ رَديفَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: يا غُلامُ، أو يا بُنَيَّ، أَلَا أُعَلِّمُك كَلِماتٍ يَنفَعُك اللهُ بِهنَّ؟ فقُلْتُ: بَلى، فقالَ: احْفَظِ اللهَ يَحفَظْك، احْفَظِ اللهَ تَجِدْه أمامَك، تَعرَّفْ إليه في الرَّخاءِ يَعرِفْك في الشِّدَّةِ، إذا سَألْتَ فاسْأَلِ اللهَ، وإذا اسْتَعَنْتَ فاسْتَعِنْ باللهِ، قد جَفَّ القَلَمُ بما هو كائِنٌ، فلو أنَّ الخَلْقَ كلَّهم جَميعًا أرادوا أن يَنفَعوك بشيءٍ لم يَقْضِه اللهُ لك لم يَقدِروا عليه، وإن أرادوا أن يَضُرُّوك بشيءٍ لم يَقْضِه اللهُ عليك لم يَقدِروا عليه، اعْمَلْ للهِ بالشُّكْرِ واليَقينِ، واعْلَمْ أنَّ الصَّبْرَ على ما تَكرَهُ خَيْرٌ كَثيرٌ، وأنَّ النَّصْرَ معَ الصَّبْرِ، ",["وأنَّ الفَرَجَ",2]," ",["معَ الكَرْبِ",1],"، وأنَّ معَ العُسْرِ يُسْرًا»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › تقوى الله","dorar":"Zz7qGbDv","merged":2,"otherRefs":["تخريج رياض الصالحين 62 (صحيح)"]},{"id":"س-06018","fp":"23c7fdc41162","stateId":32,"easy":"إذا جاء العسر ← فإن معه يسراً","cause":"معَ العُسْرِ","result":"يُسْرًا","explicit":true,"star":true,"otherNeedIds":[54],"ref":"الأحاديث المختارة 10 / 24","srcLabel":"متفق عليه","text":["«كُنْتُ رَديفَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: يا غُلامُ، أو يا بُنَيَّ، أَلَا أُعَلِّمُك كَلِماتٍ يَنفَعُك اللهُ بِهنَّ؟ فقُلْتُ: بَلى، فقالَ: احْفَظِ اللهَ يَحفَظْك، احْفَظِ اللهَ تَجِدْه أمامَك، تَعرَّفْ إليه في الرَّخاءِ يَعرِفْك في الشِّدَّةِ، إذا سَألْتَ فاسْأَلِ اللهَ، وإذا اسْتَعَنْتَ فاسْتَعِنْ باللهِ، قد جَفَّ القَلَمُ بما هو كائِنٌ، فلو أنَّ الخَلْقَ كلَّهم جَميعًا أرادوا أن يَنفَعوك بشيءٍ لم يَقْضِه اللهُ لك لم يَقدِروا عليه، وإن أرادوا أن يَضُرُّوك بشيءٍ لم يَقْضِه اللهُ عليك لم يَقدِروا عليه، اعْمَلْ للهِ بالشُّكْرِ واليَقينِ، واعْلَمْ أنَّ الصَّبْرَ على ما تَكرَهُ خَيْرٌ كَثيرٌ، وأنَّ النَّصْرَ معَ الصَّبْرِ، وأنَّ الفَرَجَ معَ الكَرْبِ، وأنَّ ",["معَ العُسْرِ",1]," ",["يُسْرًا",2],"»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › تقوى الله","dorar":"Zz7qGbDv","merged":2,"otherRefs":["تخريج رياض الصالحين 62 (صحيح)"]},{"id":"س-04356","fp":"479d386bac67","stateId":32,"easy":"إذا نزلت بك شدة ← يجعل الله لك بعدها فرجاً، ولن يغلب عسرٌ يسرين","cause":"ما يَنزِلُ بعبدٍ مؤمنٍ مِن منزِلةِ شِدَّةٍ","result":"إلَّا يَجعلُ اللهُ له بعدَها فَرَجًا، ولن يَغْلِبَ عُسْرٌ يُسرَيْنِ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 3218","srcLabel":"مسلم","text":["عنْ عُمَرَ بنِ الخَطَّابِ رَضيَ اللهُ عنه، أنَّه بَلَغَهُ أنَّ أبا عُبَيدةَ حُصِرَ بالشَّامِ وقد تألَّبَ عليه القومُ، فكَتَبَ إليه عُمَرُ: سلامٌ عليكَ، أمَّا بعدُ: فإنَّه ",["ما يَنزِلُ بعبدٍ مؤمنٍ مِن منزِلةِ شِدَّةٍ",1]," ",["إلَّا يَجعلُ اللهُ له بعدَها فَرَجًا، ولن يَغْلِبَ عُسْرٌ يُسرَيْنِ ",2],"و {يَا أَيُّهَا الَّذِينَ آمَنُوا اصْبِرُوا وَصَابِرُوا وَرَابِطُوا وَاتَّقُوا اللَّهَ لَعَلَّكُمْ تُفْلِحُونَ} [آل عمران: 200]. قالَ: فكَتَبَ إليه أبو عُبيدةَ: سلامٌ عليكَ، أمَّا بعدُ: فإنَّ اللهَ يقولُ في كتابِهِ: {اعْلَمُوا أَنَّمَا الْحَيَاةُ الدُّنْيَا لَعِبٌ وَلَهْوٌ وَزِينَةٌ وَتَفَاخُرٌ بَيْنَكُمْ وَتَكَاثُرٌ فِي الْأَمْوَالِ وَالْأَوْلَادِ} [الحديد: 20] إلى آخِرِها. قالَ: فخَرَجَ عُمَرُ بكتابِهِ، فقَعَدَ على المِنبرِ، فقَرَأَ على أهلِ المدينةِ، ثُمَّ قالَ: يا أهلَ المدينةِ، إنَّما يُعَرِّضُ بِكُم أبو عُبيدةَ أنِ ارغَبوا في الجهادِ."],"grade":"صحيح","narrator":"أسلم القرشى","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه مالك (1621)، وابن أبي شيبة (19834) بنحوه.","bab":"جهاد › الترغيب في الجهاد","dorar":"pOncW7sP","merged":2,"otherRefs":["تخريج سير أعلام النبلاء 1/15-16 (حسن)"]},{"id":"ق-0887","fp":"08bd6fb83ec6","stateId":32,"easy":"اليقين بمعية الله عند انسداد الطرق ← الهداية للمخرج والنجاة وإغراق العدو","cause":"اليقين بمعية الله عند انسداد الطرق","result":"الهداية للمخرج والنجاة وإغراق العدو","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"star":true,"otherNeedIds":[25,15],"ref":"سورة الشعراء: 61–67","srcLabel":"القرآن الكريم","quran":{"s":26,"from":61,"to":67,"text":"فَلَمَّا تَرَاءَى الْجَمْعَانِ قَالَ أَصْحَابُ مُوسَى إِنَّا لَمُدْرَكُونَ (61) قَالَ كَلَّا إِنَّ مَعِيَ رَبِّي سَيَهْدِينِ (62) فَأَوْحَيْنَا إِلَى مُوسَى أَنِ اضْرِبْ بِعَصَاكَ الْبَحْرَ فَانْفَلَقَ فَكَانَ كُلُّ فِرْقٍ كَالطَّوْدِ الْعَظِيمِ (63) وَأَزْلَفْنَا ثَمَّ الْآخَرِينَ (64) وَأَنْجَيْنَا مُوسَى وَمَنْ مَعَهُ أَجْمَعِينَ (65) ثُمَّ أَغْرَقْنَا الْآخَرِينَ (66) إِنَّ فِي ذَلِكَ لَآيَةً وَمَا كَانَ أَكْثَرُهُمْ مُؤْمِنِينَ (67)","hl":[[0,282,1]]}},{"id":"ق-1311","fp":"a1ac30020808","stateId":32,"easy":"التفسّح في المجالس ← يفسح الله لكم","cause":"التفسّح في المجالس","result":"يفسح الله لكم","explicit":true,"otherNeedIds":[1],"ref":"سورة المجادلة: 11","srcLabel":"القرآن الكريم","quran":{"s":58,"from":11,"to":11,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا قِيلَ لَكُمْ تَفَسَّحُوا فِي الْمَجَالِسِ فَافْسَحُوا يَفْسَحِ اللَّهُ لَكُمْ وَإِذَا قِيلَ انْشُزُوا فَانْشُزُوا يَرْفَعِ اللَّهُ الَّذِينَ آمَنُوا مِنْكُمْ وَالَّذِينَ أُوتُوا الْعِلْمَ دَرَجَاتٍ وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ (11)","hl":[[31,114,1]]}},{"id":"ق-1350","fp":"c561cacbc7ea","stateId":32,"easy":"تقوى الله ← المخرج من كل ضيق والرزق من حيث لا يحتسب","cause":"تقوى الله","result":"المخرج من كل ضيق والرزق من حيث لا يحتسب","explicit":true,"otherNeedIds":[1],"ref":"سورة الطلاق: 2–3","srcLabel":"القرآن الكريم","quran":{"s":65,"from":2,"to":3,"text":"فَإِذَا بَلَغْنَ أَجَلَهُنَّ فَأَمْسِكُوهُنَّ بِمَعْرُوفٍ أَوْ فَارِقُوهُنَّ بِمَعْرُوفٍ وَأَشْهِدُوا ذَوَيْ عَدْلٍ مِنْكُمْ وَأَقِيمُوا الشَّهَادَةَ لِلَّهِ ذَلِكُمْ يُوعَظُ بِهِ مَنْ كَانَ يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مَخْرَجًا (2) وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ وَمَنْ يَتَوَكَّلْ عَلَى اللَّهِ فَهُوَ حَسْبُهُ إِنَّ اللَّهَ بَالِغُ أَمْرِهِ قَدْ جَعَلَ اللَّهُ لِكُلِّ شَيْءٍ قَدْرًا (3)","hl":[[231,321,1]]}},{"id":"ق-1445","fp":"1d840903dace","stateId":32,"easy":"الصبر على العسر ← يسر مع العسر","cause":"الصبر على العسر","result":"يسر مع العسر","explicit":true,"ref":"سورة الشرح: 5–6","srcLabel":"القرآن الكريم","quran":{"s":94,"from":5,"to":6,"text":"فَإِنَّ مَعَ الْعُسْرِ يُسْرًا (5) إِنَّ مَعَ الْعُسْرِ يُسْرًا (6)","hl":[[0,63,1]]}},{"id":"س-05559","fp":"88effac9e380","stateId":32,"easy":"إذا ذكرت الموت وأنت في ضيق ← يوسّعه الله عليك","cause":"فما ذكَره عبدٌ قطُّ وهو في ضيقٍ","result":"إلَّا وسَّعه عليه","explicit":true,"otherNeedIds":[5,19],"ref":"صحيح ابن حبان 2993","srcLabel":"الترمذي","text":["أكثِروا ذِكْرَ هاذمِ اللَّذَّاتِ ",["فما ذكَره عبدٌ قطُّ وهو في ضيقٍ",1]," ",["إلَّا وسَّعه عليه",2]," ولا ذكَره وهو في سَعةٍ إلَّا ضيَّقه عليه"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الترمذي (2307)، والنسائي (1824) مختصراً، والبيهقي في ((شعب الإيمان)) (10560) باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"vNSxSHQ3","merged":2,"otherRefs":["مجمع الزوائد 10/312 (حسن)"]},{"id":"س-05987","fp":"90dba064cf3d","stateId":32,"easy":"إذا عمل الناس بآية «ومن يتق الله يجعل له مخرجاً» ← لكفتهم","cause":"وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مَخْرَجًا * وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ [الطلاق: 2، 3] قال : فجعَل يُرَدِّدُها علَيَّ حتَّى نعَسْتُ فقال : يا أبا ذرٍّ لو أنَّ النَّاسَ كلَّهم أخَذوا بها","result":"لَكفَتْهم","explicit":true,"apply":{"k":"say","t":"«ومن يتق الله يجعل له مخرجاً»"},"otherNeedIds":[1,54],"ref":"صحيح ابن حبان 6669","srcLabel":"ابن ماجه","text":["جعَل رسولُ اللهِ صلَّى اللهُ عليه وسلَّم يتلو هذه الآيةَ {",["وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مَخْرَجًا * وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ} [الطلاق: 2، 3] قال : فجعَل يُرَدِّدُها علَيَّ حتَّى نعَسْتُ فقال : ( يا أبا ذرٍّ لو أنَّ النَّاسَ كلَّهم أخَذوا بها",1]," ",["لَكفَتْهم",2]," ) ثمَّ قال : ( يا أبا ذرٍّ كيف تصنَعُ إذا أُخرِجْتَ مِن المدينةِ ) ؟ قُلْتُ : إلى السَّعةِ والدَّعةِ أكونُ حَمَامًا مِن حَمَامِ مكَّةَ قال : ( كيف تصنَعُ إذا أُخرِجْتَ مِن مكَّةَ ) ؟ قُلْتُ : إلى السَّعةِ والدَّعةِ إلى أرضِ الشَّامِ والأرضِ المُقدَّسةِ قال : ( فكيف تصنَعُ إذا أُخرِجْتَ منها ) ؟ قُلْتُ : إذَنْ والَّذي بعَثك بالحقِّ آخُذَ سَيفي فأضَعَه على عاتقي فقال صلَّى اللهُ عليه وسلَّم : ( أوَخيرٌ مِن ذلك تسمَعُ وتُطيعُ لِعبدٍ حبَشيٍّ مُجدَّعٍ )"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن ماجه (4220) مختصراً، وأحمد (21551) باختلاف يسير","bab":"رقائق وزهد › تقوى الله","dorar":"n73gcl3e","merged":2,"otherRefs":["الآداب الشرعية 3/529 (حسن)"]},{"id":"س-00996","fp":"89af142c93e9","stateId":32,"easy":"إذا لزمت الاستغفار ← يجعل الله لك من كل ضيق مخرجاً ومن كل همّ فرجاً ويرزقك من حيث لا تحتسب","cause":"مَن لَزِمَ الاسْتِغْفارَ","result":"جَعَلَ اللهُ له مِن كلِّ ضيقٍ مَخرَجًا، ومِن كلِّ هَمٍّ فَرَجًا، ورَزَقَه مِن حيثُ لا يَحتَسِبُ","explicit":true,"otherNeedIds":[1],"ref":"الأحكام الوسطى 4/ 317","srcLabel":"الأحكام الوسطى","text":["\"",["مَن لَزِمَ الاسْتِغْفارَ ",1],["جَعَلَ اللهُ له مِن كلِّ ضيقٍ مَخرَجًا، ومِن كلِّ هَمٍّ فَرَجًا، ورَزَقَه مِن حيثُ لا يَحتَسِبُ\"",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","bab":"أدعية وأذكار › فضل الذكر","dorar":"cFqsHp7o"},{"id":"س-03903","fp":"ece5b8fd5275","stateId":32,"easy":"إذا اتقيت الله وصبرت ← يأتيك الفرج قريباً","cause":"اتَّقِ اللهَ واصبِرْ","result":"فلمْ يَلبثْ إلَّا يَسيرًا حتَّى جاءَ ابنٌ له بغنمٍ له كان العدُوُّ أصابوهُ","explicit":true,"otherNeedIds":[1],"ref":"المستدرك على الصحيحين 3866","srcLabel":"الحاكم","text":["قالَ: نَزَلَتْ هذه الآيةُ: {وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مَخْرَجًا (2) وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ} [الطلاق: 2، 3] في رَجلٍ مِن أشْجَعَ كان فقيرًا خفيفَ ذاتِ اليدِ كثيرَ العيالِ، فأَتى رسولَ الله صلَّى اللهُ عليه وسلَّمَ فسَأَلَهُ فقالَ له: «",["اتَّقِ اللهَ واصبِرْ",1],"». فرَجَعَ إلى أصحابِهِ فقالوا: ما أعطاكَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ فقالَ: ما أَعطاني شيئًا وقالَ لي: «اتَّقِ اللهَ واصبِرْ». ",["فلمْ يَلبثْ إلَّا يَسيرًا حتَّى جاءَ ابنٌ له بغنمٍ له كان العدُوُّ أصابوهُ",2],"، فأَتى رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فسَأَلَهُ عنها وأَخبرَهُ خبرَها، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «كُلْها»، فنَزَلَتْ: {وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مَخْرَجًا (2) وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ} [الطلاق: 2، 3]."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح الإسناد","bab":"تفسير آيات › سورة الطلاق","dorar":"DeLMBTY1"},{"id":"س-06052","fp":"43e57f5beb18","stateId":32,"easy":"إذا جاء العسر ← لن يغلب عسرٌ يسرين","cause":"عُسْرِ","result":"لنْ يغْلِبَ عُسْرٌ - إن شاء اللهُ - يُسْرَيْنِ","explicit":true,"ref":"تغليق التعليق 4/372","srcLabel":"عبد بن حميد","text":["عن قتادةَ, في قولِهِ [ 5: الانشراح ] ?فَإِنَّ مَعَ ال",["عُسْرِ",1]," يُسْرًا } قالَ: ذُكِرَ لنا أن رسولَ الله صلَّى اللهُ عليه وسلَّم بَشَّرَ بِهَذِهِ الآيةِ أصحابَهُ,فقالَ: ",["لنْ يغْلِبَ عُسْرٌ - إن شاء اللهُ - يُسْرَيْنِ",2]],"grade":"صحيح","narrator":"قتادة بن دعامة","muhaddith":"صحيح إلى قتادة","takhrij":"أخرجه عبد بن حميد كما في ((تغليق التعليق)) (4/ 372)، الطبري في ((التفسير)) (24/ 495) كلاهما بلفظه.","bab":"رقائق وزهد › فضل الصبر","dorar":"kVnHyOs9"},{"id":"س-00069","fp":"aac7351a4d15","stateId":32,"easy":"إذا أردت أن تُستجاب دعوتك وتُكشف كربتك ← فيسّر على المعسر","cause":"فلْيُفَرِّجْ عَنْ مُعْسِرٍ","result":"مَنْ أرادَ أنْ تُسْتَجابَ دعوتُهُ وأنْ تُكْشَفَ كُرْبَتُهُ","explicit":true,"apply":{"k":"time","t":"عند الكرب والهم"},"otherNeedIds":[29],"ref":"مجمع الزوائد 4/136","srcLabel":"أحمد","text":[["مَنْ أرادَ أنْ تُسْتَجابَ دعوتُهُ وأنْ تُكْشَفَ كُرْبَتُهُ ",2],["فلْيُفَرِّجْ عَنْ مُعْسِرٍ",1]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"رجاله ثقات","takhrij":"أخرجه أحمد (4749)، وعبد بن حميد في ((المسند)) (824) واللفظ لهما، وأبو يعلى (5713) باختلاف يسير.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"4gPdVHQS"},{"id":"س-05549","fp":"188e0e1653b1","stateId":32,"easy":"إذا صبرت ← فالصبر مفتاح الفرج","cause":"الصبرُ","result":"مِفتاحُ الفَرَجِ","explicit":true,"ref":"مختصر المقاصد 575","srcLabel":"الديلمي","text":[["الصبرُ ",1],["مِفتاحُ الفَرَجِ ",2],", والزُهدُ غِنَى الأبَدِ"],"grade":"حسن","narrator":"[الحسين بن علي بن أبي طالب]","muhaddith":"حسن لغيره","takhrij":"أخرجه الديلمي في ((الفردوس)) (3844)","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"14dhbZAD"},{"id":"س-00537","fp":"b6af97c58236","stateId":32,"easy":"إذا اشتد عليك العسر ← فاعلم أن اليسر يأتي بعده فيخرجه","cause":"لوْ جاءَ العسرُ، فدخلَ هذا الحجرَ","result":"لجاءَ اليسرُ، فدخلَ عليهِ، فأخرجَهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"الجامع الصغير 7428","srcLabel":"الحاكم","text":[["لوْ جاءَ العسرُ،  فدخلَ هذا الحجرَ",1],"،  ",["لجاءَ اليسرُ،  فدخلَ عليهِ،  فأخرجَهُ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (3010)، والبزار (7530)، والبيهقي في ((شعب الإيمان)) (9540) واللفظ لهم.","bab":"آداب عامة › ضرب الأمثال","dorar":"SJW3vTuQ"},{"id":"س-05554","fp":"7dae7875c522","stateId":32,"easy":"إذا ذكرت الموت في ضيق العيش ← يوسعه الله عليك، وإن ذكرته في سعة ضيّقها في عينك","cause":"لَم يذْكُرْه أحدٌ في ضيقٍ مِن العَيشِ","result":"إلَّا وسَّعَه علَيهِ ، و لا ذَكرَه في سَعةٍ إلَّا ضيَّقَها عليهِ","explicit":true,"ref":"الجامع الصغير 1394","srcLabel":"الترمذي","text":["أكثروا ذكرَ هاذمِ اللَّذاتِ : الموتِ ؛ فإنَّه ",["لَم يذْكُرْه أحدٌ في ضيقٍ مِن العَيشِ",1]," ",["إلَّا وسَّعَه علَيهِ ، و لا ذَكرَه في سَعةٍ إلَّا ضيَّقَها عليهِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2307)، والنسائي (1824) مختصراً، وابن حبان (2993) باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"030XpNkf"},{"id":"س-03817","fp":"6cd17fcfc7b6","stateId":33,"easy":"إذا آذاك جارك فأخرج متاعك إلى الطريق ← يكفّ أذاه عنك (من واقعة)","cause":"انْطَلِقْ فَأَخْرِجْ مَتَاعَكَ إلى الطَّرِيقِ","result":"فوَاللهِ ! لا أُؤْذِيكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[31],"ref":"صحيح الأدب المفرد 92","srcLabel":"البخاري","text":["قال رجلٌ : يا رسولَ اللهِ ! إِنَّ لي جَارً يُؤْذِينِي ، فقال : ",["انْطَلِقْ فَأَخْرِجْ مَتَاعَكَ إلى الطَّرِيقِ",1]," فانطلقَ فَأَخْرِجَ مَتَاعَهُ ، فَاجتمعَ الناسُ عليهِ ، فَقَالوا : ما شأنُكَ ؟ قال : لي جَارٌ يُؤْذِينِي ، فذكرْتُ لِلنَّبِيِّ صلَّى اللهُ عليهِ و سلَّمَ فقال : انْطَلِقْ فَأَخْرِجْ مَتَاعَكَ إلى الطَّرِيقِ فَجَعَلوا يقولونَ : اللهمَّ ! العنهُ ، اللهمَّ ! اخْزِهِ ، فَبلغَهُ فأتاهُ فقال : ارْجِعْ إلى منزلِكَ ، ",["فوَاللهِ ! لا أُؤْذِيكَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (124) واللفظ له، والبزار (8344)، والطبراني في ((مكارم الأخلاق)) (237)","bab":"بر وصلة › حق الجار والوصاة به","dorar":"XV9l3Ivf","merged":8,"otherRefs":["صحيح ابن حبان 520 (صحيح)","الزواجر عن اقتراف الكبائر 1/254 (حسن)","صحيح أبي داود 5153 (صحيح)","الترغيب والترهيب 3/321 (صحيح)","عمدة التفسير 1/594 (صحيح)","صحيح الترغيب 2559 (صحيح)","صحيح الأدب المفرد 93 (صحيح)"]},{"id":"س-05695","fp":"dfacc8eebe92","stateId":33,"easy":"إذا اتُّهمت ظلماً فصلّ وادعُ الله ← يبرّئك الله (من قصة جريج)","cause":"فقام وصلَّى ودعا","result":"قال : أبي الراعي","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[29],"ref":"الآداب للبيهقي 477","srcLabel":"متفق عليه","text":["لم يتكلَّمْ في المهدِ إلا ثلاثةٌ : عيسى بنُ مريمَ، قال : وكان في بني إسرائيلَ رجلٌ يُقالُ له : جُرَيجٌ وكان عابدًا، فابتَنى صومَعةً فجعَل يصلِّي فيها، فأتَتْه أمُّه فقالتْ : يا جُرَيْجُ، فقال : يا ربِّ أمي وصلاتي، فأقبَل على صلاتِه فانصرفَتْ، ثم جاءَتْ يومًا آخَرَ ففعَل مثلَ ذلك، ثم جاءتْه يومًا ثالثًا ففعَل مثلَ ذلك، فقالتْ أمُّه : اللهم لا تُمِتْه حتى يَرى أو ينظُرَ في وُجوهِ المومِساتِ . قال : فذكَر يومًا بنو إسرائيلَ جُرَيجًا وفضلَه فقالتْ بغِيٌّ من بَغايا بني إسرائيلَ : إن شئتُم لأفتنَنَّه لكم، فقالوا : قد شئنا، فانطلقَتْ فتعرضَتْ لجُرَيجٍ فلم يلتفِتْ إليها، فأتَتْ راعيًا وكان يأوي إلى صومعَةِ جُرَيجٍ بغنمِه فأمكنَتْه من نفسِها فحملَتْ فولدَتْ غُلامًا، فقالتْ : هو من جُرَيجٍ، فأتاه بنو إسرائيلَ فضرَبوه وشتَموه وهدَموا صَومعتَه، فقال : ما شأنُكم ؟ فقالوا : زنَيتَ بهذه البغِيِّ وولدَتْ غُلامًا . قال : فأينَ الغُلامُ ؟ قال : فجيءَ به ",["فقام وصلَّى ودعا",1]," ثم انصرَف إلى الغُلامِ فطعَنه بإصبَعِه وقال : باللهِ يا غُلامُ مَن أبوك ؟ ",["قال : أبي الراعي",2]," . قال : فوثَب الناسُ إليه فجعَلوا يُقَبِّلونَه وقالوا : نبني صومعتَك من ذهبٍ . قال : لا حاجةَ لي في ذلك ابنوها كما كانتْ . قال : وبينا امرأةٌ جالسةٌ وفي حَجرِها ابنٌ لها تُرضِعُه إذ مرَّ بها راكبٌ ذو شارَةٍ، فقالتْ : اللهم اجعَلِ ابني مثلَ هذا، فترَك ثديَها ثم أقبَل إلى الراكبِ فنظَر إليه فقال : اللهم لا تجعَلْني مثلَ هذا، ثم أقبَل على ثديِها يمُصُّه . قال أبو هُرَيرَةَ : لكأني أنظُرُ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم يحكي مصَّه ووضْعَ إصبَعِه في فيه فجعَل يمُصُّها . ثم مرَّ بأَمةٍ معَها الناسُ تضرِبُها فقالتْ : اللهم لا تجعَلْ ابني مثلَ هذه، فترَك ثديَها ثم نظَر إليها وقال : اللهم اجعَلْني مثلَها . فعِندَ ذلك تراجَعا الحديثَ فقالتْ : خلفي أي بني مرَّ بي الراكبُ ذو شارَةٍ فقلتُ : اللهم اجعَلِ ابني مثلَ هذا، قلتَ : اللهم لا تجعلني مثلَه، ثم مرَّ بي هذه الأَمةُ فقلتُ : اللهم لا تجعَلِ ابني مثلَ هذه الأَمةِ، فقلتُ : اللهم اجعَلْني مثلَها . فقال : يا أُمَّتاه إن الراكبَ الذي مرَّ بكِ جبَّارٌ فدعوتِ اللهَ أن يجعلَني مثلَه، فقلتُ : اللهم لا تجعَلْني مثلَه . وهذه يقولونَ سَرقَتْ، ولم تسرِقْ، وزنَتْ، ولم تزْنِ وهي تقولُ : حسبيَ اللهُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (3436)، ومسلم (2550)، وأحمد (8071)، والبيهقي في ((الآداب)) (764) واللفظ له","bab":"رقائق وزهد › الكبر والتواضع","dorar":"in6ZBEq7","merged":2,"otherRefs":["صحيح البخاري 3436 (صحيح)"]},{"id":"س-06239","fp":"19c2655012b0","stateId":33,"easy":"إذا اتُّهمت ظلماً فصبرت ← ينجيك الله ويظهر براءتك (من قصة)","cause":"هذا الَّذي اتَّهمتُموني به","result":"ألَا إنَّه مِن بَلْدةِ الكُفرِ أنجاني","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[31],"ref":"تخريج صحيح ابن حبان 1655","srcLabel":"البخاري","text":["أنَّ وليدةً كانت مِن العرَبِ فأعتَقوها فكانت معهم فخرَجَتْ صبيَّةٌ لهم عليها وِشاحٌ أحمَرُ مِن سُيورٍ قالت : فوضَعَتْه فمرَّت به حُدَيَّاةٌ وهو مُلْقًى فحسِبَتْه لحمًا فخطِفَتْه قالت : فالتمَسوه فلَمْ يجِدوه قالت : فاتَّهموني به فقطَعوا بي يُفتِّشوني ففتَّشوا حتَّى فتَّشوا قُبُلَها قالت : فواللهِ إنِّي لَقائمةٌ معهم إذ مرَّتِ الحُدَيَّاةٌ فألقَتْه فوقَع بَيْنَهم قالت : فقُلْتُ : ",["هذا الَّذي اتَّهمتُموني به",1]," زعَمْتُم وأنا منه بريئةٌ وهو ذا هو قالت : فجاءَتْ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فأسلَمَتْ قالت عائشةُ : وكان لها خِباءٌ في المسجِدِ قالت : فكانت تأتيني فتتحدَّثُ عندي قالت : فلا تجلِسُ عندي مجلِسًا إلَّا قالت : \n( ويومُ الوِشاحِ مِن أعاجيبِ ربِّنا = ",["ألَا إنَّه مِن بَلْدةِ الكُفرِ أنجاني",2]," ) \nقالت عائشةُ : فقُلْتُ لها : ما شأنُكِ لا تقعُدينَ معي مقعَدًا إلَّا قُلْتِ هذا ؟ قالت : فحدَّثَتْني بهذا الحديثِ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه ابن حبان (1655) واللفظ له، والبخاري (439)، وابن خزيمة (1332)، وأبو نعيم في ((الحلية)) (2/ 71) جميعا باختلاف يسير.","bab":"شعر › الرخصة في الشعر ما لم يكن شركا أو هجاء مسلم","dorar":"kavBZyAM","merged":2,"otherRefs":["صحيح ابن خزيمة 2/ 471 (صحيح)"]},{"id":"س-07719","fp":"fbf078789dde","stateId":33,"easy":"إذا صدقت في نقل الحق وكُذّبت ← يصدّقك الله ويعذرك (من قصة زيد بن أرقم)","cause":"لا تنفقوا على من عند رسولِ اللهِ حتَّى ينفضُّوا، فأتيتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم فأخبرتُه","result":"إنَّ اللهَ عزَّ وجلَّ قد صدَّقك وعذَّرك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[42],"ref":"حلية الأولياء 3/252","srcLabel":"متفق عليه","text":["سمِعتُ عبدَ اللهِ بنَ أُبيٍّ يقولُ : ",["لا تنفقوا على من عند رسولِ اللهِ حتَّى ينفضُّوا، فأتيتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم فأخبرتُه",1]," ، فأتاه ابنُ أُبيٍّ فحلف أنَّه لم يقُلْ ذلك ، وأتاني أصحابُ النَّبيِّ صلَّى اللهُ عليه وسلَّم فلاموني ، قال : فأتيتُ منزلي فنِمتُ ، قال : كأنَّه كئيبٌ ، قال : فأرسل إليَّ النَّبيُّ صلَّى اللهُ عليه وسلَّم ، أو قال : فأتيتُ النَّبيُّ صلَّى اللهُ عليه وسلَّم فقال : ",["إنَّ اللهَ عزَّ وجلَّ قد صدَّقك وعذَّرك",2]," ، وتلا هاتَيْن الآيتَيْن : { هُمُ الَّذِينَ يَقُولُونَ لَا تُنْفِقُوا عَلَى مَنْ عِنْدَ رَسُولِ اللَّهِ حَتَّى يَنْفَضُّوا } الآيتَيْن"],"grade":"صحيح","narrator":"زيد بن أرقم","muhaddith":"صحيح متفق عليه [أي:بين العلماء] من حديث معاذ عن شعبة","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (8/ 177) (5003) بلفظه، البخاري (4900)، ومسلم (2772)، والترمذي (3312) جميعا بنحوه.","bab":"قرآن › أسباب النزول","dorar":"CxecVg35","merged":2,"otherRefs":["تخريج المسند لشعيب 19295 (صحيح)"]},{"id":"س-07724","fp":"fbc2a0df133f","stateId":33,"easy":"إذا صدقت وكذّبك الناس ← ينصرك الله ويطيب قلبك (من قصة)","cause":"وكذَّبَني","result":"فما كان يسُرُّني أنَّ لي بها الخُلدَ أوِ الدُّنيا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 3858","srcLabel":"متفق عليه","text":["غَزَوْنا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، وكان معنا ناسٌ مِنَ الأعرابِ، فكنَّا نَبتدِرُ الماءَ، وكان الأعرابُ يَسبِقونَنا فيَسبِقُ الأعرابيُّ أصحابَهُ فيَملأُ الحوضَ، ويَجعلُ حولَهُ حجارةً، ويَجعلُ النِّطْعَ عليه حتَّى يَجيءَ أصحابُهُ، فأَتى رَجلٌ مِنَ الأنصارِ الأعرابيَّ فأَرخى زِمامَ ناقتِهِ لتَشربَ، فأَبى أنْ يَدعَهُ فانتَزَعَ حجرًا ففاضَ، فرفَعَ الأعرابيُّ خشبةً، فضَرَبَ بها رأسَ الأنصاريِّ فشَجَّهُ، فأَتى عبدُ اللهِ بنُ أُبيٍّ رأسُ المنافقينَ فأخبرَهُ، وكان مِن أصحابِهِ فغَضِبَ عبدُ اللهِ بنُ أُبيٍّ، ثُمَّ قالَ: لا تُنفِقوا على مَنْ عندَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ حتَّى يَنفضُّوا مِن حولِهِ -يعني الأعرابَ- وكانوا يُحدِّثونَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ عندَ الطَّعامِ، فقالَ عبدُ اللهِ لأصحابِهِ: إذا انفضُّوا مِن عندِ مُحمَّدٍ، فأْتوا مُحمَّدًا للطَّعامِ فليَأكُلْ هو ومَنْ عندَهُ، ثُمَّ قالَ لأصحابِهِ: إذا رَجَعْتُم إلى المدينةِ، ليُخرِجنَّ الأعزُّ منها الأذلَّ، قالَ زيدٌ: وأنا رِدفُ عمِّي، فسَمِعتُ عبدَ اللهِ، وكنَّا أخوالَهُ، فأَخبرتُ عمِّي، فانطَلَقَ، فأَخْبَرَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فأرسلَ إليه رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فحَلَفَ وجَحَدَ، فصدَّقَهُ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ",["وكذَّبَني",1],"، فجاءَ إلى عمِّي، فقالَ: ما أَردتَ إنْ مَقَتَكَ رسولُ الله صلَّى اللهُ عليه وسلَّمَ وكَذَّبَكَ، وكَذَّبَكَ المسلمونَ. فوَقَعَ علَيَّ مِنَ الغمِّ ما لمْ يَقعْ على أَحَدٍ قَطُّ، فبيْنَا أنا أَسيرُ مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في سَفرٍ وقد خفَقْتُ برأسي مِنَ الهَمِّ، فأَتاني رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فعَرَكَ أُذُني وضَحِكَ في وجهي، ",["فما كان يسُرُّني أنَّ لي بها الخُلدَ أوِ الدُّنيا",2],"، ثُمَّ إنَّ أبا بكرٍ لَحِقَني، فقالَ: ما قالَ لكَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ قلتُ: ما قالَ لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ شيئًا غيرَ أنَّه عَرَكَ أُذني وضَحِكَ في وجهي، فقالَ: أَبشِرْ. ثُمَّ لَحِقني عُمَرُ فقلتُ له مثلَ قولي لأبي بكرٍ، فلمَّا أصبَحْنا قَرَأَ رسولُ الله صلَّى اللهُ عليه وسلَّمَ سورةَ المنافقينَ: {قَالُوا نَشْهَدُ إِنَّكَ لَرَسُولُ اللَّهِ} [المنافقون: 1] حتَّى بَلَغَ: {هُمُ الَّذِينَ يَقُولُونَ لَا تُنْفِقُوا عَلَى مَنْ عِنْدَ رَسُولِ اللَّهِ حَتَّى يَنْفَضُّوا} [المنافقون: 7] حتَّى بَلَغَ: {لَيُخْرِجَنَّ الْأَعَزُّ مِنْهَا الْأَذَلَّ} [المنافقون: 8]."],"grade":"صحيح","narrator":"زيد بن أرقم","muhaddith":"إسناده صحيح [وله متابعة]","takhrij":"أخرجه البخاري (4901)، ومسلم (2772) بنحوه.","bab":"قرآن › أسباب النزول","dorar":"W2iREhoE"},{"id":"س-03185","fp":"df1f803a8a31","stateId":33,"easy":"إذا أسلمت ← تسلم","cause":"أسْلِمْ","result":"تَسْلَمْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[66,53],"ref":"أضواء البيان 3/577","srcLabel":"أضواء البيان","text":["حديثُ هِرَقلَ لقد أمِر أمرُ ابنِ أبي كَبشةَ إنه لَيَخافُه ملِكُ بني الأصفَرِ [يعني حديث: انْطَلَقْتُ في المُدَّةِ الَّتي كَانَتْ بَيْنِي وبيْنَ رَسولِ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ، قَالَ: فَبيْنَا أنَا بالشَّأْمِ، إذْ جِيءَ بكِتَابٍ مِنَ النبيِّ صَلَّى اللهُ عليه وسلَّمَ إلى هِرَقْلَ ، قَالَ: وكانَ دَحْيَةُ الكَلْبِيُّ جَاءَ به، فَدَفَعَهُ إلى عَظِيمِ بُصْرَى، فَدَفَعَهُ عَظِيمُ بُصْرَى إلى هِرَقْلَ ، قَالَ: فَقَالَ هِرَقْلُ: هلْ هَا هُنَا أحَدٌ مِن قَوْمِ هذا الرَّجُلِ الذي يَزْعُمُ أنَّه نَبِيٌّ؟ فَقالوا: نَعَمْ، قَالَ: فَدُعِيتُ في نَفَرٍ مِن قُرَيْشٍ، فَدَخَلْنَا علَى هِرَقْلَ فَأُجْلِسْنَا بيْنَ يَدَيْهِ، فَقَالَ: أيُّكُمْ أقْرَبُ نَسَبًا مِن هذا الرَّجُلِ الذي يَزْعُمُ أنَّه نَبِيٌّ؟ فَقَالَ أبو سُفْيَانَ: فَقُلتُ: أنَا، فأجْلَسُونِي بيْنَ يَدَيْهِ، وأَجْلَسُوا أصْحَابِي خَلْفِي، ثُمَّ دَعَا بتَرْجُمَانِهِ، فَقَالَ: قُلْ لهمْ: إنِّي سَائِلٌ هذا عن هذا الرَّجُلِ الذي يَزْعُمُ أنَّه نَبِيٌّ، فإنْ كَذَبَنِي فَكَذِّبُوهُ، قَالَ أبو سُفْيَانَ: وايْمُ اللَّهِ ، لَوْلَا أنْ يُؤْثِرُوا عَلَيَّ الكَذِبَ لَكَذَبْتُ، ثُمَّ قَالَ: لِتَرْجُمَانِهِ، سَلْهُ كيفَ حَسَبُهُ فِيكُمْ؟ قَالَ: قُلتُ: هو فِينَا ذُو حَسَبٍ، قَالَ: فَهلْ كانَ مِن آبَائِهِ مَلِكٌ؟ قَالَ: قُلتُ: لَا، قَالَ: فَهلْ كُنْتُمْ تَتَّهِمُونَهُ بالكَذِبِ قَبْلَ أنْ يَقُولَ ما قَالَ؟ قُلتُ: لَا، قَالَ: أيَتَّبِعُهُ أشْرَافُ النَّاسِ أمْ ضُعَفَاؤُهُمْ؟ قَالَ: قُلتُ: بَلْ ضُعَفَاؤُهُمْ، قَالَ: يَزِيدُونَ أوْ يَنْقُصُونَ؟ قَالَ: قُلتُ لا بَلْ يَزِيدُونَ، قَالَ: هلْ يَرْتَدُّ أحَدٌ منهمْ عن دِينِهِ بَعْدَ أنْ يَدْخُلَ فيه سَخْطَةً له؟ قَالَ: قُلتُ: لَا، قَالَ: فَهلْ قَاتَلْتُمُوهُ؟ قَالَ: قُلتُ: نَعَمْ، قَالَ: فَكيفَ كانَ قِتَالُكُمْ إيَّاهُ؟ قَالَ: قُلتُ: تَكُونُ الحَرْبُ بيْنَنَا وبيْنَهُ سِجَالًا يُصِيبُ مِنَّا ونُصِيبُ منه، قَالَ: فَهلْ يَغْدِرُ؟ قَالَ: قُلتُ: لَا، ونَحْنُ منه في هذِه المُدَّةِ لا نَدْرِي ما هو صَانِعٌ فِيهَا، قَالَ: واللَّهِ ما أمْكَنَنِي مِن كَلِمَةٍ أُدْخِلُ فِيهَا شيئًا غيرَ هذِه، قَالَ: فَهلْ قَالَ هذا القَوْلَ أحَدٌ قَبْلَهُ؟ قُلتُ: لَا، ثُمَّ قَالَ لِتُرْجُمَانِهِ: قُلْ له: إنِّي سَأَلْتُكَ عن حَسَبِهِ فِيكُمْ، فَزَعَمْتَ أنَّه فِيكُمْ ذُو حَسَبٍ، وكَذلكَ الرُّسُلُ تُبْعَثُ في أحْسَابِ قَوْمِهَا، وسَأَلْتُكَ: هلْ كانَ في آبَائِهِ مَلِكٌ، فَزَعَمْتَ أنْ لَا، فَقُلتُ: لو كانَ مِن آبَائِهِ مَلِكٌ، قُلتُ: رَجُلٌ يَطْلُبُ مُلْكَ آبَائِهِ، وسَأَلْتُكَ عن أتْبَاعِهِ أضُعَفَاؤُهُمْ أمْ أشْرَافُهُمْ، فَقُلْتَ: بَلْ ضُعَفَاؤُهُمْ، وهُمْ أتْبَاعُ الرُّسُلِ ، وسَأَلْتُكَ: هلْ كُنْتُمْ تَتَّهِمُونَهُ بالكَذِبِ قَبْلَ أنْ يَقُولَ ما قَالَ، فَزَعَمْتَ أنْ لَا، فَعَرَفْتُ أنَّه لَمْ يَكُنْ لِيَدَعَ الكَذِبَ علَى النَّاسِ، ثُمَّ يَذْهَبَ فَيَكْذِبَ علَى اللَّهِ، وسَأَلْتُكَ هلْ يَرْتَدُّ أحَدٌ منهمْ عن دِينِهِ بَعْدَ أنْ يَدْخُلَ فيه سَخْطَةً له، فَزَعَمْتَ أنْ لَا، وكَذلكَ الإيمَانُ إذَا خَالَطَ بَشَاشَةَ القُلُوبِ، وسَأَلْتُكَ هلْ يَزِيدُونَ أمْ يَنْقُصُونَ، فَزَعَمْتَ أنَّهُمْ يُزِيدُونَ وكَذلكَ الإيمَانُ حتَّى يَتِمَّ، وسَأَلْتُكَ: هلْ قَاتَلْتُمُوهُ فَزَعَمْتَ أنَّكُمْ قَاتَلْتُمُوهُ، فَتَكُونُ الحَرْبُ بيْنَكُمْ وبيْنَهُ سِجَالًا يَنَالُ مِنكُم وتَنَالُونَ منه، وكَذلكَ الرُّسُلُ تُبْتَلَى ثُمَّ تَكُونُ لهمُ العَاقِبَةُ، وسَأَلْتُكَ هلْ يَغْدِرُ فَزَعَمْتَ أنَّه لا يَغْدِرُ، وكَذلكَ الرُّسُلُ لا تَغْدِرُ، وسَأَلْتُكَ: هلْ قَالَ أحَدٌ هذا القَوْلَ قَبْلَهُ، فَزَعَمْتَ أنْ لَا، فَقُلتُ: لو كانَ قَالَ هذا القَوْلَ أحَدٌ قَبْلَهُ، قُلتُ: رَجُلٌ ائْتَمَّ بقَوْلٍ قيلَ قَبْلَهُ، قَالَ: ثُمَّ قَالَ: بمَ يَأْمُرُكُمْ؟ قَالَ: قُلتُ: يَأْمُرُنَا بالصَّلَاةِ والزَّكَاةِ والصِّلَةِ والعَفَافِ، قَالَ: إنْ يَكُ ما تَقُولُ فيه حَقًّا، فإنَّه نَبِيٌّ، وقدْ كُنْتُ أعْلَمُ أنَّه خَارِجٌ، ولَمْ أكُ أظُنُّهُ مِنكُمْ، ولو أنِّي أعْلَمُ أنِّي أخْلُصُ إلَيْهِ لَأَحْبَبْتُ لِقَاءَهُ، ولو كُنْتُ عِنْدَهُ لَغَسَلْتُ عن قَدَمَيْهِ، ولَيَبْلُغَنَّ مُلْكُهُ ما تَحْتَ قَدَمَيَّ، قَالَ: ثُمَّ دَعَا بكِتَابِ رَسولِ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ فَقَرَأَهُ: فَإِذَا فيه بسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ مِن مُحَمَّدٍ رَسولِ اللَّهِ إلى هِرَقْلَ عَظِيمِ الرُّومِ ، سَلَامٌ علَى مَنِ اتَّبَعَ الهُدَى، أمَّا بَعْدُ: فإنِّي أدْعُوكَ بدِعَايَةِ الإسْلَامِ، ",["أسْلِمْ",1]," ",["تَسْلَمْ",2],"، وأَسْلِمْ يُؤْتِكَ اللَّهُ أجْرَكَ مَرَّتَيْنِ، فإنْ تَوَلَّيْتَ فإنَّ عَلَيْكَ إثْمَ الأرِيسِيِّينَ ، و: {يَا أهْلَ الكِتَابِ تَعَالَوْا إلى كَلِمَةٍ سَوَاءٍ بيْنَنَا وبيْنَكُمْ، أنْ لا نَعْبُدَ إلَّا اللَّهَ} إلى قَوْلِهِ: {اشْهَدُوا بأنَّا مُسْلِمُونَ} فَلَمَّا فَرَغَ مِن قِرَاءَةِ الكِتَابِ، ارْتَفَعَتِ الأصْوَاتُ عِنْدَهُ وكَثُرَ اللَّغَطُ ، وأُمِرَ بنَا فَأُخْرِجْنَا، قَالَ: فَقُلتُ لأصْحَابِي حِينَ خَرَجْنَا: لقَدْ أمِرَ أمْرُ ابْنِ أبِي كَبْشَةَ، إنَّه لَيَخَافُهُ مَلِكُ بَنِي الأصْفَرِ، فَما زِلْتُ مُوقِنًا بأَمْرِ رَسولِ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ أنَّه سَيَظْهَرُ حتَّى أدْخَلَ اللَّهُ عَلَيَّ الإسْلَامَ، قَالَ الزُّهْرِيُّ: فَدَعَا هِرَقْلُ عُظَمَاءَ الرُّومِ فَجَمعهُمْ في دَارٍ له، فَقَالَ: يا مَعْشَرَ الرُّومِ، هلْ لَكُمْ في الفلاحِ والرَّشَدِ آخِرَ الأبَدِ، وأَنْ يَثْبُتَ لَكُمْ مُلْكُكُمْ، قَالَ: فَحَاصُوا حَيْصَةَ حُمُرِ الوَحْشِ إلى الأبْوَابِ، فَوَجَدُوهَا قدْ غُلِّقَتْ، فَقَالَ: عَلَيَّ بهِمْ، فَدَعَا بهِمْ فَقَالَ: إنِّي إنَّما اخْتَبَرْتُ شِدَّتَكُمْ علَى دِينِكُمْ، فقَدْ رَأَيْتُ مِنْكُمُ الذي أحْبَبْتُ فَسَجَدُوا له ورَضُوا عنْه.]"],"grade":"صحيح","narrator":"[أبو سفيان بن حرب]","muhaddith":"صحيح","bab":"إيمان › دعوة الكافر إلى الإسلام","dorar":"t0gRurVe","merged":8,"otherRefs":["صحيح البخاري 6944 (صحيح)","المستدرك على الصحيحين 4417 (صحيح)","صحيح البخاري 3167 (صحيح)","مجمع الزوائد 5/308 (صحيح)","الأحاديث المختارة 2426 (صحيح)"]},{"id":"س-00731","fp":"3f444679e059","stateId":33,"easy":"إذا خفت ظلم ذي سلطان فقل «اللهم رب السماوات السبع... كن لي جاراً» ← يكون الله لك جاراً منه","cause":"فليقلِ اللَّهمَّ ربَّ السَّمواتِ السَّبعِ وربَّ العرشِ العظيمِ كن لي جارًا من فلانِ بنِ فلانٍ وأحزابِهِ من خلائقِكَ أن يفرطَ عليَّ أحدٌ منْهم أو يَطغى عزَّ جارُكَ وجلَّ ثناؤُكَ ولا إلَهَ إلَّا أنتَ","result":"إذا كانَ على أحدِكم إمامٌ يخافُ تَغطرُسَهُ أو ظلمَهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«اللهم رب السماوات السبع... كن لي جاراً»"},"similar":["س-00828"],"otherNeedIds":[31],"ref":"صحيح الأدب المفرد 545","srcLabel":"البخاري (الأدب المفرد)","text":["عن عبدِ اللَّهِ بنِ مسعودٍ ",["إذا كانَ على أحدِكم إمامٌ يخافُ تَغطرُسَهُ أو ظلمَهُ",2]," ",["فليقلِ (اللَّهمَّ ربَّ السَّمواتِ السَّبعِ وربَّ العرشِ العظيمِ كن لي جارًا من فلانِ بنِ فلانٍ وأحزابِهِ من خلائقِكَ أن يفرطَ عليَّ أحدٌ منْهم أو يَطغى عزَّ جارُكَ وجلَّ ثناؤُكَ ولا إلَهَ إلَّا أنتَ",1]],"grade":"صحيح","muhaddith":"صحيح","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"SRNW0ENn"},{"id":"س-00828","fp":"7a16c51488b8","stateId":33,"easy":"إذا خفت السلطان فقل «اللهم رب السماوات السبع... كن لي جاراً» ← يكون الله لك جاراً منه","cause":"فليقُلِ اللَّهمَّ ربَّ السَّماواتِ السَّبعِ وربَّ العرشِ العظيمِ كُنْ لي جارًا من شرِّ فلانِ بنِ فلانٍ يعني الَّذي يُريدُه وشرِّ الجنِّ والإنسِ وأتباعِهم أن يفرُطَ عليَّ أحدٌ منهم عزَّ جارُك وجلَّ ثناؤُك ولا إلهَ غيرُك","result":"إذا تخوَّف أحدُكم السُّلطانَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«اللَّهمَّ ربَّ السَّماواتِ السَّبعِ وربَّ العرشِ العظيمِ كُنْ لي جارًا»"},"repOf":"س-00731","otherNeedIds":[31],"ref":"الترغيب والترهيب 3/202","text":[["إذا تخوَّف أحدُكم السُّلطانَ",2]," ",["فليقُلِ اللَّهمَّ ربَّ السَّماواتِ السَّبعِ وربَّ العرشِ العظيمِ كُنْ لي جارًا من شرِّ فلانِ بنِ فلانٍ يعني الَّذي يُريدُه وشرِّ الجنِّ والإنسِ وأتباعِهم أن يفرُطَ عليَّ أحدٌ منهم عزَّ جارُك وجلَّ ثناؤُك ولا إلهَ غيرُك",1]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"رجاله رجال الصحيح إلا جناد بن سلم وقد وثق","takhrij":"أخرجه الخرائطي في ((مكارم الأخلاق)) (1047)، والطبراني (10/18) (9795) واللفظ له، والبيهقي في ((الدعوات الكبير)) (472)","bab":"أدعية وأذكار › دعوات النبي صلى الله عليه وسلم","dorar":"5wuN4c3q"},{"id":"س-03658","fp":"a9c8a712d564","stateId":33,"easy":"إذا ظُلمت فلا تُكثر الدعاء على ظالمك ← لا تخففي عنه إثمه بدعائك عليه","cause":"تَدْعو على سارِقٍ سَرَقَها","result":"لا تُسبِّخي عنهُ بدُعائِكِ عليْهِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج شرح السنة 1354","srcLabel":"أبو داود","text":["عَنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، وسمِعَها ",["تَدْعو على سارِقٍ سَرَقَها",1],"، قالَ: ",["لا تُسبِّخي عنهُ بدُعائِكِ عليْهِ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[فيه] حبيب بن أبي ثابت كثير التدليس، وقد عنعن، وبقية رجاله ثقات","takhrij":"أخرجه البغوي في ((شرح السنة)) (1354) واللفظ له، وأبو داود (1497)، وأحمد (24183) باختلاف يسير.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"iR8tuXdd","merged":2,"otherRefs":["عمدة التفسير 1/593 (صحيح)"]}]}