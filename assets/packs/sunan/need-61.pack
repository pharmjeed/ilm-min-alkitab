44","quran":{"s":35,"from":44,"to":44,"text":"أَوَلَمْ يَسِيرُوا فِي الْأَرْضِ فَيَنْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الَّذِينَ مِنْ قَبْلِهِمْ وَكَانُوا أَشَدَّ مِنْهُمْ قُوَّةً وَمَا كَانَ اللَّهُ لِيُعْجِزَهُ مِنْ شَيْءٍ فِي السَّمَاوَاتِ وَلَا فِي الْأَرْضِ إِنَّهُ كَانَ عَلِيمًا قَدِيرًا (44)","hl":[[0,46,1],[46,94,2],[94,129,1]]}},{"id":"ق-1045","fp":"f05cf5f33f9f","stateId":631,"easy":"الضلال بعد الإنذار ← سوء عاقبة المنذَرين","cause":"الضلال بعد الإنذار","result":"سوء عاقبة المنذَرين","explicit":true,"repOf":"ق-0165","ref":"سورة الصافات: 71–73","quran":{"s":37,"from":71,"to":73,"text":"وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ الْأَوَّلِينَ (71) وَلَقَدْ أَرْسَلْنَا فِيهِمْ مُنْذِرِينَ (72) فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُنْذَرِينَ (73)","hl":[[0,100,1],[100,147,2]]}},{"id":"ق-1057","fp":"b96ad20ba76f","stateId":631,"easy":"العزة والشقاق (الكفر) ← إهلاك القرون ولات حين مناص","cause":"العزة والشقاق (الكفر)","result":"إهلاك القرون ولات حين مناص","explicit":true,"repOf":"ق-0549","ref":"سورة ص: 2–3","quran":{"s":38,"from":2,"to":3,"text":"بَلِ الَّذِينَ كَفَرُوا فِي عِزَّةٍ وَشِقَاقٍ (2) كَمْ أَهْلَكْنَا مِنْ قَبْلِهِمْ مِنْ قَرْنٍ فَنَادَوْا وَلَاتَ حِينَ مَنَاصٍ (3)","hl":[[0,50,1],[50,127,2]]}},{"id":"ق-1084","fp":"881ba9fdb303","stateId":631,"easy":"التكذيب ← العذاب من حيث لا يشعرون وخزي الدنيا وعذاب الآخرة أكبر","cause":"التكذيب","result":"العذاب من حيث لا يشعرون وخزي الدنيا وعذاب الآخرة أكبر","explicit":true,"repOf":"ق-0686","otherNeedIds":[60,69],"ref":"سورة الزمر: 25–26","quran":{"s":39,"from":25,"to":26,"text":"كَذَّبَ الَّذِينَ مِنْ قَبْلِهِمْ فَأَتَاهُمُ الْعَذَابُ مِنْ حَيْثُ لَا يَشْعُرُونَ (25) فَأَذَاقَهُمُ اللَّهُ الْخِزْيَ فِي الْحَيَاةِ الدُّنْيَا وَلَعَذَابُ الْآخِرَةِ أَكْبَرُ لَوْ كَانُوا يَعْلَمُونَ (26)","hl":[[0,34,1],[34,179,2],[179,204,1]]}},{"id":"ق-1102","fp":"77f2e5f4161c","stateId":631,"easy":"الجدال في آيات الله بالباطل وهمّ الأمم برسلها ← الأخذ والعقاب وحقّت عليهم كلمة العذاب","cause":"الجدال في آيات الله بالباطل وهمّ الأمم برسلها","result":"الأخذ والعقاب وحقّت عليهم كلمة العذاب","explicit":true,"otherNeedIds":[70],"ref":"سورة غافر: 4–6","srcLabel":"القرآن الكريم","quran":{"s":40,"from":4,"to":6,"text":"مَا يُجَادِلُ فِي آيَاتِ اللَّهِ إِلَّا الَّذِينَ كَفَرُوا فَلَا يَغْرُرْكَ تَقَلُّبُهُمْ فِي الْبِلَادِ (4) كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ وَالْأَحْزَابُ مِنْ بَعْدِهِمْ وَهَمَّتْ كُلُّ أُمَّةٍ بِرَسُولِهِمْ لِيَأْخُذُوهُ وَجَادَلُوا بِالْبَاطِلِ لِيُدْحِضُوا بِهِ الْحَقَّ فَأَخَذْتُهُمْ فَكَيْفَ كَانَ عِقَابِ (5) وَكَذَلِكَ حَقَّتْ كَلِمَتُ رَبِّكَ عَلَى الَّذِينَ كَفَرُوا أَنَّهُمْ أَصْحَابُ النَّارِ (6)","hl":[[0,278,1],[278,409,2]]}},{"id":"ق-1107","fp":"855e950bacbd","stateId":631,"easy":"الكفر بعد مجيء البينات ← أخذ الله بالذنوب ولا واقي","cause":"الكفر بعد مجيء البينات","result":"أخذ الله بالذنوب ولا واقي","explicit":true,"ref":"سورة غافر: 21–22","srcLabel":"القرآن الكريم","quran":{"s":40,"from":21,"to":22,"text":"أَوَلَمْ يَسِيرُوا فِي الْأَرْضِ فَيَنْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الَّذِينَ كَانُوا مِنْ قَبْلِهِمْ كَانُوا هُمْ أَشَدَّ مِنْهُمْ قُوَّةً وَآثَارًا فِي الْأَرْضِ فَأَخَذَهُمُ اللَّهُ بِذُنُوبِهِمْ وَمَا كَانَ لَهُمْ مِنَ اللَّهِ مِنْ وَاقٍ (21) ذَلِكَ بِأَنَّهُمْ كَانَتْ تَأْتِيهِمْ رُسُلُهُمْ بِالْبَيِّنَاتِ فَكَفَرُوا فَأَخَذَهُمُ اللَّهُ إِنَّهُ قَوِيٌّ شَدِيدُ الْعِقَابِ (22)","hl":[[0,165,1],[165,242,2],[242,325,1],[325,345,2],[345,380,1]]}},{"id":"ق-1125","fp":"0c288c35b3c5","stateId":631,"easy":"الفرح بما عندهم من العلم وردّ البينات ← يحيق بهم ما كانوا به يستهزئون ولا يغني عنهم كسبهم","cause":"الفرح بما عندهم من العلم وردّ البينات","result":"يحيق بهم ما كانوا به يستهزئون ولا يغني عنهم كسبهم","explicit":true,"repOf":"ق-0346","ref":"سورة غافر: 82–83","quran":{"s":40,"from":82,"to":83,"text":"أَفَلَمْ يَسِيرُوا فِي الْأَرْضِ فَيَنْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الَّذِينَ مِنْ قَبْلِهِمْ كَانُوا أَكْثَرَ مِنْهُمْ وَأَشَدَّ قُوَّةً وَآثَارًا فِي الْأَرْضِ فَمَا أَغْنَى عَنْهُمْ مَا كَانُوا يَكْسِبُونَ (82) فَلَمَّا جَاءَتْهُمْ رُسُلُهُمْ بِالْبَيِّنَاتِ فَرِحُوا بِمَا عِنْدَهُمْ مِنَ الْعِلْمِ وَحَاقَ بِهِمْ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ (83)","hl":[[0,163,1],[163,209,2],[209,304,1],[304,351,2]]}},{"id":"ق-1166","fp":"e4dbd36300fe","stateId":631,"easy":"تقليد الآباء في الباطل وتكذيب الرسل ← الانتقام وسوء العاقبة","cause":"تقليد الآباء في الباطل وتكذيب الرسل","result":"الانتقام وسوء العاقبة","explicit":true,"repOf":"ق-0165","ref":"سورة الزخرف: 25","quran":{"s":43,"from":25,"to":25,"text":"فَانْتَقَمْنَا مِنْهُمْ فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُكَذِّبِينَ (25)","hl":[[0,56,2],[56,72,1]]}},{"id":"ق-1214","fp":"81c1b91ad263","stateId":631,"easy":"إخراج الرسول ← الإهلاك بلا ناصر","cause":"إخراج الرسول","result":"الإهلاك بلا ناصر","explicit":true,"similar":["ق-0717"],"ref":"سورة محمد: 13","srcLabel":"القرآن الكريم","quran":{"s":47,"from":13,"to":13,"text":"وَكَأَيِّنْ مِنْ قَرْيَةٍ هِيَ أَشَدُّ قُوَّةً مِنْ قَرْيَتِكَ الَّتِي أَخْرَجَتْكَ أَهْلَكْنَاهُمْ فَلَا نَاصِرَ لَهُمْ (13)","hl":[[0,84,1],[84,120,2]]}},{"id":"ق-1341","fp":"ae2746cf08e1","stateId":631,"easy":"الكفر بالرسل والتولي عنهم ← ذوق وبال الأمر وعذاب أليم","cause":"الكفر بالرسل والتولي عنهم","result":"ذوق وبال الأمر وعذاب أليم","explicit":true,"repOf":"ق-0686","otherNeedIds":[69],"ref":"سورة التغابن: 5–6","quran":{"s":64,"from":5,"to":6,"text":"أَلَمْ يَأْتِكُمْ نَبَأُ الَّذِينَ كَفَرُوا مِنْ قَبْلُ فَذَاقُوا وَبَالَ أَمْرِهِمْ وَلَهُمْ عَذَابٌ أَلِيمٌ (5) ذَلِكَ بِأَنَّهُ كَانَتْ تَأْتِيهِمْ رُسُلُهُمْ بِالْبَيِّنَاتِ فَقَالُوا أَبَشَرٌ يَهْدُونَنَا فَكَفَرُوا وَتَوَلَّوْا وَاسْتَغْنَى اللَّهُ وَاللَّهُ غَنِيٌّ حَمِيدٌ (6)","hl":[[0,56,1],[56,109,2],[109,280,1]]}},{"id":"ق-1165","fp":"ce6e4984ba08","stateId":631,"easy":"الاستهزاء بالأنبياء ← إهلاك من هم أشد بطشاً","cause":"الاستهزاء بالأنبياء","result":"إهلاك من هم أشد بطشاً","explicit":true,"ref":"سورة الزخرف: 6–8","srcLabel":"القرآن الكريم","quran":{"s":43,"from":6,"to":8,"text":"وَكَمْ أَرْسَلْنَا مِنْ نَبِيٍّ فِي الْأَوَّلِينَ (6) وَمَا يَأْتِيهِمْ مِنْ نَبِيٍّ إِلَّا كَانُوا بِهِ يَسْتَهْزِئُونَ (7) فَأَهْلَكْنَا أَشَدَّ مِنْهُمْ بَطْشًا وَمَضَى مَثَلُ الْأَوَّلِينَ (8)","hl":[[0,49,1]]}},{"id":"ق-0121","fp":"f44f85de0319","stateId":632,"easy":"التكذيب بآيات الله (دأب آل فرعون) ← أخذ الله لهم بذنوبهم","cause":"التكذيب بآيات الله (دأب آل فرعون)","result":"أخذ الله لهم بذنوبهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["ق-0470","ق-0472","ق-0877"],"ref":"سورة آل عمران: 11","srcLabel":"القرآن الكريم","quran":{"s":3,"from":11,"to":11,"text":"كَدَأْبِ آلِ فِرْعَوْنَ وَالَّذِينَ مِنْ قَبْلِهِمْ كَذَّبُوا بِآيَاتِنَا فَأَخَذَهُمُ اللَّهُ بِذُنُوبِهِمْ وَاللَّهُ شَدِيدُ الْعِقَابِ (11)","hl":[[0,74,1],[74,108,2],[108,137,1]]}},{"id":"ق-0408","fp":"b8e05b02f1a7","stateId":632,"easy":"التكذيب بالآيات ← الإغراق","cause":"التكذيب بالآيات","result":"الإغراق","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["ق-0794","ق-0878"],"ref":"سورة الأعراف: 64","srcLabel":"القرآن الكريم","quran":{"s":7,"from":64,"to":64,"text":"فَكَذَّبُوهُ فَأَنْجَيْنَاهُ وَالَّذِينَ مَعَهُ فِي الْفُلْكِ وَأَغْرَقْنَا الَّذِينَ كَذَّبُوا بِآيَاتِنَا إِنَّهُمْ كَانُوا قَوْمًا عَمِينَ (64)","hl":[[62,75,2],[75,107,1]]}},{"id":"ق-0410","fp":"f80d72e43272","stateId":632,"easy":"التكذيب بالآيات (عاد) ← قطع الدابر، ونجاة المؤمنين برحمة الله","cause":"التكذيب بالآيات (عاد)","result":"قطع الدابر، ونجاة المؤمنين برحمة الله","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["ق-0892"],"otherNeedIds":[4],"ref":"سورة الأعراف: 72","srcLabel":"القرآن الكريم","quran":{"s":7,"from":72,"to":72,"text":"فَأَنْجَيْنَاهُ وَالَّذِينَ مَعَهُ بِرَحْمَةٍ مِنَّا وَقَطَعْنَا دَابِرَ الَّذِينَ كَذَّبُوا بِآيَاتِنَا وَمَا كَانُوا مُؤْمِنِينَ (72)","hl":[[0,72,2],[72,130,1]]}},{"id":"ق-0411","fp":"9d8ecada77f1","stateId":632,"easy":"العتوّ عن أمر الله وعقر الناقة (ثمود) ← الرجفة","cause":"العتوّ عن أمر الله وعقر الناقة (ثمود)","result":"الرجفة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["ق-0893","ق-1280","ق-1440"],"ref":"سورة الأعراف: 77–78","srcLabel":"القرآن الكريم","quran":{"s":7,"from":77,"to":78,"text":"فَعَقَرُوا النَّاقَةَ وَعَتَوْا عَنْ أَمْرِ رَبِّهِمْ وَقَالُوا يَا صَالِحُ ائْتِنَا بِمَا تَعِدُنَا إِنْ كُنْتَ مِنَ الْمُرْسَلِينَ (77) فَأَخَذَتْهُمُ الرَّجْفَةُ فَأَصْبَحُوا فِي دَارِهِمْ جَاثِمِينَ (78)","hl":[[0,138,1],[138,202,2]]}},{"id":"ق-0412","fp":"8f4371ade092","stateId":632,"easy":"الفاحشة والإجرام (قوم لوط) ← مطر السوء وسوء العاقبة","cause":"الفاحشة والإجرام (قوم لوط)","result":"مطر السوء وسوء العاقبة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0590","ref":"سورة الأعراف: 84","quran":{"s":7,"from":84,"to":84,"text":"وَأَمْطَرْنَا عَلَيْهِمْ مَطَرًا فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُجْرِمِينَ (84)","hl":[[0,65,2],[65,80,1]]}},{"id":"ق-0414","fp":"291799ddf90b","stateId":632,"easy":"تكذيب شعيب ← الرجفة والخسران","cause":"تكذيب شعيب","result":"الرجفة والخسران","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["ق-0945"],"otherNeedIds":[57],"ref":"سورة الأعراف: 90–92","srcLabel":"القرآن الكريم","quran":{"s":7,"from":90,"to":92,"text":"وَقَالَ الْمَلَأُ الَّذِينَ كَفَرُوا مِنْ قَوْمِهِ لَئِنِ اتَّبَعْتُمْ شُعَيْبًا إِنَّكُمْ إِذًا لَخَاسِرُونَ (90) فَأَخَذَتْهُمُ الرَّجْفَةُ فَأَصْبَحُوا فِي دَارِهِمْ جَاثِمِينَ (91) الَّذِينَ كَذَّبُوا شُعَيْبًا كَأَنْ لَمْ يَغْنَوْا فِيهَا الَّذِينَ كَذَّبُوا شُعَيْبًا كَانُوا هُمُ الْخَاسِرِينَ (92)","hl":[[0,115,1],[115,179,2],[179,274,1],[274,300,2]]}},{"id":"ق-0421","fp":"0719a35f063e","stateId":632,"easy":"الظلم بآيات الله (فرعون وملؤه) ← عاقبة المفسدين","cause":"الظلم بآيات الله (فرعون وملؤه)","result":"عاقبة المفسدين","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الأعراف: 103","srcLabel":"القرآن الكريم","quran":{"s":7,"from":103,"to":103,"text":"ثُمَّ بَعَثْنَا مِنْ بَعْدِهِمْ مُوسَى بِآيَاتِنَا إِلَى فِرْعَوْنَ وَمَلَئِهِ فَظَلَمُوا بِهَا فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُفْسِدِينَ (103)","hl":[[79,96,1],[96,143,2]]}},{"id":"ق-0424","fp":"2164617eab99","stateId":632,"easy":"نكث العهد والتكذيب بالآيات والغفلة عنها ← الانتقام والإغراق","cause":"نكث العهد والتكذيب بالآيات والغفلة عنها","result":"الانتقام والإغراق","explicit":true,"ref":"سورة الأعراف: 135–136","srcLabel":"القرآن الكريم","quran":{"s":7,"from":135,"to":136,"text":"فَلَمَّا كَشَفْنَا عَنْهُمُ الرِّجْزَ إِلَى أَجَلٍ هُمْ بَالِغُوهُ إِذَا هُمْ يَنْكُثُونَ (135) فَانْتَقَمْنَا مِنْهُمْ فَأَغْرَقْنَاهُمْ فِي الْيَمِّ بِأَنَّهُمْ كَذَّبُوا بِآيَاتِنَا وَكَانُوا عَنْهَا غَافِلِينَ (136)","hl":[[0,96,1],[96,150,2],[150,213,1]]}},{"id":"ق-0470","fp":"6a9ff2151cae","stateId":632,"easy":"الكفر بآيات الله ← أخذ الله بالذنوب","cause":"الكفر بآيات الله","result":"أخذ الله بالذنوب","explicit":true,"repOf":"ق-0121","ref":"سورة الأنفال: 52","quran":{"s":8,"from":52,"to":52,"text":"كَدَأْبِ آلِ فِرْعَوْنَ وَالَّذِينَ مِنْ قَبْلِهِمْ كَفَرُوا بِآيَاتِ اللَّهِ فَأَخَذَهُمُ اللَّهُ بِذُنُوبِهِمْ إِنَّ اللَّهَ قَوِيٌّ شَدِيدُ الْعِقَابِ (52)","hl":[[24,78,1],[78,112,2],[112,153,1]]}},{"id":"ق-0472","fp":"4bd2c8d40623","stateId":632,"easy":"التكذيب بآيات الله ← الإهلاك بالذنوب والإغراق","cause":"التكذيب بآيات الله","result":"الإهلاك بالذنوب والإغراق","explicit":true,"repOf":"ق-0121","ref":"سورة الأنفال: 54","quran":{"s":8,"from":54,"to":54,"text":"كَدَأْبِ آلِ فِرْعَوْنَ وَالَّذِينَ مِنْ قَبْلِهِمْ كَذَّبُوا بِآيَاتِ رَبِّهِمْ فَأَهْلَكْنَاهُمْ بِذُنُوبِهِمْ وَأَغْرَقْنَا آلَ فِرْعَوْنَ وَكُلٌّ كَانُوا ظَالِمِينَ (54)","hl":[[24,81,1],[81,141,2],[141,168,1]]}},{"id":"ق-0590","fp":"2b46569c2e1f","stateId":632,"easy":"الفاحشة والظلم (قوم لوط) ← قلب الديار وحجارة من سجيل","cause":"الفاحشة والظلم (قوم لوط)","result":"قلب الديار وحجارة من سجيل","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["ق-0412","ق-0658","ق-0894","ق-1259","ق-1281","ق-1365"],"ref":"سورة هود: 82–83","srcLabel":"القرآن الكريم","quran":{"s":11,"from":82,"to":83,"text":"فَلَمَّا جَاءَ أَمْرُنَا جَعَلْنَا عَالِيَهَا سَافِلَهَا وَأَمْطَرْنَا عَلَيْهَا حِجَارَةً مِنْ سِجِّيلٍ مَنْضُودٍ (82) مُسَوَّمَةً عِنْدَ رَبِّكَ وَمَا هِيَ مِنَ الظَّالِمِينَ بِبَعِيدٍ (83)","hl":[[0,25,1],[25,146,2],[146,186,1]]}},{"id":"ق-0658","fp":"8cbc54554d3f","stateId":632,"easy":"الفاحشة (قوم لوط) ← الصيحة وقلب الديار وحجارة من سجيل","cause":"الفاحشة (قوم لوط)","result":"الصيحة وقلب الديار وحجارة من سجيل","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0590","ref":"سورة الحجر: 73–74","quran":{"s":15,"from":73,"to":74,"text":"فَأَخَذَتْهُمُ الصَّيْحَةُ مُشْرِقِينَ (73) فَجَعَلْنَا عَالِيَهَا سَافِلَهَا وَأَمْطَرْنَا عَلَيْهِمْ حِجَارَةً مِنْ سِجِّيلٍ (74)","hl":[[0,126,1]]}},{"id":"ق-0659","fp":"831abf46914c","stateId":632,"easy":"الظلم (أصحاب الأيكة) ← انتقام الله","cause":"الظلم (أصحاب الأيكة)","result":"انتقام الله","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0895","ref":"سورة الحجر: 78–79","quran":{"s":15,"from":78,"to":79,"text":"وَإِنْ كَانَ أَصْحَابُ الْأَيْكَةِ لَظَالِمِينَ (78) فَانْتَقَمْنَا مِنْهُمْ وَإِنَّهُمَا لَبِإِمَامٍ مُبِينٍ (79)","hl":[[0,53,1],[53,76,2]]}},{"id":"ق-0660","fp":"da4dd3ecc1b7","stateId":632,"easy":"تكذيب المرسلين والإعراض عن الآيات (أصحاب الحجر) ← الصيحة ولم يغن عنهم كسبهم","cause":"تكذيب المرسلين والإعراض عن الآيات (أصحاب الحجر)","result":"الصيحة ولم يغن عنهم كسبهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الحجر: 80–84","srcLabel":"القرآن الكريم","quran":{"s":15,"from":80,"to":84,"text":"وَلَقَدْ كَذَّبَ أَصْحَابُ الْحِجْرِ الْمُرْسَلِينَ (80) وَآتَيْنَاهُمْ آيَاتِنَا فَكَانُوا عَنْهَا مُعْرِضِينَ (81) وَكَانُوا يَنْحِتُونَ مِنَ الْجِبَالِ بُيُوتًا آمِنِينَ (82) فَأَخَذَتْهُمُ الصَّيْحَةُ مُصْبِحِينَ (83) فَمَا أَغْنَى عَنْهُمْ مَا كَانُوا يَكْسِبُونَ (84)","hl":[[0,178,1],[178,268,2]]}},{"id":"ق-0722","fp":"d6a87d4cb79d","stateId":632,"easy":"إرادة استفزاز المؤمنين من الأرض (فرعون) ← الإغراق وإسكان المستضعفين الأرض","cause":"إرادة استفزاز المؤمنين من الأرض (فرعون)","result":"الإغراق وإسكان المستضعفين الأرض","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["ق-1261"],"otherNeedIds":[43],"ref":"سورة الإسراء: 103–104","srcLabel":"القرآن الكريم","quran":{"s":17,"from":103,"to":104,"text":"فَأَرَادَ أَنْ يَسْتَفِزَّهُمْ مِنَ الْأَرْضِ فَأَغْرَقْنَاهُ وَمَنْ مَعَهُ جَمِيعًا (103) وَقُلْنَا مِنْ بَعْدِهِ لِبَنِي إِسْرَائِيلَ اسْكُنُوا الْأَرْضَ فَإِذَا جَاءَ وَعْدُ الْآخِرَةِ جِئْنَا بِكُمْ لَفِيفًا (104)","hl":[[0,46,1],[46,155,2]]}},{"id":"ق-0794","fp":"d73d47cdf928","stateId":632,"easy":"التكذيب بآيات الله ← الإغراق","cause":"التكذيب بآيات الله","result":"الإغراق","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0408","ref":"سورة الأنبياء: 77","quran":{"s":21,"from":77,"to":77,"text":"وَنَصَرْنَاهُ مِنَ الْقَوْمِ الَّذِينَ كَذَّبُوا بِآيَاتِنَا إِنَّهُمْ كَانُوا قَوْمَ سَوْءٍ فَأَغْرَقْنَاهُمْ أَجْمَعِينَ (77)","hl":[[61,93,1],[93,122,2]]}},{"id":"ق-0834","fp":"ea4976e36e17","stateId":632,"easy":"التكذيب والظلم ← الصيحة بالحق وجعلهم غثاءً","cause":"التكذيب والظلم","result":"الصيحة بالحق وجعلهم غثاءً","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة المؤمنون: 39–41","srcLabel":"القرآن الكريم","quran":{"s":23,"from":39,"to":41,"text":"قَالَ رَبِّ انْصُرْنِي بِمَا كَذَّبُونِ (39) قَالَ عَمَّا قَلِيلٍ لَيُصْبِحُنَّ نَادِمِينَ (40) فَأَخَذَتْهُمُ الصَّيْحَةُ بِالْحَقِّ فَجَعَلْنَاهُمْ غُثَاءً فَبُعْدًا لِلْقَوْمِ الظَّالِمِينَ (41)","hl":[[0,96,1],[96,167,2],[167,192,1]]}},{"id":"ق-0877","fp":"da688e6f1858","stateId":632,"easy":"التكذيب بآيات الله ← التدمير","cause":"التكذيب بآيات الله","result":"التدمير","explicit":true,"repOf":"ق-0121","ref":"سورة الفرقان: 36","quran":{"s":25,"from":36,"to":36,"text":"فَقُلْنَا اذْهَبَا إِلَى الْقَوْمِ الَّذِينَ كَذَّبُوا بِآيَاتِنَا فَدَمَّرْنَاهُمْ تَدْمِيرًا (36)","hl":[[19,67,1],[67,94,2]]}},{"id":"ق-0878","fp":"1b9c51e59a30","stateId":632,"easy":"تكذيب الرسل (قوم نوح) ← الإغراق وعذاب أليم","cause":"تكذيب الرسل (قوم نوح)","result":"الإغراق وعذاب أليم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0408","otherNeedIds":[69],"ref":"سورة الفرقان: 37","quran":{"s":25,"from":37,"to":37,"text":"وَقَوْمَ نُوحٍ لَمَّا كَذَّبُوا الرُّسُلَ أَغْرَقْنَاهُمْ وَجَعَلْنَاهُمْ لِلنَّاسِ آيَةً وَأَعْتَدْنَا لِلظَّالِمِينَ عَذَابًا أَلِيمًا (37)","hl":[[0,42,1],[42,136,2]]}},{"id":"ق-0879","fp":"eb98c668fee3","stateId":632,"easy":"تكذيب الرسل (عاد وثمود وأصحاب الرس) ← التتبير","cause":"تكذيب الرسل (عاد وثمود وأصحاب الرس)","result":"التتبير","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الفرقان: 38–39","srcLabel":"القرآن الكريم","quran":{"s":25,"from":38,"to":39,"text":"وَعَادًا وَثَمُودَ وَأَصْحَابَ الرَّسِّ وَقُرُونًا بَيْنَ ذَلِكَ كَثِيرًا (38) وَكُلًّا ضَرَبْنَا لَهُ الْأَمْثَالَ وَكُلًّا تَبَّرْنَا تَتْبِيرًا (39)","hl":[[0,116,1],[116,146,2]]}},{"id":"ق-0892","fp":"99ab78d4cf69","stateId":632,"easy":"التكذيب (عاد) ← الإهلاك","cause":"التكذيب (عاد)","result":"الإهلاك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0410","ref":"سورة الشعراء: 139","quran":{"s":26,"from":139,"to":139,"text":"فَكَذَّبُوهُ فَأَهْلَكْنَاهُمْ إِنَّ فِي ذَلِكَ لَآيَةً وَمَا كَانَ أَكْثَرُهُمْ مُؤْمِنِينَ (139)","hl":[[0,13,1],[13,30,2],[30,92,1]]}},{"id":"ق-0893","fp":"af4a0d537748","stateId":632,"easy":"عقر الناقة (ثمود) ← الندم وأخذ العذاب","cause":"عقر الناقة (ثمود)","result":"الندم وأخذ العذاب","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0411","ref":"سورة الشعراء: 157–158","quran":{"s":26,"from":157,"to":158,"text":"فَعَقَرُوهَا فَأَصْبَحُوا نَادِمِينَ (157) فَأَخَذَهُمُ الْعَذَابُ إِنَّ فِي ذَلِكَ لَآيَةً وَمَا كَانَ أَكْثَرُهُمْ مُؤْمِنِينَ (158)","hl":[[0,13,1],[13,66,2]]}},{"id":"ق-0894","fp":"7750f9449bc2","stateId":632,"easy":"عمل الفاحشة (قوم لوط) ← تدميرهم ومطر السوء ونجاة لوط وأهله","cause":"عمل الفاحشة (قوم لوط)","result":"تدميرهم ومطر السوء ونجاة لوط وأهله","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0590","otherNeedIds":[4],"ref":"سورة الشعراء: 169–173","quran":{"s":26,"from":169,"to":173,"text":"رَبِّ نَجِّنِي وَأَهْلِي مِمَّا يَعْمَلُونَ (169) فَنَجَّيْنَاهُ وَأَهْلَهُ أَجْمَعِينَ (170) إِلَّا عَجُوزًا فِي الْغَابِرِينَ (171) ثُمَّ دَمَّرْنَا الْآخَرِينَ (172) وَأَمْطَرْنَا عَلَيْهِمْ مَطَرًا فَسَاءَ مَطَرُ الْمُنْذَرِينَ (173)","hl":[[0,50,1],[50,231,2]]}},{"id":"ق-0895","fp":"f18871ec18f7","stateId":632,"easy":"التكذيب وبخس الكيل (أصحاب الأيكة) ← عذاب يوم الظلة","cause":"التكذيب وبخس الكيل (أصحاب الأيكة)","result":"عذاب يوم الظلة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["ق-0659"],"ref":"سورة الشعراء: 189","srcLabel":"القرآن الكريم","quran":{"s":26,"from":189,"to":189,"text":"فَكَذَّبُوهُ فَأَخَذَهُمْ عَذَابُ يَوْمِ الظُّلَّةِ إِنَّهُ كَانَ عَذَابَ يَوْمٍ عَظِيمٍ (189)","hl":[[0,13,1],[13,88,2]]}},{"id":"ق-0945","fp":"6c631c15cf96","stateId":632,"easy":"تكذيب شعيب ← الرجفة","cause":"تكذيب شعيب","result":"الرجفة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0414","ref":"سورة العنكبوت: 37","quran":{"s":29,"from":37,"to":37,"text":"فَكَذَّبُوهُ فَأَخَذَتْهُمُ الرَّجْفَةُ فَأَصْبَحُوا فِي دَارِهِمْ جَاثِمِينَ (37)","hl":[[0,13,1],[13,77,2]]}},{"id":"ق-1037","fp":"815a4029cea9","stateId":632,"easy":"تكذيب المرسلين (أصحاب القرية) ← صيحة واحدة فإذا هم خامدون","cause":"تكذيب المرسلين (أصحاب القرية)","result":"صيحة واحدة فإذا هم خامدون","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة يس: 28–29","srcLabel":"القرآن الكريم","quran":{"s":36,"from":28,"to":29,"text":"وَمَا أَنْزَلْنَا عَلَى قَوْمِهِ مِنْ بَعْدِهِ مِنْ جُنْدٍ مِنَ السَّمَاءِ وَمَا كُنَّا مُنْزِلِينَ (28) إِنْ كَانَتْ إِلَّا صَيْحَةً وَاحِدَةً فَإِذَا هُمْ خَامِدُونَ (29)","hl":[[0,105,1],[105,167,2]]}},{"id":"ق-1058","fp":"c1d1958e7911","stateId":632,"easy":"تكذيب الرسل ← حقّ العقاب","cause":"تكذيب الرسل","result":"حقّ العقاب","explicit":true,"similar":["ق-1254"],"ref":"سورة ص: 12–14","srcLabel":"القرآن الكريم","quran":{"s":38,"from":12,"to":14,"text":"كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ وَعَادٌ وَفِرْعَوْنُ ذُو الْأَوْتَادِ (12) وَثَمُودُ وَقَوْمُ لُوطٍ وَأَصْحَابُ الْأَيْكَةِ أُولَئِكَ الْأَحْزَابُ (13) إِنْ كُلٌّ إِلَّا كَذَّبَ الرُّسُلَ فَحَقَّ عِقَابِ (14)","hl":[[0,190,1],[190,205,2]]}},{"id":"ق-1129","fp":"7ccc96013b8d","stateId":632,"easy":"الاستكبار في الأرض بغير الحق وجحود الآيات (عاد) ← ريح صرصر وعذاب الخزي في الدنيا وعذاب الآخرة أخزى","cause":"الاستكبار في الأرض بغير الحق وجحود الآيات (عاد)","result":"ريح صرصر وعذاب الخزي في الدنيا وعذاب الآخرة أخزى","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["ق-1198","ق-1262","ق-1279"],"otherNeedIds":[60],"ref":"سورة فصلت: 15–16","srcLabel":"القرآن الكريم","quran":{"s":41,"from":15,"to":16,"text":"فَأَمَّا عَادٌ فَاسْتَكْبَرُوا فِي الْأَرْضِ بِغَيْرِ الْحَقِّ وَقَالُوا مَنْ أَشَدُّ مِنَّا قُوَّةً أَوَلَمْ يَرَوْا أَنَّ اللَّهَ الَّذِي خَلَقَهُمْ هُوَ أَشَدُّ مِنْهُمْ قُوَّةً وَكَانُوا بِآيَاتِنَا يَجْحَدُونَ (15) فَأَرْسَلْنَا عَلَيْهِمْ رِيحًا صَرْصَرًا فِي أَيَّامٍ نَحِسَاتٍ لِنُذِيقَهُمْ عَذَابَ الْخِزْيِ فِي الْحَيَاةِ الدُّنْيَا وَلَعَذَابُ الْآخِرَةِ أَخْزَى وَهُمْ لَا يُنْصَرُونَ (16)","hl":[[0,220,1],[220,396,2]]}},{"id":"ق-1130","fp":"b8078d034a45","stateId":632,"easy":"استحباب العمى على الهدى (ثمود) ← صاعقة العذاب الهُون","cause":"استحباب العمى على الهدى (ثمود)","result":"صاعقة العذاب الهُون","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-1263","ref":"سورة فصلت: 17","quran":{"s":41,"from":17,"to":17,"text":"وَأَمَّا ثَمُودُ فَهَدَيْنَاهُمْ فَاسْتَحَبُّوا الْعَمَى عَلَى الْهُدَى فَأَخَذَتْهُمْ صَاعِقَةُ الْعَذَابِ الْهُونِ بِمَا كَانُوا يَكْسِبُونَ (17)","hl":[[0,72,1],[72,116,2],[116,142,1]]}},{"id":"ق-1198","fp":"e9891aed6d1d","stateId":632,"easy":"التكذيب واستعجال العذاب (عاد) ← ريح تدمّر كل شيء","cause":"التكذيب واستعجال العذاب (عاد)","result":"ريح تدمّر كل شيء","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-1129","ref":"سورة الأحقاف: 25","quran":{"s":46,"from":25,"to":25,"text":"تُدَمِّرُ كُلَّ شَيْءٍ بِأَمْرِ رَبِّهَا فَأَصْبَحُوا لَا يُرَى إِلَّا مَسَاكِنُهُمْ كَذَلِكَ نَجْزِي الْقَوْمَ الْمُجْرِمِينَ (25)","hl":[[0,84,2],[84,126,1]]}},{"id":"ق-1254","fp":"754ca8f89184","stateId":632,"easy":"تكذيب الرسل ← حقّ الوعيد","cause":"تكذيب الرسل","result":"حقّ الوعيد","explicit":true,"repOf":"ق-1058","ref":"سورة ق: 12–14","quran":{"s":50,"from":12,"to":14,"text":"كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ وَأَصْحَابُ الرَّسِّ وَثَمُودُ (12) وَعَادٌ وَفِرْعَوْنُ وَإِخْوَانُ لُوطٍ (13) وَأَصْحَابُ الْأَيْكَةِ وَقَوْمُ تُبَّعٍ كُلٌّ كَذَّبَ الرُّسُلَ فَحَقَّ وَعِيدِ (14)","hl":[[0,179,1],[179,194,2]]}},{"id":"ق-1259","fp":"0497d172f019","stateId":632,"easy":"الإجرام والإسراف (قوم لوط) ← حجارة من طين","cause":"الإجرام والإسراف (قوم لوط)","result":"حجارة من طين","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0590","ref":"سورة الذاريات: 32–34","quran":{"s":51,"from":32,"to":34,"text":"قَالُوا إِنَّا أُرْسِلْنَا إِلَى قَوْمٍ مُجْرِمِينَ (32) لِنُرْسِلَ عَلَيْهِمْ حِجَارَةً مِنْ طِينٍ (33) مُسَوَّمَةً عِنْدَ رَبِّكَ لِلْمُسْرِفِينَ (34)","hl":[[0,57,1],[57,131,2],[131,147,1]]}},{"id":"ق-1261","fp":"4cdfca7b1072","stateId":632,"easy":"التولي والتكذيب (فرعون) ← النبذ في اليمّ","cause":"التولي والتكذيب (فرعون)","result":"النبذ في اليمّ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0722","ref":"سورة الذاريات: 39–40","quran":{"s":51,"from":39,"to":40,"text":"فَتَوَلَّى بِرُكْنِهِ وَقَالَ سَاحِرٌ أَوْ مَجْنُونٌ (39) فَأَخَذْنَاهُ وَجُنُودَهُ فَنَبَذْنَاهُمْ فِي الْيَمِّ وَهُوَ مُلِيمٌ (40)","hl":[[0,58,1],[58,112,2],[112,127,1]]}},{"id":"ق-1262","fp":"5d954eaafeca","stateId":632,"easy":"الكفر (عاد) ← الريح العقيم","cause":"الكفر (عاد)","result":"الريح العقيم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-1129","ref":"سورة الذاريات: 41–42","quran":{"s":51,"from":41,"to":42,"text":"وَفِي عَادٍ إِذْ أَرْسَلْنَا عَلَيْهِمُ الرِّيحَ الْعَقِيمَ (41) مَا تَذَرُ مِنْ شَيْءٍ أَتَتْ عَلَيْهِ إِلَّا جَعَلَتْهُ كَالرَّمِيمِ (42)","hl":[[0,12,1],[12,134,2]]}},{"id":"ق-1263","fp":"62473462bd7f","stateId":632,"easy":"العتوّ عن أمر الله (ثمود) ← الصاعقة","cause":"العتوّ عن أمر الله (ثمود)","result":"الصاعقة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["ق-1130"],"ref":"سورة الذاريات: 44–45","srcLabel":"القرآن الكريم","quran":{"s":51,"from":44,"to":45,"text":"فَعَتَوْا عَنْ أَمْرِ رَبِّهِمْ فَأَخَذَتْهُمُ الصَّاعِقَةُ وَهُمْ يَنْظُرُونَ (44) فَمَا اسْتَطَاعُوا مِنْ قِيَامٍ وَمَا كَانُوا مُنْتَصِرِينَ (45)","hl":[[0,32,1],[32,143,2]]}},{"id":"ق-1276","fp":"36e3fc749173","stateId":632,"easy":"الظلم والطغيان ← الإهلاك","cause":"الظلم والطغيان","result":"الإهلاك","explicit":true,"ref":"سورة النجم: 50–53","srcLabel":"القرآن الكريم","quran":{"s":53,"from":50,"to":53,"text":"وَأَنَّهُ أَهْلَكَ عَادًا الْأُولَى (50) وَثَمُودَ فَمَا أَبْقَى (51) وَقَوْمَ نُوحٍ مِنْ قَبْلُ إِنَّهُمْ كَانُوا هُمْ أَظْلَمَ وَأَطْغَى (52) وَالْمُؤْتَفِكَةَ أَهْوَى (53)","hl":[[0,96,2],[96,144,1],[144,169,2]]}},{"id":"ق-1279","fp":"374b06f048bf","stateId":632,"easy":"التكذيب (عاد) ← ريح صرصر في يوم نحس","cause":"التكذيب (عاد)","result":"ريح صرصر في يوم نحس","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-1129","ref":"سورة القمر: 18–20","quran":{"s":54,"from":18,"to":20,"text":"كَذَّبَتْ عَادٌ فَكَيْفَ كَانَ عَذَابِي وَنُذُرِ (18) إِنَّا أَرْسَلْنَا عَلَيْهِمْ رِيحًا صَرْصَرًا فِي يَوْمِ نَحْسٍ مُسْتَمِرٍّ (19) تَنْزِعُ النَّاسَ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ مُنْقَعِرٍ (20)","hl":[[0,54,1],[54,193,2]]}},{"id":"ق-1280","fp":"a040fb875949","stateId":632,"easy":"تكذيب النذر وعقر الناقة (ثمود) ← صيحة واحدة فكانوا كهشيم المحتظر","cause":"تكذيب النذر وعقر الناقة (ثمود)","result":"صيحة واحدة فكانوا كهشيم المحتظر","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0411","ref":"سورة القمر: 23–31","quran":{"s":54,"from":23,"to":31,"text":"كَذَّبَتْ ثَمُودُ بِالنُّذُرِ (23) فَقَالُوا أَبَشَرًا مِنَّا وَاحِدًا نَتَّبِعُهُ إِنَّا إِذًا لَفِي ضَلَالٍ وَسُعُرٍ (24) أَأُلْقِيَ الذِّكْرُ عَلَيْهِ مِنْ بَيْنِنَا بَلْ هُوَ كَذَّابٌ أَشِرٌ (25) سَيَعْلَمُونَ غَدًا مَنِ الْكَذَّابُ الْأَشِرُ (26) إِنَّا مُرْسِلُو النَّاقَةِ فِتْنَةً لَهُمْ فَارْتَقِبْهُمْ وَاصْطَبِرْ (27) وَنَبِّئْهُمْ أَنَّ الْمَاءَ قِسْمَةٌ بَيْنَهُمْ كُلُّ شِرْبٍ مُحْتَضَرٌ (28) فَنَادَوْا صَاحِبَهُمْ فَتَعَاطَى فَعَقَرَ (29) فَكَيْفَ كَانَ عَذَابِي وَنُذُرِ (30) إِنَّا أَرْسَلْنَا عَلَيْهِمْ صَيْحَةً وَاحِدَةً فَكَانُوا كَهَشِيمِ الْمُحْتَظِرِ (31)","hl":[[0,493,1],[493,575,2]]}},{"id":"ق-1281","fp":"bb9ffbed80a4","stateId":632,"easy":"التكذيب بالنذر (قوم لوط) ← الحاصب","cause":"التكذيب بالنذر (قوم لوط)","result":"الحاصب","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0590","ref":"سورة القمر: 33–34","quran":{"s":54,"from":33,"to":34,"text":"كَذَّبَتْ قَوْمُ لُوطٍ بِالنُّذُرِ (33) إِنَّا أَرْسَلْنَا عَلَيْهِمْ حَاصِبًا إِلَّا آلَ لُوطٍ نَجَّيْنَاهُمْ بِسَحَرٍ (34)","hl":[[0,40,1],[40,78,2]]}},{"id":"ق-1283","fp":"17bdebab305a","stateId":632,"easy":"التكذيب بالآيات كلها (آل فرعون) ← أخذ عزيز مقتدر","cause":"التكذيب بالآيات كلها (آل فرعون)","result":"أخذ عزيز مقتدر","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة القمر: 42","srcLabel":"القرآن الكريم","quran":{"s":54,"from":42,"to":42,"text":"كَذَّبُوا بِآيَاتِنَا كُلِّهَا فَأَخَذْنَاهُمْ أَخْذَ عَزِيزٍ مُقْتَدِرٍ (42)","hl":[[0,31,1],[31,72,2]]}},{"id":"ق-1365","fp":"8cf26c1e8eef","stateId":632,"easy":"التكذيب ← الخسف أو الحاصب والنكير","cause":"التكذيب","result":"الخسف أو الحاصب والنكير","explicit":true,"repOf":"ق-0590","ref":"سورة الملك: 16–18","quran":{"s":67,"from":16,"to":18,"text":"أَأَمِنْتُمْ مَنْ فِي السَّمَاءِ أَنْ يَخْسِفَ بِكُمُ الْأَرْضَ فَإِذَا هِيَ تَمُورُ (16) أَمْ أَمِنْتُمْ مَنْ فِي السَّمَاءِ أَنْ يُرْسِلَ عَلَيْكُمْ حَاصِبًا فَسَتَعْلَمُونَ كَيْفَ نَذِيرِ (17) وَلَقَدْ كَذَّبَ الَّذِينَ مِنْ قَبْلِهِمْ فَكَيْفَ كَانَ نَكِيرِ (18)","hl":[[0,33,1],[33,190,2],[190,239,1],[239,261,2]]}},{"id":"ق-1372","fp":"9261a0bb491e","stateId":632,"easy":"التكذيب بالقارعة (ثمود وعاد) ← الإهلاك بالطاغية وبريح صرصر عاتية","cause":"التكذيب بالقارعة (ثمود وعاد)","result":"الإهلاك بالطاغية وبريح صرصر عاتية","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الحاقة: 4–6","srcLabel":"القرآن الكريم","quran":{"s":69,"from":4,"to":6,"text":"كَذَّبَتْ ثَمُودُ وَعَادٌ بِالْقَارِعَةِ (4) فَأَمَّا ثَمُودُ فَأُهْلِكُوا بِالطَّاغِيَةِ (5) وَأَمَّا عَادٌ فَأُهْلِكُوا بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ (6)","hl":[[0,45,1],[45,148,2]]}},{"id":"ق-1373","fp":"1cc4910e547f","stateId":632,"easy":"الخاطئة وعصيان رسول الله (فرعون ومن قبله والمؤتفكات) ← أخذة رابية","cause":"الخاطئة وعصيان رسول الله (فرعون ومن قبله والمؤتفكات)","result":"أخذة رابية","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["ق-1391"],"ref":"سورة الحاقة: 9–10","srcLabel":"القرآن الكريم","quran":{"s":69,"from":9,"to":10,"text":"وَجَاءَ فِرْعَوْنُ وَمَنْ قَبْلَهُ وَالْمُؤْتَفِكَاتُ بِالْخَاطِئَةِ (9) فَعَصَوْا رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةً رَابِيَةً (10)","hl":[[0,101,1],[101,132,2]]}},{"id":"ق-1391","fp":"7f1da43816f3","stateId":632,"easy":"عصيان الرسول (فرعون) ← أخذ وبيل","cause":"عصيان الرسول (فرعون)","result":"أخذ وبيل","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-1373","ref":"سورة المزمل: 15–16","quran":{"s":73,"from":15,"to":16,"text":"إِنَّا أَرْسَلْنَا إِلَيْكُمْ رَسُولًا شَاهِدًا عَلَيْكُمْ كَمَا أَرْسَلْنَا إِلَى فِرْعَوْنَ رَسُولًا (15) فَعَصَى فِرْعَوْنُ الرَّسُولَ فَأَخَذْنَاهُ أَخْذًا وَبِيلًا (16)","hl":[[108,138,1],[138,168,2]]}},{"id":"ق-1440","fp":"850965774d07","stateId":632,"easy":"الطغيان وتكذيب الرسول وعقر الناقة (ثمود) ← الدمدمة عليهم بذنبهم","cause":"الطغيان وتكذيب الرسول وعقر الناقة (ثمود)","result":"الدمدمة عليهم بذنبهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0411","ref":"سورة الشمس: 11–15","quran":{"s":91,"from":11,"to":15,"text":"كَذَّبَتْ ثَمُودُ بِطَغْوَاهَا (11) إِذِ انْبَعَثَ أَشْقَاهَا (12) فَقَالَ لَهُمْ رَسُولُ اللَّهِ نَاقَةَ اللَّهِ وَسُقْيَاهَا (13) فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُمْ بِذَنْبِهِمْ فَسَوَّاهَا (14) وَلَا يَخَافُ عُقْبَاهَا (15)","hl":[[0,158,1],[158,214,2],[214,244,1]]}},{"id":"س-07763","fp":"1953b25e04c6","stateId":632,"easy":"إذا عاند القوم الحق ← قد يصيبهم القحط (من واقعة)","cause":"دَعا عليهم بسِنينَ كَسِني يوسُفَ","result":"فأصابَهم قَحطٌ وجَهدٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح مسلم 2798","srcLabel":"البخاري","text":["جاءَ إلى عبدِ اللهِ رَجُلٌ فقال: تَرَكتُ في المَسجِدِ رَجُلًا يُفَسِّرُ القُرآنَ برَأيِه، يُفَسِّرُ هذه الآيةَ: {يَومَ تَأتي السَّماءُ بدُخانٍ مُبينٍ} قال: يَأتي النَّاسَ يَومَ القيامةِ دُخانٌ، فيَأخُذُ بأنفاسِهم حتَّى يَأخُذَهم منه كَهَيئةِ الزُّكامِ، فقال عبدُ اللهِ: مَن عَلِمَ عِلمًا فليَقُلْ به، ومَن لم يَعلَم فليَقُلْ: اللهُ أعلَمُ؛ فإنَّ مِن فِقهِ الرَّجُلِ أن يَقولَ لما لا عِلمَ له به: اللهُ أعلَمُ، إنَّما كان هذا أنَّ قُرَيشًا لَمَّا استَعصَت على النَّبيِّ صلَّى اللهُ عليه وسلَّم، ",["دَعا عليهم بسِنينَ كَسِني يوسُفَ",1],"، ",["فأصابَهم قَحطٌ وجَهدٌ",2],"، حتَّى جَعَلَ الرَّجُلُ يَنظُرُ إلى السَّماءِ فيَرى بينَه وبينَها كَهَيئةِ الدُّخانِ مِنَ الجَهدِ، وحتَّى أكَلوا العِظامَ، فأتى النَّبيَّ صلَّى اللهُ عليه وسلَّم رَجُلٌ فقال: يا رَسولَ اللهِ، استَغفِرِ اللهَ لمُضَرَ؛ فإنَّهم قد هَلَكوا، فقال: لمُضَرَ! إنَّكَ لَجَريءٌ، قال: فدَعا اللهَ لهم، فأنزَلَ اللهُ عَزَّ وجَلَّ: {إنَّا كاشِفو العَذابِ قَليلًا إنَّكُم عائِدونَ} قال: فمُطِروا، فلَمَّا أصابَتهُمُ الرَّفاهيةُ، قال: عادوا إلى ما كانوا عليه، قال: فأنزَلَ اللهُ عَزَّ وجَلَّ: {فارتَقِب يَومَ تَأتي السَّماءُ بدُخانٍ مُبينٍ يَغشى النَّاسَ هذا عَذابٌ أليمٌ} {يَومَ نَبطِشُ البَطشةَ الكُبرى إنَّا مُنتَقِمونَ} قال: يَعني يَومَ بَدرٍ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4774) باختلاف يسير","bab":"قرآن › أسباب النزول","dorar":"y1W3eAC3"},{"id":"س-07713","fp":"3e5e71a80f0f","stateId":632,"easy":"إذا كفرت بالله وعاندت ← قد تنزل عليك صاعقة (من واقعة)","cause":"هذا الَّذي تَدعوني إليهِ من ذَهَبٍ أو فضَّه أو نحاسٍ","result":"وأرسلَ اللَّهُ تبارَكَ وتعالى صاعقةً منَ السَّماءِ فأَهْلَكَتهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[22],"ref":"الصحيح المسند 91","srcLabel":"البيهقي","text":["أرسلَ رسولُ اللَّهِ - صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ - رجُلًا مِن أصحابِهِ إلى رأسِ المشرِكينَ يدعوهُ إلى اللَّهِ تعالى فقالَ المشرِكُ : ",["هذا الَّذي تَدعوني إليهِ من ذَهَبٍ أو فضَّه أو نحاسٍ",1]," فتَعاظمَ مقالتُهُ في صدرِ رسولِ رسولِ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ فرجعَ إلى رسولِ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ فأخبرَهُ فقالَ : ارجِع إليهِ فرجعَ إليهِ بمثلِ ذلِكَ ",["وأرسلَ اللَّهُ تبارَكَ وتعالى صاعقةً منَ السَّماءِ فأَهْلَكَتهُ",2]," ورسولُ رسولِ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ في الطريق فقال : لا يَدري فقالَ لَهُ النَّبيُّ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ : إنَّ اللَّهَ قد أَهْلَكَ صاحبَكَ بعدَكَ ونزلَت على رسولُ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ : وَيُرْسِلُ الصَّوَاعِقَ فَيُصِيبُ بِهَا مَنْ يَشَاءُ ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (692) واللفظ له، والبيهقي في ((الأسماء والصفات)) (605)","bab":"قرآن › أسباب النزول","dorar":"QbK1MxlL","merged":2,"otherRefs":["مجمع الزوائد 7/45 (صحيح)"]},{"id":"ق-0355","fp":"524772bf069e","stateId":633,"easy":"الظلم ← الهلاك","cause":"الظلم","result":"الهلاك","explicit":true,"repOf":"ق-0735","ref":"سورة الأنعام: 47","quran":{"s":6,"from":47,"to":47,"text":"قُلْ أَرَأَيْتَكُمْ إِنْ أَتَاكُمْ عَذَابُ اللَّهِ بَغْتَةً أَوْ جَهْرَةً هَلْ يُهْلَكُ إِلَّا الْقَوْمُ الظَّالِمُونَ (47)","hl":[[74,87,2],[87,118,1]]}},{"id":"ق-0384","fp":"a6046745a1e2","stateId":633,"easy":"الإجرام ← لا يُردّ بأس الله عنهم","cause":"الإجرام","result":"لا يُردّ بأس الله عنهم","explicit":true,"similar":["ق-0617"],"ref":"سورة الأنعام: 147","srcLabel":"القرآن الكريم","quran":{"s":6,"from":147,"to":147,"text":"فَإِنْ كَذَّبُوكَ فَقُلْ رَبُّكُمْ ذُو رَحْمَةٍ وَاسِعَةٍ وَلَا يُرَدُّ بَأْسُهُ عَنِ الْقَوْمِ الْمُجْرِمِينَ (147)","hl":[[58,80,2],[80,110,1]]}},{"id":"ق-0391","fp":"670fdddc2444","stateId":633,"easy":"الظلم ← الهلاك بياتاً أو قائلين","cause":"الظلم","result":"الهلاك بياتاً أو قائلين","explicit":true,"repOf":"ق-0735","ref":"سورة الأعراف: 4–5","quran":{"s":7,"from":4,"to":5,"text":"وَكَمْ مِنْ قَرْيَةٍ أَهْلَكْنَاهَا فَجَاءَهَا بَأْسُنَا بَيَاتًا أَوْ هُمْ قَائِلُونَ (4) فَمَا كَانَ دَعْوَاهُمْ إِذْ جَاءَهُمْ بَأْسُنَا إِلَّا أَنْ قَالُوا إِنَّا كُنَّا ظَالِمِينَ (5)","hl":[[0,86,2],[86,184,1]]}},{"id":"ق-0452","fp":"cf6a17acd528","stateId":633,"easy":"مشاقّة الله ورسوله ← شدة العقاب","cause":"مشاقّة الله ورسوله","result":"شدة العقاب","explicit":true,"similar":["ق-1317"],"otherNeedIds":[70],"ref":"سورة الأنفال: 13","srcLabel":"القرآن الكريم","quran":{"s":8,"from":13,"to":13,"text":"ذَلِكَ بِأَنَّهُمْ شَاقُّوا اللَّهَ وَرَسُولَهُ وَمَنْ يُشَاقِقِ اللَّهَ وَرَسُولَهُ فَإِنَّ اللَّهَ شَدِيدُ الْعِقَابِ (13)","hl":[[48,85,1],[85,119,2]]}},{"id":"ق-0504","fp":"a5c62bb6d75f","stateId":633,"easy":"النفاق ← التعذيب بالأموال والأولاد في الحياة الدنيا","cause":"النفاق","result":"التعذيب بالأموال والأولاد في الحياة الدنيا","explicit":true,"otherNeedIds":[3],"ref":"سورة التوبة: 55","srcLabel":"القرآن الكريم","quran":{"s":9,"from":55,"to":55,"text":"فَلَا تُعْجِبْكَ أَمْوَالُهُمْ وَلَا أَوْلَادُهُمْ إِنَّمَا يُرِيدُ اللَّهُ لِيُعَذِّبَهُمْ بِهَا فِي الْحَيَاةِ الدُّنْيَا وَتَزْهَقَ أَنْفُسُهُمْ وَهُمْ كَافِرُونَ (55)","hl":[[0,51,1],[51,147,2],[147,165,1]]}},{"id":"ق-0524","fp":"dc14bb7cd854","stateId":633,"easy":"عدّ النفقة مغرماً والتربص بالمؤمنين ← دائرة السوء عليهم","cause":"عدّ النفقة مغرماً والتربص بالمؤمنين","result":"دائرة السوء عليهم","explicit":true,"ref":"سورة التوبة: 98","srcLabel":"القرآن الكريم","quran":{"s":9,"from":98,"to":98,"text":"وَمِنَ الْأَعْرَابِ مَنْ يَتَّخِذُ مَا يُنْفِقُ مَغْرَمًا وَيَتَرَبَّصُ بِكُمُ الدَّوَائِرَ عَلَيْهِمْ دَائِرَةُ السَّوْءِ وَاللَّهُ سَمِيعٌ عَلِيمٌ (98)","hl":[[0,92,1],[92,122,2]]}},{"id":"ق-0589","fp":"7f17233b13df","stateId":633,"easy":"الظلم ← الصيحة","cause":"الظلم","result":"الصيحة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0735","ref":"سورة هود: 67","quran":{"s":11,"from":67,"to":67,"text":"وَأَخَذَ الَّذِينَ ظَلَمُوا الصَّيْحَةُ فَأَصْبَحُوا فِي دِيَارِهِمْ جَاثِمِينَ (67)","hl":[[0,8,2],[8,28,1],[28,79,2]]}},{"id":"ق-0596","fp":"48f0898c1226","stateId":633,"easy":"الظلم ← الصيحة","cause":"الظلم","result":"الصيحة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0735","ref":"سورة هود: 94","quran":{"s":11,"from":94,"to":94,"text":"وَلَمَّا جَاءَ أَمْرُنَا نَجَّيْنَا شُعَيْبًا وَالَّذِينَ آمَنُوا مَعَهُ بِرَحْمَةٍ مِنَّا وَأَخَذَتِ الَّذِينَ ظَلَمُوا الصَّيْحَةُ فَأَصْبَحُوا فِي دِيَارِهِمْ جَاثِمِينَ (94)","hl":[[91,101,2],[101,121,1],[121,172,2]]}},{"id":"ق-0597","fp":"d5f3008600b7","stateId":633,"easy":"ظلم القرى ← الأخذ الأليم الشديد","cause":"ظلم القرى","result":"الأخذ الأليم الشديد","explicit":true,"repOf":"ق-0735","ref":"سورة هود: 102","quran":{"s":11,"from":102,"to":102,"text":"وَكَذَلِكَ أَخْذُ رَبِّكَ إِذَا أَخَذَ الْقُرَى وَهِيَ ظَالِمَةٌ إِنَّ أَخْذَهُ أَلِيمٌ شَدِيدٌ (102)","hl":[[0,47,2],[47,65,1],[65,95,2]]}},{"id":"ق-0602","fp":"374f21632298","stateId":633,"easy":"اتباع الترف ← الإجرام والهلاك","cause":"اتباع الترف","result":"الإجرام والهلاك","explicit":true,"ref":"سورة هود: 116","srcLabel":"القرآن الكريم","quran":{"s":11,"from":116,"to":116,"text":"فَلَوْلَا كَانَ مِنَ الْقُرُونِ مِنْ قَبْلِكُمْ أُولُو بَقِيَّةٍ يَنْهَوْنَ عَنِ الْفَسَادِ فِي الْأَرْضِ إِلَّا قَلِيلًا مِمَّنْ أَنْجَيْنَا مِنْهُمْ وَاتَّبَعَ الَّذِينَ ظَلَمُوا مَا أُتْرِفُوا فِيهِ وَكَانُوا مُجْرِمِينَ (116)","hl":[[151,202,1],[202,223,2]]}},{"id":"ق-0617","fp":"ef6d35b6bed2","stateId":633,"easy":"الإجرام ← لا يُردّ بأس الله عنهم","cause":"الإجرام","result":"لا يُردّ بأس الله عنهم","explicit":true,"repOf":"ق-0384","ref":"سورة يوسف: 110","quran":{"s":12,"from":110,"to":110,"text":"حَتَّى إِذَا اسْتَيْأَسَ الرُّسُلُ وَظَنُّوا أَنَّهُمْ قَدْ كُذِبُوا جَاءَهُمْ نَصْرُنَا فَنُجِّيَ مَنْ نَشَاءُ وَلَا يُرَدُّ بَأْسُنَا عَنِ الْقَوْمِ الْمُجْرِمِينَ (110)","hl":[[112,135,2],[135,165,1]]}},{"id":"ق-0630","fp":"7e02a7cfb5f4","stateId":633,"easy":"الكفر وسوء الصنيع ← قوارع تصيبهم أو تحلّ قريباً من دارهم","cause":"الكفر وسوء الصنيع","result":"قوارع تصيبهم أو تحلّ قريباً من دارهم","explicit":true,"ref":"سورة الرعد: 31","srcLabel":"القرآن الكريم","quran":{"s":13,"from":31,"to":31,"text":"وَلَوْ أَنَّ قُرْآنًا سُيِّرَتْ بِهِ الْجِبَالُ أَوْ قُطِّعَتْ بِهِ الْأَرْضُ أَوْ كُلِّمَ بِهِ الْمَوْتَى بَلْ لِلَّهِ الْأَمْرُ جَمِيعًا أَفَلَمْ يَيْأَسِ الَّذِينَ آمَنُوا أَنْ لَوْ يَشَاءُ اللَّهُ لَهَدَى النَّاسَ جَمِيعًا وَلَا يَزَالُ الَّذِينَ كَفَرُوا تُصِيبُهُمْ بِمَا صَنَعُوا قَارِعَةٌ أَوْ تَحُلُّ قَرِيبًا مِنْ دَارِهِمْ حَتَّى يَأْتِيَ وَعْدُ اللَّهِ إِنَّ اللَّهَ لَا يُخْلِفُ الْمِيعَادَ (31)","hl":[[227,260,1],[260,271,2],[271,287,1],[287,333,2]]}},{"id":"ق-0670","fp":"b387494f7252","stateId":633,"easy":"الظلم والاستهزاء بالحق ← إصابة سيئات ما عملوا وحاق بهم ما استهزؤوا به","cause":"الظلم والاستهزاء بالحق","result":"إصابة سيئات ما عملوا وحاق بهم ما استهزؤوا به","explicit":true,"ref":"سورة النحل: 33–34","srcLabel":"القرآن الكريم","quran":{"s":16,"from":33,"to":34,"text":"هَلْ يَنْظُرُونَ إِلَّا أَنْ تَأْتِيَهُمُ الْمَلَائِكَةُ أَوْ يَأْتِيَ أَمْرُ رَبِّكَ كَذَلِكَ فَعَلَ الَّذِينَ مِنْ قَبْلِهِمْ وَمَا ظَلَمَهُمُ اللَّهُ وَلَكِنْ كَانُوا أَنْفُسَهُمْ يَظْلِمُونَ (33) فَأَصَابَهُمْ سَيِّئَاتُ مَا عَمِلُوا وَحَاقَ بِهِمْ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ (34)","hl":[[86,200,1],[200,285,2]]}},{"id":"ق-0700","fp":"78db36aa5f97","stateId":633,"easy":"فسق المترفين ← حقّ القول وتدمير القرية","cause":"فسق المترفين","result":"حقّ القول وتدمير القرية","explicit":true,"repOf":"ق-1203","ref":"سورة الإسراء: 16","quran":{"s":17,"from":16,"to":16,"text":"وَإِذَا أَرَدْنَا أَنْ نُهْلِكَ قَرْيَةً أَمَرْنَا مُتْرَفِيهَا فَفَسَقُوا فِيهَا فَحَقَّ عَلَيْهَا الْقَوْلُ فَدَمَّرْنَاهَا تَدْمِيرًا (16)","hl":[[0,82,1],[82,136,2]]}},{"id":"ق-0735","fp":"a3b5eb8a6c1e","stateId":633,"easy":"الظلم ← إهلاك القرى بموعد","cause":"الظلم","result":"إهلاك القرى بموعد","explicit":true,"similar":["ق-0355","ق-0391","ق-0589","ق-0596","ق-0597","ق-0785","ق-0819","ق-0923","ق-0938"],"ref":"سورة الكهف: 59","srcLabel":"القرآن الكريم","quran":{"s":18,"from":59,"to":59,"text":"وَتِلْكَ الْقُرَى أَهْلَكْنَاهُمْ لَمَّا ظَلَمُوا وَجَعَلْنَا لِمَهْلِكِهِمْ مَوْعِدًا (59)","hl":[[0,33,2],[33,50,1],[50,86,2]]}},{"id":"ق-0785","fp":"45ea78e04b55","stateId":633,"easy":"الظلم ← قصم القرى وجعلها حصيداً خامدين","cause":"الظلم","result":"قصم القرى وجعلها حصيداً خامدين","explicit":true,"repOf":"ق-0735","ref":"سورة الأنبياء: 11–15","quran":{"s":21,"from":11,"to":15,"text":"وَكَمْ قَصَمْنَا مِنْ قَرْيَةٍ كَانَتْ ظَالِمَةً وَأَنْشَأْنَا بَعْدَهَا قَوْمًا آخَرِينَ (11) فَلَمَّا أَحَسُّوا بَأْسَنَا إِذَا هُمْ مِنْهَا يَرْكُضُونَ (12) لَا تَرْكُضُوا وَارْجِعُوا إِلَى مَا أُتْرِفْتُمْ فِيهِ وَمَسَاكِنِكُمْ لَعَلَّكُمْ تُسْأَلُونَ (13) قَالُوا يَا وَيْلَنَا إِنَّا كُنَّا ظَالِمِينَ (14) فَمَا زَالَتْ تِلْكَ دَعْوَاهُمْ حَتَّى جَعَلْنَاهُمْ حَصِيدًا خَامِدِينَ (15)","hl":[[0,30,2],[30,346,1],[346,386,2]]}},{"id":"ق-0819","fp":"6f0d36a4a8ac","stateId":633,"easy":"الظلم ← إهلاك القرى وخواء العروش","cause":"الظلم","result":"إهلاك القرى وخواء العروش","explicit":true,"repOf":"ق-0735","ref":"سورة الحج: 45","quran":{"s":22,"from":45,"to":45,"text":"فَكَأَيِّنْ مِنْ قَرْيَةٍ أَهْلَكْنَاهَا وَهِيَ ظَالِمَةٌ فَهِيَ خَاوِيَةٌ عَلَى عُرُوشِهَا وَبِئْرٍ مُعَطَّلَةٍ وَقَصْرٍ مَشِيدٍ (45)","hl":[[0,40,2],[40,58,1],[58,129,2]]}},{"id":"ق-0900","fp":"62281f380feb","stateId":633,"easy":"جحود الآيات ظلماً وعلواً ← عاقبة المفسدين","cause":"جحود الآيات ظلماً وعلواً","result":"عاقبة المفسدين","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة النمل: 14","srcLabel":"القرآن الكريم","quran":{"s":27,"from":14,"to":14,"text":"وَجَحَدُوا بِهَا وَاسْتَيْقَنَتْهَا أَنْفُسُهُمْ ظُلْمًا وَعُلُوًّا فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُفْسِدِينَ (14)","hl":[[0,68,1],[68,115,2]]}},{"id":"ق-0906","fp":"1addddcbf3a1","stateId":633,"easy":"الإجرام ← سوء العاقبة","cause":"الإجرام","result":"سوء العاقبة","explicit":true,"repOf":"ق-1179","ref":"سورة النمل: 69","quran":{"s":27,"from":69,"to":69,"text":"قُلْ سِيرُوا فِي الْأَرْضِ فَانْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الْمُجْرِمِينَ (69)","hl":[[0,27,1],[27,61,2],[61,76,1]]}},{"id":"ق-0911","fp":"8a21fe75694d","stateId":633,"easy":"العلوّ في الأرض وتفريق الناس واستضعافهم والإفساد ← الهلاك (عاقبة المفسدين)","cause":"العلوّ في الأرض وتفريق الناس واستضعافهم والإفساد","result":"الهلاك (عاقبة المفسدين)","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة القصص: 4","srcLabel":"القرآن الكريم","quran":{"s":28,"from":4,"to":4,"text":"إِنَّ فِرْعَوْنَ عَلَا فِي الْأَرْضِ وَجَعَلَ أَهْلَهَا شِيَعًا يَسْتَضْعِفُ طَائِفَةً مِنْهُمْ يُذَبِّحُ أَبْنَاءَهُمْ وَيَسْتَحْيِي نِسَاءَهُمْ إِنَّهُ كَانَ مِنَ الْمُفْسِدِينَ (4)","hl":[[0,179,1]]}},{"id":"ق-0919","fp":"f9c45946559e","stateId":633,"easy":"الاستكبار في الأرض بغير الحق وإنكار الرجوع إلى الله ← النبذ في اليم ولعنة في الدنيا ويوم القيامة من المقبوحين","cause":"الاستكبار في الأرض بغير الحق وإنكار الرجوع إلى الله","result":"النبذ في اليم ولعنة في الدنيا ويوم القيامة من المقبوحين","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[28],"ref":"سورة القصص: 39–42","srcLabel":"القرآن الكريم","quran":{"s":28,"from":39,"to":42,"text":"وَاسْتَكْبَرَ هُوَ وَجُنُودُهُ فِي الْأَرْضِ بِغَيْرِ الْحَقِّ وَظَنُّوا أَنَّهُمْ إِلَيْنَا لَا يُرْجَعُونَ (39) فَأَخَذْنَاهُ وَجُنُودَهُ فَنَبَذْنَاهُمْ فِي الْيَمِّ فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الظَّالِمِينَ (40) وَجَعَلْنَاهُمْ أَئِمَّةً يَدْعُونَ إِلَى النَّارِ وَيَوْمَ الْقِيَامَةِ لَا يُنْصَرُونَ (41) وَأَتْبَعْنَاهُمْ فِي هَذِهِ الدُّنْيَا لَعْنَةً وَيَوْمَ الْقِيَامَةِ هُمْ مِنَ الْمَقْبُوحِينَ (42)","hl":[[0,114,1],[114,411,2]]}},{"id":"ق-0923","fp":"7790bad8c03d","stateId":633,"easy":"بطر المعيشة والظلم ← إهلاك القرى","cause":"بطر المعيشة والظلم","result":"إهلاك القرى","explicit":true,"repOf":"ق-0735","otherNeedIds":[3],"ref":"سورة القصص: 58–59","quran":{"s":28,"from":58,"to":59,"text":"وَكَمْ أَهْلَكْنَا مِنْ قَرْيَةٍ بَطِرَتْ مَعِيشَتَهَا فَتِلْكَ مَسَاكِنُهُمْ لَمْ تُسْكَنْ مِنْ بَعْدِهِمْ إِلَّا قَلِيلًا وَكُنَّا نَحْنُ الْوَارِثِينَ (58) وَمَا كَانَ رَبُّكَ مُهْلِكَ الْقُرَى حَتَّى يَبْعَثَ فِي أُمِّهَا رَسُولًا يَتْلُو عَلَيْهِمْ آيَاتِنَا وَمَا كُنَّا مُهْلِكِي الْقُرَى إِلَّا وَأَهْلُهَا ظَالِمُونَ (59)","hl":[[0,32,2],[32,55,1],[55,153,2],[153,325,1]]}},{"id":"ق-0938","fp":"297864188ed3","stateId":633,"easy":"الظلم ← الطوفان","cause":"الظلم","result":"الطوفان","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0735","ref":"سورة العنكبوت: 14","quran":{"s":29,"from":14,"to":14,"text":"وَلَقَدْ أَرْسَلْنَا نُوحًا إِلَى قَوْمِهِ فَلَبِثَ فِيهِمْ أَلْفَ سَنَةٍ إِلَّا خَمْسِينَ عَامًا فَأَخَذَهُمُ الطُّوفَانُ وَهُمْ ظَالِمُونَ (14)","hl":[[0,98,1],[98,122,2],[122,140,1]]}},{"id":"ق-0962","fp":"670703393035","stateId":633,"easy":"الشرك بالله ← سوء العاقبة","cause":"الشرك بالله","result":"سوء العاقبة","explicit":true,"ref":"سورة الروم: 42","srcLabel":"القرآن الكريم","quran":{"s":30,"from":42,"to":42,"text":"قُلْ سِيرُوا فِي الْأَرْضِ فَانْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الَّذِينَ مِنْ قَبْلُ كَانَ أَكْثَرُهُمْ مُشْرِكِينَ (42)","hl":[[0,27,1],[27,61,2],[61,114,1]]}},{"id":"ق-0966","fp":"21ab3d722b0e","stateId":633,"easy":"الإجرام ← انتقام الله","cause":"الإجرام","result":"انتقام الله","explicit":true,"repOf":"ق-1179","ref":"سورة الروم: 47","quran":{"s":30,"from":47,"to":47,"text":"وَلَقَدْ أَرْسَلْنَا مِنْ قَبْلِكَ رُسُلًا إِلَى قَوْمِهِمْ فَجَاءُوهُمْ بِالْبَيِّنَاتِ فَانْتَقَمْنَا مِنَ الَّذِينَ أَجْرَمُوا وَكَانَ حَقًّا عَلَيْنَا نَصْرُ الْمُؤْمِنِينَ (47)","hl":[[89,103,2],[103,129,1]]}},{"id":"ق-0982","fp":"ab72d703c7e3","stateId":633,"easy":"الإعراض عن آيات الله بعد التذكير ← انتقام الله","cause":"الإعراض عن آيات الله بعد التذكير","result":"انتقام الله","explicit":true,"ref":"سورة السجدة: 22","srcLabel":"القرآن الكريم","quran":{"s":32,"from":22,"to":22,"text":"وَمَنْ أَظْلَمُ مِمَّنْ ذُكِّرَ بِآيَاتِ رَبِّهِ ثُمَّ أَعْرَضَ عَنْهَا إِنَّا مِنَ الْمُجْرِمِينَ مُنْتَقِمُونَ (22)","hl":[[0,72,1],[72,112,2]]}},{"id":"ق-1000","fp":"9ddbab9dbd93","stateId":633,"easy":"عدم انتهاء المنافقين والمرجفين ← التسليط عليهم واللعن والأخذ (سنة الله)","cause":"عدم انتهاء المنافقين والمرجفين","result":"التسليط عليهم واللعن والأخذ (سنة الله)","explicit":true,"otherNeedIds":[28],"ref":"سورة الأحزاب: 60–62","srcLabel":"القرآن الكريم","quran":{"s":33,"from":60,"to":62,"text":"لَئِنْ لَمْ يَنْتَهِ الْمُنَافِقُونَ وَالَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ وَالْمُرْجِفُونَ فِي الْمَدِينَةِ لَنُغْرِيَنَّكَ بِهِمْ ثُمَّ لَا يُجَاوِرُونَكَ فِيهَا إِلَّا قَلِيلًا (60) مَلْعُونِينَ أَيْنَمَا ثُقِفُوا أُخِذُوا وَقُتِّلُوا تَقْتِيلًا (61) سُنَّةَ اللَّهِ فِي الَّذِينَ خَلَوْا مِنْ قَبْلُ وَلَنْ تَجِدَ لِسُنَّةِ اللَّهِ تَبْدِيلًا (62)","hl":[[0,106,1],[106,343,2]]}},{"id":"ق-1170","fp":"00600a154527","stateId":633,"easy":"الفسق وطاعة الطاغية المستخِفّ ← إغضاب الله والانتقام والإغراق","cause":"الفسق وطاعة الطاغية المستخِفّ","result":"إغضاب الله والانتقام والإغراق","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الزخرف: 54–56","srcLabel":"القرآن الكريم","quran":{"s":43,"from":54,"to":56,"text":"فَاسْتَخَفَّ قَوْمَهُ فَأَطَاعُوهُ إِنَّهُمْ كَانُوا قَوْمًا فَاسِقِينَ (54) فَلَمَّا آسَفُونَا انْتَقَمْنَا مِنْهُمْ فَأَغْرَقْنَاهُمْ أَجْمَعِينَ (55) فَجَعَلْنَاهُمْ سَلَفًا وَمَثَلًا لِلْآخِرِينَ (56)","hl":[[0,77,1],[77,147,2],[147,199,1]]}},{"id":"ق-1179","fp":"64094df466c4","stateId":633,"easy":"الإجرام ← الإهلاك","cause":"الإجرام","result":"الإهلاك","explicit":true,"similar":["ق-0906","ق-0966","ق-1405"],"ref":"سورة الدخان: 37","srcLabel":"القرآن الكريم","quran":{"s":44,"from":37,"to":37,"text":"أَهُمْ خَيْرٌ أَمْ قَوْمُ تُبَّعٍ وَالَّذِينَ مِنْ قَبْلِهِمْ أَهْلَكْنَاهُمْ إِنَّهُمْ كَانُوا مُجْرِمِينَ (37)","hl":[[62,77,2],[77,107,1]]}},{"id":"ق-1199","fp":"dd87e68eeff9","stateId":633,"easy":"جحود آيات الله ← لا يغني السمع والبصر والفؤاد ويحيق بهم ما استهزؤوا به","cause":"جحود آيات الله","result":"لا يغني السمع والبصر والفؤاد ويحيق بهم ما استهزؤوا به","explicit":true,"otherNeedIds":[21],"ref":"سورة الأحقاف: 26","srcLabel":"القرآن الكريم","quran":{"s":46,"from":26,"to":26,"text":"وَلَقَدْ مَكَّنَّاهُمْ فِيمَا إِنْ مَكَّنَّاكُمْ فِيهِ وَجَعَلْنَا لَهُمْ سَمْعًا وَأَبْصَارًا وَأَفْئِدَةً فَمَا أَغْنَى عَنْهُمْ سَمْعُهُمْ وَلَا أَبْصَارُهُمْ وَلَا أَفْئِدَتُهُمْ مِنْ شَيْءٍ إِذْ كَانُوا يَجْحَدُونَ بِآيَاتِ اللَّهِ وَحَاقَ بِهِمْ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ (26)","hl":[[108,194,2],[194,237,1],[237,284,2]]}},{"id":"ق-1200","fp":"263b1f9c8461","stateId":633,"easy":"اتخاذ آلهة من دون الله ← الإهلاك وخذلان الآلهة","cause":"اتخاذ آلهة من دون الله","result":"الإهلاك وخذلان الآلهة","explicit":true,"otherNeedIds":[44],"ref":"سورة الأحقاف: 27–28","srcLabel":"القرآن الكريم","quran":{"s":46,"from":27,"to":28,"text":"وَلَقَدْ أَهْلَكْنَا مَا حَوْلَكُمْ مِنَ الْقُرَى وَصَرَّفْنَا الْآيَاتِ لَعَلَّهُمْ يَرْجِعُونَ (27) فَلَوْلَا نَصَرَهُمُ الَّذِينَ اتَّخَذُوا مِنْ دُونِ اللَّهِ قُرْبَانًا آلِهَةً بَلْ ضَلُّوا عَنْهُمْ وَذَلِكَ إِفْكُهُمْ وَمَا كَانُوا يَفْتَرُونَ (28)","hl":[[0,49,2],[49,182,1],[182,203,2],[203,249,1]]}},{"id":"ق-1203","fp":"3bc4507b35c5","stateId":633,"easy":"الفسق ← الهلاك","cause":"الفسق","result":"الهلاك","explicit":true,"similar":["ق-0700","ق-1264"],"ref":"سورة الأحقاف: 35","srcLabel":"القرآن الكريم","quran":{"s":46,"from":35,"to":35,"text":"فَاصْبِرْ كَمَا صَبَرَ أُولُو الْعَزْمِ مِنَ الرُّسُلِ وَلَا تَسْتَعْجِلْ لَهُمْ كَأَنَّهُمْ يَوْمَ يَرَوْنَ مَا يُوعَدُونَ لَمْ يَلْبَثُوا إِلَّا سَاعَةً مِنْ نَهَارٍ بَلَاغٌ فَهَلْ يُهْلَكُ إِلَّا الْقَوْمُ الْفَاسِقُونَ (35)","hl":[[176,191,2],[191,222,1]]}},{"id":"ق-1209","fp":"fba70a6dca5c","stateId":633,"easy":"الكفر ← تدمير الله عليهم (ولأمثالهم مثلها)","cause":"الكفر","result":"تدمير الله عليهم (ولأمثالهم مثلها)","explicit":true,"ref":"سورة محمد: 10","srcLabel":"القرآن الكريم","quran":{"s":47,"from":10,"to":10,"text":"أَفَلَمْ يَسِيرُوا فِي الْأَرْضِ فَيَنْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الَّذِينَ مِنْ قَبْلِهِمْ دَمَّرَ اللَّهُ عَلَيْهِمْ وَلِلْكَافِرِينَ أَمْثَالُهَا (10)","hl":[[0,95,1],[95,151,2]]}},{"id":"ق-1264","fp":"19dbf8f4ea17","stateId":633,"easy":"الفسق ← الهلاك (قوم نوح)","cause":"الفسق","result":"الهلاك (قوم نوح)","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-1203","ref":"سورة الذاريات: 46","quran":{"s":51,"from":46,"to":46,"text":"وَقَوْمَ نُوحٍ مِنْ قَبْلُ إِنَّهُمْ كَانُوا قَوْمًا فَاسِقِينَ (46)","hl":[[0,63,1]]}},{"id":"ق-1271","fp":"e808a52bf21d","stateId":633,"easy":"الظلم ← عذاب دون عذاب الآخرة","cause":"الظلم","result":"عذاب دون عذاب الآخرة","explicit":true,"otherNeedIds":[64],"ref":"سورة الطور: 47","srcLabel":"القرآن الكريم","quran":{"s":52,"from":47,"to":47,"text":"وَإِنَّ لِلَّذِينَ ظَلَمُوا عَذَابًا دُونَ ذَلِكَ وَلَكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ (47)","hl":[[8,28,1],[28,49,2],[49,88,1]]}},{"id":"ق-1317","fp":"6991368d76e7","stateId":633,"easy":"مشاقّة الله ورسوله ← إتيان الله من حيث لم يحتسبوا وقذف الرعب والجلاء وعذاب النار","cause":"مشاقّة الله ورسوله","result":"إتيان الله من حيث لم يحتسبوا وقذف الرعب والجلاء وعذاب النار","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0452","otherNeedIds":[60,70],"ref":"سورة الحشر: 2–4","quran":{"s":59,"from":2,"to":4,"text":"هُوَ الَّذِي أَخْرَجَ الَّذِينَ كَفَرُوا مِنْ أَهْلِ الْكِتَابِ مِنْ دِيَارِهِمْ لِأَوَّلِ الْحَشْرِ مَا ظَنَنْتُمْ أَنْ يَخْرُجُوا وَظَنُّوا أَنَّهُمْ مَانِعَتُهُمْ حُصُونُهُمْ مِنَ اللَّهِ فَأَتَاهُمُ اللَّهُ مِنْ حَيْثُ لَمْ يَحْتَسِبُوا وَقَذَفَ فِي قُلُوبِهِمُ الرُّعْبَ يُخْرِبُونَ بُيُوتَهُمْ بِأَيْدِيهِمْ وَأَيْدِي الْمُؤْمِنِينَ فَاعْتَبِرُوا يَا أُولِي الْأَبْصَارِ (2) وَلَوْلَا أَنْ كَتَبَ اللَّهُ عَلَيْهِمُ الْجَلَاءَ لَعَذَّبَهُمْ فِي الدُّنْيَا وَلَهُمْ فِي الْآخِرَةِ عَذَابُ النَّارِ (3) ذَلِكَ بِأَنَّهُمْ شَاقُّوا اللَّهَ وَرَسُولَهُ وَمَنْ يُشَاقِّ اللَّهَ فَإِنَّ اللَّهَ شَدِيدُ الْعِقَابِ (4)","hl":[[0,191,1],[191,338,2],[338,381,1],[381,502,2],[502,613,1]]}},{"id":"ق-1355","fp":"63dc085cad65","stateId":633,"easy":"العتوّ عن أمر الله ورسله ← حساب شديد وعذاب نُكر وخسران العاقبة","cause":"العتوّ عن أمر الله ورسله","result":"حساب شديد وعذاب نُكر وخسران العاقبة","explicit":true,"otherNeedIds":[57,69],"ref":"سورة الطلاق: 8–10","srcLabel":"القرآن الكريم","quran":{"s":65,"from":8,"to":10,"text":"وَكَأَيِّنْ مِنْ قَرْيَةٍ عَتَتْ عَنْ أَمْرِ رَبِّهَا وَرُسُلِهِ فَحَاسَبْنَاهَا حِسَابًا شَدِيدًا وَعَذَّبْنَاهَا عَذَابًا نُكْرًا (8) فَذَاقَتْ وَبَالَ أَمْرِهَا وَكَانَ عَاقِبَةُ أَمْرِهَا خُسْرًا (9) أَعَدَّ اللَّهُ لَهُمْ عَذَابًا شَدِيدًا فَاتَّقُوا اللَّهَ يَا أُولِي الْأَلْبَابِ الَّذِينَ آمَنُوا قَدْ أَنْزَلَ اللَّهُ إِلَيْكُمْ ذِكْرًا (10)","hl":[[0,65,1],[65,98,2]]}},{"id":"ق-1405","fp":"eab5a2c804b6","stateId":633,"easy":"الإجرام ← الإهلاك (كذلك نفعل بالمجرمين)","cause":"الإجرام","result":"الإهلاك (كذلك نفعل بالمجرمين)","explicit":true,"repOf":"ق-1179","ref":"سورة المرسلات: 16–18","quran":{"s":77,"from":16,"to":18,"text":"أَلَمْ نُهْلِكِ الْأَوَّلِينَ (16) ثُمَّ نُتْبِعُهُمُ الْآخِرِينَ (17) كَذَلِكَ نَفْعَلُ بِالْمُجْرِمِينَ (18)","hl":[[0,88,2],[88,105,1]]}},{"id":"ق-1411","fp":"f90772970a6d","stateId":633,"easy":"الطغيان والتكذيب والعصيان وادعاء الربوبية (فرعون) ← نكال الآخرة والأولى","cause":"الطغيان والتكذيب والعصيان وادعاء الربوبية (فرعون)","result":"نكال الآخرة والأولى","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[69],"ref":"سورة النازعات: 17–26","srcLabel":"القرآن الكريم","quran":{"s":79,"from":17,"to":26,"text":"اذْهَبْ إِلَى فِرْعَوْنَ إِنَّهُ طَغَى (17) فَقُلْ هَلْ لَكَ إِلَى أَنْ تَزَكَّى (18) وَأَهْدِيَكَ إِلَى رَبِّكَ فَتَخْشَى (19) فَأَرَاهُ الْآيَةَ الْكُبْرَى (20) فَكَذَّبَ وَعَصَى (21) ثُمَّ أَدْبَرَ يَسْعَى (22) فَحَشَرَ فَنَادَى (23) فَقَالَ أَنَا رَبُّكُمُ الْأَعْلَى (24) فَأَخَذَهُ اللَّهُ نَكَالَ الْآخِرَةِ وَالْأُولَى (25) إِنَّ فِي ذَلِكَ لَعِبْرَةً لِمَنْ يَخْشَى (26)","hl":[[0,277,1],[277,326,2],[326,374,1]]}},{"id":"ق-1433","fp":"7105123afd87","stateId":633,"easy":"الطغيان في البلاد وإكثار الفساد (عاد وثمود وفرعون) ← سوط عذاب وربك بالمرصاد","cause":"الطغيان في البلاد وإكثار الفساد (عاد وثمود وفرعون)","result":"سوط عذاب وربك بالمرصاد","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الفجر: 6–14","srcLabel":"القرآن الكريم","quran":{"s":89,"from":6,"to":14,"text":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ (6) إِرَمَ ذَاتِ الْعِمَادِ (7) الَّتِي لَمْ يُخْلَقْ مِثْلُهَا فِي الْبِلَادِ (8) وَثَمُودَ الَّذِينَ جَابُوا الصَّخْرَ بِالْوَادِ (9) وَفِرْعَوْنَ ذِي الْأَوْتَادِ (10) الَّذِينَ طَغَوْا فِي الْبِلَادِ (11) فَأَكْثَرُوا فِيهَا الْفَسَادَ (12) فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ (13) إِنَّ رَبَّكَ لَبِالْمِرْصَادِ (14)","hl":[[0,287,1],[287,364,2]]}},{"id":"ق-1460","fp":"1a37d474794b","stateId":633,"easy":"الكيد لبيت الله ← تضليل الكيد والإهلاك","cause":"الكيد لبيت الله","result":"تضليل الكيد والإهلاك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الفيل: 1–5","srcLabel":"القرآن الكريم","quran":{"s":105,"from":1,"to":5,"text":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَابِ الْفِيلِ (1) أَلَمْ يَجْعَلْ كَيْدَهُمْ فِي تَضْلِيلٍ (2) وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ (3) تَرْمِيهِمْ بِحِجَارَةٍ مِنْ سِجِّيلٍ (4) فَجَعَلَهُمْ كَعَصْفٍ مَأْكُولٍ (5)","hl":[[0,59,1],[59,222,2]]}},{"id":"س-07375","fp":"e910123963c6","stateId":633,"easy":"إذا مزّقت كتاب الحق ← يمزّق الله ملكك (من واقعة)","cause":"خرَقهُ","result":"أنْ يُمَزَّقوا كلَّ مُمَزَّقٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج مشكل الآثار 515","srcLabel":"البخاري","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ بعَث بكتابِهِ إلى كِسْرى مع عبدِ اللهِ بنِ حُذافةَ السَّهْميِّ، وأمَرهُ أنْ يدفَعَهُ إلى عظيمِ البَحرَيْنِ، فدفَعهُ عظيمُ البَحرَيْنِ إلى كِسْرى، فلمَّا قرَأهُ ",["خرَقهُ",1],"، قال ابنُ شِهابٍ فحسِبْتُ أنَّ ابنَ المُسَيِّبِ قال: فدعا عليهم رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["أنْ يُمَزَّقوا كلَّ مُمَزَّقٍ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (2939) باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › أحوال النبي","dorar":"KukLHLMR"},{"id":"س-07298","fp":"53c28a0ffa53","stateId":633,"easy":"إذا مشت الأمة مشية الخيلاء وخدمها أبناء الملوك ← سُلّط شرارها على خيارها","cause":"إذا مَشت أُمَّتي الْمُطَيطَاءَ ، و خدَمَها أبناءُ الملوكِ أبناءُ فارسٍ و الرومِ","result":"سُلِّطَ شرارُها على خيارِها","explicit":true,"ref":"صحيح الجامع 801","srcLabel":"الترمذي","text":[["إذا مَشت أُمَّتي الْمُطَيطَاءَ ، و خدَمَها أبناءُ الملوكِ أبناءُ فارسٍ و الرومِ",1]," ، ",["سُلِّطَ شرارُها على خيارِها",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2261)، وابن المبارك في ((الزهد)) (2/51)، وأبو نعيم في ((تاريخ أصبهان)) (1/362) باختلاف يسير.","bab":"فتن › ظهور الفتن","dorar":"fKz7B1zT","merged":2,"otherRefs":["الترغيب والترهيب 4/42 (صحيح)"]},{"id":"س-04975","fp":"fcddd37341c9","stateId":634,"easy":"إذا نقض قوم العهد ← يكون القتل بينهم","cause":"ما نَقَضَ قومٌ العَهْدَ قَطُّ","result":"إلَّا كان القَتْلُ بيْنَهم","explicit":true,"ref":"المستدرك على الصحيحين 2613","srcLabel":"مسلم","text":[["ما نَقَضَ قومٌ العَهْدَ قَطُّ؛",1]," ",["إلَّا كان القَتْلُ بيْنَهم",2],"، ولا ظَهَرَتِ الفاحشةُ في قومٍ قَطُّ؛ إلَّا سَلَّطَ اللهُ عليهم الموتَ، ولا مَنَعَ قومٌ الزَّكاةَ؛ إلَّا حَبَسَ اللهُ عنهم القَطْرَ."],"grade":"صحيح","narrator":"[بريدة]","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه البزار (4463)، والبيهقي (6469) كلاهما بلفظه، وابن المنذر في ((الأوسط)) (6692) ببعض لفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"R29oTLvs"},{"id":"س-04976","fp":"7516b4918136","stateId":634,"easy":"إذا ظهرت الفاحشة في قوم ← يسلط الله عليهم الموت","cause":"ولا ظَهَرَتِ الفاحشةُ في قومٍ قَطُّ","result":"إلَّا سَلَّطَ اللهُ عليهم الموتَ","explicit":true,"similar":["س-06151","س-08253"],"ref":"المستدرك على الصحيحين 2613","srcLabel":"مسلم","text":["ما نَقَضَ قومٌ العَهْدَ قَطُّ؛ إلَّا كان القَتْلُ بيْنَهم، ",["ولا ظَهَرَتِ الفاحشةُ في قومٍ قَطُّ",1],"؛ ",["إلَّا سَلَّطَ اللهُ عليهم الموتَ",2],"، ولا مَنَعَ قومٌ الزَّكاةَ؛ إلَّا حَبَسَ اللهُ عنهم القَطْرَ."],"grade":"صحيح","narrator":"[بريدة]","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه البزار (4463)، والبيهقي (6469) كلاهما بلفظه، وابن المنذر في ((الأوسط)) (6692) ببعض لفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"R29oTLvs"},{"id":"س-06139","fp":"ac7e5598d398","stateId":634,"easy":"إذا منعت الزكاة ← تُؤخذ منك وشطر مالك عزمة من عزمات ربنا","cause":"ومن منعَها","result":"فإنَّا آخِذُها وشطرَ إبلِهِ عزمةٌ من عزماتِ ربِّنا","explicit":true,"ref":"صحيح ابن خزيمة 4/ 31","srcLabel":"النسائي","text":["في كلِّ إبلٍ سائمةٍ في كلِّ أربعينَ بنتُ لبونٍ، لا يفرَّقُ إبلٌ مِن حسابِها، مَن أعطاها مؤتَجرًا فلَهُ أجرُها، ",["ومن منعَها",1],"، ",["فإنَّا آخِذُها وشطرَ إبلِهِ عزمةٌ من عزماتِ ربِّنا",2],"، لا يحلُّ لآلِ مُحمَّدٍ منها شيءٌ . [وفي روايةٍ]: مِن كلِّ أربعينَ بنتُ لبونٍ . [وفي رِوايةٍ]: ومن أبى فأَنا آخِذُها وشطرَ مالِهِ، وقالَ: لا يفرَّقُ إبلٌ مِن حسابِها"],"grade":"صحيح","narrator":"معاوية بن حيدة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه النسائي (2444)، وأحمد (20016)، والدارمي (1719) واللفظ لهم.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"ZSBa2M5g","merged":5,"otherRefs":["تهذيب السنن 4/453 (صحيح)","تخريج مشكل الآثار 15/ 101 (حسن)","تخريج سير أعلام النبلاء 15/ 257- 258 (حسن)","الطرق الحكمية 226 (صحيح)"]},{"id":"س-08278","fp":"9caca151c589","stateId":634,"easy":"إذا ظهر الربا والزنا في قوم ← فقد أحلّوا بأنفسهم عقاب الله","cause":"ما ظهَرَ في قَومٍ الرِّبا والزِّنا","result":"إلَّا أحَلُّوا بأنفُسِهم عِقابَ اللهِ عزَّ وجلَّ","explicit":true,"similar":["س-06955","س-08074"],"ref":"تخريج المسند لشعيب 3809","srcLabel":"الترمذي","text":["\"لعَنَ اللهُ آكِلَ الرِّبا، ومُوكِلَه، وشاهدَيْه، وكاتبَه\"،\nقال: وقال: \"",["ما ظهَرَ في قَومٍ الرِّبا والزِّنا،",1]," ",["إلَّا أحَلُّوا بأنفُسِهم عِقابَ اللهِ عزَّ وجلَّ\"",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (1206)، وابن ماجه (2277) باختلاف يسير، والنسائي (3416) مطولاً باختلاف يسير، وأحمد (3809) واللفظ له","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"FLufTdL7","merged":2,"otherRefs":["صحيح ابن حبان 4410 (صحيح)"]},{"id":"س-01701","fp":"b8f57c485098","stateId":634,"easy":"إذا ظهرت الفاحشة في قوم حتى أعلنوها ← يظهر فيهم الطاعون والأوجاع التي لم تكن في أسلافهم","cause":"لم تَظهَرِ الفاحشةُ في قومٍ قطُّ حتَّى يَعمَلوها","result":"إلَّا ظَهَر فيهم الطَّاعونُ والأوجاعُ الَّتي لم تكُنْ مَضَت في أسلافِهم، ولم يَنقُصوا المِكيالَ والميزانَ إلَّا أُخِذوا بالسِّنينَ وشِدَّةِ المؤْنةِ وجَوْرِ السُّلطانِ عليهم، ولم يَمنَعوا زكاةَ أموالِهم إلَّا مُنِعوا القطْرَ","explicit":true,"similar":["س-02677","س-06128"],"otherNeedIds":[3],"ref":"المستدرك على الصحيحين 8848","srcLabel":"الحاكم","text":["عن عَطاءِ بنِ أبي رَباحٍ، قال: كُنتُ مع عبدِ اللهِ بنِ عُمرَ، فأتاهُ فتًى يَسألُه عن إسدالِ العِمامةِ، فقال ابنُ عُمرَ: سأُخبِرُك عن ذلكَ بعِلمٍ إنْ شاء اللهُ: كُنتُ عاشرَ عَشَرةٍ في مَسجدِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ: أبو بَكرٍ، وعُمرُ، وعُثمانُ، وعلِيٌّ، وابنُ مَسعودٍ، وحُذَيفةُ، وابنُ عَوفٍ، وأبو سَعيدٍ الخُدْريُّ رَضيَ اللهُ عنهم، فجاء فتًى مِنَ الأنصارِ فسَلَّم على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ ثمَّ جلَسَ، فقال: يا رَسولَ اللهِ، أيُّ المُؤمنينَ أفضلُ؟ قال: أحسَنُهم خُلقًا، قال: فأيُّ المُؤمنينَ أكيَسُ؟ قال: أكثَرُهم للموتِ ذِكرًا وأحسَنُهم له استعدادًا قبْلَ أنْ يَنزِلَ بهم، أولئكَ مِنَ الأكياسِ، ثمَّ سَكَت الفَتى. وأقبَلَ عليه النَّبيُّ صلَّى اللهُ عليه وسلَّمَ، فقال: يا مَعشَرَ المهاجِرين، خمسٌ إنِ ابتُلِيتُم بهنَّ، ونزَلَ فيكم، أعوذُ باللهِ أنْ تُدْرِكُوهنَّ: ",["لم تَظهَرِ الفاحشةُ في قومٍ قطُّ حتَّى يَعمَلوها",1]," ",["إلَّا ظَهَر فيهم الطَّاعونُ والأوجاعُ الَّتي لم تكُنْ مَضَت في أسلافِهم، ولم يَنقُصوا المِكيالَ والميزانَ إلَّا أُخِذوا بالسِّنينَ وشِدَّةِ المؤْنةِ وجَوْرِ السُّلطانِ عليهم، ولم يَمنَعوا زكاةَ أموالِهم إلَّا مُنِعوا القطْرَ",2]," مِنَ السَّماءِ، ولوْلا البهائمُ لم يُمْطَروا، ولم يَنقُضوا عهْدَ اللهِ وعهْدَ رَسولِه إلَّا سُلِّطَ عليهم عدُوُّهم مِن غيرِهم وأَخَذوا بعضَ ما كان في أيْديهم، وما لم يَحكُمْ أئمَّتُهم بكتابِ اللهِ إلَّا ألْقى اللهُ بأسهُمٍ بيْنهم. ثمَّ أمَرَ عبدَ الرَّحمنِ بنَ عَوفٍ يَتجهَّزُ لسَرِيَّةٍ بَعَثه عليها، وأصبَحَ عبْدُ الرَّحمنِ قدِ اعتَمَّ بعِمامةٍ مِن كَرابيسَ سَوداءَ، فأدْناه النَّبيُّ صلَّى اللهُ عليه وسلَّمَ، ثمَّ نَقَضه وعمَّمه بعِمامةٍ بَيضاءَ، وأرسَلَ مِن خلْفِه أربعَ أصابعَ أو نحْوَ ذلكَ، وقال: هكذا يا ابنَ عَوفٍ اعتَمَّ؛ فإنَّه أعرَبُ وأحسَنُ. ثمَّ أمَرَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ بِلالًا أنْ يَدفَعَ إليه اللِّواءَ، فحَمِد اللهَ وصلَّى على النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، ثمَّ قال: خُذِ ابنَ عَوفٍ فاغْزُوا جميعًا في سَبيلِ اللهِ، فقاتِلوا مَن كَفَر باللهِ، لا تَغُلُّوا ولا تَغدِروا، ولا تُمثِّلوا، ولا تَقْتُلوا وَليدًا، فهذا عهْدُ اللهِ وسِيرةُ نبيِّه صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح الإسناد، ولم يخرجاه","bab":"أقضية وأحكام › الحكم بالكتاب والسنة ثم باجتهاد الحاكم، والخطأ معذور","dorar":"uPcbS7uR"},{"id":"س-02677","fp":"9bb218fe3a47","stateId":634,"easy":"إذا ظهرت الفاحشة في قوم وأعلنوها ← فشا فيهم الطاعون والأوجاع الجديدة","cause":"لم تَظْهرِ الفاحِشةُ في قومٍ قطُّ حتى يُعلِنُوا بِها","result":"إلا فَشَا فِيهمُ الطاعونُ و الأَوجاعُ التِي لم تكنْ مَضتْ في أسلافِهم الَّذين مَضَوَا","explicit":true,"repOf":"س-01701","ref":"صحيح الترغيب 2419","text":["يا مَعشَرَ المُهاجِرينَ ! خَمسُ خِصالٍ إذا ابْتُلِيتُم بِهنَّ ، وأَعوذُ باللهِ أنْ تُدْرِكُوهُنَّ : ",["لم تَظْهرِ الفاحِشةُ في قومٍ قطُّ حتى يُعلِنُوا بِها ؛",1]," ",["إلا فَشَا فِيهمُ الطاعونُ و الأَوجاعُ التِي لم تكنْ مَضتْ في أسلافِهم الَّذين مَضَوَا",2],".. الحديثُ ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (4019)، والطبراني في ((المعجم الأوسط)) (4671)، والحاكم (8623) باختلاف يسير.","bab":"إيمان › الحكم بما أنزل الله","dorar":"QaIEK7rb"},{"id":"س-05234","fp":"00680fb431db","stateId":634,"easy":"إذا فشا ولد الزنا في الأمة ← يوشك أن يعمهم الله بعذاب","cause":"ما لم يفشِ فيهم ولدُ الزنا فإذا فشا فيهم ولدُ الزنا فأوشك أن يعمَّهم اللهُ بعذابٍ","result":"لا تزال أمتي بخيرٍ","explicit":true,"ref":"مجمع الزوائد 6/260","srcLabel":"أحمد","text":[["لا تزال أمتي بخيرٍ",2]," ",["ما لم يفشِ فيهم ولدُ الزنا فإذا فشا فيهم ولدُ الزنا فأوشك أن يعمَّهم اللهُ بعذابٍ",1]],"grade":"صحيح","narrator":"ميمونة بنت الحارث أم المؤمنين","muhaddith":"صحيح أو حسن","takhrij":"أخرجه أحمد (26830)، والطبراني (24/ 23) (55)، وأبو يعلى في ((المسند)) (7091) واللفظ لهم جميعا.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"wVMVfWBC"},{"id":"س-05651","fp":"be7f41b5b5c5","stateId":634,"easy":"إذا أبغض المسلمون علماءهم وعمروا أسواقهم وتناكحوا على جمع المال ← رماهم الله بالقحط وجور السلطان وخيانة الولاة وصولة العدو","cause":"إذا أبغَضَ المُسلِمونَ عُلماءَهُم، وأظْهَروا عِمارةَ أَسواقِهِم، وتَناكَحوا على جمْعِ الدَّراهِمِ","result":"رَماهُم اللهُ عزَّ وجلَّ بأربعِ خِصالٍ: بالقَحْطِ مِن الزَّمانِ، والجَوْرِ مِن السُّلْطانِ، والخيانةِ مِن وُلاةِ الأحكامِ، والصَّولةِ مِن العَدُوِّ","explicit":true,"ref":"المستدرك على الصحيحين 8136","srcLabel":"الحاكم","text":[["إذا أبغَضَ المُسلِمونَ عُلماءَهُم، وأظْهَروا عِمارةَ أَسواقِهِم، وتَناكَحوا على جمْعِ الدَّراهِمِ",1],"، ",["رَماهُم اللهُ عزَّ وجلَّ بأربعِ خِصالٍ: بالقَحْطِ مِن الزَّمانِ، والجَوْرِ مِن السُّلْطانِ، والخيانةِ مِن وُلاةِ الأحكامِ، والصَّولةِ مِن العَدُوِّ",2],"."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح الإسناد إن كان عبد الله بن أبي مليكة سمع من أمير المؤمنين عليه السلام","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"NnOABwBY"},{"id":"س-06130","fp":"c3ec50cdd921","stateId":634,"easy":"إذا بخس قوم المكيال والميزان ← أُخذوا بالسنين وشدة المؤونة وجور السلطان","cause":"وما بخَس قومٌ المكيالَ والميزانَ","result":"إلا أُخِذوا بالسِّنينَ وشِدَّةِ المؤْنةِ وجَوْرِ السُّلطانِ","explicit":true,"otherNeedIds":[3],"ref":"صحيح الترغيب 2187","srcLabel":"ابن ماجه","text":["كيف أنتم إذا وقعت فيكم خمسٌ ؟ وأعوذ باللهِ أن تكون فيكم أو تُدرِكوها : ما ظهرتِ الفاحشةُ في قومٍ قطُّ يعملُ بها فيهم علانيةً ؛ إلا ظهر فيهم الطاعونُ والأوجاعُ التي لم تكن في أسلافِهم ، وما منع قومٌ الزكاةَ ؛ إلا مُنِعوا القطرَ من السماءِ ولولا البهائمُ لم يُمطَروا ، ",["وما بخَس قومٌ المكيالَ والميزانَ",1]," ؛ ",["إلا أُخِذوا بالسِّنينَ وشِدَّةِ المؤْنةِ وجَوْرِ السُّلطانِ",2]," ، ولا حكم أمراؤهم بغير ما أنزل اللهُ ؛ إلا سلَّطَ اللهُ عليهم عدوَّهم فاستنقَذوا بعضَ ما في أيديهم ، وما عطَّلوا كتابَ اللهِ وسنَّةَ نبيِّه ؛ إلا جعل اللهُ بأسَهم بينهم"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (4019) باختلاف يسير، والطبراني (12/446) (13619) مختصراً، والحاكم (8623) مطولاً باختلاف يسير","bab":"زكاة › عقوبة مانع الزكاة","dorar":"xjvYry2k"},{"id":"س-06151","fp":"820a84fb2654","stateId":634,"easy":"إذا فشت الفاحشة في قوم ← أخذهم الله بالموت","cause":"ولا فشتِ الفاحشةُ في قومٍ","result":"إلا أخذهم اللهُ بالموتِ","explicit":true,"repOf":"س-04976","ref":"السلسلة الصحيحة 1/219","text":["عن ابنِ عباسٍ قال : ما نقض قومٌ العهدَ إلا سلَّط اللهُ عليهم عدوَّهم ",["ولا فشتِ الفاحشةُ في قومٍ",1]," ",["إلا أخذهم اللهُ بالموتِ",2]," وما طفَّف قومٌ الميزانَ إلا أخذَهم اللهُ بالسِّنينَ وما منع قومٌ الزكاةَ إلا منعَهم اللهُ القطرَ من السماءِ وما جار قومٌ في حكمٍ إلا كان البأسُ بينهم أظنُّه قال : والقتلُ"],"grade":"صحيح","narrator":"عبدالله بن بريدة بن الحصيب الأسلمي","muhaddith":"إسناده صحيح","takhrij":"أخرجه البيهقي (6470) واللفظ له.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"4yZchCL2"},{"id":"س-06955","fp":"7b437d9e4092","stateId":634,"easy":"إذا شاع الزنا والربا في قرية ← فقد أحلّت بنفسها غضب الله","cause":"إذا شاعَ الزِّنا والرِّبا في قريةٍ","result":"فقد أحلَّت بنَفسِها غضبَ اللهِ","explicit":true,"repOf":"س-08278","ref":"فقه السيرة 342","text":[["إذا شاعَ الزِّنا والرِّبا في قريةٍ ",1],["فقد أحلَّت بنَفسِها غضبَ اللهِ ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (1/179) (462)، والحاكم (2261) باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"wCyBInaA"},{"id":"س-08253","fp":"068668bf31fe","stateId":634,"easy":"إذا أشاع قوم الفاحشة ← يعمهم الله بالبلاء","cause":"ولا يشيعُ قومٌ قطُّ الفاحشةَ","result":"إلا عمَّهم اللهُ بالبلاء","explicit":true,"repOf":"س-04976","ref":"البداية والنهاية 5/218","text":["عن أنسِ بنِ مالكٍ قال لما بُويعَ أبو بكرٍ في السَّقيفةِ وكان الغدُ جلس أبو بكرٍ على المنبرِ وقام عمرُ فتكلَّم قبل أبي بكرٍ فحمد اللهَ وأثنى عليه بما هو أهلُه ثم قال أيها الناسُ إني قد كنتُ قلتُ لكم بالأمسِ مقالةً ما كانت وما وجدتُها في كتاب اللهِ ولا كانت عهدًا عهِدها إليَّ رسولُ اللهِ ولكني كنتُ أرى أنَّ رسولَ اللهِ سيُدبِرُ أمرَنا يقول يكون آخرَنا واللهِ قد أبقى فيكم كتابَه الذي هدى به رسولَ اللهِ فإن اعتصمتُم به هداكم اللهُ لما كان هداه اللهُ له وأنَّ اللهَ قد جمع أمرَكم على خيرِكم صاحبِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وثاني اثنين إذ هما في الغار فقوموا فبايِعوه فبايع الناسُ أبا بكرٍ بيعةَ العامةِ بعد بيعةِ السَّقيفةِ ثم تكلم أبو بكرٍ فحمد اللهَ وأثنى عليه بما هو أهلُه ثم قال أما بعد أيها الناسُ فإني قد وُلِّيتُ عليكم ولستُ بخيرِكم فإن أحسنتُ فأَعِينوني وإن أسأتُ فقوِّموني الصدقُ أمانةٌ والكذبُ خيانةٌ والضعيفُ منكم قويٌّ عندي حتى أزيحَ عِلَّتَه إن شاء اللهُ والقويُّ فيكم ضعيفٌ حتى آخذَ منه الحقَّ إن شاء اللهُ لا يدعُ قومٌ الجهادَ في سبيل اللهِ إلا ضربَهم اللهُ بالذُّلِّ ",["ولا يشيعُ قومٌ قطُّ الفاحشةَ",1]," ",["إلا عمَّهم اللهُ بالبلاء",2]," أَطيعوني ما أَطعتُ اللهَ ورسولَه فإذا عصيتُ اللهَ ورسولَه فلا طاعةَ لي عليكم قوموا إلى صلاتِكم يرحمْكم اللهُ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح","takhrij":"أخرجه محمد بن إسحاق كما في ((السيرة)) لابن هشام (6/ 82)، والطبري في ((التاريخ)) (3/ 210) كلاهما بلفظه.","bab":"مناقب وفضائل › أبو بكر الصديق","dorar":"Fk8YWRPX"},{"id":"س-06931","fp":"f3ed4016d3bc","stateId":634,"easy":"إذا زنيت ← ففيه ست خصال: ثلاث في الدنيا (ذهاب البهاء والفقر وقصر العمر) وثلاث في الآخرة","cause":"إياكم والزنا","result":"فإنَّ في الزنا ستَّ خصالٍ ثلاثٌ في الدنيا وثلاثٌ في الآخرةِ ، فأما اللواتي في دارِ الدنيا فذهابُ نورِ الوجهِ ، وانقطاعُ الرزقِ ، وسرعةُ الفناءِ ، وأما اللواتي في الآخرةِ فغضبُ الربِّ ، وسوءُ الحسابِ ، والحلولُ في النارِ","explicit":true,"otherNeedIds":[3,69],"ref":"تاريخ بغداد 12/491","srcLabel":"ابن الجوزي","text":[["إياكم والزنا ",1],["فإنَّ في الزنا ستَّ خصالٍ ثلاثٌ في الدنيا وثلاثٌ في الآخرةِ ، فأما اللواتي في دارِ الدنيا فذهابُ نورِ الوجهِ ، وانقطاعُ الرزقِ ، وسرعةُ الفناءِ ، وأما اللواتي في الآخرةِ فغضبُ الربِّ ، وسوءُ الحسابِ ، والحلولُ في النارِ",2]," ، إلا أنْ يشاءَ اللهُ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده كلهم ثقات سوى كعب","takhrij":"أخرجه ابن الجوزي في ((الموضوعات)) (3/107)، والسيوطي في ((اللآلىء المصنوعة)) (2/162) واللفظ لهما.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"F5vneFcQ"},{"id":"س-08074","fp":"b9fe7f65ca77","stateId":634,"easy":"إذا ظهر الزنا والربا في قرية ← فقد أحلّوا بأنفسهم عقاب الله","cause":"إذا ظهَرَ الزِّنَى والرِّبَا في قريَةٍ","result":"فقدْ أَحَلُّوا بِأَنْفُسِهِمْ عِقَابَ اللهِ عزَّ وجلَّ","explicit":true,"repOf":"س-08278","ref":"مجمع الزوائد 4/121","text":[["إذا ظهَرَ الزِّنَى والرِّبَا في قريَةٍ",1]," ",["فقدْ أَحَلُّوا بِأَنْفُسِهِمْ عِقَابَ اللهِ عزَّ وجلَّ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"فيه هاشم بن مرزوق ولم أجد من ترجمه وبقية رجاله ثقات","takhrij":"أخرجه الطبراني (1/179) (462)، والحاكم (2261) باختلاف يسير.","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"d0DGDVzA"},{"id":"س-06128","fp":"5362bc22f4c2","stateId":634,"easy":"إذا ظهرت الفاحشة في قوم علانية ← يظهر فيهم الطاعون والأوجاع الجديدة","cause":"ما ظهرتِ الفاحشةُ في قومٍ قطُّ يعملُ بها فيهم علانيةً","result":"إلا ظهر فيهم الطاعونُ والأوجاعُ التي لم تكن في أسلافِهم","explicit":true,"repOf":"س-01701","ref":"صحيح الترغيب 2187","text":["كيف أنتم إذا وقعت فيكم خمسٌ ؟ وأعوذ باللهِ أن تكون فيكم أو تُدرِكوها : ",["ما ظهرتِ الفاحشةُ في قومٍ قطُّ يعملُ بها فيهم علانيةً ؛",1]," ",["إلا ظهر فيهم الطاعونُ والأوجاعُ التي لم تكن في أسلافِهم",2]," ، وما منع قومٌ الزكاةَ ؛ إلا مُنِعوا القطرَ من السماءِ ولولا البهائمُ لم يُمطَروا ، وما بخَس قومٌ المكيالَ والميزانَ ؛ إلا أُخِذوا بالسِّنينَ وشِدَّةِ المؤْنةِ وجَوْرِ السُّلطانِ ، ولا حكم أمراؤهم بغير ما أنزل اللهُ ؛ إلا سلَّطَ اللهُ عليهم عدوَّهم فاستنقَذوا بعضَ ما في أيديهم ، وما عطَّلوا كتابَ اللهِ وسنَّةَ نبيِّه ؛ إلا جعل اللهُ بأسَهم بينهم"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (4019) باختلاف يسير، والطبراني (12/446) (13619) مختصراً، والحاكم (8623) مطولاً باختلاف يسير","bab":"زكاة › عقوبة مانع الزكاة","dorar":"xjvYry2k"},{"id":"س-06129","fp":"dec4d7857cc4","stateId":634,"easy":"إذا منع قوم الزكاة ← مُنعوا القطر من السماء ولولا البهائم لم يُمطروا","cause":"وما منع قومٌ الزكاةَ","result":"إلا مُنِعوا القطرَ من السماءِ ولولا البهائمُ لم يُمطَروا","explicit":true,"otherNeedIds":[3],"ref":"صحيح الترغيب 2187","srcLabel":"ابن ماجه","text":["كيف أنتم إذا وقعت فيكم خمسٌ ؟ وأعوذ باللهِ أن تكون فيكم أو تُدرِكوها : ما ظهرتِ الفاحشةُ في قومٍ قطُّ يعملُ بها فيهم علانيةً ؛ إلا ظهر فيهم الطاعونُ والأوجاعُ التي لم تكن في أسلافِهم ، ",["وما منع قومٌ الزكاةَ",1]," ؛ ",["إلا مُنِعوا القطرَ من السماءِ ولولا البهائمُ لم يُمطَروا",2]," ، وما بخَس قومٌ المكيالَ والميزانَ ؛ إلا أُخِذوا بالسِّنينَ وشِدَّةِ المؤْنةِ وجَوْرِ السُّلطانِ ، ولا حكم أمراؤهم بغير ما أنزل اللهُ ؛ إلا سلَّطَ اللهُ عليهم عدوَّهم فاستنقَذوا بعضَ ما في أيديهم ، وما عطَّلوا كتابَ اللهِ وسنَّةَ نبيِّه ؛ إلا جعل اللهُ بأسَهم بينهم"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (4019) باختلاف يسير، والطبراني (12/446) (13619) مختصراً، والحاكم (8623) مطولاً باختلاف يسير","bab":"زكاة › عقوبة مانع الزكاة","dorar":"xjvYry2k"},{"id":"س-06132","fp":"90efe83e9a47","stateId":634,"easy":"إذا عطّلوا كتاب الله وسنة نبيه ← جعل الله بأسهم بينهم","cause":"وما عطَّلوا كتابَ اللهِ وسنَّةَ نبيِّه","result":"إلا جعل اللهُ بأسَهم بينهم","explicit":true,"otherNeedIds":[60],"ref":"صحيح الترغيب 2187","srcLabel":"ابن ماجه","text":["كيف أنتم إذا وقعت فيكم خمسٌ ؟ وأعوذ باللهِ أن تكون فيكم أو تُدرِكوها : ما ظهرتِ الفاحشةُ في قومٍ قطُّ يعملُ بها فيهم علانيةً ؛ إلا ظهر فيهم الطاعونُ والأوجاعُ التي لم تكن في أسلافِهم ، وما منع قومٌ الزكاةَ ؛ إلا مُنِعوا القطرَ من السماءِ ولولا البهائمُ لم يُمطَروا ، وما بخَس قومٌ المكيالَ والميزانَ ؛ إلا أُخِذوا بالسِّنينَ وشِدَّةِ المؤْنةِ وجَوْرِ السُّلطانِ ، ولا حكم أمراؤهم بغير ما أنزل اللهُ ؛ إلا سلَّطَ اللهُ عليهم عدوَّهم فاستنقَذوا بعضَ ما في أيديهم ، ",["وما عطَّلوا كتابَ اللهِ وسنَّةَ نبيِّه",1]," ؛ ",["إلا جعل اللهُ بأسَهم بينهم",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (4019) باختلاف يسير، والطبراني (12/446) (13619) مختصراً، والحاكم (8623) مطولاً باختلاف يسير","bab":"زكاة › عقوبة مانع الزكاة","dorar":"xjvYry2k"},{"id":"س-01557","fp":"63862224dc7c","stateId":635,"easy":"إذا شربت الأمة الخمر وأكلت الربا واتخذت القينات وقطعت الرحم ← يُمسخون خنازير","cause":"شُرْبَهم الخمْرَ، وأكْلَهم الرِّبا، ولُبْسَهم الحريرَ، واتِّخاذَهم القَيْناتِ، وقَطيعتَهم الرَّحِمَ","result":"فيُصبِحون قدْ مُسِخوا خَنازيرَ","explicit":true,"repOf":"س-01565","ref":"المستدرك على الصحيحين 8797","text":["يَبِيتُ قومٌ مِن هذه الأُمَّةِ على طَعامٍ وشَرابٍ ولَهْوٍ، ",["فيُصبِحون قدْ مُسِخوا خَنازيرَ",2],"، ولَيُخْسَفَنَّ بقَبائلَ فيها وفي دُورٍ فيها، حتَّى يُصبِحوا فيَقولُون: خُسِفَ اللَّيلةَ ببَني فُلانٍ، خُسِف اللَّيلةَ بدارِ بَني فُلانٍ، ولَيُرْسَلَنَّ عليهم حَصْباءُ حِجارةٍ كما أُرسِلَت على قَومِ لُوطٍ، على قَبائلَ فيها وعلى دُورٍ منها، ولَيُرْسَلَنَّ عليهم الرِّيحُ، قال: وإنَّ ",["شُرْبَهم الخمْرَ، وأكْلَهم الرِّبا، ولُبْسَهم الحريرَ، واتِّخاذَهم القَيْناتِ، وقَطيعتَهم الرَّحِمَ",1],"، قال: وذكَرَ خَصَلةً أُخرى، فنَسِيتُها."],"grade":"صحيح","narrator":"أبو  أمامة","muhaddith":"صحيح على شرط مسلم لجعفر، فأما فرقد فإنهما لم يخرجاه","takhrij":"أخرجه أبو داود الطيالسي في ((المسند)) (1233)، والخرائطي في ((مساوئ الأخلاق)) (271)، وأبو نعيم في ((حلية الأولياء)) (6/ 295) باختلاف يسير.","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"DoNtKbmI","merged":2,"otherRefs":["تحريم آلات الطرب 67 (صحيح)"]},{"id":"س-07488","fp":"79289fa322f1","stateId":635,"easy":"إذا استحل قوم الزنا والحرير والخمر والمعازف ← يمسخ الله بعضهم قردة وخنازير","cause":"يَسْتَحِلُّونَ الحِرَ والحَرِيرَ، والخَمْرَ والمَعازِفَ","result":"ويَمْسَخُ آخَرِينَ قِرَدَةً وخَنازِيرَ","explicit":true,"repOf":"س-01565","ref":"مدارج السالكين 2/101","text":["حديث  تحريمِ أصواتِ المعازفِ وأن في الأُمَّةِ من سيستحلُّها [يعني حديث:  لَيَكونَنَّ مِن أُمَّتي أقْوامٌ ",["يَسْتَحِلُّونَ الحِرَ والحَرِيرَ، والخَمْرَ والمَعازِفَ",1],"، ولَيَنْزِلَنَّ أقْوامٌ إلى جَنْبِ عَلَمٍ، يَرُوحُ عليهم بسارِحَةٍ لهمْ، يَأْتِيهِمْ -يَعْنِي الفقِيرَ- لِحاجَةٍ، فيَقولونَ: ارْجِعْ إلَيْنا غَدًا، فيُبَيِّتُهُمُ اللَّهُ ، ويَضَعُ العَلَمَ، ",["ويَمْسَخُ آخَرِينَ قِرَدَةً وخَنازِيرَ",2]," إلى يَومِ القِيامَةِ.]"],"grade":"صحيح","narrator":"[أبو مالك الأشعري]","muhaddith":"صحيح","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"gS2jAEJW","merged":4,"otherRefs":["تخريج سنن أبي داود 4039 (صحيح)","صحيح الترغيب 1864 (حسن)","صحيح الجامع 5466 (صحيح)"]},{"id":"س-01565","fp":"27a4e2345880","stateId":635,"easy":"إذا شربوا الخمور واتخذوا القينات وضربوا بالمعازف ← يكون الخسف والقذف والمسخ","cause":"إذا شرِبُوا الخمورَ ، و اتَّخذوا القَيْناتِ ، و ضربُوا بالمعازفِ","result":"خسفٌ ، و قذفٌ ، و مسخٌ","explicit":true,"similar":["س-01557","س-07488","س-07483","س-04841","س-06188"],"ref":"السلسلة الصحيحة 2203","srcLabel":"ابن أبي الدنيا","text":["لَيكوننَّ في هذه الأُمَّةِ ",["خسفٌ ، و قذفٌ ، و مسخٌ",2]," ، و ذلك ",["إذا شرِبُوا الخمورَ ، و اتَّخذوا القَيْناتِ ، و ضربُوا بالمعازفِ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرجه ابن أبي الدنيا في ((ذم الملاهي)) (7)","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"uCcQgvFT"},{"id":"س-07297","fp":"9cb625d3463e","stateId":635,"easy":"إذا فعلت الأمة خمس عشرة خصلة (من المنكرات) ← حل بها البلاء","cause":"إذا فعلتْ أمَّتي خمسَ عشرةَ خَصلةً","result":"فقد حلَّ بها البلاءُ","explicit":true,"ref":"الترغيب والترهيب 4/75","srcLabel":"الترمذي","text":[["إذا فعلتْ أمَّتي خمسَ عشرةَ خَصلةً ",1],["فقد حلَّ بها البلاءُ ",2],". قيل : وما هي يا رسولَ اللهِ ؟ قال : إذا كان المغنَمُ دُوَلًا ، وإذا كانت الأمانةُ مَغنمًا ، والزَّكاةُ مَغرمًا ، وأطاع الرَّجلُ زوجتَه ، وعقَّ أمَّه ، وبرَّ صديقَه ، وجفا أباه ، وارتفعت الأصواتُ في المساجدِ ، وكان زعيمُ القومِ أرذلَهم ، وأُكرِم الرَّجلُ مخافةَ شرِّه ، وشُرِبتِ الخمرُ ، ولُبِس الحريرُ ، واتُّخِذتِ القَيناتُ والمعازفُ ، ولعن آخرُ هذه الأمَّةِ أوَّلَها ، فليرتقِبوا عند ذلك ريحًا حمراءَ ، أو خسفًا ، أو مسخًا"],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (2210)، وابن أبي الدنيا في ((ذم الملاهي)) (5)، وابن حبان في ((المجروحين)) (2/138)، والطبراني في ((المعجم الأوسط)) (469","bab":"فتن › ظهور الفتن","dorar":"bjtKhOK0"},{"id":"س-07483","fp":"082bfe7ddcb8","stateId":635,"easy":"إذا ظهرت المعازف والقينات واستُحلت الخمر ← يكون الخسف والقذف والمسخ","cause":"إذا ظَهَرَتِ المعازِفُ والقَيْناتُ ، واسْتُحِلَّتِ الخمْرُ","result":"خَسْفُ وقذفٌ ومَسْخٌ","explicit":true,"repOf":"س-01565","ref":"صحيح الجامع 3665","text":["سيكونُ في آخرِ الزمانِ ",["خَسْفُ وقذفٌ ومَسْخٌ",2]," ، ",["إذا ظَهَرَتِ المعازِفُ والقَيْناتُ ، واسْتُحِلَّتِ الخمْرُ",1]],"grade":"صحيح","narrator":"سهل بن سعد الساعدي وأبو سعيد الخدري وعمران بن الحصين","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (6/ 150) (5810) واللفظ له.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"vdr2mKh4"},{"id":"س-04841","fp":"1f2b9f2e3d8a","stateId":635,"easy":"إذا بات قوم على أكل ولهو ولعب (بالمحرمات) ← يصبحون قردة وخنازير","cause":"لَيَبيتَنَّ أقوامٌ مِنَ أُمَّتِي على أكلٍ ولَهْوٍ ولعِبٍ","result":"ثُمَّ لَيُصْبِحُنَّ قردةً وخنازيرَ","explicit":true,"repOf":"س-01565","ref":"صحيح الجامع 5354","text":[["لَيَبيتَنَّ أقوامٌ مِنَ أُمَّتِي على أكلٍ ولَهْوٍ ولعِبٍ",1]," ، ",["ثُمَّ لَيُصْبِحُنَّ قردةً وخنازيرَ",2]],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"حسن","takhrij":"أخرجه الطبراني (8/ 256) (7997) واللفظ له، وابن أبي الدنيا في ((ذم الملاهي)) (3)، والبيهقي في ((شعب الإيمان)) (5226) مطولا.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"RbPbPF7m"},{"id":"س-06430","fp":"092901fad1cb","stateId":635,"easy":"إذا شربت الخمر ← فهي مفتاح كل شر","cause":"ولا تشربنَ خمرًا","result":"فإِنَّها مِفْتَاحُ كلِّ شَرٍّ","explicit":true,"otherNeedIds":[13],"ref":"صحيح الترغيب 571","srcLabel":"صحيح الترغيب","text":["لا تُشْرِكْ باللهِ شيئًا ، و إنْ قُطِّعْتَ و حُرِّقْتَ ، و لا تَعْصِ و الدَيْكَ ، وإنْ أمرَاكَ أنْ تُخَلِّيَ من أهلِكَ ودُنياكَ فتخلَ ، ",["ولا تشربنَ خمرًا ، ",1],["فإِنَّها مِفْتَاحُ كلِّ شَرٍّ",2]," ، و لا تَتْرُكَنَّ صَّلاةَ مُتَعَمِّدًا ، فمَنْ فعلَ ذلكَ فقد بَرِئَتْ مِنْهُ ذِمَّةُ رَسُولِه الحديث"],"grade":"حسن","narrator":"أميمة مولاة النبي وقيل هي أم أيمن","muhaddith":"حسن لغيره","bab":"صلاة › تارك الصلاة","dorar":"ZhFLBH14"},{"id":"س-06188","fp":"cd4ef97c0f98","stateId":635,"easy":"إذا ظهر التلاعن ولبس الحرير واتخاذ القينات وشرب الخمر واكتفى الرجال بالرجال ← فعليهم الدمار","cause":"إذا استعملَتْ أمَّتي خمسًا","result":"فعليهم الدَّمارُ : إذا ظهر فيهم التَّلاعُنُ ، ولُبسُ الحريرِ ، واتَّخذوا القَيْناتِ ، وشرِبوا الخمورَ ، واكتفَى الرِّجالُ بالرِّجالِ والنِّساءُ بالنِّساءِ","explicit":true,"repOf":"س-01565","ref":"شعب الإيمان 4/1912","text":[["إذا استعملَتْ أمَّتي خمسًا ",1],["فعليهم الدَّمارُ : إذا ظهر فيهم التَّلاعُنُ ، ولُبسُ الحريرِ ، واتَّخذوا القَيْناتِ ، وشرِبوا الخمورَ ، واكتفَى الرِّجالُ بالرِّجالِ والنِّساءُ بالنِّساءِ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده غير قوي وإذا ضم إلى غيره أخذ قوة","takhrij":"أخرجه الطبراني في ((مسند الشاميين)) (519)، وأبو نعيم في ((حلية الأولياء)) (6/123)، والبيهقي في ((شعب الإيمان)) (5467) واللفظ له","bab":"زينة اللباس › إباحة الذهب والحرير للنساء دون الرجال","dorar":"hhdtmjxp"},{"id":"س-04371","fp":"27d31d690d9e","stateId":636,"easy":"إذا لم يغزُ أهل بيت ولم يجهزوا غازياً ولم يخلفوه ← يصيبهم الله بقارعة قبل يوم القيامة","cause":"ما مِن أهْلِ بَيْتٍ لم يَغْزُ فيهم غازٍ أو يُجَهِّزوا غازِيًا أو يَخلُفوه في أهْلِه","result":"إلَّا أصابَهم اللهُ عَزَّ وجَلَّ بقارِعةٍ قبَلْ يَوْمِ القِيامةِ","explicit":true,"star":true,"similar":["س-04361","س-05165","س-05246"],"ref":"الأحاديث المختارة 2666","srcLabel":"متفق عليه","text":["«",["ما مِن أهْلِ بَيْتٍ لم يَغْزُ فيهم غازٍ أو يُجَهِّزوا غازِيًا أو يَخلُفوه في أهْلِه،",1]," ",["إلَّا أصابَهم اللهُ عَزَّ وجَلَّ بقارِعةٍ قبَلْ يَوْمِ القِيامةِ»",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"جهاد › الترغيب في الجهاد","dorar":"rt3tldB7"},{"id":"ق-0296","fp":"005a03f49c29","stateId":636,"easy":"النكول عن أمر الله والجبن عن الجهاد ← التيه أربعين سنة والحرمان","cause":"النكول عن أمر الله والجبن عن الجهاد","result":"التيه أربعين سنة والحرمان","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[60],"ref":"سورة المائدة: 24–26","srcLabel":"القرآن الكريم","quran":{"s":5,"from":24,"to":26,"text":"قَالُوا يَا مُوسَى إِنَّا لَنْ نَدْخُلَهَا أَبَدًا مَا دَامُوا فِيهَا فَاذْهَبْ أَنْتَ وَرَبُّكَ فَقَاتِلَا إِنَّا هَاهُنَا قَاعِدُونَ (24) قَالَ رَبِّ إِنِّي لَا أَمْلِكُ إِلَّا نَفْسِي وَأَخِي فَافْرُقْ بَيْنَنَا وَبَيْنَ الْقَوْمِ الْفَاسِقِينَ (25) قَالَ فَإِنَّهَا مُحَرَّمَةٌ عَلَيْهِمْ أَرْبَعِينَ سَنَةً يَتِيهُونَ فِي الْأَرْضِ فَلَا تَأْسَ عَلَى الْقَوْمِ الْفَاسِقِينَ (26)","hl":[[0,247,1]]}},{"id":"س-01736","fp":"195431f68b74","stateId":636,"easy":"إذا غللت ← تُرد عنك الراية والنصر (من قصة)","cause":"بغُلولِ رأسِ غَزالٍ مِن ذَهَبٍ","result":"فرُدَّتْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأحاديث المختارة 9 / 529","srcLabel":"متفق عليه","text":["«بَعَثَ نَبيٌّ صلَّى اللهُ عليه وسلَّمَ جَيْشًا ",["فرُدَّتْ",2]," رايتُه، ثُمَّ بَعَثَ فرُدَّتْ، ثُمَّ بَعَثَ فرُدَّتْ ",["بغُلولِ رأسِ غَزالٍ مِن ذَهَبٍ",1],"، فنَزَلَتْ: {وَمَا كَانَ لِنَبِيٍّ أَنْ يَغُلَّ}»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"أنبياء › عام","dorar":"JJUKsTPP"},{"id":"س-04361","fp":"977a5ed054f7","stateId":636,"easy":"إذا لم تغزُ ولم تجهز غازياً ولم تخلفه بخير ← يصيبك الله بقارعة","cause":"مَن لم يَغْزُ، أو يُجهِّزْ غازيًا، أو يَخلُفْ غازيًا في أهلِه بخيرٍ","result":"أصابَه اللهُ بقارعةٍ","explicit":true,"repOf":"س-04371","ref":"تخريج سنن أبي داود 2503","text":[["مَن لم يَغْزُ، أو يُجهِّزْ غازيًا، أو يَخلُفْ غازيًا في أهلِه بخيرٍ، ",1],["أصابَه اللهُ بقارعةٍ",2],". قال يزيدُ بنُ عبدِ ربِّه في حديثِه: قبلَ يومِ القيامةِ."],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2503)، وابن ماجه (2762)، والدارمي (2462) جميعا بلفظه،","bab":"جهاد › الترغيب في الجهاد","dorar":"UmM2xlCk"},{"id":"س-05165","fp":"f502c6fb0639","stateId":636,"easy":"إذا ترك قوم الجهاد ← يعمهم الله بالعذاب","cause":"ما تركَ قومٌ الجِهادَ","result":"إلَّا عَمَّهُمُ اللهُ بِالعذابِ","explicit":true,"repOf":"س-04371","otherNeedIds":[60],"ref":"السلسلة الصحيحة 2663","text":[["ما تركَ قومٌ الجِهادَ",1]," ",["إلَّا عَمَّهُمُ اللهُ بِالعذابِ",2]],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"يشهد له حديث العينة وهو حديث صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (3839)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"lLYOWtR7"},{"id":"س-05140","fp":"05541e8857f3","stateId":636,"easy":"إذا تثاقلت عن الجهاد ← يُمسك عنك المطر (أثر ابن عباس)","cause":"فتَثاقَلوا","result":"فأُمسِكَ عنهم المطرُ؛ وكان عذابَهُم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 2539","srcLabel":"أبو داوود","text":["سَألتُ ابنَ عبَّاسٍ رَضيَ اللهُ عنهُما عنْ قولِ اللهِ عزَّ وجلَّ: {إِلَّا تَنفِرُوا يُعَذِّبْكُمْ عَذَابًا أَلِيمًا} [التوبة: 39]، قالَ: استَنْفَرَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ حَيًّا مِن أَحياءِ العربِ، ",["فتَثاقَلوا",1],"، ",["فأُمسِكَ عنهم المطرُ؛ وكان عذابَهُم",2],"."],"grade":"صحيح","narrator":"نجدة بن نفيع","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داوود (2506)، والطبري، وابن أبي حاتم في ((تفسيره)) (10033) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"rJCuAuU2","merged":2,"otherRefs":["المستدرك على الصحيحين 2588 (صحيح)"]},{"id":"س-07331","fp":"2eac58116cee","stateId":636,"easy":"إذا تركت الجهاد للأموال ← فهي التهلكة","cause":"الإقامةَ في أمْوالِنا، وإصلاحَها، وتَرْكَنا الغَزوَ","result":"فكانتِ التَّهلُكةُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 30/429","srcLabel":"أبو داود","text":["كنَّا بمَدينةِ الرُّومِ، فأخرَجوا إلينا صَفًّا عَظيمًا مِن الرُّومِ، وخَرَجَ مِثلُه أو أكثرُ، وعلى أهلِ مِصرَ عُقْبةُ بنُ عامرٍ صاحِبُ رسولِ اللهِ صلي الله عليه وسلم فحَمَلَ رَجُلٌ مِن المُسلمينَ على صَفِّ الرُّومِ حتى دَخَلَ فيهم، فصاح به النَّاسُ، وقالوا: سُبحانَ اللهِ! تُلقي بيَدِكَ إلى التَّهلُكةِ؟! فقام أبو أيُّوبَ الأنصاريُّ، فقال: أيُّها النَّاسُ، إنَّكم تَتأوَّلونَ هذه الآيةَ على هذا التَّأْويلِ؛ إنَّما نَزَلَتْ هذه الآيةُ فينا مَعشرَ الأنصارِ، إنَّا لمَّا أعَزَّ اللهُ الإسلامَ، وكَثَّرَ ناصريه، قُلْنا بعضُنا لبعضٍ سِرًّا مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّ أمْوالَنا قد ضاعتْ، وإنَّ اللهَ قد أعَزَّ الإسلامَ، وكَثَّرَ ناصريه، فلو أقَمْنا في أمْوالِنا، فأصلَحْنا ما ضاع منَّا، فأنزَلَ اللهُ على نَبيِّه صلَّى اللهُ عليه وسلَّمَ يَرُدُّ علينا ما قُلْنا: {وَأَنْفِقُوا فِي سَبِيلِ اللَّهِ وَلَا تُلْقُوا بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ وَأَحْسِنُوا إِنَّ اللَّهَ يُحِبُّ الْمُحْسِنِينَ} [البقرة: 195]، ",["فكانتِ التَّهلُكةُ",2]," ",["الإقامةَ في أمْوالِنا، وإصلاحَها، وتَرْكَنا الغَزوَ",1],"، قال: وما زال أبو أيُّوبَ شاخصًا في سَبيلِ اللهِ، حتى دُفِنَ بأرضِ الرُّومِ."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2512)، والترمذي (2972)، والنسائي في ((السنن الكبرى)) (11029) باختلاف يسير، وابن حبان (4711) واللفظ له","bab":"فتن › فتنة المال","dorar":"mL3pbkWE","merged":2,"otherRefs":["تخريج مشكل الآثار 4685 (صحيح)"]},{"id":"س-03953","fp":"5382cf5daf8b","stateId":636,"easy":"إذا عصيت أمر الجهاد جبناً ← تُحرم الخير وتتيه (من قصة بني إسرائيل)","cause":"إِنَّا لَنْ نَدْخُلَهَا أَبَدًا مَا دَامُوا فِيهَا فَاذْهَبْ أَنْتَ وَرَبُّكَ فَقَاتِلَا","result":"فحرَّمَها عليهم أربعينَ سَنةً يَتِيهون في الأرضِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[57],"ref":"إتحاف الخيرة المهرة 6/234","srcLabel":"النسائي","text":["سألْتُ عبدَ اللهِ بنَ عبَّاسٍ رضِيَ اللهُ عنهما عن قولِ اللهِ عَزَّ وجَلَّ لموسى صَلَّى اللهُ عليه وسلَّمَ: {وَفَتَنَّاكَ فُتُونًا} [طه: 40]، فسألْتُه عن الفُتونِ؟ فقال: استأنِفِ النَّهارَ يا ابنَ جُبيرٍ؛ فإنَّ لها حديثًا طويلًا.\nقال: فغدوْتُ على ابنِ عبَّاسٍ لأنتجِزَ ما وَعَدني مِن حديثِ الفُتونِ، فقال: تذاكَرَ فِرعونُ وجُلساؤُه ما كان اللهُ عَزَّ وجَلَّ وعَدَ إبراهيمَ صَلَّى اللهُ عليه وسلَّمَ مِن أنْ يجعَلَ في ذُرِّيتَه أنبياءَ ومُلوكًا؛ فقال بعضُهم: إنَّ بني إسرائيلَ لينتظِرونَ ذلك ما يشُكُّون فيه، وقد كانوا يظنُّونَ أنَّه يُوسفُ بنُ يعقوبَ عليهما الصَّلاةُ والسَّلامُ، فلمَّا هلَكَ قالوا: ليس هكذا كان، إنَّ اللهَ عَزَّ وجَلَّ وعَدَ إبراهيمَ صَلَّى اللهُ عليه وسلَّمَ. قال فِرعونُ: فكيف تَرَونَ؟ فائْتَمَروا، واجتمَعوا أمْرَهم على أنْ يبعَثَ رِجالًا بالشِّفارِ، يَطُوفون في بني إسرائيلَ، فلا يَجِدون مولودًا ذكَرًا إلَّا ذَبَحوه، ففَعَلوا ذلك، فلمَّا أنْ رَأَوا أنَّ الكبارَ في بني إسرائيلَ يموتونَ بآجالِهم، والصِّغارَ يُذْبَحونَ، قالوا: أتوشِكونَ أنْ تُفْنوا بني إسرائيلَ، فتَصيروا إلى أنْ تُباشِروا مِن الأعمالِ والخدمةِ الَّتي كانوا يَكْفُونكم؟ فاقْتُلوا عامًا كلَّ مولودٍ ذكرٍ، فيقِلَّ نَباتُهم، ودَعُوا عامًا، فلا تَقْتلوا منهم أحدًا، فيشِبَّ الصِّغارُ مكانَ مَن يموتُ مِن الكبارِ، فإنَّهم لنْ يَكْثروا بمَن تَسْتحيون، فتخافوا مُكاثرتَهم إياكم، ولنْ يَفْنَوا بمَن تقتُلونَ، فتحتاجونَ إليهم، فأجْمَعوا أمْرَهم على ذلك، فحمَلَت أُمُّ موسى بهارونَ عليهما السَّلامُ العامَ الَّذي لا يُذْبَحُ فيه الغِلمانُ، فولدَتْه عَلانيةً، فلمَّا كان مِن قابلٍ حمَلَتْ بمُوسى عليه السَّلامُ، فوقَعَ في قلْبِها مِن الهَمِّ والحزنِ. فذلك مِن الفُتونِ يا ابنَ جُبيرٍ، ما دخَلَ عليه في دهو بَطْنِ أُمِّه ممَّا يُرادُ به، فأوحَى اللهُ تعالى إليها: {وَلَا تَخَافِي وَلَا تَحْزَنِي إِنَّا رَادُّوهُ إِلَيْكِ وَجَاعِلُوهُ مِنَ الْمُرْسَلِينَ} [القصص: 7]، وأمَرَها أنْ إذا ولَدَتْ أنْ تجعَلَه في تابوتٍ، ثمَّ تُلْقِيه في اليمِّ، فلمَّا ولَدَت فعَلَت ذلك به، فألْقَته في اليمِّ، فلمَّا توارى عنها ابنُها أتاها الشَّيطانُ، فقالت في نفْسِها: ما فعَلْتُ بابني؟! لو ذُبِحَ لبِثَ عندي فرأيْتُه وكفَّنْتُه، كان أحَبَّ إليَّ مِن أنْ أُلْقِيَه بيدي إلى دوابِّ البحرِ وحِيتانِه، وانتهى الماءُ به حتَّى أرفَأَ به عند فُرْضَةُ مُسْتَقى جواري امرأةِ فِرعونَ، فلمَّا رأيْنَه أخذْنَه، فهمَمْنَ أنْ يفتحْنَ التَّابوتَ، فقالت بعضُهنَّ: إنَّ في هذا مالًا، وإنَّا إنْ فتحْناه لم تُصدِّقْنا امرأةُ الملِكِ بما وجَدْنا فيه، فحمَلْنَه بهيئةٍ لم يُحرِّكْنَ منه شيئًا، دفعْنَه إليها، فلمَّا فتحَتْه رأتْ فيه غُلامًا، فأُلْقِيَ عليه منها محبَّةٌ لم تُلْقَ مثْلُها على البشَرِ قطُّ، وأصبَحَ فُؤَادُ أُمِّ موسى فارغًا مِن ذِكْرِ كلِّ شَيءٍ إلَّا مِن ذِكْرِ مُوسى عليه السَّلامُ، فلمَّا سمِعَ الذَّابِحونَ بأمْرِه أقبلوا بشِفارِهم إلى امرأةِ فرعونَ ليذبَحُوه -وذلك مِن الفُتونِ يا ابنَ جُبيرٍ- فقالت للذَّبَّاحينَ: أقِرُّوه؛ فإنَّ هذا الواحدَ لا يَزيدُ في بني إسرائيلَ حتَّى آتِيَ فِرعونَ فأسْتَوْهِبَه منه، فإنْ وهَبَه لي كنْتُم قد أحسنْتُم وأجمَلْتُم، وإنْ أمَرَ بذبْحِه لم أَلُمْكم، فأتَتْ به فرعونَ، فقالت: قُرَّةُ عينٍ لي ولك، قال فِرعونُ: يكونُ لك، فأمَّا لي فلا حاجةَ لي في ذلك. قال رسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ: والَّذي أحلِفُ به، لو أقَرَّ فِرعونُ بأنْ يكونَ له قُرَّةَ عينٍ كما أقَرَّت امرأتُه، لهداهُ اللهُ به كما هدى به امرأتَه، ولكنَّ اللهَ حرَمَه ذلك.\nفأرسَلَتْ إلى مَن حولَها، مِن كلِّ امرأةٍ لها لبنٌ، تختارُ لها ظِئرًا، فجعَلَ كلَّما أخذَتْه امرأةٌ منهنَّ، فترُضِعُه، لم يَقْبَلْ ثَدْيَها، حتَّى أشفَقَت عليه امرأةُ فِرعونَ أنْ يَمتنِعَ مِن اللَّبنِ فيموتَ، فأحْزَنَها ذلك، فأمرَتْ به، فأُخْرِجَ إلى السُّوقِ وتجمَّعَ النَّاسُ، تَرْجو أنْ تجِدَ له ظِئرًا يأخُذُ منها، فلم يَقْبَلْ، وأصبَحَتْ أُمُّ موسى والهةً، فقالت لأُخْتِه: قُصِّيه -يعني: أثَرَهُ- واطْلُبِيه، هل تسمعينَ له ذِكْرًا؟ أحيٌّ ابْني أمْ قد أكلَتْه الدَّوابُّ؟ ونسِيَت ما كان اللهُ عَزَّ وجَلَّ وعَدَها فيه، فبَصُرتْ به أختُه عن جُنُبٍ وهم لا يَشعُرونَ، والجُنُبُ: أنْ يبصِرَ الإنسانُ إلى الشَّيءِ البعيدِ وهو إلى جَنْبِه لا يشعُرُ به، فقالت مِن الفرحِ حين أعياهم الظُّؤارتُ: أنا {أَدُلُّكُمْ عَلَى أَهْلِ بَيْتٍ يَكْفُلُونَهُ لَكُمْ وَهُمْ لَهُ نَاصِحُونَ} [القصص: 12]، فأخَذُوها فقالوا: ما يُدريك ما نُصْحُهم له؟ هل يعرِفونَه؟ حتَّى شكُّوا في ذلك -فذلك مِن الفُتونِ يا ابنَ جُبيرٍ- فقالت: نصيحَتُهم له وشفقَتُهم عليه رغبةً في صِهر الـمَلِك، ورجاءَ مَنفعتِه، فأرْسَلوها، فانطلَقَتْ إلى أُمِّها فأخبرتْها الخبرَ، فجاءتْ أُمُّه، فلمَّا وضعَتْه في حِجْرِها، نزَا إلى ثَدْيِها، فمَصَّه حتَّى امتلَأَ جَنباهُ رِيًّا، وانطلَقَ البشيرُ إلى امرأةِ فرعونَ: أنْ قد وجَدْنا لابْنِك، فأرسَلَتْ إليها، فأُوتِيتْ بها وبه، فلمَّا رأت ما يصنَعُ، قالت لها: امْكُثي عندي؛ تُرْضِعي ابني هذا، فإنِّي لم أحجِبْه شيئًا قطُّ، فقالت أُمُّ مُوسى: لا أستطيعُ أنْ أدَعَ بيتي وولدي، فيَضيعَ، فإنْ طابتْ نفْسُك أنْ تُعْطِيَنه، فأذهَبَ به إلى مَنْزلي، فيكونَ معي لا آلوهُ خيرًا، فعلْتُ، وإلَّا فإنِّي غيرُ تاركةٍ بيتي وولدي، وذكَرَت أُمُّ مُوسى عليه السَّلامُ ما كان اللهُ عَزَّ وجَلَّ وعَدَها، فتعاسَرَت على امرأةِ فرعونَ، وأيقنَتْ بأنَّ اللهَ عَزَّ وجَلَّ يُنْجِزُ موعودَه، فرجَعَتْ إلى بيتِها بابنِها مِن يومِها، فأنبَتَه اللهُ نباتًا حسنًا، وحفِظَه لِمَا قد قَضى فيه، فلم يزَلْ بنو إسرائيلَ وهم في ناحيةِ القريةِ مُمْتنعينَ يَمْتنعونَ به مِن السُّخرةِ ما كان فيهم.\nفلمَّا تَرعرَعَ قالت امرأةُ فرعونَ لأُمِّ مُوسى: أريدُ أنْ تُرِيني ابني، فوعَدَتْها يومًا تُرِيها فيه إيَّاه، فقالتِ امرأةُ فِرعونَ لخُزَّانِها، وظُؤورتِها، وقَهارِمَتِها: لا يَبْقينَّ أحدٌ منكم إلَّا استقبَلَ ابني اليومَ بهَديَّةٍ وكَرامةٍ؛ لِأَرى ذلك فيه، وأنا باعثةٌ أمينًا يُحْصِي ما يصنَعُ كلُّ إنسانٍ منكم، فلم تَزَلِ الهدايا والكرامةُ والنِّحلةُ، تَستقبِلُه مِن حينِ خرَجَ مِن بيتِ أُمِّه إلى أنْ دخَلَ على امرأةِ فرعونَ، فلمَّا دخَلَ عليها بجَّلَتْه، وأكرمَتْه، وفرِحَت به، وأعجَبَها، ونحَلَت أُمَّه؛ لحُسْنِ أثَرِه، ثمَّ قالت: لآتيَنَّ به فِرعونَ، فليَنْحَلَنَّه، وليُكْرِمَنَّه، فلمَّا دخَلَتْ به عليه، جعَلَه في حِجْرِه، فتناوَلَ مُوسى لِحيةَ فرعونَ، فمَدَّها إلى الأرضِ، فقال الغواةُ مِن أعداءِ اللهِ لفرعونَ: ألَا ترى إلى ما وعَدَ اللهُ عَزَّ وجَلَّ إبراهيمَ نَبِيَّه عليه السَّلامُ أنَّه يرِثُك، ويَعْلوك، ويصرَعُك، فأرسَلَ إلى الذَّبَّاحينَ، وذلك مِن الفُتونِ يا ابنَ جُبيرٍ، بعدَ كلِّ بلاءٍ ابتُلِيَ به، أو أُرِيدَ به فُتونًا.\nفجاءت امرأةُ فِرعونَ تَسْعى إلى فرعونَ، فقالت: ما بدا لك في هذا الغلامِ الَّذي وهَبْتَه لي؟ قال: ألَا تَرَيْنَه يزعُمُ أنَّه يصرَعُني ويَعْلوني؟ قالت: اجْعَلْ بيني وبينك أمرًا تعرِفُ فيه الحقَّ؛ ائْتِ بجَمْرتينِ ولُؤلؤتَينِ، فقَرِّبْهما إليه، فإنْ بطَش باللُّؤلؤتَينِ واجتنَبَ الجَمْرتينِ، عرَفْتَ أنَّه يعقِلُ، وإنْ تَناوَلَ الجَمْرتَينِ ولم يُرِدِ اللُّؤلؤتَينِ، علِمْتَ أنَّ أحدًا لا يُؤثِرُ الجَمرتينِ على اللُّؤلؤتينَ وهو يعقِلُ، فقُرِّبَ ذلك إليه، فتناوَلَ الجَمرتَينِ، فانْتَزَعوهما مِن يَدِه، وخافت أنْ يحرِقَا يدَيْه، فقالت المرأةُ: ألَا ترى؟! فصرَفَه اللهُ عنه بعدما كان قد هَمَّ به، وكان الله عَزَّ وجَلَّ بالغًا فيه أمْرَه.\nفلمَّا بلَغَ أشُدَّه وصار مِن الرِّجالِ، لم يكُنْ أحدٌ مِن آلِ فِرعونَ يخلُصُ إلى أحدٍ مِن بني إسرائيلَ معه بظُلمٍ، ولا يخرُجُ حتَّى امْتَنعوا كلَّ الامتناعِ.\nفبينما مُوسى عليه السَّلامُ يَمْشي في ناحيةِ المدينةِ، إذ هو برجُلينِ يَقْتتلانِ؛ أحدُهما فرعونيٌّ، والآخرُ إسرائيليٌّ، فاستغاثَه الإسرائيليُّ على الفرعونيِّ، فغضِبَ مُوسى عليه السَّلامُ غضبًا شديدًا؛ لأنَّه تناوَلَ وهو يعلَمُ منزلةَ مُوسى عليه السَّلامُ مِن بَني إسرائيلَ، وحِفْظَه لهم، لا يعلَمُ النَّاسُ إلَّا إنَّما ذلك مِن الرَّضاعِ إلَّا أُمُّ مُوسى، إلَّا أنْ يكونَ اللهُ عَزَّ وجَلَّ أَطْلَعَ مُوسى عليه السَّلامُ مِن ذلك على ما لم يُطْلِعْ عليه غيرَه. فوكَزَ مُوسى عليه السَّلامُ الفرعونيَّ، فقتَلَه، وليس يراهما أحدٌ إلَّا اللهُ عَزَّ وجَلَّ، فقال مُوسى عليه السَّلامُ حين قتَلَ الرَّجلَ: هذا مِن عمَلِ الشَّيطانِ؛ إنَّه عدُوٌّ مُضِلٌّ مُبينٌ، ثمَّ قال: {رَبِّ إِنِّي ظَلَمْتُ}، إلى قولِه: {إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ} [القصص: 16].\n{فَأَصْبَحَ فِي الْمَدِينَةِ خَائِفًا يَتَرَقَّبُ} [القصص: 18] الأخبارَ، فأُتِيَ فِرعونُ فقيلَ: إنَّ بني إسرائيلَ قد قتَلَتْ رجُلًا مِن آلِ فرعونَ، فخُذْ لنا بحَقِّنا، ولا تُرخِّصْ لهم، فقال: ابْغُوني قاتِلَه ومَن شهِدَ عليه؛ فإنَّ الملِكَ وإنْ كان صَفْوُه مع قومِه، لا يستقيمُ له أنْ يُقِيدَ بغيرِ بيِّنةٍ، ولا ثَبَتٍ، فانْظُروا في عِلْمِ ذلك آخُذْ لكم بحَقِّكم، فبينا هم يَطوفونَ لا يَجِدونَ شيئًا، إذا موسى عليه السَّلامُ قد رأى في الغدِ ذلك الإسرائيليَّ يقتُلُ رجُلًا مِن آلِ فرعونَ آخرَ، فاستغاثَه الإسرائيليُّ على الفرعونيِّ، فصادَفَ مُوسى عليه السَّلامُ قد ندِمَ على ما كان منه، فكَرِهَ الَّذي رأى، فغضِبَ الإسرائيليُّ وهو يُريدُ أنْ يبطِشَ بالفرعونيِّ، فقال للإسرائيليِّ -لِمَا فعَلَ أمسِ واليومَ-: {إِنَّكَ لَغَوِيٌّ مُبِينٌ} [القصص: 18]. فنظَرَ الإسرائيليُّ إلى مُوسى عليه السَّلامُ بعدما قال له ما قال، فإذا هو غضبانُ كغضَبِه بالأمسِ الَّذي قتَلَ به الفرعونيَّ، فخاف أنْ يكونَ بعدما قال له: {إِنَّكَ لَغَوِيٌّ مُبِينٌ} إيَّاه أراد، ولم يكُنْ أراده، إنَّما أراد الفرعونيَّ، فخاف الإسرائيليُّ، فحاجَزَ الفرعونيَّ، فقال: {يَا مُوسَى أَتُرِيدُ أَنْ تَقْتُلَنِي كَمَا قَتَلْتَ نَفْسًا بِالْأَمْسِ} [القصص: 19]؟ وإنَّما قال ذلك؛ مخافةَ أنْ يكون إيَّاهُ أراد مُوسى عليه السَّلامُ أنْ يقتُلَه، فتنازَعَا. فانطلَقَ الفرعونيُّ إلى قومِه، فأخبَرَهم بما سمِعَ مِن الإسرائيليِّ مِن الخبرِ حين يقولُ: {أَتُرِيدُ أَنْ تَقْتُلَنِي كَمَا قَتَلْتَ نَفْسًا بِالْأَمْسِ} [القصص: 19]، فأرسَلَ فرعونُ الذَّبَّاحينَ ليقتُلوا موسى عليه السَّلامُ، فأخَذَ رُسلُ فرعونَ الطَّريقَ الأعظمَ يَمْشون على هَيئتِهم يطلُبونَ مُوسى عليه السَّلامُ، وهم لا يخافونَ أنْ يفوتَهم، فجاء رجُلٌ مِن شِيعَةِ مُوسى عليه السَّلامُ مِن أَقْصى المدينةِ، فاختصَرَ طريقًا قريبًا حتَّى سبَقَهم إلى موسى عليه السَّلامُ فأخْبَرَه. فذلك مِن الفُتونِ يا ابنَ جُبيرٍ.\nفخرَجَ مُوسى عليه السَّلامُ مُتوجِّهًا نحوَ مدينَ لم يلْقَ بلاءً قبلَ ذلك، وليس له علمٌ بالطَّريقِ إلَّا حُسْنَ الظَّنِّ بربِّه عَزَّ وجَلَّ، فإنَّه قال: {عَسَى رَبِّي أَنْ يَهْدِيَنِي سَوَاءَ السَّبِيلِ} [القصص: 22].\n{وَلَمَّا وَرَدَ مَاءَ مَدْيَنَ وَجَدَ عَلَيْهِ أُمَّةً مِنَ النَّاسِ يَسْقُونَ} إلى {تَذُودَانِ} [القصص: 23]، يعني بذلك: حابستَينِ غنَمَهما، فقال لهما: ما خطْبُكما مُعتزلتَينِ لا تَسْقيانِ مع النَّاسِ؟ قالتا: ليس لنا قُوَّةٌ نُزاحِمُ القومَ، وإنَّما ننتظِرُ فُضولَ حياضِهم، فسقى لهما، فجعَلَ يغرِفُ بالدَّلْوِ ماءً كثيرًا، حتَّى كانتا أوَّلَ الرِّعاءِ فراغًا، فانصرَفَتا بغنَمِهما إلى أبيهما، وانصرَفَ موسى عليه السَّلامُ، فاستظَلَّ بشجرةٍ، وقال: {رَبِّ إِنِّي لِمَا أَنْزَلْتَ إِلَيَّ مِنْ خَيْرٍ فَقِيرٌ} [القصص: 24]، فاستنكَرَ أبوهما سُرعةَ صُدورِهما بغنَمِهما حُفَّلًا بطانًا، فقال: إنَّ لكما اليومَ لشأنًا، فأخبَرَتَاه بما صنَعَ موسى عليه السَّلامُ، فأمَرَ إحداهما أنْ تَدْعُوَه له، فأتَتْ موسى عليه السَّلامُ فدَعَتْه، فلمَّا كلَّمَه قال: {لَا تَخَفْ نَجَوْتَ مِنَ الْقَوْمِ الظَّالِمِينَ} [القصص: 25]، ليس لفِرعونَ ولا لقومِه علينا سُلطانٌ، ولسْنا في مَمْلكتِه.\nقال: فقالت إحداهما: {يَا أَبَتِ اسْتَأْجِرْهُ إِنَّ خَيْرَ مَنِ اسْتَأْجَرْتَ الْقَوِيُّ الْأَمِينُ} [القصص: 26]، فاحتمَلَتْه الغَيرةُ على أنْ قال: وما يُدريكِ ما قُوَّتُه؟ وما أمانَتُه؟ قالت: أمَّا قُوَّتُه: فما رأيْتُ في الدَّلوِ حين سَقى لنا، لم أرَ رجُلًا قطُّ في ذلك المَسْقى أقوى منه، وأمَّا أمانَتُه: فإنَّه نظَرَ إليَّ حين أقبلْتُ إليه وشَخَصْتُ له، فلمَّا علِمَ إنِّي امرأةٌ، صوَّبَ رأْسَه لم يرفَعْه، ولم ينظُرْ إليَّ حتَّى بلَّغْتُه رِسالتَك، ثمَّ قال لي: امشِي خلفي، وانْعَتي لي الطَّريقَ، لم يفعَلْ هذا إلَّا وهو أمينٌ، فسُرِّيَ عن أبيها وصدَّقَها، وظَنَّ به الَّذي قالت له.\nفقال له: هل لك {أَنْ أُنْكِحَكَ إِحْدَى ابْنَتَيَّ هَاتَيْنِ}، إلى قوله: {مِنَ الصَّالِحِينَ} [القصص: 27]، ففعَلَ، فكانت على نَبِيِّ اللهِ موسى عليه السَّلامُ ثمانيَ سنينَ واجبةً، وكانت سنتانِ عِدَةً منه، فقَضَى اللهُ عَزَّ وجَلَّ عنه عِدَتَه فأتمَّها عشْرًا.\nقال سَعيدٌ: فلَقِيَني رجُلٌ مِن أهلِ النَّصرانيَّةِ مِن عُلمائِهم، فقال: هلْ تَدْري أيَّ الأجلينِ قضى مُوسى عليه السَّلامُ؟ قلْتُ: لا، وأنا يومئذٍ لا أدري، فلقِيتُ ابنَ عبَّاسٍ، فذكَرْتُ ذلك له، فقال: أمَا علِمْتَ أنَّ ثمانيًا كانت على نبيِّ اللهِ عليه السَّلامُ واجبةً، لم يكُنْ نبيُّ اللهِ ليَنْقُصَ منها شيئًا، وتعلَمُ أنَّ اللهَ عَزَّ وجَلَّ كان قاضيًا عن مُوسى عليه السَّلامُ عِدَتَه الَّتي وعَدَ، فإنَّه قضى عشْرَ سنينَ. فلقِيتُ النَّصرانيَّ، فأخبَرْتُه بذلك، فقال: الَّذي سألْتَه فأخبَرَك أعلَمُ منك بذلك؟ قلْتُ: أجلْ، وأَولى.\nفلمَّا سار مُوسى عليه السَّلامُ بأهلِه كان مِن أمْرِ النَّارِ ما قَصَّ اللهُ عليك في القُرآنِ، وأمْرِ العصا ويَدِه، فشكا إلى ربِّه عَزَّ وجَلَّ ما يتخوَّفُ مِن آلِ فرعونَ في القتيلِ، وعُقدةَ لسانِه، فآتاهُ اللهُ عَزَّ وجَلَّ سُؤْلَه، وحَلَّ عُقدةً مِن لسانِه، وأوحى اللهُ عَزَّ وجَلَّ إلى هارونَ عليه السَّلامُ، وأمَرَه أنْ يلقاهُ، واندفَعَ مُوسى عليه السَّلامُ بعصاهُ، حتَّى لقِيَ هارونَ عليه السَّلامُ، وانطلَقَا جميعًا إلى فرعونَ، فأقاما حِينًا على بابِه لا يُؤْذَنُ لهما، فقالا: إنَّا رسولَا ربِّك، قال: فمَن ربُّكما يا موسى؟ فأخبراهُ بالَّذي قَصَّ اللهُ عَزَّ وجَلَّ عليك في القُرآنِ، قال: فما تُريدانِ؟ وذكَّرَه القتيلَ، واعتذَرَ بما قد سمِعْتَ، وقال: أريدُ أنْ تُؤمِنَ باللهِ، وأنْ تُرْسِلَ معي بني إسرائيلَ، فأبى عليه، وقال: ائتِ بآيةٍ إنْ كنْتَ مِن الصَّادقينَ، فألقى عصاه فإذا هي حيَّةٌ عظيمةٌ، فازعةٌ، فاغرةٌ فاها، مُسرعةٌ إلى فرعونَ، فلمَّا رآها فِرعونُ قاصدةً إليه خافها، فاقتحَمَ عن سَريرِه، واستغاثَ بمُوسى عليه السَّلامُ أنْ يكُفَّها عنه، ففعَلَ، ثمَّ أخرَجَ يَدَه مِن جَيْبِه، فرآها بيضاءَ مِن غيرِ سُوءٍ، يعني: مِن غيرِ برَصٍ، فرَدَّها، فعادت إلى لونِها الأوَّلِ.\nفاستشارَ الملَأَ حولَه فيما رأى، فقالوا له: {هَذَانِ لَسَاحِرَانِ يُرِيدَانِ أَنْ يُخْرِجَاكُمْ مِنْ أَرْضِكُمْ} [طه: 63] الآيةَ، والمُثْلى: مُلْكُهم الَّذي هم فيه والعيشُ. فأَبَوا على مُوسى عليه السَّلامُ أنْ يُعْطُوه شيئًا ممَّا طلَبَ، وقالوا له: اجمَعْ لهما السَّحرةَ؛ فإنَّهم بأرضِك كثيرٌ، حتَّى نغلِبَ سِحْرَهما، وأرسَلَ في المدائنِ، فحُشِرَ له كلُّ ساحرٍ مُتعالمٍ، فلمَّا أَتَوا على فرعونَ، قالوا: ما يعمَلُ هذا السَّاحرُ؟ قالوا: يعمَلُ الحيَّاتِ، قالوا: فلا واللهِ ما أحدٌ في الأرضِ يعمَلُ السِّحرَ والحيَّاتِ والحبالَ والعِصِيَّ الَّذي نعمَلُ، فما أجْرُنا إنْ نحن غلَبْنا؟ قال لهم: أنتم أقاربي وخاصَّتي، وأنا صانعٌ إليكم كلَّ شَيءٍ أحببتم، فتَواعَدوا يومَ الزِّينةِ وأنْ يُحْشَرَ النَّاسُ ضُحًى.\nقال سعيدٌ: فحدَّثني ابنُ عبَّاسٍ: أنَّ يومَ الزِّينةِ اليومُ الَّذي أظهَرَ اللهُ عَزَّ وجَلَّ فيه مُوسى عليه السَّلامُ على فِرعونَ والسَّحرةِ هو يومُ عاشوراءَ.\nفلمَّا اجتمعوا في صَعيدٍ، قال النَّاسُ بعضُهم لبعضٍ: انطَلِقوا، فنتخبَّرْ هذا الأمْرَ، {لَعَلَّنَا نَتَّبِعُ السَّحَرَةَ إِنْ كَانُوا هُمُ الْغَالِبِينَ} [الشعراء: 40]، يعنون مُوسى وهارونَ عليهما السَّلامُ؛ استهزاءً بهما، فقالوا: يا موسى -لِقُدْرتِهم في أنفُسِهم بسِحْرِهم- إمَّا أنْ تُلْقِيَ، وإمَّا أنْ نكونَ نحن المُلْقينَ، قال: بل ألْقُوا. {فَأَلْقَوْا حِبَالَهُمْ وَعِصِيَّهُمْ وَقَالُوا بِعِزَّةِ فِرْعَوْنَ إِنَّا لَنَحْنُ الْغَالِبُونَ} [الشعراء: 44]، فرأى مُوسى عليه السَّلامُ مِن سِحْرِهم ما أوجَسَ في نفْسِه خِيفةً، فأوحى اللهُ عَزَّ وجَلَّ إليه: أنْ ألْقِ عصاك، فلمَّا ألقاها، صارت ثُعبانًا عظيمًا فاغرةً فاها، فجُعِلَتِ العِصِيُّ بدَعوةِ مُوسي عليه السَّلامُ تلتبِسُ بالحبالِ، حتَّى صارتْ جُرُزًا إلى الثُّعبانِ تَدخُل فيه، حتَّى ما أبقَتْ عصًا ولا حبلًا إلَّا ابتلعَتْه. فلمَّا عرَفَ السَّحرةُ ذلك، قالوا: لو كان هذا سِحرٌ لم يَبلُغْ مِن سِحرِنا كلَّ هذا، ولكنَّه أمْرٌ مِن اللهِ، آمنَّا باللهِ ربِّنا وما جاء به مُوسى عليه السَّلامُ، ونتوبُ إلى اللهِ عَزَّ وجَلَّ ممَّا كنَّا عليه. وكسَرَ اللهُ ظهْرَ فِرعونَ في ذلك الموطنِ وأشياعِه، وأظهَرَ الحقَّ، وبطَلَ ما كانوا يعمَلونَ، فغُلِبوا هنالك وانقَلَبوا صاغِرينَ. وامرأةُ فِرعونَ بارزةٌ مُتبذِّلَةٌ تَدْعو بالنَّصرِ لمُوسى عليه السَّلامُ على فِرعونَ، فمَن رآها مِن آلِ فرعونَ ظَنَّ أنَّها إنَّما تبذَّلَتْ للشفقةِ على فِرعونَ وأشياعِه، وإنَّما كان حُزْنُها وهمُّها لمُوسى عليه السَّلامُ. فلمَّا طال مُكْثُ مُوسى عليه السَّلامُ لمواعيدِ فِرعونَ الكاذبةِ، كلَّما جاءه بآيةٍ وعَدَه عندها أنْ يُرْسِلَ معه بني إسرائيلَ، فإذا مضَتْ أخلَفَ موعِدَه، وقال: هل يستطيعُ ربُّك أنْ يصنَعَ غيرَ هذا؟ فأرسَلَ اللهُ عليه وعلى قومِه الطُّوفانَ، والجرادَ، والقُمَّلَ، والضَّفادعَ، آياتٍ مُفصَّلاتٍ، كلُّ ذلك يَشْكو إلى موسى عليه السَّلامُ، ويطلُبُ إليه أنْ يكُفَّها عنه، ويُواثِقُه على أنْ يُرسِلَ معه بني إسرائيلَ، فإذا كَفَّ ذلك عنه، أخلَفَ موعِدَه ونكَثَ عهدَه. فأُمِرَ موسى عليه السَّلامُ بالخُروجِ بقومِه، فخرَجَ بهم ليلًا، فلمَّا أصبَحَ فرعونُ ورأى أنَّهم قد مَضَوا، أرسَلَ في المدائنِ حاشرينَ، فتبِعَهم بجُنودٍ عظيمةٍ كثيرةٍ، وأوحى اللهُ عَزَّ وجَلَّ إلى البحرِ: أنْ إذا ضرَبَك مُوسى بعصاهُ، فانفرِقْ له اثنتَيْ عشْرةَ فِرقةً، حتَّى يجوزَ موسى عليه السَّلامُ ومَن معه، ثمَّ الْتَئَمَ على مَن بقِيَ بعدُ مِن فرعونَ وأشياعِه، فنسِيَ مُوسى عليه السَّلامُ أنْ يضرِبَ البحرَ بالعصا، فانْتَهى إلى البحرِ وله قصيفٌ؛ مخافةَ أنْ يَضرِبَه موسى عليه السَّلامُ، وهو غافِلٌ، فيصيرَ عاصيًا اللهَ عَزَّ وجَلَّ. فلمَّا تراءى الجَمْعانِ وتقارَبَا، قال أصحابُ موسى: إنَّا لمُدْرَكونَ، افعَلْ ما أمرَكَ به ربُّك عَزَّ وجَلَّ؛ فإنَّك لم تكذِبْ ولم تُكْذَبْ، فقال: وعَدَني ربِّي عَزَّ وجَلَّ إذا أتيْتُ البحرَ، انفرَقَ لي اثنتيْ عشْرةَ فِرقةً حتَّى أُجاوزَه، ثمَّ ذكَرَ بعدَ ذلك العصا، فضرَبَ البحرَ بعصاه حين دنا أوائلُ جُندِ فرعونَ مِن أواخرِ جُندِ مُوسى عليه السَّلامُ، فانفرَقَ البحرُ كما أمَرَه اللهُ عَزَّ وجَلَّ، وكما وُعِدَ مُوسى عليه السَّلامُ، فلمَّا أنْ جاوَزَ موسى عليه السَّلامُ وأصحابُه البحرَ، ودخَلَ فِرعونُ وأصحابُه، الْتَقى عليهم البحرُ كما أُمِرَ. فلمَّا جاوَزَ مُوسى عليه السَّلامُ البحرَ، قال أصحابُه: إنَّا نخافُ ألَّا يكونَ فِرعونُ قد غرِقَ، فلا نُؤمِنُ بهلاكِه، فدعا ربَّه عَزَّ وجَلَّ، فأخرَجَه له ببدنه حتَّى استيْقَنوا بهلاكِه.\nثمَّ مَرُّوا بعدَ ذلك {عَلَى قَوْمٍ يَعْكُفُونَ عَلَى أَصْنَامٍ لَهُمْ قَالُوا يَا مُوسَى اجْعَلْ لَنَا إِلَهًا كَمَا لَهُمْ آلِهَةٌ} [الأعراف: 138]، إلى {وَبَاطِلٌ مَا كَانُوا يَعْمَلُونَ} [الأعراف: 139]، قد رأيتُمْ مِن العِبَرِ، وسمِعْتُم ما يَكْفيكم، ومَضَى. فأنزَلَهم مُوسى عليه السَّلامُ منزلًا، ثمَّ قال لهم: أطيعوا هارونَ عليه السَّلامُ؛ فإنِّي قد استخلفْتُه عليكم، وإنِّي ذاهبٌ إلى ربِّي عَزَّ وجَلَّ، وأجَّلَهم ثلاثينَ يومًا أنْ يَرجِعَ إليهم فيها، فلمَّا أتى ربَّه وأراد أنْ يُكلِّمَه ثلاثينَ يومًا، وقد صامهنَّ: ليلَهنَّ ونهارَهنَّ، وكرِهَ أنْ يُكلِّمَ ربَّه عَزَّ وجَلَّ ورِيحُ فَمِه رِيحُ فَمِ الصَّائمِ، فتناوَلَ مُوسى عليه السَّلامُ مِن نباتِ الأرضِ شيئًا فمضَغَه، فقال له ربُّه عَزَّ وجَلَّ حين لقاه: لِمَ أفطرْتَ؟ -وهو أعلَمُ بالَّذي كان- قال: يا ربِّ، إنِّي كرِهْتُ أنْ أُكلِّمَك إلَّا وفَمِي طيِّبُ الرِّيحِ، قال: أوما علِمْتَ يا مُوسى أنْ رِيحَ فَمِ الصَّائمِ أطيبُ عندي مِن رِيحِ المِسْكِ؟ ارجِعْ حتَّى تصومَ عشْرًا ثمَّ ائْتِني، ففعَلَ مُوسى عليه السَّلامُ ما أُمِرَ به.\nفلمَّا رأى قومُ مُوسى عليه السَّلامُ أنَّه لم يرجِعْ إليهم للأجَلِ ساءَهم ذلك، وكان هارونُ عليه السَّلامُ قد خطَبَهم، فقال لهم: خرجْتُم مِن مِصْرَ ولقومِ فرعونَ عندي عواري وودائعُ، ولكم فيهم مثلُ ذلك، وأنا أرى أنْ تحتَسِبوا ما لكم عندهم، ولا أحلَّ لكم وديعةً اسْتُودِعْتُمُوها، ولا عاريَّةً، ولسنا برادِّين إليهم شيئًا مِن ذلك، ولا مُمْسِكيه لأنفُسِنا، فحفَرَ حفيرًا، وأمَرَ كلَّ قومٍ عليهم شَيءٌ مِن ذلك؛ مِن متاعٍ أو حِليةٍ أنْ يَقْذِفوه في ذلك الحفيرِ، ثمَّ أوقَدَ عليه النَّارَ، فأحرَقَه، فقال: لا يكونُ لنا، ولا لهم.\nوكان السَّامريُّ رجلًا مِن قومٍ يَعْبُدون البقرَ جيرانٍ لهم، ولم يكُنْ مِن بني إسرائيلَ، فاحتملَ مع مُوسى عليه السَّلامُ وبني إسرائيلَ حين احْتملوا، فقُضِيَ له أنْ رأى أثرًا، فأخَذَ منه بقبْضَتِه، فمَرَّ بهارونَ، فقال له هارونُ عليه السَّلامُ: يا سامريُّ، ألَا تُلْقي ما في يدَيْك؟ وهو قابضٌ عليه لا يَراه أحدٌ طوالَ ذلك، فقال: هذه قبْضةٌ مِن أثرِ الرَّسولِ الَّذي جاوَزَ بكم البحرَ، ولا أُلْقيها لشَيءٍ إلَّا أنْ تَدْعُوَ اللهَ إذا ألقيْتُها أنْ تكونَ ما أُرِيدُ، فألْقاها، ودعا اللهَ هارونُ عليه السَّلامُ، فقال: أريدُ أنْ يكونَ عِجْلًا، واجتمَعَ ما كان في الحُفرةِ مِن متاعٍ له، أو حِلْيةٍ، أو نحاسٍ، أو حديدٍ، فصار عِجْلًا أجوفَ ليس فيه رُوحٌ، له خُوارٌ.\nقال ابنُ عبَّاسٍ: لا واللهِ ما كان له صوتٌ قطُّ، إنَّما كانت الرِّيحُ تدخُلُ مِن دُبُرِه وتخرُجُ مِن فَمِه، فكان ذلك الصَّوتُ مِن ذلك.\nفتفرَّقَ بنو إسرائيلَ فِرَقًا؛ فقالت فِرقةٌ: يا سامريُّ، ما هذا فأنت أعلَمُ به؟ قال: هذا ربُّكم عَزَّ وجَلَّ، ولكنَّ مُوسى عليه السَّلامُ أضَلَّ الطَّريقَ. وقالت فِرقةٌ: لا نُكذِّب بهذا حتَّى يرجِعَ إلينا مُوسى، فإنْ كان ربَّنا لم نكُنْ ضيَّعْناه وعجَزْنا فيه حِينَ رأيْناه، وإنْ لم يكُنْ ربَّنا، فإنَّا نتَّبِعُ قولَ مُوسى عليه السَّلامُ. وقالت فِرقةٌ: هذا عمَلُ الشَّيطانِ، وليس بربِّنا، ولا نُؤْمِنُ، ولا نُصدِّقُ.\nوأُشْرِبَ فِرقةٌ في قُلوبِهم التَّصديقَ بما قال السَّامريُّ في العجلِ، وأعْلَنوا التَّكذيبَ، فقال لهم هارونُ عليه السَّلامُ: {يَا قَوْمِ إِنَّمَا فُتِنْتُمْ بِهِ} [طه: 90]، وإنَّ ربَّكم ليس هكذا، قالوا: فما بالُ مُوسى عليه السَّلامُ؛ وعَدَنا ثلاثينَ يومًا ثمَّ أخلَفَنا، فهذه أربعونَ قد مَضَت؟! فقال سُفهاؤُهم: أخطَأَ ربَّه، فهو يطلُبُه ويتبَعُه. فلمَّا كلَّمَ اللهُ عَزَّ وجَلَّ مُوسى عليه السَّلامُ وقال له ما قال، أخبَرَه بما لقِيَ قومُه بعده. {فَرَجَعَ مُوسَى إِلَى قَوْمِهِ غَضْبَانَ أَسِفًا} [طه: 86]، وقال لهم ما سمِعْتُم في القُرآنِ وأخَذَ برأْسِ أخِيه، وألْقى الألواحَ مِن الغضَبِ، ثمَّ عذَرَ أخاه بعُذْرِه، واستغفَرَ له، وانصرَفَ إلى السَّامريِّ، فقال له: ما حمَلَك على ما صنعْتَ؟ قال: قبَضْتُ قبضةً مِن أثرِ الرَّسولِ وفطِنْتُ لها، وعُمِّيَت عليكم، فقَذفْتُها؛ وكذلك سوَّلَت لي نَفْسي.\nقال: {اذْهَبْ فَإِنَّ لَكَ فِي الْحَيَاةِ أَنْ تَقُولَ لَا مِسَاسَ وَإِنَّ لَكَ مَوْعِدًا لَنْ تُخْلَفَهُ وَانْظُرْ إِلَى إِلَهِكَ} إلى قولِه: {نَسْفًا} [طه: 97]، ولو كان إلهًا لم يُخْلَصْ إلى ذلك منه. فاستيقَنَ بنو إسرائيلَ بالفتنةِ، واغْتَبَطَ الَّذين كان رأيُهم فيه مثلَ رأيِ هارونَ عليه السَّلامُ، فقالوا بجماعتِهم لمُوسى عليه السَّلامُ: سَلْ لنا ربَّك عَزَّ وجَلَّ أنْ يفتَحَ لنا بابَ توبةٍ نصنَعُها؛ فيُكَفِّرَ عنَّا ما عمِلْنا، فاختارَ موسى عليه السَّلامُ قومَه سبعينَ رجُلًا لذلك -لا يأْلُو الخيرَ- خيارَ بني إسرائيلَ، ومَن لم يُشْرِكْ في العجلِ. فانطلَقَ بهم ليسأَلَ لهم التَّوبةَ، فرجَفَتْ بهم الأرضُ، فاستحيا نبيُّ اللهِ صَلَّى اللهُ عليه وسلَّمَ من قومِه ووفْدِه حين فُعِلَ بهم ما فُعِلَ، فقال: {رَبِّ لَوْ شِئْتَ أَهْلَكْتَهُمْ مِنْ قَبْلُ وَإِيَّايَ أَتُهْلِكُنَا بِمَا فَعَلَ السُّفَهَاءُ مِنَّا} [الأعراف: 155]، وفيهم مَن قد كان اللهُ عَزَّ وجَلَّ اطَّلَعَ على ما أُشْرِبَ قلبُه من حُبِّ العجلِ وإيمانِه به؛ فلذلك رجَفَت بهم الأرضُ.\nفقال: {وَرَحْمَتِي وَسِعَتْ كُلَّ شَيْءٍ فَسَأَكْتُبُهَا لِلَّذِينَ يَتَّقُونَ} [الأعراف: 156] إلى: {فِي التَّوْرَاةِ وَالْإِنْجِيلِ} [الأعراف: 157]، فقال: رَبِّ سألْتُك التَّوبةَ لقومي، فقلْتَ: إنَّ رحمتي كتبْتُها لقومٍ غيرِ قومي، فليتَكَ أخَّرْتَني حين تُخْرِجُني حيًّا في أُمَّةِ ذلك الرَّجلِ المرحومةِ، فقال اللهُ له: إنَّ توبتَهم أنْ يقتُلَ كلُّ رجُلٍ منهم مَن لقِيَ مِن والدٍ أو ولدٍ، فيقتُلَه بالسَّيفِ لا يُبَالي مَن قتَلَ في ذلك الموطنِ، وتاب أولئك الَّذين كان خفِيَ على موسى وهارونَ عليهما السلام ما اطَّلَعُ اللهُ عليهم من ذُنوبِهم، فاعتَرَفوا بها، وفعَلوا ما أُمِروا، وغفَرَ اللهُ للقاتِلِ والمقتولِ. ثمَّ سار بهم مُوسى عليه السَّلامُ مُتوجِّهًا نحوَ الأرضِ المُقدَّسةِ، وأخَذَ الألواحَ بعدما سكَتَ عنه الغضبُ، وأمَرَهم بالَّذي أُمِرَ به أنْ يُبَلِّغَهم من الوظائفِ، فثقُلَ ذلك عليهم، وأبَوا أنْ يُقِرُّوا بها، فنتَقَ اللهُ عليهم الجبلَ كأنَّه ظُلَّةٌ، ودنا منهم حتَّى خافوا أنْ يقَعَ عليهم، فأخَذُوا الكتابَ بأيمانِهم وهم يَصْغُون ينظُرونَ إلى الجبلِ والأرضِ، والكتابُ بأيديهم وهم يَنظُرونَ إلى الجبلِ؛ مخافةَ أنْ يقَعَ عليهم، ثمَّ مَضَوا إلى الأرضِ المُقدَّسةِ، فوَجَدوا مدينةَ قومٍ جبَّارينَ خَلْقُهم مُنْكرٌ، وذكَرَ من ثِمارِهم أمرًا عجَبًا من عِظَمِها، فقالوا: يا موسى، إنَّ فيها قومًا جبَّارينَ لا طاقةَ لنا بهم، ولا ندخُلُها ما داموا فيها، فإنْ يَخْرجوا منها فإنَّا داخِلونَ، قال رجُلانِ من الَّذين يَخافونَ مِن الجبَّارينَ: آمنَّا بمُوسى عليه السَّلامُ، فخرَجَا إليه، فقالا: نحنُ أعلَمُ بقومِنا، إنْ كنتُمْ إنَّما تَخافونَ ما رأيتُمْ من أجسامِهم وعدَدِهم، فإنَّهم لا قُلوبَ لهم، ولا مَنعةَ عندهم، فادْخُلوا عليهم البابَ، فإذا دخلْتُموه فإنَّكم غالِبونَ. ويقولُ أناسٌ: إنَّهما من قومِ مُوسى عليه السَّلامُ. وزعَمَ سعيدُ بنُ جُبيرٍ أنَّهما من الجبَّارينَ آمَنَا بمُوسى، بقولِه: {مِنَ الَّذِينَ يَخَافُونَ} [المائدة: 23]: إنَّما عَنى بذلك: مِن الَّذين يَخافونَ بني إسرائيلَ.\n{قَالُوا يَا مُوسَى ",["إِنَّا لَنْ نَدْخُلَهَا أَبَدًا مَا دَامُوا فِيهَا فَاذْهَبْ أَنْتَ وَرَبُّكَ فَقَاتِلَا",1]," إِنَّا هَاهُنَا قَاعِدُونَ} [المائدة: 24]، فأغْضَبوا مُوسَى عليه السَّلامُ، فدعا عليهم، وسمَّاهم فاسقينَ، ولم يدْعُ عليهم قبلَ ذلك؛ لِمَا رأى منهم من المعصيةِ وإساءتِهم حتَّى كان يومئذٍ، فاستجابَ اللهُ عَزَّ وجَلَّ له، فسمَّاهم كما سمَّاهم مُوسى عليه السَّلامُ فاسقينَ، ",["فحرَّمَها عليهم أربعينَ سَنةً يَتِيهون في الأرضِ",2],"؛ يُصْبِحون كلَّ يومٍ، فيَسِيرونَ ليس لهم قرارٌ، ثمَّ ظلَّلَ عليهم الغمامَ في التِّيهِ، وأنزَلَ عليهم المَنَّ والسَّلوى، وجعَلَ لهم ثيابًا لا تَبْلى، ولا تتَّسِخُ، وجعَلَ بين ظَهرِهم حَجرًا مُربَّعًا، وأمَرَ مُوسى عليه السَّلامُ فضرَبَه بعصاهُ، فانفجَرَ منه اثنتا عشْرةَ عينًا، في كلِّ ناحيةٍ ثلاثةُ أعينٍ، وأعلَمَ كلَّ سِبْطٍ عينَهم الَّتي يَشْربون منها، فلا يَرْتحِلونَ من مَنزلٍ إلَّا وجدوا ذلك الحجرَ منهم بالمكانِ الَّذي كان منه أمسِ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (11263)، وأبو يعلى (2618)، والطحاوي في ((شرح مشكل الآثار)) (66) بنحوه.","bab":"تفسير آيات › سورة طه","dorar":"n97bkyvU"},{"id":"س-05246","fp":"7ce455c00848","stateId":636,"easy":"إذا لم تغزُ أو تجهز غازياً أو تخلفه بخير ← يصيبك الله بقارعة قبل الموت","cause":"ما مِن مُسلِمٍ لا يَغْزو، أو يُجهِّزُ غازيًا، أو يَخلُفُه بخَيرٍ","result":"إلَّا أصابَهُ اللهُ بقارِعةٍ قبْلَ المَوتِ","explicit":true,"repOf":"س-04371","ref":"تخريج سير أعلام النبلاء 4/247","text":[["ما مِن مُسلِمٍ لا يَغْزو، أو يُجهِّزُ غازيًا، أو يَخلُفُه بخَيرٍ،",1]," ",["إلَّا أصابَهُ اللهُ بقارِعةٍ قبْلَ المَوتِ",2],"."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"رجاله ثقات خلا عبد الملك","takhrij":"أخرجه الطبراني في ((مسند الشاميين)) (796)، وابن عساكر في ((تاريخ دمشق)) (37/ 111) كلاهما بلفظ مقارب.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"8fu8SWyZ"},{"id":"س-07720","fp":"edcfe5a3dec6","stateId":637,"easy":"إذا كثر سؤالكم واختلافكم على أنبيائكم ← فبذلك هلك من قبلكم","cause":"بكثرةِ سؤالِهم واختلافِهم على أنبيائِهم","result":"فإنَّما هلَك الَّذينَ قبْلكم","explicit":true,"star":true,"similar":["س-07776","س-07373","س-03647","س-03745","س-07780"],"ref":"تخريج صحيح ابن حبان 3704","srcLabel":"متفق عليه","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم خطَب فقال ( يا أيُّها النَّاسُ إنَّ اللهَ قد افتَرض عليكم الحجَّ ) فقام رجلٌ فقال أكُلَّ عامٍ يا رسولَ اللهِ ؟ قال: فسكَت عنه حتَّى أعادها ثلاثَ مرَّاتٍ قال: ( لو قُلْتُ: نَعم، لوجَبَت، ولو وجَبَت ما قُمْتُم بها ذَرُوني ما تُرِكْتُم ",["فإنَّما هلَك الَّذينَ قبْلكم",2]," ",["بكثرةِ سؤالِهم واختلافِهم على أنبيائِهم",1]," فإذا نهَيْتُكم عن شيءٍ فاجتنِبوه وإذا أمَرْتُكم بشيءٍ فأتوا منه ما استطَعْتُم ) وذكَر أنَّ هذه الآيةَ الَّتي في المائدةِ نزَلت في ذلك: {يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَسْأَلُوا عَنْ أَشْيَاءَ إِنْ تُبْدَ لَكُمْ تَسُؤْكُمْ} [المائدة: 101]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (3704) واللفظ له، والبخاري (7288) بنحوه، دون: يا أيها الناس، إن الله فرض عليكم الحج...، ومسلم (1337) بنحوه.","bab":"قرآن › أسباب النزول","dorar":"BinpXJ0i","merged":6,"otherRefs":["تخريج صحيح ابن حبان 3705 (صحيح)","صحيح مسلم 1337 (صحيح)","تخريج المسند لشعيب 10531 (صحيح)","صحيح النسائي 2618 (صحيح)","صحيح أسباب النزول 103 (صحيح)"]},{"id":"س-07776","fp":"f2bab9941355","stateId":637,"easy":"إذا اختلفتم في القراءة ← فإنما أهلك من قبلكم الاختلاف","cause":"اخْتَلَفْنا في قِراءتِنا","result":"إنَّما أهْلَكَ مَنْ كان قَبْلَكُم الاخْتِلافُ","explicit":true,"repOf":"س-07720","otherNeedIds":[22,60],"ref":"المستدرك على الصحيحين 2926","text":["نحوَهُ: [أَقْرأَني رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ سورةَ {حم}، ورُحتُ إلى المسجدِ عَشِيَّةً، فجَلَسَ إليَّ رَهْطٌ، فقلتُ لرجُلٍ مِنَ الرَّهْطِ: اقرأْ علَيَّ، فإذا هو يَقرأُ حروفًا لا أقْرؤها، فقلتُ له: مَنْ أقْرَأَكَها؟ قالَ: أَقْرأَني رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ. فانطَلَقْنا إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وإذا عنده رجُلٌ فقلتُ: ",["اخْتَلَفْنا في قِراءتِنا",1],". وإذا وجْهُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ قد تغَيَّرَ، ووَجَدَ في نفْسِهِ، حين ذكَرْتُ له الاخْتِلافَ، فقالَ: «",["إنَّما أهْلَكَ مَنْ كان قَبْلَكُم الاخْتِلافُ",2],"». ثُمَّ أَسَرَّ إلى عَليٍّ، فقالَ عَليٌّ: إنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَأمُرُكم أنْ يَقرأَ علَيَّ كُلُّ رجُلٍ منكم كما عُلِّمَ، فانطَلَقْنا وكُلُّ رجُلٍ منَّا يَقرأُ حروفًا لا يَقرَؤها صاحِبُهُ.] قالَ فيه: فانطَلَقْنا إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وإذا عنده رجُلٌ، قالَ زِرٌّ: إنَّهم يَلْعَنونَهُ؛ يعني عليًّا."],"grade":"صحيح","narrator":"عبدالله","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن أبي شيبة ((مسنده)) (318)، وابن حبان (747)، باختلاف يسير، والبخاري (3476) مختصرا","bab":"قرآن › الاختلاف والمراء في القرآن","dorar":"5eqj2f3K","merged":12,"otherRefs":["صحيح الترمذي 2133 (حسن)","تخريج المسند لشاكر 6/39 (صحيح)","مجمع الزوائد 7/202 (حسن)","تفسير الطبري 1/17 (صحيح)","تخريج كتاب السنة 133 (حسن)","صحيح مسلم 2666 (صحيح)","تخريج المسند لشعيب 4322 (صحيح)","صحيح البخاري 5062 (صحيح)","تخريج المسند لشاكر 6/169 (صحيح)","تفسير الطبري 1/16 (صحيح)","تخريج المسند لشاكر 5/306 (صحيح)"]},{"id":"س-07373","fp":"5deed491265e","stateId":637,"easy":"إذا اختلفتم ← فإن من قبلكم اختلفوا فهلكوا","cause":"لا تَختلِفوا","result":"فإنَّ مَن قبلَكم اختلَفوا فيه فهلَكوا","explicit":true,"repOf":"س-07720","otherNeedIds":[60],"ref":"تخريج المسند لشعيب 3908","text":["سَمِعتُ رَجُلًا يَقرَأُ آيةً على غيرِ ما أقرَأَني رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فأخَذتُ بيَدِه، فأتَيتُ به النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فقال: كِلاكما قد أحسَنَ، قال: وغَضِبَ حتى عُرِفَ الغَضبُ في وَجهِه، قال شُعبَةُ: أكبرُ ظنِّي أنَّه قال: ",["لا تَختلِفوا؛ ",1],["فإنَّ مَن قبلَكم اختلَفوا فيه فهلَكوا",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه البخاري (2410)، والنسائي في ((السنن الكبرى)) (8095)، وأحمد (3908) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › أحوال النبي","dorar":"ek6Ln4Bl","merged":4,"otherRefs":["صحيح البخاري 3476 (صحيح)","صحيح البخاري 2410 (صحيح)","تخريج المسند لشاكر 6/5 (صحيح)"]},{"id":"س-03647","fp":"356b2dfbab63","stateId":637,"easy":"إذا كثرت المسائل والاختلاف على الأنبياء ← فهو ما أهلك من كان قبلكم","cause":"كَثرةُ مَسائِلِهم، واختِلافُهم على أنبيائِهم","result":"فإنَّما أهلَكَ الذينَ مِن قَبلِكُم","explicit":true,"repOf":"س-07720","ref":"صحيح مسلم 1337","text":["أنَّه سَمِعَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ما نَهَيتُكُم عنه فاجتَنِبوه، وما أمَرتُكُم به فافعَلوا منه ما استَطَعتُم؛ ",["فإنَّما أهلَكَ الذينَ مِن قَبلِكُم",2]," ",["كَثرةُ مَسائِلِهم، واختِلافُهم على أنبيائِهم",1],". [وفي روايةٍ]: ذَروني ما تَرَكتُكُم. وفي حَديثِ هَمَّامٍ: ما تُرِكتُم؛ فإنَّما هَلَكَ مَن كان قَبلَكُم، ثُمَّ ذَكَروا نَحوَ: حَديثِ الزُّهريِّ، عن سَعيدٍ وأبي سَلَمةَ، عن أبي هُرَيرةَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7288)، وابن ماجة (2)، وابن حبان (2106) بنحوه.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"5lb9a0SH","merged":2,"otherRefs":["مجمع الزوائد 1/163 (حسن)"]},{"id":"س-03745","fp":"01df8b719eec","stateId":637,"easy":"إذا أكثرت السؤال واختلفت على النبي ﷺ ← فبذلك هلك من كان قبلكم","cause":"ذَرُوني ما ترَكْتُكم","result":"فإنَّما هلَك مَن كان قبْلَكم بكثرةِ سؤالِهم واختلافِهم على أنبيائِهم ما نهَيْتُكم عنه فانتَهوا وما أمَرْتُكم به فَأْتُوا منه ما استطَعْتُم","explicit":true,"repOf":"س-07720","ref":"تخريج صحيح ابن حبان 18","text":[["ذَرُوني ما ترَكْتُكم ",1],["فإنَّما هلَك مَن كان قبْلَكم بكثرةِ سؤالِهم واختلافِهم على أنبيائِهم ما نهَيْتُكم عنه فانتَهوا وما أمَرْتُكم به فَأْتُوا منه ما استطَعْتُم )",2]," قال ابنُ عَجْلانَ : فحدَّثْتُ به أَبَانَ بنَ صالحٍ فقال لي : ما أجودَ هذه الكلمةَ قولَه : ( فَأْتُوا منه ما استطَعْتُم )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح رجاله رجال الشيخين ما عدا إبراهيم بن بشار الرمادي، وهو حافظ ثقة","takhrij":"أخرجه ابن حبان (3705) واللفظ له، والبخاري (7288) بنحوه مختصرا، ومسلم (1337) باختلاف يسير.","bab":"اعتصام بالسنة › ما يكره من كثرة السؤال وتكلف ما لا يعنيه","dorar":"4HQ0o04A","merged":2,"otherRefs":["تخريج صحيح ابن حبان 2106 (صحيح)"]},{"id":"س-07780","fp":"db9fd6099c54","stateId":637,"easy":"إذا اختلفتم على أنبيائكم وضربتم الكتاب بعضه ببعض ← فبهذا أُهلكت الأمم قبلكم","cause":"باختِلافِهم على أنبيائِهم، وضَربِهمُ الكُتُبَ بَعضَها ببَعضٍ","result":"بهذا أُهلِكَتِ الأُمُمَ مِن قَبلِكُم","explicit":true,"repOf":"س-07720","otherNeedIds":[21,22],"ref":"تخريج شرح الطحاوية 168","text":["«لَقد جَلَستُ أنا وأخي مَجلسًا ما أحِبُّ أنَّ لي به حُمْرَ النَّعَمِ، أقبَلتُ أنا وأخي، وإذا مَشيَخةٌ مِن أصحابِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم جُلوسٌ عِندَ بابٍ مِن أبوابِه، فكَرِهنا أن نُفرِّقَ بَينَهم، فجَلَسنا حُجرةً، إذ ذَكَروا آيةً مِنَ القُرآنِ، فتَمارَوا فيها، حَتَّى ارتَفعَت أصواتُهم، فخَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم مُغضَبًا، قدِ احمَرَّ وجهُه، يَرميهم بالتُّرابِ، ويَقولُ: مَهلًا يا قَومِ! ",["بهذا أُهلِكَتِ الأُمُمَ مِن قَبلِكُم",2],"؛ ",["باختِلافِهم على أنبيائِهم، وضَربِهمُ الكُتُبَ بَعضَها ببَعضٍ",1],"، إنَّ القُرآنَ لَم يَنزِلْ يُكَذِّبُ بَعضُه بَعضًا، بَل يُصَدِّقُ بَعضُه بَعضًا، فما عَرَفتُم مِنه فاعمَلوا به، وما جَهِلتُم مِنه فرُدُّوه إلى عالِمِه»"],"grade":"صحيح","narrator":"جد عمرو بن شعيب","muhaddith":"صحيح","takhrij":"أخرجه أحمد (6702)، وابن أبي أسامة في ((مسند الحارث)) (735) واللفظ لهما.","bab":"قرآن › الاختلاف والمراء في القرآن","dorar":"zaO2NpcS","merged":7,"otherRefs":["اقتضاء الصراط المستقيم 1/163 (صحيح)","صحيح الجامع 1322 (صحيح)","مجموع الفتاوى 24/171 (صحيح)","تخريج المسند لشاكر 11/26 (صحيح)","تخريج سير أعلام النبلاء 16/ 241 (حسن)","تخريج سير أعلام النبلاء 3/78 (حسن)"]},{"id":"س-07475","fp":"3ed38ef12a64","stateId":637,"easy":"إذا قاتلت في الفتنة اليوم ← يقتلك الله غداً","cause":"يُقاتِلُ في الفِتْنةِ اليومَ","result":"ويَقتُلُه اللهُ غدًا","explicit":true,"ref":"المستدرك على الصحيحين 2705","srcLabel":"الطبراني","text":["عنْ أَبي ثَوْرٍ الحُدَّانيِّ قالَ: بَعَثَ عُثمانُ بنُ عَفَّانَ يومَ الجَرَعَةِ سعيدَ بنَ العاصِ إلى الكوفةِ، قالَ: فخَرَجوا إليه فرَدُّوه، قالَ: وكنتُ قاعِدًا مع ابنِ مسعودٍ وحُذَيفَةَ، فقالَ ابنُ مسعودٍ: ما كنتُ أَرى أنْ يَرجِعَ هؤلاء، ولمْ يُهْرَقْ فيها مِحْجَمةٌ مِن دَمٍ، وما عَلِمتُ مِن ذلك شيئًا إلَّا شيئًا عَلِمتُه، ومُحمَّدٌ صلَّى اللهُ عليه وسلَّمَ حَيٌّ أنَّ الرَّجلَ يُصبِحُ مؤمِنًا، ويُمسي وما معه شيءٌ، ويُمسي مؤمِنًا، ويُصبِحُ وما معه شيءٌ، ",["يُقاتِلُ في الفِتْنةِ اليومَ",1],"، ",["ويَقتُلُه اللهُ غدًا",2],"، يَنكُسُ قَلبُه وتَعْلوهُ استُه، قلتُ: أسفَلُه، قالَ: بل استُه."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني (17/ 253)، (703) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"uvgVUtjx","merged":3,"otherRefs":["مجمع الزوائد 7/236 (صحيح)","المستدرك على الصحيحين 8570 (صحيح)"]},{"id":"س-07493","fp":"4eb530cc2bc2","stateId":637,"easy":"إذا تعلم الناس القرآن فتأولوه على غير ما أنزل الله ← فهو هلاك الأمة","cause":"يتعلَّمونَ القرآنَ فيتأوَّلونَهُ على غيرِ ما أنزَلَ اللهُ","result":"هلاكُ أُمَّتي","explicit":true,"otherNeedIds":[21],"ref":"السلسلة الصحيحة 2778","srcLabel":"أحمد","text":[["هلاكُ أُمَّتي",2]," في الكِتابِ واللَّبَنِ، قالوا: يا رسولَ اللهِ، ما الكِتابُ واللَّبَنُ؟ قال: ",["يتعلَّمونَ القرآنَ فيتأوَّلونَهُ على غيرِ ما أنزَلَ اللهُ",1]," عزَّ وجلَّ، ويُحِبُّونَ اللَّبَنَ فيَدَعونَ الجماعاتِ والجُمَعَ ويَبْدُونَ."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17415)، وأبو يعلى (1746)، وابن عبدالبر في ((جامع بيان العلم وفضله)) (2359)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"PDj6GIAR","merged":2,"otherRefs":["تخريج العواصم والقواصم 6/ 178 (حسن)"]},{"id":"س-07494","fp":"6125cadf386f","stateId":637,"easy":"إذا أحب الناس اللبن (البادية) فتركوا الجماعات والجمع ← فهو هلاك الأمة","cause":"ويُحِبُّونَ اللَّبَنَ فيَدَعونَ الجماعاتِ والجُمَعَ ويَبْدُونَ","result":"هلاكُ أُمَّتي","explicit":true,"ref":"السلسلة الصحيحة 2778","srcLabel":"أحمد","text":[["هلاكُ أُمَّتي",2]," في الكِتابِ واللَّبَنِ، قالوا: يا رسولَ اللهِ، ما الكِتابُ واللَّبَنُ؟ قال: يتعلَّمونَ القرآنَ فيتأوَّلونَهُ على غيرِ ما أنزَلَ اللهُ عزَّ وجلَّ، ",["ويُحِبُّونَ اللَّبَنَ فيَدَعونَ الجماعاتِ والجُمَعَ ويَبْدُونَ",1],"."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17415)، وأبو يعلى (1746)، وابن عبدالبر في ((جامع بيان العلم وفضله)) (2359)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"PDj6GIAR"},{"id":"س-05932","fp":"c72b73c6645f","stateId":637,"easy":"إذا تفرقتم ← فالفرقة عذاب","cause":"والفُرقةُ","result":"عذابٌ","explicit":true,"otherNeedIds":[60],"ref":"تخريج كتاب السنة 895","srcLabel":"أبن","text":["أن النبيَّ خطب فقال : الجماعةُ رحمةٌ ",["والفُرقةُ",1]," ",["عذابٌ",2]],"grade":"حسن","narrator":"النعمان بن بشير","muhaddith":"إسناده حسن","takhrij":"أخرجه أبن أبي عاصم في ((السنة)) (895)، وابن بطة في ((الإبانة)) (117)، والقضاعي في ((مسند الشهاب)) (15) جميعا بلفظه","bab":"رقائق وزهد › الوصايا النافعة","dorar":"4oZliEJJ"},{"id":"س-07657","fp":"a14db20b5bc6","stateId":637,"easy":"إذا كذبت الأمة بالقدر ← يكون فيها خسف ومسخ","cause":"في المُكَذِّبينَ بالقدَرِ","result":"يَكونُ في أمَّتي خَسفٌ ، ومَسخٌ","explicit":true,"ref":"هداية الرواة 102","srcLabel":"الترمذي","text":[["يَكونُ في أمَّتي خَسفٌ ، ومَسخٌ",2]," ، وذلِكَ ",["في المُكَذِّبينَ بالقدَرِ",1]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"إسناده حسن","takhrij":"أخرجه الترمذي (2153) واللفظ له، وابن ماجه (4061) باختلاف يسير، وأحمد (6208) بنحوه","bab":"قدر › التكذيب بالقدر","dorar":"zReyhSqi"},{"id":"س-07346","fp":"45f33534f49c","stateId":637,"easy":"إذا اختلفتم في الغنيمة وساءت أخلاقكم ← ينتزعها الله منكم","cause":"اختلَفنا في الغنيمةِ وساءت أخلاقُنا","result":"انتزعَها اللَّهُ منَّا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"فتح الباري لابن حجر 730/6","srcLabel":"فتح الباري لابن حجر","text":["عن عُبادةَ بنِ الصَّامتِ قالَ: فلمَّا ",["اختلَفنا في الغنيمةِ وساءت أخلاقُنا",1]," ",["انتزعَها اللَّهُ منَّا",2]," فجعلَها لرسولِهِ فقَسمَها على النَّاسِ سواءٍ"],"grade":"حسن","muhaddith":"إسناده حسن يحتج بمثله","bab":"فتن › كراهية الاختلاف","dorar":"b4oHy0bU"},{"id":"س-07284","fp":"fd631e886813","stateId":637,"easy":"إذا اقتتل المسلمون ← يركبون سنن من كان قبلهم في الهلاك","cause":"وإنْ يَقتَتِلوا","result":"يَركَبوا سُنَنَ مَن كان قبلَهم","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج مشكل الآثار 1612","srcLabel":"أبو داود","text":["إنَّ رَحى الإسلامِ ستَزولُ بعدَ خَمسٍ وثلاثينَ، فإنْ يَصطَلِحوا فيما بينَهم على غيرِ قتالٍ يَأكُلوا الدُّنيا سَبعين عامًا رَغدًا، ",["وإنْ يَقتَتِلوا",1]," ",["يَركَبوا سُنَنَ مَن كان قبلَهم",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4254)، وأحمد (3707) باختلاف يسير","bab":"فتن › ظهور الفتن","dorar":"UyCZBOkr"},{"id":"س-04594","fp":"fd7912c31dd5","stateId":638,"easy":"إذا تُرك الشريف إذا سرق وأُقيم الحد على الضعيف ← فهو ما أهلك من قبلكم","cause":"إذا سَرَقَ فيهمِ الشَّريفُ تَرَكوه","result":"فإنَّما أهلَكَ الذينَ مِن قَبلِكُم","explicit":true,"star":true,"ref":"صحيح مسلم 1688","srcLabel":"البخاري","text":["أنَّ قُرَيشًا أهَمَّهُم شَأنُ المَرأةِ التي سَرَقَت في عَهدِ النَّبيِّ صلَّى اللهُ عليه وسلَّم في غَزوةِ الفَتحِ، فقالوا: مَن يُكَلِّمُ فيها رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم؟ فقالوا: ومَن يَجتَرِئُ عليه إلَّا أُسامةُ بنُ زَيدٍ حِبُّ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فأُتيَ بها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فكَلَّمَه فيها أُسامةُ بنُ زَيدٍ، فتَلَوَّنَ وجْهُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: أتَشفَعُ في حَدٍّ مِن حُدودِ اللهِ؟ فقال له أُسامةُ: استَغفِرْ لي يا رَسولَ اللهِ، فلَمَّا كان العَشيُّ قامَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فاختَطَبَ، فأثنى على اللهِ بما هو أهلُه، ثُمَّ قال: أمَّا بَعدُ، ",["فإنَّما أهلَكَ الذينَ مِن قَبلِكُم",2]," أنَّهُم كانوا ",["إذا سَرَقَ فيهمِ الشَّريفُ تَرَكوه",1],"، وإذا سَرَقَ فيهمِ الضَّعيفُ أقاموا عليه الحَدَّ، وإنِّي والذي نَفسي بيَدِه، لو أنَّ فاطِمةَ بنتَ مُحَمَّدٍ سَرَقَت لَقَطَعتُ يَدَها، ثُمَّ أمَرَ بتلك المَرأةِ التي سَرَقَت، فقُطِعَت يَدُها. قال يونُسُ: قال ابنُ شِهابٍ: قال عُروةُ: قالت عائِشةُ: فحَسُنَت تَوبَتُها بَعدُ وتَزَوَّجَت، وكانَت تَأتيني بَعدَ ذلك فأرفَعُ حاجَتَها إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6788)، وأبو داود (4373)، والترمذي (1430)، والنسائي (4901) جميعا باختلاف يسير.","bab":"حدود › حد السرقة ونصابها","dorar":"jtczzCMO","merged":7,"otherRefs":["تخريج مشكل الآثار 2301 (صحيح)","صحيح النسائي 4912 (صحيح)","صحيح النسائي 4915 (صحيح)","صحيح البخاري 6787 (صحيح)","صحيح النسائي 4910 (صحيح)","صحيح البخاري 3733 (صحيح)"]},{"id":"س-08077","fp":"44b42450f025","stateId":638,"easy":"إذا لم يُؤخذ للضعيف من القوي ← فكيف يقدّس الله قوماً","cause":"لا يُؤخَذُ لضعيفِهم مِن شديدِهم","result":"كيف يُقدِّسُ اللهُ قومًا","explicit":true,"repOf":"س-01671","otherNeedIds":[28],"ref":"صحيح ابن حبان 5058","text":["لمَّا رجَعتْ مُهاجِرةُ الحبشةِ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم قال: ( ألَا تُحدِّثوني بأعجَبِ ما رأَيْتُم بأرضِ الحبشةِ ؟ ) قال فتيةٌ منهم: يا رسولَ اللهِ بينما نحنُ جلوسٌ مرَّت علينا عجوزٌ مِن عجائزِهم تحمِلُ على رأسِها قُلَّةً مِن ماءٍ فمرَّت بفتًى منهم فجعَل إحدى يدَيْه بيْنَ كتِفَيْها ثمَّ دفَعها على رُكبتَيْها فانكسَرتْ قُلَّتُها فلمَّا ارتفعَتِ التفتَت إليه ثمَّ قالت: ستعلَمُ يا غُدَرُ إذا وضَع اللهُ الكُرسيَّ وجمَع الأوَّلينَ والآخِرينَ وتكلَّمتِ الأيدي والأرجُلُ بما كانا يكسِبونَ فسوف تعلَمُ أمري وأمرَك عندَه غدًا فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( صدَقتْ ثمَّ صدَقتْ ",["كيف يُقدِّسُ اللهُ قومًا",2]," ",["لا يُؤخَذُ لضعيفِهم مِن شديدِهم",1]," )"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن ماجه (4010)، وابن أبي الدنيا في ((الأهوال)) (243)، وأبو يعلى (2003) واللفظ لهم جميعا.","bab":"مظالم › قصاص المظالم","dorar":"nMT6V3cy","merged":10,"otherRefs":["صحيح الجامع 1858 (صحيح)","مجمع الزوائد 4/143 (صحيح)","صحيح الترغيب 2191 (صحيح)","تخريج كتاب السنة 582 (صحيح)","هداية الرواة 2937 (صحيح)","مجمع الزوائد 5/212 (حسن)","صحيح الترغيب 1816 (صحيح)","مجمع الزوائد 4/200 (حسن)","صحيح الجامع 1857 (صحيح)"]},{"id":"س-06164","fp":"858489f78d0f","stateId":638,"easy":"إذا كنت أميراً فتظالم الناس ولم تأخذ لبعضهم من بعض ← ينتقم الله منك","cause":"إذا كانَ أميرًا فتظالَمَ النَّاسُ بينَهم، فلم يأخُذْ لبعضِهم مِن بعضٍ","result":"انتقَمَ اللهُ منه","explicit":true,"ref":"مجمع الزوائد 5/204","srcLabel":"البخاري","text":["بعَثَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ عَمرَو بنَ العاصِ على جيشِ ذاتِ السلاسلِ، فبعَثَ معه في ذلك الجَيشِ  أبا بَكْرٍ وعُمَرَ وسَراةَ أصحابِه، فانطَلَقوا حتى نزَلوا جبلَ طَيِّئٍ، فقال عَمرٌو: انظُروا إلى رجُلٍ دليلٍ بالطَّريقِ. فقالوا: ما نعلَمُه إلَّا رافعَ بنَ عَمرٍو؛ فإنَّه كان رَبيلًا، فسأَلتُ طارقًا: ما الرَّبيلُ؟ قال: اللِّصُ الذي يَغْزو القومَ وحْدَه فيسرِقُ. قال رافعٌ: فلمَّا قضَيْنا غَزاتَنا، وانتهَيتُ إلى المكانِ الذي كنَّا خرَجْنا منه توسَّمتُ أبا بَكْرٍ فأتَيتُه، فقلتُ: يا صاحبَ [الخلال] ، إنِّي توسَّمتُكَ مِن بينِ أصحابِكَ، فائْتِني بشيءٍ إذا حفِظتُه كنتُ منكم ومِثلَكم. فقال: أتحفَظُ أصابِعَكَ الخمْسَ؟ قلتُ: نعَمْ. قال: أشهدُ أنْ لا إلهَ إلَّا اللهُ وحدَه لا شريكَ له، وأنَّ مُحمَّدًا عبدُه ورسولُه، وتقيمُ الصَّلاةَ، وتُؤتي الزكاةَ إنْ كان لكَ مالٌ، وتحُجُّ البَيتَ، وتصومُ رمضانَ. حفِظتَ؟ فقلتُ: نعَمْ. قال: وأُخرى: لا تأمَّرنَّ على اثنينِ. قلتُ: وهل تكونُ الإمْرةُ إلَّا فيكم أهلَ بدرٍ؟ قال: يوشِكُ أنْ تفشوَ حتى تبلُغَكَ ومَن هو دونَكَ، إنَّ اللهَ عزَّ وجلَّ لمَّا بعَثَ نبيَّه صلَّى اللهُ عليه وسلَّمَ دخَلَ النَّاسُ في الإسلامِ، فمنهم مَن دخَلَ فهداه اللهُ، ومنهم مَن أكرَهَه السَّيفُ، فهم عُوَّادُ اللهِ عزَّ وجلَّ وجيرانُ اللهِ في خِفارةِ اللهِ، إنَّ الرجُلَ ",["إذا كانَ أميرًا فتظالَمَ النَّاسُ بينَهم، فلم يأخُذْ لبعضِهم مِن بعضٍ",1]," ",["انتقَمَ اللهُ منه",2],"، إنَّ الرجُلَ منكم لتؤخَذُ شاةُ جارِه، فيظَلُّ ناتِئَ عَضَلتِه غَضبًا لجارِه، واللهُ مِن وراءِ جارِه. قال رافعٌ: فمكَثتُ سنةً، ثمَّ إنَّ أبا بَكْرٍ استُخلِفَ، فركَنتُ إليه، قلتُ: أنا رافعٌ، كنتُ نَقيبَكَ بمكانِ كذا وكذا. قال: عرَفتُ. قال: كنتَ نهَيتَني عن الإمارةِ، ثمَّ ركبِتَ أعظَمَ مِن ذلكَ، أُمَّةَ مُحمَّدٍ صلَّى اللهُ عليه وسلَّمَ؟! قال: نعَمْ، فمَن لم يُقِمْ فيهم كتابَ اللهِ، فعليه بَهلةُ اللهِ. يَعْني: لعنةَ اللهِ."],"grade":"حسن","narrator":"رافع بن عمرو الطائي","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني (5/ 21) (4467) واللفظ له، والبخاري في ((التاريخ الكبير)) (6/ 24)، والنسائي في ((فضائل الصحابة)) (16) مختصرا.","bab":"زكاة › فرض الزكاة","dorar":"S9eBzz3d"},{"id":"س-06131","fp":"aabd50b9e571","stateId":638,"easy":"إذا حكم الأمراء بغير ما أنزل الله ← سلط الله عليهم عدوهم","cause":"ولا حكم أمراؤهم بغير ما أنزل اللهُ","result":"إلا سلَّطَ اللهُ عليهم عدوَّهم فاستنقَذوا بعضَ ما في أيديهم","explicit":true,"otherNeedIds":[44],"ref":"صحيح الترغيب 2187","srcLabel":"ابن ماجه","text":["كيف أنتم إذا وقعت فيكم خمسٌ ؟ وأعوذ باللهِ أن تكون فيكم أو تُدرِكوها : ما ظهرتِ الفاحشةُ في قومٍ قطُّ يعملُ بها فيهم علانيةً ؛ إلا ظهر فيهم الطاعونُ والأوجاعُ التي لم تكن في أسلافِهم ، وما منع قومٌ الزكاةَ ؛ إلا مُنِعوا القطرَ من السماءِ ولولا البهائمُ لم يُمطَروا ، وما بخَس قومٌ المكيالَ والميزانَ ؛ إلا أُخِذوا بالسِّنينَ وشِدَّةِ المؤْنةِ وجَوْرِ السُّلطانِ ، ",["ولا حكم أمراؤهم بغير ما أنزل اللهُ",1]," ؛ ",["إلا سلَّطَ اللهُ عليهم عدوَّهم فاستنقَذوا بعضَ ما في أيديهم",2]," ، وما عطَّلوا كتابَ اللهِ وسنَّةَ نبيِّه ؛ إلا جعل اللهُ بأسَهم بينهم"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (4019) باختلاف يسير، والطبراني (12/446) (13619) مختصراً، والحاكم (8623) مطولاً باختلاف يسير","bab":"زكاة › عقوبة مانع الزكاة","dorar":"xjvYry2k"},{"id":"س-07276","fp":"cf3eb5461129","stateId":638,"easy":"إذا كان أمراؤكم شراركم وأغنياؤكم بخلاءكم وأموركم إلى نسائكم ← فبطن الأرض خير لكم من ظهرها","cause":"وإذا كانت أمراؤكم شرارُكم وكان أغنياؤكم بخلاءكم وكانت أمورُكم إلى نسائِكم","result":"فبطنُ الأرضِ خيرٌ لكم من ظهْرها","explicit":true,"ref":"مسند عمر 1/113","srcLabel":"الترمذي","text":["إذا كانت أمراؤكم خيارَكم وكان أغنياؤكم سمحاءَكم وكانت أموركُم شورى بينكم فظَهْرُ الأرضُ خيرٌ لكم من بطنها ",["وإذا كانت أمراؤكم شرارُكم وكان أغنياؤكم بخلاءكم وكانت أمورُكم إلى نسائِكم",1]," ",["فبطنُ الأرضِ خيرٌ لكم من ظهْرها",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (2266)، والبزار (9529)، وأبو نعيم في ((حلية الأولياء)) (6/176)","bab":"فتن › ظهور الفتن","dorar":"LkxtpFNP"},{"id":"س-01671","fp":"0390545d3802","stateId":638,"easy":"إذا لم يكن في الأمة من يأخذ للضعيف حقه ← لا يقدّسها الله","cause":"ليس فيه مَن يأخُذُ للضَّعيفِ حَقَّه","result":"إنَّ اللهَ لا يُقدِّسُ أُمَّةً","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"similar":["س-08077","س-01670"],"otherNeedIds":[28],"ref":"خلاصة البدر المنير 2/425","srcLabel":"مسلم","text":[["إنَّ اللهَ لا يُقدِّسُ أُمَّةً",2]," ",["ليس فيه مَن يأخُذُ للضَّعيفِ حَقَّه",1],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده على شرط مسلم","takhrij":"أخرجه ابن ماجة (4010)، وابن حبان (5058)، وأبو يعلى (2003) بلفظه في آخر حديث طويل.","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"b4HsV2tE"},{"id":"س-01670","fp":"1b23c74031f3","stateId":638,"easy":"إذا لم يأخذ الضعيف حقه من القوي ← لا يقدّس الله الأمة","cause":"لا يَأْخَذُ ضعيفُها حقَّهُ من قَوِيِّها","result":"كيفَ يُقَدِّسُ اللهُ أُمَّةً","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-01671","otherNeedIds":[28],"ref":"صحيح الجامع 4597","text":[["كيفَ يُقَدِّسُ اللهُ أُمَّةً",2]," ",["لا يَأْخَذُ ضعيفُها حقَّهُ من قَوِيِّها",1]," ، و هو غيرُ متَعْتَعٍ ؟"],"grade":"صحيح","narrator":"بريدة بن الحصيب وأبو سعيد الخدري وأبو سفيان","muhaddith":"صحيح","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"c8sMtynO"},{"id":"ق-0338","fp":"37b7aa1a9fd7","stateId":639,"easy":"العود إلى المعصية بعد العفو ← انتقام الله","cause":"العود إلى المعصية بعد العفو","result":"انتقام الله","explicit":true,"repOf":"ق-0695","ref":"سورة المائدة: 95","quran":{"s":5,"from":95,"to":95,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَقْتُلُوا الصَّيْدَ وَأَنْتُمْ حُرُمٌ وَمَنْ قَتَلَهُ مِنْكُمْ مُتَعَمِّدًا فَجَزَاءٌ مِثْلُ مَا قَتَلَ مِنَ النَّعَمِ يَحْكُمُ بِهِ ذَوَا عَدْلٍ مِنْكُمْ هَدْيًا بَالِغَ الْكَعْبَةِ أَوْ كَفَّارَةٌ طَعَامُ مَسَاكِينَ أَوْ عَدْلُ ذَلِكَ صِيَامًا لِيَذُوقَ وَبَالَ أَمْرِهِ عَفَا اللَّهُ عَمَّا سَلَفَ وَمَنْ عَادَ فَيَنْتَقِمُ اللَّهُ مِنْهُ وَاللَّهُ عَزِيزٌ ذُو انْتِقَامٍ (95)","hl":[[337,350,1],[350,377,2]]}},{"id":"ق-0464","fp":"3e0f411f2c91","stateId":639,"easy":"العود إلى الكفر والعدوان ← مضيّ سنة الأولين فيهم","cause":"العود إلى الكفر والعدوان","result":"مضيّ سنة الأولين فيهم","explicit":true,"repOf":"ق-0695","ref":"سورة الأنفال: 38","quran":{"s":8,"from":38,"to":38,"text":"قُلْ لِلَّذِينَ كَفَرُوا إِنْ يَنْتَهُوا يُغْفَرْ لَهُمْ مَا قَدْ سَلَفَ وَإِنْ يَعُودُوا فَقَدْ مَضَتْ سُنَّتُ الْأَوَّلِينَ (38)","hl":[[73,90,1],[90,125,2]]}},{"id":"ق-0551","fp":"956c378ba5c4","stateId":639,"easy":"المكر في آيات الله بعد الرحمة ← مكر الله أسرع","cause":"المكر في آيات الله بعد الرحمة","result":"مكر الله أسرع","explicit":true,"ref":"سورة يونس: 21","srcLabel":"القرآن الكريم","quran":{"s":10,"from":21,"to":21,"text":"وَإِذَا أَذَقْنَا النَّاسَ رَحْمَةً مِنْ بَعْدِ ضَرَّاءَ مَسَّتْهُمْ إِذَا لَهُمْ مَكْرٌ فِي آيَاتِنَا قُلِ اللَّهُ أَسْرَعُ مَكْرًا إِنَّ رُسُلَنَا يَكْتُبُونَ مَا تَمْكُرُونَ (21)","hl":[[0,103,1],[103,132,2],[132,176,1]]}},{"id":"ق-0552","fp":"389f527db14a","stateId":639,"easy":"البغي في الأرض بغير الحق بعد النجاة ← البغي على النفس","cause":"البغي في الأرض بغير الحق بعد النجاة","result":"البغي على النفس","explicit":true,"ref":"سورة يونس: 23","srcLabel":"القرآن الكريم","quran":{"s":10,"from":23,"to":23,"text":"فَلَمَّا أَنْجَاهُمْ إِذَا هُمْ يَبْغُونَ فِي الْأَرْضِ بِغَيْرِ الْحَقِّ يَا أَيُّهَا النَّاسُ إِنَّمَا بَغْيُكُمْ عَلَى أَنْفُسِكُمْ مَتَاعَ الْحَيَاةِ الدُّنْيَا ثُمَّ إِلَيْنَا مَرْجِعُكُمْ فَنُنَبِّئُكُمْ بِمَا كُنْتُمْ تَعْمَلُونَ (23)","hl":[[0,96,1],[96,134,2]]}},{"id":"ق-0665","fp":"d4a72dcf3edb","stateId":639,"easy":"المكر ← إتيان البنيان من القواعد وسقوط السقف والعذاب من حيث لا يشعرون","cause":"المكر","result":"إتيان البنيان من القواعد وسقوط السقف والعذاب من حيث لا يشعرون","explicit":true,"similar":["ق-0673","ق-0903","ق-1032"],"ref":"سورة النحل: 26","srcLabel":"القرآن الكريم","quran":{"s":16,"from":26,"to":26,"text":"قَدْ مَكَرَ الَّذِينَ مِنْ قَبْلِهِمْ فَأَتَى اللَّهُ بُنْيَانَهُمْ مِنَ الْقَوَاعِدِ فَخَرَّ عَلَيْهِمُ السَّقْفُ مِنْ فَوْقِهِمْ وَأَتَاهُمُ الْعَذَابُ مِنْ حَيْثُ لَا يَشْعُرُونَ (26)","hl":[[0,38,1],[38,181,2]]}},{"id":"ق-0673","fp":"8a7d61bc26bf","stateId":639,"easy":"مكر السيئات ← الخسف أو العذاب من حيث لا يشعرون أو الأخذ في التقلب","cause":"مكر السيئات","result":"الخسف أو العذاب من حيث لا يشعرون أو الأخذ في التقلب","explicit":true,"repOf":"ق-0665","ref":"سورة النحل: 45–47","quran":{"s":16,"from":45,"to":47,"text":"أَفَأَمِنَ الَّذِينَ مَكَرُوا السَّيِّئَاتِ أَنْ يَخْسِفَ اللَّهُ بِهِمُ الْأَرْضَ أَوْ يَأْتِيَهُمُ الْعَذَابُ مِنْ حَيْثُ لَا يَشْعُرُونَ (45) أَوْ يَأْخُذَهُمْ فِي تَقَلُّبِهِمْ فَمَا هُمْ بِمُعْجِزِينَ (46) أَوْ يَأْخُذَهُمْ عَلَى تَخَوُّفٍ فَإِنَّ رَبَّكُمْ لَرَءُوفٌ رَحِيمٌ (47)","hl":[[0,44,1],[44,244,2],[244,280,1]]}},{"id":"ق-0695","fp":"33e3a821cc54","stateId":639,"easy":"العود إلى الإفساد ← عود العقوبة","cause":"العود إلى الإفساد","result":"عود العقوبة","explicit":true,"similar":["ق-0338","ق-0464","ق-1176"],"ref":"سورة الإسراء: 8","srcLabel":"القرآن الكريم","quran":{"s":17,"from":8,"to":8,"text":"عَسَى رَبُّكُمْ أَنْ يَرْحَمَكُمْ وَإِنْ عُدْتُمْ عُدْنَا وَجَعَلْنَا جَهَنَّمَ لِلْكَافِرِينَ حَصِيرًا (8)","hl":[[34,50,1],[50,57,2]]}},{"id":"ق-0903","fp":"3257a4ce2cf5","stateId":639,"easy":"المكر والإفساد في الأرض ← تدميرهم وقومهم أجمعين وخواء البيوت بما ظلموا","cause":"المكر والإفساد في الأرض","result":"تدميرهم وقومهم أجمعين وخواء البيوت بما ظلموا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0665","ref":"سورة النمل: 50–52","quran":{"s":27,"from":50,"to":52,"text":"وَمَكَرُوا مَكْرًا وَمَكَرْنَا مَكْرًا وَهُمْ لَا يَشْعُرُونَ (50) فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ مَكْرِهِمْ أَنَّا دَمَّرْنَاهُمْ وَقَوْمَهُمْ أَجْمَعِينَ (51) فَتِلْكَ بُيُوتُهُمْ خَاوِيَةً بِمَا ظَلَمُوا إِنَّ فِي ذَلِكَ لَآيَةً لِقَوْمٍ يَعْلَمُونَ (52)","hl":[[0,67,1],[67,193,2],[193,208,1]]}},{"id":"ق-1032","fp":"8b35714aae5f","stateId":639,"easy":"الاستكبار في الأرض ومكر السيئ ← يحيق المكر السيئ بأهله (سنة الله)","cause":"الاستكبار في الأرض ومكر السيئ","result":"يحيق المكر السيئ بأهله (سنة الله)","explicit":true,"repOf":"ق-0665","ref":"سورة فاطر: 43","quran":{"s":35,"from":43,"to":43,"text":"اسْتِكْبَارًا فِي الْأَرْضِ وَمَكْرَ السَّيِّئِ وَلَا يَحِيقُ الْمَكْرُ السَّيِّئُ إِلَّا بِأَهْلِهِ فَهَلْ يَنْظُرُونَ إِلَّا سُنَّتَ الْأَوَّلِينَ فَلَنْ تَجِدَ لِسُنَّتِ اللَّهِ تَبْدِيلًا وَلَنْ تَجِدَ لِسُنَّتِ اللَّهِ تَحْوِيلًا (43)","hl":[[0,48,1],[48,234,2]]}},{"id":"ق-1176","fp":"8aca792cd0a6","stateId":639,"easy":"العود إلى الكفر بعد كشف العذاب ← البطشة الكبرى والانتقام","cause":"العود إلى الكفر بعد كشف العذاب","result":"البطشة الكبرى والانتقام","explicit":true,"repOf":"ق-0695","ref":"سورة الدخان: 15–16","quran":{"s":44,"from":15,"to":16,"text":"إِنَّا كَاشِفُو الْعَذَابِ قَلِيلًا إِنَّكُمْ عَائِدُونَ (15) يَوْمَ نَبْطِشُ الْبَطْشَةَ الْكُبْرَى إِنَّا مُنْتَقِمُونَ (16)","hl":[[0,62,1],[62,121,2]]}},{"id":"س-03907","fp":"ff9c8b186b65","stateId":639,"easy":"إذا كدت لنبي أو صالح ← يخسف الله بك (من قصة قارون)","cause":"أنْ أُرسِلَ إلى بَغِيِّ بني إسرائيلَ فنُرسِلَها إليه فتَرمِيهِ","result":"فَخَسَفْنَا بِهِ وَبِدَارِهِ الْأَرْضَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 3582","srcLabel":"ابن أبي شيبة","text":["عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهُما قالَ: لمَّا أَتى موسى قومَهُ أَمَرَهُم بالزَّكاةِ فجَمَعَهم قارونُ، فقالَ لهم: جاءكم بالصَّلاةِ وجاءكم بأشياءَ، فاحْتَمَلتُموها فتحَمَّلوا أنْ تُعطوهُ أموالَكُم. فقالوا: لا نَحتَمِلُ أنْ نُعطيَهُ أموالَنا، فما تَرى؟ فقالَ لهم: أرى ",["أنْ أُرسِلَ إلى بَغِيِّ بني إسرائيلَ فنُرسِلَها إليه فتَرمِيهِ",1]," بأنَّه أرادَها على نَفسِها، فدعا اللهَ موسى عليهم، فأَمَرَ اللهُ الأرضَ أنْ تُطيعَهُ، فقالَ موسى للأرضِ: خُذيهِم، فأَخَذَتْهم إلى أعْقابِهم. فجَعَلوا يقولونَ: يا موسى يا موسى، ثُمَّ قالَ للأرضِ: خُذيهِم، فأَخَذَتْهم إلى رُكَبِهِم، فجَعَلوا يقولونَ: يا موسى يا موسى، ثُمَّ قالَ للأرضِ: خُذيهِم، فأَخَذَتْهم إلى أعناقِهِم. فجعلوا يقولونَ: يا موسى يا موسى، فقالَ للأرضِ: خُذيهِم فأَخَذَتْهم فغَيَّبَتْهم، فأَوْحى اللهُ إلى موسى: يا موسى سَأَلكَ عِبادي وتضَرَّعوا إليكَ فلمْ تُجِبْهُم، وعِزَّتي لوْ أنَّهم دَعَوْني لأجَبْتُهم. قالَ ابنُ عبَّاسٍ: وذلك قولُ اللهِ عزَّ وجلَّ: {",["فَخَسَفْنَا بِهِ وَبِدَارِهِ الْأَرْضَ",2],"} [القصص: 81]، خَسَفَ به إلى الأرضِ السُّفلى."],"grade":"صحيح","narrator":"عبدالله بن الحارث","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه ابن أبي شيبة (31843)، وابن أبي الدنيا في ((العقوبات)) (233) بلفظ مقارب","bab":"تفسير آيات › سورة القصص","dorar":"91tvWhgT","merged":2,"otherRefs":["فتح الباري لابن حجر 517/6 (صحيح)"]},{"id":"ق-0017","fp":"9d6c5c1c5516","stateId":640,"easy":"تبديل أمر الله والفسق ← رجز من السماء","cause":"تبديل أمر الله والفسق","result":"رجز من السماء","explicit":true,"similar":["ق-0434","ق-0944"],"ref":"سورة البقرة: 59","srcLabel":"القرآن الكريم","quran":{"s":2,"from":59,"to":59,"text":"فَبَدَّلَ الَّذِينَ ظَلَمُوا قَوْلًا غَيْرَ الَّذِي قِيلَ لَهُمْ فَأَنْزَلْنَا عَلَى الَّذِينَ ظَلَمُوا رِجْزًا مِنَ السَّمَاءِ بِمَا كَانُوا يَفْسُقُونَ (59)","hl":[[0,65,1],[65,127,2],[127,153,1]]}},{"id":"ق-0021","fp":"8455dff62476","stateId":640,"easy":"الاعتداء على حدود الله بالحيلة (السبت) ← المسخ قردة خاسئين","cause":"الاعتداء على حدود الله بالحيلة (السبت)","result":"المسخ قردة خاسئين","explicit":true,"similar":["ق-0437"],"ref":"سورة البقرة: 65","srcLabel":"القرآن الكريم","quran":{"s":2,"from":65,"to":65,"text":"وَلَقَدْ عَلِمْتُمُ الَّذِينَ اعْتَدَوْا مِنْكُمْ فِي السَّبْتِ فَقُلْنَا لَهُمْ كُونُوا قِرَدَةً خَاسِئِينَ (65)","hl":[[0,64,1],[64,108,2]]}},{"id":"ق-0274","fp":"e56f85eb080c","stateId":640,"easy":"سؤال رؤية الله جهرة (ظلم) ← الصاعقة","cause":"سؤال رؤية الله جهرة (ظلم)","result":"الصاعقة","explicit":true,"ref":"سورة النساء: 153","srcLabel":"القرآن الكريم","quran":{"s":4,"from":153,"to":153,"text":"يَسْأَلُكَ أَهْلُ الْكِتَابِ أَنْ تُنَزِّلَ عَلَيْهِمْ كِتَابًا مِنَ السَّمَاءِ فَقَدْ سَأَلُوا مُوسَى أَكْبَرَ مِنْ ذَلِكَ فَقَالُوا أَرِنَا اللَّهَ جَهْرَةً فَأَخَذَتْهُمُ الصَّاعِقَةُ بِظُلْمِهِمْ ثُمَّ اتَّخَذُوا الْعِجْلَ مِنْ بَعْدِ مَا جَاءَتْهُمُ الْبَيِّنَاتُ فَعَفَوْنَا عَنْ ذَلِكَ وَآتَيْنَا مُوسَى سُلْطَانًا مُبِينًا (153)","hl":[[159,186,2],[186,199,1]]}},{"id":"ق-0434","fp":"e279e3533ff7","stateId":640,"easy":"تبديل القول ظلماً ← رجز من السماء","cause":"تبديل القول ظلماً","result":"رجز من السماء","explicit":true,"repOf":"ق-0017","ref":"سورة الأعراف: 162","quran":{"s":7,"from":162,"to":162,"text":"فَبَدَّلَ الَّذِينَ ظَلَمُوا مِنْهُمْ قَوْلًا غَيْرَ الَّذِي قِيلَ لَهُمْ فَأَرْسَلْنَا عَلَيْهِمْ رِجْزًا مِنَ السَّمَاءِ بِمَا كَانُوا يَظْلِمُونَ (162)","hl":[[0,74,1],[74,122,2],[122,148,1]]}},{"id":"ق-0435","fp":"2a9a1afa540e","stateId":640,"easy":"الفسق ← شدة الابتلاء","cause":"الفسق","result":"شدة الابتلاء","explicit":true,"ref":"سورة الأعراف: 163","srcLabel":"القرآن الكريم","quran":{"s":7,"from":163,"to":163,"text":"وَاسْأَلْهُمْ عَنِ الْقَرْيَةِ الَّتِي كَانَتْ حَاضِرَةَ الْبَحْرِ إِذْ يَعْدُونَ فِي السَّبْتِ إِذْ تَأْتِيهِمْ حِيتَانُهُمْ يَوْمَ سَبْتِهِمْ شُرَّعًا وَيَوْمَ لَا يَسْبِتُونَ لَا تَأْتِيهِمْ كَذَلِكَ نَبْلُوهُمْ بِمَا كَانُوا يَفْسُقُونَ (163)","hl":[[194,214,2],[214,240,1]]}},{"id":"ق-0437","fp":"7d5a4e43d289","stateId":640,"easy":"الظلم والفسق والعتوّ عمّا نُهوا عنه ← عذاب بئيس والمسخ قردة","cause":"الظلم والفسق والعتوّ عمّا نُهوا عنه","result":"عذاب بئيس والمسخ قردة","explicit":true,"repOf":"ق-0021","ref":"سورة الأعراف: 165–166","quran":{"s":7,"from":165,"to":166,"text":"فَلَمَّا نَسُوا مَا ذُكِّرُوا بِهِ أَنْجَيْنَا الَّذِينَ يَنْهَوْنَ عَنِ السُّوءِ وَأَخَذْنَا الَّذِينَ ظَلَمُوا بِعَذَابٍ بَئِيسٍ بِمَا كَانُوا يَفْسُقُونَ (165) فَلَمَّا عَتَوْا عَنْ مَا نُهُوا عَنْهُ قُلْنَا لَهُمْ كُونُوا قِرَدَةً خَاسِئِينَ (166)","hl":[[82,130,2],[130,203,1],[203,245,2]]}},{"id":"ق-0944","fp":"41a19a24a8e0","stateId":640,"easy":"الفسق ← رجز من السماء","cause":"الفسق","result":"رجز من السماء","explicit":true,"repOf":"ق-0017","ref":"سورة العنكبوت: 34","quran":{"s":29,"from":34,"to":34,"text":"إِنَّا مُنْزِلُونَ عَلَى أَهْلِ هَذِهِ الْقَرْيَةِ رِجْزًا مِنَ السَّمَاءِ بِمَا كَانُوا يَفْسُقُونَ (34)","hl":[[0,74,2],[74,100,1]]}},{"id":"س-08013","fp":"a423bcdb7053","stateId":641,"easy":"إذا ظلمت ← يُملي الله لك حتى إذا أخذك لم يفلتك","cause":"للظَّالِمِ","result":"حتَّى إذا أخذَه لم يُفلِتْهُ","explicit":true,"star":true,"similar":["ق-0821"],"ref":"صحيح الترمذي 3110","srcLabel":"البخاري","text":["إنَّ اللهَ تبارَك وتعالَى يُملي ، - وربَّما قال : يمهلُ ",["للظَّالِمِ",1]," ، ",["حتَّى إذا أخذَه لم يُفلِتْهُ",2]," ، ثمَّ قرأ :  وَكَذَلِكَ أَخْذُ رَبِّكَ إِذَا أَخَذَ الْقُرَى وَهِيَ ظَالِمَةٌ  الآيةَ"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح","takhrij":"أخرجه البخاري (4686)، والترمذي (3110)، وابن ماجه (4018)، والبزار (3183)، والنسائي في ((السنن الكبرى)) (11181) واللفظ لهم.","bab":"مظالم › تحريم الظلم","dorar":"fH5ksFpW"},{"id":"ق-0191","fp":"7e597b5d8697","stateId":641,"easy":"الكفر مع الإمهال ← الإملاء ليزدادوا إثماً وعذاب مهين","cause":"الكفر مع الإمهال","result":"الإملاء ليزدادوا إثماً وعذاب مهين","explicit":true,"star":true,"similar":["ق-0445","ق-0631","ق-0753","ق-0818","ق-0836","ق-1370"],"otherNeedIds":[69],"ref":"سورة آل عمران: 178","srcLabel":"القرآن الكريم","quran":{"s":3,"from":178,"to":178,"text":"وَلَا يَحْسَبَنَّ الَّذِينَ كَفَرُوا أَنَّمَا نُمْلِي لَهُمْ خَيْرٌ لِأَنْفُسِهِمْ إِنَّمَا نُمْلِي لَهُمْ لِيَزْدَادُوا إِثْمًا وَلَهُمْ عَذَابٌ مُهِينٌ (178)","hl":[[0,83,1],[83,153,2]]}},{"id":"ق-0354","fp":"921ffc803ddf","stateId":641,"easy":"قسوة القلب وترك التضرع عند البلاء ونسيان التذكير ← الاستدراج بفتح أبواب كل شيء ثم الأخذ بغتة وقطع الدابر","cause":"قسوة القلب وترك التضرع عند البلاء ونسيان التذكير","result":"الاستدراج بفتح أبواب كل شيء ثم الأخذ بغتة وقطع الدابر","explicit":true,"star":true,"similar":["ق-0415","ق-0840"],"otherNeedIds":[21],"ref":"سورة الأنعام: 43–45","srcLabel":"القرآن الكريم","quran":{"s":6,"from":43,"to":45,"text":"فَلَوْلَا إِذْ جَاءَهُمْ بَأْسُنَا تَضَرَّعُوا وَلَكِنْ قَسَتْ قُلُوبُهُمْ وَزَيَّنَ لَهُمُ الشَّيْطَانُ مَا كَانُوا يَعْمَلُونَ (43) فَلَمَّا نَسُوا مَا ذُكِّرُوا بِهِ فَتَحْنَا عَلَيْهِمْ أَبْوَابَ كُلِّ شَيْءٍ حَتَّى إِذَا فَرِحُوا بِمَا أُوتُوا أَخَذْنَاهُمْ بَغْتَةً فَإِذَا هُمْ مُبْلِسُونَ (44) فَقُطِعَ دَابِرُ الْقَوْمِ الَّذِينَ ظَلَمُوا وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ (45)","hl":[[0,169,1],[169,347,2],[347,387,1]]}},{"id":"ق-0415","fp":"cb67e31554dc","stateId":641,"easy":"ترك التضرع عند البأساء والاغترار بالنعمة بعدها ← الأخذ بغتة","cause":"ترك التضرع عند البأساء والاغترار بالنعمة بعدها","result":"الأخذ بغتة","explicit":true,"repOf":"ق-0354","ref":"سورة الأعراف: 94–95","quran":{"s":7,"from":94,"to":95,"text":"وَمَا أَرْسَلْنَا فِي قَرْيَةٍ مِنْ نَبِيٍّ إِلَّا أَخَذْنَا أَهْلَهَا بِالْبَأْسَاءِ وَالضَّرَّاءِ لَعَلَّهُمْ يَضَّرَّعُونَ (94) ثُمَّ بَدَّلْنَا مَكَانَ السَّيِّئَةِ الْحَسَنَةَ حَتَّى عَفَوْا وَقَالُوا قَدْ مَسَّ آبَاءَنَا الضَّرَّاءُ وَالسَّرَّاءُ فَأَخَذْنَاهُمْ بَغْتَةً وَهُمْ لَا يَشْعُرُونَ (95)","hl":[[0,253,1],[253,300,2]]}},{"id":"ق-0445","fp":"e3da6d1b27d7","stateId":641,"easy":"التكذيب بآيات الله ← الاستدراج من حيث لا يعلمون والإملاء","cause":"التكذيب بآيات الله","result":"الاستدراج من حيث لا يعلمون والإملاء","explicit":true,"repOf":"ق-0191","ref":"سورة الأعراف: 182–183","quran":{"s":7,"from":182,"to":183,"text":"وَالَّذِينَ كَذَّبُوا بِآيَاتِنَا سَنَسْتَدْرِجُهُمْ مِنْ حَيْثُ لَا يَعْلَمُونَ (182) وَأُمْلِي لَهُمْ إِنَّ كَيْدِي مَتِينٌ (183)","hl":[[0,34,1],[34,125,2]]}},{"id":"ق-0631","fp":"b9c5b90efeba","stateId":641,"easy":"الاستهزاء بالرسل ← الإملاء ثم الأخذ والعقاب","cause":"الاستهزاء بالرسل","result":"الإملاء ثم الأخذ والعقاب","explicit":true,"repOf":"ق-0191","ref":"سورة الرعد: 32","quran":{"s":13,"from":32,"to":32,"text":"وَلَقَدِ اسْتُهْزِئَ بِرُسُلٍ مِنْ قَبْلِكَ فَأَمْلَيْتُ لِلَّذِينَ كَفَرُوا ثُمَّ أَخَذْتُهُمْ فَكَيْفَ كَانَ عِقَابِ (32)","hl":[[0,44,1],[44,118,2]]}},{"id":"ق-0753","fp":"288f3cb5984d","stateId":641,"easy":"الضلالة ← مدّ الرحمن له (استدراج) حتى يرى العذاب","cause":"الضلالة","result":"مدّ الرحمن له (استدراج) حتى يرى العذاب","explicit":true,"repOf":"ق-0191","ref":"سورة مريم: 75","quran":{"s":19,"from":75,"to":75,"text":"قُلْ مَنْ كَانَ فِي الضَّلَالَةِ فَلْيَمْدُدْ لَهُ الرَّحْمَنُ مَدًّا حَتَّى إِذَا رَأَوْا مَا يُوعَدُونَ إِمَّا الْعَذَابَ وَإِمَّا السَّاعَةَ فَسَيَعْلَمُونَ مَنْ هُوَ شَرٌّ مَكَانًا وَأَضْعَفُ جُنْدًا (75)","hl":[[0,33,1],[33,203,2]]}},{"id":"ق-0818","fp":"0cfd84e48e0a","stateId":641,"easy":"تكذيب الرسل ← الإملاء ثم الأخذ والنكير","cause":"تكذيب الرسل","result":"الإملاء ثم الأخذ والنكير","explicit":true,"repOf":"ق-0191","ref":"سورة الحج: 44","quran":{"s":22,"from":44,"to":44,"text":"وَأَصْحَابُ مَدْيَنَ وَكُذِّبَ مُوسَى فَأَمْلَيْتُ لِلْكَافِرِينَ ثُمَّ أَخَذْتُهُمْ فَكَيْفَ كَانَ نَكِيرِ (44)","hl":[[38,50,2],[50,66,1],[66,107,2]]}},{"id":"ق-0821","fp":"f1d82b23cc90","stateId":641,"easy":"الظلم ← الإملاء ثم الأخذ","cause":"الظلم","result":"الإملاء ثم الأخذ","explicit":true,"repOf":"س-08013","ref":"سورة الحج: 48","quran":{"s":22,"from":48,"to":48,"text":"وَكَأَيِّنْ مِنْ قَرْيَةٍ أَمْلَيْتُ لَهَا وَهِيَ ظَالِمَةٌ ثُمَّ أَخَذْتُهَا وَإِلَيَّ الْمَصِيرُ (48)","hl":[[0,42,2],[42,60,1],[60,77,2]]}},{"id":"ق-0836","fp":"8ccdb011ae21","stateId":641,"easy":"الكفر مع الإمداد بالمال والبنين ← استدراج لا مسارعة في الخيرات","cause":"الكفر مع الإمداد بالمال والبنين","result":"استدراج لا مسارعة في الخيرات","explicit":true,"repOf":"ق-0191","ref":"سورة المؤمنون: 55–56","quran":{"s":23,"from":55,"to":56,"text":"أَيَحْسَبُونَ أَنَّمَا نُمِدُّهُمْ بِهِ مِنْ مَالٍ وَبَنِينَ (55) نُسَارِعُ لَهُمْ فِي الْخَيْرَاتِ بَلْ لَا يَشْعُرُونَ (56)","hl":[[0,120,1]]}},{"id":"ق-0840","fp":"24c9a846266f","stateId":641,"easy":"ترك الاستكانة والتضرع عند العذاب ← فتح باب عذاب شديد والإبلاس","cause":"ترك الاستكانة والتضرع عند العذاب","result":"فتح باب عذاب شديد والإبلاس","explicit":true,"repOf":"ق-0354","otherNeedIds":[10],"ref":"سورة المؤمنون: 76–77","quran":{"s":23,"from":76,"to":77,"text":"وَلَقَدْ أَخَذْنَاهُمْ بِالْعَذَابِ فَمَا اسْتَكَانُوا لِرَبِّهِمْ وَمَا يَتَضَرَّعُونَ (76) حَتَّى إِذَا فَتَحْنَا عَلَيْهِمْ بَابًا ذَا عَذَابٍ شَدِيدٍ إِذَا هُمْ فِيهِ مُبْلِسُونَ (77)","hl":[[0,93,1],[93,182,2]]}},{"id":"ق-1370","fp":"91842d29a576","stateId":641,"easy":"التكذيب بالقرآن ← الاستدراج من حيث لا يعلمون والإملاء","cause":"التكذيب بالقرآن","result":"الاستدراج من حيث لا يعلمون والإملاء","explicit":true,"repOf":"ق-0191","ref":"سورة القلم: 44–45","quran":{"s":68,"from":44,"to":45,"text":"فَذَرْنِي وَمَنْ يُكَذِّبُ بِهَذَا الْحَدِيثِ سَنَسْتَدْرِجُهُمْ مِنْ حَيْثُ لَا يَعْلَمُونَ (44) وَأُمْلِي لَهُمْ إِنَّ كَيْدِي مَتِينٌ (45)","hl":[[0,46,1],[46,136,2]]}},{"id":"س-05576","fp":"383fefdbe0ea","stateId":641,"easy":"إذا أعطاك الله ما تحب وأنت مقيم على معاصيه ← فإنما هو استدراج","cause":"ما يُحبُّ ، و هو مقيمٌ على معاصِيه","result":"فإنَّما ذلك منه استدراجٌ","explicit":true,"otherNeedIds":[13],"ref":"صحيح الجامع 561","srcLabel":"الروياني","text":["إذا رأيتَ اللهَ تعالى يُعطي العبدَ من الدنيا ",["ما يُحبُّ ، و هو مقيمٌ على معاصِيه",1]," ؛ ",["فإنَّما ذلك منه استدراجٌ",2]],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه الروياني (261)، والخرائطي في ((فضيلة الشكر)) (70)، وابن قانع في ((معجم الصحابة)) (2/ 272) باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"nfeLijzu","merged":2,"otherRefs":["تخريج المسند لشعيب 17311 (حسن)"]},{"id":"س-07423","fp":"0ab892959664","stateId":642,"easy":"إذا داهن خياركم فجاركم وصار الفقه في شراركم ← تلبسكم الفتنة","cause":"إذا دَاهَنَ خيارُكُم فجارَكم وصار الفقهُ في شرارِكم","result":"فعندَ ذلِكَ تَلْبِسُكُم فتنةٌ","explicit":true,"otherNeedIds":[17],"ref":"مجمع الزوائد 7/289","srcLabel":"الطبراني","text":["قلتُ للنَّبِيِّ صلَّى اللهُ عليه وسلَّم يا رسولَ اللهِ متى يُتْرَكُ الأمرُ بالمعروفِ والنَّهْيُ عنِ المنكرِ وهما سيِّدَا أعمالِ أهلِ البرِّ قال إذا أصابَكم ما أَصابَ بني إسرائيلَ قلْتُ يا رسولَ اللهِ وما أَصابَ بني إسرائيلَ قال ",["إذا دَاهَنَ خيارُكُم فجارَكم وصار الفقهُ في شرارِكم",1]," وصار الملْكُ في صغارِكم ",["فعندَ ذلِكَ تَلْبِسُكُم فتنةٌ",2]," تَكِرُّونَ ويُكَرُّ علَيْكُمْ"],"grade":"حسن","narrator":"حذيفة بن اليمان","muhaddith":"فيه عمار بن سيف وبقية رجاله ثقات وفي بعضهم خلاف","takhrij":"أخرجه الطبراني في ((الأوسط)) (144) واللفظ له.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"xEI82IWL"},{"id":"س-00583","fp":"5fcc51f04f61","stateId":642,"easy":"إذا تُرك السفهاء وأمرهم ← هلك الجميع","cause":"فإنْ تَرَكوهم وأمْرَهم","result":"هَلَكوا جَميعًا","explicit":true,"star":true,"similar":["س-02179","س-00575","س-00584","س-02071"],"ref":"تخريج المسند لشعيب 18370","srcLabel":"البخاري","text":["مَثلُ القائمِ على حُدودِ اللهِ، والواقعِ فيها،  المُدْهِنِ فيها، مَثلُ قَومٍ رَكِبوا سَفينةً، فأصابَ بعضُهم أسفلَها، وأوْعرَها، وشَرَّها، وأصابَ بعضُهم أعلاها، فكان الذين في أسفلِها إذا استَقَوُا الماءَ، مَرُّوا على مَن فوقَهم، فآذَوْهم، فقالوا: لو خَرَقْنا في نَصيبِنا خَرقًا، فاستقَيْنا منه، ولم نُؤذِ مَن فوقَنا، ",["فإنْ تَرَكوهم وأمْرَهم",1],"؛ ",["هَلَكوا جَميعًا",2],"، وإنْ أخَذوا على أيْديهم؛ نَجَوْا جَميعًا."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (2493)، والترمذي (2173)، وأحمد (18370) واللفظ له","bab":"آداب عامة › ضرب الأمثال","dorar":"pyDjRbxb","merged":2,"otherRefs":["أحكام القرآن لابن العربي 4/305 (صحيح)"]},{"id":"س-02179","fp":"7b891acabd10","stateId":642,"easy":"إذا تُرك السفهاء وما أرادوا ← هلك الجميع","cause":"فإنْ يَتركُوهمْ وما أرادُوا","result":"هلَكُوا جميعًا","explicit":true,"repOf":"س-00583","ref":"صحيح الجامع 5832","text":["مَثلُ القائِمِ على حُدودِ اللهِ ، والمدَّهِنِ فيها ، كمَثلِ قومٍ اسْتهَمُوا على سفينةٍ في البحْرِ ، فأصابَ بعضُهمْ أعلَاها ، وأصابَ بعضُهمْ أسفَلَها ، فكانَ الّذينَ في أسفلِها إذا استَقَوا من الماءِ مَرُّوا على مَنْ فوقَهُمْ ، فقال الّذينَ في أعْلاها : لا نَدعُكُمْ تَصعدُونَ فتُؤذُونا ، فقالُوا : لوْ أنّا خرقْنا في نَصيبِنا خرْقًا ولمْ نُؤْذِ مَنْ فوقَنا ، ",["فإنْ يَتركُوهمْ وما أرادُوا",1]," ، ",["هلَكُوا جميعًا",2]," ، وإنْ أخذُوا على أيدِيهمْ ، نَجَوْا ونَجَوْا جميعًا"],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2173)، وأحمد (18361) باختلاف يسير، وأخرجه البخاري (2686) بلفظ مقارب","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"1vc7R5ao"},{"id":"ق-0458","fp":"e1fcaf5f3ae5","stateId":642,"easy":"ترك إنكار الظلم إذا شاع ← فتنة تعمّ ولا تخصّ الظالمين","cause":"ترك إنكار الظلم إذا شاع","result":"فتنة تعمّ ولا تخصّ الظالمين","explicit":true,"star":true,"ref":"سورة الأنفال: 25","srcLabel":"القرآن الكريم","quran":{"s":8,"from":25,"to":25,"text":"وَاتَّقُوا فِتْنَةً لَا تُصِيبَنَّ الَّذِينَ ظَلَمُوا مِنْكُمْ خَاصَّةً وَاعْلَمُوا أَنَّ اللَّهَ شَدِيدُ الْعِقَابِ (25)","hl":[[0,11,1],[11,71,2]]}},{"id":"س-02481","fp":"4238f4d5475d","stateId":642,"easy":"إذا هابت الأمة أن تقول للظالم «أنت ظالم» ← فقد تُودّع منها","cause":"إذا رأيتُمْ أمَّتي تَهابُ الظَّالمَ أن تَقولَ لَهُ : إنَّكَ أنتَ ظالمٌ","result":"فقد توُدِّعَ مِنهُم","explicit":true,"star":true,"ref":"تخريج المسند لشاكر 10/30","srcLabel":"أحمد","text":[["إذا رأيتُمْ أمَّتي تَهابُ الظَّالمَ أن تَقولَ لَهُ : إنَّكَ أنتَ ظالمٌ ، ",1],["فقد توُدِّعَ مِنهُم",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6521) واللفظ له، والبزار (2375)، وابن أبي الدنيا في ((الأمر بالمعروف)) (3)، والعقيلي في ((الضعفاء الكبير)) (4/290)، والطبراني (13/454) (14314)  باختلاف يسير","bab":"إمامة وخلافة › الإنكار على الأمراء فيما خالفوا الشرع فيه","dorar":"3lNNSmKJ","merged":3,"otherRefs":["تخريج المسند لشاكر 11/47 (صحيح)","مجمع الزوائد 7/273 (صحيح)"]},{"id":"س-01564","fp":"026a46b2d95b","stateId":642,"easy":"إذا كثر الخبث ← يُخسف بالأرض","cause":"إذا كان أكثرُ أهلِها الخبَثُ","result":"يُخْسَفُ بأرضٍ","explicit":true,"star":true,"similar":["س-07422"],"ref":"مجمع الزوائد 7/272","srcLabel":"الطبراني","text":["ذُكِرَ في زمنِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم خَسْفٌ قِبَلَ المشرقِ فقال رجلٌ يا رسولَ اللهِ ",["يُخْسَفُ بأرضٍ",2]," فيها المسلمون فقال نعم ",["إذا كان أكثرُ أهلِها الخبَثُ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (1841)، والداني في ((السنن الواردة في الفتن)) (342)واللفظ لهما.","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"vb45TU5A","merged":2,"otherRefs":["صحيح الترمذي 2185 (صحيح)"]},{"id":"س-01783","fp":"e1bf33c5019a","stateId":642,"easy":"إذا لم تأمروا بالمعروف وتنهوا عن المنكر وتأخذوا على يد المسيء ← يضرب الله قلوب بعضكم ببعض ويلعنكم","cause":"لتأمرُنَّ بالمعروفِ ولتَنْهُنَّ عنِ المنكرِ ولتأخذُنَّ على أيدي المسيءِ ولتأطِرُنَّهُ على الحقِّ أطْرًا","result":"أو ليضرِبَنَّ اللهُ بقلوبِ بعضِكم على بعضٍ ويلعنُكم كما لَعَنَهُمْ","explicit":true,"otherNeedIds":[30],"ref":"مجمع الزوائد 7/272","srcLabel":"الطحاوي","text":["إنَّهُ من كان قَبْلَكُمْ مِنْ بني إسرائيلَ إذا عَمِلَ فيهم العامِلُ الخطيئةَ فنَهَاهُ الناهِي تَعْذِيرًا فإذا كان من الغدِ جالَسَهُ ووَاكلَهُ وشارَبَهُ كأَنَّهُ لم يرَهُ على خَطِيئَةٍ بالأمْسِ فلمَّا رأَى اللهُ تعالى ذلِكَ منهم ضَرَبَ قلوبَ بعضِهم على بعضٍ على لسانِ داودَ وعيسى بنِ مريمَ  ذَلِكَ بِمَا عَصَوْا وَكَانُوا يَعْتَدُونَ  والذي نفْسِي بيدِهِ ",["لتأمرُنَّ بالمعروفِ ولتَنْهُنَّ عنِ المنكرِ ولتأخذُنَّ على أيدي المسيءِ ولتأطِرُنَّهُ على الحقِّ أطْرًا",1]," ",["أو ليضرِبَنَّ اللهُ بقلوبِ بعضِكم على بعضٍ ويلعنُكم كما لَعَنَهُمْ",2]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (1163) واللفظ له.","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"VqidmtBS","merged":2,"otherRefs":["عمدة التفسير 1/715 (صحيح)"]},{"id":"س-02985","fp":"53da09cc39e7","stateId":642,"easy":"إذا رأى الناس الظالم فلم يأخذوا على يديه ← أوشك أن يعمهم الله بعقاب","cause":"إنَّ النَّاسَ إذا رأَوا الظَّالِمَ فلم يَأخُذوا على يَدَيه","result":"أَوشَكَ أن يَعُمَّهم اللهُ بعِقابٍ","explicit":true,"repOf":"س-02986","ref":"الصحيح المسند 707","text":["قالَ أبو بَكْرٍ بَعْدَ أن حَمِدَ اللهَ وأَثْنى عليه: يا أيُّها النَّاسُ، إنَّكم تَقرَؤونَ هذه الآيةَ، وتَضَعونَها على غَيْرِ مَواضِعِها: {عَلَيْكُمْ أَنْفُسَكُمْ لا يَضُرُّكُمْ مَنْ ضَلَّ إِذَا اهْتَدَيْتُمْ}.\nقالَ عن خالِدٍ: وإنَّا سَمِعْنا النَّبيَّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ يقولُ: «",["إنَّ النَّاسَ إذا رأَوا الظَّالِمَ فلم يَأخُذوا على يَدَيه، ",1],["أَوشَكَ أن يَعُمَّهم اللهُ بعِقابٍ»",2],".\nوقالَ عَمْرٌو عن هُشَيمٍ: وإنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ يقولُ: «ما مِن قَوْمٍ يُعمَلُ فيهم بالمَعاصي، ثُمَّ يَقدِرونَ على أن يُغيِّروا ثُمَّ لا يُغَيِّروا، إلَّا يوشِكُ أن يَعُمَّهم اللهُ مِنه بعِقابٍ».\nقالَ أبو داودُ: ورَواه كما قالَ خالِدٌ: أبو أُسامةَ وجَماعةٌ، وقالَ شُعْبةُ فيه: «ما مِن قَوْمٍ يُعمَلُ فيهم بالمَعاصي هُمْ أَكثَرُ ممَّن يَعمَلُه»."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"صحيح على شرط الشَّيْخين","takhrij":"أخرجه أبو داود (4338)، والترمذي (2168)، وابن ماجه (4005)، وأحمد (1) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"oNv8xwNw","merged":2,"otherRefs":["تخريج المسند لشعيب 29 (صحيح)"]},{"id":"س-04771","fp":"856a96e291eb","stateId":642,"easy":"إذا رأى الناس المنكر بينهم فلم يغيروه ← يعذب الله العامة والخاصة","cause":"إذا رأَوا المنكرَ بين ظَهرانَيهم فلم يُغيِّروه","result":"عذَّبَ اللهُ عزَّ وجلَّ العامَّةَ والخاصَّةَ","explicit":true,"repOf":"س-02986","ref":"شرح مشكل الآثار 3/214","text":["إنَّ اللهَ عزَّ وجلَّ لا يهلكُ العامةَ بعملِ الخاصَّةِ ولكن ",["إذا رأَوا المنكرَ بين ظَهرانَيهم فلم يُغيِّروه",1]," ",["عذَّبَ اللهُ عزَّ وجلَّ العامَّةَ والخاصَّةَ",2]],"grade":"صحيح","narrator":"عدي بن عميرة الكندي","muhaddith":"صحيح","takhrij":"لم نقف عليه إلا في الطحاوي في ((شرح مشكل الآثار)) (1175)","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"AyoJQ0vt","merged":2,"otherRefs":["إرشاد الساري 10/167 (حسن)"]},{"id":"س-00104","fp":"86cc9aa96599","stateId":642,"easy":"إذا رأى الناس المنكر فلم يغيروه ← يوشك أن يعمهم الله بعقابه","cause":"إنَّ النَّاسَ إذا رَأَوُا المُنكَرَ لا يُغَيِّرُوهُ","result":"أَوْشَكَ أنْ يَعُمَّهُمُ اللهُ بعِقابِه","explicit":true,"repOf":"س-02986","ref":"تخريج مسند أبي بكر 88","text":["قام أبو بَكرٍ رضيَ اللهُ عنه فحَمِدَ اللهَ وأَثنَى علَيهِ، وقال: يا أيُّها النَّاسُ، إنَّكُم تَقرَؤُونَ هذِه الآيةَ: {يَا أَيُّهَا الَّذِينَ آمَنُوا عَلَيْكُمْ أَنْفُسَكُمْ لَا يَضُرُّكُمْ مَنْ ضَلَّ إِذَا اهْتَدَيْتُمْ} [المائدة: 105]، وإنَّا سمِعْنا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: «",["إنَّ النَّاسَ إذا رَأَوُا المُنكَرَ لا يُغَيِّرُوهُ",1],"، ",["أَوْشَكَ أنْ يَعُمَّهُمُ اللهُ بعِقابِه",2],"». قال أبو أُسامةَ: وقال مرَّةً أُخرى: وإنِّي سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ..."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4338)، والترمذي (2168)، والنسائي في ((السنن الكبرى)) (11157)، وابن ماجه (4005)، وأحمد (16) باختلاف يسير، والمروزي في ((مسند أبي بكر)) (88) واللفظ له","bab":"آداب الدعاء › الثناء على الله في الدعاء","dorar":"zw6Sc8Dx"},{"id":"س-02483","fp":"38ef138a80a6","stateId":642,"easy":"إذا رأى الناس الظالم فلم يأخذوا على يديه ← عمهم الله بعقابه","cause":"إنَّ النَّاسَ إذا رأَوُا الظَّالمَ فلم يأخُذوا على يدَيهِ","result":"عمَّهم اللهُ بعقابِه","explicit":true,"repOf":"س-02986","ref":"تخريج صحيح ابن حبان 304","text":["قرَأ أبو بكرٍ الصِّدِّيقُ هذه الآيةَ: {يَا أَيُّهَا الَّذِينَ آمَنُوا عَلَيْكُمْ أَنْفُسَكُمْ لَا يَضُرُّكُمْ مَنْ ضَلَّ إِذَا اهْتَدَيْتُمْ} [المائدة: 105] قال: إنَّ النَّاسَ يضَعون هذه الآيةَ على غيرِ موضعِها ألَا وإنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( ",["إنَّ النَّاسَ إذا رأَوُا الظَّالمَ فلم يأخُذوا على يدَيهِ",1]," - أو قال: المنكَرَ فلم يُغيِّروه - ",["عمَّهم اللهُ بعقابِه",2]," )"],"grade":"صحيح","narrator":"أبوبكر الصديق","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (4338)، والترمذي (2168) باختلاف يسير، وابن ماجه (4005) بنحوه","bab":"إمامة وخلافة › الإنكار على الأمراء فيما خالفوا الشرع فيه","dorar":"j92f9iyb"},{"id":"س-02986","fp":"3d3455f30d7f","stateId":642,"easy":"إذا عُملت المعاصي في قوم يقدرون على تغييرها فلم يغيروا ← يوشك أن يعمهم الله بعقاب","cause":"ما مِن قَوْمٍ يُعمَلُ فيهم بالمَعاصي، ثُمَّ يَقدِرونَ على أن يُغيِّروا ثُمَّ لا يُغَيِّروا","result":"إلَّا يوشِكُ أن يَعُمَّهم اللهُ مِنه بعِقابٍ","explicit":true,"similar":["س-02985","س-04771","س-00104","س-02483","س-03023","س-04889","س-05315","س-04775","س-04865","س-05125"],"ref":"الصحيح المسند 707","srcLabel":"أبو داود","text":["قالَ أبو بَكْرٍ بَعْدَ أن حَمِدَ اللهَ وأَثْنى عليه: يا أيُّها النَّاسُ، إنَّكم تَقرَؤونَ هذه الآيةَ، وتَضَعونَها على غَيْرِ مَواضِعِها: {عَلَيْكُمْ أَنْفُسَكُمْ لا يَضُرُّكُمْ مَنْ ضَلَّ إِذَا اهْتَدَيْتُمْ}.\nقالَ عن خالِدٍ: وإنَّا سَمِعْنا النَّبيَّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ يقولُ: «إنَّ النَّاسَ إذا رأَوا الظَّالِمَ فلم يَأخُذوا على يَدَيه، أَوشَكَ أن يَعُمَّهم اللهُ بعِقابٍ».\nوقالَ عَمْرٌو عن هُشَيمٍ: وإنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ يقولُ: «",["ما مِن قَوْمٍ يُعمَلُ فيهم بالمَعاصي، ثُمَّ يَقدِرونَ على أن يُغيِّروا ثُمَّ لا يُغَيِّروا،",1]," ",["إلَّا يوشِكُ أن يَعُمَّهم اللهُ مِنه بعِقابٍ»",2],".\nقالَ أبو داودُ: ورَواه كما قالَ خالِدٌ: أبو أُسامةَ وجَماعةٌ، وقالَ شُعْبةُ فيه: «ما مِن قَوْمٍ يُعمَلُ فيهم بالمَعاصي هُمْ أَكثَرُ ممَّن يَعمَلُه»."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"صحيح على شرط الشَّيْخين","takhrij":"أخرجه أبو داود (4338)، والترمذي (2168)، وابن ماجه (4005)، وأحمد (1) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"oNv8xwNw"},{"id":"س-03023","fp":"d049cec83980","stateId":642,"easy":"إذا رأى الناس منكراً فلم يغيروه ← أوشك أن يعمهم الله بعقابه","cause":"إنَّ النَّاسَ إذا رأَوْا مُنكَرًا لا يُغيِّرونَهُ","result":"أوشَك أنْ يعُمَّهمُ اللهُ بعقابِهِ","explicit":true,"repOf":"س-02986","ref":"تخريج مشكل الآثار 1169","text":["حدَّثني قَيْسُ بنُ أبي حازمٍ، عن أبي بكْرٍ، قال: سمِعْتُهُ حمِد اللهَ وأثْنى عليه، ثمَّ قال: أيُّها النَّاسُ، ثمَّ ذكَر بَقِيَّةَ هذا الحديثِ. يعني حديثَ: أيُّها النَّاسُ، إنَّكم تَقرَؤُونَ هذه الآيةَ، وتضَعونَها على غيْرِ موضِعها: {يَا أَيُّهَا الَّذِينَ آمَنُوا عَلَيْكُمْ أَنْفُسَكُمْ لَا يَضُرُّكُمْ مَنْ ضَلَّ إِذَا اهْتَدَيْتُمْ} [المائدة: 105]، ثمَّ قال: إنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["إنَّ النَّاسَ إذا رأَوْا مُنكَرًا لا يُغيِّرونَهُ ",1],["أوشَك أنْ يعُمَّهمُ اللهُ بعقابِهِ",2],"."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (16)، والطحاوي في ((شرح مشكل الآثار)) (1169) كلاهما بلفظه، وابن أبي شيبة (37583)، والبيهقي (20214) كلاهما بلفظ مقارب.","bab":"إيمان › الوعيد","dorar":"g45bIPyR"},{"id":"س-04889","fp":"d83cad708653","stateId":642,"easy":"إذا عُملت المعاصي في قوم هم أعز ممن يعملها ثم لم يغيروا ← يعمهم الله بعقاب","cause":"ما منْ قومٍ يعملُ فيهم بالمعاصي، همْ أعزُّ و أكثرُ ممنْ يعملُهُ، ثمَّ لمْ يغيرُوه","result":"إلا عمَّهمُ اللهُ تعالى منهُ بعقابٍ","explicit":true,"repOf":"س-02986","ref":"الجامع الصغير 8066","text":[["ما منْ قومٍ يعملُ فيهم بالمعاصي،  همْ أعزُّ و أكثرُ ممنْ يعملُهُ،  ثمَّ لمْ يغيرُوه،",1],"  ",["إلا عمَّهمُ اللهُ تعالى منهُ بعقابٍ",2]],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجة (4009) واللفظ له، وأبو داود (4339)، وأحمد (19216) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"vzRfEfgW"},{"id":"س-05315","fp":"1e10a8e2e794","stateId":642,"easy":"إذا تمادى القوم في المعاصي ولم ينههم العلماء ← تأخذهم العقوبات","cause":"تَمادَوا في المعاصي ولم يَنهَهُمُ الرَّبَّانيُّونَ والأحبارُ","result":"أخذتْهمُ العقوباتُ","explicit":true,"repOf":"س-02986","ref":"عمدة التفسير 1/705","text":["خطبَ عليُّ بنُ أبي طالبٍ فحمِدَ اللَّهَ وأثنى عليهِ ، ثمَّ قالَ : أيُّها النَّاسُ ، إنَّما هلَكَ مَن كانَ قبلَكُم برُكوبِ المعاصي ، ولم ينهَهُمُ الرَّبَّانيُّونَ والأحبارُ ، فلمَّا ",["تَمادَوا في المعاصي ولم يَنهَهُمُ الرَّبَّانيُّونَ والأحبارُ",1]," ",["أخذتْهمُ العقوباتُ",2]," . فَمُروا بالمعروفِ وانهَوا عنِ المنكرِ ، قبلَ أن يَنزلَ بِكُم مثلُ الَّذي نزلَ بِهِم ، واعلَموا أنَّ الأمرَ بالمعروفِ والنَّهيَ عنِ المنكرِ لا يَقطعُ رزقًا ولا يقرِّبُ أجلًا"],"grade":"صحيح","narrator":"يحيى بن يعمر","muhaddith":"إسناده صحيح ، ولكن في سماع يحيى بن يعمر من علي كلام","takhrij":"أخرجه ابن أبي حاتم في ((التفسير)) (6571)، وعبد الغني المقدسي في ((الأمر بالمعروف)) (54) واللفظ لهما.","bab":"رقائق وزهد › التوكل واليقين","dorar":"xykckZNK"},{"id":"س-04775","fp":"82365d8d7bb2","stateId":642,"easy":"إذا عملت الخاصة منكراً تقدر العامة على تغييره فلم تفعل ← يأذن الله في هلاك الجميع","cause":"حتى تَعْمَلَ الخاصَّةُ بعملٍ تَقْدِرُ العامَّةُ أنْ تُغَيِّرَهُ ولَا تُغَيِّرُهُ","result":"فذاكَ حين يأذَنُ اللهُ في هلاكِ العامَّةِ والخاصَّةِ","explicit":true,"repOf":"س-02986","ref":"مجمع الزوائد 7/271","text":["إنَّ اللهَ لا يعذِّبُ العامَّةَ بعملِ الخاصَّةِ ",["حتى تَعْمَلَ الخاصَّةُ بعملٍ تَقْدِرُ العامَّةُ أنْ تُغَيِّرَهُ ولَا تُغَيِّرُهُ",1]," ",["فذاكَ حين يأذَنُ اللهُ في هلاكِ العامَّةِ والخاصَّةِ",2]],"grade":"حسن","narrator":"العرس بن عميرة الكندي","muhaddith":"رجاله ثقات","takhrij":"أخرجه أحمد (17720)، وابن أبي عاصم في ((الآحاد والمثاني)) (2431)، والطبراني (343) (17/ 138)، وابن الأثير في ((أسد الغابة)) (1322) واللفظ لهم جميعا.","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"ObtC9sF7"},{"id":"س-04865","fp":"70c8d4740e97","stateId":642,"easy":"إذا كان بينكم من يعمل المعاصي وأنتم أعز منه فلم تغيروا ← يصيبكم الله بعقاب","cause":"ما من قومٍ يَكونُ بينَ أظهرِهم رجلٌ يعملُ بالمعاصي هم أمنعُ منهُ وأعزُّ لا يغيِّرونَ عليهِ","result":"إلَّا أصابَهمُ اللَّهُ بعقابٍ","explicit":true,"repOf":"س-02986","ref":"هداية الرواة 4/486","text":[["ما من قومٍ يَكونُ بينَ أظهرِهم رجلٌ يعملُ بالمعاصي هم أمنعُ منهُ وأعزُّ لا يغيِّرونَ عليهِ",1]," ",["إلَّا أصابَهمُ اللَّهُ بعقابٍ",2]],"grade":"حسن","narrator":"جرير بن عبدالله","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه الطبراني (2/331) (2380) واللفظ له، وأخرجه ابن ماجه (4009)، وأحمد (19192) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"hG2Fjcyv"},{"id":"س-05125","fp":"ffd099b35c80","stateId":642,"easy":"إذا عُملت المعاصي في قوم أعز ممن يعملها ← يعمهم الله بعقاب","cause":"ما مِن قومٍ يُعمَلُ فيهم بالمَعاصي أعزُّ وأكثرُ مِمَّا يَعمَلُهُ وهو عندي، واللهُ أعلَمُ مِمَّن يَعمَلُهُ، لا يُغَيِّرونَهُ عليهم","result":"إلَّا عمَّهمُ اللهُ عزَّ وجلَّ بعقابٍ","explicit":true,"repOf":"س-02986","ref":"تخريج مشكل الآثار 1174","text":[["ما مِن قومٍ يُعمَلُ فيهم بالمَعاصي أعزُّ وأكثرُ مِمَّا يَعمَلُهُ وهو عندي، واللهُ أعلَمُ مِمَّن يَعمَلُهُ، لا يُغَيِّرونَهُ عليهم",1]," ",["إلَّا عمَّهمُ اللهُ عزَّ وجلَّ بعقابٍ",2],"."],"grade":"حسن","narrator":"جرير","muhaddith":"إسناده حسن","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Pcz7a5BV"},{"id":"س-07422","fp":"ed09b7a4d721","stateId":642,"easy":"إذا كثر الخبث ← يكون الخسف","cause":"إذا أكثَر أهلُها الخَبَثَ","result":"سيكونُ بعدي خسفٌ","explicit":true,"repOf":"س-01564","ref":"مجمع الزوائد 8/14","text":[["سيكونُ بعدي خسفٌ",2]," بالمشرقِ وخسفٌ بالمغربِ في جزيرةِ العربِ قُلْتُ يا رسولَ اللهِ أيُخسَفُ بالأرضِ وفيها الصَّالِحونَ قال لها رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["إذا أكثَر أهلُها الخَبَثَ",1]],"grade":"حسن","narrator":"أم سلمة أم المؤمنين","muhaddith":"فيه حكيم بن نافع وبقية رجاله ثقات","takhrij":"أخرجه الطبراني (23/271) (580) باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"4PvCR9IH"},{"id":"س-00575","fp":"023f1c7fd7a0","stateId":642,"easy":"إذا خرقتم السفينة (تركتم المنكر) ← تهلكون جميعاً","cause":"نكسِرُ دَفَّ السَّفينةِ فنستقي","result":"فإنَّك إذًا تهلِكُ ونهلِكُ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-00583","ref":"تخريج صحيح ابن حبان 301","text":["مَثَلُ المداهنِ في حدودِ اللهِ والآمِرِ بها والنَّاهي عنها كمَثَلِ قومٍ استَهَموا سفينةً مِن سُفنِ البحرِ فصار بعضُهم في مؤخَّرِ السَّفينةِ وأبعدَهم مِن المِرفَقِ وبعضُهم في أعلى السَّفينةِ فكانوا إذا أرادوا الماءَ وهم في آخِرِ السَّفينةِ آذَوْا رحالَهم فقال بعضُهم: نحنُ أقربُ مِن المِرفَقِ وأبعدُ مِن الماءِ نخرِقُ دفَّةَ السَّفينةِ ونستقي فإذا استغنَيْنا عنه سدَدْناه فقال السُّفهاءُ منهم: افعَلوا قال: فأخَذ الفأسَ فضرَب عرضَ السَّفينةِ فقال رجلٌ منهم رشيدٌ: ما تصنَعُ ؟ قال: نحنُ أقرَبُ مِن المِرفَقِ وأبعدُ مِن الماءِ ",["نكسِرُ دَفَّ السَّفينةِ فنستقي",1]," فإذا استغنَيْنا عنه سدَدْناه فقال: لا تفعَلْ ",["فإنَّك إذًا تهلِكُ ونهلِكُ",2]],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"إسناده صحيح على شرطهما","takhrij":"أخرجه ابن حبان (301) بلفظه، وأخرجه البخاري ( 2686) بنحوه، والطبراني  (34) (21 / 50) بلفظ مقارب، وأخرجه الترمذي (2173)، وأحمد (18361) كلاهما بمعناه","bab":"آداب عامة › ضرب الأمثال","dorar":"PKXdXqZ9"},{"id":"س-00584","fp":"1764aa977446","stateId":642,"easy":"إذا تُرك أهل المعاصي ← غرق الجميع","cause":"وإنْ تَرَكوهم","result":"غَرِقوا جَميعًا","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-00583","ref":"تخريج المسند لشعيب 18361","text":["مَثلُ القائمِ على حُدودِ اللهِ،  والمُدْهِنِ فيها، كمَثلِ قَومٍ استَهَموا على سَفينةٍ في البحرِ، فأصابَ بعضُهم أسفلَها، وأصابَ بعضُهم أعلاها، فكان الذين في أسفلِها يَصعَدونَ، فيَستَقونَ الماءَ، فيَصُبُّونَ على الذين في أعلاها، فقال الذين في أعلاها: لا نَدَعُكم تَصعَدون، فتُؤذونَنا، فقال الذين في أسفلِها: فإنَّنا نَنقُبُها مِن أسفلِها، فنَستَقي؟ قال: فإنْ أخَذوا على أيديهم، فمَنَعوهم؛ نَجَوا جَميعًا، ",["وإنْ تَرَكوهم",1],"؛ ",["غَرِقوا جَميعًا",2],"."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (2493)، والترمذي (2173)، وأحمد (18361) واللفظ له","bab":"آداب عامة › ضرب الأمثال","dorar":"M3mlQNHT"},{"id":"س-02071","fp":"d24e7883d457","stateId":642,"easy":"إذا تُرك العاصي يخرق السفينة ← أهلكه وأهلك نفسه","cause":"وإن تَرَكوه","result":"أهلَكوه وأهلَكوا أنفُسَهم","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-00583","ref":"صحيح البخاري 2686","text":["مَثَلُ المُدهِنِ في حُدودِ اللهِ والواقِعِ فيها مَثَلُ قَومٍ استَهَموا سَفينةً، فصارَ بَعضُهم في أسفَلِها وصارَ بَعضُهم في أعلاها، فكان الذي في أسفَلِها يَمُرُّونَ بالماءِ على الذينَ في أعلاها، فتَأذَّوا به، فأخَذَ فأسًا فجَعَلَ يَنقُرُ أسفَلَ السَّفينةِ، فأتَوه فقالوا: ما لَكَ؟ قال: تَأذَّيتُم بي، ولا بُدَّ لي مِنَ الماءِ، فإن أخَذوا على يَدَيه أنجَوه ونَجَّوا أنفُسَهم، ",["وإن تَرَكوه",1]," ",["أهلَكوه وأهلَكوا أنفُسَهم",2],"."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"[صحيح]","takhrij":"أخرجه الترمذي (2173)، وأحمد (18361)، والبزار (3248) جميعا باختلاف","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"7uPzGbPt"}]}