{"schema":1,"kind":"sunan-chunk","version":"sunan-3f5fd6b9930a","needId":55,"stateIds":[582,583,584,585,586,587,588,589,590,591,592],"items":[{"id":"ق-0064","fp":"2c8c21586481","stateId":582,"easy":"التطوع بالخير والصيام ← خير للعبد","cause":"التطوع بالخير والصيام","result":"خير للعبد","explicit":true,"star":true,"ref":"سورة البقرة: 184","srcLabel":"القرآن الكريم","quran":{"s":2,"from":184,"to":184,"text":"أَيَّامًا مَعْدُودَاتٍ فَمَنْ كَانَ مِنْكُمْ مَرِيضًا أَوْ عَلَى سَفَرٍ فَعِدَّةٌ مِنْ أَيَّامٍ أُخَرَ وَعَلَى الَّذِينَ يُطِيقُونَهُ فِدْيَةٌ طَعَامُ مِسْكِينٍ فَمَنْ تَطَوَّعَ خَيْرًا فَهُوَ خَيْرٌ لَهُ وَأَنْ تَصُومُوا خَيْرٌ لَكُمْ إِنْ كُنْتُمْ تَعْلَمُونَ (184)","hl":[[161,261,1]]}},{"id":"ق-0219","fp":"dfb29b92fe26","stateId":582,"easy":"السمع والطاعة وحسن الخطاب مع النبي ← خير وأقوم","cause":"السمع والطاعة وحسن الخطاب مع النبي","result":"خير وأقوم","explicit":true,"star":true,"ref":"سورة النساء: 46","srcLabel":"القرآن الكريم","quran":{"s":4,"from":46,"to":46,"text":"مِنَ الَّذِينَ هَادُوا يُحَرِّفُونَ الْكَلِمَ عَنْ مَوَاضِعِهِ وَيَقُولُونَ سَمِعْنَا وَعَصَيْنَا وَاسْمَعْ غَيْرَ مُسْمَعٍ وَرَاعِنَا لَيًّا بِأَلْسِنَتِهِمْ وَطَعْنًا فِي الدِّينِ وَلَوْ أَنَّهُمْ قَالُوا سَمِعْنَا وَأَطَعْنَا وَاسْمَعْ وَانْظُرْنَا لَكَانَ خَيْرًا لَهُمْ وَأَقْوَمَ وَلَكِنْ لَعَنَهُمُ اللَّهُ بِكُفْرِهِمْ فَلَا يُؤْمِنُونَ إِلَّا قَلِيلًا (46)","hl":[[182,285,1]]}},{"id":"ق-0225","fp":"90943edcf004","stateId":582,"easy":"ردّ النزاع إلى الله والرسول ← خير وأحسن عاقبة","cause":"ردّ النزاع إلى الله والرسول","result":"خير وأحسن عاقبة","explicit":true,"star":true,"otherNeedIds":[41],"ref":"سورة النساء: 59","srcLabel":"القرآن الكريم","quran":{"s":4,"from":59,"to":59,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا أَطِيعُوا اللَّهَ وَأَطِيعُوا الرَّسُولَ وَأُولِي الْأَمْرِ مِنْكُمْ فَإِنْ تَنَازَعْتُمْ فِي شَيْءٍ فَرُدُّوهُ إِلَى اللَّهِ وَالرَّسُولِ إِنْ كُنْتُمْ تُؤْمِنُونَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ ذَلِكَ خَيْرٌ وَأَحْسَنُ تَأْوِيلًا (59)","hl":[[100,262,1]]}},{"id":"ق-0455","fp":"34e96d757c96","stateId":582,"easy":"الانتهاء عن محاربة الله ورسوله ← خير لهم","cause":"الانتهاء عن محاربة الله ورسوله","result":"خير لهم","explicit":true,"star":true,"ref":"سورة الأنفال: 19","srcLabel":"القرآن الكريم","quran":{"s":8,"from":19,"to":19,"text":"إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ وَإِنْ تَنْتَهُوا فَهُوَ خَيْرٌ لَكُمْ وَإِنْ تَعُودُوا نَعُدْ وَلَنْ تُغْنِيَ عَنْكُمْ فِئَتُكُمْ شَيْئًا وَلَوْ كَثُرَتْ وَأَنَّ اللَّهَ مَعَ الْمُؤْمِنِينَ (19)","hl":[[47,86,1]]}},{"id":"ق-0481","fp":"ce49948627cf","stateId":582,"easy":"التوبة ← خير للعبد","cause":"التوبة","result":"خير للعبد","explicit":true,"star":true,"similar":["ق-0514"],"ref":"سورة التوبة: 3","srcLabel":"القرآن الكريم","quran":{"s":9,"from":3,"to":3,"text":"وَأَذَانٌ مِنَ اللَّهِ وَرَسُولِهِ إِلَى النَّاسِ يَوْمَ الْحَجِّ الْأَكْبَرِ أَنَّ اللَّهَ بَرِيءٌ مِنَ الْمُشْرِكِينَ وَرَسُولُهُ فَإِنْ تُبْتُمْ فَهُوَ خَيْرٌ لَكُمْ وَإِنْ تَوَلَّيْتُمْ فَاعْلَمُوا أَنَّكُمْ غَيْرُ مُعْجِزِي اللَّهِ وَبَشِّرِ الَّذِينَ كَفَرُوا بِعَذَابٍ أَلِيمٍ (3)","hl":[[132,169,1]]}},{"id":"ق-0500","fp":"c076d53ed82c","stateId":582,"easy":"النفير والجهاد بالمال والنفس ← خير للعبد","cause":"النفير والجهاد بالمال والنفس","result":"خير للعبد","explicit":true,"ref":"سورة التوبة: 41","srcLabel":"القرآن الكريم","quran":{"s":9,"from":41,"to":41,"text":"انْفِرُوا خِفَافًا وَثِقَالًا وَجَاهِدُوا بِأَمْوَالِكُمْ وَأَنْفُسِكُمْ فِي سَبِيلِ اللَّهِ ذَلِكُمْ خَيْرٌ لَكُمْ إِنْ كُنْتُمْ تَعْلَمُونَ (41)","hl":[[0,141,1]]}},{"id":"ق-0514","fp":"83344a3f0e02","stateId":582,"easy":"التوبة من النفاق ← خير لهم","cause":"التوبة من النفاق","result":"خير لهم","explicit":true,"repOf":"ق-0481","otherNeedIds":[11],"ref":"سورة التوبة: 74","quran":{"s":9,"from":74,"to":74,"text":"يَحْلِفُونَ بِاللَّهِ مَا قَالُوا وَلَقَدْ قَالُوا كَلِمَةَ الْكُفْرِ وَكَفَرُوا بَعْدَ إِسْلَامِهِمْ وَهَمُّوا بِمَا لَمْ يَنَالُوا وَمَا نَقَمُوا إِلَّا أَنْ أَغْنَاهُمُ اللَّهُ وَرَسُولُهُ مِنْ فَضْلِهِ فَإِنْ يَتُوبُوا يَكُ خَيْرًا لَهُمْ وَإِنْ يَتَوَلَّوْا يُعَذِّبْهُمُ اللَّهُ عَذَابًا أَلِيمًا فِي الدُّنْيَا وَالْآخِرَةِ وَمَا لَهُمْ فِي الْأَرْضِ مِنْ وَلِيٍّ وَلَا نَصِيرٍ (74)","hl":[[206,242,1]]}},{"id":"ق-0809","fp":"3643ced3a717","stateId":582,"easy":"تعظيم حرمات الله ← خير له عند ربه","cause":"تعظيم حرمات الله","result":"خير له عند ربه","explicit":true,"otherNeedIds":[45],"ref":"سورة الحج: 30","srcLabel":"القرآن الكريم","quran":{"s":22,"from":30,"to":30,"text":"ذَلِكَ وَمَنْ يُعَظِّمْ حُرُمَاتِ اللَّهِ فَهُوَ خَيْرٌ لَهُ عِنْدَ رَبِّهِ وَأُحِلَّتْ لَكُمُ الْأَنْعَامُ إِلَّا مَا يُتْلَى عَلَيْكُمْ فَاجْتَنِبُوا الرِّجْسَ مِنَ الْأَوْثَانِ وَاجْتَنِبُوا قَوْلَ الزُّورِ (30)","hl":[[7,75,1]]}},{"id":"ق-0940","fp":"031d3d87b5f0","stateId":582,"easy":"عبادة الله وتقواه ← خير للعبد","cause":"عبادة الله وتقواه","result":"خير للعبد","explicit":true,"ref":"سورة العنكبوت: 16","srcLabel":"القرآن الكريم","quran":{"s":29,"from":16,"to":16,"text":"وَإِبْرَاهِيمَ إِذْ قَالَ لِقَوْمِهِ اعْبُدُوا اللَّهَ وَاتَّقُوهُ ذَلِكُمْ خَيْرٌ لَكُمْ إِنْ كُنْتُمْ تَعْلَمُونَ (16)","hl":[[37,115,1]]}},{"id":"ق-1218","fp":"c099dcb746e9","stateId":582,"easy":"صدق الله عند العزم ← خير لهم","cause":"صدق الله عند العزم","result":"خير لهم","explicit":true,"ref":"سورة محمد: 21","srcLabel":"القرآن الكريم","quran":{"s":47,"from":21,"to":21,"text":"طَاعَةٌ وَقَوْلٌ مَعْرُوفٌ فَإِذَا عَزَمَ الْأَمْرُ فَلَوْ صَدَقُوا اللَّهَ لَكَانَ خَيْرًا لَهُمْ (21)","hl":[[52,98,1]]}},{"id":"ق-1333","fp":"d2875532c1d5","stateId":582,"easy":"السعي إلى ذكر الله وترك البيع عند نداء الجمعة ← خير للعبد","cause":"السعي إلى ذكر الله وترك البيع عند نداء الجمعة","result":"خير للعبد","explicit":true,"ref":"سورة الجمعة: 9","srcLabel":"القرآن الكريم","quran":{"s":62,"from":9,"to":9,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا نُودِيَ لِلصَّلَاةِ مِنْ يَوْمِ الْجُمُعَةِ فَاسْعَوْا إِلَى ذِكْرِ اللَّهِ وَذَرُوا الْبَيْعَ ذَلِكُمْ خَيْرٌ لَكُمْ إِنْ كُنْتُمْ تَعْلَمُونَ (9)","hl":[[81,154,1]]}},{"id":"ق-1346","fp":"f6f3989055e0","stateId":582,"easy":"التقوى قدر الاستطاعة والسمع والطاعة والإنفاق ← خير للنفس","cause":"التقوى قدر الاستطاعة والسمع والطاعة والإنفاق","result":"خير للنفس","explicit":true,"ref":"سورة التغابن: 16","srcLabel":"القرآن الكريم","quran":{"s":64,"from":16,"to":16,"text":"فَاتَّقُوا اللَّهَ مَا اسْتَطَعْتُمْ وَاسْمَعُوا وَأَطِيعُوا وَأَنْفِقُوا خَيْرًا لِأَنْفُسِكُمْ وَمَنْ يُوقَ شُحَّ نَفْسِهِ فَأُولَئِكَ هُمُ الْمُفْلِحُونَ (16)","hl":[[0,96,1]]}},{"id":"س-07736","fp":"ba4107cf0830","stateId":582,"easy":"إذا تزودت للسفر ← فإن خير الزاد التقوى","cause":"يحجُّونَ ، ولا يتزوَّدونَ","result":"وَتَزَوَّدُوا فَإِنَّ خَيْرَ الزَّادِ التَّقْوَى","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح أبي داود 1730","srcLabel":"البخاري","text":["عنِ ابنِ عبَّاسٍ قالَ كانوا ",["يحجُّونَ ، ولا يتزوَّدونَ",1]," قالَ أبو مسعودٍ كانَ أهْلُ اليمنِ أو ناسٌ من أهْلِ اليمَنِ يحجُّونَ ولا يتزوَّدونَ ويقولونَ نحنُ المتوَكِّلونَ فأنزلَ اللَّهُ سبحانَهُ  ",["وَتَزَوَّدُوا فَإِنَّ خَيْرَ الزَّادِ التَّقْوَى",2],"  الآيةَ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1730) واللفظ له، وأخرجه البخاري (1523) باختلاف يسير","bab":"قرآن › أسباب النزول","dorar":"rGDMAR4D"},{"id":"س-00902","fp":"8c3642f5ad32","stateId":582,"easy":"إذا اتقيت الله ← فهي جماع كل خير","cause":"عليكَ بتقوَى اللهِ","result":"فإنَّها جِماعُ كلِّ خيرٍ","explicit":true,"ref":"صحيح الترغيب 2869","srcLabel":"الطبراني","text":[["عليكَ بتقوَى اللهِ ، ",1],["فإنَّها جِماعُ كلِّ خيرٍ",2]," ، وعليكَ بالجهادِ في سبيلِ اللهِ ، فإنَّها رهبانيةُ المسلمينَ ، وعليكَ بذكرِ اللهِ وتلاوةِ كتابِهِ ، فإنَّهُ نورٌ لكَ في الأرضِ ، وذِكرٌ لكَ في السَّماءِ . . . ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو يعلى (1000)، والطبراني في ((المعجم الصغير)) (949)، والبيهقي في ((الآداب)) (835) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"EzATOcwG"},{"id":"س-02028","fp":"b9384e352fe8","stateId":582,"easy":"إذا تركت شيئاً اتقاء الله ← يعطيك الله خيراً منه","cause":"تَدَعَ شَيئًا اتِّقاءَ اللهِ","result":"إلَّا أَعْطاك اللهُ خَيْرًا مِنه","explicit":true,"otherNeedIds":[1],"ref":"الصحيح المسند 1489","srcLabel":"أحمد","text":["عن أبي قَتادةَ وأبي الدَّهْماءِ قالا: كانا يُكثِرانِ السَّفَرَ نَحْوَ هذا البَيْتِ، قالا أَتَيْنا على رَجُلٍ مِن أهْلِ البادِيةِ، فقالَ البَدَويُّ: أخَذَ بيَدي رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، فجَعَلَ يُعَلِّمُني ممَّا عَلَّمَه اللهُ تَبارَكَ وتَعالى، وقالَ: «إنَّك لن ",["تَدَعَ شَيئًا اتِّقاءَ اللهِ",1]," جَلَّ وعَزَّ ",["إلَّا أَعْطاك اللهُ خَيْرًا مِنه",2],"»."],"grade":"صحيح","narrator":"أبو قتادة وأبو الدهماء","muhaddith":"صحيح","takhrij":"أخرجه أحمد (20739) بلفظه، وأبو نعيم (7315)، والبيهقي (5364) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"jKKQd18T"},{"id":"س-07005","fp":"e5fbc3a525b7","stateId":582,"easy":"إذا أطعت رسول الله ﷺ ← فهو خير لك","cause":"وطاعةُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم","result":"خيرٌ لكم","explicit":true,"ref":"صحيح النسائي 3873","srcLabel":"النسائي","text":["نهانا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم عن أمرٍ ، كان لنا نافعًا ، ",["وطاعةُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم",1]," ",["خيرٌ لكم",2]," ، نهاكم عن : الحقلِ ، وقال : من كانت له أرضٌ فليمنَحْها ، أو ليدَعْها . ونهَى عن المُزابَنةِ : والمُزابَنةُ الرَّجلُ يكونُ له المالُ العظيمُ من النَّخلِ ، فيجيءُ الرَّجلُ فيأخذُها بكذا وكذا وسقا من تمرٍ"],"grade":"صحيح","narrator":"رافع بن خديج","muhaddith":"صحيح","takhrij":"أخرجه النسائي (3864)، وأبو دلود (3398)، وابن ماجه (2460)، وأحمد (15817) واللفظ لهم جميعا.","bab":"علم › الحث على الأخذ بالسنة","dorar":"y6oLzx7r"},{"id":"س-07271","fp":"a943691c286c","stateId":582,"easy":"إذا مت في طاعة الله ← فهو خير من حياة في معصيته","cause":"موتٌ في طاعةِ اللهِ","result":"خيرٌ من حياةٍ في معصيةِ اللهِ","explicit":true,"ref":"سبل الهدى والرشاد 10/136","srcLabel":"الطبراني","text":["«خُذوا العطاءَ ما دام عطاءٌ، فإذا صار رِشوةٌ على الدِّينِ فلا تأخُذوه، ولستُم بتاركيه، يمنَعُكم من ذلك المخافةُ والفقرُ، ألا وإنَّ رحى الإيمانِ دائرةٌ، وإنَّ رحى الإسلامِ دائرةٌ، فدوروا مع الكتابِ حيث يدورُ، ألا وإنَّ السُّلطانَ والكتابَ سيفتَرِقان، ألا فلا تفارِقوا الكتابَ، ألا إنَّه سيكونُ عليكم أمراءُ إن أطعتُموهم أضلُّوكم، وإن عصيتُموهم قتَلوكم»، قالوا: فكيف نصنعُ يا رسولَ اللهِ؟ قال: «كما صنع أصحابُ عيسى بنِ مريمَ حُمِلوا على الخُشُبِ ونُشِروا بالمناشيرِ، ",["موتٌ في طاعةِ اللهِ",1]," ",["خيرٌ من حياةٍ في معصيةِ اللهِ",2],"»"],"grade":"حسن","narrator":"معاذ بن جبل","muhaddith":"رجاله ثقات","takhrij":"أخرجه ابن راهويه كما في ((المطالب العالية)) لابن حجر (4344)، والطبراني (20/ 90)، (172)، وأبو نعيم الأصبهاني في ((حلية الأولياء)) (5/ 165) جميعهم بلفظه.","bab":"فتن › أمراء الجور","dorar":"FHryksVR"},{"id":"س-02450","fp":"c257c64697b6","stateId":582,"easy":"إذا قلت «لا إله إلا هو» ← فهو خير لك","cause":"قُلْ: لا إلهَ إلَّا هو","result":"خَيْرٌ لي؟ قال: نَعَمْ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«لا إله إلا هو»"},"similar":["س-02402"],"otherNeedIds":[62],"ref":"تخريج المسند لشعيب 12543","srcLabel":"مسلم","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ دَخَلَ على رَجُلٍ من بَني النَّجَّارِ يَعودُه، فقال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا خالُ، قُلْ: لا إلهَ إلَّا اللهُ. فقال: أوَ خالٌ أنا أو عَمٌّ؟ فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: لا بَلْ خالٌ، فقال له: ",["قُلْ: لا إلهَ إلَّا هو",1],"، قال: ",["خَيْرٌ لي؟ قال: نَعَمْ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (12543) واللفظ له، والبزار (6984)، وأبو يعلى (3512)","bab":"إسلام › فضل الشهادتين","dorar":"kn3qn12Q"},{"id":"س-02402","fp":"a89bc5546238","stateId":582,"easy":"إذا شهدت أن لا إله إلا الله ← فهو الخير كله","cause":"تشهَدُ أنْ لا إلهَ إلَّا اللهُ وحدَه لا شريكَ له وأنَّ محمَّدًا عبدُه ورسولُه","result":"هل لك إلى خيرٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-02450","ref":"صحيح ابن حبان 6505","text":["كنَّا مع النَّبيِّ صلَّى اللهُ عليه وسلَّم في سَفَرٍ فأقبَل أعرابيٌّ فلمَّا دنا منه قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ( أين تُريدُ ؟ ) قال : إلى أهلي قال : ( ",["هل لك إلى خيرٍ",2]," ؟ ) قال : ما هو ؟ قال : ( ",["تشهَدُ أنْ لا إلهَ إلَّا اللهُ وحدَه لا شريكَ له وأنَّ محمَّدًا عبدُه ورسولُه",1]," ) قال : هل مِن شاهدٍ على ما تقولُ ؟ قال صلَّى اللهُ عليه وسلَّم ( هذه السَّمُرَةُ ) فدعاها رسولُ اللهِ صلَّى اللهُ عليه وسلَّم وهي بشاطئِ الوادي فأقبَلَتْ تخُدُّ الأرضَ خَدًّا حتَّى كانت بيْنَ يدَيْهِ فاستشهَدها ثلاثًا فشهِدَتْ أنَّه كما قال ثمَّ رجَعَتْ إلى مَنْبَتِها ورجَع الأعرابيُّ إلى قومِه وقال : إنْ يتَّبِعوني أتَيْتُك بهم وإلَّا رجَعْتُ إليك فكُنْتُ معك"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البزار كما في ((كشف الأستار)) للهيثمي (2411)، والبيهقي في ((دلائل النبوة)) (6/14)، وابن عساكر في ((تاريخ دمشق)) (4/364) باختلاف يسير","bab":"إسلام › فضل الشهادتين","dorar":"EtPI5DCy"},{"id":"س-00677","fp":"fbbd10a4cd64","stateId":583,"easy":"إذا دعوت «اللهم اغفر لنا وارحمنا وآتنا في الدنيا حسنة...» ← تُؤتى خير الدنيا والآخرة","cause":"اللهمَّ اغفِرْ لنا وارحمنا ، وآتِنَا في الدنيا حسنةً وفي الآخرةِ حسنةً وقنا عذابَ النارِ","result":"إن أُوتيتُمْ هذا ، فقد أوتيتم خيرَ الدنيا والآخرةِ","explicit":true,"star":true,"apply":{"k":"say","t":"«اللهمَّ اغفِرْ لنا وارحمنا ، وآتِنَا في الدنيا حسنةً وفي الآخرةِ حسنةً وقنا عذابَ النارِ»"},"similar":["س-03716"],"ref":"صحيح الأدب المفرد 493","srcLabel":"البخاري","text":["عن أنسِ بنِ مالكٍ قال قيل له إنَّ إخوانَك أتوْكَ من البصرةِ - وهو يومئذٍ - ب ( الزاويةِ ) - لتدعُوَ اللهَ لهم ، قال : ",["اللهمَّ اغفِرْ لنا وارحمنا ، وآتِنَا في الدنيا حسنةً وفي الآخرةِ حسنةً وقنا عذابَ النارِ",1]," . فاستزادوهُ فقال مثلَها ، فقال : ",["إن أُوتيتُمْ هذا ، فقد أوتيتم خيرَ الدنيا والآخرةِ",2]],"grade":"صحيح","narrator":"عبدالله الرومي","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (633) بلفظه، وأبو يعلى الموصلي (3397)، وابن حبان (938) باختلاف يسير.","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"84ZaJQ2U"},{"id":"س-03716","fp":"18cd08e8dffa","stateId":583,"easy":"إذا دعوت «اللهم آتنا في الدنيا حسنة وفي الآخرة حسنة وقنا عذاب النار» ← سألت خير الدنيا والآخرة","cause":"اللَّهمَّ آتِنا في الدُّنيا حَسنةً وفي الآخرةِ حَسنةً وقِنا عذابَ النَّارِ","result":"سأَلْتُ لكم خيرَ الدُّنيا والآخرةِ","explicit":true,"apply":{"k":"say","t":"«اللهم آتنا في الدنيا حسنة وفي الآخرة حسنة وقنا عذاب النار»"},"repOf":"س-00677","ref":"تخريج صحيح ابن حبان 938","text":["أنَّهم قالوا لأنَسِ بنِ مالكٍ : ادعُ اللهَ لنا فقال : ",["اللَّهمَّ آتِنا في الدُّنيا حَسنةً وفي الآخرةِ حَسنةً وقِنا عذابَ النَّارِ",1]," قالوا : زِدْنا فأعادها قالوا : زِدْنا فأعادها فقالوا : زِدْنا فقال : ما تُريدونَ ؟ ",["سأَلْتُ لكم خيرَ الدُّنيا والآخرةِ",2]," قال أنَسٌ : وكان رسولُ اللهِ صلَّى اللهُ عليه وسلَّم يُكثِرُ أنْ يدعوَ بها : ( اللَّهمَّ آتِنا في الدُّنيا حَسنةً وفي الآخرةِ حَسنةً وقِنا عذابَ النَّارِ )"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (938) واللفظ له، وأبو يعلى (3397) باختلاف يسير، والبخاري (6389)، ومسلم (2690) مختصرًا.","bab":"اعتصام بالسنة › لزوم السنة","dorar":"YSGDjYFN"},{"id":"س-00674","fp":"29b7d8dff20d","stateId":583,"easy":"إذا دعوت «اللهم اغفر لي وارحمني واهدني وارزقني» ← تجمع لك خير دنياك وآخرتك","cause":"قُلْ: اللهُمَّ اغفِرْ لي، وارحَمْني، واهْدِني، وارزُقْني","result":"هؤلاءِ يجْمَعْنَ لكَ خيرَ دُنْياكَ وآخِرَتِكَ","explicit":true,"star":true,"apply":{"k":"say","t":"«اللهم اغفر لي وارحمني واهدني وارزقني»"},"otherNeedIds":[29],"ref":"تخريج المسند لشعيب 27211","srcLabel":"مسلم","text":["أنَّه سَمِعَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ وإذا أتاهُ الإنسانُ يسأَلُه، قال: يا نَبِيَّ اللهِ، كيفَ أقولُ حينَ أسْأَلُ رَبِّي؟ قال: ",["قُلْ: اللهُمَّ اغفِرْ لي، وارحَمْني، واهْدِني، وارزُقْني",1],". وقبَضَ كفَّهُ إلا الإبْهامَ، وقال: ",["هؤلاءِ يجْمَعْنَ لكَ خيرَ دُنْياكَ وآخِرَتِكَ",2],"."],"grade":"صحيح","narrator":"طارق بن أشيم الأشجعي","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2697)، وابن ماجه (3845)، وأحمد (27211) واللفظ له","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"9DF3hD1N","merged":2,"otherRefs":["صحيح الأدب المفرد 507 (صحيح)"]},{"id":"س-03241","fp":"506a10a33359","stateId":583,"easy":"إذا سألت الله أن يعيذك من عذاب النار والقبر ← كان خيراً وأفضل","cause":"سَألتِ اللهَ أن يُعيذَكِ مِن عَذابٍ في النَّارِ، أو عَذابٍ في القَبرِ","result":"كان خَيرًا وأفضَلَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"صحيح مسلم 2663","srcLabel":"متفق عليه","text":["قالت أُمُّ حَبيبةَ زَوجُ النَّبيِّ صلَّى اللهُ عليه وسلَّم: اللَّهمَّ أمتِعْني بزَوجي رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، وبأبي أبي سُفيانَ، وبأخي مُعاويةَ، قال: فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: قد سَألتِ اللهَ لآجالٍ مَضروبةٍ، وأيَّامٍ مَعدودةٍ، وأرزاقٍ مَقسومةٍ، لَن يُعَجِّلَ شيئًا قَبلَ حِلِّه، أو يُؤَخِّرَ شيئًا عن حِلِّه، ولو كُنتِ ",["سَألتِ اللهَ أن يُعيذَكِ مِن عَذابٍ في النَّارِ، أو عَذابٍ في القَبرِ",1],"، ",["كان خَيرًا وأفضَلَ",2],"، قال: وذُكِرَت عِندَه القِرَدةُ، قال مِسعَرٌ: وأُراه قال: والخَنازيرُ مِن مَسخٍ، فقال: إنَّ اللهَ لم يَجعَلْ لمَسخٍ نَسلًا ولا عَقِبًا، وقد كانَتِ القِرَدةُ والخَنازيرُ قَبلَ ذلك. وفي روايةٍ: مِن عَذابٍ في النَّارِ وعَذابٍ في القَبرِ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"استعاذة › التعوذ","dorar":"nzosEPeJ","merged":2,"otherRefs":["صحيح مسلم 2663 (صحيح)"]},{"id":"س-00684","fp":"66c133bf6879","stateId":583,"easy":"إذا آتاك الله في الدنيا حسنة وفي الآخرة حسنة ووقاك النار ← فقد آتاك الخير كله","cause":"آتاكمُ اللَّهُ في الدُّنيا حَسنةً وفي الآخرةِ حَسنةً ووقاكُم عذابَ النَّارِ","result":"فَقد آتاكمُ الخيرَ كُلَّهُ","explicit":true,"otherNeedIds":[29],"ref":"عمدة التفسير 1/251","srcLabel":"ابن أبي حاتم","text":["كنتُ عندَ أنسِ بنِ مالِكٍ ، فقالَ لَهُ ثابتٌ : إنَّ إخوانَكَ يحبُّونَ أن تَدعوَ لَهُم . فقالَ : اللَّهمَّ آتِنا في الدُّنيا حَسَنةً وفي الآخرةِ حَسَنةً وقِنا عذابَ النَّارِ ، وتحدَّثوا ساعةً ، حتَّى إذا أرادوا القيامَ ، قال : يا أبا حَمزةَ إنَّ إخوانَكَ يُريدونَ القيامَ فادعُ اللَّهَ لَهُم ،فقالَ تريدونَ أن أشقِّقَ لَكُمُ الأمورَ ، إذا ",["آتاكمُ اللَّهُ في الدُّنيا حَسنةً وفي الآخرةِ حَسنةً ووقاكُم عذابَ النَّارِ",1]," ، ",["فَقد آتاكمُ الخيرَ كُلَّهُ",2]],"grade":"صحيح","narrator":"عبدالسلام بن شداد","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي حاتم في ((التفسير)) (1886) بلفظه، وابن أبي شيبة (30216) باختلاف يسير.","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"ZsZosBAz"},{"id":"س-00689","fp":"2290325ab7d4","stateId":583,"easy":"إذا قلت «اللهم احفظني بالإسلام قاعداً وقائماً وراقداً» ← فهي كلمات خير لك","cause":"قلِ : اللَّهمَّ احفَظْني بالإسلامِ قاعدًا واحفَظْني بالإسلامِ قائمًا واحفَظْني بالإسلامِ راقدًا ولا تُطِعْ فيَّ عدوًّا حاسدًا وأعوذُ بكَ مِن شرِّ ما أنتَ آخِذٌ بناصيتِه وأسأَلُكَ مِن الخيرِ الَّذي هو بيدِكَ كلِّه","result":"كلماتٍ هي خيرٌ لكَ","explicit":true,"apply":{"k":"say","t":"«اللهم احفظني بالإسلام قاعداً وقائماً وراقداً»"},"ref":"صحيح ابن حبان 934","srcLabel":"البيهقي","text":["أنَّ عُمَرَ بنَ الخطَّابِ أصابَتْه مُصيبةٌ فأتى رسولَ اللهِ صلَّى اللهُ عليه وسلَّم فشكا إليه ذلكَ وسأَله أنْ يأمُرَ له بوَسْقٍ مِن تمرٍ فقال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ( إنْ شِئْتَ أمَرْتُ لكَ بوَسْقٍ مِن تمرٍ وإنْ شِئْتَ علَّمْتُكَ ",["كلماتٍ هي خيرٌ لكَ",2]," ) ؟ قال : علِّمْنيهنَّ ومُرْ لي بوَسْقٍ فإنِّي ذو حاجةٍ إليه فقال : ( ",["قلِ : اللَّهمَّ احفَظْني بالإسلامِ قاعدًا واحفَظْني بالإسلامِ قائمًا واحفَظْني بالإسلامِ راقدًا ولا تُطِعْ فيَّ عدوًّا حاسدًا وأعوذُ بكَ مِن شرِّ ما أنتَ آخِذٌ بناصيتِه وأسأَلُكَ مِن الخيرِ الَّذي هو بيدِكَ كلِّه",1]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الخرائطي في ((مساويء الأخلاق)) (723)، والبيهقي في ((الدعوات الكبير)) (252)، والضياء المقدسي في ((المختارة)) (296) باختلاف يسير.","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"GugSvlnZ"},{"id":"س-01121","fp":"7e182a9be520","stateId":583,"easy":"إذا قلت عند خروجك «آمنت بالله اعتصمت بالله...» ← تُرزق خير المخرج ويُصرف عنك شره","cause":"ما مِن مسلمٍ يخرُجُ مِن بيتِه يُريدُ سَفَرًا أو غيرَه فقال حينَ يخرُجُ آمَنْتُ باللهِ اعتصَمْتُ باللهِ توكَّلْتُ على اللهِ لا حولَ ولا قوَّةَ إلَّا باللهِ","result":"إلَّا رُزِقَ خيرَ ذلك المَخْرَجِ وصُرِفَ عنه شرُّ ذلك المَخْرَجِ","explicit":true,"apply":{"k":"say","t":"«آمَنْتُ باللهِ اعتصَمْتُ باللهِ توكَّلْتُ على اللهِ لا حولَ ولا قوَّةَ إلَّا باللهِ إلَّا رُزِقَ خيرَ ذلك المَخْرَجِ وصُرِفَ عنه شرُّ ذلك المَخْرَج»"},"otherNeedIds":[31],"ref":"مجمع الزوائد 10/131","srcLabel":"أحمد","text":[["ما مِن مسلمٍ يخرُجُ مِن بيتِه يُريدُ سَفَرًا أو غيرَه فقال حينَ يخرُجُ آمَنْتُ باللهِ اعتصَمْتُ باللهِ توكَّلْتُ على اللهِ لا حولَ ولا قوَّةَ إلَّا باللهِ ",1],["إلَّا رُزِقَ خيرَ ذلك المَخْرَجِ وصُرِفَ عنه شرُّ ذلك المَخْرَجِ",2]],"grade":"حسن","narrator":"عثمان بن عفان","muhaddith":"[فيه] رجل عن عثمان وبقية رجاله ثقات","takhrij":"أخرجه أحمد (471)، وابن أبي الدنيا في ((التوكل على الله)) (45)، وابن السني في ((عمل اليوم والليلة)) (491) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"C6gUXGUX"},{"id":"س-01257","fp":"5b9ade29f6bc","stateId":583,"easy":"إذا قلت «اللهم اغفر لي وارحمني وعافني واهدني وارزقني» ← فقد ملأت يديك من الخير","cause":"تقولُ: اللَّهُمَّ اغْفِرْ لي، وارْحَمْني، وعافِني، واهْدِني، وارْزُقْني","result":"أمَّا هذا فقدْ مَلَأَ يَدَيه مِن الخَيْرِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«اللهم اغفر لي وارحمني وعافني واهدني وارزقني»"},"similar":["س-01201"],"ref":"الأحاديث المختارة 13 / 102","srcLabel":"متفق عليه","text":["«جاءَ رَجُلٌ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فقالَ: إنِّي لا أَسْتَطيعُ أن أَتَعَلَّمَ القُرآنَ، فما يجْزيني؟ قالَ: تَقولُ: سُبْحانَ اللهِ، والحَمْدُ للهِ، ولا حَوْلَ ولا قُوَّةَ إلَّا باللهِ، ولا إلهَ إلَّا اللهُ، واللهُ أَكبَرُ، قالَ: فقالَ الرَّجُلُ: هكذا، وجَمَعَ أصْابِعَه الخَمْسَ، فقالَ: هذا لله، فما لي؟ قالَ: ",["تقولُ: اللَّهُمَّ اغْفِرْ لي، وارْحَمْني، وعافِني، واهْدِني، وارْزُقْني",1],"، قالَ: فقَبَضَ الرَّجُلُ كَفَّيه جَميعًا، فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",["أمَّا هذا فقدْ مَلَأَ يَدَيه مِن الخَيْرِ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن أبي أوفى","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"أدعية وأذكار › فضل لا حول ولا قوة إلا بالله","dorar":"TTJ3QQjI"},{"id":"س-00669","fp":"f00bca9fce1d","stateId":583,"easy":"إذا سألت ربك العفو والعافية في الدنيا والآخرة ← ينفعك الله به","cause":"سَلْ رَبَّكَ العَفوَ، والعافيةَ في الدُّنيا والآخِرةِ","result":"فعلِّمْني شَيئًا يَنفَعُني اللهُ به","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"تخريج المسند لشعيب 1767","srcLabel":"أحمد","text":["عن أبيهِ عبَّاسِ بنِ عَبدِ المُطَّلِبِ قال: أتَيتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقلتُ: يا رَسولَ اللهِ، أنا عَمُّكَ، قد كبِرَتْ سِنِّي.. فذكَرَ مَعناهُ [أي معنى حَديثِ: عن أبيهِ العبَّاسِ، أنَّهُ أتى رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقال: يا رَسولَ اللهِ، أنا عَمُّكَ، كبِرَتْ سِنِّي، واقتَرَبَ أجَلي، ",["فعلِّمْني شَيئًا يَنفَعُني اللهُ به",2],". قال: يا عبَّاسُ، أنتَ عَمِّي، ولا أُغني عنكَ مِنَ اللهِ شَيئًا، ولكنْ ",["سَلْ رَبَّكَ العَفوَ، والعافيةَ في الدُّنيا والآخِرةِ",1],". قالَها ثَلاثًا، ثم أتاهُ عِندَ قَرنِ الحَولِ، فقال له مِثلَ ذلك.]"],"grade":"حسن","narrator":"العباس بن عبدالمطلب","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (1767) واللفظ له، وابن سعد في ((الطبقات الكبرى)) (4749)","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"gVOhpJnp"},{"id":"س-01201","fp":"1d2d393002c1","stateId":583,"easy":"إذا قلت «اللهم اغفر لي وارحمني وعافني وارزقني» ← فقد ملأت يديك خيراً","cause":"تقول : اللهمَّ اغفِرْ لي ، وارْحمني ، وعافني ، وارزُقني","result":"وقد ملأ يدَيه خيرًا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«اللهم اغفر لي وارحمني وعافني وارزقني»"},"repOf":"س-01257","ref":"صحيح الترغيب 1561","text":["قال أعرابيٌّ يا رسولَ اللهِ إني قد عالجتُ القرآنَ فلم أستطِعْه فعلِّمْني شيئًا يُجزئُ من القرآنِ ؟ قل : ( سبحان اللهِ ، والحمدُ لله ، ولا إله إلا اللهُ ، واللهُ أكبرُ ) . فقالها ، وأمسكَها بأصبعِه ، فقال : يا رسولَ اللهِ ! هذا لربي ، فما لي ؟ قال : ",["تقول : اللهمَّ اغفِرْ لي ، وارْحمني ، وعافني ، وارزُقني",1]," ، وأحسبُه قال : - واهدِني . ومضى الأعرابيُّ ، فقال رسولُ اللهِ : ذهب الأعرابيُّ ",["وقد ملأ يدَيه خيرًا",2]," ."],"grade":"حسن","narrator":"عبدالله بن أبي أوفى","muhaddith":"حسن","takhrij":"أخرجه أبو داود (832)، وأحمد (19110) باختلاف يسير، والنسائي (924) مختصراً باختلاف يسير","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"2jfIR1ab"},{"id":"س-00778","fp":"919c24098d6b","stateId":584,"easy":"إذا قلت «اللهم رب السماوات السبع... اقضِ عنا الدين وأغننا من الفقر» ← فهو خير لك من خادم","cause":"تقولينَ: اللَّهمَّ ربَّ السَّمواتِ السَّبعِ، وربَّ العَرشِ العظيمِ، ربَّنا وربَّ كُلِّ شيءٍ، مُنزِلَ التَّوراةِ والإنجيلِ...، الحديث. يعني حديثَ: جاءت فاطِمةُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم تسألُه خادِمًا","result":"ألا أدُلُّك على ما هو خيرٌ لك مِن ذلك","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«اللهم رب السماوات السبع... اقضِ عنا الدين وأغننا من الفقر»"},"ref":"علل الدارقطني 1980","srcLabel":"الترمذي","text":["دخلَت فاطِمةُ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّم تسألُه خادِمًا، فقال لها رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["ألا أدُلُّك على ما هو خيرٌ لك مِن ذلك",2],"؟",[" تقولينَ: اللَّهمَّ ربَّ السَّمواتِ السَّبعِ، وربَّ العَرشِ العظيمِ، ربَّنا وربَّ كُلِّ شيءٍ، مُنزِلَ التَّوراةِ والإنجيلِ...، الحديث. [يعني حديثَ: جاءت فاطِمةُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم تسألُه خادِمًا",1],"، فقال لها: \"قولي: ‌اللَّهمَّ ‌ربَّ ‌السَّمواتِ ‌السَّبعِ، ‌وربَّ ‌العَرشِ ‌العظيمِ، ‌ربَّنا ‌وربَّ ‌كُلِّ ‌شيءٍ، ‌مُنزِلَ ‌التَّوراةِ ‌والإنجيلِ والقرآنِ، فالِقَ الحَبِّ والنَّوى، أعوذُ بك مِن شرِّ كُلِّ شيءٍ أنت آخِذٌ بناصيتِه، أنت الأوَّلُ فليس قَبلَك شيءٌ، وأنت الآخِرُ فليس بَعدَك شيءٌ، وأنت الظَّاهِرُ فليس فَوقَك شيءٌ، وأنت الباطِنُ فليس دونَك شيءٌ، اقضِ عنِّي الدَّينِ، وأغنِني مِن الفَقرِ\"]."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[حكى فيه الخلافَ على الأعمَشِ، ثُمَّ قال]: وحديثُ أبي هُرَيرةَ محفوظٌ عن الأعمَشِ وسُهَيلٍ.","takhrij":"أخرجه الترمذي (3481)، وابن ماجه (3831)، والنسائي في ((السنن الكبرى)) (7622) جميعهم ببلفظه تاما.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"90RVpphs"},{"id":"س-00896","fp":"9ccb6457e409","stateId":584,"easy":"إذا قلت «اللهم رب السماوات السبع ورب العرش العظيم...» ← فهو خير من خادم","cause":"قولي : اللَّهمَّ ربَّ السَّماواتِ السَّبعِ وربَّ العرشِ العظيمِ ربَّنا وربَّ كلِّ شيءٍ مُنْزِلَ التَّوراةِ والإنجيلِ والقرآنِ العظيمِ أنتَ الأوَّلُ فليسَ قبلَكَ شيءٌ وأنتَ الآخرُ فليسَ بعدَكَ شيءٌ وأنتَ الظَّاهرُ فليسَ فوقَكَ شيءٌ وأنتَ الباطنُ فليسَ دونَكَ شيءٌ اقضِ عنَّا الدَّينَ وأغنِنا منَ الفقرِ","result":"ما هوَ خيرٌ منهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«اللَّهمَّ ربَّ السَّماواتِ السَّبعِ وربَّ العرشِ العظيمِ ربَّنا وربَّ كلِّ شيءٍ مُنْزِلَ التَّوراةِ والإنجيلِ والقرآنِ العظيمِ أنتَ الأوَّلُ فليسَ قبلَكَ شيءٌ وأنتَ الآخرُ فليسَ بعدَكَ شيءٌ وأنتَ الظَّاهرُ فليسَ فوقَكَ شيءٌ وأنتَ الباطنُ فليسَ دونَكَ شيءٌ اقضِ عنَّا الدَّينَ وأغنِنا منَ الفقر»"},"otherNeedIds":[2],"ref":"صحيح ابن ماجه 3104","srcLabel":"ابن ماجه","text":["أتت فاطمةُ النَّبيَّ صلَّى اللَّه عليهِ وسلَّمَ تسألُهُ خادمًا فقالَ لَها : ما عندي ما أعطيكِ . فرجَعت فأتاها بعدَ ذلِكَ فقالَ : الَّذي سألتِ أحبُّ إليكِ أو ",["ما هوَ خيرٌ منهُ",2]," ؟ فقالَ لَها عليٌّ : قولي لَا بل ما هوَ خيرٌ منهُ فقالَت : فقالَ : ",["قولي : اللَّهمَّ ربَّ السَّماواتِ السَّبعِ وربَّ العرشِ العظيمِ ربَّنا وربَّ كلِّ شيءٍ مُنْزِلَ التَّوراةِ والإنجيلِ والقرآنِ العظيمِ أنتَ الأوَّلُ فليسَ قبلَكَ شيءٌ وأنتَ الآخرُ فليسَ بعدَكَ شيءٌ وأنتَ الظَّاهرُ فليسَ فوقَكَ شيءٌ وأنتَ الباطنُ فليسَ دونَكَ شيءٌ اقضِ عنَّا الدَّينَ وأغنِنا منَ الفقرِ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (3831)","bab":"أدعية وأذكار › فضل الذكر","dorar":"88OtpIDB"},{"id":"س-06410","fp":"213b2f879b0e","stateId":584,"easy":"إذا سبّحت وحمدت وكبّرت دبر الصلاة وعند النوم ← فهو خير لكما من خادم","cause":"تُسبِّحانِ في دُبُرَ كلِّ صلاةٍ عشرًا وتحمدانِ عشرًا وتُكبِّرانِ عشرًا وإذا آويتُما إلى فراشكما فسبِّحَا ثلاثًا وثلاثين واحمدا ثلاثًا وثلاثين وكبِّرَا أربعًا وثلاثين","result":"ألا أُخبركما بخيرٍ مما سألتماني","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"apply":{"k":"time","t":"عند النوم، دبر كل صلاة"},"similar":["س-00770","س-00877","س-00796","س-00844","س-01108"],"ref":"تخريج المسند لشاكر 2/149","srcLabel":"البخاري","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ لمَّا زوجهُ فاطمةَ بعث معَهُ بخميلَةٍ ووسادةٍ من أَدَمٍ حشوها ليفٌ ورحيينِ وسقاءَ وجرَّتينِ فقال عليٌّ لفاطمةَ رضيَ اللهُ عنهما ذاتَ يومٍ : واللهِ لقد سنوتُ حتى لقد اشتكيتُ صدري قال وقد جاء اللهُ أباكِ بسبيٍّ فاذهبي فاستخدميهِ فقالت : وأنا واللهِ قد طحنتُ حتى مَجَلَتْ يدايَ فأتتِ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ فقال : ما جاء بكِ أي بُنَيَّةِ قالت : جئتُ لأُسَلِّمَ عليكَ واستحيَتْ أن تسألَهُ ورجعت فقال : ما فعلتِ قالت : استحييتُ أن أسألَهُ فأتيناهُ جميعًا فقال عليٌّ رضيَ اللهُ عنهُ : يا رسولَ اللهِ واللهِ لقد سنوتُ حتى اشتكيتُ صدري وقالت فاطمةُ رضيَ اللهُ عنها : قد طحنتُ حتى مَجَلَتْ يدايَ وقد جاءكَ اللهُ بسبيٍّ وسعةٍ فأَخْدِمْنَا فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ : واللهِ لا أُعطيكما وأدعَ أهلَ الصُّفَّةِ تُطْوَى بطونهم لا أجدُ ما أُنفقُ عليهم ولكني أبيعهم وأُنفقُ عليهم أثمانهم فرجعا فأتاهما النبيُّ صلَّى اللهُ عليهِ وسلَّمَ وقد دخلا في قطيفتهما إذا غَطَّتْ رؤسهما تَكَشَّفَتْ أقدامهما وإذا غَطَّيَا أقدامهما تَكَشَّفَتْ رؤوسهما فثارا فقال : مكانكما ثم قال : ",["ألا أُخبركما بخيرٍ مما سألتماني",2]," قالا : بلى فقال : كلماتٍ علَّمنيهِنَّ جبريلُ عليهِ السلامُ فقال : ",["تُسبِّحانِ في دُبُرَ كلِّ صلاةٍ عشرًا وتحمدانِ عشرًا وتُكبِّرانِ عشرًا وإذا آويتُما إلى فراشكما فسبِّحَا ثلاثًا وثلاثين واحمدا ثلاثًا وثلاثين وكبِّرَا أربعًا وثلاثين",1]," قال : فواللهِ ما تركتهُنَّ منذُ علَّمنيهنَّ رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ قال : فقال لهُ ابنُ الكَوَّاءِ ولا ليلةَ صِفِّينَ فقال : قاتلكمُ اللهُ يا أهلَ العراقِ نعم ولا ليلةَ صِفِّينَ"],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني في ((الدعاء)) (230) واللفظ له، والضياء المقدسي في ((المختارة)) (467) باختلاف يسير، والبخاري (3113) بنحوه.","bab":"صلاة › أدعية دبر الصلوات","dorar":"pncYMcf5"},{"id":"س-00770","fp":"35cda8956917","stateId":584,"easy":"إذا لزمت مضجعك فسبّحت وكبّرت وحمدت ← فهو خير لك من الخادم","cause":"إذا لَزِمتِ مَضجَعَكِ، فسَبِّحي اللهَ ثَلاثًا وثلاثينَ، وكَبِّري ثَلاثًا وثلاثينَ، واحمَدي أربَعًا وثلاثينَ","result":"فهو خيرٌ لكِ من الخادِمِ","explicit":true,"apply":{"k":"time","t":"عند النوم"},"repOf":"س-06410","otherNeedIds":[4,16],"ref":"تخريج المسند لشعيب 26551","text":["زَعمَتْ أنَّ فاطمةَ، جاءتْ إلى نبيِّ اللهِ تَشتَكي إليه الخِدمةَ، فقالَت: يا رسولَ اللهِ، واللهِ لقد مَجِلتْ يدايَ من الرَّحى، أطحَنُ مرَّةً، وأعجِنُ مرَّةً، فقالَ لها رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ: إنْ يَرزُقْكِ اللهُ شيئًا يأتِكِ، وسأدُلُّكِ على خيرٍ من ذلكَ؛ ",["إذا لَزِمتِ مَضجَعَكِ، فسَبِّحي اللهَ ثَلاثًا وثلاثينَ، وكَبِّري ثَلاثًا وثلاثينَ، واحمَدي أربَعًا وثلاثينَ",1],"، فذلك مِئةٌ، ",["فهو خيرٌ لكِ من الخادِمِ",2],"، وإذا صَلَّيتِ صَلاةَ الصُّبحِ، فقولي: لا إلهَ إلَّا اللهُ وحدَهُ لا شَريكَ له، له المُلكُ وله الحَمدُ، يُحيي ويُميتُ، بيَدِه الخَيرُ، وهو على كلِّ شيءٍ قديرٌ. عَشْرَ مرَّاتٍ بعدَ صلاةِ الصُّبحِ، وعَشْرَ مرَّاتٍ بعدَ صَلاةِ المَغرِبِ؛ فإنَّ كلَّ واحدةٍ منهنَّ تُكتَبُ عَشْرَ حَسَناتٍ، وتَحُطُّ عَشْرَ سيِّئاتٍ، وكلُّ واحدةٍ منهنَّ كعِتقِ رَقبةٍ مِن وَلدِ إسماعيلَ، ولا يَحِلُّ لذَنبٍ كُسِبَ ذلكَ اليومَ أنْ يُدرِكَه إلَّا أنْ يَكونَ الشِّركُ، لا إلهَ إلَّا اللهُ وحدَهُ لا شريكَ له، وهو حَرَسُكِ، ما بينَ أنْ تَقوليهِ غُدْوةً إلى أنْ تَقوليه عَشيَّةً، من كلِّ شَيطانٍ، ومن كلِّ سُوءٍ."],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"طلب فاطمة رضي الله عنها الخادم، وما دلها عليه صلَّى اللهُ عليهِ وسلَّمَ من الذكر إذا لزمت مضجعها. صحيح لغيره","takhrij":"أخرجه أحمد (26551) واللفظ له، والطبراني (23/339) (787)","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"k3YBql5B","merged":2,"otherRefs":["تخريج المسند لشاكر 2/329 (حسن)"]},{"id":"س-00877","fp":"bf3a7368ba4f","stateId":584,"easy":"إذا سبّحت 33 وحمدت 33 وكبّرت 34 ← فهو خير لك من خادم","cause":"تُسَبِّحينَ ثَلاثًا وثَلاثينَ، وتَحمَدينَ ثَلاثًا وثَلاثينَ، وتُكَبِّرينَ أربَعًا وثَلاثينَ، حينَ تَأخُذينَ مَضجَعَكِ","result":"ألا أدُلُّكِ على ما هو خَيرٌ لَكِ مِن خادِمٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-06410","otherNeedIds":[16],"ref":"صحيح مسلم 2728","text":["أنَّ فاطِمةَ أتَتِ النَّبيَّ صلَّى اللهُ عليه وسلَّم تَسألُه خادِمًا وشَكَتِ العَمَلَ، فقال: ما ألفَيتيه عِندَنا، قال: ",["ألا أدُلُّكِ على ما هو خَيرٌ لَكِ مِن خادِمٍ",2],"؟",[" تُسَبِّحينَ ثَلاثًا وثَلاثينَ، وتَحمَدينَ ثَلاثًا وثَلاثينَ، وتُكَبِّرينَ أربَعًا وثَلاثينَ، حينَ تَأخُذينَ مَضجَعَكِ.",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"أدعية وأذكار › فضل الذكر","dorar":"2H7KXOfG","merged":3,"otherRefs":["صحيح الجامع 2616 (صحيح)","تخريج المسند لشعيب 604 (صحيح)"]},{"id":"س-00796","fp":"e355a11828a1","stateId":584,"easy":"إذا أويت إلى فراشك فسبّحت وكبّرت وهللت ← فهو خير لك من خادم","cause":"إذا أوَيْتِ إلى فراشِك فسبِّحي وكبِّري وهلِّلي","result":"ما هو خيرٌ لكِ مِن ذلكَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"عند النوم"},"repOf":"س-06410","otherNeedIds":[16],"ref":"تخريج صحيح ابن حبان 5529","text":["أنَّ فاطمةَ أتتِ النَّبيَّ صلَّى اللهُ عليه وسلَّم تستخدِمُه فقال صلَّى اللهُ عليه وسلَّم: ( ألا أدُلُّكِ أو أُعلِّمُك ",["ما هو خيرٌ لكِ مِن ذلكَ",2]," ",["إذا أوَيْتِ إلى فراشِك فسبِّحي وكبِّري وهلِّلي",1]," ثلاثًا وثلاثينَ وثلاثًا وثلاثينَ وأربعًا وثلاثينَ ) قال عليٌّ رضي اللهُ عنه: فلم أدَعْها منذُ سمِعْتُها مِن النَّبيِّ صلَّى اللهُ عليه وسلَّم قالوا: ولا ليلةَ صِفِّينَ ؟ قال: ولا ليلةَ صِفِّينَ"],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه ابن حبان (5529) واللفظ له، والبخاري (5362)، والحميدي (43) باختلاف يسير.","bab":"أدعية وأذكار › الذكر عند النوم","dorar":"fqs4BPbR"},{"id":"س-00844","fp":"822ae553ad78","stateId":584,"easy":"إذا سبّحت وكبّرت وحمدت عند النوم مائة ← فهو خير لك من خادم","cause":"تسبِّحين وتكبِّرين وتحمدين اللهَ وإذا أوْيتِ إلى مضجعِك مئةَ مرَّةٍ","result":"ألا أدُلُّك على ما هو خيرٌ لك من ذلك","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"عند النوم"},"repOf":"س-06410","otherNeedIds":[16],"ref":"معجم الشيوخ 2/690","text":["سألتْ النَّبيَّ صلَّى اللهُ عليه وسلَّم فاطمةُ رضِي اللهُ عنها خادمًا قال ",["ألا أدُلُّك على ما هو خيرٌ لك من ذلك",2]," ",["تسبِّحين وتكبِّرين وتحمدين اللهَ وإذا أوْيتِ إلى مضجعِك مئةَ مرَّةٍ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه مسلم (2728)، والترمذي (3841) باختلاف يسير.","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"ykbgUUWN"},{"id":"س-01108","fp":"21d74d87e7d6","stateId":584,"easy":"إذا سبّحت وحمدت وكبّرت عند منامك ← فهو خير لك من خادم","cause":"تُسَبِّحينَ اللهَ عِندَ مَنامِكِ ثَلاثًا وثَلاثينَ، وتَحمَدينَ اللهَ ثَلاثًا وثَلاثينَ، وتُكَبِّرينَ اللهَ أربَعًا وثَلاثينَ","result":"ألا أُخبِرُكِ ما هو خَيرٌ لَكِ منه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-06410","ref":"صحيح البخاري 5362","text":["أنَّ فاطِمةَ عليها السَّلامُ أتَتِ النَّبيَّ صلَّى اللهُ عليه وسلَّم تَسألُه خادِمًا، فقال: ",["ألا أُخبِرُكِ ما هو خَيرٌ لَكِ منه",2],"؟ ",["تُسَبِّحينَ اللهَ عِندَ مَنامِكِ ثَلاثًا وثَلاثينَ، وتَحمَدينَ اللهَ ثَلاثًا وثَلاثينَ، وتُكَبِّرينَ اللهَ أربَعًا وثَلاثينَ",1],"، ثُمَّ قال سُفيانُ: إحداهنَّ أربَعٌ وثَلاثونَ، فما تَرَكتُها بَعدُ، قيلَ: ولا لَيلةَ صِفِّينَ؟ قال: ولا لَيلةَ صِفِّينَ."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"[صحيح]","takhrij":"أخرجه الحميدي (43) واللفظ له، وابن حبان (5529) باختلاف يسير، وأحمد (1229) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"GplOuysh"},{"id":"س-02176","fp":"76be7bfb75c5","stateId":585,"easy":"إذا استحييت ← فالحياء خير كله","cause":"الحياءُ","result":"خيرٌ كلُّهُ","explicit":true,"star":true,"similar":["س-01887","س-05439","س-05959"],"ref":"صحيح الجامع 3196","srcLabel":"متفق عليه","text":[["الحياءُ ",1],["خيرٌ كلُّهُ ",2],"[فَقالَ بُشيرُ بنُ كَعْبٍ: إنَّا لَنَجِدُ في بَعْضِ الكُتُبِ، أوِ الحِكْمَةِ، أنَّ منه سَكِينَةً ووَقارًا لِلَّهِ، ومِنْهُ ضَعْفٌ، قالَ: فَغَضِبَ عِمْرانُ حتَّى احْمَرَّتا عَيْناهُ، وقالَ: ألا أرَى أُحَدِّثُكَ عن رَسولِ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ، وتُعارِضُ فِيهِ، قالَ: فأعادَ عِمْرانُ الحَدِيثَ، قالَ: فأعادَ بُشيرٌ، فَغَضِبَ عِمْرانُ، قالَ: فَما زِلْنا نَقُولُ فِيهِ: إنَّه مِنَّا يا أبا نُجَيْدٍ، إنَّه لا بَأْسَ بهِ.]"],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"صحيح","takhrij":"أخرجه البخاري(6117 )بمعناه، ومسلم(37)واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"3iPA44R7","merged":4,"otherRefs":["تخريج المسند لشعيب 19976 (صحيح)","تخريج المسند لشعيب 19914 (حسن)","تخريج المسند لشعيب 19958 (صحيح)"]},{"id":"س-00339","fp":"101a3b32a5a1","stateId":585,"easy":"إذا رفقت ← فالرفق لم يدخل في شيء إلا زانه","cause":"إنَّ الرِّفْقَ","result":"لم يدخُلْ في شَيءٍ إلَّا زانه","explicit":true,"star":true,"similar":["س-01992","س-00463","س-06331"],"ref":"الأحاديث المختارة 1669","srcLabel":"البخاري","text":["«دخلوا على النَّبيِّ صلَّى اللهُ عليه وسلَّم -يعني اليهودَ- فقالوا: السَّامُ عليك، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: السَّامُ عليكم، فقالت عائِشةُ: بل عليكم السَّامُ ولعْنَتُه وغَضَبُه يا إخوانَ القِرَدةِ والخنازيرِ، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: مَهْ يا عائِشةُ؟ فقالت: أمَّا سَمِعْتَ ما قالوا يا رَسولَ اللهِ؟ قال: وما سَمِعْتِ ما ردَدْتُ عليهم، يا عائِشةُ ",["إنَّ الرِّفْقَ",1]," ",["لم يدخُلْ في شَيءٍ إلَّا زانه",2],"، ولم يُنزَعْ مِن شَيءٍ إلَّا شانه»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"x4PsaH1h","merged":2,"otherRefs":["صحيح مسلم 2594 (صحيح)"]},{"id":"س-01887","fp":"f072d17e3c79","stateId":585,"easy":"إذا استحييت ← فالحياء لا يأتي إلا بخير","cause":"الحَياءُ","result":"لا يَأتي إلَّا بخَيرٍ","explicit":true,"repOf":"س-02176","ref":"صحيح البخاري 6117","text":[["الحَياءُ ",1],["لا يَأتي إلَّا بخَيرٍ",2],". فقال بُشيرُ بنُ كَعبٍ: مَكتوبٌ في الحِكمةِ: إنَّ مِنَ الحَياءِ وقارًا، وإنَّ مِنَ الحَياءِ سَكينةً. فقال له عِمرانُ: أُحَدِّثُك عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم وتُحَدِّثُني عن صَحيفَتِك!"],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6117 )، ومسلم (37)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"zULWpkPt","merged":2,"otherRefs":["الأحاديث المختارة 1483 (صحيح)"]},{"id":"س-05439","fp":"243604e8cee1","stateId":585,"easy":"إذا استحييت ← فالحياء ما كان في شيء إلا زانه","cause":"ولا كان الحياءُ في شَيءٍ","result":"قَطُّ إلَّا زانه","explicit":true,"repOf":"س-02176","otherNeedIds":[41],"ref":"الأحاديث المختارة 1777","text":["«ما كان الفُحْشُ في شيءٍ قَطُّ إلَّا شانه، ",["ولا كان الحياءُ في شَيءٍ",1]," ",["قَطُّ إلَّا زانه",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"رقائق وزهد › الحياء","dorar":"lcy08ruD","merged":2,"otherRefs":["صحيح الأدب المفرد 469 (صحيح)"]},{"id":"س-01992","fp":"fe3b2937aa10","stateId":585,"easy":"إذا اتقيت الله ورفقت ← فالرفق ما كان في شيء إلا زانه","cause":"عليك بتَقْوى اللهِ عزَّ وجلَّ والرِّفقِ","result":"فإنَّ الرِّفقَ لم يَكُ في شَيءٍ قَطُّ إلَّا زانَه، ولم يُنزَعْ مِن شَيءٍ قَطُّ إلَّا شانَه","explicit":true,"repOf":"س-00339","ref":"تخريج المسند لشعيب 24307","text":["قُلتُ لعائشةَ: هل كان النَّبيُّ صلَّى اللهُ عليه وسلَّم يَبْدو؟ قالت: نَعَمْ، كان يَبْدو إلى هذه التِّلاعِ، فأرادَ البَداوةَ مَرَّةً، فأرسَلَ إلى نَعَمٍ من إبِلِ الصَّدَقةِ، فأعْطاني منها ناقةً مُحرَّمةً، ثم قال: يا عائشةُ، ",["عليك بتَقْوى اللهِ عزَّ وجلَّ والرِّفقِ؛ ",1],["فإنَّ الرِّفقَ لم يَكُ في شَيءٍ قَطُّ إلَّا زانَه، ولم يُنزَعْ مِن شَيءٍ قَطُّ إلَّا شانَه",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2594) مختصراً باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"8uW7wWc4","merged":2,"otherRefs":["تخريج المسند لشعيب 25863 (صحيح)"]},{"id":"س-00463","fp":"27c6b1ec9c24","stateId":585,"easy":"إذا رفقت ← فالرفق ما كان في شيء إلا زانه ولا نُزع من شيء إلا شانه","cause":"ارفُقي","result":"فإنَّ الرِّفقَ لم يَكُن في شَيءٍ قطُّ إلَّا زانَهُ، ولا نَزعَ مِن شيءٍ قطُّ، إلَّا شانَهُ","explicit":true,"repOf":"س-00339","ref":"صحيح أبي داود 2478","text":["عن شريح بن هانئ قال: سألت عائشةَ، عن البَدَاوة، فقالت: كانَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ يَبدو إلى هذِهِ التِّلاعِ، وإنَّهُ أرادَ البَداوةَ مرَّةً، فأرسلَ إليَّ ناقةً مُحرَّمةً مِن إبلِ الصَّدَقةِ، فقالَ لي: يا عائشَةُ، ",["ارفُقي ",1],["فإنَّ الرِّفقَ لم يَكُن في شَيءٍ قطُّ إلَّا زانَهُ، ولا نَزعَ مِن شيءٍ قطُّ، إلَّا شانَهُ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح دون جملة التلاع","takhrij":"أخرجه أبو داود (2478)، وابن حبان (550)، واللفظ لهما، وأصله في مسلم بدون القصة (2594)","bab":"آداب عامة › الرفق بالحيوان والطير ونحوهما","dorar":"UqJ0OQKd"},{"id":"س-06331","fp":"6854ecd91300","stateId":585,"easy":"إذا رفقت ← فالرفق لا يخالط شيئاً إلا زانه","cause":"ارفُقي به","result":"فإنَّ الرِّفقَ لا يُخالِطُ شيئًا إلَّا زانَه، ولا يُفارِقُ شيئًا إلَّا شانَه","explicit":true,"repOf":"س-00339","ref":"تخريج المسند لشعيب 24808","text":["خرَجَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ إلى الباديةِ إلى إبلِ الصَّدَقةِ، فأَعْطى نساءَه بَعيرًا بَعيرًا غَيْري، فقُلْتُ: يا رسولَ اللهِ، أَعطَيتَهُنَّ بَعيرًا بَعيرًا غَيْري، فأَعْطاني بَعيرًا آدَمًا صَعْبًا، لم يُركَبْ عليه، فقال: يا عائشةُ، ",["ارفُقي به، ",1],["فإنَّ الرِّفقَ لا يُخالِطُ شيئًا إلَّا زانَه، ولا يُفارِقُ شيئًا إلَّا شانَه",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أبو داود (2478) باختلاف يسير، وأخرجه مسلم (2594) مختصراً باختلاف يسير","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"DbvO58hy"},{"id":"س-02280","fp":"14a88480d03d","stateId":585,"easy":"إذا أُعطيت حظك من الرفق ← فقد أُعطيت حظك من خير الدنيا والآخرة","cause":"مَن أُعطيَ حظَّه منَ الرفْقِ","result":"فقد أُعطِيَ حظَّه من خَيرِ الدُّنيا والآخِرةِ","explicit":true,"star":true,"ref":"تخريج شرح السنة 13/ 74","srcLabel":"أحمد","text":["عن عائشةَ أنَّ النَّبِيَّ صلَّى اللهُ عليه وسلَّمَ قال لها: إنَّه ",["مَن أُعطيَ حظَّه منَ الرفْقِ، ",1],["فقد أُعطِيَ حظَّه من خَيرِ الدُّنيا والآخِرةِ",2],"، وصِلةُ الرحِمِ وحُسنُ الخُلُقِ، وحُسنُ الجِوارِ يَعمُرانِ الديارَ ويَزيدانِ في الأعمارِ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (25259) واللفظ له، وأبو يعلى (4530)، والبيهقي في ((معرفة السنن والآثار)) (20826) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"5RQPo3mB","merged":3,"otherRefs":["صحيح الجامع 6055 (صحيح)","تخريج المسند لشعيب 27553 (صحيح)"]},{"id":"س-05959","fp":"340c5012f8ac","stateId":585,"easy":"إذا استحييت ← فلا يأتيك من الحياء إلا خير","cause":"الحياءِ","result":"لا يَأْتيكَ مِنَ الحياءِ إلَّا خَيرٌ","explicit":true,"repOf":"س-02176","ref":"تخريج سير أعلام النبلاء 14/ 503","text":[["لا يَأْتيكَ مِنَ الحياءِ إلَّا خَيرٌ",2],"."],"grade":"حسن","narrator":"أسير [رجل من أصحاب النبي صلى الله عليه وسلم]","muhaddith":"رجاله ثقات","takhrij":"أخرجه الذهبي في ((السير)) (11/ 307)، وابن سعد في ((طبقاته)) (2925)، والبغوي في ((معجم الصحابة)) (135)، وابن قانع في ((معجم الصحابة)) (1/ 55) واللفظ لهم مطولا.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"XXeNvgTX"},{"id":"س-00227","fp":"bb872de6e1e4","stateId":585,"easy":"إذا لم تغضب ← فهو خير لك","cause":"لا تغضَبْ","result":"علِّمني شيئًا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح الترمذي 2020","srcLabel":"البخاري","text":["جاءَ رجلٌ إلى النَّبيِّ صلَّى اللَّهُ عليْهِ وسلَّم، قال: ",["علِّمني شيئًا",2]," ولا تُكثِرْ عليَّ لعلِّي أعيهِ، قال: ",["لا تغضَبْ",1],"، فردَّدَ ذلِكَ مرارًا كلُّ ذلِكَ يقول: لا تغضَبْ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6116)، والترمذي (2020) واللفظ له، وأحمد (10012)","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"aTJnKJwr"},{"id":"س-07225","fp":"a8af7e31a975","stateId":585,"easy":"إذا لم تغضب ← تعقل وصية جامعة","cause":"لا تَغضَبْ","result":"مُرْني بأمرٍ، ولا تُكثِرْ علَيَّ حتى أَعقِلَه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"تخريج المسند لشعيب 8744","srcLabel":"البخاري","text":["أَتَى النَّبيُّ صلَّى اللهُ عليه وسلَّمَ رجُلٌ، فقالَ: ",["مُرْني بأمرٍ، ولا تُكثِرْ علَيَّ حتى أَعقِلَه",2],"، قال: ",["لا تَغضَبْ",1],"، فأعادَ عليه: لا تَغضَبْ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6116)، والترمذي (2020)، وأحمد (8744) واللفظ له","bab":"علم › حسن السؤال ونصح العالم","dorar":"1DssOret"},{"id":"س-07178","fp":"3838c1eeb257","stateId":585,"easy":"إذا حسن خلقك ← فهو أفضل ما أُعطي المسلم","cause":"حُسنُ الخُلقِ","result":"ما أفضلُ ما أُعطِيَ المرءُ المسلمُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[41],"ref":"تخريج صحيح ابن حبان 478","srcLabel":"مسلم","text":["قالوا: يا رسولَ اللهِ ",["ما أفضلُ ما أُعطِيَ المرءُ المسلمُ",2]," ؟ قال: ( ",["حُسنُ الخُلقِ",1]," )"],"grade":"صحيح","narrator":"أسامة بن شريك","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن حبان (478)، ووكيع في ((الزهد)) (423)، وهناد في ((الزهد)) (2/ 595) بلفظه.","bab":"علم › حسن السؤال ونصح العالم","dorar":"chx6oT6R","merged":2,"otherRefs":["الصحيح المسند 1/43 (صحيح)"]},{"id":"س-05067","fp":"703134b94421","stateId":585,"easy":"إذا رُزقت خلقاً حسناً ← فهو خير ما أُعطي العبد","cause":"خلقٌ حسنٌ","result":"ما خيرُ ما أُعْطيَ العبدُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[41,47],"ref":"مصباح الزجاجة 4/49","srcLabel":"أبو داود","text":["شَهِدْتُ الأعرابَ يَسألونَ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ: أعلَينا حرجٌ في كذا ؟ أعلَينا حرجٌ في كذا ؟ فقالَ لَهُم: عبادَ اللَّهِ، وضعَ اللَّهُ الحرجَ، إلَّا منِ اقترضَ، من عِرضِ أخيهِ شيئًا، فذاكَ الَّذي حَرِجَ فقالوا يا رسولَ اللَّهِ: هل علينا جُناحٌ أن لا نتَداوى ؟ قالَ: تَداووا عبادَ اللَّهِ، فإنَّ اللَّهَ، سُبحانَهُ، لم يضع داءً، إلَّا وضعَ معَهُ شفاءً، إلَّا الهرَمَ، قالوا: يا رسولَ اللَّهِ ",["ما خيرُ ما أُعْطيَ العبدُ",2]," قالَ: ",["خلقٌ حسنٌ",1]],"grade":"صحيح","narrator":"أسامة بن شريك","muhaddith":"إسناده صحيح رجاله ثقات","takhrij":"أخرجه ابن ماجه (3436) واللفظ له، وأخرجه أبو داود (2015) مختصراً بنحوه، والترمذي (2038) مختصراً باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"WIt3b0XB","merged":6,"otherRefs":["شرح السنة 6/243 (حسن)","تخريج الإحياء للعراقي 2/196 (صحيح)","هداية الرواة 5008 (صحيح)","تخريج صحيح ابن حبان 6061 (صحيح)","تخريج مشكل الآثار 4424 (صحيح)"]},{"id":"س-07117","fp":"5a00337a2bfc","stateId":585,"easy":"إذا لم تغضب ← ينفعك ذلك","cause":"لا تَغضَبْ","result":"قُلْ لي قَولًا يَنفَعُني","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"تخريج المسند لشعيب 20359","srcLabel":"أحمد","text":["عن الأحنَفِ بنِ قَيسٍ، عن جاريةَ بنِ قُدامةَ، قال: وحَدَّثَني عَمٌّ لي أنَّه أتى رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: يا رَسولَ اللهِ، عَلِّمْني شَيئًا يَنفَعُني وأقلِلْ، فذَكَرَ الحَديثَ [يَعني حَديثَ: عن جاريةَ بنِ قُدامةَ السَّعديِّ، أنَّه سَألَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: يا رَسولَ اللهِ، ",["قُلْ لي قَولًا يَنفَعُني",2],"، وأقلِلْ عليَّ لَعَلِّي أعيه؟ فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["لا تَغضَبْ",1],"، فأعادَ عليه حَتَّى أعادَ عليه مِرارًا، كُلَّ ذلك يَقولُ: لا تَغضَبْ]"],"grade":"صحيح","narrator":"جارية بن قدامة","muhaddith":"إسناده صحيح","bab":"علم › تعليم الناس وفضل ذلك","dorar":"lTga6yHu","merged":8,"otherRefs":["التمهيد 7/246 (صحيح)","شعب الإيمان 6/2805 (صحيح)","المطالب العالية 3/147 (حسن)","تخريج المسند لشعيب 23137 (صحيح)","الصحيح المسند 256 (صحيح)","مجمع الزوائد 8/73 (حسن)","تخريج المسند لشعيب 23163 (صحيح)"]},{"id":"س-07176","fp":"2a00fa38dcbd","stateId":585,"easy":"إذا اجتنبت الغضب ← تعيش به","cause":"اجتنِبِ الغضَبَ","result":"بكلامٍ أعيشُ به","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"إتحاف الخيرة المهرة 7/375","srcLabel":"أحمد","text":["أنَّ رجلًا أتى النبيَّ صلَّى اللهُ عليه وسلَّم فقال:  أخبِرْني ",["بكلامٍ أعيشُ به",2]," ولا  تُكثِرْ عليَّ فأنْسَى قال:  ",["اجتنِبِ الغضَبَ",1]," ثلاثًا قال:  فأعادَ عليه فقال:  اجتنِبِ الغضَبَ ثلاثًا"],"grade":"صحيح","narrator":"رجل من الصحابة","muhaddith":"سنده صحيح","takhrij":"أخرجه أحمد (23468)، وابن أبي شيبة في ((المسند)) (972)[235]، وإسماعيل الأصبهاني في ((الترغيب والترهيب)) (2364) واللفظ لهم جميعا.","bab":"علم › حسن السؤال ونصح العالم","dorar":"SxAV2qS1"},{"id":"س-06037","fp":"8447684c6c66","stateId":586,"easy":"إذا أصابك ما تكره فصبرت ← كان لك خير","cause":"أصابَهُ ما يَكْرَهُ فصبرَ","result":"كانَ لَهُ خيرٌ","explicit":true,"star":true,"otherNeedIds":[9],"ref":"السلسلة الصحيحة 147","srcLabel":"مسلم","text":["عَجِبْتُ لأمرِ المؤمنِ ، إنَّ أمرَهُ كُلَّهُ خيرٌ ، إن أصابَهُ ما يحبُّ حمدَ اللَّهَ وَكانَ لَهُ خيرٌ ، وإن ",["أصابَهُ ما يَكْرَهُ فصبرَ",1]," ",["كانَ لَهُ خيرٌ",2]," ، وليسَ كلُّ أحدٍ أمرُهُ كلُّهُ خيرٌ إلَّا المؤمنُ"],"grade":"صحيح","narrator":"صهيب بن سنان الرومي","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (23930) مطولاً باختلاف يسير، وأخرجه مسلم (2999) بنحوه","bab":"رقائق وزهد › فضل الصبر","dorar":"ryF9KldZ","merged":3,"otherRefs":["تخريج صحيح ابن حبان 2896 (صحيح)","صحيح مسلم 2999 (صحيح)"]},{"id":"س-06015","fp":"6b7ea7dad99f","stateId":586,"easy":"إذا صبرت على ما تكره ← ففيه خير كثير","cause":"الصَّبْرَ على ما تَكرَهُ","result":"خَيْرٌ كَثيرٌ","explicit":true,"star":true,"otherNeedIds":[16],"ref":"الأحاديث المختارة 10 / 24","srcLabel":"متفق عليه","text":["«كُنْتُ رَديفَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: يا غُلامُ، أو يا بُنَيَّ، أَلَا أُعَلِّمُك كَلِماتٍ يَنفَعُك اللهُ بِهنَّ؟ فقُلْتُ: بَلى، فقالَ: احْفَظِ اللهَ يَحفَظْك، احْفَظِ اللهَ تَجِدْه أمامَك، تَعرَّفْ إليه في الرَّخاءِ يَعرِفْك في الشِّدَّةِ، إذا سَألْتَ فاسْأَلِ اللهَ، وإذا اسْتَعَنْتَ فاسْتَعِنْ باللهِ، قد جَفَّ القَلَمُ بما هو كائِنٌ، فلو أنَّ الخَلْقَ كلَّهم جَميعًا أرادوا أن يَنفَعوك بشيءٍ لم يَقْضِه اللهُ لك لم يَقدِروا عليه، وإن أرادوا أن يَضُرُّوك بشيءٍ لم يَقْضِه اللهُ عليك لم يَقدِروا عليه، اعْمَلْ للهِ بالشُّكْرِ واليَقينِ، واعْلَمْ أنَّ ",["الصَّبْرَ على ما تَكرَهُ",1]," ",["خَيْرٌ كَثيرٌ",2],"، وأنَّ النَّصْرَ معَ الصَّبْرِ، وأنَّ الفَرَجَ معَ الكَرْبِ، وأنَّ معَ العُسْرِ يُسْرًا»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › تقوى الله","dorar":"Zz7qGbDv"},{"id":"س-06036","fp":"10ae417d885e","stateId":586,"easy":"إذا أصابك ما تحب فحمدت الله ← كان لك خير","cause":"أصابَهُ ما يحبُّ حمدَ اللَّهَ","result":"وَكانَ لَهُ خيرٌ","explicit":true,"otherNeedIds":[5],"ref":"السلسلة الصحيحة 147","srcLabel":"مسلم","text":["عَجِبْتُ لأمرِ المؤمنِ ، إنَّ أمرَهُ كُلَّهُ خيرٌ ، إن ",["أصابَهُ ما يحبُّ حمدَ اللَّهَ",1]," ",["وَكانَ لَهُ خيرٌ",2]," ، وإن أصابَهُ ما يَكْرَهُ فصبرَ كانَ لَهُ خيرٌ ، وليسَ كلُّ أحدٍ أمرُهُ كلُّهُ خيرٌ إلَّا المؤمنُ"],"grade":"صحيح","narrator":"صهيب بن سنان الرومي","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (23930) مطولاً باختلاف يسير، وأخرجه مسلم (2999) بنحوه","bab":"رقائق وزهد › فضل الصبر","dorar":"ryF9KldZ","merged":2,"otherRefs":["صحيح مسلم 2999 (صحيح)"]},{"id":"س-00810","fp":"a12f0bb05b54","stateId":586,"easy":"إذا أصابتك سراء فشكرت أو ضراء فصبرت ← فأمرك كله خير","cause":"إنْ أصابَتْه سرَّاءُ شكَر","result":"عجبًا لأمرِ المؤمنِ إنَّ أمرَه كلَّه خيرٌ","explicit":true,"otherNeedIds":[5],"ref":"تخريج صحيح ابن حبان 2896","srcLabel":"مسلم","text":[["عجبًا لأمرِ المؤمنِ إنَّ أمرَه كلَّه خيرٌ",2]," ",["إنْ أصابَتْه سرَّاءُ شكَر",1]," وإنْ أصابَتْه ضرَّاءُ صبَر وكان خيرًا له وليس ذلك لأحدٍ إلَّا للمؤمنِ"],"grade":"صحيح","narrator":"صهيب","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2999) باختلاف يسير","bab":"أدعية وأذكار › حمد الله في كل الأحوال","dorar":"vmDXlnFN"},{"id":"ق-0690","fp":"b9b43535f766","stateId":586,"easy":"الصبر وترك المعاقبة ← خير للصابرين","cause":"الصبر وترك المعاقبة","result":"خير للصابرين","explicit":true,"ref":"سورة النحل: 126","srcLabel":"القرآن الكريم","quran":{"s":16,"from":126,"to":126,"text":"وَإِنْ عَاقَبْتُمْ فَعَاقِبُوا بِمِثْلِ مَا عُوقِبْتُمْ بِهِ وَلَئِنْ صَبَرْتُمْ لَهُوَ خَيْرٌ لِلصَّابِرِينَ (126)","hl":[[61,109,1]]}},{"id":"س-07732","fp":"89025f290e95","stateId":586,"easy":"إذا نزل بك أمر تكرهه ← يجعل الله لك وللمسلمين فيه خيراً","cause":"فأنزَلَ اللهُ آيةَ التَّيَمُّمِ","result":"ما نَزَلَ بكِ أمرٌ تَكرَهينَه، إلَّا جَعَلَ اللهُ ذلك لَكِ وللمُسلِمينَ فيه خَيرًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[5],"ref":"صحيح البخاري 336","srcLabel":"متفق عليه","text":["أنَّها استَعارَت مِن أسماءَ قِلادةً فهَلَكَت، فبَعَثَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم رَجُلًا فوجَدَها، فأدرَكَتهُمُ الصَّلاةُ وليسَ معهُم ماءٌ، فصَلَّوا، فشَكَوا ذلك إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، ",["فأنزَلَ اللهُ آيةَ التَّيَمُّمِ",1],"، فقال أُسَيدُ بنُ حُضَيرٍ لعائِشةَ: جَزاكِ اللهُ خَيرًا، فواللهِ ",["ما نَزَلَ بكِ أمرٌ تَكرَهينَه، إلَّا جَعَلَ اللهُ ذلك لَكِ وللمُسلِمينَ فيه خَيرًا",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (336)، ومسلم (367)","bab":"قرآن › أسباب النزول","dorar":"M80so7Ox","merged":2,"otherRefs":["صحيح أبي داود 317 (صحيح)"]},{"id":"س-07706","fp":"e30a28a53c63","stateId":586,"easy":"إذا ابتُليت بأمر تكرهه ← قد يجعل الله فيه بركة ويسراً (من قصة عائشة)","cause":"إنَّكِ لَمُبارَكةٌ","result":"ماذا جعَلَ اللهُ للمُسلِمينَ في حَبسِكِ إيَّاهم مِن البَرَكةِ واليُسرِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 26341","srcLabel":"أحمد","text":["أقْبَلْنا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في بَعضِ أسْفارِه حتى إذا كنَّا بِتُرْبانَ، بَلَدٍ بَينَه وبَينَ المَدينةِ بَريدٌ وأمْيالٌ، وهو بَلَدٌ لا ماءَ به، وذلك مِن السَّحَرِ، انْسَلَّتْ قِلادةٌ لي مِن عُنُقي، فوَقَعَتْ؛ فحُبِسَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ لِالتِماسِها حتى طَلَعَ الفَجرُ، وليس مع القومِ ماءٌ، قالَتْ: فلَقيتُ مِن أبي ما اللهُ به عَليمٌ مِن التَّعنيفِ والتَّأفيفِ، وقال: في كلِّ سَفَرٍ للمُسلِمينَ منكِ عَناءٌ وبَلاءٌ؟ قالَتْ: فأنزَلَ اللهُ الرُّخصةَ بالتَّيَمُّمِ، قالَتْ: فتَيَمَّمَ القومُ وصَلَّوْا، قالَتْ: يقولُ أبي حينَ جاءَ مِن اللهِ ما جاءَ مِن الرُّخْصةِ للمُسلِمينَ: واللهِ، ما عَلِمتُ يا بُنَيَّةُ، ",["إنَّكِ لَمُبارَكةٌ",1],"، ",["ماذا جعَلَ اللهُ للمُسلِمينَ في حَبسِكِ إيَّاهم مِن البَرَكةِ واليُسرِ",2],"؟"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه أحمد (26341) واللفظ له، والطبراني (23/121) (159) بنحوه","bab":"قرآن › أسباب النزول","dorar":"DujgeVFP"},{"id":"س-00962","fp":"6b0f544951d4","stateId":587,"easy":"إذا اتخذت لساناً ذاكراً وقلباً شاكراً وزوجة مؤمنة ← فهو خير المال","cause":"أفضَلُه لِسانًا ذاكرًا، وقَلبًا شاكرًا، وزَوجةً مُؤمنةً تُعينُه على إيمانِه","result":"أيُّ المالِ خيرٌ اتَّخَذْناه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"تخريج المسند لشعيب 22392","srcLabel":"الترمذي","text":["لمَّا أُنزِلَتْ {الَّذِينَ يَكْنِزُونَ الذَّهَبَ وَالْفِضَّةَ وَلَا يُنْفِقُونَهَا فِي سَبِيلِ اللَّهِ} [التوبة: 34]، قال: كنَّا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في بعضِ أسفارِه، فقال بعضُ أصحابِه: قد نَزَلَ في الذَّهبِ والفِضَّةِ ما نَزَلَ، فلو أنَّا عَلِمْنا ",["أيُّ المالِ خيرٌ اتَّخَذْناه،",2]," فقال: ",["أفضَلُه لِسانًا ذاكرًا، وقَلبًا شاكرًا، وزَوجةً مُؤمنةً تُعينُه على إيمانِه.",1]],"grade":"حسن","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"حسن لغيره","takhrij":"أخرجه الترمذي (3094) باختلاف يسير، وابن ماجه (1856)، وأحمد (22392) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"PPZMyoo5"},{"id":"س-05687","fp":"7c8357376ba0","stateId":587,"easy":"إذا أُعطيت قلباً شاكراً ولساناً ذاكراً وبدناً صابراً وزوجة أمينة ← فقد أُعطيت خير الدنيا والآخرة","cause":"قَلْبًا شاكِرًا، ولِسانًا ذاكِرًا، وبَدَنًا على البَلاءِ صابِرًا، وزَوْجةً لا تَبْغيه خَوْنًا في نَفْسِها ولا مالِه","result":"أرْبَعٌ مَن أُعْطِيَهنَّ فقدْ أُعْطِيَ خَيْرَ الدُّنْيا والآخِرةِ","explicit":true,"star":true,"ref":"الأحاديث المختارة 11 / 70","srcLabel":"متفق عليه","text":["«",["أرْبَعٌ مَن أُعْطِيَهنَّ فقدْ أُعْطِيَ خَيْرَ الدُّنْيا والآخِرةِ",2],":",[" قَلْبًا شاكِرًا، ولِسانًا ذاكِرًا، وبَدَنًا على البَلاءِ صابِرًا، وزَوْجةً لا تَبْغيه خَوْنًا في نَفْسِها ولا مالِه».",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الصبر على البلاء","dorar":"knJWu7zm"},{"id":"س-00945","fp":"59556e1c9ede","stateId":587,"easy":"إذا اكتنز الناس الذهب فقل «اللهم إني أسألك الثبات في الأمر...» ← فهو خير الكنوز","cause":"اللَّهمَّ إنِّي أسأَلُكَ الثَّباتَ في الأمرِ والعزيمةَ على الرُّشدِ وأسأَلُكَ شُكرَ نعمتِكَ وحُسنَ عبادتِكَ وأسأَلُكَ مِن خيرِ ما تعلَمُ وأستغفِرُكَ لِما تعلَمُ إنَّكَ أنتَ علَّامُ الغيوبِ","result":"إذا اكتَنَز النَّاسُ الدَّنانيرَ والدَّراهمَ فاكتَنِزوا هؤلاءِ الكلماتِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«اللَّهمَّ إنِّي أسأَلُكَ الثَّباتَ في الأمرِ والعزيمةَ على الرُّشدِ وأسأَلُكَ شُكرَ نعمتِكَ وحُسنَ عبادتِكَ وأسأَلُكَ مِن خيرِ ما تعلَمُ وأستغفِرُكَ لِما تعلَمُ إنَّكَ أنتَ علَّامُ الغيوبِ»"},"ref":"صحيح ابن حبان 935","srcLabel":"الترمذي","text":["خرَجْتُ مع شدَّادِ بنِ أوسٍ فنزَلْنا مَرْجَ الصُّفَّرِ فقال : ائتوني بالسُّفرةِ نعبَثْ بها فكان القومُ يحفَظونَها منه فقال : يا بَني أخي لا تحفَظوها عنِّي ولكنِ احفَظوا منِّي ما سمِعْتُ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم : ( ",["إذا اكتَنَز النَّاسُ الدَّنانيرَ والدَّراهمَ فاكتَنِزوا هؤلاءِ الكلماتِ",2]," : ",["اللَّهمَّ إنِّي أسأَلُكَ الثَّباتَ في الأمرِ والعزيمةَ على الرُّشدِ وأسأَلُكَ شُكرَ نعمتِكَ وحُسنَ عبادتِكَ وأسأَلُكَ مِن خيرِ ما تعلَمُ وأستغفِرُكَ لِما تعلَمُ إنَّكَ أنتَ علَّامُ الغيوبِ",1]," )"],"grade":"صحيح","narrator":"شداد بن أوس","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو نعيم في ((الحلية)) (1/ 266)، وابن عساكر في ((تاريخ دمشق)) (14586) واللفظ لهما، والترمذي (3407)، وأحمد (17114) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"gSL3KpRv"},{"id":"س-00779","fp":"5230852d4759","stateId":587,"easy":"إذا اتخذت لساناً ذاكراً وقلباً صادقاً وجسداً صابراً ← فهو خير ما تكنز","cause":"لسانًا ذاكرًا، وقلبًا صادقًا، وجسدًا على البَلاءِ صابرًا","result":"فماذا نَكنِزُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[47],"ref":"فضيلة ذكر الله 29","srcLabel":"فضيلة ذكر الله","text":["لمَّا نَزَلت {وَالَّذِينَ يَكْنِزُونَ الذَّهَبَ وَالْفِضَّةَ ...} الآية. قال أصحابُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم: ما للكَنزِ اليَومَ؟ قال: فقال رَجُلٌ مِنَ القَومِ: يا رَسولَ اللهِ، نَزَل اليَومَ في الكَنزِ ما نَزَل، ",["فماذا نَكنِزُ",2],"؟ قال: ",["لسانًا ذاكرًا، وقلبًا صادقًا، وجسدًا على البَلاءِ صابرًا",1]],"grade":"حسن","narrator":"بريدة","muhaddith":"حسن غريب.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"Aco9XMGa"},{"id":"س-05575","fp":"6be193c64955","stateId":587,"easy":"إذا اتخذت لساناً ذاكراً وقلباً شاكراً وزوجة تعين على الآخرة ← فهو خير من الذهب والفضة","cause":"لِسانًا ذاكِرًا، وقَلْبًا شاكِرًا، وزَوْجةً تُعينُ على الآخِرةِ","result":"قَولُك: تَبًّا للذَّهَبِ والفِضَّةِ، ماذا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[1],"ref":"صحيح الجامع 2907","srcLabel":"صحيح الجامع","text":["تبًّا للذهبِ والفضةِ [ يعني حديث: سَمِعتُ عبدَ اللهِ بنَ أبي الهُذَيلِ قال: حَدَّثَني صاحِبٌ لي، أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال: تَبًّا للذَّهَبِ والفِضَّةِ، قال: فحَدَّثَني صاحِبي أنَّه انطَلَقَ مع عُمَرَ بنِ الخَطَّابِ فقال: يا رسولَ اللهِ، ",["قَولُك: تَبًّا للذَّهَبِ والفِضَّةِ، ماذا",2],"؟ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["لِسانًا ذاكِرًا، وقَلْبًا شاكِرًا، وزَوْجةً تُعينُ على الآخِرةِ",1],".]"],"grade":"حسن","narrator":"رجل وعمر بن الخطاب","muhaddith":"حسن","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"gjLvdLgq"},{"id":"س-07235","fp":"5b7d71b982a1","stateId":588,"easy":"إذا منحت أخاك أرضك ← فهو خير لك من أن تأخذ عليها أجراً","cause":"لَأَن يمنحَ أحدُكم أخاهُ","result":"خيرٌ لهُ من أن يأخذَ عليها أجرًا معلومًا","explicit":true,"star":true,"ref":"صحيح ابن ماجه 2010","srcLabel":"متفق عليه","text":["عن عمرو بن دينار، قال: قلتُ لطاوسٍ يا أبا عبدِ الرَّحمنِ لو تركتَ هذهِ المخابرةَ فإنَّهم يزعمونَ أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ نهى عنهُ فقالَ أي عمرو إنِّي أُعينُهم وأعطيهم وإنَّ معاذَ بنَ جبلٍ أخذَ النَّاسَ عليها عندنا وإنَّ أعلمَهم يعني ابنَ عبَّاسٍ أخبرني أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ لم ينهَ عنها ولكن قالَ ",["لَأَن يمنحَ أحدُكم أخاهُ",1]," ",["خيرٌ لهُ من أن يأخذَ عليها أجرًا معلومًا",2]],"grade":"صحيح","narrator":"عبد الله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (2462) بلفظه، والبخاري (2330)، ومسلم (1550) باختلاف يسير دون قوله: ((وإن معاذ بن جبل أخذ الناس عليها عندنا)) .","bab":"علم › سؤال العالم عما لا يعلم","dorar":"GSQmqAGv","merged":3,"otherRefs":["صحيح البخاري 2330 (صحيح)","المحلى 8/220 (صحيح)"]},{"id":"س-01809","fp":"e6e1023f64b0","stateId":588,"easy":"إذا احتطبت حزمة على ظهرك فبعتها ← فهو خير لك من سؤال الناس","cause":"لَأن يحتَزِمَ أحدُكم حزمةَ حطبٍ على ظَهرِهِ فيبيعَها","result":"خيرٌ من أن يسألَ رجلًا فيُعطيَهُ أو يمنعَهُ","explicit":true,"star":true,"similar":["س-01814"],"ref":"صحيح النسائي 2583","srcLabel":"متفق عليه","text":[["لَأن يحتَزِمَ أحدُكم حزمةَ حطبٍ على ظَهرِهِ فيبيعَها ",1],["خيرٌ من أن يسألَ رجلًا فيُعطيَهُ أو يمنعَهُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (2074)، ومسلم (1042)، والترمذي (680)، والنسائي (2584) واللفظ له، وأحمد (9868)","bab":"إجارة › كسب الرجل وعمله بيده","dorar":"t5umsnyK"},{"id":"س-01814","fp":"c0311d1c3a80","stateId":588,"easy":"إذا احتطبت على ظهرك ← فهو خير لك من أن تسأل أحداً","cause":"لَأن يَحتَطِبَ أحَدُكُم حُزمةً على ظَهرِه","result":"خَيرٌ له مِن أن يَسألَ أحَدًا","explicit":true,"repOf":"س-01809","ref":"صحيح البخاري 2074","text":[["لَأن يَحتَطِبَ أحَدُكُم حُزمةً على ظَهرِه ",1],["خَيرٌ له مِن أن يَسألَ أحَدًا",2],"، فيُعطيَه أو يَمنَعَه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2074)، ومسلم (1042)","bab":"إجارة › كسب الرجل وعمله بيده","dorar":"OqNuslLM"},{"id":"س-06404","fp":"4c44f10a7948","stateId":588,"easy":"إذا تركت أهلك بخير ← فهو خير لك من أن تتركهم عالة على الناس","cause":"أحدُكُم يدَعُ أَهْلَهُ بِخيرٍ","result":"خيرٌ لَهُ من أن يدعَهُم عالةً علَى أيدي النَّاسِ","explicit":true,"star":true,"otherNeedIds":[37],"ref":"تخريج المسند لشاكر 3/94","srcLabel":"متفق عليه","text":["قُلتُ : يا رسولَ اللَّهِ أوصي بمالي كلِّهِ قالَ : لا قُلتُ : فثلُثَيْهِ ؟ قالَ : لا قُلتُ : فنصفَهُ ؟ قالَ : لا . قلتُ : فالثُّلثَ ؟ قالَ : الثُّلثَ والثُّلثُ كبيرٌ ",["أحدُكُم يدَعُ أَهْلَهُ بِخيرٍ",1]," ",["خيرٌ لَهُ من أن يدعَهُم عالةً علَى أيدي النَّاسِ",2]],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (1599) بلفظه، والبخاري (1295)، ومسلم (1628) باختلاف يسير.","bab":"صدقة › كراهة التصدق بكل المال","dorar":"IdYm8xCY"},{"id":"س-07071","fp":"21ba8f24af91","stateId":588,"easy":"إذا ربّيت الفرع من غنمك حتى يستحمل ثم ذبحته ← فهو خير","cause":"في كُلِّ سائِمةٍ مِنَ الغَنَمِ فَرَعٌ، تَغُذوهُ غَنَمُكَ، حتى إذا استَحمَلَ ذَبَحتَهُ، فتَصَدَّقتَ بِلَحمِهِ على ابنِ السَّبيلِ","result":"فإنَّ ذلك هو خَيرٌ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 20729","srcLabel":"مسلم","text":["إنِّي كنتُ نَهيتُكم عن لُحومِ الأضاحِيِّ فَوقَ ثَلاثٍ؛ كيما تَسَعَكم، فقد جاءَ اللهُ بِالخَيرِ، فكُلوا، وادَّخِروا، واتَّجِروا، وإنَّ هذه الأيَّامَ أيَّامُ أكْلٍ، وَشُرْبٍ، وذِكرٍ للهِ. فقالَ رَجُلٌ: يا رَسولَ اللهِ، إنَّا كُنَّا نَعتِرُ عَتيرةً في الجاهليَّةِ في رَجَبٍ، فما تَأمُرُنا؟ فقالَ: اذبَحوا للهِ في أيِّ شَهرٍ ما كانَ، وَبَرُّوا اللهَ، وَأطْعِموا. فقالَ رَجُلٌ آخَرُ: يا رَسولَ اللهِ، إنَّا كُنَّا نُفَرِّعُ فَرَعًا في الجاهليَّةِ، فما تَأمُرُنا؟ قالَ: فقالَ رَسولُ اللهِ صلَّى اللهُ عليهِ وسَلَّمَ: ",["في كُلِّ سائِمةٍ مِنَ الغَنَمِ فَرَعٌ، تَغُذوهُ غَنَمُكَ، حتى إذا استَحمَلَ ذَبَحتَهُ، فتَصَدَّقتَ بِلَحمِهِ على ابنِ السَّبيلِ",1],"؛ ",["فإنَّ ذلك هو خَيرٌ",2],"."],"grade":"صحيح","narrator":"نبيشة الخير الهذلي","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أبو داود (2830)، والنسائي (4230)، وابن ماجه (3167)، وأحمد (20729) واللفظ له","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"sgt5C9WJ"},{"id":"س-02639","fp":"3dbd611613ff","stateId":588,"easy":"إذا تركت ورثتك أغنياء ← فهو خير من أن تتركهم عالة يتكففون الناس","cause":"أنْ تترُكَ ورثَتَكَ بخيرٍ أغيناءَ","result":"خيرٌ لكَ مِن أنْ تترُكَهم عالةً يتكفَّفونَ النَّاسَ","explicit":true,"otherNeedIds":[37],"ref":"تخريج صحيح ابن حبان 7261","srcLabel":"ابن حبان","text":["كُنْتُ مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّم في حجَّةِ الوَداعِ فمرِضْتُ مرَضًا أشفى على الموتِ فعادني رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فقُلْتُ : يا رسولَ اللهِ إنَّ لي مالًا كثيرًا وليس يرِثُني إلَّا ابنةٌ لي أفأُوصي بثُلُثَيْ مالي ؟ قال : ( لا ) قُلْتُ : فبِشَطْرِ مالي ؟ قال : ( لا ) قُلْتُ : فبثُلُثِه ؟ قال : ( الثُّلُثُ والثُّلُثُ كثيرٌ إنَّكَ يا سعدُ ",["أنْ تترُكَ ورثَتَكَ بخيرٍ أغيناءَ",1]," ",["خيرٌ لكَ مِن أنْ تترُكَهم عالةً يتكفَّفونَ النَّاسَ",2]," إنَّكَ يا سعدُ لنْ تُنفِقَ نفقةً تبتغي بها وجهَ اللهِ إلَّا أُجِرْتَ عليها حتَّى اللُّقمةَ تجعَلُها في فِي امرأتِكَ ) قُلْتُ : يا رسولَ اللهِ أُخلَّفُ عن أصحابي ؟ قال : ( إنَّكَ لنْ تُخلَّفَ بعدي فتعمَلَ عمَلًا تُريدُ به وجهَ اللهِ إلَّا ازدَدْتَ به درجةً ورِفعةً ولعلَّكَ أنْ تُخلَّفَ بعدي فينفَعَ اللهُ بكَ أقوامًا ويضُرَّ بكَ آخرينَ اللَّهمَّ أَمضِ لأصحابي هجرتَهم ولا ترُدَّهم على أعقابِهم لكِنِ البائسُ سعدُ بنُ خَولةَ ) رثى له رسولُ اللهِ صلَّى اللهُ عليه وسلَّم وقد مات بمكَّةَ"],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"إسناده صحيح على شرط الشيخين","bab":"إيمان › الاحتساب والنية","dorar":"qzUJL8XK","merged":6,"otherRefs":["صحيح الجامع 3081 (صحيح)","صحيح النسائي 3630 (صحيح)","صحيح النسائي 3635 (صحيح)","صحيح مسلم 1628 (صحيح)","تخريج مشكل الآثار 5228 (صحيح)"]},{"id":"ق-0117","fp":"ca1db405bcd8","stateId":588,"easy":"إنظار المعسر والتصدق عليه بالدَّين ← خير للعبد","cause":"إنظار المعسر والتصدق عليه بالدَّين","result":"خير للعبد","explicit":true,"otherNeedIds":[45],"ref":"سورة البقرة: 280","srcLabel":"القرآن الكريم","quran":{"s":2,"from":280,"to":280,"text":"وَإِنْ كَانَ ذُو عُسْرَةٍ فَنَظِرَةٌ إِلَى مَيْسَرَةٍ وَأَنْ تَصَدَّقُوا خَيْرٌ لَكُمْ إِنْ كُنْتُمْ تَعْلَمُونَ (280)","hl":[[0,112,1]]}},{"id":"ق-0413","fp":"dd047a5b335c","stateId":588,"easy":"إيفاء الكيل والميزان وترك بخس الناس أشياءهم وترك الإفساد ← خير للعبد","cause":"إيفاء الكيل والميزان وترك بخس الناس أشياءهم وترك الإفساد","result":"خير للعبد","explicit":true,"otherNeedIds":[1],"ref":"سورة الأعراف: 85","srcLabel":"القرآن الكريم","quran":{"s":7,"from":85,"to":85,"text":"وَإِلَى مَدْيَنَ أَخَاهُمْ شُعَيْبًا قَالَ يَا قَوْمِ اعْبُدُوا اللَّهَ مَا لَكُمْ مِنْ إِلَهٍ غَيْرُهُ قَدْ جَاءَتْكُمْ بَيِّنَةٌ مِنْ رَبِّكُمْ فَأَوْفُوا الْكَيْلَ وَالْمِيزَانَ وَلَا تَبْخَسُوا النَّاسَ أَشْيَاءَهُمْ وَلَا تُفْسِدُوا فِي الْأَرْضِ بَعْدَ إِصْلَاحِهَا ذَلِكُمْ خَيْرٌ لَكُمْ إِنْ كُنْتُمْ مُؤْمِنِينَ (85)","hl":[[146,320,1]]}},{"id":"ق-0708","fp":"047b540059f1","stateId":588,"easy":"إيفاء الكيل والوزن بالقسط ← خير وأحسن عاقبة","cause":"إيفاء الكيل والوزن بالقسط","result":"خير وأحسن عاقبة","explicit":true,"otherNeedIds":[1],"ref":"سورة الإسراء: 35","srcLabel":"القرآن الكريم","quran":{"s":17,"from":35,"to":35,"text":"وَأَوْفُوا الْكَيْلَ إِذَا كِلْتُمْ وَزِنُوا بِالْقِسْطَاسِ الْمُسْتَقِيمِ ذَلِكَ خَيْرٌ وَأَحْسَنُ تَأْوِيلًا (35)","hl":[[0,110,1]]}},{"id":"س-07753","fp":"e48bc1ec83ac","stateId":588,"easy":"إذا أردت التصدق بمالك كله فأمسك بعضه ← فهو خير لك","cause":"أن أنخَلِعَ مِن مالي صَدَقةً","result":"أمسِكْ بَعضَ مالِكَ فهو خَيرٌ لكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[1],"ref":"صحيح مسلم 2769","srcLabel":"البخاري","text":["ثُمَّ غَزا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم غَزوةَ تَبوكَ، وهو يُريدُ الرُّومَ ونَصارى العَرَبِ بالشَّامِ، قال ابنُ شِهابٍ: فأخبَرَني عبدُ الرَّحمَنِ بنُ عبدِ اللهِ بنِ كَعبِ بنِ مالِكٍ، أنَّ عَبدَ اللهِ بنَ كَعبٍ كان قائِدَ كَعبٍ، مِن بَنيه، حينَ عَميَ، قال: سَمِعتُ كَعبَ بنَ مالِكٍ يُحَدِّثُ حَديثَه حينَ تَخَلَّفَ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةِ تَبوكَ، قال كَعبُ بنُ مالِكٍ: لم أتَخَلَّفْ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةٍ غَزاها قَطُّ إلَّا في غَزوةِ تَبوكَ، غيرَ أنِّي قد تَخَلَّفتُ في غَزوةِ بَدرٍ ولم يُعاتِبْ أحَدًا تَخَلَّفَ عنه، إنَّما خَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم والمُسلِمونَ يُريدونَ عيرَ قُرَيشٍ، حتَّى جَمع اللهُ بينَهم وبينَ عَدوِّهِم على غيرِ ميعادٍ، ولقد شَهِدتُ مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم لَيلةَ العَقَبةِ، حينَ تَواثَقنا على الإسلامِ، وما أُحِبُّ أنَّ لي بها مَشهَدَ بَدرٍ، وإن كانَت بَدرٌ أذكَرَ في النَّاسِ منها، وكانَ مِن خَبَري حينَ تَخَلَّفتُ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةِ تَبوكَ أنِّي لم أكُنْ قَطُّ أقوى ولا أيسَرَ مِنِّي حينَ تَخَلَّفتُ عنه في تلك الغَزوةِ، واللهِ ما جَمَعتُ قَبلَها راحِلَتَينِ قَطُّ، حتَّى جَمَعتُهما في تلك الغَزوةِ، فغَزاها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم في حَرٍّ شَديدٍ واستَقبَلَ سَفَرًا بَعيدًا ومَفازًا، واستَقبَلَ عَدوًّا كَثيرًا، فجَلا للمُسلِمينَ أمرَهم ليَتَأهَّبوا أُهبةَ غَزوِهم، فأخبَرَهم بوجهِهمِ الذي يُريدُ، والمُسلِمونَ مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم كَثيرٌ، ولا يَجمَعُهم كِتابُ حافِظٍ، يُريدُ بذلك الدِّيوانَ، قال كَعبٌ: فقَلَّ رَجُلٌ يُريدُ أن يَتَغَيَّبَ، يَظُنُّ أنَّ ذلك سَيَخفى له، ما لم يَنزِلْ فيه وحيٌ مِنَ اللهِ عَزَّ وجَلَّ، وغَزا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم تلك الغَزوةَ حينَ طابَتِ الثِّمارُ والظِّلالُ، فأنا إليها أصعَرُ، فتَجَهَّزَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم والمُسلِمونَ معهُ، وطَفِقتُ أغدو لكَي أتَجَهَّزَ معهُم، فأرجِعُ ولم أقضِ شيئًا، وأقولُ في نَفسي: أنا قادِرٌ على ذلك إذا أرَدتُ، فلم يَزَلْ ذلك يَتَمادى بي حتَّى استَمَرَّ بالنَّاسِ الجِدُّ، فأصبَحَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم غاديًا والمُسلِمونَ معهُ، ولم أقضِ مِن جَهازي شيئًا، ثُمَّ غَدَوتُ فرَجَعتُ ولم أقضِ شيئًا، فلم يَزَلْ ذلك يَتَمادى بي حتَّى أسرَعوا وتَفارَطَ الغَزوُ، فهَمَمتُ أن أرتَحِلَ فأُدرِكَهم، فيا لَيتَني فعَلتُ، ثُمَّ لم يُقدَّرْ ذلك لي، فطَفِقتُ إذا خَرَجتُ في النَّاسِ بَعدَ خُروجِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم يَحزُنُني أنِّي لا أرى لي أُسوةً إلَّا رَجُلًا مَغموصًا عليه في النِّفاقِ، أو رَجُلًا مِمَّن عَذَرَ اللهُ مِنَ الضُّعَفاءِ، ولم يَذكُرْني رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم حتَّى بَلَغَ تَبوكَ، فقال وهو جالِسٌ في القَومِ بتَبوكَ: ما فعَلَ كَعبُ بنُ مالِكٍ؟ قال رَجُلٌ مِن بَني سَلِمةَ: يا رَسولَ اللهِ، حَبَسَه بُرداه والنَّظَرُ في عِطفَيه، فقال له مُعاذُ بنُ جَبَلٍ: بئسَ ما قُلتَ! واللهِ يا رَسولَ اللهِ، ما عَلِمنا عليه إلَّا خَيرًا، فسَكَتَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فبينَما هو على ذلك رَأى رَجُلًا مُبَيِّضًا يَزولُ به السَّرابُ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: كُنْ أبا خَيثَمةَ، فإذا هو أبو خَيثَمةَ الأنصاريُّ، وهو الذي تَصَدَّقَ بصاعِ التَّمرِ حينَ لَمَزَه المُنافِقونَ. فقال كَعبُ بنُ مالِكٍ: فلَمَّا بَلَغَني أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قد تَوجَّهَ قافِلًا مِن تَبوكَ حَضَرَني بَثِّي، فطَفِقتُ أتَذَكَّرُ الكَذِبَ وأقولُ: بمَ أخرُجُ مِن سَخَطِه غَدًا؟ وأستَعينُ على ذلك كُلَّ ذي رَأيٍ مِن أهلي، فلَمَّا قيلَ لي: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قد أظَلَّ قادِمًا زاحَ عَنِّي الباطِلُ، حتَّى عَرَفتُ أنِّي لَن أنجوَ منه بشيءٍ أبَدًا، فأجمَعتُ صِدقَه، وصَبَّحَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم قادِمًا، وكانَ إذا قدِمَ مِن سَفَرٍ بَدَأ بالمَسجِدِ فرَكَعَ فيه رَكعَتَينِ، ثُمَّ جَلَسَ للنَّاسِ، فلَمَّا فعَلَ ذلك جاءَه المُخَلَّفونَ، فطَفِقوا يَعتَذِرونَ إليه، ويَحلِفونَ له، وكانوا بضعةً وثَمانينَ رَجُلًا، فقَبِلَ منهم رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم عَلانيَتَهم، وبايَعَهم واستَغفَرَ لهم، ووكَلَ سَرائِرَهم إلى اللهِ، حتَّى جِئتُ، فلَمَّا سَلَّمتُ تَبَسَّمَ تَبَسُّمَ المُغضَبِ، ثُمَّ قال: تَعالَ، فجِئتُ أمشي حتَّى جَلَستُ بينَ يَدَيه، فقال لي: ما خَلَّفَكَ؟ ألَم تَكُنْ قدِ ابتَعتَ ظَهرَكَ؟ قال: قُلتُ: يا رَسولَ اللهِ، إنِّي، واللهِ لو جَلَستُ عِندَ غيرِكَ مِن أهلِ الدُّنيا لَرَأيتُ أنِّي سَأخرُجُ مِن سَخَطِه بعُذرٍ، ولقد أُعطيتُ جَدَلًا، ولَكِنِّي واللهِ لقد عَلِمتُ لَئِن حَدَّثتُكَ اليومَ حَديثَ كَذِبٍ تَرضى به عَنِّي لَيوشِكَنَّ اللهُ أن يُسخِطَكَ عليَّ، ولَئِن حَدَّثتُكَ حَديثَ صِدقٍ تَجِدُ عليَّ فيه، إنِّي لأرجو فيه عُقبى اللهِ، واللهِ ما كان لي عُذرٌ، واللهِ ما كُنتُ قَطُّ أقوى ولا أيسَرَ مِنِّي حينَ تَخَلَّفتُ عَنكَ، قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أمَّا هذا فقد صَدَقَ، فقُمْ حتَّى يَقضيَ اللهُ فيكَ، فقُمتُ، وثارَ رِجالٌ مِن بَني سَلِمةَ فاتَّبَعوني، فقالوا لي: واللهِ ما عَلِمناكَ أذنَبتَ ذَنبًا قَبلَ هذا، لقد عَجَزتَ في أن لا تَكونَ اعتَذَرتَ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم بما اعتَذَرَ به إليه المُخَلَّفونَ؛ فقد كان كافيَكَ ذَنبَكَ استِغفارُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم لَكَ. قال: فواللهِ ما زالوا يُؤَنِّبوني حتَّى أرَدتُ أن أرجِعَ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فأُكَذِّبَ نَفسي، قال ثُمَّ قُلتُ لهم: هل لَقيَ هذا مَعي مِن أحَدٍ؟ قالوا: نَعَم، لَقيَه معكَ رَجُلانِ، قالا مِثلَ ما قُلتَ، فقيلَ لهما مِثلَ ما قيلَ لَكَ، قال: قُلتُ: مَن هُما؟ قالوا: مُرارةُ بنُ الرَّبيعةِ العامِريُّ، وهِلالُ بنُ أُمَيَّةَ الواقِفيُّ، قال: فذَكَروا لي رَجُلَينِ صالِحَينِ قد شَهِدا بَدرًا، فيهما أُسوةٌ، قال: فمَضَيتُ حينَ ذَكَروهما لي. قال: ونَهى رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم المُسلِمينَ عن كَلامِنا -أيُّها الثَّلاثةُ- مِن بَينِ مَن تَخَلَّفَ عنه. قال: فاجتَنَبَنا النَّاسُ، وقال: تَغَيَّروا لَنا حتَّى تَنَكَّرَت لي في نَفسيَ الأرضُ، فما هي بالأرضِ التي أعرِفُ، فلَبِثنا على ذلك خَمسينَ لَيلةً، فأمَّا صاحِبايَ فاستَكانا وقَعَدا في بُيوتِهما يَبكيانِ، وأمَّا أنا فكُنتُ أشَبَّ القَومِ وأجلَدَهم، فكُنتُ أخرُجُ فأشهَدُ الصَّلاةَ وأطوفُ في الأسواقِ ولا يُكَلِّمُني أحَدٌ، وآتي رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم فأُسَلِّمُ عليه وهو في مَجلِسِه بَعدَ الصَّلاةِ، فأقولُ في نَفسي: هل حَرَّكَ شَفَتَيه برَدِّ السَّلامِ، أم لا؟ ثُمَّ أُصَلِّي قَريبًا منه وأُسارِقُه النَّظَرَ، فإذا أقبَلتُ على صَلاتي نَظَرَ إليَّ، وإذا التَفَتُّ نَحوه أعرَضَ عَنِّي، حتَّى إذا طالَ ذلك عليَّ مِن جَفوةِ المُسلِمينَ مَشيتُ حتَّى تَسَوَّرتُ جِدارَ حائِطِ أبي قَتادةَ، وهو ابنُ عَمِّي، وأحَبُّ النَّاسِ إليَّ، فسَلَّمتُ عليه، فواللهِ ما رَدَّ عليَّ السَّلامَ. فقُلتُ له: يا أبا قَتادةَ، أنشُدُكَ باللهِ هل تَعلَمَنَّ أنِّي أُحِبُّ اللهَ ورَسولَه؟ قال: فسَكَتَ، فعُدتُ فناشَدتُه، فسَكَتَ، فعُدتُ فناشَدتُه، فقال: اللهُ ورَسولُه أعلَمُ، ففاضَت عَينايَ وتَولَّيتُ حتَّى تَسَوَّرتُ الجِدارَ. فبينا أنا أمشي في سوقِ المَدينةِ إذا نَبَطيٌّ مِن نَبَطِ أهلِ الشَّامِ، مِمَّن قدِمَ بالطَّعامِ يَبيعُه بالمَدينةِ، يقولُ: مَن يَدُلُّ على كَعبِ بنِ مالِكٍ؟ قال: فطَفِقَ النَّاسُ يُشيرونَ له إليَّ، حتَّى جاءَني فدَفَعَ إليَّ كِتابًا مِن مَلِكِ غَسَّانَ، وكُنتُ كاتِبًا، فقَرَأتُه فإذا فيه: أمَّا بَعدُ؛ فإنَّه قد بَلَغَنا أنَّ صاحِبَكَ قد جَفاكَ، ولم يَجعَلْكَ اللهُ بدارِ هَوانٍ ولا مَضيَعةٍ، فالحَقْ بنا نُواسِكَ، قال: فقُلتُ حينَ قَرَأتُها: وهذه أيضًا مِنَ البَلاءِ، فتَيامَمتُ بها التَّنُّورَ فسَجَرتُها بها، حتَّى إذا مَضَت أربَعونَ مِنَ الخَمسينَ، واستَلبَثَ الوحيُ، إذا رَسولُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم يَأتيني، فقال: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَأمُرُكَ أن تَعتَزِلَ امرَأتَكَ، قال: فقُلتُ: أُطَلِّقُها أم ماذا أفعَلُ؟ قال: لا، بَلِ اعتَزِلها، فلا تَقرَبَنَّها، قال: فأرسَلَ إلى صاحِبَيَّ بمِثلِ ذلك، قال: فقُلتُ لامرَأتي: الحَقي بأهلِكِ فكوني عِندَهم حتَّى يَقضيَ اللهُ في هذا الأمرِ، قال: فجاءَتِ امرَأةُ هِلالِ بنِ أُمَيَّةَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فقالت له: يا رَسولَ اللهِ، إنَّ هِلالَ بنَ أُمَيَّةَ شيخٌ ضائِعٌ ليس له خادِمٌ، فهل تَكرَهُ أن أخدُمَه؟ قال: لا، ولَكِن لا يَقرَبَنَّكِ، فقالت: إنَّه واللهِ ما به حَرَكةٌ إلى شيءٍ، وواللهِ ما زالَ يَبكي مُنذُ كان مِن أمرِه ما كانَ إلى يَومِه هذا، قال: فقال لي بَعضُ أهلي: لَوِ استَأذَنتَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم في امرَأتِكَ؟ فقد أذِنَ لامرَأةِ هِلالِ بنِ أُمَيَّةَ أن تَخدُمَه، قال: فقُلتُ: لا أستَأذِنُ فيها رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، وما يُدريني ماذا يقولُ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم إذا استَأذَنتُه فيها، وأنا رَجُلٌ شابٌّ، قال: فلَبِثتُ بذلك عَشرَ لَيالٍ، فكَمُلَ لَنا خَمسونَ لَيلةً مِن حينَ نُهي عن كَلامِنا، قال: ثُمَّ صَلَّيتُ صَلاةَ الفَجرِ صَباحَ خَمسينَ لَيلةً على ظَهرِ بَيتٍ مِن بُيوتِنا، فبينا أنا جالِسٌ على الحالِ التي ذَكَرَ اللهُ عَزَّ وجَلَّ مِنَّا قد ضاقَت عليَّ نَفسي وضاقَت عليَّ الأرضُ بما رَحُبَت، سَمِعتُ صَوتَ صارِخٍ أوفى على سَلعٍ يقولُ بأعلى صَوتِه: يا كَعبَ بنَ مالِكٍ أبشِرْ، قال: فخَرَرتُ ساجِدًا وعَرَفتُ أنْ قد جاءَ فرَجٌ. قال: فآذَنَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم النَّاسَ بتَوبةِ اللهِ علينا، حينَ صَلَّى صَلاةَ الفَجرِ، فذَهَبَ النَّاسُ يُبَشِّرونَنا، فذَهَبَ قِبَلَ صاحِبَيَّ مُبَشِّرونَ، ورَكَضَ رَجُلٌ إليَّ فرَسًا، وسَعى ساعٍ مِن أسلَمَ قِبَلي، وأوفى الجَبَلَ، فكانَ الصَّوتُ أسرَعَ مِنَ الفَرَسِ، فلَمَّا جاءَني الذي سَمِعتُ صَوتَه يُبَشِّرُني فنَزَعتُ له ثَوبَيَّ فكَسَوتُهما إيَّاه ببِشارَتِه، واللهِ ما أملِكُ غَيرَهما يَومَئذٍ، واستَعَرتُ ثَوبَينِ فلَبِستُهما، فانطَلَقتُ أتَأمَّمُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَتَلَقَّاني النَّاسُ فوجًا فوجًا، يُهَنِّئوني بالتَّوبةِ ويقولونَ: لتَهنِئْكَ تَوبةُ اللهِ عليكَ! حتَّى دَخَلتُ المَسجِدَ، فإذا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم جالِسٌ في المَسجِدِ وحَوله النَّاسُ، فقامَ طَلحةُ بنُ عُبَيدِ اللهِ يُهَروِلُ حتَّى صافَحَني وهَنَّأني، واللهِ ما قامَ رَجُلٌ مِنَ المُهاجِرينَ غَيرُه. قال: فكانَ كَعبٌ لا يَنساها لطَلحةَ. قال كَعبٌ: فلَمَّا سَلَّمتُ على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم قال وهو يَبرُقُ وجهُه مِنَ السُّرورِ ويقولُ: أبشِرْ بخَيرِ يَومٍ مَرَّ عليكَ مُنذُ ولَدَتكَ أُمُّكَ، قال: فقُلتُ: أمِن عِندِكَ يا رَسولَ اللهِ أم مِن عِندِ اللهِ؟ فقال: لا، بَل مِن عِندِ اللهِ، وكانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم إذا سُرَّ استَنارَ وجهُه، كَأنَّ وجهَه قِطعةُ قَمَرٍ، قال: وكُنَّا نَعرِفُ ذلك، قال: فلَمَّا جَلَستُ بينَ يَدَيه قُلتُ: يا رَسولَ اللهِ، إنَّ مِن تَوبَتي ",["أن أنخَلِعَ مِن مالي صَدَقةً",1]," إلى اللهِ وإلى رَسولِه صلَّى اللهُ عليه وسلَّم، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["أمسِكْ بَعضَ مالِكَ فهو خَيرٌ لكَ",2],"، قال: فقُلتُ: فإنِّي أُمسِكُ سَهميَ الذي بخَيبَرَ، قال: وقُلتُ: يا رَسولَ اللهِ، إنَّ اللهَ إنَّما أنجاني بالصِّدقِ، وإنَّ مِن تَوبَتي أن لا أُحَدِّثَ إلَّا صِدقًا ما بَقيتُ، قال: فواللهِ ما عَلِمتُ أنَّ أحَدًا مِنَ المُسلِمينَ أبلاه اللهُ في صِدقِ الحَديثِ مُنذُ ذَكَرتُ ذلك لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّم إلى يَومي هذا أحسَنَ ممَّا أبلاني اللهُ به، واللهِ ما تَعَمَّدتُ كَذبةً مُنذُ قُلتُ ذلك لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّم إلى يَومي هذا، وإنِّي لأرجو أن يَحفَظَني اللهُ فيما بَقيَ. قال: فأنزَلَ اللهُ عَزَّ وجَلَّ: {لقد تابَ اللهُ على النَّبيِّ والمُهاجِرينَ والأنصارِ الذينَ اتَّبَعوه في ساعةِ العُسرةِ مِن بَعدِ ما كادَ يَزيغُ قُلوبُ فريقٍ منهم ثُمَّ تابَ عليهم إنَّه بهم رَؤوفٌ رَحيمٌ وعلى الثَّلاثةِ الذينَ خُلِّفوا حتَّى إذا ضاقَت عليهمِ الأرضُ بما رَحُبَت وضاقَت عليهم أنفُسُهم} حتَّى بَلَغَ: {يا أيُّها الذينَ آمَنوا اتَّقوا اللهَ وكونوا مع الصَّادِقينَ}. قال كَعبٌ: واللهِ ما أنعَمَ اللهُ عليَّ مِن نِعمةٍ قَطُّ بَعدَ إذ هَداني اللهُ للإسلامِ أعظَمَ في نَفسي مِن صِدقي رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم أن لا أكونَ كَذَبتُه فأهلِكَ كما هَلَكَ الذينَ كَذَبوا، إنَّ اللهَ قال للذينَ كَذَبوا حينَ أنزَلَ الوحيَ شَرَّ ما قال لأحَدٍ. وقال اللهُ: {سَيَحلِفونَ باللهِ لَكُم إذا انقَلَبتُم إليهم لتُعرِضوا عنهم فأعرِضوا عنهم إنَّهم رِجسٌ ومَأواهم جَهَنَّمُ جَزاءً بما كانوا يَكسِبونَ يَحلِفونَ لَكُم لتَرضَوا عنهم فإن تَرضَوا عنهم فإنَّ اللهَ لا يَرضى عَنِ القَومِ الفاسِقينَ}. قال كَعبٌ: كُنَّا خُلِّفنا أيُّها الثَّلاثةُ عن أمرِ أولَئِكَ الذينَ قَبِلَ منهم رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم حينَ حَلَفوا له، فبايَعَهم واستَغفَرَ لهم، وأرجَأ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم أمرَنا حتَّى قَضى اللهُ فيه، فبِذلك قال اللهُ عَزَّ وجَلَّ: وعلى الثَّلاثةِ الذينَ خُلِّفوا، وليسَ الذي ذَكَرَ اللهُ ممَّا خُلِّفنا تَخَلُّفَنا عَنِ الغَزوِ، وإنَّما هو تَخليفُه إيَّانا، وإرجاؤُه أمرَنا، عَمَّن حَلَفَ له واعتَذَرَ إليه فقَبِلَ منه. وفي روايةٍ: أنَّ عُبَيدَ اللهِ بنَ كَعبِ بنِ مالِكٍ، وكانَ قائِدَ كَعبٍ حينَ عَميَ، قال: سَمِعتُ كَعبَ بنَ مالِكٍ يُحَدِّثُ حَديثَه حينَ تَخَلَّفَ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةِ تَبوكَ، وساقَ الحَديثَ. وزادَ فيه، على يونُسَ: فكانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم قَلَّما يُريدُ غَزوةً إلَّا ورَّى بغَيرِها، حتَّى كانَت تلك الغَزوةُ."],"grade":"صحيح","narrator":"كعب بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4418)، وأحمد (15789) باختلاف يسير، والنسائي في ((الكبرى)) (11168) بنحوه.","bab":"قرآن › أسباب النزول","dorar":"MuC2vFZU","merged":2,"otherRefs":["تخريج المسند لشعيب 15770 (صحيح)"]},{"id":"س-07948","fp":"56df99cf47ab","stateId":588,"easy":"إذا كان مالك قليلاً فدعه لعيالك ← فهو أفضل من الوصية به","cause":"فدَعْه لعِيالِك","result":"فإنَّه أَفضَلُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[37],"ref":"الأحاديث المختارة 672","srcLabel":"البخاري","text":["«دَخَلَ على علِيٍّ عليه السَّلامُ صَديقٌ له يَعودُه، فقالَ له: إنِّي أُريدُ أن أوصيَ، فقالَ علِيٌّ: إنَّ اللهَ يَقولُ: {إِنْ تَرَكَ خَيْرًا}، وإنَّك إنَّما تَدَعُ شَيئًا يَسيرًا ",["فدَعْه لعِيالِك",1]," ",["فإنَّه أَفضَلُ",2],"»."],"grade":"صحيح","narrator":"[عروة بن الزبير]","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"OLHdiOVu"},{"id":"س-04700","fp":"5534e572eda5","stateId":588,"easy":"إذا فتحت باب عطية ابتغاء وجه الله ← يعطيك الله خير الدنيا والآخرة","cause":"ومن فتح بابَ عطيةٍ ابتغاءَ وجهِ اللهِ","result":"أعطاه اللهُ خيرَ الدُّنيا والآخرةِ","explicit":true,"ref":"مسند عمر 1/20","srcLabel":"أحمد","text":["مَن فتح بابَ مسألةٍ فتح اللهُ له بابَ فقرٍ في الدُّنيا والآخرةِ ",["ومن فتح بابَ عطيةٍ ابتغاءَ وجهِ اللهِ ",1],["أعطاه اللهُ خيرَ الدُّنيا والآخرةِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (9624) مطولاً، وأبو يعلى (6691) مختصراً، والطبري في ((تهذيب الآثار - مسند عمر)) (26) واللفظ له","bab":"رقائق وزهد › الإخلاص","dorar":"GooteYrl"},{"id":"س-04887","fp":"23d9d0eaaa76","stateId":588,"easy":"إذا لبست ثوباً مرقعاً ← فهو خير من أن تأخذ ما ليس عندك بالأمانة","cause":"أنْ يأخذَ بأمانتِه ما ليسَ عندَه","result":"لأنْ يلبسَ أحدُكم ثوبًا منْ رِقَاعٍ شَتَّى، خيرٌ لهُ","explicit":true,"otherNeedIds":[2],"ref":"الجامع الصغير 7199","srcLabel":"أحمد","text":[["لأنْ يلبسَ أحدُكم ثوبًا منْ رِقَاعٍ شَتَّى،  خيرٌ لهُ",2]," منْ ",["أنْ يأخذَ بأمانتِه ما ليسَ عندَه",1]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"أخرجه أحمد (13559)، والخطيب في ((الأسماء المبهمة)) (1/ 59)، وفي ((المتفق والمفترق)) (349) واللفظ لهما، والدولابي في ((الكنى والأسماء)) (1975) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"NCjkXToA"},{"id":"س-07132","fp":"9a27428b9233","stateId":588,"easy":"إذا تركت ولد الناقة حتى يكبر فحملت عليه في سبيل الله ← خير من ذبحه صغيراً","cause":"وإن ترَكْتَهُ حتَّى يَكونَ شُغزُبًّا ابنَ مخاضٍ ، أوِ ابنَ لبونٍ ، فتَحملَ عليهِ في سبيلِ اللَّهِ ، أو تُعْطيَهُ أرملةً","result":"خيرٌ من أن تبُكَّهُ يَلصَقُ لحمُهُ بوبرِهِ ، وتَكْفأَ إناءَكَ ، وتولِهُ ناقتَكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشاكر 11/37","srcLabel":"أبو داود","text":["سُئِلَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ عنِ الفَرعِ ؟ فقالَ : الفَرعُ حقٌّ ، ",["وإن ترَكْتَهُ حتَّى يَكونَ شُغزُبًّا ابنَ مخاضٍ ، أوِ ابنَ لبونٍ ، فتَحملَ عليهِ في سبيلِ اللَّهِ ، أو تُعْطيَهُ أرملةً",1]," ، ",["خيرٌ من أن تبُكَّهُ يَلصَقُ لحمُهُ بوبرِهِ ، وتَكْفأَ إناءَكَ ، وتولِهُ ناقتَكَ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2842)، وأحمد (6759) واللفظ له.","bab":"علم › حسن السؤال ونصح العالم","dorar":"S3ZnjtCe"},{"id":"س-02305","fp":"6133477a4e3e","stateId":589,"easy":"إذا جعلت لبيتك نصيباً من صلاتك ← يجعل الله في بيتك خيراً","cause":"فإذا صلَّى أحَدُكم في المسجِدِ فلْيَجعَلْ في بَيْتِه نَصيبًا مِن صلاتِه","result":"فإنَّ اللهَ تعالى جاعِلٌ في بَيْتِه مِن صلاتِه خَيرًا","explicit":true,"star":true,"ref":"الأحاديث المختارة 1836","srcLabel":"البخاري","text":["«صلاةُ الرَّجُلِ في الجَماعةِ تَفضُلُ على صلاةِ الرَّجُلِ وَحْدَه في بَيْتِه بسَبْعةٍ وعِشرينَ ضِعْفًا، ",["فإذا صلَّى أحَدُكم في المسجِدِ فلْيَجعَلْ في بَيْتِه نَصيبًا مِن صلاتِه",1],"؛ ",["فإنَّ اللهَ تعالى جاعِلٌ في بَيْتِه مِن صلاتِه خَيرًا",2],"، وإنَّ الشَّيْطانَ لا يدخُلُ بَيْتًا فيه يقرَأُ القُرآنَ»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"m0JjRLEj"},{"id":"ق-0210","fp":"72745bc3a0c1","stateId":589,"easy":"المعاشرة بالمعروف والصبر على الزوجة مع الكراهة ← خير كثير يجعله الله","cause":"المعاشرة بالمعروف والصبر على الزوجة مع الكراهة","result":"خير كثير يجعله الله","explicit":true,"star":true,"otherNeedIds":[37],"ref":"سورة النساء: 19","srcLabel":"القرآن الكريم","quran":{"s":4,"from":19,"to":19,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا يَحِلُّ لَكُمْ أَنْ تَرِثُوا النِّسَاءَ كَرْهًا وَلَا تَعْضُلُوهُنَّ لِتَذْهَبُوا بِبَعْضِ مَا آتَيْتُمُوهُنَّ إِلَّا أَنْ يَأْتِينَ بِفَاحِشَةٍ مُبَيِّنَةٍ وَعَاشِرُوهُنَّ بِالْمَعْرُوفِ فَإِنْ كَرِهْتُمُوهُنَّ فَعَسَى أَنْ تَكْرَهُوا شَيْئًا وَيَجْعَلَ اللَّهُ فِيهِ خَيْرًا كَثِيرًا (19)","hl":[[192,320,1]]}},{"id":"س-01275","fp":"19a00d90558f","stateId":589,"easy":"إذا قبلت مشورة النبي ﷺ في الزواج ← يجعل الله لك فيه خيراً (من واقعة)","cause":"انكِحِي أُسامةَ بنَ زيْدٍ. فكرِهْتُه، فقالَ: انكِحي أُسامةَ بنَ زيْدٍ. فنكِحْتُه","result":"فجعَلَ اللهُ لي فيه خيرًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 27328","srcLabel":"مسلم","text":["أنَّ أبا عَمرِو بنَ حفْصٍ طلَّقَها البتَّةَ، وهو غائِبٌ، فذكَرَ معناه، وقال: ",["انكِحِي أُسامةَ بنَ زيْدٍ. فكرِهْتُه، فقالَ: انكِحي أُسامةَ بنَ زيْدٍ. فنكِحْتُه",1],"، ",["فجعَلَ اللهُ لي فيه خيرًا",2],"."],"grade":"صحيح","narrator":"فاطمة بنت قيس","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (1480)، وأبو داود (2284)، والنسائي (3245)، وأحمد (27328) واللفظ له","bab":"نكاح › الحث على التزويج","dorar":"FaAE7F0k"},{"id":"س-03725","fp":"dbb6e067d89e","stateId":589,"easy":"إذا لم تكل الأمة الجنائز إلى أهلها وحدهم ← تبقى في تمسك بدينها","cause":"ما لم يَكِلوا الجَنائزَ إلى أهلِها","result":"لا تَزالُ أُمَّتي -أو: هذه الأُمَّةُ- في مَسَكةٍ من دينِها","explicit":true,"ref":"المستدرك على الصحيحين 1389","srcLabel":"الحاكم","text":[["لا تَزالُ أُمَّتي -أو: هذه الأُمَّةُ- في مَسَكةٍ من دينِها",2]," ",["ما لم يَكِلوا الجَنائزَ إلى أهلِها",1],"."],"grade":"صحيح","narrator":"الصنابحي","muhaddith":"صحيح الإسناد إن كان الصنابحي هذا عبد الله، فإن كان عبد الرحمن بن عسيلة الصنابحي فإنه يختلف في سماعه من النبي صلى الله عليه وسلم","bab":"اعتصام بالسنة › لزوم السنة","dorar":"lbwXdO8B"},{"id":"س-07241","fp":"08e8312f6530","stateId":589,"easy":"إذا اعتزلت جليس السوء ← فالوحدة خير منه","cause":"الوَحدةُ","result":"خَيرٌ مِن جليس السُّوءِ","explicit":true,"ref":"الجامع الصغير 9647","srcLabel":"الحاكم","text":[["الوَحدةُ ",1],["خَيرٌ مِن جليس السُّوءِ",2],"، والجليسُ الصَّالحُ خَيرٌ مِن الوَحدةِ، وإملاءُ الخيرِ خَيرٌ مِن السُّكوتِ، والسُّكوتُ خَيرٌ مِن إملاءِ الشَّرِّ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه الدولابي في ((الكنى والأسماء)) (1734)، والخرائطي في ((مكارم الأخلاق)) (753)، والحاكم (5466)، والبيهقي في ((شعب الإيمان)) (4993) واللفظ لهم.","bab":"علم › فضل مجالس العلم والذكر","dorar":"6xuJrBG5"},{"id":"س-07275","fp":"13702dee4b2d","stateId":589,"easy":"إذا كان أمراؤكم خياركم وأغنياؤكم سمحاءكم وأمركم شورى ← فظهر الأرض خير لكم من بطنها","cause":"إذا كانت أمراؤكم خيارَكم وكان أغنياؤكم سمحاءَكم وكانت أموركُم شورى بينكم","result":"فظَهْرُ الأرضُ خيرٌ لكم من بطنها","explicit":true,"ref":"مسند عمر 1/113","srcLabel":"الترمذي","text":[["إذا كانت أمراؤكم خيارَكم وكان أغنياؤكم سمحاءَكم وكانت أموركُم شورى بينكم",1]," ",["فظَهْرُ الأرضُ خيرٌ لكم من بطنها",2]," وإذا كانت أمراؤكم شرارُكم وكان أغنياؤكم بخلاءكم وكانت أمورُكم إلى نسائِكم فبطنُ الأرضِ خيرٌ لكم من ظهْرها"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (2266)، والبزار (9529)، وأبو نعيم في ((حلية الأولياء)) (6/176)","bab":"فتن › ظهور الفتن","dorar":"LkxtpFNP"},{"id":"س-05779","fp":"5d35f67cc887","stateId":589,"easy":"إذا وضعت ما في بطنك في غير موضعه (أسرفت في الأكل) ← لكان خيراً لك","cause":"لو كانَ هذا في غيرِ هذا","result":"لكانَ خيرًا لَكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 8/229","srcLabel":"أحمد","text":["سمعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ورأَى رجلًا سمِينًا فجعَلَ النبيُّ صلَّى اللهُ عليه وسلَّم يُوِمئُ إلى بطْنِهِ ويقولُ ",["لو كانَ هذا في غيرِ هذا",1]," ",["لكانَ خيرًا لَكَ",2]," قالَ وأُتِيَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم برجُلٍ فقالوا هذا أرادَ أنْ يَقْتُلَكَ فقالَ لَهُ النبيُّ صلَّى اللهُ عليه وسلَّم لَمْ تُرَعْ لَمْ تُرَعْ لَوْ أردتَّ ذلِكَ لَمْ يُسَلِّطْكَ اللهُ عَلَيَّ"],"grade":"صحيح","narrator":"جعدة بن خالد","muhaddith":"رجاله رجال الصحيح غير أبي إسرائيل الجشمي وهو ثقة","takhrij":"أخرجه أحمد (15868) واللفظ له، والحاكم (7141)، والطبراني في ((المعجم الكبير)) (2/ 284) (2185) مختصرًا.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"150lI2nR","merged":3,"otherRefs":["تخريج الإحياء للعراقي 3/109 (حسن)","مجمع الزوائد 7/183 (حسن)"]},{"id":"س-05856","fp":"d8e5f8bcc97d","stateId":590,"easy":"إذا استكثرت من النعال ← لا تزال راكباً ما انتعلت","cause":"استَكثِروا مِنَ النِّعالِ","result":"فإنَّ الرَّجُلَ لا يَزالُ راكِبًا ما انتَعَلَ","explicit":true,"star":true,"ref":"صحيح مسلم 2096","srcLabel":"مسلم","text":["سَمِعتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم يقولُ في غَزوةٍ غَزَوناها: ",["استَكثِروا مِنَ النِّعالِ؛ ",1],["فإنَّ الرَّجُلَ لا يَزالُ راكِبًا ما انتَعَلَ",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2096).","bab":"رقائق وزهد › الوصايا النافعة","dorar":"w3M4XQVR"},{"id":"س-04149","fp":"c9e6bf9ecde1","stateId":590,"easy":"إذا لبست البياض ← فهو أطهر وأطيب","cause":"الْبَسُوا مِن الثِّيابِ البياضَ","result":"فإنَّها أطْهَرُ وأطيبُ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 7583","srcLabel":"الترمذي","text":[["الْبَسُوا مِن الثِّيابِ البياضَ",1],"؛ ",["فإنَّها أطْهَرُ وأطيبُ",2]," وكَفِّنُوا فيها مَوتاكُم."],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه الترمذي (2810)، والنسائي (5323) باختلاف يسير.","bab":"جنائز وموت › صفة الكفن","dorar":"62WvKgw5","merged":4,"otherRefs":["تخريج المسند لشعيب 20200 (صحيح)","المستدرك على الصحيحين 1327 (صحيح)","صحيح الجامع 1235 (صحيح)"]},{"id":"س-01354","fp":"af269455702c","stateId":590,"easy":"إذا أتيت أهلك ثم أردت أن تعود فتوضأ ← فهو أنشط للعود","cause":"إذا أتى أحدُكم أهلَه ثمَّ أراد أنْ يعودَ فليتوضَّأْ","result":"فإنَّه أنشطُ للعَوْدِ","explicit":true,"otherNeedIds":[35,37],"ref":"نيل الأوطار 1/272","srcLabel":"ابن حبان","text":["إنَّهُ أنشطُ للعودِ [يعني حديث: ",["إذا أتى أحدُكم أهلَه ثمَّ أراد أنْ يعودَ فليتوضَّأْ",1]," ",["فإنَّه أنشطُ للعَوْدِ",2],"]"],"grade":"صحيح","narrator":"[أبو سعيد الخدري]","muhaddith":"ثابت","takhrij":"أخرجه ابن حبان (1211)، والحاكم (542)، والبيهقي (1000) بلفظه تامًا.","bab":"نكاح › عشرة النساء","dorar":"EyiNNjzp","merged":2,"otherRefs":["صحيح ابن خزيمة 1/ 324 (صحيح)"]},{"id":"س-04148","fp":"13aab0e55ff2","stateId":590,"easy":"إذا لبست البياض وكفنت فيه موتاك ← فهي من خير ثيابكم","cause":"فالبَسوها، وكَفِّنوا فيها مَوْتاكم","result":"هي من خَيرِ ثِيابِكم","explicit":true,"ref":"تخريج زاد المعاد 1/135","srcLabel":"زاد المعاد","text":["وكانَ أحبَّ الألوانِ إليه البياضُ، وقال: ",["هي من خَيرِ ثِيابِكم",2]," ",["فالبَسوها، وكَفِّنوا فيها مَوْتاكم",1],"."],"grade":"صحيح","muhaddith":"[حسن صحيح]","bab":"جنائز وموت › صفة الكفن","dorar":"Z10lMA0A","merged":2,"otherRefs":["الجامع الصغير 5497 (صحيح)"]},{"id":"س-04147","fp":"a05c1311f1fc","stateId":590,"easy":"إذا لبست البياض ← فهو أحسن ما تزور الله به في قبرك ومسجدك","cause":"البياضُ","result":"إنَّ أحسنَ ما زُرتم اللهَ به في قبورِكم ومساجِدِكم","explicit":true,"ref":"البدر المنير 4/675","srcLabel":"ابن ماجه","text":[["إنَّ أحسنَ ما زُرتم اللهَ به في قبورِكم ومساجِدِكم",2]," ",["البياضُ",1]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"كل رجاله ثقات","takhrij":"أخرجه ابن ماجه (3568) واللفظ له، والمحاملي في ((الأمالي)) (335) باختلاف يسير","bab":"جنائز وموت › صفة الكفن","dorar":"FiG9rVYC"},{"id":"س-01350","fp":"11b035fed962","stateId":590,"easy":"إذا اغتسلت عند كل جماع ← فهو أزكى وأطيب وأطهر","cause":"يَغْتَسِلُ عندَ هذه ، وعندَ هذه","result":"هذا أَزْكَى وأَطْيَبُ وأَطْهَرُ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"هداية الرواة 447","srcLabel":"أبو داود","text":["إنَّ رسولَ اللهِ – صلَّى اللهُ عليه وسلَّم – طاف ذاتَ يومٍ على نسائِه ، ",["يَغْتَسِلُ عندَ هذه ، وعندَ هذه",1]," ، قال : فقلتُ له : يا رسولَ اللهِ ! أَلَا تَجْعَلُهُ غُسْلًا واحِدًا آخِرًا ؟ قال : ",["هذا أَزْكَى وأَطْيَبُ وأَطْهَرُ",2]],"grade":"حسن","narrator":"أبو رافع مولى رسول الله صلى الله عليه وسلم","muhaddith":"إسناده حسن","takhrij":"أخرجه أبو داود (219)، وابن ماجة (590)، وأحمد (23862) واللفظ لهم.","bab":"نكاح › عشرة النساء","dorar":"mzHCMFh3"},{"id":"س-03727","fp":"9ffcef7522a7","stateId":591,"easy":"إذا لم تؤخر الفطر حتى تظهر النجوم ← تبقى على السنة","cause":"مالم تَنْتَظِرْ بفِطْرِها النجومَ","result":"لا تَزَالُ أُمَّتِي على سُنَّتِي","explicit":true,"star":true,"ref":"صحيح ابن خزيمة 2061","srcLabel":"متفق عليه","text":[["لا تَزَالُ أُمَّتِي على سُنَّتِي",2]," ",["مالم تَنْتَظِرْ بفِطْرِها النجومَ",1]," . قال : وكان النبيُّ صلَّى اللهُ عليه وسلَّم إذا كان صائمًا أمر رجلًا ، فأَوْفَى على شيءٍ ، فإذا قال : غابَتِ الشمسُ أَفْطَرَ ."],"grade":"صحيح","narrator":"سهل بن سعد الساعدي","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن خزيمة (2061) واللفظ له، وأخرجه البخاري (1957)، ومسلم (1098) مختصراً بنحوه","bab":"اعتصام بالسنة › لزوم السنة","dorar":"RrGSnoPj","merged":2,"otherRefs":["فيض القدير 5/ 301 (حسن)"]},{"id":"س-05846","fp":"0e18c3afab2a","stateId":591,"easy":"إذا عجّل الناس الفطر ← لا يزالون بخير","cause":"ما عجَّلوا الفِطرَ","result":"لا يزالُ النَّاسُ بخَيرٍ","explicit":true,"ref":"صحيح ابن ماجه 1387","srcLabel":"أبو داود","text":[["لا يزالُ النَّاسُ بخَيرٍ",2]," ",["ما عجَّلوا الفِطرَ",1]," عجِّلوا الفطرَ فإنَّ اليَهودَ يؤخِّرونَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه ابن ماجه (1698) واللفظ له، وأخرجه أبو داود (2353)، وأحمد (9810) بنحوه","bab":"رقائق وزهد › الوصايا النافعة","dorar":"M9GvWN5F","merged":5,"otherRefs":["تحفة المحتاج 2/93 (صحيح)","إرواء الغليل 4/33 (صحيح)","صحيح مسلم 1098 (صحيح)","الأربعين المغنية 475 (صحيح)"]},{"id":"س-03701","fp":"af5f1f19bd08","stateId":591,"easy":"إذا لم تؤخر الأمة المغرب حتى تشتبك النجوم ← تبقى بخير","cause":"ما لم يؤخِّروا المغربَ حتَّى تشتبِكَ النُّجومُ","result":"لا تزالُ أمَّتي بخيرٍ","explicit":true,"ref":"صحيح ابن خزيمة 1/ 435","srcLabel":"أبو داود","text":["قدمَ علينا أبو أيُّوبَ غازيًا وعُقبةُ بنُ عامرٍ يومئذٍ علَى مصرَ فأخَّرَ المغربَ فقامَ إليهِ أبو أيُّوبَ فقالَ ما هذِهِ الصَّلاةُ يا عقبةُ فقالَ شُغِلْنا فقالَ أما واللَّهِ ما بي إلَّا أن يظنَّ النَّاسُ أنَّكَ رأيتَ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يصنَعُ هَكَذا سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ ",["لا تزالُ أمَّتي بخيرٍ",2]," أو على الفِطرةِ ",["ما لم يؤخِّروا المغربَ حتَّى تشتبِكَ النُّجومُ",1]," وفي رواية أما سمِعتَ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ لا تزالُ أمَّتي وفي روايةٍ أما سمعتَ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ لا تزالُ أمَّتي بخيرٍ أو على الفِطرةِ ما لم يؤخِّروا المغرِبَ حتَّى تشتبِكَ النُّجومُ قالَ بلَى"],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (418)، وأحمد (23582)، والحاكم (685) واللفظ لهم.","bab":"اعتصام بالسنة › لزوم السنة","dorar":"m4Y7KiSG","merged":3,"otherRefs":["المستدرك على الصحيحين 698 (صحيح)","مجمع الزوائد 1/316 (حسن)"]},{"id":"س-04034","fp":"716307fb16a0","stateId":592,"easy":"إذا لم تتمنَّ الموت ← فلعلك تزداد خيراً إن كنت محسناً أو تتوب إن كنت مسيئاً","cause":"ولا يَتَمَنَّيَنَّ أحَدُكُمُ المَوتَ","result":"إمَّا مُحسِنًا فلَعَلَّه أن يَزدادَ خَيرًا، وإمَّا مُسيئًا فلَعَلَّه أن يَستَعتِبَ","explicit":true,"star":true,"otherNeedIds":[36],"ref":"صحيح البخاري 5673","srcLabel":"متفق عليه","text":["لَن يُدخِلَ أحَدًا عَمَلُه الجَنَّةَ. قالوا: ولا أنتَ يا رَسولَ اللهِ؟ قال: لا، ولا أنا، إلَّا أن يَتَغَمَّدَني اللهُ بفَضلٍ ورَحمةٍ؛ فسَدِّدوا وقارِبوا، ",["ولا يَتَمَنَّيَنَّ أحَدُكُمُ المَوتَ",1],": ",["إمَّا مُحسِنًا فلَعَلَّه أن يَزدادَ خَيرًا، وإمَّا مُسيئًا فلَعَلَّه أن يَستَعتِبَ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5673)، ومسلم (2816)","bab":"توبة › سعة رحمة الله تعالى وأنها سبقت غضبه","dorar":"DPz8ZGaw","merged":5,"otherRefs":["تخريج المسند لشعيب 10669 (صحيح)","صحيح النسائي 1818 (صحيح)","صحيح الجامع 5222 (صحيح)","الترغيب والترهيب 4/206 (صحيح)"]},{"id":"س-03198","fp":"209095e8ea94","stateId":592,"easy":"إذا طال عمرك وأنت مؤمن ← لا يزيدك طول العمر إلا خيراً","cause":"طُولُ العُمُرِ","result":"إنَّ المُؤمِنَ لا يَزيدُه طُولُ العُمُرِ إلَّا خَيرًا","explicit":true,"otherNeedIds":[36],"ref":"تخريج المسند لشعيب 23973","srcLabel":"أحمد","text":["يا طاعونُ، خُذْني إليكَ! قالوا: لِمَ تقولُ هذا؟ أليس سَمِعتَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["إنَّ المُؤمِنَ لا يَزيدُه طُولُ العُمُرِ إلَّا خَيرًا",2],"؟ قال: بَلى! فذَكَرَ مِثلَ حَديثِ وَكيعٍ. [أي حَديثَ:...ولكنِّي أخافُ سِتًّا: إمارةَ السُّفَهاءِ، وبَيعَ الحُكمِ، وكَثْرةَ الشُّرَطِ، وقَطيعةَ الرَّحِمِ، ونَشْأً يَنشَؤونَ يتَّخِذونَ القُرآنَ مَزاميرَ، وسَفْكَ الدَّمِ]"],"grade":"صحيح","narrator":"عوف بن مالك الأشجعي","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (23973) واللفظ له، وابن أبي شيبة (38901)، والطبراني (18/57) (105)","bab":"إيمان › فضل الإيمان","dorar":"uTjufJyD","merged":3,"otherRefs":["إرواء الغليل 6/28 (صحيح)","الجامع الصغير 6353 (حسن)"]},{"id":"س-05836","fp":"c95b6d653d5b","stateId":592,"easy":"إذا كنت محسناً فأُخّرت ← تزداد إحساناً إلى إحسانك","cause":"تُؤخَّرْ تَزدادُ إحسانًا إلى إحسانِكَ","result":"خَيرًا لكَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[36],"ref":"المستدرك على الصحيحين 1271","srcLabel":"أحمد","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ دَخَل عَليهِم وعَبَّاسٌ عَمُّ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يَشتَكي، فتَمَنَّى عَبَّاسٌ المَوتَ، فقالَ له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا عَمُّ، لا تَتَمَنَّ المَوتَ؛ فإنَّكَ إنْ كُنتَ مُحسِنًا فإنْ ",["تُؤخَّرْ تَزدادُ إحسانًا إلى إحسانِكَ",1]," ",["خَيرًا لكَ",2],"، وإنْ كُنتَ مُسيئًا فإنْ تُؤخَّرْ تَستَعتِبْ من إساءَتِكَ خَيرًا لكَ، فلا تَتَمَنَّ المَوتَ."],"grade":"صحيح","narrator":"أم الفضل","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (26874)، والحارث بن أبي أسامة كما في ((البغية)) (1082) واللفظ له، وأبو يعلى في ((مسنده)) (7076)  بلفظ قريب.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"Mkt8ZIvm"},{"id":"س-05837","fp":"bec0c76ccf5e","stateId":592,"easy":"إذا كنت مسيئاً فأُخّرت ← تستعتب من إساءتك","cause":"تُؤخَّرْ تَستَعتِبْ من إساءَتِكَ","result":"خَيرًا لكَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[36],"ref":"المستدرك على الصحيحين 1271","srcLabel":"أحمد","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ دَخَل عَليهِم وعَبَّاسٌ عَمُّ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يَشتَكي، فتَمَنَّى عَبَّاسٌ المَوتَ، فقالَ له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا عَمُّ، لا تَتَمَنَّ المَوتَ؛ فإنَّكَ إنْ كُنتَ مُحسِنًا فإنْ تُؤخَّرْ تَزدادُ إحسانًا إلى إحسانِكَ خَيرًا لكَ، وإنْ كُنتَ مُسيئًا فإنْ ",["تُؤخَّرْ تَستَعتِبْ من إساءَتِكَ",1]," ",["خَيرًا لكَ",2],"، فلا تَتَمَنَّ المَوتَ."],"grade":"صحيح","narrator":"أم الفضل","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (26874)، والحارث بن أبي أسامة كما في ((البغية)) (1082) واللفظ له، وأبو يعلى في ((مسنده)) (7076)  بلفظ قريب.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"Mkt8ZIvm"}]}