{"schema":1,"kind":"sunan-chunk","version":"sunan-2420572879fb","needId":13,"stateIds":[109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145,146,147],"items":[{"id":"س-07757","fp":"1d545ea160f5","stateId":109,"easy":"إذا جعلت لله نداً وهو خلقك ← فهو أكبر الذنوب","cause":"أن تَدعوَ للهِ نِدًّا وهو خَلَقَكَ","result":"أيُّ الذَّنبِ أكبَرُ عِندَ اللهِ","explicit":true,"star":true,"otherNeedIds":[22],"ref":"صحيح البخاري 7532","srcLabel":"مسلم","text":["قال رَجُلٌ: يا رَسولَ اللهِ، ",["أيُّ الذَّنبِ أكبَرُ عِندَ اللهِ",2],"؟ قال: ",["أن تَدعوَ للهِ نِدًّا وهو خَلَقَكَ",1],"، قال: ثُمَّ أيٌّ؟ قال: ثُمَّ أن تَقتُلَ ولَدَكَ مَخافةَ أن يَطعَمَ معكَ، قال: ثُمَّ أيٌّ؟ قال: أن تُزانيَ حَليلةَ جارِكَ، فأنزَلَ اللهُ تَصديقَها: {وَالَّذِينَ لَا يَدْعُونَ مَعَ اللَّهِ إِلَهًا آخَرَ وَلَا يَقْتُلُونَ النَّفْسَ الَّتِي حَرَّمَ اللَّهُ إِلَّا بِالْحَقِّ وَلَا يَزْنُونَ وَمَنْ يَفْعَلْ ذَلِكَ يَلْقَ أَثَامًا (68) يُضَاعَفْ لَهُ الْعَذَابُ} [الفرقان: 68، 69] الآيةَ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (86) باختلاف يسير","bab":"قرآن › أسباب النزول","dorar":"124CWz2H","merged":6,"otherRefs":["صحيح النسائي 4026 (صحيح)","صحيح مسلم 86 (صحيح)","تخريج المسند لشاكر 6/86 (صحيح)","صحيح أبي داود 2310 (صحيح)","تخريج مشكل الآثار 890 (صحيح)"]},{"id":"س-03819","fp":"e58b200f20f8","stateId":109,"easy":"إذا أشركت أو قتلت ولدك أو زنيت بزوجة جارك ← فهي من أكبر الكبائر","cause":"الإشراكُ باللهِ وقتلُ الولدِ والزِّنا بحَليلةِ الجارِ","result":"من الكبائرِ","explicit":true,"star":true,"ref":"عارضة الأحوذي 6/127","srcLabel":"متفق عليه","text":[["الإشراكُ باللهِ وقتلُ الولدِ والزِّنا بحَليلةِ الجارِ",1]," [ أيْ ",["من الكبائرِ",2]," ]"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"ثابت","takhrij":"أخرجه البخاري (4477)، ومسلم (86) بنحوه.","bab":"بر وصلة › حق الجار والوصاة به","dorar":"SvZ0aNZK"},{"id":"س-04383","fp":"f806cc5750f8","stateId":109,"easy":"إذا أشركت أو قتلت أو فررت من الزحف أو قذفت ← فهي من الكبائر التسع","cause":"الإشراكُ باللهِ، وقَتلُ النَّفسِ بغَيرِ حِلِّها، والفِرارُ مِنَ الزَّحفِ، وقَذفُ المُحصَنةِ، وأكْلُ الرِّبا، وأكلُ مالِ اليَتيمِ ظُلمًا، وإلحادٌ في المَسجِدِ الحَرامِ، والذي يَستَسحِرُ، وبُكاءُ الوالِدَيْنِ مِنَ العُقوقِ","result":"هي تِسعٌ","explicit":true,"star":true,"similar":["س-02703","س-04380","س-04392"],"ref":"عمدة التفسير 1/491","srcLabel":"البخاري","text":["كُنتُ مع النَّجِداتِ، فأصَبتُ ذُنوبًا لا أُراها إلَّا مِنَ الكَبائِرِ، فلَقيتُ ابنَ عُمَرَ فقُلتُ له: إنِّي أصَبتُ ذُنوبًا لا أُراها إلَّا مِنَ الكَبائِرِ. قال: ما هي؟ قُلتُ: أصَبتُ كذا وكذا؟ قال: ليس مِنَ الكَبائِرِ. قُلتُ: وأصَبتُ كذا وكذا؟ قال: ليس مِنَ الكَبائِرِ. قال لِشَيءٍ لم يُسَمِّه طَيسَلةُ، قال: ",["هي تِسعٌ",2],"، وسأعُدُّهُنَّ عليكَ: ",["الإشراكُ باللهِ، وقَتلُ النَّفسِ بغَيرِ حِلِّها، والفِرارُ مِنَ الزَّحفِ، وقَذفُ المُحصَنةِ، وأكْلُ الرِّبا، وأكلُ مالِ اليَتيمِ ظُلمًا، وإلحادٌ في المَسجِدِ الحَرامِ، والذي يَستَسحِرُ، وبُكاءُ الوالِدَيْنِ مِنَ العُقوقِ",1],". قال طَيسَلةُ: لَمَّا رأى ابنُ عُمَرَ فَرَقي قال: أتَخافُ النارَ أنْ تَدخُلَها؟ قُلتُ: نَعَمْ. قال: وتُحِبُّ أنْ تَدخُلَ الجَنَّةَ؟ قُلتُ: نَعَمْ. قال: أحَيٌّ والِداكَ؟ قُلتُ: عِندي أُمِّي. قال: فواللهِ لَئِن أنتَ ألَنتَ لها الكَلامَ، وأطعَمتَها الطَّعامَ، لَتَدخُلَنَّ الجَنَّةَ ما اجتَنَبتَ المُوجِباتِ."],"grade":"صحيح","narrator":"طيسلة بن مياس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أخرجه البخاري في ((الأدب المفرد)) (8) بلفظه، وإسماعيل بن إسحاق الجهضمي في ((أحكام القرآن)) (35)، والطبري في ((التفسير)) (6/ 646)، وابن حجر في ((موافقة الخبر)) (1/ 343) جميعهم بألفاظ مقاربة.","bab":"جهاد › التولي والفرار من الزحف","dorar":"WFTQ9lK5"},{"id":"س-03765","fp":"7cd3eb495f86","stateId":109,"easy":"إذا أشركت بالله أو أمنت من مكره أو قنطت من رحمته ← فهي من الكبائر","cause":"الإشراكُ باللهِ والأمنُ من مكرِ اللهِ والقُنوطُ من رحمةِ اللهِ واليأسُ من رَوحِ اللهِ","result":"الكبائرِ","explicit":true,"otherNeedIds":[22],"ref":"مجمع الزوائد 1/109","srcLabel":"مجمع الزوائد","text":["عن ابنِ مسعودٍ قال الكبائرُ ",["الإشراكُ باللهِ والأمنُ من مكرِ اللهِ والقُنوطُ من رحمةِ اللهِ واليأسُ من رَوحِ اللهِ",1]," وفي روايةٍ أكبرُ ",["الكبائرِ",2]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"الكفر والشرك › ذم الشرك وما ورد فيه من العقوبة","dorar":"2c91ONSQ","merged":4,"otherRefs":["تفسير القرآن العظيم 2/243 (صحيح)","الدر المنثور 4/367 (حسن)","السلسلة الصحيحة 2051 (حسن)"]},{"id":"س-02703","fp":"dbe357777b03","stateId":109,"easy":"إذا أشركت أو قتلت نفساً بغير حق أو فررت من الزحف ← فهي من أكبر الكبائر","cause":"الإشراكُ باللهِ وقتلُ النَّفسِ المؤمنةِ بغيرِ الحقِّ والفرارُ في سبيلِ اللهِ يومَ الزَّحفِ وعقوقُ الوالدَيْن ورميُ المُحصَنةِ وتعلُّمُ السِّحرِ وأكلُ الرِّبا وأكلُ مالِ اليتيمِ","result":"وإنَّ أكبرَ الكبائرِ عند اللهِ يومَ القيامةِ","explicit":true,"repOf":"س-04383","ref":"الترغيب والترهيب 2/268","text":["أنَّ رسولَ الله صلَّى اللهُ عليه وسلَّم كتب إلى أهلِ اليمنِ بكتابٍ فيه الفرائضُ والسُّننُ والدِّياتُ فذكر فيه ",["وإنَّ أكبرَ الكبائرِ عند اللهِ يومَ القيامةِ",2]," ",["الإشراكُ باللهِ وقتلُ النَّفسِ المؤمنةِ بغيرِ الحقِّ والفرارُ في سبيلِ اللهِ يومَ الزَّحفِ وعقوقُ الوالدَيْن ورميُ المُحصَنةِ وتعلُّمُ السِّحرِ وأكلُ الرِّبا وأكلُ مالِ اليتيمِ",1]],"grade":"صحيح","narrator":"عمرو بن حزم","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن حبان (6559)، والطبراني في ((الأحاديث الطوال)) (56)، والبيهقي (7336) باختلاف يسير مطولًا.","bab":"إيمان › السحر والنشرة والكهانة","dorar":"Wil81Ksf"},{"id":"س-04380","fp":"98d3546588bc","stateId":109,"easy":"إذا أشركت أو قذفت محصنة أو قتلت أو فررت من الزحف ← فهي من الكبائر","cause":"الإشراكُ باللهِ، و قذفُ المحصنةِ، و قتلُ النفسِ المؤمنةِ، و الفرارُ يومَ الزحفِ، و أكلُ مالِ اليتيمِ، و عقوقُ الوالدَينِ المسلمَينِ، و إِلحادٌ بالبيتِ","result":"الكبائرُ","explicit":true,"repOf":"س-04383","ref":"الجامع الصغير 6434","text":[["الكبائرُ",2]," : ",["الإشراكُ باللهِ،  و قذفُ المحصنةِ،  و قتلُ النفسِ المؤمنةِ،  و الفرارُ يومَ الزحفِ،  و أكلُ مالِ اليتيمِ،  و عقوقُ الوالدَينِ المسلمَينِ،  و إِلحادٌ بالبيتِ",1]," قِبلتِكمْ أحياءً و أمواتًا"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه أبو القاسم البغوي في ((مسند ابن الجعد)) (3303)، والخرائطي في ((مكارم الأخلاق)) (237)، والبيهقي (6805) واللفظ لهم.","bab":"جهاد › التولي والفرار من الزحف","dorar":"5Rma6ISn"},{"id":"س-04389","fp":"0c6e3b50709f","stateId":109,"easy":"إذا سحرت أو فررت من الزحف ← فهي من الكبائر","cause":"السِّحرُ والفِرارُ من الزَّحفِ","result":"من الكبائرِ","explicit":true,"ref":"عارضة الأحوذي 6/127","srcLabel":"ابن الجعد","text":[["السِّحرُ والفِرارُ من الزَّحفِ",1]," [ أيْ ",["من الكبائرِ",2]," ]"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"ثابت","takhrij":"أخرجه ابن الجعد (3303 )، والطبري في ((جامع البيان)) (6/ 648)، والخطيب في ((الكفاية في علم الرواية)) ( 104)","bab":"جهاد › التولي والفرار من الزحف","dorar":"DcVQEL13"},{"id":"س-04390","fp":"90122c826396","stateId":109,"easy":"إذا أشركت أو أكلت مال اليتيم أو عققت والديك ← فهي من الكبائر","cause":"الشرك بًالله ، وأكل مال اليتيم ، وفرار من الزحف ، وقذف المحصنة ، وعقوق الوالدين ، وقول الزور ، والغلول ، والسحر ، وأكل الربًا","result":"ذكروا الكبًائر","explicit":true,"ref":"تفسير الطبري 4/1/61","srcLabel":"تفسير الطبري","text":["أن ناسا من أصحاب رسول اللهِ صلى الله عليه وسلم ",["ذكروا الكبًائر",2]," ، وهو متكئ ، فقالوا : ",["الشرك بًالله ، وأكل مال اليتيم ، وفرار من الزحف ، وقذف المحصنة ، وعقوق الوالدين ، وقول الزور ، والغلول ، والسحر ، وأكل الربًا",1]," ، فقال رسول اللهِ صلى الله عليه وسلم : فأين تجعلون : ?إن الذين يشترون بعهد الله وأيمانهم ثمنا قليلا? إلى آخر الآية"],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"ثابت","takhrij":"لم أقف عليه إلا عند الطبري في التفسير","bab":"جهاد › التولي والفرار من الزحف","dorar":"LqUrIbiR"},{"id":"س-05715","fp":"5994aa5f571b","stateId":109,"easy":"إذا كفرت أو تكبرت ← فهي من أكبر الكبائر","cause":"الكفرُ والكبرُ","result":"أَكبرَ الكبائرِ","explicit":true,"ref":"مجموع الفتاوى 18/330","srcLabel":"مجموع الفتاوى","text":["إنَّ ",["أَكبرَ الكبائرِ",2]," ",["الكفرُ والكبرُ",1]],"grade":"صحيح","muhaddith":"صحيح","bab":"رقائق وزهد › الكبر والتواضع","dorar":"pi22tjYy"},{"id":"س-03771","fp":"416787d01765","stateId":109,"easy":"إذا أشركت أو قتلت أو أكلت الربا أو مال اليتيم ← وقعت في الكبائر التسع","cause":"الإِشراكُ بِاللهِ ، و قتلُ النفسِ بِغيرِ حقٍّ ، و أكلُ الرِّبا ، و أكلُ مالِ اليتيمِ ، و قذْفُ المحصَنَةِ و الفِرارُ يومَ الزَّحْفِ ، و عُقوقُ الوالِدَيْنِ ، و اسْتحلالُ البيتِ الحرامِ","result":"الكبائِرُ تِسْعٌ ، أعظمُهُنَّ","explicit":true,"otherNeedIds":[22],"ref":"صحيح الجامع 4605","srcLabel":"أبو داود","text":[["الكبائِرُ تِسْعٌ ، أعظمُهُنَّ",2]," ",["الإِشراكُ بِاللهِ ، و قتلُ النفسِ بِغيرِ حقٍّ ، و أكلُ الرِّبا ، و أكلُ مالِ اليتيمِ ، و قذْفُ المحصَنَةِ و الفِرارُ يومَ الزَّحْفِ ، و عُقوقُ الوالِدَيْنِ ، و اسْتحلالُ البيتِ الحرامِ",1]," ، قِبلتِكمْ أحياءً و أمْواتًا"],"grade":"حسن","narrator":"عمير بن قتادة الليثي","muhaddith":"حسن","takhrij":"أخرجه أبو داود (2875)، والنسائي (4012) باختلاف يسير.","bab":"الكفر والشرك › ذم الشرك وما ورد فيه من العقوبة","dorar":"axI5DvRw"},{"id":"س-04392","fp":"eff0d46e2746","stateId":109,"easy":"إذا أشركت أو قتلت أو فررت يوم الزحف ← فهي من الكبائر السبع","cause":"إشراكٌ باللهِ ، وقتلُ النَّفسِ بغيرِ حقٍّ ، وفرارٌ يومَ الزَّحفِ","result":"ما الكبائرُ ؟ قال : هنَّ سبعٌ","explicit":true,"repOf":"س-04383","ref":"صحيح النسائي 4023","text":["أنَّ رجلًا قال : يا رسولَ اللهِ ! ",["ما الكبائرُ ؟ قال : هنَّ سبعٌ",2]," ، أعظمُهنَّ ",["إشراكٌ باللهِ ، وقتلُ النَّفسِ بغيرِ حقٍّ ، وفرارٌ يومَ الزَّحفِ",1]],"grade":"حسن","narrator":"عمير بن قتادة الليثي","muhaddith":"حسن","takhrij":"أخرجه النسائي (4012)، واللفظ له، والطبراني في ((المعجم الكبير)) (17/ 47) (101)، والحاكم في ((المستدرك على الصحيحين)) (197)، باختلاف يسير مطولا، وأبو داود (2875)، مختصرا.","bab":"جهاد › التولي والفرار من الزحف","dorar":"7S1Y8Yrl"},{"id":"س-06344","fp":"7be9a4e483c9","stateId":109,"easy":"إذا وليت دبرك يوم الزحف ← بؤت بغضب من الله","cause":"مَنْ وَلَّى","result":"فقد باءَ بغضبٍ مِنَ اللهِ","explicit":true,"otherNeedIds":[28],"ref":"المستدرك على الصحيحين 2456","srcLabel":"الحاكم","text":["أَتيتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ لأُبايِعَهُ على الإسلامِ، فاشْتَرَطَ عَلَيَّ: تَشهَدُ أنْ لا إلَهَ إلَّا اللهُ وأنَّ مُحمَّدًا عبدُهُ ورسولُهُ، وتُصلِّي الخَمْسَ، وتَصومُ رمضانَ، وتُؤدِّي الزَّكاةَ، وتَحُجُّ البيتَ، وتُجاهِدُ في سبيلِ اللهِ، قالَ: قلتُ: يا رسولَ اللهِ، أمَّا اثنتانِ فلا أُطيقُهُما؛ أمَّا الزَّكاةُ فمالي إلَّا عَشْرُ ذَوْدٍ، هُنَّ رُسُلُ أَهْلي وحَمولَتُهُم، وأمَّا الجهادُ فيَزعُمونَ أنَّه ",["مَنْ وَلَّى",1],"؛ ",["فقد باءَ بغضبٍ مِنَ اللهِ",2],"، فأَخافُ إذا حَضَرَني قتالٌ كَرِهْتُ الموتَ، وخَشَعَتْ نَفْسي، قالَ: فقَبَضَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يدَهُ، ثُمَّ حَرَّكَها، ثُمَّ قالَ: لا صَدَقَةَ ولا جهادَ، فبِمَ تَدخُلُ الجنَّةَ؟ قالَ: ثُمَّ قلتُ: يا رسولَ اللهِ، أُبايعُكَ، فبايَعَني عليْهِنَّ كُلِّهنَّ."],"grade":"صحيح","narrator":"ابن الخصاصية","muhaddith":"صحيح الإسناد","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"Fy5wR4SC","merged":2,"otherRefs":["تخريج المسند لشعيب 21952 (حسن)"]},{"id":"س-02777","fp":"042a11a5e28f","stateId":110,"easy":"إذا كنت ذا وجهين ← فلا تصلح أن تكون أميناً","cause":"لذِي الوَجهينِ","result":"لا ينبَغِي لذِي الوَجهينِ أنْ يكونَ أَمينًا","explicit":true,"star":true,"ref":"صحيح الأدب المفرد 238","srcLabel":"البخاري","text":[["لا ينبَغِي لذِي الوَجهينِ أنْ يكونَ أَمينًا",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (313)، والبيهقي (21688) واللفظ لهما، وأخرجه أحمد (7890) باختلاف يسير","bab":"إيمان › النفاق","dorar":"oAw6mb1a"},{"id":"س-07582","fp":"5ebeb8f5bb12","stateId":110,"easy":"إذا جادل المنافق العليم اللسان ← فهو أخوف ما يُخاف عليكم","cause":"جِدالُ المُنافِقِ عليمِ اللِّسانِ","result":"أخوفُ ما أخافُ عليكم","explicit":true,"star":true,"otherNeedIds":[22],"ref":"تخريج صحيح ابن حبان 80","srcLabel":"البخاري","text":[["أخوفُ ما أخافُ عليكم",2]," ",["جِدالُ المُنافِقِ عليمِ اللِّسانِ",1]],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"إسناده صحيح على شرط البخاري","bab":"فضائل النبي وصفته ودلائل النبوة › شفقته على أمته","dorar":"AtcLAMHT"},{"id":"س-05482","fp":"ed1378d340e6","stateId":110,"easy":"إذا صنعت طعام وليمة ثلاثة أيام ← فهو رياء وسمعة","cause":"وطعامُ ثلاثةِ أيامٍ","result":"رياءٌ وسمعةٌ","explicit":true,"ref":"الجامع الصغير 5243","srcLabel":"الطبراني","text":["طعامُ يومٍ في العُرْسِ سُنَّةٌ، وطعامُ يومينِ فضلٌ، ",["وطعامُ ثلاثةِ أيامٍ",1]," ",["رياءٌ وسمعةٌ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (11/151) (11331)","bab":"رقائق وزهد › الرياء والسمعة","dorar":"rlZ9y8wM"},{"id":"س-04867","fp":"463162f7a6d7","stateId":110,"easy":"إذا صرت يُشار إليك بالأصابع في دين أو دنيا ← فحسبك من الشر","cause":"أن يُشارَ إليهِ بالأصابعِ في دينٍ أو دُنيا","result":"بحسب امرئ منَ الشَّرِّ","explicit":true,"ref":"هداية الرواة 5/64","srcLabel":"الترمذي","text":[["بحسب امرئ منَ الشَّرِّ",2]," ",["أن يُشارَ إليهِ بالأصابعِ في دينٍ أو دُنيا",1]," إلَّا من عصمَه اللَّهُ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه الترمذي معلقاً بصيغة التضعيف بعد حديث (2453) واللفظ له، وأخرجه موصولاً باختلاف يسير ابن وهب في ((الجامع)) (481)، وابن أبي الدنيا في ((التواضع والخمول)) (30).","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"XlzW7MNq"},{"id":"س-02222","fp":"3b97e4a940ee","stateId":110,"easy":"إذا أقمت الوليمة اليوم الثالث ← فهي سمعة ورياء","cause":"واليومُ الثَّالثُ","result":"سُمعةٌ ورياءٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"الإصابة في تمييز الصحابة 1/554","srcLabel":"أبو داود","text":["حديثُ زهيرِ بنِ عثمانَ الثَّقفيِّ في الوليمَةِ [يعني حديث: الوَليمةُ أوَّلَ يومٍ حقٌّ، والثَّاني معروفٌ، ",["واليومُ الثَّالثُ",1]," ",["سُمعةٌ ورياءٌ",2],"]"],"grade":"حسن","narrator":"زهير بن عثمان","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه أبو داود (3745)، وأحمد (20325)، والدارمي (2109) واللفظ لهم تامًا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"t9x0hJPc","merged":2,"otherRefs":["الجامع الصغير 9673 (حسن)"]},{"id":"س-06380","fp":"706201ec5191","stateId":111,"easy":"إذا سننت في الإسلام سيئة ← عليك وزرها ووزر من عمل بها بعدك","cause":"ومَن سنَّ في الإسلامِ سَيِّئةً","result":"كانَ علَيهِ وزرُها ، و [ مِثلُ ] وِزرِ مَن عمِلَ بِها من بعدِه، من غيرِ أن ينقُصَ مِن أوزارِهم شيءٌ","explicit":true,"star":true,"ref":"أحكام الجنائز 225","srcLabel":"مسلم","text":["كنَّا عندَ رسولِ اللهِ صلَّى اللهُ علَيهِ وسلَّمَ في صدرِ النَّهار، فجاءَه أقوُمٌ حُفاةٌ عُراةٌ مُجتابي النِّمارِ أوِ العَباءِ، متقلِّدي السُّيوفِ ، [ ولَيس عليهِم أُزُرٌ ولا شَيءٌ غيرَها ] عامَّتُهم من مُضَر، بل كلُّهُم مِن مُضَرَ فتمعَّرَ ( وفي روايةٍ : فتغيَّرَ ومعناهُما واحِدٌ ) وجهُ رسولِ اللهِ صلَّى اللهُ علَيهِ وسلَّمَ لما رأى بِهم منَ الفاقةِ، فدخلَ ثمَّ خرجَ، فأمرَ بلالًا فأذَّنَ وصلَّى [ الظُّهرَ ، ثم صعِدَ منبرًا صغيرًا ] ، فصلَّى ثمَّ خطبَ [ فحمِدَ اللهَ وأثنَى علَيهِ ] فقال : [ أمَّا بعدُ فإنَّ اللهَ أنزلَ في كتابِهِ ] :  يَا أَيُّهَا النَّاسُ اتَّقُوا رَبَّكُمُ الَّذِي خَلَقَكُمْ مِنْ نَفْسٍ وَاحِدَةٍ وَخَلَقَ مِنْهَا زَوْجَهَا وَبَثَّ مِنْهُمَا رِجَالًا كَثِيرًا وَنِسَاءً وَاتَّقُوا اللَّهَ الَّذِي تَسَاءَلُونَ بهِ وَالْأَرْحَامَ إِنَّ اللَّهَ كَانَ عَلَيْكُمْ رَقِيبًا والآيةُ الَّتي في الحَشرِ  يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَلْتَنْظُرْ نَفْسٌ مَا قَدَّمَتْ لِغَدٍ وَاتَّقُوا اللَّهَ إِنَّ اللَّهَ خَبِيرٌ بِمَا تَعْمَلُونَ . [وَلَا تَكُونُوا كَالَّذِينَ نَسُوا اللَّهَ فَأَنْسَاهُمْ أَنْفُسَهُمْ أُولَئِكَ هُمُ الْفَاسِقُونَ . لَا يَسْتَوِي أَصْحَابُ النَّارِ وَأَصْحَابُ الْجَنَّةِ أَصْحَابُ الْجَنَّةِ هُمُ الْفَائِزُونَ . تصدَّقوا قبلَ أن يُحالَ بينَكُم وبينَ الصَّدَقةِ ] ، تصدَّقَ رجلٌ من دينارِه، من درهمِه، من ثَوبِه، من صاعِ برِّهِ ، [ مِن شعيرِهِ ] ، مِن صاعِ تمرِه حتَّى قالَ : [ ولا يحقِرَنَّ أحدُكُم شيئًا من الصَّدَقةِ ، ولَو بِشقِّ تمرةٍ ، [ فأبطَؤوا حتَّى بانَ في وجهِهِ الغضَبُ ] ، قال فجاءَ رجلٌ منَ الأنصارِ بصُرَّةٍ من وَرِق ( وفي روايةٍ : مِن ذهَبٍ ) كادَت كفُّهُ تعجِزُ عنها، بل قد عَجَزَت [ فناولَها رسولَ اللهِ صلَّى اللهُ علَيهِ وسلَّمَ وهو علَى مِنبرِهِ ] ، [ فقال : يا رسولَ اللهِ هذِهِ في سبيلِ اللَّهِ ] ، [ فقبضَها رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ ] ، [ ثمَّ قامَ أبو بكرٍ فأعطى ، ثمَّ قامَ عمرُ فأَعطى ، ثم قامَ المهاجِرونَ والأنصارُ فأعطَوا ] ، ثم تتابعَ النَّاسُ [ في الصَّدقاتِ ] ، [ فمِن ذي دينارٍ ، ومِن ذي درهَمٍ ، ومِن ذي ، ومِن ذي ] حتَّى رأيتُ كَومينِ من طَعامٍ وثيابٍ، حتَّى رأيتُ وجهَ رسولِ اللهِ صلَّى اللهُ علَيهِ وسلَّمَ يتَهلَّلُ، كأنَّهُ مُذهبةٌ، فقالَ رسولُ اللهِ صلَّى اللهُ علَيهِ وسلَّمَ: مَن سنَّ في الإسلامِ سُنَّةً حَسنةً، فلَه أجرُها، و[ مثلُ ] أجرِ مَن عمِلَ بِها بعدَهُ، مِن غيرِ أن ينقُصَ مِن أجورِهم شيءٌ، ",["ومَن سنَّ في الإسلامِ سَيِّئةً، ",1],["كانَ علَيهِ وزرُها ، و [ مِثلُ ] وِزرِ مَن عمِلَ بِها من بعدِه، من غيرِ أن ينقُصَ مِن أوزارِهم شيءٌ",2]," ، [ ثمَّ تلى هذِه الآيةَ :  وَنَكتُبُ مَا قَدَّمُوا وَآثَارَهُمْ ] ، [ قال : فقسَمهُ بينَهُم ] ."],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"أخرجه مسلم وابن أبي حاتم والزيادة التي قبل الأخيرة له، وإسنادها صحيح، وللترمذي وصححه الجملتان اللتان قبل الزيادة المشار إليها مع الزيادتين فيهما","takhrij":"أخرجه مسلم (1017)، والنسائي (2554)، وأحمد (19174)، والطيالسي (705)، والبيهقي (7816 )   .","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"VSNRsPPW","merged":3,"otherRefs":["صحيح مسلم 1017 (صحيح)","صحيح ابن خزيمة 4/ 189 (صحيح)"]},{"id":"س-06245","fp":"749de8e86286","stateId":111,"easy":"إذا سننت سنة سيئة فعُمل بها ← عليك مثل أوزار من عمل بها","cause":"ومَن سَنَّ في الإسلامِ سُنَّةً سَيِّئةً، فعُمِلَ بها بَعدَهُ","result":"كان عليه مِثلُ أوزارِهم، مِن غَيرِ أنْ يُنتَقَصَ مِن أوزارِهم شيءٌ","explicit":true,"similar":["س-05076","س-06249"],"ref":"تخريج المسند لشعيب 19183","srcLabel":"مسلم","text":["أنَّ رَجُلًا مِنَ الأنصارِ جاءَ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ بِصُرَّةٍ مِن ذَهَبٍ تَملَأُ ما بَينَ أصابِعِهِ، فقالَ: هذه في سَبيلِ اللهِ عزَّ وجلَّ. ثم قامَ أبو بكرٍ رَضيَ اللهُ عنهُ، فأعطَوْا، فأعطى، ثم قامَ عُمَرُ رَضيَ اللهُ عنهُ فأعطى، ثم قامَ المُهاجِرونَ فأعطَوْا. قالَ: فأشرَقَ وَجْهُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ حتى رَأيتُ الإشراقَ في وَجنَتَيْهِ، ثم قال: مَن سَنَّ سُنَّةً صالِحةً في الإسلامِ، فعُمِلَ بها بَعدَهُ، كانَ له مِثلُ أجورِهم، مِن غَيرِ أنْ يُنتَقَصَ مِن أُجورِهم شيءٌ، ",["ومَن سَنَّ في الإسلامِ سُنَّةً سَيِّئةً، فعُمِلَ بها بَعدَهُ، ",1],["كان عليه مِثلُ أوزارِهم، مِن غَيرِ أنْ يُنتَقَصَ مِن أوزارِهم شيءٌ",2],"."],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1017) مطولاً، وأحمد (19183) واللفظ له","bab":"صدقة › صدقة العلانية","dorar":"iSZ6vDKS","merged":2,"otherRefs":["صحيح ابن ماجه 173 (صحيح)"]},{"id":"س-02350","fp":"95aebea14a3e","stateId":111,"easy":"إذا سننت سنة شر فاتُّبعت ← عليك وزرها ومثل أوزار من تبعك","cause":"ومن سنَّ سنَّةَ شرٍّ فاتُّبعَ عليْها","result":"كانَ عليْهِ وزرُهُ ومثلُ أوزارِ من اتَّبعَهُ غيرَ منقوصٍ من أوزارِهم شيئًا","explicit":true,"similar":["س-06339","س-02961"],"ref":"صحيح الترمذي 2675","srcLabel":"مسلم","text":["من سنَّ سُنَّةَ خيرٍ فاتُّبعَ عليْها فلَهُ أجرُهُ ومثلُ أجورِ من اتَّبعَهُ غيرَ منقوصٍ من أجورِهم شيئًا ، ",["ومن سنَّ سنَّةَ شرٍّ فاتُّبعَ عليْها ، ",1],["كانَ عليْهِ وزرُهُ ومثلُ أوزارِ من اتَّبعَهُ غيرَ منقوصٍ من أوزارِهم شيئًا",2]],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2675) واللفظ له، ومسلم (1017) بنحوه وفيه قصة، وابن ماجة (203) بنحوه.","bab":"إحسان › الحسنات والسيئات","dorar":"uJX5MiDv"},{"id":"س-02352","fp":"dbf8e17838ea","stateId":111,"easy":"إذا دعوت إلى ضلالة ← عليك مثل آثام من تبعك","cause":"ومَن دعا إلى ضلالةٍ","result":"كان عليه من الإثمِ ، مِثْلُ آثامِ مَن تَبِعَه ، لا يَنْقُصُ ذلك من آثامِهِم شيئًا","explicit":true,"similar":["س-03749"],"ref":"صحيح الجامع 6234","srcLabel":"مسلم","text":["مَن دعا إلى هُدًى ، كان له من الأجرِ مِثْلُ أجورِ مَن تَبِعَه ، لا يَنْقُصُ ذلك من أجورِهِم شيئًا ، ",["ومَن دعا إلى ضلالةٍ ، ",1],["كان عليه من الإثمِ ، مِثْلُ آثامِ مَن تَبِعَه ، لا يَنْقُصُ ذلك من آثامِهِم شيئًا",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2674)","bab":"إحسان › الحسنات والسيئات","dorar":"GB4lzl61"},{"id":"س-05076","fp":"54e078217f67","stateId":111,"easy":"إذا سننت سنة سيئة فعُمل بها ← عليك وزرها ووزر من عمل بها","cause":"ومَن سنَّ سُنَّةً سيِّئةً فعُمِل بها مِن بعدِه","result":"كان عليه وِزْرُها ووِزْرُ مَن عمِل بها مِن بعدِه","explicit":true,"repOf":"س-06245","ref":"تخريج صحيح ابن حبان 3308","text":["كنَّا عندَ النَّبيِّ صلَّى اللهُ عليه وسلَّم مِن صدرِ النَّهارِ فجاء قومٌ حفاةٌ عراةٌ مُجتابِي النِّمارِ عليهم سيوفٌ، عامَّتُهم مِن مُضَرَ بل كلُّهم مِن مُضَرَ فرأَيْتُ وجهَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم تغيَّر لِما رأى منهم مِن الفاقةِ قال: فدخَل فأمَر بلالًا فأذَّن ثمَّ أقام فخرَج فصلَّى ثمَّ قال: ({يَا أَيُّهَا النَّاسُ اتَّقُوا رَبَّكُمُ الَّذِي خَلَقَكُمْ مِنْ نَفْسٍ وَاحِدَةٍ وَخَلَقَ مِنْهَا زَوْجَهَا وَبَثَّ مِنْهُمَا رِجَالًا كَثِيرًا وَنِسَاءً وَاتَّقُوا اللَّهَ الَّذِي تَسَاءَلُونَ بِهِ وَالْأَرْحَامَ إِنَّ اللَّهَ كَانَ عَلَيْكُمْ رَقِيبًا} [النساء: 1]، {اتَّقُوا اللَّهَ وَلْتَنْظُرْ نَفْسٌ مَا قَدَّمَتْ لِغَدٍ} [الحشر: 18] يتصدَّقُ امرؤٌ مِن دينارِه ومِن درهمِه ومِن ثوبِه ومِن صاعِ بُرِّه ومِن صاعِ شعيرِه ) حتَّى ذكَر شِقَّ تمرةٍ فجاء رجلٌ منِ الأنصارِ بصُرَّةٍ كادت تعجِزُ كفَّاه بل قد عجَزَت ثمَّ تتابَع النَّاسُ حتَّى رأَيْتُ بينَ يدَيْ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم كَوْمَيْنِ مِن الثِّيابِ والطَّعامِ فلقد رأَيْتُ وجهَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم تهلَّل حتَّى كأنَّه مُذْهَبةٌ ثمَّ قال: ( مَن سنَّ في الإسلامِ سُنَّةً حسَنةً فعُمِل بها مِن بعدِه كان له أجرُها وأجرُ مَن يعمَلُ بها مِن بعدِه ",["ومَن سنَّ سُنَّةً سيِّئةً فعُمِل بها مِن بعدِه ",1],["كان عليه وِزْرُها ووِزْرُ مَن عمِل بها مِن بعدِه )",2]],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن حبان (3308) بلفظه،  ومسلم (1017)، والنسائي (2554)، وأحمد (19174) جميعا بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"DCtXBo5K"},{"id":"ق-0664","fp":"d3ce2c21eb8f","stateId":111,"easy":"إضلال الناس بغير علم ← حمل أوزاره كاملة وأوزار من أضلّهم","cause":"إضلال الناس بغير علم","result":"حمل أوزاره كاملة وأوزار من أضلّهم","explicit":true,"otherNeedIds":[70],"ref":"سورة النحل: 25","srcLabel":"القرآن الكريم","quran":{"s":16,"from":25,"to":25,"text":"لِيَحْمِلُوا أَوْزَارَهُمْ كَامِلَةً يَوْمَ الْقِيَامَةِ وَمِنْ أَوْزَارِ الَّذِينَ يُضِلُّونَهُمْ بِغَيْرِ عِلْمٍ أَلَا سَاءَ مَا يَزِرُونَ (25)","hl":[[0,140,1]]}},{"id":"ق-0937","fp":"9b3dd08f0744","stateId":111,"easy":"إضلال الناس والوعد بتحمل خطاياهم ← حمل أثقاله وأثقال مع أثقاله","cause":"إضلال الناس والوعد بتحمل خطاياهم","result":"حمل أثقاله وأثقال مع أثقاله","explicit":true,"otherNeedIds":[70],"ref":"سورة العنكبوت: 12–13","srcLabel":"القرآن الكريم","quran":{"s":29,"from":12,"to":13,"text":"وَقَالَ الَّذِينَ كَفَرُوا لِلَّذِينَ آمَنُوا اتَّبِعُوا سَبِيلَنَا وَلْنَحْمِلْ خَطَايَاكُمْ وَمَا هُمْ بِحَامِلِينَ مِنْ خَطَايَاهُمْ مِنْ شَيْءٍ إِنَّهُمْ لَكَاذِبُونَ (12) وَلَيَحْمِلُنَّ أَثْقَالَهُمْ وَأَثْقَالًا مَعَ أَثْقَالِهِمْ وَلَيُسْأَلُنَّ يَوْمَ الْقِيَامَةِ عَمَّا كَانُوا يَفْتَرُونَ (13)","hl":[[0,300,1]]}},{"id":"س-06339","fp":"bcbfe3264242","stateId":111,"easy":"إذا سننت شراً فاتُّبع ← عليك وزره ومثل أوزار من تبعك","cause":"ومَنِ استَنَّ شرًّا فاستُنَّ به","result":"فعليه وِزرُهُ، ومثلُ أوزارِ مَنِ اتَّبعَهُ غيرَ مُنتقِصٍ مِن أوْزارِهِم شيئًا","explicit":true,"repOf":"س-02350","ref":"المستدرك على الصحيحين 3954","text":["قامَ سائلٌ على عهدِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فسَأَلَ فسَكَتَ القومُ، ثُمَّ إنَّ رَجلًا أعطاهُ، فأعطاهُ القومُ، فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: «مَنِ استَنَّ خيرًا فاستُنَّ به فله أجرُهُ، ومِثلُ أجورِ مَنِ اتَّبعَهُ غيرَ مُنتقِصٍ مِن أُجُورِهِم، ",["ومَنِ استَنَّ شرًّا فاستُنَّ به ",1],["فعليه وِزرُهُ، ومثلُ أوزارِ مَنِ اتَّبعَهُ غيرَ مُنتقِصٍ مِن أوْزارِهِم شيئًا»",2],". قالَ: وتلا حُذَيْفةُ بنُ اليَمانِ: {عَلِمَتْ نَفْسٌ مَا قَدَّمَتْ وَأَخَّرَتْ} [الانفطار: 5]."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح الإسناد","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"ymU0ouRX","merged":3,"otherRefs":["تخريج المسند لشعيب 23289 (صحيح)","الترغيب والترهيب 1/69 (صحيح)"]},{"id":"س-02961","fp":"d49a2a446d62","stateId":111,"easy":"إذا سننت سنة ضلال فاتُّبعت ← عليك مثل أوزار من تبعك","cause":"مَن سَنَّ سُنَّةَ ضَلالٍ فاتُّبِعَ عليها","result":"كان عليه مِثْلُ أوزارِهم مِن غَيرِ أنْ يَنقُصَ مِن أوزارِهم شيءٌ","explicit":true,"repOf":"س-02350","ref":"تخريج المسند لشعيب 10556","text":[["مَن سَنَّ سُنَّةَ ضَلالٍ فاتُّبِعَ عليها، ",1],["كان عليه مِثْلُ أوزارِهم مِن غَيرِ أنْ يَنقُصَ مِن أوزارِهم شيءٌ، ",2],"ومَن سَنَّ سُنَّةَ هُدًى فاتُّبِعَ عليها؛ كان له مِثْلُ أُجورِهم مِن غَيرِ أنْ يَنقُصَ مِن أُجورِهم شيءٌ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (204)، وأحمد (10556) واللفظ له","bab":"إيمان › الوعيد","dorar":"TYKf3yEN"},{"id":"س-03666","fp":"4d72a3b1ee7e","stateId":111,"easy":"إذا ابتدعت بدعة فعُمل بها ← عليك أوزار من عمل بها","cause":"ومن ابتدعَ بدعةً ، فعمِلَ بِها","result":"كانَ عليهِ أوزارُ مَن عملَ بِها ، لا ينقُصُ مِن أوزارِ من عملَ بِها شيئًا","explicit":true,"similar":["س-06996"],"ref":"صحيح ابن ماجه 174","srcLabel":"الترمذي","text":["مَن أحيا سنَّةً من سنَّتي ، فعملَ بِها النَّاسُ ، كانَ لَهُ مثلُ أجرِ من عَمِلَ بِها ، لا يَنقصُ مِن أجورِهِم شيئًا ، ",["ومن ابتدعَ بدعةً ، فعمِلَ بِها",1]," ، ",["كانَ عليهِ أوزارُ مَن عملَ بِها ، لا ينقُصُ مِن أوزارِ من عملَ بِها شيئًا",2]],"grade":"صحيح","narrator":"عمرو بن عوف المزني","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (2677)، وابن ماجه (209) واللفظ له.","bab":"اعتصام بالسنة › الأمر بالتمسك بالكتاب والسنة","dorar":"I69gRFWy"},{"id":"س-03749","fp":"e748c5068df2","stateId":111,"easy":"إذا دعوت إلى ضلالة فاتُّبعت ← عليك مثل أوزار من تبعك","cause":"أيُّما داٍع دعا إلى ضلالةٍ فاتُّبِع","result":"فإنَّ عليه مِثلَ أوزارِ مَن اتَّبَعَه، ولا يَنقُصُ مِن أوزارِهم شيئًا","explicit":true,"repOf":"س-02352","ref":"الجامع الصغير 2996","text":[["أيُّما داٍع دعا إلى ضلالةٍ فاتُّبِع، ",1],["فإنَّ عليه مِثلَ أوزارِ مَن اتَّبَعَه، ولا يَنقُصُ مِن أوزارِهم شيئًا، ",2],"أيُّما داٍع دعا إلى الهدى فاتُّبِع، فإنَّ له مِثلَ أجورِ مَن اتَّبَعَه، ولا يَنقُصُ مِن أجورِهم شَيئًا."],"grade":"صحيح","narrator":"أنس","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجة (205)، وابن بشران في ((أماليه-الجزء الأول)) (242) باختلاف يسير.","bab":"اعتصام بالسنة › مخالفة السنة","dorar":"7fbKIhAl"},{"id":"س-06249","fp":"c75491eb2779","stateId":111,"easy":"إذا استننت سنة سيئة فتبعك الناس ← عليك وزرها ومثل أوزارهم","cause":"ومنِ استنَّ سنَّةً سيِّئةً فاستنَّ بِهِ","result":"فعليهِ وزرُهُ كاملًا ، ومِن أوزارِ الَّذي استنَّ بِهِ ، ولا ينقصُ من أوزارِهِم","explicit":true,"repOf":"س-06245","ref":"صحيح ابن ماجه 170","text":["جاءَ رجلٌ إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ: فحثَّ عليهِ ، فقالَ رجُلٌ ، عندي كذا وَكَذا ، قالَ ، فما بقيَ في المَجلسِ رجلٌ إلَّا تصدَّقَ عليهِ بما قلَّ أو كثرَ ، فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: منِ استنَّ خيرًا فاستنَّ بِهِ ، كانَ لَهُ أجرُهُ كاملًا ، ومِن أجورِ منِ استنَّ بِهِ ، ولا يَنقُصُ من أجورِهِم شيئًا ، ",["ومنِ استنَّ سنَّةً سيِّئةً فاستنَّ بِهِ",1]," ، ",["فعليهِ وزرُهُ كاملًا ، ومِن أوزارِ الَّذي استنَّ بِهِ ، ولا ينقصُ من أوزارِهِم",2]," شيئًا"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (204) واللفظ له، وأحمد (10759)","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"pTvMewrx"},{"id":"س-03187","fp":"7af78558a6ca","stateId":111,"easy":"إذا كنت سبب ضلال قومك ← فعليك إثمهم","cause":"فإنْ تَوَلَّيْتَ","result":"فإنَّ عَلَيْكَ إثْمَ الأرِيسِيِّينَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"أضواء البيان 3/577","srcLabel":"أضواء البيان","text":["حديثُ هِرَقلَ لقد أمِر أمرُ ابنِ أبي كَبشةَ إنه لَيَخافُه ملِكُ بني الأصفَرِ [يعني حديث: انْطَلَقْتُ في المُدَّةِ الَّتي كَانَتْ بَيْنِي وبيْنَ رَسولِ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ، قَالَ: فَبيْنَا أنَا بالشَّأْمِ، إذْ جِيءَ بكِتَابٍ مِنَ النبيِّ صَلَّى اللهُ عليه وسلَّمَ إلى هِرَقْلَ ، قَالَ: وكانَ دَحْيَةُ الكَلْبِيُّ جَاءَ به، فَدَفَعَهُ إلى عَظِيمِ بُصْرَى، فَدَفَعَهُ عَظِيمُ بُصْرَى إلى هِرَقْلَ ، قَالَ: فَقَالَ هِرَقْلُ: هلْ هَا هُنَا أحَدٌ مِن قَوْمِ هذا الرَّجُلِ الذي يَزْعُمُ أنَّه نَبِيٌّ؟ فَقالوا: نَعَمْ، قَالَ: فَدُعِيتُ في نَفَرٍ مِن قُرَيْشٍ، فَدَخَلْنَا علَى هِرَقْلَ فَأُجْلِسْنَا بيْنَ يَدَيْهِ، فَقَالَ: أيُّكُمْ أقْرَبُ نَسَبًا مِن هذا الرَّجُلِ الذي يَزْعُمُ أنَّه نَبِيٌّ؟ فَقَالَ أبو سُفْيَانَ: فَقُلتُ: أنَا، فأجْلَسُونِي بيْنَ يَدَيْهِ، وأَجْلَسُوا أصْحَابِي خَلْفِي، ثُمَّ دَعَا بتَرْجُمَانِهِ، فَقَالَ: قُلْ لهمْ: إنِّي سَائِلٌ هذا عن هذا الرَّجُلِ الذي يَزْعُمُ أنَّه نَبِيٌّ، فإنْ كَذَبَنِي فَكَذِّبُوهُ، قَالَ أبو سُفْيَانَ: وايْمُ اللَّهِ ، لَوْلَا أنْ يُؤْثِرُوا عَلَيَّ الكَذِبَ لَكَذَبْتُ، ثُمَّ قَالَ: لِتَرْجُمَانِهِ، سَلْهُ كيفَ حَسَبُهُ فِيكُمْ؟ قَالَ: قُلتُ: هو فِينَا ذُو حَسَبٍ، قَالَ: فَهلْ كانَ مِن آبَائِهِ مَلِكٌ؟ قَالَ: قُلتُ: لَا، قَالَ: فَهلْ كُنْتُمْ تَتَّهِمُونَهُ بالكَذِبِ قَبْلَ أنْ يَقُولَ ما قَالَ؟ قُلتُ: لَا، قَالَ: أيَتَّبِعُهُ أشْرَافُ النَّاسِ أمْ ضُعَفَاؤُهُمْ؟ قَالَ: قُلتُ: بَلْ ضُعَفَاؤُهُمْ، قَالَ: يَزِيدُونَ أوْ يَنْقُصُونَ؟ قَالَ: قُلتُ لا بَلْ يَزِيدُونَ، قَالَ: هلْ يَرْتَدُّ أحَدٌ منهمْ عن دِينِهِ بَعْدَ أنْ يَدْخُلَ فيه سَخْطَةً له؟ قَالَ: قُلتُ: لَا، قَالَ: فَهلْ قَاتَلْتُمُوهُ؟ قَالَ: قُلتُ: نَعَمْ، قَالَ: فَكيفَ كانَ قِتَالُكُمْ إيَّاهُ؟ قَالَ: قُلتُ: تَكُونُ الحَرْبُ بيْنَنَا وبيْنَهُ سِجَالًا يُصِيبُ مِنَّا ونُصِيبُ منه، قَالَ: فَهلْ يَغْدِرُ؟ قَالَ: قُلتُ: لَا، ونَحْنُ منه في هذِه المُدَّةِ لا نَدْرِي ما هو صَانِعٌ فِيهَا، قَالَ: واللَّهِ ما أمْكَنَنِي مِن كَلِمَةٍ أُدْخِلُ فِيهَا شيئًا غيرَ هذِه، قَالَ: فَهلْ قَالَ هذا القَوْلَ أحَدٌ قَبْلَهُ؟ قُلتُ: لَا، ثُمَّ قَالَ لِتُرْجُمَانِهِ: قُلْ له: إنِّي سَأَلْتُكَ عن حَسَبِهِ فِيكُمْ، فَزَعَمْتَ أنَّه فِيكُمْ ذُو حَسَبٍ، وكَذلكَ الرُّسُلُ تُبْعَثُ في أحْسَابِ قَوْمِهَا، وسَأَلْتُكَ: هلْ كانَ في آبَائِهِ مَلِكٌ، فَزَعَمْتَ أنْ لَا، فَقُلتُ: لو كانَ مِن آبَائِهِ مَلِكٌ، قُلتُ: رَجُلٌ يَطْلُبُ مُلْكَ آبَائِهِ، وسَأَلْتُكَ عن أتْبَاعِهِ أضُعَفَاؤُهُمْ أمْ أشْرَافُهُمْ، فَقُلْتَ: بَلْ ضُعَفَاؤُهُمْ، وهُمْ أتْبَاعُ الرُّسُلِ ، وسَأَلْتُكَ: هلْ كُنْتُمْ تَتَّهِمُونَهُ بالكَذِبِ قَبْلَ أنْ يَقُولَ ما قَالَ، فَزَعَمْتَ أنْ لَا، فَعَرَفْتُ أنَّه لَمْ يَكُنْ لِيَدَعَ الكَذِبَ علَى النَّاسِ، ثُمَّ يَذْهَبَ فَيَكْذِبَ علَى اللَّهِ، وسَأَلْتُكَ هلْ يَرْتَدُّ أحَدٌ منهمْ عن دِينِهِ بَعْدَ أنْ يَدْخُلَ فيه سَخْطَةً له، فَزَعَمْتَ أنْ لَا، وكَذلكَ الإيمَانُ إذَا خَالَطَ بَشَاشَةَ القُلُوبِ، وسَأَلْتُكَ هلْ يَزِيدُونَ أمْ يَنْقُصُونَ، فَزَعَمْتَ أنَّهُمْ يُزِيدُونَ وكَذلكَ الإيمَانُ حتَّى يَتِمَّ، وسَأَلْتُكَ: هلْ قَاتَلْتُمُوهُ فَزَعَمْتَ أنَّكُمْ قَاتَلْتُمُوهُ، فَتَكُونُ الحَرْبُ بيْنَكُمْ وبيْنَهُ سِجَالًا يَنَالُ مِنكُم وتَنَالُونَ منه، وكَذلكَ الرُّسُلُ تُبْتَلَى ثُمَّ تَكُونُ لهمُ العَاقِبَةُ، وسَأَلْتُكَ هلْ يَغْدِرُ فَزَعَمْتَ أنَّه لا يَغْدِرُ، وكَذلكَ الرُّسُلُ لا تَغْدِرُ، وسَأَلْتُكَ: هلْ قَالَ أحَدٌ هذا القَوْلَ قَبْلَهُ، فَزَعَمْتَ أنْ لَا، فَقُلتُ: لو كانَ قَالَ هذا القَوْلَ أحَدٌ قَبْلَهُ، قُلتُ: رَجُلٌ ائْتَمَّ بقَوْلٍ قيلَ قَبْلَهُ، قَالَ: ثُمَّ قَالَ: بمَ يَأْمُرُكُمْ؟ قَالَ: قُلتُ: يَأْمُرُنَا بالصَّلَاةِ والزَّكَاةِ والصِّلَةِ والعَفَافِ، قَالَ: إنْ يَكُ ما تَقُولُ فيه حَقًّا، فإنَّه نَبِيٌّ، وقدْ كُنْتُ أعْلَمُ أنَّه خَارِجٌ، ولَمْ أكُ أظُنُّهُ مِنكُمْ، ولو أنِّي أعْلَمُ أنِّي أخْلُصُ إلَيْهِ لَأَحْبَبْتُ لِقَاءَهُ، ولو كُنْتُ عِنْدَهُ لَغَسَلْتُ عن قَدَمَيْهِ، ولَيَبْلُغَنَّ مُلْكُهُ ما تَحْتَ قَدَمَيَّ، قَالَ: ثُمَّ دَعَا بكِتَابِ رَسولِ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ فَقَرَأَهُ: فَإِذَا فيه بسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ مِن مُحَمَّدٍ رَسولِ اللَّهِ إلى هِرَقْلَ عَظِيمِ الرُّومِ ، سَلَامٌ علَى مَنِ اتَّبَعَ الهُدَى، أمَّا بَعْدُ: فإنِّي أدْعُوكَ بدِعَايَةِ الإسْلَامِ، أسْلِمْ تَسْلَمْ، وأَسْلِمْ يُؤْتِكَ اللَّهُ أجْرَكَ مَرَّتَيْنِ، ",["فإنْ تَوَلَّيْتَ",1]," ",["فإنَّ عَلَيْكَ إثْمَ الأرِيسِيِّينَ",2]," ، و: {يَا أهْلَ الكِتَابِ تَعَالَوْا إلى كَلِمَةٍ سَوَاءٍ بيْنَنَا وبيْنَكُمْ، أنْ لا نَعْبُدَ إلَّا اللَّهَ} إلى قَوْلِهِ: {اشْهَدُوا بأنَّا مُسْلِمُونَ} فَلَمَّا فَرَغَ مِن قِرَاءَةِ الكِتَابِ، ارْتَفَعَتِ الأصْوَاتُ عِنْدَهُ وكَثُرَ اللَّغَطُ ، وأُمِرَ بنَا فَأُخْرِجْنَا، قَالَ: فَقُلتُ لأصْحَابِي حِينَ خَرَجْنَا: لقَدْ أمِرَ أمْرُ ابْنِ أبِي كَبْشَةَ، إنَّه لَيَخَافُهُ مَلِكُ بَنِي الأصْفَرِ، فَما زِلْتُ مُوقِنًا بأَمْرِ رَسولِ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ أنَّه سَيَظْهَرُ حتَّى أدْخَلَ اللَّهُ عَلَيَّ الإسْلَامَ، قَالَ الزُّهْرِيُّ: فَدَعَا هِرَقْلُ عُظَمَاءَ الرُّومِ فَجَمعهُمْ في دَارٍ له، فَقَالَ: يا مَعْشَرَ الرُّومِ، هلْ لَكُمْ في الفلاحِ والرَّشَدِ آخِرَ الأبَدِ، وأَنْ يَثْبُتَ لَكُمْ مُلْكُكُمْ، قَالَ: فَحَاصُوا حَيْصَةَ حُمُرِ الوَحْشِ إلى الأبْوَابِ، فَوَجَدُوهَا قدْ غُلِّقَتْ، فَقَالَ: عَلَيَّ بهِمْ، فَدَعَا بهِمْ فَقَالَ: إنِّي إنَّما اخْتَبَرْتُ شِدَّتَكُمْ علَى دِينِكُمْ، فقَدْ رَأَيْتُ مِنْكُمُ الذي أحْبَبْتُ فَسَجَدُوا له ورَضُوا عنْه.]"],"grade":"صحيح","narrator":"[أبو سفيان بن حرب]","muhaddith":"صحيح","bab":"إيمان › دعوة الكافر إلى الإسلام","dorar":"t0gRurVe"},{"id":"س-06996","fp":"4125e688d681","stateId":111,"easy":"إذا ابتدعت بدعة ضلالة ← عليك مثل آثام من عمل بها","cause":"ومَنِ ابْتدَعَ بِدعةً ضَلالَةً لا يَرْضَاها اللهُ ورسولُهُ","result":"كان عليه مِثلُ آثامِ مَن عَمِلَ بِها","explicit":true,"repOf":"س-03666","ref":"سنن الترمذي 2677","text":["أنَّ النبيَّ صلَّى اللهُ عليه وسَلَّمَ قال لِبِلالِ بنِ الحارِثِ اعْلَمْ قال : ما أعْلَمُ يا رسولَ اللهِ ؟ قال إنَّهُ مَنْ أحْيا سُنَّةً من سُنَّتِي قدْ أُمِيتَتْ بَعدِي فإنَّ لهُ من الأجرِ مِثلَ مَنْ عَمِلَ بِها من غَيرِ أنْ يَنْقُصَ من أُجُورِهِمْ شيئٌ ",["ومَنِ ابْتدَعَ بِدعةً ضَلالَةً لا يَرْضَاها اللهُ ورسولُهُ",1]," ",["كان عليه مِثلُ آثامِ مَن عَمِلَ بِها",2]," لا يُنقِصُ ذلِك من أوزارِ الناسِ ( في روايةٍ من آثامِ النَّاسِ ) شيئًا"],"grade":"حسن","narrator":"عمرو بن عوف المزني","muhaddith":"حسن","takhrij":"أخرجه ابن عدي في ((الكامل)) (7/ 193) واللفظ له ، وابن ماجه (210) ، والطبراني (17/ 16) (10) كلاهما بنحوه .","bab":"علم › الحث على الأخذ بالسنة","dorar":"x6C86RhP"},{"id":"س-08066","fp":"6ac62f6f4aea","stateId":111,"easy":"إذا سننت سنة سيئة ← فعليك إثمها حتى تُترك","cause":"ومن سنَّ سنَّةً سيِّئةً","result":"فعليْهِ إثمُها حتَّى تُترَكَ","explicit":true,"ref":"الدر المنثور 4/202","srcLabel":"الطبراني","text":["من سنَّ سُنَّةً حسنةً فلَهُ أجرُها ما عُمِلَ بِها في حياتِهِ وبعدَ مماتِهِ حتَّى تُترَكَ ",["ومن سنَّ سنَّةً سيِّئةً ",1],["فعليْهِ إثمُها حتَّى تُترَكَ ",2],"ومن ماتَ مرابطًا في سبيلِ اللَّهِ جرى عليْهِ عملُ المرابطِ حتَّى يُبعثَ يومَ القيامةِ"],"grade":"حسن","narrator":"واثلة بن الأسقع الليثي أبو فسيلة","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه الطبراني (184) (22/ 74) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (7/ 398) بدون فقرة:\"من مات مرابطًا\"، وابن أبي عاصم في الجهاد (298) مختصرًا بالفقرة الأخيرة.","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"fhipisl2"},{"id":"س-07990","fp":"6bf9ed673087","stateId":111,"easy":"إذا سننت القتل (كابن آدم الأول) ← عليك نصيب من كل نفس تُقتل ظلماً بعدك","cause":"أوَّلُ مَن سَنَّ القَتلَ","result":"ليس مِن نَفسٍ تُقتَلُ ظُلمًا، إلَّا كان على ابنِ آدَمَ الأوَّلِ كِفلٌ مِنها","explicit":true,"star":true,"ref":"صحيح البخاري 7321","srcLabel":"مسلم","text":[["ليس مِن نَفسٍ تُقتَلُ ظُلمًا، إلَّا كان على ابنِ آدَمَ الأوَّلِ كِفلٌ مِنها",2]," -ورُبَّما قال سُفيانُ: مِن دَمِها- لأنَّه ",["أوَّلُ مَن سَنَّ القَتلَ",1]," أوَّلًا."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1677) باختلاف يسير","bab":"مظالم › تحريم الظلم","dorar":"6hMEpfEC","merged":2,"otherRefs":["الجامع الصغير 1066 (صحيح)"]},{"id":"س-03824","fp":"8dd7d0b9d809","stateId":112,"easy":"إذا أفتيت بغير علم ← فإثم من عمل بفتواك عليك","cause":"مَنْ أُفْتِىَ بِغيرِ عِلمٍ","result":"كان إثْمُهُ على مَنْ أفْتاهُ","explicit":true,"similar":["س-05060"],"ref":"الجامع الصغير 8471","srcLabel":"الحاكم","text":[["مَنْ أُفْتِىَ بِغيرِ عِلمٍ",1]," ",["كان إثْمُهُ على مَنْ أفْتاهُ",2]," ، ومَنْ أشارَ على أخيهِ بأمْرٍ يعلمُ أنَّ الرُّشْدَ في غيرِهِ فقدْ خانَهُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داوود (3657)، والحاكم في ((مستدركه)) (350)، والطحاوي في ((مشكل الآثار)) (410) واللفظ لهم.","bab":"بر وصلة › حق المسلم على المسلم","dorar":"dZMyAcHT"},{"id":"س-07777","fp":"a42afe3ae589","stateId":112,"easy":"إذا تكلمت في القرآن بغير علم ← فقد أخطأت ولو أصبت","cause":"مَن تكلَّمَ في القُرآنِ بغيرِ علْمٍ","result":"فقد أخطَأَ، وإنْ أصاب","explicit":true,"similar":["س-07697"],"ref":"عارضة الأحوذي 6/62","srcLabel":"عارضة الأحوذي","text":[["مَن تكلَّمَ في القُرآنِ بغيرِ علْمٍ ",1],["فقد أخطَأَ، وإنْ أصاب",2],"."],"grade":"صحيح","muhaddith":"إن لم يكن سندا صحيحا فإنه معنى صحيح","bab":"قرآن › الاختلاف والمراء في القرآن","dorar":"iSFmNRu7"},{"id":"س-05060","fp":"0982eaf31cab","stateId":112,"easy":"إذا أفتيت بغير تثبّت ← فإثم من عمل بها عليك","cause":"من أُفتيَ بفُتيا غيرِ ثَبتٍ","result":"فإنما إثمُه على الذي أفتاه","explicit":true,"repOf":"س-03824","ref":"فتح الغفار 2055/4","text":["عن أبي هُرَيرةَ قال: ",["من أُفتيَ بفُتيا غيرِ ثَبتٍ ",1],["فإنما إثمُه على الذي أفتاه",2],". وفي لفظٍ: مَن أُفتِيَ بفُتيا بغيرِ عِلمٍ كان إثمُه على الذي أفتاه"],"grade":"حسن","muhaddith":"رجال إسناده أئمة ثقات","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"SmfQlh4A"},{"id":"س-07697","fp":"7a9190e89bb2","stateId":112,"easy":"إذا قلت في القرآن برأيك فأصبت ← فقد أخطأت (الطريق)","cause":"من قال في القُرآنِ برَأيِه فأصابَ","result":"فقد أخطَأَ","explicit":true,"repOf":"س-07777","ref":"فيض القدير 6/ 190","text":[["من قال في القُرآنِ برَأيِه فأصابَ",1]," ",["فقد أخطَأَ",2]],"grade":"حسن","narrator":"جندب بن عبد الله البجلي","muhaddith":"رمز السيوطي لحسنه ولعله لاعتضاده","bab":"قرآن › آداب الناس كلهم مع القرآن","dorar":"V3LzlquZ"},{"id":"س-03744","fp":"6db008318731","stateId":112,"easy":"إذا سألت عن أمر لم يُحرّم فحُرّم بسببك ← فأنت أعظم المسلمين جرماً","cause":"مَن سَألَ عن أمرٍ لم يُحَرَّمْ فحُرِّمَ على النَّاسِ مِن أجلِ مَسألَتِه","result":"أعظَمُ المُسلِمينَ في المُسلِمينَ جُرمًا","explicit":true,"star":true,"ref":"صحيح مسلم 2358","srcLabel":"متفق عليه","text":[["أعظَمُ المُسلِمينَ في المُسلِمينَ جُرمًا",2]," ",["مَن سَألَ عن أمرٍ لم يُحَرَّمْ فحُرِّمَ على النَّاسِ مِن أجلِ مَسألَتِه",1],". وزادَ في حَديثِ مَعمَرٍ: رَجُلٌ سَألَ عن شيءٍ ونَقَّرَ عنه. وقال في حَديثِ يونُسَ: عامِرِ بنِ سَعدٍ، أنَّه سَمِعَ سَعدًا."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7289)، ومسلم (2358).","bab":"اعتصام بالسنة › ما يكره من كثرة السؤال وتكلف ما لا يعنيه","dorar":"vvbs9ssI","merged":4,"otherRefs":["تخريج صحيح ابن حبان 110 (صحيح)","مجموع الفتاوى 21/617 (صحيح)","صحيح مسلم 2358 (صحيح)"]},{"id":"س-03754","fp":"b665741b2e9f","stateId":113,"easy":"إذا خرجت من المسجد بعد الأذان بلا عذر ← فقد عصيت النبي ﷺ","cause":"فأذَّنَ المُؤَذِّنُ، فقامَ رَجُلٌ مِنَ المَسجِدِ يَمشي، فأتبَعَه أبو هُرَيرةَ بَصَرَه حتَّى خَرَجَ مِنَ المَسجِدِ","result":"فقد عَصى أبا القاسِمِ صلَّى اللهُ عليه وسلَّم","explicit":true,"star":true,"similar":["س-05160","س-04848"],"ref":"صحيح مسلم 655","srcLabel":"متفق عليه","text":["عَن أبي الشَّعثاءِ، قال: كُنَّا قُعودًا في المَسجِدِ مع أبي هُرَيرةَ، ",["فأذَّنَ المُؤَذِّنُ، فقامَ رَجُلٌ مِنَ المَسجِدِ يَمشي، فأتبَعَه أبو هُرَيرةَ بَصَرَه حتَّى خَرَجَ مِنَ المَسجِدِ",1],"، فقال أبو هُرَيرةَ: أمَّا هذا ",["فقد عَصى أبا القاسِمِ صلَّى اللهُ عليه وسلَّم",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"اعتصام بالسنة › مخالفة السنة","dorar":"w4ivyMzP","merged":6,"otherRefs":["تخريج المسند لشعيب 10933 (صحيح)","الفتح الرباني 6/2844 (صحيح)","تخريج المسند لشعيب 10095 (صحيح)","صحيح ابن خزيمة 3/ 35 (صحيح)","تخريج المسند لشعيب 9382 (صحيح)"]},{"id":"س-03713","fp":"8cd760be4559","stateId":113,"easy":"إذا دُعيت إلى الوليمة فلم تجب ← فقد عصيت الله ورسوله","cause":"فمن دُعِيَ فلم يُجِبْ","result":"فَقَدْ عَصَى اللهَ ورسولَهُ","explicit":true,"star":true,"ref":"مجمع الزوائد 4/55","srcLabel":"متفق عليه","text":["عن أبي هريرةَ، قال: الوليمةُ حقٌّ وسنةٌ؛ ",["فمن دُعِيَ فلم يُجِبْ ",1],["فَقَدْ عَصَى اللهَ ورسولَهُ",2],"، والخَرْسُ والإعذارُ والتوكيرُ أنتَ فيه بالخيارِ، قال: قلتُ: إني واللهِ لا أدري ما الخرْسُ والإعذارُ والتوكيرُ؟ قال: الخَرْسُ الوِلَادَةُ والإعْذارُ الخِتانُ والتوكيرُ الرجلُ يبني الدَّارَ وينزِلُ في القومِ فيجعلُ الطعامَ فيدعوهم، فهم بالخيارِ إنْ شاؤُوا جاؤوا، وإنْ شاؤُوا قعَدُوا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"فيه يحيى بن عثمان التيمي وبقية رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (3948) بلفظه، والبخاري (5177)، ومسلم (1432) بنحوه.","bab":"اعتصام بالسنة › لزوم السنة","dorar":"iEQaanpO","merged":4,"otherRefs":["صحيح الجامع 3706 (صحيح)","الضعفاء الكبير 2/161 (حسن)","تخريج المسند لشعيب 10412 (صحيح)"]},{"id":"س-06728","fp":"f8eb097a3e21","stateId":113,"easy":"إذا صمت يوم الشك ← فقد عصيت أبا القاسم ﷺ","cause":"مَن صامَ اليومَ الَّذي يشَكُّ فيهِ","result":"فقد عَصى أبا القاسمِ صلَّى اللهُ علَيهِ وسلَّمَ","explicit":true,"star":true,"similar":["س-05280"],"ref":"صحيح ابن خزيمة 1914","srcLabel":"البخاري","text":["كنَّا عندَ عمَّارٍ ، فأُتيَ بشاةٍ مَصليَّةٍ ، فقالَ : كُلوا ، فتنحَّى بعضُ القومِ : فقالَ : إنِّي صائمٌ . فقالَ عمَّارٌ: ",["مَن صامَ اليومَ الَّذي يشَكُّ فيهِ ",1],["فقد عَصى أبا القاسمِ صلَّى اللهُ علَيهِ وسلَّمَ ",2],"."],"grade":"صحيح","narrator":"عمار بن ياسر","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن خزيمة (1914) واللفظ له، وأخرجه أبو داود (2334) باختلاف يسير، والحديث أخرجه البخاري معلقاً بصيغة الجزم قبل حديث (1906) باختلاف يسير","bab":"صيام › صيامه صلى الله عليه وسلم","dorar":"vZ86N64n","merged":2,"otherRefs":["تخريج صحيح ابن حبان 3595 (صحيح)"]},{"id":"س-01604","fp":"f0cd29bab717","stateId":113,"easy":"إذا تركت إجابة الدعوة ← فقد عصيت الله ورسوله","cause":"ومن ترَك الدَّعوةَ","result":"فقد عصى اللَّهَ ورسولَه","explicit":true,"star":true,"ref":"مختصر المقاصد 556","srcLabel":"متفق عليه","text":["شرُّ الطَّعامِ طعامُ الوليمةِ ، يُدعَى إليْها الأغنياءُ ، ويُترَك الفقراءُ ، ",["ومن ترَك الدَّعوةَ ",1],["فقد عصى اللَّهَ ورسولَه",2]],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5177)، ومسلم (1432) باختلاف يسير.","bab":"أطعمة › إجابة الدعوة","dorar":"QEzvPBla"},{"id":"س-05110","fp":"d14d1862547c","stateId":113,"easy":"إذا لم تجب الدعوة ← فقد عصيت الله ورسوله","cause":"ومَن لَـمْ يَأْتِ الدَّعْوةَ","result":"فقد عَصَى اللهَ ورسولَه","explicit":true,"ref":"تخريج المسند لشعيب 7279","srcLabel":"متفق عليه","text":["قال سُفيانُ: سَأَلْتُه أنا عنه: كيف الطَّعامُ، طَعامُ الأغنياءِ؟ قال: أخْبَرَني الأَعْرجُ عن أبي هُريرةَ: شَرُّ الطَّعامِ طَعامُ الوَلِيمَةِ، يُدْعى إليه الأغْنياءُ، ويُتْرَكُ الـمَساكِينُ، ",["ومَن لَـمْ يَأْتِ الدَّعْوةَ ",1],["فقد عَصَى اللهَ ورسولَه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (5177)، ومسلم (1432)، وأبو داود (3742)، والنسائي في ((السنن الكبرى)) (6613)، وابن ماجه (1913)، وأحمد (7279) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"zRvkmjZr"},{"id":"س-05160","fp":"5819e1f2d9d1","stateId":113,"easy":"إذا خرجت من المسجد بعد النداء ← فقد عصيت أبا القاسم ﷺ","cause":"مرَّ رجلٌ في المسجدِ بعدَ النِّداءِ حتَّى قطعَه","result":"فقد عصى أبا القاسمِ","explicit":true,"repOf":"س-03754","ref":"صحيح النسائي 682","text":["عن [أبي الشعثاء] قال: رأيتُ أبا هريرةَ و",["مرَّ رجلٌ في المسجدِ بعدَ النِّداءِ حتَّى قطعَه",1]," فقالَ أبو هريرةَ أمَّا هذا ",["فقد عصى أبا القاسمِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (655)، وأبو داود (536)، والنسائي (683) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Oor1wu3j","merged":2,"otherRefs":["علل الدارقطني 2246 (صحيح)"]},{"id":"س-04848","fp":"6fd39c68fba1","stateId":113,"easy":"إذا خرجت من المسجد بعد الأذان بلا عذر ← فقد عصيت أبا القاسم ﷺ","cause":"رَجُلًا يَجتازُ المَسجِدَ خارِجًا بَعدَ الأذانِ","result":"فقد عَصى أبا القاسِمِ صلَّى اللهُ عليه وسلَّم","explicit":true,"repOf":"س-03754","ref":"صحيح مسلم 655","text":["عن [أبي الشَّعثاءِ المحارِبيِّ] قال: سَمِعتُ أبا هُرَيرةَ، ورَأى ",["رَجُلًا يَجتازُ المَسجِدَ خارِجًا بَعدَ الأذانِ",1],"، فقال: أمَّا هذا ",["فقد عَصى أبا القاسِمِ صلَّى اللهُ عليه وسلَّم",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (655)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ROFpCN9j"},{"id":"ق-0047","fp":"8966621bc2fb","stateId":113,"easy":"اتباع أهواء أهل الباطل بعد العلم ← الدخول في الظالمين","cause":"اتباع أهواء أهل الباطل بعد العلم","result":"الدخول في الظالمين","explicit":true,"ref":"سورة البقرة: 145","srcLabel":"القرآن الكريم","quran":{"s":2,"from":145,"to":145,"text":"وَلَئِنْ أَتَيْتَ الَّذِينَ أُوتُوا الْكِتَابَ بِكُلِّ آيَةٍ مَا تَبِعُوا قِبْلَتَكَ وَمَا أَنْتَ بِتَابِعٍ قِبْلَتَهُمْ وَمَا بَعْضُهُمْ بِتَابِعٍ قِبْلَةَ بَعْضٍ وَلَئِنِ اتَّبَعْتَ أَهْوَاءَهُمْ مِنْ بَعْدِ مَا جَاءَكَ مِنَ الْعِلْمِ إِنَّكَ إِذًا لَمِنَ الظَّالِمِينَ (145)","hl":[[164,271,1]]}},{"id":"س-02691","fp":"acc7afcbf44a","stateId":113,"easy":"إذا خالفت رخصة أمر بها النبي ﷺ ← فأنت من العصاة (من واقعة)","cause":"ناسًا صاموا بعدُ ذلك","result":"أولئِكَ العُصاةُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-01599"],"ref":"نخب الافكار 8/334","srcLabel":"مسلم","text":["خرجَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ عامَ الفتحِ في رمَضانَ ، فصامَ حتَّى بلغَ كُراعَ الغَميمِ ، فصامَ النَّاسُ معَهُ فبلغَهُ أنَّ النَّاسَ قد شقَّ عليهمُ الصِّيامُ ، ينظُرونَ فيما بُلِّغتُ فدَعَى بقدَحٍ من ماءٍ بعدَ العَصرِ فشَرِبَ والنَّاسُ ينظُرونَ فيما بُلِّغتُ فدَعَى بقدحٍ من ماءٍ بعدَ العصرِ ، فشربَ والنَّاسُ ينظرونَ . فبلغَهُ أنَّ ",["ناسًا صاموا بعدُ ذلك",1]," فقالَ: ",["أولئِكَ العُصاةُ",2]],"grade":"صحيح","narrator":"جابر","muhaddith":"طريقه صحيح","takhrij":"أخرجه الطحاوي في ((شرح معاني الآثار)) (3229)، ومسلم (1114)، والترمذي (710) جميعهم بلفظه.","bab":"إيمان › الدين يسر","dorar":"8GKcLVLB","merged":2,"otherRefs":["صحيح النسائي 2262 (صحيح)"]},{"id":"س-01856","fp":"b8e48e294645","stateId":113,"easy":"إذا لم تقبل رخصة الله ← عليك من الإثم مثل جبال عرفة","cause":"مَن لم يَقبلْ رُخصةَ اللَّهِ","result":"كانَ عليهِ منَ الإثمِ مثلُ جبالِ عرفةَ","explicit":true,"ref":"عمدة التفسير 1/222","srcLabel":"عمدة التفسير","text":["عنِ ابنِ عمرَ : ",["مَن لم يَقبلْ رُخصةَ اللَّهِ ",1],["كانَ عليهِ منَ الإثمِ مثلُ جبالِ عرفةَ",2]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"إحسان › الأخذ بالرخصة","dorar":"XDsc3ryy"},{"id":"س-04074","fp":"d0dec20f68aa","stateId":113,"easy":"إذا عصيت الله ورسوله ← فقد غويت","cause":"مَن يَعصِهما","result":"فقد غَوى","explicit":true,"ref":"صحيح مسلم 870","srcLabel":"أبو داود","text":["أنَّ رَجُلًا خَطَبَ عِندَ النَّبيِّ صلَّى اللهُ عليه وسلَّم، فقال: مَن يُطِعِ اللَّهَ ورَسولَه فقد رَشَدَ، و",["مَن يَعصِهما",1]," ",["فقد غَوى",2],"، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: بِئْسَ الخَطيبُ أنتَ! قُلْ: ومَن يَعصِ اللَّهَ ورَسولَه. [وفي روايةٍ]: فقد غَويَ."],"grade":"صحيح","narrator":"عدي بن حاتم الطائي","muhaddith":"[صحيح]","takhrij":"أخرجه أبو داود (4981) وأحمد (18247) وابن حبان (2798) باختلاف يسير","bab":"جمعة › كيفية الخطبة","dorar":"FiWrOSrS"},{"id":"س-04824","fp":"e4ea6ec54a7c","stateId":113,"easy":"إذا حرّمت الحلال ← فأنت كمن يحلّ الحرام","cause":"مُحرِّمَ الحلالِ","result":"كمُحِلِّ الحرامِ","explicit":true,"similar":["س-00528"],"ref":"مجمع الزوائد 1/181","srcLabel":"ابن حبان","text":["إن ",["مُحرِّمَ الحلالِ",1]," ",["كمُحِلِّ الحرامِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه ابن حبان في ((المجروحين)) (1/125)، والطبراني في ((المعجم الأوسط)) (7982) واللفظ له، والقضاعي في ((مسند الشهاب)) (980)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"rf5KIw5P"},{"id":"س-05280","fp":"f2aba0bf710d","stateId":113,"easy":"إذا صمت يوم الشك ← فقد عصيت أبا القاسم ﷺ","cause":"مَن صامَ يَومَ الشَّكِّ","result":"فقد عَصى أبا القاسِمِ","explicit":true,"repOf":"س-06728","ref":"الروضة الندية 1/237","text":["قال عَمَّارٌ: ",["مَن صامَ يَومَ الشَّكِّ ",1],["فقد عَصى أبا القاسِمِ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"wOnaXGWA"},{"id":"س-03748","fp":"26f008d71a00","stateId":113,"easy":"إذا وقّرت صاحب بدعة ← فقد أعنت على هدم الإسلام","cause":"مَن وَقَّر صاحبَ بدعةٍ","result":"فقد أعان على هَدْمِ الإسلامِ","explicit":true,"ref":"هداية الرواة 187","srcLabel":"البيهقي","text":[["مَن وَقَّر صاحبَ بدعةٍ ؛ ",1],["فقد أعان على هَدْمِ الإسلامِ",2]],"grade":"حسن","narrator":"إبراهيم بن ميسرة الطائفي","muhaddith":"حسن","takhrij":"أخرجه اللالكائي في ((شرح أصول الاعتقاد)) (273)، والبيهقي في ((شعب الإيمان)) (9018)","bab":"اعتصام بالسنة › مخالفة السنة","dorar":"ad2ATdh6"},{"id":"س-01599","fp":"4b055b099bda","stateId":113,"easy":"إذا خالفت أمر النبي ﷺ ← فأنت من العصاة (من واقعة)","cause":"فما قام إلا أبو هريرةَ وخَمْسَةٌ معهم","result":"إنكم لَعُصاةٌ لأَبي القاسِمِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-02691","otherNeedIds":[28],"ref":"تخريج المسند لشاكر 15/5","text":["أنَّ الغاديةَ اليَمَامِيَّ  قال : أتيتُ المدينةَ، فجاء رسولُ كَثِيرِ بنِ الصَّلْتِ، فدعاهم، ",["فما قام إلا أبو هريرةَ وخَمْسَةٌ معهم",1],"  أنا أحدُهم، فذهَبوا فأكَلوا ثم جاء أبو هريرةَ، فغسَل يدَهُ، ثُمَّ قال  وَاللهِ، يا أهلَ المسجِدِ، ",["إنكم لَعُصاةٌ لأَبي القاسِمِ",2]," صلى اللهُ عليه وسلَّم"],"grade":"حسن","narrator":"أبو غادية اليماني","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (7884).","bab":"أطعمة › إجابة الدعوة","dorar":"CpiNPbXX"},{"id":"س-04377","fp":"e0e1b3f8583a","stateId":113,"easy":"إذا فررت من الطاعون ← فأنت كالفار من الزحف","cause":"والفارُّ منه","result":"كالفارِّ مِن الزَّحْفِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"إرواء الغليل 1638","srcLabel":"أحمد","text":["غُدَّةٌ كغُدَّةِ البَعيرِ ، المُقيمُ به كالشَّهيدِ ، ",["والفارُّ منه",1]," ",["كالفارِّ مِن الزَّحْفِ",2]," [ أيِ الطَّاعونِ ]"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه أحمد (25118) بلفظه تامًا، وأبو يعلى (4408) باختلاف يسير تامًا، وابن الأعرابي في ((معجمه)) (2456) بنحوه تامًا.","bab":"جهاد › التولي والفرار من الزحف","dorar":"bIOuBz7i","merged":5,"otherRefs":["صحيح الجامع 4276 (صحيح)","صحيح الجامع 3948 (صحيح)","صحيح الجامع 4282 (صحيح)","صحيح الجامع 4277 (صحيح)"]},{"id":"س-00528","fp":"7b5154381fd7","stateId":113,"easy":"إذا حرّمت الحلال ← فأنت كمن استحل الحرام","cause":"محرِّمَ الحلالِ","result":"كمستَحِلِّ الحرامِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-04824","ref":"مجمع الزوائد 4-42","text":["سمِعْتُ عبدَ اللهِ بنَ مسعودٍ يقولُ إنَّ ",["محرِّمَ الحلالِ",1]," ",["كمستَحِلِّ الحرامِ",2]],"grade":"صحيح","narrator":"عبدالرحمن بن عبدالله بن مسعود","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه عبد الرزاق (20573)، والطبراني في ((المعجم الكبير)) (9/ 172) (8852)، وابن سعد في ((الطبقات الكبرى)) (16/ 181) واللفظ لهم.","bab":"آداب عامة › ضرب الأمثال","dorar":"4DhjGQMI"},{"id":"ق-0299","fp":"1a948e075566","stateId":114,"easy":"قتل نفس بغير حق ← كأنما قتل الناس جميعاً","cause":"قتل نفس بغير حق","result":"كأنما قتل الناس جميعاً","explicit":true,"star":true,"otherNeedIds":[70],"ref":"سورة المائدة: 32","srcLabel":"القرآن الكريم","quran":{"s":5,"from":32,"to":32,"text":"مِنْ أَجْلِ ذَلِكَ كَتَبْنَا عَلَى بَنِي إِسْرَائِيلَ أَنَّهُ مَنْ قَتَلَ نَفْسًا بِغَيْرِ نَفْسٍ أَوْ فَسَادٍ فِي الْأَرْضِ فَكَأَنَّمَا قَتَلَ النَّاسَ جَمِيعًا وَمَنْ أَحْيَاهَا فَكَأَنَّمَا أَحْيَا النَّاسَ جَمِيعًا وَلَقَدْ جَاءَتْهُمْ رُسُلُنَا بِالْبَيِّنَاتِ ثُمَّ إِنَّ كَثِيرًا مِنْهُمْ بَعْدَ ذَلِكَ فِي الْأَرْضِ لَمُسْرِفُونَ (32)","hl":[[62,163,1]]}},{"id":"س-02460","fp":"7f5ad2d9de3a","stateId":114,"easy":"إذا قتلت من قال لا إله إلا الله ← فمن لك بها يوم القيامة","cause":"قالَ: لا إلَهَ إلَّا اللَّهُ فضَربناهُ حتَّى قتلناهُ","result":"من لَكَ بِ لا إلَهَ إلَّا اللَّهُ يومَ القيامةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-01226"],"otherNeedIds":[70],"ref":"صحيح أبي داود 2643","srcLabel":"متفق عليه","text":["بعثَنا رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ سريَّةً إلى الحُرقاتِ فنَذروا بنا فَهَربوا فأدرَكْنا رجلًا فلمَّا غشيناهُ ",["قالَ: لا إلَهَ إلَّا اللَّهُ فضَربناهُ حتَّى قتلناهُ",1]," فذَكَرتُهُ للنَّبيِّ صلَّى اللَّهُ علَيهِ وسلَّمَ فقالَ: ",["من لَكَ بِ ( لا إلَهَ إلَّا اللَّهُ يومَ القيامةِ",2]," فقُلتُ: يا رسولَ اللَّهِ، إنَّما قالَها مَخافةَ السِّلاحِ. قالَ: أفلا شقَقتَ عن قلبِهِ حتَّى تعلمَ مِن أجلِ ذلِكَ قالَها أم لا؟ مَن لَكَ بلا إلَهَ إلَّا اللَّهُ يومَ القيامةِ؟ فما زالَ يقولُها حتَّى وَدِدْتُ أنِّي لم أُسلِم إلَّا يومئذٍ"],"grade":"صحيح","narrator":"أسامة بن زيد","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2643) واللفظ له، وأخرجه البخاري (4269)، ومسلم (96) باختلاف يسير","bab":"إسلام › فضل الشهادتين","dorar":"uZHnp5eA"},{"id":"س-02361","fp":"5474af88ca7e","stateId":114,"easy":"إذا سفكت دماً بغير حق ← فزوال الدنيا أهون على الله منه","cause":"دَمٍ يُسْفَكُ بغيرِ حقٍّ","result":"لَزَوَالُ الدنيا جَمِيعًا ؛ أَهْوَنُ على اللهِ","explicit":true,"ref":"صحيح الترغيب 2438","srcLabel":"ابن ماجه","text":[["لَزَوَالُ الدنيا جَمِيعًا ؛ أَهْوَنُ على اللهِ",2]," من ",["دَمٍ يُسْفَكُ بغيرِ حقٍّ",1]],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن أبي الدنيا في ((الأهوال)) (191)، وابن أبي عاصم في ((الديات)) (ص2) واللفظ لهما، وابن ماجه (2619) باختلاف يسير.","bab":"إسلام › حرمة المسلم","dorar":"dlgrDMJj","merged":2,"otherRefs":["صحيح الترغيب 2438 (صحيح)"]},{"id":"س-01778","fp":"0df3457f1f61","stateId":114,"easy":"إذا قتلت مؤمناً ← فهو أعظم عند الله من زوال الدنيا","cause":"لقَتلُ مؤمنٍ","result":"أعظمُ عندَ اللَّهِ من زوالِ الدُّنيا","explicit":true,"similar":["س-05179"],"ref":"صحيح النسائي 3997","srcLabel":"النسائي","text":["والَّذي نفسي بيدِهِ ",["لقَتلُ مؤمنٍ",1]," ",["أعظمُ عندَ اللَّهِ من زوالِ الدُّنيا",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه النسائي (3986) واللفظ له، وابن أبي حاتم في ((العلل)) (6/301)، والطبراني (13/416) (14256) باختلاف يسير","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"Efmh2NdA"},{"id":"س-02364","fp":"a52680716bc5","stateId":114,"easy":"إذا سفكت دماً حراماً ← وقعت في ورطة لا مخرج منها","cause":"سَفكَ الدَّمِ الحَرامِ بغَيرِ حِلِّه","result":"إنَّ مِن ورَطاتِ الأُمورِ التي لا مَخرَجَ لمَن أوقَعَ نَفسَه فيها","explicit":true,"ref":"صحيح البخاري 6863","srcLabel":"البيهقي","text":["عَن عبدِ اللهِ بنِ عُمَرَ، قال: ",["إنَّ مِن ورَطاتِ الأُمورِ التي لا مَخرَجَ لمَن أوقَعَ نَفسَه فيها",2]," ",["سَفكَ الدَّمِ الحَرامِ بغَيرِ حِلِّه",1],"."],"grade":"صحيح","narrator":"سعيد بن عمرو بن سعيد بن العاص","muhaddith":"[صحيح]","takhrij":"أخرجه البيهقي (15957) واللفظ له، وابن الحداد في ((جامع الصحيحين)) (2016) باختلاف يسير.","bab":"إسلام › حرمة المسلم","dorar":"o6Mytr4R"},{"id":"س-05179","fp":"5dc80a761454","stateId":114,"easy":"إذا قتلت مؤمناً ← فهو يعدل عند الله زوال الدنيا","cause":"قتلُ المؤمنِ عند اللهِ","result":"يعدِلُ زوالَ الدُّنيا","explicit":true,"repOf":"س-01778","ref":"البدر المنير 8/346","text":[["قتلُ المؤمنِ عند اللهِ ",1],["يعدِلُ زوالَ الدُّنيا",2]],"grade":"صحيح","muhaddith":"أسند هذا من وجوه صحيحة لا مطعن لأحد في رجالها","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"S90tOHL2"},{"id":"س-02451","fp":"c25386c70c8e","stateId":114,"easy":"إذا قتلت مسلماً ← أبى الله أن يقبل منك (من واقعة)","cause":"مَن قَتَلَ مُسلِمًا","result":"أَبى اللهُ علَيَّ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"تخريج المسند لشعيب 17009","srcLabel":"النسائي","text":["أنَّ سَرِيَّةً لرسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ غَشَوْا أهْلَ ماءٍ صُبْحًا، فبَرَزَ رجُلٌ مِن أهلِ الماءِ، فحمَلَ عليه رجُلٌ مِنَ المُسلمينَ، فقال: إنِّي مُسلِمٌ، فقتَلَه، فلمَّا قَدِموا أَخْبَروا النَّبيَّ صلَّى اللهُ عليه وسلَّمَ بذلك، فقام رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ خَطيبًا، فحَمِدَ اللهَ وأَثْنى عليه، ثمَّ قال: أمَّا بعْدُ، فما بالُ المُسلِمِ يَقتُلُ الرَّجُلَ وهو يقولُ: إنِّي مُسلِمٌ؟! فقال الرَّجُلُ: إنَّما قالها مُتَعَوِّذًا، فصرَفَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ وجْهَه، ومَدَّ يدَهُ اليُمْنى فقال: ",["أَبى اللهُ علَيَّ",2]," ",["مَن قَتَلَ مُسلِمًا",1],"، ثلاثَ مرَّاتٍ."],"grade":"صحيح","narrator":"عقبة بن مالك","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (8593)، وأحمد (17008) واللفظ له","bab":"إسلام › فضل الشهادتين","dorar":"MLEhEtb9","merged":2,"otherRefs":["المستدرك على الصحيحين 48 (صحيح)"]},{"id":"س-02453","fp":"a715558e9ec4","stateId":114,"easy":"إذا قتلت مؤمناً ← أبى الله عليك (من واقعة)","cause":"لِمَن قَتَلَ مُؤمنًا","result":"إنَّ اللهَ عزَّ وجلَّ أبَى عليَّ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"تخريج المسند لشعيب 22490","srcLabel":"النسائي","text":["بَعَثَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ سَريَّةً، قال: فأغارَتْ على قَومٍ، قال: فشَذَّ مِن القَومِ رَجُلٌ، قال: فأتْبَعَه رَجُلٌ مِن السَّريَّةِ شاهرًا سَيفَه، قال: فقال الشَّاذُّ مِن القَومِ: إنِّي مُسلِمٌ، قال: فلمْ يَنظُرْ فيما قال، فضَرَبَه فقَتَلَه، قال: فنُمِيَ الحديثُ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، قال: فقال فيه قَولًا شَديدًا، فبَلَغَ القاتلَ، قال: فبيْنَا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يَخطُبُ إذ قال القاتلُ: يا رسولَ اللهِ، واللهِ ما قال الذي قال إلَّا تَعوُّذًا مِن القَتلِ، قال: فأعرَضَ عنه، وعمَّن قبلَه مِن النَّاسِ، وأخَذَ في خُطبتِه، ثُمَّ قال أيضًا: يا رسولَ اللهِ، ما قال الذي قال إلَّا تَعوُّذًا مِن القَتلِ، فأعرَضَ عنه، وعمَّن قِبَلَه مِن النَّاسِ، وأخَذَ في خُطبتِه، ثُمَّ لم يَصبِرْ فقال الثَّالثةَ: يا رسولَ اللهِ، واللهِ ما قال إلَّا تَعوُّذًا مِن القَتلِ، فأقبَلَ عليه رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ -تُعرَفُ المَساءةُ في وَجهِه- قال له: ",["إنَّ اللهَ عزَّ وجلَّ أبَى عليَّ",2]," ",["لِمَن قَتَلَ مُؤمنًا",1],"، ثَلاثَ مَرَّاتٍ."],"grade":"صحيح","narrator":"عقبة بن مالك","muhaddith":"إسناده صحيح إن كان بشر بن عاصم الليثي هو الذي وثقه النسائي، وإلا كان الإسناد حسنا","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (8593)، وأحمد (22490) واللفظ له","bab":"إسلام › فضل الشهادتين","dorar":"ZFtDwnvr","merged":2,"otherRefs":["الصحيح المسند 2/40 (صحيح)"]},{"id":"س-01226","fp":"fe646553aef4","stateId":114,"easy":"إذا قتلت من قال لا إله إلا الله ← فكيف تصنع بها إذا جاءت يوم القيامة","cause":"فلَمَّا رَفَعَ عليه السَّيفَ قال: لا إلَهَ إلَّا اللهُ، فقَتَلَه","result":"فكيفَ تَصنَعُ بلا إلَهَ إلَّا اللهُ إذا جاءَت يَومَ القيامةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-02460","otherNeedIds":[70],"ref":"صحيح مسلم 97","text":["أنَّ جُندَبَ بنَ عبدِ اللهِ البَجَليَّ بَعَثَ إلى عَسعَسِ بنِ سَلامةَ زَمَنَ فِتنةِ ابنِ الزُّبَيرِ، فقال: اجمَعْ لي نَفَرًا مِن إخوانِك حتَّى أُحَدِّثَهم، فبَعَثَ رَسولًا إليهم، فلَمَّا اجتَمَعوا جاءَ جُندَبٌ وعليه بُرنُسٌ أصفَرُ، فقال: تَحَدَّثوا بما كُنتُم تَحَدَّثونَ به حتَّى دارَ الحَديثُ، فلَمَّا دارَ الحَديثُ إليه حَسَرَ البُرنُسَ عن رَأسِه، فقال: إنِّي أتَيتُكُم ولا أُريدُ أن أُخبِرَكُم عن نَبيِّكُم، إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم بَعَثَ بَعثًا مِنَ المُسلِمينَ إلى قَومٍ مِنَ المُشرِكينَ، وإنَّهمُ التَقَوا فكانَ رَجُلٌ مِنَ المُشرِكينَ إذا شاءَ أن يَقصِدَ إلى رَجُلٍ مِنَ المُسلِمينَ قَصَدَ له فقَتَلَه، وإنَّ رَجُلًا مِنَ المُسلِمينَ قَصَدَ غَفلَتَه -قال: وكُنَّا نُحَدَّثُ أنَّه أُسامةُ بنُ زَيدٍ- ",["فلَمَّا رَفَعَ عليه السَّيفَ قال: لا إلَهَ إلَّا اللهُ، فقَتَلَه",1],"، فجاءَ البَشيرُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم فسَألَه فأخبَرَه، حتَّى أخبَرَه خَبَرَ الرَّجُلِ كيفَ صَنَعَ، فدَعاه فسَألَه، فقال: لمَ قَتَلتَه؟ قال: يا رَسولَ اللهِ، أوجَعَ في المُسلِمينَ، وقَتَلَ فُلانًا وفُلانًا، وسَمَّى له نَفَرًا، وإنِّي حَمَلتُ عليه، فلَمَّا رَأى السَّيفَ قال: لا إلَهَ إلَّا اللهُ، قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أقَتَلتَه؟ قال: نَعَم، قال: ",["فكيفَ تَصنَعُ بلا إلَهَ إلَّا اللهُ إذا جاءَت يَومَ القيامةِ",2],"؟ قال: يا رَسولَ اللهِ، استَغفِرْ لي، قال: وكيفَ تَصنَعُ بلا إلَهَ إلَّا اللهُ إذا جاءَت يَومَ القيامةِ؟ قال: فجَعَلَ لا يَزيدُه على أن يَقولَ: كيفَ تَصنَعُ بلا إلَهَ إلَّا اللهُ إذا جاءَت يَومَ القيامةِ؟"],"grade":"صحيح","narrator":"جندب بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه ابن منده في ((الإيمان)) (64)، وابن الحداد في ((جامع الصحيحين)) (4104)، والخطيب في ((منتخب الفوائد)) (64) واللفظ لهم.","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"cyeNVXtE"},{"id":"س-07290","fp":"578a5fb87faa","stateId":114,"easy":"إذا شهرت سيفك في الفتنة ← فقد شاركت القوم في إثمها","cause":"أفلا آخُذُ سَيْفي فأَضرِبُ به مَنْ فَعَلَ ذلك","result":"فقد شارَكْتَ القومَ إذن","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 2702","srcLabel":"أبو داود","text":["قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا أبا ذَرٍّ، كيف أنتَ ومَوتٌ يُصيبُ حتَّى يكونَ البيتُ بالوَصيفِ؟ -يعني القبرَ- قلتُ: ما خارَ اللهُ لي ورسولُهُ، ثُمَّ قالَ: كيف أنتَ وجوعٌ يُصيبُ النَّاسَ حتَّى تَأتيَ مسجِدَكَ، فلا تَستَطيعُ أنْ تَرجِعَ إلى فِراشِكَ، ولا تَستَطيعُ أنْ تَقومَ مِن فِراشِكَ إلى مسجِدِكَ؟ قلتُ: ما خارَ اللهُ لي ورسولُه. قالَ: عليكَ بالعِفَّةِ. ثُمَّ قالَ: كيف أنتَ وقَتْلٌ يُصيبُ النَّاسَ حتَّى تُغرَقَ حِجارةُ الزَّيتِ بالدَّمِ؟ قلتُ: ما خارَ اللهُ لي ورسولُه -أوِ: اللهُ ورسولُه أَعلمُ- قالَ: الزَمْ مَنزِلَكَ، قالَ: فقلتُ: يا رسولَ اللهِ، ",["أفلا آخُذُ سَيْفي فأَضرِبُ به مَنْ فَعَلَ ذلك",1],"؟ قالَ: ",["فقد شارَكْتَ القومَ إذن",2],"، قلتُ: يا رسولَ اللهِ، فإنْ دَخَلَ بيتي؟ قالَ: إنْ خَشيتَ أنْ يَبْهَرَكَ شُعاعُ السَّيفِ فقُلْ هكذا، فأَلقِ طَرَفَ ثوبِكَ على وَجهِكَ؛ فيَبوءَ بإثمِه وإثمِكَ، ويكونَ مِن أصحابِ النَّارِ."],"grade":"صحيح","narrator":"أبو ذر","muhaddith":"صحيح على شرط الشيخين،","takhrij":"أخرجه أبو داود (4261)، وابن ماجه (3958)، وأحمد (21445)، والبزار (3928) واللفظ لهم.","bab":"فتن › ظهور الفتن","dorar":"3ISNNjdK"},{"id":"س-02366","fp":"d84ec7d9b37a","stateId":114,"easy":"إذا قتلت من قال لا إله إلا الله ← فهو بمنزلتك قبل أن تقتله، وأنت بمنزلته قبل أن يقولها","cause":"فإن قَتَلتَه","result":"فإنَّه بمَنزِلَتِك قَبلَ أن تَقتُلَه، وإنَّك بمَنزِلَتِه قَبلَ أن يَقولَ كَلِمَتَه التي","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"صحيح مسلم 95","srcLabel":"متفق عليه","text":["أنَّه قال: يا رَسولَ اللهِ، أرَأيتَ إن لَقيتُ رَجُلًا مِنَ الكُفَّارِ فقاتَلَني، فضَرَبَ إحدى يَدَيَّ بالسَّيفِ فقَطَعَها، ثُمَّ لاذَ مِنِّي بشَجَرةٍ، فقال: أسلَمتُ للَّهِ، أفَأقتُلُه يا رَسولَ اللهِ، بَعدَ أن قالها؟ قال: رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: لا تَقتُلْه، قال: فقُلتُ: يا رَسولَ اللهِ، إنَّه قد قَطَعَ يَدي، ثُمَّ قال ذلك بَعدَ أن قَطَعَها، أفَأقتُلُه؟ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: لا تَقتُلْه، ",["فإن قَتَلتَه",1]," ",["فإنَّه بمَنزِلَتِك قَبلَ أن تَقتُلَه، وإنَّك بمَنزِلَتِه قَبلَ أن يَقولَ كَلِمَتَه التي",2]," قال. وفي روايةٍ: فلَمَّا أهويتُ لأقتُلَه قال: لا إلَهَ إلَّا اللهُ."],"grade":"صحيح","narrator":"المقداد بن عمرو بن الأسود","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4019)، ومسلم (95).","bab":"إسلام › حرمة المسلم","dorar":"5hsi11fW","merged":2,"otherRefs":["تخريج صحيح ابن حبان 4750 (صحيح)"]},{"id":"س-03782","fp":"ac385d5f0503","stateId":115,"easy":"إذا أكلت حق الضعيفين (اليتيم والمرأة) ← وقعت في الحرج والإثم الشديد","cause":"مالَ الضَّعيفَيْنِ اليتيمِ والمرأةِ","result":"أُحَرِّجُ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 7363","srcLabel":"مسلم","text":["عنْ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أنَّه كانَ يقولُ على المِنبَرِ: ",["أُحَرِّجُ",2]," ",["مالَ الضَّعيفَيْنِ اليتيمِ والمرأةِ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه ابن ماجة (3678)، وأحمد (9666)، وابن حبان (5565) باختلاف يسير.","bab":"بر وصلة › إعالة اليتيم والضعيف وفضلها","dorar":"wPep4Cvh","merged":3,"otherRefs":["الأحكام الشرعية الصغرى 632 (صحيح)","المحلى 8/326 (صحيح)"]},{"id":"س-06783","fp":"806824961afb","stateId":115,"easy":"إذا ضربت من تحت يدك ← فالله أقدر عليك منك عليه","cause":"كُنتُ أضرِبُ غُلامًا لي","result":"أنَّ اللهَ أقدَرُ عليكَ مِنكَ على هذا الغُلامِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"صحيح مسلم 1659","srcLabel":"متفق عليه","text":[["كُنتُ أضرِبُ غُلامًا لي",1]," بالسَّوطِ، فسَمِعتُ صَوتًا مِن خَلفي، اعلَمْ أبا مَسعودٍ، فلم أفهَمِ الصَّوتَ مِنَ الغَضَبِ، قال: فلَمَّا دَنا مِنِّي إذا هو رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فإذا هو يقولُ: اعلَمْ أبا مَسعودٍ، اعلَمْ أبا مَسعودٍ، قال: فألقَيتُ السَّوطَ مِن يَدي، فقال: اعلَمْ أبا مَسعودٍ ",["أنَّ اللهَ أقدَرُ عليكَ مِنكَ على هذا الغُلامِ",2],"، قال: فقُلتُ: لا أضرِبُ مَملوكًا بَعدَه أبَدًا. [وفي روايةٍ]: فسَقَطَ مِن يَدي السَّوطُ مِن هَيبَتِه."],"grade":"صحيح","narrator":"أبو مسعود عقبة بن عمرو","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"عتق وولاء › الإحسان إلى العبيد","dorar":"Vh7KuBi0","merged":6,"otherRefs":["حلية الأولياء 4/243 (صحيح)","تخريج المسند لشعيب 22354 (صحيح)","صحيح مسلم 1659 (صحيح)","النوافح العطرة 267 (صحيح)","سبل الهدى والرشاد 7/110 (صحيح)"]},{"id":"ق-0062","fp":"cd0a80d9134d","stateId":115,"easy":"تبديل الوصية بعد سماعها ← الإثم على المبدِّل","cause":"تبديل الوصية بعد سماعها","result":"الإثم على المبدِّل","explicit":true,"star":true,"ref":"سورة البقرة: 181","srcLabel":"القرآن الكريم","quran":{"s":2,"from":181,"to":181,"text":"فَمَنْ بَدَّلَهُ بَعْدَمَا سَمِعَهُ فَإِنَّمَا إِثْمُهُ عَلَى الَّذِينَ يُبَدِّلُونَهُ إِنَّ اللَّهَ سَمِيعٌ عَلِيمٌ (181)","hl":[[0,116,1]]}},{"id":"ق-0998","fp":"044aa199ec73","stateId":115,"easy":"إيذاء المؤمنين والمؤمنات بغير ما اكتسبوا ← بهتان وإثم مبين","cause":"إيذاء المؤمنين والمؤمنات بغير ما اكتسبوا","result":"بهتان وإثم مبين","explicit":true,"ref":"سورة الأحزاب: 58","srcLabel":"القرآن الكريم","quran":{"s":33,"from":58,"to":58,"text":"وَالَّذِينَ يُؤْذُونَ الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ بِغَيْرِ مَا اكْتَسَبُوا فَقَدِ احْتَمَلُوا بُهْتَانًا وَإِثْمًا مُبِينًا (58)","hl":[[0,127,1]]}},{"id":"س-05290","fp":"8ed7b94e1a37","stateId":115,"easy":"إذا روّعت مسلماً ← فهو ظلم عظيم","cause":"لا تُرَوِّعوا المُسلِمَ","result":"فإنَّ رَوعةَ المُسلِمِ ظُلمٌ عظيمٌ","explicit":true,"ref":"فيض القدير 6/ 395","srcLabel":"مسلم","text":[["لا تُرَوِّعوا المُسلِمَ؛ ",1],["فإنَّ رَوعةَ المُسلِمِ ظُلمٌ عظيمٌ",2]],"grade":"حسن","narrator":"عامر بن ربيعة","muhaddith":"رمز السيوطي لحسنه وهو غير مسلم فقد أعله الهيثمي","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"XfvAWK9q"},{"id":"س-03825","fp":"2a7aeb2a5dfd","stateId":115,"easy":"إذا أشرت على أخيك بأمر تعلم أن الصواب غيره ← فقد خنته","cause":"ومَنْ أشارَ على أخيهِ بأمْرٍ يعلمُ أنَّ الرُّشْدَ في غيرِهِ","result":"فقدْ خانَهُ","explicit":true,"similar":["س-04994"],"ref":"الجامع الصغير 8471","srcLabel":"الحاكم","text":["مَنْ أُفْتِىَ بِغيرِ عِلمٍ كان إثْمُهُ على مَنْ أفْتاهُ ، ",["ومَنْ أشارَ على أخيهِ بأمْرٍ يعلمُ أنَّ الرُّشْدَ في غيرِهِ ",1],["فقدْ خانَهُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داوود (3657)، والحاكم في ((مستدركه)) (350)، والطحاوي في ((مشكل الآثار)) (410) واللفظ لهم.","bab":"بر وصلة › حق المسلم على المسلم","dorar":"dZMyAcHT"},{"id":"س-04994","fp":"4c1de42ee9db","stateId":115,"easy":"إذا استشارك أخوك فأشرت عليه بغير الصواب ← فقد خنته","cause":"ومَن اسْتَشارَه أخوه المُسلِمُ فأشارَ عليه بغَيْرِ رُشْدٍ","result":"فقد خانَه","explicit":true,"repOf":"س-03825","ref":"الصحيح المسند 1336","text":["مَن قالَ علَيَّ ما لم أَقُلْ فلْيَتَبَوَّأْ مَقعَدَه مِن النَّارِ، ",["ومَن اسْتَشارَه أخوه المُسلِمُ فأشارَ عليه بغَيْرِ رُشْدٍ ",1],["فقد خانَه، ",2],"ومَن أَفْتى فُتْيا بغَيْرِ تَثَبُّتٍ فإنَّ إثْمَها على مَن أَفْتاه."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه أحمد (8266)، وإسحاق في ((مسنده)) (334)، وابن بشران في ((أماليه-الجزء الأول)) (5) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"bRn4ELEr"},{"id":"س-08049","fp":"1424712e4882","stateId":115,"easy":"إذا اقتطعت ذراعاً من أرض أخيك ← فهو من أظلم الظلم","cause":"ذِراعٌ مِنَ الأرضِ يَنتَقِصُها المَرءُ المُسلمُ مِن حَقِّ أخيه","result":"أيُّ الظُّلمِ أظلمُ","explicit":true,"ref":"تنبيه الغافلين 255","srcLabel":"أحمد","text":["عن ابنِ مَسعودٍ رَضيَ اللهُ عنه، قال: قُلتُ: يا رسولَ اللَّهِ، ",["أيُّ الظُّلمِ أظلمُ",2],"؟ فقال: «",["ذِراعٌ مِنَ الأرضِ يَنتَقِصُها المَرءُ المُسلمُ مِن حَقِّ أخيه",1],"، فليسَ حَصاةٌ مِنَ الأرضِ يَأخُذُها إلَّا طُوِّقَها يَومَ القيامةِ إلى قَعرِ الأرضِ، ولا يَعلمُ قَعرَها إلَّا الذي خَلقَها»"],"grade":"حسن","narrator":"ابن مسعود","muhaddith":"إسناده حسن.","takhrij":"أخرجه أحمد (3767)، والطبراني في ((الكبير)) (10/ 216) (10516) واللفظ لهما.","bab":"مظالم › تحريم الظلم","dorar":"lx7LXXuh"},{"id":"س-07394","fp":"2661b37afbfe","stateId":116,"easy":"إذا أجعت دابتك وأتعبتها ← فاتقِ الله في البهيمة","cause":"أنَّك تُجيعُه وتُدْئِبُه","result":"أَفلا تَتَّقي اللهَ في هذه البَهيمةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[28],"ref":"الأحاديث المختارة 9 / 158","srcLabel":"متفق عليه","text":["«أَرْدَفَني رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ذاتَ يَوْمٍ خَلْفَه، فأَسَرَّ إليَّ حَديثًا لا أُحَدِّثُ به أحَدًا مِن النَّاسِ، وكانَ أحَبَّ ما اسْتَتَرَ به رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ لحاجتِه هَدَفٌ أو حائِشُ نَخْلٍ، فدَخَلَ حائِطًا لرَجُلٍ مِن الأنْصارِ، فإذا فيه جَمَلٌ، فلمَّا رأى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ حَنَّ وذَرَفَتْ عَيْناه، قالَ: فأتاه النَّبيُّ صلَّى اللهُ عليه وسلَّمَ فمَسَحَ سَراتَه إلى سَنامِه وذِفْراه، فسَكَنَ، فقالَ: مَن رَبُّ هذا الجَمَلِ؟ لِمَن هذا الجَمَلُ؟ فجاءَ فَتًى مِن الأنْصارِ فقالَ: هو لي يا رَسولَ اللهِ، قالَ: ",["أَفلا تَتَّقي اللهَ في هذه البَهيمةِ",2]," الَّتي مَلَّكَك اللهُ إيَّاها؟ فإنَّه شَكا إليَّ ",["أنَّك تُجيعُه وتُدْئِبُه",1],"».\nوفي رِوايةٍ: عن … ذاتَ يَوْمٍ فأَسَرَّ إليَّ، لم يَقُلْ: خَلْفَه، وعِنْدَه: فدَخَلَ حائِطَ رَجُلٍ مِن الأنْصارِ فإذا جَمَلٌ، وعِنْدَه: سَراتَه وذِفْرَيه فسَكَنَ، ثُمَّ قالَ: لمَن هذا الجَمَلُ؟ وعِنْدَه: فإنَّه شَكاك إليَّ أنَّك تُجيعُه وتُدْئِبُه."],"grade":"صحيح","narrator":"عبدالله بن جعفر بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"فضائل النبي وصفته ودلائل النبوة › أدب الحيوانات معه صلى الله عليه وسلم ومعرفته بلغتها","dorar":"HAoLZdtm"},{"id":"س-07430","fp":"f7bfa2814f00","stateId":116,"easy":"إذا قتلت عصفوراً عبثاً ← يشكوك إلى الله يوم القيامة","cause":"مَن قتَل عصفورًا عبَثًا","result":"عجَّ إلى اللهِ يومَ القيامةِ يقولُ: يا ربِّ إنَّ فلانًا قتَلني عبَثًا ولم يقتُلْني منفعةً","explicit":true,"similar":["س-07862"],"ref":"صحيح ابن حبان 5894","srcLabel":"النسائي","text":[["مَن قتَل عصفورًا عبَثًا",1]," ",["عجَّ إلى اللهِ يومَ القيامةِ يقولُ: يا ربِّ إنَّ فلانًا قتَلني عبَثًا ولم يقتُلْني منفعةً",2]],"grade":"صحيح","narrator":"الشريد بن سويد الثقفي","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه النسائي (4446)، وأحمد (19470)، والطبراني (7 / 317) (7245 )، واللفظ لهم جميعا","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"02pGdAI3"},{"id":"س-07852","fp":"1c62cd6fe0f9","stateId":116,"easy":"إذا قتلت عصفوراً فما فوقه بغير حق ← يسألك الله عنه يوم القيامة","cause":"ما من إنسانٍ يقتلُ عُصفورًا فما فوقها بغيرِ حقِّها","result":"إلَّا يسألُ اللهُ عنها يومَ القيامةِ","explicit":true,"similar":["س-07219"],"otherNeedIds":[70],"ref":"الترغيب والترهيب 3/213","srcLabel":"النسائي","text":[["ما من إنسانٍ يقتلُ عُصفورًا فما فوقها بغيرِ حقِّها",1]," ",["إلَّا يسألُ اللهُ عنها يومَ القيامةِ",2]," قال حقُّها أن تذبَحها فتأكلَها ولا تقطعْ رأسَها فترميَ به"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه النسائي (4349)، والحاكم (7574) باختلاف يسير، وأحمد (6551) بنحوه.","bab":"قيامة › الحساب والقصاص","dorar":"VUzYRg87"},{"id":"س-07862","fp":"c3e6fc3c080f","stateId":116,"easy":"إذا قتلت عصفوراً عبثاً ← يشكوك إلى الله يوم القيامة","cause":"ما قُتِلَ عُصفورٌ قَطُّ عَبَثًا","result":"إلَّا عجَّ إلى اللهِ عزَّ وجلَّ يومَ القِيامةِ: يا ربِّ، فُلانٌ قتَلني، فلا هو انتفَع بي، ولا هو ترَكني أعيشُ في خُشَاراتِها","explicit":true,"repOf":"س-07430","ref":"تخريج مشكل الآثار 873","text":["عُصفورٌ قَطُّ، قال أبو جَعفَرٍ: كأنَّه يعني: ",["ما قُتِلَ عُصفورٌ قَطُّ عَبَثًا",1],"، قال أبو بكْرٍ: فما فَوْقَهُ، أو فما دُونَهُ ",["إلَّا عجَّ إلى اللهِ عزَّ وجلَّ يومَ القِيامةِ: يا ربِّ، فُلانٌ قتَلني، فلا هو انتفَع بي، ولا هو ترَكني أعيشُ في خُشَاراتِها",2],"."],"grade":"صحيح","narrator":"الشريد بن سويد الثقفي","muhaddith":"إسناده قوي، رجاله رجال الصحيح غير أبان بن صالح، فقد روى لهُ أصحاب السنن، وهو ثقة","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (873) واللفظ له، والبغوي في ((معجم الصحابة)) (1240) باختلاف يسير.","bab":"قيامة › الحساب والقصاص","dorar":"XNbs3u0a"},{"id":"س-07219","fp":"6abfca5e0bfd","stateId":116,"easy":"إذا قتلت عصفوراً فما فوقه بغير حق ← يسألك الله عنه","cause":"ما مِن إنسانٍ يَقتُلُ عُصفورًا فما فَوقَه بغَيرِ حقِّه","result":"إلَّا سَأَلَه اللهُ عزَّ وجلَّ عنْها","explicit":true,"repOf":"س-07852","ref":"تخريج زاد المعاد 4/350","text":[["ما مِن إنسانٍ يَقتُلُ عُصفورًا فما فَوقَه بغَيرِ حقِّه",1],"، ",["إلَّا سَأَلَه اللهُ عزَّ وجلَّ عنْها",2],". قيل: يا رسولَ اللهِ، وما حَقُّه؟ قال: تَذبَحُه فتَأكُلُه، ولا تَقطَعُ رأْسَه وتَرْمي به."],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"[فيه] صهيب مولى ابن عامر لم يوثقه غير ابن حبان، وباقي رجاله ثقات [وله شاهد يتقوى به]","takhrij":"أخرجه النسائي (4349)، وأحمد (6551)، والدارمي (2021) باختلاف يسير.","bab":"علم › حسن السؤال ونصح العالم","dorar":"e2U56Tab"},{"id":"س-00466","fp":"ea0e6eb0cbe7","stateId":116,"easy":"إذا ظلمت البهائم وحمّلتها ما لا تطيق ← تُكتب عليك ذنوب عظيمة","cause":"ما تأتونَ إلى البهائمِ","result":"لئِنْ غفَر اللهُ لكم مِثلَ ما تأتونَ إلى البهائمِ لَيَغفِرَنَّ لكم عظيمًا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"similar":["س-03316"],"ref":"إتحاف الخيرة المهرة 3/147","srcLabel":"إتحاف الخيرة المهرة","text":["أنَّ أبا الدرداءِ , رضي اللهُ عنه , مرَّ بقومٍ قد أناخوا بعيرًا فحمَّلوه غرارتَينِ ثم علَوه بأخرى فلم يستطِعِ البعيرُ أن يَنهَضَ , فألقاها أبو الدرداءِ عنِ البعيرِ , ثم أنهضَه ، فانتَهَض ثم قال أبو الدرداءِ : ",["لئِنْ غفَر اللهُ لكم مِثلَ ما تأتونَ إلى البهائمِ لَيَغفِرَنَّ لكم عظيمًا",2]," , إني سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ : إنَّ اللهَ يوصيكم بهذه العجمِ خيرًا أن تنزِلوا بها منازِلَها , فإذا أصابَتْكم سنةٌ أن تُنَحُّوا عنها نقيَّها"],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"رجاله ثقات، وله شاهد","bab":"آداب عامة › الرفق بالحيوان والطير ونحوهما","dorar":"B19LjRW7"},{"id":"س-03316","fp":"9d4878483949","stateId":116,"easy":"إذا ظلمت البهائم ← يُكتب عليك ذنب كثير","cause":"ما تَأْتُونَ إلى البَهائِمِ","result":"لَغُفِرَ لَكُمْ كَثِيرًا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-00466","ref":"صحيح الترغيب 2476","text":["لَوْ غُفِرَ لَكُمْ ",["ما تَأْتُونَ إلى البَهائِمِ",1]," ؛ ",["لَغُفِرَ لَكُمْ كَثِيرًا",2]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"حسن","takhrij":"أخرجه أحمد (27486)، والبيهقي في ((شعب الإيمان)) (5188)","bab":"استغفار › أسباب المغفرة","dorar":"x8APJxp7"},{"id":"س-04952","fp":"07686eee3558","stateId":117,"easy":"إذا أخذت الربا أو أعطيته ← فأنتما سواء في الإثم","cause":"الآخِذُ والمُعْطي","result":"سَواءٌ في الرِّبا","explicit":true,"ref":"تخريج سنن الدارقطني 2879","srcLabel":"مسلم","text":[["الآخِذُ والمُعْطي",1]," ",["سَواءٌ في الرِّبا",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1584) مطولاً باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"MCGZDzZN"},{"id":"س-00483","fp":"52e220090495","stateId":117,"easy":"إذا زدت في مبادلة الأصناف الربوية ← فقد أربيت","cause":"فمن زادَ أوِ ازدادَ","result":"فقد أربى","explicit":true,"ref":"الوهم والإيهام 5/441","srcLabel":"أبو داود","text":["حديثُ عُبادةَ بزيادةِ : ولا بأسَ ببيعِ البُرِّ بالشَّعيرِ والشَّعيرُ أَكثرُهُما [يعني حديث: الذَّهبُ بالذَّهبِ تبرُها وعينُها ، والفضَّةُ بالفضَّةِ تبرُها وعينُها ، والبُرُّ بالبُرِّ مُديٌ بمديٍ، والشَّعيرُ بالشَّعيرِ مديٌ بمديٍ، والتَّمرُ بالتَّمرِ مديٌ بمديٍ، والملحُ بالملحِ مديٌ بمديٍ، ",["فمن زادَ أوِ ازدادَ",1]," ",["فقد أربى",2],"، ولا بأسَ ببيعِ الذَّهبِ، بالفضَّةِ والفضَّةُ أَكثرُهما يدًا بيدٍ ، وأمَّا نسيئةً فلا، ولا بأسَ ببيعِ البرِّ بالشَّعير، والشَّعيرُ ( بالبُرِّ ) أَكثرُهما يدًا بيدٍ ، وأمَّا نسيئةً فلا]"],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"حسن أو صحيح","takhrij":"أخرجه أبو داود (3349)، والنسائي (4563)، والطحاوي في ((شرح معاني الآثار)) (5481)، والشاشي في ((المسند)) (1242) واللفظ لهم جميعا.","bab":"آداب عامة › المباحات من الأفعال والأقوال","dorar":"G3C4BWZA","merged":5,"otherRefs":["تخريج سنن الدارقطني 2854 (صحيح)","نخب الافكار 11/334 (صحيح)","نخب الافكار 14/305 (صحيح)"]},{"id":"س-04888","fp":"01a3e4339e0f","stateId":117,"easy":"إذا أكلت الربا ← فأدناه مثل أن ينكح الرجل أمه","cause":"الربا","result":"اثنانِ و سبعونَ بابًا أدناها مثلُ إتيانِ الرجلِ أمَّهُ","explicit":true,"ref":"الجامع الصغير 4490","srcLabel":"الطبراني","text":[["الربا",1]," ",["اثنانِ و سبعونَ بابًا أدناها مثلُ إتيانِ الرجلِ أمَّهُ",2],"،  و إنَّ أَرْبَى الربا استطالةُ الرجلِ في عرضِ أخيهِ"],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي حاتم في ((المراسيل)) (916 )، والطبراني في ((المعجم الأوسط)) (7151 )،","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"0xVrMMY5","merged":5,"otherRefs":["صحيح الترغيب 1853 (صحيح)","صحيح الترغيب 1858 (صحيح)","هداية الرواة 2755 (صحيح)","صحيح الجامع 1531 (صحيح)"]},{"id":"س-04839","fp":"06f91a644a54","stateId":117,"easy":"إذا اتخذت فرساً للمراهنة والقمار ← فثمنه وعلفه وركوبه وزر عليك","cause":"فرسٌ يغالق عليه الرجلُ ويراهِنُ","result":"فثمنُه وِزرٌ ، [ وعلفُه وزرٌ ] ، وركوبُه وزرٌ","explicit":true,"otherNeedIds":[70],"ref":"صحيح الترغيب 1243","srcLabel":"أحمد","text":["الخيلُ ثلاثةٌ : فرسٌ يرتبطُه الرجلُ في سبيلِ اللهِ عزَّ وجلَّ ، فثمنُه أجرٌ ، وركوبُه أجرٌ ، وعاريتُه أجرٌ ، [ وعلَفُه أجرٌ ] . و",["فرسٌ يغالق عليه الرجلُ ويراهِنُ",1]," ، ",["فثمنُه وِزرٌ ، [ وعلفُه وزرٌ ] ، وركوبُه وزرٌ",2]," . وفرسٌ للبَطْنةِ ، فعسى أن يكونَ سِدادًا من الفقرِ إن شاء اللهُ ."],"grade":"صحيح","narrator":"رجل من الأنصار","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي شيبة (993 ) في ((المسند))، وأحمد (23230 )،والحارث ابن أبي أسامة كما في ((بغية الباحث عن زوائد مسند الحارث)) (649 )،وأبو نعيم في ((معرفة الصحابة)) (7153 )","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"NaVEVj05","merged":2,"otherRefs":["مجمع الزوائد 5/263 (صحيح)"]},{"id":"س-04854","fp":"543c154a6af9","stateId":117,"easy":"إذا أكلت درهماً من الربا ← فهو أعظم عند الله من ست وثلاثين زنية","cause":"الدِّرهمَ يُصيبُه الرَّجلُ من الرِّبا","result":"أعظمُ عند اللهِ في الخطيئةِ من ستٍّ وثلاثين زنْيةً يزنيها الرَّجلُ","explicit":true,"ref":"الترغيب والترهيب 3/68","srcLabel":"البيهقي","text":["خطَبنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فذكر أمرَ الرِّبا وعظَّم شأنَه وقال إنَّ ",["الدِّرهمَ يُصيبُه الرَّجلُ من الرِّبا",1]," ",["أعظمُ عند اللهِ في الخطيئةِ من ستٍّ وثلاثين زنْيةً يزنيها الرَّجلُ",2]," وإنَّ أربَى الرِّبا عِرضُ الرَّجلِ المسلمِ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن أبي الدنيا في ((الصمت)) (175)، وابن عدي في ((الكامل في الضعفاء)) (4/233)، والبيهقي في ((شعب الإيمان)) (5523).","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"esgWECQk","merged":2,"otherRefs":["صحيح الجامع 3375 (صحيح)"]},{"id":"س-02983","fp":"5819a952ecfc","stateId":117,"easy":"إذا شفعت لأحد فأهدى لك هدية فقبلتها ← أتيت باباً عظيماً من الربا","cause":"مَن شَفَعَ لأخيه شَفاعةً، وأَهْدى له هَديَّةً","result":"فقد أتى بابًا عَظيمًا مِن أبْوابِ الرِّبا","explicit":true,"ref":"الأحكام الوسطى 3/ 340","srcLabel":"أبو داود","text":[["مَن شَفَعَ لأخيه شَفاعةً، وأَهْدى له هَديَّةً ",1],["فقد أتى بابًا عَظيمًا مِن أبْوابِ الرِّبا",2],"."],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (3541)، وأحمد (22251)، والطبراني (8/ 211) (7853) بلفظه.","bab":"إيمان › الوعيد","dorar":"v0oVaQTj"},{"id":"س-07717","fp":"7f7e6fd3bbf5","stateId":117,"easy":"إذا نجشت (زايدت لترفع السعر لا لتشتري) ← فأنت آكل ربا خائن","cause":"النَّاجِشُ","result":"آكِلُ رِبًا خائِنٌ","explicit":true,"ref":"صحيح البخاري 2675","srcLabel":"الحاكم","text":["سَمِعَ عَبدَ اللهِ بنَ أبي أوفى رَضيَ اللهُ عنهما يقولُ: أقامَ رَجُلٌ سِلعَتَه، فحَلَفَ باللهِ لقد أعطى بها ما لَم يُعطِها، فنَزَلَت: {إنَّ الذينَ يَشتَرونَ بعَهدِ اللهِ وأيمانِهم ثَمَنًا قَليلًا} [آل عمران: 77]، وقال ابنُ أبي أوفى: ",["النَّاجِشُ",1]," ",["آكِلُ رِبًا خائِنٌ",2],"."],"grade":"صحيح","narrator":"عبدالله بن أبي أوفى","muhaddith":"[صحيح]","takhrij":"أخرجه الدولابي في ((الكنى والأسماء)) (514)، والطبراني في ((المعجم الأوسط)) (7867)، والحاكم (2151) واللفظ لهم جميعا.","bab":"قرآن › أسباب النزول","dorar":"HIDHjBvq"},{"id":"س-05039","fp":"788b76388809","stateId":117,"easy":"إذا اتخذت الخيل للقمار والرهان ← فهي فرس الشيطان","cause":"فالذي يُقامَرُ أو يُراهَنُ عليه","result":"فرسُ الشيطانِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"غاية المرام 392","srcLabel":"غاية المرام","text":["الخيلُ ثلاثةٌ : فرس ٌللرحمنِ . وفرسٌ للإنسانِ , و فرسٌ للشيطانِ . فأما فرسُ الرحمنِ فالذي يرتبطُ في سبيلِ اللهِ ، فعلفُه و روثُه و بولُه , و ذكر ما شاء اللهُ - يعني إنَّ كلَّ ذلك له حسناتٌ - و أما ",["فرسُ الشيطانِ",2]," ",["فالذي يُقامَرُ أو يُراهَنُ عليه",1]," . و أما فرسُ الإنسانِ فالذي يرتبطُه الإنسانُ يلتمسُ بطنَها - أي للنتاجِ - فهى سترٌ من فقرٍ"],"grade":"صحيح","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"TGiGIY8T","merged":2,"otherRefs":["صحيح الجامع 3350 (صحيح)"]},{"id":"س-04957","fp":"0fde5e48d6f8","stateId":118,"easy":"إذا اعتديت في أخذ الصدقة (وأنت عامل عليها) ← فأنت كمانعها","cause":"المعتَدي في الصَّدقةِ","result":"كمانعِها","explicit":true,"ref":"صحيح ابن خزيمة 4/ 88","srcLabel":"ابن خزيمة","text":["لا إيمانَ لمَن لا أمانَ لَهُ، و",["المعتَدي في الصَّدقةِ",1]," ",["كمانعِها",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أخرجه في صحيحه","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"OfcDAJGE","merged":3,"otherRefs":["صحيح أبي داود 1585 (حسن)","الوهم والإيهام 4/213 (حسن)"]},{"id":"س-04984","fp":"414009817466","stateId":118,"easy":"إذا أخذت من عمل الدولة غير ما فُرض لك ← فأنت غالّ أو سارق","cause":"مَن اتَّخَذَ غَيْرَ ذلك","result":"فهو غالٌّ أو سارِقٌ","explicit":true,"ref":"الأحكام الوسطى 2/ 377","srcLabel":"أبو داود","text":["مَن كانَ لنا عامِلًا فلْيَكْتَسِبْ زَوْجةً، فإن لم يكنْ له خادِمٌ فلْيَكْتَسِبْ له خادِمًا، فإن لم يكنْ له مَسكَنٌ فلْيَكْتَسِبْ مَسكَنًا\"، قالَ: قالَ أبو بَكْرٍ: أُخبِرْتُ أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قالَ: \"",["مَن اتَّخَذَ غَيْرَ ذلك",1]," ",["فهو غالٌّ أو سارِقٌ",2],"\"."],"grade":"صحيح","narrator":"المستورد","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (2945)، وابن خزيمة (2370)، والطبراني (727) (20/  305) واللفظ لهم","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"nT38z2NR","merged":3,"otherRefs":["تخريج المسند لشعيب 18015 (صحيح)","تخريج المسند لشعيب 18019 (صحيح)"]},{"id":"س-02570","fp":"9dfb72cc245d","stateId":118,"easy":"إذا أخذت الهدية وأنت أمير ← فهي سحت","cause":"أخذُ الأميرِ الهديَّةَ","result":"سُحتٌ","explicit":true,"ref":"الجامع الصغير 288","srcLabel":"أحمد","text":[["أخذُ الأميرِ الهديَّةَ",1]," ",["سُحتٌ",2]," وقبولُ القاضي الرِّشوةَ كُفرٌ"],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"حسن","takhrij":"أخرجه أحمد في ((الزهد)) كما في ((الجامع الصغير)) للسيوطي (‌‌1244) واللفظ له.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"LZyyLOrD"},{"id":"س-05054","fp":"671134a4b099","stateId":118,"easy":"إذا أخذت هدية بسبب وظيفتك ← فهي غلول","cause":"هَدايا العُمَّالِ","result":"غُلولٌ","explicit":true,"ref":"خلاصة البدر المنير 2/430","srcLabel":"أحمد","text":[["هَدايا العُمَّالِ",1]," ",["غُلولٌ",2],"."],"grade":"حسن","narrator":"أبو حميد الساعدي","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (23601)، والبزار (3723)، والطبراني كما في ((مجمع الزوائد)) للهيثمي (5/252)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"3P4FYd4Z"},{"id":"س-02493","fp":"a7ce11698ec7","stateId":118,"easy":"إذا وُليت عملاً فأخذت سوى رزقك ← فهو غلول","cause":"فما أَصابَ سِوى رِزْقِه","result":"فهو غُلولٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-02494"],"ref":"الأحكام الوسطى 2/184","srcLabel":"أبو داود","text":["مَن اسْتَعْمَلْناه على عَمَلٍ، فرَزَقْناه عليه رِزْقًا، ",["فما أَصابَ سِوى رِزْقِه",1]," ",["فهو غُلولٌ",2],"."],"grade":"صحيح","narrator":"بريدة","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (2943)، وابن خزيمة (2369)، والحاكم (1472) واللفظ لهم","bab":"إمامة وخلافة › تولية الولاة وغيرهم","dorar":"HB05JcV5"},{"id":"س-02494","fp":"feb77f197627","stateId":118,"easy":"إذا وُليت عملاً فأخذت فوق ما رُزقت ← فهو غلول","cause":"فما أَخَذَ بَعْدَ ذلك","result":"فهو غُلولٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-02493","ref":"الأحكام الوسطى 2/ 377","text":["مَن اسْتَعْمَلْناه على عَمَلٍ فرَزَقْناه رِزْقًا ",["فما أَخَذَ بَعْدَ ذلك",1]," ",["فهو غُلولٌ",2],"."],"grade":"صحيح","narrator":"بريدة بن خصيب","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (2943)، والبزار (4427)، وابن خزيمة (2369) واللفظ لهم","bab":"إمامة وخلافة › تولية الولاة وغيرهم","dorar":"m29fa8LD"},{"id":"س-08025","fp":"3a6c22c17118","stateId":119,"easy":"إذا ماطلت في سداد الدين وأنت غني ← فهو ظلم","cause":"مَطْلُ الغَنِيِّ","result":"ظُلْمٌ","explicit":true,"star":true,"ref":"المحلى 8/169","srcLabel":"متفق عليه","text":[["مَطْلُ الغَنِيِّ",1]," ",["ظُلْمٌ",2]," [فإذا أُتْبِعَ أحَدُكُمْ علَى مَلِيٍّ فَلْيَتْبَعْ .]"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"احتج به ، وقال في المقدمة: (لم نحتج إلا بخبر صحيح من رواية الثقات مسند)","takhrij":"أخرجه البخاري (2288)، ومسلم (1564)، وأبو داود (3345) واللفظ لهم.","bab":"مظالم › تحريم الظلم","dorar":"mcUAxatY","merged":3,"otherRefs":["ذخيرة الحفاظ 4/2152 (صحيح)","تخريج المسند لشعيب 7336 (صحيح)"]},{"id":"س-02593","fp":"c1b86871c924","stateId":119,"easy":"إذا احتكرت ← فأنت خاطئ","cause":"مَنِ احتَكَرَ","result":"فهو خاطِئٌ","explicit":true,"star":true,"otherNeedIds":[28],"ref":"صحيح مسلم 1605","srcLabel":"متفق عليه","text":[["مَنِ احتَكَرَ ",1],["فهو خاطِئٌ",2],". فقيلَ لسَعيدٍ: فإنَّك تَحتَكِرُ! قال سَعيدٌ: إنَّ مَعمَرًا الذي كانَ يُحَدِّثُ هذا الحَديثَ كانَ يَحتَكِرُ."],"grade":"صحيح","narrator":"معمر بن عبدالله بن نضلة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"إيمان › أعمال تنافي الإيمان","dorar":"yx9tdXlR","merged":2,"otherRefs":["صحيح مسلم 1605 (صحيح)"]},{"id":"س-04590","fp":"e231e13675df","stateId":119,"easy":"إذا سرقت من بيت جارك ← فهو أشد من السرقة من عشرة بيوت","cause":"أن يسرقَ من بيتِ جارِه","result":"لَأَنْ يسرقَ من عشرةِ أهلِ أبياتٍ ، أيسرُ عليه","explicit":true,"star":true,"ref":"صحيح الأدب المفرد 76","srcLabel":"البخاري","text":["لأَنْ يزنيَ الرجلُ بعشرِ نِسوةٍ ، أيسرُ عليه من أنْ يزنيَ بامرأةِ جارِه . و سألهم عن السرقةِ ؟ قالوا حرامٌ ؛ حرَّمه اللهُ عزَّ و جلَّ و رسولُه ، فقال : ",["لَأَنْ يسرقَ من عشرةِ أهلِ أبياتٍ ، أيسرُ عليه",2]," من ",["أن يسرقَ من بيتِ جارِه",1]],"grade":"صحيح","narrator":"المقداد بن عمرو بن الأسود","muhaddith":"صحيح","takhrij":"أخرجه أحمد (23854)، والبخاري في ((الأدب المفرد)) (103) واللفظ له، والبزار (2115)","bab":"حدود › تحريم السرقة","dorar":"UkKIcUqd","merged":2,"otherRefs":["صحيح الجامع 5043 (صحيح)"]},{"id":"س-01812","fp":"caaf35870737","stateId":119,"easy":"إذا جعلت في فمك ما حرّم الله ← فلأن تأكل تراباً خير لك","cause":"أنْ يَـجْعَلَ في فِيهِ ما حَرَّمَ اللهُ عليه","result":"ولَأَنْ يأْخُذَ تُرابًا، فيَجْعَلَه في فيه؛ خَيْرٌ له","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 7490","srcLabel":"متفق عليه","text":["والذي نَفْسي بِيَدِه، لأَنْ يَأْخُذَ أَحَدُكم حَبْلَه، فيَذْهَبَ إلى الـجَبَلِ، فيحْتَطِبَ، ثم يَأْتيَ به يَـحمِلُه على ظَهْرِه، فيَبِيعَه، فيأْكُلَ؛ خَيرٌ له مِن أنْ يَسْأَلَ النَّاسَ، ",["ولَأَنْ يأْخُذَ تُرابًا، فيَجْعَلَه في فيه؛ خَيْرٌ له",2]," مِن ",["أنْ يَـجْعَلَ في فِيهِ ما حَرَّمَ اللهُ عليه",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1480) باختلاف يسير، ومسلم (1042) مطولاً","bab":"إجارة › كسب الرجل وعمله بيده","dorar":"jaxmhbCQ"},{"id":"س-05168","fp":"e83c83b0b578","stateId":119,"easy":"إذا آويت ضالة ولم تعرّفها ← فأنت ضال","cause":"مَنْ آوَى ضالَّةً","result":"فهو ضالٌّ ، ما لمْ يُعَرِّفْها","explicit":true,"similar":["س-05293"],"ref":"صحيح الجامع 5926","srcLabel":"مسلم","text":[["مَنْ آوَى ضالَّةً",1]," ",["فهو ضالٌّ ، ما لمْ يُعَرِّفْها",2]],"grade":"صحيح","narrator":"زيد بن ثابت","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1725)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"jRKRcafv"},{"id":"س-07795","fp":"ec94facff2a0","stateId":119,"easy":"إذا كنت تاجراً تحلف وتأثم ← تكون من الفجّار","cause":"يحلِفونَ ويأثَمونَ","result":"إنَّ التُّجَّارَ همُ الفُجَّارُ","explicit":true,"ref":"مجمع الزوائد 8/39","srcLabel":"أحمد","text":["تعلَّموا القرآنَ فإذا علِمْتُموه فلا تغلُوا فيه ولا تجفُوا عنه ولا تأكُلوا به ولا تستكثِروا به ثُمَّ قال ",["إنَّ التُّجَّارَ همُ الفُجَّارُ",2]," قالوا يا رسولَ اللهِ أليس قد أحلَّ اللهُ البيعَ وحرَّم الرِّبا قال بلى ولكنَّهم ",["يحلِفونَ ويأثَمونَ",1]," ثُمَّ قال إنَّ الفُسَّاقَ هم أهلُ النَّارِ قالوا يا رسولَ اللهِ مَن الفُسَّاقُ قال النِّساءُ قالوا أو ليس أمَّهاتِنا وبناتِنا وأخواتِنا قال بلى ولكنَّهنَّ إذا أُعطِينَ لم يشكُرْنَ وإن ابتُلِينَ لم يصبِرْنَ ثُمَّ قال يُسلِّمُ الرِّاكبُ على الرَّاجلِ والرَّاجلُ على الجالسِ والأقلُّ على الأكثرِ فمَن أجاب السَّلامَ كان له ومَن لم يُجِبْ فلا شيءَ له"],"grade":"صحيح","narrator":"عبدالرحمن بن شبل","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (15704)، وعبد بن حميد في ((مسنده)) (314)، والبيهقي (2362)","bab":"قرآن › تعلم القرآن وتعليمه","dorar":"1qQvD5R8","merged":3,"otherRefs":["تخريج مشكل الآثار 2078 (صحيح)","السلسلة الصحيحة 366 (صحيح)"]},{"id":"س-02690","fp":"66343101f5ea","stateId":119,"easy":"إذا اقترضت من أخيك ظالماً (تنوي ألا ترد) ← هلكت وحرجت","cause":"منِ اقترضَ من أخيهِ مَظلومًا","result":"فذلِكَ الَّذي حَرِجَ وَهَلَكَ","explicit":true,"ref":"نخب الافكار 10/148","srcLabel":"الطبراني","text":["أنَّ الأعرابَ سألوا رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ، عَن أشياءَ، ثمَّ قالوا: هَل علَينا حرجٌ في كذا ؟ وَهَل علَينا حرجٌ في كذا ؟ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: إنَّ اللَّهَ تعالى قد رفعَ الحرجَ عن عِبادِهِ، إلَّا ",["منِ اقترضَ من أخيهِ مَظلومًا، ",1],["فذلِكَ الَّذي حَرِجَ وَهَلَكَ",2]],"grade":"صحيح","narrator":"أسامة بن شريك","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن خزيمة (2774)، والطبراني (1/ 181) (472) بلفظه.","bab":"إيمان › الدين يسر","dorar":"R7cveiPi"},{"id":"س-04816","fp":"9365b079cafd","stateId":119,"easy":"إذا كنت تاجراً ولم تتقِ ولم تبرّ ولم تصدق ← تكون من الفجّار","cause":"إلا منِ اتَّقَى وبرَّ وصدقَ","result":"إنَّ التُّجَّارَ همُ الفُجَّارُ","explicit":true,"ref":"مسند علي 47","srcLabel":"الترمذي","text":["خرج مع النبيِّ صلَّى اللهُ عليه وسلَّم إلى البقيعِ فقال يا معشرَ التُّجَّارِ ألا ",["إنَّ التُّجَّارَ همُ الفُجَّارُ",2]," ",["إلا منِ اتَّقَى وبرَّ وصدقَ",1]],"grade":"صحيح","narrator":"رفاعة بن رافع","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (1210)، وابن ماجه (2146)، والدارمي (2580)، وابن حبان (4910) جميعا بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"lZeHZhGs"},{"id":"س-07830","fp":"8f76846a349b","stateId":119,"easy":"إذا تزوجت امرأة وأنت تنوي ألا تؤدي صداقها ← فأنت زانٍ","cause":"مَن تَزوَّجَ امرَأةً على صَداقٍ ، وهوَ يَنوي أن لا يُؤَدِّيَه إليها","result":"فهوَ زَانٍ","explicit":true,"ref":"صحيح الترغيب 1806","srcLabel":"ابن حبان","text":[["مَن تَزوَّجَ امرَأةً على صَداقٍ ، وهوَ يَنوي أن لا يُؤَدِّيَه إليها ؛ ",1],["فهوَ زَانٍ ، ",2],"ومَن ادَّانَ دَينًا وهوَ يَنوي أن لا يُؤَدِّيَه إلى صَاحِبِه أَحسِبُه قال : ؛ فهوَ سارِقٌ ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه البزار (8721)، والعقيلي في ((الضعفاء الكبير)) (4/21)، وابن حبان في ((المجروحين)) (2/195) باختلاف يسير.","bab":"قرض › الترهيب من الدين","dorar":"ErsCGrVO"},{"id":"س-05293","fp":"2b1cb739e45a","stateId":119,"easy":"إذا آويت الضالة ولم تعرّفها ← فأنت ضال","cause":"يُؤوي الضَّالَّةَ","result":"إلَّا ضالٌّ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-05168","ref":"تخريج المسند لشعيب 19209","text":["كُنتُ مَعَ أبي جَريرٍ بالبَوازيجِ في السَّوادِ، فراحَتِ البَقَرُ، فرَأى بَقَرةً أنكَرَها فقال: ما هذه البَقَرةُ؟ قال: بَقَرةٌ لَحِقَت بالبَقَرِ، فأمَرَ بها فطُرِدَت حَتَّى تَوارَت، ثُمَّ قال: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: «لا ",["يُؤوي الضَّالَّةَ",1]," ",["إلَّا ضالٌّ",2],"»"],"grade":"صحيح","narrator":"جرير","muhaddith":"إسناده صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"3WVjnEBg","merged":3,"otherRefs":["صحيح أبي داود 1720 (صحيح)","نخب الافكار 16/418 (حسن)"]},{"id":"س-07515","fp":"69d07bad2129","stateId":119,"easy":"إذا ذبحت ما لا تملك بغير إذن أهله ← لا يُسيغه آكله (من واقعة)","cause":"ذُبِحَت بغيرِ إذنِ أهلِها","result":"فلم يستطِعْ أن يسيغَها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سبل الهدى والرشاد 10/53","srcLabel":"النسائي","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم مَرَّ وأصحابُه بامرأةٍ فذَبَحت لهم شاةً واتَّخَذَت لهم طعامًا، فلمَّا رجع قالت: يا رسولَ اللهِ إنَّا ذبحنا لكم شاةً، واتَّخَذنا لكم طعامًا، فادخُلوا فكلوا، فدخل رسولُ اللهِ صلَّى اللهُ عليه وسلَّم وأصحابُه، وكانوا لا يبدؤون حتى يبدأَ النَّبيُّ صلَّى اللهُ عليه وسلَّم، فأخذ النَّبيُّ صلَّى اللهُ عليه وسلَّم لُقمةً، ",["فلم يستطِعْ أن يسيغَها",2],"، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: «هذه ",["ذُبِحَت بغيرِ إذنِ أهلِها",1],"»، فقالت المرأةُ: يا رسولَ اللهِ، إنَّا لا نحتَشِمُ من آلِ معاذٍ، نأخُذُ منهم ويأخُذون منَّا، في لفظ: إنَّا لا نحتَشِمُ من آلِ فلانٍ ولا يحتَشِمون منَّا، نأخُذُ منهم ويأخُذون منَّا."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[رجاله] رجال الصحيح","takhrij":"أخرجه أحمد (14785)، والحاكم (7579)، باختلاف يسير، والنسائي في ((الكبرى)) (6720)، مختصرًا.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"E8fiW2Bq"},{"id":"س-03078","fp":"9008fb980c53","stateId":119,"easy":"إذا استدنت (غرمت) ← حدّثت فكذبت ووعدت فأخلفت","cause":"إذَا غَرِمَ","result":"حَدَّثَ فَكَذَبَ، ووَعَدَ فأخْلَفَ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[2],"ref":"الفتح الرباني 2/620","srcLabel":"متفق عليه","text":["عذابُ القبرِ لمن يستحقُّه [يعني حديث: أنَّ رَسولَ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ كانَ يَدْعُو في الصَّلَاةِ: اللَّهُمَّ إنِّي أعُوذُ بكَ مِن عَذَابِ القَبْرِ، وأَعُوذُ بكَ مِن فِتْنَةِ المَسِيحِ الدَّجَّالِ، وأَعُوذُ بكَ مِن فِتْنَةِ المَحْيَا، وفِتْنَةِ المَمَاتِ، اللَّهُمَّ إنِّي أعُوذُ بكَ مِنَ المَأْثَمِ والمَغْرَمِ فَقَالَ له قَائِلٌ: ما أكْثَرَ ما تَسْتَعِيذُ مِنَ المَغْرَمِ، فَقَالَ: إنَّ الرَّجُلَ ",["إذَا غَرِمَ",1],"، ",["حَدَّثَ فَكَذَبَ، ووَعَدَ فأخْلَفَ",2],".]"],"grade":"صحيح","narrator":"[عائشة أم المؤمنين]","muhaddith":"ثبت بالأحاديث المتواترة","takhrij":"أخرجه البخاري (798)، ومسلم (589)، وأبو داوود (880)، والنسائي (1309)، وأحمد (24578) واللفظ له.","bab":"إيمان › الوعيد","dorar":"sUPdZdcs","merged":4,"otherRefs":["غاية المرام 349 (صحيح)","صحيح النسائي 5469 (صحيح)","صحيح النسائي 5487 (صحيح)"]},{"id":"س-05259","fp":"4d1607627cb5","stateId":120,"easy":"إذا علمت ما في سؤال الناس من إثم ← لم تسأل","cause":"لو يَعلَمُ صاحِبُ المَسْألةِ ما له فيها","result":"لم يَسأَلْ","explicit":true,"star":true,"ref":"الأحاديث المختارة 9 / 556","srcLabel":"متفق عليه","text":["«",["لو يَعلَمُ صاحِبُ المَسْألةِ ما له فيها، ",1],["لم يَسأَلْ»",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"NbnMtCEb"},{"id":"س-06215","fp":"f588dbf94f86","stateId":120,"easy":"إذا أخذت المسألة بغير حاجة ← فهي سحت تأكله","cause":"وما كان غَيرَ ذلك","result":"سُحتٌ يَأكُلُه صاحِبُه سُحتًا","explicit":true,"star":true,"otherNeedIds":[3],"ref":"تخريج شرح السنة 1625","srcLabel":"البغوي","text":["كُنتُ جالِسًا عِندَ قَبِيصةَ بنِ مُخارِقٍ؛ إذ جاءَه نَفَرٌ مِن قَومِه يَستَعينونَه في نِكاحِ رَجُلٍ منهم، فأبَى أنْ يُعطيَهم شَيئًا، فانطَلَقوا مِن عِندِه، قالَ كِنانةُ: فقُلتُ له: أنتَ سيِّدُ قَومِكَ، وأتَوْكَ يَسألونَكَ، فلم تُعطِهم شَيئًا؟! قال: أمَّا في مِثلِ هذا فلا أُعطي شَيئًا، ولو عَصَبَه بقِدٍّ حتَّى يَقحَلَ، لكانَ خَيرًا له مِن أنْ يَسألَ في مِثلِ هذا، وسأُخبرُكَ عن ذلكَ، إنِّي تَحمَّلتُ بحَمالةٍ في قَومِي، فأتَيتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقُلتُ: يا رَسولَ اللهِ، إنِّي تَحمَّلتُ بحَمالةٍ في قَوْمي، أتَيتُكَ لِتُعينَني فيها، قال: بل نَحمِلُها عنكَ يا قَبيصةُ، ونُؤَدِّيها إليهم مِنَ الصَّدَقةِ، ثم قال: يا قَبيصةُ، إنَّ المَسألةَ حُرِّمتْ إلَّا في إحدى ثَلاثٍ: في رَجُلٍ أصابَتْه جائِحةٌ، فاجتاحَتْ مالَه، فيَسألُ حتى يُصيبَ قِوامًا مِن عَيْشِه، ثُم يُمسِكُ، وفي رَجُلٍ أصابَتْه حاجةٌ حتى يَشهدَ ثَلاثةُ نَفَرٍ مِن ذَوي الحِجَى مِن قَومِه أنَّ المَسألةَ قد حَلَّتْ له، فيَسألُ حتَّى يُصيبَ القِوامَ مِنَ العَيشِ، ثُم يُمسِكُ، وفي رَجُلٍ تَحمَّلَ بحَمالةٍ، فيَسألُ حتى إذا بَلَغَ أمسَكَ، ",["وما كان غَيرَ ذلك",1],"، فإنَّه ",["سُحتٌ يَأكُلُه صاحِبُه سُحتًا",2],"."],"grade":"صحيح","narrator":"قبيصة بن مخارق","muhaddith":"إسناده صحيح","bab":"سؤال › من تحل له المسألة","dorar":"c8V4yU2k","merged":10,"otherRefs":["صحيح النسائي 2590 (صحيح)","صحيح ابن خزيمة 4/ 123 (صحيح)","صحيح ابن خزيمة 4/ 111 (صحيح)","مسند عمر 1/36 (صحيح)","تخريج صحيح ابن حبان 3291 (صحيح)","تخريج صحيح ابن حبان 4830 (صحيح)","الأحكام الوسطى 2/ 189 (صحيح)"]},{"id":"س-01795","fp":"73938a7e75ba","stateId":120,"easy":"إذا سألت الناس وعندك أوقية ← فقد سألت إلحافاً","cause":"يسألُ عبدٌ ولهُ أوقيةٌ أو عدلُ ذلك","result":"إلا سأل إلحافًا","explicit":true,"similar":["س-06209"],"ref":"مسند عمر 1/21","srcLabel":"مسند عمر","text":["جاء رجلٌ إلى النبيِّ صلَّى اللهُ عليهِ وسلَّمَ يسألُه فلم يكن عندَه ما يُعطيهِ قال فتغيَّظَ عليهِ وقال والذي نفسي بيدِه لا ",["يسألُ عبدٌ ولهُ أوقيةٌ أو عدلُ ذلك",1]," ",["إلا سأل إلحافًا",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"[لم أقف عليه إلا في تهذيب الآثار- مسند عمر].","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"PgnlY3XM","merged":2,"otherRefs":["تخريج المسند لشعيب 23648 (صحيح)"]},{"id":"س-06209","fp":"997151b419f6","stateId":120,"easy":"إذا سألت الناس ولك أوقية ← فقد سألت إلحافاً","cause":"من سألَ مِنكم ولَهُ أوقيَّةٌ ، أو عَدلُها","result":"فقد سألَ إِلحافًا","explicit":true,"repOf":"س-01795","ref":"صحيح أبي داود 1627","text":["عن رجلٍ من بَني أسدٍ ، أنَّهُ قالَ : نزلتُ أَنا وأَهْلي ببقيعِ الغرقَدِ ، فقالَ لي أَهْلي : اذهب إلى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ ، فسلهُ لَنا شيئًا نأكلُهُ ، فجَعلوا يذكرونَ من حاجتِهِم ، فذَهَبتُ إلى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ ، فوجدتُ عندَهُ رجلًا يسألُهُ ، ورسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ ، يقولُ : لا أجدُ ما أعطيكَ ، فتولَّى الرَّجلُ عنهُ وَهوَ مُغضَبٌ وَهوَ يقولُ : لعَمري إنَّكَ لتُعطي مَن شئتَ ، فقالَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ : يغضَبُ عليَّ أن لا أجدَ ما أعطيهِ ، ",["من سألَ مِنكم ولَهُ أوقيَّةٌ ، أو عَدلُها ، ",1],["فقد سألَ إِلحافًا ",2],"، قالَ الأسديُّ : فقلتُ : لَلَقحةٌ لَنا خيرٌ من أوقيَّةٍ  والأوقيَّةُ أربعونَ درهمًا  قالَ : فرجَعتُ ولم أسألهُ ، فقدمَ على رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ بعدَ ذلِكَ شعيرٌ وزبيبٌ ، فقَسمَ لَنا منهُ ، أو كما قالَ : حتَّى أغنانا اللَّهُ عزَّ وجلَّ"],"grade":"صحيح","narrator":"رجل من بني أسد","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1627) واللفظ له، والنسائي (2596)","bab":"سؤال › من تحل له المسألة","dorar":"qx6fBr6q","merged":2,"otherRefs":["السلسلة الصحيحة 5/401 (صحيح)"]},{"id":"س-00547","fp":"88c619879f20","stateId":120,"easy":"إذا سألت الناس ولك ما يكفيك ← فأنت ملحّ (وهو كالرماد الحار)","cause":"مَن سألَ ولَهُ أربعونَ درهمًا","result":"فَهوَ مُلحِفٌ وَهوَ مثلُ سفِّ الملَّةِ","explicit":true,"ref":"صحيح ابن خزيمة 4/ 169","srcLabel":"النسائي","text":[["مَن سألَ ولَهُ أربعونَ درهمًا",1]," ",["فَهوَ مُلحِفٌ وَهوَ مثلُ سفِّ الملَّةِ",2]," . يَعني: الرَّملَ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه النسائي (2594)، والبيهقي (13340) بلفظه","bab":"آداب عامة › ضرب الأمثال","dorar":"ibso90VW"},{"id":"س-04395","fp":"53133c4ee9e9","stateId":120,"easy":"إذا كنت شحيحاً جباناً ← فهذا شر ما في الرجل","cause":"شُحٌّ هالِعٌ ، و جُبْنٌ خَالِعٌ","result":"شَرُّ ما في رجلٍ","explicit":true,"ref":"السلسلة الصحيحة 560","srcLabel":"أبو داود","text":[["شَرُّ ما في رجلٍ",2]," ",["شُحٌّ هالِعٌ ، و جُبْنٌ خَالِعٌ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2511)، وأحمد (8010)","bab":"جهاد › الشجاعة في الحرب والجبن","dorar":"mIHUx3HT"},{"id":"س-07519","fp":"a950ad718a1a","stateId":120,"easy":"إذا بخلت بالسلام ← فأنت أبخل الناس","cause":"إلَّا الذي يَبخَلُ بالسَّلامِ","result":"ما رأيْتُ الذي هو أبخَلُ منكَ","explicit":true,"ref":"تخريج المسند لشعيب 14517","srcLabel":"أحمد","text":["أنَّ رَجلًا أتى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فقال: إنَّ لفُلانٍ في حائِطي عَذْقًا، وإنَّه قد آذاني، وشقَّ عليَّ مكانُ عَذْقِه، فأرسَلَ إليه النَّبيُّ صلَّى اللهُ عليه وسلَّمَ، فقال: بِعْني عَذْقَكَ الذي في حائطِ فُلانٍ، قال: لا، قال: فهَبْهُ لي، قال: لا، قال: فبِعْنيه بعَذْقٍ في الجَنَّةِ، قال: لا، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",["ما رأيْتُ الذي هو أبخَلُ منكَ",2],"، ",["إلَّا الذي يَبخَلُ بالسَّلامِ",1],"."],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"حسن لغيره دون قوله: ما رأيت الذي هو أبخل منك... إلخ","takhrij":"أخرجه أحمد (14517) واللفظ له، وعبد بن حميد (1035)، والحاكم (2195)","bab":"فضائل النبي وصفته ودلائل النبوة › اختصام المؤمنين إليه صلى الله عليه وسلم وحكمه عليهم","dorar":"QH7Du4xW"},{"id":"س-05175","fp":"a65488cf9784","stateId":120,"easy":"إذا رجعت في هبتك ← فأنت كالكلب يعود في قيئه","cause":"العائِدَ في هِبَتِه","result":"كالكَلبِ يَعودُ في قَيئِه","explicit":true,"star":true,"similar":["س-00645"],"otherNeedIds":[44,27],"ref":"صحيح البخاري 3003","srcLabel":"مسلم","text":["قال أسلم: سَمِعتُ عُمَرَ بنَ الخَطَّابِ رَضيَ اللهُ عنه، يقولُ: حَمَلتُ على فرَسٍ في سَبيلِ اللهِ، فابتاعَه أو فأضاعَه الذي كان عِندَه، فأرَدتُ أن أشتَريَه وظَنَنتُ أنَّه بائِعُه برُخصٍ، فسَألتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم، فقال: لا تَشتَرِه وإن بدِرهَمٍ؛ فإنَّ ",["العائِدَ في هِبَتِه",1]," ",["كالكَلبِ يَعودُ في قَيئِه",2],"."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1620)، والنسائي (2615)، وأحمد (281) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Bq55VpMh","merged":15,"otherRefs":["تخريج صحيح ابن حبان 5123 (صحيح)","تخريج المسند لشعيب 2647 (صحيح)","صحيح النسائي 3694 (صحيح)","تخريج المسند لشاكر 4/217 (صحيح)","صحيح مسلم 1622 (صحيح)","صحيح النسائي 3706 (صحيح)","صحيح الترغيب 2612 (صحيح)","صحيح مسلم 1620 (صحيح)","حلية الأولياء 6/155 (صحيح)","صحيح ابن خزيمة 4/ 188 (صحيح)","الجوهر النقي 6/181 (صحيح)","تخريج سنن أبي داود 3539 (صحيح)","المحلى 9/135 (صحيح)","تخريج المسند لشاكر 10/121 (صحيح)"]},{"id":"س-05221","fp":"10d06e6e548f","stateId":120,"easy":"إذا عدت فاشتريت صدقتك ← فأنت كالكلب يعود في قيئه","cause":"لا تشترِهْ ، وإن أعطاكَهُ بدرهمٍ واحدٍ","result":"فإنَّ العائدَ في صدقتِهِ كالكلبِ يعودُ في قَيْئِهِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"التمهيد 3/257","srcLabel":"متفق عليه","text":["قال أسلم: سمعتُ عمرَ بنَ الخطابِ وهو يقولُ : حملتُ على فرسٍ عتيقٍ في سبيلِ اللهِ وكان الرجلُ الذي هو عندَهُ قد أضاعَهُ ، فأردتُ أن أشتريهِ منهُ وظننتُ أنَّهُ بائعُهُ برُخْصٍ ، فسألتُ عن ذلك رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ فقال : ",["لا تشترِهْ ، وإن أعطاكَهُ بدرهمٍ واحدٍ",1]," ",["فإنَّ العائدَ في صدقتِهِ كالكلبِ يعودُ في قَيْئِهِ",2]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"متصل صحيح مسند","takhrij":"أخرجه البخاري (2623)، ومسلم (1620)، والنسائي (2615) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"9fiT31mL","merged":4,"otherRefs":["صحيح البخاري 1490 (صحيح)","صحيح مسلم 1620 (صحيح)","تخريج المسند لشاكر 1/143 (صحيح)"]},{"id":"س-00645","fp":"931828ea180b","stateId":120,"easy":"إذا رجعت في هبتك ← فمثلك كالكلب يعود في قيئه","cause":"الَّذي يَرجِعُ في عَطِيَّتِه","result":"كمَثَلِ الكَلْبِ أَكَلَ حتَّى إذا شَبِعَ قاءَ، ثُمَّ رَجَعَ في قَيْئِه","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-05175","otherNeedIds":[44,27],"ref":"الأحاديث المختارة 11 / 43","text":["«لا يَحِلُّ لرَجُلٍ مُسلِمٍ أن يُعْطيَ العَطيَّةَ ثُمَّ يَرجِعَ فيها إلَّا الوالدِ فيما يُعْطي وَلَدَه، ومَثَلُ ",["الَّذي يَرجِعُ في عَطِيَّتِه",1]," ",["كمَثَلِ الكَلْبِ أَكَلَ حتَّى إذا شَبِعَ قاءَ، ثُمَّ رَجَعَ في قَيْئِه",2],"»."],"grade":"صحيح","narrator":"عبدالله بن عمر وعبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"آداب عامة › ضرب الأمثال","dorar":"ayLx0e5D","merged":12,"otherRefs":["صحيح الجامع 4139 (صحيح)","صحيح الجامع 7686 (صحيح)","تخريج المسند لشعيب 2251 (صحيح)","تخريج سنن الدارقطني 2967 (صحيح)","تخريج المسند لشعيب 10382 (صحيح)","صحيح النسائي 3696 (صحيح)","صحيح الجامع 5834 (صحيح)","تخريج مشكل الآثار 5034 (صحيح)","معجم الشيوخ 1/359 (صحيح)","تخريج المسند لشعيب 2646 (صحيح)","صحيح النسائي 3707 (صحيح)"]},{"id":"س-05887","fp":"166c1ecbdfb0","stateId":121,"easy":"إذا أسأت الظن ← فإنه أكذب الحديث","cause":"والظَّنَّ","result":"فإنَّه أكذَبُ الحَديثِ","explicit":true,"ref":"تخريج المسند لشعيب 10949","srcLabel":"متفق عليه","text":["إيَّاكم ",["والظَّنَّ",1],"؛ ",["فإنَّه أكذَبُ الحَديثِ",2],"، ولا تَحَسَّسوا، ولا تَجَسَّسوا، ولا تَحاسَدوا، ولا تَباغَضوا، ولا تَنافَسوا، ولا تَدابَروا، وكونوا عِبادَ اللهِ إخوانًا، كما أمَرَكم اللهُ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6066)، ومسلم (2563) باختلاف يسير","bab":"رقائق وزهد › الوصايا النافعة","dorar":"5p9dbO4j","merged":2,"otherRefs":["صحيح الأدب المفرد 972 (صحيح)"]},{"id":"س-02586","fp":"6cc2e8726b49","stateId":121,"easy":"إذا انتسبت لغير أبيك ← فهو من أعظم الكذب","cause":"مَنِ ادَّعَى إلى غيرِ أبيهِ","result":"أفْرى الفِرَى","explicit":true,"ref":"تخريج المسند لشعيب 5998","srcLabel":"متفق عليه","text":["أفْرى الفِرَى ",["مَنِ ادَّعَى إلى غيرِ أبيهِ",1],"، و",["أفْرى الفِرَى",2]," مَن أرى عَينَيْهِ في النَّومِ ما لم تَرَ، ومَن غَيَّرَ تُخومَ الأرضِ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"قوله: \"أفْرى الفِرَى مَن أرى عَينَيْهِ في النَّومِ ما لم تَرَ\" أخرجه البخاري (7043) باختلاف يسير","bab":"إيمان › أعمال تنافي الإيمان","dorar":"lrJ01lOV"},{"id":"س-05172","fp":"0c39108f79ae","stateId":121,"easy":"إذا اعتمدت في كلامك على «زعموا» ← فبئست المطية هي","cause":"زَعَموا","result":"بئسَ مَطيَّةُ الرَّجلِ","explicit":true,"ref":"هداية الرواة 4703","srcLabel":"البخاري","text":["سَمِعْتُ رسولَ اللَّهِ - صلَّى اللَّهُ علَيهِ وسلَّمَ - يقولُ في ( ",["زَعَموا",1]," ) : ",["بئسَ مَطيَّةُ الرَّجلِ",2]," ."],"grade":"صحيح","narrator":"أبو مسعود عقبة بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (17075)، وابن المبارك في ((الزهد)) (377)، والبخاري في ((الأدب المفرد)) (763) جميعهم بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"3oaTEECB"},{"id":"س-04942","fp":"2cabb00b9f75","stateId":121,"easy":"إذا حدّثت بحديث تظنه كذباً ← فأنت أحد الكاذبين","cause":"من حدث بحديث وهو يرى أنه كذب","result":"فهو أحَدُ الكاذبينَ","explicit":true,"similar":["س-05114","س-04870"],"ref":"تخريج المسند لشعيب 18241","srcLabel":"مسلم","text":["حَدَّثَنا حَبيبُ بنُ أبي ثابتٍ، فذَكَرَ نحوَه، قال: ",["فهو أحَدُ الكاذبينَ",2],". \n [أي نحو حديث: ",["من حدث بحديث وهو يرى أنه كذب",1],"،...]"],"grade":"صحيح","narrator":"المغيرة بن شعبة","muhaddith":"صحيح","takhrij":"أخرجه مسلم في ((مقدمة الصحيح)) (1/9)، والترمذي (2662)، وابن ماجه (41)، وأحمد (18241)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"oIWmTesB","merged":2,"otherRefs":["تخريج المسند لشعيب 18240 (صحيح)"]},{"id":"س-05092","fp":"1dd7631a5850","stateId":121,"easy":"إذا ادّعيت رؤية ما لم ترَ أو انتسبت لغير والديك ← فهي من أعظم الكذب","cause":"أن يفتريَ الرَّجُلُ على عينَيْهِ، يقولُ: رأَيْتُ، ولم يَرَ، وأن يفتريَ على والدَيْهِ، فيدَّعيَ إلى غيرِ أبيه، أو يقولُ: سَمِعَني، ولم يَسمَعْ منِّي","result":"إنَّ أعظَمَ الفِرَى ثلاثةٌ","explicit":true,"ref":"تخريج المسند لشعيب 16008","srcLabel":"مسلم","text":[["إنَّ أعظَمَ الفِرَى ثلاثةٌ",2],": ",["أن يفتريَ الرَّجُلُ على عينَيْهِ، يقولُ: رأَيْتُ، ولم يَرَ، وأن يفتريَ على والدَيْهِ، فيدَّعيَ إلى غيرِ أبيه، أو يقولُ: سَمِعَني، ولم يَسمَعْ منِّي",1],"."],"grade":"صحيح","narrator":"واثلة بن الأسقع الليثي أبو فسيلة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (16008) واللفظ له، وابن حبان (32)، والطبراني (22/68) (164)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"lHG45XNV"},{"id":"س-05114","fp":"be74417bee7c","stateId":121,"easy":"إذا رويت عن النبي ﷺ حديثاً تظنه كذباً ← فأنت أحد الكاذبين","cause":"مَن رَوى عنِّي حديثًا وهو يَرى أنَّه كَذِبٌ","result":"فهو أحَدُ الكاذبَيْنِ","explicit":true,"repOf":"س-04942","ref":"تخريج المسند لشعيب 20224","text":[["مَن رَوى عنِّي حديثًا وهو يَرى أنَّه كَذِبٌ، ",1],["فهو أحَدُ الكاذبَيْنِ",2],"، وقال عفَّانُ أيضًا: الكاذبِينَ."],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم في ((المقدمة)) (1/9)، وابن ماجه (39)، وأحمد (20224) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"4z5AV4eZ"},{"id":"س-05265","fp":"1f70ee54c37f","stateId":121,"easy":"إذا قلت لطفلك «تعال أعطك» ولم تعطه ← تُكتب عليك كذبة","cause":"لو لم تَفْعَلي","result":"كُتِبَتْ عليكِ كِذْبةٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأحاديث المختارة 9 / 483","srcLabel":"متفق عليه","text":["«دَخَلَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ على أُمِّي وأنا غُلامٌ، فأَدْبَرْتُ خارِجًا فنَادَتْني أُمِّي: يا عَبْدَ اللهِ تَعالَ هاكَ، فقالَ لها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ماذا تُعْطيه؟ قالَتْ: أُعْطيه تَمْرًا، قالَ أَمَا إنَّكِ ",["لو لم تَفْعَلي",1]," ",["كُتِبَتْ عليكِ كِذْبةٌ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن عامر بن ربيعة","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"IlUsU2SE","merged":3,"otherRefs":["صحيح أبي داود 4991 (حسن)","صحيح الجامع 1319 (حسن)"]},{"id":"ق-0119","fp":"2c18e5500d21","stateId":121,"easy":"كتمان الشهادة ← إثم القلب","cause":"كتمان الشهادة","result":"إثم القلب","explicit":true,"ref":"سورة البقرة: 283","srcLabel":"القرآن الكريم","quran":{"s":2,"from":283,"to":283,"text":"وَإِنْ كُنْتُمْ عَلَى سَفَرٍ وَلَمْ تَجِدُوا كَاتِبًا فَرِهَانٌ مَقْبُوضَةٌ فَإِنْ أَمِنَ بَعْضُكُمْ بَعْضًا فَلْيُؤَدِّ الَّذِي اؤْتُمِنَ أَمَانَتَهُ وَلْيَتَّقِ اللَّهَ رَبَّهُ وَلَا تَكْتُمُوا الشَّهَادَةَ وَمَنْ يَكْتُمْهَا فَإِنَّهُ آثِمٌ قَلْبُهُ وَاللَّهُ بِمَا تَعْمَلُونَ عَلِيمٌ (283)","hl":[[209,288,1]]}},{"id":"س-06240","fp":"b95465205677","stateId":121,"easy":"إذا هجوت قبيلة كاملة أو انتفيت من أبيك ← فأنت من أعظم الناس فرية","cause":"فِريَةً ، لَرجُلٌ هَجا رجُلًا ، فهَجا القَبيلَةَ بأَسْرِها ، ورجُلٌ انتَفى مِن أبيه ، وزَنَّى أُمَّه","result":"إنَّ أعظَمَ الناسِ","explicit":true,"ref":"السلسلة الصحيحة 1487","srcLabel":"ابن حبان","text":[["إنَّ أعظَمَ الناسِ",2],[" فِريَةً ، لَرجُلٌ هَجا رجُلًا ، فهَجا القَبيلَةَ بأَسْرِها ، ورجُلٌ انتَفى مِن أبيه ، وزَنَّى أُمَّه",1]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه ابن ماجة (3761) واللفظ له، وابن حبان (5785)، والطحاوي في ((مشكل الآثار)) (10) بنحوه.","bab":"شعر › الرخصة في الشعر ما لم يكن شركا أو هجاء مسلم","dorar":"XqeAIlOl","merged":5,"otherRefs":["السلسلة الصحيحة 763 (صحيح)","تخريج مشكل الآثار 10 (صحيح)","فتح الباري لابن حجر 10/555 (حسن)","صحيح الجامع 1569 (صحيح)"]},{"id":"س-00434","fp":"6759884b63de","stateId":121,"easy":"إذا حدّثت بكل ما سمعت ← كفى بك كذباً","cause":"أنْ يُحدِّثَ بكُلِّ ما سَمِعَ","result":"كَفى بالمَرءِ مِنَ الكذِبِ","explicit":true,"ref":"المستدرك على الصحيحين 2230","srcLabel":"ابن الأعرابي","text":[["كَفى بالمَرءِ مِنَ الكذِبِ",2]," ",["أنْ يُحدِّثَ بكُلِّ ما سَمِعَ",1],"، وكَفى بالمَرءِ مِنَ الشُّحِّ أنْ يقولَ: آخُذُ حقِّي، لا أَترُكُ منه شيئًا."],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن الأعرابي في ((معجم الشيوخ)) (2396) بلفظه، والقضاعي في ((مسند الشهاب)) (1415) باختلاف يسير.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"iQQlXZ80","merged":3,"otherRefs":["فتح المغيث 2/347 (صحيح)","السلسلة الصحيحة 2025 (صحيح)"]},{"id":"س-03767","fp":"655eb12eadb2","stateId":121,"easy":"إذا شهدت زوراً ← فقد عدلت الشرك بالله","cause":"شَهادةُ الزُّورِ","result":"عدلَت شَهادةُ الزُّورِ بالإشراكِ باللَّهِ","explicit":true,"otherNeedIds":[22],"ref":"مجموع الفتاوى 27/350","srcLabel":"مجموع الفتاوى","text":[["عدلَت شَهادةُ الزُّورِ بالإشراكِ باللَّهِ",2],"» قالَها مرَّتين أو ثلاثًا . وقرأَ قولَه تعالى  وَاجْتَنِبوا قَوْلَ الزُّورِ حُنَفَاءَ لِلَّهِ غَيْرَ مُشْرِكِينَ بِهِ وَمَنْ يُشْرِكْ بِاللَّهِ فَكَأنَّمَا خَرَّ مِنَ السَّمَاءِ فَتَخْطَفُهُ الطَّيْرُ أَوْ تَهْوِي بِهِ الرِّيحُ فِي مَكَانٍ سَحِيقٍ"],"grade":"صحيح","muhaddith":"صحيح","bab":"الكفر والشرك › ذم الشرك وما ورد فيه من العقوبة","dorar":"Q8oK4teL","merged":3,"otherRefs":["اقتضاء الصراط المستقيم 2/279 (صحيح)","مجمع الزوائد 4/203 (حسن)"]},{"id":"س-03762","fp":"2051130ef0fd","stateId":121,"easy":"إذا نقلت حديثاً مكذوباً دون أن تبيّن ← فأنت أحد الكاذبين","cause":"مَن نقَلَ الحديثَ المكذوبَ دونَ أنْ يُبيِّنَ أنَّه مَكذوبٌ","result":"فهو أحدُ الكاذبين","explicit":true,"ref":"شرح النزهة لابن عثيمين 189","srcLabel":"شرح النزهة لابن عثيمين","text":["[حديثُ أنَّ] ",["مَن نقَلَ الحديثَ المكذوبَ دونَ أنْ يُبيِّنَ أنَّه مَكذوبٌ؛ ",1],["فهو أحدُ الكاذبين",2],"."],"grade":"صحيح","muhaddith":"صحيح","bab":"اعتصام بالسنة › نقل السنة وروايتها","dorar":"30HVRMTV"},{"id":"س-04870","fp":"8e9881151e81","stateId":121,"easy":"إذا نشرت حديثاً عن النبي ﷺ تظنه كذباً ← فأنت أحد الكاذبين","cause":"من نشر حديثًا عن النبيِّ صلَّى اللهُ عليهِ وسلَّمَ يرَى أنه كذبٌ","result":"فإنه أحدُ الكاذبينَ","explicit":true,"repOf":"س-04942","ref":"مجموع فتاوى ابن عثيمين 232/24","text":[["من نشر حديثًا عن النبيِّ صلَّى اللهُ عليهِ وسلَّمَ يرَى أنه كذبٌ ",1],["فإنه أحدُ الكاذبينَ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"UACHRohT"},{"id":"س-05245","fp":"47016daa9ff9","stateId":121,"easy":"إذا تشبّعت بما لم تُعطَ ← فأنت كلابس ثوبي زور","cause":"المُتَشبِّعُ بما لم يُعطَ","result":"كَلابِسِ ثَوبَيْ زُورٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"تخريج المسند لشعيب 25340","srcLabel":"مسلم","text":["أنَّ امرأةً جاءَتِ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فقالت: يا رَسولَ اللهِ، إنَّ لي زَوجًا، ولي ضَرَّةٌ، وإنِّي أتشَبَّعُ مِن زَوجي، أقولُ: أعطاني كذا، وكساني كذا، وهو كَذِبٌ؟ فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["المُتَشبِّعُ بما لم يُعطَ",1],"، ",["كَلابِسِ ثَوبَيْ زُورٍ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2129)، والنسائي في ((السنن الكبرى)) (8920)، وأحمد (25340) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"PCoY8TDr","merged":7,"otherRefs":["تخريج المسند لشعيب 24593 (صحيح)","تخريج المسند لشعيب 26977 (صحيح)","مختصر المقاصد 1011 (صحيح)","تخريج صحيح ابن حبان 5739 (صحيح)","صحيح الأدب المفرد 157 (صحيح)","الترغيب والترهيب 2/101 (صحيح)"]},{"id":"س-00365","fp":"dfa35471e047","stateId":121,"easy":"إذا كذبت ← فالكذب كله إثم إلا ما نُفع به مسلم أو دُفع به عن دين","cause":"الكذبُ","result":"كلُّه إثمٌ، إلا مَا نُفعَ به مسلمٌ، أو دُفعَ بهِ عن دِينٍ","explicit":true,"ref":"الجامع الصغير 6437","srcLabel":"الروياني","text":[["الكذبُ",1]," ",["كلُّه إثمٌ،  إلا مَا نُفعَ به مسلمٌ،  أو دُفعَ بهِ عن دِينٍ",2]],"grade":"حسن","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"حسن","takhrij":"أخرجه الروياني في ((مسنده)) (630) واللفظ له.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"GVwmpOQv"},{"id":"س-00403","fp":"2738094e3dc2","stateId":121,"easy":"إذا قلت لطفل «تعال خذ» ثم لم تعطه ← فهي كذبة","cause":"مَنْ قال لِصَبِيٍّ : تَعالَ هاكَ ، ثُمَّ لمْ يُعْطِهِ","result":"فهيَ كَذْبَةٌ","explicit":true,"ref":"صحيح الترغيب 2942","srcLabel":"أحمد","text":[["مَنْ قال لِصَبِيٍّ : تَعالَ هاكَ ، ثُمَّ لمْ يُعْطِهِ",1]," ، ",["فهيَ كَذْبَةٌ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (9836) واللفظ له، وابن وهب في ((الجامع)) (514)، وابن أبي الدنيا في ((الصمت)) (519)","bab":"آداب عامة › الأخلاق المذمومة","dorar":"6LspGn7H"},{"id":"س-00456","fp":"eff9de526f42","stateId":121,"easy":"إذا حدّثت أخاك حديثاً يصدّقك فيه وأنت كاذب ← فتلك خيانة كبيرة","cause":"أن تُحَدِّثَ أخاكَ حَديثًا هو لَكَ به مُصَدِّقٌ، وأنتَ له به كاذِبٌ","result":"كَبُرَت خيانةً","explicit":true,"ref":"فيض القدير 4/ 547","srcLabel":"فيض القدير","text":[["كَبُرَت خيانةً",2]," ",["أن تُحَدِّثَ أخاكَ حَديثًا هو لَكَ به مُصَدِّقٌ، وأنتَ له به كاذِبٌ",1]],"grade":"حسن","narrator":"النواس","muhaddith":"إسناده جيد","bab":"آداب عامة › الأخلاق المذمومة","dorar":"32Y7WZWe"},{"id":"س-01569","fp":"2b4773e431c7","stateId":121,"easy":"إذا كذبت ولو كذبة صغيرة ← تُكتب كذبة","cause":"إنْ قالت إحْدانا لشَيءٍ تَشتَهيهِ: لا أَشتَهيهِ","result":"إنَّ الكَذِبَ يُكتَبُ كَذِبًا حتى تُكتَبَ الكُذَيْبَةُ كُذَيْبَةً","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 4/54","srcLabel":"أحمد","text":["كُنتُ صاحبةَ عائشةَ التي هيَّأَتْها وأدخَلَتْها على رسولِ اللهِ صلَّى اللهُ عليه وسلَّم، ومعي نِسوَةٌ، قالت: فواللهِ ما وَجَدْنا عندَه قِرًى إلَّا قَدَحًا من لَبَنٍ، فشَرِبَ منه، ثم ناوَلَه عائشةَ فاستَحْيَتِ الجاريةُ، فقُلنا: لا تَرُدِّي يَدَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم، خُذي منه فأَخَذَتْه على حَياءٍ فشَرِبَتْ منه، ثم قال: ناوِلي صواحِبَكِ، فقُلنا: لا نَشتَهيهِ، فقال: لا تَجمَعْنَ جوعًا وكَذِبًا، قالت: فقُلتُ: يا رسولَ اللهِ، ",["إنْ قالت إحْدانا لشَيءٍ تَشتَهيهِ: لا أَشتَهيهِ",1]," يُعَدُّ ذلك كَذِبًا؟ قال: ",["إنَّ الكَذِبَ يُكتَبُ كَذِبًا حتى تُكتَبَ الكُذَيْبَةُ كُذَيْبَةً",2],"."],"grade":"صحيح","narrator":"أسماء بنت عميس","muhaddith":"فيه أبو شداد عن مجاهد روى عنه ابن جريج ويونس بن يزيد وبقية رجاله رجال الصحيح إلا أن أسماء بنت عميس كانت بأرض الحبشة مع زوجها جعفر حين تزوج النبي صلى الله عليه وسلم عائشة ، والصواب حديث أسماء بنت يزيد","takhrij":"أخرجه أحمد (27471) واللفظ له، وابن أبي الدنيا في ((الصمت)) (520)، والطبراني (24/155) (400)","bab":"أشربة › اللبن","dorar":"QFSxtPZS"},{"id":"س-01335","fp":"b240297e6975","stateId":121,"easy":"إذا كذبت ← يُكتب عليك إلا كذب الرجل لامرأته أو للإصلاح بين الناس","cause":"كل الكَذبِ","result":"يُكتَبُ على بَني آدمَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج مشكل الآثار 2915","srcLabel":"أحمد","text":[["كل الكَذبِ",1]," ",["يُكتَبُ على بَني آدمَ",2]," إلَّا مَن كذَبَ لامرأتِهِ، أو رجُلٌ كذَبَ بيْنَ امرأَيْنِ مُسلمَيْنِ يُصلِحُ بيْنَهما، ورجُلٌ كذَبَ في حرْبٍ."],"grade":"حسن","narrator":"أسماء بنت يزيد أم سلمة الأنصارية","muhaddith":"حسن","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (2915) واللفظ له، وأحمد  (27570)، والطبراني (24/ 165) (420)، وابن أبي الدنيا في ((الصمت وآداب اللسان )) (499) باختلاف يسير.","bab":"نكاح › عشرة النساء","dorar":"VyqT84Zr"},{"id":"س-04782","fp":"ddf16ba75f4c","stateId":122,"easy":"إذا نلت من عرض مسلم ظلماً ← فذلك الذي حرج وهلك","cause":"مَن اقْتَرَضَ مِن امْرِئٍ مُسلِمٍ ظُلْمًا","result":"فذلك الَّذي حَرِجَ وهَلَكَ","explicit":true,"similar":["س-05156","س-04578","س-04772","س-04959"],"ref":"الأحاديث المختارة 1383","srcLabel":"البخاري","text":["«أتَيْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ بعَرَفاتٍ وكأنَّ على رُؤوسِ أصْحابِه الطَّيْرَ، فجاءَتْه الأعْرابُ مِن هاهنا وهاهنا: يا رَسولَ اللهِ، علينا حَرَجٌ في كَذا وكَذا؟ علينا حَرَجٌ في كَذا وكَذا؟ فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: رَفَعَ اللهُ الحَرَجَ إلَّا ",["مَن اقْتَرَضَ مِن امْرِئٍ مُسلِمٍ ظُلْمًا، ",1],["فذلك الَّذي حَرِجَ وهَلَكَ",2],"، قالوا: يا رَسولَ اللهِ، نَتَداوى؟ قالَ: تَداوَوا؛ فإنَّ اللهَ عَزَّ وجَلَّ لم يُنزِلْ داءً إلَّا وَضَعَ له دَواءً إلَّا الهَرَمَ، قالوا: يا رَسولَ اللهِ، فما خَيْرُ ما أُعْطِيَ النَّاسُ؟ فقالَ: إنَّ النَّاسَ لم يُعْطَوا شَيئًا خَيْرًا مِن خُلُقٍ حَسَنٍ»."],"grade":"صحيح","narrator":"أسامة بن شريك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"qvlyGJqP","merged":2,"otherRefs":["معجم الشيوخ 2/612 (صحيح)"]},{"id":"س-04764","fp":"70593b44a1d3","stateId":122,"easy":"إذا سمعت بفاحشة فأفشيتها ← تكون كمن فعلها","cause":"من سمع بفاحشةٍ فأفشاها","result":"فهو فيها كالذي أبداها","explicit":true,"ref":"صحيح الأدب المفرد 248","srcLabel":"البخاري","text":["كان يُقالُ ",["من سمع بفاحشةٍ فأفشاها ",1],["فهو فيها كالذي أبداها",2]],"grade":"صحيح","narrator":"شبيل بن عوف","muhaddith":"إسناده صحيح","takhrij":"أخرجه وكيع في ((الزهد)) (450)، والبخاري في ((الأدب المفرد)) (325)، وابن أبي الدنيا في ((ذم الغيبة والنميمة)) (125) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"wcfxbswa"},{"id":"س-08323","fp":"1ee452b06aac","stateId":122,"easy":"إذا حكيت عيب أحد ← فقد ارتكبت ما لا يسرّ النبي ﷺ ولو أُعطي كذا","cause":"حكَيْتُ رجُلًا","result":"ما يسُرُّني أنِّي","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"تخريج مشكل الآثار 1080","srcLabel":"مسلم","text":["قُلْتُ: يا رسولَ اللهِ: إنَّ صَفِيَّةَ امرأةٌ، فقالت بيدِها: أَيْ إنَّها قصيرةٌ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: لقْد مزَجْتِيها بكلمةٍ لو مَزَجْتِ بها البَحرَ لَمزَجتْهُ، قالت: وحكَيْتُ عندَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ رجُلًا، فقال: ",["ما يسُرُّني أنِّي",2]," ",["حكَيْتُ رجُلًا",1],"، وإنَّ لي كَذا وكَذا."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (1080) واللفظ له، والترمذي (2502)، وأحمد (25560) باختلاف يسير.","bab":"مناقب وفضائل › فضائل أزواج النبي صلى الله عليه وسلم","dorar":"HVS7kgWO","merged":5,"otherRefs":["تخريج المسند لشعيب 25708 (صحيح)","تخريج المسند لشعيب 25560 (صحيح)","السلسلة الصحيحة 901 (صحيح)","تخريج المسند لشعيب 24964 (صحيح)"]},{"id":"س-03828","fp":"03e262149cba","stateId":122,"easy":"إذا اغتبت المؤمنين ← ترتفع منك ريح منتنة","cause":"الَّذينَ يغتابونَ المؤمنينَ","result":"فارتفعَت ريحٌ مُنْتِنَةٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الزواجر عن اقتراف الكبائر 2/11","srcLabel":"البخاري","text":["كنَّا معَ النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ ",["فارتفعَت ريحٌ مُنْتِنَةٌ",2]," فقالَ صلَّى اللَّهُ عليهِ وسلَّمَ : أتدرونَ ما هذهِ الرِّيحُ ؟ هذهِ ريحُ ",["الَّذينَ يغتابونَ المؤمنينَ",1]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (14784)، والبخاري في ((الأدب المفرد)) (732)، وابن أبي الدنيا في ((الصمت)) (216) باختلاف يسير","bab":"بر وصلة › حق المسلم على المسلم","dorar":"9k4sD6Ze","merged":3,"otherRefs":["فتح الباري لابن حجر 10/485 (حسن)","صحيح الأدب المفرد 562 (حسن)"]},{"id":"ق-0246","fp":"056071a6ef2e","stateId":122,"easy":"رمي البريء بخطيئة أو إثم ← بهتان وإثم مبين","cause":"رمي البريء بخطيئة أو إثم","result":"بهتان وإثم مبين","explicit":true,"ref":"سورة النساء: 112","srcLabel":"القرآن الكريم","quran":{"s":4,"from":112,"to":112,"text":"وَمَنْ يَكْسِبْ خَطِيئَةً أَوْ إِثْمًا ثُمَّ يَرْمِ بِهِ بَرِيئًا فَقَدِ احْتَمَلَ بُهْتَانًا وَإِثْمًا مُبِينًا (112)","hl":[[0,112,1]]}},{"id":"ق-0847","fp":"1678c6c9fe95","stateId":122,"easy":"قذف المحصنات ← الجلد وردّ الشهادة والفسق","cause":"قذف المحصنات","result":"الجلد وردّ الشهادة والفسق","explicit":true,"ref":"سورة النور: 4","srcLabel":"القرآن الكريم","quran":{"s":24,"from":4,"to":4,"text":"وَالَّذِينَ يَرْمُونَ الْمُحْصَنَاتِ ثُمَّ لَمْ يَأْتُوا بِأَرْبَعَةِ شُهَدَاءَ فَاجْلِدُوهُمْ ثَمَانِينَ جَلْدَةً وَلَا تَقْبَلُوا لَهُمْ شَهَادَةً أَبَدًا وَأُولَئِكَ هُمُ الْفَاسِقُونَ (4)","hl":[[0,187,1]]}},{"id":"ق-0849","fp":"8cee9e68b961","stateId":122,"easy":"الخوض في الإفك ← لكل امرئ ما اكتسب من الإثم ولمن تولّى كِبره عذاب عظيم","cause":"الخوض في الإفك","result":"لكل امرئ ما اكتسب من الإثم ولمن تولّى كِبره عذاب عظيم","explicit":true,"otherNeedIds":[70],"ref":"سورة النور: 11","srcLabel":"القرآن الكريم","quran":{"s":24,"from":11,"to":11,"text":"إِنَّ الَّذِينَ جَاءُوا بِالْإِفْكِ عُصْبَةٌ مِنْكُمْ لَا تَحْسَبُوهُ شَرًّا لَكُمْ بَلْ هُوَ خَيْرٌ لَكُمْ لِكُلِّ امْرِئٍ مِنْهُمْ مَا اكْتَسَبَ مِنَ الْإِثْمِ وَالَّذِي تَوَلَّى كِبْرَهُ مِنْهُمْ لَهُ عَذَابٌ عَظِيمٌ (11)","hl":[[108,219,1]]}},{"id":"ق-1248","fp":"ec9d47eb1298","stateId":122,"easy":"السخرية واللمز والتنابز بالألقاب وترك التوبة ← الفسوق والظلم","cause":"السخرية واللمز والتنابز بالألقاب وترك التوبة","result":"الفسوق والظلم","explicit":true,"ref":"سورة الحجرات: 11","srcLabel":"القرآن الكريم","quran":{"s":49,"from":11,"to":11,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا يَسْخَرْ قَوْمٌ مِنْ قَوْمٍ عَسَى أَنْ يَكُونُوا خَيْرًا مِنْهُمْ وَلَا نِسَاءٌ مِنْ نِسَاءٍ عَسَى أَنْ يَكُنَّ خَيْرًا مِنْهُنَّ وَلَا تَلْمِزُوا أَنْفُسَكُمْ وَلَا تَنَابَزُوا بِالْأَلْقَابِ بِئْسَ الِاسْمُ الْفُسُوقُ بَعْدَ الْإِيمَانِ وَمَنْ لَمْ يَتُبْ فَأُولَئِكَ هُمُ الظَّالِمُونَ (11)","hl":[[31,323,1]]}},{"id":"ق-1249","fp":"cc7779e577dd","stateId":122,"easy":"سوء الظن والتجسس والغيبة ← الإثم","cause":"سوء الظن والتجسس والغيبة","result":"الإثم","explicit":true,"ref":"سورة الحجرات: 12","srcLabel":"القرآن الكريم","quran":{"s":49,"from":12,"to":12,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اجْتَنِبُوا كَثِيرًا مِنَ الظَّنِّ إِنَّ بَعْضَ الظَّنِّ إِثْمٌ وَلَا تَجَسَّسُوا وَلَا يَغْتَبْ بَعْضُكُمْ بَعْضًا أَيُحِبُّ أَحَدُكُمْ أَنْ يَأْكُلَ لَحْمَ أَخِيهِ مَيْتًا فَكَرِهْتُمُوهُ وَاتَّقُوا اللَّهَ إِنَّ اللَّهَ تَوَّابٌ رَحِيمٌ (12)","hl":[[31,146,1]]}},{"id":"س-04855","fp":"f41ef96f6574","stateId":122,"easy":"إذا استطلت في عرض مسلم ← فهو أربى الربا","cause":"عِرضُ الرَّجلِ المسلمِ","result":"وإنَّ أربَى الرِّبا","explicit":true,"otherNeedIds":[27],"ref":"الترغيب والترهيب 3/68","srcLabel":"البيهقي","text":["خطَبنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فذكر أمرَ الرِّبا وعظَّم شأنَه وقال إنَّ الدِّرهمَ يُصيبُه الرَّجلُ من الرِّبا أعظمُ عند اللهِ في الخطيئةِ من ستٍّ وثلاثين زنْيةً يزنيها الرَّجلُ ",["وإنَّ أربَى الرِّبا",2]," ",["عِرضُ الرَّجلِ المسلمِ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن أبي الدنيا في ((الصمت)) (175)، وابن عدي في ((الكامل في الضعفاء)) (4/233)، والبيهقي في ((شعب الإيمان)) (5523).","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"esgWECQk","merged":5,"otherRefs":["الأحاديث المختارة 1107 (صحيح)","السلسلة الصحيحة 1433 (صحيح)","مجموع فتاوى ابن باز 25/255 (حسن)","الجامع الصغير 4490 (صحيح)"]},{"id":"س-05156","fp":"f1615f84ab45","stateId":122,"easy":"إذا نلت من عرض أخيك ← حرجت وهلكت","cause":"مَن اقتَرَضَ مِن عِرْضِ أخيهِ شيئًا","result":"فذلِكَ الَّذي حَرِجَ وهلَكَ","explicit":true,"repOf":"س-04782","ref":"المستدرك على الصحيحين 7635","text":["شَهِدْتُ الأعاريبَ يَسأَلُونَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ: هلْ علينا حَرَجٌ في كذا وفي كذا؟ فقالَ: عِبادَ اللهِ، وضَعَ اللهُ الحَرَجَ إلَّا ",["مَن اقتَرَضَ مِن عِرْضِ أخيهِ شيئًا؛ ",1],["فذلِكَ الَّذي حَرِجَ وهلَكَ",2],". قالوا: يا رسولَ اللهِ، نَتداوى؟ قالَ: تَدَاوَوْا عبادَ اللهِ؛ فإنَّ اللهَ تَعالَى لم يُنزِلْ داءً إلَّا وقَدْ أنزَلَ له شِفاءً، إلَّا هذا الهَرَمَ.\n قالوا: يا رسولَ اللهِ، ما خَيْرُ ما أُعطِيَ العبدُ المسلِمُ؟ قالَ: خُلُقٌ حسَنٌ."],"grade":"صحيح","narrator":"أسامة بن شريك العامري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الحميدي في ((المسند)) (845)، وابن عبد البر في ((التمهيد)) (5/ 281) بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ZsiMk7El","merged":4,"otherRefs":["تخريج صحيح ابن حبان 6061 (صحيح)","التمهيد 5/281 (صحيح)","نخب الافكار 10/142 (صحيح)"]},{"id":"س-00424","fp":"0f870702c73b","stateId":122,"easy":"إذا ذكرت أخاك بما يكره ولو بوصف خَلقي ← فقد اغتبته","cause":"ذكَرَتْ قِصَرَها","result":"قدِ اغْتَبْتيها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 25049","srcLabel":"مسلم","text":["حكَتِ امرأةً عندَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ ",["ذكَرَتْ قِصَرَها",1],"، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",["قدِ اغْتَبْتيها",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أبو داود (4875) بنحوه، وأحمد (25049) واللفظ له","bab":"آداب عامة › الأخلاق المذمومة","dorar":"40HOoeLz"},{"id":"س-00426","fp":"bd9341c613d0","stateId":122,"easy":"إذا عبت أحداً بكلمة ← فقد قلت كلمة لو مُزج بها ماء البحر لمزجته","cause":"إنَّ صَفيَّةَ امرأةٌ -وقال بيَدِهِ، كأنَّهُ يَعني: قَصيرةٌ","result":"لقد مَزَجتِ بكَلِمةٍ، لو مُزِجَ بها ماءُ البَحرِ مزَجَتْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-08325"],"ref":"تخريج المسند لشعيب 25560","srcLabel":"مسلم","text":["حكَيتُ لِلنَّبيِّ صلَّى اللهُ عليه وسلَّمَ رَجُلًا، فقال: ما يَسُرُّني أنِّي حكَيتُ رَجُلًا، وأنَّ لي كذا وكذا، قالت: فقُلتُ: يا رَسولَ اللهِ، ",["إنَّ صَفيَّةَ امرأةٌ -وقال بيَدِهِ، كأنَّهُ يَعني: قَصيرةٌ",1],"- فقال: ",["لقد مَزَجتِ بكَلِمةٍ، لو مُزِجَ بها ماءُ البَحرِ مزَجَتْ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أبو داود (4875)، والترمذي (2502)، وأحمد (25560) واللفظ له","bab":"آداب عامة › الأخلاق المذمومة","dorar":"aLcpVOyn"},{"id":"س-00615","fp":"780eaba843b6","stateId":122,"easy":"إذا اغتبت مسلماً ← فكأنك أكلت لحمه، والقيح خير لك منه","cause":"أنْ يأكُلَ لَحمَ رَجُلٍ مُسلِمٍ","result":"لَأنْ يأكُلَ الرَّجُلُ مِن هذا حتى يَملَأَ بَطنَه خَيرٌ له","explicit":true,"ref":"الترغيب والترهيب 4/11","srcLabel":"الترغيب والترهيب","text":["عن عَمرِو بنِ العاصِ رَضيَ اللهُ عنه أنَّه مَرَّ على بَغلٍ مَيْتٍ فقالَ لِبَعضِ أصحابِه: ",["لَأنْ يأكُلَ الرَّجُلُ مِن هذا حتى يَملَأَ بَطنَه خَيرٌ له",2]," مِن ",["أنْ يأكُلَ لَحمَ رَجُلٍ مُسلِمٍ",1],"."],"grade":"صحيح","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","bab":"آداب عامة › ضرب الأمثال","dorar":"YJWPsrox","merged":2,"otherRefs":["صحيح الأدب المفرد 565 (صحيح)"]},{"id":"س-04578","fp":"1d6a320c8261","stateId":122,"easy":"إذا نلت من عرض مسلم ← فقد حرجت وهلكت","cause":"إلَّا رجلٌ اقترض امرأً مسلمًا","result":"فذلك الَّذي حَرِجَ وهلك","explicit":true,"repOf":"س-04782","ref":"حجة الوداع 215","text":["شهِدتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم في حجَّةِ الوداعِ يخطُبُ وهو يقولُ : أمَّك وأباك وأختَك وأخاك ، ثمَّ أدناك أدناك . قال : فجاء قومٌ فقالوا : يا رسولَ اللهِ قتلتنا بنو يربوعٍ ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : لا تجني نفسٌ على أخرَى ، ثمَّ سأله رجلٌ نسي أن يرميَ الجِمارَ فقال : ارْمِ ولا حرجَ ، ثمَّ أتاه آخرُ فقال : يا رسولَ اللهِ نسيتُ الطَّوافَ ، فقال : طُفْ ولا حرجَ ، ثمَّ أتاه آخرُ حلَق قبل أن يذبحَ ، فقال : اذبَحْ ولا حرجَ . فما سألوه يومئذٍ عن شيءٍ إلَّا قال : لا حرجَ لا حرجَ . ثمَّ قال : قد أذهب اللهُ الحرجَ ",["إلَّا رجلٌ اقترض امرأً مسلمًا",1]," ",["فذلك الَّذي حَرِجَ وهلك",2]," . وقال : ما أنزل اللهُ عزَّ وجلَّ داءٌ إلَّا أنزل معه دواءً إلَّا الهرَمَ"],"grade":"صحيح","narrator":"أسامة بن شريك","muhaddith":"إسناده متصل صحيح[كما ذكر في المقدمة]","takhrij":"أخرجه الطبراني (1/186) (486)، وابن حزم في ((حجة الوداع)) (191)، والضياء في ((الأحاديث المختارة)) (1389)","bab":"حج › فضل يوم النحر وأيام التشريق","dorar":"jZaQP4xV","merged":2,"otherRefs":["شرح السنة 6/243 (حسن)"]},{"id":"س-04678","fp":"2304d40f228e","stateId":122,"easy":"إذا سببت أمواتنا ← تؤذي بذلك الأحياء","cause":"لا تَسُبُّوا أمْواتَنا","result":"فتُؤْذوا به الأحْياءَ","explicit":true,"ref":"المستدرك على الصحيحين 5517","srcLabel":"الحاكم","text":["أنَّ رجُلًا ذكَرَ أبا العبَّاسِ فنالَ منه، فلطَمَه العبَّاسُ فاجتَمَعوا، فقالوا: واللهِ لَنلطِمَنَّ العبَّاسَ كما لطَمَه، فبلَغَ ذلك رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فخطَبَ، فقالَ: مَن أكرَمُ النَّاسِ على اللهِ؟ قالوا: أنتَ يا رَسولَ اللهِ، قالَ: فإنَّ العبَّاسَ منِّي، وأنا منه، ",["لا تَسُبُّوا أمْواتَنا",1]," ",["فتُؤْذوا به الأحْياءَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","bab":"ديات وقصاص › الشفاعة في القصاص","dorar":"t34anxdn","merged":2,"otherRefs":["صحيح الجامع 7312 (صحيح)"]},{"id":"س-00388","fp":"b9f57072dae6","stateId":122,"easy":"إذا تطاولت على عرض مسلم بغير حق ← فهو من الكبائر","cause":"استِطالةَ المَرءِ في عِرضِ رَجُلٍ مُسلِمٍ بغَيرِ حَقٍّ","result":"من الكبائِرِ","explicit":true,"ref":"تخريج سنن أبي داود 4877","srcLabel":"أبو داود","text":["إنَّ من الكبائِرِ ",["استِطالةَ المَرءِ في عِرضِ رَجُلٍ مُسلِمٍ بغَيرِ حَقٍّ",1],"، و",["من الكبائِرِ",2]," السَّبَّتانِ بالسَّبَّةِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (4877) بلفظه، وابن أبي الدنيا في ((الصمت)) (727)، والبزار (8336) كلاهما بلفظ مقارب.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"YN4CWgUo"},{"id":"س-00389","fp":"2149c9071d13","stateId":122,"easy":"إذا رددت السبة بسبتين ← فهو من الكبائر","cause":"السَّبَّتانِ بالسَّبَّةِ","result":"ومن الكبائِرِ","explicit":true,"ref":"تخريج سنن أبي داود 4877","srcLabel":"أبو داود","text":["إنَّ من الكبائِرِ استِطالةَ المَرءِ في عِرضِ رَجُلٍ مُسلِمٍ بغَيرِ حَقٍّ، ",["ومن الكبائِرِ",2]," ",["السَّبَّتانِ بالسَّبَّةِ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (4877) بلفظه، وابن أبي الدنيا في ((الصمت)) (727)، والبزار (8336) كلاهما بلفظ مقارب.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"YN4CWgUo"},{"id":"س-04772","fp":"89094a7b24b1","stateId":122,"easy":"إذا نلت من عرض مسلم ظلماً ← حرجت وهلكت","cause":"امرءًا اقترض امرءًا ظلمًا","result":"فذاك يَحْرَجُ و يهلِكُ","explicit":true,"repOf":"س-04782","ref":"صحيح الجامع 3973","text":["عبادَ اللهِ ! و ضع اللهُ الحرجَ إلا ",["امرءًا اقترض امرءًا ظلمًا",1]," ",["فذاك يَحْرَجُ و يهلِكُ",2]," ، عبادَ اللهِ ! تداووا ، فإنَّ اللهَ تعالَى لم يضع داءًا إلا وضع له الدواءَ إلا داءً واحدًا الهرَمُ"],"grade":"صحيح","narrator":"أسامة بن شريك","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2015، 3855) مفرقاً، والترمذي (2038)، والنسائي في ((السنن الكبرى)) (7553)، وابن ماجه (3436)، وأحمد (18454) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"mKOgsJXE"},{"id":"س-04959","fp":"e6cbee36d337","stateId":122,"easy":"إذا نلت من عرض مسلم ظالماً ← فذاك الذي حرج وهلك","cause":"رجلٌ اقتَرضَ مِن عرضِ رجلٍ مُسلمٍ، وَهوَ ظالِمٌ","result":"فذاكَ الَّذي حَرِجَ وَهَلَكَ","explicit":true,"repOf":"س-04782","ref":"صحيح ابن خزيمة 4/ 411","text":["خرجتُ معَ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ حاجًّا، وَكانَ النَّاسُ يأتونَهُ، فمِن قائلٍ يقولُ: يا رسولَ اللَّهِ سعيتُ قبلَ أن أطوفَ أو أخَّرتُ شيئًا أو قدَّمتُ شيئًا، وَكانَ يقولُ لَهُم: لا حرَجَ لا حرجَ إلَّا ",["رجلٌ اقتَرضَ مِن عرضِ رجلٍ مُسلمٍ، وَهوَ ظالِمٌ",1]," ",["فذاكَ الَّذي حَرِجَ وَهَلَكَ",2]],"grade":"صحيح","narrator":"أسامة بن شريك","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الطبراني (1/ 181) (472)، والبيهقي (9733) بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"8wO5U3yp"},{"id":"س-04826","fp":"ec91fb90615a","stateId":122,"easy":"إذا وقعت في أخيك بعد قيامه ← فقد أكلت لحمه","cause":"فوقَع فيه رجلٌ من بعدِه","result":"إنَّك أكَلْتَ لحمَ أخيك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 8/97","srcLabel":"الطبراني","text":["كُنَّا  عندَ النَّبيِّ صلَّى اللهُ عليه وسلَّم فقام رجلٌ ",["فوقَع فيه رجلٌ من بعدِه",1]," فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم تخلَّلْ فقال وما أتخلَّلُ يا رسولَ اللهِ أكَلْتُ لحمًا فقال ",["إنَّك أكَلْتَ لحمَ أخيك",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه ابن أبي شيبة في ((المسند)) (311)، والطبراني (10/126) (10092) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"SnV1at0x","merged":2,"otherRefs":["غاية المرام 428 (صحيح)"]},{"id":"س-04847","fp":"d4e7a563b82e","stateId":122,"easy":"إذا اغتبت أخاك ← فقد أكلت لحمه","cause":"إنَّ هذا لَيوائمُ","result":"بلحمِ أخيكما ، والذي نفسي بيدِه إني لأرى لحمَه بين أنيابِكما","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"السلسلة الصحيحة 6/211","srcLabel":"الخرائطي","text":["كانت العربُ تخدِمُ بعضُها بعضًا في الأسفارِ ، وكان مع أبِي بكرٍ وعمرَ رجلٌ يخدِمُهما ، فناما ، فاستيقظا ، ولم يُهيِّئْ لهما طعامًا ، فقال أحدُهما لصاحبِه : ",["إنَّ هذا لَيوائمُ",1]," نومَ نبيِّكم صلَّى اللهُ عليهِ وسلَّمَ [ وفي روايةٍ : لِيوائِمَ نومَ بيتِكم ] فأيقَظاه فقالا : ائتَ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ فقُلْ له : إنَّ أبا بكرٍ وعمرَ يُقرئانِكَ السَّلامَ ، وهما يستأدِمانِك ، فقال : أَقرِهِما السَّلامَ ، وأخْبِرْهما أنهما قد ائتدَما ، ففزِعا ، فجاءا إلى النبيِّ صلَّى اللهُ عليهِ وسلَّمَ فقالا : يا رسولَ اللهِ بعثْنا إليك نستأدمُك ، فقلتَ : قدِ ائتدَما فبأيِّ شيءٍ ائتدَمْنا ؟ قال : ",["بلحمِ أخيكما ، والذي نفسي بيدِه إني لأرى لحمَه بين أنيابِكما",2]," ، يعني لحمَ الذي استغاباه ، قالا : فاستغفِرْ لنا ، قال : هو فلْيستغفِرْ لكما"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح","takhrij":"أخرجه الخرائطي في ((مساوئ الأخلاق)) (180)، والضياء في ((الأحاديث المختارة)) (1697)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"vMsspnza"},{"id":"س-08325","fp":"e62ba6dcd53e","stateId":122,"easy":"إذا عبت أحداً ← فقد قلت كلمة لو مُزجت بماء البحر لمزجته","cause":"حسبُكَ مِن صفيَّةَ كذا وَكَذا","result":"لقد قُلتِ كلمةً لو مُزِجَت بماءِ البحرِ لمزجَتْهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-00426","ref":"الاقتراح في بيان الاصطلاح 118","text":["قلتُ للنَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ : ",["حسبُكَ مِن صفيَّةَ كذا وَكَذا",1]," . قالَ : غيرُ مسدَّدٍ ، تَعني قصيرةً ، فقالَ : ",["لقد قُلتِ كلمةً لو مُزِجَت بماءِ البحرِ لمزجَتْهُ",2]," . قالَت : وحَكَيتُ لَهُ إنسانًا . فقالَ : ما أحبُّ أنِّي حَكَيتُ إنسانًا وأنَّ لي كذا وَكَذا"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4875) واللفظ له، والترمذي (2502)","bab":"مناقب وفضائل › فضائل أزواج النبي صلى الله عليه وسلم","dorar":"kkl25Ljd"},{"id":"س-00437","fp":"e48d8c89628a","stateId":122,"easy":"إذا أشرت إلى عيب أحد ولو بيدك ← فقد اغتبته","cause":"أومأتُ بيديَّ أنَّها قصيرةٌ","result":"اغتبتِها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج الإحياء للعراقي 3/179","srcLabel":"ابن حبان","text":["دخَلَت علينا امرأةٌ ، فلمَّا ولَّت ، ",["أومأتُ بيديَّ أنَّها قصيرةٌ",1]," ، فقال عليهِ السَّلامُ : ",["اغتبتِها",2]," ."],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"من رواية حسان بن مخارق وحسان وثقه ابن حبان , وباقيهم ثقات","takhrij":"أخرجه ابن أبي الدنيا في ((ذم الغيبة والنميمة)) (70)، والخرائطي في ((مساوئ الأخلاق)) (197)، وأبو الشيخ في ((التوبيخ والتنبيه)) (199) باختلاف يسير.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"ww7K2u0t"},{"id":"س-00438","fp":"67af838e7480","stateId":123,"easy":"إذا سببت الدهر ← فإنما تسب مقلّبه وهو الله","cause":"تَسُبُّوا الدَّهْرَ","result":"فإنَّ اللهَ عزَّ وجلَّ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"السلسلة الصحيحة 532","srcLabel":"متفق عليه","text":["لا ",["تَسُبُّوا الدَّهْرَ",1]," ، ",["فإنَّ اللهَ عزَّ وجلَّ",2]," قال : أنا الدَّهْرُ ، الأَيَّامُ و اللَّيالِي أُجَدِّدُها و أُبْلِيها ، وآتِي بِمُلوكٍ بعدَ مُلوكٍ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده جيد على شرط مسلم","takhrij":"أخرجه أحمد (10438) بلفظه، والبخاري (5827)، ومالك (1/ 207) كلاهما بنحوه.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"TRC1P93F","merged":3,"otherRefs":["معجم الشيوخ 2/649 (حسن)","تخريج المسند لشعيب 10438 (صحيح)"]},{"id":"س-03139","fp":"06ed03818554","stateId":123,"easy":"إذا سببت الدهر ← تؤذي الله","cause":"يسُبُّ الدَّهرَ","result":"يُؤذيني ابنُ آدَمَ","explicit":true,"star":true,"otherNeedIds":[27],"ref":"تخريج صحيح ابن حبان 5715","srcLabel":"متفق عليه","text":["كان أهلُ الجاهليَّةِ يقولونَ: إنَّما يُهلِكُنا اللَّيلُ والنَّهارُ، هو الَّذي يُهلِكُنا ويُميتُنا ويُحيينا قال اللهُ: {مَا هِيَ إِلَّا حَيَاتُنَا الدُّنْيَا} [الجاثية: 24] قال الزُّهريُّ عن سعيدِ بنِ المُسيَّبِ: عن أبي هُريرةَ عن النَّبيِّ صلَّى اللهُ عليه وسلَّم قال: يقولُ اللهُ جلَّ وعلا: ",["يُؤذيني ابنُ آدَمَ",2]," ",["يسُبُّ الدَّهرَ",1]," وأنا الدَّهرُ بيدي الأمرُ أُقلِّبُ ليلَه ونهارَه فإذا شِئْتُ قبَضْتُهما )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه ابن حبان (5715) واللفظ له، والبخاري (7491) دون: فإذا شئت قبضتهما، ومسلم (2246) بنحوه.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"MHCuZeXh","merged":5,"otherRefs":["المستدرك على الصحيحين 1546 (صحيح)","المستدرك على الصحيحين 3736 (صحيح)","المستدرك على الصحيحين 3737 (صحيح)","المستدرك على الصحيحين 3738 (صحيح)"]},{"id":"س-03143","fp":"37afdb422942","stateId":123,"easy":"إذا قلت «يا خيبة الدهر» ← فإن الله هو مقلّب الدهر","cause":"لا يَقُلِ ابنُ آدَمَ: واخَيبَةَ الدَّهرِ","result":"إنِّي أنا الدَّهرُ، أُرسِلُ اللَّيلَ والنَّهارَ، فإذا شِئتُ قَبَضتُهما","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 8232","srcLabel":"متفق عليه","text":[["لا يَقُلِ ابنُ آدَمَ: واخَيبَةَ الدَّهرِ",1],"، ",["إنِّي أنا الدَّهرُ، أُرسِلُ اللَّيلَ والنَّهارَ، فإذا شِئتُ قَبَضتُهما",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6181) مختصراً، ومسلم (2246) باختلاف يسير","bab":"إيمان › توحيد الأسماء والصفات","dorar":"4o5QP429","merged":4,"otherRefs":["التمهيد 18/151 (صحيح)","تخريج صحيح ابن حبان 5713 (صحيح)","تخريج المسند لشعيب 7518 (صحيح)"]},{"id":"س-02539","fp":"1b37a944200b","stateId":123,"easy":"إذا تسابّ اثنان ← فالإثم على البادئ ما لم يعتدِ المظلوم","cause":"المُستَبَّانِ ما قالا","result":"على البادئِ ما لم يَعتَدِ المَظلومُ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 18337","srcLabel":"مسلم","text":[["المُستَبَّانِ ما قالا",1]," ",["على البادئِ ما لم يَعتَدِ المَظلومُ",2],"، والمُستَبَّانِ شَيطانانِ يَتكاذَبانِ ويَتهاتَرانِ."],"grade":"صحيح","narrator":"عياض بن حمار","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (18337) واللفظ له، والطيالسي (1176) باختلاف يسير، والبزار (3493) مختصراً","bab":"إيمان › أعمال الجن والشياطين","dorar":"eS6KJDo0","merged":5,"otherRefs":["الصحيح المسند 1055 (صحيح)","صحيح الجامع 6697 (صحيح)","تخريج المسند لشعيب 17488 (صحيح)","سنن الترمذي 1981 (صحيح)"]},{"id":"س-05023","fp":"c7518f76ee3a","stateId":123,"easy":"إذا قلت لأخيك «يا كافر» ← رجعت على أحدكما","cause":"أيُّما امرئٍ قال لِأخيهِ : كافرٌ","result":"فقَدْ باءَ بِها أحدُهما ، إِنْ كان كمَا قال ، وإلَّا رجَعَتْ إليهِ","explicit":true,"star":true,"otherNeedIds":[22],"ref":"صحيح الجامع 2698","srcLabel":"متفق عليه","text":[["أيُّما امرئٍ قال لِأخيهِ : كافرٌ ، ",1],["فقَدْ باءَ بِها أحدُهما ، إِنْ كان كمَا قال ، وإلَّا رجَعَتْ إليهِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6104) مختصراً، ومسلم (60) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"IrgIsPfJ","merged":3,"otherRefs":["اللطائف من دقائق المعارف 617 (صحيح)","تخريج المسند لشعيب 4745 (صحيح)"]},{"id":"س-02374","fp":"6e9b77158031","stateId":123,"easy":"إذا لعنت مؤمناً ← فهو كقتله","cause":"ولَعنُ المُؤمِنِ","result":"كَقَتلِه","explicit":true,"star":true,"similar":["س-03020"],"ref":"صحيح مسلم 110","srcLabel":"متفق عليه","text":["ليس على رَجُلٍ نَذرٌ فيما لا يَملِكُ، ",["ولَعنُ المُؤمِنِ",1]," ",["كَقَتلِه",2],"، ومَن قَتَلَ نَفسَه بشيءٍ في الدُّنيا عُذِّبَ به يَومَ القيامةِ، ومَنِ ادَّعى دَعوى كاذِبةً ليَتَكَثَّرَ بها لم يَزِدْه اللهُ إلَّا قِلَّةً، ومَن حَلَفَ على يَمينِ صَبرٍ فاجِرةٍ."],"grade":"صحيح","narrator":"ثابت بن الضحاك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6047)، ومسلم (110).","bab":"إسلام › حرمة المسلم","dorar":"LmqD8FfX","merged":2,"otherRefs":["الإحكام في أصول الأحكام 2/504 (صحيح)"]},{"id":"س-00409","fp":"d79a28ac8212","stateId":123,"easy":"إذا عيّرت أحداً بأمه ← ففيك جاهلية","cause":"أَعَيَّرْتَهُ بأُمِّهِ","result":"إنك امْرُؤٌ فيك جاهِلِيَّةٌ","explicit":true,"similar":["س-06782"],"ref":"غاية المرام 307","srcLabel":"متفق عليه","text":["أنَّ أبا ذَرٍّ وبلالًا تَغَاضَبَا وتَسَابَّا وفي ثورةِ الغضبِ قال أبو ذَرٍّ لبلالٍ : يا ابنَ السَّوْدَاءِ فشكاه بلالٌ إلى النبيِّ فقال النبيُّ لأبي ذَرٍّ : ",["أَعَيَّرْتَهُ بأُمِّهِ",1]," ",["إنك امْرُؤٌ فيك جاهِلِيَّةٌ",2]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح بغير هذا السياق","takhrij":"أخرجه البخاري (30)، ومسلم (1661)، وأبو داود (5157) جميعهم باختلاف يسير.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"v8klG64Q"},{"id":"س-02367","fp":"0d7230b97026","stateId":123,"easy":"إذا رميت مؤمناً بالكفر ← فهو كقتله","cause":"ومَن قَذَف مُؤمِنًا بِكُفرٍ","result":"فهوَ كقاتِلِه","explicit":true,"similar":["س-08274"],"ref":"صحيح الترغيب 2776","srcLabel":"متفق عليه","text":["لَيسَ على المَرءِ نَذرٌ فيما لا يَملِكُ، ولاعِنُ المُؤمنِ كقاتِلِه، ",["ومَن قَذَف مُؤمِنًا بِكُفرٍ ",1],["فهوَ كقاتِلِه، ",2],"ومَن قَتَل نَفْسَه بِشَيءٍ عذَّبَه اللهُ بِما قَتَل بِه نَفسَه يومَ القيامَةِ."],"grade":"صحيح","narrator":"ثابت بن الضحاك","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6047)، ومسلم (110) باختلاف يسير.","bab":"إسلام › حرمة المسلم","dorar":"XyD8F1In"},{"id":"س-03019","fp":"6fe0c4d7f351","stateId":123,"easy":"إذا شهدت على مسلم بكفر ← فهو كقتله","cause":"ومَن شهِدَ على مُسلِمٍ -أو قال: مُؤمِنٍ- بكُفرٍ","result":"فهو كقَتلِهِ","explicit":true,"ref":"تخريج المسند لشعيب 16391","srcLabel":"متفق عليه","text":["مَن قتَلَ نَفْسَهُ بشيءٍ؛ عُذِّبَ به، ",["ومَن شهِدَ على مُسلِمٍ -أو قال: مُؤمِنٍ- بكُفرٍ؛ ",1],["فهو كقَتلِهِ، ",2],"ومَن لعَنَهُ؛ فهو كقَتلِهِ، ومَن حلَفَ على مِلَّةٍ غَيرِ الإسلامِ كاذبًا؛ فهو كما حلَفَ."],"grade":"صحيح","narrator":"ثابت بن الضحاك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6105)، ومسلم (110) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"CtVwll2I"},{"id":"س-03020","fp":"1a9aa98a9572","stateId":123,"easy":"إذا لعنت مسلماً ← فهو كقتله","cause":"ومَن لعَنَهُ","result":"فهو كقَتلِهِ","explicit":true,"repOf":"س-02374","ref":"تخريج المسند لشعيب 16391","text":["مَن قتَلَ نَفْسَهُ بشيءٍ؛ عُذِّبَ به، ومَن شهِدَ على مُسلِمٍ -أو قال: مُؤمِنٍ- بكُفرٍ؛ فهو كقَتلِهِ، ",["ومَن لعَنَهُ؛ ",1],["فهو كقَتلِهِ، ",2],"ومَن حلَفَ على مِلَّةٍ غَيرِ الإسلامِ كاذبًا؛ فهو كما حلَفَ."],"grade":"صحيح","narrator":"ثابت بن الضحاك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6105)، ومسلم (110) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"CtVwll2I"},{"id":"س-04281","fp":"f9a8d1292c80","stateId":123,"easy":"إذا رميت أحداً بالكفر أو قلت «عدو الله» وليس كذلك ← رجعت عليك","cause":"ومن دعا رجلًا بالكفرِ","result":"أو قال : عدوُّ اللهِ ، وليس كذلك إلا حارَتْ عليه","explicit":true,"similar":["س-04791","س-05167","س-04904","س-05025"],"ref":"صحيح الأدب المفرد 336","srcLabel":"متفق عليه","text":["من ادَّعى لغيرِ أبيه وهو يعلمُ فقد كفر ، ومن ادَّعى قومًا ليس هو منهم فلْيتبوَّأْ مقعدَه من النارِ ، ",["ومن دعا رجلًا بالكفرِ ، ",1],["أو قال : عدوُّ اللهِ ، وليس كذلك إلا حارَتْ عليه",2]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (433) واللفظ له، وأصله في صحيح البخاري (3508)، ومسلم (61) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"wYGcBCap"},{"id":"س-04791","fp":"405d2278f434","stateId":123,"easy":"إذا كفّرت أخاك ← رجعت على أحدكما","cause":"إذا كَفَّرَ الرَّجُلُ أخاه","result":"فقد باءَ بها أحَدُهما","explicit":true,"repOf":"س-04281","ref":"صحيح مسلم 60","text":[["إذا كَفَّرَ الرَّجُلُ أخاه ",1],["فقد باءَ بها أحَدُهما",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6104) بلفظ: \"إذا قال الرجل لأخيه: يا كافر..\"","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"WwGubLYh"},{"id":"س-05167","fp":"10b526587fac","stateId":123,"easy":"إذا رميت أحداً بالفسق أو الكفر وليس كذلك ← ارتدّت عليك","cause":"لا يَرمِي رجلٌ رجلًا بالفُسوقِ ولا يَرمِيَه بالكفرِ","result":"إلَّا ارتَدَّتْ عليهِ ؛ إنْ لَم يكُنْ صاحبُه كذلِكَ","explicit":true,"repOf":"س-04281","ref":"صحيح الأدب المفرد 335","text":[["لا يَرمِي رجلٌ رجلًا بالفُسوقِ ولا يَرمِيَه بالكفرِ",1]," ",["إلَّا ارتَدَّتْ عليهِ ؛ إنْ لَم يكُنْ صاحبُه كذلِكَ",2]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6045)، وأحمد (21571)، والبزار (3919) جميعهم بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"D2AWjX2V"},{"id":"س-08274","fp":"e19c100b5509","stateId":123,"easy":"إذا رميت مؤمناً بالكفر ← فهو كقتله","cause":"ومَن رَمَى مُؤْمِنًا بكُفْرٍ","result":"فَهو كَقَتْلِهِ","explicit":true,"repOf":"س-02367","ref":"الإحكام في أصول الأحكام 2/504","text":["لَعْنُ المؤمِنِ كقَتلِه [يعني حديث: مَن حَلَفَ بغيرِ مِلَّةِ الإسْلامِ فَهو كما قالَ، قالَ: ومَن قَتَلَ نَفْسَهُ بشيءٍ عُذِّبَ به في نارِ جَهَنَّمَ، ولَعْنُ المُؤْمِنِ كَقَتْلِهِ، ",["ومَن رَمَى مُؤْمِنًا بكُفْرٍ ",1],["فَهو كَقَتْلِهِ",2],".]"],"grade":"صحيح","narrator":"[ثابت بن الضحاك]","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6105)، ومسلم (110)، وأحمد (16385) جميعهم بلفظه مطولا.","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"liqMOyV9"},{"id":"س-06782","fp":"f9b999039f3f","stateId":123,"easy":"إذا عيّرت أحداً بأمه ← ففيك جاهلية","cause":"فعَيَّرتُه بأُمِّه","result":"إنَّكَ امرُؤٌ فيكَ جاهِليَّةٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-00409","ref":"صحيح مسلم 1661","text":["مَرَرنا بأبي ذَرٍّ بالرَّبَذةِ وعليه بُردٌ وعلى غُلامِه مِثلُه، فقُلنا: يا أبا ذَرٍّ لو جَمَعتَ بينَهما كانَت حُلَّةً، فقال: إنَّه كان بَيني وبينَ رَجُلٍ مِن إخواني كَلامٌ، وكانَت أُمُّه أعجَميَّةً، ",["فعَيَّرتُه بأُمِّه",1],"، فشَكاني إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم، فلَقيتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم، فقال: يا أبا ذَرٍّ، ",["إنَّكَ امرُؤٌ فيكَ جاهِليَّةٌ",2],"، قُلتُ: يا رَسولَ اللهِ، مَن سَبَّ الرِّجالَ سَبُّوا أباه وأُمَّه، قال: يا أبا ذَرٍّ، إنَّكَ امرُؤٌ فيكَ جاهِليَّةٌ، هُم إخوانُكُم، جَعَلَهمُ اللهُ تَحتَ أيديكُم، فأطعِموهم ممَّا تَأكُلونَ، وألبِسوهم ممَّا تَلبَسونَ، ولا تُكَلِّفوهم ما يَغلِبُهم، فإن كَلَّفتُموهم فأعينوهم. [وفي روايةٍ]: وزادَ في حَديثِ زُهَيرٍ وأبي مُعاويةَ بَعدَ قَولِه: إنَّكَ امرُؤٌ فيكَ جاهِليَّةٌ، قال: قُلتُ: على حالِ ساعَتي مِنَ الكِبَرِ؟ قال: نَعَم. وفي رِوايةِ أبي مُعاويةَ: نَعَم على حالِ ساعَتِكَ مِنَ الكِبَرِ. وفي حَديثِ عيسى: فإن كَلَّفَه ما يَغلِبُه فليَبِعْه. وفي حَديثِ زُهَيرٍ: فليُعِنْه عليه. وليسَ في حَديثِ أبي مُعاويةَ: فليَبِعْه، ولا فليُعِنْه، انتَهى عِندَ قَولِه: ولا يُكَلِّفْه ما يَغلِبُه."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (30)، ومسلم (1661).","bab":"عتق وولاء › الإحسان إلى العبيد","dorar":"iwzGBSJl","merged":5,"otherRefs":["صحيح أبي داود 5157 (صحيح)","مجموع الفتاوى 10/106 (صحيح)","صحيح مسلم 1661 (صحيح)","صحيح البخاري 6050 (صحيح)"]},{"id":"س-02377","fp":"f7e6b4d430b7","stateId":123,"easy":"إذا سببت مسلماً ← فهو فسوق","cause":"سِبابُ المسلمِ","result":"فُسوقٌ","explicit":true,"similar":["س-00195"],"ref":"مجمع الزوائد 8/76","srcLabel":"الطبراني","text":["انتهى النَّبيُّ صلَّى اللهُ عليه وسلَّم إلى مجلسٍ من مجالسِ الأنصارِ ورجلٌ منهم كان يُعرَفُ بالبَذاءِ فقال النَّبيُُّ صلَّى اللهُ عليه وسلَّم ",["سِبابُ المسلمِ",1]," ",["فُسوقٌ",2]," وقتالُه كفرٌ"],"grade":"صحيح","narrator":"عمرو بن النعمان بن مقرن","muhaddith":"رجاله رجال الصحيح غير أبي خالد الوالبي وهو ثقة","takhrij":"أخرجه ابن أبي الدنيا في ((الصمت)) (590) مختصراً، ومحمد بن نصر المروزي في ((تعظيم قدر الصلاة)) (1100) بنحوه، والطبراني (17/39) (80) باختلاف يسير.","bab":"إسلام › حرمة المسلم","dorar":"ZK2qOUpR","merged":3,"otherRefs":["صحيح الأدب المفرد 334 (صحيح)","تخريج المسند لشاكر 6/4 (صحيح)"]},{"id":"س-00195","fp":"457da576049d","stateId":123,"easy":"إذا سببت مسلماً ← فهو فسوق","cause":"وسبابَهُ","result":"فسوقٌ","explicit":true,"repOf":"س-02377","ref":"الجامع الصغير 2591","text":["إِنَّما هما اثنتانِ الكلامُ والهديُ ، فأحسنُ الكلامِ كلامُ اللهِ ، وأحسنُ الهدْيِ هديُ محمدٍ ، ألَا وإيَّاكم ومحدَثاتِ الأمورِ ، فإِنَّ شرَّ الأمورِ مُحْدَثاتُها ، وكُلَّ محدَثَةٍ بدعةٌ ، وكُلَّ بِدْعَةٍ ضلالَةٌ ، ألَا لَا يَطولَنَّ عليكم الأمَدُ فتقسو قلوبُكُم ، ألَا إِنَّ كُلَّ ما هو آتٍ قريبٌ ، وإِنَّما البعيدُ ما ليس بآتٍ ، ألَا إِنَّما الشَّقِيُّ مَنْ شقِيَ في بطنِ أُمِّهِ ، والسعيدُ مَنْ وُعِظَ بِغَيْرِهِ ، ألَا إِنَّ قتالَ المؤمِنِ كفْرٌ ، ",["وسبابَهُ",1]," ",["فسوقٌ",2]," ، ولَا يَحِلُ لمسلِمٍ أنْ يهجُرَ أخاهُ فوقَ ثلاثٍ ، ألَا وإيَّاكم والكذبَ ، فإِنَّ الكذبَ لا يصلُحُ لَا بالجدِّ ، ولَا بالْهَزْلِ ، ولَا يعِدُ الرجلُ صَبِيَّهُ ولَا يفِي ، وإِنَّ الكذِبَ يهدِي إلى الفجورِ ، وإِنَّ الفجورَ يهدي إلى النارِ ، وإِنَّ الصدقَ يهدي إلى البرِ ، وإِنَّ البرَّ يهدي إلى الجنَّةِ ، وإِنَّه يقالُ للصادقِ : صدقَ وبَرَّ ، ويقالُ للكاذِبِ : كذَبَ وفجرَ ، ألَا وإِنَّ العبدَ يكذِبُ حتى يُكْتَبَ عندَ اللهِ كذابًا"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (46) واللفظ له، والطبراني (9/99) (8520) باختلاف يسير، والبيهقي في ((شعب الإيمان)) (4787) مختصراً باختلاف يسير","bab":"آداب الكلام › الصدق وما جاء فيه","dorar":"UhkJzNNf","merged":2,"otherRefs":["تخريج المسند لشعيب 4394 (صحيح)"]},{"id":"س-00515","fp":"8f4191dae0a0","stateId":123,"easy":"إذا قلت لأخيك «يا كافر» ← فهو كقتله، ولعنه كقتله","cause":"إذا قال الرجلُ لِأَخِيهِ : يا كَافِرُ","result":"فهوَ كَقَتْلِه ، و لَعْنُ المُؤْمِنِ كَقَتْلِه","explicit":true,"ref":"صحيح الجامع 710","srcLabel":"أحمد","text":[["إذا قال الرجلُ لِأَخِيهِ : يا كَافِرُ ",1],["فهوَ كَقَتْلِه ، و لَعْنُ المُؤْمِنِ كَقَتْلِه",2]],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (18/ 193) (463) واللفظ له، وأحمد بن منيع كما في ((المطالب العالية)) (2715) باختلاف يسير، والبزار (3519) مختصرًا على الفقرة الأولى.","bab":"آداب عامة › ضرب الأمثال","dorar":"1KY2qPez"},{"id":"س-04763","fp":"4d167479856b","stateId":123,"easy":"إذا لعنت أخاك ← فقد أتيت باباً من الكبائر","cause":"يَلْعَنُ أَخَاهُ","result":"قد أَتَى بابًا مِنَ الكبائرِ","explicit":true,"ref":"السلسلة الصحيحة 2649","srcLabel":"الطبراني","text":["كُنَّا إذا رَأَيْنا الرجلَ ",["يَلْعَنُ أَخَاهُ",1]," رَأَيْنا أنَّهُ ",["قد أَتَى بابًا مِنَ الكبائرِ",2]],"grade":"صحيح","narrator":"سلمة بن الأكوع","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6674) واللفظ له.","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"uQ1wQwM0"},{"id":"س-04770","fp":"2fbf4248bc17","stateId":123,"easy":"إذا لعنت شيئاً ليس أهلاً للعن ← ترجع اللعنة عليك","cause":"إنَّ العَبدَ إذا لعنَ شيئًا","result":"صعِدتِ اللَّعنةُ إلى السَّماءِ ، فغُلِّقتْ أبوابُها دونَها ، ثمَّ تَهبِطُ إلى الأرضِ فتُغلَقُ أبوابُها دونَها ، ثمَّ تأخذُ يمينًا وشمالًا ، فإذا لَم تجدْ مَساغًا رجَعتْ إلى الَّذي لُعنَ ، فإنْ كانَ لذلِكَ أهلًا وإلا رجَعتْ إلى قائِلِهَا","explicit":true,"otherNeedIds":[28],"ref":"البحر الزخار 10/24","srcLabel":"أبو داود","text":[["إنَّ العَبدَ إذا لعنَ شيئًا",1]," ",["صعِدتِ اللَّعنةُ إلى السَّماءِ ، فغُلِّقتْ أبوابُها دونَها ، ثمَّ تَهبِطُ إلى الأرضِ فتُغلَقُ أبوابُها دونَها ، ثمَّ تأخذُ يمينًا وشمالًا ، فإذا لَم تجدْ مَساغًا رجَعتْ إلى الَّذي لُعنَ ، فإنْ كانَ لذلِكَ أهلًا وإلا رجَعتْ إلى قائِلِهَا",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"محفوظ [وفيه] يحيى بن حسان ثقة صاحب حديث","takhrij":"أخرجه أبو داود (4905)، وابن أبي الدنيا في ((الصمت)) (381)، والبيهقي في ((شعب الإيمان)) (5162) باختلاف يسير","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"Cgg6zF04"},{"id":"س-04904","fp":"b25fc23df357","stateId":123,"easy":"إذا كفّرت أحداً ← رجعت على أحدكما","cause":"ما أكفَر رجلٌ رجلًا قطُّ","result":"إلَّا باء أحدُهما بها إنْ كان كافرًا وإلا كفَر بتكفيرِه","explicit":true,"repOf":"س-04281","ref":"صحيح ابن حبان 248","text":[["ما أكفَر رجلٌ رجلًا قطُّ",1]," ",["إلَّا باء أحدُهما بها إنْ كان كافرًا وإلا كفَر بتكفيرِه",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (864)، والخرائطي في ((مساوئ الأخلاق)) (17)، والديلمي في ((الفردوس)) (6337) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"VBLxZdOV"},{"id":"س-05025","fp":"cab06b1c7150","stateId":123,"easy":"إذا كفّرت أحداً ← باء بها أحدكما","cause":"ما كفَّر رجلٌ رجلًا قطُّ","result":"إلَّا باءَ بها أحدُهما","explicit":true,"repOf":"س-04281","ref":"صحيح الجامع 5545","text":[["ما كفَّر رجلٌ رجلًا قطُّ",1]," ",["إلَّا باءَ بها أحدُهما",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري وعبدالله بن عمر وأبو هريرة وأبو ذر الغفاري","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"phWz4ZnN"},{"id":"س-02538","fp":"d864df111a1c","stateId":123,"easy":"إذا تسابّ رجلان ← فهما شيطانان يتهاتران ويتكاذبان","cause":"المُستَبَّانِ","result":"شَيطانانِ، يَتَهاتَرانِ، ويَتكاذَبانِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج المسند لشعيب 17489","srcLabel":"مسلم","text":["أنَّه سأَلَ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فقال: يا رسولَ اللهِ، أرأيْتَ الرَّجُلَ يَشتُمُني، وهو أنقَصُ منِّي نَسبًا؟ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["المُستَبَّانِ",1]," ",["شَيطانانِ، يَتَهاتَرانِ، ويَتكاذَبانِ",2],"."],"grade":"صحيح","narrator":"عياض بن حمار","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (17489) واللفظ له، والطيالسي (1176) مطولاً، والبزار (3493) باختلاف يسير","bab":"إيمان › أعمال الجن والشياطين","dorar":"HdDCrXfw","merged":6,"otherRefs":["تخريج صحيح ابن حبان 5726 (صحيح)","صحيح الجامع 6696 (صحيح)","تخريج صحيح ابن حبان 5727 (صحيح)","تخريج المسند لشعيب 17483 (صحيح)","فيض القدير 6/ 267 (صحيح)"]},{"id":"س-04970","fp":"838bb77a694b","stateId":124,"easy":"إذا أصررت على يمين تضر أهلك ← فهو أعظم إثماً من الكفارة","cause":"إذا استَلَجَّ أحَدُكُم باليَمينِ في أهلِهِ","result":"فإنَّه آثَمُ عِندَ اللهِ منَ الكَفَّارةِ","explicit":true,"similar":["س-01759","س-05088"],"ref":"المستدرك على الصحيحين 8038","srcLabel":"متفق عليه","text":[["إذا استَلَجَّ أحَدُكُم باليَمينِ في أهلِهِ",1],"، ",["فإنَّه آثَمُ عِندَ اللهِ منَ الكَفَّارةِ",2]," الَّتي أُمِرَ بها."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6626)، ومسلم (1655)، وابن ماجة (2114) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"z0qFmJ4H","merged":2,"otherRefs":["الجامع الصغير 430 (صحيح)"]},{"id":"س-01759","fp":"2ac7bfc3c406","stateId":124,"easy":"إذا أصررت على يمين تضرّ أهلك ← فهو أعظم إثماً","cause":"مَنِ استَلَجَّ في أهلِه بيَمينٍ","result":"فهو أعظَمُ إثمًا","explicit":true,"repOf":"س-04970","ref":"صحيح البخاري 6626","text":[["مَنِ استَلَجَّ في أهلِه بيَمينٍ",1]," ",["فهو أعظَمُ إثمًا",2],"، ليَبَرَّ. يَعني الكَفَّارةَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6626) واللفظ له، ومسلم (1655)","bab":"أيمان › تعظيم شأن الأيمان","dorar":"WyuYtdQD"},{"id":"س-05088","fp":"33fb56fbb8da","stateId":124,"easy":"إذا أصررت على يمين تضر أهلك ← فهو آثم لك من أداء الكفارة","cause":"لَأنْ يَلِجَ أَحدُكم بِيَمينِه في أَهلِه","result":"آثَمُ له عنْدَ اللهِ مِن أنْ يُعطِيَ كَفَّارَتَه الَّتي فرَضَ اللهُ عزَّ وجلَّ","explicit":true,"repOf":"س-04970","ref":"تخريج المسند لشعيب 8208","text":["واللهِ ",["لَأنْ يَلِجَ أَحدُكم بِيَمينِه في أَهلِه",1],"؛ ",["آثَمُ له عنْدَ اللهِ مِن أنْ يُعطِيَ كَفَّارَتَه الَّتي فرَضَ اللهُ عزَّ وجلَّ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6625)، ومسلم (1655) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"sQIEL5EW"},{"id":"س-04391","fp":"fd48866b3b5e","stateId":124,"easy":"إذا اشتريت بعهد الله وأيمانك ثمناً قليلاً ← فهي من الكبائر","cause":"الذين يشترون بعهد الله وأيمانهم ثمنا قليلا","result":"ذكروا الكبًائر","explicit":true,"ref":"تفسير الطبري 4/1/61","srcLabel":"تفسير الطبري","text":["أن ناسا من أصحاب رسول اللهِ صلى الله عليه وسلم ",["ذكروا الكبًائر",2]," ، وهو متكئ ، فقالوا : الشرك بًالله ، وأكل مال اليتيم ، وفرار من الزحف ، وقذف المحصنة ، وعقوق الوالدين ، وقول الزور ، والغلول ، والسحر ، وأكل الربًا ، فقال رسول اللهِ صلى الله عليه وسلم : فأين تجعلون : ?إن ",["الذين يشترون بعهد الله وأيمانهم ثمنا قليلا",1],"? إلى آخر الآية"],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"ثابت","takhrij":"لم أقف عليه إلا عند الطبري في التفسير","bab":"جهاد › التولي والفرار من الزحف","dorar":"LqUrIbiR"},{"id":"س-01758","fp":"93d4fda4df93","stateId":124,"easy":"إذا حلفت يميناً غموساً ← فهي من الكبائر","cause":"إنَّ اليَمينَ الغَموسَ","result":"مِنَ الكَبائرِ","explicit":true,"ref":"الوهم والإيهام 5/792","srcLabel":"الوهم والإيهام","text":[["إنَّ اليَمينَ الغَموسَ ",1],["مِنَ الكَبائرِ",2]],"grade":"حسن","muhaddith":"حسن","bab":"أيمان › تعظيم شأن الأيمان","dorar":"bam1rsbu"},{"id":"س-01756","fp":"43207dbfeb8d","stateId":124,"easy":"إذا حلفت بالله كاذباً ← فالله يعلم ما فعلت","cause":"مَن حَلِفَ بي كاذِبًا","result":"ما عَلِمَ ذلك","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"مجمع الزوائد 4/183","srcLabel":"الحاكم","text":["إنَّ اللهَ جلَّ ذِكرُه أَذِنَ لي أنْ أُحدِّثَ عن ديكٍ، قد مزَّقتْ رِجْليهِ الأرضُ، وعُرفُه مُنثَنٍ تحت العَرشِ، وهو يقولُ: سُبحانَك ما أعظَمَك ربَّنا، فيَرُدُّ عليه: ",["ما عَلِمَ ذلك",2]," ",["مَن حَلِفَ بي كاذِبًا",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (7324)، وأبو الشيخ في ((العظمة)) (524) بلفظه، والحاكم (7813) باختلاف يسير.","bab":"أيمان › تعظيم شأن الأيمان","dorar":"NpP6tfjh"},{"id":"س-00349","fp":"e0efa2566e09","stateId":125,"easy":"إذا كنت ثرثاراً متشدقاً متفيهقاً ← تكون من شرار الأمة","cause":"الثَّرثَارونَ ، والمتشدِّقُونَ ، المتفَيهِقونَ","result":"شرارُ أُمَّتي","explicit":true,"ref":"صحيح الأدب المفرد 982","srcLabel":"البخاري","text":[["شرارُ أُمَّتي",2]," ",["الثَّرثَارونَ ، والمتشدِّقُونَ ، المتفَيهِقونَ",1]," ، وخيارُ أُمَّتي أحاسِنُهُم أخلاقًا"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (8822)، والبخاري في ((الأدب المفرد)) (1308) باختلاف يسير، والبزار (9442) مطولاً باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"MSYlziSI"},{"id":"س-00406","fp":"263491b71512","stateId":125,"easy":"إذا مدحت أحداً في وجهه بإفراط ← قطعت عنقه","cause":"إن كانَ أحدُكُم مادِحًا","result":"قطَعتَ عُنُقَ صاحِبِك","explicit":true,"ref":"صحيح الأدب المفرد 253","srcLabel":"متفق عليه","text":["ويحكَ ",["قطَعتَ عُنُقَ صاحِبِك",2]," ، يقولُه مِرارًا ",["إن كانَ أحدُكُم مادِحًا",1]," لا مَحالةَ ، فليقُل : أحسَبُ كَذا و كَذا إن كان يَرى أنَّهُ كذلِك و حَسيبُه اللهُ ، و لا يُزَكِّي على اللهِ أحدًا"],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6061) واللفظ له، ومسلم (3000) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"23adncss"},{"id":"س-07487","fp":"f50185a96ef6","stateId":125,"easy":"إذا أطلقت لسانك ← تشكوه جوارحك إلى الله","cause":"الِّلسانَ على حِدَّتِه","result":"ليس شيءٌ من الجسدِ إلا يشكو إلى اللهِ","explicit":true,"ref":"السلسلة الصحيحة 2/71","srcLabel":"البخاري","text":["أنَّ عمرَ بنَ الخطابِ اطَّلع على أبِي بكرٍ الصديقِ رضيَ اللهُ عنهُما وهو يمدُّ لسانَه فقال ما تصنعُ يا خليفةَ رسولِ اللهِ ؟ فقال : هذا أوردَني المواردَ إنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ قال ",["ليس شيءٌ من الجسدِ إلا يشكو إلى اللهِ",2]," ",["الِّلسانَ على حِدَّتِه",1]],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"صحيح الإسناد على شرط البخاري","takhrij":"أخرجه أبو يعلى (5)، وابن أبي الدنيا في ((الورع)) كلاهما بلفظه، وأبو نعيم في ((حلي الأولياء)) (9/ 17) مختصرا،","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"MbxG8d9X"},{"id":"س-04769","fp":"88bfd80e4b0b","stateId":125,"easy":"إذا أطلقت لسانك ← فأكثر خطايا ابن آدم منه","cause":"من لسانِه","result":"أكثرُ خطايا ابنِ آدمَ","explicit":true,"ref":"مجمع الزوائد 10/302","srcLabel":"الطبراني","text":["عن عبدِ اللهِ أنَّه ارتقى الصَّفا فأخَذ بلسانِه فقال يا لسانِ قُلْ خيرًا تغنَمْ واسكُتْ عن شرٍّ تسلَمْ من قبلِ أن تندَمَ من قبلِ أن تندَمَ ثُمَّ قال سمِعْتُ رسولَ اللهِ صلَّى اللَّهُ عليه وسلَّم يقولُ ",["أكثرُ خطايا ابنِ آدمَ",2]," ",["من لسانِه",1]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني (10/243) (10446) واللفظ له، وأبو نعيم في ((حلية الأولياء)) (4/107)، والبيهقي في ((شعب الإيمان)) (4933)","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"2D69Hf7Y","merged":2,"otherRefs":["السلسلة الصحيحة 534 (صحيح)"]},{"id":"س-06004","fp":"2cd45deb60c1","stateId":125,"easy":"إذا كنت بذيئاً فاحشاً بخيلاً ← كفى بك شراً","cause":"يَكونَ بذيًّا فاحِشًا بخيلًا","result":"كفى بالرَّجلِ","explicit":true,"ref":"هداية الرواة 4836","srcLabel":"أحمد","text":["أنسابُكُم هذِهِ لَيسَتْ بِمَسبَّةٍ علَى أحدٍ ، كلُّكم بنو آدمَ، طفُّ الصَّاعِ بالصَّاعِ لم تَملَأوها، ليسَ لأحدٍ علَى أحدٍ فضلٌ إلَّا بدينٍ وَتَقوى، ",["كفى بالرَّجلِ",2]," أن ",["يَكونَ بذيًّا فاحِشًا بخيلًا",1],"."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17446)، والبيهقي في ((الشعب)) (5146) باختلاف يسير.","bab":"رقائق وزهد › تقوى الله","dorar":"lnvomoyx","merged":2,"otherRefs":["تخريج مشكل الآثار 3459 (حسن)"]},{"id":"س-07425","fp":"4ad647c07d5b","stateId":125,"easy":"إذا أطلقت لسانك في الفتنة ← فهو كوقوع السيف","cause":"وإشرافُ اللسانِ فيها","result":"كوقوعِ السيفِ","explicit":true,"ref":"الجامع الصغير 4662","srcLabel":"أبو داود","text":["ستكونُ فتنَةٌ صمَّاءُ بكماءُ عمياءُ ، من أشرفَ لها استشرفَتْ له ، ",["وإشرافُ اللسانِ فيها",1]," ",["كوقوعِ السيفِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1623)، والطبراني في ((الأوسط)) (8717)، وابن بطة في ((الإبانة)) (768) واللفظ لهم.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"XgFwpl81","merged":2,"otherRefs":["تخريج المسند لشاكر 11/170 (صحيح)"]},{"id":"س-00264","fp":"52efd5b68049","stateId":125,"easy":"إذا كنت فاحشاً متفحّشاً ← فليس ذلك من الإسلام في شيء","cause":"إنَّ الفُحشَ، وَالتَّفَحُّشَ","result":"ليسا مِنَ الإسلامِ في شَيءٍ","explicit":true,"ref":"تخريج المسند لشعيب 20943","srcLabel":"أحمد","text":["كنتُ جالِسًا في مَجلِسٍ فيهِ رَسولُ اللهِ صلَّى اللهُ عليهِ وسَلَّمَ وأبي سَمُرَةُ جالِسٌ أمامي، فقالَ رَسولُ اللهِ صلَّى اللهُ عليهِ وسَلَّمَ: ",["إنَّ الفُحشَ، وَالتَّفَحُّشَ",1]," ",["ليسا مِنَ الإسلامِ في شَيءٍ",2],"، وإنَّ خَيرَ النَّاسِ إسلامًا أحسَنُهم خُلُقًا، قالَ ابنُ أبي شَيبةَ في حَديثِهِ: زَكريَّا بنِ أبي يَحيى، عن عِمرانَ بنِ رِياحٍ."],"grade":"صحيح","narrator":"جابر بن سمرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه عبدالله بن أحمد في ((زوائد المسند)) (20943) واللفظ له، وابن أبي شيبة (25825)، وأبو يعلى (7468)","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"QWDFiKNi"},{"id":"س-00446","fp":"e5704b50cdc3","stateId":125,"easy":"إذا فحشت ← فالفحش ألأم الأخلاق","cause":"الفحشُ","result":"ألأمُ أخلاقِ المؤمنِ","explicit":true,"ref":"صحيح الأدب المفرد 239","srcLabel":"البخاري (الأدب المفرد)","text":["عن عبدِ اللهِ بنِ مسعودٍ قال ",["ألأمُ أخلاقِ المؤمنِ",2]," ",["الفحشُ",1]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"آداب عامة › الأخلاق المذمومة","dorar":"a6LVaWbM"},{"id":"س-05857","fp":"ac183e44239c","stateId":125,"easy":"إذا تكلمت فيما لا يعنيك ← لا يُؤمن عليك الوزر","cause":"لا تَكلَّمْ فيما لا يعنيك","result":"فإنَّه فضلٌ ولا آمَنُ عليك الوِزرَ","explicit":true,"ref":"الترغيب والترهيب 4/26","srcLabel":"أبو داود","text":["عن ابنِ عبَّاسٍ  رضِي اللهُ عنهما قال : سمِعتُه يقولُ : خمسٌ لهنَّ أحسنُ من الدُّهْمِ المُوقَفةِ : ",["لا تَكلَّمْ فيما لا يعنيك",1]," ، ",["فإنَّه فضلٌ ولا آمَنُ عليك الوِزرَ",2]," ، ولا تَكلَّمْ فيما لا يعنيك حتَّى تجِدَ له مَوضعًا ، فإنَّه رُبَّ مُتكلِّمٍ في أمرٍ يعنيه قد وضعه في غيرِ موضعِه فعُيِّب ، ولا تُمارِ حليمًا ولا سفيهًا ، فإنَّ الحليمَ يُقليك ، وإنَّ السَّفيهَ يُؤذيك ، واذكُرْ أخاك إذا تغيَّب عنك بما تحِبُّ أن يذكُرَك به ، وأعْفِه ممَّا تُحِبُّ أن يُعفيَك منه ، واعمَلْ عملَ رجلٍ يرَى أنَّه مجازًى بالإحسانِ مأخوذٌ بالإجرامِ"],"grade":"صحيح","narrator":"مجاهد بن جبر المكي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن أبي الدنيا في ((الصمت)) (114) واللفظ له، وأبو داود في ((الزهد)) (334) والبيهقي في ((شعب الإيمان)) (4663) بنحوه","bab":"رقائق وزهد › الوصايا النافعة","dorar":"gaRpFUyh"},{"id":"س-05239","fp":"868b8307e31d","stateId":125,"easy":"إذا أكثرت الخوض في الباطل ← تكون أكثر الناس خطايا يوم القيامة","cause":"أكثرُهم خوضًا في الباطلِ","result":"أكثرُ النَّاسِ خطايا يومَ القيامةِ","explicit":true,"ref":"مجمع الزوائد 10/306","srcLabel":"أبو داود","text":["[ عن عبدِ اللهِ بنِ مسعودٍ ] قال ",["أكثرُ النَّاسِ خطايا يومَ القيامةِ",2]," ",["أكثرُهم خوضًا في الباطلِ",1]],"grade":"حسن","narrator":"[حصين بن عقبة]","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني ((9/ 104)\n) (8547) واللفظ له، وأحمد في ((الزهد)) (877)، وأبو داود في ((الزهد)) (150)،   والبيهقي في ((شعب الإيمان)) (10317) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"7BIovmLQ","merged":2,"otherRefs":["فيض القدير 2/ 81 (حسن)"]},{"id":"س-05447","fp":"fb086144b5e2","stateId":125,"easy":"إذا أطلقت لسانك ← يوردك الموارد (أثر أبي بكر)","cause":"يجبِذُ لسانَهُ","result":"إنَّ هذا أوْردني المواردَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"هداية الرواة 4797","srcLabel":"مالك","text":["إنَّ عمرَ دخل يومًا على أبي بكرٍ الصديقِ - رضي اللهُ عنهم - وهو ",["يجبِذُ لسانَهُ",1],"، فقال عمرُ :مهْ ؟ ! غفر اللهُ لكَ ! فقال لهُ أبو بكرٍ : ",["إنَّ هذا أوْردني المواردَ",2]," ."],"grade":"صحيح","narrator":"أسلم مولى عمر بن الخطاب","muhaddith":"إسناده صحيح","takhrij":"أخرجه مالك (3621)، وأبو نعيم في ((حلية الأولياء)) (1/ 33) بلفظه، وابن أبي شيبة (38202) باختلاف يسير.","bab":"رقائق وزهد › الخوف من الله","dorar":"9ul6bEwk"},{"id":"س-05739","fp":"f01eee6a7b0c","stateId":125,"easy":"إذا بالغت في مدح الرجل ← تهلكه (أثر ابن عمر)","cause":"يا خَيرَ الناسِ -أو ابنَ خَيرِ الناسِ","result":"لن تَزالوا بالرَّجُلِ حتى تُهلِكوه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج سير أعلام النبلاء 3/236","srcLabel":"معمر","text":["أنَّ رَجُلًا قال لابنِ عُمَرَ: ",["يا خَيرَ الناسِ -أو ابنَ خَيرِ الناسِ",1],". فقال: ما أنا بخَيرِ الناسِ، ولا ابنِ خَيرِ الناسِ، ولكِنِّي عَبدٌ مِن عِبادِ اللهِ، أرجو اللهَ، وأخافُه، واللهِ ",["لن تَزالوا بالرَّجُلِ حتى تُهلِكوه",2],"."],"grade":"صحيح","narrator":"نافع","muhaddith":"سنده صحيح","takhrij":"أخرجه معمر بن راشد في ((الجامع)) (20523)، وعبد الرزاق (21598)، وأبو نعيم في ((حلية الأولياء)) (1/ 307)، وابن عساكر (31/ 155) واللفظ لهم.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"rbTleYnd"},{"id":"س-06241","fp":"55451d2bf560","stateId":125,"easy":"إذا قلت شعراً فاحشاً في الإسلام ← فلسانك هدر","cause":"مَن قال في الإسلامِ شِعرًا مُقذِعًا","result":"فلسانُه هَدَرٌ","explicit":true,"otherNeedIds":[56],"ref":"مجمع الزوائد 8/126","srcLabel":"البيهقي","text":[["مَن قال في الإسلامِ شِعرًا مُقذِعًا",1]," ",["فلسانُه هَدَرٌ",2]],"grade":"حسن","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"رجاله ثقات وفي بعضهم خلاف","takhrij":"أخرجه البزار (4403)، والبيهقي في ((شعب الإيمان)) (5088)","bab":"شعر › الرخصة في الشعر ما لم يكن شركا أو هجاء مسلم","dorar":"4eBeJqP6"},{"id":"س-07189","fp":"999316e03364","stateId":125,"easy":"إذا أكثرت الكلام ← تقع في الهُجر (الفحش)","cause":"مَن يُكثِرْ","result":"يَهجُرْ","explicit":true,"ref":"تخريج سير أعلام النبلاء 3/403","srcLabel":"البيهقي","text":["عن أنَسٍ -قيل له: ألَا تُحدِّثُنا؟- قال: يا بُنَيَّ، إنَّه ",["مَن يُكثِرْ",1]," ",["يَهجُرْ",2],"."],"grade":"حسن","narrator":"ثابت","muhaddith":"رجاله ثقات","takhrij":"أخرجه ابن سعد في ((الطبقات الكبرى)) (7/ 22)، والبيهقي في ((شعب الإيمان)) (4660) واللفظ لهما.","bab":"علم › حسن السؤال ونصح العالم","dorar":"mCNvcf5k"},{"id":"س-03221","fp":"7ec05ab4eb9d","stateId":125,"easy":"إذا أطلقت لسانك ← فهو أخوف ما يُتقى","cause":"فأومَأ إلى لسانِه","result":"فما أتَّقي","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"تخريج المسند لشعيب 19431","srcLabel":"أحمد","text":["مُرْني في الإسلامِ بأمرٍ لا أسألُ عنه أحَدًا بَعدَكَ. قال: «قُلْ آمَنتُ باللهِ، ثُمَّ استَقِمْ». قال: قُلتُ: ",["فما أتَّقي",2],"، ",["فأومَأ إلى لسانِه",1]],"grade":"صحيح","narrator":"سفيان الثقفي","muhaddith":"إسناده صحيح","bab":"إيمان › فضل الإيمان","dorar":"Kb2SbRLa"},{"id":"س-00348","fp":"47fea12378e3","stateId":125,"easy":"إذا تفحّشت في قولك ← فالفحش أسوأ ما يكون","cause":"الفُحْشُ","result":"لكان رجُلًا سُوءًا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح الترغيب 2631","srcLabel":"الطبراني","text":["لو كان ",["الفُحْشُ",1]," رجُلًا ",["لكان رجُلًا سُوءًا",2],"."],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"حسن لغيره","takhrij":"أخرجه مطولاً ابن أبي الدنيا في ((مكارم الأخلاق)) (89) واللفظ له، والطبراني في ((المعجم الأوسط)) (331)، والبيهقي في ((شعب الإيمان)) (7722) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"37pqNckN"},{"id":"س-07025","fp":"e31d4f278ee4","stateId":125,"easy":"إذا سمعت الحكمة فلم تحدّث إلا بشر ما سمعت ← فمثلك كمن طلب من الراعي شاة فأخذ كلبها","cause":"يجلسُ فيسمعُ الحِكْمةَ ، ثمَّ لا يحدِّثُ عن صاحبِهِ ، إلَّا بشرِّ ما سَمعَ","result":"كَمَثلِ رجلٍ أتى راعيًا","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"تخريج المسند لشاكر 16/262","srcLabel":"ابن ماجه","text":["مثلُ الَّذي ",["يجلسُ فيسمعُ الحِكْمةَ ، ثمَّ لا يحدِّثُ عن صاحبِهِ ، إلَّا بشرِّ ما سَمعَ",1]," ، ",["كَمَثلِ رجلٍ أتى راعيًا ،",2]," فقالَ : يا راعيَ ، اجزُر لي شاةً مِن غنمِكَ ، قالَ : اذهَب فَخُذ بأذُنِ خَيرِها ، فذَهَبَ فأخذَ بأذنِ كَلبِ الغنمِ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن ماجه (4172)، وأحمد (8639) واللفظ له","bab":"علم › الحث على طلب العلم","dorar":"5geNSVmJ"},{"id":"س-05709","fp":"8261c7711857","stateId":126,"easy":"إذا احتقرت أخاك المسلم ← فحسبك من الشر","cause":"أن يَحقِرَ أخاه المُسلِمَ","result":"بحَسبِ امرِئٍ مِنَ الشَّرِّ","explicit":true,"star":true,"ref":"صحيح مسلم 2564","srcLabel":"متفق عليه","text":["لا تَحاسَدوا، ولا تَناجَشوا، ولا تَباغَضوا، ولا تَدابَروا، ولا يَبِعْ بَعضُكُم على بَيعِ بَعضٍ، وكونوا عِبادَ اللهِ إخوانًا. المُسلِمُ أخو المُسلِمِ، لا يَظلِمُه، ولا يَخذُلُه، ولا يَحقِرُه. التَّقوى هاهنا. ويُشيرُ إلى صَدرِه ثَلاثَ مَرَّاتٍ. ",["بحَسبِ امرِئٍ مِنَ الشَّرِّ",2]," ",["أن يَحقِرَ أخاه المُسلِمَ",1],". كُلُّ المُسلِمِ على المُسلِمِ حَرامٌ؛ دَمُه، ومالُه، وعِرضُه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6064) مختصراً، ومسلم (2564).","bab":"رقائق وزهد › الكبر والتواضع","dorar":"ZiboTABY","merged":5,"otherRefs":["تخريج العواصم والقواصم 7/ 275 (صحيح)","صحيح الجامع 4509 (صحيح)","صحيح الجامع 6706 (صحيح)","تخريج المسند لشعيب 16019 (صحيح)"]},{"id":"س-07746","fp":"d8604701c170","stateId":126,"easy":"إذا اتخذت الخيل أشراً وبطراً ← فهي عليك وزر","cause":"فالذي يَتَّخِذُها أشَرًا وبَطَرًا","result":"وأمَّا الذي عليه وِزرٌ","explicit":true,"star":true,"ref":"صحيح مسلم 987","srcLabel":"مسلم","text":["ما مِن صاحِبِ كَنزٍ لا يُؤَدِّي زَكاتَه إلَّا أُحميَ عليه في نارِ جَهَنَّمَ، فيُجعَلُ صَفائِحَ، فيُكوى بها جَنباه وجَبينُه حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ، وما مِن صاحِبِ إبِلٍ لا يُؤَدِّي زَكاتَها إلَّا بُطِحَ لها بقاعٍ قَرقَرٍ كَأوفَرِ ما كانَت تَستَنُّ عليه، كُلَّما مَضى عليه أُخراها رُدَّت عليه أولاها، حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ، وما مِن صاحِبِ غَنَمٍ لا يُؤَدِّي زَكاتَها إلَّا بُطِحَ لها بقاعٍ قَرقَرٍ كَأوفَرِ ما كانَت فتَطَؤُه بأظلافِها وتَنطَحُه بقُرونِها، ليس فيها عَقصاءُ ولا جَلحاءُ، كُلَّما مَضى عليه أُخراها رُدَّت عليه أولاها، حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ ممَّا تَعُدُّونَ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ. قال سُهَيلٌ: فلا أدري أذَكَرَ البَقَرَ أم لا، قالوا: فالخَيلُ؟ يا رَسولَ اللهِ، قال: الخَيلُ في نَواصيها -أو قال، الخَيلُ مَعقودٌ في نَواصيها. قال سُهَيلٌ: أنا أشُكُّ- الخَيرُ إلى يَومِ القيامةِ، الخَيلُ ثَلاثةٌ: فهي لرَجُلٍ أجرٌ، ولرَجُلٍ سِترٌ، ولرَجُلٍ وِزرٌ؛ فأمَّا التي هي له أجرٌ: فالرَّجُلُ يَتَّخِذُها في سَبيلِ اللهِ ويُعِدُّها له، فلا تُغَيِّبُ شيئًا في بُطونِها إلَّا كَتَبَ اللهُ له أجرًا، ولو رَعاها في مَرجٍ، ما أكَلَت مِن شيءٍ إلَّا كَتَبَ اللهُ له بها أجرًا، ولو سَقاها مِن نَهرٍ، كانَ له بكُلِّ قَطرةٍ تُغَيِّبُها في بُطونِها أجرٌ، حتَّى ذَكَرَ الأجرَ في أبوالِها وأرواثِها، ولَوِ استَنَّت شَرَفًا أو شَرَفَينِ، كُتِبَ له بكُلِّ خُطوةٍ تَخطوها أجرٌ، وأمَّا الذي هي له سِترٌ: فالرَّجُلُ يَتَّخِذُها تَكَرُّمًا وتَجَمُّلًا، ولا يَنسى حَقَّ ظُهورِها وبُطونِها في عُسرِها ويُسرِها، ",["وأمَّا الذي عليه وِزرٌ",2]," ",["فالذي يَتَّخِذُها أشَرًا وبَطَرًا",1]," وبَذَخًا ورياءَ النَّاسِ، فذاك الذي هي عليه وِزرٌ، قالوا: فالحُمُرُ يا رَسولَ اللهِ؟ قال: ما أنزَلَ اللهُ عليَّ فيها شيئًا إلَّا هذه الآيةَ الجامِعةَ الفاذَّةَ: {فمَنْ يَعمَلْ مِثقالَ ذَرَّةٍ خَيرًا يَرَهُ * ومَن يَعمَلْ مِثقالَ ذَرَّةٍ شَرًّا يَرَهُ} [الزلزلة: 7-8]. [وفي روايةٍ]: بَدَلَ عَقصاءُ: عَضباءُ، وقال: فيُكوى بها جَنبُه وظَهرُه، ولَم يَذكُرْ: جَبينُه. [وفي روايةٍ]: إذا لَم يُؤَدِّ المَرءُ حَقَّ اللهِ، أوِ الصَّدَقةَ في إبِلِه، وساقَ الحَديثَ بنَحوِ حَديثِ سُهَيلٍ عن أبيه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (987) مطولاً","bab":"قرآن › أسباب النزول","dorar":"1IlMX4Z5","merged":6,"otherRefs":["صحيح البخاري 2371 (صحيح)","تخريج المسند لشعيب 8977 (صحيح)","صحيح ابن خزيمة 4/ 51 (صحيح)","تخريج المسند لشعيب 7563 (صحيح)","صحيح مسلم 987 (صحيح)"]},{"id":"س-06094","fp":"e8c4c2290e8e","stateId":126,"easy":"إذا ربطت الخيل تفاخراً على الناس ← يكون كل ما تأكله وزراً عليك","cause":"فمن ارتبطها تبذُّخًا على الناسِ","result":"فإنها لا تُغَيِّبُ في بطونِها شيئًا إلا كان وزرًا عليه ، حتى ذكر أرْواثَها وأبوالَها ، ولا تعْدو في وادٍ شوطًا أو شوطَينِ إلا كان عليه وِزرٌ","explicit":true,"star":true,"ref":"صحيح الترغيب 1242","srcLabel":"متفق عليه","text":["الخيلُ معقودٌ في نواصيها الخيرُ إلى يومِ القيامةِ ، والخيلُ ثلاثةٌ : خيلُ أجرٍ ، وخيلُ وِزرٍ ، وخيلُ سِترٍ . فأما خيلُ سِترٍ ؛ فمَنِ اتَّخذها تعفُّفًا وتكرُّمًا وتجمُّلًا ، ولم ينْسَ حقَّ ظهورِها وبطونِها في عُسْرِه ويُسْرِه . وأما خيلُ الأجرِ ؛ فمن ارتبطها في سبيلِ اللهِ ؛ فإنها لا تُغَيِّبُ في بطونها شيئًا إلا كان له أجرٌ ؛ حتى ذكر أرْواثَهَا وأبوالَها ، ولاتَعْدو فى وادٍ شوطًا أو شوطَين ؛ إلا كان في ميزانِه . وأما خيلُ الوِزرِ ؛ ",["فمن ارتبطها تبذُّخًا على الناسِ",1]," ؛ ",["فإنها لا تُغَيِّبُ في بطونِها شيئًا إلا كان وزرًا عليه ، حتى ذكر أرْواثَها وأبوالَها ، ولا تعْدو في وادٍ شوطًا أو شوطَينِ إلا كان عليه وِزرٌ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (987) بنحوه، وأخرجه البخاري (2860 ) من قوله : الخيل ثلاثة،","bab":"رقائق وزهد › ما فيه البركة","dorar":"0jGXloqJ"},{"id":"س-03005","fp":"2e9305982d5a","stateId":126,"easy":"إذا قلت «هلك الناس» (احتقاراً) ← فأنت أهلكهم","cause":"إذا سمِعتَ الرَّجُلَ يَقولُ: هلَكَ النَّاسُ","result":"فهو أهلَكُهم","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 10697","srcLabel":"مسلم","text":[["إذا سمِعتَ الرَّجُلَ يَقولُ: هلَكَ النَّاسُ؛ ",1],["فهو أهلَكُهم",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2623)، وأبو داود (4983)، وأحمد (10697) واللفظ له","bab":"إيمان › الوعيد","dorar":"SnMhRfUZ"},{"id":"س-05702","fp":"fbec3568839c","stateId":126,"easy":"إذا قصصت على الناس بلا إذن ← فأنت مختال","cause":"يَقُصُّ على الناسِ","result":"إلَّا أميرٌ، أو مَأمورٌ، أو مُخْتالٌ","explicit":true,"ref":"تخريج المسند لشعيب 23994","srcLabel":"أبو داود","text":["لا ",["يَقُصُّ على الناسِ",1]," ",["إلَّا أميرٌ، أو مَأمورٌ، أو مُخْتالٌ",2],"."],"grade":"صحيح","narrator":"عوف بن مالك الأشجعي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3665)، وأحمد (23994) واللفظ له","bab":"رقائق وزهد › الكبر والتواضع","dorar":"L2mPETpC","merged":2,"otherRefs":["تخريج المسند لشاكر 10/145 (صحيح)"]},{"id":"س-05733","fp":"3845368ec5f9","stateId":126,"easy":"إذا قيل لك «اتقِ الله» فقلت «عليك نفسك» ← فهو من أكبر الذنب","cause":"أنْ يقولَ الرجلُ لأخيهِ اتقِ اللهَ فيقولَ عليكَ نَفْسَكَ أنتَ تَأْمُرُنِي","result":"إنَّ من أكبرِ الذنبِ","explicit":true,"ref":"مجمع الزوائد 7/274","srcLabel":"الطبراني","text":["عن عبدِ اللهِ يعني ابنَ مسعودٍ قال ",["إنَّ من أكبرِ الذنبِ",2]," ",["أنْ يقولَ الرجلُ لأخيهِ اتقِ اللهَ فيقولَ عليكَ نَفْسَكَ أنتَ تَأْمُرُنِي",1]],"grade":"صحيح","narrator":"[سعد بن وهب]","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني (9/ 113) (8587)، والبيهقي في ((الشعب)) (7896)، والنحاس في ((فضائل القرآن)) (ص104) واللفظ لهم.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"civOBwKi"},{"id":"س-05734","fp":"a127be80b449","stateId":126,"easy":"إذا قيل لك «اتقِ الله» فغضبت ← كفى بك إثماً","cause":"إذا قيل له اتقِ اللهَ غضِبَ","result":"كفى بالمرءِ إثْمًا","explicit":true,"ref":"مجمع الزوائد 7/274","srcLabel":"الطبراني","text":["عن عبدِ اللهِ قال ",["كفى بالمرءِ إثْمًا",2],[" إذا قيل له اتقِ اللهَ غضِبَ",1]],"grade":"صحيح","narrator":"[زيد بن وهب]","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني (9/ 114) (8588) واللفظ له، والبيهقي في ((الشعب)) (7896)، والنحاس في ((فضائل القرآن)) (ص104) كلاهما بنحوه.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"U77gd8N1"},{"id":"س-06205","fp":"c52f90d459b2","stateId":127,"easy":"إذا لبست المعصفر (للرجال) ← فهو من ثياب الكفار","cause":"ثوبَيْنِ مُعَصْفَرَيْنِ","result":"إن هذه من ثيابِ الكفارِ فلا تَلْبَسْهُما","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"مجموع الفتاوى 22/128","srcLabel":"مسلم","text":["رأى رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم عَلَيَّ ",["ثوبَيْنِ مُعَصْفَرَيْنِ",1]," فقال : ",["إن هذه من ثيابِ الكفارِ فلا تَلْبَسْهُما",2],"، قلتُ : أَغْسِلُهُما، قال : أَحْرِقْهُما"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"ثابت","takhrij":"أخرجه مسلم (2077) باختلاف يسير.","bab":"زينة اللباس › ما نهي عنه من اللباس","dorar":"xA7o6X3C","merged":3,"otherRefs":["تخريج المسند لشاكر 11/165 (صحيح)","تخريج المسند لشعيب 6821 (صحيح)"]},{"id":"س-00748","fp":"5f9d8e5fc35d","stateId":127,"easy":"إذا لبست ثياب الكبر والحرير (للرجال) ← ينكر النبي ﷺ عليك (من واقعة)","cause":"عليه جُبَّةٌ مِن طَيالِسَةٍ مَكْفوفَةٌ بالدِّيباجِ، أو مَزْرورَةٌ بالدِّيباجِ","result":"مُغْضَبًا، فَأخذَ بمجامَعِ ثَوْبِهِ فاجْتَذَبَهُ وقالَ: أَلا أَرى عليكَ ثيابَ مَنْ لا يَعْقِلُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 155","srcLabel":"البخاري","text":["عنْ عَبْدِ اللهِ بنِ عَمرٍو قالَ: أَتَى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ أَعْرابيٌّ ",["عليه جُبَّةٌ مِن طَيالِسَةٍ مَكْفوفَةٌ بالدِّيباجِ، أو مَزْرورَةٌ بالدِّيباجِ",1],"، فقالَ: إنَّ صاحِبَكُمْ هذا يُريدُ رَفْعَ كُلِّ راعٍ وابنِ راعٍ، ويَضَعُ كُلَّ فارسٍ وابنَ فارسٍ. فقامَ النبيُّ صلَّى اللهُ عليه وسلَّمَ ",["مُغْضَبًا، فَأخذَ بمجامَعِ ثَوْبِهِ فاجْتَذَبَهُ وقالَ: «أَلا أَرى عليكَ ثيابَ مَنْ لا يَعْقِلُ",2],"؟». ثُمَّ رَجَعَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فجَلَسَ، فقالَ: «إنَّ نُوحًا لَمَّا حَضَرَتْهُ الوَفاةُ دَعا ابْنَيْهِ فقالَ: إنِّي قاصٌّ عليكُمُ الوَصِيَّةَ: آمُرُكُما باثْنينِ وأَنهاكُما عنِ اثنينِ: أَنهاكُما عنِ الشِّرْكِ والكِبْرِ، وآمُرُكُما بِلا إلهَ إلَّا اللهُ، فإنَّ السَّمَواتِ والأَرْضَ وما فيهما لَوْ وُضِعَتْ في كِفَّةِ الميزانِ، وَوُضِعَتْ لا إلَهَ إلَّا اللهُ في الكِفَّةِ الأُخْرى كانتْ أَرْجَحَ مِنْهُما، ولوْ أنَّ السَّمَواتِ والأَرْضَ وما فيهما كانتْ حَلْقَةً فَوُضِعَتْ لا إلهَ إلَّا اللهُ عليهما لَقَصَمَتْهُما، وآمُرُكُما بِسُبْحانَ اللهِ وبحَمْدِهِ؛ فَإنَّها صلاةُ كُلِّ شيءٍ، وبها يُرْزَقُ كُلُّ شيءٍ»."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (7101)، والبخاري في ((الأدب المفرد)) (548)، والطبراني (13/ 7)، (1) جميعهم بنحوه.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"uzjseAfS"},{"id":"س-07377","fp":"d40bc7146de7","stateId":127,"easy":"إذا لبست الحرير ← فلا ينبغي هذا للمتقين","cause":"فرُّوجُ حَريرٍ","result":"لا يَنبَغي هذا للمُتَّقينَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح البخاري 5801","srcLabel":"مسلم","text":["أُهديَ لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّم ",["فرُّوجُ حَريرٍ",1]," فلَبِسَه، ثُمَّ صَلَّى فيه، ثُمَّ انصَرَفَ، فنَزَعَه نَزعًا شَديدًا، كالكارِهِ له، ثُمَّ قال: ",["لا يَنبَغي هذا للمُتَّقينَ",2],"! تابَعَه عبدُ اللهِ بنُ يوسُفَ، عَنِ اللَّيثِ، وقال غَيرُه: فرُّوجٌ حَريرٌ."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2075)","bab":"فضائل النبي وصفته ودلائل النبوة › أحوال النبي","dorar":"sr8Okdbk","merged":2,"otherRefs":["تخريج المسند لشعيب 17293 (صحيح)"]},{"id":"س-07484","fp":"310c3984b5ca","stateId":127,"easy":"إذا تفننت في ألوان الطعام والشراب والثياب وتشدقت ← فأنت من شرار الأمة","cause":"يأكلونَ ألوانَ الطعامِ ، ويشربونَ ألوانَ الشرابِ ، ويلبَسونَ ألوانَ الثيابِ ، ويتشدقونَ في الكلامِ","result":"فأولئكَ شرارُ أُمَّتِي","explicit":true,"ref":"صحيح الجامع 3663","srcLabel":"الطبراني","text":["سيكونُ رجالٌ مِنْ أمتي ",["يأكلونَ ألوانَ الطعامِ ، ويشربونَ ألوانَ الشرابِ ، ويلبَسونَ ألوانَ الثيابِ ، ويتشدقونَ في الكلامِ",1]," ، ",["فأولئكَ شرارُ أُمَّتِي",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (8/127) (7512)، وتمام في ((الفوائد)) (1683)، وأبو نعيم في ((حلية الأولياء)) (6/90)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"uQLBeW4r","merged":3,"otherRefs":["صحيح الترغيب 2149 (حسن)","صحيح الترغيب 2087 (حسن)"]},{"id":"س-07586","fp":"9cf641af8b0e","stateId":127,"easy":"إذا أسبلت ثوبك أسفل الكعبين ← فلا خير فيه","cause":"فيما أَسْفَلَ من ذلكَ","result":"لا خَيْرَ","explicit":true,"otherNeedIds":[57],"ref":"السلسلة الصحيحة 1765","srcLabel":"أحمد","text":["الإِزَارُ إلى نصفِ السَّاقِ فلمَّا رأى شِدَّةَ ذلكَ على المسلمينَ قال : إلى الكعبيْنِ ، ",["لا خَيْرَ",2]," ",["فيما أَسْفَلَ من ذلكَ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (13630) واللفظ له، وابن أبي شيبة في ((المصنف)) (25324)","bab":"فضائل النبي وصفته ودلائل النبوة › شفقته على أمته","dorar":"MztvcNf0","merged":3,"otherRefs":["الأحاديث المختارة 2003 (صحيح)","الأحاديث المختارة 2004 (صحيح)"]},{"id":"س-05099","fp":"788b1a01dd58","stateId":127,"easy":"إذا وصلت المرأة شعرها بشعر غيرها ← فهو زور","cause":"أَيُّما امرأةٍ أَدخَلَتْ في شَعرِها مِن شَعرِ غَيْرِها","result":"فإنَّما تُدخِلُه زُورًا","explicit":true,"ref":"تخريج المسند لشعيب 16927","srcLabel":"أحمد","text":[["أَيُّما امرأةٍ أَدخَلَتْ في شَعرِها مِن شَعرِ غَيْرِها، ",1],["فإنَّما تُدخِلُه زُورًا",2],"."],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (16927) واللفظ له، والطبراني (19/342) (792)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"WhGuGhc9"},{"id":"س-05642","fp":"059a01b9db20","stateId":127,"easy":"إذا أكلت كل ما اشتهيت ← فهو من الإسراف","cause":"أن تأكُلَ كلَّ ما اشتهيْتَ","result":"من الإسرافِ","explicit":true,"ref":"سبل السلام 4/272","srcLabel":"سبل السلام","text":[["من الإسرافِ",2]," ",["أن تأكُلَ كلَّ ما اشتهيْتَ",1]],"grade":"صحيح","muhaddith":"صحيح","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"kIikkz3x"},{"id":"س-06196","fp":"0a4ac9489dff","stateId":127,"easy":"إذا لبست خاتم حديد ← فهو حلية أهل النار","cause":"خاتَمٌ مِن حديدٍ","result":"ما لي أرى عليك حِليةَ أهلِ النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[69],"ref":"صحيح ابن حبان 5488","srcLabel":"أبو داود","text":["جاء رجُلٌ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم وعليه ",["خاتَمٌ مِن حديدٍ",1]," فقال: ( ",["ما لي أرى عليك حِليةَ أهلِ النَّارِ",2]," ) فطرَحه ثمَّ جاء وعليه خاتَمٌ مِن شَبَهٍ فقال: ( ما لي أجِدُ منك ريحَ الأصنامِ ) فقال: يا رسولَ اللهِ مِن أيِّ شيءٍ أتَّخذُه ؟ قال: ( مِن وَرِقٍ ولا تُتمَّه مثقالًا )"],"grade":"صحيح","narrator":"بريدة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (4223)، والترمذي (1785)، والنسائي (5195) باختلاف يسير","bab":"زينة اللباس › لبس الخاتم","dorar":"hYDeVvQS","merged":5,"otherRefs":["صحيح الأدب المفرد 779 (حسن)","عارضة الأحوذي 3/39 (صحيح)","شرح معاني الآثار 4/261 (صحيح)","آداب الزفاف 145 (صحيح)"]},{"id":"س-06197","fp":"dcf7ce40bdd8","stateId":127,"easy":"إذا لبست خاتم صُفر (شَبَه) ← يُجد منك ريح الأصنام","cause":"خاتَمٌ مِن شَبَهٍ","result":"ما لي أجِدُ منك ريحَ الأصنامِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح ابن حبان 5488","srcLabel":"أبو داود","text":["جاء رجُلٌ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم وعليه خاتَمٌ مِن حديدٍ فقال: ( ما لي أرى عليك حِليةَ أهلِ النَّارِ ) فطرَحه ثمَّ جاء وعليه ",["خاتَمٌ مِن شَبَهٍ",1]," فقال: ( ",["ما لي أجِدُ منك ريحَ الأصنامِ",2]," ) فقال: يا رسولَ اللهِ مِن أيِّ شيءٍ أتَّخذُه ؟ قال: ( مِن وَرِقٍ ولا تُتمَّه مثقالًا )"],"grade":"صحيح","narrator":"بريدة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (4223)، والترمذي (1785)، والنسائي (5195) باختلاف يسير","bab":"زينة اللباس › لبس الخاتم","dorar":"hYDeVvQS","merged":2,"otherRefs":["الآداب الشرعية 3/503 (صحيح)"]},{"id":"س-06190","fp":"9805f8e3e5c8","stateId":127,"easy":"إذا لبست الحرير (للرجال) ← تُنكَر عليك (من واقعة)","cause":"عليهِ جبَّةٌ مَكْفوفةٌ بِحريرٍ، أو قالَ: مُزرَّرةٌ بديباجٍ","result":"مُغضبًا وأخذَ مَجامعِ جُبَّتِهِ فجَذبَها بِهِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"نخب الافكار 13/266","srcLabel":"نخب الافكار","text":["أتى رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ أعرابيٌّ، ",["عليهِ جبَّةٌ مَكْفوفةٌ بِحريرٍ، أو قالَ: مُزرَّرةٌ بديباجٍ",1]," - فقامَ إليهِ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ",["مُغضبًا وأخذَ مَجامعِ جُبَّتِهِ فجَذبَها بِهِ",2]," ثمَّ قالَ: ألا أرَى عليكَ ثيابَ مَن لا يعقلُ"],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"زينة اللباس › إباحة الذهب والحرير للنساء دون الرجال","dorar":"FhvlO5OE"},{"id":"س-02955","fp":"133754e9f55e","stateId":127,"easy":"إذا لبست خاتم حديد ← لا يطهّر الله كفاً هو فيه","cause":"خاتَمٌ مِن حَديدٍ","result":"ما طَهَّرَ اللَّه كفًّا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الجامع الصغير 7919","srcLabel":"الطبراني","text":[["ما طَهَّرَ اللَّه كفًّا",2]," فيها ",["خاتَمٌ مِن حَديدٍ",1]],"grade":"حسن","narrator":"مسلم بن عبدالرحمن مولى شميسة بنت نبهان","muhaddith":"حسن","takhrij":"أخرجه الطبراني (19/435) (1054)، وأبو نعيم في ((معرفة الصحابة)) (6045) واللفظ لهما، وأخرجه البزار كما في ((كشف الأستار)) للهيثمي (2993) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"Tfmnjh6R"},{"id":"س-06198","fp":"7c94dbc440c1","stateId":127,"easy":"إذا تختمت بالحديد ← فهو شر من الذهب (للرجال)","cause":"فتَختَّمَ بخاتَمٍ مِن حديدٍ","result":"فقال: ذا شرٌّ منه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 132","srcLabel":"أحمد","text":["إنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ رأَى في يدِ رجُلٍ خاتَمًا مِن ذهبٍ، فقال: أَلْقِ ذا، فألْقاهُ، ",["فتَختَّمَ بخاتَمٍ مِن حديدٍ",1],"، ",["فقال: ذا شرٌّ منه",2],"، فتَختَّمَ بخاتَمٍ مِن فضَّةٍ، فسكَتَ عنه."],"grade":"حسن","narrator":"عمر بن الخطاب","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (132) واللفظ له، والعقيلي في ((الضعفاء الكبير)) (4/192)","bab":"زينة اللباس › لبس الخاتم","dorar":"D3IhKbwn"},{"id":"س-05120","fp":"177c8ca97ca7","stateId":128,"easy":"إذا نظرت أو تكلمت أو لمست الحرام ← أصبت حظك من الزنا","cause":"فالعَيْنُ تَزني وزِناها النَّظَرُ، واللِّسانُ يَزني وزِناهُ الكَلامُ، واليَدانِ تَزنيانِ وزِناها البَطْشُ، والرِّجْلُ تَزني وزِناها المشْيُ، والسَّمْعُ يَزني وزِناهُ الاستماعُ","result":"حظَّهُ منَ الزِّنا","explicit":true,"star":true,"similar":["س-00392"],"ref":"تخريج مشكل الآثار 2713","srcLabel":"متفق عليه","text":["كتَبَ اللهُ على كلِّ عُضوٍ ",["حظَّهُ منَ الزِّنا",2],"؛ ",["فالعَيْنُ تَزني وزِناها النَّظَرُ، واللِّسانُ يَزني وزِناهُ الكَلامُ، واليَدانِ تَزنيانِ وزِناها البَطْشُ، والرِّجْلُ تَزني وزِناها المشْيُ، والسَّمْعُ يَزني وزِناهُ الاستماعُ",1],"، ويُصدِّقُ ذلك الفَرْجُ أو يُكذِّبُهُ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في  ((شرح مشكل الآثار)) (98) واللفظ له, والبخاري (6612)، ومسلم (2657) كلاهما بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"sO0u9GZI","merged":2,"otherRefs":["تخريج المسند لشعيب 8598 (صحيح)"]},{"id":"س-00376","fp":"211bce12dbb3","stateId":128,"easy":"إذا نظرت أو نطقت أو تمنيت الحرام ← أصبت نصيبك من الزنا","cause":"فالعينُ زناها النَّظرُ واللِّسانُ زناه النُّطقُ والقلبُ زناه التَّمنِّي","result":"له نصيبٌ مِن الزِّنا","explicit":true,"star":true,"ref":"تخريج صحيح ابن حبان 4421","srcLabel":"متفق عليه","text":["كلُّ بني آدَمَ ",["له نصيبٌ مِن الزِّنا",2]," أدرَكه ذلك لا محالةَ: ",["فالعينُ زناها النَّظرُ واللِّسانُ زناه النُّطقُ والقلبُ زناه التَّمنِّي",1]," والفَرْجُ يُصدِّقُ ويُكذِّبُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (4421) بلفظه، وأحمد (8215) بلفظ مقارب، والبخاري (6243)، ومسلم (2657)، كلاهما بنحوه.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"FlvQ3nR9"},{"id":"س-00392","fp":"a4c1a9644a46","stateId":128,"easy":"إذا نظرت أو لمست الحرام ← أصبت من الزنا","cause":"فالعينُ زِناؤُها النَّظرُ، واليَدُ زِناؤُها اللَّمسُ","result":"أصابَ منَ الزِّنا","explicit":true,"repOf":"س-05120","ref":"صحيح ابن خزيمة 1/ 149","text":["كلُّ ابنِ آدمَ ",["أصابَ منَ الزِّنا",2]," لا مَحالةَ، ",["فالعينُ زِناؤُها النَّظرُ، واليَدُ زِناؤُها اللَّمسُ",1],"، والنَّفسُ تَهْوَى أو تحدِّثُ، ويصدِّقُهُ أو يُكَذِّبُهُ الفَرجُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (6243)، ومسلم (2657)، وأبو داود (2152) بنحوه.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"yTcHhvt5"},{"id":"س-00423","fp":"f8079e45fc8b","stateId":128,"easy":"إذا نظرت أو بطشت أو مشيت إلى الحرام ← فلك حظك من الزنا","cause":"فزِنا العَينَيْنِ النَّظَرُ، وزِنا اليَدَيْنِ البَطشُ، وزِنا الرِّجلَيْنِ المَشيُ، وزِنا الفَمِ القُبَلُ","result":"له حَظُّه مِن الزِّنا","explicit":true,"star":true,"similar":["س-00445","س-00355"],"ref":"تخريج المسند لشعيب 10920","srcLabel":"متفق عليه","text":["كُلُّ ابنِ آدمَ ",["له حَظُّه مِن الزِّنا",2],"، ",["فزِنا العَينَيْنِ النَّظَرُ، وزِنا اليَدَيْنِ البَطشُ، وزِنا الرِّجلَيْنِ المَشيُ، وزِنا الفَمِ القُبَلُ",1],"، والقَلبُ يَهوى ويتمَنَّى، ويُصَدِّقُ ذلك أو يُكذِّبُه الفَرْجُ. وحلَّقَ عَشَرةً، ثم أدخَلَ إصبَعَهُ السَّبابةَ فيها، شهِدَ على ذلك أبو هُرَيرةَ، لَحمُهُ ودَمُهُ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه من طرق البخاري (6243)، ومسلم (2657)، وأبو داود (2153)، والنسائي في ((السنن الكبرى)) (11544) مطولاً بنحوه، وأحمد (10920) واللفظ له","bab":"آداب عامة › الأخلاق المذمومة","dorar":"6BiWc6jl"},{"id":"س-04922","fp":"635702cbfdf5","stateId":128,"easy":"إذا نظرت إلى الحرام أو تمنيته ← فقد زنت عينك وقلبك","cause":"فزِنَا العينِ النظرُ، وزِنا القلبِ التمَنِّي","result":"العينُ تَزني، والقلبُ يَزني","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 8356","srcLabel":"متفق عليه","text":[["العينُ تَزني، والقلبُ يَزني",2],"؛ ",["فزِنَا العينِ النظرُ، وزِنا القلبِ التمَنِّي",1],"، والفرجُ يُصدِّقُ ما هنالِك أو يُكذِّبُه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6243) بنحوه، ومسلم (2657) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"IBrWuIeN"},{"id":"س-07937","fp":"6af13cfb4a1e","stateId":128,"easy":"إذا نظرت إلى المرأة الأجنبية ← لو فُقئت عينك كان خيراً لك (أثر ابن مسعود)","cause":"ينظرُ إلى المرأةِ","result":"لو انفقَأَتْ عينُك كان خيرًا لك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح الأدب المفرد 412","srcLabel":"البخاري","text":["دخل عبدُ اللهِ بنُ مسعودٍ على مريضٍ يعودُه - ومعه قومٌ ، وفي البيتِ امرأةٌ - فجعل رجلٌ من القومِ ",["ينظرُ إلى المرأةِ",1]," ، فقال له عبدُ اللهِ : ",["لو انفقَأَتْ عينُك كان خيرًا لك",2]],"grade":"صحيح","narrator":"عبدالله بن أبي الهذيل","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (531)، وابن الجوزي في ((ذم الهوى)) (87) واللفظ لهما.","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"5XvLzVpO"},{"id":"س-04840","fp":"dd44a22a7b03","stateId":128,"easy":"إذا مسست امرأة لا تحل لك ← فطعنة مخيط في رأسك خير لك منه","cause":"لَأَنْ يُطعَنَ في رأسِ أحَدِكُمْ بِمَخْيَطٍ من حَدِيدٍ","result":"خَيرٌ له من أنْ يَمسَّ امْرأةً لا تَحِلُّ لَهُ","explicit":true,"ref":"صحيح الجامع 5045","srcLabel":"الطبراني","text":[["لَأَنْ يُطعَنَ في رأسِ أحَدِكُمْ بِمَخْيَطٍ من حَدِيدٍ ",1],["خَيرٌ له من أنْ يَمسَّ امْرأةً لا تَحِلُّ لَهُ",2]],"grade":"صحيح","narrator":"معقل بن يسار","muhaddith":"صحيح","takhrij":"أخرجه الروياني في ((المسند)) (1283) باختلاف يسير، والطبراني (20/211) (486)، والبيهقي كما في ((الترغيب والترهيب)) للمنذري (3/26) واللفظ لهما","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"HSUzXvA2"},{"id":"س-00445","fp":"5112ee4aaf89","stateId":128,"easy":"إذا نظرت أو استمعت أو تكلمت أو بطشت أو مشيت في الحرام ← يُكتب عليك نصيبك من الزنا","cause":"فَالْعَيْنَانِ زِنَاهُما النَّظَرُ، وَالأُذُنَانِ زِنَاهُما الاسْتِمَاعُ، وَاللِّسَانُ زِنَاهُ الكَلَامُ، وَالْيَدُ زِنَاهَا البَطْشُ، وَالرِّجْلُ زِنَاهَا الخُطَا","result":"كُتِبَ علَى ابْنِ آدَمَ نَصِيبُهُ مِنَ الزِّنَا","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-00423","ref":"مجموع الفتاوى 15/395","text":["زِنا العَينينِ النَّظرُ [يعني حديث: ",["كُتِبَ علَى ابْنِ آدَمَ نَصِيبُهُ مِنَ الزِّنَا",2],"، مُدْرِكٌ ذلكَ لا مَحَالَةَ، ",["فَالْعَيْنَانِ زِنَاهُما النَّظَرُ، وَالأُذُنَانِ زِنَاهُما الاسْتِمَاعُ، وَاللِّسَانُ زِنَاهُ الكَلَامُ، وَالْيَدُ زِنَاهَا البَطْشُ، وَالرِّجْلُ زِنَاهَا الخُطَا",1],"، وَالْقَلْبُ يَهْوَى وَيَتَمَنَّى، وَيُصَدِّقُ ذلكَ الفَرْجُ وَيُكَذِّبُهُ.]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الخرائطي في ((اعتلال القلوب)) (285) بلفظه، والبخاري (6612)، ومسلم (2657)، وأبو داود (2152) بنحوه.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"iXHmXulI","merged":4,"otherRefs":["المستدرك على الصحيحين 3798 (صحيح)","تخريج المسند لشعيب 8932 (حسن)","صحيح ابن حبان 4423 (صحيح)"]},{"id":"س-00355","fp":"982067417fb4","stateId":128,"easy":"إذا نظرت إلى الحرام أو نطقت به ← فهو حظك من الزنا يُكتب عليك","cause":"فزِنا العَينَينِ النَّظَرُ، وزِنا اللِّسانِ النُّطقُ","result":"كَتَبَ على ابنِ آدَمَ حَظَّه مِنَ الزِّنا","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-00423","ref":"صحيح مسلم 2657","text":["عن ابنِ عَبَّاسٍ، قال: ما رَأيتُ شيئًا أشبَهَ باللَّمَمِ ممَّا قال أبو هُرَيرةَ: أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم قال: إنَّ اللهَ ",["كَتَبَ على ابنِ آدَمَ حَظَّه مِنَ الزِّنا",2],"، أدرَكَ ذلك لا مَحالةَ؛ ",["فزِنا العَينَينِ النَّظَرُ، وزِنا اللِّسانِ النُّطقُ",1],"، والنَّفسُ تَمَنَّى وتَشتَهي، والفَرجُ يُصَدِّقُ ذلك أو يُكَذِّبُه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6243) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"KwANGJvq","merged":2,"otherRefs":["صحيح الجامع 1797 (صحيح)"]},{"id":"س-00435","fp":"22d4451364b2","stateId":128,"easy":"إذا أطلقت عينك ولسانك ويدك ورجلك في الحرام ← فهو زناها يُكتب عليك","cause":"النَّظرُ ، وزنا اللِّسانِ النُّطقُ ، وزنا اليدِ البَطشُ ، وزنا الرِّجلِ الخُطا","result":"زنا العينِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"الزواجر عن اقتراف الكبائر 2/141","srcLabel":"الزواجر عن اقتراف الكبائر","text":[["زنا العينِ",2]," ",["النَّظرُ ، وزنا اللِّسانِ النُّطقُ ، وزنا اليدِ البَطشُ ، وزنا الرِّجلِ الخُطا",1]," ، والقلبُ يهوَى ويتمنَّى ويُصدِّقُ ذلك الفرْجُ أو يُكذِّبُه"],"grade":"صحيح","muhaddith":"صحيح","bab":"آداب عامة › الأخلاق المذمومة","dorar":"vxxbiaig"},{"id":"س-01134","fp":"ce36b7b8dcfb","stateId":129,"easy":"إذا وضعت شهوتك في الحرام ← عليك وزر","cause":"لو وَضع في الحرامِ","result":"أليس كان عليه وزرٌ","explicit":true,"star":true,"ref":"صحيح الأدب المفرد 167","srcLabel":"متفق عليه","text":["أليس قد جعل اللهُ لكم ما تصدَّقون ؟ إنَّ بكلِّ تسبيحةٍ و تحميدةٍ صدقةٌ وبُضعُ أحدِكم صدقةٌ قيل : في شهوتِه صدقةٌ ؟ قال : ",["لو وَضع في الحرامِ",1]," ، ",["أليس كان عليه وزرٌ",2]," ؟ فكذلك إن وضعَها في الحلالِ كان له أجرٌ"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (227) بلفظه، ومسلم (1006)، وأحمد (21473) كلاهما بلفظ مقارب.","bab":"أدعية وأذكار › فضل الذكر","dorar":"WtHRBfB5"},{"id":"س-04589","fp":"7f8bf858db36","stateId":129,"easy":"إذا زنيت بزوجة جارك ← فهو أشد من الزنا بعشر نسوة","cause":"أن يزنيَ بحليلةِ جارِهِ","result":"لأن يزنيَ الرَّجلُ بعشرِ نسوةٍ أيسرُ عليهِ","explicit":true,"ref":"عمدة التفسير 1/504","srcLabel":"أحمد","text":["قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ لأصحابِهِ : ما تقولونَ في الزِّنا ؟ قالوا : حرمَهُ اللَّهُ ورسولُهُ ، هو حرامٌ إلى يومِ القيامةِ ، فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : ",["لأن يزنيَ الرَّجلُ بعشرِ نسوةٍ أيسرُ عليهِ",2]," مِن ",["أن يزنيَ بحليلةِ جارِهِ",1]," ، قال : ما تقولونَ في السَّرقةِ ؟ قالوا : حرَّمَها اللَّهُ ورسولُهُ ، فهي حرامٌ إلى يومِ القيامةِ ، قالَ : لأن يسرقَ الرَّجلُ من عشرةِ أبياتٍ أيسرُ عليهِ من أن يسرقَ من جارِهِ"],"grade":"صحيح","narrator":"المقداد بن عمرو بن الأسود","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (23854)، والبزار (2115) واللفظ له، والطبراني (20/257) (605)","bab":"حدود › تحريم السرقة","dorar":"Y9OzD5Fl","merged":3,"otherRefs":["صحيح الأدب المفرد 76 (صحيح)","صحيح الجامع 5043 (صحيح)"]},{"id":"س-03279","fp":"fe7f6a75c76a","stateId":129,"easy":"إذا تساهلت في الخلوة حتى وقعت في الزنا ← قد تحبط حسنات سنين طويلة","cause":"فلم يزَلْ يُكلِّمُها وتُكلِّمُه حتَّى غشِيها","result":"فوُزِنت عبادةُ ستِّين سنةً بتلك الزَّنيةِ فرجحت تلك الزَّنيةُ بحسناتِه","explicit":true,"otherNeedIds":[52],"ref":"الترغيب والترهيب 3/262","srcLabel":"ابن حبان","text":["تعبَّد عابدٌ من بني إسرائيلَ فعبد اللهَ في صومعتِه ستِّين عامًا فأُمطِرت الأرضُ فاخضرَّت فأشرف الرَّاهبُ من صومعتِه فقال لو نزلتُ فذكرتُ اللهَ فازددتُ خيرًا فنزل ومعه رغيفٌ أو رغيفان فبينما هو في الأرضِ لقِيتْه امرأةٌ ",["فلم يزَلْ يُكلِّمُها وتُكلِّمُه حتَّى غشِيها",1]," ثمَّ أُغمي عليه فنزل الغديرَ يستحِمُّ فجاء سائلٌ فأومأ إليه أن يأخُذَ الرَّغيفَيْن ثمَّ مات ",["فوُزِنت عبادةُ ستِّين سنةً بتلك الزَّنيةِ فرجحت تلك الزَّنيةُ بحسناتِه",2]," ثمَّ وُضِع الرَّغيفُ أو الرَّغيفان مع حسناتِه فرجَحت حسناتُه فغُفِر له"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن حبان (378).","bab":"استغفار › أسباب المغفرة","dorar":"DtzQp802"},{"id":"س-04880","fp":"d3f3406836e2","stateId":129,"easy":"إذا خرجت المرأة متعطرة لتجد الرجال ريحها ← فهي زانية","cause":"أيُّما امرأةٍ استعطرتْ ثُمَّ خَرَجَتْ ، فمرَّتْ علَى قومٍ ليجِدُوا ريَحها","result":"فهِيَ زانيةٌ","explicit":true,"ref":"الجامع الصغير 2956","srcLabel":"النسائي","text":[["أيُّما امرأةٍ استعطرتْ ثُمَّ خَرَجَتْ ، فمرَّتْ علَى قومٍ ليجِدُوا ريَحها",1]," ",["فهِيَ زانيةٌ",2]," ، وكُلُّ عينٍ زانيةٌ"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح","takhrij":"أخرجه النسائي (5126)، وأحمد (19578)، وابن خزيمة (1681)، والطحاوي في ((شرح مشكل الآثار)) (4553)، وابن حبان (3785) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"mmGWWp6Y"},{"id":"س-05182","fp":"65288981ac96","stateId":129,"easy":"إذا عملت عمل قوم لوط ← فهو أخوف ما يُخاف على الأمة","cause":"عملِ قومِ لوطٍ","result":"إنَّ أخوَفَ ما أخافُ على أمَّتي","explicit":true,"ref":"الترغيب والترهيب 3/270","srcLabel":"الترمذي","text":[["إنَّ أخوَفَ ما أخافُ على أمَّتي",2]," من ",["عملِ قومِ لوطٍ",1]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (1457)، وابن ماجه (2563)، وأحمد (15093) جميعهم بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"rZCw6S6W"},{"id":"س-08454","fp":"e1ceb3be4583","stateId":129,"easy":"إذا اتخذت من الخدم من يمارسن البغاء ← فعليك مثل آثامهن","cause":"مَن اتَّخَذَ مِن الخَدَمِ غَيْرَ ما يَنكِحُ ثُمَّ بَغَيْنَ","result":"فعليه مِثلُ آثامِهنَّ مِن غَيْرِ أن يَنقُصَ مِن آثامِهنَّ شيءٌ","explicit":true,"ref":"الأحكام الوسطى 3/ 177","srcLabel":"البزار","text":[["مَن اتَّخَذَ مِن الخَدَمِ غَيْرَ ما يَنكِحُ ثُمَّ بَغَيْنَ، ",1],["فعليه مِثلُ آثامِهنَّ مِن غَيْرِ أن يَنقُصَ مِن آثامِهنَّ شيءٌ",2],"."],"grade":"صحيح","narrator":"سلمان","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه البزار (2536) واللفظ له","bab":"نفقة › نفقة الرقيق والرفق بهم والإحسان إليهم","dorar":"ROR4w2wv"},{"id":"س-04857","fp":"e7c45f75054b","stateId":129,"easy":"إذا مارست النساء السحاق بينهن ← فهو زنا","cause":"سحاقُ النساءِ بينَهن","result":"زنًا","explicit":true,"ref":"مجمع الزوائد 6/259","srcLabel":"البيهقي","text":[["سحاقُ النساءِ بينَهن",1]," ",["زنًا",2],"."],"grade":"حسن","narrator":"واثلة بن الأسقع الليثي أبو فسيلة","muhaddith":"رجاله ثقات","takhrij":"أخرجه أبو يعلى (7491) واللفظ له، وابن أبي الدنيا في ((ذم الملاهي)) (142)، والبيهقي في ((شعب الإيمان)) (5464)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"9pERKAT5"},{"id":"س-06370","fp":"c4d07a12ccb2","stateId":129,"easy":"إذا عبدت الله دهراً ثم وقعت في الزنا ← قد تحبط عبادتك (من قصة الراهب)","cause":"فنزل إليها فواقَعها ستَّ ليالٍ","result":"فوُضِعت السِّتُّون في كِفَّةٍ ووُضِعت السِّتَّةُ في كِفَّةٍ فرجحت يعني السِّتَّةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[52],"ref":"الترغيب والترهيب 2/67","srcLabel":"البيهقي","text":["عن ابنِ مسعودٍ [ قال ] إنَّ راهبًا عبد اللهَ في صومعتِه ستِّين سنةً فجاءت امرأةٌ فنزلت إلى جنبِه ",["فنزل إليها فواقَعها ستَّ ليالٍ",1]," ثمَّ سُقِط في يدِه فهرب فأتَى مسجدًا فأوَى فيه ثلاثًا لا يطعمُ شيئًا فأُتي برغيفٍ فكسره فأعطَى رجلًا عن يمينِه نصفَه وأعطَى آخرَ عن يسارِه نصفَه فبعث اللهُ إليه ملكَ الموتِ فقبض روحَه ",["فوُضِعت السِّتُّون في كِفَّةٍ ووُضِعت السِّتَّةُ في كِفَّةٍ فرجحت يعني السِّتَّةَ",2]," ثمَّ وُضِع الرَّغيفُ فرجح يعني رجح الرَّغيفُ السِّتَّةَ"],"grade":"صحيح","narrator":"[عبدالله بن هانئ الأودي أبو الزعراء]","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن أبي شيبة (35352)، والبيهقي في ((الشعب)) (3213)، وإسحاق كما في ((المطالب العالية)) (3468) بنحوه.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"uohlwSI5"},{"id":"س-01297","fp":"96fb271078ed","stateId":129,"easy":"إذا أتيت امرأتك في دبرها ← فهي اللوطية الصغرى","cause":"الذي يَأتي امرأتَه في دُبُرِها","result":"هي اللُّوطيَّةُ الصُّغْرى","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"فتح الغفار 1484/3","srcLabel":"فتح الغفار","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم قال في ",["الذي يَأتي امرأتَه في دُبُرِها",1],": ",["هي اللُّوطيَّةُ الصُّغْرى",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"رجاله رجال الصحيح","bab":"نكاح › حسن العشرة بين الأزواج","dorar":"oB47dGpj","merged":4,"otherRefs":["نخب الافكار 10/461 (صحيح)","تخريج زاد المعاد 4/237 (حسن)","حسن الأسوة بما ثبت في النسوة 533 (صحيح)"]},{"id":"س-03061","fp":"741754cc53c7","stateId":129,"easy":"إذا تعطّرت المرأة ومرت بالرجال ليجدوا ريحها ← فهي كذا وكذا (زانية)","cause":"إذا تعطَّرتِ المرأةُ ، فمرَّت على القَومِ ليجِدوا ريحَها","result":"فَهيَ كذا وَكَذا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"الاقتراح في بيان الاصطلاح 126","srcLabel":"أبو داود","text":[["إذا تعطَّرتِ المرأةُ ، فمرَّت على القَومِ ليجِدوا ريحَها",1]," ، ",["فَهيَ كذا وَكَذا",2]," ، قالَ قولًا شديدًا"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4173)، وأحمد (19593)","bab":"إيمان › الوعيد","dorar":"pvmxS2FN","merged":2,"otherRefs":["إتحاف الخيرة المهرة 4/ 14 (صحيح)"]},{"id":"س-03656","fp":"e7a7275ca730","stateId":130,"easy":"إذا تداويت بالخمر ← فليست دواء بل داء","cause":"الخمرِ","result":"إنَّها ليست بدواءٍ ولكنَّها داءٌ","explicit":true,"star":true,"similar":["س-00419"],"ref":"صحيح ابن حبان 1390","srcLabel":"مسلم","text":["أنَّ سويدَ بنَ طارقٍ سأَل رسولَ اللهِ صلَّى اللهُ عليه وسلَّم عن ",["الخمرِ",1]," وقال: إنَّا نصنَعُها فنهاه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم عن ذلك فقال يا رسولَ اللهِ إنَّها دواءٌ فقال صلَّى اللهُ عليه وسلَّم: ( ",["إنَّها ليست بدواءٍ ولكنَّها داءٌ",2]," )"],"grade":"صحيح","narrator":"وائل بن حجر","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الدارمي (2140)  بلفظه، وأخرجه مسلم (1984)، وأبو داود (3873) والترمذي (2046) جميعا باختلاف يسير","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"tGqmCjLf","merged":5,"otherRefs":["صحيح الترمذي 2046 (صحيح)","غاية المرام 65 (صحيح)","تخريج المسند لشعيب 18862 (صحيح)","صحيح الجامع 2436 (صحيح)"]},{"id":"س-00419","fp":"9ca8a03eafea","stateId":130,"easy":"إذا تداويت بالخمر ← فليست دواء، إنها داء","cause":"نصنَعُ الخمرَ فنهاه عنها فقال : إنَّما نتداوى بها","result":"ليسَتْ بدواءٍ إنَّها داءٌ","explicit":true,"repOf":"س-03656","ref":"تخريج صحيح ابن حبان 6065","text":["أنَّهم أتَوُا النَّبيَّ صلَّى اللهُ عليه وسلَّم فقام إليه رجُلٌ مِن خَثْعَمٍ يُقالُ له : سُويدُ بنُ طارقٍ فقال : إنَّا ",["نصنَعُ الخمرَ فنهاه عنها فقال : إنَّما نتداوى بها",1]," فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ( ",["ليسَتْ بدواءٍ إنَّها داءٌ",2]," )"],"grade":"صحيح","narrator":"وائل","muhaddith":"إسناده حسن على شرط مسلم","takhrij":"أخرجه ابن حبان (6065) واللفظ له، وأحمد (18859)، وعبد الرزاق (17100) باختلاف يسير.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"MLLyjHdH"},{"id":"س-05062","fp":"2652ab8bdb0e","stateId":130,"easy":"إذا سكرت ← فهو من الكبائر","cause":"السُّكْرُ","result":"منَ الكبائرِ","explicit":true,"star":true,"ref":"إتحاف الخيرة المهرة 4/ 378","srcLabel":"البخاري","text":["سمِعتُ ابنَ عباسٍ يقولُ : ",["السُّكْرُ ",1],["منَ الكبائرِ",2]],"grade":"حسن","narrator":"واصل بن عبدالرحمن","muhaddith":"إسناده رجاله ثقات","takhrij":"أخرجه مسدد كما في ((المطالب العالية)) (1822)، وابن أبي شيبة (24243)، والبخاري في ((التاريخ الكبير)) (8/ 171) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"lxBRBtnq"},{"id":"س-07714","fp":"7201f8786e5e","stateId":130,"easy":"إذا شربت حتى ثملت ← تقع الضغائن بينك وبين إخوانك","cause":"شَرِبوا حتَّى ثَمِلوا","result":"فوَقَعَتْ في قُلوبِهم الضَّغائِنُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[44],"ref":"الأحاديث المختارة 10 / 341","srcLabel":"متفق عليه","text":["عَنِ ابْنِ عَبَّاسٍ قَالَ «نَزَلَ تَحْريمُ الخَمْرِ في قَبيلتَينِ مِن الأنْصارِ ",["شَرِبوا حتَّى ثَمِلوا",1],"، عَبَثَ بعضُهم ببعضٍ، فلمَّا صَحَوا جَعَلَ الرَّجُلُ يَرَى الأثَرَ بوَجْهِه وبرَأسِه وبلِحْيتِه، ويقولُ: فَعَلَ بي هذا أَخي فُلانٌ، فوَاللهِ لو كانَ بي رَؤوفًا رَحيمًا ما فَعَلَ هذا بي، قالَ: وكانوا إخْوةً ليس في قُلوبِهم ضَغائِنُ، ",["فوَقَعَتْ في قُلوبِهم الضَّغائِنُ",2],"؛ فأَنزَلَ اللهُ عَزَّ وجَلَّ: {إِنَّمَا الْخَمْرُ والْمَيْسِرُ وَالْأَنْصَابُ وَالْأَزْلَامُ رِجْسٌ مِنْ عَمَلِ الشَّيْطَانِ فَاجْتَنِبُوهُ لَعَلَّكُمْ تُفْلِحُونَ * إِنَّمَا يُرِيدُ الشَّيْطَانَ أَنْ يُوقِعَ بَيْنَكُمُ الْعَدَاوَةَ وَالْبَغْضَاءَ فِي الْخَمْرِ وَالْمَيْسِرِ وَيَصُدَّكُمْ عَنْ ذِكْرِ اللَّهِ وَعَنِ الصَّلَاةِ فَهَلْ أَنْتُمْ مُنْتَهُونَ}، فقالَ ناسٌ مِن المُتَكَلِّفينَ: هي رِجْسٌ، وهي في بَطْنِ فُلانٍ؛ قُتِلَ يَوْمَ بَدْرٍ، وفُلانٍ قُتِلَ يَوْمَ أُحُدٍ؛ فأَنزَلَ اللهُ عَزَّ وجَلَّ: {لَيْسَ عَلَى الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ جُنَاحٌ فِيمَا طَعِمُوا}»..الآية"],"grade":"صحيح","narrator":"سعيد بن جبير","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"قرآن › أسباب النزول","dorar":"ve2t1jpY"},{"id":"س-02566","fp":"3014a9bc1059","stateId":130,"easy":"إذا شربت الخمر ← فهي أم الخبائث","cause":"اجتنِبوا الخمرَ","result":"فإنها أمُّ الخبائثِ","explicit":true,"similar":["س-04065","س-04893","س-05150"],"ref":"صحيح النسائي 5683","srcLabel":"النسائي","text":["قال عثمان رضي الله عنه: ",["اجتنِبوا الخمرَ ، ",1],["فإنها أمُّ الخبائثِ",2]," ، فإنه كان رجلٌ ممنْ خلا قبلَكم ، يتعبَّدُ ويعتزلُ الناسَ . . . . . . . فذكر مثلَهُ . قال : فاجتنِبوا الخمرَ ، فإنهُ واللهِ لا يجتمعُ والإيمانُ أبدًا ، إلَّا يوشكُ أحدُهما أنْ يخرجَ صاحبَهُ ."],"grade":"صحيح","narrator":"عبد الرحمن بن الحارث","muhaddith":"صحيح","takhrij":"أخرجه النسائي (5667) بهذا اللفظ وأخرجه عبد الرزاق (17060) والبيهقي (17416) مطولا.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"x82KXZZv","merged":2,"otherRefs":["الأحاديث المختارة 338 (صحيح)"]},{"id":"س-04065","fp":"8989d77ba4a6","stateId":130,"easy":"إذا شربت الخمر ← فهي جماع الإثم","cause":"والخَمْرُ","result":"جِماعُ الإثْمِ","explicit":true,"repOf":"س-02566","ref":"الأحكام الوسطى 4/ 165","text":["تَلَقَّفْتُ الخُطْبةَ مِن في رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ بتَبوكَ، سَمِعْتُه يقولُ: \"",["والخَمْرُ",1]," ",["جِماعُ الإثْمِ",2],"\"."],"grade":"صحيح","narrator":"زيد بن خالد","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه الدارقطني (4611)، واللفظ له وأبو ذر الهروي في ((فوائده)) (5) مطولا","bab":"جمعة › خطبة النبي صلى الله عليه وسلم","dorar":"3vLLyyfp"},{"id":"س-04823","fp":"e71f224a8e8d","stateId":130,"easy":"إذا شربت الخمر ← فقد جُعلت عِدلاً للشرك","cause":"حرِّمتِ الخمرُ","result":"وجعِلَت عدلا للشِّركِ","explicit":true,"ref":"قتل مدمني الخمر 69","srcLabel":"الحاكم","text":["لمَّا ",["حرِّمتِ الخمرُ",1]," مشَى أصحابُ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ بعضُهم إلى بعضٍ وقالوا حُرِّمتِ الخمرُ ",["وجعِلَت عدلا للشِّركِ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني (12399) (12/ 37)، والحاكم (7227)، وابن عبد البر في ((التمهيد)) (1/ 247)، والضياء المقدسي في ((الأحاديث المختارة)) (192) واللفظ لهم جميعا.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"9d4IXAA1"},{"id":"س-04893","fp":"39eff638faae","stateId":130,"easy":"إذا شربت الخمر ← فهي أم الفواحش وأكبر الكبائر","cause":"الخمرُ","result":"أمُّ الفواحشِ، وأكبرُ الكبائرِ","explicit":true,"repOf":"س-02566","ref":"الجامع الصغير 4125","text":[["الخمرُ",1]," ",["أمُّ الفواحشِ،  وأكبرُ الكبائرِ",2],"،  منْ شربَها وقعَ على أمِّهِ،  و خالتِهِ،  و عمتِهِ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الدارقطني في ((السنن)) (4612 )، والطبراني في ((المعجم الكبير )) (11/ 164) (11372)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"AmNmorhK"},{"id":"س-05150","fp":"d9400fa654f0","stateId":130,"easy":"إذا شربت الخمر ← فهي مفتاح كل شر","cause":"اجْتَنِبوا الخمرَ","result":"فإنَّها مِفتاحُ كُلِّ شَرٍّ","explicit":true,"repOf":"س-02566","ref":"المستدرك على الصحيحين 7436","text":[["اجْتَنِبوا الخمرَ؛ ",1],["فإنَّها مِفتاحُ كُلِّ شَرٍّ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (5199) واللفظ له، وابن رشيد الفهري في ((ملء العيبة)) (ص: 291) مطولا","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"q6dUqIlP"},{"id":"س-02573","fp":"608d9f006f94","stateId":130,"easy":"إذا شربت الخمر ← تقودك إلى الزنا وقتل النفس (أم الخبائث)","cause":"اسقيني كأسًا مِن هذا الخمرِ","result":"فلم يزَلْ حتَّى وقَع عليها وقتَل النَّفسَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح ابن حبان 5348","srcLabel":"النسائي","text":["اجتَنِبوا أمَّ الخبائثِ فإنَّه كان رجُلٌ ممَّن قبْلَكم يتعبَّدُ ويعتزلُ النَّاسَ فعلِقتْه امرأةٌ فأرسَلتْ إليه خادمًا فقالت: إنَّا ندعوك لشَهادةٍ فدخَل فطفِقتْ كلَّما يدخُلُ بابًا أغلَقتْه دونَه حتَّى أفضى إلى امرأةٍ وضيئةٍ جالسةٍ وعندَها غلامٌ وباطيَةٌ فيها خمرٌ فقالت: إنَّا لم نَدْعُك لشَهادةٍ ولكِنْ دعَوْتُك لتقتُلَ هذا الغلامَ أو تقَعَ عليَّ أو تشرَبَ كأسًا مِن هذا الخمرِ فإنْ أبَيْتَ صِحْتُ بك وفضَحْتُك قال: فلمَّا رأى أنَّه لا بدَّ له مِن ذلك قال: ",["اسقيني كأسًا مِن هذا الخمرِ",1]," فسقَتْه كأسًا مِن الخمرِ فقال: زيديني ",["فلم يزَلْ حتَّى وقَع عليها وقتَل النَّفسَ",2]," فاجتَنِبوا الخمرَ فإنَّه واللهِ لا يجتمِعُ الإيمانُ وإدمانُ الخمرِ في صدرِ رجُلٍ أبدًا لَيوشِكَنَّ أحدُهما يُخرِجُ صاحبَه"],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه النسائي (5666)، والبيهقي في ((شعب الإيمان)) (5197) كلاهما باختلاف يسير، وابن أبي الدنيا في ((ذم المسكر)) (1) بنحوه.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"NHaSz0RP"},{"id":"س-05058","fp":"a0367ae0e9f5","stateId":130,"easy":"إذا شربت الخمر ← فإثمها عظيم كعبادة غير الله (أثر أبي موسى)","cause":"شربتُ الخمرَ","result":"أو عبدتُ هذه الساريةَ من دون اللهِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[22],"ref":"صحيح النسائي 5679","srcLabel":"النسائي","text":["عن [أبي موسى رضي الله عنه] أنه كان يقولُ : ما أبالي : ",["شربتُ الخمرَ",1]," ",["أو عبدتُ هذه الساريةَ من دون اللهِ",2]," عزَّ وجلَّ !"],"grade":"صحيح","narrator":"أبو بردة بن أبي موسى الأشعري","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (5663)، والدولابي في ((الكنى والأسماء)) (684)، وأبو نعيم في ((تاريخ أصبهان)) (1/ 196) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"zx6YV8mY"},{"id":"س-05177","fp":"71d871fe36f9","stateId":130,"easy":"إذا شربت الخمر ← تُسمّى كافراً","cause":"شاربَ الخمرِ","result":"يُسَمَّى كافرًا","explicit":true,"otherNeedIds":[22],"ref":"فتح الباري لابن رجب 1/128","srcLabel":"فتح الباري لابن رجب","text":["أنَّ ",["شاربَ الخمرِ",1]," ",["يُسَمَّى كافرًا",2]],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"قد روي عنه من وجوه كثيرة، وبعضها إسناده حسن","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"QWCehYRw"},{"id":"س-06652","fp":"deef52e79341","stateId":131,"easy":"إذا أخّرت صلاة حتى دخل وقت التي بعدها (وأنت مستيقظ) ← فذلك هو التفريط","cause":"أن تُؤَخِّرَ صَلاةً حتَّى يَدخُلَ وقتُ صَلاةٍ أُخرى","result":"إنَّما التَّفريطُ في اليَقَظةِ","explicit":true,"star":true,"ref":"فيض القدير 5/ 376","srcLabel":"مسلم","text":["ليس في النَّومِ تفريطٌ، ",["إنَّما التَّفريطُ في اليَقَظةِ",2]," ",["أن تُؤَخِّرَ صَلاةً حتَّى يَدخُلَ وقتُ صَلاةٍ أُخرى",1]],"grade":"صحيح","narrator":"أبو قتادة","muhaddith":"إسناده على شرط مسلم","takhrij":"أخرجه أبو داود (441)، والترمذي (177)، والنسائي (616)، وابن ماجه (698) واللفظ لهم.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"weoZRoEl","merged":3,"otherRefs":["العواصم من القواصم 267 (صحيح)","الأوسط لابن المنذر 3/21 (صحيح)"]},{"id":"س-04379","fp":"1deb7905d0ce","stateId":131,"easy":"إذا جمعت بين الصلاتين بلا عذر أو فررت من الزحف أو نهبت ← فهي من الكبائر","cause":"جَمعٌ بين الصَّلاتيْنِ يَعني بغيرِ عُذرٍ والفِرارُ من الزَّحفِ والنُّهْبَةُ","result":"من الكَبائرِ","explicit":true,"star":true,"similar":["س-04896"],"ref":"تفسير القرآن العظيم 2/242","srcLabel":"البيهقي","text":["قُرِئَ علينا كتابُ عُمرَ ",["من الكَبائرِ",2]," ",["جَمعٌ بين الصَّلاتيْنِ يَعني بغيرِ عُذرٍ والفِرارُ من الزَّحفِ والنُّهْبَةُ",1]],"grade":"صحيح","narrator":"أبو قتادة العدوي","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي حاتم (5208، 5211) بلفظه مفرقًا في موضعين، والبيهقي (5629) بنحوه.","bab":"جهاد › التولي والفرار من الزحف","dorar":"u6mWA5zL","merged":2,"otherRefs":["فتاوى صديق خان 507 (صحيح)"]},{"id":"س-07131","fp":"796fa594b73a","stateId":131,"easy":"إذا سرقت من صلاتك (لم تتم ركوعها وسجودها) ← فأنت أسوأ الناس سرقة","cause":"سرِقةً الَّذي يَسرِقُ مِن صَلاتِه","result":"أسوأُ النَّاسِ","explicit":true,"otherNeedIds":[52],"ref":"صحيح الترغيب 524","srcLabel":"أحمد","text":[["أسوأُ النَّاسِ",2],[" سرِقةً الَّذي يَسرِقُ مِن صَلاتِه ",1],". قالوا : يا رَسولَ اللهِ كيفَ يَسرِقُ من صلاتِه ؟ قال : لا يُتِمُّ رُكوعَها و لا سُجودَها ( أو قال : لا يُقِيمُ صُلْبَه في الرُّكوعِ و السُّجودِ"],"grade":"صحيح","narrator":"أبو قتادة الحارث بن ربعي","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (22695) واللفظ له، والدارمي (1328) باختلاف يسير","bab":"علم › حسن السؤال ونصح العالم","dorar":"Xk5oK5PI","merged":2,"otherRefs":["الترغيب والترهيب 1/243 (حسن)"]},{"id":"س-01539","fp":"6759b2805bda","stateId":131,"easy":"إذا سمعت «حيّ على الفلاح» فلم تجب ← فقد تركت سنة محمد ﷺ","cause":"من سمعَ حيِّ على الفلاحِ فلم يجب","result":"فقد تركَ سنَّةَ محمَّدٍ","explicit":true,"ref":"مجمع الزوائد 2/46","srcLabel":"الطبراني","text":["عنِ ابنِ عبَّاسٍ قالَ ",["من سمعَ حيِّ على الفلاحِ فلم يجب",1]," ",["فقد تركَ سنَّةَ محمَّدٍ",2]," صلَّى اللهُ عليهِ وسلَّم"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (7990)","bab":"أذان › من سمع النداء لزمته الإجابة","dorar":"YSnjYPfV"},{"id":"س-04896","fp":"7d9b33a57b22","stateId":131,"easy":"إذا جمعت بين الصلاتين بلا عذر ← أتيت باباً من أبواب الكبائر","cause":"منْ جَمَعَ بينَ الصلاتَيْنِ منْ غَيْرِ عُذْرٍ","result":"فقدْ أَتَى بابًا منْ أبوابِ الكبائِرِ","explicit":true,"repOf":"س-04379","ref":"الجامع الصغير 8599","text":[["منْ جَمَعَ بينَ الصلاتَيْنِ منْ غَيْرِ عُذْرٍ،  ",1],["فقدْ أَتَى بابًا منْ أبوابِ الكبائِرِ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (188)، والحاكم (1020)، واللفظ لهما، والطبراني (11540) (11/316)، باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"1bj44zt0"},{"id":"س-07212","fp":"45b4afa5de2e","stateId":131,"easy":"إذا صليت وأنت مشبّك يديك ← فهي صلاة المغضوب عليهم","cause":"يصلِّي وَهوَ مشبِّكٌ يدَيهِ","result":"تلكَ صلاةُ المغضوبِ عليهم","explicit":true,"ref":"صحيح أبي داود 993","srcLabel":"أبو داود","text":["سألتُ نافعًا عنِ الرَّجلِ ",["يصلِّي وَهوَ مشبِّكٌ يدَيهِ",1]," قالَ قالَ ابنُ عمرَ ",["تلكَ صلاةُ المغضوبِ عليهم",2]],"grade":"صحيح","narrator":"نافع مولى ابن عمر","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (993)، والبيهقي (3716)","bab":"علم › حسن السؤال ونصح العالم","dorar":"Ni4K8KdX"},{"id":"س-01422","fp":"38500fecb259","stateId":131,"easy":"إذا زدت في الوضوء على ثلاث أو نقصت ← فقد أسأت وظلمت","cause":"فمَن زادَ على هذا أو نَقَصَ","result":"فقدْ أساءَ وظَلَمَ\"، أو \"ظَلَمَ وأساءَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"الأحكام الوسطى 1/ 182","srcLabel":"الأحكام الوسطى","text":["أنَّ رَجُلًا أتى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فقالَ: يا رَسولَ اللهِ كيف الطُّهورُ؟ فدَعا بماءٍ في إناءٍ، فغَسَلَ كَفَّيه ثَلاثًا، ثُمَّ غَسَلَ وَجْهَه ثَلاثًا، ثُمَّ غَسَلَ ذِراعَيه ثَلاثًا، ثُمَّ مَسَحَ برأسِه وأَدخَلَ إصْبَعَيه السَّبَّاحَتَينِ في أُذُنيه، ومَسَحَ بإبْهامَيه ظاهِرَ أُذُنَيه، وبالسَّبَّاحَتَينِ باطِنَ أُذُنَيه، ثُمَّ غَسَلَ رِجْلَيه ثَلاثًا ثَلاثًا، ثُمَّ قالَ: \"هكذا الوُضوءُ، ",["فمَن زادَ على هذا أو نَقَصَ",1]," ",["فقدْ أساءَ وظَلَمَ\"، أو \"ظَلَمَ وأساءَ",2],"\"، هكذا قالَ: \"فمَن زادَ على هذا أو نَقَصَ\"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","bab":"وضوء › صفة الوضوء","dorar":"BxRocuBK","merged":7,"otherRefs":["صحيح ابن خزيمة 1/ 285 (صحيح)","نيل الأوطار 1/209 (صحيح)","إصلاح المساجد 211 (صحيح)","الإمام في معرفة أحاديث الأحكام 2/46 (صحيح)","التلخيص الحبير 1/121 (صحيح)","فتاوى نور على الدرب لابن باز 5/46 (صحيح)"]},{"id":"س-01326","fp":"b1bb9ae8429f","stateId":132,"easy":"إذا أفشيت سر زوجتك ← فهي من أعظم الخيانة عند الله","cause":"الرَّجُلَ يُفضي إلى امرَأتِه وتُفضي إليه، ثُمَّ يَنشُرُ سِرَّها","result":"إنَّ مِن أعظَمِ الأمانةِ عِندَ اللهِ يَومَ القيامةِ","explicit":true,"star":true,"ref":"صحيح مسلم 1437","srcLabel":"متفق عليه","text":[["إنَّ مِن أعظَمِ الأمانةِ عِندَ اللهِ يَومَ القيامةِ",2]," ",["الرَّجُلَ يُفضي إلى امرَأتِه وتُفضي إليه، ثُمَّ يَنشُرُ سِرَّها",1],". وقال ابنُ نُمَيرٍ: [وفي روايةٍ]: إنَّ أعظَمَ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"نكاح › عشرة النساء","dorar":"Y06GcViI"},{"id":"ق-0086","fp":"8a2a547227cd","stateId":132,"easy":"إمساك المطلقة ضراراً للاعتداء ← ظلم النفس","cause":"إمساك المطلقة ضراراً للاعتداء","result":"ظلم النفس","explicit":true,"star":true,"ref":"سورة البقرة: 231","srcLabel":"القرآن الكريم","quran":{"s":2,"from":231,"to":231,"text":"وَإِذَا طَلَّقْتُمُ النِّسَاءَ فَبَلَغْنَ أَجَلَهُنَّ فَأَمْسِكُوهُنَّ بِمَعْرُوفٍ أَوْ سَرِّحُوهُنَّ بِمَعْرُوفٍ وَلَا تُمْسِكُوهُنَّ ضِرَارًا لِتَعْتَدُوا وَمَنْ يَفْعَلْ ذَلِكَ فَقَدْ ظَلَمَ نَفْسَهُ وَلَا تَتَّخِذُوا آيَاتِ اللَّهِ هُزُوًا وَاذْكُرُوا نِعْمَتَ اللَّهِ عَلَيْكُمْ وَمَا أَنْزَلَ عَلَيْكُمْ مِنَ الْكِتَابِ وَالْحِكْمَةِ يَعِظُكُمْ بِهِ وَاتَّقُوا اللَّهَ وَاعْلَمُوا أَنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ (231)","hl":[[114,202,1]]}},{"id":"س-03906","fp":"19b264265205","stateId":132,"easy":"إذا طلّقت امرأتك فوق الثلاث عبثاً ← عصيت ربك وبانت منك ولم تتق الله فيجعل لك مخرجاً","cause":"طَلَّقَ امْرَأتَه مِئةً","result":"عَصَيْتَ رَبَّك وبانَتْ مِنك امْرَأتُك فلم تَتَّقِ اللهَ فيَجعَلَ لك مَخرَجًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[44],"ref":"الأحاديث المختارة 13 / 74","srcLabel":"متفق عليه","text":["«أنَّ رَجُلًا سَألَ ابنَ عبَّاسٍ فقالَ: إنَّه ",["طَلَّقَ امْرَأتَه مِئةً",1],"، فقالَ: ",["عَصَيْتَ رَبَّك وبانَتْ مِنك امْرَأتُك فلم تَتَّقِ اللهَ فيَجعَلَ لك مَخرَجًا",2]," ويَرْزُقَك مِن حيثُ لا تَحْتَسِبُ، وقَرَأَ: (يَا أَيُّهَا النَّبِيُّ إِذَا طَلَّقْتُمُ النِّسَاءَ فَطَلِّقُوهُنَّ فِي عِدَّتِهِنَّ)»."],"grade":"صحيح","narrator":"مجاهد","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"تفسير آيات › سورة الطلاق","dorar":"Gt1TKd16","merged":2,"otherRefs":["نخب الافكار 11/58 (صحيح)"]},{"id":"س-07231","fp":"474dca4c0410","stateId":132,"easy":"إذا طلّقت ثلاثاً ← عصيت ربك وحرمت عليك امرأتك ولم تتق الله فيجعل لك مخرجاً","cause":"طَلَّقْتُ امْرَأتي ثَلاثًا","result":"عَصَيْتَ رَبَّك، وحُرِّمَتْ عليك امْرَأتُك، ولم تَتَّقِ اللهَ، فيَجعَلَ لك مَخرَجًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-03904","س-05136"],"otherNeedIds":[44],"ref":"الأحاديث المختارة 13 / 73","srcLabel":"متفق عليه","text":["«سألَ ابنَ عبَّاسٍ يَوْمًا رَجُلٌ وأنا عِنْدَه، فقالَ: يا أبا عبَّاسٍ! إنِّي ",["طَلَّقْتُ امْرَأتي ثَلاثًا",1],"، فقالَ ابنُ عبَّاسٍ: ",["عَصَيْتَ رَبَّك، وحُرِّمَتْ عليك امْرَأتُك، ولم تَتَّقِ اللهَ، فيَجعَلَ لك مَخرَجًا",2],"، يُطلِّقُ أحَدُكم ثُمَّ يقولُ: يا أبا عبَّاسٍ! قالَ اللهُ: (يَا أَيُّهَا النَّبِيُّ إِذَا طَلَّقْتُمُ النِّسَاءَ فَطَلِّقُوهُنَّ فِي قُبُلِ عِدَّتِهِنَّ)، وهكذا كانَ ابنُ عبَّاسٍ يَقرَأُ هذا الحَرْفَ»."],"grade":"صحيح","narrator":"مجاهد بن جبر المكي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"علم › حسن السؤال ونصح العالم","dorar":"wnhVF1Bp","merged":2,"otherRefs":["جامع العلوم والحكم 1/375 (صحيح)"]},{"id":"س-03904","fp":"7c071373c791","stateId":132,"easy":"إذا طلّقت امرأتك ثلاثاً جملة ← حرمت عليك وعصيت الله","cause":"وإن كُنتَ طَلَّقتَها ثَلاثًا","result":"فقد حَرُمَت عليكَ حتَّى تَنكِحَ زَوجًا غَيرَكَ، وعَصَيتَ اللَّهَ فيما أمَرَكَ مِن طَلاقِ امرَأتِكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-07231","otherNeedIds":[44],"ref":"صحيح مسلم 1471","text":["أنَّه طَلَّقَ امرَأتَه وهي حائِضٌ في عَهدِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فسَألَ عُمَرُ بنُ الخَطَّابِ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم عن ذلك، فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: مُرْه فليُراجِعْها، ثُمَّ ليَترُكْها حتَّى تَطْهرَ، ثُمَّ تَحيضَ، ثُمَّ تَطْهرَ، ثُمَّ إن شاءَ أمسَكَ بَعدُ، وإن شاءَ طَلَّقَ قَبلَ أن يَمَسَّ، فتلك العِدَّةُ التي أمَرَ اللهُ عَزَّ وجَلَّ أن يُطَلَّقَ لَها النِّساءُ. [وفي روايةٍ]: أنَّه طَلَّقَ امرَأةً له وهي حائِضٌ تَطليقةً واحِدةً، فأمَرَه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم أن يُراجِعَها، ثُمَّ يُمسِكَها حتَّى تَطْهرَ، ثُمَّ تَحيضَ عِندَه حَيضةً أُخرى، ثُمَّ يُمهِلَها حتَّى تَطْهرَ مِن حَيضَتِها، فإن أرادَ أن يُطَلِّقَها فليُطَلِّقها حينَ تَطْهرُ مِن قَبلِ أن يُجامِعَها، فتلك العِدَّةُ التي أمَرَ اللهُ أن يُطَلَّقَ لَها النِّساءُ. [وفي روايةٍ]: وكان عبدُ اللهِ إذا سُئِلَ عن ذلك، قال لأحَدِهم: أمَّا أنتَ طَلَّقتَ امرَأتَكَ مَرَّةً أو مَرَّتَينِ؛ فإنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم أمَرَني بهذا، ",["وإن كُنتَ طَلَّقتَها ثَلاثًا",1]," ",["فقد حَرُمَت عليكَ حتَّى تَنكِحَ زَوجًا غَيرَكَ، وعَصَيتَ اللَّهَ فيما أمَرَكَ مِن طَلاقِ امرَأتِكَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5251) باختلاف يسير","bab":"تفسير آيات › سورة الطلاق","dorar":"AU0JdwPI"},{"id":"س-01353","fp":"feb8495ac6e6","stateId":132,"easy":"إذا كثرت شكوى النساء من الرجل ← فليس أولئك من خياركم","cause":"كلُّ امرأةٍ تشتَكي زوجَها","result":"فلا تجدونَ أولئِكَ خيارَكم","explicit":true,"ref":"صحيح ابن ماجه 1628","srcLabel":"أبو داود","text":["لا تضربُنَّ إماءَ اللَّه فجاءَ عمرُ إلى النَّبيِّ صلَّى اللَّهُ عليْهِ وسلَّمَ فقالَ يا رسولَ اللَّهِ قد ذَئرَ النِّساءُ على أزواجِهنَّ فأمر بضربِهنَّ فَضُرِبنَ فطافَ بآلِ محمَّدٍ صلَّى اللَّهُ عليْهِ وسلَّمَ طائفُ نساءٍ كثيرٍ فلمَّا أصبحَ قالَ لقد طافَ اللَّيلةَ بآلِ محمَّدٍ سبعونَ امرأةً ",["كلُّ امرأةٍ تشتَكي زوجَها",1]," ",["فلا تجدونَ أولئِكَ خيارَكم",2]],"grade":"صحيح","narrator":"إياس بن عبدالله بن أبي ذباب","muhaddith":"حسن صحيح","takhrij":"أخرجه ابن ماجة (1985) واللفظ له، وأبو داود (2146)، والدارمي (2265) باختلاف يسير.","bab":"نكاح › عشرة النساء","dorar":"UvbEtoDo","merged":2,"otherRefs":["صحيح الجامع 5137 (صحيح)"]},{"id":"س-04850","fp":"847d8fb3e392","stateId":132,"easy":"إذا عزلت عن زوجتك ← فهو الوأد الخفي","cause":"العَزلِ","result":"ذلك الوأدُ الخَفيُّ","explicit":true,"ref":"صحيح مسلم 1442","srcLabel":"أبو داود","text":["حَضَرتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم في أُناسٍ وهو يقولُ: لقد هَمَمتُ أن أنهى عَنِ الغيلةِ، فنَظَرتُ في الرُّومِ وفارِسَ، فإذا هُم يُغيلونَ أولادَهم، فلا يَضُرُّ أولادَهم ذلك شيئًا. ثُمَّ سَألوه عَنِ ",["العَزلِ",1],"، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["ذلك الوأدُ الخَفيُّ",2],"."],"grade":"صحيح","narrator":"جذامة الأسدية بنت وهب أخت عكاشة","muhaddith":"[صحيح]","takhrij":"أخرجه أبو نعيم في ((المستخرج)) (3373) واللفظ له، وأبو داود (3882)، والترمذي (2077)، والنسائي (3326) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"vb39Yklb"},{"id":"س-05136","fp":"68714b1bc18f","stateId":132,"easy":"إذا طلّقت امرأتك ثلاثاً دفعة ← فقد عصيت ربك","cause":"مَن طلَّقَ امرأتَه ثلاثًا","result":"وعَصى ربَّه","explicit":true,"repOf":"س-07231","ref":"تخريج زاد المعاد 5/211","text":["عنِ ابنِ عُمَرَ قال: ",["مَن طلَّقَ امرأتَه ثلاثًا",1],"، طُلِّقَت، ",["وعَصى ربَّه",2],"."],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"2RcT4aiC"},{"id":"س-03628","fp":"5a18e8b3bc70","stateId":132,"easy":"إذا ضربت زوجتك ← فلست من خياركم","cause":"كُلُّهُنَّ يَشْتكينَ الضَّربَ","result":"لا تَجِدونَ أُولئك خِيارَكُم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-01344"],"ref":"تخريج مشكل الآثار 6/ 345","srcLabel":"الطحاوي","text":["لا تَضْرِبوا إماءَ اللهِ، قال: فذَئِرَ النِّساءُ، وساءتْ أخْلاقُهُنَّ على أزْواجِهِنَّ، فقال عُمَرُ بنُ الخطَّابِ: ذَئِرَ النِّساءُ، وساءتْ أخْلاقُهُنَّ على أزْواجِهِنَّ منذُ نَهَيتَ عن ضَربِهِنَّ، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: فاضْرِبوا، فضَرَبَ الناسُ نِساءَهُم تلك اللَّيلةَ، فأتَى نِساءٌ كَثيرٌ يَشْتكينَ الضَّربَ، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ حين أصبَحَ: لقدْ طافَ بآلِ مُحمَّدٍ اللَّيلةَ سَبْعونَ امْرأةً ",["كُلُّهُنَّ يَشْتكينَ الضَّربَ",1],"، وايْمُ اللهِ، ",["لا تَجِدونَ أُولئك خِيارَكُم",2],"!"],"grade":"صحيح","narrator":"إياس بن أبي ذباب","muhaddith":"إسناده صحيح","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"5mMwvd4J","merged":3,"otherRefs":["هداية الرواة 3197 (صحيح)","المستدرك على الصحيحين 2812 (صحيح)"]},{"id":"س-05139","fp":"c281c5c49269","stateId":132,"easy":"إذا طلّقت فوق الثلاث ← فالزائد وزر عليك واتخذت آيات الله هزواً","cause":"طلَّقْتُ امْرَأتي ألفًا","result":"وبَقيَّتُها عليك وِزرٌ، اتخَذْتَ آياتِ اللهِ هُزُوًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج زاد المعاد 5/236","srcLabel":"عبد الرزاق","text":["قال رجُلٌ لابنِ عبَّاسٍ: ",["طلَّقْتُ امْرَأتي ألفًا",1],"، فقال له ابنُ عبَّاسٍ: ثلاثٌ تُحرِّمُها عليكَ، ",["وبَقيَّتُها عليك وِزرٌ، اتخَذْتَ آياتِ اللهِ هُزُوًا",2],"."],"grade":"صحيح","narrator":"سعيد بن جبير","muhaddith":"إسناده صحيح","takhrij":"أخرجه عبد الرزاق (11353) واللفظ له، وابن أبي شيبة (18103)، وابن المنذر في ((الأوسط)) (7640) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ttuHixJ7","merged":2,"otherRefs":["تخريج شرح السنة 9 / 214 (حسن)"]},{"id":"س-07068","fp":"7c4343b5936e","stateId":132,"easy":"إذا طلّقت امرأتك البتة وهي حائض ← عصيت ربك وفارقت امرأتك","cause":"طلَّقتُ امرَأتي البتَّةَ وَهيَ حائضٌ","result":"عَصيتَ ربَّكَ وفارَقتَ امرأتَكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[44],"ref":"نخب الافكار 11/21","srcLabel":"الطبراني","text":["أنَّ رجُلًا قال لِعُمرَ: إنِّي ",["طلَّقتُ امرَأتي البتَّةَ وَهيَ حائضٌ",1]," فقالَ ",["عَصيتَ ربَّكَ وفارَقتَ امرأتَكَ",2],"، فَقالَ الرَّجلُ: فإنَّ رسولَ اللَّهِ - صلَّى اللَّهُ عليهِ وسلَّمَ - أمرَ ابنَ عُمرَ حينَ فارَقَ امرأتَهُ أن يُراجعَها، فقالَ لَهُ عمرُ: إنَّ رسولَ اللَّهِ - صلَّى اللَّهُ عليهِ وسلَّمَ - أمرَهُ أن يراجِعَ امرأتَهُ بطلاقٍ بقيَ، له وأنت لم تُبقِ ما تَرتَجِعُ بِهِ امرأتَكَ"],"grade":"صحيح","narrator":"عمر","muhaddith":"سنده صحيح","takhrij":"أخرجه أبو بكر النجاد في ((مسند عمر)) (13)، والطبراني في ((المعجم الأوسط)) (8029) واللفظ لهما.","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"40p8y7tn","merged":2,"otherRefs":["مجمع الزوائد 4/338 (صحيح)"]},{"id":"س-01344","fp":"2b02631edc5a","stateId":132,"easy":"إذا ضربت زوجتك ← فلست من خياركم","cause":"كُلُّهُنَّ قد ضُرِبتْ","result":"ولنْ يَضرِبَ خيارُكُم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-03628","ref":"المستدرك على الصحيحين 2813","text":["كان الرِّجالُ نُهوا عنْ ضَرْبِ النِّساءِ، ثُمَّ شَكوهُنَّ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فخَلَّى بيْنَهم وبيْنَ ضَربِهِنَّ، ثُمَّ قالَ: لقد أَطافَ اللَّيلةَ بآلِ مُحمَّدٍ صلَّى اللهُ عليه وسلَّمَ سبعونَ امرأةً ",["كُلُّهُنَّ قد ضُرِبتْ",1],". قالَ يَحيى: وحَسِبتُ أنَّ القاسمَ قالَ: ثُمَّ قيلَ لهم بعدُ: ",["ولنْ يَضرِبَ خيارُكُم",2],"."],"grade":"صحيح","narrator":"أم كلثوم بنت أبي بكر","muhaddith":"[إسناده صحيح]","bab":"نكاح › عشرة النساء","dorar":"xGjDQxQl"},{"id":"س-01346","fp":"3c0cca4ca617","stateId":132,"easy":"إذا حدّثت الناس بما تفعل مع زوجك ← فمثلك مثل شيطان لقي شيطانة والناس ينظرون","cause":"يقولُ ما فَعلَ بأهلِه ، ولعلَّ امرأةً تُخبِرُ بما فعَلَت مع زَوجِها","result":"فإنَّما مَثلُ ذلكَ شَيطانٌ لقيَ شَيطانةً ، فغَشِيَها والنَّاسُ يَنظُرونَ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"similar":["س-05012"],"otherNeedIds":[44],"ref":"صحيح الترغيب 2022","srcLabel":"أحمد","text":["لعلَّ رجُلًا ",["يقولُ ما فَعلَ بأهلِه ، ولعلَّ امرأةً تُخبِرُ بما فعَلَت مع زَوجِها",1]," فأرَمَّ القَومُ ، فقُلتُ : إي واللهِ يا رَسولَ اللهِ ! إنهم ليَفعَلونَ ، وإنَهنَّ ليَفعلْنَ . قالَ : فلا تَفعَلوا ، ",["فإنَّما مَثلُ ذلكَ شَيطانٌ لقيَ شَيطانةً ، فغَشِيَها والنَّاسُ يَنظُرونَ",2]],"grade":"صحيح","narrator":"أسماء بنت يزيد أم سلمة الأنصارية","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (27583) واللفظ له، والطبراني (24/ 162) (414)، والخطيب في ((المتفق والمفترق)) (467) كلاهما باختلاف يسير، وإبراهيم الحربي في ((غريب الحديث)) (2/ 656) بلفظ قريب.","bab":"نكاح › عشرة النساء","dorar":"lJutC95E","merged":2,"otherRefs":["صحيح الجامع 4008 (حسن)"]},{"id":"س-00625","fp":"5ace5b690b30","stateId":132,"easy":"إذا حدّثت بما يكون بينك وبين أهلك ← فمثلك مثل شيطان لقي شيطانة على قارعة الطريق","cause":"ثم يجلس بعد ذلك فيقول : فعلتُ كذا ، فعلتُ كذا","result":"مثلُ ذلك شيطانةٌ لقِيَتْ شيطانًا في السِّكّةِ ، فقضى حاجتَه و الناسُ ينظرون إليه","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"صحيح الجامع 7037","srcLabel":"أبو داود","text":["هل منكم رجلٌ إذا أتى فأغلق عليه بابَه و ألقى عليه سترَه و استتر بسِترِ اللهِ ؟ قالوا : نعم ، قال : ",["ثم يجلس بعد ذلك فيقول : فعلتُ كذا ، فعلتُ كذا",1]," ، فسكتوا ، ثم أقبل على النساءِ ، فقال : هل منكن من تحدِّثُ ؟ فسكتْنَ ، فجثَتْ فتاةٌ كَعابٌ على إحدى ركبتَيها ، و تطاولَتْ لرسولِ اللهِ ليراها و يسمعُ كلامَها ، فقالت : يا رسولَ اللهِ ! إنهم ليُحدِّثون ، و إنهن ليُحدِّثْن ، فقال : هل تدرون [ ما ] مثلُ ذلك ؟ أما ",["مثلُ ذلك شيطانةٌ لقِيَتْ شيطانًا في السِّكّةِ ، فقضى حاجتَه و الناسُ ينظرون إليه",2]," ! ألا إنَّ طِيبَ الرجالِ ما ظهَر ريحُه و لم يظهر لونُه ، ألا إنَّ طِيبَ النِّساءِ ما ظهر لونُه و لم يظهرْ ريحُه ، ألا لا يُفضِيَنّ رجلٌ إلى رجلٍ ، و لا امرأةٌ إلى امرأةٍ ، إلا إلى ولدٍ أو والدٍ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2174) واللفظ له، والترمذي (2787)، والنسائي (5117) مختصراً، وأحمد (10977) باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"OBnRSElY"},{"id":"س-05012","fp":"cc48a7e3d615","stateId":132,"easy":"إذا حدّثت الناس بما تفعل مع أهلك ← فمثلك مثل شيطان أتى شيطانة والناس ينظرون","cause":"رجلٌ أن يُخبِر القومَ بما يكون منه إذا خلا بأهله","result":"مِثلُ ذلك ؟ ! مثلُ شيطانٍ أتى شيطانةً بالطريق ؛ فوقع بها والناسُ ينظُرون","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-01346","otherNeedIds":[44],"ref":"السلسلة الصحيحة 3153","text":["ألا هل عستِ امرأةٌ أن تُخبِرَ القومَ بما يكون من زوجِها إذا خلا بها ؟ ! ألا هل عسى ",["رجلٌ أن يُخبِر القومَ بما يكون منه إذا خلا بأهله",1]," ؟ ! فقامت منهن امرأةٌ سَفْعاءُ الخَدَّينِ فقالت : واللهِ ! إنهم ليفعلون ، وإنهنَّ لَيفْعَلْنَ ! قال : فلا تفعلوا ذلك ، أفلا أُنبِّئُكم ما ",["مِثلُ ذلك ؟ ! مثلُ شيطانٍ أتى شيطانةً بالطريق ؛ فوقع بها والناسُ ينظُرون",2]," !"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه الخرائطي في ((مساوئ الأخلاق)) (413) بلفظه، والبزار في ((مسنده)) (9583)، وابن السني في ((عمل اليوم والليلة)) كلاهما بمعناه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"dQOCD9z7","merged":2,"otherRefs":["صحيح الترغيب 2023 (حسن)"]},{"id":"س-06779","fp":"c6594670b819","stateId":133,"easy":"إذا حبست قوت من تعول ← كفى بك إثماً","cause":"أن يَحبِسَ عَمَّن يَملِكُ قُوتَه","result":"كَفى بالمَرءِ إثمًا","explicit":true,"star":true,"ref":"صحيح مسلم 996","srcLabel":"متفق عليه","text":["كُنَّا جُلوسًا مع عبدِ اللهِ بنِ عَمرٍو إذ جاءَه قَهرَمانٌ له، فدَخَلَ، فقال: أعطَيتَ الرَّقيقَ قُوتَهُم؟ قال: لا، قال: فانطَلِقْ فأعطِهم، قال: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["كَفى بالمَرءِ إثمًا",2],[" أن يَحبِسَ عَمَّن يَملِكُ قُوتَه",1],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"عتق وولاء › الإحسان إلى العبيد","dorar":"SjPsQlSU","merged":4,"otherRefs":["تخريج المسند لشعيب 6819 (صحيح)","رياض الصالحين 153 (صحيح)","صحيح الجامع 4479 (صحيح)"]},{"id":"س-03916","fp":"faa7b6af098f","stateId":133,"easy":"إذا أضررت بالورثة في الوصية ← فهو من الكبائر","cause":"الضِّرارُ عِنْدَ الوَصِيَّةِ","result":"مِن الكَبائِرِ","explicit":true,"star":true,"ref":"الأحاديث المختارة 11 / 383","srcLabel":"متفق عليه","text":["عن ابنِ عبَّاسٍ: ",["«الضِّرارُ عِنْدَ الوَصِيَّةِ ",1],["مِن الكَبائِرِ",2],"، ثُمَّ قَرَأَ: {غَيْرَ مُضَارٍّ وَصِيَّةً مِنَ اللَّهِ وَاللَّهُ عَلِيمٌ حَلِيمٌ}»."],"grade":"صحيح","narrator":"عكرمة","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"تفسير آيات › سورة النساء","dorar":"onps5p0v","merged":2,"otherRefs":["نيل المرام 254 (صحيح)"]},{"id":"س-07069","fp":"4ff4c0e68bf1","stateId":133,"easy":"إذا فضّلت أحد أولادك في العطية ← فهو جور","cause":"فهل آتَيْتَ كلَّ واحدٍ منهم مِثْلَ الَّذي آتَيْتَ هذا ؟ قال: لا","result":"هذا جَوْرٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-01340"],"ref":"تخريج صحيح ابن حبان 5104","srcLabel":"متفق عليه","text":["طلَبتْ عَمرةُ بنتُ رواحةَ إلى بَشيرِ بنِ سعدٍ أنْ ينحَلَني نُحْلًا مِن مالِه وإنَّه أبى عليها ثمَّ بدا له بعدَ حَوْلٍ أو حولَيْنِ أنْ يُنحِلَنيه فقال لها: الَّذي سأَلْتِ لابني كُنْتُ منَعْتُكِ وقد بدا لي أنْ أنحَلَه إيَّاه قالت: لا واللهِ لا أرضى حتَّى تأخُذَ بيدِه فتنطلِقَ به إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فتُشهِدَه قال: فأخَذ بيدي فانطلَق بي إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقصَّ عليه القِصَّةَ فقال له النَّبيُّ صلَّى اللهُ عليه وسلَّم: ( هل لك معه ولدٌ غيرُه ؟ ) قال: نَعم قال: ( ",["فهل آتَيْتَ كلَّ واحدٍ منهم مِثْلَ الَّذي آتَيْتَ هذا ؟ ) قال: لا",1]," قال: ( فإنِّي لا أشهَدُ على هذا، ",["هذا جَوْرٌ",2],"، أشهِدْ على هذا غيري اعدِلوا بيْنَ أولادِكم في النُّحْلِ كما تُحِبُّون أنْ يعدِلوا بينَكم في البِرِّ واللُّطْفِ"],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"إسناده صحيح على شرطهما","takhrij":"أخرجه ابن حبان (5104)، والطبراني في ((المعجم الكبير)) (21/ 71) (69) واللفظ لهما، والبخاري (2650)، ومسلم (15/ 1623) بنحوه.","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"q3JUDlOq","merged":4,"otherRefs":["تخريج صحيح ابن حبان 5101 (صحيح)","نخب الافكار 14/354 (صحيح)","تخريج المسند لشعيب 18429 (صحيح)"]},{"id":"س-01340","fp":"d74326b4f741","stateId":133,"easy":"إذا فضّلت بعض أولادك في العطية ← فهو جور لا يُشهد عليه","cause":"وقد بدا لي فوهَبْتُها له","result":"لا تُشهِدْني على جَوْرٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-07069","ref":"تخريج صحيح ابن حبان 5103","text":["سأَلتْ أمِّي أبي بعضَ الموهبةِ مِن مالِه فالتوى بها سنَةً ثمَّ بدا له فوهَبها لي وإنَّها قالت: لا أرضى حتَّى تُشهِدَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم فقال: يا رسولَ اللهِ إنَّ أمَّ هذا بنتُ رواحةَ قاتَلتْني منذُ سنَةٍ على بعضِ موهبةٍ لابني هذا ",["وقد بدا لي فوهَبْتُها له",1]," وقد أعجَبها أنْ تُشهِدَك يا رسولَ اللهِ فقال ( يا بَشيرُ ألك ولدٌ سوى هذا ؟ ) قال: نَعم قال: ( ",["لا تُشهِدْني على جَوْرٍ",2]," )"],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (2650)، والنسائي (3682)، وأحمد (18363)، وابن حبان (5103) جميعا بلفظه.","bab":"نكاح › عشرة النساء","dorar":"seo8gjeK"},{"id":"س-03830","fp":"a26afc0452dc","stateId":133,"easy":"إذا زوّجت ابنتك فاسقاً ← فقد قطعت رحمها","cause":"من زوَّج كريمتَه من فاسقٍ","result":"فقد قطع رحِمَها","explicit":true,"ref":"تخريج الإحياء للعراقي 2/54","srcLabel":"ابن حبان","text":[["من زوَّج كريمتَه من فاسقٍ ",1],["فقد قطع رحِمَها ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"من قول الشعبي بإسناد صحيح","takhrij":"أخرجه ابن حبان في ((المجروحين)) (1/275)، وابن عدي في ((الكامل في الضعفاء)) (2/322)، وابن الجوزي في ((الموضوعات)) (2/260)","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"EXwFoU2R"},{"id":"س-03796","fp":"9a1b4ccf8365","stateId":134,"easy":"إذا ظلمت جارك ← تكونان أول خصمين يوم القيامة","cause":"جارانِ","result":"أولُ خصمينِ يومَ القيامةِ","explicit":true,"otherNeedIds":[70],"ref":"مجمع الزوائد 8/173","srcLabel":"أحمد","text":[["أولُ خصمينِ يومَ القيامةِ",2]," ",["جارانِ",1]],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"أحد إسنادي الطبراني رجاله رجال الصحيح غير أبي عشانة وهو ثقة","takhrij":"أخرجه أحمد (17372)، وابن أبي عاصم في ((الأوائل)) (45)، والطبراني (17/303) (836)","bab":"بر وصلة › تحري الجار والرفيق","dorar":"fAnKQYBz"},{"id":"س-07064","fp":"b72743bbb21d","stateId":134,"easy":"إذا قال جيرانك إنك مسيء ← فأنت مسيء","cause":"وإنْ قالوا: إنَّكَ مُسيءٌ","result":"فأنت مُسيءٌ","explicit":true,"otherNeedIds":[44],"ref":"المستدرك على الصحيحين 1417","srcLabel":"البيهقي","text":["جاء رَجُلٌ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: يا رَسولَ اللهِ، دُلَّني على عَمَلٍ إذا أنا عَمِلتُ به دَخَلتُ الجَنَّةَ. قالَ: كُنْ مُحسِنًا قالَ: كيف أعلَمُ أنِّي مُحسِنٌ؟ قالَ: سَلْ جيرانَكَ، فإنْ قالوا: إنَّكَ مُحسِنٌ؛ فأنت مُحسِنٌ، ",["وإنْ قالوا: إنَّكَ مُسيءٌ",1],"؛ ",["فأنت مُسيءٌ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه البيهقي في ((الشعب)) (9120)، وقوام السنة في ((الترغيب والترهيب)) (871)، والويزر ابن الجراح في ((حديثه)) (121) واللفظ لهم.","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"MlJdVu4G"},{"id":"س-03810","fp":"0dee9d397168","stateId":134,"easy":"إذا آذيت جارك ← فلا قليل من أذى الجار","cause":"أذَى الجارِ","result":"فإنَّه لا قَليلَ مِن","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"مجمع الزوائد 8/173","srcLabel":"الطبراني","text":["لا قَليلَ من ",["أذَى الجارِ",1]," [يعني حديث: بَينَما أنا مع النَّبيِّ صلَّى اللهُ عليه وسلَّمَ في الفِراشِ، فدَخَلتْ شاةٌ لِبَعضِ جيرانِنا فأخَذَتْ قُرصًا، فقُمتُ إليها فنَكَبتِ القُرصَ مِن بَينِ لِحيَيْها، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ما كان لكِ أنْ تُعَنِّفيها ",["فإنَّه لا قَليلَ مِن",2]," أذى الجارِ.]"],"grade":"حسن","narrator":"أم سلمة أم المؤمنين","muhaddith":"رجاله ثقات","takhrij":"أخرجه الخرائطي في ((مساوئ الأخلاق)) (586)، والطبراني (23/258) (535)، وأبو نعيم في ((حلية الأولياء)) (10/27)","bab":"بر وصلة › حق الجار والوصاة به","dorar":"pVyA2zoW"},{"id":"س-06685","fp":"9c96cdffeb40","stateId":135,"easy":"إذا أممت فأنقصت من الصلاة ← فإثمه عليك لا عليهم","cause":"ومن انتقصَ من ذلك شيئًا","result":"فعليهِ ولا عليهم","explicit":true,"star":true,"ref":"عمدة القاري 5/334","srcLabel":"البخاري","text":["مَنْ أمَّ النَّاسَ فأتَمَّ [يعني حديث: من أمَّ الناسَ فأصاب الوقتَ وأَتَمَّ الصلاةَ فلَهُ ولهم، ",["ومن انتقصَ من ذلك شيئًا",1]," ",["فعليهِ ولا عليهم",2],"]"],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"على شرط البخاري","takhrij":"أخرجه أبو داود (580)، وابن ماجه (983)، وأحمد (17305) مطولاً","bab":"صلاة الجماعة والإمامة › الإمام","dorar":"8fluxKO4","merged":6,"otherRefs":["تخريج المسند لشعيب 28/621 (حسن)","تخريج المسند لشعيب 17795 (حسن)","تخريج مشكل الآثار 2198 (حسن)","صحيح الترغيب 482 (صحيح)","صحيح الجامع 2786 (صحيح)"]},{"id":"س-07112","fp":"a1590fe9f878","stateId":135,"easy":"إذا ضربت المسلمين أو منعتهم حقوقهم (وأنت أمير) ← تذلّهم وتدفعهم للكفر","cause":"لا تَضْرِبوا المُسلِمينَ","result":"فتُذِلُّوهم، ولا تمنَعوهم حُقوَقهم فتُكَفِّروهم، ولا تَجَمِّرُوهم فتَفْتِنوهم، ولا تُنزِلوهم الغِياضَ فتُضَيِّعوهم","explicit":true,"star":true,"ref":"الأحاديث المختارة 116","srcLabel":"متفق عليه","text":["«شَهِدْتُ عُمَرَ بنَ الخَطَّابِ وهو يخطُبُ النَّاسَ، قال: فقال: يا أيُّها النَّاسُ إنَّه قد أتى عليَّ زمانٌ وأنا أرى من قرأ القُرآنَ يُريدُ اللهَ وما عِندَه، فيُخَيَّلُ إليَّ أنَّ قَومًا قَرؤوه يُريدونَ به النَّاسَ، ويُريدونَ به الدُّنيا، ألَا فأَريدوا اللهَ بأعمالِكم، ألَا إنَّا إنَّما كُنَّا نَعرِفُكم أن يُنَزَّلَ، وأنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم بَيْنَ أظهُرِنا وإذ: {نَبَّأَنَا اللَّهُ مِنْ أَخْبَارِكُمْ} فقد انقَطَع الوَحْيُ وذهب نبيُّ اللهِ صلَّى اللهُ عليه وسلَّم فإنَّما نَعرِفُكم بما نقولُ لكم، ألَا مَن رأينا منه خيرًا ظَنَنَّا به خيرًا وأحبَبْناه عليه، ومن رأَينا منه شَرًّا ظَنَنَّا به شَرًّا وأبغَضْناه عليه، سرائِرُكم بَيْنَكم وبَيْنَ رَبِّكم، ألَا إنِّي إنَّما أَبعَثُ عُمَّالي ليُعَلِّموكم دينَكم، وليُعَلِّمُوكم سُنَّتَكم، ولا أبعَثُهم ليَضرِبوا ظُهورَكم ولا ليأخُذوا أموالَكم، ألَا فمَن رابه شيءٌ من ذلك فليرفَعْه إليَّ؛ فوالذي نَفْسُ عُمَرَ بيَدِه لأُقِصَّنَّكم منه. قال: فقام عَمرُو بنُ العاصِ، فقال: يا أميرَ المؤمِنينَ، أرأيتَ إنْ بعَثْتَ عامِلًا مِن عُمَّالِك، فأدَّب رجلًا من أهلِ رَعِيَّتِه فضَرَبه، أكُنْتَ تُقِصُّه منه؟ قال: فقال: نَعَم، والذي نَفْسُ عُمَرَ بيَدِه لأقُصَّنَّ منه، ألَا أَقُصُّ، وقد رأيتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقُصُّ مِن نَفْسِه، ألَا ",["لا تَضْرِبوا المُسلِمينَ",1]," ",["فتُذِلُّوهم، ولا تمنَعوهم حُقوَقهم فتُكَفِّروهم، ولا تَجَمِّرُوهم فتَفْتِنوهم، ولا تُنزِلوهم الغِياضَ فتُضَيِّعوهم",2],"»."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"علم › تعليم الناس وفضل ذلك","dorar":"xh74WHmz","merged":3,"otherRefs":["تخريج مشكل الآثار 3528 (حسن)","تخريج المسند لشاكر 1/146 (حسن)"]},{"id":"ق-0310","fp":"b01b39172f70","stateId":135,"easy":"ترك الحكم بما أنزل الله ← الظلم","cause":"ترك الحكم بما أنزل الله","result":"الظلم","explicit":true,"star":true,"ref":"سورة المائدة: 45","srcLabel":"القرآن الكريم","quran":{"s":5,"from":45,"to":45,"text":"وَكَتَبْنَا عَلَيْهِمْ فِيهَا أَنَّ النَّفْسَ بِالنَّفْسِ وَالْعَيْنَ بِالْعَيْنِ وَالْأَنْفَ بِالْأَنْفِ وَالْأُذُنَ بِالْأُذُنِ وَالسِّنَّ بِالسِّنِّ وَالْجُرُوحَ قِصَاصٌ فَمَنْ تَصَدَّقَ بِهِ فَهُوَ كَفَّارَةٌ لَهُ وَمَنْ لَمْ يَحْكُمْ بِمَا أَنْزَلَ اللَّهُ فَأُولَئِكَ هُمُ الظَّالِمُونَ (45)","hl":[[218,292,1]]}},{"id":"ق-0311","fp":"040fec4a76db","stateId":135,"easy":"ترك الحكم بما أنزل الله ← الفسق","cause":"ترك الحكم بما أنزل الله","result":"الفسق","explicit":true,"ref":"سورة المائدة: 47","srcLabel":"القرآن الكريم","quran":{"s":5,"from":47,"to":47,"text":"وَلْيَحْكُمْ أَهْلُ الْإِنْجِيلِ بِمَا أَنْزَلَ اللَّهُ فِيهِ وَمَنْ لَمْ يَحْكُمْ بِمَا أَنْزَلَ اللَّهُ فَأُولَئِكَ هُمُ الْفَاسِقُونَ (47)","hl":[[62,136,1]]}},{"id":"س-06682","fp":"254616180129","stateId":135,"easy":"إذا أممت قوماً فخصصت نفسك بالدعاء دونهم ← فقد خنتهم","cause":"ولا يَختَصَّ نفْسَه بدَعوةٍ دونَهم","result":"فإنْ فعَلَ فقد خانَهم","explicit":true,"ref":"تخريج سنن أبي داود 91","srcLabel":"البيهقي","text":["\"لا يَحِلُّ لرَجلٍ يُؤمِنُ باللهِ واليومِ الآخِرِ أنْ يُصلِّيَ وهو حَقِنٌ حتى يَتخَفَّفَ\"، ثم ساقَ نحوَه على هذا اللفظِ، قال: \"ولا يَحِلُّ لرَجلٍ يُؤمِنُ باللهِ واليومِ الآخِرِ أنْ يَؤُمَّ قومًا إلَّا بإذنِهم، ",["ولا يَختَصَّ نفْسَه بدَعوةٍ دونَهم",1],"، ",["فإنْ فعَلَ فقد خانَهم",2],"\"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره دون القطعة الأخيرة منه","takhrij":"أخرجه البيهقي (5555)، والديلمي في ((الفردوس)) (7632)، وابن عساكر في ((تاريخ دمشق)) (65/236) باختلاف يسير","bab":"صلاة الجماعة والإمامة › الإمام","dorar":"F8kPzbKM","merged":4,"otherRefs":["تخريج المسند لشعيب 22415 (صحيح)","تخريج المسند لشعيب 22241 (صحيح)","تخريج سنن أبي داود 90 (صحيح)"]},{"id":"س-05149","fp":"01cd08708cfd","stateId":135,"easy":"إذا ولّيت رجلاً وفي القوم من هو أرضى لله منه ← فقد خنت الله ورسوله والمؤمنين","cause":"مَنِ استعْمَلَ رَجُلًا مِن عِصابةٍ، وفي تلكِ العِصابةِ مَن هو أرْضَى للهِ منْه","result":"فقَدْ خانَ اللهَ، وخانَ رَسولَهُ، وخانَ المُؤمِنينَ","explicit":true,"ref":"المستدرك على الصحيحين 7218","srcLabel":"البيهقي","text":[["مَنِ استعْمَلَ رَجُلًا مِن عِصابةٍ، وفي تلكِ العِصابةِ مَن هو أرْضَى للهِ منْه؛ ",1],["فقَدْ خانَ اللهَ، وخانَ رَسولَهُ، وخانَ المُؤمِنينَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن أبي عاصم (1462)، والبيهقي (20390)، والعقيلي ((الضعفاء الكبير)) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"VsF5FqXZ"},{"id":"س-04677","fp":"43f6c4d3d0d3","stateId":135,"easy":"إذا رُفع الحد إلى السلطان فعفا عنه ← فلا أعفاه الله","cause":"فإذا رُفِعَتْ إلى السُّلطانِ","result":"فلا أعْفاهُ اللهُ إنْ عَفا عنه","explicit":true,"ref":"تخريج مشكل الآثار 4/ 385","srcLabel":"الطحاوي","text":["أنَّ الزُّبَيرَ رضِيَ اللهُ عنه مرَّ بلِصٍّ قد سَرَقَ، فقال: دَعوه اعْفوا عنه، فقالوا: تأمُرُنا بهذا يا أبا عبدِ اللهِ، وأنتَ صاحِبُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ فقال الزُّبَيرُ: إنَّ الحُدودَ يُعْفى عنها ما لم تُرفَعْ إلى السُّلطانِ، ",["فإذا رُفِعَتْ إلى السُّلطانِ",1],"، ",["فلا أعْفاهُ اللهُ إنْ عَفا عنه",2],"."],"grade":"حسن","narrator":"الفرافصة","muhaddith":"إسناده حسن","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (4/ 384) واللفظ له، وعبد الرزاق (18928)، وابن أبي شيبة (28075)، والدارقطني (3468) بنحوه.","bab":"ديات وقصاص › الشفاعة في القصاص","dorar":"S1o3jv4g"},{"id":"س-07579","fp":"74187e4fddf7","stateId":135,"easy":"إذا زلّ العالم أو جار الحاكم أو اتُّبع الهوى ← فهي أخوف ما يُخاف على الأمة","cause":"زلَّةُ عالِمٍ ، وحُكْمٌ جائرٌ ، وَهَوًى متَّبعٌ","result":"إنِّي أخافُ على أمَّتي","explicit":true,"otherNeedIds":[21],"ref":"الزواجر عن اقتراف الكبائر 2/115","srcLabel":"الزواجر عن اقتراف الكبائر","text":[["إنِّي أخافُ على أمَّتي",2]," من أعمالٍ ثلاثةً ، قالوا : وما هيَ يا رسولَ اللَّهِ ؟ قالَ : ",["زلَّةُ عالِمٍ ، وحُكْمٌ جائرٌ ، وَهَوًى متَّبعٌ",1]],"grade":"حسن","muhaddith":"رواته ثقات إلا واحدا اختلف في توثيقه","bab":"فضائل النبي وصفته ودلائل النبوة › شفقته على أمته","dorar":"JLFIOlkg"},{"id":"س-03675","fp":"963a3a4abb83","stateId":135,"easy":"إذا أمر الأمير بغير تقوى الله ← فعليه منه الإثم","cause":"وإن قال بغَيرِه","result":"فإنَّ عليه منه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح البخاري 2957","srcLabel":"متفق عليه","text":["مَن أطاعَني فقد أطاعَ اللهَ، ومَن عَصاني فقد عَصى اللهَ، ومَن يُطِعِ الأميرَ فقد أطاعَني، ومَن يَعصِ الأميرَ فقد عَصاني، وإنَّما الإمامُ جُنَّةٌ يُقاتَلُ مِن ورائِه ويُتَّقى به، فإن أمَرَ بتَقوى اللهِ وعَدَلَ فإنَّ له بذلك أجرًا، ",["وإن قال بغَيرِه",1]," ",["فإنَّ عليه منه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2957)، ومسلم (1835)","bab":"اعتصام بالسنة › الأمر بالتمسك بالكتاب والسنة","dorar":"50wib7r4","merged":2,"otherRefs":["صحيح الجامع 2322 (صحيح)"]},{"id":"س-05898","fp":"d61b484933e2","stateId":136,"easy":"إذا امتلأ جوفك شعراً (يشغلك عن الذكر) ← فالقيح خير لك منه","cause":"أنْ يَمتَلِئَ شِعْرًا","result":"لأَنْ يَمتَلِئَ جَوْفُ الرجُلِ قَيْحًا خَيرٌ له","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 11368","srcLabel":"مسلم","text":["بيْنَما نحن نَسيرُ مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ بالعَرْجِ إذ عرَض شاعرٌ يَنشُدُ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: \"خُذوا الشيطانَ -أو أَمْسِكوا الشيطانَ- ",["لأَنْ يَمتَلِئَ جَوْفُ الرجُلِ قَيْحًا خَيرٌ له",2]," من ",["أنْ يَمتَلِئَ شِعْرًا",1],"\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2259)، وأحمد (11368) واللفظ له","bab":"رقائق وزهد › الوصايا النافعة","dorar":"I4hnwRF0","merged":4,"otherRefs":["صحيح الأدب المفرد 667 (صحيح)","صحيح الجامع 5048 (صحيح)","تخريج المسند لشعيب 5704 (صحيح)"]},{"id":"س-05762","fp":"5986acd207fd","stateId":136,"easy":"إذا تمنيت مالاً لتعمل به المعاصي ← فوزرك ووزر العامل سواء","cause":"لو أنَّ لي مالًا لعملتُ فيه بعملِ فلانٍ","result":"فهو بنيَّتِه ، فوزرُهما سواءٌ مثلَ هذه الأمةِ كمثلِ أربعةِ نفرٍ : رجلٌ آتاه اللهُ مالًا و علمًا فهو يعملُ بعلمِه في مالِه ؛ ينفقُه في حقِّه ، و رجلٌ آتاه","explicit":true,"star":true,"ref":"صحيح الترغيب 16","srcLabel":"الترمذي","text":["إنما الدنيا لأربعةِ نفرٍ ؛ عبدٌ رزقَه اللهُ مالًا و علمًا فهو يتَّقي فيه ربَّه ، و يصِلُ فيه رَحِمَه ، و يعلمُ للهِ فيه حقًّا ، فهذا بأفضلِ المنازلِ ، و عبدٌ رزقَه اللهُ علمًا ، و لم يرزقْه مالًا ، فهو صادقُ النَّيَّةِ ، يقولُ : لو أنَّ لي مالًا لعملتُ بعملِ فلانٍ ، فهو بنِيَّتِه ، فأجرُهما سواءٌ و عبدٌ رزقَه اللهُ مالًا ، و لم يرزقْه عِلمًا يخبِطُ في مالِه بغيرِ علمٍ ، و لا يتَّقي فيه ربَّه ، و لا يصِلُ فيه رَحِمَه ، و لا يعلمُ للهِ فيه حقًّا ، فهذا بأخبثِ المنازلِ ، و عبدٌ لم يرزقْه اللهُ مالًا و لا علمًا فهو يقولُ : ",["لو أنَّ لي مالًا لعملتُ فيه بعملِ فلانٍ ، ",1],["فهو بنيَّتِه ، فوزرُهما سواءٌ ) مثلَ هذه الأمةِ كمثلِ أربعةِ نفرٍ : رجلٌ آتاه اللهُ مالًا و علمًا فهو يعملُ بعلمِه في مالِه ؛ ينفقُه في حقِّه ، و رجلٌ آتاه",2]," اللهُ علمًا و لم يُؤْتِه مالًا و هو يقول : لو كان لي مثلُ هذا عملتُ فيه بمثلِ الذي يعملُ فهما في الأجر سواءٌ ، و رجلٌ آتاه اللهُ مالًا و لم يُؤتِه علمًا فهو يخبطُ في مالِه ينفقُه في غيرِ حقِّه ، و رجلٌ لم يؤْتِه اللهُ مالًا و لا علمًا ، و هو يقولُ : لو كان لي مثلُ هذا عملتُ فيه مثلَ الذي يعمل قال رسولُ اللهِ : فهما في الوزرِ سواءٌ"],"grade":"صحيح","narrator":"أبو كبشة الأنماري","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (2325) مطولاً واللفظ له، وأحمد (18031) مطولاً باختلاف يسير","bab":"رقائق وزهد › النية","dorar":"MhgfuyRo","merged":4,"otherRefs":["شرح مسلم لابن عثيمين 2/456 (صحيح)","الفروع لابن مفلح 3/ 73 (حسن)","هداية الرواة 5217 (صحيح)"]},{"id":"س-07489","fp":"c26e9660c8c9","stateId":136,"easy":"إذا كنت ضخماً أكولاً شروباً بلا عمل صالح ← لا تزن عند الله جناح بعوضة","cause":"بالعظيمِ الطَّويلِ الأكولِ الشَّروبِ","result":"فلا يزِنُ عند اللهِ جناحَ بعوضةٍ","explicit":true,"ref":"الترغيب والترهيب 3/167","srcLabel":"البيهقي","text":["ليُؤْتينَّ يومَ القيامةِ ",["بالعظيمِ الطَّويلِ الأكولِ الشَّروبِ",1]," ",["فلا يزِنُ عند اللهِ جناحَ بعوضةٍ",2]," واقرءُوا إن شئتُم { فَلَا نُقِيمُ لَهُمْ يَوْمَ الْقِيَامَةِ وَزْنًا }"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (6/230)، والبيهقي في ((شعب الإيمان)) (5670)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"g2oDhRCN"},{"id":"س-05659","fp":"a386e73e77f5","stateId":136,"easy":"إذا أحببت الدنيا ← فهي رأس كل خطيئة","cause":"حُبُّ الدُّنيا","result":"رأسُ كُلِّ خَطيئةٍ","explicit":true,"ref":"فيض القدير 3/ 369","srcLabel":"فيض القدير","text":[["حُبُّ الدُّنيا",1]," ",["رأسُ كُلِّ خَطيئةٍ",2]],"grade":"حسن","narrator":"الحسن البصري","muhaddith":"ابن المديني أثنى على مراسيل الحسن والإسناد إليه حسن","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"pOmGMErj"},{"id":"س-06023","fp":"0baae0c41377","stateId":136,"easy":"إذا نشأت على النعيم والترف ← تكون من شرار الأمة","cause":"الَّذين غُذُّوا بالنَّعيمِ ونبتت عليه أجسامُهم","result":"أشرارَ أمَّتي","explicit":true,"ref":"الترغيب والترهيب 3/170","srcLabel":"البزار","text":["إنَّ ",["أشرارَ أمَّتي",2]," ",["الَّذين غُذُّوا بالنَّعيمِ ونبتت عليه أجسامُهم",1]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"رواته ثقات إلا عبد الرحمن بن زياد بن أنعم","takhrij":"أخرجه البزار (9415)، وابن عساكر في ((تاريخ دمشق)) (43/ 311) كلاهما بلفظه، وابن راهويه (1/ 348) باختلاف يسير.","bab":"رقائق وزهد › ذم حب الدنيا","dorar":"oeZgJ1bV"},{"id":"س-07511","fp":"c37397fa75c5","stateId":136,"easy":"إذا خالطت الملوك لدنياهم ← لا تجني منهم إلا الإثم","cause":"أَتَيْتُم المُلوكَ فأَصَبْتُم مِن دُنْياهم، واعْتَزَلْتُموهم بدينِكم","result":"كما لا يُجْتَنى مِن القَتادِ إلَّا الشَّوْكُ، كذلك لا يُجْتَنى مِن قُرْبِهم إلَّا الخَطايا","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"الأحاديث المختارة 11/ 167","srcLabel":"متفق عليه","text":["«إنَّ ناسًا مِن أُمَّتي سيَقْرَؤونَ القُرآنَ ويَتَعَمَّقونَ في الدِّينِ يَأتيهم الشَّيْطانُ، فيقولُ: لو ما ",["أَتَيْتُم المُلوكَ فأَصَبْتُم مِن دُنْياهم، واعْتَزَلْتُموهم بدينِكم",1],"، أَلَا ولا يكونُ ذلك إلَّا ",["كما لا يُجْتَنى مِن القَتادِ إلَّا الشَّوْكُ، كذلك لا يُجْتَنى مِن قُرْبِهم إلَّا الخَطايا",2],"»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"lODvY2HC"},{"id":"س-00612","fp":"5de90b520767","stateId":136,"easy":"إذا خالطت الأمراء تطلب دنياهم بدينك ← لا تجني إلا الإثم كما لا يُجنى من القتاد إلا الشوك","cause":"نأتي الأُمَراءَ فنُصيبُ مِن دُنياهم، ونَعتَزُّ لهم بدِينِنا","result":"كمَن لا يَجتَني مِنَ القَتادِ إلَّا الشَّوكَ، كذلك لا يَجتَني مَن قَرَبَهم إلَّا","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه","واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الترغيب والترهيب 1/93","srcLabel":"ابن ماجه","text":["إنَّ ناسًا مِن أُمَّتي سَيَتفَقَّهونَ في الدِّينِ يَقرَؤونَ القُرآنَ يَقولونَ: ",["نأتي الأُمَراءَ فنُصيبُ مِن دُنياهم، ونَعتَزُّ لهم بدِينِنا",1],"، ولا يَكونُ ذلكَ إلَّا ",["كمَن لا يَجتَني مِنَ القَتادِ إلَّا الشَّوكَ، كذلك لا يَجتَني مَن قَرَبَهم إلَّا.",2]," قال ابنُ الصَّباحِ: يَعني الخَطايا."],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"رواته ثقات","takhrij":"أخرجه ابن ماجه (255)، والطبراني في ((المعجم الأوسط)) (8236)، والضياء في ((الأحاديث المختارة)) (154) باختلاف يسير","bab":"آداب عامة › ضرب الأمثال","dorar":"pRl74w1o"},{"id":"س-07204","fp":"ad40a9b3ea6c","stateId":137,"easy":"إذا تفلت في المسجد ← فهي خطيئة","cause":"التَّفلِ في المَسجِدِ","result":"خَطيئةٌ","explicit":true,"star":true,"otherNeedIds":[45],"ref":"صحيح مسلم 552","srcLabel":"البخاري","text":["سَألتُ قَتادةَ عَنِ ",["التَّفلِ في المَسجِدِ",1],"، فقال: سَمِعتُ أنَسَ بنَ مالِكٍ يقولُ: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: التَّفلُ في المَسجِدِ ",["خَطيئةٌ",2],"، وكَفَّارَتُها دَفنُها."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه ابن الجعد في ((مسنده)) (937)، وابن شبة في ((تاريخ المدينة)) (1/ 25) كلاهما بلفظه، والبخاري (415)، وأبو داود (474) كلاهما بلفظ مقارب .","bab":"علم › حسن السؤال ونصح العالم","dorar":"tWtanb4E","merged":8,"otherRefs":["صحيح ابن خزيمة 2/ 457 (صحيح)","تخريج المسند لشعيب 13948 (صحيح)","تخريج المسند لشعيب 12891 (صحيح)","تخريج سنن أبي داود 476 (صحيح)","صحيح الجامع 2885 (حسن)","صحيح الترغيب 287 (صحيح)","إرشاد الساري 1/421 (حسن)"]},{"id":"س-05197","fp":"28393b7cf728","stateId":137,"easy":"إذا مررت بين يدي أخيك وهو يصلي ← فوقوفك أربعين خير لك","cause":"أن يمرَّ بينَ يدي أخيهِ وَهوَ يصلِّي","result":"كانَ لأن يقفَ أربعينَ قالَ لا أدري أربعينَ عامًا أو أربعينَ شَهرًا أو أربعينَ يومًا خيرٌ لَهُ من ذلِكَ","explicit":true,"star":true,"similar":["س-02926","س-07187","س-05181"],"ref":"صحيح ابن ماجه 781","srcLabel":"متفق عليه","text":["لو يعلمُ أحدُكم ما لَهُ ",["أن يمرَّ بينَ يدي أخيهِ وَهوَ يصلِّي",1]," ",["كانَ لأن يقفَ أربعينَ قالَ لا أدري أربعينَ عامًا أو أربعينَ شَهرًا أو أربعينَ يومًا خيرٌ لَهُ من ذلِكَ",2]],"grade":"صحيح","narrator":"بسر بن سعيد","muhaddith":"صحيح","takhrij":"أخرجه البخاري (510)، ومسلم (507)، وابن ماجه (945) واللفظ له، وأحمد (24009/59)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Z4v2LNmX","merged":4,"otherRefs":["تحفة المحتاج 1/359 (صحيح)","تنبيه الغافلين 268 (صحيح)","شرح ابن ماجه لمغلطاي 3/567 (صحيح)"]},{"id":"س-07962","fp":"a679c698371c","stateId":137,"easy":"إذا تنخمت في المسجد ← فغيّب نخامتك لئلا تؤذي مؤمناً","cause":"إذا تَنَخَّمَ أحَدُكم وهو في المَسجِدِ فلْيُغَيِّبْ نُخامتَه","result":"لا يُصيبُ جِلدَ مُؤمِنٍ أو ثَوْبَه فيُؤْذِيَه","explicit":true,"star":true,"ref":"الأحاديث المختارة 991","srcLabel":"البخاري","text":["«",["إذا تَنَخَّمَ أحَدُكم وهو في المَسجِدِ فلْيُغَيِّبْ نُخامتَه",1]," ",["لا يُصيبُ جِلدَ مُؤمِنٍ أو ثَوْبَه فيُؤْذِيَه",2],"»."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"مساجد ومواضع الصلاة › البزاق في المسجد","dorar":"jf3Ug2Tr","merged":2,"otherRefs":["السلسلة الصحيحة 1265 (حسن)"]},{"id":"س-02926","fp":"a98ff157023c","stateId":137,"easy":"إذا مررت بين يدي المصلي ← فلأن تقف أربعين خير لك من المرور","cause":"لو يَعلَمُ المارُّ بينَ يَدَيِ المُصَلِّي ماذا عليه","result":"لَكان أن يَقِفَ أربَعينَ خَيرًا له مِن أن يَمُرَّ بينَ يَدَيه","explicit":true,"repOf":"س-05197","ref":"صحيح البخاري 510","text":["أنَّ زَيدَ بنَ خالِدٍ أرسَلَه إلى أبي جُهَيمٍ يَسألُه: ماذا سَمِعَ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في المارِّ بينَ يَدَيِ المُصَلِّي؟ فقال أبو جُهَيمٍ: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["لو يَعلَمُ المارُّ بينَ يَدَيِ المُصَلِّي ماذا عليه",1],"، ",["لَكان أن يَقِفَ أربَعينَ خَيرًا له مِن أن يَمُرَّ بينَ يَدَيه",2],". قال أبو النَّضرِ: لا أدري أقال: أربَعينَ يَومًا، أو شَهرًا، أو سَنةً."],"grade":"صحيح","narrator":"أبو جهيم بن الحارث بن الصمة الأنصاري","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (507) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"JApy6zmM","merged":2,"otherRefs":["تخريج الإحياء للعراقي 1/247 (صحيح)"]},{"id":"س-07471","fp":"261e00e2a632","stateId":137,"easy":"إذا تركت النخامة في المسجد ولم تدفنها ← فهي من مساوئ الأعمال","cause":"النُّخاعةُ تكونُ في المَسجِدِ لا تُدفَنُ","result":"في مَساوئِ أعمالِها","explicit":true,"ref":"تخريج المسند لشعيب 21567","srcLabel":"مسلم","text":["عُرِضَتْ عليَّ أعمالُ أُمَّتي حَسَنُها وسَيِّئُها، فوجَدْتُ في مَحاسِنِ أعمالِها إماطةَ الأَذى عنِ الطريقِ، ووجَدْتُ ",["في مَساوئِ أعمالِها",2]," النُّخاعةَ، قال عارمٌ: تكونُ في المَسجِدِ لا تُدفَنُ، وقال يونُسُ: ",["النُّخاعةُ تكونُ في المَسجِدِ لا تُدفَنُ",1],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده قوي على شرط مسلم","takhrij":"أخرجه مسلم (553)، وابن ماجه (3683)، وأحمد (21567) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"AoRxZRGM","merged":2,"otherRefs":["صحيح الجامع 4003 (صحيح)"]},{"id":"س-07572","fp":"9069624b64d6","stateId":137,"easy":"إذا أطلت الصلاة على الناس ← تنفّرهم","cause":"يُطيلُ بنا","result":"إنَّ مِنكُم مُنَفِّرينَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح البخاري 7159","srcLabel":"متفق عليه","text":["جاءَ رَجُلٌ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: يا رَسولَ اللهِ، إنِّي واللهِ لَأتَأخَّرُ عن صَلاةِ الغَداةِ مِن أجلِ فُلانٍ؛ ممَّا ",["يُطيلُ بنا",1]," فيها، قال: فما رَأيتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم قَطُّ أشَدَّ غَضَبًا في مَوعِظةٍ منه يَومَئذٍ، ثُمَّ قال: يا أيُّها النَّاسُ، ",["إنَّ مِنكُم مُنَفِّرينَ",2],"، فأيُّكُم ما صَلَّى بالنَّاسِ فليوجِزْ؛ فإنَّ فيهمُ الكَبيرَ، والضَّعيفَ، وذا الحاجةِ."],"grade":"صحيح","narrator":"أبو مسعود عقبة بن عمرو","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7159)، ومسلم (466)","bab":"فضائل النبي وصفته ودلائل النبوة › شفقته على أمته","dorar":"ouG1dVhn","merged":4,"otherRefs":["صحيح البخاري 704 (صحيح)","فتح الباري لابن حجر 2/232 (حسن)","صحيح مسلم 466 (صحيح)"]},{"id":"س-02696","fp":"9d8904ddcc35","stateId":137,"easy":"إذا أطلت الصلاة بالناس ← تفتنهم","cause":"فطوَّلَ","result":"أفتَّانٌ يا معاذُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأحكام الكبير 3/189","srcLabel":"البخاري","text":["قام معاذٌ فصلَّى العِشاءَ الآخرةَ ",["فطوَّلَ",1]," فقال النبيُّ صلَّى اللهُ عليهِ وسلَّمَ: ",["أفتَّانٌ يا معاذُ",2],"؟! أفتَّانٌ يا معاذُ؟! أين كنتَ عن {سَبِّحِ اسمَ رَبِّكَ الْأَعْلَى} [الأعلى: 1] {وَالضُّحَى} و{إِذَا السَّمَاءُ انْفَطَرَتْ}."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"أصل هذا الحديث في صحيح البخاري","takhrij":"أخرجه النسائي (997)","bab":"إيمان › الدين يسر","dorar":"cpfUnns3"},{"id":"س-04781","fp":"73eafc553664","stateId":137,"easy":"إذا تخطّيت رقاب الناس يوم الجمعة ← فقد آذيت وتأخرت","cause":"يَتَخَطَّى رِقابَ النَّاسِ","result":"فقدْ آذَيْتَ وآنَيْتَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأحاديث المختارة 9 / 47","srcLabel":"متفق عليه","text":["«أنَّ رَجُلًا دَخَلَ والنَّبيُّ صلَّى اللهُ عليه وسلَّمَ يَخطُبُ يَوْمَ الجُمُعةِ، فجَعَلَ ",["يَتَخَطَّى رِقابَ النَّاسِ",1],"، فقالَ له النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: اجْلِسْ؛ ",["فقدْ آذَيْتَ وآنَيْتَ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن بسر المازني","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"118Wjb8Z"},{"id":"س-07187","fp":"f48e028d4cd1","stateId":137,"easy":"إذا مررت بين يدي المصلي ← فوقوفك أربعين خير لك","cause":"لَأنْ يقومَ أحَدُكم أربعِينَ","result":"خيرٌ له من أنْ يمُرَّ بيْنَ يَدَيْهِ","explicit":true,"repOf":"س-05197","ref":"تخريج مشكل الآثار 84","text":["عن بُسْرِ بنِ سَعيدٍ، أرسَلهُ أبو جُهَيْمٍ ابنُ أُختِ أُبَيِّ بنِ كَعبٍ إلى زَيدِ بن خالدٍ الجُهَنيِّ يسألُهُ: ما سمِعْتَ منَ النَّبيِّ عليه السَّلامُ في الذي يمُرُّ بيْنَ يَدَيِ المُصلِّي؟ فحدَّثهُ عنِ النَّبيِّ عليه السَّلامُ: ",["لَأنْ يقومَ أحَدُكم أربعِينَ ",1],["خيرٌ له من أنْ يمُرَّ بيْنَ يَدَيْهِ",2],". لا يَدري أربعِينَ سَنَةً، أو شهرًا، أو يومًا."],"grade":"صحيح","narrator":"زيد بن خالد الجهني","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الدارمي (1456)، والحميدي (836)، والطحاوي في ((شرح مشكل الآثار)) (84)، والطبراني (5235) (5/ 246) واللفظ لهم جميعا.","bab":"علم › حسن السؤال ونصح العالم","dorar":"QUTg9yMb","merged":2,"otherRefs":["تخريج مشكل الآثار 86 (صحيح)"]},{"id":"س-02689","fp":"e3884ce82a61","stateId":137,"easy":"إذا أطلت الصلاة على الناس وأنت إمام ← تبغّض إليهم الصلاة","cause":"فيطيلُ على القومِ الصلاةَ","result":"حتَّى يبغِّضَ إليهم ما هم فيه","explicit":true,"ref":"شرح ثلاثيات المسند 1/250","srcLabel":"شرح ثلاثيات المسند","text":["عن عمرَ بنِ الخطابِ رضي اللهُ عنه أنه قال  لا تُبغِّضوا اللهَ إلى عبادِه يكونُ أحدُكم إمامًا ",["فيطيلُ على القومِ الصلاةَ",1]," ",["حتَّى يبغِّضَ إليهم ما هم فيه",2]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"إيمان › الدين يسر","dorar":"2wQuBEzD"},{"id":"س-03060","fp":"c02046e67dfd","stateId":137,"easy":"إذا وضعت يدك على خاصرتك في الصلاة ← فهو فعل أهل النار","cause":"الاختصارُ في الصَّلاةِ","result":"راحةُ أَهْلِ النَّارِ","explicit":true,"ref":"الترغيب والترهيب 1/258","srcLabel":"ابن حبان","text":[["الاختصارُ في الصَّلاةِ",1]," ",["راحةُ أَهْلِ النَّارِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن خزيمة (909)، وابن حبان (2286)","bab":"إيمان › الوعيد","dorar":"yIZp4djh"},{"id":"س-05181","fp":"ca945b173c26","stateId":137,"easy":"إذا مررت بين يدي المصلي متعمداً ← فلأن تكون رماداً تذروه الريح خير لك","cause":"أن يمرَّ بينَ يدَي رجُلٍ متَعمِّدًا وهو يُصلِّي","result":"لأن يكونَ الرَّجُلُ رمادًا يُذرَى بِهِ خيرٌ لهُ","explicit":true,"repOf":"س-05197","ref":"الترغيب والترهيب 1/259","text":["عَن عبدِ اللهِ بنِ عمرٍو رضيَ اللهُ عنهُما قالَ ",["لأن يكونَ الرَّجُلُ رمادًا يُذرَى بِهِ خيرٌ لهُ",2]," مِن ",["أن يمرَّ بينَ يدَي رجُلٍ متَعمِّدًا وهو يُصلِّي",1]],"grade":"صحيح","narrator":"[أبو عمران الغافقي]","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الفاكهي في ((فوائده)) (20)، وأبو نعيم في ((تاريخ أصبهان)) (1/ 417)، وابن عبد البر في ((التمهيد)) (21/ 149) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"PdPfmBLJ"},{"id":"س-02769","fp":"18d4681c80c7","stateId":137,"easy":"إذا بصقت أمامك في الصلاة ← فقد آذيت الله والملائكة","cause":"تَفَلَّتَ بين يديْكَ ، و أنتَ قائمٌ تؤمُ الناسَ","result":"فآذيتَ اللهَ و الملائكةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[28],"ref":"صحيح الترغيب 289","srcLabel":"الطبراني","text":["لا ، و لكنَّكَ ",["تَفَلَّتَ بين يديْكَ ، و أنتَ قائمٌ تؤمُ الناسَ",1]," ، ",["فآذيتَ اللهَ و الملائكةَ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"حسن صحيح","takhrij":"لم نقف عليه من حديث عبدالله بن عمر. وأخرجه الطبراني (14/80) (14688) مطولاً من حديث عبدالله بن عمرو رضي الله عنهما","bab":"إيمان › الملائكة","dorar":"XgyGuZMc"},{"id":"س-07960","fp":"1a702a3b58b1","stateId":137,"easy":"إذا بصقت في القبلة وأنت إمام ← تُمنع من إمامة الناس","cause":"أمَّ قومًا ، فَبصقَ في القبلةِ","result":"لا يصلِّي لَكُم هَذا فأرادَ بعدَ ذلِكَ أن يصلِّيَ لَهُم فمنعوهُ وأخبروهُ بقولِ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ، فذَكَرَ ذلِكَ لرسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[28],"ref":"الترغيب والترهيب 1/162","srcLabel":"أبو داود","text":["أنَّ رجلًا ",["أمَّ قومًا ، فَبصقَ في القبلةِ",1]," ، ورسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يَنظرُ ، فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ حينَ فرغَ : ",["لا يصلِّي لَكُم هَذا فأرادَ بعدَ ذلِكَ أن يصلِّيَ لَهُم فمنعوهُ وأخبروهُ بقولِ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ، فذَكَرَ ذلِكَ لرسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ،",2]," فقالَ : نعَم ، وحَسِبْتُ أنَّهُ قالَ : إنَّكَ آذَيتَ اللَّهَ ورسولَهُ"],"grade":"صحيح","narrator":"السائب بن خلاد","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (481)، وأحمد (16561) باختلاف يسير","bab":"مساجد ومواضع الصلاة › البزاق في المسجد","dorar":"Hh5UPp4L"},{"id":"س-04057","fp":"5a369ff2931c","stateId":137,"easy":"إذا تخطّيت رقاب الناس يوم الجمعة ← تؤذيهم","cause":"جاء يتخَطَّى رِقابَ النَّاسِ","result":"يُؤذيهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"إتحاف الخيرة المهرة 2/310","srcLabel":"ابن أبي عمر","text":["جاء رجُلٌ والنَّبيُّ صَلَّى اللهُ عليه وسلَّمَ يخطُبُ يومَ الجُمعةِ، فقال النَّبيُّ صَلَّى اللهُ عليه وسلَّمَ: يَلْهو أحدُكم حتَّى إذا كادتِ الجُمعةُ تفوتُه ",["جاء يتخَطَّى رِقابَ النَّاسِ",1]," ",["يُؤذيهم",2],"! فقال: ما فعلْتُ يا نَبِيَّ اللهِ ولكنْ كنْتُ راقدًا، ثمَّ استيقظْتُ، فقُمْتُ، فتوضَّأْتُ، ثمَّ أقبَلْتُ، فقال النَّبيُّ صَلَّى اللهُ عليه وسلَّمَ: أويومُ وُضوءٍ هذا؟!"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"رجاله ثقات","takhrij":"أخرجه ابن أبي عمر العدني كما في ((إتحاف الخيرة المهرة)) للبوصيري (2/310)","bab":"جمعة › الكلام مع الإمام وهو يخطب والعكس","dorar":"o6rqwCsS"},{"id":"س-04925","fp":"d2e94f8ed592","stateId":138,"easy":"إذا حاولت مضاهاة خلق الله (التصوير) ← فلا أحد أظلم منك","cause":"خلَقَ خَلْقًا كخَلْقي","result":"مَن أظلَمُ ممَّن","explicit":true,"ref":"تخريج المسند لشعيب 9082","srcLabel":"متفق عليه","text":[["مَن أظلَمُ ممَّن",2]," ",["خلَقَ خَلْقًا كخَلْقي",1],"، فليَخْلُقوا مِثْلَ خَلْقي ذَرَّةً، أو ذُبابةً، أو حَبَّةً."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5953)، ومسلم (2111)، وأحمد (9082) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"uVbEqDky"},{"id":"س-00581","fp":"de13b3e68866","stateId":138,"easy":"إذا لعبت بالنرد ← فكأنما غمست يدك في لحم خنزير ودمه","cause":"مَن لَعِبَ بالنَّردشيرِ","result":"فكأنَّما غَمَسَ يَدَه في لَحمِ خِنزيرٍ ودَمِه","explicit":true,"similar":["س-04999"],"ref":"تخريج المسند لشعيب 22979","srcLabel":"مسلم","text":[["مَن لَعِبَ بالنَّردشيرِ، ",1],["فكأنَّما غَمَسَ يَدَه في لَحمِ خِنزيرٍ ودَمِه",2],". ولم يُسنِدْه وَكيعٌ مَرَّةً."],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2260) باختلاف يسير","bab":"آداب عامة › ضرب الأمثال","dorar":"B5dXnK7o","merged":2,"otherRefs":["غاية المرام 396 (صحيح)"]},{"id":"س-05185","fp":"5e5c81b64be7","stateId":138,"easy":"إذا لعبت بالنرد ← فقد عصيت الله ورسوله","cause":"من لعِب بنردٍ أو نردشيرَ","result":"فقد عصَى الله ورسولَه","explicit":true,"similar":["س-04881","س-04943"],"ref":"الترغيب والترهيب 4/95","srcLabel":"أبو داود","text":[["من لعِب بنردٍ أو نردشيرَ ",1],["فقد عصَى الله ورسولَه",2]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (4938)، وابن ماجه (3762)، وأحمد (19521) باختلاف يسير، ومالك كما في ((الترغيب والترهيب)) للمنذري (4/23) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"RSGfasJp","merged":2,"otherRefs":["هداية الرواة 4431 (حسن)"]},{"id":"س-04881","fp":"9906bf150469","stateId":138,"easy":"إذا لعبت بالنرد ← فقد عصيت الله ورسوله","cause":"مَنْ لَعِبَ بالنَّرْدِ","result":"فقدْ عصَى اللهَ و رسولَهُ","explicit":true,"repOf":"س-05185","ref":"الجامع الصغير 8988","text":[["مَنْ لَعِبَ بالنَّرْدِ ، ",1],["فقدْ عصَى اللهَ و رسولَهُ",2]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4938)، وابن ماجه (3762)، وأحمد (19521)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"jLCzf9dY"},{"id":"س-04941","fp":"0c8d01b46978","stateId":138,"easy":"إذا قلّبت كعاب النرد تنتظر ما تأتي به ← فقد عصيت الله ورسوله","cause":"لا يُقلِّبُ كَعَباتِها أحَدٌ يَنتظِرُ ما تأتي به","result":"إلَّا عَصى اللهَ ورسولَه","explicit":true,"ref":"تخريج المسند لشعيب 19649","srcLabel":"أحمد","text":[["لا يُقلِّبُ كَعَباتِها أحَدٌ يَنتظِرُ ما تأتي به",1]," ",["إلَّا عَصى اللهَ ورسولَه",2],"."],"grade":"حسن","narrator":"أبو موسى الأشعري","muhaddith":"حسن","takhrij":"أخرجه أحمد (19649)، والبيهقي (21480) واللفظ لهما، وأبو يعلى (7289) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"xUoFcHFt"},{"id":"س-04943","fp":"2b4455a8ef98","stateId":138,"easy":"إذا لعبت بالكعاب (النرد) ← فقد عصيت الله ورسوله","cause":"مَن لَعِبَ بالكِعابِ","result":"فقد عَصى اللهَ ورسولَه","explicit":true,"repOf":"س-05185","ref":"تخريج المسند لشعيب 19501","text":[["مَن لَعِبَ بالكِعابِ ",1],["فقد عَصى اللهَ ورسولَه",2],"."],"grade":"حسن","narrator":"أبو موسى الأشعري","muhaddith":"حسن","takhrij":"أخرجه أحمد (19501)، وعبد بن حميد (548)، والحاكم (161)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"AkdsEQR6"},{"id":"س-01415","fp":"fe226ab869db","stateId":138,"easy":"إذا صوّرت ما فيه روح ← فلا أظلم منك (تضاهي خلق الله)","cause":"ذهَبَ يَـخْلُقُ خَلْقًا كخَلْقي","result":"ومَن أَظْلَمُ مـمَّن","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"otherNeedIds":[69],"ref":"تخريج المسند لشعيب 7166","srcLabel":"متفق عليه","text":["دخَلْتُ مع أبي هريرةَ دارَ مَرْوانَ بنِ الـحَكَمِ، فرَأى فيها تَصاوِيرَ، وهي تُبْنى، فقال: سـمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: يَقولُ اللهُ عزَّ وجلَّ: ",["ومَن أَظْلَمُ مـمَّن",2]," ",["ذهَبَ يَـخْلُقُ خَلْقًا كخَلْقي",1],"، فلْيَخْلُقوا ذَرَّةً، أو فَلْيَخْلُقوا حَبَّةً، أو لِيَخْلُقوا شَعِيرَةً، ثم دَعا بوَضوءٍ، فتَوَضَّأ وغَسَلَ ذِراعَيْه حتى جاوَزَ الـمِرْفَقَيْن، فلمَّا غَسَلَ رِجْلَيْه جاوَزَ الكَعْبَيْن إلى السَّاقَيْن، فقُلْتُ: ما هذا؟ فقال: هذا مَبْلَغُ الـحِلْيَةِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (5953)، ومسلم (2111) باختلاف يسير","bab":"وضوء › صفة الوضوء","dorar":"r1sB0lNw","merged":3,"otherRefs":["صحيح البخاري 5953 (صحيح)","تخريج صحيح ابن حبان 5859 (صحيح)"]},{"id":"س-04999","fp":"84f06a0dd99d","stateId":138,"easy":"إذا لعبت بالنرد ← فكأنما غمست يدك في لحم الخنزير","cause":"من لَعِب بالنَّرْدَشيرِ","result":"فلْيُشَقِّصِ الخنازيرَ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-00581","ref":"الفتاوى الكبرى 4/460","text":[["فلْيُشَقِّصِ الخنازيرَ",2]," [",["من لَعِب بالنَّرْدَشيرِ",1],"]"],"grade":"صحيح","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"GMzssxQk"},{"id":"س-04813","fp":"a37452d8a418","stateId":139,"easy":"إذا كنتم ثلاثة فلا يتناجَ اثنان دون الثالث ← فإن ذلك يحزنه","cause":"فلا يَتناجَى اثنانِ دُونَ صاحِبِهما","result":"فإنَّ ذلك يُحزِنُه","explicit":true,"star":true,"otherNeedIds":[27],"ref":"تخريج المسند لشاكر 6/183","srcLabel":"البخاري","text":["لا تُباشِرِ المَرأةُ المَرأةَ كأنَّها تَنعَتُها لِزَوجِها، أو تَصِفُها لِزَوجِها، أو لِلرَّجُلِ، كأنَّه يَنظُرُ إليها، وإذا كان ثَلاثةٌ ",["فلا يَتناجَى اثنانِ دُونَ صاحِبِهما",1],"؛ ",["فإنَّ ذلك يُحزِنُه",2],"، ومَن حَلَفَ على يَمينٍ كاذِبًا لِيَقتَطِعَ مالَ أخيهِ -أو قال: مالَ امرئٍ مُسلِمٍ- لَقيَ اللهَ عزَّ وجلَّ وهو عليه غَضبانُ. قال: فسمِعَ الأشعَثُ بنُ قَيسٍ ابنَ مَسعودٍ يُحدِّثُ هذا، فقال: فيَّ قال ذلك رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، وفي رَجُلٍ، اختَصَمْنا إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ في بِئرٍ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (5240)، وأبو داود (2150)، والترمذي (2792)، والنسائي في ((السنن الكبرى)) (9231) مختصراً، وأحمد (4395) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"5K82BY6S","merged":8,"otherRefs":["تخريج المسند لشعيب 4407 (صحيح)","تخريج صحيح ابن حبان 584 (صحيح)","تخريج مشكل الآثار 1793 (صحيح)","صحيح البخاري 6290 (صحيح)","صحيح الترمذي 2825 (صحيح)","صحيح الأدب المفرد 893 (صحيح)","الأحاديث المختارة 11 / 267 (صحيح)"]},{"id":"س-07348","fp":"b39fa6686edd","stateId":139,"easy":"إذا لم ترد السلام ← بؤت بالإثم","cause":"وإن لم يردَّ علَيهِ","result":"فقد باءَ بالإثْمِ","explicit":true,"star":true,"otherNeedIds":[44],"ref":"فتح الباري لابن حجر 10/511","srcLabel":"البخاري","text":[". .فإن مرَّتْ بي ثلاثةٌ فلقيَهُ فليسلِّم علَيهِ ، فإن ردَّ علَيهِ فقدِ اشترَكا في الأجرِ ، ",["وإن لم يردَّ علَيهِ",1]," ",["فقد باءَ بالإثْمِ",2]," وخرجَ المسلِّمُ منَ الهِجرةِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4912)، والبخاري في ((الأدب المفرد)) (414)، والخرائطي في ((مساويء الأخلاق)) (528) باختلاف يسير.","bab":"فتن › كراهية الاختلاف","dorar":"dgA8LEMe","merged":2,"otherRefs":["صحيح الترغيب 2758 (صحيح)"]},{"id":"س-06772","fp":"cf73becefb32","stateId":139,"easy":"إذا قضيت حاجتك في طريق الناس أو ظلهم ← جلبت على نفسك اللعن","cause":"الَّذي يَتَخَلَّى في طَريقِ المسْلِمينَ، وفي ظِلِّهِمْ","result":"اتَّقوا اللَّاعِنَيْنِ","explicit":true,"otherNeedIds":[44,28],"ref":"المستدرك على الصحيحين 677","srcLabel":"مسلم","text":["«",["اتَّقوا اللَّاعِنَيْنِ",2],"». قالوا: وما اللَّاعِنانِ يا رسولَ اللَّهِ؟ قالَ: «",["الَّذي يَتَخَلَّى في طَريقِ المسْلِمينَ، وفي ظِلِّهِمْ",1],"»."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط مسلم، وله شاهد عن محمد بن سيرين بإسناد صحيح ولفظه غير هذا","takhrij":"أخرجه مسلم (269)، وأبو داود (25)، وأحمد (8853) بنحوه.","bab":"طهارة › إبعاد المتخلي واستتاره","dorar":"JiUh3Mp4","merged":3,"otherRefs":["الأحكام الوسطى 1/ 125 (صحيح)","صحيح ابن خزيمة 1/ 185 (صحيح)"]},{"id":"س-07119","fp":"075e8be431c4","stateId":139,"easy":"إذا أقمت عند أخيك حتى لا يجد ما يقريك به ← توقعه في الإثم","cause":"يُقيمُ عِندَه ولا شيءَ له يَقريه بهِ","result":"يُؤثِمَه","explicit":true,"ref":"صحيح مسلم 48","srcLabel":"متفق عليه","text":["الضِّيافةُ ثَلاثةُ أيَّامٍ، وجائِزَتُه يَومٌ ولَيلةٌ، ولا يَحِلُّ لرَجُلٍ مُسلِمٍ أن يُقيمَ عِندَ أخيه حتَّى يُؤثِمَه، قالوا: يا رَسولَ اللهِ، وكيفَ يُؤثِمُه؟ قال: ",["يُقيمُ عِندَه ولا شيءَ له يَقريه بهِ",1],". وفي روايةٍ: ولا يَحِلُّ لأحَدِكُم أن يُقيمَ عِندَ أخيه حتَّى ",["يُؤثِمَه",2]],"grade":"صحيح","narrator":"أبو شريح العدوي خويلد بن عمرو","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6476)، ومسلم (48).","bab":"علم › حسن السؤال ونصح العالم","dorar":"NVefudfc"},{"id":"س-04932","fp":"7f0fad303a31","stateId":139,"easy":"إذا نظرت داخل بيت أحد قبل أن تستأذن ← فكأنك دخلت","cause":"يَنظُرَ في جَوفِ بَيتِ امرِئٍ حتى يَستأذِنَ","result":"فإنْ نَظَرَ فقد دَخَلَ","explicit":true,"ref":"تخريج المسند لشعيب 22415","srcLabel":"أبو داود","text":["لا يَحِلُّ لامرِئٍ مِن المُسلِمينَ أنْ ",["يَنظُرَ في جَوفِ بَيتِ امرِئٍ حتى يَستأذِنَ",1],"، ",["فإنْ نَظَرَ فقد دَخَلَ",2],"، ولا يَؤمُّ قَومًا فيَختَصُّ نَفْسَه بدُعاءٍ دونهم، فإنْ فَعَلَ فقد خانهم، ولا يُصلِّي وهو حَقِنٌ حتى يَتخفَّفَ."],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح لغيره دون قصة دعاء الإمام لنفسه","takhrij":"أخرجه أبو داود (90)، والترمذي (357)، وأحمد (22415) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"XgnRto0p"},{"id":"س-07574","fp":"7a40d2b701ca","stateId":139,"easy":"إذا دعوت الأغنياء لوليمتك وتركت الفقراء ← فهي شر الولائم","cause":"يُدعَى لها الأغنياءُ ويُتركُ الفقراءُ","result":"شرُّ الولائمِ","explicit":true,"ref":"البدر المنير 8/10","srcLabel":"البدر المنير","text":[["شرُّ الولائمِ",2]," وليمةُ العُرسِ ",["يُدعَى لها الأغنياءُ ويُتركُ الفقراءُ",1]],"grade":"صحيح","muhaddith":"صحيح","bab":"فضائل النبي وصفته ودلائل النبوة › شفقته على أمته","dorar":"5JTgp5AD"},{"id":"س-04830","fp":"166be266c1b2","stateId":139,"easy":"إذا اضطجعت على بطنك ← فهي ضجعة أهل النار","cause":"مُضْطَجِعٌ على بَطْني","result":"إنَّما هذه ضِجْعَةُ أهلِ النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح ابن ماجه 3016","srcLabel":"ابن ماجه","text":["مرَّ بيَ النَّبيُّ صلَّى اللهُ عليه وسلَّم وأنا ",["مُضْطَجِعٌ على بَطْني",1],"، فركَضني برِجْلِه وقال: يا جُنَيْدِبُ، ",["إنَّما هذه ضِجْعَةُ أهلِ النَّارِ",2],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (3724)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"rdYS6nOd"},{"id":"س-00209","fp":"cc5123751093","stateId":139,"easy":"إذا نزلت ضيفاً فلا تطل فوق ثلاث ← حتى لا تُؤثّم أهل المنزل","cause":"وعلى الضَّيفِ أن يرتحِلَ","result":"لا يُؤَثّمُ أهلَ المنزلِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"صحيح الترغيب 2590","srcLabel":"أحمد","text":["للضَّيفِ على من نزل به من الحقِّ ثلاثٌ ، فما زاد فهو صدقةٌ ، ",["وعلى الضَّيفِ أن يرتحِلَ",1]," ؛ ",["لا يُؤَثّمُ أهلَ المنزلِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (7873) مختصراً، والبزار (9674)، وأبو يعلي (6134) باختلاف يسير.","bab":"آداب المجلس › إكرام الضيف","dorar":"ltgl9y0P"},{"id":"س-01658","fp":"e95e26e6a6ea","stateId":139,"easy":"إذا تسخّطت ما قُدّم إليك من الطعام ← فكفى به إثماً","cause":"أن يتسخَّطَ ما قُرِّب إليه","result":"وكفَى بالمرءِ إثمًا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"معجم الشيوخ 2/1001","srcLabel":"أبو داود","text":["نعم الإدامُ الخلُّ ",["وكفَى بالمرءِ إثمًا",2]," ",["أن يتسخَّطَ ما قُرِّب إليه",1]],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"حسن غريب","takhrij":"أخرجه أبو داود (3820)، والترمذي (1839)، والنسائي (3796)، وابن ماجه (3317) مختصراً، وأحمد (14985) باختلاف يسير، وأبو عوانة في ((المسند)) (8371) واللفظ له","bab":"أطعمة › ما يحل من الأطعمة","dorar":"XvYb0DM4"},{"id":"س-01602","fp":"ade5ad429226","stateId":139,"easy":"إذا تركت خصلة من حقوق أخيك الست ← تركت حقاً واجباً له عليك","cause":"لِلْمُسْلِمِ على المسلمِ سِتُّ خِصالٍ ، واجِبَةٍ","result":"فمَنْ تركَ مِنْها خَصْلَةً تركَ حَقًّا واجِبًا لِأَخِيهِ عليهِ","explicit":true,"star":true,"ref":"المطالب العالية 3/111","srcLabel":"متفق عليه","text":["إنَّهُ جَمَعَهُمْ في مَرَاسهِمْ في مَغْزَاهُمْ في البَحْرِ ، ومَرْكَبِ أبي أيوبَ الأنصاريِّ رضيَ اللهُ عنهُ قال : فلمَّا حَضَرَ غَدَاؤُنا أَرْسَلْنا إلى أبي أيوبَ الأنصاريِّ رضيَ اللهُ عنهُ وأهلِ مَرْكَبِه ، فَأَتَانا أبو أيوبَ رضيَ اللهُ عنهُ فقال : إِنَّكُمْ دَعَوْتُمُونِي وأنا صائِمٌ ، وكان عليَّ مِنَ الحَقِّ أنْ أُجِيبَكُمْ ، إنِّي سَمِعْتُ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يقولُ : ",["لِلْمُسْلِمِ على المسلمِ سِتُّ خِصالٍ ، واجِبَةٍ",1]," ",["فمَنْ تركَ مِنْها خَصْلَةً تركَ حَقًّا واجِبًا لِأَخِيهِ عليهِ",2]," : أنْ يُجِيبَهُ إذا دعاهُ ، ويُسَلِّمَ عليهِ إذا لَقِيَهُ ، ويُشَمِّتَهُ إذا عَطَسَ ، ويَعُودَهُ إذا مَرِضَ ، ويُشَيِّعَ جِنازَتَهُ إذا ماتَ ، ويَنْصَحَهُ إذا اسْتَنْصَحَهُ"],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"حسن، وله شاهد في صحيح مسلم","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (922)، والطبراني في ((المعجم الكبير)) (4/ 180) (4076)، والحارث كما في ((بغية الباحث)) (910) واللفظ لهم تامًا.","bab":"أطعمة › إجابة الدعوة","dorar":"PhTgWEad","merged":2,"otherRefs":["صحيح الترغيب 2157 (صحيح)"]},{"id":"س-04814","fp":"4a5cbb7e8ed4","stateId":140,"easy":"إذا كسرت عظم الميت ← فهو كإثم كسره حياً","cause":"كَسْرُ عظمِ الميتِ","result":"مثلُ كَسْرِ عظمِ الحيِّ","explicit":true,"similar":["س-00635"],"ref":"إرواء الغليل 3/214","srcLabel":"أبو داود","text":["سمعتُ عائشةَ تقولُ ",["كَسْرُ عظمِ الميتِ",1]," ",["مثلُ كَسْرِ عظمِ الحيِّ",2]," قال محمدٌ وكان مَوْلىً من أهلِ المدينةِ يُحَدِّثُهُ عن عائشةَ عن النبيِّ صلَّى اللهُ عليهِ وسلَّمَ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (24686) واللفظ له، وأبو داود (3207)، وابن ماجة (1616) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"7SBVisO4","merged":6,"otherRefs":["خلاصة البدر المنير 2/99 (حسن)","تخريج مشكل الآثار 1273 (حسن)","تخريج المسند لشعيب 25645 (حسن)","تخريج مشكل الآثار 1274 (صحيح)","تخريج سنن الدارقطني 3413 (صحيح)"]},{"id":"س-05011","fp":"4ef4c3e250b8","stateId":140,"easy":"إذا جلست على قبر ← فالجلوس على جمرة تحرقك أحب إلى النبي ﷺ من ذلك","cause":"أجلسَ علَى قبرٍ","result":"لَأن أجلسَ على جمرةٍ فتُحْرِقَ ما دونَ لَحمي حتَّى تُفْضيَ إليَّ أحبُّ إليَّ مِن","explicit":true,"ref":"فتح الباري لابن حجر 3/265","srcLabel":"فتح الباري لابن حجر","text":["أن أبا هُرَيْرةَ يقولُ : ",["لَأن أجلسَ على جمرةٍ فتُحْرِقَ ما دونَ لَحمي حتَّى تُفْضيَ إليَّ أحبُّ إليَّ مِن",2]," ",["أجلسَ علَى قبرٍ",1]," قالَ عُثمانُ فرأيتُ خارجةَ بنَ زيدٍ في المقابرِ فذَكَرتُ لَهُ ذلِكَ فأخذَ بيدي"],"grade":"صحيح","narrator":"عبدالله بن سرجس وأبو سلمة بن عبدالرحمن","muhaddith":"إسناده صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"HanQk4Kf","merged":6,"otherRefs":["أحكام الجنائز 267 (صحيح)","صحيح الترغيب 3565 (صحيح)","سبل الهدى والرشاد 8/381 (صحيح)","صحيح الجامع 5042 (صحيح)","صحيح الجامع 5044 (صحيح)"]},{"id":"س-00635","fp":"0cbf305b8749","stateId":140,"easy":"إذا كسرت عظم ميت ← فإثمه ككسره حياً","cause":"كسرُ عظمِ الميِّتِ","result":"ككسرِه حيًّا","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-04814","ref":"الأحكام الشرعية الصغرى 343","text":["أنَّ رسولَ اللهِ – صلَّى اللهُ عليه وسلَّم – قال : ",["كسرُ عظمِ الميِّتِ",1]," ",["ككسرِه حيًّا",2]],"grade":"صحيح","muhaddith":"[أشار في المقدمة أنه صحيح الإسناد]","bab":"آداب عامة › ضرب الأمثال","dorar":"28wbKIoT","merged":3,"otherRefs":["فتح الغفار 741/2 (صحيح)","صحيح الجامع 2143 (صحيح)"]},{"id":"س-00430","fp":"4a2f88983e8e","stateId":141,"easy":"إذا اعتقدت العدوى (بذاتها) ← فهو من أمر الجاهلية","cause":"العَدْوَى","result":"من أمرِ الجاهليَّةِ","explicit":true,"ref":"تخريج سنن أبي داود 6/56","srcLabel":"الترمذي","text":["أربَعٌ في أُمَّتي ",["من أمرِ الجاهليَّةِ",2],"، لن يدَعَهنَّ الناسُ...، وذكر منها: ",["العَدْوَى",1],". قال: أجرَبَ بَعيرٌ، فأجرَبَ مئةَ بَعيرٍ، مَن أجرَبَ البَعيرَ الأولَ؟."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده عند ابن حبان صحيح، وعند الباقين حسن","takhrij":"أخرجه الترمذي (1001) باختلاف يسير، وأحمد (10871) بنحوه","bab":"آداب عامة › الأخلاق المذمومة","dorar":"3yYHa87t"},{"id":"س-00359","fp":"bd9aef2f4817","stateId":141,"easy":"إذا تفاخرت بالأحساب وطعنت في الأنساب واستسقيت بالنجوم ونحت ← فهذا من أمر الجاهلية","cause":"التفاخرُ بالأحسابِ والطعنُ في الأنسابِ والاستسقاءُ بالنجومِ والنياحةُ","result":"من أمرِ الجاهليةِ","explicit":true,"ref":"فتاوى نور على الدرب لابن باز 14/424","srcLabel":"مسلم","text":["أربعٌ في أمتي ",["من أمرِ الجاهليةِ",2]," لا يتركونهنَّ: ",["التفاخرُ بالأحسابِ والطعنُ في الأنسابِ والاستسقاءُ بالنجومِ والنياحةُ",1],"."],"grade":"صحيح","narrator":"[أبو مالك الأشعري]","muhaddith":"صحيح","takhrij":"أخرجه مسلم (934) باختلاف يسير.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"msmxIo4G"},{"id":"س-00378","fp":"a65759a2c1b3","stateId":141,"easy":"إذا نحت أو تعايرت بالأحساب أو نسبت المطر للنجوم ← فهو من أمر الجاهلية","cause":"النِّياحةُ، والتَّعايُرُ في الأحسابِ، وقَولُهم: سُقينا بنَوءِ كذا، والعَدوَى","result":"مِن أمْرِ الجاهليَّةِ","explicit":true,"similar":["س-00387"],"ref":"تخريج المسند لشعيب 10871","srcLabel":"مسلم","text":["أربعٌ لا يَدَعُها النَّاسُ ",["مِن أمْرِ الجاهليَّةِ",2],": ",["النِّياحةُ، والتَّعايُرُ في الأحسابِ، وقَولُهم: سُقينا بنَوءِ كذا، والعَدوَى",1],": جَرِبَ بَعيرٌ فأجرَبَ مِئةً، فمَن أجرَبَ الأوَّلَ؟"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (67) بنحوه مختصراً، وأحمد (10871) واللفظ له","bab":"آداب عامة › الأخلاق المذمومة","dorar":"scAbKyqJ"},{"id":"س-00387","fp":"dee9a857e84e","stateId":141,"easy":"إذا طعنت في الأنساب أو نحت أو نسبت المطر للنجوم ← فهو من أمر الجاهلية","cause":"التَّطاعُنُ في الأنسابِ، والنِّياحَةُ، ومُطِرْنا بنَوْءِ كذا وكذا، والعَدوى","result":"مِن أمْرِ الجاهليَّةِ","explicit":true,"repOf":"س-00378","ref":"تخريج المسند لشعيب 9878","text":["أربعٌ في أُمَّتي.. فذكَرَ الحَديثَ، يَعني نَحوَ حَديثِ محمدِ بنِ جَعفَرٍ [أي حَديثَ: أربَعٌ في أُمَّتي ",["مِن أمْرِ الجاهليَّةِ",2]," لن يَدَعوهُنَّ: ",["التَّطاعُنُ في الأنسابِ، والنِّياحَةُ، ومُطِرْنا بنَوْءِ كذا وكذا، والعَدوى",1],": الرَّجُلُ يَشتَري البَعيرَ الأجرَبَ، فيَجعَلُه في مِئةِ بَعيرٍ فتَجرَبُ، فمَن أعدى الأوَّلَ؟]."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (67) بنحوه مختصراً، وأحمد (9878) واللفظ له","bab":"آداب عامة › الأخلاق المذمومة","dorar":"D5wD7aeZ"},{"id":"س-00370","fp":"718d7d8045ab","stateId":141,"easy":"إذا نحت أو عيّرت في الأنساب أو قلت مُطرنا بنوء كذا ← فهي من الجاهلية","cause":"النِّياحةُ والتَّعايرُ أو التَّعايرُ في الأنسابِ مُطِرْنا بنَوْءِ كذا وكذا والعَدْوى","result":"أربعٌ مِن الجاهليَّةِ","explicit":true,"ref":"صحيح ابن حبان 3142","srcLabel":"الترمذي","text":[["أربعٌ مِن الجاهليَّةِ",2]," لن يدَعَها النَّاسُ: ",["النِّياحةُ والتَّعايرُ أو التَّعايرُ في الأنسابِ مُطِرْنا بنَوْءِ كذا وكذا والعَدْوى",1],": جرِب بعيرٌ في مئةِ بعيرٍ فمَن أعدى الأوَّلَ ؟"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الترمذي (1001) بنحوه، وأحمد (10871) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"aztHqm8L"},{"id":"س-00453","fp":"3666b5f191ce","stateId":141,"easy":"إذا نحت أو استسقيت بالأنواء ← فهي من عمل الجاهلية","cause":"النِّياحَةُ، والاسْتِسْقاءُ بالأَنْواءِ","result":"ثَلاثٌ مِن عَمَلِ أَهْلِ الـجاهِلِيَّةِ","explicit":true,"ref":"الاستذكار 2/ 593","srcLabel":"أحمد","text":["نهى عن النوح [يعني حديث: ",["ثَلاثٌ مِن عَمَلِ أَهْلِ الـجاهِلِيَّةِ",2],"، لا يَتْرُكُهنَّ أَهْلُ الإسلامِ: ",["النِّياحَةُ، والاسْتِسْقاءُ بالأَنْواءِ",1],"، وكذا، قُلتُ لِسعيدٍ: وما هو؟ قال: دَعْوى الـجاهِلِيَّةِ: يا آلَ فُلانٍ، يا آلَ فُلانٍ]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"ثابت","takhrij":"أخرجه أحمد (7560)، وابن حبان (3141) بلفظه.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"ouRh0mqx"},{"id":"س-04767","fp":"03248412a07a","stateId":141,"easy":"إذا رفعت صوتك بلهو ومزامير أو بنياحة وخمش الوجوه عند المصيبة ← فهما صوتان أحمقان فاجران","cause":"صوتٍ عِندَ نَغْمةِ لَهوٍ ولَعِبٍ ومَزاميرِ شيطانٍ، وصوتٍ عِندَ مصيبةِ خَمْشِ وُجوهٍ، وشقِّ جُيوبٍ، ورنَّةِ الشَّيطانِ","result":"نَهَيْتُ عَنْ صوتَيْنِ أحمقَيْنِ فاجرَيْنِ","explicit":true,"star":true,"otherNeedIds":[27,28],"ref":"النوافح العطرة 411","srcLabel":"البيهقي","text":["من لا يرحمْ لا يُرْحَمُ [يعني حديث: أخَذَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ بيَدِ عبدِ الرَّحمنِ بنِ عَوفٍ حتَّى أتى بِهِ النَّخْلَ، فإذا هُوَ بإبراهيمَ ابنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ في حِجْرِ أُمِّهِ، وهو يَجُودُ بنَفْسِهِ ، فذَرَفَتْ عَيْناهُ صلَّى اللهُ عليه وسلَّمَ، فبَكى، فقالَ لَهُ عبدُ الرَّحمنِ: يا رسولَ اللهِ، تَبْكي؟! ألَمْ تَنْهَ عَنِ البكاءِ؟! فقالَ: إنَّما ",["نَهَيْتُ عَنْ صوتَيْنِ أحمقَيْنِ فاجرَيْنِ",2],": ",["صوتٍ عِندَ نَغْمةِ لَهوٍ ولَعِبٍ ومَزاميرِ شيطانٍ، وصوتٍ عِندَ مصيبةِ خَمْشِ وُجوهٍ، وشقِّ جُيوبٍ، ورنَّةِ الشَّيطانِ",1],"، وهذِهِ رحمةٌ، ومَن لا يَرْحَمْ لا يُرْحَمْ. يا إبراهيمُ، لَوْلا أنَّهُ قولٌ حقٌّ، ووعدٌ صادقٌ، وسبيلٌ مَأْتِيَّةٌ، وأنَّ آخِرَنا يَلْحَقُ بأوَّلِنا، لَحَزِنَّا عليكَ حزنًا هو أشدُّ مِن هَذا، وإنَّا بِكَ لَمَحْزونونَ، تَبْكي العَينُ، ويَوْجَلُ القلبُ، ولا نقولُ ما يُسخِطُ الرَّبَّ.]"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي شيبة (25876) واللفظ له، وعبد بن حميد (1004)، والبيهقي (7402) مطولا","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"M8oPeX4U","merged":8,"otherRefs":["صحيح الجامع 5194 (صحيح)","السلسلة الصحيحة 1/790 (حسن)","صحيح الترمذي 1005 (حسن)","نخب الافكار 13/511 (حسن)","الجامع الصغير 5033 (صحيح)","الأحاديث المختارة 2200 (صحيح)","الأحاديث المختارة 2201 (صحيح)"]},{"id":"س-06056","fp":"485bc264cd8b","stateId":141,"easy":"إذا حزنت وسخطت على القدر ← تأثم وتؤزر","cause":"وإنْ تَحزَنوا وتَسخَطوا","result":"تَأثُموا وتُؤزَروا","explicit":true,"ref":"مجمع الزوائد 2/328","srcLabel":"مجمع الزوائد","text":["سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ونظَرَ النَّبيُّ صلَّى اللهُ عليه وسلَّم إلى مَلَكِ المَوتِ عليه السَّلامُ عندَ رأسِ رَجُلٍ من الأنصارِ فقال: يا مَلَكَ المَوتِ، ارفُقْ بصاحِبي، فإنَّه مُؤمِنٌ، فقال مَلَكُ المَوتِ عليه السَّلامُ: طِبْ نَفْسًا وقَرَّ عَينًا، واعلَمْ أنِّي بكل مُؤمِنٍ رفيقٌ، واعلَمْ يا مُحمَّدُ أنِّي لأقبِضُ رُوحَ ابنِ آدَمَ، فإذا صرَخَ صارِخٌ من أهلِه، قُمتُ في الدَّارِ ومعي رُوحُه، فقُلتُ: ما هذا الصَّارخُ؟ واللهِ ما ظَلَمْناه، ولا سَبَقْنا أجَلَه، ولا استَعْجَلْنا قَدَرَه، وما لنا في قَبضِه من ذَنْبٍ، فإنْ تَرْضَوْا بما صنَعَ اللهُ تُؤجَروا، ",["وإنْ تَحزَنوا وتَسخَطوا",1]," ",["تَأثُموا وتُؤزَروا",2],"، ما لكم عندَنا منه [عُتبى، وإنَّ لنا عندَكم بعدُ عَودَةً وعَودَةً]، فالحَذَرُ الحَذَرُ، وما من أهلِ بَيتٍ يا مُحمَّدُ شَعَرٌ ولا مَدَرٌ، بَرٌّ ولا بَحْرٌ، سَهْلٌ ولا جَبَلٌ إلَّا أنا أتصفَّحُهم في كُلِّ يَومٍ ولَيلَةٍ حتى لأنا أعرَفُ بصَغيرِهم وكَبيرِهم منهم بأنْفُسِهم، واللهِ يا مُحمَّدُ لو أرَدتُ أقبِضُ رُوحَ بَعوضَةٍ ما قَدَرتُ على ذلك حتى يكونَ اللهُ هو أَذِنَ بقَبْضِها، قال جَعفَرُ بنُ مُحمَّدٍ: بَلَغَني أنَّه إنَّما يتصفَّحُهم عندَ مَواقيتِ الصَّلاةِ، فإذا نظَرَ عندَ المَوتِ، فمَن كان يُحافِظُ على الصَّلواتِ، دَنا منه المَلَكُ وطَرَدَ عنه الشَّيطانَ، ويُلقِّنُه المَلَكُ لا إلهَ إلَّا اللهُ، مُحمَّدٌ رسولُ اللهِ، وذلك الحالُ العظيمُ."],"grade":"صحيح","narrator":"الخزرج والد الحارث","muhaddith":"فيه عمر بن شمر الجعفي والحارث بن الخزرج ولم أجد من ترجمهما وبقية رجاله رجال الصحيح","bab":"رقائق وزهد › فضل الصبر","dorar":"qxgiGeUr"},{"id":"س-04978","fp":"5ab5c0646a3c","stateId":142,"easy":"إذا احتكرت الطعام في الحرم ← فهو إلحاد فيه","cause":"احْتِكارُ الطَّعامِ في الحَرَمِ","result":"إلْحادٌ فيه","explicit":true,"ref":"الأحكام الوسطى 2/ 341","srcLabel":"البخاري","text":[["احْتِكارُ الطَّعامِ في الحَرَمِ",1]," ",["إلْحادٌ فيه",2],"."],"grade":"صحيح","narrator":"يعلى بن أمية","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (2020)، والبخاري في ((التاريخ الكبير)) (7/ 255) واللفظ لهما.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"5QG9wJM2"},{"id":"س-01263","fp":"c1c87e481a9b","stateId":142,"easy":"إذا بقيت عزباً بلا حاجة ← تكون من شرار الناس","cause":"عزَّابُكم","result":"شرارُكم","explicit":true,"ref":"الجامع الصغير 4850","srcLabel":"الجامع الصغير","text":[["شرارُكم",2]," ",["عزَّابُكم",1]," وأراذِلُ موتاكم عزَّابُكُم"],"grade":"صحيح","narrator":"عطية بن بسر وأبو ذر","muhaddith":"صحيح","bab":"نكاح › الحث على التزويج","dorar":"bXlAuO7I","merged":3,"otherRefs":["النكت على الموضوعات 145 (حسن)","فيض القدير 4/ 157 (حسن)"]},{"id":"س-03387","fp":"21fbb752e5a0","stateId":142,"easy":"إذا اغتنمت ظلمة الليل وغفلة الناس في المعاصي ← فهو عليك لا لك","cause":"فَرجلٌ اغْتَنَمَ ظُلْمَةَ الليلِ وغفلةَ الناسِ فركبَ فرسَهُ في المعاصِي","result":"فذلكَ عليهِ ولا لهُ","explicit":true,"ref":"صحيح الترغيب 633","srcLabel":"أبو داود","text":["قال سلمانُ : حافِظُوا على هذه الصلواتِ الخمسِ ، فإنَّهُنَّ كَفَّارَاتٌ لِهَذِهِ الجِرَاحاتِ ، ما لمْ تُصِبِ المَقْتَلَةَ ، فإذا صلَّى الناسُ العِشاءَ صَدَرُوا عن ثلاثِ منازلٍ ، مِنْهُمْ مَنْ عليهِ ولا لهُ ، ومِنْهُمْ مَنْ لهُ ولا عليهِ ، ومِنْهُمْ مَنْ لا لهُ ولا عليهِ : ",["فَرجلٌ اغْتَنَمَ ظُلْمَةَ الليلِ وغفلةَ الناسِ فركبَ فرسَهُ في المعاصِي",1]," ، ",["فذلكَ عليهِ ولا لهُ",2]," ، ومن لهُ ولا عليهِ فَرجلٌ أغْتَنَمَ ظُلْمَةَ الليلِ وغَفْلَةَ الناسِ فقامَ يصلِّي ، فذلكَ لهُ ولا عليهِ ، ومَنْ لا لهُ ولا عليهِ : فَرجلٌ صلَّى ثُمَّ نامَ ، فذلكَ لا لهُ ولا عليهِ ، إِيَّاكَ والحَقْحَقَةَ ، وعليكَ بِالقَصْدِ ، وداومْ"],"grade":"صحيح","narrator":"طارق بن شهاب","muhaddith":"صحيح لغيره","takhrij":"أخرجه عبد الرزاق (148)، وأبو داود في ((الزهد)) (256)، والطبراني في ((المعجم الكبير)) (6/ 217) (6051) بنحوه.","bab":"استغفار › أسباب المغفرة","dorar":"r0MO4bjA"},{"id":"س-07075","fp":"08b5b6e2ccb1","stateId":142,"easy":"إذا ساء خلقك ← يفسد خلقك السيء أخلاقك الحسنة","cause":"وخلقٌ سيِّءٌ","result":"فيُفسدُ الخلقُ السَّيِّءُ الأخلاقَ الحسَنةَ","explicit":true,"ref":"عمدة التفسير 1/733","srcLabel":"الحاكم","text":["خرجنا حُجَّاجًا ، فَكُنَّا إذا صلَّينا الغداةَ اقتَدنا رواحلَنا نَتماشى نتَحدَّثُ ، قالَ : فبينَما نحنُ ذاتَ غداةٍ إذ سنحَ لَنا ظبيٌ - أو : برِحَ - فرماهُ رجلٌ كانَ معَنا بحجَرٍ ، فما أخطأَ خُشَّاه فرَكِبَ دِرعه ميِّتًا ، قالَ : فعظَّمنا عليهِ ، فلمَّا قدمنا مَكَّةَ خَرجتُ معَهُ حتَّى أتينَا عمرَ بن الخطاب ، فقصَّ عليهِ القصَّةَ قالَ : وإلى جنبِهِ رجلٌ كأنَّ وجهَهُ قَلب فضَّةٍ - يعني عبدَ الرَّحمنِ بنَ عوفٍ - فالتَفتَ عمرُ إلى صاحبِهِ فَكَلَّمَهُ قالَ : ثمَّ أقبلَ على الرَّجلِ فقالَ : أعمدًا قتلتَهُ أم خطأً ؟ قالَ الرَّجلُ : لقد تعمَّدتُ رميَهُ ، وما أردتُ قتلَهُ . فقالَ عمرُ : ما أراكَ إلَّا قد أشرَكْتَ بينَ العمدِ والخطأِ ، اعمِد إلى شاةٍ فاذبَحها فتصدَّق بلَحمِها واستبقِ إِهابَها . قالَ : فقُمنا من عندِهِ ، فقلتُ لصاحبي : أيُّها الرَّجلُ ، عظِّم شعائرَ اللَّهِ ، فما درى أميرُ المؤمنينَ ما يُفتيكَ حتَّى سألَ صاحبَهُ : اعمَد إلى ناقتِكَ فانحَرها ، فلعلَ ذاكَ يعني أن يجزئَ عنكَ . قالَ قَبيصةُ : ولا أذكرُ الآيةَ من سورةِ المائدةِ : ويَحْكُمُ بِهِ ذَوَا عَدْلٍ مِنْكُمْ فبلغَ عمرَ مقالتي ، فلم يفجأنا منهُ إلَّا ومعَهُ الدِّرَّةُ . قالَ : فعلا صاحِبي ضربًا بالدِّرَّةِ ، أقتلتَ في الحرمِ وسفَّهتَ الحَكَمَ ؟ قالَ : ثمَّ أقبلَ عليَّ فقلتُ : يا أميرَ المؤمنينَ ، لا أحلُّ لَكَ اليومَ شيئًا يحرُمُ عليكَ منِّي ، فقالَ : يا قَبيصةَ بنَ جابرٍ ، إنِّي أراكَ شابَّ السِّنِّ ، فَسيحَ الصَّدرِ ، بيِّنَ اللِّسانِ ، وإنَّ الشَّابَّ يَكونُ فيهِ تِسعةُ أخلاقٍ حسَنةٍ ",["وخلقٌ سيِّءٌ",1]," ، ",["فيُفسدُ الخلقُ السَّيِّءُ الأخلاقَ الحسَنةَ",2]," ، فإيَّاكَ وعثَراتِ الشَّبابِ"],"grade":"صحيح","narrator":"قبيصة بن جابر","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبري في ((التفسير)) (12588) بلفظه، ووالطبراني (1/ 127)، (258)، والحاكم (5355) كلاهما باختلاف يسير.","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"I64bdTgb"},{"id":"س-04913","fp":"c75133719625","stateId":142,"easy":"إذا لم تستحِ من الناس ← لا تستحي من الله","cause":"مَن لا يستَحيِ من النَّاسِ","result":"لا يستَحيِ من اللهِ","explicit":true,"ref":"الجامع الصغير 9076","srcLabel":"الطبراني","text":[["مَن لا يستَحيِ من النَّاسِ ، ",1],["لا يستَحيِ من اللهِ",2],"."],"grade":"حسن","narrator":"أنس","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((الأوسط)) (7159) واللفظ له.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"u4z8a4br"},{"id":"س-06181","fp":"50ce8054e17f","stateId":142,"easy":"إذا صليت وزكيت وسمعت لكن عصيت ← فأمرك إلى الله إن شاء رحمك وإن شاء عذبك","cause":"وأقام الصلاةَ وآتَى الزكاةَ وسمِعَ وعصَى","result":"من أمرِه بالخيارِ إنْ شاء رحِمه و إن شاء عذَّبه","explicit":true,"ref":"مجمع الزوائد 5/219","srcLabel":"أحمد","text":["من عبدَ اللهَ تبارَك وتعالَى لا يشركُ به شيئًا فأقام الصلاةَ وآتَى الزكاةَ وسمع وأطاع فإن اللهَ تبارَك وتعالَى يُدخِلُه من أيِّ أبوابِ الجنةِ شاء ولها ثمانيةُ أبوابٍ ومن عبدَ اللهَ تبارَكَ وتعالَى لا يشركُ به شيئًا ",["وأقام الصلاةَ وآتَى الزكاةَ وسمِعَ وعصَى",1]," فإن اللهَ تباركَ وتعالَى ",["من أمرِه بالخيارِ إنْ شاء رحِمه و إن شاء عذَّبه",2]],"grade":"حسن","narrator":"عبادة بن الصامت","muhaddith":"رجاله ثقات","takhrij":"أخرجه أحمد (22768)، وابن أبي عاصم في ((السنة)) (968)، والبزار (2704) واللفظ لهم.","bab":"زكاة › فرض الزكاة","dorar":"rb6guJaq"},{"id":"س-02332","fp":"007784467e39","stateId":142,"easy":"إذا ذُكر النبي ﷺ عندك فلم تصلّ عليه ← فهو من الجفاء","cause":"أُذكَرَ عِندَ الرَّجُلِ فلا يُصَلِّي عَلَيَّ","result":"مِنَ الجَفاءِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"فيض القدير 6/ 7","srcLabel":"فيض القدير","text":[["مِنَ الجَفاءِ",2]," أن ",["أُذكَرَ عِندَ الرَّجُلِ فلا يُصَلِّي عَلَيَّ",1]],"grade":"حسن","narrator":"قتادة","muhaddith":"رواته ثقات","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"2w6Ijw6K"},{"id":"س-05248","fp":"7182f941495f","stateId":142,"easy":"إذا ألحدت (ظلمت وعصيت) في البلد الحرام ← فهو من الكبائر","cause":"الإلحادُ بالبلدِ الحرامِ","result":"في الكبائر","explicit":true,"star":true,"ref":"تخريج شرح السنة 1/86","srcLabel":"البغوي","text":["[",["في الكبائر",2]," ] عن عبدِ اللهِ بنِ عُمَرَ قال: ",["الإلحادُ بالبلدِ الحرامِ",1],"."],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"WfrpTthu"},{"id":"س-02344","fp":"9cf431987d75","stateId":142,"easy":"إذا أخطأت بمكة ← فخطيئتك فيها أعظم من سبعين في غيرها (أثر عمر)","cause":"خَطيئةٌ أُصيبُها بمكَّةَ","result":"أعَزُّ علَيَّ من سَبعين خَطيئةً بغَيرِها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"فضائل بيت الله الحرام 179","srcLabel":"فضائل بيت الله الحرام","text":["عن عُمَرَ أنَّه قال: ",["خَطيئةٌ أُصيبُها بمكَّةَ",1]," ",["أعَزُّ علَيَّ من سَبعين خَطيئةً بغَيرِها",2],"."],"grade":"صحيح","muhaddith":"[ثابت]","bab":"إحسان › الحسنات والسيئات","dorar":"3tPexMa2"},{"id":"س-00439","fp":"d8fff698cc1d","stateId":143,"easy":"إذا أعنت قومك على غير الحق ← فأنت كالبعير سقط في بئر وهو يُجرّ بذنبه","cause":"الذي يُعينُ عشيرتَهُ على غيرِ الحقِّ","result":"مثلُ البعيرِ رُدِّيَ في بئرٍ فهو يمُدُّ بذَنَبِهِ","explicit":true,"similar":["س-08014","س-08051"],"otherNeedIds":[57],"ref":"تخريج المسند لشاكر 5/275","srcLabel":"أبو داود","text":["مثلُ ",["الذي يُعينُ عشيرتَهُ على غيرِ الحقِّ",1]," ",["مثلُ البعيرِ رُدِّيَ في بئرٍ فهو يمُدُّ بذَنَبِهِ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح إلا أن شعبة شك في رفعه","takhrij":"أخرجه أبو داود (5117)، وأحمد (3726) واللفظ له","bab":"آداب عامة › الأخلاق المذمومة","dorar":"Bte6Rjgy"},{"id":"س-08007","fp":"6916f1f5619a","stateId":143,"easy":"إذا أعنت على خصومة بظلم ← بؤت بغضب من الله","cause":"ومَن أعانَ على خُصومةٍ بظُلمٍ","result":"فقد باءَ بغَضَبٍ مِنَ اللهِ","explicit":true,"otherNeedIds":[28],"ref":"تخريج سنن أبي داود 3598","srcLabel":"ابن ماجه","text":["عنِ النَّبيِّ صلَّى اللَّهُ عليه وسلَّمَ، بمَعناه، قال: ",["ومَن أعانَ على خُصومةٍ بظُلمٍ، ",1],["فقد باءَ بغَضَبٍ مِنَ اللهِ",2]," عزَّ وجلَّ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (2320) بنحوه، وأحمد (5544) مطولاً بنحوه","bab":"مظالم › تحريم الظلم","dorar":"inqoWlI5"},{"id":"س-08014","fp":"e3ad6d9aca57","stateId":143,"easy":"إذا أعنت قومك على ظلم ← فأنت كالبعير المتردي يُنزع بذنبه","cause":"من أعان قومَه على ظُلمٍ","result":"فهوَ كالبعيرِ المُترَدِّي يَنْزِعُ بذَنَبِهِ","explicit":true,"repOf":"س-00439","ref":"تخريج المسند لشاكر 6/144","text":[["من أعان قومَه على ظُلمٍ ",1],["فهوَ كالبعيرِ المُترَدِّي يَنْزِعُ بذَنَبِهِ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (4292)، والشاشي في ((المسند للشاشي)) واللفظ لهما، وأبو داود (5117)، بلفظ مقارب.","bab":"مظالم › تحريم الظلم","dorar":"AN6IXua0"},{"id":"س-08051","fp":"60bffa178ed6","stateId":143,"easy":"إذا نصرت قومك على غير الحق ← فأنت كالبعير الساقط يُنزع بذنبه","cause":"مَن نَصَرَ قَومَه على غَيرِ الحقِّ","result":"فهو كالبَعيرِ الذي ردِيَ فهو يُنزَعُ بذَنَبِه","explicit":true,"repOf":"س-00439","ref":"صحيح أبي داود 5118","text":["عن أبيه قال انتَهَيتُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، وهو في قُبَّةٍ من أدَمٍ، فذكَرَ نحوَه [",["مَن نَصَرَ قَومَه على غَيرِ الحقِّ ",1],["فهو كالبَعيرِ الذي ردِيَ فهو يُنزَعُ بذَنَبِه",2],"]."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5118) واللفظ له، والطيالسي (342)، والبزار (2013) باختلاف يسير.","bab":"مظالم › تحريم الظلم","dorar":"kSMa31fl"},{"id":"س-04979","fp":"890d4521cf3f","stateId":143,"easy":"إذا كتمت على غالّ ← فأنت مثله","cause":"مَن كَتَمَ غالًّا","result":"فإنَّه مِثلُه","explicit":true,"ref":"الأحكام الوسطى 3/80","srcLabel":"أبو داود","text":["أمَّا بَعْدُ، وكانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: \"",["مَن كَتَمَ غالًّا",1]," ",["فإنَّه مِثلُه",2],"."],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (2716)، والطبراني (7024) (7/  251) واللفظ لهما","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"p81lTh0r","merged":2,"otherRefs":["هداية الرواة 4/85 (حسن)"]},{"id":"س-00393","fp":"e6b34efaa91e","stateId":143,"easy":"إذا اشتريت مسروقاً وأنت تعلم ← تشترك في عاره وإثمه","cause":"مَنِ اشْتَرى سَرِقةً، وهو يَعلمُ أنَّها سَرِقةٌ","result":"فقد شُرِكَ في عارِها وإثمِها","explicit":true,"ref":"المستدرك على الصحيحين 2287","srcLabel":"البيهقي","text":[["مَنِ اشْتَرى سَرِقةً، وهو يَعلمُ أنَّها سَرِقةٌ، ",1],["فقد شُرِكَ في عارِها وإثمِها",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه إسحاق في ((مسنده)) (413)، والبيهقي في ((الشعب)) (5112) واللفظ لهما، والحارث كما في ((بغية الباحث)) (205) في أثناء حديث طويل.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"LBpAru2D"},{"id":"س-04786","fp":"b1ebe7e13d90","stateId":143,"easy":"إذا سترت على من يغلّ (يختلس من المال العام) ← فأنت مثله","cause":"مَن كتَم على غالٍّ","result":"فهو مِثلُه","explicit":true,"ref":"فيض القدير 6/ 212","srcLabel":"فيض القدير","text":[["مَن كتَم على غالٍّ ",1],["فهو مِثلُه",2]],"grade":"حسن","narrator":"سمرة","muhaddith":"رمز السيوطي لحسنه وهو كما قال أو أعلى فقد قالوا: رجاله ثقات","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"lnnnLM4b"},{"id":"ق-0235","fp":"6713ca45d0ca","stateId":143,"easy":"الشفاعة السيئة ← كِفل (وزر) منها","cause":"الشفاعة السيئة","result":"كِفل (وزر) منها","explicit":true,"ref":"سورة النساء: 85","srcLabel":"القرآن الكريم","quran":{"s":4,"from":85,"to":85,"text":"مَنْ يَشْفَعْ شَفَاعَةً حَسَنَةً يَكُنْ لَهُ نَصِيبٌ مِنْهَا وَمَنْ يَشْفَعْ شَفَاعَةً سَيِّئَةً يَكُنْ لَهُ كِفْلٌ مِنْهَا وَكَانَ اللَّهُ عَلَى كُلِّ شَيْءٍ مُقِيتًا (85)","hl":[[61,167,1]]}},{"id":"ق-0264","fp":"6ff0b60492ab","stateId":143,"easy":"القعود مع المستهزئين بآيات الله ← يكون مثلهم","cause":"القعود مع المستهزئين بآيات الله","result":"يكون مثلهم","explicit":true,"otherNeedIds":[69],"ref":"سورة النساء: 140","srcLabel":"القرآن الكريم","quran":{"s":4,"from":140,"to":140,"text":"وَقَدْ نَزَّلَ عَلَيْكُمْ فِي الْكِتَابِ أَنْ إِذَا سَمِعْتُمْ آيَاتِ اللَّهِ يُكْفَرُ بِهَا وَيُسْتَهْزَأُ بِهَا فَلَا تَقْعُدُوا مَعَهُمْ حَتَّى يَخُوضُوا فِي حَدِيثٍ غَيْرِهِ إِنَّكُمْ إِذًا مِثْلُهُمْ إِنَّ اللَّهَ جَامِعُ الْمُنَافِقِينَ وَالْكَافِرِينَ فِي جَهَنَّمَ جَمِيعًا (140)","hl":[[114,204,1]]}},{"id":"س-07463","fp":"b4bd379fee21","stateId":143,"easy":"إذا خشيت الناس فلم تقل الحق ← فالله أحق أن تخشاه","cause":"خشيةَ الناسِ","result":"فإيَّاي كنتَ أحقَّ أن تَخشى","explicit":true,"otherNeedIds":[16],"ref":"إتحاف الخيرة المهرة 8/26","srcLabel":"ابن ماجه","text":["لا يُحَقِّرَنَّ أحدُكم نفسَه قالوا: وكيف يُحَقِّرُ نفسَه ؟ قال: أن يَرى أمرًا للهِ فيه مقالٌ فلا يقولُ به  فيَلقى اللهَ تبارَك وتعالى وقد أضاع ذلك  فيقولُ: ما منَعكَ ؟ فيقولُ: ",["خشيةَ الناسِ",1]," فيقولُ: ",["فإيَّاي كنتَ أحقَّ أن تَخشى",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"سنده صحيح","takhrij":"أخرجه ابن ماجه (4008)، وأحمد (11255) باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"YfnlWTU5","merged":4,"otherRefs":["الفتح الرباني 11/5448 (حسن)","عمدة التفسير 1/701 (صحيح)","تخريج المسند لشعيب 17/313 (حسن)"]},{"id":"س-08063","fp":"ff8e4c1241fb","stateId":143,"easy":"إذا غبت عن المعصية فرضيتها ← فأنت كمن شهدها","cause":"مَن غابَ عنها فرَضِيَها","result":"كمَن شَهِدَها","explicit":true,"ref":"الأحكام الوسطى 4/ 271","srcLabel":"أبو داود","text":["\"إذا عُمِلَتِ الخَطيئةُ في الأرْضِ كانَ مَن شَهِدَها فكَرِهَها -وقالَ مَرَّةً: فأَنكَرَها- كانَ كمَن غابَ عنها، و",["مَن غابَ عنها فرَضِيَها",1]," ",["كمَن شَهِدَها",2],"\"."],"grade":"صحيح","narrator":"العرس بن عميرة الكندي","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (4345)، وابن قانع ((معجم الصحابة)) (2/  309)، وأبو نعيم الأصبهاني في ((تاريخ أصبهان)) (1/  391) واللفظ لهم","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"j27vdZss"},{"id":"س-00493","fp":"a374dbfd8b9f","stateId":144,"easy":"إذا وقعت في الشبهات ← توشك أن تقع في الحرام","cause":"ومَن وقَعَ في الشُّبُهاتِ","result":"وقَعَ في الحَرامِ، كالرَّاعي يَرعى حَولَ الحِمى، يوشِكُ أن يَرتَعَ فيه","explicit":true,"star":true,"ref":"صحيح مسلم 1599","srcLabel":"متفق عليه","text":["سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ -وأهوى النُّعمانُ بإصبَعَيه إلى أُذُنَيه-: إنَّ الحَلالَ بَيِّنٌ، وإنَّ الحَرامَ بَيِّنٌ، وبينَهما مُشتَبِهاتٌ لا يَعلَمُهنَّ كَثيرٌ مِنَ النَّاسِ، فمَنِ اتَّقى الشُّبُهاتِ استَبرَأ لدينِه وعِرضِه، ",["ومَن وقَعَ في الشُّبُهاتِ",1]," ",["وقَعَ في الحَرامِ، كالرَّاعي يَرعى حَولَ الحِمى، يوشِكُ أن يَرتَعَ فيه",2],"، ألا وإنَّ لكُلِّ مَلِكٍ حِمًى، ألا وإنَّ حِمى اللهِ مَحارِمُه، ألا وإنَّ في الجَسَدِ مُضغةً إذا صَلَحَت صَلَحَ الجَسَدُ كُلُّه، وإذا فسَدَت فسَدَ الجَسَدُ كُلُّه، ألا وهي القَلبُ."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (52)، ومسلم (1599).","bab":"آداب عامة › ضرب الأمثال","dorar":"3ItFLlck","merged":2,"otherRefs":["حلية الأولياء 8/144 (صحيح)"]},{"id":"س-05134","fp":"3700fadc3ba0","stateId":144,"easy":"إذا رعيت حول الحمى ← توشك أن تقع فيه","cause":"مَن يَرْعَ حولَ الحِمَى","result":"يُوشِكُ أنْ يُخالِطَ الحِمى","explicit":true,"star":true,"ref":"تخريج سير أعلام النبلاء 6/372","srcLabel":"متفق عليه","text":["إنَّ الحَلالَ بَيِّنٌ، وإنَّ الحَرامَ بَيِّنٌ، وبينَ ذلك أمورٌ مُشتَبِهاتٌ -وربَّما قال: مُشتَبِهةٌ- وسأضرِبُ لكم في ذلك مَثلًا: إنَّ اللهَ حَمى حِمًى، وإنَّ حِمى اللهِ ما حرَّمَ اللهُ، وإنَّه ",["مَن يَرْعَ حولَ الحِمَى",1]," ",["يُوشِكُ أنْ يُخالِطَ الحِمى",2]," -وربَّما قال: مَن يُخالِطُ الرِّيبةَ، يوشِكُ أنْ يَجسُرَ."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"إسناده صحيح","takhrij":"أخرجه الذهبي في ((سير أعلام النبلاء)) (6/ 372) بلفظه، والبخاري (52)، ومسلم (1599) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"UpGPFlnO","merged":7,"otherRefs":["إرشاد الفحول 2/284 (صحيح)","تخريج مشكل الآثار 749 (صحيح)","حلية الأولياء 4/298 (صحيح)","حلية الأولياء 5/121 (صحيح)","صحيح الجامع 152 (صحيح)","الفتح الرباني 4/1818 (صحيح)"]},{"id":"س-05135","fp":"11f6b5ac8b78","stateId":144,"easy":"إذا خالطت الريبة ← توشك أن تتجرأ على الحرام","cause":"مَن يُخالِطُ الرِّيبةَ","result":"يوشِكُ أنْ يَجسُرَ","explicit":true,"ref":"تخريج سير أعلام النبلاء 6/372","srcLabel":"متفق عليه","text":["إنَّ الحَلالَ بَيِّنٌ، وإنَّ الحَرامَ بَيِّنٌ، وبينَ ذلك أمورٌ مُشتَبِهاتٌ -وربَّما قال: مُشتَبِهةٌ- وسأضرِبُ لكم في ذلك مَثلًا: إنَّ اللهَ حَمى حِمًى، وإنَّ حِمى اللهِ ما حرَّمَ اللهُ، وإنَّه مَن يَرْعَ حولَ الحِمَى يُوشِكُ أنْ يُخالِطَ الحِمى -وربَّما قال: ",["مَن يُخالِطُ الرِّيبةَ",1],"، ",["يوشِكُ أنْ يَجسُرَ",2],"."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"إسناده صحيح","takhrij":"أخرجه الذهبي في ((سير أعلام النبلاء)) (6/ 372) بلفظه، والبخاري (52)، ومسلم (1599) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"UpGPFlnO"},{"id":"س-05301","fp":"6bbac7358fdf","stateId":144,"easy":"إذا تجرأت على ما تشك فيه من الإثم ← أوشكت أن تقع في الحرام البيّن","cause":"ومَنِ اجتَرَأ على ما يَشُكُّ فيه مِنَ الإثمِ","result":"أوشَك أن يواقِعَ ما استَبانَ، والمَعاصي حِمى اللهِ","explicit":true,"ref":"صحيح البخاري 2051","srcLabel":"مسلم","text":["الحَلالُ بَيِّنٌ، والحَرامُ بَيِّنٌ، وبينَهما أُمورٌ مُشتَبِهةٌ، فمَن تَرَك ما شُبِّهَ عليه مِنَ الإثمِ كان لما استَبانَ أترَكَ، ",["ومَنِ اجتَرَأ على ما يَشُكُّ فيه مِنَ الإثمِ ",1],["أوشَك أن يواقِعَ ما استَبانَ، والمَعاصي حِمى اللهِ، ",2],"مَن يَرتَعْ حَولَ الحِمى يوشِكْ أن يواقِعَه."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1599) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مواقعة الحدود وانتهاك المحارم","dorar":"kbZKWXl6"},{"id":"س-00574","fp":"fe7675605966","stateId":144,"easy":"إذا اقتربت من الحرام وخالطت الريبة ← توشك أن تقع فيه","cause":"مَن يرتَعْ حولَ الحِمى","result":"يوشِكْ أنْ يرتَعَ - وإنَّ مَن خالَط الرِّيبةَ يوشِكُ أنْ يجسُرَ","explicit":true,"ref":"تخريج صحيح ابن حبان 721","srcLabel":"ابن حبان","text":["الحلالُ بيِّنٌ والحرامُ بيِّنٌ وبَيْنَ ذلكَ أمورٌ مُشتبِهةٌ - وربَّما قال : مُتشابِهةٌ - وسأضرِبُ لكم في ذلك مَثَلًا : إنَّ اللهَ حَمَى حِمًى وإنَّ حِمى اللهِ محارِمُه وإنَّه مَن يرتَعْ حولَ الحِمى يوشِكْ أنْ يُخالِطَ الحِمَى - وربَّما قال : ",["مَن يرتَعْ حولَ الحِمى ",1],["يوشِكْ أنْ يرتَعَ - وإنَّ مَن خالَط الرِّيبةَ يوشِكُ أنْ يجسُرَ",2]],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"إسناده صحيح على شرط الشيخين","bab":"آداب عامة › ضرب الأمثال","dorar":"2080yyT9"},{"id":"س-00449","fp":"f55a8da1871e","stateId":145,"easy":"إذا كتمت المعروف (لم تشكره) ← فقد كفرته","cause":"وإنْ كتَمَه","result":"فقد كَفَرَه","explicit":true,"star":true,"similar":["س-05507"],"ref":"تخريج شرح السنة 3609","srcLabel":"البخاري","text":["مَن صُنِعَ إليه مَعْروفٌ، فلْيَجْزِ به؛ فإنْ لم يَجِدْ ما يَجْزي به، فلْيُثْنِ عليه؛ فإنَّه إذا أثْنى عليه، فقد شكَرَه، ",["وإنْ كتَمَه",1],"، ",["فقد كَفَرَه",2],"، ومَن تَحَلَّى بما لم يُعْطَ، كان كلابِسِ ثَوبَيْنِ من زُورٍ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح بطرقه","takhrij":"أخرجه البغوي في ((شرح السنة)) (13/ 186) واللفظ له، والبخاري في ((الأدب المفرد)) (215) باختلاف يسير، والترمذي (2034) بنحوه، وأبو داود (4813) مختصرًا.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"qXCJmr7W","merged":5,"otherRefs":["الجامع الصغير 8464 (صحيح)","تخريج سنن أبي داود 4813 (حسن)","الأحاديث المختارة 836 (صحيح)","صحيح الأدب المفرد 157 (صحيح)"]},{"id":"س-01302","fp":"f1b87a750250","stateId":145,"easy":"إذا تعلمت الرمي ثم تركته ← فهي نعمة كفرتها","cause":"ومَنْ عَلِمَ الرَّميَ ثُمَّ تَرَكَه","result":"فهي نِعمةٌ كَفَرَها","explicit":true,"similar":["س-05017"],"ref":"المستدرك على الصحيحين 2502","srcLabel":"مسلم","text":["عنْ خالدِ بنِ زيدٍ قالَ: كنتُ راميًا أُرامي عُقبةَ بنَ عامِرٍ، فمَرَّ بي ذاتَ يومٍ، فقالَ: يا خالدُ، اخرُجْ بِنا نَرْمي، فأَبْطَأْتُ عليه، فقالَ: يا خالدُ، تعالَ أُحدِّثْكَ ما حدَّثَني رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، وأَقولُ لكَ كما قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّ اللهَ يُدخِلُ بالسَّهمِ الواحدِ ثلاثةَ نَفَرٍ الجنَّةَ: صانِعُه الَّذي احتَسَبَ في صَنْعتِه الخيرَ، ومُتَنبِّلُه، والرَّامي، ارْموا واركَبوا، وأنْ تَرْموا أَحبُّ إليَّ مِن أنْ ترْكَبوا، وليس مِنَ اللَّهوِ إلَّا ثلاثةٌ: تأديبُ الرَّجلِ فرَسَه، ومُلاعبتُه زوجتَه، ورميُه بنَبْلِه عن قومِه، ",["ومَنْ عَلِمَ الرَّميَ ثُمَّ تَرَكَه",1],"؛ ",["فهي نِعمةٌ كَفَرَها",2],"."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح الإسناد، وله شاهد صحيح على شرط مسلم","takhrij":"أخرجه الروياني (247) بلفظه، وأبو داود (2513)، والنسائي (3146) كلاهما ببعض لفظه.","bab":"نكاح › حسن العشرة بين الأزواج","dorar":"73ojelQY","merged":2,"otherRefs":["مشارع الأشواق 837 (حسن)"]},{"id":"س-00272","fp":"cb162048bfa5","stateId":145,"easy":"إذا لم تشكر الناس ← لا تكون شكرت الله","cause":"مَن لم يَشكُرِ النَّاسَ","result":"لم يَشكُرِ اللهَ","explicit":true,"otherNeedIds":[27,41],"ref":"تخريج المسند لشعيب 11280","srcLabel":"الترمذي","text":["\"",["مَن لم يَشكُرِ النَّاسَ ",1],["لم يَشكُرِ اللهَ\"",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (1955)، وأحمد (11280)","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"RQxFg3Be","merged":2,"otherRefs":["تخريج المسند لشعيب 8019 (صحيح)"]},{"id":"س-05017","fp":"37f22ff1ab73","stateId":145,"easy":"إذا تعلمت الرمي ثم نسيته ← فهي نعمة جحدتها","cause":"من تعلَّم الرميَ ثم نسِيَه","result":"فهي نعمةٌ جحَدها","explicit":true,"repOf":"س-01302","ref":"صحيح الترغيب 1294","text":[["من تعلَّم الرميَ ثم نسِيَه",1]," ؛ ",["فهي نعمةٌ جحَدها",2]," ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه البزار (9095)، والطبراني في ((المعجم الصغير)) (543)، وأبو نعيم في ((تاريخ أصبهان)) (1/432)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"aBsejsnk","merged":2,"otherRefs":["الزواجر عن اقتراف الكبائر 2/180 (حسن)"]},{"id":"س-05507","fp":"296a4671201b","stateId":145,"easy":"إذا كتمت (المعروف أو النعمة) ← فقد كفرت","cause":"من كتم","result":"فقد كفر","explicit":true,"repOf":"س-00449","ref":"الترغيب والترهيب 2/101","text":["من أُعطي عطاءً فوجد فليجزِ به فإن لم يجدْ فليُثْنِ فإنَّ من أثنَى فقد شكر و",["من كتم",1]," ",["فقد كفر",2]," ومن تحلَّى بما لم يُعطَ كان كلابسِ ثوبيْ زورٍ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (4813)، والترمذي (2034) باختلاف يسير","bab":"رقائق وزهد › الرياء والسمعة","dorar":"sqN17tBB"},{"id":"س-07052","fp":"ba5a55b1f1be","stateId":146,"easy":"إذا كان علمك على لسانك لا في قلبك ← فهو حجة الله عليك","cause":"وعلمٌ على اللِّسانِ","result":"فذلك حُجَّةُ اللهِ على ابنِ آدَمَ","explicit":true,"star":true,"ref":"فيض القدير 4/ 391","srcLabel":"الدارمي","text":["العِلمُ عِلمان: فعِلمٌ في القلبِ فذلك العِلمُ النَّافعُ، ",["وعلمٌ على اللِّسانِ",1]," ",["فذلك حُجَّةُ اللهِ على ابنِ آدَمَ",2]],"grade":"صحيح","narrator":"الحسن البصري","muhaddith":"إسناده صحيح","takhrij":"أخرجه الدارمي (376) وابن المبارك في ((الزهد)) (1161)  وابن أبي شيبة (35502) واللفظ لهم","bab":"علم › الحث على طلب العلم","dorar":"P2NJ3j6u"},{"id":"س-07442","fp":"e02cb5845c17","stateId":146,"easy":"إذا حفظت سورة أو آية ثم نسيتها ← فلا ذنب أعظم منه","cause":"سورةٍ منَ القُرآنِ أو آيةٍ أوتيَها رجلٌ ثمَّ نَسيَها","result":"فلم أرَ ذنبًا هوَ أعظَمُ","explicit":true,"star":true,"ref":"صحيح ابن خزيمة 2/ 448","srcLabel":"ابن خزيمة","text":["عُرِضَت عليَّ أجورُ أمَّتي حتَّى القَذاةُ يخرِجُها الرَّجلُ منَ المسجدِ، وعُرِضَت عليَّ ذُنوبُ أمَّتي ",["فلم أرَ ذنبًا هوَ أعظَمُ",2]," مِن ",["سورةٍ منَ القُرآنِ أو آيةٍ أوتيَها رجلٌ ثمَّ نَسيَها",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أخرجه في صحيحه","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"ZfGNeAzE"},{"id":"س-07045","fp":"6f0c82db708e","stateId":146,"easy":"إذا خنت في علمك ← فهي أشد من خيانة المال وتُسأل عنها","cause":"خيانةَ أحدِكم في علمِه","result":"أشدُّ من خيانتِه في مالِه وإنَّ اللهَ سائلُكم يومَ القيامةِ","explicit":true,"ref":"النكت على الموضوعات 52","srcLabel":"الطبراني","text":["تناصَحوا في العلمِ [فإنَّ ",["خيانةَ أحدِكم في علمِه",1]," ",["أشدُّ من خيانتِه في مالِه وإنَّ اللهَ سائلُكم يومَ القيامةِ",2],"]"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"لم ينفرد به عبد القدوس بن حبيب بل أخرجه الطبراني في الكبير من وجه آخر عنه بسند رجاله موثقون","takhrij":"أخرجه ابن أبي الدنيا في ((العقل وفضله)) (111)، والطبراني (11/270) (11701)، وأبو نعيم في ((حلية الأولياء)) (9/20) مطولاً","bab":"علم › الحث على طلب العلم","dorar":"Av3RtKvP"},{"id":"س-07296","fp":"aadf478d7b00","stateId":146,"easy":"إذا كتمت حديثاً (علماً) ← فقد كتمت ما أنزل الله","cause":"فمن كتَم حديثًا","result":"فقد كتم ما أنزل اللهُ عَزَّ وَجَلَّ","explicit":true,"ref":"تهذيب السنن 10/93","srcLabel":"ابن ماجه","text":["إذا لَعنَ آخرُ هذه الأمةِ أولَها ",["فمن كتَم حديثًا",1]," ",["فقد كتم ما أنزل اللهُ عَزَّ وَجَلَّ",2]],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"رجاله ثقات","takhrij":"أخرجه ابن ماجه (263)","bab":"فتن › ظهور الفتن","dorar":"mKzzrBl5"},{"id":"س-07775","fp":"a9358f365d10","stateId":146,"easy":"إذا تسارعتم في قراءة القرآن تنازعاً ← تختصمون ثم تختلفون","cause":"متى ما يُسارِعوا هذه المُسارَعةَ","result":"يَحتَقُّوا، ومتى ما يَحتَقُّوا يَختَصِموا، ومتى ما اختَصَموا يَختَلِفوا، ومتى ما يَختَلِفوا يَقتَتِلوا","explicit":true,"otherNeedIds":[56],"ref":"تخريج سير أعلام النبلاء 3/349","srcLabel":"الذهبي","text":["قَدِمَ على عُمَرَ رَجُلٌ، فجَعَلَ عُمَرُ يَسألُه عنِ الناسِ، فقال: يا أميرَ المُؤمِنينَ، قد قَرَأ القُرآنَ منهم كذا وكذا. فقُلتُ: واللهِ ما أُحِبُّ أنْ يُسارِعوا يَومَهم هذا في القُرآنِ هذه المُسارَعةَ. قال: فزَبَرَني عُمَرُ، ثم قال: مَهْ. فانطَلَقتُ إلى مَنزِلي مُكتَئِبًا حَزينًا، فقُلتُ: قد كُنتُ نزَلتُ مِن هذا بمَنزِلةٍ، ولا أراني إلَّا قد سَقَطتُ مِن نَفْسِه، فاضطَجَعتُ على فِراشي، حتى عادَني نِسوةُ أهلي، وما بي وَجَعٌ، فبَينا أنا على ذلك، قيل لي: أجِبْ أميرَ المُؤمِنينَ. فخَرَجتُ، فإذا هو قائِمٌ على البابِ يَنتَظِرُني، فأخَذَ بيَدي، ثم خَلا بي، فقال: ما الذي كَرِهتَ ممَّا قال الرَّجُلُ آنِفًا؟ قُلتُ: يا أميرَ المُؤمِنينَ، إنْ كُنتُ أسَأْتُ، فإنِّي أستَغفِرُ اللهَ، وأتوبُ إليه، وأنزِلُ حيث أحبَبْتَ. قال: لَتُخبِرَنِّي. قُلتُ: ",["متى ما يُسارِعوا هذه المُسارَعةَ",1]," ",["يَحتَقُّوا، ومتى ما يَحتَقُّوا يَختَصِموا، ومتى ما اختَصَموا يَختَلِفوا، ومتى ما يَختَلِفوا يَقتَتِلوا",2],". قال: للهِ أبوكَ، لقد كُنتُ أكتُمُها الناسَ حتى جِئتَ بها."],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"رجاله ثقات.","takhrij":"أخرجه الذهبي في ((سير أعلام النبلاء)) (3/ 348) بلفظه، وعبد الرزاق (20368)، والفسوي في ((المعرفة والتاريخ))  (1/ 516) كلاهما بنحوه .","bab":"قرآن › الاختلاف والمراء في القرآن","dorar":"YCmzNwdc"},{"id":"ق-0085","fp":"757e2ccca424","stateId":147,"easy":"تعدّي حدود الله ← الدخول في الظالمين","cause":"تعدّي حدود الله","result":"الدخول في الظالمين","explicit":true,"star":true,"ref":"سورة البقرة: 229","srcLabel":"القرآن الكريم","quran":{"s":2,"from":229,"to":229,"text":"الطَّلَاقُ مَرَّتَانِ فَإِمْسَاكٌ بِمَعْرُوفٍ أَوْ تَسْرِيحٌ بِإِحْسَانٍ وَلَا يَحِلُّ لَكُمْ أَنْ تَأْخُذُوا مِمَّا آتَيْتُمُوهُنَّ شَيْئًا إِلَّا أَنْ يَخَافَا أَلَّا يُقِيمَا حُدُودَ اللَّهِ فَإِنْ خِفْتُمْ أَلَّا يُقِيمَا حُدُودَ اللَّهِ فَلَا جُنَاحَ عَلَيْهِمَا فِيمَا افْتَدَتْ بِهِ تِلْكَ حُدُودُ اللَّهِ فَلَا تَعْتَدُوهَا وَمَنْ يَتَعَدَّ حُدُودَ اللَّهِ فَأُولَئِكَ هُمُ الظَّالِمُونَ (229)","hl":[[332,395,1]]}},{"id":"ق-0245","fp":"81a7032e9b24","stateId":147,"easy":"كسب الإثم ← وباله على النفس","cause":"كسب الإثم","result":"وباله على النفس","explicit":true,"star":true,"ref":"سورة النساء: 111","srcLabel":"القرآن الكريم","quran":{"s":4,"from":111,"to":111,"text":"وَمَنْ يَكْسِبْ إِثْمًا فَإِنَّمَا يَكْسِبُهُ عَلَى نَفْسِهِ وَكَانَ اللَّهُ عَلِيمًا حَكِيمًا (111)","hl":[[0,94,1]]}},{"id":"ق-0369","fp":"8082237d4628","stateId":147,"easy":"كسب الإثم ظاهره وباطنه ← الجزاء بما اقترفوا","cause":"كسب الإثم ظاهره وباطنه","result":"الجزاء بما اقترفوا","explicit":true,"otherNeedIds":[70],"ref":"سورة الأنعام: 120","srcLabel":"القرآن الكريم","quran":{"s":6,"from":120,"to":120,"text":"وَذَرُوا ظَاهِرَ الْإِثْمِ وَبَاطِنَهُ إِنَّ الَّذِينَ يَكْسِبُونَ الْإِثْمَ سَيُجْزَوْنَ بِمَا كَانُوا يَقْتَرِفُونَ (120)","hl":[[39,117,1]]}},{"id":"ق-0390","fp":"1e5df3d898ed","stateId":147,"easy":"المجيء بالسيئة ← يجزى مثلها فقط","cause":"المجيء بالسيئة","result":"يجزى مثلها فقط","explicit":true,"similar":["ق-0932","ق-1112"],"ref":"سورة الأنعام: 160","srcLabel":"القرآن الكريم","quran":{"s":6,"from":160,"to":160,"text":"مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ عَشْرُ أَمْثَالِهَا وَمَنْ جَاءَ بِالسَّيِّئَةِ فَلَا يُجْزَى إِلَّا مِثْلَهَا وَهُمْ لَا يُظْلَمُونَ (160)","hl":[[52,133,1]]}},{"id":"ق-0932","fp":"7720adc67be2","stateId":147,"easy":"المجيء بالسيئة ← يجزى بما عمل فقط","cause":"المجيء بالسيئة","result":"يجزى بما عمل فقط","explicit":true,"repOf":"ق-0390","ref":"سورة القصص: 84","quran":{"s":28,"from":84,"to":84,"text":"مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ خَيْرٌ مِنْهَا وَمَنْ جَاءَ بِالسَّيِّئَةِ فَلَا يُجْزَى الَّذِينَ عَمِلُوا السَّيِّئَاتِ إِلَّا مَا كَانُوا يَعْمَلُونَ (84)","hl":[[47,152,1]]}},{"id":"ق-1112","fp":"52b18064feb4","stateId":147,"easy":"عمل السيئة ← يجزى مثلها فقط","cause":"عمل السيئة","result":"يجزى مثلها فقط","explicit":true,"repOf":"ق-0390","ref":"سورة غافر: 40","quran":{"s":40,"from":40,"to":40,"text":"مَنْ عَمِلَ سَيِّئَةً فَلَا يُجْزَى إِلَّا مِثْلَهَا وَمَنْ عَمِلَ صَالِحًا مِنْ ذَكَرٍ أَوْ أُنْثَى وَهُوَ مُؤْمِنٌ فَأُولَئِكَ يَدْخُلُونَ الْجَنَّةَ يُرْزَقُونَ فِيهَا بِغَيْرِ حِسَابٍ (40)","hl":[[0,53,1]]}},{"id":"ق-1349","fp":"3ba3394f4dc2","stateId":147,"easy":"تعدّي حدود الله ← ظلم النفس","cause":"تعدّي حدود الله","result":"ظلم النفس","explicit":true,"ref":"سورة الطلاق: 1","srcLabel":"القرآن الكريم","quran":{"s":65,"from":1,"to":1,"text":"يَا أَيُّهَا النَّبِيُّ إِذَا طَلَّقْتُمُ النِّسَاءَ فَطَلِّقُوهُنَّ لِعِدَّتِهِنَّ وَأَحْصُوا الْعِدَّةَ وَاتَّقُوا اللَّهَ رَبَّكُمْ لَا تُخْرِجُوهُنَّ مِنْ بُيُوتِهِنَّ وَلَا يَخْرُجْنَ إِلَّا أَنْ يَأْتِينَ بِفَاحِشَةٍ مُبَيِّنَةٍ وَتِلْكَ حُدُودُ اللَّهِ وَمَنْ يَتَعَدَّ حُدُودَ اللَّهِ فَقَدْ ظَلَمَ نَفْسَهُ لَا تَدْرِي لَعَلَّ اللَّهَ يُحْدِثُ بَعْدَ ذَلِكَ أَمْرًا (1)","hl":[[260,374,1]]}}]}