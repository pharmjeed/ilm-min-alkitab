{"schema":1,"kind":"sunan-chunk","version":"sunan-cb5af5731a1c","needId":3,"stateIds":[22,23,24,25,26,27],"items":[{"id":"س-02376","fp":"2e3a1dde6f43","stateId":22,"easy":"إذا ادّعيت دعوى كاذبة لتكثر مالك ← لا يزيدك الله إلا قلة","cause":"ومَنِ ادَّعى دَعوى كاذِبةً ليَتَكَثَّرَ بها","result":"لم يَزِدْه اللهُ إلَّا قِلَّةً","explicit":true,"star":true,"ref":"صحيح مسلم 110","srcLabel":"متفق عليه","text":["ليس على رَجُلٍ نَذرٌ فيما لا يَملِكُ، ولَعنُ المُؤمِنِ كَقَتلِه، ومَن قَتَلَ نَفسَه بشيءٍ في الدُّنيا عُذِّبَ به يَومَ القيامةِ، ",["ومَنِ ادَّعى دَعوى كاذِبةً ليَتَكَثَّرَ بها",1]," ",["لم يَزِدْه اللهُ إلَّا قِلَّةً",2],"، ومَن حَلَفَ على يَمينِ صَبرٍ فاجِرةٍ."],"grade":"صحيح","narrator":"ثابت بن الضحاك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6047)، ومسلم (110).","bab":"إسلام › حرمة المسلم","dorar":"LmqD8FfX"},{"id":"س-03865","fp":"9674f2cb74d3","stateId":22,"easy":"إذا كذب البائع والمشتري وكتما العيب ← تُمحق بركة بيعهما","cause":"وإن كذَبا وَكَتما","result":"فعسَى أن يدورَ بينَهُما فَضلٌ، وتُمْحقُ برَكَةُ بيعِهِما","explicit":true,"star":true,"ref":"نخب الافكار 11/408","srcLabel":"متفق عليه","text":["البيِّعانِ بالخيارِ حتَّى يتفرَّقا - أو ما لَم يتفرَّقا - فإن صَدقا وبيَّنا بورِكَ لَهُما في بيعِهِما، ",["وإن كذَبا وَكَتما",1]," ",["فعسَى أن يدورَ بينَهُما فَضلٌ، وتُمْحقُ برَكَةُ بيعِهِما",2]," قالَ همَّامٌ: فسَمِعْتُ أبا التَّيَّاحِ يقولُ: سَمِعْتُ هذا الحديثَ عَن عبدِ اللَّهِ بنِ الحارِثِ، عَن حَكيمِ بنِ حزامٍ، عَنِ النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ بمثلِ هذا"],"grade":"صحيح","narrator":"حكيم بن حزام","muhaddith":"طريقه صحيح","takhrij":"أخرجه الطحاوي في ((شرح معاني الآثار)) (5533) بلفظه، والبخاري (2079)، ومسلم (1532)، وأبو داود (3459) جميعهم باختلاف يسير.","bab":"تجارة › أخلاقيات التجارة","dorar":"VWSbqmD8"},{"id":"س-07993","fp":"6e11b8304eab","stateId":22,"easy":"إذا اقتطعت مال أخيك بيمين كاذبة ← لا يبارك الله لك فيه","cause":"ومَنِ اقتطع مالَ أخيهِ بيَمينِه","result":"فلا بارَكَ اللهُ له فيه","explicit":true,"star":true,"similar":["س-08019"],"ref":"تخريج المسند لشاكر 3/117","srcLabel":"متفق عليه","text":["قال لنا مَرْوانُ: انطلِقوا فأَصلِحوا بيْن هذينِ؛ سعيدِ بنِ زيدٍ وأَرْوى بنتِ أُوَيسٍ. فأتَينا سعيدَ بنَ زيدٍ، فقال: أتَرَون أنِّي قدِ استَنقصْتُ مِن حقِّها شيئًا؟ أشهَدُ لسَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: مَن أخَذ شِبرًا مِن الأرضِ بغيرِ حقِّه، طُوِّقَه مِن سبعِ أرَضينَ، ومَن تولَّى قومًا بغيرِ إذنِهم، فعليه لَعنةُ اللهِ، ",["ومَنِ اقتطع مالَ أخيهِ بيَمينِه، ",1],["فلا بارَكَ اللهُ له فيه",2],"."],"grade":"صحيح","narrator":"عبدالرحمن بن عوف","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو يعلى (955) واللفظ له، والحاكم (7807) باختلاف يسير، والبخاري (3198)، ومسلم (1610) بالفقرة الأولى فقط.","bab":"مظالم › تحريم الظلم","dorar":"XXyZA1jm"},{"id":"س-08019","fp":"d4cd0aa48472","stateId":22,"easy":"إذا اقتطعت مالاً بيمين كاذبة ← لا يُبارك لك فيه","cause":"ومَنِ اقتَطَع مالًا بيَمينِه","result":"فلا بُورِكَ له فيه","explicit":true,"repOf":"س-07993","ref":"المستدرك على الصحيحين 8017","text":["عن أبي سَلَمةَ: كانَ بيْنَ سَعيدِ بنِ زَيدٍ وبيْنَ ابنةِ أرْوَى خُصومةٌ، فقالَ مَرْوانُ: أصلِحوا بيْنَ هَذَينِ، فقُلنا له في ذلكَ، حتَّى قُلنا: أنصِفْ هذه المَرأةَ، فقالَ: تَرَوْني أنتَقِصُها مِن حَقِّها شَيئًا وقدْ سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: مَنِ اقتَطَع شِبرًا منَ الأرضِ طَوَّقَه اللهُ تَعالَى يَومَ القِيامةِ مِن سَبعِ أرَضِينَ، ",["ومَنِ اقتَطَع مالًا بيَمينِه ",1],["فلا بُورِكَ له فيه، ",2],"ومَن تَوَلَّى قَومًا بغَيرِ إذنِهم فعليْه لَعنةُ اللهِ والمَلائكةِ والنَّاسِ أجمَعين!"],"grade":"صحيح","narrator":"سعيد بن زيد","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البخاري (3198)، ومسلم (1610) بنحوه.","bab":"مظالم › تحريم الظلم","dorar":"m5eeByMx"},{"id":"ق-0112","fp":"0dfe1c0294e3","stateId":22,"easy":"الربا ← المحق","cause":"الربا","result":"المحق","explicit":true,"star":true,"ref":"سورة البقرة: 276","srcLabel":"القرآن الكريم","quran":{"s":2,"from":276,"to":276,"text":"يَمْحَقُ اللَّهُ الرِّبَا وَيُرْبِي الصَّدَقَاتِ وَاللَّهُ لَا يُحِبُّ كُلَّ كَفَّارٍ أَثِيمٍ (276)","hl":[[0,25,1]]}},{"id":"ق-0591","fp":"e17155381487","stateId":22,"easy":"نقص المكيال والميزان ← عذاب يوم محيط","cause":"نقص المكيال والميزان","result":"عذاب يوم محيط","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[56],"ref":"سورة هود: 84","srcLabel":"القرآن الكريم","quran":{"s":11,"from":84,"to":84,"text":"وَإِلَى مَدْيَنَ أَخَاهُمْ شُعَيْبًا قَالَ يَا قَوْمِ اعْبُدُوا اللَّهَ مَا لَكُمْ مِنْ إِلَهٍ غَيْرُهُ وَلَا تَنْقُصُوا الْمِكْيَالَ وَالْمِيزَانَ إِنِّي أَرَاكُمْ بِخَيْرٍ وَإِنِّي أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ مُحِيطٍ (84)","hl":[[104,224,1]]}},{"id":"ق-0959","fp":"2be408f98df2","stateId":22,"easy":"الربا ← لا يربو عند الله","cause":"الربا","result":"لا يربو عند الله","explicit":true,"ref":"سورة الروم: 39","srcLabel":"القرآن الكريم","quran":{"s":30,"from":39,"to":39,"text":"وَمَا آتَيْتُمْ مِنْ رِبًا لِيَرْبُوَ فِي أَمْوَالِ النَّاسِ فَلَا يَرْبُو عِنْدَ اللَّهِ وَمَا آتَيْتُمْ مِنْ زَكَاةٍ تُرِيدُونَ وَجْهَ اللَّهِ فَأُولَئِكَ هُمُ الْمُضْعِفُونَ (39)","hl":[[0,89,1]]}},{"id":"س-02994","fp":"c68e1b7c2aec","stateId":22,"easy":"إذا احتكرت طعام المسلمين ← يضربك الله بالإفلاس أو المرض","cause":"منِ احتَكَرَ على المسلِمينَ طعامَهُم","result":"ضربَهُ اللَّهُ بالإفلاسِ ، أو بِجُذامٍ","explicit":true,"otherNeedIds":[56],"ref":"تخريج المسند لشاكر 1/82","srcLabel":"البيهقي","text":["أنَّ عمرَ رضيَ اللَّهُ عنهُ وَهوَ يومئذٍ أميرُ المؤمنينَ خرجَ إلى المسجِدِ فرَأى طعامًا مَنثورًا فقالَ : ما هذا الطَّعامُ ؟ فَقالوا : طَعامٌ جلبَ إلَينا ، قالَ : بارَكَ اللَّهُ فيهِ ، وفيمَن جلبَهُ ، قيلَ : يا أميرَ المؤمنينَ فإنَّهُ قدِ احتُكِرَ ، قالَ : ومنِ احتَكَرَهُ ؟ قالوا : فرُّوخُ مولى عثمانَ ، وفلانٌ مولَى عمرَ ، فأرسلَ إليهِما فدَعاهما ، فقالَ : ما حملَكُما علَى احتِكارِ طعامِ المسلِمينَ ؟ قالا : يا أميرَ المؤمِنينَ ، نشتَري بأموالِنا ، ونبيعُ ، فقالَ عمرُ : سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يَقولُ : ",["منِ احتَكَرَ على المسلِمينَ طعامَهُم ، ",1],["ضربَهُ اللَّهُ بالإفلاسِ ، أو بِجُذامٍ ",2],"، فقالَ فرُّوخُ : عندَ ذلِكَ يا أميرَ المؤمنينَ ، أعاهدُ اللَّهَ ، وأعاهِدُكَ ، أن لا أعودَ في طَعامٍ أبدًا ، وأمَّا مَولى عُمرَ فقالَ : إنَّما نَشتَري بأموالِنا ونبيعُ . قالَ أبو يَحيى : فلَقد رأيتُ مَولى عمرَ مَجذومًا"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح","takhrij":"أخرجه عبد بن حميد (17)، والبيهقي في ((شعب الإيمان)) (10705) واللفظ لهما، وابن ماجة (2155) مختصرًا على المرفوع.","bab":"إيمان › الوعيد","dorar":"J1SFzHwd"},{"id":"س-03821","fp":"169f776ecb35","stateId":22,"easy":"إذا كسبت مالاً حراماً ← لا يُبارك لك فيه، ولا تُقبل صدقتك منه، ويكون زادك إلى النار","cause":"ولا يَكْسبُ عبدٌ مالًا من حرامٍ","result":"فينفقَ منهُ فيباركَ لَهُ فيهِ ، ولا يتصدقُ فيقبلَ منهُ ، ولا يترُكُهُ خلفَ ظَهْرِهِ إلَّا كانَ زادَهُ إلى النَّارِ","explicit":true,"otherNeedIds":[52,70],"ref":"عمدة التفسير 1/323","srcLabel":"أحمد","text":["إن اللَّهَ قسَّمَ بينَكُم أخلاقَكُم ، كما قسَّمَ بينَكُم أرزاقَكُم ، وإنَّ اللَّهَ يُعطي الدُّنيا مَن يحبُّ ومن لا يحبُّ ، ولا يعطي الدِّينَ إلَّا لمن أحبَّ ، فمَن أعطاهُ اللَّهُ الدِّينَ فقد أحبَّهُ ، والَّذي نَفسي بيدِهِ ، لا يُسلِمُ عبدٌّ حتَّى يسلمَ قلبُه ولسانُهُ ، ولا يؤمنُ حتَّى يأمنَ جارُه بوائقَهُ . قالوا : وما بوائقُهُ يا نبيَّ اللَّهِ ؟ . قالَ : غشمُه وظلمُهُ ، ",["ولا يَكْسبُ عبدٌ مالًا من حرامٍ",1]," ",["فينفقَ منهُ فيباركَ لَهُ فيهِ ، ولا يتصدقُ فيقبلَ منهُ ، ولا يترُكُهُ خلفَ ظَهْرِهِ إلَّا كانَ زادَهُ إلى النَّارِ",2]," ، إنَّ اللَّهَ لا يمحو السَّيِّئَ بالسَّيِّئِ ، ولَكِن يمحو السَّيِّئَ بالحسنِ ، إنَّ الخبيثَ لا يمحو الخبيثَ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (3672) واللفظ له، والحاكم (7301) مختصراً، والبيهقي في ((شعب الإيمان)) (5524) باختلاف يسير","bab":"بر وصلة › حق الجار والوصاة به","dorar":"2ncru5Qu"},{"id":"س-04964","fp":"0712bc5dfa9f","stateId":22,"easy":"إذا خان أحد الشريكين صاحبه ← تنزع بركة الله من الشركة","cause":"فإذا خانَه","result":"خرَجْتُ مِن بيْنِهما","explicit":true,"ref":"فتاوى نور على الدرب لابن عثيمين 9/186","srcLabel":"فتاوى نور على الدرب لابن عثيمين","text":["إِنَّ اللهَ تَعَالَى يَقُولُ: أنا ثالثُ الشَّريكينِ ما لم يَخُنْ أحدُهما صاحبَه، ",["فإذا خانَه",1]," ",["خرَجْتُ مِن بيْنِهما",2],"."],"grade":"صحيح","muhaddith":"[ثابت]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Y0rSZk8R"},{"id":"س-05145","fp":"f352cc6663bb","stateId":22,"easy":"إذا تعاملت بالربا ← تصير عاقبته إلى قلة وإن كثر","cause":"الرِّبا وإنْ كَثُرَ","result":"فإنَّ عاقِبتَهُ تَصيرُ إلى قُلٍّ","explicit":true,"ref":"المستدرك على الصحيحين 2296","srcLabel":"ابن ماجه","text":[["الرِّبا وإنْ كَثُرَ",1],"؛ ",["فإنَّ عاقِبتَهُ تَصيرُ إلى قُلٍّ",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (3754)، وأبو يعلى الموصلي (5042) كلاهما بلفظه، وابن ماجه (2279) بلفظ مقارب.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"2n0xvOX7"},{"id":"س-06152","fp":"d77be74dc6f3","stateId":22,"easy":"إذا طفّف قوم الميزان ← يأخذهم الله بالقحط","cause":"وما طفَّف قومٌ الميزانَ","result":"إلا أخذَهم اللهُ بالسِّنينَ","explicit":true,"ref":"السلسلة الصحيحة 1/219","srcLabel":"البيهقي","text":["عن ابنِ عباسٍ قال : ما نقض قومٌ العهدَ إلا سلَّط اللهُ عليهم عدوَّهم ولا فشتِ الفاحشةُ في قومٍ إلا أخذهم اللهُ بالموتِ ",["وما طفَّف قومٌ الميزانَ",1]," ",["إلا أخذَهم اللهُ بالسِّنينَ",2]," وما منع قومٌ الزكاةَ إلا منعَهم اللهُ القطرَ من السماءِ وما جار قومٌ في حكمٍ إلا كان البأسُ بينهم أظنُّه قال : والقتلُ"],"grade":"صحيح","narrator":"عبدالله بن بريدة بن الحصيب الأسلمي","muhaddith":"إسناده صحيح","takhrij":"أخرجه البيهقي (6470) واللفظ له.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"4yZchCL2"},{"id":"س-00290","fp":"8373009c6a70","stateId":22,"easy":"إذا خنت ← تجرّ الخيانة عليك الفقر","cause":"والخيانةُ","result":"تجرُّ الفقرَ","explicit":true,"similar":["س-03867"],"ref":"شرح كتاب الشهاب 244","srcLabel":"الكلاباذي","text":["الأمانةُ تجرُّ الرِّزقَ ",["والخيانةُ",1]," ",["تجرُّ الفقرَ",2]],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"إسناده حسن","takhrij":"أخرجه الكلاباذي في ((بحر الفوائد)) (ص159)","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"m4jEttGK"},{"id":"س-03867","fp":"1b90d716ad8a","stateId":22,"easy":"إذا خنت ← تجلب الخيانة عليك الفقر","cause":"والخيانةُ","result":"تَجلِبُ الفقرَ","explicit":true,"repOf":"س-00290","ref":"فيض القدير 3/ 183","text":["الأمانةُ تَجلِبُ الرِّزقَ، ",["والخيانةُ",1]," ",["تَجلِبُ الفقرَ",2]],"grade":"حسن","narrator":"علي","muhaddith":"إسناده حسن","bab":"تجارة › أخلاقيات التجارة","dorar":"Icowimgy"},{"id":"س-05386","fp":"b6281e8328c6","stateId":22,"easy":"إذا غششت في تجارتك ← يذهب الله بما كسبت من الغش (من قصة)","cause":"إذا باعَ الخمرَ شابَهُ بالماءِ، ثُمَّ باعَه","result":"فأخذَ القِردُ الكيسَ، فصعِدَ بِه فوقَ الدَّقَلِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الصحيح المسند 1348","srcLabel":"أحمد","text":["إنَّ رجلًا حملَ معَه خَمرًا في سفينةٍ يبيعُه ومعَهُ قِردٌ، قالَ : فَكانَ الرَّجُلُ ",["إذا باعَ الخمرَ شابَهُ بالماءِ، ثُمَّ باعَه",1],"، ",["فأخذَ القِردُ الكيسَ، فصعِدَ بِه فوقَ الدَّقَلِ",2]," قالَ : فجعَلَ يطرحُ دينارًا في البحرِ ودينارًا في السَّفينةِ حتَّى قسمَهُ ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح ، رجاله رجال الصحيح","takhrij":"أخرجه أحمد (8055)، وابن بشران في ((أماليه-الجزء الأول)) (77)، وأبو سعيد النقاش في ((فنون العجائب)) (80) واللفظ لهم.","bab":"رقائق وزهد › الجزاء من جنس العمل","dorar":"n7L0tfIA"},{"id":"س-04811","fp":"c13fec9679ac","stateId":22,"easy":"إذا أكثرت من الربا ← تكون عاقبة أمرك إلى قلة","cause":"ما أحدٌ أكثرَ من الرِّبا","result":"إلَا كان عاقِبَةُ أمْرِهِ إلى قِلَّةٍ","explicit":true,"ref":"صحيح الجامع 5518","srcLabel":"ابن ماجه","text":[["ما أحدٌ أكثرَ من الرِّبا ،",1]," ",["إلَا كان عاقِبَةُ أمْرِهِ إلى قِلَّةٍ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (2279) واللفظ له، والشاشي في ((المسند)) (809)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"c0yJP7Jd"},{"id":"س-06329","fp":"57f781d5da4f","stateId":23,"easy":"إذا أمسكت وبخلت ← يمسك الله عنك","cause":"لا توعي","result":"فيوعيَ اللهُ عليك","explicit":true,"star":true,"ref":"تخريج صحيح ابن حبان 3357","srcLabel":"متفق عليه","text":["عن أسماءَ بنتِ أبي بكرٍ: أنَّها جاءتِ النَّبيَّ صلَّى اللهُ عليه وسلَّم فقالت: يا نبيَّ اللهِ ليس لي شيءٌ إلَّا ما أدخَل علَيَّ الزُّبيرُ فهل علَيَّ مِن جُناحٍ أنْ أرضَخَ ممَّا يُدخِلُ علَيَّ قال: ( ارضَخي ما استطَعْتِ و",["لا توعي",1]," ",["فيوعيَ اللهُ عليك",2]," )"],"grade":"صحيح","narrator":"أسماء بنت أبي بكر","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (3357) بلفظه، والبخاري (2590)، ومسلم (1029)،  باختلاف يسير.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"FVc9GUoG","merged":10,"otherRefs":["الصحيح المسند 2/522 (صحيح)","صحيح البخاري 1434 (صحيح)","تخريج المسند لشعيب 25081 (صحيح)","تخريج المسند لشعيب 26984 (صحيح)","تخريج صحيح ابن حبان 3209 (صحيح)","تخريج المسند لشعيب 26991 (صحيح)","تخريج المسند لشعيب 26980 (صحيح)","صحيح البخاري 2590 (صحيح)","صحيح الجامع 1513 (صحيح)"]},{"id":"س-04977","fp":"88a5d15e69cd","stateId":23,"easy":"إذا منع قوم الزكاة ← يحبس الله عنهم المطر","cause":"ولا مَنَعَ قومٌ الزَّكاةَ","result":"إلَّا حَبَسَ اللهُ عنهم القَطْرَ","explicit":true,"star":true,"similar":["س-06153"],"ref":"المستدرك على الصحيحين 2613","srcLabel":"مسلم","text":["ما نَقَضَ قومٌ العَهْدَ قَطُّ؛ إلَّا كان القَتْلُ بيْنَهم، ولا ظَهَرَتِ الفاحشةُ في قومٍ قَطُّ؛ إلَّا سَلَّطَ اللهُ عليهم الموتَ، ",["ولا مَنَعَ قومٌ الزَّكاةَ",1],"؛ ",["إلَّا حَبَسَ اللهُ عنهم القَطْرَ",2],"."],"grade":"صحيح","narrator":"[بريدة]","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه البزار (4463)، والبيهقي (6469) كلاهما بلفظه، وابن المنذر في ((الأوسط)) (6692) ببعض لفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"R29oTLvs","merged":2,"otherRefs":["الزواجر عن اقتراف الكبائر 1/170 (صحيح)"]},{"id":"س-05541","fp":"94c009b43209","stateId":23,"easy":"إذا أمسكت مالك عن الحق ← يُعجَّل لك التلف","cause":"وعجِّلْ لمُمسكٍ","result":"تلفًا","explicit":true,"star":true,"ref":"صحيح الترغيب 3167","srcLabel":"أحمد","text":["ما طلعَتْ شمسٌ قطُّ إلَّا بُعِثَ بجنبَتَيْها ملَكانِ ، إنَّهما ليُسمِعانِ أهلَ الأرضِ إلَّا الثَّقلَيْنِ يا أيُّها النَّاسُ ! هلمُّوا إلى ربِّكُم ، فإنَّ ما قلَّ وكفَى خيرٌ ممَّا كثُرَ وألهَى وما غربَتْ شمسٌ قطُّ إلَّا وبُعِثَ بجنبَتَيْها ملَكانِ يناديانِ اللَّهمَّ عجِّلْ لمُنفِقٍ خلفًا ",["وعجِّلْ لمُمسكٍ",1]," ",["تلفًا",2]," ما من يومٍ طلعَتْ شمسُهُ إلَّا وكان بجنبَتَيْها ملَكانِ يناديانِ نداءً يسمعُهُ ما خلقَ اللهُ كلُّهُم غيرَ الثَّقلَيْنِ يا أيُّها النَّاسُ هلمُّوا إلى ربِّكُم إنَّ ما قلَّ وكفَى خيرٌ ممَّا كثُرَ وألهَى ولا آبَتِ الشَّمسُ إلَّا وكان بجنبَتَيْها ملَكانِ يناديانِ نداءً يسمعُهُ خَلْقُ اللهِ كلُّهُم غيرَ الثَّقلَيْنِ اللَّهمَّ أعطِ مُنفقًا خلفًا وأعطِ مُمسكًا تلفًا وأنزلَ اللهُ في ذلكَ قرآنًا في قَولِ الملَكَيْنِ يا أيُّها النَّاسُ هلمُّوا إلى ربِّكُم في سورةِ يونسَ  وَاللهُ يَدْعُو إِلَى دَارِ السَّلَامِ وَيَهْدِي مَنْ يَشَاءُ إِلَى صِرَاطٍ مُسْتَقِيمٍ  وأنزلَ اللهُ في قولِهِما اللَّهمَّ أعطِ مُنفقًا خلفًا وأعطِ مُمسكًا تلفًا  وَاللَّيْلِ إِذَا يَغْشَى وَالنَّهَارِ إِذَا تَجَلَّى وَمَا خَلَقَ الذَّكَرَ وَالْأُنْثَى  إلى قولِهِ لِلْعُسْرَى . ."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه أحمد (21721)، وابن حبان (686) مختصراً، والبيهقي في ((شعب الإيمان)) (3412) باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"GAdRie7k","merged":7,"otherRefs":["تاريخ الإسلام 16/329 (صحيح)","تخريج صحيح ابن حبان 686 (صحيح)","صحيح الترغيب 914 (صحيح)","عارضة الأحوذي 3/173 (صحيح)","صحيح الجامع 1332 (صحيح)","النظر في أحكام النظر 301 (صحيح)"]},{"id":"س-02124","fp":"1c649756813a","stateId":23,"easy":"إذا أوكيت (أمسكت) ← يوكي الله عليك","cause":"لا تُوكِي","result":"فيُوكَى عليكِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"تخريج المسند لشعيب 26912","srcLabel":"متفق عليه","text":["قلتُ للنَّبيِّ صلَّى اللهُ عليهِ وسلَّمَ: ليس لي إلَّا ما أدخَلَ الزُّبَيرِ بَيْتي؟ قال: أنفِقي، و",["لا تُوكِي",1],"، ",["فيُوكَى عليكِ",2],"."],"grade":"صحيح","narrator":"أسماء بنت أبي بكر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1699) باختلاف يسير، ومسلم (1029) دون الزيادة في أوله، وقوله: \"ولا تُوكِي، فيُوكَى عليكِ\" أخرجه البخاري (1433)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"8IKftQty","merged":3,"otherRefs":["تخريج سنن أبي داود 1699 (صحيح)","صحيح الترمذي 1960 (صحيح)"]},{"id":"ق-1367","fp":"dbb6a0991069","stateId":23,"easy":"منع حق المساكين وترك الاستثناء (إن شاء الله) ← هلاك الجنة والمال وعذاب الآخرة أكبر","cause":"منع حق المساكين وترك الاستثناء (إن شاء الله)","result":"هلاك الجنة والمال وعذاب الآخرة أكبر","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[61],"ref":"سورة القلم: 17–33","srcLabel":"القرآن الكريم","quran":{"s":68,"from":17,"to":33,"text":"إِنَّا بَلَوْنَاهُمْ كَمَا بَلَوْنَا أَصْحَابَ الْجَنَّةِ إِذْ أَقْسَمُوا لَيَصْرِمُنَّهَا مُصْبِحِينَ (17) وَلَا يَسْتَثْنُونَ (18) فَطَافَ عَلَيْهَا طَائِفٌ مِنْ رَبِّكَ وَهُمْ نَائِمُونَ (19) فَأَصْبَحَتْ كَالصَّرِيمِ (20) فَتَنَادَوْا مُصْبِحِينَ (21) أَنِ اغْدُوا عَلَى حَرْثِكُمْ إِنْ كُنْتُمْ صَارِمِينَ (22) فَانْطَلَقُوا وَهُمْ يَتَخَافَتُونَ (23) أَنْ لَا يَدْخُلَنَّهَا الْيَوْمَ عَلَيْكُمْ مِسْكِينٌ (24) وَغَدَوْا عَلَى حَرْدٍ قَادِرِينَ (25) فَلَمَّا رَأَوْهَا قَالُوا إِنَّا لَضَالُّونَ (26) بَلْ نَحْنُ مَحْرُومُونَ (27) قَالَ أَوْسَطُهُمْ أَلَمْ أَقُلْ لَكُمْ لَوْلَا تُسَبِّحُونَ (28) قَالُوا سُبْحَانَ رَبِّنَا إِنَّا كُنَّا ظَالِمِينَ (29) فَأَقْبَلَ بَعْضُهُمْ عَلَى بَعْضٍ يَتَلَاوَمُونَ (30) قَالُوا يَا وَيْلَنَا إِنَّا كُنَّا طَاغِينَ (31) عَسَى رَبُّنَا أَنْ يُبْدِلَنَا خَيْرًا مِنْهَا إِنَّا إِلَى رَبِّنَا رَاغِبُونَ (32) كَذَلِكَ الْعَذَابُ وَلَعَذَابُ الْآخِرَةِ أَكْبَرُ لَوْ كَانُوا يَعْلَمُونَ (33)","hl":[[0,927,1]]}},{"id":"ق-1434","fp":"f9d1592d47e8","stateId":23,"easy":"ترك إكرام اليتيم وترك الحضّ على طعام المسكين وأكل الميراث وحبّ المال ← سبب الذمّ عند تضييق الرزق والندم يوم القيامة","cause":"ترك إكرام اليتيم وترك الحضّ على طعام المسكين وأكل الميراث وحبّ المال","result":"سبب الذمّ عند تضييق الرزق والندم يوم القيامة","explicit":true,"otherNeedIds":[57],"ref":"سورة الفجر: 17–20","srcLabel":"القرآن الكريم","quran":{"s":89,"from":17,"to":20,"text":"كَلَّا بَلْ لَا تُكْرِمُونَ الْيَتِيمَ (17) وَلَا تَحَاضُّونَ عَلَى طَعَامِ الْمِسْكِينِ (18) وَتَأْكُلُونَ التُّرَاثَ أَكْلًا لَمًّا (19) وَتُحِبُّونَ الْمَالَ حُبًّا جَمًّا (20)","hl":[[0,174,1]]}},{"id":"س-04852","fp":"603ac40e4e60","stateId":23,"easy":"إذا خالطت مالَك الصدقةُ (الزكاة الواجبة) ولم تُخرجها ← أفسدته","cause":"خالطتِ الصَّدقةُ مالًا","result":"إلَّا أفسدتْهُ","explicit":true,"ref":"عمدة التفسير 1/466","srcLabel":"عمدة التفسير","text":["ما ",["خالطتِ الصَّدقةُ مالًا",1]," ",["إلَّا أفسدتْهُ",2]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"96bhN2l7","merged":2,"otherRefs":["شرح مسند الشافعي 3/124 (حسن)"]},{"id":"س-02111","fp":"e4ec21ad8b28","stateId":23,"easy":"إذا أحصيت ما تعطي ← يحصي الله عليك","cause":"لا تُحصي","result":"فيُحصيَ اللهُ عليك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج صحيح ابن حبان 3365","srcLabel":"أبو داود","text":["عن عائشةَ قالت: جاءها سائلٌ فأمَرت له عائشةُ بشيءٍ فلمَّا خرَجَتِ الخادمُ دعَتْها فنظَرَت إليه فقال لها رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( ما تُخرِجينَ شيئًا إلَّا بعملك ) قال: إنِّي لأعلَمُ فقال لها: ( ",["لا تُحصي",1]," ",["فيُحصيَ اللهُ عليك",2]," )"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه ابن حبان (3365) بلفظه، وأبو يعلى الموصلي (4463) باختلاف يسير، وأبو داود (1700) مختصرا، والنسائي (2549) بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"XxLIZvZy","merged":8,"otherRefs":["تخريج سنن أبي داود 1700 (صحيح)","صحيح الجامع 7932 (صحيح)","تخريج صحيح ابن حبان 3209 (صحيح)","تخريج المسند لشعيب 26991 (صحيح)","تخريج المسند لشعيب 24418 (صحيح)","تخريج المسند لشعيب 24773 (صحيح)","صحيح الجامع 1513 (صحيح)"]},{"id":"س-06153","fp":"276819f08da0","stateId":23,"easy":"إذا منع قوم الزكاة ← يمنعهم الله المطر","cause":"وما منع قومٌ الزكاةَ","result":"إلا منعَهم اللهُ القطرَ من السماءِ","explicit":true,"repOf":"س-04977","ref":"السلسلة الصحيحة 1/219","text":["عن ابنِ عباسٍ قال : ما نقض قومٌ العهدَ إلا سلَّط اللهُ عليهم عدوَّهم ولا فشتِ الفاحشةُ في قومٍ إلا أخذهم اللهُ بالموتِ وما طفَّف قومٌ الميزانَ إلا أخذَهم اللهُ بالسِّنينَ ",["وما منع قومٌ الزكاةَ",1]," ",["إلا منعَهم اللهُ القطرَ من السماءِ",2]," وما جار قومٌ في حكمٍ إلا كان البأسُ بينهم أظنُّه قال : والقتلُ"],"grade":"صحيح","narrator":"عبدالله بن بريدة بن الحصيب الأسلمي","muhaddith":"إسناده صحيح","takhrij":"أخرجه البيهقي (6470) واللفظ له.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"4yZchCL2"},{"id":"س-06072","fp":"94b1c985f60d","stateId":23,"easy":"إذا منعت النعمة عن حاجة الناس ← ينزعها الله منك ويحوّلها لغيرك","cause":"فإذا منعوها","result":"نزعها منهم ، فحولَّها إلى غيرِهم","explicit":true,"ref":"صحيح الجامع 2164","srcLabel":"الطبراني","text":["إنَّ للهِ تعالى أقوامًا يختصُّهم بالنِّعَمِ لمنافعِ العبادِ ، و يُقرُّها فيهم ما بذلوها ، ",["فإذا منعوها",1]," ، ",["نزعها منهم ، فحولَّها إلى غيرِهم",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن","takhrij":"أخرجه الطبراني (13/206) (13925)، وأبو نعيم في ((حلية الأولياء)) (10/215)، والبيهقي في ((شعب الإيمان)) (7662) باختلاف يسير","bab":"رقائق وزهد › ما جاء في فعل الخير","dorar":"oxacCTYL","merged":2,"otherRefs":["صحيح الترغيب 2616 (حسن)"]},{"id":"س-06067","fp":"7ec12b238b35","stateId":23,"easy":"إذا تبرّمت بحوائج الناس إليك ← تعرّض نعمتك للزوال","cause":"جعلَ مِنْ حوائجِ الناسِ إليهِ فتبرَّمَ","result":"فقدْ عرَّضَ تلكَ النعمةَ للزوالِ","explicit":true,"ref":"إتقان ما يحسن 2/504","srcLabel":"الطبراني","text":["ما مِنْ عبدٍ أنعمَ اللهُ عليهِ نِعمةً فأسبغَها عليهِ ثمَّ ",["جعلَ مِنْ حوائجِ الناسِ إليهِ فتبرَّمَ",1]," ",["فقدْ عرَّضَ تلكَ النعمةَ للزوالِ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده جيد","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (7529)، وأبو نعيم في ((تاريخ أصبهان)) (1/215)، وابن عساكر في ((تاريخ دمشق)) (71/259) باختلاف يسير","bab":"رقائق وزهد › ما جاء في السعي لقضاء حوائج الخلق","dorar":"fWOkkNc4"},{"id":"س-06324","fp":"af9dd35cf9c7","stateId":23,"easy":"إذا أمسكت الزكاة ← لا يزيد مالك بإمساكها","cause":"أمسَكها","result":"ولا أمسَكها فزادَتْ في مالِه","explicit":true,"ref":"إتحاف الخيرة المهرة 3/8","srcLabel":"أحمد","text":["ما كرُم عبدٌ على اللهِ , عزَّ وجلَّ , إلا ازداد البلاءُ عليه شدةً ، ولا أعطى عبدٌ صدقةَ مالِه فنقصَتْ مِن مالِه ، ",["ولا أمسَكها فزادَتْ في مالِه",2]," ، ولا سرَق سارقٌ إلا حُسِب مِن رِزقِه"],"grade":"حسن","narrator":"كعب","muhaddith":"سنده رجاله ثقات","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (3141) بلفظه، وأحمد في ((الزهد)) (1921) مختصرا، والحارث بن أبي أسامة كما في ((بغية الباحث)) للهيثمي (287) باختلاف يسير.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"uf22Em9Z"},{"id":"س-04793","fp":"7787deaac94f","stateId":24,"easy":"إذا سألت الناس وأنت غنيّ ← يفتح الله عليك باب الفقر","cause":"ما فتحَ عبدٌ بابَ مسئلةٍ له عنها غنًى","result":"إلا فتحَ اللَّهُ له بابَ الفقرِ","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 1/193","srcLabel":"الزواجر عن اقتراف الكبائر","text":[["ما فتحَ عبدٌ بابَ مسئلةٍ له عنها غنًى",1]," ",["إلا فتحَ اللَّهُ له بابَ الفقرِ",2]],"grade":"صحيح","muhaddith":"صحيح أو حسن","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"aUZxELdp"},{"id":"س-05547","fp":"c076f266d12a","stateId":24,"easy":"إذا أخذت المال بغير حقه ← تكون كالذي يأكل ولا يشبع، ويشهد عليك يوم القيامة","cause":"وإنَّه مَن يَأخُذُه بغيرِ حَقِّه","result":"كان كالذي يَأكُلُ ولا يَشبَعُ، ويَكونُ عليه شَهيدًا يَومَ القيامةِ","explicit":true,"star":true,"similar":["س-00604","س-00623","س-07321","س-08423","س-00579","س-07327","س-05631"],"otherNeedIds":[70],"ref":"صحيح مسلم 1052","srcLabel":"متفق عليه","text":["جَلَسَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم على المِنبَرِ، وجَلَسنا حَولَه، فقال: إنَّ ممَّا أخافُ علَيكُم بَعدي ما يُفتَحُ علَيكُم مِن زَهرةِ الدُّنيا وزينَتِها، فقال رَجُلٌ: أو يَأتي الخَيرُ بالشَّرِّ يا رَسولَ اللهِ؟ قال: فسَكَتَ عنه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فقيلَ له: ما شَأنُكَ؟ تُكَلِّمُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم ولا يُكَلِّمُكَ؟ قال: ورَأينا أنَّه يُنزَلُ عليه، فأفاقَ يَمسَحُ عنه الرُّحَضاءَ، وقال: إنَّ هذا السَّائِلَ، وكَأنَّه حَمِدَه، فقال: إنَّه لا يَأتي الخَيرُ بالشَّرِّ، وإنَّ ممَّا يُنبِتُ الرَّبيعُ يَقتُلُ أو يُلِمُّ، إلَّا آكِلةَ الخَضِرِ؛ فإنَّها أكَلَت، حتَّى إذا امتَلأت خاصِرَتاها استَقبَلَت عَينَ الشَّمسِ فثَلَطَت وبالَت، ثُمَّ رَتَعَت، وإنَّ هذا المالَ خَضِرٌ حُلوٌ، ونِعمَ صاحِبُ المُسلِمِ هو لمَن أعطى منه المِسكينَ واليَتيمَ وابنَ السَّبيلَ، أو كما قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، ",["وإنَّه مَن يَأخُذُه بغيرِ حَقِّه",1]," ",["كان كالذي يَأكُلُ ولا يَشبَعُ، ويَكونُ عليه شَهيدًا يَومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1465)، ومسلم (1052).","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"5c9RwbiX","merged":7,"otherRefs":["تخريج المسند لشعيب 11157 (صحيح)","صحيح مسلم 1052 (صحيح)","صحيح ابن حبان 4513 (صحيح)","صحيح ابن حبان 5174 (صحيح)","تخريج صحيح ابن حبان 3227 (صحيح)","صحيح البخاري 6427 (صحيح)"]},{"id":"س-00604","fp":"3768ebfb6456","stateId":24,"easy":"إذا أخذت العطاء بشره نفس وإلحاح ← تكون كالذي يأكل ولا يشبع","cause":"و من أعطيتُه عطاءً عن شرَهِ نفسٍ و شدةِ مسألةٍ","result":"فهو كالآكلِ ، يأكلُ و لا يشبعُ","explicit":true,"repOf":"س-05547","ref":"صحيح الجامع 2344","text":["إنما أنا خازنٌ ، و إنما يعطي اللهُ ، فمن أعطيتُه عطاءً عن طيبِ نفسٍ مني ، فيبارَكْ له فيه ، ",["و من أعطيتُه عطاءً عن شرَهِ نفسٍ و شدةِ مسألةٍ",1]," ، ",["فهو كالآكلِ ، يأكلُ و لا يشبعُ",2]],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"صحيح","takhrij":"أخرجه أحمد (16936)، والطبراني في ((المعجم الكبير)) (19/ 389) (914) باختلاف يسير، والبخاري في ((التاريخ الكبير)) (7/ 10) مختصرًا.","bab":"آداب عامة › ضرب الأمثال","dorar":"sVNlzauN"},{"id":"س-00623","fp":"8b17d6efb7dc","stateId":24,"easy":"إذا أخذت المال برغبة سيئة وطريقة سيئة ← تكون كالذي يأكل ولا يشبع","cause":"و مَنْ بلغَهُ منِّي شيءٌ بِسُوءِ رَغْبَةٍ و سُوءِ هَدْيٍ","result":"فذاكَ الذي يأكلُ ولا يَشْبَعُ","explicit":true,"repOf":"س-05547","ref":"السلسلة الصحيحة 1628","text":["إِنَّما أنا مُبَلِّغٌ و اللهُ يَهْدِي ، و قاسِمٌ و اللهُ يُعْطِي ، فمَنْ بلغَهُ مِنِّي شيءٌ بحسنِ رَغْبَةٍ و حُسْنِ هُدًى ، فإنَّ ذلكَ الذي يُبارَكُ لهُ فيهِ ، ",["و مَنْ بلغَهُ منِّي شيءٌ بِسُوءِ رَغْبَةٍ و سُوءِ هَدْيٍ",1]," ، ",["فذاكَ الذي يأكلُ ولا يَشْبَعُ",2]],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"إسناده صحيح رجاله ثقات رجال مسلم","takhrij":"أخرجه أحمد (16936)، والطبراني في ((المعجم الكبير)) (19/ 389) (914) واللفظ لهما، والبخاري في ((التاريخ الكبير)) (7/ 10) مختصرًا.","bab":"آداب عامة › ضرب الأمثال","dorar":"cTf6h54J"},{"id":"س-07321","fp":"016a550da447","stateId":24,"easy":"إذا أخذت المال بغير حقه ← لا يُبارك لك وتكون كالذي يأكل ولا يشبع","cause":"ومَن أخَذها بغيرِ حقِّها","result":"لم يُبارَكْ له، وكان كالذي يأكُلُ ولا يَشبَعُ","explicit":true,"repOf":"س-05547","ref":"تخريج المسند لشعيب 11035","text":["\"إنَّ أَخوَفَ ما أَخافُ عليكم ما يُخرِجُ اللهُ من نباتِ الأرضِ وزَهْرةِ الدُّنْيا\"، فقال رجُلٌ: أيْ رسولَ اللهِ، أوَ يأْتي الخَيرُ بالشَّرِّ؟ فسكَت حتى رأَيْنا أنَّه يُنزَلُ عليه، قال: وغَشيَه بُهْرٌ وعَرَقٌ، فقال: \"أين السائلُ؟\" فقال: ها أنا ذا، ولم أُرِدْ إلَّا خَيرًا، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: \"إنَّ الخَيرَ لا يأْتي إلَّا بالخَيرِ، إنَّ الخَيرَ لا يأْتي إلَّا بالخَيرِ، إنَّ الخَيرَ لا يأْتي إلَّا بالخَيرِ، ولكنَّ الدُّنْيا خَضِرةٌ حُلوةٌ، وكلَّما يُنبِتُ الرَّبيعُ يَقتُلُ حَبَطًا، أو يُلِمُّ إلَّا آكِلةَ الخَضِرِ؛ فإنَّها أكَلتْ حتى امتَدَّتْ خاصِرَتاها، واستَقبَلتِ الشَّمسَ فثَلَطتْ وبالَتْ، ثم عادتْ، فأكَلتْ، فمَن أخَذها بحقِّها بورِكَ له فيه، ",["ومَن أخَذها بغيرِ حقِّها ",1],["لم يُبارَكْ له، وكان كالذي يأكُلُ ولا يَشبَعُ\"",2],"، قال عبدُ اللهِ: قال أبي: قال سُفيانُ: وكان الأَعمَشُ يَسأَلُني عن هذا الحديثِ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1465)، ومسلم (1052)، وابن ماجه (3995)، وأحمد (11035) واللفظ له","bab":"فتن › فتنة المال","dorar":"svArXOUo"},{"id":"س-07333","fp":"ef499edc2d5c","stateId":24,"easy":"إذا سألت الناس ← تكون كالآكل الذي لا يشبع","cause":"ومَنْ سَأَلَ النَّاسَ أَعْطوهُ، والسَّائلُ منها","result":"كالآكِلِ ولا يَشبَعُ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 2164","srcLabel":"البخاري","text":["عَنْ خَالِدِ بْنِ حِزَامٍ أنَّ حَكيمَ بنَ حِزامٍ أغارَ بفَرَسينِ يومَ خَيبرَ، فأُصِيبا، فأَتى رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: أُصيبَ فَرَساي يا رسولَ اللهِ، فأَعطاهُ، ثُمَّ استزادَهُ، فزادَهُ، ثُمَّ استزادَهُ، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا حكيمُ، إنَّ هذا المالَ خَضِرةٌ حُلوةٌ، ",["ومَنْ سَأَلَ النَّاسَ أَعْطوهُ، والسَّائلُ منها",1]," ",["كالآكِلِ ولا يَشبَعُ",2],"."],"grade":"صحيح","narrator":"حكيم بن حزام","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن عساكر في ((تاريخ دمشق)) (15/ 110) بلفظه، والبخاري (1427) بنحوه.","bab":"فتن › فتنة المال","dorar":"NbkINZxD"},{"id":"س-08423","fp":"db47e3be7d49","stateId":24,"easy":"إذا أخذت المال بتطلّع نفس ← لا يُبارك لك فيه وتكون كالذي يأكل ولا يشبع","cause":"ومَن أخَذه بإشرافِ نفسٍ","result":"لم يُبارَكْ له فيه وكان كالَّذي يأكُلُ ولا يشبَعُ","explicit":true,"repOf":"س-05547","ref":"صحيح ابن حبان 3220","text":["سأَلْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم فأعطاني ثمَّ سأَلْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم فأعطاني ثمَّ سأَلْتُه فأعطاني ثمَّ سأَلْتُ فأعطاني ثمَّ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ( يا حكيمُ بنَ حِزامٍ إنَّ هذا المالَ حُلْوةٌ خضِرةٌ فمَن أخَذه بسخاوة نفسٍ بورِك له فيه ",["ومَن أخَذه بإشرافِ نفسٍ",1]," ",["لم يُبارَكْ له فيه وكان كالَّذي يأكُلُ ولا يشبَعُ",2]," واليدُ العليا خيرٌ مِن اليدِ السُّفلى ) قال حكيمٌ: فقُلْتُ: يا رسولَ اللهِ والَّذي بعَثك بالحقِّ لا أرزَأُ أحدًا بعدَك شيئًا حتَّى أُفارقَ الدُّنيا قال عروةُ وسعيدٌ: فكان أبو بكرٍ يدعو حكيمًا فيُعطيه العطاءَ فيأبى ثمَّ كان عمرُ بنُ الخطَّابِ يُعطيه فيأبى فيقولُ عمرُ: إنِّي أُشهِدُكم يا معشرَ المسلِمينَ على حكيمِ بنِ حزامٍ أنِّي أعرِضُ عليه حقَّه الَّذي قُسِم له مِن هذا الفَيءِ فيأبى يأخُذُه قال: فلم يرزَأْ حكيمٌ أحدًا مِن النَّاسِ بعدَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم حتَّى توفِّي \nقال عروةُ وسعيدٌ: فكان أبو بكرٍ يدعو حكيمًا فيُعطيه العطاءَ فيأبى ثمَّ كان عمرُ بنُ الخطَّابِ يُعطيه فيأبى فيقولُ عمرُ: إنِّي أُشهِدُكم يا معشرَ المسلِمينَ على حكيمِ بنِ حِزامٍ أنِّي أعرِضُ عليه حقَّه الَّذي قُسِم له مِن هذا الفَيءِ فيأبى يأخُذُه قال: فلم يرزَأْ حكيمٌ أحدًا مِن النَّاسِ بعدَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم حتَّى توفِّي"],"grade":"صحيح","narrator":"حكيم بن حزام","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (1472) بلفظ مقارب، والترمذي (2463)، والنسائي (2603)","bab":"مناقب وفضائل › فضائل جمع من الصحابة والتابعين","dorar":"I6zFyIEk"},{"id":"س-05435","fp":"ad625f24a2cb","stateId":24,"easy":"إذا ألححت في السؤال ← لا يُبارك لك فيما تأخذ","cause":"لا تُلْحِفوا في المَسألةِ","result":"واللهِ لا يَسألُني أَحدٌ منكم شيئًا، فتُخرِجَه له مِنِّي المَسألةُ، فأُعطيَهُ إيَّاهُ، وأنا كارِهٌ، فيُبارَكَ له في الَّذي أُعطيهِ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 2399","srcLabel":"مسلم","text":[["لا تُلْحِفوا في المَسألةِ",1],"؛ ",["واللهِ لا يَسألُني أَحدٌ منكم شيئًا، فتُخرِجَه له مِنِّي المَسألةُ، فأُعطيَهُ إيَّاهُ، وأنا كارِهٌ، فيُبارَكَ له في الَّذي أُعطيهِ",2],"."],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (1038)، والنسائي (593)، وأحمد (16893) جميعهم بلفظه.","bab":"رقائق وزهد › الحياء","dorar":"4RW5NtwK","merged":2,"otherRefs":["تخريج صحيح ابن حبان 3389 (صحيح)"]},{"id":"س-00579","fp":"7fa989ce6089","stateId":24,"easy":"إذا أخذت العطاء بالسؤال والحرص ← تكون كالذي يأكل ولا يشبع","cause":"ومَن أعطَيْتُه عن مسألةٍ وعن شَرَهٍ","result":"كان كالَّذي يأكُلُ ولا يشبَعُ","explicit":true,"repOf":"س-05547","ref":"تخريج صحيح ابن حبان 3401","text":["إيَّاكم وأحاديثَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم إلَّا حديثًا كان في عهدِ عمرَ فإنَّ عمرَ كان يُخيفُ النَّاسَ في اللهِ، سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( مَن يُرِدِ اللهُ به خيرًا يُفقِّهْه في الدِّينِ ) وسمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( إنَّما أنا خازنٌ فمَن أعطَيْتُه عن طِيبِ نفسٍ يُبارَكُ له فيه ",["ومَن أعطَيْتُه عن مسألةٍ وعن شَرَهٍ",1]," ",["كان كالَّذي يأكُلُ ولا يشبَعُ",2]," )"],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"إسناده صحيح على شرط مسلم","bab":"آداب عامة › ضرب الأمثال","dorar":"73lOtpDE"},{"id":"س-07327","fp":"b75a58651de4","stateId":24,"easy":"إذا أخذت المال بغير حقه ← تكون كالآكل الذي لا يشبع، ويشهد عليك يوم القيامة","cause":"ومَن لَم يَأخُذْه بحَقِّه","result":"فهو كالآكِلِ الذي لا يَشبَعُ، ويَكونُ عليه شَهيدًا يَومَ القيامةِ","explicit":true,"repOf":"س-05547","otherNeedIds":[70],"ref":"صحيح البخاري 2842","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قامَ على المِنبَرِ، فقال: إنَّما أخشى علَيكُم مِن بَعدي ما يُفتَحُ علَيكُم مِن بَرَكاتِ الأرضِ، ثُمَّ ذَكَرَ زَهرةَ الدُّنيا، فبَدَأ بإحداهما، وثَنَّى بالأُخرى، فقامَ رَجُلٌ فقال: يا رَسولَ اللهِ، أويَأتي الخَيرُ بالشَّرِّ؟! فسَكَتَ عنه النَّبيُّ صلَّى اللهُ عليه وسلَّم، قُلنا: يوحى إليه، وسَكَتَ النَّاسُ كَأنَّ على رُؤوسِهمُ الطَّيرَ، ثُمَّ إنَّه مَسَحَ عن وجههِ الرُّحَضاءَ، فقال: أينَ السَّائِلُ آنِفًا؟ أوخَيرٌ هو؟! -ثَلاثًا- إنَّ الخَيرَ لا يَأتي إلَّا بالخَيرِ، وإنَّه كُلَّما يُنبِتُ الرَّبيعُ ما يَقتُلُ حَبَطًا أو يُلِمُّ، إلَّا آكِلةَ الخَضِرِ، أكَلَت حتَّى إذا امتَلَأت خاصِرَتاها، استَقبَلَتِ الشَّمسَ، فثَلَطَت وبالَت، ثُمَّ رَتَعَت، وإنَّ هذا المالَ خَضِرةٌ حُلوةٌ، ونِعمَ صاحِبُ المُسلِمِ لمَن أخَذَه بحَقِّه، فجَعَلَه في سَبيلِ اللهِ، واليَتامى والمَساكينِ وابنِ السَّبيلِ، ",["ومَن لَم يَأخُذْه بحَقِّه",1],"، ",["فهو كالآكِلِ الذي لا يَشبَعُ، ويَكونُ عليه شَهيدًا يَومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1052) باختلاف يسير","bab":"فتن › فتنة المال","dorar":"m0vV0BCu"},{"id":"س-08119","fp":"280590a0d75f","stateId":24,"easy":"إذا فتحت باب سؤال تريد الكثرة ← يزيدك الله قلة","cause":"وما فَتَحَ بابَ مَسأَلةٍ يُريدُ بها كثْرَةً","result":"إلَّا زادَه اللهُ بها قِلَّةً","explicit":true,"ref":"مجمع الزوائد 8/192","srcLabel":"مسلم","text":["أنَّ رَجُلًا شَتَمَ أبا بَكرٍ والنَّبيُّ صلَّى اللهُ عليه وسلَّم جالِسٌ، فجَعَلَ النَّبيُّ صلَّى اللهُ عليه وسلَّم يَعجَبُ ويَبتَسِمُ، فلمَّا أكثَرَ رَدَّ عليه بعضَ قَولِه، فغَضِبَ النَّبيُّ صلَّى اللهُ عليه وسلَّم وقامَ، فلَحِقَه أبو بَكرٍ، فقال: يا رسولَ اللهِ، كان يَشتُمُني وأنتَ جالِسٌ، فلمَّا رَدَدتُ عليه بعضَ قَولِه، غَضِبتَ وقُمتَ! قال: إنَّه كان معك مَلَكٌ يَرُدُّ عنك، فلمَّا رَدَدتَ عليه بعضَ قَولِه، وَقَعَ الشَّيطانُ، فلم أكُنْ لِأَقعُدَ مع الشَّيطانِ، ثم قال: يا أبا بَكرٍ، ثلاثٌ كُلُّهن حَقٌّ: ما مِن عَبدٍ ظُلِمَ بمَظلَمَةٍ فيُغْضي عنها للهِ عزَّ وجلَّ، إلَّا أعزَّ اللهُ بها نَصْرَه، وما فَتَحَ رَجُلٌ بابَ عَطيَّةٍ يُريدُ بها صِلَةً، إلَّا زادَه بها كثْرَةً، ",["وما فَتَحَ بابَ مَسأَلةٍ يُريدُ بها كثْرَةً",1],"، ",["إلَّا زادَه اللهُ بها قِلَّةً",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (9624) بلفظه، ومسلم (2588)، والترمذي (2029) بنحوه.","bab":"ملائكة › أعمال الملائكة","dorar":"LZZkcHK6"},{"id":"س-06051","fp":"9ad7d33d92cc","stateId":24,"easy":"إذا فتحت باب سؤال الناس ← يفتح الله عليك باب فقر","cause":"ولا فتح عبدٌ بابَ مسألةٍ","result":"إلا فتح اللهُ عليهِ باب فقرٍ","explicit":true,"ref":"هداية الرواة 5217","srcLabel":"الترمذي","text":["أنهُ سمع رسولَ اللهِ - صلَّى اللهُ عليهِ وسلَّمَ - يقول : ثلاثٌ أُقسِم عليهنَّ، وأحدِّثُكم حديثًا فاحفظوهُ : فأما الذي أُقسمُ عليهنَّ ؛ فإنهُ ما نقص مالُ عبدٍ من صدقةٍ، ولا ظُلم عبدٌ مظلمةً صبر عليها ؛ إلا زادهُ اللهُ بها عزًّا، ",["ولا فتح عبدٌ بابَ مسألةٍ",1]," ؛ ",["إلا فتح اللهُ عليهِ باب فقرٍ",2]," . وأما الذي أُحدِّثُكمْ فاحفظوهُ ؛ فقال : إنما الدنيا لأربعةِ نفرٍ : عبدٌ رزقهُ اللهُ مالًا وعلمًا ؛ فهو يتَّقي فيهِ ربَّهُ، ويصلُ فيهِ رحمَهُ، ويعمل للهِ فيهِ بحقِّهِ ؛ فهذا بأفضلِ المنازلِ . وعبدٌ رزقهُ اللهُ علمًا ولمْ يرزقْهُ مالًا ؛ فهو صادقُ النيةِ يقول : لو أنَّ لي مالًا لعملتُ بعملِ فلانٍ ؛ فهو ونيتُهُ، فأجرُهما سواءٌ . وعبدٌ رزقَهُ اللهُ مالًا ولم يرزقْهُ علمًا ؛ فهو يتخبَّطُ في مالِهِ بغيرِ علمٍ ؛ لا يتَّقي فيهِ ربَّهُ، ولا يصلُ فيهِ رحمَهُ، ولا يعملُ فيهِ بحقٍّ ؛ فهذا بأخبثِ المنازلِ . وعبدٌ لم يرزقْهُ اللهُ مالًا ولا علمًا ؛ فهو يقولُ : لو أنَّ لي مالًا لعملتُ فيهِ بعملِ فلانٍ ؛ فهو بنيتهِ، فوِزْرُهما سواءٌ ."],"grade":"صحيح","narrator":"أبو كبشة الأنماري","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (2325)، وأحمد (18031)، والبغوي في ((شرح السنة)) (4097) باختلاف يسير.","bab":"رقائق وزهد › فضل الصبر","dorar":"qb3b13Vo","merged":7,"otherRefs":["نيل الأوطار 7/177 (صحيح)","مختصر المقاصد 914 (صحيح)","مسند عمر 1/20 (صحيح)","السلسلة الصحيحة 2543 (صحيح)","تخريج صحيح ابن حبان 3387 (صحيح)","صحيح الجامع 3025 (صحيح)"]},{"id":"س-05623","fp":"6372bef3a450","stateId":24,"easy":"إذا طمعت ← فالطمع فقر حاضر","cause":"وإيَّاكَ والطَّمَعَ","result":"فَإِنَّهُ فقْرٌ حاضِرٌ","explicit":true,"ref":"مجمع الزوائد 4/224","srcLabel":"أحمد","text":["عن سعدٍ أنه قال لابْنِهِ عندَ الموتِ يا بُنَيَّ إِنَّكَ لن تلْقَ أحدًا هو أنصَحُ لكَ مِنِّي إذا أردتَّ أن تصلِّيَ فأَحْسِنْ وضوءَكَ ثمَّ صَلِّ صلاةً لا تَرَى أنكَ تُصَلِّي بعدَها ",["وإيَّاكَ والطَّمَعَ",1]," ",["فَإِنَّهُ فقْرٌ حاضِرٌ",2]," وعليكَ بِالإيَاسِ فَإِنَّهُ الغِنَى وَإِيَّاكَ ومَا يُعْتَذَرُ إليه من العملِ والقولِ واعملْ ما بدا لَكَ"],"grade":"صحيح","narrator":"[عكرمة بن خالد]","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد في ((الزهد)) (1017)، والطبراني في ((الكبير)) (1/ 142) (312) باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"E5nBmYmi","merged":2,"otherRefs":["الترغيب والترهيب 2/44 (صحيح)"]},{"id":"س-05631","fp":"fcb0161f9c5b","stateId":24,"easy":"إذا أخذت العطاء بغير طيب نفس من معطيه وبتطلّع نفس ← لا يُبارك لك فيه","cause":"ومَنْ أَعْطَيْناهُ مِنْها شيئًا بغيرِ طِيبِ نَفْسٍ مِنَّا ، وحَسَنِ طُعْمَةٍ مِنْهُ ، وإِشْرَافِ نَفْسٍ","result":"كان غيرَ مُبارَكٍ لهُ فيهِ","explicit":true,"repOf":"س-05547","ref":"صحيح الموارد 704","text":["إِنَّ الدُّنِيا خَضِرَةٌ حُلوَةٌ ، فمَنْ أَعْطَيْناهُ مِنْها شيئًا بِطِيبِ نَفْسٍ مِنَّا ، وحَسَنِ طُعْمَةٍ مِنْهُ ، من غَيْرِ شرفٍ – أوْ من غَيْرِ شَرِهِ – نَفْسٍ ؛ بُورِكَ لهُ فيهِ ، ",["ومَنْ أَعْطَيْناهُ مِنْها شيئًا بغيرِ طِيبِ نَفْسٍ مِنَّا ، وحَسَنِ طُعْمَةٍ مِنْهُ ، وإِشْرَافِ نَفْسٍ ؛ ",1],["كان غيرَ مُبارَكٍ لهُ فيهِ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (24394)، والبزار كما في ((كشف الأستار)) للهيثمي (920)، وابن حبان (3215) باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"J6fLaULp","merged":2,"otherRefs":["تخريج المسند لشعيب 24394 (حسن)"]},{"id":"س-05603","fp":"f500b6d4f4ff","stateId":24,"easy":"إذا طمعت فيما بأيدي الناس ← فهو الفقر الحاضر، واليأس منه غنى","cause":"عليكَ بالإِياسِ ممَّا في أيْدي النَّاسِ، وإيَّاكَ والطَّمَعَ","result":"فإنَّه الفَقْرُ الحاضِرُ، وصَلِّ صلاتَكَ وأنتَ مُوَدِّعٌ، وإيَّاكَ وما تَعتذِرُ مِنه","explicit":true,"otherNeedIds":[10],"ref":"المستدرك على الصحيحين 8141","srcLabel":"الطبراني","text":["جاءَ رجُلٌ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فقال: يا رسولَ اللهِ، أوْصِني وأَوْجِزْ، فقالَ له النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",["عليكَ بالإِياسِ ممَّا في أيْدي النَّاسِ، وإيَّاكَ والطَّمَعَ؛ ",1],["فإنَّه الفَقْرُ الحاضِرُ، وصَلِّ صلاتَكَ وأنتَ مُوَدِّعٌ، وإيَّاكَ وما تَعتذِرُ مِنه",2],"."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني (1/ 142) (312)، وأبو نعيم في ((معرفة الصحابة)) (3226) بلفظه.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"ALLEN2jG"},{"id":"س-06210","fp":"80dfb5a9615e","stateId":24,"easy":"إذا سألت الناس من غير حاجة ← يفتح الله عليك باب فاقة من حيث لا تحتسب","cause":"من فتح على نفسِه بابَ مسألةٍ من غيرِ فاقةٍ نزلَت به أو عيالٍ لا يُطيقُهم","result":"فتح اللهُ عليه بابَ فاقةٍ من حيثُ لا يحتسبُ","explicit":true,"ref":"مسند عمر 1/18","srcLabel":"البيهقي","text":[["من فتح على نفسِه بابَ مسألةٍ من غيرِ فاقةٍ نزلَت به أو عيالٍ لا يُطيقُهم ",1],["فتح اللهُ عليه بابَ فاقةٍ من حيثُ لا يحتسبُ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبري في ((مسند عمر)) (22)، والبيهقي في ((شعب الإيمان)) (3526)","bab":"سؤال › من تحل له المسألة","dorar":"SqhHEUcI"},{"id":"س-07339","fp":"93b0cbff7b64","stateId":24,"easy":"إذا سألت الناس ← فهو آخر الكسب، ومن سأل ترك كسبه","cause":"والمسألةَ","result":"فإنَّها آخِرُ كسْبِ المرْءِ، وإنَّ أحَدًا لم يسأَلْ إلَّا ترَكَ كسْبَه","explicit":true,"ref":"تهذيب الكمال 15/324","srcLabel":"الطبراني","text":["أتَيْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فلمَّا دَنَوْتُ منه سمِعْتُه يقول: هذا سيِّدُ أهْلِ الوبَرِ، فسلَّمْتُ وجلَسْتُ، فقلْتُ: يا رسولَ اللهِ، المالُ الَّذي لا يكونُ عليَّ فيه تَبِعَةٌ مِن ضعيفٍ ضافَنِي، أو عيالٍ إنْ كثُرُوا؟ قال: نِعْمَ المالُ أربعونُ مِن الإبلِ، والكثيرُ سِتُّونَ، وويلٌ لأصحابِ المِئينَ، إلَّا مَن أَعْطَى في رِسْلِها ونجْدَتِها، وأفقَرَ ظهْرَها، وأطْرَقَ فَحْلَها، ونحَرَ سَمِينَها، وأطْعَمَ القانِعَ والمُعْتَرَّ. قلت: يا رسولَ اللهِ، ما أكْرَمَ هذه الأخلاقَ وأحسَنَها، إنَّه لا يُحَلُّ بالوادي الَّذي أنا فيه مِن كثْرَةِ إبِلِي؟ قال: فكيف تصنَعُ بالمَنِيحَةِ؟ قلْتُ: إنِّي لأمْنَحُ في كلِّ عامٍ مِئَةً. قال: فكيف تصنَعُ بالعاريةِ؟ قلْتُ: تغْدُو الإبلُ ويغْدُو النَّاسُ، فمَن أخَذَ برأْسِ بعيرٍ ذهَبَ به. قال: فكيف تصنَعُ بالأفقارِ؟ قال: إنِّي أُفْقِرُ البِكْرَ الضَّرْعَ والنَّابَ المُدبرَ. قال: مالُك أحبُّ إليك أم مالُ مَوْلاك؟ قلْتُ: بلْ مالِي. قال: فإنَّما لك مِن مالِكَ ما أكَلْتَ فأفْنَيْتَ، أو لَبِسَت فأبْلَيْتَ، أو أعطَيْتَ فأمضَيْتَ، وما بَقِيَ فلِمولاكَ. قلْتُ: لِمَولايَ؟ قال: نعم. قلْتُ: واللهِ لئن بَقِيتُ لأدَعَنَّ عِدَّتَها قليلةً. قال الحسَنُ: ففعَلَ رحِمَه اللهُ. فلمَّا حضَرَتْه الوفاةُ دعا بَنِيه، فقال: يا بَنِيَّ، خُذُوا عنِّي؛ فلا أجِدُ أنصَحَ لكم مِنِّي، إذا أنا مِتُّ فسَوِّدُوا أكابرَكم، ولا تُسَوِّدُوا أصاغِرَكم، فَيَسْتَسْفِهَ النَّاسُ كِبارَكم، وتَهُونوا عليهم. وعليكم باستصلاحِ المالِ؛ فإنَّه مَنْبَهَةٌ للكريمِ، ويُسْتَغْنَى به عنِ اللَّئيمِ. وإيَّاكم ",["والمسألةَ",1],"؛ ",["فإنَّها آخِرُ كسْبِ المرْءِ، وإنَّ أحَدًا لم يسأَلْ إلَّا ترَكَ كسْبَه",2],". فإذا أنا مِتُّ فكَفِّنوني في ثِيابي الَّتي كنْتُ أُصَلِّي فيها وأصومُ. وإيَّاكم والنِّياحةَ عليَّ؛ فإنِّي سمِعْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ ينهى عنها. وادْفِنوني في مكانٍ لا يعلَمُ به أحدٌ؛ فإنَّه قد كانت بيننا وبين بكْرِ بنِ وائلٍ خُماشاتٌ في الجاهليَّةِ، وأخافُ أنْ يُدْخِلوها عليكم في الإسلامِ، فيَعيثُوا عليكم دينَكم."],"grade":"حسن","narrator":"قيس بن عاصم","muhaddith":"حسن","takhrij":"أخرجه الطبراني (18/339) (870) باختلاف يسير.","bab":"فتن › فتنة المال","dorar":"k4pllV8f","merged":2,"otherRefs":["إتحاف الخيرة المهرة 2/418 (حسن)"]},{"id":"س-07390","fp":"abeab9ada095","stateId":24,"easy":"إذا فتحت باب سؤال تبتغي به الكثرة ← يزيدك الله به قلة","cause":"وليس عبدٌ يَفتَحُ بابَ مَسألةٍ يَبْتَغي بها كَثرةً","result":"إلَّا زادَه بها قِلَّةً","explicit":true,"ref":"تخريج شرح السنة 3586","srcLabel":"أحمد","text":["أنَّ رجُلًا سبَّ أبا بَكرٍ عندَ النَّبِيِّ صلَّى اللهُ عليه وسلَّمَ، والنَّبِيُّ صلَّى اللهُ عليه وسلَّمَ جالسٌ لا يقولُ شيئًا، فلمَّا سكَتَ، ذهَبَ أبو بَكرٍ يَتكلَّمُ، فقام رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ واتَّبَعَه أبو بَكرٍ، فقال: يا رَسولَ اللهِ، كان يَسُبُّني، وأنتَ جالسٌ، فلمَّا ذهبْتُ أتكلَّمُ، قُمْتَ.\nقال: إنَّ المَلَكَ كان يرُدُّ عنكَ، فلمَّا تَكلَّمتَ، ذهبَ المَلَكُ، ووقَعَ الشيطانُ، وكَرِهتُ أنْ أجلِسَ يا أبا بَكرٍ، ثلاثٌ كُلُّهنَّ حقٌّ: ليس عبدٌ يُظلَمُ بمَظلَمةٍ، فيُغْضي عنها إلَّا أعَزَّ اللهُ بها نَصْرَه، ",["وليس عبدٌ يَفتَحُ بابَ مَسألةٍ يَبْتَغي بها كَثرةً",1]," ",["إلَّا زادَه بها قِلَّةً",2],"، وليس عبدٌ يَفتَحُ بابَ عَطيَّةٍ يَبْتَغي بها وَجهَ اللهِ أو صِلةً إلَّا زادَه اللهُ به كَثرةً."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (9624)، والطبراني في ((المعجم الأوسط)) (7239)، والخطيب البغدادي في ((الأسماء المبهمة)) (3/ 164).","bab":"فضائل النبي وصفته ودلائل النبوة › أخلاق النبي","dorar":"S7DHCIPU"},{"id":"س-05795","fp":"7a475bd3d405","stateId":24,"easy":"إذا طمعت ← فالطمع هو الفقر الحاضر","cause":"إيَّاكمْ و الطمعَ","result":"فإنَّه هوَ الفقرُ الحاضرُ، و إيَّاكمْ و مَا يعتذرُ منهُ","explicit":true,"otherNeedIds":[10],"ref":"الجامع الصغير 2912","srcLabel":"الطبراني","text":[["إيَّاكمْ و الطمعَ،  ",1],["فإنَّه هوَ الفقرُ الحاضرُ،  و إيَّاكمْ و مَا يعتذرُ منهُ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((الأوسط)) (7753) بلفظه.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"mXSoxoKE"},{"id":"ق-0276","fp":"6780693b0ca2","stateId":25,"easy":"الظلم والصد عن سبيل الله وأخذ الربا وأكل أموال الناس بالباطل ← تحريم طيبات أُحلّت وعذاب أليم","cause":"الظلم والصد عن سبيل الله وأخذ الربا وأكل أموال الناس بالباطل","result":"تحريم طيبات أُحلّت وعذاب أليم","explicit":true,"star":true,"otherNeedIds":[70],"ref":"سورة النساء: 160–161","srcLabel":"القرآن الكريم","quran":{"s":4,"from":160,"to":161,"text":"فَبِظُلْمٍ مِنَ الَّذِينَ هَادُوا حَرَّمْنَا عَلَيْهِمْ طَيِّبَاتٍ أُحِلَّتْ لَهُمْ وَبِصَدِّهِمْ عَنْ سَبِيلِ اللَّهِ كَثِيرًا (160) وَأَخْذِهِمُ الرِّبَا وَقَدْ نُهُوا عَنْهُ وَأَكْلِهِمْ أَمْوَالَ النَّاسِ بِالْبَاطِلِ وَأَعْتَدْنَا لِلْكَافِرِينَ مِنْهُمْ عَذَابًا أَلِيمًا (161)","hl":[[0,277,1]]}},{"id":"ق-0383","fp":"356d6fa90906","stateId":25,"easy":"البغي ← تحريم الطيبات","cause":"البغي","result":"تحريم الطيبات","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"سورة الأنعام: 146","srcLabel":"القرآن الكريم","quran":{"s":6,"from":146,"to":146,"text":"وَعَلَى الَّذِينَ هَادُوا حَرَّمْنَا كُلَّ ذِي ظُفُرٍ وَمِنَ الْبَقَرِ وَالْغَنَمِ حَرَّمْنَا عَلَيْهِمْ شُحُومَهُمَا إِلَّا مَا حَمَلَتْ ظُهُورُهُمَا أَوِ الْحَوَايَا أَوْ مَا اخْتَلَطَ بِعَظْمٍ ذَلِكَ جَزَيْنَاهُمْ بِبَغْيِهِمْ وَإِنَّا لَصَادِقُونَ (146)","hl":[[196,229,1]]}},{"id":"ق-0423","fp":"3b74624590d7","stateId":25,"easy":"التكذيب والاستكبار والتطيّر بالمؤمنين (آل فرعون) ← السنون ونقص الثمرات والطوفان والجراد والقمّل والضفادع والدم","cause":"التكذيب والاستكبار والتطيّر بالمؤمنين (آل فرعون)","result":"السنون ونقص الثمرات والطوفان والجراد والقمّل والضفادع والدم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[56],"ref":"سورة الأعراف: 130–133","srcLabel":"القرآن الكريم","quran":{"s":7,"from":130,"to":133,"text":"وَلَقَدْ أَخَذْنَا آلَ فِرْعَوْنَ بِالسِّنِينَ وَنَقْصٍ مِنَ الثَّمَرَاتِ لَعَلَّهُمْ يَذَّكَّرُونَ (130) فَإِذَا جَاءَتْهُمُ الْحَسَنَةُ قَالُوا لَنَا هَذِهِ وَإِنْ تُصِبْهُمْ سَيِّئَةٌ يَطَّيَّرُوا بِمُوسَى وَمَنْ مَعَهُ أَلَا إِنَّمَا طَائِرُهُمْ عِنْدَ اللَّهِ وَلَكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ (131) وَقَالُوا مَهْمَا تَأْتِنَا بِهِ مِنْ آيَةٍ لِتَسْحَرَنَا بِهَا فَمَا نَحْنُ لَكَ بِمُؤْمِنِينَ (132) فَأَرْسَلْنَا عَلَيْهِمُ الطُّوفَانَ وَالْجَرَادَ وَالْقُمَّلَ وَالضَّفَادِعَ وَالدَّمَ آيَاتٍ مُفَصَّلَاتٍ فَاسْتَكْبَرُوا وَكَانُوا قَوْمًا مُجْرِمِينَ (133)","hl":[[0,565,1]]}},{"id":"ق-0471","fp":"c3053da49aac","stateId":25,"easy":"تغيير ما بالأنفس (كفران النعمة) ← تغيير النعمة وزوالها","cause":"تغيير ما بالأنفس (كفران النعمة)","result":"تغيير النعمة وزوالها","explicit":true,"star":true,"otherNeedIds":[56],"ref":"سورة الأنفال: 53","srcLabel":"القرآن الكريم","quran":{"s":8,"from":53,"to":53,"text":"ذَلِكَ بِأَنَّ اللَّهَ لَمْ يَكُ مُغَيِّرًا نِعْمَةً أَنْعَمَهَا عَلَى قَوْمٍ حَتَّى يُغَيِّرُوا مَا بِأَنْفُسِهِمْ وَأَنَّ اللَّهَ سَمِيعٌ عَلِيمٌ (53)","hl":[[0,115,1]]}},{"id":"ق-0638","fp":"8868cdde80fc","stateId":25,"easy":"كفران النعمة ← العذاب الشديد","cause":"كفران النعمة","result":"العذاب الشديد","explicit":true,"otherNeedIds":[56],"ref":"سورة إبراهيم: 7","srcLabel":"القرآن الكريم","quran":{"s":14,"from":7,"to":7,"text":"وَإِذْ تَأَذَّنَ رَبُّكُمْ لَئِنْ شَكَرْتُمْ لَأَزِيدَنَّكُمْ وَلَئِنْ كَفَرْتُمْ إِنَّ عَذَابِي لَشَدِيدٌ (7)","hl":[[62,106,1]]}},{"id":"ق-0685","fp":"ebeebde1d208","stateId":25,"easy":"كفران أنعم الله ← لباس الجوع والخوف بعد الأمن والرزق الرغد","cause":"كفران أنعم الله","result":"لباس الجوع والخوف بعد الأمن والرزق الرغد","explicit":true,"otherNeedIds":[10],"ref":"سورة النحل: 112","srcLabel":"القرآن الكريم","quran":{"s":16,"from":112,"to":112,"text":"وَضَرَبَ اللَّهُ مَثَلًا قَرْيَةً كَانَتْ آمِنَةً مُطْمَئِنَّةً يَأْتِيهَا رِزْقُهَا رَغَدًا مِنْ كُلِّ مَكَانٍ فَكَفَرَتْ بِأَنْعُمِ اللَّهِ فَأَذَاقَهَا اللَّهُ لِبَاسَ الْجُوعِ وَالْخَوْفِ بِمَا كَانُوا يَصْنَعُونَ (112)","hl":[[0,217,1]]}},{"id":"ق-0731","fp":"a0ab63b73e7c","stateId":25,"easy":"العجب بالمال والكبر والشرك وإنكار البعث ← هلاك الثمر والندم ولا فئة تنصره","cause":"العجب بالمال والكبر والشرك وإنكار البعث","result":"هلاك الثمر والندم ولا فئة تنصره","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[57,44],"ref":"سورة الكهف: 42–43","srcLabel":"القرآن الكريم","quran":{"s":18,"from":42,"to":43,"text":"وَأُحِيطَ بِثَمَرِهِ فَأَصْبَحَ يُقَلِّبُ كَفَّيْهِ عَلَى مَا أَنْفَقَ فِيهَا وَهِيَ خَاوِيَةٌ عَلَى عُرُوشِهَا وَيَقُولُ يَا لَيْتَنِي لَمْ أُشْرِكْ بِرَبِّي أَحَدًا (42) وَلَمْ تَكُنْ لَهُ فِئَةٌ يَنْصُرُونَهُ مِنْ دُونِ اللَّهِ وَمَا كَانَ مُنْتَصِرًا (43)","hl":[[0,254,1]]}},{"id":"ق-0927","fp":"c0d3929c9f79","stateId":25,"easy":"نسبة النعمة إلى النفس والبغي والعُجب بالمال ← الخسف به وبداره ولا فئة تنصره","cause":"نسبة النعمة إلى النفس والبغي والعُجب بالمال","result":"الخسف به وبداره ولا فئة تنصره","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[56,44],"ref":"سورة القصص: 78–81","srcLabel":"القرآن الكريم","quran":{"s":28,"from":78,"to":81,"text":"قَالَ إِنَّمَا أُوتِيتُهُ عَلَى عِلْمٍ عِنْدِي أَوَلَمْ يَعْلَمْ أَنَّ اللَّهَ قَدْ أَهْلَكَ مِنْ قَبْلِهِ مِنَ الْقُرُونِ مَنْ هُوَ أَشَدُّ مِنْهُ قُوَّةً وَأَكْثَرُ جَمْعًا وَلَا يُسْأَلُ عَنْ ذُنُوبِهِمُ الْمُجْرِمُونَ (78) فَخَرَجَ عَلَى قَوْمِهِ فِي زِينَتِهِ قَالَ الَّذِينَ يُرِيدُونَ الْحَيَاةَ الدُّنْيَا يَا لَيْتَ لَنَا مِثْلَ مَا أُوتِيَ قَارُونُ إِنَّهُ لَذُو حَظٍّ عَظِيمٍ (79) وَقَالَ الَّذِينَ أُوتُوا الْعِلْمَ وَيْلَكُمْ ثَوَابُ اللَّهِ خَيْرٌ لِمَنْ آمَنَ وَعَمِلَ صَالِحًا وَلَا يُلَقَّاهَا إِلَّا الصَّابِرُونَ (80) فَخَسَفْنَا بِهِ وَبِدَارِهِ الْأَرْضَ فَمَا كَانَ لَهُ مِنْ فِئَةٍ يَنْصُرُونَهُ مِنْ دُونِ اللَّهِ وَمَا كَانَ مِنَ الْمُنْتَصِرِينَ (81)","hl":[[0,671,1]]}},{"id":"ق-1010","fp":"0d09c8248103","stateId":25,"easy":"الإعراض وكفران النعمة ← سيل العرم وتبديل الجنتين","cause":"الإعراض وكفران النعمة","result":"سيل العرم وتبديل الجنتين","explicit":true,"otherNeedIds":[56],"ref":"سورة سبأ: 16–17","srcLabel":"القرآن الكريم","quran":{"s":34,"from":16,"to":17,"text":"فَأَعْرَضُوا فَأَرْسَلْنَا عَلَيْهِمْ سَيْلَ الْعَرِمِ وَبَدَّلْنَاهُمْ بِجَنَّتَيْهِمْ جَنَّتَيْنِ ذَوَاتَيْ أُكُلٍ خَمْطٍ وَأَثْلٍ وَشَيْءٍ مِنْ سِدْرٍ قَلِيلٍ (16) ذَلِكَ جَزَيْنَاهُمْ بِمَا كَفَرُوا وَهَلْ نُجَازِي إِلَّا الْكَفُورَ (17)","hl":[[0,236,1]]}},{"id":"ق-1093","fp":"6992e32c7241","stateId":25,"easy":"نسبة النعمة إلى النفس (إنما أوتيته على علم) ← فتنة ولا يغني الكسب وتصيبه سيئات ما كسب","cause":"نسبة النعمة إلى النفس (إنما أوتيته على علم)","result":"فتنة ولا يغني الكسب وتصيبه سيئات ما كسب","explicit":true,"otherNeedIds":[56],"ref":"سورة الزمر: 49–51","srcLabel":"القرآن الكريم","quran":{"s":39,"from":49,"to":51,"text":"فَإِذَا مَسَّ الْإِنْسَانَ ضُرٌّ دَعَانَا ثُمَّ إِذَا خَوَّلْنَاهُ نِعْمَةً مِنَّا قَالَ إِنَّمَا أُوتِيتُهُ عَلَى عِلْمٍ بَلْ هِيَ فِتْنَةٌ وَلَكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ (49) قَدْ قَالَهَا الَّذِينَ مِنْ قَبْلِهِمْ فَمَا أَغْنَى عَنْهُمْ مَا كَانُوا يَكْسِبُونَ (50) فَأَصَابَهُمْ سَيِّئَاتُ مَا كَسَبُوا وَالَّذِينَ ظَلَمُوا مِنْ هَؤُلَاءِ سَيُصِيبُهُمْ سَيِّئَاتُ مَا كَسَبُوا وَمَا هُمْ بِمُعْجِزِينَ (51)","hl":[[0,413,1]]}},{"id":"س-00084","fp":"218c730d8f2e","stateId":25,"easy":"إذا أذنبت ← قد تُحرم الرزق بذنبك","cause":"بالذَّنبِ يُصيبُه","result":"وإنَّ العَبدَ لَيُحرَمُ الرِّزقَ","explicit":true,"similar":["س-04872"],"ref":"النوافح العطرة 143","srcLabel":"الحاكم","text":["الدعاءُ يردُّ القضاءَ [يعني حديث: إنَّ الدُّعاءَ يرُدُّ القَضاءَ، وإنَّ البِرَّ يَزيدُ في الرِّزقِ، ",["وإنَّ العَبدَ لَيُحرَمُ الرِّزقَ",2]," ",["بالذَّنبِ يُصيبُه",1],".]"],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (6038)، والطحاوي في ((مشكل الآثار)) (3069)، وقوام السنة في ((الترغيب والترهيب)) (1262) بلفظه تامًا.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"uDGZZtLv","merged":3,"otherRefs":["المستدرك على الصحيحين 1838 (صحيح)","صحيح ابن حبان 872 (صحيح)"]},{"id":"س-04872","fp":"10191c88313d","stateId":25,"easy":"إذا أذنبت ← قد تُحرم الرزق بذنبك","cause":"بذنبٍ يصيبُه","result":"إنَّ العبدَ ليُحرمُ الرزقَ","explicit":true,"repOf":"س-00084","ref":"فتاوى نور على الدرب لابن باز 11/127","text":[["إنَّ العبدَ ليُحرمُ الرزقَ",2]," ",["بذنبٍ يصيبُه",1],"."],"grade":"صحيح","narrator":"[ثوبان مولى رسول الله صلى الله عليه وسلم]","muhaddith":"صحيح","takhrij":"أخرجه أبو يعلى الموصلي في ((المعجم)) (282) بلفظه، وابن ماجه (4022)، وأحمد (22386) كلاهما بزيادة في لفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"BfvdsSOO"},{"id":"س-05359","fp":"e907d62b6142","stateId":25,"easy":"إذا أبطأ رزقك فلا تطلبه بمعصية ← فلا يُنال فضل الله بمعصيته","cause":"فلا يطلُبْه بمعصيةِ اللهِ","result":"فإنَّ اللهَ لا يُنالُ فضلُه بمعصيتِه","explicit":true,"ref":"صحيح الترغيب 1700","srcLabel":"الحاكم","text":["ليس من عملٍ يُقرِّبُ من الجنَّةِ إلا قد أمرتُكم به ، ولا من عملٍ يُقرِّبُ إلى النَّارِ إلا وقد نهيتُكم عنه ، فلا يستَبْطِئَنَّ أحدٌ منكم رزقَه ؛ فإنَّ جبريلَ ألقَى في رُوعي : أنّ أحدًا منكم لن يخرج من الدنيا حتى يستكملَ رزقَه ، فاتَّقوا اللهَ أيها الناسُ ! وأَجمِلوا في الطَّلبِ ، فإن استبطأ أحدٌ منكم رزقَه ",["فلا يطلُبْه بمعصيةِ اللهِ",1]," ؛ ",["فإنَّ اللهَ لا يُنالُ فضلُه بمعصيتِه",2]," ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح لغيره","takhrij":"أخرجه الحاكم (2136)","bab":"رقائق وزهد › التوكل واليقين","dorar":"U2AVBT0A"},{"id":"س-05056","fp":"188699ba1aef","stateId":25,"easy":"إذا وقعت في الزنا ← يورثك الفقر","cause":"الزنا","result":"يُورثُ الفقرَ","explicit":true,"ref":"شرح كتاب الشهاب 58","srcLabel":"ابن حبان","text":[["الزنا ",1],["يُورثُ الفقرَ",2],"."],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن حبان في ((المجروحين)) (2/ 231)، وابن عدي في ((الكامل)) (8/ 181)،والبيهقي في ((شعب الإيمان)) (5034 )","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"WgyJbsyR"},{"id":"س-05325","fp":"022f48121638","stateId":26,"easy":"إذا أنزلت حاجتك بالناس دون الله ← يوشك ألا تُسدّ","cause":"مَن نَزَلَتْ به فاقةٌ فأنزَلَها بالنَّاسِ","result":"كان قَمِنًا مِن ألَّا تُسَدَّ حاجتُه","explicit":true,"ref":"تخريج المسند لشعيب 4219","srcLabel":"أبو داود","text":[["مَن نَزَلَتْ به فاقةٌ فأنزَلَها بالنَّاسِ، ",1],["كان قَمِنًا مِن ألَّا تُسَدَّ حاجتُه، ",2],"ومَن أنزَلَها باللهِ عزَّ وجلَّ، أتاه اللهُ برِزقٍ عاجلٍ أو مَوتٍ آجلٍ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1645)، والترمذي (2326)، وأحمد (4219) واللفظ له","bab":"رقائق وزهد › التوكل واليقين","dorar":"ZfNY3tXQ"},{"id":"س-05671","fp":"d48f18950354","stateId":26,"easy":"إذا لم ترضَ بما قسم الله لك ← لا يُبارك لك فيه","cause":"ومَن لم يرضَ","result":"لم يباركْ له","explicit":true,"ref":"مجمع الزوائد 10/260","srcLabel":"أحمد","text":["حدَّثَني أحدُ بني سُليمٍ ولا أحسبُه إلا قد رأَى النبيَّ صلَّى اللهُ عليه وسلَّم أن اللهَ عزَّ وجلَّ يبتلِي عبدَه بما أعطاه فمَن رضِيَ بما قُسِم له باركَ اللهُ فيه ووسَّعه ",["ومَن لم يرضَ",1]," ",["لم يباركْ له",2]],"grade":"صحيح","narrator":"يزيد بن عبدالله بن الشخير أبو العلاء","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (20294)، والبيهقي في ((شعب الإيمان)) (9725)","bab":"رقائق وزهد › الصبر على البلاء","dorar":"VT06xIH5","merged":3,"otherRefs":["تخريج المسند لشعيب 20279 (صحيح)","السلسلة الصحيحة 1658 (صحيح)"]},{"id":"س-05304","fp":"7236f838cf72","stateId":26,"easy":"إذا نزلت بك حاجة فشكوتها إلى الناس ← لا تُسدّ حاجتك","cause":"مَن نَزَلتْ به فَاقةٌ ، فأَنَزَلَها بالنَّاسِ","result":"لَم تُسدَّ فاقتُه","explicit":true,"ref":"صحيح الجامع 6566","srcLabel":"أبو داود","text":[["مَن نَزَلتْ به فَاقةٌ ، فأَنَزَلَها بالنَّاسِ ، ",1],["لَم تُسدَّ فاقتُه",2]," ، و مَن نَزلَتْ به فاقةً ، فأنزلَها باللهِ ، فيُوشِكُ اللهُ له برزقٍ عاجلٍ ، أو آجلٍ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1645)، والترمذي (2326) واللفظ له، وأحمد (3696)","bab":"رقائق وزهد › التوكل واليقين","dorar":"ipIiYgSN","merged":2,"otherRefs":["المستدرك على الصحيحين 1501 (صحيح)"]},{"id":"س-05655","fp":"6aacd590d14a","stateId":26,"easy":"إذا كانت الدنيا نيتك ← يفرّق الله عليك أمرك ويجعل فقرك بين عينيك","cause":"ومَن كانَت نِيَّتُه الدُّنْيا","result":"فَرَّقَ اللهُ عليه ضَيعتَه، وجَعَلَ فَقْرَه بَيْنَ عَيْنَيه، ولم يَأتِه مِن الدُّنْيا إلَّا ما كُتِبَ له، وسَألْنا عن الصَّلاةِ الوُسْطى وهي الظُّهْرُ","explicit":true,"star":true,"similar":["س-05639","س-05542","س-05614"],"otherNeedIds":[10],"ref":"الصحيح المسند 351","srcLabel":"الصحيح المسند","text":["أنَّ زَيدَ بنَ ثابِتٍ خَرَجَ مِن عنْدِ مَرْوانَ نَحْوًا مِن نِصْفِ النَّهارِ، فقُلْنا: ما بَعَثَ إليه السَّاعةَ إلَّا لشيءٍ سَألَه عنه، فقُمْتُ إليه، فسَألْتُه، فقالَ: أجَلْ، سَألَنا عن أشْياءَ سَمِعْتُها مِن رَسولِ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ يقولُ: «نَضَّرَ اللهُ امْرَأً سَمِعَ مِنَّا حَديثًا فحَفِظَه حتَّى يُبَلِّغَه غَيْرَه؛ فإنَّه رُبَّ حامِلِ فِقْهٍ ليس بفَقيهٍ، ورُبَّ حامِلِ فِقْهٍ إلى مَن هو أَفقَهُ مِنه، ثَلاثُ خِصالٍ لا يُغِلُّ عليهن قَلْبُ مُسلِمٍ أبَدًا: إخْلاصُ العَمَلِ للهِ، ومُناصَحةُ وُلاةِ الأمْرِ، ولُزومُ الجَماعةِ؛ فإنَّ دَعْوتُهم تُحيطُ مِن وَرائِهم»، وقالَ: «مَن كانَ هَمُّه الآخِرةَ جَمَعَ اللهُ شَمْلَه، وجَعَلَ غِناه في قَلْبِه، وأَتَتْه الدُّنْيا وهي راغِمةٌ، ",["ومَن كانَت نِيَّتُه الدُّنْيا ",1],["فَرَّقَ اللهُ عليه ضَيعتَه، وجَعَلَ فَقْرَه بَيْنَ عَيْنَيه، ولم يَأتِه مِن الدُّنْيا إلَّا ما كُتِبَ له»، وسَألْنا عن الصَّلاةِ الوُسْطى وهي الظُّهْرُ",2],"."],"grade":"صحيح","narrator":"زيد بن ثابت","muhaddith":"صحيح","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"WqH1UqRw","merged":4,"otherRefs":["تخريج صحيح ابن حبان 680 (صحيح)","تخريج الإحياء للعراقي 5/88 (حسن)","هداية الرواة 5250 (صحيح)"]},{"id":"س-05606","fp":"8c57d9728dc6","stateId":26,"easy":"إذا لم تتفرغ لعبادة الله ← يملأ صدرك شغلاً ولا يسدّ فقرك","cause":"وإلَّا تَفعَلَ","result":"ملأتُ صدرَكَ شُغلًا ولمْ أَسُدَّ فقرَكَ","explicit":true,"star":true,"otherNeedIds":[10],"ref":"المستدرك على الصحيحين 3702","srcLabel":"الترمذي","text":["تلا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: {مَن كَانَ يُرِيدُ حَرْثَ الْآخِرَةِ نَزِدْ لَهُ فِي حَرْثِهِ وَمَن كَانَ يُرِيدُ حَرْثَ الدُّنْيَا نُؤْتِهِ مِنْهَا وَمَا لَهُ فِي الْآخِرَةِ مِن نَّصِيبٍ} [الشورى: 20]، ثُمَّ قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «يقولُ اللهُ عزَّ وجلَّ: ابنَ آدمَ، تَفرَّغْ لعبادتي املأْ صدرَكَ غِنًى، وأسُدَّ فقرَكَ ",["وإلَّا تَفعَلَ",1]," ",["ملأتُ صدرَكَ شُغلًا ولمْ أَسُدَّ فقرَكَ",2],"»."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في(( شعب الإيمان)) (9856) واللفظ له، والترمذي (2466)، وابن ماجه (4107) مختصرا","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"dj3wePIQ","merged":2,"otherRefs":["المستدرك على الصحيحين 8139 (صحيح)"]},{"id":"س-05639","fp":"812e3d5f45dc","stateId":26,"easy":"إذا كانت الدنيا نيتك ← يجعل الله فقرك بين عينيك ويشتّت أمرك","cause":"مَن تَكُنِ الدُّنيا نِيَّتَه","result":"يَجعَلِ اللهُ فَقرَه بَينَ عَينَيْه، ويُشَتِّتُ عليه ضَيعَتَه، ولا يأتيه منها إلَّا ما كُتِبَ له","explicit":true,"repOf":"س-05655","otherNeedIds":[10],"ref":"الترغيب والترهيب 4/162","text":["رَحِمَ اللهُ مَن سَمِعَ مَقالَتي حتى يُبَلِّغَها غَيرَه: ثَلاثٌ لا يَغِلُّ عليهِنَّ قَلبُ امرِئٍ مُسلِمٍ: إخلاصُ العَمَلِ للهِ، والنُّصحُ لِأئِمَّةِ المُسلِمينَ، واللُّزومُ لِجَماعَتِهم، فإنَّ دُعاءَهم يُحيطُ مِن وَرائِهم، إنَّه ",["مَن تَكُنِ الدُّنيا نِيَّتَه",1]," ",["يَجعَلِ اللهُ فَقرَه بَينَ عَينَيْه، ويُشَتِّتُ عليه ضَيعَتَه، ولا يأتيه منها إلَّا ما كُتِبَ له",2],"، ومَن تَكُنِ الآخِرةُ نِيَّتَه يَجعَلِ اللهُ غِناهُ في قَلبِه ويَكفيه ضَيعَتَه، وتأتيه الدُّنيا وهي راغِمةٌ."],"grade":"صحيح","narrator":"زيد بن ثابت","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (3660) باختلاف يسير دون قوله: \"ثلاث لا يغل ...\"، وابن ماجه (230، 4105) مفرقاً باختلاف يسير، وأحمد (21590) باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"jihas9WH","merged":2,"otherRefs":["صحيح الترغيب 3168 (صحيح)"]},{"id":"س-05365","fp":"62e6628ec7fa","stateId":26,"easy":"إذا أنزلت حاجتك بالناس ← لا تُسدّ حاجتك","cause":"مَن نَزَلتْ به فاقةٌ فأنزَلَها بالناسِ","result":"لم تَستَدَّ فاقَتُه","explicit":true,"ref":"مسند عمر 1/11","srcLabel":"أبو داود","text":[["مَن نَزَلتْ به فاقةٌ فأنزَلَها بالناسِ، ",1],["لم تَستَدَّ فاقَتُه، ",2],"ومَن أنزَلَها باللهِ أوشَكَ اللهُ له بالغِنى، إمَّا غِنًى عاجِلًا، وإمَّا أجَلًا عاجِلًا."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1645)، والترمذي (2326)، وأحمد (4219) باختلاف يسير، والطبري في ((مسند عمر)) (11) واللفظ له","bab":"رقائق وزهد › التوكل واليقين","dorar":"MSMqmY3j"},{"id":"س-05542","fp":"5bc0eb5a426f","stateId":26,"easy":"إذا كانت الدنيا همّك ونيّتك ← يجعل الله الفقر بين عينيك ويشتّت أمرك، ولا يأتيك إلا ما كُتب لك","cause":"من كانت الدنيا همَّتَه وسدَمَه ، ولها شَخِصٌ ، وإياها ينوي","result":"جعل اللهُ الفقرَ بين عينَيه ، وشتَّتَ عليه ضَيعتَه ، ولم يأْتِه منها إلا ما كُتب له منها","explicit":true,"repOf":"س-05655","otherNeedIds":[10],"ref":"صحيح الترغيب 1707","text":[["من كانت الدنيا همَّتَه وسدَمَه ، ولها شَخِصٌ ، وإياها ينوي ؛ ",1],["جعل اللهُ الفقرَ بين عينَيه ، وشتَّتَ عليه ضَيعتَه ، ولم يأْتِه منها إلا ما كُتب له منها ، ",2],"ومن كانت الآخرةُ هِمَّتَه وسدَمَه ، ولها شَخِصٌ ، وإياها ينوي ؛ جعل اللهُ عزَّ وجلَّ الغِنى في قلبِه ، وجمع عليه ضَيعتَه وأتَتْه الدُّنيا وهي صاغرةٌ ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن أبي الدنيا في ((الزهد)) (333)، وابن أبي عاصم في ((الزهد)) (165)، وابن حبان في ((المجروحين)) (1/328) باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"d2CDkmco"},{"id":"س-05614","fp":"06c81f5fadc4","stateId":26,"easy":"إذا كانت نيتك الدنيا ← يجعل الله الفقر بين عينيك صباحاً ومساءً","cause":"ومَنْ كانَتْ نِيَّتُهُ الدنيا","result":"جعلَ اللهُ الفقرَ بين عَيْنَيْهِ فلا يُصْبِحُ إِلَّا فَقِيرًا ولا يُمسي إِلَّا فَقِيرًا","explicit":true,"repOf":"س-05655","otherNeedIds":[10],"ref":"صحيح الترغيب 3169","text":["مَنْ كانَتْ نِيَّتُهُ الآخِرَةَ جعلَ اللهُ تباركَ وتعالى الغِنَى في قلبِهِ وجَمَعَ لهُ شَمْلهُ ونزعَ الفقرَ من بَيْنِ عَيْنَيْهِ وآتَتْهُ الدنيا وهيَ رَاغِمَةٌ فلا يُصْبِحُ إِلَّا غَنِيًّا ولا يُمسي إِلَّا غَنِيًّا ",["ومَنْ كانَتْ نِيَّتُهُ الدنيا ",1],["جعلَ اللهُ الفقرَ بين عَيْنَيْهِ فلا يُصْبِحُ إِلَّا فَقِيرًا ولا يُمسي إِلَّا فَقِيرًا",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن أبي الدنيا في ((الزهد)) (332)، والحارث في ((المسند)) (1092)، والبزار (6704) واللفظ له","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"zaERiuOm"},{"id":"س-06099","fp":"a405db6c53d6","stateId":26,"easy":"إذا لم ترضَ بما قسم الله ← لا يُبارك لك ولا تُزاد على ما كُتب لك","cause":"وإنْ لمْ يرْضَ","result":"لمْ يُبارَكْ لهُ ، ولمْ يَزِدْ على ما كُتِبَ لهُ","explicit":true,"ref":"صحيح الجامع 1869","srcLabel":"أحمد","text":["إنَّ اللهَ تعالى يَبتلِي العبدَ فيما أعطاهُ ، فإنْ رضِيَ بِما قسَمَ اللهَ لهُ بُورِكَ لهُ فيه ووسَّعَهُ ، ",["وإنْ لمْ يرْضَ",1]," ",["لمْ يُبارَكْ لهُ ، ولمْ يَزِدْ على ما كُتِبَ لهُ",2]],"grade":"صحيح","narrator":"رجل من بني سليم","muhaddith":"صحيح","takhrij":"أخرجه ابن قانع في ((معجم الصحابة)) (1/ 287) بلفظه، وأحمد (20279)، والبيهقي في ((شعب الإيمان)) (1292) بنحوه.","bab":"رقائق وزهد › ما فيه البركة","dorar":"ePrfvbYK"},{"id":"س-05593","fp":"1314ed2b8f13","stateId":26,"easy":"إذا انقطعت إلى الدنيا ← يكلك الله إليها","cause":"ومن انقطع إلى الدنيا","result":"وَكَلهُ اللهُ إليها","explicit":true,"otherNeedIds":[28],"ref":"المتجر الرابح 333","srcLabel":"الطبراني","text":["من انقطعَ إلى اللهِ عزَّ وجلَّ كفاه اللهُ كلَّ مئونةٍ ورزقه من حيث لا يحتسبُ ",["ومن انقطع إلى الدنيا",1]," ",["وَكَلهُ اللهُ إليها",2],"."],"grade":"حسن","narrator":"عمران بن الحصين","muhaddith":"إسناده حسن إن صح سماع الحسن من عمران","takhrij":"أخرجه ابن أبي الدنيا في ((الفرج بعد الشدة)) (26)، والطبراني في ((المعجم الأوسط)) (3359)، والبيهقي في ((شعب الإيمان)) (1076)","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"bVIRYHAI"},{"id":"س-07700","fp":"ca6dd6327bf5","stateId":26,"easy":"إذا تمنّى الناس الدنيا ← (لو بُسط لهم الرزق لبغوا) فيقدّر الله لهم بقدر","cause":"لِأَنَّهُمْ تَمَنَّوُا الدُّنْيَا","result":"وَلَوْ بَسَطَ اللهُ الرِّزْقَ لِعِبَادِهِ لَبَغَوْا فِي الْأَرْضِ","explicit":true,"otherNeedIds":[56],"ref":"مجمع الزوائد 7/107","srcLabel":"مجمع الزوائد","text":["عنْ عمرِو بنِ حُرَيْثٍ قال نَزَلَتْ هذِهِ الآيَةُ في أهْلِ الصُّفَّةِ  ",["وَلَوْ بَسَطَ اللهُ الرِّزْقَ لِعِبَادِهِ لَبَغَوْا فِي الْأَرْضِ",2],"  ",["لِأَنَّهُمْ تَمَنَّوُا الدُّنْيَا",1]],"grade":"صحيح","muhaddith":"رجاله رجال الصحيح","bab":"قرآن › أسباب النزول","dorar":"tqUi1MLv"},{"id":"س-05573","fp":"99be5884b2d5","stateId":27,"easy":"إذا كلت ما بارك الله لك فيه ← يفنى (من واقعة)","cause":"فَكِلْتُهُ","result":"ففَنيَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح ابن ماجه 2717","srcLabel":"متفق عليه","text":["لقد توُفِّيَ النَّبيُّ صلَّى اللَّهُ علَيهِ وسلَّمَ ، وما في بَيتي مِن شيءٍ ، يأكلُهُ ذو كَبدٍ ، إلَّا شَطرُ شَعيرٍ ، في رفٍّ لي ، فأَكَلتُ منهُ ، حتَّى طالَ علَيَّ ، ",["فَكِلْتُهُ",1]," ",["ففَنيَ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (3345) واللفظ له، والبخاري (6451)، مسلم (2973) باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"bumoVnTl"},{"id":"س-05894","fp":"81fe862e3bcd","stateId":27,"easy":"إذا خلا البيت من التمر ← جاع أهله","cause":"بَيتٌ ليس فيه تَمرٌ","result":"جياعٌ أهلُه","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 25549","srcLabel":"مسلم","text":["قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا عائِشةُ، ",["بَيتٌ ليس فيه تَمرٌ",1]," ",["جياعٌ أهلُه",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2046)، وأبو داود (3831)، والترمذي (1815)، وابن ماجه (3327) بمعناه، وأحمد (25549) واللفظ له","bab":"رقائق وزهد › الوصايا النافعة","dorar":"NDN8Laoc"},{"id":"س-05318","fp":"d8010b5126f8","stateId":27,"easy":"إذا كلت ما بارك الله فيه وأحصيته ← تذهب بركته (من واقعة)","cause":"رفعتُها ونفضتُها","result":"لو تركتموها ما زالتْ كما هي لكم حياتكُم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الخصائص الكبرى 2/55","srcLabel":"أحمد","text":["أنَّ رجلًا من الأنصارِ كان ذا حاجةٍ فخرج يومًا وليس عند أهلِه شيءٌ فقالت امرأتُه : لو أني حركتُ رحايَ وجعلتُ في تنُّوري سعَفاتٍ فسمعَ جيراني صوتَ الرَّحَى ورأوْا الدُّخانَ فظنُّوا أنَّ عندنا طعامًا ما بنا خَصاصةٌ ، فقامت على تنورِها فأوقدَتهُ وقد تحركَ الرحَى فأقبل زوجُها وسمِع الرحَى فقال : ما تطحنينَ ؟ فأخبرتْهُ فدخل وإنَّ رَحاها لتدورُ وتصبُّ دقيقًا فلم يبقَ في البيتِ وعاءٌ إلا مُلئَ ، ثمَّ خرجتْ إلى تنُّورِها فوجدتْهُ مملوءًا خبزًا فأقبل زوجُها فذكر ذلك لرسولِ اللهِ صلَّى اللهُ عليه وسلم ، قال : فما فعلتِ الرحَى ؟ قال : ",["رفعتُها ونفضتُها",1]," ، قال : ",["لو تركتموها ما زالتْ كما هي لكم حياتكُم",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (10658)، والطبراني في ((الأوسط)) (5588)، والبيهقي في ((الدلائل)) (6/ 105)، والبزار في ((مسنده)) (10073) جميعهم بنحوه.","bab":"رقائق وزهد › التوكل واليقين","dorar":"Lv3Yel2y"},{"id":"س-05333","fp":"adcf1223a2f8","stateId":27,"easy":"إذا كلت البركة وأحصيتها ← تنقطع (من قصة)","cause":"لو لَم يرفَعْها","result":"لم تزَلْ تدرر إلى يومِ القيامَةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الصحيح المسند 1281","srcLabel":"أحمد","text":["دخلَ رجلٌ على أَهْلِهِ ، فلمَّا رأى ما بِهِم مِنَ الحاجةِ ، خرجَ إلى البريَّةِ ، فلمَّا رأَت امرأتُهُ قامَت إلى الرَّحى ، فوضعَتها ، وإلى التَّنُّورِ فسَجرَتْهُ ، ثمَّ قالَت : اللَّهُمَّ ارزقنا فنظَرت فإذا الجَفنةُ قدِ امتلأَتْ . قالَ : وذَهَبت إلى التَّنُّورِ فوجدتهُ مُمتلئًا . قالَ : فرجعَ الزَّوجُ ، قالَ : أصَبتُمْ بعدي شيئًا ؟ قالت امرأتُهُ : نعَم من ربِّنا . فقامَ إلى الرَّحى . فذُكِرَ ذلِكَ للنَّبيِّ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ فقالَ : أما أنَّهُ ",["لو لَم يرفَعْها",1]," ، ",["لم تزَلْ تدرر إلى يومِ القيامَةِ",2]," ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح ، رجاله رجال الصحيح","takhrij":"أخرجه أحمد (10667) واللفظ له، والبزار (10073)، والعقيلي في ((الضعفاء الكبير)) (2/189).","bab":"رقائق وزهد › التوكل واليقين","dorar":"mhUlbcor"},{"id":"س-04774","fp":"5ba922752985","stateId":27,"easy":"إذا أكثرت الحلف في البيع ← تروج السلعة لكن تُمحق البركة","cause":"الحَلِفُ","result":"مُنَفِّقةٌ للسِّلعةِ، مُمحِقةٌ للبَرَكةِ","explicit":true,"star":true,"similar":["س-05929"],"ref":"صحيح البخاري 2087","srcLabel":"متفق عليه","text":["سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["الحَلِفُ",1]," ",["مُنَفِّقةٌ للسِّلعةِ، مُمحِقةٌ للبَرَكةِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2087) واللفظ له، ومسلم (1606)","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"MzwEtuHe"},{"id":"س-05929","fp":"be94b4dd21aa","stateId":27,"easy":"إذا أكثرت الحلف في البيع ← يروّج السلعة ثم يمحق البركة","cause":"إياكُمْ وكثرَةَ الْحَلِفِ فِي البيعِ","result":"فإِنَّه يُنَفِّقُ ثُمَّ يَمْحَقُ","explicit":true,"repOf":"س-04774","ref":"صحيح الجامع 2685","text":[["إياكُمْ وكثرَةَ الْحَلِفِ فِي البيعِ ؛ ",1],["فإِنَّه يُنَفِّقُ ثُمَّ يَمْحَقُ",2]],"grade":"صحيح","narrator":"أبو قتادة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1607)، والنسائي (4460)  واللفظ لهما، ابن ماجه (2209) باختلاف يسير.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"qeWZRdNK"},{"id":"س-03871","fp":"94e07a02cd63","stateId":27,"easy":"إذا بعت أرضاً أو داراً ولم تجعل ثمنها في مثلها ← لا يُبارك لك فيه","cause":"ثمنِ أرضٍ ولا دارٍ","result":"لا يُباركُ في ثمنِ أرضٍ ولا دارٍ لا يُجعلُ في أرضٍ ولا دارٍ","explicit":true,"star":true,"similar":["س-03868","س-03873"],"ref":"تخريج المسند لشاكر 3/118","srcLabel":"الدارقطني","text":[["لا يُباركُ في ثمنِ أرضٍ ولا دارٍ لا يُجعلُ في أرضٍ ولا دارٍ",2]],"grade":"صحيح","narrator":"سعيد بن زيد","muhaddith":"إسناده صحيح","takhrij":"أخرجه الدارقطني في ((العلل)) (662) معلقًا واللفظ له.","bab":"تجارة › الحث على التجارة","dorar":"KVzcVwZs","merged":3,"otherRefs":["تخريج كتاب الخراج 264 (حسن)","صحيح الجامع 6120 (حسن)"]},{"id":"س-00397","fp":"f274651d2854","stateId":27,"easy":"إذا بذّرت ← يُفقرك الله","cause":"ومَن بَذَّرَ","result":"أَفقَرَه اللهُ","explicit":true,"star":true,"ref":"الأحكام الوسطى 4/ 145","srcLabel":"البزار","text":["تَمشَّى رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ معَنا وهو صائِمٌ، فجَهَدَه الصَّوْمُ، فحَلَبْنا له ناقةً لنا في قَعْبٍ، وصَبَّيْنا عليه عَسَلًا نُكرِمُ به رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ عنْدَ فِطْرِه، فلمَّا غابَتِ الشَّمْسُ ناوَلْناه القَعْبَ، فلمَّا ذاقَه قالَ بيَدِه كأنَّه يقولُ: \"ما هذا؟\"، قُلْنا: لَبَنًا وعَسَلًا أَرَدْنا نُكرِمُك به، قالَ: \"أَكرَمَك اللهُ بما أَكرَمْتَني\"، أو دَعْوةً هذا مَعْناها، ثُمَّ قالَ: \"مَن اقْتَصَدَ أَغْناه اللهُ، ",["ومَن بَذَّرَ",1]," ",["أَفقَرَه اللهُ",2],"، ومَن تَواضَعَ رَفَعَه اللهُ، ومَن تَجَبَّرَ قَصَمَه اللهُ\"."],"grade":"صحيح","narrator":"طلحة بن عبيد الله","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه البزار (946)، وقوام السنة في ((الترغيب والترهيب)) (638) واللفظ لهما","bab":"آداب عامة › الأخلاق المذمومة","dorar":"oVUBfjRz"},{"id":"س-03868","fp":"d466ee6a68ae","stateId":27,"easy":"إذا بعت داراً ولم تجعل ثمنها في مثلها ← لا يُبارك لك فيه","cause":"من باع دارًا ثم لم يجعلْ ثمنُها في مثلِها","result":"لم يُبارَكْ له فيها","explicit":true,"repOf":"س-03871","ref":"النوافح العطرة 367","text":[["من باع دارًا ثم لم يجعلْ ثمنُها في مثلِها ",1],["لم يُبارَكْ له فيها",2]],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"متواتر","takhrij":"أخرجه ابن ماجه (2491)، والطحاوي في ((شرح مشكل الآثار)) (3948) بلفظه، والبيهقي (11285) باختلاف يسير.","bab":"تجارة › الحث على التجارة","dorar":"exxnEy5H"},{"id":"س-07963","fp":"8c7f22096700","stateId":27,"easy":"إذا بعت أو اشتريت في المسجد ← يُدعى عليك ألا يربح الله تجارتك","cause":"مَن يَبيعُ أو يَبْتاعُ في المَسجِدِ","result":"لا أَربَحَ اللهُ تِجارتَك","explicit":true,"ref":"الأحكام الوسطى 1/ 295","srcLabel":"الترمذي","text":["إذا رَأيْتُم ",["مَن يَبيعُ أو يَبْتاعُ في المَسجِدِ",1]," فقولوا: ",["لا أَربَحَ اللهُ تِجارتَك",2],"، وإذا رَأيْتُم مَن يَنشُدُ ضالَّةً في المَسجِدِ فقولوا: لا رَدَّها اللهُ عليك."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه الترمذي (1321)، والدارمي (1441)، والنسائي في ((السنن الكبرى)) (9933) بلفظه.","bab":"مساجد ومواضع الصلاة › العناية بالمسجد","dorar":"E145Lb51"},{"id":"س-00293","fp":"79cc0cc84051","stateId":27,"easy":"إذا كنت تاجراً جباناً ← تُحرم الرزق","cause":"التاجرُ الجبانُ","result":"محرومٌ","explicit":true,"ref":"شرح كتاب الشهاب 318","srcLabel":"القضاعي","text":[["التاجرُ الجبانُ",1]," ",["محرومٌ",2]," والتاجرُ الجسورُ مرزوقٌ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن","takhrij":"أخرجه القضاعي في ((مسند الشهاب)) (243 )","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"sL7mxck3"},{"id":"س-01178","fp":"ad4002bc8621","stateId":27,"easy":"إذا بدأت أمراً مهماً دون حمد الله ← يكون ناقصاً ممحوق البركة","cause":"كُلُّ أمرٍ ذي بالٍ لا يُبدَأُ فيه بحَمدِ اللهِ والصَّلاةِ عليَّ","result":"فهو أقطَعُ أبترُ مَمحوقٌ مِن كُلِّ برَكةٍ","explicit":true,"ref":"فيض القدير 5/ 13","srcLabel":"ابن ماجه","text":[["كُلُّ أمرٍ ذي بالٍ لا يُبدَأُ فيه بحَمدِ اللهِ والصَّلاةِ عليَّ",1]," ",["فهو أقطَعُ أبترُ مَمحوقٌ مِن كُلِّ برَكةٍ",2]],"grade":"حسن","narrator":"أبو هريرةَ","muhaddith":"حسن","takhrij":"أخرجه ابن ماجه (1894)، وأحمد (8712)، والبزار (7898) جميعهم باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"XKZHVm0t"},{"id":"س-03872","fp":"c98e06002396","stateId":27,"easy":"إذا نمت في الصباح الباكر ← تمنع عنك نومةُ الصبح الرزق","cause":"الصُّبحةُ","result":"تمنَعُ الرِّزقَ","explicit":true,"ref":"مختصر المقاصد 574","srcLabel":"أحمد","text":[["الصُّبحةُ",1]," ",["تمنَعُ الرِّزقَ",2],"."],"grade":"حسن","narrator":"[عثمان بن عفان]","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (530) واللفظ له، والطحاوي في ((شرح مشكل الآثار)) (1074)، وابن عدي في ((الكامل في الضعفاء)) (1/327) باختلاف يسير.","bab":"تجارة › الحث على التجارة","dorar":"2CJRY5Qc"},{"id":"س-03873","fp":"a34495c1b293","stateId":27,"easy":"إذا بعت داراً أو عقاراً ولم تجعل ثمنه في مثله ← يوشك ألا يُبارك لك فيه","cause":"من باعَ دارًا أو عقارًا فلم يجعَل ثمنَه في مثلِه","result":"كانَ قمِنًا أن لاَ يبارَكَ فيه","explicit":true,"repOf":"س-03871","ref":"صحيح ابن ماجه 2035","text":[["من باعَ دارًا أو عقارًا فلم يجعَل ثمنَه في مثلِه ",1],["كانَ قمِنًا أن لاَ يبارَكَ فيه",2],"."],"grade":"حسن","narrator":"سعيد بن حريث المخزومي","muhaddith":"حسن","takhrij":"أخرجه ابن ماجه (2490) واللفظ له، وأحمد (18739) باختلاف يسير","bab":"تجارة › الحث على التجارة","dorar":"oVXo5ewK"},{"id":"س-00654","fp":"9570cf3ff29d","stateId":27,"easy":"إذا طلبت الرزق من غير بابه ← تقع في الوعر والمشقة ولا تنال إلا ما قُدّر لك (مثَل نبوي)","cause":"ومن أتاه من قِبَلِ حائِطِه","result":"وَقَع في الوَعرِ والوَعثِ حتَّى إذا انتهى إليه لم يكُنْ له إلَّا الرِّزقُ الذي يسَّرَه اللهُ تعالى له","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"سبل الهدى والرشاد 7/141","srcLabel":"الطبراني","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ضَرَب مَثَلَ الرِّزقِ كمَثَلِ حائِطٍ له بابٌ، فما حَولَ البابِ سُهولةٌ، وما حولَ الحائِطِ وَعرٌ وَعثٌ، فمن أتاه من قِبَلِ بابِه أصابه كُلَّه وسَلِم، ",["ومن أتاه من قِبَلِ حائِطِه",1]," ",["وَقَع في الوَعرِ والوَعثِ حتَّى إذا انتهى إليه لم يكُنْ له إلَّا الرِّزقُ الذي يسَّرَه اللهُ تعالى له",2],"."],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"إسناده جيد.","takhrij":"أخرجه الطبراني في ((الأوسط)) (1523) بلفظه.","bab":"آداب عامة › ضرب الأمثال","dorar":"FAdONsp6"}]}