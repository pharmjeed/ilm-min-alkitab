{"schema":1,"kind":"sunan-chunk","version":"sunan-b53213585e2f","needId":7,"stateIds":[32,33,34],"items":[{"id":"س-03797","fp":"e70b6bd50163","stateId":32,"easy":"إذا رُزقت جاراً صالحاً ومسكناً واسعاً ومركباً هنيئاً ← فهي من سعادة المسلم في الدنيا","cause":"الجارُ الصالِحُ ، والمسْكَنُ الواسِعُ ، والمركَبُ الهَنِيءُ","result":"ثلاثُ خِصالٍ من سعادَةِ المرْءِ المسلِمِ في الدنيا","explicit":true,"star":true,"similar":["س-03787","س-00229","س-01956"],"ref":"صحيح الجامع 3029","srcLabel":"البخاري","text":[["ثلاثُ خِصالٍ من سعادَةِ المرْءِ المسلِمِ في الدنيا ",2],":",[" الجارُ الصالِحُ ، والمسْكَنُ الواسِعُ ، والمركَبُ الهَنِيءُ",1]],"grade":"صحيح","narrator":"نافع بن عبدالحارث","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (116)، والخرائطي في ((مكارم الأخلاق)) (251)، والحاكم (7306) باختلاف يسير","bab":"بر وصلة › تحري الجار والرفيق","dorar":"7PHeNZZL","merged":2,"otherRefs":["صحيح الجامع 3629 (حسن)"]},{"id":"س-03787","fp":"afb247bbbd91","stateId":32,"easy":"إذا رُزقت جاراً صالحاً ومركباً هنيئاً ومسكناً واسعاً ← فهي من سعادة المرء","cause":"الجارُ الصالحُ ، والمركبُ الهنيءُ ، والمسكنُ الواسعُ","result":"من سعادةِ المرءِ","explicit":true,"repOf":"س-03797","ref":"صحيح الترغيب 2575","text":[["من سعادةِ المرءِ",2]," ؛ ",["الجارُ الصالحُ ، والمركبُ الهنيءُ ، والمسكنُ الواسعُ",1]],"grade":"صحيح","narrator":"نافع بن عبدالحارث","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (15372) واللفظ له، وعبد بن حميد في ((المسند)) (385)، والبخاري في ((الأدب المفرد)) (457)","bab":"بر وصلة › إكرام الجار وعدم أذيته","dorar":"9Tkm9umM"},{"id":"س-01341","fp":"5c1d14dc5eb8","stateId":32,"easy":"إذا رُزقت زوجة صالحة ← فهي خير متاع الدنيا","cause":"المرأةُ الصَّالحةُ","result":"وخيرُ متاعِ الدُّنيا","explicit":true,"star":true,"similar":["س-05548"],"otherNeedIds":[35],"ref":"تخريج صحيح ابن حبان 4031","srcLabel":"مسلم","text":["إنَّ الدُّنيا كلَّها متاعٌ ",["وخيرُ متاعِ الدُّنيا",2]," ",["المرأةُ الصَّالحةُ",1]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (1467) باختلاف يسير","bab":"نكاح › عشرة النساء","dorar":"xTrpvmmw"},{"id":"س-00229","fp":"34229534d722","stateId":32,"easy":"إذا رُزقت زوجة صالحة ومسكناً واسعاً وجاراً صالحاً ومركباً هنيئاً ← فهي من السعادة","cause":"المرأةُ الصَّالِحَةُ ، و المَسْكَنُ الوَاسِعُ ، و الجَارُ الصَّالِحُ ، والمَرْكَبُ الهَنِيءُ، وأربعٌ مِنَ الشَّقَاوَةِ : الجَارُ السُّوءُ ، والمرأةُ السُّوءُ ، و المَرْكَبُ السُّوءُ و المَسْكَنُ الضِّيقُ","result":"أربعٌ مِنَ السَّعادَةِ","explicit":true,"repOf":"س-03797","ref":"السلسلة الصحيحة 282","text":[["أربعٌ مِنَ السَّعادَةِ",2],":",[" المرأةُ الصَّالِحَةُ ، و المَسْكَنُ الوَاسِعُ ، و الجَارُ الصَّالِحُ ، والمَرْكَبُ الهَنِيءُ، وأربعٌ مِنَ الشَّقَاوَةِ : الجَارُ السُّوءُ ، والمرأةُ السُّوءُ ، و المَرْكَبُ السُّوءُ و المَسْكَنُ الضِّيقُ",1]],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه ابن حبان (4032)، والخطيب في ((تاريخ بغداد)) (12/99) باختلاف يسير.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"J9ZtPUEy"},{"id":"س-01286","fp":"9fdacbb25edd","stateId":32,"easy":"إذا رُزقت زوجة صالحة ودابة وطيئة ودار واسعة ← فهي من السعادة","cause":"المرأةُ الصَّالحةُ، تَراها فتُعجِبُك، وتَغِيبُ عنها فتأمَنُها على نفسِها ومالِكَ، والدَّابَّةُ تكونُ وَطِيئةً، تُلحِقُك بأصحابِك، والدَّارُ تكونُ واسعةً كثيرةَ المَرافِقِ","result":"ثلاثةٌ مِن السَّعادةِ","explicit":true,"similar":["س-01316"],"ref":"التنوير شرح الجامع الصغير 5/207","srcLabel":"الحاكم","text":[["ثلاثةٌ مِن السَّعادةِ",2],"، وثلاثةٌ مِن الشَّقاءِ؛ فمِن السَّعادةِ: ",["المرأةُ الصَّالحةُ، تَراها فتُعجِبُك، وتَغِيبُ عنها فتأمَنُها على نفسِها ومالِكَ، والدَّابَّةُ تكونُ وَطِيئةً، تُلحِقُك بأصحابِك، والدَّارُ تكونُ واسعةً كثيرةَ المَرافِقِ",1],". ومِن الشَّقاءِ: المرأةُ تَراها فتَسُوءُك، وتَحمِلُ لسانَها عليك، وإن غِبْتَ عليها لم تأمَنْها على نفسِها ومالِك، والدَّابَّةُ تكونُ قَطُوفًا، فإن ضرَبْتَها أتعَبَتْك، وإن ترَكْتَها لم تُلحِقْك بأصحابِك، والدَّارُ تكونُ ضيِّقةً قليلةَ المَرافِقِ."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"قال الحاكم: تفرد بن محمد بن سعد عن أبيه فإن كان حفظه فعلى شرطهما وتعقبه الذهبي فقال محمد قال أبو حاتم: صدوق يغلط، وقال يعقوب بن شيبة: ثقة، قلت: لا يعقب على الحاكم وقد قيده بالشرطية","takhrij":"أخرجه الحاكم (2864)، وابن المنذر في ((الأوسط)) (7123) بلفظه.","bab":"نكاح › الحث على التزويج","dorar":"4JXDfLnD"},{"id":"س-01316","fp":"aba737d87b2b","stateId":32,"easy":"إذا رُزقت زوجة صالحة تأمنها ودابة وطيئة ← فهي من السعادة","cause":"المرأةُ تَراها تُعجِبُكَ، وتَغيبُ فتَأْمَنُها على نَفسِها ومالِكَ، والدَّابَّةُ تكونُ وَطِيَّةً فتُلحِقُكَ بأَصحابِكَ، والدَّارُ تكونُ واسِعةً كثيرةَ المِرافقِ","result":"فمِنَ السَّعادةِ","explicit":true,"repOf":"س-01286","ref":"المستدرك على الصحيحين 2721","text":["ثلاثٌ مِنَ السَّعادةِ، وثلاثٌ مِنَ الشَّقاوةِ، ",["فمِنَ السَّعادةِ",2],": ",["المرأةُ تَراها تُعجِبُكَ، وتَغيبُ فتَأْمَنُها على نَفسِها ومالِكَ، والدَّابَّةُ تكونُ وَطِيَّةً فتُلحِقُكَ بأَصحابِكَ، والدَّارُ تكونُ واسِعةً كثيرةَ المِرافقِ",1],"، ومِن الشَّقاوةِ: المرأةُ تَراها فتَسوؤكَ، وتَحمِلُ لسانَها عليكَ، وإنْ غِبتَ عنها لمْ تَأْمَنْها على نَفسِها ومالِكَ، والدَّابَّةُ تكونُ قَطوفًا، فإنْ ضَرَبْتَها أَتْعبَتْكَ، وإنْ تَركَبْها لمْ تُلحِقْكَ بأصْحابِكَ، والدَّارُ ضَيِّقةٌ قليلةُ المِرافقِ."],"grade":"صحيح","narrator":"[سعد]","muhaddith":"صحيح الإسناد من خالد بن عبد الله الواسطي إلى رسول الله صلَّى اللهُ عليه وسلَّمَ تفرد به محمد بن بكير، عن خالد إن كان حفظه فإنَّه صحيح على شرط الشيخين.","takhrij":"أخرجه البزار في ((مسنده)) (4/ 11) واللفظ له، والترمذي (2151)، وأحمد (1444)، وابن حبان في ((صحيحه)) (4032) كلاهما بنحوه.","bab":"نكاح › حق الزوج على المرأة","dorar":"sfdCVsj1"},{"id":"س-01956","fp":"125907937447","stateId":32,"easy":"إذا رُزقت زوجة صالحة ومسكناً صالحاً ومركباً صالحاً ← فهي من سعادة ابن آدم","cause":"المَرأةُ الصَّالِحةُ، والمَسكَنُ الصَّالِحُ، والمَركَبُ الصَّالِحُ","result":"مِن سَعادةِ ابنِ آدَمَ","explicit":true,"repOf":"س-03797","ref":"تخريج المسند لشعيب 1445","text":["مِن سَعادةِ ابنِ آدَمَ ثَلاثةٌ، ومِن شِقْوةِ ابنِ آدَمَ ثَلاثةٌ، ",["مِن سَعادةِ ابنِ آدَمَ",2]," ",["المَرأةُ الصَّالِحةُ، والمَسكَنُ الصَّالِحُ، والمَركَبُ الصَّالِحُ",1],"، ومِن شِقْوةِ ابنِ آدَمَ: المَرأةُ السُّوءُ، والمَسكَنُ السُّوءُ، والمَركَبُ السُّوءُ."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"صحيح","takhrij":"أخرجه أحمد (1445) واللفظ له، والطيالسي (207) باختلاف يسير، والبزار (4/9) مختصراً","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"T4fx5DPE"},{"id":"س-01298","fp":"aa4234123d91","stateId":32,"easy":"إذا رُزقت مركباً وطيئاً وزوجة صالحة ومنزلاً واسعاً ← فهي من نعيم الدنيا","cause":"مَركَبٌ وَطيءٌ, والمرأةُ الصالحةُ , والمنزِلُ الواسعُ","result":"ثلاثٌ مِن نعيمِ الدنيا","explicit":true,"ref":"إتحاف الخيرة المهرة 3/152","srcLabel":"ابن أبي الدنيا","text":[["ثلاثٌ مِن نعيمِ الدنيا",2]," وإن كان لا نعيمَ لها :",["مَركَبٌ وَطيءٌ, والمرأةُ الصالحةُ , والمنزِلُ الواسعُ",1]],"grade":"حسن","narrator":"قرة بن إياس المزني أو ابنه معاوية","muhaddith":"رجاله ثقات، وله شاهد","takhrij":"أخرجه ابن أبي الدنيا في ((إصلاح المال)) (290)، وابن أبي شيبة كما في ((إتحاف الخيرة المهرة)) للبوصيري (3/152) باختلاف يسير","bab":"نكاح › حسن العشرة بين الأزواج","dorar":"pjXhgsPj"},{"id":"س-01315","fp":"b01e82b094f7","stateId":32,"easy":"إذا كانت زوجتك موافقة وأولادك أبراراً وإخوانك صالحين ورزقك في بلدك ← فهي من سعادة المرء","cause":"أنْ تكونَ زوجتُه مُوافِقَةً ، وأولادُه أبرارًا ، وإخوانُه صالِحينَ ، وأنْ يكونَ رِزقُه في بلَدِه","result":"أربعٌ مِن سَعادَةِ المرءِ","explicit":true,"ref":"إتحاف الخيرة المهرة 4/ 24","srcLabel":"ابن عساكر","text":[["أربعٌ مِن سَعادَةِ المرءِ ",2],":",[" أنْ تكونَ زوجتُه مُوافِقَةً ، وأولادُه أبرارًا ، وإخوانُه صالِحينَ ، وأنْ يكونَ رِزقُه في بلَدِه",1]],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"إسناده رجاله ثقات","takhrij":"أخرجه ابن عساكر في ((تاريخ دمشق)) (54/178)","bab":"نكاح › حق الزوج على المرأة","dorar":"xKbWnjHI"},{"id":"س-05548","fp":"c001d0ebc279","stateId":32,"easy":"إذا رُزقت امرأة صالحة ← فهي خير متاع الدنيا","cause":"المرأةُ الصَّالحةِ","result":"وخيرُ متاعِها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-01341","otherNeedIds":[35],"ref":"مختصر المقاصد 466","text":["الدُّنيا متاعٌ ",["وخيرُ متاعِها",2]," ",["المرأةُ الصَّالحةِ",1]],"grade":"صحيح","narrator":"[عبدالله بن عمرو]","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1467)","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"aXP2YWh2"},{"id":"س-01792","fp":"e02bdbbdf342","stateId":33,"easy":"إذا صمت ← لك فرحتان: عند فطرك، وعند لقاء ربك","cause":"لِلصَّائِمِ","result":"فَرْحَتَانِ يَفْرَحُهُما ، إذا أفْطَرَ فَرِحَ بفطرِهِ ، وإذَا لَقِيَ رَبَّهُ فَرِحَ بِصَوْمِهِ","explicit":true,"star":true,"similar":["س-05407"],"ref":"صحيح الترغيب 978","srcLabel":"متفق عليه","text":["قال اللهُ عزَّ وجلَّ : كلُّ عَمَلِ ابنِ آدمَ لهُ ، إلَّا الصُّومُ ، فإنَّهُ لي ، وأنا أَجْزِي بهِ ، والصِّيامُ جُنَّةٌ ، فإِذَا كان يومُ صِيامِ أَحَدِكُمْ فلا يَرْفُثْ ، ولا يَصْخَبْ ، فإنْ سابَهُ أحدٌ أوْ قاتَلهُ فَلْيَقُلْ : إِنِي صائِمٌ ، إِنِي صائِمٌ ، والذي نَفْسُ محمدٍ بيدِهِ لَخُلوفُ فَمِ الصَّائِمِ أطْيَبُ عندَ اللهِ من رِيحِ المِسْكِ ، ",["لِلصَّائِمِ",1]," ",["فَرْحَتَانِ يَفْرَحُهُما ، إذا أفْطَرَ فَرِحَ بفطرِهِ ، وإذَا لَقِيَ رَبَّهُ فَرِحَ بِصَوْمِهِ",2]," ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1904)، ومسلم (1151) باختلاف يسير.","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"ew6eS5Os","merged":7,"otherRefs":["صحيح ابن خزيمة 3/ 349 (صحيح)","تخريج المسند لشعيب 10176 (صحيح)","تخريج المسند لشعيب 10218 (صحيح)","صحيح النسائي 2214 (صحيح)","تخريج المسند لشعيب 10631 (صحيح)","تخريج المسند لشعيب 4256 (صحيح)"]},{"id":"س-03623","fp":"c565919311ef","stateId":33,"easy":"إذا رأيت رؤيا حسنة فحدّث بها ← فهي بشرى من الله","cause":"فليُحدِّثْ بها","result":"فإنَّها بُشرى مِن اللهِ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 22635","srcLabel":"متفق عليه","text":["مَن رَأى رُؤيا تُعجِبُه ",["فليُحدِّثْ بها",1],"؛ ",["فإنَّها بُشرى مِن اللهِ",2],"، ومَن رَأى رُؤيا يَكرَهُها فلا يُحدِّثْ بها، وليَتفُلْ عن يَسارِه، ويَتعوَّذْ باللهِ مِن شَرِّها."],"grade":"صحيح","narrator":"أبو قتادة الحارث بن ربعي","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه البخاري (7044)، ومسلم (2261) مطولاً بنحوه، وأحمد (22635) واللفظ له","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"aW8VxhwP"},{"id":"س-00897","fp":"c985bc51536a","stateId":33,"easy":"إذا استيقظت فذكرت الله وتوضأت وصليت ← تصبح نشيطاً قد أصبت خيراً","cause":"فإنِ استيقظَ فذَكَرَ اللَّهَ","result":"انحلَّت عقدةٌ ، وإن هوَ توضَّأَ ثمَّ قامَ إلى الصَّلاةِ ؛ أصبحَ نشيطًا قد أصابَ خيرًا وقدِ انحلَّت عقَدُهُ كلُّها","explicit":true,"star":true,"apply":{"k":"time","t":"عند الاستيقاظ"},"otherNeedIds":[30],"ref":"صحيح الموارد 147","srcLabel":"أحمد","text":["ما مِن مسلمٍ ذَكَرٍ ولا أنثى يَنامُ إلَّا وعليهِ جريرٌ معقودٌ ، [ ",["فإنِ استيقظَ فذَكَرَ اللَّهَ",1]," ",["انحلَّت عقدةٌ ] ، وإن هوَ توضَّأَ ثمَّ قامَ إلى الصَّلاةِ ؛ أصبحَ نشيطًا قد أصابَ خيرًا وقدِ انحلَّت عقَدُهُ كلُّها",2]," ، وإن أصبحَ ولم يذكرِ اللَّهَ أصبحَ وعقدُهُ عليهِ ، وأصبحَ ثقيلًا كَسلانًا لم يصب خيرًا"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أحمد (14387)، وأبو يعلى (2298)، وابن حبان (2556) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"xUYwZb0N","merged":4,"otherRefs":["صحيح ابن خزيمة 2/ 311 (صحيح)","مجمع الزوائد 2/264 (صحيح)","صحيح النسائي 1606 (صحيح)"]},{"id":"س-04111","fp":"f38b06772119","stateId":33,"easy":"إذا حمدت الله في كل حال ← فأنت بخير على كل حال حتى عند خروج روحك","cause":"وَهوَ يَحمدُ اللَّهَ عزَّ وجلَّ","result":"المؤمنُ بخيرٍ علَى كلِّ حالٍ تنزعُ نفسُهُ من بينِ جنبيهِ","explicit":true,"otherNeedIds":[51,48,9],"ref":"صحيح النسائي 1842","srcLabel":"النسائي","text":["لمَّا حُضِرَتْ بنتٌ لرسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ صغيرةٌ فأخذَها رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ ، فضمَّها إلى صدرِهِ ، ثمَّ وضعَ يدَهُ عليها ، فقَضَت ، وَهيَ بينَ يدي رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ ، فبَكَت أمُّ أيمنَ ، فقالَ لَها رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ : يا أمَّ أيمنَ ، أتبكينَ ورسولُ اللَّهِ عندَكِ ، فقالَت : ما لي لا أبكي ورسولُ اللَّهِ يبكي ، فقالَ رسولُ اللَّهِ : إنِّي لَستُ أبكي ، ولَكِنَّها رحمةٌ ، ثمَّ قالَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ : ",["المؤمنُ بخيرٍ علَى كلِّ حالٍ تنزعُ نفسُهُ من بينِ جنبيهِ",2]," ",["وَهوَ يَحمدُ اللَّهَ عزَّ وجلَّ",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه النسائي (1843 )، وفي ((السنن الكبرى)) (1982)، وهناد بن السري في ((الزهد)) (2/ 617) واللفظ لهم، وأحمد (2412) بنحوه.","bab":"جنائز وموت › البكاء على الميت","dorar":"J0OcQ8w4","merged":4,"otherRefs":["الأحاديث المختارة 12 / 163 (صحيح)","الأحاديث المختارة 12 / 162 (صحيح)","الأحاديث المختارة 12 / 161 (صحيح)"]},{"id":"س-06606","fp":"9608ab391113","stateId":33,"easy":"إذا حافظت على الصلوات الخمس ← تعيش بخير وتموت بخير وتخرج من ذنوبك كيوم ولدتك أمك","cause":"ومَنْ حافظَ عليهِنَّ","result":"عاشَ بِخَيْرٍ ، وماتَ بِخَيْرٍ ، وكان من ذنوبِه كَيومِ ولَدَتْهُ أمُّهُ","explicit":true,"otherNeedIds":[51,11],"ref":"صحيح الترغيب 408","srcLabel":"الترمذي","text":["أتاني الليلةَ ربِّي ، وفي ( روايةٍ ) : رأيْتُ ربِّي في أَحْسَنِ صُورَةٍ ، فقال لي : يا محمدُ ! قُلْتُ : لَبَّيْكَ رب وسَعْدَيْكَ ، قال : هلْ تدرِي فيمَ يَخْتَصِمُ المَلَأُ الأعلى ؟ قُلْتُ : لا أعلمُ . فوضعَ يدَهُ بيَن كَتِفَيَّ حتى وجدْتُ بَردَها بيَن ثديَيَّ أوْ قال : في نحرِي فعلمْتُ ما في السمواتِ وما في الأرضِ أوْ قال : ما بين المشرقِ والمغربِ قال : يا محمدُ ! أتدرِي فيمَ يَخْتَصِمُ المَلَأُ الأعلى ؟ قُلْتُ : نَعَمْ ، في الدرجاتِ ، والكفَّاراتِ ، ونَقْلِ الأَقْدَامِ إلى الجَماعَاتِ ، وإسباغِ الوُضُوءِ في السَّبَرَاتِ ، وانْتِظَارُ الصَّلاةِ بعدَ الصَّلاةِ ، ",["ومَنْ حافظَ عليهِنَّ ",1],["عاشَ بِخَيْرٍ ، وماتَ بِخَيْرٍ ، وكان من ذنوبِه كَيومِ ولَدَتْهُ أمُّهُ ",2],". قال : يا محمدُ ! قُلْتُ : لَبَّيْكَ وسَعْدَيْكَ . فقال : إذا صَلَّيْتَ قُلْ : اللهمَّ ! إنِّي أسألُكَ فِعْلَ الخَيْرَاتِ ، وتَرْكَ المُنْكَرَاتِ ، وحُبَّ المساكينِ ، وإذا أردْتَ بِعِبادِكَ فِتْنَةً فَاقْبِضْنِي إليكَ غيرَ مَفْتُونٍ . قال : والدَّرَجَاتُ : إِفْشَاءُ السلامِ ، وإِطْعَامُ الطَّعَامِ ، والصَّلاةُ بِالليلِ ، والناسُ نِيامٌ ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (3233)، وأحمد (3484) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"2aHXGAwL","merged":3,"otherRefs":["بيان تلبيس الجهمية 7/205 (صحيح)","صحيح الترغيب 194 (صحيح)"]},{"id":"س-03994","fp":"df5862ff1d31","stateId":33,"easy":"إذا طال عمرك حتى رزقك الله الإنابة والتوبة ← فذلك من السعادة","cause":"أن يَطولَ عُمرُ العَبْدِ حتَّى يَرزُقَه اللهُ الإنابةَ","result":"وإنَّ مِن السَّعادةِ","explicit":true,"otherNeedIds":[34],"ref":"الأحكام الوسطى 4/ 289","srcLabel":"أحمد","text":["\"لا تَمنَّوا المَوْتَ؛ فإنَّ هَوْلَ المَطلَعِ شَديدٌ، ",["وإنَّ مِن السَّعادةِ",2]," ",["أن يَطولَ عُمرُ العَبْدِ حتَّى يَرزُقَه اللهُ الإنابةَ",1],"\"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أحمد (14564)، والبزار كما في ((كشف الأستار )) (3240)، والبيهقي في ((الزهد الكبير )) (626) واللفظ له","bab":"توبة › الحض على التوبة","dorar":"akqxcdUG","merged":2,"otherRefs":["الجامع الصغير 2475 (صحيح)"]},{"id":"س-08059","fp":"ce777534976c","stateId":33,"easy":"إذا استخرت الله ورضيت بقضائه ← فهو من سعادتك","cause":"استخارتُهُ اللهَ، و منْ سعادةِ ابنِ آدمَ رضاهُ بما قضَى اللهُ","result":"منْ سعادةِ ابنِ آدمَ","explicit":true,"otherNeedIds":[47],"ref":"الجامع الصغير 8233","srcLabel":"أحمد","text":[["منْ سعادةِ ابنِ آدمَ",2]," ",["استخارتُهُ اللهَ،  و منْ سعادةِ ابنِ آدمَ رضاهُ بما قضَى اللهُ",1]," ومنْ شَقَاوةِ ابنِ آدمَ تركُهُ استخارةَ اللهِ،  و منْ شقاوةِ ابنِ آدمِ سخطُه بما قضى اللهُ لهُ"],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"صحيح","takhrij":"أخرجه أحمد (1444)، والحاكم (1903)، والبزار (1097) باختلاف يسير.","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"9y7jfN90","merged":2,"otherRefs":["المستدرك على الصحيحين 1927 (صحيح)"]},{"id":"س-05229","fp":"a6c8c2886911","stateId":33,"easy":"إذا استخرت ربك ورضيت بما قضى ← فذلك من سعادتك","cause":"استِخارتُهُ ربَّهُ ورضاهُ بما قَضى","result":"مِن سعادةِ المرءِ","explicit":true,"ref":"الترغيب والترهيب 1/330","srcLabel":"الترمذي","text":[["مِن سعادةِ المرءِ",2]," ",["استِخارتُهُ ربَّهُ ورضاهُ بما قَضى",1]," ، ومِن شقاءِ المرءِ تركُهُ الاستخارةَ وسخطُهُ بعدَ القَضاءِ"],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أحمد (1444)، والحكيم الترمذي في ((نوادر الأصول)) (736)، والحاكم (1927) جميعهم باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"meN9503p"},{"id":"س-05672","fp":"d040126fb0a9","stateId":33,"easy":"إذا صبرت ← وجدت خير عيشك في الصبر","cause":"الصبرَ","result":"وجدنا خيرَ عيشِنا","explicit":true,"otherNeedIds":[14],"ref":"عمدة القاري 23/103","srcLabel":"أحمد","text":["قال عمرُ رضِيَ اللهُ تعالَى عنه ",["وجدنا خيرَ عيشِنا",2]," ",["الصبرَ",1]],"grade":"صحيح","narrator":"مجاهد بن جبر المكي","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد في ((الزهد)) (612)، وابن المبارك في ((الزهد)) (630)، ووكيع في ((الزهد)) (198) باختلاف يسير.","bab":"رقائق وزهد › الصبر على البلاء","dorar":"MEMqOM9O"},{"id":"س-08055","fp":"f6077342c802","stateId":33,"easy":"إذا سمعت وأطعت ← تعيش (تسلم في دنياك)","cause":"اسمَعوا مِنِّي","result":"تَعيشوا","explicit":true,"otherNeedIds":[46],"ref":"تخريج المسند لشعيب 20695","srcLabel":"أحمد","text":["عن أبي حُرَّةَ الرَّقاشيِّ، عن عَمِّه، قال كُنتُ آخِذًا بزِمامِ ناقةِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في أوسَطِ أيَّامِ التَّشريقِ، أذودُ عنه النَّاسَ، فقال: «يا أيُّها النَّاسُ، هَل تَدرونَ في أيِّ يَومٍ أنتُم؟ وفي أيِّ شَهرٍ أنتُم؟ وفي أيِّ بَلَدٍ أنتُم؟» قالوا: في يَومٍ حَرامٍ، وشَهرٍ حَرامٍ، وبَلَدٍ حَرامٍ، قال: «فإنَّ دِماءَكُم وأموالَكُم وأعراضَكُم عليكُم حَرامٌ، كَحُرمةِ يَومِكُم هذا، في شَهرِكُم هذا، في بَلَدِكُم هذا، إلى يَومِ تَلقَونَه»، ثُمَّ قال: \"",["اسمَعوا مِنِّي",1]," ",["تَعيشوا",2],"، ألا لا تَظلِموا، ألا لا تَظلِموا، ألا لا تَظلِموا، إنَّه لا يَحِلُّ مالُ امرِئٍ إلَّا بطيبِ نَفسٍ مِنه، ألا وإنَّ كُلَّ دَمٍ ومالٍ ومَأثُرةٍ كانَت في الجاهِليَّةِ تَحتَ قدَمي هذه إلى يَومِ القيامةِ، وإنَّ أوَّلَ دَمٍ يوضَعُ دَمُ رَبيعةَ بنِ الحارِثِ بنِ عَبدِ المُطَّلِبِ، كان مُستَرضَعًا في بَني لَيثٍ فقَتَلَته هُذَيلٌ، ألا وإنَّ كُلَّ رِبًا كان في الجاهِليَّةِ مَوضوعٌ، وإنَّ اللهَ قَضى أنَّ أوَّلَ رِبًا يوضَعُ رِبا العَبَّاسِ بنِ عَبدِ المُطَّلِبِ، لَكُم رُؤوسُ أموالِكُم لا تَظلِمونَ ولا تُظلَمونَ، ألا وإنَّ الزَّمانَ قدِ استَدارَ كَهَيئَتِه يَومَ خَلَقَ اللهُ السَّمَواتِ والأرضَ، ثُمَّ قَرَأ: {إنَّ عِدَّةَ الشُّهورِ عِندَ اللهِ اثنَا عَشَرَ شَهرًا في كِتابِ اللهِ يَومَ خَلَقَ السَّمَواتِ والأرضَ مِنها أربَعةٌ حُرُمٌ ذلك الدِّينُ القَيِّمُ فلا تَظلِموا فيهنَّ أنفُسَكُم}، ألا لا تَرجِعوا بَعدي كُفَّارًا يَضرِبُ بَعضُكُم رِقابَ بَعضٍ، ألا إنَّ الشَّيطانَ قد أيِسَ أن يَعبُدَه المُصَلُّونَ، ولَكِنْ في التَّحريشِ بَينَكُم، فاتَّقوا اللهَ في النِّساءِ؛ فإنَّهنَّ عِندَكُم عَوانٍ، لا يَملِكنَ لأنفُسِهنَّ شَيئًا، وإنَّ لهنَّ عليكُم ولَكُم عليهنَّ حَقًّا: أن لا يوطِئنَ فُرُشَكُم أحَدًا غَيرَكُم، ولا يَأذَنَّ في بُيوتِكُم لأحَدٍ تَكرَهونَه، فإن خِفتُم نُشوزَهنَّ فعِظوهُنَّ واهجُروهُنَّ في المَضاجِعِ، واضرِبوهُنَّ ضَربًا غَيرَ مُبَرِّحٍ\"، قال حُمَيدٌ: قُلتُ للحَسَنِ: ما المُبَرِّحُ؟ قال: المُؤَثِّرُ، «ولَهنَّ رِزقُهنَّ وكِسوتُهنَّ بالمَعروفِ، وإنَّما أخَذتُموهُنَّ بأمانةِ اللهِ، واستَحلَلتُم فُروجَهنَّ بكَلِمةِ اللهِ، ألا ومَن كانَت عِندَه أمانةٌ فليُؤَدِّها إلى مَنِ ائتَمَنَه عليها»، وبَسَطَ يَدَيه، فقال: \"ألا هَل بَلَّغتُ؟ ألا هَل بَلَّغتُ؟ ألا هَل بَلَّغتُ؟ ثُمَّ قال: ليُبَلِّغِ الشَّاهِدُ الغائِبَ؛ فإنَّه رُبَّ مُبَلَّغٍ أسعَدُ مِن سامِعٍ \"، قال حُمَيدٌ: قال الحَسَنُ حينَ بَلَغَ هذه الكَلِمةَ: «قد واللهِ بَلَّغوا أقوامًا كانوا أسعَدَ به»"],"grade":"صحيح","narrator":"عم، أبي حرة الرقاشي","muhaddith":"صحيح لغيره مقطعا","bab":"مظالم › تحريم الظلم","dorar":"7sEuKHD1"},{"id":"س-02083","fp":"b6b1fbec45c8","stateId":33,"easy":"إذا طال عمرك في طاعة الله ← فهي السعادة كل السعادة","cause":"طولُ العمرِ في طاعةِ اللهِ","result":"السعادةُ كلُّ السعادةِ","explicit":true,"otherNeedIds":[34],"ref":"شرح كتاب الشهاب 446","srcLabel":"القضاعي","text":[["السعادةُ كلُّ السعادةِ",2]," ",["طولُ العمرِ في طاعةِ اللهِ",1]," – عزَّ وجلَّ -"],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"إسناده حسن","takhrij":"أخرجه القضاعي في ((مسند الشهاب)) (312 )، والديلمي في ((الفردوس)) (3566 )، وابن عساكر في ((تاريخ دمشق)) (35/ 340)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"NpicWE1d"},{"id":"س-05407","fp":"3a70b489355b","stateId":33,"easy":"إذا صمت ← فلك فرحتان: عند فطرك وفي الآخرة","cause":"للصائمِ","result":"فرحتانِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-01792","ref":"تخريج المسند لشعيب 8550","text":[["للصائمِ",1]," ",["فرحتانِ",2],": فرحةٌ في الدُّنيا عندَ إفطارِه، وفرحةٌ في الآخِرةِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1904)، ومسلم (1151)، والنسائي (2215)، وابن ماجه (1638) مطولاً بنحوه، والترمذي (766) بنحوه، وأحمد (8550) واللفظ له","bab":"رقائق وزهد › الحب للقاء الله","dorar":"LtIremRB"},{"id":"س-03958","fp":"fc0a53d38f61","stateId":33,"easy":"إذا غفر الله لك ← تستريح حقاً","cause":"مَنْ غُفِرَ لهُ","result":"إِنَّما يَسْتَرِيحُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[11],"ref":"السلسلة الصحيحة 1710","srcLabel":"السلسلة الصحيحة","text":[["إِنَّما يَسْتَرِيحُ",2]," ",["مَنْ غُفِرَ لهُ",1]],"grade":"صحيح","narrator":"عائشة وبلال الحبشي ومحمد بن عروة","muhaddith":"صحيح بمجموع طرقه","bab":"توبة › الحض على التوبة","dorar":"gVNGFJhg","merged":3,"otherRefs":["صحيح الجامع 2319 (صحيح)","مجمع الزوائد 2/333 (حسن)"]},{"id":"س-04451","fp":"72b6e7ca0c6e","stateId":34,"easy":"إذا كنت مستعداً للجهاد في سبيل الله على فرسك ← فهو من خير معاش الناس","cause":"رجلٌ مُمْسِكٌ عنانَ فرَسِهِ في سبيلِ اللهِ ، يَطيرُ على متْنِهِ كُلَّمَا سَمِعَ هَيْعَةً أوْ فَزْعَةً طارَ عَلَيْهِ يَبْتَغِي القتلَ والموتَ مظانَّهُ","result":"مِنْ خيرِ معاشِ الناسِ لهم","explicit":true,"star":true,"otherNeedIds":[41,40,31],"ref":"صحيح الجامع 5915","srcLabel":"مسلم","text":[["مِنْ خيرِ معاشِ الناسِ لهم",2]," ، ",["رجلٌ مُمْسِكٌ عنانَ فرَسِهِ في سبيلِ اللهِ ، يَطيرُ على متْنِهِ كُلَّمَا سَمِعَ هَيْعَةً أوْ فَزْعَةً طارَ عَلَيْهِ يَبْتَغِي القتلَ والموتَ مظانَّهُ",1]," ورجلٌ في غُنَيْمَةٍ ، في رأسِ شَعَفَةٍ مِنْ هَذِهِ الشَّعَفِ ، أوْ بَطْنِ وادٍ مِنْ هذِهِ الأودِيَةِ ، يُقيمُ الصلاةَ ويُؤْتِي الزكاةَ ، ويعبدُ ربَّهُ حتى يأتِيَهُ اليقينُ ؛ ليس مِنَ الناسِ إلَّا فِي خيرٍ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1889) باختلاف يسير","bab":"جهاد › فضل الجهاد","dorar":"AE2zFXZ8","merged":5,"otherRefs":["الأحكام الوسطى 2/352 (صحيح)","السلسلة الصحيحة 698 (صحيح)","صحيح ابن حبان 4600 (صحيح)","تخريج المسند لشعيب 1987 (صحيح)"]},{"id":"ق-0575","fp":"5723a0e12811","stateId":34,"easy":"الاستغفار والتوبة ← متاع حسن إلى أجل مسمى وإيتاء كل ذي فضل فضله","cause":"الاستغفار والتوبة","result":"متاع حسن إلى أجل مسمى وإيتاء كل ذي فضل فضله","explicit":true,"star":true,"otherNeedIds":[1,40],"ref":"سورة هود: 3","srcLabel":"القرآن الكريم","quran":{"s":11,"from":3,"to":3,"text":"وَأَنِ اسْتَغْفِرُوا رَبَّكُمْ ثُمَّ تُوبُوا إِلَيْهِ يُمَتِّعْكُمْ مَتَاعًا حَسَنًا إِلَى أَجَلٍ مُسَمًّى وَيُؤْتِ كُلَّ ذِي فَضْلٍ فَضْلَهُ وَإِنْ تَوَلَّوْا فَإِنِّي أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ كَبِيرٍ (3)","hl":[[0,141,1]]}},{"id":"ق-0667","fp":"27198a61afdf","stateId":34,"easy":"الإحسان في الدنيا والتقوى ← حسنة في الدنيا ودار الآخرة خير","cause":"الإحسان في الدنيا والتقوى","result":"حسنة في الدنيا ودار الآخرة خير","explicit":true,"similar":["ق-1075"],"otherNeedIds":[55],"ref":"سورة النحل: 30","srcLabel":"القرآن الكريم","quran":{"s":16,"from":30,"to":30,"text":"وَقِيلَ لِلَّذِينَ اتَّقَوْا مَاذَا أَنْزَلَ رَبُّكُمْ قَالُوا خَيْرًا لِلَّذِينَ أَحْسَنُوا فِي هَذِهِ الدُّنْيَا حَسَنَةٌ وَلَدَارُ الْآخِرَةِ خَيْرٌ وَلَنِعْمَ دَارُ الْمُتَّقِينَ (30)","hl":[[71,182,1]]}},{"id":"ق-0672","fp":"fb5ff8ae88d9","stateId":34,"easy":"الهجرة في الله بعد الظلم مع الصبر والتوكل ← حسنة في الدنيا وأجر الآخرة أكبر","cause":"الهجرة في الله بعد الظلم مع الصبر والتوكل","result":"حسنة في الدنيا وأجر الآخرة أكبر","explicit":true,"otherNeedIds":[40,1],"ref":"سورة النحل: 41–42","srcLabel":"القرآن الكريم","quran":{"s":16,"from":41,"to":42,"text":"وَالَّذِينَ هَاجَرُوا فِي اللَّهِ مِنْ بَعْدِ مَا ظُلِمُوا لَنُبَوِّئَنَّهُمْ فِي الدُّنْيَا حَسَنَةً وَلَأَجْرُ الْآخِرَةِ أَكْبَرُ لَوْ كَانُوا يَعْلَمُونَ (41) الَّذِينَ صَبَرُوا وَعَلَى رَبِّهِمْ يَتَوَكَّلُونَ (42)","hl":[[0,214,1]]}},{"id":"ق-0678","fp":"9a2250fa468a","stateId":34,"easy":"العمل الصالح مع الإيمان (ذكراً أو أنثى) ← حياة طيبة وأجر بأحسن العمل","cause":"العمل الصالح مع الإيمان (ذكراً أو أنثى)","result":"حياة طيبة وأجر بأحسن العمل","explicit":true,"otherNeedIds":[40],"ref":"سورة النحل: 97","srcLabel":"القرآن الكريم","quran":{"s":16,"from":97,"to":97,"text":"مَنْ عَمِلَ صَالِحًا مِنْ ذَكَرٍ أَوْ أُنْثَى وَهُوَ مُؤْمِنٌ فَلَنُحْيِيَنَّهُ حَيَاةً طَيِّبَةً وَلَنَجْزِيَنَّهُمْ أَجْرَهُمْ بِأَحْسَنِ مَا كَانُوا يَعْمَلُونَ (97)","hl":[[0,163,1]]}},{"id":"ق-1055","fp":"b76639554900","stateId":34,"easy":"الإيمان (قوم يونس) ← التمتيع إلى حين","cause":"الإيمان (قوم يونس)","result":"التمتيع إلى حين","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[30],"ref":"سورة الصافات: 148","srcLabel":"القرآن الكريم","quran":{"s":37,"from":148,"to":148,"text":"فَآمَنُوا فَمَتَّعْنَاهُمْ إِلَى حِينٍ (148)","hl":[[0,38,1]]}},{"id":"ق-1075","fp":"bf63d3850d08","stateId":34,"easy":"الإحسان في الدنيا والتقوى ← حسنة","cause":"الإحسان في الدنيا والتقوى","result":"حسنة","explicit":true,"repOf":"ق-0667","ref":"سورة الزمر: 10","quran":{"s":39,"from":10,"to":10,"text":"قُلْ يَا عِبَادِ الَّذِينَ آمَنُوا اتَّقُوا رَبَّكُمْ لِلَّذِينَ أَحْسَنُوا فِي هَذِهِ الدُّنْيَا حَسَنَةٌ وَأَرْضُ اللَّهِ وَاسِعَةٌ إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُمْ بِغَيْرِ حِسَابٍ (10)","hl":[[54,106,1]]}}]}