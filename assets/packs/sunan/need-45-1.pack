1cc3f","stateId":415,"easy":"الاهتداء ← نفعه لنفسه","cause":"الاهتداء","result":"نفعه لنفسه","explicit":true,"repOf":"ق-0573","ref":"سورة النمل: 92","quran":{"s":27,"from":92,"to":92,"text":"وَأَنْ أَتْلُوَ الْقُرْآنَ فَمَنِ اهْتَدَى فَإِنَّمَا يَهْتَدِي لِنَفْسِهِ وَمَنْ ضَلَّ فَقُلْ إِنَّمَا أَنَا مِنَ الْمُنْذِرِينَ (92)","hl":[[27,74,1]]}},{"id":"ق-0936","fp":"31d1b41408f9","stateId":415,"easy":"الإيمان والعمل الصالح ← الدخول في الصالحين","cause":"الإيمان والعمل الصالح","result":"الدخول في الصالحين","explicit":true,"otherNeedIds":[67],"ref":"سورة العنكبوت: 9","srcLabel":"القرآن الكريم","quran":{"s":29,"from":9,"to":9,"text":"وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَنُدْخِلَنَّهُمْ فِي الصَّالِحِينَ (9)","hl":[[0,80,1]]}},{"id":"ق-0992","fp":"53919da15c73","stateId":415,"easy":"القنوت لله ورسوله والعمل الصالح ← الأجر مرتين ورزق كريم","cause":"القنوت لله ورسوله والعمل الصالح","result":"الأجر مرتين ورزق كريم","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"otherNeedIds":[1],"ref":"سورة الأحزاب: 31","srcLabel":"القرآن الكريم","quran":{"s":33,"from":31,"to":31,"text":"وَمَنْ يَقْنُتْ مِنْكُنَّ لِلَّهِ وَرَسُولِهِ وَتَعْمَلْ صَالِحًا نُؤْتِهَا أَجْرَهَا مَرَّتَيْنِ وَأَعْتَدْنَا لَهَا رِزْقًا كَرِيمًا (31)","hl":[[0,134,1]]}},{"id":"ق-0996","fp":"fd2644f97ada","stateId":415,"easy":"الإيمان ← فضل كبير من الله","cause":"الإيمان","result":"فضل كبير من الله","explicit":true,"otherNeedIds":[1],"ref":"سورة الأحزاب: 47","srcLabel":"القرآن الكريم","quran":{"s":33,"from":47,"to":47,"text":"وَبَشِّرِ الْمُؤْمِنِينَ بِأَنَّ لَهُمْ مِنَ اللَّهِ فَضْلًا كَبِيرًا (47)","hl":[[0,69,1]]}},{"id":"ق-1013","fp":"5f72fa8ff0e6","stateId":415,"easy":"الإيمان والعمل الصالح (لا كثرة الأموال والأولاد) ← جزاء الضعف والأمن في الغرفات","cause":"الإيمان والعمل الصالح (لا كثرة الأموال والأولاد)","result":"جزاء الضعف والأمن في الغرفات","explicit":true,"otherNeedIds":[68,6],"ref":"سورة سبأ: 37","srcLabel":"القرآن الكريم","quran":{"s":34,"from":37,"to":37,"text":"وَمَا أَمْوَالُكُمْ وَلَا أَوْلَادُكُمْ بِالَّتِي تُقَرِّبُكُمْ عِنْدَنَا زُلْفَى إِلَّا مَنْ آمَنَ وَعَمِلَ صَالِحًا فَأُولَئِكَ لَهُمْ جَزَاءُ الضِّعْفِ بِمَا عَمِلُوا وَهُمْ فِي الْغُرُفَاتِ آمِنُونَ (37)","hl":[[0,202,1]]}},{"id":"ق-1090","fp":"0445be4c93ed","stateId":415,"easy":"الاهتداء ← نفعه لنفسه","cause":"الاهتداء","result":"نفعه لنفسه","explicit":true,"repOf":"ق-0573","ref":"سورة الزمر: 41","quran":{"s":39,"from":41,"to":41,"text":"إِنَّا أَنْزَلْنَا عَلَيْكَ الْكِتَابَ لِلنَّاسِ بِالْحَقِّ فَمَنِ اهْتَدَى فَلِنَفْسِهِ وَمَنْ ضَلَّ فَإِنَّمَا يَضِلُّ عَلَيْهَا وَمَا أَنْتَ عَلَيْهِمْ بِوَكِيلٍ (41)","hl":[[60,88,1]]}},{"id":"ق-1128","fp":"83b2e0673937","stateId":415,"easy":"الإيمان والعمل الصالح ← أجر غير ممنون","cause":"الإيمان والعمل الصالح","result":"أجر غير ممنون","explicit":true,"similar":["ق-1425","ق-1446"],"ref":"سورة فصلت: 8","srcLabel":"القرآن الكريم","quran":{"s":41,"from":8,"to":8,"text":"إِنَّ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ (8)","hl":[[0,79,1]]}},{"id":"ق-1141","fp":"faacfe4fa928","stateId":415,"easy":"العمل الصالح ← نفعه لنفسه","cause":"العمل الصالح","result":"نفعه لنفسه","explicit":true,"ref":"سورة فصلت: 46","srcLabel":"القرآن الكريم","quran":{"s":41,"from":46,"to":46,"text":"مَنْ عَمِلَ صَالِحًا فَلِنَفْسِهِ وَمَنْ أَسَاءَ فَعَلَيْهَا وَمَا رَبُّكَ بِظَلَّامٍ لِلْعَبِيدِ (46)","hl":[[0,34,1]]}},{"id":"ق-1251","fp":"d69a77be0871","stateId":415,"easy":"طاعة الله ورسوله ← لا ينقص من العمل شيء","cause":"طاعة الله ورسوله","result":"لا ينقص من العمل شيء","explicit":true,"ref":"سورة الحجرات: 14","srcLabel":"القرآن الكريم","quran":{"s":49,"from":14,"to":14,"text":"قَالَتِ الْأَعْرَابُ آمَنَّا قُلْ لَمْ تُؤْمِنُوا وَلَكِنْ قُولُوا أَسْلَمْنَا وَلَمَّا يَدْخُلِ الْإِيمَانُ فِي قُلُوبِكُمْ وَإِنْ تُطِيعُوا اللَّهَ وَرَسُولَهُ لَا يَلِتْكُمْ مِنْ أَعْمَالِكُمْ شَيْئًا إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ (14)","hl":[[125,233,1]]}},{"id":"ق-1425","fp":"2ed963741cb1","stateId":415,"easy":"الإيمان والعمل الصالح ← أجر غير ممنون","cause":"الإيمان والعمل الصالح","result":"أجر غير ممنون","explicit":true,"repOf":"ق-1128","ref":"سورة الانشقاق: 25","quran":{"s":84,"from":25,"to":25,"text":"إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ (25)","hl":[[7,80,1]]}},{"id":"ق-1446","fp":"2e096c065a23","stateId":415,"easy":"الإيمان والعمل الصالح ← أجر غير ممنون","cause":"الإيمان والعمل الصالح","result":"أجر غير ممنون","explicit":true,"repOf":"ق-1128","ref":"سورة التين: 6","quran":{"s":95,"from":6,"to":6,"text":"إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ (6)","hl":[[7,82,1]]}},{"id":"س-06994","fp":"04adc518e494","stateId":415,"easy":"إذا بلغك عن الله فضل فعملت به إيماناً ورجاء ثوابه ← يعطيك الله ذلك","cause":"من بلغَهُ عن اللَّهِ عزَّ وجلَّ شيءٌ فيهِ فضيلةٌ فأخذَ بهِ إيمانَ ورجاءَ ثَوابِهِ","result":"أعطاهُ اللَّهُ ذلكَ وإن لَم يكُن كذلِكَ","explicit":true,"ref":"مختصر المقاصد 1003","srcLabel":"ابن شاهين","text":[["من بلغَهُ عن اللَّهِ عزَّ وجلَّ شيءٌ فيهِ فضيلةٌ فأخذَ بهِ إيمانَ ورجاءَ ثَوابِهِ",1]," ، ",["أعطاهُ اللَّهُ ذلكَ وإن لَم يكُن كذلِكَ",2]],"grade":"حسن","narrator":"[جابر بن عبدالله]","muhaddith":"حسن لغيره","takhrij":"أخرجه ابن شاهين في ((شرح مذاهب أهل السنة)) (68)، والخطيب في ((تاريخ بغداد)) (8/295)، وابن الجوزي في ((الموضوعات)) (1/258)","bab":"علم › الحث على الأخذ بالسنة","dorar":"BE8JF6jX"},{"id":"س-03039","fp":"541dff2e77a2","stateId":415,"easy":"إذا وفّيت بالبيعة (ألا تشرك ولا تسرق ولا تزني...) ← فأجرك على الله","cause":"فمَنْ وَفَّى","result":"فأجْرُهُ على اللهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"المستدرك على الصحيحين 3282","srcLabel":"الشاشي","text":["قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «مَنْ يُبايعُني على هؤلاء الآياتِ؟». ثُمَّ قَرَأَ: {قُلْ تَعَالَوْا أَتْلُ مَا حَرَّمَ رَبُّكُمْ عَلَيْكُمْ} [الأنعام: 151] حتَّى خَتَمَ الآياتِ الثَّلاثَ. «",["فمَنْ وَفَّى",1]," ",["فأجْرُهُ على اللهِ",2],"، ومَنِ انتَقَصَ شيئًا أدرَكَهُ اللهُ بها في الدُّنيا كانت عُقوبتُهُ، ومَنْ أخَّرَ إلى الآخِرةِ كان أمرُهُ إلى اللهِ، إنْ شاءَ عذَّبَهُ وإنْ شاءَ غَفَرَ له»."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الشاشي (مسنده) (1229) بلفظه، ومحمد بن نصر المروزي في ((تعظيم قدر الصلاة)) (660)","bab":"إيمان › الوعيد","dorar":"nYLKIfYT"},{"id":"س-01123","fp":"b384d928f4ad","stateId":416,"easy":"إذا سبّحت وحمدت ثلاثاً وثلاثين وكبّرت أربعاً وثلاثين دبر كل صلاة ← فهي معقبات لا يخيب قائلهن","cause":"دُبُرَ كُلِّ صَلاةٍ مَكتوبةٍ: ثَلاثٌ وثَلاثونَ تَسبيحةً، وثَلاثٌ وثَلاثونَ تَحميدةً، وأربَعٌ وثَلاثونَ تَكبيرةً","result":"مُعَقِّباتٌ لا يَخيبُ قائِلُهنَّ","explicit":true,"star":true,"apply":{"k":"count","t":"ثلاثاً وثلاثين · الوقت: دبر كل صلاة"},"otherNeedIds":[53],"ref":"صحيح مسلم 596","srcLabel":"مسلم","text":[["مُعَقِّباتٌ لا يَخيبُ قائِلُهنَّ",2]," أو فاعِلُهنَّ ",["دُبُرَ كُلِّ صَلاةٍ مَكتوبةٍ: ثَلاثٌ وثَلاثونَ تَسبيحةً، وثَلاثٌ وثَلاثونَ تَحميدةً، وأربَعٌ وثَلاثونَ تَكبيرةً",1],"."],"grade":"صحيح","narrator":"كعب بن عجرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم ( (596) واللفظ له، والترمذي (3412)، والنسائي (1349) باحتلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"7iBxGQI4","merged":3,"otherRefs":["صحيح النسائي 1348 (صحيح)","نتائج الأفكار 2/269 (صحيح)"]},{"id":"س-05853","fp":"021e588cfdb0","stateId":416,"easy":"إذا سبّحت وحمدت وكبّرت خلف كل صلاة ثلاثاً وثلاثين ← تدرك من سبقك ولا يدركك أحد بعدك","cause":"تُسَبِّحُونَ ، و تَحْمَدونَ ؛ و تُكَبِّرونَ خَلْفَ كُلِّ صَلَاةٍ ثلاثًا وثلاثينَ","result":"أَلَا أُحَدِّثُكُمْ بِأَمْرٍ إِنْ أَخَذْتُمْ بِهِ أَدْرَكْتُمْ مَنْ قَبْلَكُمْ ، ولَمْ يُدْرِككُّمْ مَنْ بَعْدَكُمْ ، و كنتُمْ خَيْرَ مَنْ أَنتُم بَيْنَ ظَهْرَانَيْهِ ؛ إِلَّا مَنْ عَمِلَ مِثْلَهُ","explicit":true,"apply":{"k":"count","t":"ثلاثاً وثلاثين"},"ref":"صحيح الجامع 2590","srcLabel":"مسلم","text":[["أَلَا أُحَدِّثُكُمْ بِأَمْرٍ إِنْ أَخَذْتُمْ بِهِ أَدْرَكْتُمْ مَنْ قَبْلَكُمْ ، ولَمْ يُدْرِككُّمْ مَنْ بَعْدَكُمْ ، و كنتُمْ خَيْرَ مَنْ أَنتُم بَيْنَ ظَهْرَانَيْهِ ؛ إِلَّا مَنْ عَمِلَ مِثْلَهُ ",2],"؟",[" تُسَبِّحُونَ ، و تَحْمَدونَ ؛ و تُكَبِّرونَ خَلْفَ كُلِّ صَلَاةٍ ثلاثًا وثلاثينَ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (595)، وأبو عوانة في ((المستخرج)) (2130)، والطبراني في ((الدعاء)) (720) باختلاف يسير.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"j3ZcdCnK"},{"id":"س-00881","fp":"8c8f4e8564b1","stateId":416,"easy":"إذا قلتها بعد المغرب والصبح قبل أن تنصرف ← يكتب الله لك بكل واحدة عشر حسنات","cause":"مَن قالَ قبلَ أن ينصرفَ ويثنيَ رجليهِ من صلاةِ المغربِ والصُّبحِ لا إلَهَ إلَّا اللَّهُ وحدَهُ لا شريكَ لَهُ لَهُ الملكُ ولَهُ الحمدُ يحيي ويميتُ وَهوَ على كلِّ شيءٍ قديرٌ عشرَ مرَّاتٍ","result":"كَتبَ اللَّهُ لَهُ بِكُلِّ واحدةٍ عشرَ حسَناتٍ ومحا عنهُ عشرَ سيِّئاتٍ ورفعَ لَهُ عشرَ درجاتٍ وَكانَت له حِرزًا من كلِّ مَكْروهٍ وحِرزًا منَ الشَّيطانِ الرَّجيمِ ولم يحِلَّ للذَّنبِ أن يُدْرِكَهُ","explicit":true,"otherNeedIds":[11,47],"ref":"الترغيب والترهيب 1/225","srcLabel":"أحمد","text":[["مَن قالَ قبلَ أن ينصرفَ ويثنيَ رجليهِ من صلاةِ المغربِ والصُّبحِ لا إلَهَ إلَّا اللَّهُ وحدَهُ لا شريكَ لَهُ لَهُ الملكُ ولَهُ الحمدُ يحيي ويميتُ وَهوَ على كلِّ شيءٍ قديرٌ عشرَ مرَّاتٍ ",1],["كَتبَ اللَّهُ لَهُ بِكُلِّ واحدةٍ عشرَ حسَناتٍ ومحا عنهُ عشرَ سيِّئاتٍ ورفعَ لَهُ عشرَ درجاتٍ وَكانَت له حِرزًا من كلِّ مَكْروهٍ وحِرزًا منَ الشَّيطانِ الرَّجيمِ ولم يحِلَّ للذَّنبِ أن يُدْرِكَهُ",2]," إلَّا الشِّركَ وَكانَ من أفضلِ النَّاسِ عملًا إلَّا رجلًا يَفضلُهُ يقولُ أفضلَ مِمَّا قالَ"],"grade":"صحيح","narrator":"عبدالرحمن بن غنم","muhaddith":"رجاله رجال الصحيح غير شهر بن حوشب وعبدالرحمن بن غنم مختلف في صحبته","takhrij":"أخرجه أحمد (17990)، وابن حجر في ((الأمالي الحلبية)) (17) كلاهما بلفظه، وعبد الرزاق (3192) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"PCxMTMWk"},{"id":"س-00984","fp":"a53f803810cf","stateId":416,"easy":"إذا سبّحت وحمدت وكبّرت عشراً دبر كل صلاة ← فهي مئتان وخمسون حسنة تُضاعف ألفين وخمسمئة","cause":"ومَن يعمَلُهما قليلٌ؛ يُسبِّحُ عشرًا في دُبُرِ كلِّ صلاةٍ، ويَحمَدُ عشرًا، ويُكبِّرُ عشرًا، فإذا أَوَى إلى فِراشِه مِن الليلِ سبَّح ثلاثًا وثلاثينَ، وحَمِد ثلاثًا وثلاثينَ، وكبَّر أربعًا وثلاثينَ","result":"فتلك خمسونَ ومئتا حسنةٍ، وإذا ضُعِّفَتْ كانتْ ألفينِ وخمسَ مئةٍ، فأيُّكم يعملُ في يومِه وليلتِه ألفينِ وخمسَ مئةِ سيِّئةٍ","explicit":true,"apply":{"k":"time","t":"دبر كل صلاة"},"ref":"تخريج مشكل الآثار 4090","srcLabel":"أبو داود","text":["خَصلتانِ لا يَجمَعُهما مسلمٌ إلَّا دخَلَ الجنَّةَ، وهما يسيرٌ، ",["ومَن يعمَلُهما قليلٌ؛ يُسبِّحُ عشرًا في دُبُرِ كلِّ صلاةٍ، ويَحمَدُ عشرًا، ويُكبِّرُ عشرًا، فإذا أَوَى إلى فِراشِه مِن الليلِ سبَّح ثلاثًا وثلاثينَ، وحَمِد ثلاثًا وثلاثينَ، وكبَّر أربعًا وثلاثينَ، ",1],["فتلك خمسونَ ومئتا حسنةٍ، وإذا ضُعِّفَتْ كانتْ ألفينِ وخمسَ مئةٍ، فأيُّكم يعملُ في يومِه وليلتِه ألفينِ وخمسَ مئةِ سيِّئةٍ",2],"؟"],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن","takhrij":"أخرجه أبو داود (5065)، والترمذي (3410)، والنسائي (1348) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"6bLRFsG4"},{"id":"س-00742","fp":"9ec4c695a720","stateId":417,"easy":"إذا قلتها عشر مرات حين تصبح ← تُكتب لك مئة حسنة وتُمحى عنك مئة سيئة","cause":"مَن قالها عَشْرَ مرَّاتٍ حين يُصبِحُ","result":"كُتِبَ له بها مِئةُ حَسنةٍ، ومُحِيَ عنه بها مِئةُ سَيِّئةٍ، وكانتْ له عَدْلَ رَقَبةٍ، وحُفِظَ بها يومئذٍ حتى يُمسي","explicit":true,"star":true,"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ، وَحْدَه لا شريكَ له، له المُلكُ، وله الحمدُ، وهو على كلِّ شيءٍ قديرٌ» · العدد: عشر مرات · الوقت: في الصباح"},"otherNeedIds":[11,49],"ref":"تخريج المسند لشعيب 8719","srcLabel":"متفق عليه","text":["مَن قال: لا إلهَ إلَّا اللهُ، وَحْدَه لا شريكَ له، له المُلكُ، وله الحمدُ، وهو على كلِّ شيءٍ قديرٌ، ",["مَن قالها عَشْرَ مرَّاتٍ حين يُصبِحُ، ",1],["كُتِبَ له بها مِئةُ حَسنةٍ، ومُحِيَ عنه بها مِئةُ سَيِّئةٍ، وكانتْ له عَدْلَ رَقَبةٍ، وحُفِظَ بها يومئذٍ حتى يُمسي، ",2],"ومَن قال مِثلَ ذلك حين يُمسي، كان له مِثلُ ذلك."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6403)، ومسلم (2691) بلفظ مقارب","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"k9ZXrBtc"},{"id":"س-00874","fp":"85cd356a21e5","stateId":417,"easy":"إذا قلت صباحاً ومساءً «سبحان الله العظيم وبحمده» مئة مرة ← لا يأتي أحد يوم القيامة بأفضل منك إلا من زاد","cause":"مَنْ قال حِينَ يُصبِحُ و حِينَ يُمسِي : سُبحانَ اللهِ العظيمِ و بِحمدِهِ ، مِائةَ مَرَّةٍ","result":"لمْ يأتِ أحدٌ يومَ القِيامةِ بأفْضلَ مِمَّا جاء به ، إلَّا أحَدٌ","explicit":true,"apply":{"k":"say","t":"«سبحان الله العظيم وبحمده» · العدد: مئة مرة · الوقت: صباحاً ومساءً"},"ref":"صحيح الجامع 6425","srcLabel":"مسلم","text":[["مَنْ قال حِينَ يُصبِحُ و حِينَ يُمسِي : سُبحانَ اللهِ العظيمِ و بِحمدِهِ ، مِائةَ مَرَّةٍ ، ",1],["لمْ يأتِ أحدٌ يومَ القِيامةِ بأفْضلَ مِمَّا جاء به ، إلَّا أحَدٌ",2]," قال مِثلَ ذلِكَ ، و زادَ عليْهِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2692) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"bs0nwLje"},{"id":"س-00771","fp":"4e61ae2989a4","stateId":417,"easy":"إذا قلت بعد الصبح «لا إله إلا الله وحده لا شريك له...» ← تُكتب لك بكل واحدة عشر حسنات وتُحط عشر سيئات","cause":"وإذا صَلَّيتِ صَلاةَ الصُّبحِ، فقولي: لا إلهَ إلَّا اللهُ وحدَهُ لا شَريكَ له، له المُلكُ وله الحَمدُ، يُحيي ويُميتُ، بيَدِه الخَيرُ، وهو على كلِّ شيءٍ قديرٌ. عَشْرَ مرَّاتٍ بعدَ صلاةِ الصُّبحِ، وعَشْرَ مرَّاتٍ بعدَ صَلاةِ المَغرِبِ","result":"فإنَّ كلَّ واحدةٍ منهنَّ تُكتَبُ عَشْرَ حَسَناتٍ، وتَحُطُّ عَشْرَ سيِّئاتٍ، وكلُّ واحدةٍ منهنَّ كعِتقِ رَقبةٍ مِن وَلدِ إسماعيلَ، ولا يَحِلُّ لذَنبٍ كُسِبَ ذلكَ اليومَ أنْ يُدرِكَه إلَّا أنْ يَكونَ الشِّركُ، لا إلهَ إلَّا اللهُ وحدَهُ لا شريكَ له، وهو حَرَسُكِ، ما بينَ أنْ تَقوليهِ غُدْوةً إلى أنْ تَقوليه عَشيَّةً، من كلِّ شَيطانٍ، ومن كلِّ سُوءٍ","explicit":true,"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ وحدَهُ لا شَريكَ له، له المُلكُ وله الحَمدُ، يُحيي ويُميتُ، بيَدِه الخَيرُ، وهو على كلِّ شيءٍ قدير»"},"similar":["س-00880","س-01124"],"otherNeedIds":[11,49,31],"ref":"تخريج المسند لشعيب 26551","srcLabel":"أحمد","text":["زَعمَتْ أنَّ فاطمةَ، جاءتْ إلى نبيِّ اللهِ تَشتَكي إليه الخِدمةَ، فقالَت: يا رسولَ اللهِ، واللهِ لقد مَجِلتْ يدايَ من الرَّحى، أطحَنُ مرَّةً، وأعجِنُ مرَّةً، فقالَ لها رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ: إنْ يَرزُقْكِ اللهُ شيئًا يأتِكِ، وسأدُلُّكِ على خيرٍ من ذلكَ؛ إذا لَزِمتِ مَضجَعَكِ، فسَبِّحي اللهَ ثَلاثًا وثلاثينَ، وكَبِّري ثَلاثًا وثلاثينَ، واحمَدي أربَعًا وثلاثينَ، فذلك مِئةٌ، فهو خيرٌ لكِ من الخادِمِ، ",["وإذا صَلَّيتِ صَلاةَ الصُّبحِ، فقولي: لا إلهَ إلَّا اللهُ وحدَهُ لا شَريكَ له، له المُلكُ وله الحَمدُ، يُحيي ويُميتُ، بيَدِه الخَيرُ، وهو على كلِّ شيءٍ قديرٌ. عَشْرَ مرَّاتٍ بعدَ صلاةِ الصُّبحِ، وعَشْرَ مرَّاتٍ بعدَ صَلاةِ المَغرِبِ",1],"؛ ",["فإنَّ كلَّ واحدةٍ منهنَّ تُكتَبُ عَشْرَ حَسَناتٍ، وتَحُطُّ عَشْرَ سيِّئاتٍ، وكلُّ واحدةٍ منهنَّ كعِتقِ رَقبةٍ مِن وَلدِ إسماعيلَ، ولا يَحِلُّ لذَنبٍ كُسِبَ ذلكَ اليومَ أنْ يُدرِكَه إلَّا أنْ يَكونَ الشِّركُ، لا إلهَ إلَّا اللهُ وحدَهُ لا شريكَ له، وهو حَرَسُكِ، ما بينَ أنْ تَقوليهِ غُدْوةً إلى أنْ تَقوليه عَشيَّةً، من كلِّ شَيطانٍ، ومن كلِّ سُوءٍ",2],"."],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"طلب فاطمة رضي الله عنها الخادم، وما دلها عليه صلَّى اللهُ عليهِ وسلَّمَ من الذكر إذا لزمت مضجعها. صحيح لغيره","takhrij":"أخرجه أحمد (26551) واللفظ له، والطبراني (23/339) (787)","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"k3YBql5B"},{"id":"س-00880","fp":"b2b31c937e44","stateId":417,"easy":"إذا قلت بعد الصبح قبل أن تتكلم «لا إله إلا الله وحده...» عشراً ← تُكتب لك عشر حسنات بكل مرة وتُمحى عشر سيئات","cause":"مَن قال بَعدَ صَلاةِ الصُّبحِ وهو ثانٍ رِجلَيْه قَبلَ أنْ يَتكَلَّمَ: لا إلهَ إلَّا اللهُ وَحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ يُحيي ويُميتُ، بيَدِه الخَيرُ وهو على كُلِّ شَيءٍ قَديرٌ عَشْرَ مَرَّاتٍ","result":"كَتَبَ اللهُ له بكُلِّ مَرَّةٍ عَشْرَ حَسَناتٍ، ومَحا عنه عَشْرَ سَيِّئاتٍ، ورَفَعَ له عَشْرَ دَرَجاتٍ، وكُنَّ له في يَومِه ذلك حِرزًا مِن كُلِّ مَكروهٍ، وحَرَسًا مِنَ الشَّيطانِ الرَّجيمِ، وكان له","explicit":true,"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ وَحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ يُحيي ويُميتُ وهو على كُلِّ شَيءٍ قَدير»"},"repOf":"س-00771","otherNeedIds":[11,47],"ref":"الترغيب والترهيب 1/225","text":["مَن قال دُبَرَ صَلاةِ الغَداةِ: لا إلهَ إلَّا اللهُ وَحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ يُحيي ويُميتُ وهو على كُلِّ شَيءٍ قَديرٌ مِئةَ مَرَّةٍ قَبلَ أنْ يَثنيَ رِجلَيْه كان يَومَئِذٍ مِن أفضَلِ أهلِ الأرضِ عَمَلًا، إلَّا مَن قال مِثلَ ما قال، أو زادَ على ما قال. [وفي لَفظٍ:] ",["مَن قال بَعدَ صَلاةِ الصُّبحِ وهو ثانٍ رِجلَيْه قَبلَ أنْ يَتكَلَّمَ: لا إلهَ إلَّا اللهُ وَحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ يُحيي ويُميتُ، بيَدِه الخَيرُ وهو على كُلِّ شَيءٍ قَديرٌ عَشْرَ مَرَّاتٍ ",1],["كَتَبَ اللهُ له بكُلِّ مَرَّةٍ عَشْرَ حَسَناتٍ، ومَحا عنه عَشْرَ سَيِّئاتٍ، ورَفَعَ له عَشْرَ دَرَجاتٍ، وكُنَّ له في يَومِه ذلك حِرزًا مِن كُلِّ مَكروهٍ، وحَرَسًا مِنَ الشَّيطانِ الرَّجيمِ، وكان له",2]," بكُلِّ مَرَّةٍ عِتقُ رَقَبةٍ مِن وَلَدِ إسْماعيلَ، ثَمَنُ كُلِّ رَقَبةٍ اثْنا عَشَرَ ألْفًا، ولم يَلحَقْه يَومَئِذٍ ذَنبٌ إلَّا الشِّركَ باللهِ، ومَن قال ذلك بَعدَ صَلاةِ المَغرِبِ كان له مِثلُ ذلك."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (7200)، وابن السني في ((عمل اليوم والليلة)) (142) باختلاف يسير. والرواية أخرجه الطبراني في ((مسند الشاميين)) (23) واللفظ له، وابن عساكر في ((تاريخ دمشق)) (38/100) من حديث أبي الدرداء رضي الله عنه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"qKcJf4m7"},{"id":"س-01019","fp":"acec72d5ebfa","stateId":417,"easy":"إذا قلت في يوم مئتي مرة «لا إله إلا الله وحده...» ← لا يسبقك أحد قبلك ولا يدركك أحد بعدك","cause":"من قالَ في يومٍ مائتي مرَّةٍ : لا إلَهَ إلَّا اللَّهُ وحدَهُ لا شريكَ لَهُ لَهُ الملكُ","result":"ولَهُ الحمدُ ، وَهوَ على كلِّ شيءٍ قديرٌ لم يسبِقهُ أحدٌ كانَ قبلَهُ ولم يدرِكْهُ أحدٌ كانَ بعدَهُ ، إلَّا بأفضلَ من عملِهِ","explicit":true,"apply":{"k":"say","t":"«لا إلَهَ إلَّا اللَّهُ وحدَهُ لا شريكَ لَهُ لَهُ الملكُ ، ولَهُ الحمدُ ، وَهوَ على كلِّ شيءٍ قدير»"},"ref":"تخريج المسند لشاكر 11/184","srcLabel":"النسائي","text":[["من قالَ في يومٍ مائتي مرَّةٍ : لا إلَهَ إلَّا اللَّهُ وحدَهُ لا شريكَ لَهُ لَهُ الملكُ ، ",1],["ولَهُ الحمدُ ، وَهوَ على كلِّ شيءٍ قديرٌ لم يسبِقهُ أحدٌ كانَ قبلَهُ ولم يدرِكْهُ أحدٌ كانَ بعدَهُ ، إلَّا بأفضلَ من عملِهِ",2]," يعني : إلَّا من عملَ بأفضلَ مِن عملِهِ"],"grade":"صحيح","narrator":"[جد عمرو بن شعيب]","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (7005)واللفظ له، والنسائي في ((الكبرى)) (10335)، والطبراني في ((الدعاء)) (333)  بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"5Tu7ULti"},{"id":"س-01124","fp":"f335c77822c7","stateId":417,"easy":"إذا قلت ثانياً رجليك قبل أن تتكلم «لا إله إلا الله وحده...» ← تُكتب لك عشر حسنات وتُمحى عشر سيئات وتُرفع عشر درجات","cause":"ثانٍ رجلَيْهِ قبلَ أن يتكلَّمَ : لا إلهَ إلَّا اللهُ ، وحدَهُ لا شريكَ لهُ ، لهُ المُلْكُ ولهُ الحمدُ ، يُحيي ويُميتُ ، وهوَ على كلِّ شيءٍ قديرٌ . عشرَ مرَّاتٍ","result":"كُتِبَتْ لهُ عشرُ حسناتٍ ، ومُحِيَ عنهُ عشرُ سَيئاتٍ ، ورُفِعَ لهُ عشرُ درجاتٍ ، وكان يومَهُ ذلكَ كلَّهُ في حِرْزٍ من كلِّ مكروهٍ ، وحُرِسَ من الشَّيطانِ ، ولَم ينبَغِ لذنبٍ أن يُدركَهُ في ذلكَ اليومِ إلَّا الشِّركُ باللهِ","explicit":true,"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ ، وحدَهُ لا شريكَ لهُ ، لهُ المُلْكُ ولهُ الحمدُ ، يُحيي ويُميتُ ، وهوَ على كلِّ شيءٍ قديرٌ»"},"repOf":"س-00771","otherNeedIds":[11,47,31],"ref":"سنن الترمذي 3474","text":["من قال في دُبُرِ صلاةِ الفجرِ ، وهوَ ",["ثانٍ رجلَيْهِ قبلَ أن يتكلَّمَ : لا إلهَ إلَّا اللهُ ، وحدَهُ لا شريكَ لهُ ، لهُ المُلْكُ ولهُ الحمدُ ، يُحيي ويُميتُ ، وهوَ على كلِّ شيءٍ قديرٌ . عشرَ مرَّاتٍ",1]," ",["كُتِبَتْ لهُ عشرُ حسناتٍ ، ومُحِيَ عنهُ عشرُ سَيئاتٍ ، ورُفِعَ لهُ عشرُ درجاتٍ ، وكان يومَهُ ذلكَ كلَّهُ في حِرْزٍ من كلِّ مكروهٍ ، وحُرِسَ من الشَّيطانِ ، ولَم ينبَغِ لذنبٍ أن يُدركَهُ في ذلكَ اليومِ إلَّا الشِّركُ باللهِ",2]," . [ انظرْ : \" صحيحَ التَّرغيبِ \" رقم : 474 و \" السِّلسلةَ الصَّحيحةَ \" رقم : 114 ]"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"حسن غريب صحيح","takhrij":"أخرجه الترمذي (3474) واللفظ له، والنسائي في ((السنن الكبرى)) (9955)","bab":"أدعية وأذكار › فضل الذكر","dorar":"CI3TjUuT"},{"id":"س-01140","fp":"c2f7bf50bb7d","stateId":417,"easy":"إذا قلت «لا إله إلا الله وحده لا شريك له... يحيي ويميت» ← يبعث الله لك حرساً يحفظونك من الشيطان حتى تصبح","cause":"مَن قال: لا إلهَ إلَّا اللهُ وَحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، يُحيي ويُميتُ، وهو على كُلِّ شَيءٍ قَديرٌ عَشْرَ مَرَّاتٍ على إثْرِ المَغرِبِ","result":"بَعَثَ اللهُ له مَسلَحةً يَحفَظونَه مِنَ الشَّيطانِ حتى يُصبِحَ، وكَتَبَ له بها عَشْرَ حَسَناتٍ مُوجِباتٍ، ومَحا عنه عَشْرَ سَيِّئاتٍ مُوبِقاتٍ، وكانت له بعَدلِ عَشْرِ رَقَباتٍ مُؤمِناتٍ","explicit":true,"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ وَحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، يُحيي ويُميت»"},"otherNeedIds":[11,49],"ref":"الترغيب والترهيب 1/224","srcLabel":"الترمذي","text":[["مَن قال: لا إلهَ إلَّا اللهُ وَحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، يُحيي ويُميتُ، وهو على كُلِّ شَيءٍ قَديرٌ عَشْرَ مَرَّاتٍ على إثْرِ المَغرِبِ، ",1],["بَعَثَ اللهُ له مَسلَحةً يَحفَظونَه مِنَ الشَّيطانِ حتى يُصبِحَ، وكَتَبَ له بها عَشْرَ حَسَناتٍ مُوجِباتٍ، ومَحا عنه عَشْرَ سَيِّئاتٍ مُوبِقاتٍ، وكانت له بعَدلِ عَشْرِ رَقَباتٍ مُؤمِناتٍ",2],"."],"grade":"صحيح","narrator":"عمارة بن شبيب السبائي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (3534)، والنسائي في ((السنن الكبرى)) (10413)","bab":"أدعية وأذكار › فضل الذكر","dorar":"356614NZ"},{"id":"س-07091","fp":"eff39a24a284","stateId":417,"easy":"إذا قلت حين تصبح «لا إله إلا الله وحده لا شريك له...» ← يُكتب لك أجر عظيم","cause":"ما مِن عَبدٍ يقولُ حين يُصبِحُ: لا إلهَ","result":"إلَّا اللهُ، وَحْدَه لا شَريكَ له، له المُلكُ وله الحَمدُ؛ إلَّا كَتَبَ اللهُ له بها عَشْرَ حَسَناتٍ، ومَحا عنه عَشْرَ سيِّئاتٍ، وإلَّا كُنَّ له عندَ اللهِ عَدْلَ عَشْرِ رِقابٍ مُحرَّرينَ","explicit":true,"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ، وَحْدَه لا شَريكَ له، له المُلكُ وله الحَمد» · الوقت: في الصباح"},"otherNeedIds":[11,49],"ref":"تخريج المسند لشعيب 23516","srcLabel":"الترمذي","text":["لمَّا قَدِمَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ المدينةَ، نَزَلَ علَيَّ فقال لي: يا أبا أيُّوبَ، ألَا أُعلِّمُك؟ قال: قُلتُ: بَلى يا رسولَ اللهِ، قال: ",["ما مِن عَبدٍ يقولُ حين يُصبِحُ: لا إلهَ",1]," ",["إلَّا اللهُ، وَحْدَه لا شَريكَ له، له المُلكُ وله الحَمدُ؛ إلَّا كَتَبَ اللهُ له بها عَشْرَ حَسَناتٍ، ومَحا عنه عَشْرَ سيِّئاتٍ، وإلَّا كُنَّ له عندَ اللهِ عَدْلَ عَشْرِ رِقابٍ مُحرَّرينَ،",2]," وإلَّا كان في جُنَّةٍ مِن الشَّيْطانِ حتى يُمسِيَ، ولا قالَها حين يُمْسي، إلَّا كذلك. قال: فقُلتُ لأبي مُحمَّدٍ: أنتَ سَمِعتَها مِن أبي أيُّوبَ؟ قال: آللهِ لَسَمِعتُه مِن أبي أيُّوبَ يُحدِّثُه عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3553) مختصراً بنحوه، والنسائي في ((السنن الكبرى)) (9852) باختلاف يسير، وأحمد (23516) واللفظ له","bab":"علم › تعليم الناس وفضل ذلك","dorar":"FjsdvQXf"},{"id":"س-00933","fp":"57f5ea4fec05","stateId":417,"easy":"إذا ذكرت الله مع قوم بعد الفجر حتى الشروق ← فهو أحب إلى النبي ﷺ من الدنيا وما فيها","cause":"لأنْ أذكرَ اللهَ تعالى معَ قومٍ بعدَ صلاةِ الفجرِ إلى طلوعِ الشمسِ","result":"أحبَّ إليَّ منَ الدنيا و ما فيها","explicit":true,"similar":["س-00934"],"ref":"الجامع الصغير 7181","srcLabel":"أبو داود","text":[["لأنْ أذكرَ اللهَ تعالى معَ قومٍ بعدَ صلاةِ الفجرِ إلى طلوعِ الشمسِ",1],"،  ",["أحبَّ إليَّ منَ الدنيا و ما فيها",2],"،  و لأنْ أذكرَ اللهَ معَ قومٍ بعدَ صلاةِ العصرِ إلى أنْ تغيبَ الشمسُ أحبَّ إليَّ منَ الدنيا و ما فيها"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (555) واللفظ له، وأبو داود (3667)، وأحمد (13760) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"k9LFeIAc"},{"id":"س-00934","fp":"37eb3d5208d3","stateId":417,"easy":"إذا ذكرت الله مع قوم بعد العصر حتى الغروب ← فهو أحب إليه من الدنيا وما فيها","cause":"و لأنْ أذكرَ اللهَ معَ قومٍ بعدَ صلاةِ العصرِ إلى أنْ تغيبَ الشمسُ","result":"أحبَّ إليَّ منَ الدنيا و ما فيها","explicit":true,"repOf":"س-00933","ref":"الجامع الصغير 7181","text":["لأنْ أذكرَ اللهَ تعالى معَ قومٍ بعدَ صلاةِ الفجرِ إلى طلوعِ الشمسِ،  أحبَّ إليَّ منَ الدنيا و ما فيها،  ",["و لأنْ أذكرَ اللهَ معَ قومٍ بعدَ صلاةِ العصرِ إلى أنْ تغيبَ الشمسُ",1]," ",["أحبَّ إليَّ منَ الدنيا و ما فيها",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (555) واللفظ له، وأبو داود (3667)، وأحمد (13760) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"k9LFeIAc"},{"id":"س-01155","fp":"0004deddc684","stateId":417,"easy":"إذا هلّلت وسبّحت وحمدت عند منامك ثلاثاً وثلاثين ← فتلك مئة خير من الدنيا وما فيها","cause":"تُهَلِّلينَ اللهَ ثلاثًا وثلاثينَ عندَ مَنامِكَ وتُسَبِّحينَه ثلاثًا وثلاثينَ ، وتَحمَدينَه أربعًا وثلاثينَ","result":"تلك مِئةٌ خيرٌ منَ الدنيا وما فيها","explicit":true,"apply":{"k":"count","t":"ثلاثاً وثلاثين"},"otherNeedIds":[49,1],"ref":"إتحاف الخيرة المهرة 6/404","srcLabel":"ابن أبي شيبة","text":["أتَتِ امرأةٌ إلى النبيِّ صلَّى اللهُ عليه وسلَّم تَشكو إليه الحاجةَ ، فقال : ألا أدلُّكَ على خيرٍ مِن ذلك ",["تُهَلِّلينَ اللهَ ثلاثًا وثلاثينَ عندَ مَنامِكَ وتُسَبِّحينَه ثلاثًا وثلاثينَ ، وتَحمَدينَه أربعًا وثلاثينَ",1]," ، قال : ",["تلك مِئةٌ خيرٌ منَ الدنيا وما فيها",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده رواته ثقات","takhrij":"أخرجه ابن أبي شيبة في ((المصنف)) (10/427)، وابن عدي في ((الكامل في الضعفاء)) (3/335)","bab":"أدعية وأذكار › فضل الذكر","dorar":"2eYCu8Kp"},{"id":"س-00736","fp":"ea48f4e7b034","stateId":417,"easy":"إذا كنت ذاكراً بعد العشاء ← تغنم","cause":"إمَّا ذاكرًا","result":"فيغنَمُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"مجمع الزوائد 1/319","srcLabel":"ابن حبان","text":["ما رأَيْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم نائمًا قبلَ العشاءِ ولا لاغيًا بعدَها ",["إمَّا ذاكرًا",1]," ",["فيغنَمُ",2]," وإمَّا نائمَا فيسلَمُ قالت عائشةُ زوجُ النَّبيِّ صلَّى اللهُ عليه وسلَّم قالت السَّمرُ لثلاثةٍ لعروسٍ أو مسافرٍ أو متهجِّدٍ باللَّيلِ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أبو يعلى (4878،4879) بلفظه، والبيهقي (4878) مختصرا على أوله، وابن حبان (5547) بمعناه مختصرا على أوله.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"kvucaViE"},{"id":"س-00174","fp":"65df57913640","stateId":418,"easy":"إذا قلت «الحمد لله حمداً كثيراً طيباً مباركاً فيه...» ← يبتدرها عشرة أملاك يكتبونها","cause":"أحمَدُ اللهَ حَمدًا كثيرًا طَيِّبًا مُبارَكًا فيه كما يحِبُّ رَبُّنا ويرضى","result":"لقد ابتَدَرَ بها عَشَرةُ أملاكٍ كُلُّهم حَرَص على أن يَكْتُبوها، فما دَرَوا كيف يَكتُبونها حتَّى رَفَعوا إلى ذي العِزَّةِ","explicit":true,"star":true,"apply":{"k":"say","t":"«الحمد لله حمداً كثيراً طيباً مباركاً فيه...»"},"similar":["س-08216"],"otherNeedIds":[26],"ref":"الأحاديث المختارة 1887","srcLabel":"البخاري","text":["«كُنتُ مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في الحَلْقةِ إذ جاءَه رَجُلٌ، فسَلَّم على النَّبيِّ وعلى القَومِ، فقال: السَّلامُ عليكم، قال: فرَدَّ عليه السَّلامَ النَّبيُّ صلَّى اللهُ عليه وسلَّم: وعليكم السَّلامُ ورَحمةُ اللهِ وبَرَكاتُه، فلمَّا جلس الرَّجُلُ، قال: ",["أحمَدُ اللهَ حَمدًا كثيرًا طَيِّبًا مُبارَكًا فيه كما يحِبُّ رَبُّنا ويرضى",1],"، فقال له النَّبيُّ صلَّى اللهُ عليه وسلَّم: كيف قُلْتَ؟ فرَدَّ على النَّبيِّ صلَّى اللهُ عليه وسلَّم كما قال، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: والذي نَفْسي بيَدِه ",["لقد ابتَدَرَ بها عَشَرةُ أملاكٍ كُلُّهم حَرَص على أن يَكْتُبوها، فما دَرَوا كيف يَكتُبونها حتَّى رَفَعوا إلى ذي العِزَّةِ،",2]," فقال: اكتُبوها كما قال عَبْدَي»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"آداب السلام › كيفية رد السلام","dorar":"fou73YLk"},{"id":"س-08161","fp":"559baeb45968","stateId":418,"easy":"إذا قلت بعد الرفع «ربنا ولك الحمد حمداً كثيراً طيباً مباركاً فيه» ← يبتدرها بضعة وثلاثون ملكاً","cause":"اللَّهمَّ ربَّنا ولَكَ الحمدُ حمدًا كثيرًا طَيِّبًا مُباركًا فيهِ","result":"لقَد رأيتُ بِضعةً وثلاثينَ ملَكًا يبتدِرونَها أيُّهم يكتبُها أوَّلُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«ربنا ولك الحمد حمداً كثيراً طيباً مباركاً فيه»"},"otherNeedIds":[26],"ref":"صحيح أبي داود 770","srcLabel":"البخاري","text":["كنَّا يَومًا نصلِّي وراءَ رسولِ اللَّهِ -صلَّى اللَّهُ علَيهِ وسلَّمَ- فلمَّا رفعَ رسولُ اللَّهِ -صلَّى اللَّهُ علَيهِ وسلَّمَ- رأسَهُ منَ الرُّكوعِ قالَ سمِعَ اللَّهُ لمَن حمِدَهُ . قالَ رجلٌ وراءَ رسولِ اللَّهِ -صلَّى اللَّهُ علَيهِ وسلَّمَ- ",["اللَّهمَّ ربَّنا ولَكَ الحمدُ حمدًا كثيرًا طَيِّبًا مُباركًا فيهِ",1]," فلمَّا انصرفَ رسولُ اللَّهِ -صلَّى اللَّهُ علَيهِ وسلَّمَ- قالَ منِ المُتكلِّمُ بِها آنفًا . فقالَ الرَّجلُ أنا يا رسولَ اللَّهِ. فقالَ رسولُ اللَّهِ -صلَّى اللَّهُ علَيهِ وسلَّمَ- ",["لقَد رأيتُ بِضعةً وثلاثينَ ملَكًا يبتدِرونَها أيُّهم يكتبُها أوَّلُ",2]],"grade":"صحيح","narrator":"رفاعة بن رافع","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (770) واللفظ له، وأخرجه البخاري (799) باختلاف يسير","bab":"ملائكة › أعمال الملائكة","dorar":"NrUoQ4bA","merged":3,"otherRefs":["المحلى 4/165 (صحيح)","الترغيب والترهيب 2/363 (حسن)"]},{"id":"س-08216","fp":"e3bf3e2d39f2","stateId":418,"easy":"إذا قلت «الله أكبر، الحمد لله حمداً كثيراً طيباً مباركاً فيه» ← يبتدرها اثنا عشر ملكاً","cause":"اللَّهُ أَكْبرُ، الحمدُ للَّهِ حمدًا كثيرًا طيِّبًا مبارَكًا فيهِ","result":"لقد رَأيتُ اثني عشرَ ملَكًا يبتدِرونَها أيُّهم يرفعُها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«الله أكبر، الحمد لله حمداً كثيراً طيباً مباركاً فيه»"},"repOf":"س-00174","otherNeedIds":[26,51],"ref":"صحيح ابن خزيمة 1/529","text":["أنَّ رجلًا جاءَ وقد حَفزَهُ النَّفسُ، فقالَ: ",["اللَّهُ أَكْبرُ، الحمدُ للَّهِ حمدًا كثيرًا طيِّبًا مبارَكًا فيهِ",1],"، فلمَّا قَضى رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ صلاتَهُ قالَ: أيُّكمُ المتَكَلِّمُ بالكلِماتِ؟ فأرمَّ القومُ، فقالَ: أيُّكمُ المتَكَلِّمُ بالكلِماتِ فإنَّهُ لم يقُل بأسًا؟ فقالَ الرَّجلُ: أَنا يا رسولَ اللَّهِ، جِئتُ وقد حفزَني النَّفسُ فقلتُهُنَّ، فقالَ: ",["لقد رَأيتُ اثني عشرَ ملَكًا يبتدِرونَها أيُّهم يرفعُها",2]," وفي روايةٍ - إنَّ رجلًا دخلَ في الصَّلاةِ، فقالَ الحمدُ للَّهِ حمدًا كثيرًا طيِّبًا مبارَكًا فيهِ، [ وفيها ]: فقالَ رجلٌ منَ القومِ: أَنا قلتُها وما أردتُ بِها إلَّا الخيرَ، فقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ: لقدِ ابتَدرَها اثنا عَشرَ ملَكًا، فما دروا كيفَ يَكْتبونَها حتَّى سألوا ربَّهم، فقالَ: اكتُبوها كما قالَ عَبدي"],"grade":"صحيح","narrator":"أنس","muhaddith":"أخرجه في صحيحه","bab":"ملائكة › أعمال الملائكة","dorar":"vjsAYzFS","merged":7,"otherRefs":["تخريج المسند لشعيب 12960 (صحيح)","صحيح النسائي 931 (صحيح)","تخريج المسند لشعيب 12034 (صحيح)","صحيح النسائي 884 (صحيح)","تخريج الإحياء للعراقي 2/258 (حسن)","الأحاديث المختارة 8 / 189 (صحيح)"]},{"id":"س-08168","fp":"78a67bf9b4ae","stateId":418,"easy":"إذا حمدت الله ملء السماء ← تتلقاها الملائكة","cause":"الحمدُ لله ملْء السماءَ وسبّح ودعا","result":"لقد رأيتُ الملائكةَ تلْقَى به بعضهُم بعضا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[26],"ref":"تخريج المسند لشاكر 10/122","srcLabel":"الطبراني","text":["أن رجلا قال : ذاتَ يومٍ ودخلَ الصلاةَ ",["الحمدُ لله ملْء السماءَ وسبّح ودعا",1]," فقال رسولُ اللهِ صلى الله عليه وسلم من قائلهنّ فقال الرجل أنا فقال النبي صلى الله عليه وسلم : ",["لقد رأيتُ الملائكةَ تلْقَى به بعضهُم بعضا",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه البزار كما في ((كشف الأستار)) للهيثمي (524)، والطبراني كما في ((مجمع الزوائد)) للهيثمي (2/108) باختلاف يسير","bab":"ملائكة › أعمال الملائكة","dorar":"v2dyK6dZ","merged":3,"otherRefs":["إتحاف الخيرة المهرة 2/160 (حسن)","تخريج المسند لشاكر 12/18 (صحيح)"]},{"id":"س-08185","fp":"6862fa7e9f59","stateId":418,"easy":"إذا عطست في الصلاة فحمدت الله وبالغت ← يكتب كلماتك بضع وثلاثون ملكاً","cause":"وحَمِدَ اللهَ وبالغَ في الحَمدِ","result":"وكتبَ كَلِماتِه بِضعٌ وثلاثون مَلِكًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[26],"ref":"عارضة الأحوذي 5/384","srcLabel":"عارضة الأحوذي","text":["أنَّ رجُلًا عَطِسَ في الصَّلاةِ ",["وحَمِدَ اللهَ وبالغَ في الحَمدِ",1],"، ",["وكتبَ كَلِماتِه بِضعٌ وثلاثون مَلِكًا",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"ملائكة › أعمال الملائكة","dorar":"bJVHGzyl"},{"id":"س-02827","fp":"d573430d2912","stateId":418,"easy":"إذا عطست فحمدت الله ← تبتدر الملائكة كتابتها","cause":"عطسَ فحمِد اللهَ بعد العطاسِ","result":"رأى كذا وكذا من الملائكةِ كلُّهم يبتدرونها أيُّهم يكتبُها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[26],"ref":"فتاوى نور على الدرب لابن باز 9/283","srcLabel":"الترمذي","text":["أنه صلَّى اللهُ عليهِ وسلَّمَ سمع إنسانًا ",["عطسَ فحمِد اللهَ بعد العطاسِ",1]," فقال له بعد الصلاةِ: إنه ",["رأى كذا وكذا من الملائكةِ كلُّهم يبتدرونها أيُّهم يكتبُها",2],"."],"grade":"صحيح","narrator":"[رفاعة بن رافع الأنصاري]","muhaddith":"ثابت","takhrij":"أخرجه النسائي (931)، والترمذي (404)، والبيهقي (2649) جميعا بلفظه.","bab":"إيمان › الوعد","dorar":"iOo2qdBH"},{"id":"س-00964","fp":"28361ff53501","stateId":419,"easy":"إذا قلت «الله أكبر» ← تملأ ما بين السماء والأرض","cause":"واللهُ أكبَرُ","result":"تملأُ ما بين السَّماءِ والأرضِ","explicit":true,"star":true,"apply":{"k":"say","t":"«الله أكبر»"},"ref":"تخريج المسند لشعيب 22909","srcLabel":"مسلم","text":["الطُّهورُ شَطرُ الإيمانِ، فذَكَرَ مِثلَه [أي: حَديثَ: الطُّهورُ شَطرُ الإيمانِ، والحَمدُ لله تملأُ الميزانَ، وسُبحانَ الله والحَمدُ لله ",["واللهُ أكبَرُ",1]," ",["تملأُ ما بين السَّماءِ والأرضِ",2],"، والصَّلاةُ نورٌ، والصَّدَقةُ بُرهانٌ، والصَّبرُ ضِياءٌ، والقُرآنُ حُجَّةٌ لك أو عليك. كلُّ النَّاسِ يغدو؛ فبائِعٌ نَفسَه فمُعتِقُها أو مُوبِقُها]، إلَّا أنَّه قال: الصَّلاةُ بُرهانٌ، والصَّدَقةُ نورٌ."],"grade":"صحيح","narrator":"أبو مالك الأشعري","muhaddith":"صحيح","takhrij":"أخرجه مسلم (223)، والترمذي (3517)، والنسائي (2437)، وأحمد (22909) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"nu8DvRlD","merged":4,"otherRefs":["الجامع الصغير 4619 (صحيح)","تخريج المسند لشعيب 23099 (صحيح)","تخريج المسند لشعيب 23139 (صحيح)"]},{"id":"س-01045","fp":"be1824147cee","stateId":419,"easy":"إذا سبّحت مئة تسبيحة ← تُكتب لك ألف حسنة أو تُحط عنك ألف خطيئة","cause":"يُسبِّحُ مِئةَ تَسبيحةٍ","result":"تُكتَبُ له ألْفُ حَسَنةٍ، أو يُحَطُّ عنه ألْفُ خَطيئةٍ","explicit":true,"star":true,"similar":["س-00852"],"otherNeedIds":[11],"ref":"تخريج المسند لشعيب 1563","srcLabel":"مسلم","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال: أيَعجِزُ أحَدُكم أنْ يَكسِبَ كُلَّ يَومٍ ألْفَ حَسَنةٍ؟ فقال رَجُلٌ مِن جُلَسائِهِ: كيف يَكسِبُ أحَدُنا ألْفَ حَسَنةٍ؟ قال: ",["يُسبِّحُ مِئةَ تَسبيحةٍ",1],"؛ ",["تُكتَبُ له ألْفُ حَسَنةٍ، أو يُحَطُّ عنه ألْفُ خَطيئةٍ",2],". قال أبي: وقال ابنُ نُمَيرٍ أيضًا: أو يُحَطُّ. ويَعْلى أيضًا: أو يُحَطُّ."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2698)، والترمذي (3463)، والنسائي في ((السنن الكبرى)) (9980)، وأحمد (1563) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"elecm2yt","merged":3,"otherRefs":["تخريج صحيح ابن حبان 825 (صحيح)","صحيح الترمذي 3463 (صحيح)"]},{"id":"س-01133","fp":"355b5fd620a3","stateId":419,"easy":"إذا سبّحت أو حمدت ← فكل تسبيحة وتحميدة صدقة","cause":"بكلِّ تسبيحةٍ و تحميدةٍ","result":"صدقةٌ","explicit":true,"ref":"صحيح الأدب المفرد 167","srcLabel":"متفق عليه","text":["أليس قد جعل اللهُ لكم ما تصدَّقون ؟ إنَّ ",["بكلِّ تسبيحةٍ و تحميدةٍ",1]," ",["صدقةٌ",2]," وبُضعُ أحدِكم صدقةٌ قيل : في شهوتِه صدقةٌ ؟ قال : لو وَضع في الحرامِ ، أليس كان عليه وزرٌ ؟ فكذلك إن وضعَها في الحلالِ كان له أجرٌ"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (227) بلفظه، ومسلم (1006)، وأحمد (21473) كلاهما بلفظ مقارب.","bab":"أدعية وأذكار › فضل الذكر","dorar":"WtHRBfB5"},{"id":"س-01173","fp":"1c095b175e3b","stateId":419,"easy":"إذا دخلت السوق فقلت «لا إله إلا الله وحده لا شريك له...» ← يكتب الله لك ألف ألف حسنة ويرفعك ألف ألف درجة","cause":"من دخل السُّوقَ، فقال: لا إلهَ إلَّا اللهُ وَحْدَه لا شَريكَ له، له المُلْكُ وله الحَمْدُ يُحْيي ويُميتُ وهو حَيٌّ لا يموتُ، بيَدِه الخَيرُ، وهو على كُلِّ شَيءٍ قديرٌ","result":"كَتَبَ اللهُ له ألْفَ ألْفِ حَسَنةٍ، ورَفَع له ألْفَ ألْفِ دَرَجةٍ","explicit":true,"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ وَحْدَه لا شَريكَ له، له المُلْكُ وله الحَمْدُ يُحْيي ويُميتُ وهو حَيٌّ لا يموتُ، بيَدِه الخَيرُ، وهو على كُلِّ شَيءٍ قدير»"},"otherNeedIds":[47,67],"ref":"الأحاديث المختارة 187","srcLabel":"البخاري","text":["«",["من دخل السُّوقَ، فقال: لا إلهَ إلَّا اللهُ وَحْدَه لا شَريكَ له، له المُلْكُ وله الحَمْدُ يُحْيي ويُميتُ وهو حَيٌّ لا يموتُ، بيَدِه الخَيرُ، وهو على كُلِّ شَيءٍ قديرٌ) ",1],["كَتَبَ اللهُ له ألْفَ ألْفِ حَسَنةٍ، ورَفَع له ألْفَ ألْفِ دَرَجةٍ -",2],"أو قال: وبنى له بيتًا في الجنَّةِ- قال: فقَدِمْتُ خُراسانَ فأَتَيتُ قُتَيبةَ بنَ مُسلِمٍ فقُلْتُ: أتيتُك بهَدِيَّةٍ، فحَدَّثْتُه الحديثَ، قال: فكان قُتَيبةُ يركَبُ في مَوكِبِه حتَّى يأتيَ السُّوقَ فيَقولَها، ثُمَّ ينصَرِفُ»."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"أدعية وأذكار › فضل الذكر","dorar":"43hdhB2a"},{"id":"س-01211","fp":"0ea04dc3afbe","stateId":419,"easy":"إذا أنعم الله عليك في أهلك ومالك وولدك فقلت «الحمد لله رب العالمين» ← تكون قد أعطيت خيراً مما أخذت","cause":"ما أنعَمَ اللهُ على عَبدٍ نِعمةً في أهلٍ ومالٍ ووَلَدٍ فقال: الحَمْدُ للهِ رَبِّ العالَمينَ","result":"إلَّا كان قد أعطى خيرًا ممَّا أخذ","explicit":true,"apply":{"k":"say","t":"«الحمد لله رب العالمين»"},"ref":"الأحاديث المختارة 2196","srcLabel":"البخاري","text":["«",["ما أنعَمَ اللهُ على عَبدٍ نِعمةً في أهلٍ ومالٍ ووَلَدٍ فقال: الحَمْدُ للهِ رَبِّ العالَمينَ،",1]," ",["إلَّا كان قد أعطى خيرًا ممَّا أخذ»",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"YgeUsFk0"},{"id":"س-00852","fp":"2496d5174366","stateId":419,"easy":"إذا سبّحت الله مئة تسبيحة ← يكتب الله لك ألف حسنة ويحط عنك ألف خطيئة","cause":"يُسَبِّحُ اللهَ مائَةَ تسبيحَةٍ","result":"فَيَكْتُبُ اللهُ لَهُ بَها ألفَ حسَنَةٍ ، ويَحُطُّ عنه بِها ألْفَ خَطِيئَةٍ","explicit":true,"repOf":"س-01045","otherNeedIds":[11],"ref":"صحيح الجامع 2665","text":["أَيَعْجِزُ أحدُكم ، أن يكسِبَ كُلَّ يومٍ ألفَ حسَنَةٍ ؟ ",["يُسَبِّحُ اللهَ مائَةَ تسبيحَةٍ",1]," ؛ ",["فَيَكْتُبُ اللهُ لَهُ بَها ألفَ حسَنَةٍ ، ويَحُطُّ عنه بِها ألْفَ خَطِيئَةٍ",2]],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2698)، والترمذي (3463)، وأحمد (1563) واللفظ لهم.","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"VdfSW9xE"},{"id":"س-03456","fp":"f28347c37079","stateId":419,"easy":"إذا كبّرت وسبّحت وحمدت وهلّلت واستغفرت ← فكلها صدقة منك على نفسك","cause":"التَّكْبيرَ ، و سُبحانَ اللهِ ، و الحمدُ للهِ ، و لا إلهَ إلَّا اللهُ ،وَ أَسْتَغْفِرُ اللهَ ، و تَأْمُرُ بالمعروفِ ، و تَنْهَى عَنِ المنكرِ، و تَعْزِلُ الشَّوْكَةَ عن طَرِيقِ الناسِ و العظمَةَ و الحَجَرَ ، و تَهْدِي الأَعْمَى ، و تُسْمِعُ الأَصَمَّ و الأَبْكَمَ حتى يَفْقَهَ ، و تُدِلُّ المُسْتَدِلَّ على حاجَةٍ لهُ قد عَلِمْتَ مكانَها ، و تَسْعَى بِشِدَّةِ ساقَيْكَ إلى اللَّهْفَانِ المُسْتَغِيثِ ، و تَرْفَعُ بِشِدَّةِ ذِرَاعَيْكَ مع الضَّعِيفِ","result":"كلُّ ذلكَ من أبوابِ الصَّدَقَةِ مِنْكَ على نَفْسِكَ","explicit":true,"ref":"السلسلة الصحيحة 575","srcLabel":"مسلم","text":["على كلِّ نَفْسٍ كلَّ يَوْمٍ طَلَعَتْ فيهِ الشمسُ صدقةٌ مِنْهُ على نفسِهِ ، قُلْتُ يا رسولَ اللهِ من أين نَتَصَدَّقُ و ليس لَنا أَمْوَالٌ ؟ قال : لِأنَّ من أبوابِ الصَّدَقَةِ ",["التَّكْبيرَ ، و سُبحانَ اللهِ ، و الحمدُ للهِ ، و لا إلهَ إلَّا اللهُ ،وَ أَسْتَغْفِرُ اللهَ ، و تَأْمُرُ بالمعروفِ ، و تَنْهَى عَنِ المنكرِ، و تَعْزِلُ الشَّوْكَةَ عن طَرِيقِ الناسِ و العظمَةَ و الحَجَرَ ، و تَهْدِي الأَعْمَى ، و تُسْمِعُ الأَصَمَّ و الأَبْكَمَ حتى يَفْقَهَ ، و تُدِلُّ المُسْتَدِلَّ على حاجَةٍ لهُ قد عَلِمْتَ مكانَها ، و تَسْعَى بِشِدَّةِ ساقَيْكَ إلى اللَّهْفَانِ المُسْتَغِيثِ ، و تَرْفَعُ بِشِدَّةِ ذِرَاعَيْكَ مع الضَّعِيفِ",1]," ، ",["كلُّ ذلكَ من أبوابِ الصَّدَقَةِ مِنْكَ على نَفْسِكَ",2]," ، و لكَ في جِماعِكَ زَوْجَتَكَ أَجْرٌ ، قال أبو ذَرٍّ : كَيْفَ لي أَجْرٌ في شَهْوَتِي ؟ فقال : أرأيْتَ لَوْ كان لكَ ولَدٌ فَأَدْرَكَ ورَجَوْتَ خَيْرَهُ ، فماتَ أَكُنْتَ تَحْتَسِبُ ُ؟ قُلْتُ : نَعَمْ ، قال : فَأنتَ خَلَقْتَهُ ؟ قال : بَلْ اللهُ خلقَهُ ، قال : فَأنتَ هَدَيْتَهُ ؟ قال : بَلْ اللهُ هَدَاهُ ، قال : فَأنتَ تَرْزُقُهُ ؟ قال : بَلْ اللهُ كان يَرْزُقُهُ ، قال : كَذلكَ فَضَعْهُ في حَلالِه و جَنِّبْهُ حَرَامَهُ ، فإنْ شاءَ اللهُ أَحْياهُ ، وإنْ شاءَ أَماتَهُ ، و لكَ أَجْرٌ"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9027)، وأحمد (21484) باختلاف يسير","bab":"استغفار › فضل الاستغفار","dorar":"a8m5cxDp"},{"id":"ق-0732","fp":"797ae8dc2fb1","stateId":419,"easy":"الباقيات الصالحات ← خير ثواباً وخير أملاً","cause":"الباقيات الصالحات","result":"خير ثواباً وخير أملاً","explicit":true,"similar":["س-01250"],"otherNeedIds":[50],"ref":"سورة الكهف: 46","srcLabel":"القرآن الكريم","quran":{"s":18,"from":46,"to":46,"text":"الْمَالُ وَالْبَنُونَ زِينَةُ الْحَيَاةِ الدُّنْيَا وَالْبَاقِيَاتُ الصَّالِحَاتُ خَيْرٌ عِنْدَ رَبِّكَ ثَوَابًا وَخَيْرٌ أَمَلًا (46)","hl":[[52,129,1]]}},{"id":"ق-0860","fp":"96fcd5bd4704","stateId":419,"easy":"التسبيح في المساجد بالغدو والآصال وعدم الالتهاء بالتجارة عن ذكر الله والصلاة والزكاة ← الجزاء بأحسن العمل والزيادة من فضل الله والرزق بغير حساب","cause":"التسبيح في المساجد بالغدو والآصال وعدم الالتهاء بالتجارة عن ذكر الله والصلاة والزكاة","result":"الجزاء بأحسن العمل والزيادة من فضل الله والرزق بغير حساب","explicit":true,"apply":{"k":"time","t":"في السجود"},"otherNeedIds":[1],"ref":"سورة النور: 36–38","srcLabel":"القرآن الكريم","quran":{"s":24,"from":36,"to":38,"text":"فِي بُيُوتٍ أَذِنَ اللَّهُ أَنْ تُرْفَعَ وَيُذْكَرَ فِيهَا اسْمُهُ يُسَبِّحُ لَهُ فِيهَا بِالْغُدُوِّ وَالْآصَالِ (36) رِجَالٌ لَا تُلْهِيهِمْ تِجَارَةٌ وَلَا بَيْعٌ عَنْ ذِكْرِ اللَّهِ وَإِقَامِ الصَّلَاةِ وَإِيتَاءِ الزَّكَاةِ يَخَافُونَ يَوْمًا تَتَقَلَّبُ فِيهِ الْقُلُوبُ وَالْأَبْصَارُ (37) لِيَجْزِيَهُمُ اللَّهُ أَحْسَنَ مَا عَمِلُوا وَيَزِيدَهُمْ مِنْ فَضْلِهِ وَاللَّهُ يَرْزُقُ مَنْ يَشَاءُ بِغَيْرِ حِسَابٍ (38)","hl":[[0,418,1]]}},{"id":"س-01183","fp":"73b962aa20a1","stateId":419,"easy":"إذا قلت «سبحان الله» ← تُكتب لك عشرون حسنة وتُحط عنك عشرون سيئة","cause":"فمَنْ قال : سُبحانَ اللهِ","result":"كُتِبَ لهُ عِشْرُونَ حسنةً ، وحُطَّتْ عنهُ عِشْرُونَ سَيِّئَةً","explicit":true,"apply":{"k":"say","t":"«سبحان الله»"},"otherNeedIds":[11],"ref":"صحيح الترغيب 1554","srcLabel":"النسائي","text":["إِنَّ اللهَ اصْطَفَى مِنَ الكلامِ أربعًا : ( سُبحانَ اللهِ ، و الحمدُ للهِ ، ولا إلَهَ إلَّا اللهُ ، واللهُ أكبرُ ) . ",["فمَنْ قال : ( سُبحانَ اللهِ ) ؛ ",1],["كُتِبَ لهُ عِشْرُونَ حسنةً ، وحُطَّتْ عنهُ عِشْرُونَ سَيِّئَةً",2]," ، ومَنْ قال : ( اللهُ أكبرُ ) ؛ فمثلُ ذلكَ ، ومَنْ قال : ( لا إلَهَ إلَّا اللهُ ) ؛ فمثلُ ذلكَ ، ومَنْ قال : ( الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ ) من قِبَلِ نفسِهِ ؛ كُتِبَتْ لهُ ثلاثُونَ حسنةً ، وحُطَّتْ عنهُ ثلاثُونَ سَيِّئَةً ) ."],"grade":"صحيح","narrator":"أبو سعيد الخدري وأبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (8012)، والنسائي في ((الكبرى)) (10608)، وابن أبي شيبة (30446) باختلاف يسير.","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"LQdvE3Pr","merged":2,"otherRefs":["المستدرك على الصحيحين 1910 (صحيح)"]},{"id":"س-01186","fp":"472e3bf9f4d3","stateId":419,"easy":"إذا قلت «الحمد لله رب العالمين» من قلبك ← تُكتب لك ثلاثون حسنة وتُحط عنك ثلاثون سيئة","cause":"ومَنْ قال : ( الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ ) من قِبَلِ نفسِهِ","result":"كُتِبَتْ لهُ ثلاثُونَ حسنةً ، وحُطَّتْ عنهُ ثلاثُونَ سَيِّئَةً","explicit":true,"apply":{"k":"say","t":"«الحمد لله رب العالمين»"},"otherNeedIds":[11],"ref":"صحيح الترغيب 1554","srcLabel":"النسائي","text":["إِنَّ اللهَ اصْطَفَى مِنَ الكلامِ أربعًا : ( سُبحانَ اللهِ ، و الحمدُ للهِ ، ولا إلَهَ إلَّا اللهُ ، واللهُ أكبرُ ) . فمَنْ قال : ( سُبحانَ اللهِ ) ؛ كُتِبَ لهُ عِشْرُونَ حسنةً ، وحُطَّتْ عنهُ عِشْرُونَ سَيِّئَةً ، ومَنْ قال : ( اللهُ أكبرُ ) ؛ فمثلُ ذلكَ ، ومَنْ قال : ( لا إلَهَ إلَّا اللهُ ) ؛ فمثلُ ذلكَ ، ",["ومَنْ قال : ( الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ ) من قِبَلِ نفسِهِ",1]," ؛ ",["كُتِبَتْ لهُ ثلاثُونَ حسنةً ، وحُطَّتْ عنهُ ثلاثُونَ سَيِّئَةً",2]," ) ."],"grade":"صحيح","narrator":"أبو سعيد الخدري وأبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (8012)، والنسائي في ((الكبرى)) (10608)، وابن أبي شيبة (30446) باختلاف يسير.","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"LQdvE3Pr","merged":2,"otherRefs":["المستدرك على الصحيحين 1910 (صحيح)"]},{"id":"س-07436","fp":"6f4717a38729","stateId":419,"easy":"إذا قلت «سبحان الله والحمد لله ولا إله إلا الله والله أكبر» ← فهن الباقيات الصالحات","cause":"سُبحانَ اللهِ، والحَمدُ للهِ، ولا إلهَ إلَّا اللهُ، واللهُ أكبرُ","result":"هنَّ الباقياتُ الصَّالحاتُ","explicit":true,"apply":{"k":"say","t":"«سبحان الله والحمد لله ولا إله إلا الله والله أكبر»"},"otherNeedIds":[50],"ref":"تخريج المسند لشعيب 18353","srcLabel":"أحمد","text":["خَرَجَ علينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، ونحن في المسجدِ بعدَ صَلاةِ العِشاءِ، رَفَعَ بَصرَه إلى السَّماءِ، ثُمَّ خَفَضَ، حتى ظَنَنَّا أنَّه قد حَدَثَ في السَّماءِ شيءٌ، فقال: ألَا إنَّه سيَكونُ بعدي أُمَراءُ يَكذِبونَ ويَظلِمونَ، فمَن صَدَّقَهم بكَذِبِهم، ومالَأَهم على ظُلمِه؛ فليس منِّي، ولا أنا منه، ومَن لم يُصدِّقْهم بكَذِبِهم، ولم يُمالِئْهم على ظُلمِهم؛ فهو منِّي، وأنا منه، ألَا وإنَّ دَمَ المُسلمِ كفَّارتُه، ألَا وإنَّ ",["سُبحانَ اللهِ، والحَمدُ للهِ، ولا إلهَ إلَّا اللهُ، واللهُ أكبرُ",1]," ",["هنَّ الباقياتُ الصَّالحاتُ",2],"."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (18353)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"xakRCxUz","merged":2,"otherRefs":["الأمالي المطلقة 226 (صحيح)"]},{"id":"س-00233","fp":"62c4cc695c91","stateId":419,"easy":"إذا أنعم الله عليك فحمدته ← يكون حمدك أفضل من النعمة","cause":"ما أنعمَ اللهُ على عبدٍ نعمةً فحمِدَ اللهَ عليها","result":"إلَّا كان ذلِكَ الحمدُ أفضلَ منْ تلكَ النعمةِ","explicit":true,"ref":"صحيح الجامع 5562","srcLabel":"صحيح الجامع","text":[["ما أنعمَ اللهُ على عبدٍ نعمةً فحمِدَ اللهَ عليها ،",1]," ",["إلَّا كان ذلِكَ الحمدُ أفضلَ منْ تلكَ النعمةِ",2]],"grade":"صحيح","narrator":"أنس بن مالك وأبو أمامة","muhaddith":"صحيح","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"ih8mMGPk"},{"id":"س-00658","fp":"f345e84212fb","stateId":419,"easy":"إذا قلت «لا إله إلا الله وحده لا شريك له...» ← يكتب الله لك عشر حسنات ويمحو عنك عشر سيئات","cause":"مَنْ قال لا إلهَ إِلَّا اللهُ وحْدَهُ، لا شريكَ لهُ لهُ الملكُ ولهُ الحمدُ وهوَ على كلِّ شيءٍ قديرٌ بعدَ ما يصلِّي الغداةَ عشرَ مراتٍ","result":"كتب اللهُ عزَّ وجلَّ لهُ عشرَ حَسَناتٍ ، و مَحَى عنهُ عشرَ سيئاتٍ ، و رفعَ لهُ عشرَ درجاتٍ وكُنَّ لهُ بِعِدْلِ عِتْقِ رَقَبَتَيْنِ من ولَدِ إسماعيلَ","explicit":true,"apply":{"k":"say","t":"«لا إلهَ إِلَّا اللهُ وحْدَهُ، لا شريكَ لهُ لهُ الملكُ ولهُ الحمدُ وهوَ على كلِّ شيءٍ قديرٌ بعدَ ما يصلِّي الغداة»"},"similar":["س-00873","س-00971"],"otherNeedIds":[11,47],"ref":"السلسلة الصحيحة 113","srcLabel":"ابن عرفه","text":[["مَنْ قال لا إلهَ إِلَّا اللهُ وحْدَهُ، لا شريكَ لهُ لهُ الملكُ ولهُ الحمدُ وهوَ على كلِّ شيءٍ قديرٌ بعدَ ما يصلِّي الغداةَ عشرَ مراتٍ",1]," ",["كتب اللهُ عزَّ وجلَّ لهُ عشرَ حَسَناتٍ ، و مَحَى عنهُ عشرَ سيئاتٍ ، و رفعَ لهُ عشرَ درجاتٍ وكُنَّ لهُ بِعِدْلِ عِتْقِ رَقَبَتَيْنِ من ولَدِ إسماعيلَ",2]," ، فإنْ قالها حينَ يُمسي كان لهُ مِثْلَ ذلكَ ، وكُنَّ لهُ حِجابًا مِنَ الشيطانِ حتى يُصبحَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن عرفه في ((جزئه)) (18)، والخطيب في ((تاريخ بغداد)) (12/389)، وقاضي المارستان في ((المشيخة)) (476) باختلاف يسير","bab":"أدعية وأذكار › أذكار الصباح","dorar":"s3PZKdKr"},{"id":"س-00715","fp":"ad1f1da3936b","stateId":419,"easy":"إذا صليت وصمت وذكرت ← يضاعف على النفقة في سبيل الله بسبعمئة ضعف","cause":"إنَّ الصَّلاةَ والصِّيامَ والذِّكرَ","result":"يضاعَفُ على النَّفقةِ في سبيلِ اللَّهِ تعالى بِسبعِمائةِ ضِعفٍ","explicit":true,"ref":"الجامع الصغير 2048","srcLabel":"أبو داود","text":[["إنَّ الصَّلاةَ والصِّيامَ والذِّكرَ",1]," ",["يضاعَفُ على النَّفقةِ في سبيلِ اللَّهِ تعالى بِسبعِمائةِ ضِعفٍ",2]],"grade":"صحيح","narrator":"معاذ بن أنس","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2498) واللفظ له، وأحمد (15613) بنحوه دون ذكر \"الصلاة والصيام\"","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"HpC5nssE"},{"id":"س-00751","fp":"ef0b94bc7e0f","stateId":419,"easy":"إذا قلت «سبحان الله وبحمده» مئة مرة ← فهي ألف حسنة","cause":"يقولُ: سُبحانَ اللهِ وبحمدِهِ مائةَ مرَّةٍ","result":"فإنَّها ألفُ حسنةٍ","explicit":true,"apply":{"k":"say","t":"«سبحان الله وبحمده» · العدد: مئة مرة"},"similar":["س-01091"],"ref":"المستدرك على الصحيحين 1921","srcLabel":"أحمد","text":["لا يَدَعْ رَجلٌ مِنكم أنْ يَعملَ ألفَ حسنةٍ حتَّى يُصبِحَ ",["يقولُ: سُبحانَ اللهِ وبحمدِهِ مائةَ مرَّةٍ",1],"، ",["فإنَّها ألفُ حسنةٍ",2],"؛ فإنَّه لمْ يَعملْ إنْ شاءَ اللهُ مِثلَ ذلك في يومِهِ مِنَ الذُّنوبِ، ويكونُ ما عَمِلَ مِن خيرٍ سوى ذلك وافرًا."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (27478)، والطبراني في ((الشاميين)) (1471)، وأبو يعلى كما في ((المطالب العالية)) (3385) باختلاف يسير.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"L74rvVtl"},{"id":"س-00841","fp":"a11f94254df7","stateId":419,"easy":"إذا قلت «سبحان الله والحمد لله» ← تملآن ما بين السماء والأرض","cause":"و سبحان اللهِ و الحمدُ للهِ","result":"تملآنِ أو تملأ ما بين السماءِ و الأرضِ","explicit":true,"apply":{"k":"say","t":"«سبحان الله والحمد لله»"},"ref":"صحيح الترغيب 189","srcLabel":"الترمذي","text":["إسباغُ الوضوءِ شطرُ الإيمانِ و الحمدُ للهِ تملأ الميزانَ ، ",["و سبحان اللهِ و الحمدُ للهِ",1]," ",["تملآنِ أو تملأ ما بين السماءِ و الأرضِ",2]," ، و الصلاةُ نورٌ ، و الصدقةُ برهانٌ ، و الصبرُ ضياءٌ ، و القرآنُ حُجَّةٌ لك أو عليك ، كلُّ الناسِ يَغدو ، فبائعٌ نفسَه ، فمُعتِقُها أو موبِقُها"],"grade":"صحيح","narrator":"أبو مالك الأشعري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3517)، والنسائي (2437)، وابن ماجه (280) باختلاف يسير.","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"XLyeA0GQ"},{"id":"س-00873","fp":"665ae6997c24","stateId":419,"easy":"إذا قلت دبر صلاتك «لا إله إلا الله وحده...» ← يكتب الله لك عشر حسنات ويمحو عشر سيئات ويرفعك عشر درجات","cause":"من قالَهُنَّ في دُبُرِ صلاتِه إذا صلَّى لا إلهَ إلَّا اللَّهُ وحدَهُ لا شريكَ لهُ لهُ الملكُ ولهُ الحمدُ وهوَ على كلِّ شيءٍ قديرٌ","result":"كتبَ اللَّه لهُ عشرُ حسناتٍ ومحا عنه عشرَ سيئاتٍ ورفع له عشرَ درجاتٍ وكنَّ لهُ مثلَ عشرِ رقابٍ وكنَّ لهُ حرزًا منَ الشَّيطانِ حتَّى يُمسِيَ","explicit":true,"apply":{"k":"say","t":"«لا إلهَ إلَّا اللَّهُ وحدَهُ لا شريكَ لهُ لهُ الملكُ ولهُ الحمدُ وهوَ على كلِّ شيءٍ قدير»"},"repOf":"س-00658","otherNeedIds":[11,47,49,31],"ref":"نتائج الأفكار 3/18","text":["عشرٌ ",["من قالَهُنَّ في دُبُرِ صلاتِه إذا صلَّى لا إلهَ إلَّا اللَّهُ وحدَهُ لا شريكَ لهُ لهُ الملكُ ولهُ الحمدُ وهوَ على كلِّ شيءٍ قديرٌ",1]," ",["كتبَ اللَّه لهُ عشرُ حسناتٍ ومحا عنه عشرَ سيئاتٍ ورفع له عشرَ درجاتٍ وكنَّ لهُ مثلَ عشرِ رقابٍ وكنَّ لهُ حرزًا منَ الشَّيطانِ حتَّى يُمسِيَ",2]," وإنَّ قالَهنَّ حينَ يُمسي كُنَّ لهُ مثلُ ذلِكَ حتَّى يصبِحَ"],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"حسن من هذا الوجه وأصله في الصحيحين","takhrij":"أخرجه الترمذي (3553)، والنسائي في ((الكبرى)) (9861)، والطحاوي في ((مشكل الآثار)) (3906) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"cYoABOJ6"},{"id":"س-00971","fp":"94965b434002","stateId":419,"easy":"إذا قلت صباحاً «لا إله إلا الله وحده لا شريك له...» ← يكتب الله لك بكل واحدة عشر حسنات ويحط عشر سيئات","cause":"مَن قال حين يُصبِحُ: لا إلهَ إلَّا اللهُ، وَحْدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، يُحيي ويُميتُ، وهو على كُلِّ شَيءٍ قَديرٌ، عَشْرَ مرَّاتٍ","result":"كَتَبَ اللهُ له بكُلِّ واحدةٍ قالها عَشْرَ حَسَناتٍ، وحَطَّ اللهُ عنه بها عَشْرَ سيِّئاتٍ، ورَفَعَه اللهُ بها عَشْرَ دَرَجاتٍ، وكُنَّ له كعَشْرِ رقابٍ، وكُنَّ له مَسلَحةً مِن أوَّلِ النَّهارِ إلى آخِرِه","explicit":true,"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ، وَحْدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، يُحيي ويُميتُ، وهو على كُلِّ شَيءٍ قَديرٌ» · الوقت: في الصباح"},"repOf":"س-00658","otherNeedIds":[11,43],"ref":"تخريج المسند لشعيب 23568","text":["عن أبي أيُّوبَ الأنصاريِّ، عن النَّبيِّ صلَّى اللهُ عليه وسلَّمَ أنَّه قال: ",["مَن قال حين يُصبِحُ: لا إلهَ إلَّا اللهُ، وَحْدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، يُحيي ويُميتُ، وهو على كُلِّ شَيءٍ قَديرٌ، عَشْرَ مرَّاتٍ؛ ",1],["كَتَبَ اللهُ له بكُلِّ واحدةٍ قالها عَشْرَ حَسَناتٍ، وحَطَّ اللهُ عنه بها عَشْرَ سيِّئاتٍ، ورَفَعَه اللهُ بها عَشْرَ دَرَجاتٍ، وكُنَّ له كعَشْرِ رقابٍ، وكُنَّ له مَسلَحةً مِن أوَّلِ النَّهارِ إلى آخِرِه",2],"، ولم يَعمَلْ يَومَئذٍ عَمَلًا يَقهَرُهُنَّ، فإنْ قال حين يُمْسي، فمِثلُ ذلك."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3553) مختصراً بنحوه، والنسائي في ((السنن الكبرى)) (9852) بنحوه، وأحمد (23568) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"u4X1UaMe"},{"id":"س-01071","fp":"b1c998ffa5f1","stateId":419,"easy":"إذا كبّرت مرة ← تُكتب لك عشرون وتُمحى عنك عشرون","cause":"مَنْ كَبَّرَ واحدةً","result":"كُتِبَ له عشرونَ، ومُحِيتْ عنه عشرونَ","explicit":true,"otherNeedIds":[11],"ref":"المستدرك على الصحيحين 1914","srcLabel":"البيهقي","text":[["مَنْ كَبَّرَ واحدةً؛ ",1],["كُتِبَ له عشرونَ، ومُحِيتْ عنه عشرونَ، ",2],"ومَنْ سَبَّحَ واحدةً؛ كُتِبَتْ له عشرونَ ومُحِيتْ عنه عشرونَ، ومَنْ حَمِدَ واحدةً؛ كُتِبَتْ له ثلاثونَ، ومُحِيتْ عنه ثلاثونَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((الشعب)) (4084) واللفظ له.","bab":"أدعية وأذكار › فضل الذكر","dorar":"Lw5z6JLF"},{"id":"س-01072","fp":"25343679346b","stateId":419,"easy":"إذا سبّحت مرة ← تُكتب لك عشرون وتُمحى عنك عشرون","cause":"ومَنْ سَبَّحَ واحدةً","result":"كُتِبَتْ له عشرونَ ومُحِيتْ عنه عشرونَ","explicit":true,"otherNeedIds":[11],"ref":"المستدرك على الصحيحين 1914","srcLabel":"البيهقي","text":["مَنْ كَبَّرَ واحدةً؛ كُتِبَ له عشرونَ، ومُحِيتْ عنه عشرونَ، ",["ومَنْ سَبَّحَ واحدةً؛ ",1],["كُتِبَتْ له عشرونَ ومُحِيتْ عنه عشرونَ، ",2],"ومَنْ حَمِدَ واحدةً؛ كُتِبَتْ له ثلاثونَ، ومُحِيتْ عنه ثلاثونَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((الشعب)) (4084) واللفظ له.","bab":"أدعية وأذكار › فضل الذكر","dorar":"Lw5z6JLF"},{"id":"س-01073","fp":"a25cad431a97","stateId":419,"easy":"إذا حمدت مرة ← تُكتب لك ثلاثون وتُمحى عنك ثلاثون","cause":"ومَنْ حَمِدَ واحدةً","result":"كُتِبَتْ له ثلاثونَ، ومُحِيتْ عنه ثلاثونَ","explicit":true,"otherNeedIds":[11],"ref":"المستدرك على الصحيحين 1914","srcLabel":"البيهقي","text":["مَنْ كَبَّرَ واحدةً؛ كُتِبَ له عشرونَ، ومُحِيتْ عنه عشرونَ، ومَنْ سَبَّحَ واحدةً؛ كُتِبَتْ له عشرونَ ومُحِيتْ عنه عشرونَ، ",["ومَنْ حَمِدَ واحدةً؛ ",1],["كُتِبَتْ له ثلاثونَ، ومُحِيتْ عنه ثلاثونَ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((الشعب)) (4084) واللفظ له.","bab":"أدعية وأذكار › فضل الذكر","dorar":"Lw5z6JLF"},{"id":"س-01076","fp":"c16ed767ed85","stateId":419,"easy":"إذا قلت «الحمد لله» على نعمة ← أديت شكرها، وإن كررتها جدد الله لك ثوابها","cause":"ما أَنعَمَ اللهُ على عبدٍ مِن نِعمةٍ فقالَ: الحمدُ للهِ","result":"إلَّا وقد أَدَّى شُكرَها، فإنْ قالَها الثَّانيةَ؛ جدَّدَ اللهُ له ثَوابَها، فإنْ قالَها الثَّالثةَ؛ غَفَرَ اللهُ له ذُنوبَه","explicit":true,"apply":{"k":"say","t":"«الحمد لله»"},"otherNeedIds":[11],"ref":"المستدرك على الصحيحين 1895","srcLabel":"الحاكم","text":[["ما أَنعَمَ اللهُ على عبدٍ مِن نِعمةٍ فقالَ: الحمدُ للهِ؛",1]," ",["إلَّا وقد أَدَّى شُكرَها، فإنْ قالَها الثَّانيةَ؛ جدَّدَ اللهُ له ثَوابَها، فإنْ قالَها الثَّالثةَ؛ غَفَرَ اللهُ له ذُنوبَه",2],"."],"grade":"صحيح","narrator":"جابر","muhaddith":"صحيح الإسناد","bab":"أدعية وأذكار › فضل الذكر","dorar":"uYPiqNmR"},{"id":"س-01091","fp":"17ce98922c10","stateId":419,"easy":"إذا قلت «سبحان الله وبحمده» مئة مرة ← يكتب الله لك ألف حسنة وأربعاً وعشرين ألف حسنة","cause":"ومَن قالَ: سُبحانَ اللهِ وبحمدِهِ، مائةً","result":"كتَبَ اللهُ له ألفَ حسنةٍ وأربعًا وعشرينَ ألْفَ حَسنةٍ","explicit":true,"apply":{"k":"say","t":"«سبحان الله وبحمده» · العدد: مئة مرة"},"repOf":"س-00751","ref":"المستدرك على الصحيحين 7847","text":["مَن قالَ: لا إلَهَ إلَّا اللهُ، دخَلَ الجنَّةَ، أو وجبَتْ له الجَنَّةُ، ",["ومَن قالَ: سُبحانَ اللهِ وبحمدِهِ، مائةً، ",1],["كتَبَ اللهُ له ألفَ حسنةٍ وأربعًا وعشرينَ ألْفَ حَسنةٍ",2],"، قالُوا: يا رسولَ اللهِ، إذنْ لا يَهْلِكُ منَّا أحدٌ، قالَ: بلَى؛ إنَّ أحدَكُمْ لَيَجيءُ بالحَسناتِ لو وُضِعَتْ على جبَلٍ أثقَلَتْه، ثمَّ تَجيءُ النِّعَمُ فتَذْهَبُ بتلكَ، ثمَّ يَتطاوَلُ الرَّبُّ بعْدَ ذلكَ برَحْمتِه."],"grade":"صحيح","narrator":"أبو طلحة الأنصاري","muhaddith":"صحيح الإسناد","takhrij":"لم نقف عليه إلا عند الحاكم (7638).","bab":"أدعية وأذكار › فضل الذكر","dorar":"4u78kqR4"},{"id":"س-01122","fp":"b10eeb4474b3","stateId":419,"easy":"إذا كبّرت عند غروب الشمس على ساحل البحر رافعاً صوتك ← يعطيك الله من الأجر بعدد قطرات البحر","cause":"من كَبَّرَ تكبيرةً عند غُروبِ الشَّمسِ على ساحِلِ البَحرِ رافِعًا صَوتَه","result":"أعطاه اللهُ مِن الأجرِ بعَدَدِ كُلِّ قَطرةٍ في البَحَرِ حَسَناتٍ","explicit":true,"ref":"الضعفاء الكبير 2/22","srcLabel":"الحاكم","text":[["من كَبَّرَ تكبيرةً عند غُروبِ الشَّمسِ على ساحِلِ البَحرِ رافِعًا صَوتَه، ",1],["أعطاه اللهُ مِن الأجرِ بعَدَدِ كُلِّ قَطرةٍ في البَحَرِ حَسَناتٍ",2]],"grade":"صحيح","narrator":"جد إياس بن معاوية","muhaddith":"ليس في هذا الباب شيء صحيح يثبت","takhrij":"أخرجه الطبراني (19/ 29) (62)، والحاكم (6627)، وأبو نعيم في ((حلية الأولياء)) (3/ 125) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"HPasg6OV"},{"id":"س-01188","fp":"a45375f0c50c","stateId":419,"easy":"إذا قلت «الله أكبر والحمد لله وسبحان الله وبحمده» ← بواحدة عشر وبعشر مئة، ومن زاد زاده الله","cause":"قولوا اللهُ أكبرُ والحمدُ للهِ وسبحانَ اللهِ وبحمدِهِ","result":"بواحدةٍ عشرًا وبعشرٍ مائةً من زادَ زادهُ اللهُ","explicit":true,"apply":{"k":"say","t":"«الله أكبر والحمد لله وسبحان الله وبحمده»"},"ref":"تخريج المسند لشاكر 7/255","srcLabel":"أحمد","text":["عن أيوب بن سلمان رجل من أهل صنعاء قال: كنَّا بمكةَ فجلسنا إلى عطاءٍ الخراسانيِّ إلى جنبِ جدارِ المسجدِ فلم نسألْه ولم يُحدِّثْنا قال ثم جلسنا إلى ابنِ عمرَ مثلَ مجلسِكم هذا فلمْ نسألْه ولم يُحدِّثْنا قال فقال ما بالُكم لا تتكلَّمونَ ولا تذكرونَ اللهَ ",["قولوا اللهُ أكبرُ والحمدُ للهِ وسبحانَ اللهِ وبحمدِهِ",1]," ",["بواحدةٍ عشرًا وبعشرٍ مائةً من زادَ زادهُ اللهُ",2]," ومن سكتَ غُفِرَ لهُ ألا أُخبرُكم بخمسٍ سمعتهنَّ من رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ؟ قالوا : بَلَى قال من حالتْ شفاعتُهُ دونَ حَدٍّ من حدودِ اللهِ فهو مُضَادُّ اللهِ في أمرِهِ ومن أعانَ على خصومةٍ بغيرِ حقٍّ فهو مُستظلٌّ في سخطِ اللهِ حتى يتركَ ومن قَفَا مؤمنًا أو مؤمنةً حبسهُ اللهُ في رَدْغَةِ الخَبَالِ عصارةِ أهلِ النارِ ومن ماتَ وعليهِ دَيْنٌ أُخِذَ لصاحبِه من حسناتِه لا دينارَ ثَمَّ ولا درهمَ وركعتا الفجرِ، حافظوا عليهما فإنَّهما من الفضائلِ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (5544)","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"2sGjBDac"},{"id":"س-01196","fp":"47dbdf9f844a","stateId":419,"easy":"إذا قلت «سبحان الله والحمد لله ولا إله إلا الله والله أكبر» ← تُكتب لك بكل حرف عشر حسنات","cause":"مَن قال سُبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ واللهُ أكبَرُ","result":"كُتِبَتْ له بكلِّ حرفٍ عَشْرُ حسناتٍ","explicit":true,"apply":{"k":"say","t":"«سبحان الله والحمد لله ولا إله إلا الله والله أكبر»"},"ref":"مجمع الزوائد 10/94","srcLabel":"أبو داود","text":[["مَن قال سُبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ واللهُ أكبَرُ ",1],["كُتِبَتْ له بكلِّ حرفٍ عَشْرُ حسناتٍ ",2],"ومَن أعان على خصومةِ باطلٍ لم يزَلْ في سَخَطِ اللهِ حتَّى ينزِعَ ومَن حالت شفاعتُه دونَ حدٍّ مِن حدودِ اللهِ فقد ضادَّ اللهَ في أمرِه ومَن بهَت مؤمنًا أو مؤمنةً حبَسه اللهُ في رَدْغةِ الخَبالِ يومَ القيامةِ حتَّى يخرُجَ ممَّا قال وليس بخارجٍ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"رجاله رجال الصحيح غير محمد بن منصور الطوسي وهو ثقة","takhrij":"أخرجه أبو داود (3597)، وأحمد (5544) باختلاف يسير، وابن ماجه (2320) مختصراً","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"A31kGr3M"},{"id":"س-01250","fp":"f634129e0c00","stateId":419,"easy":"إذا أكثرت من الباقيات الصالحات (التكبير والتهليل والتسبيح والتحميد والحوقلة) ← تستكثر من الخير الباقي","cause":"التَّكْبيرُ، والتَّهْليلُ، والتَّسْبيحُ، والحَمْدُ للهِ، ولا حَوْلَ ولا قُوَّةَ إلَّا باللهِ","result":"اسْتَكْثِروا مِن الباقياتِ الصَّالِحاتِ","explicit":true,"repOf":"ق-0732","ref":"الأحكام الوسطى 4/ 316","text":["\"",["اسْتَكْثِروا مِن الباقياتِ الصَّالِحاتِ",2],"\"، قيلَ: وما هي يا رَسولَ اللهِ؟ قالَ: \"المِلَّةُ\"، قيلَ: وما هي يا رَسول اللهِ؟ قالَ: \"",["التَّكْبيرُ، والتَّهْليلُ، والتَّسْبيحُ، والحَمْدُ للهِ، ولا حَوْلَ ولا قُوَّةَ إلَّا باللهِ",1],"\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أحمد (11713)، وابن حبان (840)، والحاكم (1889) واللفظ لهم.","bab":"أدعية وأذكار › فضل لا حول ولا قوة إلا بالله","dorar":"azAzb74P"},{"id":"س-01206","fp":"812b51b43278","stateId":419,"easy":"إذا هلّلت الله مئة ← تملأ ما بين السماء والأرض ولا يُرفع لأحد عمل مثلك","cause":"وهلِّلي اللهَ مئةً","result":"تملأُ ما بينَ السماءِ والأرضِ ولا يُرفعُ يومئذٍ لأحدٍ عملٌ إلا أن يأتِيَ بمثلِ ما أتيت","explicit":true,"otherNeedIds":[47,49],"ref":"مجمع الزوائد 10/95","srcLabel":"النسائي","text":["مرَّ بي رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ذاتَ يومٍ فقلت يا رسولَ اللهِ قد كبُرْت وضعُفْتُ أو كما قالت فمُرْني بعملٍ أعملُ وأنا جالسةٌ قال سبِّحِي اللهَ مئةَ تسبيحةٍ فإنها تعدلُ لكِ مئةَ رقبةٍ تعتِقِيها من ولدِ إسماعيلَ واحمَدِي اللهَ مئةَ تحميدةٍ فإنها تعدلُ مئةَ فرسٍ مسرجةٍ ملجمةٍ تحملينَ عليها في سبيلِ اللهِ وكبِّرِي اللهَ مئةَ تكبيرةٍ فإنها تعدلُ لك مئةَ بدنةٍ مقلدةٍ متَقبَّلةٍ ",["وهلِّلي اللهَ مئةً",1]," قال ابنُ خلفٍ أحسبُه قال ",["تملأُ ما بينَ السماءِ والأرضِ ولا يُرفعُ يومئذٍ لأحدٍ عملٌ إلا أن يأتِيَ بمثلِ ما أتيت",2]," [ وفي روايةٍ ] قلت يا رسولَ اللهِ كبُرَت سنِّي ورقَّ عظمِي فدُلَّنِي على عملٍ يُدخِلُني الجنةَ فقال بخٍ بخٍ لقد سألت وقال خيرٌ لك من مئةِ بدنةٍ مقلدةٍ مجللةٍ تٌهديها إلى بيتِ اللهِ تعالَى وقولِي لا إلهَ إلا اللهُ مئةَ مرةٍ فهو خيرٌ لكِ مما أطبقت عليه السماءُ والأرضُ ولا يُرفعُ يومئذٍ لأحدٍ عملٌ أفضلُ مما رُفِع لك إلا مَن قال مثلَ ما قلتَ أو زادَ"],"grade":"حسن","narrator":"فاختة بنت أبي طالب أم هانئ","muhaddith":"أسانيدهم حسنة","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10680)، وابن ماجه (3810)، وأحمد (26911) باختلاف يسير. والرواية أخرجها الطبراني في ((المعجم الأوسط)) (6313)","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"PQazsOpK","merged":2,"otherRefs":["تخريج شرح السنة 1280 (حسن)"]},{"id":"س-00861","fp":"6c461f66cc75","stateId":419,"easy":"إذا قلت «سبحان الله وبحمده سبحان الله العظيم أستغفر الله وأتوب إليه» ← تُعلّق بالعرش لا يمحوها ذنب","cause":"سبحانَ اللهِ وبحمدِه سبحانَ اللهِ العظيمِ أستغفرُ اللهَ وأتوبُ إليه من قالها","result":"كُتِب له كما قالها ثمَّ عُلِّقتْ بالعرشِ لا يمحوها ذنبٌ عمِله صاحبُها حتَّى يلقَى اللهَ يومَ القيامةِ وهي مختومةٌ كما قالها","explicit":true,"apply":{"k":"say","t":"«سبحان الله وبحمده سبحان الله العظيم أستغفر الله وأتوب إليه»"},"ref":"الترغيب والترهيب 2/348","srcLabel":"مالك","text":[["سبحانَ اللهِ وبحمدِه سبحانَ اللهِ العظيمِ أستغفرُ اللهَ وأتوبُ إليه من قالها",1]," ",["كُتِب له كما قالها ثمَّ عُلِّقتْ بالعرشِ لا يمحوها ذنبٌ عمِله صاحبُها حتَّى يلقَى اللهَ يومَ القيامةِ وهي مختومةٌ كما قالها",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"رواته ثقات إلا يحيى بن عمر بن مالك النكري","takhrij":"أخرجه البزار (5298)، والطبراني (12/174) (12799)","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"x9kDidAj"},{"id":"س-00893","fp":"fc6bc96d2c6b","stateId":419,"easy":"إذا عقدت التسبيح بأناملك ← فهن مسؤولات مستنطقات يشهدن لك","cause":"وأن يعقِدنَ بالأناملِ","result":"فإنَّهنَّ مَسئولاتٌ مُستَنطَقاتٌ","explicit":true,"ref":"صحيح أبي داود 1501","srcLabel":"أبو داود","text":["أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ أمرَهنَّ أن يُراعينَ بالتَّكبيرِ والتَّقديسِ والتَّهليلِ ",["وأن يعقِدنَ بالأناملِ",1]," ",["فإنَّهنَّ مَسئولاتٌ مُستَنطَقاتٌ",2]],"grade":"حسن","narrator":"يسيرة بنت ياسر","muhaddith":"حسن","takhrij":"أخرجه أبو داود (1501)، والترمذي (3583)، وأبو بكر الشافعي في ((الغيلانيات)) (687)، والطبراني في ((الدعاء)) (1772)، والمخلص في ((المخلصيات)) (1003) واللفظ لهم.","bab":"أدعية وأذكار › فضل الذكر","dorar":"D9Vr5D4Z"},{"id":"س-01492","fp":"a549a55da6c1","stateId":419,"easy":"إذا كبّرت وسبّحت وحمدت ← فهو خير لك من خادم","cause":"قُلْتُ: وما هو؟ قالَ: تقولُ: اللهُ أَكبَرُ اللهُ أَكبَرُ اللهُ أَكبَرُ اللهُ أَكبَرُ، أَشهَدُ أنْ لا إلهَ إلَّا اللهُ أَشهَدُ أنْ لا إلهَ إلَّا اللهُ، أَشهَدُ أنَّ مُحمَّدًا رَسولُ اللهِ أَشهَدُ أنَّ مُحمَّدًا رَسولُ اللهِ، حَيَّ على الصَّلاةِ حَيَّ على الصَّلاةِ، حَيَّ على الفَلاحِ حَيَّ على الفَلاحِ، اللهُ أَكبَرُ","result":"أَلَا أَدُلُّك على خَيْرٍ مِن ذلك","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"الأحاديث المختارة 9 / 375","srcLabel":"متفق عليه","text":["«وقدْ كانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ حينَ قَدِمَها إنَّما يَجْتمِعُ النَّاسُ إليه للصَّلاةِ لحينِ مَواقيتِها بغَيْرِ دَعْوةٍ، فهَمَّ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ أن يَجعَلَ بوقًا كبوقِ اليَهودِ الَّذين يَدْعونَ به لصَلاتِهم، ثُمَّ كَرِهَه، ثُمَّ أَمَرَ بالنَّاقوسِ فنُحِتَ لِيُضرَبَ به للمُسْلِمينَ إلى الصَّلاةِ، فبَيْنَما هُمْ على ذلك أُرِيَ عَبْدُ اللهِ بنُ زَيدِ بنِ عَبْدِ رَبِّه -أخو بَلْحارِثِ- النِّداءَ، فأتى رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فقالَ له: يا رَسولَ اللهِ إنَّه طافَ بي هذه اللَّيْلةَ طائِفٌ، مَرَّ بي رَجُلٌ عليه ثَوْبانِ أخْضَرانِ يَحمِلُ ناقوسًا في يَدِه، فقُلْتُ: يا عَبْدَ اللهِ أَتَبيعُ هذا النَّاقوسَ؟ فقالَ: وما تَصنَعُ به؟ قُلْتُ: نَدْعو به إلى الصَّلاةِ، فقالَ: ",["أَلَا أَدُلُّك على خَيْرٍ مِن ذلك",2],"؟",[" قُلْتُ: وما هو؟ قالَ: تقولُ: اللهُ أَكبَرُ اللهُ أَكبَرُ اللهُ أَكبَرُ اللهُ أَكبَرُ، أَشهَدُ أنْ لا إلهَ إلَّا اللهُ أَشهَدُ أنْ لا إلهَ إلَّا اللهُ، أَشهَدُ أنَّ مُحمَّدًا رَسولُ اللهِ أَشهَدُ أنَّ مُحمَّدًا رَسولُ اللهِ، حَيَّ على الصَّلاةِ حَيَّ على الصَّلاةِ، حَيَّ على الفَلاحِ حَيَّ على الفَلاحِ، اللهُ أَكبَرُ",1]," اللهُ أَكبَرُ، لا إلهَ إلَّا اللهُ، قالَ: ثُمَّ اسْتَأخَرَ غَيْرَ كَبيرٍ، ثُمَّ قالَ مِثلَ ما قالَ، وقالَ: وجَعَلَها وِتْرًا إلَّا أنَّه قد قالَ: قد قامَتِ الصَّلاةُ قد قامَتِ الصَّلاةُ، اللهُ أَكبَرُ اللهُ أَكبَرُ، لا إلهَ إلَّا اللهُ، فلمَّا خَبَّرَ بها رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قالَ: إنَّها لَرُؤْيا حَقٍّ إن شاءَ اللهُ، فقُمْ معَ بِلالٍ فأَلْقِها عليه؛ فإنَّه أَنْدى صَوْتًا مِنك. قالَ: فلمَّا أَذَّنَ بها بِلالٌ سَمِعَ بها عُمَرُ بنُ الخَطَّابِ وهو في بَيْتِه، فخَرَجَ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وهو يَجُرُّ رِداءَه وهو يقولُ: يا نَبيَّ اللهِ، والَّذي بَعَثَك بالحَقِّ لقد رَأيْتُ مِثلَ ما رأى، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: فلِلَّهِ الحَمْدُ، فذاك أَثْبَتُ»."],"grade":"صحيح","narrator":"‌‌عبدالله بن زيد بن عبد ربه الأنصاري","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"أذان › بدء الأذان","dorar":"30UmzZtn"},{"id":"س-01131","fp":"c98119a092c9","stateId":419,"easy":"إذا قلت «الحمد لله كثيراً» ← يعظم أجرها حتى يعجز الملك عن كتابتها","cause":"الحمدُ للهِ كثيرًا","result":"فأعظمَها الملَكُ أن يكتُبَها ، فراجعَ فيها ربَّه عزَّ وجلَّ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«الحمد لله كثيراً»"},"ref":"صحيح الترغيب 1577","srcLabel":"الطبراني","text":["قال رجلٌ : ( ",["الحمدُ للهِ كثيرًا",1]," ) ، ",["فأعظمَها الملَكُ أن يكتُبَها ، فراجعَ فيها ربَّه عزَّ وجلَّ",2]," فقالَ : اكتُبْهَا كما قالَ عبدي [ كَثيرًا ] ."],"grade":"حسن","narrator":"سلمان الفارسي","muhaddith":"حسن لغيره","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (2061) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"t8NsqB8R"},{"id":"س-00701","fp":"fde6ff5f73fb","stateId":419,"easy":"إذا قلت «سبحان الله عدد ما خلق...» ← فهو أيسر وأكثر من ذكرك ساعات","cause":"فقال : سُبحانَ اللَّهِ عددَ ما خلقَ في السَّماءِ ، وسُبحانَ اللَّهِ عددَ ما خلقَ في الأرضِ ، وسُبحانَ اللَّهِ عددَ ما بينَ ذلِكَ ، وسبحانَ اللَّهِ عددَ ما هوَ خالقٌ ، واللَّهُ أَكْبرُ مثلَ ذلِكَ ، والحمدُ للَّهِ مثلَ ذلِكَ ، ولا إلهَ إلَّا اللَّهُ مثلَ ذلِكَ ولا حولَ ولا قوَّةَ إلَّا باللَّهِ مثلَ ذلِكَ","result":"ألا أخبرُكِ بما هوَ أيسَرُ علَيكِ من هذا أو أفضلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«سُبحانَ اللَّهِ عددَ ما خلقَ في السَّماءِ ، وسُبحانَ اللَّهِ عددَ ما خلقَ في الأرضِ ، وسُبحانَ اللَّهِ عددَ ما بينَ ذلِكَ ، وسبحانَ اللَّهِ عددَ ما هوَ خالقٌ ، واللَّهُ أَكْبرُ مثلَ ذلِكَ ، والحمدُ للَّهِ مثلَ ذلِكَ ، ولا إلهَ إلَّا اللَّهُ مثلَ ذلِكَ ولا حولَ ولا قوَّةَ إلَّا باللَّهِ مثلَ ذلِك»"},"similar":["س-01107"],"ref":"الفتوحات الربانية 1/244","srcLabel":"أبو داود","text":["أنَّهُ دخلَ معَ رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ على امرَأةٍ وبينَ يدَيها نوى ، أو حَصى تسبِّحُ بِهِ ، فقالَ : ",["ألا أخبرُكِ بما هوَ أيسَرُ علَيكِ من هذا أو أفضلُ ",2],"؟",[" فقال : سُبحانَ اللَّهِ عددَ ما خلقَ في السَّماءِ ، وسُبحانَ اللَّهِ عددَ ما خلقَ في الأرضِ ، وسُبحانَ اللَّهِ عددَ ما بينَ ذلِكَ ، وسبحانَ اللَّهِ عددَ ما هوَ خالقٌ ، واللَّهُ أَكْبرُ مثلَ ذلِكَ ، والحمدُ للَّهِ مثلَ ذلِكَ ، ولا إلهَ إلَّا اللَّهُ مثلَ ذلِكَ ولا حولَ ولا قوَّةَ إلَّا باللَّهِ مثلَ ذلِكَ",1]],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1500)، والترمذي (3568)، والدورقي في ((مسند سعد بن أبي وقاص)) (88)، والبزار (1201) واللفظ لهم.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"wERK4OB1"},{"id":"س-01107","fp":"a5c4d2428344","stateId":419,"easy":"إذا قلت «سبحان الله عدد ما خلق...» ← فهو أكثر وأفضل من ذكرك الليل مع النهار","cause":"قلتُ : بلى يا رسولَ اللهِ ! قال : تقولُ : سبحان اللهِ عدَدَ ما خلق ، سبحان اللهِ مِلْءَ ما خلَق ، سبحان اللهِ عدَدَ ما في الأرضِ [والسماءِ] سبحان اللهِ مِلْءَ ما في الأرضِ والسماءِ ، سبحان اللهِ عدَدَ ما أحصى كتابُه ، سبحان اللهِ","result":"ألا أُخبرُكَ بأكثرَ وأفضلَ من ذِكرِك باللَّيلِ والنَّهارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«سبحان اللهِ عدَدَ ما خلق ، سبحان اللهِ مِلْءَ ما خلَق ، سبحان اللهِ عدَدَ ما في الأرضِ [والسماءِ] سبحان اللهِ مِلْءَ ما في الأرضِ والسماءِ ، سبحان اللهِ عدَدَ ما أحصى كتابُه ، سبحان اللهِ مِلْءَ ما أحصى كتابُه ، سبحان اللهِ عددَ كلِّ شيءٍ ، سبحانَ اللهِ مِلْءَ كلِّ شيءٍ ، الحمدُ للهِ عددَ ما خلق ، والحمدُ لله مِلْءَ ما خلَق ، والحمدُ لله عدَدَ ما في الأرضِ والسماءِ ، والحمدُ لله مِلْءَ ما في الأرضِ والسماءِ ، والحمدُ للهِ عدَدَ ما أحصى كتابُه ، والحمدُ لله مِلْءَ ما أحصى كتابُه ، والحمدُ للهِ عدَدَ كلِّ شيءٍ ، والحمدُ للهِ مِلْءَ كلِّ شيءٍ»"},"repOf":"س-00701","ref":"صحيح الترغيب 1575","text":["بأيِّ شيءٍ تحرِّكُ شفَتَيكَ يا أبا أمامةَ ؟ . فقلتُ : أذكرُ اللهَ يا رسولَ اللهِ ! فقال : ",["ألا أُخبرُكَ بأكثرَ وأفضلَ من ذِكرِك باللَّيلِ والنَّهارِ ",2],"؟",[" . قلتُ : بلى يا رسولَ اللهِ ! قال : تقولُ : ( سبحان اللهِ عدَدَ ما خلق ، سبحان اللهِ مِلْءَ ما خلَق ، سبحان اللهِ عدَدَ ما في الأرضِ [والسماءِ] سبحان اللهِ مِلْءَ ما في الأرضِ والسماءِ ، سبحان اللهِ عدَدَ ما أحصى كتابُه ، سبحان اللهِ",1]," مِلْءَ ما أحصى كتابُه ، سبحان اللهِ عددَ كلِّ شيءٍ ، سبحانَ اللهِ مِلْءَ كلِّ شيءٍ ، الحمدُ للهِ عددَ ما خلق ، والحمدُ لله مِلْءَ ما خلَق ، والحمدُ لله عدَدَ ما في الأرضِ والسماءِ ، والحمدُ لله مِلْءَ ما في الأرضِ والسماءِ ، والحمدُ للهِ عدَدَ ما أحصى كتابُه ، والحمدُ لله مِلْءَ ما أحصى كتابُه ، والحمدُ للهِ عدَدَ كلِّ شيءٍ ، والحمدُ للهِ مِلْءَ كلِّ شيءٍ ) ."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه أحمد (22198)، والنسائي في ((السنن الكبرى)) (9994) مختصراً؛ وابن أبي الدنيا في كما في ((الترغيب والترهيب)) للمنذري (2/287) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"H7Nb5jHu"},{"id":"س-01184","fp":"35bdb1f52ee7","stateId":419,"easy":"إذا قلت «الله أكبر» ← تُكتب لك عشرون حسنة وتُحط عنك عشرون سيئة","cause":"ومَنْ قال : اللهُ أكبرُ","result":"فمثلُ ذلكَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«الله أكبر»"},"otherNeedIds":[11],"ref":"صحيح الترغيب 1554","srcLabel":"النسائي","text":["إِنَّ اللهَ اصْطَفَى مِنَ الكلامِ أربعًا : ( سُبحانَ اللهِ ، و الحمدُ للهِ ، ولا إلَهَ إلَّا اللهُ ، واللهُ أكبرُ ) . فمَنْ قال : ( سُبحانَ اللهِ ) ؛ كُتِبَ لهُ عِشْرُونَ حسنةً ، وحُطَّتْ عنهُ عِشْرُونَ سَيِّئَةً ، ",["ومَنْ قال : ( اللهُ أكبرُ",1]," ) ؛ ",["فمثلُ ذلكَ",2]," ، ومَنْ قال : ( لا إلَهَ إلَّا اللهُ ) ؛ فمثلُ ذلكَ ، ومَنْ قال : ( الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ ) من قِبَلِ نفسِهِ ؛ كُتِبَتْ لهُ ثلاثُونَ حسنةً ، وحُطَّتْ عنهُ ثلاثُونَ سَيِّئَةً ) ."],"grade":"صحيح","narrator":"أبو سعيد الخدري وأبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (8012)، والنسائي في ((الكبرى)) (10608)، وابن أبي شيبة (30446) باختلاف يسير.","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"LQdvE3Pr"},{"id":"س-01185","fp":"7ab327c5c6ed","stateId":419,"easy":"إذا قلت «لا إله إلا الله» ← تُكتب لك عشرون حسنة وتُحط عشرون سيئة","cause":"ومَنْ قال : لا إلَهَ إلَّا اللهُ","result":"فمثلُ ذلكَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«لا إله إلا الله»"},"otherNeedIds":[11],"ref":"صحيح الترغيب 1554","srcLabel":"النسائي","text":["إِنَّ اللهَ اصْطَفَى مِنَ الكلامِ أربعًا : ( سُبحانَ اللهِ ، و الحمدُ للهِ ، ولا إلَهَ إلَّا اللهُ ، واللهُ أكبرُ ) . فمَنْ قال : ( سُبحانَ اللهِ ) ؛ كُتِبَ لهُ عِشْرُونَ حسنةً ، وحُطَّتْ عنهُ عِشْرُونَ سَيِّئَةً ، ومَنْ قال : ( اللهُ أكبرُ ) ؛ فمثلُ ذلكَ ، ",["ومَنْ قال : ( لا إلَهَ إلَّا اللهُ",1]," ) ؛ ",["فمثلُ ذلكَ",2]," ، ومَنْ قال : ( الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ ) من قِبَلِ نفسِهِ ؛ كُتِبَتْ لهُ ثلاثُونَ حسنةً ، وحُطَّتْ عنهُ ثلاثُونَ سَيِّئَةً ) ."],"grade":"صحيح","narrator":"أبو سعيد الخدري وأبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (8012)، والنسائي في ((الكبرى)) (10608)، وابن أبي شيبة (30446) باختلاف يسير.","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"LQdvE3Pr"},{"id":"س-01195","fp":"9541a6e766e6","stateId":419,"easy":"إذا قلت «سبحان الله» ← فهو أعظم من جبل أحد","cause":"سُبحانَ اللهِ","result":"أعظَمُ مِن أُحُدٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"apply":{"k":"say","t":"«سبحان الله»"},"otherNeedIds":[49],"ref":"مجمع الزوائد 10/93","srcLabel":"النسائي","text":["أوَما يستطيعُ أحدُكم أن يعمَلَ كلَّ يومٍ مِثلَ أُحُدٍ عمَلًا قالوا يا رسولَ اللهِ ومَن يستطيعُ أن يعمَلَ في كلِّ يومٍ مِثلَ أُحُدٍ عمَلًا قال كلُّكم يستطيعُه قالوا يا رسولَ اللهِ ماذا قال ",["سُبحانَ اللهِ",1]," ",["أعظَمُ مِن أُحُدٍ",2]," والحمدُ للهِ أعظَمُ مِن أُحُدٍ ولا إلهَ إلَّا اللهُ أعظَمُ مِن أُحُدٍ واللهُ أكبَرُ أعظَمُ مِن أُحُدٍ"],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (18/ 174) (398)، واللفظ له، والنسائي في ((السنن الكبرى)) (10604)، والبزار كما في ((البحر الزخار)) (3609)، بلفظ مقارب.","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"X8NtvA7s"},{"id":"س-06965","fp":"08afe65e0ef1","stateId":419,"easy":"إذا قلت «يا رب لك الحمد كما ينبغي لجلال وجهك وعظيم سلطانك» ← يكتبها الله كما قلت ويجزيك","cause":"يا ربِّ ، لَكَ الحمدُ كما ينبَغي لجلالِ وجهِكَ وعظيمِ سلطانِكَ","result":"اكتُباها كما قالَ عبدي حتَّى يَلقاني فأجزيَهُ بِها","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"apply":{"k":"say","t":"«يا رب لك الحمد كما ينبغي لجلال وجهك وعظيم سلطانك»"},"ref":"عمدة التفسير 1/62","srcLabel":"ابن ماجه","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ حدَّثَهُم : أنَّ عَبدًا من عبادِ اللَّهِ قالَ : ",["يا ربِّ ، لَكَ الحمدُ كما ينبَغي لجلالِ وجهِكَ وعظيمِ سلطانِكَ",1]," ، فعضَلت بالملَكَينِ فلم يدريا كيفَ يَكْتبانِها ، فصعِدا إلى السَّماءِ فقالا يا ربِّنا ، إنَّ عبدكَ قد قالَ مقالةً لا نَدري كيفَ نَكْتبُها ، قالَ اللَّهُ -وَهوَ أعلمُ بما قالَ عبدُهُ - : ماذا قالَ عبدي ؟ قالا : يا ربِّ إنَّهُ قد قالَ : يا ربِّ لَكَ الحمدُ كما ينبغي لجلالِ وجهِكَ وعظيمِ سلطانِكَ . فقالَ اللَّهُ لَهُما : ",["اكتُباها كما قالَ عبدي حتَّى يَلقاني فأجزيَهُ بِها",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"إسناده جيد","takhrij":"أخرجه ابن ماجه (3801)، والطبراني (12/344) (13297)، والبيهقي في ((شعب الإيمان)) (4387) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"bXh4pjRi"},{"id":"س-01446","fp":"535be68b8fc2","stateId":419,"easy":"إذا كبّرت ← يملأ التكبير ما بين السماء والأرض","cause":"والتَّكبيرُ","result":"يَملَأُ ما بيْنَ السَّماءِ والأرضِ","explicit":true,"ref":"تخريج المسند لشعيب 23160","srcLabel":"الترمذي","text":["عن جُرَيٍّ النَّهْديِّ قال: لَقيتُ شَيخًا من بَني سُلَيمٍ بالكُناسةِ فحَدَّثَني، أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ عَدَّ خَمسًا في يَدِه، أو في يَدي، قال: التَّسبيحُ نِصفُ الميزانِ، والحَمدُ للهِ يَملَؤه، ",["والتَّكبيرُ",1]," ",["يَملَأُ ما بيْنَ السَّماءِ والأرضِ",2],"، والصَّومُ نِصفُ الصَّبرِ، والطُّهورُ نِصفُ الإيمانِ."],"grade":"صحيح","narrator":"رجل من الصحابة","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (3519)، وأحمد (23160) واللفظ له","bab":"وضوء › فضل الوضوء","dorar":"Hn5ERxvd"},{"id":"س-02413","fp":"1f49c9275746","stateId":419,"easy":"إذا قلت «سبحان الله وبحمده سبحانك اللهم وبحمدك أشهد أن لا إله إلا أنت...» ← تكون كالطابع يُختم به","cause":"مَنْ قالَ: سُبحانَ اللهِ وبحمدِهِ، سُبحانَكَ اللَّهُمَّ وبحمدِكَ، أَشهدُ أنْ لا إلَهَ إلَّا أنتَ، أَستغفرُكَ، وأَتوبُ إليكَ، فقالَها في مَجلِسِ ذِكرٍ","result":"كانت كالطَّابِعِ يُطبَعُ عليه","explicit":true,"star":true,"apply":{"k":"say","t":"«سبحان الله وبحمده سبحانك اللهم وبحمدك أشهد أن لا إله إلا أنت...»"},"ref":"المستدرك على الصحيحين 1994","srcLabel":"مسلم","text":[["مَنْ قالَ: سُبحانَ اللهِ وبحمدِهِ، سُبحانَكَ اللَّهُمَّ وبحمدِكَ، أَشهدُ أنْ لا إلَهَ إلَّا أنتَ، أَستغفرُكَ، وأَتوبُ إليكَ، فقالَها في مَجلِسِ ذِكرٍ؛ ",1],["كانت كالطَّابِعِ يُطبَعُ عليه، ",2],"ومَنْ قالَها في مَجلِسِ لَغوٍ؛ كانت كفَّارةً له."],"grade":"صحيح","narrator":"جبير بن مطعم","muhaddith":"صحيح على شرط مسلم","bab":"إسلام › فضل الشهادتين","dorar":"ThydINKD"},{"id":"س-00907","fp":"dd5c40241ba1","stateId":420,"easy":"إذا استغفرت للمؤمنين والمؤمنات ← يكتب الله لك بكل مؤمن ومؤمنة حسنة","cause":"مَنِ استغفَرَ للمؤمنينَ وللمؤمناتِ","result":"كتَبَ اللهُ لَهُ بِكُلِّ مؤمِنٍ ومؤمنةٍ حسنةً","explicit":true,"star":true,"ref":"صحيح الجامع 6026","srcLabel":"الطبراني","text":[["مَنِ استغفَرَ للمؤمنينَ وللمؤمناتِ ، ",1],["كتَبَ اللهُ لَهُ بِكُلِّ مؤمِنٍ ومؤمنةٍ حسنةً",2]],"grade":"حسن","narrator":"عبادة بن الصامت","muhaddith":"حسن","takhrij":"لم نقف عليه إلا عند الطبراني في ((مسند الشاميين)) (2155) بلفظه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"Y80Depsq"},{"id":"س-00046","fp":"a807b6060272","stateId":420,"easy":"إذا دعوت الله ← فالدعاء هو العبادة","cause":"الدُّعاءَ","result":"هو العِبادةُ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج المسند لشعيب 18386","srcLabel":"الترمذي","text":["إنَّ ",["الدُّعاءَ",1]," ",["هو العِبادةُ",2],"، ثُمَّ قَرَأَ: {وَقَالَ رَبُّكُمُ ادْعُونِي أَسْتَجِبْ لَكُمْ إِنَّ الَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِي سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ} [غافر: 60]. قال أبو عبدِ الرَّحمنِ: يُسَيعٌ الكِنْديُّ يُسَيعٌ بنُ مَعدانِ."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (3247)، والنسائي في ((السنن الكبرى)) (11464)، وابن ماجه (3828)، وأحمد (18386) واللفظ له","bab":"آداب الدعاء › استجابة الدعاء","dorar":"WllhZ8fw","merged":2,"otherRefs":["سنن الترمذي 2969 (صحيح)"]},{"id":"س-01713","fp":"0dc26da4fc29","stateId":421,"easy":"إذا أكثرت من الصلاة على النبي ﷺ (يوم الجمعة) ← فصلاتك معروضة عليه","cause":"فأكثِروا عَلَيَّ منَ الصَّلاةِ","result":"فإنَّ صَلاتَكُم مَعروضةٌ عَلَيَّ","explicit":true,"star":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"otherNeedIds":[23],"ref":"المستدرك على الصحيحين 1044","srcLabel":"البخاري","text":["قالَ لي رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّ من أفضَلِ أيَّامِكُمُ يَومَ الجُمُعةِ؛ فيه خُلِق آدَمُ، وفيه قُبِضَ، وفيه النَّفخةُ، وفيه الصَّعقةُ؛ ",["فأكثِروا عَلَيَّ منَ الصَّلاةِ",1]," فيه؛ ",["فإنَّ صَلاتَكُم مَعروضةٌ عَلَيَّ",2],". قالوا: وكَيفَ تُعرَضُ صَلاتُنا عليكَ وقد أَرَمْتَ؟ قالَ: إنَّ الله عزَّ وجلَّ قد حَرَّم على الأرضِ أن تَأكُلَ أجسادَ الأنبِياءِ."],"grade":"صحيح","narrator":"أوس بن أوس الثقفي","muhaddith":"صحيح على شرط البخاري","bab":"أنبياء › خصائص وفضائل","dorar":"mmKxm6LW","merged":2,"otherRefs":["صحيح ابن ماجه 896 (صحيح)"]},{"id":"س-04577","fp":"dee1cb86d855","stateId":421,"easy":"إذا صليت وسلّمت على النبي ﷺ ← تبلغه صلاتك حيث كنت","cause":"و صلُّوا عليَّ وسَلِّمُوا","result":"فإنَّ صَلاتَكُمْ تَبْلُغُنِي حيثُمَّا كنتُمْ","explicit":true,"star":true,"similar":["س-02209"],"ref":"صحيح الجامع 3785","srcLabel":"الطبراني","text":["صلُّوا في بُيُوتِكُمْ و لا تَتَّخِذُوها قُبُورًا ، و لا تَتَّخِذُوا بَيْتي عِيدًا ، ",["و صلُّوا عليَّ وسَلِّمُوا ، ",1],["فإنَّ صَلاتَكُمْ تَبْلُغُنِي حيثُمَّا كنتُمْ",2]],"grade":"صحيح","narrator":"الحسن بن علي بن أبي طالب","muhaddith":"صحيح","takhrij":"أخرجه عبدالرزاق في ((المصنف)) (4839)، وأبو يعلى (6761) باختلاف يسير، والطبراني (3/82) (2729) مختصراً بنحوه","bab":"حج › زيارة قبر النبي صلى الله عليه وسلم","dorar":"h5aSJGFM","merged":4,"otherRefs":["تخريج سير أعلام النبلاء 4/483 (حسن)","تخريج المسند لشعيب 8804 (حسن)","غاية المرام 125 (صحيح)"]},{"id":"س-00976","fp":"c4c5b33bf596","stateId":421,"easy":"إذا صليت على النبي ﷺ مرة ← يكتب الله لك بها عشر حسنات","cause":"مَن صلَّى عَلَيَّ مَرَّةً واحدةً","result":"كتَبَ اللهُ عزَّ وجلَّ له بِـها عَشْرَ حَسَناتٍ","explicit":true,"similar":["س-07379","س-03307","س-02340","س-03411"],"otherNeedIds":[11],"ref":"تخريج المسند لشعيب 7561","srcLabel":"أحمد","text":[["مَن صلَّى عَلَيَّ مَرَّةً واحدةً، ",1],["كتَبَ اللهُ عزَّ وجلَّ له بِـها عَشْرَ حَسَناتٍ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (7562)، وابن حبان (913) واللفظ لهما، وابن عساكر في ((تاريخ دمشق)) (56/81) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"Xg4EEVG5","merged":3,"otherRefs":["فضل الصلاة 11 (صحيح)","القول البديع 152 (صحيح)"]},{"id":"س-07379","fp":"89760a75e41c","stateId":421,"easy":"إذا صليت على النبي ﷺ ← تُكتب لك عشر حسنات وتُكفّر عشر سيئات وتُرفع عشر درجات","cause":"مَن صَلَّى عليكَ صَلاةً","result":"كُتِبَ له بها عَشرُ حَسَناتٍ، وكُفِّر عنه بها عَشرُ سَيِّئاتٍ، ورُفِع له بها عَشرُ دَرَجاتٍ، ورَدَّ اللهُ عليه مِثلَ قَولِه، وعُرِضت عليه يَومَ القيامةِ","explicit":true,"repOf":"س-00976","otherNeedIds":[11,47],"ref":"أطراف الغرائب 2/238","text":["حَديثُ: أتَيتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم وهو يَتَهَلَّلُ وجهُه [مُستَبشِرًا، فقُلتُ: أي رَسولَ اللهِ، إنَّك لعلى حالٍ ما رَأيتُك على مِثلِها، قال: وما يَمنَعُني؟ أتاني جِبريلُ عليه السَّلامُ آنِفًا فقال: بَشِّرْ أُمَّتَك أنَّه ",["مَن صَلَّى عليكَ صَلاةً ",1],["كُتِبَ له بها عَشرُ حَسَناتٍ، وكُفِّر عنه بها عَشرُ سَيِّئاتٍ، ورُفِع له بها عَشرُ دَرَجاتٍ، ورَدَّ اللهُ عليه مِثلَ قَولِه، وعُرِضت عليه يَومَ القيامةِ",2],"]"],"grade":"صحيح","narrator":"أبو طلحة","muhaddith":"غريبٌ من حديث الزهري، تَفَرَّدَ بهِ زيد بن رفيع عنه، وتَفَرَّدَ بهِ حماد بن عَمْرو النصيبي عنه، قال في موضع آخر، تَفَرَّدَ بهِ سُلَيمان بن بلال، عَن عَبيد الله بن عُمَر عن ثابت عن أَنس.","bab":"فضائل النبي وصفته ودلائل النبوة › أحوال النبي","dorar":"KUuNDKfw","merged":2,"otherRefs":["الترغيب والترهيب 2/400 (صحيح)"]},{"id":"س-03307","fp":"3ebcbe0828ca","stateId":421,"easy":"إذا صليت على النبي ﷺ ← يكتب الله لك عشر حسنات ويمحو عشر سيئات","cause":"من صلَّى عليَّ صلاةً","result":"كتبَ لهُ اللَّهُ عَشرَ حسناتٍ ومَحا عنهُ عشرُ سيِّئاتٍ وردَّ عليهِ مثلَ ما قالَ","explicit":true,"repOf":"س-00976","otherNeedIds":[11],"ref":"حلية الأولياء 8/137","text":["دفَعنا إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ وهوَ أطيَبُ شيءٍ نفسًا فقُلنا لَهُ فقال وما يَمنعُني وإنَّما خرَجَ جبريلُ عليهِ السَّلامُ آنفًا فأخبرَني أنَّهُ ",["من صلَّى عليَّ صلاةً ",1],["كتبَ لهُ اللَّهُ عَشرَ حسناتٍ ومَحا عنهُ عشرُ سيِّئاتٍ وردَّ عليهِ مثلَ ما قالَ",2]],"grade":"صحيح","narrator":"أبو طلحة الأنصاري زيد بن سهل","muhaddith":"ثابت مشهور من حديث أنس وروي من غير وجه","takhrij":"أخرجه الطبراني في ((الأوسط)) (6414)، والشاشي في ((مسنده)) (1054) باختلاف يسير، والنسائي (1283) بنحوه.","bab":"استغفار › أسباب المغفرة","dorar":"dn3k1ejR"},{"id":"س-00690","fp":"762ec07d6099","stateId":421,"easy":"إذا قلت «جزى الله محمداً عنا ما هو أهله» ← أتعبت سبعين كاتباً ألف صباح","cause":"مَن قال: جزى اللهُ محمَّدًا عنا ما هو أهْلُه","result":"أتعَبَ سبعينَ كاتبًا ألفَ صباحٍ","explicit":true,"apply":{"k":"say","t":"«جزى الله محمداً عنا ما هو أهله»"},"ref":"أطراف الغرائب 1/463","srcLabel":"أطراف الغرائب","text":["حديثُ: ",["مَن قال: جزى اللهُ محمَّدًا عنا ما هو أهْلُه",1]," [",["أتعَبَ سبعينَ كاتبًا ألفَ صباحٍ",2],"]"],"grade":"حسن","narrator":"عبد الله بن عباس","muhaddith":"غريبٌ من حديثه عن عكرمة، تَفَرَّدَ بهِ هاني بن المتوكل عن معاوية بن صالح، عَنه.","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"BBRRQYiM"},{"id":"س-00936","fp":"830b25010a54","stateId":421,"easy":"إذا صليت على النبي ﷺ ← يكتب الله لك قيراطاً مثل أحد","cause":"من صلَّى عليَّ صلاةً","result":"كتبَ اللَّه لَه قيراطًا والقيراطُ مثلُ أُحُدٍ","explicit":true,"ref":"الجامع الصغير 8794","srcLabel":"عبد الرزاق","text":[["من صلَّى عليَّ صلاةً ",1],["كتبَ اللَّه لَه قيراطًا والقيراطُ مثلُ أُحُدٍ",2]],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"حسن","takhrij":"أخرجه عبد الرزاق (153) في أثناء حديث طويل.","bab":"أدعية وأذكار › فضل الذكر","dorar":"bs2kD2EV"},{"id":"س-01715","fp":"2744bd766ecf","stateId":421,"easy":"إذا سلّمت على النبي ﷺ ← يرد عليك السلام","cause":"يُسلِّمُ علَيَّ","result":"حتَّى أَرُدَّ عليه السَّلامَ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"أسنى المطالب 3/243","srcLabel":"أسنى المطالب","text":["ما مِن أحدٍ ",["يُسلِّمُ علَيَّ",1]," إلَّا رَدَّ اللهُ علَيَّ رُوحي ",["حتَّى أَرُدَّ عليه السَّلامَ",2],"."],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"أنبياء › خصائص وفضائل","dorar":"sYHICFUs"},{"id":"س-02209","fp":"34b8b7d7e900","stateId":421,"easy":"إذا صليت على النبي ﷺ ← تبلغه صلاتك وسلامك حيث كنت","cause":"صلُّوا عليَّ","result":"فإنَّ صلواتِكم وسلامَكم يبلغُني حيثُ ما كنتم","explicit":true,"repOf":"س-04577","ref":"النوافح العطرة 180","text":[["صلُّوا عليَّ ",1],["فإنَّ صلواتِكم وسلامَكم يبلغُني حيثُ ما كنتم",2]],"grade":"حسن","narrator":"الحسن بن علي بن أبي طالب","muhaddith":"حسن","takhrij":"أخرجه عبدالرزاق في ((المصنف)) (4839)، وأبو يعلى (6761) مطولاً بنحوه، والطبراني (3/82) (2729) بنحوه","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"vxGm4l10"},{"id":"س-02340","fp":"782301c2a595","stateId":421,"easy":"إذا صليت على النبي ﷺ ← تبلغه صلاتك ويصلي عليك ويُكتب لك عشر حسنات","cause":"مَن صلَّى عليَّ بلَغتني صلاتُهُ ، وصلَّيتُ علَيهِ","result":"وَكُتبَ لَهُ سِوى ذلِكَ عَشرُ حسَناتٍ","explicit":true,"repOf":"س-00976","ref":"تحفة الذاكرين 51","text":[["مَن صلَّى عليَّ بلَغتني صلاتُهُ ، وصلَّيتُ علَيهِ ، ",1],["وَكُتبَ لَهُ سِوى ذلِكَ عَشرُ حسَناتٍ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (1642)","bab":"إحسان › الحسنات والسيئات","dorar":"Yb4LzzbQ"},{"id":"س-03411","fp":"a182bad742a8","stateId":421,"easy":"إذا ذكرت النبي ﷺ فصليت عليه ← يكتب الله لك عشر حسنات ويمحو عشر سيئات ويرفعك عشر درجات","cause":"ما من عبدٍ مؤمنٍ يذكرُني فيصلِّي عليَّ","result":"إلَّا كتب اللهُ له عشرَ حسناتٍ ، ويمحو عنه عشرَ سيِّئاتٍ ، ورفع له عشرَ درجاتٍ","explicit":true,"repOf":"س-00976","otherNeedIds":[11,47],"ref":"القول البديع 155","text":[["ما من عبدٍ مؤمنٍ يذكرُني فيصلِّي عليَّ",1]," ",["إلَّا كتب اللهُ له عشرَ حسناتٍ ، ويمحو عنه عشرَ سيِّئاتٍ ، ورفع له عشرَ درجاتٍ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن","takhrij":"أخرجه النسائي (1297) باختلاف يسير، وأحمد (11998) مختصراً","bab":"استغفار › أسباب المغفرة","dorar":"790KoWaY"},{"id":"س-08165","fp":"b041d877f227","stateId":421,"easy":"إذا أكثرت الصلاة على النبي ﷺ ← يبلّغه الملك صلاتك","cause":"أكثِروا الصَّلاةَ عليَّ","result":"فإنَّ اللهَ وكَّلَ بي مَلَكًا عندَ قبري ، فإذا صلَّى عليَّ رجلٌ مِن أُمَّتي","explicit":true,"ref":"صحيح الجامع 1207","srcLabel":"الديلمي","text":[["أكثِروا الصَّلاةَ عليَّ ، ",1],["فإنَّ اللهَ وكَّلَ بي مَلَكًا عندَ قبري ، فإذا صلَّى عليَّ رجلٌ مِن أُمَّتي",2]," قال لي ذلكَ الملَكُ : يا محمَّدُ إنَّ فلانَ ابنَ فلانٍ صلَّى عليكَ السَّاعةَ"],"grade":"حسن","narrator":"أبو بكر الصديق","muhaddith":"حسن","takhrij":"أخرجه الديلمي في ((مسند الفردوس)) كما عند السيوطي في ((اللآلىء المصنوعة في الأحاديث الموضوعة)) (1/ 260).","bab":"ملائكة › أعمال الملائكة","dorar":"RoWipANK"},{"id":"س-02752","fp":"f22fae7963a2","stateId":421,"easy":"إذا أكثرت الصلاة على النبي ﷺ يوم الجمعة ← تُعرض عليه صلاتك","cause":"أكثروا من الصلاةِ عليَّ يومَ الجمعةِ","result":"فإنه مشهودٌ تشهدُه الملائكةُ وإنَّ أحدًا لن يصليَ عليَّ إلا عُرضت عليَّ صلاتُه حتى يفرغَ منها","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"ref":"المتجر الرابح 246","srcLabel":"ابن ماجه","text":[["أكثروا من الصلاةِ عليَّ يومَ الجمعةِ ",1],["فإنه مشهودٌ تشهدُه الملائكةُ وإنَّ أحدًا لن يصليَ عليَّ إلا عُرضت عليَّ صلاتُه حتى يفرغَ منها",2]," قال: قلتُ: وبعد الموتِ؟ قال: إنَّ اللهَ حرَّم على الأرضِ أنْ تأكلَ أجسادَ الأنبياءِ."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (1637) مع اختلافٍ يسير، والطبري في ((تفسيره)) (24/ 337) ببعضه، وابن أبي حاتم في ((تفسيره)) (6/ 2084) ببعضه.","bab":"إيمان › الملائكة","dorar":"PbTzA0aa"},{"id":"س-00173","fp":"ce6325684d64","stateId":421,"easy":"إذا سلّمت على النبي ﷺ ← يرد الله عليه روحه حتى يرد عليك","cause":"يُسلِّمُ عليَّ","result":"إلا ردَّ اللهُ رُوحي حتى أردَّ عليه السَّلامَ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"رحلة الحج 322","srcLabel":"أبو داود","text":["ما من أحدٍ ",["يُسلِّمُ عليَّ",1]," ",["إلا ردَّ اللهُ رُوحي حتى أردَّ عليه السَّلامَ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2041)، وأحمد (10815) باختلاف يسير","bab":"آداب السلام › كيفية رد السلام","dorar":"kiTzxfZh"},{"id":"س-01068","fp":"8fe899983f53","stateId":421,"easy":"إذا صليت على النبي ﷺ عند قبره ← يسمعه","cause":"مَن صَلَّى عَلَيَّ عِندَ قَبْري","result":"سَمِعتُه","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[26],"ref":"الحرز الثمين 3/1561","srcLabel":"الحرز الثمين","text":[["مَن صَلَّى عَلَيَّ عِندَ قَبْري",1]," ",["سَمِعتُه",2],"، ومَن صَلَّى عَلَيَّ نائيًا بُلِّغْتُه."],"grade":"حسن","muhaddith":"[إسناده جيد]","bab":"أدعية وأذكار › فضل الذكر","dorar":"hmT425QU"},{"id":"س-01069","fp":"fd243a15add0","stateId":421,"easy":"إذا صليت على النبي ﷺ بعيداً ← يُبلَّغه","cause":"مَن صَلَّى عَلَيَّ نائيًا","result":"بُلِّغْتُه","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[26],"ref":"الحرز الثمين 3/1561","srcLabel":"الحرز الثمين","text":["مَن صَلَّى عَلَيَّ عِندَ قَبْري سَمِعتُه، و",["مَن صَلَّى عَلَيَّ نائيًا",1]," ",["بُلِّغْتُه",2],"."],"grade":"حسن","muhaddith":"[إسناده جيد]","bab":"أدعية وأذكار › فضل الذكر","dorar":"hmT425QU"},{"id":"س-00109","fp":"ea498fed082c","stateId":421,"easy":"إذا سلّمت على النبي ﷺ ← يبلغه تسليمك أينما كنت","cause":"سَلِّمُوا عَلَيَّ","result":"فإنَّ تَسْلِيمَكم يَبْلُغُنِي أَيْنَما كنتم","explicit":true,"ref":"كشف الخفاء 2/33","srcLabel":"إسماعيل","text":[["سَلِّمُوا عَلَيَّ",1]," ",["فإنَّ تَسْلِيمَكم يَبْلُغُنِي أَيْنَما كنتم",2]],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"حسن","takhrij":"أخرجه إسماعيل القاضي في ((فضل الصلاة على النبي)) (20)، واللفظ له، وأبو يعلى (469)، باختلاف يسير.","bab":"آداب الدعاء › الصلاة على النبي صلى الله عليه وسلم في الدعاء","dorar":"ZSBcobV8"},{"id":"س-03880","fp":"d3f58266392a","stateId":422,"easy":"إذا خفت ألا تستيقظ آخر الليل فأوتر أوله ← وإن طمعت فآخره، فالقراءة فيه محضورة","cause":"مَن خافَ منكُم ألَّا يَستَيقِظَ مِن آخِرِ الليلِ، فلْيوتِرْ مِن أوَّلِ الليلِ، ثُمَّ لْيَرقُدْ، ومَن طَمِعَ منكم أنْ يَستَيقِظَ مِن آخِرِ الليلِ فَليوتِرْ مِن آخِرِ الليلِ","result":"فإنَّ قِراءةَ آخِرِ الليلِ مَحْضورةٌ، وذلك أفضَلُ","explicit":true,"star":true,"apply":{"k":"time","t":"في الليل"},"ref":"تخريج المسند لشعيب 15179","srcLabel":"مسلم","text":[["مَن خافَ منكُم ألَّا يَستَيقِظَ مِن آخِرِ الليلِ، فلْيوتِرْ مِن أوَّلِ الليلِ، ثُمَّ لْيَرقُدْ، ومَن طَمِعَ منكم أنْ يَستَيقِظَ مِن آخِرِ الليلِ فَليوتِرْ مِن آخِرِ الليلِ؛ ",1],["فإنَّ قِراءةَ آخِرِ الليلِ مَحْضورةٌ، وذلك أفضَلُ",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه مسلم (755)، والترمذي بعد حديث (455)، وابن ماجه (1187)، وأحمد (15179) واللفظ له","bab":"تراويح وتهجد وقيام ليل › فضل قيام الليل","dorar":"TErt7Vxl","merged":2,"otherRefs":["صحيح الترمذي 455 (صحيح)"]},{"id":"ق-0155","fp":"306d07024e93","stateId":422,"easy":"قيام الليل بتلاوة آيات الله والسجود والإيمان والأمر بالمعروف والمسارعة في الخيرات ← الصلاح ولا يُكفر خيرهم","cause":"قيام الليل بتلاوة آيات الله والسجود والإيمان والأمر بالمعروف والمسارعة في الخيرات","result":"الصلاح ولا يُكفر خيرهم","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"apply":{"k":"time","t":"في السجود، في الليل"},"otherNeedIds":[51],"ref":"سورة آل عمران: 113–115","srcLabel":"القرآن الكريم","quran":{"s":3,"from":113,"to":115,"text":"لَيْسُوا سَوَاءً مِنْ أَهْلِ الْكِتَابِ أُمَّةٌ قَائِمَةٌ يَتْلُونَ آيَاتِ اللَّهِ آنَاءَ اللَّيْلِ وَهُمْ يَسْجُدُونَ (113) يُؤْمِنُونَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَيَأْمُرُونَ بِالْمَعْرُوفِ وَيَنْهَوْنَ عَنِ الْمُنْكَرِ وَيُسَارِعُونَ فِي الْخَيْرَاتِ وَأُولَئِكَ مِنَ الصَّالِحِينَ (114) وَمَا يَفْعَلُوا مِنْ خَيْرٍ فَلَنْ يُكْفَرُوهُ وَاللَّهُ عَلِيمٌ بِالْمُتَّقِينَ (115)","hl":[[17,377,1]]}},{"id":"س-08113","fp":"a6b6fe2032d0","stateId":422,"easy":"إذا خفت ألا تقوم آخر الليل فأوتر أوله، وإن طمعت فآخره ← فصلاة آخر الليل مشهودة وهي أفضل","cause":"مَن خافَ أن لا يَقومَ مِن آخِرِ اللَّيلِ فليوتِرْ أوَّلَه، ومَن طَمِعَ أن يَقومَ آخِرَه فليوتِرْ آخِرَ اللَّيلِ","result":"فإنَّ صَلاةَ آخِرِ اللَّيلِ مَشْهودةٌ، وذلك أفضَلُ","explicit":true,"apply":{"k":"time","t":"في الليل"},"ref":"صحيح مسلم 755","srcLabel":"أحمد","text":["قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["مَن خافَ أن لا يَقومَ مِن آخِرِ اللَّيلِ فليوتِرْ أوَّلَه، ومَن طَمِعَ أن يَقومَ آخِرَه فليوتِرْ آخِرَ اللَّيلِ؛ ",1],["فإنَّ صَلاةَ آخِرِ اللَّيلِ مَشْهودةٌ، وذلك أفضَلُ",2],". وقال أبو مُعاويةَ: وفي روايةٍ: مَحضورةٌ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (14207)، وأبو يعلى (2279)، والبيهقي (4837) باختلاف يسير.","bab":"ملائكة › أعمال الملائكة","dorar":"u6XeKben","merged":3,"otherRefs":["الفتاوى الكبرى 2/ 128 (صحيح)","فتاوى نور على الدرب لابن عثيمين 5/88 (صحيح)"]},{"id":"س-00724","fp":"516843280e8c","stateId":422,"easy":"إذا استيقظت من الليل وأيقظت زوجتك فصليتما ← تُكتبان من الذاكرين الله كثيراً والذاكرات","cause":"مَنِ استيقَظَ مِنَ اللَّيلِ وأيقَظَ امرأتَه فصَلَّيَا ركعتَينِ جميعًا","result":"كُتِبَا مِنَ الذَّاكِرينَ اللهَ كثيرًا والذَّاكِراتِ","explicit":true,"apply":{"k":"time","t":"عند الاستيقاظ"},"otherNeedIds":[26],"ref":"الأحكام الوسطى 2/ 53","srcLabel":"الأحكام الوسطى","text":[["مَنِ استيقَظَ مِنَ اللَّيلِ وأيقَظَ امرأتَه فصَلَّيَا ركعتَينِ جميعًا، ",1],["كُتِبَا مِنَ الذَّاكِرينَ اللهَ كثيرًا والذَّاكِراتِ",2]],"grade":"صحيح","narrator":"أبو هريرة وأبو سعيد","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"HohRKnWO"},{"id":"س-02145","fp":"6d1e2ca81a22","stateId":422,"easy":"إذا صليت الوتر ← فهو خير لك من حمر النعم","cause":"إنَّ اللهَ قد أمَدَّكُم بصَلاةٍ هي","result":"خَيرٌ لَكُم من حُمْرِ النَّعَمِ","explicit":true,"ref":"المستدرك على الصحيحين 1163","srcLabel":"أحمد","text":["خَرَج علينا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: ",["إنَّ اللهَ قد أمَدَّكُم بصَلاةٍ هي ",1],["خَيرٌ لَكُم من حُمْرِ النَّعَمِ",2],"، وهي الوِترُ، فجَعَلَها لَكُم فيما بيْنَ صَلاةِ العِشاءِ إلى صَلاةِ الفَجرِ."],"grade":"صحيح","narrator":"خارجة بن حذافة العدوي","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (39/ 444)، والدارمي (1617) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"168yWUBC"},{"id":"س-03388","fp":"cf2b896ce771","stateId":422,"easy":"إذا اغتنمت ظلمة الليل وغفلة الناس فقمت تصلي ← فذلك لك لا عليك","cause":"فَرجلٌ أغْتَنَمَ ظُلْمَةَ الليلِ وغَفْلَةَ الناسِ فقامَ يصلِّي","result":"فذلكَ لهُ ولا عليهِ","explicit":true,"ref":"صحيح الترغيب 633","srcLabel":"أبو داود","text":["قال سلمانُ : حافِظُوا على هذه الصلواتِ الخمسِ ، فإنَّهُنَّ كَفَّارَاتٌ لِهَذِهِ الجِرَاحاتِ ، ما لمْ تُصِبِ المَقْتَلَةَ ، فإذا صلَّى الناسُ العِشاءَ صَدَرُوا عن ثلاثِ منازلٍ ، مِنْهُمْ مَنْ عليهِ ولا لهُ ، ومِنْهُمْ مَنْ لهُ ولا عليهِ ، ومِنْهُمْ مَنْ لا لهُ ولا عليهِ : فَرجلٌ اغْتَنَمَ ظُلْمَةَ الليلِ وغفلةَ الناسِ فركبَ فرسَهُ في المعاصِي ، فذلكَ عليهِ ولا لهُ ، ومن لهُ ولا عليهِ ",["فَرجلٌ أغْتَنَمَ ظُلْمَةَ الليلِ وغَفْلَةَ الناسِ فقامَ يصلِّي",1]," ، ",["فذلكَ لهُ ولا عليهِ",2]," ، ومَنْ لا لهُ ولا عليهِ : فَرجلٌ صلَّى ثُمَّ نامَ ، فذلكَ لا لهُ ولا عليهِ ، إِيَّاكَ والحَقْحَقَةَ ، وعليكَ بِالقَصْدِ ، وداومْ"],"grade":"صحيح","narrator":"طارق بن شهاب","muhaddith":"صحيح لغيره","takhrij":"أخرجه عبد الرزاق (148)، وأبو داود في ((الزهد)) (256)، والطبراني في ((المعجم الكبير)) (6/ 217) (6051) بنحوه.","bab":"استغفار › أسباب المغفرة","dorar":"r0MO4bjA"},{"id":"س-05923","fp":"8ba3afcd5464","stateId":422,"easy":"إذا وثقت بقيامك آخر الليل فأوتر آخره ← فالقراءة فيه محضورة وهو أفضل","cause":"ومَن وثِقَ بقيامٍ مِنَ اللَّيلِ فليوتِرْ مِن آخِرِه","result":"فإنَّ قِراءةَ آخِرِ اللَّيلِ مَحضورةٌ، وذلك أفضَلُ","explicit":true,"apply":{"k":"time","t":"في الليل"},"ref":"صحيح مسلم 755","srcLabel":"الترمذي","text":["سَمِعتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم يقولُ: أيُّكُم خافَ أن لا يَقومَ مِن آخِرِ اللَّيلِ فليوتِرْ، ثُمَّ ليَرقُدْ، ",["ومَن وثِقَ بقيامٍ مِنَ اللَّيلِ فليوتِرْ مِن آخِرِه؛ ",1],["فإنَّ قِراءةَ آخِرِ اللَّيلِ مَحضورةٌ، وذلك أفضَلُ",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه الترمذي (455)، وابن ماجة (1187)، وأحمد (14624) واللفظ لهم.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"yNcF4apu"},{"id":"س-01629","fp":"5cc555466138","stateId":422,"easy":"إذا عبدت الله في جوف الليل الآخر ← فهي أفضل الساعات","cause":"جَوفُ اللَّيلِ الآخِرُ","result":"أيُّ السَّاعاتِ أفضلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"في الليل"},"otherNeedIds":[29],"ref":"تخريج المسند لشعيب 19435","srcLabel":"ابن ماجه","text":["عن عمرِو بنِ عَبَسةَ قال: أتَيتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فقُلتُ: يا رسولَ اللهِ، مَن معك على هذا الأمْرِ؟ قال: حُرٌّ وعبدٌ، قُلتُ: ما الإسلامُ؟ قال: طِيبُ الكَلامِ، وإطعامُ الطَّعامِ، قُلتُ: ما الإيمانُ؟ قال: الصَّبرُ والسَّماحةُ، قال: قُلتُ: أيُّ الإسلامِ أفضلُ؟ قال: مَن سَلِمَ المُسلِمونَ مِن لِسانِه ويدِه، قال: قُلتُ: أيُّ الإيمانِ أفضلُ؟ قال: خُلقٌ حَسنٌ، قال: قُلتُ: أيُّ الصَّلاةِ أفضلُ؟ قال: طولُ القُنوتِ، قال: قُلتُ: أيُّ الهِجرةِ أفضلُ؟ قال: أنْ تَهجُرَ ما كَرِهَ ربُّكَ عزَّ وجلَّ، قال: قُلتُ: فأيُّ الجِهادِ أفضلُ؟ قال: مَن عُقِرَ جَوادُه وأُهريقَ دَمُه، قال: قُلتُ: ",["أيُّ السَّاعاتِ أفضلُ",2],"؟ قال: ",["جَوفُ اللَّيلِ الآخِرُ",1],"، ثُمَّ الصَّلاةُ مَكتوبةٌ مَشهودةٌ حتى يَطلُعَ الفَجرُ، فإذا طَلَعَ الفَجرُ، فلا صَلاةَ إلَّا الرَّكعتَينِ حتى تُصلِّيَ الفَجرَ، فإذا صَلَّيتَ صَلاةَ الصُّبحِ، فأمسِكْ عن الصَّلاةِ حتى تَطلُعَ الشَّمسُ، فإذا طَلَعَتِ الشَّمسُ -فإنَّها تَطلُعُ في قَرنَيْ شَيطانٍ، وإنَّ الكفَّارَ يُصلُّونَ لها-، فأمسِكْ عن الصَّلاةِ حتى تَرتفِعَ، فإذا ارتفَعَتْ، فالصَّلاةُ مَكتوبةٌ مَشهودةٌ حتى يَقومَ الظِّلُّ قيامَ الرُّمحِ، فإذا كان كذلك، فأمسِكْ عن الصَّلاةِ حتى تَميلَ، فإذا مالتْ، فالصَّلاةُ مَكتوبةٌ مَشهودةٌ حتى تَغرُبَ الشَّمسُ، فإذا كان عندَ غُروبِها، فأمسِكْ عن الصَّلاةِ؛ فإنَّها تَغرُبُ أو تَغيبُ في قَرنَيْ شَيطانٍ، وإنَّ الكفَّارَ يُصلُّونَ لها."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"قوله: أي الساعات أفضل؟ قال: \"جوف الليل الآخر\" صحيح، وقوله في أفضل الإيمان وأفضل الصلاة وأفضل الهجرة وأفضل الجهاد، صحيح لغيره","takhrij":"أخرجه ابن ماجه (2794) مختصراً، وأحمد (19435) واللفظ له","bab":"أطعمة › إطعام الطعام","dorar":"DBB8Imql"},{"id":"س-06539","fp":"63bd29450187","stateId":423,"easy":"إذا صليت ركعتي الفجر ← فهما خير من الدنيا جميعاً","cause":"رَكْعَتا الفَجرِ","result":"خيرٌ منَ الدُّنيا جميعًا","explicit":true,"star":true,"ref":"صحيح ابن خزيمة 2/ 288","srcLabel":"مسلم","text":[["رَكْعَتا الفَجرِ ",1],["خيرٌ منَ الدُّنيا جميعًا ",2],"[وفي روايةٍ]: في رَكْعتيِ الفجرِ: هما خيرٌ منَ الدُّنيا جميعًا [وفي روايةٍ]: رَكْعتا الفَجرِ أحبُّ إليَّ منَ الدُّنيا جميعًا"],"grade":"صحيح","narrator":"عائشة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (725)، والترمذي (416)، وأحمد (26286) بلفظه","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"0TcspfNQ"},{"id":"س-01193","fp":"a0892eb11999","stateId":423,"easy":"إذا حافظت على ركعتي الفجر ← فهما من الفضائل","cause":"وركعتا الفجرِ، حافظوا عليهما","result":"فإنَّهما من الفضائلِ","explicit":true,"ref":"تخريج المسند لشاكر 7/255","srcLabel":"أحمد","text":["عن أيوب بن سلمان رجل من أهل صنعاء قال: كنَّا بمكةَ فجلسنا إلى عطاءٍ الخراسانيِّ إلى جنبِ جدارِ المسجدِ فلم نسألْه ولم يُحدِّثْنا قال ثم جلسنا إلى ابنِ عمرَ مثلَ مجلسِكم هذا فلمْ نسألْه ولم يُحدِّثْنا قال فقال ما بالُكم لا تتكلَّمونَ ولا تذكرونَ اللهَ قولوا اللهُ أكبرُ والحمدُ للهِ وسبحانَ اللهِ وبحمدِهِ بواحدةٍ عشرًا وبعشرٍ مائةً من زادَ زادهُ اللهُ ومن سكتَ غُفِرَ لهُ ألا أُخبرُكم بخمسٍ سمعتهنَّ من رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ؟ قالوا : بَلَى قال من حالتْ شفاعتُهُ دونَ حَدٍّ من حدودِ اللهِ فهو مُضَادُّ اللهِ في أمرِهِ ومن أعانَ على خصومةٍ بغيرِ حقٍّ فهو مُستظلٌّ في سخطِ اللهِ حتى يتركَ ومن قَفَا مؤمنًا أو مؤمنةً حبسهُ اللهُ في رَدْغَةِ الخَبَالِ عصارةِ أهلِ النارِ ومن ماتَ وعليهِ دَيْنٌ أُخِذَ لصاحبِه من حسناتِه لا دينارَ ثَمَّ ولا درهمَ ",["وركعتا الفجرِ، حافظوا عليهما",1]," ",["فإنَّهما من الفضائلِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (5544)","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"2sGjBDac"},{"id":"س-06463","fp":"5a194508e959","stateId":423,"easy":"إذا مشيت إلى صلاة الضحى ← فلك أجر المعتمر","cause":"ومَن مَشى إلى سُبْحةِ الضُّحى","result":"كان له كأجْرِ المُعتمِرِ، وصَلاةٌ على إثرِ صَلاةٍ لا لَغوَ بيْنَهما كِتابٌ في عِلِّيِّينَ","explicit":true,"apply":{"k":"time","t":"الضحى"},"otherNeedIds":[49,68],"ref":"تخريج المسند لشعيب 22304","srcLabel":"أبو داود","text":["مَن مَشى إلى صَلاةٍ مَكتوبةٍ وهو مُتطهِّرٌ، كان له كأجْرِ الحاجِّ المُحرِمِ، ",["ومَن مَشى إلى سُبْحةِ الضُّحى، ",1],["كان له كأجْرِ المُعتمِرِ، وصَلاةٌ على إثرِ صَلاةٍ لا لَغوَ بيْنَهما كِتابٌ في عِلِّيِّينَ",2],"، وقال أبو أُمامةَ: الغُدوُّ والرَّواحُ إلى هذه المساجدِ مِن الجِهادِ في سَبيلِ اللهِ."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (558)، وأحمد (22304) واللفظ له","bab":"صلاة › فرض الصلاة","dorar":"TkJ3OB7B"},{"id":"س-06579","fp":"03057bff6d80","stateId":423,"easy":"إذا خرجت لصلاة الضحى لا يخرجك إلا هي ← فأجرك كأجر المعتمر","cause":"ومَن خرَجَ إلى تَسبيحِ الضُّحى لا يَنصِبُه إلَّا إيَّاهُ","result":"فأجْرُه كأجْرِ المُعتَمِرِ، وصَلاةٌ على إثْرِ صَلاةٍ لا لَغوَ بينَهما كتابٌ في عِلِّيِّينَ","explicit":true,"apply":{"k":"time","t":"الضحى"},"otherNeedIds":[49,68],"ref":"تخريج سنن أبي داود 558","srcLabel":"أبو داود","text":["\"مَن خرَجَ من بَيتِه مُتطهِّرًا إلى صَلاةٍ مَكتوبةٍ؛ فأجْرُه كأجْرِ الحاجِّ المُحرِمِ، ",["ومَن خرَجَ إلى تَسبيحِ الضُّحى لا يَنصِبُه إلَّا إيَّاهُ؛ ",1],["فأجْرُه كأجْرِ المُعتَمِرِ، وصَلاةٌ على إثْرِ صَلاةٍ لا لَغوَ بينَهما كتابٌ في عِلِّيِّينَ\"",2],"."],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (558 ) واللفظ له، وأحمد (22304)، والطبراني في ((المعجم الأوسط)) (3262) كلاهما باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"yiDjareh"},{"id":"س-01941","fp":"ec81015fd77e","stateId":423,"easy":"إذا لم تدع ركعتي الفجر ← ففيهما الرغائب","cause":"لا تَدَعُوا الركعتينِ اللتينِ قبلَ صلاةِ الفجرِ","result":"فإنَّ فيهمَا الرَّغَائِبُ","explicit":true,"similar":["س-02330"],"ref":"الجامع الصغير 9741","srcLabel":"أحمد","text":[["لا تَدَعُوا الركعتينِ اللتينِ قبلَ صلاةِ الفجرِ،  ",1],["فإنَّ فيهمَا الرَّغَائِبُ",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن","takhrij":"أخرجه الطبراني (12/408) (13502) واللفظ له، وأخرجه أحمد (5544) مطولاً باختلاف يسير، والخطيب في ((تاريخ بغداد)) (1/241) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"HB0qiHN0"},{"id":"س-02330","fp":"b8854e21789d","stateId":423,"easy":"إذا حافظت على ركعتي الفجر ← ففيهما فضيلة","cause":"عليك بركعَتَي الفَجرِ","result":"فإنَّ فيهما فَضيلةً","explicit":true,"repOf":"س-01941","ref":"فيض القدير 4/ 333","text":[["عليك بركعَتَي الفَجرِ؛ ",1],["فإنَّ فيهما فَضيلةً",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"رمز السيوطي لحسنه وليس كما قال","takhrij":"أخرجه الطبراني (13/337) (14147). واللفظ له، وأحمد (5544) مطولاً باختلاف يسير، وأبو نعيم الأصبهاني في تاريخ أصبهان ((1/ 112)) بنحوه","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"RoqsiQQL"},{"id":"س-03876","fp":"63a16f7b645c","stateId":423,"easy":"إذا صليت ركعتين ← فما أذن الله لعبد في شيء أفضل منهما","cause":"ركعتينِ يصلِّيهما","result":"ما أذِنَ اللهُ لعبدٍ في شيءٍ أفضلَ","explicit":true,"apply":{"k":"count","t":"ركعتين"},"ref":"هداية الرواة 2/84","srcLabel":"الترمذي","text":[["ما أذِنَ اللهُ لعبدٍ في شيءٍ أفضلَ",2]," من ",["ركعتينِ يصلِّيهما",1]," وإنَّ البِرَّ ليُذَرُّ على رأسِ العبدِ ما دام في صلاتِه وما تقرَّب العبادُ إلى اللهِ تعالى بمِثلِ ما خرجَ منه يعني القرآنَ"],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه الترمذي (2911)، وأحمد (22306) باختلاف يسير","bab":"تراويح وتهجد وقيام ليل › فضل قيام الليل","dorar":"SIChCS0E"},{"id":"س-06755","fp":"d58e68d14e6c","stateId":423,"easy":"إذا صليت الضحى وصمت ثلاثة أيام من الشهر ولم تترك الوتر ← يُكتب لك أجر شهيد","cause":"مَنْ صلَّى الضُّحَى وصامَ ثلاثَةَ أيامٍ مِنَ الشَّهْرِ ولمْ يَتْرُكِ الوترَ في حَضَرٍ ولا سفرٍ","result":"كُتِبَ لهُ أَجْرُ شَهِيدٍ","explicit":true,"apply":{"k":"time","t":"الضحى"},"otherNeedIds":[49,62],"ref":"الفتح الرباني 10/4958","srcLabel":"الطبراني","text":[["مَنْ صلَّى الضُّحَى وصامَ ثلاثَةَ أيامٍ مِنَ الشَّهْرِ ولمْ يَتْرُكِ الوترَ في حَضَرٍ ولا سفرٍ ",1],["كُتِبَ لهُ أَجْرُ شَهِيدٍ",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني (13/74) (13707)، وأبو نعيم في ((حلية الأولياء)) (4/332)","bab":"صيام › فضل الصيام","dorar":"hGl1321I"},{"id":"س-02869","fp":"74145fd6f1eb","stateId":423,"easy":"إذا صليت الضحى ← فلك أجر ذلك اليوم","cause":"فصلَّى رجلٌ ركعتين وأربعَ سجداتٍ","result":"فإنَّ له أجرَ ذلك اليومِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"apply":{"k":"time","t":"الضحى"},"ref":"المتجر الرابح 79","srcLabel":"الطبراني","text":["إذا طلعتِ الشمسُ من مطلَعِها كهيئتِها لصلاةِ العصرِ حتى تغربَ من مغربِها ",["فصلَّى رجلٌ ركعتين وأربعَ سجداتٍ",1]," – ",["فإنَّ له أجرَ ذلك اليومِ",2]," وحسبتُه قال -: وكُفر عنه خطيئتُه وإثمُه وأحسبُه قال: وإنْ مات من يومِه دخل الجنَّةَ."],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه الطبراني (8/226) (7790)","bab":"إيمان › الوعد","dorar":"T8Moz33f"},{"id":"س-06689","fp":"e23d409a7469","stateId":424,"easy":"إذا صليت النافلة في بيتك ← فهي أفضل من صلاتك في المسجد النبوي","cause":"صلاتُكُمْ في بُيوتِكُمْ","result":"أفضلُ مِن صلاتِكُمْ في مسجِدي هذا","explicit":true,"star":true,"similar":["س-06721"],"ref":"تخريج شرح السنة 996","srcLabel":"متفق عليه","text":[["صلاتُكُمْ في بُيوتِكُمْ ",1],["أفضلُ مِن صلاتِكُمْ في مسجِدي هذا",2],"، إلَّا المكتوبةَ."],"grade":"صحيح","narrator":"زيد بن ثابت","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (731)، ومسلم (781) مطولاً بنحوه","bab":"صلاة الجماعة والإمامة › الحرص على حضور الجماعة","dorar":"YDCAvJWc"},{"id":"س-06721","fp":"424808bb7b29","stateId":424,"easy":"إذا صليت النافلة في بيتك ← فهي أفضل من صلاتك في المسجد النبوي","cause":"صلاةُ المرءِ في بيتِهِ","result":"أفضَلُ مِن صلاتِهِ في مَسجدي هذا","explicit":true,"repOf":"س-06689","ref":"هداية الرواة 1252","text":["أنَّ النَّبيَّ صلَّى اللَّهُ علَيهِ وسلَّمَ قالَ : ",["صلاةُ المرءِ في بيتِهِ ",1],["أفضَلُ مِن صلاتِهِ في مَسجدي هذا ",2],"؛ إلَّا المَكْتوبةَ"],"grade":"صحيح","narrator":"زيد بن ثابت","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1044) واللفظ له، وأخرجه البخاري (731)، ومسلم (781) مطولاً بنحوه","bab":"صلاة الجماعة والإمامة › فضل صلاة الجماعة","dorar":"xuGPxZVL"},{"id":"س-04103","fp":"d46675767785","stateId":424,"easy":"إذا صلت المرأة في حجرتها ← فهو أفضل من صلاتها في دارها","cause":"وصلاتُها في حُجرتِها","result":"أفضلُ من صلاتِها في دارِها","explicit":true,"similar":["س-06854","س-06220","س-06855","س-03684"],"ref":"مجمع الزوائد 2/37","srcLabel":"الطبراني","text":["عن ابنِ مسعودٍ قال صلاةُ المرأةِ في بيتِها أفضلُ من صلاتِها في حُجرتِها ",["وصلاتُها في حُجرتِها",1]," ",["أفضلُ من صلاتِها في دارِها",2]," وصلاتُها في دارها أفضل من صلاتِها فيما سواها ثم قال إنَّ المرأةَ إذا خرجَتْ استشرفَها الشيطانُ"],"grade":"صحيح","narrator":"[عوف بن مالك بن نضلة أبو الأحوص]","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((الكبير)) (9/ 295) (9482) واللفظ له، وعبد الرزاق (5116) بنحوه.","bab":"جن › صفة إبليس وجنوده","dorar":"1CzLxLtZ","merged":2,"otherRefs":["الجامع الصغير 5094 (صحيح)"]},{"id":"س-06854","fp":"f0a9039a334f","stateId":424,"easy":"إذا صلّت المرأة في مخدعها ← فهو أفضل من صلاتها في بيتها","cause":"صلاةُ المرأةِ في مَخدعِها","result":"أفضلُ من صلاتِها في بيتِها","explicit":true,"repOf":"س-04103","ref":"المحلى 4/201","text":["إنَّما المرأةُ عَورةٌ فإذا خرجَت استشرَفَها الشَّيطانُ ، وأقرَبُ ما تَكونُ مِن وجهِ ربِّها وَهيَ في قَعرِ بيتِها ",["صلاةُ المرأةِ في مَخدعِها",1]," ",["أفضلُ من صلاتِها في بيتِها",2]," ، وصلاتُها في بيتِها أفضلُ من صلاتِها في حُجرتِها"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"احتج به ، وقال في المقدمة: (لم نحتج إلا بخبر صحيح من رواية الثقات مسند)","takhrij":"أخرجه الترمذي (1173)، وابن حبان (5598) مختصراً، وابن خزيمة (1685، 1690) مفرقاً","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"bCwOJksE","merged":2,"otherRefs":["مجمع الزوائد 2/37 (صحيح)"]},{"id":"س-06220","fp":"df18bc8a29ef","stateId":424,"easy":"إذا صلّت المرأة في بيتها ← فهو أفضل من صلاتها في حجرتها","cause":"صلاتُكُنَّ في بُيوتِكُنَّ","result":"أفضلُ من صلاتِكُنَّ في حُجَرِكُنَّ","explicit":true,"repOf":"س-04103","ref":"الجامع الصغير 5094","text":[["صلاتُكُنَّ في بُيوتِكُنَّ ",1],["أفضلُ من صلاتِكُنَّ في حُجَرِكُنَّ ",2],"، و صلاتُكُنَّ في حُجَرِكُنَّ أفضلُ من صلاتِكُنَّ في دُورِكُنَّ ، و صلاتُكُنَّ في دُورِكُنَّ أفضلُ من صلاتِكُنَّ في مَسجِدِ الجماعةِ."],"grade":"صحيح","narrator":"أم حميد","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (25/148) (356) واللفظ له، وأخرجه أحمد (27090)، وابن خزيمة (1689) بنحوه","bab":"ستر العورة › وجوب سترها","dorar":"FPdW7VPz"},{"id":"س-06855","fp":"8ebdea7e3e8c","stateId":424,"easy":"إذا صلّت في بيتها ← فهو أفضل من صلاتها في حجرتها","cause":"وصلاتُها في بيتِها","result":"أفضلُ من صلاتِها في حُجرتِها","explicit":true,"repOf":"س-04103","ref":"المحلى 4/201","text":["إنَّما المرأةُ عَورةٌ فإذا خرجَت استشرَفَها الشَّيطانُ ، وأقرَبُ ما تَكونُ مِن وجهِ ربِّها وَهيَ في قَعرِ بيتِها صلاةُ المرأةِ في مَخدعِها أفضلُ من صلاتِها في بيتِها ، ",["وصلاتُها في بيتِها",1]," ",["أفضلُ من صلاتِها في حُجرتِها",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"احتج به ، وقال في المقدمة: (لم نحتج إلا بخبر صحيح من رواية الثقات مسند)","takhrij":"أخرجه الترمذي (1173)، وابن حبان (5598) مختصراً، وابن خزيمة (1685، 1690) مفرقاً","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"bCwOJksE"},{"id":"س-03684","fp":"2e8a64a6f596","stateId":424,"easy":"إذا صلّت المرأة في بيتها ← فهو خير لها من حجرتها","cause":"وصَلاتُكِ في بَيتِك","result":"خيرٌ لكِ من صلاتِكِ في حُجرتِكِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04103","ref":"تخريج المحلى 3/133","text":["عن عَمَّتِه أُمِّ حُمَيدٍ امرأةِ أبي حُمَيدٍ الساعِديِّ أنَّها جاءتِ النَّبيَّ صلَّى اللهُ عليه وسلَّم فقالت: يا رسولَ اللهِ، إنِّي أُحِبُّ الصَّلاةَ معك، قال: قد عَلِمتُ أنَّكِ تُحِبينَ الصَّلاةَ معي، ",["وصَلاتُكِ في بَيتِك",1]," ",["خيرٌ لكِ من صلاتِكِ في حُجرتِكِ",2],"، وصَلاتُكِ في حُجرتِكِ خيرٌ من صَلاتِكِ في دارِكِ، وصَلاتُكِ في دارِكِ خيرٌ لكِ من صَلاتِكِ في مسجِدِ قومِكِ، وصلاتُكِ في مسجِدِ قومِكِ خيرٌ لك من صَلاتِكِ في مسجِدي، قال: فأَمَرَتْ, فبُنِيَ لها مسجِدٌ في أقصى شَيءٍ من بيتِها أو أظلَمِه، فكانتْ تُصَلي فيه حتى لَقِيَتِ اللهَ عزَّ وجلَّ."],"grade":"صحيح","narrator":"أم حميد الساعدي","muhaddith":"صحيح","takhrij":"أخرجه أحمد (27090) واللفظ له، وابن أبي شيبة كما في ((إتحاف الخيرة المهرة)) للبوصيري (1045)، وابن خزيمة (1689) باختلاف يسير","bab":"اعتصام بالسنة › لزوم السنة","dorar":"99N17ssg"},{"id":"س-03685","fp":"50cb8b0b90e0","stateId":424,"easy":"إذا صلّت المرأة في دارها ← فهو خير لها من مسجد قومها","cause":"وصَلاتُكِ في دارِكِ","result":"خيرٌ لكِ من صَلاتِكِ في مسجِدِ قومِكِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المحلى 3/133","srcLabel":"أحمد","text":["عن عَمَّتِه أُمِّ حُمَيدٍ امرأةِ أبي حُمَيدٍ الساعِديِّ أنَّها جاءتِ النَّبيَّ صلَّى اللهُ عليه وسلَّم فقالت: يا رسولَ اللهِ، إنِّي أُحِبُّ الصَّلاةَ معك، قال: قد عَلِمتُ أنَّكِ تُحِبينَ الصَّلاةَ معي، وصَلاتُكِ في بَيتِك خيرٌ لكِ من صلاتِكِ في حُجرتِكِ، وصَلاتُكِ في حُجرتِكِ خيرٌ من صَلاتِكِ في دارِكِ، ",["وصَلاتُكِ في دارِكِ",1]," ",["خيرٌ لكِ من صَلاتِكِ في مسجِدِ قومِكِ",2],"، وصلاتُكِ في مسجِدِ قومِكِ خيرٌ لك من صَلاتِكِ في مسجِدي، قال: فأَمَرَتْ, فبُنِيَ لها مسجِدٌ في أقصى شَيءٍ من بيتِها أو أظلَمِه، فكانتْ تُصَلي فيه حتى لَقِيَتِ اللهَ عزَّ وجلَّ."],"grade":"صحيح","narrator":"أم حميد الساعدي","muhaddith":"صحيح","takhrij":"أخرجه أحمد (27090) واللفظ له، وابن أبي شيبة كما في ((إتحاف الخيرة المهرة)) للبوصيري (1045)، وابن خزيمة (1689) باختلاف يسير","bab":"اعتصام بالسنة › لزوم السنة","dorar":"99N17ssg"},{"id":"س-03786","fp":"2dbaa18feb83","stateId":425,"easy":"إذا صليت الصلاة لوقتها ← أحرزت صلاتك، وما صليته بعد مع الأمراء نافلة","cause":"وصَلِّ الصَّلاةَ لِوقتِها","result":"كُنْتَ قد أحرَزْتَ صلاتَك وإلَّا فهي لك نافلةٌ","explicit":true,"star":true,"otherNeedIds":[51],"ref":"تخريج صحيح ابن حبان 5964","srcLabel":"مسلم","text":["قدِم أبو ذرٍّ على عُثمانَ مِن الشَّامِ فقال : يا أميرَ المؤمنينَ افتَحِ البابَ حتَّى يدخُلَ النَّاسُ أتحسَبُني مِن قومٍ يقرَؤونَ القُرآنَ لا يُجاوِزُ حناجرَهم يمرُقونَ مِن الدِّينِ مُروقَ السَّهمِ مِن الرَّميَّةِ ثمَّ لا يعودونَ فيه حتَّى يعودَ السَّهمُ على فُوقِه هم شرُّ الخَلْقِ والخليقةِ والَّذي نفسي بيدِه لو أمَرْتَني أنْ أقعُدَ لَمَا قُمْتُ ولو أمَرْتَني أنْ أكونَ قائمًا لَقُمْتُ ما أمكنَتْني رِجْلايَ ولو ربَطْتَني على بعيرٍ لَمْ أُطلِقْ نفسي حتَّى تكونَ أنتَ الَّذي تُطلِقُني ثمَّ استأذَنه أنْ يأتيَ الرَّبَذةَ فأذِن له فأتاها فإذا عبدٌ يؤُمُّهم فقالوا : أبو ذرٍّ فنكَص العبدُ فقيل له : تقدَّمْ فقال : أوصاني خليلي صلَّى اللهُ عليه وسلَّم بثلاثٍ : أنْ أسمَعَ وأُطيعَ ولو لعبدٍ حبَشيٍّ مُجدَّعِ الأطرافِ، وإذا صنَعْتَ مَرقةً فأكثِرْ ماءَها ثمَّ انظُرْ جيرانَك فأنِلْهم منها بمعروفٍ ",["وصَلِّ الصَّلاةَ لِوقتِها",1]," فإنْ أتَيْتَ الإمامَ وقد صلَّى ",["كُنْتَ قد أحرَزْتَ صلاتَك وإلَّا فهي لك نافلةٌ",2]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن زنجويه في ((الأموال)) (27) باختلاف يسير، وأخرجه مسلم (648، 2625) مفرقاً بلفظ مقارب دون الموقوف","bab":"بر وصلة › إكرام الجار وعدم أذيته","dorar":"hIcIH9NS","merged":9,"otherRefs":["تخريج المسند لشعيب 21501 (صحيح)","صحيح الأدب المفرد 83 (صحيح)","صحيح مسلم 648 (صحيح)","صحيح الجامع 3770 (صحيح)","صحيح الجامع 2394 (صحيح)","أعلام الموقعين 4/264 (صحيح)","إتحاف الخيرة المهرة 1/454 (حسن)"]},{"id":"س-06554","fp":"895baf7fc67c","stateId":425,"easy":"إذا كان لك تطوع ← تُكمل به فريضتك","cause":"من تطوُّعٍ","result":"أُكمِلتِ الفريضةُ من تطوُّعِهِ","explicit":true,"similar":["س-06161"],"otherNeedIds":[65],"ref":"صحيح ابن ماجه 1180","srcLabel":"ابن ماجه","text":["عَنْ أَنَسِ بْنِ حَكِيمٍ الضَّبِّيِّ، قَالَ: قَالَ لِي أَبُو هُرَيْرَةَ: إذا أتيتَ أَهلَ مصرِكَ فأخبرْهم أنِّي سمعتُ رسول اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّمَ يقولُ إنَّ أوَّلَ ما يحاسبُ بِهِ العبدُ المسلمُ يومَ القيامةِ الصَّلاةُ المَكتوبةُ فإن أتمَّها وإلَّا قيلَ انظروا هل لَهُ ",["من تطوُّعٍ",1]," فإن كانَ لَهُ تطوُّعٌ ",["أُكمِلتِ الفريضةُ من تطوُّعِهِ",2]," ثمَّ يفعلُ بسائرِ الأعمالِ المفروضةِ مثلُ ذلِكَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (1425)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"aozKOsvL","merged":6,"otherRefs":["تخريج مشكل الآثار 2554 (صحيح)","المستدرك على الصحيحين 982 (صحيح)","صحيح النسائي 465 (صحيح)","تخريج مشكل الآثار 2552 (صحيح)","تخريج شرح السنة 1019 (صحيح)"]},{"id":"ق-0036","fp":"53fbef3e9544","stateId":425,"easy":"تقديم الخير (الصلاة والزكاة) ← تجده عند الله","cause":"تقديم الخير (الصلاة والزكاة)","result":"تجده عند الله","explicit":true,"ref":"سورة البقرة: 110","srcLabel":"القرآن الكريم","quran":{"s":2,"from":110,"to":110,"text":"وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ وَمَا تُقَدِّمُوا لِأَنْفُسِكُمْ مِنْ خَيْرٍ تَجِدُوهُ عِنْدَ اللَّهِ إِنَّ اللَّهَ بِمَا تَعْمَلُونَ بَصِيرٌ (110)","hl":[[0,111,1]]}},{"id":"ق-0046","fp":"6cafd1b58a7e","stateId":425,"easy":"الإيمان والعمل (الصلاة) ← لا يضيعه الله","cause":"الإيمان والعمل (الصلاة)","result":"لا يضيعه الله","explicit":true,"ref":"سورة البقرة: 143","srcLabel":"القرآن الكريم","quran":{"s":2,"from":143,"to":143,"text":"وَكَذَلِكَ جَعَلْنَاكُمْ أُمَّةً وَسَطًا لِتَكُونُوا شُهَدَاءَ عَلَى النَّاسِ وَيَكُونَ الرَّسُولُ عَلَيْكُمْ شَهِيدًا وَمَا جَعَلْنَا الْقِبْلَةَ الَّتِي كُنْتَ عَلَيْهَا إِلَّا لِنَعْلَمَ مَنْ يَتَّبِعُ الرَّسُولَ مِمَّنْ يَنْقَلِبُ عَلَى عَقِبَيْهِ وَإِنْ كَانَتْ لَكَبِيرَةً إِلَّا عَلَى الَّذِينَ هَدَى اللَّهُ وَمَا كَانَ اللَّهُ لِيُضِيعَ إِيمَانَكُمْ إِنَّ اللَّهَ بِالنَّاسِ لَرَءُوفٌ رَحِيمٌ (143)","hl":[[316,401,1]]}},{"id":"س-06514","fp":"c2a72cf74420","stateId":425,"easy":"إذا صليت ← فالصلاة خير موضوع","cause":"الصلاةُ","result":"خيرٌ موضوعٍ","explicit":true,"similar":["س-01676"],"ref":"الجامع الصغير 5163","srcLabel":"الطبراني","text":[["الصلاةُ",1]," ",["خيرٌ موضوعٍ",2]," ، فمَنِ استطاعَ أنْ يَسْتكْثِرَ فلْيستكْثِرْ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((الأوسط)) (5346) واللفظ له.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"4EiChaFA","merged":2,"otherRefs":["شرح البخاري لابن الملقن 8/168 (صحيح)"]},{"id":"س-07171","fp":"25727df2c4bb","stateId":425,"easy":"إذا صليت مضطجعاً ← فلك نصف أجر القاعد","cause":"ومَن صَلَّى نائِمًا","result":"فلَه نِصفُ أجرِ القاعِدِ","explicit":true,"ref":"صحيح البخاري 1116","srcLabel":"أبو داود","text":["سَألتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم عن صَلاةِ الرَّجُلِ وهو قاعِدٌ، فقال: مَن صَلَّى قائِمًا فهو أفضَلُ، ومَن صَلَّى قاعِدًا فلَه نِصفُ أجرِ القائِمِ، ",["ومَن صَلَّى نائِمًا ",1],["فلَه نِصفُ أجرِ القاعِدِ",2],". قال أبو عَبد اللهِ: ‌نائِمًا ‌عِندي ‌مُضطَجِعًا ‌ها‌هُنا."],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"[صحيح]","takhrij":"أخرجه الترمذي (371)، وابن ماجه (1231)، باختلاف يسير، وأبو داود (951)، بلفظ مقارب.","bab":"علم › حسن السؤال ونصح العالم","dorar":"7L9WUmLZ","merged":2,"otherRefs":["النكت على المحرر 1/86 (صحيح)"]},{"id":"س-00937","fp":"814c3a79d9ec","stateId":425,"easy":"إذا ذكرت ربك وصليت في أول الوقت ← يضاعف الله لك الأجر","cause":"عليكُم بذِكرِ ربِّكم وصلُّوا صلاتَكم في أوَّلِ وقتِكم","result":"فإنَّ اللَّه عزَّ وجلَّ يضاعِفُ لَكم الأجرَ","explicit":true,"ref":"الجامع الصغير 5545","srcLabel":"الطبراني","text":[["عليكُم بذِكرِ ربِّكم وصلُّوا صلاتَكم في أوَّلِ وقتِكم ",1],["فإنَّ اللَّه عزَّ وجلَّ يضاعِفُ لَكم الأجرَ",2]],"grade":"صحيح","narrator":"عياض بن حمار","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (17/ 369) (1013)، وأبو نعيم في ((معرفة الصحابة)) (5443)، واللفظ لهما دون قول:\"الأجر\"","bab":"أدعية وأذكار › فضل الذكر","dorar":"mk2R7Hxh"},{"id":"س-03273","fp":"80006f11ef9d","stateId":425,"easy":"إذا سجدت لله سجدة ← يكتب الله لك بها حسنة ويحط خطيئة ويرفع درجة","cause":"مَن سَجَدَ للهِ سَجدةً","result":"كَتَبَ اللهُ له بها حَسَنةً، وحَطَّ عنه بها خَطيئةً، ورَفَعَ له بها دَرَجةً","explicit":true,"otherNeedIds":[11,47],"ref":"الترغيب والترهيب 1/194","srcLabel":"أحمد","text":["عن مطرف رضي الله عنه قال: قَعَدتُ إلى نَفَرٍ مِن قُرَيشٍ، فجاءَ رَجُلٌ فجَعَلَ يُصلِّي ويَرفَعُ ويَسجُدُ ولا يَقعُدُ، فقُلتُ: واللهِ ما أرى هذا يَدري يَنصَرِفُ على شَفْعٍ أو وِتْرٍ. فقالوا: ألَا نَقومُ إليه فنَقولَ له؟ قال: فقُمتُ فقُلتُ له: يا عَبدَ اللهِ ما أراكَ تَدري تَنصَرِفُ على شَفعٍ أو على وِتْرٍ. قال: ولكِنَّ اللهَ يَدْري، وسَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["مَن سَجَدَ للهِ سَجدةً، ",1],["كَتَبَ اللهُ له بها حَسَنةً، وحَطَّ عنه بها خَطيئةً، ورَفَعَ له بها دَرَجةً",2],". فقُلتُ: مَن أنتَ؟ فقال: أبو ذَرٍّ. فرَجَعتُ إلى أصحابي فقُلتُ: جَزاكُمُ اللهُ مِن جُلساءَ شَرًّا، أمَرتُموني أنْ أُعلِّمَ رَجُلًا مِن أصحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ. وفي رِوايةٍ: فرَأيتُه يُطيلُ القيامَ ويُكثِرُ الرُّكوعَ والسُّجودَ، فذَكَرتُ ذلك له، فقال: ما آلوْتُ أنْ أُحسِنَ؛ إنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: مَن رَكَعَ رَكعةً أو سَجَدَ سَجدةً، رَفَعَ اللهُ له بها دَرَجةً، وحَطَّ عنه بها خَطيئةً."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"هو بمجموع طرقه حسن أو صحيح","takhrij":"أخرجه أحمد (21308)، وأبو يوسف في ((الآثار)) (173)، والمروزي في ((تعظيم قدر الصلاة)) (287)، والطحاوي في ((شرح معاني الآثار)) (2730) واللفظ لهم.","bab":"استغفار › أسباب المغفرة","dorar":"1YdLkG7s"},{"id":"س-06161","fp":"119bed0cf40f","stateId":425,"easy":"إذا كان لك تطوّع ← تُكمّل به فريضتك يوم القيامة","cause":"هل تجدونَ لعبدِي مِنْ تَطَوُّعٍ","result":"فتُكْمِلونَ بها فريضتَهُ","explicit":true,"repOf":"س-06554","otherNeedIds":[65],"ref":"صحيح الجامع 2574","text":["أوَّلُ ما يُحاسَبُ بِهِ العبْدُ يومَ القيامَةِ صلاتُهُ ، فإِنْ كان أتَمَّها ، كُتِبَتْ له تامَّةً ، وإِنْ لم يكن أتَمَّها ، قال اللهُ لملائِكَتِه : انظروا ",["هل تجدونَ لعبدِي مِنْ تَطَوُّعٍ",1]," ",["فتُكْمِلونَ بها فريضتَهُ",2]," ؟ ثُمَّ الزكاةُ كذلِكَ ، ثُمَّ تُؤْخَذُ الأعمالُ علَى حَسَبِ ذلكَ"],"grade":"صحيح","narrator":"تميم الداري","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (1426)، وأحمد (16954)، والحاكم (966) باختلاف يسير.","bab":"زكاة › فرض الزكاة","dorar":"CZKWHWzO"},{"id":"س-06256","fp":"6209759024ea","stateId":425,"easy":"إذا وُجد لك تطوع ← تتم فريضتك من تطوعك","cause":"فإن وُجِدَ لَهُ تطوُّعٌ","result":"تمَّتِ الفريضةُ منَ التَّطوُّعِ","explicit":true,"otherNeedIds":[65],"ref":"الترغيب والترهيب 1/187","srcLabel":"الترغيب والترهيب","text":["إنَّ أوَّلَ ما افتَرضَ اللَّهُ على النَّاسِ من دينِهِمُ الصَّلاةُ ، وآخرَ ما يبقى الصَّلاةُ ، وأوَّلَ ما يحاسبُ بِهِ الصَّلاةُ ، ويقولُ اللَّهُ انظُروا في صلاةِ عبدي . فإن كانت تامَّةً كُتِبت تامَّةً ، وإن كانت ناقصةً يقولُ : انظُروا هل لعبدي تطوُّعٍ ؟ ",["فإن وُجِدَ لَهُ تطوُّعٌ",1]," ",["تمَّتِ الفريضةُ منَ التَّطوُّعِ",2]," ، ثمَّ قالَ : انظُروا هل زَكاتُهُ تامَّةٌ ؟ فإن كانت تامَّةً كُتِبت تامَّةً ، وإن كانت ناقِصةً قالَ : انظروا هل لَهُ صدقةٌ ؟ فإن كانت لَهُ صدقة تمَّت له زَكاتُهُ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"nQR3w5rf"},{"id":"س-06445","fp":"ab5c493220f9","stateId":425,"easy":"إذا سجدت فاعتمد على راحتيك وجافِ ذراعيك ← يسجد كل عضو منك","cause":"لا تبسُطْ ذراعَيْك إذا صلَّيْتَ كبَسْطِ السَّبُعِ وادَّعِمْ على راحتَيْكَ وجافِ عن ضَبْعَيْك","result":"فإنَّك إذا فعَلْتَ ذلك سجَد كلُّ عضوٍ منك","explicit":true,"ref":"صحيح ابن حبان 1914","srcLabel":"الحاكم","text":[["لا تبسُطْ ذراعَيْك إذا صلَّيْتَ كبَسْطِ السَّبُعِ وادَّعِمْ على راحتَيْكَ وجافِ عن ضَبْعَيْك ",1],["فإنَّك إذا فعَلْتَ ذلك سجَد كلُّ عضوٍ منك",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن خزيمة (645)، والطبراني (13/106) (13757)، والحاكم (827) باختلاف يسير","bab":"صلاة › صفة صلاة النبي صلى الله عليه وسلم","dorar":"t3En262j"},{"id":"س-06530","fp":"2493aa8212fb","stateId":425,"easy":"إذا صليت صلاة في إثر صلاة لا لغو بينهما ← تُكتب في عليين","cause":"صَلاةٌ في دُبُرِ صَلاةٍ -قال عبدُ اللهِ بنُ أحمدَ: قال أبي: وقال غيرُه: في إثرِ صَلاةٍ- لا لَغوَ بيْنَهما","result":"كِتابٌ في عِلِّيِّينَ","explicit":true,"otherNeedIds":[68],"ref":"تخريج المسند لشعيب 22273","srcLabel":"أبو داود","text":[["صَلاةٌ في دُبُرِ صَلاةٍ -قال عبدُ اللهِ بنُ أحمدَ: قال أبي: وقال غيرُه: في إثرِ صَلاةٍ- لا لَغوَ بيْنَهما",1],"، ",["كِتابٌ في عِلِّيِّينَ",2],"."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1288)، وأحمد (22273) واللفظ له","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"ru8YjlNn"},{"id":"س-07169","fp":"8729add4c3b8","stateId":425,"easy":"إذا صليت قائماً ← فهو أفضل","cause":"مَن صَلَّى قائِمًا","result":"فهو أفضَلُ","explicit":true,"ref":"صحيح البخاري 1116","srcLabel":"أبو داود","text":["سَألتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم عن صَلاةِ الرَّجُلِ وهو قاعِدٌ، فقال: ",["مَن صَلَّى قائِمًا ",1],["فهو أفضَلُ، ",2],"ومَن صَلَّى قاعِدًا فلَه نِصفُ أجرِ القائِمِ، ومَن صَلَّى نائِمًا فلَه نِصفُ أجرِ القاعِدِ. قال أبو عَبد اللهِ: ‌نائِمًا ‌عِندي ‌مُضطَجِعًا ‌ها‌هُنا."],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"[صحيح]","takhrij":"أخرجه الترمذي (371)، وابن ماجه (1231)، باختلاف يسير، وأبو داود (951)، بلفظ مقارب.","bab":"علم › حسن السؤال ونصح العالم","dorar":"7L9WUmLZ"},{"id":"س-07170","fp":"2e8b1a561a78","stateId":425,"easy":"إذا صليت قاعداً (في النافلة) ← فلك نصف أجر القائم","cause":"ومَن صَلَّى قاعِدًا","result":"فلَه نِصفُ أجرِ القائِمِ","explicit":true,"ref":"صحيح البخاري 1116","srcLabel":"أبو داود","text":["سَألتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم عن صَلاةِ الرَّجُلِ وهو قاعِدٌ، فقال: مَن صَلَّى قائِمًا فهو أفضَلُ، ",["ومَن صَلَّى قاعِدًا ",1],["فلَه نِصفُ أجرِ القائِمِ، ",2],"ومَن صَلَّى نائِمًا فلَه نِصفُ أجرِ القاعِدِ. قال أبو عَبد اللهِ: ‌نائِمًا ‌عِندي ‌مُضطَجِعًا ‌ها‌هُنا."],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"[صحيح]","takhrij":"أخرجه الترمذي (371)، وابن ماجه (1231)، باختلاف يسير، وأبو داود (951)، بلفظ مقارب.","bab":"علم › حسن السؤال ونصح العالم","dorar":"7L9WUmLZ"},{"id":"س-03710","fp":"4b3f024a627f","stateId":425,"easy":"إذا اجتهدت فأعدت الصلاة احتياطاً ← لك الأجر مرتين","cause":"فَأَعادَ أَحَدُهُما الصَّلاةَ والوُضوءَ","result":"لَكَ الأَجْرُ مَرَّتَيْنِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 644","srcLabel":"أبو داود","text":["خَرَجَ رَجُلانِ في سَفَرٍ، فَحَضَرَتِ الصَّلاةُ وليس مَعَهُما ماءٌ فَتَيَمَّما صَعيدًا طَيِّبًا، فَصَلَّيا، ثُمَّ وَجَدا الماءَ في الوَقْتِ، ",["فَأَعادَ أَحَدُهُما الصَّلاةَ والوُضوءَ",1]," ولمْ يُعِدِ الآخَرُ، ثُمَّ أَتَيا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فَذَكَرا ذلك له، فقالَ للَّذي لمْ يُعِدْ: «أَصَبْتَ السُّنَّةَ، وأَجْزَأَتْكَ صَلاتُكَ»، وقالَ للَّذي تَوَضَّأَ وأَعادَ: «",["لَكَ الأَجْرُ مَرَّتَيْنِ",2],"»."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (338)، والدارمي (771) كلاهما بلفظه، والنسائي (433) بنحوه.","bab":"اعتصام بالسنة › لزوم السنة","dorar":"hbPEnaR6","merged":3,"otherRefs":["الفتح الرباني 5/2617 (صحيح)","فتاوى نور على الدرب لابن باز 5/349 (صحيح)"]},{"id":"س-07106","fp":"32b5df64948a","stateId":425,"easy":"إذا سجدت ولم تعقص شعرك ← فلك بكل شعرة أجر","cause":"فلا تعقِصْ شعرَكَ فإنَّ شعرَكَ يسجدُ معَكَ","result":"ولَك بِكلِّ شعرةٍ أجرٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"نيل الأوطار 2/387","srcLabel":"نيل الأوطار","text":["عن عبدِ اللَّهِ بنِ مسعودٍ أنَّهُ دخلَ المسجدَ فرأى فيهِ رجلًا يصلِّي عاقِصًا شعرَهُ فلمَّا انصرفَ قالَ عبدُ اللَّهِ: إذا صلَّيتَ ",["فلا تعقِصْ شعرَكَ فإنَّ شعرَكَ يسجدُ معَكَ",1],"، ",["ولَك بِكلِّ شعرةٍ أجرٌ",2],"، فقالَ الرَّجل: إنِّي أخافُ أن يتتَرَّبَ فقال: تتريبُهُ خيرٌ لَكَ"],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"علم › تعليم الناس وفضل ذلك","dorar":"rrmT6lPw","merged":2,"otherRefs":["مجمع الزوائد 2/128 (حسن)"]},{"id":"س-06650","fp":"02c0e1a81914","stateId":425,"easy":"إذا أشرت بيدك في الصلاة (في التشهد) ← تُكتب لك بكل إصبع حسنة أو درجة","cause":"يُكتَبُ بكُلِّ إشارةٍ أشارها الرَّجُلُ بيَدِه في الصَّلاةِ","result":"بكُلِّ أصبَعٍ حَسَنةٌ أو دَرَجةٌ","explicit":true,"otherNeedIds":[47],"ref":"سبل الهدى والرشاد 8/112","srcLabel":"الطبراني","text":["«",["يُكتَبُ بكُلِّ إشارةٍ أشارها الرَّجُلُ بيَدِه في الصَّلاةِ",1]," ",["بكُلِّ أصبَعٍ حَسَنةٌ أو دَرَجةٌ",2],"»"],"grade":"حسن","narrator":"عقبة بن عامر-","muhaddith":"إسناده جيد.","takhrij":"أخرجه الطبراني في ((الكبير)) (17/ 297) (819)، وابن قطلوبغا في ((مسند عقبة بن عامر)) (207)، وحرب الكرماني في ((مسائله)) (748) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"SvjhKSTe"},{"id":"س-06444","fp":"2f6677e36854","stateId":425,"easy":"إذا زدت في القراءة على الفاتحة ← فهو أفضل","cause":"ومَن زادَ","result":"فهو أفضَلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح مسلم 396","srcLabel":"متفق عليه","text":["في كُلِّ صَلاةٍ قِراءةٌ، فما أسمعَنَا النَّبيُّ صلَّى اللهُ عليه وسلَّم أسمَعناكُم، وما أخفى مِنَّا أخفَيناه مِنكُم، ومَن قَرَأ بأُمِّ الكِتابِ فقد أجزَأَت عنه، ",["ومَن زادَ ",1],["فهو أفضَلُ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (772)، ومسلم (396).","bab":"صلاة › صفة صلاة النبي صلى الله عليه وسلم","dorar":"RMeYcKY1"},{"id":"س-06612","fp":"d5d23b9e816d","stateId":425,"easy":"إذا صليت وأصلحت ذات البين وحسن خلقك ← فهو أفضل ما عمل ابن آدم","cause":"الصلاةِ ، وصلاحِ ذاتِ البَيْنِ ، وخُلُقٍ حَسَنٍ","result":"ما عمِلَ ابنُ آدمَ شيئًا أفضلَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الجامع 5645","srcLabel":"البخاري","text":[["ما عمِلَ ابنُ آدمَ شيئًا أفضلَ",2]," من ",["الصلاةِ ، وصلاحِ ذاتِ البَيْنِ ، وخُلُقٍ حَسَنٍ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((التاريخ الكبير)) (1/63)، والبيهقي في ((شعب الإيمان)) (11091)، وابن  عساكر في ((تاريخ دمشق)) (52/266)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"Re6SJbrY"},{"id":"س-01676","fp":"9792e79e3916","stateId":425,"easy":"إذا صليت ← فالصلاة خير موضوع، فاستكثر","cause":"فما الصَّلاةُ","result":"خيرٌ موضوعٌ استكثِرْ أو استَقِلَّ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-06514","ref":"النوافح العطرة 227","text":["قُلِ الحقَّ وإن كان مُرًّا [يعني حديث: دخَلتُ علَى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وهو في المسجِدِ جالِسٌ، فاغتَنَمتُ خلوتَهُ، وحدَهُ، فجلَستُ إليهِ، فقالَ : أبا ذَرٍّ ! إن لِلمَسجِد تَحيَّةً، وإنَّ تحيَّتَهُ ركعتان فقُم فاركَعهما، قالَ : فقُمت فركَعتُها ثم عُدتُ فجلَستُ إليهِ، فقُلتُ : يا رسولَ اللهِ ! إنَّكَ أمَرتَني بالصَّلاةِ ",["فما الصَّلاةُ",1]," ؟ قال : ",["خيرٌ موضوعٌ استكثِرْ أو استَقِلَّ",2],". قلتُ : يا رسولَ اللهِ ! فأيُّ الأعمالِ أفضَلُ ؟ قال : إيمانٌ باللَّهِ عزَّ وجلَّ، وجهادٌ في سبيلِهِ، قال : قلتُ : يا رسولَ اللهِ ! فأيُّ المؤمنينَ أكمَلُهم إيمانًا ؟ قالَ : أحسَنُهُم خُلُقًا. قالَ : قلتُ : يا رسولَ اللَّهِ ! فأيُّ المؤمنينَ أسلَمُ ؟ قالَ : مَن سلِمَ النَّاسُ من لسانِهِ ويدِهِ. قال : قلتُ : يا رسولَ اللَّهِ ! فأيُّ الهجرةِ أفضَلُ ؟ قال : مَن هجرَ السَّيِّئاتِ. قالَ : قُلتُ : يا رسولَ اللهِ ! فأيُّ الصَّلاةِ أفضَلُ ؟ قال : طولُ القنوتِ . قال : قلتُ : يا رسولَ اللهِ ! فما الصِّيامُ ؟ قالَ : فرضٌ مَجزيٌّ ، وعندَ اللهِ أضعافٌ كثيرةٌ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ الجهادِ أفضَلُ ؟ قالَ : مَن عُقِرَ جوادُهُ وأهريقَ دمُهُ. قال : قُلتُ : يا رسولَ اللهِ ! فأيُّ الرِّقابِ أفضَلُ ؟ قالَ : أغلاها ثَمنًا وأنفَسُها عندَ ربِّها. قالَ : قلتُ : يا رسولَ اللهِ ! فأيُّ الصَّدقةِ أفضَلُ ؟ قال : جُهدٌ مِن مُقِلٍّ يُسَرُّ إلى فقيرٍ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ آيةٍ مِمَّا أنزلَ اللهُ عزَّ وجلَّ عليكَ أعظَمُ ؟ قال : آيةُ الكُرسيِّ. ثُمَّ قالَ : يا أبا ذَرٍّ ! ما السَّماواتُ السَّبعُ معَ الكُرسيِّ إلا كَحلقَةٍ مُلقاةٍ بأرضِ فلاةٍ، وفَضلُ العَرشِ على الكُرسيِّ كفَضلِ الفَلاةِ علَى الحَلقَةِ. قلتُ : يا رسولَ اللهِ ! كم الأنبياءُ ؟ قال : مائةُ ألفٍ وأربعةٌ وعِشرونَ ألفًا. قلتُ : يا رسولَ اللهِ ! كم الرُّسلِ ؟ قالَ : ثلاثُمائةٍ وثلاثَةُ عشرَ جَمًّا غفيرًا. قلتُ : كثيرٌ طيِّبٌ، قلتُ : يا رسولَ اللهِ ! مَن كان أوَّلُهمْ ؟ قال : آدَمُ. قلتُ : يا رسولَ اللهِ ! أنَبيٌّ مُرسَلٌ ؟ قال : نعَم، خلقَهُ اللهُ بيدِهِ، ونفخَ فيهِ مِن روحِهِ، ثُمَّ سوَّاهُ قِبَلًا. وقال أحمدُ بنُ أنَسٍ ثُمَّ كلَّمهُ قِبَلًا. ثُمَّ قالَ : يا أبا ذَرٍّ ! أربعةٌ سُريانيُّونَ؛ آدَمُ، وشيثُ، وخَنوخُ - وهو إدريسُ، وهم أوَّلُ مَن خطَّ بالقلَمِ - ونوحٌ. وأربعةٌ من العَربِ؛ هودٌ، وصالِحٌ، وشُعَيبٌ، ونبيُّكَ يا أبا ذَرٍّ. قال : قلتُ : يا رسولَ اللهِ ! كَم كتابٌ أنزلَهُ اللَّهُ تعالى ؟ قال : مائةُ كتابٍ وأربعةُ كتُبٍ، أنزلَ علَى شيثَ خَمسونَ صحيفَةً، وأنزلَ علَى خَنوخَ ثلاثونَ صَحيفةً، وأنزلَ على إبراهيمَ عشرَ صحائفَ، وأنزلَ على موسَى قبلَ التَّوراةِ عَشرَ صحائفَ، وأنزلَ التَّوراةَ والإنجيلَ والزَّبورَ والفُرقانَ. قال : قلتُ : يا رسولَ اللهِ ! فَما كانَت صُحفُ إبراهيمَ ؟ قالَ : كانَت أمثالًا كلُّها : أيُّها الملِكُ المسلَّطُ المبتَلَى المغرورُ، فإنِّي لم أبعثْكَ لتجمَعَ الدُّنيا بعضَها إلى بعضٍ، ولكن بعثتُكَ لترُدَّ عنِّي دعوةَ المظلومِ، فإنِّي لا أردُّها ولَو كانَت مِن كافِرٍ. وكانَت فيها أمثالٌ : علَى العاقِلِ ما لَم يكُن مغلوبًا علَى عقلِهِ أن تكونَ له ساعاتٌ؛ ساعَةٌ يُناجي فيها ربَّهُ عزَّ وجلَّ، وساعةٌ يحاسِبُ فيها نفسَهُ، وساعَةٌ يفكِّرُ فيها في صُنعِ اللَّهِ عزَّ وجلَّ، وساعةٌ يخلو فيها بحاجتِهِ من المطعَمِ والمشرَبِ، وعلى العاقلِ أن لا يكون ظاعِنًا إلَّا لثلاثٍ؛ تزوُّدٍ لمعادٍ، أو مرمَّةٍ لمعاشٍ، أو لذَّةٍ في غيرِ محرَّمٍ، وعلى العاقِلِ أن يكونَ بصيرًا بزمانِهِ، مقبِلًا على شأنِهِ، حافِظًا للسانِهِ، ومن حسَبَ كلامَهُ من عمَلِهِ قلَّ كلامُهُ إلا فيما يعنيهِ. قلتُ : يا رسولَ اللَّهِ ! فما كان صحُفُ موسَى عليهِ السَّلامُ ؟ قال : كانَت عبرًا كلَّها، عجبتُ لمن أيقنَ بالموتِ ثُمَّ هو يفرَحُ، عجبتُ لمن أيقنَ بالنَّارِ وهو يضحَكُ، عجبتُ لمن أيقنَ للقدرِ ثم هو ينصَبُ، عجبتُ لمن رأى الدُّنيا وتقلُّبَها ثُمَّ اطمأنَّ إليها، عجِبتُ لمن أيقنَ بالحسابِ غدًا ثُمَّ لا يعمَلُ. قلتُ : يا رسولَ اللهِ ! أوصِني. قال : أوصيكَ بتقوى اللهِ فإنَّهُ رأسُ الأمرِ كلِّهِ، قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بتلاوَةِ القرآنِ فإنَّهُ نور لكَ في الأرضِ وذكرٌ لكَ في السَّماءِ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : إيَّاكَ وكثرةَ الضَّحِكِ فإنَّهُ يُميتُ القَلبَ، ويَذهَبُ بنورِ الوَجهِ، قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : عليكَ بالصَّمتِ إلَّا مِن خيرٍ، فإنَّهُ مطردَةٌ للشَّيطانِ عنكَ، وعونٌ لكَ علَى أمر دينِكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بالجهادِ فإنَّهُ رهبانيَّةُ أمَّتي. قلتُ : يا رسولَ اللهِ ! زِدني. قال : حبُّ المساكينِ وجالِسهُم. قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : انظُر إلى مَن تحتَكَ ولا تنظُر إلى مَن فوقكَ فإنَّهُ أجدَرُ أن لا تَزدَري نِعمةَ اللهِ عندكَ. قلتُ : زِدني يا رسولَ اللهِ ! قال : صِلْ قرابَتَكَ وإن قَطعوكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : لا تَخَف في اللَّهِ تعالى لَومَةَ لائمٍ. قلتُ : يا رسولَ اللهِ ! زِدني. قالَ : قُل الحقَّ وإن كان مُرًّا. قلتُ : يا رسولَ اللهِ ! زِدني. قال : يردُّكَ عن النَّاسِ ما تعرفُ من نفسِكَ، ولا تجِد عليهِم فيما تأتي، وكفَى به عيبًا أن تعرِفَ من النَّاسِ ما تجهَلُ من نفسِكَ، أو تجِدُ عليهِم فيما تأتي. ثُمَّ ضربَ بيدِهِ علَى صدري، فقالَ : يا أبا ذَرٍّ ! لا عقلَ كالتَّدبيرِ، ولا ورعَ كالكَفِّ، ولا حسَبَ كحُسنِ الخُلُقِ، قلتُ : يارسولَ اللهِ ! هل لي في الدُّنيا شَيءٌ مِمَّا أنزلَ اللهُ عليكَ مِمَّا كان في صحُفِ إبراهيمَ وموسَى ؟ قال : يا أبا ذَرٍّ ! اقرَأ : ? قَد أفلَحَ مَن تزَكَّى? إلى آخرِ السُّورَةِ]"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مطولاً أحمد (21415)، والبزار (3966) باختلاف يسير، وابن حبان (361) واللفظ له","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"wZID7EAR","merged":2,"otherRefs":["تحفة المحتاج 1/422 (صحيح)"]},{"id":"س-02347","fp":"e998cc987def","stateId":425,"easy":"إذا أشرت بيدك في صلاتك (رفع اليدين) ← تُكتب لك عشر حسنات","cause":"في كلِّ إشارةٍ يُشيرُ الرجلُ [ بيده ] في صلاتِه","result":"عشرُ حسناتٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"السلسلة الصحيحة 3286","srcLabel":"الطبراني","text":["يُكتَبُ ",["في كلِّ إشارةٍ يُشيرُ الرجلُ [ بيده ] في صلاتِه",1]," ",["عشرُ حسناتٍ",2]," ؛ كلُّ إصبعٍ حسنةٌ"],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني (17/ 297) (819) بلفظه والديلمي (4/ 344) مختصرا","bab":"إحسان › الحسنات والسيئات","dorar":"wY5kwhF9"},{"id":"س-06304","fp":"93150c2a1253","stateId":426,"easy":"إذا مشيت إلى الصلاة ← فكل خطوة صدقة","cause":"وَكُلُّ خطوةٍ تمشي بِها إلى الصَّلاةِ","result":"صدقةٌ","explicit":true,"ref":"صحيح ابن خزيمة 3/ 24","srcLabel":"متفق عليه","text":["كلُّ نفسٍ كُتِبَ عليها الصَّدقةُ كلَّ يومٍ طلَعت فيهِ الشَّمسُ، فمِن ذلِكَ: أن تعدلَ بينَ الاثنينِ صدقةٌ، وأن تعينَ الرَّجلَ على دابَّتِهِ وتحملَهُ عليها صدقةٌ، وتُميطُ الأذى عَنِ الطَّريقِ صدقةٌ، ومن ذلِكَ أن تُعينَ الرَّجلَ على دابَّتِهِ وتحملَهُ عليها، وترفعَ متاعَهُ علَيها صدقةٌ، والكلمةُ الطَّيِّبةُ صدقةٌ، ",["وَكُلُّ خطوةٍ تمشي بِها إلى الصَّلاةِ",1]," ",["صدقةٌ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (2989)، ومسلم (1009)، وابن حبان (3381) باختلاف يسير.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"93eHCYot"},{"id":"س-06483","fp":"ebe4e11294db","stateId":426,"easy":"إذا أحسنت الطهور ثم عمدت إلى المسجد ← يكتب الله لك بكل خطوة حسنة ويرفعك درجة ويحط خطيئة","cause":"وما مِن رَجُلٍ يَتَطَهَّرُ فيُحسِنُ الطُّهورَ، ثُمَّ يَعمِدُ إلى مَسجِدٍ مِن هذه المَساجِدِ","result":"إلَّا كَتَبَ اللهُ له بكُلِّ خَطوةٍ يَخطوها حَسَنةً، ويَرفَعُه بها دَرَجةً، ويَحُطُّ عنه بها سَيِّئةً","explicit":true,"similar":["س-03397","س-06997","س-01457","س-03357","س-07966","س-03373","س-01470"],"otherNeedIds":[47,11],"ref":"صحيح مسلم 654","srcLabel":"متفق عليه","text":["عَن عبدِ اللهِ، قال: مَن سَرَّه أن يَلقى اللَّهَ غَدًا مُسلِمًا فليُحافِظْ على هؤلاء الصَّلَواتِ حَيثُ يُنادى بهِنَّ؛ فإنَّ اللَّهَ شَرَعَ لنَبيِّكُم صلَّى اللهُ عليه وسلَّم سُنَنَ الهُدى، وإنَّهُنَّ مَن سُنَنَ الهُدى، ولو أنَّكُم صَلَّيتُم في بُيوتِكُم كما يُصَلِّي هذا المُتَخَلِّفُ في بَيتِه لَتَرَكتُم سُنَّةَ نَبيِّكُم، ولو تَرَكتُم سُنَّةَ نَبيِّكُم لَضَلَلتُم، ",["وما مِن رَجُلٍ يَتَطَهَّرُ فيُحسِنُ الطُّهورَ، ثُمَّ يَعمِدُ إلى مَسجِدٍ مِن هذه المَساجِدِ، ",1],["إلَّا كَتَبَ اللهُ له بكُلِّ خَطوةٍ يَخطوها حَسَنةً، ويَرفَعُه بها دَرَجةً، ويَحُطُّ عنه بها سَيِّئةً",2],"، ولقد رَأيتُنا وما يَتَخَلَّفُ عَنها إلَّا مُنافِقٌ مَعلومُ النِّفاقِ، ولقد كان الرَّجُلُ يُؤتى به يُهادى بينَ الرَّجُلَينِ حتَّى يُقامَ في الصَّفِّ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"5xlNY4cG"},{"id":"س-06707","fp":"b9ac1000d1e5","stateId":426,"easy":"إذا كنت أبعد عن المسجد ممشى وانتظرت الصلاة مع الإمام ← فأنت أعظم الناس أجراً","cause":"أجرًا في الصَّلاةِ أبعَدُهم إليها مَمشًى، فأبعَدُهم، والذي يَنتَظِرُ الصَّلاةَ حتَّى يُصَلِّيَها مع الإمامِ أعظَمَ أجرًا مِنَ الذي يُصَلِّيَها ثُمَّ يَنامُ","result":"إنَّ أعظَمَ النَّاسِ","explicit":true,"ref":"صحيح مسلم 662","srcLabel":"البخاري","text":[["إنَّ أعظَمَ النَّاسِ",2],[" أجرًا في الصَّلاةِ أبعَدُهم إليها مَمشًى، فأبعَدُهم، والذي يَنتَظِرُ الصَّلاةَ حتَّى يُصَلِّيَها مع الإمامِ أعظَمَ أجرًا مِنَ الذي يُصَلِّيَها ثُمَّ يَنامُ",1],". وفي رِوايةِ أبي كُرَيبٍ: حتَّى يُصَلِّيَها مع الإمامِ في جَماعةٍ."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (651) باختلاف يسير","bab":"صلاة الجماعة والإمامة › فضل صلاة الجماعة","dorar":"Mp6M0hIh"},{"id":"س-02850","fp":"6e8ed890db5b","stateId":426,"easy":"إذا تطهرت ثم مشيت إلى المسجد ← يكتب لك كاتبك بكل خطوة عشر حسنات","cause":"إذا تَطهَّر الرَّجُلُ، ثمَّ مَرَّ إلى المَسجِدِ فيَرعَى الصَّلاةَ","result":"كَتَب له كاتِبُه -أو: كاتِباه بكلِّ خُطوةٍ يَخطوها إلى المَسجِدِ عَشْرَ حَسَناتٍ، والقاعِدُ يَرعَى الصَّلاةَ كالقانِتِ، ويُكتَبُ منَ المُصَلِّين من حينِ يَخرُجُ من بَيتِه حتَّى يَرجِعَ","explicit":true,"ref":"المستدرك على الصحيحين 861","srcLabel":"مسلم","text":[["إذا تَطهَّر الرَّجُلُ، ثمَّ مَرَّ إلى المَسجِدِ فيَرعَى الصَّلاةَ ",1],["كَتَب له كاتِبُه -أو: كاتِباه بكلِّ خُطوةٍ يَخطوها إلى المَسجِدِ عَشْرَ حَسَناتٍ، والقاعِدُ يَرعَى الصَّلاةَ كالقانِتِ، ويُكتَبُ منَ المُصَلِّين من حينِ يَخرُجُ من بَيتِه حتَّى يَرجِعَ",2],"."],"grade":"صحيح","narrator":"عقبة بن عامر الجهني","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه ابن خزيمة (1492)، والبيهقي (5038) كلاهما بلفظه، وابن حبان (2045) ببعض لفظه.","bab":"إيمان › الوعد","dorar":"tiLvmaQX"},{"id":"س-03397","fp":"30bf3f6ac154","stateId":426,"easy":"إذا خطوت إلى الصلاة ← تُكتب لك بكل خطوة حسنة وتُمحى سيئة","cause":"كلُّ خطوةٍ يخطوها أحدُكم إلى الصلاةِ","result":"يُكْتَبُ لَهُ [ بها ] حسنةٌ ويُمْحَى عنه بِها سَيِّئَةٌ","explicit":true,"repOf":"س-06483","otherNeedIds":[11],"ref":"صحيح الجامع 4521","text":[["كلُّ خطوةٍ يخطوها أحدُكم إلى الصلاةِ",1]," ",["يُكْتَبُ لَهُ [ بها ] حسنةٌ ويُمْحَى عنه بِها سَيِّئَةٌ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (7801) باختلاف يسير، وأخرجه مسلم (666) بمعناه مطولاً","bab":"استغفار › أسباب المغفرة","dorar":"bY9zzo5A"},{"id":"س-06587","fp":"92f6bae862ad","stateId":426,"easy":"إذا رجعت من المسجد ← يُكتب لك أجر خطاك","cause":"في الرجوعِ","result":"أجرُ الخطا يكتبُ","explicit":true,"ref":"فتح الباري لابن حجر 2/548","srcLabel":"مسلم","text":[["أجرُ الخطا يكتبُ",2]," ",["في الرجوعِ",1]],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"ثابت","takhrij":"أخرجه مسلم (663)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"gakeTFeO"},{"id":"س-06997","fp":"2a0e3c6d3520","stateId":426,"easy":"إذا أحسنت الوضوء ثم مشيت إلى الصلاة ← يكتب الله لك بكل خطوة حسنة أو يرفعك درجة","cause":"وما من عبدٍ مسلمٍ يتوضأُ فيحسنُ الوضوءَ ، ثمَّ يمشي إلى صلاةٍ","result":"إلَّا كتب اللهُ عزَّ وجلَّ له بكلِّ خطوةٍ يخطوها حسنةً ، أو يرفعَ له بها درجةً ، أو يكفرَّ عنه بها خطيئةً","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"repOf":"س-06483","otherNeedIds":[47,11],"ref":"صحيح النسائي 848","text":["من سرَّه أنْ يلقَى اللهَ عزَّ وجلَّ غدًا مسلمًا ، فليحافظْ على هؤلاءِ الصلواتِ الخمسِ حيث ينادَى بهنَّ ، فإنَّ اللهَ عزَّ وجلَّ شرَعَ لنبيِّهِ صلَّى اللهُ عليه وسلم سنَنَ الهدَى ، وإنهُ من سننِ الهدَى ، وإني لا أحسبُ منكم أحدًا ، إلَّا له مسجدٌ يصلِّي فيه في بيتهِ ، فلو صليتُمْ في بيوتِكم وتركتُمْ مساجدَكُم ، لتركتُمْ سنَّةَ نبيِّكُم ، ولو تركتُمْ سنَّةَ نبيِّكُم لضللتُمْ ، ",["وما من عبدٍ مسلمٍ يتوضأُ فيحسنُ الوضوءَ ، ثمَّ يمشي إلى صلاةٍ ، ",1],["إلَّا كتب اللهُ عزَّ وجلَّ له بكلِّ خطوةٍ يخطوها حسنةً ، أو يرفعَ له بها درجةً ، أو يكفرَّ عنه بها خطيئةً",2]," ، ولقد رأيتُنا نقارِبُ بين الخُطا ، ولقد رأيتُنا وما يتخلفُ عنها إلَّا منافقٌ معلومٌ نفاقُه ، ولقد رأيتُ الرجلَ يهادَى بين الرجلينِ حتَّى يُقامَ في الصفِّ ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه مسلم (654) باختلاف يسير","bab":"علم › الحث على الأخذ بالسنة","dorar":"gMR7YFhp"},{"id":"س-02274","fp":"3d79d17d937b","stateId":426,"easy":"إذا بعُد بيتك عن المسجد فمشيت إليه ← تُكتب لك آثارك","cause":"أنْ يَتَحَوَّلوا مِن ديارِهم إلى قُربِ المسجِدِ","result":"ألَا تَحتسِبون آثارَكم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-07974"],"ref":"تخريج المسند لشعيب 12876","srcLabel":"البخاري","text":["أنَّ بَني سَلِمةَ، أرادوا ",["أنْ يَتَحَوَّلوا مِن ديارِهم إلى قُربِ المسجِدِ",1],"، فكَرِهَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، أنْ يَعْرى المسجِدُ، فقال: يا بَني سَلِمةَ، ",["ألَا تَحتسِبون آثارَكم",2],"؟ فأقاموا، قال عبدُ اللهِ بنُ أحمدَ: قال أَبِي: أخطَأَ فيه يَحيى بنُ سعيدٍ، وإنِّما هو: أنْ تَعرَى المدينةُ، فقال يَحيى: المسجِدُ. وضَرَبَ عليه أبي هاهُنا، وقد حدَّثَنا به في كِتابِ يَحيى بنِ سعيدٍ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (656)، وابن ماجه (784)، وأحمد (12876) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"wiJbRSx4","merged":2,"otherRefs":["تخريج المسند لشعيب 13770 (صحيح)"]},{"id":"س-02082","fp":"708703ba82fa","stateId":426,"easy":"إذا خطوت إلى الصلاة خطوة ← يكتب الله لك بها أجراً","cause":"وما من عبدٍ يخطو إلى الصَّلاةِ خطوةً","result":"إلَّا كتبَ اللَّهُ لهُ بها أجرًا","explicit":true,"ref":"مجمع الزوائد 2/33","srcLabel":"مسلم","text":["أنَّ بني سلمةَ قالوا يا رسولَ اللَّهِ أنبيعُ دورَنا ونتحوَّلُ إليكَ فإنَّ بينَنا وبينَكَ وادٍ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ اثبتوا فإنَّكم أوتادُها ",["وما من عبدٍ يخطو إلى الصَّلاةِ خطوةً ",1],["إلَّا كتبَ اللَّهُ لهُ بها أجرًا",2]],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"رجاله ثقات","takhrij":"أخرجه مسلم (664) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"XY8OqCmt"},{"id":"س-02882","fp":"759191e06935","stateId":426,"easy":"إذا بعُد بيتك عن المسجد فاحتسبت ← لك ما نويت","cause":"ما أُحِبُّ أنَّ طُنُبي بطُنُبِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ","result":"لكَ ما نوَيْتَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 21215","srcLabel":"مسلم","text":["كان رَجُلٌ يَأْتي الصَّلاةَ، فقيلَ له: لوِ اتَّخذْتَ حِمارًا يَقيكَ الرَّمْضاءَ والشوكَ والوَقَعَ، قال شُعْبةُ: وذكَرَ رابعةً، قال: مَحْلوفُه، ",["ما أُحِبُّ أنَّ طُنُبي بطُنُبِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ",1],"، فذُكِرَ ذلك للنَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقال: ",["لكَ ما نوَيْتَ",2],"، أو قال: لكَ أجْرُ ما نوَيْتَ، شُعْبةُ يقولُ ذلك."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (663)، وأحمد (21215) واللفظ له","bab":"إيمان › الوعد","dorar":"3THGtPa7"},{"id":"س-00541","fp":"9dbc0b059ef7","stateId":426,"easy":"إذا توضأت فأتيت المسجد ← تُكتب لك بكل خطوة عشر حسنات","cause":"إذا تَوضَّأَ الرجُلُ فأَتى المَسجِدَ","result":"كَتَب اللهُ له بكلِّ خَطْوةٍ يَخْطوها عَشْرَ حسَناتٍ، فإذا صَلَّى في المَسجِدِ ثمَّ قَعَد فيه، كان كالصائمِ القانِتِ حتى يَرجِعَ","explicit":true,"ref":"تخريج المسند لشعيب 17456","srcLabel":"أحمد","text":[["إذا تَوضَّأَ الرجُلُ فأَتى المَسجِدَ، ",1],["كَتَب اللهُ له بكلِّ خَطْوةٍ يَخْطوها عَشْرَ حسَناتٍ، فإذا صَلَّى في المَسجِدِ ثمَّ قَعَد فيه، كان كالصائمِ القانِتِ حتى يَرجِعَ",2],"."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17456) واللفظ له، وابن خزيمة (1492)، وأبو يعلى (1747)","bab":"آداب عامة › ضرب الأمثال","dorar":"LBjuQVPu"},{"id":"س-01457","fp":"0fdd045366eb","stateId":426,"easy":"إذا أحسنت الوضوء ثم خرجت إلى الصلاة ← تُكتب لك بكل خطوة حسنة وتُحط سيئة","cause":"إذا تَوَضَّأَ أحَدُكم فأَحسَنَ الوُضوءَ، ثُمَّ خَرَجَ إلى الصَّلاةِ لم يَرفَعْ قَدَمَه اليُمْنى","result":"إلَّا كَتَبَ اللهُ له حَسَنةً، ولم يَضَعْ قَدَمَه اليُسْرى إلَّا حَطَّ اللهُ عَزَّ وجَلَّ عنه سَيِّئةً","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"repOf":"س-06483","otherNeedIds":[11],"ref":"الأحكام الوسطى 1/ 281","text":["عن سَعيدِ بنِ المَسَيِّبِ قالَ: وحَضَرَ رَجُلًا مِن الأنْصارِ المَوْتُ، فقالَ: إنِّي مُحَدِّثُكم حَديثًا ما أُحَدِّثُكموه إلَّا احْتِسابًا، سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولَ: \"",["إذا تَوَضَّأَ أحَدُكم فأَحسَنَ الوُضوءَ، ثُمَّ خَرَجَ إلى الصَّلاةِ لم يَرفَعْ قَدَمَه اليُمْنى ",1],["إلَّا كَتَبَ اللهُ له حَسَنةً، ولم يَضَعْ قَدَمَه اليُسْرى إلَّا حَطَّ اللهُ عَزَّ وجَلَّ عنه سَيِّئةً",2],"، فلْيُقَرِّبْ أحَدُكم أو لِيُبعِدْ، فإن أتى المَسجِدَ فصلَّى في جَماعةٍ غُفِرَ له، فإن أتى المَسجِدَ وقدْ صَلَّوا بعضًا وبَقِيَ بعضٌ صلَّى ما أَدرَكَ، وأَتَمَّ ما بَقِيَ كانَ كذلك، فإن أتى المَسجِدَ وقدْ صَلَّوا فأَتَمَّ الصَّلاةَ كانَ كذلك\"."],"grade":"صحيح","narrator":"رجل من الأنصار","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (563)،  والمروزي في ((تعظيم قدر الصلاة)) (106) والبيهقي (5075) واللفظ لهم","bab":"وضوء › فضل الوضوء","dorar":"4KmTs2TL"},{"id":"س-01904","fp":"40e3c59b49b0","stateId":426,"easy":"إذا كان بيتك أبعد عن المسجد ← فأجرك أعظم","cause":"الأبعدُ فالأبعَدُ","result":"أفضلُ أجرًا عنِ المسجِدِ","explicit":true,"similar":["س-02017"],"ref":"تخريج المسند لشاكر 16/253","srcLabel":"أحمد","text":[["الأبعدُ فالأبعَدُ",1]," ",["أفضلُ أجرًا عنِ المسجِدِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (8603)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"9trPnl0s"},{"id":"س-02017","fp":"6d093207ac09","stateId":426,"easy":"إذا كنت أبعد عن المسجد ← فأجرك أعظم","cause":"الأبعَدُ فالأبعَدُ منَ المَسجدِ","result":"أعظَمُ أجرًا","explicit":true,"repOf":"س-01904","ref":"المستدرك على الصحيحين 847","text":[["الأبعَدُ فالأبعَدُ منَ المَسجدِ ",1],["أعظَمُ أجرًا",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (556)، وابن ماجه (782)، وأحمد (9531) واللفظ لهم","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"0BssGY5d"},{"id":"س-03357","fp":"74a2d8c7c8c8","stateId":426,"easy":"إذا أحسنت الوضوء ثم خرجت إلى الصلاة ← فأنت في صلاة وبكل خطوة حسنة","cause":"من توضأ فأحسنَ الوضوءَ، ثم خرج عامدًا إلى الصلاةِ","result":"فإنه في صلاةٍ ما كان يعمدُ إلى الصلاةِ، و إنه يكتبُ له بإحدى خطوتَيه حسنةٌ و يُمحَى عنه بالأخرى سيئةٌ، فإذا سمع أحدُكم الإقامةَ فلا يَسْعَ فإنَّ أعظمَكم أجرًا أبعدُكم","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"repOf":"س-06483","otherNeedIds":[11],"ref":"صحيح الترغيب 297","text":["عن أبي هريرة رضي الله عنه قال: ",["من توضأ فأحسنَ الوضوءَ، ثم خرج عامدًا إلى الصلاةِ، ",1],["فإنه في صلاةٍ ما كان يعمدُ إلى الصلاةِ، و إنه يكتبُ له بإحدى خطوتَيه حسنةٌ و يُمحَى عنه بالأخرى سيئةٌ، فإذا سمع أحدُكم الإقامةَ فلا يَسْعَ فإنَّ أعظمَكم أجرًا أبعدُكم",2]," دارًا، قالوا : لمَ يا أبا هريرةَ ؟ قال : من أجلِ كثرةِ الخُطا \n[وفي رواية] من حين يخرجُ أحدُكم من منزلِه إلى مسجدي، فرِجلٌ تَكتُبُ له حسنةٌ، و رِجلٌ تَحطُّ عنه سيئةً، حتى يرجعَ."],"grade":"صحيح","muhaddith":"صحيح","takhrij":"أخرجه ابن خزيمة (439)، وابن حبان (1622)، والحاكم (744) مختصراً","bab":"استغفار › أسباب المغفرة","dorar":"X1eEZYr0"},{"id":"س-06462","fp":"e847cea694a1","stateId":426,"easy":"إذا مشيت إلى صلاة مكتوبة متطهراً ← فلك أجر الحاج المحرم","cause":"مَن مَشى إلى صَلاةٍ مَكتوبةٍ وهو مُتطهِّرٌ","result":"كان له كأجْرِ الحاجِّ المُحرِمِ","explicit":true,"similar":["س-06578"],"otherNeedIds":[49],"ref":"تخريج المسند لشعيب 22304","srcLabel":"أبو داود","text":[["مَن مَشى إلى صَلاةٍ مَكتوبةٍ وهو مُتطهِّرٌ، ",1],["كان له كأجْرِ الحاجِّ المُحرِمِ، ",2],"ومَن مَشى إلى سُبْحةِ الضُّحى، كان له كأجْرِ المُعتمِرِ، وصَلاةٌ على إثرِ صَلاةٍ لا لَغوَ بيْنَهما كِتابٌ في عِلِّيِّينَ، وقال أبو أُمامةَ: الغُدوُّ والرَّواحُ إلى هذه المساجدِ مِن الجِهادِ في سَبيلِ اللهِ."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (558)، وأحمد (22304) واللفظ له","bab":"صلاة › فرض الصلاة","dorar":"TkJ3OB7B"},{"id":"س-06489","fp":"d84253952655","stateId":426,"easy":"إذا أحسنت الوضوء وخرجت إلى المسجد فوجدت الناس قد صلوا ← يكتب الله لك مثل أجر من حضرها","cause":"مَن تَوضَّأ ، فأحسنَ الوُضوءَ ثمَّ خرجَ عامدًا إلى المسجدِ فوجدَ النَّاسَ قد صلَّوا","result":"كتبَ اللَّهُ لَه مثلَ أجرِ مَن حضرَها ، ولا ينقُصُ ذلِكَ مِن أجورِهِم شيئًا","explicit":true,"otherNeedIds":[49],"ref":"صحيح النسائي 854","srcLabel":"أبو داود","text":[["مَن تَوضَّأ ، فأحسنَ الوُضوءَ ثمَّ خرجَ عامدًا إلى المسجدِ فوجدَ النَّاسَ قد صلَّوا ، ",1],["كتبَ اللَّهُ لَه مثلَ أجرِ مَن حضرَها ، ولا ينقُصُ ذلِكَ مِن أجورِهِم شيئًا",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (564)، والنسائي (855) واللفظ له، وأحمد (8947).","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"DOE6akJo"},{"id":"س-06578","fp":"81b849826a08","stateId":426,"easy":"إذا خرجت من بيتك متطهراً إلى صلاة مكتوبة ← فأجرك كأجر الحاج المحرم","cause":"مَن خرَجَ من بَيتِه مُتطهِّرًا إلى صَلاةٍ مَكتوبةٍ","result":"فأجْرُه كأجْرِ الحاجِّ المُحرِمِ","explicit":true,"apply":{"k":"time","t":"عند الخروج من البيت"},"repOf":"س-06462","otherNeedIds":[49],"ref":"تخريج سنن أبي داود 558","text":["\"",["مَن خرَجَ من بَيتِه مُتطهِّرًا إلى صَلاةٍ مَكتوبةٍ؛ ",1],["فأجْرُه كأجْرِ الحاجِّ المُحرِمِ، ",2],"ومَن خرَجَ إلى تَسبيحِ الضُّحى لا يَنصِبُه إلَّا إيَّاهُ؛ فأجْرُه كأجْرِ المُعتَمِرِ، وصَلاةٌ على إثْرِ صَلاةٍ لا لَغوَ بينَهما كتابٌ في عِلِّيِّينَ\"."],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (558 ) واللفظ له، وأحمد (22304)، والطبراني في ((المعجم الأوسط)) (3262) كلاهما باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"yiDjareh"},{"id":"س-07966","fp":"a50cc98b73a0","stateId":426,"easy":"إذا خرجت من بيتك إلى المسجد ← لك بكل خطوة عشر حسنات، والقاعد فيه كالقانت","cause":"مَن خرَجَ مِن بَيتِه إلى المَسجِدِ","result":"كُتِب له بكلِّ خَطْوةٍ يَخْطوها عَشْرُ حسَناتٍ، والقاعدُ في المَسجِدِ يَنتظِرُ الصلاةَ كالقانتِ، ويُكتَبُ مِنَ المُصلِّينَ حتى يَرجِعَ إلى بَيتِه","explicit":true,"apply":{"k":"time","t":"عند الخروج من البيت"},"repOf":"س-06483","ref":"تخريج المسند لشعيب 17459","text":[["مَن خرَجَ مِن بَيتِه إلى المَسجِدِ ",1],["كُتِب له بكلِّ خَطْوةٍ يَخْطوها عَشْرُ حسَناتٍ، والقاعدُ في المَسجِدِ يَنتظِرُ الصلاةَ كالقانتِ، ويُكتَبُ مِنَ المُصلِّينَ حتى يَرجِعَ إلى بَيتِه",2],"."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17459) واللفظ له، وابن خزيمة (1492)، وأبو يعلى (1747)","bab":"مساجد ومواضع الصلاة › فضل من غدا إلى المسجد أو راح","dorar":"NUfRR3Hb"},{"id":"س-07974","fp":"a884974857a9","stateId":426,"easy":"إذا بعُد بيتك عن المسجد فلا تنتقل ← فإن آثارك تُكتب","cause":"فلا تنْتقلوا","result":"إنَّ آثارَكم تُكتبُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-02274","ref":"صحيح الجامع 1515","text":[["إنَّ آثارَكم تُكتبُ",2]," [حديث أبي سعيد الخدري: كانت بنو سلمةَ في ناحيةِ المدينةِ فأرادوا النُّقلةَ إلى قُربِ المسجدِ فنزلتْ هذه الآيةِ إِنّا نَحْنُ نُحْيِ المَوْتَى وَنَكْتُبُ مَا قَدَّمُواْ وِآثَارَهُمْ فقال رسولُ اللهِ صلى الله عليه وسلم إن آثاركُم تُكتبُ ",["فلا تنْتقلوا",1],"]        [وحديث جابر بن عبدالله: خَلَتِ البِقَاعُ حَوْلَ المَسْجِدِ، فأرَادَ بَنُو سَلِمَةَ أَنْ يَنْتَقِلُوا إلى قُرْبِ المَسْجِدِ، فَبَلَغَ ذلكَ رَسولَ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ، فَقالَ لهمْ: إنَّه بَلَغَنِي أنَّكُمْ تُرِيدُونَ أَنْ تَنْتَقِلُوا قُرْبَ المَسْجِدِ، قالوا: نَعَمْ يا رَسولَ اللهِ، قدْ أَرَدْنَا ذلكَ، فَقالَ: يا بَنِي سَلِمَةَ، دِيَارَكُمْ تُكْتَبْ آثَارُكُمْ، دِيَارَكُمْ تُكْتَبْ آثَارُكُمْ.]"],"grade":"صحيح","narrator":"أبو سعيد الخدري وجابر بن عبدالله","muhaddith":"صحيح","bab":"مساجد ومواضع الصلاة › فضل من غدا إلى المسجد أو راح","dorar":"BI6dLD7Z","merged":8,"otherRefs":["الأحاديث المختارة 12 / 67 (صحيح)","المستدرك على الصحيحين 3650 (صحيح)","صحيح أسباب النزول 196 (صحيح)","تخريج صحيح ابن حبان 2042 (صحيح)","تخريج المسند لشعيب 14992 (صحيح)","تخريج المسند لشعيب 15194 (صحيح)","صحيح مسلم 665 (صحيح)"]},{"id":"س-02848","fp":"76114c12bb7c","stateId":426,"easy":"إذا احتسبت خطاك إلى المسجد ذهاباً وإياباً ← يعطيك الله ذلك كله","cause":"لِكَيما يُكْتبَ أثَري ورجوعي إلى أَهْلي وإقبالي إليهِ","result":"أعطاكَ اللَّهُ ذلِكَ كُلَّهُ، وأعطاكَ ما احتسَبتَ أجمعَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح ابن خزيمة 3/ 29","srcLabel":"ابن ماجه","text":["كانَ رجلٌ منَ الأنصارِ بيتُهُ أقصَى بَيتٍ بالمدينةِ، فَكانَ لا تُخطئُهُ الصَّلاةُ معَ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ، فتَوجَّعتُ لَهُ، فقُلتُ: يا فلانُ، لَو إنَّكَ اشتريتَ حمارًا يَقيكَ الرَّمضَ ، ويرفعُكَ منَ الوقع، ويقيكَ هوامَّ الأرضِ، فقالَ: إنِّي واللَّهِ ما أحبُّ أنَّ بَيتيَ مطنَّبٌ ببيتِ محمَّدٍ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ: فحملتُ بِهِ حملًا حتَّى أتيتُ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ فذَكَرتُ ذلِكَ لَهُ قالَ: فدعاهُ فسألَهُ، فذَكَرَ لَهُ مثلَ ذلِكَ، وذَكَرَ أنَّهُ يرجو في أمرِهِ، فقالَ لَهُ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: إنَّ لَكَ ما احتسَبتَ، [وفي روايةٍ]: فأخبَرتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ، فسألَهُ عن ذلِكَ، فقالَ: يا نبيَّ اللَّهِ، ",["لِكَيما يُكْتبَ أثَري ورجوعي إلى أَهْلي وإقبالي إليهِ",1],"، أو كما قالَ قالَ: ",["أعطاكَ اللَّهُ ذلِكَ كُلَّهُ، وأعطاكَ ما احتسَبتَ أجمعَ",2],"، أو كما قالَ"],"grade":"صحيح","narrator":"أُبي بن كعب","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن ماجه (783)، وأبو عوانة في ((المستخرج)) (1196) باختلاف يسير.","bab":"إيمان › الوعد","dorar":"3dPYJWTi","merged":4,"otherRefs":["صحيح مسلم 663 (صحيح)","صحيح أبي داود 557 (صحيح)","تخريج صحيح ابن حبان 2041 (صحيح)"]},{"id":"س-03373","fp":"7ab55a9030ab","stateId":426,"easy":"إذا خرجت إلى المسجد ← تُكتب لك بكل خطوة حسنة وتُمحى سيئة","cause":"فإذا خرج إلى المسجدِ","result":"كُتِب له بكلِّ خطوةٍ خطاها حسنةٌ ومُحِيَ بها عنه سيئةٌ حتى يأتِيَ مقامَه","explicit":true,"repOf":"س-06483","otherNeedIds":[11],"ref":"مجمع الزوائد 1/231","text":["ما من مسلمٍ يتوضأُ للصلاةِ فيمضمضُ إلا خرج معَ قطرِ الماءِ كلُّ سيئةٍ تكلَّم بها لسانُه ولا يستنشقُ إلا خرج معَ قطرِ الماءِ كلُّ سيئةٍ وجدَ ريحَها بأنفِه ولا يغسلُ وجهَه إلا تناثر من عينَيه معَ قطرِ الماءِ كلُّ سيئةٍ نظر إليها بهما ولا يغسلُ شيئًا من يديه إلا خرج معَ قطرِ الماءِ كلُّ سيئةٍ بطش بهما ولا يغسلُ شيئًا من رجليه إلا خرج معَ قطرِ الماءِ كلُّ سيئةٍ مشَى بهما إليها ",["فإذا خرج إلى المسجدِ ",1],["كُتِب له بكلِّ خطوةٍ خطاها حسنةٌ ومُحِيَ بها عنه سيئةٌ حتى يأتِيَ مقامَه",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"رجاله موثقون","takhrij":"أخرجه البزار (9116) باختلاف يسير، والعقيلي في ((الضعفاء الكبير)) (3/133) واللفظ له، والطبراني كما في ((المعجم الأوسط)) كما في ((مجمع الزوائد)) للهيثمي (1/231) مطولاً باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"nR27mGSO","merged":2,"otherRefs":["السلسلة الصحيحة 1063 (حسن)"]},{"id":"س-01470","fp":"9257bd9980b1","stateId":426,"easy":"إذا أحسنت الوضوء ثم عمدت إلى المسجد ← تُكتب لك برجلك اليمنى حسنة وتُحط باليسرى سيئة","cause":"إنَّ العبدَ المُسلِمَ إذا توضَّأَ فأحسَنَ الوُضوءَ، ثم عَمَدَ إلى المسجِدِ","result":"لم يَرفَعْ رِجْلَه اليُمنى إلَّا كُتِبَتْ له بها حَسَنةٌ، ولم يَضَعِ اليُسرى إلَّا حُطَّتْ عنه بها خَطيئةٌ، حتى يبلُغَ المسجِدَ، فلْيَتقرَّبْ أو لِيَتباعَدْ، فإنْ أدرَكَ الصَّلاةَ في الجَماعةِ مع القَومِ غُفِرَ له","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"repOf":"س-06483","ref":"تخريج مشكل الآثار 2322","text":["عن سعيدِ بنِ المُسيِّبِ، قال: دَخَلْنا على رَجُلٍ من أصحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ منَ الأنصارِ وهو وَجِعٌ، فقال: مَن في البَيتِ؟ فقيلَ: أهلُكَ وولدُكَ وجُلساؤُكَ في المسجِدِ، قال: فأجْلِسوني، قال: فأسنَدَه ابنُه إلى صَدرِه، ثم قال: لأُحَدِّثَنَّكمُ اليومَ حديثًا ما حدَّثتُ به مُنذُ سَمِعتُه من رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ احتسابًا، وما أُحدِّثُكموهُ اليومَ إلَّا احتسابًا، سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["إنَّ العبدَ المُسلِمَ إذا توضَّأَ فأحسَنَ الوُضوءَ، ثم عَمَدَ إلى المسجِدِ؛ ",1],["لم يَرفَعْ رِجْلَه اليُمنى إلَّا كُتِبَتْ له بها حَسَنةٌ، ولم يَضَعِ اليُسرى إلَّا حُطَّتْ عنه بها خَطيئةٌ، حتى يبلُغَ المسجِدَ، فلْيَتقرَّبْ أو لِيَتباعَدْ، فإنْ أدرَكَ الصَّلاةَ في الجَماعةِ مع القَومِ غُفِرَ له",2]," ما تَقدَّمَ من ذَنْبِه، وإنْ أدرَكَ منها بعضًا وسُبِقَ ببَعضٍ، فقَضى ما فاتَه، فأحسَنَ رُكوعَه وسُجودَه كان كذلك، وإنْ جاء والقومُ قُعودٌ كان كذلك."],"grade":"حسن","narrator":"رجل من الصحابة من الأنصار","muhaddith":"رجاله ثقات رجال الصحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (2322) بلفظه، وأبو داود (563)، والبيهقي (5075) بنحوه.","bab":"وضوء › فضل الوضوء","dorar":"cr6b1WZq"},{"id":"س-05749","fp":"ba9a5b511f52","stateId":426,"easy":"إذا رجوت الأجر في خطاك ← فلك ما احتسبت","cause":"يَرْجُو في أَثَرِهِ الأجْرَ","result":"إنَّ لكَ ما احْتَسَبْتَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح الجامع 2159","srcLabel":"صحيح الجامع","text":["إنَّ لك ما احْتسبتَ [يعني حديث: كانَ رَجُلٌ مِنَ الأنْصَارِ بَيْتُهُ أَقْصَى بَيْتٍ في المَدِينَةِ، فَكانَ لا تُخْطِئُهُ الصَّلَاةُ مع رَسولِ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ، قالَ: فَتَوَجَّعْنَا له، فَقُلتُ له: يا فُلَانُ، لو أنَّكَ اشْتَرَيْتَ حِمَارًا يَقِيكَ مِنَ الرَّمْضَاءِ ، وَيَقِيكَ مِن هَوَامِّ الأرْضِ، قالَ: أَمَ وَاللَّهِ ما أُحِبُّ أنَّ بَيْتي مُطَنَّبٌ ببَيْتِ مُحَمَّدٍ صَلَّى اللَّهُ عليه وسلَّمَ، قالَ: فَحَمَلْتُ به حِمْلًا حتَّى أَتَيْتُ نَبِيَّ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ، فأخْبَرْتُهُ، قالَ: فَدَعَاهُ، فَقالَ له مِثْلَ ذلكَ، وَذَكَرَ له أنَّهُ ",["يَرْجُو في أَثَرِهِ الأجْرَ",1]," ، فَقالَ له النبيُّ صَلَّى اللَّهُ عليه وسلَّمَ: ",["إنَّ لكَ ما احْتَسَبْتَ",2],".]"],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"صحيح","bab":"رقائق وزهد › النية","dorar":"GCgs8olJ"},{"id":"س-02649","fp":"8c59118b802e","stateId":426,"easy":"إذا قاربت خطاك إلى الصلاة ← تكثر حسناتك","cause":"فقاربَ في الخُطا","result":"لتكثرَ خطانا في المشيِ إلى الصَّلاة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"طرح التثريب 2/358","srcLabel":"البخاري","text":["عن أنسِ بنِ مالكٍ قالَ كنتُ أمشي معَ زيدِ بنِ ثابتٍ ",["فقاربَ في الخُطا",1]," فقالَ أتدري لمَ مشيتُ بكَ هذهِ المِشيةَ فقلتُ لا فقالَ ",["لتكثرَ خطانا في المشيِ إلى الصَّلاة",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح وروي مرفوعا","takhrij":"أخرجه الطبراني (5/ 117)، (4796) بلفظه، والبخاري في ((الأدب المقرد)) (458)، وأبو نعيم الأصبهاني في ((معرفة الصحابة)) (2920) باختلاف يسير.","bab":"إيمان › الاحتساب والنية","dorar":"48wSPeba"},{"id":"س-06660","fp":"9b76714c0e04","stateId":427,"easy":"إذا انتظرت الصلاة ← فلم تزل في صلاة","cause":"منذُ انتظرتُمُ الصَّلاةَ","result":"وإنَّكم لم تَزالوا في صلاةٍ","explicit":true,"star":true,"similar":["س-07513","س-08132","س-00024","س-00055","س-02174","س-06193"],"otherNeedIds":[49,24],"ref":"صحيح ابن خزيمة 1/ 446","srcLabel":"متفق عليه","text":["أنَّ رجلًا أتى النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ فسألَهُ عَن وقتِ الصَّلاةِ فذَكَرَ الحديثَ بطولِهِ في مَواقيتِ الصَّلاةِ في اليومَينِ واللَّيلتينِ، وقالَ في اللَّيلةِ الأولى: ثمَّ أذَّنَ بلالٌ العِشاءَ حينَ ذَهَبَ بياضُ النَّهارِ وأمرَهُ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ فأقامَ الصَّلاةَ فصلَّى، وقالَ في اللَّيلةِ الثَّانيةِ: ثمَّ أذَّنَ بلالٌ العشاءَ حينَ ذَهَبَ بياضُ النَّهارِ فأخَّرَها النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ فنِمنا، ثمَّ نِمنا مِرارًا، ثمَّ خرجَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ: إنَّ النَّاسَ قد صلَّوا ورقَدوا ",["وإنَّكم لم تَزالوا في صلاةٍ",2]," ",["منذُ انتظرتُمُ الصَّلاةَ",1]," ثمَّ ذَكَرَ الحديثَ بطولِهِ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه النسائي (504) بنحوه، وأصله في البخاري (560)، ومسلم (646)","bab":"صلاة › مواقيت الصلاة","dorar":"siuH8zxN","merged":21,"otherRefs":["المصابيح في الأحاديث المتواترة 601 (صحيح)","صحيح البخاري 647 (صحيح)","مسند الفاروق 1/268 (حسن)","تخريج صحيح ابن حبان 1750 (صحيح)","تخريج المسند لشعيب 13819 (صحيح)","صحيح مسلم 640 (صحيح)","الجامع الصغير 9169 (صحيح)","تخريج المسند لشعيب 11907 (صحيح)","صحيح ابن خزيمة 1/ 144 (صحيح)","صحيح النسائي 537 (صحيح)","الصحيح المسند 1/348 (صحيح)","تخريج المسند لشعيب 7892 (صحيح)","مجمع الزوائد 1/317 (صحيح)","تخريج صحيح ابن حبان 1537 (صحيح)","صحيح البخاري 176 (صحيح)","صحيح ابن حبان 2033 (صحيح)","تخريج صحيح ابن حبان 1529 (صحيح)","صحيح البخاري 2119 (صحيح)","صحيح البخاري 659 (صحيح)","صحيح البخاري 3229 (صحيح)"]},{"id":"س-07513","fp":"101163c37418","stateId":427,"easy":"إذا جلست تنتظر الصلاة ← فأنت في صلاة حتى تصلي","cause":"مَن جَلَسَ مَجْلِسًا يَنْتَظِرُ الصَّلاةَ","result":"فهو في صَلاةٍ حتَّى يُصَلِّيَ","explicit":true,"repOf":"س-06660","ref":"الأحاديث المختارة 9 / 424","text":["«خَرَجْتُ إلى الطُّورِ فلَقيْتُ كَعْبَ الأحْبارِ، فجَلَسْتُ معَه فحَدَّثَني عن التَّوْراةِ، وحَدَّثْتُه عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فكانَ فيما حَدَّثْتُه أنْ قُلْتُ: قالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: خَيْرُ يَوْمٍ طَلَعَتْ عليه الشَّمْسُ يَوْمُ الجُمُعةِ؛ فيه خُلِقَ آدَمُ، وفيه أُهبِطَ، وفيه ماتَ، وفيه تيبَ عليه، وفيه تَقومُ السَّاعةُ، وما مِن دابَّةٍ إلَّا وهي مُصيخةٌ يَوْمَ الجُمُعةِ مِن حينِ تُصبِحُ حتَّى تَطلُعَ الشَّمْسُ؛ شَفَقًا مِن السَّاعةِ، إلَّا الجِنَّ والإنْسَ، وفيه ساعةٌ لا يُصادِفُها عَبْدٌ مُسلِمٌ وهو يُصَلِّي يَسأَلُ اللهَ شَيئًا إلَّا أَعْطاه إيَّاه، قالَ كَعْبٌ: ذلك في كلِّ سَنَةٍ يَوْمٌ؟ فقُلْتُ: بلْ في كلِّ جُمُعةٍ، قالَ: فقَرَأَ كَعْبٌ التَّوْراةَ، فقالَ: صَدَقَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ.\nفقالَ أبو هُرَيرةَ: فلَقيْتُ بَصْرةَ بنَ أبي بَصْرةَ الغِفارِيَّ فقالَ: مِن أين أَقْبَلْتَ؟ فقُلْتُ: مِن الطُّورِ، فقالَ: لو أَدْرَكْتُك قَبْلَ أن تَخرُجَ إليه ما خَرَجْتَ إليه، سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: لا تُعمَلُ المَطِيُّ إلَّا إلى ثَلاثةِ مَساجِدَ؛ إلى المَسجِدِ الحَرامِ، أو مَسجِدي هذا، أو إلى مَسجِد إيلياءَ، أو بَيْتِ المَقدِسِ، يَشُكُّ أيُّهما، قالَ أبو هُرَيْرةَ: ثُمَّ لَقيْتُ عَبْدَ اللهِ بنَ سَلامٍ فحَدَّثْتُه بمَجْلِسي معَ كَعْبِ الأحْبارِ وما حَدَّثْتُه في يَوْمِ الجُمُعةِ، فقُلْتُ له: قالَ كَعْبٌ ذلك في كلِّ سَنَةٍ يَوْمٌ، فقالَ عَبْدُ اللهِ بنُ سَلامٍ: كَذَبَ كَعْبٌ، فقُلْتُ: ثُمَّ قَرَأَ التَّوْراةَ فقالَ: بلْ هي في كلِّ جُمُعةٍ، فقالَ عَبْدُ اللهِ بنُ سَلامٍ: صَدَقَ كَعْبٌ، ثُمَّ قالَ عَبْدُ اللهِ بنُ سَلامٍ: قد عَلِمْتُ أيَّةُ ساعةٍ هي، قالَ أبو هُرَيْرةَ: فقُلْتُ له: فأَخْبِرْني بها ولا تَضْنَنْ عنِّي، قالَ عَبْدُ اللهِ بنُ سَلامٍ: هي آخِرُ ساعةٍ في يَوْمِ الجُمُعةِ، فقالَ أبو هُرَيْرةَ: وكيف تكونُ آخِرَ ساعةٍ في يَوْمِ الجُمُعةِ وقدْ قالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: لا يُصادِفُها عَبْدٌ مُسلِمٌ وهو يُصَلِّي، وتلك ساعةٌ لا يُصَلَّى فيها، فقالَ عَبْدُ اللهِ بنُ سَلامٍ: أَلَمْ يَقُلْ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["مَن جَلَسَ مَجْلِسًا يَنْتَظِرُ الصَّلاةَ ",1],["فهو في صَلاةٍ حتَّى يُصَلِّيَ",2],"؟ قالَ أبو هُرَيْرةَ: بَلى، قالَ: فهو ذلك»."],"grade":"صحيح","narrator":"أبو هريرة وبصرة بن أبي بصرة الغفاري وعبدالله بن سلام","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"T0pnKQET","merged":2,"otherRefs":["صحيح الترمذي 491 (صحيح)"]},{"id":"س-01491","fp":"71a2a93a985f","stateId":427,"easy":"إذا عمدت إلى الصلاة ← فأنت في صلاة","cause":"إذا كانَ يَعمِدُ إلى الصَّلاةِ","result":"فهو في صَلاةٍ","explicit":true,"similar":["س-01373","س-06692","س-01375"],"ref":"صحيح مسلم 602","srcLabel":"البخاري","text":["إذا ثُوِّبَ للصَّلاةِ فلا تَأتوها وأنتُم تَسعَونَ، وأْتوها وعليكُمُ السَّكينةُ، فما أدرَكتُم فصَلُّوا، وما فاتَكُم فأتِمُّوا؛ فإنَّ أحَدَكُم ",["إذا كانَ يَعمِدُ إلى الصَّلاةِ",1]," ",["فهو في صَلاةٍ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (908) بنحوه","bab":"أذان › التثويب في أذان الصبح","dorar":"F0ftTT5H"},{"id":"س-06420","fp":"0a78c727d2eb","stateId":427,"easy":"إذا بقيت في مصلاك لا يحبسك إلا انتظار الصلاة ← فأنت في صلاة","cause":"ما دامَ في مُصَلَّاهُ، لا يَحبِسُهُ إلَّا انتظارُ الصَّلاةِ","result":"إنَّ العَبدَ المُؤمِنَ في صلاةٍ","explicit":true,"similar":["س-00034"],"ref":"تخريج المسند لشعيب 10901","srcLabel":"متفق عليه","text":[["إنَّ العَبدَ المُؤمِنَ في صلاةٍ",2]," ",["ما دامَ في مُصَلَّاهُ، لا يَحبِسُهُ إلَّا انتظارُ الصَّلاةِ",1],"، والمَلائكةُ معه تَقولُ: اللَّهمَّ ارحَمْهُ، اللَّهمَّ اغفِرْ لهُ؛ ما لم يُحدِثْ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (445)، ومسلم (649)، وأبو داود (469)، والنسائي (733)، وأحمد (10901) واللفظ له","bab":"صلاة › الوضوء والتطهر للصلاة","dorar":"cADmfU2k"},{"id":"س-08132","fp":"ab3007bf6f2c","stateId":427,"easy":"إذا قعدت تنتظر الصلاة ← فأنت في صلاة والملائكة تدعو لك","cause":"ما قَعَدَ يَنتَظِرُ الصَّلاةَ","result":"في صَلاةٍ ما لَم يُحدِثْ، تَدعو له المَلائِكةُ: اللَّهُمَّ اغفِرْ له، اللَّهُمَّ ارحَمْه","explicit":true,"repOf":"س-06660","otherNeedIds":[24,11],"ref":"صحيح مسلم 649","text":["أحَدُكُم ",["ما قَعَدَ يَنتَظِرُ الصَّلاةَ",1]," ",["في صَلاةٍ ما لَم يُحدِثْ، تَدعو له المَلائِكةُ: اللَّهُمَّ اغفِرْ له، اللَّهُمَّ ارحَمْه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3229)، ومسلم (649).","bab":"ملائكة › أعمال الملائكة","dorar":"ka1SjK5d"},{"id":"س-01373","fp":"6df17fdc2a0a","stateId":427,"easy":"إذا أحسنت الوضوء ثم خرجت عامداً إلى المسجد ← فأنت في صلاة","cause":"إذا توضَّأَ أحدُكم فأحسنَ وضوءَهُ ثمَّ خرجَ عامِدًا إلى المسجدِ","result":"فإنَّهُ في صلاةٍ","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"repOf":"س-01491","otherNeedIds":[51],"ref":"صحيح أبي داود 562","text":["[عن] أبي ثمامة الحناط، أنَّ كعبَ بنَ عُجْرَةَ أدرَكَهُ وَهوَ يريدُ المسجدَ أدرَكَ أحدُهما صاحبَهُ قالَ فوجدني وأنا مشبِّكٌ بيديَّ فنَهاني عن ذلِكَ وقالَ إنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ ",["إذا توضَّأَ أحدُكم فأحسنَ وضوءَهُ ثمَّ خرجَ عامِدًا إلى المسجدِ",1]," فلا يشبِّكَنَّ يديهِ ",["فإنَّهُ في صلاةٍ",2]],"grade":"صحيح","narrator":"كعب بن عجرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (562) واللفظ له، وابن ماجة (967)، والدارمي (1444) بنحوه.","bab":"وضوء › إسباغ الوضوء","dorar":"n21qEhYu","merged":3,"otherRefs":["صحيح ابن حبان 2036 (صحيح)","صحيح ابن خزيمة 1/ 512 (صحيح)"]},{"id":"س-06692","fp":"be3edbb70429","stateId":427,"easy":"إذا توضأت فعمدت إلى المسجد ← فأنت في صلاة","cause":"إذا توضأْتَ ، فعمدتَ إلى المسجدِ","result":"فإنَّك في صلاةٍ","explicit":true,"repOf":"س-01491","otherNeedIds":[51],"ref":"تفسير القرطبي 1/255","text":[["إذا توضأْتَ ، فعمدتَ إلى المسجدِ",1]," ، فلا تُشَبِّكنَّ بينَ أصابِعِك ، ",["فإنَّك في صلاةٍ",2]],"grade":"صحيح","narrator":"كعب بن عجرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (18130)، وابن حبان (2150)، وعبد الرزاق (3334) بنحوه.","bab":"صلاة الجماعة والإمامة › الخشوع في الصلاة","dorar":"YqJnfA9R","merged":2,"otherRefs":["تخريج المسند لشعيب 18114 (حسن)"]},{"id":"س-00024","fp":"f6ef765789df","stateId":427,"easy":"إذا انتظرت الصلاة ← فأنت في صلاة حتى تصلي","cause":"مَنِ انتَظَرَ صلاةً","result":"فهو في صلاةٍ حتى يُصلِّيَ","explicit":true,"repOf":"س-06660","ref":"تخريج المسند لشعيب 23786","text":["عن أبي هُرَيرةَ، قال: فلَقيتُ عَبدَ اللهِ بنَ سَلامٍ فحَدَّثتُه حَديثي وحَديثَ كَعْبٍ في قَولِه في كُلِّ سَنةٍ، قال: كَذَبَ كَعبٌ، هو كما قال رسولُ اللهِ صلَّى اللهُ عليه وسَلَّمَ: في كلِّ يَومِ جُمُعةٍ، قُلتُ: إنَّه قد رَجَعَ، قال: أمَا والذي نَفْسُ عَبدِ اللهِ بنِ سَلَامٍ بيَدِه إنِّي لَأعْرِفُ تلك الساعةَ، قال: قلتُ يا عَبدَ اللهِ، فأخْبِرْني بها، قال: هي آخِرُ ساعةٍ مِن يَومِ الجُمُعةِ، قال: قلتُ: قال: لا يُوافِقُ مُؤمِنٌ وهو يُصلِّي، قال: أما سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسَلَّمَ يقول: ",["مَنِ انتَظَرَ صلاةً",1]," ",["فهو في صلاةٍ حتى يُصلِّيَ",2],"، قُلتُ: بَلى، قال: فهو كذلك."],"grade":"صحيح","narrator":"عبدالله بن سلام","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1046)، والترمذي (491)، وأحمد (23786) واللفظ له","bab":"آداب الدعاء › استجابة الدعاء","dorar":"mevfCgKm"},{"id":"س-00034","fp":"c93e66d11c55","stateId":427,"easy":"إذا صليت ثم جلست لا يحبسك إلا الصلاة ← فأنت في صلاة","cause":"إنَّ العبدَ المؤمنَ إذا صلَّى ثمَّ جلسَ لا يحبسُهُ إلَّا الصَّلاةُ","result":"فَهوَ في الصَّلاةِ","explicit":true,"repOf":"س-06420","ref":"الصحيح المسند 582","text":["قلتُ ورسولُ اللَّهِ - صلَّى اللَّهُ عليهِ وعلَى آلِه وسلَّمَ - جالسٌ إنَّا لنَجِدُ في كتابِ اللَّهِ ، في يومِ الجمعةِ ساعةٌ لا يوافقُها عبدٌ مؤمنٌ يصلِّي يسألُ اللَّهَ فيها شيئًا إلَّا قضَى لَه حاجتَهُ قالَ عبدُ اللَّهِ فأشارَ إليَّ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وعلَى آلِه وسلَّمَ أو بعضُ ساعةٍ فقُلتُ صدَقتَ أو بعضُ ساعةٍ قلتُ أيُّ ساعةٍ هيَ قالَ آخرُ ساعاتِ النَّهارِ قلتُ إنَّها ليسَتْ ساعةَ الصَّلاةِ قالَ بلَى ",["إنَّ العبدَ المؤمنَ إذا صلَّى ثمَّ جلسَ لا يحبسُهُ إلَّا الصَّلاةُ ",1],["فَهوَ في الصَّلاةِ",2]],"grade":"صحيح","narrator":"عبدالله بن سلام","muhaddith":"حسن رجاله رجال الصحيح","takhrij":"أخرجه ابن ماجه (1139)، والمروزي في ((الجمعة وفضلها)) (4)، والطبراني (13/ 168) (405) واللفظ لهم.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"1KZRxCf7"},{"id":"س-00055","fp":"0183b24380db","stateId":427,"easy":"إذا انتظرت الصلاة ← فأنت في صلاة","cause":"منِ انتظرَ الصَّلاةَ","result":"فهوَ في صلاةٍ","explicit":true,"repOf":"س-06660","ref":"طرح التثريب 3/208","text":["عن عبدِ اللَّهِ بنِ سلامٍ يذكرُ عن رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ نعم هيَ آخرُ ساعةٍ قلتُ إنَّما قالَ وهوَ يصلِّي وليست تلكَ ساعةَ صلاةٍ قالَ أما سمعتَ أو أما بلغَكَ أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ ",["منِ انتظرَ الصَّلاةَ",1]," ",["فهوَ في صلاةٍ",2]],"grade":"صحيح","narrator":"عبدالله بن سلام","muhaddith":"صحيح","takhrij":"أخرجه البزار (8611)، وابن منده في ((التوحيد)) (45) واللفظ لهما، والطبراني (13/ 145) (359) مختصرا.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"wNr26Pz4"},{"id":"س-00732","fp":"920dacac7644","stateId":427,"easy":"إذا صليت الصبح في جماعة ثم ذكرت الله حتى الشروق ثم صليت ركعتين ← لك أجر حجة وعمرة","cause":"مَن صلَّى الصُّبحَ في جماعةٍ ثمَّ قعدَ يذكرُ اللَّهَ حتَّى تطلعَ الشَّمسُ ، ثمَّ صلَّى رَكْعتينِ","result":"كانت لَهُ كأجرِ حجَّةٍ وعمرةٍ","explicit":true,"apply":{"k":"count","t":"ركعتين"},"similar":["س-01014"],"otherNeedIds":[49],"ref":"الترغيب والترهيب 1/220","srcLabel":"الترمذي","text":[["مَن صلَّى الصُّبحَ في جماعةٍ ثمَّ قعدَ يذكرُ اللَّهَ حتَّى تطلعَ الشَّمسُ ، ثمَّ صلَّى رَكْعتينِ ",1],["كانت لَهُ كأجرِ حجَّةٍ وعمرةٍ ",2],"، قالَ : قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : تامَّةٍ تامَّةٍ تامَّةٍ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (586)، والبغوي في ((شرح السنة)) (710) باختلاف يسير.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"LFu0bifj"},{"id":"س-01014","fp":"f3cf78c9b7b8","stateId":427,"easy":"إذا صليت الغداة في جماعة ثم ذكرت الله حتى الشروق ثم صليت ← تنقلب بأجر حجة وعمرة","cause":"من صلَّى صلاةَ الغداةِ في جماعةٍ ، ثم جلس يذكرُ اللهَ حتى تطلعَ الشمسُ ، ثم قام فصلَّى ركعتَين","result":"انقلب بأجرِ حجَّةٍ و عمرةٍ","explicit":true,"repOf":"س-00732","otherNeedIds":[49],"ref":"صحيح الترغيب 467","text":[["من صلَّى صلاةَ الغداةِ في جماعةٍ ، ثم جلس يذكرُ اللهَ حتى تطلعَ الشمسُ ، ثم قام فصلَّى ركعتَين ، ",1],["انقلب بأجرِ حجَّةٍ و عمرةٍ",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"حسن صحيح","takhrij":"أخرجه الطبراني (8/209) (7741)","bab":"أدعية وأذكار › فضل الذكر","dorar":"VxMXPKkL"},{"id":"س-01375","fp":"9b5838c91b7d","stateId":427,"easy":"إذا أحسنت الوضوء ثم خرجت إلى المسجد ← فأنت في صلاة","cause":"إذا توضَّأْتَ فأحسَنْتَ الوضوءَ ثمَّ خرَجْتَ إلى المسجدِ","result":"فإنَّك في صلاةٍ","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"repOf":"س-01491","ref":"صحيح ابن حبان 2150","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم قال له: ( يا كعبُ بنَ عُجْرةَ ",["إذا توضَّأْتَ فأحسَنْتَ الوضوءَ ثمَّ خرَجْتَ إلى المسجدِ",1]," فلا تُشَبِّكْ بينَ أصابعِك ",["فإنَّك في صلاةٍ",2]," )"],"grade":"صحيح","narrator":"كعب بن عجرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (562) بلفظ مقارب، والترمذي (386)، وأحمد (18115)","bab":"وضوء › إسباغ الوضوء","dorar":"sts1380P"},{"id":"س-01427","fp":"8034f650cec3","stateId":427,"easy":"إذا توضأت في بيتك ثم أتيت المسجد ← فأنت في صلاة حتى ترجع","cause":"إذا توضَّأَ أحدُكُم في بيتِهِ ثمَّ أتى المسجدَ","result":"كانَ في الصَّلاةِ حتَّى يرجعَ ، فلا يقُلْ هَكَذا ، وشبَّكَ بينَ أصابعِهِ","explicit":true,"ref":"الترغيب والترهيب 1/164","srcLabel":"الحاكم","text":[["إذا توضَّأَ أحدُكُم في بيتِهِ ثمَّ أتى المسجدَ ، ",1],["كانَ في الصَّلاةِ حتَّى يرجعَ ، فلا يقُلْ هَكَذا ، وشبَّكَ بينَ أصابعِهِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"قال الحاكم صحيح على شرطهما وفيما قاله نظر","takhrij":"أخرجه ابن خزيمة (439)، والحاكم (744)","bab":"وضوء › فضل الوضوء","dorar":"wfNdZD3X"},{"id":"س-01449","fp":"d7adf6136a1b","stateId":427,"easy":"إذا توضأت ثم خرجت تريد الصلاة ← فأنت في صلاة حتى ترجع إلى بيتك","cause":"مَن توضَّأَ ثُمَّ خرجَ يُريدُ الصَّلاةَ","result":"فَهوَ في صَلاةٍ حتَّى يرجعَ إلى بَيتِهِ","explicit":true,"similar":["س-04747"],"ref":"صحيح ابن خزيمة 1/ 514","srcLabel":"الحاكم","text":[["مَن توضَّأَ ثُمَّ خرجَ يُريدُ الصَّلاةَ",1]," ",["فَهوَ في صَلاةٍ حتَّى يرجعَ إلى بَيتِهِ",2],"، ولا يقولُ: هذا يَعني يشبِّكُ بينَ أصابعِهِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الدارمي (1446)، والحاكم (744)، وعبد الرزاق (3332) باختلاف يسير.","bab":"وضوء › فضل الوضوء","dorar":"rGwyBU7J"},{"id":"س-02174","fp":"95e2810c189d","stateId":427,"easy":"إذا صليت وجلست تنتظر الصلاة ← تبقى في صلاة حتى تأتي الصلاة التالية","cause":"من صلَّى و جلس ينتظرُ الصلاةَ","result":"لم يزلْ في صلاةٍ حتى تأتيَه الصلاةُ التي يلاقيها","explicit":true,"repOf":"س-06660","ref":"صحيح الجامع 6366","text":[["من صلَّى و جلس ينتظرُ الصلاةَ ",1],["لم يزلْ في صلاةٍ حتى تأتيَه الصلاةُ التي يلاقيها",2]],"grade":"صحيح","narrator":"عبدالله بن سلام وأبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي عاصم في ((الآحاد والمثاني)) (2081)، والسراج في ((مسنده)) (1243) واللفظ لهما، والنسائي (1430) بلفظه تامًا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"FzTPJfAj"},{"id":"س-06223","fp":"8141ea564821","stateId":427,"easy":"إذا توضأت في بيتك وصليت الغداة في المسجد ثم جلست حتى الضحى ← فقد أسرعت الرجعة وأعظمت الغنيمة","cause":"رجلٌ توضَّأ في بيتِه فأحسَن وضوءَه ثمَّ تحمَّل إلى المسجدِ فصلَّى فيه الغداةَ ثمَّ عقَّب بصلاةِ الضُّحى","result":"فقد أسرَع الكرَّةَ وأعظَم الغنيمةَ","explicit":true,"apply":{"k":"time","t":"الضحى"},"ref":"صحيح ابن حبان 2535","srcLabel":"أبو يعلى","text":["بعَث رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بعثًا فأعظموه الغنيمةَ وأسرَعوا الكَرَّةَ فقال رجلٌ: يا رسولَ اللهِ ما رأَيْنا بعثَ قومٍ أسرَعَ كرَّةً ولا أعظَمَ غنيمةً مِن هذا البعثِ فقال صلَّى اللهُ عليه وسلَّم: ( ألا أُخبِرُكم بأسرعَ كرَّةً وأعظَمَ غنيمةً مِن هذا البعثِ ؟ ",["رجلٌ توضَّأ في بيتِه فأحسَن وضوءَه ثمَّ تحمَّل إلى المسجدِ فصلَّى فيه الغداةَ ثمَّ عقَّب بصلاةِ الضُّحى",1]," ",["فقد أسرَع الكرَّةَ وأعظَم الغنيمةَ",2]," )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو يعلى (6559)، وابن عدي في ((الكامل في الضعفاء)) (2/275)، وابن شاهين في ((الترغيب في فضائل الأعمال)) (125) باختلاف يسير","bab":"سرايا › السرايا","dorar":"lSbb53YR"},{"id":"س-06706","fp":"e2bd6672ddb1","stateId":427,"easy":"إذا صليت الصبح في جماعة ثم ثبتّ حتى تصلي الضحى ← فلك أجر حاج ومعتمر تامّين","cause":"من صلَّى صلاةَ الصبحِ في جماعةٍ ، ثم ثبت حتى يسبحَ للهِ سُبحةَ الضُّحى","result":"كان له كأجرِ حاجٍّ و معتمرٍ ، تامًّا له حجتُه و عمرتُه","explicit":true,"apply":{"k":"time","t":"الضحى"},"otherNeedIds":[49],"ref":"صحيح الترغيب 469","srcLabel":"الطبراني","text":[["من صلَّى صلاةَ الصبحِ في جماعةٍ ، ثم ثبت حتى يسبحَ للهِ سُبحةَ الضُّحى ، ",1],["كان له كأجرِ حاجٍّ و معتمرٍ ، تامًّا له حجتُه و عمرتُه",2]],"grade":"صحيح","narrator":"أبو أمامة وعتبة بن عبد","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني في ((الكبير)) (8/ 148) (7649)، والمحاملي في ((أماليه-رواية ابن يحيى)) (494)، وابن شاهين في ((الترغيب)) (116) واللفظ لهم.","bab":"صلاة الجماعة والإمامة › فضل صلاة الجماعة","dorar":"h1uHVGlj"},{"id":"س-07971","fp":"340368c9e8de","stateId":427,"easy":"إذا دخلت المسجد ← فأنت في صلاة ما كانت الصلاة تحبسك","cause":"فَإِذَا دَخَلَ المَسْجِدَ","result":"كانَ في الصَّلَاةِ ما كَانَتِ الصَّلَاةُ هي تَحْبِسُهُ","explicit":true,"apply":{"k":"time","t":"عند دخول المسجد"},"ref":"عارضة الأحوذي 6/304","srcLabel":"عارضة الأحوذي","text":["حديث  أنَّهُ لا يخطو خطوةً إلا كتب اللهُ لهُ بها حسنةً ومحا عنهُ بها سيئةً ورفعَه بها درجةً [يعني حديث: قالَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ: صَلَاةُ الرَّجُلِ في جَمَاعَةٍ تَزِيدُ علَى صَلَاتِهِ في بَيْتِهِ، وَصَلَاتِهِ في سُوقِهِ، بضْعًا وَعِشْرِينَ دَرَجَةً، وَذلكَ أنَّ أَحَدَهُمْ إذَا تَوَضَّأَ فأحْسَنَ الوُضُوءَ ، ثُمَّ أَتَى المَسْجِدَ لا يَنْهَزُهُ إلَّا الصَّلَاةُ، لا يُرِيدُ إلَّا الصَّلَاةَ، فَلَمْ يَخْطُ خَطْوَةً إلَّا رُفِعَ له بهَا دَرَجَةٌ، وَحُطَّ عنْه بهَا خَطِيئَةٌ، حتَّى يَدْخُلَ المَسْجِدَ، ",["فَإِذَا دَخَلَ المَسْجِدَ",1]," ",["كانَ في الصَّلَاةِ ما كَانَتِ الصَّلَاةُ هي تَحْبِسُهُ",2],"، وَالْمَلَائِكَةُ يُصَلُّونَ علَى أَحَدِكُمْ ما دَامَ في مَجْلِسِهِ الذي صَلَّى فيه يقولونَ: اللَّهُمَّ ارْحَمْهُ، اللَّهُمَّ اغْفِرْ له، اللَّهُمَّ تُبْ عليه، ما لَمْ يُؤْذِ فِيهِ، ما لَمْ يُحْدِثْ فِيهِ.]"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"صحيح","bab":"مساجد ومواضع الصلاة › فضل من غدا إلى المسجد أو راح","dorar":"HzQfmfaA"},{"id":"س-04747","fp":"54bf80a5c6d5","stateId":427,"easy":"إذا تطهرت في بيتك ثم خرجت لا تريد إلا الصلاة ← فأنت في صلاة حتى تقضيها","cause":"لا يَتطهَّرُ رَجُلٌ في بَيتِه، ثُمَّ يَخرُجُ لا يُريدُ","result":"إلَّا الصَّلاةَ؛ إلَّا كان في صَلاةٍ، حتى يَقضيَ صَلاتَه، ولا يُخالِفْ أحدُكم بين أصابعِ يدَيه في الصَّلاةِ","explicit":true,"repOf":"س-01449","ref":"تخريج المسند لشعيب 18112","text":[["لا يَتطهَّرُ رَجُلٌ في بَيتِه، ثُمَّ يَخرُجُ لا يُريدُ",1]," ",["إلَّا الصَّلاةَ؛ إلَّا كان في صَلاةٍ، حتى يَقضيَ صَلاتَه، ولا يُخالِفْ أحدُكم بين أصابعِ يدَيه في الصَّلاةِ",2],"."],"grade":"حسن","narrator":"كعب بن عجرة","muhaddith":"حسن","takhrij":"أخرجه أبو داود (562)، والترمذي (386) بنحوه، وأحمد (18112) واللفظ له","bab":"رقائق وزهد › الإخلاص","dorar":"2xfZZCjB"},{"id":"س-06193","fp":"1b9d004a1430","stateId":427,"easy":"إذا انتظرت الصلاة ← فأنت في صلاة","cause":"مَتى انتَظَرتُموها","result":"وإنَّكُم لَن تَزالوا في صَلاةٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-06660","ref":"الأربعون من المساواة 269","text":["سُئِلَ أنَسٌ: هَل اتَّخَذَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم خاتَمًا؟ فقال: نَعَم، كَأنِّي أنظُرُ إلى وَبيصِ خاتَمِه، أخَّرَ لَيلةً صَلاةَ العِشاءِ الآخِرةِ، إلى شَطرِ اللَّيلِ، ثُمَّ صَلَّى. فلَمَّا قَضى صَلاتَه أقبَلَ علينا بوَجهِه، فقال: «إنَّ النَّاسَ قد صَلَّوا وناموا، ",["وإنَّكُم لَن تَزالوا في صَلاةٍ",2]," ",["مَتى انتَظَرتُموها",1],"» قال: وكَأنِّي أنظُرُ إلى وَبيصِ خاتَمِه قال: وكان خاتَمُه مِن فِضَّةٍ، كان فصُّه مِنه »"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح.","bab":"زينة اللباس › خاتم النبي صلى الله عليه وسلم","dorar":"DuPZF8mz","merged":6,"otherRefs":["صحيح النسائي 538 (صحيح)","صحيح البخاري 661 (صحيح)","صحيح البخاري 5869 (صحيح)","نخب الافكار 3/230 (صحيح)","الصحيح المسند 411 (صحيح)"]},{"id":"س-02223","fp":"f7ebe73d1486","stateId":427,"easy":"إذا انتظرت الصلاة ← فأنت في صلاة ما لم تحدث","cause":"من انتظر الصَّلاةَ","result":"فهو في صلاةٍ ما لم يُحدِثْ","explicit":true,"ref":"صحيح الموارد 361","srcLabel":"النسائي","text":[["من انتظر الصَّلاةَ (",1]," وفي روايةٍ : من كان في المسجدِ ينتظِرُ الصَّلاةَ ) ؛ ",["فهو في صلاةٍ ما لم يُحدِثْ",2]],"grade":"صحيح","narrator":"سهل بن سعد الساعدي","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان كما في ((موارد الظمآن)) للهيثمي (423، 424) واللفظ له، وأخرجه النسائي (734)، وأحمد (22812) دون قوله: \"ما لم يحدث\"","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"dirrB2d7"},{"id":"س-07363","fp":"33bc953da968","stateId":427,"easy":"إذا انتظر القوم الخير ← لا يزالون بخير","cause":"ما انتَظروا الخيرَ","result":"إنَّ القومَ لا يزالون بخيرٍ","explicit":true,"star":true,"ref":"صحيح ابن حبان 2033","srcLabel":"متفق عليه","text":["انتظَرْنا النَّبيَّ صلَّى اللهُ عليه وسلَّم ذاتَ ليلةٍ حتَّى كان شَطْرُ اللَّيلِ فجاء فصلَّى لنا ثمَّ خطَبنا فقال: ( إنَّ النَّاسَ قد صلَّوا ورقَدوا وإنَّكم لن تزالوا في صلاةٍ مُذِ انتظَرْتُم الصَّلاةَ ) \nقال أنسُ بنُ مالكٍ: ",["إنَّ القومَ لا يزالون بخيرٍ",2]," ",["ما انتَظروا الخيرَ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (600) واللفظ له، ومسلم (640)، والنسائي (539) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › أحوال النبي","dorar":"qQHpjNv5"},{"id":"س-08170","fp":"b5f15bf1ce38","stateId":428,"easy":"إذا بكّرت إلى الجمعة ← فكأنما أهديت بدنة ثم بقرة ثم شاة بحسب تبكيرك","cause":"المُهَجِّرُ إلى الجمعةِ","result":"كالمُهْدي بدَنةً ، ثمَّ كالمُهْدي بقرةً ، ثمَّ كالمُهْدي شاةً ، ثمَّ كالمُهْدي دَجاجةً ، ثمَّ كالمُهْدي حَسِبْتُهُ","explicit":true,"similar":["س-00497","س-00602"],"otherNeedIds":[49],"ref":"تخريج المسند لشاكر 14/186","srcLabel":"أحمد","text":["عَن أبي هُرَيْرةَ قالَ : إذا كانَ يومُ الجمعةِ ، جلَستِ الملائِكَةُ على أبوابِ المسجِدِ ، يَكْتُبونَ كلَّ مَن جاءَ إلى الجُمعةِ ، فإذا خَرجَ الإمامُ ، طَوتِ الملائِكَةُ الصُّحفَ ، ودخَلَت تَسمعُ الذِّكرَ قالَ : وقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ : ",["المُهَجِّرُ إلى الجمعةِ",1]," ",["كالمُهْدي بدَنةً ، ثمَّ كالمُهْدي بقرةً ، ثمَّ كالمُهْدي شاةً ، ثمَّ كالمُهْدي دَجاجةً ، ثمَّ كالمُهْدي حَسِبْتُهُ",2]," قالَ – بيضةً"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (7766) واللفظ له، وعبد الرزاق (5562)، والمروزي في ((الجمعة وفضلها)) (44) بلفظه مطولًا.","bab":"ملائكة › أعمال الملائكة","dorar":"rj82OXl7","merged":6,"otherRefs":["تخريج المسند لشعيب 10646 (صحيح)","صحيح مسلم 850 (صحيح)","المحلى 5/44 (صحيح)","صحيح البخاري 929 (صحيح)","صحيح النسائي 1385 (صحيح)"]},{"id":"س-02004","fp":"6120fd44b14e","stateId":428,"easy":"إذا اغتسلت وبكّرت ودنوت من الإمام وأنصت يوم الجمعة ← فلك أجر سنة صيامها وقيامها","cause":"مَن غسَّلَ واغتَسلَ، ثمَّ غدا وابتَكَرَ، وجلَسَ منَ الإمامِ قريبًا، فاستمعَ وأنصتَ","result":"كانَ لَهُ منَ الأجرِ أجرُ سنةٍ، صيامُها وقيامُها","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"similar":["س-02139"],"ref":"صحيح ابن خزيمة 3/ 247","srcLabel":"أبو داود","text":[["مَن غسَّلَ واغتَسلَ، ثمَّ غدا وابتَكَرَ، وجلَسَ منَ الإمامِ قريبًا، فاستمعَ وأنصتَ ",1],["كانَ لَهُ منَ الأجرِ أجرُ سنةٍ، صيامُها وقيامُها ",2],". [وفي روايةٍ]: كانَ لَهُ بِكُلِّ خطوةٍ أجرُ سنةٍ صيامُها وقيامُها"],"grade":"صحيح","narrator":"أوس بن أوس","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (16178) واللفظ له، وأبو داود (345)، والترمذي (496)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"R9ttUb7I"},{"id":"س-02139","fp":"ba266dd62c1e","stateId":428,"easy":"إذا اغتسلت وبكّرت ودنوت من الإمام وأنصت يوم الجمعة ← لك بكل خطوة صيام سنة وقيامها","cause":"مَن غَسَّلَ واغتَسَلَ يومَ الجمُعةِ، وبكَّرَ وابتَكَرَ، ودَنا منَ الإمامِ فأنْصَتَ","result":"كان له بكلِّ خُطوةٍ يَخْطوها صيامُ سَنةٍ وقيامُها، وذلك على اللهِ يَسيرٌ","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-02004","otherNeedIds":[49],"ref":"تخريج زاد المعاد 1/373","text":[["مَن غَسَّلَ واغتَسَلَ يومَ الجمُعةِ، وبكَّرَ وابتَكَرَ، ودَنا منَ الإمامِ فأنْصَتَ، ",1],["كان له بكلِّ خُطوةٍ يَخْطوها صيامُ سَنةٍ وقيامُها، وذلك على اللهِ يَسيرٌ",2],"."],"grade":"صحيح","narrator":"أوس بن أبي أوس وقيل أوس بن أوس والد عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (345)، والبيهقي (5944)، والطبراني (1/ 215) (585) بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"BYmNO1Lx"},{"id":"س-06673","fp":"e59160997bd6","stateId":428,"easy":"إذا أنصت للخطبة ولو لم تسمع ← فلك من الحظ مثل السامع المنصت","cause":"فاستَمِعوا له وأنصِتوا","result":"فإنَّ للمُنصِتِ الذي لا يسمعُ منَ الحظِّ مثلَ ما للسامعِ المنصتِ","explicit":true,"ref":"خلاصة الأحكام للنووي 2/805","srcLabel":"مالك","text":["أنَّ عثمانَ بنَ عفانَ رضي اللهُ عنه كان يقولُ في خطبتِه قَلَّ ما يدَعُ ذلك إذا قام الإمامُ يخطبُ يومَ الجمُعةِ ",["فاستَمِعوا له وأنصِتوا",1]," ، ",["فإنَّ للمُنصِتِ الذي لا يسمعُ منَ الحظِّ مثلَ ما للسامعِ المنصتِ",2]," ، فإذا قامَتِ الصلاةُ فاعدِلوا الصفوفَ ، وحاذوا المناكبَ ، فإنَّ اعتدالَ الصفوفِ مِن تمامِ الصلاةِ . ثم لا يكبِّرُ حتى تأتيَه رجالٌ قد وكَلَهم بتسويةِ الصفوفِ ، فيُخبِرونَه أن قدِ استَوَتْ فيكبرُ"],"grade":"صحيح","narrator":"مالك بن أبي عامر الأصبحي","muhaddith":"صحيح","takhrij":"أخرجه الشافعي في ((مسنده-ترتيب سنجر)) (430)، والبيهقي في ((الصغير)) (630) واللفظ لهما، ومالك (345) باختلاف يسير.","bab":"صلاة الجماعة والإمامة › إقامة الصفوف ووصلها وفضائلها","dorar":"f9VImpaJ"},{"id":"س-00497","fp":"65b8cfbda04d","stateId":428,"easy":"إذا بكّرت إلى الجمعة ← فكأنما قربت بدنة","cause":"التَّبكيرِ","result":"كَناحرِ البدنةِ كَناحرِ البقرةِ كَناحرِ الشَّاةِ حتَّى ذَكَرَ الدَّجاجةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-08170","otherNeedIds":[49],"ref":"صحيح ابن ماجه 904","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ضربَ مثلَ الجمُعةِ ثمَّ ",["التَّبكيرِ",1]," ",["كَناحرِ البدنةِ كَناحرِ البقرةِ كَناحرِ الشَّاةِ حتَّى ذَكَرَ الدَّجاجةَ",2]],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"حسن صحيح","takhrij":"أخرجه ابن ماجه (1093) والروياني في المسند (820) باختلاف يسير، والطبراني ((7/ 212)) (6880) بنحوه","bab":"آداب عامة › ضرب الأمثال","dorar":"l8msxjO3","merged":2,"otherRefs":["الترغيب والترهيب 1/343 (حسن)"]},{"id":"س-00602","fp":"34354dfe5603","stateId":428,"easy":"إذا استعجلت إلى الجمعة ← فكأنما أهديت بدنة","cause":"المُستَعجِلُ إلى الجمعةِ","result":"كالمُهدِي بَدَنةً ، والَّذي يليهِ كالمُهدِي بقرةً ، والَّذي يليهِ كالمُهدِي شاةً ، والَّذي يليهِ كالمُهدِي طيرًا","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-08170","otherNeedIds":[49],"ref":"صحيح الترغيب 708","text":[["المُستَعجِلُ إلى الجمعةِ",1]," ",["كالمُهدِي بَدَنةً ، والَّذي يليهِ كالمُهدِي بقرةً ، والَّذي يليهِ كالمُهدِي شاةً ، والَّذي يليهِ كالمُهدِي طيرًا",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن خزيمة (1768) باختلاف يسير.\nوأخرجه النسائي (1386)، وابن ماجه (1092)، وأحمد (7258) بنحوه.","bab":"آداب عامة › ضرب الأمثال","dorar":"MwgOX6En"},{"id":"س-02840","fp":"6af570d2941f","stateId":428,"easy":"إذا اغتسلت يوم الجمعة وبكّرت ودنوت ← لك بكل خطوة صيام سنة وقيامها","cause":"إذا كان يَومُ الجُمُعةِ، فغسَلَ أحدُكم رَأسَهُ، واغتَسَلَ، ثم غَدا أو ابتكَرَ، ثم دنا فاستمَعَ، وأنصَتَ","result":"كان له بكُلِّ خُطوةٍ خَطاها كصيامِ سَنةٍ، وقيامِ سَنةٍ","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"otherNeedIds":[49],"ref":"تخريج المسند لشعيب 16161","srcLabel":"أبو داود","text":[["إذا كان يَومُ الجُمُعةِ، فغسَلَ أحدُكم رَأسَهُ، واغتَسَلَ، ثم غَدا أو ابتكَرَ، ثم دنا فاستمَعَ، وأنصَتَ؛ ",1],["كان له بكُلِّ خُطوةٍ خَطاها كصيامِ سَنةٍ، وقيامِ سَنةٍ",2],"."],"grade":"صحيح","narrator":"أوس بن أبي أوس وقيل أوس بن أوس والد عمرو","muhaddith":"صحيح","takhrij":"أخرجه من طرق أبو داود (346)، وأحمد (16161) واللفظ له","bab":"إيمان › الوعد","dorar":"6tvLZ5yx","merged":3,"otherRefs":["المتجر الرابح 84 (صحيح)","إتحاف الخيرة المهرة 2/263 (صحيح)"]},{"id":"س-06719","fp":"70d5c7b980b4","stateId":429,"easy":"إذا صليت في المسجد النبوي ← فهي أفضل من ألف صلاة فيما سواه إلا المسجد الحرام","cause":"صلاةٌ في مسجدي هذا","result":"أفضَلُ مِن ألفِ صلاةٍ فيما سواه إلَّا المسجِدَ الحرامَ وصلاةٌ في ذاك المسجِدِ أفضَلُ مِن مئةِ","explicit":true,"similar":["س-02200","س-07480"],"ref":"تخريج صحيح ابن حبان 1620","srcLabel":"مسلم","text":[["صلاةٌ في مسجدي هذا ",1],["أفضَلُ مِن ألفِ صلاةٍ فيما سواه إلَّا المسجِدَ الحرامَ وصلاةٌ في ذاك المسجِدِ أفضَلُ مِن مئةِ",2]," صلاةٍ في هذا يعني في مسجِدِ المدينةِ"],"grade":"صحيح","narrator":"عبدالله بن الزبير","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن حبان (1620) بلفظه، والطحاوي في ((شرح مشكل الاثار ))(597) باختلاف يسير، وأحمد (16117) والبزار (2196) بنحوه","bab":"صلاة الجماعة والإمامة › فضل صلاة الجماعة","dorar":"pk8uAzkE"},{"id":"س-02200","fp":"7e611c690ae7","stateId":429,"easy":"إذا صليت في المسجد النبوي ← فهي أفضل من ألف صلاة فيما سواه إلا المسجد الحرام","cause":"الصَّلاةُ في مسجدي هذا","result":"أفضلُ من ألفِ صلاةٍ فيما سواه إلَّا المسجدَ الحرامَ والجمعةُ في مسجدي هذا أفضلُ من ألفِ","explicit":true,"repOf":"س-06719","otherNeedIds":[49],"ref":"الترغيب والترهيب 2/207","text":[["الصَّلاةُ في مسجدي هذا ",1],["أفضلُ من ألفِ صلاةٍ فيما سواه إلَّا المسجدَ الحرامَ والجمعةُ في مسجدي هذا أفضلُ من ألفِ",2]," جمعةٍ فيما سواه إلَّا المسجدَ الحرامَ وشهرُ رمضانَ في مسجدي هذا أفضلُ من ألفِ شهرِ رمضانَ فيما سواه إلَّا المسجدَ الحرامَ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (4147)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"QV9x0Mtn","merged":4,"otherRefs":["صحيح الترغيب 1175 (صحيح)","صحيح مسلم 1394 (صحيح)","صحيح الجامع 3841 (صحيح)"]},{"id":"س-07480","fp":"4f290a5901bd","stateId":429,"easy":"إذا صليت في المسجد النبوي ← فهي أفضل من أربع صلوات في بيت المقدس","cause":"صَلاةٌ في مَسجدي هذا","result":"أفضَلُ مِن أربَعِ صَلواتٍ فيه","explicit":true,"repOf":"س-06719","ref":"المستدرك على الصحيحين 8777","text":["تَذاكَرْنا ونحن عِندَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أيُّهما أفضَلُ: مَسجِدُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، أو مَسجِدُ بيتِ المقدِسِ؟ فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["صَلاةٌ في مَسجدي هذا ",1],["أفضَلُ مِن أربَعِ صَلواتٍ فيه",2],"، ولَنِعْمَ المُصلَّى، ولَيُوشِكَنَّ ألَّا يكونَ للرَّجلِ مِثلُ بَسْطِ فَرشِه مِنَ الأرضِ حيثَ يَرى منه بيْتَ المقدِسِ خيْرٌ له مِنَ الدُّنيا جميعًا. أو قال: خيرٌ مِنَ الدُّنيا وما فيها."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح الإسناد، ولم يخرجاه","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"MDu2vsm2","merged":2,"otherRefs":["صحيح الترغيب 1179 (صحيح)"]},{"id":"س-02335","fp":"6b45776a8851","stateId":429,"easy":"إذا تطهرت في بيتك ثم صليت في مسجد قباء ← فلك أجر عمرة","cause":"مَن تَطَهَّرَ في بَيتِه ثُمَّ أتى مَسجِدَ قُباءٍ، فصَلَّى فيه صَلاةً","result":"كان له كَأجرِ عُمرةٍ","explicit":true,"otherNeedIds":[49],"ref":"مجموع الشروح الفقهية. 317/18","srcLabel":"النسائي","text":[["مَن تَطَهَّرَ في بَيتِه ثُمَّ أتى مَسجِدَ قُباءٍ، فصَلَّى فيه صَلاةً، ",1],["كان له كَأجرِ عُمرةٍ",2],"."],"grade":"صحيح","narrator":"سهل بن حنيف","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (1412)، وابن شبة في ((تاريخ المدينة)) (1/ 40) بلفظه، والنسائي (699) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"psNpATPW"},{"id":"س-06479","fp":"bec3ccf06765","stateId":429,"easy":"إذا صليت في المدينة ← فهي خير من ألف صلاة في بيت المقدس","cause":"صلاةٌ ها هنا - يريدُ المدينةَ","result":"خيرٌ من ألفِ صلاةٍ ها هنا - يريدُ إيلياءَ","explicit":true,"ref":"السلسلة الصحيحة 2902","srcLabel":"أحمد","text":[["صلاةٌ ها هنا - يريدُ المدينةَ - ",1],["خيرٌ من ألفِ صلاةٍ ها هنا - يريدُ إيلياءَ -",2]],"grade":"صحيح","narrator":"الأرقم بن أبي الأرقم","muhaddith":"حسن أو صحيح لغيره","takhrij":"أخرجه أحمد (24009)، والطبراني (1/306) (910) مطولاً باختلاف يسير، والطحاوي في ((شرح مشكل الآثار)) (607) واللفظ له","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"bELJ9Kig"},{"id":"س-08319","fp":"8e6f6bebd4ab","stateId":429,"easy":"إذا صليت في المسجد الحرام ← فهي خير من ألف صلاة","cause":"صَلاةٌ ها هنا","result":"خَيرٌ مِن ألْفِ صَلاةٍ","explicit":true,"similar":["س-08443"],"ref":"المستدرك على الصحيحين 6269","srcLabel":"الحاكم","text":["عنْ عُثْمانَ بنِ عَبدِ اللهِ بنِ الأرْقَمِ، عنْ جَدِّه الأرْقَمِ، وكانَ بَدْريًّا، وكانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ آوَى في دارِه عندَ الصَّفا حتَّى تَكامَلوا أرْبَعينَ رَجُلًا مُسلِمينَ، وكانَ آخِرَهم إسْلامًا عُمَرُ بنُ الخطَّابِ رَضيَ اللهُ عنهم، فلمَّا كانوا أرْبَعينَ خَرَجوا إلى المُشْركينَ، قالَ الأرْقَمُ: فجِئْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ لأُودِّعَه، وأرَدْتُ الخُروجَ إلى بَيتِ المَقدِسِ، فقالَ لي رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: أين تُريدُ؟ قُلْتُ: بَيتَ المَقدِسِ، قالَ: وما يُخرِجُكَ إليه؟ أفي تِجارةٍ؟ قُلْتُ: لا، ولكنْ أُصلِّي فيه، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["صَلاةٌ ها هنا ",1],["خَيرٌ مِن ألْفِ صَلاةٍ ",2],"ثَمَّ."],"grade":"صحيح","narrator":"الأرقم","muhaddith":"صحيح الإسناد","bab":"مناقب وفضائل › عمر بن الخطاب","dorar":"ASGPpUSl"},{"id":"س-08443","fp":"f24f8a2fd012","stateId":429,"easy":"إذا صليت في مكة ← فهي خير من ألف صلاة","cause":"فالصَّلاةُ هَهنا وأومأَ بيدِه إلى مَكةَ","result":"خيرٌ من ألفِ صلاةٍ","explicit":true,"repOf":"س-08319","ref":"عمدة القاري 7/372","text":["وَكانَ بدريًّا أنهُ جاءَ إلى رسول اللَّه صلَّى اللَّهُ عليهِ وسلَّم َ فسلَّمَ عليهِ فقالَ أين تريدُ فقالَ أردتُ يا رسولَ اللَّهِ هَهُنا وأومأَ بيدِه إلى حيِّزِ بيتِ المقدِّسِ قالَ ما يخرِجُك إليهِ أتِجارةٌ فقالَ قلتُ لا ولَكن أردتُ الصَّلاةَ فيهِ قالَ ",["فالصَّلاةُ هَهنا وأومأَ بيدِه إلى مَكةَ",1]," ",["خيرٌ من ألفِ صلاةٍ",2]," وأومأَ بيدِه إلى الشَّامِ وقال صلاةٌ هَهنا خيرٌ من ألفِ صلاةٍ ثَمَّةَ"],"grade":"حسن","narrator":"الأرقم بن أبي الأرقم","muhaddith":"رجال إسناده  ثقات","takhrij":"أخرجه أحمد (24009) مختصرا باختلاف يسير، والطبراني (1/306) (907)، والحاكم (6130) مطولا بنحوه","bab":"مناقب وفضائل › مكة شرفها الله تعالى","dorar":"m4N09O3W"},{"id":"س-02818","fp":"6a3b056095c8","stateId":429,"easy":"إذا صليت في المسجد النبوي أربعين صلاة لا تفوتك ← تُكتب لك براءة من النار والعذاب والنفاق","cause":"مَنْ صلَّى في مسجدِي أربعينَ صلاةً لا تفوتُه صلاةٌ","result":"كُتِبَ له براءَةٌ منَ النارِ وبراءَةٌ منَ العذابِ وَبَرِئَ مِنَ النفاقِ","explicit":true,"otherNeedIds":[66],"ref":"مجمع الزوائد 11-4","srcLabel":"الترمذي","text":[["مَنْ صلَّى في مسجدِي أربعينَ صلاةً لا تفوتُه صلاةٌ ",1],["كُتِبَ له براءَةٌ منَ النارِ وبراءَةٌ منَ العذابِ وَبَرِئَ مِنَ النفاقِ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"رجاله ثقات","takhrij":"أخرجه الترمذي (241) بنحوه، وأحمد (12583) باختلاف يسير.","bab":"إيمان › الوعد","dorar":"eQv9sUTU"},{"id":"س-06636","fp":"5c4a75e5d807","stateId":430,"easy":"إذا صليت مع رجل ← فهو أفضل من صلاتك وحدك","cause":"صَلاتَك معَ رَجُلٍ","result":"أَفضَلُ مِن صَلاتِك وَحْدَك","explicit":true,"star":true,"similar":["س-06637"],"ref":"الأحاديث المختارة 1196","srcLabel":"البخاري","text":["«كُنْتُ معَ أُبَيِّ بنِ كَعْبٍ في مَرَضِه، فسَمِعَ المُناديَ بالأذانِ، فقالَ: الأذانُ هذا أو الإقامةُ؟ فقُلْنا: الإقامةُ، فقالَ: ما تَنْتَظِرونَ؟ أَلَا تَنْهَضونَ إلى صَلاتِكم؟ فقُلْنا: ما بِنا إلَّا مَكانُك، فقالَ: لا تَفعَلوا قُوموا، إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ صلَّى بِنا صَلاةَ الفَجْرِ، فلمَّا سلَّمَ أَقبَلَ على القَوْمِ بوَجْهِه، فقالَ: أَشاهِدٌ فُلانٌ، حتَّى دَعا ثَلاثةً كلُّهم في مَنازِلِهم لم يَحْضُروا، فقالَ: إنَّ أَثقَلَ الصَّلاةِ على المُنافِقينَ صَلاةُ الفَجْرِ والعِشاءِ، ولو يَعلَمونَ ما فيهما لَأَتَوْهما ولو حَبْوًا، واعْلَمْ أنَّ ",["صَلاتَك معَ رَجُلٍ",1]," ",["أَفضَلُ مِن صَلاتِك وَحْدَك",2],"، وأنَّ صَلاتَك معَ رَجُلَينِ أَفضَلُ مِن صَلاتِك معَ رَجُلٍ، وما كانَ أَكثَرَ فهو أَحَبُّ إلى اللهِ، أَلَا وإنَّ الصَّفَّ المُقدَّمَ على مِثلِ صَفِّ المَلائِكةِ، ولو تَعلَمونَ فَضيلتَه لابْتَدَرْتُموه، أَلَا وإنَّ صَلاةَ الجَماعةِ تَفضُلُ على صِلاةِ الرَّجُلِ وَحْدَه أرْبَعًا وعِشْرينَ أو خَمْسًا وعِشْرينَ دَرَجةً»."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"EGIRXhcj","merged":6,"otherRefs":["صحيح ابن حبان 2056 (صحيح)","تحفة المحتاج 1/437 (صحيح)","الترغيب والترهيب 1/202 (صحيح)","صحيح الترغيب 411 (حسن)","الأحاديث المختارة 1197 (صحيح)"]},{"id":"س-06684","fp":"89e155ff85c4","stateId":430,"easy":"إذا أممت الناس فأصبت الوقت وأتممت الصلاة ← فلك ولهم","cause":"من أمَّ الناسَ فأصاب الوقتَ وأَتَمَّ الصلاةَ","result":"فلَهُ ولهم","explicit":true,"star":true,"ref":"عمدة القاري 5/334","srcLabel":"البخاري","text":["مَنْ أمَّ النَّاسَ فأتَمَّ [يعني حديث: ",["من أمَّ الناسَ فأصاب الوقتَ وأَتَمَّ الصلاةَ",1]," ",["فلَهُ ولهم",2],"، ومن انتقصَ من ذلك شيئًا فعليهِ ولا عليهم]"],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"على شرط البخاري","takhrij":"أخرجه أبو داود (580)، وابن ماجه (983)، وأحمد (17305) مطولاً","bab":"صلاة الجماعة والإمامة › الإمام","dorar":"8fluxKO4","merged":8,"otherRefs":["تخريج المسند لشعيب 28/621 (حسن)","تخريج المسند لشعيب 17795 (حسن)","تخريج مشكل الآثار 2198 (حسن)","صحيح الترغيب 482 (صحيح)","السلسلة الصحيحة 1767 (صحيح)","صحيح الجامع 2786 (صحيح)","صحيح ابن حبان 2228 (صحيح)"]},{"id":"س-06637","fp":"2aae8d2aafa1","stateId":430,"easy":"إذا صليت مع رجلين ← فهو أفضل من صلاتك مع رجل","cause":"صَلاتَك معَ رَجُلَينِ","result":"أَفضَلُ مِن صَلاتِك معَ رَجُلٍ","explicit":true,"repOf":"س-06636","ref":"الأحاديث المختارة 1196","text":["«كُنْتُ معَ أُبَيِّ بنِ كَعْبٍ في مَرَضِه، فسَمِعَ المُناديَ بالأذانِ، فقالَ: الأذانُ هذا أو الإقامةُ؟ فقُلْنا: الإقامةُ، فقالَ: ما تَنْتَظِرونَ؟ أَلَا تَنْهَضونَ إلى صَلاتِكم؟ فقُلْنا: ما بِنا إلَّا مَكانُك، فقالَ: لا تَفعَلوا قُوموا، إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ صلَّى بِنا صَلاةَ الفَجْرِ، فلمَّا سلَّمَ أَقبَلَ على القَوْمِ بوَجْهِه، فقالَ: أَشاهِدٌ فُلانٌ، حتَّى دَعا ثَلاثةً كلُّهم في مَنازِلِهم لم يَحْضُروا، فقالَ: إنَّ أَثقَلَ الصَّلاةِ على المُنافِقينَ صَلاةُ الفَجْرِ والعِشاءِ، ولو يَعلَمونَ ما فيهما لَأَتَوْهما ولو حَبْوًا، واعْلَمْ أنَّ صَلاتَك معَ رَجُلٍ أَفضَلُ مِن صَلاتِك وَحْدَك، وأنَّ ",["صَلاتَك معَ رَجُلَينِ",1]," ",["أَفضَلُ مِن صَلاتِك معَ رَجُلٍ",2],"، وما كانَ أَكثَرَ فهو أَحَبُّ إلى اللهِ، أَلَا وإنَّ الصَّفَّ المُقدَّمَ على مِثلِ صَفِّ المَلائِكةِ، ولو تَعلَمونَ فَضيلتَه لابْتَدَرْتُموه، أَلَا وإنَّ صَلاةَ الجَماعةِ تَفضُلُ على صِلاةِ الرَّجُلِ وَحْدَه أرْبَعًا وعِشْرينَ أو خَمْسًا وعِشْرينَ دَرَجةً»."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"EGIRXhcj","merged":5,"otherRefs":["تحفة المحتاج 1/437 (صحيح)","الترغيب والترهيب 1/202 (صحيح)","صحيح الترغيب 411 (حسن)","الأحاديث المختارة 1197 (صحيح)"]},{"id":"س-06476","fp":"2ef2bf98f227","stateId":430,"easy":"إذا صليت مع الإمام (وقد صليت) ← تكون لك نافلة","cause":"صلَّيْتَ معه","result":"وكانت صلاتُكَ لكَ نافلةً","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 21445","srcLabel":"مسلم","text":["كُنْتُ خلفَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ حينَ خرَجْنا من حاشي المدينةِ، فقال: يا أبا ذَرٍّ، صَلِّ الصَّلاةَ لوَقتِها، وإنْ جِئْتَ وقد صَلَّى الإمامُ كُنْتَ قد أحرَزْتَ صلاتَك قبلَ ذلك، وإنْ جِئْتَ ولم يُصلِّ ",["صلَّيْتَ معه",1],"، ",["وكانت صلاتُكَ لكَ نافلةً",2],"، وكُنْتَ قد أحرَزْتَ صلاتَكَ، يا أبا ذَرٍّ، أرَأيْتَ إنِ الناسُ جاعوا حتى لا تَبلُغَ مَسجِدَكَ منَ الجَهدِ، أو لا تَرجِعَ إلى فِراشِكَ منَ الجَهدِ، فكيف أنتَ صانعٌ؟ قال: قُلْتُ: اللهُ ورسولُه أعلَمُ، قال: تَعفَّفْ، قال: يا أبا ذَرٍّ، أرَأيْتَ إنِ الناسُ ماتوا حتى يكونَ البيتُ بالعَبدِ، فكيف أنتَ صانعٌ؟ قال: قُلْتُ: اللهُ ورسولُه أعلَمُ، قال: تَصبِرُ، قال: يا أبا ذَرٍّ، أرَأيْتَ إنِ الناسُ قُتِلوا حتى تَغرَقَ حِجارةُ الزيْتِ منَ الدماءِ، كيف أنتَ صانعٌ؟ قُلْتُ: اللهُ ورسولُه أعلَمُ، قال: تَدخُلُ بيتَكَ، قُلْتُ: يا رسولَ اللهِ، فإنْ أنا دُخِلَ عليَّ؟ قال: تَأْتي مَن أنتَ منه، قال: قُلْتُ: وأحمِلُ السلاحَ؟ قال: إذا شارَكْتَ، قال: قُلْتُ: كيف أصنَعُ يا رسولَ اللهِ؟ قال: إنْ خِفْتَ أنْ يَبهَرَكَ شُعاعُ السيفِ، فأَلْقِ طائفةً من رِدائِكَ على وَجهِكَ، يَبُؤْ بإثمِكَ وإثمِهِ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (648)، وأبو داود (431)، والترمذي (176)، وابن ماجه (1256) مختصراً، وأحمد (21445) واللفظ له","bab":"صلاة › فضل أول الوقت","dorar":"TRJG5AII","merged":10,"otherRefs":["تخريج سنن أبي داود 575 (صحيح)","تخريج المسند لشعيب 21490 (صحيح)","تخريج صحيح ابن حبان 1719 (صحيح)","صحيح الجامع 666 (صحيح)","صحيح الجامع 654 (صحيح)","تخريج المسند لشعيب 17479 (صحيح)","الأحكام الوسطى 1/ 283 (صحيح)","نخب الافكار 6/11 (صحيح)","تخريج صحيح ابن حبان 1564 (صحيح)"]},{"id":"س-04533","fp":"66e83767af4f","stateId":430,"easy":"إذا علمت ما في الأذان والصف الأول ← لاستهمت عليهما","cause":"لو يَعلَمُ النَّاسُ ما في النِّداءِ والصَّفِّ الأوَّلِ","result":"لَم يَجِدوا إلَّا أن يَستَهِموا لاستَهَموا عليه","explicit":true,"star":true,"apply":{"k":"time","t":"عند الأذان"},"otherNeedIds":[47],"ref":"صحيح البخاري 652","srcLabel":"متفق عليه","text":["بينَما رَجُلٌ يَمشي بطَريقٍ وجَدَ غُصنَ شَوكٍ على الطَّريقِ فأخَّرَه، فشَكَرَ اللهُ له فغَفَرَ له. ثُمَّ قال: الشُّهَداءُ خَمسةٌ: المَطعونُ، والمَبطونُ، والغَريقُ، وصاحِبُ الهَدمِ، والشَّهيدُ في سَبيلِ اللهِ، وقال: ",["لو يَعلَمُ النَّاسُ ما في النِّداءِ والصَّفِّ الأوَّلِ، ",1],"ثُمَّ ",["لَم يَجِدوا إلَّا أن يَستَهِموا لاستَهَموا عليه",2],". ولو يَعلَمونَ ما في التَّهجيرِ لاستَبَقوا إليه، ولو يَعلَمونَ ما في العَتَمةِ والصُّبحِ لَأتَوْهما ولو حَبوًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (652)، ومسلم (1914)","bab":"جهاد › فضل الشهيد","dorar":"DuXuhGJL","merged":2,"otherRefs":["علل ابن أبي حاتم 457 (حسن)"]},{"id":"س-06648","fp":"de03fd0849b5","stateId":430,"easy":"إذا صليت مع الإمام ← فهو أفضل من خمس وعشرين صلاة وحدك","cause":"صَلاةٌ مَعَ الإمامِ","result":"أفضَلُ مِن خَمسةٍ وعِشرينَ يُصَلِّيها وحدَه","explicit":true,"ref":"النفح الشذي 4/166","srcLabel":"متفق عليه","text":[["صَلاةٌ مَعَ الإمامِ ",1],["أفضَلُ مِن خَمسةٍ وعِشرينَ يُصَلِّيها وحدَه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح]","takhrij":"أخرجه البخاري (477)، ومسلم (649)، وأبو داود (559) بنحوه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"GrXl2GK1"},{"id":"س-02292","fp":"5188537de053","stateId":430,"easy":"إذا استكت للصلاة ← تفضل صلاتك بسبعين ضعفاً","cause":"الصَّلاةِ الَّتي تَسْتاكُ لها","result":"سَبْعونَ ضِعْفًا","explicit":true,"ref":"المستدرك على الصحيحين 522","srcLabel":"مسلم","text":["«فَضْلُ ",["الصَّلاةِ الَّتي تَسْتاكُ لها",1]," على الصَّلاةِ الَّتي لا تَسْتاكُ لها ",["سَبْعونَ ضِعْفًا",2],"»."],"grade":"صحيح","narrator":"عائشة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أحمد (26340)، وابن خزيمة (137)، والبيهقي في ((شعب الإيمان)) (2519) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"V9km5EHo"},{"id":"س-06714","fp":"6daa4c85c435","stateId":430,"easy":"إذا صليت في الجماعة ← فهي أفضل من صلاتك وحدك ببضع وعشرين","cause":"صلاةُ الرَّجلِ في الجميعِ","result":"أفضَلُ مِن صلاتِهِ وحدَهُ ببِضعٍ وعِشرينَ صلاةً","explicit":true,"ref":"صحيح ابن خزيمة 3/ 7","srcLabel":"مسلم","text":[["صلاةُ الرَّجلِ في الجميعِ ",1],["أفضَلُ مِن صلاتِهِ وحدَهُ ببِضعٍ وعِشرينَ صلاةً",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (649)، والترمذي (216)، وأحمد (10305) باختلاف يسير.","bab":"صلاة الجماعة والإمامة › فضل صلاة الجماعة","dorar":"7DpNVHtV"},{"id":"س-06669","fp":"a8bdf7fbc854","stateId":430,"easy":"إذا صليت في الصف المقدم (للرجال) والمؤخر (للنساء) ← فهو خير الصفوف","cause":"الرِّجالِ الصَّفُّ المُقدَّمُ، وشَرُّها الصَّفُّ المُؤخَّرُ، وخَيرُ صُفوفِ النِّساءِ المُؤخَّرُ، وشَرُّها المُقدَّمُ","result":"خَيرُ صُفوفِ","explicit":true,"otherNeedIds":[47],"ref":"تخريج المسند لشعيب 11121","srcLabel":"أحمد","text":["\"",["خَيرُ صُفوفِ",2],[" الرِّجالِ الصَّفُّ المُقدَّمُ، وشَرُّها الصَّفُّ المُؤخَّرُ، وخَيرُ صُفوفِ النِّساءِ المُؤخَّرُ، وشَرُّها المُقدَّمُ\"",1],"، وقال: \"يا مَعشَرَ النِّساءِ، لا تَرفَعْنَ رُؤوسَكُنَّ إذا سَجَدتُنَّ؛ لا تَرَيْنَ عَوْراتِ الرِّجالِ من ضِيقِ الأُزُرِ\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح لغيره دون قوله: يا معشر النساء..، فهو حديث حسن لغيره","takhrij":"أخرجه أحمد (10994) واللفظ له، والحارث في ((المسند)) (153)، وأبو يعلى (1355) مطولاً","bab":"صلاة الجماعة والإمامة › إقامة الصفوف ووصلها وفضائلها","dorar":"hraLmkyc","merged":5,"otherRefs":["المحلى 3/126 (صحيح)","تخريج المسند لشعيب 10290 (صحيح)","صحيح ابن ماجه 827 (صحيح)","مجمع الزوائد 2/96 (حسن)"]},{"id":"س-06657","fp":"a4eead84ee86","stateId":430,"easy":"إذا أسفرت بصلاة الصبح ← فهو أعظم للأجر","cause":"أسفِروا بصلاةِ الصُّبحِ","result":"فإنَّه أعظَمُ للأجرِ","explicit":true,"similar":["س-01862","س-01871","س-06604","س-06659","س-06656"],"ref":"تخريج صحيح ابن حبان 1491","srcLabel":"أبو داود","text":[["أسفِروا بصلاةِ الصُّبحِ ",1],["فإنَّه أعظَمُ للأجرِ ) ",2],"أو قال: ( أعظَمُ لأجورِكم )"],"grade":"صحيح","narrator":"رافع بن خديج","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (424)، وابن ماجه (672) بنحوه، والترمذي (154) باختلاف يسير","bab":"صلاة › مواقيت الصلاة","dorar":"dldg9MxP","merged":4,"otherRefs":["شرح مسند الشافعي 1/370 (صحيح)","تخريج سنن أبي داود 424 (صحيح)","نخب الافكار 3/394 (صحيح)"]},{"id":"س-02232","fp":"de481172195d","stateId":430,"easy":"إذا صليت مع الإمام حتى ينصرف ← يُكتب لك قيام ليلة","cause":"إنَّ الرجُلَ إذا صَلَّى مع الإِمامِ حتى يَنصَرِفَ","result":"كُتِبَ له قِيامُ ليلَةٍ","explicit":true,"otherNeedIds":[49],"ref":"صحيح الجامع 1615","srcLabel":"الترمذي","text":[["إنَّ الرجُلَ إذا صَلَّى مع الإِمامِ حتى يَنصَرِفَ ",1],["كُتِبَ له قِيامُ ليلَةٍ",2]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (3410) مطولاً واللفظ له، وأخرجه الترمذي (806)، والنسائي (1605) مطولاً باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"N36U6bDV","merged":2,"otherRefs":["مجموع فتاوى ابن باز 25/178 (صحيح)"]},{"id":"س-01496","fp":"536278ebe189","stateId":430,"easy":"إذا أذّنت سبع سنين محتسباً ← تُكتب لك براءة من النار","cause":"مَنْ أذَّنَ سبْعَ سِنينَ مُحتَسِبًا","result":"كُتِبَتْ لهُ براءةٌ من النارِ","explicit":true,"otherNeedIds":[66],"ref":"البحر الزخار 11/191","srcLabel":"الترمذي","text":[["مَنْ أذَّنَ سبْعَ سِنينَ مُحتَسِبًا ، ",1],["كُتِبَتْ لهُ براءةٌ من النارِ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"محفوظ من هذا الوجه","takhrij":"أخرجه الترمذي (206) واللفظ له، وابن ماجه (727)","bab":"أذان › فضل التأذين","dorar":"yypgpYBI"},{"id":"س-01862","fp":"b4e5b8067a52","stateId":430,"easy":"إذا أسفرت بصلاة الفجر ← فهو أعظم لأجرك","cause":"أسفِروا بصلاةِ الغداةِ","result":"فإنَّهُ أعظمُ لأجرِكم ، أسفِروا بالفجرِ ، فكلَّما أسفرْتُم فإنَّهُ أعظمُ للأجرِ أو لأجرِكُم","explicit":true,"repOf":"س-06657","ref":"المحلى 3/188","text":[["أسفِروا بصلاةِ الغداةِ ، ",1],["فإنَّهُ أعظمُ لأجرِكم ، أسفِروا بالفجرِ ، فكلَّما أسفرْتُم فإنَّهُ أعظمُ للأجرِ أو لأجرِكُم",2]],"grade":"صحيح","narrator":"رافع بن خديج","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (4/249) (4284)\n\nوالحديث التالي أخرجه الطحاوي في ((شرح معاني الآثار)) (1066)، وأبو نعيم في ((معرفة الصحابة)) (2653) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"jOrA9xH3"},{"id":"س-01871","fp":"d07242a2c602","stateId":430,"easy":"إذا أسفرت بالفجر ← فهو أعظم للأجر","cause":"أَسفِروا بالفجرِ","result":"فكلما أسفرتُم بالفجرِ فهو أعظمُ للأجرِ","explicit":true,"repOf":"س-06657","ref":"الإلمام بأحاديث الأحكام 1/125","text":[["أَسفِروا بالفجرِ",1]," ، ",["فكلما أسفرتُم بالفجرِ فهو أعظمُ للأجرِ",2]," أو قال : لأجورِكم"],"grade":"صحيح","narrator":"رافع بن خديج","muhaddith":"[اشترط في المقدمة أنه] صحيح على طريقة بعض أهل الحديث","takhrij":"أخرجه الطحاوي في ((شرح معاني الآثار)) (1066)، وأبو نعيم في ((معرفة الصحابة)) (2653)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"9jhTqtsX"},{"id":"س-02865","fp":"d64fd922d30a","stateId":430,"easy":"إذا صليت في جماعة أربعين ليلة لا تفوتك الركعة الأولى من العشاء ← يكتب الله لك عتقاً من النار","cause":"مَن صلَّى في مَسجدٍ جماعةً أربعينَ ليلةً ، لا تفوتُهُ الرَّكعةُ الأولى من صلاةِ العشاءِ","result":"كتبَ اللَّهُ لَهُ بِها عتقًا منَ النَّارِ","explicit":true,"otherNeedIds":[66],"ref":"الترغيب والترهيب 1/201","srcLabel":"ابن ماجه","text":[["مَن صلَّى في مَسجدٍ جماعةً أربعينَ ليلةً ، لا تفوتُهُ الرَّكعةُ الأولى من صلاةِ العشاءِ ، ",1],["كتبَ اللَّهُ لَهُ بِها عتقًا منَ النَّارِ",2]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن ماجه (798) واللفظ له، والبيهقي في ((شعب الإيمان)) (2876)، وابن عساكر في ((تاريخ دمشق)) (43/88).","bab":"إيمان › الوعد","dorar":"VPj4qNb8"},{"id":"س-06481","fp":"3edcebe8645f","stateId":430,"easy":"إذا صليت لله أربعين يوماً في جماعة تدرك التكبيرة الأولى ← تُكتب لك براءتان من النار والنفاق","cause":"مَنْ صَلَّى للهِ أربعينَ يومًا في جماعةٍ ، يُدْرِكُ التكبيرةَ الأولى","result":"كُتِبَتْ له براءتانِ : براءةٌ مِنَ النارِ ، وبراءةٌ مِنَ النفاقِ","explicit":true,"similar":["س-06480"],"otherNeedIds":[66],"ref":"هداية الرواة 1102","srcLabel":"الترمذي","text":[["مَنْ صَلَّى للهِ أربعينَ يومًا في جماعةٍ ، يُدْرِكُ التكبيرةَ الأولى ؛ ",1],["كُتِبَتْ له براءتانِ : براءةٌ مِنَ النارِ ، وبراءةٌ مِنَ النفاقِ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (241) واللفظ له، وأحمد (12583) بنحوه","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"j7sw7BK4"},{"id":"س-06543","fp":"b08eea91ee1d","stateId":430,"easy":"إذا صليت في الصف المقدم ← فهو مثل صف الملائكة","cause":"عَلَيكُم بالصَّفِّ المُقَدَّمِ","result":"فإنَّه مِثلُ صَفِّ المَلائكةِ، ولو تَعلَمون ما فيه لَابتَدَرتُمُوه","explicit":true,"ref":"المستدرك على الصحيحين 831","srcLabel":"الحاكم","text":["صَلَّى رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ الصُّبحَ وذَكَر الحَديثَ.[صَلَّى رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ صَلاةَ الصُّبحِ، فقالَ: أشاهِدٌ فُلانٌ؟ لنَفَرٍ منَ المُنافِقين لم يَشهَدوا الصَّلاةَ، ثمَّ قالَ: إنَّ هاتَينِ الصَّلاتَينِ من أثقَلِ الصَّلَواتِ على المُنافِقين، ولو يَعلَمون ما فيهِما لَأَتَوهُما ولو حَبوًا يَعني: صَلاةَ العِشاءِ والصُّبحِ، ثمَّ قالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["عَلَيكُم بالصَّفِّ المُقَدَّمِ؛ ",1],["فإنَّه مِثلُ صَفِّ المَلائكةِ، ولو تَعلَمون ما فيه لَابتَدَرتُمُوه",2],". وقالَ: صَلاتُكَ مع الرَّجُلِ أزكى من صَلاتِكَ وَحدَكَ، وصَلاتُكَ مع الرَّجُلَينِ أزكى من صَلاتِكَ مع الرَّجُلِ، وما أكثَرتَ فهو أحَبُّ إلى اللهِ عزَّ وجلَّ]"],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"[صحيح]","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"bIKgfpYW"},{"id":"س-06604","fp":"f5ef89674014","stateId":430,"easy":"إذا أسفرت بالفجر ← فهو أعظم للأجر","cause":"ما أسفَرتُم بالفجرِ","result":"فإنَّهُ أعظمُ بالأجرِ","explicit":true,"repOf":"س-06657","ref":"صحيح النسائي 548","text":[["ما أسفَرتُم بالفجرِ",1]," ، ",["فإنَّهُ أعظمُ بالأجرِ",2]],"grade":"صحيح","narrator":"رجل من الأنصار","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (549)، والطبراني (4294) (4/ 251) واللفظ لهما، والشيباني في ((الحجة على أهل المدينة)) (1/ 5) بنحوه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"Xu5xXRSE"},{"id":"س-06659","fp":"c90a7db6e288","stateId":430,"easy":"إذا أسفرت بالصبح ← فهو أعظم للأجر","cause":"أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال: ما أسْفَرتُم بالصُّبحِ","result":"فإنَّه أعظَمُ لِلأجْرِ","explicit":true,"repOf":"س-06657","ref":"تنقيح التحقيق 2/33","text":[["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال: ما أسْفَرتُم بالصُّبحِ؛ ",1],["فإنَّه أعظَمُ لِلأجْرِ",2],"."],"grade":"صحيح","narrator":"رجال من الصحابة الأنصار","muhaddith":"[إسناده صحيح]","takhrij":"أخرجه النسائي (549)، وأحمد (17286)، والطحاوي في ((شرح معاني الآثار)) (1067) باختلاف يسير.","bab":"صلاة › مواقيت الصلاة","dorar":"MnbHCfSM"},{"id":"س-07441","fp":"a41bfa8cd7c8","stateId":430,"easy":"إذا أخرجت القذاة من المسجد ← فهو من أجور الأمة المعروضة على النبي ﷺ","cause":"حتَّى القَذاةُ يخرِجُها الرَّجلُ منَ المسجدِ","result":"عُرِضَت عليَّ أجورُ أمَّتي","explicit":true,"ref":"صحيح ابن خزيمة 2/ 448","srcLabel":"ابن خزيمة","text":[["عُرِضَت عليَّ أجورُ أمَّتي",2]," ",["حتَّى القَذاةُ يخرِجُها الرَّجلُ منَ المسجدِ",1],"، وعُرِضَت عليَّ ذُنوبُ أمَّتي فلم أرَ ذنبًا هوَ أعظَمُ مِن سورةٍ منَ القُرآنِ أو آيةٍ أوتيَها رجلٌ ثمَّ نَسيَها"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أخرجه في صحيحه","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"ZfGNeAzE"},{"id":"س-06384","fp":"f660e77df5d9","stateId":430,"easy":"إذا صليت مع من فاتته الجماعة ← فقد تصدقت عليه","cause":"مَن يَتَصدَّقُ على هذا","result":"فيُصلِّيَ معه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-02009"],"ref":"تخريج المسند لشعيب 11408","srcLabel":"الترمذي","text":["أنَّ رَجُلًا دخَلَ المَسجِدَ، وقد صلَّى رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بأصْحابِه، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["مَن يَتَصدَّقُ على هذا",1]," ",["فيُصلِّيَ معه",2],"؟ فقام رَجُلٌ من القَومِ، فصلَّى معه."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (220)، وأحمد (11408) واللفظ له","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"wEammcs0","merged":3,"otherRefs":["إرواء الغليل 535 (صحيح)","فتاوى نور على الدرب لابن باز 12/161 (صحيح)"]},{"id":"س-00490","fp":"bf1a0cb25353","stateId":430,"easy":"إذا وجدت قوماً يصلّون (وقد صليت) فصلِّ معهم ← تكون لك نافلة","cause":"إذا وجدتُما قومًا يصلُّونَ فصلَّيا معَهُم","result":"فإنَّها لَكُما نافلةً","explicit":true,"ref":"الفوائد العلمية من الدروس البازية 8/156","srcLabel":"أبو داود","text":["في حجَّةِ الوداعِ: أنَّ النَّبيَّ صلَّى اللَّهُ عليه وسلَّمَ صلَّى الفجرَ فجيءَ إليه باثنينِ لم يصلَّيا معَه ترعدُ فرائصُهُما فدعا بِهِما فقالَ: ما منعَكُما أن تصلِّيا معَنا؟ فقالا: صلَّينا في رحالِنا. قالَ: لا تفعلا ",["إذا وجدتُما قومًا يصلُّونَ فصلَّيا معَهُم",1]," ",["فإنَّها لَكُما نافلةً",2]],"grade":"حسن","narrator":"يزيد بن الأسود العامري السوائي","muhaddith":"سنده جيد","takhrij":"أخرجه أبو داود (575)، والترمذي (219)، والنسائي (858) باختلاف يسير","bab":"آداب عامة › المباحات من الأفعال والأقوال","dorar":"9lNWP8o2"},{"id":"س-02009","fp":"8ff6c5006f2a","stateId":430,"easy":"إذا صليت مع من فاتته الجماعة ← فقد تصدقت عليه","cause":"فصلَّى معَهُ","result":"أيُّكم يتَّجرُ على هذا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-06384","ref":"صحيح ابن خزيمة 3/ 129","text":["جاءَ رجلٌ وقد صلَّى رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ، فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: ",["أيُّكم يتَّجرُ على هذا",2],"؟ قالَ: فقامَ رجلٌ منَ القومِ، ",["فصلَّى معَهُ",1],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن خزيمة (1632)، والترمذي (220)، وابن أبي شيبة (7172) بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"VhADDjP0"},{"id":"س-06480","fp":"dab4b9630836","stateId":430,"easy":"إذا صليت أربعين يوماً في جماعة لا تفوتك تكبيرة الإحرام ← يكتب الله لك براءتين من النفاق والنار","cause":"من صلَّى أربعين يومًا الصلواتِ في جماعةٍ لا تفوتُه فيها تكبيرةُ الإحرامِ","result":"كتبَ اللهُ له براءتيْنِ براءةً من النفاقِ ، وبراءةً من النارِ","explicit":true,"repOf":"س-06481","otherNeedIds":[66],"ref":"تخريج الإحياء للعراقي 1/203","text":[["من صلَّى أربعين يومًا الصلواتِ في جماعةٍ لا تفوتُه فيها تكبيرةُ الإحرامِ ",1],["كتبَ اللهُ له براءتيْنِ براءةً من النفاقِ ، وبراءةً من النارِ ",2],"."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"رجال إسناده ثقات","takhrij":"أخرجه البزار (7570)، وابن شاهين في ((الترغيب في فضائل الأعمال)) (61)، وابن سمعون الواعظ في ((الأمالي)) (89) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"yQldMDhG"},{"id":"س-06656","fp":"3e28064c5acd","stateId":430,"easy":"إذا أسفرت بالفجر ← فهو أعظم لأجرك","cause":"أسفِروا بِالفَجرِ","result":"فإنَّهُ أعظمُ لأجرِكُم - أو للأَجرِ","explicit":true,"repOf":"س-06657","ref":"نخب الافكار 3/396","text":[["أسفِروا بِالفَجرِ ",1],["فإنَّهُ أعظمُ لأجرِكُم - أو للأَجرِ",2]],"grade":"حسن","narrator":"قتادة بن النعمان","muhaddith":"رجاله ثقات","takhrij":"أخرجه البزار كما في ((كشف الأستار)) للهيثمي (384) بلفظه.","bab":"صلاة › مواقيت الصلاة","dorar":"W5JQalEA"},{"id":"س-06703","fp":"0dc864ec36cd","stateId":430,"easy":"إذا انفردت خلف الصف فاجذب رجلاً ليقوم معك ← فما أعظم أجر المجذوب","cause":"فليَختَلِجْ إلَيه رَجُلًا مِنَ الصَّفِّ فليَقُمْ مَعَه","result":"فما أعظَمَ أجرَ المُختَلِجِ","explicit":true,"ref":"النكت على المحرر 1/117","srcLabel":"أبو داود","text":["إن جاءَ رَجُلٌ فلَم يَجِدْ أحَدًا ",["فليَختَلِجْ إلَيه رَجُلًا مِنَ الصَّفِّ فليَقُمْ مَعَه",1],"، ",["فما أعظَمَ أجرَ المُختَلِجِ",2],"!"],"grade":"حسن","narrator":"مقاتل بن حيان","muhaddith":"[إسناده] كلهم ثقات","takhrij":"أخرجه أبو داود في ((المراسيل)) (83)، والبيهقي (5278) واللفظ لهما.","bab":"صلاة الجماعة والإمامة › صلاة الفذ وحده خلف الصف","dorar":"zKMFqnYL"},{"id":"س-07077","fp":"ea8427725f0a","stateId":430,"easy":"إذا صليت في مسجد عشيرتك ← فهي بخمس عشرة صلاة","cause":"صَلَّى في مَسجِدِ عَشيرَتِه","result":"خَمسَ عَشرةَ صَلاةً","explicit":true,"ref":"إرشاد الساري 6/22","srcLabel":"إرشاد الساري","text":["عن أوْسٍ المَعافِريِّ أنَّه قال لِعَبدِ اللهِ بنِ عَمرِو بنِ العاصِ: أرأيتَ مَن تَوضَّأ فأحسَنَ الوُضوءَ ثم صَلَّى في بَيتِه؟ قال: حَسَنٌ جَميلٌ. قال: فإنْ ",["صَلَّى في مَسجِدِ عَشيرَتِه",1],"؟ قال: ",["خَمسَ عَشرةَ صَلاةً",2],". قال: فإنْ مَشى إلى مَسجِدِ جَماعةٍ فصَلَّى فيه؟ قال: خَمسٌ وعِشرونَ."],"grade":"حسن","narrator":"أوس المعافري","muhaddith":"إسناده حسن","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"FngorTVW"},{"id":"س-07078","fp":"6466cf805804","stateId":430,"easy":"إذا مشيت إلى مسجد جماعة فصليت ← فهي بخمس وعشرين","cause":"مَشى إلى مَسجِدِ جَماعةٍ فصَلَّى فيه","result":"خَمسٌ وعِشرونَ","explicit":true,"ref":"إرشاد الساري 6/22","srcLabel":"إرشاد الساري","text":["عن أوْسٍ المَعافِريِّ أنَّه قال لِعَبدِ اللهِ بنِ عَمرِو بنِ العاصِ: أرأيتَ مَن تَوضَّأ فأحسَنَ الوُضوءَ ثم صَلَّى في بَيتِه؟ قال: حَسَنٌ جَميلٌ. قال: فإنْ صَلَّى في مَسجِدِ عَشيرَتِه؟ قال: خَمسَ عَشرةَ صَلاةً. قال: فإنْ ",["مَشى إلى مَسجِدِ جَماعةٍ فصَلَّى فيه",1],"؟ قال: ",["خَمسٌ وعِشرونَ",2],"."],"grade":"حسن","narrator":"أوس المعافري","muhaddith":"إسناده حسن","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"FngorTVW"},{"id":"س-02304","fp":"3364b74a6168","stateId":430,"easy":"إذا صليت في جماعة ← تفضل على صلاتك وحدك بسبع وعشرين درجة","cause":"صلاةُ الرَّجُلِ في الجَماعةِ","result":"تَفضُلُ على صلاةِ الرَّجُلِ وَحْدَه في بَيْتِه بسَبْعةٍ وعِشرينَ ضِعْفًا","explicit":true,"ref":"الأحاديث المختارة 1836","srcLabel":"البخاري","text":[["«صلاةُ الرَّجُلِ في الجَماعةِ ",1],["تَفضُلُ على صلاةِ الرَّجُلِ وَحْدَه في بَيْتِه بسَبْعةٍ وعِشرينَ ضِعْفًا",2],"، فإذا صلَّى أحَدُكم في المسجِدِ فلْيَجعَلْ في بَيْتِه نَصيبًا مِن صلاتِه؛ فإنَّ اللهَ تعالى جاعِلٌ في بَيْتِه مِن صلاتِه خَيرًا، وإنَّ الشَّيْطانَ لا يدخُلُ بَيْتًا فيه يقرَأُ القُرآنَ»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"m0JjRLEj"},{"id":"س-02794","fp":"3b65886a5cfd","stateId":430,"easy":"إذا شهدت الصلاة مع النبي ﷺ (أو الجماعة) ← فهو أعظم من شاة سمينة أو شاتين","cause":"إذا شهِدَ الصَّلاةَ معي","result":"كان له أَعظَمُ مِن شاةٍ سَمينَةٍ أو شاتَين؛ لَفعَلَ، فما يُصيبُ مِن الأَجرِ أَفضَلُ","explicit":true,"ref":"تخريج المسند لشعيب 7984","srcLabel":"أحمد","text":["لو أنَّ أَحدَكم يَعلَمُ أنَّه ",["إذا شهِدَ الصَّلاةَ معي",1]," ",["كان له أَعظَمُ مِن شاةٍ سَمينَةٍ أو شاتَين؛ لَفعَلَ، فما يُصيبُ مِن الأَجرِ أَفضَلُ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (7984) واللفظ له، والبيهقي في ((شعب الإيمان)) (2855)","bab":"إيمان › النفاق","dorar":"ZVsxKmhv"},{"id":"س-06422","fp":"f1422ce069f9","stateId":431,"easy":"إذا اغتسلت يوم الجمعة ← فالغسل أفضل (والوضوء يجزئ)","cause":"مَن تَوضَّأَ يومَ الجُمعةِ فبِها ونِعمَت","result":"ومنِ اغتَسلَ فالغُسلُ أفضلُ","explicit":true,"star":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"ref":"صحيح ابن ماجه 902","srcLabel":"ابن ماجه","text":[["مَن تَوضَّأَ يومَ الجُمعةِ فبِها ونِعمَت",1]," تُجزِئُ عنهُ الفريضةُ ",["ومنِ اغتَسلَ فالغُسلُ أفضلُ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح دون \"يجزيء عنه الفريضة\"","takhrij":"أخرجه ابن ماجه (1091) واللفظ له، والطيالسي في ((المسند)) (2224)، والبزار (6669) مختصراً.","bab":"صلاة › الوضوء والتطهر للصلاة","dorar":"J0mqJNzO","merged":2,"otherRefs":["صحيح الجامع 6180 (حسن)"]},{"id":"س-01397","fp":"3531f554dcf5","stateId":431,"easy":"إذا توضأت (فغُفر لك) ← كان مشيك إلى المسجد وصلاتك نافلة لك","cause":"ثُم كان مَشْيُهُ إلى المسْجِدِ وصلاتُه","result":"له نافِلَةً","explicit":true,"star":true,"ref":"صحيح الجامع 449","srcLabel":"النسائي","text":["إذا تَوضَّأَ العبدُ المؤمِنُ فتَمضْمَضَ خَرجتِ الخَطايا من فيه ، فإذا اسْتنْثَر خَرجَتِ الخَطايا من أنْفِه ، فإذا غَسَلَ وجْهَهُ خَرَجَتِ الخَطايا من وجْهِهِ ، حتى تَخْرُجَ من تحتِ أشْفارِ عَينَيْهِ ، فإذا غَسَلَ يَدَيْهِ خَرَجَتِ الخطايا من يديه ، حتى تَخْرُجَ من تحتِ أظْفارِ يَدَيْهِ فإذا مَسَحَ بِرأسِه خَرَجَتِ الخَطايا من رأْسِهِ حتى تَخْرُجَ من أُذُنَيْهِ ، فإذا غَسَلَ رِجْلَيْهِ خَرَجَتِ الخَطايا من رِجَلَيْهِ حتى تَخْرُجَ من تَحتِ أظْفارِ رِجْلَيْهِ ",["ثُم كان مَشْيُهُ إلى المسْجِدِ وصلاتُه",1]," ",["له نافِلَةً",2]],"grade":"صحيح","narrator":"عبدالله الصنابحي","muhaddith":"صحيح","takhrij":"أخرجه النسائي (103) واللفظ له، وابن ماجه (282)، وأحمد (19091)، ومالك في ((الموطأ)) (30)","bab":"وضوء › صفة الوضوء","dorar":"kXbX8Dgs"},{"id":"س-01477","fp":"b04ea30a7677","stateId":431,"easy":"إذا توضأت ← فأنت في صلاة ما لم تحدث","cause":"إذا توضَّأ الرجلُ","result":"فهو في صلاةٍ ما لم يُحدِثْ","explicit":true,"star":true,"ref":"مسند علي 273","srcLabel":"أحمد","text":[["إذا توضَّأ الرجلُ ",1],["فهو في صلاةٍ ما لم يُحدِثْ",2]," قال وقال لنا عليٌّ ولن أستحْيِيَكم مما لم يَستحْيي منه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم والحدَثُ أن تفسُوَ أو أن تضرُطَ"],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (1164)، والطبراني في ((المعجم الأوسط)) (1965)، والبيهقي (1066) واللفظ لهم.","bab":"وضوء › فضل الوضوء","dorar":"3rfUHGWq"},{"id":"س-02189","fp":"47400abd26c7","stateId":431,"easy":"إذا اغتسلت يوم الجمعة ← تبقى طاهراً إلى الجمعة الأخرى","cause":"مَن اغتسل يومَ الجمعةِ","result":"لم يزَلْ طاهرًا إلى الجمعةِ الأخرَى","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"ref":"تحفة المحتاج 1/212","srcLabel":"ابن حبان","text":[["مَن اغتسل يومَ الجمعةِ ",1],["لم يزَلْ طاهرًا إلى الجمعةِ الأخرَى",2]],"grade":"صحيح","narrator":"أبو قتادة","muhaddith":"صحيح أو حسن [كما اشترط على نفسه في المقدمة]","takhrij":"أخرجه ابن خزيمة (1760)، وابن حبان (1222) واللفظ لهما، والطبراني في ((المعجم الأوسط)) (8180) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"A4IjfAcW"},{"id":"س-02333","fp":"31823934c381","stateId":431,"easy":"إذا أسبغت الوضوء في البرد الشديد ← فلك أجران","cause":"مَن أسبَغَ الوُضوءَ في البَردِ الشَّديدِ","result":"كان له مِنَ الأجرِ كِفلانِ","explicit":true,"ref":"فيض القدير 6/ 52","srcLabel":"فيض القدير","text":[["مَن أسبَغَ الوُضوءَ في البَردِ الشَّديدِ ",1],["كان له مِنَ الأجرِ كِفلانِ",2]],"grade":"صحيح","narrator":"علي","muhaddith":"ليس لهذا المتن إسناد صحيح","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"cgqUSlyv"},{"id":"س-03453","fp":"78b3fb6f5657","stateId":431,"easy":"إذا سمّيت عند الوضوء وقلت بعده «سبحانك اللهم وبحمدك أستغفرك وأتوب إليك» ← يُختم عليها وتُرفع تحت العرش","cause":"من قالَ إذا توضَّأَ : بسمِ اللَّهِ ، وإذا فرغَ قالَ : سبحانَكَ اللَّهُمَّ وبحمدِكَ أستغفرُك وأتوبُ إليكَ","result":"خُتمُ عليها بخاتَمٍ وفي رواية قيس طُبعَ عليها بطابَعٍ فوُضِعت تحتَ العرشِ فلم تُكسَر إلى يومِ القيامةِ","explicit":true,"apply":{"k":"say","t":"«سبحانك اللهم وبحمدك أستغفرك وأتوب إليك»"},"ref":"نتائج الأفكار 1/245","srcLabel":"النسائي","text":[["من قالَ إذا توضَّأَ : بسمِ اللَّهِ ، وإذا فرغَ قالَ : سبحانَكَ اللَّهُمَّ وبحمدِكَ أستغفرُك وأتوبُ إليكَ",1]," ",["خُتمُ عليها بخاتَمٍ وفي رواية قيس طُبعَ عليها بطابَعٍ فوُضِعت تحتَ العرشِ فلم تُكسَر إلى يومِ القيامةِ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9909) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (1455)، والحاكم (2072) مطولاً باختلاف يسير","bab":"استغفار › فضل الاستغفار","dorar":"D0X4cmDN"},{"id":"س-03728","fp":"ac7d7e2363ea","stateId":431,"easy":"إذا تيممت ثم وجدت الماء فأعدت ← فلك مثل سهم جمع","cause":"فتوضأ أحدُهما، وعاد لصلاتِهِ ما كان في الوقتِ","result":"فلك مِثلُ سَهْمِ جَمْعٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح النسائي 431","srcLabel":"أبو داود","text":["أن رَجُلين تَيَمما وصَلَّيَا، ثم وجدا ماءً في الوقتِ، ",["فتوضأ أحدُهما، وعاد لصلاتِهِ ما كان في الوقتِ",1],"، ولم يُعِدِ الآخَرُ، فسألا النبيَّ صلَّى اللهُ عليهِ وسلَّم ؟ فقال للذي لم يُعِدْ : أَصَبْتَ السنةَ، وأَجْزَأَتْكَ صلاتُك . وقال للآخَرِ : أَمَّا أنت، ",["فلك مِثلُ سَهْمِ جَمْعٍ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه والنسائي (433) واللفظ له، أبو داود (338)،  والدارمي (771)بنحوه.","bab":"اعتصام بالسنة › لزوم السنة","dorar":"SPE9J3fy","merged":2,"otherRefs":["الفوائد العلمية من الدروس البازية 8/156 (صحيح)"]},{"id":"س-03731","fp":"317e0c12d76b","stateId":431,"easy":"إذا صليت ركعتين بالسواك ← فهي أفضل من سبعين ركعة بغير سواك","cause":"ركعتانِ بالسِّواكِ","result":"أفضلُ مِن سبعينَ ركعةً بغيرِ السِّواكِ","explicit":true,"apply":{"k":"count","t":"ركعتين"},"ref":"الترغيب والترهيب 1/136","srcLabel":"أبو نعيم","text":[["ركعتانِ بالسِّواكِ ",1],["أفضلُ مِن سبعينَ ركعةً بغيرِ السِّواكِ",2]],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"إسناده حسن","takhrij":"أخرجه أبو نعيم كما في ((الترغيب والترهيب)) للمنذري (1/102)","bab":"اعتصام بالسنة › لزوم السنة","dorar":"sIFFGKd1"},{"id":"س-07191","fp":"d9a7ae8044ae","stateId":431,"easy":"إذا قمت تصلي (بعد الوضوء) ← تكون لك فضيلة وأجراً","cause":"فإنْ قُمْتَ تُصلِّي","result":"كانت لكَ فَضيلةً وأجْرًا","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"ref":"تخريج زاد المعاد 1/313","srcLabel":"أحمد","text":["حدَّثَنا أبو أُمامةَ، قال: إذا وضَعْتَ الطَّهورَ مَواضِعَه، قُمْتَ مَغْفورًا لكَ، ",["فإنْ قُمْتَ تُصلِّي",1],"، ",["كانت لكَ فَضيلةً وأجْرًا",2],"، فقال رجُلٌ: يا أبا أُمامةَ، أرأيْتَ إنْ قام يُصلِّي تكونُ له نافلةً؟ قال: لا، إنَّما النافلةُ للنبيِّ صلَّى اللهُ عليه وسلَّمَ، فكيف يكونُ له نافلةً، وهو يَسْعى في الذنوبِ والخَطايا؟! تكونُ له فَضيلةً وأجْرًا."],"grade":"حسن","narrator":"أبو غالب","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (22196)، والطبراني (8062)(8/ 276) باختلاف يسير، والبيهقي في ((شعب الإيمان))(2524) بنحوه.","bab":"علم › حسن السؤال ونصح العالم","dorar":"ct9ei1iw"},{"id":"س-08142","fp":"aff6974a612e","stateId":431,"easy":"إذا قلت عند الوضوء «بسم الله والحمد لله» ← تظل حفظتك تكتب لك الحسنات حتى تحدث","cause":"إذا توضأت فقلْ بسمِ اللهِ والحمدُ للهِ","result":"فإن حفَظَتَك لا تبرحُ تكتبُ لك الحسناتَ حتى تُحدثَ من ذلك الوضوءِ","explicit":true,"apply":{"k":"say","t":"«بسم الله والحمد لله»"},"ref":"مجمع الزوائد 1/225","srcLabel":"الطبراني","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم يا أبا هريرةَ ",["إذا توضأت فقلْ بسمِ اللهِ والحمدُ للهِ ",1],["فإن حفَظَتَك لا تبرحُ تكتبُ لك الحسناتَ حتى تُحدثَ من ذلك الوضوءِ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((المعجم الصغير)) (196)، والديلمي في ((الفردوس)) (8396)، وابن الجوزي في ((الموضوعات)) (3/186)","bab":"ملائكة › أعمال الملائكة","dorar":"VGFkXJm8"},{"id":"س-00531","fp":"ee5b62e72640","stateId":432,"easy":"إذا قرأت القرآن وهو عليك شاق ← فلك أجران","cause":"الذي يقرأهُ وهو عليه شاقٌّ","result":"له أجرانِ","explicit":true,"star":true,"similar":["س-07822"],"ref":"معالم التنزيل (تفسير البغوي) 1/61","srcLabel":"متفق عليه","text":["مثَلُ الماهرُ بالقرآنِ مثَلُ السفَرةِ الكرامِ البررَةِ ومثلُ ",["الذي يقرأهُ وهو عليه شاقٌّ",1]," ",["له أجرانِ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه البغوي في ((شرح السنة)) (1173) بلفظه، وأخرجه البخاري  (4937)، ومسلم (798) بلفظ مقارب دون قوله: ((مثل))","bab":"آداب عامة › ضرب الأمثال","dorar":"mVPauBcc"},{"id":"س-02031","fp":"c582109a3490","stateId":432,"easy":"إذا قرأت مئة آية ← يُكتب لك قنوت ليلة","cause":"ومَن قَرَأَ مِئةَ آيةٍ","result":"كُتِبَ له قُنوتُ لَيْلةٍ","explicit":true,"star":true,"similar":["س-02043"],"ref":"الأحاديث المختارة 8 / 278","srcLabel":"متفق عليه","text":["(«مَن قَرَأَ عَشْرَ آياتٍ في لَيْلةٍ لم يُكتَبْ مِن الغافِلينَ) ",["ومَن قَرَأَ مِئةَ آيةٍ ",1],["كُتِبَ له قُنوتُ لَيْلةٍ، ",2],"ومَن قَرَأَ مِئَتي آيةٍ كُتِبَ مِن القانِتينَ، ومَن قَرَأَ أرْبَعَمِئةٍ كُتِبَ مِن المُخْبِتينَ، ومَن قَرَأَ ألْفَ آيةٍ أصْبَحَ وله قِنْطارٌ ألْفٌ ومِئَتا أوقِيَّةٍ، الأوقِيَّةُ خَيْرٌ مِمَّا بَيْنَ السَّماءِ والأرْضِ، ومَن قَرَأَ ألْفَي آيةٍ كانَ مِن المُوجِبينَ»."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"q8mF6vVQ"},{"id":"س-02032","fp":"8803b4c24132","stateId":432,"easy":"إذا قرأت مئتي آية ← تُكتب من القانتين","cause":"ومَن قَرَأَ مِئَتي آيةٍ","result":"كُتِبَ مِن القانِتينَ","explicit":true,"star":true,"similar":["س-02255"],"ref":"الأحاديث المختارة 8 / 278","srcLabel":"متفق عليه","text":["(«مَن قَرَأَ عَشْرَ آياتٍ في لَيْلةٍ لم يُكتَبْ مِن الغافِلينَ) ومَن قَرَأَ مِئةَ آيةٍ كُتِبَ له قُنوتُ لَيْلةٍ، ",["ومَن قَرَأَ مِئَتي آيةٍ ",1],["كُتِبَ مِن القانِتينَ، ",2],"ومَن قَرَأَ أرْبَعَمِئةٍ كُتِبَ مِن المُخْبِتينَ، ومَن قَرَأَ ألْفَ آيةٍ أصْبَحَ وله قِنْطارٌ ألْفٌ ومِئَتا أوقِيَّةٍ، الأوقِيَّةُ خَيْرٌ مِمَّا بَيْنَ السَّماءِ والأرْضِ، ومَن قَرَأَ ألْفَي آيةٍ كانَ مِن المُوجِبينَ»."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"q8mF6vVQ"},{"id":"س-02033","fp":"14bea2e53e83","stateId":432,"easy":"إذا قرأت أربعمئة آية ← تُكتب من المخبتين","cause":"ومَن قَرَأَ أرْبَعَمِئةٍ","result":"كُتِبَ مِن المُخْبِتينَ","explicit":true,"star":true,"ref":"الأحاديث المختارة 8 / 278","srcLabel":"متفق عليه","text":["(«مَن قَرَأَ عَشْرَ آياتٍ في لَيْلةٍ لم يُكتَبْ مِن الغافِلينَ) ومَن قَرَأَ مِئةَ آيةٍ كُتِبَ له قُنوتُ لَيْلةٍ، ومَن قَرَأَ مِئَتي آيةٍ كُتِبَ مِن القانِتينَ، ",["ومَن قَرَأَ أرْبَعَمِئةٍ ",1],["كُتِبَ مِن المُخْبِتينَ، ",2],"ومَن قَرَأَ ألْفَ آيةٍ أصْبَحَ وله قِنْطارٌ ألْفٌ ومِئَتا أوقِيَّةٍ، الأوقِيَّةُ خَيْرٌ مِمَّا بَيْنَ السَّماءِ والأرْضِ، ومَن قَرَأَ ألْفَي آيةٍ كانَ مِن المُوجِبينَ»."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"q8mF6vVQ"},{"id":"س-07822","fp":"0b80b287ddb3","stateId":432,"easy":"إذا قرأت القرآن وأنت تتعاهده وهو عليك شديد ← فلك أجران","cause":"ومَثَلُ الذي يَقرَأُ وهو يَتَعاهَدُه، وهو عليه شَديدٌ","result":"فلَه أجرانِ","explicit":true,"repOf":"س-00531","ref":"صحيح البخاري 4937","text":["مَثَلُ الذي يَقرَأُ القُرآنَ وهو حافِظٌ له، مع السَّفَرةِ الكِرامِ البَرَرةِ، ",["ومَثَلُ الذي يَقرَأُ وهو يَتَعاهَدُه، وهو عليه شَديدٌ",1],"؛ ",["فلَه أجرانِ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (798) بلفظ مقارب","bab":"قرآن › فضل قراءة القرآن","dorar":"emqPdm3o","merged":2,"otherRefs":["تخريج المسند لشعيب 24634 (صحيح)"]},{"id":"ق-0441","fp":"603f8647d476","stateId":432,"easy":"التمسك بالكتاب وإقامة الصلاة ← لا يضيع أجر المصلحين","cause":"التمسك بالكتاب وإقامة الصلاة","result":"لا يضيع أجر المصلحين","explicit":true,"ref":"سورة الأعراف: 170","srcLabel":"القرآن الكريم","quran":{"s":7,"from":170,"to":170,"text":"وَالَّذِينَ يُمَسِّكُونَ بِالْكِتَابِ وَأَقَامُوا الصَّلَاةَ إِنَّا لَا نُضِيعُ أَجْرَ الْمُصْلِحِينَ (170)","hl":[[0,101,1]]}},{"id":"ق-1028","fp":"c2a97f30f96b","stateId":432,"easy":"تلاوة كتاب الله وإقامة الصلاة والإنفاق سراً وعلانية ← تجارة لن تبور وتوفية الأجور وزيادة من فضل الله","cause":"تلاوة كتاب الله وإقامة الصلاة والإنفاق سراً وعلانية","result":"تجارة لن تبور وتوفية الأجور وزيادة من فضل الله","explicit":true,"otherNeedIds":[1,11],"ref":"سورة فاطر: 29–30","srcLabel":"القرآن الكريم","quran":{"s":35,"from":29,"to":30,"text":"إِنَّ الَّذِينَ يَتْلُونَ كِتَابَ اللَّهِ وَأَقَامُوا الصَّلَاةَ وَأَنْفَقُوا مِمَّا رَزَقْنَاهُمْ سِرًّا وَعَلَانِيَةً يَرْجُونَ تِجَارَةً لَنْ تَبُورَ (29) لِيُوَفِّيَهُمْ أُجُورَهُمْ وَيَزِيدَهُمْ مِنْ فَضْلِهِ إِنَّهُ غَفُورٌ شَكُورٌ (30)","hl":[[0,237,1]]}},{"id":"س-00697","fp":"fa059d3da1c4","stateId":432,"easy":"إذا قرأت القرآن ← تُؤجر بكل حرف عشر حسنات","cause":"اقرؤوا القرآنَ","result":"فإنَّكم تُؤجرونَ عليه ، أما إني لا أقولُ آلم حرفٌ ، و لكنْ ألفٌ عشرٌ ، و لامٌ عشرٌ ، و ميمٌ عشرٌ ، فتلك ثلاثونَ","explicit":true,"similar":["س-03409","س-00765"],"ref":"صحيح الجامع 1164","srcLabel":"الدارقطني","text":[["اقرؤوا القرآنَ",1]," ، ",["فإنَّكم تُؤجرونَ عليه ، أما إني لا أقولُ  آلم  حرفٌ ، و لكنْ ألفٌ عشرٌ ، و لامٌ عشرٌ ، و ميمٌ عشرٌ ، فتلك ثلاثونَ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه الدارقطني في ((علله)) (5/326)","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"3tWLABDM"},{"id":"س-01915","fp":"9a48b6491567","stateId":432,"easy":"إذا قرأت حرفاً من القرآن ← فلك به حسنة والحسنة بعشر أمثالها","cause":"من قرأ حرفًا من كتابِ اللهِ","result":"فله به حسنةٌ ، والحسنةُ بعشرِ أمثالِها ، لا أقولُ : آلم حرف ؛ ولكن ( ألفٌ ) حرف ، و( لامٌ ) حرف ، و( ميمٌ ) حرف","explicit":true,"ref":"صفة الصلاة 101","srcLabel":"الترمذي","text":[["من قرأ حرفًا من كتابِ اللهِ ",1],["فله به حسنةٌ ، والحسنةُ بعشرِ أمثالِها ، لا أقولُ :  آلم  حرف ؛ ولكن ( ألفٌ ) حرف ، و( لامٌ ) حرف ، و( ميمٌ ) حرف",2]],"grade":"صحيح","narrator":"[عبدالله بن مسعود]","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (2910) واللفظ له، وأبو نعيم في ((حلية الأولياء)) (6/263)، والبيهقي في ((شعب الإيمان)) (1983) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"ewBzm8wG"},{"id":"س-01919","fp":"c66c760a809e","stateId":432,"easy":"إذا رجعت من سوقك فقرأت عشر آيات ← يكتب الله لك بكل آية حسنة","cause":"إذا رجَع مِن سوقِه أن يقرَأَ عشْرَ آياتٍ","result":"فيكتُبَ اللهُ له بكلِّ آيةٍ حسنةً","explicit":true,"ref":"مجمع الزوائد 10/132","srcLabel":"الطبراني","text":["يا معشرَ التُّجَّارِ أيعجِزُ أحدُكم ",["إذا رجَع مِن سوقِه أن يقرَأَ عشْرَ آياتٍ",1]," ",["فيكتُبَ اللهُ له بكلِّ آيةٍ حسنةً",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"رجاله رجال الصحيح غير الربيع بن ثعلب وأبي إسماعيل المؤدب وكلاهما ثقة","takhrij":"أخرجه الطبراني (11/398) (12119)، والبيهقي في ((شعب الإيمان)) (2198) واللفظ لهما، وابن عدي في ((الكامل في الضعفاء)) (1/250) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"LAXAdJ2e"},{"id":"س-02043","fp":"77329081fd72","stateId":432,"easy":"إذا قرأت مئة آية في ليلة ← يُكتب لك قنوت ليلة","cause":"مَنْ قرأَ بِمِائَةِ آيَةٍ في ليلةٍ","result":"كُتِبَ لهُ قُنُوتُ ليلةٍ","explicit":true,"repOf":"س-02031","ref":"السلسلة الصحيحة 644","text":[["مَنْ قرأَ بِمِائَةِ آيَةٍ في ليلةٍ ",1],["كُتِبَ لهُ قُنُوتُ ليلةٍ",2]],"grade":"صحيح","narrator":"تميم الداري","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10553)، وأحمد (16958)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"82O1XGJQ"},{"id":"س-03149","fp":"bac80dce8e95","stateId":432,"easy":"إذا قرأت القرآن ← فقد أُدرجت النبوة بين جنبيك غير أنه لا يُوحى إليك","cause":"مَنْ قَرَأَ القرآنَ","result":"فقد استَدْرَجَ النُّبوَّةَ بيْنَ جَنبَيْهِ غيرَ أنَّه لا يُوحَى إليه، لا يَنبَغي لصاحبِ القرآنِ أنْ يَحِدَّ مع مَنْ حَدَّ، ولا يَجهَلَ مع مَنْ جَهِلَ وفي جوفِهِ كلامُ اللهِ تَعالَى","explicit":true,"otherNeedIds":[18],"ref":"المستدرك على الصحيحين 2054","srcLabel":"البيهقي","text":[["مَنْ قَرَأَ القرآنَ؛ ",1],["فقد استَدْرَجَ النُّبوَّةَ بيْنَ جَنبَيْهِ غيرَ أنَّه لا يُوحَى إليه، لا يَنبَغي لصاحبِ القرآنِ أنْ يَحِدَّ مع مَنْ حَدَّ، ولا يَجهَلَ مع مَنْ جَهِلَ وفي جوفِهِ كلامُ اللهِ تَعالَى",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((الأسماء والصفات)) (581) بلفظه، وابن المبارك في ((الزهد)) (799) بلفظ مقارب.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"MZ3B4XIf"},{"id":"س-03409","fp":"158215a1b049","stateId":432,"easy":"إذا قرأت القرآن فأعربته ← فلك بكل حرف عشر حسنات","cause":"مَن قرأَ القرآنَ فأعربَهُ","result":"فلَهُ بِكُلِّ حرفٍ منه عَشرُ حَسَناتٍ","explicit":true,"repOf":"س-00697","ref":"الكافي لابن قدامة 1/187","text":[["مَن قرأَ القرآنَ فأعربَهُ ",1],["فلَهُ بِكُلِّ حرفٍ منه عَشرُ حَسَناتٍ ، ",2],"ومَن قرأَهُ ولحنَ فيهِ فلَهُ بِكُلِّ حرفٍ حَسنةٌ"],"grade":"صحيح","muhaddith":"حسن صحيح","bab":"استغفار › أسباب المغفرة","dorar":"t9dLzWQc"},{"id":"س-03410","fp":"bb8cc7dc863f","stateId":432,"easy":"إذا قرأته ولحنت فيه ← فلك بكل حرف حسنة","cause":"ومَن قرأَهُ ولحنَ فيهِ","result":"فلَهُ بِكُلِّ حرفٍ حَسنةٌ","explicit":true,"ref":"الكافي لابن قدامة 1/187","srcLabel":"الكافي لابن قدامة","text":["مَن قرأَ القرآنَ فأعربَهُ فلَهُ بِكُلِّ حرفٍ منه عَشرُ حَسَناتٍ ، ",["ومَن قرأَهُ ولحنَ فيهِ ",1],["فلَهُ بِكُلِّ حرفٍ حَسنةٌ",2]],"grade":"صحيح","muhaddith":"حسن صحيح","bab":"استغفار › أسباب المغفرة","dorar":"t9dLzWQc"},{"id":"س-07826","fp":"804e8012b944","stateId":432,"easy":"إذا قرأت «قل هو الله أحد» مئتي مرة ← يكتب الله لك ألفاً وخمسمئة حسنة إلا أن يكون عليك دين","cause":"مَن قَرَأ {قُل هو اللهُ أحَدٌ} مِائَتَي مَرَّةٍ","result":"كَتَبَ اللهُ له ألفًا وخمسَمائةِ حَسَنةٍ، إلَّا أن يَكونَ عليه دَينٌ","explicit":true,"apply":{"k":"say","t":"«قل هو الله أحد»"},"ref":"الفوائد المجموعة 304","srcLabel":"الترمذي","text":[["مَن قَرَأ {قُل هو اللهُ أحَدٌ} مِائَتَي مَرَّةٍ، ",1],["كَتَبَ اللهُ له ألفًا وخمسَمائةِ حَسَنةٍ، إلَّا أن يَكونَ عليه دَينٌ",2]],"grade":"صحيح","narrator":"أنس","muhaddith":"لم يسق السيوطي الأسانيد، وانما ذكر أنه جاء عن الحسن بن أبي جعفر والاغلب بن تميم وصالح المري كل منهم عن ثابت عن الحسن وهؤلاء الثلاثة ليسوا في الرواية بشيء","takhrij":"أخرجه أبو يعلى (3365)، والبيهقي في ((الشعب)) (2316) واللفظ لهما، والترمذي (2898) بنحوه.","bab":"قرآن › فضل قراءة القرآن","dorar":"QsMCsyLF"},{"id":"س-00765","fp":"4562730462b8","stateId":432,"easy":"إذا قرأت القرآن ← تُؤجر بكل حرف عشر حسنات","cause":"اقرءوا القرآنَ","result":"فإنَّكم تُؤجَرون عليه ، أما إنِّي لا أقولُ : الم حرفٌ ، ولكن ألِفٌ عشرٌ ، ولامٌ عشرٌ ، وميمٌ عشرٌ ، فتلك ثلاثون","explicit":true,"repOf":"س-00697","ref":"السلسلة الصحيحة 660","text":[["اقرءوا القرآنَ ، ",1],["فإنَّكم تُؤجَرون عليه ، أما إنِّي لا أقولُ :  الم  حرفٌ ، ولكن ألِفٌ عشرٌ ، ولامٌ عشرٌ ، وميمٌ عشرٌ ، فتلك ثلاثون",2]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"إسناده جيد","takhrij":"أخرجه الدارقطني في ((علله)) (5/326)","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"mxGKHe6D"},{"id":"س-02103","fp":"08549218942b","stateId":432,"easy":"إذا استمعت إلى آية من كتاب الله ← تُكتب لك حسنة مضاعفة","cause":"منِ استمَعَ إلى آيةٍ من كتابِ اللَّهِ","result":"كتبت لَهُ حسنةٌ مضاعَفةٌ","explicit":true,"ref":"الدر المنثور 6/726","srcLabel":"أحمد","text":[["منِ استمَعَ إلى آيةٍ من كتابِ اللَّهِ ",1],["كتبت لَهُ حسنةٌ مضاعَفةٌ ",2],"ومن تلاها كانت لَهُ نورًا يومَ القيامَةِ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (8475)، وابن منده في ((من يقول الم حرف)) (24) واللفظ لهما، والعقيلي في ((الضعفاء)) (3/ 133)، وأبو عمرو الداني في ((البيان)) (ص23) كلاهما بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"DJOL6Vmp"},{"id":"س-02255","fp":"a95e04cae58a","stateId":432,"easy":"إذا قرأت مئة آية ← تُكتب من القانتين","cause":"ومَن قرَأَ مِئَةَ آيَةٍ","result":"كُتِبَ من القانِتينَ","explicit":true,"repOf":"س-02032","ref":"مجمع الزوائد 2/271","text":["مَن قرَأَ في لَيلَةٍ خَمسينَ آيَةً، لم يُكتَبْ من الغافِلينَ، ",["ومَن قرَأَ مِئَةَ آيَةٍ، ",1],["كُتِبَ من القانِتينَ، ",2],"ومَن قرَأَ ثَلاثَ مِئَةِ آيةٍ كُتِبَ له قِنطارٌ، ومَن قرَأَ بسَبعِ مِئَةٍ أفلَحَ."],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"رجاله ثقات","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"ZyHKYTlq"},{"id":"س-02256","fp":"196413247a34","stateId":432,"easy":"إذا قرأت ثلاثمئة آية ← يُكتب لك قنطار","cause":"ومَن قرَأَ ثَلاثَ مِئَةِ آيةٍ","result":"كُتِبَ له قِنطارٌ","explicit":true,"ref":"مجمع الزوائد 2/271","srcLabel":"مجمع الزوائد","text":["مَن قرَأَ في لَيلَةٍ خَمسينَ آيَةً، لم يُكتَبْ من الغافِلينَ، ومَن قرَأَ مِئَةَ آيَةٍ، كُتِبَ من القانِتينَ، ",["ومَن قرَأَ ثَلاثَ مِئَةِ آيةٍ ",1],["كُتِبَ له قِنطارٌ، ",2],"ومَن قرَأَ بسَبعِ مِئَةٍ أفلَحَ."],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"رجاله ثقات","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"ZyHKYTlq"},{"id":"س-07825","fp":"b48c9b0891a1","stateId":432,"easy":"إذا قرأت آية الكرسي دبر كل صلاة مكتوبة ← تُعطى قلوب الشاكرين وثواب النبيين وأعمال الصديقين","cause":"مَن قَرأ آيةَ الكُرسيِّ دُبُرَ كلِّ صلاةٍ مَكتوبةٍ أُعطِيَ قُلوبَ الشاكِرينَ","result":"وثَوابَ النَّبيِّينَ، وأعمالَ الصِّدِّيقينَ","explicit":true,"apply":{"k":"read","t":"آية الكرسي · الوقت: دبر كل صلاة"},"ref":"ترتيب الموضوعات 62","srcLabel":"ترتيب الموضوعات","text":[["مَن قَرأ آيةَ الكُرسيِّ دُبُرَ كلِّ صلاةٍ مَكتوبةٍ أُعطِيَ قُلوبَ الشاكِرينَ، ",1],["وثَوابَ النَّبيِّينَ، وأعمالَ الصِّدِّيقينَ",2],"."],"grade":"حسن","muhaddith":"سند مظلم إلى حسن بن محمد _ ولا يدري من هو","bab":"قرآن › فضل قراءة القرآن","dorar":"xaTpfeVq"},{"id":"س-07807","fp":"adcad04e8bea","stateId":432,"easy":"إذا كنت مؤمناً تقرأ القرآن ← فمثلك كالأترجة ريحها طيب وطعمها طيب","cause":"مَثَلُ المُؤمِنِ الذي يَقرَأُ القُرآنَ","result":"مَثَلُ الأُترُجَّةِ، ريحُها طَيِّبٌ وطَعمُها طَيِّبٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"صحيح مسلم 797","srcLabel":"متفق عليه","text":[["مَثَلُ المُؤمِنِ الذي يَقرَأُ القُرآنَ",1]," ",["مَثَلُ الأُترُجَّةِ، ريحُها طَيِّبٌ وطَعمُها طَيِّبٌ",2],"، ومَثَلُ المُؤمِنِ الذي لا يَقرَأُ القُرآنَ مَثَلُ التَّمرةِ، لا ريحَ لها وطَعمُها حُلوٌ، ومَثَلُ المُنافِقِ الذي يَقرَأُ القُرآنَ مَثَلُ الرَّيحانةِ، ريحُها طَيِّبٌ وطَعمُها مُرٌّ، ومَثَلُ المُنافِقِ الذي لا يَقرَأُ القُرآنَ كمَثَلِ الحَنظَلةِ، ليس لها ريحٌ وطَعمُها مُرٌّ. في حَديثِ هَمَّامٍ، بَدَلَ المُنافِقِ: الفاجِرِ."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5427)، ومسلم (797).","bab":"قرآن › فضل قراءة القرآن","dorar":"snr3jsjJ","merged":2,"otherRefs":["صحيح البخاري 5059 (صحيح)"]},{"id":"س-01964","fp":"b8a27d9d84ca","stateId":433,"easy":"إذا تصدقت من طيب ← يضعها الله في كفه ويربيها لك","cause":"ما مِن عبدٍ مُؤمنٍ تصدَّقَ بصَدَقةٍ مِن طَيِّبٍ، ولا يَقبَلُ اللهُ","result":"إلَّا طَيِّبًا، ولا يَصعَدُ إلى السَّماءِ إلَّا طَيِّبٌ، إلَّا وهو يَضَعُها في يَدِ الرَّحمنِ -أو في كَفِّ الرَّحمنِ- فيُرَبِّيها له كما يُرَبِّي أحدُكم فَلُوَّه -أو فَصيلَه- حتى إنَّ التَّمرةَ لتَكونُ","explicit":true,"similar":["س-06941","س-00540","س-01948","س-02005","س-03888","س-06289","س-06290","س-06851","س-06921","س-06870","س-00617","س-00624","س-00646","س-06919"],"ref":"تخريج المسند لشعيب 9423","srcLabel":"متفق عليه","text":[["ما مِن عبدٍ مُؤمنٍ تصدَّقَ بصَدَقةٍ مِن طَيِّبٍ، ولا يَقبَلُ اللهُ",1]," ",["إلَّا طَيِّبًا، ولا يَصعَدُ إلى السَّماءِ إلَّا طَيِّبٌ، إلَّا وهو يَضَعُها في يَدِ الرَّحمنِ -أو في كَفِّ الرَّحمنِ- فيُرَبِّيها له كما يُرَبِّي أحدُكم فَلُوَّه -أو فَصيلَه- حتى إنَّ التَّمرةَ لتَكونُ",2]," مِثْلَ الجَبَلِ العَظيمِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1410)، ومسلم (1014)، والترمذي (661)، والنسائي (2525)، وابن ماجه (1842) بنحوه، وأحمد (9423) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"FM3xXSxM","merged":2,"otherRefs":["تخريج صحيح ابن حبان 270 (صحيح)"]},{"id":"س-06941","fp":"aade9b9302de","stateId":433,"easy":"إذا تصدقت بعدل تمرة من كسب طيب ← يقبلها الله بيمينه ويربيها لك","cause":"مَن تصدَّقَ بعدلِ تَمرَةٍ من كِسبٍ طَيِّبٍ ولا يقبَلُ اللَّهُ إلا طيِّبًا","result":"فإنَّ اللَّهَ يقبَلُها بيمينِهِ ثُمَّ يُرَبِّيها لصاحِبِها كما يُرَبِّي أحدُكم فَلُوَّهُ حتَّى تكونَ مثلَ الجبلِ","explicit":true,"repOf":"س-01964","otherNeedIds":[51],"ref":"الزواجر عن اقتراف الكبائر 1/192","text":[["مَن تصدَّقَ بعدلِ تَمرَةٍ من كِسبٍ طَيِّبٍ ولا يقبَلُ اللَّهُ إلا طيِّبًا ",1],["فإنَّ اللَّهَ يقبَلُها بيمينِهِ ثُمَّ يُرَبِّيها لصاحِبِها كما يُرَبِّي أحدُكم فَلُوَّهُ حتَّى تكونَ مثلَ الجبلِ",2]," وفي روايةٍ : كما يرَبِّي أحدُكم مُهرَهُ حتَّى إنَّ اللُّقمَةَ لتصيرُ مثلَ أُحُدٍ"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"صحيح أو حسن","takhrij":"أخرجه البخاري (1410)، ومسلم (1014) باختلاف يسير. والرواية: أخرجها مطولاً الترمذي (662) واللفظ له، وأحمد (10088)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"sktOXWBv","merged":2,"otherRefs":["صحيح ابن حبان 3319 (صحيح)"]},{"id":"س-00540","fp":"22aa49b795ed","stateId":433,"easy":"إذا تصدقت من كسب طيب ← يضعها الله في كفه ويربيها لك حتى تصير كالجبل","cause":"ما مِن مُسلِمٍ يتصَدَّقُ بصَدَقةٍ مِن كَسْبٍ طَيِّبٍ، ولا يَصعَدُ إلى السَّماءِ إلَّا طَيِّبٌ","result":"إلَّا كأنَّما يَضَعُها في كَفِّ الرَّحمنِ عزَّ وجلَّ، فيُرَبِّيها كما يُرَبِّي أحدُكم فَلُوَّه، أو فَصيلَه، حتى إنَّ التَّمرةَ لَتَعودُ مِثْلَ الجَبَلِ العَظيمِ","explicit":true,"repOf":"س-01964","otherNeedIds":[51],"ref":"تخريج المسند لشعيب 9565","text":[["ما مِن مُسلِمٍ يتصَدَّقُ بصَدَقةٍ مِن كَسْبٍ طَيِّبٍ، ولا يَصعَدُ إلى السَّماءِ إلَّا طَيِّبٌ",1],"، ",["إلَّا كأنَّما يَضَعُها في كَفِّ الرَّحمنِ عزَّ وجلَّ، فيُرَبِّيها كما يُرَبِّي أحدُكم فَلُوَّه، أو فَصيلَه، حتى إنَّ التَّمرةَ لَتَعودُ مِثْلَ الجَبَلِ العَظيمِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1410)، ومسلم (1014)، والترمذي (661)، والنسائي (2525)، وابن ماجه (1842) بنحوه، وأحمد (9565) واللفظ له","bab":"آداب عامة › ضرب الأمثال","dorar":"OiB2sfoy"},{"id":"س-01948","fp":"4e0c36c27eb8","stateId":433,"easy":"إذا تصدقت بتمرة من طيب ← يجعلها الله في كفه ويربيها لك","cause":"إنَّ أحدَكم ليتصدَّقُ بالتَّمرةِ إذا كانت مِن طيِّبٍ","result":"فيجعَلُها اللهُ في كَفِّه فيُربِّيها كما يُربِّي أحدُكم فَلُوَّه أو فَصيلَه حتَّى تكونَ في يدِه جلَّ وعلا مِثلَ جبلٍ","explicit":true,"repOf":"س-01964","ref":"صحيح ابن حبان 3318","text":[["إنَّ أحدَكم ليتصدَّقُ بالتَّمرةِ إذا كانت مِن طيِّبٍ",1]," ـ ولا يقبَلُ اللهُ إلَّا الطَّيِّبَ ـ ",["فيجعَلُها اللهُ في كَفِّه فيُربِّيها كما يُربِّي أحدُكم فَلُوَّه أو فَصيلَه حتَّى تكونَ في يدِه جلَّ وعلا مِثلَ جبلٍ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (7430)، ومسلم (1014) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"fnfNb5OP"},{"id":"س-02005","fp":"d400d1ffd872","stateId":433,"easy":"إذا تصدقت من كسب طيب ← يأخذها الله بيمينه ويربيها لك","cause":"ما مِن عبدٍ مُسلمٍ يتصدَّقُ بصدقةٍ من كسبٍ طيِّبٍ ولا يقبلُ اللَّهُ","result":"إلَّا الطَّيِّبَ إلَّا اللَّهُ يأخذُها بيمينِهِ، فيربِّيها لَهُ كما يربِّي أحدُكُم، فلوَّهُ","explicit":true,"repOf":"س-01964","ref":"صحيح ابن خزيمة 4/ 155","text":[["ما مِن عبدٍ مُسلمٍ يتصدَّقُ بصدقةٍ من كسبٍ طيِّبٍ ولا يقبلُ اللَّهُ",1]," ",["إلَّا الطَّيِّبَ إلَّا اللَّهُ يأخذُها بيمينِهِ، فيربِّيها لَهُ كما يربِّي أحدُكُم، فلوَّهُ",2]," أو قالَ فصيلَهُ، حتَّى تبلُغَ التَّمرةُ مثلَ أُحدٍ، وقالَ عُتبةُ: فلوَّهُ قلوصَهُ. ولم أضبِط عن عُتبةَ مثلَ أُحُدٍ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (1410)، ومسلم (1014)، والنسائي (2525) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"SpFEw3fm"},{"id":"س-03888","fp":"c51d4dcc0b95","stateId":433,"easy":"إذا تصدقت من طيب ← يأخذها الله بيمينه ويربيها لك","cause":"إن الله تباركَ وتعالى يقبلُ الصدقاتِ ، ولا يقبلُ منها إلا الطيبُ","result":"يأخذها بيَمينهِ ، ثم يُرَبِّيها لصاحبهِ كما يُربِّي أحدكُم مهرهُ أو فصيلهُ حتى تصيرَ اللقمَةُ مثلَ أُحدٍ","explicit":true,"repOf":"س-01964","ref":"شرح السنة 3/398","text":[["إن الله تباركَ وتعالى يقبلُ الصدقاتِ ، ولا يقبلُ منها إلا الطيبُ",1]," ",["يأخذها بيَمينهِ ، ثم يُرَبِّيها لصاحبهِ كما يُربِّي أحدكُم مهرهُ أو فصيلهُ حتى تصيرَ اللقمَةُ مثلَ أُحدٍ",2]," وتصديقُ ذلكَ في كتابِ اللهِ سُبحانهُ وتعالى المنزلُ { يَمْحَقُ اللَهُ الرِّبَا وَيُرْبِي الصَّدَقَاتِ } و{ أَنَّ اللهَ هُوَ يَقْبَلُ التَّوْبَةَ عَنْ عِبَادِهِ وَيَأْخُذُ الصَّدَقَاتِ }"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (662) باختلاف يسير، وأخرجه البخاري (7430)، ومسلم (1014) باختلاف يسير دون قوله: \"حتى تصير اللقمة ...\"","bab":"تفسير آيات › سورة التوبة","dorar":"idhnsaCL"},{"id":"س-06289","fp":"a73ede3c363e","stateId":433,"easy":"إذا تصدقت من طيب ← يقبلها الله بيمينه ويربيها لك","cause":"إنَّ اللهَ عزَّ وجلَّ يَقبَلُ الصَّدَقةَ، ولا يَقبَلُ منها إلَّا الطَّيِّبَ","result":"يَقبَلُها بيَمينِه تَبارَكَ وتَعالى، يُرَبِّيها لعَبدِه المُسلِمِ كما يُرَبِّي أحدُكم مُهْرَه، أو فَصيلَه، حتى يُوافَى بها يَومَ القِيامةِ مِثْلَ أُحُدٍ","explicit":true,"repOf":"س-01964","ref":"تخريج المسند لشعيب 9245","text":[["إنَّ اللهَ عزَّ وجلَّ يَقبَلُ الصَّدَقةَ، ولا يَقبَلُ منها إلَّا الطَّيِّبَ",1],"، ",["يَقبَلُها بيَمينِه تَبارَكَ وتَعالى، يُرَبِّيها لعَبدِه المُسلِمِ كما يُرَبِّي أحدُكم مُهْرَه، أو فَصيلَه، حتى يُوافَى بها يَومَ القِيامةِ مِثْلَ أُحُدٍ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1410)، ومسلم (1014)، والترمذي (661)، والنسائي (2525)، وابن ماجه (1842) بنحوه، وأحمد (9245) واللفظ له","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"eckGyM8Y"},{"id":"س-06290","fp":"b06c2d93bba3","stateId":433,"easy":"إذا تصدقت بتمرة من طيب ← تقع في يد الله فيربيها لك","cause":"إنَّ الرَّجُلَ إذا تصَدَّقَ بتَمرةٍ مِنَ الطَّيِّبِ","result":"ولا يَقبَلُ اللهُ إلَّا الطَّيِّبَ، وقَعَتْ في يَدِ اللهِ فيُرَبِّيها له كما يُرَبِّي أحدُكم فَلُوَّهُ، أو فَصيلَهُ، حتى تَعودَ في يَدِهِ مِثلَ الجَبَلِ","explicit":true,"repOf":"س-01964","ref":"تخريج المسند لشعيب 10979","text":[["إنَّ الرَّجُلَ إذا تصَدَّقَ بتَمرةٍ مِنَ الطَّيِّبِ، ",1],["ولا يَقبَلُ اللهُ إلَّا الطَّيِّبَ، وقَعَتْ في يَدِ اللهِ فيُرَبِّيها له كما يُرَبِّي أحدُكم فَلُوَّهُ، أو فَصيلَهُ، حتى تَعودَ في يَدِهِ مِثلَ الجَبَلِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1410)، ومسلم (1014)، والترمذي (661)، والنسائي (2525)، وابن ماجه (1842) بنحوه، وأحمد (10979) واللفظ له","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"hPfCPxTq"},{"id":"س-06306","fp":"a87c9eee2d90","stateId":433,"easy":"إذا تصدقت ولو بلقمة ← تربو في كف الله حتى تكون مثل الجبل","cause":"إنَّ الرَّجلَ ليتصدَّقُ باللُّقمةِ","result":"فتَربو في يدِ اللَّهِ أو قالَ: في كَفِّ اللَّهِ حتَّى تَكونَ مثلَ الجبلِ","explicit":true,"similar":["س-03891"],"ref":"صحيح ابن خزيمة 4/ 156","srcLabel":"متفق عليه","text":["إنَّ العبدَ إذا تَصدَّقَ مِن طيِّبٍ تقبَّلَها اللَّهُ منهُ، وأخذَها بيمينِهِ، فربَّاها كما يُربِّي أحدُكُم مُهْرَهُ أو فصيلَهُ ",["إنَّ الرَّجلَ ليتصدَّقُ باللُّقمةِ",1],"، ",["فتَربو في يدِ اللَّهِ أو قالَ: في كَفِّ اللَّهِ حتَّى تَكونَ مثلَ الجبلِ",2]," فتصدَّقوا [وفي روايةٍ]: نحوَهُ، وزادَ: وتصديقُ ذلِكَ في كتابِ اللَّهِ {يَمْحَقُ اللَّهُ الرِّبَا وَيُرْبِي الصَّدَقَاتِ} [البقرة: 276]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (1410)، ومسلم (1014)، والنسائي (2525) باختلاف يسير.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"kxEsYxxw"},{"id":"س-06851","fp":"608e1bae3e74","stateId":433,"easy":"إذا تصدقت من طيب ← يأخذها الرحمن بيمينه ويربيها لك","cause":"ما تصدَّقَ أحدٌ بصدقةٍ من طيِّبٍ ، ولا يقبلُ اللَّهُ عزَّ وجلَّ","result":"إلَّا الطَّيِّبَ ، إلَّا أخذَها الرَّحمنُ عزَّ وجلَّ بيمينِهِ ، وإن كانت تمرةً فتَربو في كفِّ الرَّحمنِ ، حتَّى تَكونَ أعظمَ منَ الجبلِ كما يربِّي أحدُكُم فَلُوَّه أو فَصيلَهُ","explicit":true,"repOf":"س-01964","ref":"صحيح النسائي 2524","text":[["ما تصدَّقَ أحدٌ بصدقةٍ من طيِّبٍ ، ولا يقبلُ اللَّهُ عزَّ وجلَّ",1]," ",["إلَّا الطَّيِّبَ ، إلَّا أخذَها الرَّحمنُ عزَّ وجلَّ بيمينِهِ ، وإن كانت تمرةً فتَربو في كفِّ الرَّحمنِ ، حتَّى تَكونَ أعظمَ منَ الجبلِ كما يربِّي أحدُكُم فَلُوَّه أو فَصيلَهُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1410)، ومسلم (1014)، والترمذي (661)، والنسائي (2525) واللفظ له، وابن ماجه (1842)، وأحمد (10945)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"umr03EbV"},{"id":"س-06921","fp":"31bf4ef99301","stateId":433,"easy":"إذا تصدقت بتمرة من كسب طيب ← يأخذها الله بيمينه ويربيها لك","cause":"لا يَتَصَدَّقُ أحَدٌ بتَمرةٍ مِن كَسبٍ طَيِّبٍ","result":"إلَّا أخَذَها اللهُ بيَمينِه، فيُرَبِّيها كما يُرَبِّي أحَدُكُم فَلُوَّه، أو قَلوصَه، حتَّى تَكونَ مِثلَ الجَبَلِ أو أعظَمَ","explicit":true,"repOf":"س-01964","ref":"صحيح مسلم 1014","text":[["لا يَتَصَدَّقُ أحَدٌ بتَمرةٍ مِن كَسبٍ طَيِّبٍ",1]," ",["إلَّا أخَذَها اللهُ بيَمينِه، فيُرَبِّيها كما يُرَبِّي أحَدُكُم فَلُوَّه، أو قَلوصَه، حتَّى تَكونَ مِثلَ الجَبَلِ أو أعظَمَ",2],". في حَديثِ رَوحٍ: مِنَ الكَسبِ الطَّيِّبِ فيَضَعُها في حَقِّها. وفي حَديثِ سُلَيمانَ: فيَضَعُها في مَوضِعِها."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1410) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"GR3MeWEH"},{"id":"س-06870","fp":"c027ea82af3e","stateId":433,"easy":"إذا تصدقت من كسب طيب ووضعتها موضعها ← يأخذها الله بيمينه ويربيها لك","cause":"ما مِن مؤمِنٍ آمن تصدَّقَ بصدَقةٍ مِن كَسبٍ طيِّبٍ ووضعَها موضعَها","result":"إلَّا أخذَها تبارَكَ وتعالى بيمينِهِ فيربِّيها لهُ كما يربِّي أحدُكم فلوَّهُ حتَّى يَكونَ مثلَ الجبلِ العَظيمِ","explicit":true,"repOf":"س-01964","ref":"تخريج كتاب السنة 623","text":["لعلَّهُ ( ",["ما مِن مؤمِنٍ ) آمن تصدَّقَ بصدَقةٍ مِن كَسبٍ طيِّبٍ ووضعَها موضعَها",1]," ",["إلَّا أخذَها تبارَكَ وتعالى بيمينِهِ فيربِّيها لهُ كما يربِّي أحدُكم فلوَّهُ حتَّى يَكونَ مثلَ الجبلِ العَظيمِ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده جيد","takhrij":"أخرجه البخاري (7430)، ومسلم (1014) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"S3ivsFH4"},{"id":"س-03891","fp":"a428c25528b4","stateId":433,"easy":"إذا تصدقت من طيب ولو بلقمة ← يربيها الله لك حتى تكون مثل الجبل","cause":"إنَّ اللهَ يَقبلُ الصَّدقةَ إذا كانت مِن طَيِّبٍ","result":"فيأخُذُها بيمينِهِ، وإنَّ الرَّجلَ ليتَصدَّقُ بمثلِ اللُّقمَةِ، فيُربِّيها اللهُ له كما يُربِّي أَحدُكُم فَصيلَهُ -أوْ: مُهْرَهُ- فيَرْبو في كفِّ اللهِ -أوْ: في يدِ اللهِ- حتَّى يكونَ مثلَ أُحُدٍ","explicit":true,"repOf":"س-06306","otherNeedIds":[51],"ref":"المستدرك على الصحيحين 3325","text":["عنْ أبي هُريرةَ رَضيَ اللهُ عنه في قولِهِ عزَّ وجلَّ: {أَلَمْ يَعْلَمُوا أَنَّ اللَّهَ هُوَ يَقْبَلُ التَّوْبَةَ عَنْ عِبَادِهِ وَيَأْخُذُ الصَّدَقَاتِ} [التوبة: 104] قالَ: ",["إنَّ اللهَ يَقبلُ الصَّدقةَ إذا كانت مِن طَيِّبٍ",1]," ",["فيأخُذُها بيمينِهِ، وإنَّ الرَّجلَ ليتَصدَّقُ بمثلِ اللُّقمَةِ، فيُربِّيها اللهُ له كما يُربِّي أَحدُكُم فَصيلَهُ -أوْ: مُهْرَهُ- فيَرْبو في كفِّ اللهِ -أوْ: في يدِ اللهِ- حتَّى يكونَ مثلَ أُحُدٍ",2],"."],"grade":"صحيح","narrator":"القاسم","muhaddith":"صحيح على شرطهما","bab":"تفسير آيات › سورة التوبة","dorar":"VTOk3AAY","merged":2,"otherRefs":["سنن الترمذي 662 (صحيح)"]},{"id":"س-00617","fp":"6fbb93297688","stateId":433,"easy":"إذا تصدقت ← يقبلها الله ويربيها لك كما يربي أحدكم مهره","cause":"إنَّ اللَّهَ يقبلُ الصَّدقةَ","result":"ويربِّيها لأحدِكم كما يربِّي أحدُكم فلوَّهُ أو فصيلَهُ","explicit":true,"repOf":"س-01964","otherNeedIds":[1],"ref":"مجمع الزوائد 3/114","text":[["إنَّ اللَّهَ يقبلُ الصَّدقةَ",1]," ",["ويربِّيها لأحدِكم كما يربِّي أحدُكم فلوَّهُ أو فصيلَهُ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (4228) واللفظ له، وأخرجه أحمد (26135) بنحوه، والبزار كما في ((كشف الأستار)) للهيثمي (931) باختلاف يسير","bab":"آداب عامة › ضرب الأمثال","dorar":"QsJKlnek"},{"id":"س-00624","fp":"6550b09c1a0b","stateId":433,"easy":"إذا تصدقت ولو بتمرة أو لقمة ← يربيها الله لك كما يُربّى المهر","cause":"التَّمْرَةَ و اللُّقْمَةَ","result":"إِنَّ اللهَ لَيُربِّي لِأَحَدِكُمْ التَّمْرَةَ و اللُّقْمَةَ ، كما يُربِّي أحدُكُمْ فَلوَّهُ أوْ فَصِيلهُ ، حتى يَكُونَ مِثْلَ أُحُدٍ","explicit":true,"repOf":"س-01964","otherNeedIds":[1],"ref":"صحيح الترغيب 857","text":[["إِنَّ اللهَ لَيُربِّي لِأَحَدِكُمْ التَّمْرَةَ و اللُّقْمَةَ ، كما يُربِّي أحدُكُمْ فَلوَّهُ أوْ فَصِيلهُ ، حتى يَكُونَ مِثْلَ أُحُدٍ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (3317) واللفظ له، وأخرجه أحمد (26135) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (4228) بنحوه","bab":"آداب عامة › ضرب الأمثال","dorar":"wH8bb8Ae"},{"id":"س-00646","fp":"c6566e25013b","stateId":433,"easy":"إذا تصدقت بتمرة من كسب طيب في حقها ← يأخذها الله بيمينه ويربيها لك","cause":"إنَّ أحدَكم ليتصدَّقُ بالتَّمرةِ مِن الكَسبِ الطَّيِّبِ، فيضَعُها في حَقِّها","result":"فيليها اللهُ بيَمينِه، ثُمَّ ما تبرَحُ فيُربيها كأحسَنِ ما يُرَبِّي أحدُكم فَلُوَّه، حتَّى تكونَ مِثلَ الجَبلِ، أو أعظَمَ مِن الجَبلِ","explicit":true,"repOf":"س-01964","ref":"علل الدارقطني 2813","text":["إنَّ العبدَ ليتصدَّقُ بالتَّمرةِ، أو عَدْلِها مِن الطَّيِّبِ -ولا يقبَلُ اللهُ إلَّا الطَّيِّبَ- فتقَعُ بيدِ اللهِ، فيُرَبِّيها له...، الحديثَ. [يعني حديثَ: ",["إنَّ أحدَكم ليتصدَّقُ بالتَّمرةِ مِن الكَسبِ الطَّيِّبِ، فيضَعُها في حَقِّها",1],"، ",["فيليها اللهُ بيَمينِه، ثُمَّ ما تبرَحُ فيُربيها كأحسَنِ ما يُرَبِّي أحدُكم فَلُوَّه، حتَّى تكونَ مِثلَ الجَبلِ، أو أعظَمَ مِن الجَبلِ",2],"]."],"grade":"صحيح","narrator":"عبد الله بن عمر","muhaddith":"[حكى فيه الخلافَ على عبدِ اللهِ بنِ دينارٍ، ثُمَّ قال]: قال أبو جَعفَرٍ الرَّازيُّ: عن عبدِ اللهِ بنِ دينارٍ، عن بَشيرِ بنِ يَسارٍ، عن أبي هُرَيرةَ. وهو محفوظٌ عن سعيدِ بنِ يَسارٍ، عن أبي هُرَيرةَ.","bab":"آداب عامة › ضرب الأمثال","dorar":"h2eki6kb"},{"id":"س-06919","fp":"3ef2b7231eb3","stateId":433,"easy":"إذا تصدقت من الكسب الطيب ← يتلقاها الرحمن بيده ويربيها لك","cause":"إنَّ الرَّجلَ ليتصدَّقُ بالصَّدقةِ منَ الكسبِ الطَّيِّبِ","result":"فيتلقَّاها الرَّحمنُ تباركَ وتعالى بيدِهِ فيربِّيها كما يربِّي أحدُكم فلوَّهُ أو وصيفَهُ أو فصيلَهُ","explicit":true,"repOf":"س-01964","ref":"مجمع الزوائد 3/115","text":[["إنَّ الرَّجلَ ليتصدَّقُ بالصَّدقةِ منَ الكسبِ الطَّيِّبِ",1]," ولا يقبلُ اللَّهُ إلَّا الطَّيِّبَ ",["فيتلقَّاها الرَّحمنُ تباركَ وتعالى بيدِهِ فيربِّيها كما يربِّي أحدُكم فلوَّهُ أو وصيفَهُ أو فصيلَهُ",2]],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"رجاله ثقات","takhrij":"أخرجه أحمد (26135) بنحوه، والبزار كما في ((كشف الأستار)) للهيثمي (931)، والطبراني في ((المعجم الأوسط)) (4228) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"5LfNQTk2"},{"id":"س-03402","fp":"174940a7f790","stateId":434,"easy":"إذا أحسنت إلى كل كبد رطبة ← فلك أجر","cause":"في كُلِّ كَبِدٍ رَطبةٍ","result":"أجرٌ","explicit":true,"star":true,"ref":"صحيح البخاري 2363","srcLabel":"مسلم","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: بَينا رَجُلٌ يَمشي فاشتَدَّ عليه العَطَشُ، فنَزَلَ بئرًا فشَرِبَ مِنها، ثُمَّ خَرَجَ فإذا هو بكَلبٍ يَلهَثُ يَأكُلُ الثَّرى مِنَ العَطَشِ، فقال: لقد بَلَغَ هذا مِثلُ الذي بَلَغَ بي، فمَلَأ خُفَّه ثُمَّ أمسَكَه بفيه، ثُمَّ رَقيَ، فسَقى الكَلبَ، فشَكَرَ اللهُ له، فغَفَرَ له، قالوا: يا رَسولَ اللهِ، وإنَّ لنا في البَهائِمِ أجرًا؟ قال: ",["في كُلِّ كَبِدٍ رَطبةٍ",1]," ",["أجرٌ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2244) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"OElQNDLt","merged":6,"otherRefs":["الاستذكار 7/507 (صحيح)","غاية المرام 476 (صحيح)","تخريج المسند لشعيب 17584 (صحيح)","تخريج المسند لشعيب 17588 (صحيح)","الترغيب والترهيب 2/97 (صحيح)"]},{"id":"س-02110","fp":"6097a58e268d","stateId":434,"easy":"إذا غرست غرساً أو زرعت زرعاً فأكل منه إنسان أو دابة ← فهو لك صدقة","cause":"لا يغرِسُ المسلمُ غرسًا ولا يزرَعُ زرعًا فيأكُلُ منه إنسانٌ ولا دابَّةٌ ولا شيءٌ","result":"إلَّا كانت له صدقةٌ","explicit":true,"similar":["س-02652","س-07182","س-02177"],"ref":"تخريج صحيح ابن حبان 3368","srcLabel":"مسلم","text":["عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم أنَّه دخَل على أمِّ مبشِّرٍ الأنصاريَّةِ في نخلٍ لها فقال لها النَّبيُّ صلَّى اللهُ عليه وسلَّم: ( مَن غرَس هذا النَّخلَ ؟ أمسلمٌ أم كافرٌ ؟ فقالت: \nبل مسلمٌ، فقال صلَّى اللهُ عليه وسلَّم: ( ",["لا يغرِسُ المسلمُ غرسًا ولا يزرَعُ زرعًا فيأكُلُ منه إنسانٌ ولا دابَّةٌ ولا شيءٌ",1]," ",["إلَّا كانت له صدقةٌ )",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (1552)، ومعمر بن راشد (19690)، والطبراني (260) (25/ 100)، وابن حبان (3368) واللفظ لهم جميعا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"zkyPn5aU","merged":4,"otherRefs":["صحيح مسلم 1552 (صحيح)","صحيح مسلم 1553 (صحيح)","صحيح الجامع 5757 (صحيح)"]},{"id":"س-02651","fp":"b466e29e518d","stateId":434,"easy":"إذا غرست غرساً أو زرعت فأكل منه سبع أو طائر ← فلك فيه أجر","cause":"لا يَغرِسُ رَجُلٌ مُسلِمٌ غَرسًا ولا زَرعًا، فيَأكُلَ منه سَبُعٌ أو طائِرٌ أو شيءٌ","result":"إلَّا كانَ له فيه أجرٌ","explicit":true,"ref":"صحيح مسلم 1552","srcLabel":"متفق عليه","text":[["لا يَغرِسُ رَجُلٌ مُسلِمٌ غَرسًا ولا زَرعًا، فيَأكُلَ منه سَبُعٌ أو طائِرٌ أو شيءٌ،",1]," ",["إلَّا كانَ له فيه أجرٌ",2],". وقال ابنُ أبي خَلَفٍ: طائِرٌ شيءٌ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"إيمان › الاحتساب والنية","dorar":"ywzBj8NI","merged":2,"otherRefs":["تخريج صحيح ابن حبان 3369 (صحيح)"]},{"id":"س-07955","fp":"3652e44552f8","stateId":434,"easy":"إذا أحييت أرضاً ميتة ← فلك فيها أجر وما أكلت الدواب صدقة","cause":"مَن أحْيا أرْضًا مَيْتةً","result":"فلَه فيها أجْرٌ، وما أكَلَتِ العافيةُ منها، فهو له صَدَقةٌ","explicit":true,"similar":["س-01969"],"ref":"تخريج المسند لشعيب 14839","srcLabel":"البخاري","text":[["مَن أحْيا أرْضًا مَيْتةً، ",1],["فلَه فيها أجْرٌ، وما أكَلَتِ العافيةُ منها، فهو له صَدَقةٌ",2],"، وقال ابنُ أبي بُكَيرٍ: مَن أحْيا أرْضًا مَيْتةً، فهي له."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه البخاري  معلقاً بصيغة التمريض قبل حديث (2335)، وأخرجه موصولاً الترمذي (1379)، والنسائي في ((السنن الكبرى)) (5757)، وأحمد (14839) واللفظ له","bab":"مزارعة › من أحيا أرضا مواتا","dorar":"6uQl7MDj","merged":2,"otherRefs":["تخريج المسند لشعيب 14271 (صحيح)"]},{"id":"س-01969","fp":"b9fa01cf65f6","stateId":434,"easy":"إذا أحييت أرضاً ميتة ← فلك بها أجر وبكل ما أكلت منه العافية","cause":"مَن أحْيا أرضًا مَيْتةً له بها أجْرٌ، وما أكَلَتْ منه العافيةُ","result":"فله به أجْرٌ","explicit":true,"repOf":"س-07955","ref":"تخريج المسند لشعيب 14361","text":[["مَن أحْيا أرضًا مَيْتةً له بها أجْرٌ، وما أكَلَتْ منه العافيةُ ",1],["فله به أجْرٌ",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه البخاري  معلقاً بصيغة التمريض قبل حديث (2335)، وأخرجه موصولاً الترمذي (1379)، والنسائي في ((السنن الكبرى)) (5757)، وأحمد (14361) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"MDswxauK"},{"id":"س-02652","fp":"8174a1c488c9","stateId":434,"easy":"إذا غرست غرساً فأكل منه إنسان أو دابة ← فهو لك صدقة","cause":"ما مِن مُسلِمٍ غَرَسَ غَرسًا، فأكَلَ منه إنسانٌ أو دابَّةٌ","result":"إلَّا كان له به صَدَقةٌ","explicit":true,"repOf":"س-02110","ref":"صحيح البخاري 6012","text":[["ما مِن مُسلِمٍ غَرَسَ غَرسًا، فأكَلَ منه إنسانٌ أو دابَّةٌ،",1]," ",["إلَّا كان له به صَدَقةٌ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6012)، ومسلم (1553)","bab":"إيمان › الاحتساب والنية","dorar":"lJMRdkpl"},{"id":"س-07182","fp":"eb1e93e43a24","stateId":434,"easy":"إذا أكلت الدواب من زرعك ← فهو لك صدقة","cause":"وما أكَلَتِ العافيةُ","result":"فهو له صَدَقةٌ","explicit":true,"repOf":"س-02110","ref":"تخريج المسند لشعيب 14636","text":["مَن أحْيا أرْضًا مَيْتةً فهي له، ",["وما أكَلَتِ العافيةُ",1]," ",["فهو له صَدَقةٌ",2],"، فقال رَجُلٌ: يا أبا المُنذِرِ. قال أبو عَبدِ الرحمنِ: أبو المُنذِرِ هِشامُ بنُ عُرْوةَ، ما العافيةُ؟ قال: ما اعْتَفاها مِن شَيءٍ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري  معلقاً بصيغة التمريض قبل حديث (2335)، وأخرجه موصولاً الترمذي (1379)، والنسائي في ((السنن الكبرى)) (5757)، وأحمد (14636) واللفظ له","bab":"علم › حسن السؤال ونصح العالم","dorar":"b41DWWE9"},{"id":"س-02663","fp":"ef4f89be587a","stateId":434,"easy":"إذا غرست غرساً ← فما أُكل منه أو سُرق صدقة لك","cause":"ما مِنْ مسلِمٍ يغرِسُ غرْسًا","result":"إلَّا كان ما أُكِلَ منْهُ لَهُ صَدَقَةً ، وما سُرِقَ منه صدَقَةٌ ، وما أكلَ السبُعُ فهوَ لَهُ صدَقَةٌ ، وما أكَلَتِ الطيورُ فهو لَهُ صدقَةٌ ، ولا يَرْزَؤُهُ أَحَدٌ","explicit":true,"similar":["س-06378"],"ref":"صحيح الجامع 5768","srcLabel":"مسلم","text":[["ما مِنْ مسلِمٍ يغرِسُ غرْسًا",1]," ",["إلَّا كان ما أُكِلَ منْهُ لَهُ صَدَقَةً ، وما سُرِقَ منه صدَقَةٌ ، وما أكلَ السبُعُ فهوَ لَهُ صدَقَةٌ ، وما أكَلَتِ الطيورُ فهو لَهُ صدقَةٌ ، ولا يَرْزَؤُهُ أَحَدٌ",2]," إِلاَّ كَانَ لَهُ صَدَقَةٌ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1552) باختلاف يسير","bab":"إيمان › الاحتساب والنية","dorar":"J8FGdglJ"},{"id":"س-02177","fp":"b9df7765b492","stateId":434,"easy":"إذا زرعت زرعاً فأكل منه الطير أو الدواب ← فهو لك صدقة","cause":"مَنْ زرَعَ زرْعًا ، فأكَلَ مِنْهُ الطيرُ ، أو عافِيةٌ","result":"كان لهُ صدَقةً","explicit":true,"repOf":"س-02110","ref":"صحيح الجامع 6273","text":[["مَنْ زرَعَ زرْعًا ، فأكَلَ مِنْهُ الطيرُ ، أو عافِيةٌ ، ",1],["كان لهُ صدَقةً",2]],"grade":"صحيح","narrator":"خلاد بن السائب الأنصاري","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (4134) (4/ 199) واللفظ له، وابن خزيمة كما في ((إتحاف المهرة)) (4504) باختلاف يسير، وأبو نعيم في ((معرفة الصحابة)) بمعناه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"C59DP7FZ"},{"id":"س-02242","fp":"a132479af45c","stateId":434,"easy":"إذا سقيت بعيراً عطشان ولو لغيرك ← ففي كل كبد عطشى أجر","cause":"وردَ عليَّ البعيرُ لغَيري فسقيتُهُ","result":"في كلِّ ذاتِ كبدٍ حَرَّى أجرٌ","explicit":true,"ref":"تخريج المسند لشاكر 12/30","srcLabel":"أحمد","text":["أنَّ رجلًا جاءَ إلى رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ : إنِّي أنزِعُ في حَوضي حتَّى إذا ملأتُهُ لأَهْلي ",["وردَ عليَّ البعيرُ لغَيري فسقيتُهُ",1]," فَهَل لي في ذلِكَ مِن أجرٍ ؟ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : ",["في كلِّ ذاتِ كبدٍ حَرَّى أجرٌ",2]],"grade":"صحيح","narrator":"[جد عمرو بن شعيب]","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد(7075) واللفظ له.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"4T6kgPD6"},{"id":"س-02338","fp":"0d09e282687f","stateId":434,"easy":"إذا سقيت كل كبد عطشى ← فلك أجر","cause":"سَقيِ كُلِّ كَبِدٍ حَرَّى","result":"أجرٌ","explicit":true,"similar":["س-02054","س-01708"],"ref":"تخريج المسند لشعيب 17587","srcLabel":"أحمد","text":["دَخَلَ على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في وجَعِه الذي توفِّيَ فيه، قال: فطَفِقتُ أسألُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم حَتَّى ما أذكُرُ ما أسألُه عنه. فقال: اذكُرْه. قال: وكان مِمَّا سَألتُه عنه: أن قُلتُ: يا رَسولَ اللهِ، الضَّالَّةُ تَغشى حياضي، وقد مَلَأتُها ماءً لإبِلي، هَل لي مِن أجرٍ أن أسقيَها؟ فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: «نَعَم، في ",["سَقيِ كُلِّ كَبِدٍ حَرَّى",1]," ",["أجرٌ",2]," للَّهِ»."],"grade":"صحيح","narrator":"سراقة بن مالك","muhaddith":"صحيح","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"jRzG4v4U"},{"id":"س-02664","fp":"ba87cffed6ae","stateId":434,"easy":"إذا غرست غرساً ← يكتب الله لك من الأجر قدر ما يخرج منه","cause":"ما مِنْ رجلٍ يَغْرِسُ غَرْسًا","result":"إلَّا كَتَبَ اللهُ له منَ الأجْرِ قَدْرَ ما يخرُجُ مِنْ ذلِكَ الغَرْسِ","explicit":true,"similar":["س-02097"],"otherNeedIds":[67],"ref":"مجمع الزوائد 4-70","srcLabel":"أحمد","text":[["ما مِنْ رجلٍ يَغْرِسُ غَرْسًا",1]," ",["إلَّا كَتَبَ اللهُ له منَ الأجْرِ قَدْرَ ما يخرُجُ مِنْ ذلِكَ الغَرْسِ",2]],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"فيه عبد الله بن عبد العزيز وبقية رجاله رجال الصحيح","takhrij":"أخرجه أحمد (23520) واللفظ له، والطبراني (4/148) (3968)","bab":"إيمان › الاحتساب والنية","dorar":"s9oU61CN"},{"id":"س-06378","fp":"c6c42b703070","stateId":434,"easy":"إذا غرست غرساً ← لا يأكل منه آدمي ولا خلق إلا كان لك صدقة","cause":"من غرس غرسًا","result":"لم يأكلْ منه آدميٌّ و لا خلقٌ من خلْقِ اللهِ إلا كان له صدقةٌ","explicit":true,"repOf":"س-02663","ref":"صحيح الجامع 6400","text":[["من غرس غرسًا ، ",1],["لم يأكلْ منه آدميٌّ و لا خلقٌ من خلْقِ اللهِ إلا كان له صدقةٌ",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه أحمد (27506)، وابن عساكر في ((تاريخ دمشق)) (68/114) واللفظ لهما، والطبراني كما في ((مجمع الزوائد)) للهيثمي (4/71) باختلاف يسير","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"scrbN0wO"},{"id":"س-06388","fp":"bd858dd692e9","stateId":434,"easy":"إذا أكل من زرعك إنسان أو سبع ← فلك فيه أجر","cause":"فيما يَأكُلُ ابنُ آدمَ","result":"أجْرٌ، وفيما يَأكُلُ السَّبُعُ أجْرٌ","explicit":true,"similar":["س-02655"],"ref":"المستدرك على الصحيحين 7385","srcLabel":"الحاكم","text":["أتى رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بَني عَمْرِو بنِ عَوْفٍ يومَ الأربعاءِ، فرأى أشياءَ لم يكُنْ رآها قبْلَ ذلكَ مِن حِصَنةٍ على النَّخيلِ، فقال: لو أنَّكُمْ إذا جِئْتُم عِيدَكُم هذا مكَثْتُم حتَّى تَسمَعوا مِن قَوْلي، قالوا: نَعَمْ، بآبائِنا أنتَ أيْ رسولَ اللهِ وأُمَّهاتِنا. قالَ: فلمَّا حَضَروا الجُمُعةَ، صَلَّى بهِمْ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ الجُمُعةَ، ثُمَّ صلَّى ركعتَيْنِ في المسجِدِ، وكان يَنصَرِفُ إلى بَيتِه قبْلَ ذلكَ اليومِ، ثمَّ استوى فاستَقْبَلَ النَّاسَ بوَجْهِهِ، فتتبَّعْتُ له الأنصارَ، أو مَن كانَ منهُمْ حتَّى وَفِيَ بهم إليه، فقال: يا مَعْشَرَ الأنصارِ، قالوا: لبَّيْكَ أيْ رَسولَ اللهِ، فقال: كنتُمْ في الجاهلِيَّةِ إذْ لا تَعبُدونَ اللهَ، تَحْمِلونَ الكَلَّ، وتَفْعَلونَ في أموالِكُم المعروفَ، وتَفعَلونَ إلى ابنِ السَّبيلَ، حتَّى إذا مَنَّ اللهُ عليكُم بالإسلامِ ومَنَّ عليكُمْ بنَبِيِّه صلَّى اللهُ عليه وسلَّمَ، إذا أنَّكُمْ لتُحَصِّنونَ أموالَكُمْ! و",["فيما يَأكُلُ ابنُ آدمَ",1]," ",["أجْرٌ، وفيما يَأكُلُ السَّبُعُ أجْرٌ",2],". فرَجَعَ القَوْمُ، فما منهم أحَدٌ إلَّا هَدَمَ مِن حَديقَتِه ثلاثينَ بابًا."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح الإسناد","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"y1uFBdJz"},{"id":"س-01932","fp":"abd461c26fe3","stateId":434,"easy":"إذا أحييت أرضاً فشرب منها كبد عطشى أو انتفع بها أحد ← يكتب الله لك بها أجراً","cause":"ما مِنِ امْرِئٍ يُحْيِي أَرْضًا فيَشْرَبُ منها كَبِدٌ حَرَّى ، أو يُصِيبُ منها عافيةٌ","result":"إلا كُتِبَ له بها أَجْرًا","explicit":true,"ref":"الجامع الصغير 7981","srcLabel":"الجامع الصغير","text":[["ما مِنِ امْرِئٍ يُحْيِي أَرْضًا فيَشْرَبُ منها كَبِدٌ حَرَّى ، أو يُصِيبُ منها عافيةٌ ،",1]," ",["إلا كُتِبَ له بها أَجْرًا",2]],"grade":"حسن","narrator":"أم سلمة أم المؤمنين","muhaddith":"حسن","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Y7R7gjmG"},{"id":"س-02054","fp":"eb8229652b1e","stateId":434,"easy":"إذا سقيت دابة عطشى ← فلك أجر","cause":"إن سقيتُها","result":"في الكَبدِ الحارَّةِ أجرٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-02338","ref":"صحيح الجامع 4254","text":[["في الكَبدِ الحارَّةِ أجرٌ",2]," [يعني حديثَ: عن سُراقةَ بنِ مالكٍ أنَّه جاء النَّبيَّ صلَّى اللهُ عليه وسلَّم في وَجَعِه، فقال: أرأيتَ ضالَّةً تَرِدُ على حَوضِ إبلي، فهل لي أجرٌ ",["إن سقيتُها",1],"؟ فقال: \"نعم، ‌في ‌الكَبِدِ ‌الحارَّةِ ‌أجرٌ\"]"],"grade":"صحيح","narrator":"سراقة بن مالك","muhaddith":"صحيح","takhrij":"أخرجه عبد الرزاق (20750)، والطبراني (7/ 128) (6587)، وأبو نعيم في ((معرفة الصحابة)) (3600 ) جميعا بلفظه، وابن ماجه (3686)، وأحمد (17588) كلاهما بلفظ مقارب، جميعا مطولا .","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"9TMaHoPC"},{"id":"س-02080","fp":"7116c0d02a2e","stateId":434,"easy":"إذا غرست شجرة وصبرت على رعايتها حتى تثمر ← لك في كل ما يُصاب من ثمرها صدقة","cause":"مَنْ نَصَبَ شَجَرَةً فَصَبَر عَلَى حَفْظِهَا والقيامِ علَيْها حتى تُثْمِرَ","result":"كان لَهُ في كُلِّ شيءٍ يُصَابُ مِنْ ثَمَرَتِها صدَقَةٌ عندَ اللهِ عزَّ وجلَّ","explicit":true,"ref":"مجمع الزوائد 4-71","srcLabel":"أحمد","text":[["مَنْ نَصَبَ شَجَرَةً فَصَبَر عَلَى حَفْظِهَا والقيامِ علَيْها حتى تُثْمِرَ ",1],["كان لَهُ في كُلِّ شيءٍ يُصَابُ مِنْ ثَمَرَتِها صدَقَةٌ عندَ اللهِ عزَّ وجلَّ",2]],"grade":"حسن","narrator":"رجل من الصحابة","muhaddith":"فيه فتح ذكره ابن أبي حاتم ولم يوثقه ولم يجرحه وبقية رجاله ثقات","takhrij":"أخرجه أحمد (16586)، والبيهقي في ((شعب الإيمان)) (3223)، واللفظ لهما.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"38W7CenK"},{"id":"س-02097","fp":"6dfc52bd376e","stateId":434,"easy":"إذا غرست غرساً فأثمر ← فلك من الأجر بعدد ثمره","cause":"مَن غرَس غِراسًا فأثمَر","result":"كان له منَ الأجرِ بعددِ ذلك الثمَرِ","explicit":true,"repOf":"س-02664","ref":"إتحاف الخيرة المهرة 3/384","text":[["مَن غرَس غِراسًا فأثمَر ، ",1],["كان له منَ الأجرِ بعددِ ذلك الثمَرِ",2]],"grade":"حسن","narrator":"أبو أيوب الأنصاري","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (23520)، والطبراني (4/148) (3968) بنحوه مطولاً، والخطيب في ((تاريخ بغداد)) (10/360) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"TySBXpG9"},{"id":"س-02268","fp":"80447a7ed3ec","stateId":434,"easy":"إذا سقيت الماء ← فلا صدقة أعظم أجراً منه","cause":"ماءٍ","result":"ليس صدقةٌ أَعْظَمَ أَجْرًا","explicit":true,"ref":"الجامع الصغير 7589","srcLabel":"البيهقي","text":[["ليس صدقةٌ أَعْظَمَ أَجْرًا",2]," من ",["ماءٍ",1]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه البيهقي في ((الشعب)) (3106)، وابن عدي في ((الكامل)) (9/ 115)، والخطيب في ((تاريخه)) (2/ 376)، واللفظ لهم.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"khDcUoaO"},{"id":"س-02655","fp":"fa555b26dbfe","stateId":434,"easy":"إذا أصاب طير أو سبع من زرعك أو ثمرك ← فلك فيه أجر","cause":"ما من شيءٍ يصيبُ من زرعِ أحدِكم ولا تمرِه من طيرٍ ولا سبعٍ","result":"إلا كان له فيه أجرٌ","explicit":true,"repOf":"س-06388","ref":"الإصابة في تمييز الصحابة 1/454","text":[["ما من شيءٍ يصيبُ من زرعِ أحدِكم ولا تمرِه من طيرٍ ولا سبعٍ",1]," ",["إلا كان له فيه أجرٌ",2]],"grade":"حسن","narrator":"خلاد بن السائب الأنصاري","muhaddith":"إسناده حسن","takhrij":"أخرجه البغوي في ((معجم الصحابة)) (861)، والطبراني (4133)، وأبو نعيم الأصبهاني في ((معرفة الصحابة)) (2482) جميعهم بلفظه.","bab":"إيمان › الاحتساب والنية","dorar":"LSvqDcT1"},{"id":"س-02665","fp":"fe3404faa30b","stateId":434,"easy":"إذا أصابت الدواب من زرعك ← يكتب الله لك به أجراً","cause":"ما من شيءٍ يصيبُ زرعَ أحدِكم منَ العوَافِي","result":"إلَّا كتَبَ اللهُ به أجْرًا","explicit":true,"ref":"مجمع الزوائد 4-71","srcLabel":"أحمد","text":[["ما من شيءٍ يصيبُ زرعَ أحدِكم منَ العوَافِي",1]," ",["إلَّا كتَبَ اللهُ به أجْرًا",2]],"grade":"حسن","narrator":"السائب بن خلاد","muhaddith":"فيه عبد الله بن موسى التيمي وهو ثقة لكنه كثير الخطأ وبقية رجاله ثقات","takhrij":"أخرجه أحمد (16558) بنحوه، وابن أبي عاصم في ((الآحاد والمثاني)) (2154)، والطبراني (7/144) (6639) باختلاف يسير","bab":"إيمان › الاحتساب والنية","dorar":"aUChbhy9"},{"id":"س-08181","fp":"ec843c01039e","stateId":434,"easy":"إذا سقيت البهائم ← ففي كل كبد حرى أجر","cause":"فيَرِدُ الْهَمَلُ","result":"في كلِّ كبدٍ حَرَّى أجرٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 6/56","srcLabel":"الطبراني","text":["كان النبيُّ صلَّى اللهُ عليه وسلَّمَ يأتينا بمكةَ كلَّ يومٍ مرتينِ فلمَّا كان يومٌ من ذلك جاءنا في الظهيرةِ فقالتْ يا أبتِ هذا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فبأبي وأمي ما جاء به هذه الساعةَ إلا أمرٌ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ هل شعرتَ أنَّ اللهَ قد أذِنَ لي في الخروجِ فقال أبو بكرٍ فالصحابةُ يا رسولَ اللهِ قال الصحابةُ قال إنَّ عندي راحلتينِ قد علفتُهما منذُ كذا وكذا انتظارًا لهذا اليومِ فَخُذْ إحْدَاهُمَا فقال بثمنِها يا أبا بكرٍ فقال بثمنِها بأبي وأمي إنْ شئتَ قالتْ فهيأْنا لهم سفرةً ثم قطعتْ نطاقَها فربَطَتْها ببعضِه فخرجا فمكثا في الغارِ في جبلِ ثورٍ فلما انتهيا إليه دخل أبو بكرٍ الغارَ قبلَه فلم يتركْ فيه جحرًا إلا أدخل فيه أصبعَه مخافةَ أنْ يكونَ فيه هامةٌ وخرجتْ قريشٌ حين فقدوهما في بغائِهما وجعلوا في النبيِّ صلَّى اللهُ عليه وسلَّمَ مائةَ ناقةٍ وخرجوا يطوفون في جبالِ مكةَ حتى انتهوا إلى الجبلِ الذي هما فيه فقال أبو بكرٍ لرجلٍ مُواجِهٍ الغارَ يا رسولَ اللهِ إنه لَيرانا فقال كلا إنَّ ملائكةً تسترُنا بأجنحتِها فجلس ذلك الرجلُ فبال مُواجِهٍ الغارَ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ لو كان يرانا ما فعل هذا فمكثا ثلاثَ ليالٍ يروحُ عليهما عامرُ بنُ فهيرةَ مولى أبي بكرٍ غنمًا لأبي بكرٍ ويُدْلِجُ من عندِهما فيُصبحُ مع الرعاةِ في مَراعِيها ويروحُ معهم ويُبطئُ في المشيِ حتى إذا أظلمَ الليلُ انصرفَ بغنمِه إليهما فتظنُّ الرعاةُ أنه معهم وعبدُ اللهِ بنِ أبي بكرٍ يظلُّ بمكةَ يتَطَلبُ الأخبارَ ثم يأتيِهما إذا أظلَمَ الليلُ فيُخبرُهما ثم يُدلِجُ من عندِهما فيُصبحُ بمكةَ ثم خرجا من الغارِ فأخذا على الساحلِ فجعل أبو بكرٍ يسيرُ أمامَه فإذا خشي أن يُؤتى من خلفِه سارا خلْفَه فلم يزلْ كذلِك مسيرَه وكان أبو بكرٍ رجلًا معروفًا في الناسِ فإذا لقِيَه لاقٍ فيقولون من هذا معك فيقولُ هادٍ يهديني يريدُ الهدى في الدِّينِ وحَسِبَ الآخرُ دليلًا حتى إذا كان بأبياتِ قُدَيْدٍ وكان على طريقِهما جاء إنسانٌ إلى بني مُدْلِجٍ فقال قد رأيتُ راكبينِ نحو الساحلِ فإني لَأجدُهما لَصاحبَ قريشٍ الذي تبغون فقال سراقةُ بنُ مالكٍ ذانِك راكبينِ ممن بعثْنا في طلبةِ القومِ ثم دعا جاريتَه فسارَّها فأمرَها أنْ تُخْرِجَ فرسَه ثم خرج في آثارِهما قال سراقةُ فدنوتُ منهما حتى أني لَأسمعُ قراءةَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ ثم رَكَضَتِ الفرسُ فوقعتْ بمَنْخِرَيْها فأخرجتُ قِداحتي من كنانتي فضربتُ بها أضرُّه أم لا أضرُّه فخرج لا تضرُّه فأبتْ نفسي حتى أتَّبِعَه فأتيتُ ذلك الموضعَ فوقعتِ الفرسُ فاسْتَخْرَجْتُ يدَيْه مرةً أُخرى فضربتُ بالقداحِ أضرُّه أم لا فخرج لا تضرُّه فأبَتْ نفسي حتى إذا كنتُ منه بمثلِ ذلك الموضعِ خشيةَ أن يُصيبَني مثلُ ما أصابني بأَذِيَّتِه فقلتُ إني أرى سيكونُ لك شأنٌ فقِفْ أُكَلِّمُك فوقفَ النبيُّ صلَّى اللهُ عليه وسلَّمَ فسألَه أنْ يكتبَ له أمانًا فأمر أنْ يكتبَ فكتب له قال سراقةُ فلمَّا كان يومَ حنينٍ وأخرجْتُه وناديتُ أنا سراقةُ فقال النبيُّ صلَّى اللهُ عليه وسلَّمَ يومُ وفاءٍ قال سراقةُ فما شُبِّهَتْ ساقُه في غَرْزِهِ إلا بحِمارٍ فذكرتُ شيئًا أسألُه عنه فقلتُ يا رسولَ اللهِ  إنِّي رجلٌ ذا نَعَمٍ، وإِنَّ الحِيَاضَ تُمْلَأُ من الماءِ، فنَشْرَبُ فيفْضُلُ من الماءِ في الحِيَاضِ، ",["فيَرِدُ الْهَمَلُ",1]," فهل لي في ذلِك من أجرٍ فقال النبيُّ صلَّى اللهُ عليه وسلَّمَ نعمْ ",["في كلِّ كبدٍ حَرَّى أجرٌ",2]],"grade":"صحيح","narrator":"أسماء بنت أبي بكر","muhaddith":"فيه يعقوب بن حميد بن كاسب وبقية رجاله رجال الصحيح","takhrij":"أخرجه الطبراني (24/106) (284) بنحوه، وأبو نعيم في ((حلية الأولياء)) (1/109) مختصرا بنحوه","bab":"ملائكة › أعمال الملائكة","dorar":"PLkWC6xF"},{"id":"س-07931","fp":"5685d553a637","stateId":434,"easy":"إذا سقيت العطشان ← وجدت ذلك عند الله","cause":"لو سقَيْتَه","result":"لَوجَدْتَ ذلكَ عندي","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[26],"ref":"تخريج صحيح ابن حبان 944","srcLabel":"مسلم","text":["يقولُ اللهُ جلَّ وعلا للعبدِ يومَ القيامةِ : يا ابنَ آدَمَ مرِضْتُ فلَمْ تَعُدْني فيقولُ يا ربِّ كيفَ أعُودُكَ وأنتَ ربُّ العالَمينَ ؟ فيقولُ : أمَا علِمْتَ أنَّ عبدي فلانًا مرِض فلَمْ تَعُدْه أمَا علِمْتَ أنَّكَ لو عُدْتَه لَوجَدْتَني ويقولُ : يا ابنَ آدَمَ استسقَيْتُكَ فلَمْ تسقِني ؟ فيقولُ : يا ربِّ كيف أسقيكَ وأنتَ ربُّ العالَمينَ ؟ فيقولُ : أمَا علِمْتَ أنَّ عبدي فلانًا استسقاك فلَمْ تسقِه ؟ أمَا علِمْتَ أنَّك ",["لو سقَيْتَه",1]," ",["لَوجَدْتَ ذلكَ عندي",2]," يا ابنَ آدَمَ استطعَمْتُكَ فلَمْ تُطعِمْني فيقولُ : يا ربِّ وكيفَ أُطعِمُكَ وأنتَ ربُّ العالَمينَ ؟ فيقولُ : ألَمْ تعلَمْ أنَّ عبدي فلانًا استطعَمكَ فلَمْ تُطعِمْه أمَا لو أنَّكَ أطعَمْتَه لَوجَدْتَ ذلكَ عندي"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (2569) باختلاف يسير","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"gz3WxKb8"},{"id":"س-07932","fp":"135f3a83f224","stateId":434,"easy":"إذا أطعمت الجائع ← وجدت ذلك عند الله","cause":"لو أنَّكَ أطعَمْتَه","result":"لَوجَدْتَ ذلكَ عندي","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[26],"ref":"تخريج صحيح ابن حبان 944","srcLabel":"مسلم","text":["يقولُ اللهُ جلَّ وعلا للعبدِ يومَ القيامةِ : يا ابنَ آدَمَ مرِضْتُ فلَمْ تَعُدْني فيقولُ يا ربِّ كيفَ أعُودُكَ وأنتَ ربُّ العالَمينَ ؟ فيقولُ : أمَا علِمْتَ أنَّ عبدي فلانًا مرِض فلَمْ تَعُدْه أمَا علِمْتَ أنَّكَ لو عُدْتَه لَوجَدْتَني ويقولُ : يا ابنَ آدَمَ استسقَيْتُكَ فلَمْ تسقِني ؟ فيقولُ : يا ربِّ كيف أسقيكَ وأنتَ ربُّ العالَمينَ ؟ فيقولُ : أمَا علِمْتَ أنَّ عبدي فلانًا استسقاك فلَمْ تسقِه ؟ أمَا علِمْتَ أنَّك لو سقَيْتَه لَوجَدْتَ ذلكَ عندي يا ابنَ آدَمَ استطعَمْتُكَ فلَمْ تُطعِمْني فيقولُ : يا ربِّ وكيفَ أُطعِمُكَ وأنتَ ربُّ العالَمينَ ؟ فيقولُ : ألَمْ تعلَمْ أنَّ عبدي فلانًا استطعَمكَ فلَمْ تُطعِمْه أمَا ",["لو أنَّكَ أطعَمْتَه",1]," ",["لَوجَدْتَ ذلكَ عندي",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (2569) باختلاف يسير","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"gz3WxKb8"},{"id":"س-01708","fp":"0e406e374860","stateId":434,"easy":"إذا سقيت كبداً عطشى ← فلك فيها أجر","cause":"أن نسقِيَها","result":"في كلِّ كبدٍ حرَّى أجرٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-02338","ref":"الإلمام بأحاديث الأحكام 2/815","text":["نصبتُ حبائلي بالأبواءِ فوقع في حبْلي ظبيٌ فأفلْتُ به فخرجتُ في أثرِه فوجدتُ رجلًا قد أخذه فتنازعا فيه فتساوقْنا إلى رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ فوجدْناه نازلًا بالأبواءِ تحت شجرةٍ يستظلُّ بنطعٍ فاختصمْنا إليه فقضى به رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ بيننا شطرَينِ . قلتُ : يا رسولَ اللهِ نلقى الإبلَ فيها لبونٌ وهي مُصَرَّاةٌ وهم يحتاجون . قال : نادِ صاحبَ الإبلِ ثلاثًا فإن جاء وإلا فاحلُلْ صِرارَها ثم اشرب ثم صرِّ وأبقِ للبنِ دواعيه . قلتُ : يا رسولَ اللهِ إنَّ الضوالَّ ترِدُ علينا هل لنا أجرٌ ",["أن نسقِيَها",1]," ؟ قال : نعم ",["في كلِّ كبدٍ حرَّى أجرٌ",2]," . . ."],"grade":"صحيح","narrator":"جحول البهزي","muhaddith":"[اشترط في المقدمة أنه] صحيح على طريقة بعض أهل الحديث","takhrij":"أخرجه أبو يعلى (1568)، وابن حبان (5882)، والطبراني (763) (20/ 322) واللفظ لهم جميعا.","bab":"أقضية وأحكام › قضايا حكم فيها النبي صلى الله عليه وسلم","dorar":"b4v2ThMo"},{"id":"س-02757","fp":"c70f035422fc","stateId":435,"easy":"إذا أقرضت الله اليوم ← تُجزى غداً","cause":"مَن يُقرِضُ اليَومَ","result":"يُجزى غَدًا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشعيب 8054","srcLabel":"متفق عليه","text":["إنَّ مَلَكًا بِبابٍ مِن أَبوابِ السَّماءِ يَقولُ: ",["مَن يُقرِضُ اليَومَ، ",1],["يُجزى غَدًا",2],"، ومَلَكًا بِبابٍ آخَرَ يَقولُ: اللَّهمَّ أَعْطِ لِمُنفِقٍ خَلَفًا، وعَجِّلْ لِمُمسِكٍ تَلَفًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (1442)، ومسلم (1010)، والنسائي في ((السنن الكبرى)) (9178) بنحوه، وأحمد (8054) واللفظ له","bab":"إيمان › الملائكة","dorar":"3yXStZ68"},{"id":"س-06070","fp":"dc3a15ee84f6","stateId":435,"easy":"إذا منحت منيحة ← تغدو بصدقة وتروح بصدقة","cause":"مَن مَنَحَ مَنيحةً","result":"غَدَت بصَدَقةٍ، وراحَت بصَدَقةٍ؛ صَبوحِها وغَبوقِها","explicit":true,"ref":"صحيح مسلم 1020","srcLabel":"متفق عليه","text":["عَنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم أنَّه نَهى، فذَكَرَ خِصالًا، وقال: ",["مَن مَنَحَ مَنيحةً",1]," ",["غَدَت بصَدَقةٍ، وراحَت بصَدَقةٍ؛ صَبوحِها وغَبوقِها",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5608) بنحوه، ومسلم (1020) واللفظ له","bab":"رقائق وزهد › ما جاء في فعل الخير","dorar":"9QJIdKeE"},{"id":"س-02051","fp":"9d89e0c62724","stateId":435,"easy":"إذا منحت أهل بيت ناقة يشربون لبنها ← فأجرك عظيم","cause":"رجلٌ يَمنحُ أهلَ بيْتٍ نَاقةً ، تَغدُو بِغَداءٍ و تَرُوحُ بِعشاءٍ","result":"إنَّ أجْرَها لَعظِيمٌ","explicit":true,"ref":"صحيح الجامع 2653","srcLabel":"مسلم","text":["ألا ",["رجلٌ يَمنحُ أهلَ بيْتٍ نَاقةً ، تَغدُو بِغَداءٍ و تَرُوحُ بِعشاءٍ",1]," ؟ ",["إنَّ أجْرَها لَعظِيمٌ",2]," . [ اسْتَدْرَكَ الشَّيخُ لَفظَ :  تَغدُو بِغَداءٍ و تَرُوحُ بِعشاءٍ  وقالَ : فلْيُصَحَّحْ و\"العس\" هو القدح الكبير، انظر \" السلسلة الصحيحة \" رقم : 3601 ]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1019)، وأحمد (7301)، والبيهقي (7877) بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"zkPBY204","merged":2,"otherRefs":["صحيح مسلم 1019 (صحيح)"]},{"id":"س-06346","fp":"f988556daa4b","stateId":435,"easy":"إذا أقرضت ← فالقرض بثمانية عشر","cause":"والقرضُ","result":"بثمانيةَ عشرَ","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 1/193","srcLabel":"ابن ماجه","text":["رأيتُ ليلةَ أُسريَ بي على بابِ الجنَّةِ مَكْتوبًا الصَّدقةُ بعشرِ أمثالِها ",["والقرضُ",1]," ",["بثمانيةَ عشرَ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح أو حسن","takhrij":"أخرجه مطولاً ابن ماجه (2431) واللفظ له، وابن حبان في ((المجروحين)) (1/320)، والطبراني في ((المعجم الأوسط)) (6719)","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"KzrTrRVY","merged":2,"otherRefs":["السلسلة الصحيحة 3407 (حسن)"]},{"id":"س-02118","fp":"2b7ddc5e19ae","stateId":435,"easy":"إذا أعرت فحلك لمسلم فأعقب له الفرس ← فلك أجر سبعين فرساً في سبيل الله","cause":"مَن أطرَقَ مُسلِمًا فعَقَبَ له الفَرَسُ","result":"كان له كأجْرِ سَبعينَ فَرَسًا حُمِلَ عليه في سَبيلِ اللهِ","explicit":true,"otherNeedIds":[49],"ref":"تخريج المسند لشعيب 18032","srcLabel":"أحمد","text":["عن أبي عامِرٍ الهَوْزَنيِّ، عن أبي كَبْشةَ الأنْماريِّ: أنَّه أتاهُ فقال: أطْرِقْني من فَرَسِكَ؛ فإنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن أطرَقَ مُسلِمًا فعَقَبَ له الفَرَسُ، ",1],["كان له كأجْرِ سَبعينَ فَرَسًا حُمِلَ عليه في سَبيلِ اللهِ",2],"."],"grade":"صحيح","narrator":"أبو كبشة الأنماري","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (18032) واللفظ له، وابن حبان (4679)، والطبراني (22/341) (853)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"BH9EphA8"},{"id":"س-06374","fp":"2971d1d6deb5","stateId":435,"easy":"إذا أقرضت ← فكل قرض صدقة","cause":"كلُّ قرضٍ","result":"صدَقةٌ","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 1/193","srcLabel":"الطبراني","text":[["كلُّ قرضٍ ",1],["صدَقةٌ",2],"."],"grade":"صحيح","narrator":"[عبدالله بن مسعود]","muhaddith":"صحيح أو حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (3498)، وابن عدي في ((الكامل في الضعفاء)) (2/143)، والبيهقي في ((شعب الإيمان)) (3563)","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"OfFp608h"},{"id":"س-06680","fp":"2fe7831fb5a0","stateId":435,"easy":"إذا منحت منيحة لبن أو هديت طريقاً ← فهو لك صدقة","cause":"ومَن منَحَ مَنيحةَ لبَنٍ، أو هدَى زُقاقًا","result":"كان له صدقةً","explicit":true,"ref":"تخريج شرح السنة 817","srcLabel":"أحمد","text":["إنَّ اللهَ وملائكتَه يُصلُّونَ على الذينَ يَصِلونَ الصفَّ الأولَ، وزَيِّنوا القرآنَ بأصواتِكم، ",["ومَن منَحَ مَنيحةَ لبَنٍ، أو هدَى زُقاقًا ",1],["كان له صدقةً",2],"."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"إسناده صحيح","takhrij":"أخرجه البغوي في ((شرح السنة)) (817) واللفظ له، وأحمد (18616)، وعبد الرزاق (4175) باختلاف يسير.","bab":"صلاة الجماعة والإمامة › إقامة الصفوف ووصلها وفضائلها","dorar":"ze5oAY1Q"},{"id":"س-06272","fp":"f91c48553856","stateId":436,"easy":"إذا أنفقت المرأة من بيت زوجها غير مفسدة ← فلها أجر ما أنفقت ولزوجها أجر ما كسب","cause":"إذا أنفقتِ امرأةٌ من بيت زوجِها غيرَ مُفْسِدَةٍ","result":"كانَ لَها أجر بما أنفقَت ولزوجِها أجرُ ما كسبَ وللخازنِ مثلُ ذلِكَ ، لا ينقصُ بعضُهُم من أجرِ بعضٍ شيئًا","explicit":true,"similar":["س-02874","س-06268","س-06270","س-01300"],"ref":"التمهيد 1/228","srcLabel":"متفق عليه","text":["قال رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : ",["إذا أنفقتِ امرأةٌ من بيت زوجِها غيرَ مُفْسِدَةٍ ",1],["كانَ لَها أجر بما أنفقَت ولزوجِها أجرُ ما كسبَ وللخازنِ مثلُ ذلِكَ ، لا ينقصُ بعضُهُم من أجرِ بعضٍ شيئًا",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1359)، ومسلم (1034)، وأبو داود (1685) بلفظه.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"kYaskxhz","merged":2,"otherRefs":["صحيح أبي داود 1685 (صحيح)"]},{"id":"س-02874","fp":"7a95b1eac76a","stateId":436,"easy":"إذا تصدقت المرأة من بيت زوجها غير مفسدة ← فلها أجرها ولزوجها أجره وللخازن مثله","cause":"إذا تصدَّقَتِ المرأةُ مِن بيتِ زوجِها غيرَ مفسدةٍ","result":"فلها أجرُها ولزوجِها أجرٌ ما اكتسَب ولها أجرٌ ما نوَتْ وللخازنِ مِثْلُ ذلك","explicit":true,"repOf":"س-06272","ref":"تخريج صحيح ابن حبان 3358","text":[["إذا تصدَّقَتِ المرأةُ مِن بيتِ زوجِها غيرَ مفسدةٍ ",1],["فلها أجرُها ولزوجِها أجرٌ ما اكتسَب ولها أجرٌ ما نوَتْ وللخازنِ مِثْلُ ذلك",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (3358) واللفظ له، والبخاري (1437)، والحميدي (278) باختلاف يسير.","bab":"إيمان › الوعد","dorar":"GhACWWDq"},{"id":"س-04907","fp":"199cbf56b5b3","stateId":436,"easy":"إذا تصدقت المرأة من مال زوجها بإذنه ← فله نصف أجرها","cause":"تصدَّقتْ مِن صدقةٍ","result":"فله نصفُ صدقتِها","explicit":true,"similar":["س-01309"],"ref":"صحيح ابن حبان 4170","srcLabel":"متفق عليه","text":["لا يحِلُّ لامرأةٍ أنْ تصومَ وزوجُها شاهدٌ إلَّا بإذنِه ولا تأذَنَ لرجلٍ في بيتِها وهو له كارهٌ وما ",["تصدَّقتْ مِن صدقةٍ",1]," ",["فله نصفُ صدقتِها",2]," وإنَّما خُلِقتْ مِن ضِلَعٍ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (5195،3331)، ومسلم (1026، 1468) مطولاً مفرقاً بلفظ مقارب","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"N8D6JoNM"},{"id":"س-06268","fp":"feef3160b438","stateId":436,"easy":"إذا أطعمت المرأة من بيت زوجها غير مفسدة ← فلها أجرها وله مثله وللخازن مثله","cause":"إذا أنفقتِ المرأةُ وقالَ أبي في حديثِه: إذا أطعمتِ المرأةُ من بيتِ زوجِها، غيرَ مُفسِدةٍ","result":"كانَ لَها أجرُها، ولَهُ مثلُهُ بما اكتسَبَ، ولَها بما أنفقَتْ، وللخازنِ مثلُ ذلِكَ، من غيرِ أن ينقُصَ من أجورِهم شيئًا","explicit":true,"repOf":"س-06272","ref":"صحيح ابن ماجه 1872","text":[["إذا أنفقتِ المرأةُ وقالَ أبي في حديثِه: إذا أطعمتِ المرأةُ من بيتِ زوجِها، غيرَ مُفسِدةٍ، ",1],["كانَ لَها أجرُها، ولَهُ مثلُهُ بما اكتسَبَ، ولَها بما أنفقَتْ، وللخازنِ مثلُ ذلِكَ، من غيرِ أن ينقُصَ من أجورِهم شيئًا",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1440)، ومسلم (1024)، وابن ماجه (2294) واللفظ له","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"hYUurcON"},{"id":"س-06266","fp":"72e8c4d1e0a1","stateId":436,"easy":"إذا أنفقت المرأة من كسب زوجها بغير أمره (في المعتاد) ← فله نصف أجره","cause":"إذا أنفَقَتِ المَرأةُ مِن كَسبِ زَوجِها عن غيرِ أمرِه","result":"فلَه نِصفُ أجرِه","explicit":true,"similar":["س-01359"],"ref":"صحيح البخاري 2066","srcLabel":"مسلم","text":[["إذا أنفَقَتِ المَرأةُ مِن كَسبِ زَوجِها عن غيرِ أمرِه، ",1],["فلَه نِصفُ أجرِه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1026) مطولاً باختلاف يسير","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"5a1hr720","merged":2,"otherRefs":["صحيح أبي داود 1687 (صحيح)"]},{"id":"س-01359","fp":"e0816170eb31","stateId":436,"easy":"إذا أنفقت المرأة من كسب زوجها بغير إذنه (في المعروف) ← فلها نصف أجره","cause":"وما أَنفَقَتْ مِن كَسْبِه مِن غَيْرِ إذْنِه","result":"فإنَّ نِصْفَ أجْرِه له","explicit":true,"repOf":"س-06266","ref":"الأحكام الوسطى 2/ 230","text":["[لا تَصُمِ المَرْأةُ وبَعْلُها شاهِدٌ [عليها] إلَّا بإذْنِه، ولا تَأذَنْ في بَيْتِه وهو شاهِدٌ إلَّا بإذْنِه، ",["وما أَنفَقَتْ مِن كَسْبِه مِن غَيْرِ إذْنِه",1]," ",["فإنَّ نِصْفَ أجْرِه له",2],"].\nوقالَ أبو داوُدَ: \"غَيْرَ رَمَضانَ\"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه مسلم (1026)، والبيهقي (7926)، وعبد الرزاق (7886) بلفظه.","bab":"نكاح › عشرة النساء","dorar":"FdXXTioG"},{"id":"س-06251","fp":"a672376d2829","stateId":436,"easy":"إذا أطعمت المسكين من مال سيدك ← فالأجر بينكما","cause":"فجاءني مسكينٌ فأطعمتُه","result":"الأجرُ بينكما","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المحلى 9/162","srcLabel":"مسلم","text":["عن عميرٍ مولى أبي اللحمِ قال : أمرني مولايَ أن أُقدِّدَ لحمًا ",["فجاءني مسكينٌ فأطعمتُه",1]," فعلم بذلك مولايَ فضربني فأتيتُ رسولَ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ فدعاهُ فقال لِمَ ضربْتَه فقال يطعمُ طعامي بغيرِ أن آمُرَه فقال رسولُ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ ",["الأجرُ بينكما",2]],"grade":"صحيح","narrator":"عمير مولى آبي اللحم","muhaddith":"احتج به ، وقال في المقدمة: (لم نحتج إلا بخبر صحيح من رواية الثقات مسند)","takhrij":"أخرجه النسائي (2537)، واللفظ له، ومسلم (1025)، والبيهقي (7935)،باختلاف يسير، وابن أبي عاصم في ((الآحاد والمثاني)) (2674)، بلفظ مقارب.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"E5uiSrLW","merged":3,"otherRefs":["تخريج صحيح ابن حبان 3360 (صحيح)","صحيح ابن ماجه 1874 (صحيح)"]},{"id":"س-06270","fp":"c39946884ea3","stateId":436,"easy":"إذا تصدقت المرأة من بيت زوجها ← فلها أجر وللزوج مثله وللخازن مثله","cause":"إذا تصدَّقتِ المرأةُ من بيتِ زوجِها","result":"كانَ لَها أجرٌ، وللزَّوجِ مِثلُ ذلِكَ، وللخازِنِ مثلُ ذلِكَ ، ولا ينقُصُ كلُّ واحدٍ منهُما مِن أجرِ صاحبِهِ شيئًا، للزَّوجِ بما كسَبَ ، ولَها بما أنفَقَت","explicit":true,"repOf":"س-06272","ref":"صحيح النسائي 2538","text":[["إذا تصدَّقتِ المرأةُ من بيتِ زوجِها، ",1],["كانَ لَها أجرٌ، وللزَّوجِ مِثلُ ذلِكَ، وللخازِنِ مثلُ ذلِكَ ، ولا ينقُصُ كلُّ واحدٍ منهُما مِن أجرِ صاحبِهِ شيئًا، للزَّوجِ بما كسَبَ ، ولَها بما أنفَقَت",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (671)، والنسائي (2539)","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"u5rD7QOl"},{"id":"س-01309","fp":"68e1b5828bfe","stateId":436,"easy":"إذا أنفقت المرأة من مال زوجها بغير أمره ← فله نصف الأجر","cause":"وما أنفَقَت مِن نَفَقةٍ عن غيرِ أمرِه","result":"فإنَّه يُؤَدَّى إليه شَطرُه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-04907","ref":"صحيح البخاري 5195","text":["لا يَحِلُّ للمَرأةِ أن تَصومَ وزَوجُها شاهِدٌ إلَّا بإذنِه، ولا تَأذَنَ في بَيتِه إلَّا بإذنِه، ",["وما أنفَقَت مِن نَفَقةٍ عن غيرِ أمرِه",1]," ",["فإنَّه يُؤَدَّى إليه شَطرُه",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1026) باختلاف يسير","bab":"نكاح › حق الزوج على المرأة","dorar":"s5hxBviE"},{"id":"س-01300","fp":"646efa7397ba","stateId":436,"easy":"إذا تصدقت المرأة من قوتها في بيت زوجها ← فالأجر بينهما","cause":"إلَّا مِن قُوتِها","result":"والأجرُ بينَهما","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-06272","ref":"تخريج سنن أبي داود 1688","text":["عن أبى هريرة: في المرأةِ: تَصَدَّقُ مِن بيتِ زَوجِها؟ قال: لا، ",["إلَّا مِن قُوتِها",1],"، ",["والأجرُ بينَهما",2],"، ولا يَحِلُّ لها أنْ تَصدَّقَ مِن مالِ زَوجِها إلَّا بإذنِه."],"grade":"صحيح","narrator":"عطاء بن أبي رباح","muhaddith":"إسناده صحيح","takhrij":"أخرجه عبدالرزاق (7273)، وابن أبي شيبة (22516) باختلاف يسير، والبيهقي (8105)","bab":"نكاح › حسن العشرة بين الأزواج","dorar":"dSoVv7gq"},{"id":"س-02227","fp":"49b3ceac8f1b","stateId":437,"easy":"إذا أنفقت نفقة في سبيل الله ← تُكتب لك سبعمئة ضعف","cause":"مَنْ أنْفَقَ نَفَقَةً في سبيلِ اللهِ","result":"كُتِبَ لهُ سبعُ مِائَةِ ضِعْفٍ","explicit":true,"ref":"صحيح الموارد 1373","srcLabel":"الترمذي","text":[["مَنْ أنْفَقَ نَفَقَةً في سبيلِ اللهِ ؛ ",1],["كُتِبَ لهُ سبعُ مِائَةِ ضِعْفٍ",2]],"grade":"صحيح","narrator":"خريم بن فاتك الأسدي","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (4647) واللفظ له، وأخرجه الترمذي (1625)، والنسائي (3186) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"tATyBRE5"},{"id":"س-06126","fp":"57f284de4ed1","stateId":437,"easy":"إذا تصدقت على أمك بشيء ثم ماتت ← وجب أجرك وردّه عليك الميراث","cause":"إنِّي تَصَدَّقتُ على أُمِّي بجاريةٍ، وإنَّها ماتَت","result":"وجَبَ أجرُكِ، ورَدَّها عليكِ الميراثُ","explicit":true,"star":true,"otherNeedIds":[1],"ref":"صحيح مسلم 1149","srcLabel":"متفق عليه","text":["بينا أنا جالِسٌ عِندَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم إذ أتَتْه امرَأةٌ، فقالت: ",["إنِّي تَصَدَّقتُ على أُمِّي بجاريةٍ، وإنَّها ماتَت",1],"، قال: فقال: ",["وجَبَ أجرُكِ، ورَدَّها عليكِ الميراثُ",2],"، قالت: يا رَسولَ اللهِ، إنَّه كان عليها صَومُ شَهرٍ، أفَأصومُ عَنها؟ قال: صومي عَنها، قالت: إنَّها لَم تَحُجَّ قَطُّ، أفَأحُجُّ عَنها؟ قال: حُجِّي عَنها. [وفي رِوايةٍ]: صَومُ شَهرَينِ."],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"زكاة › المتصدق يرث صدقته","dorar":"brWp4ZmC","merged":6,"otherRefs":["معجم الشيوخ 1/397 (صحيح)","صحيح ابن ماجه 1954 (صحيح)","صحيح أبي داود 2877 (صحيح)","صحيح ابن خزيمة 4/ 182 (صحيح)","تخريج المسند لشعيب 23054 (صحيح)"]},{"id":"س-03573","fp":"71757bcce225","stateId":437,"easy":"إذا أنفقت ← تؤجر في كل شيء إلا ما تجعله في البناء الزائد","cause":"إنَّ المُسلِمَ لَيُؤجَرُ في كُلِّ شَيءٍ يُنفِقُه","result":"إلَّا في شَيءٍ يَجعَلُه في هذا التُّرابِ","explicit":true,"otherNeedIds":[52,3],"ref":"صحيح البخاري 5672","srcLabel":"مسلم","text":["دَخَلنا على خَبَّابٍ نَعودُه، وقدِ اكتَوى سَبعَ كَيَّاتٍ، فقال: إنَّ أصحابَنا الذينَ سَلَفوا مَضَوا ولَم تَنقُصْهمُ الدُّنيا، وإنَّا أصَبنا ما لا نَجِدُ له مَوضِعًا إلَّا التُّرابَ، ولَولا أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم نَهانا أن نَدعوَ بالمَوتِ لَدَعَوتُ به. ثُمَّ أتَيناه مَرَّةً أُخرى وهو يَبني حائِطًا له، فقال: ",["إنَّ المُسلِمَ لَيُؤجَرُ في كُلِّ شَيءٍ يُنفِقُه، ",1],["إلَّا في شَيءٍ يَجعَلُه في هذا التُّرابِ",2],"."],"grade":"صحيح","narrator":"خباب بن الأرت","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2681) مختصراً باختلاف يسير","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"Dd7VCTAo","merged":5,"otherRefs":["تخريج الإحياء للعراقي 4/291 (حسن)","الأحكام الشرعية الصغرى 865 (صحيح)","شرح كتاب الشهاب 229 (صحيح)","السلسلة الصحيحة 6/800 (صحيح)"]},{"id":"س-05896","fp":"c542f9de2da2","stateId":437,"easy":"إذا قدّمت من مالك صدقة ← فهو مالك الحقيقي الباقي","cause":"ما قدَّمْتَ","result":"ما لك مِن مالِكَ إلَّا","explicit":true,"otherNeedIds":[1],"ref":"تخريج المسند لشعيب 3626","srcLabel":"مسلم","text":["\"أَيُّكم مالُ وارثِه أحَبُّ إليه مِن مالِه؟!\"، قال: قالوا: يا رسولَ اللهِ، ما منَّا أحدٌ إلَّا مالُه أحَبُّ إليه مِن مالِ وارثِه، قال: \"اعلَموا أنَّه ليس منكم أحدٌ إلَّا مالُ وارثِه أحَبُّ إليه مِن مالِه، ",["ما لك مِن مالِكَ إلَّا",2]," ",["ما قدَّمْتَ",1],"، ومالُ وارثِكَ ما أخَّرْتَ\".\nقال: وقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: \"ما تعُدُّونَ فيكم الصُّرَعةَ؟\"، قال: قُلْنا: الذي لا يَصرَعُه الرَّجالُ، قال: قال: \"لا، ولكنِ الصُّرَعةَ: الذي يملِكُ نفْسَه عندَ الغَضبِ\".\nقال: وقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: \"ما تعُدُّونَ فيكم الرَّقوبَ؟\"، قال: قُلْنا: الذي لا وَلدَ له، قال: \"لا، ولكنِ الرَّقوبُ: الذي لم يُقدِّمْ مِن وَلدِه شيئًا\"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (2608)، وأبو داود (4779)، والنسائي (3612) مختصراً، وأحمد (3626) واللفظ له","bab":"رقائق وزهد › الوصايا النافعة","dorar":"8jYNoG7e","merged":4,"otherRefs":["تخريج صحيح ابن حبان 3330 (صحيح)","الضعفاء الكبير 2/321 (حسن)","تهذيب الكمال 15/324 (حسن)"]},{"id":"س-06293","fp":"cce1f52795a7","stateId":437,"easy":"إذا تصدقت على المسكين ← فهي صدقة","cause":"صدَقَتُكَ على المِسكينِ","result":"صدَقةٌ","explicit":true,"similar":["س-06355"],"ref":"تخريج المسند لشعيب 17871","srcLabel":"البخاري","text":["مع الغُلامِ عَقيقَتُه، فأَهْرِقوا عنه دَمًا، وأَميطوا عنه الأَذى، قال: وسمِعْتُه يقولُ: ",["صدَقَتُكَ على المِسكينِ ",1],["صدَقةٌ",2],"، وعلى ذي القُرْبى الرحِمِ ثِنْتانِ: صدَقةٌ، وصِلةٌ."],"grade":"صحيح","narrator":"سلمان بن عامر الضبى","muhaddith":"صحيح","takhrij":"أخرجه البخاري معلقاً بعد حديث (5471) مختصراً، وأخرجه موصولاً أبو داود (2839) مختصراً، والترمذي (1515، 658) مفرقاً، والنسائي (4214، 2582) مفرقاً، وابن ماجه (1844، 3164) مفرقاً، وأحمد (17871) واللفظ له","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"vJjw5IV3"},{"id":"س-06355","fp":"5ec17c31d31c","stateId":437,"easy":"إذا تصدقت من مالك ← فهي صدقة","cause":"إنَّ صدَقتَكَ من مالِكَ","result":"صدقةٌ","explicit":true,"repOf":"س-06293","ref":"صحيح الجامع 3081","text":["الثُّلُثُ و الثُّلُثُ كثيرٌ ، ",["إنَّ صدَقتَكَ من مالِكَ",1]," ",["صدقةٌ",2]," ، و إنَّ نفقَتَكَ على عِيالِكَ صدقةٌ ، و إنَّ ما تأْكلُ امرأتُكَ من مالِكَ صدقةٌ ، و إنَّكَ أنْ تدَعَ أهلَكَ بِخيرٍ خيرٌ من أنْ تدَعَهمْ يتَكَفَّفُونَ النّاسَ"],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1295)، ومسلم (1628)، وأبو داود (2864)، والترمذي (2116) واللفظ لهم.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"8T526meL"},{"id":"س-06362","fp":"7f39ccb93731","stateId":437,"easy":"إذا تصدقت بناقة في سبيل الله ← لك بها سبعمائة ناقة يوم القيامة","cause":"بناقةٍ مَخطومةٍ، فقال: هذه في سَبيلِ اللهِ","result":"لكَ بها يَومَ القيامةِ سَبعُ مِائةِ ناقةٍ، كُلُّها مَخطومةٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[67,49],"ref":"صحيح مسلم 1892","srcLabel":"متفق عليه","text":["جاءَ رَجُلٌ ",["بناقةٍ مَخطومةٍ، فقال: هذه في سَبيلِ اللهِ",1],"، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["لكَ بها يَومَ القيامةِ سَبعُ مِائةِ ناقةٍ، كُلُّها مَخطومةٌ",2],"."],"grade":"صحيح","narrator":"أبو مسعود عقبة بن عمرو","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"0pmAk1DI","merged":3,"otherRefs":["حلية الأولياء 8/119 (صحيح)","تخريج المسند لشعيب 22358 (صحيح)"]},{"id":"ق-0089","fp":"c20d8910ad91","stateId":437,"easy":"إقراض الله قرضاً حسناً (الإنفاق) ← المضاعفة أضعافاً كثيرة","cause":"إقراض الله قرضاً حسناً (الإنفاق)","result":"المضاعفة أضعافاً كثيرة","explicit":true,"similar":["ق-1297","ق-1301","ق-1348"],"otherNeedIds":[1],"ref":"سورة البقرة: 245","srcLabel":"القرآن الكريم","quran":{"s":2,"from":245,"to":245,"text":"مَنْ ذَا الَّذِي يُقْرِضُ اللَّهَ قَرْضًا حَسَنًا فَيُضَاعِفَهُ لَهُ أَضْعَافًا كَثِيرَةً وَاللَّهُ يَقْبِضُ وَيَبْسُطُ وَإِلَيْهِ تُرْجَعُونَ (245)","hl":[[0,142,1]]}},{"id":"ق-0096","fp":"9889885d8501","stateId":437,"easy":"الإنفاق في سبيل الله ← المضاعفة إلى سبعمائة ضعف وأكثر","cause":"الإنفاق في سبيل الله","result":"المضاعفة إلى سبعمائة ضعف وأكثر","explicit":true,"otherNeedIds":[1],"ref":"سورة البقرة: 261","srcLabel":"القرآن الكريم","quran":{"s":2,"from":261,"to":261,"text":"مَثَلُ الَّذِينَ يُنْفِقُونَ أَمْوَالَهُمْ فِي سَبِيلِ اللَّهِ كَمَثَلِ حَبَّةٍ أَنْبَتَتْ سَبْعَ سَنَابِلَ فِي كُلِّ سُنْبُلَةٍ مِائَةُ حَبَّةٍ وَاللَّهُ يُضَاعِفُ لِمَنْ يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ (261)","hl":[[7,205,1]]}},{"id":"ق-0097","fp":"cc6b57be9a3d","stateId":437,"easy":"الإنفاق في سبيل الله بلا منٍّ ولا أذى ← الأجر عند الله ولا خوف ولا حزن","cause":"الإنفاق في سبيل الله بلا منٍّ ولا أذى","result":"الأجر عند الله ولا خوف ولا حزن","explicit":true,"otherNeedIds":[6],"ref":"سورة البقرة: 262","srcLabel":"القرآن الكريم","quran":{"s":2,"from":262,"to":262,"text":"الَّذِينَ يُنْفِقُونَ أَمْوَالَهُمْ فِي سَبِيلِ اللَّهِ ثُمَّ لَا يُتْبِعُونَ مَا أَنْفَقُوا مَنًّا وَلَا أَذًى لَهُمْ أَجْرُهُمْ عِنْدَ رَبِّهِمْ وَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ (262)","hl":[[0,193,1]]}},{"id":"ق-0100","fp":"d48d8f8446d7","stateId":437,"easy":"الإنفاق ابتغاء مرضاة الله وتثبيتاً من النفس ← مضاعفة الثمرة","cause":"الإنفاق ابتغاء مرضاة الله وتثبيتاً من النفس","result":"مضاعفة الثمرة","explicit":true,"otherNeedIds":[1],"ref":"سورة البقرة: 265","srcLabel":"القرآن الكريم","quran":{"s":2,"from":265,"to":265,"text":"وَمَثَلُ الَّذِينَ يُنْفِقُونَ أَمْوَالَهُمُ ابْتِغَاءَ مَرْضَاتِ اللَّهِ وَتَثْبِيتًا مِنْ أَنْفُسِهِمْ كَمَثَلِ جَنَّةٍ بِرَبْوَةٍ أَصَابَهَا وَابِلٌ فَآتَتْ أُكُلَهَا ضِعْفَيْنِ فَإِنْ لَمْ يُصِبْهَا وَابِلٌ فَطَلٌّ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ (265)","hl":[[9,254,1]]}},{"id":"ق-0103","fp":"0ca58a45ab40","stateId":437,"easy":"الإنفاق والنذر ← يعلمه الله ويجازي به","cause":"الإنفاق والنذر","result":"يعلمه الله ويجازي به","explicit":true,"similar":["ق-0146"],"ref":"سورة البقرة: 270","srcLabel":"القرآن الكريم","quran":{"s":2,"from":270,"to":270,"text":"وَمَا أَنْفَقْتُمْ مِنْ نَفَقَةٍ أَوْ نَذَرْتُمْ مِنْ نَذْرٍ فَإِنَّ اللَّهَ يَعْلَمُهُ وَمَا لِلظَّالِمِينَ مِنْ أَنْصَارٍ (270)","hl":[[0,87,1]]}},{"id":"ق-0106","fp":"c07be7fd058f","stateId":437,"easy":"الإنفاق ابتغاء وجه الله ← يوفّى إليكم ولا تظلمون","cause":"الإنفاق ابتغاء وجه الله","result":"يوفّى إليكم ولا تظلمون","explicit":true,"similar":["ق-0474"],"otherNeedIds":[1],"ref":"سورة البقرة: 272","srcLabel":"القرآن الكريم","quran":{"s":2,"from":272,"to":272,"text":"لَيْسَ عَلَيْكَ هُدَاهُمْ وَلَكِنَّ اللَّهَ يَهْدِي مَنْ يَشَاءُ وَمَا تُنْفِقُوا مِنْ خَيْرٍ فَلِأَنْفُسِكُمْ وَمَا تُنْفِقُونَ إِلَّا ابْتِغَاءَ وَجْهِ اللَّهِ وَمَا تُنْفِقُوا مِنْ خَيْرٍ يُوَفَّ إِلَيْكُمْ وَأَنْتُمْ لَا تُظْلَمُونَ (272)","hl":[[65,236,1]]}},{"id":"ق-0107","fp":"025fede13bef","stateId":437,"easy":"الإنفاق على الفقراء المتعففين ← يعلمه الله ويجازي به","cause":"الإنفاق على الفقراء المتعففين","result":"يعلمه الله ويجازي به","explicit":true,"ref":"سورة البقرة: 273","srcLabel":"القرآن الكريم","quran":{"s":2,"from":273,"to":273,"text":"لِلْفُقَرَاءِ الَّذِينَ أُحْصِرُوا فِي سَبِيلِ اللَّهِ لَا يَسْتَطِيعُونَ ضَرْبًا فِي الْأَرْضِ يَحْسَبُهُمُ الْجَاهِلُ أَغْنِيَاءَ مِنَ التَّعَفُّفِ تَعْرِفُهُمْ بِسِيمَاهُمْ لَا يَسْأَلُونَ النَّاسَ إِلْحَافًا وَمَا تُنْفِقُوا مِنْ خَيْرٍ فَإِنَّ اللَّهَ بِهِ عَلِيمٌ (273)","hl":[[212,269,1]]}},{"id":"ق-0108","fp":"da2868988007","stateId":437,"easy":"الإنفاق بالليل والنهار سراً وعلانية ← الأجر عند الله ولا خوف ولا حزن","cause":"الإنفاق بالليل والنهار سراً وعلانية","result":"الأجر عند الله ولا خوف ولا حزن","explicit":true,"otherNeedIds":[6],"ref":"سورة البقرة: 274","srcLabel":"القرآن الكريم","quran":{"s":2,"from":274,"to":274,"text":"الَّذِينَ يُنْفِقُونَ أَمْوَالَهُمْ بِاللَّيْلِ وَالنَّهَارِ سِرًّا وَعَلَانِيَةً فَلَهُمْ أَجْرُهُمْ عِنْدَ رَبِّهِمْ وَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ (274)","hl":[[0,165,1]]}},{"id":"ق-0145","fp":"a0dd849268b7","stateId":437,"easy":"الإنفاق مما يحب العبد ← نيل البر","cause":"الإنفاق مما يحب العبد","result":"نيل البر","explicit":true,"otherNeedIds":[17],"ref":"سورة آل عمران: 92","srcLabel":"القرآن الكريم","quran":{"s":3,"from":92,"to":92,"text":"لَنْ تَنَالُوا الْبِرَّ حَتَّى تُنْفِقُوا مِمَّا تُحِبُّونَ وَمَا تُنْفِقُوا مِنْ شَيْءٍ فَإِنَّ اللَّهَ بِهِ عَلِيمٌ (92)","hl":[[0,59,1]]}},{"id":"ق-0146","fp":"c35084fd1769","stateId":437,"easy":"الإنفاق ← يعلمه الله ويجازي به","cause":"الإنفاق","result":"يعلمه الله ويجازي به","explicit":true,"repOf":"ق-0103","ref":"سورة آل عمران: 92","quran":{"s":3,"from":92,"to":92,"text":"لَنْ تَنَالُوا الْبِرَّ حَتَّى تُنْفِقُوا مِمَّا تُحِبُّونَ وَمَا تُنْفِقُوا مِنْ شَيْءٍ فَإِنَّ اللَّهَ بِهِ عَلِيمٌ (92)","hl":[[60,117,1]]}},{"id":"ق-0474","fp":"4b6895ae4586","stateId":437,"easy":"الإنفاق في سبيل الله ← يوفّى إليكم ولا تظلمون","cause":"الإنفاق في سبيل الله","result":"يوفّى إليكم ولا تظلمون","explicit":true,"repOf":"ق-0106","otherNeedIds":[1],"ref":"سورة الأنفال: 60","quran":{"s":8,"from":60,"to":60,"text":"وَأَعِدُّوا لَهُمْ مَا اسْتَطَعْتُمْ مِنْ قُوَّةٍ وَمِنْ رِبَاطِ الْخَيْلِ تُرْهِبُونَ بِهِ عَدُوَّ اللَّهِ وَعَدُوَّكُمْ وَآخَرِينَ مِنْ دُونِهِمْ لَا تَعْلَمُونَهُمُ اللَّهُ يَعْلَمُهُمْ وَمَا تُنْفِقُوا مِنْ شَيْءٍ فِي سَبِيلِ اللَّهِ يُوَفَّ إِلَيْكُمْ وَأَنْتُمْ لَا تُظْلَمُونَ (60)","hl":[[189,283,1]]}},{"id":"ق-0613","fp":"9695f081e972","stateId":437,"easy":"الصدقة ← جزاء الله للمتصدقين","cause":"الصدقة","result":"جزاء الله للمتصدقين","explicit":true,"ref":"سورة يوسف: 88","srcLabel":"القرآن الكريم","quran":{"s":12,"from":88,"to":88,"text":"فَلَمَّا دَخَلُوا عَلَيْهِ قَالُوا يَا أَيُّهَا الْعَزِيزُ مَسَّنَا وَأَهْلَنَا الضُّرُّ وَجِئْنَا بِبِضَاعَةٍ مُزْجَاةٍ فَأَوْفِ لَنَا الْكَيْلَ وَتَصَدَّقْ عَلَيْنَا إِنَّ اللَّهَ يَجْزِي الْمُتَصَدِّقِينَ (88)","hl":[[146,207,1]]}},{"id":"ق-0960","fp":"65e34ba511d8","stateId":437,"easy":"الزكاة ابتغاء وجه الله ← المضاعفة","cause":"الزكاة ابتغاء وجه الله","result":"المضاعفة","explicit":true,"otherNeedIds":[1],"ref":"سورة الروم: 39","srcLabel":"القرآن الكريم","quran":{"s":30,"from":39,"to":39,"text":"وَمَا آتَيْتُمْ مِنْ رِبًا لِيَرْبُوَ فِي أَمْوَالِ النَّاسِ فَلَا يَرْبُو عِنْدَ اللَّهِ وَمَا آتَيْتُمْ مِنْ زَكَاةٍ تُرِيدُونَ وَجْهَ اللَّهِ فَأُولَئِكَ هُمُ الْمُضْعِفُونَ (39)","hl":[[90,176,1]]}},{"id":"ق-1295","fp":"f85d694420ec","stateId":437,"easy":"الإيمان والإنفاق ← أجر كبير","cause":"الإيمان والإنفاق","result":"أجر كبير","explicit":true,"ref":"سورة الحديد: 7","srcLabel":"القرآن الكريم","quran":{"s":57,"from":7,"to":7,"text":"آمِنُوا بِاللَّهِ وَرَسُولِهِ وَأَنْفِقُوا مِمَّا جَعَلَكُمْ مُسْتَخْلَفِينَ فِيهِ فَالَّذِينَ آمَنُوا مِنْكُمْ وَأَنْفَقُوا لَهُمْ أَجْرٌ كَبِيرٌ (7)","hl":[[83,146,1]]}},{"id":"ق-1297","fp":"d2ffa2578586","stateId":437,"easy":"إقراض الله قرضاً حسناً ← المضاعفة وأجر كريم","cause":"إقراض الله قرضاً حسناً","result":"المضاعفة وأجر كريم","explicit":true,"repOf":"ق-0089","otherNeedIds":[1],"ref":"سورة الحديد: 11","quran":{"s":57,"from":11,"to":11,"text":"مَنْ ذَا الَّذِي يُقْرِضُ اللَّهَ قَرْضًا حَسَنًا فَيُضَاعِفَهُ لَهُ وَلَهُ أَجْرٌ كَرِيمٌ (11)","hl":[[0,90,1]]}},{"id":"ق-1301","fp":"a6269269d4dd","stateId":437,"easy":"التصدق وإقراض الله قرضاً حسناً ← المضاعفة وأجر كريم","cause":"التصدق وإقراض الله قرضاً حسناً","result":"المضاعفة وأجر كريم","explicit":true,"repOf":"ق-0089","otherNeedIds":[1],"ref":"سورة الحديد: 18","quran":{"s":57,"from":18,"to":18,"text":"إِنَّ الْمُصَّدِّقِينَ وَالْمُصَّدِّقَاتِ وَأَقْرَضُوا اللَّهَ قَرْضًا حَسَنًا يُضَاعَفُ لَهُمْ وَلَهُمْ أَجْرٌ كَرِيمٌ (18)","hl":[[0,119,1]]}},{"id":"ق-1348","fp":"7962ee1a42fb","stateId":437,"easy":"إقراض الله قرضاً حسناً ← المضاعفة والمغفرة وشكر الله","cause":"إقراض الله قرضاً حسناً","result":"المضاعفة والمغفرة وشكر الله","explicit":true,"repOf":"ق-0089","otherNeedIds":[11,1],"ref":"سورة التغابن: 17","quran":{"s":64,"from":17,"to":17,"text":"إِنْ تُقْرِضُوا اللَّهَ قَرْضًا حَسَنًا يُضَاعِفْهُ لَكُمْ وَيَغْفِرْ لَكُمْ وَاللَّهُ شَكُورٌ حَلِيمٌ (17)","hl":[[0,102,1]]}},{"id":"ق-1392","fp":"d3882fa6ef63","stateId":437,"easy":"تقديم الخير: الصلاة والزكاة والقرض الحسن ← تجده عند الله خيراً وأعظم أجراً","cause":"تقديم الخير: الصلاة والزكاة والقرض الحسن","result":"تجده عند الله خيراً وأعظم أجراً","explicit":true,"ref":"سورة المزمل: 20","srcLabel":"القرآن الكريم","quran":{"s":73,"from":20,"to":20,"text":"إِنَّ رَبَّكَ يَعْلَمُ أَنَّكَ تَقُومُ أَدْنَى مِنْ ثُلُثَيِ اللَّيْلِ وَنِصْفَهُ وَثُلُثَهُ وَطَائِفَةٌ مِنَ الَّذِينَ مَعَكَ وَاللَّهُ يُقَدِّرُ اللَّيْلَ وَالنَّهَارَ عَلِمَ أَنْ لَنْ تُحْصُوهُ فَتَابَ عَلَيْكُمْ فَاقْرَءُوا مَا تَيَسَّرَ مِنَ الْقُرْآنِ عَلِمَ أَنْ سَيَكُونُ مِنْكُمْ مَرْضَى وَآخَرُونَ يَضْرِبُونَ فِي الْأَرْضِ يَبْتَغُونَ مِنْ فَضْلِ اللَّهِ وَآخَرُونَ يُقَاتِلُونَ فِي سَبِيلِ اللَّهِ فَاقْرَءُوا مَا تَيَسَّرَ مِنْهُ وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ وَأَقْرِضُوا اللَّهَ قَرْضًا حَسَنًا وَمَا تُقَدِّمُوا لِأَنْفُسِكُمْ مِنْ خَيْرٍ تَجِدُوهُ عِنْدَ اللَّهِ هُوَ خَيْرًا وَأَعْظَمَ أَجْرًا وَاسْتَغْفِرُوا اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ (20)","hl":[[443,623,1]]}},{"id":"س-06075","fp":"b00dd1a7f94f","stateId":437,"easy":"إذا وقيت عرضك بمالك ← تُكتب لك صدقة","cause":"وما وقى به المرءُ المسلِمُ عِرضَه","result":"كُتِب له به صَدَقةٌ","explicit":true,"ref":"عارضة الأحوذي 3/325","srcLabel":"البيهقي","text":["كلُّ معروفٍ صدقَةٌ [وما أنفَقَ المسلِمُ من نفقتِه على نفسِه وأهلِه، كُتِب له بها صَدَقةٌ، ",["وما وقى به المرءُ المسلِمُ عِرضَه",1]," ",["كُتِب له به صَدَقةٌ",2],"، وكُلُّ نَفَقةٍ أنفقها المسلِمُ فعلى اللهِ خَلَفُها ضامِنًا، إلَّا نَفَقةً في بنيانٍ أو معصيةٍ\". قال: فقلتُ لابنِ المنكَدِرِ: ما قولُه: \"وما وقى به المرءُ المُسلِمُ عِرضَه\"؟ قال: أن يعطِيَ الشَّاعِرَ وذا اللِّسانِ]"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه البيهقي (21172), وعبد بن حميد في ((مسنده)) (1081), وابن عدي في ((الكامل))  (8/ 180) واللفظ لهم.","bab":"رقائق وزهد › ما جاء في فعل الخير","dorar":"s0svCHUS","merged":4,"otherRefs":["الوهم والإيهام 5/243 (صحيح)","المستدرك على الصحيحين 2346 (صحيح)","تخريج شرح السنة 1646 (صحيح)"]},{"id":"س-06320","fp":"a86c7720dec2","stateId":437,"easy":"إذا تصدقت فلا تعد في صدقتك ← توافيك يوم القيامة","cause":"اترُكْها","result":"تُوافِكَ ، أو تَلقَها جميعًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[65],"ref":"تخريج المسند لشاكر 1/94","srcLabel":"متفق عليه","text":["قال أسلم: إنَّ عمرَ ، حَملَ علَى فرسٍ في سَبيلِ اللَّهِ عزَّ وجلَّ ، فرَآها أو بَعضَ نتاجِها يُباعُ ، فأرادَ شراءَهُ ، فسألَ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ عنهُ فقالَ : ",["اترُكْها",1]," ",["تُوافِكَ ، أو تَلقَها جميعًا",2]," وقالَ مرَّتينِ فنَهاهُ ، وقالَ : لا تشترِهِ ، ولا تَعُد في صدَقتِكَ"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (166) بلفظه، والبخاري (1489)، ومسلم (1620) بنحوه.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"q41pRoTT"},{"id":"س-04233","fp":"a29cc51a1e93","stateId":437,"easy":"إذا أنفقت نفقة فاضلة في سبيل الله ← فبسبعمئة ضعف","cause":"مَن أنفَق نفقةً فاضلةً في سبيلِ اللهِ","result":"فبِسَبْعِمِئةِ","explicit":true,"similar":["س-06265","س-06342","س-06369"],"ref":"تخريج صحيح ابن حبان 6171","srcLabel":"ابن حبان","text":["النَّاسُ أربعةٌ والأعمالُ ستَّةٌ مُوجبتانِ ومِثْلٌ بمِثْلٍ وحسَنةٌ بعَشْرِ أمثالِها وحسَنةٌ بسَبْعِمئةِ ضِعْفٍ والنَّاسُ موسَّعٌ عليه في الدُّنيا والآخرةِ وموسَّعٌ عليه في الدُّنيا مَقتورٌ عليه في الآخرةِ ومَقتورٌ عليه في الدُّنيا موسَّعٌ عليه في الآخرةِ ومَقتورٌ عليه في الدُّنيا والآخرةِ وشَقيٌّ في الدُّنيا وشَقيٌّ في الآخرةِ والمُوجِبتانِ : مَن قال لا إلهَ إلَّا اللهُ أو قال : مؤمنًا باللهِ دخَل الجنَّةَ ومَن مات وهو يُشرِكُ باللهِ دخَل النَّارَ ومَن هَمَّ بحسَنةٍ فعمِلها كُتِبَتْ له عَشَرةُ أمثالِها ومَن هَمَّ بحسَنةٍ فلم يعمَلْها كُتِبَتْ له حسَنةٌ ومَن هَمَّ بسيِّئةٍ فلم يعمَلْها كُتِبَتْ له حسَنةٌ ومَن هَمَّ بسيِّئةٍ فعمِلها كُتِبَتْ له سيِّئةٌ واحدةٌ غيرُ مضعَّفةٍ و",["مَن أنفَق نفقةً فاضلةً في سبيلِ اللهِ",1]," ",["فبِسَبْعِمِئةِ",2]," ضِعْفٍ"],"grade":"صحيح","narrator":"خريم بن فاتك الأسدي","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (6171) واللفظ له، وابن أبي شيبة في ((مسنده)) (743)، وابن ابي عاصم في ((الآحاد والمثاني)) (1047)، والطبراني (4/ 205)(4151) جميعهم باختلاف يسير .","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"0BwkAjc5","merged":3,"otherRefs":["الأحاديث المختارة 1117 (صحيح)","الأحاديث المختارة 1120 (صحيح)"]},{"id":"س-03558","fp":"c52d1b858ed9","stateId":437,"easy":"إذا أديت زكاتك إلى رسول الإمام ← برئت منها ولك أجرها وإثمها على من بدّلها","cause":"إذا أدَّيتَها إلى رسولي","result":"فقد برئتَ منها ولكَ أجرُها وإثمُها على من بدَّلَها","explicit":true,"ref":"مجمع الزوائد 3/66","srcLabel":"أحمد","text":["أتى رجلٌ من بني تميمٍ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ يا رسولَ اللَّهِ إنِّي ذو مالٍ كثيرٍ وذو أهلٍ ومالٍ وحاضرةٍ فأخبرني كيفَ أصنعُ وكيفَ أنفقُ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ تخرجُ الزَّكاةَ من مالِكَ فإنَّها طهرةٌ تطهِّرُكَ وتصلُ أقرباءَكَ وتعرفُ حقَّ المسكينِ والجارِ والسَّائلِ فقالَ يا رسولَ اللَّهِ أقلِل لي فقالَ آتِ ذا القربى حقَّهُ والمسكينَ وابنَ السَّبيلِ ولا تبذِّر تبذيرًا فقالَ [حسبي] يا رسولَ اللَّهِ إذا أدَّيتُ الزَّكاةَ إلى رسولِكَ فقد برئتُ منها إلى اللَّهِ ورسولهِ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ نعم ",["إذا أدَّيتَها إلى رسولي",1]," ",["فقد برئتَ منها ولكَ أجرُها وإثمُها على من بدَّلَها",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (12417)، والطبراني في ((المعجم الأوسط)) (8802)","bab":"استغفار › مكفرات الذنوب","dorar":"301XQaUt","merged":2,"otherRefs":["المستدرك على الصحيحين 3417 (صحيح)"]},{"id":"س-06138","fp":"fe7dff6d90fa","stateId":437,"easy":"إذا أعطيت الزكاة محتسباً ← فلك أجرها","cause":"مَن أعطاها مؤتَجرًا","result":"فلَهُ أجرُها","explicit":true,"ref":"صحيح ابن خزيمة 4/ 31","srcLabel":"النسائي","text":["في كلِّ إبلٍ سائمةٍ في كلِّ أربعينَ بنتُ لبونٍ، لا يفرَّقُ إبلٌ مِن حسابِها، ",["مَن أعطاها مؤتَجرًا",1]," ",["فلَهُ أجرُها",2],"، ومن منعَها، فإنَّا آخِذُها وشطرَ إبلِهِ عزمةٌ من عزماتِ ربِّنا، لا يحلُّ لآلِ مُحمَّدٍ منها شيءٌ . [وفي روايةٍ]: مِن كلِّ أربعينَ بنتُ لبونٍ . [وفي رِوايةٍ]: ومن أبى فأَنا آخِذُها وشطرَ مالِهِ، وقالَ: لا يفرَّقُ إبلٌ مِن حسابِها"],"grade":"صحيح","narrator":"معاوية بن حيدة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه النسائي (2444)، وأحمد (20016)، والدارمي (1719) واللفظ لهم.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"ZSBa2M5g","merged":2,"otherRefs":["تهذيب السنن 4/453 (صحيح)"]},{"id":"س-06345","fp":"f483828f60dc","stateId":437,"easy":"إذا تصدقت ← فالصدقة بعشر أمثالها","cause":"الصَّدقةُ","result":"بعشرِ أمثالِها","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 1/193","srcLabel":"ابن ماجه","text":["رأيتُ ليلةَ أُسريَ بي على بابِ الجنَّةِ مَكْتوبًا ",["الصَّدقةُ",1]," ",["بعشرِ أمثالِها",2]," والقرضُ بثمانيةَ عشرَ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح أو حسن","takhrij":"أخرجه مطولاً ابن ماجه (2431) واللفظ له، وابن حبان في ((المجروحين)) (1/320)، والطبراني في ((المعجم الأوسط)) (6719)","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"KzrTrRVY","merged":2,"otherRefs":["السلسلة الصحيحة 3407 (حسن)"]},{"id":"س-07712","fp":"fcc80f36bf9c","stateId":437,"easy":"إذا بعت نفسك ومالك لله ← ربح البيع (من قصة صهيب)","cause":"لا تَصِلونَ إليَّ حتَّى أضَعَ في كلِّ رَجُلٍ مِنكم سَهمًا، ثمَّ أَصيرَ بعدَ إلى السَّيفِ فتَعلَمونَ أنِّي رَجُلٌ، وقد خلَّفْتُ بمكَّةَ قَينَتَينِ فهُما لكُم","result":"رَبِحَ البَيعُ رَبِحَ البَيعُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[67],"ref":"المستدرك على الصحيحين 5816","srcLabel":"مسلم","text":["نحو [خرَجَ صُهَيبٌ مُهاجِرًا تَبِعَه أهْلُ مكَّةَ فنَثَلَ كِنانَتَه، فأخرَجَ منها أرْبَعينَ سَهمًا، فقالَ: ",["لا تَصِلونَ إليَّ حتَّى أضَعَ في كلِّ رَجُلٍ مِنكم سَهمًا، ثمَّ أَصيرَ بعدَ إلى السَّيفِ فتَعلَمونَ أنِّي رَجُلٌ، وقد خلَّفْتُ بمكَّةَ قَينَتَينِ فهُما لكُم",1],"]، ونزَلَتْ على النَّبيِّ صلَّى اللهُ عليه وسلَّمَ: {وَمِنَ النَّاسِ مَنْ يَشْرِي نَفْسَهُ ابْتِغَاءَ مَرْضَاةِ اللَّهِ} [البقرة: 207] الآيةَ، فلمَّا رَآهُ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ قالَ: أبا يَحْيى، ",["رَبِحَ البَيعُ رَبِحَ البَيعُ",2],"، قالَ: وتَلا عليه الآيةَ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح على شرط مسلم","bab":"قرآن › أسباب النزول","dorar":"0SWYIKiF"},{"id":"س-06257","fp":"ac4058b8bd15","stateId":437,"easy":"إذا كانت لك صدقة ← تتم بها زكاتك","cause":"فإن كانت لَهُ صدقة","result":"تمَّت له زَكاتُهُ","explicit":true,"otherNeedIds":[65],"ref":"الترغيب والترهيب 1/187","srcLabel":"الترغيب والترهيب","text":["إنَّ أوَّلَ ما افتَرضَ اللَّهُ على النَّاسِ من دينِهِمُ الصَّلاةُ ، وآخرَ ما يبقى الصَّلاةُ ، وأوَّلَ ما يحاسبُ بِهِ الصَّلاةُ ، ويقولُ اللَّهُ انظُروا في صلاةِ عبدي . فإن كانت تامَّةً كُتِبت تامَّةً ، وإن كانت ناقصةً يقولُ : انظُروا هل لعبدي تطوُّعٍ ؟ فإن وُجِدَ لَهُ تطوُّعٌ تمَّتِ الفريضةُ منَ التَّطوُّعِ ، ثمَّ قالَ : انظُروا هل زَكاتُهُ تامَّةٌ ؟ فإن كانت تامَّةً كُتِبت تامَّةً ، وإن كانت ناقِصةً قالَ : انظروا هل لَهُ صدقةٌ ؟ ",["فإن كانت لَهُ صدقة",1]," ",["تمَّت له زَكاتُهُ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"nQR3w5rf"},{"id":"س-06265","fp":"d5260ee136ac","stateId":437,"easy":"إذا أنفقت في سبيل الله ← فالحسنة بسبعمئة","cause":"ومن أنفقَ في سبيلِ اللهِ","result":"فحسنةٌ بسبعمائةٍ","explicit":true,"repOf":"س-04233","ref":"مجمع الزوائد 1/26","text":["الأعمالُ ستةٌ والناسُ أربعةٌ فموجبتانِ ومثلٌ بمثلٍ وحسنةٌ بعشرِ أمثالِها وحسنةٌ بسبعمائةِ ضعفٍ فأما الموجبتانِ فمن مات لا يشركُ باللهِ شيئًا دخل الجنةََ ومن مات يشركُ باللهِ شيئًا دخل النارَ وأما مثلٌ بمثلٍ فمَن همَّ بحسنةٍ حتى يُشعِرَها قلبَه ويعلمُها اللهُ منه كُتِبت له حسنةٌ ومن عمِل سيئةً كُتِبَت عليه سيئةٌ ومن عمل حسنةً فبعشرِ أمثالِها ",["ومن أنفقَ في سبيلِ اللهِ",1]," ",["فحسنةٌ بسبعمائةٍ",2]," ، وأما الناسُ فموسَّعٌ عليه في الدنيا مقتورٌ عليه في الآخرةِ ومقتورٌ عليه في الدنيا وموسعٌ عليه في الآخرةِ"],"grade":"صحيح","narrator":"خريم بن فاتك الأسدي","muhaddith":"رجاله رجال الصحيح إلا أنه قال عن الركين بن الربيع عن رجل عن خريم وقال الطبراني عن الركين بن الربيع عن أبيه عن عمه يسير بن عميلة ورجاله ثقات","takhrij":"أخرجه أحمد (18920)، وابن حبان (6171)، والطبراني (4/206) (4151) باختلاف يسير.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"vWLW9M9R"},{"id":"س-06342","fp":"bd9d3953105a","stateId":437,"easy":"إذا أنفقت نفقة في سبيل الله ← تُكتب بسبعمئة ضعف","cause":"مَنْ أَنفَقَ نَفقةً في سبيلِ اللهِ","result":"كُتِبَتْ بسبعِ مائةِ ضِعفٍ","explicit":true,"repOf":"س-04233","ref":"المستدرك على الصحيحين 2476","text":[["مَنْ أَنفَقَ نَفقةً في سبيلِ اللهِ؛ ",1],["كُتِبَتْ بسبعِ مائةِ ضِعفٍ",2],"."],"grade":"صحيح","narrator":"خريم بن فاتك الأسدي","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (19036)، والبغوي في ((معجم الصحابة)) (628) بلفظه.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"RuuDkbXj"},{"id":"س-06369","fp":"922f4fdb8962","stateId":437,"easy":"إذا أنفقت نفقة في سبيل الله ← تكون لك بسبعمئة ضعف","cause":"ومَن أنفقَ نفقةً في سبيلِ اللَّهِ ، عزَّ وجلَّ","result":"كانت لَهُ بسبعِمائةِ ضعفٍ","explicit":true,"repOf":"س-04233","ref":"عمدة التفسير 1/846","text":["النَّاسُ أربعةٌ ، والعمَّالُ ستَّةٌ . فالنَّاسُ موسَّعٌ لَهُ في الدُّنيا والآخرةِ ، وموسَّعٌ لَهُ في الدُّنيا مقتورٌ عليهِ في الآخرةِ ، ومقتورٌ عليهِ في الدُّنيا موسَّعٌ لَهُ في الآخرةِ ، وشقيٌ في الدُّنيا والآخرةِ . والأعمالُ موجبتانِ ، ومثلٌ بمثلٍ ، وعشرةُ أضعافٍ ، وسبعُمائةِ ضعفٍ ؛ فالموجبتانِ مَن ماتَ مسلمًا مؤمنًا لا يشرِكُ باللَّهِ شيئًا وجبَتْ لَهُ الجنَّةُ ، ومَن ماتَ كافرًا وجبَتْ لَهُ النَّارُ . ومَن همَّ بحسنةٍ فلَم يعملْها ، فعلِمَ اللَّهُ أنَّهُ قد أشعرَها قلبَه وحرصَ علَيها ، كُتبَت لَهُ حسنةً . ومَن همَّ بسيِّئةٍ لم تُكْتَب عليهِ ، ومَن عمِلَها كُتبَت واحدةً ولم تُضاعَف عليهِ . ومَن عملَ حسنةً كانت له بعشرةِ أمثالِها . ",["ومَن أنفقَ نفقةً في سبيلِ اللَّهِ ، عزَّ وجلَّ ، ",1],["كانت لَهُ بسبعِمائةِ ضعفٍ",2]],"grade":"صحيح","narrator":"خريم بن فاتك الأسدي","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي شيبة في ((مسنده)) (743)، وابن ابي عاصم في ((الآحاد والمثاني)) (1047)، وابن حبان (4630) جميعهم باختلاف يسير .","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"mVsonKjD"},{"id":"س-02127","fp":"1b00f48913e0","stateId":437,"easy":"إذا تصدقت ← يبقى لك ما تصدقت به","cause":"ما بَقِيَ منها إلَّا كَتِفُها","result":"بَقِيَ كُلُّها غيرُ كَتِفِها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-06108"],"otherNeedIds":[1],"ref":"تخريج رياض الصالحين 558","srcLabel":"الترمذي","text":["عن عائشةَ رضِيَ اللهُ عنها أنَّهم ذَبَحوا شاةً، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: \"ما بَقِيَ منها؟ \"قالت: ",["ما بَقِيَ منها إلَّا كَتِفُها",1],"، قال: \"",["بَقِيَ كُلُّها غيرُ كَتِفِها",2],"\"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (2470) واللفظ له، وأحمد (24240)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Ysg4YFk2","merged":3,"otherRefs":["معجم الشيوخ 2/647 (حسن)","السلسلة الصحيحة 6/98 (حسن)"]},{"id":"س-05562","fp":"f030b5e48a31","stateId":437,"easy":"إذا تصدقت ← فهو ما أمضيت لنفسك","cause":"تصدَّقتَ","result":"فأمضَيتَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[1],"ref":"تخريج مشكل الآثار 1658","srcLabel":"مسلم","text":["عن مُطرِّفِ بنِ عبدِ اللهِ، عن أبيه، أنَّه انتَهى إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وهو يَقرَأُ: {أَلْهَاكُمُ التَّكَاثُرُ} [التكاثر: 1] فقال: يقولُ ابنُ آدَمَ: مالي مالي، وما لكَ من مالِكَ إلَّا ما ",["تصدَّقتَ",1]," ",["فأمضَيتَ",2],"، أو أَكَلتَ فأفنَيتَ، أو لَبِستَ فأبلَيتَ."],"grade":"صحيح","narrator":"عبدالله بن الشخير","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2958)، والترمذي (2342)، والنسائي (3613)، وأحمد (16305) واللفظ لهم.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"gWSvpd8Z","merged":2,"otherRefs":["المستدرك على الصحيحين 8126 (صحيح)"]},{"id":"س-05535","fp":"f9b664ef5290","stateId":437,"easy":"إذا أعطيت من مالك ← فهو ما أبقيت لنفسك","cause":"ما أعْطى","result":"فأبْقى","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[1],"ref":"صحيح الموارد 2106","srcLabel":"مسلم","text":["يقولُ العبدُ : مالي مالي ، وإنَّما له من مالِهِ ثلاثةٌ : ما أكلَ فأفْنى ، أو [ ",["ما ] أعْطى",1]," ",["فأبْقى",2]," ، أو لَبِسَ فأبْلى ، وما سِوى ذلك ؛ فهو ذاهبٌ وتاركُهُ للناسِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2959)","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"SYvXHeFs"},{"id":"س-06108","fp":"91f1bd71a081","stateId":437,"easy":"إذا تصدقت ← فما تصدقت به هو الباقي لك","cause":"حتى أطعَمَ الشاةَ جَميعًا","result":"كُلُّها واللهِ لنا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-02127","otherNeedIds":[1],"ref":"تخريج شرح السنة 1636","text":["ذُبِحَ في بَيتِ أُمِّ سَلَمةَ شاةٌ، فلَمَّا سُلِختْ، جاءَ مِسكينٌ يَستَطعِمُ، فقامَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ هو نَفْسُه، فقَطَعَ له منها عُضوًا، فأطعَمَه، فذَهَبَ المِسكينُ، فدَلَّ آخَرَ، فقامَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقَطَعَ له منها عُضوًا، فأطعَمَه، فتَدالُّوا عليه، فلم يَزَلْ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يُطعِمُهم ",["حتى أطعَمَ الشاةَ جَميعًا",1],"، فقالت أُمُّ سَلَمةَ: يا رَسولَ اللهِ، ألَا تَركتَ لنا بَعضَ شاتِنا نأكُلُه؟ فقال: ",["كُلُّها واللهِ لنا",2],"."],"grade":"حسن","narrator":"المطلب","muhaddith":"رجاله ثقات إلا أن المطلب بن عبد الله كثير الإرسال والتدليس [وله شاهد]","takhrij":"أخرجه البغوي في ((شرح السنة)) (1636)، وعلي بن حجر في ((أحاديث إسماعيل بن جعفر)) (361) واللفظ لهما.","bab":"رقائق وزهد › معيشة النبي صلى الله عليه وسلم","dorar":"FnadaPBL"},{"id":"س-06364","fp":"d63c28c241f2","stateId":437,"easy":"إذا أعطيت ناقة في سبيل الله ← تجيء هي وأولادها في ميزانك","cause":"أَعطَيتُ ناقةً في سَبيلِ اللهِ","result":"تَجيءَ يَومَ القيامةِ هي وأولادُها في مِيزانِكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[65],"ref":"مسند الفاروق 1/367","srcLabel":"الطبراني","text":[["أَعطَيتُ ناقةً في سَبيلِ اللهِ",1],"، فأرَدتُ أنْ أشتَريَ مِن نَسلِها -أو قال: مِن ضِئضِئِها- فسألتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ فقال: دَعْها حتى ",["تَجيءَ يَومَ القيامةِ هي وأولادُها في مِيزانِكَ",2],"."],"grade":"حسن","narrator":"عمر بن الخطاب","muhaddith":"إسناده جيد","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (1281)، والمخلص في ((المخلصيات)) (1881)، والضياء المقدسي في ((الأحاديث المختارة)) (237) واللفظ لهم.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"dAaQ73rb"},{"id":"س-06394","fp":"daf87dd67ff2","stateId":437,"easy":"إذا وزعت طعامك على الجيران ← بقي لك كله","cause":"فوَزَّعها بَينَ الجيرانِ","result":"بَقِيَ كُلُّها إلَّا الذِّراعَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سبل الهدى والرشاد 7/186","srcLabel":"الترمذي","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم أمَر أن تُذبَحَ شاةٌ فيَقسِمَها بين الجيرانِ قال: ",["فوَزَّعها بَينَ الجيرانِ",1],"، ورُفعَت الذِّراعُ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم، وكان أحَبَّ الشَّاةِ إليه الذِّراعُ، فلمَّا جاء رسولُ اللهِ صلَّى اللهُ عليه وسلَّم قالت عائشةُ رَضِيَ اللهُ تعالى عنها: ما بَقِيَ عندنا منها إلَّا الذِّراعُ، قال: «",["بَقِيَ كُلُّها إلَّا الذِّراعَ",2],"»"],"grade":"حسن","narrator":"عائشة","muhaddith":"رجاله ثقات","takhrij":"أخرجه الترمذي (2470)، وأحمد (24240)، وابن أبي شيبة (9909) بنحوه.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"NTk7G5ct"},{"id":"س-02072","fp":"686fe5dfa178","stateId":438,"easy":"إذا صمت ← فالصيام لله وهو يجزي به","cause":"الصيامُ","result":"لِي، وأَنَا أجْزِي به","explicit":true,"star":true,"similar":["س-02116","س-01791","س-01987"],"otherNeedIds":[26],"ref":"لطائف المعارف 312","srcLabel":"متفق عليه","text":[["الصيامُ",1]," جُنَّةٌ [يعني حديث: أنَّ رَسولَ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ، قالَ: الصِّيَامُ جُنَّةٌ فلا يَرْفُثْ ولَا يَجْهلْ، وإنِ امْرُؤٌ قَاتَلَهُ أوْ شَاتَمَهُ فَلْيَقُلْ: إنِّي صَائِمٌ مَرَّتَيْنِ وَالَّذِي نَفْسِي بيَدِهِ لَخُلُوفُ فَمِ الصَّائِمِ أطْيَبُ عِنْدَ اللَّهِ تَعَالَى مِن رِيحِ المِسْكِ. يَتْرُكُ طَعَامَهُ وشَرَابَهُ وشَهْوَتَهُ مِن أجْلِي الصِّيَامُ ",["لِي، وأَنَا أجْزِي به",2]," والحَسَنَةُ بعَشْرِ أمْثَالِهَا.]"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"ثابت","takhrij":"أخرجه مسلم (1151) واللفظ له، والبخاري (1894)، وأبو داود (2363) بلفظه تامًا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"7rq3bUXQ","merged":21,"otherRefs":["تخريج صحيح ابن حبان 3416 (صحيح)","صحيح ابن خزيمة 3/ 349 (صحيح)","تخريج المسند لشعيب 10693 (صحيح)","تخريج المسند لشعيب 10176 (صحيح)","تخريج المسند لشعيب 10218 (صحيح)","صحيح الجامع 3881 (حسن)","تخريج المسند لشعيب 9363 (صحيح)","تخريج المسند لشعيب 7494 (صحيح)","صحيح النسائي 2218 (صحيح)","صحيح الترغيب 978 (صحيح)","مجمع الزوائد 3/183 (حسن)","صحيح مسلم 1151 (صحيح)","مجمع الزوائد 3/182 (صحيح)","الجامع الصغير 5993 (صحيح)","تخريج المسند لشعيب 10691 (صحيح)","تخريج المسند لشعيب 7195 (صحيح)","ذخيرة الحفاظ 3/1659 (صحيح)","تخريج المسند لشعيب 4256 (صحيح)","مجمع الزوائد 3/185 (حسن)","أطراف الغرائب 2/382 (حسن)"]},{"id":"س-01718","fp":"823b59c75ccf","stateId":438,"easy":"إذا صمت يوماً ← فلك أجر تسعة","cause":"صُمْ يومًا","result":"ولكَ أَجرُ تسعةٍ","explicit":true,"star":true,"similar":["س-02064","س-06739","س-01890"],"ref":"تخريج المسند لشعيب 6877","srcLabel":"متفق عليه","text":["قال: أتَيْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فقُلْتُ: يا رسولَ اللهِ، مُرْني بصيامٍ، قال: ",["صُمْ يومًا",1]," ",["ولكَ أَجرُ تسعةٍ",2],"، قال: قُلْتُ: يا رسولَ اللهِ، إنِّي أجِدُ قوَّةً، فزِدْني، قال: صُمْ يومَينِ، ولكَ أَجرُ ثمانيةِ أيَّامٍ، قال: قُلْتُ: يا رسولَ اللهِ، إنِّي أجِدُ قوَّةً، فزِدْني، قال: فصُمْ ثلاثةَ أيَّامٍ ولكَ أَجرُ سبعةِ أيَّامٍ، قال: فما زال يحُطُّ لي، حتى قال: إنَّ أفضلَ الصَّومِ صَومُ أخي داوُدَ، أو نبيِّ اللهِ داوُدَ -شكَّ الجُرَيريُّ- صُمْ يومًا وأفطِرْ يومًا، فقال عبدُ اللهِ لمَّا ضعُفَ: لَيتني كنتُ قنَعْتُ بما أمَرَني به النَّبيُّ صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"رجاله ثقات، وهو صحيح بغير هذه السياقة","takhrij":"أخرجه البخاري (5052)، ومسلم (1159)، وأبو داود (2427)، والنسائي (2389)، وأحمد (6877) واللفظ له","bab":"أنبياء › خصائص وفضائل","dorar":"EuGSYbDj","merged":2,"otherRefs":["تخريج مشكل الآثار 5890 (صحيح)"]},{"id":"س-01975","fp":"8c1fa41eceec","stateId":438,"easy":"إذا فطّرت صائماً ← لك مثل أجره من غير أن ينقص من أجره شيء","cause":"مَن فَطَّرَ صائمًا","result":"كان له -أو: كُتِبَ له- مِثلُ أجرِ الصَّائمِ، مِن غيرِ أنْ يَنقُصَ مِن أجرِ الصَّائمِ شيئًا","explicit":true,"otherNeedIds":[49],"ref":"تخريج المسند لشعيب 21676","srcLabel":"متفق عليه","text":[["مَن فَطَّرَ صائمًا، ",1],["كان له -أو: كُتِبَ له- مِثلُ أجرِ الصَّائمِ، مِن غيرِ أنْ يَنقُصَ مِن أجرِ الصَّائمِ شيئًا، ",2],"ومَن جَهَّزَ غازيًا في سَبيلِ اللهِ، كان له -أو: كُتِبَ له- مِثلُ أجرِ الغازي في أنَّه لا يَنقُصُ مِن أجرِ الغازي شيئًا."],"grade":"صحيح","narrator":"زيد بن خالد الجهني","muhaddith":"الشطر الأول من الحديث حسن لغيره، والشطر الثاني صحيح","takhrij":"أخرجه البخاري (2843)، ومسلم (1895)، وأبو داود (2509)، والنسائي (3180) مختصراً، والترمذي (807، 1628) مفرقاً، وابن ماجه (1746، 2759) مفرقاً، وأحمد (21676) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"xyjD4Mxc","merged":2,"otherRefs":["صحيح ابن ماجه 1428 (صحيح)"]},{"id":"س-02116","fp":"db6c843a4b38","stateId":438,"easy":"إذا صمت ← فالصيام لله يجزي به بلا حد","cause":"إلَّا الصِّيامَ؛ فهو لي، وأنا أجزي به","result":"سَبعِ مِئةِ ضِعفٍ","explicit":true,"repOf":"س-02072","ref":"تخريج المسند لشعيب 10693","text":["والذي نَفْسي بيَدِهِ؛ لَخُلوفُ فَمِ الصَّائمِ أطيَبُ عِندَ اللهِ مِن ريحِ المِسكِ؛ يَذَرُ طَعامَهُ وشَرابَهُ وشَهوَتَهُ مِن أجْلي، فالصِّيامُ لي، وأنا أجزي به، كُلُّ حَسَنةٍ بعَشْرِ أمثالِها إلى ",["سَبعِ مِئةِ ضِعفٍ",2],"،",[" إلَّا الصِّيامَ؛ فهو لي، وأنا أجزي به.",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (7492) بنحوه، ومسلم (1151) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"sikWF8Es","merged":2,"otherRefs":["تخريج المسند لشعيب 10540 (صحيح)"]},{"id":"س-01791","fp":"6ed035916037","stateId":438,"easy":"إذا صمت ← فالصوم لله وهو يجزي به","cause":"كلُّ عَمَلِ ابنِ آدمَ لهُ ، إلَّا الصُّومُ","result":"فإنَّهُ لي ، وأنا أَجْزِي بهِ","explicit":true,"repOf":"س-02072","ref":"صحيح الترغيب 978","text":["قال اللهُ عزَّ وجلَّ : ",["كلُّ عَمَلِ ابنِ آدمَ لهُ ، إلَّا الصُّومُ ، ",1],["فإنَّهُ لي ، وأنا أَجْزِي بهِ",2]," ، والصِّيامُ جُنَّةٌ ، فإِذَا كان يومُ صِيامِ أَحَدِكُمْ فلا يَرْفُثْ ، ولا يَصْخَبْ ، فإنْ سابَهُ أحدٌ أوْ قاتَلهُ فَلْيَقُلْ : إِنِي صائِمٌ ، إِنِي صائِمٌ ، والذي نَفْسُ محمدٍ بيدِهِ لَخُلوفُ فَمِ الصَّائِمِ أطْيَبُ عندَ اللهِ من رِيحِ المِسْكِ ، لِلصَّائِمِ فَرْحَتَانِ يَفْرَحُهُما ، إذا أفْطَرَ فَرِحَ بفطرِهِ ، وإذَا لَقِيَ رَبَّهُ فَرِحَ بِصَوْمِهِ ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1904)، ومسلم (1151) باختلاف يسير.","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"ew6eS5Os"},{"id":"س-01987","fp":"6312202b1a20","stateId":438,"easy":"إذا صمت وتركت شهوتك لله ← فالصوم لله وهو يجزي به","cause":"صام هذا من أَجْلي، وترَك شَهوتَه عنِ الطَّعامِ والشَّرابِ من أَجْلي","result":"فالصومُ لي، وأنا أَجْزي به","explicit":true,"repOf":"س-02072","ref":"تخريج المسند لشعيب 11359","text":["\"لَخُلوفُ فَمِ الصَّائمِ أطيَبُ عندَ اللهِ من فَيْحِ المِسْكِ، قال: ",["صام هذا من أَجْلي، وترَك شَهوتَه عنِ الطَّعامِ والشَّرابِ من أَجْلي",1],"، ",["فالصومُ لي، وأنا أَجْزي به",2],"\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (11359). وأخرجه البخاري (1904) من حديث أبي هريرة رضي الله عنه. وأخرجه مسلم (1151) من حديث أبي هريرة وأبي سعيد الخدري.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"kO0SEcZy"},{"id":"س-06750","fp":"8448e1af0047","stateId":438,"easy":"إذا صمت ← فالصوم لا عدل له","cause":"عليك بالصَّومِ","result":"فإنَّه لا عِدلَ له، ثُمَّ أتَيتُه الثَّانيةَ","explicit":true,"similar":["س-03601","س-01988","س-01682","س-07223"],"ref":"تخريج المسند لشعيب 22149","srcLabel":"مسلم","text":["سَمِعتُ أبا نَصرٍ يُحدِّثُ عن رجاءِ بنِ حَيْوةَ، عن أبي أُمامةَ قال: أتَيتُ رسولَ اللهِ صَلَّى اللهُ عليه وسلَّمَ فقُلتُ: مُرْني بعملٍ يُدخِلُني الجنَّةَ، قال: ",["عليك بالصَّومِ؛ ",1],["فإنَّه لا عِدلَ له، ثُمَّ أتَيتُه الثَّانيةَ",2],"، فقال لي: عليك بالصِّيامِ."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه النسائي (2223) باختلاف يسير، وأحمد (22149) واللفظ له","bab":"صيام › فضل الصيام","dorar":"XTrkGJdp"},{"id":"س-03601","fp":"dd3655fcaf3c","stateId":438,"easy":"إذا صمت ← فالصوم لا مثل له","cause":"عليك بالصَّوْمِ","result":"فإنَّه لامِثلَ له","explicit":true,"repOf":"س-06750","ref":"الصحيح المسند 488","text":["أَنشَأَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ غَزْوةً، فأَتَيْتُه فقُلْتُ: يا رَسولَ اللهِ، ادْعُ اللهَ لي بالشَّهادةِ، فقالَ: «اللَّهُمَّ سَلِّمْهم وغَنِّمْهم»، قالَ: فسَلِمْنا وغَنِمْنا، قالَ: ثُمَّ أَنشَأَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ غَزْوًا ثانِيًا، فأَتَيْتُه فقُلْتُ: يا رَسولَ اللهِ، ادْعُ اللهَ لي بالشَّهادةِ، فقالَ: «اللَّهُمَّ سَلِّمْهم وغَنِّمْهم»، قالَ: ثُمَّ أَنشَأَ غَزْوًا ثالِثًا، فأَتَيْتُه فقُلْتُ: يا رَسولَ اللهِ، إنِّي أَتَيْتُك مَرَّتَينِ قَبْلَ مَرَّتي هذه فسَألْتُك أن تَدْعوَ اللهَ لي بالشَّهادةِ، فدَعَوْتَ اللهَ عَزَّ وجَلَّ أن يُسَلِّمَنا ويُغَنِّمَنا، فسَلَّمَنا وغَنَّمَنا، يا رَسولَ اللهِ، فادْعُ اللهَ لي بالشَّهادةِ، فقالَ: «اللَّهُمَّ سَلِّمْهم وغَنِّمْهم»، قالَ: فسَلِمْنا وغَنِمْنا، ثُمَّ أَتَيْتُه فقُلْتُ: يا رَسولَ اللهِ، مُرْني بعَمَلٍ، قالَ: «",["عليك بالصَّوْمِ؛ ",1],["فإنَّه لامِثلَ له»",2],"، قالَ: فما رُئِيَ أبو أُمامةَ ولا امْرَأتُه ولا خادِمُه إلَّا صُيَّامًا قالَ: فكانَ إذا رُئِيَ في دارِهم دُخانٌ بالنَّهارِ قيلَ: اعْتَراهم ضَيْف، نَزَلَ بِهم نازِلٌ، قالَ: فلَبِثَ بِذلك ما شاءَ اللهُ، ثُمَّ أَتَيْتُه فقُلْتُ: يا رَسولَ اللهِ، أَمَرْتَنا بالصِّيامِ، فأَرْجو أن يكونَ قد بارَكَ اللهُ لنا فيه يا رَسولَ اللهِ، فمُرْني بعَمَلٍ آخَرَ، قالَ: «اعْلَمْ أنَّك لن تَسجُدَ للهِ سَجْدةً إلَّا رَفَعَ اللهُ لك بِها دَرَجةً، وحَطَّ عنك بِها خَطيئةً»."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه أحمد (22140)، وعبد الرزاق (7899)، وابن حبان (146)، والطبراني (8/ 91) (7463) واللفظ لهم.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"bD6UQIb3","merged":6,"otherRefs":["تخريج المسند لشعيب 22220 (صحيح)","تخريج المسند لشعيب 22195 (صحيح)","مجموع الشروح الفقهية. 381/31 (حسن)","الأحكام الوسطى 2/206 (صحيح)","صحيح ابن حبان 3425 (صحيح)"]},{"id":"س-02064","fp":"1d9b0517d056","stateId":438,"easy":"إذا صمت يوماً ← فلك عشرة أيام","cause":"صم يومًا","result":"ولَكَ عَشرةُ أيَّامٍ","explicit":true,"repOf":"س-01718","ref":"تخريج المسند لشاكر 11/152","text":[["صم يومًا",1]," ",["ولَكَ عَشرةُ أيَّامٍ",2]," قالَ زِدني يا رسولَ اللَّهِ إنَّ بي قوَّةً قالَ صُم يومينِ ولَكَ تِسعةُ أيَّامٍ قالَ زِدني فإنِّي أجدُ قوَّةً قالَ صُم ثلاثةَ أيَّامٍ ولَكَ ثَمانيةُ أيَّامٍ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (2396)، وأحمد (6951) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"LoQQmdOx","merged":3,"otherRefs":["تخريج المسند لشاكر 10/55 (صحيح)","صحيح النسائي 2395 (صحيح)"]},{"id":"س-02159","fp":"8d80937efd99","stateId":438,"easy":"إذا صمت في الشتاء ← فهي الغنيمة الباردة","cause":"الصَّومُ في الشِّتاءِ","result":"الغَنيمةُ الباردةُ","explicit":true,"ref":"صحيح الترمذي 797","srcLabel":"الترمذي","text":[["الغَنيمةُ الباردةُ",2]," ،",["الصَّومُ في الشِّتاءِ",1]],"grade":"صحيح","narrator":"عامر بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (797) واللفظ له، وأحمد (18979)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"GVRSAN80","merged":2,"otherRefs":["الإصابة في تمييز الصحابة 2/260 (صحيح)"]},{"id":"س-06739","fp":"0a2e586df111","stateId":438,"easy":"إذا صمت يوماً من كل شهر ← فلك أجر ما بقي","cause":"صُم يومًا مِن كلِّ شَهْرٍ","result":"ولَكَ أجرُ ما بقيَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-01718","ref":"صحيح ابن خزيمة 3/ 512","text":["أتَيتُ رَسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ، فسَألتُهُ عنِ الصَّومِ، فقالَ: ",["صُم يومًا مِن كلِّ شَهْرٍ",1],"، ",["ولَكَ أجرُ ما بقيَ",2],"، قُلتُ: إنِّي أطيقُ أَكْثرَ مِن ذلِكَ، فقالَ: صُم يومينِ مِن كلِّ شَهْرٍ، ولَكَ أجرُ ما بقيَ، قلتُ: إنِّي أطيقُ أَكْثرَ من ذلِكَ قالَ: صُم ثلاثةَ أيَّامٍ ولَكَ أجرُ ما بقيَ، قُلتُ: إنِّي أطيقُ أَكْثرَ من ذلِكَ قالَ: صُم أربعةَ أيَّامٍ ولَكَ أجرُ ما بَقيَ قالَ: إنِّي أطيقُ أَكْثرَ مِن ذلِكَ، فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: إنَّ أحبَّ الصِّيامِ صومُ داودَ، كانَ يَصومُ يومًا، ويُفطِرُ يومًا"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (1159)، والنسائي (2394)، وابن حبان (170) بنحوه","bab":"صيام › فضل الصيام","dorar":"FespiLKx"},{"id":"س-01890","fp":"84a2eefec064","stateId":438,"easy":"إذا صمت من كل عشرة أيام يوماً ← فلك أجر التسعة","cause":"صُم من كلِّ عشرةِ أيَّامٍ يومًا","result":"ولَكَ أجرُ تلكَ التِّسعة","explicit":true,"repOf":"س-01718","ref":"صحيح النسائي 2394","text":[["صُم من كلِّ عشرةِ أيَّامٍ يومًا",1]," ، ",["ولَكَ أجرُ تلكَ التِّسعة",2],"، فقلتُ : إنِّي أقوى مِن ذلِكَ، قالَ : صُم من كلِّ تسعةِ أيَّامٍ يومًا ، ولَكَ أجرُ تلكَ الثَّمانيةِ، قلتُ : إنِّي أقوَى من ذلِكَ، قالَ : فصُم مِن كلِّ ثمانيةِ أيَّامٍ يومًا، ولَكَ أجرُ تلكَ السَّبعةِ ، قلتُ : إنِّي أقوى من ذلِكَ، قالَ: فلَم يزَلْ حتَّى قالَ : صُم يومًا ، وأفطَر يومًا"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه النسائي (2395) واللفظ له، وأحمد (7087)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"IhtBc7OT"},{"id":"س-01940","fp":"fc0c3c5ae462","stateId":438,"easy":"إذا صمت يوماً من المحرم ← فلك بكل يوم ثلاثون حسنة","cause":"منْ صامَ يومًا منْ المُحَرَّمِ","result":"فَلَهُ بِكُلِ يومٍ ثَلاثُونَ حسنةً","explicit":true,"ref":"الجامع الصغير 8763","srcLabel":"الطبراني","text":[["منْ صامَ يومًا منْ المُحَرَّمِ ",1],["فَلَهُ بِكُلِ يومٍ ثَلاثُونَ حسنةً",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (11/72) (11082)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"olSJLAR6"},{"id":"س-01875","fp":"88fe17b446a2","stateId":438,"easy":"إذا صمت يوماً تطوعاً ← لا يُستوفى ثوابه إلا يوم الحساب","cause":"صام يومًا تطوُّعًا","result":"لم يستوفِ ثوابَه دون يومِ الحسابِ","explicit":true,"ref":"الترغيب والترهيب 2/108","srcLabel":"الطبراني","text":["لو أنَّ رجلًا ",["صام يومًا تطوُّعًا",1]," ثمَّ أُعطِي ملْءَ الأرضِ ذهبًا ",["لم يستوفِ ثوابَه دون يومِ الحسابِ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"رواته ثقات إلا ليث بن أبي سليم","takhrij":"أخرجه أبو يعلى (6130) واللفظ له، والطبراني في ((المعجم الأوسط)) (4869)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"G3H1uj7g"},{"id":"س-01988","fp":"f03cbef702a5","stateId":438,"easy":"إذا صمت ← فالصوم قرض مجزئ عند الله","cause":"الصومُ","result":"قَرضٌ مُجْزئٌ","explicit":true,"repOf":"س-06750","ref":"تخريج المسند لشعيب 21365","text":["يا رسولَ اللهِ، ما ",["الصومُ",1],"؟ قال: ",["قَرضٌ مُجْزئٌ",2],"."],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (21365)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Rumqj0VT"},{"id":"س-01682","fp":"ca40d91944bb","stateId":438,"easy":"إذا صمت ← فهو فرض مجزي وعند الله أضعاف كثيرة","cause":"فما الصِّيامُ","result":"فرضٌ مَجزيٌّ ، وعندَ اللهِ أضعافٌ كثيرةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-06750","ref":"النوافح العطرة 227","text":["قُلِ الحقَّ وإن كان مُرًّا [يعني حديث: دخَلتُ علَى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وهو في المسجِدِ جالِسٌ، فاغتَنَمتُ خلوتَهُ، وحدَهُ، فجلَستُ إليهِ، فقالَ : أبا ذَرٍّ ! إن لِلمَسجِد تَحيَّةً، وإنَّ تحيَّتَهُ ركعتان فقُم فاركَعهما، قالَ : فقُمت فركَعتُها ثم عُدتُ فجلَستُ إليهِ، فقُلتُ : يا رسولَ اللهِ ! إنَّكَ أمَرتَني بالصَّلاةِ فما الصَّلاةُ ؟ قال : خيرٌ موضوعٌ استكثِرْ أو استَقِلَّ. قلتُ : يا رسولَ اللهِ ! فأيُّ الأعمالِ أفضَلُ ؟ قال : إيمانٌ باللَّهِ عزَّ وجلَّ، وجهادٌ في سبيلِهِ، قال : قلتُ : يا رسولَ اللهِ ! فأيُّ المؤمنينَ أكمَلُهم إيمانًا ؟ قالَ : أحسَنُهُم خُلُقًا. قالَ : قلتُ : يا رسولَ اللَّهِ ! فأيُّ المؤمنينَ أسلَمُ ؟ قالَ : مَن سلِمَ النَّاسُ من لسانِهِ ويدِهِ. قال : قلتُ : يا رسولَ اللَّهِ ! فأيُّ الهجرةِ أفضَلُ ؟ قال : مَن هجرَ السَّيِّئاتِ. قالَ : قُلتُ : يا رسولَ اللهِ ! فأيُّ الصَّلاةِ أفضَلُ ؟ قال : طولُ القنوتِ . قال : قلتُ : يا رسولَ اللهِ ! ",["فما الصِّيامُ",1]," ؟ قالَ : ",["فرضٌ مَجزيٌّ ، وعندَ اللهِ أضعافٌ كثيرةٌ",2],". قال : قلتُ : يا رسولَ اللهِ ! فأيُّ الجهادِ أفضَلُ ؟ قالَ : مَن عُقِرَ جوادُهُ وأهريقَ دمُهُ. قال : قُلتُ : يا رسولَ اللهِ ! فأيُّ الرِّقابِ أفضَلُ ؟ قالَ : أغلاها ثَمنًا وأنفَسُها عندَ ربِّها. قالَ : قلتُ : يا رسولَ اللهِ ! فأيُّ الصَّدقةِ أفضَلُ ؟ قال : جُهدٌ مِن مُقِلٍّ يُسَرُّ إلى فقيرٍ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ آيةٍ مِمَّا أنزلَ اللهُ عزَّ وجلَّ عليكَ أعظَمُ ؟ قال : آيةُ الكُرسيِّ. ثُمَّ قالَ : يا أبا ذَرٍّ ! ما السَّماواتُ السَّبعُ معَ الكُرسيِّ إلا كَحلقَةٍ مُلقاةٍ بأرضِ فلاةٍ، وفَضلُ العَرشِ على الكُرسيِّ كفَضلِ الفَلاةِ علَى الحَلقَةِ. قلتُ : يا رسولَ اللهِ ! كم الأنبياءُ ؟ قال : مائةُ ألفٍ وأربعةٌ وعِشرونَ ألفًا. قلتُ : يا رسولَ اللهِ ! كم الرُّسلِ ؟ قالَ : ثلاثُمائةٍ وثلاثَةُ عشرَ جَمًّا غفيرًا. قلتُ : كثيرٌ طيِّبٌ، قلتُ : يا رسولَ اللهِ ! مَن كان أوَّلُهمْ ؟ قال : آدَمُ. قلتُ : يا رسولَ اللهِ ! أنَبيٌّ مُرسَلٌ ؟ قال : نعَم، خلقَهُ اللهُ بيدِهِ، ونفخَ فيهِ مِن روحِهِ، ثُمَّ سوَّاهُ قِبَلًا. وقال أحمدُ بنُ أنَسٍ ثُمَّ كلَّمهُ قِبَلًا. ثُمَّ قالَ : يا أبا ذَرٍّ ! أربعةٌ سُريانيُّونَ؛ آدَمُ، وشيثُ، وخَنوخُ - وهو إدريسُ، وهم أوَّلُ مَن خطَّ بالقلَمِ - ونوحٌ. وأربعةٌ من العَربِ؛ هودٌ، وصالِحٌ، وشُعَيبٌ، ونبيُّكَ يا أبا ذَرٍّ. قال : قلتُ : يا رسولَ اللهِ ! كَم كتابٌ أنزلَهُ اللَّهُ تعالى ؟ قال : مائةُ كتابٍ وأربعةُ كتُبٍ، أنزلَ علَى شيثَ خَمسونَ صحيفَةً، وأنزلَ علَى خَنوخَ ثلاثونَ صَحيفةً، وأنزلَ على إبراهيمَ عشرَ صحائفَ، وأنزلَ على موسَى قبلَ التَّوراةِ عَشرَ صحائفَ، وأنزلَ التَّوراةَ والإنجيلَ والزَّبورَ والفُرقانَ. قال : قلتُ : يا رسولَ اللهِ ! فَما كانَت صُحفُ إبراهيمَ ؟ قالَ : كانَت أمثالًا كلُّها : أيُّها الملِكُ المسلَّطُ المبتَلَى المغرورُ، فإنِّي لم أبعثْكَ لتجمَعَ الدُّنيا بعضَها إلى بعضٍ، ولكن بعثتُكَ لترُدَّ عنِّي دعوةَ المظلومِ، فإنِّي لا أردُّها ولَو كانَت مِن كافِرٍ. وكانَت فيها أمثالٌ : علَى العاقِلِ ما لَم يكُن مغلوبًا علَى عقلِهِ أن تكونَ له ساعاتٌ؛ ساعَةٌ يُناجي فيها ربَّهُ عزَّ وجلَّ، وساعةٌ يحاسِبُ فيها نفسَهُ، وساعَةٌ يفكِّرُ فيها في صُنعِ اللَّهِ عزَّ وجلَّ، وساعةٌ يخلو فيها بحاجتِهِ من المطعَمِ والمشرَبِ، وعلى العاقلِ أن لا يكون ظاعِنًا إلَّا لثلاثٍ؛ تزوُّدٍ لمعادٍ، أو مرمَّةٍ لمعاشٍ، أو لذَّةٍ في غيرِ محرَّمٍ، وعلى العاقِلِ أن يكونَ بصيرًا بزمانِهِ، مقبِلًا على شأنِهِ، حافِظًا للسانِهِ، ومن حسَبَ كلامَهُ من عمَلِهِ قلَّ كلامُهُ إلا فيما يعنيهِ. قلتُ : يا رسولَ اللَّهِ ! فما كان صحُفُ موسَى عليهِ السَّلامُ ؟ قال : كانَت عبرًا كلَّها، عجبتُ لمن أيقنَ بالموتِ ثُمَّ هو يفرَحُ، عجبتُ لمن أيقنَ بالنَّارِ وهو يضحَكُ، عجبتُ لمن أيقنَ للقدرِ ثم هو ينصَبُ، عجبتُ لمن رأى الدُّنيا وتقلُّبَها ثُمَّ اطمأنَّ إليها، عجِبتُ لمن أيقنَ بالحسابِ غدًا ثُمَّ لا يعمَلُ. قلتُ : يا رسولَ اللهِ ! أوصِني. قال : أوصيكَ بتقوى اللهِ فإنَّهُ رأسُ الأمرِ كلِّهِ، قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بتلاوَةِ القرآنِ فإنَّهُ نور لكَ في الأرضِ وذكرٌ لكَ في السَّماءِ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : إيَّاكَ وكثرةَ الضَّحِكِ فإنَّهُ يُميتُ القَلبَ، ويَذهَبُ بنورِ الوَجهِ، قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : عليكَ بالصَّمتِ إلَّا مِن خيرٍ، فإنَّهُ مطردَةٌ للشَّيطانِ عنكَ، وعونٌ لكَ علَى أمر دينِكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بالجهادِ فإنَّهُ رهبانيَّةُ أمَّتي. قلتُ : يا رسولَ اللهِ ! زِدني. قال : حبُّ المساكينِ وجالِسهُم. قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : انظُر إلى مَن تحتَكَ ولا تنظُر إلى مَن فوقكَ فإنَّهُ أجدَرُ أن لا تَزدَري نِعمةَ اللهِ عندكَ. قلتُ : زِدني يا رسولَ اللهِ ! قال : صِلْ قرابَتَكَ وإن قَطعوكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : لا تَخَف في اللَّهِ تعالى لَومَةَ لائمٍ. قلتُ : يا رسولَ اللهِ ! زِدني. قالَ : قُل الحقَّ وإن كان مُرًّا. قلتُ : يا رسولَ اللهِ ! زِدني. قال : يردُّكَ عن النَّاسِ ما تعرفُ من نفسِكَ، ولا تجِد عليهِم فيما تأتي، وكفَى به عيبًا أن تعرِفَ من النَّاسِ ما تجهَلُ من نفسِكَ، أو تجِدُ عليهِم فيما تأتي. ثُمَّ ضربَ بيدِهِ علَى صدري، فقالَ : يا أبا ذَرٍّ ! لا عقلَ كالتَّدبيرِ، ولا ورعَ كالكَفِّ، ولا حسَبَ كحُسنِ الخُلُقِ، قلتُ : يارسولَ اللهِ ! هل لي في الدُّنيا شَيءٌ مِمَّا أنزلَ اللهُ عليكَ مِمَّا كان في صحُفِ إبراهيمَ وموسَى ؟ قال : يا أبا ذَرٍّ ! اقرَأ : ? قَد أفلَحَ مَن تزَكَّى? إلى آخرِ السُّورَةِ]"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مطولاً أحمد (21415)، والبزار (3966) باختلاف يسير، وابن حبان (361) واللفظ له","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"wZID7EAR"},{"id":"س-05967","fp":"aea2eb6e9478","stateId":438,"easy":"إذا صمتّ وحسّنت خلقك ← فهي أيسر العبادة وأهونها","cause":"الصَّمتُ، وحُسنُ الخُلُقِ","result":"ألا أُخبِرُكُم بأيسَرِ العِبادةِ وأهونِها على البَدَنِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"فيض القدير 3/ 103","srcLabel":"فيض القدير","text":[["ألا أُخبِرُكُم بأيسَرِ العِبادةِ وأهونِها على البَدَنِ",2],":",[" الصَّمتُ، وحُسنُ الخُلُقِ",1]],"grade":"حسن","narrator":"صفوان بن سليم","muhaddith":"رجاله ثقات","bab":"رقائق وزهد › الوصايا النافعة","dorar":"GxuwMy7G"},{"id":"س-07223","fp":"c918ec9d3aef","stateId":438,"easy":"إذا صمت ← فلا مثل للصوم","cause":"عليكَ بالصومِ فإنه لا مِثلَ له","result":"أيُّ الأعمالِ أفضلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-06750","ref":"آداب المشي إلى الصلاة 19","text":["أنَّ رجلًا سأل النبيَّ صلَّى اللهُ عليه وسلَّم ",["أيُّ الأعمالِ أفضلُ",2],"؟ قال: ",["عليكَ بالصومِ فإنه لا مِثلَ له",1]],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"إسناده حسن","takhrij":"أخرجه النسائي (4/165)، وأحمد في ((المسند)) (5/264)، وابن حبان (8/212) باختلاف يسير.","bab":"علم › حسن السؤال ونصح العالم","dorar":"87wXyebl"},{"id":"س-08177","fp":"7a8cd324b48a","stateId":438,"easy":"إذا صمت رمضان وعملت ← توفّى أجرك عند الفراغ","cause":"يعملون فإذا فرغوا من أعمالِهم","result":"وُفُّوا أجورَهم","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"apply":{"k":"time","t":"في رمضان"},"ref":"الترغيب والترهيب 2/113","srcLabel":"البيهقي","text":["أُعطِيَتْ أمَّتي في شهرِ رمضانَ خمسًا لم يُعطَهنَّ نبيٌّ قبلي أمَّا واحدةٌ فإنَّه إذا كان أوَّلُ ليلةٍ من شهرِ رمضانَ نظر اللهُ عزَّ وجلَّ إليهم ومن نظر اللهُ إليه لم يعذِّبْه أبدًا وأمَّا الثَّانيةُ فإنَّ خلوفَ أفواهِهم حين يُمسون أطيبُ عند اللهِ من ريحِ المسكِ وأمَّا الثَّالثةُ فإنَّ الملائكةَ تستغفِرُ لهم في كلِّ يومٍ وليلةٍ وأمَّا الرَّابعةُ فإنَّ اللهَ عزَّ وجلَّ يأمُرُ جنَّتَه فيقولُ لها استعدِّي وتزيَّني لعبادي أوْشَك أن يستريحوا من تعبِ الدُّنيا إلى داري وكرامتي وأمَّا الخامسةُ فإنَّه إذا كان آخرُ ليلةٍ غفر اللهُ لهم جميعًا فقال رجلٌ من القومِ أهي ليلةُ القدرِ فقال لا ألم ترَ إلى العمَّالِ ",["يعملون فإذا فرغوا من أعمالِهم",1]," ",["وُفُّوا أجورَهم",2]],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"إسناده مقارب أصلح مما قبله","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (3603)","bab":"ملائكة › أعمال الملائكة","dorar":"l5UNfhxc"}]}