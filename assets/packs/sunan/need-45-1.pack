Id":415,"easy":"الإيمان بالله ورسله بلا تفريق ← الأجور ومغفرة الله ورحمته","cause":"الإيمان بالله ورسله بلا تفريق","result":"الأجور ومغفرة الله ورحمته","explicit":true,"otherNeedIds":[11],"ref":"سورة النساء: 152","srcLabel":"القرآن الكريم","quran":{"s":4,"from":152,"to":152,"text":"وَالَّذِينَ آمَنُوا بِاللَّهِ وَرُسُلِهِ وَلَمْ يُفَرِّقُوا بَيْنَ أَحَدٍ مِنْهُمْ أُولَئِكَ سَوْفَ يُؤْتِيهِمْ أُجُورَهُمْ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا (152)","hl":[[0,157,1]]}},{"id":"ق-0280","fp":"54a61f36be6b","stateId":415,"easy":"الإيمان والعمل الصالح ← توفية الأجور وزيادة من فضل الله","cause":"الإيمان والعمل الصالح","result":"توفية الأجور وزيادة من فضل الله","explicit":true,"repOf":"ق-0134","ref":"سورة النساء: 173","quran":{"s":4,"from":173,"to":173,"text":"فَأَمَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَيُوَفِّيهِمْ أُجُورَهُمْ وَيَزِيدُهُمْ مِنْ فَضْلِهِ وَأَمَّا الَّذِينَ اسْتَنْكَفُوا وَاسْتَكْبَرُوا فَيُعَذِّبُهُمْ عَذَابًا أَلِيمًا وَلَا يَجِدُونَ لَهُمْ مِنْ دُونِ اللَّهِ وَلِيًّا وَلَا نَصِيرًا (173)","hl":[[0,255,1]]}},{"id":"ق-0365","fp":"e754aa753f6d","stateId":415,"easy":"الإبصار بالبصائر ← نفعه لنفسه","cause":"الإبصار بالبصائر","result":"نفعه لنفسه","explicit":true,"ref":"سورة الأنعام: 104","srcLabel":"القرآن الكريم","quran":{"s":6,"from":104,"to":104,"text":"قَدْ جَاءَكُمْ بَصَائِرُ مِنْ رَبِّكُمْ فَمَنْ أَبْصَرَ فَلِنَفْسِهِ وَمَنْ عَمِيَ فَعَلَيْهَا وَمَا أَنَا عَلَيْكُمْ بِحَفِيظٍ (104)","hl":[[40,68,1]]}},{"id":"ق-0543","fp":"7a231a9e0c33","stateId":415,"easy":"الإيمان ← قَدَم صدق عند ربهم","cause":"الإيمان","result":"قَدَم صدق عند ربهم","explicit":true,"otherNeedIds":[47],"ref":"سورة يونس: 2","srcLabel":"القرآن الكريم","quran":{"s":10,"from":2,"to":2,"text":"أَكَانَ لِلنَّاسِ عَجَبًا أَنْ أَوْحَيْنَا إِلَى رَجُلٍ مِنْهُمْ أَنْ أَنْذِرِ النَّاسَ وَبَشِّرِ الَّذِينَ آمَنُوا أَنَّ لَهُمْ قَدَمَ صِدْقٍ عِنْدَ رَبِّهِمْ قَالَ الْكَافِرُونَ إِنَّ هَذَا لَسَاحِرٌ مُبِينٌ (2)","hl":[[88,159,1]]}},{"id":"ق-0544","fp":"14d21d392bd1","stateId":415,"easy":"الإيمان والعمل الصالح ← الجزاء بالقسط","cause":"الإيمان والعمل الصالح","result":"الجزاء بالقسط","explicit":true,"ref":"سورة يونس: 4","srcLabel":"القرآن الكريم","quran":{"s":10,"from":4,"to":4,"text":"إِلَيْهِ مَرْجِعُكُمْ جَمِيعًا وَعْدَ اللَّهِ حَقًّا إِنَّهُ يَبْدَأُ الْخَلْقَ ثُمَّ يُعِيدُهُ لِيَجْزِيَ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ بِالْقِسْطِ وَالَّذِينَ كَفَرُوا لَهُمْ شَرَابٌ مِنْ حَمِيمٍ وَعَذَابٌ أَلِيمٌ بِمَا كَانُوا يَكْفُرُونَ (4)","hl":[[96,161,1]]}},{"id":"ق-0573","fp":"903a6a87141e","stateId":415,"easy":"الاهتداء ← نفعه لنفسه","cause":"الاهتداء","result":"نفعه لنفسه","explicit":true,"similar":["ق-0698","ق-0910","ق-1090"],"ref":"سورة يونس: 108","srcLabel":"القرآن الكريم","quran":{"s":10,"from":108,"to":108,"text":"قُلْ يَا أَيُّهَا النَّاسُ قَدْ جَاءَكُمُ الْحَقُّ مِنْ رَبِّكُمْ فَمَنِ اهْتَدَى فَإِنَّمَا يَهْتَدِي لِنَفْسِهِ وَمَنْ ضَلَّ فَإِنَّمَا يَضِلُّ عَلَيْهَا وَمَا أَنَا عَلَيْكُمْ بِوَكِيلٍ (108)","hl":[[66,113,1]]}},{"id":"ق-0698","fp":"8f291ad340d1","stateId":415,"easy":"الاهتداء ← نفعه لنفسه","cause":"الاهتداء","result":"نفعه لنفسه","explicit":true,"repOf":"ق-0573","ref":"سورة الإسراء: 15","quran":{"s":17,"from":15,"to":15,"text":"مَنِ اهْتَدَى فَإِنَّمَا يَهْتَدِي لِنَفْسِهِ وَمَنْ ضَلَّ فَإِنَّمَا يَضِلُّ عَلَيْهَا وَلَا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَى وَمَا كُنَّا مُعَذِّبِينَ حَتَّى نَبْعَثَ رَسُولًا (15)","hl":[[0,45,1]]}},{"id":"ق-0702","fp":"690d33890e05","stateId":415,"easy":"إرادة الآخرة والسعي لها مع الإيمان ← سعي مشكور","cause":"إرادة الآخرة والسعي لها مع الإيمان","result":"سعي مشكور","explicit":true,"otherNeedIds":[51],"ref":"سورة الإسراء: 19","srcLabel":"القرآن الكريم","quran":{"s":17,"from":19,"to":19,"text":"وَمَنْ أَرَادَ الْآخِرَةَ وَسَعَى لَهَا سَعْيَهَا وَهُوَ مُؤْمِنٌ فَأُولَئِكَ كَانَ سَعْيُهُمْ مَشْكُورًا (19)","hl":[[0,105,1]]}},{"id":"ق-0724","fp":"15ac8876f974","stateId":415,"easy":"الإيمان والعمل الصالح ← أجر حسن ماكثين فيه أبداً","cause":"الإيمان والعمل الصالح","result":"أجر حسن ماكثين فيه أبداً","explicit":t