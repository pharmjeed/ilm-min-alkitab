{"schema":1,"kind":"sunan-chunk","version":"sunan-3f5fd6b9930a","needId":45,"stateIds":[415,416,417,418,419,420,421,422,423,424,425,426,427,428,429,430,431,432,433,434,435,436,437,438],"items":[{"id":"س-03484","fp":"4c16c849f3fa","stateId":415,"easy":"إذا عملت حسنة وأنت مؤمن ← تُثاب عليها في الدنيا وتُجزى بها في الآخرة","cause":"المؤْمِنَ حسَنةً","result":"يُثابُ عليها الرِّزقَ في الدُّنيا، ويُجْزى بها في الآخِرةِ","explicit":true,"star":true,"otherNeedIds":[1],"ref":"تخريج المسند لشعيب 14018","srcLabel":"مسلم","text":["إنَّ اللهَ لا يَظلِمُ ",["المؤْمِنَ حسَنةً",1],"، ",["يُثابُ عليها الرِّزقَ في الدُّنيا، ويُجْزى بها في الآخِرةِ",2],"، قال: وأمَّا الكافرُ فيُطْعَمُ بحسناتِه في الدُّنيا، حتى إذا أَفْضى إلى الآخِرةِ لم يكُنْ له حسنةٌ يُعْطى بها خَيرًا."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (2808)، وأحمد (14018) واللفظ له","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"zH7QbqZC","merged":3,"otherRefs":["تخريج المسند لشعيب 12264 (صحيح)","صحيح الجامع 1853 (صحيح)"]},{"id":"س-08362","fp":"d0fd7fe304c6","stateId":415,"easy":"إذا فعلت الخير قبل إسلامك ثم أسلمت ← أسلمت على ما أسلفت من خير","cause":"كُنتُ أفعَلُها في الجاهِليَّةِ","result":"أسلَمتَ على ما أسلَفتَ لك مِنَ الخَيرِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح مسلم 123","srcLabel":"البخاري","text":["قُلتُ: يا رَسولَ اللهِ، أشياء ",["كُنتُ أفعَلُها في الجاهِليَّةِ",1],"، قال هِشامٌ: يَعني أتَبَرَّرُ بها، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["أسلَمتَ على ما أسلَفتَ لك مِنَ الخَيرِ",2],"، قُلتُ: فواللهِ، لا أدَعُ شيئًا صَنَعتُه في الجاهِليَّةِ إلَّا فعَلتُ في الإسلامِ مِثلَه. وفي روايةٍ: أنَّ حَكيمَ بنَ حِزامٍ أعتَقَ في الجاهِليَّةِ مِئةَ رَقَبةٍ، وحَمَلَ على مِئةِ بَعيرٍ، ثُمَّ أعتَقَ في الإسلامِ مِئةَ رَقَبةٍ وحَمَلَ على مِئةِ بَعيرٍ، ثُمَّ أتى النَّبيَّ صلَّى اللهُ عليه وسلَّم..."],"grade":"صحيح","narrator":"حكيم بن حزام","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1436)، وأحمد (15318)، وابن حبان (329) بنحوه دون قوله:\" لا أدع شيئا .....\".","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"NLfmDhWF","merged":9,"otherRefs":["المحلى 9/208 (صحيح)","المستدرك على الصحيحين 6177 (صحيح)","صحيح البخاري 1436 (صحيح)","تخريج المسند لشعيب 15575 (صحيح)","صحيح مسلم 123 (صحيح)","صحيح البخاري 5992 (صحيح)","صحيح البخاري 2538 (صحيح)"]},{"id":"ق-0013","fp":"734a43692867","stateId":415,"easy":"الوفاء بعهد الله ← وفاء الله بعهده لعبده","cause":"الوفاء بعهد الله","result":"وفاء الله بعهده لعبده","explicit":true,"ref":"سورة البقرة: 40","srcLabel":"القرآن الكريم","quran":{"s":2,"from":40,"to":40,"text":"يَا بَنِي إِسْرَائِيلَ اذْكُرُوا نِعْمَتِيَ الَّتِي أَنْعَمْتُ عَلَيْكُمْ وَأَوْفُوا بِعَهْدِي أُوفِ بِعَهْدِكُمْ وَإِيَّايَ فَارْهَبُونِ (40)","hl":[[0,137,1]]}},{"id":"ق-0019","fp":"c609123a60b0","stateId":415,"easy":"الإيمان بالله واليوم الآخر والعمل الصالح ← الأجر عند الله ولا خوف ولا حزن","cause":"الإيمان بالله واليوم الآخر والعمل الصالح","result":"الأجر عند الله ولا خوف ولا حزن","explicit":true,"otherNeedIds":[6],"ref":"سورة البقرة: 62","srcLabel":"القرآن الكريم","quran":{"s":2,"from":62,"to":62,"text":"إِنَّ الَّذِينَ آمَنُوا وَالَّذِينَ هَادُوا وَالنَّصَارَى وَالصَّابِئِينَ مَنْ آمَنَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَعَمِلَ صَالِحًا فَلَهُمْ أَجْرُهُمْ عِنْدَ رَبِّهِمْ وَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ (62)","hl":[[0,217,1]]}},{"id":"ق-0037","fp":"f2ff9460f3b3","stateId":415,"easy":"إسلام الوجه لله مع الإحسان ← الأجر عند الله ولا خوف ولا حزن","cause":"إسلام الوجه لله مع الإحسان","result":"الأجر عند الله ولا خوف ولا حزن","explicit":true,"otherNeedIds":[6],"ref":"سورة البقرة: 112","srcLabel":"القرآن الكريم","quran":{"s":2,"from":112,"to":112,"text":"بَلَى مَنْ أَسْلَمَ وَجْهَهُ لِلَّهِ وَهُوَ مُحْسِنٌ فَلَهُ أَجْرُهُ عِنْدَ رَبِّهِ وَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ (112)","hl":[[6,130,1]]}},{"id":"ق-0115","fp":"8bc4cc3ef170","stateId":415,"easy":"الإيمان والعمل الصالح وإقامة الصلاة وإيتا