{"schema":1,"kind":"sunan-chunk","version":"sunan-cb5af5731a1c","needId":9,"stateIds":[50,51,52,53,54,55,56,57],"items":[{"id":"س-06028","fp":"72b68e7aae73","stateId":50,"easy":"إذا مات لك ثلاثة من الولد ← لا تدخل النار إلا تحلة القسم","cause":"مَن قَدَّم ثَلاثةً مِنَ الوَلدِ","result":"لمْ يَلِجِ النَّارَ إلَّا تَحِلَّةَ القَسَمِ","explicit":true,"star":true,"similar":["س-02846","س-05683","س-04220","س-01440","س-06034"],"otherNeedIds":[66],"ref":"تخريج كتاب السنة 862","srcLabel":"متفق عليه","text":[["مَن قَدَّم ثَلاثةً مِنَ الوَلدِ",1]," ",["لمْ يَلِجِ النَّارَ إلَّا تَحِلَّةَ القَسَمِ",2],"، وَقالَ مَعمَرٌ: لَم تَمسَّه النَّارُ، وَقالَ مالكٌ: فتَمسَّه النَّارُ إلَّا تَحلَّةَ القَسَمِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (1251)، ومسلم (2632)، والترمذي (1060)، والنسائي (1875)، وابن ماجه (1603)، وأحمد (7265) بنحوه، وابن أبي عاصم في ((السنة)) (862) واللفظ له","bab":"رقائق وزهد › فضل الصبر","dorar":"QX87YEyp","merged":2,"otherRefs":["تخريج المسند لشعيب 10210 (صحيح)"]},{"id":"س-02846","fp":"423178b66ffc","stateId":50,"easy":"إذا مات لك ثلاثة من الولد ← يحجبونك من النار","cause":"مَن قدَّمَ ثَلاثةً من ولَدِه","result":"حجَبوه منَ النَّارِ","explicit":true,"repOf":"س-06028","otherNeedIds":[66],"ref":"تخريج المسند لشعيب 11106","text":["\"",["مَن قدَّمَ ثَلاثةً من ولَدِه ",1],["حجَبوه منَ النَّارِ\"",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه البخاري (101)، ومسلم (2633)، والنسائي في ((السنن الكبرى)) (5896) بنحوه، وأحمد (11106) واللفظ له","bab":"إيمان › الوعد","dorar":"6tckWvwb"},{"id":"س-05683","fp":"9c54eb60406b","stateId":50,"easy":"إذا مات لك ثلاثة من الولد ← لا تمسك النار إلا تحلة القسم","cause":"لا يَموتُ لأحَدٍ مِنَ المُسلِمينَ ثَلاثةٌ مِنَ الولَدِ","result":"فتَمَسَّه النَّارُ إلَّا تَحِلَّةَ القَسَمِ","explicit":true,"repOf":"س-06028","otherNeedIds":[66],"ref":"صحيح مسلم 2632","text":[["لا يَموتُ لأحَدٍ مِنَ المُسلِمينَ ثَلاثةٌ مِنَ الولَدِ",1]," ",["فتَمَسَّه النَّارُ إلَّا تَحِلَّةَ القَسَمِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6656) باختلاف يسير","bab":"رقائق وزهد › الصبر على البلاء","dorar":"TsFb8kjI"},{"id":"س-07558","fp":"655e73fbf80d","stateId":50,"easy":"إذا صبرت على المصيبة ← يبارك الله لك (من قصة أبي طلحة)","cause":"فبِتُّما عَروسَينِ","result":"بارَكَ اللهُ لكُما في ليلتِكُما","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"star":true,"otherNeedIds":[1],"ref":"تخريج المسند لشعيب 12865","srcLabel":"متفق عليه","text":["تَزَوَّجَ أبو طَلْحةَ أُمَّ سُلَيْمٍ وهي أُمُّ أنَسٍ، والبَراءِ، قال: فوَلَدَتْ له بُنَيًّا. قال: فكان يُحِبُّه حُبًّا شَديدًا. قال: فمَرِضَ الغُلامُ مَرَضًا شديدًا، فكان أبو طَلْحةَ يَقومُ صَلاةَ الغَداةِ يَتَوَضَّأُ، ويَأتي النَّبيَّ صلَّى اللهُ عليه وسلَّمَ فيُصَلِّي معه، ويكونُ معه إلى قَريبٍ مِن نِصفِ النَّهارِ، فيَجيءُ فيَقيلُ ويَأكُلُ، فإذا صَلَّى الظُّهرَ تَهيَّأَ وذَهَبَ، فلم يَجئْ إلى صَلاةِ العَتَمةِ. قال: فراحَ عَشيَّةً، ومات الصَّبيُّ. قال: وجاءَ أبو طَلْحةَ، قال: فسَجَّتْ عليه ثَوبًا، وتَرَكَتْه. قال: فقال لها أبو طَلْحةَ: يا أُمَّ سُلَيْمٍ، كيف باتَ بُنَيَّ الليلةَ؟ قالت: يا أبا طَلْحةَ، ما كان ابنُكَ منذُ اشتَكى أسْكَنَ منه الليلةَ، قال: ثُم جاءَتْه بالطعامِ، فأكَلَ وطابَت نَفسُه. قال: فقام إلى فِراشِه، فوَضَعَ رَأسَه، قالتْ: وقُمتُ أنا، فمَسِستُ شيئًا مِن طِيبٍ، ثُم جِئتُ حتى دَخَلتُ معه الفِراشَ، فما هو إلَّا أنْ وَجَدَ ريحَ الطِّيبِ كان منه ما يكون مِن الرَّجُلِ إلى أهلِه. قال: ثُم أصبَحَ أبو طَلْحةَ يَتهيَّأُ كما كان يَتهيَّأُ كلَّ يومٍ، قال: فقالت له: يا أبا طَلْحةَ، أرأيتَ لو أنَّ رَجُلًا استَودَعَكَ وَديعةً، فاستَمتَعْتَ بها، ثُم طَلَبَها، فأخَذَها منكَ تَجزَعُ مِن ذلك؟ قال: لا. قلتُ: فإنَّ ابنَكَ قد مات. قال أنَسٌ: فجَزِعَ عليه جَزَعًا شديدًا، وحدَّثَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ بما كان مِن أمرِهِ في الطَّعامِ والطِّيبِ، وما كان منه إليها. قال: فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: هِيهِ ",["فبِتُّما عَروسَينِ",1]," وهو إلى جَنبِكُما؟ قال: نَعَمْ يا رسولَ اللهِ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["بارَكَ اللهُ لكُما في ليلتِكُما",2],". قال: فحَمَلَتْ أُمُّ سُلَيمٍ تلك الليلةَ، قال: فتَلِدُ غُلامًا، قال: فحينَ أصبَحْنا، قال لي أبو طَلْحةَ: احْمِلْه في خِرْقةٍ حتى تأتيَ به رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، واحْمِلْ معكَ تَمرَ عَجْوةٍ. قال: فحَمَلتُه في خِرْقةٍ. قال: ولم يُحَنَّكْ، ولم يَذُقْ طعامًا ولا شيئًا، قال: فقلتُ: يا رسولَ اللهِ، وَلَدَتْ أُمُّ سُلَيمٍ، قال: اللهُ أكبرُ ما وَلَدَتْ؟ قلتُ: غُلامًا، قال: الحمدُ للهِ، فقال: هاتِهِ إليَّ، فدَفَعتُه إليه، فحَنَّكَه رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، ثُم قال له: معكَ تَمرُ عَجْوةٍ؟ قلتُ: نَعَمْ، فأخرَجْتُ تَمرًا، فأخَذَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ تَمرةً وألْقاها في فيه، فما زالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يَلوكُها حتى اخْتَلَطَتْ بِريقِهِ، ثُم دَفَعَ الصَّبيَّ. فما هو إلَّا أنْ وَجَدَ الصبيُّ حلاوةَ التَّمرِ جعَلَ يَمُصُّ حلاوةَ التَّمرِ وريقَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ. فكان أولُ ما تفتَّحَتْ أمعاءُ ذلك الصبيِّ على ريقِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ. فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: حُبُّ الأنصارِ التَّمرَ، فسُمِّيَ عبدَ اللهِ بنَ أبي طَلْحةَ، قال: فخرَجَ منه رَجُلٌ كثيرٌ، قال: واستُشْهِدَ عبدُ اللهِ بِفارِسَ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1301)، ومسلم (2144)، وأبو داود (4951) بنحوه، وأحمد (12865) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › دعاء النبي لبعض الناس","dorar":"67UEuVVz","merged":5,"otherRefs":["معجم الشيوخ 1/138 (صحيح)","تخريج سير أعلام النبلاء 2/311 (صحيح)","تخريج صحيح ابن حبان 7187 (صحيح)","تخريج المسند لشعيب 12028 (صحيح)"]},{"id":"س-04220","fp":"a24006894f03","stateId":50,"easy":"إذا مات لك ثلاثة من الولد ← لا تمسك النار إلا تحلة القسم","cause":"لا يَموتُ لمُسلِمٍ ثَلاثةٌ مِنَ الولَدِ، فيَلِجَ النَّارَ","result":"إلَّا تَحِلَّةَ القَسَمِ","explicit":true,"repOf":"س-06028","otherNeedIds":[66],"ref":"صحيح البخاري 1251","text":[["لا يَموتُ لمُسلِمٍ ثَلاثةٌ مِنَ الولَدِ، فيَلِجَ النَّارَ،",1]," ",["إلَّا تَحِلَّةَ القَسَمِ",2],"؛ قال أبو عبدِ اللهِ: {وإنْ مِنكُم إلَّا وارِدُها} [مريم: 71]."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2632) باختلاف يسير دون قول أبي عبدالله سفيان الثوري","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"PvcHP7tX"},{"id":"س-04272","fp":"861809ad8706","stateId":50,"easy":"إذا مات لك صغار فصبرت ← يتلقّونك في الجنة (دعاميص الجنة)","cause":"قد ماتَ ليَ ابنانِ","result":"صِغارُهم دَعاميصُ الجَنَّةِ، يَتَلَقَّى أحَدُهم أباه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[67],"ref":"صحيح مسلم 2635","srcLabel":"متفق عليه","text":["قُلتُ لأبي هُرَيرةَ: إنَّه ",["قد ماتَ ليَ ابنانِ",1],"، فما أنتَ مُحَدِّثي عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم بحَديثٍ تُطَيِّبُ به أنفُسَنا عن مَوتانا؟ قال: قال: نَعَم، ",["صِغارُهم دَعاميصُ الجَنَّةِ، يَتَلَقَّى أحَدُهم أباه -",2],"أو قال: أبَويه- فيَأخُذُ بثَوبِه -أو قال: بيَدِه- كما آخُذُ أنا بصَنِفةِ ثَوبِكَ هذا، فلا يَتَناهى -أو قال: فلا يَنتَهي- حتَّى يُدخِلَه اللهُ وأباه الجَنَّةَ. وفي رِوايةٍ: فهل سَمِعتَ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم شيئًا تُطَيِّبُ به أنفُسَنا عن مَوتانا؟ قال: نَعَم."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"Q5bMVPjC","merged":2,"otherRefs":["صحيح الجامع 3764 (صحيح)"]},{"id":"س-06040","fp":"066d219a077a","stateId":50,"easy":"إذا صبرت على موت ولدك واحتسبت ← يخلفك الله ذرية مباركة (من قصة أم سليم)","cause":"قالت: قد هَدَأت نَفسُه، وأرجو أن يَكونَ قدِ استَراحَ","result":"فرَأيتُ لهما تِسعةَ أولادٍ كُلُّهم قد قَرَأ القُرآنَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[38],"ref":"صحيح البخاري 1301","srcLabel":"متفق عليه","text":["اشتَكى ابنٌ لأبي طَلحةَ، قال: فماتَ، وأبو طَلحةَ خارِجٌ، فلَمَّا رَأتِ امرَأتُه أنَّه قد ماتَ هَيَّأت شيئًا، ونَحَّتْه في جانِبِ البَيتِ، فلَمَّا جاءَ أبو طَلحةَ قال: كيفَ الغُلامُ؟ ",["قالت: قد هَدَأت نَفسُه، وأرجو أن يَكونَ قدِ استَراحَ",1],"، وظَنَّ أبو طَلحةَ أنَّها صادِقةٌ، قال: فباتَ، فلَمَّا أصبَحَ اغتَسَلَ، فلَمَّا أرادَ أن يَخرُجَ أعلَمَتْه أنَّه قد ماتَ، فصَلَّى مع النَّبيِّ صلَّى اللهُ عليه وسلَّم، ثُمَّ أخبَرَ النَّبيَّ صلَّى اللهُ عليه وسلَّم بما كان منهما، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: لَعَلَّ اللهَ أن يُبارِكَ لَكُما في لَيلَتِكُما، قال سُفيانُ: فقال رَجُلٌ مِنَ الأنصارِ: ",["فرَأيتُ لهما تِسعةَ أولادٍ كُلُّهم قد قَرَأ القُرآنَ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1301)، ومسلم (2144)","bab":"رقائق وزهد › فضل الصبر","dorar":"ZoIT99a5"},{"id":"س-06042","fp":"b24426967aaa","stateId":50,"easy":"إذا صبرت على فقد ولدك ← يعوّضك الله ولداً (من قصة أم سليم)","cause":"لصبرِها على ولدِها","result":"لقد قذَف اللهُ تبارك وتعالى في رحِمِها ذكَرًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[38],"ref":"مجمع الزوائد 9/264","srcLabel":"متفق عليه","text":["جاءت أمُّ سُلَيمٍ إلى أبي أنسٍ فقالت جئْتُ اليومَ بما تكرَهُ فقال لا تزالينَ تجيئينَ بما أكرَهُ مِن عندِ هذا الأعرابيِّ قالت كان أعرابيًّا اصطفاه اللهُ واختاره وجعَلَه نبيًّا قال ما الَّذي جئْتِ به قال حُرِّمَتِ الخمرُ قال هذا فراقُ بيني وبينِكِ فمات مُشرِكًا وجاء أبو طلحةَ إلى أمِّ سُلَيمٍ قالت لم أكُنْ أتزوَّجُك وأنت مُشرِكٌ قال لا واللهِ ما هذا دهرُكِ قالت فما دهري قال دهرُكِ في الصَّفراءِ والبيضاءِ قالت فإنِّي أُشْهِدُك وأُشْهِدُ نبيَّ اللهِ صلَّى اللهُ عليه وسلَّم أنَّك إنْ أسلمْتَ فقد رضيتُ بالإسلامِ منك قال فمَن لي بهذا قالت يا أنسُ قُمْ فانطلِقْ مع عمِّك فقام فوضَع يدَه على عاتقي فانطلَقْنا حتَّى إذا كنَّا قريبًا مِن نبيِّ اللهِ صلَّى اللهُ عليه وسلَّم فسمِع كلامَنا فقال هذا أبو طلحةَ بينَ عينيه عِزَّةُ الإسلامِ فسلَّم على نبيِّ اللهِ صلَّى اللهُ عليه وسلَّم فقال أشهَدُ أن لا إلهَ إلَّا اللهُ وأنَّ محمَّدًا عبدُه ورسولُه فزوَّجَه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم على الإسلامِ فولَدَتْ له غُلامًا ثمَّ إنَّ الغلام درَج وأُعْجِبَ به أبوه فقبَضه اللهُ تبارك وتعالى فجاء أبو طلحةَ فقال ما فعَل ابني يا أمَّ سُلَيمٍ قالت خيرَ ما كان فقالت ألا تتغدَّى قد أخَّرْتَ غَداءَك اليومَ قالت فقدَّمْتُ إليه غَداءَه فقلْتُ يا أبا طلحةَ عاريَةٌ استعارَها قومٌ وكانت العاريَةُ عندَهم ما قضى اللهُ وإنَّ أهلَ العاريَةِ أرسَلوا إلى عاريَتِهم فقبَضوها ألَهُم أن يجْزَعوا قال لا قالت فإنَّ ابنَك قد فارَقَ الدُّنيا قال فأين هو قالت ها هو ذا في المَخْدَعِ فدخَل فكشَف عنه واسترجَع فذهَب إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فحدَّثَه بقولِ أمِّ سُلَيمٍ فقال والَّذي بعَثني بالحقِّ ",["لقد قذَف اللهُ تبارك وتعالى في رحِمِها ذكَرًا",2]," ",["لصبرِها على ولدِها",1]," قال فوضَعَتْه فقال نبيُّ اللهِ صلَّى اللهُ عليه وسلَّم اذهَبْ يا أنسُ إلى أمِّكَ فقُلْ لها إذا قَطَعْتِ سِرارَ ابنِكِ فلا تُذيقيه شيئًا حتَّى تُرسِلي به إليَّ قال فوضَعْتُه على ذِراعي حتَّى أتيتُ به رسولَ اللهِ صلَّى اللهُ عليه وسلَّم فوضَعْتُه بينَ يدَيه فقال ائتني بثلاثِ تَمْراتٍ عجوةً قال فجئتُ بهنَّ فقذَف نَواهنَّ ثمَّ قذَفه في فيه فلاكَه ثمَّ فتَح فا الغلامِ فجعَله في فيه فجعَل يتلمَّظُ فقال أنصاريٌّ يُحِبُّ التَّمرَ فقال اذهَبْ إلى أمِّك فقُلْ بارَك اللهُ لكِ فيه وجعَله بَرًّا تقيًّا"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"رجاله رجال الصحيح غير أحمد بن منصور الرمادي وهو ثقة","takhrij":"أخرجه البزار (7310) واللفظ له، وأصل الحديث في البخاري (5470)، ومسلم (2144) بمعناه.","bab":"رقائق وزهد › فضل الصبر","dorar":"zvAUiFgZ"},{"id":"س-02727","fp":"8c24b3236f0a","stateId":50,"easy":"إذا مات ولدك فحمدت الله واسترجعت ← يُبنى لك بيت في الجنة يسمى «بيت الحمد»","cause":"استرجَع وحمِدك","result":"ابنوا له بيتًا في الجنَّةِ وسمُّوه بيتَ الحمدِ","explicit":true,"similar":["س-08179"],"otherNeedIds":[67],"ref":"صحيح ابن حبان 2948","srcLabel":"الترمذي","text":["إذا مات ولدُ العبدِ المؤمنِ قال اللهُ للملائكةِ: قبَضْتُم ولَد عبدي ؟ قالوا: نَعم قال: قبَضْتُم ثمرةَ فؤادِه ؟ قالوا: نَعم قال: فما قال ؟ قالوا: ",["استرجَع وحمِدك",1]," قال: ",["ابنوا له بيتًا في الجنَّةِ وسمُّوه بيتَ الحمدِ",2]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الترمذي (1021)، والطيالسي (510)، والبيهقي في ((الآداب)) (756) باختلاف يسير","bab":"إيمان › الملائكة","dorar":"xUM3veg8","merged":2,"otherRefs":["نتائج الأفكار 3/285 (حسن)"]},{"id":"س-01440","fp":"6483d6ea6f95","stateId":50,"easy":"إذا مات لك ثلاثة من الولد صغاراً ← يكونون لك ستراً من النار","cause":"وأيُّما رَجُلٍ مُسلِمٍ قَدَّمَ للهِ عزَّ وجلَّ مِن صُلبِه ثلاثةً لم يَبلُغوا الحِنثَ، أو امرأةٍ","result":"فهم له سُترةٌ مِن النَّارِ","explicit":true,"repOf":"س-06028","otherNeedIds":[66],"ref":"تخريج المسند لشعيب 19439","text":["أيُّما رَجُلٍ رَمى بسَهمٍ في سَبيلِ اللهِ عزَّ وجلَّ، فبَلَغَ، مُخطِئًا أو مُصيبًا، فله مِن الأجْرِ كرَقبةٍ يُعتِقُها مِن وَلدِ إسماعيلَ، وأيُّما رَجُلٍ شاب شَيبةً في سَبيلِ اللهِ، فهي له نورٌ، وأيُّما رَجُلٍ مُسلِمٍ أعتَقَ رَجُلًا مُسلِمًا، فكلُّ عُضوٍ مِن المُعتَقِ بعُضوٍ مِن المُعتِقِ فِداءٌ له مِن النَّارِ، وأيُّما امرأةٍ مُسلِمةٍ أعتَقَتِ امرأةً مُسلِمةً، فكلُّ عُضوٍ مِن المُعتَقةِ بعُضوٍ مِن المُعتِقةِ فِداءٌ لها مِن النَّارِ، ",["وأيُّما رَجُلٍ مُسلِمٍ قَدَّمَ للهِ عزَّ وجلَّ مِن صُلبِه ثلاثةً لم يَبلُغوا الحِنثَ، أو امرأةٍ",1],"، ",["فهم له سُترةٌ مِن النَّارِ،",2]," وأيُّما رَجُلٍ قام إلى وُضوءٍ يُريدُ الصَّلاةَ، فأحصى الوُضوءَ إلى أماكنِه، سَلِمَ مِن كلِّ ذَنبٍ أو خَطيئةٍ له، فإنْ قام إلى الصَّلاةِ، رَفَعَه اللهُ عزَّ وجلَّ بها دَرجةً، وإنْ قَعَدَ، قَعَدَ سالمًا. فقال شُرَحبيلُ بنُ السِّمطِ: آنتَ سَمِعتَ هذا الحديثَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يا ابنَ عَبَسةَ؟ قال: نَعَمْ، والذي لا إلهَ إلَّا هو، لو أنِّي لم أسمَعْ هذا الحديثَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ غيرَ مَرَّةٍ أو مَرَّتَينِ أو ثلاثٍ أو أربعٍ أو خَمسٍ أو ستٍّ أو سَبعٍ -فانتَهى عندَ سَبعٍ-، ما حَلَفتُ -يَعني ما بالَيتُ- ألَّا أُحدِّثَ به أحَدًا مِن النَّاسِ، ولكنِّي واللهِ ما أدري عَددَ ما سَمِعتُه مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح دون قوله: \"من ولد إسماعيل\"","takhrij":"أخرجه النسائي (3142) مختصراً، وأحمد (19439) واللفظ له","bab":"وضوء › فضل الوضوء","dorar":"LicciAss"},{"id":"س-05664","fp":"ec233af68453","stateId":50,"easy":"إذا مات لك ثلاثة من الولد ← يتلقّونك من أبواب الجنة الثمانية","cause":"مَن يموتُ –وفي لفظٍ: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ما من رَجلٍ مُسلِمٍ يُتوفَّى- له ثلاثةٌ منَ الوَلَدِ، لم يَبلُغوا الحِنْثَ","result":"إلَّا تَلقَّوْه من أبوابِ الجَنَّةِ الثمانيةِ، من أيِّها شاءَ دخَلَ","explicit":true,"otherNeedIds":[67],"ref":"تخريج المسند لشعيب 17639","srcLabel":"ابن ماجه","text":["أنَّه سمِعَ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن يموتُ –وفي لفظٍ: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ما من رَجلٍ مُسلِمٍ يُتوفَّى- له ثلاثةٌ منَ الوَلَدِ، لم يَبلُغوا الحِنْثَ، ",1],["إلَّا تَلقَّوْه من أبوابِ الجَنَّةِ الثمانيةِ، من أيِّها شاءَ دخَلَ",2],"."],"grade":"صحيح","narrator":"عتبة بن عبد السلمي","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (1604)، وأحمد (17639) واللفظ له","bab":"رقائق وزهد › الصبر على البلاء","dorar":"2kNpLXnq"},{"id":"س-05667","fp":"efc85bfa930a","stateId":50,"easy":"إذا مات حبيبك فصبرت واحتسبت ← لا يرضى الله لك ثواباً دون الجنة","cause":"إذا ذَهَبَ بصَفِيِّه مِن أهْلِ الأرْضِ، فصَبَرَ، واحْتَسَبَ، وقالَ ما أُمِرَ به","result":"إنَّ اللهَ لا يَرْضى لِعَبْدِه المُؤمِنِ إذا ذَهَبَ بصَفِيِّه مِن أهْلِ الأرْضِ، فصَبَرَ، واحْتَسَبَ، وقالَ ما أُمِرَ به- بثَوابٍ دونَ الجَنَّةِ","explicit":true,"otherNeedIds":[67],"ref":"الأحكام الوسطى 2/154","srcLabel":"الأحكام الوسطى","text":[["إنَّ اللهَ لا يَرْضى لِعَبْدِه المُؤمِنِ إذا ذَهَبَ بصَفِيِّه مِن أهْلِ الأرْضِ، فصَبَرَ، واحْتَسَبَ، وقالَ ما أُمِرَ به- بثَوابٍ دونَ الجَنَّةِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","bab":"رقائق وزهد › الصبر على البلاء","dorar":"2vsBpeiH"},{"id":"س-08179","fp":"611d266c287e","stateId":50,"easy":"إذا مات ولدك فحمدت الله واسترجعت ← يُبنى لك بيت في الجنة يسمى بيت الحمد","cause":"إذا مات ولدُ العبدِ قال اللهُ تعالَى لملائكتِه : قبضتم ولدَ عبدي ؟ فيقولون : نعم ، فيقولُ : قبضتم ثمرةَ فؤادِه ؟ فيقولون : نعم ، فيقولُ : ماذا قال عبدي ؟ فيقولون : حمِدك واسترجع","result":"ابْنُوا لعبدي بيتًا في الجنَّةِ ، وسمُّوه بيتَ الحمدِ","explicit":true,"repOf":"س-02727","otherNeedIds":[67],"ref":"الترغيب والترهيب 4/257","text":[["إذا مات ولدُ العبدِ قال اللهُ تعالَى لملائكتِه : قبضتم ولدَ عبدي ؟ فيقولون : نعم ، فيقولُ : قبضتم ثمرةَ فؤادِه ؟ فيقولون : نعم ، فيقولُ : ماذا قال عبدي ؟ فيقولون : حمِدك واسترجع",1]," ، فيقولُ اللهُ تعالَى : ",["ابْنُوا لعبدي بيتًا في الجنَّةِ ، وسمُّوه بيتَ الحمدِ",2]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (1021)","bab":"ملائكة › أعمال الملائكة","dorar":"u0LDPPcr"},{"id":"س-06034","fp":"7638045a1144","stateId":50,"easy":"إذا مات لك ثلاثة من الولد صغاراً ← لا تَرِد النار إلا عابر سبيل","cause":"مَنْ ماتَ لَهُ ثَلَاثَةٌ مِنَ الْوَلَدِ لَمْ يَبْلُغُوا الْحِنْثَ","result":"لم يَرِدِ النَّارَ إلَّا عابِرُ سَبيلٍ","explicit":true,"repOf":"س-06028","otherNeedIds":[66],"ref":"مجمع الزوائد 10/3","text":[["مَنْ ماتَ لَهُ ثَلَاثَةٌ مِنَ الْوَلَدِ لَمْ يَبْلُغُوا الْحِنْثَ ",1],["لم يَرِدِ النَّارَ إلَّا عابِرُ سَبيلٍ",2]," يعْنِي الجَوَازَ عَلَى الصِّرَاطِ"],"grade":"حسن","narrator":"عبدالرحمن بن بشير الأنصاري","muhaddith":"رجاله موثقون خلا شيخ الطبراني أحمد بن مسعود المقدسي ولم أجد من ترجمه","takhrij":"أخرجه أبو نعيم في ((معرفة الصحابة)) (4647) بلفظه.","bab":"رقائق وزهد › فضل الصبر","dorar":"xHarxSPk"},{"id":"س-02666","fp":"628540c4d5a2","stateId":50,"easy":"إذا مات لك عزيز فاحتسبته ← فلك أجره (من أثر ابن مسعود)","cause":"يَمُوتَ فَأَحْتَسِبُهُ","result":"أحَبُّ إِلَيَّ مِنْ أَنْ أَموتُ فيَحْتَسِبُنِي","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[49],"ref":"مجمع الزوائد 23/3","srcLabel":"الطبراني","text":["لما ماتَ عُتْبَةُ بنُ مسعودٍ بَكَى عبْدُ اللهِ بنُ مسعودٍ فقالوا لَهُ تَبْكِي فقالَ نَعَمْ أَخِي فِي النسَبِ وصَاحِبِي مَعَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وأَحَبُّ الناسِ إِلَيَّ إِلَّا مَا كَانَ مِنْ عُمَرَ بنِ الخطابِ ومَا أُحِبُّ معَ ذَلِكَ أَنِّي كُنْتُ مِتُّ قَبْلَهُ لَأَنْ ",["يَمُوتَ فَأَحْتَسِبُهُ",1]," ",["أحَبُّ إِلَيَّ مِنْ أَنْ أَموتُ فيَحْتَسِبُنِي",2]],"grade":"حسن","narrator":"عبدالله بن عتبة","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني في ((الأوسط)) (5873)، وأبونعيم في ((معرفةالصحابة)) (5347) واللفظ لهما مختصرا.","bab":"إيمان › الاحتساب والنية","dorar":"AWx6x8pD"},{"id":"س-04178","fp":"f33087a382a5","stateId":50,"easy":"إذا مات لك ولد فصبرت ← تجده على باب من أبواب الجنة","cause":"إنَّ الغلامَ مات","result":"أفما يَسُرُّكَ إذا أَدخلَكَ اللهُ الجنةَ أن تجدَه على بابٍ من أبوابِها فيفتحُه لك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[67],"ref":"السلسلة الصحيحة 6/156","srcLabel":"ابن سعد","text":["عن معاويةَ بنِ قُرَّةَ عن عمِّه أنه كان يأتي النبيَّ بابنِه فيُجلِسُه بين يدَيه ، فقال له النبيُّ صلَّى اللهُ عليهِ وسلَّمَ : تُحبُّه ؟ قال : نعم حُبًّا شديدًا ، قال : ثم ",["إنَّ الغلامَ مات",1]," ، فقال له النبيُّ صلَّى اللهُ عليهِ وسلَّمَ : كأنك حزِنتَ عليه ؟ قال : أجل يا رسولَ اللهِ ، قال : ",["أفما يَسُرُّكَ إذا أَدخلَكَ اللهُ الجنةَ أن تجدَه على بابٍ من أبوابِها فيفتحُه لك",2]," ؟ يعني ابنَه الصغيرَ"],"grade":"حسن","narrator":"عم معاوية بن قرة","muhaddith":"إسناد رجاله كلهم ثقات رجال الشيخين","takhrij":"أخرجه ابن سعد في ((الطبقات)) (5/ 152)، وابن أبي خيثمة في ((التاريخ))-السفر الثاني (1561)، وأبو نعيم الأصبهاني في ((معرفة الصحابة)) (7118) جميعهم باختلاف يسير.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"hlnAoCvd"},{"id":"س-00267","fp":"47b7bc194725","stateId":50,"easy":"إذا مات لك ولد فصبرت ← يكون لك فرطاً، والمحروم من لم يقدّم منهم شيئاً","cause":"الذي له وَلَدٌ فماتَ ولم يُقدِّمْ منهم شَيئًا","result":"الرَّقوبُ كُلُّ الرَّقوبِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[57],"ref":"تخريج المسند لشعيب 23115","srcLabel":"أحمد","text":["عن رَجُلٍ شَهِدَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَخطُبُ فقال: تَدْرونَ ما الرَّقوبُ؟ قالوا: الذي لا وَلَدَ له، فقال: ",["الرَّقوبُ كُلُّ الرَّقوبِ",2],"، الرَّقوبُ كُلُّ الرَّقوبِ، الرَّقوبُ كُلُّ الرَّقوبِ: ",["الذي له وَلَدٌ فماتَ ولم يُقدِّمْ منهم شَيئًا",1],"، قال: تَدْرونَ ما الصُّعلوكُ؟ قالوا: الذي ليس له مالٌ، قال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: الصُّعلوكُ كُلُّ الصُّعلوكِ، الصُّعلوكُ كُلُّ الصُّعلوكِ: الذي له مالَ فماتَ ولم يُقدِّمْ منه شَيئًا. قال: ثم قال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ما الصُّرَعةُ؟ قال: قالوا: الصَّريعُ، قال: فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: الصُّرَعةُ كُلُّ الصُّرَعةِ، الصُّرَعةُ كُلُّ الصُّرَعةِ: الرَّجُلُ يَغضَبُ فيَشتَدُّ غَضَبُه، ويَحمَرُّ وَجْهُه، ويَقشَعِرُّ شَعَرُه، فيَصرَعُ غَضَبَه."],"grade":"صحيح","narrator":"رجال من الصحابة","muhaddith":"صحيح لغيره دون قصة الصعلوك","takhrij":"أخرجه أحمد (23115)","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"w4wwUFDS","merged":2,"otherRefs":["صحيح الترغيب 886 (صحيح)"]},{"id":"س-04167","fp":"9c4bfb50b971","stateId":50,"easy":"إذا قدّمت من ولدك (مات لك ولد فصبرت) ← فلست بالرقوب المحروم","cause":"الرَّجُلُ الَّذي لَمْ يُقَدِّمْ مِن ولَدِهِ شيئًا","result":"ليسَ ذاكَ بالرَّقُوبِ، ولَكِنَّهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[57],"ref":"صحيح الجامع 3556","srcLabel":"صحيح الجامع","text":["[حديث أبي هريرة: الرَّقوبُ الذي لا فرَطَ له]            [وحديث عبدالله بن مسعود: ما تَعُدُّونَ الرَّقُوبَ فِيكُمْ؟ قالَ: قُلْنا: الَّذي لا يُولَدُ له، قالَ: ",["ليسَ ذاكَ بالرَّقُوبِ، ولَكِنَّهُ",2]," ",["الرَّجُلُ الَّذي لَمْ يُقَدِّمْ مِن ولَدِهِ شيئًا",1],"، قالَ: فَما تَعُدُّونَ الصُّرَعَةَ فِيكُمْ؟ قالَ قُلْنا: الَّذي لا يَصْرَعُهُ الرِّجالُ، قالَ: ليْسَ بذلكَ، ولَكِنَّهُ الَّذي يَمْلِكُ نَفْسَهُ عِنْدَ الغَضَبِ.]"],"grade":"صحيح","narrator":"أبو هريرة وابن مسعود","muhaddith":"صحيح","bab":"جنائز وموت › موت الأولاد وفضل احتسابهم","dorar":"ZzHuNzfm"},{"id":"س-04169","fp":"cee7cdccd5de","stateId":50,"easy":"إذا مات لك ولد فصبرت ← فلست الرقوب، بل الرقوب من لم يمت له ولد","cause":"التي لا يموتُ لها ولدٌ","result":"الرَّقوبُ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[57],"ref":"صحيح الجامع 3555","srcLabel":"ابن أبي الدنيا","text":[["الرَّقوبُ",2]," ",["التي لا يموتُ لها ولدٌ",1]],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي الدنيا كما في ((كنز العمال)) (6557)","bab":"جنائز وموت › موت الأولاد وفضل احتسابهم","dorar":"gYE6AoaV"},{"id":"س-08433","fp":"d43df02cf742","stateId":51,"easy":"إذا صبرت على الحمى ← تكون لك طهوراً","cause":"إنْ شِئتُم دَعوتُ اللهَ فكَشَفَها عَنكُم، وإنْ شِئتُم","result":"كانت لَكُم طَهورًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[11],"ref":"المستدرك على الصحيحين 1298","srcLabel":"مسلم","text":["أتَتِ الحُمَّى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فاستَأذَنَتْ عليه، فقالَ: مَن أنتِ؟ قالتْ: أنا أُمُّ مِلدَمٍ فقالَ: أتُهدَينَ إلى أهلِ قُباءَ؟ قالتْ: نعم. قالَ: فأتَتهُمْ؛ فحُمُّوا، ولَقُوا منها شِدَّةً، فاشتَكَوا إليه، قالوا: يا رَسولَ اللهِ، ما لَقِينا منَ الحُمَّى! قالَ: ",["إنْ شِئتُم دَعوتُ اللهَ فكَشَفَها عَنكُم، وإنْ شِئتُم",1]," ",["كانت لَكُم طَهورًا",2],". قالوا: لا، بل تَكونُ لنا طَهورًا."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح على شرط مسلم","bab":"مناقب وفضائل › فضائل جمع من الصحابة والتابعين","dorar":"rF73ovyo","merged":2,"otherRefs":["تخريج صحيح ابن حبان 2935 (صحيح)"]},{"id":"س-08215","fp":"2f1dd2a6f465","stateId":51,"easy":"إذا أُصبت ببلاء في جسدك ← يأمر الله الملائكة بكتابة عملك","cause":"ما أحَدٌ مِنَ النَّاسِ يُصابُ بِبلاءٍ في جسدِهِ","result":"إلَّا أمَرَ اللَّهُ عزَّ وجلَّ الملائكةَ الَّذينَ يحفظونَهُ","explicit":true,"star":true,"otherNeedIds":[45],"ref":"تخريج سنن أبي داود 5/9","srcLabel":"البخاري","text":[["ما أحَدٌ مِنَ النَّاسِ يُصابُ بِبلاءٍ في جسدِهِ",1]," ",["إلَّا أمَرَ اللَّهُ عزَّ وجلَّ الملائكةَ الَّذينَ يحفظونَهُ",2],"، فقال: اكتُبوا لِعَبْدي في كلِّ يَومٍ ولَيلةٍ ما كانَ يعمَلُ مِن خَيرٍ، ما كانَ في وَثاقِي."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6482)، وهناد بن السري في ((الزهد))، والدارمي (2812) واللفظ لهم جميعا، والبخاري في ((الأدب المفرد)) (500) مختصرا.","bab":"ملائكة › أعمال الملائكة","dorar":"RSfHs6zk"},{"id":"س-08214","fp":"9b88129f2de0","stateId":51,"easy":"إذا ابتُليت ببلاء في جسدك ← يُكتب لك مثل ما كنت تعمل صحيحاً","cause":"ما أحدٌ مِن المُسلمينَ يُبتَلى ببَلاءٍ في جسدِه","result":"إلَّا أمَرَ اللهُ عزَّ وجلَّ الحفَظةَ الذين يحفَظونه: اكتُبوا لِعبدي مِثلَ ما كان يعمَلُ وهو صحيحٌ، ما دام مَحبوسًا في وَثاقي","explicit":true,"star":true,"similar":["س-03261"],"otherNeedIds":[45],"ref":"تخريج المسند لشعيب 6825","srcLabel":"مسلم","text":[["ما أحدٌ مِن المُسلمينَ يُبتَلى ببَلاءٍ في جسدِه؛",1]," ",["إلَّا أمَرَ اللهُ عزَّ وجلَّ الحفَظةَ الذين يحفَظونه: اكتُبوا لِعبدي مِثلَ ما كان يعمَلُ وهو صحيحٌ، ما دام مَحبوسًا في وَثاقي",2],"، قال عبدُ اللهِ [بنُ أحمدَ]: قال أبي وقال إسحاقُ: اكتُبوا لِعبدي في كلِّ يومٍ ولَيلةٍ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (6825) واللفظ له، والدارمي (2770)، وابن أبي شيبة (10909)","bab":"ملائكة › أعمال الملائكة","dorar":"CiNJQMGo"},{"id":"س-07939","fp":"3d4410fe79e7","stateId":51,"easy":"إذا عدت مريضاً فقل «لا بأس، طهور إن شاء الله» ← (المرض طهور)","cause":"دَخَلَ على أعرابيٍّ يَعودُه","result":"لا بَأسَ، طَهورٌ إن شاءَ اللهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"apply":{"k":"say","t":"«لا بأس، طهور إن شاء الله»"},"otherNeedIds":[11],"ref":"صحيح البخاري 3616","srcLabel":"متفق عليه","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم ",["دَخَلَ على أعرابيٍّ يَعودُه",1],"، قال: وكان النَّبيُّ صلَّى اللهُ عليه وسلَّم إذا دَخَلَ على مَريضٍ يَعودُه، قال: ",["لا بَأسَ، طَهورٌ إن شاءَ اللهُ",2],"، فقال له: لا بَأسَ، طَهورٌ إن شاءَ اللهُ، قال: قُلتَ: طَهورٌ؟ كَلَّا، بَل هي حُمَّى تَفورُ -أو تَثورُ- على شَيخٍ كَبيرٍ، تُزيرُه القُبورَ، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: فنَعَم إذَنْ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"من أفراد البخاري على مسلم","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"pw1BlWJs","merged":3,"otherRefs":["صحيح البخاري 5662 (صحيح)","صحيح البخاري 7470 (صحيح)"]},{"id":"س-04555","fp":"15fc037d7002","stateId":51,"easy":"إذا أصابتك الحمى ← فهي حظك من النار","cause":"فما أَصابَ المُؤْمِنَ مِنْها","result":"كان حَظَّهُ مِنَ النارِ","explicit":true,"star":true,"similar":["س-07929"],"otherNeedIds":[66],"ref":"السلسلة الصحيحة 1822","srcLabel":"أحمد","text":["الحُمَّى كِيرٌ من جهنمَ ، ",["فما أَصابَ المُؤْمِنَ مِنْها",1]," ",["كان حَظَّهُ مِنَ النارِ",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرجه أحمد (22328 )، و الروياني في ((مسنده)) (1269 )، ووالطبراني في ((المعجم الكبير )) (8/ 93) (7468 )،","bab":"جهنم › شدة نار جهنم وبعد قعرها","dorar":"EfnqJd2D","merged":5,"otherRefs":["السلسلة الصحيحة 1821 (صحيح)","صحيح الترغيب 3447 (صحيح)","صحيح الجامع 3190 (صحيح)","صحيح الترغيب 3445 (صحيح)"]},{"id":"س-07631","fp":"a43afd4cb15f","stateId":51,"easy":"إذا مِتّ بالطاعون ← فهو شهادة ورحمة لك","cause":"فالطَّاعونُ شَهادةٌ لأُمَّتِي","result":"شَهادةٌ لأُمَّتِي ، و رَحمةٌ لَهم ، و رِجسٌ على الكافرينَ","explicit":true,"star":true,"otherNeedIds":[62],"ref":"الجامع الصغير 76","srcLabel":"أحمد","text":["أتاني جبريلُ بالحُمَّى و الطاعونِ ، فأَمسكْتُ الحُمَّى في المدينةِ ، و أرسلْتُ الطاعونَ إلى الشَّامِ ، ",["فالطَّاعونُ ",1],["شَهادةٌ لأُمَّتِي ، و رَحمةٌ لَهم ، و رِجسٌ على الكافرينَ",2]],"grade":"صحيح","narrator":"أبو عسيب مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه ابن سعد (7/ 61) بلفظه، وأحمد (20767)، والطبراني (974)(22/ 391) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › نزول الوحي عليه صلى الله عليه وسلم","dorar":"v3N5nHIF","merged":2,"otherRefs":["سبل الهدى والرشاد 10/5 (حسن)"]},{"id":"س-07908","fp":"8acad416ab70","stateId":51,"easy":"إذا أصابك المرض ← فهو كفارة لك ولو كان شوكة","cause":"هذه الأمراضَ التي تُصيبُ أبدانَنا","result":"الكفَّاراتُ، قال أُبَيُّ بنُ كعبٍ: وإنْ قَلَّ ذلك يا رسولَ اللهِ؟ قال: وإنْ شَوكةً فما وراءَها","explicit":true,"otherNeedIds":[11],"ref":"تخريج مشكل الآثار 2220","srcLabel":"أحمد","text":["أنَّ رَجُلًا منَ المُسلِمينَ، ثم ذَكَرَ مِثلَه، غيرَ أنَّه قال: ولا صَلاةٍ مَكتوبةٍ في جَماعةٍ، ولم يَقُلْ: حتى صار كالجَريدةِ المُبراةِ، [يعني حديثَ: أنَّ رَجُلًا قال: يا رسولَ اللهِ، أرأيتَ ",["هذه الأمراضَ التي تُصيبُ أبدانَنا",1],"، ما لنا بها؟ قال: ",["الكفَّاراتُ، قال أُبَيُّ بنُ كعبٍ: وإنْ قَلَّ ذلك يا رسولَ اللهِ؟ قال: وإنْ شَوكةً فما وراءَها",2],"، قال: فدَعا أُبَيُّ بنُ كعبٍ على نفْسِه ألَّا تزالَ حُمَّى مُصارِعَةً لجَسَدِه ما أُبقِيَ في الدُّنيا، لا تحولُ بينَه وبينَ حَجٍّ وعُمْرةٍ، ولا جهادٍ في سبيلِ اللهِ، ولا شُهودِ صَلاةٍ في مسجِدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، قال: فما ذاقَه ذائِقٌ بعدَ ذلك إلَّا وَجَدَ عليه صالِبًا مِثلَ النارِ؛ حتى بَرَتْ جَسَدَه؛ وحتى تَرَكتْه مِثلَ الجَريدةِ المُبراةِ.]"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (2220) بلفظه، وأحمد (11193)، والحاكم (7854) باختلاف يسير.","bab":"مريض › فضل المرض والنوائب","dorar":"3ov83IXx","merged":2,"otherRefs":["المستدرك على الصحيحين 8066 (صحيح)"]},{"id":"س-07918","fp":"0be3cc1ba878","stateId":51,"easy":"إذا أصابتك الحمى ← فهي كفارة وطهور","cause":"وهو مَحمومٌ","result":"كَفَّارةٌ وطَهورٌ","explicit":true,"otherNeedIds":[11],"ref":"تخريج المسند لشعيب 13616","srcLabel":"أحمد","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم دخَلَ على أعرابيٍّ يَعودُه ",["وهو مَحمومٌ",1],"، فقال: ",["كَفَّارةٌ وطَهورٌ",2],"، فقال الأعرابيُّ: بلْ حُمَّى تَفور، على شَيخٍ كبير، تُزيرُه القُبور. فقام رسولُ اللهِ صلَّى اللهُ عليه وسلَّم وتَرَكَه."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (13616) واللفظ له، وأبو يعلى (4232)، والطبراني في ((الدعاء)) (2023)","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"oMSqQdE2","merged":2,"otherRefs":["الفتوحات الربانية 4/68 (حسن)"]},{"id":"س-07929","fp":"937aecef0723","stateId":51,"easy":"إذا أصابتك الحمى ← فهي حظك من النار","cause":"هيَ ناري أسلِّطُها على عَبدي المؤمنِ","result":"لتَكونَ حظَّهُ منَ النَّارِ","explicit":true,"repOf":"س-04555","otherNeedIds":[66],"ref":"مصباح الزجاجة 4/61","text":["عنِ النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ، أنَّهُ عادَ مريضًا، ومعَهُ أبو هُرَيْرةَ من وَعكٍ كانَ بِهِ، فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: أبشِر فإنَّ اللَّهَ يقولُ: ",["هيَ ناري أسلِّطُها على عَبدي المؤمنِ",1]," في الدُّنيا، ",["لتَكونَ حظَّهُ منَ النَّارِ",2],"، في الآخِرةِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح رجاله موثقون","takhrij":"أخرجه ابن ماجه (3470)، وأحمد (9676)، والطبراني في ((مسند الشاميين)) (561) بلفظه.","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"BAynY0Up","merged":2,"otherRefs":["تاريخ دمشق 66/297 (صحيح)"]},{"id":"س-03261","fp":"73f63b3a3ecf","stateId":51,"easy":"إذا ابتُليت ببلاء في جسدك ← يُكتب لك أجر ما كنت تعمله صالحاً وأنت صحيح","cause":"إذا ابتلى اللهُ عزَّ وجلَّ العبدَ المسلمَ ببلاءٍ في جسَدِه","result":"قال اللهُ عزَّ وجلَّ للملَكُ : اكتُبْ لهُ صالِحَ عملِه الَّذي كان يَعملُ ، وإن شفاهُ غَسَلَهُ وَطَهَّرَهُ ، وإنْ قبضَه غَفرَ لهُ ورحِمَه","explicit":true,"repOf":"س-08214","otherNeedIds":[45,11],"ref":"صحيح الترغيب 3422","text":[["إذا ابتلى اللهُ عزَّ وجلَّ العبدَ المسلمَ ببلاءٍ في جسَدِه ، ",1],["قال اللهُ عزَّ وجلَّ للملَكُ : اكتُبْ لهُ صالِحَ عملِه الَّذي كان يَعملُ ، وإن شفاهُ غَسَلَهُ وَطَهَّرَهُ ، وإنْ قبضَه غَفرَ لهُ ورحِمَه ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"حسن صحيح","takhrij":"أخرجه أحمد (13526) واللفظ له، وأبو يعلى (4235)","bab":"استغفار › أسباب المغفرة","dorar":"ErVJaSe7"},{"id":"س-05661","fp":"42a1c1fb4629","stateId":51,"easy":"إذا مرضت فلم تشكُ إلى عوّادك ← يبدلك الله لحماً خيراً من لحمك ودماً خيراً من دمك","cause":"فإنْ لم يشْكُني إلى عُوَّادِهِ","result":"أبدلتُهُ لحمًا خيرًا من لحمهِ ودمًا أطيبَ من دمهِ","explicit":true,"similar":["س-06046"],"otherNeedIds":[35],"ref":"اللآلئ المصنوعة 2/396","srcLabel":"الحاكم","text":["قال اللهُ عزَّ وجلَّ : أَبتلي عبدي بالبلاءِ ",["فإنْ لم يشْكُني إلى عُوَّادِهِ",1]," ",["أبدلتُهُ لحمًا خيرًا من لحمهِ ودمًا أطيبَ من دمهِ",2]," ، فإنْ أطلقتُه من أَسْري أمرتُه فاستأنفَ العملَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح وله طرق أخرى","takhrij":"أخرجه ابن أبي الدنيا في ((المرض والكفارات)) (215)، والحاكم (1290)، والبيهقي (6786)","bab":"رقائق وزهد › الصبر على البلاء","dorar":"yY7OHeru"},{"id":"س-06046","fp":"b808a666d7f0","stateId":51,"easy":"إذا ابتُليت فلم تشكُ إلى عوّادك ← يطلقك الله من البلاء ويبدلك لحماً ودماً خيراً","cause":"إذا ابْتَلَيْتُ عَبدي المُؤْمِنَ فلمْ يَشْكُنِي إلى عُوَّادِه","result":"أَطْلَقْتُهُ من إسارِي ، ثُمَّ أَبْدَلْتُهُ لَحْمًا خيرًا من لَحْمِهِ ، ودَمًا خيرًا من دَمِهِ ، ثُمَّ يسْتَأْنَفُ العَمَلَ","explicit":true,"repOf":"س-05661","otherNeedIds":[35],"ref":"صحيح الترغيب 3424","text":["قال اللهُ تباركَ وتعالى : ",["إذا ابْتَلَيْتُ عَبدي المُؤْمِنَ فلمْ يَشْكُنِي إلى عُوَّادِه ؛ ",1],["أَطْلَقْتُهُ من إسارِي ، ثُمَّ أَبْدَلْتُهُ لَحْمًا خيرًا من لَحْمِهِ ، ودَمًا خيرًا من دَمِهِ ، ثُمَّ يسْتَأْنَفُ العَمَلَ ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي الدنيا في ((المرض والكفارات)) (215)، والحاكم (1290)، والبيهقي (6786)","bab":"رقائق وزهد › فضل الصبر","dorar":"cFUA8Rcj"},{"id":"س-08108","fp":"26d82d4b1608","stateId":51,"easy":"إذا مرضت ← يُكتب لك مثل ما كنت تعمل حتى تشفى أو تُقبض","cause":"إذا مرض العبدُ","result":"قال اللهُ للكرام الكاتبِين : اكتُبوا لعبدي مثلَ الذي كان يعملُ ، حتى أَقبضَه أو أعافِيَه","explicit":true,"otherNeedIds":[45],"ref":"صحيح الجامع 800","srcLabel":"ابن أبي شيبة","text":[["إذا مرض العبدُ ",1],["قال اللهُ للكرام الكاتبِين : اكتُبوا لعبدي مثلَ الذي كان يعملُ ، حتى أَقبضَه أو أعافِيَه",2]],"grade":"صحيح","narrator":"عطاء بن يسار","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي شيبة في ((مصنفه)) (10812) واللفظ له .","bab":"ملائكة › أعمال الملائكة","dorar":"7OXjFG0J"},{"id":"س-03429","fp":"8ac50e8dcbf0","stateId":51,"easy":"إذا علمت ما لك من الأجر في المرض ← تحب أن تكون مريضاً حتى تلقى الله","cause":"عَجِبتُ للمُؤمِنِ وجَزَعه مِنَ السَّقَمِ","result":"ولَو يَعلَمُ ما له في السَّقَمِ أحَبَّ أن يَكونَ سقيمًا حتَّى يلقى اللهَ عَزَّ وجَلَّ","explicit":true,"otherNeedIds":[11],"ref":"فيض القدير 4/ 304","srcLabel":"فيض القدير","text":[["عَجِبتُ للمُؤمِنِ وجَزَعه مِنَ السَّقَمِ",1],"، ",["ولَو يَعلَمُ ما له في السَّقَمِ أحَبَّ أن يَكونَ سقيمًا حتَّى يلقى اللهَ عَزَّ وجَلَّ",2]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"رمز السيوطي لحسنه وليس كما قال","bab":"استغفار › أسباب المغفرة","dorar":"um551IUK"},{"id":"س-03554","fp":"7375da6bcfda","stateId":51,"easy":"إذا أصابتك الحمى ← يعطي الله كل عضو منك حظه من الأجر (من أثر أبي هريرة)","cause":"الحمَّى","result":"لأنَّها تدخلُ في كلِّ عضوٍ منِّي ، وإنَّ اللهَ عزَّ وجلَّ يُعطي كلَّ عضوٍ قِسطَهُ من الأجرِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[45],"ref":"صحيح الأدب المفرد 388","srcLabel":"البخاري (الأدب المفرد)","text":["عن أبي هريرةَ قال : ما مِن مرضٍ يصيبُني ، أحبُّ إليَّ من ",["الحمَّى",1]," ؛ ",["لأنَّها تدخلُ في كلِّ عضوٍ منِّي ، وإنَّ اللهَ عزَّ وجلَّ يُعطي كلَّ عضوٍ قِسطَهُ من الأجرِ",2]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"استغفار › مكفرات الذنوب","dorar":"wj1FBuyf"},{"id":"س-07598","fp":"182883363df7","stateId":51,"easy":"إذا حبسك المرض عن عملك ← يُكتب لك أجر عملك كاملاً","cause":"فوجَدناه قد حَبَستَه في حِبالِكَ","result":"اكتُبا لعَبدي عَمَلَه في يَومِه ولَيلَتِه، ولا تَنقُصا مِن عَمَلِه شَيئًا، عليَّ أجرُه ما حَبَستُه، وله أجرُ ما كان يعمَلُ","explicit":true,"otherNeedIds":[45],"ref":"فيض القدير 4/ 305","srcLabel":"فيض القدير","text":["رفع رسولُ اللهِ صلَّى اللهُ عليه وسلَّم رأسَه إلى السَّماءِ فضَحِك فسُئِل فقال: عَجِبتُ للمَلَكَينِ مِنَ المَلائِكةِ نَزَلا إلى الأرضِ يَلتَمِسانِ عَبدًا في مُصَلَّاه فلَم يَجِداه، ثُمَّ عرجا إلى ربِّهما فقالا: يا ربِّ كُنَّا نَكتُبُ لعَبدِكَ المُؤمِنِ في يَومِه ولَيلَتِه مِنَ العَمَلِ كَذا وكَذا ",["فوجَدناه قد حَبَستَه في حِبالِكَ",1],"، فلَم نَكتُبْ له شَيئًا، فقال اللهُ عَزَّ وجَلَّ: ",["اكتُبا لعَبدي عَمَلَه في يَومِه ولَيلَتِه، ولا تَنقُصا مِن عَمَلِه شَيئًا، عليَّ أجرُه ما حَبَستُه، وله أجرُ ما كان يعمَلُ",2]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"رمز السيوطي لحسنه وليس كما قال","bab":"فضائل النبي وصفته ودلائل النبوة › ضحك النبي صلى الله عليه وسلم وتبسمه","dorar":"ZvV2uTWv"},{"id":"س-08154","fp":"fe746914152d","stateId":51,"easy":"إذا مرضت فحمدت الله عند عوّادك ← إن مِتّ دخلت الجنة، وإن شُفيت أُبدلت لحماً خيراً","cause":"إذا مرض العبدُ بعث اللهُ إليه ملَكينِ فقال : انظُروا ما يقول لعُوَّادِه ؟ فإن هو إذا جاؤوه حمد اللهَ وأثنى عليه","result":"لعبدي عليَّ إن توفَّيتُه أن أُدخِلَه الجنَّةَ وإن أنا شَفيتُه أن أُبدِلَه لحمًا خيرًا من لحمِه ، ودمًا خيرًا من دمِه ، وأن أُكفِّرَ عنه سيِّئاتِه","explicit":true,"otherNeedIds":[67,11],"ref":"صحيح الترغيب 3431","srcLabel":"مالك","text":[["إذا مرض العبدُ بعث اللهُ إليه ملَكينِ فقال : انظُروا ما يقول لعُوَّادِه ؟ فإن هو إذا جاؤوه حمد اللهَ وأثنى عليه",1]," ، رَفعا ذلك إلى اللهِ ، وهو أعلمُ ، فيقول : ",["لعبدي عليَّ إن توفَّيتُه أن أُدخِلَه الجنَّةَ وإن أنا شَفيتُه أن أُبدِلَه لحمًا خيرًا من لحمِه ، ودمًا خيرًا من دمِه ، وأن أُكفِّرَ عنه سيِّئاتِه",2]," ."],"grade":"حسن","narrator":"عطاء بن يسار","muhaddith":"حسن لغيره","takhrij":"أخرجه مالك (2/940)، والبيهقي في ((شعب الإيمان)) (9941) باختلاف يسير","bab":"ملائكة › أعمال الملائكة","dorar":"xmC5MNjn"},{"id":"س-08206","fp":"6bdc41e0cf8d","stateId":51,"easy":"إذا ابتُليت في جسدك ← يأمر الله الحفظة أن يكتبوا لك عملك","cause":"ما من أحدٍ يُبتَلى في جسدِه","result":"إلا أمر اللهُ الحفظةَ","explicit":true,"otherNeedIds":[45],"ref":"الاستذكار 7/413","srcLabel":"أحمد","text":[["ما من أحدٍ يُبتَلى في جسدِه",1]," ",["إلا أمر اللهُ الحفظةَ ",2],"، فقال : اكتبوا لعبدي ما كان يعملُ وهو صحيحٌ ما كان مشدودًا في وِثاقي"],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"إسناده جيد","takhrij":"أخرجه أحمد (6825)، والدارمي (2770)، وابن عبدالبر في ((التمهيد)) (5/49) واللفظ له.","bab":"ملائكة › أعمال الملائكة","dorar":"BCzXDjUb"},{"id":"س-00621","fp":"ca57b045f026","stateId":51,"easy":"إذا أصابتك حمى أو وعك ← تذهب خطاياك كما يذهب خبث الحديد في النار","cause":"حينَ يُصِيبُهُ الوَعْكُ أَوِ الحُمَّى","result":"كَمَثَلِ حَدِيدَةٍ تَدْخُلُ النارَ ، فَيَذْهَبُ خَبَثُها ، و يَبْقَى طِيبُها","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"otherNeedIds":[11],"ref":"السلسلة الصحيحة 1714","srcLabel":"الحاكم","text":["إِنَّما مَثَلُ العبدِ المُؤْمِنِ ",["حينَ يُصِيبُهُ الوَعْكُ أَوِ الحُمَّى",1]," ",["كَمَثَلِ حَدِيدَةٍ تَدْخُلُ النارَ ، فَيَذْهَبُ خَبَثُها ، و يَبْقَى طِيبُها",2]],"grade":"صحيح","narrator":"عبدالرحمن بن أزهر","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرجه الفسوي في ((المعرفة والتاريخ)) (1/ 284)، والروياني في ((مسنده)) (1539)، والحاكم (1288)، والبيهقي في (6618) جميعا بلفظه .","bab":"آداب عامة › ضرب الأمثال","dorar":"GlN4NHAD"},{"id":"س-02732","fp":"243d906a4617","stateId":51,"easy":"إذا مرضت وأنت مؤمن ← يُختم لك على مثل عملك في صحتك حتى تبرأ أو تموت","cause":"فإذا مَرِضَ المؤْمِنُ","result":"اختِموا له على مِثلِ عَمَلِه حتى يَبرأَ أو يَموتَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[45],"ref":"تخريج المسند لشعيب 17316","srcLabel":"أحمد","text":["ليس مِن عمَلِ يَومٍ إلَّا وهو يُختَمُ عليه، ",["فإذا مَرِضَ المؤْمِنُ",1]," قالتِ المَلائكةُ: يا رَبَّنا، عبْدُك فُلانٌ قد حَبَسْتَه، فيقولُ الرَّبُّ عزَّ وجلَّ: ",["اختِموا له على مِثلِ عَمَلِه حتى يَبرأَ أو يَموتَ",2],"."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17316) واللفظ له، والطبراني (17/284) (782)، والحاكم (7855)","bab":"إيمان › الملائكة","dorar":"wlUrXDfM"},{"id":"س-07502","fp":"dec5a2994c9c","stateId":51,"easy":"إذا أصابك الطاعون (وصبرت) ← يكون لك شهادة وتزكية لعملك","cause":"داءٌ كالدُّمَّلِ","result":"يَستشهِدُ اللهُ به أنفُسَهم، ويُزكِّي به أعمالَهم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[47],"ref":"تخريج المسند لشعيب 22088","srcLabel":"أحمد","text":["ستُهاجِرونَ إلى الشَّامِ فيُفتَحُ لكم، ويَكونُ فيكم ",["داءٌ كالدُّمَّلِ",1]," أو كالحَرَّةِ يَأخُذُ بمَراقِّ الرَّجُلِ، ",["يَستشهِدُ اللهُ به أنفُسَهم، ويُزكِّي به أعمالَهم",2],"، اللَّهُمَّ إنْ كنتَ تَعلَمُ أنَّ مُعاذَ بنَ جَبلٍ سَمِعَه مِن رسولِ اللهِ صَلَّى اللهُ عليه وسلَّمَ فأعطِه هو وأهلَ بَيتِه الحَظَّ الأَوفرَ منه؛ فأصابَهم الطَّاعونُ فلمْ يَبْقَ منهم أحَدٌ، فطُعِنَ في إصبَعِه السَّبَّابةِ، فكان يقولُ: ما يَسُرُّني أنَّ لي بها حُمْرَ النَّعَمِ."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"المرفوع منه صحيح لغيره","takhrij":"أخرجه أحمد (22088) واللفظ له، والطبراني (20/113) (225)، وابن عساكر في ((تاريخ دمشق)) (58/443)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"OUZB7xCu"},{"id":"س-02659","fp":"e5f12ca4ffdd","stateId":52,"easy":"إذا أخذ الله عينيك في الدنيا ← فليس لك جزاء إلا الجنة","cause":"إذا أخَذْتُ كرِيمَتَي عبْدِي في الدُّنيا لم يَكُنْ له جَزاءٌ عِندِي","result":"إلا الجَنَّةَُ","explicit":true,"star":true,"otherNeedIds":[67],"ref":"صحيح الترغيب 3448","srcLabel":"البخاري","text":["يقولُ اللهُ عزَّ وجلَّ ",["إذا أخَذْتُ كرِيمَتَي عبْدِي في الدُّنيا لم يَكُنْ له جَزاءٌ عِندِي ",1],["إلا الجَنَّةَُ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5653) بنحوه، والترمذي (2400) واللفظ له","bab":"إيمان › الاحتساب والنية","dorar":"x6XRbp4f"},{"id":"س-05679","fp":"06309ce5ef8e","stateId":52,"easy":"إذا فقدت عينيك فصبرت ← يعوضك الله الجنة","cause":"إذا ابتليتُ عبدي","result":"بحبيبَتَيْه ( يريد بعينَيْه ) ثم صبر عوَّضتُه منهما الجنّةَ","explicit":true,"star":true,"otherNeedIds":[67],"ref":"صحيح الجامع 4302","srcLabel":"البخاري","text":["قال اللهُ تعالى : ",["إذا ابتليتُ عبدي ",1],["بحبيبَتَيْه ( يريد بعينَيْه ) ثم صبر عوَّضتُه منهما الجنّةَ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5653) باختلاف يسير.","bab":"رقائق وزهد › الصبر على البلاء","dorar":"Ta198mHc"},{"id":"س-02662","fp":"696ed8bd66fc","stateId":52,"easy":"إذا فقدت بصرك فصبرت واحتسبت عند الصدمة الأولى ← لا يرضى الله لك ثواباً دون الجنة","cause":"إذا أخذتُ كرِيمتيْكَ فصبَرْتَ واحتسبْتَ عند الصَّدْمَةِ الأُولَى","result":"لمْ أرْضَ لكَ ثوابًا دُونَ الجنةِ","explicit":true,"similar":["س-05675","س-02912","س-07041","س-07905"],"otherNeedIds":[67,66],"ref":"صحيح الجامع 8143","srcLabel":"ابن ماجه","text":["يقولُ اللهُ تعالَى : يا ابنَ آدمَ ! ",["إذا أخذتُ كرِيمتيْكَ فصبَرْتَ واحتسبْتَ عند الصَّدْمَةِ الأُولَى",1]," ",["لمْ أرْضَ لكَ ثوابًا دُونَ الجنةِ",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (1597) مختصراً، أحمد (22228) باختلاف يسير","bab":"إيمان › الاحتساب والنية","dorar":"6ve3dbDC","merged":8,"otherRefs":["تخريج المسند لشعيب 12595 (صحيح)","صحيح الموارد 582 (صحيح)","السلسلة الصحيحة 2010 (حسن)","صحيح الأدب المفرد 414 (صحيح)","تخريج المسند لشعيب 27063 (صحيح)","صحيح البخاري 5653 (صحيح)","الجامع الصغير 5412 (حسن)"]},{"id":"س-05675","fp":"00cac64e3f0a","stateId":52,"easy":"إذا فقدت بصرك فصبرت واحتسبت ← كان ثوابك الجنة","cause":"مَن أذهَبْتُ كريمتَيهِ، ثمَّ صبَرَ واحتسَبَ","result":"كان ثَوابُه الجَنَّةَ","explicit":true,"repOf":"س-02662","otherNeedIds":[67],"ref":"تخريج المسند لشعيب 14021","text":["قال ربُّكم عزَّ وجلَّ: ",["مَن أذهَبْتُ كريمتَيهِ، ثمَّ صبَرَ واحتسَبَ؛ ",1],["كان ثَوابُه الجَنَّةَ",2],"."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده قوي","takhrij":"أخرجه البخاري (5653) بمعناه، وأحمد (14021) واللفظ له","bab":"رقائق وزهد › الصبر على البلاء","dorar":"tUH4MM9U"},{"id":"س-02912","fp":"b8916a07fce3","stateId":52,"easy":"إذا فقدت بصرك فحمدت الله ← لا يرضى لك ثواباً دون الجنة","cause":"إذا سلبتُ من عبدي كريمتَيْه وهو بهما ضنينٌ","result":"لم أرْضَ له ثوابًا دون الجنَّةِ إذا هو حمِدني عليهما","explicit":true,"repOf":"س-02662","otherNeedIds":[67],"ref":"الترغيب والترهيب 4/236","text":["عن النَّبيِّ صلَّى اللهُ عليه وسلَّم عن ربِّه تبارك وتعالَى أنَّه قال : ",["إذا سلبتُ من عبدي كريمتَيْه وهو بهما ضنينٌ ",1],["لم أرْضَ له ثوابًا دون الجنَّةِ إذا هو حمِدني عليهما",2]],"grade":"صحيح","narrator":"العرباض بن سارية","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن حبان (2931)، والطبراني في ((مسند الشاميين)) (1848) واللفظ لهما، والبزار (4198)، والطبراني (634) (18/ 254)، وأبو نعيم في ((حلية الأولياء)) (6/ 103) باختلاف يسير.","bab":"إيمان › الوعد","dorar":"oBjA9NFa"},{"id":"س-07041","fp":"ca4cfbeac77f","stateId":52,"easy":"إذا فقدت بصرك ← يثيبك الله عليه الجنة","cause":"ومن سلَبتُ كريمتيهِ","result":"أثَبتُهُ عَليهما الجنَّةَ","explicit":true,"repOf":"س-02662","otherNeedIds":[67],"ref":"هداية الرواة 246","text":["إنَّ اللَّهَ - عزَّ وجلَّ - أوحى إليَّ أنَّهُ من سلَكَ مَسلَكًا في طلبِ العلمِ سَهَّلتُ لهُ طريقَ الجنَّةِ ؛ ",["ومن سلَبتُ كريمتيهِ",1]," ",["أثَبتُهُ عَليهما الجنَّةَ",2],". وفضلٌ في عِلمٍ خيرٌ مِن فضلٍ في عبادةٍ . ومِلاكُ الدِّينِ الورَعُ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (5751) واللفظ له، وأخرجه ابن حبان في ((المجروحين)) (2/204) باختلاف يسير، وابن عدي في ((الكامل في الضعفاء)) (6/160) مفرقاً باختلاف يسير","bab":"علم › الحث على طلب العلم","dorar":"MvDDsYZn"},{"id":"س-07904","fp":"6d84e5427738","stateId":52,"easy":"إذا فقدت بصرك فصبرت واحتسبت ← تلقى الله ولا ذنب عليك","cause":"لو كانتْ عَيناكَ لمَا بهما، ثُمَّ صَبَرتَ واحتسَبتَ","result":"للَقيتَ اللهَ عزَّ وجلَّ ولا ذَنبَ لك","explicit":true,"otherNeedIds":[11,67],"ref":"تخريج المسند لشعيب 19348","srcLabel":"أبو داود","text":["أصابَني رَمَدٌ فعادني النَّبيُّ صلَّى اللهُ عليه وسلَّمَ، قال: فلمَّا بَرَأتُ خَرَجتُ، قال: فقال لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: أرَأَيتَ لو كانتْ عَيناكَ لمَا بهما ما كنتَ صانعًا؟ قال: قُلتُ: لو كانتا عَينايَ لمَا بهما صَبَرتُ واحتسَبتُ، قال: ",["لو كانتْ عَيناكَ لمَا بهما، ثُمَّ صَبَرتَ واحتسَبتَ",1],"؛ ",["للَقيتَ اللهَ عزَّ وجلَّ ولا ذَنبَ لك",2],"، قال إسماعيلُ: ثُمَّ صَبَرتَ واحتسَبتَ؛ لأَوجَبَ اللهُ لك الجنَّةَ."],"grade":"حسن","narrator":"زيد بن أرقم","muhaddith":"إسناده حسن","takhrij":"أخرجه أبو داود (3102) مختصراً، وأحمد (19348) واللفظ له","bab":"مريض › فضل المرض والنوائب","dorar":"S7lDR9ob","merged":5,"otherRefs":["تخريج المسند لشعيب 12636 (حسن)","تخريج المسند لشعيب 12586 (حسن)","شرح البخاري لابن الملقن 27/283 (حسن)","تخريج سير أعلام النبلاء 3/167 (حسن)"]},{"id":"س-05669","fp":"0573d5e059cf","stateId":52,"easy":"إذا ابتُليت ببصرك فصبرت حتى تلقى الله ← تلقاه ولا حساب عليك","cause":"ومن ابتُلِيَ ببصرِهِ فصبرَ حتى يَلقى اللهَ","result":"لقِيَ اللهَ تعالى ولا حسابَ عليْهِ","explicit":true,"otherNeedIds":[65],"ref":"فتح الباري لابن حجر 10/121","srcLabel":"أبو داود","text":["ما ابتُليَ عبدٌ بعد ذهابِ دينِهِ بأشدَّ من ذهابِ بصرِهِ ، ",["ومن ابتُلِيَ ببصرِهِ فصبرَ حتى يَلقى اللهَ ",1],["لقِيَ اللهَ تعالى ولا حسابَ عليْهِ",2]],"grade":"حسن","narrator":"زيد بن أرقم","muhaddith":"إسناده جيد ، من حديث ابن عمر بلفظ (من أذهب الله بصره) فذكر نحوه","takhrij":"أخرجه البزار (4342) واللفظ له، وأبو داود (3102)، وأحمد (19348)، والحاكم (1265) جميعهم بمعناه.","bab":"رقائق وزهد › الصبر على البلاء","dorar":"hslFEYtw"},{"id":"س-07905","fp":"481834d1efb7","stateId":52,"easy":"إذا ابتُليت في بصرك فصبرت واحتسبت ← أوجب الله لك الجنة","cause":"ثُمَّ صَبَرتَ واحتسَبتَ","result":"لأَوجَبَ اللهُ لك الجنَّةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-02662","otherNeedIds":[67],"ref":"تخريج المسند لشعيب 19348","text":["أصابَني رَمَدٌ فعادني النَّبيُّ صلَّى اللهُ عليه وسلَّمَ، قال: فلمَّا بَرَأتُ خَرَجتُ، قال: فقال لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: أرَأَيتَ لو كانتْ عَيناكَ لمَا بهما ما كنتَ صانعًا؟ قال: قُلتُ: لو كانتا عَينايَ لمَا بهما صَبَرتُ واحتسَبتُ، قال: لو كانتْ عَيناكَ لمَا بهما، ثُمَّ صَبَرتَ واحتسَبتَ؛ للَقيتَ اللهَ عزَّ وجلَّ ولا ذَنبَ لك، قال إسماعيلُ: ",["ثُمَّ صَبَرتَ واحتسَبتَ",1],"؛ ",["لأَوجَبَ اللهُ لك الجنَّةَ",2],"."],"grade":"حسن","narrator":"زيد بن أرقم","muhaddith":"إسناده حسن","takhrij":"أخرجه أبو داود (3102) مختصراً، وأحمد (19348) واللفظ له","bab":"مريض › فضل المرض والنوائب","dorar":"S7lDR9ob","merged":2,"otherRefs":["الصحيح المسند 343 (حسن)"]},{"id":"س-06325","fp":"f2f9e701e267","stateId":53,"easy":"إذا سُرق منك شيء ← يُحسب من رزقك المقدّر لك","cause":"سرَق سارقٌ","result":"إلا حُسِب مِن رِزقِه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"إتحاف الخيرة المهرة 3/8","srcLabel":"أحمد","text":["ما كرُم عبدٌ على اللهِ , عزَّ وجلَّ , إلا ازداد البلاءُ عليه شدةً ، ولا أعطى عبدٌ صدقةَ مالِه فنقصَتْ مِن مالِه ، ولا أمسَكها فزادَتْ في مالِه ، ولا ",["سرَق سارقٌ",1]," ",["إلا حُسِب مِن رِزقِه",2]],"grade":"حسن","narrator":"كعب","muhaddith":"سنده رجاله ثقات","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (3141) بلفظه، وأحمد في ((الزهد)) (1921) مختصرا، والحارث بن أبي أسامة كما في ((بغية الباحث)) للهيثمي (287) باختلاف يسير.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"uf22Em9Z"},{"id":"س-01294","fp":"8d770e58584c","stateId":53,"easy":"إذا أصابتك مصيبة فقلت «إنا لله وإنا إليه راجعون، اللهم أجرني...» ← يخلف الله لك خيراً منها","cause":"ما مِن مُسلِمٍ تُصيبُه مُصيبةٌ، فيَقولُ ما أمَرَه اللهُ: {إنَّا للَّهِ وإنَّا إليه راجِعونَ} [البقرة: 156]، اللهمَّ أْجُرني في مُصيبَتي، وأخلِفْ لي خَيرًا مِنها","result":"إلَّا أخلَفَ اللهُ له خَيرًا مِنها","explicit":true,"star":true,"apply":{"k":"say","t":"«إنَّا للَّهِ وإنَّا إليه راجِعونَ} [البقرة: 156]، اللهمَّ أْجُرني في مُصيبَتي، وأخلِفْ لي خَيرًا مِنها، إلَّا أخلَفَ اللهُ له خَيرًا مِنها» · الوقت: عند المصيبة"},"similar":["س-01295"],"ref":"صحيح مسلم 918","srcLabel":"متفق عليه","text":[["ما مِن مُسلِمٍ تُصيبُه مُصيبةٌ، فيَقولُ ما أمَرَه اللهُ: {إنَّا للَّهِ وإنَّا إليه راجِعونَ} [البقرة: 156]، اللهمَّ أْجُرني في مُصيبَتي، وأخلِفْ لي خَيرًا مِنها، ",1],["إلَّا أخلَفَ اللهُ له خَيرًا مِنها",2],"، قالت: فلَمَّا ماتَ أبو سَلَمةَ قُلتُ: أيُّ المُسلِمينَ خَيرٌ مِن أبي سَلَمةَ؟ أوَّلُ بَيتٍ هاجَرَ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، ثُمَّ إنِّي قُلتُها، فأخلَفَ اللهُ لي رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، قالت: أرسَلَ إلَيَّ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم حاطِبَ بنَ أبي بَلتَعةَ يَخطُبُني له، فقُلتُ: إنَّ لي بنتًا، وأنا غَيورٌ، فقال: أمَّا ابنَتُها فنَدعو اللهَ أن يُغنيَها عَنها، وأدعو اللهَ أن يَذهَبَ بالغَيرةِ."],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"نكاح › الغيرة","dorar":"uH8y5Wtn","merged":2,"otherRefs":["صحيح مسلم 918 (صحيح)"]},{"id":"س-07609","fp":"fe0cbc69c2b7","stateId":53,"easy":"إذا أصابتك نكبة ولو شوكة ← تُحط عنك خطيئة وتُرفع درجة","cause":"لا يُصيبُ مُؤمِنًا نَكبةٌ مِن شَوكةٍ، فما فَوقَ ذلك","result":"إلَّا حُطَّتْ به عنه خَطيئةٌ، ورُفِعَ بها دَرَجةً","explicit":true,"star":true,"otherNeedIds":[11,47],"ref":"تخريج المسند لشعيب 25264","srcLabel":"متفق عليه","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ طرَقَه وَجَعٌ، فجعَلَ يَشتَكي ويَتقَلَّبُ على فِراشِهِ، فقالت عائِشةُ: لو صنَعَ هذا بَعضُنا لَوجَدتَ عليه. فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: إنَّ الصَّالِحينَ يُشدَّدُ عليهم، وإنَّه ",["لا يُصيبُ مُؤمِنًا نَكبةٌ مِن شَوكةٍ، فما فَوقَ ذلك",1],"، ",["إلَّا حُطَّتْ به عنه خَطيئةٌ، ورُفِعَ بها دَرَجةً",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (5640)، ومسلم (2572)، والترمذي (965)، والنسائي في ((السنن الكبرى)) (7487) بنحوه، وأحمد (25264) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › مرض النبي وموته","dorar":"GeFUyGGM","merged":2,"otherRefs":["صحيح الجامع 1660 (صحيح)"]},{"id":"س-05665","fp":"c0bfddd4af01","stateId":53,"easy":"إذا أصابتك مصيبة فاسترجعت ودعوت ← يأجرك الله ويخلف لك خيراً","cause":"ما من أحدٍ من المُسلمِينَ يُصابُ بمُصيبةٍ، فيقولُ: إنَّا للهِ، وإنَّا إليه راجِعونَ، اللَّهمَّ أْجُرْني في مُصيبَتي، واخلُفْ علَيَّ بخيرٍ منها","result":"إلَّا فُعِلَ به ذلك","explicit":true,"star":true,"apply":{"k":"time","t":"عند المصيبة"},"similar":["س-02885","س-02898"],"ref":"تخريج المسند لشعيب 26773","srcLabel":"مسلم","text":["بلَغَها أنَّ النَّبيَّ صلَّى اللهُ عليهِ وسلَّمَ قال: ",["ما من أحدٍ من المُسلمِينَ يُصابُ بمُصيبةٍ، فيقولُ: إنَّا للهِ، وإنَّا إليه راجِعونَ، اللَّهمَّ أْجُرْني في مُصيبَتي، واخلُفْ علَيَّ بخيرٍ منها،",1]," ",["إلَّا فُعِلَ به ذلك",2],". قالتْ: فقُلتُ هذا، فأَجَرَني اللهُ في مصيبَتِي، فمَن يَخلُفُ عليَّ مَكانَ أبي سلَمةَ؟ فلمَّا انقضَتْ عِدَّتُها، خطَبَها رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ."],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه مسلم (918)، وأحمد (26723) واللفظ له","bab":"رقائق وزهد › الصبر على البلاء","dorar":"HzpAPFCS"},{"id":"ق-0052","fp":"6478e1019737","stateId":53,"easy":"الصبر عند المصيبة وقول: إنا لله وإنا إليه راجعون ← صلوات من الله ورحمة وهداية","cause":"الصبر عند المصيبة وقول: إنا لله وإنا إليه راجعون","result":"صلوات من الله ورحمة وهداية","explicit":true,"star":true,"apply":{"k":"time","t":"عند المصيبة"},"otherNeedIds":[24,15],"ref":"سورة البقرة: 155–157","srcLabel":"القرآن الكريم","quran":{"s":2,"from":155,"to":157,"text":"وَلَنَبْلُوَنَّكُمْ بِشَيْءٍ مِنَ الْخَوْفِ وَالْجُوعِ وَنَقْصٍ مِنَ الْأَمْوَالِ وَالْأَنْفُسِ وَالثَّمَرَاتِ وَبَشِّرِ الصَّابِرِينَ (155) الَّذِينَ إِذَا أَصَابَتْهُمْ مُصِيبَةٌ قَالُوا إِنَّا لِلَّهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ (156) أُولَئِكَ عَلَيْهِمْ صَلَوَاتٌ مِنْ رَبِّهِمْ وَرَحْمَةٌ وَأُولَئِكَ هُمُ الْمُهْتَدُونَ (157)","hl":[[111,327,1]]}},{"id":"ق-1344","fp":"113706582ca5","stateId":53,"easy":"الإيمان بالله عند المصيبة ← هداية القلب","cause":"الإيمان بالله عند المصيبة","result":"هداية القلب","explicit":true,"apply":{"k":"time","t":"عند المصيبة"},"otherNeedIds":[5,15],"ref":"سورة التغابن: 11","srcLabel":"القرآن الكريم","quran":{"s":64,"from":11,"to":11,"text":"مَا أَصَابَ مِنْ مُصِيبَةٍ إِلَّا بِإِذْنِ اللَّهِ وَمَنْ يُؤْمِنْ بِاللَّهِ يَهْدِ قَلْبَهُ وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ (11)","hl":[[0,92,1]]}},{"id":"س-01295","fp":"4bce1dc6ffad","stateId":53,"easy":"إذا أصابتك مصيبة فقل «إنا لله وإنا إليه راجعون، اللهم أجرني...» ← يخلفك الله خيراً منها (من قصة أم سلمة)","cause":"إذا أصابَ أحدَكُم مُصيبةٌ، فلْيقُلْ: إنَّا للهِ وإنَّا إليهِ راجعونَ، عندَكَ أحتَسِبُ مصيبتي فأْجُرْني فيها، وأبدِلْني ما هو خيرٌ منها","result":"فبعَث إليها رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«إنَّا للهِ وإنَّا إليهِ راجعونَ، عندَكَ أحتَسِبُ مصيبتي فأْجُرْني فيها، وأبدِلْني ما هو خيرٌ منها» · الوقت: عند المصيبة"},"repOf":"س-01294","ref":"تخريج المسند لشعيب 26669","text":["قال أبو سلَمةَ: قال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ: ",["إذا أصابَ أحدَكُم مُصيبةٌ، فلْيقُلْ: إنَّا للهِ وإنَّا إليهِ راجعونَ، عندَكَ أحتَسِبُ مصيبتي فأْجُرْني فيها، وأبدِلْني ما هو خيرٌ منها",1],". فلمَّا احتُضِرَ أبو سلَمةَ، قال: اللَّهمَّ اخلُفْني في أهلي بخَيرٍ، فلمَّا قُبِضَ، قلتُ: إنَّا للهِ وإنَّا إليه راجعونَ، اللَّهمَّ عندَكَ أحتَسِبُ مصيبتي، فأْجُرْني فيها. قالتْ: وأرَدْتُ أنْ أقولَ: وأَبدِلْني خيرًا منها، فقلتُ: ومَن خَيرٌ مِن أبي سلَمةَ، فما زِلتُ حتى قُلتُها، فلمَّا انقضَتْ عِدَّتُها خطَبها أبو بكْرٍ فردَّتْه، ثمَّ خطَبَها عُمرُ فردَّتْه، ",["فبعَث إليها رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ",2],"، فقالَتْ: مَرحبًا برسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ، وبرَسولِه، أخبِرْ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ أنِّي امرَأةٌ غَيْرَى، وأنِّي مُصْبِيةٌ، وأنَّه ليس أحَدٌ مِن أوليائي شاهدًا، فبعَث إليها رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ: أمَّا قولُك: إنِّي مُصْبِيةٌ، فإنَّ اللهَ سيَكفيكِ صِبْيانَكِ، وأمَّا قولُكِ: إني غَيْرَى، فسأدْعو اللهَ أنْ يُذهِبَ غَيْرَتِكِ، وأمَّا الأولياءُ، فليسَ أحدٌ منهم شاهدٌ ولا غائبٌ إلَّا سيَرْضاني. قلتُ: يا عُمرُ، قمْ فزوِّجْ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ، فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ: أمَا إنِّي لا أَنقُصُكِ شيئًا ممَّا أعطيتُ أُختَكِ فُلانةَ رَحْيَينِ وجَرَّتينِ، ووِسادةً مِن أدَمٍ، حَشوُها لِيفٌ. قال: وكان رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يأْتيها، فإذا جاءَ أخذَتْ زَينَبَ، فوضَعَتْها في حِجرِها لتُرضِعَها، وكان رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ حَيِيًّا كريمًا، يَستَحْيي، فيرجِعُ، ففعَل ذلك مِرارًا، ففَطِنَ عمَّارُ بنُ ياسرٍ لِمَا تَصنَعُ، فأقبَلَ ذاتَ يومٍ، وجاءَ عمَّارٌ، وكان أخاها لأمِّها، فدخَل عليها، فانتَشطَها من حِجْرِها، وقال: دَعِي هذه المَقبوحةَ المَشقوحةَ التي آذَيْتِ بها رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ. قال: وجاءَ رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ فدخَلَ، فجعَلَ يُقلِّبُ بصَرَه في البيتِ ويقولُ: أينَ زَنابُ؟ ما فعَلتْ زَنابُ؟ قالتْ: جاءَ عمَّارٌ، فذهَبَ بها، قال: فبَنَى بأهلِه، ثمَّ قال: إنْ شئتِ أنْ أُسبِّعَ لكِ، سَبَّعْتُ للنِّساءِ."],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"بعضه صحيح","takhrij":"أخرجه مسلم (1460)، وأبو داود (2122)، والنسائي في ((السنن الكبرى)) (8925)، وابن ماجه (1917) مختصراً بنحوه، وأحمد (26669) واللفظ له","bab":"نكاح › الغيرة","dorar":"HtS0BzeD","merged":3,"otherRefs":["صحيح ابن حبان 2949 (صحيح)","المستدرك على الصحيحين 6932 (صحيح)"]},{"id":"س-08086","fp":"fbbaa88dfb69","stateId":53,"easy":"إذا ذكرت الله عند الشدة (بسم الله) ← تحملك الملائكة (من واقعة)","cause":"لو قلتَ بسمِ اللهِ","result":"لطارَت بكَ الملائكةُ والناسُ ينظرونَ إليكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"السلسلة الصحيحة 6/700","srcLabel":"مسلم","text":["لمَّا كانَ يومُ أُحُدٍ وولَّى الناسُ كانَ رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ في ناحيةٍ في اثنَي عشرَ رجلًا من الأنصارِ ، وفيهِم طلحةُ بنُ عبيدِ اللهِ ، فأدركَهم المشركونَ ، فالتفتَ رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ وقالَ : مَن للقومِ ؟ فقالَ طلحةُ : أنَا . قالَ رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ : كمَا أنتَ . فقالَ رجلٌ مِن الأنصارِ : أنَا يا رسولَ اللهِ ، فقالَ : أنتَ ، فقاتلَ حتى قُتلَ ، ثمَّ التفتَ فإذا المشركونَ ، فقالَ : مَن للقومِ ؟ فقالَ طلحةُ : أنَا ، قالَ : كما أنتَ ، فقال رجلٌ مِن الأنصارِ : أنَا ، فقال : أنتَ ، فقاتلَ حتَّى قُتلَ ، ثمَّ لمْ يزلْ يقولُ ذلكَ ويخرجُ إليهِم رجلٌ مِن الأنصارِ ، فيُقاتِلُ قتالَ مَن قَبلَه حتَّى يُقتَلَ ، حتَّى بَقِيَ رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ وطلحةُ بنُ عبيدِ اللهِ ، فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ : مَن للقومِ ؟ فقالَ طلحةُ : أنَا ، فقاتلَ طلحةُ قِتالَ الأحدَ عشَرَ حتَّى ضُرِبَت يدُه فقُطعَت أصابعُه فقال : حَسِّ ، فقالَ رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ",["لو قلتَ بسمِ اللهِ",1]," ",["لطارَت بكَ الملائكةُ والناسُ ينظرونَ إليكَ",2]," ، ثمَّ ردَّ اللهُ المشركينَ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناد على شرط مسلم ، إلا أن فيه عنعنة أبي الزبير لكن يقويه ما بعده","takhrij":"أخرجه النسائي (3149) واللفظ له، وابن السني في ((عمل اليوم والليلة)) (669) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (8704) بنحوه.","bab":"مغازي › غزوة أحد","dorar":"C3gH7NUr","merged":3,"otherRefs":["السلسلة الصحيحة 2796 (حسن)","صحيح الجامع 5276 (صحيح)"]},{"id":"س-03909","fp":"5adc05fee2dd","stateId":53,"easy":"إذا أصابتك الحمى أو مصيبة ولو ضياع متاع ← تخرج من ذنوبك نقياً","cause":"بما يُصيبُهُ مِن الحُمَّى والنَّكْبَةِ حتَّى البِضاعةُ يضعُها في يدِ قميصِهِ فيفقِدُها فيفزعُ لها","result":"حتَّى إنَّ العبدَ ليخرجُ مِن ذنوبِهِ كما يخرجُ التِّبْرُ الأحمرُ من الكيرِ","explicit":true,"otherNeedIds":[11],"ref":"سنن الترمذي 2991","srcLabel":"متفق عليه","text":["أنَّها سألت عائشةَ عن قَولِ اللهِ تباركَ وتعالى : :  إِنْ تُبْدُوْا مَا فِي أَنْفُسِكُمْ أَوْ تُخْفُوهُ يُحَاسِبْكُمْ بِهِ اللهُ  وعن قَولِهِ :  مَنْ يَعْمَلْ سُوءًا يُجْزَ بِهِ  فقالت : ما سأَلَني عنها أحدٌ منذُ سألتُ رسولَ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ فقال : \" هذهِ معاتبةُ اللهِ العبدَ ",["بما يُصيبُهُ مِن الحُمَّى والنَّكْبَةِ حتَّى البِضاعةُ يضعُها في يدِ قميصِهِ فيفقِدُها فيفزعُ لها",1]," ، ",["حتَّى إنَّ العبدَ ليخرجُ مِن ذنوبِهِ كما يخرجُ التِّبْرُ الأحمرُ من الكيرِ",2]," \""],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"حسن غريب","takhrij":"أخرجه البخاري (5640)، ومسلم (2572) بنحوه.","bab":"تفسير آيات › سورة النساء","dorar":"2Nvggr31"},{"id":"س-07611","fp":"28445cc0c1dd","stateId":53,"easy":"إذا أصابتك مصيبة فتذكّر مصيبتك بموت النبي ﷺ ← فهي أعظم المصائب (فتهون عليك)","cause":"إذا أصاب أحدَكم مُصيبةٌ ، فلْيذْكرْ مُصيبتَه بي","result":"فإنها من أعظمِ المصائبِ","explicit":true,"apply":{"k":"time","t":"عند المصيبة"},"ref":"صحيح الجامع 347","srcLabel":"صحيح الجامع","text":[["إذا أصاب أحدَكم مُصيبةٌ ، فلْيذْكرْ مُصيبتَه بي ، ",1],["فإنها من أعظمِ المصائبِ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس وسابط الجمحي","muhaddith":"صحيح","bab":"فضائل النبي وصفته ودلائل النبوة › مرض النبي وموته","dorar":"EbYtT3OP","merged":2,"otherRefs":["السلسلة الصحيحة 1106 (صحيح)"]},{"id":"س-01012","fp":"57e0cac2b856","stateId":53,"easy":"إذا استرجعت عند المصيبة وقلت «اللهم أجرني في مصيبتي واخلف لي خيراً منها» ← يكون لك ذلك","cause":"مَن رجعَ عندَ مصيبةٍ ثمَّ قالَ اللَّهمَّ أْجُرْني في مُصيبَتي واخلُفني خيرًا مِنها","result":"كانَ لَهُ ذلكَ","explicit":true,"apply":{"k":"say","t":"«اللهم أجرني في مصيبتي واخلف لي خيراً منها» · الوقت: عند المصيبة"},"ref":"التمهيد 3/184","srcLabel":"الترمذي","text":["عن أمِّ أيمنَ مولاةِ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قالَت أخبرَتني أمُّ سلمةَ زوجُ النَّبيِّ عليهِ السَّلامُ أنَّ أبا سلَمةَ أتاها يومًا فقالَ لقد سَمِعتُ اليومَ مِن رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ كلامًا لَهوَ أحبُّ إليَّ مِن حمرِ النَّعمِ قالت وما هوَ يا أبا سلَمةَ قالَ سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ ",["مَن رجعَ عندَ مصيبةٍ ثمَّ قالَ اللَّهمَّ أْجُرْني في مُصيبَتي واخلُفني خيرًا مِنها",1]," ",["كانَ لَهُ ذلكَ",2]," قالَت فلمَّا أصيبَ أبو سلَمَةَ رجعَت ثمَّ قلتُ اللَّهمَّ أْجُرْني في مُصيبتي قالَت وَهَممتُ أن أقولَ واخلُف لي خيرًا منها ثمَّ قلتُ ومن خيرٌ من أبي سلمةَ قالت ورسولُ اللَّه صلَّى اللَّهُ عليهِ وسلَّمَ أمامي متوكِّئٌ على أبي بَكْرٍ ممسِكٌ بيدِهِ قالت ثمَّ قلتُها قالت فشدَّ على يدَي أبي بَكْرٍ"],"grade":"صحيح","narrator":"أبو سلمة الأنصاري","muhaddith":"إسناده عن أبي سلمة فهو صحيح","takhrij":"أخرجه الترمذي (3511)، وابن ماجة (1598)، وأحمد (16343) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"nW5l8Sjb"},{"id":"س-02768","fp":"7d62b4a0a62a","stateId":53,"easy":"إذا أصابتك مصيبة فوثقت بالله ورجوته ← ففي الله عزاء من كل مصيبة وعوض من كل فائت","cause":"فباللهِ فَثِقوا، وإيَّاه فارْجوا","result":"إنَّ في اللهِ عَزاءً من كلِّ مُصيبةٍ، وخلَفًا من كلِّ فائتٍ","explicit":true,"apply":{"k":"time","t":"عند المصيبة"},"ref":"المستدرك على الصحيحين 4445","srcLabel":"البيهقي","text":["عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ رَضِيَ اللَّهُ عَنْهُمَا قَالَ: لمَّا تُوفِّيَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ عزَّتْهمُ المَلائكةُ، يَسمَعونَ الحِسَّ ولا يرَوْنَ الشَّخصَ، فقالَتِ: السَّلامُ عليكم أهْلَ البَيتِ ورَحْمةُ اللهِ وبَرَكاتُه، ",["إنَّ في اللهِ عَزاءً من كلِّ مُصيبةٍ، وخلَفًا من كلِّ فائتٍ",2],"، ",["فباللهِ فَثِقوا، وإيَّاه فارْجوا",1],"؛ فإنَّما المَحْرومُ مَن حُرِمَ الثَّوابَ، والسَّلامُ عليكم ورَحْمةُ اللهِ وبَرَكاتُه."],"grade":"صحيح","narrator":"[محمد بن على بن الحسين]","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((دلائل النبوة)) (7/ 268) بلفظه.","bab":"إيمان › الملائكة","dorar":"wJAYg1xK"},{"id":"س-02885","fp":"bc87664cf820","stateId":53,"easy":"إذا أصابتك مصيبة فاسترجعت واحتسبتها ← يبدلك الله خيراً منها","cause":"ما من أحَدٍ منَ المُسلِمينَ يُصابُ بمُصيبةٍ، فيقولُ: إنَّا للهِ وإنَّا إليه راجعونَ، اللَّهُمَّ إنِّي احتَسَبْتُ مُصيبَتي عندَكَ، فأبدِلْني خَيرًا منها","result":"إلَّا أبدَلَه اللهُ خَيرًا منها","explicit":true,"apply":{"k":"time","t":"عند المصيبة"},"repOf":"س-05665","ref":"تخريج مشكل الآثار 5754","text":["عن زَوجِها أبي سَلَمةَ قال: سمِعْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["ما من أحَدٍ منَ المُسلِمينَ يُصابُ بمُصيبةٍ، فيقولُ: إنَّا للهِ وإنَّا إليه راجعونَ، اللَّهُمَّ إنِّي احتَسَبْتُ مُصيبَتي عندَكَ، فأبدِلْني خَيرًا منها،",1]," ",["إلَّا أبدَلَه اللهُ خَيرًا منها",2],"، فلمَّا تُوفِّيَ أبو سَلَمةَ قُلْتُ: إنَّا للهِ وإنَّا إليه راجعونَ، اللَّهُمَّ إنِّي احتَسَبْتُ في مُصيبَتي، فأبدِلْني به خَيرًا منه. قالت: وجعَلْتُ أقولُ في نفْسي: مَن خَيرٌ من أبي سَلَمةَ، فجاءَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فخطَبَني فتَزوَّجْتُه."],"grade":"صحيح","narrator":"أبو سلمة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (5754) بلفظه، والترمذي (3511)، وأحمد (26669) مطولا، وكلاهما بلفظ مقارب.","bab":"إيمان › الوعد","dorar":"ytr2rkI8"},{"id":"س-02898","fp":"2f8e8605d5bd","stateId":53,"easy":"إذا أصابتك مصيبة ففزعت إلى الاسترجاع ← يأجرك الله ويعوضك خيراً منها","cause":"ما مِن مُسلِمٍ يُصابُ بِمصيبةٍ فيفزَعُ إلى ما أمرَ اللَّهُ بِه من قولِه إنَّا لِلَّهِ وإنَّا إليهِ راجِعونَ اللَّهمَّ عندَك احتسبتُ مُصيبتي فأجِرني فيها وعوِّضني مِنها","result":"إلَّا آجرَه اللَّهُ عليها وعاضَه خَيرًا منها","explicit":true,"apply":{"k":"time","t":"عند المصيبة"},"repOf":"س-05665","otherNeedIds":[45],"ref":"صحيح ابن ماجه 1309","text":[["ما مِن مُسلِمٍ يُصابُ بِمصيبةٍ فيفزَعُ إلى ما أمرَ اللَّهُ بِه من قولِه إنَّا لِلَّهِ وإنَّا إليهِ راجِعونَ اللَّهمَّ عندَك احتسبتُ مُصيبتي فأجِرني فيها وعوِّضني مِنها",1]," ",["إلَّا آجرَه اللَّهُ عليها وعاضَه خَيرًا منها",2]],"grade":"صحيح","narrator":"أبو سلمة عبدالله بن عبد الأسد","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (1598) بلفظه مطولًا، والترمذي (3511) بلفظ مقارب، وأحمد (26669) بلفظ مقارب مطولًا","bab":"إيمان › الوعد","dorar":"L1AnbSDx"},{"id":"س-03275","fp":"81454568e080","stateId":53,"easy":"إذا أصابتك الحمى أو النكبة أو ضياع شيء ففزعت ← تخرج من ذنوبك كما يخرج الذهب من الكير","cause":"وما يُصيبُهُ منَ الحمَّى ، والنَّكبة ، والبِضاعةُ يضعُها في يدِ كمِّهِ ، فيتفقَّدُها فيفزعُ لَها ، ثمَّ يجدُها في ضُبنتِه","result":"حتَّى إنَّ المُؤْمِنَ ليخرجُ من ذنوبِهِ كما يخرجُ التِّبرُ الأحمرُ","explicit":true,"otherNeedIds":[11],"ref":"عمدة التفسير 1/346","srcLabel":"الترمذي","text":["سألتُ عائشةَ عن هذِهِ الآيةِ :  وَإِنْ تُبْدُوا مَا فِي أَنْفُسِكُمْ أَوْ تُخْفُوهُ يُحَاسِبْكُمْ بِهِ اللَّهُ  فقالت : ما سألَني عنها أحدٌ منذُ سألتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ عنها فقالَ : هذِهِ متابَعةُ اللَّهِ العبدَ ، ",["وما يُصيبُهُ منَ الحمَّى ، والنَّكبة ، والبِضاعةُ يضعُها في يدِ كمِّهِ ، فيتفقَّدُها فيفزعُ لَها ، ثمَّ يجدُها في ضُبنتِه",1]," ، ",["حتَّى إنَّ المُؤْمِنَ ليخرجُ من ذنوبِهِ كما يخرجُ التِّبرُ الأحمرُ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2991)، وأحمد (25835)، والطيالسي (1689) واللفظ لهم.","bab":"استغفار › أسباب المغفرة","dorar":"D806xV8z"},{"id":"س-08326","fp":"9cbc2115eaf7","stateId":53,"easy":"إذا أصابتك مصيبة ← فقل «إنا لله وإنا إليه راجعون»","cause":"فليقل إنَّا للَّهِ وإنَّا إليهِ راجعونَ","result":"إذا أصابَ أحدَكم مصيبةٌ","explicit":true,"apply":{"k":"time","t":"عند المصيبة"},"ref":"صحيح الترمذي 3511","srcLabel":"الترمذي","text":[["إذا أصابَ أحدَكم مصيبةٌ",2]," ",["فليقل إنَّا للَّهِ وإنَّا إليهِ راجعونَ",1]," اللَّهمَّ عندَك أحتسبتُ مصيبتي فأجرني فيها وأبدلني منها خيرًا. فلمَّا احتضرَ أبو سلمةَ قالَ اللَّهمَّ اخلف في أهلي خيرًا منِّي فلمَّا قبضَ قالت أمُّ سلمةَ إنَّا للَّهِ وإنَّا إليهِ راجعونَ عندَ اللهِ أحتسبتُ مصيبتي فأجرني فيها"],"grade":"صحيح","narrator":"أبو سلمة عبدالله بن عبد الأسد","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (3511) واللفظ له، وأحمد (16387) من حديث أبي سلمة رضي الله عنه.","bab":"مناقب وفضائل › فضائل أزواج النبي صلى الله عليه وسلم","dorar":"0bf5IvRc"},{"id":"س-05685","fp":"9f781b1c52ea","stateId":53,"easy":"إذا احتسبت مصيبتك ← لك أجر كبير: صلوات من الله ورحمة وهدى","cause":"إنِ احتَسَبْتَه","result":"بأجْرٍ كَبيرٍ، الصَّلاةُ والرَّحمةُ والهُدى","explicit":true,"otherNeedIds":[24],"ref":"المستدرك على الصحيحين 5281","srcLabel":"الطبراني","text":["أنَّه ماتَ له ابنٌ، فكتَبَ إليه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يُعزِّيه عليه: «بسمِ اللهِ الرَّحمَنِ الرَّحيمِ، من محمَّدٍ رَسولِ اللهِ إلى مُعاذِ بنِ جَبلٍ، سَلامٌ عليكَ، فإنِّي أحمَدُ إليكَ اللهَ الَّذي لا إلَهَ إلَّا هو، أمَّا بعدُ، فأعظَمَ اللهُ لكَ الأجْرَ، وألهَمَكَ الصَّبرَ، ورزَقَنا وإيَّاكَ الشُّكرَ، فإنَّ أنفُسَنا وأمْوالَنا وأهْلينا وأوْلادَنا من مَواهِبِ اللهِ عزَّ وجلَّ الهَنيئةِ وعَواريهِ المُستَودَعةِ، متَّعَكَ به في غِبْطةٍ وسُرورٍ، وقبَضَه منكَ ",["بأجْرٍ كَبيرٍ، الصَّلاةُ والرَّحمةُ والهُدى",2],"، ",["إنِ احتَسَبْتَه",1],"، فاصْبِرْ، ولا يُحبِطُ جزَعُكَ أجْرَكَ فتَندَمَ، واعلَمْ أنَّ الجَزعَ لا يرُدُّ شَيئًا، ولا يَدفَعُ حُزنًا، وما هو نازِلٌ فكانَ قدْ، والسَّلامُ»."],"grade":"حسن","narrator":"معاذ بن جبل","muhaddith":"غريب حسن إلا أن مجاشع بن عمرو ليس من شرط هذا الكتاب","takhrij":"أخرجه الطبراني (20/ 155) (324)، وابن الأعرابي في ((معجم شيوخه)) (646)، وأبو نعيم في ((الحلية)) (1/ 242) بلفظ قريب.","bab":"رقائق وزهد › الصبر على البلاء","dorar":"Wa9l8qsN"},{"id":"س-06080","fp":"0875c43defd8","stateId":53,"easy":"إذا ضاع منك شيء فخفق قلبك له ← يُكتب لك أجره","cause":"فيلتمسُها فتخطئُها كفُّهُ فيخفِقُ لَها فؤادُه","result":"ويُكتبُ لَه أجرُهُ","explicit":true,"otherNeedIds":[45],"ref":"الأمالي المطلقة 117","srcLabel":"الطبراني","text":["إنَّ المؤمنَ ليؤجَرُ في هدايتِه السَّبيلَ وفي إماطتِه الأذى عنِ الطَّريقِ وفي تعبيرِه بلسانِهِ عنِ الأعجميِّ وفي إتيانِه أَهلَه حتَّى أنَّهُ ليؤجر في السِّلعةِ تكونُ في طرفِ ثوبِه ",["فيلتمسُها فتخطئُها كفُّهُ فيخفِقُ لَها فؤادُه",1]," فتُرَدُّ عليهِ ",["ويُكتبُ لَه أجرُهُ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"أخرجه البزار (6927)، والطبراني في ((المعجم الأوسط)) (3530)، والبيهقي في ((شعب الإيمان)) (9479) باختلاف يسير","bab":"رقائق وزهد › ما جاء في فعل الخير","dorar":"9UmyItxP"},{"id":"س-03543","fp":"06fe1bb6d14c","stateId":54,"easy":"إذا أصابتك شوكة أو وجع ← يرفعك الله بها درجة ويحط عنك خطيئة","cause":"ليس مِن مُؤمِنٍ تُصيبُه نَكْبةٌ؛ شَوْكةٌ، ولا وَجَعٌ","result":"إلَّا رفَعَ اللهُ عزَّ وجلَّ له بها دَرَجةً، وحَطَّ عنه بها خَطيئَةً","explicit":true,"star":true,"otherNeedIds":[11,47],"ref":"تخريج المسند لشعيب 25804","srcLabel":"متفق عليه","text":["أنَّ النبيَّ صلَّى اللهُ عليه وسلَّمَ طرَقَه وَجَعٌ؛ فجعَلَ يَشتَكي، ويتَقَلَّبُ على فِراشِه، فقالَتْ له عائِشةُ: لو فعَلَ هذا بَعْضُنا لَوَجِدْتَ عليه، فقال: إنَّ المُؤمِنينَ يُشَدَّدُ عليهم، فإنَّه ",["ليس مِن مُؤمِنٍ تُصيبُه نَكْبةٌ؛ شَوْكةٌ، ولا وَجَعٌ",1],"، ",["إلَّا رفَعَ اللهُ عزَّ وجلَّ له بها دَرَجةً، وحَطَّ عنه بها خَطيئَةً",2],"، أو كالذي قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (5640) مختصراً بنحوه، ومسلم (2572) بلفظ مقارب دون القصة في أوله","bab":"استغفار › مكفرات الذنوب","dorar":"oCGJ4xfm","merged":3,"otherRefs":["صحيح الجامع 1935 (صحيح)","المستدرك على الصحيحين 1296 (صحيح)"]},{"id":"س-07561","fp":"a43964c5243e","stateId":54,"easy":"إذا ابتُليت فصبرت ← فلك الجنة","cause":"إنْ أحبَبْتِ أن تَصْبري","result":"ولك الجنَّةُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[67,65],"ref":"الفتاوى الكبرى 3/7","srcLabel":"متفق عليه","text":["عن الجاريةِ التي كانت تُصْرَعُ، وسألَتِ النَّبيَّ صلَّى اللهُ عليه وسلَّم أن يَدْعوَ لها، فقال: ",["إنْ أحبَبْتِ أن تَصْبري",1]," ",["ولك الجنَّةُ",2],"، وإن أحبَبْتِ دَعَوتُ اللهَ أن يَشْفِيَكِ، فقالت: بل أصبِرُ، ولكِنِّي أتكشَّفُ فادْعُ اللهَ لي ألَّا أنكَشِفَ، فدعا لها ألَّا تتكَشَّفَ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه البخاري (‌5652)، ومسلم (‌2576)، وأحمد (3240) واللفظ لهم.","bab":"فضائل النبي وصفته ودلائل النبوة › دعاء النبي لبعض الناس","dorar":"BbvK448b","merged":4,"otherRefs":["السلسلة الصحيحة 2502 (حسن)","صحيح ابن حبان 2909 (صحيح)","الترغيب والترهيب 4/227 (صحيح)"]},{"id":"س-03526","fp":"e7b226f3587b","stateId":54,"easy":"إذا صبرت على البلاء ← يتمنى أهل العافية يوم القيامة مكانك لما يرون من ثوابك","cause":"لأهْلِ البَلاءِ","result":"يَوَدُّ أهْلُ العافِيةِ أنَّ لُحومَهم قُرِضَتْ بالمَقاريضِ لِما يَرَوْنَ مِن ثَوابِ اللهِ عَزَّ وجَلَّ","explicit":true,"star":true,"ref":"الأحكام الوسطى 4/ 228","srcLabel":"الترمذي","text":["\"",["يَوَدُّ أهْلُ العافِيةِ أنَّ لُحومَهم قُرِضَتْ بالمَقاريضِ لِما يَرَوْنَ مِن ثَوابِ اللهِ عَزَّ وجَلَّ",2]," ",["لأهْلِ البَلاءِ",1],"\"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه الترمذي (2402)، والبيهقي في ((شعب الإيمان)) (9451)، وابن أبي الدنيا في ((المرض والكفارات)) (202) واللفظ لهم","bab":"استغفار › مكفرات الذنوب","dorar":"KwuD7pgd","merged":4,"otherRefs":["الجامع الصغير 7721 (صحيح)","اللآلئ المصنوعة 2/401 (حسن)","صحيح الجامع 8177 (حسن)"]},{"id":"س-02503","fp":"69626b0948fc","stateId":54,"easy":"إذا صبرت على بلائك ← تجيء يوم القيامة بلا ذنوب ولا حساب (من واقعة)","cause":"تصبري على ما أنتِ عليه","result":"وتجيئي يومَ القيامةِ ليس عليكِ ذنوبٌ ولاحسابٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-08307"],"otherNeedIds":[11,65],"ref":"البداية والنهاية 6/298","srcLabel":"متفق عليه","text":["كان النبيُّ صلَّى اللهُ عليه وسلَّمَ بمكةَ فجاءته امرأةٌ من الأنصارِ فقالت يا رسولَ اللهِ إنَّ هذا الخبيثَ قد غلبني فقال لها ",["تصبري على ما أنتِ عليه",1]," ",["وتجيئي يومَ القيامةِ ليس عليكِ ذنوبٌ ولاحسابٌ",2]," فقالت والذي بعثك بالحقِّ لَأصبِرنَّ حتى ألقى اللهَ ثم قالت إني أخاف الخبيثَ أن يُجرِّدَني فدعا لها وكانت إذا أحسَّتْ أن يأتيَها تأتي أستارَ الكعبةِ فتتعلَّقُ بها وتقول له اخْسَأْ فيذهبُ عنها"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"له شاهد في صحيح البخاري ومسلم","takhrij":"أخرجه البزار (5073)","bab":"إيمان › أعمال الجن والشياطين","dorar":"MmNA7pGZ"},{"id":"س-03119","fp":"bd90ce69fe71","stateId":54,"easy":"إذا صبرت ← فلك أجر الصبر","cause":"فمَن صَبَرَ","result":"فله الصَّبْرُ","explicit":true,"otherNeedIds":[23],"ref":"تخريج زاد المعاد 4/177","srcLabel":"أحمد","text":["إنَّ اللهَ عزَّ وجلَّ إذا أحبَّ قَومًا ابْتلاهُم، ",["فمَن صَبَرَ",1]," ",["فله الصَّبْرُ",2],"، ومَن جَزِعَ فله الجَزَعُ."],"grade":"صحيح","narrator":"محمود بن لبيد","muhaddith":"صحيح","takhrij":"أخرجه أحمد (23633)، والبيهقي في ((شعب الإيمان)) (9327)، وأبو العباس الأصم في ((جزئه)) (342) بلفظه.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"JkfltjQn","merged":2,"otherRefs":["صحيح الترغيب 3406 (صحيح)"]},{"id":"س-05608","fp":"9d6403cceb85","stateId":54,"easy":"إذا صبرت على مرارة الدنيا ← تجد حلاوة الآخرة","cause":"مُرَّةُ الدُّنيا","result":"حُلوةُ الآخِرةِ","explicit":true,"ref":"المستدرك على الصحيحين 8073","srcLabel":"أحمد","text":["عن شُرَيحِ بنِ عُبَيدٍ: أنَّ أبا مالِكٍ الأشعَريَّ لمَّا حَضَرَتْه الوَفاةُ قالَ: يا مَعشَرَ الأشعَرِيِّين، ليُبَلِّغِ الشَّاهِدُ مِنكُم الغائبَ، إنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: حُلوةُ الدُّنيا مُرَّةُ الآخِرةِ، و",["مُرَّةُ الدُّنيا",1]," ",["حُلوةُ الآخِرةِ",2],"."],"grade":"صحيح","narrator":"أبو مالك الأشعري","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (22899)، والطبراني (3/ 291)، (3438) كلاهما بلفظه، وابن أبي عاصم في ((الزهد)) (7861) مختصرا.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"yzJduXgE","merged":2,"otherRefs":["السلسلة الصحيحة 1817 (صحيح)"]},{"id":"س-06026","fp":"90e443f9528e","stateId":54,"easy":"إذا ابتُليت فصبرت ← فأنت السعيد","cause":"ابتُليَ فصبرَ","result":"إنَّ السَّعيدَ","explicit":true,"otherNeedIds":[16],"ref":"البحر الزخار 6/46","srcLabel":"أبو داود","text":["جاءَ المقدادُ بنُ الأسوَدِ في حاجةٍ، فقلنا: اجلِس حتَّى نطلُبَ لَك حاجتَكَ فجلسَ فقال: عجِبتُ لقومٍ مرَرتُ بِهم يتمنَّونَ الفتَنَ يزعُمونَ ليُبلِينَّهمُ اللَّهُ فيها ما أبلى رسولَه صلَّى اللهُ علَيهِ وسلَّم، وأصحابَه رضيَ اللَّهُ عنهُم، ولقد سمعتُ رسولَ اللَّهِ صلَّى اللهُ علَيهِ وسلَّمَ يقولُ: ",["إنَّ السَّعيدَ",2]," لَمَن جُنِّبَ الفتَنَ، إنَّ السَّعيدَ لمن جُنِّبَ الفتَن يردِّدُها ثلاثَ مرَّاتٍ إلَّا مَنِ ",["ابتُليَ فصبرَ",1]," وايمُ اللَّهِ لا أشهَدُ لأحدٍ أنَّهُ من أَهلِ الجنَّةِ حتَّى أعلمَ ما يموتُ علَيهِ بعدَ حديثٍ سمعتُهُ مِن رسولِ اللَّهِ صلَّى اللهُ علَيهِ وسلَّمَ سمعتُ رسولَ اللَّهِ صلَّى اللهُ علَيهِ وسلَّمَ يقولُ: لَقَلبُ ابنِ آدمَ أشدُّ انقلابًا منَ القِدرِ إذا غَلِيَتْ"],"grade":"صحيح","narrator":"المقداد بن عمرو بن الأسود","muhaddith":"محفوظ وإسناده حسن","takhrij":"أخرجه أبو داود (4263) مختصراً، والبزار (2112) واللفظ له.","bab":"رقائق وزهد › فضل الصبر","dorar":"wy9CD1MT","merged":2,"otherRefs":["السلسلة الصحيحة 975 (صحيح)"]},{"id":"س-06041","fp":"fc93674c1a36","stateId":54,"easy":"إذا حمدت الله في الخير وصبرت في المصيبة ← تؤجر في كل شيء","cause":"إنِ أصابَهُ خيرٌ حمِدَ ربَّهُ وشَكَرَ وإنِ أصابتهُ مُصيبةٌ حمِدَ ربَّهُ وصبرَ","result":"المؤمنُ يُؤجَرُ في كلِّ شيءٍ حتَّى في اللُّقمةِ يرفعُها إلى فيِّ امرأتِهِ","explicit":true,"otherNeedIds":[5,45],"ref":"تخريج المسند لشاكر 3/49","srcLabel":"أحمد","text":["عَجِبْتُ مِن قضاءِ اللَّهِ عزَّ وجلَّ للمؤمنِ ",["إنِ أصابَهُ خيرٌ حمِدَ ربَّهُ وشَكَرَ وإنِ أصابتهُ مُصيبةٌ حمِدَ ربَّهُ وصبرَ",1]," ",["المؤمنُ يُؤجَرُ في كلِّ شيءٍ حتَّى في اللُّقمةِ يرفعُها إلى فيِّ امرأتِهِ",2]],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (1487) بلفظه، والضياء في ((المختارة)) (1027)، والبيهقي (6629)باختلاف يسير.","bab":"رقائق وزهد › فضل الصبر","dorar":"Zt9l5V8a","merged":2,"otherRefs":["صحيح الجامع 3986 (صحيح)"]},{"id":"س-08307","fp":"0ce1993851e6","stateId":54,"easy":"إذا صبرت على بلائك ← فلا حساب عليك ولا عذاب","cause":"فدَعْنِي إذنْ","result":"فلا حِسابَ ولا عَذَابَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-02503","otherNeedIds":[65],"ref":"المستدرك على الصحيحين 7718","text":["أتَتِ امرأةٌ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ فذَكَرَتْ أنَّ بها طَيْفًا مِن الشَّيْطانِ، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنْ شِئتِ دعَوْتُ اللهَ عزَّ وجلَّ فبَرَّأَكِ، وإنْ شِئْتِ ",["فلا حِسابَ ولا عَذَابَ",2],"، قالتْ: يا رسولَ اللهِ، ",["فدَعْنِي إذنْ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أحمد (9689)، وابن حبان (2909)، والبزار (7980) بنحوه.","bab":"مناقب وفضائل › بعض من شهد النبي بأنهم من أهل الجنة","dorar":"IjZ4sMKH"},{"id":"س-05570","fp":"39db084a8e91","stateId":54,"easy":"إذا علمت ما لك عند الله في الفقر ← لأحببت أن تزداد فاقة","cause":"لو تعلَمونَ ما لَكُم عندَ اللَّهِ","result":"لأحببتُمْ أن تَزدادوا فاقةً وحاجةً","explicit":true,"ref":"الصحيح المسند 1060","srcLabel":"الترمذي","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّه عليهِ وعلَى آلِهِ وسلَّمَ كانَ إذا صلَّى بالنَّاسِ يَخرُّ رجالٌ مِن قامتِهِم في الصَّلاةِ منَ الخصاصةِ وَهُم أصحابُ الصُّفَّةِ حتَّى تقولَ الأعرابُ هؤلاءِ مَجانينُ أو مَجانونَ ، فإذا صلَّى رسولُ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ انصرفَ إليهِم ، فقالَ: ",["لو تعلَمونَ ما لَكُم عندَ اللَّهِ",1]," ",["لأحببتُمْ أن تَزدادوا فاقةً وحاجةً",2]," قالَ فَضالةُ: أَنا يومئذٍ معَ رسولِ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ - ."],"grade":"صحيح","narrator":"فضالة بن عبيد","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2368)، وأحمد (23938)، والبزار (3750)، والطبراني (18/ 310) (799) واللفظ لهم.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"V2KVuYHn"},{"id":"س-06055","fp":"5f971a88819b","stateId":54,"easy":"إذا رضيت بما صنع الله ← تؤجر","cause":"فإنْ تَرْضَوْا بما صنَعَ اللهُ","result":"تُؤجَروا","explicit":true,"otherNeedIds":[45],"ref":"مجمع الزوائد 2/328","srcLabel":"مجمع الزوائد","text":["سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ونظَرَ النَّبيُّ صلَّى اللهُ عليه وسلَّم إلى مَلَكِ المَوتِ عليه السَّلامُ عندَ رأسِ رَجُلٍ من الأنصارِ فقال: يا مَلَكَ المَوتِ، ارفُقْ بصاحِبي، فإنَّه مُؤمِنٌ، فقال مَلَكُ المَوتِ عليه السَّلامُ: طِبْ نَفْسًا وقَرَّ عَينًا، واعلَمْ أنِّي بكل مُؤمِنٍ رفيقٌ، واعلَمْ يا مُحمَّدُ أنِّي لأقبِضُ رُوحَ ابنِ آدَمَ، فإذا صرَخَ صارِخٌ من أهلِه، قُمتُ في الدَّارِ ومعي رُوحُه، فقُلتُ: ما هذا الصَّارخُ؟ واللهِ ما ظَلَمْناه، ولا سَبَقْنا أجَلَه، ولا استَعْجَلْنا قَدَرَه، وما لنا في قَبضِه من ذَنْبٍ،",[" فإنْ تَرْضَوْا بما صنَعَ اللهُ ",1],["تُؤجَروا",2],"، وإنْ تَحزَنوا وتَسخَطوا تَأثُموا وتُؤزَروا، ما لكم عندَنا منه [عُتبى، وإنَّ لنا عندَكم بعدُ عَودَةً وعَودَةً]، فالحَذَرُ الحَذَرُ، وما من أهلِ بَيتٍ يا مُحمَّدُ شَعَرٌ ولا مَدَرٌ، بَرٌّ ولا بَحْرٌ، سَهْلٌ ولا جَبَلٌ إلَّا أنا أتصفَّحُهم في كُلِّ يَومٍ ولَيلَةٍ حتى لأنا أعرَفُ بصَغيرِهم وكَبيرِهم منهم بأنْفُسِهم، واللهِ يا مُحمَّدُ لو أرَدتُ أقبِضُ رُوحَ بَعوضَةٍ ما قَدَرتُ على ذلك حتى يكونَ اللهُ هو أَذِنَ بقَبْضِها، قال جَعفَرُ بنُ مُحمَّدٍ: بَلَغَني أنَّه إنَّما يتصفَّحُهم عندَ مَواقيتِ الصَّلاةِ، فإذا نظَرَ عندَ المَوتِ، فمَن كان يُحافِظُ على الصَّلواتِ، دَنا منه المَلَكُ وطَرَدَ عنه الشَّيطانَ، ويُلقِّنُه المَلَكُ لا إلهَ إلَّا اللهُ، مُحمَّدٌ رسولُ اللهِ، وذلك الحالُ العظيمُ."],"grade":"صحيح","narrator":"الخزرج والد الحارث","muhaddith":"فيه عمر بن شمر الجعفي والحارث بن الخزرج ولم أجد من ترجمهما وبقية رجاله رجال الصحيح","bab":"رقائق وزهد › فضل الصبر","dorar":"qxgiGeUr"},{"id":"س-07909","fp":"198ca2059d90","stateId":54,"easy":"إذا أصابتك المصائب والأمراض والأحزان ← فهي جزاء (تكفير) لك","cause":"المصائِبُ ، و الأمْراضُ ، و الأحْزانُ في الدُّنيا","result":"جَزاءٌ","explicit":true,"otherNeedIds":[11],"ref":"صحيح الجامع 6717","srcLabel":"ابن مردويه","text":[["المصائِبُ ، و الأمْراضُ ، و الأحْزانُ في الدُّنيا",1]," ",["جَزاءٌ",2]],"grade":"صحيح","narrator":"مسروق بن الأجدع","muhaddith":"صحيح","takhrij":"أخرجه ابن مردويه كما في ((تفسير ابن كثير)) (2/419) مطولاً.","bab":"مريض › فضل المرض والنوائب","dorar":"bKjHfVbC"},{"id":"س-04508","fp":"fbd697033418","stateId":54,"easy":"إذا صبرت على البلاء ← يُصبّ عليك الأجر صبّاً بلا حساب","cause":"بأهلِ البلاءِ","result":"فلا ينصبُ لهُم ميزانٌ ولا يُنشرُ لهم ديوانٌ فيصبُّ عليْهِمُ الأجرُ صبًّا","explicit":true,"otherNeedIds":[65],"ref":"البدور السافرة 242","srcLabel":"الطبراني","text":["يؤتى بالشهيدِ يومَ القيامةِ فيُنصبُ للحسابِ ، ثم يؤتى بالمتصدقِ فينصبُ للحسابِ ، ثم يؤتى ",["بأهلِ البلاءِ",1]," ",["فلا ينصبُ لهُم ميزانٌ ولا يُنشرُ لهم ديوانٌ فيصبُّ عليْهِمُ الأجرُ صبًّا",2]," حتى إنَّ أهلَ العافيةِ ليَتمنونَ في الموقفِ أن أجسادَهُمْ قُرضَتْ بالمقاريضِ من حُسنِ ثوابِ اللهِ لهم"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه الطبراني (12829) (12/ 182) واللفظ له، وأبو نعيم في ((حلية الأولياء)) (3/ 91) باختلاف يسير، ومجاعة بن الزبير في ((حديثه)) (100).","bab":"جهاد › فضل الشهيد","dorar":"pFUua80i"},{"id":"س-07622","fp":"2aeea3363169","stateId":54,"easy":"إذا ابتُليت فصبرت ← فهو خير لك من العافية","cause":"وإن شئتَ صبرتَ","result":"فهو خيرٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[16],"ref":"التوسل للألباني 68","srcLabel":"الحاكم","text":["أنَّ رجلًا ضريرَ البصرِ أتى النَّبيَّ صلَّى اللهُ عليهِ وسلَّمَ فقال : ادعُ اللهَ أن يُعافِيَني . قال : إن شئتَ دعوتُ لك ، وإن شئتَ أخَّرتُ ذاك ، فهو خيرٌ ، ( وفي روايةٍ : ",["وإن شئتَ صبرتَ",1]," ",["فهو خيرٌ",2]," لك ) ، فقال : ادعُه . فأمره أن يتوضَّأ فيحسنُ وُضوءَه ، فيصلِّي ركعتَينِ ، ويدعو بهذا الدعاءِ : اللهمَّ إني أسألُك ، وأتوجَّه إليك بنبيِّك محمدٍ نبيِّ الرحمةِ ، يا محمدُ إني توجَّهتُ بك إلى ربي في حاجتي هذه فتُقضَى لي ، اللهمَّ فَشَفِّعْه فيَّ \" وشفِّعْني فيه \" قال ففعل الرجلُ ، فبرئ . ."],"grade":"صحيح","narrator":"عثمان بن حنيف","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن خزيمة (2/225)، والطبراني (9/17)، والحاكم في ((المستدرك)) (1/707) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › معجزات النبي","dorar":"RU6o1uz3"},{"id":"س-01717","fp":"b34017f9e43b","stateId":55,"easy":"إذا اشتد بلاؤك ← يضاعف الله لك الأجر","cause":"يُشَدَّدُ عَلَيْنا البَلاءُ","result":"ويُضَاعَفُ لَنا الأَجْرُ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"star":true,"otherNeedIds":[45],"ref":"صحيح الترغيب 3403","srcLabel":"البخاري","text":["إنَّا كَذلكَ ",["يُشَدَّدُ عَلَيْنا البَلاءُ",1]," ، ",["ويُضَاعَفُ لَنا الأَجْرُ",2]," ثُمَّ قال : يا رسولَ اللهِ ! مَنْ أَشَدُّ الناسِ بَلاءً ؟ قال : الأنْبياءُ قال : ثُمَّ مَنْ ؟ قال : العلماءُ قال : ثُمَّ مَنْ ؟ قال الصَّالِحُونَ ، وكان أحدُهُمْ يُبْتَلَى بِالقَمْلِ حتى يَقْتُلهُ ، ويُبْتَلَى أحدُهُمْ بِالفَقْرِ حتى ما يَجِدُ إلَّا العَباءَةَ يَلْبَسُها ، ولأحدُهُمْ كان أَشَدَّ فَرَحًا بِالبلاءِ من أَحَدِكُمْ بِالعَطَاءِ ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (4024)، والبخاري في ((الأدب المفرد)) (510) واللفظ لهما، والطبري في ((تهذيب الآثار- مسند ابن عباس)) (421)، والحاكم (7848) بنحوه.","bab":"أنبياء › خصائص وفضائل","dorar":"RxF6AhaS","merged":5,"otherRefs":["تخريج مشكل الآثار 2210 (صحيح)","صحيح الجامع 4577 (حسن)","صحيح الأدب المفرد 395 (صحيح)","السلسلة الصحيحة 5/76 (صحيح)"]},{"id":"س-05652","fp":"3e94bbde76d3","stateId":55,"easy":"إذا أحببت أهل البيت (الصالحين) ← فاستعد لفقر يأتيك سريعاً (والأجر عليه)","cause":"مَن يُحِبُّنا","result":"فإنَّ الفقْرَ أسرعُ إلى مَن يُحِبُّنا مِن السَّيْلِ مِن أعلى الأكَمَةِ إلى أسْفَلِها","explicit":true,"ref":"المستدرك على الصحيحين 8158","srcLabel":"الحاكم","text":["أنَّه أتَى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ فقالَ: إنِّي أُحِبُّكُم أهْلَ البيتِ، فقالَ له النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: اللهِ؟ قالَ: اللهِ، قالَ: فأعِدَّ للفَقْرِ تِجْفَافًا؛ ",["فإنَّ الفقْرَ أسرعُ إلى مَن يُحِبُّنا مِن السَّيْلِ مِن أعلى الأكَمَةِ إلى أسْفَلِها",2],"."],"grade":"صحيح","narrator":"أبو ذر","muhaddith":"صحيح على شرط الشيخين","takhrij":"لم نقف عليه إلا عند الحاكم (7944).","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"5hAeT5GM","merged":5,"otherRefs":["صحيح ابن حبان 2922 (صحيح)","سنن الترمذي 2350 (حسن)","السلسلة الصحيحة 2828 (حسن)","صحيح الجامع 1592 (صحيح)"]},{"id":"س-05662","fp":"cb3a8e820091","stateId":55,"easy":"إذا كنت نبياً أو صفياً ← كنت أشد الناس بلاء","cause":"نبيٌّ أوْ صفِيٌّ","result":"أشدُّ الناسِ بلاءً في الدنيا","explicit":true,"ref":"الجامع الصغير 1049","srcLabel":"البخاري","text":[["أشدُّ الناسِ بلاءً في الدنيا",2]," ، ",["نبيٌّ أوْ صفِيٌّ",1]],"grade":"حسن","narrator":"أزواج النبي صلى الله عليه وسلم","muhaddith":"حسن","takhrij":"أخرجه البخاري في ((التاريخ الكبير)) (8/ 115) بلفظه.","bab":"رقائق وزهد › الصبر على البلاء","dorar":"6MGHucdr"},{"id":"س-01727","fp":"304dde7c71d8","stateId":55,"easy":"إذا قوي دينك ← اشتد بلاؤك","cause":"فَمَنْ ثَخُنَ دينُهُ","result":"ثَخُنَ بَلاؤهُ","explicit":true,"ref":"المستدرك على الصحيحين 121","srcLabel":"الترمذي","text":["عنْ مُصْعَبِ بنِ سَعْدٍ، عنْ أَبيهِ قالَ: سُئِلَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: أيُّ النَّاسِ أشَدُّ بَلاءً؟ قالَ: «الأَنبياءُ، ثُمَّ الأَمْثَلُ فالأمْثَلُ، فإذا كان الرَّجُلُ صُلْبَ الدِّينِ يُبْتَلى الرَّجُلُ على قدْرِ دينِهِ، ",["فَمَنْ ثَخُنَ دينُهُ",1]," ",["ثَخُنَ بَلاؤهُ",2],"، ومَنْ ضَعُفَ دينُهُ ضَعُفَ بَلاؤهُ»."],"grade":"صحيح","narrator":"سعد","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه الترمذي (2398)، وابن ماجه (4023) باختلاف يسير.","bab":"أنبياء › عام","dorar":"vF0FrtSa","merged":2,"otherRefs":["صحيح ابن حبان 2920 (صحيح)"]},{"id":"س-05680","fp":"b38693165626","stateId":55,"easy":"إذا عظم بلاؤك ← عظم جزاؤك","cause":"عِظَمِ البلاءِ","result":"إنَّ عِظَمَ الجزاءِ","explicit":true,"otherNeedIds":[45],"ref":"الترغيب والترهيب 4/223","srcLabel":"الترمذي","text":[["إنَّ عِظَمَ الجزاءِ",2]," مع ",["عِظَمِ البلاءِ",1]," ، وإنَّ اللهَ تعالَى إذا أحبَّ قومًا ابتلاهم ، فمن رضِي فله الرِّضا ومن سخِط فله السُّخطُ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي بعد حديث (2396)، وابن ماجه (4031)","bab":"رقائق وزهد › الصبر على البلاء","dorar":"6JAtSMug","merged":2,"otherRefs":["صحيح الجامع 4013 (صحيح)"]},{"id":"س-01726","fp":"db4257f39d08","stateId":55,"easy":"إذا كنت أقرب إلى الله ديناً ← يشتد بلاؤك (الأنبياء ثم الأمثل فالأمثل)","cause":"الأنْبياءُ، ثمَّ العُلَماءُ، ثمَّ الأمثَلُ فالأمثَلُ","result":"أشَدُّ النَّاسِ بَلاءً","explicit":true,"ref":"المستدرك على الصحيحين 6/105","srcLabel":"الترمذي","text":[["أشَدُّ النَّاسِ بَلاءً",2]," ",["الأنْبياءُ، ثمَّ العُلَماءُ، ثمَّ الأمثَلُ فالأمثَلُ",1],"."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"[صحيح]","takhrij":"أخرجه الترمذي (2398)، وأحمد (1494) باختلاف يسير.","bab":"أنبياء › عام","dorar":"lWD9zIYA"},{"id":"س-04311","fp":"d105495a67f0","stateId":55,"easy":"إذا كانت لك منزلة لم تبلغها بعملك ← يبتليك الله بما تكره حتى تبلغها","cause":"فما يزالُ اللَّهُ يبتليهِ بما يكرَهُ","result":"حتَّى يُبلِّغَهُ إيَّاها","explicit":true,"similar":["س-06047","س-02831"],"otherNeedIds":[47],"ref":"الزواجر عن اقتراف الكبائر 1/164","srcLabel":"الزواجر عن اقتراف الكبائر","text":["إنَّ الرَّجُلَ ليكونُ لهُ عندَ اللَّهِ المنزلةَ فما يبلُغُها بعمَلٍ ",["فما يزالُ اللَّهُ يبتليهِ بما يكرَهُ",1]," ",["حتَّى يُبلِّغَهُ إيَّاها",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"جنة › درجات الجنة","dorar":"8HIV94HH"},{"id":"س-06047","fp":"05632ed3b124","stateId":55,"easy":"إذا كانت لك منزلة لم تبلغها بعملك ← يبتليك الله في جسدك أو مالك أو ولدك ويصبّرك حتى تبلغها","cause":"إنَّ العبدَ إذا سبقتْ له من اللهِ منزلةٌ فلم يبلُغْها بعملٍ","result":"ابتلاه اللهُ في جسدِه أو مالِه أو في ولدِه ، ثم صبر على ذلك حتى يُبلِّغَه المنزلةَ التي سبقتْ له من اللهِ عزَّ وجلَّ","explicit":true,"repOf":"س-04311","otherNeedIds":[47],"ref":"صحيح الترغيب 3409","text":[["إنَّ العبدَ إذا سبقتْ له من اللهِ منزلةٌ فلم يبلُغْها بعملٍ ؛ ",1],["ابتلاه اللهُ في جسدِه أو مالِه أو في ولدِه ، ثم صبر على ذلك حتى يُبلِّغَه المنزلةَ التي سبقتْ له من اللهِ عزَّ وجلَّ ",2],"."],"grade":"صحيح","narrator":"اللجلاج بن حكيم السلمي والد خالد","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (‌3090)، وابن أبي عاصم في ((الآحاد والمثاني)) (1416)، والدولابي في ((الكنى والأسماء)) (169) واللفظ لهم.","bab":"رقائق وزهد › فضل الصبر","dorar":"zFM46t1K"},{"id":"س-03193","fp":"49f9a3cda648","stateId":55,"easy":"إذا كنت مؤمناً ← فلا بد أن يقيّض الله لك من يؤذيك ولو كنت في جحر فأرة (فاصبر)","cause":"لو كانَ المؤمنُ في جحرِ فأرةٍ","result":"لقيَّضَ اللَّهُ لهُ فيهِ من يؤذيه","explicit":true,"ref":"مختصر المقاصد 836","srcLabel":"القضاعي","text":[["لو كانَ المؤمنُ في جحرِ فأرةٍ",1]," ",["لقيَّضَ اللَّهُ لهُ فيهِ من يؤذيه",2]],"grade":"حسن","narrator":"[علي بن أبي طالب]","muhaddith":"حسن","takhrij":"أخرجه القضاعي في ((مسند الشهاب)) (1437)","bab":"إيمان › فضل الإيمان","dorar":"INCT1tOl","merged":2,"otherRefs":["كشف الخفاء 2/211 (حسن)"]},{"id":"س-05646","fp":"f13c10823cb5","stateId":55,"easy":"إذا أحببت النبي ﷺ صادقاً ← فاستعد للفاقة والبلاء","cause":"إنِّي أُحِبُّك","result":"استِعدَّ للفاقةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 10/277","srcLabel":"البيهقي","text":["أتى النَّبيَّ صلَّى اللَّهُ عليه وسلَّم رجلٌ فقال ",["إنِّي أُحِبُّك",1]," فقال ",["استِعدَّ للفاقةِ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"رجاله رجال الصحيح غير بكر بن سليم وهو ثقة","takhrij":"أخرجه البزار (6222)، والبيهقي في ((شعب الإيمان)) (1470)","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"PGvbNq95","merged":2,"otherRefs":["السلسلة الصحيحة 2827 (حسن)"]},{"id":"س-02831","fp":"dd70fe22bc80","stateId":55,"easy":"إذا كانت لك عند الله منزلة لم تبلغها بعملك ← يبتليك ويصبّرك حتى تبلغها","cause":"إذا سَبَقتْ للعبدِ منَ اللهِ تعالى منزلةٌ لمْ ينلْها بعملِهِ","result":"ابتلاهُ اللهُ في جسدِهِ ، وفي أهلِهِ ومالهِ ، ثمَّ صبَّرَهُ على ذلكَ ، حتى ينالَ المنزلةَ التي سبقتْ لهُ منَ اللهِ عزَّ وجلَّ","explicit":true,"repOf":"س-04311","otherNeedIds":[47],"ref":"الجامع الصغير 664","text":[["إذا سَبَقتْ للعبدِ منَ اللهِ تعالى منزلةٌ لمْ ينلْها بعملِهِ ، ",1],["ابتلاهُ اللهُ في جسدِهِ ، وفي أهلِهِ ومالهِ ، ثمَّ صبَّرَهُ على ذلكَ ، حتى ينالَ المنزلةَ التي سبقتْ لهُ منَ اللهِ عزَّ وجلَّ",2]],"grade":"حسن","narrator":"اللجلاج بن حكيم السلمي والد خالد","muhaddith":"حسن","takhrij":"أخرجه أبو داود (3090)، وأحمد (22338)، والبيهقي (6619) باختلاف يسير.","bab":"إيمان › الوعد","dorar":"5hTzleLj"},{"id":"س-07202","fp":"6171a7979df6","stateId":55,"easy":"إذا كنت من الصالحين ← يشتد بلاؤك، فالأنبياء أشد الناس بلاءً ثم الأمثل","cause":"الأنبياءُ ثمَّ الصَّالِحونَ","result":"أىُّ النَّاسِ أشدُّ بلاءً","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح الأدب المفرد 395","srcLabel":"البخاري","text":["إنَّا كذلِكَ ، يَشتدُّ علينَا البَلاءُ و يُضاعفُ لنَا الأجرُ فقالَ : يا رسولَ اللهِ ! ",["أىُّ النَّاسِ أشدُّ بلاءً",2]," ؟ قالَ : ",["الأنبياءُ ثمَّ الصَّالِحونَ",1]," ، و قد كانَ أحدُهم يُبتلَى بالفَقرِ ، حتَّى ما يجِدُ إلَّا العَباءةَ يجُوبُها فيلْبسُها ، و يُبتلَى بالقُمَّلِ حتَّى يقتُلَه ، و لأحدُهُم كانَ أشدَّ فرَحًا بالبَلاءِ ، من أحدِكم بالعَطاءِ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (4024)، والبخاري في ((الأدب المفرد)) (510) واللفظ لهما، والطبري في ((تهذيب الآثار- مسند ابن عباس)) (421)، والحاكم (7848) بنحوه.","bab":"علم › حسن السؤال ونصح العالم","dorar":"SW0HxPY9","merged":2,"otherRefs":["الأحاديث المختارة 1056 (صحيح)"]},{"id":"س-07608","fp":"a4cd2fbe53c8","stateId":55,"easy":"إذا كنت من الصالحين ← يُشدَّد عليك البلاء","cause":"الصَّالِحينَ","result":"يُشدَّدُ عليهم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-03542"],"ref":"تخريج المسند لشعيب 25264","srcLabel":"متفق عليه","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ طرَقَه وَجَعٌ، فجعَلَ يَشتَكي ويَتقَلَّبُ على فِراشِهِ، فقالت عائِشةُ: لو صنَعَ هذا بَعضُنا لَوجَدتَ عليه. فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: إنَّ ",["الصَّالِحينَ",1]," ",["يُشدَّدُ عليهم",2],"، وإنَّه لا يُصيبُ مُؤمِنًا نَكبةٌ مِن شَوكةٍ، فما فَوقَ ذلك، إلَّا حُطَّتْ به عنه خَطيئةٌ، ورُفِعَ بها دَرَجةً."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (5640)، ومسلم (2572)، والترمذي (965)، والنسائي في ((السنن الكبرى)) (7487) بنحوه، وأحمد (25264) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › مرض النبي وموته","dorar":"GeFUyGGM","merged":2,"otherRefs":["صحيح الجامع 1660 (صحيح)"]},{"id":"س-03542","fp":"913df227bf15","stateId":55,"easy":"إذا كنت من المؤمنين الصالحين ← يُشدّد عليك البلاء ويُضاعف لك الأجر","cause":"المُؤمِنينَ","result":"يُشَدَّدُ عليهم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-07608","ref":"تخريج المسند لشعيب 25804","text":["أنَّ النبيَّ صلَّى اللهُ عليه وسلَّمَ طرَقَه وَجَعٌ؛ فجعَلَ يَشتَكي، ويتَقَلَّبُ على فِراشِه، فقالَتْ له عائِشةُ: لو فعَلَ هذا بَعْضُنا لَوَجِدْتَ عليه، فقال: إنَّ ",["المُؤمِنينَ",1]," ",["يُشَدَّدُ عليهم",2],"، فإنَّه ليس مِن مُؤمِنٍ تُصيبُه نَكْبةٌ؛ شَوْكةٌ، ولا وَجَعٌ، إلَّا رفَعَ اللهُ عزَّ وجلَّ له بها دَرَجةً، وحَطَّ عنه بها خَطيئَةً، أو كالذي قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (5640) مختصراً بنحوه، ومسلم (2572) بلفظ مقارب دون القصة في أوله","bab":"استغفار › مكفرات الذنوب","dorar":"oCGJ4xfm"},{"id":"ق-0167","fp":"d7f6c0629eb9","stateId":56,"easy":"الابتلاء بالقرح وتداول الأيام ← تمحيص المؤمنين ومحق الكافرين","cause":"الابتلاء بالقرح وتداول الأيام","result":"تمحيص المؤمنين ومحق الكافرين","explicit":true,"star":true,"ref":"سورة آل عمران: 141","srcLabel":"القرآن الكريم","quran":{"s":3,"from":141,"to":141,"text":"وَلِيُمَحِّصَ اللَّهُ الَّذِينَ آمَنُوا وَيَمْحَقَ الْكَافِرِينَ (141)","hl":[[0,64,1]]}},{"id":"ق-0193","fp":"48c4849d169e","stateId":56,"easy":"الإيمان ← التمييز بين الخبيث والطيب بالابتلاء","cause":"الإيمان","result":"التمييز بين الخبيث والطيب بالابتلاء","explicit":true,"star":true,"ref":"سورة آل عمران: 179","srcLabel":"القرآن الكريم","quran":{"s":3,"from":179,"to":179,"text":"مَا كَانَ اللَّهُ لِيَذَرَ الْمُؤْمِنِينَ عَلَى مَا أَنْتُمْ عَلَيْهِ حَتَّى يَمِيزَ الْخَبِيثَ مِنَ الطَّيِّبِ وَمَا كَانَ اللَّهُ لِيُطْلِعَكُمْ عَلَى الْغَيْبِ وَلَكِنَّ اللَّهَ يَجْتَبِي مِنْ رُسُلِهِ مَنْ يَشَاءُ فَآمِنُوا بِاللَّهِ وَرُسُلِهِ وَإِنْ تُؤْمِنُوا وَتَتَّقُوا فَلَكُمْ أَجْرٌ عَظِيمٌ (179)","hl":[[0,111,1]]}},{"id":"ق-0439","fp":"15a126204232","stateId":56,"easy":"الابتلاء بالحسنات والسيئات ← غايته الرجوع إلى الله","cause":"الابتلاء بالحسنات والسيئات","result":"غايته الرجوع إلى الله","explicit":true,"star":true,"ref":"سورة الأعراف: 168","srcLabel":"القرآن الكريم","quran":{"s":7,"from":168,"to":168,"text":"وَقَطَّعْنَاهُمْ فِي الْأَرْضِ أُمَمًا مِنْهُمُ الصَّالِحُونَ وَمِنْهُمْ دُونَ ذَلِكَ وَبَلَوْنَاهُمْ بِالْحَسَنَاتِ وَالسَّيِّئَاتِ لَعَلَّهُمْ يَرْجِعُونَ (168)","hl":[[86,156,1]]}},{"id":"ق-0788","fp":"01d9b4afc914","stateId":56,"easy":"الابتلاء بالشر والخير ← فتنة واختبار ثم الرجوع إلى الله","cause":"الابتلاء بالشر والخير","result":"فتنة واختبار ثم الرجوع إلى الله","explicit":true,"star":true,"ref":"سورة الأنبياء: 35","srcLabel":"القرآن الكريم","quran":{"s":21,"from":35,"to":35,"text":"كُلُّ نَفْسٍ ذَائِقَةُ الْمَوْتِ وَنَبْلُوكُمْ بِالشَّرِّ وَالْخَيْرِ فِتْنَةً وَإِلَيْنَا تُرْجَعُونَ (35)","hl":[[33,102,1]]}},{"id":"ق-0933","fp":"56e55432e0e2","stateId":56,"easy":"دعوى الإيمان ← الفتنة والاختبار ليُعلم الصادق من الكاذب","cause":"دعوى الإيمان","result":"الفتنة والاختبار ليُعلم الصادق من الكاذب","explicit":true,"ref":"سورة العنكبوت: 2–3","srcLabel":"القرآن الكريم","quran":{"s":29,"from":2,"to":3,"text":"أَحَسِبَ النَّاسُ أَنْ يُتْرَكُوا أَنْ يَقُولُوا آمَنَّا وَهُمْ لَا يُفْتَنُونَ (2) وَلَقَدْ فَتَنَّا الَّذِينَ مِنْ قَبْلِهِمْ فَلَيَعْلَمَنَّ اللَّهُ الَّذِينَ صَدَقُوا وَلَيَعْلَمَنَّ الْكَاذِبِينَ (3)","hl":[[0,200,1]]}},{"id":"ق-1221","fp":"39e00d904bac","stateId":56,"easy":"الجهاد والصبر عند الابتلاء ← ظهور صدق المجاهدين والصابرين","cause":"الجهاد والصبر عند الابتلاء","result":"ظهور صدق المجاهدين والصابرين","explicit":true,"ref":"سورة محمد: 31","srcLabel":"القرآن الكريم","quran":{"s":47,"from":31,"to":31,"text":"وَلَنَبْلُوَنَّكُمْ حَتَّى نَعْلَمَ الْمُجَاهِدِينَ مِنْكُمْ وَالصَّابِرِينَ وَنَبْلُوَ أَخْبَارَكُمْ (31)","hl":[[0,76,1]]}},{"id":"ق-1361","fp":"4407e82f4b91","stateId":56,"easy":"إحسان العمل ← الفوز في ابتلاء الحياة والموت","cause":"إحسان العمل","result":"الفوز في ابتلاء الحياة والموت","explicit":true,"otherNeedIds":[45],"ref":"سورة الملك: 2","srcLabel":"القرآن الكريم","quran":{"s":67,"from":2,"to":2,"text":"الَّذِي خَلَقَ الْمَوْتَ وَالْحَيَاةَ لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ عَمَلًا وَهُوَ الْعَزِيزُ الْغَفُورُ (2)","hl":[[0,79,1]]}},{"id":"س-07911","fp":"4db440ec81fd","stateId":57,"easy":"إذا أراد الله بك خيراً ← يعجّل لك عقوبة ذنبك في الدنيا","cause":"عجَّل له عقوبةَ ذنبِه","result":"إذا أراد اللهُ بعبدٍ خيرًا","explicit":true,"otherNeedIds":[55],"ref":"مجمع الزوائد 10/194","srcLabel":"أحمد","text":["أنَّ رجلًا لقِيَ امرأةً كانت بغِيًّا في الجاهليَّةِ فجعَل يُلاعِبُها حتَّى بسَط يدَه إليها فقالت مَهْ فإنَّ اللهَ عَزَّ وجَلَّ قد أذهَب الشِّرْكَ قال عفَّانُ مرَّةً ذهَب بالجاهليَّةِ وجاء بالإسلامِ فولَّى الرَّجلُ فأصاب وجهَه الحائطُ فشَجَّه ثمَّ أتى النَّبيَّ صلَّى اللهُ عليه وسلَّم فأخبَره فقال أنت عبدٌ أراد اللهُ بك خيرًا ",["إذا أراد اللهُ بعبدٍ خيرًا",2]," ",["عجَّل له عقوبةَ ذنبِه",1]," وإذا أراد بعبدٍ شَرًّا أمسَك عليه بذنبِه حتَّى يُوافِيَ به يومَ القيامةِ كأنَّه عَيرٌ[ وفي روايةٍ ] قال بينما نحن مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّم وهو يبايعُ تحتَ الشَّجرةِ وإنِّي لرافِعٌ أغصانَها عن رأسِه إذ جاء رجلٌ يَسيلُ وجهُه دمًا فقال يا رسولَ اللهِ هلَكْتُ وقال وما أهلَكَك قال إنِّي خرَجْتُ مِن منزلي فإذا امرأةٌ أتبَعْتُها بصري فأصاب وجهي الجدارُ فأصابني ما ترى"],"grade":"صحيح","narrator":"عبدالله بن مغفل","muhaddith":"الأولى رجاله رجال الصحيح وكذلك أحد إسنادي الثانية","takhrij":"أخرجه أحمد (16806)، وابن حبان (2911)، والحاكم (1291) باختلاف يسير. والرواية: أخرجها الطبراني كما في ((مجمع الزوائد)) (10/194)","bab":"مريض › فضل المرض والنوائب","dorar":"L9OghXVt","merged":4,"otherRefs":["مجمع الزوائد 10/195 (حسن)","تخريج الإحياء للعراقي 4/162 (صحيح)","فتح الباري لابن حجر 7/730 (صحيح)"]},{"id":"س-05465","fp":"9a20443314a9","stateId":57,"easy":"إذا أصابك في الدنيا ما تكره ← فهو جزاء مثاقيل الشر، ويُدّخر لك الخير في الآخرة","cause":"ما ترى في الدُّنيا ممَّا تَكرَهُ","result":"مثاقيلُ ذَرَّةٍ مِن شَرٍّ، ويُدَّخَرُ لك مثاقيلُ ذَرٍّ مِنَ الخَيرِ حتَّى تُوَفَّاه يومَ القيامةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"otherNeedIds":[11],"ref":"الأحاديث المختارة 2245","srcLabel":"البخاري","text":["«بينا أبو بَكرٍ يأكُلُ مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم طعامًا إذ نزَلَت عليه هذه الآيةُ {فَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُ * وَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُ} قال: فرفع أبو بَكرٍ يَدَه، قال: فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ما لك؟ قال: يا رَسولَ اللهِ، إنِّي لراءٍ ما عَمِلْتُ مِن مثقالِ ذَرَّةٍ مِن شَرٍّ؟ قال: يا أبا بكرٍ، أرأيتَ ",["ما ترى في الدُّنيا ممَّا تَكرَهُ",1]," ",["مثاقيلُ ذَرَّةٍ مِن شَرٍّ، ويُدَّخَرُ لك مثاقيلُ ذَرٍّ مِنَ الخَيرِ حتَّى تُوَفَّاه يومَ القيامةِ",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"رقائق وزهد › الخوف من الله","dorar":"BNVwuGRp"},{"id":"س-03495","fp":"8e690052b243","stateId":57,"easy":"إذا كثرت ذنوبك ولم يكن لك من العمل ما يكفّرها ← يبتليك الله بالحزن ليكفّرها عنك","cause":"إذا كثرتْ ذنوبُ العبدٍ ، فلمْ يكنْ لهُ من العملِ ما يكفرُها","result":"ابتلاهُ اللهُ بالحزنِ ، ليكفرَها عنهُ","explicit":true,"otherNeedIds":[11],"ref":"الجامع الصغير 832","srcLabel":"البزار","text":[["إذا كثرتْ ذنوبُ العبدٍ ، فلمْ يكنْ لهُ من العملِ ما يكفرُها ",1],["ابتلاهُ اللهُ بالحزنِ ، ليكفرَها عنهُ",2]],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"حسن","takhrij":"أخرجه البزار (255)، وابن ـأبي الدنيا في ((الهم والحزن)) (3)، وأبو نعيم في ((تاريخ أصبهان)) (2/ 159) باختلاف يسير.","bab":"استغفار › مكفرات الذنوب","dorar":"uzNx5coz"},{"id":"س-06838","fp":"28e0ef8bc526","stateId":57,"easy":"إذا أصابك بلاء في الدنيا بذنبك ← فالله أكرم من أن يعاقبك عليه مرة أخرى في الآخرة","cause":"ما أصابكم من مرضٍ أو عقوبةٍ أو بلاءٍ في الدنيا فبما كسبت أيديكم","result":"واللهُ تعالى أكرمُ من أن يُثَنِّي عليهم العقوبةَ في الآخرةِ وما عفا اللهُ تعالى عنهُ في الدنيا فاللهُ تعالى أحلمُ من أن يعودَ بعد عفوِهِ","explicit":true,"otherNeedIds":[11],"ref":"تخريج المسند لشاكر 2/61","srcLabel":"أحمد","text":["ألا أُخبركم بأفضلِ آيةٍ في كتابِ اللهِ تعالى حدَّثنا بها رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ما أصابكم من مصيبةٍ فبما كسبت أيديكم ويعفو عن كثيرٍ وسأُفَسِّرُها لك يا عليُّ ",["ما أصابكم من مرضٍ أو عقوبةٍ أو بلاءٍ في الدنيا فبما كسبت أيديكم",1]," ",["واللهُ تعالى أكرمُ من أن يُثَنِّي عليهم العقوبةَ في الآخرةِ وما عفا اللهُ تعالى عنهُ في الدنيا فاللهُ تعالى أحلمُ من أن يعودَ بعد عفوِهِ",2]],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (1/ 85) واللفظ له، وأبو يعلى (1/ 453)، والدولابي في ((الكنى والأسماء)) (2/ 574).","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"5N5SaHnP"}]}