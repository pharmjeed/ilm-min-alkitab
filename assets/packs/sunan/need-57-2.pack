{"schema":1,"kind":"sunan-chunk","version":"sunan-b53213585e2f","needId":57,"stateIds":[589,590,591,592,593,594,595,596,597,598,599,600,601,602,603,604,605],"items":[{"id":"س-05529","fp":"ae3d34ba70c3","stateId":589,"easy":"إذا كنزت المال ← تُكوى برضف من نار جهنم","cause":"الكانِزينَ","result":"برَضفٍ يُحمى عليه في نارِ جَهَنَّمَ، ثُمَّ يوضَعُ على حَلَمةِ ثَديِ أحَدِهم حتَّى يَخرُجَ مِن نُغضِ كَتِفِه، ويوضَعُ على نُغضِ كَتِفِه حتَّى يَخرُجَ مِن حَلَمةِ ثَديِه، يَتَزَلزَلُ","explicit":true,"star":true,"ref":"صحيح البخاري 1408","srcLabel":"مسلم","text":["جَلَستُ إلى مَلَإٍ مِن قُرَيشٍ، فجاءَ رَجُلٌ خَشِنُ الشَّعَرِ والثِّيابِ والهَيئةِ، حتَّى قامَ عليهم فسَلَّمَ، ثُمَّ قال: بَشِّرِ ",["الكانِزينَ",1]," ",["برَضفٍ يُحمى عليه في نارِ جَهَنَّمَ، ثُمَّ يوضَعُ على حَلَمةِ ثَديِ أحَدِهم حتَّى يَخرُجَ مِن نُغضِ كَتِفِه، ويوضَعُ على نُغضِ كَتِفِه حتَّى يَخرُجَ مِن حَلَمةِ ثَديِه، يَتَزَلزَلُ",2],"، ثُمَّ ولَّى، فجَلَسَ إلى ساريةٍ، وتَبِعتُه وجَلَستُ إليه وأنا لا أدري مَن هو؟ فقُلتُ له: لا أُرى القَومَ إلَّا قد كَرِهوا الذي قُلتَ، قال: إنَّهم لا يَعقِلونَ شيئًا، قال لي خَليلي، قال: قُلتُ: مَن خَليلُكَ؟ قال النَّبيُّ صلَّى اللهُ عليه وسلَّم: يا أبا ذَرٍّ، أتُبصِرُ أُحُدًا؟ قال: فنَظَرتُ إلى الشَّمسِ ما بَقيَ مِنَ النَّهارِ، وأنا أُرى أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يُرسِلُني في حاجةٍ له، قُلتُ: نَعَم، قال: ما أُحِبُّ أنَّ لي مِثلَ أُحُدٍ ذَهَبًا، أُنفِقُه كُلَّه، إلَّا ثَلاثةَ دَنانيرَ، وإنَّ هؤلاء لا يَعقِلونَ، إنَّما يَجمَعونَ الدُّنيا، لا واللهِ لا أسألُهم دُنيا، ولا أستَفتيهم عن دينٍ، حتَّى ألقى اللهَ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (992) مطولاً باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"cacHzxPr","merged":5,"otherRefs":["تخريج المسند لشعيب 21485 (صحيح)","صحيح مسلم 992 (صحيح)","تاريخ الإسلام 3/410 (صحيح)"]},{"id":"س-03021","fp":"d757bf069d41","stateId":589,"easy":"إذا مت وتركت كنزاً لم تؤد حقه ← يأتي يوم القيامة شجاعاً أقرع يطوقك","cause":"مَن قال في عبادِ اللهِ هكذا وهكذا وهكذا، وقليلٌ ما هُم، ما من رَجُلٍ يموتُ فيَترُكُ غَنمًا، أو إبلًا، أو بَقرًا لم يُؤَدِّ زَكاتَها","result":"إلَّا جاءَتْ يومَ القِيامةِ أعظَمَ ما تكونُ وأسمَنَ، حتى تَطأَهُ بأظلافِها، وتَنطَحَه بقُرونِها، حتى يُقْضى بينَ الناسِ، ثُم تَعودُ أُولَاها على أُخْراها","explicit":true,"star":true,"similar":["س-02960","س-05073","س-06144","س-06155","س-05161","س-06148","س-06157","س-07438","س-07473","س-06145"],"ref":"تخريج المسند لشعيب 21351","srcLabel":"متفق عليه","text":["أتَيْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ وهو في ظِلِّ الكَعبةِ، فقال: همُ الأخسَرونَ ورَبِّ الكَعبةِ، همُ الأخسَرونَ ورَبِّ الكَعبةِ، فأخَذَني غَمٌّ وجعَلْتُ أتنَفَّسُ، قال: قُلْتُ: هذا شَرُّ حدَثَ فيَّ، قال: قُلْتُ: مَن هُم فِداكَ أبي وأُمِّي؟ قال: الأكثَرونَ، إلَّا ",["مَن قال في عبادِ اللهِ هكذا وهكذا وهكذا، وقليلٌ ما هُم، ما من رَجُلٍ يموتُ فيَترُكُ غَنمًا، أو إبلًا، أو بَقرًا لم يُؤَدِّ زَكاتَها؛ ",1],["إلَّا جاءَتْ يومَ القِيامةِ أعظَمَ ما تكونُ وأسمَنَ، حتى تَطأَهُ بأظلافِها، وتَنطَحَه بقُرونِها، حتى يُقْضى بينَ الناسِ، ثُم تَعودُ أُولَاها على أُخْراها",2],"، وقال ابنُ نُمَيرٍ: كلَّما نَفِدَتْ أُخْراها عادَتْ عليه أُولاها."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6638)، ومسلم (990)، والترمذي (617)، والنسائي (2440)، وأحمد (21351) واللفظ له","bab":"إيمان › الوعيد","dorar":"BkA0OGrD","merged":3,"otherRefs":["صحيح الترمذي 617 (صحيح)","حلية الأولياء 7/421 (صحيح)"]},{"id":"س-06282","fp":"79b074d94c77","stateId":589,"easy":"إذا كنت صاحب إبل أو بقر أو غنم لا تؤدي زكاتها ← تأتي يوم القيامة أعظم ما كانت فتطؤك","cause":"ما مِن صاحِبِ إبِلٍ ولا بَقَرٍ ولا غَنَمٍ لا يُؤَدِّي زَكاتَها","result":"إلَّا جاءَت يَومَ القيامةِ أعظَمَ ما كانَت وأسمَنَه، تَنطَحُه بقُرونِها وتَطَؤُه بأظلافِها، كُلَّما نَفِدَت أُخراها عادَت عليه أُولاها، حتَّى يُقضى بينَ النَّاسِ","explicit":true,"star":true,"similar":["س-05192"],"ref":"صحيح مسلم 990","srcLabel":"البخاري","text":["انتَهَيتُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم وهو جالِسٌ في ظِلِّ الكَعبةِ، فلَمَّا رَآني قال: هُمُ الأخسَرونَ ورَبِّ الكَعبةِ! قال: فجِئتُ حتَّى جَلَستُ، فلَم أتَقارَّ أن قُمتُ فقُلتُ: يا رَسولَ اللهِ، فِداكَ أبي وأُمِّي، مَن هُم؟ قال: هُمُ الأكثَرونَ أموالًا، إلَّا مَن قال هَكَذا وهَكَذا وهَكَذا، مِن بينَ يَدَيه ومِن خَلفِه وعَن يَمينِه وعَن شِمالِه، وقَليلٌ ما هُم، ",["ما مِن صاحِبِ إبِلٍ ولا بَقَرٍ ولا غَنَمٍ لا يُؤَدِّي زَكاتَها",1]," ",["إلَّا جاءَت يَومَ القيامةِ أعظَمَ ما كانَت وأسمَنَه، تَنطَحُه بقُرونِها وتَطَؤُه بأظلافِها، كُلَّما نَفِدَت أُخراها عادَت عليه أُولاها، حتَّى يُقضى بينَ النَّاسِ",2],". [وفي روايةٍ]: انتَهَيتُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم وهو جالِسٌ في ظِلِّ الكَعبةِ، فذَكَرَ نَحوَ حَديثِ وكيعٍ، غيرَ أنَّه قال: والذي نَفسي بيَدِه ما على الأرضِ رَجُلٌ يَموتُ فيَدَعُ إبِلًا أو بَقَرًا أو غَنَمًا لَم يُؤَدِّ زَكاتَها."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1460) باختلاف يسير","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"idPGCs5y","merged":3,"otherRefs":["صحيح البخاري 1460 (صحيح)","صحيح مسلم 988 (صحيح)"]},{"id":"س-07402","fp":"54e631b2cdbc","stateId":589,"easy":"إذا ضربت الناس بالسياط ظلماً أو كنت كاسية عارية ← فأنت من صنفي أهل النار","cause":"قومٌ مَعَهُمْ سِياطٌ كَأَذْنابِ البَقَرِ يَضْرِبُونَ الناسَ بِها ، ونِساءٌ كَاسِياتٌ عَارِياتٌ ، مُمِيلاتٌ مائِلاتٌ ، رُؤوسُهُنَّ كَأَسْنِمَةِ البُخْتِ المائِلَةِ ، لا يَدْخُلَنَّ الجنةَ ، ولا يَجِدَنَّ رِيحَها ، وإِنَّ رِيحَها لَيوجَدُ من مَسِيرَةِ كذا وكذا","result":"صِنْفَانِ من أهلِ النارِ لمْ أَرَهُما بَعْدُ","explicit":true,"star":true,"otherNeedIds":[58],"ref":"صحيح الجامع 3799","srcLabel":"مسلم","text":[["صِنْفَانِ من أهلِ النارِ لمْ أَرَهُما بَعْدُ ",2],":",[" قومٌ مَعَهُمْ سِياطٌ كَأَذْنابِ البَقَرِ يَضْرِبُونَ الناسَ بِها ، ونِساءٌ كَاسِياتٌ عَارِياتٌ ، مُمِيلاتٌ مائِلاتٌ ، رُؤوسُهُنَّ كَأَسْنِمَةِ البُخْتِ المائِلَةِ ، لا يَدْخُلَنَّ الجنةَ ، ولا يَجِدَنَّ رِيحَها ، وإِنَّ رِيحَها لَيوجَدُ من مَسِيرَةِ كذا وكذا",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2128) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"JRFbgv3d","merged":4,"otherRefs":["تخريج المسند لشعيب 9680 (صحيح)","مجموع الفتاوى 34/129 (صحيح)","تخريج صحيح ابن حبان 7461 (صحيح)"]},{"id":"س-07743","fp":"8a5486bf62dd","stateId":589,"easy":"إذا كنت صاحب إبل لا تؤدي زكاتها ← يُبطح لها بقاع قرقر فتطؤك","cause":"وما مِن صاحِبِ إبِلٍ لا يُؤَدِّي زَكاتَها","result":"إلَّا بُطِحَ لها بقاعٍ قَرقَرٍ كَأوفَرِ ما كانَت تَستَنُّ عليه، كُلَّما مَضى عليه أُخراها رُدَّت عليه أولاها، حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ","explicit":true,"star":true,"similar":["س-07744"],"ref":"صحيح مسلم 987","srcLabel":"مسلم","text":["ما مِن صاحِبِ كَنزٍ لا يُؤَدِّي زَكاتَه إلَّا أُحميَ عليه في نارِ جَهَنَّمَ، فيُجعَلُ صَفائِحَ، فيُكوى بها جَنباه وجَبينُه حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ، ",["وما مِن صاحِبِ إبِلٍ لا يُؤَدِّي زَكاتَها",1]," ",["إلَّا بُطِحَ لها بقاعٍ قَرقَرٍ كَأوفَرِ ما كانَت تَستَنُّ عليه، كُلَّما مَضى عليه أُخراها رُدَّت عليه أولاها، حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ",2],"، وما مِن صاحِبِ غَنَمٍ لا يُؤَدِّي زَكاتَها إلَّا بُطِحَ لها بقاعٍ قَرقَرٍ كَأوفَرِ ما كانَت فتَطَؤُه بأظلافِها وتَنطَحُه بقُرونِها، ليس فيها عَقصاءُ ولا جَلحاءُ، كُلَّما مَضى عليه أُخراها رُدَّت عليه أولاها، حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ ممَّا تَعُدُّونَ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ. قال سُهَيلٌ: فلا أدري أذَكَرَ البَقَرَ أم لا، قالوا: فالخَيلُ؟ يا رَسولَ اللهِ، قال: الخَيلُ في نَواصيها -أو قال، الخَيلُ مَعقودٌ في نَواصيها. قال سُهَيلٌ: أنا أشُكُّ- الخَيرُ إلى يَومِ القيامةِ، الخَيلُ ثَلاثةٌ: فهي لرَجُلٍ أجرٌ، ولرَجُلٍ سِترٌ، ولرَجُلٍ وِزرٌ؛ فأمَّا التي هي له أجرٌ: فالرَّجُلُ يَتَّخِذُها في سَبيلِ اللهِ ويُعِدُّها له، فلا تُغَيِّبُ شيئًا في بُطونِها إلَّا كَتَبَ اللهُ له أجرًا، ولو رَعاها في مَرجٍ، ما أكَلَت مِن شيءٍ إلَّا كَتَبَ اللهُ له بها أجرًا، ولو سَقاها مِن نَهرٍ، كانَ له بكُلِّ قَطرةٍ تُغَيِّبُها في بُطونِها أجرٌ، حتَّى ذَكَرَ الأجرَ في أبوالِها وأرواثِها، ولَوِ استَنَّت شَرَفًا أو شَرَفَينِ، كُتِبَ له بكُلِّ خُطوةٍ تَخطوها أجرٌ، وأمَّا الذي هي له سِترٌ: فالرَّجُلُ يَتَّخِذُها تَكَرُّمًا وتَجَمُّلًا، ولا يَنسى حَقَّ ظُهورِها وبُطونِها في عُسرِها ويُسرِها، وأمَّا الذي عليه وِزرٌ فالذي يَتَّخِذُها أشَرًا وبَطَرًا وبَذَخًا ورياءَ النَّاسِ، فذاك الذي هي عليه وِزرٌ، قالوا: فالحُمُرُ يا رَسولَ اللهِ؟ قال: ما أنزَلَ اللهُ عليَّ فيها شيئًا إلَّا هذه الآيةَ الجامِعةَ الفاذَّةَ: {فمَنْ يَعمَلْ مِثقالَ ذَرَّةٍ خَيرًا يَرَهُ * ومَن يَعمَلْ مِثقالَ ذَرَّةٍ شَرًّا يَرَهُ} [الزلزلة: 7-8]. [وفي روايةٍ]: بَدَلَ عَقصاءُ: عَضباءُ، وقال: فيُكوى بها جَنبُه وظَهرُه، ولَم يَذكُرْ: جَبينُه. [وفي روايةٍ]: إذا لَم يُؤَدِّ المَرءُ حَقَّ اللهِ، أوِ الصَّدَقةَ في إبِلِه، وساقَ الحَديثَ بنَحوِ حَديثِ سُهَيلٍ عن أبيه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (987) مطولاً","bab":"قرآن › أسباب النزول","dorar":"1IlMX4Z5","merged":4,"otherRefs":["تخريج المسند لشعيب 8977 (صحيح)","تخريج المسند لشعيب 7563 (صحيح)","صحيح مسلم 987 (صحيح)"]},{"id":"س-07744","fp":"a8560adf7618","stateId":589,"easy":"إذا كنت صاحب غنم لا تؤدي زكاتها ← يُبطح لها بقاع قرقر فتطؤك وتنطحك","cause":"وما مِن صاحِبِ غَنَمٍ لا يُؤَدِّي زَكاتَها","result":"إلَّا بُطِحَ لها بقاعٍ قَرقَرٍ كَأوفَرِ ما كانَت فتَطَؤُه بأظلافِها وتَنطَحُه بقُرونِها، ليس فيها عَقصاءُ ولا جَلحاءُ، كُلَّما مَضى عليه أُخراها رُدَّت عليه أولاها، حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ ممَّا تَعُدُّونَ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ","explicit":true,"repOf":"س-07743","ref":"صحيح مسلم 987","text":["ما مِن صاحِبِ كَنزٍ لا يُؤَدِّي زَكاتَه إلَّا أُحميَ عليه في نارِ جَهَنَّمَ، فيُجعَلُ صَفائِحَ، فيُكوى بها جَنباه وجَبينُه حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ، وما مِن صاحِبِ إبِلٍ لا يُؤَدِّي زَكاتَها إلَّا بُطِحَ لها بقاعٍ قَرقَرٍ كَأوفَرِ ما كانَت تَستَنُّ عليه، كُلَّما مَضى عليه أُخراها رُدَّت عليه أولاها، حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ، ",["وما مِن صاحِبِ غَنَمٍ لا يُؤَدِّي زَكاتَها",1]," ",["إلَّا بُطِحَ لها بقاعٍ قَرقَرٍ كَأوفَرِ ما كانَت فتَطَؤُه بأظلافِها وتَنطَحُه بقُرونِها، ليس فيها عَقصاءُ ولا جَلحاءُ، كُلَّما مَضى عليه أُخراها رُدَّت عليه أولاها، حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ ممَّا تَعُدُّونَ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ",2],". قال سُهَيلٌ: فلا أدري أذَكَرَ البَقَرَ أم لا، قالوا: فالخَيلُ؟ يا رَسولَ اللهِ، قال: الخَيلُ في نَواصيها -أو قال، الخَيلُ مَعقودٌ في نَواصيها. قال سُهَيلٌ: أنا أشُكُّ- الخَيرُ إلى يَومِ القيامةِ، الخَيلُ ثَلاثةٌ: فهي لرَجُلٍ أجرٌ، ولرَجُلٍ سِترٌ، ولرَجُلٍ وِزرٌ؛ فأمَّا التي هي له أجرٌ: فالرَّجُلُ يَتَّخِذُها في سَبيلِ اللهِ ويُعِدُّها له، فلا تُغَيِّبُ شيئًا في بُطونِها إلَّا كَتَبَ اللهُ له أجرًا، ولو رَعاها في مَرجٍ، ما أكَلَت مِن شيءٍ إلَّا كَتَبَ اللهُ له بها أجرًا، ولو سَقاها مِن نَهرٍ، كانَ له بكُلِّ قَطرةٍ تُغَيِّبُها في بُطونِها أجرٌ، حتَّى ذَكَرَ الأجرَ في أبوالِها وأرواثِها، ولَوِ استَنَّت شَرَفًا أو شَرَفَينِ، كُتِبَ له بكُلِّ خُطوةٍ تَخطوها أجرٌ، وأمَّا الذي هي له سِترٌ: فالرَّجُلُ يَتَّخِذُها تَكَرُّمًا وتَجَمُّلًا، ولا يَنسى حَقَّ ظُهورِها وبُطونِها في عُسرِها ويُسرِها، وأمَّا الذي عليه وِزرٌ فالذي يَتَّخِذُها أشَرًا وبَطَرًا وبَذَخًا ورياءَ النَّاسِ، فذاك الذي هي عليه وِزرٌ، قالوا: فالحُمُرُ يا رَسولَ اللهِ؟ قال: ما أنزَلَ اللهُ عليَّ فيها شيئًا إلَّا هذه الآيةَ الجامِعةَ الفاذَّةَ: {فمَنْ يَعمَلْ مِثقالَ ذَرَّةٍ خَيرًا يَرَهُ * ومَن يَعمَلْ مِثقالَ ذَرَّةٍ شَرًّا يَرَهُ} [الزلزلة: 7-8]. [وفي روايةٍ]: بَدَلَ عَقصاءُ: عَضباءُ، وقال: فيُكوى بها جَنبُه وظَهرُه، ولَم يَذكُرْ: جَبينُه. [وفي روايةٍ]: إذا لَم يُؤَدِّ المَرءُ حَقَّ اللهِ، أوِ الصَّدَقةَ في إبِلِه، وساقَ الحَديثَ بنَحوِ حَديثِ سُهَيلٍ عن أبيه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (987) مطولاً","bab":"قرآن › أسباب النزول","dorar":"1IlMX4Z5","merged":4,"otherRefs":["تخريج المسند لشعيب 8977 (صحيح)","تخريج المسند لشعيب 7563 (صحيح)","صحيح مسلم 987 (صحيح)"]},{"id":"س-03024","fp":"aeaead7d2533","stateId":589,"easy":"إذا خنقت نفسك ← تخنق نفسك في النار","cause":"الذي يخنُقُ نفْسَهُ","result":"يخنُقُ نفْسَهُ في النَّارِ","explicit":true,"ref":"تخريج مشكل الآثار 195","srcLabel":"البخاري","text":[["الذي يخنُقُ نفْسَهُ",1]," ",["يخنُقُ نفْسَهُ في النَّارِ",2],"، والذي يقتحِمُ نفْسَهُ يقتحِمُ نفْسَهُ في النَّارِ، والذي يطعُنُ نفْسَهُ يطعُنُ نفْسَهُ في النَّارِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (1365) باختلاف يسير دون قوله: \"والذي يقتحم نفسه يقتحم نفسه في النار\"","bab":"إيمان › الوعيد","dorar":"2M0dsz66","merged":2,"otherRefs":["صحيح الجامع 5494 (صحيح)"]},{"id":"س-06137","fp":"e78df74075b7","stateId":589,"easy":"إذا تركت بعدك كنزاً ← يُمثّل لك يوم القيامة شجاعاً أقرع يتبعك","cause":"مَن تَرَك بَعدَه كَنزًا","result":"مُثِّل له يَومَ القِيامةِ شُجاعًا أقرَعَ له زَبيبَتانِ يُتْبِعُ فاه، فيَقولُ: وَيلَكَ! ما لَكَ؟ فيَقولُ: أنا كَنزُكَ الَّذي تَرَكْتَه بَعدَكَ، فلا يَزالُ يَتبَعُه حتَّى يُلقِمَه يَدَه، فيَقضَمُها، ثمَّ يُتبِعُه سائرَ جَسَدِه","explicit":true,"similar":["س-06135"],"ref":"المستدرك على الصحيحين 1452","srcLabel":"مسلم","text":[["مَن تَرَك بَعدَه كَنزًا",1]," ",["مُثِّل له يَومَ القِيامةِ شُجاعًا أقرَعَ له زَبيبَتانِ يُتْبِعُ فاه، فيَقولُ: وَيلَكَ! ما لَكَ؟ فيَقولُ: أنا كَنزُكَ الَّذي تَرَكْتَه بَعدَكَ، فلا يَزالُ يَتبَعُه حتَّى يُلقِمَه يَدَه، فيَقضَمُها، ثمَّ يُتبِعُه سائرَ جَسَدِه",2],"."],"grade":"صحيح","narrator":"ثوبان","muhaddith":"صحيح على شرط مسلم، وله شاهد صحيح على شرط مسلم","bab":"زكاة › عقوبة مانع الزكاة","dorar":"HG3O8Mr1","merged":3,"otherRefs":["مختصر زوائد البزار 1/371 (صحيح)","صحيح الموارد 668 (صحيح)"]},{"id":"س-07742","fp":"c5ecb114da0b","stateId":589,"easy":"إذا كنت صاحب كنز لا تؤدي زكاته ← يُحمى عليك في نار جهنم فيُجعل صفائح يُكوى بها جنبك","cause":"ما مِن صاحِبِ كَنزٍ لا يُؤَدِّي زَكاتَه","result":"إلَّا أُحميَ عليه في نارِ جَهَنَّمَ، فيُجعَلُ صَفائِحَ، فيُكوى بها جَنباه وجَبينُه حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ","explicit":true,"similar":["س-07739","س-03887","س-03897"],"ref":"صحيح مسلم 987","srcLabel":"مسلم","text":[["ما مِن صاحِبِ كَنزٍ لا يُؤَدِّي زَكاتَه",1]," ",["إلَّا أُحميَ عليه في نارِ جَهَنَّمَ، فيُجعَلُ صَفائِحَ، فيُكوى بها جَنباه وجَبينُه حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ،",2]," وإمَّا إلى النَّارِ، وما مِن صاحِبِ إبِلٍ لا يُؤَدِّي زَكاتَها إلَّا بُطِحَ لها بقاعٍ قَرقَرٍ كَأوفَرِ ما كانَت تَستَنُّ عليه، كُلَّما مَضى عليه أُخراها رُدَّت عليه أولاها، حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ، وما مِن صاحِبِ غَنَمٍ لا يُؤَدِّي زَكاتَها إلَّا بُطِحَ لها بقاعٍ قَرقَرٍ كَأوفَرِ ما كانَت فتَطَؤُه بأظلافِها وتَنطَحُه بقُرونِها، ليس فيها عَقصاءُ ولا جَلحاءُ، كُلَّما مَضى عليه أُخراها رُدَّت عليه أولاها، حتَّى يَحكُمَ اللهُ بينَ عِبادِه، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ ممَّا تَعُدُّونَ، ثُمَّ يَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ. قال سُهَيلٌ: فلا أدري أذَكَرَ البَقَرَ أم لا، قالوا: فالخَيلُ؟ يا رَسولَ اللهِ، قال: الخَيلُ في نَواصيها -أو قال، الخَيلُ مَعقودٌ في نَواصيها. قال سُهَيلٌ: أنا أشُكُّ- الخَيرُ إلى يَومِ القيامةِ، الخَيلُ ثَلاثةٌ: فهي لرَجُلٍ أجرٌ، ولرَجُلٍ سِترٌ، ولرَجُلٍ وِزرٌ؛ فأمَّا التي هي له أجرٌ: فالرَّجُلُ يَتَّخِذُها في سَبيلِ اللهِ ويُعِدُّها له، فلا تُغَيِّبُ شيئًا في بُطونِها إلَّا كَتَبَ اللهُ له أجرًا، ولو رَعاها في مَرجٍ، ما أكَلَت مِن شيءٍ إلَّا كَتَبَ اللهُ له بها أجرًا، ولو سَقاها مِن نَهرٍ، كانَ له بكُلِّ قَطرةٍ تُغَيِّبُها في بُطونِها أجرٌ، حتَّى ذَكَرَ الأجرَ في أبوالِها وأرواثِها، ولَوِ استَنَّت شَرَفًا أو شَرَفَينِ، كُتِبَ له بكُلِّ خُطوةٍ تَخطوها أجرٌ، وأمَّا الذي هي له سِترٌ: فالرَّجُلُ يَتَّخِذُها تَكَرُّمًا وتَجَمُّلًا، ولا يَنسى حَقَّ ظُهورِها وبُطونِها في عُسرِها ويُسرِها، وأمَّا الذي عليه وِزرٌ فالذي يَتَّخِذُها أشَرًا وبَطَرًا وبَذَخًا ورياءَ النَّاسِ، فذاك الذي هي عليه وِزرٌ، قالوا: فالحُمُرُ يا رَسولَ اللهِ؟ قال: ما أنزَلَ اللهُ عليَّ فيها شيئًا إلَّا هذه الآيةَ الجامِعةَ الفاذَّةَ: {فمَنْ يَعمَلْ مِثقالَ ذَرَّةٍ خَيرًا يَرَهُ * ومَن يَعمَلْ مِثقالَ ذَرَّةٍ شَرًّا يَرَهُ} [الزلزلة: 7-8]. [وفي روايةٍ]: بَدَلَ عَقصاءُ: عَضباءُ، وقال: فيُكوى بها جَنبُه وظَهرُه، ولَم يَذكُرْ: جَبينُه. [وفي روايةٍ]: إذا لَم يُؤَدِّ المَرءُ حَقَّ اللهِ، أوِ الصَّدَقةَ في إبِلِه، وساقَ الحَديثَ بنَحوِ حَديثِ سُهَيلٍ عن أبيه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (987) مطولاً","bab":"قرآن › أسباب النزول","dorar":"1IlMX4Z5","merged":3,"otherRefs":["تخريج المسند لشعيب 8977 (صحيح)","تخريج المسند لشعيب 7563 (صحيح)"]},{"id":"س-08375","fp":"0f33423ef6a3","stateId":589,"easy":"إذا أوكيت على ذهب أو فضة (فلم تنفقه في سبيل الله) ← فهو جمر عليك يوم القيامة","cause":"أيُّما ذهَبٍ أو فِضَّةٍ أُوكيَ عليه","result":"فهو جَمرٌ على صاحِبِه يومَ القِيامةِ حتى يُفرِغَه إفراغًا في سَبيلِ اللهِ","explicit":true,"ref":"تخريج المسند لشعيب 21528","srcLabel":"مسلم","text":["كُنْتُ مع أبي ذَرٍّ، وقد خرَجَ عَطاؤُه، ومعه جاريةٌ له، فجعَلَتْ تَقْضي حوائجَه، وقال مرَّةً: تَقْضي، قال: ففضَلَ معه فَضلٌ، قال: أحسَبُه قال: سَبعٌ، قال: فأمَرَها أنْ تَشتريَ بها فُلوسًا، قُلْتُ: يا أبا ذَرٍّ، لوِ ادَّخرْتَه للحاجةِ تَنوبُكَ، وللضيفِ يَأْتيكَ، فقال: إنَّ خَليلي عهِدَ إليَّ أنْ: ",["أيُّما ذهَبٍ أو فِضَّةٍ أُوكيَ عليه",1],"، ",["فهو جَمرٌ على صاحِبِه يومَ القِيامةِ حتى يُفرِغَه إفراغًا في سَبيلِ اللهِ",2],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (21528) واللفظ له، والبزار (3926)، والطبراني (2/151) (1634)","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"XHvMsNnO","merged":3,"otherRefs":["الصحيح المسند 266 (صحيح)","الزواجر عن اقتراف الكبائر 1/178 (صحيح)"]},{"id":"س-02960","fp":"d738ab0b66b8","stateId":589,"easy":"إذا كان لك مال فلم تؤدِّ حقه ← يُجعل يوم القيامة شجاعاً أقرع يطوقك","cause":"مَن كان له مالٌ فلم يُؤَدِّ حَقَّه","result":"جُعِلَ يَومَ القِيامَةِ شُجاعًا أَقرَعَ، لِفيهِ زَبيبَتان، يَتبَعُه حتى يَضَعَ يَدَه في فيهِ، فلا يَزالُ يَقضِمُها حتى يُقضى بيْنَ العِبادِ","explicit":true,"repOf":"س-03021","ref":"تخريج المسند لشعيب 7756","text":[["مَن كان له مالٌ فلم يُؤَدِّ حَقَّه",1],"؛ ",["جُعِلَ يَومَ القِيامَةِ شُجاعًا أَقرَعَ، لِفيهِ زَبيبَتان، يَتبَعُه حتى يَضَعَ يَدَه في فيهِ، فلا يَزالُ يَقضِمُها حتى يُقضى بيْنَ العِبادِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1403) باختلاف يسير، ومسلم (987) بمعناه مطولاً","bab":"إيمان › الوعيد","dorar":"NPiwNMl7"},{"id":"س-03892","fp":"b4bf42df506e","stateId":589,"easy":"إذا كنزت المال ولم تؤد زكاته ← فويل لك","cause":"مَن كَنَزَها فلم يُؤَدِّ زَكاتَها","result":"فوَيْلٌ له","explicit":true,"ref":"الأحاديث المختارة 13 / 173","srcLabel":"متفق عليه","text":["عن خالِدِ بنِ أَسلَمَ، قالَ: «خَرَجْنا معَ عَبْدِ اللهِ بنِ عُمَرَ نَمْشي فلَحِقَنا أعْرابيٌّ، فقالَ: أنت عَبْدُ اللهِ بنُ عُمَرَ؟ قالَ: نَعمْ، قالَ: سَألْتُ عنك فدُلِلْتُ عليك، فأَخْبِرْني: أَتَرِثُ العَمَّةُ؟ فقالَ ابنُ عُمَرَ: لا أَدْري، فقالَ: أنت لا تَدْري ولا نَدْري؟ قالَ: نَعمْ: اذْهَبْ إلى العُلَماءِ فاسْأَلْهم، فلمَّا أَدبَرَ قَبَّلَ يَدَيه، ثُمَّ قالَ: نِعْمَ ما قالَ أبو عَبْدِ الرَّحْمنِ يُسأَلُ عمَّا لا يَدْري! فقالَ: لا أَدْري، قالَ الأعْرابيُّ: قَوْلُ اللهِ عَزَّ وجَلَّ: {وَالَّذِينَ يَكْنِزُونَ الذَّهَبَ وَالْفِضَّةَ} فقالَ ابنُ عُمَرَ: ",["مَن كَنَزَها فلم يُؤَدِّ زَكاتَها",1],"، ",["فوَيْلٌ له",2]," إنَّما كانَ هذا قَبْلَ أن تُنزَلَ الزَّكاةُ، فلمَّا أُنزِلَتْ جَعَلَها اللهُ طُهْرةً، ثُمَّ الْتَفَتَ إليَّ، فقالَ: ما أُبالي لو كانَ عِنْدي مِثلُ أحُدٍ ذَهَبًا أَعلَمُ عَدَدَه أُزَكِّيه وأَعمَلُ فيه بطاعةِ اللهِ»."],"grade":"صحيح","narrator":"خالد بن أسلم","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"تفسير آيات › سورة التوبة","dorar":"2Wm4bqG5"},{"id":"س-04154","fp":"d03018f1ccab","stateId":589,"easy":"إذا كنزت الدنانير (من أهل المسألة) ← فهي كيّات عليك","cause":"هل ترَكَ مِن شَيءٍ؟ قالوا: ثَلاثَ دَنانيرَ","result":"ثَلاثُ كَيَّاتٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 16527","srcLabel":"البخاري","text":["كنتُ مع النَّبيِّ صلَّى اللهُ عليه وسَلَّمَ، فأُتيَ بِجِنازةٍ، فقالوا: يا نَبيَّ اللهِ، صَلِّ عليها. قال: هل ترَكَ شَيئًا؟ قالوا: لا. قال: هل ترَكَ عليه دَيْنًا؟ قالوا: لا. فصَلَّى عليه. ثم أُتيَ بِجِنازةٍ بَعدَ ذلك، فقال: هل ترَكَ عليه مِن دَيْنٍ؟ قالوا: لا. قال: ",["هل ترَكَ مِن شَيءٍ؟ قالوا: ثَلاثَ دَنانيرَ",1],". قال: ",["ثَلاثُ كَيَّاتٍ",2],". قال: فأُتيَ بِالثَّالِثةِ، فقال: هل ترَكَ عليه مِن دَيْنٍ؟ قالوا: نَعَمْ. قال: هل ترَكَ مِن شَيءٍ؟ قالوا: لا. قال: صَلُّوا على صاحِبِكم. فقال رَجُلٌ مِنَ الأنصارِ، يُقالُ له أبو قَتادةَ: يا رَسولَ اللهِ، علَيَّ دَيْنُهُ. فصَلَّى عليه."],"grade":"صحيح","narrator":"سلمة بن الأكوع","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (2289) باختلاف يسير","bab":"جنائز وموت › قضاء دين الميت","dorar":"kOYiMeon","merged":7,"otherRefs":["تخريج المسند لشعيب 22172 (صحيح)","تخريج المسند لشعيب 22221 (صحيح)","تخريج المسند لشعيب 22174 (صحيح)","إتحاف الخيرة المهرة 2/472 (صحيح)","تخريج المسند لشعيب 14688 (حسن)","تخريج المسند لشعيب 22180 (صحيح)"]},{"id":"س-05072","fp":"6241d2f74785","stateId":589,"easy":"إذا كان لك مال لم تعطِ حقه ← تطؤك الإبل بأخفافها والبقر والغنم يوم القيامة","cause":"المالُ الَّذي لم يُعْطَ الحقُّ منها","result":"فتطَأُ الإبلُ سيِّدَها بأخفافِها ويأتي البقرُ والغَنمُ فتطَأُ صاحبَها بأظلافِها وتنطَحُه بقرونِها","explicit":true,"ref":"تخريج صحيح ابن حبان 3254","srcLabel":"متفق عليه","text":["يأتي ",["المالُ الَّذي لم يُعْطَ الحقُّ منها",1]," ",["فتطَأُ الإبلُ سيِّدَها بأخفافِها ويأتي البقرُ والغَنمُ فتطَأُ صاحبَها بأظلافِها وتنطَحُه بقرونِها",2]," ويأتي الكنزُ شُجاعًا أقرَعَ فيَلقى صاحبَه فيفِرُّ منه ثمَّ يستقبِلُه ويفِرُّ منه فيقولُ: ما لي وما وما لك ؟ ! فيقولُ: أنا كَنزُك أنا كنزُك فيتلقَّاه صاحبُه بيدِه فيلقَمُ يدَه"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (1402، 6957) مفرقاً بنحوه","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"XRvWQ6wA"},{"id":"س-05073","fp":"2db12a8be710","stateId":589,"easy":"إذا كنزت المال ولم تؤدِّ حقه ← يأتي يوم القيامة شجاعاً أقرع يلاحقك","cause":"ويأتي الكنزُ","result":"شُجاعًا أقرَعَ فيَلقى صاحبَه فيفِرُّ منه ثمَّ يستقبِلُه ويفِرُّ منه فيقولُ: ما لي وما وما لك ؟ ! فيقولُ: أنا كَنزُك أنا كنزُك فيتلقَّاه صاحبُه بيدِه فيلقَمُ يدَه","explicit":true,"repOf":"س-03021","ref":"تخريج صحيح ابن حبان 3254","text":["يأتي المالُ الَّذي لم يُعْطَ الحقُّ منها فتطَأُ الإبلُ سيِّدَها بأخفافِها ويأتي البقرُ والغَنمُ فتطَأُ صاحبَها بأظلافِها وتنطَحُه بقرونِها ",["ويأتي الكنزُ",1]," ",["شُجاعًا أقرَعَ فيَلقى صاحبَه فيفِرُّ منه ثمَّ يستقبِلُه ويفِرُّ منه فيقولُ: ما لي وما وما لك ؟ ! فيقولُ: أنا كَنزُك أنا كنزُك فيتلقَّاه صاحبُه بيدِه فيلقَمُ يدَه",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (1402، 6957) مفرقاً بنحوه","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"XRvWQ6wA"},{"id":"س-05378","fp":"92114cb2ff28","stateId":589,"easy":"إذا منعت فضول الماء لتمنع به الكلأ ← يمنعك الله فضل رحمته يوم القيامة","cause":"مَن منعَ فضولَ الماءِ ليَمنعَ بِهِ الكلأَ","result":"منعَهُ اللَّهُ فَضلَ رحمتِهِ يومَ القيامةِ","explicit":true,"similar":["س-05244"],"ref":"الأم 5/99","srcLabel":"متفق عليه","text":[["مَن منعَ فضولَ الماءِ ليَمنعَ بِهِ الكلأَ",1]," ",["منعَهُ اللَّهُ فَضلَ رحمتِهِ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الشافعي في ((الأم)) (5/99). والنهي عن منع فضل الماء أخرجه البخاري (2354)، ومسلم (1566)","bab":"رقائق وزهد › الجزاء من جنس العمل","dorar":"3XMClQaK"},{"id":"س-06135","fp":"12f553a07abd","stateId":589,"easy":"إذا تركت كنزاً (لم تؤدِّ حقه) ← يُمثّل لك يوم القيامة شجاعاً أقرع يتبعك","cause":"مَن ترَكَ كَنزًا","result":"فإنَّه يُمثَّلُ له يَومَ القِيامةِ شُجاعًا أقرعَ يَتبَعُهُ، له زَبيبَتانِ، فما زالَ يَطلُبُه، يَقولُ: وَيلَكَ ما أنتَ","explicit":true,"repOf":"س-06137","ref":"تخريج المسند لشعيب 10344","text":[["مَن ترَكَ كَنزًا؛ ",1],["فإنَّه يُمثَّلُ له يَومَ القِيامةِ شُجاعًا أقرعَ يَتبَعُهُ، له زَبيبَتانِ، فما زالَ يَطلُبُه، يَقولُ: وَيلَكَ ما أنتَ",2],"؟ قال: يَقولُ: أنا كَنزُكَ الذي ترَكتَ بَعدَكَ. قال: فيُلقِمُهُ يَدَهُ فيَقضَمُها، ثم يُتبِعُهُ سائرَ جَسدِهِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6957) باختلاف يسير، ومسلم (987) بمعناه مطولاً","bab":"زكاة › عقوبة مانع الزكاة","dorar":"Ky1gWEHY"},{"id":"س-06143","fp":"10368f0ca7aa","stateId":589,"easy":"إذا لم تعطِ حق إبلك وبقرك وغنمك ← تطؤك بأخفافها وأظلافها يوم القيامة","cause":"الإبلُ الَّتي لم تُعطِ الحقَّ منها","result":"تطَأُ صاحبَها بأخفافِها وتأتي البقرُ والغنمُ تطَأُ صاحبَها بأظلافِها وتَنطحُهُ بقرونِها","explicit":true,"similar":["س-06133"],"ref":"صحيح ابن ماجه 1457","srcLabel":"متفق عليه","text":["تأتي ",["الإبلُ الَّتي لم تُعطِ الحقَّ منها",1]," ",["تطَأُ صاحبَها بأخفافِها وتأتي البقرُ والغنمُ تطَأُ صاحبَها بأظلافِها وتَنطحُهُ بقرونِها",2]," ويأتي الكَنزُ شجاعًا أقرعَ فيَلقى صاحبَهُ يومَ القيامةِ فيَفرُّ منهُ صاحبُهُ مرَّتينِ ثمَّ يستَقبلُهُ فيفرُّ فيقولُ ما لي ولَكَ فيقولُ أنا كَنزُكَ أنا كَنزُكَ فيتقيهِ بيدِهِ فَيلقَمُها"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه البخاري (1402)، ومسلم (987)، والنسائي (2448)، وابن ماجه (1786) واللفظ له، وأحمد (8965)","bab":"زكاة › عقوبة مانع الزكاة","dorar":"6oRWVpKj"},{"id":"س-06144","fp":"4fc950d76ba5","stateId":589,"easy":"إذا كنزت المال ← يأتي يوم القيامة شجاعاً أقرع يلاحقك","cause":"ويأتي الكَنزُ","result":"شجاعًا أقرعَ فيَلقى صاحبَهُ يومَ القيامةِ فيَفرُّ منهُ صاحبُهُ مرَّتينِ ثمَّ يستَقبلُهُ فيفرُّ فيقولُ ما لي ولَكَ فيقولُ أنا كَنزُكَ أنا كَنزُكَ فيتقيهِ بيدِهِ فَيلقَمُها","explicit":true,"repOf":"س-03021","ref":"صحيح ابن ماجه 1457","text":["تأتي الإبلُ الَّتي لم تُعطِ الحقَّ منها تطَأُ صاحبَها بأخفافِها وتأتي البقرُ والغنمُ تطَأُ صاحبَها بأظلافِها وتَنطحُهُ بقرونِها ",["ويأتي الكَنزُ",1]," ",["شجاعًا أقرعَ فيَلقى صاحبَهُ يومَ القيامةِ فيَفرُّ منهُ صاحبُهُ مرَّتينِ ثمَّ يستَقبلُهُ فيفرُّ فيقولُ ما لي ولَكَ فيقولُ أنا كَنزُكَ أنا كَنزُكَ فيتقيهِ بيدِهِ فَيلقَمُها",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه البخاري (1402)، ومسلم (987)، والنسائي (2448)، وابن ماجه (1786) واللفظ له، وأحمد (8965)","bab":"زكاة › عقوبة مانع الزكاة","dorar":"6oRWVpKj"},{"id":"س-06155","fp":"02d080d8fc8f","stateId":589,"easy":"إذا آتاك الله مالاً فلم تؤدِّ زكاته ← يُمثّل لك يوم القيامة شجاعاً أقرع","cause":"مَنْ آتاهُ اللهُ مالًا فلَمْ يؤَدِ زكاتَهُ","result":"مُثِّلَ له يومَ القيامَةِ شجاعًا أقرَعَ لَهُ زبيبتانِ يطوِّقُهُ يومَ القيامَةِ ثُمَّ يأخُذُ بلِهْزِمَتَيْهِ","explicit":true,"repOf":"س-03021","ref":"تخريج مشكلة الفقر 60","text":[["مَنْ آتاهُ اللهُ مالًا فلَمْ يؤَدِ زكاتَهُ",1]," ",["مُثِّلَ له يومَ القيامَةِ شجاعًا أقرَعَ لَهُ زبيبتانِ يطوِّقُهُ يومَ القيامَةِ ثُمَّ يأخُذُ بلِهْزِمَتَيْهِ",2]," يعني بِشِدْقَيْهِ ثُمَّ يقولُ : أنا مالُكَ أنا كنزُكَ ثُمَّ تلا النبىُّ : ولَا يَحْسَبَنَّ الَّذِينَ يَبْخَلُونَ بِمَا آتاهُمُ اللهُ مِنْ فَضْلِهِ هُوَ خَيْرًا لَهُمْ بَلْ هُوَ شَرٌّ لَهُمْ سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ القيامَةِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1403) باختلاف يسير.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"rXyxhxTV"},{"id":"س-07739","fp":"ac06a4578321","stateId":589,"easy":"إذا كنت صاحب ذهب أو فضة لا تؤدي حقها ← تُصفّح لك يوم القيامة صفائح من نار يُكوى بها","cause":"ما مِن صاحِبِ ذَهَبٍ ولا فِضَّةٍ لا يُؤَدِّي مِنها حَقَّها","result":"إلَّا إذا كانَ يَومُ القيامةِ صُفِّحَت له صَفائِحُ مِن نارٍ، فأُحميَ عليها في نارِ جَهَنَّمَ، فيُكوى بها جَنبُه وجَبينُه وظَهرُه، كُلَّما بَرَدَت أُعيدَت له، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ","explicit":true,"repOf":"س-07742","ref":"صحيح مسلم 987","text":[["ما مِن صاحِبِ ذَهَبٍ ولا فِضَّةٍ لا يُؤَدِّي مِنها حَقَّها",1]," ",["إلَّا إذا كانَ يَومُ القيامةِ صُفِّحَت له صَفائِحُ مِن نارٍ، فأُحميَ عليها في نارِ جَهَنَّمَ، فيُكوى بها جَنبُه وجَبينُه وظَهرُه، كُلَّما بَرَدَت أُعيدَت له، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ",2]," سَنةٍ، حتَّى يُقضى بينَ العِبادِ، فيَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ. قيلَ: يا رَسولَ اللهِ، فالإبِلُ؟ قال: ولا صاحِبُ إبِلٍ لا يُؤَدِّي مِنها حَقَّها -ومِن حَقِّها حَلَبُها يَومَ وِردِها- إلَّا إذا كانَ يَومُ القيامةِ بُطِحَ لها بقاعٍ قَرقَرٍ أوفَرَ ما كانَت، لا يَفقِدُ مِنها فصيلًا واحِدًا، تَطَؤُه بأخفافِها وتَعَضُّه بأفواهِها، كُلَّما مَرَّ عليه أُولاها رُدَّ عليه أُخراها، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، حتَّى يُقضى بينَ العِبادِ، فيَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ. قيلَ: يا رَسولَ اللهِ، فالبَقَرُ والغَنَمُ؟ قال: ولا صاحِبُ بَقَرٍ ولا غَنَمٍ لا يُؤَدِّي مِنها حَقَّها إلَّا إذا كانَ يَومُ القيامةِ بُطِحَ لها بقاعٍ قَرقَرٍ، لا يَفقِدُ مِنها شيئًا، ليس فيها عَقصاءُ ولا جَلحاءُ ولا عَضباءُ، تَنطَحُه بقُرونِها وتَطَؤُه بأظلافِها، كُلَّما مَرَّ عليه أولاها رُدَّ عليه أُخراها، في يَومٍ كانَ مِقدارُه خَمسينَ ألفَ سَنةٍ، حتَّى يُقضى بينَ العِبادِ، فيَرى سَبيلَه؛ إمَّا إلى الجَنَّةِ، وإمَّا إلى النَّارِ. قيلَ: يا رَسولَ اللهِ، فالخَيلُ؟ قال: الخَيلُ ثَلاثةٌ: هي لرَجُلٍ وِزرٌ، وهي لرَجُلٍ سِترٌ، وهي لرَجُلٍ أجرٌ؛ فأمَّا التي هي له وِزرٌ فرَجُلٌ رَبَطَها رياءً وفَخرًا ونِواءً على أهلِ الإسلامِ، فهي له وِزرٌ، وأمَّا التي هي له سِترٌ فرَجُلٌ رَبَطَها في سَبيلِ اللهِ، ثُمَّ لَم يَنسَ حَقَّ اللهِ في ظُهورِها ولا رِقابِها، فهي له سِترٌ، وأمَّا التي هي له أجرٌ فرَجُلٌ رَبَطَها في سَبيلِ اللهِ لأهلِ الإسلامِ في مَرجٍ ورَوضةٍ، فما أكَلَت مِن ذلك المَرجِ أوِ الرَّوضةِ مِن شَيءٍ إلَّا كُتِبَ له عَدَدَ ما أكَلَت حَسَناتٌ، وكُتِبَ له عَدَدَ أرواثِها وأبوالِها حَسَناتٌ، ولا تَقطَعُ طِوَلَها فاستَنَّت شَرَفًا أو شَرَفَينِ، إلَّا كَتَبَ اللهُ له عَدَدَ آثارِها وأرواثِها حَسَناتٍ، ولا مَرَّ بها صاحِبُها على نَهرٍ، فشَرِبَت منه ولا يُريدُ أن يَسقيَها؛ إلَّا كَتَبَ اللهُ له عَدَدَ ما شَرِبَت حَسَناتٍ. قيلَ: يا رَسولَ اللهِ، فالحُمُرُ؟ قال: ما أُنزِلَ عليَّ في الحُمُرِ شَيءٌ إلَّا هذه الآيةُ الفاذَّةُ الجامِعةُ: {فمَن يَعمَلْ مِثقالَ ذَرَّةٍ خَيرًا يَرَهُ * ومَن يَعمَلْ مِثقالَ ذَرَّةٍ شَرًّا يَرَهُ}. [الزلزلة: 7-8]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2371) مختصراً، ومسلم (987) واللفظ له","bab":"قرآن › أسباب النزول","dorar":"J4xobANc"},{"id":"س-03887","fp":"6a08d0b593f5","stateId":589,"easy":"إذا كان لك ذهب أو فضة لم تؤد زكاتها ← تُجعل يوم القيامة صفائح من نار يُكوى بها جنبك","cause":"مَن كانت لَه ذَهَبٌ أو فضَّةٌ لم يؤدِّ ما فيها","result":"جُعِلَت لَه يومَ القيامةِ صفائحَ من نارٍ فوُضِعَت علَى جنبِهِ وظَهْرِهِ وجبهتِهِ، حتَّى يُقضَي بينَ النَّاسِ، ثمَّ يَرى سبيلَهُ","explicit":true,"repOf":"س-07742","ref":"المحلى 6/68","text":[["مَن كانت لَه ذَهَبٌ أو فضَّةٌ لم يؤدِّ ما فيها",1]," ",["جُعِلَت لَه يومَ القيامةِ صفائحَ من نارٍ فوُضِعَت علَى جنبِهِ وظَهْرِهِ وجبهتِهِ، حتَّى يُقضَي بينَ النَّاسِ، ثمَّ يَرى سبيلَهُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"احتج به ، وقال في المقدمة: (لم نحتج إلا بخبر صحيح من رواية الثقات مسند)","takhrij":"أخرجه مسلم (987) مطولاً باختلاف يسير","bab":"تفسير آيات › سورة التوبة","dorar":"rLa9dzNS"},{"id":"س-03895","fp":"5c941ccba027","stateId":589,"easy":"إذا كنت صاحب نعم لم تعط حقها ← تُسلّط عليك يوم القيامة فتخبط وجهك بأخفافها","cause":"إذا ما رَبُّ النَّعَمِ لم يُعطِ حَقَّها","result":"تُسَلَّطُ عليه يَومَ القيامةِ، فتَخبِطُ وجهَه بأخفافِها","explicit":true,"ref":"صحيح البخاري 6957","srcLabel":"مسلم","text":["يَكونُ كَنزُ أحَدِكُم يَومَ القيامةِ شُجاعًا أقرَعَ، يَفِرُّ منه صاحِبُه، فيَطلُبُه ويقولُ: أنا كَنزُك، قال: واللهِ لَن يَزالَ يَطلُبُه حتَّى يَبسُطَ يَدَه فيُلقِمَها فاه، وقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["إذا ما رَبُّ النَّعَمِ لم يُعطِ حَقَّها",1]," ",["تُسَلَّطُ عليه يَومَ القيامةِ، فتَخبِطُ وجهَه بأخفافِها",2],"، وقال بَعضُ النَّاسِ: في رَجُلٍ له إبِلٌ، فخافَ أن تَجِبَ عليه الصَّدَقةُ، فباعَها بإبِلٍ مِثلِها أو بغَنَمٍ أو ببَقَرٍ أو بدَراهمَ؛ فِرارًا مِنَ الصَّدَقةِ بيَومٍ احتيالًا، فلا بَأسَ عليه. وهو يقولُ: إن زَكَّى إبِلَه قَبلَ أن يَحولَ الحَولُ بيَومٍ أو بسِتَّةٍ جازَت عنه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (987) بمعناه","bab":"تفسير آيات › سورة التوبة","dorar":"jLEE4Cvv"},{"id":"س-06140","fp":"a03bf50873bb","stateId":589,"easy":"إذا لم تؤدِّ زكاة مالك ← تُحمى عليك صفائح في نار جهنم فيُكوى بها جنبك","cause":"ما مِن عبدٍ لا يؤدِّي زَكاةَ مالِهِ","result":"إلَّا أتيَ بِهِ وبمالِهِ فأُحْميَ عليهِ صَفائحُ في نارِ جَهَنَّمَ، فتُكْوى بِهِ جَنباهُ وجبينُهُ وظَهْرُهُ، حتَّى يَحكُمَ اللَّهُ بينَ عبادِهِ يومًا مقدارُهُ ألفَ سنَةٍ مِمَّا تعدُّونَ، ثمَّ يرى سبيلَهُ، إمَّا","explicit":true,"similar":["س-07468"],"ref":"صحيح ابن خزيمة 4/ 14","srcLabel":"مسلم","text":[["ما مِن عبدٍ لا يؤدِّي زَكاةَ مالِهِ",1]," ",["إلَّا أتيَ بِهِ وبمالِهِ فأُحْميَ عليهِ صَفائحُ في نارِ جَهَنَّمَ، فتُكْوى بِهِ جَنباهُ وجبينُهُ وظَهْرُهُ، حتَّى يَحكُمَ اللَّهُ بينَ عبادِهِ يومًا مقدارُهُ ألفَ سنَةٍ مِمَّا تعدُّونَ، ثمَّ يرى سبيلَهُ، إمَّا",2]," إلى الجنَّةِ، وإمَّا إلى النَّارِ ولا عَبدٍ لا يؤدِّي صدقةَ إبلِهِ إلَّا أتيَ بِهِ، وبإبلِهِ علَى أوفرَ ما كانت فيبطحُ لَها بِقاعٍ قَرقرٍ فتسيرُ علَيهِ كلَّما مَضَى آخرُها رُدَّ أوَّلُها حتَّى يحكُمَ اللَّهُ بينَ عبادِهِ في يومٍ كانَ مِقدارُهُ ألفَ سنةٍ مِمَّا تَعدُّونَ، ثمَّ يرَى سبيلَهُ إمَّا إلى الجنَّةِ، وإمَّا إلى النَّارِ ولا عَبدٍ لا يؤدِّي صَدقةَ غنمِهِ إلَّا أتيَ بِهِ وبغَنمِهِ على أوفرَ ما كانَت فيبطَحُ لَها بِقاعٍ قرقرٍ فتسيرُ عليهِ كلَّما مضَى عنهُ آخرُها ردَّ أوَّلُها تطأَهُ بأظلافِها، وتنطحُهُ بقرونِها ليسَ فيها عقصاءُ، ولا جلحاءُ حتَّى يحكمَ اللَّهُ بينَ عبادِهِ في يومٍ كانَ مقدارُهُ ألفَ سنةٍ ممَّا تعدُّونَ، ثمَّ يرى سبيلَهُ إمَّا إلى الجنَّةِ وإمَّا إلى النَّارِ قالوا: يا رسولَ اللَّهِ الخيلُ قالَ: الخيلُ معقودٌ في نواصيها الخيرُ إلى يومِ القيامةِ، والخيلُ لثلاثةٍ هيَ لرجلٍ أجرٌ، ولرجلٍ سترٌ، وعلى رجلٍ وزرٌ فذكرَ الحديثَ بطولِهِ قالوا: الحمرُ يا رسولَ اللَّهِ قالَ: ما أنزلَ اللَّهُ عليَّ فيها شيئًا إلَّا هذِهِ الآيةَ الجامعةَ الفاذَّةَ {فَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُ وَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُ} . الجلحاءُ: التي لَيس لها قرنٌ . والعَقصاءُ: المكسورةُ القَرنِ[وفي روايةٍ]: قال في كلِّها: في يومٍ كان مِقدارُهُ خمسينَ ألفَ سنةٍ مِمَّا تعدُّونَ، وقالَ أيضًا: ثمَّ تستنُّ عليهِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (987)، وأحمد (8977)، وأبو عوانة في ((المستخرج)) (3370) بنحوه.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"0QHtvoc0"},{"id":"س-06141","fp":"bbd4bd8923bc","stateId":589,"easy":"إذا لم تؤدِّ صدقة إبلك ← تأتي يوم القيامة أوفر ما كانت فتطؤك","cause":"ولا عَبدٍ لا يؤدِّي صدقةَ إبلِهِ","result":"إلَّا أتيَ بِهِ، وبإبلِهِ علَى أوفرَ ما كانت فيبطحُ لَها بِقاعٍ قَرقرٍ فتسيرُ علَيهِ كلَّما مَضَى آخرُها رُدَّ أوَّلُها حتَّى يحكُمَ اللَّهُ بينَ عبادِهِ في يومٍ كانَ مِقدارُهُ ألفَ سنةٍ مِمَّا تَعدُّونَ، ثمَّ يرَى سبيلَهُ إمَّا إلى الجنَّةِ، وإمَّا إلى النَّارِ","explicit":true,"similar":["س-06142"],"ref":"صحيح ابن خزيمة 4/ 14","srcLabel":"مسلم","text":["ما مِن عبدٍ لا يؤدِّي زَكاةَ مالِهِ إلَّا أتيَ بِهِ وبمالِهِ فأُحْميَ عليهِ صَفائحُ في نارِ جَهَنَّمَ، فتُكْوى بِهِ جَنباهُ وجبينُهُ وظَهْرُهُ، حتَّى يَحكُمَ اللَّهُ بينَ عبادِهِ يومًا مقدارُهُ ألفَ سنَةٍ مِمَّا تعدُّونَ، ثمَّ يرى سبيلَهُ، إمَّا إلى الجنَّةِ، وإمَّا إلى النَّارِ ",["ولا عَبدٍ لا يؤدِّي صدقةَ إبلِهِ",1]," ",["إلَّا أتيَ بِهِ، وبإبلِهِ علَى أوفرَ ما كانت فيبطحُ لَها بِقاعٍ قَرقرٍ فتسيرُ علَيهِ كلَّما مَضَى آخرُها رُدَّ أوَّلُها حتَّى يحكُمَ اللَّهُ بينَ عبادِهِ في يومٍ كانَ مِقدارُهُ ألفَ سنةٍ مِمَّا تَعدُّونَ، ثمَّ يرَى سبيلَهُ إمَّا إلى الجنَّةِ، وإمَّا إلى النَّارِ",2]," ولا عَبدٍ لا يؤدِّي صَدقةَ غنمِهِ إلَّا أتيَ بِهِ وبغَنمِهِ على أوفرَ ما كانَت فيبطَحُ لَها بِقاعٍ قرقرٍ فتسيرُ عليهِ كلَّما مضَى عنهُ آخرُها ردَّ أوَّلُها تطأَهُ بأظلافِها، وتنطحُهُ بقرونِها ليسَ فيها عقصاءُ، ولا جلحاءُ حتَّى يحكمَ اللَّهُ بينَ عبادِهِ في يومٍ كانَ مقدارُهُ ألفَ سنةٍ ممَّا تعدُّونَ، ثمَّ يرى سبيلَهُ إمَّا إلى الجنَّةِ وإمَّا إلى النَّارِ قالوا: يا رسولَ اللَّهِ الخيلُ قالَ: الخيلُ معقودٌ في نواصيها الخيرُ إلى يومِ القيامةِ، والخيلُ لثلاثةٍ هيَ لرجلٍ أجرٌ، ولرجلٍ سترٌ، وعلى رجلٍ وزرٌ فذكرَ الحديثَ بطولِهِ قالوا: الحمرُ يا رسولَ اللَّهِ قالَ: ما أنزلَ اللَّهُ عليَّ فيها شيئًا إلَّا هذِهِ الآيةَ الجامعةَ الفاذَّةَ {فَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُ وَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُ} . الجلحاءُ: التي لَيس لها قرنٌ . والعَقصاءُ: المكسورةُ القَرنِ[وفي روايةٍ]: قال في كلِّها: في يومٍ كان مِقدارُهُ خمسينَ ألفَ سنةٍ مِمَّا تعدُّونَ، وقالَ أيضًا: ثمَّ تستنُّ عليهِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (987)، وأحمد (8977)، وأبو عوانة في ((المستخرج)) (3370) بنحوه.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"0QHtvoc0"},{"id":"س-06142","fp":"3486eda42af0","stateId":589,"easy":"إذا لم تؤدِّ صدقة غنمك ← تأتي يوم القيامة أوفر ما كانت فتطؤك وتنطحك","cause":"ولا عَبدٍ لا يؤدِّي صَدقةَ غنمِهِ","result":"إلَّا أتيَ بِهِ وبغَنمِهِ على أوفرَ ما كانَت فيبطَحُ لَها بِقاعٍ قرقرٍ فتسيرُ عليهِ كلَّما مضَى عنهُ آخرُها ردَّ أوَّلُها تطأَهُ بأظلافِها، وتنطحُهُ بقرونِها ليسَ فيها عقصاءُ، ولا جلحاءُ حتَّى يحكمَ اللَّهُ بينَ عبادِهِ في يومٍ كانَ مقدارُهُ ألفَ سنةٍ ممَّا تعدُّونَ، ثمَّ يرى سبيلَهُ إمَّا إلى الجنَّةِ وإمَّا إلى النَّارِ","explicit":true,"repOf":"س-06141","ref":"صحيح ابن خزيمة 4/ 14","text":["ما مِن عبدٍ لا يؤدِّي زَكاةَ مالِهِ إلَّا أتيَ بِهِ وبمالِهِ فأُحْميَ عليهِ صَفائحُ في نارِ جَهَنَّمَ، فتُكْوى بِهِ جَنباهُ وجبينُهُ وظَهْرُهُ، حتَّى يَحكُمَ اللَّهُ بينَ عبادِهِ يومًا مقدارُهُ ألفَ سنَةٍ مِمَّا تعدُّونَ، ثمَّ يرى سبيلَهُ، إمَّا إلى الجنَّةِ، وإمَّا إلى النَّارِ ولا عَبدٍ لا يؤدِّي صدقةَ إبلِهِ إلَّا أتيَ بِهِ، وبإبلِهِ علَى أوفرَ ما كانت فيبطحُ لَها بِقاعٍ قَرقرٍ فتسيرُ علَيهِ كلَّما مَضَى آخرُها رُدَّ أوَّلُها حتَّى يحكُمَ اللَّهُ بينَ عبادِهِ في يومٍ كانَ مِقدارُهُ ألفَ سنةٍ مِمَّا تَعدُّونَ، ثمَّ يرَى سبيلَهُ إمَّا إلى الجنَّةِ، وإمَّا إلى النَّارِ ",["ولا عَبدٍ لا يؤدِّي صَدقةَ غنمِهِ",1]," ",["إلَّا أتيَ بِهِ وبغَنمِهِ على أوفرَ ما كانَت فيبطَحُ لَها بِقاعٍ قرقرٍ فتسيرُ عليهِ كلَّما مضَى عنهُ آخرُها ردَّ أوَّلُها تطأَهُ بأظلافِها، وتنطحُهُ بقرونِها ليسَ فيها عقصاءُ، ولا جلحاءُ حتَّى يحكمَ اللَّهُ بينَ عبادِهِ في يومٍ كانَ مقدارُهُ ألفَ سنةٍ ممَّا تعدُّونَ، ثمَّ يرى سبيلَهُ إمَّا إلى الجنَّةِ وإمَّا إلى النَّارِ",2]," قالوا: يا رسولَ اللَّهِ الخيلُ قالَ: الخيلُ معقودٌ في نواصيها الخيرُ إلى يومِ القيامةِ، والخيلُ لثلاثةٍ هيَ لرجلٍ أجرٌ، ولرجلٍ سترٌ، وعلى رجلٍ وزرٌ فذكرَ الحديثَ بطولِهِ قالوا: الحمرُ يا رسولَ اللَّهِ قالَ: ما أنزلَ اللَّهُ عليَّ فيها شيئًا إلَّا هذِهِ الآيةَ الجامعةَ الفاذَّةَ {فَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُ وَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُ} . الجلحاءُ: التي لَيس لها قرنٌ . والعَقصاءُ: المكسورةُ القَرنِ[وفي روايةٍ]: قال في كلِّها: في يومٍ كان مِقدارُهُ خمسينَ ألفَ سنةٍ مِمَّا تعدُّونَ، وقالَ أيضًا: ثمَّ تستنُّ عليهِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (987)، وأحمد (8977)، وأبو عوانة في ((المستخرج)) (3370) بنحوه.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"0QHtvoc0"},{"id":"س-07443","fp":"7474de4cae40","stateId":589,"easy":"إذا كان لك مال لا تؤدي زكاته ← تُحمى عليك صفائح في جهنم","cause":"ما مِن عبدٍ لَهِ مالٌ لا يؤدِّي زَكاتَهُ","result":"إلَّا جُمِعَ يومَ القيامةِ تُحمَى عليهِ صفائحُ في جَهَنَّمَ، وَكويَ بِها جنبُهُ، وظَهْرُهُ حتَّى يقضيَ اللَّهُ بينَ عبادِهِ في يومٍ كانَ مِقدارُهُ خمسينَ ألفَ سنةٍ مِمَّا تعدُّونَ، ثمَّ يَرى سبيلَهُ، إمَّا إلى الجنَّةِ، وإمَّا إلى النَّارِ","explicit":true,"ref":"صحيح ابن خزيمة 4/ 51","srcLabel":"مسلم","text":[["ما مِن عبدٍ لَهِ مالٌ لا يؤدِّي زَكاتَهُ",1]," ",["إلَّا جُمِعَ يومَ القيامةِ تُحمَى عليهِ صفائحُ في جَهَنَّمَ، وَكويَ بِها جنبُهُ، وظَهْرُهُ حتَّى يقضيَ اللَّهُ بينَ عبادِهِ في يومٍ كانَ مِقدارُهُ خمسينَ ألفَ سنةٍ مِمَّا تعدُّونَ، ثمَّ يَرى سبيلَهُ، إمَّا إلى الجنَّةِ، وإمَّا إلى النَّارِ",2],"، وذَكَرَ الحديثَ بطولِهِ في قصَّةِ الإبلِ والغنمِ . قالَ: قيلَ: يا رسولَ اللَّهِ: والخيلُ قالَ: الخيلُ معقودٌ في نواصيها الخيرُ إلى يومِ القيامةِ، والخيلُ لثلاثةٍ: هيَ لرجلٍ أجرٌ، ولرجلٍ سِترٌ، وعلى رجلٍ وزرٌ، فأمَّا الَّذي هيَ لَهُ أجرٌ، فالَّذي يتَّخذُها في سبيلِ اللَّهِ، ويعدُّها لَهُ لا يغيبُ في بطونِها شيئًا إلَّا كتبَ لَهُ بِها أجرٌ، ولو عَرضَ مرجًا أو مرجينِ فرعاها صاحبُها فيهِ كتبَ لَهُ مِمَّا غيَّبت في بطونِها أجرٌ، ولوِ استنَّت شَرفًا أو شرفينِ، كُتِبَ لَهُ بِكُلِّ خطوةٍ خطاها أجرٌ، ولو عرضَ نَهَرٌ فسقاها بِهِ، كانت لَهُ بِكُلِّ قطرةٍ غُيِّبَت في بطونِها منهُ أجرٌ، حتَّى ذَكَرَ الأجرَ في أرواثِها وأبوالِها، وأمَّا الَّتي هيَ لَهُ سترٌ فالَّذي يتَّخذُها تعفُّفًا وتجمُّلًا وتستُّرًا، ولا يحبِسُ حقَّ ظُهورِها وبطونِها في يُسْرِها وعُسْرِها، وأمَّا الَّذي عليهِ وزرٌ فالَّذي يتَّخذُها أشَرًا وبطرًا وبَذخًا عليهِم قالوا: فالحُمرُ يا رسولَ اللَّهِ؟ قالَ: ما أنزَلَ اللَّهُ عليَّ فيها شيئًا إلَّا هذِهِ الآيةَ الجامِعةَ الفاذَّةَ: {فَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُ، وَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُ} [الزَّلزلةُ: 8]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (987)، وأحمد (8977)، وأبو عوانة في ((المستخرج)) (3370) بنحوه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"DFO0OKiF"},{"id":"س-07468","fp":"0f0c7afdc098","stateId":589,"easy":"إذا لم تؤدِّ زكاة مالك ← يُجعل يوم القيامة صفائح من نار يُكوى بها جنبك","cause":"ما مِن رَجُلٍ لا يُؤَدِّي زَكاةَ مالِه","result":"إلَّا جُعِلَ يَومَ القِيامَةِ صَفائِحَ مِن نارٍ، يُكوى بِها جَنبُه وجَبهَتُه وظَهرُه، في يَومٍ كان مِقدارُه خَمسينَ أَلْفَ سَنَةٍ، حتى يُقضَى بَينَ النَّاسِ، ثم يُرى سَبيلَه","explicit":true,"repOf":"س-06140","ref":"تخريج المسند لشعيب 7720","text":[["ما مِن رَجُلٍ لا يُؤَدِّي زَكاةَ مالِه",1]," ",["إلَّا جُعِلَ يَومَ القِيامَةِ صَفائِحَ مِن نارٍ، يُكوى بِها جَنبُه وجَبهَتُه وظَهرُه، في يَومٍ كان مِقدارُه خَمسينَ أَلْفَ سَنَةٍ، حتى يُقضَى بَينَ النَّاسِ، ثم يُرى سَبيلَه",2],"، وإنْ كانت إبِلًا إلَّا بُطِحَ لَها بِقاعٍ قَرقَرٍ في يَومٍ كان مِقدارُه خَمسين أَلْفَ سَنَةٍ، تَطَؤُه بأَخفافِها -حسِبْتُه قال: وتَعَضُّه بأَفواهِها- يَرِدُ أَوَّلُها عن آخِرِها، حتى يُقضى بيْنَ النَّاسِ، ثم يُرى سَبيلَه، وإنْ كانت غَنَمًا فكمِثْلِ ذلك، إلَّا أنَّها تَنطَحُه بِقُرونِها، وتَطَؤُه بأَظْلافِها."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (987)، وأبو داود (1658)، وأحمد (7720) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"sEBp3H2I"},{"id":"س-05193","fp":"e89872f771fe","stateId":589,"easy":"إذا كنت صاحب كنز لا تؤدي حقه ← يأتي كنزك يوم القيامة شجاعاً أقرع يتبعك","cause":"ولا صاحِبِ كَنزٍ لا يَفعَلُ فيه حَقَّه","result":"إلَّا جاءَ كَنزُه يَومَ القيامةِ شُجاعًا أقرَعَ، يَتبَعُه فاتِحًا فاه، فإذا أتاه فرَّ منه، فيُناديه: خُذْ كَنزَك الذي خَبَأتَه، فأنا عنه غَنيٌّ، فإذا رَأى أن لا بُدَّ منه سَلَك يَدَه في فيه، فيَقضَمُها قَضمَ الفَحلِ","explicit":true,"ref":"صحيح مسلم 988","srcLabel":"النسائي","text":["ما مِن صاحِبِ إبِلٍ لا يَفعَلُ فيها حَقَّها، إلَّا جاءَت يَومَ القيامةِ أكثَرَ ما كانَت قَطُّ، وقَعَدَ لها بقاعٍ قَرقَرٍ تَستَنُّ عليه بقَوائِمِها وأخفافِها، ولا صاحِبِ بَقَرٍ لا يَفعَلُ فيها حَقَّها، إلَّا جاءَت يَومَ القيامةِ أكثَرَ ما كانَت، وقَعَدَ لها بقاعٍ قَرقَرٍ تَنطَحُه بقُرونِها، وتَطَؤُه بقَوائِمِها، ولا صاحِبِ غَنَمٍ لا يَفعَلُ فيها حَقَّها، إلَّا جاءَت يَومَ القيامةِ أكثَرَ ما كانَت، وقَعَدَ لها بقاعٍ قَرقَرٍ تَنطَحُه بقُرونِها وتَطَؤُه بأظلافِها، ليس فيها جَمَّاءُ ولا مُنكَسِرٌ قَرنُها، ",["ولا صاحِبِ كَنزٍ لا يَفعَلُ فيه حَقَّه",1],"، ",["إلَّا جاءَ كَنزُه يَومَ القيامةِ شُجاعًا أقرَعَ، يَتبَعُه فاتِحًا فاه، فإذا أتاه فرَّ منه، فيُناديه: خُذْ كَنزَك الذي خَبَأتَه، فأنا عنه غَنيٌّ، فإذا رَأى أن لا بُدَّ منه سَلَك يَدَه في فيه، فيَقضَمُها قَضمَ الفَحلِ",2],". قال أبو الزُّبَيرِ: سَمِعتُ عُبَيدَ بنَ عُمَيرٍ يقولُ هذا القَولَ، ثُمَّ سَألنا جابِرَ بنَ عبدِ اللهِ عن ذلك فقال مِثلَ قَولِ عُبَيدِ بنِ عُمَيرٍ. وقال أبو الزُّبَيرِ: سَمِعتُ عُبَيدَ بنَ عُمَيرٍ يقولُ: قال رَجُلٌ: يا رَسولَ اللهِ، ما حَقُّ الإبِلِ؟ قال: حَلَبُها على الماءِ، وإعارةُ دَلوِها، وإعارةُ فحلِها، ومَنيحَتُها، وحَملٌ عليها في سَبيلِ اللهِ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه النسائي (2454) بلفظه، وأحمد (14442)، والدارمي (1658) كلاهما باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"GdeF1WiP","merged":7,"otherRefs":["صحيح البخاري 6957 (صحيح)","صحيح ابن خزيمة 4/ 18 (صحيح)","صحيح ابن خزيمة 4/ 16 (صحيح)","صحيح مسلم 988 (صحيح)","صحيح الجامع 2902 (صحيح)","تخريج المسند لشعيب 6448 (صحيح)"]},{"id":"ق-0194","fp":"966b9fd757ac","stateId":589,"easy":"البخل بما آتى الله من فضله ← شرّ لصاحبه ويطوَّق ما بخل به يوم القيامة","cause":"البخل بما آتى الله من فضله","result":"شرّ لصاحبه ويطوَّق ما بخل به يوم القيامة","explicit":true,"ref":"سورة آل عمران: 180","srcLabel":"القرآن الكريم","quran":{"s":3,"from":180,"to":180,"text":"وَلَا يَحْسَبَنَّ الَّذِينَ يَبْخَلُونَ بِمَا آتَاهُمُ اللَّهُ مِنْ فَضْلِهِ هُوَ خَيْرًا لَهُمْ بَلْ هُوَ شَرٌّ لَهُمْ سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ وَلِلَّهِ مِيرَاثُ السَّمَاوَاتِ وَالْأَرْضِ وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ (180)","hl":[[0,172,1]]}},{"id":"ق-0216","fp":"6d33f9e5b41d","stateId":589,"easy":"البخل والأمر به وكتمان فضل الله ← عذاب مهين","cause":"البخل والأمر به وكتمان فضل الله","result":"عذاب مهين","explicit":true,"ref":"سورة النساء: 37","srcLabel":"القرآن الكريم","quran":{"s":4,"from":37,"to":37,"text":"الَّذِينَ يَبْخَلُونَ وَيَأْمُرُونَ النَّاسَ بِالْبُخْلِ وَيَكْتُمُونَ مَا آتَاهُمُ اللَّهُ مِنْ فَضْلِهِ وَأَعْتَدْنَا لِلْكَافِرِينَ عَذَابًا مُهِينًا (37)","hl":[[0,152,1]]}},{"id":"ق-0495","fp":"f8e1ab50b28f","stateId":589,"easy":"كنز الذهب والفضة وترك الإنفاق في سبيل الله ← عذاب أليم (الكيّ بها)","cause":"كنز الذهب والفضة وترك الإنفاق في سبيل الله","result":"عذاب أليم (الكيّ بها)","explicit":true,"ref":"سورة التوبة: 34–35","srcLabel":"القرآن الكريم","quran":{"s":9,"from":34,"to":35,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنَّ كَثِيرًا مِنَ الْأَحْبَارِ وَالرُّهْبَانِ لَيَأْكُلُونَ أَمْوَالَ النَّاسِ بِالْبَاطِلِ وَيَصُدُّونَ عَنْ سَبِيلِ اللَّهِ وَالَّذِينَ يَكْنِزُونَ الذَّهَبَ وَالْفِضَّةَ وَلَا يُنْفِقُونَهَا فِي سَبِيلِ اللَّهِ فَبَشِّرْهُمْ بِعَذَابٍ أَلِيمٍ (34) يَوْمَ يُحْمَى عَلَيْهَا فِي نَارِ جَهَنَّمَ فَتُكْوَى بِهَا جِبَاهُهُمْ وَجُنُوبُهُمْ وَظُهُورُهُمْ هَذَا مَا كَنَزْتُمْ لِأَنْفُسِكُمْ فَذُوقُوا مَا كُنْتُمْ تَكْنِزُونَ (35)","hl":[[159,455,1]]}},{"id":"ق-1127","fp":"a53fe51ce9b2","stateId":589,"easy":"الشرك ومنع الزكاة والكفر بالآخرة ← الويل","cause":"الشرك ومنع الزكاة والكفر بالآخرة","result":"الويل","explicit":true,"ref":"سورة فصلت: 6–7","srcLabel":"القرآن الكريم","quran":{"s":41,"from":6,"to":7,"text":"قُلْ إِنَّمَا أَنَا بَشَرٌ مِثْلُكُمْ يُوحَى إِلَيَّ أَنَّمَا إِلَهُكُمْ إِلَهٌ وَاحِدٌ فَاسْتَقِيمُوا إِلَيْهِ وَاسْتَغْفِرُوهُ وَوَيْلٌ لِلْمُشْرِكِينَ (6) الَّذِينَ لَا يُؤْتُونَ الزَّكَاةَ وَهُمْ بِالْآخِرَةِ هُمْ كَافِرُونَ (7)","hl":[[129,228,1]]}},{"id":"ق-1375","fp":"0a5fcef4251f","stateId":589,"easy":"عدم الإيمان بالله العظيم وترك الحضّ على طعام المسكين ← الكتاب بالشمال والغلّ والجحيم والسلسلة ولا حميم","cause":"عدم الإيمان بالله العظيم وترك الحضّ على طعام المسكين","result":"الكتاب بالشمال والغلّ والجحيم والسلسلة ولا حميم","explicit":true,"ref":"سورة الحاقة: 25–37","srcLabel":"القرآن الكريم","quran":{"s":69,"from":25,"to":37,"text":"وَأَمَّا مَنْ أُوتِيَ كِتَابَهُ بِشِمَالِهِ فَيَقُولُ يَا لَيْتَنِي لَمْ أُوتَ كِتَابِيَهْ (25) وَلَمْ أَدْرِ مَا حِسَابِيَهْ (26) يَا لَيْتَهَا كَانَتِ الْقَاضِيَةَ (27) مَا أَغْنَى عَنِّي مَالِيَهْ (28) هَلَكَ عَنِّي سُلْطَانِيَهْ (29) خُذُوهُ فَغُلُّوهُ (30) ثُمَّ الْجَحِيمَ صَلُّوهُ (31) ثُمَّ فِي سِلْسِلَةٍ ذَرْعُهَا سَبْعُونَ ذِرَاعًا فَاسْلُكُوهُ (32) إِنَّهُ كَانَ لَا يُؤْمِنُ بِاللَّهِ الْعَظِيمِ (33) وَلَا يَحُضُّ عَلَى طَعَامِ الْمِسْكِينِ (34) فَلَيْسَ لَهُ الْيَوْمَ هَاهُنَا حَمِيمٌ (35) وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍ (36) لَا يَأْكُلُهُ إِلَّا الْخَاطِئُونَ (37)","hl":[[0,582,1]]}},{"id":"ق-1376","fp":"65ab605738aa","stateId":589,"easy":"الإدبار والتولي وجمع المال ومنع حقه ← لظى نزّاعة للشوى","cause":"الإدبار والتولي وجمع المال ومنع حقه","result":"لظى نزّاعة للشوى","explicit":true,"ref":"سورة المعارج: 15–18","srcLabel":"القرآن الكريم","quran":{"s":70,"from":15,"to":18,"text":"كَلَّا إِنَّهَا لَظَى (15) نَزَّاعَةً لِلشَّوَى (16) تَدْعُو مَنْ أَدْبَرَ وَتَوَلَّى (17) وَجَمَعَ فَأَوْعَى (18)","hl":[[0,109,1]]}},{"id":"س-06136","fp":"abe54fec6908","stateId":589,"easy":"إذا كانت لك إبل لا تعطي حقها ← تأتي يوم القيامة كأغذّ ما كانت فتطؤك","cause":"مَن كانت له إبِلٌ لا يُعطي حَقَّها في نَجدَتِها، ورِسلِها","result":"فإنَّها تَأتي يَومَ القيامةِ كأغَذِّ ما كانت، وأكبَرِهِ، وأسمَنِهِ، وآشَرِهِ، ثم يُبطَحُ لها بقاعٍ قَرقَرٍ، فتَطَؤهُ بأخفافِها، إذا جاوَزَتْهُ أُخراها؛ أُعيدَتْ عليه أُولاها، في يَومٍ كان مِقدارُهُ خَمسينَ ألْفَ سَنةٍ، حتى يُقضى بَينَ النَّاسِ فيَرى سَبيلَهُ","explicit":true,"ref":"تخريج المسند لشعيب 10350","srcLabel":"أبو داود","text":["فمَرَّ رَجُلٌ مِن بني عامِرِ بنِ صَعصَعةَ، فقيل له: هذا أكثَرُ عامِريٍّ نادى مالًا. فقال أبو هُرَيرةَ: رُدُّوهُ إليَّ. فرَدُّوهُ عليه، فقال: نُبِّئتُ أنَّكَ ذو مالٍ كثيرٍ. فقال العامِريُّ: إيْ واللهِ؛ إنَّ لي لمِئةً حُمْرًا، ومِئةً أدماءَ، حتى عَدَّ مِن ألوانِ الإبِلِ، وأفنانِ الرَّقيقِ، ورباطِ الخَيلِ، فقال أبو هُرَيرةَ: إيَّاكَ، وأخفافَ الإبِلِ، وأظلافَ الغَنَمِ، يُرَدِّدُ ذلك عليه، حتى جعَلَ لَونُ العامِريِّ يتغَيَّرُ، أو يتلَوَّنُ، فقال: ما ذاك يا أبا هُرَيرةَ؟ قال: سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["مَن كانت له إبِلٌ لا يُعطي حَقَّها في نَجدَتِها، ورِسلِها",1],". قُلنا: يا رسولَ اللهِ، ما نَجدَتُها ورِسلُها؟ قال: في عُسرِها ويُسرِها؛ ",["فإنَّها تَأتي يَومَ القيامةِ كأغَذِّ ما كانت، وأكبَرِهِ، وأسمَنِهِ، وآشَرِهِ، ثم يُبطَحُ لها بقاعٍ قَرقَرٍ، فتَطَؤهُ بأخفافِها، إذا جاوَزَتْهُ أُخراها؛ أُعيدَتْ عليه أُولاها، في يَومٍ كان مِقدارُهُ خَمسينَ ألْفَ سَنةٍ، حتى يُقضى بَينَ النَّاسِ فيَرى سَبيلَهُ",2],"، وإذا كانت له بَقَرٌ لا يُعطي حَقَّها في نَجدَتِها، ورِسلِها؛ فإنَّها تَأتي يَومَ القيامةِ كأغَذِّ ما كانت، وأكبَرِهِ، وأسمَنِهِ، وآشَرِهِ، ثم يُبطَحُ لها بقاعٍ قَرقَرٍ، فتَطَؤهُ كُلُّ ذاتِ ظِلفٍ بظِلفِها، وتَنطَحُهُ كُلُّ ذاتِ قَرنٍ بقَرنِها، إذا جاوَزَتْهُ أُخراها أُعيدَتْ عليه أُولاها، في يَومٍ كان مِقدارُهُ خَمسينَ ألْفَ سَنةٍ، حتى يُقضى بَينَ النَّاسِ، حتى يَرى  سَبيلَهُ، وإذا كانت له غَنَمٌ لا يُعطي حَقَّها في نَجدَتِها ورِسلِها؛ فإنَّها تَأتي يَومَ القِيامةِ كأغَذِّ ما كانتْ، وأكبَرِهِ، وأسمَنِهِ، وآشَرِهِ، ثم يُبطَحُ لها بقاعٍ قَرقَرٍ، فتَطَؤهُ كُلُّ ذاتِ ظِلفٍ بظِلفِها، وتَنطَحُهُ كُلُّ ذاتِ قَرنٍ بقَرنِها -يَعني ليس فيها عَقصاءُ، ولا عَضباءُ- إذا جاوَزَتْهُ أُخراها أُعيدَتْ أُولاها، في يَومٍ كان مِقدارُهُ خَمسينَ ألْفَ سَنةٍ، حتى يُقضى بَينَ النَّاسِ، فيَرى سَبيلَهُ. فقال العامِريُّ: وما حَقُّ الإبِلِ يا أبا هُرَيرةَ؟ قال: أنْ تُعطيَ الكريمةَ، وتَمنَحَ الغَزيرةَ، وتُفقِرَ الظَّهرَ، وتَسقيَ اللَّبَنَ، وتُطرِقَ الفَحلَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1660)، والنسائي (2442)، وأحمد (10350) واللفظ له","bab":"زكاة › عقوبة مانع الزكاة","dorar":"CwOwzfnG","merged":4,"otherRefs":["مجمع الزوائد 3/67 (حسن)","المستدرك على الصحيحين 1484 (صحيح)","صحيح ابن خزيمة 4/ 73 (صحيح)"]},{"id":"س-07407","fp":"e5a812e47e13","stateId":589,"easy":"إذا أغلقت بابك دون جارك وضننت عليه بمالك ← يتعلق بك يوم القيامة","cause":"أغلقَ بابَهُ وضنَّ عني بمالِهِ","result":"وإنَّ الرجلَ ليتعلَّقُ بجارِهِ يوم القيامةِ","explicit":true,"otherNeedIds":[12],"ref":"مسند عمر 1/109","srcLabel":"أبو داود","text":[". . . وأخذتم أذنابَ البقرِ ورضيتم بالزرعِ وتركتم الجهادَ . . . . . ",["وإنَّ الرجلَ ليتعلَّقُ بجارِهِ يوم القيامةِ",2]," إنَّ هذا ",["أغلقَ بابَهُ وضنَّ عني بمالِهِ",1]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3462)، وأحمد (4825) مختصراً باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"XvyiANDN","merged":3,"otherRefs":["السلسلة الصحيحة 2646 (حسن)","الجامع الصغير 6497 (صحيح)"]},{"id":"س-05244","fp":"652b6a7819f8","stateId":589,"easy":"إذا منعت فضل الماء لتمنع به فضل الكلأ ← يمنعك الله فضله يوم القيامة","cause":"مَن منَعَ فَضلَ الماءِ ليَمنَعَ به فَضلَ الكَلأِ","result":"منَعَه اللهُ فَضلَه يومَ القِيامةِ","explicit":true,"repOf":"س-05378","ref":"تخريج المسند لشعيب 6722","text":["أنَّ عبدَ اللهِ بنَ عَمرٍو كتَبَ إلى عاملٍ له على أرضٍ له: أنْ لا تَمنَعَ فَضلَ مائِكَ؛ فإنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن منَعَ فَضلَ الماءِ ليَمنَعَ به فَضلَ الكَلأِ؛ ",1],["منَعَه اللهُ فَضلَه يومَ القِيامةِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (6722) واللفظ له، والطبراني في (13/650) (14576)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"vjBM9HxN","merged":2,"otherRefs":["صحيح الترغيب 897 (حسن)"]},{"id":"س-06158","fp":"2de60697a10f","stateId":589,"easy":"إذا لم تؤدِّ زكاة مالك ← فهو كنز تُعذّب به","cause":"كلَّ مالٍ لا تُؤدَّى زكاتُه","result":"فهو كنزٌ يُعذَّبُ به صاحبُه","explicit":true,"ref":"مجموع فتاوى ابن باز 31/14","srcLabel":"مجموع فتاوى ابن باز","text":["[حديثُ أن ",["كلَّ مالٍ لا تُؤدَّى زكاتُه",1]," ",["فهو كنزٌ يُعذَّبُ به صاحبُه",2],"]"],"grade":"صحيح","muhaddith":"صحيح","bab":"زكاة › عقوبة مانع الزكاة","dorar":"xUZRZIn0","merged":2,"otherRefs":["تخريج شرح السنة 5/477 (حسن)"]},{"id":"س-02964","fp":"c13a66a09a79","stateId":589,"easy":"إذا كنزت المال (تركت دينارين ممن يسأل الناس) ← فهما كيّتان","cause":"فتَرَكَ دينارَينِ","result":"كَيَّتانِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 22172","srcLabel":"أحمد","text":["سَمِعتُ أبا الجَعدِ يُحدِّثُ -قال هاشمٌ في حديثِه: أبو الجَعدِ مَولًى لبَني ضُبَيعةَ- عن أبي أُمامةَ، أنَّ رَجُلًا مِن أهلِ الصُّفَّةِ تُوُفِّيَ وتَرَكَ دينارًا، فقال رسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ له: كَيَّةٌ، قال: ثُمَّ تُوُفِّيَ آخَرُ ",["فتَرَكَ دينارَينِ",1],"، فقال رسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ: ",["كَيَّتانِ",2],"."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه أحمد (22172) واللفظ له، وابن أبي شيبة (12147)، والطبراني (8/311) (8011)","bab":"إيمان › الوعيد","dorar":"NqLm6JMN","merged":12,"otherRefs":["صحيح الترغيب 935 (صحيح)","تخريج المسند لشعيب 3843 (حسن)","تخريج المسند لشاكر 6/40 (صحيح)","السلسلة الصحيحة 2637 (حسن)","مجمع الزوائد 10/243 (صحيح)","تخريج المسند لشعيب 16/253 (صحيح)","صحيح الترغيب 801 (صحيح)","صحيح الموارد 2102 (صحيح)","الصحيح المسند 876 (حسن)","تخريج المسند لشعيب 9538 (صحيح)","الترغيب والترهيب 2/86 (حسن)"]},{"id":"س-03889","fp":"72ca36456961","stateId":589,"easy":"إذا منعت الزكاة ← يُجعل مالك صفائح يُكوى بها","cause":"وأنَّ مانعَ الزكاةِ","result":"يُجعلُ له مالُه صفائحَ يُكوى به","explicit":true,"ref":"فتح الباري لابن رجب 3/436","srcLabel":"فتح الباري لابن رجب","text":[["وأنَّ مانعَ الزكاةِ",1]," ",["يُجعلُ له مالُه صفائحَ يُكوى به",2]," ."],"grade":"صحيح","muhaddith":"صحيح.","bab":"تفسير آيات › سورة التوبة","dorar":"s2Zfx2ls"},{"id":"س-03897","fp":"89eb909e1535","stateId":589,"easy":"إذا كان لك ذهب لا تؤدي ما فيه ← يُجعل لك يوم القيامة صفائح من نار يُكوى بها","cause":"ما من صاحبِ ذَهبٍ لا يؤدِّي ما فيها","result":"إلَّا جعلَ لَهُ يومَ القيامةِ صفائحُ من نارٍ يُكوى بِها","explicit":true,"repOf":"س-07742","ref":"المحلى 6/80","text":[["ما من صاحبِ ذَهبٍ لا يؤدِّي ما فيها",1]," ",["إلَّا جعلَ لَهُ يومَ القيامةِ صفائحُ من نارٍ يُكوى بِها",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"تفسير آيات › سورة التوبة","dorar":"xs3uGIVd"},{"id":"س-04871","fp":"ff2992a6b0eb","stateId":589,"easy":"إذا منعت الزكاة ← تُعذب يوم القيامة بالمال الذي بخلت بزكاته","cause":"مانعُ الزكاةِ","result":"يعذبُ يومَ القيامةِ بالمالِ الذي بخلِ بزكاتِه","explicit":true,"ref":"فتاوى نور على الدرب لابن باز 4/114","srcLabel":"فتاوى نور على الدرب لابن باز","text":[["مانعُ الزكاةِ",1]," ",["يعذبُ يومَ القيامةِ بالمالِ الذي بخلِ بزكاتِه",2],"."],"grade":"صحيح","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"vOoaB8Mi"},{"id":"س-04950","fp":"aef21b196cc7","stateId":589,"easy":"إذا سألك مولاك من فضل عندك فمنعته ← يُدعى لك يوم القيامة فضلك شجاعاً أقرع","cause":"لا يَسأَلُ رَجُلٌ مَوْلاه من فَضلٍ هو عندَه فيمنَعَه إيَّاه","result":"إلَّا دُعِيَ له يومَ القيامةِ فضلُه الذي مَنَعَه شُجاعًا أقرَعَ","explicit":true,"ref":"تخريج سنن أبي داود 5139","srcLabel":"أبو داود","text":["قُلتُ: يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، مَن أبَرُّ؟ قال: أُمَّك، ثمَّ أمَّكَ، ثمَّ أمَّكَ، ثمَّ أباكَ، ثُمَّ الأقربَ فالأقربَ. وقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["لا يَسأَلُ رَجُلٌ مَوْلاه من فَضلٍ هو عندَه فيمنَعَه إيَّاه،",1]," ",["إلَّا دُعِيَ له يومَ القيامةِ فضلُه الذي مَنَعَه شُجاعًا أقرَعَ",2],"."],"grade":"صحيح","narrator":"معاوية بن حيدة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (5139)، واللفظ له، والترمذي (1897)، وأحمد (20028) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ynYrA3Ou"},{"id":"س-05043","fp":"f218e8cace4b","stateId":589,"easy":"إذا ادخرت التمر وخبأته بخلاً ← أما تخشى أن يُخسف به في نار جهنم","cause":"ما عندي إلَّا صُبْرٌ من تمرٍ خبأتُهُ لكَ","result":"أما تخشَى أن يُخسَفَ به في نارِ جهنَّمَ","explicit":true,"similar":["س-06278"],"ref":"معجم الشيوخ 1/285","srcLabel":"البيهقي","text":["أطعِمنا يا بلالُ قالَ : يا رسولَ اللَّهِ ",["ما عندي إلَّا صُبْرٌ من تمرٍ خبأتُهُ لكَ",1]," قال ",["أما تخشَى أن يُخسَفَ به في نارِ جهنَّمَ",2]," أنفِقْ يا بلالُ ولا تَخشَ مِن ذي العرشِ إقلالًا"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"محفوظ من حديث مفضل عن الأعمش","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (1466)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"acQl79uU"},{"id":"س-05161","fp":"cde360743cb8","stateId":589,"easy":"إذا كان لك مال لا تؤدي حقه ← يُجعل طوقاً في عنقك شجاعاً أقرع","cause":"ما مِن رجُلٍ لَهُ مالٌ ، لا يؤدِّي حقَّ مالِهِ","result":"إلَّا جعلَ لَهُ طوقًا في عنقِهِ ، شُجاعٌ أقرَعُ ، وَهوَ يفِرُّ منْهُ ، وَهوَ يتبعُه","explicit":true,"repOf":"س-03021","ref":"صحيح النسائي 2440","text":[["ما مِن رجُلٍ لَهُ مالٌ ، لا يؤدِّي حقَّ مالِهِ ،",1]," ",["إلَّا جعلَ لَهُ طوقًا في عنقِهِ ، شُجاعٌ أقرَعُ ، وَهوَ يفِرُّ منْهُ ، وَهوَ يتبعُه ",2],". ثمَّ قرأَ مِصداقَهُ من كتابِ اللَّهِ عزَّ وجلَّ وَلَا تَحْسِبَنَّ الَّذِينَ يَبْخَلُونَ بِمَا آتَاهُمُ اللَّهُ مِنْ فَضْلِهِ هُوَ خَيْرًا لَهُمْ بَلْ هُوَ شَرٌّ لَهُمْ سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ  الآيةَ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3012) بنحوه مطولاً، والنسائي (2441) واللفظ له، وابن ماجه (1784) بنحوه، وأحمد (3577) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"EMSGK2NO"},{"id":"س-05192","fp":"f3f40dc8c3a4","stateId":589,"easy":"إذا كنت صاحب إبل لا تؤدي حقها ← تأتي يوم القيامة أكثر ما كانت فتطؤك","cause":"ما مِن صاحِبِ إبِلٍ لا يَفعَلُ فيها حَقَّها","result":"إلَّا جاءَت يَومَ القيامةِ أكثَرَ ما كانَت قَطُّ، وقَعَدَ لها بقاعٍ قَرقَرٍ تَستَنُّ عليه بقَوائِمِها وأخفافِها","explicit":true,"repOf":"س-06282","ref":"صحيح مسلم 988","text":[["ما مِن صاحِبِ إبِلٍ لا يَفعَلُ فيها حَقَّها",1],"، ",["إلَّا جاءَت يَومَ القيامةِ أكثَرَ ما كانَت قَطُّ، وقَعَدَ لها بقاعٍ قَرقَرٍ تَستَنُّ عليه بقَوائِمِها وأخفافِها",2],"، ولا صاحِبِ بَقَرٍ لا يَفعَلُ فيها حَقَّها، إلَّا جاءَت يَومَ القيامةِ أكثَرَ ما كانَت، وقَعَدَ لها بقاعٍ قَرقَرٍ تَنطَحُه بقُرونِها، وتَطَؤُه بقَوائِمِها، ولا صاحِبِ غَنَمٍ لا يَفعَلُ فيها حَقَّها، إلَّا جاءَت يَومَ القيامةِ أكثَرَ ما كانَت، وقَعَدَ لها بقاعٍ قَرقَرٍ تَنطَحُه بقُرونِها وتَطَؤُه بأظلافِها، ليس فيها جَمَّاءُ ولا مُنكَسِرٌ قَرنُها، ولا صاحِبِ كَنزٍ لا يَفعَلُ فيه حَقَّه، إلَّا جاءَ كَنزُه يَومَ القيامةِ شُجاعًا أقرَعَ، يَتبَعُه فاتِحًا فاه، فإذا أتاه فرَّ منه، فيُناديه: خُذْ كَنزَك الذي خَبَأتَه، فأنا عنه غَنيٌّ، فإذا رَأى أن لا بُدَّ منه سَلَك يَدَه في فيه، فيَقضَمُها قَضمَ الفَحلِ. قال أبو الزُّبَيرِ: سَمِعتُ عُبَيدَ بنَ عُمَيرٍ يقولُ هذا القَولَ، ثُمَّ سَألنا جابِرَ بنَ عبدِ اللهِ عن ذلك فقال مِثلَ قَولِ عُبَيدِ بنِ عُمَيرٍ. وقال أبو الزُّبَيرِ: سَمِعتُ عُبَيدَ بنَ عُمَيرٍ يقولُ: قال رَجُلٌ: يا رَسولَ اللهِ، ما حَقُّ الإبِلِ؟ قال: حَلَبُها على الماءِ، وإعارةُ دَلوِها، وإعارةُ فحلِها، ومَنيحَتُها، وحَملٌ عليها في سَبيلِ اللهِ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه النسائي (2454) بلفظه، وأحمد (14442)، والدارمي (1658) كلاهما باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"GdeF1WiP"},{"id":"س-05383","fp":"6b0fd3c1af4d","stateId":589,"easy":"إذا منعت فضل مائك أو كلئك ← يمنعك الله فضله يوم القيامة","cause":"مَن مَنَعَ فَضلَ مائِهِ أو فَضلَ كَلَئِهِ","result":"مَنَعَه اللهُ فَضلَه يَومَ القيامَةِ","explicit":true,"ref":"تخريج المسند لشاكر 10/155","srcLabel":"أحمد","text":[["مَن مَنَعَ فَضلَ مائِهِ أو فَضلَ كَلَئِهِ",1]," ",["مَنَعَه اللهُ فَضلَه يَومَ القيامَةِ",2]],"grade":"صحيح","narrator":"[جد عمرو بن شعيب]","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6673) واللفظ له، والطبراني في ((الأوسط)) (1195) بنحوه مع زيادة في أوله، وابن زنجويه في ((الأموال)) (1093) باختلاف يسير.","bab":"رقائق وزهد › الجزاء من جنس العمل","dorar":"p4NbkOJo"},{"id":"س-06147","fp":"d4409b1d9582","stateId":589,"easy":"إذا رفعت الدنانير والدراهم لا تعدها لغريم ولا تنفقها في سبيل الله ← فهي كنز تُكوى به","cause":"ومَن رَفَع دَنانيرَ ودَراهِمَ أو تِبرًا أو فِضَّةً لا يَعُدُّها لغَريمٍ","result":"ولا يُنفِقُها في سَبيلِ اللهِ فهو كَنزٌ يُكوَى به يَومَ القِيامةِ","explicit":true,"ref":"المستدرك على الصحيحين 1449","srcLabel":"أحمد","text":["في الإِبِلِ صَدَقَتُها، وفي الغَنَمِ صَدَقَتُها، وفي البَقَرِ صَدَقَتُها، وفي البُرِّ صَدَقَتُه، ",["ومَن رَفَع دَنانيرَ ودَراهِمَ أو تِبرًا أو فِضَّةً لا يَعُدُّها لغَريمٍ، ",1],["ولا يُنفِقُها في سَبيلِ اللهِ فهو كَنزٌ يُكوَى به يَومَ القِيامةِ",2],"."],"grade":"صحيح","narrator":"أبو ذر","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (21557)، وابن أبي شيبة (10700)، والدارقطني (1933) واللفظ لهم.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"a0V37BJc"},{"id":"س-06148","fp":"7e593a58e48f","stateId":589,"easy":"إذا لم تؤدِّ زكاة مالك ← يجعل الله في عنقك يوم القيامة شجاعاً","cause":"ما مِن رجُلٍ لَا يؤدِّي زَكاةَ مالِهِ","result":"إلَّا جعلَ اللَّهُ يومَ القيامةِ في عُنقِهِ شجاعًا ، ثمَّ قرأَ علَينا مصداقَهُ من كتابِ اللَّهِ : (وَلَا يَحْسَبَنَّ الَّذِينَ يَبْخَلُونَ بِمَا آتَاهُمُ اللَّهُ مِنْ فَضْلِهِ) الآيةَ","explicit":true,"repOf":"س-03021","ref":"صحيح الترمذي 3012","text":[["ما مِن رجُلٍ لَا يؤدِّي زَكاةَ مالِهِ",1]," ",["إلَّا جعلَ اللَّهُ يومَ القيامةِ في عُنقِهِ شجاعًا ، ثمَّ قرأَ علَينا مصداقَهُ من كتابِ اللَّهِ : (وَلَا يَحْسَبَنَّ الَّذِينَ يَبْخَلُونَ بِمَا آتَاهُمُ اللَّهُ مِنْ فَضْلِهِ) الآيةَ ",2],"، وقالَ مرَّةً : قرأَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ مِصداقَهُ : ( سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ) ومن اقتطعَ مالَ أخيهِ المسلمِ بيَمينٍ لقيَ اللَّهَ وَهوَ علَيهِ غضبانُ ، ثمَّ قَرأَ رسولُ اللَّهِ مِصداقَهُ من كتابِ اللَّهِ : (إِنَّ الَّذِينَ يَشْتَرُونَ بعَهْدِ اللَّهِ)"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3012) واللفظ له، والنسائي (2441)، وأحمد (3577) بنحوه، وابن ماجه (1784) مختصراً","bab":"زكاة › عقوبة مانع الزكاة","dorar":"cew4VdCg"},{"id":"س-06150","fp":"94f548e0fffa","stateId":589,"easy":"إذا لم تؤدِّ زكاة حليك ← يسوّرك الله بسوارين من نار","cause":"أَتُعطِين زكاةَ هذا ؟ قالت : لا","result":"أَيَسُرُّكِ أن يُسَوِّرَكِ اللهُ بهما يومَ القيامةِ بسِوَارَينِ من نارٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-04968"],"ref":"البدر المنير 5/565","srcLabel":"أبو داود","text":["أنَّ امرأةً أتتْ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ومعَها ابنةٌ لها ، وفي يدِ ابنَتِها مَسَكَتانِ غَليظتانِ من ذَهَبٍ ، فقال لها : ",["أَتُعطِين زكاةَ هذا ؟ قالت : لا",1]," ، قال : ",["أَيَسُرُّكِ أن يُسَوِّرَكِ اللهُ بهما يومَ القيامةِ بسِوَارَينِ من نارٍ",2]," ؟ قال : فخلَعَتْهُما فَأَلْقَتْهُما إلى رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ وقالت : هُما للهِ ولرسولِه"],"grade":"صحيح","narrator":"[جد عمرو بن شعيب]","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1563) بلفظه، والنسائي (2479) باختلاف يسير، والترمذي (637) بلفظ مقارب.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"jkNgriu0","merged":9,"otherRefs":["إرواء الغليل 3/296 (حسن)","صحيح الترغيب 770 (صحيح)","تخريج المسند لشاكر 11/124 (صحيح)","عمدة القاري 9/49 (صحيح)","فتاوى نور على الدرب لابن باز 15/150 (صحيح)","البدر المنير 5/564 (صحيح)","مجموع فتاوى ابن عثيمين 547/18 (حسن)","مجموع فتاوى ابن باز 125/4 (صحيح)"]},{"id":"س-06157","fp":"a02a237f502c","stateId":589,"easy":"إذا لم تؤدِّ زكاة كنزك ← تُعذّب به يوم القيامة في يوم مقداره خمسون ألف سنة","cause":"الذين لا يُؤدُّون زكاتَها","result":"يُعذَّبون بها يومَ القيامةِ في يومٍ كان مِقدارُه خمسينَ ألفَ سنةٍ","explicit":true,"repOf":"س-03021","ref":"مجموع فتاوى ابن باز 12/9","text":["[أحاديثُ أن أهلَ الأموالِ ",["الذين لا يُؤدُّون زكاتَها",1]," ",["يُعذَّبون بها يومَ القيامةِ في يومٍ كان مِقدارُه خمسينَ ألفَ سنةٍ",2],"]"],"grade":"صحيح","muhaddith":"صحيحة","bab":"زكاة › عقوبة مانع الزكاة","dorar":"lYjsUo8P"},{"id":"س-06278","fp":"020b8bc8ee65","stateId":589,"easy":"إذا ادخرت الطعام بخلاً ← أما تخشى أن يُجعل لك بخار في نار جهنم","cause":"ادَّخَرْتُه لك","result":"أما تخشى أن يُجعَل لك بخارٌ في نارِ جهنَّمَ","explicit":true,"repOf":"س-05043","ref":"صحيح الترغيب 922","text":["ما هذا يا بلالُ ! . قال : ",["ادَّخَرْتُه لك",1]," يا رسولَ اللهِ ! قال : ",["أما تخشى أن يُجعَل لك بخارٌ في نارِ جهنَّمَ",2]," ؟ ! أَنفِقْ يا بلالُ ! و لا تخشَ من ذي العرشِ إقْلالًا"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه مطولاً الطبراني (1/342) (1028) واللفظ له، وأبو نعيم في ((حلية الأولياء)) (2/280)، والبيهقي في ((شعب الإيمان)) (1345) باختلاف يسير.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"D8XjFyAh"},{"id":"س-06317","fp":"12ecce15b6b5","stateId":589,"easy":"إذا ادخرت لأضيافك بخلاً على المحتاج ← أما تخشى أن يفور له بخار في جهنم","cause":"أعدُّ ذلِكَ لأضيافِكَ","result":"أمَّا تخشَى أن يفورَ لهُ بخارٌ في نارِ جهنَّمَ","explicit":true,"ref":"صحيح الترغيب 921","srcLabel":"الطبراني","text":["ما هذا يا بِلالُ ؟ . قال : ",["أعدُّ ذلِكَ لأضيافِكَ",1]," . قالَ : ",["أمَّا تخشَى أن يفورَ لهُ بخارٌ في نارِ جهنَّمَ",2]," ؟ ! أنفِقْ بلالُ ! و لا تَخشَ من ذيِ العرشِ إقلالًا"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح لغيره","takhrij":"أخرجه البزار (1978)، والطبراني (1/340) (1023)، وأبو نعيم في ((حلية الأولياء)) (1/149) باختلاف يسير","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"0TkO360q"},{"id":"س-07324","fp":"04077ce4a802","stateId":589,"easy":"إذا بخلت بما آتاك الله ← تُطوّق به يوم القيامة ثعباناً ينقر رأسك","cause":"سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ","result":"يَجيئُهُ ثُعبانٌ، فيَنقُرُ رأسَهُ، ثُمَّ يتطَوَّقُ في عُنقِهِ، ثُمَّ يقولُ: أنا مالُكَ الَّذي بَخِلْتَ به","explicit":true,"ref":"المستدرك على الصحيحين 3211","srcLabel":"الحاكم","text":["عنْ عبدِ اللهِ بنِ مسعودٍ في قولِهِ: {",["سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ",1],"} [آل عمران: 180]، قالَ: قالَ عبدُ اللهِ: ",["يَجيئُهُ ثُعبانٌ، فيَنقُرُ رأسَهُ، ثُمَّ يتطَوَّقُ في عُنقِهِ، ثُمَّ يقولُ: أنا مالُكَ الَّذي بَخِلْتَ به",2],"."],"grade":"صحيح","narrator":"أبو وائل","muhaddith":"صحيح على شرط الشيخين","bab":"فتن › فتنة المال","dorar":"qKDiaUaR"},{"id":"س-07438","fp":"76ce67a4106e","stateId":589,"easy":"إذا لم تؤدِّ زكاتك ← يُجعل لك يوم القيامة شجاع يُطوّق في عنقك","cause":"ما مِن رجلٍ لا يؤدِّي زَكاتَهُ","result":"إلَّا جُعِلَ لَهُ يومَ القيامةِ شجاعٌ طوِّقَ في عنقِهِ يومَ القيامةِ","explicit":true,"repOf":"س-03021","ref":"صحيح ابن خزيمة 4/ 17","text":[["ما مِن رجلٍ لا يؤدِّي زَكاتَهُ",1],"، ",["إلَّا جُعِلَ لَهُ يومَ القيامةِ شجاعٌ طوِّقَ في عنقِهِ يومَ القيامةِ",2]," ثمَّ قرأَ علَينا النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ مصداقَهُ مِن كتابِ اللَّهِ {سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ} [آل عمران: 180]"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البيهقي (7304) بلفظه، والنسائي (2441)، وأحمد (3577) بنحوه","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"YH9fAVPr"},{"id":"س-07459","fp":"df34e625130c","stateId":589,"easy":"إذا منعت زكاة مالك ← يُجعل لك شجاع أقرع يتبعك يقول: أنا كنزك","cause":"لا يمنعُ عبدٌ زكاةَ مالِهِ","result":"إلا جُعِلَ له شجاعٌ أقرعُ يتْبَعُهُ يفرُّ منهُ وهو يَتْبَعُهُ فيقولُ : أنا كنزُكَ ، ثم قرأَ عبدُ اللهِ مصداقَه في كتابِ اللهِ","explicit":true,"ref":"تخريج المسند لشاكر 5/200","srcLabel":"الترمذي","text":[["لا يمنعُ عبدٌ زكاةَ مالِهِ",1]," ",["إلا جُعِلَ له شجاعٌ أقرعُ يتْبَعُهُ يفرُّ منهُ وهو يَتْبَعُهُ فيقولُ : أنا كنزُكَ ، ثم قرأَ عبدُ اللهِ مصداقَه في كتابِ اللهِ ",2],"{ سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ } قالَ سفيانُ مرةً : يُطَوِّقُهُ في عنقِه"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (3577)، واللفظ له، والترمذي (3012)، وابن ماجه (1784)، باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"H5mmEuGt"},{"id":"س-07473","fp":"f4795b963b3f","stateId":589,"easy":"إذا لم تؤدِّ زكاة مالك ← يُجعل يوم القيامة شجاعاً أقرع يتبعك","cause":"ما من رَجلٍ لا يُؤدِّي زكاةَ مالِه","result":"إلَّا جُعِلَ له يومَ القيامةِ شُجاعًا أقرَعَ، يَفِرُّ منه، ويَتبَعُه، حتى يُطوَّقَ به عُنُقُه، ثُم قرَأَ علينا النَّبيُّ صلَّى اللهُ عليه وسلَّمَ","explicit":true,"repOf":"س-03021","ref":"تخريج مشكل الآثار 6147","text":[["ما من رَجلٍ لا يُؤدِّي زكاةَ مالِه",1]," ",["إلَّا جُعِلَ له يومَ القيامةِ شُجاعًا أقرَعَ، يَفِرُّ منه، ويَتبَعُه، حتى يُطوَّقَ به عُنُقُه، ثُم قرَأَ علينا النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",2],"{سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ} [آل عمران: 180]."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (6147) بلفظه، والنسائي (2441)، وابن ماجه (1784) كلاهما باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"AfODdjMg"},{"id":"س-04968","fp":"ee92fb42ec10","stateId":589,"easy":"إذا لم تؤدِّ زكاة حليك ← فهي حسبك من النار","cause":"أَتُؤَدِّين زَكاتَهُنَّ؟ فقُلتُ: لا","result":"هي حَسبُكِ منَ النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-06150","ref":"المستدرك على الصحيحين 1455","text":["عنْ عَبدِ اللهِ بنِ شَدَّادِ بنِ الهادِ، قالَ: دَخَلْنا على عائشةَ زَوجِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فقالتْ: دَخَل عَلَيَّ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فرأى في يَدِي سِخابًا من وَرِقٍ، فقالَ: ما هذا يا عائشةُ؟ فقلت: صَنعتُهُنَّ أتزَيَّنُ لكَ فيهِنَّ يا رَسولَ اللهِ، فقالَ: ",["أَتُؤَدِّين زَكاتَهُنَّ؟ فقُلتُ: لا",1],"، أو ما شاءَ اللهُ من ذلكَ. قالَ: ",["هي حَسبُكِ منَ النَّارِ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه البيهقي في ((السنن الصغير)) (1202) بلفظه، وأبو داود (1565)، والدارقطني (1951) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"vIPBs2LU","merged":2,"otherRefs":["الزواجر عن اقتراف الكبائر 1/171 (صحيح)"]},{"id":"س-05218","fp":"f1807496feaa","stateId":589,"easy":"إذا ادخرت لغد بخلاً ← تخشى أن ترى له بخاراً في جهنم","cause":"شيءٌ ادَّخَرْتُهُ لِغَدٍ","result":"أَمَا تَخْشَى أن تَرَى له غَدًا بُخَارًا في نارِ جهنمَ يومَ القيامةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"هداية الرواة 1826","srcLabel":"الطبراني","text":["أن النبيَّ - صلَّى اللهُ عليهِ وسلَّم - دخل على بلالٍ وعنده صُبْرَةٌ من تَمْرٍ، فقال : ما هذا يا بلالُ ؟ !، قال : ",["شيءٌ ادَّخَرْتُهُ لِغَدٍ",1],"، فقال : ",["أَمَا تَخْشَى أن تَرَى له غَدًا بُخَارًا في نارِ جهنمَ يومَ القيامةِ",2]," ؟ ! أَنْفِقْ بلالُ ! ولا تَخْشَ من ذِي العرشِ إِقْلالًا"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (3067) بلفظه، والطبراني (10/ 155) (10300)، والبزار (1978)، والحارث بن أبي أسامة كما في ((بغية الباحث)) (941) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"b9nTN8iW","merged":2,"otherRefs":["إتحاف الخيرة المهرة 4/ 177 (حسن)"]},{"id":"س-01712","fp":"58d9bcd2d875","stateId":589,"easy":"إذا سُئلت بوجه الله فرددت السائل وأنت قادر ← تقف يوم القيامة وليس على وجهك جلد ولا لحم","cause":"من سُئِلَ بوجْهِ اللهِ فردَّ سائلَهُ وهو يَقدرُ","result":"وقفَ يومَ القيامةِ وليس على وجهِهِ جلدٌ ولا لحمٌ ولا عظمَ يَتقعقعُ","explicit":true,"ref":"الإصابة في تمييز الصحابة 1/434","srcLabel":"الطبراني","text":["عن أبي أمامةَ الباهليِّ أنَّ رسولَ اللهِ صلَّى اللهِ عليْهِ وآلِه وسلَّمَ قال لأصحابِهِ : ألَا أُحدِّثُكم عنِ الخَضرِ ؟ قالوا : بلى يا رسولَ اللهِ ، قال : بينما هو ذاتَ يومٍ يَمشي في سوقِ بني إسرائيلَ أبصرَهُ رجلٌ مكاتبٌ ، فقال : تصدَّقْ عليَّ باركَ اللهُ فيك ، قال الخضرُ : آمنْتُ باللهِ ما شاء اللهُ من أمرٍ يكنْ . ما عندي من شيءٍ أُعطيكَهُ ، فقال المسكينُ : أسألُكَ بوجهِ اللهِ لما تصدقْتَ عليَّ فإنِّي نظرْتُ السماحةَ في وجهِكَ ، ورجوْتُ البركةَ عِندَكَ ، فقال الخضرُ : آمنْتُ باللهِ ما عندي شيءٌ أُعطيكَهُ إلَّا أن تأخذَني فتَبيعَني فقال المسكينُ : وهل يستقيمُ هذا ؟ قال : نعم الحقَّ أقولُ : لقد سألتَني بأمرٍ عظيمٍ أما إنِّي لا أُخيبُكَ بوجهِ ربِّي بِعْني . قال : فقدَّمَهُ إلى السوقِ فباعَهُ بأربعِمائةِ درهمٍ فمكثَ عِندَ المُشتري زمانًا لا يَستعملُهُ في شيءٍ ، فقال له إنَّكَ إنَّما اشتريتَني الْتماسَ خيرٍ عندي فأوصِني بعملٍ ، قال : أكرَهُ أنْ أشقَّ عليكَ إنَّكَ شيخٌ كبيرٌ ضعيفٌ قال ليس يشقُّ عليَّ قال فقمْ فانقلْ هذه الحجارةَ وكان لا ينقلُها دونَ ستةِ نفرٍ في يومٍ فخرجَ الرجلُ لبعضِ حاجتِهِ ثم انصرفَ ، وقد نقلَ الحجارةَ في ساعةٍ فقال : أحسنْتَ وأجملْتَ وأطقْتَ ما لم أركَ تُطيقُهُ ، قال : ثم عرضَ للرجلِ سفرٌ ، فقال إنِّي أحسبُكَ أمينًا ، فاخلُفْني في أهلي خلافةً حسنةً . قال : نعم وأوصني بعملٍ قال : إنِّي أكرَهُ أن أشقَّ عليك قال : ليس يشقُّ عليَّ ، قال فاضربْ منَ اللبنِ لبَيتي حتى أقدمَ عليك ، قال ومرَّ الرجلُ لسفرِهِ ، ثم رجع وقد شيَّدَ بناءَهُ ، فقال : أسألُكَ بوجهِ اللهِ ما سبيلُكَ ؟ وما أمرُكَ ؟ قال سألتَني بوجهِ اللهِ ووجهِ اللهِ أوقعَني في العبوديةِ ، فقال الخَضِرُ : سأخبرُكَ من أنا ، أنا الخضرُ الذي سمعْتَ به ، سألَني مسكينٌ صدقةً ، فلم يكنْ عندي شيءٌ أعطيهِ فسألَني بوجهِ اللهِ ، فمكنْتُهُ من رَقبتي فباعَني وأخبرُكَ أنَّهُ ",["من سُئِلَ بوجْهِ اللهِ فردَّ سائلَهُ وهو يَقدرُ",1]," ",["وقفَ يومَ القيامةِ وليس على وجهِهِ جلدٌ ولا لحمٌ ولا عظمَ يَتقعقعُ",2]," ، فقال الرجلُ آمنْتُ باللهِ شققْتُ عليك يا نبيَّ اللهِ ولم أعلمْ ، قال : لا بأسَ أحسنْتَ وأبقيْتَ فقال الرجلُ : بأبي وأمي يا نبيَّ اللهِ احكمْ في أهلي ومالي بما شئْتَ ، أوِ اخترْ فأُخلِّي سبيلَكَ ، قال : أحبُّ أن تخليَ سبيلي ، فأعبدَ ربِّي . قال فخلَّى سبيلَهُ ، فقال الخضرُ : الحمدُ للهِ الذي أوقعَني في العبوديةِ ثم نجَّاني منها"],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"إسناده حسن لولا عنعنة بقية","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (1877)، والطبراني (8/132) (7530)، وابن عدي في ((الكامل في الضعفاء)) (2/76) باختلاف يسير.","bab":"أنبياء › الخضر","dorar":"LF1eFm1g"},{"id":"س-03847","fp":"90f02d24527d","stateId":589,"easy":"إذا سألك ابن عمك من فضلك فمنعته ← يمنعك الله فضله يوم القيامة","cause":"أيما رجلٍ أتاه ابنُ عمِّه يسألُه من فضلِه ، فمنعه","result":"منعه اللهُ فضلَه يومَ القيامةِ","explicit":true,"ref":"صحيح الترغيب 897","srcLabel":"أحمد","text":[["أيما رجلٍ أتاه ابنُ عمِّه يسألُه من فضلِه ، فمنعه ، ",1],["منعه اللهُ فضلَه يومَ القيامةِ ",2],"[ومَن مَنَعَ فَضلَ الماءِ ليَمنَعَ به فَضلَ الكَلأِ، مَنَعَه اللهُ فَضلَه يَومَ القيامةِ]"],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (6673) مختصراً باختلاف يسير، والطبراني في ((المعجم الأوسط)) (1195) باختلاف يسير","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"VO3fkAqL"},{"id":"س-04180","fp":"8b6659eae6be","stateId":589,"easy":"إذا آتاك الله علماً فبخلت به أو اشتريت به ثمناً قليلاً ← تُلجم يوم القيامة بلجام من نار","cause":"مَن آتاهُ اللَّهُ عِلمًا فبخِلَ بهِ عن عبادِه وأخذَ عليهِ طَمَعًا واشتَرى بهِ ثمنًا","result":"فذلكَ يُلجَمُ يومَ القيامةِ بلِجامٍ مِن نارٍ ، ويُنادي مُنادٍ هذا الَّذي آتاهُ اللَّهُ عِلمًا فبَخلَ بهِ عن عِبادِهِ وأخذَ علَيهِ طمَعًا واشتَرى بهِ ثَمنًا وَكَذلِكَ حتَّى يُفرَغَ مِنَ الحسابِ","explicit":true,"ref":"البدور السافرة 96","srcLabel":"الطبراني","text":[["مَن آتاهُ اللَّهُ عِلمًا فبخِلَ بهِ عن عبادِه وأخذَ عليهِ طَمَعًا واشتَرى بهِ ثمنًا ",1],["فذلكَ يُلجَمُ يومَ القيامةِ بلِجامٍ مِن نارٍ ، ويُنادي مُنادٍ هذا الَّذي آتاهُ اللَّهُ عِلمًا فبَخلَ بهِ عن عِبادِهِ وأخذَ علَيهِ طمَعًا واشتَرى بهِ ثَمنًا وَكَذلِكَ حتَّى يُفرَغَ مِنَ الحسابِ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (7187) مطولا باختلاف يسير، وأبو يعلى (2585)، والعقيلي في ((الضعفاء الكبير)) (4/ 206) مختصرا.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"LELYX4lu"},{"id":"س-05648","fp":"e513d44ecc59","stateId":589,"easy":"إذا لبستِ الذهب (بلا زكاة) ← يُخاف عليك اللهب (أثر أبي هريرة)","cause":"تَلْبَسي الذَّهَبَ","result":"فإنِّي أخافُ عليكِ اللَّهَبَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج شرح السنة 12/71","srcLabel":"البيهقي","text":["أنَّ أبا هُريرةَ كانَ يقولُ لابنتِهِ: لا ",["تَلْبَسي الذَّهَبَ",1],"؛ ",["فإنِّي أخافُ عليكِ اللَّهَبَ",2],"."],"grade":"صحيح","narrator":"محمد بن سيرين","muhaddith":"إسناده صحيح","takhrij":"أخرجه عبد الرزاق (19938)، والبيهقي في ((شعب الإيمان)) (5781)، وأبو نعيم في ((حلية الأولياء)) (1/ 380) واللفظ لهم.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"OlZZPDlW"},{"id":"س-06145","fp":"2abe069b4706","stateId":589,"easy":"إذا كان لك مال لم تؤدِّ زكاته ← تُطوّقه يوم القيامة شجاعاً أقرع يقول: أنا مالك","cause":"مَن كان له مالٌ لم يؤدِّ زكاتَه","result":"طُوِّقَه يومَ القيامةِ شجاعًا أقرعَ ينقُرُ رأسَه فيقولُ أنا مالُك الذي كنتَ تبخلُ به سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ","explicit":true,"repOf":"س-03021","ref":"مجمع الزوائد 6/332","text":["عن عبدِ اللهِ يعنِي ابنَ مسعودٍ في قولٍه  سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ  قال يُطوَّقُ شجاعًا أقرعَ بفِيه زبيبتانِ يَنقُرُ رأسَه فيقولُ مالِي ومالَك فيقولُ أنا مالُك الذي بخلتَ به ، وفي روايةٍ عن عبدِ اللهِ أيضًا قال ",["مَن كان له مالٌ لم يؤدِّ زكاتَه ",1],["طُوِّقَه يومَ القيامةِ شجاعًا أقرعَ ينقُرُ رأسَه فيقولُ أنا مالُك الذي كنتَ تبخلُ به  سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ",2]],"grade":"حسن","narrator":"[شقيق بن سلمة]","muhaddith":"[روي] بأسانيد ورجال أحدها ثقات","takhrij":"أخرجه الطبراني (9/ 230) (9125) واللفظ له، والحاكم في ((مستدركه)) (3205)، وابن أبي شيبة في ((مصنفه)) (10698)كلاهما باختلاف يسير، وابن خزيمة في ((صحيحه)) (2256) بمعناه.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"DahJ883I"},{"id":"س-06133","fp":"c29c299fa49b","stateId":589,"easy":"إذا لم تعطِ الإبل حقها ← تطؤك بأخفافها","cause":"إذا هيَ لم يُعْطِ فيها حقَّها","result":"تَطَؤُهُ بأخْفافِها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-06143","ref":"صحيح الجامع 2902","text":["تأتي الإبلُ على ربِّها على خيرِ ما كانتْ ، ",["إذا هيَ لم يُعْطِ فيها حقَّها",1]," ، ",["تَطَؤُهُ بأخْفافِها",2]," ، وتأتي الغَنمُ على ربِّها على خيرِ ما كانتْ ، إذا لمْ يُعْطِ فيها حقَّها ، تَطَؤُهُ بأظْلافِها ، وتنطَحُه بِقُرُونِها ، ومن حقِّها أن تُحلَبَ على الماءِ ، ألا لا يَأْتِيَنَّ أحدُكم يَومَ القيامةِ بِبعيرٍ يَحملُهُ على رقَبتِه ، له رُغاءٌ ، فيقولُ : يا محمدُ ! فأقولُ : لا أملِكُ لك شيئًا قد بَلَّغتُ ، ألا لا يَأْتِيَنَّ أحدُكم يَومَ القيامةِ بِشاةٍ يحملُها على رقبتِه لها يُعارٌ ، فيقولُ : يا محمدُ ! فأقولُ : لا أملكُ لك شيئًا قد بَلَّغتُ ، ويكونُ كنزُ أحدِكم يومَ القيامةِ شُجاعًا أقرَعَ ، يَفِرُّ منه صاحبُه ، ويطلُبُه : أنا كَنزُكَ ، فلا يزالُ حتى يُلْقِمَهُ  إِصْبَعَهُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1402)، ومسلم (987) باختلاف يسير.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"CIymNJ8J"},{"id":"س-06134","fp":"372b7ecb214d","stateId":589,"easy":"إذا لم تعطِ الغنم حقها ← تطؤك بأظلافها وتنطحك بقرونها","cause":"إذا لمْ يُعْطِ فيها حقَّها","result":"تَطَؤُهُ بأظْلافِها ، وتنطَحُه بِقُرُونِها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الجامع 2902","srcLabel":"متفق عليه","text":["تأتي الإبلُ على ربِّها على خيرِ ما كانتْ ، إذا هيَ لم يُعْطِ فيها حقَّها ، تَطَؤُهُ بأخْفافِها ، وتأتي الغَنمُ على ربِّها على خيرِ ما كانتْ ، ",["إذا لمْ يُعْطِ فيها حقَّها",1]," ، ",["تَطَؤُهُ بأظْلافِها ، وتنطَحُه بِقُرُونِها",2]," ، ومن حقِّها أن تُحلَبَ على الماءِ ، ألا لا يَأْتِيَنَّ أحدُكم يَومَ القيامةِ بِبعيرٍ يَحملُهُ على رقَبتِه ، له رُغاءٌ ، فيقولُ : يا محمدُ ! فأقولُ : لا أملِكُ لك شيئًا قد بَلَّغتُ ، ألا لا يَأْتِيَنَّ أحدُكم يَومَ القيامةِ بِشاةٍ يحملُها على رقبتِه لها يُعارٌ ، فيقولُ : يا محمدُ ! فأقولُ : لا أملكُ لك شيئًا قد بَلَّغتُ ، ويكونُ كنزُ أحدِكم يومَ القيامةِ شُجاعًا أقرَعَ ، يَفِرُّ منه صاحبُه ، ويطلُبُه : أنا كَنزُكَ ، فلا يزالُ حتى يُلْقِمَهُ  إِصْبَعَهُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1402)، ومسلم (987) باختلاف يسير.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"CIymNJ8J"},{"id":"س-06127","fp":"72a3e74ad101","stateId":589,"easy":"إذا كثر مالك ← فويل لك إلا أن تنفقه هكذا وهكذا","cause":"لمُكثِرينَ","result":"ويلٌ ل","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الترغيب 3262","srcLabel":"ابن ماجه","text":[["ويلٌ ل",2],["لمُكثِرينَ ",1],"[يعني حديث: ويلٌ للمُكثِرينَ، إلَّا مَن قالَ بالمالِ هكذا، وهكذا، وهكذا، وهكذا)، أرْبَعٌ: عن يَمينِه، وعن شِمالِه، ومِن قُدَّامِه، ومِن وَرائِه.]"],"grade":"صحيح","narrator":"[أبو سعيد الخدري]","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (4129)، واللفظ له، وأحمد (11491)، وأبو يعلى (1083)، بنحوه.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"frKRd3Wy"},{"id":"س-07329","fp":"ff756cdc4abf","stateId":589,"easy":"إذا جمعت المال ولم تقدّم خيراً ← يُمضى بك إلى النار","cause":"جمعتهُ وثمَّرتهُ فتركتهُ أكثرُ ما كان","result":"فإذا عبدٌ لم يقدِّمْ خيرًا فيُمضى به إلى النارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"التذكرة للقرطبي 265","srcLabel":"الترمذي","text":["يجاءُ بابنِ آدمَ يومَ القيامةِ فيوقَفُ بين يديِ اللهِ تعالى فيقولُ لهُ : أعطيتُك وخوَّلتُك وأنعمتُ عليك ، فماذا صنعتَ ؟ فيقولُ : يا ربِّ ",["جمعتهُ وثمَّرتهُ فتركتهُ أكثرُ ما كان",1]," فارجعْني آتيكَ به فيقولُ اللهُ تعالى : أرِني ما قدَّمتَ فيقولُ : ",["فإذا عبدٌ لم يقدِّمْ خيرًا فيُمضى به إلى النارِ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2427) باختلاف يسير، وأبو يعلى (4121)، وأبو نعيم في ((حلية الأولياء)) (6/310) بنحوه","bab":"فتن › فتنة المال","dorar":"EEu0wxP8"},{"id":"س-01414","fp":"3b8b8d2938ba","stateId":590,"easy":"إذا لم تسبغ الوضوء ← فويل للأعقاب من النار","cause":"أسبِغوا الوُضوءَ","result":"وَيْلٌ لِلأَعْقابِ مِن النَّارِ","explicit":true,"star":true,"similar":["س-07207","س-01378"],"ref":"تخريج المسند لشعيب 9304","srcLabel":"متفق عليه","text":["كان أبو هُرَيرةَ يأتي على النَّاسِ وهم يتوضَّؤون في المَطْهَرةِ، فيَقولُ لهم: ",["أسبِغوا الوُضوءَ",1],"، أسبِغوا الوُضوءَ؛ فإنِّي سمِعتُ أبا القاسِمِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["وَيْلٌ لِلأَعْقابِ مِن النَّارِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (165)، ومسلم (242)، والترمذي (41)، والنسائي (110)، وابن ماجه (453)، وأحمد (9304) واللفظ له","bab":"وضوء › صفة الوضوء","dorar":"lkVRhEbq","merged":3,"otherRefs":["صحيح البخاري 165 (صحيح)","صحيح مسلم 242 (صحيح)"]},{"id":"س-06642","fp":"bf43eb260dc1","stateId":590,"easy":"إذا انتقصت من الصلوات استخفافاً ← لم يكن لك عند الله عهد","cause":"ومَن جاءَ بِهنَّ قد انْتَقَصَ مِنه شَيئًا اسْتِخْفافًا بحَقِّهنَّ","result":"لم يكنْ له عِنْدَ اللهِ عَهْدٌ؛ إن شاءَ عَذَّبَه، وإن شاءَ غَفَرَ له","explicit":true,"star":true,"ref":"الأحاديث المختارة 8 / 366","srcLabel":"متفق عليه","text":["«سألَ رَجُلٌ أبا مُحمَّدٍ -رَجُلًا مِن الأنْصارِ- عن الوِتْرِ، فقالَ: الوِتْرُ واجِبٌ كوُجوبِ الصَّلاةِ فأتى عُبادةَ فذَكَرَ ذلك له، فقالَ: كَذَبَ أبو مُحمَّدٍ، سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: (خَمْسُ صَلَواتٍ افْتَرَضَهنَّ اللهُ على عِبادِه، فمَن جاءَ بِهنَّ لم يَنْتَقِصْ مِنه شَيئًا اسْتِخْفافًا بحَقِّها فإنَّ اللهَ جاعِلٌ لهم يَوْمَ القِيامةِ عَهْدًا أن يُدخِلَه الجنَّةَ، ",["ومَن جاءَ بِهنَّ قد انْتَقَصَ مِنه شَيئًا اسْتِخْفافًا بحَقِّهنَّ",1]," ",["لم يكنْ له عِنْدَ اللهِ عَهْدٌ؛ إن شاءَ عَذَّبَه، وإن شاءَ غَفَرَ له",2],"»)."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"8iPRmKyK","merged":3,"otherRefs":["صحيح ابن حبان 1732 (صحيح)","تخريج صحيح ابن حبان 1731 (صحيح)"]},{"id":"س-07207","fp":"5de2dddd849a","stateId":590,"easy":"إذا لم تغسل عراقيبك في الوضوء ← فويل للعراقيب من النار","cause":"للعراقيبِ","result":"ويلٌ للعراقيبِ منَ النَّارِ","explicit":true,"repOf":"س-01414","ref":"تخريج المسند لشاكر 11/100","text":["سألتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ عن صلاةِ الرَّجلِ قاعدًا فقالَ : علَى النِّصفِ من صلاتِهِ قائمًا قالَ : وأبصرَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قومًا يتوضَّؤونَ لم يُتمُّوا الوضوءَ فقالَ : أسبِغوا يَعني الوضوءَ ",["ويلٌ للعراقيبِ منَ النَّارِ",2]," أو الأعقابِ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (735)، وأبو داود (950)، والنسائي (1659) واللفظ لهم، وأخرج عجزه أبو عوانة (688) واللفظ له.","bab":"علم › حسن السؤال ونصح العالم","dorar":"FfJu2Mbr","merged":3,"otherRefs":["صحيح ابن حبان 1059 (صحيح)","صحيح مسلم 242 (صحيح)"]},{"id":"س-07446","fp":"3ffa54d64f2f","stateId":590,"easy":"إذا أضعت الصلاة واتبعت الشهوات ← فسوف تلقى غياً","cause":"أضاعوا الصَّلاةَ، واتَّبعوا الشَّهواتِ","result":"فسوف يلقَوْنَ غيًّا","explicit":true,"star":true,"otherNeedIds":[45],"ref":"المستدرك على الصحيحين 3460","srcLabel":"البخاري","text":["سَمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، وتلا هذه الآيةَ: {فَخَلَفَ مِن بَعْدِهِمْ خَلْفٌ} [مريم: 59]، فقالَ صلَّى اللهُ عليه وسلَّمَ: «يكونُ خلْفٌ مِن بعدِ ستِّينَ سنةً ",["أضاعوا الصَّلاةَ، واتَّبعوا الشَّهواتِ",1]," ",["فسوف يلقَوْنَ غيًّا",2],"، ثُمَّ يكون خلْفٌ يَقرؤونَ القرآنَ، لا يعدو تَراقِيهُم، ويَقرأُ القرآنَ ثلاثةٌ: مؤمنٌ، ومنافقٌ، وفاجرٌ». قالَ بشيرٌ: فقلتُ للوليدِ: ما هؤلاء الثَّلاثةُ؟ فقالَ: المنافقُ كافرٌ، والفاجرُ يتَأَكَّلُ به، والمؤمنُ يُؤمنُ به."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (11340)، والبخاري في ((خلق أفعال العباد)) (117)، وابن حبان (755)، والطبراني في ((المعجم الأوسط)) (9330) جميعا بلفظه دون تلاوة الآية في أوله.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"3rGLN93d"},{"id":"س-01378","fp":"9ca0c16c42af","stateId":590,"easy":"إذا لم تغسل عقبيك في الوضوء ← فويل للأعقاب من النار","cause":"للأَعقابِ","result":"ويلٌ للأَعقابِ منَ النَّارِ","explicit":true,"repOf":"س-01414","ref":"صحيح ابن خزيمة 1/ 675","text":["صلَّى رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ بأصحابِهِ، ثمَّ جلسَ في طائفةٍ منهم، فدخلَ رجلٌ، فقامَ يصلِّي، فجعلَ يركعُ وينقرُ في سجودِهِ، فقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ: أترَونَ هذا، من ماتَ على هذا ماتَ على غيرِ ملَّةِ محمَّدٍ، ينقُرُ صلاتَهُ كما ينقُرُ الغرابُ الدَّمَ، إنَّما مَثلُ الَّذي يركعُ وينقرُ في سجودِهِ كالجائعِ لا يأكلُ إلَّا التَّمرةَ والتَّمرتينِ، فماذا تُغْنيانِ عنهُ، فأسبِغوا الوضوءَ، ",["ويلٌ للأَعقابِ منَ النَّارِ",2],"، أتمُّوا الرُّكوعَ والسُّجودَ. قالَ أبو صالِحٍ: فقلتُ لأبي عبدِ اللَّهِ الأشعريِّ: من حدَّثَكَ بِهَذا الحديثِ؟ فقالَ: أُمَراءُ الأجنادِ: عَمرُو بنُ العاصِ، وخالدُ بنُ الوليدِ، ويزيدُ بنُ أبي سُفيانَ، وشُرَحْبيلُ بنُ حَسنةَ، كلُّ هؤلاءِ سمعوهُ منَ النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ"],"grade":"صحيح","narrator":"عمرو بن العاص، وخالد بن الوليد، ويزيد بن أبي سفيان، وشرحبيل بن حسنة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن أبي عاصم في ((الآحاد والمثاني)) (494)، وأبو يعلى (7184)، والطبراني (4/ 115) (3840) واللفظ لهم.","bab":"وضوء › إسباغ الوضوء","dorar":"EdEJ7nD8","merged":29,"otherRefs":["تخريج المسند لشعيب 14392 (صحيح)","تخريج المسند لشعيب 25589 (صحيح)","الأوسط لابن المنذر 2/52 (صحيح)","تخريج المسند لشعيب 7816 (صحيح)","تخريج المسند لشعيب 9265 (صحيح)","تخريج المسند لشعيب 15195 (صحيح)","تخريج المسند لشعيب 6911 (صحيح)","صحيح النسائي 142 (صحيح)","مجموع الفتاوى 21/128 (صحيح)","صحيح مسلم 241 (صحيح)","عمدة القاري 2/361 (صحيح)","كشف اللثام 1/54 (صحيح)","تخريج المسند لشعيب 24813 (صحيح)","الأوسط لابن المنذر 2/51 (صحيح)","نخب الافكار 1/343 (صحيح)","تخريج المسند لشعيب 9304 (صحيح)","تخريج المسند لشعيب 9554 (صحيح)","تاريخ بغداد 6/4 (صحيح)","صحيح ابن ماجه 369 (صحيح)","صحيح الجامع 124 (صحيح)","صحيح الجامع 7132 (صحيح)","فتح البيان 3/ 364 (صحيح)","تخريج المسند لشعيب 17706 (صحيح)","الجامع الصغير 9625 (صحيح)","نخب الافكار 1/339 (حسن)","… و3 غيرها"]},{"id":"ق-0748","fp":"be2ae5a69410","stateId":590,"easy":"إضاعة الصلاة واتباع الشهوات ← لقاء الغيّ","cause":"إضاعة الصلاة واتباع الشهوات","result":"لقاء الغيّ","explicit":true,"star":true,"otherNeedIds":[19],"ref":"سورة مريم: 59","srcLabel":"القرآن الكريم","quran":{"s":19,"from":59,"to":59,"text":"فَخَلَفَ مِنْ بَعْدِهِمْ خَلْفٌ أَضَاعُوا الصَّلَاةَ وَاتَّبَعُوا الشَّهَوَاتِ فَسَوْفَ يَلْقَوْنَ غَيًّا (59)","hl":[[0,105,1]]}},{"id":"ق-1395","fp":"c52cb774af9d","stateId":590,"easy":"ترك الصلاة وترك إطعام المسكين والخوض مع الخائضين والتكذيب بيوم الدين ← سقر","cause":"ترك الصلاة وترك إطعام المسكين والخوض مع الخائضين والتكذيب بيوم الدين","result":"سقر","explicit":true,"star":true,"ref":"سورة المدثر: 38–47","srcLabel":"القرآن الكريم","quran":{"s":74,"from":38,"to":47,"text":"كُلُّ نَفْسٍ بِمَا كَسَبَتْ رَهِينَةٌ (38) إِلَّا أَصْحَابَ الْيَمِينِ (39) فِي جَنَّاتٍ يَتَسَاءَلُونَ (40) عَنِ الْمُجْرِمِينَ (41) مَا سَلَكَكُمْ فِي سَقَرَ (42) قَالُوا لَمْ نَكُ مِنَ الْمُصَلِّينَ (43) وَلَمْ نَكُ نُطْعِمُ الْمِسْكِينَ (44) وَكُنَّا نَخُوضُ مَعَ الْخَائِضِينَ (45) وَكُنَّا نُكَذِّبُ بِيَوْمِ الدِّينِ (46) حَتَّى أَتَانَا الْيَقِينُ (47)","hl":[[0,355,1]]}},{"id":"ق-1399","fp":"2b7cb37cf747","stateId":590,"easy":"ترك التصديق والصلاة والتكذيب والتولي والخيلاء ← الوعيد: أولى لك فأولى","cause":"ترك التصديق والصلاة والتكذيب والتولي والخيلاء","result":"الوعيد: أولى لك فأولى","explicit":true,"ref":"سورة القيامة: 31–35","srcLabel":"القرآن الكريم","quran":{"s":75,"from":31,"to":35,"text":"فَلَا صَدَّقَ وَلَا صَلَّى (31) وَلَكِنْ كَذَّبَ وَتَوَلَّى (32) ثُمَّ ذَهَبَ إِلَى أَهْلِهِ يَتَمَطَّى (33) أَوْلَى لَكَ فَأَوْلَى (34) ثُمَّ أَوْلَى لَكَ فَأَوْلَى (35)","hl":[[0,131,1]]}},{"id":"ق-1408","fp":"4887b10e1033","stateId":590,"easy":"ترك الركوع (الصلاة) ← ويل يومئذ","cause":"ترك الركوع (الصلاة)","result":"ويل يومئذ","explicit":true,"ref":"سورة المرسلات: 48–49","srcLabel":"القرآن الكريم","quran":{"s":77,"from":48,"to":49,"text":"وَإِذَا قِيلَ لَهُمُ ارْكَعُوا لَا يَرْكَعُونَ (48) وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ (49)","hl":[[0,86,1]]}},{"id":"ق-1448","fp":"26675e95602e","stateId":590,"easy":"النهي عن الصلاة والتكذيب والتولي ← السفع بالناصية","cause":"النهي عن الصلاة والتكذيب والتولي","result":"السفع بالناصية","explicit":true,"otherNeedIds":[49],"ref":"سورة العلق: 9–16","srcLabel":"القرآن الكريم","quran":{"s":96,"from":9,"to":16,"text":"أَرَأَيْتَ الَّذِي يَنْهَى (9) عَبْدًا إِذَا صَلَّى (10) أَرَأَيْتَ إِنْ كَانَ عَلَى الْهُدَى (11) أَوْ أَمَرَ بِالتَّقْوَى (12) أَرَأَيْتَ إِنْ كَذَّبَ وَتَوَلَّى (13) أَلَمْ يَعْلَمْ بِأَنَّ اللَّهَ يَرَى (14) كَلَّا لَئِنْ لَمْ يَنْتَهِ لَنَسْفَعًا بِالنَّاصِيَةِ (15) نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍ (16)","hl":[[0,301,1]]}},{"id":"ق-1462","fp":"078eb0f0b6e2","stateId":590,"easy":"السهو عن الصلاة والمراءاة ومنع الماعون ← الويل","cause":"السهو عن الصلاة والمراءاة ومنع الماعون","result":"الويل","explicit":true,"ref":"سورة الماعون: 4–7","srcLabel":"القرآن الكريم","quran":{"s":107,"from":4,"to":7,"text":"فَوَيْلٌ لِلْمُصَلِّينَ (4) الَّذِينَ هُمْ عَنْ صَلَاتِهِمْ سَاهُونَ (5) الَّذِينَ هُمْ يُرَاءُونَ (6) وَيَمْنَعُونَ الْمَاعُونَ (7)","hl":[[0,128,1]]}},{"id":"س-02982","fp":"ca969aefa574","stateId":590,"easy":"إذا تركت موضع شعرة من جنابة لم تغسلها ← يُفعل بك كذا وكذا في النار","cause":"مَن تَرَكَ مَوضِعَ شَعَرةٍ مِن جَنابةٍ لم يَغسِلْها","result":"فُعِلَ بِهذا كَذا وكَذا في النَّارِ","explicit":true,"ref":"الأحكام الوسطى 1/ 200","srcLabel":"الأحكام الوسطى","text":["\"",["مَن تَرَكَ مَوضِعَ شَعَرةٍ مِن جَنابةٍ لم يَغسِلْها",1]," ",["فُعِلَ بِهذا كَذا وكَذا في النَّارِ",2],"\"، قالَ علِيٌّ: فمِن ثَمَّ عادَيْتُ رأسي ثَلاثًا، وكانَ يَجُزُّ شَعَرَه."],"grade":"صحيح","narrator":"علي","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","bab":"إيمان › الوعيد","dorar":"G49Lkleq","merged":2,"otherRefs":["تحفة المحتاج 1/205 (صحيح)"]},{"id":"س-06466","fp":"395b10c63380","stateId":590,"easy":"إذا لم تأتِ بالصلوات ← فليس لك عند الله عهد، إن شاء عذبك","cause":"ومَن لم يَأتِ بِهنَّ","result":"فليس له عنْدَ اللهِ عَهْدٌ، إن شاءَ عَذَّبَه، وإن شاءَ أَدخَلَه الجَنَّةَ","explicit":true,"similar":["س-06497"],"ref":"تخريج مشكل الآثار 3172","srcLabel":"أبو داود","text":["عَنِ ابْنِ مُحَيْرِيزٍ، ذكَرَ رَجلٌ من أصحابِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يُقالُ له: أبو مُحمَّدٍ الوِترَ، فقال: إنَّه واجبٌ، فذكَرْتُ ذلك لعُبادةَ بنِ الصامِتِ، فقال: كذَبَ أبو محمَّدٍ، سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: خَمسُ صَلَواتٍ........ ثم ذكر بقية الحديث على مثل ما في حديثي مالك والليث [أي حديث: أنَّ رَجُلًا مِن بَني كِنانةَ يُدْعى المُخْدَجيَّ، سَمِعَ رَجُلًا بالشَّامِ يُدْعى أبا مُحمَّدٍ، يقولُ: إنَّ الوِتْرَ واجِبٌ، قالَ المُخْدَجيُّ: فرُحْتُ إلى عُبادةَ بنِ الصَّامِتِ، فاعتَرَضْتُه وهو رائحٌ إلى المسجِدِ، ، فأَخبَرْتُه، فأخبَرْتُه بالذي قال أبو محمَّدٍ فقالَ عُبادةُ: كَذَبَ أبو مُحمَّدٍ، سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: خَمْسُ صَلَواتٍ كَتَبَهنَّ اللهُ على العِبادِ، فمَن جاءَ بهنَّ لم يُضيِّعْ مِنهنَّ شَيئًا اسْتِخْفافًا بحَقِّهنَّ كانَ له عنْدَ اللهِ عَهْدٌ أن يُدخِلَه الجَنَّةَ، ",["ومَن لم يَأتِ بِهنَّ",1]," ",["فليس له عنْدَ اللهِ عَهْدٌ، إن شاءَ عَذَّبَه، وإن شاءَ أَدخَلَه الجَنَّةَ",2],"]"],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (3172) واللفظ له، وأبو داود (1420)، والنسائي (461)، والبيهقي (2257) باختلاف يسير تاما.","bab":"صلاة › فرض الصلاة","dorar":"kQFSxhUM","merged":2,"otherRefs":["تخريج المسند لشعيب 22693 (صحيح)"]},{"id":"س-03030","fp":"3a28d8417062","stateId":590,"easy":"إذا لم تقم الصلاة لوقتها ولم تقم حدها ← لم يكن لك عند الله عهد، إن شاء عذبك","cause":"ومَن لم يُقِمِ الصَّلاةَ لِوَقتِها، ولم يُقِمْ حَدَّها","result":"لم يكُنْ له به عندي عَهدٌ؛ إن شِئتُ أدخَلْتُه النَّارَ، وإن شِئتُ أدخَلْتُه الجنَّةَ","explicit":true,"ref":"تخريج مشكل الآثار 3174","srcLabel":"أحمد","text":["خرَجَ إلينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ذاتَ يومٍ ونحن في المسجِدِ، ثُم ذكَرَ مِثلَه. [أي: حَديثَ: خرج علينا رَسولُ الله صلَّى اللهُ عليه وسلَّم ونحن في المسجِدِ سَبعةٌ؛ مِنَّا ثلاثةٌ مِن عَرَبِنا، وأربعةٌ مِن مَوالينا، فقال: ما يُجلِسُكم هنا؟ قلنا: الصَّلاةُ. قال: فنَكَتَ بأُصبُعِه في الأرضِ ثمَّ نَكَسَ ساعةً، ثمَّ رفَعَ إلينا رأسَه فقال: تدرونَ ما يقولُ رَبُّكم؟ قُلْنا: اللهُ ورسولُه أعلَمُ. قال: إنَّه يقولُ: مَن صلَّى الصَّلاةَ لِوَقتِها، وأقام حَدَّها؛ كان له به على اللهِ عَهدٌ إذا جاءه؛ الجنَّةُ، ",["ومَن لم يُقِمِ الصَّلاةَ لِوَقتِها، ولم يُقِمْ حَدَّها، ",1],["لم يكُنْ له به عندي عَهدٌ؛ إن شِئتُ أدخَلْتُه النَّارَ، وإن شِئتُ أدخَلْتُه الجنَّةَ",2],"]"],"grade":"صحيح","narrator":"كعب","muhaddith":"إسناده صحيح على شرط الشيخين.","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (3173) بلفظه، وأحمد (18132)، والدارمي (1262)، والطبراني (19/ 143) (314) جميعا بنحوه.","bab":"إيمان › الوعيد","dorar":"iugaM2VX"},{"id":"س-06433","fp":"fff341333662","stateId":590,"easy":"إذا تركت الصلاة سكراً أربع مرات ← كان حقاً على الله أن يسقيك من طينة الخبال","cause":"ومَن ترَك الصلاةَ سُكْرًا أربعَ مرَّاتٍ","result":"كان حقًّا على اللهِ عزَّ وجَلَّ أنْ يَسقِيَه مِن طِينَةِ الخَبالِ قيل وما طِينَةُ الخَبالِ يا رسولَ اللهِ","explicit":true,"ref":"تخريج المسند لشاكر 10/143","srcLabel":"أحمد","text":["مَن ترَك الصلاةَ سُكْرًا مرَّةً واحِدَةً فكأنَّما كانَتْ له الدُّنيا وما عليها فسَلَبَها ",["ومَن ترَك الصلاةَ سُكْرًا أربعَ مرَّاتٍ ",1],["كان حقًّا على اللهِ عزَّ وجَلَّ أنْ يَسقِيَه مِن طِينَةِ الخَبالِ قيل وما طِينَةُ الخَبالِ يا رسولَ اللهِ",2]," قال عُصارَةُ أهلِ جَهَنَّمَ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6659)، والحاكم (7233) واللفظ لهما، والطبراني في ((المعجم الأوسط)) (6371) باختلاف يسير.","bab":"صلاة › تارك الصلاة","dorar":"EATgevil"},{"id":"س-06497","fp":"e6162239eaf8","stateId":590,"easy":"إذا لم تأتِ بالصلوات ← لم يكن لك عند الله عهد","cause":"ومَن لم يأتِ بِهِنَّ","result":"لم يَكُن لهُ عندَ اللَّهِ عهدًا إن شاءَ عذَّبَهُ وإن شاءَ رحِمَهُ","explicit":true,"repOf":"س-06466","ref":"تخريج كتاب السنة 967","text":["خمسُ صلَواتٍ كتبَهُنَّ اللَّهُ علَى عبادِهِ مَن جاءَ بِهِنَّ يومَ القيامةِ لم يضيِّعْ منهنَّ شيئًا استِخفافًا بحقِّهم كانَ لهُ عندَ اللَّهِ عَهدًا أن يُدْخِلَهُ الجنَّةَ ",["ومَن لم يأتِ بِهِنَّ",1]," ",["لم يَكُن لهُ عندَ اللَّهِ عهدًا إن شاءَ عذَّبَهُ وإن شاءَ رحِمَهُ",2]],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1420)، والنسائي (461)، وابن ماجه (1401)، وأحمد (22745) باختلاف يسير، وابن أبي عاصم في ((السنة)) (967) واللفظ له","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"9BjooeTE"},{"id":"س-06547","fp":"8cf1a4ca6a27","stateId":590,"easy":"إذا لم تفعل (لم تحافظ على الصلاة) ← فليس لك على الله عهد، إن شاء غفر لك وإن شاء عذبك","cause":"ومَن لم يَفعَلْ","result":"فليس على اللهِ عَهْدٌ؛ إن شاءَ غَفَرَ له، وإن شاءَ عَذَّبَه","explicit":true,"ref":"الأحكام الوسطى 1/ 247","srcLabel":"الأحكام الوسطى","text":["عن عَبْدِ اللهِ الصُّنابحيِّ، قالَ: زَعَمَ أبو مُحمَّدٍ أنَّ الوِتْرَ واجِبٌ، فقالَ عُبادةُ بنُ الصَّامِتِ: كَذَبَ أبو مُحمَّدٍ، أَشهَدُ أنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: \"خَمْسُ صَلَواتٍ افْتَرَضَهنَّ اللهُ عَزَّ وجَلَّ، مَن أَحسَنَ وُضوءَهنَّ، وصَلَّاهنَّ لوَقْتِهنَّ، وأَتَمَّ رُكوعَهنَّ وخُشوعَهنَّ، كانَ على اللهِ عَهْدٌ أن يَغفِرَ له، ",["ومَن لم يَفعَلْ",1]," ",["فليس على اللهِ عَهْدٌ؛ إن شاءَ غَفَرَ له، وإن شاءَ عَذَّبَه",2],"\"."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"DVkj448X"},{"id":"س-06626","fp":"a1ef7c10cb47","stateId":590,"easy":"إذا لم تصلِّ الصلاة لوقتها وضيعتها استخفافاً ← فلا عهد لك، إن شاء عذبك","cause":"ومَن لم يُصلِّها لوَقتِها، ولم يُحافِظْ عليها، وضَيَّعَها استِخفافًا بحَقِّها","result":"فلا عَهدَ له، إنْ شِئتُ عَذَّبتُه، وإنْ شِئتُ غَفَرتُ له","explicit":true,"ref":"تخريج المسند لشعيب 18132","srcLabel":"أحمد","text":["بينما أنا جالسٌ في مسجدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، مُسنِدي ظُهورِنا إلى قِبلةِ مسجدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، سبعةُ رَهطٍ، أربعةٌ مِن مَوالينا، وثلاثةٌ مِن عَرَبِنا، إذ خَرَجَ إلينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ صَلاةَ الظُّهرِ، حتى انتَهى إلينا، فقال: ما يُجلِسُكم هاهنا؟ قُلْنا: يا رسولَ اللهِ، نَنتظِرُ الصَّلاةَ، قال: فأرَمَّ قليلًا، ثُمَّ رَفَعَ رأسَه، فقال: أتَدرون ما يقولُ ربُّكم عزَّ وجلَّ؟ قال: قُلْنا: اللهُ ورسولُه أعلمُ، قال: فإنَّ ربَّكم عزَّ وجلَّ يقولُ: مَن صَلَّى الصَّلاةَ لوَقتِها، وحافَظَ عليها، ولم يُضيِّعْها استِخفافًا بحَقِّها؛ فله عليَّ عَهدٌ أنْ أُدخِلَه الجنَّةَ، ",["ومَن لم يُصلِّها لوَقتِها، ولم يُحافِظْ عليها، وضَيَّعَها استِخفافًا بحَقِّها",1],"؛ ",["فلا عَهدَ له، إنْ شِئتُ عَذَّبتُه، وإنْ شِئتُ غَفَرتُ له",2],"."],"grade":"صحيح","narrator":"كعب بن عجرة","muhaddith":"مرفوعه صحيح لغيره","takhrij":"أخرجه أحمد (18132) واللفظ له، والدارمي (1226)، والطبراني (19/142) (311)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"bpNDRbFU"},{"id":"س-06621","fp":"640c71227fb9","stateId":590,"easy":"إذا صمت وقمت وتركت الجماعة والجمعة ← فأنت في النار (أثر ابن عباس)","cause":"يصومُ النَّهارَ ويقومُ اللَّيلَ ولا يشهَد الجماعَةَ ولا الجمُعةَ","result":"هذا في النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الترغيب والترهيب 1/211","srcLabel":"الترمذي","text":["عنِ ابنِ عبَّاسٍ رضيَ اللَّهُ عنهما قال أنه سُئِلَ عن رجلٍ ",["يصومُ النَّهارَ ويقومُ اللَّيلَ ولا يشهَد الجماعَةَ ولا الجمُعةَ",1]," فقالَ ",["هذا في النَّارِ",2]],"grade":"صحيح","narrator":"مجاهد بن جبر المكي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (218)، وعبد الرزاق (1989)، وابن المنذر في ((الأوسط)) (1906) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"ZdzB7dzk","merged":3,"otherRefs":["مجموع فتاوى ابن باز 252/10 (صحيح)","تخريج سنن الترمذي 1/424 (صحيح)"]},{"id":"س-02984","fp":"b7382effc52b","stateId":590,"easy":"إذا كنت أميراً أو أميناً أو عريفاً ← فويل لك إن لم تعدل","cause":"لأُمَراءِ، وَيْلٌ للأُمَناءِ، وَيْلٌ للعُرَفاءِ، لَيَتَمَنَّيْنَ أقْوامٌ يَوْمَ القِيامةِ أنَّ ذَوائِبَهم كانَتْ مُعَلَّقةً بالثُّرَيَّا، يَتَذَبْذَبونَ بَيْنَ السَّماءِ والأرْضِ، وأنَّهم لم يَلُوا عَمَلًا","result":"وَيْلٌ ل","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[50],"ref":"الأحكام الوسطى 2/363","srcLabel":"أبو داود","text":[["وَيْلٌ ل",2],["لأُمَراءِ، وَيْلٌ للأُمَناءِ، وَيْلٌ للعُرَفاءِ، لَيَتَمَنَّيْنَ أقْوامٌ يَوْمَ القِيامةِ أنَّ ذَوائِبَهم كانَتْ مُعَلَّقةً بالثُّرَيَّا، يَتَذَبْذَبونَ بَيْنَ السَّماءِ والأرْضِ، وأنَّهم لم يَلُوا عَمَلًا",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود الطيالسي (2646) بلفظه، وأحمد (8627)، وأبو يعلى في ((المسند)) (6217) بلفظه.","bab":"إيمان › الوعيد","dorar":"W4a4fkhj","merged":5,"otherRefs":["هداية الرواة 3/465 (حسن)","تخريج صحيح ابن حبان 4483 (صحيح)","المستدرك على الصحيحين 7211 (صحيح)","الجامع الصغير 7530 (صحيح)"]},{"id":"س-03669","fp":"72e90809d509","stateId":590,"easy":"إذا تعديت حدود الله وضيعت فرائضه ← فبئس الحامل للقرآن أنت","cause":"تعدى حُدودي وضيعَ فرائضِي","result":"فبئسَ الحاملُ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"أحاديث مختارة 150","srcLabel":"سنده صالح","text":["يمثلُ القرآنُ يومَ القيامةِ رجلًا فيقولُ حملَ هذا إياي ",["فبئسَ الحاملُ",2]," ",["تعدى حُدودي وضيعَ فرائضِي",1]],"grade":"حسن","narrator":"[جد عمرو بن شعيب]","muhaddith":"سنده صالح","bab":"اعتصام بالسنة › الأمر بالتمسك بالكتاب والسنة","dorar":"qxfDdGfL"},{"id":"س-04564","fp":"c1db890b232a","stateId":590,"easy":"إذا لم تبالِ أين يصيبك البول ← تؤذي أهل النار بجر أمعائك","cause":"كان لا يُبالِي أينَ أصاب البولُ منه لا يغسلُه","result":"ورجلٌ يجرُّ أمعاءَه","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"مجمع الزوائد 1/213","srcLabel":"الطبراني","text":["أربعةٌ يُؤذونَ أهلَ النارِ على ما بهم من الأذَى يسعونَ بينَ الحميمِ والجحيمِ يدعونَ بالويلِ والثبورِ يقولُ أهلُ النارِ بعضُهم لبعضٍ ما بالُ هؤلاءِ قد آذونا على ما بنا من الأذَى قال فرجلٌ مغلقٌ عليه تابوتٌ من جمرٍ ",["ورجلٌ يجرُّ أمعاءَه",2]," ورجلٌ يسيلُ فوه قيحًا ودمًا ورجلٌ يأكلُ لحمَه قال فيُقالُ لصاحبِ التابوتِ ما بالُ الأبعدِ قد آذانا على ما بنا من الأذَى قال فيقولُ إن الأبعدَ مات وفي عنقِه أموالُ الناسِ ما يجدُ لها قضاءً أو وفاءً ثم قال للذي يجرُّ أمعاءَه ما بالُ الأبعدِ قد آذانا على ما بنا من الأذَى فقال إن الأبعدَ ",["كان لا يُبالِي أينَ أصاب البولُ منه لا يغسلُه",1]," ثم قال للذي يسيلُ فوه قيحًا ودمًا ما بالُ الأبعدِ قد آذانا على ما بنا من الأذَى فيقولُ إن الأبعدَ كان يأكلُ لحمَ الناسِ"],"grade":"حسن","narrator":"شفي بن ماتع الأصبحي","muhaddith":"رجاله موثقون","takhrij":"أخرجه ابن المبارك في ((الزهد)) (2/94)، وابن أبي الدنيا في ((صفة النار)) (229)، والطبراني (7/311) (7226) باختلاف يسير.","bab":"جهنم › صفة عذاب أهل النار","dorar":"SXiXxY4A"},{"id":"س-05121","fp":"c609cdb999ea","stateId":591,"easy":"إذا قذفت مملوكك بزنا وهو بريء ← يُقام عليك الحد يوم القيامة","cause":"مَن قذَف مملوكَهُ بزِنًا بَريئًا مِمَّا قال","result":"أقام عليه الحدَّ يومَ القِيامةِ","explicit":true,"star":true,"ref":"تخريج مشكل الآثار 192","srcLabel":"متفق عليه","text":["ثمَّ ذكَر بإسنادِهِ مِثْلَهُ، ولمْ يَقُلْ: بزِنًا، [يعني حديثَ: قال أبو القاسِمِ نبيُّ التَّوبةِ صلَّى اللهُ عليه وسلَّمَ: ",["مَن قذَف مملوكَهُ بزِنًا بَريئًا مِمَّا قال",1],"، ",["أقام عليه الحدَّ يومَ القِيامةِ",2],"، إلَّا أنْ يكونَ كما قال.]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح رجاله رجال الشيخين غير سويد بن نصر وهو ثقة","takhrij":"أخرجه الطحاوي في  ((شرح مشكل الآثار)) (191) واللفظ له، والبخاري (6858)، ومسلم (1660) كلاهما باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"qtNNe2K8","merged":6,"otherRefs":["تخريج المسند لشعيب 9567 (صحيح)","تخريج مشكل الآثار 190 (صحيح)","تخريج سنن الدارقطني 3126 (حسن)","صحيح الجامع 6463 (صحيح)","السنن الصغير للبيهقي 3/305 (صحيح)"]},{"id":"س-06327","fp":"c7925585f0a6","stateId":591,"easy":"إذا أكثرتن اللعن وكفرتن العشير ← تكنّ أكثر أهل النار","cause":"تُكثِرْنَ اللَّعنَ وتكفُرْنَ العشيرَ","result":"أراكنَّ أكثَرَ أهلِ النَّارِ","explicit":true,"star":true,"similar":["س-01334"],"otherNeedIds":[35],"ref":"تخريج صحيح ابن حبان 5744","srcLabel":"متفق عليه","text":["خرَج رسولُ اللهِ صلَّى اللهُ عليه وسلَّم في أضحى أو فِطْرٍ إلى المُصلَّى فصلَّى ثمَّ انصرَف فقام فوعَظ النَّاسَ وأمَرهم بالصَّدقةِ قال: ( أيُّها النَّاسُ تصدَّقوا ) ثمَّ انصرَف فمرَّ على النِّساءِ فقال: ( يا معشرَ النِّساءِ تصدَّقْنَ فإنِّي ",["أراكنَّ أكثَرَ أهلِ النَّارِ",2]," ) فقُلْنَ: ولمَ ذلك يا رسولَ اللهِ ؟ قال: ( ",["تُكثِرْنَ اللَّعنَ وتكفُرْنَ العشيرَ",1]," ما رأَيْتُ مِن ناقصاتِ عقلٍ ودِينٍ أذهَبَ لِلُبِّ الرَّجُلِ الحازمِ مِن إحداكنَّ يا معشرَ النِّساءِ ) فقُلْنُ له: ما نقصانُ دِينِنا وعقلِنا يا رسولَ اللهِ ؟ قال: ( أليس شَهادةُ المرأةِ مِثْلَ نصفِ شَهادةِ الرَّجُلِ ) قُلْنَ: بلى قال: ( فذاك نُقصانُ عقلِها أوَليسَتْ إذا حاضتِ المرأةُ لم تُصَلِّ ولم تَصُمْ ) ؟ قُلْنَ: بلى قال ( فذاك نُقصانُ دِينِها ) ثمَّ انصرَف رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فلمَّا صار إلى منزلِه جاءتْ زينبُ امرأةُ عبدِ اللهِ بنِ مسعودٍ تستأذِنُ عليه فقيل: يا رسولَ اللهِ هذه زينبُ تستأذِنُ عليك فقال: ( أيُّ الزَّيانبِ ) ؟ قيل: امرأةُ عبدِ اللهِ بنِ مسعودٍ قال: ( نَعم ائذَنوا لها ) فأذِن لها فقالت: يا نبيَّ اللهِ إنَّك أمَرْتَنا اليومَ بالصَّدقةِ وكان عندي حُلِيٌّ فأرَدْتُ أنْ أتصدَّقَ فزعَم ابنُ مسعودٍ أنَّه وولَدَه أحقُّ مَن تصدَّقْتُ به عليهم فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ( صدَق زوجُك وولَدُك أحقُّ مَن تصدَّقْتِ به عليهم )"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه البخاري (1462) باختلاف يسير، ومسلم (80) دون ذكر لفظه","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"0z0NtOOk","merged":7,"otherRefs":["صحيح مسلم 80 (صحيح)","تخريج صحيح ابن حبان 7479 (صحيح)","صحيح ابن حبان 3323 (صحيح)","تخريج المسند لشعيب 4151 (صحيح)","المستدرك على الصحيحين 9008 (صحيح)","المستدرك على الصحيحين 2810 (صحيح)"]},{"id":"س-08317","fp":"b098955ec573","stateId":591,"easy":"إذا كذبت على النبي ﷺ متعمداً ← فتبوأ مقعدك من النار","cause":"من كذب عليَّ مُتعمِّدًا","result":"فلْيتبوَّأْ مَقعدَه من النَّارِ","explicit":true,"star":true,"similar":["س-08354","س-03006","س-04955","س-05097","س-03011","س-03057","س-04208","س-08345","س-03763","س-03098","س-00507","س-02575","س-04226","س-04247","س-04305","س-05077","س-05081","س-05240"],"ref":"سنن الترمذي 3715","srcLabel":"متفق عليه","text":["لما كان يومُ الحُدَيبيةِ ، خرج إلينا ناسٌ من المشركين ، فيهم سُهَيلُ بنُ عَمرو ، وأُناسٌ من رؤساءِ المشركين ، فقالوا : يا رسولَ اللهِ ! خرج إليك ناسٌ من أبنائِنا وإخواننا وأرِقَّائِنا ، وليس لهم ثقةٌ في الدِّين ، وإنما خرجوا فرارًا من أموالنا وضياعِنا ، فارْدُدْهم إلينا ، فإن لم يكن لهم فقهٌ في الدِّين سنُفَقِّهُهم ، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ يا معشرَ قريشٍ ! لتنتهُنَّ أو ليبعثَنَّ اللهُ عليكم من يضرب رقابَكم بالسيفِ على الدِّينِ ، قد امتحن اللهُ قلوبَهم على الإيمانِ . قالوا : من هو يا رسولَ اللهِ ؟ فقال له أبو بكرٍ : من هو يا رسولَ اللهِ ؟ وقال عمرُ : من هو يا رسولَ اللهِ ؟ قال : هو خاصفُ النَّعلِ . وكان أعطى عليًّا نعلَه يخصفُها ، قال : ثم التفت إلينا عليٌّ ، فقال : إنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال : ",["من كذب عليَّ مُتعمِّدًا ",1],["فلْيتبوَّأْ مَقعدَه من النَّارِ",2]],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"حسن صحيح غريب لا نعرفه إلا من حديث ربعي عن علي","takhrij":"أخرجه أحمد بن حنبل في ((فضائل الصحابة)) (1105)، باختلاف يسير، وأصله في البخاري (106)، ومسلم (1)","bab":"مناقب وفضائل › علي بن أبي طالب","dorar":"hdVa4t7B","merged":25,"otherRefs":["نخب الافكار 13/517 (صحيح)","الوهم والإيهام 5/313 (صحيح)","تخريج المسند لشعيب 12800 (صحيح)","تخريج المسند لشعيب 6592 (صحيح)","صحيح أبي داود 3651 (صحيح)","تخريج المسند لشعيب 11092 (صحيح)","تخريج المسند لشعيب 19266 (صحيح)","تخريج سير أعلام النبلاء 9/186 (صحيح)","تخريج المسند لشعيب 1089 (حسن)","تخريج المسند لشعيب 11536 (صحيح)","صحيح البخاري 107 (صحيح)","الأحاديث المختارة 1088 (صحيح)","مسند أبي بكر الصديق 593 (صحيح)","تخريج مشكل الآثار 409 (صحيح)","صحيح البخاري 110 (صحيح)","تخريج المسند لشعيب 12764 (صحيح)","تخريج سير أعلام النبلاء 1/43 (صحيح)","الأحكام الوسطى 4/ 339 (صحيح)","تخريج صحيح ابن حبان 6256 (صحيح)","تخريج المسند لشعيب 1428 (صحيح)","تخريج المسند لشعيب 18202 (صحيح)","تخريج مشكل الآثار 387 (صحيح)","تخريج المسند لشعيب 17431 (صحيح)","صحيح ابن حبان 4804 (صحيح)"]},{"id":"س-04195","fp":"caabfab03241","stateId":591,"easy":"إذا كفرت العشير وأنكرت الإحسان ← تكونين من أكثر أهل النار","cause":"يكفُرْنَ العشيرَ ويكفُرْنَ الإحسانَ","result":"رأَيْتُ أكثرَ أهلِها النِّساءَ","explicit":true,"star":true,"ref":"صحيح ابن حبان 2853","srcLabel":"متفق عليه","text":["خسَفت الشَّمسُ على عهدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فصلَّى رسولُ اللهِ صلَّى اللهُ عليه وسلَّم والنَّاسُ معه فقام قيامًا طويلًا نحوًا مِن سورةِ البقرةِ ثمَّ ركَع ركوعًا طويلًا ثمَّ رفَع فقام قيامًا طويلًا وهو دونَ القيامِ الأوَّلِ ثمَّ ركَع ركوعًا طويلًا وهو دونَ الرُّكوعِ الأوَّلِ ثمَّ سجَد ثمَّ قام قيامًا طويلًا دونَ القيامِ الأوَّلِ ثمَّ ركَع ركوعًا طويلًا وهو دونَ الرُّكوعِ الأوَّلِ ثمَّ سجَد ثمَّ قام قيامًا طويلًا دونَ القيامِ الأوَّلِ ثمَّ ركَع ركوعًا طويلًا وهو دونَ الرُّكوعِ الأوَّلِ ثمَّ رفَع فقام قيامًا طويلًا وهو دونَ القيامِ الأوَّلِ ثمَّ ركَع ركوعًا طويلًا وهو دونَ الرُّكوعِ الأوَّلِ ثمَّ سجَد ثمَّ انصرَف وقد تجلَّتِ الشَّمسُ فقال: ( إنَّ الشَّمسَ والقمرَ آيتانِ مِن آياتِ اللهِ لا يخسفانِ لموتِ أحدٍ ولا لحياتِه فإذا رأَيْتُم ذلك فاذكُروا اللهَ ) فقالوا: يا رسولَ اللهِ رأَيْناك تناوَلْتَ شيئًا في مقامِك هذا ثمَّ رأَيْناك تكعكَعْتَ قال: ( إنِّي رأَيْتُ الجنَّةَ أو أُريتُ الجنَّةَ فتناوَلْتُ منه عُنقودًا ولو أخَذْتُه لأكَلْتُم منه ما بقيتِ الدُّنيا ورأَيْتُ النَّارَ فلم أرَ كاليومِ منظرًا قطُّ و",["رأَيْتُ أكثرَ أهلِها النِّساءَ",2]," ) \nقالوا: بمَ يا رسولَ اللهِ ؟ قال: ( بكفرِهنَّ ) قيل: يكفُرْنَ باللهِ ؟ قال: ( ",["يكفُرْنَ العشيرَ ويكفُرْنَ الإحسانَ",1]," لو أحسَنْتَ إلى إحداهنَّ الدَّهرَ ثمَّ رأَتْ منك شيئًا قالت: واللهِ ما رأَيْتُ منك خيرًا قطُّ )"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (1052)، ومسلم (907) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"EQxsZEVP","merged":2,"otherRefs":["تخريج مشكل الآثار 851 (صحيح)"]},{"id":"س-04295","fp":"2a7b4306eaa4","stateId":591,"easy":"إذا حلفت عند المنبر النبوي يميناً آثمة ولو على سواك ← وجبت لك النار","cause":"لا يحلِفُ عندَ هذا المنبرِ عبدٌ ولا أمةٌ على يمينٍ آثمةٍ ولو على سواكٍ رطبٍ","result":"إلَّا وجبت لَهُ النَّارُ","explicit":true,"star":true,"similar":["س-05153","س-00632","س-04993","س-04927"],"ref":"الكبائر للذهبي 231","srcLabel":"البخاري","text":["حديثُ تغليظِ إثْمِ الحالِفِ كاذبًا بعد العَصْرِ [يعني حديث: ثَلَاثَةٌ لا يُكَلِّمُهُمُ اللَّهُ يَومَ القِيَامَةِ، وَلَا يَنْظُرُ إِلَيْهِمْ: رَجُلٌ حَلَفَ علَى سِلْعَةٍ لقَدْ أَعْطَى بهَا أَكْثَرَ ممَّا أَعْطَى، وَهو كَاذِبٌ، وَرَجُلٌ حَلَفَ علَى يَمِينٍ كَاذِبَةٍ بَعْدَ العَصْرِ؛ لِيَقْتَطِعَ بهَا مَالَ رَجُلٍ مُسْلِمٍ، وَرَجُلٌ مَنَعَ فَضْلَ مَاءٍ، فيَقولُ اللَّهُ: اليومَ أَمْنَعُكَ فَضْلِي كما مَنَعْتَ فَضْلَ ما لَمْ تَعْمَلْ يَدَاكَ.]                                   حديثُ تغليظِ إثْمِ الحالِفِ كاذبًا عند مِنْبَر رسولِ اللهِ صلَّى الله عليه وسلَّم. [يعني حديث: ",["لا يحلِفُ عندَ هذا المنبرِ عبدٌ ولا أمةٌ على يمينٍ آثمةٍ ولو على سواكٍ رطبٍ",1]," ",["إلَّا وجبت لَهُ النَّارُ",2],"]"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7446)، وأبو داود (3474)، وأحمد (10226) واللفظ لهم تامًا.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"GBTEmKxm","merged":2,"otherRefs":["معرفة السنن والآثار 20036 (حسن)"]},{"id":"س-08354","fp":"cb8d0b4e5f9e","stateId":591,"easy":"إذا كذبت على النبي ﷺ ← تلج النار","cause":"لا تَكْذِبوا عَلَيَّ","result":"فإنَّه مَنْ يَكذِبْ عَلَيَّ يَلِجِ النَّارَ","explicit":true,"repOf":"س-08317","ref":"المستدرك على الصحيحين 2651","text":["لمَّا افتَتَحَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ مكَّةَ أَتاهُ ناسٌ مِن قريشٍ، فقالوا: يا مُحمَّدُ، إنَّا حُلفاؤكَ وقَومُكَ، وإنَّه لَحِقَ بكَ أَرِقَّاؤنا، ليس لهُم رَغبةٌ في الإسلامِ، وإنَّما فَرُّوا مِن العملِ، فارْدُدْهُم علينا، فشاوَرَ أبا بكرٍ في أمْرِهِم، فقالَ: صَدَقوا يا رسولَ اللهِ، فقالَ لعُمَرَ: ما تَرى؟ فقالَ مِثلَ قولِ أبي بكرٍ، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا مَعشرَ قريشٍ، ليَبْعَثَنَّ اللهُ عليكم رَجلًا منكم، امْتَحَنَ اللهُ قلبَهُ للإيمانِ، يَضرِبُ رِقابَكُم على الدِّينِ، فقالَ أبو بكرٍ: أنا هو يا رسولَ اللهِ؟ قالَ: لا، قالَ عُمَرُ: أنا هو يا رسولَ اللهِ؟ قالَ: لا، ولكنَّه خاصِفُ النَّعلِ في المسجدِ -وقد كان أَلْقى نَعْلَه إلى عَليٍّ يَخصِفُها- ثُمَّ قالَ: أما إنِّي سَمِعْتُه يقولُ: ",["لا تَكْذِبوا عَلَيَّ",1],"؛ ",["فإنَّه مَنْ يَكذِبْ عَلَيَّ يَلِجِ النَّارَ",2],"."],"grade":"صحيح","narrator":"علي","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه البخاري (106)، ومسلم (1)، والترمذي (2660) جميعهم مختصرا.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"7aVrZFI2","merged":2,"otherRefs":["تخريج المسند لشعيب 1000 (صحيح)"]},{"id":"س-00317","fp":"fdfa9ae336ea","stateId":591,"easy":"إذا تحريت الكذب ← تُكتب عند الله كذاباً ويهديك إلى النار","cause":"وإنَّ الكَذِبَ فُجورٌ","result":"وإنَّ الفُجورَ يَهدي إلى النَّارِ، وإنَّ العَبدَ لَيَتَحَرَّى الكَذِبَ حتَّى يُكتَبَ كَذَّابًا","explicit":true,"otherNeedIds":[26],"ref":"صحيح مسلم 2607","srcLabel":"البخاري","text":["إنَّ الصِّدقَ برٌّ، وإنَّ البِرَّ يَهدي إلى الجَنَّةِ، وإنَّ العَبدَ لَيَتَحَرَّى الصِّدقَ حتَّى يُكتَبَ عِندَ اللهِ صِدِّيقًا، ",["وإنَّ الكَذِبَ فُجورٌ",1],"، ",["وإنَّ الفُجورَ يَهدي إلى النَّارِ، وإنَّ العَبدَ لَيَتَحَرَّى الكَذِبَ حتَّى يُكتَبَ كَذَّابًا",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6094) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"iOeH5RT5"},{"id":"س-00417","fp":"6e2b1956d44d","stateId":591,"easy":"إذا ادعيت رؤيا لم ترها ← تُكلّف يوم القيامة أن تعقد بين شعيرتين","cause":"الَّذي يُرِي عينَيْه في المنامِ ما لم يَرَ","result":"يُكلَّفُ يومَ القيامةِ أنْ يعقِدَ بيْنَ شَعيرتينِ","explicit":true,"similar":["س-02950"],"ref":"تخريج صحيح ابن حبان 6057","srcLabel":"البخاري","text":[["الَّذي يُرِي عينَيْه في المنامِ ما لم يَرَ",1]," ",["يُكلَّفُ يومَ القيامةِ أنْ يعقِدَ بيْنَ شَعيرتينِ",2]," والَّذي يستمِعُ حديثَ قومٍ وهم له كارهونَ يُصَبُّ في أُذنِه الآنُكُ يومَ القيامةِ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (7042) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"TlQS3qid"},{"id":"س-00418","fp":"d001222a923f","stateId":591,"easy":"إذا استمعت إلى حديث قوم وهم كارهون ← يُصب في أذنك الرصاص المذاب يوم القيامة","cause":"والَّذي يستمِعُ حديثَ قومٍ وهم له كارهونَ","result":"يُصَبُّ في أُذنِه الآنُكُ يومَ القيامةِ","explicit":true,"similar":["س-02587","س-03028"],"ref":"تخريج صحيح ابن حبان 6057","srcLabel":"البخاري","text":["الَّذي يُرِي عينَيْه في المنامِ ما لم يَرَ يُكلَّفُ يومَ القيامةِ أنْ يعقِدَ بيْنَ شَعيرتينِ ",["والَّذي يستمِعُ حديثَ قومٍ وهم له كارهونَ",1]," ",["يُصَبُّ في أُذنِه الآنُكُ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (7042) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"TlQS3qid"},{"id":"س-02585","fp":"cc8d91fb479e","stateId":591,"easy":"إذا تحلمت حلماً كاذباً ← تُكلّف أن تعقد بين شعيرتين وتُعذب","cause":"ومَن تحلَّم حُلمًا كاذبًا","result":"كُلِّف أنْ يعقِدَ بيْنَ شَعيرتَيْنِ ويُعذَّبُ على ذلك","explicit":true,"similar":["س-02588"],"ref":"تخريج صحيح ابن حبان 5685","srcLabel":"متفق عليه","text":["مَن صوَّر صورةً فإنَّه يُعذَّبُ حتَّى ينفُخَ فيها الرُّوحَ وليس بنافخٍ فيها الرُّوحَ ",["ومَن تحلَّم حُلمًا كاذبًا",1]," ",["كُلِّف أنْ يعقِدَ بيْنَ شَعيرتَيْنِ ويُعذَّبُ على ذلك",2],"، ومَن استمَع إلى قومٍ وهم له كارهون صُبَّ في أُذنَيْه الآنُكُ يومَ القيامةِ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه البخاري (7042)، ومسلم (2110) باختلاف يسير","bab":"إيمان › أعمال تنافي الإيمان","dorar":"GxHcF46d"},{"id":"س-02587","fp":"9607fac8ec11","stateId":591,"easy":"إذا استمعت إلى حديث قوم لا يعجبهم ← يُذاب في أذنك الرصاص","cause":"ومَنِ استمَعَ إلى حَديثِ قَومٍ ولا يُعجِبُهم أنْ يَستَمِعَ حَديثَهم","result":"أُذيبَ في أُذُنِهِ الآنُكُ","explicit":true,"repOf":"س-00418","ref":"تخريج المسند لشعيب 10549","text":["مَن صوَّرَ صورةً؛ عُذِّبَ يَومَ القيامةِ حتى يَنفُخَ فيها الرُّوحَ، وليس بنافِخٍ فيها، ",["ومَنِ استمَعَ إلى حَديثِ قَومٍ ولا يُعجِبُهم أنْ يَستَمِعَ حَديثَهم",1],"، ",["أُذيبَ في أُذُنِهِ الآنُكُ",2],"، ومَن تحَلَّمَ كاذِبًا؛ دُفِعَ إليه شَعيرةٌ، وعُذِّبَ حتى يَعقِدَ بَينَ طَرَفَيْها، وليس بعاقِدٍ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه النسائي (5360) مختصراً، وأحمد (10549) واللفظ له. وأخرجه البخاري معلقاً موقوفاً مختصراً بصيغة الجزم بعد حديث (7042)","bab":"إيمان › أعمال تنافي الإيمان","dorar":"9znVjq2s"},{"id":"س-02588","fp":"2158a8be609d","stateId":591,"easy":"إذا تحلمت كاذباً ← تُعذّب حتى تعقد بين طرفي شعيرة ولست بعاقد","cause":"ومَن تحَلَّمَ كاذِبًا","result":"دُفِعَ إليه شَعيرةٌ، وعُذِّبَ حتى يَعقِدَ بَينَ طَرَفَيْها، وليس بعاقِدٍ","explicit":true,"repOf":"س-02585","ref":"تخريج المسند لشعيب 10549","text":["مَن صوَّرَ صورةً؛ عُذِّبَ يَومَ القيامةِ حتى يَنفُخَ فيها الرُّوحَ، وليس بنافِخٍ فيها، ومَنِ استمَعَ إلى حَديثِ قَومٍ ولا يُعجِبُهم أنْ يَستَمِعَ حَديثَهم، أُذيبَ في أُذُنِهِ الآنُكُ، ",["ومَن تحَلَّمَ كاذِبًا",1],"؛ ",["دُفِعَ إليه شَعيرةٌ، وعُذِّبَ حتى يَعقِدَ بَينَ طَرَفَيْها، وليس بعاقِدٍ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه النسائي (5360) مختصراً، وأحمد (10549) واللفظ له. وأخرجه البخاري معلقاً موقوفاً مختصراً بصيغة الجزم بعد حديث (7042)","bab":"إيمان › أعمال تنافي الإيمان","dorar":"9znVjq2s"},{"id":"س-03006","fp":"c9bdddf4d9a7","stateId":591,"easy":"إذا كذبت على النبي ﷺ متعمداً ← فتبوأ مقعدك من النار","cause":"مَن كَذَبَ عليَّ","result":"فليَتَبَوَّأْ مَقْعَدَه مِن النَّارِ، مُتعمِّدًا، حدَّثَنا به هكذا مرَّتينِ، وحدَّثَنا به مرةً أخرى","explicit":true,"repOf":"س-08317","ref":"تخريج المسند لشعيب 12800","text":[["مَن كَذَبَ عليَّ ",1],["فليَتَبَوَّأْ مَقْعَدَه مِن النَّارِ، مُتعمِّدًا، حدَّثَنا به هكذا مرَّتينِ، وحدَّثَنا به مرةً أخرى",2],"، فقال: قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: مَن كَذَبَ عليَّ مُتعمِّدًا فليَتَبَوَّأْ مَقْعَدَه مِن النَّارِ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (108)، ومسلم (2)، والترمذي (2661)، والنسائي في ((السنن الكبرى)) (5914)، وابن ماجه (32)، وأحمد (12800) واللفظ له","bab":"إيمان › الوعيد","dorar":"it24KoZu"},{"id":"س-04302","fp":"b23e3e628c1c","stateId":591,"easy":"إذا حدّثت عن النبي ﷺ فكذبت ← تبوأت مقعدك من النار","cause":"مَن حَدَّثَ عنِّي بحَديثٍ فكَذَبَ","result":"تَبَوَّأَ مَقعَدَه مِن النَّارِ","explicit":true,"ref":"الأحاديث المختارة 833","srcLabel":"البخاري","text":["«",["مَن حَدَّثَ عنِّي بحَديثٍ فكَذَبَ، ",1],["تَبَوَّأَ مَقعَدَه مِن النَّارِ»",2],"."],"grade":"صحيح","narrator":"طلحة بن عبيد الله","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"QpAiYEbA"},{"id":"س-04568","fp":"bdec41618925","stateId":591,"easy":"إذا طعنت (في الأنساب أو الناس) ← تطعن في النار","cause":"والذِي يطْعَنُها","result":"يطْعَنُها في النارِ","explicit":true,"ref":"صحيح الجامع 5494","srcLabel":"متفق عليه","text":["الذي يخنِقُ نفْسَهُ يخنُقُهَا فِي النَّارِ ، ",["والذِي يطْعَنُها",1]," ",["يطْعَنُها في النارِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1365 ) واللفظ له، ومسلم (109) بمعناه","bab":"جهنم › صفة عذاب أهل النار","dorar":"d5oYk6lq"},{"id":"س-04953","fp":"c16ae948912b","stateId":591,"easy":"إذا قذفت عبدك بحد ← يُقام عليك يوم القيامة","cause":"مَن قذَفَ عبدَه بحَدٍّ","result":"أُقيمَ عليه يومَ القيامةِ","explicit":true,"ref":"تخريج سنن الدارقطني 3123","srcLabel":"متفق عليه","text":[["مَن قذَفَ عبدَه بحَدٍّ ",1],["أُقيمَ عليه يومَ القيامةِ",2],"، إلَّا أنْ يَكونَ كذلك."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الدارقطني (3123) بلفظه، والترمذي (1947) بلفظ مقارب، والبخاري (6858)، ومسلم (1660) كلاهما بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"t8eRDCOd"},{"id":"س-04955","fp":"15c4333b35b2","stateId":591,"easy":"إذا كذبت على النبي ﷺ ← فليشهد جنبك مضجعاً من النار","cause":"مَن كذَبَ علَيَّ","result":"فليَشهَدْ لجَنبِه مَضجَعًا مِن النَّارِ","explicit":true,"repOf":"س-08317","ref":"تخريج سير أعلام النبلاء 2/451","text":["قُلتُ لأبي قَتادةَ: ما لك لا تُحدِّثُ عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ كما يُحدِّثُ عنه النَّاسُ؟ فقال: سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن كذَبَ علَيَّ، ",1],["فليَشهَدْ لجَنبِه مَضجَعًا مِن النَّارِ",2],"."],"grade":"صحيح","narrator":"أبو قتادة","muhaddith":"متواتر","takhrij":"أخرجه الشافعي في ((الرسالة)) (1093) بلفظ: فليتلمس لجنبه. والبخاري في ((الأدب المفرد))(904) بلفظ: فليسهل لجنبه ، والبيهقي في ((معرفة السنن والآثار))(142) بلفظ:فليلتمس لجنبه .","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"fDXQYm1S"},{"id":"س-05097","fp":"6cb563093689","stateId":591,"easy":"إذا قلت على النبي ﷺ باطلاً أو ما لم يقل ← تبوأت مقعدك من النار","cause":"لا يَقولُ أحَدٌ علَيَّ باطِلًا، أو ما لم أقُلْ","result":"إلَّا تَبَوَّأَ مَقعَدَهُ مِنَ النَّارِ","explicit":true,"repOf":"س-08317","ref":"تخريج المسند لشعيب 16524","text":[["لا يَقولُ أحَدٌ علَيَّ باطِلًا، أو ما لم أقُلْ،",1]," ",["إلَّا تَبَوَّأَ مَقعَدَهُ مِنَ النَّارِ",2],"."],"grade":"صحيح","narrator":"سلمة بن الأكوع","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (109) مختصراً، وأحمد (16524) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ra6pCOx2"},{"id":"س-05478","fp":"5335d65ceba8","stateId":591,"easy":"إذا اكتسيت بالنيل من مسلم ← يكسوك الله من جهنم","cause":"و من كسى برجلٍ مسلمٍ","result":"فإنَّ اللهَ عزَّ وجلَّ يكسوه من جهنَّمَ","explicit":true,"similar":["س-05502","س-05495","س-05497","س-05503"],"ref":"صحيح الأدب المفرد 179","srcLabel":"البخاري","text":["من أكل بمسلمٍ أكلةً فإنَّ اللهَ يُطعِمُه مثلَها من جهنَّمَ ، ",["و من كسى برجلٍ مسلمٍ",1]," ، ",["فإنَّ اللهَ عزَّ وجلَّ يكسوه من جهنَّمَ",2]," ، و من قام برجلٍ مسلمٍ مقامَ رياءٍ و سُمعةٍ ؛ فإنَّ اللهَ يقوم به مَقامَ رياءٍ و سُمعةٍ يومَ القيامةِ"],"grade":"صحيح","narrator":"المستورد بن شداد","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4881)، وأحمد (18011) باختلاف يسير، والبخاري في ((الأدب المفرد)) (240) واللفظ له.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"q49Z61vr"},{"id":"س-00421","fp":"6a6d2272cb8b","stateId":591,"easy":"إذا أتيت بصلاة وصيام وزكاة وقد شتمت وقذفت وأكلت مال الناس ← تُعطى حسناتك لهم ثم تُطرح في النار","cause":"يأتي بصلاةٍ وصيامٍ وزكاةٍ، ويأتي قد شتَمَ عِرْضَ هذا، وقذَفَ هذا، وأكَلَ مالَ هذا، وضرَبَ هذا","result":"فيُقعَدُ فيَقتَصُّ هذا مِن حَسناتِه، وهذا مِن حَسناتِه، فإنْ فنِيَتْ حَسناتُه قبلَ أنْ يُقضَى ما عليه، أُخِذَ مِن خطاياهم، فطُرِحَ عليه، ثمَّ طُرِحَ في النَّارِ","explicit":true,"otherNeedIds":[45],"ref":"تخريج المسند لشعيب 8414","srcLabel":"مسلم","text":["أَتَدرونَ مَنِ المُفلِسُ؟ قالوا: المُفلِسُ فينا يا رسولَ اللهِ مَن لا دِرْهَمَ له ولا مَتاعَ، قال: المُفلِسُ مِن أُمَّتي يومَ القِيامةِ مَن ",["يأتي بصلاةٍ وصيامٍ وزكاةٍ، ويأتي قد شتَمَ عِرْضَ هذا، وقذَفَ هذا، وأكَلَ مالَ هذا، وضرَبَ هذا",1],"، ",["فيُقعَدُ فيَقتَصُّ هذا مِن حَسناتِه، وهذا مِن حَسناتِه، فإنْ فنِيَتْ حَسناتُه قبلَ أنْ يُقضَى ما عليه، أُخِذَ مِن خطاياهم، فطُرِحَ عليه، ثمَّ طُرِحَ في النَّارِ",2],". وقال عبدُ الرحمنِ -يعني ابنَ مَهْديٍّ-: فيُقَصُّ، وقال عبدُ الرحمنِ: قبلَ أنْ يَقْضي ما عليه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2581)، والترمذي (2418)، وأحمد (8414) واللفظ له","bab":"آداب عامة › الأخلاق المذمومة","dorar":"ahFo9eHU"},{"id":"س-03011","fp":"a89d898a4d62","stateId":591,"easy":"إذا كذبت على النبي ﷺ متعمداً ← فتبوأ مقعدك من النار","cause":"فمَن كتَب عنِّي شيئًا فلْيَمْحُه\"، وقال: \"حدِّثوا عنِّي، ومَن كذَب عليَّ مُتعمِّدًا","result":"فلْيَتبوَّأْ مَقعَدَه منَ النَّارِ","explicit":true,"repOf":"س-08317","ref":"تخريج المسند لشعيب 11344","text":["\"لا تَكتُبوا عنِّي شيئًا إلَّا القُرآنَ، ",["فمَن كتَب عنِّي شيئًا فلْيَمْحُه\"، وقال: \"حدِّثوا عنِّي، ومَن كذَب عليَّ مُتعمِّدًا ",1],["فلْيَتبوَّأْ مَقعَدَه منَ النَّارِ\"",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (3004) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"GImi4yuq"},{"id":"س-03057","fp":"c1f871d39a28","stateId":591,"easy":"إذا تعمدت الكذب على النبي ﷺ ← فتبوأ مقعدك من النار","cause":"مَن تَعَمَّدَ عليَّ كَذِبًا","result":"فليَتَبَوَّأْ مَقعَدَه مِنَ النَّارِ","explicit":true,"repOf":"س-08317","ref":"صحيح البخاري 108","text":["إنَّه لَيَمنَعُني أن أُحَدِّثَكُم حَديثًا كَثيرًا أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم قال: ",["مَن تَعَمَّدَ عليَّ كَذِبًا ",1],["فليَتَبَوَّأْ مَقعَدَه مِنَ النَّارِ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2) واللفظ له، وأحمد (12110)، والدارمي (241) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"SoBGWWJg"},{"id":"س-04208","fp":"47e39c329a13","stateId":591,"easy":"إذا كذبت على النبي ﷺ متعمداً ← فلتلج النار","cause":"فمَن كذَبَ عليَّ مُتعمِّدًا","result":"فلْيَلِجِ النارَ","explicit":true,"repOf":"س-08317","ref":"تخريج سير أعلام النبلاء 5/410","text":["لا تَكذِبوا عليَّ، ",["فمَن كذَبَ عليَّ مُتعمِّدًا",1]," ",["فلْيَلِجِ النارَ",2],"."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"متواتر","takhrij":"أخرجه الذهبي في ((سير أعلام النبلاء)) (5/ 410)، ومسلم (1)، وأحمد (629) بلفظه.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"xe5DH6ag"},{"id":"س-00196","fp":"a0e13b7bf1ee","stateId":591,"easy":"إذا كذبت ← يهديك الكذب إلى الفجور","cause":"الكذبَ","result":"يهدِي إلى الفجورِ","explicit":true,"similar":["س-04223","س-02954"],"ref":"الجامع الصغير 2591","srcLabel":"ابن ماجه","text":["إِنَّما هما اثنتانِ الكلامُ والهديُ ، فأحسنُ الكلامِ كلامُ اللهِ ، وأحسنُ الهدْيِ هديُ محمدٍ ، ألَا وإيَّاكم ومحدَثاتِ الأمورِ ، فإِنَّ شرَّ الأمورِ مُحْدَثاتُها ، وكُلَّ محدَثَةٍ بدعةٌ ، وكُلَّ بِدْعَةٍ ضلالَةٌ ، ألَا لَا يَطولَنَّ عليكم الأمَدُ فتقسو قلوبُكُم ، ألَا إِنَّ كُلَّ ما هو آتٍ قريبٌ ، وإِنَّما البعيدُ ما ليس بآتٍ ، ألَا إِنَّما الشَّقِيُّ مَنْ شقِيَ في بطنِ أُمِّهِ ، والسعيدُ مَنْ وُعِظَ بِغَيْرِهِ ، ألَا إِنَّ قتالَ المؤمِنِ كفْرٌ ، وسبابَهُ فسوقٌ ، ولَا يَحِلُ لمسلِمٍ أنْ يهجُرَ أخاهُ فوقَ ثلاثٍ ، ألَا وإيَّاكم و",["الكذبَ",1]," ، فإِنَّ الكذبَ لا يصلُحُ لَا بالجدِّ ، ولَا بالْهَزْلِ ، ولَا يعِدُ الرجلُ صَبِيَّهُ ولَا يفِي ، وإِنَّ الكذِبَ ",["يهدِي إلى الفجورِ",2]," ، وإِنَّ الفجورَ يهدي إلى النارِ ، وإِنَّ الصدقَ يهدي إلى البرِ ، وإِنَّ البرَّ يهدي إلى الجنَّةِ ، وإِنَّه يقالُ للصادقِ : صدقَ وبَرَّ ، ويقالُ للكاذِبِ : كذَبَ وفجرَ ، ألَا وإِنَّ العبدَ يكذِبُ حتى يُكْتَبَ عندَ اللهِ كذابًا"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (46) واللفظ له، والطبراني (9/99) (8520) باختلاف يسير، والبيهقي في ((شعب الإيمان)) (4787) مختصراً باختلاف يسير","bab":"آداب الكلام › الصدق وما جاء فيه","dorar":"UhkJzNNf","merged":11,"otherRefs":["بدائع الفوائد 1/68 (صحيح)","الأحاديث المختارة 67 (صحيح)","شفاء العليل 1/105 (صحيح)","صحيح الأدب المفرد 298 (صحيح)","المستدرك على الصحيحين 445 (صحيح)","تخريج المسند لشاكر 1/31 (صحيح)","تخريج المسند لشاكر 1/38 (صحيح)","تخريج المسند لشاكر 1/41 (صحيح)","صحيح الأدب المفرد 557 (صحيح)","شرح ثلاثيات المسند 1/234 (حسن)"]},{"id":"س-03028","fp":"536ac1b42668","stateId":591,"easy":"إذا استمعت إلى حديث قوم يفرون منك ← يُصب في أذنك الرصاص يوم القيامة","cause":"ومَن استَمَعَ إلى حَديثِ قَومٍ يَفِرُّون به منه","result":"صُبَّ في أُذُنِه الآنُكُ يومَ القيامةِ","explicit":true,"repOf":"س-00418","ref":"تخريج سنن أبي داود 5024","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قال: مَن صوَّرَ صُورةً عذَّبَه اللهُ بها يومَ القيامةِ حتى يَنفُخَ فيها، وليس بنافِخٍ، ومَن تحلَّمَ كُلِّفَ أنْ يَعقِدَ شَعيرةً، ",["ومَن استَمَعَ إلى حَديثِ قَومٍ يَفِرُّون به منه",1],"، ",["صُبَّ في أُذُنِه الآنُكُ يومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (5024) واللفظ له، وأحمد (1866)، وابن حبان (5685) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"yjg5dgGL","merged":6,"otherRefs":["تخريج صحيح ابن حبان 5685 (صحيح)","الجامع الصغير 8407 (حسن)","تخريج المسند لشاكر 5/130 (صحيح)","صحيح الأدب المفرد 883 (صحيح)","صحيح الجامع 6370 (صحيح)"]},{"id":"س-05915","fp":"7b7cd9b8cdd9","stateId":591,"easy":"إذا أطلقت فمك وفرجك ← فهما أكثر ما يدخل الناس النار","cause":"الفَمُ والفَرْجُ","result":"أكثَرِ ما يُدخِلُ النَّاسَ النَّارَ","explicit":true,"ref":"المستدرك على الصحيحين 8132","srcLabel":"الترمذي","text":["سُئِلَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ عنْ أكثرِ ما يُدخِلُ النَّاسَ الجنَّةَ، قالَ: التَّقْوى وحُسْنُ الخُلُقِ، وسُئِلَ عنْ ",["أكثَرِ ما يُدخِلُ النَّاسَ النَّارَ",2],"، فقال: الأجْوفانِ: ",["الفَمُ والفَرْجُ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (2004)، وابن ماجة (4246)، وأحمد (7907) باختلاف يسير.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"NpzBpE76","merged":7,"otherRefs":["صحيح ابن حبان 476 (صحيح)","صحيح ابن ماجه 3443 (حسن)","تخريج المسند لشعيب 7907 (حسن)","تخريج المسند لشعيب 9096 (حسن)","صحيح الأدب المفرد 222 (حسن)","تخريج المسند لشعيب 9696 (حسن)"]},{"id":"س-08345","fp":"3e2fef353e50","stateId":591,"easy":"إذا قلت على النبي ﷺ ما لم يقل ← فتبوأ مقعدك من النار","cause":"مَن قال علَيَّ ما لَمْ أقُلْ","result":"فلْيتبوَّأْ مَقعدَه مِن النَّارِ","explicit":true,"repOf":"س-08317","ref":"تخريج صحيح ابن حبان 6982","text":["قال عبدُ اللهِ بنُ الزُّبيرِ لأبيه : يا أبتِ حدِّثْني عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم حتَّى أُحدِّثَ عنكَ فإنَّ كلَّ أبناءِ الصَّحابةِ يُحدِّثُ عن أبيه قال : يا بنيَّ ما مِن أحَدٍ صحِب رسولَ اللهِ صلَّى اللهُ عليه وسلَّم بصُحبةٍ إلَّا وقد صحِبْتُه مِثْلَها أو أفضلَ ولقد علِمْتَ يا بُنيَّ أنَّ أمَّكَ أسماءَ بنتَ أبي بكرٍ كانت تحتي ولقد علِمْتَ أنَّ عائشةَ بنتَ أبي بكرٍ خالتُك ولقد علِمْتَ أنَّ أمِّي صفيَّةُ بنتُ عبدِ المطَّلبِ وأنَّ أخوالي حمزةُ بنُ عبدِ المُطَّلبِ وأبو طالبٍ والعبَّاسُ وأنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ابنُ خالي ولقد علِمْتَ أنَّ عمَّتي خديجةُ بنتُ خُوَيلدٍ وكانت تحتَه وأنَّ ابنتَها فاطمةُ بنتُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم ولقد علِمْتَ أنَّ أمَّه صلَّى اللهُ عليه وسلَّم آمنةُ بنتُ وهبِ بنِ عبدِ مَنافِ بنِ زُهرةَ وأنَّ أمَّ صفيَّةَ وحمزةَ هالةُ بنتُ وهبِ بنِ عبدِ مَنافِ بنِ زُهرةَ ولقد صحِبْتُه بأحسَنِ صُحبةٍ والحمدُ للهِ ولقد سمِعْتُه صلَّى اللهُ عليه وسلَّم يقولُ : ( ",["مَن قال علَيَّ ما لَمْ أقُلْ ",1],["فلْيتبوَّأْ مَقعدَه مِن النَّارِ )",2]],"grade":"صحيح","narrator":"الزبير بن العوام","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (6982)، والحاكم (5656) بلفظه، والدارمي (239)، والطحاوي في ((شرح مشكل الآثار)) (389) مختصرا.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"jNHPgFuA","merged":8,"otherRefs":["مجمع الزوائد 1/149 (حسن)","تخريج المسند لشعيب 22639 (صحيح)","المستدرك على الصحيحين 384 (صحيح)","تخريج المسند لشعيب 6591 (صحيح)","الصحيح المسند 1336 (حسن)","تخريج المسند لشعيب 22538 (حسن)","تخريج المسند لشاكر 1/232 (صحيح)"]},{"id":"ق-0517","fp":"154611ac63a2","stateId":591,"easy":"السخرية من المتصدقين ← سخرية الله منهم وعذاب أليم","cause":"السخرية من المتصدقين","result":"سخرية الله منهم وعذاب أليم","explicit":true,"ref":"سورة التوبة: 79","srcLabel":"القرآن الكريم","quran":{"s":9,"from":79,"to":79,"text":"الَّذِينَ يَلْمِزُونَ الْمُطَّوِّعِينَ مِنَ الْمُؤْمِنِينَ فِي الصَّدَقَاتِ وَالَّذِينَ لَا يَجِدُونَ إِلَّا جُهْدَهُمْ فَيَسْخَرُونَ مِنْهُمْ سَخِرَ اللَّهُ مِنْهُمْ وَلَهُمْ عَذَابٌ أَلِيمٌ (79)","hl":[[0,191,1]]}},{"id":"ق-1424","fp":"3ae9be28f17c","stateId":591,"easy":"الغفلة واللهو والظن أن لا رجوع ← الكتاب وراء الظهر والثبور وصَلي السعير","cause":"الغفلة واللهو والظن أن لا رجوع","result":"الكتاب وراء الظهر والثبور وصَلي السعير","explicit":true,"ref":"سورة الانشقاق: 10–15","srcLabel":"القرآن الكريم","quran":{"s":84,"from":10,"to":15,"text":"وَأَمَّا مَنْ أُوتِيَ كِتَابَهُ وَرَاءَ ظَهْرِهِ (10) فَسَوْفَ يَدْعُو ثُبُورًا (11) وَيَصْلَى سَعِيرًا (12) إِنَّهُ كَانَ فِي أَهْلِهِ مَسْرُورًا (13) إِنَّهُ ظَنَّ أَنْ لَنْ يَحُورَ (14) بَلَى إِنَّ رَبَّهُ كَانَ بِهِ بَصِيرًا (15)","hl":[[0,228,1]]}},{"id":"ق-1459","fp":"57a2b70cf911","stateId":591,"easy":"الهمز واللمز وجمع المال وتعديده ظناً أنه يخلّده ← الويل والنبذ في الحطمة","cause":"الهمز واللمز وجمع المال وتعديده ظناً أنه يخلّده","result":"الويل والنبذ في الحطمة","explicit":true,"ref":"سورة الهمزة: 1–9","srcLabel":"القرآن الكريم","quran":{"s":104,"from":1,"to":9,"text":"وَيْلٌ لِكُلِّ هُمَزَةٍ لُمَزَةٍ (1) الَّذِي جَمَعَ مَالًا وَعَدَّدَهُ (2) يَحْسَبُ أَنَّ مَالَهُ أَخْلَدَهُ (3) كَلَّا لَيُنْبَذَنَّ فِي الْحُطَمَةِ (4) وَمَا أَدْرَاكَ مَا الْحُطَمَةُ (5) نَارُ اللَّهِ الْمُوقَدَةُ (6) الَّتِي تَطَّلِعُ عَلَى الْأَفْئِدَةِ (7) إِنَّهَا عَلَيْهِمْ مُؤْصَدَةٌ (8) فِي عَمَدٍ مُمَدَّدَةٍ (9)","hl":[[0,320,1]]}},{"id":"س-03055","fp":"4a0e5a826d86","stateId":591,"easy":"إذا نحت ولم تتوبي قبل الموت ← تُبعثين يوم القيامة عليك سرابيل من قطران","cause":"النائحةَ إذا لم تَتُبْ قبلَ أنْ تموتَ","result":"فإِنَّها تُبْعَثُ يومَ القيامَةِ عليْها سرابيلُ مِنْ قطِرانٍ ، ثُمَّ يُغْلَى عليها بدروعٍ مِنْ لهبِ النارِ","explicit":true,"ref":"صحيح الجامع 6809","srcLabel":"صحيح الجامع","text":["النياحةُ على الميتِ مِنْ أمرِ الجاهليةِ ، وإِنَّ ",["النائحةَ إذا لم تَتُبْ قبلَ أنْ تموتَ",1]," ، ",["فإِنَّها تُبْعَثُ يومَ القيامَةِ عليْها سرابيلُ مِنْ قطِرانٍ ، ثُمَّ يُغْلَى عليها بدروعٍ مِنْ لهبِ النارِ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس وأبو مالك الأشعري","muhaddith":"صحيح","bab":"إيمان › الوعيد","dorar":"8YThLFSB","merged":5,"otherRefs":["صحيح ابن ماجه 1295 (صحيح)","صحيح الجامع 6792 (صحيح)","الفتاوى الكبرى 3/67 (صحيح)","مجمع الزوائد 16/3 (حسن)"]},{"id":"س-04554","fp":"3322c84d26c5","stateId":591,"easy":"إذا تكلمت بكلمة لا تلقي لها بالاً (من سخط الله) ← تهوي بها في النار","cause":"إنَّ الرَّجُلَ لَيتكَلَّمُ بالكَلمةِ، وما يَرى أنَّها تَبلُغُ حيثُ بلَغَتْ","result":"يَهوي بها في النَّارِ سَبعينَ خَريفًا","explicit":true,"ref":"تخريج المسند لشعيب 10895","srcLabel":"الترمذي","text":[["إنَّ الرَّجُلَ لَيتكَلَّمُ بالكَلمةِ، وما يَرى أنَّها تَبلُغُ حيثُ بلَغَتْ",1],"، ",["يَهوي بها في النَّارِ سَبعينَ خَريفًا",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2314)، وابن ماجه (3970)، وأحمد (10895) واللفظ له","bab":"جهنم › شدة نار جهنم وبعد قعرها","dorar":"0fp2L05u","merged":4,"otherRefs":["المستدرك على الصحيحين 8994 (صحيح)","صحيح ابن ماجه 3221 (صحيح)","تخريج المسند لشعيب 7958 (صحيح)"]},{"id":"س-05153","fp":"18176b0761b7","stateId":591,"easy":"إذا حلفت على المنبر النبوي يميناً آثمة ← فتبوأ مقعدك من النار","cause":"مَن حَلَف على مِنبَري هذا على يَمينٍ آثِمةٍ","result":"فليَتبَوَّأْ مَقعَدَه منَ النَّارِ","explicit":true,"repOf":"س-04295","ref":"المستدرك على الصحيحين 8020","text":[["مَن حَلَف على مِنبَري هذا على يَمينٍ آثِمةٍ ",1],["فليَتبَوَّأْ مَقعَدَه منَ النَّارِ -",2],"أو قالَ: إلَّا وَجَبَت له النَّارُ-، ولو على سِواكٍ أخضَرَ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح الإسناد","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"UBbGS5bs","merged":4,"otherRefs":["المحلى 8/37 (صحيح)","تخريج المسند لشعيب 19912 (صحيح)","تخريج سنن أبي داود 3242 (صحيح)"]},{"id":"س-07099","fp":"d4d5bd8c59ba","stateId":591,"easy":"إذا سُئلت عن علم فكتمته ← تأتي يوم القيامة ملجماً بلجام من نار","cause":"مَنْ سُئِلَ عَنْ عِلْمٍ فَكَتَمَهُ","result":"جيءَ به يَوْمَ القيامَةِ وقدْ أُلْجِمَ بِلِجامٍ مِنْ نارٍ","explicit":true,"similar":["س-04296","س-02932","س-02991","س-03063"],"ref":"المستدرك على الصحيحين 348","srcLabel":"أبو داود","text":["جاءَ الأَعْمَشُ إلى عَطاءٍ، فَسَألَهُ عنْ حَديثٍ فَحَدَّثَهُ، فقُلنا لهُ: تُحَدِّثُ هذا وهو عِراقيٌّ؟ قالَ: لأَنِّي سَمِعْتُ أبا هُرَيْرَةَ يُحَدِّثُ عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ قالَ: «",["مَنْ سُئِلَ عَنْ عِلْمٍ فَكَتَمَهُ",1]," ",["جيءَ به يَوْمَ القيامَةِ وقدْ أُلْجِمَ بِلِجامٍ مِنْ نارٍ",2],"»."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح على شرط الشيخين]","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) بلفظه (1613)، وأبو داود (3658)، والترمذي (2649) بنحوه.","bab":"علم › تعليم الناس وفضل ذلك","dorar":"HqCmSFqS","merged":4,"otherRefs":["المطالب العالية 3/313 (صحيح)","تخريج المسند لشعيب 10420 (صحيح)","تخريج سنن أبي داود 3658 (صحيح)"]},{"id":"س-02950","fp":"3b12c8290b16","stateId":591,"easy":"إذا ادعيت رؤيا لم ترها ← تُكلّف أن تعقد شعيرة","cause":"و منْ أَرَى عينيهِ في المنامِ ما لمْ يرَ","result":"كُلِّفُ أنْ يعقدَ شعيرةً","explicit":true,"repOf":"س-00417","ref":"الجامع الصغير 8407","text":["من استمعَ إلى حديثَ قومٍ،  و همْ لهُ كارهونَ،  صُبَّ في أذنيهِ الآنُكُ،  ",["و منْ أَرَى عينيهِ في المنامِ ما لمْ يرَ",1]," ",["كُلِّفُ أنْ يعقدَ شعيرةً",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن","takhrij":"أخرجه الطبراني (11/248) (11637) باختلاف يسير، وأخرجه البخاري (7042) بنحوه","bab":"إيمان › الوعيد","dorar":"ZgG06Mm9"},{"id":"س-03763","fp":"db554ce8a223","stateId":591,"easy":"إذا افتريت على النبي ﷺ ← فتبوأ بيتاً في جهنم","cause":"فمَن عقَل شيئًا فلْيُحَدِّثْ به، ومَنِ افتَرى علَيَّ","result":"فلْيَتبوَّأْ بيتًا، أو مَقعَدًا في جَهنَّمَ","explicit":true,"repOf":"س-08317","ref":"تخريج مشكل الآثار 412","text":["أنَّ وَداعةَ الحَمْديَّ حدَّثهُ: أنَّه كان بجَنْبِ مالِكِ بنِ عُبادةَ أبي موسى الغافِقيِّ، وعُقْبةُ بنُ عامرٍ يَقُصُّ يقولُ: قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقال مالِكٌ: إنَّ صاحبَكم هذا غافلٌ، أو هالِكٌ، إنَّ النَّبيَّ عليه السَّلامُ عهِد إلينا في حَجَّةِ الوَداعِ، فقال: عليكم بالقُرآنِ، وإنَّكم ستَرجِعونَ إلى قومٍ يَشتَهونَ الحديثَ عنِّي، ",["فمَن عقَل شيئًا فلْيُحَدِّثْ به، ومَنِ افتَرى علَيَّ؛ ",1],["فلْيَتبوَّأْ بيتًا، أو مَقعَدًا في جَهنَّمَ",2],"."],"grade":"حسن","narrator":"مالك بن عبادة (أبو موسى الغافقي)","muhaddith":"[فيه] وداعة الحمدي: لم يوثقه غير ابن حبان، وترجم له البخاري وابن أبي حاتم فلم يذكرا فيه جرحا ولا تعديلا، وباقي رجاله ثقات","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار))  (412) والطبراني ((19/ 296)) (658) واللفظ لهما، والدولابي في ((الكنى والأسماء)) (331) باختلاف يسير","bab":"اعتصام بالسنة › نقل السنة وروايتها","dorar":"B1ePxERu"},{"id":"س-04296","fp":"dd2575393c76","stateId":591,"easy":"إذا كتمت علماً ← يلجمك الله يوم القيامة بلجام من نار","cause":"مَنْ كَتَمَ عِلْمًا","result":"أَلْجَمَهُ اللهُ يومَ القيامَةِ بِلِجامٍ مِنْ نارٍ","explicit":true,"repOf":"س-07099","ref":"المستدرك على الصحيحين 350","text":["«",["مَنْ كَتَمَ عِلْمًا؛ ",1],["أَلْجَمَهُ اللهُ يومَ القيامَةِ بِلِجامٍ مِنْ نارٍ»",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح من حديث المصريين على شرط الشيخين","takhrij":"أخرجه ابن حبان (96) بلفظه، ونعيم بن حماد في زياداته على ((الزهد)) لابن المبارك (2/ 119)، والطبراني في ((الأوسط)) (5027) كلاهما باختلاف يسير.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"OBGYsqbj","merged":3,"otherRefs":["تخريج سير أعلام النبلاء 23/ 134 (صحيح)","تخريج صحيح ابن حبان 95 (صحيح)"]},{"id":"س-05014","fp":"deb6403a7600","stateId":591,"easy":"إذا مكرت وخدعت ← فالمكر والخديعة في النار","cause":"المكرُ و الخَديعةُ","result":"في النَّارِ","explicit":true,"ref":"صحيح الجامع 6725","srcLabel":"ابن عدي","text":[["المكرُ و الخَديعةُ",1]," ",["في النَّارِ",2]],"grade":"صحيح","narrator":"قيس بن سعد","muhaddith":"صحيح","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (2/161) مطولاً، والديلمي في ((الفردوس)) (6658) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"bHpx61Mf","merged":3,"otherRefs":["صحيح الجامع 6726 (حسن)","فتح الباري لابن حجر 4/417 (حسن)"]},{"id":"س-00433","fp":"f862962423c4","stateId":591,"easy":"إذا شنت مسلماً بكلمة بغير حق ← يشينك الله بها في النار يوم القيامة","cause":"مَن شانَ على مُسلِمٍ كَلمةً يُشينُهُ بها بغيرِ حقٍّ","result":"أشانَهُ اللهُ بها في النَّارِ يومَ القيامةِ","explicit":true,"ref":"المستدرك على الصحيحين 8106","srcLabel":"ابن أبي الدنيا","text":[["مَن شانَ على مُسلِمٍ كَلمةً يُشينُهُ بها بغيرِ حقٍّ، ",1],["أشانَهُ اللهُ بها في النَّارِ يومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"أبو ذر","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن أبي الدنيا في ((ذم الغيبة والنميمة)) (120)، وأبو الشيخ في ((التوبيخ والتنبيه)) (138) واللفظ لهما.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"FD4GEbOb","merged":2,"otherRefs":["الجامع الصغير 8420 (حسن)"]},{"id":"س-02925","fp":"27afd3f530ff","stateId":591,"easy":"إذا كذبت في حلمك ← تُكلّف يوم القيامة عقد شعيرة","cause":"مَنْ كَذَبَ فِي حُلْمِهِ","result":"كُلِّفَ يَوْمَ القيامَةِ عقْدَ شعيرةٍ","explicit":true,"ref":"صحيح الجامع 6520","srcLabel":"صحيح الجامع","text":[["مَنْ كَذَبَ فِي حُلْمِهِ ، ",1],["كُلِّفَ يَوْمَ القيامَةِ عقْدَ شعيرةٍ",2]],"grade":"صحيح","narrator":"علي بن أبي طالب وعبدالله بن عباس","muhaddith":"صحيح","bab":"إيمان › الوعيد","dorar":"rgvTouZx","merged":2,"otherRefs":["تخريج المسند لشعيب 1088 (حسن)"]},{"id":"س-03098","fp":"80dbc53da29c","stateId":591,"easy":"إذا كذبت على النبي ﷺ متعمداً ← فتبوأ مضجعك من النار","cause":"مَن كَذَبَ عليَّ كَذبةً مُتَعَمِّدًا","result":"فليَتَبَوَّأ مَضجَعًا مِنَ النَّارِ - أو بَيتًا في جَهَنَّمَ","explicit":true,"repOf":"س-08317","ref":"تخريج المسند لشعيب 15482","text":[["مَن كَذَبَ عليَّ كَذبةً مُتَعَمِّدًا ",1],["فليَتَبَوَّأ مَضجَعًا مِنَ النَّارِ - أو بَيتًا في جَهَنَّمَ -",2],"."],"grade":"صحيح","narrator":"قيس بن سعد بن عبادة","muhaddith":"صحيح لغيره","bab":"إيمان › الوعيد","dorar":"7kKtTdWj","merged":2,"otherRefs":["تخريج المسند لشعيب 11350 (صحيح)"]},{"id":"س-05085","fp":"01a9e23f42f6","stateId":591,"easy":"إذا قلت في مؤمن ما ليس فيه ← يسكنك الله ردغة الخبال حتى تخرج مما قلت","cause":"ومَن قال في مؤْمِنٍ ما ليس فيه","result":"أَسْكَنَه اللهُ رَدْغةَ الخَبَالِ حتى يَخرُجَ ممَّا قالَ","explicit":true,"ref":"تخريج المسند لشعيب 5385","srcLabel":"أبو داود","text":["خرَجْنا حُجَّاجًا عَشَرةً مِن أهلِ الشَّامِ، حتى أَتَيْنا مكَّةَ، فذَكَر الحديثَ، قال: فأَتَيْناهُ، فخَرَج إلينا -يعني: ابنَ عُمرَ، فقال: سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقول: مَن حالَتْ شَفاعَتُه دُونَ حدٍّ مِن حُدودِ اللهِ عزَّ وجلَّ، فقد ضادَّ اللهَ أَمْرَه، ومَن مات وعليه دَيْنٌ، فليس بالدِّينارِ ولا بالدِّرهمِ، ولكنَّها الحسَناتُ والسَّيِّئاتُ، ومَن خاصَمَ في باطِلٍ وهو يَعْلَمُه، لم يَزَلْ في سَخَطِ اللهِ حتى يَنزِعَ، ",["ومَن قال في مؤْمِنٍ ما ليس فيه، ",1],["أَسْكَنَه اللهُ رَدْغةَ الخَبَالِ حتى يَخرُجَ ممَّا قالَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3597)، وأحمد (5385) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"jwOzDMmj","merged":2,"otherRefs":["السلسلة الصحيحة 437 (صحيح)"]},{"id":"س-05147","fp":"c50f07ed136c","stateId":591,"easy":"إذا شهدت زوراً ← لا تزول قدماك حتى يوجب الله لك النار","cause":"شاهِدُ الزُّورِ لا تَزولُ قَدَماهُ","result":"حتَّى يُوجِبَ اللهُ لهما النَّارَ","explicit":true,"similar":["س-02935","س-04908"],"ref":"المستدرك على الصحيحين 7238","srcLabel":"الطبراني","text":[["شاهِدُ الزُّورِ لا تَزولُ قَدَماهُ ",1],["حتَّى يُوجِبَ اللهُ لهما النَّارَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني  (13/ 131)، (13802) بلفظه، والحار ث بن أبي أسامة كما في ((بغية الباحث)) للهيثمي (465)، وأبو يعلى الموصلي (5672) كلاهما بزيادة في لفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"4IkEmkCU","merged":2,"otherRefs":["الترغيب والترهيب 3/227 (صحيح)"]},{"id":"س-05502","fp":"9dbf5575ae1a","stateId":591,"easy":"إذا أكلت برجل مسلم أكلة (بالنيل منه) ← يطعمك الله مثلها من جهنم","cause":"مَنْ أكل برَجلٍ مُسلمٍ أكْلَةً","result":"فإنَّ اللهَ يُطعِمُهُ مِثلَها من جهنَّمَ","explicit":true,"repOf":"س-05478","ref":"صحيح الجامع 6083","text":[["مَنْ أكل برَجلٍ مُسلمٍ أكْلَةً ، ",1],["فإنَّ اللهَ يُطعِمُهُ مِثلَها من جهنَّمَ ، ",2],"ومَنِ اكْتسَى برَجلٍ مُسلمٍ ثوْبًا ، فإنَّ اللهَ يَكسُوهُ مِثلَهُ من جهنَّمَ ، ومَنْ قامَ برَجلٍ مُسلمٍ مَقامَ سُمْعةٍ ورِياءٍ ، فإنَّ اللهَ يقومُ بهِ مَقامَ سُمعةٍ ورِياءٍ يومَ القيامةِ"],"grade":"صحيح","narrator":"المستورد بن شداد","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4881)، وأحمد (18011) باختلاف يسير.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"SeBidggI","merged":2,"otherRefs":["صحيح الأدب المفرد 179 (صحيح)"]},{"id":"س-00298","fp":"7e48a059f7f0","stateId":591,"easy":"إذا ملأ الله أذنيك من ثناء الناس شراً ← فأنت من أهل النار","cause":"من ملأَ أذُنَيْهِ من ثَناءِ النَّاسِ شرًّا وَهوَ يسمَعُ","result":"وأَهْلُ النَّارِ","explicit":true,"ref":"مصباح الزجاجة 4/243","srcLabel":"ابن ماجه","text":["أَهْلُ الجنَّةِ مَن ملأَ اللَّهُ أذُنَيْهِ من ثَناءِ النَّاسِ خيرًا وَهوَ يسمعُ، ",["وأَهْلُ النَّارِ",2]," ",["من ملأَ أذُنَيْهِ من ثَناءِ النَّاسِ شرًّا وَهوَ يسمَعُ",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح رجاله ثقات","takhrij":"أخرجه ابن ماجه (4224) واللفظ له، والطبراني (12/ 170) (12787)، وأبو نعيم في ((حلية الأولياء)) (3/ 80) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"4ipX0kYA"},{"id":"س-00375","fp":"7b1f1a1a9a2f","stateId":591,"easy":"إذا تكلمت بكلمة تضحك بها جلساءك (بسوء) ← تهوي بها أبعد من الثريا","cause":"لَيتكلَّمُ بالكلمةِ يُضحِكُ بها جُلساءَه","result":"يهوِي بها مِن أبعدَ مِن الثُّريَّا","explicit":true,"similar":["س-06860"],"ref":"صحيح ابن حبان 5716","srcLabel":"أحمد","text":["إنَّ الرَّجُلَ ",["لَيتكلَّمُ بالكلمةِ يُضحِكُ بها جُلساءَه",1]," ",["يهوِي بها مِن أبعدَ مِن الثُّريَّا",2]," )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (9220)، والبزار (8732)، وابن عدي في ((الكامل في الضعفاء)) (3/225) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"vInQWYQ7"},{"id":"س-00507","fp":"6f9ff605096f","stateId":591,"easy":"إذا كذبت على النبي ﷺ متعمداً ← فتبوأ مقعدك من النار","cause":"من أدَمٍ في نحوٍ من أربعينَ رجلًا فقال : إنكم مفتوحٌ عليكم منصورونَ ومصيبونَ فمَن أدرَك ذلكَ منكمْ فليتقِ اللهَ وليأمرْ بالمعروفِ وليَنهَ عن المنكرِ وليصلْ رَحِمَه من كذب علَيَّ مُتعمِّدًا","result":"فليتبوأْ مقعدَه من النارِ ومثلُ الذي يُعينُ قومَه على غيرِ الحقِّ كمثلِ بعيرٍ رديٍّ في بئرٍ فهو ينزعُ منها بذَنبِه","explicit":true,"repOf":"س-08317","ref":"تخريج المسند لشاكر 5/306","text":["انتهيت إلى النبيِّ صلَّى اللهُ عليهِ وسلمَ  وهو في قُبَّةٍ حمراءَ قال عبدُ الملكِ : ",["من أدَمٍ في نحوٍ من أربعينَ رجلًا فقال : إنكم مفتوحٌ عليكم منصورونَ ومصيبونَ فمَن أدرَك ذلكَ منكمْ فليتقِ اللهَ وليأمرْ بالمعروفِ وليَنهَ عن المنكرِ وليصلْ رَحِمَه من كذب علَيَّ مُتعمِّدًا ",1],["فليتبوأْ مقعدَه من النارِ ومثلُ الذي يُعينُ قومَه على غيرِ الحقِّ كمثلِ بعيرٍ رديٍّ في بئرٍ فهو ينزعُ منها بذَنبِه",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (3801) واللفظ له، والبزار (2013) مختصراً، وأبو يعلى (5304) باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"2fFiwMmF"},{"id":"س-00632","fp":"0bb0b338f0a4","stateId":591,"easy":"إذا حلفت على منبر النبي ﷺ يميناً آثمة ← وجبت لك النار ولو على قضيب أراك","cause":"من حلفَ على منبري بيمينٍ آثِمةٍ","result":"وجبت له النار وإن كانَ قضيبًا من أراكٍ","explicit":true,"repOf":"س-04295","ref":"المحلى 9/497","text":[["من حلفَ على منبري بيمينٍ آثِمةٍ ",1],["وجبت له النار وإن كانَ قضيبًا من أراكٍ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"آداب عامة › ضرب الأمثال","dorar":"G8ZqIjHC"},{"id":"س-01191","fp":"698b99091b2d","stateId":591,"easy":"إذا قذفت مؤمناً أو مؤمنة ← يحبسك الله في ردغة الخبال (عصارة أهل النار)","cause":"ومن قَفَا مؤمنًا أو مؤمنةً","result":"حبسهُ اللهُ في رَدْغَةِ الخَبَالِ عصارةِ أهلِ النارِ","explicit":true,"similar":["س-01198"],"ref":"تخريج المسند لشاكر 7/255","srcLabel":"أحمد","text":["عن أيوب بن سلمان رجل من أهل صنعاء قال: كنَّا بمكةَ فجلسنا إلى عطاءٍ الخراسانيِّ إلى جنبِ جدارِ المسجدِ فلم نسألْه ولم يُحدِّثْنا قال ثم جلسنا إلى ابنِ عمرَ مثلَ مجلسِكم هذا فلمْ نسألْه ولم يُحدِّثْنا قال فقال ما بالُكم لا تتكلَّمونَ ولا تذكرونَ اللهَ قولوا اللهُ أكبرُ والحمدُ للهِ وسبحانَ اللهِ وبحمدِهِ بواحدةٍ عشرًا وبعشرٍ مائةً من زادَ زادهُ اللهُ ومن سكتَ غُفِرَ لهُ ألا أُخبرُكم بخمسٍ سمعتهنَّ من رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ؟ قالوا : بَلَى قال من حالتْ شفاعتُهُ دونَ حَدٍّ من حدودِ اللهِ فهو مُضَادُّ اللهِ في أمرِهِ ومن أعانَ على خصومةٍ بغيرِ حقٍّ فهو مُستظلٌّ في سخطِ اللهِ حتى يتركَ ",["ومن قَفَا مؤمنًا أو مؤمنةً",1]," ",["حبسهُ اللهُ في رَدْغَةِ الخَبَالِ عصارةِ أهلِ النارِ",2]," ومن ماتَ وعليهِ دَيْنٌ أُخِذَ لصاحبِه من حسناتِه لا دينارَ ثَمَّ ولا درهمَ وركعتا الفجرِ، حافظوا عليهما فإنَّهما من الفضائلِ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (5544)","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"2sGjBDac"},{"id":"س-01198","fp":"6ea42b470416","stateId":591,"easy":"إذا بهتّ مؤمناً أو مؤمنة ← يحبسك الله في ردغة الخبال حتى تخرج مما قلت","cause":"ومَن بهَت مؤمنًا أو مؤمنةً","result":"حبَسه اللهُ في رَدْغةِ الخَبالِ يومَ القيامةِ حتَّى يخرُجَ ممَّا قال وليس بخارجٍ","explicit":true,"repOf":"س-01191","ref":"مجمع الزوائد 10/94","text":["مَن قال سُبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ واللهُ أكبَرُ كُتِبَتْ له بكلِّ حرفٍ عَشْرُ حسناتٍ ومَن أعان على خصومةِ باطلٍ لم يزَلْ في سَخَطِ اللهِ حتَّى ينزِعَ ومَن حالت شفاعتُه دونَ حدٍّ مِن حدودِ اللهِ فقد ضادَّ اللهَ في أمرِه ",["ومَن بهَت مؤمنًا أو مؤمنةً ",1],["حبَسه اللهُ في رَدْغةِ الخَبالِ يومَ القيامةِ حتَّى يخرُجَ ممَّا قال وليس بخارجٍ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"رجاله رجال الصحيح غير محمد بن منصور الطوسي وهو ثقة","takhrij":"أخرجه أبو داود (3597)، وأحمد (5544) باختلاف يسير، وابن ماجه (2320) مختصراً","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"A31kGr3M"},{"id":"س-02575","fp":"d7c61cfb9844","stateId":591,"easy":"إذا كذبت على النبي ﷺ ← يُبنى لك بيت في جهنم","cause":"مَن كَذَبَ عليَّ","result":"بُنِي له بَيْتٌ في جهنَّم","explicit":true,"repOf":"س-08317","ref":"الكبائر للذهبي 154","text":[["مَن كَذَبَ عليَّ ",1],["بُنِي له بَيْتٌ في جهنَّم",2],"."],"grade":"صحيح","narrator":"[أبو قرصافة]","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((الكبير)) (3/ 18) (2516)، والدولابي في ((الكنى والأسماء)) (292)، وابن بشران في ((أماليه-الجزء الأول)) (944) بنحوه تامًا.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"WBncKZH1"},{"id":"س-02931","fp":"25de72e05555","stateId":591,"easy":"إذا قلت في القرآن بغير علم ← تأتي يوم القيامة ملجماً بلجام من نار","cause":"ومَنْ قال في القرآنِ بغيرِ عِلْمٍ","result":"جاء يومَ القيامةِ مُلَجَّمًا بِلِجَامٍ من نارٍ","explicit":true,"ref":"المطالب العالية 3/313","srcLabel":"الطبراني","text":["مَنْ سُئِلَ عن عِلْمٍ فَكَتَمَهُ جاء يومَ القِيامَةَ مُلْجَمًا بِلِجَامٍ من نارٍ ، ",["ومَنْ قال في القرآنِ بغيرِ عِلْمٍ ",1],["جاء يومَ القيامةِ مُلَجَّمًا بِلِجَامٍ من نارٍ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه أبو يعلى (2585)، والطبراني (11/145) (11310)، والخطيب في ((تاريخ بغداد)) (7/406)","bab":"إيمان › الوعيد","dorar":"fJuPyeGb"},{"id":"س-02932","fp":"6edd56597595","stateId":591,"easy":"إذا كتمت علماً عن أهله ← تُلجم يوم القيامة بلجام من نار","cause":"مَن كتم عِلْمًا على أهلِه","result":"أُلْجِمَ ، يومَ القيامةِ لِجَامًا","explicit":true,"repOf":"س-07099","ref":"صحيح الجامع 6517","text":[["مَن كتم عِلْمًا على أهلِه ، ",1],["أُلْجِمَ ، يومَ القيامةِ لِجَامًا ",2],"من نارٍ"],"grade":"صحيح","narrator":"عبدالله بن عمرو وابن مسعود","muhaddith":"صحيح","bab":"إيمان › الوعيد","dorar":"xTLXAzkM"},{"id":"س-02935","fp":"de33c54a4718","stateId":591,"easy":"إذا شهدت زوراً ← لا تفارق قدماك الأرض حتى تُقذف في النار","cause":"شاهدُ الزُّورِ","result":"ولا تفارقُ قدماه على الأرضِ حتَّى يُقذفَ به في النَّارِ","explicit":true,"repOf":"س-05147","ref":"الترغيب والترهيب 3/227","text":["إنَّ الطَّيرَ لتضرِبُ بمناقيرِها وتُحرِّك أذنابِها من هولِ يومِ القيامةِ وما يتكلَّمُ به ",["شاهدُ الزُّورِ",1]," ",["ولا تفارقُ قدماه على الأرضِ حتَّى يُقذفَ به في النَّارِ",2]],"grade":"صحيح","narrator":"[عبدالله بن عمر]","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((الأوسط)) (7616)، وابن المقريء في ((معجمه)) (1304)، والعقيلي في ((الضعفاء)) (6440) واللفظ لهم.","bab":"إيمان › الوعيد","dorar":"oQjYTAuE"},{"id":"س-02936","fp":"0853e6c52322","stateId":591,"easy":"إذا كنت ذا وجهين في الدنيا ← تأتي يوم القيامة ولك وجهان من نار","cause":"ذو الوجهَيْن في الدُّنيا","result":"يأتي يومَ القيامةِ ، وله وجهان من نارٍ","explicit":true,"ref":"الترغيب والترهيب 4/57","srcLabel":"الطبراني","text":[["ذو الوجهَيْن في الدُّنيا",1]," ",["يأتي يومَ القيامةِ ، وله وجهان من نارٍ",2]],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((الأوسط)) (6278) بلفظه.","bab":"إيمان › الوعيد","dorar":"US0urbA2"},{"id":"س-02990","fp":"3152537433f2","stateId":591,"easy":"إذا كان لك وجهان في الدنيا ← يكون لك يوم القيامة لسانان من نار","cause":"مَنْ كان لهُ وجْهانِ في الدنيا","result":"كان لهُ يومَ القيامةِ لِسانانِ من نارٍ","explicit":true,"ref":"صحيح الترغيب 2949","srcLabel":"أبو داود","text":[["مَنْ كان لهُ وجْهانِ في الدنيا ؛ ",1],["كان لهُ يومَ القيامةِ لِسانانِ من نارٍ",2]],"grade":"صحيح","narrator":"عمار بن ياسر","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (4873) واللفظ له، والدارمي (2764)، وأبو يعلى (1620).","bab":"إيمان › الوعيد","dorar":"me9z3Vlu"},{"id":"س-02991","fp":"ccdb9cfd6f8d","stateId":591,"easy":"إذا حفظت علماً فكتمته ← تأتي يوم القيامة ملجماً بلجام من نار","cause":"ما من رجلٍ يَحْفَظُ عِلْمًا فَيَكْتُمُهُ","result":"إِلَّا أُتِيَ بهِ يومَ القيامةِ مُلْجومًا بِلِجَامٍ مِنَ النارِ","explicit":true,"repOf":"س-07099","ref":"صحيح الترغيب 120","text":[["ما من رجلٍ يَحْفَظُ عِلْمًا فَيَكْتُمُهُ ؛",1]," ",["إِلَّا أُتِيَ بهِ يومَ القيامةِ مُلْجومًا بِلِجَامٍ مِنَ النارِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (3658)، والترمذي (2649)، وأحمد (7571) بنحوه، وابن ماجه (261) واللفظ له","bab":"إيمان › الوعيد","dorar":"yGvUSiO4"},{"id":"س-02992","fp":"c263bbc35094","stateId":591,"easy":"إذا كنت ذا لسانين ← يجعل الله لك يوم القيامة لسانين من نار","cause":"من كان ذا لسانَين","result":"جعل اللهُ له يومَ القيامةِ لسانَين من نارٍ","explicit":true,"ref":"صحيح الترغيب 2950","srcLabel":"الطبراني","text":[["من كان ذا لسانَين ؛ ",1],["جعل اللهُ له يومَ القيامةِ لسانَين من نارٍ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن أبي الدنيا في ((ذم الغيبة والنميمة)) (144)، وابن أبي عاصم في ((الزهد)) (217)، والطبراني في ((المعجم الأوسط)) (8885) واللفظ له","bab":"إيمان › الوعيد","dorar":"9a1TOqcu"},{"id":"س-03065","fp":"bdf78505d6b4","stateId":591,"easy":"إذا قلت في القرآن بغير علم ← فتبوأ مقعدك من النار","cause":"مَن قالَ في القُرآنِ بغَيرِ علمٍ","result":"فَليَتبوَّأ مَقعدَهُ منَ النَّارِ","explicit":true,"ref":"سنن الترمذي 2950","srcLabel":"الترمذي","text":[["مَن قالَ في القُرآنِ بغَيرِ علمٍ ، ",1],["فَليَتبوَّأ مَقعدَهُ منَ النَّارِ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"حسن صحيح","takhrij":"أخرجه الترمذي (2950)، والنسائي في ((السنن الكبرى)) (8085)، وأحمد (2069)","bab":"إيمان › الوعيد","dorar":"39HVdaND"},{"id":"س-03487","fp":"f3ec36675f32","stateId":591,"easy":"إذا حلفت أن الله لا يغفر لفلان ← يغفر الله له ويحبط عملك","cause":"فحَلَفَ رجلٌ أنه لا يُغْفَرَ له","result":"فغَفَرَ اللهُ للمذنِبِ وسخِطَ على المُتَأَلِّي","explicit":true,"otherNeedIds":[45],"ref":"عارضة الأحوذي 4/320","srcLabel":"عارضة الأحوذي","text":["إنَّ رجلًا كانَ عاصِيًا ",["فحَلَفَ رجلٌ أنه لا يُغْفَرَ له",1]," ",["فغَفَرَ اللهُ للمذنِبِ وسخِطَ على المُتَأَلِّي",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"VTiJHb7a"},{"id":"س-03792","fp":"4fec2036ae12","stateId":591,"easy":"إذا قذفت أمتك بالزنا وهي بريئة ← تجلدك يوم القيامة","cause":"قال أو قالتْ لِوَليدتِها: يا زانيةُ، ولم تَطَّلِعْ منها على زِنًا","result":"جلَدَتْها وَليدتُها يَومَ القيامةِ","explicit":true,"ref":"المستدرك على الصحيحين 8321","srcLabel":"ابن عساكر","text":["عن عُمرِو بنِ العاصِ رَضيَ اللهُ عنه: أنَّه زارَ عمَّةً له، فدَعَت له بطَعامٍ، فأبْطَأَت الجاريةُ، فقالت: ألَا تَسْتعجِلي يا زانيةُ! فقال عُمرٌو: سُبحانَ اللهِ! لَقدْ قُلتِ أمرًا عظيمًا، هلِ اطَّلعْتِ منها على زِنًا؟ قالت: لا واللهِ، فقال عَمرٌو رَضيَ اللهُ عنه: إنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: أيُّما عَبدٍ أو امرأةٍ ",["قال أو قالتْ لِوَليدتِها: يا زانيةُ، ولم تَطَّلِعْ منها على زِنًا",1],"؛ ",["جلَدَتْها وَليدتُها يَومَ القيامةِ",2],"؛ لأنَّه لا حَدَّ لهنَّ في الدُّنيا."],"grade":"صحيح","narrator":"عمرو بن العاص","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن عساكر في ((تاريخه)) (46/ 181) بنحوه.","bab":"بر وصلة › إكرام الزائر","dorar":"eE5ormSs"},{"id":"س-04223","fp":"b62df9293922","stateId":591,"easy":"إذا كذبت ← فجرت، وإذا فجرت كفرت، وإذا كفرت دخلت النار","cause":"الكذِبُ إذا كذَبَ العبدُ فجَرَ ، وإذا فجرَ كفَرَ","result":"وإذا كفَرَ دخلَ","explicit":true,"repOf":"س-00196","otherNeedIds":[20],"ref":"تخريج المسند لشاكر 10/126","text":["أنَّ رجلًا جاءَ إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ : يا رسولَ اللَّهِ ما عَملُ الجنَّةِ ؟ قالَ : الصِّدقُ ، وإذا صدَقَ العبدُ بَرَّ ، وإذا بَرَّ آمَنَ ، وإذا آمَنَ دخلَ الجنَّةَ ، قالَ : يا رسولَ اللَّهِ ، ما عمَلُ النَّارِ ؟ قالَ : ",["الكذِبُ إذا كذَبَ العبدُ فجَرَ ، وإذا فجرَ كفَرَ",1]," ، ",["وإذا كفَرَ دخلَ",2]," يعني النَّارَ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو يعلى كما في ((إتحاف الخيرة المهرة)) للبوصيري (6/85) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"DAP2yanO"},{"id":"س-04226","fp":"1217b31b9c88","stateId":591,"easy":"إذا كذبت على النبي ﷺ ← ففي النار","cause":"من كذب عليَّ","result":"فهو في النَّارِ","explicit":true,"repOf":"س-08317","ref":"مسند الفاروق 2/623","text":["كنَّا إذا قلنا لعمرَ : حدِّثْنا عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم قال : أخافُ أن أزيدَ حرفًا أو أنقُصَ حرفًا ، إنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال : ",["من كذب عليَّ ",1],["فهو في النَّارِ",2]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"غريب من هذا الوجه ، وله طرق عن رسول الله صلى الله عليه وسلم متواترة","takhrij":"أخرجه أحمد (326)، وأبو طاهر السلفي في ((المشيخة البغدادية)) (2681) كلاهما مطولا بلفظه، والعقيلي في ((الضعفاء الكبير)) (2/ 45) بنحوه .","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"zdoA4Nv1"},{"id":"س-04247","fp":"3dfed511bf10","stateId":591,"easy":"إذا كذبت على النبي ﷺ ← فتبوأ بيتك من جهنم","cause":"مَن كذَب علَيَّ","result":"فلْيَتبوَّأْ بيتَهُ مِن جَهنَّمَ، وسمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: الحَريرُ والذَّهَبُ حرامٌ على ذُكورِ أُمَّتي، حِلٌّ لإنَاثِهم","explicit":true,"repOf":"س-08317","ref":"تخريج مشكل الآثار 416","text":["عن هِشامِ بنِ أبي رُقَيَّةَ اللَّخْميِّ، قال سمِعْتُ مَسْلَمةَ بنَ مُخَلَّدٍ، يقولُ لِعُقْبةَ بنِ عامرٍ: قُمْ فحدِّثِ النَّاسَ بما سمِعْتَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقام عُقْبةُ فقال: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن كذَب علَيَّ؛ ",1],["فلْيَتبوَّأْ بيتَهُ مِن جَهنَّمَ، وسمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: الحَريرُ والذَّهَبُ حرامٌ على ذُكورِ أُمَّتي، حِلٌّ لإنَاثِهم",2],"."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (416)، وأحمد (17431) باختلاف يسير، وابن حبان (5436) مختصرا.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"3wkfiYCa"},{"id":"س-04305","fp":"b680cd14b32c","stateId":591,"easy":"إذا قلت على النبي ﷺ ما لم يقل أو ادعيت لغير أبيك ← فتبوأ بيتاً في النار","cause":"مَن يَقُلْ عليَّ ما لم أقُلْ أوِ ادَّعى إلى غَيرِ أبيه وانتَمى إلى غَيرِ مَواليه","result":"فليَتَبَوَّأْ بَينَ عَينَي جَهَنَّمَ مَقعَدًا","explicit":true,"repOf":"س-08317","ref":"يقظة أولي الاعتبار 82","text":[["مَن يَقُلْ عليَّ ما لم أقُلْ أوِ ادَّعى إلى غَيرِ أبيه وانتَمى إلى غَيرِ مَواليه ",1],["فليَتَبَوَّأْ بَينَ عَينَي جَهَنَّمَ مَقعَدًا",2],"، قيل: يا رَسولَ اللهِ، وهَل لها مِن عَينَينِ؟! قال: نَعَم، أمَا سَمِعتُمُ اللَّهَ يَقولُ: {إِذَا رَأَتْهُمْ مِنْ مَكَانٍ بَعِيدٍ}"],"grade":"صحيح","narrator":"رجل من الصحابة","muhaddith":"[صحيح]","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"ljQsicab"},{"id":"س-04332","fp":"06fdd6e11f13","stateId":591,"easy":"إذا أفشت المرأة الأمانة وألحفت في السؤال وبخلت إذا سُئلت ← تكون من أكثر أهل النار","cause":"إنِ ائتُمِنَّ أفْشَيْنَ، وإنْ سَألْنَ ألْحَفْنَ، وإذا سُئِلنَ بَخَلْنَ، وإذا أُعطِينَ لم يَشكُرْنَ","result":"وأكثَرُ مَن رأيْتُ فيها مِنَ النِّساءِ","explicit":true,"ref":"المستدرك على الصحيحين 9014","srcLabel":"أحمد","text":["بيْنا نحنُ مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في صَلاةِ الظُّهرِ والنَّاسُ في الصُّفوفِ خلْفَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فرَأيْنا رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَتناوَلُ شَيئًا، فجَعَل يَتناوَلُه، فتَأخَّر وتَأخَّرَ النَّاسُ، ثمَّ تَأخَّر الثَّانيةَ فتَأخَّر النَّاسُ، فقُلتُ: يا رَسولَ اللهِ، رَأيْناك صَنعتَ اليومَ شَيئًا ما كُنتَ تَصنَعُه في الصَّلاةِ، فقال: إنَّه عُرِضَت علَيَّ الجنَّةُ بما فيها مِنَ الزَّهْرةِ والنَّضرةِ، فتَناوَلْتُ قِطفًا مِن عِنَبِها، ولوْ أخذْتُه لَأكَلَ منه مَن بيْن السَّماءِ والأرضِ لا يَنقُصُونه، فحِيلَ بيْني وبيْنه. وعُرِضَت علَيَّ النَّارُ، فلمَّا وجَدْتُ سَفْعَتَها تَأخَّرْتُ عنها، ",["وأكثَرُ مَن رأيْتُ فيها مِنَ النِّساءِ",2],"، ",["إنِ ائتُمِنَّ أفْشَيْنَ، وإنْ سَألْنَ ألْحَفْنَ، وإذا سُئِلنَ بَخَلْنَ، وإذا أُعطِينَ لم يَشكُرْنَ",1],"، ورأيْتُ فيها عَمْرَو بنَ لُحَيٍّ يجُرُّ قُصْبَه في النَّارِ، وأشْبَهُ مَن رأيْتُ به مَعبَدُ بنُ أكثَمَ الخُزاعيُّ، فقال مَعبَدٌ: يا رَسولَ اللهِ، أتَخْشَى علَيَّ مِن شَبَهِه؛ فإنَّه والدٌ؟ فقال: لا، أنتَ مُؤمِنٌ وهو كافرٌ، وهو أوَّلُ مَن حمَلَ العرَبَ على عِبادةِ الأصنامِ."],"grade":"صحيح","narrator":"أبو  بن كعب","muhaddith":"صحيح الإسناد ولم يخرجاه","takhrij":"أخرجه أحمد (21251)، والضياء في ((المختارة)) (1194) بنحوه.","bab":"جنة › صفة الجنة","dorar":"wzocmYYZ"},{"id":"س-04581","fp":"a7674a6a5492","stateId":591,"easy":"إذا أشعت على مسلم كلمة وهو بريء منها تشينه بها ← كان حقاً على الله أن يذيبك في النار","cause":"وأَيُّما رجلٍ أشاع على رجلٍ مسلمٍ بكَلِمَةٍ وهو منها بريءٌ يُشِينُه بها في الدنيا","result":"كان حَقًّا على اللهِ أن يُدْنِيَه يومَ القيامةِ في النارِ ، حتى يَأْتِيَ بإنفاذِ ما قال","explicit":true,"ref":"الجامع الصغير 2951","srcLabel":"الطبراني","text":["أَيُّما رجلٍ حالت شفاعتُه دونَ حَدٍّ من حدودِ اللهِ تعالى ، لم يَزَلْ في سَخَطِ اللهِ تعالى حتى يَنْزِعَ ، وأَيُّما رجلٍ شَدَّ غضبًا على مسلمٍ في خصومةٍ لا عِلْمَ له بها ، فقد عاند اللهَ حَقَّهُ ، وحَرَصَ ، على سَخَطِهِ ، وعليه لعنةُ اللهِ المتتابِعَةُ إلى يومِ القيامةِ ، ",["وأَيُّما رجلٍ أشاع على رجلٍ مسلمٍ بكَلِمَةٍ وهو منها بريءٌ يُشِينُه بها في الدنيا ؛ ",1],["كان حَقًّا على اللهِ أن يُدْنِيَه يومَ القيامةِ في النارِ ، حتى يَأْتِيَ بإنفاذِ ما قال",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه الطبراني كما في ((الجامع الصغير)) للسيوطي (1/260)","bab":"حدود › الحث على إقامة الحدود","dorar":"sPYe1Im7"},{"id":"س-04874","fp":"51dc2cabb5c9","stateId":591,"easy":"إذا ذكرت امرءاً بما ليس فيه لتعيبه ← يحبسك الله في نار جهنم حتى تأتي بنفاذ ما قلت","cause":"مَن ذكر امْرَءًا بما ليس فيه ليَعِيبَه","result":"حبسه اللهُ في نارِ جهنمَ ، حتى يأتيَ بنَفَاذِ ما قال","explicit":true,"ref":"الجامع الصغير 8657","srcLabel":"الطبراني","text":[["مَن ذكر امْرَءًا بما ليس فيه ليَعِيبَه ، ",1],["حبسه اللهُ في نارِ جهنمَ ، حتى يأتيَ بنَفَاذِ ما قال",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (8936) واللفظ له، وأبو الشيخ في ((التوبيخ والتنبيه)) (128)، وابن عدي في ((الكامل في الضعفاء)) (7/297)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"A57j8MkR"},{"id":"س-04908","fp":"46a042ff7a46","stateId":591,"easy":"إذا شهدت زوراً ← تجب لك النار","cause":"شاهِدِ الزُّورِ","result":"حتى تَجِبَ له النَّارُ","explicit":true,"repOf":"س-05147","ref":"الكبائر للذهبي 198","text":["لا تزولُ قَدَما ",["شاهِدِ الزُّورِ",1]," يَوْمَ القيامَةِ ",["حتى تَجِبَ له النَّارُ",2],"."],"grade":"صحيح","narrator":"[عبدالله بن عمر]","muhaddith":"ثابت","takhrij":"أخرجه ابن ماجة (2373)، والحاكم (7042)، والطبراني في ((الأوسط)) (8367) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"hQotduK7"},{"id":"س-04993","fp":"908665cae09c","stateId":591,"easy":"إذا حلفت عند المنبر النبوي على يمين آثمة ولو على سواك ← تبوأت مقعدك من النار","cause":"لا يحلِفُ أحدٌ عندَ منبري هذا على يمينٍ آثِمةٍ ، ولو على سِواكٍ أخضرَ","result":"إلَّا تبوَّأَ مقعدَه منَ النَّارِ","explicit":true,"repOf":"س-04295","ref":"الصحيح المسند 206","text":[["لا يحلِفُ أحدٌ عندَ منبري هذا على يمينٍ آثِمةٍ ، ولو على سِواكٍ أخضرَ",1]," ",["إلَّا تبوَّأَ مقعدَه منَ النَّارِ",2]," أو وجبَت لَه النَّارُ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"6vevjhhS"},{"id":"س-05077","fp":"953f0c269628","stateId":591,"easy":"إذا كذبت على النبي ﷺ متعمداً ← فتبوأ بيتاً في جهنم","cause":"مَن كذَب علَيَّ مُتعمِّدًا","result":"فلْيتبوَّأْ بيتًا مِن جهنَّمَ ) وسمِعْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم يقولُ : ( رجُلٌ مِن أمَّتي يقومُ مِن اللَّيلِ يُعالِجُ نفسَه إلى الطَّهورِ وعليكم عُقَدٌ فإذا وضَّأ يدَيْهِ انحلَّتْ","explicit":true,"repOf":"س-08317","ref":"تخريج صحيح ابن حبان 1052","text":["لا أقولُ اليومَ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّم ما لَمْ يقُلْ سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ : ( ",["مَن كذَب علَيَّ مُتعمِّدًا ",1],["فلْيتبوَّأْ بيتًا مِن جهنَّمَ ) وسمِعْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم يقولُ : ( رجُلٌ مِن أمَّتي يقومُ مِن اللَّيلِ يُعالِجُ نفسَه إلى الطَّهورِ وعليكم عُقَدٌ فإذا وضَّأ يدَيْهِ انحلَّتْ",2]," عُقدةٌ فإذا وضَّأ وجهَه انحلَّتْ عُقدةٌ وإذا مسَح رأسَه انحلَّتْ عُقدةٌ وإذا وضَّأ رجلَيْهِ انحلَّتْ عُقدةٌ فيقولُ اللهُ جلَّ وعلا للَّذي وراءَ الحجابِ : انظُروا إلى عبدي هذا يُعالِجُ نفسَه لِيسأَلَني ما سأَلني عبدِي هذا فهو له ما سأَلني عبدي هذا فهو له )"],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (17457، 17458) مفرقاً باختلاف يسير، وأبو يعلى (1751) بنحوه دون حديث: \"رجل من أمتي\"، والطبراني (17/305) (843) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ndghLtOP"},{"id":"س-05081","fp":"5ba6a0b0aef8","stateId":591,"easy":"إذا كذبت على النبي ﷺ ← يُبنى لك بيت في النار","cause":"إنَّ الَّذي يَكذِبُ عليَّ","result":"يُبنَى له بَيتٌ في النَّارِ","explicit":true,"repOf":"س-08317","ref":"تخريج المسند لشعيب 5798","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["إنَّ الَّذي يَكذِبُ عليَّ",1]," ",["يُبنَى له بَيتٌ في النَّارِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (5798)، وابن أبي شيبة (26769)، وعبد بن حميد (736)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"aUrpti9h"},{"id":"س-05126","fp":"6fd5932161d6","stateId":591,"easy":"إذا هجوت رجلاً فهجوت القبيلة بأسرها ← تكون من أشد الناس عذاباً يوم القيامة","cause":"يومَ القِيامةِ رجُلٌ هجَا رجُلًا، فهَجا القَبيلةَ بأَسْرِها","result":"أشدُّ النَّاسِ عذابًا","explicit":true,"ref":"تخريج مشكل الآثار 9","srcLabel":"ابن حبان","text":[["أشدُّ النَّاسِ عذابًا",2],[" يومَ القِيامةِ رجُلٌ هجَا رجُلًا، فهَجا القَبيلةَ بأَسْرِها",1],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (9) واللفظ له، وابن ماجة (3761)، وابن حبان (5785) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"xpBJIwII"},{"id":"س-05240","fp":"935d4340bd11","stateId":591,"easy":"إذا حدّثت عن النبي ﷺ ما لم يقل ← فتبوأ بيتاً في النار","cause":"مَن حَدَّث عني ما لم أقُلْ أو قَصَر عن شَيءٍ أمَرْتُ به","result":"فلْيَتبَوَّأْ بيتًا في النَّارِ","explicit":true,"repOf":"س-08317","ref":"الضعفاء الكبير 1/203","text":[["مَن حَدَّث عني ما لم أقُلْ أو قَصَر عن شَيءٍ أمَرْتُ به، ",1],["فلْيَتبَوَّأْ بيتًا في النَّارِ",2],"."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"ثابت من غير هذا الوجه","takhrij":"أخرجه الترمذي في ((العلل الكبير)) (631)، وأبو يعلى (73)، والطبراني في ((الأوسط)) (2838) جميعا بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"vGHrw2uo"},{"id":"س-05495","fp":"d52e4e2cf732","stateId":591,"easy":"إذا أكلت بالنيل من مسلم أكلة ← يطعمك الله بها أكلة من نار جهنم","cause":"مَن أكَلَ بمُسْلِمٍ أكلَةً","result":"أطعَمَهُ اللهُ بها أكْلَةً مِن نارِ جهَنَّمَ يومَ القيامةِ","explicit":true,"repOf":"س-05478","ref":"المستدرك على الصحيحين 7362","text":[["مَن أكَلَ بمُسْلِمٍ أكلَةً، ",1],["أطعَمَهُ اللهُ بها أكْلَةً مِن نارِ جهَنَّمَ يومَ القيامةِ، ",2],"ومَن أقامَ بمُسلِمٍ مُقامَ سُمْعةٍ، أقامَهُ اللهُ يومَ القِيامةِ مُقامَ سُمعةٍ ورِياءٍ، ومَنِ اكتسى بمُسلِمٍ ثَوبًا كَساهُ اللهُ ثوبًا مِن نارٍ يومَ القِيامةِ."],"grade":"صحيح","narrator":"المستورد بن شداد","muhaddith":"صحيح الإسناد","bab":"رقائق وزهد › الرياء والسمعة","dorar":"9Kg2tmyU"},{"id":"س-05497","fp":"12e9569af682","stateId":591,"easy":"إذا اكتسيت بالنيل من مسلم ثوباً ← يكسوك الله ثوباً من نار يوم القيامة","cause":"ومَنِ اكتسى بمُسلِمٍ ثَوبًا","result":"كَساهُ اللهُ ثوبًا مِن نارٍ يومَ القِيامةِ","explicit":true,"repOf":"س-05478","ref":"المستدرك على الصحيحين 7362","text":["مَن أكَلَ بمُسْلِمٍ أكلَةً، أطعَمَهُ اللهُ بها أكْلَةً مِن نارِ جهَنَّمَ يومَ القيامةِ، ومَن أقامَ بمُسلِمٍ مُقامَ سُمْعةٍ، أقامَهُ اللهُ يومَ القِيامةِ مُقامَ سُمعةٍ ورِياءٍ، ",["ومَنِ اكتسى بمُسلِمٍ ثَوبًا ",1],["كَساهُ اللهُ ثوبًا مِن نارٍ يومَ القِيامةِ",2],"."],"grade":"صحيح","narrator":"المستورد بن شداد","muhaddith":"صحيح الإسناد","bab":"رقائق وزهد › الرياء والسمعة","dorar":"9Kg2tmyU"},{"id":"س-05503","fp":"581b62bef2c1","stateId":591,"easy":"إذا اكتسيت برجل مسلم ثوباً ← يكسوك الله مثله من جهنم","cause":"ومَنِ اكْتسَى برَجلٍ مُسلمٍ ثوْبًا","result":"فإنَّ اللهَ يَكسُوهُ مِثلَهُ","explicit":true,"repOf":"س-05478","ref":"صحيح الجامع 6083","text":["مَنْ أكل برَجلٍ مُسلمٍ أكْلَةً ، فإنَّ اللهَ يُطعِمُهُ مِثلَها من جهنَّمَ ، ",["ومَنِ اكْتسَى برَجلٍ مُسلمٍ ثوْبًا ، ",1],["فإنَّ اللهَ يَكسُوهُ مِثلَهُ ",2],"من جهنَّمَ ، ومَنْ قامَ برَجلٍ مُسلمٍ مَقامَ سُمْعةٍ ورِياءٍ ، فإنَّ اللهَ يقومُ بهِ مَقامَ سُمعةٍ ورِياءٍ يومَ القيامةِ"],"grade":"صحيح","narrator":"المستورد بن شداد","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4881)، وأحمد (18011) باختلاف يسير.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"SeBidggI"},{"id":"س-08255","fp":"4547dbf17469","stateId":591,"easy":"إذا قلت لأحد «والله لا يغفر الله لك» ← أوبقت دنياك وآخرتك","cause":"واللهِ لا يغفِرُ اللهُ لك","result":"لَتكلَّم بكلمةٍ أوبقَتْ دنياه وآخِرتَه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[45,11,12],"ref":"صحيح ابن حبان 5712","srcLabel":"أبو داود","text":["[عن] ضمضم بن جوس، قال: دخَلْتُ مسجدَ الرَّسولِ صلَّى اللهُ عليه وسلَّم فإذا أنا بشيخٍ مُصفِّرٍ رأسَه برَّاقِ الثَّنايا معه رجُلٌ أدعَجُ جميلُ الوجهِ شابٌّ فقال الشَّيخُ: يا يَماميُّ تَعالَ لا تقولَنَّ لرجُلٍ أبدًا: لا يغفِرُ اللهُ لك واللهِ لا يُدخِلُك اللهُ الجنَّةَ أبدًا قُلْتُ: ومَن أنتَ يرحَمُك اللهُ ؟ قال: أنا أبو هُريرةَ قُلْتُ: إنَّ هذه لَكلمةٌ يقولُها أحدُنا لبعضِ أهلِه أو لخادمِه إذا غضِب عليها قال: فلا تَقُلْها إنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( كان رجُلانِ مِن بني إسرائيلَ متواخيَيْنِ أحدُهما مُجتهِدٌ في العبادةِ والآخَرُ مُذنِبٌ فأبصَر المُجتهدُ المُذنِبَ على ذنبٍ فقال له: أقصِرْ فقال له: خَلِّني وربِّي قال: وكان يُعيدُ ذلك عليه ويقولُ: خَلِّني وربِّي حتَّى وجَده يومًا على ذنبٍ فاستعظَمه فقال وَيْحَك أقصِرْ قال خَلِّني وربِّي أبُعِثْتَ عليَّ رقيبًا ؟ ! فقال: ",["واللهِ لا يغفِرُ اللهُ لك",1]," أبدًا أو قال: لا يُدخِلُك اللهُ الجنَّةَ أبدًا فبُعِث إليهما ملَكٌ فقبَض أرواحَهما فاجتمَعا عندَه جلَّ وعلا فقال ربُّنا للمُجتهِدِ: أكُنْتَ عالِمًا أم كُنْتَ قادرًا على ما في يدي أم تحظُرُ رحمتي على عبدي ؟ اذهَبْ إلى الجنَّةِ يُريدُ المُذنِبَ وقال للآخَرِ: اذهبَوا به إلى النَّارِ فوالَّذي نفسي بيدِه ",["لَتكلَّم بكلمةٍ أوبقَتْ دنياه وآخِرتَه",2]," )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (4901)، وأحمد (8292)، والبزار (9418) واللفظ لهم جميعا.","bab":"مناقب وفضائل › أبو هريرة","dorar":"7dykX84Y","merged":7,"otherRefs":["إتحاف الخيرة المهرة 2/210 (حسن)","تخريج شرح الطحاوية 299 (صحيح)","تخريج شرح السنة 4188 (حسن)","صحيح مسلم 2621 (صحيح)","تخريج الإحياء للعراقي 3/429 (حسن)","إتحاف الخيرة المهرة 6/475 (صحيح)"]},{"id":"س-04224","fp":"3ec94e211b7d","stateId":591,"easy":"إذا آذيتِ جيرانك بلسانك ولو صليتِ وصمتِ ← فأنتِ من أهل النار","cause":"وتُؤذي جيرانَها بلسانِها","result":"هي من أهلِ النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[39,55,36],"ref":"السلسلة الصحيحة 1/369","srcLabel":"أحمد","text":["قيل للنبيِّ صلَّى اللهُ عليهِ وسلَّمَ : يا رسولَ اللهِ إنَّ فلانةً تقومُ الليلَ وتصومُ النهارَ وتفعلُ وتصدَّقُ ",["وتُؤذي جيرانَها بلسانِها",1]," فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ : لا خيرَ فيها ",["هي من أهلِ النَّارِ",2]," قال : وفلانةٌ تُصلِّي المكتوبةَ وتصدّقُ بأثوارٍ من الأقِطِ ولا تُؤذي أحدًا فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ : هي من أهلِ الجنَّةِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (9675)، والبزار (9713)، وابن حبان (5764) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"dbvXsh4A","merged":5,"otherRefs":["صحيح الترغيب 2560 (صحيح)","صحيح الأدب المفرد 88 (صحيح)","تخريج صحيح ابن حبان 5764 (صحيح)"]},{"id":"س-02951","fp":"f3908d0476f0","stateId":591,"easy":"إذا شهدت شهادة يُستباح بها مال مسلم أو دمه ← فقد أوجبت النار","cause":"منْ شَهِدَ شهادةً يُستباحُ بها مَالُ امرئٍ مسلمٍ، أوْ يسفِكُ بها دمًا","result":"فقدْ أوجَبَ النارَ","explicit":true,"ref":"الجامع الصغير 8754","srcLabel":"الطبراني","text":[["منْ شَهِدَ شهادةً يُستباحُ بها مَالُ امرئٍ مسلمٍ،  أوْ يسفِكُ بها دمًا،  ",1],["فقدْ أوجَبَ النارَ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن","takhrij":"أخرجه الحارث في ((المسند)) (464)، وأبو يعلى (2751) مطولاً باختلاف يسير، والطبراني (11/216) (11541) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"IwmCW44Z","merged":2,"otherRefs":["النوافح العطرة 387 (حسن)"]},{"id":"س-04987","fp":"f5e31deef986","stateId":591,"easy":"إذا غللت ← تجيء يوم القيامة على ظهرك بعير","cause":"قد أَغْلَلْتَه","result":"لا أُلْفِيَنَّك يَوْمَ القِيامةِ تَجيءُ على ظَهْرِك بَعيرٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأحكام الوسطى 2/ 185","srcLabel":"أبو داود","text":["بَعَثَني رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ساعِيًا، ثُمَّ قالَ: \"انْطَلِقْ أبا مَسْعودٍ، ",["لا أُلْفِيَنَّك يَوْمَ القِيامةِ تَجيءُ على ظَهْرِك بَعيرٌ",2]," مِن إبِلِ الصَّدَقةِ له رُغاءٌ ",["قد أَغْلَلْتَه",1],"\"، قالَ: إذًا لا أَنطَلِقُ، قالَ: \"إذًا لا أُكرِهُك\"."],"grade":"صحيح","narrator":"أبو مسعود","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (2947) بلفظه، والطبراني (17/ 247)، (688) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"JimjWMoC","merged":2,"otherRefs":["مجمع الزوائد 3/89 (صحيح)"]},{"id":"س-00357","fp":"af60b89a1d8b","stateId":591,"easy":"إذا قلت كلمة لتضحك بها الناس (بباطل) ← تهوي بها في النار أبعد مما بين السماء والأرض","cause":"ليقولُ الكَلِمةَ لا يقولُها إلَّا ليُضحِكَ بها النَّاسَ","result":"يَهْوي بها أبعَدَ ممَّا بين السَّماءِ والأرضِ","explicit":true,"ref":"هداية الرواة 4/381","srcLabel":"البيهقي","text":["إنَّ العبدَ ",["ليقولُ الكَلِمةَ لا يقولُها إلَّا ليُضحِكَ بها النَّاسَ",1]," ",["يَهْوي بها أبعَدَ ممَّا بين السَّماءِ والأرضِ",2],"، وإنَّه وَعَدتْه لَيَزِلُّ عن لِسانِه أشَدُّ ممَّا يَزِلُّ عن قَدَمِه."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه ابن المبارك في ((المسند)) (18)، والخرائطي في ((مكارم الأخلاق)) (407)، والبيهقي في ((شعب الإيمان)) (4492) جميعهم بلفظه.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"j6cTn2mi"},{"id":"س-02801","fp":"978067d6b8fe","stateId":591,"easy":"إذا رميت مسلماً بشيء تريد شينه ← يحبسك الله على جسر جهنم حتى تخرج مما قلت","cause":"ومَن قَفَى مُسلمًا بشيءٍ يُريدُ شَينَه به","result":"حبَسَه اللهُ على جِسرِ جَهنَّمَ حتى يَخرُجَ ممَّا قال","explicit":true,"ref":"تخريج شرح السنة 3527","srcLabel":"أبو داود","text":["مَن حَمى مُؤمنًا من مُنافقٍ يَعيبُه، بعَثَ اللهُ مَلَكًا يَحمي لَحمَه يومَ القيامةِ مِن نارِ جَهنَّمَ، ",["ومَن قَفَى مُسلمًا بشيءٍ يُريدُ شَينَه به، ",1],["حبَسَه اللهُ على جِسرِ جَهنَّمَ حتى يَخرُجَ ممَّا قال",2],"."],"grade":"حسن","narrator":"معاذ بن أنس","muhaddith":"إسماعيل بن يحيى المعافري لم يوثقه غير ابن حبان، وباقي رجاله ثقات.","takhrij":"أخرجه الطبراني (433) (20/ 194) واللفظ له، وأبو داود (4883)، وأحمد (15649) باختلاف يسير.","bab":"إيمان › النفاق","dorar":"iku4DJoR"},{"id":"س-02954","fp":"7ef79da69056","stateId":591,"easy":"إذا كذبت ← فالكذب عمل النار","cause":"الكذبُ","result":"و عملُ النارِ","explicit":true,"repOf":"س-00196","ref":"الجامع الصغير 5599","text":["عملُ الجنةِ الصدقُ، و إذا صدقَ العبدُ برَّ، و إذا برَّ آمنَ، و إذا آمنَ دخلَ الجنةَ، ",["و عملُ النارِ",2]," ",["الكذبُ",1],"، و إذا كذبَ العبدُ فجرَ، و إذا فجرَ كفرَ، و إذا كفرَ دخلَ النارَ"],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن","takhrij":"أخرجه أحمد (6641) واللفظ له.","bab":"إيمان › الوعيد","dorar":"Bd26lIOj"},{"id":"س-03001","fp":"9135f266e0f9","stateId":591,"easy":"إذا أكلت لحم أخيك في الدنيا (اغتبته) ← يُقرّب إليك يوم القيامة فيقال: كله ميتاً","cause":"مَن أكَل لحمَ أخيه في الدنيا","result":"قُرِّب إليه يومَ القيامةِ فيُقالُ له كُلْه ميتًا كما أكَلتَه حيًّا فيأكُلُه فيَكلَحُ ويَصيحُ","explicit":true,"ref":"الكبائر لابن عبدالوهاب 42","srcLabel":"الطبراني","text":[["مَن أكَل لحمَ أخيه في الدنيا",1]," ",["قُرِّب إليه يومَ القيامةِ فيُقالُ له كُلْه ميتًا كما أكَلتَه حيًّا فيأكُلُه فيَكلَحُ ويَصيحُ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن أبي الدنيا في ((الصمت)) (178)، وأبو يعلى كما في ((إتحاف الخيرة المهرة)) للبوصيري (6/75)، والطبراني في ((المعجم الأوسط)) (1656) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"KoYbcT6o"},{"id":"س-03063","fp":"fcfd9c776a00","stateId":591,"easy":"إذا كتمت علماً عن أهله ← تُلجم بلجام من نار","cause":"من كتم علمًا عن أهلِه","result":"أُلْجِمَ بلجامٍ من نارٍ","explicit":true,"repOf":"س-07099","ref":"الكافي الشاف 62","text":[["من كتم علمًا عن أهلِه",1]," ",["أُلْجِمَ بلجامٍ من نارٍ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"رجاله ثقات لكن فيه رجل مبهم قيل أنه حجاج بن أرطأة","takhrij":"أخرجه أبو داود (3658)، والترمذي (2649)، وأحمد (10487) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"bPo8SbWx"},{"id":"س-04027","fp":"f44f570b1118","stateId":591,"easy":"إذا قلت لأحد «لا يغفر الله لك» ← قد يُغفر له وتوجب على نفسك النار","cause":"فغضب فقال : لا يغفرُ اللهُ لك","result":"وأنت فقد أوجبتُ لك النارَ","explicit":true,"otherNeedIds":[45],"ref":"تخريج الإحياء للعراقي 4/187","srcLabel":"أبو داود","text":["إنَّ رجليْنِ من بني إسرائيلَ تواخيَا في اللهِ فكان أحدُهما يُسرفُ على نفسِه وكان الآخرُ عابدًا وكان يَعِظُه ويزجرُه فكان يقول : دعني وربِّي أَبُعِثْتَ عليَّ رقيبًا حتى رآهُ ذاتَ يومٍ على كبيرةٍ ",["فغضب فقال : لا يغفرُ اللهُ لك",1]," قال : فيقول الله تعالَى يوم القيامةِ : أيستطيعُ أحدٌ أن يحظُرَ رحمتي على عبادي اذهب أنت فقد غفرتُ لك ثم يقول للعابدِ : ",["وأنت فقد أوجبتُ لك النارَ",2]," قال : فوالذي نفسي بيدِه لقد تكلَّمَ بكلمةٍ أهلكتْ دنياهُ وآخرتَه ."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده جيد","takhrij":"أخرجه أبو داود (4901)، وأحمد (8292)، وابن حبان (5712)،  جميعا بنحوه مطولا .","bab":"توبة › سعة رحمة الله تعالى وأنها سبقت غضبه","dorar":"zUxdKIsa"},{"id":"س-04828","fp":"6dfc2c9bb650","stateId":591,"easy":"إذا شهدت على مسلم شهادة لست لها أهلاً ← فتبوأ مقعدك من النار","cause":"من شَهِدَ علَى مسلِمٍ شَهادةً ليسَ لَها بأهْلٍ","result":"فليتبوَّأ مقعدَه من النَّارِ","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 2/193","srcLabel":"الزواجر عن اقتراف الكبائر","text":["عن ابنِ مسعودٍ قالَ : ",["من شَهِدَ علَى مسلِمٍ شَهادةً ليسَ لَها بأهْلٍ ",1],["فليتبوَّأ مقعدَه من النَّارِ",2]],"grade":"حسن","muhaddith":"إسناده حسن","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"7ZxthUFe"},{"id":"س-04875","fp":"e112ca6f2d54","stateId":591,"easy":"إذا زنّيت أمة لم ترها تزني ← يجلدك الله يوم القيامة بسوط من نار","cause":"من زنَّى أَمَةً لم يَرَها تزني","result":"جلَدَه الله يومَ القيامة بسَوطٍ مِن نارٍ","explicit":true,"ref":"الجامع الصغير 8705","srcLabel":"أحمد","text":[["من زنَّى أَمَةً لم يَرَها تزني، ",1],["جلَدَه الله يومَ القيامة بسَوطٍ مِن نارٍ",2],"."],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"حسن","takhrij":"أخرجه أحمد (21375)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"VJuzdJfk"},{"id":"س-04903","fp":"5ae87abb7c03","stateId":591,"easy":"إذا قذفت ذمياً ← يُقام عليك الحد يوم القيامة بسياط من نار","cause":"من قذَفَ ذمِّيًا","result":"حُدَّ لَه يومَ القيامةِ بِسياطٍ من نارٍ","explicit":true,"ref":"الجامع الصغير 8902","srcLabel":"ابن حبان","text":[["من قذَفَ ذمِّيًا، ",1],["حُدَّ لَه يومَ القيامةِ بِسياطٍ من نارٍ",2]],"grade":"حسن","narrator":"واثلة بن الأسقع الليثي أبو فسيلة","muhaddith":"حسن","takhrij":"أخرجه ابن حبان في ((المجروحين)) (2/ 289)، والطبراني (22/ 57) (135)، وابن عدي في ((الكامل في الضعفاء)) (7/ 367) بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"4PWRSRjE"},{"id":"س-04927","fp":"66e2a68f31da","stateId":591,"easy":"إذا حلفت عند المنبر النبوي يميناً كاذبة تستحق بها مالاً ← يدخلك الله النار","cause":"أيُّما امْرئٍ مِن النَّاسِ حَلَفَ عِندَ مِنبَري هذا على يَمينٍ كاذِبةٍ يَستَحِقُّ بها حقَّ مُسلِمٍ","result":"أدخَلَه اللهُ النَّارَ، وإنْ على سِواكٍ أخضَرَ","explicit":true,"repOf":"س-04295","ref":"تخريج المسند لشعيب 15024","text":[["أيُّما امْرئٍ مِن النَّاسِ حَلَفَ عِندَ مِنبَري هذا على يَمينٍ كاذِبةٍ يَستَحِقُّ بها حقَّ مُسلِمٍ ",1],["أدخَلَه اللهُ النَّارَ، وإنْ على سِواكٍ أخضَرَ",2],"."],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"قوي","takhrij":"أخرجه أبو داود (3246)، وابن ماجه (2325) باختلاف يسير، وأحمد (15024) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"OjT9vqbn"},{"id":"س-06860","fp":"a34583b8d7d8","stateId":591,"easy":"إذا تكلمت بالكلمة تضحك بها القوم (بباطل) ← تسقط بها أبعد من السماء","cause":"أنْ يَتَكَلَّمَ بِالكَلِمَةِ يُضْحِكُ بِها القومَ","result":"فَيَسْقُطُ بِها أَبْعَدَ مِنَ السَّماءِ","explicit":true,"repOf":"س-00375","ref":"صحيح الترغيب 2877","text":["أَلا هل عَسَى رجلٌ مِنكمْ ",["أنْ يَتَكَلَّمَ بِالكَلِمَةِ يُضْحِكُ بِها القومَ",1]," ؛ ",["فَيَسْقُطُ بِها أَبْعَدَ مِنَ السَّماءِ",2]," ، ألا عَسَى رجلٌ مِنكمْ أنْ يَتَكَلَّمَ بِالكَلِمَةِ يُضْحِكُ بِها أصحابَهُ ؛ فيسخط اللهُ بِها عليهِ ؛ لا يرضَى عنهُ حتى يدخلهُ النارَ ."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"لم نقف عليه إلا في ((الترغيب والترهيب)) للمنذري (3/ 344).","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"HIfAivTx"},{"id":"س-02978","fp":"b38e4b8fae00","stateId":591,"easy":"إذا عبدت الله ثم لقيته وأنت مبغض لأهل بيت النبي ﷺ ← تدخل النار (على رواية)","cause":"فلو أنَّ رَجلًا صفَنَ بيْنَ الرُّكنِ والمَقامِ فصَلَّى، وصامَ، ثمَّ لَقيَ اللهَ وهو مُبغِضٌ لأهْلِ بَيتِ محمَّدٍ صلَّى اللهُ عليه وسلَّمَ","result":"دخَلَ النَّارَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"المستدرك على الصحيحين 4771","srcLabel":"مسلم","text":["يا بَني عَبدِ المطَّلِبِ، إنِّي سألْتُ اللهَ لكم ثَلاثًا: أنْ يُثبِّتَ قائمَكم، وأنْ يَهْديَ ضالَّكم، وأنْ يُعلِّمَ جاهِلَكم، وسألْتُ اللهَ أنْ يَجعَلَكم جُوَداءَ نُجَداءَ رُحَماءَ، ",["فلو أنَّ رَجلًا صفَنَ بيْنَ الرُّكنِ والمَقامِ فصَلَّى، وصامَ، ثمَّ لَقيَ اللهَ وهو مُبغِضٌ لأهْلِ بَيتِ محمَّدٍ صلَّى اللهُ عليه وسلَّمَ",1]," ",["دخَلَ النَّارَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه الطبراني (11412) (11/  176)، وابن أبي عاصم  (1546)،  وابن بشران (465)\n واللفظ لهم","bab":"إيمان › الوعيد","dorar":"wZjrPy5d"},{"id":"س-01880","fp":"9b2fe1d96e23","stateId":591,"easy":"إذا أطلقت لسانك ← تُكب في النار على منخريك بحصائده","cause":"حصائدُ ألسنَتِهمْ","result":"هل يَكُبُّ النَّاسَ على مَناخِرِهم في جهنَّمَ إلَّا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"مختصر المقاصد 596","srcLabel":"الترمذي","text":["الصَّومُ جُنَّةٌ [يعني حديث: بيْنَما نحن مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في غزوةِ تَبوكَ وقد أَصابَنا الحَرُّ، فتفَرَّقَ القومُ حتَّى نَظرتُ، فإذا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ أقرَبَهُم مِنِّي. قالَ: فدَنوتُ منه فقلتُ: يا رسولَ اللهِ، أَنبِئْني بعملٍ يُدخِلُني الجنَّةَ ويُباعِدُني مِنَ النَّارِ. قالَ: «لقد سألتَ عنْ عظيمٍ، وإنَّه ليَسيرٌ على مَنْ يَسَّرَهُ اللهُ عليه؛ تَعبدُ اللهَ ولا تُشركُ به شيئًا، وتُقيمُ الصَّلاةَ المكتوبةَ، وتُؤتي الزَّكاةَ المفروضةَ، وتَصومُ رمضانَ». قالَ: «وإنْ شئتَ أنبأتُكَ بأبوابِ الجنَّةِ». قلتُ: أجَلْ يا رسولَ اللهِ. قالَ: «الصَّومُ جُنَّةٌ، والصَّدقةُ تُكفِّرُ الخطيئةَ، وقيامُ الرَّجلِ في جوفِ اللَّيلِ يَبتغي وجهَ اللهِ». قالَ: ثُمَّ قَرَأَ هذه الآيةَ: {تَتَجَافَى جُنُوبُهُمْ عَنِ الْمَضَاجِعِ يَدْعُونَ رَبَّهُمْ خَوْفًا وَطَمَعًا وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ} [السجدة: 16] قالَ: «وإنْ شئتَ أنبأتُكَ برأسِ الأمرِ وعمودِهِ وذُروةِ سَنامِهِ» . قالَ: قلتُ: أجَلْ يا رسولَ اللهِ. قالَ: «أمَّا رأسُ الأمرِ فالإسلامُ، وأمَّا عمودُهُ فالصَّلاةُ، وأمَّا ذُروةُ سَنامِهِ فالجهادُ في سبيلِ اللهِ، وإنْ شئتَ أنبأتُكَ بأمْلَكِ ذلك كُلِّهِ». قالَ: فسَكَتَ، فإذا راكبانِ يُوضِعانِ قِبَلَنا، فخَشيتُ أنْ يَشغلاهُ عنْ حاجتي. قالَ: فقلتُ: ما هو يا رسولَ اللهِ؟ قالَ: فأَهْوَى بإصبَعِهِ إلى فيهِ. قالَ: فقلتُ: يا رسولَ اللهِ، وإنَّا لنُؤاخذُ بما نقولُ بألسِنَتِنا؟ قالَ: «ثَكِلتكَ أمُّكَ ابنَ جَبلٍ، ",["هل يَكُبُّ النَّاسَ على مَناخِرِهم في جهنَّمَ إلَّا",2]," ",["حصائدُ ألسنَتِهمْ",1],"؟».]"],"grade":"صحيح","narrator":"[معاذ بن جبل]","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (5/ 12)، والنسائي (2224 )، وابن ماجة (3973 )","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"snTBq0Xu","merged":6,"otherRefs":["البحر الزخار 6/273 (حسن)","مجمع الزوائد 10/303 (حسن)","الترغيب والترهيب 4/23 (صحيح)","الأحكام الشرعية الكبرى 3/156 (صحيح)","صحيح الترمذي 2616 (صحيح)"]},{"id":"س-04794","fp":"ee080a54f881","stateId":591,"easy":"إذا حلفت كاذباً في البيع ← فقد أوجبت على نفسك (الإثم)","cause":"يَتَبايَعَانِ شَاةً يَتَحالَفَانِ","result":"قد أوْجَبَ أحدَهُما","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[12],"ref":"تعجيل المنفعة 1/774","srcLabel":"ابن أبي خيثمة","text":["أنَّ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ مَرَّ بِرَجُلَيْنِ ",["يَتَبايَعَانِ شَاةً يَتَحالَفَانِ",1]," ، ثُمَّ مَرَّ بِالشَّاةِ وقد اشْتَرَاها الرجلُ ، فقال : ",["قد أوْجَبَ أحدَهُما",2]],"grade":"حسن","narrator":"ناسج الحضرمي","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن أبي خيثمة في ((التاريخ الكبير))، والخرائطي في ((مساوئ الأخلاق)) (112)، وابن سمعون في ((الأمالي)) (147)، والمخلص في ((المخلصيات)) (2359) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"vTQFp0xg"},{"id":"س-00206","fp":"7191d1c7f360","stateId":591,"easy":"إذا حدّثت بالكذب لتضحك القوم ← فويل لك ثم ويل لك","cause":"لَّذي يُحدِّثُ بالحديثِ ليُضحِكَ به القومَ فيكذِبُ ، ويلٌ له ، ويلٌ له","result":"ويلٌ ل","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"الترغيب والترهيب 4/56","srcLabel":"أبو داود","text":[["ويلٌ ل",2],["لَّذي يُحدِّثُ بالحديثِ ليُضحِكَ به القومَ فيكذِبُ ، ويلٌ له ، ويلٌ له",1]],"grade":"صحيح","narrator":"معاوية بن حيدة القشيري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (4990)، والترمذي (2315) واللفظ له، والنسائي في ((السنن الكبرى)) (11126)، وأحمد (20046).","bab":"آداب الكلام › المزاح والمداعبة","dorar":"bwhB14LN","merged":3,"otherRefs":["الجامع الصغير 9629 (صحيح)","تخريج المسند لشعيب 20021 (حسن)"]},{"id":"س-07453","fp":"d6fa37a131cd","stateId":591,"easy":"إذا أكلت لحوم الناس ووقعت في أعراضهم ← تخمش وجهك وصدرك بأظفار من نحاس","cause":"الذينَ يأكلونَ لُحُومَ الناسِ ، ويَقَعُونَ في أَعْرَاضِهِمْ","result":"بِقومٍ لهُمْ أَظْفَارٌ من نُحاسٍ ، يَخْمُشُونَ وُجُوهَهُمْ وصُدُورَهُمْ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح الترغيب 2839","srcLabel":"أبو داود","text":["َلمَّا عُرِجَ بي مَرَرْتُ ",["بِقومٍ لهُمْ أَظْفَارٌ من نُحاسٍ ، يَخْمُشُونَ وُجُوهَهُمْ وصُدُورَهُمْ",2]," ، فقُلْتُ : مَنْ هؤلاءِ يا جبريلُ ؟ قال : هؤلاءِ ",["الذينَ يأكلونَ لُحُومَ الناسِ ، ويَقَعُونَ في أَعْرَاضِهِمْ",1]," ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4878) واللفظ له، وأحمد (13340).","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"myy669P0","merged":3,"otherRefs":["الأحكام الوسطى 4/ 263 (صحيح)","مجموع فتاوى ابن باز 381/8 (صحيح)"]},{"id":"س-01334","fp":"b95f4095c955","stateId":591,"easy":"إذا أكثرتن اللعن وكفرتن العشير ← تكنّ أكثر أهل النار","cause":"بكثرةِ لَعْنِكُنَّ وكُفرِكُنَّ العَشيرَ","result":"فإني رأيتُكُنَّ أكْثرَ أهلِ النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-06327","ref":"تخريج مشكل الآثار 2728","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ خطَبَ فوعَظَ، ثمَّ قال: يا مَعشرَ النِّساءِ، تَصدَّقْنَ ",["فإني رأيتُكُنَّ أكْثرَ أهلِ النَّارِ",2],"، فقالت له امرأةٌ: ولِمَ ذاك يا رسولَ اللهِ؟ قال: ",["بكثرةِ لَعْنِكُنَّ وكُفرِكُنَّ العَشيرَ",1],"، وما رأيْتُ من ناقصاتِ عقلٍ ودِينٍ أغلبَ لِألبابِ ذَوِي الرأْيِ منكُنَّ، فقالتِ امرأةٌ: يا رسولَ اللهِ، وما نُقصانُ عُقولِنا ودِينِنا؟ قال: شَهادةُ امرأتَيْنِ منكُنَّ بشَهادةِ رجُلٍ، ونُقصانُ دِينِكُنَّ الحَيْضةُ: تمكُثُ إحداكُنَّ الثلاثَ والأربعَ لا تُصلِّي."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (2728) واللفظ له، والترمذي (2613)، والنسائي في الكبرى (9226)، وابن أبي عاصم في ((السنة)) (956) باختلاف يسير","bab":"نكاح › عشرة النساء","dorar":"svZdHtPH"},{"id":"س-04565","fp":"ba2ea037a15e","stateId":591,"easy":"إذا أكلت لحوم الناس (اغتبتهم) ← يسيل فوك قيحاً ودماً في النار","cause":"كان يأكلُ لحمَ الناسِ","result":"ورجلٌ يسيلُ فوه قيحًا ودمًا","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"مجمع الزوائد 1/213","srcLabel":"الطبراني","text":["أربعةٌ يُؤذونَ أهلَ النارِ على ما بهم من الأذَى يسعونَ بينَ الحميمِ والجحيمِ يدعونَ بالويلِ والثبورِ يقولُ أهلُ النارِ بعضُهم لبعضٍ ما بالُ هؤلاءِ قد آذونا على ما بنا من الأذَى قال فرجلٌ مغلقٌ عليه تابوتٌ من جمرٍ ورجلٌ يجرُّ أمعاءَه ",["ورجلٌ يسيلُ فوه قيحًا ودمًا",2]," ورجلٌ يأكلُ لحمَه قال فيُقالُ لصاحبِ التابوتِ ما بالُ الأبعدِ قد آذانا على ما بنا من الأذَى قال فيقولُ إن الأبعدَ مات وفي عنقِه أموالُ الناسِ ما يجدُ لها قضاءً أو وفاءً ثم قال للذي يجرُّ أمعاءَه ما بالُ الأبعدِ قد آذانا على ما بنا من الأذَى فقال إن الأبعدَ كان لا يُبالِي أينَ أصاب البولُ منه لا يغسلُه ثم قال للذي يسيلُ فوه قيحًا ودمًا ما بالُ الأبعدِ قد آذانا على ما بنا من الأذَى فيقولُ إن الأبعدَ ",["كان يأكلُ لحمَ الناسِ",1]],"grade":"حسن","narrator":"شفي بن ماتع الأصبحي","muhaddith":"رجاله موثقون","takhrij":"أخرجه ابن المبارك في ((الزهد)) (2/94)، وابن أبي الدنيا في ((صفة النار)) (229)، والطبراني (7/311) (7226) باختلاف يسير.","bab":"جهنم › صفة عذاب أهل النار","dorar":"SXiXxY4A"},{"id":"س-03070","fp":"eb37af490b84","stateId":592,"easy":"إذا سرّك أن يقوم لك الناس قياماً ← فتبوأ بيتاً من النار","cause":"مَن سَرَّهُ أن يَمْثُلَ لهُ عِبادُ اللهِ قيامًا","result":"فليتبَوَّأْ بيتًا مِنَ النَّارِ","explicit":true,"star":true,"ref":"صحيح الأدب المفرد 748","srcLabel":"البخاري","text":["[عن] أبي مجلز يَقُولُ: ‌إِنَّ ‌مُعَاوِيَةَ ‌خَرَجَ، وَعَبْدُ اللَّهِ بْنُ عَامِرٍ وَعَبْدُ اللَّهِ بْنُ الزُّبَيْرِ قُعُودٌ، فَقَامَ ابْنُ عَامِرٍ، وَقَعَدَ ابْنُ الزُّبَيْرِ، وَكَانَ أَرْزَنَهُمَا، قَالَ مُعَاوِيَةُ: قَالَ النبي صلى الله عليه وسلم: ",["مَن سَرَّهُ أن يَمْثُلَ لهُ عِبادُ اللهِ قيامًا ",1],["فليتبَوَّأْ بيتًا مِنَ النَّارِ",2]],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5229)، والترمذي (2755)، وأحمد (16918) بنحوه، والبخاري في ((الأدب المفرد)) (977) واللفظ له","bab":"إيمان › الوعيد","dorar":"xkDLiGsS","merged":7,"otherRefs":["صحيح الترمذي 2755 (صحيح)","الأحكام الوسطى 4/ 225 (صحيح)","تخريج المسند لشعيب 16918 (صحيح)","تخريج المسند لشعيب 16830 (صحيح)","تخريج مشكل الآثار 1127 (صحيح)","تخريج المسند لشعيب 16845 (صحيح)"]},{"id":"س-04569","fp":"0b6f41573470","stateId":592,"easy":"إذا أمرت بالمعروف ولم تأته ونهيت عن المنكر وأتيته ← تُلقى في النار فتندلق أقتابك","cause":"كُنتُ آمُرُ بالمَعروفِ ولا آتيه، وأنهى عَنِ المُنكَرِ وآتيه","result":"فيُلقى في النَّارِ، فتَندَلِقُ أقتابُ بَطنِه، فيَدورُ بها كما يَدورُ الحِمارُ بالرَّحى","explicit":true,"star":true,"ref":"صحيح مسلم 2989","srcLabel":"متفق عليه","text":["قيلَ له: ألا تَدخُلُ على عُثمانَ فتُكَلِّمَه؟ فقال: أترَونَ أنِّي لا أُكَلِّمُه إلَّا أُسمِعُكُم؟ واللَّهِ لقد كَلَّمتُه فيما بَيني وبينَه، ما دونَ أن أفتَتِحَ أمرًا لا أُحِبُّ أن أكونَ أوَّلَ مَن فتَحَه، ولا أقولُ لأحَدٍ يَكونُ عليَّ أميرًا: إنَّه خَيرُ النَّاسِ بَعدَ ما سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: يُؤتى بالرَّجُلِ يَومَ القيامةِ، ",["فيُلقى في النَّارِ، فتَندَلِقُ أقتابُ بَطنِه، فيَدورُ بها كما يَدورُ الحِمارُ بالرَّحى",2],"، فيَجتَمِعُ إليه أهلُ النَّارِ، فيَقولونَ: يا فُلانُ ما لَكَ؟ ألَم تَكُنْ تَأمُرُ بالمَعروفِ، وتَنهى عَنِ المُنكَرِ؟ فيَقولُ: بَلى، قد ",["كُنتُ آمُرُ بالمَعروفِ ولا آتيه، وأنهى عَنِ المُنكَرِ وآتيه",1],". وفي روايةٍ: كُنَّا عِندَ أُسامةَ بنِ زَيدٍ، فقال رَجُلٌ: ما يَمنَعُكَ أن تَدخُلَ على عُثمانَ فتُكَلِّمَه فيما يَصنَعُ؟ وساقَ الحَديثَ، بمِثلِه."],"grade":"صحيح","narrator":"أسامة بن زيد","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3267)، ومسلم (2989).","bab":"جهنم › صفة عذاب أهل النار","dorar":"kLnPj7dF","merged":7,"otherRefs":["صحيح الترغيب 124 (صحيح)","المستدرك على الصحيحين 7205 (صحيح)","صحيح البخاري 7098 (صحيح)","صحيح البخاري 3267 (صحيح)","صحيح الجامع 8022 (صحيح)","الفتح الرباني 6/3089 (صحيح)"]},{"id":"س-07887","fp":"6d2047b77004","stateId":592,"easy":"إذا سجدت رياءً واتقاءً ← يجعل الله ظهرك طبقة واحدة يوم القيامة فلا تستطيع السجود","cause":"مَن كانَ يَسجُدُ اتِّقاءً ورياءً","result":"إلَّا جَعَلَ اللهُ ظَهرَه طَبَقةً واحِدةً، كُلَّما أرادَ أن يَسجُدَ خَرَّ على قَفاه","explicit":true,"star":true,"otherNeedIds":[45],"ref":"صحيح مسلم 183","srcLabel":"البخاري","text":["أنَّ ناسًا في زَمَنِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم قالوا: يا رَسولَ اللهِ، هل نَرى رَبَّنا يَومَ القيامةِ؟ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: نَعَم، قال: هل تُضارُّونَ في رُؤيةِ الشَّمسِ بالظَّهيرةِ صَحوًا ليس معها سَحابٌ؟ وهل تُضارُّونَ في رُؤيةِ القَمَرِ لَيلةَ البَدرِ صَحوًا ليس فيها سَحابٌ؟ قالوا: لا يا رَسولَ اللهِ، قال: ما تُضارُّونَ في رُؤيةِ اللهِ تَبارَك وتَعالى يَومَ القيامةِ إلَّا كما تُضارُّونَ في رُؤيةِ أحَدِهما، إذا كانَ يَومُ القيامةِ أذَّنَ مُؤَذِّنٌ: ليَتَّبِعْ كُلُّ أُمَّةٍ ما كانَت تَعبُدُ، فلا يَبقى أحَدٌ كانَ يَعبُدُ غيرَ اللهِ سُبحانَه مِنَ الأصنامِ والأنصابِ إلَّا يَتَساقَطونَ في النَّارِ، حتَّى إذا لَم يَبقَ إلَّا مَن كانَ يَعبُدُ اللهَ مِن بَرٍّ وفاجِرٍ وغُبَّرِ أهلِ الكِتابِ، فيُدعى اليَهودُ، فيُقالُ لهم: ما كُنتُم تَعبُدونَ؟ قالوا: كُنَّا نَعبُدُ عُزَيرَ ابنَ اللهِ، فيُقالُ: كَذَبتُم، ما اتَّخَذَ اللهُ مِن صاحِبةٍ ولا ولَدٍ، فماذا تَبغونَ؟ قالوا: عَطِشنا يا رَبَّنا، فاسقِنا، فيُشارُ إليهم، ألا تَرِدونَ؟ فيُحشَرونَ إلى النَّارِ كَأنَّها سَرابٌ يَحطِمُ بَعضُها بَعضًا، فيَتَساقَطونَ في النَّارِ، ثُمَّ يُدعى النَّصارى، فيُقالُ لهم: ما كُنتُم تَعبُدونَ؟ قالوا: كُنَّا نَعبُدُ المَسيحَ ابنَ اللهِ، فيُقالُ لهم، كَذَبتُم، ما اتَّخَذَ اللهُ مِن صاحِبةٍ ولا ولَدٍ، فيُقالُ لهم: ماذا تَبغونَ؟ فيَقولونَ: عَطِشنا يا رَبَّنا، فاسقِنا، قال: فيُشارُ إليهم، ألا تَرِدونَ؟ فيُحشَرونَ إلى جَهَنَّمَ كَأنَّها سَرابٌ يَحطِمُ بَعضُها بَعضًا، فيَتَساقَطونَ في النَّارِ، حتَّى إذا لَم يَبقَ إلَّا مَن كانَ يَعبُدُ اللهَ تَعالى مِن بَرٍّ وفاجِرٍ، أتاهم رَبُّ العالَمينَ سُبحانَه وتَعالى في أدنى صورةٍ مِنَ التي رَأوْه فيها، قال: فما تَنتَظِرونَ؟ تَتبَعُ كُلُّ أُمَّةٍ ما كانَت تَعبُدُ، قالوا: يا رَبَّنا، فارَقنا النَّاسَ في الدُّنيا أفقَرَ ما كُنَّا إليهم، ولَم نُصاحِبْهُم، فيَقولُ: أنا رَبُّكُم، فيَقولونَ: نَعوذُ باللهِ مِنك لا نُشرِكُ باللهِ شيئًا، مَرَّتَينِ أو ثَلاثًا، حتَّى إنَّ بَعضَهم لَيَكادُ أن يَنقَلِبَ، فيَقولُ: هل بينَكُم وبينَه آيةٌ فتَعرِفونَه بها؟ فيَقولونَ: نَعَم، فيُكشَفُ عن ساقٍ، فلا يَبقى مَن كانَ يَسجُدُ للَّهِ مِن تِلقاءِ نَفسِه إلَّا أذِنَ اللهُ له بالسُّجودِ، ولا يَبقى ",["مَن كانَ يَسجُدُ اتِّقاءً ورياءً",1]," ",["إلَّا جَعَلَ اللهُ ظَهرَه طَبَقةً واحِدةً، كُلَّما أرادَ أن يَسجُدَ خَرَّ على قَفاه",2],"، ثُمَّ يَرفَعونَ رُؤوسَهم وقد تَحَوَّلَ في صورَتِه التي رَأوْه فيها أوَّلَ مَرَّةٍ، فقال: أنا رَبُّكُم، فيَقولونَ: أنتَ رَبُّنا، ثُمَّ يُضرَبُ الجِسرُ على جَهَنَّمَ، وتَحِلُّ الشَّفاعةُ، ويقولونَ: اللهمَّ سَلِّمْ سَلِّمْ، قيلَ: يا رَسولَ اللهِ، وما الجِسرُ؟ قال: دَحضٌ مَزِلَّةٌ، فيه خَطاطيفُ وكَلاليبُ، وحَسَكٌ تَكونُ بنَجدٍ فيها شويكةٌ يُقالُ لها السَّعدانُ، فيَمُرُّ المُؤمِنونَ كَطَرفِ العَينِ، وكالبَرقِ، وكالرِّيحِ، وكالطَّيرِ، وكَأجاويدِ الخَيلِ والرِّكابِ؛ فناجٍ مُسَلَّمٌ، ومَخدوشٌ مُرسَلٌ، ومَكدوسٌ في نارِ جَهَنَّمَ، حتَّى إذا خَلَصَ المُؤمِنونَ مِنَ النَّارِ، فوالذي نَفسي بيَدِه، ما مِنكُم مِن أحَدٍ بأشَدَّ مُناشَدةً للَّهِ في استِقصاءِ الحَقِّ مِنَ المُؤمِنينَ للَّهِ يَومَ القيامةِ لإخوانِهمُ الذينَ في النَّارِ، يقولونَ: رَبَّنا كانوا يَصومونَ معنا ويُصَلُّونَ ويَحُجُّونَ، فيُقالُ لهم: أخرِجوا مَن عَرَفتُم، فتُحَرَّمُ صورُهم على النَّارِ، فيُخرِجونَ خَلقًا كَثيرًا قدِ أخَذَتِ النَّارُ إلى نِصفِ ساقَيه، وإلى رُكبَتَيه، ثُمَّ يقولونَ: رَبَّنا ما بَقيَ فيها أحَدٌ مِمَّن أمَرتَنا به، فيَقولُ: ارجِعوا فمَن وجَدتُم في قَلبِه مِثقالَ دينارٍ مِن خَيرٍ فأخرِجوه، فيُخرِجونَ خَلقًا كَثيرًا، ثُمَّ يقولونَ: رَبَّنا لَم نَذَرْ فيها أحَدًا مِمَّن أمَرتَنا، ثُمَّ يقولُ: ارجِعوا فمَن وجَدتُم في قَلبِه مِثقالَ نِصفِ دينارٍ مِن خَيرٍ فأخرِجوه، فيُخرِجونَ خَلقًا كَثيرًا، ثُمَّ يقولونَ: رَبَّنا لَم نَذَرْ فيها مِمَّن أمَرتَنا أحَدًا، ثُمَّ يقولُ: ارجِعوا فمَن وجَدتُم في قَلبِه مِثقالَ ذَرَّةٍ مِن خَيرٍ فأخرِجوه، فيُخرِجونَ خَلقًا كَثيرًا، ثُمَّ يقولونَ: رَبَّنا لَم نَذَرْ فيها خَيرًا. وكانَ أبو سَعيدٍ الخُدريُّ يقولُ: إن لَم تُصَدِّقوني بهذا الحَديثِ فاقرَؤوا إن شِئتُم: {إنَّ اللهَ لا يَظلِمُ مِثقالَ ذَرَّةٍ وإن تَكُ حَسَنةً يُضاعِفها ويُؤتِ مِن لَدُنْه أجرًا عَظيمًا} [النساء: 40]، فيَقولُ اللهُ عزَّ وجلَّ: شَفَعَتِ المَلائِكةُ، وشَفَعَ النَّبيُّونَ، وشَفَعَ المُؤمِنونَ، ولَم يَبقَ إلَّا أرحَمُ الرَّاحِمينَ، فيَقبِضُ قَبضةً مِنَ النَّارِ، فيُخرِجُ مِنها قَومًا لَم يَعمَلوا خَيرًا قَطُّ قد عادوا حُمَمًا، فيُلقيهم في نَهَرٍ في أفواهِ الجَنَّةِ، يُقالُ له: نَهَرُ الحَياةِ، فيَخرُجونَ كما تَخرُجُ الحِبَّةُ في حَميلِ السَّيلِ، ألا تَرَونَها تَكونُ إلى الحَجَرِ أو إلى الشَّجَرِ، ما يَكونُ إلى الشَّمسِ أُصَيفِرُ وأُخَيضِرُ، وما يَكونُ مِنها إلى الظِّلِّ يَكونُ أبيَضَ؟ فقالوا: يا رَسولَ اللهِ، كَأنَّك كُنتَ تَرعى بالباديةِ! قال: فيَخرُجونَ كاللُّؤلُؤِ في رِقابِهمُ الخَواتِمُ، يَعرِفُهم أهلُ الجَنَّةِ: هؤلاء عُتَقاءُ اللهِ الذينَ أدخَلَهمُ اللهُ الجَنَّةَ بغيرِ عَمَلٍ عَمِلوه، ولا خَيرٍ قدَّموه، ثُمَّ يقولُ: ادخُلوا الجَنَّةَ فما رَأيتُموه فهو لكم، فيَقولونَ: رَبَّنا، أعطَيتَنا ما لَم تُعطِ أحَدًا مِنَ العالَمينَ، فيَقولُ: لكم عِندي أفضَلُ مِن هذا، فيَقولونَ: يا رَبَّنا، أيُّ شيءٍ أفضَلُ مِن هذا؟ فيَقولُ: رِضايَ، فلا أسخَطُ علَيكُم بَعدَه أبَدًا. قال مُسلِمٌ: قَرَأتُ على عيسى بنِ حَمَّادٍ زُغبةَ المِصريِّ هذا الحَديثَ في الشَّفاعةِ، وقُلتُ له: أُحَدِّثُ بهذا الحَديثِ عَنك أنَّك سَمِعتَ مِنَ اللَّيثِ بنِ سَعدٍ، فقال: نَعَم، قُلتُ لعيسى بنِ حَمَّادٍ: أخبَرَكُمُ اللَّيثُ بنُ سَعدٍ، عن خالِدِ بنِ يَزيدَ، عن سَعيدِ بنِ أبي هِلالٍ، عن زَيدِ بنِ أسلَمَ، عن عَطاءِ بنِ يَسارٍ، عن أبي سَعيدٍ الخُدريِّ، أنَّه قال: قُلنا: يا رَسولَ اللهِ، أنَرى رَبَّنا؟ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: هل تُضارُّونَ في رُؤيةِ الشَّمسِ إذا كانَ يَومٌ صَحوٌ؟ قُلنا: لا، وسُقتُ الحَديثَ حتَّى انقَضى آخِرُه، وهو نَحوُ حَديثِ حَفصِ بنِ مَيسَرةَ، وزادَ بَعدَ قَولِه: بغيرِ عَمَلٍ عَمِلوه، ولا قدَمٍ قدَّموه، فيُقالُ لهم: لكم ما رَأيتُم ومِثلُه معهُ. قال أبو سَعيدٍ: بَلَغَني أنَّ الجِسرَ أدَقُّ مِنَ الشَّعرةِ، وأحَدُّ مِنَ السَّيفِ. وليسَ في حَديثِ اللَّيثِ، فيَقولونَ: رَبَّنا أعطَيتَنا ما لَم تُعطِ أحَدًا مِنَ العالَمينَ وما بَعدَه، فأقَرَّ به عيسى بنُ حَمَّادٍ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7439) باختلاف يسير","bab":"قيامة › الشفاعة","dorar":"KOAVhCFo","merged":5,"otherRefs":["المستدرك على الصحيحين 8962 (صحيح)","صحيح البخاري 4919 (صحيح)","تخريج كتاب السنة 634 (صحيح)","تخريج صحيح ابن حبان 7377 (صحيح)"]},{"id":"س-03130","fp":"787a909e353d","stateId":592,"easy":"إذا نازعت الله رداءه (الكبرياء) ← يقصمك","cause":"فَمَنْ نازعَني رِدائي","result":"قَصَمْتُهُ","explicit":true,"star":true,"otherNeedIds":[39],"ref":"المستدرك على الصحيحين 204","srcLabel":"مسلم","text":["عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فيما يَحْكي عنْ رَبِّه عزَّ وجلَّ، قالَ: «الكِبْرياءُ رِدائي، ",["فَمَنْ نازعَني رِدائي",1]," ",["قَصَمْتُهُ",2],"»."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أبو داود (4090)، وابن ماجة (4174)، وأحمد (7382) بنحوه.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"cCOPJdjd","merged":8,"otherRefs":["صحيح الترغيب 2898 (صحيح)","صحيح الجامع 4310 (صحيح)","صحيح مسلم 2620 (صحيح)","صحيح الأدب المفرد 429 (صحيح)","صحيح الجامع 4309 (صحيح)","الأحاديث المختارة 10 / 273 (صحيح)","مدح التواضع وذم الكبر 9 (حسن)"]},{"id":"س-00953","fp":"71911ba78b22","stateId":592,"easy":"إذا نازعت الله في الكبرياء أو العظمة ← يقذفك في النار","cause":"فمَن نازَعني في واحدةٍ منهما","result":"قذَفْتُه في النَّارِ","explicit":true,"star":true,"similar":["س-03113"],"ref":"تخريج صحيح ابن حبان 328","srcLabel":"متفق عليه","text":["الكبرياءُ ردائي والعظمةُ إزاري ",["فمَن نازَعني في واحدةٍ منهما",1]," ",["قذَفْتُه في النَّارِ",2]," ومَن اقتَرَب إليَّ شبرًا اقترَبْتُ منه ذراعًا ومَن اقتَرَب منِّي ذراعًا اقترَبْتُ منه باعًا ومَن جاءني يمشي جِئْتُه أُهَروِلُ ومَن جاءني يُهروِلُ جِئْتُه أسعى ومَن ذكَرني في نفسِه ذكَرْتُه في نفسي ومَن ذكَرني في ملأٍ ذكَرْتُه في ملأٍ أكثَرَ منهم وأطيَبَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حديث صحيح إسناده قوي","takhrij":"أخرجه البخاري (7405) مختصراً بلفظ مقارب، ومسلم (2620، 2675) مفرقاً بنحوه من حديث أبي هريرة وأبي سعيد الخدري رضي الله عنهما","bab":"أدعية وأذكار › فضل الذكر","dorar":"VsMBRNQH","merged":4,"otherRefs":["تخريج المسند لشعيب 7382 (صحيح)","السلسلة الصحيحة 541 (حسن)","صحيح ابن حبان 5671 (صحيح)"]},{"id":"س-05693","fp":"a410494a0ade","stateId":592,"easy":"إذا تكبرت ← تُحشر يوم القيامة أمثال الذر في صور الرجال يغشاك الذل","cause":"المُتَكَبِّرُونَ","result":"يُحْشَرُ المُتَكَبِّرُونَ يومَ القيامةِ أَمْثَالَ الذَّرِّ في صُوَرِ الرِّجَالِ يَغْشَاهُمُ الذُّلُّ من كلِّ مَكَانٍ يُساقُونَ إلى سِجْنٍ في جهنمَ يُسَمَّى : بُولَسَ تَعْلوهُمْ نارُ الأنْيارِ ، يُسْقَوْنَ من عُصارَةِ أهلِ النارِ طِينَةَ الخَبالِ","explicit":true,"otherNeedIds":[39],"ref":"سنن الترمذي 2492","srcLabel":"البخاري","text":[["يُحْشَرُ المُتَكَبِّرُونَ يومَ القيامةِ أَمْثَالَ الذَّرِّ في صُوَرِ الرِّجَالِ يَغْشَاهُمُ الذُّلُّ من كلِّ مَكَانٍ يُساقُونَ إلى سِجْنٍ في جهنمَ يُسَمَّى : بُولَسَ تَعْلوهُمْ نارُ الأنْيارِ ، يُسْقَوْنَ من عُصارَةِ أهلِ النارِ طِينَةَ الخَبالِ",2]],"grade":"صحيح","narrator":"[جد عمرو بن شعيب]","muhaddith":"حسن صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (557) واللفظ له، وأحمد (6677) باختلاف يسير والبيهقي في ((شعب الإيمان)) (7834) بنحوه","bab":"رقائق وزهد › الكبر والتواضع","dorar":"cJW1bjNm","merged":4,"otherRefs":["عمدة التفسير 1/136 (صحيح)","فتح البيان 7/ 228 (صحيح)","تخريج الإحياء للعراقي 3/415 (حسن)"]},{"id":"س-05488","fp":"2ac5e3a01df8","stateId":592,"easy":"إذا أنفقت ليُقال جواد ← تكون من أول من تُسعّر بهم النار","cause":"بل إنَّما أرَدْتَ أنْ يُقالَ: فلانٌ جَوَادٌ فقد قيل ذاك","result":"أولئك الثَّلاثةُ أوَّلُ خلقِ اللهِ تُسعَّرُ بهم النَّارُ يومَ القيامةِ","explicit":true,"otherNeedIds":[45],"ref":"تخريج صحيح ابن حبان 408","srcLabel":"مسلم","text":["أنَّه دخَل مسجدَ المدينةِ فإذا هو برجلٍ قد اجتمَع عليه النَّاسُ فقال: مَن هذا ؟ قالوا: أبو هُريرةَ قال: فدنَوْتُ منه حتَّى قعَدْتُ بينَ يديه وهو يُحدِّثُ النَّاسَ فلمَّا سكَت وخلا قُلْتُ له: أنشُدُكَ بحقِّي لَمَا حدَّثْتَني حديثًا سمِعْتَه عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم عقَلْتَه وعلِمْتَه فقال أبو هُريرةَ: أفعَلُ، لَأُحدِّثَنَّك حديثًا حدَّثَنيه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم عقَلْتُه وعلِمْتُه ثمَّ نشَغ أبو هُريرةَ نَشغةً فمكَث قليلًا ثمَّ أفاق فقال: لَأُحَدِّثَنَّك حديثًا حدَّثنيه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم وأنا وهو في هذا البيتِ ما معنا أحدٌ غيري وغيرُه ثمَّ نشَغ أبو هُريرةَ نَشغةً أخرى فمكَث كذلك ثمَّ أفاق فمسَح عن وجهِه فقال: أفعَلُ، لَأُحَدِّثَنَّك حديثًا حدَّثنيه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم وأنا وهو في هذا البيتِ ما معه أحدٌ غيري وغيرُه ثمَّ نشَغ نشغةً شديدةً ثمَّ مال خارًّا على وجهِه واشتدَّ به طويلًا ثمَّ أفاق فقال: حدَّثني رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( أنَّ اللهَ تبارَك وتعالى إذا كان يومُ القيامةِ ينزِلُ إلى العبادِ ليقضيَ بينَهم وكلُّ أمةٍ جاثيةٌ \nفأوَّلُ مَن يدعو به رجلٌ جمَع القرآنَ ورجلٌ يُقتَلُ في سبيلِ اللهِ ورجلٌ كثيرُ المالِ فيقولُ اللهُ تبارَك وتعالى للقارئِ: ألم أُعلِّمْكَ ما أنزَلْتُ على رسولي صلَّى اللهُ عليه وسلَّم ؟ قال: بلى يا ربِّ قال: فماذا عمِلْتَ فيما علِمْتَ ؟ قال: كُنْتُ أقومُ به آناءَ اللَّيلِ وآناءَ النَّهارِ فيقولُ اللهُ تبارَك وتعالى له: كذَبْتَ وتقولُ له الملائكةُ: كذَبْتَ ويقولُ اللهُ: بل أرَدْتَ أنْ يُقالَ: فلانٌ قارئٌ فقد قيل ذاك \nويُؤتَى بصاحبِ المالِ فيقولُ اللهُ له: ألم أُوسِّعْ عليك حتَّى لم أدَعْكَ تحتاجُ إلى أحدٍ ؟ قال: بلى يا ربِّ قال: فماذا عمِلْتَ فيما آتَيْتُك ؟ قال: كُنْتُ أصِلُ الرَّحِمَ وأتصدَّقُ ؟ فيقولُ اللهُ له: كذَبْتَ وتقولُ الملائكةُ له: كذَبْتَ ويقولُ اللهُ: ",["بل إنَّما أرَدْتَ أنْ يُقالَ: فلانٌ جَوَادٌ فقد قيل ذاك",1]," \nويُؤتَى بالَّذي قُتِل في سبيلِ اللهِ فيُقالُ له: في ماذا قُتِلْتَ ؟ فيقولُ: أُمِرْتُ بالجهادِ في سبيلِك فقاتَلْتُ حتَّى قُتِلْتُ فيقولُ اللهُ له: كذَبْتَ وتقولُ له الملائكةُ: كذَبْتَ ويقولُ اللهُ: بل أرَدْتَ أنْ يُقالَ: فلانٌ جريءٌ فقد قيل ذاك ) ثمَّ ضرَب رسولُ اللهِ صلَّى اللهُ عليه وسلَّم رُكبتي فقال: ( يا أبا هُريرةَ ",["أولئك الثَّلاثةُ أوَّلُ خلقِ اللهِ تُسعَّرُ بهم النَّارُ يومَ القيامةِ",2]," ) \nقال الوليدُ بنُ أبي الوليدِ: فأخبَرني عقبةُ أنَّ شُفَيًّا هو الَّذي دخَل على معاويةَ فأخبَره بهذا الخبرِ \nقال أبو عثمانَ الوليدُ: وحدَّثني العلاءُ بنُ أبي حكيمٍ أنَّه كان سيَّافًا لمعاويةَ قال: فدخَل عليه رجلٌ فحدَّثه بهذا عن أبي هُريرةَ فقال معاويةُ: قد فُعِل بهؤلاء مِثلُ هذا فكيف بِمَن بقي مِن النَّاسِ ؟ ثمَّ بكى معاويةُ بكاءً شديدًا حتَّى ظنَنَّا أنَّه هالكٌ وقُلْنا: قد جاءنا هذا الرَّجلُ بِشَرٍّ ثمَّ أفاق معاويةُ ومسَح عن وجهِه فقال: صدَق اللهُ ورسولُه {مَنْ كَانَ يُرِيدُ الْحَيَاةَ الدُّنْيَا وَزِينَتَهَا نُوَفِّ إِلَيْهِمْ أَعْمَالَهُمْ فِيهَا وَهُمْ فِيهَا لَا يُبْخَسُونَ * أُولَئِكَ الَّذِينَ لَيْسَ لَهُمْ فِي الْآخِرَةِ إِلَّا النَّارُ وَحَبِطَ مَا صَنَعُوا فِيهَا وَبَاطِلٌ مَا كَانُوا يَعْمَلُونَ} [هود: 15، 16]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (408) واللفظ له، ومسلم (1905) بنحوه مختصرا، والترمذي (2382) بنحوه.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"tBU37SCj","merged":5,"otherRefs":["اقتضاء العلم 107 (صحيح)","تاريخ الإسلام 7/102 (صحيح)","المستدرك على الصحيحين 2560 (صحيح)","صحيح النسائي 3137 (صحيح)"]},{"id":"س-04967","fp":"fb72869608c6","stateId":592,"easy":"إذا كنت جعظرياً جواظاً مستكبراً جمّاعاً ← فأنت من أهل النار","cause":"جَعْظرِيٍّ جوَّاظٍ مُستكبرٍ جَمَّاعٍ، وأهلُ الجنَّةِ الضُّعفاءُ المغلوبونَ","result":"أهلُ النَّارِ كُلُّ","explicit":true,"similar":["س-04790"],"ref":"المستدرك على الصحيحين 3890","srcLabel":"مسلم","text":["عنْ عبدِ اللهِ بنِ عمرِو بنِ العاصِ، أنَّه تلا هذه الآيةَ: {مَنَّاعٍ لِلْخَيْرِ مُعْتَدٍ أَثِيمٍ (12) عُتُلٍّ بَعْدَ ذَلِكَ زَنِيمٍ} [القلم: 12، 13] فقالَ: سَمِعتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ يقولُ: «",["أهلُ النَّارِ كُلُّ",2],[" جَعْظرِيٍّ جوَّاظٍ مُستكبرٍ جَمَّاعٍ، وأهلُ الجنَّةِ الضُّعفاءُ المغلوبونَ»",1],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أحمد (6850)، وابن أبي الدنيا في ((التواضع والخمول)) (220)، والحارث بن أبي أسامة كما في ((بغية الباحث)) للهيثمي (1098) جميعهم باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"NK64BvWx","merged":4,"otherRefs":["تخريج المسند لشعيب 12476 (صحيح)","تخريج المسند لشعيب 17585 (صحيح)","يقظة أولي الاعتبار 112 (صحيح)"]},{"id":"س-05487","fp":"390a5f7a1d24","stateId":592,"easy":"إذا قرأت القرآن ليُقال قارئ ← تكون من الثلاثة الذين تُسعّر بهم النار أولاً","cause":"بل أرَدْتَ أنْ يُقالَ: فلانٌ قارئٌ فقد قيل ذاك","result":"أولئك الثَّلاثةُ أوَّلُ خلقِ اللهِ تُسعَّرُ بهم النَّارُ يومَ القيامةِ","explicit":true,"similar":["س-04424"],"otherNeedIds":[45],"ref":"تخريج صحيح ابن حبان 408","srcLabel":"مسلم","text":["أنَّه دخَل مسجدَ المدينةِ فإذا هو برجلٍ قد اجتمَع عليه النَّاسُ فقال: مَن هذا ؟ قالوا: أبو هُريرةَ قال: فدنَوْتُ منه حتَّى قعَدْتُ بينَ يديه وهو يُحدِّثُ النَّاسَ فلمَّا سكَت وخلا قُلْتُ له: أنشُدُكَ بحقِّي لَمَا حدَّثْتَني حديثًا سمِعْتَه عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم عقَلْتَه وعلِمْتَه فقال أبو هُريرةَ: أفعَلُ، لَأُحدِّثَنَّك حديثًا حدَّثَنيه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم عقَلْتُه وعلِمْتُه ثمَّ نشَغ أبو هُريرةَ نَشغةً فمكَث قليلًا ثمَّ أفاق فقال: لَأُحَدِّثَنَّك حديثًا حدَّثنيه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم وأنا وهو في هذا البيتِ ما معنا أحدٌ غيري وغيرُه ثمَّ نشَغ أبو هُريرةَ نَشغةً أخرى فمكَث كذلك ثمَّ أفاق فمسَح عن وجهِه فقال: أفعَلُ، لَأُحَدِّثَنَّك حديثًا حدَّثنيه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم وأنا وهو في هذا البيتِ ما معه أحدٌ غيري وغيرُه ثمَّ نشَغ نشغةً شديدةً ثمَّ مال خارًّا على وجهِه واشتدَّ به طويلًا ثمَّ أفاق فقال: حدَّثني رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( أنَّ اللهَ تبارَك وتعالى إذا كان يومُ القيامةِ ينزِلُ إلى العبادِ ليقضيَ بينَهم وكلُّ أمةٍ جاثيةٌ \nفأوَّلُ مَن يدعو به رجلٌ جمَع القرآنَ ورجلٌ يُقتَلُ في سبيلِ اللهِ ورجلٌ كثيرُ المالِ فيقولُ اللهُ تبارَك وتعالى للقارئِ: ألم أُعلِّمْكَ ما أنزَلْتُ على رسولي صلَّى اللهُ عليه وسلَّم ؟ قال: بلى يا ربِّ قال: فماذا عمِلْتَ فيما علِمْتَ ؟ قال: كُنْتُ أقومُ به آناءَ اللَّيلِ وآناءَ النَّهارِ فيقولُ اللهُ تبارَك وتعالى له: كذَبْتَ وتقولُ له الملائكةُ: كذَبْتَ ويقولُ اللهُ: ",["بل أرَدْتَ أنْ يُقالَ: فلانٌ قارئٌ فقد قيل ذاك",1]," \nويُؤتَى بصاحبِ المالِ فيقولُ اللهُ له: ألم أُوسِّعْ عليك حتَّى لم أدَعْكَ تحتاجُ إلى أحدٍ ؟ قال: بلى يا ربِّ قال: فماذا عمِلْتَ فيما آتَيْتُك ؟ قال: كُنْتُ أصِلُ الرَّحِمَ وأتصدَّقُ ؟ فيقولُ اللهُ له: كذَبْتَ وتقولُ الملائكةُ له: كذَبْتَ ويقولُ اللهُ: بل إنَّما أرَدْتَ أنْ يُقالَ: فلانٌ جَوَادٌ فقد قيل ذاك \nويُؤتَى بالَّذي قُتِل في سبيلِ اللهِ فيُقالُ له: في ماذا قُتِلْتَ ؟ فيقولُ: أُمِرْتُ بالجهادِ في سبيلِك فقاتَلْتُ حتَّى قُتِلْتُ فيقولُ اللهُ له: كذَبْتَ وتقولُ له الملائكةُ: كذَبْتَ ويقولُ اللهُ: بل أرَدْتَ أنْ يُقالَ: فلانٌ جريءٌ فقد قيل ذاك ) ثمَّ ضرَب رسولُ اللهِ صلَّى اللهُ عليه وسلَّم رُكبتي فقال: ( يا أبا هُريرةَ ",["أولئك الثَّلاثةُ أوَّلُ خلقِ اللهِ تُسعَّرُ بهم النَّارُ يومَ القيامةِ",2]," ) \nقال الوليدُ بنُ أبي الوليدِ: فأخبَرني عقبةُ أنَّ شُفَيًّا هو الَّذي دخَل على معاويةَ فأخبَره بهذا الخبرِ \nقال أبو عثمانَ الوليدُ: وحدَّثني العلاءُ بنُ أبي حكيمٍ أنَّه كان سيَّافًا لمعاويةَ قال: فدخَل عليه رجلٌ فحدَّثه بهذا عن أبي هُريرةَ فقال معاويةُ: قد فُعِل بهؤلاء مِثلُ هذا فكيف بِمَن بقي مِن النَّاسِ ؟ ثمَّ بكى معاويةُ بكاءً شديدًا حتَّى ظنَنَّا أنَّه هالكٌ وقُلْنا: قد جاءنا هذا الرَّجلُ بِشَرٍّ ثمَّ أفاق معاويةُ ومسَح عن وجهِه فقال: صدَق اللهُ ورسولُه {مَنْ كَانَ يُرِيدُ الْحَيَاةَ الدُّنْيَا وَزِينَتَهَا نُوَفِّ إِلَيْهِمْ أَعْمَالَهُمْ فِيهَا وَهُمْ فِيهَا لَا يُبْخَسُونَ * أُولَئِكَ الَّذِينَ لَيْسَ لَهُمْ فِي الْآخِرَةِ إِلَّا النَّارُ وَحَبِطَ مَا صَنَعُوا فِيهَا وَبَاطِلٌ مَا كَانُوا يَعْمَلُونَ} [هود: 15، 16]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (408) واللفظ له، ومسلم (1905) بنحوه مختصرا، والترمذي (2382) بنحوه.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"tBU37SCj","merged":4,"otherRefs":["تاريخ الإسلام 7/102 (صحيح)","المستدرك على الصحيحين 2560 (صحيح)","صحيح النسائي 3137 (صحيح)"]},{"id":"س-05489","fp":"88f398373f8a","stateId":592,"easy":"إذا قاتلت ليُقال جريء ← تكون من أول من تُسعّر بهم النار","cause":"بل أرَدْتَ أنْ يُقالَ: فلانٌ جريءٌ فقد قيل ذاك","result":"أولئك الثَّلاثةُ أوَّلُ خلقِ اللهِ تُسعَّرُ بهم النَّارُ يومَ القيامةِ","explicit":true,"otherNeedIds":[45],"ref":"تخريج صحيح ابن حبان 408","srcLabel":"مسلم","text":["أنَّه دخَل مسجدَ المدينةِ فإذا هو برجلٍ قد اجتمَع عليه النَّاسُ فقال: مَن هذا ؟ قالوا: أبو هُريرةَ قال: فدنَوْتُ منه حتَّى قعَدْتُ بينَ يديه وهو يُحدِّثُ النَّاسَ فلمَّا سكَت وخلا قُلْتُ له: أنشُدُكَ بحقِّي لَمَا حدَّثْتَني حديثًا سمِعْتَه عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم عقَلْتَه وعلِمْتَه فقال أبو هُريرةَ: أفعَلُ، لَأُحدِّثَنَّك حديثًا حدَّثَنيه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم عقَلْتُه وعلِمْتُه ثمَّ نشَغ أبو هُريرةَ نَشغةً فمكَث قليلًا ثمَّ أفاق فقال: لَأُحَدِّثَنَّك حديثًا حدَّثنيه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم وأنا وهو في هذا البيتِ ما معنا أحدٌ غيري وغيرُه ثمَّ نشَغ أبو هُريرةَ نَشغةً أخرى فمكَث كذلك ثمَّ أفاق فمسَح عن وجهِه فقال: أفعَلُ، لَأُحَدِّثَنَّك حديثًا حدَّثنيه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم وأنا وهو في هذا البيتِ ما معه أحدٌ غيري وغيرُه ثمَّ نشَغ نشغةً شديدةً ثمَّ مال خارًّا على وجهِه واشتدَّ به طويلًا ثمَّ أفاق فقال: حدَّثني رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( أنَّ اللهَ تبارَك وتعالى إذا كان يومُ القيامةِ ينزِلُ إلى العبادِ ليقضيَ بينَهم وكلُّ أمةٍ جاثيةٌ \nفأوَّلُ مَن يدعو به رجلٌ جمَع القرآنَ ورجلٌ يُقتَلُ في سبيلِ اللهِ ورجلٌ كثيرُ المالِ فيقولُ اللهُ تبارَك وتعالى للقارئِ: ألم أُعلِّمْكَ ما أنزَلْتُ على رسولي صلَّى اللهُ عليه وسلَّم ؟ قال: بلى يا ربِّ قال: فماذا عمِلْتَ فيما علِمْتَ ؟ قال: كُنْتُ أقومُ به آناءَ اللَّيلِ وآناءَ النَّهارِ فيقولُ اللهُ تبارَك وتعالى له: كذَبْتَ وتقولُ له الملائكةُ: كذَبْتَ ويقولُ اللهُ: بل أرَدْتَ أنْ يُقالَ: فلانٌ قارئٌ فقد قيل ذاك \nويُؤتَى بصاحبِ المالِ فيقولُ اللهُ له: ألم أُوسِّعْ عليك حتَّى لم أدَعْكَ تحتاجُ إلى أحدٍ ؟ قال: بلى يا ربِّ قال: فماذا عمِلْتَ فيما آتَيْتُك ؟ قال: كُنْتُ أصِلُ الرَّحِمَ وأتصدَّقُ ؟ فيقولُ اللهُ له: كذَبْتَ وتقولُ الملائكةُ له: كذَبْتَ ويقولُ اللهُ: بل إنَّما أرَدْتَ أنْ يُقالَ: فلانٌ جَوَادٌ فقد قيل ذاك \nويُؤتَى بالَّذي قُتِل في سبيلِ اللهِ فيُقالُ له: في ماذا قُتِلْتَ ؟ فيقولُ: أُمِرْتُ بالجهادِ في سبيلِك فقاتَلْتُ حتَّى قُتِلْتُ فيقولُ اللهُ له: كذَبْتَ وتقولُ له الملائكةُ: كذَبْتَ ويقولُ اللهُ: ",["بل أرَدْتَ أنْ يُقالَ: فلانٌ جريءٌ فقد قيل ذاك",1]," ) ثمَّ ضرَب رسولُ اللهِ صلَّى اللهُ عليه وسلَّم رُكبتي فقال: ( يا أبا هُريرةَ ",["أولئك الثَّلاثةُ أوَّلُ خلقِ اللهِ تُسعَّرُ بهم النَّارُ يومَ القيامةِ",2]," ) \nقال الوليدُ بنُ أبي الوليدِ: فأخبَرني عقبةُ أنَّ شُفَيًّا هو الَّذي دخَل على معاويةَ فأخبَره بهذا الخبرِ \nقال أبو عثمانَ الوليدُ: وحدَّثني العلاءُ بنُ أبي حكيمٍ أنَّه كان سيَّافًا لمعاويةَ قال: فدخَل عليه رجلٌ فحدَّثه بهذا عن أبي هُريرةَ فقال معاويةُ: قد فُعِل بهؤلاء مِثلُ هذا فكيف بِمَن بقي مِن النَّاسِ ؟ ثمَّ بكى معاويةُ بكاءً شديدًا حتَّى ظنَنَّا أنَّه هالكٌ وقُلْنا: قد جاءنا هذا الرَّجلُ بِشَرٍّ ثمَّ أفاق معاويةُ ومسَح عن وجهِه فقال: صدَق اللهُ ورسولُه {مَنْ كَانَ يُرِيدُ الْحَيَاةَ الدُّنْيَا وَزِينَتَهَا نُوَفِّ إِلَيْهِمْ أَعْمَالَهُمْ فِيهَا وَهُمْ فِيهَا لَا يُبْخَسُونَ * أُولَئِكَ الَّذِينَ لَيْسَ لَهُمْ فِي الْآخِرَةِ إِلَّا النَّارُ وَحَبِطَ مَا صَنَعُوا فِيهَا وَبَاطِلٌ مَا كَانُوا يَعْمَلُونَ} [هود: 15، 16]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (408) واللفظ له، ومسلم (1905) بنحوه مختصرا، والترمذي (2382) بنحوه.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"tBU37SCj","merged":4,"otherRefs":["تاريخ الإسلام 7/102 (صحيح)","المستدرك على الصحيحين 2560 (صحيح)","صحيح النسائي 3137 (صحيح)"]},{"id":"س-05479","fp":"ecf1965fb613","stateId":592,"easy":"إذا قمت بمسلم مقام رياء وسمعة ← يقوم الله بك مقام رياء وسمعة يوم القيامة","cause":"و من قام برجلٍ مسلمٍ مقامَ رياءٍ و سُمعةٍ","result":"فإنَّ اللهَ يقوم به مَقامَ رياءٍ و سُمعةٍ يومَ القيامةِ","explicit":true,"otherNeedIds":[39],"ref":"صحيح الأدب المفرد 179","srcLabel":"البخاري","text":["من أكل بمسلمٍ أكلةً فإنَّ اللهَ يُطعِمُه مثلَها من جهنَّمَ ، و من كسى برجلٍ مسلمٍ ، فإنَّ اللهَ عزَّ وجلَّ يكسوه من جهنَّمَ ، ",["و من قام برجلٍ مسلمٍ مقامَ رياءٍ و سُمعةٍ",1]," ؛ ",["فإنَّ اللهَ يقوم به مَقامَ رياءٍ و سُمعةٍ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"المستورد بن شداد","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4881)، وأحمد (18011) باختلاف يسير، والبخاري في ((الأدب المفرد)) (240) واللفظ له.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"q49Z61vr"},{"id":"س-05519","fp":"742b3a65bba4","stateId":592,"easy":"إذا تعلمت العلم لتباهي أو تماري أو تصرف الوجوه إليك ← فأنت في النار","cause":"مَن تَعلَّمَ العِلمَ ليُباهيَ به العُلَماءَ، أو ليُمارِيَ به السُّفَهاءَ، أو ليَصرِفَ به وُجوهَ النَّاسِ إليه","result":"فهو في النَّارِ","explicit":true,"similar":["س-02956","س-04268","س-05517","س-05518","س-03068"],"ref":"الأحاديث المختارة 2480","srcLabel":"متفق عليه","text":["«",["مَن تَعلَّمَ العِلمَ ليُباهيَ به العُلَماءَ، أو ليُمارِيَ به السُّفَهاءَ، أو ليَصرِفَ به وُجوهَ النَّاسِ إليه؛ ",1],["فهو في النَّارِ»",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الرياء والسمعة","dorar":"FKG4Hr1q"},{"id":"س-05580","fp":"4e0bf5d3cb98","stateId":592,"easy":"إذا قلت ما لا تفعل ← تُكتب شهادة في عنقك تُسأل عنها يوم القيامة","cause":"تَقولونَ ما لا تَفعَلونَ","result":"فتُكتَبُ شَهادةً في أعناقِكُم، فتُسألونَ عَنها يَومَ القيامةِ","explicit":true,"ref":"صحيح مسلم 1050","srcLabel":"متفق عليه","text":["بَعَثَ أبو موسى الأشعَريُّ إلى قُرَّاءِ أهلِ البَصرةِ، فدَخَلَ عليه ثَلاثُ مِائةِ رَجُلٍ قد قَرَؤوا القُرآنَ، فقال: أنتُم خيارُ أهلِ البَصرةِ وقُرَّاؤُهم، فاتلوه، ولا يَطولَنَّ عليكُمُ الأمَدُ فتَقسوَ قُلوبُكُم كما قَسَت قُلوبُ مَن كان قَبلَكُم، وإنَّا كُنَّا نَقرَأُ سورةً كُنَّا نُشَبِّهُها في الطُّولِ والشِّدَّةِ ببَراءةَ، فأُنسيتُها، غيرَ أنِّي قد حَفِظتُ منها: لو كان لابنِ آدَمَ واديانِ مِن مالٍ لابتَغى واديًا ثالِثًا، ولا يَملأُ جَوفَ ابنِ آدَمَ إلَّا التُّرابُ، وكُنَّا نَقرَأُ سورةً كُنَّا نُشَبِّهُها بإحدى المُسَبِّحاتِ، فأُنسيتُها، غيرَ أنِّي حَفِظتُ منها: يا أيُّها الذينَ آمَنوا لمَ ",["تَقولونَ ما لا تَفعَلونَ",1],"، ",["فتُكتَبُ شَهادةً في أعناقِكُم، فتُسألونَ عَنها يَومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"أبو الأسود الديلي","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"u65Ireta"},{"id":"س-05720","fp":"facc44284258","stateId":592,"easy":"إذا كان في قلبك مثقال حبة خردل من كبر ← يكبك الله على وجهك في النار","cause":"مَن كان في قلبِه مِثقالُ حَبَّةٍ مِن خَردلٍ مِن كِبرٍ","result":"أكَبَّه اللهُ على وَجهِه في النَّارِ","explicit":true,"similar":["س-05746"],"ref":"تخريج المسند لشعيب 7015","srcLabel":"البخاري","text":["التَقى عبدُ اللهِ بنُ عُمَرَ وعبدُ اللهِ بنُ عَمرِو بنِ العاصي على المَروَةَ، فتَحدَّثا، ثُمَّ مَضى عبدُ اللهِ بنُ عَمرٍو، وبَقيَ عبدُ اللهِ بنُ عُمَرَ يَبكي، فقال له رَجُلٌ: ما يُبكيكَ يا أبا عبدِ الرَّحمنِ؟ قال: هذا -يعني عبدَ اللهِ بنَ عَمرٍو- زعَمَ أنَّه سمِعَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن كان في قلبِه مِثقالُ حَبَّةٍ مِن خَردلٍ مِن كِبرٍ؛ ",1],["أكَبَّه اللهُ على وَجهِه في النَّارِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه أحمد (7015) واللفظ له، وابن أبي شيبة (27113)","bab":"رقائق وزهد › الكبر والتواضع","dorar":"KEHHjUkX"},{"id":"س-08093","fp":"2e9c0f94b982","stateId":592,"easy":"إذا غللت من الغنائم ← تلتهب عليك ناراً","cause":"أخَذَها مِنَ الغَنائِمِ","result":"لَتَلتَهِبُ عليه نارًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح مسلم 115","srcLabel":"متفق عليه","text":["خَرَجنا مع النَّبيِّ صلَّى اللهُ عليه وسلَّم إلى خَيبَرَ، ففَتَحَ اللهُ علينا، فلَم نَغنَمْ ذَهَبًا ولا ورِقًا، غَنِمنا المَتاعَ والطَّعامَ والثِّيابَ، ثُمَّ انطَلَقنا إلى الوادي، ومع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم عَبدٌ له وهَبَه له رَجُلٌ مِن جُذامٍ يُدعى رِفاعةَ بنَ زَيدٍ مِن بَني الضُّبَيبِ، فلَمَّا نَزَلنا الواديَ قامَ عبدُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم يَحُلُّ رَحلَه، فرُميَ بسَهمٍ، فكانَ فيه حَتفُه، فقُلنا: هَنيئًا له الشَّهادةُ يا رَسولَ اللهِ! قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: كَلَّا والذي نَفسُ مُحَمَّدٍ بيَدِه، إنَّ الشَّملةَ ",["لَتَلتَهِبُ عليه نارًا",2]," ",["أخَذَها مِنَ الغَنائِمِ",1]," يَومَ خَيبَرَ لَم تُصِبْها المَقاسِمُ، قال: ففَزِعَ النَّاسُ، فجاءَ رَجُلٌ بشِراكٍ أو شِراكَينِ، فقال: يا رَسولَ اللهِ، أصَبتُ يَومَ خَيبَرَ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: شِراكٌ مِن نارٍ، أو شِراكانِ مِن نارٍ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4234)، ومسلم (115).","bab":"مغازي › غزوة خيبر","dorar":"HZ4atbUU","merged":5,"otherRefs":["صحيح ابن حبان 4852 (صحيح)","تخريج زاد المعاد 3/307 (صحيح)","صحيح أبي داود 2711 (صحيح)","المستدرك على الصحيحين 4401 (صحيح)"]},{"id":"س-03046","fp":"7b897af79920","stateId":592,"easy":"إذا قرأت القرآن رياءً ← يقال يوم القيامة: اذهبوا به إلى النار","cause":"ربِّ علَّمْتَني الكتابَ، فقَرَأتُه آناءَ اللَّيلِ والنَّهارِ رجاءَ ثَوابِكَ، فيُقالُ: كَذَبْتَ إنَّما كنتَ تُصلِّي؛ ليُقالَ: إنَّكَ قارئٌ مُصَلٍّ، وقد قيلَ","result":"اذهبوا به إلى النَّارِ","explicit":true,"otherNeedIds":[45],"ref":"المستدرك على الصحيحين 2564","srcLabel":"مسلم","text":["أَوَّلُ النَّاسِ يَدخُلُ النَّارَ يومَ القيامةِ ثلاثةُ نَفَرٍ، يُؤتى بالرَّجلِ -أوْ قالَ: بأَحَدِهِم- فيقولُ: ",["ربِّ علَّمْتَني الكتابَ، فقَرَأتُه آناءَ اللَّيلِ والنَّهارِ رجاءَ ثَوابِكَ، فيُقالُ: كَذَبْتَ إنَّما كنتَ تُصلِّي؛ ليُقالَ: إنَّكَ قارئٌ مُصَلٍّ، وقد قيلَ",1],"، ",["اذهبوا به إلى النَّارِ",2],"، ثُمَّ يُؤتى بآخَرَ، فيقولُ ربِّ رزَقَتْنَي مالًا، فوَصَلتُ به الرَّحِمَ، وتَصدَّقتُ به على المساكينِ، وحَملْتُ ابنَ السبَّيلِ رَجاءَ ثَوابِكَ وجنَّتِكَ، فيُقالُ: كذَبْتَ، إنَّما كنتَ تَتصدَّقُ وتَصِلُ؛ ليُقالَ: إنَّه سَمْحٌ جَوادٌ، وقد قيلَ، اذهبوا به إلى النَّارِ، ثُمَّ يُجاءُ بالثَّالثِ فيقولُ: ربِّ، خَرجْتُ في سبيلِكَ، فقاتَلْتُ فيكَ حتَّى قُتِلتُ مُقبِلًا غيرَ مُدبِرٍ رجاءَ ثوابِكَ وجنَّتِكَ، فيُقالُ: كذَبْتَ، إنَّما كنتَ تُقاتلُ؛ ليُقالَ: إنَّكَ جريءٌ شُجاعٌ، وقد قيلَ، اذهبوا به إلى النَّارِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه مسلم (1905)، والنسائي (3137) بلفظ مقارب، والترمذي (2382) مطولا.","bab":"إيمان › الوعيد","dorar":"koMuDrs4"},{"id":"س-03047","fp":"39fb5cde84a7","stateId":592,"easy":"إذا أنفقت مالك رياءً ← يقال: اذهبوا به إلى النار","cause":"ربِّ رزَقَتْنَي مالًا، فوَصَلتُ به الرَّحِمَ، وتَصدَّقتُ به على المساكينِ، وحَملْتُ ابنَ السبَّيلِ رَجاءَ ثَوابِكَ وجنَّتِكَ، فيُقالُ: كذَبْتَ، إنَّما كنتَ تَتصدَّقُ وتَصِلُ؛ ليُقالَ: إنَّه سَمْحٌ جَوادٌ، وقد قيلَ","result":"اذهبوا به إلى النَّارِ","explicit":true,"otherNeedIds":[45],"ref":"المستدرك على الصحيحين 2564","srcLabel":"مسلم","text":["أَوَّلُ النَّاسِ يَدخُلُ النَّارَ يومَ القيامةِ ثلاثةُ نَفَرٍ، يُؤتى بالرَّجلِ -أوْ قالَ: بأَحَدِهِم- فيقولُ: ربِّ علَّمْتَني الكتابَ، فقَرَأتُه آناءَ اللَّيلِ والنَّهارِ رجاءَ ثَوابِكَ، فيُقالُ: كَذَبْتَ إنَّما كنتَ تُصلِّي؛ ليُقالَ: إنَّكَ قارئٌ مُصَلٍّ، وقد قيلَ، اذهبوا به إلى النَّارِ، ثُمَّ يُؤتى بآخَرَ، فيقولُ ",["ربِّ رزَقَتْنَي مالًا، فوَصَلتُ به الرَّحِمَ، وتَصدَّقتُ به على المساكينِ، وحَملْتُ ابنَ السبَّيلِ رَجاءَ ثَوابِكَ وجنَّتِكَ، فيُقالُ: كذَبْتَ، إنَّما كنتَ تَتصدَّقُ وتَصِلُ؛ ليُقالَ: إنَّه سَمْحٌ جَوادٌ، وقد قيلَ",1],"، ",["اذهبوا به إلى النَّارِ",2],"، ثُمَّ يُجاءُ بالثَّالثِ فيقولُ: ربِّ، خَرجْتُ في سبيلِكَ، فقاتَلْتُ فيكَ حتَّى قُتِلتُ مُقبِلًا غيرَ مُدبِرٍ رجاءَ ثوابِكَ وجنَّتِكَ، فيُقالُ: كذَبْتَ، إنَّما كنتَ تُقاتلُ؛ ليُقالَ: إنَّكَ جريءٌ شُجاعٌ، وقد قيلَ، اذهبوا به إلى النَّارِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه مسلم (1905)، والنسائي (3137) بلفظ مقارب، والترمذي (2382) مطولا.","bab":"إيمان › الوعيد","dorar":"koMuDrs4"},{"id":"س-03048","fp":"69defb52fceb","stateId":592,"easy":"إذا قاتلت رياءً ← يقال: اذهبوا به إلى النار","cause":"ربِّ، خَرجْتُ في سبيلِكَ، فقاتَلْتُ فيكَ حتَّى قُتِلتُ مُقبِلًا غيرَ مُدبِرٍ رجاءَ ثوابِكَ وجنَّتِكَ، فيُقالُ: كذَبْتَ، إنَّما كنتَ تُقاتلُ؛ ليُقالَ: إنَّكَ جريءٌ شُجاعٌ، وقد قيلَ","result":"اذهبوا به إلى النَّارِ","explicit":true,"otherNeedIds":[45],"ref":"المستدرك على الصحيحين 2564","srcLabel":"مسلم","text":["أَوَّلُ النَّاسِ يَدخُلُ النَّارَ يومَ القيامةِ ثلاثةُ نَفَرٍ، يُؤتى بالرَّجلِ -أوْ قالَ: بأَحَدِهِم- فيقولُ: ربِّ علَّمْتَني الكتابَ، فقَرَأتُه آناءَ اللَّيلِ والنَّهارِ رجاءَ ثَوابِكَ، فيُقالُ: كَذَبْتَ إنَّما كنتَ تُصلِّي؛ ليُقالَ: إنَّكَ قارئٌ مُصَلٍّ، وقد قيلَ، اذهبوا به إلى النَّارِ، ثُمَّ يُؤتى بآخَرَ، فيقولُ ربِّ رزَقَتْنَي مالًا، فوَصَلتُ به الرَّحِمَ، وتَصدَّقتُ به على المساكينِ، وحَملْتُ ابنَ السبَّيلِ رَجاءَ ثَوابِكَ وجنَّتِكَ، فيُقالُ: كذَبْتَ، إنَّما كنتَ تَتصدَّقُ وتَصِلُ؛ ليُقالَ: إنَّه سَمْحٌ جَوادٌ، وقد قيلَ، اذهبوا به إلى النَّارِ، ثُمَّ يُجاءُ بالثَّالثِ فيقولُ: ",["ربِّ، خَرجْتُ في سبيلِكَ، فقاتَلْتُ فيكَ حتَّى قُتِلتُ مُقبِلًا غيرَ مُدبِرٍ رجاءَ ثوابِكَ وجنَّتِكَ، فيُقالُ: كذَبْتَ، إنَّما كنتَ تُقاتلُ؛ ليُقالَ: إنَّكَ جريءٌ شُجاعٌ، وقد قيلَ",1],"، ",["اذهبوا به إلى النَّارِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه مسلم (1905)، والنسائي (3137) بلفظ مقارب، والترمذي (2382) مطولا.","bab":"إيمان › الوعيد","dorar":"koMuDrs4"},{"id":"ق-0197","fp":"68667cd55c6d","stateId":592,"easy":"الفرح بالباطل وحبّ الحمد بما لم يُفعل ← لا مفازة من العذاب وعذاب أليم","cause":"الفرح بالباطل وحبّ الحمد بما لم يُفعل","result":"لا مفازة من العذاب وعذاب أليم","explicit":true,"ref":"سورة آل عمران: 188","srcLabel":"القرآن الكريم","quran":{"s":3,"from":188,"to":188,"text":"لَا تَحْسَبَنَّ الَّذِينَ يَفْرَحُونَ بِمَا أَتَوْا وَيُحِبُّونَ أَنْ يُحْمَدُوا بِمَا لَمْ يَفْعَلُوا فَلَا تَحْسَبَنَّهُمْ بِمَفَازَةٍ مِنَ الْعَذَابِ وَلَهُمْ عَذَابٌ أَلِيمٌ (188)","hl":[[0,177,1]]}},{"id":"ق-0281","fp":"607514f86b72","stateId":592,"easy":"الاستنكاف والاستكبار عن عبادة الله ← عذاب أليم ولا وليّ ولا نصير","cause":"الاستنكاف والاستكبار عن عبادة الله","result":"عذاب أليم ولا وليّ ولا نصير","explicit":true,"ref":"سورة النساء: 173","srcLabel":"القرآن الكريم","quran":{"s":4,"from":173,"to":173,"text":"فَأَمَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَيُوَفِّيهِمْ أُجُورَهُمْ وَيَزِيدُهُمْ مِنْ فَضْلِهِ وَأَمَّا الَّذِينَ اسْتَنْكَفُوا وَاسْتَكْبَرُوا فَيُعَذِّبُهُمْ عَذَابًا أَلِيمًا وَلَا يَجِدُونَ لَهُمْ مِنْ دُونِ اللَّهِ وَلِيًّا وَلَا نَصِيرًا (173)","hl":[[107,255,1]]}},{"id":"ق-0666","fp":"6f3188a57d7e","stateId":592,"easy":"ظلم النفس والتكبر ← الخزي يوم القيامة ودخول أبواب جهنم","cause":"ظلم النفس والتكبر","result":"الخزي يوم القيامة ودخول أبواب جهنم","explicit":true,"otherNeedIds":[59],"ref":"سورة النحل: 27–29","srcLabel":"القرآن الكريم","quran":{"s":16,"from":27,"to":29,"text":"ثُمَّ يَوْمَ الْقِيَامَةِ يُخْزِيهِمْ وَيَقُولُ أَيْنَ شُرَكَائِيَ الَّذِينَ كُنْتُمْ تُشَاقُّونَ فِيهِمْ قَالَ الَّذِينَ أُوتُوا الْعِلْمَ إِنَّ الْخِزْيَ الْيَوْمَ وَالسُّوءَ عَلَى الْكَافِرِينَ (27) الَّذِينَ تَتَوَفَّاهُمُ الْمَلَائِكَةُ ظَالِمِي أَنْفُسِهِمْ فَأَلْقَوُا السَّلَمَ مَا كُنَّا نَعْمَلُ مِنْ سُوءٍ بَلَى إِنَّ اللَّهَ عَلِيمٌ بِمَا كُنْتُمْ تَعْمَلُونَ (28) فَادْخُلُوا أَبْوَابَ جَهَنَّمَ خَالِدِينَ فِيهَا فَلَبِئْسَ مَثْوَى الْمُتَكَبِّرِينَ (29)","hl":[[0,463,1]]}},{"id":"ق-1041","fp":"f6a152a7a3ad","stateId":592,"easy":"الاستكبار عن «لا إله إلا الله» والإجرام ← ذوق العذاب الأليم","cause":"الاستكبار عن «لا إله إلا الله» والإجرام","result":"ذوق العذاب الأليم","explicit":true,"ref":"سورة الصافات: 34–38","srcLabel":"القرآن الكريم","quran":{"s":37,"from":34,"to":38,"text":"إِنَّا كَذَلِكَ نَفْعَلُ بِالْمُجْرِمِينَ (34) إِنَّهُمْ كَانُوا إِذَا قِيلَ لَهُمْ لَا إِلَهَ إِلَّا اللَّهُ يَسْتَكْبِرُونَ (35) وَيَقُولُونَ أَئِنَّا لَتَارِكُو آلِهَتِنَا لِشَاعِرٍ مَجْنُونٍ (36) بَلْ جَاءَ بِالْحَقِّ وَصَدَّقَ الْمُرْسَلِينَ (37) إِنَّكُمْ لَذَائِقُو الْعَذَابِ الْأَلِيمِ (38)","hl":[[0,294,1]]}},{"id":"ق-1096","fp":"0c31388f45ae","stateId":592,"easy":"الكذب على الله والتكبر ← اسوداد الوجوه وجهنم","cause":"الكذب على الله والتكبر","result":"اسوداد الوجوه وجهنم","explicit":true,"ref":"سورة الزمر: 60","srcLabel":"القرآن الكريم","quran":{"s":39,"from":60,"to":60,"text":"وَيَوْمَ الْقِيَامَةِ تَرَى الَّذِينَ كَذَبُوا عَلَى اللَّهِ وُجُوهُهُمْ مُسْوَدَّةٌ أَلَيْسَ فِي جَهَنَّمَ مَثْوًى لِلْمُتَكَبِّرِينَ (60)","hl":[[0,134,1]]}},{"id":"ق-1121","fp":"2acda5c7e757","stateId":592,"easy":"الاستكبار عن عبادة الله ودعائه ← دخول جهنم داخرين","cause":"الاستكبار عن عبادة الله ودعائه","result":"دخول جهنم داخرين","explicit":true,"otherNeedIds":[29],"ref":"سورة غافر: 60","srcLabel":"القرآن الكريم","quran":{"s":40,"from":60,"to":60,"text":"وَقَالَ رَبُّكُمُ ادْعُونِي أَسْتَجِبْ لَكُمْ إِنَّ الَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِي سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ (60)","hl":[[46,128,1]]}},{"id":"ق-1124","fp":"a61e2302f3f3","stateId":592,"easy":"الفرح في الأرض بغير الحق والمرح ← جهنم مثوى المتكبرين","cause":"الفرح في الأرض بغير الحق والمرح","result":"جهنم مثوى المتكبرين","explicit":true,"ref":"سورة غافر: 75–76","srcLabel":"القرآن الكريم","quran":{"s":40,"from":75,"to":76,"text":"ذَلِكُمْ بِمَا كُنْتُمْ تَفْرَحُونَ فِي الْأَرْضِ بِغَيْرِ الْحَقِّ وَبِمَا كُنْتُمْ تَمْرَحُونَ (75) ادْخُلُوا أَبْوَابَ جَهَنَّمَ خَالِدِينَ فِيهَا فَبِئْسَ مَثْوَى الْمُتَكَبِّرِينَ (76)","hl":[[0,184,1]]}},{"id":"ق-1182","fp":"07519109f41c","stateId":592,"easy":"الإفك والإثم: سماع آيات الله ثم الإصرار مستكبراً واتخاذها هزواً ← ويل وعذاب أليم ومهين ومن ورائهم جهنم","cause":"الإفك والإثم: سماع آيات الله ثم الإصرار مستكبراً واتخاذها هزواً","result":"ويل وعذاب أليم ومهين ومن ورائهم جهنم","explicit":true,"ref":"سورة الجاثية: 7–10","srcLabel":"القرآن الكريم","quran":{"s":45,"from":7,"to":10,"text":"وَيْلٌ لِكُلِّ أَفَّاكٍ أَثِيمٍ (7) يَسْمَعُ آيَاتِ اللَّهِ تُتْلَى عَلَيْهِ ثُمَّ يُصِرُّ مُسْتَكْبِرًا كَأَنْ لَمْ يَسْمَعْهَا فَبَشِّرْهُ بِعَذَابٍ أَلِيمٍ (8) وَإِذَا عَلِمَ مِنْ آيَاتِنَا شَيْئًا اتَّخَذَهَا هُزُوًا أُولَئِكَ لَهُمْ عَذَابٌ مُهِينٌ (9) مِنْ وَرَائِهِمْ جَهَنَّمُ وَلَا يُغْنِي عَنْهُمْ مَا كَسَبُوا شَيْئًا وَلَا مَا اتَّخَذُوا مِنْ دُونِ اللَّهِ أَوْلِيَاءَ وَلَهُمْ عَذَابٌ عَظِيمٌ (10)","hl":[[0,405,1]]}},{"id":"ق-1197","fp":"09627483d15b","stateId":592,"easy":"الاستكبار في الأرض بغير الحق والفسق وإذهاب الطيبات في الدنيا ← عذاب الهُون","cause":"الاستكبار في الأرض بغير الحق والفسق وإذهاب الطيبات في الدنيا","result":"عذاب الهُون","explicit":true,"ref":"سورة الأحقاف: 20","srcLabel":"القرآن الكريم","quran":{"s":46,"from":20,"to":20,"text":"وَيَوْمَ يُعْرَضُ الَّذِينَ كَفَرُوا عَلَى النَّارِ أَذْهَبْتُمْ طَيِّبَاتِكُمْ فِي حَيَاتِكُمُ الدُّنْيَا وَاسْتَمْتَعْتُمْ بِهَا فَالْيَوْمَ تُجْزَوْنَ عَذَابَ الْهُونِ بِمَا كُنْتُمْ تَسْتَكْبِرُونَ فِي الْأَرْضِ بِغَيْرِ الْحَقِّ وَبِمَا كُنْتُمْ تَفْسُقُونَ (20)","hl":[[0,262,1]]}},{"id":"س-00360","fp":"3c5597f18f3c","stateId":592,"easy":"إذا انتسبت إلى آباء كفار تريد بهم عزاً ← تكون عاشرهم في النار","cause":"مَن انتسَبَ إلى تِسعةِ آباءٍ كُفَّارٍ يريدُ بهم عِزًّا وكَرَمًا","result":"كان عاشِرَهم في النَّارِ","explicit":true,"similar":["س-05266"],"ref":"الجامع الصغير 8515","srcLabel":"البخاري","text":[["مَن انتسَبَ إلى تِسعةِ آباءٍ كُفَّارٍ يريدُ بهم عِزًّا وكَرَمًا، ",1],["كان عاشِرَهم في النَّارِ",2],"."],"grade":"حسن","narrator":"أبو ريحانة","muhaddith":"حسن","takhrij":"أخرجه أحمد (17212)، والبخاري في ((التاريخ الكبير)) (3/ 270)، وأبو يعلى (1439) بلفظه.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"fR2tqn4o"},{"id":"س-05266","fp":"144bb10fef46","stateId":592,"easy":"إذا انتسبت إلى آبائك الكفار فخراً ← تكون عاشرهم في النار","cause":"المُنْتَمي -أو المُنْتَسِبُ- إلى تِسْعةٍ في النَّارِ","result":"فأنت عاشِرُهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-00360","ref":"الأحاديث المختارة 1241","text":["«انْتَسَبَ رَجُلانِ على عَهْدِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقالَ أَحَدُهما: أنا فُلانُ بنُ فُلانِ بنِ فُلانٍ، فمَن أنت لا أُمَّ لك؟ فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: انْتَسَبَ رَجُلانِ على عَهْدِ موسى صلَّى اللهُ عليه وسلَّمَ، فقالَ أحَدُهما: أنا فُلانُ بنُ فُلانٍ، حتَّى عَدَّ تِسْعةً، فمَن أنت لا أُمَّ لك؟ قالَ: أنا فُلانُ بنُ فُلانِ بنِ الإسْلامِ، قالَ: فأَوْحى اللهُ إلى موسى عليه السَّلامُ: إنَّ هذَينِ المُنْتَسِبَينِ؛ أمَّا أنت أيُّها ",["المُنْتَمي -أو المُنْتَسِبُ- إلى تِسْعةٍ في النَّارِ",1]," ",["فأنت عاشِرُهم",2],"، وأمَّا أنت يا هذا المُنْتَسِبُ إلى اثْنَينِ في الجنَّةِ فأنت ثالِثُهما في الجنَّةِ»."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"sCfhYTR3"},{"id":"س-04822","fp":"beec8b280597","stateId":592,"easy":"إذا توليت الإمارة ← أولها ملامة وثانيها ندامة وثالثها عذاب يوم القيامة إلا من عدل","cause":"الإمارةِ","result":"أوَّلُها ملامةٌ ، وثانيها ندامةٌ , وثالثُها عذابٌ يومَ القيامةِ ، إلَّا من عدَل","explicit":true,"otherNeedIds":[39,50],"ref":"الأحكام الشرعية الصغرى 484","srcLabel":"الطبراني","text":["إن شئتم أنبأتُكم عن ",["الإمارةِ",1]," وما هي . فقمتُ فناديتُ بأعلَى صوتي ثلاثَ مرَّاتٍ ، وما هي يا رسولَ اللهِ ؟ قال : ",["أوَّلُها ملامةٌ ، وثانيها ندامةٌ , وثالثُها عذابٌ يومَ القيامةِ ، إلَّا من عدَل",2]," ، وكيف يعدِلُ مع أقربيه"],"grade":"صحيح","narrator":"عوف بن مالك الأشجعي","muhaddith":"[أشار في المقدمة أنه صحيح الإسناد]","takhrij":"أخرجه البزار (2756)، والطبراني في ((مسند الشاميين)) (2006)، واللفظ لهما، وابن أبي عاصم في (الآحاد والمثاني) (1284) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"N7kiV7N4","merged":3,"otherRefs":["صحيح الترغيب 2174 (صحيح)","السلسلة الصحيحة 1562 (صحيح)"]},{"id":"س-05292","fp":"9b24cfee1cb2","stateId":592,"easy":"إذا جررت ثوبك خيلاء ← تطؤه في النار","cause":"مَن وَطِئَه مِنَ الخُيَلاءِ وطِئَه","result":"في النَّارِ","explicit":true,"ref":"تخريج المسند لشعيب 15607","srcLabel":"أحمد","text":["عن أسلَمَ، أنَّه سَمِعَ هُبَيبَ بنَ مُغْفِلٍ، صاحِبَ النَّبيِّ صلَّى اللهُ عليه وسلَّم، ورَأى رَجُلًا يَجُرُّ رِداءَه خَلفَه، ويَطَؤُه، فقال: سُبحانَ اللهِ! سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: ",["مَن وَطِئَه مِنَ الخُيَلاءِ وطِئَه ",1],["في النَّارِ",2]],"grade":"صحيح","narrator":"هبيب بن مغفل","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"wSvpJDma","merged":3,"otherRefs":["تخريج المسند لشعيب 15605 (صحيح)","تنبيه الغافلين 217 (حسن)"]},{"id":"س-04236","fp":"7163fbd83fe9","stateId":592,"easy":"إذا كنت جباراً عنيداً أو ادعيت مع الله إلهاً أو صوّرت ← يخرج عنق من النار يلتقطك","cause":"بكلِّ جبَّارٍ عَنيدٍ، وبكلِّ مَنِ ادَّعَى مع اللهِ إلهًا آخَرَ، والمُصَوِّرينَ","result":"يَخرُجُ عُنُقٌ مِنَ النَّارِ يومَ القيامةِ، له عينانِ يُبصِرُ بهما، وأُذُنانِ يَسمَعُ بهما، ولسانٌ يَنطِقُ به، فيقولُ: إنِّي وُكِّلتُ بثلاثةٍ","explicit":true,"ref":"تخريج المسند لشعيب 8430","srcLabel":"الترمذي","text":[["يَخرُجُ عُنُقٌ مِنَ النَّارِ يومَ القيامةِ، له عينانِ يُبصِرُ بهما، وأُذُنانِ يَسمَعُ بهما، ولسانٌ يَنطِقُ به، فيقولُ: إنِّي وُكِّلتُ بثلاثةٍ",2],": ",["بكلِّ جبَّارٍ عَنيدٍ، وبكلِّ مَنِ ادَّعَى مع اللهِ إلهًا آخَرَ، والمُصَوِّرينَ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الترمذي (2574)، وأحمد (8430) واللفظ له","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"qOGG1He7","merged":2,"otherRefs":["الصحيح المسند 1406 (صحيح)"]},{"id":"س-04424","fp":"415569af562f","stateId":592,"easy":"إذا طلبت العلم وقرأت القرآن ليُقال عالم أو قارئ ← تكون من أول من تُسعّر بهم النار","cause":"الذي طلب العلمَ وقرأ القرآنَ لغيرِ اللهِ ليقالَ: هو عالمٌ، ولِيقالَ له: قارئٌ","result":"إن أولَ مَن تُسعَّرُ بهم النارُ","explicit":true,"repOf":"س-05487","otherNeedIds":[45],"ref":"مجموع فتاوى ابن باز 307/2","text":["[",["إن أولَ مَن تُسعَّرُ بهم النارُ",2]," ثلاثةٌ: منهم: ",["الذي طلب العلمَ وقرأ القرآنَ لغيرِ اللهِ ليقالَ: هو عالمٌ، ولِيقالَ له: قارئٌ",1],"]"],"grade":"صحيح","muhaddith":"صحيح","bab":"جهاد › النية في القتال والغزو","dorar":"0ud2Xe3H","merged":2,"otherRefs":["زاد المعاد 3/80 (صحيح)"]},{"id":"س-05128","fp":"b2a3dad74c22","stateId":592,"easy":"إذا لم تحافظ على الصلاة ← لا تكون لك نوراً ولا برهاناً ولا نجاة، وتكون يوم القيامة مع فرعون وقارون","cause":"ومَن لم يُحافِظْ عليها","result":"لم تكُنْ له نورًا ولا بُرهانًا ولا نَجاةً، وكان يومَ القيامةِ مع فِرعونَ، وقارونَ، وهامانَ، وأُبَيٍّ صاحبِ العِظامِ","explicit":true,"otherNeedIds":[50],"ref":"تخريج مشكل الآثار 3180","srcLabel":"أحمد","text":["ذكَرَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ الصَّلاةَ يومًا، فقال: مَن حافَظَ عليها كانت له نورًا وبُرهانًا ونَجاةً يومَ القيامةِ، ",["ومَن لم يُحافِظْ عليها، ",1],["لم تكُنْ له نورًا ولا بُرهانًا ولا نَجاةً، وكان يومَ القيامةِ مع فِرعونَ، وقارونَ، وهامانَ، وأُبَيٍّ صاحبِ العِظامِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6576)، والدارمي (2721)، وابن حبان (1467) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"QKOyihCm","merged":2,"otherRefs":["مجموع فتاوى ابن باز 234/10 (حسن)"]},{"id":"س-00556","fp":"22269078cc70","stateId":592,"easy":"إذا علّمت الناس وخالفت ما تنهاهم عنه ← تُقذف في النار يوم القيامة مع علماء السوء","cause":"إنِّي كنتُ أخالِفُ ما أنهاكم عنه","result":"يُؤتى بعُلَماءِ السُّوءِ يومَ القيامةِ فيُقذَفونَ في نارِ جهنَّمَ، فيدورُ أحدُهم في نارِ جهنَّمَ بقُصْبِه كما يدورُ الحِمارُ بالرَّحى","explicit":true,"ref":"المصابيح في الأحاديث المتواترة 626","srcLabel":"المصابيح في الأحاديث المتواترة","text":[["يُؤتى بعُلَماءِ السُّوءِ يومَ القيامةِ فيُقذَفونَ في نارِ جهنَّمَ، فيدورُ أحدُهم في نارِ جهنَّمَ بقُصْبِه كما يدورُ الحِمارُ بالرَّحى",2],"، فيقالُ له: يا وَيلَك! بك اهتَدَينا، فما بالُك؟! قال: ",["إنِّي كنتُ أخالِفُ ما أنهاكم عنه",1],"، وفي بَعضِ الرِّواياتِ: (برَجُل)، وفي بعضِها: (بالأميرِ)، وفي بعضِها: (بالوالي)"],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"آداب عامة › ضرب الأمثال","dorar":"RD8d0mJv"},{"id":"س-02956","fp":"91891553effb","stateId":592,"easy":"إذا تعلمت العلم لتباهي العلماء أو تماري السفهاء أو تصرف الوجوه إليك ← فالنار النار","cause":"لا تَتعلَّموا العِلمَ لتُباهوا بِهِ العُلَماءَ، أو لتُماروا بِهِ السُّفَهاءَ، ولا لتَخيَّروا بِهِ المجالِسَ","result":"فمن فعلَ ذلك فالنَّارَ النَّارَ","explicit":true,"repOf":"س-05519","ref":"المصابيح في الأحاديث المتواترة 623","text":[["لا تَتعلَّموا العِلمَ لتُباهوا بِهِ العُلَماءَ، أو لتُماروا بِهِ السُّفَهاءَ، ولا لتَخيَّروا بِهِ المجالِسَ",1]," ",["فمن فعلَ ذلك فالنَّارَ النَّارَ",2]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"إيمان › الوعيد","dorar":"n9XBBvpi"},{"id":"س-03113","fp":"15ed2b57148c","stateId":592,"easy":"إذا نازعت الله في العظمة أو الكبرياء ← يدخلك النار","cause":"فمَن نازَعني في شيءٍ منه","result":"أدخَلْتُه في النَّارِ","explicit":true,"repOf":"س-00953","ref":"صحيح ابن حبان 5672","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم عن اللهِ جلَّ وعلا: ( الكبرياءُ ردائي والعظمةُ إزاري ",["فمَن نازَعني في شيءٍ منه",1]," ",["أدخَلْتُه في النَّارِ",2]," )"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن ماجه (4175)، والبزار (5106)، وابن عدي في ((الكامل في الضعفاء)) (5/363) باختلاف يسير","bab":"إيمان › توحيد الأسماء والصفات","dorar":"Jnw9TKXy"},{"id":"س-03152","fp":"7cf2255e2b34","stateId":592,"easy":"إذا نازعت الله رداءه ← لا ينبغي لك أن تدخل الجنة","cause":"ومَنْ نازَعَ اللهَ رِداءَهُ الَّذي ينبغي له","result":"فإنَّ اللهَ يقولُ: لا ينبغي لمَنْ نازَعني أنْ أُدْخِله الجنَّةَ","explicit":true,"ref":"المستدرك على الصحيحين 3730","srcLabel":"البيهقي","text":["عنْ أبي هُريرةَ رَضيَ اللهُ عنه، رفَعَهُ قالَ: «إنَّ للهِ ثلاثةَ أثوابٍ؛ اتَّزرَ العِزَّةَ، وتَسرْبلَ الرَّحمةَ، وارتدى الكِبرياءَ، فمَنْ تعزَّزَ بغيرِ ما أعزَّهُ اللهُ، فذلك الَّذي يُقالُ له: {ذُقْ إِنَّكَ أَنتَ الْعَزِيزُ الْكَرِيمُ} [الدخان: 49]، ومَنْ رَحِمَ النَّاسَ رَحِمَهُ اللهُ، فذلك الَّذي تَسرْبلَ بسِربالِهِ الَّذي ينبغي له، ",["ومَنْ نازَعَ اللهَ رِداءَهُ الَّذي ينبغي له، ",1],["فإنَّ اللهَ يقولُ: لا ينبغي لمَنْ نازَعني أنْ أُدْخِله الجنَّةَ»",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن حجر في ((الغرائب الملتقطة)) (775) بنحوه، والبيهقي في ((شعب الإيمان)) (7810) بلفظ مقارب","bab":"إيمان › توحيد الأسماء والصفات","dorar":"8ogeNT4w"},{"id":"س-04268","fp":"a72d1ff73254","stateId":592,"easy":"إذا تعلمت العلم للمباهاة أو المماراة أو صرف الوجوه ← يدخلك الله النار","cause":"مَنْ تعلَّمَ العلْمَ ليُباهِيَ بِهِ العلماءَ ، أوْ يُمارِيَ بِهِ السفهاءَ ، أوْ يصرِفَ بِهِ وجوهَ الناسِ إليه","result":"أدخَلَهُ اللهُ جهنَّمَ","explicit":true,"repOf":"س-05519","ref":"صحيح الجامع 6158","text":[["مَنْ تعلَّمَ العلْمَ ليُباهِيَ بِهِ العلماءَ ، أوْ يُمارِيَ بِهِ السفهاءَ ، أوْ يصرِفَ بِهِ وجوهَ الناسِ إليه ، ",1],["أدخَلَهُ اللهُ جهنَّمَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3664)، وأحمد (8457) بمعناه، وابن ماجه (260) باختلاف يسير.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"S9oVj6Om"},{"id":"س-04788","fp":"0565ef6b4461","stateId":592,"easy":"إذا وطئت على إزارك خيلاء ← تطأ في نار جهنم","cause":"مَن وطِئَ على إزارِه خُيَلاءَ","result":"وَطِئَ في نارِ جَهَنَّمَ","explicit":true,"similar":["س-05712"],"ref":"تخريج المسند لشعيب 18078","srcLabel":"أحمد","text":["«",["مَن وطِئَ على إزارِه خُيَلاءَ",1]," ",["وَطِئَ في نارِ جَهَنَّمَ",2],"»."],"grade":"صحيح","narrator":"هبيب بن مغفل الغفاري","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"hOhaFrHS"},{"id":"س-05484","fp":"5c1ca2886544","stateId":592,"easy":"إذا ربطت الخيل رياءً وسمعة وفرحاً ومرحاً ← يكون شبعها وجوعها وريها وظمؤها خسراناً في ميزانك","cause":"ومَن ربَطَها رِياءً، وسُمْعةً، وفَرَحًا، ومَرَحًا","result":"فإنَّ شِبَعَها، وجوعَها، ورِيَّها، وظَمَأَها، وأَرْواثَها، وأَبْوالَها خُسْرانٌ في مَوازينِهِ يومَ القِيامَةِ","explicit":true,"ref":"تخريج المسند لشعيب 27574","srcLabel":"أحمد","text":["الخَيْلُ في نَواصِيها الخَيْرُ مَعْقودٌ أبَدًا إلى يومِ القيامَةِ، فمَنْ ربَطَها عُدَّةً في سَبيلِ اللهِ، وأنْفَقَ عليها احتِسابًا في سبيلِ اللهِ، فإنَّ شِبَعَها وجُوعَها، ورِيَّها، وظَمَأَها، وأَرْواثَها، وأبْوالَها فَلاحٌ في مَوازينِهِ يومَ القِيامةِ، ",["ومَن ربَطَها رِياءً، وسُمْعةً، وفَرَحًا، ومَرَحًا، ",1],["فإنَّ شِبَعَها، وجوعَها، ورِيَّها، وظَمَأَها، وأَرْواثَها، وأَبْوالَها خُسْرانٌ في مَوازينِهِ يومَ القِيامَةِ",2],"."],"grade":"صحيح","narrator":"أسماء بنت يزيد أم سلمة الأنصارية","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (27574) واللفظ له، وابن أبي شيبة (34172) مختصراً، وعبد بن حميد (1581) باختلاف يسير","bab":"رقائق وزهد › الرياء والسمعة","dorar":"gWcCzVJy"},{"id":"س-05493","fp":"e05e55e1508f","stateId":592,"easy":"إذا قاتلت مرائياً مكاثراً ← يبعثك الله مرائياً مكاثراً","cause":"وإنْ قاتلْتَ مُرائيًا مُكاثِرًا","result":"بَعَثَكَ اللهُ مُرائيًا مُكاثِرًا","explicit":true,"otherNeedIds":[45],"ref":"المستدرك على الصحيحين 2565","srcLabel":"أبو داود","text":["يا رسولَ اللهِ، أَخبِرني عنِ الجهادِ والغَزْوِ، فقالَ: يا عبدَ اللهِ بنَ عَمرٍو، إنْ قَاتلْتَ صابِرًا مُحتسِبًا؛ بَعَثَكَ اللهُ صابِرًا مُحتسِبًا، ",["وإنْ قاتلْتَ مُرائيًا مُكاثِرًا",1],"؛ ",["بَعَثَكَ اللهُ مُرائيًا مُكاثِرًا",2],"، يا عبدَ اللهِ بنَ عَمرٍو، على أَيِّ حالٍ قاتلْتَ أوْ قُتِلتَ؛ بَعَثَكَ اللهُ على تلك الحالِ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داود (2519)، والبيهقي (18588) كلاهما باختلاف يسير، وابن أبي الدنيا في ((محاسبة النفس)) (62) ببعض لفظه.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"f6sMT1kR"},{"id":"س-05511","fp":"ea8632dde2ff","stateId":592,"easy":"إذا راءيت بشيء من عملك في الدنيا ← يكلك الله إليه يوم القيامة","cause":"مَن رايا بشَيءٍ في الدُّنيا مِن عَمَلِه","result":"وَكَلَه اللهُ إليه يَومَ القيامةِ","explicit":true,"otherNeedIds":[45],"ref":"الترغيب والترهيب 1/50","srcLabel":"الترغيب والترهيب","text":["عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهما قالَ: ",["مَن رايا بشَيءٍ في الدُّنيا مِن عَمَلِه ",1],["وَكَلَه اللهُ إليه يَومَ القيامةِ",2],"، وقال: انظُرْ هل يُغني عنكَ شَيئًا."],"grade":"صحيح","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","bab":"رقائق وزهد › الرياء والسمعة","dorar":"4udUAISU"},{"id":"س-05517","fp":"5b3fb2210ce8","stateId":592,"easy":"إذا ابتغيت العلم لتباهي العلماء أو تماري السفهاء أو تُقبل الوجوه عليك ← فإلى النار","cause":"مَنِ ابْتَغَى العِلْمَ لِيُباهيَ به العُلَماءَ، أَوْ يُماريَ به السُّفَهاءَ، أَوْ يُقْبلَ أفْئِدةَ النَّاسِ إليهِ","result":"فَإلى النَّارِ","explicit":true,"repOf":"س-05519","ref":"المستدرك على الصحيحين 296","text":["«",["مَنِ ابْتَغَى العِلْمَ لِيُباهيَ به العُلَماءَ، أَوْ يُماريَ به السُّفَهاءَ، أَوْ يُقْبلَ أفْئِدةَ النَّاسِ إليهِ، ",1],["فَإلى النَّارِ»",2],"."],"grade":"صحيح","narrator":"كعب بن مالك","muhaddith":"[إسناده صحيح] لم يخرج الشيخان لإسحاق بن يحيى شيئا، وإنما جعلته شاهدا لما قدمت من شرطهما","takhrij":"أخرجه الطبراني (19/ 100) (199)، وابن أبي الدنيا في ((ذم الغيبة والنميمة)) (3)، وابن عدي في ((الكامل)) (1/ 541) باختلاف يسير.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"Jryb5cQl"},{"id":"س-05518","fp":"9597a5221b41","stateId":592,"easy":"إذا تعلمت العلم لتباهي به أو تماري أو تتخير المجالس ← فالنار النار","cause":"لا تَعَلَّموا العِلْم لِتُباهوا به العُلَماءَ أو تُماروا به السُّفَهاءَ، ولا لِتُحَبِّروا به المَجْلِسَ","result":"فَمَنْ فَعَلَ ذلك فالنَّارُ النَّارُ","explicit":true,"repOf":"س-05519","ref":"المستدرك على الصحيحين 293","text":["«",["لا تَعَلَّموا العِلْم لِتُباهوا به العُلَماءَ أو تُماروا به السُّفَهاءَ، ولا لِتُحَبِّروا به المَجْلِسَ",1],"؛ ",["فَمَنْ فَعَلَ ذلك فالنَّارُ النَّارُ",2],"»."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[إسناده صحيح]","bab":"رقائق وزهد › الرياء والسمعة","dorar":"1ZbVtuPG"},{"id":"س-05520","fp":"9f57c8a5a096","stateId":592,"easy":"إذا قرأت القرآن رياءً ← فلك في جهنم وادٍ تستعيذ منه جهنم كل يوم","cause":"للقُرَّاءِ المُرائينَ","result":"إنَّ في جهنَّمَ واديًا تستعيذُ منه كُلَّ يومٍ سبعينَ مرَّةً، أعدَّه اللهُ","explicit":true,"ref":"المصابيح في الأحاديث المتواترة 600","srcLabel":"المصابيح في الأحاديث المتواترة","text":[["إنَّ في جهنَّمَ واديًا تستعيذُ منه كُلَّ يومٍ سبعينَ مرَّةً، أعدَّه اللهُ",2]," ",["للقُرَّاءِ المُرائينَ",1]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"رقائق وزهد › الرياء والسمعة","dorar":"X7921jLv"},{"id":"س-05712","fp":"b7ba260ce27c","stateId":592,"easy":"إذا وطئت على إزارك خيلاء ← تطؤه في النار","cause":"من وُطِيءَ على إزارٍ خُيلاءَ","result":"وُطِئَه في النَّارِ","explicit":true,"repOf":"س-04788","ref":"صحيح الجامع 6592","text":[["من وُطِيءَ على إزارٍ خُيلاءَ ، ",1],["وُطِئَه في النَّارِ",2]],"grade":"صحيح","narrator":"هبيب بن مغفل الغفاري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (15607)، وأبو يعلى (1542)، والطبراني (22/206) (543) باختلاف يسير.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"qEPgQH2S"},{"id":"س-05746","fp":"88ecbe08b9c4","stateId":592,"easy":"إذا كان في قلبك مثقال حبة خردل من كبر ← يكبك الله لوجهك في النار","cause":"مَن كان في قَلبِه مِثقالُ حَبَّةِ خَردَلٍ مِن كِبرٍ","result":"كَبَّه اللهُ لوَجهِه في النَّارِ","explicit":true,"repOf":"س-05720","ref":"تنبيه الغافلين 225","text":["«",["مَن كان في قَلبِه مِثقالُ حَبَّةِ خَردَلٍ مِن كِبرٍ ",1],["كَبَّه اللهُ لوَجهِه في النَّارِ»",2],". وفي رِوايةٍ: «لا يَدخُلُ الجَنَّةَ إنسانٌ في قَلبِه مِثقالُ حَبَّةِ خَردَلٍ مِن كِبرٍ»."],"grade":"صحيح","narrator":"عبد الله بن عمرو","muhaddith":"رجاله رجال الصحيح.","takhrij":"أخرجه الطبراني في ((الشاميين)) (62)، والخرائطي في ((مساويء الأخلاق)) (581)، وأبو نعيم في ((معرفة الصحابة)) (4358) باختلاف يسير.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"RWnYVAeQ"},{"id":"س-07500","fp":"85f2f394211c","stateId":592,"easy":"إذا ظللت تذهب بنفسك (تتكبر) ← تُكتب في الجبارين فيصيبك ما أصابهم","cause":"لا يزالُ الرَّجلُ يذهبُ بنفسِه","result":"حتَّى يُكتَبَ في الجبَّارين فيُصيبَه ما أصابهم","explicit":true,"ref":"الترغيب والترهيب 4/43","srcLabel":"الترمذي","text":[["لا يزالُ الرَّجلُ يذهبُ بنفسِه",1]," ",["حتَّى يُكتَبَ في الجبَّارين فيُصيبَه ما أصابهم",2]],"grade":"صحيح","narrator":"سلمة بن الأكوع","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (2000) واللفظ له، وابن أبي الدنيا في ((التواضع والخمول)) (198)، والطبراني (7/21) (6254)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"6NqGhpUt"},{"id":"س-04215","fp":"c741f9675f74","stateId":592,"easy":"إذا كنت جباراً عنيداً ← فلك في جهنم وادٍ فيه بئر يقال لها هبهب","cause":"كلَّ جَبَّارٍ عَنِيدٍ","result":"إِنَّ في جهنمَ وادِيًا في الوَادِي بِئْرٌ يقالُ لها : هَبْهَبٌ حقٌّ على اللهِ أنْ يُسْكِنَهُ","explicit":true,"similar":["س-06001"],"ref":"الفتح الرباني 11/5425","srcLabel":"الحاكم","text":[["إِنَّ في جهنمَ وادِيًا في الوَادِي بِئْرٌ يقالُ لها : هَبْهَبٌ حقٌّ على اللهِ أنْ يُسْكِنَهُ",2]," ",["كلَّ جَبَّارٍ عَنِيدٍ",1]],"grade":"حسن","narrator":"أبو موسى الأشعري","muhaddith":"إسناده حسن","takhrij":"أخرجه الدارمي (2816)، والطبراني في ((المعجم الأوسط)) (3548)، والحاكم (8765) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"R7Bc9tI5","merged":3,"otherRefs":["هداية الرواة 5/231 (حسن)","الزواجر عن اقتراف الكبائر 2/115 (حسن)"]},{"id":"س-05284","fp":"d11b6f930243","stateId":592,"easy":"إذا قلت «قد قرأنا القرآن فمن أقرأ منا؟» عجباً ← فأولئك وقود النار","cause":"يقولون: قد قرأنا القرآنَ فمن أقرأُ منَّا؟ ومن أفقَهُ منَّا، ومن أعلَمُ منَّا","result":"وأولئك هم وَقودُ النَّارِ","explicit":true,"otherNeedIds":[19],"ref":"سبل الهدى والرشاد 10/131","srcLabel":"الطبراني","text":["«يظهَرُ الدِّينُ حتى يجاوِزَ البِحارَ، وتُخاضُ البِحارُ بالخيلِ في سبيلِ اللهِ، حتى يُرَدَّ الكُفرُ إلى مَوطِنِه، وليأتينَّ على النَّاسِ زمانٌ يتعَلَّمون فيه القُرآنَ يتعلَّمونه ويقرؤونه، ثمَّ ",["يقولون: قد قرأنا القرآنَ فمن أقرأُ منَّا؟ ومن أفقَهُ منَّا، ومن أعلَمُ منَّا",1],"؟»، ثمَّ التفَتَ إلى أصحابِه، فقال: «هل في أولئك من خيرٍ؟» قالوا: لا، قال: «أولئك منكم من هذه الأمَّةِ، ",["وأولئك هم وَقودُ النَّارِ",2],"»"],"grade":"حسن","narrator":"عمر بن الخطاب","muhaddith":"رجاله ثقات","takhrij":"أخرجه البزار (283)، والطبراني في ((الأوسط)) (6242) كلاهما بلفظ مقارب.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"S9WvdyoV","merged":3,"otherRefs":["السلسلة الصحيحة 3230 (حسن)","الترغيب والترهيب 1/105 (حسن)"]},{"id":"س-05500","fp":"eb6e9a4d23b2","stateId":592,"easy":"إذا تعلمت علماً لغير الله أو أردت به غير الله ← فتبوأ مقعدك من النار","cause":"مَنْ تَعَلَّمَ عِلْمًا لغيرِ اللهِ ، أوْ أرادَ بهِ غيرَ اللهِ","result":"فَلْيَتَبَوَّأْ مَقْعَدَهُ مِنَ النارِ","explicit":true,"ref":"سنن الترمذي 2655","srcLabel":"الترمذي","text":[["مَنْ تَعَلَّمَ عِلْمًا لغيرِ اللهِ ، أوْ أرادَ بهِ غيرَ اللهِ ، ",1],["فَلْيَتَبَوَّأْ مَقْعَدَهُ مِنَ النارِ",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن غريب لا نعرفه من حديث أيوب غلا من هذا الوجه","takhrij":"أخرجه الترمذي (2655)، والنسائي في ((السنن الكبرى)) (5910)","bab":"رقائق وزهد › الرياء والسمعة","dorar":"kpMp7GcY","merged":2,"otherRefs":["أحاديث معلة 241 (حسن)"]},{"id":"س-00807","fp":"58d40faf4475","stateId":592,"easy":"إذا كنت جباراً عنيداً ← تلتقطك النار يوم القيامة من الصفوف","cause":"بِكلِّ جبَّارٍ عنيدٍ","result":"فتلتقطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسِمِ، فتجلِسُ بِهم في جَهنَّمَ","explicit":true,"ref":"الدر المنثور 10/111","srcLabel":"الحاكم","text":["عنِ ابنِ عبَّاسٍ قالَ: إذا كانَ يومُ القيامةِ مُدَّتِ الأرضُ مدَّ الأديمِ، وزيدَ في سَعتِها كذا وَكذا، وجمعَ الخلائقُ بصعيدٍ واحدٍ جنُّهمُ وَ إنسُهم، فإذا كانَ ذلِكَ اليومَ قُبِضت هذِهِ السَّماءُ الدُّنيا عن أَهلِها على وجْهِ الأرضِ ولأَهلُ السَّماءِ وحدُهم أَكثرُ من أَهلِ الأرضِ جنِّهم وَ إنسِهم بضِعفٍ، فإذا نُثِروا على وجْهِ الأرض فزعوا إليهِم فيقولون: أفيكم ربُّنا؟ فيفزعونَ من قولِهم ويقولونَ: سبحانَ ربِّنا ليس فينا وهو آتٍ، ثُمَّ تُقاضُ السَّماءُ الثَّانيةُ ولأَهلُ السَّماءِ الثَّانيةِ وحدَهم أَكثرَ من أهل السَّماءِ الدُّنيا، ومن جميعِ أهل الأرضِ بضِعفٍ جنِّهم وَ إنسِهم، فإذا نُثِروا على وجهِ الأرض فزعَ إليهم أهلُ الأرضِ فيقولونَ: أفيكُم ربُّنا؟ فيفزعونَ من قولِهم ويقولونَ: سبحانَ ربِّنا ليسَ فينا وهو آتٍ، ثم تُقاضُ السَّمواتُ سماءً سماءً كلَّما قيضَت سماءٌ عن أهلِها كانت أكثرَ من أهل السَّمواتِ الَّتي تحتَها ومن جميعِ أَهلِ الأرضِ بضِعفٍ، فإذا نُثِروا على أهل الأرضِ يفزعَ إليْهم أَهلُ الأرضِ فيقولونَ لَهم: مثلُ ذلِكَ فيرجعونَ إليهم مثل ذلك حتَّى تقاضَ السَّماءُ السَّابعةُ فلَأَهلُ السَّماءِ السَّابعةِ أَكثرُ من أهلِ ستِّ سمواتٍ ومن جميعِ أهلِ الأرضِ بضِعفٍ، فيجيءُ اللَّهُ فيهم والأممُ جثًى صفوفٌ فينادي منادٍ ستعلمونَ اليومَ من أصحابُ الْكرمِ ليقُمِ الحمَّادونَ للَّهِ على كلِّ حالٍ فيقومونَ فيسرَحونَ إلى الجنَّةِ ثمَّ ينادي الثَّانيةَ ستعلمون اليومَ من أصحابُ الْكرمِ أينَ الَّذينَ كانت تَتَجَافَى جُنُوبُهُمْ عَنِ المَضَاجِعِ يَدْعُونَ رَبَّهُمْ خَوْفًا وَطَمَعًا وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ [السجدة آية: 16] فيقومونَ فيسرَحونَ إلى الجنَّةِ، قالَ: ثمَّ ينادي الثَّالثةَ ستعلمون اليومَ من أصحابُ الْكرَمِ أين الَّذينَ لَا تُلْهِيهِمْ تِجَارَةٌ وَلَا بَيْعٌ عَنْ ذِكْرِ اللَّهِ وَإِقَامِ الصَّلَاةِ وَإِيتَاءِ الزَّكَاةِ يَخَافُونَ يَوْمًا تَتَقَلَّبُ فِيهِ الْقُلُوبُ وَالْأَبْصَارُ [النور آية: 37] فيقومونَ فيسرَحونَ إلى الجنَّةِ فإذا أخذَ كلٌّ من هؤلاءِ ثلاثةٌ خرجَ عنُقٌ منَ النَّارِ فأشرفَ على الخلائقِ لَهُ عينانِ تبصِرانِ ولسانٌ فصيحٌ فيقولُ: إنِّي وُكِّلتُ منكُم بثلاثةٍ ",["بِكلِّ جبَّارٍ عنيدٍ",1]," ",["فتلتقطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسِمِ، فتجلِسُ بِهم في جَهنَّمَ",2]," ثمَّ تخرجُ ثانيةً فتقولُ إنِّي وُكِّلتُ منكُم بمن آذى اللَّهَ تعالى ورسولَهُ، فتلتقِطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسمِ فتُحبَسُ بهم في جهنَّمَ، ثم تخرجُ ثالثةً فتقولُ: إنِّي وُكِّلتُ بأصحابِ التَّصاويرِ فتَلقطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسمِ فتُحبَسُ بِهم في جَهنَّمَ فإذا أُخذَ من هؤلاءِ ثلاثةً ومن هؤلاءِ ثلاثةً نشِرتِ الصُّحفَ ووُضِعتِ الموازينَ ودُعيَ الخلائقُ للحسابِ"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن المبارك في ((الزهد والرقائق)) (2/101) واللفظ له، والحاكم (8699)، والحارث بن أبي أسامة كما في ((بغية الباحث)) (1122) بلفظ مقارب","bab":"أدعية وأذكار › حمد الله في كل الأحوال","dorar":"TsRrl1QY"},{"id":"س-03068","fp":"5590608abc6f","stateId":592,"easy":"إذا تعلمت العلم للمباهاة أو المماراة أو لتصرف الوجوه إليك ← ففي النار","cause":"لا تَعلَّموا العِلمَ لتباهوا بهِ العلماءَ أو لتُماروا بهِ السُّفَهاءَ أو لتصرِفوا وجوهَ النَّاسِ إليكم","result":"فمَن فعلَ ذلِكَ فَهوَ في النَّارِ","explicit":true,"repOf":"س-05519","ref":"صحيح ابن ماجه 210","text":[["لا تَعلَّموا العِلمَ لتباهوا بهِ العلماءَ أو لتُماروا بهِ السُّفَهاءَ أو لتصرِفوا وجوهَ النَّاسِ إليكم",1]," ",["فمَن فعلَ ذلِكَ فَهوَ في النَّارِ",2]],"grade":"حسن","narrator":"حذيفة بن اليمان","muhaddith":"حسن","takhrij":"أخرجه ابن ماجه (259) بلفظه، وابن قانع في ((معجم الصحابة)) (1/ 191)، والخطيب البغدادي في ((الجامع لأخلاق الراوي)) (21) كلاهما باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"RB09h0gH"},{"id":"س-04710","fp":"b26bfb40425e","stateId":592,"easy":"إذا عبدت الله رياءً ← يقال: لم يصعد إلي منه شيء، انطلقوا به إلى النار","cause":"وفرقةٌ تعبدُ اللهَ رياءً","result":"قال : لم يصعدْ إليَّ منه شيءٌ انطلقوا به إلى النارِ","explicit":true,"otherNeedIds":[45],"ref":"البدور السافرة 196","srcLabel":"الطبراني","text":["إذا كان آخرُ الزمانِ صارَتْ أُمتي ثلاثَ فرقٍ : فرقةٌ تعبدُ اللهَ خالصًا ، ",["وفرقةٌ تعبدُ اللهَ رياءً",1]," ، وفرقةٌ يعبدونَ اللهَ ليستأكِلوا به الناسَ ، فإذا جمعَهمُ اللهُ يومَ القيامةِ قال للذي كان يستأكلُ الناسَ : بعزَّتي وجَلالي ما أردْتَ بعبادَتي ؟ فيقولُ : وعزَّتِكَ وجلالِكَ أستأكلُ به الناسَ ، قال : لم ينفعْكَ ما جمعْتَ شيئًا تلجأُ إليه انطلِقوا به إلى النارِ ، ثم يقولُ للذي كان يعبدُ رياءً : بعزَّتي وجلالي ما أردْتَ بعبادتي ؟ قال : بعزتِكَ وجلالِكَ أردْتَ بعبادتِكَ رياءً للناسِ ",["قال : لم يصعدْ إليَّ منه شيءٌ انطلقوا به إلى النارِ",2]," ، ثم يقولُ للذي كان يعبدُهُ خالصًا ، بعزَّتي وجَلالي ما أردْتَ بعبادَتي ؟ قال : بعزتِكَ وجلالِكَ أنتَ أعلمُ بذلكَ مني أردْت به ذِكرَكَ ووجهَكَ ، قال : صدقَ عَبدي انطلِقوا به إلى الجنةِ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (5105)، والبيهقي في ((شعب الإيمان)) (6808) باختلاف يسير.","bab":"رقائق وزهد › الإخلاص","dorar":"ysnCCp7U"},{"id":"س-04711","fp":"2e7f3f577809","stateId":592,"easy":"إذا عبدت الله لتستأكل به الناس ← يقال: لم ينفعك ما جمعت، انطلقوا به إلى النار","cause":"وفرقةٌ يعبدونَ اللهَ ليستأكِلوا به الناسَ","result":"قال : لم ينفعْكَ ما جمعْتَ شيئًا تلجأُ إليه انطلِقوا به إلى النارِ","explicit":true,"ref":"البدور السافرة 196","srcLabel":"الطبراني","text":["إذا كان آخرُ الزمانِ صارَتْ أُمتي ثلاثَ فرقٍ : فرقةٌ تعبدُ اللهَ خالصًا ، وفرقةٌ تعبدُ اللهَ رياءً ، ",["وفرقةٌ يعبدونَ اللهَ ليستأكِلوا به الناسَ",1]," ، فإذا جمعَهمُ اللهُ يومَ القيامةِ قال للذي كان يستأكلُ الناسَ : بعزَّتي وجَلالي ما أردْتَ بعبادَتي ؟ فيقولُ : وعزَّتِكَ وجلالِكَ أستأكلُ به الناسَ ، ",["قال : لم ينفعْكَ ما جمعْتَ شيئًا تلجأُ إليه انطلِقوا به إلى النارِ",2]," ، ثم يقولُ للذي كان يعبدُ رياءً : بعزَّتي وجلالي ما أردْتَ بعبادتي ؟ قال : بعزتِكَ وجلالِكَ أردْتَ بعبادتِكَ رياءً للناسِ قال : لم يصعدْ إليَّ منه شيءٌ انطلقوا به إلى النارِ ، ثم يقولُ للذي كان يعبدُهُ خالصًا ، بعزَّتي وجَلالي ما أردْتَ بعبادَتي ؟ قال : بعزتِكَ وجلالِكَ أنتَ أعلمُ بذلكَ مني أردْت به ذِكرَكَ ووجهَكَ ، قال : صدقَ عَبدي انطلِقوا به إلى الجنةِ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (5105)، والبيهقي في ((شعب الإيمان)) (6808) باختلاف يسير.","bab":"رقائق وزهد › الإخلاص","dorar":"ysnCCp7U"},{"id":"س-05131","fp":"f1bcd642c92e","stateId":592,"easy":"إذا أحببت أن يقوم لك الرجال قياماً ← وجبت لك النار","cause":"مَن أحبَّ أنْ يستجِمَّ له الرِّجالُ قيامًا","result":"وجبَتْ له النَّارُ","explicit":true,"ref":"تخريج مشكل الآثار 1125","srcLabel":"أبو داود","text":[["مَن أحبَّ أنْ يستجِمَّ له الرِّجالُ قيامًا ",1],["وجبَتْ له النَّارُ",2],"."],"grade":"حسن","narrator":"معاوية بن أبي سفيان","muhaddith":"إسناده قوي","takhrij":"أخرجه أبو داود (5229)، والترمذي (2755)، وأحمد (16830) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Ui7QKSSY"},{"id":"س-05295","fp":"bda250c30f87","stateId":592,"easy":"إذا خطبت رياءً وسمعة ← يوقفك الله يوم القيامة موقف رياء وسمعة","cause":"مَن قامَ بخُطبةٍ لا يَلتَمِسُ بها إلَّا رياءً وسُمعةً","result":"أوقَفَه اللهُ عَزَّ وجَلَّ يَومَ القيامةِ مَوقِفَ رياءٍ وسُمعةٍ","explicit":true,"ref":"تخريج المسند لشعيب 16073","srcLabel":"أحمد","text":["«",["مَن قامَ بخُطبةٍ لا يَلتَمِسُ بها إلَّا رياءً وسُمعةً ",1],["أوقَفَه اللهُ عَزَّ وجَلَّ يَومَ القيامةِ مَوقِفَ رياءٍ وسُمعةٍ»",2]],"grade":"حسن","narrator":"بشير بن عقربة","muhaddith":"إسناده حسن","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"fbq687EV"},{"id":"س-04790","fp":"5bc3f6a11bd4","stateId":592,"easy":"إذا كنت عتلاً جوّاظاً مستكبراً ← فأنت من أهل النار","cause":"كُلُّ عُتُلٍّ جَوَّاظٍ مُستَكبِرٍ","result":"ألا أُخبِرُكُم بأهلِ النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-04967","ref":"صحيح مسلم 2853","text":["ألا أُخبِرُكُم بأهلِ الجَنَّةِ؟ قالوا: بَلى، قال صلَّى اللهُ عليه وسلَّم: كُلُّ ضَعيفٍ مُتَضَعِّفٍ، لو أقسَمَ على اللهِ لأبَرَّه، ثُمَّ قال: ",["ألا أُخبِرُكُم بأهلِ النَّارِ",2],"؟ قالوا: بَلى، قال: ",["كُلُّ عُتُلٍّ جَوَّاظٍ مُستَكبِرٍ",1],". وفي روايةٍ: بهذا الإسنادِ بمِثلِه، غيرَ أنَّه قال: ألا أدُلُّكُم."],"grade":"صحيح","narrator":"حارثة بن وهب الخزاعي","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4918)، والترمذي (2605)، وأحمد (18728) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"UwXLp5PX","merged":3,"otherRefs":["تخريج المسند لشعيب 23131 (صحيح)","صحيح الجامع 2594 (صحيح)"]},{"id":"س-02879","fp":"c04b6660a0fa","stateId":592,"easy":"إذا كنت جباراً متكبراً ← تدخل النار","cause":"الجَبَّارون والمُتكَبِّرون","result":"يا رَبِّ، ما لها يَدخُلُها","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"similar":["س-02967"],"ref":"تخريج المسند لشعيب 10588","srcLabel":"متفق عليه","text":["اختصَمَتِ الجنَّةُ والنَّارُ، فقالتِ الجنَّةُ: أي رَبِّ، ما لها يَدخُلُها ضُعفاءُ النَّاسِ وسَقَطُهم؟ وقالت النَّارُ: ",["يا رَبِّ، ما لها يَدخُلُها",2]," ",["الجَبَّارون والمُتكَبِّرون",1],"؟ قال للجنَّةِ: أنتِ رَحمَتي أُصيبُ بكِ مَن أشاءُ، وقال للنَّارِ: أنتِ عَذابي أُصيبُ بكِ مَن أشاءُ، ولكُلِّ واحِدةٍ منكما مِلؤُها. قال: فأمَّا الجنَّةُ؛ فإنَّ اللهَ عزَّ وجلَّ لا يَظلِمُ مِن خَلقِهِ أحدًا، وإنَّه يُنشِئُ لها مِن خَلقِهِ ما شاءَ، وأمَّا النَّارُ؛ فيُلقَوْن فيها، وتَقولُ: هل مِن مَزيدٍ؟ ويُلقَوْن فيها، وتَقولُ: هل مِن مَزيدٍ، حتى يَضَعَ رَبُّنا عزَّ وجلَّ فيها قَدَمَهُ، فهُنالك تَمتَلئُ ويَنزَوي بَعضُها إلى بَعضٍ، وتَقولُ: قَطْ قَطْ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (7449)، ومسلم (2846)، والنسائي في ((السنن الكبرى)) (7740)، وأحمد (10588) واللفظ له","bab":"إيمان › الوعد","dorar":"RBlv8xU3"},{"id":"س-02967","fp":"f255da2dbd77","stateId":592,"easy":"إذا كنت جباراً متكبراً ← تدخل النار","cause":"الجَبابرةُ والمُتكبِّرونَ والمُلوكُ والأشرافُ","result":"يا ربِّ، يَدخُلُني","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-02879","ref":"تخريج المسند لشعيب 11099","text":["\"افتَخَرتِ الجَنَّةُ والنَّارُ، فقالتِ النَّارُ: ",["يا ربِّ، يَدخُلُني",2]," ",["الجَبابرةُ والمُتكبِّرونَ والمُلوكُ والأشرافُ",1],"، وقالتِ الجَنَّةُ: أيْ ربِّ، يَدخُلُني الضُّعَفاءُ والفُقراءُ والمساكينُ، فيقولُ اللهُ تبارَك وتعالى للنَّارِ: أنتِ عَذابي أُصيبُ بكِ مَن أَشاءُ، وقال للجَنَّةِ: أنتِ رَحمَتي وسِعَتْ كلَّ شيءٍ، ولكلِّ واحدةٍ منكما مِلْؤُها، فيُلْقى في النَّارِ أهلُها، فتقولُ: هل من مَزيدٍ؟ قال: ويُلْقى فيها، وتقولُ: هل من مَزيدٍ؟ ويُلْقى فيها، وتقولُ: هل من مَزيدٍ؟ حتى يَأتِيَها تبارَك وتعالى، فيضَعُ قدَمَه عليها فتُزْوى، فتقولُ: قَدِي قَدِي، وأمَّا الجَنَّةُ فيَبْقى فيها أهلُها ما شاء اللهُ أنْ يَبْقى، فيُنشئُ اللهُ لها خَلْقًا ما يَشاءُ\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (11099) واللفظ له، وعبد بن حميد (906)، وأبو يعلى (1313)","bab":"إيمان › الوعيد","dorar":"Ezp3c6FA","merged":7,"otherRefs":["تخريج صحيح ابن حبان 7477 (صحيح)","التمهيد 5/10 (صحيح)","صحيح الجامع 185 (صحيح)","تخريج كتاب السنة 528 (صحيح)","تفسير الطبري 13/2/208 (صحيح)","صحيح مسلم 2846 (صحيح)"]},{"id":"س-07501","fp":"94eab8c91a02","stateId":592,"easy":"إذا أمرت الناس بالبر ونسيت نفسك ← تُقرض شفتك ولسانك","cause":"يَأْمُرُونَ الناسَ بالبرِّ وينسونَ أَنْفُسَهُمْ","result":"تُقْرَضُ ألسنتُهُمْ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"مجمع الزوائد 7/279","srcLabel":"أحمد","text":["أتيتُ ليلَةَ أُسْرِيَ بي علَى رِجالٍ تُقْرَضُ شِفَاهُهُم بمقاريضَ من نارٍ قلْتُ مَنْ هَؤُلَاءِ يَا جبريلُ قال هؤلاءِ خطباءُ أمتِكَ الَّذِينَ ",["يَأْمُرُونَ الناسَ بالبرِّ وينسونَ أَنْفُسَهُمْ",1]," وهم يَتْلُونَ الْكِتابَ أفَلَا يعقِلونَ وفي روايةٍ ",["تُقْرَضُ ألسنتُهُمْ",2]," بِمقَارِيضَ من نارٍ أوْ قال من حديدٍ وفي روايةٍ أتيتُ على سماءِ الدنيا ليلةَ أُسْرِيَ بي فرأَيْتُ فيها رجالًا تُقْطَعُ ألسنتُهم وشفاهُهم . . . ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أحد أسانيد أبي يعلى رجاله رجال الصحيح","takhrij":"أخرجه أحمد (13445)، وأبو يعلى (3992) واللفظ له.\n\nوالرواية: أخرجها أبو يعلى (4160)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"sMWPyD9A","merged":3,"otherRefs":["صحيح الترغيب 125 (صحيح)","السلسلة الصحيحة 291 (صحيح)"]},{"id":"س-01554","fp":"8b34441e91ee","stateId":592,"easy":"إذا اغتررت بعلمك وقلت «من خير منا» ← فأنت من وقود النار","cause":"يقولونَ : قد قرأنا ، وعلِمنا فمَن هذا الَّذي هوَ خيرٌ منَّا","result":"وأولئِكَ هُم وقودُ النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"otherNeedIds":[19],"ref":"عمدة التفسير 1/356","srcLabel":"الطبراني","text":["بينَما نحنُ بمَكَّةَ ، قامَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ منَ اللَّيلِ فَنادى هل بلَّغتُ ، اللَّهمَّ هل بلَّغتُ ، ثلاثًا ، فقامَ عمرُ بنُ الخطَّابِ فقالَ : نعَم ، ثمَّ أصبحَ ، فقالَ النبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ : ليظهَرنَّ الإسلامُ حتَّى يُردَّ الكفرَ إلى مواطنِهِ ، ولتخوضُنَّ البحارَ بالإسلامِ ، وليأتينَّ على النَّاسِ زمانٌ يتعلَّمونَ القرآنَ ويقرئونَهُ ثمَّ ",["يقولونَ : قد قرأنا ، وعلِمنا فمَن هذا الَّذي هوَ خيرٌ منَّا",1]," ، فَهَل في أولئِكَ مِن خيرٍ ؟ قالوا : يا رسولَ اللَّهِ : فمَن أولئِكَ ؟ قالَ : أولئِكَ منكُم ، ",["وأولئِكَ هُم وقودُ النَّارِ",2]],"grade":"صحيح","narrator":"لبابة بنت الحارث أم الفضل","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (12/ 250) (13019)، وابن أبي حاتم في ((تفسيره)) (3229)، والفاكهي في ((أخبار مكة)) (1899) بنحوه.","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"5S0SzdW4","merged":2,"otherRefs":["الترغيب والترهيب 1/105 (حسن)"]},{"id":"س-05486","fp":"9477f681bd27","stateId":592,"easy":"إذا بارزت الله بالعظائم في الخلوة وتصنّعت للناس ← يذيقك الله أليم العذاب","cause":"كُنتُمْ إذا خلوتُمْ بارزتُموني بالعَظائمِ ، وإذا لقيتُمُ النَّاسَ لقيتُموهم مُخبتينَ تراءونَ النَّاسَ بخلافِ ما تُعطوني مِن قلوبِكُم ، هبتُمُ النَّاسَ ولم تَهابوني ، وأجللتُمُ النَّاسَ ولم تجلُّوني ، وترَكْتُمْ للنَّاسِ ، ولم تترُكوني","result":"اليومَ أذيقُكُمُ أليمَ العذابِ معَ ما حُرِمتُمْ منَ الثَّوابِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[45],"ref":"الترغيب والترهيب 1/55","srcLabel":"ابن حبان","text":["يُؤمَرُ يومَ القيامةِ بناسٍ منَ النَّاسِ إلى الجنَّةِ ، حتَّى إذا دنوا منها واستَنشَقوا ريحَها ، ونظروا إلى قصورِها وما أعدَّ اللَّهُ لأَهْلِها فيها نودوا : أنِ اصرِفوهم عَنها ، لا نَصيبَ لَهُم فيها ، فيرجعونَ بحَسرةٍ ما رجعَ الأوَّلونَ بمثلِها فيقولونَ : ربَّنا ، لو أَدخلتَنا النَّارَ قبلَ أن تُريَنا ما أرَيتَنا مِن ثوابِكَ وما أعددتَ فيها لأوليائِكَ كانَ أَهْوَنَ علينا قالَ : ذاكَ أردتُ بِكُم ",["كُنتُمْ إذا خلوتُمْ بارزتُموني بالعَظائمِ ، وإذا لقيتُمُ النَّاسَ لقيتُموهم مُخبتينَ تراءونَ النَّاسَ بخلافِ ما تُعطوني مِن قلوبِكُم ، هبتُمُ النَّاسَ ولم تَهابوني ، وأجللتُمُ النَّاسَ ولم تجلُّوني ، وترَكْتُمْ للنَّاسِ ، ولم تترُكوني",1]," ",["اليومَ أذيقُكُمُ أليمَ العذابِ معَ ما حُرِمتُمْ منَ الثَّوابِ",2]],"grade":"صحيح","narrator":"عدي بن حاتم الطائي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن حبان في ((المجروحين)) (2/416)، والطبراني (17/86) (199)","bab":"رقائق وزهد › الرياء والسمعة","dorar":"jV6l9qSx"},{"id":"س-06001","fp":"1f80c2b8e7e8","stateId":592,"easy":"إذا كنت جباراً ← حق على الله أن يسكنك وادياً في جهنم","cause":"كُلَّ جبارٍ","result":"في جهَنَّمَ وادٍ، وفي الوادي بِئْرٌ يُقالُ له: هَبْ هَبْ، حَقٌّ على اللهِ أنْ يُسكِنَها","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-04215","ref":"المستدرك على الصحيحين 8160","text":["عن مُحَمَّدِ بنَ واسِعٍ الأزْدِيِّ: دَخَلتُ على بلالِ بنِ أبي بُرْدةَ بنِ أبي مُوسى، فقُلْتُ: يا بِلالُ، إنَّ أباكَ حدَّثَني عنْ جَدِّكَ، عنْ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أنَّه قالَ: ",["في جهَنَّمَ وادٍ، وفي الوادي بِئْرٌ يُقالُ له: هَبْ هَبْ، حَقٌّ على اللهِ أنْ يُسكِنَها",2]," ",["كُلَّ جبارٍ",1],"؛ فاتَّقِ اللهَ لا تَسكُنْها."],"grade":"صحيح","narrator":"أبو موسى","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الدارمي (2858)، وأبو يعلى الموصلي (7249)، والعقيلي في ((الضعفاء)) (1/ 134) جميعهم بلفظه.","bab":"رقائق وزهد › تقوى الله","dorar":"UtBV2RM9"},{"id":"س-08146","fp":"2bba675e26c1","stateId":592,"easy":"إذا كنت مختالاً فخوراً ← تلتقطك النار بلسانها","cause":"كلُّ مُختالٍ فَخورٍ","result":"فتلتقطُهُم بلسانِها وتقذِفُهم في جوفِها","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"البدور السافرة 151","srcLabel":"أبو يعلى","text":["إذا جمعَ اللَّهُ النَّاسَ في صعيدٍ واحدٍ يومَ القيامةِ ، أقبلَتِ النَّارُ يركَبُ بعضُها بعضًا وخزنَتُها يَكفُّونَها وَهيَ تقولُ وعزَّةِ ربِّي ليُخلَّيَنَّ بيني وبينَ أزواجي أو لأغشَينَّ النَّاسَ عُنُقًا واحدَةً فيقولونَ ومَن أزواجُك فتقولُ ",["كلُّ مُختالٍ فَخورٍ",1]," ",["فتلتقطُهُم بلسانِها وتقذِفُهم في جوفِها",2]," ، ويَقضي اللَّهُ بينَ العبادِ"],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"رجاله ثقات","takhrij":"أخرجه أبو يعلى (1145) بنحوه","bab":"ملائكة › أعمال الملائكة","dorar":"pgvHJRA1"},{"id":"س-03632","fp":"d918c1e47436","stateId":593,"easy":"إذا ظهر الزنا والربا في قرية ← فقد أحلّوا بأنفسهم عذاب الله","cause":"إذا ظَهَرَ الزِّنا والرِّبا في قريةٍ","result":"فقد أَحَلُّوا بأنفُسِهِم عذابَ اللهِ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 2295","srcLabel":"متفق عليه","text":["نَهى رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ أنْ تُشتَرى الثَّمرةُ حتَّى تَطْعَمَ، وقال: ",["إذا ظَهَرَ الزِّنا والرِّبا في قريةٍ، ",1],["فقد أَحَلُّوا بأنفُسِهِم عذابَ اللهِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (5033) واللفظ له، والبخاري (2246)، ومسلم (1537) مختصرا","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"XxR60PPu","merged":2,"otherRefs":["الترغيب والترهيب 3/265 (حسن)"]},{"id":"س-07300","fp":"762c940adaa9","stateId":593,"easy":"إذا كنت كاسية في الدنيا (متبرجة) ← تكونين عارية يوم القيامة","cause":"كاسيةٍ في الدُّنيا","result":"عاريةٍ يَومَ القيامةِ","explicit":true,"star":true,"ref":"صحيح البخاري 5844","srcLabel":"متفق عليه","text":["استَيقَظَ النَّبيُّ صلَّى اللهُ عليه وسلَّم مِنَ اللَّيلِ وهو يقولُ: لا إلَهَ إلَّا اللهُ، ماذا أُنزِلَ اللَّيلةَ مِنَ الفِتنةِ؟! ماذا أُنزِلَ مِنَ الخَزائِنِ؟! مَن يوقِظُ صَواحِبَ الحُجُراتِ؟ كَم مِن ",["كاسيةٍ في الدُّنيا",1]," ",["عاريةٍ يَومَ القيامةِ",2],"! قال الزُّهريُّ: وكانَت هِندٌ لَها أزرارٌ في كُمَّيها بينَ أصابِعِها."],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"من أفراد البخاري على مسلم","bab":"فتن › ظهور الفتن","dorar":"maCzCWQh"},{"id":"س-04561","fp":"1db8089e4a20","stateId":593,"easy":"إذا شربت المسكر ← عهد على الله أن يسقيك من طينة الخبال","cause":"لمن شربَ المُسْكِرَ","result":"أن يَسقيَهُ من طينةِ الخبالِ","explicit":true,"star":true,"ref":"صحيح النسائي 5725","srcLabel":"مسلم","text":["أنَّ رجلًا مِن جَيشانَ، وجَيشانُ منَ اليمنِ، قدمَ فسألَ رسولَ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ عن شرابٍ يَشربونَهُ بأرضِهِم، منَ الذُّرةِ يقالُ لَهُ المِزرُ، فقالَ النَّبيُّ صلَّى اللَّهُ علَيهِ وسلَّمَ: أمُسكِرٌ هوَ؟، قالَ: نعَم، قالَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ: كلُّ مسكرٍ حرامٌ، إنَّ اللَّهَ عزَّ وجلَّ عَهِدَ ",["لمن شربَ المُسْكِرَ",1],"، ",["أن يَسقيَهُ من طينةِ الخبالِ",2]," قالوا: يا رسولَ اللَّهِ وما طينةُ الخبالِ؟، قالَ: عَرَقُ أَهْلِ النَّارِ أو قالَ: عُصارةُ أَهْلِ النَّارِ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه النسائي (5709) واللفظ له، وأخرجه مسلم (2002) باختلاف يسير.","bab":"جهنم › صفة عذاب أهل النار","dorar":"N32Uayp1"},{"id":"س-06199","fp":"9735e3aa420a","stateId":593,"easy":"إذا لبست خاتم الذهب (للرجال) ← فقد جعلت جمرة من نار في يدك","cause":"خاتَمًا مِن ذَهَبٍ","result":"يَعمِدُ أحَدُكُم إلى جَمرةٍ مِن نارٍ فيَجعَلُها في يَدِه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-06187"],"ref":"صحيح مسلم 2090","srcLabel":"متفق عليه","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم رَأى ",["خاتَمًا مِن ذَهَبٍ",1]," في يَدِ رَجُلٍ، فنَزَعَه فطَرَحَه، وقال: ",["يَعمِدُ أحَدُكُم إلى جَمرةٍ مِن نارٍ فيَجعَلُها في يَدِه",2],"! فقيلَ للرَّجُلِ بَعدَ ما ذَهَبَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: خُذْ خاتِمَكَ انتَفِعْ به، قال: لا واللهِ، لا آخُذُه أبَدًا وقد طَرَحَه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"زينة اللباس › لبس الخاتم","dorar":"9RF11nzd","merged":3,"otherRefs":["فتاوى نور على الدرب لابن عثيمين 11/197 (صحيح)","تخريج صحيح ابن حبان 15 (صحيح)"]},{"id":"ق-0850","fp":"6a00c91c035f","stateId":593,"easy":"حب شيوع الفاحشة في المؤمنين ← عذاب أليم في الدنيا والآخرة","cause":"حب شيوع الفاحشة في المؤمنين","result":"عذاب أليم في الدنيا والآخرة","explicit":true,"star":true,"otherNeedIds":[49],"ref":"سورة النور: 19","srcLabel":"القرآن الكريم","quran":{"s":24,"from":19,"to":19,"text":"إِنَّ الَّذِينَ يُحِبُّونَ أَنْ تَشِيعَ الْفَاحِشَةُ فِي الَّذِينَ آمَنُوا لَهُمْ عَذَابٌ أَلِيمٌ فِي الدُّنْيَا وَالْآخِرَةِ وَاللَّهُ يَعْلَمُ وَأَنْتُمْ لَا تَعْلَمُونَ (19)","hl":[[0,171,1]]}},{"id":"ق-0991","fp":"c3949d0fff6e","stateId":593,"easy":"الفاحشة ممن له مكانة وقدوة ← مضاعفة العذاب","cause":"الفاحشة ممن له مكانة وقدوة","result":"مضاعفة العذاب","explicit":true,"ref":"سورة الأحزاب: 30","srcLabel":"القرآن الكريم","quran":{"s":33,"from":30,"to":30,"text":"يَا نِسَاءَ النَّبِيِّ مَنْ يَأْتِ مِنْكُنَّ بِفَاحِشَةٍ مُبَيِّنَةٍ يُضَاعَفْ لَهَا الْعَذَابُ ضِعْفَيْنِ وَكَانَ ذَلِكَ عَلَى اللَّهِ يَسِيرًا (30)","hl":[[23,144,1]]}},{"id":"س-00197","fp":"42d68565ffa2","stateId":593,"easy":"إذا فجرت ← يهديك الفجور إلى النار","cause":"الفجورِ","result":"يهدي إلى النارِ","explicit":true,"ref":"الجامع الصغير 2591","srcLabel":"ابن ماجه","text":["إِنَّما هما اثنتانِ الكلامُ والهديُ ، فأحسنُ الكلامِ كلامُ اللهِ ، وأحسنُ الهدْيِ هديُ محمدٍ ، ألَا وإيَّاكم ومحدَثاتِ الأمورِ ، فإِنَّ شرَّ الأمورِ مُحْدَثاتُها ، وكُلَّ محدَثَةٍ بدعةٌ ، وكُلَّ بِدْعَةٍ ضلالَةٌ ، ألَا لَا يَطولَنَّ عليكم الأمَدُ فتقسو قلوبُكُم ، ألَا إِنَّ كُلَّ ما هو آتٍ قريبٌ ، وإِنَّما البعيدُ ما ليس بآتٍ ، ألَا إِنَّما الشَّقِيُّ مَنْ شقِيَ في بطنِ أُمِّهِ ، والسعيدُ مَنْ وُعِظَ بِغَيْرِهِ ، ألَا إِنَّ قتالَ المؤمِنِ كفْرٌ ، وسبابَهُ فسوقٌ ، ولَا يَحِلُ لمسلِمٍ أنْ يهجُرَ أخاهُ فوقَ ثلاثٍ ، ألَا وإيَّاكم والكذبَ ، فإِنَّ الكذبَ لا يصلُحُ لَا بالجدِّ ، ولَا بالْهَزْلِ ، ولَا يعِدُ الرجلُ صَبِيَّهُ ولَا يفِي ، وإِنَّ الكذِبَ يهدِي إلى ",["الفجورِ",1]," ، وإِنَّ الفجورَ ",["يهدي إلى النارِ",2]," ، وإِنَّ الصدقَ يهدي إلى البرِ ، وإِنَّ البرَّ يهدي إلى الجنَّةِ ، وإِنَّه يقالُ للصادقِ : صدقَ وبَرَّ ، ويقالُ للكاذِبِ : كذَبَ وفجرَ ، ألَا وإِنَّ العبدَ يكذِبُ حتى يُكْتَبَ عندَ اللهِ كذابًا"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (46) واللفظ له، والطبراني (9/99) (8520) باختلاف يسير، والبيهقي في ((شعب الإيمان)) (4787) مختصراً باختلاف يسير","bab":"آداب الكلام › الصدق وما جاء فيه","dorar":"UhkJzNNf","merged":4,"otherRefs":["صحيح مسلم 2607 (صحيح)","صحيح الأدب المفرد 298 (صحيح)","المستدرك على الصحيحين 445 (صحيح)"]},{"id":"س-00557","fp":"64a0e0f16a04","stateId":593,"easy":"إذا مت مدمناً للخمر ← تلقى الله كعابد وثن","cause":"من مات مُدمِنًا الخَمرَ","result":"لَقِي اللهَ تعالى وهو كعابدِ وَثَنٍ","explicit":true,"similar":["س-03755"],"ref":"المصابيح في الأحاديث المتواترة 622","srcLabel":"المصابيح في الأحاديث المتواترة","text":[["من مات مُدمِنًا الخَمرَ ",1],["لَقِي اللهَ تعالى وهو كعابدِ وَثَنٍ",2]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"آداب عامة › ضرب الأمثال","dorar":"DNbPLnKx","merged":3,"otherRefs":["صحيح الجامع 6549 (صحيح)","البحر الزخار 11/289 (صحيح)"]},{"id":"س-02706","fp":"5aed35e25633","stateId":593,"easy":"إذا مت مدمناً للخمر ← يسقيك الله من نهر الغوطة","cause":"ومَن ماتَ مُدْمِنَ الخَمْرِ","result":"سقاهُ اللهُ مِن نَهْرِ الغُوطةِ","explicit":true,"similar":["س-04566"],"ref":"المستدرك على الصحيحين 7439","srcLabel":"أحمد","text":["ثَلاثةٌ لا يَدخُلونَ الجنَّةَ: مُدْمِنُ الخَمْرِ، وقاطِعُ الرَّحِمِ، ومُصَدِّقٌ بالسِّحْرِ، ",["ومَن ماتَ مُدْمِنَ الخَمْرِ ",1],["سقاهُ اللهُ مِن نَهْرِ الغُوطةِ",2],"، قيل: وما نَهْرُ الغُوطةِ؟ قالَ: نَهْرٌ يَخْرُجُ مِن فُروجِ المُومساتِ، يُؤذي أهْلَ النَّار رِيحُ فُرُوجِهِم."],"grade":"صحيح","narrator":"أبو موسى","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (19569)، وابن حبان (5346)، والمخلص في ((المخلصيات)) (740) جميعهم بلفظه.","bab":"إيمان › السحر والنشرة والكهانة","dorar":"Ze7ME3QW","merged":2,"otherRefs":["مجمع الزوائد 5/77 (حسن)"]},{"id":"س-05166","fp":"1a5f16f5be87","stateId":593,"easy":"إذا لبست جبة محشوة بالحرير (للرجال) ← تكون طوقاً من نار يوم القيامة","cause":"جُبَّةٌ مُجَبِّيَةٌ بحرير","result":"طَوْقٌ من نارٍ يومَ القيامةِ","explicit":true,"ref":"السلسلة الصحيحة 2684","srcLabel":"الطبراني","text":[["طَوْقٌ من نارٍ يومَ القيامةِ",2]," قالهُ لِمَنْ رأى عليهِ ",["جُبَّةٌ مُجَبِّيَةٌ بحرير",1]],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"إسناده صحيح","takhrij":"أخرجه البزار (2659)، والطبراني (20/ 118)، (236) كلاهما بلفظه تاما.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"QAbtLB2j","merged":2,"otherRefs":["تنبيه الغافلين 288 (حسن)"]},{"id":"س-03755","fp":"dc3fd26e4106","stateId":593,"easy":"إذا لقيت الله مدمناً للخمر مستحلاً لها ← تلقاه كعابد وثن","cause":"من لقِيَ اللهَ مُدمنَ خمرٍ مُستحلًّا لشربِه","result":"لقيه كعابدِ وثنٍ","explicit":true,"repOf":"س-00557","ref":"الإلمام بأحاديث الأحكام 2/770","text":[["من لقِيَ اللهَ مُدمنَ خمرٍ مُستحلًّا لشربِه ، ",1],["لقيه كعابدِ وثنٍ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[اشترط في المقدمة أنه] صحيح على طريقة بعض أهل الحديث","takhrij":"أخرجه أحمد (2453)، وعبدالرزاق (17070)، والبزار (5085) باختلاف يسير","bab":"اعتصام بالسنة › من استحل الحرام أو حرم الحلال","dorar":"XATw0oYH"},{"id":"س-04206","fp":"4215ee565a30","stateId":593,"easy":"إذا سقيت الخمر صغيراً لا يعرف حلالها من حرامها ← يسقيك الله من طينة الخبال","cause":"ومَن سَقاهُ صَغيرًا لا يَعرِفُ حَلالَه مِن حَرامِه","result":"كان حَقًّا على اللهِ أنْ يَسقيَه مِن طينةِ الخَبالِ","explicit":true,"ref":"تخريج سنن أبي داود 3680","srcLabel":"البيهقي","text":["عنِ النَّبيِّ صلَّى اللَّهُ عليه وسلَّمَ قال: كُلُّ مُخمَّرٍ خَمرٌ، وكُلُّ مُسكِرٍ حَرامٌ، ومَن شَرِبَ مُسكِرًا بُخِسَتْ صَلاتُه أربَعينَ صَباحًا، فإنْ تابَ تابَ اللهُ عليه، فإنْ عادَ الرَّابِعةَ كان حَقًّا على اللهِ أنْ يَسقيَه مِن طينةِ الخَبالِ. قيل: وما طينةُ الخَبالِ يا رَسولَ اللَّهِ؟ قال: صَديدُ أهلِ النارِ، ",["ومَن سَقاهُ صَغيرًا لا يَعرِفُ حَلالَه مِن حَرامِه، ",1],["كان حَقًّا على اللهِ أنْ يَسقيَه مِن طينةِ الخَبالِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه البيهقي (17807)","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"4Br3CQG3"},{"id":"س-04566","fp":"33989ff444a3","stateId":593,"easy":"إذا مت وأنت تشرب الخمر ← يسقيك الله من طينة الخبال","cause":"لمَن مات وهو يشربُ الخمرَ","result":"أن يسقِيَه من طينةِ الخبالِ ، قيل : يا رسولَ اللهِ وما طينةُ الخبالِ","explicit":true,"repOf":"س-02706","ref":"مجموع فتاوى ابن باز 349/19","text":["إن على اللهِ عهدًا ",["لمَن مات وهو يشربُ الخمرَ",1]," ",["أن يسقِيَه من طينةِ الخبالِ ، قيل : يا رسولَ اللهِ وما طينةُ الخبالِ ؟",2]," قال : عصارةُ أهلِ النارِ أو قال : عرقُ أهلِ النارِ"],"grade":"صحيح","muhaddith":"صحيح","bab":"جهنم › صفة عذاب أهل النار","dorar":"ztSYdnYq"},{"id":"س-05236","fp":"b217b3d3bdb3","stateId":593,"easy":"إذا شربت الخمر بعد تحريمها ← يعطشك الله يوم القيامة","cause":"من شربها بعدما حرَّمتُها","result":"لأُعطِّشَنَّه يومَ القيامةِ","explicit":true,"similar":["س-02943"],"ref":"تفسير القرآن العظيم 3/178","srcLabel":"البيهقي","text":["عن عبدِ اللهِ بنِ عمرو قال إنَّ هذه الآيةَ التي في القرآنِ  يَا أَيُّهَا الَّذِينَ آمَنُوْا إِنَّمَا الْخَمْرُ وَالْمَيْسِرُ وَالْأَنْصَابُ وَالْأَزْلَامُ رِجْسٌ مِنْ عَمَلِ الشَّيْطَانِ فَاجْتَنِبُوهُ لَعَلَّكُمْ تُفْلِحُونَ  قال هيَ في التوراةِ إنَّ اللهَ أنزل الحقَّ ليُذْهِبَ به الباطلَ ويُبْطِلَ به اللعبَ والمزاميرَ والزفنَ والكباراتِ يعني البرابطَ والزماراتِ يعني به الدُّفَّ والطنابيرَ والشِّعْرَ والخمرَ مرةً لمن طعمَها أقسم اللهُ بيمينِه وعِزَّةِ حَيْلِه ",["من شربها بعدما حرَّمتُها",1]," ",["لأُعطِّشَنَّه يومَ القيامةِ",2]," ومن تركها بعدما حرَّمتُها لأسقِيَنَّهُ إياها في حظيرةِ القدسِ"],"grade":"صحيح","narrator":"عطاء بن يسار","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي حاتم في ((تفسيره)) (6744) ، والبيهقي في ((السنن الكبرى)) (21042) بنحوه ، والخطيب البغدادي في ((المتفق والمفترق)) (1665) مطولا .","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"0dlqHhJd"},{"id":"س-06187","fp":"46d1cfae79d0","stateId":593,"easy":"إذا لبست خاتم الذهب (للرجال) ← ففي يدك جمرة من نار","cause":"في يدِه خاتمٌ من ذهبٍ وجُبَّةٌ من حريرٍ","result":"كان في يدِك جمرةٌ من نارٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-06199","otherNeedIds":[12],"ref":"مجمع الزوائد 5/157","text":["أقبل رجلٌ من البحرينِ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فلم يردَّ عليهِ السلامَ وكان ",["في يدِه خاتمٌ من ذهبٍ وجُبَّةٌ من حريرٍ",1]," فانصرف الرجلُ محزونًا فشكا ذلك إلى امرأتِه فقالت له لعلَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ كرَه جُبَّتَك وخاتمَك فألقِهِما فألقاهما ثم غدا إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فردَّ عليه السلامَ فقال يا رسولَ اللهِ أتيتُك آنفًا فأعرضتَ عني قال ",["كان في يدِك جمرةٌ من نارٍ",2]," قال لقد جئتُ إذًا بجمرٍ كثيرٍ قال إنما جئتَ به ليس أغنى عنَّا من حجارةٍ الحرَّةِ ولكنَّهُ متاعُ الحياةِ الدنيا قال فما أتختَّمُ به قال حلقةٌ من ورِقٍ أو حديدٍ أو صفرٍ"],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"[فيه] أبو النجيب وثقه ابن حبان ورجاله ثقات","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (1022)، والنسائي (5206)، والطبراني في ((المعجم الأوسط)) (8664) باختلاف يسير.","bab":"زينة اللباس › إباحة الذهب والحرير للنساء دون الرجال","dorar":"dAPkPz7Q"},{"id":"س-01312","fp":"677be84a1958","stateId":593,"easy":"إذا قعدت على فراش امرأة غاب زوجها ← يقيّض الله لك ثعباناً يوم القيامة","cause":"من قعَدَ على فراشِ مَغِيبةٍ","result":"قَيَّض اللهُ له ثُعبانًا يومَ القيامةِ","explicit":true,"ref":"الجامع الصغير 8945","srcLabel":"أحمد","text":[["من قعَدَ على فراشِ مَغِيبةٍ ",1],["قَيَّض اللهُ له ثُعبانًا يومَ القيامةِ",2]],"grade":"حسن","narrator":"أبو قتادة الحارث بن ربعي","muhaddith":"حسن","takhrij":"أخرجه أحمد (22557) باختلاف يسير، والطبراني (3/241) (3278)، وأبو نعيم في ((معرفة الصحابة)) (2002) واللفظ لهما","bab":"نكاح › حق الزوج على المرأة","dorar":"ySIKqLN6"},{"id":"س-02943","fp":"1271e1a38283","stateId":593,"easy":"إذا شربت الخمر ← تأتي عطشان يوم القيامة","cause":"مَنْ شربَ الخمرَ","result":"أَتى عطشانَ يومَ القيامةِ","explicit":true,"repOf":"س-05236","ref":"الجامع الصغير 8748","text":[["مَنْ شربَ الخمرَ،  ",1],["أَتى عطشانَ يومَ القيامةِ",2]],"grade":"حسن","narrator":"عبدالله بن عمرو وقيس بن سعد","muhaddith":"حسن","takhrij":"أخرجه أحمد (15482)، وأبو يعلى (1436)، وابن وهب في ((الجامع)) (77) بنحوه مطولًا.","bab":"إيمان › الوعيد","dorar":"NcvC8HUC"},{"id":"س-04307","fp":"443a6de3be8c","stateId":593,"easy":"إذا حبست العنب أيام القطاف لتبيعه لمن يتخذه خمراً ← فقد تقحمت النار على بصيرة","cause":"مَن حَبَس العِنَبَ أيَّامَ القِطافِ حتَّى يَبيعَه مِن يَهوديٍّ أو نَصرانيٍّ أو مِمَّن يَتَّخِذُه خَمرًا","result":"فقد تَقَحَّم النَّارَ على بَصيرةٍ","explicit":true,"ref":"الروضة الندية 2/99","srcLabel":"ابن حبان","text":["\"",["مَن حَبَس العِنَبَ أيَّامَ القِطافِ حتَّى يَبيعَه مِن يَهوديٍّ أو نَصرانيٍّ أو مِمَّن يَتَّخِذُه خَمرًا، ",1],["فقد تَقَحَّم النَّارَ على بَصيرةٍ\"",2]],"grade":"حسن","narrator":"بريدة","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((الأوسط)) (5356) واللفظ له، وابن حبان في ((المجروحين)) (1/286)، والبيهقي في ((شعب الإيمان)) (5230) بلفظ مقارب","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"GEpg8FEt"},{"id":"س-04562","fp":"990e12a5a050","stateId":593,"easy":"إذا لبست الديباج (للرجال) ← تكون لبنته من نار","cause":"وعليه جُبَّةٌ لَبِنَتُها دِيباجٌ","result":"لَبِنَةُ من نارٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 5/144","srcLabel":"أحمد","text":["أنه دخل على رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ ",["وعليه جُبَّةٌ لَبِنَتُها دِيباجٌ",1]," فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ",["لَبِنَةُ من نارٍ",2]],"grade":"حسن","narrator":"رجل من الحي","muhaddith":"فيه علي بن عاصم بن صهيب وأنكر عليه كثرة الغلط وتماديه فيه وبقية رجاله ثقات","takhrij":"أخرجه أحمد (20683) واللفظ له.","bab":"جهنم › صفة عذاب أهل النار","dorar":"AmecHDnE"},{"id":"س-07418","fp":"52e81b0ea0e1","stateId":593,"easy":"إذا تزينت للحرام ← تُقرض جلودك بمقاريض من نار","cause":"الَّذين يتزيَّنون للزِّينةِ","result":"تُقرضُ جلودُهم بمقاريضَ من نارٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"الترغيب والترهيب 3/264","srcLabel":"البيهقي","text":["لمَّا عُرِج بي مررتُ برجالٍ ",["تُقرضُ جلودُهم بمقاريضَ من نارٍ",2]," فقلتُ من هؤلاء يا جبريلُ قال ",["الَّذين يتزيَّنون للزِّينةِ",1]," قال ثمَّ مررتُ بجُبٍّ مُنتِنِ الرِّيحِ فسمِعتُ فيه أصواتًا شديدةً فقلتُ من هؤلاء يا جبريلُ قال نساءٌ كنَّ يتزيَّنَّ للزِّينةِ ويفعلن ما لا يحِلُّ لهنَّ"],"grade":"صحيح","narrator":"راشد بن سعد","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الأصم في ((مصنفات أبي العباس الأصم)) (156)، والبيهقي في ((شعب الإيمان))، واللفظ لهما.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"6YFsqtac"},{"id":"س-07419","fp":"1dfc496785b9","stateId":593,"easy":"إذا تزينت المرأة للحرام وفعلت ما لا يحل ← تُعذّب","cause":"نساءٌ كنَّ يتزيَّنَّ للزِّينةِ ويفعلن ما لا يحِلُّ لهنَّ","result":"فسمِعتُ فيه أصواتًا شديدةً","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"الترغيب والترهيب 3/264","srcLabel":"البيهقي","text":["لمَّا عُرِج بي مررتُ برجالٍ تُقرضُ جلودُهم بمقاريضَ من نارٍ فقلتُ من هؤلاء يا جبريلُ قال الَّذين يتزيَّنون للزِّينةِ قال ثمَّ مررتُ بجُبٍّ مُنتِنِ الرِّيحِ ",["فسمِعتُ فيه أصواتًا شديدةً",2]," فقلتُ من هؤلاء يا جبريلُ قال ",["نساءٌ كنَّ يتزيَّنَّ للزِّينةِ ويفعلن ما لا يحِلُّ لهنَّ",1]],"grade":"صحيح","narrator":"راشد بن سعد","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الأصم في ((مصنفات أبي العباس الأصم)) (156)، والبيهقي في ((شعب الإيمان))، واللفظ لهما.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"6YFsqtac"},{"id":"س-05281","fp":"7afe6ab99ba5","stateId":593,"easy":"إذا جلست على فراش المغيبة ← ينهشك أسود من أساود يوم القيامة","cause":"يَجلسُ على فِراشِ المُغيبةِ","result":"مَثَلُ الذي يَنهَشُه أسوَدُ مِن أساوِدِ يَومِ القيامةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"حسن الأسوة بما ثبت في النسوة 532","srcLabel":"حسن الأسوة بما ثبت في النسوة","text":["مَثَلُ الذي ",["يَجلسُ على فِراشِ المُغيبةِ",1]," ",["مَثَلُ الذي يَنهَشُه أسوَدُ مِن أساوِدِ يَومِ القيامةِ",2]],"grade":"حسن","narrator":"عبداللهِ بن عمر","muhaddith":"رواته ثقات","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"SlPqZJUm","merged":2,"otherRefs":["إتحاف الخيرة المهرة 4/ 72 (حسن)"]},{"id":"س-04866","fp":"8f7570e3e19a","stateId":594,"easy":"إذا غبطت فاجراً بنعمة ← فإن له عند الله قاتلاً لا يموت (النار)","cause":"لا تغبِطنَّ فاجِرًا بنعمةٍ","result":"إنَّ لَه عندَ اللَّهِ قاتِلًا لا يموتُ","explicit":true,"star":true,"ref":"هداية الرواة 5/34","srcLabel":"الطبراني","text":[["لا تغبِطنَّ فاجِرًا بنعمةٍ",1]," فإنَّكَ لا تدري ما هوَ لاقٍ بعدَ موتِه ",["إنَّ لَه عندَ اللَّهِ قاتِلًا لا يموتُ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه عبدالله بن المبارك في ((المسند)) (269) واللفظ له، وأخرجه الطبراني في ((المعجم الأوسط)) (4067)، والبيهقي في ((شعب الإيمان)) (4542) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"QKoEB2wZ"},{"id":"س-00254","fp":"2e9e52a96deb","stateId":594,"easy":"إذا كنت هيناً ليناً قريباً سهلاً ← تحرم عليك النار","cause":"قالوا: بلى يا رسولَ اللهِ قال: على كلِّ هيِّنٍ ليِّنٍ قريبٍ سهلٍ","result":"ألَا أُخبِرُكم بمَنْ تحرُمُ عليه النَّارُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح ابن حبان 470","srcLabel":"الترمذي","text":["( ",["ألَا أُخبِرُكم بمَنْ تحرُمُ عليه النَّارُ ) ",2],"؟",[" قالوا: بلى يا رسولَ اللهِ قال: ( على كلِّ هيِّنٍ ليِّنٍ قريبٍ سهلٍ )",1]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الترمذي (2488)، وأحمد (3938) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"4dD4L7kv","merged":3,"otherRefs":["صحيح الترغيب 2676 (صحيح)","صحيح الترمذي 2488 (صحيح)"]},{"id":"س-02531","fp":"dcd5f5c6fda2","stateId":594,"easy":"إذا كنت ضعيفاً لا عزم لك تابعاً لا تبتغي أهلاً ولا مالاً ← فأنت من أهل النار","cause":"الضَّعيفُ الذي لا زَبْرَ له، الذينَ هُم فيكُم تَبَعًا، لا يَبتَغونَ أهلًا ولا مالًا، والخائِنُ الذي لا يَخفى له طَمَعٌ وإن دَقَّ إلَّا خانَه، ورَجُلٌ لا يُصبِحُ ولا يُمسي إلَّا وهو يُخادِعُكَ عن أهلِكَ ومالِكَ","result":"وأهلُ النَّارِ خَمسةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح مسلم 2865","srcLabel":"أبو داود","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال ذاتَ يَومٍ في خُطبَتِه: ألا إنَّ رَبِّي أمَرَني أن أُعَلِّمَكُم ما جَهِلتُم ممَّا عَلَّمَني يَومي هذا: كُلُّ مالٍ نَحَلتُه عَبدًا حَلالٌ، وإنِّي خَلَقتُ عِبادي حُنَفاءَ كُلَّهُم، وإنَّهُم أتَتْهمُ الشَّياطينُ فاجتالَتْهم عن دينِهم، وحَرَّمَت عليهم ما أحلَلتُ لهم، وأمَرَتْهم أن يُشرِكوا بي ما لَم أُنزِلْ به سُلطانًا، وإنَّ اللَّهَ نَظَرَ إلى أهلِ الأرضِ فمَقَتَهُم عَرَبَهُم وعَجَمَهُم إلَّا بَقايا مِن أهلِ الكِتابِ، وقال: إنَّما بَعَثتُكَ لأبتَليَكَ وأبتَليَ بكَ، وأنزَلتُ عليكَ كِتابًا لا يَغسِلُه الماءُ، تَقرَؤُه نائِمًا ويَقظانَ. وإنَّ اللَّهَ أمَرَني أن أُحَرِّقَ قُرَيشًا، فقُلتُ: رَبِّ، إذن يَثلَغوا رَأسي فيَدَعوه خُبزةً! قال: استَخرِجْهم كما استَخرَجوكَ، واغزُهم نُغزِكَ، وأنفِقْ فسَنُنفِقُ عليكَ، وابعَثْ جَيشًا نَبعَث خَمسةً مِثلَه، وقاتِلْ بمَن أطاعَكَ مَن عَصاكَ. قال: وأهلُ الجَنَّةِ ثَلاثةٌ: ذو سُلطانٍ مُقسِطٌ مُتَصَدِّقٌ موفَّقٌ، ورَجُلٌ رَحيمٌ رَقيقُ القَلبِ لكُلِّ ذي قُربى ومُسلِمٍ، وعَفيفٌ مُتَعَفِّفٌ ذو عيالٍ. قال: ",["وأهلُ النَّارِ خَمسةٌ",2],[": الضَّعيفُ الذي لا زَبْرَ له، الذينَ هُم فيكُم تَبَعًا، لا يَبتَغونَ أهلًا ولا مالًا، والخائِنُ الذي لا يَخفى له طَمَعٌ وإن دَقَّ إلَّا خانَه، ورَجُلٌ لا يُصبِحُ ولا يُمسي إلَّا وهو يُخادِعُكَ عن أهلِكَ ومالِكَ،",1]," وذَكَرَ البُخلَ -أوِ الكَذِبَ- والشِّنظيرُ الفَحَّاشُ. [وفي روايةٍ] لَم يُذكَر: وأنفِقْ فسَنُنفِقُ عليكَ. [وفي روايةٍ] لَم يُذكَر: كُلُّ مالٍ نَحَلتُه عَبدًا حَلالٌ. وفي روايةٍ: قامَ فينا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم ذاتَ يَومٍ خَطيبًا، فقال: إنَّ اللَّهَ أمَرَني... وساقَ الحَديثَ. وزادَ فيه: وإنَّ اللَّهَ أوحى إليَّ أن تَواضَعوا حتَّى لا يَفخَرَ أحَدٌ على أحَدٍ، ولا يَبغي أحَدٌ على أحَدٍ، وقال في حَديثِه: وهم فيكُم تَبَعًا، لا يَبغونَ أهلًا ولا مالًا. فقُلتُ [قتادة]: فيَكونُ ذلك يا أبا عبدِ اللهِ؟ قال: نَعَم، واللَّهِ لقد أدرَكتُهم في الجاهِليَّةِ، وإنَّ الرَّجُلَ لَيَرعى على الحَيِّ، ما به إلَّا وليدَتُهم، يَطَؤُها."],"grade":"صحيح","narrator":"عياض بن حمار","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (17484)، وابن حبان (653)، والطبراني في ((المعجم الكبير)) (17/ 358) (987)، وأبو داود الطيالسي (1175)، باختلاف يسير.","bab":"إيمان › أعمال الجن والشياطين","dorar":"wCEWyYoh","merged":2,"otherRefs":["تخريج صحيح ابن حبان 653 (صحيح)"]},{"id":"س-03995","fp":"a388b011d401","stateId":594,"easy":"إذا سرقت فقُطعت ثم تبت ← تسبقك يدك إلى الجنة، وإن عدت تبعتها إلى النار","cause":"إذا قُطِعَتْ يَدُه وَقَعَتْ في النَّارِ، فإن عادَ","result":"تَبِعَها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الأحكام الوسطى 4/ 98","srcLabel":"عبد الرزاق","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قَطَعَ رَجُلًا، ثُمَّ أمَرَ به فحُسِمَ، ثُمَّ قالَ: \"تُبْ إلى اللهِ\"، قالَ: أَتوبُ إلى اللهِ، فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: \"",["إذا قُطِعَتْ يَدُه وَقَعَتْ في النَّارِ، فإن عادَ",1]," ",["تَبِعَها",2],"، وإن تابَ اسْتَشْلاها\".\nقالَ عَبْدُ الرَّزَّاقِ: يقولُ: اسْتَرْجَعَها."],"grade":"صحيح","narrator":"ابن المنكدر","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه عبد الرزاق (13585) واللفظ له","bab":"توبة › الحض على التوبة","dorar":"b6AtCVgU"},{"id":"س-05028","fp":"c3b7e1d72cc9","stateId":595,"easy":"إذا ضاهيت خلق الله (صوّرت) ← تكون من أشد الناس عذاباً يوم القيامة","cause":"عندَ اللَّهِ يومَ القيامةِ، الَّذينَ يُضاهونَ بخلقِ اللَّهِ","result":"أشدُّ النَّاسِ عذابًا","explicit":true,"star":true,"ref":"آداب الزفاف 113","srcLabel":"متفق عليه","text":["دخلَ عليَّ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ، وقد سَترتُ سَهْوةً لي بقِرامٍ فيهِ تماثيلُ ( وفي روايةٍ : فيه الخيلُ ذواتُ الأجنِحَةِ ) فلمَّا رآهُ هتَكَهُ وتلوَّنَ وجهُهُ وقالَ: يا عائشةُ ",["أشدُّ النَّاسِ عذابًا",2],[" عندَ اللَّهِ يومَ القيامةِ، الَّذينَ يُضاهونَ بخلقِ اللَّهِ (",1]," وفي روايةٍ: إنَّ أصحابَ هذِهِ الصُّوَرِ يعذَّبونَ، ويقالُ لَهُم: أحيوا ما خلقتُمْ، ثمَّ قالَ: إنَّ البيتَ الَّذي فيهِ الصُّوَرُ لا تدخلُهُ الملائِكَةُ ) قالَت عائشةُ: فقطَعناهُ فجعَلنا منهُ وسادةً أو وسادتَينِ فقَد رأيتُهُ متكِّئًا علَى إحداهما وفيها صورَةٌ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"أخرجه البخاري ومسلم والزيادة الأخيرة لأحمد سندها على شرط مسلم","takhrij":"أخرجه النسائي (5357)، وأحمد (26146) باختلاف يسير، وأخرجه البخاري (6109)، ومسلم (2107) مختصراً","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"NxSWgRXi","merged":8,"otherRefs":["نخب الافكار 13/458 (صحيح)","تخريج صحيح ابن حبان 5847 (صحيح)","صحيح النسائي 5372 (صحيح)","صحيح البخاري 6109 (صحيح)","صحيح مسلم 2107 (صحيح)","صحيح الجامع 999 (صحيح)","مجموع الفتاوى 29/370 (صحيح)"]},{"id":"س-05106","fp":"56d1151e4382","stateId":595,"easy":"إذا صوّرت صورة في الدنيا ← تُكلّف يوم القيامة أن تنفخ فيها الروح ولست بنافخ","cause":"مَن صوَّرَ صورَةً في الدُّنيا","result":"كُلِّفَ يَومَ القيامَةِ أنْ يَنفُخَ فيها الرُّوحَ، وليس بِنافِخٍ","explicit":true,"star":true,"similar":["س-05243"],"ref":"تخريج المسند لشعيب 3272","srcLabel":"متفق عليه","text":["أنَّه شهِدَ عبدَ اللهِ بنَ عبَّاسٍ أَفتى النَّاسَ، ولا يَذكُرُ في فُتياه رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ حتى جاءَ رَجُلٌ فقال: إنِّي رَجُلٌ عِراقيٌّ، وإنِّي أُصوِّرُ هذه التَّصاويرَ. فقال: ادنُه -مَرَّتَيْنِ أو ثَلاثًا- سمِعتُ محمدًا صلَّى اللهُ عليه وسلَّمَ، -أو قال: سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ- يَقولُ: ",["مَن صوَّرَ صورَةً في الدُّنيا؛ ",1],["كُلِّفَ يَومَ القيامَةِ أنْ يَنفُخَ فيها الرُّوحَ، وليس بِنافِخٍ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (5963)، ومسلم (2110)، والنسائي (5358)، وأحمد (3272) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"nIxHB5no","merged":8,"otherRefs":["تخريج صحيح ابن حبان 5848 (صحيح)","تخريج صحيح ابن حبان 5685 (صحيح)","تخريج المسند لشعيب 10549 (صحيح)","تخريج سنن أبي داود 5024 (صحيح)","صحيح الجامع 6371 (صحيح)","صحيح الجامع 6370 (صحيح)","مجموع الفتاوى 29/370 (صحيح)"]},{"id":"س-02755","fp":"590c6ae0aead","stateId":595,"easy":"إذا صوّرت ← تُعذّب يوم القيامة ويقال: أحيوا ما خلقتم","cause":"أصحابَ هذِهِ الصُّورِ","result":"يُعذَّبونَ يومَ القيامةِ فيقالُ أَحيوا ما خَلقتُمْ","explicit":true,"similar":["س-02721","س-03071","س-04921"],"ref":"نخب الافكار 13/466","srcLabel":"متفق عليه","text":["أنَّها اشترَت نُمرُقَةً فيها تَصاويرُ . فلمَّا رآها رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قامَ علَى البابِ، فلَم يدخُلْ، فعَرفتُ في وجهِهِ الكراهةَ . فقُلتُ: يا رسولَ اللَّهِ، أتوبُ إلى اللَّهِ، وإلى رسولِهِ، فماذا أذنَبتُ ؟ . فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: ما بالُ هذِهِ النُّمرقةِ ؟ قُلتُ: اشتريتُها لَكَ ; لتقعدَ علَيها، وتتوسَّدَها . فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: إنَّ ",["أصحابَ هذِهِ الصُّورِ",1]," ",["يُعذَّبونَ يومَ القيامةِ فيقالُ أَحيوا ما خَلقتُمْ",2]," . ثمَّ قالَ: إنَّ البيتَ الَّذي فيهِ تَصاويرُ لا تدخلُهُ الملائِكَةُ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"طريقه صحيح","takhrij":"أخرجه الطحاوي في ((شرح معاني الآثار)) (6930) واللفظ له، البخاري (2105)، ومسلم (2107) بنحوه.","bab":"إيمان › الملائكة","dorar":"kpMrzvos","merged":2,"otherRefs":["نخب الافكار 13/471 (صحيح)"]},{"id":"س-04234","fp":"73b19d477b48","stateId":595,"easy":"إذا صوّرت ← يعذبك الله بما صوّرت","cause":"المُصوِّرينَ لِما صوَّروا","result":"إنَّ اللهَ يُعذِّبُ","explicit":true,"ref":"تخريج صحيح ابن حبان 5846","srcLabel":"متفق عليه","text":["جاءه رجُلٌ فقال: إنِّي عمِلْتُ هذه التَّصاويرَ قال: فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ( ",["إنَّ اللهَ يُعذِّبُ",2]," ",["المُصوِّرينَ لِما صوَّروا",1]," ) قال: فذهَب الرَّجُلُ وزعَم أنَّ له عيالًا \nقال ابنُ عبَّاسٍ: لا تُصوِّرْ شيئًا فيه رُوحٌ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه البخاري (2225)، ومسلم (2110) بنحوه","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"gmD0vsrE","merged":2,"otherRefs":["صحيح الجامع 1899 (صحيح)"]},{"id":"س-02721","fp":"a24b40a9d096","stateId":595,"easy":"إذا صنعت الصورة ← تُعذّب يوم القيامة ويقال لك: أحيِ ما خلقت","cause":"مَن صَنَعَ الصُّورةَ","result":"يُعَذَّبُ يَومَ القيامةِ، يقولُ: أحيوا ما خَلَقتُم","explicit":true,"repOf":"س-02755","ref":"صحيح البخاري 3224","text":["حَشَوتُ للنَّبيِّ صلَّى اللهُ عليه وسلَّم وِسادةً فيها تَماثيلُ كَأنَّها نُمرُقةٌ، فجاءَ فقامَ بينَ البابَينِ وجَعَلَ يَتَغَيَّرُ وجهُه، فقُلتُ: ما لَنا يا رَسولَ اللهِ؟ قال: ما بالُ هذه الوِسادةِ؟ قالت: وِسادةٌ جَعَلتُها لكَ لتَضطَجِعَ عليها، قال: أما عَلِمتِ أنَّ المَلائِكةَ لا تَدخُلُ بَيتًا فيه صورةٌ، وأنَّ ",["مَن صَنَعَ الصُّورةَ",1]," ",["يُعَذَّبُ يَومَ القيامةِ، يقولُ: أحيوا ما خَلَقتُم",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3224)، ومسلم (2107)","bab":"إيمان › الملائكة","dorar":"EYTuErUP"},{"id":"س-03071","fp":"8495f24df594","stateId":595,"easy":"إذا صنعت الصور ← تُعذّب يوم القيامة ويقال: أحيوا ما خلقتم","cause":"مَن صَنَعَ الصُّوَرَ","result":"يُعَذَّبُ يَومَ القِيامَةِ فيُقالُ : أحْيُوا ما خَلَقْتُمْ","explicit":true,"repOf":"س-02755","ref":"صحيح الجامع 1330","text":["أمَا عَلِمتَ أنَّ الملائِكةَ لا تَدخُلُ بيتًا فيه صُورةٌ و أنَّ ",["مَن صَنَعَ الصُّوَرَ",1]," ",["يُعَذَّبُ يَومَ القِيامَةِ فيُقالُ : أحْيُوا ما خَلَقْتُمْ",2]," ؟"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه البخاري (3224)، ومسلم (2107) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"YHXL8Hay"},{"id":"س-04179","fp":"0a9c4fe4da72","stateId":595,"easy":"إذا صوّرت ← تكون من أشد أهل النار عذاباً","cause":"المصورينَ","result":"إنَّ من أشدِّ أهلِ النارِ عذابًا يومَ القيامةِ","explicit":true,"ref":"تخريج المسند لشاكر 6/59","srcLabel":"متفق عليه","text":[["إنَّ من أشدِّ أهلِ النارِ عذابًا يومَ القيامةِ",2]," ",["المصورينَ",1]," وقال وكيعٌ : أشدُّ الناسِ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (5950)، ومسلم (2109) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"tE9wlu76"},{"id":"س-04265","fp":"7d48f927b443","stateId":595,"easy":"إذا صوّرت ← ففي النار، ويُجعل لك بكل صورة نفس تعذبك","cause":"كلُّ مُصوِّرٍ","result":"في النَّارِ ، يُجْعَلُ له بكلِّ صورةٍ صوَّرها نفسٌ فتُعذِّبُه في جهنَّمَ","explicit":true,"ref":"صحيح الجامع 4554","srcLabel":"متفق عليه","text":[["كلُّ مُصوِّرٍ",1]," ",["في النَّارِ ، يُجْعَلُ له بكلِّ صورةٍ صوَّرها نفسٌ فتُعذِّبُه في جهنَّمَ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2110) واللفظ له، وأخرجه البخاري (2225) بنحوه","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"IX4Vq6iV"},{"id":"س-04921","fp":"5c410617d80e","stateId":595,"easy":"إذا صوّرت صورة ← يقال لك يوم القيامة: أحيِ ما خلقت","cause":"لا يُصوِّرُ عبدٌ صورَةً","result":"إلَّا قيلَ له يَومَ القيامَةِ: أحْيِ ما خَلَقتَ","explicit":true,"repOf":"س-02755","ref":"تخريج المسند لشعيب 6241","text":[["لا يُصوِّرُ عبدٌ صورَةً",1]," ",["إلَّا قيلَ له يَومَ القيامَةِ: أحْيِ ما خَلَقتَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5951)، ومسلم (2108)، والنسائي (5361) بنحوه، وأحمد (6241) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"EcTTaUV3"},{"id":"س-05243","fp":"bdfa3b4d1942","stateId":595,"easy":"إذا صوّرت صورة ← تُكلّف أن تنفخ فيها ولست بنافخ","cause":"مَن صَوَّرَ صورَةً","result":"عُذِّبَ -وقال حَفْصٌ مرَّةً: - كُلِّفَ أنْ يَنْفُخَ فيها، وليس بِنافِخٍ","explicit":true,"repOf":"س-05106","ref":"تخريج المسند لشعيب 6326","text":[["مَن صَوَّرَ صورَةً",1]," ",["عُذِّبَ -وقال حَفْصٌ مرَّةً: - كُلِّفَ أنْ يَنْفُخَ فيها، وليس بِنافِخٍ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"المرفوع منه صحيح","takhrij":"أخرجه أحمد (6326)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"EupNUz2A"},{"id":"س-00809","fp":"98d533ca1574","stateId":595,"easy":"إذا صوّرت ← تلتقطك النار من الصفوف","cause":"بأصحابِ التَّصاويرِ","result":"فتَلقطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسمِ فتُحبَسُ بِهم في جَهنَّمَ","explicit":true,"ref":"الدر المنثور 10/111","srcLabel":"الحاكم","text":["عنِ ابنِ عبَّاسٍ قالَ: إذا كانَ يومُ القيامةِ مُدَّتِ الأرضُ مدَّ الأديمِ، وزيدَ في سَعتِها كذا وَكذا، وجمعَ الخلائقُ بصعيدٍ واحدٍ جنُّهمُ وَ إنسُهم، فإذا كانَ ذلِكَ اليومَ قُبِضت هذِهِ السَّماءُ الدُّنيا عن أَهلِها على وجْهِ الأرضِ ولأَهلُ السَّماءِ وحدُهم أَكثرُ من أَهلِ الأرضِ جنِّهم وَ إنسِهم بضِعفٍ، فإذا نُثِروا على وجْهِ الأرض فزعوا إليهِم فيقولون: أفيكم ربُّنا؟ فيفزعونَ من قولِهم ويقولونَ: سبحانَ ربِّنا ليس فينا وهو آتٍ، ثُمَّ تُقاضُ السَّماءُ الثَّانيةُ ولأَهلُ السَّماءِ الثَّانيةِ وحدَهم أَكثرَ من أهل السَّماءِ الدُّنيا، ومن جميعِ أهل الأرضِ بضِعفٍ جنِّهم وَ إنسِهم، فإذا نُثِروا على وجهِ الأرض فزعَ إليهم أهلُ الأرضِ فيقولونَ: أفيكُم ربُّنا؟ فيفزعونَ من قولِهم ويقولونَ: سبحانَ ربِّنا ليسَ فينا وهو آتٍ، ثم تُقاضُ السَّمواتُ سماءً سماءً كلَّما قيضَت سماءٌ عن أهلِها كانت أكثرَ من أهل السَّمواتِ الَّتي تحتَها ومن جميعِ أَهلِ الأرضِ بضِعفٍ، فإذا نُثِروا على أهل الأرضِ يفزعَ إليْهم أَهلُ الأرضِ فيقولونَ لَهم: مثلُ ذلِكَ فيرجعونَ إليهم مثل ذلك حتَّى تقاضَ السَّماءُ السَّابعةُ فلَأَهلُ السَّماءِ السَّابعةِ أَكثرُ من أهلِ ستِّ سمواتٍ ومن جميعِ أهلِ الأرضِ بضِعفٍ، فيجيءُ اللَّهُ فيهم والأممُ جثًى صفوفٌ فينادي منادٍ ستعلمونَ اليومَ من أصحابُ الْكرمِ ليقُمِ الحمَّادونَ للَّهِ على كلِّ حالٍ فيقومونَ فيسرَحونَ إلى الجنَّةِ ثمَّ ينادي الثَّانيةَ ستعلمون اليومَ من أصحابُ الْكرمِ أينَ الَّذينَ كانت تَتَجَافَى جُنُوبُهُمْ عَنِ المَضَاجِعِ يَدْعُونَ رَبَّهُمْ خَوْفًا وَطَمَعًا وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ [السجدة آية: 16] فيقومونَ فيسرَحونَ إلى الجنَّةِ، قالَ: ثمَّ ينادي الثَّالثةَ ستعلمون اليومَ من أصحابُ الْكرَمِ أين الَّذينَ لَا تُلْهِيهِمْ تِجَارَةٌ وَلَا بَيْعٌ عَنْ ذِكْرِ اللَّهِ وَإِقَامِ الصَّلَاةِ وَإِيتَاءِ الزَّكَاةِ يَخَافُونَ يَوْمًا تَتَقَلَّبُ فِيهِ الْقُلُوبُ وَالْأَبْصَارُ [النور آية: 37] فيقومونَ فيسرَحونَ إلى الجنَّةِ فإذا أخذَ كلٌّ من هؤلاءِ ثلاثةٌ خرجَ عنُقٌ منَ النَّارِ فأشرفَ على الخلائقِ لَهُ عينانِ تبصِرانِ ولسانٌ فصيحٌ فيقولُ: إنِّي وُكِّلتُ منكُم بثلاثةٍ بِكلِّ جبَّارٍ عنيدٍ فتلتقطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسِمِ، فتجلِسُ بِهم في جَهنَّمَ ثمَّ تخرجُ ثانيةً فتقولُ إنِّي وُكِّلتُ منكُم بمن آذى اللَّهَ تعالى ورسولَهُ، فتلتقِطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسمِ فتُحبَسُ بهم في جهنَّمَ، ثم تخرجُ ثالثةً فتقولُ: إنِّي وُكِّلتُ ",["بأصحابِ التَّصاويرِ",1]," ",["فتَلقطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسمِ فتُحبَسُ بِهم في جَهنَّمَ",2]," فإذا أُخذَ من هؤلاءِ ثلاثةً ومن هؤلاءِ ثلاثةً نشِرتِ الصُّحفَ ووُضِعتِ الموازينَ ودُعيَ الخلائقُ للحسابِ"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن المبارك في ((الزهد والرقائق)) (2/101) واللفظ له، والحاكم (8699)، والحارث بن أبي أسامة كما في ((بغية الباحث)) (1122) بلفظ مقارب","bab":"أدعية وأذكار › حمد الله في كل الأحوال","dorar":"TsRrl1QY"},{"id":"س-04949","fp":"4826462fa521","stateId":596,"easy":"إذا ظللت تسأل الناس ← تأتي يوم القيامة وليس في وجهك مزعة لحم","cause":"لا يَزالُ الرَّجُلُ يسأَلُ النَّاسَ","result":"حتى يأْتيَ يومَ القِيامةِ وليْسَ في وجهِهِ مُزْعةُ لحْمٍ","explicit":true,"star":true,"ref":"تخريج مشكل الآثار 1022","srcLabel":"متفق عليه","text":[["لا يَزالُ الرَّجُلُ يسأَلُ النَّاسَ",1]," ",["حتى يأْتيَ يومَ القِيامةِ وليْسَ في وجهِهِ مُزْعةُ لحْمٍ",2],"، وقال: إنَّ الشَّمسَ تَدْنو حتى يبلُغَ العَرَقُ نِصفَ الأُذُنِ، فبَيْنا هُم كذلك، استَغاثوا بآدَمَ صلَّى اللهُ عليه وسلَّمَ فيقولُ: لسْتُ صاحبَ ذاكَ، ثمَّ بموسى صلَّى اللهُ عليه وسلَّمَ، فيقولُ ذلك، ثمَّ بمحمَّدٍ صلَّى اللهُ عليه وعليهم أجمَعينَ فيَشفَعُ لِيقُضَى بيْنَ الخَلْقِ، فيَمْشي حتى يأخُذَ بحَلْقةِ الجَنَّةِ، فيَومَئِذٍ يبعَثُهُ اللهُ مَقامًا محمودًا، يحمَدُهُ أهلُ الجَمعِ كلُّهم."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1474، 1475) باختلاف يسير، ومسلم (1040) مختصراً باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"7v5iODoE","merged":5,"otherRefs":["مسند عمر 1/15 (صحيح)","صحيح النسائي 2584 (صحيح)","حلية الأولياء 3/192 (صحيح)","صحيح مسلم 1040 (صحيح)"]},{"id":"س-04239","fp":"800629cc3468","stateId":596,"easy":"إذا سألت الناس بلا حاجة فخرجت بها ← فما هي لك إلا نار","cause":"لَيسأَلُني المَسأَلةَ، فأُعْطيها إيَّاه، فيَخرُجُ بها مُتَأَبِّطُها","result":"وما هي لهم إلَّا نارٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-05013"],"ref":"تخريج المسند لشعيب 11123","srcLabel":"البخاري","text":["قال عمرُ: يا رسولَ اللهِ، سمِعْتُ فُلانًا يقولُ خَيرًا، ذكَر أنَّكَ أَعطَيْتَه دينارَيْنِ، قال: \"لكنْ فُلانٌ لا يقولُ ذلك، ولا يُثْني به، لقد أَعطَيْتُه ما بيْنَ العَشَرةِ إلى المِئَةِ -أو قال: إلى المِئَتيْنِ- وإنَّ أَحَدَهم ",["لَيسأَلُني المَسأَلةَ، فأُعْطيها إيَّاه، فيَخرُجُ بها مُتَأَبِّطُها",1],"، ",["وما هي لهم إلَّا نارٌ",2],"\"، قال عمرُ: يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فلمَ تُعْطيهم؟ قال: \"إنَّهم يأبَوْنَ إلَّا أنْ يَسأَلوني، ويأْبى اللهُ لي البُخْلَ\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه أحمد (11123) واللفظ له، والبزار (224)، وأبو يعلى (1327)","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"VQcCCCeA","merged":6,"otherRefs":["مسند عمر 1/3 (صحيح)","الترغيب والترهيب 2/48 (صحيح)","المستدرك على الصحيحين 144 (صحيح)","تخريج مشكل الآثار 5936 (صحيح)","صحيح ابن حبان 3265 (صحيح)"]},{"id":"س-04301","fp":"568dda8ea46f","stateId":596,"easy":"إذا سألت عن ظهر غنى ← استكثرت بها من رضف جهنم","cause":"مَن سألَ مَسْألةً عن ظَهْرِ غِنًى","result":"اسْتَكْثَرَ بها مِن رَضْفِ جَهَنَّمَ","explicit":true,"star":true,"similar":["س-03056","س-05224","س-02993"],"ref":"الأحاديث المختارة 519","srcLabel":"البخاري","text":["«",["مَن سألَ مَسْألةً عن ظَهْرِ غِنًى",1]," ",["اسْتَكْثَرَ بها مِن رَضْفِ جَهَنَّمَ",2],"، قالوا: ما ظَهْرُ غِنًى؟ قالَ: عَشاءٌ»."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"emjn9sZf"},{"id":"س-03056","fp":"2bd16ed20500","stateId":596,"easy":"إذا سألت وأنت تجد غنى ← فإنما تستكثر من النار","cause":"مَن سألَ مسألةً، وَهوَ يجدُ عنها غَناءً","result":"فإنَّما يستَكْثرُ منَ النَّارِ","explicit":true,"repOf":"س-04301","ref":"صحيح ابن خزيمة 2391","text":[["مَن سألَ مسألةً، وَهوَ يجدُ عنها غَناءً ",1],["فإنَّما يستَكْثرُ منَ النَّارِ ",2],". قيلَ يا رسولَ اللَّهِ وما الغَناءُ الَّذي لا ينبغي معَهُ المسألةُ ؟ قالَ : أن يَكونَ لهُ شِبعُ يومٍ وليلةٍ أو ليلةٍ ويومٍ ."],"grade":"صحيح","narrator":"سهل ابن الحنظلية الأنصاري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أبو عبيد في ((الأموال)) (1737) باختلاف يسير، وأبو داود (1629)، وأحمد (17625) مطولًا.","bab":"إيمان › الوعيد","dorar":"JN6Mc5Ax"},{"id":"س-03089","fp":"cca8bd6b7d85","stateId":596,"easy":"إذا سألت الناس ولك ما يغنيك ← تأتي يوم القيامة ومسألتك في وجهك خموش","cause":"مَن سَألَ الناسَ ولَه ما يُغنِيهِ","result":"جاءَ يَومَ القيامةِ ومسألَتُه في وَجهِه خُموشٌ، أو خُدوشٌ، أو كُدوحٌ","explicit":true,"similar":["س-02995","س-03076","س-03077","س-06211","س-06212","س-02974"],"ref":"تخريج شرح السنة 1600","srcLabel":"أبو داود","text":[["مَن سَألَ الناسَ ولَه ما يُغنِيهِ",1],"، ",["جاءَ يَومَ القيامةِ ومسألَتُه في وَجهِه خُموشٌ، أو خُدوشٌ، أو كُدوحٌ",2],". قيلَ: يا رَسولَ اللهِ، وما يُغنِيهِ؟ قال: خَمسونَ دِرهمًا أو قيمَتُها مِنَ الذَّهَبِ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1626)، والترمذي (650) واللفظ له، والنسائي (2592)","bab":"إيمان › الوعيد","dorar":"UPOykHt7","merged":6,"otherRefs":["صحيح أبي داود 1626 (صحيح)","مسند عمر 1/23 (صحيح)","صحيح النسائي 2591 (صحيح)","السلسلة الصحيحة 499 (صحيح)","صحيح ابن ماجه 1502 (صحيح)"]},{"id":"س-02929","fp":"74619a75b858","stateId":596,"easy":"إذا سألت الناس من غير فقر ← فكأنما تأكل الجمر","cause":"من سأل من فقرٍ","result":"فكأنما يأكلُ الجمرَ","explicit":true,"similar":["س-02937"],"otherNeedIds":[3],"ref":"الزواجر عن اقتراف الكبائر 1/184","srcLabel":"الزواجر عن اقتراف الكبائر","text":[["من سأل من فقرٍ",1]," ",["فكأنما يأكلُ الجمرَ",2]," ، وفي روايةِ البيهقيِّ : الذي يسألُ الناسَ من غيرِ حاجةٍ كمثلِ الذي يلتقطُ الجمرَ"],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"إيمان › الوعيد","dorar":"8NFkPC8S","merged":5,"otherRefs":["صحيح ابن خزيمة 4/ 168 (صحيح)","تخريج المسند لشعيب 17509 (صحيح)","تخريج صحيح ابن حبان 3393 (صحيح)","تخريج المسند لشعيب 7163 (صحيح)"]},{"id":"س-05233","fp":"ede867d3b438","stateId":596,"easy":"إذا أخلقت وجهك بالسؤال ← تأتي وليس في وجهك مزعة لحم","cause":"أَخلقُوها بالسؤالِ","result":"ليستْ في وجوهِهمْ مُزعةٌ مِنْ لحمٍ","explicit":true,"ref":"النوافح العطرة 285","srcLabel":"متفق عليه","text":["ليجيئنَّ أقوامٌ يومَ القيامةِ ",["ليستْ في وجوهِهمْ مُزعةٌ مِنْ لحمٍ",2]," قدْ ",["أَخلقُوها بالسؤالِ",1]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن","takhrij":"أخرجه الطبراني (12/310) (13207) دون قوله: \"بالسؤال\"، وأصله في صحيح البخاري (1474)، ومسلم (1040)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"P7m4xMDc"},{"id":"س-00472","fp":"a7e9c92ede52","stateId":596,"easy":"إذا سألت وعندك ما يغنيك ← فإنما تستكثر من نار جهنم","cause":"مَن سَألَ وعنْدَه ما يُغْنيه","result":"فإنَّما يَسْتكثِرُ مِن نارِ جَهَنَّمَ","explicit":true,"ref":"الصحيح المسند 461","srcLabel":"الصحيح المسند","text":["أنَّ عُيَيْنةَ والأَقرَعَ سَألا رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ شَيئًا، فأمَرَ مُعاوِيةَ أن يَكتُبَ به لهما، ففَعَلَ، وخَتَمَها رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، وأمَرَ بدَفْعِه إليهما، فأمَّا عُيَيْنةُ فقالَ: ما فيه؟ قالَ: فيه الَّذي أمَرْتَ به، فقَبِلَه وعَقَدَه في عِمامتِه، وكانَ أَحكَمَ الرَّجُلَينِ، وأمَّا الأَقرَعُ فقالَ: أَحمِلُ صَحيفةً لا أَدْري ما فيها، كصَحيفةِ المُتَلَمِّسِ؟ فأَخبَرَ مُعاوِيةُ رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ بقَوْلِهما، وخَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ في حاجتِه، فمَرَّ ببَعيرٍ مُناخٍ على بابِ المَسجِدِ مِن أوَّلِ النَّهارِ، ثُمَّ مَرَّ به آخِرَ النَّهارِ وهو على حالِه، فقالَ: أين صاحِبُ هذا البَعيرِ؟ فابْتُغِيَ، فلم يوجَدْ، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ: اتَّقوا اللهَ في هذه البَهائِمِ، ثُمَّ ارْكَبوها صِحاحًا، وارْكَبوها سِمانًا، كالمُتَسخِّطِ آنِفًا، إنَّه ",["مَن سَألَ وعنْدَه ما يُغْنيه، ",1],["فإنَّما يَسْتكثِرُ مِن نارِ جَهَنَّمَ",2],"، قالوا يا رَسولَ اللهِ: وما يُغْنيه؟ قالَ: ما يُغَدِّيه أو يُعَشِّيه."],"grade":"صحيح","narrator":"سهل ابن الحنظلية الأنصاري","muhaddith":"صحيح","bab":"آداب عامة › الرفق بالحيوان والطير ونحوهما","dorar":"FsqHGIcm","merged":3,"otherRefs":["صحيح الترغيب 805 (صحيح)","صحيح أبي داود 1629 (صحيح)"]},{"id":"س-02995","fp":"4a7e5a5e1985","stateId":596,"easy":"إذا سألت مسألة وأنت عنها غني ← تأتي يوم القيامة كدوحاً في وجهك","cause":"من سأل مسألةً وهو عنها غَنِيٌّ","result":"جاءت يومَ القيامةِ كُدُوحًا في وجهِه","explicit":true,"repOf":"س-03089","ref":"تخريج المسند لشاكر 6/200","text":[["من سأل مسألةً وهو عنها غَنِيٌّ",1]," ",["جاءت يومَ القيامةِ كُدُوحًا في وجهِه",2]," ولا تَحِلُّ الصدقةُ لمن له خمسونَ درهمًا أو عِوضُها من الذهبِ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1626)، والترمذي (650)، والنسائي (2592)، وابن ماجه (1840)، وأحمد (4440) واللفظ له","bab":"إيمان › الوعيد","dorar":"6PdEQMZq","merged":3,"otherRefs":["عمدة القاري 9/71 (صحيح)","صحيح الترغيب 800 (صحيح)"]},{"id":"س-03075","fp":"d1afdd8c638d","stateId":596,"easy":"إذا سألت الناس ← فالمسائل كدّ تكدّ بها وجهك","cause":"المَسَائِلَ","result":"كَدٌّ يكدُّ بها الرجلُ وجهَه","explicit":true,"ref":"مسند عمر 1/16","srcLabel":"الترمذي","text":["عن سَمُرةَ بنِ جُندبٍ قال قال رسولُ اللهِ صلَّى اللهُ عليهِ وسلمَ  إنَّ ",["المَسَائِلَ",1]," ",["كَدٌّ يكدُّ بها الرجلُ وجهَه",2]," إلا أن يسألَ ذا سلطانٍ أو في أمرٍ لا بُدَّ منه قال وقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلمَ  مسألةُ الرجلِ شَينٌ يومَ القيامةِ في وجهِه خدوشٌ أو كدوحٌ"],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (681)، والنسائي (2600)، وأحمد (20106) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"sIyNMl6o","merged":3,"otherRefs":["حلية الأولياء 7/418 (صحيح)","تخريج المسند لشعيب 20219 (صحيح)"]},{"id":"س-03054","fp":"da7613faa0e3","stateId":596,"easy":"إذا سألت الناس لتثري مالك ← فإنما هو جمر من النار","cause":"مَنْ سألَ الناسَ لِيُثْرِيَ مالهُ","result":"فإنَّما هو رَضْفٌ مِنَ النارِ يَتَلَهَّبُهُ","explicit":true,"similar":["س-03081"],"ref":"صحيح الموارد 703","srcLabel":"ابن حبان","text":[["مَنْ سألَ الناسَ لِيُثْرِيَ مالهُ ؛ ",1],["فإنَّما هو رَضْفٌ مِنَ النارِ يَتَلَهَّبُهُ ، ",2],"مَنْ شاءَ فَلِيُقِلَّ ، ومَنْ شاءَ فَلِيُكْثِرْ"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن حبان (3391) واللفظ له، وتمام في ((الفوائد)) (1771)، وابن عساكر في ((تاريخ دمشق)) (52/48)","bab":"إيمان › الوعيد","dorar":"kpfjJ6ue","merged":2,"otherRefs":["مسند الفاروق 1/254 (صحيح)"]},{"id":"س-03086","fp":"c7f7747a9bb1","stateId":596,"easy":"إذا سألت بلا حاجة نزلت بك ← تأتي يوم القيامة وليس على وجهك مزعة لحم","cause":"مَن سأَل في غيرِ حاجةٍ نزَلَتْ به أو عِيالٍ لا يُطيقُهم","result":"جاء يومَ القيامةِ ووَجْهُه ليس عليه مُزْعَةُ لَحْمٍ","explicit":true,"ref":"الضعفاء الكبير 1/214","srcLabel":"البيهقي","text":[["مَن سأَل في غيرِ حاجةٍ نزَلَتْ به أو عِيالٍ لا يُطيقُهم",1],"، ",["جاء يومَ القيامةِ ووَجْهُه ليس عليه مُزْعَةُ لَحْمٍ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"يروى بغير هذا اللفظ من وجه ثابت","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (3526)، والطبري في ((تهذيب الآثار-مسند عمر)) (21) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"K6gKtlqq","merged":2,"otherRefs":["الترغيب والترهيب 2/32 (صحيح)"]},{"id":"س-03090","fp":"9d02939adcbd","stateId":596,"easy":"إذا سألت الناس لتثري مالك ← تكون خموشاً في وجهك ورضفاً تأكله من جهنم","cause":"ومَن سألَ الناسَ لِيُثريَ به مالَه","result":"كانَ خُموشًا في وَجهِه يَومَ القيامةِ، ورَضْفًا يأكُلُه مِن جَهنَّمَ","explicit":true,"otherNeedIds":[3],"ref":"تخريج شرح السنة 1623","srcLabel":"الترمذي","text":["سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ في حَجَّةِ الوَداعِ وهو واقِفٌ بعَرَفةَ، أتاه أعرابيٌّ، فأخَذَ بطَرفِ رِدائِه، فسألَه إيَّاه، فأَعْطاه وذهَبَ، فعِندَ ذلك حُرِّمَتِ المَسألةُ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّ المَسألةَ لا تَحِلُّ لِغَنيٍّ، ولا لِذي مِرَّةٍ سَويٍّ، إلَّا لِذي فَقرٍ مُدقِعٍ، أو غُرمٍ مُفظِعٍ، ",["ومَن سألَ الناسَ لِيُثريَ به مالَه",1],"، ",["كانَ خُموشًا في وَجهِه يَومَ القيامةِ، ورَضْفًا يأكُلُه مِن جَهنَّمَ",2],"، فمَن شاءَ فلْيُقِلَّ، ومَن شاءَ فليُكثِرْ."],"grade":"صحيح","narrator":"حبشي بن جنادة السلولي","muhaddith":"[صحيح]","takhrij":"أخرجه البغوي في ((شرح السنة)) (1623)، والترمذي (653) بلفظه، والطبراني (4/ 14) (3504) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"gTlTJg1U","merged":2,"otherRefs":["صحيح الترغيب 802 (صحيح)"]},{"id":"س-02937","fp":"3eb6dc6bf87c","stateId":596,"easy":"إذا سألت بغير فقر ← فإنما تأكل النار","cause":"من سأل بغيرِ فقرٍ","result":"فإنما يأكلُ النارَ","explicit":true,"repOf":"س-02929","ref":"النوافح العطرة 383","text":[["من سأل بغيرِ فقرٍ ",1],["فإنما يأكلُ النارَ",2]],"grade":"صحيح","muhaddith":"رجاله رجال الصحيح","bab":"إيمان › الوعيد","dorar":"8fDjY2Je"},{"id":"س-03076","fp":"8261cb8c873a","stateId":596,"easy":"إذا سألت الناس ← تأتي يوم القيامة وفي وجهك خدوش","cause":"مسألةُ الرجلِ","result":"شَينٌ يومَ القيامةِ في وجهِه خدوشٌ أو كدوحٌ","explicit":true,"repOf":"س-03089","ref":"مسند عمر 1/16","text":["عن سَمُرةَ بنِ جُندبٍ قال قال رسولُ اللهِ صلَّى اللهُ عليهِ وسلمَ  إنَّ المَسَائِلَ كَدٌّ يكدُّ بها الرجلُ وجهَه إلا أن يسألَ ذا سلطانٍ أو في أمرٍ لا بُدَّ منه قال وقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلمَ  ",["مسألةُ الرجلِ",1]," ",["شَينٌ يومَ القيامةِ في وجهِه خدوشٌ أو كدوحٌ",2]],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (681)، والنسائي (2600)، وأحمد (20106) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"sIyNMl6o"},{"id":"س-03077","fp":"ab9bcf0e74c2","stateId":596,"easy":"إذا سألت وأنت غني ← فهو شين في وجهك يوم القيامة","cause":"مسألةُ الغَنيِّ","result":"شَيْنٌ في وجهِهِ يومَ القيامةِ","explicit":true,"repOf":"س-03089","ref":"مسند عمر 1/25","text":[["مسألةُ الغَنيِّ",1]," ",["شَيْنٌ في وجهِهِ يومَ القيامةِ",2]," أو خَموشٌ"],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (19821) مختصراً، والبزار (3572)، والطبراني (18/175) (400) مطولاً باختلاف يسير، والطبري في ((مسند عمر)) (35) واللفظ له.","bab":"إيمان › الوعيد","dorar":"Wz6PknEF"},{"id":"س-03081","fp":"763152e294ea","stateId":596,"easy":"إذا سألت الناس لتثري مالك ← فإنما هو حجارة محماة من النار","cause":"من سأل النَّاسَ ليُثريَ مالَه","result":"فإنَّما هي رَضْفٌ من النَّارِ مُلهِبةٌ فمن شاء فليُقِلَّ ومن شاء فليُكثِرْ","explicit":true,"repOf":"س-03054","ref":"الترغيب والترهيب 2/35","text":[["من سأل النَّاسَ ليُثريَ مالَه ",1],["فإنَّما هي رَضْفٌ من النَّارِ مُلهِبةٌ فمن شاء فليُقِلَّ ومن شاء فليُكثِرْ",2]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن حبان (3391)، وتمام في ((الفوائد)) (1771)، وابن عساكر في ((تاريخ دمشق)) (52/48) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"CaRWmmAP"},{"id":"س-05224","fp":"7980406e34cc","stateId":596,"easy":"إذا سألت الناس عن ظهر غنى ← فإنما تستكثر من جمر جهنم","cause":"من يسألُ الناسَ عن ظهرِ غنًى","result":"فإنما يستكثرُ من جمرِ جهنمَ","explicit":true,"repOf":"س-04301","ref":"مسند عمر 1/25","text":["عن سهلِ بنِ الحنظليةَ أنه سمع رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يقولُ ",["من يسألُ الناسَ عن ظهرِ غنًى ",1],["فإنما يستكثرُ من جمرِ جهنمَ",2]," قلتُ يا رسولَ اللهِ ما ظهرُ الغِنى قال أن يعلمَ أن عندَ أهلِه ما يُغدِّيهم أو يُعشِّيهِم قال أبو كبشةَ لا أسألُ بعد هذا أحدًا"],"grade":"صحيح","narrator":"سهل ابن الحنظلية الأنصاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن زنجويه في ((الأموال)) (2077) واللفظ له، والطبراني في ((الشاميين)) (584) بلفظه مطولًا، وأبو داود (1629) بنحوه مطولًا.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"IK9N9Y8o"},{"id":"س-06211","fp":"742e9809282d","stateId":596,"easy":"إذا سألت الناس ← تكون المسألة كدوحاً في وجهك يوم القيامة","cause":"المسألةُ","result":"كُدُوحٌ في وجْهِ صاحِبِها يَومَ القيامةِ","explicit":true,"repOf":"س-03089","ref":"تخريج المسند لشعيب 5680","text":[["المسألةُ",1]," ",["كُدُوحٌ في وجْهِ صاحِبِها يَومَ القيامةِ",2],"، فمَن شاء فلْيَسْتَبْقِ على وجْهِه، وأَهْوَنُ المسألةِ مَسألةُ ذِي الرَّحِمِ تَسألُه في حاجةٍ، وخَيْرُ المَسألةِ المسألةُ عن ظَهرِ غِنًى، وابْدَأْ بمَن تَعُولُ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (5680)، والبيهقي في ((شعب الإيمان)) (3510)","bab":"سؤال › من تحل له المسألة","dorar":"pfS7gLvb"},{"id":"س-06212","fp":"dea874edaa68","stateId":596,"easy":"إذا سألت ولك ما يغنيك ← تأتي يوم القيامة وفي وجهك شين أو خدوش","cause":"لا يَسألُ عبدٌ مسألةً وله ما يُغنيهِ","result":"إلَّا جاءتْ شَيْنًا، أو كُدوحًا، أو خُدوشًا في وجهِهِ يومَ القِيامةِ","explicit":true,"repOf":"س-03089","ref":"تخريج مشكل الآثار 489","text":["فذكَر بإسنادِهِ مِثْلَهُ. غيْرَ أنَّه قال: كُدوحًا في وجهِهِ، ولمْ يشُكَّ. [يعني حديثَ: ",["لا يَسألُ عبدٌ مسألةً وله ما يُغنيهِ",1]," ",["إلَّا جاءتْ شَيْنًا، أو كُدوحًا، أو خُدوشًا في وجهِهِ يومَ القِيامةِ",2],"، قيلَ: يا رسولَ اللهِ، وما غِناهُ؟ قال: خمسونَ دِرهمًا، أو حِسابُها منَ الذَّهَبِ.]"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1626)، والترمذي (650)، والنسائي (2592) باختلاف يسير","bab":"سؤال › من تحل له المسألة","dorar":"VmRopH5w"},{"id":"س-05013","fp":"e654b0c41412","stateId":596,"easy":"إذا سألت بلا حاجة ← فلا تحمل في حضنك إلا النار","cause":"إِنَّ الرجلَ يأتينِي مِنكمْ ، فَيَسْأَلُنِي","result":"فَأُعْطِيهِ ، فَيَنْطَلِقُ وما يَحْمِلُ في حُضْنِهِ إلَّا النارَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04239","ref":"صحيح الموارد 700","text":[["إِنَّ الرجلَ يأتينِي مِنكمْ ، فَيَسْأَلُنِي ",1],["فَأُعْطِيهِ ، فَيَنْطَلِقُ وما يَحْمِلُ في حُضْنِهِ إلَّا النارَ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (2504)، وعبد بن حميد (1111)، وابن أبي شيبة كما في ((المطالب العالية)) (938) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"J831sCnX","merged":2,"otherRefs":["صحيح الترغيب 842 (صحيح)"]},{"id":"س-02974","fp":"4b230dda81a5","stateId":596,"easy":"إذا سألت الناس وأنت غني ← تأتي يوم القيامة وفي وجهك كدوح وخدوش","cause":"مَن سألَ الناسَ وهو غَنيٌّ","result":"جاء يومَ القيامةِ وفي وَجهِه كُدوحٌ وخُدوشٌ","explicit":true,"repOf":"س-03089","ref":"تخريج سنن الدارقطني 2002","text":[["مَن سألَ الناسَ وهو غَنيٌّ ",1],["جاء يومَ القيامةِ وفي وَجهِه كُدوحٌ وخُدوشٌ",2],"، فقيلَ: يا رسولَ اللهِ، ما غِناهُ؟ قال: أرْبعونَ دِرهمًا أو قِيمَتُها ذَهَبًا."],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"حسن","takhrij":"أخرجه أبو داود (1626)، والترمذي (650)، والنسائي (2592) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"MzhAJMFi"},{"id":"س-02993","fp":"a3edb170a6b3","stateId":596,"easy":"إذا سألت عن غنى ← فإنما تسأل جمراً","cause":"من سألَ عن ظهرِ غِنى","result":"فإنّما يسأَلُ جمرًا فليستقلّ أو ليستكثِر","explicit":true,"repOf":"س-04301","ref":"تخريج الإحياء للعراقي 4/263","text":[["من سألَ عن ظهرِ غِنى ",1],["فإنّما يسأَلُ جمرًا فليستقلّ أو ليستكثِر",2]," قالوا : وما ظهرُ غنى ؟ قال : عشاءُ ليلتهِ"],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"إسناده حسن","takhrij":"أخرجه عبدالله بن أحمد في ((زوائد المسند)) (1253)، والعقيلي في ((الضعفاء الكبير)) (1/223)، والطبراني في ((المعجم الأوسط)) (7078) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"71jRdqsW"},{"id":"س-03254","fp":"14373f97af2d","stateId":597,"easy":"إذا أدركت أبويك أو أحدهما فلم تبرهما فمت فدخلت النار ← أبعدك الله","cause":"ومن أدركَ أبويْهِ ، أو أحدَهما ، فلم يَبَرَّهما","result":"فماتَ ، فدخلَ النارَ ، فأبعدَهُ اللهُ","explicit":true,"star":true,"ref":"موارد الظمآن 2/900","srcLabel":"مسلم","text":["أنَّ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ صعدَ المنبَرَ ، فقال : آمينَ ، آمينَ ، آمينَ ، قيلَ : يا رسولَ اللهِ ، إنكَ صعدتَ المنبَرَ ، فقلتُ آمينَ ، آمينَ ، آمينَ ، فقال : إنَّ جبريلَ عليهِ السلامُ أتاني ، فقالَ لي : من أدركَ شهرَ رمضانَ فلم يُغفرْ لهُ ، فدخلَ النارَ فأبعدَهُ اللهُ ، قلْ : آمينَ ، فقلتُ : آمينَ ، ",["ومن أدركَ أبويْهِ ، أو أحدَهما ، فلم يَبَرَّهما",1]," ، ",["فماتَ ، فدخلَ النارَ ، فأبعدَهُ اللهُ",2]," ، قلْ : آمينَ ، فقلتُ : آمينَ ، ومن ذُكِرْتَ عندَهُ ، فلم يُصَلِّ عليكَ ، فماتَ ، فدخلَ النارَ ، فأبعدَهُ اللهُ ، قلْ آمينَ ، فقلتُ : آمينَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"في صحيح مسلم منه ما يتعلق ببر الوالدين بنحوه فقط","takhrij":"أخرجه ابن خزيمة (1888)، وابن حبان (907)، والطبراني في ((المعجم الأوسط)) (8131) باختلاف يسير. وقوله: \"ومن أدرك أبويه أو أحدهما فلم يبرهما فمات فدخل النار فأبعده الله\" أخرجه مسلم (2551) بلفظ مقارب","bab":"استغفار › أسباب المغفرة","dorar":"wrNPaZCt","merged":5,"otherRefs":["السلسلة الصحيحة 515 (صحيح)","صحيح الترغيب 2543 (صحيح)","صحيح الموارد 2024 (صحيح)","تخريج المسند لشعيب 20330 (صحيح)"]},{"id":"س-03816","fp":"b0e761a54b2e","stateId":597,"easy":"إذا تصارمت مع أخيك فوق ثلاثة أيام فمتما على ذلك ← هلكتما","cause":"ما مِن رجلَيْنِ يتصارمانِ فَوقَ ثلاثةِ أيامٍ فيَهلَكُ أحدُهما فماتا وهُما على ذلكَ مِن الصَّرامةِ","result":"إلَّا هلَكا جميعًا","explicit":true,"star":true,"ref":"صحيح الأدب المفرد 94","srcLabel":"البخاري","text":["كان ثَوبانُ يقولُ ",["ما مِن رجلَيْنِ يتصارمانِ فَوقَ ثلاثةِ أيامٍ فيَهلَكُ أحدُهما فماتا وهُما على ذلكَ مِن الصَّرامةِ",1]," ",["إلَّا هلَكا جميعًا",2]," وما مِن جارٍ يظلمُ جارَهُ ويقهرُهُ حتَّى يحملَهُ ذلكَ على أن يخرجَ مِن منزلِهِ إلَّا هلكَ"],"grade":"صحيح","narrator":"أبو عامر الحمصي","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (127) واللفظ له.","bab":"بر وصلة › حق الجار والوصاة به","dorar":"b6FAOS6n"},{"id":"س-04304","fp":"515ec8e0c033","stateId":597,"easy":"إذا أصبحت ساخطاً لوالديك ← يصبح لك بابان مفتوحان من النار","cause":"ومَن أَصبَحَ ساخِطًا لوالِدَيه","result":"أَصبَحَ له بابانِ مَفْتوحانِ مِن النَّارِ","explicit":true,"ref":"الأحاديث المختارة 11 / 228","srcLabel":"متفق عليه","text":["«مَن أَمْسى مُرْضِيًا لوالِدَيه -أَحسَبُه- أَصبَحَ له بابانِ مَفْتوحانِ إلى الجنَّةِ، ",["ومَن أَصبَحَ ساخِطًا لوالِدَيه",1]," ",["أَصبَحَ له بابانِ مَفْتوحانِ مِن النَّارِ",2],"، وإن واحِدٌ فواحِدٌ، فقالَ رَجُلٌ: يا رَسولَ اللهِ، وإن ظَلَماه؟ قالَ: وإن ظَلَماه، وإن ظَلَماه، ثَلاثَ مَرَّاتٍ»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"l8AJolNy"},{"id":"س-04988","fp":"5e3423532979","stateId":597,"easy":"إذا هجرت أخاك فوق ثلاث فمت ← دخلت النار","cause":"فمَن هجرَ أخاهُ فوقَ ثلاثٍ فماتَ","result":"دخلَ النَّارَ","explicit":true,"similar":["س-05278"],"ref":"الصحيح المسند 1307","srcLabel":"أبو داود","text":["لا يحلُّ لِمُسلِمٍ أن يَهجُرَ أخاهُ فوقَ ثلاثٍ، ",["فمَن هجرَ أخاهُ فوقَ ثلاثٍ فماتَ ",1],["دخلَ النَّارَ ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (4914) واللفظ له، وأحمد (9092)، والنسائي في ((الكبرى)) (9116) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"X5q5P22p","merged":2,"otherRefs":["فيض القدير 6/ 234 (صحيح)"]},{"id":"س-00256","fp":"431c8807ee40","stateId":597,"easy":"إذا اعتذر إليك أخوك فلم تقبل ← لن ترد على النبي ﷺ الحوض","cause":"ومَن تُنُصِّلَ إليه فلم يَقْبَلْ","result":"فلن يَرِدَ عَلَىَّ الحَوْضَ","explicit":true,"similar":["س-06112"],"ref":"الجامع الصغير 3124","srcLabel":"الحاكم","text":["بِرُّوا آباءَكم تَبَرَّكم أبناؤُكم ، وعِفُّوا عن النساءِ ، تَعِفَّ نساؤُكم ، ",["ومَن تُنُصِّلَ إليه فلم يَقْبَلْ ",1],["فلن يَرِدَ عَلَىَّ الحَوْضَ",2],"."],"grade":"صحيح","narrator":"جابر","muhaddith":"صحيح","takhrij":"أخرجه العقيلي في ((الضعفاء)) (3/ 249)، والحاكم (7259) كلاهما بلفظه، والطبراني في ((المعجم الأوسط)) (1029) مختصرا ببعض لفظه.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"jQMsjCC7"},{"id":"س-03849","fp":"b3441989e4e2","stateId":597,"easy":"إذا قطعت رحمك ← تشهد عليك بالقطيعة يوم القيامة","cause":"إن كان قطعها","result":"وعليه بقطيعةٍ","explicit":true,"otherNeedIds":[39],"ref":"صحيح الأدب المفرد 54","srcLabel":"البخاري (الأدب المفرد)","text":["عن ابنِ عباسٍ أنه قال احفظوا أنسابَكم تصلوا أرحامَكم فإنه لا بعد بالرحمِ إذا قربت وإن كانت بعيدةً ولا قُربَ بها إذا بعدت وإن كانت قريبةً وكلُّ رحمٍ آتيةٌ يومَ القيامةِ أمام صاحبِها تشهدُ له بصلةٍ إن كان وصلها ",["وعليه بقطيعةٍ",2]," ",["إن كان قطعها",1]],"grade":"صحيح","muhaddith":"صحيح الإسناد وصح مرفوعا","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"woiNIi8Y"},{"id":"س-05278","fp":"a31575b5f4ae","stateId":597,"easy":"إذا هجرت أخاك فوق ثلاث ← فأنت في النار إلا أن يتداركك الله برحمته","cause":"مَن هَجَرَ أخاه فوقَ ثَلاثٍ","result":"فهو في النَّارِ إلَّا أن يَتَدارَكَه اللهُ برَحمَتِه","explicit":true,"repOf":"س-04988","ref":"تنبيه الغافلين 185","text":["«",["مَن هَجَرَ أخاه فوقَ ثَلاثٍ ",1],["فهو في النَّارِ إلَّا أن يَتَدارَكَه اللهُ برَحمَتِه»",2]],"grade":"صحيح","narrator":"فضالة بن عبيد","muhaddith":"رجاله رجال الصحيح.","takhrij":"أخرجه ابن أبي شيبة (25371)، والطبراني في ((الكبير)) (18/ 315) (815) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Cp6ZjIgC"},{"id":"س-06112","fp":"96f30d2b5bd6","stateId":597,"easy":"إذا أتاك أخوك معتذراً فلم تقبل ← لن ترد على النبي ﷺ الحوض","cause":"ومَنْ أتاهُ أخوهُ مُتَنَصِّلًا فلْيَقْبَلْ ذلِكَ منْهُ ، مُحِقًّا كانَ أوْ مُبْطِلًا","result":"فإِنْ لم يَفْعَلْ لَمْ يَرِدْ عَلَيَّ الحوْضَ","explicit":true,"repOf":"س-00256","ref":"الجامع الصغير 5424","text":["عِفُّوا عنِ نساءِ الناسِ تعِفَّ نساؤُكم ، وبِرُّوا آباءَكُم تبرَّكُمْ أبناؤُكُمْ ، ",["ومَنْ أتاهُ أخوهُ مُتَنَصِّلًا فلْيَقْبَلْ ذلِكَ منْهُ ، مُحِقًّا كانَ أوْ مُبْطِلًا ، ",1],["فإِنْ لم يَفْعَلْ لَمْ يَرِدْ عَلَيَّ الحوْضَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الحاكم في ((مستدركه)) (7258)، والشجري في ((أماليه)) (1982) واللفظ لهما.","bab":"رقائق وزهد › مكارم الأخلاق والعفو عمن ظلم","dorar":"B4Sv4Ht8"},{"id":"س-04217","fp":"9302202bfe2d","stateId":597,"easy":"إذا أمسيت عاصياً لله في والديك ← يصبح لك بابان مفتوحان من النار","cause":"ومن أمسَى عاصيًا للهِ في والدَيهِ","result":"أصبَحَ لهُ بابانِ مفتوحانِ من النَّارِ","explicit":true,"ref":"لسان الميزان 5/39","srcLabel":"البيهقي","text":["مَن أصبَحَ مُطيعًا للهِ في والِدَيهِ : أصبح لهُ بابانِ مَفتوحانِ مِن الجنَّةِ ، وإن كانَ واحدًا فواحدٌ ، ",["ومن أمسَى عاصيًا للهِ في والدَيهِ",1]," : ",["أصبَحَ لهُ بابانِ مفتوحانِ من النَّارِ",2]," ، وإن كانَ واحدًا فواحدٌ ، قال الرَّجلُ : وإن ظلَماهُ ؟ قال : وإن ظَلماهُ ، وإن ظَلماهُ ، وإن ظَلَماهُ"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"رجاله ثقات أثبات، غير عبد الله بن يحيى السرخسي، فهو آفته","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (7916)، وابن عساكر في ((تاريخ دمشق)) (33/365) باختلاف يسير.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"2XPIzW9C"},{"id":"س-04245","fp":"7c042f572086","stateId":598,"easy":"إذا شربت في آنية الفضة ← إنما تجرجر في بطنك نار جهنم","cause":"إنَّ الذي يَشرَبُ في آنيةِ الفِضَّةِ","result":"إنَّما يُجَرجِرُ في بَطنِه نارَ جَهنَّمَ","explicit":true,"star":true,"similar":["س-00656"],"ref":"تخريج مشكل الآثار 1414","srcLabel":"متفق عليه","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قال: ",["إنَّ الذي يَشرَبُ في آنيةِ الفِضَّةِ",1]," ",["إنَّما يُجَرجِرُ في بَطنِه نارَ جَهنَّمَ",2],"."],"grade":"صحيح","narrator":"أم سلمة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (5634)، ومسلم (2065) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"S1ftlhx3","merged":5,"otherRefs":["صحيح مسلم 2065 (صحيح)","صحيح ابن ماجه 2774 (صحيح)","السلسلة الصحيحة 3417 (صحيح)","الاستذكار 7/355 (صحيح)"]},{"id":"س-08264","fp":"d751a41efbae","stateId":598,"easy":"إذا مسّ ثوبك الأرض (إسبالاً) ← فهو في النار","cause":"ما مَسَّ الأرضَ","result":"فهو في النَّارِ","explicit":true,"star":true,"similar":["س-03692"],"ref":"تخريج المسند لشعيب 5693","srcLabel":"أحمد","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ كَساهُ حُلَّةً سِيَراءَ، وكَسَا أُسامةَ قُبْطِيَّتَينِ، ثمَّ قال: ",["ما مَسَّ الأرضَ",1],"، ",["فهو في النَّارِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (5693)، وابن سعد في ((الطبقات الكبرى)) (5064)","bab":"مناقب وفضائل › أسامة بن زيد","dorar":"DS0hOU5y","merged":6,"otherRefs":["تخريج المسند لشعيب 26173 (صحيح)","إتحاف الخيرة المهرة 4/ 516 (حسن)","صحيح الجامع 5618 (صحيح)","السلسلة الصحيحة 2037 (صحيح)","تخريج المسند لشعيب 11487 (صحيح)"]},{"id":"س-04784","fp":"495823b7ddc2","stateId":598,"easy":"إذا لبست المعصفر (للرجال) ← تُعرّض نفسك للنار","cause":"مِلْحَفةٌ مُعَصْفَرةٌ","result":"يَستُرُ بَيْني وبَيْنَ هذه النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"الأحاديث المختارة 8 / 359","srcLabel":"متفق عليه","text":["«بَصُرَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ برَجُلٍ في مُؤَخَّرِ مَسجِدٍ، عليه ",["مِلْحَفةٌ مُعَصْفَرةٌ",1],"، فقالَ: (ألَا رَجُلٌ ",["يَستُرُ بَيْني وبَيْنَ هذه النَّارِ",2],"؟) ففَعَلَ ذلك رَجُلٌ»."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"YmjHMTQ1","merged":2,"otherRefs":["الأحاديث المختارة 8 / 359 (صحيح)"]},{"id":"س-06204","fp":"14f4cf33dd7d","stateId":598,"easy":"إذا أسبلت ثوبك أسفل الكعبين ← فهو في النار","cause":"ما كانَ أَسفَلَ مِن الكَعْبَينِ","result":"فهو في النَّارِ","explicit":true,"ref":"الصحيح المسند 1/347","srcLabel":"أبو داود","text":["إزْرةُ المُسلِمِ إلى نِصْفِ السَّاقِ ولا حَرَجَ -أو لا جُناحَ- فيما بَيْنَه وبَيْنَ الكَعْبَينِ، ",["ما كانَ أَسفَلَ مِن الكَعْبَينِ",1]," ",["فهو في النَّارِ",2],"، مَن جَرَّ إزارَه بَطَرًا لم يَنظُرِ اللهُ إليه."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"حسن على شرط مُسلِم","takhrij":"أخرجه أبو داود (4093)، وأحمد (11944)","bab":"زينة اللباس › ما نهي عنه من اللباس","dorar":"01NziWMJ","merged":2,"otherRefs":["تخريج المسند لشعيب 10461 (صحيح)"]},{"id":"س-00656","fp":"5cc40cbdc676","stateId":598,"easy":"إذا شربت في إناء فضة ← فكأنما تجرجر في بطنك ناراً","cause":"الذي يَشرَبُ في إناءِ فِضَّةٍ","result":"كَأنَّما يُجَرجِرُ في بَطنِه نارًا","explicit":true,"repOf":"س-04245","ref":"مجموع الشروح الفقهية. 89/17","text":["عَنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم قال في ",["الذي يَشرَبُ في إناءِ فِضَّةٍ",1],": ",["كَأنَّما يُجَرجِرُ في بَطنِه نارًا",2],"."],"grade":"صحيح","narrator":"عائشة","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (3415)، وأحمد (24662)، والبغوي كما في ((مسند ابن الجعد)) (1549) بلفظه.","bab":"آداب عامة › ضرب الأمثال","dorar":"uTD9W6DG"},{"id":"س-02578","fp":"8885d18afa66","stateId":598,"easy":"إذا تشبهت بالأعاجم في أعيادهم حتى تموت ← تُحشر معهم يوم القيامة","cause":"من بنَى ببلادِ الأعاجمِ ، فصنع نَيروزَهم ومهرجانَهم ، وتشبَّهَ بهم حتَّى يموتَ وهو كذلك","result":"حُشِرَ معهم يومَ القيامةِ","explicit":true,"ref":"اقتضاء الصراط المستقيم 1/513","srcLabel":"اقتضاء الصراط المستقيم","text":["عن عبدِ اللهِ بنِ عمرٍو قال : ",["من بنَى ببلادِ الأعاجمِ ، فصنع نَيروزَهم ومهرجانَهم ، وتشبَّهَ بهم حتَّى يموتَ وهو كذلك ، ",1],["حُشِرَ معهم يومَ القيامةِ",2]],"grade":"صحيح","narrator":"أبو المغيرة","muhaddith":"إسناده صحيح","bab":"إيمان › أعمال تنافي الإيمان","dorar":"k0GOi2nS"},{"id":"س-03692","fp":"aa4a63452790","stateId":598,"easy":"إذا مسّ ثوبك الأرض (إسبالاً) ← ففي النار","cause":"كُلُّ شَيءٍ مَسَّ الأرضَ من الثِّيابِ","result":"ففي النَّارِ","explicit":true,"repOf":"س-08264","ref":"تخريج المسند لشعيب 5727","text":["كَساني رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ قُبطيَّةً، وكَسا أُسامَةَ حُلَّةً سِيَراءَ، قال: فنَظَرَ فرَآني قد أسبَلْتُ، فجاءَ فأخَذَ بمَنْكِبي، وقال: يا ابنَ عُمَرَ، ",["كُلُّ شَيءٍ مَسَّ الأرضَ من الثِّيابِ",1]," ",["ففي النَّارِ",2],"، قال: فرَأيتُ ابنَ عُمَرَ يَتَّزِرُ إلى نِصفِ السَّاقِ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (5727) واللفظ له، وابن سعد في ((الطبقات الكبرى)) (5064) باختلاف يسير","bab":"اعتصام بالسنة › لزوم السنة","dorar":"GAT4HMwe"},{"id":"س-04171","fp":"a1d46b4830cd","stateId":598,"easy":"إذا تقلدت المرأة قلادة من ذهب (للتبرج) ← تُقلد مثلها من النار","cause":"أيما امرأةٍ تقلَّدت قلادةً من ذهبٍ قُلِّدَتْ في عنقها مثلَها من النارِ يومَ القيامةِ ، وأيما امرأةٍ جعلت في أذنها خرصًا من ذهبٍ","result":"جعل اللهُ في أذنها مثلَه من النارِ يومَ القيامةِ","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 1/171","srcLabel":"أبو داود","text":[["أيما امرأةٍ تقلَّدت قلادةً من ذهبٍ قُلِّدَتْ في عنقها مثلَها من النارِ يومَ القيامةِ ، وأيما امرأةٍ جعلت في أذنها خرصًا من ذهبٍ ",1],["جعل اللهُ في أذنها مثلَه من النارِ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"[أسماء بنت يزيد أم سلمة الأنصارية]","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4238) واللفظ له، والنسائي (5139)، وأحمد (27577) بنحوه.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"Qgw0mbdU"},{"id":"س-04287","fp":"6b22907d0213","stateId":598,"easy":"إذا أحببت أن تطوق حبيبك طوقاً من نار ← فطوّقه طوقاً من ذهب (للنساء بلا زكاة على رواية)","cause":"فليُطَوِّقْه طَوْقًا مِن ذَهَبٍ، ومَن أحَبَّ أنْ يُسَوِّرَ حَبيبَه سِوارًا مِن نارٍ فليُسَوِّرْه بسِوارٍ مِن ذَهَبٍ، ومَن أحَبَّ أنْ يُحلِّقَ حَبِيبَه حَلقةً مِن نارٍ، فليُحَلِّقْه حَلقةً مِن ذَهَبٍ","result":"مَن أحَبَّ أنْ يُطَوِّقَ حَبيبَه طَوقًا مِن نارٍ","explicit":true,"ref":"تخريج المسند لشاكر 16/177","srcLabel":"أبو داود","text":[["مَن أحَبَّ أنْ يُطَوِّقَ حَبيبَه طَوقًا مِن نارٍ، ",2],["فليُطَوِّقْه طَوْقًا مِن ذَهَبٍ، ومَن أحَبَّ أنْ يُسَوِّرَ حَبيبَه سِوارًا مِن نارٍ فليُسَوِّرْه بسِوارٍ مِن ذَهَبٍ، ومَن أحَبَّ أنْ يُحلِّقَ حَبِيبَه حَلقةً مِن نارٍ، فليُحَلِّقْه حَلقةً مِن ذَهَبٍ،",1]," ولكن عليكم بالفِضَّةِ، العَبوا بها لَعِبًا، العَبوا بها لَعِبًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4236)، وأحمد (8910) واللفظ له.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"0JjPlmp4"},{"id":"س-02938","fp":"39d5b44d3de1","stateId":598,"easy":"إذا تحلّت المرأة بذهب تظهره (للفتنة) ← تُعذّب به","cause":"تُحلَّى ذَهبًا تُظهِرُه","result":"إلَّا عُذِّبَتْ به","explicit":true,"ref":"هداية الرواة 4/225","srcLabel":"أبو داود","text":["يا مَعشَرَ النِّساءِ، أمَا لكُنَّ في الفِضَّةِ ما تَحَلَّينَ به، أمَا إنَّه ليس مِنكُنَّ امرَأةٌ ",["تُحلَّى ذَهبًا تُظهِرُه",1]," ",["إلَّا عُذِّبَتْ به",2],"."],"grade":"حسن","narrator":"أخت لحذيفة بن اليمان","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه أبو داود (4237) واللفظ له، والنسائي (5138)، وأحمد (27011)","bab":"إيمان › الوعيد","dorar":"tDz3fn1p","merged":2,"otherRefs":["النكت على المحرر 1/140 (حسن)"]},{"id":"س-02949","fp":"7404a8c158e6","stateId":598,"easy":"إذا صليت فارفع ثوبك عن الأرض (لا تسبل) ← فكل ما أصاب الأرض من ثوبك في النار","cause":"إذا صليتُم فارفَعُوا سُبُلَكُم","result":"فإنَّ كلَّ شيءٍ أصابَ الأرضَ منْ سُبُلِكُمْ فهوَ فِي النَّارِ","explicit":true,"ref":"الجامع الصغير 728","srcLabel":"الطبراني","text":[["إذا صليتُم فارفَعُوا سُبُلَكُم ، ",1],["فإنَّ كلَّ شيءٍ أصابَ الأرضَ منْ سُبُلِكُمْ فهوَ فِي النَّارِ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (11/ 261) (11677) واللفظ له، والبيهقي في ((شعب الإيمان)) (5722)، وأبو نعيم في ((تسمية ما روي عن الفضل)) (51) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"rszC3UZ2"},{"id":"س-04768","fp":"809e181b8819","stateId":598,"easy":"إذا خضبت بالسواد ← يسوّد الله وجهك يوم القيامة (على رواية)","cause":"من خضَب بالسوادِ","result":"سوَّد اللهُ وجهَه يومَ القيامةِ","explicit":true,"ref":"مجمع الزوائد 5/166","srcLabel":"أحمد","text":[["من خضَب بالسوادِ ",1],["سوَّد اللهُ وجهَه يومَ القيامةِ",2]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"فيه الوضين بن عطاء وثقه أحمد وابن معين وبقية رجاله ثقات","takhrij":"أخرجه ابن أبي عاصم كما في ((فتح الباري)) لابن حجر (10/355)، وابن عدي في ((الكامل في الضعفاء)) (3/222) واللفظ لهما، والطبراني في ((مسند الشاميين)) (652) باختلاف يسير","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"V9AGqFd4"},{"id":"س-02959","fp":"2de9bd803a24","stateId":598,"easy":"إذا افتتنت المرأة بالذهب والمعصفر ← فويل لها","cause":"لنِّساءِ مِن الأحمرينِ : الذَّهبِ والمُعصفَرِ","result":"وَيْلٌ ل","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح ابن حبان 5968","srcLabel":"البيهقي","text":[["وَيْلٌ ل",2],["لنِّساءِ مِن الأحمرينِ : الذَّهبِ والمُعصفَرِ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (5780) بلفظه.","bab":"إيمان › الوعيد","dorar":"pCLcSScB"},{"id":"س-02559","fp":"8349460d996c","stateId":599,"easy":"إذا خلعت البيعة ← تلقى الله لا حجة لك","cause":"ومَن خَلَعَها يَوْمَ عَقْدِه إيَّاها","result":"لَقيَ اللهَ لا حُجَّةَ له","explicit":true,"star":true,"similar":["س-03857"],"ref":"الأحاديث المختارة 8 / 198","srcLabel":"متفق عليه","text":["«مَن ماتَ وليسَتْ عليه طاعةٌ ماتَ مِيتةً جاهِليَّةً، ",["ومَن خَلَعَها يَوْمَ عَقْدِه إيَّاها ",1],["لَقيَ اللهَ لا حُجَّةَ له",2],"، ألَا لا يَخْلُوَنَّ رَجُلٌ بامْرَأةٍ إلَّا امْرَأةٍ ذاتِ مَحْرَمٍ، فإنَّ الشَّيْطانَ ثالثُهما، وهو مِن الاثْنَينِ أبْعَدُ، ومَن سَرَّتْه حَسَنتُه وساءَتْه سَيِّئتُه فهو مُؤمِنٌ»)."],"grade":"صحيح","narrator":"عامر بن ربيعة","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إيمان › أعمال الجن والشياطين","dorar":"0MxCj6ym"},{"id":"س-02603","fp":"5ac0525c7d7c","stateId":599,"easy":"إذا فارقت أمتك أو ارتددت أعرابياً بعد هجرتك ← فلا حجة لك","cause":"مَنْ فارَقَ أُمَّتَهُ أَوْ عادَ أَعْرَابِيًّا بَعْدَ هِجْرَتِهِ","result":"فلا حُجَّةَ لهُ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 413","srcLabel":"متفق عليه","text":["«",["مَنْ فارَقَ أُمَّتَهُ أَوْ عادَ أَعْرَابِيًّا بَعْدَ هِجْرَتِهِ؛ ",1],["فلا حُجَّةَ لهُ»",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[إسناده صحيح]","takhrij":"أخرجه البخاري في ((التاريخ الكبير)) معلقا (2/ 23) باختلاف يسير، ومسلم (1851)، وأحمد (5551) كلاهما بنحوه.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"5x16B4YO"},{"id":"س-01630","fp":"83b82b029ebc","stateId":599,"easy":"إذا ابتدعت في الدين ← تجر قصبك في النار (من قصة عمرو بن لحي)","cause":"كان أوَّلَ مَن سَيَّبَ السَّوائِبَ","result":"رَأيتُ عَمرَو بنَ عامِرٍ الخُزاعيَّ يَجُرُّ قُصْبَه في النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-07499"],"otherNeedIds":[20],"ref":"صحيح البخاري 4623","srcLabel":"متفق عليه","text":["عَن سَعيدِ بنِ المُسَيِّبِ، قال: البَحيرةُ: التي يُمنَعُ دَرُّها للطَّواغيتِ، فلا يَحلُبُها أحَدٌ مِنَ النَّاسِ، والسَّائِبةُ: كانوا يُسَيِّبونَها لآلِهَتِهم، لا يُحمَلُ عليها شَيءٌ. قال: وقال أبو هُرَيرةَ: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["رَأيتُ عَمرَو بنَ عامِرٍ الخُزاعيَّ يَجُرُّ قُصْبَه في النَّارِ",2],"، ",["كان أوَّلَ مَن سَيَّبَ السَّوائِبَ",1],". والوَصيلةُ: النَّاقةُ البِكرُ، تُبَكِّرُ في أوَّلِ نِتاجِ الإبِلِ، ثُمَّ تُثَنِّي بَعدُ بأُنثى، وكانوا يُسَيِّبونَها لطَواغيتِهم، إن وصَلَت إحداهما بالأُخرى ليس بينَهما ذَكَرٌ. والحامِ: فحلُ الإبِلِ يَضرِبُ الضِّرابَ المَعدودَ، فإذا قَضى ضِرابَه ودَعُوه للطَّواغيتِ، وأعْفَوه مِنَ الحَملِ، فلَم يُحمَلْ عليه شَيءٌ، وسَمَّوه الحاميَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4623)، ومسلم (2856)","bab":"أطعمة › حلب الرجل الناقة وغيرها","dorar":"icY5HOpI","merged":3,"otherRefs":["تخريج صحيح ابن حبان 6260 (صحيح)","صحيح البخاري 4624 (صحيح)"]},{"id":"ق-0239","fp":"e71d13b8f6fc","stateId":599,"easy":"ترك الهجرة مع القدرة والرضا بالاستضعاف ← مأواهم جهنم","cause":"ترك الهجرة مع القدرة والرضا بالاستضعاف","result":"مأواهم جهنم","explicit":true,"ref":"سورة النساء: 97","srcLabel":"القرآن الكريم","quran":{"s":4,"from":97,"to":97,"text":"إِنَّ الَّذِينَ تَوَفَّاهُمُ الْمَلَائِكَةُ ظَالِمِي أَنْفُسِهِمْ قَالُوا فِيمَ كُنْتُمْ قَالُوا كُنَّا مُسْتَضْعَفِينَ فِي الْأَرْضِ قَالُوا أَلَمْ تَكُنْ أَرْضُ اللَّهِ وَاسِعَةً فَتُهَاجِرُوا فِيهَا فَأُولَئِكَ مَأْوَاهُمْ جَهَنَّمُ وَسَاءَتْ مَصِيرًا (97)","hl":[[0,254,1]]}},{"id":"ق-0498","fp":"7f3180961d26","stateId":599,"easy":"التثاقل عن الجهاد والرضا بالحياة الدنيا ← عذاب أليم واستبدال قوم غيرهم","cause":"التثاقل عن الجهاد والرضا بالحياة الدنيا","result":"عذاب أليم واستبدال قوم غيرهم","explicit":true,"otherNeedIds":[39],"ref":"سورة التوبة: 38–39","srcLabel":"القرآن الكريم","quran":{"s":9,"from":38,"to":39,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا مَا لَكُمْ إِذَا قِيلَ لَكُمُ انْفِرُوا فِي سَبِيلِ اللَّهِ اثَّاقَلْتُمْ إِلَى الْأَرْضِ أَرَضِيتُمْ بِالْحَيَاةِ الدُّنْيَا مِنَ الْآخِرَةِ فَمَا مَتَاعُ الْحَيَاةِ الدُّنْيَا فِي الْآخِرَةِ إِلَّا قَلِيلٌ (38) إِلَّا تَنْفِرُوا يُعَذِّبْكُمْ عَذَابًا أَلِيمًا وَيَسْتَبْدِلْ قَوْمًا غَيْرَكُمْ وَلَا تَضُرُّوهُ شَيْئًا وَاللَّهُ عَلَى كُلِّ شَيْءٍ قَدِيرٌ (39)","hl":[[31,389,1]]}},{"id":"س-01182","fp":"ca0f7c3897dd","stateId":599,"easy":"إذا دعوت بدعوى الجاهلية ← فأنت من جثا جهنم","cause":"ومَن دَعا بدَعوى الجاهِليَّةِ","result":"فهو مِن جُثا جَهَنَّمَ","explicit":true,"similar":["س-00892","س-04212"],"ref":"تخريج المسند لشعيب 17800","srcLabel":"أحمد","text":["إنَّ اللهَ أمَرَ يَحيى بنَ زَكَريَّا بخَمسِ كَلِماتٍ أن يَعمَلَ بهنَّ، وأن يَأمُرَ بَني إسرائيلَ أن يَعمَلوا بهنَّ، فكادَ أن يُبطِئَ، فقال له عيسى: إنَّكَ قد أُمِرتَ بخَمسِ كَلِماتٍ أن تَعمَلَ بهنَّ، وأن تَأمُرَ بَني إسرائيلَ أن يَعمَلوا بهنَّ، فإمَّا أن تُبَلِّغَهنَّ وإمَّا أُبَلِّغهنَّ، فقال له: يا أخي، إنِّي أخشى إن سَبَقتَني أن أُعَذَّبَ، أو يُخسَفَ بي، قال: فجَمَعَ يَحيى بَني إسرائيلَ في بَيتِ المَقدِسِ، حَتَّى امتَلَأ المَسجِدُ، وقُعِدَ على الشُّرَفِ، فحَمِدَ اللهَ، وأثنى عليه، ثُمَّ قال: إنَّ اللهَ أمَرَني بخَمسِ كَلِماتٍ أن أعمَلَ بهنَّ وآمُرَكُم أن تَعمَلوا بهنَّ: أوَّلُهنَّ: أن تَعبُدوا اللهَ ولا تُشرِكوا به شَيئًا؛ فإنَّ مَثَلَ ذلك مَثَلُ رَجُلٍ اشتَرى عَبدًا مِن خالِصِ مالِه بوَرِقٍ أو ذَهَبٍ، فجَعَلَ يَعمَلُ ويُؤَدِّي عَمَلَه إلى غَيرِ سَيِّدِه، فأيُّكُم يَسُرُّه أن يَكونَ عَبدُه كَذلك؟ وإنَّ اللهَ خَلَقَكُم ورَزَقَكُم فاعبُدوهُ ولا تُشرِكوا به شَيئًا، وآمُرُكُم بالصَّلاةِ؛ فإنَّ اللهَ يَنصِبُ وجهَه لوَجهِ عَبدِه ما لم يَلتَفِتْ، فإذا صَلَّيتُم فلا تَلتَفِتوا، وآمُرُكُم بالصِّيامِ؛ فإنَّ مَثَلَ ذلك كَمَثَلِ رَجُلٍ مَعَه صُرَّةٌ مِن مِسكٍ في عِصابةٍ، كُلُّهم يَجِدُ ريحَ المِسكِ، وإنَّ خُلوفَ فمِ الصَّائِمِ أطيَبُ عِندَ اللهِ مِن ريحِ المِسكِ، وآمُرُكُم بالصَّدَقةِ؛ فإنَّ مَثَلَ ذلك كَمَثَلِ رَجُلٍ أسَرَه العَدوُّ، فشَدُّوا يَدَيه إلى عُنُقِه، وقَرَّبوهُ ليَضرِبوا عُنُقَه، فقال: هَل لَكُم أن أفتَديَ نَفسي مِنكُم، فجَعَلَ يَفتَدي نَفسَه مِنهم بالقَليلِ والكَثيرِ، حَتَّى فكَّ نَفسَه، وآمُرُكُم بذِكرِ اللهِ كَثيرًا، وإنَّ مَثَلَ ذلك كَمَثَلِ رَجُلٍ طَلَبَه العَدوُّ سِراعًا في أثَرِه، فأتى حِصنًا حَصينًا، فتَحَصَّنَ فيه، وإنَّ العَبدَ أحصَنُ ما يَكونُ مِنَ الشَّيطانِ إذا كان في ذِكرِ اللهِ. قال: وقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: «أنا آمُرُكُم بخَمسٍ اللهُ أمَرَني بهنَّ: بالجَماعةِ، والسَّمعِ، والطَّاعةِ، والهجرةِ، والجِهادِ في سَبيلِ اللهِ؛ فإنَّه مَن خَرَجَ مِنَ الجَماعةِ قِيدَ شِبرٍ فقد خَلَعَ رِبقَ الإسلامِ مِن عُنُقِه إلى أن يَرجِعَ، ",["ومَن دَعا بدَعوى الجاهِليَّةِ ",1],["فهو مِن جُثا جَهَنَّمَ»",2],"، قالوا: يا رَسولَ اللهِ، وإن صامَ وصَلَّى؟ قال: «وإن صامَ وصَلَّى، وزَعَمَ أنَّه مُسلِمٌ، فادعوا المُسلِمينَ بما سَمَّاهُمُ المُسلِمينَ المُؤمِنينَ عِبادَ اللهِ»."],"grade":"صحيح","narrator":"الحارث الأشعري","muhaddith":"صحيح","bab":"أدعية وأذكار › فضل الذكر","dorar":"sHxpfooO","merged":3,"otherRefs":["تخريج صحيح ابن حبان 6233 (صحيح)","المستدرك على الصحيحين 8027 (صحيح)"]},{"id":"س-03857","fp":"c5707f6c5a28","stateId":599,"easy":"إذا خلعت يداً من طاعة ← تلقى الله يوم القيامة لا حجة لك","cause":"مَن خَلَعَ يَدًا مِن طاعةٍ","result":"لَقيَ اللهَ يَومَ القيامةِ لا حُجَّةَ له","explicit":true,"repOf":"س-02559","ref":"صحيح مسلم 1851","text":["جاءَ عبدُ اللهِ بنُ عُمَرَ إلى عبدِ اللهِ بنِ مُطيعٍ حينَ كان مِن أمرِ الحَرَّةِ ما كانَ، زَمَنَ يَزيدَ بنِ مُعاويةَ، فقال: اطرَحوا لأبي عبدِ الرَّحمَنِ وِسادةً، فقال: إنِّي لم آتِكَ لأجلِسَ، أتَيتُكَ لأُحَدِّثَكَ حَديثًا سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُه: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["مَن خَلَعَ يَدًا مِن طاعةٍ ",1],["لَقيَ اللهَ يَومَ القيامةِ لا حُجَّةَ له، ",2],"ومَن ماتَ وليسَ في عُنُقِه بَيعةٌ ماتَ مِيتةً جاهِليَّةً."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (5386)، وابن حبان (4578) بنحوه.","bab":"بيعة › مبايعة الإمام","dorar":"Hr2AYVCB","merged":3,"otherRefs":["تخريج المسند لشاكر 9/165 (صحيح)","تخريج المسند لشعيب 6048 (صحيح)"]},{"id":"س-03059","fp":"8a3cde13e5d5","stateId":599,"easy":"إذا شذذت عن الجماعة ← شذذت إلى النار","cause":"من شذَّ","result":"شذَّ إلى النَّارِ","explicit":true,"ref":"الفتح الرباني 10/4768","srcLabel":"الترمذي","text":[["من شذَّ ",1],["شذَّ إلى النَّارِ ",2],"[يعني حديث: لا تَجتَمِعُ أُمَّةُ محمدٍ على ضَلالَةٍ أبدًا وعليكم بالسَّوادِ الأعظَمِ فإنه مَن شَذَّ شَذَّ إلى النارِ]"],"grade":"صحيح","narrator":"[عبدالله بن عمر]","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2167)، وابن أبي عاصم في ((السنة)) (80)، والحاكم (391) جميعا بلفظه مطولا.","bab":"إيمان › الوعيد","dorar":"lFFty4UO","merged":2,"otherRefs":["نيل الأوطار 9/231 (صحيح)"]},{"id":"س-07587","fp":"f31b7d22c075","stateId":599,"easy":"إذا أحدثت بعد النبي ﷺ ← يُذهب بك ذات الشمال","cause":"ما أحدثوا بعدَك ، إنهم كانوا يمشون بعدَك القَهْقَرى على أعقابهم","result":"و يذهبُ بكم ذاتَ الشمالِ","explicit":true,"ref":"صحيح الترغيب 784","srcLabel":"البزار","text":["إني مُمسِكٌ بحُجَزِكم عن النَّارِ : هَلُمَّ عن النارِ ، و تغلبونَني ، تقاحَمون فيه تقاحُمَ الفراشِ أو الجنادِبِ ، فأوشك أن أُرسِلَ بحُجَزِكم ، و أنا فرطَكُم على الحوضِ ، فترِدُون عليَّ معًا و أشتاتًا ، فأعرفُكم بسِيماكم و أسمائِكم ، كما يَعرِف الرجلُ الغريبةَ من الإبلِ في إبلِه ، ",["و يذهبُ بكم ذاتَ الشمالِ",2]," ، و أناشدُ فيكم ربَّ العالمين فأقول : أي ربِّ أُمَّتي ! ! فيقول : يا محمدُ ! إنك لا تدري ",["ما أحدثوا بعدَك ، إنهم كانوا يمشون بعدَك القَهْقَرى على أعقابهم",1]," ، فلا أعرفنَّ أحدَكم يومَ القيامةِ يحمل شاةً لها ثُغاءٌ ، فينادي : يا محمدُ يا محمدُ ! فأقول لا أملِكُ لك شيئًا ، قد بلَّغتُك ، فلا أعرفنَّ أحدَكم يأتي يومَ القيامةِ يحمل بعيرًا له رُغاءٌ ، فينادي : يا محمدُ يا محمدُ ! فأقول : لا أملِك لك شيئًا ، قد بلَّغتُك ، فلا أعرفنَّ أحدَكم يأتى يومَ القيامةِ يحمل فرسًا له حَمْحَمَةٌ ، فينادى : يا محمدُ يا محمدُ ! فأقول : لا أملكُ لك شيئًا قد بلَّغتُك فلا أعرفنَّ أحدَكم يومَ القيامةِ يحمل سقاءً من آدمَ ينادى : يا محمدُ يا محمدُ ! فأقول : لا أملِكُ لك شيئًا ، قد بلَّغتُكَ"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"حسن صحيح","takhrij":"أخرجه البزار (204)، والشهاب في ((المسند)) (1130)، والرامهرمزي في ((أمثال الحديث)) (14) واللفظ لهم.","bab":"فضائل النبي وصفته ودلائل النبوة › شفقته على أمته","dorar":"ExmIAaN9","merged":2,"otherRefs":["السلسلة الصحيحة 2865 (حسن)"]},{"id":"س-00892","fp":"fc03fd98d683","stateId":599,"easy":"إذا ادعيت دعوى الجاهلية ← فأنت من جثى جهنم","cause":"ومن ادَّعى دَعوى الجاهليَّةِ","result":"فإنَّهُ من جُثى جَهَنَّم","explicit":true,"repOf":"س-01182","ref":"سنن الترمذي 2863","text":["إنَّ اللَّهَ أمرَ يحيى بنَ زَكَريَّا بخمسِ كلماتٍ أن يعملَ بِها ، ويأمرَ بني إسرائيل أن يعمَلوا بِها ، وإنَّهُ كادَ أن يُبْطِئَ بِها فقال عيسى: إنَّ اللهَ أمَرَك بخَمسِ كلماتٍ؛ لِتَعمَلَ بها وتَأمُرَ بَني إسرائيلَ أن يَعمَلوا بها، فإمَّا أن تَأمُرَهم، وإمَّا أنْ آمُرَهم، فقال يحيى: أخشى إن سبَقتَني بها أن يُخسَفَ بي أو أُعذَّبَ، فجمَع النَّاسَ في بيتِ المقدِسِ، فامتَلَأ المسجدُ وقعَدوا على الشُّرُفِ، فقال: \"إنَّ اللهَ أمَرني بخَمسِ كلماتٍ أن أَعمَلَ بِهنَّ، وآمرُكم أن تَعمَلوا بهنَّ: أوَّلُهنَّ أن تَعبُدوا اللهَ ولا تُشرِكوا به شيئًا، وإنَّ مَثلَ مَن أشرَك باللهِ كمثَلِ رجلٍ اشترى عبدًا مِن خالصِ مالِه بذهَبٍ أو ورِقٍ، فقال: هذه داري وهذا عمَلي، فاعمَلْ وأدِّ إليَّ، فكان يعمَلُ ويُؤدِّي إلى غيرِ سيِّدِه، فأيُّكم يَرضى أن يكونَ عبدُه كذلك؟! وإنَّ الله أمركم بالصَّلاة، فإذا صَلَّيتُم فلا تَلتَفِتوا؛ فإنَّ اللهَ يَنصُبُ وجهَه لوجهِ عبدِه في صلاتِه ما لم يَلتفِتْ، وآمرُكم بالصِّيامِ؛ فإنَّ مَثلَ ذلك كمثَلِ رجلٍ في عِصابةٍ معَه صُرَّةٌ فيها مِسكٌ، فكلَّهم يَعجَبُ أو يُعجِبُه ريحُها، وإنَّ ريحَ الصَّائمِ أطيبُ عندَ اللهِ مِن ريحِ المسكِ، وآمرُكم بالصَّدقةِ؛ فإنَّ مثَلَ ذلك كمثَلِ رجلٍ أسَره العدوُّ، فأوثَقوا يدَه إلى عنُقِه، وقدَّموه لِيَضرِبوا عُنقَه، فقال: أنا أَفْديه منكم بالقليلِ والكثيرِ، ففدَى نفسَه منهم، وآمُركم أن تَذكُروا اللهَ؛ فإنَّ مَثلَ ذلك كمَثلِ رجلٍ خرَج العدوُّ في أثَرِه سِراعًا حتَّى إذا أتى على حِصنٍ حَصينٍ، فأحرَز نفسَه منهم، كذلك العبدُ لا يُحرِزُ نفسَه مِن الشَّيطانِ إلَّا بذِكْرِ اللهِ\". قال النَّبيُّ صلَّى اللهُ علَيه وسلَّم: وأَنا آمرُكُم بخَمسٍ اللَّهُ أمرَني بِهِنَّ، السَّمعُ والطَّاعةُ والجِهادُ والهجرةُ والجمَاعةُ، فإنَّهُ مَن فارقَ الجماعةَ قيدَ شبرٍ فقد خلَعَ رِبقةَ الإسلامِ من عُنقِهِ إلَّا أن يراجِعَ، ",["ومن ادَّعى دَعوى الجاهليَّةِ",1]," ",["فإنَّهُ من جُثى جَهَنَّم",2],"، فقالَ رجلٌ: يا رسولَ اللَّهِ وإن صلَّى وصامَ؟ فقالَ: وإن صلَّى وصامَ، فادعوا بدَعوى اللَّهِ الَّذي سمَّاكمُ المسلِمينَ المؤمنينَ، عبادَ اللَّهِ"],"grade":"صحيح","narrator":"الحارث بن الحارث الأشعري","muhaddith":"حسن صحيح غريب","takhrij":"أخرجه أحمد (17170)، وابن خزيمة (930) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"p7zymDIJ"},{"id":"س-03721","fp":"19b75e9ef406","stateId":599,"easy":"إذا سمعت وعصيت ← فلا حجة لك","cause":"السَّامعَ العاصيَ","result":"لا حُجَّةَ له","explicit":true,"ref":"تخريج المسند لشعيب 16875","srcLabel":"الطبراني","text":["وإنَّ السَّامعَ المُطيعَ لا حُجَّةَ عليه، وإنَّ ",["السَّامعَ العاصيَ",1]," ",["لا حُجَّةَ له",2],"."],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (1056)، والطبراني (19/366) (861)","bab":"اعتصام بالسنة › لزوم السنة","dorar":"WZ20pwZQ"},{"id":"س-03732","fp":"0aa3dbc8c535","stateId":599,"easy":"إذا عصيت النبي ﷺ ← دخلت النار","cause":"ومَن عصاني","result":"دخَل النَّارَ","explicit":true,"ref":"مجمع الزوائد 10/73","srcLabel":"ابن حبان","text":["والَّذي نفسي بيدِه لتَدْخُلُنَّ الجَنَّةَ كُلُّكم إلَّا مَن أبى أو شرَد على اللهِ شِرادَ البعيرِ قيل يا رسولَ اللهِ ومَن أبى أن يدخُلَ الجَنَّةَ فقال مَن أطاعَني دخَل الجَنَّةَ ",["ومَن عصاني ",1],["دخَل النَّارَ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه ابن حبان (17)، والطبراني في ((المعجم الأوسط)) (808) باختلاف يسير","bab":"اعتصام بالسنة › لزوم السنة","dorar":"2nDXRKMp"},{"id":"س-04212","fp":"c2c5f663dcf2","stateId":599,"easy":"إذا دعوت بدعوى الجاهلية ← فأنت من جثى جهنم","cause":"مَن دَعا بدَعْوى الجاهِليَّةِ","result":"فإنَّه مِن جُثَى جَهَنَّمَ","explicit":true,"repOf":"س-01182","ref":"الأحكام الوسطى 4/ 269","text":["\"",["مَن دَعا بدَعْوى الجاهِليَّةِ ",1],["فإنَّه مِن جُثَى جَهَنَّمَ\"",2],"، فقالَ رَجُلٌ: يا رَسولَ اللهِ، وإن صامَ وصلَّى؟ قالَ: \"نَعمْ، وإن صامَ وصلَّى، فادْعوا بدَعْوةِ اللهِ الَّذي سَمَّاكم بِها المُسلِمينَ المُؤمِنينَ عِبادَ اللهِ\"."],"grade":"صحيح","narrator":"الحارث بن مالك الأشعري","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه النسائي ((السنن الكبرى)) (8815) واللفظ له، والترمذي (2863)، وأحمد (17170) مطولا","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"lEZVd2gn"},{"id":"س-07341","fp":"c462c66d5d45","stateId":599,"easy":"إذا اتبعت الأهواء وفارقت الجماعة ← تكون من الفرق الهالكة","cause":"وواحدةٌ في الجنةِ ، وهيَ الجماعةُ ، وإنَّهُ سيخرُجُ مِنْ أُمتي أقوامٌ تَجَارَى بِهمْ تلكَ الأهواءُ ، كما يَتجَارَى الكلَبُ بصاحبِهِ لاَ يبقَى منهُ عِرْقٌ ولاَ مَفْصِلٌ إلَّا دخلَهُ","result":"ثنتانِ وسبعونَ في النارِ","explicit":true,"ref":"الأحكام الشرعية الصغرى 96","srcLabel":"أبو داود","text":["ألاَ إنَّ مَنْ قبلكُمْ مِنْ أهلِ الكتابِ ، افترقوا على ثنتينِ وسبعينَ ملةً ، وإنَّ هذهِ الأمةَ ستفترقُ على ثلاثٍ وسبعينَ : ",["ثنتانِ وسبعونَ في النارِ ",2],"،",[" وواحدةٌ في الجنةِ ، وهيَ الجماعةُ ، وإنَّهُ سيخرُجُ مِنْ أُمتي أقوامٌ تَجَارَى بِهمْ تلكَ الأهواءُ ، كما يَتجَارَى الكلَبُ بصاحبِهِ لاَ يبقَى منهُ عِرْقٌ ولاَ مَفْصِلٌ إلَّا دخلَهُ",1]],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"[أشار في المقدمة أنه صحيح الإسناد]","takhrij":"أخرجه أبو داود (4597)، وأحمد (16937) باختلاف يسير","bab":"فتن › كراهية الاختلاف","dorar":"Ju2Kmaaj"},{"id":"س-07499","fp":"fdf0323044c3","stateId":599,"easy":"إذا غيّرت دين الله ← تجر قصبك في النار","cause":"أوَّلُ مَن غيَّر دينَ إسماعيلَ","result":"يجرُّ قصبه في النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-01630","otherNeedIds":[20],"ref":"عمدة التفسير 1/745","text":["سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ لأَكْثمَ بنِ الجونِ : يا أَكْثمُ ، رأيتُ عمرَو بنَ لُحيٍّ بنِ قَمعةَ بنِ خِندفَ ",["يجرُّ قصبه في النَّارِ",2]," ، فما رأيتُ رجلًا أشبَهَ برجلٍ منكَ بِهِ ، ولا بِهِ منكَ . فقالَ أَكْثمُ : تخشَى أن يَضرَّني شبَهُهُ يا رسولَ اللَّهِ ؟ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : لا إنَّكَ مُؤمنٌ وَهوَ كافرٌ ، إنَّهُ ",["أوَّلُ مَن غيَّر دينَ إسماعيلَ",1]," ، وبَحَّرَ البحيرةَ ، وسيَّبَ السَّائبةَ ، وحَمى الحاميَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (8787) مختصراً، وابن أبي عاصم في ((الأوائل)) (83)، والبزار (8991) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"OQdCRecS","merged":6,"otherRefs":["مجموع فتاوى ابن باز 181/5 (صحيح)","تخريج المسند لشعيب 4259 (صحيح)","صحيح ابن حبان 7490 (صحيح)","عمدة القاري 16/126 (صحيح)","صحيح الجامع 2024 (صحيح)"]},{"id":"س-03752","fp":"1095b3e175c7","stateId":599,"easy":"إذا أحدثت في الدين ← يُؤخذ بك ذات الشمال عن الحوض","cause":"ما أحدَثوا بَعدَك","result":"فيُؤْخَذُ بهِمْ ذَاتَ الشِّمَالِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[20],"ref":"المصابيح في الأحاديث المتواترة 637","srcLabel":"المصابيح في الأحاديث المتواترة","text":["لا تدري ",["ما أحدَثوا بَعدَك",1]," [حديث عبدالله بن مسعود: أنا فَرَطُكُمْ علَى الحَوْضِ، ولَيُرْفَعَنَّ مَعِي رِجالٌ مِنكُم ثُمَّ لَيُخْتَلَجُنَّ دُونِي، فأقُولُ: يا رَبِّ أصْحابِي، فيُقالُ: إنَّكَ لا تَدْرِي ما أحْدَثُوا بَعْدَكَ.] [وحديث سهل بن سعد وأبي سعيد الخدري: إنِّي فَرَطُكُمْ علَى الحَوْضِ، مَن مَرَّ عَلَيَّ شَرِبَ، ومَن شَرِبَ لَمْ يَظْمَأْ أبَدًا، لَيَرِدَنَّ عَلَيَّ أقْوامٌ أعْرِفُهُمْ ويَعْرِفُونِي، ثُمَّ يُحالُ بَيْنِي وبيْنَهُمْ. قالَ أبو حازِمٍ: فَسَمِعَنِي النُّعْمانُ بنُ أبِي عَيَّاشٍ، فقالَ: هَكَذا سَمِعْتَ مِن سَهْلٍ؟ فَقُلتُ: نَعَمْ، فقالَ: أشْهَدُ علَى أبِي سَعِيدٍ الخُدْرِيِّ، لَسَمِعْتُهُ وهو يَزِيدُ فيها: فأقُولُ إنَّهُمْ مِنِّي، فيُقالُ: إنَّكَ لا تَدْرِي ما أحْدَثُوا بَعْدَكَ، فأقُولُ: سُحْقًا سُحْقًا لِمَن غَيَّرَ بَعْدِي.]  [وحديث أنس بن مالك: لَيَرِدَنَّ عَلَيَّ ناسٌ مِن أصْحابِي الحَوْضَ، حتَّى عَرَفْتُهُمُ، اخْتُلِجُوا دُونِي، فأقُولُ: أصْحابِي! فيَقولُ: لا تَدْرِي ما أحْدَثُوا بَعْدَكَ.]                                       [وحديث ابن عباس: قَامَ فِينَا النبيُّ صَلَّى اللهُ عليه وسلَّمَ يَخْطُبُ، فَقالَ: إنَّكُمْ مَحْشُورُونَ حُفَاةً عُرَاةً غُرْلًا: {كما بَدَأْنَا أوَّلَ خَلْقٍ نُعِيدُهُ} [الأنبياء: 104] الآيَةَ، وإنَّ أوَّلَ الخَلَائِقِ يُكْسَى يَومَ القِيَامَةِ إبْرَاهِيمُ، وإنَّه سَيُجَاءُ برِجَالٍ مِن أُمَّتي ",["فيُؤْخَذُ بهِمْ ذَاتَ الشِّمَالِ",2],"، فأقُولُ: يا رَبِّ أصْحَابِي، فيَقولُ: إنَّكَ لا تَدْرِي ما أحْدَثُوا بَعْدَكَ، فأقُولُ كما قالَ العَبْدُ الصَّالِحُ: {وَكُنْتُ عليهم شَهِيدًا ما دُمْتُ فيهم} [المائدة: 117]- إلى قَوْلِهِ - {الحَكِيمُ} [البقرة: 32] قالَ: فيُقَالُ: إنَّهُمْ لَمْ يَزَالُوا مُرْتَدِّينَ علَى أعْقَابِهِمْ.] [وحديث أم سلمة: كُنْتُ أَسْمَعُ النَّاسَ يَذْكُرُونَ الحَوْضَ، وَلَمْ أَسْمَعْ ذلكَ مِن رَسولِ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، فَلَمَّا كانَ يَوْمًا مِن ذلكَ، وَالْجَارِيَةُ تَمْشُطُنِي، فَسَمِعْتُ رَسولَ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ يقولُ: أَيُّهَا النَّاسُ، فَقُلتُ لِلْجَارِيَةِ: اسْتَأْخِرِي عَنِّي، قالَتْ: إنَّما دَعَا الرِّجَالَ وَلَمْ يَدْعُ النِّسَاءَ، فَقُلتُ: إنِّي مِنَ النَّاسِ، فَقالَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ: إنِّي لَكُمْ فَرَطٌ علَى الحَوْضِ، فَإِيَّايَ لا يَأْتِيَنَّ أَحَدُكُمْ فيُذَبُّ عَنِّي كما يُذَبُّ البَعِيرُ الضَّالُّ ، فأقُولُ: فِيمَ هذا؟ فيُقَالُ: إنَّكَ لا تَدْرِي ما أَحْدَثُوا بَعْدَكَ، فأقُولُ: سُحْقًا. وفي رِوايَةٍ: كَانَتْ أُمُّ سَلَمَةَ تُحَدِّثُ، أنَّهَا سَمِعَتِ النَّبيَّ صَلَّى اللَّهُ عليه وَسَلَّمَ يقولُ علَى المِنْبَرِ، وَهي تَمْتَشِطُ: أَيُّهَا النَّاسُ، فَقالَتْ لِمَاشِطَتِهَا: كُفِّي رَأْسِي .]"],"grade":"صحيح","narrator":"[عبدالله بن مسعود وسهل بن سعد الساعدي وأبو سعيد الخدري وأنس بن مالك وعبدالله بن عباس وأم سلمة أم المؤمنين]","muhaddith":"متواتر معنى، وقيل: متواتر لفظًا أيضًا","bab":"اعتصام بالسنة › مخالفة السنة","dorar":"djhGMoKW","merged":17,"otherRefs":["تخريج المسند لشعيب 2281 (صحيح)","تخريج المسند لشعيب 2327 (صحيح)","تخريج المسند لشعيب 3850 (صحيح)","المصابيح في الأحاديث المتواترة 629 (صحيح)","صحيح البخاري 7049 (صحيح)","مجمع الزوائد 10/368 (صحيح)","صحيح مسلم 2304 (صحيح)","تخريج المسند لشعيب 15121 (صحيح)","صحيح البخاري 7048 (صحيح)","صحيح الجامع 1471 (صحيح)","فتح الباري لابن حجر 1/246 (صحيح)","صحيح مسلم 2297 (صحيح)","تخريج المسند لشعيب 20494 (صحيح)","تخريج المسند لشعيب 19/411 (صحيح)","تخريج المسند لشعيب 11996 (صحيح)","مجمع الزوائد 9/370 (حسن)"]},{"id":"س-05657","fp":"a52307275ad4","stateId":600,"easy":"إذا بنيت فوق الحاجة ← يكون وبالاً عليك يوم القيامة إلا ما لا بد منه","cause":"كلَّ بِناءٍ بُنِيَ","result":"وبالٌ على صاحِبِه يَوْمَ القِيامةِ إلَّا ما لا بُدَّ مِنه","explicit":true,"star":true,"ref":"الأحاديث المختارة 2746","srcLabel":"متفق عليه","text":["«أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ خَرَجَ فرأى قُبَّةً مُشرِفةً، فقالَ: ما هذه؟ فقالَ له أصْحابُه: هذه لرَجُلٍ مِن الأنْصارِ، قالَ: فسَكَتَ وجَعَلَها في نَفْسِه حتَّى إذا دَخَلَ صاحِبُها فسَلَّمَ على النَّاسِ أعْرَضَ عنه، وصَنَعَ ذلك به مِرارًا، حتَّى عَرَفَ الرَّجُلُ الغَضَبَ في وَجْهِه، والإعْراضَ عنه، فشَكا ذلك إلى أصْحابِه، فقالَ: واللهِ إنِّي لأُنكِرُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، ما أدْري ما حَدَثَ بي وما صَنَعْتُ؟\nقالوا: خَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فرأى قُبَّتَك، فسألَ عن هذه فأخْبَرْناه.\nفرَجَعَ الرَّجُلُ إلى قُبَّتِه فهَدَمَها حتَّى سَوَّاها بالأرْضِ، فخَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ذاتَ يَوْمٍ ولم يَرَها، فقالَ: ما فَعَلَتِ القُبَّةُ الَّتي كانَتْ هاهنا؟ قالوا: شَكا إلينا صاحِبُها إعْراضَك عنه، فأخْبَرْناه فهَدَمَها، فقالَ لنا: إنَّ ",["كلَّ بِناءٍ بُنِيَ",1]," ",["وبالٌ على صاحِبِه يَوْمَ القِيامةِ إلَّا ما لا بُدَّ مِنه",2]," [ … ]»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"orcYWem8","merged":5,"otherRefs":["صحيح الترغيب 1874 (صحيح)","الجامع الصغير 6270 (حسن)","صحيح ابن ماجه 3/362 (صحيح)","صحيح أبي داود 5237 (صحيح)"]},{"id":"س-07541","fp":"af1d3c793e18","stateId":600,"easy":"إذا شربت الماء البارد ← فهو من النعيم الذي تُسأل عنه","cause":"ثُمَّ أتاهم بماءٍ فشَرِبوا عليه","result":"هذا من النَّعيمِ الذي تُسأَلون عنه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"الأحاديث المختارة 179","srcLabel":"البخاري","text":["«خرج رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم عندَ الظَّهيرةِ فوَجَد أبا بكرٍ في المَسجِدِ، فقال: ما أخرَجَك هذه السَّاعةَ؟ قال: أخرَجَني الذي أخرَجَك يا رَسولَ اللهِ، وجاء عُمَر بنُ الخَطَّابِ، فقال: يا ابنَ الخَطَّابِ ما أخرَجَك؟ قال: أخرَجَني الذي أخرَجَكما يا رَسولَ اللهِ، فقعَدَ عُمَرُ وأقبل رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يحَدِّثُنا، ثُمَّ قال: هل بكما من قُوَّةٍ فتَنطَلِقا إلى هذا النَّخْلِ فتُصيبا طعامًا وشرابًا وظِلًّا؟ قُلْنا: نَعَم، قال: مُرُّوا بنا إلى مَنزِلِ ابنِ التَّيِّهانِ أبي الهَيثَمِ الأنصاريِّ، فتقدَّمَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم بَيْنَ أيدينا فسَلَّم، واستأذن ثلاثَ مَرَّاتٍ، وأمُّ الهيثمِ وراءَ البابِ تَسمَعُ الكلامَ وتريدُ أن يَزيدَها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم مِنَ السَّلامِ، فلمَّا أراد رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم أن ينصَرِفَ خرَجَت أمُّ الهيثَمِ تسعى خلْفَهم، فقالت: يا رَسولَ اللهِ قَدْ -واللهِ- سَمِعْتُ تَسليمَك، ولكِنِّي أرَدْتُ أن تزيدَنا من سَلامِك! فقال لها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم خيرًا. وقال أين أبو الهَيثَمِ؟ لا أَراه. قالت: هو قريبٌ، ذَهَب يستعْذِبُ لنا من الماءِ، ادخُلوا فإنَّه يأتي السَّاعةَ -إن شاء اللهُ- فبسَطَت لهم بِساطًا تحتَ شَجَرةٍ، فجاء أبو الهَيثَمِ، ففَرِحَ بهم، وقَرَّت عيناه بهم، وصَعِد نخلةً فصَرَم لهم أعذاقًا. قال: فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: حَسْبُك يا أبا الهَيْثَمِ، قال: يا رَسولَ اللهِ تأكُلون من بُسْرِه ومِن رُطَبِه ومِن تَذْنُوبِه، ",["ثُمَّ أتاهم بماءٍ فشَرِبوا عليه",1],". فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["هذا من النَّعيمِ الذي تُسأَلون عنه",2],"! وقام أبو الهَيثَمِ لِيَذبَحَ لهم شاةً، فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: إيَّاكَ واللَّبونَ، وقامت أمُّ الهيثَمِ تَعجِنُ لهم وتخبِزُ، ووضع رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم وأبو بَكرٍ وعُمَرُ رُؤوسَهم للقائِلةِ، فانتَبَهوا وقد أدرك طعامُهم، فوُضِع الطَّعامُ بَيْنَ أيديهم وأكَلوا وشَبِعوا، وحَمِدوا اللهَ، ورَدَّت عليهم أمُّ الهيثَمِ بَقِيَّةَ الأعذاقِ، فأكلوا مِن رُطَبِه ومِن تَذنُوبِه، فسَلَّم عليهم رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم ودعا لهم»."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم] وقال: لهذا الحديث شاهد في الصحيح من حديث أبي حازم، عن أبي هريرة. \nوعبد الله بن عيسى الخزاز، قال أبو زرعة الرازي: منكر الحديث وقد أخرج له الترمذي وأبو حاتم بن حبان.\nقُلْتُ: وإذا كانت هذه القصة صحيحة فروايتهما عن عمر أولى؛ لأنه كان مع النَّبيّ صلَّى اللهُ عليه وسلَّم . والله أعلم","bab":"فضائل النبي وصفته ودلائل النبوة › تبرك الناس به","dorar":"EV1lXjy4","merged":7,"otherRefs":["تخريج مشكل الآثار 471 (صحيح)","تخريج مشكل الآثار 469 (حسن)","صحيح النسائي 3641 (صحيح)","تخريج صحيح ابن حبان 3411 (صحيح)","تخريج المسند لشعيب 15206 (صحيح)","تخريج المسند لشعيب 14637 (صحيح)"]},{"id":"س-05600","fp":"ae7534273056","stateId":600,"easy":"إذا كنت أطول الناس شبعاً في الدنيا ← تكون أكثرهم جوعاً يوم القيامة","cause":"أطْوَلُ النَّاسِ شِبَعًا في الدُّنْيا","result":"أكثَرُهم جوعًا يومَ القيامةِ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 6707","srcLabel":"الطبراني","text":["سمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، يَقولُ: الدُّنيا سِجنُ المؤمِنِ وجنَّةُ الكافِرِ. وسمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، يَقولُ: ",["أطْوَلُ النَّاسِ شِبَعًا في الدُّنْيا",1]," ",["أكثَرُهم جوعًا يومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"سلمان","muhaddith":"غريب صحيح الإسناد","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (5257) بلفظه، والطبراني (6/ 268) (6183) باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"nJxkSD3T","merged":7,"otherRefs":["السلسلة الصحيحة 7/1117 (حسن)","مجمع الزوائد 10/326 (حسن)","هداية الرواة 5/16 (حسن)","فتح الغفار 1985/4 (حسن)","صحيح الترغيب 2137 (صحيح)","سبل السلام 4/272 (حسن)"]},{"id":"ق-1457","fp":"b61157362c14","stateId":600,"easy":"الالتهاء بالتكاثر حتى الموت ← رؤية الجحيم والسؤال عن النعيم","cause":"الالتهاء بالتكاثر حتى الموت","result":"رؤية الجحيم والسؤال عن النعيم","explicit":true,"otherNeedIds":[50],"ref":"سورة التكاثر: 1–8","srcLabel":"القرآن الكريم","quran":{"s":102,"from":1,"to":8,"text":"أَلْهَاكُمُ التَّكَاثُرُ (1) حَتَّى زُرْتُمُ الْمَقَابِرَ (2) كَلَّا سَوْفَ تَعْلَمُونَ (3) ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ (4) كَلَّا لَوْ تَعْلَمُونَ عِلْمَ الْيَقِينِ (5) لَتَرَوُنَّ الْجَحِيمَ (6) ثُمَّ لَتَرَوُنَّهَا عَيْنَ الْيَقِينِ (7) ثُمَّ لَتُسْأَلُنَّ يَوْمَئِذٍ عَنِ النَّعِيمِ (8)","hl":[[0,290,1]]}},{"id":"س-06107","fp":"eca3de16df80","stateId":600,"easy":"إذا أكلت حتى شبعت ← تُسأل عن النعمة يوم القيامة","cause":"فذبَح لهم شاةً، فأكَلوا، فلمَّا شبِعوا","result":"لَتُسأَلُنَّ عن هذه النِّعمةِ يومَ القِيامةِ، أخرَجكم من بُيوتِكمُ الجوعُ، ثمَّ لمْ ترجِعوا حتى أصبْتُم هذا النَّعيمَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج مشكل الآثار 474","srcLabel":"مسلم","text":["أنَّ رسولَ اللهِ عليه السَّلامُ خرَج يومًا، فإذا هو بأبي بكْرٍ وعمرَ فقال: ما أخرَجكما هذه السَّاعةَ؟ قالا: الجوعُ يا رسولَ اللهِ، قال: وأنا والذي بعَثني بالحقِّ أخرَجني الذي أخرَجكما؛ فقُومَا. فقاما معه، فأتى رجُلًا منَ الأنصارِ، فلمْ يكُنِ الرَّجُلُ ثَمَّتَ، وإذا امرأتُهُ، فلمَّا نظَرتْ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وأبي بكْرٍ وعمرَ، قالت: مَرحبًا وأهلًا، قال نبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ: أينَ فُلانٌ؟ قالت: انطلَق يستعذِبُ لنا الماءَ، قال: فبيْنَا هم كذلك، إذْ جاء الأنصاريُّ وعليه قِرْبةٌ من ماءٍ، فلمَّا نظَر إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ وإلى صاحبَيْهِ كبَّر، ثمَّ قال: اللهُ أكبرُ، ما أحَدٌ منَ النَّاسِ من ذكَرٍ وأُنْثى أكْرَمَ أضيافًا منِّي اليومَ، فعلَّق القِرْبةَ بكِرْنافةٍ، فانطلَق فجاء بعِذْقٍ فيه تَمرٌ ورُطَبٌ وبُسْرٌ، فوضَعه بيْنَ أيديهم، فقال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: لولا اجتنَيْتَهُ، قال: تخيَّروا على أعيُنِكم يا رسولَ اللهِ، ثمَّ أخَذ المُدْيةَ، فقال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إيَّاكَ والحَلوبَ، ",["فذبَح لهم شاةً، فأكَلوا، فلمَّا شبِعوا",1]," قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: والذي نفْسي بيدِهِ ",["لَتُسأَلُنَّ عن هذه النِّعمةِ يومَ القِيامةِ، أخرَجكم من بُيوتِكمُ الجوعُ، ثمَّ لمْ ترجِعوا حتى أصبْتُم هذا النَّعيمَ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":".صحيح","takhrij":"أخرجه الطحاوي في  ((شرح مشكل الآثار)) (474) واللفظ له، ومسلم (2038)، والترمذي (2369)","bab":"رقائق وزهد › معيشة النبي صلى الله عليه وسلم","dorar":"6aE9eEAp","merged":2,"otherRefs":["التمهيد 24/339 (صحيح)"]},{"id":"س-05531","fp":"1ff893b8e581","stateId":600,"easy":"إذا تمتعت بما فوق الإزار والخبز والظل والماء ← فهو فضل تُحاسب عليه يوم القيامة","cause":"ما فوقَ الإزارِ وخلفُ الخبزِ ، وظلُّ الحائطِ وجرَّةُ الماءِ","result":"فضلٌ يحاسبُ به أو يسألُ عنه المرءُ يومَ القيامةِ","explicit":true,"ref":"البدور السافرة 195","srcLabel":"البزار","text":[["ما فوقَ الإزارِ وخلفُ الخبزِ ، وظلُّ الحائطِ وجرَّةُ الماءِ",1]," ، ",["فضلٌ يحاسبُ به أو يسألُ عنه المرءُ يومَ القيامةِ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه البزار كما في ((كشف الأستار)) للهيثمي (3643)، وأبو نعيم في ((حلية الأولياء)) (4/100) واللفظ له، وأبو منصور الديلمي كما في ((الغرائب الملتقطة)) لابن حجر (2362)","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"NSG1jIJF","merged":2,"otherRefs":["الترغيب والترهيب 4/153 (حسن)"]},{"id":"س-00436","fp":"6024f658dcc7","stateId":600,"easy":"إذا أكثرت الشبع في الدنيا ← تكون من أطول الناس جوعاً يوم القيامة","cause":"أَكثرُكم شبعًا في دارِ الدُّنيا","result":"فإنَّ أطولَكم جوعًا يومَ القيامةِ","explicit":true,"ref":"صحيح ابن ماجه 2721","srcLabel":"الترمذي","text":["تجشَّأَ رجلٌ عندَ النَّبيِّ صلَّى اللَّهُ عليْهِ وسلَّمَ فقالَ كُفَّ جشاءَكَ عنَّا ",["فإنَّ أطولَكم جوعًا يومَ القيامةِ",2]," ",["أَكثرُكم شبعًا في دارِ الدُّنيا",1]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن","takhrij":"أخرجه الترمذي (2478)، وابن ماجه (3350) واللفظ له","bab":"آداب عامة › الأخلاق المذمومة","dorar":"KoSatFLC"},{"id":"س-05560","fp":"d8577ce505a9","stateId":600,"easy":"إذا خُدمت (وتنعمت) ← وقع عليك الحساب","cause":"فإذا خُدِمَ","result":"وقع عليه الحسابُ","explicit":true,"ref":"الجامع الصغير 5649","srcLabel":"البيهقي","text":["العبدُ من اللهِ ، وهو منه ، ما لم يُخْدَمْ ، ",["فإذا خُدِمَ",1]," ",["وقع عليه الحسابُ",2],"."],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"حسن","takhrij":"أخرجه المعافى بن عمران في ((الزهد)) (33)، وابن الأعرابي في ((الزهد)) (112) واللفظ لهما، والبيهقي في ((الشعب)) (9918) بنحوه.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"89WB4tOs"},{"id":"س-05569","fp":"75ab400e224a","stateId":600,"easy":"إذا تنعمت بنعمة ← تُسأل عنها يوم القيامة","cause":"ثمَّ دعا بماءٍ باردٍ فشربَ","result":"لتُسألُنَّ عن هذا يومَ القيامةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الصحيح المسند 1240","srcLabel":"أحمد","text":["خرَجَ رسولُ اللَّهِ _ صلَّى اللَّهُ عليهِ وعلى وآلِهِ وسلَّمَ _ ليلًا ، فمَرَّ بي ، فدعاني إليهِ ، فخرجتُ . ثمَّ مرَّ بأبي بكرٍ فدعاهُ فخرجَ إليهِ ، ثمَّ مرَّ بِعُمرَ فدعاهُ فخرجَ إليهِ ، فانطلقَ حتَّى دخلَ حائِطًا لبعضِ الأنصارِ فقالَ لصاحبِ الحائطِ : أطعِمنا بُسرًا ، فجاءَ بعِذْقٍ ، فوضعَهُ فأكلَ ، فأكلَ رسولُ اللَّهِ - صلَّى اللَّهُ عليهِ وعلى وآلِهِ وسلَّمَ - وأصحابُهُ ، ",["ثمَّ دعا بماءٍ باردٍ فشربَ",1]," فقالَ : ",["لتُسألُنَّ عن هذا يومَ القيامةِ .",2]," قالَ : فأخذَ عمرُ العِذقَ فضربَ بهِ الأرضَ حتَّى تناثرَ البُسرُ قِبَلَ رسولِ اللَّهِ - صلَّى اللَّهُ عليهِ وعلى وآلِهِ وسلَّمَ - ثمَّ قالَ : يا رسولَ اللَّهِ أئنَّا لمسئولونَ عن هذا يومَ القيامةِ ؟ قالَ ؟ نعَم ، إلاَّ من ثلاثٍ : خِرقةٍ كفَّ بها الرَّجلُ عورتَهُ، أو كِسرةٍ سدَّ بها جوعَهُ، أو جحرٍ يتدخَّلُ فيهِ منَ الحرِّ والقُرِّ ."],"grade":"حسن","narrator":"أبو عسيب مولى رسول الله صلى الله عليه وسلم","muhaddith":"حسن","takhrij":"أخرجه أحمد (20768) بلفظه، وأبو نعيم في ((معرفة الصحابة)) (6920)، والبيهقي في ((شعب الإيمان)) (4281) باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"h9zD5QiI","merged":2,"otherRefs":["البدور السافرة 195 (حسن)"]},{"id":"س-05609","fp":"4b45b252bd0f","stateId":600,"easy":"إذا أثقلت ظهرك بالدنيا ← لا تجوز العقبة الكؤود (أثر أبي الدرداء)","cause":"المُثْقَلون","result":"عَقَبةً كَؤُودًا، لا يَجُوزُها المُثْقَلون","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[53],"ref":"المستدرك على الصحيحين 8939","srcLabel":"ابن الأعرابي","text":["عن أمِّ الدَّرداءِ رَضيَ اللهُ عنها، قالت: قُلتُ لأبي الدَّرداءِ: ألَا تَبْتغي لِأضيافِكَ ما يَبْتغي الرِّجالُ لِأضيافِهم؟ فقال: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: إنَّ أمامَكم ",["عَقَبةً كَؤُودًا، لا يَجُوزُها المُثْقَلون",2],"، فأُحِبُّ أنْ أتخفَّفَ لِتلكَ العَقَبةِ."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح الإسناد ولم يخرجاه","takhrij":"أخرجه ابن الأعرابي في ((معجمه)) (515)، وتمام في ((فوائده)) (1642)، وأبو نعيم في ((الحلية)) (1/ 226) واللفظ لهم.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"fcOCbeyX","merged":5,"otherRefs":["صحيح الجامع 2001 (صحيح)","صحيح الترغيب 3176 (صحيح)","صحيح الترغيب 3177 (صحيح)","سبل الهدى والرشاد 7/161 (حسن)"]},{"id":"س-07693","fp":"ec5e0d7d3e4d","stateId":601,"easy":"إذا قرأت آيات التفكر ولم تتفكر فيها ← فويل لك","cause":"لِمَن قرَأها ولم يتفكَّرْ فيها","result":"ويلٌ","explicit":true,"star":true,"otherNeedIds":[12],"ref":"تخريج صحيح ابن حبان 620","srcLabel":"مسلم","text":["عَنْ عَطَاءٍ، قَالَ: دخَلْتُ أنا وعُبيدُ بنُ عُميرٍ على عائشةَ فقالت لِعُبيدِ بنِ عُميرٍ : قد آن لك أنْ تزورَنا فقال : أقولُ يا أمَّهْ كما قال الأوَّلُ : زُرْ غِبًّا تزدَدْ حُبًّا قال : فقالت : دعُونا مِن رَطانتِكم هذه قال ابنُ عُميرٍ : أخبِرينا بأعجَبِ شيءٍ رأَيْتِه مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم قال : فسكَتَتْ ثمَّ قالت : لَمَّا كان ليلةٌ مِن اللَّيالي قال : ( يا عائشةُ ذَرِيني أتعبَّدِ اللَّيلةَ لربِّي ) قُلْتُ : واللهِ إنِّي لَأُحِبُّ قُرْبَك وأُحِبُّ ما سرَّك قالت : فقام فتطهَّر ثمَّ قام يُصَلِّي قالت : فلم يزَلْ يبكي حتَّى بَلَّ حجرَه قالت : ثمَّ بكى فلم يزَلْ يبكي حتَّى بَلَّ لِحيتَه قالت : ثمَّ بكى فلم يزَلْ يبكي حتَّى بَلَّ الأرضَ فجاء بلالٌ يُؤذِنُه بالصَّلاةِ فلمَّا رآه يبكي قال : يا رسولَ اللهِ لِمَ تَبكي وقد غفَر اللهُ لك ما تقدَّم وما تأخَّر ؟ قال : ( أفلا أكونُ عبدًا شكورًا لقد نزَلَتْ علَيَّ اللَّيلةَ آيةٌ، ",["ويلٌ",2]," ",["لِمَن قرَأها ولم يتفكَّرْ فيها",1]," {إِنَّ فِي خَلْقِ السَّمَوَاتِ وَالْأَرْضِ} [آل عمران: 190] ) الآيةَ كلَّها"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن حبان (620) واللفظ له، والطحاوي في ((مشكل الآثار)) (4618)، وأبو الشيخ في ((أخلاق النبي)) (544) بنحوه.","bab":"قرآن › آداب الناس كلهم مع القرآن","dorar":"O8dP8jdJ","merged":2,"otherRefs":["الترغيب والترهيب 2/316 (صحيح)"]},{"id":"س-03255","fp":"c25a7297dc98","stateId":601,"easy":"إذا ذُكر النبي ﷺ عندك فلم تصلِّ عليه فمت فدخلت النار ← أبعدك الله","cause":"ومن ذُكِرْتَ عندَهُ ، فلم يُصَلِّ عليكَ","result":"فماتَ ، فدخلَ النارَ ، فأبعدَهُ اللهُ","explicit":true,"star":true,"otherNeedIds":[27],"ref":"موارد الظمآن 2/900","srcLabel":"مسلم","text":["أنَّ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ صعدَ المنبَرَ ، فقال : آمينَ ، آمينَ ، آمينَ ، قيلَ : يا رسولَ اللهِ ، إنكَ صعدتَ المنبَرَ ، فقلتُ آمينَ ، آمينَ ، آمينَ ، فقال : إنَّ جبريلَ عليهِ السلامُ أتاني ، فقالَ لي : من أدركَ شهرَ رمضانَ فلم يُغفرْ لهُ ، فدخلَ النارَ فأبعدَهُ اللهُ ، قلْ : آمينَ ، فقلتُ : آمينَ ، ومن أدركَ أبويْهِ ، أو أحدَهما ، فلم يَبَرَّهما ، فماتَ ، فدخلَ النارَ ، فأبعدَهُ اللهُ ، قلْ : آمينَ ، فقلتُ : آمينَ ، ",["ومن ذُكِرْتَ عندَهُ ، فلم يُصَلِّ عليكَ",1]," ، ",["فماتَ ، فدخلَ النارَ ، فأبعدَهُ اللهُ",2]," ، قلْ آمينَ ، فقلتُ : آمينَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"في صحيح مسلم منه ما يتعلق ببر الوالدين بنحوه فقط","takhrij":"أخرجه ابن خزيمة (1888)، وابن حبان (907)، والطبراني في ((المعجم الأوسط)) (8131) باختلاف يسير. وقوله: \"ومن أدرك أبويه أو أحدهما فلم يبرهما فمات فدخل النار فأبعده الله\" أخرجه مسلم (2551) بلفظ مقارب","bab":"استغفار › أسباب المغفرة","dorar":"wrNPaZCt"},{"id":"س-07431","fp":"19bbcd9d0cc5","stateId":601,"easy":"إذا رأيت المنكر فلم تنكره ← يسألك الله يوم القيامة: ما منعك؟","cause":"ما منَعكَ إذا رأَيْتَ المُنكَرَ أنْ تُنكِرَه","result":"يسأَلُ العبدَ يومَ القيامةِ","explicit":true,"star":true,"ref":"صحيح ابن حبان 7368","srcLabel":"ابن ماجه","text":["إنَّ اللهَ جلَّ وعلا ",["يسأَلُ العبدَ يومَ القيامةِ",2]," حتَّى إنَّه لَيقولُ له : ",["ما منَعكَ إذا رأَيْتَ المُنكَرَ أنْ تُنكِرَه",1]," ؟ فإذا لقَّن اللهُ عبدًا حُجَّتَه يقولُ : يا ربِّ وثِقْتُ بكَ وفرِقْتُ مِن النَّاسِ أو فرِقْتُ مِن النَّاسِ ووثِقْتُ بكَ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن ماجه (4017)، وأحمد (11245) باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"DvOA3E7j","merged":4,"otherRefs":["تخريج العواصم والقواصم 5/ 351 (صحيح)","هداية الرواة 5081 (حسن)","صحيح الجامع 1818 (صحيح)"]},{"id":"س-04936","fp":"b154572394db","stateId":601,"easy":"إذا تعلمت القرآن ثم نسيته ← تلقى الله أجذم","cause":"ومَن تَعلَّمَ القُرآنَ ثُمَّ نَسيَه","result":"لَقيَ اللهَ وهو أجذَمُ","explicit":true,"similar":["س-03087"],"ref":"تخريج المسند لشعيب 22781","srcLabel":"أحمد","text":["ما مِن أميرِ عَشَرةٍ إلَّا جِيء به يومَ القِيامةِ مَغلولةً يدُه إلى عُنُقِه حتى يُطلِقَه الحَقُّ أو يُوبِقَه، ",["ومَن تَعلَّمَ القُرآنَ ثُمَّ نَسيَه، ",1],["لَقيَ اللهَ وهو أجذَمُ",2],"."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح لغيره دون قوله: \"ومن تعلم القرآن ... إلخ\"","takhrij":"أخرجه أحمد (22758)، وعبدالله بن أحمد في ((زوائد المسند)) (22781) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"CA2b8qvX","merged":2,"otherRefs":["تخريج المسند لشعيب 22456 (صحيح)"]},{"id":"س-05042","fp":"620763a861a8","stateId":601,"easy":"إذا اجترأت على الفتيا في الجد (المواريث) ← فأنت أجرأ على النار","cause":"أجرؤُكم على الجِدِّ","result":"أجرؤُكم على النارِ","explicit":true,"ref":"المحلى 9/282","srcLabel":"ابن المنذر","text":["أن عمرَ بنَ الخطابِ قال ",["أجرؤُكم على الجِدِّ",1]," ",["أجرؤُكم على النارِ",2]," وإنما يجترئُ على الجِدِّ من يجترئُ على النارِ"],"grade":"صحيح","narrator":"سعيد بن المسيب","muhaddith":"إسناده ثابت","takhrij":"أخرجه ابن المنذر في ((الأوسط)) (6824) مختصرا","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"9wEqRXwz","merged":2,"otherRefs":["إرواء الغليل 6/129 (حسن)"]},{"id":"س-02924","fp":"c965ec40e071","stateId":601,"easy":"إذا جعلت القرآن خلفك ← يسوقك إلى النار","cause":"ومَنْ جعلَهُ خلْفَهُ","result":"ساقَهُ إلى النارِ","explicit":true,"ref":"صحيح الجامع 4443","srcLabel":"صحيح الجامع","text":["القرآنُ شافع مُشفَّعٌ ، وماحِلٌ مصدَّقٌ ، مَنْ جعلَهُ أمامَهُ قادَهُ إلى الجنةِ ، ",["ومَنْ جعلَهُ خلْفَهُ",1]," ",["ساقَهُ إلى النارِ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله وابن مسعود","muhaddith":"صحيح","bab":"إيمان › الوعيد","dorar":"BSET0YTU"},{"id":"س-03087","fp":"c2286c3cea37","stateId":601,"easy":"إذا قرأت القرآن ثم نسيته ← تلقى الله يوم القيامة أجذم","cause":"ما من امرئٍ يقرأُ القرآنَ ثمَّ ينساه","result":"إلَّا لقي اللهَ يومَ القيامةِ أجذمَ","explicit":true,"repOf":"س-04936","ref":"الفتاوى لابن عبدالوهاب 47","text":["حديثُ الوعيدِ فيمَن حفِظ القرآنَ ثم نسِيَه [يعني حديث: ",["ما من امرئٍ يقرأُ القرآنَ ثمَّ ينساه",1]," ",["إلَّا لقي اللهَ يومَ القيامةِ أجذمَ",2],"]"],"grade":"صحيح","narrator":"[سعد بن عبادة]","muhaddith":"ثابت عند أهل الحديث","takhrij":"أخرجه أبو داوود (1474)، والبيهقي في ((الشعب)) (1818) واللفظ لهم.ا، وأحمد (22456) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"s0IwWOG2"},{"id":"س-06125","fp":"0276e0a32491","stateId":601,"easy":"إذا رأيت أمراً لله فيه مقال فلم تقل ← يقال لك يوم القيامة: ما منعك؟","cause":"أن يرى أمرًا للَّهِ فيهِ مقالٌ ، فلا يقولُ فيهِ","result":"فيقالُ لَهُ يومَ القيامةِ : ما منعَكَ أن تَكونَ","explicit":true,"similar":["س-06124"],"ref":"عمدة التفسير 1/701","srcLabel":"ابن ماجه","text":["لا يحقِرنَّ أحدُكُم نفسَهُ ",["أن يرى أمرًا للَّهِ فيهِ مقالٌ ، فلا يقولُ فيهِ",1]," ، ",["فيقالُ لَهُ يومَ القيامةِ : ما منعَكَ أن تَكونَ",2]," قلتَ فيَّ كذا وَكَذا ؟ فيقولُ : مخافةَ النَّاسِ . فيقولُ : إيَّايَ أحقُّ أن تخافَ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (4008)، وأحمد (11255) باختلاف يسير","bab":"رقائق وزهد › من أرضى الناس بسخط الله","dorar":"yaOrumDD"},{"id":"س-07864","fp":"9ae0aa0c16f2","stateId":601,"easy":"إذا دعوت إلى شيء ← تقف يوم القيامة لازماً لدعوتك","cause":"ما من داعٍ يدعو لشيءٍ","result":"إلا وقفَ يومَ القيامةِ لازِمًا لدعوتِهِ ما دعا إليه","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 1/98","srcLabel":"الزواجر عن اقتراف الكبائر","text":[["ما من داعٍ يدعو لشيءٍ",1]," ",["إلا وقفَ يومَ القيامةِ لازِمًا لدعوتِهِ ما دعا إليه",2]," وإن دعا رجلٌ رجلًا"],"grade":"صحيح","muhaddith":"صحيح","bab":"قيامة › الحساب والقصاص","dorar":"Z0QgHoah"},{"id":"س-05557","fp":"f4b1c98ad100","stateId":601,"easy":"إذا تعلمت علماً ولم تعمل به ← يكون وبالاً عليك يوم القيامة","cause":"كلُّ علمٍ","result":"وبالٌ على صاحبِه يومَ القيامةِ إلَّا مَن عملَ بِهِ","explicit":true,"otherNeedIds":[16],"ref":"الجامع الصغير 6270","srcLabel":"الطبراني","text":["كلُّ بُنيانٍ وبَالٌ على صاحبِه إلَّا ما كانَ هَكذا وأشارَ بِكفِّهِ، وَ",["كلُّ علمٍ",1]," ",["وبالٌ على صاحبِه يومَ القيامةِ إلَّا مَن عملَ بِهِ",2]],"grade":"حسن","narrator":"واثلة بن الأسقع الليثي أبو فسيلة","muhaddith":"حسن","takhrij":"أخرجه الطبراني (131) (22 / 55) بلفظه","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"fziZtAXd"},{"id":"س-06124","fp":"bdc70e108bd7","stateId":601,"easy":"إذا رأيت أمراً لله عليك فيه مقال ثم لم تقل ← يقول الله يوم القيامة: ما منعك أن تقول فيه؟","cause":"يرَى أمرًا للهِ عليهِ فيهِ مقالٌ ثُمَّ لا يقولُ فيهِ","result":"فيقولُ اللهُ عزَّ وجلَّ [ لهُ ] يومَ القيامةِ : ما منعَكَ أنْ تقولَ في كذا وكذا فيقولُ : خَشِيتُ الناسَ","explicit":true,"repOf":"س-06125","ref":"الفتح الرباني 11/5448","text":["لا يَحْقِرَنَّ أحدُكُمْ نفسَهُ ، قالوا : يا رسولَ اللهِ ، وكَيْفَ يَحقِرُ أحدُنا نفسَهُ ؟ قال : ",["يرَى أمرًا للهِ عليهِ فيهِ مقالٌ ثُمَّ لا يقولُ فيهِ",1]," ! ",["فيقولُ اللهُ عزَّ وجلَّ [ لهُ ] يومَ القيامةِ : ما منعَكَ أنْ تقولَ في كذا وكذا فيقولُ : خَشِيتُ الناسَ !",2]," قال : فأنا كُنْتُ أحقُّ أنْ تَخْشَى"],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"رجال إسناده ثقات","takhrij":"أخرجه ابن ماجه (4008) واللفظ له، وأحمد (11255) باختلاف يسير","bab":"رقائق وزهد › من أرضى الناس بسخط الله","dorar":"T1G1CynB"},{"id":"س-07691","fp":"54f60b21f9d5","stateId":601,"easy":"إذا تركت القرآن أو أعرضت عنه ← يُزج في قفاك إلى النار","cause":"ومن ترَكَهُ أو أعرضَ عنهُ","result":"زَجَّ في قفاهُ إلى النَّارِ","explicit":true,"ref":"الترغيب والترهيب 1/62","srcLabel":"الترغيب والترهيب","text":["عن عبدِ اللَّهِ بنِ مسعودٍ قالَ إنَّ هذا القرآنَ شافعٌ مشفَّعٌ ومنِ اتَّبعَهُ قادَهُ إلى الجنَّةِ ",["ومن ترَكَهُ أو أعرضَ عنهُ",1]," ( أو كلمةً نحوَها ) ",["زَجَّ في قفاهُ إلى النَّارِ",2]],"grade":"حسن","muhaddith":"[روي] مرفوعا من حديث جابر وإسناد المرفوع جيد","bab":"قرآن › آداب الناس كلهم مع القرآن","dorar":"V1VHEACZ"},{"id":"س-02999","fp":"250592c05b82","stateId":601,"easy":"إذا فسقت وأنت حامل للقرآن ← فالزبانية أسرع إليك من عبدة الأوثان","cause":"فسقةِ حملةِ القرآنِ","result":"لَلزبانيةُ أسرعُ إلى","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تنزيه الشريعة 1/270","srcLabel":"الديلمي","text":[["لَلزبانيةُ أسرعُ إلى",2]," ",["فسقةِ حملةِ القرآنِ",1]," منهم إلى عبدةِ الأوثانِ فيقولون يبدأُ بنا قبلَ عبدةِ الأوثانِ فيُقالُ لهم ليس مَنْ عَلِمَ كمن لا يعلمُ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"رجاله موثقون ما خلا موسى بن محمد بن كثير السيريني","takhrij":"أخرجه الديلمي في ((الفردوس)) (3376)، وابن الجوزي في ((الموضوعات)) (1/266) واللفظ له","bab":"إيمان › الوعيد","dorar":"h2dnMxKR"},{"id":"س-03663","fp":"1109c1a3bcfd","stateId":601,"easy":"إذا خالفت أمر القرآن ← يكبّك على صخرة في النار","cause":"قد كان حملَه فخالَف أمرَه","result":"حتَّى يَكبَّه على صخرةٍ في النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"المطالب العالية 4/73","srcLabel":"ابن أبي شيبة","text":["يتمثَّلُ القرآنُ يومَ القيامةِ ، فيُؤتى بالرَّجلِ ",["قد كان حملَه [ فخالَف أمرَه",1]," ] ، فيتمثَّلُ خصمُا دونَه ، قال : فيقولُ : يا ربِّ ، حَمَّلتَه إيَّايَ ، فشرُّ حاملٍ ، تعدَّى حدودي ، وضيَّع فرائِضي ، وركِب معصيتي ، وترَك طاعتي ، فما يزالُ يقذِفُ عليهِ بالحُجَجِ حتَّى يُقالَ : فشأنَك بهِ ، فيأخذُ بيدِه ما يُرسلُه ",["حتَّى يَكبَّه على صخرةٍ في النَّارِ",2]," ، ويُؤتى بالعَبدِ الصالِحِ قد كان حملَه فحفِظ أمرَه ، فيتمثَّلُ خصمًا دونَه فيقولُ : يا ربِّ ، حمَّلتَه إيَّايَ فكان خيرَ حاملٍ ، حفِظ حدودي ، وعمِلَ بفرائضي ، واجتَنب مَعصيتي ، وعمِل بطاعَتي ، وما يزالُ يقذفُ لهُ بالحُججِ حتَّى يُقالَ [ لهُ ] : شأنُك بهِ ، فيأخذُ بيدِه فما يُرسلُه حتَّى يكسوَه حُلَّةَ الإستَبرقِ ، ويَعقدَ عليهِ تاجَ الملكِ ، ويَسقيَه كأسَ الخَمرِ"],"grade":"حسن","narrator":"[جد عمرو بن شعيب]","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن أبي شيبة (30044) واللفظ له، وابن شاهين في ((الترغيب)) (207)، والخطيب في ((اقتضاء العلم)) (112) بنحوه.","bab":"اعتصام بالسنة › الأمر بالتمسك بالكتاب والسنة","dorar":"8ONK4OdI"},{"id":"س-08335","fp":"f6029fd6e063","stateId":602,"easy":"إذا أثنى عليك المؤمنون شراً ← وجبت لك النار","cause":"ومَن أثنَيتُم عليه شَرًّا","result":"وجَبَت له النَّارُ","explicit":true,"star":true,"similar":["س-04117"],"ref":"صحيح مسلم 949","srcLabel":"متفق عليه","text":["مُرَّ بجِنازةٍ فأُثنيَ عليها خَيرًا، فقال نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّم: وجَبَت، وجَبَت، وجَبَت، ومُرَّ بجِنازةٍ فأُثنيَ عليها شَرًّا، فقال نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّم: وجَبَت، وجَبَت، وجَبَت، قال عُمَرُ: فِدًى لكَ أبي وأُمِّي، مُرَّ بجِنازةٍ، فأُثنيَ عليها خَيرٌ، فقُلتَ: وجَبَت، وجَبَت، وجَبَت، ومُرَّ بجِنازةٍ، فأُثنيَ عليها شَرٌّ، فقُلتَ: وجَبَت، وجَبَت، وجَبَت، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: مَن أثنَيتُم عليه خَيرًا وجَبَت له الجَنَّةُ، ",["ومَن أثنَيتُم عليه شَرًّا ",1],["وجَبَت له النَّارُ",2],"، أنتُم شُهَداءُ اللهِ في الأرضِ، أنتُم شُهَداءُ اللهِ في الأرضِ، أنتُم شُهَداءُ اللهِ في الأرضِ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1367)، ومسلم (949).","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"6C8bFfIJ","merged":11,"otherRefs":["مجموع الفتاوى 28/371 (صحيح)","شرح الطحاوية 378 (صحيح)","تخريج المسند لشعيب 10076 (صحيح)","صحيح البخاري 2642 (صحيح)","تخريج المسند لشعيب 13996 (صحيح)","صحيح النسائي 1932 (صحيح)","تخريج المسند لشعيب 10471 (صحيح)","تخريج المسند لشعيب 10836 (صحيح)","تخريج المسند لشعيب 10013 (صحيح)","تخريج المسند لشعيب 7552 (صحيح)"]},{"id":"س-05275","fp":"6d2d8f09d8d8","stateId":602,"easy":"إذا قطعت سدرة (يستظل بها الناس) ← يصوّب الله رأسك في النار","cause":"مَن قَطَعَ سِدْرةً","result":"صَوَّبَ اللهُ رَأسَه في النَّارِ","explicit":true,"star":true,"similar":["س-04805"],"ref":"الأحاديث المختارة 9 / 237","srcLabel":"متفق عليه","text":["«",["مَن قَطَعَ سِدْرةً",1]," ",["صَوَّبَ اللهُ رَأسَه في النَّارِ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن حبشي الخثعمي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"qAKlUB9R","merged":2,"otherRefs":["صحيح الجامع 4299 (صحيح)"]},{"id":"س-02301","fp":"261ca54f8b70","stateId":602,"easy":"إذا ساء خلقك ← قد يبلغ بك أسفل جهنم","cause":"وإنَّه لَيَبلُغُ بسُوءِ خُلُقِه","result":"أسفَلَ جَهَنَّمَ","explicit":true,"similar":["س-03082"],"ref":"الأحاديث المختارة 1812","srcLabel":"البخاري","text":["«إنَّ العَبْدَ لَيَبْلُغُ بحُسْنِ خُلُقِه عَظيمَ دَرَجاتِ الآخِرةِ وشَرَفَ المنازِلِ، وإنَّه لضَعيفُ العبادةِ، ",["وإنَّه لَيَبلُغُ بسُوءِ خُلُقِه",1]," ",["أسفَلَ جَهَنَّمَ",2]," وهو عابِدٌ»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Kwct6BL4"},{"id":"س-08425","fp":"bc6155c91630","stateId":602,"easy":"إذا نظرت في كتاب أخيك بغير إذنه ← فكأنما تنظر في النار","cause":"ومَن نظَرَ في كتابِ أخيهِ بغيرِ إذنِهِ","result":"فكأنَّما يَنظُرُ في النَّارِ","explicit":true,"similar":["س-05064"],"ref":"المستدرك على الصحيحين 7916","srcLabel":"عبد بن حميد","text":["عنْ مُحمَّدِ بنِ كعْبٍ القُرَظِيِّ، قالَ: شَهِدْتُ عُمَرَ بنَ عبدِ العزيزِ وهو أميرٌ علينا بالمدينةِ للوَليدِ بنِ عبدِ المَلِكِ، وهو شابٌّ غليظٌ مُمتلِئُ الجِسْمِ، فلَمَّا استُخْلِفَ أتَيتُه بخُناصِرَةَ، فدَخلْتُ عليهِ وقد قاسَى ما قاسَى، فإذا هو قدْ تغيَّرَتْ حالتُهُ عمَّا كان، ثُمَّ ذَكَرَ الحديثَ. \n وزادَ فيهِ: ",["ومَن نظَرَ في كتابِ أخيهِ بغيرِ إذنِهِ، ",1],["فكأنَّما يَنظُرُ في النَّارِ، ",2],"ومَن أحَبَّ أنْ يكونَ أقوى النَّاسِ فلْيَتوكَّلْ على اللهِ، ومَن أحَبَّ أنْ يكونَ أكرَمَ النَّاسِ فلْيَتَّقِ اللهَ عزَّ وجلَّ، ومَن أحَبَّ أنْ يكونَ أغْنى النَّاسِ فلْيَكُنْ بما في يَدِ اللهِ أوثَقَ ممَّا في يَدِهِ.\n وقالَ: أفأُنَبِّئُكُم بشَرٍّ مِن هذا؟ قالوا: نعَمْ يا رسولَ اللهِ، قالَ: مَن لا يُقيلُ عثْرَةً، ولا يَقبَلُ مَعذرةً، ولا يَغفِرُ ذنْبًا، أفأُنبِّئُكُم بشَرٍّ مِن هذا؟ قالوا: نعَمْ يا رسولَ الله. قالَ: مَن لا يُرجَى خَيرُه، ولا يُؤمَنُ شَرُّه. إنَّ عِيسى ابنَ مريمَ صلَواتُ اللهِ عليه قامَ في بني إسرائيلَ، فقالَ: يا بَني إسرائيلَ، لا تتَكَلَّموا بالحكمةِ عندَ الجاهلِ فتَظْلِموها، ولا تَمْنَعوها أهْلَها فتَظْلِموهُم، ولا تَظْلِموا ظالِمًا، ولا تُكافِئوا ظالِمًا؛ فيَبْطُلَ فضْلُكُم عندَ رَبِّكم، يا بَني إسرائيلَ، الأمْرُ ثَلاثٌ: أمْرٌ تَبيَّنَ غَيُّهُ فاجْتَنِبوه، وأمْرٌ اختُلِفَ فيه فرُدُّوهُ إلى اللهِ عزَّ وجلَّ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه عبد بن حميد ((المنتخب من مسنده)) (675)، ابن أبي أسامة ((مسند الحارث)) (1070)، وأبو طاهر المخلص في ((المخلصيات)) (21) بنحوه","bab":"مناقب وفضائل › فضائل جمع من الصحابة والتابعين","dorar":"phOdyaJA","merged":3,"otherRefs":["الجامع الصغير 8450 (حسن)","النوافح العطرة 360 (حسن)"]},{"id":"س-02945","fp":"2a1e7415d3b6","stateId":602,"easy":"إذا أتيت قوماً فقالوا لك «قحطاً» (لسوء فعلك) ← فقحطاً لك يوم القيامة","cause":"وإذا أتى الرجلُ القومَ فقالوا لهُ : قَحْطًا","result":"فقَحْطًا لهُ يومَ القيامةِ","explicit":true,"otherNeedIds":[39],"ref":"الجامع الصغير 340","srcLabel":"أحمد","text":["إذا أتى الرجلُ القومَ فقالوا لهُ: مرحبًا ، فمرحبًا بهِ يومَ القيامةِ يومَ يلقى ربَّهُ ، ",["وإذا أتى الرجلُ القومَ فقالوا لهُ : قَحْطًا",1]," ، ",["فقَحْطًا لهُ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"الضحاك بن قيس","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (8/ 298)\n(8136)، والحاكم (6235)، وأحمد في ((الزهد)) (1375) جميعهم باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"ccFZ9N5U"},{"id":"س-04805","fp":"3fbc93d817a6","stateId":602,"easy":"إذا قطعت السدر (الذي يُنتفع به) ← تُصب في النار على رأسك","cause":"إنَّ الَّذينَ يقطعونَ السِّدْرَ","result":"يُصبُّونَ في النَّارِ على رُؤوسِهمْ صبًّا","explicit":true,"repOf":"س-05275","ref":"صحيح الجامع 1696","text":[["إنَّ الَّذينَ يقطعونَ السِّدْرَ",1]," ",["يُصبُّونَ في النَّارِ على رُؤوسِهمْ صبًّا",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه البيهقي (12105) واللفظ له، وأخرجه الطحاوي في ((شرح مشكل الآثار)) (2976)، والطبراني في ((المعجم الأوسط)) (5615) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ZXZTdNeB"},{"id":"س-05277","fp":"8f4cced69bfd","stateId":602,"easy":"إذا قطعت سدرة ← يصب الله عليك العذاب صباً","cause":"مَن قَطَعَ سِدرةً","result":"صَبَّ اللهُ عليه العَذابَ فوقَ رَأسِه صَبًّا","explicit":true,"ref":"العلل المتناهية 2/167","srcLabel":"العلل المتناهية","text":[["مَن قَطَعَ سِدرةً ",1],["صَبَّ اللهُ عليه العَذابَ فوقَ رَأسِه صَبًّا",2]],"grade":"صحيح","narrator":"الزبير","muhaddith":"ليس فيه حديث صحيح","takhrij":"لم نقف عليه إلا عند ابن الجوزي في ((العلل المتناهية)) (1090).","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"OVYU7KVP"},{"id":"س-03082","fp":"658c01c6fced","stateId":602,"easy":"إذا ساء خلقك ← قد تبلغ أسفل دركات جهنم","cause":"وإنَّ العبدَ ليبلغُ مِنْ سوءِ خُلقِهِ","result":"أسفلَ درَكِ جهنمَ","explicit":true,"repOf":"س-02301","ref":"إتقان ما يحسن 2/517","text":["أنَّ العبدَ ليبلُغُ بحُسنِ خلقِهِ درجاتِ الآخرةِ وشرفَ المنازلِ وإنهُ لضعيفُ العبادةِ ",["وإنَّ العبدَ ليبلغُ مِنْ سوءِ خُلقِهِ",1]," ",["أسفلَ درَكِ جهنمَ",2]," وإنهُ لقويُّ العبادةِ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده جيد","bab":"إيمان › الوعيد","dorar":"0fh6pc4W"},{"id":"س-04117","fp":"f708d939c2f9","stateId":602,"easy":"إذا أثنى عليك المؤمنون شراً لفظاظتك ← وجبت لك النار","cause":"بئسَ المَرْءُ ما عَلِمْنا؛ إنْ كان لفظًّا غليظًا","result":"وَجَبَتْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-08335","ref":"المستدرك على الصحيحين 3102","text":["كنتُ مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في جِنازةٍ فينا في بني سَلِمَةَ، وأنا أمْشي إلى جنبِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ رَجلٌ: نِعْمَ المَرْءُ ما عَلِمْنا؛ إنْ كان لعَفيفًا مُسلمًا، إنْ كان. فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «أنتَ الَّذي تقولُ؟». قالَ: يا رسولَ اللهِ، ذاك بَدا لنا، واللهُ أعلمُ بالسَّرائرِ. فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «وَجَبَتْ». قالَ: وكنَّا معه في جِنازةِ رَجلٍ مِن بني حارِثَةَ -أوْ مِن بني عبدِ الأشْهَلِ- فقالَ رَجلٌ: ",["بئسَ المَرْءُ ما عَلِمْنا؛ إنْ كان لفظًّا غليظًا",1],"، إنْ كان، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «أنتَ الَّذي تقولُ؟». قالَ: يا رسولَ اللهِ، اللهُ أعلمُ بالسَّرائرِ، فأمَّا الَّذي بَدا لنا منه فذاك، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «",["وَجَبَتْ",2],"». ثُمَّ تلا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: {وَكَذَلِكَ جَعَلْنَاكُمْ أُمَّةً وَسَطًا لِتَكُونُوا شُهَدَاءَ عَلَى النَّاسِ وَيَكُونَ الرَّسُولُ عَلَيْكُمْ شَهِيدًا} [البقرة: 143]."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح الإسناد","bab":"جنائز وموت › الثناء على الجنازة والعكس","dorar":"c2FVgvzE"},{"id":"س-04118","fp":"5548bca70758","stateId":602,"easy":"إذا ذمّك الصالحون بحق ← وجبت لك النار","cause":"فكأَنَّ الناسَ نالوا منه","result":"وجبَتْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 7/3","srcLabel":"أبو داود","text":["كنَّا عندَ النبيِّ صلَّى اللهُ عليه وسلَّم فَأُتِي بِجَنَازَةٍ فأَثْنى الناسُ علَيْهَا خَيْرًا فقال النبيُّ صلَّى اللهُ عليه وسلَّم وجَبَتْ ثمَّ أُتِي بِأُخْرَى ",["فكأَنَّ الناسَ نالوا منه",1]," فقال النبيُّ صلَّى اللهُ عليه وسلَّم ",["وجبَتْ",2]," فقال أصحابُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم أُتِيَ بفلانٍ فقال وجبَتْ وأُتِي بفلانٍ فقال وجَبَتْ فقال عمرُ بِأَبي أَنْتَ وَأُمِّي أُتِيَ بِفُلانٍ فأَثْنَى الناسُ عليه خيرًا فقلْتَ وجبَتْ ثمَّ أُتِيَ بفلانٍ فأَثْنَى الناسُ عليه شرًّا فقلْتَ وجبَتْ فقال أُتِي بِأَخِيكُمْ فشهدتُّمْ بما شَهِدتُّم فوجبَتْ شهادَتُكُمْ ثمَّ أُتِي بأخيكم فلانٌ فشَهِدتُّم بما شَهِدتُّم فوَجَبَتْ شهادَتُكُمْ أنتم شهداءُ اللهِ في الأرضِ بَعْضُكُمْ على بعْضٍ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أبو داود (3233)، والنسائي (1933)، وابن ماجه (1492)، وأحمد (7552) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (2515) واللفظ له","bab":"جنائز وموت › الثناء على الجنازة والعكس","dorar":"GsOZucda"},{"id":"س-05064","fp":"7c7431d2c394","stateId":602,"easy":"إذا نظرت في كتاب أخيك بغير إذنه ← فكأنما نظرت في النار","cause":"مَن نظَر في كتابِ أخيه بغيرِ إذنِه فكأنَّه نظَر","result":"في النارِ","explicit":true,"repOf":"س-08425","ref":"إتحاف الخيرة المهرة 6/139","text":[["مَن نظَر في كتابِ أخيه بغيرِ إذنِه فكأنَّه نظَر ",1],["في النارِ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده رجاله ثقات","takhrij":"أخرجه مطولاً عبدالله بن أحمد في ((زوائد الزهد)) (1707)، والعقيلي في ((الضعفاء الكبير)) (4/340)، وابن حبان في ((المجروحين)) (2/348) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"rC2VTUl7"},{"id":"س-03923","fp":"305f2e867677","stateId":603,"easy":"إذا نوقشت الحساب ← عُذبت","cause":"مَن حُوسِبَ","result":"عُذِّبَ","explicit":true,"star":true,"ref":"الصحيح المسند 1584","srcLabel":"متفق عليه","text":["قُلْتُ: يا رَسولَ اللهِ، إنِّي لَأَعلَمُ أَشَدَّ آيةٍ في كِتابِ اللهِ عَزَّ وجَلَّ، قالَ: «أيَّةُ آيةٍ يا عائِشةُ؟»، قالَتْ: قَوْلُ اللهِ تَعالى: {مَنْ يَعْمَلْ سُوءًا يُجْزَ بِهِ}، قالَ: «أَمَا عَلِمْتِ يا عائِشةُ أنَّ المُؤمِنَ تُصيبُه النَّكْبةُ أو الشَّوْكةُ فيُكافَأُ بأَسوَأِ عَمَلِه، و",["مَن حُوسِبَ",1]," ",["عُذِّبَ",2],"؟»، قالَتْ: أليس اللهُ يقولُ: {فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا}، قالَ: «ذاكم العَرْضُ يا عائِشةُ، مَن نُوقِشَ الحِسابَ عُذِّبَ»."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"حسن على شرط مُسلِم","takhrij":"أخرجه أبو داود (3093) واللفظ له، والبخاري (103)، ومسلم (2876) بنحوه.","bab":"تفسير آيات › سورة النساء","dorar":"UWkx5CGr","merged":3,"otherRefs":["صحيح البخاري 103 (صحيح)","تخريج المسند لشعيب 24958 (صحيح)"]},{"id":"س-07866","fp":"6efe5ea5e943","stateId":603,"easy":"إذا نوقشت الحساب ← هلكت","cause":"نوقشَ الحسابَ","result":"هلَكَ","explicit":true,"star":true,"ref":"الزواجر عن اقتراف الكبائر 2/242","srcLabel":"متفق عليه","text":["من ",["نوقشَ الحسابَ",1]," ",["هلَكَ",2]," [يعني حديث: ليسَ أحَدٌ يُحاسَبُ إلَّا هَلَكَ قالَتْ: قُلتُ: يا رَسولَ اللَّهِ جَعَلَنِي اللَّهُ فِداءَكَ، أليسَ يقولُ اللَّهُ عزَّ وجلَّ: {فَأَمَّا مَن أُوتِيَ كِتابَهُ بيَمِينِهِ فَسَوْفَ يُحاسَبُ حِسابًا يَسِيرًا} قالَ: ذاكَ العَرْضُ يُعْرَضُونَ ومَن نُوقِشَ الحِسابَ هَلَكَ.]"],"grade":"صحيح","narrator":"[عائشة أم المؤمنين]","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (4939) مطولاً، ومسلم (2876) واللفظ له","bab":"قيامة › الحساب والقصاص","dorar":"EdZcaJif","merged":2,"otherRefs":["تخريج كتاب السنة 885 (صحيح)"]},{"id":"س-03253","fp":"40a29f831d57","stateId":603,"easy":"إذا أدركت رمضان فلم يُغفر لك فدخلت النار ← أبعدك الله","cause":"من أدركَ شهرَ رمضانَ فلم يُغفرْ لهُ","result":"فدخلَ النارَ فأبعدَهُ اللهُ","explicit":true,"star":true,"otherNeedIds":[50],"ref":"موارد الظمآن 2/900","srcLabel":"مسلم","text":["أنَّ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ صعدَ المنبَرَ ، فقال : آمينَ ، آمينَ ، آمينَ ، قيلَ : يا رسولَ اللهِ ، إنكَ صعدتَ المنبَرَ ، فقلتُ آمينَ ، آمينَ ، آمينَ ، فقال : إنَّ جبريلَ عليهِ السلامُ أتاني ، فقالَ لي : ",["من أدركَ شهرَ رمضانَ فلم يُغفرْ لهُ ، ",1],["فدخلَ النارَ فأبعدَهُ اللهُ",2]," ، قلْ : آمينَ ، فقلتُ : آمينَ ، ومن أدركَ أبويْهِ ، أو أحدَهما ، فلم يَبَرَّهما ، فماتَ ، فدخلَ النارَ ، فأبعدَهُ اللهُ ، قلْ : آمينَ ، فقلتُ : آمينَ ، ومن ذُكِرْتَ عندَهُ ، فلم يُصَلِّ عليكَ ، فماتَ ، فدخلَ النارَ ، فأبعدَهُ اللهُ ، قلْ آمينَ ، فقلتُ : آمينَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"في صحيح مسلم منه ما يتعلق ببر الوالدين بنحوه فقط","takhrij":"أخرجه ابن خزيمة (1888)، وابن حبان (907)، والطبراني في ((المعجم الأوسط)) (8131) باختلاف يسير. وقوله: \"ومن أدرك أبويه أو أحدهما فلم يبرهما فمات فدخل النار فأبعده الله\" أخرجه مسلم (2551) بلفظ مقارب","bab":"استغفار › أسباب المغفرة","dorar":"wrNPaZCt"},{"id":"ق-0208","fp":"ee36a6ac3ce2","stateId":603,"easy":"تسويف التوبة حتى حضور الموت ← لا تُقبل التوبة","cause":"تسويف التوبة حتى حضور الموت","result":"لا تُقبل التوبة","explicit":true,"star":true,"otherNeedIds":[59],"ref":"سورة النساء: 18","srcLabel":"القرآن الكريم","quran":{"s":4,"from":18,"to":18,"text":"وَلَيْسَتِ التَّوْبَةُ لِلَّذِينَ يَعْمَلُونَ السَّيِّئَاتِ حَتَّى إِذَا حَضَرَ أَحَدَهُمُ الْمَوْتُ قَالَ إِنِّي تُبْتُ الْآنَ وَلَا الَّذِينَ يَمُوتُونَ وَهُمْ كُفَّارٌ أُولَئِكَ أَعْتَدْنَا لَهُمْ عَذَابًا أَلِيمًا (18)","hl":[[0,127,1]]}},{"id":"ق-0843","fp":"789b8447c043","stateId":603,"easy":"خفة الموازين ← خسران النفس والخلود في جهنم","cause":"خفة الموازين","result":"خسران النفس والخلود في جهنم","explicit":true,"star":true,"otherNeedIds":[50],"ref":"سورة المؤمنون: 103","srcLabel":"القرآن الكريم","quran":{"s":23,"from":103,"to":103,"text":"وَمَنْ خَفَّتْ مَوَازِينُهُ فَأُولَئِكَ الَّذِينَ خَسِرُوا أَنْفُسَهُمْ فِي جَهَنَّمَ خَالِدُونَ (103)","hl":[[0,96,1]]}},{"id":"ق-1456","fp":"2589a8c1f999","stateId":603,"easy":"خفة الموازين ← أمّه هاوية","cause":"خفة الموازين","result":"أمّه هاوية","explicit":true,"ref":"سورة القارعة: 8–9","srcLabel":"القرآن الكريم","quran":{"s":101,"from":8,"to":9,"text":"وَأَمَّا مَنْ خَفَّتْ مَوَازِينُهُ (8) فَأُمُّهُ هَاوِيَةٌ (9)","hl":[[0,58,1]]}},{"id":"س-06918","fp":"2961f8ebe365","stateId":603,"easy":"إذا أمنت الله في الدنيا ← يخيفك في الآخرة","cause":"إذا أمِنني في الدُّنيا","result":"أخفتُه في الآخرةِ","explicit":true,"ref":"الترغيب والترهيب 4/209","srcLabel":"ابن حبان","text":["عن النَّبيِّ صلَّى اللهُ عليه وسلَّم فيما يَروي عن ربِّه جلَّ وعلا أنَّه قال : وعِزَّتي لا أجمعُ على عبدي خوفَيْن وأمنَيْن : إذا خافني في الدُّنيا أمَّنتُه يومَ القيامةِ ، و",["إذا أمِنني في الدُّنيا",1]," ",["أخفتُه في الآخرةِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن حبان (640)، والبيهقي في ((شعب الإيمان)) (759) كلاهما بلفظه، والبزار (8029) باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"rtOiudlK","merged":2,"otherRefs":["السلسلة الصحيحة 742 (صحيح)"]},{"id":"س-07467","fp":"2e5239915b99","stateId":603,"easy":"إذا كنت يوم القيامة ← يكون عرقك على قدر عملك","cause":"فيكونونَ في العرَقِ كقَدْرِ أعمالِهم","result":"فمنهم مَن يأخُذُه إلى عقِبَيْهِ","explicit":true,"ref":"تخريج صحيح ابن حبان 7330","srcLabel":"الترمذي","text":["إذا كان يومُ القيامةِ أُدنِيَتِ الشَّمشُ مِن العبادِ حتَّى تكونَ قِيدَ مِيلٍ أو مِيلَيْنِ ) قال سُلَيمٌ : لا أدري أيَّ المِيلينَ يعني أمسافةَ الأرضِ أمِ المِيلَ الَّذي تُكحَلُ به العَينُ ؟ قال : ( فتصهَرُهم الشَّمسُ ",["فيكونونَ في العرَقِ كقَدْرِ أعمالِهم",1]," ",["فمنهم مَن يأخُذُه إلى عقِبَيْهِ",2]," ومنهم مَن يأخُذُه إلى رُكبتَيْهِ ومنهم مَن يأخُذُه إلى حِقْوَيْهِ ومنهم مَن يُلجِمُه إلجامًا ) قال : فرأَيْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم وهو يُشيرُ بيدِه إلى فيه يقولُ : ( يُلجِمُهم إلجامًا )"],"grade":"صحيح","narrator":"المقداد","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (2421)، وأحمد (23813)، وابن حبان (7330)، وابن المبارك في ((مسنده)) (95) جميعا بلفظه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"lGqSnh5r","merged":2,"otherRefs":["إتحاف الخيرة المهرة 8/165 (حسن)"]},{"id":"س-07796","fp":"fb74f2df1566","stateId":603,"easy":"إذا أُعطيتم فلم تشكروا وابتُليتم فلم تصبروا ← فالفساق هم أهل النار","cause":"إذا أُعطِينَ لم يشكُرْنَ وإن ابتُلِينَ لم يصبِرْنَ","result":"إنَّ الفُسَّاقَ هم أهلُ النَّارِ","explicit":true,"ref":"مجمع الزوائد 8/39","srcLabel":"أحمد","text":["تعلَّموا القرآنَ فإذا علِمْتُموه فلا تغلُوا فيه ولا تجفُوا عنه ولا تأكُلوا به ولا تستكثِروا به ثُمَّ قال إنَّ التُّجَّارَ همُ الفُجَّارُ قالوا يا رسولَ اللهِ أليس قد أحلَّ اللهُ البيعَ وحرَّم الرِّبا قال بلى ولكنَّهم يحلِفونَ ويأثَمونَ ثُمَّ قال ",["إنَّ الفُسَّاقَ هم أهلُ النَّارِ",2]," قالوا يا رسولَ اللهِ مَن الفُسَّاقُ قال النِّساءُ قالوا أو ليس أمَّهاتِنا وبناتِنا وأخواتِنا قال بلى ولكنَّهنَّ ",["إذا أُعطِينَ لم يشكُرْنَ وإن ابتُلِينَ لم يصبِرْنَ",1]," ثُمَّ قال يُسلِّمُ الرِّاكبُ على الرَّاجلِ والرَّاجلُ على الجالسِ والأقلُّ على الأكثرِ فمَن أجاب السَّلامَ كان له ومَن لم يُجِبْ فلا شيءَ له"],"grade":"صحيح","narrator":"عبدالرحمن بن شبل","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (15704)، وعبد بن حميد في ((مسنده)) (314)، والبيهقي (2362)","bab":"قرآن › تعلم القرآن وتعليمه","dorar":"1qQvD5R8","merged":2,"otherRefs":["تخريج المسند لشعيب 15531 (صحيح)"]},{"id":"س-01729","fp":"f3d913fc0b3c","stateId":603,"easy":"إذا لم تستحِ ← فاصنع ما شئت (فستُجزى)","cause":"إذا لم تستَحِ","result":"فافعَلْ ما شِئْتَ","explicit":true,"ref":"مجمع الزوائد 8/30","srcLabel":"أحمد","text":["إنَّ ممَّا أدرَك النَّاسُ من كلامِ النُّبوَّةِ الأولى ",["إذا لم تستَحِ",1]," ",["فافعَلْ ما شِئْتَ",2]," وفي روايةٍ إنَّ آخرَ ما تعلَّق به أهلُ الجاهليَّةِ من كلامِ النُّبوَّةِ الأولى"],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه البزار(2835) بلفظه، وأحمد (23254) باختلاف يسير، والطحاوي في ((شرح مشكل الاثار)) (1536) بنحوه","bab":"أنبياء › عام","dorar":"Ov3jOzyu"},{"id":"س-04851","fp":"dedda83a6a08","stateId":603,"easy":"إذا استصغرت الذنب ← فربما دخلت به النار","cause":"صغيرَ الذنبِ","result":"فربما به دخل النارَ","explicit":true,"ref":"الإعلام بفوائد عمدة الأحكام 4/307","srcLabel":"الإعلام بفوائد عمدة الأحكام","text":["لا يحقرن أحدُكم ",["صغيرَ الذنبِ",1]," ",["فربما به دخل النارَ",2]],"grade":"صحيح","muhaddith":"ثابت","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"2dZSQ4CW"},{"id":"س-05020","fp":"574c2da65b07","stateId":603,"easy":"إذا عصيت الله واجترأت على معصيته وخالفت طاعته ← قد تدخل النار من أهل القبلة","cause":"بِما عصَوا اللهَ واجْترَؤُا على معصيتِه ، وخالَفُوا طاعتَه","result":"يدخلُ من أهلِ هذه القِبلةِ النارَ مَن لا يُحصِي عددَهم إلا اللهُ","explicit":true,"ref":"صحيح الترغيب 3640","srcLabel":"الطبراني","text":[["يدخلُ من أهلِ هذه القِبلةِ النارَ مَن لا يُحصِي عددَهم إلا اللهُ",2]," ، ",["بِما عصَوا اللهَ واجْترَؤُا على معصيتِه ، وخالَفُوا طاعتَه",1]," ، فيُؤذنُ لِي في الشفاعةِ ، فأُثنِي على اللهِ ساجِدًا كما أُثنِي عليه قائِمًا ، فيُقالُ لِي : ارْفعْ رأسَكَ ، وسَلْ تُعْطَهْ ، واشْفعْ تُشَفَّعْ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"حسن صحيح","takhrij":"أخرجه الطبراني (13/455) (14315)، وفي ((المعجم الصغير)) (103)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"woJbWv0E"},{"id":"س-07214","fp":"af7ec56095f8","stateId":603,"easy":"إذا لم تعمل بطاعة ولم تترك لله معصية ← فلا يدخل النار إلا شقي","cause":"الَّذي لا يعمَلُ بطاعةٍ ، ولا يترُكُ للَّهِ معصيةً","result":"لا يدخُلُ النَّارَ إلَّا شقيٌّ","explicit":true,"ref":"تخريج المسند لشاكر 16/245","srcLabel":"ابن ماجه","text":[["لا يدخُلُ النَّارَ إلَّا شقيٌّ",2]," ، قيلَ : ومَنِ الشَّقيُّ ؟ قالَ : ",["الَّذي لا يعمَلُ بطاعةٍ ، ولا يترُكُ للَّهِ معصيةً",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (8594) بلفظه، وابن ماجه (4298) بلفظ مقارب.","bab":"علم › حسن السؤال ونصح العالم","dorar":"Y4k8y4Lo"},{"id":"س-02758","fp":"cfcc83ac05cd","stateId":603,"easy":"إذا ساءت أعمالك ← تخطفك كلاليب الصراط","cause":"بأَعمالِهم","result":"تَخطَفُ النَّاسَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشعيب 7927","srcLabel":"متفق عليه","text":["المعنى: أنَّ النَّاسَ قالوا لرسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا رسولَ اللهِ، هل نَرى رَبَّنا عزَّ وجلَّ يَومَ القِيامَةِ؟ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: هل تُضارُّون في القَمَرِ لَيلةَ البَدْرِ؟ قالوا: لا يا رسولَ اللهِ. قال: فهل تُضارُّون في الشَّمسِ ليس دونَها سَحابٌ؟ قالوا: لا. قال: فإنَّكم تَرَوْنه كذلك، يَجمَعُ اللهُ النَّاسَ يَومَ القِيامَةِ، فيُقالُ: مَن كان يَعبُدُ شَيئًا فليَتبَعْه، فيَتبَعُ مَن يَعبُدُ الشَّمسَ الشَّمسَ، ويَتبَعُ مَن يَعبُدُ القَمرَ القَمرَ، ويَتبَعُ مَن يَعبُدُ الطَّواغيتَ الطَّواغيتَ، وتَبقى هذه الأُمَّةُ فيها شافِعوها، أو مُنافِقوها -قال أبو كامِلٍ: شَكَّ إبراهيمُ- فيَأتيهم اللهُ عزَّ وجلَّ في صورَةٍ غَيرِ صورَتِه الَّتي يَعرِفون، فيَقولُ: أنا رَبُّكم. فيَقولون: نَعوذُ باللهِ مِنك، هذا مَكانُنا حتى يَأتِيَنا رَبُّنا، فإذا جاء رَبُّنا عَرَفْناه. فيَأتيهم اللهُ عزَّ وجلَّ في صورَتِه الَّتي يَعرِفون، فيَقولُ: أنا رَبُّكم. فيَقولون: أنت رَبُّنا. فيَتبَعونه. ويُضرَبُ الصِّراطُ بيْنَ ظَهرَيْ جَهنَّمَ، فأَكونُ أنا وأُمَّتي أَوَّلَ مَن يَجوزُه، ولا يتكَلَّمُ يَومَئذٍ إلَّا الرُّسلُ، ودَعوى الرُّسلِ يَومَئذٍ: اللَّهمَّ سَلِّمْ سَلِّمْ. وفي جَهنَّمَ كَلاليبُ مِثلُ شَوكِ السَّعْدانِ، هل رأَيتُم السَّعْدانَ؟ قالوا: نعم يا رسولَ اللهِ. قال: فإنَّها مِثلُ شَوكِ السَّعْدانِ، غَيرَ أنَّه لا يَعلَمُ قَدرَ عِظَمِها إلَّا اللهُ تَعالى، ",["تَخطَفُ النَّاسَ",2]," ",["بأَعمالِهم",1],"، فمِنهم الموبَقُ بِعَملِه -أو قال: الموثَقُ بِعَملِه أو المُخَردَلُ-، ومنهم المُجازى -قال أبو كامِلٍ في حَديثِهِ: شَكَّ إبراهيمُ- ومنهم المُخَردَلُ أو المُجازى ثم يتجَلَّى، حتى إذا فرَغَ اللهُ عزَّ وجلَّ مِن القَضاءِ بيْنَ العِبادِ، وأرادَ أنْ يُخرِجَ برَحمَتِه مَن أرادَ مِن أَهلِ النَّارِ أمَرَ الملائكةَ أنْ يُخرِجوا مِن النَّارِ مَن كان لا يُشرِكُ باللهِ شيئًا، ممَّن أرادَ اللهُ أنْ يَرحَمَه، ممَّن يَقولُ: لا إلهَ إلَّا اللهُ، فيَعرِفونَهم في النَّارِ، يَعرِفونَهم بأَثَرِ السُّجودِ، تَأكُلُ النَّارُ ابنَ آدَمَ إلَّا أَثَرَ السُّجودِ، وحرَّمَ اللهُ عزَّ وجلَّ على النَّارِ أنْ تَأكُلَ أَثَرَ السُّجودِ، فيَخرُجون مِن النَّارِ قد امتُحِشوا فيُصَبُّ عليهم ماءُ الحياةِ، فيَنبُتون كما تَنبُتُ الحبَّةُ -وقال أبو كامِلٍ: الحبَّةُ، أَيضًا- في حَميلِ السَّيلِ. ويَبقى رَجُلٌ مُقبِلٌ بوَجهِه على النَّارِ، وهو آخِرُ أَهلِ الجنَّةِ دُخولًا، فيَقولُ: أَيْ رَبِّ، اصرِفْ وَجهي عن النَّارِ؛ فإنَّه قد قشَبَني رِيحُها، وأحرَقَني دُخَانُها، فيَدعو اللهَ ما شاءَ أنْ يَدعُوَه، ثم يَقولُ اللهُ عزَّ وجلَّ: هل عسَيْتَ إنْ فُعِلَ ذلك بك أنْ تَسأَلَ غَيرَه؟ فيَقولُ: لا وعِزَّتِك لا أَسأَلُ غَيرَه. ويُعطي رَبَّه عزَّ وجلَّ مِن عُهودٍ ومَواثيقَ ما شاءَ، فيَصرِفُ اللهُ عزَّ وجلَّ وَجهَه عن النَّارِ، فإذا أقبَلَ على الجنَّةِ ورآها؛ سكَتَ ما شاء اللهُ أنْ يَسكُتَ، ثم يَقولُ: أَي رَبِّ، قَرِّبْني إلى بابِ الجنَّةِ، فيَقولُ اللهُ عزَّ وجلَّ له: أَلستَ قد أعطَيْتَ عُهودَك ومَواثيقَك أَلَّا تَسأَلَني غَيرَ ما أعطَيتُكَ؟ وَيْلَكَ يا ابنَ آدَمَ، ما أَغدَرَكَ! فيَقولُ: أَيْ رَبِّ، فيَدعو اللهَ، حتى يَقولَ له: فهل عسَيْتَ إنْ أُعطيتَ ذلك أنْ تَسأَلَ غَيرَه؟ فيَقولُ: لا وَعِزَّتِكَ لا أَسأَلُ غَيرَه. فيُعطي رَبَّه عزَّ وجلَّ ما شاء مِن عُهودٍ ومَواثيقَ، فيُقَدِّمُه إلى بابِ الجنَّةِ، فإذا قام على باب الجنَّةِ انفهَقَتْ له الجنَّةُ، فرأى ما فيها مِن الحِبَرَةِ والسُّرورِ، فيَسكُتُ ما شاء اللهُ أنْ يَسكُتَ، ثم يَقولُ: أَي رَبِّ، أَدخِلْني الجنَّةَ. فيَقولُ اللهُ عزَّ وجلَّ له: أليس قد أعطَيْتَ عُهودَك ومَواثيقَك أَلَّا تَسأَلَني غَيرَ ما أعطَيتُكَ؟ وَيْلَك يا ابنَ آدَمَ، ما أَغدَرَك! فيَقولُ: أَيْ رَبِّ، لا أَكونُ أَشقى خَلقِكَ، فلا يَزالُ يَدعو اللهَ، حتى يَضحَكَ اللهُ منه، فإذا ضحِكَ اللهُ عزَّ وجلَّ منه قال: ادخُلِ الجنَّةَ. فإذا دخَلَها قال اللهُ عزَّ وجلَّ له: تَمَنَّه. فيَسأَلُ رَبَّه عزَّ وجلَّ ويتمَنَّى، حتى إنَّ اللهَ عزَّ وجلَّ ليُذَكِّرُه، يَقولُ: مِن كذا وكذا، حتى إذا انقطَعَتْ به الأَمانِيُّ؛ قال اللهُ عزَّ وجلَّ له: لك ذلك ومِثلُه معه. قال عطاءُ بنُ يَزيدَ: وأبو سَعيدٍ الخُدرِيُّ مع أبي هُريرةَ، لا يَرُدُّ عليه مِن حَديثِه شَيئًا، حتى إذا حدَّثَ أبو هُريرةَ أنَّ اللهَ عزَّ وجلَّ قال لذلك الرَّجُلِ: ومِثلُه معه. قال أبو سعيدٍ: وعَشَرةُ أَمثالِه معه يا أبا هُريرةَ. قال أبو هُريرةَ: ما حفِظْتُ إلَّا قَولَه: ذلك لك ومِثلُه معه. قال أبو سعيدٍ: أَشهَدُ أنِّي حفِظْتُ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ قَولَه في ذلك الرَّجُلِ: لك عَشَرةُ أَمثالِه. قال أبو هُريرةَ: وذلك الرَّجُلُ آخِرُ أَهلِ الجنَّةِ دُخولًا."],"grade":"صحيح","narrator":"أبو هريرة وأبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (7437)، ومسلم (182) باختلاف يسير","bab":"إيمان › الملائكة","dorar":"xsDQipBf","merged":3,"otherRefs":["تخريج صحيح ابن حبان 7429 (صحيح)","فوائد الحنائي الحنائيات 2/865 (صحيح)"]},{"id":"س-02744","fp":"ba48fb0f4fcf","stateId":603,"easy":"إذا كثرت ذنوبك وخطاياك ← تحترق على الصراط","cause":"بذُنوبٍ وخَطايا","result":"يَحترِقون، فيكونونَ فَحْمًا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[12],"ref":"المستدرك على الصحيحين 8963","srcLabel":"متفق عليه","text":["يُجمَعُ النَّاسُ عِندَ جِسرِ جَهنَّمَ عليه حَسَكٌ وكَلاليبُ، ويَمُرُّ النَّاسُ؛ فيَمُرُّ منهم مِثلَ البرْقِ، وبعضُهم مِثلَ الفرَسِ المُضَمَّرِ، وبعضُهم يَسْعى، وبعضُهم يَمْشي، وبعضُهم يَزحَفُ، والملائكةُ بجَنبَتَيْه تقولُ: اللَّهمَّ سَلِّم سَلِّم، والكَلاليبُ تَخطِفُهم، قال: وأمَّا أهلُها الَّذين همْ أهلُها فلا يَموتونَ ولا يَحْيَون، وأمَّا أُناسٌ يُؤخَذون ",["بذُنوبٍ وخَطايا",1]," ",["يَحترِقون، فيكونونَ فَحْمًا",2],"، فيُؤخَذون ضِباراتٍ ضِباراتٍ، فيُقذَفون على نَهرٍ مِنَ الجنَّة، فيَنبُتون كما تَنبُتُ الحِبَّةُ في حَمِيلِ السَّيلِ، قال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: هلْ رأيْتُم السَّفعاءَ؟ ثمَّ إنَّهم بعْدُ يُؤذَن لهم، فيَدخُلون الجنَّةَ. قال أبو سَعيدٍ: فيُعطى أحدُهم مِثلَ الدُّنيا، قال: وعلى الصِّراطِ ثلاثُ شَجَراتٍ، فيكونُ آخِرُ مَن يَخرُجُ مِنَ النَّار على شَفَتِها، فيَقولُ: يا ربِّ، قَدِّمني إلى هذه الشَّجرةِ، أكونُ في ظِلِّها وآكُلُ مِن ثَمرِها، قال: فيَقولُ: عَهْدُك وذِمَّتُك أنْ تَسأَلَني غيْرَها، فيُحَوَّلُ إليها، ثمَّ يَرى أُخرى أحسَنَ منها، فيَقولُ مِثلَ ذلك، فيَقولُ: عَهْدُك وذِمَّتُك لا تَسأَلُني غيْرَها، فيَقولُ: عَهْدي وذِمَّتي لا أسْأَلُ غيْرَها، فيُحوَّلُ إليها، فيَرى أُخرى أحسَنَ منها، فيَقولُ: يا ربِّ، آكُلُ مِن ثَمرِها وأكونُ في ظِلِّها، فيُحوَّلُ إليها، قال: فيَسمَعُ أصواتَ النَّاسِ ويَرى سَوادَهم، فيَقولُ: يا ربِّ، أدْخِلْني الجنَّةَ. قال أبو سَعيدٍ: ثمَّ ذكَرَ على أثَرِه أصحابَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، ذكَرَها فقال أحدُهما: يُعطى مِثلَ الدُّنيا ومِثلَها معها، وقال آخَرُ: مِثلَ الدُّنيا وعشْرَ أمثالِها."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح على شرط مسلم ولم يخرجاه","takhrij":"أخرجه أحمد (11200)، وابن حبان (7379) كلاهما بنحوه، وأصل الحديث في صحيح البخاري (7439)، ومسلم (183) .","bab":"إيمان › الملائكة","dorar":"UBAehUKm"},{"id":"س-03219","fp":"2798c4e439e1","stateId":603,"easy":"إذا عصيت ← تُعذّب بذنوبك ما شاء الله ثم تخرج","cause":"بذُنوبهم","result":"يُعَذَّبونَ بذُنوبهم فيَكونونَ في النَّارِ ما شاءَ اللهُ أن يَكونوا","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"فتح البيان 7/ 145","srcLabel":"البخاري","text":["إنَّ ناسًا مِن أُمَّتي ",["يُعَذَّبونَ بذُنوبهم فيَكونونَ في النَّارِ ما شاءَ اللهُ أن يَكونوا",2],"، ثُمَّ يُعَيِّرُهم أهلُ الشِّركِ فيَقولونَ: ما نَرى ما كُنتُم فيه مِن تَصديقِكُم نَفعَكُم! فلا يَبقى أحَدٌ إلَّا أخرَجَه اللهُ مِنَ النَّارِ. ثُمَّ قَرَأ رَسولُ اللهِ صلَّى الله عليه وسلَّم هذه الآيةَ."],"grade":"صحيح","narrator":"جابر بن عبد الله","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (11207)، والطبراني في ((المعجم الأوسط)) (5146) بلفظه، والبخاري (6558) بنحوه.","bab":"إيمان › فضل الإيمان","dorar":"QheIfOLJ"},{"id":"س-03343","fp":"508e9a971f70","stateId":603,"easy":"إذا أصررت على الذنب وأنت تعلم ← فويل لك","cause":"للمُصِرِّينَ الذين يُصِرُّون على ما فَعلوا و هم يعلَمون","result":"و ويلٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[12],"ref":"السلسلة الصحيحة 482","srcLabel":"البخاري","text":["ارْحَموا تُرْحَموا ، و اغفِروا يغْفِرِ اللهُ لكم ، ",["و ويلٌ",2]," لأقماعِ القولِ ، و ويلٌ ",["للمُصِرِّينَ الذين يُصِرُّون على ما فَعلوا و هم يعلَمون",1]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6541)، والبخاري في ((الأدب المفرد)) (380)، والطبراني (13/651) (14579)","bab":"استغفار › أسباب المغفرة","dorar":"M1X8iz28"},{"id":"س-01797","fp":"4a088c41c5f0","stateId":603,"easy":"إذا عملت المنكر ← يلازمك يوم القيامة","cause":"وأمَّا المنكرَ","result":"فيقولُ إليكم إليكم وما يستطيعونَ لَهُ إلَّا لُزَومًا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"مجمع الزوائد 7/265","srcLabel":"أحمد","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم والَّذِي نَفْسُ محمدٍ بيدِهِ إنَّ المعروفَ والمنكَرَ لَخَلِيقَتَانِ يُنْصَبانِ للناسِ يومَ القيامةِ فأَمَّا المعروفُ فيُبَشِّرُ أصحابَهُ ويوعِدُهم الخيرَ ",["وأمَّا المنكرَ",1]," ",["فيقولُ إليكم إليكم وما يستطيعونَ لَهُ إلَّا لُزَومًا",2]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (19487)، والطيالسي (537)، وابن أبي الدنيا في ((اصطناع المعروف)) (16)، والطبراني في ((المعجم الأوسط)) (8925) واللفظ لهم.","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"36Ag1uXp"},{"id":"س-08230","fp":"cd457f216c69","stateId":603,"easy":"إذا أصبت الذنوب ← تأخذ منك النار على الصراط","cause":"بذُنوبٍ أصابها","result":"وتأخُذُ النَّارُ منه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[12],"ref":"المصابيح في الأحاديث المتواترة 599","srcLabel":"المصابيح في الأحاديث المتواترة","text":["إنَّ على جهنَّمَ جِسرًا أدَقَّ من الشَّعرِ وأحَدَّ من السَّيفِ، أعلاه نحوُ الجنَّةِ دَحْضٌ مَزَلَّةٌ، بجنبيه كلاليبُ وحسَكُ النَّارِ، يحشُرُ اللهُ به من يشاءُ من عبادِه، الزَّالُّون والزَّالَّاتُ يومئذٍ كثيرٌ، والملائكةُ بجانبَيه قيامٌ يُنادونَ: اللَّهُمَّ سَلِّم سَلِّم، فمن جاء بالحقِّ جاز، ويُعطَونَ النُّورَ يومَئذٍ على قَدرِ أعمالِهم وإيمانِهم، منهم من يمضي عليه كلَمحِ البَرقِ، ومنهم من يَمضي عليه كمَرِّ الرِّيحِ، ومنهم من يُعطى نورًا إلى موضِعِ قَدَميه، ومنهم من يحبو حبوًا ",["وتأخُذُ النَّارُ منه",2]," ",["بذُنوبٍ أصابها",1],"، وهي تحرِقُ من يشاءُ اللهُ منهم على قَدرِ ذُنوبِهم حتَّى ينجوَ، وتنجو أوَّلُ زُمرةٍ سبعونَ ألفًا لا حِسابَ عليهم ولا عذابَ، كأنَّ وُجوهَهم القَمَرُ ليلةَ البدرِ، والذين يلونَهم كأضوأِ نَجمٍ في السَّماءِ حتَّى يَبلُغوا إلى الجنَّةِ برحمةِ اللهِ تعالى"],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"ملائكة › أعمال الملائكة","dorar":"ftBFF8cJ"},{"id":"س-08231","fp":"43d24e8023dc","stateId":603,"easy":"إذا عصيت ← تحرقك النار على قدر ذنوبك","cause":"على قَدرِ ذُنوبِهم","result":"تحرِقُ من يشاءُ اللهُ منهم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[12],"ref":"المصابيح في الأحاديث المتواترة 599","srcLabel":"المصابيح في الأحاديث المتواترة","text":["إنَّ على جهنَّمَ جِسرًا أدَقَّ من الشَّعرِ وأحَدَّ من السَّيفِ، أعلاه نحوُ الجنَّةِ دَحْضٌ مَزَلَّةٌ، بجنبيه كلاليبُ وحسَكُ النَّارِ، يحشُرُ اللهُ به من يشاءُ من عبادِه، الزَّالُّون والزَّالَّاتُ يومئذٍ كثيرٌ، والملائكةُ بجانبَيه قيامٌ يُنادونَ: اللَّهُمَّ سَلِّم سَلِّم، فمن جاء بالحقِّ جاز، ويُعطَونَ النُّورَ يومَئذٍ على قَدرِ أعمالِهم وإيمانِهم، منهم من يمضي عليه كلَمحِ البَرقِ، ومنهم من يَمضي عليه كمَرِّ الرِّيحِ، ومنهم من يُعطى نورًا إلى موضِعِ قَدَميه، ومنهم من يحبو حبوًا وتأخُذُ النَّارُ منه بذُنوبٍ أصابها، وهي ",["تحرِقُ من يشاءُ اللهُ منهم",2]," ",["على قَدرِ ذُنوبِهم",1]," حتَّى ينجوَ، وتنجو أوَّلُ زُمرةٍ سبعونَ ألفًا لا حِسابَ عليهم ولا عذابَ، كأنَّ وُجوهَهم القَمَرُ ليلةَ البدرِ، والذين يلونَهم كأضوأِ نَجمٍ في السَّماءِ حتَّى يَبلُغوا إلى الجنَّةِ برحمةِ اللهِ تعالى"],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"ملائكة › أعمال الملائكة","dorar":"ftBFF8cJ"},{"id":"س-00215","fp":"b3f4766cd7ef","stateId":604,"easy":"إذا اضطجعت على وجهك ← فهي ضجعة أهل النار","cause":"مُنْبَطِحًا على وَجْهِه","result":"هذه ضِجْعةٌ أهْلِ النَّارِ","explicit":true,"star":true,"otherNeedIds":[26],"ref":"الأحاديث المختارة 8 / 136","srcLabel":"متفق عليه","text":["«أخْبَرَني أبي أنَّه ضافَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ معَ نَفَرٍ، فبِتْنا عِنْدَه فخَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يَطَّلِعُ فرآه ",["مُنْبَطِحًا على وَجْهِه",1],"، فرَكَضَه برِجْلِه فأيْقَظَه وقالَ: (",["هذه ضِجْعةٌ أهْلِ النَّارِ",2],")."],"grade":"صحيح","narrator":"طخفة الغفاري","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"آداب المجلس › إكرام الضيف","dorar":"UScEPddg"},{"id":"س-04567","fp":"486617217da9","stateId":604,"easy":"إذا نمت في المسجد منبطحاً على وجهك ← فهي نومة جهنمية","cause":"نائمٍ في المسجدِ مُنبطِحٍ على وَجهِه","result":"فإنَّها نَومةٌ جَهنَّميَّةٌ","explicit":true,"star":true,"otherNeedIds":[26],"ref":"تخريج المسند لشعيب 32/209","srcLabel":"البخاري","text":["مَرَّ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ على رَجُلٍ ",["نائمٍ في المسجدِ مُنبطِحٍ على وَجهِه",1],"، فضَرَبَه برِجلِه، وقال: قُمْ، واقعُدْ؛ ",["فإنَّها نَومةٌ جَهنَّميَّةٌ",2],"."],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن ماجه (3725) واللفظ له، والبخاري في ((الأدب المفرد)) (1188)","bab":"جهنم › صفة عذاب أهل النار","dorar":"LHZDGytQ"},{"id":"س-04194","fp":"4f359fdff585","stateId":604,"easy":"إذا تخطيت رقاب الناس يوم الجمعة ← فكالجار قصبه في النار","cause":"إنَّ الذي يَتخَطى رقابَ الناسِ يومَ الجمعةِ، و يفرقُ بين اثنينِ بعدَ خروجِ الإمامِ","result":"كالْجَارِّ قُصْبَهُ في النارِ","explicit":true,"ref":"الجامع الصغير 2085","srcLabel":"أحمد","text":[["إنَّ الذي يَتخَطى رقابَ الناسِ يومَ الجمعةِ، و يفرقُ بين اثنينِ بعدَ خروجِ الإمامِ",1],"،  ",["كالْجَارِّ قُصْبَهُ في النارِ",2]],"grade":"صحيح","narrator":"الأرقم بن أبي الأرقم","muhaddith":"صحيح","takhrij":"أخرجه أحمد (15447)، والطبراني في ((المعجم الكبير)) (1/ 307) (908)، والحاكم (6132) جميعهم بلفظه.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"CGI08d3s","merged":2,"otherRefs":["مختصر الأحكام 3/30 (حسن)"]},{"id":"س-07961","fp":"3652b878d359","stateId":604,"easy":"إذا تنخمت في القبلة ← تأتي يوم القيامة وهي في وجهك","cause":"صاحبُ النُّخامةِ في القِبلةِ","result":"يومَ القيامةِ، و هي في وجهِهِ","explicit":true,"ref":"الوهم والإيهام 5/680","srcLabel":"ابن حبان","text":["حديثُ الَّذي يبصُقُ في القِبلةِ [يعني حديث: يُبعثُ ",["صاحبُ النُّخامةِ في القِبلةِ",1]," ",["يومَ القيامةِ، و هي في وجهِهِ",2],"]"],"grade":"صحيح","narrator":"[عبدالله بن عمر]","muhaddith":"صحيح","takhrij":"أخرجه ابن خزيمة (1313)، وابن حبان (1638)، وابن الأعرابي في ((معجمه)) (2345) بنحوه.","bab":"مساجد ومواضع الصلاة › البزاق في المسجد","dorar":"7SOCsL4b","merged":2,"otherRefs":["صحيح الجامع 2910 (صحيح)"]},{"id":"س-01590","fp":"5c314999e0f8","stateId":604,"easy":"إذا تفلت تجاه القبلة ← تأتي يوم القيامة وتفلتك بين عينيك","cause":"مَن تَفَلَ تِجاهَ القِبلةِ","result":"جاءَ يَومَ القيامةِ تَفلُه بَينَ عَينَيْه","explicit":true,"ref":"تخريج سنن أبي داود 3824","srcLabel":"أبو داود","text":["أظُنُّه قال: عن رَسولِ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ قال: ",["مَن تَفَلَ تِجاهَ القِبلةِ ",1],["جاءَ يَومَ القيامةِ تَفلُه بَينَ عَينَيْه، ",2],"ومَن أكَلَ مِن هذه البَقلةِ الخَبيثةِ فلا يَقرَبَنَّ مَسجِدَنا ثَلاثًا."],"grade":"صحيح","narrator":"حذيفة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3824)، وابن خزيمة (1663)، والبيهقي (5121) واللفظ لهم.","bab":"أطعمة › أكل الثوم والبصل والكراث","dorar":"5iYlsrIn"},{"id":"س-04843","fp":"34d4e6cc49ae","stateId":604,"easy":"إذا تخطيت رقاب الناس يوم الجمعة ← اتخذت جسراً إلى جهنم","cause":"من تَخَطَّى رقابَ الناسِ يومَ الجمعةِ","result":"اتخَذ جِسْرًا إلى جهنمَ","explicit":true,"ref":"هداية الرواة 1337","srcLabel":"الترمذي","text":[["من تَخَطَّى رقابَ الناسِ يومَ الجمعةِ ؛ ",1],["اتخَذ جِسْرًا إلى جهنمَ",2]],"grade":"صحيح","narrator":"معاذ بن أنس","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (513)، وابن ماجه (1116) واللفظ لهما، وأحمد (15609) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"2nhcozGV"},{"id":"س-07957","fp":"1fd9887ec69a","stateId":604,"easy":"إذا بصقت في القبلة ولم تواريها ← تأتي يوم القيامة أحمى ما تكون بين عينيك","cause":"مَن بَصق في قبلةٍ ولم يوارِها","result":"جاءَت يومَ القيامةِ أحمى ما تَكونُ حتَّى تقَعَ بينَ عَينيهِ","explicit":true,"ref":"الترغيب والترهيب 1/161","srcLabel":"الطبراني","text":[["مَن بَصق في قبلةٍ ولم يوارِها ",1],["جاءَت يومَ القيامةِ أحمى ما تَكونُ حتَّى تقَعَ بينَ عَينيهِ",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني (8/293) (7960) باختلاف يسير.","bab":"مساجد ومواضع الصلاة › البزاق في المسجد","dorar":"G8fZp6G0"},{"id":"س-02930","fp":"e18217c611f1","stateId":605,"easy":"إذا عصت المرأة زوجها أو أممت قوماً وهم كارهون ← تكون من أشد الناس عذاباً","cause":"اثنانِ : امرأةٌ عصَت زوجَها، وإمامُ قومٍ وَهُم لَه كارِهونَ","result":"أشدُّ النَّاسِ عذابًا","explicit":true,"star":true,"ref":"صحيح الترمذي 359","srcLabel":"الترمذي","text":["عَنْ عَمْرِو بْنِ الْحَارِثِ بْنِ الْمُصْطَلِقِ، قَالَ: كانَ يقالُ : ",["أشدُّ النَّاسِ عذابًا",2],[" اثنانِ : امرأةٌ عصَت زوجَها، وإمامُ قومٍ وَهُم لَه كارِهونَ",1]],"grade":"صحيح","narrator":"زياد بن أبي الجعد","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (359) واللفظ له، وابن أبي شيبة (4133) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"dLK84GsI"},{"id":"س-02947","fp":"14312fef8dd3","stateId":605,"easy":"إذا استلحقت نسباً ليس منك ← يحتّك الله حتّ الورق","cause":"منِ استلْحَقَ شيئًا ليسَ منهُ","result":"حَتَّهُ اللهُ حَتَّ الورقِ","explicit":true,"star":true,"ref":"الجامع الصغير 8405","srcLabel":"الدينوري","text":[["منِ استلْحَقَ شيئًا ليسَ منهُ،  ",1],["حَتَّهُ اللهُ حَتَّ الورقِ",2]],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"صحيح","takhrij":"أخرجه الدينوري في ((المجالسة وجواهر العلم)) (1390) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"jOAUpglZ"},{"id":"س-02957","fp":"fcec2be65cad","stateId":605,"easy":"إذا توليت غير مواليك ← فتبوأ مقعدك من النار","cause":"مَن تولَّى إلى غيرِ مواليه","result":"فلْيتبوَّأْ مقعدَه مِن النَّارِ","explicit":true,"ref":"صحيح ابن حبان 4327","srcLabel":"الطبري","text":[["مَن تولَّى إلى غيرِ مواليه ",1],["فلْيتبوَّأْ مقعدَه مِن النَّارِ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الطبري في ((تهذيب الآثار-مسند علي)) (341) بلفظ مقارب، وابن عساكر في ((تاريخ دمشق)) (14/360) وزاد في أوله: «من قال علي ما لم أقل فليتبوأ بيتا في النار»","bab":"إيمان › الوعيد","dorar":"YRuTdJId"},{"id":"س-05007","fp":"bc63a04209c0","stateId":605,"easy":"إذا مت وأنت عبد آبق ← دخلت النار","cause":"أيُّما عبدٍ ماتَ في إباقِهِ","result":"دخلَ النَّارَ","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 2/83","srcLabel":"الطبراني","text":[["أيُّما عبدٍ ماتَ في إباقِهِ",1]," ",["دخلَ النَّارَ",2]," وإن قُتِلَ في سبيلِ اللَّهِ"],"grade":"صحيح","narrator":"[جابر بن عبدالله]","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((الأوسط)) (9232) بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ptCE7oQG"},{"id":"س-03018","fp":"54ba0ce6efd6","stateId":605,"easy":"إذا سألك مولاك فضل مالك فلم تعطه ← يُجعل يوم القيامة شجاعاً أقرع","cause":"مَن سَأَلَه مَولاه فَضلَ مالِه فلمْ يُعطِهْ","result":"جُعِلَ يومَ القيامةِ شُجاعًا أقرَعَ","explicit":true,"ref":"تخريج المسند لشعيب 20020","srcLabel":"أبو داود","text":[["مَن سَأَلَه مَولاه فَضلَ مالِه فلمْ يُعطِهْ",1],"، ",["جُعِلَ يومَ القيامةِ شُجاعًا أقرَعَ",2],"."],"grade":"حسن","narrator":"معاوية بن حيدة القشيري","muhaddith":"إسناده حسن","takhrij":"أخرجه أبو داود (5139)، والنسائي (2566)، وأحمد (20020) واللفظ له","bab":"إيمان › الوعيد","dorar":"XVQhl4Ss"},{"id":"س-05947","fp":"c2a6964e4ec1","stateId":605,"easy":"إذا كفرت المرأة حق زوجها وضيعته ← تكون من أصحاب النار","cause":"كُفرَهُنَّ لحَقِّ الزَّوجِ وتَضييعَهُنَّ لحَقِّه","result":"إنَّ النِّساءَ هم أصحابُ النَّارِ","explicit":true,"otherNeedIds":[35],"ref":"مجمع الزوائد 4/317","srcLabel":"أحمد","text":["اقْرَؤوا القُرآنَ، فإذا قَرَأتُموه، فلا تَستَكبِروا به، ولا تَغْلوا فيه، ولا تَجْفوا عنه، ولا تأْكُلوا به، وقال: ",["إنَّ النِّساءَ هم أصحابُ النَّارِ",2],"، فقال رَجُلٌ: يا رسولَ اللهِ، أليس أُمَّهاتُنا وأَخَواتُنا وبَناتُنا، فذَكَرَ ",["كُفرَهُنَّ لحَقِّ الزَّوجِ وتَضييعَهُنَّ لحَقِّه",1],"."],"grade":"حسن","narrator":"عبدالرحمن بن شبل","muhaddith":"له طرق ورجاله ثقات","takhrij":"أخرجه أحمد (15568)، وأبو يعلى (1518)، والطحاوي في ((شرح معاني الآثار)) (4296) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (2574) واللفظ له.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"0hDYsiys"}]}