{"schema":1,"kind":"sunan-chunk","version":"sunan-c56d7b8d0f22","needId":54,"stateIds":[577,578,579,580,581],"items":[{"id":"ق-0593","fp":"dabf736fe2c3","stateId":577,"easy":"التوكل على الله والإنابة إليه ← التوفيق","cause":"التوكل على الله والإنابة إليه","result":"التوفيق","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"سورة هود: 88","srcLabel":"القرآن الكريم","quran":{"s":11,"from":88,"to":88,"text":"قَالَ يَا قَوْمِ أَرَأَيْتُمْ إِنْ كُنْتُ عَلَى بَيِّنَةٍ مِنْ رَبِّي وَرَزَقَنِي مِنْهُ رِزْقًا حَسَنًا وَمَا أُرِيدُ أَنْ أُخَالِفَكُمْ إِلَى مَا أَنْهَاكُمْ عَنْهُ إِنْ أُرِيدُ إِلَّا الْإِصْلَاحَ مَا اسْتَطَعْتُ وَمَا تَوْفِيقِي إِلَّا بِاللَّهِ عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ أُنِيبُ (88)","hl":[[216,289,1]]}},{"id":"ق-1352","fp":"d4ebfd5d9158","stateId":577,"easy":"تقوى الله ← اليسر في الأمر","cause":"تقوى الله","result":"اليسر في الأمر","explicit":true,"star":true,"ref":"سورة الطلاق: 4","srcLabel":"القرآن الكريم","quran":{"s":65,"from":4,"to":4,"text":"وَاللَّائِي يَئِسْنَ مِنَ الْمَحِيضِ مِنْ نِسَائِكُمْ إِنِ ارْتَبْتُمْ فَعِدَّتُهُنَّ ثَلَاثَةُ أَشْهُرٍ وَاللَّائِي لَمْ يَحِضْنَ وَأُولَاتُ الْأَحْمَالِ أَجَلُهُنَّ أَنْ يَضَعْنَ حَمْلَهُنَّ وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مِنْ أَمْرِهِ يُسْرًا (4)","hl":[[193,251,1]]}},{"id":"ق-1441","fp":"2f77572ce0a4","stateId":577,"easy":"العطاء والتقوى والتصديق بالحسنى ← التيسير لليسرى","cause":"العطاء والتقوى والتصديق بالحسنى","result":"التيسير لليسرى","explicit":true,"ref":"سورة الليل: 5–7","srcLabel":"القرآن الكريم","quran":{"s":92,"from":5,"to":7,"text":"فَأَمَّا مَنْ أَعْطَى وَاتَّقَى (5) وَصَدَّقَ بِالْحُسْنَى (6) فَسَنُيَسِّرُهُ لِلْيُسْرَى (7)","hl":[[0,90,1]]}},{"id":"س-06170","fp":"07d5cd7803dd","stateId":577,"easy":"إذا استقمت ← يستقم بك أمرك","cause":"و استَقيموا","result":"يستَقِمْ بكم","explicit":true,"ref":"صحيح الترغيب 746","srcLabel":"الطبراني","text":["أَقِيموا الصلاةَ ، و آتوا الزكاةَ ، و حُجُّوا ، و اعتَمِروا ، ",["و استَقيموا",1]," ",["يستَقِمْ بكم",2]],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني (7/216) (6897)","bab":"زكاة › فرض الزكاة","dorar":"tEZVGsw0","merged":2,"otherRefs":["الجامع الصغير 1367 (صحيح)"]},{"id":"س-03905","fp":"47b2334022a4","stateId":577,"easy":"إذا اتقيت الله ← يجعل لك مخرجاً","cause":"من يتَّقِ اللَّهَ","result":"يجعل لَهُ مخرجًا","explicit":true,"otherNeedIds":[1],"ref":"نخب الافكار 11/58","srcLabel":"الطبراني","text":["أنَّ رجلًا قالَ لابنِ عبَّاسٍ: رجلٌ طلَّقَ امرأتَهُ مِائةً، فقالَ: عَصَيتَ ربَّكَ وبانَت منكَ امرأتُكَ، لم تتَّقِ اللَّهَ فيجعلَ لَكَ مخرجًا، ",["من يتَّقِ اللَّهَ",1]," ",["يجعل لَهُ مخرجًا",2],"، قالَ اللَّهُ عزَّ وجلَّ: إِذَا طَلَّقْتُمُ النِّسَاءَ فَطَلِّقُوهُنَّ لِعِدَّتِهِنَّ في قُبُلِ عدَّتِهِنَّ"],"grade":"صحيح","narrator":"مجاهد","muhaddith":"طريقه صحيح","takhrij":"أخرجه الطبراني ((11/ 95)\n) (11157) والبيهقي (15051) واللفظ لهما، وأصله عند أبي داود (2197)","bab":"تفسير آيات › سورة الطلاق","dorar":"HuNYlUmW"},{"id":"س-04779","fp":"de4be1dc9322","stateId":577,"easy":"إذا احتجت فاستعمل المعاريض ← ففيها مندوحة عن الكذب","cause":"المعاريضِ","result":"لمندوحةٌ عن الكذبِ","explicit":true,"ref":"تفسير القرطبي 12/448","srcLabel":"تفسير القرطبي","text":["إنَّ من ",["المعاريضِ",1]," ",["لمندوحةٌ عن الكذبِ",2]],"grade":"صحيح","muhaddith":"[ثابت]","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"yHBpC1Hz"},{"id":"س-05949","fp":"c1b379024e7a","stateId":577,"easy":"إذا آثرت نصيبك من الآخرة على نصيبك من الدنيا ← ينتظم لك أمر الدنيا","cause":"فآثِرْ نصيبَكَ منَ الآخرَةِ علَى نصيبِكَ منَ الدُّنيا","result":"حتى يَنْتَظِمُهُ لَكَ انتظامًا","explicit":true,"ref":"مجمع الزوائد 4/224","srcLabel":"الطبراني","text":["أَتَى رجلٌ معاذَ بنَ جبلٍ ومعه أصحابُهُ يسلِّمونَ عليه ويَدْعونَهُ فقال إني موصيكَ بِأَمْرَينِ إن حفِظْتَهما حُفِظْتَ أنه لا غِنَى بِكَ عن نَصِيبِكَ منَ الدُّنْيَا وأنتَ إلى نَصِيبِكَ منَ الآخرةِ أفقرُ ",["فآثِرْ نصيبَكَ منَ الآخرَةِ علَى نصيبِكَ منَ الدُّنيا",1]," ",["حتى يَنْتَظِمُهُ لَكَ انتظامًا",2]," فتزولُ بِهِ مَعَكَ أَيْنَما زُلْتَ"],"grade":"صحيح","narrator":"محمد بن سيرين","muhaddith":"رجاله رجال الصحيح إلا أني لم أجد لابن سيرين سماعا من معاذ","takhrij":"أخرجه الطبراني (20/35) (49)، وأبو نعيم في ((حلية الأولياء)) (1/234)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"lb0qUfAB"},{"id":"س-00193","fp":"19c084f202fd","stateId":577,"easy":"إذا صدقت ← يجرك الصدق إلى الخير","cause":"الصِّدقِ","result":"فإنَّه يجُرُّه إلى الخيرِ","explicit":true,"ref":"المهذب في اختصار السنن 3/1143","srcLabel":"البيهقي","text":["كان عمرُ يقولُ في خُطبتِه : أفلح منكم من حُفِظ من الهوَى والغضبِ والطَّمعِ ووُفِّق إلى ",["الصِّدقِ",1]," , ",["فإنَّه يجُرُّه إلى الخيرِ",2]," , من يكذِبُ يفجُرْ . . . ."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده جيد","takhrij":"أخرجه البيهقي (6015) باختلاف يسير","bab":"آداب الكلام › الصدق وما جاء فيه","dorar":"eA4qzhmE"},{"id":"س-01742","fp":"d559627b1b50","stateId":578,"easy":"إذا قلت «إن شاء الله» ← لا تحنث وتدرك حاجتك","cause":"لو قال: إن شاءَ اللهُ","result":"لم يَحنَثْ، وكان دَرَكًا له في حاجَتِه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"apply":{"k":"say","t":"«إن شاء الله»"},"similar":["س-01743","س-01733"],"otherNeedIds":[29],"ref":"صحيح البخاري 6720","srcLabel":"متفق عليه","text":["سَمِعَ أبا هُرَيرةَ، قال: قال سُلَيمانُ: لَأطوفَنَّ اللَّيلةَ على تِسعينَ امرَأةً، كُلٌّ تَلِدُ غُلامًا يُقاتِلُ في سَبيلِ اللهِ، فقال له صاحِبُه -قال سُفيانُ: يَعني المَلَكَ- قُلْ: إن شاءَ اللهُ، فنَسيَ، فطافَ بهِنَّ فلَم تَأتِ امرَأةٌ منهنَّ بولَدٍ إلَّا واحِدةٌ بشِقِّ غُلامٍ، فقال أبو هُرَيرةَ يَرويه: قال: ",["لو قال: إن شاءَ اللهُ",1],"، ",["لم يَحنَثْ، وكان دَرَكًا له في حاجَتِه",2]," -وقال مَرَّةً: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم- لَوِ استَثنى، وحَدَّثَنا أبو الزِّنادِ، عَنِ الأعرَجِ: مِثلَ حَديثِ أبي هُرَيرةَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6720) واللفظ له، ومسلم (1654)","bab":"أيمان › الاستثناء في اليمين","dorar":"Z0xAqwzH","merged":5,"otherRefs":["صحيح ابن حبان 4338 (صحيح)","صحيح مسلم 1654 (صحيح)","صحيح البخاري 5242 (صحيح)"]},{"id":"س-01730","fp":"3e1182c99392","stateId":578,"easy":"إذا قلت «إن شاء الله» على عزمك ← يكون كما قلت","cause":"لو قال: إنْ شاء اللهُ","result":"كان كما قال","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"apply":{"k":"say","t":"«إن شاء الله»"},"otherNeedIds":[29],"ref":"تخريج صحيح ابن حبان 4337","srcLabel":"متفق عليه","text":["حلَف سليمانُ بنُ داودَ: لَيطوفَنَّ على مئةِ امرأةٍ كلُّ امرأةٍ منهنَّ تحمِلُ غلامًا يُجاهِدُ في سبيلِ اللهِ قال: فلم تحمِلْ منهنَّ إلَّا امرأةٌ واحدةٌ نصفَ غلامٍ ) فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ( ",["لو قال: إنْ شاء اللهُ",1]," ",["كان كما قال",2]," )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه ابن حبان (4338) واللفظ له، والبخاري (2819)، ومسلم (1654) كلاهما بنحوه.","bab":"أنبياء › عام","dorar":"SYjfSIn7","merged":2,"otherRefs":["عارضة الأحوذي 4/34 (صحيح)"]},{"id":"س-01743","fp":"d4cdacfc0f4b","stateId":578,"easy":"إذا قلت «إن شاء الله» ← تتحقق حاجتك (من قصة سليمان)","cause":"لو قال: إنْ شاءَ اللهُ","result":"لَجاهَدوا في سَبيلِ اللهِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«إن شاء الله»"},"repOf":"س-01742","otherNeedIds":[29],"ref":"تخريج مشكل الآثار 1925","text":["عن عبدِ الرحمنِ بنِ هُرمُزَ، أنَّه قال: سَمِعتُ أبا هُرَيرةَ رضِيَ اللهُ عنه يأثُرُ عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: قال سُلَيمانُ بنُ داودَ صلَّى اللهُ عليه وسلَّمَ: لأَطوفَنَّ اللَّيلةَ على مِئَةِ امرأةٍ، أو تِسعٍ وتِسعينَ امرأةً، كلُّهنَّ يَأتي بفارِسٍ يُجاهِدُ في سَبيلِ اللهِ، فقال له صاحِبُه: قُلْ: إنْ شاءَ اللهُ. فلم يَقُلْ: إنْ شاءَ اللهُ، فلم تَحمِلْ منهنَّ إلَّا امرأةٌ واحدةٌ شِقَّ رَجُلٍ، والذي نفْسُ مُحمَّدٍ بيَدِه، ",["لو قال: إنْ شاءَ اللهُ",1],"، ",["لَجاهَدوا في سَبيلِ اللهِ",2]," فُرسانًا أجمعونَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (1925) واللفظ له، والبخاري (2819) باختلاف يسير، ومسلم (1654) بنحوه، وفيه:  تسعين امرأة بدلا من مائة امرأة , أو تسع وتسعين امرأة.","bab":"أيمان › الاستثناء في اليمين","dorar":"aqAZT5He","merged":2,"otherRefs":["صحيح البخاري 3424 (صحيح)"]},{"id":"س-01741","fp":"29a2e9cb1086","stateId":578,"easy":"إذا استثنيت بـ«إن شاء الله» ← تتحقق حاجتك (من قصة سليمان)","cause":"لو كان سُلَيمانُ استَثنى","result":"لَحَمَلَت كُلُّ امرَأةٍ منهنَّ، فولَدَت فارِسًا يُقاتِلُ في سَبيلِ اللهِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"apply":{"k":"say","t":"«إن شاء الله»"},"ref":"صحيح البخاري 7469","srcLabel":"مسلم","text":["أنَّ نَبيَّ اللهِ سُلَيمانَ عليه السَّلامُ كان له سِتُّونَ امرَأةً، فقال: لَأطوفَنَّ اللَّيلةَ على نِسائي فلْتَحمِلْنَ كُلُّ امرَأةٍ، ولتَلِدْنَ فارِسًا يُقاتِلُ في سَبيلِ اللهِ، فطافَ على نِسائِه، فما ولَدَت منهنَّ إلَّا امرَأةٌ ولَدَت شِقَّ غُلامٍ، قال نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّم: ",["لو كان سُلَيمانُ استَثنى",1]," ",["لَحَمَلَت كُلُّ امرَأةٍ منهنَّ، فولَدَت فارِسًا يُقاتِلُ في سَبيلِ اللهِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1654) باختلاف يسير","bab":"أيمان › الاستثناء في اليمين","dorar":"pggWjhJ2","merged":3,"otherRefs":["تخريج مشكل الآثار 1926 (صحيح)","صحيح مسلم 1654 (صحيح)"]},{"id":"س-01733","fp":"7c8a0396bea7","stateId":578,"easy":"إذا قلت «إن شاء الله» ← تتحقق حاجتك (من قصة سليمان)","cause":"قال: إنْ شاءَ اللهُ","result":"لوَلَدتْ كُلُّ امرأةٍ منهُنَّ غُلامًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«إن شاء الله»"},"repOf":"س-01742","ref":"تخريج المسند لشعيب 10580","text":["إنَّ سُليمانَ بنَ داودَ قال: أطوفُ اللَّيلةَ على مِئةِ امرأةٍ، فتَلِدُ كُلُّ امرأةٍ منهُنَّ غُلامًا يَضرِبُ بالسَّيفِ في سَبيلِ اللهِ. ولم يَستَثْنِ، قال: فطافَ في تلك اللَّيلةِ على مِئةِ امرأةٍ، فلم تَلِدْ منهُنَّ غَيرُ امرأةٍ واحِدةٍ، ولَدَتْ نِصفَ إنسانٍ. قال: فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: لو أنَّه كان ",["قال: إنْ شاءَ اللهُ",1],"؛ ",["لوَلَدتْ كُلُّ امرأةٍ منهُنَّ غُلامًا",2]," يَضرِبُ بالسَّيفِ في سَبيلِ اللهِ عزَّ وجلَّ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (7469)، ومسلم (1654)، والترمذي معلقاً بعد حديث (1532)، والنسائي (3831)، وأحمد (10580) واللفظ له","bab":"أنبياء › عام","dorar":"d5YKSCg1"},{"id":"س-04093","fp":"dd3d84b4347e","stateId":578,"easy":"إذا تأنيت ← فالتأني من الله","cause":"التَّأنِّي","result":"من اللهِ","explicit":true,"ref":"مجمع الزوائد 8/22","srcLabel":"البيهقي","text":[["التَّأنِّي",1]," ",["من اللهِ",2]," والعَجَلةُ من الشَّيطانِ وما أحدٌ أكثرُ معاذيرَ من اللهِ وما من شيءٍ أحبُّ إلى اللهِ من الحمدِ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أبو يعلى (4256 )، والبيهقي في ((شعب الإيمان)) (4058 )","bab":"جن › صفة إبليس وجنوده","dorar":"mbnPxq0F","merged":2,"otherRefs":["صحيح الجامع 3011 (حسن)"]},{"id":"س-05344","fp":"a1209efd474e","stateId":578,"easy":"إذا سألت الله كل شيء حتى الشسع ← فالله إن لم ييسره لم يتيسر","cause":"سَلُوا اللهَ كلَّ شيءٍ حتَّى الشِّسْعَ","result":"فإنَّ اللهَ إنْ لم يُيَسِّرْه لم يَتَيَسَّرْ","explicit":true,"similar":["س-00710"],"otherNeedIds":[29],"ref":"مجمع الزوائد 10/153","srcLabel":"أحمد","text":["عن عائشةَ قالت ",["سَلُوا اللهَ كلَّ شيءٍ حتَّى الشِّسْعَ ",1],["فإنَّ اللهَ إنْ لم يُيَسِّرْه لم يَتَيَسَّرْ",2]],"grade":"صحيح","narrator":"[عروة بن الزبير]","muhaddith":"رجاله رجال الصحيح غير محمد بن عبيد الله بن المنادي وهو ثقة","takhrij":"أخرجه أحمد في ((الزهد)) (1130)، وأبو يعلى (4560)، وابن السني في ((عمل اليوم والليلة)) (355) باختلاف يسير.","bab":"رقائق وزهد › التوكل واليقين","dorar":"WjuiZLTo"},{"id":"س-05952","fp":"c5647dade1ef","stateId":578,"easy":"إذا استعنت على أمورك بالكتمان ← تقضيها","cause":"بالكِتْمانِ","result":"واستَعِينوا على أمورِكم","explicit":true,"ref":"الفتاوى الحديثية للوادعي 2/327","srcLabel":"الفتاوى الحديثية للوادعي","text":[["واستَعِينوا على أمورِكم",2]," ",["بالكِتْمانِ",1]],"grade":"صحيح","muhaddith":"لا تطمئن النفس إلى تصحيحه","bab":"رقائق وزهد › الوصايا النافعة","dorar":"Bh8vIxoS"},{"id":"س-00664","fp":"543c85c19655","stateId":578,"easy":"إذا قرأت يس أول النهار ← تُقضى حوائجك","cause":"مَن قرأَ يس في صدرِ النَّهارِ","result":"قُضِيَت حوائجُهُ","explicit":true,"ref":"هداية الرواة 2118","srcLabel":"الدارمي","text":["بلغَني أنَّ رسولَ اللَّهِ - صلَّى اللَّهُ علَيهِ وسلَّمَ - قالَ : ",["مَن قرأَ  يس  في صدرِ النَّهارِ ؛ ",1],["قُضِيَت حوائجُهُ",2]],"grade":"حسن","narrator":"عطاء بن أبي رباح","muhaddith":"رجاله ثقات فهو قوي لولا الإرسال","takhrij":"أخرجه الدارمي (3418)","bab":"أدعية وأذكار › أذكار الصباح","dorar":"2VFVhBHQ"},{"id":"س-00710","fp":"622bf8510de4","stateId":578,"easy":"إذا سألت الله حوائجك ولو شسع نعلك ← فإنه إن لم ييسره لم يتيسر","cause":"سلُوا اللهَ ما بدا لكم من حوائجِكم حتَّى شِسْعَ النَّعلِ","result":"فإنَّه إن لم يُيسِّرْه لم يتيسَّرْ","explicit":true,"repOf":"س-05344","otherNeedIds":[29],"ref":"شعب الإيمان 2/509","text":[["سلُوا اللهَ ما بدا لكم من حوائجِكم حتَّى شِسْعَ النَّعلِ ؛ ",1],["فإنَّه إن لم يُيسِّرْه لم يتيسَّرْ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده غير قوي","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (1118)","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"Juo6nn5u"},{"id":"س-01176","fp":"a70aa9322edc","stateId":578,"easy":"إذا صليت على النبي ﷺ كل يوم مئة مرة ← يقضي الله لك مئة حاجة","cause":"مَن صَلَّى عليَّ في كُلِّ يَومٍ مِائةَ مَرَّةٍ","result":"قَضى اللهُ له مِائةَ حاجةٍ: سَبعينَ مِنها لآخِرَتِه، وثَلاثينَ مِنها لدُنياه","explicit":true,"apply":{"k":"count","t":"مئة مرة"},"ref":"سبل الهدى والرشاد 12/427","srcLabel":"سبل الهدى والرشاد","text":["«",["مَن صَلَّى عليَّ في كُلِّ يَومٍ مِائةَ مَرَّةٍ ",1],["قَضى اللهُ له مِائةَ حاجةٍ: سَبعينَ مِنها لآخِرَتِه، وثَلاثينَ مِنها لدُنياه»",2]],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"حسن غريب.","bab":"أدعية وأذكار › فضل الذكر","dorar":"O51pThyT"},{"id":"س-04756","fp":"8e764bcb9d1f","stateId":578,"easy":"إذا صدقت الله ← يصدقك","cause":"إن تَصدُقِ اللَّهَ","result":"يصدُقْكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[62],"ref":"الصحيح المسند 474","srcLabel":"النسائي","text":["أنَّ رجُلًا منَ الأَعرابِ ، جاءَ إلى النَّبيِّ - صلَّى اللَّهُ علَيهِ وعلَى آلِهِ وسلَّمَ - فآمنَ بِهِ واتَّبعَهُ ثمَّ قالَ : أُهاجرُ معَكَ ، فأوصَى بِهِ النَّبيُّ - صلَّى اللَّهُ علَيهِ وعلَى آلِهِ وسلَّمَ - بعضَ أصحابِهِ ، فلمَّا كانَت غَزوةٌ ، غنِمَ النَّبيُّ - صلَّى اللَّهُ علَيهِ وعلَى آلِهِ وسلَّمَ - سَبيًا فقسمَ وقَسمَ لَهُ ، فأعطَى أصحابَهُ ما قسمَ لَهُ ، وَكانَ يرعَى ظَهْرَهُم فلمَّا جاءَ رفعوهُ إليهِ فقالَ : ما هذا ؟ قالوا : قَسمٌ قسمَهُ لَكَ النَّبيُّ - صلَّى اللَّهُ علَيهِ وعلَى آلِهِ وسلَّمَ - فأخذَهُ فجاءَ إلى النَّبيِّ - صلَّى اللَّهُ علَيهِ وعلَى آلِهِ وسلَّمَ – فقالَ : ما هذا ؟ قالَ : قسَمتُهُ لَكَ ، قالَ : ما علَى هذا اتَّبعتُكَ ولَكِنِّي اتَّبعتُكَ علَى أن أُرمَى إلى ههُنا ، وأشارَ إلى حلقِهِ بسَهْمٍ ، فأموتَ فأدخلَ الجنَّةَ فقالَ : ",["إن تَصدُقِ اللَّهَ",1]," ",["يصدُقْكَ",2]," فلبِثوا قليلًا ثمَّ نَهَضوا في قتالِ العدوِّ ، فأُتِيَ بِهِ النَّبيُّ - صلَّى اللَّهُ علَيهِ وعلَى آلِهِ وسلَّمَ - يُحمَلُ قد أصابَهُ سَهْمٌ حَيثُ أشارَ ، فقالَ النَّبيُّ - صلَّى اللَّهُ علَيهِ وعلَى آله وسلَّمَ- : أَهوَ هوَ ؟ قالوا : نعَم قالَ : صدقَ اللَّهَ فصدقَهُ ثمَّ كفَّنَهُ النَّبيُّ - صلَّى اللَّهُ علَيهِ وعلَى آلِهِ وسلَّمَ - في جُبَّةِ النَّبيِّ - صلَّى اللَّهُ علَيهِ وعلَى آلِهِ وسلَّمَ - ثمَّ قدَّمَهُ فصلَّى علَيهِ ، فَكانَ فيما ظَهَرَ من صلاتِهِ : اللَّهمَّ هذا عبدُكَ خرجَ مُهاجرًا في سبيلِكَ فقُتِلَ شَهيدًا أَنا شَهيدٌ علَى ذلِكَ ."],"grade":"صحيح","narrator":"شداد بن الهاد الليثي","muhaddith":"صحيح","takhrij":"أخرجه النسائي (4/60)، وعبد الرزاق في ((المصنف)) (3/545)، والطبراني في ((الكبير)) (7/271) باختلاف يسير.","bab":"رقائق وزهد › الإخلاص","dorar":"T1E0Pi39"},{"id":"س-07210","fp":"ce14c9f9bb36","stateId":578,"easy":"إذا فقدت شيئاً فتوضأت وصليت ركعتين ودعوت «اللهم راد الضالة...» ← يرد الله عليك ضالتك","cause":"يتوضَّأُ ويصلِّي رَكعتينِ ثمَّ يتشَهَّدُ ثمَّ يقولُ اللَّهمَّ رادَّ الضَّالَّةِ هاديَ الضلالةِ تَهدي منَ الضَّلالِ ردَّ عليَّ ضالَّتي بعزَّتِكَ وسلطانِكَ فإنَّها من فضلِكَ وعطائِكَ","result":"عنِ الضَّالَّةِ","explicit":true,"apply":{"k":"say","t":"«اللَّهمَّ رادَّ الضَّالَّةِ هاديَ الضلالةِ تَهدي منَ الضَّلالِ ردَّ عليَّ ضالَّتي بعزَّتِكَ وسلطانِكَ فإنَّها من فضلِكَ وعطائِك» · العدد: ركعتين"},"ref":"الوابل الصيب 191","srcLabel":"الوابل الصيب","text":["سُئلَ ابنُ عمرَ رضيَ اللَّهُ عنْهُ ",["عنِ الضَّالَّةِ",2]," فقالَ ",["يتوضَّأُ ويصلِّي رَكعتينِ ثمَّ يتشَهَّدُ ثمَّ يقولُ اللَّهمَّ رادَّ الضَّالَّةِ هاديَ الضلالةِ تَهدي منَ الضَّلالِ ردَّ عليَّ ضالَّتي بعزَّتِكَ وسلطانِكَ فإنَّها من فضلِكَ وعطائِكَ",1]],"grade":"حسن","muhaddith":"حسن","bab":"علم › حسن السؤال ونصح العالم","dorar":"Xb9gsTZQ"},{"id":"س-01174","fp":"a25c0e678153","stateId":578,"easy":"إذا كثرت عليك الشرائع فالزم ذكر الله ← يكفيك أن يبقى لسانك رطباً به","cause":"لا يَزالُ لِسانُك رَطْبًا مِن ذِكْرِ اللهِ","result":"إنَّ شَرائِعَ الإسْلامِ قد كَثُرَتْ علينا فبِأيِّه نَتَمَسَّكُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"الأحاديث المختارة 9 / 83","srcLabel":"متفق عليه","text":["«أتى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ أعْرابِيَّانِ، فقالَ أحَدُهما: مَن خَيْرُ الرِّجالِ يا مُحمَّدُ؟ فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: مَن طالَ عُمرُه وحَسُنَ عَمَلُه، وقالَ الآخَرُ: ",["إنَّ شَرائِعَ الإسْلامِ قد كَثُرَتْ علينا فبِأيِّه نَتَمَسَّكُ",2],"؟ فقالَ: ",["لا يَزالُ لِسانُك رَطْبًا مِن ذِكْرِ اللهِ",1],"»."],"grade":"صحيح","narrator":"عبدالله بن بسر المازني","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"أدعية وأذكار › فضل الذكر","dorar":"Nlhe38af"},{"id":"س-04417","fp":"7cdc76d3b8d6","stateId":578,"easy":"إذا قلت «إن شاء الله» ← تتحقق حاجتك (من قصة سليمان)","cause":"قل إن شاءَ اللهُ","result":"لو قالها لقاتلوا في سبيلِ اللهِ فرسانًا أجمعون","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«إن شاء الله»"},"ref":"أعلام الموقعين 4/50","srcLabel":"أعلام الموقعين","text":["أن سليمانَ بنَ داودَ عليهما الصلاة والسلام قال لأطوفن الليلةَ على كذا وكذا امرأةٍ تحملُ كلَّ امرأةٍ منهن غلامًا يقاتلُ في سبيلِ اللهِ ، فقال له الملكُ الموكلُ به ",["قل إن شاءَ اللهُ",1]," ، فلم يقلْ ، فقال النبيُّ صلى اللهُ عليهِ وسلَّمَ والذي نفسي بيدِه ",["لو قالها لقاتلوا في سبيلِ اللهِ فرسانًا أجمعون",2]],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"ثابت","bab":"جهاد › النية في القتال والغزو","dorar":"8I8MRmnH"},{"id":"س-08219","fp":"9fcc5260cf3d","stateId":579,"easy":"إذا لم تطلب القضاء ولم تستعن عليه ← ينزل الله إليك ملكاً يسددك","cause":"ومن لم يَطْلَبْه ولم يَستَعِنْ عليه","result":"أنزَلَ اللهُ إليه مَلَكًا يُسَدِّدُه","explicit":true,"star":true,"otherNeedIds":[15],"ref":"الأحاديث المختارة 1580","srcLabel":"البخاري","text":["«من طَلَب القَضاءَ واستعان عليه وُكِلَ إليه، ",["ومن لم يَطْلَبْه ولم يَستَعِنْ عليه",1]," ",["أنزَلَ اللهُ إليه مَلَكًا يُسَدِّدُه",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"ملائكة › أعمال الملائكة","dorar":"sGOBTOrL"},{"id":"س-05798","fp":"1d32e3b8f5f5","stateId":579,"easy":"إذا اشتبه عليك أمر فعليك بالتؤدة ← حتى يريك الله منه المخرج","cause":"فعليكَ بالتؤدةِ","result":"حتى يريَكَ اللهُ منهُ المخرجَ","explicit":true,"star":true,"ref":"الجامع الصغير 416","srcLabel":"البخاري","text":["إذا أردْتَ أمرًا ",["فعليكَ بالتؤدةِ",1],"، ",["حتى يريَكَ اللهُ منهُ المخرجَ",2]],"grade":"حسن","narrator":"رجل من بلي","muhaddith":"حسن","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (888)، والفسوي في ((المعرفة والتاريخ)) (3/ 411)، والخطيب البغدادي في ((الفقيه والمتفقه)) (2/ 397) جميعا بلفظه.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"yUGETzvm"},{"id":"س-08141","fp":"42f0f3bbc80a","stateId":579,"easy":"إذا أُكرهت على القضاء ← ينزل الله عليك ملكاً يسددك","cause":"ومن أُكِره عليه","result":"أنزل اللهُ عليه ملَكًا يُسدِّدُه","explicit":true,"otherNeedIds":[15],"ref":"الترغيب والترهيب 3/183","srcLabel":"أبو داود","text":["من ابتغَى القضاءَ وسأل فيه شفعاءَ وُكِل إلى نفسِه ",["ومن أُكِره عليه",1]," ",["أنزل اللهُ عليه ملَكًا يُسدِّدُه",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (3578)، والترمذي (1324) واللفظ له، وابن ماجه (2309)، وأحمد (13302).","bab":"ملائكة › أعمال الملائكة","dorar":"YmTEqcr4","merged":2,"otherRefs":["الأحاديث المختارة 1581 (صحيح)"]},{"id":"س-05863","fp":"598bd1ff3640","stateId":579,"easy":"إذا تأنيت ← أصبت أو كدت","cause":"من تأنَّى","result":"أصاب أو كاد","explicit":true,"ref":"شرح كتاب الشهاب 469","srcLabel":"الطبراني","text":[["من تأنَّى ",1],["أصاب أو كاد",2]," ومن عجِلَ أخطأ أو كاد"],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني (17/310) (858)، والقضاعي في ((مسند الشهاب)) (362)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"eNEO70Ga"},{"id":"س-07140","fp":"7439c1613bef","stateId":579,"easy":"إذا قضيت بين اثنين فاسمع كلام الآخر ← تعلم لمن الحق","cause":"فلا تقضي لواحدٍ حتَّى تسمَعَ كلامَ الآخَرِ","result":"فإنَّه أجدرُ أنْ تعلَمَ لِمَن الحقُّ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[18],"ref":"صحيح ابن حبان 5065","srcLabel":"أحمد","text":["بعَثني رسولُ اللهِ صلَّى اللهُ عليه وسلَّم برسالةٍ فقُلْتُ: يا رسولَ اللهِ: تبعَثُني وأنا غلامٌ حديثُ السِّنِّ فأُسأَلَ عن القضاءِ ولا أدريَ ما أُجيبُ ؟ قال: ( ما بدٌّ مِن ذلك أنْ أذهَبَ بها أنا أو أنتَ ) قال: فقُلْتُ: وإنْ كان ولا بدَّ أذهَبُ أنا فقال: ( انطلِقْ فاقرَأْها على النَّاسِ فإنَّ اللهَ تعالى يُثبِّتُ لسانَك ويهدي قلبَك ) ثمَّ قال: ( إنَّ النَّاسَ سيتقاضَوْنَ فإذا أتاك الخَصْمانِ ",["فلا تقضي لواحدٍ حتَّى تسمَعَ كلامَ الآخَرِ",1]," ",["فإنَّه أجدرُ أنْ تعلَمَ لِمَن الحقُّ",2]," )"],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (882)، والطيالسي (127) بنحوه، وابن ماجة (2310) مختصرًا.","bab":"علم › حسن السؤال ونصح العالم","dorar":"w4VViVEL","merged":3,"otherRefs":["تخريج المسند لشاكر 2/289 (صحيح)","تخريج مشكل الآثار 50 (حسن)"]},{"id":"س-05873","fp":"390001dbe66c","stateId":579,"easy":"إذا استشرت ← لم تعدم رشداً","cause":"منِ استشارَ منهُم","result":"لم يُعدَمْ رُشدًا","explicit":true,"ref":"الدر المنثور 4/89","srcLabel":"البيهقي","text":["لَمَّا نزلَت وَشَاوِرْهُمْ فِي الْأَمْرِ قال رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ أما إنَّ اللَّهَ ورسولَهُ لغنِيَّانِ عنها ولكن جعلها اللَّهُ رحمةً لأمَّتي ف",["منِ استشارَ منهُم",1]," ",["لم يُعدَمْ رُشدًا",2]," ومن تركَها لَم يُعدَمْ غَيًّا"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (5/ 544)، وأبو عبدالرحمن السلمي في ((آداب الصحبة)) (77)، والبيهقي في ((شعب الإيمان)) (7136)، وابن حجر في ((موافقة الخبر الخبر)) (1/ 61)، واللفظ لهم.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"RQVSZcxu"},{"id":"س-03746","fp":"fe523658df01","stateId":579,"easy":"إذا لم تستعجل بالبلية قبل نزولها ← يكون فيكم من إذا قال سُدّد ووُفّق","cause":"لا تَعجَلوا بالبَليَّةِ قبل نُزولِها","result":"فإنَّكم إلا تفعَلوا أوشَكَ أنْ يكونَ فيكم منْ إذا قال: سُدِّدَ أو وُفِّقَ","explicit":true,"ref":"إتحاف الخيرة المهرة 8/96","srcLabel":"أبو داود","text":[["لا تَعجَلوا بالبَليَّةِ قبل نُزولِها  ",1],["فإنَّكم إلا تفعَلوا أوشَكَ أنْ يكونَ فيكم منْ إذا قال:  سُدِّدَ أو وُفِّقَ",2],"  وإنَّكم إنْ عجلْتُمْ تشَتَّتتْ بكمُ الطُّرُقُ ها هُنا وها هنا"],"grade":"حسن","narrator":"معاذ بن جبل","muhaddith":"رواته ثقات","takhrij":"أخرجه إسحاق بن راهويه كما في ((المطالب العالية)) لابن حجر (3029)، وأبو داود في ((المراسيل)) (457)، وابن بطة في ((الإبانة)) (1/رقم292) جميعهم بلفظه، والدارمي (155) باختلاف يسير.","bab":"اعتصام بالسنة › ما يكره من كثرة السؤال وتكلف ما لا يعنيه","dorar":"U2QwxQTu"},{"id":"س-05341","fp":"544d5b637faf","stateId":579,"easy":"إذا هممت بأمر فصلّ ركعتين واستخر ← يختار الله لك الخير","cause":"فليَركَعْ رَكعَتَينِ مِن غيرِ الفَريضةِ، ثُمَّ ليَقُل: اللهُمَّ إنِّي أستَخيرُكَ بعِلمِكَ، وأستَقدِرُكَ بقُدرَتِكَ، وأسألُكَ مِن فضلِكَ","result":"إذا هَمَّ أحَدُكُم بالأمرِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"apply":{"k":"count","t":"ركعتين"},"ref":"صحيح البخاري 7390","srcLabel":"أبو داود","text":["كان رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يُعَلِّمُ أصحابَه الِاستِخارةَ في الأُمورِ كُلِّها كما يُعَلِّمُهمُ السُّورةَ مِنَ القُرآنِ، يقولُ: ",["إذا هَمَّ أحَدُكُم بالأمرِ",2]," ",["فليَركَعْ رَكعَتَينِ مِن غيرِ الفَريضةِ، ثُمَّ ليَقُل: اللهُمَّ إنِّي أستَخيرُكَ بعِلمِكَ، وأستَقدِرُكَ بقُدرَتِكَ، وأسألُكَ مِن فضلِكَ",1],"؛ فإنَّكَ تَقدِرُ ولا أقدِرُ، وتَعلَمُ ولا أعلَمُ، وأنتَ عَلَّامُ الغُيوبِ، اللهُمَّ فإن كُنتَ تَعلَمُ هذا الأمرَ -ثُمَّ تُسَمِّيه بعَينِه- خَيرًا لي في عاجِلِ أمري وآجِلِه -قال: أو في ديني ومعاشي وعاقِبةِ أمري- فاقدُرْه لي ويَسِّرْه لي، ثُمَّ بارِكْ لي فيه، اللهُمَّ وإن كُنتَ تَعلَمُ أنَّه شَرٌّ لي في ديني ومعاشي وعاقِبةِ أمري - أو قال: في عاجِلِ أمري وآجِلِه- فاصرِفْني عنه، واقدُرْ لي الخَيرَ حَيثُ كان، ثُمَّ رَضِّني به."],"grade":"صحيح","narrator":"جابر بن عبدالله السلمي","muhaddith":"[صحيح]","takhrij":"أخرجه أبو داود (1538)، والترمذي (480)، وابن حبان (887) واللفظ لهم.","bab":"رقائق وزهد › التوكل واليقين","dorar":"Mm1jmulN","merged":2,"otherRefs":["مختصر الأحكام 2/450 (حسن)"]},{"id":"س-01850","fp":"923c6b1f8135","stateId":580,"easy":"إذا قصرت الصلاة في السفر ← فهي صدقة تصدق الله بها عليك فاقبلها","cause":"أَنْ تَقْصُرُوا مِنَ الصَّلَاةِ","result":"صَدَقةٌ تصدَّقَ اللهُ بها عليكم فاقبَلوا صَدَقتَه","explicit":true,"star":true,"similar":["س-03925"],"ref":"تخريج مشكل الآثار 1647","srcLabel":"مسلم","text":["عن يَعلى بنِ مُنبِّهٍ، قال: سألتُ عُمَرَ بنَ الخطَّابِ رضِيَ اللهُ عنه، ثم ذَكَرَ مِثلَه، [يعني حديثَ: قلتُ لعُمَرَ بنِ الخطَّابِ رضِيَ اللهُ عنه: إنَّما قال اللهُ عزَّ وجلَّ: {فَلَيْسَ عَلَيْكُمْ جُنَاحٌ ",["أَنْ تَقْصُرُوا مِنَ الصَّلَاةِ",1]," إِنْ خِفْتُمْ أَنْ يَفْتِنَكُمُ الَّذِينَ كَفَرُوا} [النساء: 101] فقد أَمِنَ الناسُ، فقال عُمَرُ: إنِّي عَجِبتُ ممَّا عَجِبتَ منه، فسَأَلتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقال: ",["صَدَقةٌ تصدَّقَ اللهُ بها عليكم فاقبَلوا صَدَقتَه",2],".]"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (686)، والترمذي (3034)، والنسائي (1433) واللفظ لهم.","bab":"إحسان › الأخذ بالرخصة","dorar":"b1GBYtLL","merged":3,"otherRefs":["تخريج المسند لشعيب 245 (صحيح)","تخريج صحيح ابن حبان 2741 (صحيح)"]},{"id":"س-03925","fp":"e51eba86378a","stateId":580,"easy":"إذا قصرت الصلاة ← فهي رخصة الله فاقبلها","cause":"فَلَيْسَ عَلَيْكُمْ جُنَاحٌ أَنْ تَقْصُرُوا مِنَ الصَّلَاةِ","result":"هو صدقةٌ تصدَّق اللهُ بها عليكم فاقبَلوا رخصتَه","explicit":true,"repOf":"س-01850","ref":"تخريج صحيح ابن حبان 2740","text":["قُلْتُ لعمرَ بنِ الخطَّابِ: عجِبْتُ للنَّاسِ وقَصْرِهم الصَّلاةَ وقد قال اللهُ: {",["فَلَيْسَ عَلَيْكُمْ جُنَاحٌ أَنْ تَقْصُرُوا مِنَ الصَّلَاةِ",1]," إِنْ خِفْتُمْ أَنْ يَفْتِنَكُمُ الَّذِينَ كَفَرُوا} [النساء: 101] وقد ذهَب هذا فقال عمرُ: عجِبْتُ ممَّا عجِبْتَ منه فذكَرْتُ ذلك لرسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقال: ( ",["هو صدقةٌ تصدَّق اللهُ بها عليكم فاقبَلوا رخصتَه",2]," )"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن حبان (2739) واللفظ له، ومسلم (686)، والترمذي (3034) باختلاف يسير، وأبو داود (1199) بنحوه.","bab":"تفسير آيات › سورة النساء","dorar":"pYMTGg91"},{"id":"س-00379","fp":"9b84f3591b7f","stateId":580,"easy":"إذا أفسحت في المجلس ← يفسح الله لك","cause":"افسَحوا","result":"يَفسَحِ اللهُ لكم","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 10776","srcLabel":"البخاري","text":["لا يُقيمُ الرَّجُلُ الرَّجُلَ مِن مَجلِسِهِ ثم يَجلِسُ فيه، ولكنِ ",["افسَحوا",1],"؛ ",["يَفسَحِ اللهُ لكم",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (10776) واللفظ له، والبخاري في ((التاريخ الكبير)) (1/420) مختصراً، وابن أبي شيبة (26092) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"cjNgr3Dl","merged":2,"otherRefs":["تخريج المسند لشعيب 10266 (صحيح)"]},{"id":"س-07252","fp":"098865a5fa4d","stateId":580,"easy":"إذا يسّرت على معسر ← ييسر الله عليك في الدنيا والآخرة","cause":"ومَن يسَّرَ على مُعْسِرٍ","result":"يسَّرَ اللهُ عليه في الدُّنيا والآخِرَةِ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 7427","srcLabel":"مسلم","text":["مَن نفَّسَ عن مُؤْمنٍ كُرْبَةً مِن كُرَبِ الدُّنيا؛ نفَّسَ اللهُ عَنه كُرْبَةً مِن كُرَبِ يَوْمِ القِيامَةِ، ومَن ستَرَ مُسْلمًا ستَرَه اللهُ في الدُّنيا والآخِرَةِ، ",["ومَن يسَّرَ على مُعْسِرٍ ",1],["يسَّرَ اللهُ عليه في الدُّنيا والآخِرَةِ",2],"، واللهُ في عَوْنِ العَبْدِ ما كان العَبْدُ في عَوْنِ أَخيه، ومَن سلَكَ طَريقًا يَلْتَمِسُ فيه عِلْمًا سهَّلَ اللهُ له به طَريقًا إلى الجنةِ، وما اجتمَعَ قَوْمٌ في بَيْتٍ مِن بُيوتِ اللهِ يَتْلُون كِتابَ اللهِ، ويَتَدارَسُونه بَيْنَهم؛ إلَّا نزلَتْ عليهم السَّكِينَةُ، وغشِيَتْهم الرَّحْـمةُ، وحفَّتْهم الـمَلائِكةُ، وذكَرَهم اللهُ عزَّ وجلَّ فيمَن عِندَه، ومَن أبْطَأَ به عَمَلُه، لَـمْ يُسْرِعْ به نَسَبُه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (2699) باختلاف يسير","bab":"علم › فضل مجالس العلم والذكر","dorar":"hv3Ejh53"},{"id":"س-00280","fp":"26f1568dde6e","stateId":580,"easy":"إذا رفقت ← فالرفق يُمن","cause":"إنَّ الرِّفقَ","result":"يُمنٌ","explicit":true,"otherNeedIds":[1],"ref":"المصابيح في الأحاديث المتواترة 592","srcLabel":"المصابيح في الأحاديث المتواترة","text":[["إنَّ الرِّفقَ",1]," ",["يُمنٌ",2],"، وإنَّ الخُرقَ شُؤمٌ، وإنَّ اللهَ إذا أراد بأهلِ بَيتٍ خيرًا أدخل عليهم بابَ الرِّفقِ؛ وإنَّ الرِّفقَ لم يكُنْ في شيءٍ إلَّا زانه، وإنَّ الخُرقَ لم يكُنْ في شيءٍ إلَّا شانه"],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"l5YQX3WT"},{"id":"س-00325","fp":"4e9d09dcdef9","stateId":580,"easy":"إذا سمحت ← يُسمح لك","cause":"اسْمَحْ","result":"يُسْمَحْ لكَ","explicit":true,"similar":["س-02683"],"ref":"صحيح الجامع 982","srcLabel":"أحمد","text":[["اسْمَحْ",1]," ",["يُسْمَحْ لكَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه أحمد (2233)، والحارث في ((مسنده)) (1081)، والطبراني في ((المعجم الأوسط)) (5112).","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"IbcSgcx3"},{"id":"س-02683","fp":"ad64d00803dd","stateId":580,"easy":"إذا سمحت ← يُسمح لك","cause":"اسْمَحُوا","result":"يُسمَحْ لَكُمْ","explicit":true,"repOf":"س-00325","ref":"صحيح الجامع 981","text":[["اسْمَحُوا",1]," ",["يُسمَحْ لَكُمْ",2],"."],"grade":"صحيح","narrator":"عطاء بن أبي رباح","muhaddith":"صحيح","takhrij":"أخرجه عبدالرزاق في ((المصنف)) (237)","bab":"إيمان › الدين يسر","dorar":"BnYLZRQ6"},{"id":"س-07588","fp":"2a956342af91","stateId":580,"easy":"إذا عالجت الخطأ برفق ← فإنما بُعثتم ميسرين","cause":"أَهْرِيقُوا علَى بَوْلِهِ","result":"إنَّما بُعِثْتُمْ مُيَسِّرِينَ ولَمْ تُبْعَثُوا مُعَسِّرِينَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الاستذكار 1/201","srcLabel":"الاستذكار","text":["حديثُ صبِّ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ الذَّنوبَ على بولِ الأعرابيِّ إذْ بالَ في المسجدِ [يعني حديث: عن عبيد الله بن عبد الله بن عتبة، أن أبا هريرة، أخبره: أنَّ أعْرَابِيًّا بَالَ في المَسْجِدِ، فَثَارَ إلَيْهِ النَّاسُ ليَقَعُوا به، فَقالَ لهمْ رَسولُ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ: دَعُوهُ، و",["أَهْرِيقُوا علَى بَوْلِهِ",1]," ذَنُوبًا مِن مَاءٍ -أوْ سَجْلًا مِن مَاءٍ- ف",["إنَّما بُعِثْتُمْ مُيَسِّرِينَ ولَمْ تُبْعَثُوا مُعَسِّرِينَ",2],".]    حديثُ صبِّ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ الذَّنوبَ على بولِ الأعرابيِّ إذْ بالَ في المسجدِ[يعني حديث: عن أنس بن مالك:  أنَّ أعْرَابِيًّا بَالَ في المَسْجِدِ، فَقَامُوا إلَيْهِ، فَقَالَ رَسولُ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ: لا تُزْرِمُوهُ ثُمَّ دَعَا بدَلْوٍ مِن مَاءٍ فَصُبَّ عليه.]"],"grade":"صحيح","narrator":"أبو هريرة.       وأنس بن مالك.","muhaddith":"ثابت","bab":"فضائل النبي وصفته ودلائل النبوة › شفقته على أمته","dorar":"XqaAeq1p","merged":3,"otherRefs":["سنن الترمذي 147 (صحيح)","صحيح البخاري 220 (صحيح)"]},{"id":"س-02285","fp":"df1328a35022","stateId":580,"easy":"إذا وسّعت في الكيل لإخوانك ← تملؤه (من واقعة)","cause":"أوسِعوهُ","result":"تَملَئوهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح ابن خزيمة 2/ 463","srcLabel":"البيهقي","text":["أتَى رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قَومًا منَ الأنصارِ وَهُم يَبنونَ مسجِدًا، فقالَ لَهُم: ",["أوسِعوهُ",1]," ",["تَملَئوهُ",2]],"grade":"صحيح","narrator":"أبو قتادة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البيهقي (4362) بلفظه، والطيالسي (639)، والخطيب في ((تاريخ بغداد)) (554) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"HRzXRWcR"},{"id":"س-06876","fp":"590f897c8d72","stateId":581,"easy":"إذا سافرت بالليل ← فالأرض تُطوى بالليل","cause":"وعليكم بالدُّلْجةِ","result":"فإن الأرضَ تُطوى بالليلِ","explicit":true,"star":true,"apply":{"k":"time","t":"في السفر"},"similar":["س-01506"],"ref":"الاستذكار 7/545","srcLabel":"الطبراني","text":["إذا كانت الأرضُ مُخصِبةً ، فاقصدوا في السيرِ ، وأعطوا الرِّكابَ حقَّها ، فإن اللهَ رفيقٌ يحبُّ الرفقَ ، وإذا كانت الأرضُ مجدبةً فانْجوا عنها ، ",["وعليكم بالدُّلْجةِ",1]," ، ",["فإن الأرضَ تُطوى بالليلِ",2]," ، وإياكم والتعريسَ على ظهرِ الطريقِ ، فإنه مأوى الحياتِ ، ومدرجةُ السباعِ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"محفوظ","takhrij":"أخرجه الطبراني (10/399) (10811)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"OqNmRBWb","merged":4,"otherRefs":["تخريج مشكل الآثار 113 (صحيح)","تخريج مشكل الآثار 115 (صحيح)","السلسلة الصحيحة 682 (صحيح)"]},{"id":"س-00220","fp":"d57a358c9f62","stateId":581,"easy":"إذا سافرت بالليل ← فإنما يطويها الله لك","cause":"و عليكم بالدُّلجةِ","result":"فإنما يطويها اللهُ","explicit":true,"apply":{"k":"time","t":"في السفر"},"ref":"صحيح الجامع 576","srcLabel":"الطبراني","text":["إذا ركبتُم هذه البهائمَ العُجْمَ فانْجُوا عليها ، فإذا كانت سَنَةٌ فانجُوا ، ",["و عليكم بالدُّلجةِ",1]," ، ",["فإنما يطويها اللهُ",2]],"grade":"صحيح","narrator":"عبدالله بن مغفل","muhaddith":"صحيح","takhrij":"أخرجه الطبراني كما في ((مجمع الزوائد)) للهيثمي  (3/216)","bab":"آداب المجلس › الركوب على الدابة","dorar":"bcJsh0fG"},{"id":"س-01506","fp":"1aa0538ad277","stateId":581,"easy":"إذا سافرت بالليل ← فالأرض تُطوى بالليل","cause":"وعليكم بالدُّلَجِ","result":"فإنَّ الأرضَ تُطْوى بالليلِ","explicit":true,"apply":{"k":"time","t":"في السفر"},"repOf":"س-06876","ref":"تخريج المسند لشعيب 14277","text":["إذا سِرْتم في الخِصبِ، فأَمْكِنوا الرِّكابَ أسْنانَها، ولا تَجاوَزوا المنازِلَ، وإذا سِرْتم في الجَدْبِ، فاستَجِدُّوا، ",["وعليكم بالدُّلَجِ",1],"؛ ",["فإنَّ الأرضَ تُطْوى بالليلِ",2],"، وإذا تغوَّلَتْ لكم الغِيلانُ، فبادِروا بالأذانِ، وإيَّاكم والصَّلاةَ على جَوادِّ الطَّريقِ، والنُّزولَ عليها؛ فإنَّها مَأْوى الحيَّاتِ والسِّباعِ، وقَضاءَ الحاجةِ؛ فإنَّها الملاعِنُ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح لغيره دون قوله: \"وإذا تغولت الغيلان فبادروا بالأذان\"","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10791)، وابن ماجه (329) مختصراً، وأحمد (14277) واللفظ له","bab":"أذان › فضل التأذين","dorar":"SXuknuMC"}]}