{"schema":1,"kind":"sunan-chunk","version":"sunan-b41390b43331","needId":29,"stateIds":[316,317,318,319,320,321,322,323,324,325,326,327,328,329,330,331,332,333,334],"items":[{"id":"س-02245","fp":"28ea6c0a6bf5","stateId":316,"easy":"إذا وافقت ساعة الليل تسأل الله خيراً ← يعطيك إياه","cause":"إنَّ في اللَّيلِ لَساعةً لا يوافِقُها رَجُلٌ مُسلِمٌ، يَسألُ اللَّهَ خَيرًا مِن أمرِ الدُّنيا والآخِرةِ","result":"إلَّا أعطاه إيَّاه","explicit":true,"star":true,"ref":"صحيح مسلم 757","srcLabel":"مسلم","text":["سَمِعتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم يقولُ: ",["إنَّ في اللَّيلِ لَساعةً لا يوافِقُها رَجُلٌ مُسلِمٌ، يَسألُ اللَّهَ خَيرًا مِن أمرِ الدُّنيا والآخِرةِ",1],"، ",["إلَّا أعطاه إيَّاه",2],"، وذلك كُلَّ لَيلةٍ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (757).","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"vodGV5LL","merged":4,"otherRefs":["صحيح الجامع 5754 (صحيح)","نخب الافكار 2/220 (حسن)","تخريج المسند لشعيب 22114 (صحيح)"]},{"id":"س-00022","fp":"ed3e598ecf17","stateId":316,"easy":"إذا سألت الله في وقت النزول ← يعطيك","cause":"هل من سائلٍ","result":"فيُعْطى","explicit":true,"repOf":"س-03142","ref":"تخريج المسند لشعيب 11386","text":["\"إنَّ اللهَ يُمهِلُ حتى إذا كان ثُلُثُ الليلِ هبَط، فيقولُ: ",["هل من سائلٍ",1]," ",["فيُعْطى",2],"؟ هل من مُستغفِرٍ من ذنبٍ؟ هل من داعٍ فيُستجابُ له؟\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1145)، ومسلم (758)، وأبو داود (1315)، والترمذي (446)، والنسائي في ((السنن الكبرى)) (10319)، وابن ماجه (1366) بنحوه من حديث أبي هريرة، وأحمد (11386) واللفظ له","bab":"آداب الدعاء › استجابة الدعاء","dorar":"0gH5tzsk"},{"id":"س-00023","fp":"bf1caa3fad2c","stateId":316,"easy":"إذا دعوت في وقت النزول ← يُستجاب لك","cause":"هل من داعٍ","result":"فيُستجابُ له","explicit":true,"repOf":"س-03142","ref":"تخريج المسند لشعيب 11386","text":["\"إنَّ اللهَ يُمهِلُ حتى إذا كان ثُلُثُ الليلِ هبَط، فيقولُ: هل من سائلٍ فيُعْطى؟ هل من مُستغفِرٍ من ذنبٍ؟ ",["هل من داعٍ",1]," ",["فيُستجابُ له",2],"؟\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1145)، ومسلم (758)، وأبو داود (1315)، والترمذي (446)، والنسائي في ((السنن الكبرى)) (10319)، وابن ماجه (1366) بنحوه من حديث أبي هريرة، وأحمد (11386) واللفظ له","bab":"آداب الدعاء › استجابة الدعاء","dorar":"0gH5tzsk"},{"id":"س-00002","fp":"fbe440bac672","stateId":316,"easy":"إذا دعوت في وقت النزول الإلهي ← يُستجاب لك ويُعطى سؤلك","cause":"هل من داعٍ","result":"يُستَجابُ لهُ هل مِن سائلٍ يُعطَى سؤلَهُ","explicit":true,"repOf":"س-03142","ref":"الزواجر عن اقتراف الكبائر 1/198","text":["إذا كانَ أوَّلُ ليلةٍ مِن شهرِ رمضانَ فُتِحَت أبوابُ الجِنانِ فلَم يُغلَق منها بابٌ واحدٌ الشَّهرَ كلَّهُ ، وغُلِّقَت أبوابُ النَّارِ فلم يُفتَح منها بابٌ واحدٌ الشَّهرَ كلَّهُ وغُلَّت عُتاةُ الجنِّ وَنادَى مُنادٍ منَ السَّماءِ كلَّ ليلةٍ إلى انفِجارِ الصُّبحِ يا باغيَ الخَيرِ تَمِّم وأبشِر ويا باغيَ الشَّرِّ أقصِر وأبصِر هل مِن مُستغفرٍ يُغفَرُ لهُ هَل من تائبٍ يُتابُ عليهِ ",["هل من داعٍ",1]," ",["يُستَجابُ لهُ هل مِن سائلٍ يُعطَى سؤلَهُ",2]," وللَّهِ عزَّ وجلَّ عندَ كلِّ فطرٍ مِن شهرِ رمضانَ كلَّ لَيلةٍ عتقاءُ منَ النَّارِ ستُّونَ ألفًا فإذا كانَ يومُ الفطرِ أعتقَ اللَّهُ مثلَ ما أعتقَ في جميعِ الشَّهرِ ثَلاثينَ مرَّةً ستِّينَ ألفًا"],"grade":"صحيح","muhaddith":"صحيح أو حسن","bab":"آداب الدعاء › استجابة الدعاء","dorar":"sHjgh6Tp"},{"id":"س-00014","fp":"38abc0dfd4f6","stateId":316,"easy":"إذا استيقظت من الليل فذكرت الله ثم دعوت ← يُغفر لك ويُستجاب لك","cause":"ما منْ عبدٍ مسلمٍ يتَعَارُّ من الليلِ فيقولَ سبحانَ اللهِ والحمدُ للهِ ولا إلهَ","result":"إلا اللهُ واللهُ أكبرُ ، اللهمَّ اغْفِرْ لي إلا غُفِرَ لهُ ، فإنْ عَزَمَ فقامَ فتوضَأَ وصلَّى ودعَا اللهَ استَجَابَ لَهُ","explicit":true,"apply":{"k":"time","t":"عند الاستيقاظ"},"otherNeedIds":[11],"ref":"نتائج الأفكار 3/106","srcLabel":"الطبراني","text":[["ما منْ عبدٍ مسلمٍ يتَعَارُّ من الليلِ فيقولَ سبحانَ اللهِ والحمدُ للهِ ولا إلهَ",1]," ",["إلا اللهُ واللهُ أكبرُ ، اللهمَّ اغْفِرْ لي إلا غُفِرَ لهُ ، فإنْ عَزَمَ فقامَ فتوضَأَ وصلَّى ودعَا اللهَ استَجَابَ لَهُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"غريب، وأصله صحيح","takhrij":"أخرجه الطيالسي (2588)، والطبراني في ((المعجم الأوسط)) (4210)، وابن عدي في ((الكامل في الضعفاء)) (2/299) باختلاف يسير","bab":"آداب الدعاء › استجابة الدعاء","dorar":"96Cn02a8"},{"id":"س-00063","fp":"1425be23e8d1","stateId":316,"easy":"إذا دعوت (في الوقت المرجو) ← يستجيب الله لك","cause":"فلا يبْقَى مسلم يدعو بدعوةٍ","result":"إلا استجابَ اللهُ عز وجل لهُ","explicit":true,"repOf":"س-03142","ref":"السلسلة الصحيحة 1073","text":["تُفْتَحُ أبوابُ السماءِ نصفَ الليلِ ، فيُنادِي مُنادٍ : هل من داعٍ فيُستجابُ له ، هل من سائلٍ فيُعْطى ، هل من مكروبٍ فيُفرّجُ عنه ، ",["فلا يبْقَى مسلم يدعو بدعوةٍ",1]," ",["إلا استجابَ اللهُ عز وجل لهُ",2]," ، إلا زانيةً تسعَى بفرجِها ، أو عشارا"],"grade":"صحيح","narrator":"عثمان بن أبي العاص الثقفي","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني (9/51) (8391)، والشجري في ((ترتيب أماليه)) (989)","bab":"آداب الدعاء › استجابة الدعاء","dorar":"zETPmbDd"},{"id":"س-00070","fp":"200ce932eadf","stateId":316,"easy":"إذا بتّ على طهارة ثم استيقظت فسألت الله شيئاً ← يعطيك","cause":"ما من عبدٍ باتَ على طُهورٍ ثمَّ تعارَّ منَ اللَّيلِ فسألَ اللَّهَ شيئًا من أمرِ الدُّنيا أو من أمرِ الآخرةِ","result":"إلَّا أعطاهُ","explicit":true,"apply":{"k":"time","t":"عند الاستيقاظ"},"similar":["س-01429"],"ref":"صحيح ابن ماجه 3145","srcLabel":"أبو داود","text":[["ما من عبدٍ باتَ على طُهورٍ ثمَّ تعارَّ منَ اللَّيلِ فسألَ اللَّهَ شيئًا من أمرِ الدُّنيا أو من أمرِ الآخرةِ",1]," ",["إلَّا أعطاهُ",2]],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (3881) بلفظه، وأبو داود (5042)، وأحمد (22048) كلاهما باختلاف يسير.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"AvPq892V"},{"id":"س-00106","fp":"a9b9fc21e87c","stateId":316,"easy":"إذا قمت في ثلث الليل الآخر ← فهي ساعة مشهودة والدعاء فيها مستجاب","cause":"تَقومَ في ثُلُثِ اللَّيلِ الآخِرِ","result":"فإنَّها ساعةٌ مَشهودةٌ، والدُّعاءُ فيها مُستَجابٌ","explicit":true,"repOf":"س-03142","ref":"المستدرك على الصحيحين 1207","text":["أنَّه بيْنَا هو جالِسٌ عِندَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ إذ جاءَه عَلِيُّ بنُ أبي طالِبٍ فقالَ: بأبي أنت وأُمِّي يا رَسولَ اللهِ، تَفَلَّت هذا القُرآنُ من صَدري، فما أجِدُني أقدِرُ عليه، فقالَ له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: أبا الحَسَنِ، أفلا أُعَلِّمُكَ كَلِماتٍ يَنفَعُكَ اللهُ بِهِنَّ، ويَنفَعُ بِهِنَّ مَن عَلَّمْتَه، ويُثبِّتُ ما تَعَلَّمْتَ في صَدرِكَ؟ قالَ: أجَلْ يا رَسولَ اللهِ، فعَلِّمْني، قالَ: إذا كانتْ لَيلةُ الجُمُعةِ، فإنِ استَطَعتَ أن ",["تَقومَ في ثُلُثِ اللَّيلِ الآخِرِ",1],"، ",["فإنَّها ساعةٌ مَشهودةٌ، والدُّعاءُ فيها مُستَجابٌ",2],"، وهي قَولُ أخي يَعقوبَ لبَنيهِ: {سَوْفَ أَسْتَغْفِرُ لَكُمْ رَبِّي} [يوسف: 98] حتَّى تَأتِيَ لَيلةُ الجُمُعةِ، فإنْ لم تَستَطِعْ فقُمْ في وَسَطِها، فإنْ لم تَستَطِعْ فقُمْ في أوَّلِها، فصَلِّ أربَعَ رَكَعاتٍ، تَقرَأُ في الرَّكعةِ الأُولى بفاتِحةِ الكِتابِ، وسُورةِ {يس}، وفي الرَّكعةِ الثَّانِيةِ بفاتِحةِ الكِتابِ و{الم (1) تَنْزِيلُ} السَّجدةَ، وفي الرَّكعةِ الثَّالِثةِ بفاتِحةِ الكِتابِ، و{حم} الدُّخَانَ، وفي الرَّكعةِ الرَّابِعةِ بفاتِحةِ الكِتابِ، و{تَبَارَكَ} المُفَصَّلَ، فإذا فَرَغْتَ منَ التَّشَهُّدِ فاحمَدِ اللهَ، وأحسِنِ الثَّناءَ على اللهِ، وصَلِّ عَلَيَّ، وعلى سائرِ النَّبِيِّين وأحسِنْ، واستَغفِرْ لإخوانِكَ الَّذين سَبَقوكَ بالإيمانِ، ثم استَغفِرْ للمُؤمِنين وللمُؤمِناتِ، ثمَّ قُلْ آخِرَ ذلكَ: اللَّهُمَّ ارحَمني بتَركِ المَعاصي أبَدًا ما أبقَيتَني، وارحَمني أن أتكَلَّفَ ما لا يَعنيني، وارزُقني حُسْنَ النَّظَرِ فيما يُرضيكَ عَنِّي، اللَّهُمَّ بَديعَ السَّمواتِ والأرضِ ذا الجَلالِ والإكرامِ والعِزَّةِ الَّتي لا تُرامُ، أسألُكَ يا أَللهُ يا رَحمَنُ بجَلالِكَ، ونورِ وَجهِكَ أن تُلزِمَ قَلبي حِفظَ كِتابِكَ كما عَلَّمتَني، وارزُقني أن أتلُوَه على النَّحوِ الَّذي يُرضيكَ عَنِّي، اللَّهُمَّ بَديعَ السَّمواتِ والأرضِ ذا الجَلالِ والإكرامِ والعِزَّةِ الَّتي لا تُرامُ، أسألُكَ يا أَللهُ يا رَحمَنُ بجَلالِكَ ونورِ وَجهِكَ، أن تُنَوِّرَ بكِتابِكَ بَصَري، وأن تُطلِقَ به لِساني، وأن تُفَرِّجَ به عنْ قَلبي، وأن تَشرَحَ به صَدري، وأن تَشغَلَ به بَدَني، فإنَّه لا يُعينُني على الحَقِّ غَيرُكَ، ولا يُؤتِنِيه إلَّا أنت، ولا حَولَ ولا قُوَّةَ إلَّا باللهِ العَلِيِّ العَظيمِ. أبا الحَسَنِ، تَفعَلُ ذلكَ ثَلاثَ جُمَعٍ، أو خَمسًا، أو سَبعًا، تُجابُ بإذنِ اللهِ؛ فوالَّذي بَعَثَني بالحَقِّ ما أخطَأَ مُؤمِنًا قَطُّ. قالَ عَبدُ اللهِ بنُ عَبَّاسٍ: فواللهِ ما لَبِثَ عَلِيٌّ إلَّا خَمسًا، أو سَبعًا حتَّى جاءَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ في مِثلِ ذلكَ المَجلِسِ فقالَ: يا رَسولَ اللهِ، إنِّي كُنتُ فيما خَلَا لا أتَعَلَّمُ أربَعَ آياتٍ أو نَحوَهُنَّ، فإذا قَرَأتُهُنَّ يَتفَلَّتْنَ، فأمَّا اليَومَ فأتَعَلَّمُ الأربَعين آيةً ونَحوَها، فإذا قَرَأتُهُنَّ على نَفسِي، فكَأنَّما كِتابُ اللهِ نُصبَ عَينِي، ولقد كُنتُ أسمَعُ الحَديثَ فإذا أرَدتُه تَفَلَّتَ، وأنا اليَومَ أسمَعُ الأحاديثَ فإذا حَدَّثتُ بها لم أخرِم منها حَرفًا؛ فقالَ له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ عند ذلكَ: مُؤمِنٌ -ورَبِّ الكَعبةِ- أبا الحَسَنِ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه الترمذي (3570)، والبيهقي في ((الأسماء والصفات)) (673) باختلاف يسير","bab":"آداب الدعاء › الثناء على الله في الدعاء","dorar":"5Onx3CzK"},{"id":"س-01126","fp":"90489014d080","stateId":316,"easy":"إذا أويت إلى فراشك طاهراً ذاكراً حتى تنام ← لا تسأل الله خيراً في ليلتك إلا أعطاك","cause":"من أَوى إلى فراشِهِ طاهرًا ، وذكرَ اللهَ تعالى حتى يُدركَهُ النعاسُ","result":"لم ينقلبْ ساعةً منَ الليلِ يسألُ اللهَ تعالى فيها خيرًا من خيرِ الدُّنيا والآخرةِ إلا أعطاهُ إيَّاهُ","explicit":true,"apply":{"k":"time","t":"عند النوم"},"ref":"الوابل الصيب 135","srcLabel":"الترمذي","text":[["من أَوى إلى فراشِهِ طاهرًا ، وذكرَ اللهَ تعالى حتى يُدركَهُ النعاسُ ، ",1],["لم ينقلبْ ساعةً منَ الليلِ يسألُ اللهَ تعالى فيها خيرًا من خيرِ الدُّنيا والآخرةِ إلا أعطاهُ إيَّاهُ",2]],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"حسن","takhrij":"أخرجه ابن السني في ((عمل اليوم والليلة)) (719) واللفظ له، وأخرجه الترمذي (3526)، والطبراني (8/146) (7564) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"kWVliXUX"},{"id":"س-01429","fp":"14b7a62e2a29","stateId":316,"easy":"إذا بتّ على طهارة ثم استيقظت فذكرت الله وسألته خيراً ← يعطيك إياه","cause":"ما من مسلمٍ يبيتُ على طُهْرٍ ثم يتعارَّ من الليلِ فيذكرُ اللهَ ويسألُ اللهَ خيرًا من خيرِ الدنيا والآخرةِ","result":"إلا آتاه اللهُ إياه","explicit":true,"apply":{"k":"time","t":"عند الاستيقاظ"},"repOf":"س-00070","ref":"مجمع الزوائد 1/228","text":["إذا توضأ المسلمُ ذهب الإثمُ من سمعِه وبصرِه ويدَيه ورجليه قال فجاء أبو طيبةَ وهو يحدِّثُنا هذا فقال ما يحدثُكم فذكرنا له الذي حدثنا فقال رجلٌ سمعت عمرَو بنَ عبسةَ يذكرُ عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم وزاد فيه قال قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["ما من مسلمٍ يبيتُ على طُهْرٍ ثم يتعارَّ من الليلِ فيذكرُ اللهَ ويسألُ اللهَ خيرًا من خيرِ الدنيا والآخرةِ",1]," ",["إلا آتاه اللهُ إياه",2]],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (17062)","bab":"وضوء › فضل الوضوء","dorar":"CoEvxFS0"},{"id":"س-01450","fp":"599f2ca15b83","stateId":316,"easy":"إذا دعوت في جوف الليل الآخر ← فهو أسمع الليل","cause":"جَوْفُ اللَّيْلِ الآخِرِ","result":"أَيُّ اللَّيْلِ أَسْمَعُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"في الليل"},"similar":["س-00030","س-06407"],"ref":"المستدرك على الصحيحين 594","srcLabel":"أحمد","text":["أَتَيْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ في أَوَّلِ ما بُعِثَ وهو بِمكَّةَ، وهو حينَئذٍ مُسْتَخْفٍ، فقلتُ: ما أنتَ؟ قالَ: «أنا نَبيٌّ». قُلتُ: وما نَبيٌّ؟ قالَ: «رسولُ اللَّهِ». قلتُ: آللهُ أَرْسَلَكَ؟ قالَ: «نعم». قُلتُ: بما أَرْسَلَكَ؟ قالَ: «أنْ تَعْبُدَ اللَّهَ، وتَكْسِرَ الأَوْثانَ والأَدْيانَ، وتوصِلَ الأَرْحامَ». قُلْتُ: نِعْمَ ما أَرْسَلَكَ به. قُلْتُ: فَمَنْ يَتَّبِعُكَ على هذا؟ قالَ: «عَبْدٌ وحُرٌّ» -يعني أَبا بَكْرٍ وبِلالًا- فكان عَمرٌو يقولُ: لقد رَأَيْتُني وأَنا رُبْعُ –أَوْ: رابِعُ- الإسْلامِ، قالَ: فَأَسْلَمْتُ. قُلْتُ: أَتْبَعُكَ يا رسولَ اللهِ، قالَ: «لا، ولَكِنِ الْحَقْ بِقَوْمِكَ، فإذا أُخْبِرْتَ أَنِّي قدْ خَرَجْتُ فاتَّبِعْني». قالَ: فَلَحِقْتُ بِقَوْمي، وَجَعَلْتُ أَتَوَقَّع خَبَرَهُ وخُروجَهُ حتَّى أَقَبَلَتْ رُفْقَةٌ مِنْ يَثْرِبَ فَلَقيتُهُمْ، فَسَأَلْتُهُمْ عَنِ الخَبَرِ، فقالوا: قد خَرَجَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ مِنْ مَكَّةَ إلى المَدينَةِ، قلتُ: وقد أَتاها؟ قالوا: نَعَمْ، قالَ: فارْتَحَلْتُ حتَّى أَتَيْتُهُ. قُلتُ: أَتَعْرِفُني يا رسولَ اللَّهِ؟ قالَ: «نَعَمْ، أنتَ الرَّجُلُ الَّذي أَتاني بِمكَّةَ». فَجَعَلْتُ أَتَحَيَّنُ خَلْوَتَهُ، فلَمَّا خَلا قُلْتُ: يا رسولَ اللهِ، عَلِّمْني مِمَّا عَلَّمَكَ اللهُ وَأَجْهَلُ، قالَ: «فَسَلْ عَمَّ شِئْتَ»، قُلْتُ: ",["أَيُّ اللَّيْلِ أَسْمَعُ",2],"؟ قالَ: «",["جَوْفُ اللَّيْلِ الآخِرِ",1]," فَصَلِّ ما شِئْتَ؛ فإنَّ الصَّلاةَ مَشْهودَةٌ، مَكْتوبةٌ حتَّى تُصَلِّيَ الصُّبْحَ، ثُمَّ أَقْصِرْ حتَّى تَطْلُعَ الشَّمْسُ فَتَرْتَفِعُ قِيدَ رُمْحٍ أَوْ رُمْحَيْنِ؛ فإنَّها تَطْلُعُ بينَ قَرْنَيْ شَيْطانٍ، وتُصَلِّي لها الكُفَّارُ، ثُمَّ صَلِّ ما شِئْتَ، فإنَّ الصَّلاةَ مَشْهودَةٌ مَكْتوبَةٌ حتَّى يَعْدِلَ الرُّمْحُ ظِلَّهُ، ثُمَّ أَقْصِرْ؛ فإنَّ جَهَنَّمَ تُسْجَرُ وتُفْتَحُ أَبْوابُها، فإذا زالَتِ الشَّمْسُ فَصَلِّ ما شِئْتَ، فإنَّ الصَّلاةَ مَشْهودَةٌ مَكْتوبَةٌ، ثُمَّ صَلِّ حتَّى تُصَلِّي العَصْرَ ثُمَّ أَقْصِرْ حتَّى تَغْربَ الشَّمْسُ؛ فإنَّها تَغْرُبُ بينَ قَرْنَيْ شَيْطانٍ، وتُصَلِّي لها الكُفَّارُ، وإذا تَوَضَّأْتَ فاغْسِلْ يَدَيْكَ؛ فإنَّكَ إذا غَسَلْتَ يَدَيْكَ خَرَجَتْ خَطاياكَ مِنْ أَظْفارِ أَنامِلِكَ، ثُمَّ إذا غَسَلْتَ وَجْهَكَ خَرَجَتْ خَطاياكَ مِنْ وَجْهِكَ، ثُمَّ إذا مَضْمَضْتَ واسْتَنْثَرْتَ خَرَجَتْ خَطاياكَ مِنْ مَناخِرِكَ، ثُمَّ إذا غَسَلْتَ يَدَيْكَ خَرَجَتْ خَطاياكَ مِنْ ذِراعَيْكَ، ثُمَّ إذا مَسَحْتَ بِرَأْسِكَ خَرَجَتْ خَطاياكَ مِنْ أَطْرافِ شَعْرِكَ، ثُمَّ إذا غَسَلْتَ رِجْلَيْكَ خَرَجَتْ خَطاياكَ مِنْ رِجْلَيْكَ، فإنْ ثَبَتَّ في مَجْلِسِكَ كان لكَ حَظُّكَ مِنْ وُضوئِكَ، وإنْ قُمْتَ فَذَكَرْتَ رَبَّكَ، وحَمِدْتَه، ورَكَعتَهُ ركْعَتَيْنِ مُقْبِلًا عليهما بِقَلْبِكَ كُنْتَ مِنْ خَطاياكَ كَيَوْمِ وَلَدَتْكَ أُمُّكَ»."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (17026)، وابن أبي شيبة في ((مسنده)) (755)، والطبراني في ((مسند الشاميين)) (1847) جميعا بطوله.","bab":"وضوء › فضل الوضوء","dorar":"C94n0qYy","merged":3,"otherRefs":["مجمع الزوائد 10/158 (صحيح)","تخريج المسند لشعيب 18059 (صحيح)"]},{"id":"س-00030","fp":"20c6075e6800","stateId":316,"easy":"إذا دعوت في جوف الليل الآخر ودبر الصلوات المكتوبة ← فهو أسمع الدعاء","cause":"شَطْرُ اللَّيْلِ الآخِرُ، وأدبارَ المكتوباتِ","result":"أيُّ الدُّعاءِ أسمَعُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"في الليل"},"repOf":"س-01450","ref":"الأحكام الوسطى 1/416","text":["سأل النَّبيَّ صلَّى اللهُ عليه وسلَّمَ: ",["أيُّ الدُّعاءِ أسمَعُ",2],"؟ قال: \"",["شَطْرُ اللَّيْلِ الآخِرُ، وأدبارَ المكتوباتِ",1],". . .\" وذكَرَ الحَديثَ"],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه الترمذي (3499)، والنسائي في ((السنن الكبرى)) (9856)، والبيهقي في ((الدعوات الكبير)) (670) واللفظ لهم.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"aqaRNmwz"},{"id":"س-06407","fp":"4ea40837e5d2","stateId":316,"easy":"إذا دعوت في جوف الليل الأخير ودبر المكتوبات ← فهو أسمع الدعاء","cause":"جَوفَ اللَّيلِ الأخيرِ ، ودُبرَ الصَّلواتِ المكتوباتِ","result":"أيُّ الدعاءِ أسمعُ قال","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"في الليل"},"repOf":"س-01450","ref":"صحيح الترغيب 1648","text":["قيلَ يا رسولَ اللهِ ",["أيُّ الدعاءِ أسمعُ قال ",2],": ",["جَوفَ اللَّيلِ الأخيرِ ، ودُبرَ الصَّلواتِ المكتوباتِ .",1]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (3499)، والنسائي في ((السنن الكبرى)) (9936) باختلاف يسير.","bab":"صلاة › أدعية دبر الصلوات","dorar":"Pe2jmliM"},{"id":"س-03142","fp":"cf6a8c72d04f","stateId":316,"easy":"إذا سألت أو استغفرت أو دعوت في شطر الليل الآخر ← يعطيك الله ويغفر لك ويستجيب لك","cause":"إذا مضى شَطرُ اللَّيلِ أو ثُلثاه ينزِلُ اللهُ تبارَك وتعالى إلى السَّماءِ الدُّنيا فيقولُ: لا أسأَلُ عن عبادي غيري مَن ذا الَّذي يسأَلُني","result":"فأُعطيَه مَن ذا الَّذي يستغفرني فأغفِرَ له مَن ذا الَّذي يدعوني فأستجيب له حتَّى ينفجرَ الصُّبحُ","explicit":true,"star":true,"similar":["س-00022","س-00023","س-00002","س-00063","س-00106","س-03104","س-02771","س-00033"],"ref":"تخريج صحيح ابن حبان 212","srcLabel":"البخاري","text":["صدَرْنا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّم مِن مكَّةَ فجعَل ناسٌ يستأذِنون رسولَ اللهِ صلَّى اللهُ عليه وسلَّم فجعَل يأذَنُ لهم فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( ما بالُ شِقِّ الشَّجرةِ الَّتي تلي رسولَ اللهِ أبغضَ إليكم مِن الشِّقِّ الآخَرِ ؟ ) قال: فلم نرَ مِن القومِ إلَّا باكيًا قال يقولُ أبو بكرٍ: إنَّ الَّذي يستأذِنُك بعدَ هذا لسفيهٌ - في نفسي - فقام رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فحمِد اللهَ وأثنى عليه - وكان إذا حلف قال: والَّذي نفسي بيدِه: ( أشهَدُ عند اللهِ ما منكم مِن أحدٍ يؤمنُ باللهِ ثمَّ يُسدِّدُ إلَّا سُلِك به في الجنَّةِ ولقد وعَدني ربِّي أنْ يُدخِلَ مِن أمَّتي الجنَّةَ سبعينَ ألفًا بغيرِ حسابٍ ولا عذابٍ وإنِّي لأرجو ألَّا يدخُلوها حتَّى تتبوَّؤوا أنتم ومَن صلَح مِن أزواجِكم وذَرارِيُّكم مساكنَ في الجنَّةِ ) ثمَّ قال: ( ",["إذا مضى شَطرُ اللَّيلِ أو ثُلثاه ينزِلُ اللهُ تبارَك وتعالى إلى السَّماءِ الدُّنيا فيقولُ: لا أسأَلُ عن عبادي غيري مَن ذا الَّذي يسأَلُني ",1],["فأُعطيَه مَن ذا الَّذي يستغفرني فأغفِرَ له مَن ذا الَّذي يدعوني فأستجيب له حتَّى ينفجرَ الصُّبحُ )",2]],"grade":"صحيح","narrator":"رفاعة بن عرابة الجهني","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه ابن حبان (212)، وابن خزيمة (37) واللفظ لهما، وأحمد (212) بنحوه، والطبراني في ((المعجم الكبير)) (5/ 50) (4557)، والبيهقي في ((شعب الإيمان)) (400) مختصرا.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"JHx8x5ww"},{"id":"س-03104","fp":"64e60f2248dc","stateId":316,"easy":"إذا دعوت الله في وقت النزول ← يستجيب لك","cause":"من يدعوني","result":"فأستجيبَ له","explicit":true,"repOf":"س-03142","ref":"فتاوى نور على الدرب لابن باز 10/417","text":["ينزلُ ربُّنا تبارك وتعالى كلَّ ليلةٍ إلى السماءِ الدنيا حين يبقى ثلثُ الليلِ الآخرُ فيقولُ: ",["من يدعوني ",1],["فأستجيبَ له ",2],"من يسألني فأعطيَه من يستغفِرُني فأغفرَ له وفي اللفظِ الآخرِ يقولُ جل وعلا: هل من تائبٍ فيتابَ عليه هل من سائلٍ فيعطى سؤلَه هل من مستغفرٍ فيغفرَ له؟ حتى ينفجرَ الفجرُ."],"grade":"صحيح","muhaddith":"متواتر","bab":"إيمان › توحيد الأسماء والصفات","dorar":"xojV1WDj","merged":4,"otherRefs":["تخريج المسند لشعيب 7592 (صحيح)","صحيح مسلم 758 (صحيح)","أحكام القرآن لابن العربي 4/326 (صحيح)"]},{"id":"س-02771","fp":"4c56f002a707","stateId":316,"easy":"إذا دعوت في وقت النزول ← يجيبك الله","cause":"هَل من داعٍ","result":"فأُجيبُهُ","explicit":true,"repOf":"س-03142","ref":"شرح البخاري لابن الملقن 22/551","text":["ثلاثُ ساعاتٍ يبقَينَ منَ اللَّيلِ يفتحُ اللَّهُ عزَّ وجلَّ الذِّكرَ الَّذي لم يرَه أحدٌ غيرُه فيمحُو ما شاء ويُثبتُ ثمَّ في السَّاعةِ الثَّانيةِ ينزلُ إلى عَدْنٍ فيقولُ طوبى لمن دخلَكِ ثمَّ ينزلُ في السَّاعةِ الثَّالثةِ إلى السَّماءِ الدُّنيا بملائكةٍ فيقولُ هل من مستغفِرٍ فأغفرَ لَه ",["هَل من داعٍ",1]," ",["فأُجيبُهُ",2]," حتَّى يصلَّى الفجرُ وذلِكَ قولُه { وَقُرْآنَ الْفَجْرِ إِنَّ قُرْآنَ الْفَجْرِ كَانَ مَشْهُودًا} يقول يشهدُهُ اللَّهُ وملائكتُهُ وملائكةُ الليلِ وملائِكةُ النَّهارِ."],"grade":"صحيح","muhaddith":"روى الحاكم نحوه على شرط الشيخين عن أبي هريرة رضي الله عنه وأبي سعيد مرفوعاً","bab":"إيمان › الملائكة","dorar":"dUCLAyKW"},{"id":"س-00033","fp":"8344d42a4e1f","stateId":316,"easy":"إذا دعوت في ثلث الليل الآخر ← يستجيب الله لك","cause":"إذا كانَ ثلُثُ اللَّيلِ الباقي","result":"يَهْبِطُ اللَّهُ - عزَّ وجلَّ - إلى السَّماءِ الدُّنيا ، ثمَّ تُفتَحُ أبوابُ السَّماءِ ، ثمَّ يبسُطُ يدَهُ فيقولُ : هل مِن سائلٍ يُعطَى سؤلَهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-03142","ref":"الصحيح المسند 843","text":[["إذا كانَ ثلُثُ اللَّيلِ الباقي",1]," ",["يَهْبِطُ اللَّهُ - عزَّ وجلَّ - إلى السَّماءِ الدُّنيا ، ثمَّ تُفتَحُ أبوابُ السَّماءِ ، ثمَّ يبسُطُ يدَهُ فيقولُ : هل مِن سائلٍ يُعطَى سؤلَهُ",2]," ؟ فلا يَزالُ كذلِكَ حتَّى يَطلُعَ الفَجرُ ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح ، رجاله رجال الصحيح","takhrij":"أخرجه أحمد (3673)، وابن خزيمة في ((التوحيد)) (1/136)، وأبو يعلى (5319) باختلاف يسير","bab":"آداب الدعاء › استجابة الدعاء","dorar":"yXGZQsbi"},{"id":"س-00015","fp":"8a92e9448150","stateId":317,"easy":"إذا وافقت ساعة الجمعة تسأل الله شيئاً ← يعطيك إياه","cause":"إنَّ في الجمعةِ ساعةً وأشارَ بِكَفِّهِ كأنَّهُ يقلِّلُها","result":"لا يُوافقُها عبدٌ مُسلِمٌ يسألُ اللَّهَ شيئًا ، إلَّا أعطاهُ إيَّاهُ","explicit":true,"star":true,"similar":["س-00092","س-00093","س-00099","س-07630","س-07432","س-07628","س-00089","س-00003","س-00040"],"ref":"تخريج المسند لشاكر 14/187","srcLabel":"متفق عليه","text":[["إنَّ في الجمعةِ ساعةً وأشارَ بِكَفِّهِ كأنَّهُ يقلِّلُها",1]," ",["لا يُوافقُها عبدٌ مُسلِمٌ يسألُ اللَّهَ شيئًا ، إلَّا أعطاهُ إيَّاهُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (7769) بلفظه، والبخاري (935)، ومسلم (852)، وأبو داود (1046) في أثناء حديث، وجميعا بلفظ مقارب.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"YTgG2xjo"},{"id":"س-00092","fp":"616bc444e453","stateId":317,"easy":"إذا دعوت في ساعة الجمعة ← يستجيب الله لك","cause":"إنَّ في الجُمُعةِ لساعةً، ما دعا اللهَ فيها عَبدٌ مؤمنٌ بشيءٍ","result":"إلَّا استجابَ اللهُ له","explicit":true,"repOf":"س-00015","ref":"تخريج المسند لشعيب 9206","text":[["إنَّ في الجُمُعةِ لساعةً، ما دعا اللهَ فيها عَبدٌ مؤمنٌ بشيءٍ",1],"؛ ",["إلَّا استجابَ اللهُ له",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5294)، ومسلم (852) باختلاف يسير","bab":"آداب الدعاء › استجابة الدعاء","dorar":"WQDJqJLc"},{"id":"س-00093","fp":"72ca9c2628ae","stateId":317,"easy":"إذا وافقت ساعة الجمعة تدعو بخير ← يستجيب الله لك","cause":"إنَّ في الجُمُعةِ لساعةً، لا يوافِقُها رَجُلٌ يَدعو فيها بخَيرٍ","result":"إلَّا استَجابَ اللهُ له","explicit":true,"repOf":"س-00015","ref":"تخريج المسند لشعيب 10234","text":[["إنَّ في الجُمُعةِ لساعةً، لا يوافِقُها رَجُلٌ يَدعو فيها بخَيرٍ",1],"؛ ",["إلَّا استَجابَ اللهُ له",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (5294)، ومسلم (852) باختلاف يسير","bab":"آداب الدعاء › استجابة الدعاء","dorar":"xUJhpigo"},{"id":"س-00099","fp":"3a037c179ab4","stateId":317,"easy":"إذا وافقت ساعة الجمعة وأنت في الصلاة تسأل ← يعطيك ما سألت","cause":"في يَوْمِ الجُمُعةِ ساعةً لا يُوافِقُها عَبْدٌ مُسلِمٌ وهو في الصَّلاةِ فيَسأَلُ اللهَ عَزَّ وجَلَّ شَيئًا","result":"إلَّا أَعْطاه ما سَأَلَه","explicit":true,"repOf":"س-00015","ref":"الأحاديث المختارة 9 / 444","text":["«قُلْتُ ورَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ جالِسٌ: إنَّا نَجِدُ في كِتابِ اللهِ ",["في يَوْمِ الجُمُعةِ ساعةً لا يُوافِقُها عَبْدٌ مُسلِمٌ وهو في الصَّلاةِ فيَسأَلُ اللهَ عَزَّ وجَلَّ شَيئًا",1]," ",["إلَّا أَعْطاه ما سَأَلَه",2],"، فأَشارَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: بعضُ ساعةٍ قالَ: فقُلْتُ: صَدَقَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، قالَ أبو النَّضْرِ: قالَ أبو سَلَمةَ: سَألْتُه أيَّةُ ساعةٍ هي؟ قالَ: آخِرُ ساعاتِ النَّهارِ، فقُلْتُ: إنَّها ليست ساعةَ صَلاةٍ، فقالَ: بَلى، إنَّ العَبْدَ المُسلِمَ في صَلاةٍ إذا صلَّى ثُمَّ قَعَدَ في مُصَلَّاه لا يَحبِسُه إلَّا انْتِظارُ الصَّلاةِ»."],"grade":"صحيح","narrator":"عبدالله بن سلام","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"آداب الدعاء › استجابة الدعاء","dorar":"kxaFk5PB"},{"id":"س-00095","fp":"7db6c9fbd541","stateId":317,"easy":"إذا دعوت ما بين جلوس الإمام على المنبر إلى انقضاء الصلاة ← فهي ساعة الإجابة","cause":"ما بَينَ أنْ يجلِسَ الإمامُ على المِنْبَرِ إلى أنْ تُقْضَى الصَّلاةُ","result":"ساعةَ الإجابةِ","explicit":true,"ref":"الأربعين المغنية 501","srcLabel":"مسلم","text":["حديثُ: أنَّها ",["ما بَينَ أنْ يجلِسَ الإمامُ على المِنْبَرِ إلى أنْ تُقْضَى الصَّلاةُ",1],". يَعْني: ",["ساعةَ الإجابةِ",2]," الكائنةَ في يومِ الجُمُعةِ. [يعني حديث: قالَ لي عبدُ اللهِ بنُ عُمَرَ: أَسَمِعْتَ أَبَاكَ يُحَدِّثُ عن رَسولِ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ في شَأْنِ سَاعَةِ الجُمُعَةِ؟ قالَ: قُلتُ: نَعَمْ، سَمِعْتُهُ يقولُ: سَمِعْتُ رَسولَ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ يقولُ: هي ما بيْنَ أَنْ يَجْلِسَ الإمَامُ إلى أَنْ تُقْضَى الصَّلَاةُ.]"],"grade":"صحيح","narrator":"[أبو موسى الأشعري]","muhaddith":"صحيح","takhrij":"أخرجه مسلم (853)، وأبو داود (1049)، وابن خزيمة (1739) واللفظ لهم.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"KPDJf9VF","merged":2,"otherRefs":["مجموع فتاوى ابن باز 125/6 (صحيح)"]},{"id":"س-07630","fp":"a715ca339b22","stateId":317,"easy":"إذا وافقت ساعة الجمعة تسأل الله خيراً ← يعطيك إياه","cause":"فيه ساعةٌ لا يوافقُها عبدٌ مسلمٌ أو أمةٌ مسلمةٌ يسألُ اللهَ فيه خيرًا","result":"إلَّا أعطاهُ إياهُ","explicit":true,"repOf":"س-00015","ref":"سفر السعادة 97","text":["أتاني جبريلُ وفي كفِّه مرآةٌ كأحسنِ المرايا وأضوئِها وإذا في وسطِها لمعةٌ سوداءُ فقلتُ : ما هذه اللمعةُ التي أرَى فيها ؟ قال : هذه الجمعةُ ، قلتُ : وما الجمعَة ؟ قال : يومٌ من أيامِ ربكَ عظيمٌ وسأخبركَ بشرفِه وفضلِه على الدنيا وما يرجَى فيه لأهلِه وباسمِه في الآخرةِ ، فأما شرفهُ وفضلهُ في الدنيا فإنَّ اللهَ جمعَ فيه أمرَ الخلقِ ، وأما ما يرجَى فيه لأهلهِ فإنَّ ",["فيه ساعةٌ لا يوافقُها عبدٌ مسلمٌ أو أمةٌ مسلمةٌ يسألُ اللهَ فيه خيرًا",1]," ",["إلَّا أعطاهُ إياهُ",2]," وأما شرفُه وفضلُه في الآخرةِ واسمُه فإنَّ اللهَ تبارك وتعالى إذا صيَّر أهلَ الجنةِ إلى الجنةِ وأهلَ النارِ إلى النارِ جرتْ عليهم هذه الأيامُ وهذه الليالي ليس فيها ليلٌ ولا نهارٌ ، فأعلمَ اللهُ عزَّ وجلَّ مقدارَ ذلك وساعاتِه ، فإذا كان يومُ الجمعةِ حين يخرجُ أهلُ الجمعةِ إلى جمعتهِم نادَى أهلَ الجنةِ منادٍ : يا أهلَ الجنةِ اخرجوا إلى وادي المزيدِ ، ووادي المزيدُ لا يعلمُ سعتَه وطولَه وعرضَهُ إلا اللهُ ، فيه كُثبانُ المسكِ رءوسُها في السماءِ ، قال : فيخرجُ غلمانُ الأنبياءِ بمنابرَ من نورٍ ويخرجُ غلمانُ المؤمنين بكراسيِّ من ياقوتٍ فإذا وضعتْ لهم وأخذ القومُ مجالسَهم بعث اللهُ تعالى عليهم ريحًا تدعَى المُثيرةَ تنشرُ ذلك المسكَ وتدخلُه من تحتِ ثيابِهم وتخرجُه في وجوهِهم وأشعارِهم وتلك الرياح أعلمُ كيف يصنعُ بذلك المسكِ من امرأةِ أحدِكم لو رُفِع إليها كلُّ طيبٍ على وجهِ الأرضِ . قال : ثمَّ يوحي اللهُ تبارك وتعالى إلى حمَلةِ عرشهِ ضعوهُ بين أظهرِهم ، فيكونُ أقلُّ ما يسمعونَ منه أن يا عبادي الذين أطاعوني بالغيبِ ولم يرَوْني وصدَّقوا برسُلي واتبعوا أمري سلوا فهذا يومُ المزيدِ ، فيجتمعونَ على كلمةٍ واحدةٍ : رضينا عنكَ فارضَ عنَّا ، فيرجعُ اللهُ إليهم : أنْ يا أهلَ الجنةِ إني لو لم أرضَ عنكم لم أسُكنْكم داري ، فسلوني فهذا يومُ المزيدِ ، فيجتمعون على كلمةٍ واحدةٍ : ربَّنا أرِنا وجهكَ ننظرْ إليكَ ، فيكشفُ عن تلك الحجُبِ ويتجلَّى لهم عزَّ وجلَّ فيغشاهُم من نورِه شيءٌ لولا أنه قضَى أنْ لا يحترقوا لاحترَقوا لما يغشاهُم من نورِه ، ثمَّ يقالُ لهم : ارجعوا إلى منازلِكم فيرجعونَ إلى منازلِهم وقد أعطِيَ كلُّ واحدٍ منهم الضعفَ على ما كانوا فيه فيرجعونَ إلى أزواجِهم وقد خفُوا عليهنَّ وخفِينَ عليهم بما غشيَهم من نورِه ، فإذا رجعوا ترادَّ النورُ حتَّى يرجعوا إلى صوَرِهم التي كانوا عليها ، فتقولُ لهم أزواجُهم : لقد خرجتُم من عندنا على صورةٍ ورجعتم على غيرِها ، فيقولونَ : ذلك أنَّ اللهَ عزَّ وجلَّ تجلَّى لنا فنظرْنا منه ، قال : إنه واللهِ ما أحاطَه خلقٌ ولكنه قد أراهُم اللهُ عزَّ وجلَّ من عظمتِه وجلالهِ ما شاء أنْ يريَهم ، قال : فذلك قوله فنظرْنا منه ، قال : فهم يتقلَّبونَ في مسكِ الجنةِ ونعيمِها في كلِّ سبعةِ أيامٍ الضعفَ على ما كانوا فيه . قال رسولُ اللهِ صلَّى اللهُ عليه وآلهِ وسلَّم : فذلك قولهُ تعالى { فَلَا تَعْلَمُ نَفْسٌ مَا أُخْفِيَ لَهُمْ مِنْ قُرَّةِ أَعْيُنٍ جَزَاءً بِمَا كَانُوا يَعْمَلُونَ }"],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"إسناده ثابت","takhrij":"أخرجه البزار (2881)","bab":"فضائل النبي وصفته ودلائل النبوة › نزول الوحي عليه صلى الله عليه وسلم","dorar":"NZYLXKNg","merged":16,"otherRefs":["صحيح الترمذي 491 (صحيح)","تخريج المسند لشعيب 10465 (صحيح)","صحيح البخاري 6400 (صحيح)","صحيح مسلم 852 (صحيح)","تخريج المسند لشعيب 7151 (صحيح)","تخريج المسند لشعيب 7472 (صحيح)","تخريج شرح السنة 1046 (صحيح)","صحيح ابن خزيمة 3/ 219 (صحيح)","صحيح ابن خزيمة 3/ 220 (صحيح)","صحيح ابن خزيمة 3/ 221 (صحيح)","صحيح البخاري 5294 (صحيح)","التنوير شرح الجامع الصغير 6/432 (حسن)","تخريج المسند لشاكر 13/234 (صحيح)","تخريج المسند لشعيب 10723 (صحيح)","الأحاديث المختارة 9 / 424 (صحيح)"]},{"id":"س-07432","fp":"b12df536d453","stateId":317,"easy":"إذا وافقت ساعة يوم الجمعة تسأل الله شيئاً ← يعطيك إياه","cause":"وفيه ساعةٌ لا يَسأَلُ اللهَ عبدٌ فيها شيئًا","result":"إلَّا آتاه اللهُ إيَّاه","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-00015","ref":"تخريج المسند لشعيب 22457","text":["أنَّ رَجُلًا مِن الأنصارِ أتى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ فقال: أخبِرْنا عن يومِ الجُمعةِ ماذا فيه مِن الخيرِ؟ قال: فيه خَمسُ خِلالٍ: فيه خُلِقَ آدَمُ، وفيه أُهبِطَ آدَمُ، وفيه تَوَفَّى اللهُ آدَمَ، ",["وفيه ساعةٌ لا يَسأَلُ اللهَ عبدٌ فيها شيئًا",1]," ",["إلَّا آتاه اللهُ إيَّاه",2],"، ما لم يَسأَلْ مَأثمًا أو قَطيعةَ رَحِمٍ، وفيه تَقومُ السَّاعةُ، ما مِن ملَكٍ مُقرَّبٍ، ولا سَماءٍ، ولا أرضٍ، ولا جِبالٍ، ولا حَجَرٍ إلَّا وهو يُشفِقُ مِن يومِ الجُمعةِ."],"grade":"صحيح","narrator":"سعد بن عبادة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (22457) واللفظ له، والشافعي في ((الأم)) (2/434)، والبزار (3738)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"mTHj5Na1","merged":3,"otherRefs":["سنن الترمذي 490 (حسن)","فتح الغفار 616/2 (صحيح)"]},{"id":"س-07628","fp":"14da592edd36","stateId":317,"easy":"إذا وافقت ساعة الجمعة وأنت في صلاة تسأل خيراً ← يعطيك إياه","cause":"لا يُوافِقُها مُسلِمٌ، وهو في صَلاةٍ يَسأَلُ اللهَ خَيرًا","result":"إلَّا آتاهُ إيَّاهُ","explicit":true,"repOf":"س-00015","ref":"تخريج المسند لشعيب 11624","text":["كان أبو هُرَيرةَ يُحدِّثُنا عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم أنَّه قال: إنَّ في الجُمُعةِ ساعةً ",["لا يُوافِقُها مُسلِمٌ، وهو في صَلاةٍ يَسأَلُ اللهَ خَيرًا",1],"، ",["إلَّا آتاهُ إيَّاهُ",2],". \nقال: وقلَّلَها أبو هُرَيرةَ بيَدِه، قال: فلمَّا تُوفِّيَ أبو هُرَيرةَ، قُلتُ: واللهِ لو جِئتُ أبا سَعيدٍ، فسَأَلتُه عن هذه السَّاعةِ؛ أنْ يكونَ عِندَه منها عِلْمٌ، فأَتَيتُه، فأجِدُه يُقوِّمُ عَراجينَ، فقُلتُ: يا أبا سَعيدٍ، ما هذه العَراجينُ التي أراكَ تُقوِّمُ؟ قال: هذه عَراجينُ جعَلَ اللهُ لنا فيها بَرَكةً؛ كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّم يُحِبُّها، ويَتَخصَّرُ بها، فكُنَّا نُقوِّمُها، ونَأتيهِ بها، فرَأى بُصاقًا في قِبْلةِ المَسجِدِ، وفي يَدِه عُرْجونٌ من تلك العَراجينِ فحَكَّه، وقال: إذا كان أحَدُكم في صَلاتِه فلا يَبصُقْ أمامَه؛ فإنَّ رَبَّه أمامَه، ولْيَبصُقْ عن يَسارِه، أو تحتَ قَدَمِه، فإنْ لم -قال سُرَيجٌ: لم- يَجِدْ مَبصَقًا، ففي ثَوبِه أو نَعْلِه، قال: ثُمَّ هاجَتِ السَّماءُ من تلك اللَّيلةِ، فلمَّا خرَجَ النَّبيُّ صلَّى اللهُ عليه وسلَّم لصَلاةِ العِشاءِ الآخِرَةِ، بَرَقَتْ بَرْقةٌ، فرَأى قَتادةَ بنَ النُّعْمانِ، فقال: ما السُّرى يا قَتادةُ؟ قال: عَلِمتُ يا رسولَ اللهِ أنَّ شاهِدَ الصَّلاةِ قَليلٌ، فأحْبَبتُ أنْ أشهَدَها. قال: فإذا صَلَّيتَ فاثْبُتْ حتى أمُرَّ بكَ، فلمَّا انصَرَفَ أعْطاهُ العُرْجونَ، وقال: خُذْ هذا فسَيُضيءُ لك أمامَك عَشْرًا، وخَلْفَك عَشْرًا، فإذا دَخَلتَ البَيتَ، وتَراءَيتَ سَوادًا في زاويةِ البَيتِ، فاضْرِبْه قبْلَ أنْ يَتَكلَّمَ؛ فإنَّه شَيطانٌ، قال: ففعَلَ، فنحن نُحِبُّ هذه العَراجينَ؛ لذلك.\nقال: قُلتُ: يا أبا سَعيدٍ، إنَّ أبا هُرَيرةَ حدَّثَنا عن السَّاعةِ التي في الجُمُعةِ، فهل عِندَك منها عِلْمٌ؟ فقال: سَأَلتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم عنها، فقال: إنِّي كُنتُ قد أُعلِمتُها ثُمَّ أُنسيتُها، كما أُنسيتُ لَيْلةَ القَدْرِ، قال: ثُمَّ خَرَجتُ من عِندِه، فدَخَلتُ على عبدِ اللهِ بنِ سَلَامٍ."],"grade":"صحيح","narrator":"أبو سعيد الخدري وأبو هريرة","muhaddith":"بعضه صحيح، وبعضه حسن","takhrij":"أخرجه أبو داود (480) مختصراً، وأحمد (11624) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › معجزات النبي","dorar":"pZZrAM6R","merged":2,"otherRefs":["صحيح ابن خزيمة 3/ 219 (صحيح)"]},{"id":"س-00013","fp":"6cc4c999b283","stateId":317,"easy":"إذا دعوت يوم الجمعة بعد العصر حتى الغروب ← فهي ساعة الإجابة المرجوة","cause":"بعدَ العصرِ إلى غَيبوبةِ الشَّمسِ","result":"السَّاعةَ الَّتي تُرجَى في يومِ الجمُعةِ","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"similar":["س-00090","س-00051","س-02160","س-02140"],"ref":"هداية الرواة 1308","srcLabel":"الترمذي","text":["قالَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ : التَمِسوا ",["السَّاعةَ الَّتي تُرجَى في يومِ الجمُعةِ",2]," ",["بعدَ العصرِ إلى غَيبوبةِ الشَّمسِ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (489) واللفظ له، والطبراني في ((المعجم الأوسط)) (136)، وابن عدي في ((الكامل في الضعفاء)) (6/196)","bab":"آداب الدعاء › استجابة الدعاء","dorar":"aXqeTUBV"},{"id":"س-00089","fp":"5fb2044a6636","stateId":317,"easy":"إذا وافقت ساعة الجمعة تدعو بخير ← يُستجاب لك","cause":"وفيها ساعةٌ لا يوافقُها مؤمنٌ يدعو اللهَ بخيرٍ","result":"إلا استجيبَ له","explicit":true,"repOf":"س-00015","ref":"سفر السعادة 95","text":["أتَى جبريلُ النبيَّ صلَّى اللهُ عليه وسلم بمرآةٍ بيضاءَ فيها نُكتةٌ ، فقال صلَّى اللهُ عليه وسلم : ما هذه ؟ قال : هي الجمعةُ فضِّلتَ بها أنتَ وأمتكَ ، والناسُ لكم فيها تبعٌ اليهودُ والنصارَى ، ولكم فيها خيرٌ ، ",["وفيها ساعةٌ لا يوافقُها مؤمنٌ يدعو اللهَ بخيرٍ",1]," ",["إلا استجيبَ له",2]," ، وهو عندنا يومُ المزيدِ ، فقال النبيُّ صلَّى اللهُ عليه وسلم : يا جبريلُ وما يومُ المزيدِ ؟ فقال : إنَّ ربكَ اتخذَ في الفردوسِ واديًا أفيحَ فيه كثيبٌ من مسكٍ ، فإذا كان يومُ الجمعةِ أنزل اللهُ سبحانه ما شاء من ملائكتِه وحوله منابرَ من نورٍ عليها مقاعدُ النبيينَ وحفَّ تلك المنابرَ بمنابرَ من ذهبٍ مكلَّلةً بالياقوتِ والزبرجدِ عليها الشهداءُ والصديقونَ فجلسوا من ورائهمْ على ذلك الكثيبِ فيقولُ اللهُ عزَّ وجلَّ : أنا ربُّكم قد صدقتُكم وعدي فسلوني أعطِكُم ، فيقولونَ : نسألكَ رِضوانَكَ فيقولُ : قد رضيتُ عنكم ولكم ما تمنيتم ولديَّ مزيدٌ ، فهم يحبونَ الجمعةَ لمَا يعطيهم فيه ربُّهم من الخيرِ وهو اليومُ الذي استوَى فيه ربكَ تبارك وتعالى على العرش وفيه خلقَ آدمُ وفيه تقومُ الساعةُ"],"grade":"صحيح","muhaddith":"صحيح","bab":"آداب الدعاء › استجابة الدعاء","dorar":"Q5TiIOPd"},{"id":"س-00090","fp":"b333857b5697","stateId":317,"easy":"إذا جلست يوم الجمعة بعد العصر تنتظر المغرب تدعو ← فهي ساعة الإجابة","cause":"من بعدِ العصرِ إلى غروبِ الشمسِ في حقِّ مَن جلس ينتظرُ صلاةَ المغربِ","result":"ساعةَ الإجابةِ يومَ الجمعةِ","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-00013","ref":"مجموع فتاوى ابن باز 125/6","text":["[حديثُ أن ",["ساعةَ الإجابةِ يومَ الجمعةِ",2]," ",["من بعدِ العصرِ إلى غروبِ الشمسِ في حقِّ مَن جلس ينتظرُ صلاةَ المغربِ",1],"]"],"grade":"صحيح","muhaddith":"صحيح","bab":"آداب الدعاء › استجابة الدعاء","dorar":"7dyNXSMm"},{"id":"س-00003","fp":"596027aeef6f","stateId":317,"easy":"إذا دعوت في الساعة التي في يوم الجمعة ← يُستجاب دعاؤك","cause":"السَّاعةَ الَّتي في يومِ الجمعةِ","result":"يُستجابُ فيها الدُّعاءُ","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-00015","ref":"فتح الباري لابن حجر 2/483","text":["قلتُ لأبي هُرَيْرةَ : إنَّهم زعَموا أنَّ ",["السَّاعةَ الَّتي في يومِ الجمعةِ",1]," ",["يُستجابُ فيها الدُّعاءُ",2]," رُفِعَت،فقالَ : كذبَ من قالَ ذلِكَ قلتُ فَهيَ في كلِّ جمعةٍ قالَ نعَم"],"grade":"حسن","narrator":"عبدالله بن يحنس مولى ‌معاوية","muhaddith":"إسناده قوي","takhrij":"أخرجه عبد الرزاق في ((مصنفه))(5751)، وابن عبد البر في ((التمهيد)) (11/ 617)، كلاهما بمعناه .","bab":"آداب الدعاء › استجابة الدعاء","dorar":"NVgSsYEK"},{"id":"س-00040","fp":"81ab73114221","stateId":317,"easy":"إذا وافقت ساعة يوم الجمعة تسأل الله شيئاً ← تُعطى سؤلك","cause":"في يومِ الجمعةِ ساعةُ من نهارٍ لا يسألُ فيها عبدٌ مسلِمٌ شيئا","result":"إلا أُعطِي سؤلَهُ","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-00015","ref":"شرح السنة 2/555","text":[["في يومِ الجمعةِ ساعةُ من نهارٍ لا يسألُ فيها عبدٌ مسلِمٌ شيئا",1]," ",["إلا أُعطِي سؤلَهُ",2]," قيلَ : يا رسولَ اللهِ : أيّةُ ساعةٍ هِيَ ؟ قال : هيَ حينَ تقامُ الصلاةُ الأولى إلى الانصرافِ منها قال كثيرُ : يعني صلاةَ الجمعةِ"],"grade":"حسن","narrator":"عمرو بن عوف المزني","muhaddith":"حسن غريب","takhrij":"أخرجه الترمذي (490)  ، وابن ماجه (1138) ، وابن عبد البر في ((التمهيد)) (11/ 619)  جميعا بلفظ قريب .","bab":"آداب الدعاء › استجابة الدعاء","dorar":"3r1ipZDB"},{"id":"س-00051","fp":"fcc3ce7c669a","stateId":317,"easy":"إذا دعوت يوم الجمعة بعد العصر إلى الغروب ← يُستجاب لك","cause":"يومَ الجمعةِ بعْدَ العصرِ إلى غُروبِ الشَّمسِ","result":"يُستَجابُ فيها الدُّعاءُ","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-00013","ref":"مجموع رسائل العلائي 1/128","text":["السَّاعةُ الَّتي ",["يُستَجابُ فيها الدُّعاءُ",2]," ",["يومَ الجمعةِ بعْدَ العصرِ إلى غُروبِ الشَّمسِ",1]],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"رجاله ثقات","takhrij":"أخرجه الأصبهاني في ((الترغيب والترهيب)) (907)، والديلمي في ((الفردوس)) (3563) واللفظ لهما","bab":"آداب الدعاء › استجابة الدعاء","dorar":"VXF1as8x"},{"id":"س-02160","fp":"95d2711fc008","stateId":317,"easy":"إذا دعوت في آخر ساعة بعد عصر الجمعة ← يُستجاب لك","cause":"آخرُ ساعةٍ بعدَ العصرِ","result":"يُستجابُ فيها الدُّعاءُ","explicit":true,"repOf":"س-00013","ref":"فتح الباري لابن حجر 2/487","text":["أنَّ السَّاعةَ في الجمعةِ الَّتي ",["يُستجابُ فيها الدُّعاءُ",2]," ",["آخرُ ساعةٍ بعدَ العصرِ",1]],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"إسناده حسن وذكر له طرق","takhrij":"أخرجه أبو داود (1048)، والنسائي (1389)، والطبراني في ((الدعاء)) (184) بنحوه تامًا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"1JfcW2US"},{"id":"س-02140","fp":"78b3d91d8d82","stateId":317,"easy":"إذا دعوت آخر ساعة من يوم الجمعة ← فهي الساعة التي تُتحرى فيها الإجابة","cause":"آخِرُ ساعةٍ مِن الجُمعةِ","result":"إنَّ السَّاعةَ الَّتي يُتحرَّى فيها الدُّعاءُ يوْمَ الجُمعةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-00013","ref":"مجموع رسائل العلائي 1/128","text":[["إنَّ السَّاعةَ الَّتي يُتحرَّى فيها الدُّعاءُ يوْمَ الجُمعةِ",2],"، هي ",["آخِرُ ساعةٍ مِن الجُمعةِ",1],"."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"رجاله ثقات","takhrij":"أخرجه ابن عبد البر في ((التمهيد)) (23/ 43) بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"ywMlzg7X"},{"id":"س-04683","fp":"40a217d93fd1","stateId":318,"easy":"إذا سجدت فأكثر الدعاء ← فهو جدير أن يُستجاب لك","cause":"وأمَّا السُّجودُ فأَكْثروا فيهِ الدُّعاءَ","result":"فإنَّهُ قمِنٌ أن يُستَجابَ لَكُم","explicit":true,"star":true,"ref":"صحيح ابن خزيمة 1/ 633","srcLabel":"مسلم","text":["أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ كشفَ السِّترَ فرأَى النَّاسَ قيامًا وراءَ أبي بَكْرٍ يصلُّونَ، فقالَ: اللَّهمَّ هل بلَّغتُ إنَّهُ لم يبقَ مِن مبشِّراتِ النُّبوَّةِ إلَّا الرُّؤيا الصَّالحةُ يرَاها المسلِمُ لنَفسِهِ أو تُرَى لَهُ، وإنِّي نُهيتُ أن أقرأَ راكعًا أو ساجدًا، فأمَّا الرُّكوعُ فعظِّموا فيهِ الرَّبَّ، ",["وأمَّا السُّجودُ فأَكْثروا فيهِ الدُّعاءَ",1]," ؛ ",["فإنَّهُ قمِنٌ أن يُستَجابَ لَكُم",2]," - وفي روايةٍ - أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ رفعَ السِّترَ والنَّاسُ قيامٌ يصلُّونَ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (479)، والنسائي (1120)، وابن أبي شيبة (30456) بنحوه مختصرا","bab":"رؤيا › الرؤيا الصالحة من النبوة","dorar":"lLYIjBqO","merged":6,"otherRefs":["تخريج المسند لشعيب 1330 (حسن)","تخريج المسند لشعيب 1337 (حسن)","الضعفاء الكبير 3/243 (حسن)","صحيح مسلم 479 (صحيح)","صحيح النسائي 1119 (صحيح)"]},{"id":"س-00088","fp":"f4bb0b2ab025","stateId":318,"easy":"إذا دعوت عند حضور الصلاة وعند الصف في سبيل الله ← تُفتح لك أبواب السماء","cause":"عندَ حضورِ الصَّلاةِ وعندَ الصَّفِّ في سبيلِ اللهِ","result":"ساعتانِ تُفتَحُ فيها أبوابُ السَّماءِ","explicit":true,"similar":["س-00065","س-00043"],"ref":"صحيح الترغيب 266","srcLabel":"البخاري","text":["عند حُضُورِ الصلاةِ [يعني حديث: ",["ساعتانِ تُفتَحُ فيها أبوابُ السَّماءِ",2]," : ",["عندَ حضورِ الصَّلاةِ وعندَ الصَّفِّ في سبيلِ اللهِ",1],"]"],"grade":"صحيح","narrator":"سهل بن سعد الساعدي","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن حبان (1720) بلفظه في أثناء الحديث، وأبو داود (2540)، والطبراني في ((المعجم الكبير)) (6/ 140) (5774)، والبخاري في ((الأدب المفرد)) (661) جميعا بنحوه في أثناء الحديث.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"Ug3GvHy8"},{"id":"س-01525","fp":"d6a86b1177c3","stateId":318,"easy":"إذا رددت مع المؤذن ثم سألت بعد انتهائه ← تُعطى","cause":"قلْ كما يقولونَ ، فإذا انتَهَيتَ فسَلْ","result":"تُعطَهْ","explicit":true,"apply":{"k":"time","t":"عند الأذان"},"otherNeedIds":[45],"ref":"الترغيب والترهيب 1/151","srcLabel":"أبو داود","text":["أنَّ رجلًا ، قالَ : يا رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ إنَّ المؤذِّنينَ يفضلونَنا ، فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ",["قلْ كما يقولونَ ، فإذا انتَهَيتَ فسَلْ",1]," ",["تُعطَهْ",2]],"grade":"صحيح","narrator":"[عبد الله بن عمرو]","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (524)، وابن حبان (1695)، والطبراني (13/ 22) (39) بلفظه.","bab":"أذان › فضل التأذين","dorar":"RTOOFM0q","merged":3,"otherRefs":["تخريج المسند لشاكر 10/104 (صحيح)","تخريج زاد المعاد 2/358 (حسن)"]},{"id":"س-00053","fp":"b25416a35014","stateId":318,"easy":"إذا دعوت عند النداء أو عند التحام القتال ← لا تُرد دعوتك","cause":"الدُّعاءُ عندَ النِّداءِ، أوْ عندَ البأسِ حين يُلحِمُ بعضُهُم بعضًا","result":"ثِنتانِ لا تُردَّانِ","explicit":true,"apply":{"k":"time","t":"عند الأذان"},"similar":["س-00038"],"ref":"المستدرك على الصحيحين 2570","srcLabel":"أبو داود","text":[["ثِنتانِ لا تُردَّانِ",2]," -أوْ قالَ: قلَّ ما تُردَّانِ- ",["الدُّعاءُ عندَ النِّداءِ، أوْ عندَ البأسِ حين يُلحِمُ بعضُهُم بعضًا",1],". قالَ موسى بنُ يَعقوبَ: وحدَّثَني رِزقُ بنُ سعيدِ بنِ عبدِ الرَّحمنِ المَدَنيُّ عنْ أبي حازمٍ، عنْ سهلِ بنِ سَعدٍ، عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ قالَ: وتَحتَ المطرِ."],"grade":"صحيح","narrator":"سهل بن سعد","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داود (2540)، والدارمي (1236) باختلاف يسير.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"61UulYZU","merged":2,"otherRefs":["الترغيب والترهيب 2/262 (صحيح)"]},{"id":"س-00007","fp":"6cf6c8456ab7","stateId":318,"easy":"إذا دعوت عند التقاء الجيوش وإقامة الصلاة ونزول المطر ← فهي أوقات إجابة","cause":"عندَ التقاءِ الجيوشِ ، و إقامةِ الصلاةِ ، و نزولِ الغيثِ","result":"اطلبوا استجابةَ الدعاءِ","explicit":true,"ref":"صحيح الجامع 1026","srcLabel":"البيهقي","text":[["اطلبوا استجابةَ الدعاءِ",2]," ",["عندَ التقاءِ الجيوشِ ، و إقامةِ الصلاةِ ، و نزولِ الغيثِ",1]],"grade":"صحيح","narrator":"مكحول","muhaddith":"صحيح","takhrij":"أخرجه يحيى بن سلام في ((تفسيره)) (1/ 455) والشافعي في ((الأم)) (2/ 554) والبيهقي في ((معرفة السنن والأثار)) (5/ 186) باختلاف يسير.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"a3KahKpG"},{"id":"س-00065","fp":"fc4bec5224f9","stateId":318,"easy":"إذا دعوت عند النداء وعند الصف في سبيل الله ← تُفتح أبواب السماء وقلما تُرد دعوتك","cause":"عند حضورِ النِّداءِ والصَّفِّ في سبيلِ اللهِ","result":"ساعتان تُفتَّحُ فيهما أبوابُ السَّماءِ وقلَّما تُرَدُّ على داعٍ دعوتَه","explicit":true,"apply":{"k":"time","t":"عند الأذان"},"repOf":"س-00088","ref":"الترغيب والترهيب 2/262","text":[["ساعتان تُفتَّحُ فيهما أبوابُ السَّماءِ وقلَّما تُرَدُّ على داعٍ دعوتَه",2]," ",["عند حضورِ النِّداءِ والصَّفِّ في سبيلِ اللهِ",1]," وفي لفظٍ ثِنْتان لا تُرِدَّان أو قال ما تُرَدَّان الدُّعاءُ عند النِّداءِ وعند البأسِ حين يلحَمُ بعضٌ بعضًا"],"grade":"صحيح","narrator":"سهل بن سعد الساعدي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن حبان (1720)، والبيهقي (2015) باختلاف يسير. واللفظ: أخرجه أبو داود (2540)، والدارمي (1200)، وابن الجارود في ((المنتقى)) (1065) باختلاف يسير","bab":"آداب الدعاء › استجابة الدعاء","dorar":"YyD0HxiH"},{"id":"س-01488","fp":"844dd9500fde","stateId":318,"easy":"إذا دعوت بين الأذان والإقامة ← لا تُرد دعوتك","cause":"الدَّعْوةُ","result":"لا تُرَدُّ بيْن الأذانِ والإقامةِ","explicit":true,"apply":{"k":"time","t":"عند الأذان"},"similar":["س-01490","س-01866","س-05827","س-00060"],"ref":"تخريج المسند لشعيب 13357","srcLabel":"أبو داود","text":[["الدَّعْوةُ ",1],["لا تُرَدُّ بيْن الأذانِ والإقامةِ",2],"؛ فادْعُوا."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (521)، والترمذي (212)، والنسائي في ((السنن الكبرى)) (9895)، وأحمد (13357) واللفظ له","bab":"أذان › الأذكار بعد الأذان","dorar":"X9wutRiP"},{"id":"س-01490","fp":"f04ac5f48090","stateId":318,"easy":"إذا دعوت بين الأذان والإقامة ← لا يُرد دعاؤك","cause":"الدُّعاءُ","result":"لا يُرَدُّ بَيْنَ الأذانِ والإقامةِ","explicit":true,"apply":{"k":"time","t":"عند الأذان"},"repOf":"س-01488","ref":"التعليقات البازية على زاد المعاد 296","text":["حديثُ: ",["الدُّعاءُ ",1],["لا يُرَدُّ بَيْنَ الأذانِ والإقامةِ",2],"، قالوا: فما نقولُ يا رَسولَ اللهِ؟ قال: سَلُوا اللهَ العافيةَ في الدُّنيا والآخِرةِ."],"grade":"صحيح","narrator":"[أنس بن مالك]","muhaddith":"الصحيح أنَّ الحديث ثابت إلى هنا، وإنما الكلام في زياداته","takhrij":"أخرجه أبو داود (521)، والترمذي (212)، وأحمد (12200) جميعهم بلفظه.","bab":"أذان › الأذكار بعد الأذان","dorar":"GFA4T5sJ"},{"id":"س-01521","fp":"86bff8db3296","stateId":318,"easy":"إذا نزل بك كرب أو شدة فتحيّن الأذان ← فعند النداء تُفتح أبواب السماء ويُستجاب الدعاء","cause":"فمَنْ نَزَلَ به كَربٌ أوْ شِدَّةٌ فليَتَحَيَّنِ المُنادي","result":"إذا نادى المُنادي فُتِحَتْ أَبوابُ السَّماءِ، واستُجيبَ الدُّعاءُ","explicit":true,"apply":{"k":"time","t":"عند الأذان، عند الكرب والهم"},"otherNeedIds":[4],"ref":"المستدرك على الصحيحين 2030","srcLabel":"الطبراني","text":[["إذا نادى المُنادي فُتِحَتْ أَبوابُ السَّماءِ، واستُجيبَ الدُّعاءُ",2],"، ",["فمَنْ نَزَلَ به كَربٌ أوْ شِدَّةٌ فليَتَحَيَّنِ المُنادي",1],"، فإذا كَبَّرَ كَبَّرَ، وإذا تَشهَّدَ تَشهَّدَ، وإذا قالَ: حَيَّ على الصَّلاةِ، قالَ: حَيَّ على الصَّلاةِ، وإذا قالَ: حَيَّ على الفلاحِ، قالَ: حَيَّ على الفلاحِ، ثُمَّ يقولُ: اللَّهُمَّ ربَّ هذه الدَّعوةِ الصَّادقةِ المستجابِ لها، دعوةِ الحقِّ، وكلمةِ التَّقوى، أَحيِنا عليها وأَمِتْنا عليها، وابعَثْنا عليها، واجعَلْنا مِن خيارِ أَهلِها أَحياءً وأَمواتًا، ثُمَّ يَسألُ اللهَ حاجَتَه."],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن السني في ((عمل اليوم والليلة)) (98) بلفظه، والطبراني في ((الدعاء)) (458) باختلاف يسير.","bab":"أذان › فضل التأذين","dorar":"2d8MgUUr"},{"id":"س-01866","fp":"0f5b8259a114","stateId":318,"easy":"إذا دعوت بين الأذان والإقامة ← يُستجاب لك","cause":"الدُّعاءُ بين الأذانِ و الإقامةِ","result":"مُستجابٌ","explicit":true,"apply":{"k":"time","t":"عند الأذان"},"repOf":"س-01488","ref":"صحيح الجامع 3405","text":[["الدُّعاءُ بين الأذانِ و الإقامةِ ",1],["مُستجابٌ ",2],"، فادْعوا"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه أبو يعلى (3680 ) واللفظ له، وأخرجه أبو داود (521 )، والترمذي (212 )، والنسائي في ((الكبرى)) (9812 )، وأحمد (12221 ) بمعناه","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"brf6c8Yg"},{"id":"س-05827","fp":"b714c612a718","stateId":318,"easy":"إذا دعوت بين الأذان والإقامة ← لا تُرد دعوتك","cause":"الدَّعوةُ بينَ الأذانِ والإقامةِ","result":"لا تُردُّ فادعوا","explicit":true,"apply":{"k":"time","t":"عند الأذان"},"repOf":"س-01488","ref":"صحيح ابن خزيمة 1/ 504","text":[["الدَّعوةُ بينَ الأذانِ والإقامةِ ",1],["لا تُردُّ فادعوا",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أخرجه في صحيحه","bab":"رقائق وزهد › الوصايا النافعة","dorar":"a1VUj2Po"},{"id":"س-00038","fp":"6c114f61b0e7","stateId":318,"easy":"إذا دعوت عند النداء وتحت المطر ← لا تُرد دعوتك","cause":"الدُّعاءُ عند النِّداءِ ، و تحْتَ المَطَرِ","result":"ثِنتانِ ما تُرَدّانِ","explicit":true,"apply":{"k":"time","t":"عند الأذان"},"repOf":"س-00053","ref":"صحيح الجامع 3078","text":[["ثِنتانِ ما تُرَدّانِ",2]," : ",["الدُّعاءُ عند النِّداءِ ، و تحْتَ المَطَرِ",1]],"grade":"حسن","narrator":"سهل بن سعد الساعدي","muhaddith":"حسن","takhrij":"أخرجه ابن أبي عاصم في ((الجهاد)) (19)، والطبراني (6/135) (5756)، والحاكم (2534) باختلاف يسير.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"EzuVI0RA"},{"id":"س-00060","fp":"16c084147c6b","stateId":318,"easy":"إذا دعوت بين الأذان والإقامة ← يُستجاب لك","cause":"الدُّعاءُ","result":"مُستجابٌ بين النِّداءِ و الإقامةِ","explicit":true,"apply":{"k":"time","t":"عند الأذان"},"repOf":"س-01488","ref":"صحيح الجامع 3406","text":[["الدُّعاءُ ",1],["مُستجابٌ بين النِّداءِ و الإقامةِ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"أخرجه أبو داود (521 )، والترمذي (212 )، والنسائي في ((الكبرى)) (9812 )، وأحمد (12221 )أبو يعلى (3680 ) بمعناه","bab":"آداب الدعاء › استجابة الدعاء","dorar":"urFKno7L"},{"id":"س-00043","fp":"da9d1112a095","stateId":318,"easy":"إذا دعوت حين تقام الصلاة وفي الصف في سبيل الله ← لا تُرد دعوتك","cause":"ساعتانِ","result":"لا تُرَدُّ على داعٍ دعوتُه: حين تُقامُ الصَّلاةُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-00088","ref":"الأحكام الكبير 2/265","text":[["ساعتانِ ",1],["لا تُرَدُّ على داعٍ دعوتُه: حين تُقامُ الصَّلاةُ",2],"، وفي الصَّفِّ في سبيلِ اللهِ."],"grade":"صحيح","narrator":"سهل بن سعد الساعدي","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (1720) واللفظ له، وأخرجه أبو داود (2540)، والدارمي (1200) بنحوه","bab":"آداب الدعاء › استجابة الدعاء","dorar":"qbkGVvYu"},{"id":"س-05885","fp":"e8172dde2d09","stateId":319,"easy":"إذا سمعت صياح الديك فسل الله من فضله ← فإنها رأت ملكاً","cause":"فاسْأَلوا اللهَ وارْغَبوا إليه","result":"فإنَّها رأتْ مَلَكًا","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 8269","srcLabel":"متفق عليه","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فذَكَرَ معناه. [أيْ حديثَ: إذا سَمِعْتُم أصواتَ الدِّيَكةِ ",["فإنَّها رأتْ مَلَكًا",2],"؛ ",["فاسْأَلوا اللهَ وارْغَبوا إليه",1],"، وإذا سَمِعْتُم نُهاقَ الحَمِيرِ فإنَّها رأتْ شيطانًا؛ فاسْتَعِيذوا بِاللهِ مِنْ شَرِّ ما رأتْ]."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه البخاري (3303)، ومسلم (2729)، وأبو داود (5102)، والترمذي (3459)، والنسائي في ((السنن الكبرى)) (10779)، وأحمد (8269) واللفظ له","bab":"رقائق وزهد › الوصايا النافعة","dorar":"CPx3M4tL","merged":5,"otherRefs":["تخريج المسند لشعيب 8764 (صحيح)","صحيح الأدب المفرد 938 (صحيح)","صحيح الترمذي 3459 (صحيح)","صحيح الجامع 611 (صحيح)"]},{"id":"س-06847","fp":"e71da8e65854","stateId":319,"easy":"إذا سألت الله عند (ساعة الإجابة) شيئاً ← يعطيك إياه","cause":"ما من مسلمٍ يَسْأَلُ اللهَ عنده شيئًا","result":"إلا أعطاه إيَّاهُ","explicit":true,"ref":"كشف الخفاء 1/417","srcLabel":"عبد الرزاق","text":["الركنُ يَمِينُ اللهِ عز وجل يُصافِحُ بها خَلْقَهُ , والذي نفسُ ابنِ عباسٍ بيدِهِ ",["ما من مسلمٍ يَسْأَلُ اللهَ عنده شيئًا",1]," ",["إلا أعطاه إيَّاهُ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه عبد الرزاق (8878 )، والأزرقي في ((أخبار مكة )) (1/ 326) موقوفا","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"bIkcvbVv"},{"id":"س-00071","fp":"e8a42c33604c","stateId":319,"easy":"إذا دعوت يوم الأربعاء بين الظهر والعصر ← تُعرف الإجابة (من فعل جابر)","cause":"تَوَخَّيْتُ تِلْكَ السَّاعَةَ ؛ فَدَعَوْتُ اللهَ فيهِ بين الصَّلاتَيْنِ يومَ الأربعاءِ","result":"إلَّا عَرَفْتُ الإِجَابَةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-00087"],"ref":"صحيح الأدب المفرد 542","srcLabel":"البخاري","text":["دعَا رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ في هذا المسجدِ ؛ مسجدِ الفَتْحِ ، يومَ الِاثْنَيْنِ ويومَ الثُّلاثَاءِ ويومَ الأربعاءِ ، فَاسْتُجِيبَ لهُ بين الصَّلاتَيْنِ من يومِ الأربعاءِ . قال جَابِرٌ : ولمْ يَنْزِلْ بي أَمْرٌ مُهِمٌّ غائِظٌ إلَّا ",["تَوَخَّيْتُ تِلْكَ السَّاعَةَ ؛ فَدَعَوْتُ اللهَ فيهِ بين الصَّلاتَيْنِ يومَ الأربعاءِ",1]," في تِلْكَ السَّاعَةِ ، ",["إلَّا عَرَفْتُ الإِجَابَةَ",2]],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"حسن","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (704) بلفظه، وأحمد (14563)، والبيهقي في ((شعب الإيمان)) (3591) كلاهما باختلتاف يسير.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"UczMFibl"},{"id":"س-02258","fp":"3fc1c0d059f0","stateId":319,"easy":"إذا دعوت عند إفطارك وأنت صائم ← فلك دعوة مستجابة","cause":"لكلِّ عَبْدٍ صائمٍ دَعْوةٌ","result":"مستجابةٌ عند إفطارِه أُعطِيَها في الدُّنيا","explicit":true,"ref":"التنوير شرح الجامع الصغير 9/88","srcLabel":"الترمذي","text":[["لكلِّ عَبْدٍ صائمٍ دَعْوةٌ ",1],["مستجابةٌ عند إفطارِه أُعطِيَها في الدُّنيا",2],"، أو ذُخِر له في الآخرةِ."],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"رمز المصنف لحسنه إلا أن مخرجه الحكيم قال: إنه إنما رفعه نصر بن دغل وغيره وقفوه على ابن عمر، رمز المصنف أوهم أنه مرفوع باتفاق","takhrij":"أخرجه الحكيم الترمذي في ((نوادر الأصول)) (355) واللفظ له، وقوام السنة في ((الترغيب والترهيب)) (1805)، وابن فندمة في ((تاريخ بيهق)) (صـ387) بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"7EVvUQn2"},{"id":"س-00087","fp":"0e7dcf3b46f4","stateId":319,"easy":"إذا تحرّيت ساعة الإجابة يوم الأربعاء ← تعرف الإجابة (من فعل جابر)","cause":"تَوَخَّيْتُ تِلْكَ الساعَةِ فأَدْعُو فيها","result":"فأعرِفُ الإِجابَةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-00071","ref":"مجمع الزوائد 15-4","text":["أنَّ النبيَّ صلَّى اللهُ عليه وسلَّم دَعَا في مسجِدِ الفتحِ ثلاثًا يومَ الاثنينِ ويومَ الثلاثاءِ ويومَ الأربعاءِ فاسْتُجِيبَ لَهُ يَومَ الأربعاءِ بينَ الصلاتَيْنِ فَعُرِفَ البِشْرُ في وجهِهِ قال جابِرٌ فلَمْ ينزلْ بي أَمْرٌ مُهِمٌّ غليظٌ إلَّا ",["تَوَخَّيْتُ تِلْكَ الساعَةِ فأَدْعُو فيها",1]," ",["فأعرِفُ الإِجابَةَ",2]],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"رجاله ثقات","takhrij":"أخرجه أحمد (14563) بلفظه، وابن الغطريف في ((جزئه)) (68)، والبيهقي في ((شعب الإيمان)) (3591) كلاهما باختلاف يسير.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"KUur8tC3"},{"id":"س-00012","fp":"569d90fabfd5","stateId":319,"easy":"إذا دعوت في رمضان ← فلك كل يوم وليلة دعوة مستجابة","cause":"إنَّ للهِ تبارك و تعالى عُتقاءَ في كلِّ يومٍ و لَيلةٍ يعني: في رمضانَ","result":"و إنَّ لكلِّ مسلمٍ في كلِّ يومٍ و ليلةٍ دعوةً مُستجابةً","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"apply":{"k":"time","t":"في رمضان"},"similar":["س-00086"],"otherNeedIds":[66],"ref":"صحيح الترغيب 1002","srcLabel":"أحمد","text":[["إنَّ للهِ تبارك و تعالى عُتقاءَ في كلِّ يومٍ و لَيلةٍ (يعني: في رمضانَ",1],"). ",["و إنَّ لكلِّ مسلمٍ في كلِّ يومٍ و ليلةٍ دعوةً مُستجابةً",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (7450)، والبزار كما في ((كشف الأستار)) (962) واللفظ لهما.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"jjqPyyDC"},{"id":"س-00086","fp":"ef24b306bd22","stateId":319,"easy":"إذا دعوت في رمضان ← فلك دعوة مستجابة كل يوم وليلة","cause":"إنَّ للهِ في كلِّ يومٍ وليلةٍ عُتَقاءَ مِنَ النَّارِ في شهرِ رمضانَ","result":"وإنَّ لكلِّ مسلمٍ دَعوةً يدعو بها فيُسْتجابُ له","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"apply":{"k":"time","t":"في رمضان"},"repOf":"س-00012","otherNeedIds":[66],"ref":"مجمع الزوائد 10/152","text":[["إنَّ للهِ في كلِّ يومٍ وليلةٍ عُتَقاءَ مِنَ النَّارِ في شهرِ رمضانَ",1]," ",["وإنَّ لكلِّ مسلمٍ دَعوةً يدعو بها فيُسْتجابُ له",2]],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"رجاله ثقات","takhrij":"أخرجه البزار كما في ((كشف الأستار)) (3142) واللفظ له، وابن ماجة (1643)، وابن شاهين في ((الترغيب في فضائل الأعمال)) (147) بنحوه.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"YH112agZ"},{"id":"س-08121","fp":"fcffeb3fe301","stateId":320,"easy":"إذا دعوت لأخيك بظهر الغيب ← فدعوتك مستجابة","cause":"دعوةُ المرءِ","result":"مستجابةٌ لأخيهِ بظَهْرِ الغيبِ","explicit":true,"star":true,"similar":["س-08197","س-08133","س-00036","س-00075","س-00707"],"ref":"صحيح ابن ماجه 2358","srcLabel":"مسلم","text":[["دعوةُ المرءِ ",1],["مستجابةٌ لأخيهِ بظَهْرِ الغيبِ",2],"، عندَ رأسِهِ ملَكٌ يؤمِّنُ على دعائِهِ، كلَّما دعا لَهُ بخيرٍ، قالَ: آمينَ، ولَكَ بمثلهِ"],"grade":"صحيح","narrator":"خيرة بنت أبي حدرد أم الدرداء الكبرى","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (2895) واللفظ له، وأخرجه مسلم (2733) باختلاف يسير مطولاً","bab":"ملائكة › أعمال الملائكة","dorar":"yHFSr1k7"},{"id":"س-08197","fp":"56513427c413","stateId":320,"easy":"إذا دعوت لأخيك بظهر الغيب ← يُستجاب لك","cause":"دعاءُ المرءِ المسلِمِ","result":"مُستجابٌ لأخِيهِ بظهرِ الغيبِ","explicit":true,"repOf":"س-08121","ref":"صحيح الجامع 3380","text":[["دعاءُ المرءِ المسلِمِ ",1],["مُستجابٌ لأخِيهِ بظهرِ الغيبِ ",2],"، عند رأسِه ملَكٌ مُوكَّلٌ به ؛ كُلَّمَا دَعَا لأخِيهِ بِخيرٍ قال الملَكُ : آمينَ و لكَ بِمثلِ ذلكَ"],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2733) باختلاف يسير.","bab":"ملائكة › أعمال الملائكة","dorar":"0oK6Nk1a"},{"id":"س-08133","fp":"5ff7644b385b","stateId":320,"easy":"إذا دعوت لأخيك بظهر الغيب ← فدعوتك مستجابة","cause":"دَعوةُ المَرءِ المُسلِمِ لأخيه بظَهرِ الغَيبِ","result":"مُستَجابةٌ","explicit":true,"repOf":"س-08121","ref":"صحيح مسلم 2733","text":["عن صَفوانَ، وهو ابنُ عبدِ اللهِ بنِ صَفوانَ، وكانت تحتَه الدَّرداءُ، قال: قدِمتُ الشَّامَ، فأتَيتُ أبا الدَّرداءِ في مَنزِلِه، فلم أجِدْه ووجَدتُ أُمَّ الدَّرداءِ، فقالت: أتُريدُ الحَجَّ العامَ؟ فقُلتُ: نَعَم، قالت: فادعُ اللهَ لَنا بخَيرٍ؛ فإنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم كان يقولُ: ",["دَعوةُ المَرءِ المُسلِمِ لأخيه بظَهرِ الغَيبِ ",1],["مُستَجابةٌ",2],"، عِندَ رَأسِه مَلَكٌ موكَّلٌ، كُلَّما دَعا لأخيه بخَيرٍ قال المَلَكُ الموكَّلُ به: آمينَ، ولَكَ بمِثلٍ."],"grade":"صحيح","narrator":"أم الدرداء","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (27559) بلفظه، وابن أبي شيبة (29768) باختلاف يسير، وابن ماجه (2895) بنحوه .","bab":"ملائكة › أعمال الملائكة","dorar":"S94d0yIc","merged":3,"otherRefs":["مختصر المقاصد 458 (صحيح)","صحيح الجامع 3381 (صحيح)"]},{"id":"س-08129","fp":"10baa0426978","stateId":320,"easy":"إذا دعوت لغائب ← يقول لك الملك: ولك بمثل","cause":"إذا دعا الغائبُ للغائبِ","result":"قال له المَلكُ : وَ لَكَ بِمِثْل","explicit":true,"repOf":"س-01953","ref":"السلسلة الصحيحة 1339","text":[["إذا دعا الغائبُ للغائبِ",1]," ، ",["قال له المَلكُ : وَ لَكَ بِمِثْل",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح المتن","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (2/428)","bab":"ملائكة › أعمال الملائكة","dorar":"ZF2wZnfW","merged":2,"otherRefs":["صحيح الجامع 535 (صحيح)"]},{"id":"س-08208","fp":"c885fbcae5bd","stateId":320,"easy":"إذا دعوت لأخيك بظهر الغيب ← يوكّل الله بك ملكاً يقول: آمين ولك بمثل","cause":"ما مِن رجُلٍ يدعو لأخيهِ بظهرِ الغَيبِ بدعوةٍ","result":"إلَّا وكَّلَ اللَّهُ به ملكًا كلَّما دعا دعوةً قال الملَكُ الموَكَّلُ بهِ : آمينَ ولكَ مثلِهِ","explicit":true,"repOf":"س-01953","ref":"مجموع الفتاوى 1/79","text":[["ما مِن رجُلٍ يدعو لأخيهِ بظهرِ الغَيبِ بدعوةٍ",1]," ",["إلَّا وكَّلَ اللَّهُ به ملكًا كلَّما دعا دعوةً قال الملَكُ الموَكَّلُ بهِ : آمينَ ولكَ مثلِهِ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"ملائكة › أعمال الملائكة","dorar":"zpcgs8nC","merged":2,"otherRefs":["مجموع الفتاوى 27/69 (صحيح)"]},{"id":"س-00021","fp":"751744a0174b","stateId":320,"easy":"إذا كنت مظلوماً أو دعوت لأخيك بظهر الغيب ← فليس بين دعوتك وبين الله حجاب","cause":"دَعوةُ المظلومِ ، ودعوةُ المرْءِ لأخيهِ بِظهْرِ الغيْبِ","result":"ليس بينهُما وبينَ اللهِ حِجابٌ","explicit":true,"ref":"الجامع الصغير 4191","srcLabel":"الطبراني","text":["دعْوَتانِ ",["ليس بينهُما وبينَ اللهِ حِجابٌ",2]," : ",["دَعوةُ المظلومِ ، ودعوةُ المرْءِ لأخيهِ بِظهْرِ الغيْبِ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((الدعاء)) (1330)، والشجري في ((ترتيب الأمالي)) (1185) واللفظ لهما، وقوام السنة في ((الترغيب والترهيب)) (2092) باختلاف يسير.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"FNV58XgD"},{"id":"س-00036","fp":"4b55c188b678","stateId":320,"easy":"إذا دعوت لغائب وأنت غائب عنه ← فهي أسرع الدعاء إجابة","cause":"دعوةُ غائبٍ لغائبٍ","result":"إنَّ أسرَعَ الدُّعاءِ إجابةً","explicit":true,"repOf":"س-08121","ref":"المصابيح في الأحاديث المتواترة 596","text":[["إنَّ أسرَعَ الدُّعاءِ إجابةً",2]," ",["دعوةُ غائبٍ لغائبٍ",1]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"آداب الدعاء › استجابة الدعاء","dorar":"cbOgvl59"},{"id":"س-00075","fp":"c088c94eb9b0","stateId":320,"easy":"إذا دعا لك أخوك في الله ← تُستجاب","cause":"دعوةَ الأخِ في اللهِ","result":"تُستجابُ","explicit":true,"repOf":"س-08121","otherNeedIds":[41],"ref":"صحيح الأدب المفرد 486","text":["عن أبي بكرٍ رضيَ اللهُ عنهُ قال إنَّ ",["دعوةَ الأخِ في اللهِ",1]," ",["تُستجابُ",2]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"آداب الدعاء › استجابة الدعاء","dorar":"UdAq1qYK"},{"id":"س-00707","fp":"96a92ddc709e","stateId":320,"easy":"إذا دعوت لأخيك بظهر الغيب ← لا يُرد دعاؤك","cause":"دُعاءُ الأخِ لأخِيهِ بِظَهرِ الغيْبِ","result":"لا يُرَدُّ","explicit":true,"repOf":"س-08121","ref":"صحيح الجامع 3379","text":[["دُعاءُ الأخِ لأخِيهِ بِظَهرِ الغيْبِ ",1],["لا يُرَدُّ",2]],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"صحيح","takhrij":"أخرجه البزار كما في ((البحر الزخار)) (3577)، واللفظ له.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"Lbq0wYiD"},{"id":"س-01953","fp":"9ee80d835b29","stateId":320,"easy":"إذا دعوت لأخيك بظهر الغيب ← يقول الملك: ولك بمثل","cause":"ما مِن مُسلِمٍ يدعو لأخيه بظَهْرِ الغيبِ","result":"إلَّا قال المَلَكُ : ولكَ بمِثْلٍ ولكَ بمِثْلٍ","explicit":true,"star":true,"similar":["س-08129","س-08208"],"otherNeedIds":[24],"ref":"تخريج صحيح ابن حبان 989","srcLabel":"مسلم","text":[["ما مِن مُسلِمٍ يدعو لأخيه بظَهْرِ الغيبِ",1]," ",["إلَّا قال المَلَكُ : ولكَ بمِثْلٍ ولكَ بمِثْلٍ",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2732) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"zK3Clb0o","merged":6,"otherRefs":["تفسير القرطبي 6/485 (صحيح)","صحيح الجامع 6235 (صحيح)","البداية والنهاية 1/44 (صحيح)","مجمع الزوائد 10/155 (حسن)","صحيح أبي داود 1534 (صحيح)"]},{"id":"ق-0905","fp":"d4cf7a8b42e1","stateId":321,"easy":"دعاء المضطر ← الإجابة وكشف السوء","cause":"دعاء المضطر","result":"الإجابة وكشف السوء","explicit":true,"otherNeedIds":[4],"ref":"سورة النمل: 62","srcLabel":"القرآن الكريم","quran":{"s":27,"from":62,"to":62,"text":"أَمَّنْ يُجِيبُ الْمُضْطَرَّ إِذَا دَعَاهُ وَيَكْشِفُ السُّوءَ وَيَجْعَلُكُمْ خُلَفَاءَ الْأَرْضِ أَإِلَهٌ مَعَ اللَّهِ قَلِيلًا مَا تَذَكَّرُونَ (62)","hl":[[0,15,2],[15,43,1],[43,62,2]]}},{"id":"س-07387","fp":"f58e9272fe83","stateId":321,"easy":"إذا رددت على من دعا عليك ← يُستجاب لك فيه ولا يُستجاب له فيك","cause":"رددتُ عليهم","result":"إنه يُستجابُ لنا فيهم ، ولا يُستجابُ لهم فينا","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"السلسلة الصحيحة 6/492","srcLabel":"متفق عليه","text":["إنَّ اليهودَ دخلوا على رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ فقالوا : السَّامُ عليك ، فقال : وعليكم ، فقالت عائشةُ : عليكمُ السَّامُ وغضبُ اللهِ ولعنتُه أخوةَ القِرَدةِ والخنازيرَ ، فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ : يا عائشةُ عليكِ بالحِلمِ ، وإياك والجهلَ . فقالت : أوَلم تسمعْ ما قالوا ؟ قالوا : السَّامُ عليكَ ، فقال : أوَليس قد ",["رددتُ عليهم",1]," ، ",["إنه يُستجابُ لنا فيهم ، ولا يُستجابُ لهم فينا",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناد صحيح على شرط الشيخين","takhrij":"أخرجه إسحق بن راهويه في ((المسند)) (1685) واللفظ له، وأصله في صحيح البخاري (6030)، ومسلم (2165)","bab":"فضائل النبي وصفته ودلائل النبوة › أخلاق النبي","dorar":"HPCZkg8P","merged":2,"otherRefs":["تخريج المسند لشعيب 24851 (حسن)"]},{"id":"س-04044","fp":"b01e049388ac","stateId":321,"easy":"إذا كنت مظلوماً ← تُرفع دعوتك فوق الغمام وتُفتح لها أبواب السماء","cause":"ودَعْوةُ المَظْلومِ","result":"تُحمَلُ على الغَمامِ، وتُفتَحُ لها أبْوابُ السَّماءِ، ويقولُ الرَّبُّ عَزَّ وجَلَّ: وعِزَّتي لَأَنْصُرَنَّك ولو بَعْدَ حينٍ","explicit":true,"repOf":"س-00032","otherNeedIds":[25,56],"ref":"الصحيح المسند 2/366","text":["قُلْنا: يا رَسولَ اللهِ، إنَّا إذا رَأيْناك رَقَّتْ قُلوبُنا، وكُنَّا مِن أهْلِ الآخِرةِ، وإذا فارَقْناك أَعْجَبَتْنا الدُّنْيا، وشَمَمْنا النِّساءَ والأوْلادَ، قالَ: «لو تَكونونَ -أو قالَ: لو أنَّكم تَكونونَ- على كلِّ حالٍ على الحالِ الَّتي أنتم عليها عنْدي لَصافَحَتْكم المَلائِكةُ بأَكُفِّهم، ولَزارَتْكم في بُيوتِكم، ولو لم تُذْنِبوا لَجاءَ اللهُ بقَوْمٍ يُذنِبونَ كي يَغفِرَ لهم»، قالَ: قُلْنا: يا رَسولَ اللهِ، حَدِّثْنا عن الجَنَّةِ، ما بِناؤُها؟ قالَ: «لَبِنةٌ ذَهَبٌ، ولَبِنةٌ فِضَّةٌ، ومِلاطُها المِسْكُ الأَذفَرُ وحَصْباؤُها اللُّؤْلُؤُ والياقوتُ، وتُرابُها الزَّعْفَرانُ، مَن يَدخُلُها يَنعَمُ ولا يَبأَسُ، ويَخلُدُ ولا يَموتُ، لا تَبْلى ثِيابُه، ولا يَفْنى شَبابُه، ثَلاثةٌ لا تُرَدُّ دَعْوتُهم: الإمامُ العادِلُ، والصَّائِمُ حتَّى يُفطِرَ، ",["ودَعْوةُ المَظْلومِ",1]," ",["تُحمَلُ على الغَمامِ، وتُفتَحُ لها أبْوابُ السَّماءِ، ويقولُ الرَّبُّ عَزَّ وجَلَّ: وعِزَّتي لَأَنْصُرَنَّك ولو بَعْدَ حينٍ",2],"»."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (8043)، وابن حبان (7387)، والطيالسي (2706) باختلاف يسير.","bab":"توبة › سقوط الذنوب بالاستغفار والتوبة","dorar":"EoStGiec","merged":4,"otherRefs":["الزواجر عن اقتراف الكبائر 1/197 (صحيح)","صحيح الجامع 117 (صحيح)","شرح كتاب الشهاب 369 (صحيح)"]},{"id":"س-00032","fp":"f72112d51c77","stateId":321,"easy":"إذا كنت مظلوماً ← فدعوتك مستجابة","cause":"دَعْوةُ المَظْلومِ","result":"مُسْتَجابةٌ","explicit":true,"similar":["س-04044","س-01687","س-00044"],"otherNeedIds":[56],"ref":"الأحكام الوسطى 4/ 268","srcLabel":"ابن عدي","text":[["\"دَعْوةُ المَظْلومِ ",1],["مُسْتَجابةٌ",2],"، وإن كانَتْ مِن فاجِرٍ ففُجورُه على نفْسِه\"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (7/ 53)، والدارقطني في ((العلل)) (2080)، والخطيب في ((تاريخ بغداد)) (3/ 78) بلفظه.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"yZUJyslX","merged":3,"otherRefs":["الجامع الصغير 4188 (صحيح)","صحيح الجامع 1037 (حسن)"]},{"id":"س-01687","fp":"cdc8479ee08c","stateId":321,"easy":"إذا كنت مظلوماً ← لا تُرد دعوتك ولو كنت كافراً","cause":"دعوةَ المظلومِ","result":"فإنِّي لا أردُّها ولَو كانَت مِن كافِرٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"repOf":"س-00032","ref":"النوافح العطرة 227","text":["قُلِ الحقَّ وإن كان مُرًّا [يعني حديث: دخَلتُ علَى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وهو في المسجِدِ جالِسٌ، فاغتَنَمتُ خلوتَهُ، وحدَهُ، فجلَستُ إليهِ، فقالَ : أبا ذَرٍّ ! إن لِلمَسجِد تَحيَّةً، وإنَّ تحيَّتَهُ ركعتان فقُم فاركَعهما، قالَ : فقُمت فركَعتُها ثم عُدتُ فجلَستُ إليهِ، فقُلتُ : يا رسولَ اللهِ ! إنَّكَ أمَرتَني بالصَّلاةِ فما الصَّلاةُ ؟ قال : خيرٌ موضوعٌ استكثِرْ أو استَقِلَّ. قلتُ : يا رسولَ اللهِ ! فأيُّ الأعمالِ أفضَلُ ؟ قال : إيمانٌ باللَّهِ عزَّ وجلَّ، وجهادٌ في سبيلِهِ، قال : قلتُ : يا رسولَ اللهِ ! فأيُّ المؤمنينَ أكمَلُهم إيمانًا ؟ قالَ : أحسَنُهُم خُلُقًا. قالَ : قلتُ : يا رسولَ اللَّهِ ! فأيُّ المؤمنينَ أسلَمُ ؟ قالَ : مَن سلِمَ النَّاسُ من لسانِهِ ويدِهِ. قال : قلتُ : يا رسولَ اللَّهِ ! فأيُّ الهجرةِ أفضَلُ ؟ قال : مَن هجرَ السَّيِّئاتِ. قالَ : قُلتُ : يا رسولَ اللهِ ! فأيُّ الصَّلاةِ أفضَلُ ؟ قال : طولُ القنوتِ . قال : قلتُ : يا رسولَ اللهِ ! فما الصِّيامُ ؟ قالَ : فرضٌ مَجزيٌّ ، وعندَ اللهِ أضعافٌ كثيرةٌ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ الجهادِ أفضَلُ ؟ قالَ : مَن عُقِرَ جوادُهُ وأهريقَ دمُهُ. قال : قُلتُ : يا رسولَ اللهِ ! فأيُّ الرِّقابِ أفضَلُ ؟ قالَ : أغلاها ثَمنًا وأنفَسُها عندَ ربِّها. قالَ : قلتُ : يا رسولَ اللهِ ! فأيُّ الصَّدقةِ أفضَلُ ؟ قال : جُهدٌ مِن مُقِلٍّ يُسَرُّ إلى فقيرٍ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ آيةٍ مِمَّا أنزلَ اللهُ عزَّ وجلَّ عليكَ أعظَمُ ؟ قال : آيةُ الكُرسيِّ. ثُمَّ قالَ : يا أبا ذَرٍّ ! ما السَّماواتُ السَّبعُ معَ الكُرسيِّ إلا كَحلقَةٍ مُلقاةٍ بأرضِ فلاةٍ، وفَضلُ العَرشِ على الكُرسيِّ كفَضلِ الفَلاةِ علَى الحَلقَةِ. قلتُ : يا رسولَ اللهِ ! كم الأنبياءُ ؟ قال : مائةُ ألفٍ وأربعةٌ وعِشرونَ ألفًا. قلتُ : يا رسولَ اللهِ ! كم الرُّسلِ ؟ قالَ : ثلاثُمائةٍ وثلاثَةُ عشرَ جَمًّا غفيرًا. قلتُ : كثيرٌ طيِّبٌ، قلتُ : يا رسولَ اللهِ ! مَن كان أوَّلُهمْ ؟ قال : آدَمُ. قلتُ : يا رسولَ اللهِ ! أنَبيٌّ مُرسَلٌ ؟ قال : نعَم، خلقَهُ اللهُ بيدِهِ، ونفخَ فيهِ مِن روحِهِ، ثُمَّ سوَّاهُ قِبَلًا. وقال أحمدُ بنُ أنَسٍ ثُمَّ كلَّمهُ قِبَلًا. ثُمَّ قالَ : يا أبا ذَرٍّ ! أربعةٌ سُريانيُّونَ؛ آدَمُ، وشيثُ، وخَنوخُ - وهو إدريسُ، وهم أوَّلُ مَن خطَّ بالقلَمِ - ونوحٌ. وأربعةٌ من العَربِ؛ هودٌ، وصالِحٌ، وشُعَيبٌ، ونبيُّكَ يا أبا ذَرٍّ. قال : قلتُ : يا رسولَ اللهِ ! كَم كتابٌ أنزلَهُ اللَّهُ تعالى ؟ قال : مائةُ كتابٍ وأربعةُ كتُبٍ، أنزلَ علَى شيثَ خَمسونَ صحيفَةً، وأنزلَ علَى خَنوخَ ثلاثونَ صَحيفةً، وأنزلَ على إبراهيمَ عشرَ صحائفَ، وأنزلَ على موسَى قبلَ التَّوراةِ عَشرَ صحائفَ، وأنزلَ التَّوراةَ والإنجيلَ والزَّبورَ والفُرقانَ. قال : قلتُ : يا رسولَ اللهِ ! فَما كانَت صُحفُ إبراهيمَ ؟ قالَ : كانَت أمثالًا كلُّها : أيُّها الملِكُ المسلَّطُ المبتَلَى المغرورُ، فإنِّي لم أبعثْكَ لتجمَعَ الدُّنيا بعضَها إلى بعضٍ، ولكن بعثتُكَ لترُدَّ عنِّي ",["دعوةَ المظلومِ",1],"، ",["فإنِّي لا أردُّها ولَو كانَت مِن كافِرٍ",2],". وكانَت فيها أمثالٌ : علَى العاقِلِ ما لَم يكُن مغلوبًا علَى عقلِهِ أن تكونَ له ساعاتٌ؛ ساعَةٌ يُناجي فيها ربَّهُ عزَّ وجلَّ، وساعةٌ يحاسِبُ فيها نفسَهُ، وساعَةٌ يفكِّرُ فيها في صُنعِ اللَّهِ عزَّ وجلَّ، وساعةٌ يخلو فيها بحاجتِهِ من المطعَمِ والمشرَبِ، وعلى العاقلِ أن لا يكون ظاعِنًا إلَّا لثلاثٍ؛ تزوُّدٍ لمعادٍ، أو مرمَّةٍ لمعاشٍ، أو لذَّةٍ في غيرِ محرَّمٍ، وعلى العاقِلِ أن يكونَ بصيرًا بزمانِهِ، مقبِلًا على شأنِهِ، حافِظًا للسانِهِ، ومن حسَبَ كلامَهُ من عمَلِهِ قلَّ كلامُهُ إلا فيما يعنيهِ. قلتُ : يا رسولَ اللَّهِ ! فما كان صحُفُ موسَى عليهِ السَّلامُ ؟ قال : كانَت عبرًا كلَّها، عجبتُ لمن أيقنَ بالموتِ ثُمَّ هو يفرَحُ، عجبتُ لمن أيقنَ بالنَّارِ وهو يضحَكُ، عجبتُ لمن أيقنَ للقدرِ ثم هو ينصَبُ، عجبتُ لمن رأى الدُّنيا وتقلُّبَها ثُمَّ اطمأنَّ إليها، عجِبتُ لمن أيقنَ بالحسابِ غدًا ثُمَّ لا يعمَلُ. قلتُ : يا رسولَ اللهِ ! أوصِني. قال : أوصيكَ بتقوى اللهِ فإنَّهُ رأسُ الأمرِ كلِّهِ، قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بتلاوَةِ القرآنِ فإنَّهُ نور لكَ في الأرضِ وذكرٌ لكَ في السَّماءِ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : إيَّاكَ وكثرةَ الضَّحِكِ فإنَّهُ يُميتُ القَلبَ، ويَذهَبُ بنورِ الوَجهِ، قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : عليكَ بالصَّمتِ إلَّا مِن خيرٍ، فإنَّهُ مطردَةٌ للشَّيطانِ عنكَ، وعونٌ لكَ علَى أمر دينِكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بالجهادِ فإنَّهُ رهبانيَّةُ أمَّتي. قلتُ : يا رسولَ اللهِ ! زِدني. قال : حبُّ المساكينِ وجالِسهُم. قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : انظُر إلى مَن تحتَكَ ولا تنظُر إلى مَن فوقكَ فإنَّهُ أجدَرُ أن لا تَزدَري نِعمةَ اللهِ عندكَ. قلتُ : زِدني يا رسولَ اللهِ ! قال : صِلْ قرابَتَكَ وإن قَطعوكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : لا تَخَف في اللَّهِ تعالى لَومَةَ لائمٍ. قلتُ : يا رسولَ اللهِ ! زِدني. قالَ : قُل الحقَّ وإن كان مُرًّا. قلتُ : يا رسولَ اللهِ ! زِدني. قال : يردُّكَ عن النَّاسِ ما تعرفُ من نفسِكَ، ولا تجِد عليهِم فيما تأتي، وكفَى به عيبًا أن تعرِفَ من النَّاسِ ما تجهَلُ من نفسِكَ، أو تجِدُ عليهِم فيما تأتي. ثُمَّ ضربَ بيدِهِ علَى صدري، فقالَ : يا أبا ذَرٍّ ! لا عقلَ كالتَّدبيرِ، ولا ورعَ كالكَفِّ، ولا حسَبَ كحُسنِ الخُلُقِ، قلتُ : يارسولَ اللهِ ! هل لي في الدُّنيا شَيءٌ مِمَّا أنزلَ اللهُ عليكَ مِمَّا كان في صحُفِ إبراهيمَ وموسَى ؟ قال : يا أبا ذَرٍّ ! اقرَأ : ? قَد أفلَحَ مَن تزَكَّى? إلى آخرِ السُّورَةِ]"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مطولاً أحمد (21415)، والبزار (3966) باختلاف يسير، وابن حبان (361) واللفظ له","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"wZID7EAR"},{"id":"س-00044","fp":"a594b537964e","stateId":321,"easy":"إذا كنت مظلوماً ← تُستجاب دعوتك","cause":"المظلومَ","result":"ثلاثةٌ تُستَجابُ دَعوتُهم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-00032","ref":"كشف اللثام 3/406","text":[["ثلاثةٌ تُستَجابُ دَعوتُهم",2]," فذكَر منهم: ",["المظلومَ",1]],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (17436)، والطبراني (17/340) (939)، والخطيب في ((تاريخ بغداد)) (12/380) مطولاً","bab":"آداب الدعاء › استجابة الدعاء","dorar":"9UFjk7OQ"},{"id":"س-03125","fp":"fb6f45f8e2bd","stateId":322,"easy":"إذا كنت والداً أو مسافراً أو مظلوماً ← تُستجاب دعوتك","cause":"الوالدُ والمُسافرُ والمَظلومُ","result":"تستجابُ دعوتُهُمُ","explicit":true,"repOf":"س-00016","ref":"صحيح ابن خزيمة 4/ 190","text":["غَيرتانِ إحداهُما يحبُّها اللَّهُ، والأُخرَى يبغضُها اللَّهُ: الغيرةُ في الرِّيبةِ يُحبُّها اللَّهُ والغَيرةُ في غيرِ ريبةٍ يبغضُها اللَّهُ، والمَخيلةُ إذا تَصدَّقَ الرَّجلُ يُحبُّها اللَّهُ، والمَخيلةُ في الكبرِ يُبغِضُها اللَّهُ. وقالَ: ثلاثةٌ ",["تستجابُ دعوتُهُمُ",2],"، ",["الوالدُ والمُسافرُ والمَظلومُ",1]," وقالَ: إنَّ اللَّهَ يدخلُ الجنَّةَ بالسَّهمِ الواحدِ ثلاثةً، صانعَهُ والممدَّ بِهِ، والرَّاميَ بِهِ في سَبيلِ اللَّهِ"],"grade":"صحيح","narrator":"عقبة بن عامر الجهني","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (17398)، والروياني في ((المسند)) (186)، والحاكم (1525) واللفظ لهم.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"CFBRAfYL","merged":3,"otherRefs":["كشف الخفاء 1/488 (صحيح)","صحيح الجامع 3049 (حسن)"]},{"id":"س-02836","fp":"9e3aa7a91f44","stateId":322,"easy":"إذا كنت إماماً عادلاً ← لا تُرد دعوتك","cause":"الإمامُ العادِلُ","result":"لا تُرَدُّ دَعوَتُه","explicit":true,"ref":"تخريج المسند لشعيب 9725","srcLabel":"الترمذي","text":[["الإمامُ العادِلُ ",1],["لا تُرَدُّ دَعوَتُه",2],"."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه الترمذي (3598)، وابن ماجه (1752) مطولاً باختلاف يسير، وأحمد (9725) واللفظ له","bab":"إيمان › الوعد","dorar":"2HpDJ7gV"},{"id":"س-08383","fp":"e29a31820dc3","stateId":322,"easy":"إذا كنت ضعيفاً متضعفاً ذا ثياب بالية ← لو أقسمت على الله لأبرّك","cause":"ضَعيفٍ مُتضَعِّفٍ ذي طِمْرَينِ","result":"لو أقسَمَ على اللهِ لأبَرَّ قَسَمَه","explicit":true,"star":true,"otherNeedIds":[43],"ref":"المستدرك على الصحيحين 5364","srcLabel":"الترمذي","text":["كم مِن ",["ضَعيفٍ مُتضَعِّفٍ ذي طِمْرَينِ",1],"، ",["لو أقسَمَ على اللهِ لأبَرَّ قَسَمَه",2],"، منهمُ البَراءُ بنُ مالِكٍ، وإنَّ البَراءَ لَقِيَ بَعضًا منَ المُشرِكينَ وقد أوجَعَ المُشرِكونَ في المُسلِمينَ، فقالوا: يا بَراءُ، إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قالَ: إنَّكَ لو أقسَمْتَ على اللهِ لأبَرَّكَ، فأقسِمْ على ربِّكَ، فقالَ: أقسَمْتُ عليكَ يا ربِّ لَما منَحْتَنا أكْتافَهم، ثمَّ الْتقَوْا على قَنطَرةِ السُّوسِ، فأوْجَعوا في المُسلِمينَ، فقالوا له: يا بَراءُ، أقسِمْ على ربِّكَ، فقالَ: أقسَمْتُ عليكَ يا ربِّ لَما منَحْتَنا أكْتافَهم، وألْحَقْتَني بنَبيِّي صلَّى اللهُ عليه وسلَّمَ، فمُنِحوا أكْتافَهم، وقُتِلَ البَراءُ شَهيدًا."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (10001) واللفظ له، والترمذي (3854)، وأبو يعلى (3987) دون ذكر القصة","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"LSm6jiBz","merged":6,"otherRefs":["تخريج الإحياء للعراقي 3/341 (صحيح)","الجامع الصغير 4385 (صحيح)","الأحاديث المختارة 1881 (صحيح)","الأحاديث المختارة 1882 (صحيح)","الأحاديث المختارة 2659 (صحيح)"]},{"id":"س-00016","fp":"2f631eb06885","stateId":322,"easy":"إذا كنت مظلوماً أو مسافراً أو والداً تدعو لولدك ← فدعوتك مستجابة لا شك فيها","cause":"دعوةُ المظلومِ، ودعوةُ المُسافِرِ، ودعوةُ الوالِدِ لولَدِه","result":"ثلاثُ دعَواتٍ مُستجاباتٌ لا شكَّ فيهنَّ","explicit":true,"similar":["س-03125","س-00004"],"ref":"الفتح الرباني 1/402","srcLabel":"أبو داود","text":["حديث  دعاءِ الوالِدينِ لولدِهما [يعني حديث: ",["ثلاثُ دعَواتٍ مُستجاباتٌ لا شكَّ فيهنَّ",2],":",[" دعوةُ المظلومِ، ودعوةُ المُسافِرِ، ودعوةُ الوالِدِ لولَدِه.]",1]],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1536)، وابن ماجة (3862)، وأحمد (7510) بنحوه تامًا.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"HiShfgEd","merged":5,"otherRefs":["صحيح الجامع 3030 (صحيح)","تخريج المسند لشعيب 9606 (حسن)","الأحاديث المختارة 2057 (صحيح)","صحيح الترغيب 2226 (حسن)"]},{"id":"س-00004","fp":"3d20f389b62b","stateId":322,"easy":"إذا كنت مظلوماً أو مسافراً أو والداً ← فدعوتك مستجابة لا شك فيها","cause":"لا شَكَّ فيهِنَّ : دَعْوَةُ المَظْلومِ ، و دَعْوَةُ المُسافِرِ ، و دَعْوَةُ الوالدينِ على ولدِهِما","result":"ثلاثُ دَعَوَاتٍ مُسْتَجَاباتٌ لهُنَّ","explicit":true,"repOf":"س-00016","ref":"صحيح الأدب المفرد 24","text":[["ثلاثُ دَعَوَاتٍ مُسْتَجَاباتٌ لهُنَّ ",2],"،",[" لا شَكَّ فيهِنَّ : دَعْوَةُ المَظْلومِ ، و دَعْوَةُ المُسافِرِ ، و دَعْوَةُ الوالدينِ على ولدِهِما",1]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه أبو داود (1536)، والترمذي (1905)، وابن ماجه (3862)، وأحمد (7501) باختلاف يسير، والبخاري في ((الأدب المفرد)) (32) واللفظ له","bab":"آداب الدعاء › استجابة الدعاء","dorar":"j5QL24UG"},{"id":"س-04450","fp":"e378026451f8","stateId":322,"easy":"إذا غزوت أو حججت أو اعتمرت ← فأنت من وفد الله","cause":"الغازي ، والحاجُّ ، والمعتَمِرُ","result":"وفدُ اللَّهِ عزَّ وجلَّ ثلاثةٌ","explicit":true,"similar":["س-00061"],"otherNeedIds":[26],"ref":"صحيح النسائي 3121","srcLabel":"النسائي","text":[["وفدُ اللَّهِ عزَّ وجلَّ ثلاثةٌ",2]," : ",["الغازي ، والحاجُّ ، والمعتَمِرُ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (2625)، وابن خزيمة (2511) واللفظ لهما، وابن حبان (3692) باختلاف يسير.","bab":"جهاد › فضل الجهاد","dorar":"CaCk2HvU","merged":3,"otherRefs":["الأحكام الوسطى 2/257 (صحيح)","صحيح الترغيب 1109 (صحيح)"]},{"id":"س-08212","fp":"940aaaa12de7","stateId":322,"easy":"إذا كنت إماماً عادلاً أو صائماً حين تفطر أو مظلوماً ← لا تُرد دعوتك","cause":"الإمامُ العادلُ ، والصَّائمُ حينَ يُفطرُ ، ودعوةُ المظلومِ يرفعُها فوقَ الغمامِ ، وتُفتَّحُ لَها أبوابُ السَّماءِ ، ويقولُ الرَّبُّ تبارك وتعالى : وعزَّتي لأنصرنَّكِ ولو بعدَ حينٍ","result":"ثلاثٌ لا تُرَدُّ دعوتُهُم","explicit":true,"similar":["س-00028"],"ref":"صحيح الترمذي 2526","srcLabel":"الترمذي","text":["قُلنا يا رسولَ اللَّهِ : ما لَنا إذا كنَّا عندَكَ رقَّت قلوبُنا ، وزَهِدنا في الدُّنيا ، وَكُنَّا من أَهْلِ الآخرةِ ، فإذا خَرجنا من عِندِكَ فآنَسنا أَهالينا ، وشَمِمنا أولادَنا أنكَرنا أنفسَنا فقالَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ : لو أنَّكم تَكونونَ إذا خرجتُمْ من عندي كنتُمْ على حالِكُم ذلِكَ لزارتْكمُ الملائِكَةُ في بيوتِكُم ، ولو لم تُذنِبوا لجاءَ اللَّهُ بخَلقٍ جديدٍ كي يُذنِبوا فيغفرَ لَهُم قالَ : قلتُ يا رسولَ اللَّهِ ممَّ خُلِقَ الخلقُ ؟ قالَ : منَ الماءِ ، قلتُ : الجنَّةُ ما بناؤُها ؟ قالَ : لبِنةٌ من فضَّةٍ ولبنةٌ من ذَهَبٍ ، وملاطُها المسكُ الأذفرُ ، وحصباؤُها اللُّؤلؤُ والياقوتُ ، وتُربتُها الزَّعفرانُ مَن دخلَها ينعَمُ ولا يبأسُ ، ويخلدُ ولا يموتُ ، لا تبلَى ثيابُهُم ، ولا يفنى شَبابُهُم ثمَّ قالَ : ",["ثلاثٌ لا تُرَدُّ دعوتُهُم ",2],"،",[" الإمامُ العادلُ ، والصَّائمُ حينَ يُفطرُ ، ودعوةُ المظلومِ يرفعُها فوقَ الغمامِ ، وتُفتَّحُ لَها أبوابُ السَّماءِ ، ويقولُ الرَّبُّ تبارك وتعالى : وعزَّتي لأنصرنَّكِ ولو بعدَ حينٍ .",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح دون قوله مم خلق الخلق","takhrij":"أخرجه الترمذي (2526)، وأحمد (8043) باختلاف يسير.","bab":"ملائكة › أعمال الملائكة","dorar":"UXjjPkwr","merged":3,"otherRefs":["الصحيح المسند 2/366 (صحيح)","الزواجر عن اقتراف الكبائر 1/197 (صحيح)"]},{"id":"س-00010","fp":"0995b438e617","stateId":322,"easy":"إذا تقربت إلى الله بالنوافل ← إن سألته أعطاك وإن دعوته أجابك","cause":"يتقرَّبُ إليَّ بالنَّوافلِ","result":"إنَّ سألني أعطيتُهُ وإن دعاني أجبتُهُ","explicit":true,"otherNeedIds":[25],"ref":"مجمع الزوائد 2/250","srcLabel":"أحمد","text":["من آذى وليًّا فقدِ استحلَّ محاربتي وما تقرَّبَ إليَّ عبدي بمثلِ الفرائضِ وما يزالُ العبدُ ",["يتقرَّبُ إليَّ بالنَّوافلِ",1]," حتَّى أحبَّهُ ",["إنَّ سألني أعطيتُهُ وإن دعاني أجبتُهُ",2]," وما تردَّدتُ عن شيءٍ أنا فاعلُهُ تردُّدي عن وفاتِهِ لأنَّهُ يكرَهُ الموتَ وأكرَهُ مساءتَهُ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"فيه عبد الواحد بن قيس وبقية رجاله رجال الصحيح","takhrij":"أخرجه أحمد (26193)، وابن أبي الدنيا في ((الأولياء)) (45)، والبزار (99) باختلاف يسير","bab":"آداب الدعاء › استجابة الدعاء","dorar":"63PS0rcn"},{"id":"س-00028","fp":"2a77d9be9c59","stateId":322,"easy":"إذا كنت صائماً حتى تفطر أو إماماً عادلاً أو مظلوماً ← لا تُرد دعوتك","cause":"الصَّائمُ حتَّى يُفْطِرَ، وإمامٌ عدلٌ، ودَعوةُ المظلومِ يَرفعُها اللَّهُ فَوقَ الغمامِ، ويفتحُ لَها أبوابَ السَّمواتِ، فيقولُ الرَّبُّ عزَّ وجلَّ: وعِزَّتي لأنصرنَّكَ ولَو بعدَ حينٍ","result":"ثلاثةٌ لا تردُّ دعوتُهُمُ","explicit":true,"repOf":"س-08212","ref":"صحيح ابن خزيمة 3/ 352","text":[["ثلاثةٌ لا تردُّ دعوتُهُمُ",2],":",[" الصَّائمُ حتَّى يُفْطِرَ، وإمامٌ عدلٌ، ودَعوةُ المظلومِ يَرفعُها اللَّهُ فَوقَ الغمامِ، ويفتحُ لَها أبوابَ السَّمواتِ، فيقولُ الرَّبُّ عزَّ وجلَّ: وعِزَّتي لأنصرنَّكَ ولَو بعدَ حينٍ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الترمذي (3598)، وابن ماجة (1752)، وأحمد (9743) واللفظ لهم.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"w0maom5R"},{"id":"س-00061","fp":"bc5e0801a4d5","stateId":322,"easy":"إذا غزوت أو حججت أو اعتمرت ← فأنت من وفد الله، دعاك فأجبت وتسأله فيعطيك","cause":"الغازي في سبيلِ اللهِ عزَّ وجلَّ ، والحاجُّ ، والمعتمِرُ","result":"وفْدُ اللهِ دعاهم فأجابوهٌ ، وسألُوهُ فأعطاهم","explicit":true,"repOf":"س-04450","otherNeedIds":[26],"ref":"صحيح الجامع 4171","text":[["الغازي  في سبيلِ اللهِ عزَّ وجلَّ ، والحاجُّ ، والمعتمِرُ",1]," ، ",["وفْدُ اللهِ دعاهم فأجابوهٌ ، وسألُوهُ فأعطاهم",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجة (2893 )، وابن حبان (4613 )، والطبراني في ((المعجم الكبير)) (12/ 422) (13556 )","bab":"آداب الدعاء › استجابة الدعاء","dorar":"OXT47ThE"},{"id":"س-00067","fp":"56f610b15f4b","stateId":322,"easy":"إذا دعا لك والدك ← يصل دعاؤه إلى الحجاب (مستجاب)","cause":"دعاءُ الوالدِ","result":"يُفضي إلى الحجابِ","explicit":true,"otherNeedIds":[37],"ref":"الترغيب والترهيب 2/398","srcLabel":"ابن ماجه","text":[["دعاءُ الوالدِ",1]," ",["يُفضي إلى الحجابِ",2]],"grade":"صحيح","narrator":"أم حكيم بنت وادع الخزاعية","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن ماجه (3863)، والطبراني (25/ 163) (394) واللفظ لهما، والبيهقي في ((الشعب)) (8981)، والدارمي في ((نقضه على المريسي)) (188) باختلاف يسير.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"98Uv38rP"},{"id":"س-00074","fp":"817fa970e741","stateId":322,"easy":"إذا دعوت عند فطرك وأنت صائم ← لا تُرد دعوتك","cause":"للصائمِ عند فطرِهِ","result":"دعوةٌ ما تُرَدُّ","explicit":true,"similar":["س-06744"],"ref":"تحفة المحتاج 2/97","srcLabel":"ابن ماجه","text":["إنَّ ",["للصائمِ عند فطرِهِ",1]," ",["دعوةٌ ما تُرَدُّ",2]," وكان ابنُ عمرو إذا أفطرَ يقولُ اللهمَّ إني أسألكَ برحمتكَ التي وَسِعَتْ كلَّ شيٍء أن تغفرَ لي ذنوبي"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح أو حسن [كما اشترط على نفسه في المقدمة]","takhrij":"أخرجه ابن ماجه (1753)، والحاكم (1535)، والبيهقي في ((شعب الإيمان)) (3904)","bab":"آداب الدعاء › استجابة الدعاء","dorar":"d0diO3aX"},{"id":"س-03302","fp":"ad016e377b6e","stateId":322,"easy":"إذا حججت أو اعتمرت ← فأنت من وفد الله، إن دعوته أجابك وإن استغفرته غفر لك","cause":"الحُجَّاجُ والعُمَّارُ","result":"وفدُ اللهِ إن دعَوْه أجابهم وإن استغفروه غفر لهم","explicit":true,"otherNeedIds":[11],"ref":"الترغيب والترهيب 2/169","srcLabel":"الطبراني","text":[["الحُجَّاجُ والعُمَّارُ",1]," ",["وفدُ اللهِ إن دعَوْه أجابهم وإن استغفروه غفر لهم",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن ماجة(2892 )، والطبراني في ((الأوسط)) (6311 )","bab":"استغفار › أسباب المغفرة","dorar":"bss6NSuQ"},{"id":"س-06744","fp":"644bd575092e","stateId":322,"easy":"إذا دعوت عند فطرك وأنت صائم ← لا تُرد دعوتك","cause":"للصائمِ عندَ فِطرِه","result":"لَدعوةً ما تُرَدُّ","explicit":true,"repOf":"س-00074","ref":"إتحاف الخيرة المهرة 3/102","text":["إنَّ ",["للصائمِ عندَ فِطرِه",1]," ",["لَدعوةً ما تُرَدُّ",2]," قال سمِعتُ عبدَ اللهِ يقولُ عندَ فِطرِه : اللهم إني أسألُكَ برحمتِكَ التي وسِعَتْ كلَّ شيءٍ أن تغفِرَ لي  - زاد في روايةٍ : ذُنوبي"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح،  وله شاهد","takhrij":"أخرجه ابن ماجه (1753)، والحاكم (1535)، والبيهقي في ((شعب الإيمان)) (3904)","bab":"صيام › فضل الصيام","dorar":"wy24USjN"},{"id":"س-06868","fp":"073b452de4c7","stateId":322,"easy":"إذا شبت ملازماً للسنة ثم سألت الله ← يستحيي أن يردك","cause":"ذِي الشَّيْبَةِ لُزُومًا لِلسُّنَّةِ أَنْ يَسْأَلَهُ شَيْئًا","result":"إِنَّ اللهَ تعالى يَسْتَحْيِي مِنْ ذِي الشَّيْبَةِ لُزُومًا لِلسُّنَّةِ أَنْ يَسْأَلَهُ شَيْئًا فَلَا يُعْطِيهِ","explicit":true,"ref":"تخريج كتاب السنة 23","srcLabel":"ابن أبي عاصم","text":[["إِنَّ اللهَ تعالى يَسْتَحْيِي مِنْ ذِي الشَّيْبَةِ لُزُومًا لِلسُّنَّةِ أَنْ يَسْأَلَهُ شَيْئًا فَلَا يُعْطِيهِ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"x9K7TCw7"},{"id":"س-00901","fp":"74c871d0fd50","stateId":322,"easy":"إذا أكثرت ذكر الله أو كنت مظلوماً أو إماماً مقسطاً ← لا يرد الله دعاءك","cause":"الذاكرُ اللهَ كثيرًا ، ودعوةُ المظلومِ ، والإمامُ الْمُقسِطُ","result":"ثلاثةٌ لا يَرُدُّ اللهُ دُعاءَهم","explicit":true,"similar":["س-00913"],"ref":"السلسلة الصحيحة 3374","srcLabel":"الطبراني","text":[["ثلاثةٌ لا يَرُدُّ اللهُ دُعاءَهم ",2],":",[" الذاكرُ اللهَ كثيرًا ، ودعوةُ المظلومِ ، والإمامُ الْمُقسِطُ",1]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن رجاله ثقات","takhrij":"أخرجه البزار (8751) باختلاف يسير، والطبراني في ((الدعاء)) (1316)، والبيهقي في ((شعب الإيمان)) (588) واللفظ لهما.","bab":"أدعية وأذكار › فضل الذكر","dorar":"6BGf62p6"},{"id":"س-00045","fp":"74bf6ba77025","stateId":322,"easy":"إذا كنت من عتقاء الله في رمضان ← فلك دعوة مستجابة","cause":"إنَّ للهِ عُتَقاءَ في كُلِّ يَوْمٍ ولَيلَةٍ","result":"لكُلِّ عَبْدٍ مِنهم دَعْوَةٌ مُستَجابَةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"apply":{"k":"time","t":"في رمضان"},"otherNeedIds":[66],"ref":"تخريج المسند لشعيب 7450","srcLabel":"الترمذي","text":[["إنَّ للهِ عُتَقاءَ في كُلِّ يَوْمٍ ولَيلَةٍ",1],"، ",["لكُلِّ عَبْدٍ مِنهم دَعْوَةٌ مُستَجابَةٌ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الترمذي (682)، وابن ماجه (1642) أوله في أثناء حديث. من حديث أبي هريرة، وأحمد (7450) واللفظ له","bab":"آداب الدعاء › استجابة الدعاء","dorar":"jITEPVtG"},{"id":"س-00913","fp":"f40a555209fa","stateId":322,"easy":"إذا ذكرت الله كثيراً أو كنت مظلوماً أو إماماً عادلاً ← لا يُرد دعاؤك","cause":"ثلاثةٌ","result":"لا يُردُّ دعاؤُهم الذاكرُ للهِ كثيرًا ودعوةُ المظلومِ ودعوةُ الإمامِ المقسطِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-00901","ref":"تخريج فضيلة العادلين 133","text":[["ثلاثةٌ ",1],["لا يُردُّ دعاؤُهم الذاكرُ للهِ كثيرًا ودعوةُ المظلومِ ودعوةُ الإمامِ المقسطِ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"رجاله موثقون","takhrij":"أخرجه البزار (8751)، والطبراني في ((الدعاء)) (1316)، والبيهقي في ((شعب الإيمان)) (588) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"LVVmdgSM"},{"id":"س-01600","fp":"f784725a4fbd","stateId":323,"easy":"إذا أطعمت الصالحين ← تنالك دعوتهم بالبركة","cause":"فلمَّا طعِموا دعا لهم","result":"اللَّهمَّ اغفِرْ لهم وارحَمْهم وبارِكْ لهم في رزقِهم","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"similar":["س-01597"],"otherNeedIds":[1],"ref":"تخريج صحيح ابن حبان 5299","srcLabel":"مسلم","text":["قال أبي لأمِّي: لو صنَعْتِ طعامًا لرسولِ اللهِ صلَّى اللهُ عليه وسلَّم فصنَعتْ ثريدةً وقال بيدِه هكذا يُقلِّلُها فانطلَق أبي فدعا رسولَ اللهِ صلَّى اللهُ عليه وسلَّم فوضَع النَّبيُّ صلَّى اللهُ عليه وسلَّم يدَه على ذروتِها ثمَّ قال: ( خُذوا باسمِ اللهِ ) فأخَذوا مِن نواحيها ",["فلمَّا طعِموا دعا لهم",1]," قال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ( ",["اللَّهمَّ اغفِرْ لهم وارحَمْهم وبارِكْ لهم في رزقِهم",2]," )"],"grade":"صحيح","narrator":"عبدالله بن بسر","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه الدارمي (2065)، والنسائي في ((السنن الكبرى)) (6730)، وابن حبان (6640)، والحاكم (7085) واللفظ لهم.","bab":"أطعمة › إجابة الدعوة","dorar":"7UHqvs8g","merged":2,"otherRefs":["الوهم والإيهام 5/299 (صحيح)"]},{"id":"س-01597","fp":"15536192640f","stateId":323,"easy":"إذا أطعمت الصالحين ← تنالك دعوتهم بالمغفرة والبركة","cause":"فلمَّا فرَغَ من طعامِه","result":"اللَّهُمَّ اغفِرْ لهم، وارحَمْهم، وبارِكْ لهم فيما رزَقْتَهم","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"repOf":"س-01600","otherNeedIds":[1],"ref":"تخريج المسند لشعيب 17673","text":["أنَّ أباهُ صنَعَ للنبيِّ صلَّى اللهُ عليه وسلَّمَ طعامًا فدَعاهُ فأجابَه، ",["فلمَّا فرَغَ من طعامِه",1]," قال: ",["اللَّهُمَّ اغفِرْ لهم، وارحَمْهم، وبارِكْ لهم فيما رزَقْتَهم",2],"."],"grade":"صحيح","narrator":"عبدالله بن بسر","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2042)، وأبو داود (3729)، والترمذي (3576)، والنسائي في ((السنن الكبرى)) (6763)، وأحمد (17673) واللفظ له","bab":"أطعمة › إجابة الدعوة","dorar":"kCioz2BA"},{"id":"س-00020","fp":"ef73e63f7976","stateId":323,"easy":"إذا دعا لك من أحسنت إليه ← فدعاؤه لا يُرد","cause":"دعاءُ المحسَنِ إليهِ للمحسِنِ","result":"لا يُرَدُّ","explicit":true,"ref":"الجامع الصغير 4185","srcLabel":"ابن حجر","text":[["دعاءُ المحسَنِ إليهِ للمحسِنِ ",1],["لا يُرَدُّ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه ابن حجر في ((زهر الفردوس)) (1530) بلفظه.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"FRheHvcI"},{"id":"س-02754","fp":"071c282e816b","stateId":323,"easy":"إذا دخلت على مريض فاطلب منه الدعاء ← فدعاؤه كدعاء الملائكة","cause":"إذا دخَلْتَ على مَريضٍ، فمُرْهُ أنْ يدعُوَ لك","result":"فإنَّ دُعاءَه كدُعاءِ الملائكةِ","explicit":true,"ref":"الحديث لابن عبدالوهاب 2/231","srcLabel":"الحديث لابن عبدالوهاب","text":["قال لي النَّبيُّ صَلَّى اللهُ عليه وسلَّمَ: ",["إذا دخَلْتَ على مَريضٍ، فمُرْهُ أنْ يدعُوَ لك",1],"؛ ",["فإنَّ دُعاءَه كدُعاءِ الملائكةِ",2],"."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح أو حسن","bab":"إيمان › الملائكة","dorar":"5tLBtE1X"},{"id":"س-07557","fp":"1e1a4419b27d","stateId":323,"easy":"إذا دعا لك الصالحون «البس جديداً وعش حميداً ومت شهيداً» ← تنالك بركة الدعاء","cause":"البَسْ جديدًا","result":"وعِشْ حميدًا ومِتْ شهيدًا","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"apply":{"k":"say","t":"«البس جديداً وعش حميداً ومت شهيداً»"},"ref":"صحيح ابن حبان 6897","srcLabel":"ابن ماجه","text":["رأى النَّبيُّ صلَّى اللهُ عليه وسلَّم على عُمَرَ بنِ الخطَّابِ رضِي اللهُ عنه ثوبًا أبيضَ فقال : ( أجديدٌ قميصُك أم غَسيلٌ ) ؟ فقال : بلْ جديدٌ فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم : ( ",["البَسْ جديدًا",1]," ",["وعِشْ حميدًا ومِتْ شهيدًا",2]," ) \nقال عبدُ الرزَّاقِ : وزاد فيه الثَّوريُّ عن إسماعيلَ بنِ أبي خالدٍ : ( ويُعطيك اللهُ قرَّةَ العَيْنِ في الدُّنيا والآخرةِ )"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن ماجه (3558) باختلاف يسير، وأحمد (5620) مطولاً باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › دعاء النبي لبعض الناس","dorar":"MOxnTX3x","merged":3,"otherRefs":["تخريج المسند لشاكر 8/20 (صحيح)","مصباح الزجاجة 4/82 (صحيح)"]},{"id":"س-07393","fp":"f58f261cad18","stateId":323,"easy":"إذا وفّيت الناس حقوقهم ← يوفّيك الله","cause":"فقضى الأعرابيَّ وأطعمَهُ","result":"أوفيتَ أوفى اللَّهُ لَكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مصباح الزجاجة 3/68","srcLabel":"ابن ماجه","text":["عن أبي سعيد الخدري قال جاءَ أعرابيٌّ إلى النَّبيِّ صلَّى اللَّهُ عليْهِ وسلَّمَ يتقاضاهُ دَينًا كانَ عليْهِ فاشتدَّ عليْهِ حتَّى قالَ لَهُ أحرِّجُ عليْكَ إلَّا قضَيتَني فانتَهرَهُ أصحابُهُ وقالوا ويحَكَ تدري من تُكلِّمُ قالَ إنِّي أطلبُ حقِّي فقالَ النَّبيُّ صلَّى اللَّهُ عليْهِ وسلَّمَ هلَّا معَ صاحبِ الحقِّ كنتُم ثمَّ أرسلَ إلى خَولةَ بنتِ قيسٍ فقالَ لَها إن كانَ عندَكِ تمرٌ فأقرِضينا حتَّى يأتيَنا تمرُنا فنَقضِيَك فقالت نعَم بأبي أنتَ يا رسولَ اللَّهِ قالَ فأقرضَتْهُ ",["فقضى الأعرابيَّ وأطعمَهُ",1]," فقالَ ",["أوفيتَ أوفى اللَّهُ لَكَ",2]," فقالَ أولئِكَ خيارُ النَّاسِ إنَّهُ لا قُدِّست أمَّةٌ لا يأخذُ الضَّعيفُ فيها حقَّهُ غيرَ متَعتَعٍ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (2426) واللفظ له، وأبو يعلى  (1091) ، وابن أبي شيبة (22105) مختصرا","bab":"فضائل النبي وصفته ودلائل النبوة › أخلاق النبي","dorar":"lkaTbyFP"},{"id":"س-08266","fp":"04ccce25cefd","stateId":324,"easy":"إذا صليت على محمد وأهل بيته ← يُرفع دعاؤك (وإلا فهو محجوب)","cause":"حتَّى يصلِّيَ على محمَّدٍ وأهلِ بيتِهِ","result":"الدُّعاءُ محجوبٌ عن اللَّهِ","explicit":true,"repOf":"س-00041","ref":"الجامع الصغير 4250","text":[["الدُّعاءُ محجوبٌ عن اللَّهِ",2]," ",["حتَّى يصلِّيَ على محمَّدٍ وأهلِ بيتِهِ",1]],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (721 )،و أبو احمد الحاكم في ((شعار أصحاب الحديث)) (86 )،والبيهقي في ((شعب الإيمان)) (1474 ) موقوفا .    وأخرجه البيهقي في ((شعب الإيمان)) (1475 ) مرفوعا","bab":"مناقب وفضائل › أهل البيت صلوات الله عليهم","dorar":"fknkjWSK"},{"id":"س-00041","fp":"e17d151aa227","stateId":324,"easy":"إذا صليت على محمد وآل محمد ← يُرفع دعاؤك (وكل دعاء محجوب حتى يُصلّى عليه)","cause":"يصلِّى على محمَّدٍ وآلِ محمَّدٍ","result":"كل دُعاءٍ محجوبٌ حتَّى","explicit":true,"similar":["س-08266","س-00077"],"ref":"صحيح الترغيب 1675","srcLabel":"الطبراني","text":["عن عليٍّ رضيَ اللهُ عنهُ قال : ",["كل دُعاءٍ محجوبٌ حتَّى",2]," ",["يصلِّى على محمَّدٍ [ وآلِ محمَّدٍ",1]," ] ."],"grade":"صحيح","narrator":"[عاصم بن ضمرة]","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني في ((الأوسط)) (721) بلفظه، والبيهقي في ((الشعب)) (1474)، وأبو عبد الله التميمي في ((تلقيح العقول)) (573) باختلاف يسير.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"Z1qrTOb0"},{"id":"س-00054","fp":"1b19a9a5fd03","stateId":324,"easy":"إذا بدأت بالثناء على الله ثم الصلاة على النبي ﷺ ثم دعوت ← سل تُعطه","cause":"بدأتُ بالثَّناءِ على اللهِ ، ثم الصلاةُ على النَّبيِّ صلَّى اللهُ عليه وسلَّمَ ، ثم دعوتُ لنفْسي","result":"سَلْ تُعطَهْ","explicit":true,"similar":["س-00057","س-00091","س-00103","س-00105","س-00078","س-06213"],"ref":"سنن الترمذي 593","srcLabel":"أحمد","text":["كنتُ أُصلِّي والنبيُّ صلَّى اللهُ عليه وسلَّمَ ، وأبو بكرٍ ، وعمرُ معه ، فلما جلستُ ",["بدأتُ بالثَّناءِ على اللهِ ، ثم الصلاةُ على النَّبيِّ صلَّى اللهُ عليه وسلَّمَ ، ثم دعوتُ لنفْسي",1]," ، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ : ( ",["سَلْ تُعطَهْ",2]," . سَلْ تُعطَه )"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"حسن صحيح","takhrij":"أخرجه أحمد (3662) بنحوه مطولاً، وأبو يعلى (5059)، والضياء في ((الأحاديث المختارة)) (13) باختلاف يسير","bab":"آداب الدعاء › استجابة الدعاء","dorar":"ZVFHjW6j"},{"id":"س-00057","fp":"64aebce8fa7e","stateId":324,"easy":"إذا حمدت الله وصليت على النبي ﷺ ثم دعوت ← تُجب","cause":"فحمدَ اللَّهَ وصلَّى على النَّبيِّ","result":"ادعُ تُجَب","explicit":true,"repOf":"س-00054","ref":"صحيح الترمذي 3476","text":["بينا رسولُ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّمَ قاعدٌ إذ دخلَ رجلٌ فصلَّى فقال: اللَّهمَّ اغفر لي وارحمني، فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّم: عجِلتَ أيُّها المصلِّي، إذا صلَّيتَ فقعدتَ فاحمَدِ اللَّهَ بما هوَ أَهلُه، وصلِّ عليَّ ثمَّ ادعُه. قال: ثمَّ صلَّى رجلٌ آخرُ بعدَ ذلِكَ ",["فحمدَ اللَّهَ وصلَّى على النَّبيِّ",1]," صلَّى اللَّهُ عليْهِ وسلَّمَ فقالَ لَهُ النَّبيُّ صلَّى اللَّهُ عليْهِ وسلَّم: أيُّها المصلِّي ",["ادعُ تُجَب",2]],"grade":"صحيح","narrator":"فضالة بن عبيد","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1481)، والترمذي (3476) واللفظ له، والنسائي (1284)، وأحمد (23982)","bab":"آداب الدعاء › استجابة الدعاء","dorar":"bi0rfBNA"},{"id":"س-00077","fp":"b0df84a5b5dd","stateId":324,"easy":"إذا صليت على النبي ﷺ ← يصعد دعاؤك (فهو موقوف حتى تصلي عليه)","cause":"تصلِّيَ على نبيِّك","result":"الدُّعاءَ موقوفٌ بين السَّماءِ والأرضِ لا يصعدُ منه شيءٌ حتَّى","explicit":true,"repOf":"س-00041","ref":"الترغيب والترهيب 2/406","text":["عن عمرَ بنِ الخطَّابِ قال إنَّ ",["الدُّعاءَ موقوفٌ بين السَّماءِ والأرضِ لا يصعدُ منه شيءٌ حتَّى",2]," ",["تصلِّيَ على نبيِّك",1]," صلَّى اللهُ عليه وسلَّم"],"grade":"صحيح","narrator":"سعيد بن المسيب","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (486) واللفظ له، وإسحاق بن راهويه كما في ((المطالب العالية)) (3321) باختلاف يسير.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"sJWEG0pQ"},{"id":"س-00091","fp":"30b6be11d099","stateId":324,"easy":"إذا بدأت دعاءك بالحمد والثناء والصلاة على النبي ﷺ ← فهو من أسباب الإجابة","cause":"البَداءةَ بالحمدِ للهِ والثناءِ عليه والصلاةِ على النبيِّ","result":"من أسبابِ الاستجابةِ","explicit":true,"repOf":"س-00054","ref":"مجموع فتاوى ابن باز 26/125","text":["[حديثُ أنَّ] ",["البَداءةَ بالحمدِ للهِ والثناءِ عليه والصلاةِ على النبيِّ",1]," صلَّى اللهُ عليهِ وسلَّمَ ",["من أسبابِ الاستجابةِ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"آداب الدعاء › استجابة الدعاء","dorar":"Gn2UWnsM"},{"id":"س-00103","fp":"e97fddb36509","stateId":324,"easy":"إذا مجّدت الله وحمدته وصليت على النبي ﷺ ← ادعُ تُجب وسل تُعط","cause":"فمجَّد اللهَ ، وحمِدَه ، وصلَّى على النبيِّ","result":"ادعُ ، تُجَبْ ، وسَلْ ، تُعطَ","explicit":true,"repOf":"س-00054","ref":"أصل صفة الصلاة 3/990","text":["سمِع صلَّى اللهُ عليه وسلم رجلًا يدعو في صلاتهِ لَم يمجِّدِ اللهَ تعالَى ، ولم يصلِّ على النبيِّ صلَّى اللهُ عليه وسلم ، فقال : عجِلَ هذا ، ثمَّ دعاهُ فقال له أو لغيرِه : إذا صلَّى أحدُكم ، فليبدأْ ، بتحميدِ ربِّه جلَّ وعزَّ ، والثناءِ عليه ، ثمَّ يصلِّي ، وفي روايةٍ : ليصلِّ على النبيِّ صلَّى اللهُ عليه وسلم ، ثمَّ يدعو بعدُ بما شاء . وسمِع رسولُ اللهِ صلَّى اللهُ عليه وسلم رجلًا يصلِّي ، ",["فمجَّد اللهَ ، وحمِدَه ، وصلَّى على النبيِّ",1]," صلَّى اللهُ عليه وسلم ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلم : ",["ادعُ ، تُجَبْ ، وسَلْ ، تُعطَ",2]],"grade":"صحيح","narrator":"فضالة بن عبيد","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1481)، والترمذي (3477)، وأحمد (23937) باختلاف يسير، والنسائي (1284) بنحوه","bab":"آداب الدعاء › الثناء على الله في الدعاء","dorar":"m5JNITa9"},{"id":"س-00105","fp":"fea985941f50","stateId":324,"easy":"إذا بدأت بمدح الله والثناء عليه والصلاة على النبي ﷺ ثم دعوت ← فهو أجدر أن تنجح","cause":"فليبدَأْ بمدحِه والثَّناءِ عليه بما هو أهلُه ثمَّ يُصلِّي على النَّبيِّ صلَّى اللهُ عليه وسلَّم ، ثمَّ ليسأَلْ بعدُ","result":"فإنَّه أجدرُ أن ينجحَ أو يُصيبَ","explicit":true,"repOf":"س-00054","ref":"القول البديع 320","text":["عن ابنِ مسعودٍ رضِي اللهُ عنه قال : إذا أراد أحدُكم أن يسألَ اللهَ شيئًا ",["فليبدَأْ بمدحِه والثَّناءِ عليه بما هو أهلُه ثمَّ يُصلِّي على النَّبيِّ صلَّى اللهُ عليه وسلَّم ، ثمَّ ليسأَلْ بعدُ",1]," ، ",["فإنَّه أجدرُ أن ينجحَ أو يُصيبَ",2]],"grade":"صحيح","narrator":"[أبو عبيدة عامر بن عبدالله بن مسعود]","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه النميري في ((الإعلام)) (190) واللفظ له.","bab":"آداب الدعاء › الثناء على الله في الدعاء","dorar":"NtYOBaYL"},{"id":"س-00078","fp":"c1283454ea1d","stateId":324,"easy":"إذا أثنيت على الله وصليت على النبي ﷺ ثم سألت ← سل تُعطه","cause":"فأثنيْتُ على اللهِ وصلَّيْتُ على النَّبيِّ صلَّى اللهُ عليه وسلَّم ثمَّ سألتُ حاجتي","result":"سَلْ تُعطِه","explicit":true,"repOf":"س-00054","ref":"مختصر الأحكام 3/160","text":["مرَّ بي النَّبيُّ صلَّى اللهُ عليه وسلَّم وأبو بكرٍ وعمرُ وأنا في المسجدِ أقرأُ سورةَ النِّساءِ أسحلُها سحلًا ، فاستمِعوا إليَّ وقال النَّبيُّ صلَّى اللهُ عليه وسلَّم : من سرَّه أن يقرأَ القرآنَ غضًّا فليقرَأْ على قراءةِ ابنِ أمِّ عبدٍ ، قال : ثمَّ جلستُ ",["فأثنيْتُ على اللهِ وصلَّيْتُ على النَّبيِّ صلَّى اللهُ عليه وسلَّم ثمَّ سألتُ حاجتي",1]," ، فقال : ",["سَلْ تُعطِه",2]," سَلْ تُعطِه"],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"حسن","takhrij":"أخرجه أحمد (4255)، وابن حبان (7067)، والطبراني (9/62) (8417) باختلاف يسير","bab":"آداب الدعاء › استجابة الدعاء","dorar":"OrwOFf7j"},{"id":"س-06213","fp":"203cb635baa3","stateId":324,"easy":"إذا أثنيت على الله وحمدته ثم صليت على النبي ﷺ ثم سألت ← تُعطَ","cause":"فأثْنى عَبدُ اللهِ على ربِّه وحمِدَه، فأحسَنَ في حَمدِه على ربِّه، ثمَّ سألَه فأجمَلَ المَسْألةَ","result":"سَلْ تُعطَ، سَلْ تُعطَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-00054","ref":"المستدرك على الصحيحين 5480","text":["كنْتُ معَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ ومعَه أبو بَكرٍ رَضيَ اللهُ عنه، ومَن شاءَ اللهُ مِن أصْحابِه، فمَرَرْنا بعَبدِ اللهِ بنِ مَسْعودٍ وهو يُصَلِّي، فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: مَن هذا؟ فقيلَ: عَبدُ اللهِ بنُ مَسْعودٍ، فقالَ: إنَّ عَبدَ اللهِ يَقْرأُ القُرْآنَ غَضًّا كما أُنزِلَ، ",["فأثْنى عَبدُ اللهِ على ربِّه وحمِدَه، فأحسَنَ في حَمدِه على ربِّه، ثمَّ سألَه فأجمَلَ المَسْألةَ",1],"، وسأَلَه كأحسَنِ مَسألةٍ سأَلَها عَبدٌ ربَّه، ثمَّ قالَ: اللَّهمَّ إنِّي أسألُكَ إيمانًا لا يَرتَدُّ، ونَعيمًا لا يَنفَذُ، ومُرافَقةَ مُحمَّدٍ صلَّى اللهُ عليه وسلَّمَ في أعْلى عِلِّيِّينَ في جِنانِكَ جِنانِ الخُلدِ، قالَ: وكانَ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["سَلْ تُعطَ، سَلْ تُعطَ",2]," مرَّتَينِ، فانطَلَقْتُ لأُبَشِّرَه، فوجَدْتُ أبا بَكرٍ قد سَبَقَني، وكانَ سبَّاقًا بالخَيرِ."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح الإسناد","bab":"سؤال › من تحل له المسألة","dorar":"r0CjpzBg"},{"id":"س-00011","fp":"215347343b58","stateId":325,"easy":"إذا لم تستعجل (فتقول دعوت فلم يُستجب لي) ← يُستجاب لك","cause":"ما لم يعجَلْ قيل وكيف يعجَلُ يا رسولَ اللهِ قال يقولُ قد دعوتُ اللهَ فلم يستجِبِ اللهُ لي","result":"يُستَجابُ لأحدِكم","explicit":true,"star":true,"similar":["س-00017","س-00049","س-07200","س-00042"],"otherNeedIds":[30],"ref":"صحيح ابن ماجه 3121","srcLabel":"متفق عليه","text":[["يُستَجابُ لأحدِكم",2]," ",["ما لم يعجَلْ قيل وكيف يعجَلُ يا رسولَ اللهِ قال يقولُ قد دعوتُ اللهَ فلم يستجِبِ اللهُ لي",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6340)، ومسلم (2735)، وأبو داود (1484)، وابن ماجه (3853) واللفظ له، وأحمد (10312)","bab":"آداب الدعاء › استجابة الدعاء","dorar":"Hi4w9AkX","merged":2,"otherRefs":["صحيح مسلم 2735 (صحيح)"]},{"id":"س-00017","fp":"184e52863b6a","stateId":325,"easy":"إذا لم تستعجل الإجابة وتترك الدعاء ← يُستجاب لك","cause":"ما لم يعجَلْ، فيقولُ : دعوتُ ودعوتُ فلم أرَه يُستجابُ لي، فيستحسرُ عندَ ذلك ويدعُ الدعاءَ","result":"يُستجابُ لأحدِكم","explicit":true,"repOf":"س-00011","otherNeedIds":[30],"ref":"مجموع فتاوى ابن باز 305/5","text":[["يُستجابُ لأحدِكم",2]," ",["ما لم يعجَلْ، فيقولُ : دعوتُ ودعوتُ فلم أرَه يُستجابُ لي، فيستحسرُ عندَ ذلك ويدعُ الدعاءَ",1]],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6340) بنحوه مختصراً، ومسلم (2735) واللفظ له","bab":"آداب الدعاء › استجابة الدعاء","dorar":"h7p2NKnA"},{"id":"س-05338","fp":"e64b5707fac2","stateId":325,"easy":"إذا دعوت فاعزم المسألة وعظّم الرغبة ← فلا يتعاظم الله شيء أعطاه","cause":"ليَعزِمِ المَسألةَ وليُعَظِّمِ الرَّغبةَ","result":"فإنَّ اللهَ لا يَتَعاظَمُه شيءٌ أعطاه","explicit":true,"star":true,"similar":["س-05340","س-05350"],"ref":"صحيح مسلم 2679","srcLabel":"متفق عليه","text":["إذا دَعا أحَدُكُم فلا يَقُلْ: اللهمَّ اغفِرْ لي إن شِئتَ، ولَكِن ",["ليَعزِمِ المَسألةَ وليُعَظِّمِ الرَّغبةَ",1],"؛ ",["فإنَّ اللهَ لا يَتَعاظَمُه شيءٌ أعطاه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه بنحوه البخاري (6339)، ومسلم (2679).","bab":"رقائق وزهد › التوكل واليقين","dorar":"iw0jfai8"},{"id":"س-05340","fp":"c2d254c43310","stateId":325,"easy":"إذا دعوت فاعزم في الدعاء ← فالله لا مكره له","cause":"إذا دعَا أحدُكُم فليَعزِمْ في الدُّعاءِ","result":"فإنَّ اللهَ لا مُستكرِهَ لهُ","explicit":true,"repOf":"س-05338","ref":"صحيح الأدب المفرد 475","text":[["إذا دعَا أحدُكُم فليَعزِمْ في الدُّعاءِ",1]," ، و لا يقُلْ : و في رِوايةٍ : إذا دعَوتُم اللهَ فاعزِمُوا في الدُّعاءِ و لا يقولَنَّ أحدُكُم : اللهُمَّ إن شِئتَ فأعطِني ، ",["فإنَّ اللهَ لا مُستكرِهَ لهُ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6338)، ومسلم (2678) واللفظ له\n\nوالرواية أخرجها البخاري (7464)","bab":"رقائق وزهد › التوكل واليقين","dorar":"gZvktqw7"},{"id":"س-07122","fp":"71e655c85546","stateId":325,"easy":"إذا لم تدعُ بإثم ولا قطيعة رحم ولم تستعجل ← يُستجاب لك","cause":"ما لم يَدعُ بإثمٍ أو قَطيعةِ رَحِمٍ ما لم يَستَعجِلْ","result":"لا يَزالُ يُستَجابُ للعَبدِ","explicit":true,"star":true,"ref":"صحيح مسلم 2735","srcLabel":"البخاري","text":[["لا يَزالُ يُستَجابُ للعَبدِ",2]," ",["ما لم يَدعُ بإثمٍ أو قَطيعةِ رَحِمٍ ما لم يَستَعجِلْ",1],"، قيلَ: يا رَسولَ اللهِ، ما الاستِعجالُ؟ قال: يقولُ: قد دَعَوتُ وقد دَعَوتُ، فلم أرَ يَستَجيبُ لي، فيَستَحسِرُ عِندَ ذلك ويَدَعُ الدُّعاءَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6340) مختصراً باختلاف يسير","bab":"علم › حسن السؤال ونصح العالم","dorar":"Jy1mNupf"},{"id":"س-05350","fp":"4c772654e0fe","stateId":325,"easy":"إذا دعوت فعظّم الرغبة ← فلا يتعاظم على الله شيء","cause":"إذا دعا أحَدُكم فلْيُعظِمِ الرَّغبةَ","result":"فإنَّه لا يتعاظَمُ على اللهِ شيءٌ","explicit":true,"repOf":"س-05338","ref":"تخريج صحيح ابن حبان 896","text":[["إذا دعا أحَدُكم فلْيُعظِمِ الرَّغبةَ ",1],["فإنَّه لا يتعاظَمُ على اللهِ شيءٌ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2679) مطولاً باختلاف يسير","bab":"رقائق وزهد › التوكل واليقين","dorar":"3YTNqaI5"},{"id":"س-00049","fp":"1f7e9fc0fbfc","stateId":325,"easy":"إذا لم تستعجل ← يُستجاب لك","cause":"ما لمْ يَعجَلْ، قيل: وما عَجَلَتُهُ؟ قال: يقولُ: قدْ دعَوْتُ اللهَ، فما استَجاب، ودعَوْتُ اللهَ فما استَجاب","result":"يُستَجابُ للعبدِ","explicit":true,"repOf":"س-00011","otherNeedIds":[30],"ref":"تخريج مشكل الآثار 880","text":[["يُستَجابُ للعبدِ",2]," ",["ما لمْ يَعجَلْ، قيل: وما عَجَلَتُهُ؟ قال: يقولُ: قدْ دعَوْتُ اللهَ، فما استَجاب، ودعَوْتُ اللهَ فما استَجاب",1],"."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه الطحاوي في  ((شرح مشكل الآثار)) (879) واللفظ له، والبخاري (6340)، ومسلم (2735)","bab":"آداب الدعاء › استجابة الدعاء","dorar":"TeloLruk"},{"id":"س-05342","fp":"f1beb96ec7b4","stateId":325,"easy":"إذا سألت الله وأنت موقن بالإجابة ← يستجيب لك (ولا يستجيب لقلب غافل)","cause":"فاسألوهُ وأنتُمْ موقِنونَ بالإجابةِ","result":"فإنَّ اللَّهَ لا يستجيبُ لعبدٍ دعاهُ عن ظَهْرِ قَلبٍ غافلٍ","explicit":true,"similar":["س-00072"],"otherNeedIds":[30],"ref":"تخريج المسند لشاكر 10/140","srcLabel":"أحمد","text":["القُلوبُ أوعيةٌ ، وبعضُها أوعى من بعضٍ ، فإذا سألتُمُ اللَّهَ عزَّ وجلَّ ، أيُّها النَّاسُ ، ",["فاسألوهُ وأنتُمْ موقِنونَ بالإجابةِ",1]," ، ",["فإنَّ اللَّهَ لا يستجيبُ لعبدٍ دعاهُ عن ظَهْرِ قَلبٍ غافلٍ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6655).","bab":"رقائق وزهد › التوكل واليقين","dorar":"w3dOME5a"},{"id":"س-05880","fp":"ab1f67542632","stateId":325,"easy":"إذا سألت ربك فأكثر ← فإنك تسأل ربك","cause":"فلْيُكثِرْ","result":"فإنَّه يسأَلُ ربَّه","explicit":true,"ref":"تخريج صحيح ابن حبان 889","srcLabel":"ابن حبان","text":["إذا سأَل أحَدُكم ",["فلْيُكثِرْ",1]," ",["فإنَّه يسأَلُ ربَّه",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه ابن حبان (889) واللفظ له، وعبد بن حميد (1494)، والطبراني في ((الأوسط)) (2040) بنحوه.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"bftOYtvJ"},{"id":"س-07200","fp":"61f2617fbe0b","stateId":325,"easy":"إذا لم تستعجل ← لا تزال بخير","cause":"ما لا يستعجِلُ","result":"لا يزالُ العَبدُ بِخيرٍ","explicit":true,"repOf":"س-00011","otherNeedIds":[55],"ref":"تحفة الذاكرين 70","text":[["لا يزالُ العَبدُ بِخيرٍ",2]," ",["ما لا يستعجِلُ ",1],"، قالوا : يا نَبِيَّ اللَّهِ وكيفَ يستعجِلُ ؟ قالَ : يقولُ قَد دعوتُ اللَّهَ فلَم يستجِبْ لي ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (13008)، والبزار (6666)، والطبراني في ((المعجم الأوسط)) (2497) باختلاف يسير","bab":"علم › حسن السؤال ونصح العالم","dorar":"PGan8fsQ"},{"id":"س-00072","fp":"ce6af4be4f3e","stateId":325,"easy":"إذا دعوت الله وأنت موقن ← يستجيب لك","cause":"ادْعُوا اللهَ وأنتمْ مُوقِنُونَ","result":"بالإجابةِ","explicit":true,"repOf":"س-05342","ref":"صحيح الجامع 245","text":[["ادْعُوا اللهَ وأنتمْ مُوقِنُونَ",1]," ",["بالإجابةِ",2]," ، واعلمُوا أنَّ اللهَ لا يَستجيبُ دُعاءً من قلْبٍ غافِلٍ لَاهٍ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه الترمذي (3479) واللفظ له، والبزار (10061)","bab":"آداب الدعاء › استجابة الدعاء","dorar":"BcNyNkI1"},{"id":"س-00042","fp":"3b2bb27805e2","stateId":325,"easy":"إذا دعوت ولم تستعجل ← يُستجاب لك","cause":"أنَّ العبدَ","result":"يُستجابُ له ما لَم يَعجَلْ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-00011","ref":"فتح الباري لابن رجب 1/151","text":[["أنَّ العبدَ ",1],["يُستجابُ له ما لَم يَعجَلْ ",2],"، فيقولُ : قد دعوتُ فلَم يُستَجَبْ لِي ، فيدَعُ الدُّعاءَ"],"grade":"صحيح","muhaddith":"صحيح","bab":"آداب الدعاء › استجابة الدعاء","dorar":"E9oWRq4I"},{"id":"س-02762","fp":"904ea91b1067","stateId":326,"easy":"إذا حضرت المريض أو الميت فقل خيراً ← فالملائكة تؤمّن على ما تقول","cause":"إذا حضَرتُمُ المريضَ، أوِ الميِّتَ، فقولوا خيرًا","result":"فإنَّ المَلائكةَ تُؤمِّنُ على ما تقولونَ","explicit":true,"star":true,"similar":["س-08366","س-00686","س-02764"],"ref":"تخريج المسند لشعيب 26608","srcLabel":"مسلم","text":[["إذا حضَرتُمُ المريضَ، أوِ الميِّتَ، فقولوا خيرًا؛ ",1],["فإنَّ المَلائكةَ تُؤمِّنُ على ما تقولونَ",2],". قالتْ: فلمَّا ماتَ أبو سلَمةَ قُلتُ: يا رسولَ اللهِ، كيفَ أقولُ؟ قالَ: قولي: اللَّهمَّ اغفِرْ لنا وله، وأَعْقِبْني منه عُقبَى حسَنةً. وقال ابنُ نُمَيرٍ: صالحةً. قالَتْ: فأعقَبَني اللهُ عزَّ وجلَّ منه محمَّدًا صلَّى اللهُ عليهِ وسلَّمَ."],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (919)، وأبو داود (3115)، والترمذي (977)، والنسائي (1825)، وابن ماجه (1447)، وأحمد (26608) واللفظ له","bab":"إيمان › الملائكة","dorar":"s1fTrnbn"},{"id":"س-08366","fp":"3d614210c057","stateId":326,"easy":"إذا دعوت على نفسك ← فلا تدعُ إلا بخير فالملائكة تؤمّن","cause":"لا تَدعوا على أنفُسِكُم إلَّا بخَيرٍ","result":"فإنَّ المَلائِكةَ يُؤَمِّنونَ على ما تَقولونَ","explicit":true,"repOf":"س-02762","ref":"صحيح مسلم 920","text":["دَخَلَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم على أبي سَلَمةَ وقد شَقَّ بَصَرُه، فأغمَضَه، ثُمَّ قال: إنَّ الرُّوحَ إذا قُبِضَ تَبِعَه البَصَرُ، فضَجَّ ناسٌ مِن أهلِه، فقال: ",["لا تَدعوا على أنفُسِكُم إلَّا بخَيرٍ",1],"؛ ",["فإنَّ المَلائِكةَ يُؤَمِّنونَ على ما تَقولونَ",2],"، ثُمَّ قال: اللَّهُمَّ اغفِرْ لأبي سَلَمةَ، وارفَعْ دَرَجَتَه في المَهديِّينَ، واخلُفْه في عَقِبِه في الغابِرينَ، واغفِرْ لَنا ولَه يا رَبَّ العالَمينَ، وافسَحْ له في قَبرِه، ونَوِّرْ له فيه. [وفي روايةٍ]: نَحوَه، غيرَ أنَّه قال: واخلُفْه في تَرِكَتِه، وقال: اللَّهُمَّ أوسِعْ له في قَبرِه، ولَم يَقُلْ: افسَحْ له."],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"QUbczBv5"},{"id":"س-00686","fp":"d5bf71ec30d7","stateId":326,"easy":"إذا حضرت المريض أو الميت فقل خيراً ← فإن الملائكة يؤمّنون على ما تقول","cause":"إذا حَضرتُمُ المريضَ أوِ الميِّتَ ، فقولوا خَيرًا","result":"فإنَّ الملائِكَةَ يؤمِّنونَ على ما تَقولونَ فلمَّا ماتَ أبو سلَمةَ أتيتُ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ","explicit":true,"repOf":"س-02762","ref":"صحيح ابن ماجه 1195","text":[["إذا حَضرتُمُ المريضَ أوِ الميِّتَ ، فقولوا خَيرًا ، ",1],["فإنَّ الملائِكَةَ يؤمِّنونَ على ما تَقولونَ فلمَّا ماتَ أبو سلَمةَ أتيتُ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ",2]," فقُلتُ: يا رسولَ اللَّهِ ، إنَّ أبا سلَمةَ قَد ماتَ ، قالَ: قولي: اللَّهُمَّ اغفِر لي ولَهُ ، وأعقِبني منهُ عُقبَى حسنةً قالَت: ففَعلتُ: فأعقبَني اللَّهُ مَن هوَ خيرٌ مِنهُ ، محمَّدٌ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ"],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه مسلم (919)","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"OzczhTvB","merged":2,"otherRefs":["صحيح أبي داود 3115 (صحيح)"]},{"id":"س-06450","fp":"b9f479eb4162","stateId":326,"easy":"إذا قلت «آمين» ← يجبك الله","cause":"فقولوا: آمينَ","result":"يُجِبْكم اللهُ","explicit":true,"ref":"تخريج المسند لشعيب 19665","srcLabel":"مسلم","text":["أنَّ الأشعَريَّ صَلَّى بأصحابِه صَلاةً، فقال رَجُلٌ مِن القَومِ حين جَلَسَ في صَلاتِه: أُقِرَّتِ الصَّلاةُ بالبِرِّ والزَّكاةِ، فلمَّا قَضى الأشعَريُّ صَلاتَه أقبَلَ على القَومِ فقال: أيُّكم القائلُ كَلِمةَ كذا وكذا؟ فأرَمَّ القَومُ، قال أبو عبدِ الرَّحمنِ: قال أبي: أرَمَّ: السُّكوتُ، قال: لعلَّكَ يا حِطَّانُ، قُلتَها؟ -لحِطَّانَ بنِ عبدِ اللهِ- قال: واللهِ إنْ قُلتُها، ولقد رَهِبتُ أنْ تَبكَعَني بها، قال رَجُلٌ مِن القَومِ: أنا قُلتُها، وما أرَدتُ بها إلَّا الخيرَ، فقال الأشعَريُّ: ألَا تَعلمونَ ما تَقولونَ في صَلاتِكم؟ فإنَّ نَبيَّ اللهِ صلَّى اللهُ عليه وسلَّمَ خَطَبَنا فعَلَّمَنا سُنَّتَنا، وبَيَّنَ لنا صَلاتَنا فقال: أقيموا صُفوفَكم، ثُمَّ ليُؤمَّكم أقرَؤكم، فإذا كَبَّرَ فكَبِّروا، وإذا قال: {وَلَا الضَّالِّينَ} [الفاتحة: 7]، ",["فقولوا: آمينَ",1],"، ",["يُجِبْكم اللهُ",2],"، فإذا كَبَّرَ الإمامُ ورَكَعَ فكَبِّروا واركَعوا؛ فإنَّ الإمامَ يَركَعُ قبلَكم، ويَرفَعُ قبلَكم، قال نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ: فتلك بتلك، فإذا قال: سَمِعَ اللهُ لمَن حَمِدَه، فقولوا: اللَّهُمَّ ربَّنا لك الحَمدُ، يَسمَعِ اللهُ لكم؛ فإنَّ اللهَ عزَّ وجلَّ قال على لِسانِ نَبيِّه صلَّى اللهُ عليه وسلَّمَ: سَمِعَ اللهُ لمَن حَمِدَه، وإذا كَبَّرَ الإمامُ وسَجَدَ فكَبِّروا واسجُدوا؛ فإنَّ الإمامَ يَسجُدُ قبلَكم ويَرفَعُ قبلَكم، قال نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ: فتلك بتلك، فإذا كان عندَ القَعدةِ، فليَكُنْ مِن أوَّلِ قَولِ أحَدِكم أنْ يقولَ: التَّحيَّاتُ الطَّيِّباتُ، الصَّلَواتُ للهِ، السَّلامُ عليك أيُّها النَّبيُّ ورَحمةُ اللهِ وبَركاتُه، السَّلامُ علينا، وعلى عِبادِ اللهِ الصَّالحينَ، أشهَدُ أنْ لا إلهَ إلَّا اللهُ، وأنَّ محمَّدًا عبدُه ورسولُه."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (404)، وأبو داود (972)، والنسائي (1064)، وأحمد (19665) واللفظ له","bab":"صلاة › صفة صلاة النبي صلى الله عليه وسلم","dorar":"ZmCJv1f1","merged":2,"otherRefs":["صحيح النسائي 829 (صحيح)"]},{"id":"س-06451","fp":"d2047e108056","stateId":326,"easy":"إذا قلت «اللهم ربنا لك الحمد» ← يسمع الله لك","cause":"فقولوا: اللَّهُمَّ ربَّنا لك الحَمدُ","result":"يَسمَعِ اللهُ لكم","explicit":true,"apply":{"k":"say","t":"«اللهم ربنا لك الحمد»"},"ref":"تخريج المسند لشعيب 19665","srcLabel":"مسلم","text":["أنَّ الأشعَريَّ صَلَّى بأصحابِه صَلاةً، فقال رَجُلٌ مِن القَومِ حين جَلَسَ في صَلاتِه: أُقِرَّتِ الصَّلاةُ بالبِرِّ والزَّكاةِ، فلمَّا قَضى الأشعَريُّ صَلاتَه أقبَلَ على القَومِ فقال: أيُّكم القائلُ كَلِمةَ كذا وكذا؟ فأرَمَّ القَومُ، قال أبو عبدِ الرَّحمنِ: قال أبي: أرَمَّ: السُّكوتُ، قال: لعلَّكَ يا حِطَّانُ، قُلتَها؟ -لحِطَّانَ بنِ عبدِ اللهِ- قال: واللهِ إنْ قُلتُها، ولقد رَهِبتُ أنْ تَبكَعَني بها، قال رَجُلٌ مِن القَومِ: أنا قُلتُها، وما أرَدتُ بها إلَّا الخيرَ، فقال الأشعَريُّ: ألَا تَعلمونَ ما تَقولونَ في صَلاتِكم؟ فإنَّ نَبيَّ اللهِ صلَّى اللهُ عليه وسلَّمَ خَطَبَنا فعَلَّمَنا سُنَّتَنا، وبَيَّنَ لنا صَلاتَنا فقال: أقيموا صُفوفَكم، ثُمَّ ليُؤمَّكم أقرَؤكم، فإذا كَبَّرَ فكَبِّروا، وإذا قال: {وَلَا الضَّالِّينَ} [الفاتحة: 7]، فقولوا: آمينَ، يُجِبْكم اللهُ، فإذا كَبَّرَ الإمامُ ورَكَعَ فكَبِّروا واركَعوا؛ فإنَّ الإمامَ يَركَعُ قبلَكم، ويَرفَعُ قبلَكم، قال نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ: فتلك بتلك، فإذا قال: سَمِعَ اللهُ لمَن حَمِدَه، ",["فقولوا: اللَّهُمَّ ربَّنا لك الحَمدُ",1],"، ",["يَسمَعِ اللهُ لكم",2],"؛ فإنَّ اللهَ عزَّ وجلَّ قال على لِسانِ نَبيِّه صلَّى اللهُ عليه وسلَّمَ: سَمِعَ اللهُ لمَن حَمِدَه، وإذا كَبَّرَ الإمامُ وسَجَدَ فكَبِّروا واسجُدوا؛ فإنَّ الإمامَ يَسجُدُ قبلَكم ويَرفَعُ قبلَكم، قال نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ: فتلك بتلك، فإذا كان عندَ القَعدةِ، فليَكُنْ مِن أوَّلِ قَولِ أحَدِكم أنْ يقولَ: التَّحيَّاتُ الطَّيِّباتُ، الصَّلَواتُ للهِ، السَّلامُ عليك أيُّها النَّبيُّ ورَحمةُ اللهِ وبَركاتُه، السَّلامُ علينا، وعلى عِبادِ اللهِ الصَّالحينَ، أشهَدُ أنْ لا إلهَ إلَّا اللهُ، وأنَّ محمَّدًا عبدُه ورسولُه."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (404)، وأبو داود (972)، والنسائي (1064)، وأحمد (19665) واللفظ له","bab":"صلاة › صفة صلاة النبي صلى الله عليه وسلم","dorar":"ZmCJv1f1","merged":2,"otherRefs":["صحيح النسائي 829 (صحيح)"]},{"id":"س-00058","fp":"20af3687e725","stateId":326,"easy":"إذا رفعت يديك تسأل الله ← يعطيك ما لم تستعجل","cause":"ما مِن عبدٍ يرفعُ يديهِ حتَّى يبدوَ إبطُهُ يسألُ اللَّهَ مسألةً","result":"إلَّا آتاها إيَّاهُ ما لم يَعجَلْ","explicit":true,"similar":["س-00062"],"ref":"صحيح الترمذي 3604","srcLabel":"مسلم","text":[["ما مِن عبدٍ يرفعُ يديهِ حتَّى يبدوَ إبطُهُ يسألُ اللَّهَ مسألةً ،",1]," ",["إلَّا آتاها إيَّاهُ ما لم يَعجَلْ ",2],"، قالوا : يا رسولَ اللَّهِ وَكَيفَ عجَلتُهُ ؟ قالَ : يقولُ : قد سأَلتُ وسألتُ ولم أُعطَ شيئًا"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح دون الرفع","takhrij":"أخرجه مسلم (2735) بنحوه، والترمذي (3604) واللفظ له، وأحمد (9148) مختصراً","bab":"آداب الدعاء › استجابة الدعاء","dorar":"3RRq4hj1"},{"id":"س-00062","fp":"af0bc0e56426","stateId":326,"easy":"إذا رفعت يديك تسأل الله ← يعطيك ما لم تستعجل","cause":"ما من عبدٍ يرفعُ يديْهِ ، يسألُ اللهَ مسألَةً","result":"إلَّا أتاه إيَّاها ، ما لم يعجلْ ، يقولُ : قد سألْتُ وسألتُ ، فلم أُعْطَ شيئًا","explicit":true,"repOf":"س-00058","ref":"صحيح الجامع 5739","text":[["ما من عبدٍ يرفعُ يديْهِ ، يسألُ اللهَ مسألَةً ،",1]," ",["إلَّا أتاه إيَّاها ، ما لم يعجلْ ، يقولُ : قد سألْتُ وسألتُ ، فلم أُعْطَ شيئًا",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2735) مطولاً بنحوه، والترمذي (3387)، وأحمد (9148) مختصراً.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"yWfn2VV3"},{"id":"ق-0568","fp":"86c482c2979b","stateId":326,"easy":"الدعاء والاستقامة ← إجابة الدعوة","cause":"الدعاء والاستقامة","result":"إجابة الدعوة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة يونس: 89","srcLabel":"القرآن الكريم","quran":{"s":10,"from":89,"to":89,"text":"قَالَ قَدْ أُجِيبَتْ دَعْوَتُكُمَا فَاسْتَقِيمَا وَلَا تَتَّبِعَانِّ سَبِيلَ الَّذِينَ لَا يَعْلَمُونَ (89)","hl":[[6,20,2],[20,48,1]]}},{"id":"ق-0587","fp":"9418d9961e16","stateId":326,"easy":"الاستغفار والتوبة ← قرب الله وإجابته","cause":"الاستغفار والتوبة","result":"قرب الله وإجابته","explicit":true,"otherNeedIds":[26],"ref":"سورة هود: 61","srcLabel":"القرآن الكريم","quran":{"s":11,"from":61,"to":61,"text":"وَإِلَى ثَمُودَ أَخَاهُمْ صَالِحًا قَالَ يَا قَوْمِ اعْبُدُوا اللَّهَ مَا لَكُمْ مِنْ إِلَهٍ غَيْرُهُ هُوَ أَنْشَأَكُمْ مِنَ الْأَرْضِ وَاسْتَعْمَرَكُمْ فِيهَا فَاسْتَغْفِرُوهُ ثُمَّ تُوبُوا إِلَيْهِ إِنَّ رَبِّي قَرِيبٌ مُجِيبٌ (61)","hl":[[160,200,1],[200,228,2]]}},{"id":"ق-0619","fp":"d031a1798bba","stateId":326,"easy":"دعاء الله وحده ← له دعوة الحق (المستجابة)","cause":"دعاء الله وحده","result":"له دعوة الحق (المستجابة)","explicit":true,"ref":"سورة الرعد: 14","srcLabel":"القرآن الكريم","quran":{"s":13,"from":14,"to":14,"text":"لَهُ دَعْوَةُ الْحَقِّ وَالَّذِينَ يَدْعُونَ مِنْ دُونِهِ لَا يَسْتَجِيبُونَ لَهُمْ بِشَيْءٍ إِلَّا كَبَاسِطِ كَفَّيْهِ إِلَى الْمَاءِ لِيَبْلُغَ فَاهُ وَمَا هُوَ بِبَالِغِهِ وَمَا دُعَاءُ الْكَافِرِينَ إِلَّا فِي ضَلَالٍ (14)","hl":[[0,22,1]]}},{"id":"ق-0885","fp":"b6b254e53abb","stateId":326,"easy":"الدعاء والعبادة ← عناية الله بالعبد","cause":"الدعاء والعبادة","result":"عناية الله بالعبد","explicit":true,"otherNeedIds":[26],"ref":"سورة الفرقان: 77","srcLabel":"القرآن الكريم","quran":{"s":25,"from":77,"to":77,"text":"قُلْ مَا يَعْبَأُ بِكُمْ رَبِّي لَوْلَا دُعَاؤُكُمْ فَقَدْ كَذَّبْتُمْ فَسَوْفَ يَكُونُ لِزَامًا (77)","hl":[[0,5,1],[5,31,2],[31,51,1]]}},{"id":"ق-0951","fp":"8f488fe463ea","stateId":326,"easy":"الدعاء بإخلاص عند الشدة ← النجاة","cause":"الدعاء بإخلاص عند الشدة","result":"النجاة","explicit":true,"otherNeedIds":[4],"ref":"سورة العنكبوت: 65","srcLabel":"القرآن الكريم","quran":{"s":29,"from":65,"to":65,"text":"فَإِذَا رَكِبُوا فِي الْفُلْكِ دَعَوُا اللَّهَ مُخْلِصِينَ لَهُ الدِّينَ فَلَمَّا نَجَّاهُمْ إِلَى الْبَرِّ إِذَا هُمْ يُشْرِكُونَ (65)","hl":[[0,73,1],[73,107,2]]}},{"id":"ق-1064","fp":"34fa5f3476f6","stateId":326,"easy":"الإنابة والاستغفار قبل السؤال ← الملك والتسخير والزلفى وحسن المآب","cause":"الإنابة والاستغفار قبل السؤال","result":"الملك والتسخير والزلفى وحسن المآب","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[43,11],"ref":"سورة ص: 34–40","srcLabel":"القرآن الكريم","quran":{"s":38,"from":34,"to":40,"text":"وَلَقَدْ فَتَنَّا سُلَيْمَانَ وَأَلْقَيْنَا عَلَى كُرْسِيِّهِ جَسَدًا ثُمَّ أَنَابَ (34) قَالَ رَبِّ اغْفِرْ لِي وَهَبْ لِي مُلْكًا لَا يَنْبَغِي لِأَحَدٍ مِنْ بَعْدِي إِنَّكَ أَنْتَ الْوَهَّابُ (35) فَسَخَّرْنَا لَهُ الرِّيحَ تَجْرِي بِأَمْرِهِ رُخَاءً حَيْثُ أَصَابَ (36) وَالشَّيَاطِينَ كُلَّ بَنَّاءٍ وَغَوَّاصٍ (37) وَآخَرِينَ مُقَرَّنِينَ فِي الْأَصْفَادِ (38) هَذَا عَطَاؤُنَا فَامْنُنْ أَوْ أَمْسِكْ بِغَيْرِ حِسَابٍ (39) وَإِنَّ لَهُ عِنْدَنَا لَزُلْفَى وَحُسْنَ مَآبٍ (40)","hl":[[0,200,1],[200,477,2]]}},{"id":"ق-1120","fp":"21de3720fa3d","stateId":326,"easy":"دعاء الله ← الاستجابة","cause":"دعاء الله","result":"الاستجابة","explicit":true,"ref":"سورة غافر: 60","srcLabel":"القرآن الكريم","quran":{"s":40,"from":60,"to":60,"text":"وَقَالَ رَبُّكُمُ ادْعُونِي أَسْتَجِبْ لَكُمْ إِنَّ الَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِي سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ (60)","hl":[[0,28,1],[28,45,2]]}},{"id":"س-00029","fp":"9ca590b18c23","stateId":326,"easy":"إذا دعوت بدعوة ليس فيها إثم ولا قطيعة رحم ← يعطيك الله إحدى ثلاث: يعجّلها أو يدخرها أو يصرف عنك مثلها","cause":"ما مِن عَبْدٍ يَدْعو اللهَ بدَعوةٍ ليسَ فيها إثْمٌ ولا قَطيعةُ رَحِمٍ","result":"إلَّا أعْطاهُ اللهُ بها إحدْىَ ثَلاثٍ: إمَّا أنْ تُعجَّلَ له دَعوتُه في الدُّنيا، وإمَّا أنْ تُدخَّرَ له في الآخِرةِ، وإمَّا أنْ يُصرَفَ عنه مِن الشَّرِّ مِثلُ ذلك","explicit":true,"ref":"فتاوى نور على الدرب لابن باز 404/34","srcLabel":"فتاوى نور على الدرب لابن باز","text":["(",["ما مِن عَبْدٍ يَدْعو اللهَ بدَعوةٍ ليسَ فيها إثْمٌ ولا قَطيعةُ رَحِمٍ،",1]," ",["إلَّا أعْطاهُ اللهُ بها إحدْىَ ثَلاثٍ: إمَّا أنْ تُعجَّلَ له دَعوتُه في الدُّنيا، وإمَّا أنْ تُدخَّرَ له في الآخِرةِ، وإمَّا أنْ يُصرَفَ عنه مِن الشَّرِّ مِثلُ ذلك)",2],"، قالوا يا رَسولَ اللهِ: إذنْ نُكثِرُ؟ قال: (اللهُ أكثرُ)."],"grade":"صحيح","muhaddith":"صحيح","bab":"آداب الدعاء › استجابة الدعاء","dorar":"0E8VQDsf","merged":4,"otherRefs":["معجم الشيوخ 1/174 (صحيح)","تخريج شرح الطحاوية 682 (صحيح)","المستدرك على الصحيحين 1840 (صحيح)"]},{"id":"س-07416","fp":"189f1a849462","stateId":326,"easy":"إذا قرأت القرآن فاسأل الله به ← لا تسأل الناس به","cause":"فلْيَسْأَلِ اللهَ به","result":"فإنه سَيَجِيءُ أقوامٌ يقرأون القرآنَ، يَسْأَلُونَ به الناسَ","explicit":true,"otherNeedIds":[13,45],"ref":"هداية الرواة 2157","srcLabel":"الترمذي","text":["من قرأ القرآنَ ؛ ",["فلْيَسْأَلِ اللهَ به",1]," ؛ ",["فإنه سَيَجِيءُ أقوامٌ يقرأون القرآنَ، يَسْأَلُونَ به الناسَ",2]],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (2917)، وعبد الرزاق في ((التفسير)) (1347)، وسعيد بن منصور في ((التفسير)) (45) بلفظه وفيه قصة.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"4EKEj7rn","merged":3,"otherRefs":["تخريج المسند لشعيب 19917 (حسن)","الفروع لابن مفلح 11/ 90 (حسن)"]},{"id":"س-00018","fp":"0ae2eb8bdcb1","stateId":326,"easy":"إذا أكثرت الدعاء في الرخاء ← يستجيب الله لك عند الشدائد والكرب","cause":"فلْيُكثِرِ الدُّعاءَ في الرَّخاءِ","result":"من سره أن يستجيبَ اللهُ له عندَ الشَّدائدِ و الكُرَبِ","explicit":true,"otherNeedIds":[4],"ref":"الجامع الصغير 8724","srcLabel":"الترمذي","text":[["من سره أن يستجيبَ اللهُ له عندَ الشَّدائدِ و الكُرَبِ ، ",2],["فلْيُكثِرِ الدُّعاءَ في الرَّخاءِ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3382)، والحاكم في ((مستدركه)) (1997)، والطبراني في ((الدعاء)) ( 45) واللفظ لهم.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"EpEkHAWD","merged":2,"otherRefs":["المستدرك على الصحيحين 2023 (صحيح)"]},{"id":"س-02764","fp":"4c242ac3e475","stateId":326,"easy":"إذا قلت خيراً عند الميت ← تؤمّن الملائكة على دعائكم","cause":"وقُولوا خَيرًا","result":"فإنَّ المَلائكةَ تُؤَمِّنُ على دُعاءِ أهلِ البَيتِ","explicit":true,"repOf":"س-02762","ref":"المستدرك على الصحيحين 1319","text":["إذا حَضَرتُمُ المَيِّتَ فأغمِضوا البَصَرَ؛ فإنَّ البَصَر يَتبَعُ الرُّوحَ، ",["وقُولوا خَيرًا",1],"؛ ",["فإنَّ المَلائكةَ تُؤَمِّنُ على دُعاءِ أهلِ البَيتِ",2],"."],"grade":"صحيح","narrator":"شداد بن أوس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن ماجه (1455)، وأحمد (17136) باختلاف يسير.","bab":"إيمان › الملائكة","dorar":"UcXTFvya","merged":2,"otherRefs":["صحيح الجامع 492 (صحيح)"]},{"id":"س-03518","fp":"6782e65ef9a7","stateId":326,"easy":"إذا حضرت الجمعة لتدعو ← فأنت رجل دعا الله إن شاء أعطاك وإن شاء منعك","cause":"ورجلٌ حضرَها بدُعاءٍ","result":"فَهوَ رجلٌ دعا اللَّهَ، فإن شاءَ اللَّهُ أعطاهُ، وإن شاءَ مَنعَهُ","explicit":true,"ref":"صحيح ابن خزيمة 3/ 283","srcLabel":"أبو داود","text":["يَحضُرُ الجمُعةَ ثلاثةٌ: رجلٌ يَحضرُها يَلغو، فَهوَ حظُّهُ منها، ",["ورجلٌ حضرَها بدُعاءٍ",1],"، ",["فَهوَ رجلٌ دعا اللَّهَ، فإن شاءَ اللَّهُ أعطاهُ، وإن شاءَ مَنعَهُ",2],"، ورجلٌ حَضرَها بوقارٍ وإنصاتٍ وسُكونٍ، ولم يتخطَّ رقبةَ مسلِمٍ، ولم يؤذِ أحدًا، فَهوَ كفَّارةٌ لَهُ إلى الجمعةِ الَّتي تَليها، وزيادةُ ثلاثةِ أيَّامٍ ؛ لأنَّ اللَّهَ يقولُ: {مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ عَشْرُ أَمْثَالِهَا} [الأنعامُ: 160]"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (1113)، وأحمد (7002)، والبيهقي (5897) باختلاف يسير","bab":"استغفار › مكفرات الذنوب","dorar":"I9wWla72","merged":2,"otherRefs":["صحيح الترغيب 723 (صحيح)"]},{"id":"س-00076","fp":"d13391fc5236","stateId":326,"easy":"إذا اجتمع قوم فدعا بعضهم وأمّن بعضهم ← يجيبهم الله","cause":"لا يجتَمعُ ملأٌ فيدعو بَعضُهُم ويؤمِّنُ بعضُهُم","result":"إلَّا أجابَهُمُ اللَّهُ","explicit":true,"ref":"الترغيب والترهيب 1/240","srcLabel":"الحاكم","text":[["لا يجتَمعُ ملأٌ فيدعو بَعضُهُم ويؤمِّنُ بعضُهُم",1]," ",["إلَّا أجابَهُمُ اللَّهُ",2]],"grade":"صحيح","narrator":"حبيب بن مسلمة الفهري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني (4/22) (3536)، والحاكم (5478)، والبيهقي في ((دلائل النبوة)) (7/113) مطولاً","bab":"آداب الدعاء › استجابة الدعاء","dorar":"BTp1PBwo"},{"id":"س-01426","fp":"b17d1ba6081b","stateId":326,"easy":"إذا أسبغت الوضوء ثم صليت ركعتين تامتين ← يعطيك الله ما سألت عاجلاً أو آجلاً","cause":"من توضأ فأسبغ الوضوءَ ، ثمَّ صلَّى ركعتينِ بتمامِهما","result":"أعطاهُ اللهُ عزَّ وجلَّ ما سأل معجَّلًا أو مؤخَّرًا","explicit":true,"apply":{"k":"count","t":"ركعتين"},"similar":["س-01464"],"ref":"تحفة الذاكرين 232","srcLabel":"أحمد","text":[["من توضأ فأسبغ الوضوءَ ، ثمَّ صلَّى ركعتينِ بتمامِهما ",1],["أعطاهُ اللهُ عزَّ وجلَّ ما سأل معجَّلًا أو مؤخَّرًا ",2],"."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (27497)، والطبراني كما في ((الترغيب والترهيب)) للمنذري (1/209) مطولاً","bab":"وضوء › فضل الوضوء","dorar":"ckhxrQfy"},{"id":"س-05789","fp":"36c238b079c6","stateId":326,"easy":"إذا ختمت دعاءك بآمين ← أوجبت الإجابة","cause":"إنْ خَتَمَ بِآمِينَ","result":"أوْجَبَ","explicit":true,"ref":"الجامع الصغير 2764","srcLabel":"أبو داود","text":[["أوْجَبَ",2]," ",["إنْ خَتَمَ بِآمِينَ",1]],"grade":"صحيح","narrator":"أبو زهير الأنماري (النميري)","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (938)، والطبراني في ((الكبير)) (22/ 296) (756)، وابن أبي عاصم في ((الآحاد والمثاني)) (1442) باختلاف يسير تامًا.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"MGuoVCq5"},{"id":"س-01464","fp":"27a2fb69a4a1","stateId":326,"easy":"إذا أسبغت الوضوء ثم صليت ركعتين تتمهما ← يعطيك الله ما سألت عاجلاً أو آجلاً","cause":"مَن توضأَ فأسبغ وضوءَه ثم صلَّى ركعتينِ يُتمُّهما","result":"إلا أعطاه اللهُ ما سأله معجَّلًا أو مؤخَّرًا","explicit":true,"apply":{"k":"count","t":"ركعتين"},"repOf":"س-01426","ref":"تذكرة الموضوعات 50","text":[["مَن توضأَ فأسبغ وضوءَه ثم صلَّى ركعتينِ يُتمُّهما ",1],["إلا أعطاه اللهُ ما سأله معجَّلًا أو مؤخَّرًا",2]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (27497)، والطبراني كما في ((الترغيب والترهيب)) للمنذري (1/209) مطولاً","bab":"وضوء › فضل الوضوء","dorar":"rCHvNauP"},{"id":"س-03908","fp":"d83e1efee174","stateId":326,"easy":"إذا دعوت الله وتضرعت ← يستجيب لك","cause":"سَأَلكَ عِبادي وتضَرَّعوا إليكَ","result":"وعِزَّتي لوْ أنَّهم دَعَوْني لأجَبْتُهم","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[56],"ref":"المستدرك على الصحيحين 3582","srcLabel":"ابن أبي شيبة","text":["عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهُما قالَ: لمَّا أَتى موسى قومَهُ أَمَرَهُم بالزَّكاةِ فجَمَعَهم قارونُ، فقالَ لهم: جاءكم بالصَّلاةِ وجاءكم بأشياءَ، فاحْتَمَلتُموها فتحَمَّلوا أنْ تُعطوهُ أموالَكُم. فقالوا: لا نَحتَمِلُ أنْ نُعطيَهُ أموالَنا، فما تَرى؟ فقالَ لهم: أرى أنْ أُرسِلَ إلى بَغِيِّ بني إسرائيلَ فنُرسِلَها إليه فتَرمِيهِ بأنَّه أرادَها على نَفسِها، فدعا اللهَ موسى عليهم، فأَمَرَ اللهُ الأرضَ أنْ تُطيعَهُ، فقالَ موسى للأرضِ: خُذيهِم، فأَخَذَتْهم إلى أعْقابِهم. فجَعَلوا يقولونَ: يا موسى يا موسى، ثُمَّ قالَ للأرضِ: خُذيهِم، فأَخَذَتْهم إلى رُكَبِهِم، فجَعَلوا يقولونَ: يا موسى يا موسى، ثُمَّ قالَ للأرضِ: خُذيهِم، فأَخَذَتْهم إلى أعناقِهِم. فجعلوا يقولونَ: يا موسى يا موسى، فقالَ للأرضِ: خُذيهِم فأَخَذَتْهم فغَيَّبَتْهم، فأَوْحى اللهُ إلى موسى: يا موسى ",["سَأَلكَ عِبادي وتضَرَّعوا إليكَ",1]," فلمْ تُجِبْهُم، ",["وعِزَّتي لوْ أنَّهم دَعَوْني لأجَبْتُهم",2],". قالَ ابنُ عبَّاسٍ: وذلك قولُ اللهِ عزَّ وجلَّ: {فَخَسَفْنَا بِهِ وَبِدَارِهِ الْأَرْضَ} [القصص: 81]، خَسَفَ به إلى الأرضِ السُّفلى."],"grade":"صحيح","narrator":"عبدالله بن الحارث","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه ابن أبي شيبة (31843)، وابن أبي الدنيا في ((العقوبات)) (233) بلفظ مقارب","bab":"تفسير آيات › سورة القصص","dorar":"91tvWhgT"},{"id":"س-06982","fp":"e4fa637b8954","stateId":327,"easy":"إذا قلت «يا ذا الجلال والإكرام» ← يُقبل الله عليك فسل","cause":"يا ذا الجَلالِ والإكرامِ","result":"سَلْ؛ فقد أقبَلَ نَحْوَك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«يا ذا الجلال والإكرام»"},"ref":"الأحاديث المختارة 2349","srcLabel":"البخاري","text":["«سمع النَّبيُّ صلَّى اللهُ عليه وسلَّم رجلًا يَقولُ: ",["يا ذا الجَلالِ والإكرامِ",1],"، فقال: ",["سَلْ؛ فقد أقبَلَ نَحْوَك",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"hM9bq8zm","merged":4,"otherRefs":["تخريج المسند لشعيب 22017 (حسن)","سنن الترمذي 3527 (حسن)","الترغيب والترهيب 2/393 (صحيح)"]},{"id":"س-05490","fp":"1874759052b5","stateId":327,"easy":"إذا قلت «اللهم إني أسألك بأني أشهد أنك أنت الله لا إله إلا أنت الأحد الصمد...» ← سألت الله باسمه الأعظم الذي إذا سُئل به أعطى","cause":"اللَّهُمَّ إنِّي أسأَلُك بأنِّي أشهَدُ أنَّك أنتَ اللهُ الذي لا إلهَ إلَّا أنتَ، الأحَدُ الصَّمَدُ، الذي لم يَلِدْ ولم يُولَدْ، ولم يكُنْ له كُفُوًا أحَدٌ","result":"لقد سَأَلَ اللهَ باسْمِه الأعظَمِ الذي إذا سُئِلَ به أعْطى، وإذا دُعِيَ به أجابَ","explicit":true,"apply":{"k":"say","t":"«اللَّهُمَّ إنِّي أسأَلُك بأنِّي أشهَدُ أنَّك أنتَ اللهُ الذي لا إلهَ إلَّا أنتَ، الأحَدُ الصَّمَدُ، الذي لم يَلِدْ ولم يُولَدْ، ولم يكُنْ له كُفُوًا أحَدٌ، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: والَّذي نَفْسي بيَدِه -أو»"},"ref":"تخريج المسند لشعيب 22952","srcLabel":"أبو داود","text":["خَرَجَ بُرَيدةُ عِشاءً، فلَقِيَه النَّبيُّ صلَّى اللهُ عليه وسلَّمَ، فأخَذَ بيَدِه فأدخَلَه المًسجِدَ، فإذا صَوتُ رَجُلٍ يَقرَأُ، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: تُراهُ مُرائيًا؟ فأُسكِتَ بُرَيدةُ، فإذا رَجُلٌ يَدْعو، فقال: ",["اللَّهُمَّ إنِّي أسأَلُك بأنِّي أشهَدُ أنَّك أنتَ اللهُ الذي لا إلهَ إلَّا أنتَ، الأحَدُ الصَّمَدُ، الذي لم يَلِدْ ولم يُولَدْ، ولم يكُنْ له كُفُوًا أحَدٌ",1],"، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: والَّذي نَفْسي بيَدِه -أو قال: والَّذي نَفْسُ مُحمَّدٍ بيَدِه- ",["لقد سَأَلَ اللهَ باسْمِه الأعظَمِ الذي إذا سُئِلَ به أعْطى، وإذا دُعِيَ به أجابَ",2],"، قال: فلمَّا كان مِن القابِلةِ خَرَجَ بُرَيدةُ عِشاءً، فلَقِيَه النَّبيُّ صلَّى اللهُ عليه وسلَّمَ، فأخَذَ بيَدِه فأدخَلَه المًسجِدَ، فإذا صَوتُ الرَّجُلِ يَقرَأُ، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: أتقولُه مُرائيًا؟ فقال بُرَيدةُ: أتقولُه مُرائيًا يا رسولَ اللهِ؟ فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: لا، بل مُؤمِنٌ مُنيبٌ، لا، بل مُؤمِنٌ مُنيبٌ، فإذا الأشعريُّ يَقرَأُ بصَوتٍ له في جانِبِ المَسجِدِ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّ الأشعريَّ -أو إنَّ عبدَ اللهِ بنَ قَيسٍ- أُعطِيَ مِزمارًا مِن مَزاميرِ داودَ، فقُلتُ: ألَا أُخبِرُه يا رسولَ اللهِ؟ قال: بلى، فأخْبِرْه، فأخْبَرْتُه، فقال: أنت لي صَديقٌ؛ أخْبَرتَني عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ بحديثٍ."],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1494)، والترمذي (3475) مختصراً، والنسائي في ((السنن الكبرى)) (7666، 8058) مفرقاً مختصراً، وابن ماجه (3857) مختصراً، وأحمد (22952) واللفظ له","bab":"رقائق وزهد › الرياء والسمعة","dorar":"ti2v9hpf","merged":9,"otherRefs":["تبيين كذب المفتري 75 (صحيح)","تخريج سير أعلام النبلاء 2/386 (صحيح)","تخريج المسند لشعيب 12611 (صحيح)","الصحيح المسند 101 (حسن)","الأحاديث المختارة 1514 (صحيح)","هداية الرواة 2233 (صحيح)","الفتح الرباني 1/402 (صحيح)","صحيح الترمذي 3544 (صحيح)"]},{"id":"س-07595","fp":"2b2ba2b22f98","stateId":327,"easy":"إذا دعوت «اللهم إني أسألك باسمك الطاهر الطيب المبارك الأحب إليك» ← فهو الاسم الذي إذا دُعي به أجاب","cause":"اللَّهمَّ إنِّي أسألُكَ باسمِكَ الطَّاهِرِ الطَّيِّبِ المُبارَكِ الأحَبِّ إليكَ","result":"الذي إذا دُعيتَ به أجَبتَ، وإذا سُئِلتَ به أعطَيتَ","explicit":true,"apply":{"k":"say","t":"«اللهم إني أسألك باسمك الطاهر الطيب المبارك الأحب إليك»"},"otherNeedIds":[4],"ref":"الترغيب والترهيب 2/394","srcLabel":"ابن ماجه","text":[["اللَّهمَّ إنِّي أسألُكَ باسمِكَ الطَّاهِرِ الطَّيِّبِ المُبارَكِ الأحَبِّ إليكَ",1],"، ",["الذي إذا دُعيتَ به أجَبتَ، وإذا سُئِلتَ به أعطَيتَ",2],"، وإذا استُرحِمتَ به رَحِمتَ، وإذا استُفرِجتَ به فَرَّجتَ. قُلتُ: فقالَ يَومًا: يا عائِشةُ هل عَلِمتِ أنَّ اللهَ دَلَّني على الاسمِ الذي إذا دُعيَ به أجابَ؟ قالت: فقُلتُ: بأبي أنتَ وأُمِّي يا رَسولَ اللهِ، فعَلِّمْنيه. قال: إنَّه لا يَنبَغي لكِ يا عائِشةُ. قالت: فتَنَحَّيتُ وجَلَستُ ساعةً ثم قُمتُ فقَبَّلتُ رَأسَه، ثم قُلتُ له يا رَسولَ اللهِ: عَلِّمْنيه. قال: إنَّه لا يَنبَغي لكِ يا عائِشةُ أنْ أُعَلِّمَكِ، إنَّه لا يَنبَغي أنْ تَسألي به شَيئًا لِلدُّنيا. قالت: فقُمتُ فتَوَضَّأتُ ثم صَلَّيتُ رَكعَتَيْنِ ثم قُلتُ: اللَّهمَّ إنِّي أدعوكَ اللهَ وأدعوكَ الرَّحمنَ وأدعوكَ البَرَّ الرَّحيمَ وأدعوكَ بأسمائِكَ الحُسنى كُلِّها ما عَلِمتُ منها وما لم أعلَمْ أنْ تَغفِرَ لي وتَرحَمَني. قالت: فضَحِكَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ثم قال: إنَّه لَفي الأسماءِ التي دَعَوتِ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن ماجه (3859) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › ضحك النبي صلى الله عليه وسلم وتبسمه","dorar":"qz1LJX6g"},{"id":"س-01156","fp":"862d1a059426","stateId":327,"easy":"إذا قلت «يا أرحم الراحمين» ثلاثاً ← يقبل الله عليك فاسأل","cause":"فمَن قالها ثلاثًا","result":"قال له المَلَكُ : إنَّ أرحمَ الراحمينَ قد أقبل عليك فسَلْ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"apply":{"k":"say","t":"«يا أرحم الراحمين»"},"ref":"الجامع الصغير (4/ 40)","srcLabel":"الحاكم","text":["إنَّ للهِ تعالَى مَلَكًا مُوَكَّلًا بمَن يقولُ : يا أرحمَ الراحمينَ ! ",["فمَن قالها ثلاثًا",1]," ",["قال له المَلَكُ : إنَّ أرحمَ الراحمينَ قد أقبل عليك فسَلْ",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (1996) واللفظ له.","bab":"أدعية وأذكار › فضل الذكر","dorar":"lexOqe03"},{"id":"س-06818","fp":"613ce945e0f3","stateId":327,"easy":"إذا دعوت باسم الله الأعظم ← يجيبك","cause":"اسْمُ اللهِ الأعْظَمُ","result":"الذي إذا دُعِيَ بهِ أجابَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الجامع 979","srcLabel":"الطبراني","text":[["اسْمُ اللهِ الأعْظَمُ",1]," ",["الذي إذا دُعِيَ بهِ أجابَ",2]," ؛ في ثلاثِ سُوَرٍ من القُرآنِ : في ( البَقرةِ ) و ( آلِ عِمْرانَ ) ، و ( طه )"],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (8/282) (7925)","bab":"عقيدة › إثبات أسماء الله","dorar":"cdqbvyUQ"},{"id":"س-08172","fp":"901c32069ba5","stateId":328,"easy":"إذا قرأت الفاتحة وخواتيم البقرة ← لن تقرأ بحرف منهما إلا أُعطيته","cause":"فاتِحةُ الكِتابِ، وخَواتيمُ سورةِ البَقَرةِ، لَن تَقرَأَ بحَرفٍ منهما","result":"إلَّا أُعطيتَه","explicit":true,"star":true,"apply":{"k":"read","t":"الفاتحة وخواتيم البقرة"},"ref":"صحيح مسلم 806","srcLabel":"متفق عليه","text":["بينَما جِبريلُ قاعِدٌ عِندَ النَّبيِّ صلَّى اللهُ عليه وسلَّم سَمِعَ نَقيضًا مِن فوقِه، فرَفَعَ رَأسَه، فقال: هذا بابٌ مِنَ السَّماءِ فُتِحَ اليومَ لَم يُفتَحْ قَطُّ إلَّا اليَومَ، فنَزَلَ منه مَلَكٌ، فقال: هذا مَلَكٌ نَزَلَ إلى الأرضِ لَم يَنزِلْ قَطُّ إلَّا اليَومَ، فسَلَّمَ، وقال: أبشِرْ بنورَينِ أوتيتَهُما لَم يُؤتَهُما نَبيٌّ قَبلَكَ: ",["فاتِحةُ الكِتابِ، وخَواتيمُ سورةِ البَقَرةِ، لَن تَقرَأَ بحَرفٍ منهما",1]," ",["إلَّا أُعطيتَه",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"ملائكة › أعمال الملائكة","dorar":"yApFspYz","merged":4,"otherRefs":["صحيح ابن حبان 778 (صحيح)","المستدرك على الصحيحين 2078 (صحيح)","صحيح النسائي 911 (صحيح)"]},{"id":"س-03652","fp":"ab9721c9a33c","stateId":328,"easy":"إذا قلت في صلاتك «اهدنا الصراط المستقيم» ← يقول الله: ولعبدي ما سأل","cause":"يقولُ العبدُ: اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ","result":"فهؤلاءِ لِعبدي، ولِعبدي ما سألَ","explicit":true,"star":true,"apply":{"k":"say","t":"«اهدنا الصراط المستقيم»"},"otherNeedIds":[15],"ref":"صحيح أبي داود 821","srcLabel":"مسلم","text":["مَن صلَّى صلاةً لم يقرَأْ فيها بأُمِّ القرآنِ فهي خِداجٌ، فهي خِداجٌ، فهي خِداجٌ غيرُ تمامٍ، قال: فقلتُ يا أبا هُريرةَ، إنِّي أكونُ أحيانًا وراءَ الإمامِ، قال: فغمَزَ ذِراعي، وقال: اقرأْ بها يا فارسيُّ في نفْسِك؛ فإنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: قال اللهُ تعالى: قسَمْتُ الصَّلاةَ بَيْني وبينَ عبدي نصفَيْنِ؛ فنِصْفُها لي، ونِصْفُها لعبدي، ولِعبدي ما سألَ، قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: اقرؤوا، يقولُ العبدُ: {الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ} [الفاتحة: 2]، يقولُ اللهُ عزَّ وجلَّ: حَمِدَني عبدي، يقولُ: {الرَّحْمَنِ الرَّحِيمِ} [الفاتحة: 3]، يقولُ اللهُ عزَّ وجلَّ: أثنى عليَّ عبدي، يقولُ العبدُ: {مَالِكِ يَوْمِ الدِّينِ} [الفاتحة: 4]، يقولُ اللهُ عزَّ وجلَّ: مجَّدَني عبدي، يقولُ العبدُ: {إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ} [الفاتحة: 5]، يقولُ اللهُ: وهذه بَيْني وبينَ عبدي، ولِعبدي ما سألَ، ",["يقولُ العبدُ: {اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ",1]," (6) صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ} [الفاتحة: 6، 7]، يقولُ اللهُ: ",["فهؤلاءِ لِعبدي، ولِعبدي ما سألَ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (395)، وأبو داود (821) واللفظ له، والترمذي (2953)، والنسائي (909)، وابن ماجه (838)، وأحمد (7291)","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"07Zj3UP5","merged":3,"otherRefs":["صحيح ابن ماجه 3066 (صحيح)","صحيح مسلم 395 (صحيح)"]},{"id":"س-00098","fp":"88259fc12d5c","stateId":328,"easy":"إذا سبّحت عشراً وكبّرت عشراً وحمدت عشراً ثم سألت ← يقول الله: نعم نعم","cause":"سَبِّحي اللهَ عَشْرًا، وكَبِّري اللهَ عَشْرًا، واحْمَديه عَشْرًا","result":"ثُمَّ سَليه ما شِئْتِ، يَقولُ: نَعمْ نَعمْ","explicit":true,"star":true,"similar":["س-00846","س-00097","س-07093","س-01030"],"ref":"الأحاديث المختارة 1515","srcLabel":"البخاري","text":["«أنَّ أُمَّ سُلَيمٍ جاءَتْ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فقالَتْ: عَلِّمْني شَيئًا أَدْعو به في صَلاتي، فقالَ: ",["سَبِّحي اللهَ عَشْرًا، وكَبِّري اللهَ عَشْرًا، واحْمَديه عَشْرًا",1],"، ",["ثُمَّ سَليه ما شِئْتِ، يَقولُ: نَعمْ نَعمْ",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"آداب الدعاء › استجابة الدعاء","dorar":"a64KYJmY"},{"id":"س-00027","fp":"a4d1fee6354a","stateId":328,"easy":"إذا قلت «غفرانك ربنا» ← يقول الله: قد غفرت لكم","cause":"فلمَّا قال: غُفْرَانَكَ رَبَّنَا","result":"قال: اللهُ عزَّ وجلَّ: قد غَفَرتُ لكم، فلمَّا","explicit":true,"star":true,"apply":{"k":"say","t":"«غفرانك ربنا»"},"otherNeedIds":[11],"ref":"تخريج مشكل الآثار 1630","srcLabel":"مسلم","text":["لمَّا نَزَلتْ هذه الآيةُ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ {آمَنَ الرَّسُولُ بِمَا أُنْزِلَ إِلَيْهِ مِنْ رَبِّهِ} [البقرة: 285] قَرَأَها رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، ",["فلمَّا قال: {غُفْرَانَكَ رَبَّنَا",1],"} [البقرة: 285] ",["قال: اللهُ عزَّ وجلَّ: قد غَفَرتُ لكم، فلمَّا",2]," قال: {لَا تُؤَاخِذْنَا إِنْ نَسِينَا أَوْ أَخْطَأْنَا} [البقرة: 286] قال اللهُ عزَّ وجلَّ: لا أُؤاخِذُكم، فلمَّا قال: {رَبَّنَا وَلا تَحْمِلْ عَلَيْنَا إِصْرًا كَمَا حَمَلْتَهُ عَلَى الَّذِينَ مِنْ قَبْلِنَا} [البقرة: 286] قال اللهُ عزَّ وجلَّ: لا أَحمِلُ عليكم، قال: فلمَّا قال: عزَّ وجلَّ: {وَلا تُحَمِّلْنَا مَا لا طَاقَةَ لَنَا بِهِ} [البقرة: 286] قال اللهُ عزَّ وجلَّ: لا أُحمِّلُكم، فلمَّا قال: {وَاعْفُ عَنَّا} [البقرة: 286] قال اللهُ: قد عَفَوتُ عنكم، فلمَّا قال: {وَاغْفِرْ لَنَا} [البقرة: 286] قال: قد غَفَرتُ لكم، فلمَّا قال: {وَارْحَمْنَا} [البقرة: 286] قال: قد رَحِمْتُكم، فلمَّا قال: {فَانْصُرْنَا عَلى الْقَوْمِ الْكَافِرِينَ} [البقرة: 286] قال: قد نَصَرتُكم."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (1630)، واللفظ له، والبزار في ((البحر الزخار)) (5103)، والبيهقي في ((شعب الإيمان)) (2185)، باختلاف يسير، وأصله في مسلم (126)","bab":"آداب الدعاء › استجابة الدعاء","dorar":"zQxemdI6"},{"id":"س-00671","fp":"ab927578c4f7","stateId":328,"easy":"إذا قلت صباحاً ومساءً «اللهم أنت خلقتني وأنت تهديني...» ← لا تسأل الله شيئاً إلا أعطاك","cause":"من قال إذا أصبح وإذا أمسى: اللهمَّ أنت خلقتني وأنت تهديني وأنت تطعمُني وأنت تسقيني وأنت تميتُني وأنت تحييني","result":"لم يسألِ اللهَ شيئًا إلا أعطاه إياه","explicit":true,"apply":{"k":"say","t":"«اللهمَّ أنت خلقتني وأنت تهديني وأنت تطعمُني وأنت تسقيني وأنت تميتُني وأنت تحييني لم يسألِ اللهَ شيئًا إلا أعطاه إياه» · الوقت: صباحاً ومساءً"},"ref":"المتجر الرابح 227","srcLabel":"الطبراني","text":["ألا أحدثُكَ حديثًا سمعتُه من رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ مرارًا ومن أبي بكرٍ رضي الله عنه مرارًا ومن عمرَ رضي الله عنه مرارًا؟ قلتُ: بلى قال: ",["من قال إذا أصبح وإذا أمسى: اللهمَّ أنت خلقتني وأنت تهديني وأنت تطعمُني وأنت تسقيني وأنت تميتُني وأنت تحييني",1]," ",["لم يسألِ اللهَ شيئًا إلا أعطاه إياه",2]," قال: فلقيتُ عبدَ اللهِ بنَ سلامٍ فقلتُ: ألا أحدثُكَ حديثًا سمعتُه من رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ مرارًا ومن أبي بكرٍ رضي الله عنه مرارًا ومن عمرَ رضي الله عنه مرارًا؟ قال: بلى، فحدثته بهذا الحديثِ فقال: بأبي وأمي رسولَ اللهِ هؤلاء الكلماتُ كان اللهُ عزَّ وجلَّ أعطاهنَّ موسى عليه السلامُ فكان يدعو بهن في كلِّ يومٍ سبعَ مراتٍ فلا يسألُ اللهَ شيئًا إلا أعطاه إياه."],"grade":"حسن","narrator":"سمرة بن جندب","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((الأوسط)) (1028) بلفظه","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"9XTfUGfp"},{"id":"س-00846","fp":"8916ed1b76d9","stateId":328,"easy":"إذا قمت إلى الصلاة فسبّحت وهلّلت وحمدت عشراً ثم سألت ← يقول الله: قد فعلت","cause":"إذا قُمتِ إلى الصَّلاةِ فسَبِّحي اللهَ تعالى عَشرًا، وهَلِّلِيه عَشرًا، واحمَدِيه عَشرًا، وكَبِّريه عَشرًا، واستَغفِريه عَشرًا","result":"فإنَّكِ إذا سبَّحتِ قال: هذا لي، وإذا هَلَّلتِ قال: هذا لي، وإذا حَمِدتِ قال: هذا لي، وإذا كبَّرْتِ قال: هذا لي، وإذا استَغفَرْتِ قال: قد فعَلْتُ","explicit":true,"repOf":"س-00098","otherNeedIds":[11],"ref":"الفتوحات الربانية 2/148","text":["يا رَسولَ اللهِ، دُلَّني على عَمَلٍ يأجُرُني اللهُ عزَّ وجَلَّ عليه، قال: يا أمَّ رافعٍ، ",["إذا قُمتِ إلى الصَّلاةِ فسَبِّحي اللهَ تعالى عَشرًا، وهَلِّلِيه عَشرًا، واحمَدِيه عَشرًا، وكَبِّريه عَشرًا، واستَغفِريه عَشرًا",1],"؛ ",["فإنَّكِ إذا سبَّحتِ قال: هذا لي، وإذا هَلَّلتِ قال: هذا لي، وإذا حَمِدتِ قال: هذا لي، وإذا كبَّرْتِ قال: هذا لي، وإذا استَغفَرْتِ قال: قد فعَلْتُ",2]],"grade":"حسن","narrator":"سلمى مولاة النبي صلى الله عليه وسلم","muhaddith":"حسن","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"9Boc3jww"},{"id":"س-00097","fp":"24a95dbc6f87","stateId":328,"easy":"إذا كبرت وسبحت وحمدت عشراً ثم سألت حاجتك ← يقول الله: قد فعلت","cause":"كَبِّري اللهَ عَشْرًا، وسَبِّحي اللهَ عَشْرًا، واحْمَدي اللهَ عَشْرًا، ثُمَّ سَلي ما شِئْتِ، يَقولُ: نَعمْ نَعمْ","result":"عَلِّمْني كَلِماتٍ أَدْعو بِهنَّ في صَلاتي","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-00098","ref":"الأحاديث المختارة 1516","text":["«أنَّ أُمَّ سُلَيمٍ جاءَتْ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فقالَتْ أُمُّ سُلَيمٍ: ",["عَلِّمْني كَلِماتٍ أَدْعو بِهنَّ في صَلاتي،",2]," فقالَ: ",["كَبِّري اللهَ عَشْرًا، وسَبِّحي اللهَ عَشْرًا، واحْمَدي اللهَ عَشْرًا، ثُمَّ سَلي ما شِئْتِ، يَقولُ: نَعمْ نَعمْ».",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"آداب الدعاء › استجابة الدعاء","dorar":"SvrhiJOf","merged":3,"otherRefs":["مجالس أمالي صلاة التسبيح 1/31 (صحيح)","المستدرك على الصحيحين 1208 (صحيح)"]},{"id":"س-07093","fp":"2195991dac42","stateId":328,"easy":"إذا سبحت وحمدت وكبرت عشراً ثم سألت ← يقول الله: نعم","cause":"تُسبِّحينَ اللَّهَ عزَّ وجلَّ عَشرًا ، وتحمَدينَهُ عَشرًا ، وتُكَبِّرينَهُ عَشرًا ، ثمَّ سَلي حاجتَكِ ، فإنَّهُ يقولُ : قد فَعلتُ","result":"علِّمني كَلِماتٍ أدعو بِهِنَّ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-00098","ref":"الصحيح المسند 47","text":["جاءَت أمُّ سُلَيْمٍ إلى النَّبيِّ - صلَّى اللَّه عليهِ وعلَى آلِهِ وسلَّمَ - فقالَت: يا رسولَ اللَّهِ ، ",["علِّمني كَلِماتٍ أدعو بِهِنَّ",2]," قالَ: ",["تُسبِّحينَ اللَّهَ عزَّ وجلَّ عَشرًا ، وتحمَدينَهُ عَشرًا ، وتُكَبِّرينَهُ عَشرًا ، ثمَّ سَلي حاجتَكِ ، فإنَّهُ يقولُ : قد فَعلتُ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"حسن على شرط مسلم","bab":"علم › تعليم الناس وفضل ذلك","dorar":"V7pSZWmJ"},{"id":"س-01030","fp":"a3fa5e4676df","stateId":328,"easy":"إذا كبرت وسبحت وقلت «اللهم اغفر لي» عشراً ← يقول الله: قد فعلت","cause":"قولي: اللهُ أكبرُ عشرَ مراتٍ يقولُ اللهُ: هذا لي وقولي: سبحانَ اللهِ عشرَ مراتٍ يقولُ اللهُ: هذا لي وقولي: اللهمَّ اغفرْ لي يقولُ اللهُ: قد فعلتُ فتقولين: عشرَ مراتٍ ويقولُ: قد فعلتُ","result":"أخبرْني بكلماتٍ ولا تكثرْ عليَّ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«اللهم اغفر لي»"},"repOf":"س-00098","otherNeedIds":[11],"ref":"المتجر الرابح 218","text":["يا رسولَ اللهِ ",["أخبرْني بكلماتٍ ولا تكثرْ عليَّ",2]," فقال: ",["قولي: اللهُ أكبرُ عشرَ مراتٍ يقولُ اللهُ: هذا لي وقولي: سبحانَ اللهِ عشرَ مراتٍ يقولُ اللهُ: هذا لي وقولي: اللهمَّ اغفرْ لي يقولُ اللهُ: قد فعلتُ فتقولين: عشرَ مراتٍ ويقولُ: قد فعلتُ.",1]],"grade":"صحيح","narrator":"سلمى مولاة النبي صلى الله عليه وسلم","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني (24/ 302) (766)، وأبو نعيم في ((معرفة الصحابة)) (7930) واللفظ لهما وابن السني في ((عمل اليوم والليلة)) (107) بنحوه","bab":"أدعية وأذكار › فضل الذكر","dorar":"YApAU8Si"},{"id":"س-00035","fp":"196d81fca2e8","stateId":329,"easy":"إذا دعوت بدعوة ذي النون ← يستجيب الله لك","cause":"لم يَدْعُ بِها أحَدٌ","result":"إلَّا اسْتُجيبَ له","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-00096","ref":"الصحيح المسند 1/325","text":["ذَكَرَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ دَعْوةَ ذي النُّونِ، قالَ: وجاءَ أعْرابيٌّ فشَغَلَه، فاتَّبَعْتُه، فالْتَفَتَ إليَّ، فقالَ: «أبا إسْحاقَ»، قُلْتُ: نَعمْ، قالَ: «فمَهْ؟» قُلْتُ: ذَكَرْتَ دَعْوةَ ذي النُّونِ، ثُمَّ جاءَ أعْرابيٌّ فشَغَلَك، قالَ: «نَعمْ، دَعْوةُ ذي النُّونِ إذ نادى في بَطْنِ الحوتِ: لا إلهَ إلَّا أنت سُبْحانَك إنِّي كُنْتُ مِن الظَّالِمينَ؛ فإنَّه ",["لم يَدْعُ بِها أحَدٌ",1]," ",["إلَّا اسْتُجيبَ له»",2],"."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"صحيح لغيره","bab":"آداب الدعاء › استجابة الدعاء","dorar":"wXD7MBGB"},{"id":"س-00096","fp":"38cc676f99f6","stateId":329,"easy":"إذا دعوت بدعوة ذي النون ← يستجيب الله لك","cause":"لم يَدْعُ بها مُسلِمٌ رَبَّه في شيءٍ قَطُّ","result":"إلَّا اسْتَجابَ له","explicit":true,"star":true,"similar":["س-00035"],"ref":"الأحاديث المختارة 1041","srcLabel":"البخاري","text":["«مَرَرْتُ بعُثْمانَ بنِ عفَّانَ في المَسجِدِ فسَلَّمْتُ عليه، فمَلَأَ عَيْنَيه مِنِّي، ثُمَّ لم يَرُدَّ علَيَّ السَّلامَ، فأتَيْتُ أميرَ المُؤمِنينَ عُمَرَ بنَ الخَطَّابِ فقُلْتُ: يا أميرَ المُؤمِنينَ، هلْ حَدَثَ في الإسْلامِ شيءٌ؟ مَرَّتَينِ، قالَ: لا، وما ذاك؟ قالَ: قُلْتَ: لا، إلَّا أنِّي مَرَرْتُ بعُثْمانَ آنِفًا في المَسجِدِ فسَلَّمْتُ عليه فمَلَأَ عَيْنَيه مِنِّي ثُمَّ لم يَرُدَّ علَيَّ السَّلامَ، قالَ: فأَرسَلَ عُمَرُ إلى عُثْمانَ فدَعاه، فقالَ: ما مَنَعَك ألَّا تكونَ رَدَدْتَ على أخيك السَّلامَ؟ قالَ عُثْمانُ: ما فَعَلْتَ، قالَ سَعْدٌ: قُلْتُ: بَلى، قالَ: حتَّى حَلَفَ وحَلَفْتُ، قالَ: ثُمَّ إنَّ عُثْمانَ ذَكَرَ، فقالَ: بَلى، وأَسْتَغْفِرُ اللهَ وأَتوبُ إليه، إنَّك مَرَرْتَ بي آنِفًا، وأنا أُحَدِّثُ نفْسي بكَلِمةٍ سَمِعْتُها مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، لا واللهِ ما ذَكَرْتُها قَطُّ إلَّا تَغَشَّى بَصَري وقَلْبي غِشاوةٌ، قالَ: قالَ سَعْدٌ: فأنا أُنْبِئُك بها، إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم ذَكَرَ لنا أوَّلَ دَعْوةٍ، ثُمَّ جاءَ أعْرابيٌّ فشَغَلَه حتَّى قامَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فأَتْبَعْتُه، فلمَّا أَشْفَقْتُ أن يَسبِقَني إلى مَنزِلِه ضَرَبْتُ بقَدَمي الأرْضَ، فالْتَفَتَ إليَّ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فقالَ: مَن هذا، أبو إسْحاقَ؟ قالَ: قُلْتُ: نَعمْ يا رَسولَ اللهِ، قالَ: فمَهْ؟ قالَ: قُلْتُ: لا واللهِ إلَّا أنَّك ذَكَرْتَ لنا أوَّلَ دَعْوةٍ، ثُمَّ جاءَ هذا الأعْرابيُّ فشَغَلَك، قالَ: نَعمْ، دَعْوةُ ذي النُّونِ، إذ هو في بَطْنِ الحوتِ {لَا إِلَهَ إِلَّا أَنْتَ سُبْحَانَكَ إِنِّي كُنْتُ مِنَ الظَّالِمِينَ}، فإنهَّ ",["لم يَدْعُ بها مُسلِمٌ رَبَّه في شيءٍ قَطُّ",1]," ",["إلَّا اسْتَجابَ له",2],".\nوفي رِوايةٍ: هل حَدَثَ في الإسْلامِ شيءٌ؟ قالَ: وما ذاك؟ وعنْدَه: ما يَمنَعُك؟ وعنْدَه: فقالَ عُثْمانُ: ما فَعَلْتَ؟! وفيه: ثُمَّ إنَّ عُثْمانَ ذَكَرَ، وعنْدَه: غِشاوةٌ فقالَ سَعْدٌ، وعنْدَه: فشَغَلَه ثُمَّ قامَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، وليس عنْدَه: فشَغَلَك»."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"آداب الدعاء › استجابة الدعاء","dorar":"kNNF624s"},{"id":"ق-0075","fp":"18850aa70de3","stateId":329,"easy":"سؤال حسنة الدنيا وحسنة الآخرة والوقاية من النار ← نصيب مما كسبوا","cause":"سؤال حسنة الدنيا وحسنة الآخرة والوقاية من النار","result":"نصيب مما كسبوا","explicit":true,"otherNeedIds":[45],"ref":"سورة البقرة: 201–202","srcLabel":"القرآن الكريم","quran":{"s":2,"from":201,"to":202,"text":"وَمِنْهُمْ مَنْ يَقُولُ رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ (201) أُولَئِكَ لَهُمْ نَصِيبٌ مِمَّا كَسَبُوا وَاللَّهُ سَرِيعُ الْحِسَابِ (202)","hl":[[0,121,1],[121,161,2],[161,190,1]]}},{"id":"ق-0198","fp":"2f31c36b9f1c","stateId":329,"easy":"ذكر الله قياماً وقعوداً وعلى الجنوب والتفكر في خلقه والدعاء ← استجابة الله وعدم ضياع عمل عامل","cause":"ذكر الله قياماً وقعوداً وعلى الجنوب والتفكر في خلقه والدعاء","result":"استجابة الله وعدم ضياع عمل عامل","explicit":true,"otherNeedIds":[45],"ref":"سورة آل عمران: 191–195","srcLabel":"القرآن الكريم","quran":{"s":3,"from":191,"to":195,"text":"الَّذِينَ يَذْكُرُونَ اللَّهَ قِيَامًا وَقُعُودًا وَعَلَى جُنُوبِهِمْ وَيَتَفَكَّرُونَ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ رَبَّنَا مَا خَلَقْتَ هَذَا بَاطِلًا سُبْحَانَكَ فَقِنَا عَذَابَ النَّارِ (191) رَبَّنَا إِنَّكَ مَنْ تُدْخِلِ النَّارَ فَقَدْ أَخْزَيْتَهُ وَمَا لِلظَّالِمِينَ مِنْ أَنْصَارٍ (192) رَبَّنَا إِنَّنَا سَمِعْنَا مُنَادِيًا يُنَادِي لِلْإِيمَانِ أَنْ آمِنُوا بِرَبِّكُمْ فَآمَنَّا رَبَّنَا فَاغْفِرْ لَنَا ذُنُوبَنَا وَكَفِّرْ عَنَّا سَيِّئَاتِنَا وَتَوَفَّنَا مَعَ الْأَبْرَارِ (193) رَبَّنَا وَآتِنَا مَا وَعَدْتَنَا عَلَى رُسُلِكَ وَلَا تُخْزِنَا يَوْمَ الْقِيَامَةِ إِنَّكَ لَا تُخْلِفُ الْمِيعَادَ (194) فَاسْتَجَابَ لَهُمْ رَبُّهُمْ أَنِّي لَا أُضِيعُ عَمَلَ عَامِلٍ مِنْكُمْ مِنْ ذَكَرٍ أَوْ أُنْثَى بَعْضُكُمْ مِنْ بَعْضٍ فَالَّذِينَ هَاجَرُوا وَأُخْرِجُوا مِنْ دِيَارِهِمْ وَأُوذُوا فِي سَبِيلِي وَقَاتَلُوا وَقُتِلُوا لَأُكَفِّرَنَّ عَنْهُمْ سَيِّئَاتِهِمْ وَلَأُدْخِلَنَّهُمْ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ ثَوَابًا مِنْ عِنْدِ اللَّهِ وَاللَّهُ عِنْدَهُ حُسْنُ الثَّوَابِ (195)","hl":[[0,630,1],[630,727,2]]}},{"id":"ق-0761","fp":"485adc46cd91","stateId":329,"easy":"الدعاء بشرح الصدر وتيسير الأمر ← إيتاء السؤل","cause":"الدعاء بشرح الصدر وتيسير الأمر","result":"إيتاء السؤل","explicit":true,"otherNeedIds":[5,54],"ref":"سورة طه: 25–36","srcLabel":"القرآن الكريم","quran":{"s":20,"from":25,"to":36,"text":"قَالَ رَبِّ اشْرَحْ لِي صَدْرِي (25) وَيَسِّرْ لِي أَمْرِي (26) وَاحْلُلْ عُقْدَةً مِنْ لِسَانِي (27) يَفْقَهُوا قَوْلِي (28) وَاجْعَلْ لِي وَزِيرًا مِنْ أَهْلِي (29) هَارُونَ أَخِي (30) اشْدُدْ بِهِ أَزْرِي (31) وَأَشْرِكْهُ فِي أَمْرِي (32) كَيْ نُسَبِّحَكَ كَثِيرًا (33) وَنَذْكُرَكَ كَثِيرًا (34) إِنَّكَ كُنْتَ بِنَا بَصِيرًا (35) قَالَ قَدْ أُوتِيتَ سُؤْلَكَ يَا مُوسَى (36)","hl":[[0,336,1],[336,375,2]]}},{"id":"ق-0795","fp":"7f82e14cc13f","stateId":329,"easy":"نداء الله عند الضر: «أني مسني الضر وأنت أرحم الراحمين» ← كشف الضر وإيتاء الأهل ومثلهم معهم","cause":"نداء الله عند الضر: «أني مسني الضر وأنت أرحم الراحمين»","result":"كشف الضر وإيتاء الأهل ومثلهم معهم","explicit":true,"apply":{"k":"say","t":"«أني مسني الضر وأنت أرحم الراحمين»"},"otherNeedIds":[35,4,37],"ref":"سورة الأنبياء: 83–84","srcLabel":"القرآن الكريم","quran":{"s":21,"from":83,"to":84,"text":"وَأَيُّوبَ إِذْ نَادَى رَبَّهُ أَنِّي مَسَّنِيَ الضُّرُّ وَأَنْتَ أَرْحَمُ الرَّاحِمِينَ (83) فَاسْتَجَبْنَا لَهُ فَكَشَفْنَا مَا بِهِ مِنْ ضُرٍّ وَآتَيْنَاهُ أَهْلَهُ وَمِثْلَهُمْ مَعَهُمْ رَحْمَةً مِنْ عِنْدِنَا وَذِكْرَى لِلْعَابِدِينَ (84)","hl":[[0,94,1],[94,238,2]]}},{"id":"ق-0797","fp":"f532cc799bd2","stateId":329,"easy":"التسبيح والاعتراف بالذنب في الكرب: «لا إله إلا أنت سبحانك إني كنت من الظالمين» ← الاستجابة والنجاة من الغم وكذلك ينجي الله المؤمنين","cause":"التسبيح والاعتراف بالذنب في الكرب: «لا إله إلا أنت سبحانك إني كنت من الظالمين»","result":"الاستجابة والنجاة من الغم وكذلك ينجي الله المؤمنين","explicit":true,"apply":{"k":"say","t":"«لا إله إلا أنت سبحانك إني كنت من الظالمين»"},"otherNeedIds":[4],"ref":"سورة الأنبياء: 87–88","srcLabel":"القرآن الكريم","quran":{"s":21,"from":87,"to":88,"text":"وَذَا النُّونِ إِذْ ذَهَبَ مُغَاضِبًا فَظَنَّ أَنْ لَنْ نَقْدِرَ عَلَيْهِ فَنَادَى فِي الظُّلُمَاتِ أَنْ لَا إِلَهَ إِلَّا أَنْتَ سُبْحَانَكَ إِنِّي كُنْتُ مِنَ الظَّالِمِينَ (87) فَاسْتَجَبْنَا لَهُ وَنَجَّيْنَاهُ مِنَ الْغَمِّ وَكَذَلِكَ نُنْجِي الْمُؤْمِنِينَ (88)","hl":[[0,180,1],[180,262,2]]}},{"id":"ق-1154","fp":"e22a89bd835d","stateId":329,"easy":"الإيمان والعمل الصالح ← استجابة الله لهم وزيادتهم من فضله","cause":"الإيمان والعمل الصالح","result":"استجابة الله لهم وزيادتهم من فضله","explicit":true,"otherNeedIds":[1],"ref":"سورة الشورى: 26","srcLabel":"القرآن الكريم","quran":{"s":42,"from":26,"to":26,"text":"وَيَسْتَجِيبُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَيَزِيدُهُمْ مِنْ فَضْلِهِ وَالْكَافِرُونَ لَهُمْ عَذَابٌ شَدِيدٌ (26)","hl":[[0,13,2],[13,57,1],[57,84,2]]}},{"id":"ق-1359","fp":"ba3b2490040c","stateId":329,"easy":"الإيمان والدعاء بالنجاة وبيت في الجنة ← ضرب الله بها المثل للمؤمنين","cause":"الإيمان والدعاء بالنجاة وبيت في الجنة","result":"ضرب الله بها المثل للمؤمنين","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[67],"ref":"سورة التحريم: 11","srcLabel":"القرآن الكريم","quran":{"s":66,"from":11,"to":11,"text":"وَضَرَبَ اللَّهُ مَثَلًا لِلَّذِينَ آمَنُوا امْرَأَتَ فِرْعَوْنَ إِذْ قَالَتْ رَبِّ ابْنِ لِي عِنْدَكَ بَيْتًا فِي الْجَنَّةِ وَنَجِّنِي مِنْ فِرْعَوْنَ وَعَمَلِهِ وَنَجِّنِي مِنَ الْقَوْمِ الظَّالِمِينَ (11)","hl":[[0,64,2],[64,203,1]]}},{"id":"س-06058","fp":"f123426600c6","stateId":329,"easy":"إذا قلت «اللهم إني أسألك تعجيل عافيتك وصبراً على بليتك...» ← يعطيك الله إحداهن","cause":"اللَّهُمَّ إنِّي أَسألُكَ تَعجيلَ عافيتِكَ، وصَبرًا على بليَّتِكَ، أوْ خُروجًا مِنَ الدُّنيا إلى رحمتِكَ","result":"فإنَّه مُعطيكَ إحداهُنَّ","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"apply":{"k":"say","t":"«اللَّهُمَّ إنِّي أَسألُكَ تَعجيلَ عافيتِكَ، وصَبرًا على بليَّتِكَ، أوْ خُروجًا مِنَ الدُّنيا إلى رحمتِك»"},"otherNeedIds":[9],"ref":"المستدرك على الصحيحين 1941","srcLabel":"ابن حبان","text":["أَتى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ جِبريلُ عليه السَّلامُ، فقالَ: إنَّ اللهَ يَأمرُكَ أنْ تَدعوَ بهؤلاء الكلماتِ؛ ",["فإنَّه مُعطيكَ إحداهُنَّ",2],": ",["اللَّهُمَّ إنِّي أَسألُكَ تَعجيلَ عافيتِكَ، وصَبرًا على بليَّتِكَ، أوْ خُروجًا مِنَ الدُّنيا إلى رحمتِكَ",1],"."],"grade":"صحيح","narrator":"عائشة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن حبان (922)، وابن أبي الدنيا في ((الصبر والثواب عليه)) (68) بلفظه.","bab":"رقائق وزهد › فضل الصبر","dorar":"r4dBCxKL"},{"id":"س-08382","fp":"b301464443f9","stateId":329,"easy":"إذا دعوت «اللهم إني أسألك صحة في إيمان...» ليلاً ونهاراً ← (دعاء نبوي جامع)","cause":"تَسألُهنَّ الرَّحمنَ، وتَرغبُ إليه فيهنَّ، وتَدعو بهنَّ في اللَّيلِ والنَّهارِ","result":"قُلِ: اللَّهُمَّ إنِّي أَسألُكَ صِحَّةً في إيمانٍ، وإيمانًا في حُسنِ خُلقٍ، ونجاحًا يَتبعُهُ فلاحٌ ورحمةٌ منكَ وعافيةٌ ومغفرةٌ منكَ ورِضوانًا","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"apply":{"k":"say","t":"«اللَّهُمَّ إنِّي أَسألُكَ صِحَّةً في إيمانٍ، وإيمانًا في حُسنِ خُلقٍ، ونجاحًا يَتبعُهُ فلاحٌ ورحمةٌ منكَ وعافيةٌ ومغفرةٌ منكَ ورِضوانًا»"},"otherNeedIds":[15],"ref":"المستدرك على الصحيحين 1943","srcLabel":"النسائي","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ وَصَّى سَلمانَ الخيرِ، فقالَ: يا سَلمانُ، إنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يُريدُ أنْ يَمنحَكَ كلماتٍ ",["تَسألُهنَّ الرَّحمنَ، وتَرغبُ إليه فيهنَّ، وتَدعو بهنَّ في اللَّيلِ والنَّهارِ",1],"؛ ",["قُلِ: اللَّهُمَّ إنِّي أَسألُكَ صِحَّةً في إيمانٍ، وإيمانًا في حُسنِ خُلقٍ، ونجاحًا يَتبعُهُ فلاحٌ ورحمةٌ منكَ وعافيةٌ ومغفرةٌ منكَ ورِضوانًا",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (8272)، والنسائي في ((الكبرى)) (9765)، وإسحاق في ((مسنده)) (327) باختلاف يسير.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"srf3kdQ2"},{"id":"س-03222","fp":"e2084ca6efef","stateId":330,"easy":"إذا استسقيت فقل «اللهم اسقنا غيثاً مغيثاً...» ← يُرجى الغيث","cause":"اللَّهُمَّ اسْقِنا غَيثًا مُغيثًا","result":"اللَّهُمَّ اسْقِنا الغَيثَ ولا تَجعَلْنا من القانِطين","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد","دعاء أو ذكر لم يُذكر له أثر صريح"],"apply":{"k":"say","t":"«اللَّهُمَّ اسْقِنا غَيثًا مُغيثًا، هَنيئًا مَريئًا، مَريعًا، غَدَقًا مُجلِّلًا، عامًّا طَبَقًا سَحًّا دائمًا، اللَّهُمَّ اسْقِنا الغَيثَ ولا تَجعَلْنا من القانِطين، اللَّهُمَّ إنَّ بالعِبادِ والبِلادِ والبَهائِمِ والخَلْقِ من اللَّأْواءِ والجَهدِ والضَّنْكِ ما لا نَشكوه إلَّا إليك، اللَّهُمَّ أنْبِتْ لنا الزَّرْعَ، وأدِرَّ لنا الضَّرْعَ، واسْقِنا من بَرَكاتِ السَّماءِ، وأنْبِتْ لنا من بَرَكاتِ الأرضِ، اللَّهُمَّ ارفَعْ عنَّا الجَهدَ والجوعَ والعُرْيَ، واكْشِفْ عنَّا من البَلاءِ ما لا يَكشِفُه غيرُك، اللَّهُمَّ إنَّا نَستَغفِرُك إنَّك كُنتَ غَفَّارًا، فأَرْسِلِ السَّماءَ علينا مِدْرارًا»"},"repOf":"س-03227","ref":"سفر السعادة 125","text":[["اللَّهُمَّ اسْقِنا غَيثًا مُغيثًا",1],"، هَنيئًا مَريئًا، مَريعًا، غَدَقًا مُجلِّلًا، عامًّا طَبَقًا سَحًّا دائمًا، ",["اللَّهُمَّ اسْقِنا الغَيثَ ولا تَجعَلْنا من القانِطين",2],"، اللَّهُمَّ إنَّ بالعِبادِ والبِلادِ والبَهائِمِ والخَلْقِ من اللَّأْواءِ والجَهدِ والضَّنْكِ ما لا نَشكوه إلَّا إليك، اللَّهُمَّ أنْبِتْ لنا الزَّرْعَ، وأدِرَّ لنا الضَّرْعَ، واسْقِنا من بَرَكاتِ السَّماءِ، وأنْبِتْ لنا من بَرَكاتِ الأرضِ، اللَّهُمَّ ارفَعْ عنَّا الجَهدَ والجوعَ والعُرْيَ، واكْشِفْ عنَّا من البَلاءِ ما لا يَكشِفُه غيرُك، اللَّهُمَّ إنَّا نَستَغفِرُك إنَّك كُنتَ غَفَّارًا، فأَرْسِلِ السَّماءَ علينا مِدْرارًا."],"grade":"صحيح","muhaddith":"ثابت","bab":"استسقاء › الدعاء في الاستسقاء","dorar":"g5atqVRU"},{"id":"س-07618","fp":"72437d68496c","stateId":330,"easy":"إذا دعوت الله بالغيث ← يُمطرون","cause":"فادعُ اللهَ","result":"فمُطِرنا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-03227","otherNeedIds":[1],"ref":"صحيح البخاري 1033","text":["أصابَتِ النَّاسَ سَنةٌ على عَهدِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فبينا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يَخطُبُ على المِنبَرِ يَومَ الجُمُعةِ قامَ أعرابيٌّ، فقال: يا رَسولَ اللهِ، هَلَكَ المالُ، وجاعَ العيالُ، ",["فادعُ اللهَ",1]," لَنا أن يَسقيَنا، قال: فرَفَعَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يَدَيه وما في السَّماءِ قَزَعةٌ، قال: فثارَ سَحابٌ أمثالُ الجِبالِ، ثُمَّ لَم يَنزِلْ عن مِنبَرِه حتَّى رَأيتُ المَطَرَ يَتَحادَرُ على لحيَتِه، قال: ",["فمُطِرنا",2]," يَومَنا ذلك، وفي الغَدِ، ومِن بَعدِ الغَدِ، والذي يَليه إلى الجُمُعةِ الأُخرى، فقامَ ذلك الأعرابيُّ -أو رَجُلٌ غَيرُه- فقال: يا رَسولَ اللهِ، تَهَدَّمَ البِناءُ وغَرِقَ المالُ، فادعُ اللهَ لَنا، فرَفَعَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يَدَيه، وقال: اللهُمَّ حَوالَينا، ولا علينا. قال: فما جَعَلَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يُشيرُ بيَدِه إلى ناحيةٍ مِنَ السَّماءِ إلَّا تَفَرَّجَت، حتَّى صارَتِ المَدينةُ في مِثلِ الجَوبةِ حتَّى سالَ الوادي -وادي قَناةَ- شَهرًا، قال: فلَم يَجِئْ أحَدٌ مِن ناحيةٍ إلَّا حَدَّثَ بالجَودِ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1033)، ومسلم (897)","bab":"فضائل النبي وصفته ودلائل النبوة › معجزات النبي","dorar":"p2xuRWE8","merged":6,"otherRefs":["نخب الافكار 5/285 (صحيح)","صحيح البخاري 6342 (صحيح)","صحيح البخاري 1015 (صحيح)","تخريج المسند لشعيب 13016 (صحيح)","صحيح النسائي 1527 (صحيح)"]},{"id":"س-03225","fp":"1d5db3c133d7","stateId":330,"easy":"إذا دعوت «اللهم أغثنا» ← يُمطرون","cause":"اللَّهُمَّ أغِثْنا","result":"ثُمَّ أمطَرَت","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«اللهم أغثنا»"},"repOf":"س-03227","ref":"صحيح مسلم 897","text":["أنَّ رَجُلًا دَخَلَ المَسجِدَ يَومَ جُمُعةٍ مِن بابٍ كان نَحوَ دارِ القَضاءِ، ورَسولُ اللهِ صلَّى اللهُ عليه وسلَّم قائِمٌ يَخطُبُ، فاستَقبَلَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قائِمًا، ثُمَّ قال: يا رَسولَ اللهِ، هَلَكَتِ الأموالُ، وانقَطَعَتِ السُّبُلُ، فادعُ اللَّهَ يُغِثْنا، قال: فرَفَعَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يَدَيه، ثُمَّ قال: ",["اللَّهُمَّ أغِثْنا",1],"، اللَّهُمَّ أغِثْنا، اللَّهُمَّ أغِثْنا، قال أنَسٌ: ولا واللَّهِ ما نَرى في السَّماءِ مِن سَحابٍ ولا قَزَعةٍ، وما بينَنا وبينَ سَلْعٍ مِن بَيتٍ ولا دارٍ، قال: فطَلَعَت مِن ورائِه سَحابةٌ مِثلُ التُّرسِ، فلَمَّا تَوسَّطَتِ السَّماءَ انتَشَرَت، ",["ثُمَّ أمطَرَت",2],"، قال: فلا واللَّهِ ما رَأينا الشَّمسَ سَبتًا، قال: ثُمَّ دَخَلَ رَجُلٌ مِن ذلك البابِ في الجُمُعةِ المُقبِلةِ، ورَسولُ اللهِ صلَّى اللهُ عليه وسلَّم قائِمٌ يَخطُبُ، فاستَقبَلَه قائِمًا، فقال: يا رَسولَ اللهِ، هَلَكَتِ الأموالُ وانقَطَعَتِ السُّبُلُ، فادعُ اللَّهَ يُمسِكْها عَنَّا، قال: فرَفَعَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يَدَيه، ثُمَّ قال: اللَّهُمَّ حَولَنا ولا علينا، اللَّهُمَّ على الآكامِ، والظِّرابِ، وبُطونِ الأوديةِ، ومَنابِتِ الشَّجَرِ، فانقَلَعَت، وخَرَجنا نَمشي في الشَّمسِ. قال شَريكٌ: فسَألتُ أنَسَ بنَ مالِكٍ: أهو الرَّجُلُ الأوَّلُ؟ قال: لا أدري."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1014) باختلاف يسير","bab":"استسقاء › الدعاء في الاستسقاء","dorar":"v1mNIlSg","merged":2,"otherRefs":["فتاوى نور على الدرب لابن عثيمين 12/161 (صحيح)"]},{"id":"س-03226","fp":"0775c2986bda","stateId":330,"easy":"إذا استسقيت قائماً مستقبلاً القبلة وحولت رداءك ← يُسقى الناس","cause":"فَدعا اللَّهَ عزَّ وجلَّ قائمًا ثمَّ توجَّهَ قِبَلَ القِبلةِ وحوَّلَ رداءَهُ","result":"فسُقُوا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-03227","ref":"نخب الافكار 5/293","text":["أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ خرجَ بالنَّاسِ إلى المصلَّى يَستَسقي لَهُم فقامَ ",["فَدعا اللَّهَ عزَّ وجلَّ قائمًا ثمَّ توجَّهَ قِبَلَ القِبلةِ وحوَّلَ رداءَهُ",1]," ",["فسُقُوا",2]],"grade":"صحيح","narrator":"عم عباد بن تميم","muhaddith":"طريقه صحيح","takhrij":"أخرجه الطحاوي في ((شرح معاني الآثار)) (1899)، والبخاري (1023)، وأحمد (16455) جميعهم بلفظه.","bab":"استسقاء › الدعاء في الاستسقاء","dorar":"ACdJnViW"},{"id":"س-03227","fp":"16a624b5d1c0","stateId":330,"easy":"إذا استسقيت ← يُمطرون","cause":"فاستَسْقى","result":"فمُطِرْنا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-03222","س-07618","س-03225","س-03226","س-03228","س-03232","س-03229","س-05972","س-03233","س-04064","س-00687","س-03223","س-03231","س-03224"],"otherNeedIds":[1],"ref":"تخريج المسند لشعيب 13867","srcLabel":"متفق عليه","text":["أنَّ الناسَ قالوا: يا رسولَ اللهِ، هَلَكَ المالُ، أَقْحَطْنا يا رسولَ اللهِ، وهَلَكَ المالُ، فاستَسْقِ لنا. فقام يَومَ الجُمُعةِ وهو على المِنبرِ، ",["فاستَسْقى",1]," -ووصَفَ حَمَّادٌ: بَسَطَ يدَيهِ حِيالَ صَدرِه، وبَطنُ كَفَّيهِ ممَّا يَلي الأرضَ- وما في السَّماءِ قَزَعةٌ، فما انصرَفَ حتى أَهَمَّتِ الشابَّ القَويَّ نفْسُه أنْ يَرجِعَ إلى أهْلِه، ",["فمُطِرْنا",2]," إلى الجُمُعةِ الأُخرى، فقالوا: يا رسولَ اللهِ، تَهَدَّمَ البُنْيانُ، وانقطَعَ الرُّكْبانُ، ادْعُ اللهَ أنْ يَكشِطَها عنا، فضَحِكَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم، وقال: اللَّهمَّ حَوالَيْنا ولا علينا، فانجابَتْ حتى كانتِ المدينةُ كأنَّها في إكْليلٍ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (933)، ومسلم (897) باختلاف يسير","bab":"استسقاء › الدعاء في الاستسقاء","dorar":"BrjN6vx1"},{"id":"س-03228","fp":"90e19f56683d","stateId":330,"easy":"إذا استسقيت ← يُمطرون حتى يُشكى المطر","cause":"فاستَسْقى","result":"الرجوعُ إلى أهلِه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-03227","otherNeedIds":[1],"ref":"تخريج المسند لشعيب 12019","text":["سُئِلَ أَنَسٌ: هل كان النَّبيُّ صلَّى اللهُ عليه وسلَّمَ يرفَعُ يدَيْه؟ فقال: قيل له يومَ الجمُعةِ: يا رسولَ اللهِ، قحَطَ المطَرُ، وأَجدَبَتِ الأرضُ، وهلَكَ المالُ، قال: فرفَعَ يدَيْه حتى رأَيْتُ بياضَ إِبطَيْه، ",["فاستَسْقى",1],"، ولقد رفَعَ يدَيْه، وما يُرى في السماءِ سَحابةٌ، فما قضَيْنا الصلاةَ حتى إنَّ قريبَ الدارِ الشابَّ لَيُهِمُّه ",["الرجوعُ إلى أهلِه",2],"، قال: فلمَّا كانتِ الجمُعةُ التي تَليها قالوا: يا رسولَ اللهِ، تهدَّمَتِ البُيوتُ، واحتَبسَ الرُّكبانُ، فتبسَّمَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ من سُرعةِ مَلالةِ ابنِ آدَمَ، وقال: اللَّهُمَّ حَوالَيْنا ولا علينا، فتكشَّطَتْ عنِ المدينةِ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (1013)، ومسلم (897)، وأبو داود (1175)، والنسائي (1528) بنحوه، وأحمد (12019) واللفظ له","bab":"استسقاء › الدعاء في الاستسقاء","dorar":"k3FbFgvD"},{"id":"س-03232","fp":"b58fa99bba3d","stateId":330,"easy":"إذا استسقيت ← يُسقى الناس حتى يتمزق السحاب (من واقعة)","cause":"فادعُ اللَّهَ أن يسقينا","result":"تمزَّقَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-03227","otherNeedIds":[1],"ref":"صحيح النسائي 1514","text":["بينا نحنُ في المسجدِ يومَ الجمعةِ ورسولُ اللَّهِ صلى الله عليه وسلم يخطبُ النَّاسَ فقامَ رجلٌ يا رسولَ اللَّهِ تقطَّعتِ السُّبلُ وَهلَكتِ الأموالُ وأجدبَ البلادُ ",["فادعُ اللَّهَ أن يسقينا",1],". فرفعَ رسولُ اللَّهِ صلى الله عليه وسلم يديْهِ حذاءَ وجْهِهِ فقالَ: اللَّهمَّ اسقنا. فواللَّهِ ما نزلَ رسولُ اللَّهِ عنِ المنبرِ حتَّى أوسعنا مطرًا وأمطرنا ذلِكَ اليومَ إلى الجمعةِ الأخرى فقامَ رجلٌ  لاَ أدري هوَ الَّذي قالَ لرسولِ اللَّهِ  استسقِ لنا أم لاَ فقالَ يا رسولَ اللَّهِ انقطعتِ السُّبلُ وَهلَكتِ الأموالُ من كثرةِ الماءِ فادعُ اللَّهَ أن يمسِكَ عنَّا الماء.فقالَ رسولُ اللَّهِ: اللَّهمَّ حوالينا ولاَ علينا ولَكن على الجبالِ ومنابتِ الشَّجرِ. قالَ واللَّهِ ما هوَ إلاَّ أن تَكلَّمَ رسولُ اللَّهِ بذلِكَ ",["تمزَّقَ",2]," السَّحابُ حتَّى ما نرى منْهُ شيئًا."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"حسن صحيح","takhrij":"أخرجه النسائي (1515) واللفظ له، والبخاري (7420)، ومسلم (897)، وأبو داود (1174) بمعناه.","bab":"استسقاء › الدعاء في الاستسقاء","dorar":"t7gsFeyY"},{"id":"س-03229","fp":"b6f0404256ff","stateId":330,"easy":"إذا دعوت للغيث ← يُمطرون","cause":"فدَعا رَسولُ اللهِ","result":"فمُطِروا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-03227","ref":"صحيح البخاري 1017","text":["جاءَ رَجُلٌ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: يا رَسولَ اللهِ، هَلَكَتِ المَواشي، وانقَطَعَتِ السُّبُلُ، فادعُ اللهَ، ",["فدَعا رَسولُ اللهِ",1]," صلَّى اللهُ عليه وسلَّم، ",["فمُطِروا",2]," مِن جُمُعةٍ إلى جُمُعةٍ، فجاءَ رَجُلٌ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: يا رَسولَ اللهِ تَهَدَّمَتِ البُيوتُ وتَقَطَّعَتِ السُّبُلُ، وهَلَكَتِ المَواشي! فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: اللهُمَّ على رُؤوسِ الجِبالِ والآكامِ، وبُطونِ الأوديةِ، ومَنابِتِ الشَّجَرِ، فانجابَت عَنِ المَدينةِ انجيابَ الثَّوبِ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه النسائي (1504) واللفظ له، ومسلم (897)، وأبو داود (1174) بنحوه مطولا.","bab":"استسقاء › الدعاء في الاستسقاء","dorar":"1s8PWxm9"},{"id":"س-03230","fp":"b95bc6261058","stateId":330,"easy":"إذا كثر المطر فقل «اللهم حوالينا ولا علينا...» ← ينجاب عنكم","cause":"اللهُمَّ على رُؤوسِ الجِبالِ والآكامِ، وبُطونِ الأوديةِ، ومَنابِتِ الشَّجَرِ","result":"فانجابَت عَنِ المَدينةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«اللهم حوالينا ولا علينا...»"},"similar":["س-07621"],"ref":"صحيح البخاري 1017","srcLabel":"مسلم","text":["جاءَ رَجُلٌ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: يا رَسولَ اللهِ، هَلَكَتِ المَواشي، وانقَطَعَتِ السُّبُلُ، فادعُ اللهَ، فدَعا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فمُطِروا مِن جُمُعةٍ إلى جُمُعةٍ، فجاءَ رَجُلٌ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: يا رَسولَ اللهِ تَهَدَّمَتِ البُيوتُ وتَقَطَّعَتِ السُّبُلُ، وهَلَكَتِ المَواشي! فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["اللهُمَّ على رُؤوسِ الجِبالِ والآكامِ، وبُطونِ الأوديةِ، ومَنابِتِ الشَّجَرِ",1],"، ",["فانجابَت عَنِ المَدينةِ",2]," انجيابَ الثَّوبِ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه النسائي (1504) واللفظ له، ومسلم (897)، وأبو داود (1174) بنحوه مطولا.","bab":"استسقاء › الدعاء في الاستسقاء","dorar":"1s8PWxm9"},{"id":"س-05972","fp":"b1119398ace4","stateId":330,"easy":"إذا أصابك قحط فدعوت الله ← ينبت لك","cause":"إذا أصابَكَ عامُ سَنةٍ فدَعَوتَه","result":"أنبَتَ لَكَ","explicit":true,"repOf":"س-03227","otherNeedIds":[1],"ref":"تخريج المسند لشعيب 23205","text":["عن رَجُلٍ: أنَّه أتى رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم  -أو قال: شَهِدتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم وأتاهُ رَجُلٌ- فقال: أنتَ رَسولُ اللهِ؟ أو قال: أنتَ مُحَمَّدٌ؟ فقال: «نَعَم»، قال: فِإلامَ تَدعو؟ قال: «أدعو إلى اللهِ وحدَه؛ مَن إذا كان بكَ ضُرٌّ فدَعَوتَه كَشَفَه عنكَ، ومَن ",["إذا أصابَكَ عامُ سَنةٍ فدَعَوتَه",1]," ",["أنبَتَ لَكَ",2],"، ومَن إذا كُنتَ في أرضٍ قَفرٍ فأضلَلتَ فدَعَوتَه رَدَّ عليكَ»، قال: فأسلَمَ الرَّجُلُ، ثُمَّ قال: أوصِني يا رَسولَ اللهِ؟ فقال له: «لا تَسُبَّنَّ شَيئًا» -أو قال أحَدًا: شَكَّ الحَكَمُ- قال: فما سَبَبتُ شَيئًا بَعيرًا ولا شاةً مُنذُ أوصاني رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، «ولا تَزهَدْ في المَعروفِ ولَو ببَسطِ وجهكَ إلى أخيكَ وأنتَ تُكَلِّمُه، وأفرِغْ مِن دَلوِكَ في إناءِ المُستَسقي، واتَّزِرْ إلى نِصفِ السَّاقِ، فإن أبَيتَ فإلى الكَعبَينِ، وإيَّاكَ وإسبالَ الإزارِ؛ فإنَّها مِنَ المَخيلةِ، واللهُ لا يُحِبُّ المَخيلةَ»."],"grade":"صحيح","narrator":"رجل من قوم أبي تميمة","muhaddith":"صحيح","bab":"رقائق وزهد › الوصايا النافعة","dorar":"xhoAxwGh","merged":2,"otherRefs":["تخريج المسند لشعيب 20636 (صحيح)"]},{"id":"س-03233","fp":"315f36827af4","stateId":330,"easy":"إذا استسقيت ← يُمطرون (من واقعة)","cause":"فاستَسْقى","result":"يَتصَدَّعُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-03227","otherNeedIds":[1],"ref":"تخريج المسند لشعيب 13743","text":["أنَّ رجُلًا نادى رسولَ اللهِ صلَّى اللهُ عليه وسلَّم في يوم الجُمُعةِ وهو يَخطُبُ الناسَ بالمدينةِ، فقال: يا رسولَ اللهِ، قَحَطَ المطَرُ، وأَمْحَلَتِ الأرضُ، وقَحَطَ الناسُ، فاستَسْقِ لنا ربَّك. فنظَرَ النَّبيُّ صلَّى اللهُ عليه وسلَّم إلى السَّماءِ، وما نَرى كثيرَ سَحابٍ، ",["فاستَسْقى",1],"، فنَشأَ السحابُ بعضُه إلى بعضٍ، ثمَّ مُطِروا حتى سالَتْ مَثاعِبُ المدينةِ، واضْطَرَدَتْ طُرُقُها أنهارًا، فما زالت كذلك إلى يَومِ الجُمُعةِ المُقْبِلةِ ما تُقْلِعُ، ثمَّ قام ذلك الرَّجُلُ أو غيْرُه، ونبيُّ اللهِ صلَّى اللهُ عليه وسلَّم يَخطُبُ، فقال: يا نبيَّ اللهِ، ادْعُ اللهَ أنْ يَحبِسَها عَنَّا. فضَحِكَ نبيُّ اللهِ صلَّى اللهُ عليه وسلَّم، ثمَّ قال: اللَّهمَّ حَوالَيْنا ولا علينا، فدَعا ربَّه، فجعَلَ السحابُ ",["يَتصَدَّعُ",2]," عن المدينةِ يمينًا وشِمالًا، يُمطِرُ ما حَوْلَها، ولا يُمطِرُ فيها شَيئًا."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (13743) واللفظ له، والبزار (7042)، والطبراني في ((الدعاء)) (2181)","bab":"استسقاء › ما يقال إذا أمطرت","dorar":"dbZDjOtC","merged":2,"otherRefs":["صحيح البخاري 6093 (صحيح)"]},{"id":"س-04064","fp":"bb47e2026662","stateId":330,"easy":"إذا استسقيت ← يُمطرون حتى يشتد المطر","cause":"فاستَسقى","result":"مِن شدَّةِ المطرِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-03227","otherNeedIds":[1],"ref":"صحيح ابن خزيمة 3/ 267","text":["عن حُمَيْدٍ قالَ: سُئِلَ أنسٌ: هل كانَ نبيُّ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يرفَعُ يديهِ؟ قالَ: قيلَ يومَ الجمعةِ: يا رسولَ اللَّهِ، قحِطَ المطرُ، وأجدَبتِ الأرضُ، وَهَلَكَ المالُ، قالَ: فرفعَ يدَيهِ حتَّى رأيتُ بياضَ إبطيهِ، ",["فاستَسقى",1]," وما نَرى في السَّماءِ سَحابةً، قالَ: فما قضَينا الصَّلاةَ حتَّى إنَّ الشَّابَّ القريبَ المنزلِ ليُهِمُّهُ الرُّجوعُ إلى أَهْلِهِ ",["مِن شدَّةِ المطرِ",2],"، فدَامت جمعةً، فَقالوا: يا رسولَ اللَّهِ، تَهَدَّمتِ البيوتُ، واحتُبِستِ الرُّكبانُ، فتبسَّمَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ، فقالَ بيدِهِ: اللَّهمَّ حوالَينا، ولا علَينا، فَكُشِطَت عنِ المدينةِ. [وفي روايةٍ] قالَ: قحطَ المطرُ"],"grade":"صحيح","narrator":"أنس","muhaddith":"أخرجه في صحيحه","bab":"جمعة › خطبة النبي صلى الله عليه وسلم","dorar":"K3AjMaAJ","merged":2,"otherRefs":["تخريج المسند لشعيب 12949 (صحيح)"]},{"id":"س-07621","fp":"de13f20cb991","stateId":330,"easy":"إذا دعوت الله أن يرفع المطر ← تتقشع السحب","cause":"فادعُ اللَّهَ أن يَسقيَنا","result":"فتقشَّعَت","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-03230","otherNeedIds":[1],"ref":"صحيح ابن خزيمة 2/ 541","text":["كانَ النَّبيُّ صلَّى اللَّهُ عليهِ وسَلَّمَ يخطبُ يومَ الجمُعةِ، فقامَ إليهِ النَّاسُ فصاحوا قالوا: يا نبيَّ اللَّهِ قُحِطَ المطرُ، واحمرَّ الشَّجرُ، وَهَلَكَتِ البَهائمُ ",["فادعُ اللَّهَ أن يَسقيَنا",1],"، فقالَ: اللَّهمَّ اسقِنا، اللَّهمَّ اسقِنا قالَ: وايمُ اللَّهِ ما نرَى في السَّماءِ قَزعةً مِن سحابٍ فنشَأَت سحابةً فانتشَرَت، ثمَّ إنَّها أمطَرت، فنزلَ نبيُّ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ، فصلَّى وانصرفَ، فلَم تزلْ تُمْطرُ إلى الجمعةِ الأُخرَى، فلمَّا قامَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ يخطبُ، صاحوا قالوا: يا نبيَّ اللَّهِ، تَهَدَّمتِ البيوتُ وانقطَعتِ السُّبلُ، فادعُ اللَّهَ أن يحبسَها عنَّا قالَ: فتبسَّمَ، وقالَ: اللَّهمَّ حوالَينا ولا علَينا قالَ: ",["فتقشَّعَت",2]," عنِ المدينةِ، فجعَلت تُمْطرُ حولَها، وما تُمْطرُ بالمدينةِ قطرةً قالَ فنظَرتُ إلى المدينةِ وإنَّها لفي مثلِ الإِكْليلِ"],"grade":"صحيح","narrator":"أنس","muhaddith":"أخرجه في صحيحه","bab":"فضائل النبي وصفته ودلائل النبوة › معجزات النبي","dorar":"NFtroNM2","merged":2,"otherRefs":["البحر الزخار 13/336 (صحيح)"]},{"id":"س-00687","fp":"0f5145efbe82","stateId":330,"easy":"إذا استسقيت الله ← يجيبك","cause":"استسقِ اللَّهَ","result":"فما جَمَّعوا حتَّى أُجيبوا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-03227","otherNeedIds":[1],"ref":"صحيح ابن ماجه 1055","text":["جاءَ رجلٌ إلى النَّبيِّ صلَّى اللهُ علَيهِ وسلَّمَ فقالَ يا رسولَ اللَّهِ ",["استسقِ اللَّهَ",1]," فرفعَ رسولُ اللَّهِ صلَّى اللهُ علَيهِ وسلَّمَ يديْهِ فقالَ اللَّهمَّ اسقِنا غيثًا مَريئًا مَريعًا طَبَقًا عاجلًا غيرَ رائثٍ نافعًا غيرَ ضارٍّ قالَ ",["فما جَمَّعوا حتَّى أُجيبوا",2]," قالَ فأتوْهُ فشَكوا إليْهِ المطرَ فقالوا يا رسولَ اللَّهِ تَهدَّمتِ البيوتُ فقالَ اللَّهمَّ حوالَينا ولا علَينا قالَ فجعلَ السَّحابُ ينقَطعُ يمينًا وشمالًا"],"grade":"صحيح","narrator":"كعب بن مرة","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (1269) واللفظ له، وأحمد (18090)","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"IRWQfozP"},{"id":"س-03223","fp":"568b3f46cf05","stateId":330,"easy":"إذا استسقيت فقل «اللهم أنت الله لا إله إلا أنت الغني ونحن الفقراء...» ← يُمطرون بإذن الله","cause":"اللَّهُمَّ أنت اللهُ لا إلَهَ إلَّا أنتَ الغَنيُّ ونحن الفُقَراءُ، أنزِلْ عَلَينا الغَيثَ","result":"ثمَّ أمطَرَت بإذنِ اللهِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«اللَّهُمَّ أنت اللهُ لا إلَهَ إلَّا أنتَ الغَنيُّ ونحن الفُقَراءُ، أنزِلْ عَلَينا الغَيثَ، واجعَلْ ما أنزَلْتَ لنا قُوَّةً وبَلاغًا إلى حينٍ»"},"repOf":"س-03227","ref":"المستدرك على الصحيحين 1242","text":["شَكا النَّاسُ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ قُحوطَ المَطَرِ، فأمَرَ بمِنبَرٍ فوُضِعَ له في المُصَلَّى، ووَعَدَ النَّاسَ يَومًا يَخرُجون فيه، قالتْ عائشةُ: فخَرَج رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ حين بَدَا حاجِبُ الشَّمسِ، فقَعَد على المِنبَرِ فكَبَّرَ وحَمِدَ اللهَ، ثمَّ قالَ: إنَّكُم شَكَوتُم جَدْبَ دِيارِكُم، واستِئخارَ المَطَرِ عنْ إبَّانِ زَمانِه عنكم، وقد أمَرَكُمُ اللهُ أن تَدعُوه، ووَعَدَكُم أن يَستَجيبَ لَكُم، ثمَّ قالَ: {الْحَمْدُ للهِ رَبِّ الْعَالَمِينَ (2) الرَّحْمَنِ الرَّحِيمِ (3) مَالِكِ يَوْمِ الدِّينِ} [الفاتحة: 2-4]، لا إلَهَ إلَّا اللهُ يَفعَلُ ما يُريدُ، ",["اللَّهُمَّ أنت اللهُ لا إلَهَ إلَّا أنتَ الغَنيُّ ونحن الفُقَراءُ، أنزِلْ عَلَينا الغَيثَ",1],"، واجعَلْ ما أنزَلْتَ لنا قُوَّةً وبَلاغًا إلى حينٍ، ثمَّ رَفَع يَدَيه، فلم يَزَلْ في الرَّفعِ حتَّى بَدَا بَياضُ إبِطَيهِ، ثمَّ حَوَّلَ إلى النَّاسِ ظَهرَه، وقَلَب -أو: حَوَّلَ- رِداءَه وهو رافِعٌ يَدَيه، ثمَّ أقبَلَ على النَّاسِ، ونَزَل فصَلَّى رَكعَتَينِ، فأنشَأَ اللهُ سَحابًا فرَعَدَت وبَرَقَت، ",["ثمَّ أمطَرَت بإذنِ اللهِ",2],"، فلم يَأتِ مَسجِدَه حتَّى سالَتِ السُّيولُ، فلمَّا رَأى سُرعَتَهُم إلى الكِنِّ ضَحِكَ حتَّى بَدَت نَواجِذُه، فقالَ: أشهَدُ أنَّ اللهَ على كلِّ شَيءٍ قَديرٌ، وأنِّي عَبدُ اللهِ ورَسولُه."],"grade":"صحيح","narrator":"عائشة","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (1173)، وأبو عوانة في ((المستخرج)) (2572) بلفظه.","bab":"استسقاء › الدعاء في الاستسقاء","dorar":"5R0Ahct2"},{"id":"س-03231","fp":"c1eeb6c881d7","stateId":330,"easy":"إذا استسقيت الله ← يُحيي الله الناس","cause":"اسْتَسْقِ اللهَ","result":"فأُحْيُوا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-03227","otherNeedIds":[1],"ref":"إرواء الغليل 2/145","text":["جاءهُ صلَّى اللهُ عليهِ وسلَّمَ رجلٌ فقال ",["اسْتَسْقِ اللهَ",1]," لمُضَرَ قال فقال إنكَ لجريٌء ألِمُضَرَ قال يا رسولَ اللهِ استنصرتَ اللهَ عزَّ وجلَّ فنصركَ ودعوتَ اللهَ عزَّ وجلَّ فأجابكَ قال فرفعَ رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يديْهِ يقولُ اللهمَّ اسْقِنَا غيثًا مُغيثًا مريئًا طَبَقًا غدقًا عاجلًا غيرَ رائثٍ نافعًا غيرَ ضارٍّ قال ",["فأُحْيُوا",2]," قال فما لبثوا أن أَتَوْهُ فشكَوا إليهِ كثرةَ المطرِ فقالوا قد تهدَّمَتِ البيوتُ قال فرفعَ يديْهِ وقال اللهمَّ حَواليْنَا ولا علينا قال فجعلَ السحابُ يتقطَّعُ يمينًا وشمالًا"],"grade":"صحيح","narrator":"كعب بن مرة","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (18091)، والطيالسي (1295)، وعبد بن حميد في ((مسنده)) (372)","bab":"استسقاء › الدعاء في الاستسقاء","dorar":"u10U1Oxp"},{"id":"س-03224","fp":"3989f826b033","stateId":330,"easy":"إذا استسقيت ← يُسقى الناس","cause":"يستَسقي اللَّهَ","result":"الرُّجوعُ إلى أهلِه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03227","otherNeedIds":[1],"ref":"صحيح النسائي 1526","text":["قحَطَ المطرُ عامًا ، فقامَ بعضُ المسلِمينَ إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ في يومِ الجمُعةٍ فقالَ يا رسولَ اللَّهِ قحَطَ المطرُ وأجدَبتِ الأرضُ وَهلَكَ المالُ قالَ فَرفعَ يدَيهِ وما نَرى في السَّماءِ سَحابةً فمدَّ يدَيهِ حتَّى رأيتُ بَياضَ إبطيهِ ",["يستَسقي اللَّهَ",1]," عزَّ وجلَّ قالَ فَما صلَّينا الجُمعةَ حتَّى أهمَّ الشَّابَّ القريبَ الدَّارِ ",["الرُّجوعُ إلى أهلِه",2]," فدَامَت جُمُعةً فلمَّا كانتِ الجمعةُ الَّتي تَليها قالوا يا رسولَ اللَّهِ تَهدَّمتِ البيوتُ واحتُبِسَ الرُّكبانُ قالَ فتبسَّمَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ لِسُرعةِ مَلالةِ ابنِ آدمَ وقالَ بيَدَيهِ : اللَّهمَّ حَوالَينا ولا عَلَينا ، فتَكشَّطَت عنِ المدينةِ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (1021)، ومسلم (897)، وأبو داود (1174)، والنسائي (1527) واللفظ له، وأحمد (12019)","bab":"استسقاء › الدعاء في الاستسقاء","dorar":"GG1LUaIH"},{"id":"ق-0798","fp":"de543543fe4f","stateId":331,"easy":"المسارعة في الخيرات والدعاء رغباً ورهباً والخشوع ← الاستجابة وهبة الولد وإصلاح الزوج","cause":"المسارعة في الخيرات والدعاء رغباً ورهباً والخشوع","result":"الاستجابة وهبة الولد وإصلاح الزوج","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"repOf":"ق-0132","otherNeedIds":[38],"ref":"سورة الأنبياء: 89–90","quran":{"s":21,"from":89,"to":90,"text":"وَزَكَرِيَّا إِذْ نَادَى رَبَّهُ رَبِّ لَا تَذَرْنِي فَرْدًا وَأَنْتَ خَيْرُ الْوَارِثِينَ (89) فَاسْتَجَبْنَا لَهُ وَوَهَبْنَا لَهُ يَحْيَى وَأَصْلَحْنَا لَهُ زَوْجَهُ إِنَّهُمْ كَانُوا يُسَارِعُونَ فِي الْخَيْرَاتِ وَيَدْعُونَنَا رَغَبًا وَرَهَبًا وَكَانُوا لَنَا خَاشِعِينَ (90)","hl":[[0,96,1],[96,168,2],[168,276,1]]}},{"id":"ق-0132","fp":"3abe09721cd3","stateId":331,"easy":"دعاء الله بالذرية الطيبة ← البشارة بالولد الصالح","cause":"دعاء الله بالذرية الطيبة","result":"البشارة بالولد الصالح","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["ق-0798","ق-0651","ق-0744","ق-1049"],"otherNeedIds":[38],"ref":"سورة آل عمران: 38–39","srcLabel":"القرآن الكريم","quran":{"s":3,"from":38,"to":39,"text":"هُنَالِكَ دَعَا زَكَرِيَّا رَبَّهُ قَالَ رَبِّ هَبْ لِي مِنْ لَدُنْكَ ذُرِّيَّةً طَيِّبَةً إِنَّكَ سَمِيعُ الدُّعَاءِ (38) فَنَادَتْهُ الْمَلَائِكَةُ وَهُوَ قَائِمٌ يُصَلِّي فِي الْمِحْرَابِ أَنَّ اللَّهَ يُبَشِّرُكَ بِيَحْيَى مُصَدِّقًا بِكَلِمَةٍ مِنَ اللَّهِ وَسَيِّدًا وَحَصُورًا وَنَبِيًّا مِنَ الصَّالِحِينَ (39)","hl":[[0,191,1],[191,313,2]]}},{"id":"ق-0651","fp":"92ecfe027616","stateId":331,"easy":"الدعاء ← هبة الولد على الكِبَر","cause":"الدعاء","result":"هبة الولد على الكِبَر","explicit":true,"repOf":"ق-0132","otherNeedIds":[38],"ref":"سورة إبراهيم: 39","quran":{"s":14,"from":39,"to":39,"text":"الْحَمْدُ لِلَّهِ الَّذِي وَهَبَ لِي عَلَى الْكِبَرِ إِسْمَاعِيلَ وَإِسْحَاقَ إِنَّ رَبِّي لَسَمِيعُ الدُّعَاءِ (39)","hl":[[0,26,1],[26,77,2],[77,111,1]]}},{"id":"ق-0744","fp":"7823ecd0c5df","stateId":331,"easy":"نداء الله نداءً خفياً والتضرع إليه ← البشارة بالولد","cause":"نداء الله نداءً خفياً والتضرع إليه","result":"البشارة بالولد","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"repOf":"ق-0132","otherNeedIds":[38],"ref":"سورة مريم: 2–7","quran":{"s":19,"from":2,"to":7,"text":"ذِكْرُ رَحْمَتِ رَبِّكَ عَبْدَهُ زَكَرِيَّا (2) إِذْ نَادَى رَبَّهُ نِدَاءً خَفِيًّا (3) قَالَ رَبِّ إِنِّي وَهَنَ الْعَظْمُ مِنِّي وَاشْتَعَلَ الرَّأْسُ شَيْبًا وَلَمْ أَكُنْ بِدُعَائِكَ رَبِّ شَقِيًّا (4) وَإِنِّي خِفْتُ الْمَوَالِيَ مِنْ وَرَائِي وَكَانَتِ امْرَأَتِي عَاقِرًا فَهَبْ لِي مِنْ لَدُنْكَ وَلِيًّا (5) يَرِثُنِي وَيَرِثُ مِنْ آلِ يَعْقُوبَ وَاجْعَلْهُ رَبِّ رَضِيًّا (6) يَا زَكَرِيَّا إِنَّا نُبَشِّرُكَ بِغُلَامٍ اسْمُهُ يَحْيَى لَمْ نَجْعَلْ لَهُ مِنْ قَبْلُ سَمِيًّا (7)","hl":[[0,387,1],[387,486,2]]}},{"id":"ق-1049","fp":"5a1981dfbe0d","stateId":331,"easy":"الهجرة إلى الله والدعاء بالذرية الصالحة ← الهداية والبشارة بغلام حليم","cause":"الهجرة إلى الله والدعاء بالذرية الصالحة","result":"الهداية والبشارة بغلام حليم","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"repOf":"ق-0132","otherNeedIds":[38,15],"ref":"سورة الصافات: 99–101","quran":{"s":37,"from":99,"to":101,"text":"وَقَالَ إِنِّي ذَاهِبٌ إِلَى رَبِّي سَيَهْدِينِ (99) رَبِّ هَبْ لِي مِنَ الصَّالِحِينَ (100) فَبَشَّرْنَاهُ بِغُلَامٍ حَلِيمٍ (101)","hl":[[0,36,1],[36,47,2],[47,93,1],[93,125,2]]}},{"id":"ق-1277","fp":"034e369f5ce3","stateId":332,"easy":"دعاء المغلوب: «أني مغلوب فانتصر» ← النصر والنجاة وإهلاك المكذبين","cause":"دعاء المغلوب: «أني مغلوب فانتصر»","result":"النصر والنجاة وإهلاك المكذبين","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"apply":{"k":"say","t":"«أني مغلوب فانتصر»"},"otherNeedIds":[25,4],"ref":"سورة القمر: 9–14","srcLabel":"القرآن الكريم","quran":{"s":54,"from":9,"to":14,"text":"كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ فَكَذَّبُوا عَبْدَنَا وَقَالُوا مَجْنُونٌ وَازْدُجِرَ (9) فَدَعَا رَبَّهُ أَنِّي مَغْلُوبٌ فَانْتَصِرْ (10) فَفَتَحْنَا أَبْوَابَ السَّمَاءِ بِمَاءٍ مُنْهَمِرٍ (11) وَفَجَّرْنَا الْأَرْضَ عُيُونًا فَالْتَقَى الْمَاءُ عَلَى أَمْرٍ قَدْ قُدِرَ (12) وَحَمَلْنَاهُ عَلَى ذَاتِ أَلْوَاحٍ وَدُسُرٍ (13) تَجْرِي بِأَعْيُنِنَا جَزَاءً لِمَنْ كَانَ كُفِرَ (14)","hl":[[0,142,1],[142,380,2]]}},{"id":"ق-0091","fp":"959259e38844","stateId":332,"easy":"الدعاء عند اللقاء بالصبر والثبات والنصر ← هزيمة العدو بإذن الله","cause":"الدعاء عند اللقاء بالصبر والثبات والنصر","result":"هزيمة العدو بإذن الله","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[25],"ref":"سورة البقرة: 250–251","srcLabel":"القرآن الكريم","quran":{"s":2,"from":250,"to":251,"text":"وَلَمَّا بَرَزُوا لِجَالُوتَ وَجُنُودِهِ قَالُوا رَبَّنَا أَفْرِغْ عَلَيْنَا صَبْرًا وَثَبِّتْ أَقْدَامَنَا وَانْصُرْنَا عَلَى الْقَوْمِ الْكَافِرِينَ (250) فَهَزَمُوهُمْ بِإِذْنِ اللَّهِ وَقَتَلَ دَاوُودُ جَالُوتَ وَآتَاهُ اللَّهُ الْمُلْكَ وَالْحِكْمَةَ وَعَلَّمَهُ مِمَّا يَشَاءُ وَلَوْلَا دَفْعُ اللَّهِ النَّاسَ بَعْضَهُمْ بِبَعْضٍ لَفَسَدَتِ الْأَرْضُ وَلَكِنَّ اللَّهَ ذُو فَضْلٍ عَلَى الْعَالَمِينَ (251)","hl":[[0,157,1],[157,187,2]]}},{"id":"ق-0342","fp":"93ea4596a9d0","stateId":332,"easy":"دعاء الله بالرزق: «اللهم ربنا أنزل علينا مائدة» ← استجابة الله","cause":"دعاء الله بالرزق: «اللهم ربنا أنزل علينا مائدة»","result":"استجابة الله","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"apply":{"k":"say","t":"«اللهم ربنا أنزل علينا مائدة»"},"otherNeedIds":[1],"ref":"سورة المائدة: 114–115","srcLabel":"القرآن الكريم","quran":{"s":5,"from":114,"to":115,"text":"قَالَ عِيسَى ابْنُ مَرْيَمَ اللَّهُمَّ رَبَّنَا أَنْزِلْ عَلَيْنَا مَائِدَةً مِنَ السَّمَاءِ تَكُونُ لَنَا عِيدًا لِأَوَّلِنَا وَآخِرِنَا وَآيَةً مِنْكَ وَارْزُقْنَا وَأَنْتَ خَيْرُ الرَّازِقِينَ (114) قَالَ اللَّهُ إِنِّي مُنَزِّلُهَا عَلَيْكُمْ فَمَنْ يَكْفُرْ بَعْدُ مِنْكُمْ فَإِنِّي أُعَذِّبُهُ عَذَابًا لَا أُعَذِّبُهُ أَحَدًا مِنَ الْعَالَمِينَ (115)","hl":[[0,202,1],[202,246,2]]}},{"id":"ق-0451","fp":"9ea555a2b0ea","stateId":332,"easy":"الاستغاثة بالله ← الاستجابة والإمداد بالملائكة والنصر","cause":"الاستغاثة بالله","result":"الاستجابة والإمداد بالملائكة والنصر","explicit":true,"star":true,"otherNeedIds":[25],"ref":"سورة الأنفال: 9–10","srcLabel":"القرآن الكريم","quran":{"s":8,"from":9,"to":10,"text":"إِذْ تَسْتَغِيثُونَ رَبَّكُمْ فَاسْتَجَابَ لَكُمْ أَنِّي مُمِدُّكُمْ بِأَلْفٍ مِنَ الْمَلَائِكَةِ مُرْدِفِينَ (9) وَمَا جَعَلَهُ اللَّهُ إِلَّا بُشْرَى وَلِتَطْمَئِنَّ بِهِ قُلُوبُكُمْ وَمَا النَّصْرُ إِلَّا مِنْ عِنْدِ اللَّهِ إِنَّ اللَّهَ عَزِيزٌ حَكِيمٌ (10)","hl":[[0,30,1],[30,227,2]]}},{"id":"ق-0608","fp":"aa3ac8349d0c","stateId":332,"easy":"الدعاء واللجوء إلى الله من الفتنة ← استجابة الله وصرف الكيد","cause":"الدعاء واللجوء إلى الله من الفتنة","result":"استجابة الله وصرف الكيد","explicit":true,"star":true,"otherNeedIds":[20,31],"ref":"سورة يوسف: 33–34","srcLabel":"القرآن الكريم","quran":{"s":12,"from":33,"to":34,"text":"قَالَ رَبِّ السِّجْنُ أَحَبُّ إِلَيَّ مِمَّا يَدْعُونَنِي إِلَيْهِ وَإِلَّا تَصْرِفْ عَنِّي كَيْدَهُنَّ أَصْبُ إِلَيْهِنَّ وَأَكُنْ مِنَ الْجَاهِلِينَ (33) فَاسْتَجَابَ لَهُ رَبُّهُ فَصَرَفَ عَنْهُ كَيْدَهُنَّ إِنَّهُ هُوَ السَّمِيعُ الْعَلِيمُ (34)","hl":[[0,156,1],[156,209,2],[209,244,1]]}},{"id":"ق-0793","fp":"b01f6e1c472d","stateId":332,"easy":"نداء الله (الدعاء) ← الاستجابة والنجاة من الكرب العظيم والنصر","cause":"نداء الله (الدعاء)","result":"الاستجابة والنجاة من الكرب العظيم والنصر","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"similar":["ق-1047"],"otherNeedIds":[4,25],"ref":"سورة الأنبياء: 76–77","srcLabel":"القرآن الكريم","quran":{"s":21,"from":76,"to":77,"text":"وَنُوحًا إِذْ نَادَى مِنْ قَبْلُ فَاسْتَجَبْنَا لَهُ فَنَجَّيْنَاهُ وَأَهْلَهُ مِنَ الْكَرْبِ الْعَظِيمِ (76) وَنَصَرْنَاهُ مِنَ الْقَوْمِ الَّذِينَ كَذَّبُوا بِآيَاتِنَا إِنَّهُمْ كَانُوا قَوْمَ سَوْءٍ فَأَغْرَقْنَاهُمْ أَجْمَعِينَ (77)","hl":[[0,33,1],[33,170,2]]}},{"id":"ق-0916","fp":"99ae545dc305","stateId":332,"easy":"الدعاء عند الخوف والفقر وفعل المعروف للضعيف ← النجاة والأمن والرزق والمأوى","cause":"الدعاء عند الخوف والفقر وفعل المعروف للضعيف","result":"النجاة والأمن والرزق والمأوى","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[4,1,6],"ref":"سورة القصص: 21–25","srcLabel":"القرآن الكريم","quran":{"s":28,"from":21,"to":25,"text":"فَخَرَجَ مِنْهَا خَائِفًا يَتَرَقَّبُ قَالَ رَبِّ نَجِّنِي مِنَ الْقَوْمِ الظَّالِمِينَ (21) وَلَمَّا تَوَجَّهَ تِلْقَاءَ مَدْيَنَ قَالَ عَسَى رَبِّي أَنْ يَهْدِيَنِي سَوَاءَ السَّبِيلِ (22) وَلَمَّا وَرَدَ مَاءَ مَدْيَنَ وَجَدَ عَلَيْهِ أُمَّةً مِنَ النَّاسِ يَسْقُونَ وَوَجَدَ مِنْ دُونِهِمُ امْرَأَتَيْنِ تَذُودَانِ قَالَ مَا خَطْبُكُمَا قَالَتَا لَا نَسْقِي حَتَّى يُصْدِرَ الرِّعَاءُ وَأَبُونَا شَيْخٌ كَبِيرٌ (23) فَسَقَى لَهُمَا ثُمَّ تَوَلَّى إِلَى الظِّلِّ فَقَالَ رَبِّ إِنِّي لِمَا أَنْزَلْتَ إِلَيَّ مِنْ خَيْرٍ فَقِيرٌ (24) فَجَاءَتْهُ إِحْدَاهُمَا تَمْشِي عَلَى اسْتِحْيَاءٍ قَالَتْ إِنَّ أَبِي يَدْعُوكَ لِيَجْزِيَكَ أَجْرَ مَا سَقَيْتَ لَنَا فَلَمَّا جَاءَهُ وَقَصَّ عَلَيْهِ الْقَصَصَ قَالَ لَا تَخَفْ نَجَوْتَ مِنَ الْقَوْمِ الظَّالِمِينَ (25)","hl":[[0,537,1],[537,756,2]]}},{"id":"ق-1047","fp":"d29b18de916b","stateId":332,"easy":"الدعاء والإحسان والإيمان ← الإجابة والنجاة من الكرب العظيم وبقاء الذرية والثناء الحسن","cause":"الدعاء والإحسان والإيمان","result":"الإجابة والنجاة من الكرب العظيم وبقاء الذرية والثناء الحسن","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"repOf":"ق-0793","otherNeedIds":[4,37,41],"ref":"سورة الصافات: 75–81","quran":{"s":37,"from":75,"to":81,"text":"وَلَقَدْ نَادَانَا نُوحٌ فَلَنِعْمَ الْمُجِيبُونَ (75) وَنَجَّيْنَاهُ وَأَهْلَهُ مِنَ الْكَرْبِ الْعَظِيمِ (76) وَجَعَلْنَا ذُرِّيَّتَهُ هُمُ الْبَاقِينَ (77) وَتَرَكْنَا عَلَيْهِ فِي الْآخِرِينَ (78) سَلَامٌ عَلَى نُوحٍ فِي الْعَالَمِينَ (79) إِنَّا كَذَلِكَ نَجْزِي الْمُحْسِنِينَ (80) إِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِنِينَ (81)","hl":[[0,25,1],[25,238,2],[238,326,1]]}},{"id":"ق-1371","fp":"b927d5d8be59","stateId":332,"easy":"نداء الله عند الكظم والغمّ ← تدارك نعمة الله والاجتباء","cause":"نداء الله عند الكظم والغمّ","result":"تدارك نعمة الله والاجتباء","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[4],"ref":"سورة القلم: 48–50","srcLabel":"القرآن الكريم","quran":{"s":68,"from":48,"to":50,"text":"فَاصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُنْ كَصَاحِبِ الْحُوتِ إِذْ نَادَى وَهُوَ مَكْظُومٌ (48) لَوْلَا أَنْ تَدَارَكَهُ نِعْمَةٌ مِنْ رَبِّهِ لَنُبِذَ بِالْعَرَاءِ وَهُوَ مَذْمُومٌ (49) فَاجْتَبَاهُ رَبُّهُ فَجَعَلَهُ مِنَ الصَّالِحِينَ (50)","hl":[[27,93,1],[93,234,2]]}},{"id":"س-04427","fp":"22ba63857651","stateId":332,"easy":"إذا توسلت إلى الله بإيمانك وعفتك في الشدة ← ينجيك الله (من قصة سارة)","cause":"اللهُمَّ إن كُنتُ آمَنتُ بكَ وبِرَسولِكَ وأحصَنتُ فرجي إلَّا على زَوجي، فلا تُسَلِّطْ عليَّ الكافِرَ","result":"فغُطَّ حتَّى رَكَضَ برِجلِه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[31],"ref":"صحيح البخاري 2217","srcLabel":"متفق عليه","text":["قال النَّبيُّ صلَّى اللهُ عليه وسلَّم: هاجَرَ إبراهيمُ عليه السَّلامُ بسارةَ، فدَخَلَ بها قَريةً فيها مَلِكٌ مِنَ المُلوكِ -أو جَبَّارٌ مِنَ الجَبابِرةِ- فقيلَ: دَخَلَ إبراهيمُ بامرَأةٍ هي مِن أحسَنِ النِّساءِ، فأرسَلَ إليه: أن يا إبراهيمُ، مَن هذه التي معكَ؟ قال: أُختي، ثُمَّ رَجَعَ إليها فقال: لا تُكَذِّبي حَديثي؛ فإنِّي أخبَرتُهم أنَّكِ أُختي، واللهِ إنْ على الأرضِ مُؤمِنٌ غيري وغَيرُكِ، فأرسَلَ بها إليه، فقامَ إليها، فقامَت تَوضَّأُ وتُصَلِّي، فقالتِ: ",["اللهُمَّ إن كُنتُ آمَنتُ بكَ وبِرَسولِكَ وأحصَنتُ فرجي إلَّا على زَوجي، فلا تُسَلِّطْ عليَّ الكافِرَ",1],"، ",["فغُطَّ حتَّى رَكَضَ برِجلِه",2],". قال الأعرَجُ: قال أبو سَلَمةَ بنُ عبدِ الرَّحمَنِ: إنَّ أبا هُرَيرةَ قال: قالت: اللهُمَّ إن يَمُتْ يُقالُ: هي قَتَلَتْه، فأُرسِلَ، ثُمَّ قامَ إليها، فقامَت تَوضَّأُ تُصَلِّي، وتَقولُ: اللهُمَّ إن كُنتُ آمَنتُ بكَ وبِرَسولِكَ وأحصَنتُ فرجي إلَّا على زَوجي، فلا تُسَلِّطْ عليَّ هذا الكافِرَ، فغُطَّ حتَّى رَكَضَ برِجلِه. قال عبدُ الرَّحمَنِ: قال أبو سَلَمةَ: قال أبو هُرَيرةَ: فقالت: اللهُمَّ إن يَمُتْ فيُقالُ: هي قَتَلَتْه، فأُرسِلَ في الثَّانيةِ -أو في الثَّالِثةِ- فقال: واللهِ ما أرسَلتُم إليَّ إلَّا شيطانًا، ارجِعوها إلى إبراهيمَ، وأعطوها آجَرَ. فرَجَعَت إلى إبراهيمَ عليه السَّلامُ، فقالت: أشَعَرتَ أنَّ اللهَ كَبَتَ الكافِرَ وأخدَمَ وليدةً؟!"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2217) واللفظ له، ومسلم (2371)","bab":"جهاد › الهجرة من دار العدو إلى دار الإسلام","dorar":"12QOj4WY"},{"id":"س-05971","fp":"5a900f730e04","stateId":332,"easy":"إذا كان بك ضر فدعوت الله ← يكشفه عنك","cause":"إذا كان بكَ ضُرٌّ فدَعَوتَه","result":"كَشَفَه عنكَ","explicit":true,"otherNeedIds":[4],"ref":"تخريج المسند لشعيب 23205","srcLabel":"أحمد","text":["عن رَجُلٍ: أنَّه أتى رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم  -أو قال: شَهِدتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم وأتاهُ رَجُلٌ- فقال: أنتَ رَسولُ اللهِ؟ أو قال: أنتَ مُحَمَّدٌ؟ فقال: «نَعَم»، قال: فِإلامَ تَدعو؟ قال: «أدعو إلى اللهِ وحدَه؛ مَن ",["إذا كان بكَ ضُرٌّ فدَعَوتَه",1]," ",["كَشَفَه عنكَ",2],"، ومَن إذا أصابَكَ عامُ سَنةٍ فدَعَوتَه أنبَتَ لَكَ، ومَن إذا كُنتَ في أرضٍ قَفرٍ فأضلَلتَ فدَعَوتَه رَدَّ عليكَ»، قال: فأسلَمَ الرَّجُلُ، ثُمَّ قال: أوصِني يا رَسولَ اللهِ؟ فقال له: «لا تَسُبَّنَّ شَيئًا» -أو قال أحَدًا: شَكَّ الحَكَمُ- قال: فما سَبَبتُ شَيئًا بَعيرًا ولا شاةً مُنذُ أوصاني رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، «ولا تَزهَدْ في المَعروفِ ولَو ببَسطِ وجهكَ إلى أخيكَ وأنتَ تُكَلِّمُه، وأفرِغْ مِن دَلوِكَ في إناءِ المُستَسقي، واتَّزِرْ إلى نِصفِ السَّاقِ، فإن أبَيتَ فإلى الكَعبَينِ، وإيَّاكَ وإسبالَ الإزارِ؛ فإنَّها مِنَ المَخيلةِ، واللهُ لا يُحِبُّ المَخيلةَ»."],"grade":"صحيح","narrator":"رجل من قوم أبي تميمة","muhaddith":"صحيح","bab":"رقائق وزهد › الوصايا النافعة","dorar":"xhoAxwGh","merged":2,"otherRefs":["تخريج المسند لشعيب 20636 (صحيح)"]},{"id":"س-05973","fp":"c8f857e993ca","stateId":332,"easy":"إذا ضللت في أرض قفر فدعوت الله ← يردك","cause":"إذا كُنتَ في أرضٍ قَفرٍ فأضلَلتَ فدَعَوتَه","result":"رَدَّ عليكَ","explicit":true,"otherNeedIds":[54],"ref":"تخريج المسند لشعيب 23205","srcLabel":"أحمد","text":["عن رَجُلٍ: أنَّه أتى رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم  -أو قال: شَهِدتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم وأتاهُ رَجُلٌ- فقال: أنتَ رَسولُ اللهِ؟ أو قال: أنتَ مُحَمَّدٌ؟ فقال: «نَعَم»، قال: فِإلامَ تَدعو؟ قال: «أدعو إلى اللهِ وحدَه؛ مَن إذا كان بكَ ضُرٌّ فدَعَوتَه كَشَفَه عنكَ، ومَن إذا أصابَكَ عامُ سَنةٍ فدَعَوتَه أنبَتَ لَكَ، ومَن ",["إذا كُنتَ في أرضٍ قَفرٍ فأضلَلتَ فدَعَوتَه",1]," ",["رَدَّ عليكَ",2],"»، قال: فأسلَمَ الرَّجُلُ، ثُمَّ قال: أوصِني يا رَسولَ اللهِ؟ فقال له: «لا تَسُبَّنَّ شَيئًا» -أو قال أحَدًا: شَكَّ الحَكَمُ- قال: فما سَبَبتُ شَيئًا بَعيرًا ولا شاةً مُنذُ أوصاني رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، «ولا تَزهَدْ في المَعروفِ ولَو ببَسطِ وجهكَ إلى أخيكَ وأنتَ تُكَلِّمُه، وأفرِغْ مِن دَلوِكَ في إناءِ المُستَسقي، واتَّزِرْ إلى نِصفِ السَّاقِ، فإن أبَيتَ فإلى الكَعبَينِ، وإيَّاكَ وإسبالَ الإزارِ؛ فإنَّها مِنَ المَخيلةِ، واللهُ لا يُحِبُّ المَخيلةَ»."],"grade":"صحيح","narrator":"رجل من قوم أبي تميمة","muhaddith":"صحيح","bab":"رقائق وزهد › الوصايا النافعة","dorar":"xhoAxwGh","merged":2,"otherRefs":["تخريج المسند لشعيب 20636 (صحيح)"]},{"id":"س-07038","fp":"1e63c53c730a","stateId":332,"easy":"إذا سألت الله أن يُظهر لك الحق ← يبيّنه لك (من قصة الغلام)","cause":"اللَّهمَّ إن كانَ ما يقولُ الرَّاهبُ حقًّا فأسألُكَ أن أقتلَها","result":"ثمَّ رمَى فقتلَ الدَّابَّةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح الترمذي 3340","srcLabel":"مسلم","text":["كانَ ملِكٌ منَ الملوكِ وَكانَ لذلِكَ الملِكِ كاهنٌ يَكْهنُ لَهُ ، فقالَ الكاهنُ : انظروا لي غلامًا فَهِمًا - أو قالَ : فَطِنًا - لَقِنًا فأُعلِّمَهُ عِلمي هذا ، فإنِّي أخافُ أن أموتَ فينقطِعَ منكُم هذا العلمُ ، ولا يَكونَ فيكُم مِن يَعلمُهُ. قالَ : فنظَروا لَهُ علَى ما وصفَ ، فأمروهُ أن يحضرَ ذلِكَ الكاهنَ وأن يختلفَ إليهِ ، فجعلَ يختلفُ ، إليهِ وَكانَ علَى طريقِ الغُلامِ راهبٌ في صَومعةٍ - قالَ مَعمرٌ : أحسبُ أنَّ أصحابَ الصَّوامعِ كانوا يَومئذٍ مُسلمينَ - قالَ : فجعلَ الغُلامُ يسألُ ذلِكَ الرَّاهبَ كلَّما مرَّ بِهِ ، فلَم يزَلْ بِهِ حتَّى أخبرَهُ ، فقالَ : إنَّما أعبدُ اللَّهَ. قالَ : فجعلَ الغُلامُ يمكثُ عندَ الرَّاهبِ ويبطئُ عنِ الكاهنِ ، فأرسلَ الكاهنُ إلى أهْلِ الغُلامِ إنَّهُ لا يَكادُ يحضرُني ، فأخبرَ الغُلامُ الرَّاهبَ بذلِكَ ، فقالَ لَهُ الرَّاهبُ : إذا قالَ لَكَ الكاهنُ : أينَ كنتَ ؟ فقل : عندَ أَهْلي ، وإذا قالَ لَكَ أَهْلُكَ : أينَ كنتَ ؟ فأخبِرهم أنَّكَ كنتَ عندَ الكاهنِ. قالَ : فبَينما الغُلامُ علَى ذلِكَ إذ مرَّ بجماعةٍ منَ النَّاسِ كثيرٍ قد حبَستهُم دابَّةٌ ، فقالَ بعضُهُم : إنَّ تلكَ الدَّابَّةَ كانت أسدًا فأخذَ الغُلامُ حجرًا فقالَ : ",["اللَّهمَّ إن كانَ ما يقولُ الرَّاهبُ حقًّا فأسألُكَ أن أقتلَها",1],". قالَ : ",["ثمَّ رمَى فقتلَ الدَّابَّةَ",2],". فقالَ النَّاسُ : مَن قتلَها ؟ قالوا : الغُلامُ ، ففزِعَ النَّاسُ فقالوا : قد علِمَ هذا الغُلامُ عِلمًا لم يعلمْهُ أحدٌ. قالَ : فسمِعَ بِهِ أعمَى ، فقالَ لَهُ : إن أنتَ ردَدتَ بَصري فلَكَ كَذا وَكَذا. قالَ لهُ : لا أريدُ منكَ هذا ، ولَكِن أرَأيتَ إن رجعَ إليكَ بصرُكَ ، أتؤمنُ بالَّذي ردَّهُ علَيكَ ؟ قالَ : نعم. قالَ : فدعا اللَّهَ فردَّ علَيهِ بصرَهُ ، فآمنَ الأعمَى ، فبلغَ الملِكَ أمرُهُم ، فبعثَ إليهِم ، فأُتيَ بِهِم ، فقالَ : لأقتلَنَّ كلَّ واحدٍ منكُم قتلةً لا أقتلُ بِها صاحبَهُ ، فأمرَ بالرَّاهبِ والرَّجلِ الَّذي كانَ أعمَى فَوضعَ المِنشارَ علَى مَفرقِ أحدِهِما فقتلَهُ ، وقتلَ الآخرَ بقتلةٍ أُخرَى. ثمَّ أمرَ بالغُلامِ ، فقالَ : انطلِقوا بِهِ إلى جبلِ كَذا وَكَذا فألقوهُ مِن رأسِهِ ، فانطلِقوا بِهِ إلى الجبلِ ، فلمَّا انتَهَوا إلى ذلِكَ المَكانِ الَّذي أرادوا أن يلقوهُ منهُ جعَلوا يتَهافَتونَ مِن ذلِكَ الجبلِ ويتردَّونَ ، حتَّى لم يبقَ منهُم إلَّا الغُلامُ. قالَ : ثمَّ رجعَ ، فأمرَ بِهِ الملِكُ أن ينطلِقوا بِهِ إلى البحرِ فَيلقونَهُ فيهِ ، فانطلقَ بِهِ إلى البحرِ ، فغرَّقَ اللَّهُ الَّذينَ كانوا معَهُ وأنجاهُ ، فقالَ الغُلامُ للملِكِ : إنَّكَ لا تقتلُني حتَّى تصلِبَني وتَرميَني وتقولَ إذا رمَيتَني : بسمِ اللَّهِ ربِّ هذا الغُلامِ. قالَ فأمرَ بِهِ ، فصُلِبَ ، ثمَّ رماهُ ، فقالَ : بسمِ اللَّهِ ربِّ هذا الغُلامِ. قالَ : فَوضعَ الغُلامُ يدَهُ علَى صدغِهِ حينَ رُمِيَ ، ثمَّ ماتَ ، فقالَ أُناسٌ : لقد علِمَ هذا الغُلامُ عِلمًا ما علِمَهُ أحدٌ ، فإنَّا نؤمنُ بربِّ هذا الغُلامِ. قالَ : فقيلَ للملِكِ أجزَعتَ أن خالفَكَ ثلاثةٌ ، فَهَذا العالمُ كلُّهم قد خالفوكَ. قالَ : فخدَّ أُخدودًا ثمَّ ألقَى فيها الحطبَ والنَّارَ ، ثمَّ جمعَ النَّاسَ. فقالَ : مَن رجعَ عن دينِهِ ترَكْناهُ ، ومَن لم يرجِعْ ألقَيناهُ في هذِهِ النَّارِ ، فجعلَ يُلقيهم في تلكَ الأُخدودِ. قالَ : يقولُ اللَّهُ تبارَكَ وتعالى فيهِ :  قُتِلَ أَصْحَابُ الْأُخْدُودِ النَّارِ ذَاتِ الْوَقُودِ  حتَّى بلغَ  الْعَزِيزِ الْحَمِيدِ  قالَ : فأمَّا الغُلامُ فإنَّهُ دُفِنَ قالَ : فيذكرُ أنَّهُ أُخْرِجَ في زمنِ عُمرَ بنِ الخطَّابِ وأُصبعُهُ علَى صدغِهِ كما وضعَها حينَ قُتِلَ"],"grade":"صحيح","narrator":"صهيب بن سنان الرومي","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3340) واللفظ له، ومسلم (3005)، وأحمد (23931) بنحوه.","bab":"علم › الحث على طلب العلم","dorar":"seTN8V1w"},{"id":"س-07748","fp":"ed92fc4e9d90","stateId":332,"easy":"إذا استغثت بالله في الشدة ← يستجيب لك ويمدّك (من واقعة بدر)","cause":"فما زال يَستَغيثُ ربَّهُ","result":"إِذْ تَسْتَغِيثُونَ رَبَّكُمْ فَاسْتَجَابَ لَكُمْ أَنِّي مُمِدُّكُمْ بِأَلْفٍ مِنَ الْمَلَائِكَةِ مُرْدِفِينَ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"similar":["س-07764"],"otherNeedIds":[25],"ref":"صحيح أسباب النزول 61","srcLabel":"مسلم","text":["حدَّثني عمرُ بنُ الخطَّابِ رَضِيَ اللهُ عنه، قال: لمَّا كان يومُ بَدْرٍ، قال: نظر النبيُّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ إلى أصحابِهِ وهُمْ ثلاثُ مئةٍ ونَيِّفٌ، ونظر إلى المشركينَ فإذا هُمْ ألفٌ وزيادةٌ، فاستقبَلَ النبيُّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ القِبلةَ، ثم مَدَّ يديْهِ وعليه رِداؤُهُ وإزارُهُ، ثم قال: اللَّهمَّ أينَ ما وَعَدْتَني؟ اللَّهمَّ أَنْجِزْ لي ما وَعَدْتَني، اللَّهمَّ إنَّكَ إنْ تُهلِكْ هذهِ العِصابةَ مِن أهلِ الإسلامِ، فلا تُعْبَدُ في الأرضِ أبدًا، قال: ",["فما زال يَستَغيثُ ربَّهُ",1]," عزَّ وجلَّ ويَدْعوه حتى سَقَطَ رِداؤُهُ، فأتاهُ أبو بكرٍ رَضِيَ اللهُ عنه، فأخذ رِداءَهُ فرَدَّاهُ، ثم الْتَزَمَهُ مِن وَرائِهِ، ثم قال: يا نَبيَّ اللهِ، كَفاكَ مُناشَدَتُكَ ربَّكَ؛ فإنَّهُ سيُنْجِزُ لكَ ما وَعَدَكَ، وأنزل اللهُ عزَّ وجلَّ: {",["إِذْ تَسْتَغِيثُونَ رَبَّكُمْ فَاسْتَجَابَ لَكُمْ أَنِّي مُمِدُّكُمْ بِأَلْفٍ مِنَ الْمَلَائِكَةِ مُرْدِفِينَ",2],"} [الأنفال: 9]، فلمَّا كان يومئذٍ والْتَقَوْا، فهزم اللهُ عزَّ وجلَّ المشركينَ، فقُتِلَ مِنهُم سبعونَ رجُلًا، وأُسِرَ منهم سبعونَ رجُلًا، فاستشار رسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ أبا بكرٍ وعليًّا وعُمرَ رَضِيَ اللهُ عنهم، فقال أبو بكرٍ رَضِيَ اللهُ عنه: يا رسولَ اللهِ، هؤلاءِ بَنو العَمِّ والعشيرةِ والإخوانِ؛ فإنِّي أرى أنْ تأخُذَ منهُمُ الفِديةَ، فيكونَ ما أخَذْنا منهم قُوَّةً لنا على الكُفَّارِ، وعسى اللهُ أنْ يَهديَهم؛ فيكونوا لنا عَضُدًا، فقال رسولُ اللهِ صلَّى اللهُ عليه وعلى آلِهِ وسلَّمَ: ما ترى يا بنَ الخطَّابِ؟ قلتُ: واللهِ، ما أرى ما رأى أبو بكرٍ، ولكنِّي أرى أنْ تُمَكِّنَني مِن فُلانٍ -قريبًا لعُمرَ- فأضرِبَ عُنُقَهُ، وتُمَكِّنَ عليًّا رَضِيَ اللهُ عنه مِن عَقيلٍ فيضرِبَ عُنُقَهُ، وتُمَكِّنَ حمزةَ مِن فُلانٍ أخيه فيضرِبَ عُنُقَهُ؛ حتى يعلَمَ اللهُ أنَّه ليستْ في قُلوبِنا هَوادَةٌ للمشركينَ، هؤلاءِ صَناديدُهم وأئمَّتُهم وقادتُهم، فهَوِيَ رسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ ما قال أبو بكرٍ رَضِيَ اللهُ عنه، ولم يَهْوَ ما قلتُ؛ فأخَذَ مِنهُمُ الفِداءَ، فلمَّا أنْ كان مِنَ الغَدِ قال عمرُ رَضِيَ اللهُ عنه: غَدَوْتُ إلى رسولِ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، فإذا هو قاعدٌ وأبو بكرٍ رَضِيَ اللهُ عنه، وإذا هما يبكيانِ، فقلتُ: يا رسولَ اللهِ، أَخبِرْني ماذا يُبكيكَ أنتَ وصاحبَكَ، فإنْ وجدْتُ بُكاءً بكيْتُ، وإنْ لم أجِدْ تَباكَيْتُ لبكائِكما، قال: فقال النبيُّ صلَّى اللهُ عليه وعلى آلِهِ وسلَّمَ: الذي عَرَضَ عليَّ أَصحابُكَ مِنَ الفِداءِ، لقد عُرِضَ عليَّ عذابُهم أَدْنَى مِن هذهِ الشَّجرةِ -لشجرةٍ قريبةٍ-، وأنزل اللهُ عزَّ وجلَّ: {مَا كَانَ لِنَبِيٍّ أَنْ يَكونَ لَهُ أَسْرَى حَتَّى يُثْخِنَ فِي الْأَرْضِ} [الأنفال: 67] إلى قولِهِ: {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ لَمَسَّكُمْ فِيمَا أَخَذْتُمْ} [الأنفال: 68] مِنَ الفِداءِ، ثُمَّ أحَلَّ اللهُ لهُمُ الغنائِمَ، فلمَّا كان يومُ أُحُدٍ مِنَ العامِ المُقْبِلِ عُوقِبوا بما صنَعوا يومَ بَدْرٍ مِن أَخْذِهِمُ الفِداءَ، فقُتِلَ مِنهُم سبعونَ، وفَرَّ أصحابُ النبيِّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ عَنِ النبيِّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، وكُسِرَتْ رَباعِيَتُهُ، وهُشِّمَتِ البَيْضةُ على رأسِهِ، وسال الدَّمُ على وجهِهِ، وأنزل اللهُ عزَّ وجلَّ: {أَوَلَمَّا أَصَابَتْكُمْ مُصِيبَةٌ قَدْ أَصَبْتُمْ مِثْلَيْهَا} [آل عمران: 165] بأخْذِكُمُ الفِداءَ."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه مسلم (1763) باختلاف يسير.","bab":"قرآن › أسباب النزول","dorar":"FGoysDoa"},{"id":"س-00101","fp":"bdadfec7ce27","stateId":332,"easy":"إذا خرجت في سبيل الله ففقدت شيئاً فدعوت الله ← يرده الله عليك (من قصة)","cause":"يا رَبِّ، قد ضَمِنتَ لمَن خَرَجَ في سَبيلِك أن تَحفَظَ عليه، وإنِّي قد فقدتُ عَنزًا مِن غَنَمي وصيصيَتي، وإني أنشُدُك عَنزي وصِيصيَتي","result":"فأصبَحَت عَنزُها وصِيصِيتُها ومِثلُها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[31],"ref":"مشارع الأشواق 163","srcLabel":"أحمد","text":["كان رَجُلٌ مِنَ الطّفاوةِ طَريقُه علينا يَأتي على الحَيِّ فيُحَدِّثُهم، قال: أتَيتُ المَدينةَ في عِيرٍ لَنا، فبِعنا بضاعَتَنا ثُمَّ قُلتُ: لأنطَلقَنَّ إلى هذا الرَّجُلِ فلآتينَّ مَن بَعدي بخَبَرِه، قال: فانتَهَيتُ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فإذا هو يُريني بَيتًا، قال: إنَّ امرَأةً كانت فيه فخَرَجَت في سَريَّةٍ مِنَ المُسلمينَ وتَرَكَت ثِنتَي عَشرةَ عَنزًا وصِيصِيتَها التي تَنسِجُ بها، قال: ففقدَت عَنزًا مِن غَنَمِها وصِيصيتَها، قالت: ",["يا رَبِّ، قد ضَمِنتَ لمَن خَرَجَ في سَبيلِك أن تَحفَظَ عليه، وإنِّي قد فقدتُ عَنزًا مِن غَنَمي وصيصيَتي، وإني أنشُدُك عَنزي وصِيصيَتي",1],"، قال: فجَعَلَ رَسول اللهِ صلَّى اللهُ عليه وسلَّم يَذكُرُ شِدَّةَ مُناشَدَتِها لرَبِّها تَبارَكَ وتَعالى، قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["فأصبَحَت عَنزُها وصِيصِيتُها ومِثلُها",2],"، وهاتيك فأْتِها فاسأَلْها إن شِئتَ، قال: قُلتُ: بَل أُصَدِّقُك"],"grade":"صحيح","narrator":"رجل من الطفاوة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (20664) بلفظه.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"Y83sEeX0"},{"id":"س-07764","fp":"24dad89e6f12","stateId":332,"easy":"إذا ألححت في الدعاء مادّاً يديك مستقبلاً القبلة ← يمدّك الله بنصره (من واقعة بدر)","cause":"فَما زَالَ يَهْتِفُ برَبِّهِ، مَادًّا يَدَيْهِ مُسْتَقْبِلَ القِبْلَةِ","result":"فأمَدَّهُ اللَّهُ بالمَلَائِكَةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"repOf":"س-07748","otherNeedIds":[25],"ref":"فتح الباري لابن حجر 2/272","text":["حديثُ استقبالِ القبلةِ عند الدعاءِ [يعني حديث: لَمَّا كانَ يَوْمُ بَدْرٍ نَظَرَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ إلى المُشْرِكِينَ وَهُمْ أَلْفٌ، وَأَصْحَابُهُ ثَلَاثُ مِائَةٍ وَتِسْعَةَ عَشَرَ رَجُلًا، فَاسْتَقْبَلَ نَبِيُّ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ القِبْلَةَ، ثُمَّ مَدَّ يَدَيْهِ، فَجَعَلَ يَهْتِفُ برَبِّهِ: اللَّهُمَّ أَنْجِزْ لي ما وَعَدْتَنِي، اللَّهُمَّ آتِ ما وَعَدْتَنِي، اللَّهُمَّ إنْ تُهْلِكْ هذِه العِصَابَةَ مِن أَهْلِ الإسْلَامِ لا تُعْبَدْ في الأرْضِ، ",["فَما زَالَ يَهْتِفُ برَبِّهِ، مَادًّا يَدَيْهِ مُسْتَقْبِلَ القِبْلَةِ",1],"، حتَّى سَقَطَ رِدَاؤُهُ عن مَنْكِبَيْهِ، فأتَاهُ أَبُو بَكْرٍ فأخَذَ رِدَاءَهُ، فألْقَاهُ علَى مَنْكِبَيْهِ، ثُمَّ التَزَمَهُ مِن وَرَائِهِ، وَقالَ: يا نَبِيَّ اللهِ، كَفَاكَ مُنَاشَدَتُكَ رَبَّكَ؛ فإنَّه سَيُنْجِزُ لكَ ما وَعَدَكَ، فأنْزَلَ اللَّهُ عَزَّ وَجَلَّ: { إِذْ تَسْتَغِيثُونَ رَبَّكُمْ فَاسْتَجَابَ لَكُمْ أَنِّي مُمِدُّكُمْ بِأَلْفٍ مِنَ الْمَلَائِكَةِ مُرْدِفِينَ} [الأنفال: 9]، ",["فأمَدَّهُ اللَّهُ بالمَلَائِكَةِ",2],". قالَ أَبُو زُمَيْلٍ: فَحدَّثَني ابنُ عَبَّاسٍ قالَ: بيْنَما رَجُلٌ مِنَ المُسْلِمِينَ يَومَئذٍ يَشْتَدُّ في أَثَرِ رَجُلٍ مِنَ المُشْرِكِينَ أَمَامَهُ، إذْ سَمِعَ ضَرْبَةً بالسَّوْطِ فَوْقَهُ وَصَوْتَ الفَارِسِ يقولُ: أَقْدِمْ حَيْزُومُ ، فَنَظَرَ إلى المُشْرِكِ أَمَامَهُ، فَخَرَّ مُسْتَلْقِيًا، فَنَظَرَ إلَيْهِ فَإِذَا هو قدْ خُطِمَ أَنْفُهُ، وَشُقَّ وَجْهُهُ، كَضَرْبَةِ السَّوْطِ، فَاخْضَرَّ ذلكَ أَجْمَعُ، فَجَاءَ الأنْصَارِيُّ، فَحَدَّثَ بذلكَ رَسولَ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، فَقالَ: صَدَقْتَ؛ ذلكَ مِن مَدَدِ السَّمَاءِ الثَّالِثَةِ، فَقَتَلُوا يَومَئذٍ سَبْعِينَ، وَأَسَرُوا سَبْعِينَ. قالَ أَبُو زُمَيْلٍ: قالَ ابنُ عَبَّاسٍ: فَلَمَّا أَسَرُوا الأُسَارَى، قالَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ لأَبِي بَكْرٍ وَعُمَرَ: ما تَرَوْنَ في هَؤُلَاءِ الأُسَارَى؟ فَقالَ أَبُو بَكْرٍ: يا نَبِيَّ اللهِ، هُمْ بَنُو العَمِّ وَالْعَشِيرَةِ، أَرَى أَنْ تَأْخُذَ منهمْ فِدْيَةً فَتَكُونُ لَنَا قُوَّةً علَى الكُفَّارِ؛ فَعَسَى اللَّهُ أَنْ يَهْدِيَهُمْ لِلإِسْلَامِ، فَقالَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ: ما تَرَى يا ابْنَ الخَطَّابِ؟ قُلتُ: لا، وَاللَّهِ يا رَسولَ اللهِ ما أَرَى الَّذي رَأَى أَبُو بَكْرٍ، وَلَكِنِّي أَرَى أَنْ تُمَكِّنَّا فَنَضْرِبَ أَعْنَاقَهُمْ، فَتُمَكِّنَ عَلِيًّا مِن عَقِيلٍ فَيَضْرِبَ عُنُقَهُ، وَتُمَكِّنِّي مِن فُلَانٍ -نَسِيبًا لِعُمَرَ- فأضْرِبَ عُنُقَهُ؛ فإنَّ هَؤُلَاءِ أَئِمَّةُ الكُفْرِ وَصَنَادِيدُهَا، فَهَوِيَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ ما قالَ أَبُو بَكْرٍ، وَلَمْ يَهْوَ ما قُلتُ، فَلَمَّا كانَ مِنَ الغَدِ جِئْتُ، فَإِذَا رَسولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ وَأَبُو بَكْرٍ قَاعِدَيْنِ يَبْكِيَانِ، قُلتُ: يا رَسولَ اللهِ، أَخْبِرْنِي مِن أَيِّ شَيءٍ تَبْكِي أَنْتَ وَصَاحِبُكَ؟ فإنْ وَجَدْتُ بُكَاءً بَكَيْتُ، وإنْ لَمْ أَجِدْ بُكَاءً تَبَاكَيْتُ لِبُكَائِكُمَا، فَقالَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ: أَبْكِي لِلَّذِي عَرَضَ عَلَيَّ أَصْحَابُكَ مِن أَخْذِهِمِ الفِدَاءَ، لقَدْ عُرِضَ عَلَيَّ عَذَابُهُمْ أَدْنَى مِن هذِه الشَّجَرَةِ -شَجَرَةٍ قَرِيبَةٍ مِن نَبِيِّ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ- وَأَنْزَلَ اللَّهُ عَزَّ وَجَلَّ: {مَا كَانَ لِنَبِيٍّ أَنْ يَكُونَ لَهُ أَسْرَى حَتَّى يُثْخِنَ فِي الْأَرْضِ} إلى قَوْلِهِ {فَكُلُوا ممَّا غَنِمْتُمْ حَلَالًا طَيِّبًا} [الأنفال: 67 - 69]، فأحَلَّ اللَّهُ الغَنِيمَةَ لهمْ.]"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"[ثابت]","bab":"قرآن › أسباب النزول","dorar":"uqtv48mc"},{"id":"س-03898","fp":"795128fa932b","stateId":332,"easy":"إذا ظلمك أقاربك فدعوت الله عليهم ← يستجيب لك (من قصة)","cause":"يَأكُلونَ مالي، ويَشتِمونَ عِرْضي، وأنا أشتَهيهم، وناشَدتُهمُ اللهَ والرَّحِمَ، فأبَوْا علَيَّ","result":"فلم يَحُلِ الحَولُ حتى هَلَكوا غَيرَ واحِدٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[56],"ref":"فضائل الأوقات 12","srcLabel":"البيهقي","text":["بَينا نحن عِندَ عُمَرَ بنِ الخَطَّابِ رَضيَ اللهُ عنه في يَومٍ يَعرِضُ فيه الدِّيوانَ إذْ مَرَّ به رَجُلٌ أعمى، أعرَجُ، قد عَنَّى قائِدَه، فقالَ عُمَرُ حين رآه وأعجَبَه شَأنُه: مَن يَعرِفُ هذا؟ قال رَجُلٌ مِنَ القَومِ: هذا رَجُلٌ مِن بَني صَبغاءَ، بَهلةَ بَريقٍ، قال: وما بَريقٌ؟ قال: رَجُلٌ مِن أهلِ اليَمَنِ؟ قال: أشاهِدٌ هو؟ قال: نَعَمْ. فأُتيَ به عُمَرُ فقال: ما شَأنُكَ وشَأنُ بَني صَبغاءَ؟ قال: إنَّ بَني صَبغاءَ كانوا اثنَيْ عَشَرَ رَجُلًا، وإنَّهم جاوَروني في الجاهليَّةِ، فجَعَلوا ",["يَأكُلونَ مالي، ويَشتِمونَ عِرْضي، وأنا أشتَهيهم، وناشَدتُهمُ اللهَ والرَّحِمَ، فأبَوْا علَيَّ",1],"، فأمهَلتُهم حتى إذا كان الشَّهرُ الحَرامُ دَعَوتُ اللهَ عليهم، وقُلتُ: \nاللَّهمَّ أدعوكَ دُعاءً جاهِدَا *** اقتُلْ بَني صَبغاءَ إلَّا واحِدًا\nثم اضرِبِ الرَّجُلَ فذَره قاعِدَا *** أعمى إذا ما قيدَ عَنَّى القائِدا\n",["فلم يَحُلِ الحَولُ حتى هَلَكوا غَيرَ واحِدٍ",2],"، وهو هذا كما ترى قد عَنَّى قائِدَه. فقالَ عُمَرُ: سُبحانَ اللهِ! إنَّ في هذا لَعِبَرًا وعَجَبًا. فقالَ رَجُلٌ آخَرُ مِنَ القَومِ: ألَا أُحَدِّثُكَ يا أميرَ المُؤمِنينَ مِثلَ هذا وأعجَبَ منه؟ فقال: بلى. قال: فإنَّ رِجالًا مِن خُزاعةَ جاوَروا رَجُلًا منهم، فقَطَعوا رَحِمَه، وأساؤوا مُجاوَرَتَه، وإنَّه ناشَدَهمُ اللهَ والرَّحِمَ إلَّا أعفَوْه مِمَّا يَكرَهُ، فأبَوْا عليه، فأمهَلَهم حتى إذا جاءَ الشَّهرُ الحَرامُ دعا عليهم فقالَ:\nاللَّهمَّ رَبَّ كُلِّ آمِنٍ وخائِفْ *** وسامِعًا هُتافَ كُلِّ هاتِفْ\nإنَّ الخُزاعِيَّ أبا تَقاصُفْ *** لم يُعطِني الحَقَّ ولم يُناصِفْ\nفاجمَعْ له الأحِبَّةَ ‌[الألاطف]* بَني قِرانٍ ثَمَّ والنَّواصِفْ\nاجمَعْهم في جَوفِ كُلِّ راجِفْ\nقال: فبَينا هم عِندَ قَليبٍ يَنزِفونَها، فمنهم مَن هو فيها، ومنهم مَن هو فَوقَها تَهَوَّرَ القَليبُ بمَن كان عليها وعلى مَن كانَ فيها، وصارَتْ قُبورُهم حتى الساعةِ، قال عُمَرُ: سُبحانَ اللهِ! إنَّ في هذا لَعِبرةً وعَجَبًا، فقالَ رَجُلٌ مِنَ القَومِ آخَرُ: يا أميرَ المُؤمِنينَ ألَا أُخبِرُكَ بمِثلِ هذا وأعجَبَ منه؟ قال: بلى. قال: فإنَّ رَجُلًا مِن هُذَيلٍ وَرِثَ فَخِذَه التي هو فيها، حتى لم يَبقَ منهم أحَدٌ غَيرُه، فجَمَعَ مالًا كَثيرًا فعَمَدَ إلى رَهطٍ مِن قَومِه، يُقالُ لهم: بَنو المُؤَمَّلِ، فجاوَرَهم لِيَمنَعوه، ولِيرُدُّوا عليه ماشِيَتَه، وإنَّهم حَسَدوه على مالِه ونَفَسوه مالَه، فجَعَلوا يَأكُلونَ مِن مالِه، ويَشتِمونَ عِرضَه، وأنَّه ناشَدَهمُ اللهَ والرَّحِمَ إلَّا عَدَلوا عنه ما يَكرَه، فأبَوْا عليه، فجَعَلَ رَجُلٌ منهم يُقالُ له: رَباحٌ، أو رياحٌ، يُكَلِّمُهم فيه، ويَقولُ: يا بَني المُؤَمَّلِ، ابنُ عَمَّتِكمُ اختارَ مُجاوَرَتَكم على مَن سِواكم، فأحسِنوا مُجاوَرَتَه، فأبَوْا عليه، فأمهَلَهم حتى إذا كانَ الشَّهرُ الحَرامُ دعا عليهم، فقال:\nاللَّهمَّ أزِلْ عَنِّي بَني المُؤَمَّلِ *** وارْمِ على أقفائِهم بمَنكِلِ\nبصَخرةٍ أو عَرضِ جَيشٍ جَحفَلِ *** إلَّا رَباحًا إنَّه لم يَفعَلِ\nقال: فبَينَما هم ذاتَ يَومٍ نُزولٌ إلى أصلِ جَبَلٍ انحَطَّتْ عليهم صَخرةٌ مِنَ الجَبَلِ، لا تَمُرُّ بشَيءٍ إلَّا طَحَنَتْه، حتى مَرَّتْ بأبياتِهم فطَحَنَتْها طَحنةً واحِدةً، إلَّا رَباحًا الذي استَثْناهُ. فقال: سُبحانَ اللهِ! إنَّ في هذا لَعِبرةً وعَجَبًا. فقالَ رَجُلٌ مِنَ القَومِ: ألَا أُخبِرُكَ يا أميرَ المُؤمِنينَ مِثلَه وأعجَبَ منه؟ قال: بلى. قال: فإنَّ رَجُلًا مِن جُهَينةَ جاوَرَ قَومًا مِن بَني ضَمرةَ في الجاهليَّةِ، وكانَ رَجُلٌ مِن بَني ضَمرةَ يُقالُ له: ريشةُ، يَعدو عليه، فلا يَزالُ يَنحَرُ بَعيرًا مِن إبِلِه وإنَّه كَلَّمَ قَومَه فيه، فقالوا: إنَّا خَلَعْناه، فانظُرْ أنْ نَقتُلَه. فلَمَّا رآه لا يَنتَهي أمهَلَه حتى إذا كانَ الشَّهرُ الحَرامُ دَعا عليه، فقالَ:\nأصادِقٌ ريشةُ بلا ضَمرةْ *** أنْ يُسيِّرَ اللهُ عليه قَدَرَهْ\nأمَا يَزالُ شارِفٌ أو بَكْرَةْ *** يَطعُنُ منها في سَواءِ الثُّغرةْ\nبصارِمٍ ذي رَونَقٍ أو شَفرةْ *** اللَّهمَّ إنْ كان بَعدي فَجرَهْ\nفاجعَلْ أمامَ العَينِ منه حَذرَهْ *** يَأكُلُه حتى يُوافى الحُفرةْ\nفسَلَّطَ الله عليه أكَلةً فأكَلَتْه حتى ماتَ قَبلَ الحَولِ. فقالَ عُمَرُ: سُبحانَ اللهِ! إنَّ في هذا لَعِبرةً وعَجَبًا، وإنْ كانَ اللهُ لَيَصنَعُ هذا بالناسِ في جاهليَّتِهم لِيَنزِعَ بَعضَهم مِن بَعضٍ، فلَمَّا أتى اللهُ بالإسلامِ أخَّرَ اللهُ العُقوبةَ إلى يَومِ القِيامةِ، وذلك أنَّ اللهَ تَعالى قالَ: {إِنَّ يَوْمَ الْفَصْلِ مِيقَاتُهُمْ أَجْمَعِينَ} [الدخان: 40]، {بَلِ السَّاعَةُ مَوْعِدُهُمْ وَالسَّاعَةُ أَدْهَى وَأَمَرُّ} [القمر: 46]، وقال: {وَلَوْ يُؤَاخِذُ اللَّهُ النَّاسَ بِظُلْمِهِمْ مَا تَرَكَ عَلَيْهَا مِنْ دَابَّةٍ وَلَكِنْ يُؤَخِّرُهُمْ إِلَى أَجَلٍ مُسَمًّى} [النحل: 61]."],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (3529) واللفظ له، وابن أبي الدنيا في ((مجابو الدعوة)) (20)، وابن عساكر في ((فضل رجب)) (4) بنحوه.","bab":"تفسير آيات › سورة الدخان","dorar":"5hVa44Z0"},{"id":"ق-0891","fp":"e747bfa531e2","stateId":332,"easy":"الدعاء بالفتح والنجاة عند التكذيب ← النجاة في الفلك وإغراق المكذبين","cause":"الدعاء بالفتح والنجاة عند التكذيب","result":"النجاة في الفلك وإغراق المكذبين","explicit":true,"otherNeedIds":[4,61],"ref":"سورة الشعراء: 117–120","srcLabel":"القرآن الكريم","quran":{"s":26,"from":117,"to":120,"text":"قَالَ رَبِّ إِنَّ قَوْمِي كَذَّبُونِ (117) فَافْتَحْ بَيْنِي وَبَيْنَهُمْ فَتْحًا وَنَجِّنِي وَمَنْ مَعِيَ مِنَ الْمُؤْمِنِينَ (118) فَأَنْجَيْنَاهُ وَمَنْ مَعَهُ فِي الْفُلْكِ الْمَشْحُونِ (119) ثُمَّ أَغْرَقْنَا بَعْدُ الْبَاقِينَ (120)","hl":[[0,133,1],[133,232,2]]}},{"id":"س-07682","fp":"66fcf107f4ff","stateId":333,"easy":"إذا دعوت ← ينفعك الدعاء مما نزل ومما لم ينزل","cause":"والدُّعاءُ","result":"يَنفعُ ممَّا نَزَلَ، وممَّا لمْ يَنزِلْ","explicit":true,"similar":["س-07685","س-07687","س-07683"],"otherNeedIds":[4],"ref":"الجامع الصغير 9959","srcLabel":"الحاكم","text":["لا يُغني حَذرٌ مِن قَدَرٍ، [",["والدُّعاءُ",1]," ",["يَنفعُ ممَّا نَزَلَ، وممَّا لمْ يَنزِلْ",2],"، وإنَّ البلاءَ ليَنزِلُ فيَتلقَّاهُ الدُّعاءُ فيَعتلِجانِ إلى يومِ القيامةِ.]"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (2498)، والحاكم (1813) مطولاً واللفظ لهما، وابن عدي في ((الكامل في الضعفاء)) (3/212) مطولاً باختلاف يسير","bab":"قدر › كل شيء بقدر","dorar":"zOX5YBfO","merged":3,"otherRefs":["صحيح الجامع 3409 (حسن)","الجامع الصغير 7378 (حسن)"]},{"id":"س-07685","fp":"c2ecf20779cc","stateId":333,"easy":"إذا دعوت ← يدفع الدعاء القدر","cause":"والدعاءُ","result":"يدفعُ القدرَ","explicit":true,"repOf":"س-07682","otherNeedIds":[4],"ref":"معجم الشيوخ 1/109","text":["العجزُ والكَيسُ بقدرٍ ولا يغني الحذرُ منَ القدرِ ",["والدعاءُ",1]," ",["يدفعُ القدرَ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أوله صحيح وآخره غريب","takhrij":"أخرجه الحاكم (3333)، والبيهقي في ((القضاء والقدر)) (254) بنحوه، وابن عساكر في ((معجم الشيوخ)) (116) واللفظ له","bab":"قدر › كل شيء بقدر","dorar":"jvOTpCee"},{"id":"س-07687","fp":"65341f745b4e","stateId":333,"easy":"إذا دعوت ← يمحو الله بالدعاء ما يشاء من القدر","cause":"بالدُّعاءِ","result":"ولكنَّ اللهَ يمحو بالدُّعاءِ ما يشاءُ مِنَ القَدَرِ","explicit":true,"repOf":"س-07682","otherNeedIds":[31],"ref":"المستدرك على الصحيحين 3376","text":["عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهُما، قالَ: لا ينفعُ الحذَرُ مِنَ القَدَرِ، ",["ولكنَّ اللهَ يمحو بالدُّعاءِ ما يشاءُ مِنَ القَدَرِ",2],"."],"grade":"صحيح","narrator":"طاوس","muhaddith":"صحيح الإسناد","bab":"قدر › وقوع قدر الله وقضائه","dorar":"O4UfWiok"},{"id":"س-07683","fp":"96efe4c187fc","stateId":333,"easy":"إذا دعوت الله ← يلقى الدعاءُ البلاءَ فيعتلجان إلى يوم القيامة","cause":"فيَتلقَّاهُ الدُّعاءُ","result":"فيَعتلِجانِ إلى يومِ القيامةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-07682","otherNeedIds":[4],"ref":"الجامع الصغير 9959","text":["لا يُغني حَذرٌ مِن قَدَرٍ، [والدُّعاءُ يَنفعُ ممَّا نَزَلَ، وممَّا لمْ يَنزِلْ، وإنَّ البلاءَ ليَنزِلُ ",["فيَتلقَّاهُ الدُّعاءُ",1]," ",["فيَعتلِجانِ إلى يومِ القيامةِ",2],".]"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (2498)، والحاكم (1813) مطولاً واللفظ لهما، وابن عدي في ((الكامل في الضعفاء)) (3/212) مطولاً باختلاف يسير","bab":"قدر › كل شيء بقدر","dorar":"zOX5YBfO"},{"id":"س-01918","fp":"bdb2dd6f4a17","stateId":334,"easy":"إذا دعوت الله ← فعليه الإجابة","cause":"فمِنكَ الدُّعاءُ","result":"وعليَّ الإجابةُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-03474","ref":"حلية الأولياء 6/185","text":["عن النبيِّ صلَّى اللهُ عليه وسلَّمَ فيما يَرْوي عن ربِّه عزَّ وجلَّ قال: أربعُ خِصالٍ؛ واحدةٌ فيما بيني وبينَكَ، وواحدةٌ فيما بينَكَ وبينَ عبادي، وواحدةٌ لي، وواحدةٌ لكَ. فأمَّا التي لي: فتَعبُدُني لا تشرِكُ بي شيئًا، وأمَّا التي لكَ عليَّ: فما عمِلتَ مِن خَيرٍ جزَيتُكَ به، وأمَّا التي بيني وبينَكَ: ",["فمِنكَ الدُّعاءُ",1],"، ",["وعليَّ الإجابةُ",2],"، وأمَّا التي بينَكَ وبينَ عبادي تَرْضى لهم ما تَرْضى لنفْسِكَ."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"غريب من حديث الحسن تفرد به عنه صالح مرفوعا","takhrij":"أخرجه أبو يعلى (2757) بلفظه، والطبراني في ((الدعاء)) (16)، والبيهقي في ((شعب الإيمان)) (10671) كلاهما باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"TsvlE0Cn"},{"id":"س-00005","fp":"fb55da5e6780","stateId":334,"easy":"إذا نصبت وجهك إلى الله تسأله ← يعطيك إما عاجلاً وإما ذخراً في الآخرة","cause":"ما من مؤمِنٍ ينصِبُ وجهَه إلى اللهِ ، يَسألُ مسألةً","result":"إلَّا أعطاهُ إيَّاها ، إما عجَّلَها لهُ في الدُّنيا ، و إما ذَخَرَها لهُ في الآخرةِ ما لَم يَعْجَلْ","explicit":true,"repOf":"س-00059","ref":"صحيح الأدب المفرد 548","text":[["ما من مؤمِنٍ ينصِبُ وجهَه إلى اللهِ ، يَسألُ مسألةً",1]," ",["إلَّا أعطاهُ إيَّاها ، إما عجَّلَها لهُ في الدُّنيا ، و إما ذَخَرَها لهُ في الآخرةِ ما لَم يَعْجَلْ",2]," قالوا يا رسولَ اللهِ ، و ما عَجَلَتُه ؟ قال : يقولُ : دعوتُ و دَعوتُ ، ولا أُراه يُستجابُ لي"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه مسلم  (2735) بنحوه، والبخاري في ((الأدب المفرد)) (711) واللفظ له","bab":"آداب الدعاء › استجابة الدعاء","dorar":"4JdcamH5"},{"id":"س-00059","fp":"de22b451e903","stateId":334,"easy":"إذا دعوت بلا إثم ولا قطيعة رحم ← يعطيك إحدى ثلاث: تعجيل أو ادخار أو صرف سوء","cause":"ما من مسلِمٍ يَدعو ، ليسَ بإثمٍ و لا بِقطيعةِ رَحِمٍ","result":"إلَّا أَعطَاه إِحدَى ثلاثٍ : إمَّا أن يُعَجِّلَ لهُ دَعوَتَهُ ، و إمَّا أن يَدَّخِرَها لهُ في الآخرةِ ، و إمَّا أن يَدْفَعَ عنهُ من السُّوءِ مِثْلَها","explicit":true,"star":true,"similar":["س-00005","س-00750","س-00006","س-03384","س-00026","س-00066","س-00855","س-03295","س-00048","س-00094"],"ref":"صحيح الأدب المفرد 547","srcLabel":"البخاري","text":[["ما من مسلِمٍ يَدعو ، ليسَ بإثمٍ و لا بِقطيعةِ رَحِمٍ",1]," ",["إلَّا أَعطَاه إِحدَى ثلاثٍ : إمَّا أن يُعَجِّلَ لهُ دَعوَتَهُ ، و إمَّا أن يَدَّخِرَها لهُ في الآخرةِ ، و إمَّا أن يَدْفَعَ عنهُ من السُّوءِ مِثْلَها",2]," قال : إذًا نُكثِرَ ، قالَ : اللهُ أَكثَرُ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (11133)، والبخاري في ((الأدب المفرد)) (710) واللفظ له، وأبو يعلى (1019)","bab":"آداب الدعاء › استجابة الدعاء","dorar":"MXQe94Dk"},{"id":"س-00750","fp":"1990b9ddd71f","stateId":334,"easy":"إذا نصبت وجهك لله في مسألة ← يعطيكها إما عاجلاً أو ذخراً","cause":"ما مِن عَبدٍ يَنصِبُ وَجهَهُ إلى اللهِ عزَّ وجلَّ في مَسألةٍ","result":"إلَّا أَعطاهُ اللهُ إيَّاها؛ إمَّا أنْ يُعجِّلَها، وإمَّا أنْ يَدَّخِرَها","explicit":true,"repOf":"س-00059","ref":"المستدرك على الصحيحين 1853","text":[["ما مِن عَبدٍ يَنصِبُ وَجهَهُ إلى اللهِ عزَّ وجلَّ في مَسألةٍ",1]," ",["إلَّا أَعطاهُ اللهُ إيَّاها؛ إمَّا أنْ يُعجِّلَها، وإمَّا أنْ يَدَّخِرَها",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (9785) واللفظ له، والترمذي (3604)، والبخاري في ((الأدب المفرد)) (711) بنحوه مطولًا.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"rfYKGFTd"},{"id":"س-00006","fp":"d477a077e6db","stateId":334,"easy":"إذا نصبت وجهك لله في مسألة ← يعطيكها عاجلاً أو يدخرها لك","cause":"ما من مسلمٍ ينصبُ وجهَه للهِ عزَّ وجلَّ في مسألة","result":"إلا أعطاها إياه ، إما أن يُعَجِّلَها له ، وإما أن يدَّخرَها له في الآخرةِ","explicit":true,"repOf":"س-00059","ref":"صحيح الترغيب 1632","text":[["ما من مسلمٍ ينصبُ وجهَه للهِ عزَّ وجلَّ في مسألة ؛",1]," ",["إلا أعطاها إياه ، إما أن يُعَجِّلَها له ، وإما أن يدَّخرَها له في الآخرةِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه مسلم  (2735) بنحوه مطولاً، وأحمد (9785) واللفظ له","bab":"آداب الدعاء › استجابة الدعاء","dorar":"XbOQgLuR"},{"id":"س-03384","fp":"921bbf000330","stateId":334,"easy":"إذا دعوت الله ← يُستجاب لك إما عاجلاً أو مدخراً","cause":"ما مِن رجلٍ يَدعو اللَّهَ بدعاءٍ","result":"إلَّا استُجيبَ لَهُ ، فإمَّا أن يعجَّلَ له في الدُّنيا ، وإمَّا أن يُدَّخرَ لَهُ في الآخرةِ ، وإمَّا أن يُكَفَّرَ عنهُ من ذنوبِهِ بقدرِ ما دعا ، ما لم يَدعُ بإثمٍ أو قَطيعةِ رحمٍ","explicit":true,"repOf":"س-00059","otherNeedIds":[11],"ref":"صحيح الترمذي 3604","text":[["ما مِن رجلٍ يَدعو اللَّهَ بدعاءٍ",1]," ",["إلَّا استُجيبَ لَهُ ، فإمَّا أن يعجَّلَ له في الدُّنيا ، وإمَّا أن يُدَّخرَ لَهُ في الآخرةِ ، وإمَّا أن يُكَفَّرَ عنهُ من ذنوبِهِ بقدرِ ما دعا ، ما لم يَدعُ بإثمٍ أو قَطيعةِ رحمٍ",2]," أو يستعجِلْ . قالوا : يا رسولَ اللَّهِ وَكَيفَ يستَعجلُ ؟ قالَ : يقولُ : دعوتُ ربِّي فما استجابَ لي"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح دون قوله: \"وإما أن يكفر عنه من ذنوبه بقدر ما دعا\"","takhrij":"أخرجه مسلم (2735) بنحوه، والترمذي (3604) واللفظ له، وأحمد (9148) مختصراً","bab":"استغفار › أسباب المغفرة","dorar":"NBxSvEe6"},{"id":"س-06954","fp":"325a51e427b2","stateId":334,"easy":"إذا رفعت يديك إلى ربك ← يستحيي أن يردهما صفراً","cause":"إذا رفع يَدَيْهِ إليه","result":"إنَّ ربَّكم حَيِيٌّ كريمٌ ، يَسْتَحْيِي من عبدِه – إذا رفع يَدَيْهِ إليه – أن يَرُدَّهُما صِفْرًا","explicit":true,"star":true,"similar":["س-00025","س-00068","س-00047"],"ref":"هداية الرواة 2184","srcLabel":"أبو داود","text":[["إنَّ ربَّكم حَيِيٌّ كريمٌ ، يَسْتَحْيِي من عبدِه – إذا رفع يَدَيْهِ إليه – أن يَرُدَّهُما صِفْرًا",2]," ؛ أي : خالِيًا"],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1488)، والترمذي (3556)، وابن حبان (4733) باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"BN3Ggxlp","merged":9,"otherRefs":["فتاوى نور على الدرب لابن باز 9/149 (حسن)","صحيح ابن حبان 880 (صحيح)","ما تمس إليه الحاجة 119 (صحيح)","المستدرك على الصحيحين 1856 (صحيح)","صحيح الترمذي 3556 (صحيح)","صحيح الجامع 1757 (صحيح)","مختصر العلو 37 (صحيح)","العرش للذهبي 59 (صحيح)"]},{"id":"ق-0065","fp":"ebd1a9cae859","stateId":334,"easy":"دعاء الله ← قرب الله وإجابة الدعوة","cause":"دعاء الله","result":"قرب الله وإجابة الدعوة","explicit":true,"otherNeedIds":[26],"ref":"سورة البقرة: 186","srcLabel":"القرآن الكريم","quran":{"s":2,"from":186,"to":186,"text":"وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ فَلْيَسْتَجِيبُوا لِي وَلْيُؤْمِنُوا بِي لَعَلَّهُمْ يَرْشُدُونَ (186)","hl":[[0,33,1],[33,75,2],[75,89,1]]}},{"id":"ق-1308","fp":"52f2742a9f9b","stateId":334,"easy":"الشكوى إلى الله ← سماع الله وفرجه","cause":"الشكوى إلى الله","result":"سماع الله وفرجه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[4],"ref":"سورة المجادلة: 1","srcLabel":"القرآن الكريم","quran":{"s":58,"from":1,"to":1,"text":"قَدْ سَمِعَ اللَّهُ قَوْلَ الَّتِي تُجَادِلُكَ فِي زَوْجِهَا وَتَشْتَكِي إِلَى اللَّهِ وَاللَّهُ يَسْمَعُ تَحَاوُرَكُمَا إِنَّ اللَّهَ سَمِيعٌ بَصِيرٌ (1)","hl":[[0,19,2],[19,86,1]]}},{"id":"س-06435","fp":"3947654cab11","stateId":334,"easy":"إذا سألت الله ← يعطيك","cause":"ومن سألني","result":"أعطيتُه","explicit":true,"similar":["س-00050"],"otherNeedIds":[67],"ref":"الترغيب والترهيب 4/333","srcLabel":"البزار","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم أُتِي بفرَسٍ يجعلُ كلَّ خطوٍ منه أقصَى بصرِه ، فسار وسار معه جبريلُ عليه السَّلامُ ، فأتَى على قومٍ يزرَعون في يومٍ ويحصُدون في يومٍ كلَّما حصدوا عاد كما كان ، فقال : يا جبريلُ من هؤلاء ؟ قال : هؤلاء المجاهدون في سبيلِ اللهِ ، تُضاعَفُ لهم الحسنةُ بسبعِمائةِ ضِعفٍ وما أنفقوا من شيءٍ فهو يُخلِفُه ، ثمَّ أتَى على قومٍ تُرضَخُ رءوسُهم بالصَّخرِ كلَّما رُضِخت عادت كما كانت ، ولا يفتُرُ عنهم من ذلك شيءٌ ، قال : يا جبريلُ من هؤلاء ؟ قال : هؤلاء الَّذين تثاقلت رءوسُهم عن الصَّلاةِ ، ثمَّ أتَى على قومٍ على أدبارِهم رِقاعٌ ، وعلى أقبالِهم رِقاعٌ يسرَحون كما تسرَحُ الأنعامُ إلى الضَّريعِ والزَّقُّومِ ورِضفِ جهنَّمَ قال : ما هؤلاء يا جبريلُ ؟ قال هؤلاء الَّذين لا يُؤدُّون صدقاتِ أموالِهم ، وما ظلمهم اللهُ ، وما اللهُ بظلَّامٍ للعبيدِ . ثمَّ أتَى على رجلٍ قد جمع حِزمةً عظيمةً لا يستطيعُ حملَها وهو يريدُ أن يزيدَ عليها ، قال : يا جبريلُ ما هذا ؟ قال : هذا رجلٌ من أمَّتِك عليه أمانةُ النَّاسِ لا يستطيعُ أداءَها وهو يريدُ أن يزيدَ عليها ، ثمَّ أتَى على قومٍ تُقرَضُ شِفاهُهم وألسنتُهم بمقاريضَ من حديدٍ ، كلَّما قُرِضتْ عادت كما كانت ، لا يفتُرُ عنهم من ذلك شيءٌ ، قال : يا جبريلُ ما هؤلاء ؟ قال : خطباءُ الفِتنةِ ، ثمَّ أتَى على جُحرٍ صغيرٍ يخرُجُ منه ثوْرٌ عظيمٌ فيُريدُ الثَّورُ أن يدخُلَ من حيث خرج فلا يستطيعُ ، قال : ما هذا يا جبريلُ ؟ قال : هذا الرَّجلُ يتكلَّمُ بالكلمةِ العظيمةِ فيندَمُ عليها فيُريدُ أن يرُدَّها فلا يستطيعُ ، ثمَّ أتَى على وادٍ فوجد ريحًا طيِّبةً ووجد ريحَ مِسكٍ مع صوتٍ ، فقال : ما هذا ؟ قال : صوتُ الجنَّةِ تقولُ : يا ربِّ ائتِني بأهلي وبما وعدتَني فقد كثُر غرسي وحريري وسُندسي وإستبرقي وعبقريِّي ومرجاني وفضَّتي وذهبي وأكوابي وصِحافي وأباريقي وفواكهي وعسلي ومائي ولبني وخمري ، ائتِني بما وعدتَني . قال : لك كلُّ مسلمٍ ومسلمةٍ ومؤمنٍ ومؤمنةٍ ، ومن آمن بي وبرسلي ، وعمِل صالحًا ولم يُشرِكْ بي شيئًا ، ولم يتَّخِذْ من دوني أندادًا فهو آمِنٌ ، ",["ومن سألني",1]," ",["أعطيتُه",2]," ، ومن أقرضني جزيْتُه ، ومن توكَّل عليَّ كفَيْتُه ، إنِّي أنا اللهُ لا إلهَ إلَّا أنا ، لا خُلْفَ لميعادي ، قد أفلح المؤمنون ، تبارك اللهُ أحسنُ الخالقين ، فقالت : قد رَضيتُ ، ثمَّ أتَى على وادٍ فسمِع صوتًا مُنكَرًا ، فقال : يا جبريلُ ما هذا الصَّوتُ ؟ قال : هذا صوتُ جهنَّمَ تقولُ : يا ربِّ ائتِني بأهلي وبما وعدتَني فقد كثُرت سلاسلي وأغلالي وسعيري وحميمي وغَسَّاقي وغسليني ، وقد بعُد قعري ، واشتدَّ حرِّي ، ائتِني بما وعدتَني ، قال : لك كلُّ مشركٍ ومشركةٍ ، وخبيثٍ وخبيثةٍ ، وكلُّ جبَّارٍ لا يُؤمِنُ بيومِ الحسابِ ، قالت : قد رضِيتُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه البزار (9518)، وابن أبي حاتم في ((التفسير)) (13521) باختلاف يسير، والطبري في ((التفسير)) (14/424) على الشك في راويه أبو هريرة أو غيره","bab":"صلاة › تارك الصلاة","dorar":"CrAPhgwx","merged":2,"otherRefs":["حلية الأولياء 6/188 (حسن)"]},{"id":"س-00025","fp":"2ad652a7de2a","stateId":334,"easy":"إذا رفعت يديك إلى الله تسأله خيراً ← يستحيي أن يردهما صفراً","cause":"يَبسُطَ العَبدُ إليه يَدَيهِ يَسْألُهُ فيهما خَيرًا","result":"إنَّ اللهَ لَيَسْتحي أنْ يَبسُطَ العَبدُ إليه يَدَيهِ يَسْألُهُ فيهما خَيرًا، فيَرُدَّهما خائِبَتَينِ","explicit":true,"repOf":"س-06954","ref":"تخريج المسند لشعيب 23715","text":["عن النَّبيِّ صلَّى اللهُ عليه وسلَّم بمِثْلِه. [أي بمِثلِ حَديثِ: ",["إنَّ اللهَ لَيَسْتحي أنْ يَبسُطَ العَبدُ إليه يَدَيهِ يَسْألُهُ فيهما خَيرًا، فيَرُدَّهما خائِبَتَينِ",2],"]"],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1488)، والترمذي (3556)، وابن ماجه (3865)، وأحمد (23715) واللفظ له","bab":"آداب الدعاء › استجابة الدعاء","dorar":"8VRtuBvz"},{"id":"س-00026","fp":"a622d7e3e156","stateId":334,"easy":"إذا دعوت الله بدعوة ← يعطيك إياها أو يصرف عنك من السوء مثلها","cause":"ما على الأرْضِ مُسلِمٌ يدعو اللهَ تعالى بدَعوةٍ","result":"إلَّا آتاهُ اللهُ إيَّاها، أو صَرَفَ عنه من السوءِ مثلَها، ما لم يَدْعُ بإثمٍ، أو قطيعةِ رَحِمٍ","explicit":true,"repOf":"س-00059","otherNeedIds":[31],"ref":"تخريج رياض الصالحين 1501","text":[["ما على الأرْضِ مُسلِمٌ يدعو اللهَ تعالى بدَعوةٍ",1]," ",["إلَّا آتاهُ اللهُ إيَّاها، أو صَرَفَ عنه من السوءِ مثلَها، ما لم يَدْعُ بإثمٍ، أو قطيعةِ رَحِمٍ\"",2],"، فقال رَجلٌ من القومِ: إذًا نُكثِرُ. قال: \"اللهُ أكثرُ\"."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3573) واللفظ له، وعبدالله بن أحمد في ((زوائد المسند)) (22785) مختصراً","bab":"آداب الدعاء › استجابة الدعاء","dorar":"zkCq4Neb"},{"id":"س-00066","fp":"c920a813aad5","stateId":334,"easy":"إذا دعوت وأنت مؤمن ← يبيّن الله لك يوم القيامة أنه عجّلها أو ادخرها","cause":"فلا يدعُ اللهُ دعوةً دعا بها عبدُه المؤمنُ","result":"إلَّا بيَّن له إمَّا يكونُ عجَّل له في الدُّنيا وإمَّا أن يكونَ ادَّخر له في الآخرةِ","explicit":true,"repOf":"س-00059","ref":"الترغيب والترهيب 2/389","text":["يدعو اللهُ بالمؤمنِ يومَ القيامةِ حتَّى يُوقِفَه بين يدَيْه فيقولُ عبدي إنِّي أمرتُك أن تدعوَني ووعدتُك أن أستجيبَ لك فهل كنتَ تدعوني فيقولُ نعم يا ربِّ فيقولُ أما إنَّك لم تدعُني بدعوةٍ إلَّا استجبتُ لك أليس دعوتَني يومَ كذا وكذا لغمٍّ نزل بك أن أفرِّجَ عنك ففرَّجتُ عنك فيقولُ نعم يا ربِّ فيقولُ إنِّي عجَّلتُها لك في الدُّنيا ودعوتَني يومَ كذا وكذا لغمٍّ نزل بك أن أفرِّجَ عنك فلم ترَ فرَجًا قال نعم ياربِّ فيقولُ إنِّي ادَّخرتُ لك بها في الجنَّةِ كذا وكذا ودعوتَني في حاجةٍ أقضيها لك في يومِ كذا وكذا فقضيتُها فيقولُ نعم يا ربِّ فيقولُ إنِّي عجَّلتُها لك في الدُّنيا ودعوتَني يومَ كذا وكذا في حاجةٍ أقضيها لك فلم ترَ قضاءَها فيقولُ نعم يا ربِّ فيقولُ إنِّي ادَّخرتُ لك بها في الجنَّةِ كذا وكذا قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["فلا يدعُ اللهُ دعوةً دعا بها عبدُه المؤمنُ",1]," ",["إلَّا بيَّن له إمَّا يكونُ عجَّل له في الدُّنيا وإمَّا أن يكونَ ادَّخر له في الآخرةِ",2]," قال فيقولُ المؤمنُ في ذلك المقامِ يا ليتَه لم يكُنْ عُجِّل له شيءٌ من دعائِه"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الدينوري في ((المجالسة)) (126)، والبيهقي في ((شعب الإيمان)) (1133) باختلاف يسير،، والحاكم (1819) واللفظ له","bab":"آداب الدعاء › استجابة الدعاء","dorar":"uqx82dEO"},{"id":"س-00068","fp":"32282496ca12","stateId":334,"easy":"إذا رفع القوم أكفهم إلى الله يسألونه ← حق على الله أن يضع في أيديهم ما سألوا","cause":"ما رفَع قومٌ أكُفَّهم إلى اللهِ عَزَّ وجَلَّ يسألونه شيئًا","result":"إلَّا كان حقًّا على اللهِ أن يضَعَ في أيديهم الَّذي سألوا","explicit":true,"repOf":"س-06954","ref":"مجمع الزوائد 10/172","text":[["ما رفَع قومٌ أكُفَّهم إلى اللهِ عَزَّ وجَلَّ يسألونه شيئًا",1]," ",["إلَّا كان حقًّا على اللهِ أن يضَعَ في أيديهم الَّذي سألوا",2]],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني (6/254) (6142)، وابن شاهين في ((الترغيب في فضائل الأعمال)) (144)، والمخلص في ((المخلصيات)) (2815)","bab":"آداب الدعاء › استجابة الدعاء","dorar":"8e1FAKjG"},{"id":"س-00855","fp":"fe9fe60c3db5","stateId":334,"easy":"إذا دعوت ← فأنت بين ثلاث: تُعطى ما سألت أو خيراً منه أو يُصرف عنك سوء","cause":"الداعِيَ","result":"بينَ ثلاثٍ إمَّا أنْ يُعْطَى ما سأل وإما أنْ يُعطَى خيرًا منه وإما أن يُدَّخَرَ له في الآخرةِ","explicit":true,"repOf":"س-00059","ref":"القبس 2/412","text":["إنَّ ",["الداعِيَ",1]," ",["بينَ ثلاثٍ إمَّا أنْ يُعْطَى ما سأل وإما أنْ يُعطَى خيرًا منه وإما أن يُدَّخَرَ له في الآخرةِ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"NCyS4yLE"},{"id":"س-03295","fp":"7d0a2c9e85c9","stateId":334,"easy":"إذا دعوت ← فأنت بين ثلاث: يُستجاب لك أو يُدخر لك أو يُكفّر عنك","cause":"ما من داعٍ يدعُو","result":"إلا كان بين إِحدى ثلاث ٍ: إما أَنْ يُستجابَ لهُ, وإما أن يُدّخرَ لهُ, وإما أن يُكفرَ عنهُ","explicit":true,"repOf":"س-00059","otherNeedIds":[11],"ref":"التمهيد 5/343","text":["زيدُ بن أسلمَ يقول ",["ما من داعٍ يدعُو",1]," ",["إلا كان بين إِحدى ثلاث ٍ: إما أَنْ يُستجابَ لهُ, وإما أن يُدّخرَ لهُ, وإما أن يُكفرَ عنهُ",2]],"grade":"صحيح","narrator":"مالك بن أنس","muhaddith":"محفوظ عن النبي صلى الله عليه وسلم","takhrij":"أخرجه مالك (730)، والبيهقي في ((الدعوات الكبير)) (379) بلفظه.","bab":"استغفار › أسباب المغفرة","dorar":"zbGlpwbA"},{"id":"س-07809","fp":"a288da14d122","stateId":334,"easy":"إذا شغلك القرآن عن الذكر والمسألة ← يعطيك الله أفضل ما يعطي السائلين","cause":"مَن شَغلَهُ القرآنُ عن ذِكْري ومسألَتي","result":"أعطيتُهُ أفضَلَ ما أعطي السَّائلينَ ، وفضلُ كلامِ اللَّهِ تعالى علَى سائرِ الكَلامِ كفَضلِ اللَّهِ تَعالى علَى خَلقِهِ","explicit":true,"ref":"تحفة المحتاج 2/173","srcLabel":"الترمذي","text":["يقولُ الرَّبُّ سبحانه وتعالى ",["مَن شَغلَهُ القرآنُ عن ذِكْري ومسألَتي ",1],["أعطيتُهُ أفضَلَ ما أعطي السَّائلينَ ، وفضلُ كلامِ اللَّهِ تعالى علَى سائرِ الكَلامِ كفَضلِ اللَّهِ تَعالى علَى خَلقِهِ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح أو حسن [كما اشترط على نفسه في المقدمة]","takhrij":"أخرجه الترمذي (2926) واللفظ له، والدارمي (3356)، والبيهقي في ((شعب الإيمان)) (2015) باختلاف يسير","bab":"قرآن › فضل قراءة القرآن","dorar":"RjZOVES2"},{"id":"س-00047","fp":"feb3d0b12050","stateId":334,"easy":"إذا رفعت يديك إلى ربك ← يستحيي أن يردهما صفراً","cause":"إنَّ ربَّكُم حَيِيٌّ كريمٌ، يَستَحْيِي إذا رَفَع العبدُ يدَيْهِ إِلَيْهِ فيَرُدُّهُما","result":"صِفْرًا حتَّى يَضَعَ فيهما خيرًا","explicit":true,"repOf":"س-06954","ref":"تخريج أقاويل الثقات 71","text":[["إنَّ ربَّكُم حَيِيٌّ كريمٌ، يَستَحْيِي إذا رَفَع العبدُ يدَيْهِ إِلَيْهِ فيَرُدُّهُما ",1],["صِفْرًا حتَّى يَضَعَ فيهما خيرًا",2],"."],"grade":"حسن","muhaddith":"إسناده جيد","takhrij":"أخرجه عبدالرزاق (3250)، والحاكم (1832)، والبغوي في ((شرح السنة)) (1386) باختلاف يسير من حديث أنس بن مالك رضي الله عنه.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"VeIq0qxe","merged":2,"otherRefs":["شرح السنة 3/159 (حسن)"]},{"id":"س-00048","fp":"d5e27aad0576","stateId":334,"easy":"إذا دعوت وأنت مسلم ← لا تُرد دعوتك إلا بإحدى ثلاث (تعجيل أو ادخار أو صرف سوء)","cause":"دعوةُ العبدِ المُسلِمِ","result":"لا تُرَدُّ إلَّا بإحدى ثلاثٍ","explicit":true,"repOf":"س-00059","ref":"تخريج مشكل الآثار 882","text":[["دعوةُ العبدِ المُسلِمِ ",1],["لا تُرَدُّ إلَّا بإحدى ثلاثٍ",2],"، ما لمْ يَدْعُ بإثْمٍ، أو قَطيعةِ رَحِمٍ، وإمَّا أنْ يُصرَفَ عنه منَ السُّوءِ بقَدْرِ ما دعا."],"grade":"حسن","narrator":"أبو سعيد","muhaddith":"إسناده حسن","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (882) واللفظ له، وأحمد (11133)، وابن أبي شيبة (29780) بنحوه.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"DXWvvGqL"},{"id":"س-00050","fp":"e605c6bcb04d","stateId":334,"easy":"إذا سألت الله شيئاً ← يعطيك","cause":"لا يُوجدُ مُسلِمٌ يَسألُ اللهَ عزَّ وجلَّ شيئًا","result":"إلَّا آتاهُ اللهُ","explicit":true,"repOf":"س-06435","ref":"تخريج سنن أبي داود 1048","text":["يومُ الجُمعةِ ثِنتا عشْرةَ -يُريدُ: ساعةً- ",["لا يُوجدُ مُسلِمٌ يَسألُ اللهَ عزَّ وجلَّ شيئًا",1],"، ",["إلَّا آتاهُ اللهُ",2]," عزَّ وجلَّ؛ فالْتمِسوها آخِرَ ساعةٍ بعدَ العصرِ."],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"إسناده قوي","takhrij":"أخرجه أبو داود (1048)، والنسائي (1389) بلفظه.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"IuxPcMsp"},{"id":"س-00094","fp":"63108fe28f95","stateId":334,"easy":"إذا دعوت ← يعطيك الله ما سألت أو يكفّ عنك من السوء مثله","cause":"ما أحَدٌ يَدعو بدُعاءٍ","result":"إلَّا آتاه اللهُ ما سَألَ، أو كَفَّ عنه مِن السُّوءِ مِثْلَه، ما لم يَدْعُ بإثْمٍ، أو بقَطيعةِ رَحِمٍ","explicit":true,"repOf":"س-00059","ref":"تخريج المسند لشعيب 14879","text":[["ما أحَدٌ يَدعو بدُعاءٍ",1]," ",["إلَّا آتاه اللهُ ما سَألَ، أو كَفَّ عنه مِن السُّوءِ مِثْلَه، ما لم يَدْعُ بإثْمٍ، أو بقَطيعةِ رَحِمٍ",2],"."],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"حسن لغيره","takhrij":"أخرجه الترمذي (3381)، وأحمد (14879) واللفظ له","bab":"آداب الدعاء › استجابة الدعاء","dorar":"S8smLh4z"},{"id":"س-03474","fp":"4b9cb5616404","stateId":334,"easy":"إذا دعوت وسألت ← فعلى الله الاستجابة","cause":"فعليكَ الدعاءُ والمسألةُ","result":"وعليَّ الاستجابةُ","explicit":true,"similar":["س-01918"],"ref":"الجامع الصغير 6050","srcLabel":"الطبراني","text":["قالَ اللهُ تعالى : يا ابنَ آدمَ ! ثلاثةٌ : واحدةٌ لي، وواحدةٌ لكَ، وواحدةٌ بيني وبينكَ . فأمَّا التي لي ؛ فتعبدُني لا تشركْ بي شيئًا، وأما التي لك ؛ فما عملتَ منْ عملٍ جزيتُك بهِ ؛ فإنْ أَغْفِرْ فأنا الغفورُ الرحيمُ، وأما التي بيني وبينكَ، ",["فعليكَ الدعاءُ والمسألةُ",1],"، ",["وعليَّ الاستجابةُ",2]],"grade":"حسن","narrator":"سلمان الفارسي","muhaddith":"حسن","takhrij":"أخرجه البزار (2523) والطبراني (6137) (6/ 253) والبيهقي في ((الأسماء والصفات)) (438) باختلاف يسير.","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"1eEbnlw4"}]}