ا عَظِيمًا (35)","hl":[[0,365,1],[365,417,2]]}},{"id":"ق-1005","fp":"f41c7f9a1cee","stateId":63,"easy":"الإيمان والعمل الصالح ← مغفرة ورزق كريم","cause":"الإيمان والعمل الصالح","result":"مغفرة ورزق كريم","explicit":true,"repOf":"ق-0286","otherNeedIds":[1],"ref":"سورة سبأ: 4","quran":{"s":34,"from":4,"to":4,"text":"لِيَجْزِيَ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ أُولَئِكَ لَهُمْ مَغْفِرَةٌ وَرِزْقٌ كَرِيمٌ (4)","hl":[[11,54,1],[54,98,2]]}},{"id":"ق-1021","fp":"c648021081aa","stateId":63,"easy":"الإيمان والعمل الصالح ← مغفرة وأجر كبير","cause":"الإيمان والعمل الصالح","result":"مغفرة وأجر كبير","explicit":true,"repOf":"ق-0286","otherNeedIds":[45],"ref":"سورة فاطر: 7","quran":{"s":35,"from":7,"to":7,"text":"الَّذِينَ كَفَرُوا لَهُمْ عَذَابٌ شَدِيدٌ وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ مَغْفِرَةٌ وَأَجْرٌ كَبِيرٌ (7)","hl":[[42,87,1],[87,121,2]]}},{"id":"ق-1087","fp":"b4569a1e8716","stateId":63,"easy":"المجيء بالصدق والتصديق به (التقوى والإحسان) ← لهم ما يشاءون وتكفير أسوأ العمل والجزاء بأحسنه","cause":"المجيء بالصدق والتصديق به (التقوى والإحسان)","result":"لهم ما يشاءون وتكفير أسوأ العمل والجزاء بأحسنه","explicit":true,"otherNeedIds":[45,67],"ref":"سورة الزمر: 33–35","srcLabel":"القرآن الكريم","quran":{"s":39,"from":33,"to":35,"text":"وَالَّذِي جَاءَ بِالصِّدْقِ وَصَدَّقَ بِهِ أُولَئِكَ هُمُ الْمُتَّقُونَ (33) لَهُمْ مَا يَشَاءُونَ عِنْدَ رَبِّهِمْ ذَلِكَ جَزَاءُ الْمُحْسِنِينَ (34) لِيُكَفِّرَ اللَّهُ عَنْهُمْ أَسْوَأَ الَّذِي عَمِلُوا وَيَجْزِيَهُمْ أَجْرَهُمْ بِأَحْسَنِ الَّذِي كَانُوا يَعْمَلُونَ (35)","hl":[[0,77,1],[77,270,2]]}},{"id":"ق-1201","fp":"74eb6755d536","stateId":63,"easy":"إجابة داعي الله والإيمان به ← مغفرة الذنوب والإجارة من عذاب أليم","cause":"إجابة داعي الله والإيمان به","result":"مغفرة الذنوب والإجارة من عذاب أليم","explicit":true,"repOf":"ق-0639","otherNeedIds":[66],"ref":"سورة الأحقاف: 31","quran":{"s":46,"from":31,"to":31,"text":"يَا قَوْمَنَا أَجِيبُوا دَاعِيَ اللَّهِ وَآمِنُوا بِهِ يَغْفِرْ لَكُمْ مِنْ ذُنُوبِكُمْ وَيُجِرْكُمْ مِنْ عَذَابٍ أَلِيمٍ (31)","hl":[[0,55,1],[55,121,2]]}},{"id":"ق-1205","fp":"5ee63b82f9cc","stateId":63,"easy":"الإيمان والعمل الصالح والإيمان بما نزل على محمد ﷺ ← تكفير السيئات وإصلاح البال","cause":"الإيمان والعمل الصالح والإيمان بما نزل على محمد ﷺ","result":"تكفير السيئات وإصلاح البال","explicit":true,"otherNeedIds":[19,5],"ref":"سورة محمد: 2","srcLabel":"القرآن الكريم","quran":{"s":47,"from":2,"to":2,"text":"وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَآمَنُوا بِمَا نُزِّلَ عَلَى مُحَمَّدٍ وَهُوَ الْحَقُّ مِنْ رَبِّهِمْ كَفَّرَ عَنْهُمْ سَيِّئَاتِهِمْ وَأَصْلَحَ بَالَهُمْ (2)","hl":[[0,116,1],[116,168,2]]}},{"id":"ق-1242","fp":"1929bae5bc90","stateId":63,"easy":"الإيمان والعمل الصالح مع الشدة على الكفار والرحمة بالمؤمنين والركوع والسجود ابتغاء فضل الله ← مغفرة وأجر عظيم","cause":"الإيمان والعمل الصالح مع الشدة على الكفار والرحمة بالمؤمنين والركوع والسجود ابتغاء فضل الله","result":"مغفرة وأجر عظيم","explicit":true,"apply":{"k":"time","t":"في السجود"},"otherNeedIds":[45],"ref":"سورة الفتح: 29","srcLabel":"القرآن الكريم","quran":{"s":48,"from":29,"to":29,"text":"مُحَمَّدٌ رَسُولُ اللَّهِ وَالَّذِينَ مَعَهُ أَشِدَّاءُ عَلَى الْكُفَّارِ رُحَمَاءُ بَيْنَهُمْ تَرَاهُمْ رُكَّعًا سُجَّدًا يَبْتَغُونَ فَضْلًا مِنَ اللَّهِ وَرِضْوَانًا سِيمَاهُمْ فِي وُجُوهِهِمْ مِنْ أَثَرِ السُّجُودِ ذَلِكَ مَثَلُهُمْ فِي التَّوْرَاةِ وَمَثَلُهُمْ فِي الْإِنْجِيلِ كَزَرْعٍ أَخْرَجَ شَطْأَهُ فَآزَرَهُ فَاسْتَغْلَظَ فَاسْتَوَى عَلَى سُوقِهِ يُعْجِبُ الزُّرَّاعَ لِيَغِيظَ بِهِمُ الْكُفَّارَ وَعَدَ اللَّهُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ مِنْهُمْ مَغْفِرَةً وَأَجْرًا عَظِيمًا (29)","hl":[[0,410,1],[410,424,2],[424,477,1],[477,506,2]]}},{"id":"ق-1304","fp":"599adcebbfcd","stateId":63,"easy":"الإيمان بالله ورسله والمسابقة إلى المغفرة ← مغفرة وجنة عرضها كعرض السماء والأرض","cause":"الإيمان بالله ورسله والمسابقة إلى المغفرة","result":"مغفرة وجنة عرضها كعرض السماء والأرض","explicit":true,"otherNeedIds":[67],"ref":"سورة الحديد: 21","srcLabel":"القرآن الكريم","quran":{"s":57,"from":21,"to":21,"text":"سَابِقُوا إِلَى مَغْفِرَةٍ مِنْ رَبِّكُمْ وَجَنَّةٍ عَرْضُهَا كَعَرْضِ السَّمَاءِ وَالْأَرْضِ أُعِدَّتْ لِلَّذِينَ آمَنُوا بِاللَّهِ وَرُسُلِهِ ذَلِكَ فَضْلُ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ (21)","hl":[[0,16,1],[16,103,2],[103,143,1]]}},{"id":"ق-1342","fp":"63cb9d5cf676","stateId":63,"easy":"الإيمان بالله والعمل الصالح ← تكفير السيئات وجنات والفوز العظيم","cause":"الإيمان بالله والعمل الصالح","result":"تكفير السيئات وجنات والفوز العظيم","explicit":true,"repOf":"ق-0935","otherNeedIds":[67,53],"ref":"سورة التغابن: 9","quran":{"s":64,"from":9,"to":9,"text":"يَوْمَ يَجْمَعُكُمْ لِيَوْمِ الْجَمْعِ ذَلِكَ يَوْمُ التَّغَابُنِ وَمَنْ يُؤْمِنْ بِاللَّهِ وَيَعْمَلْ صَالِحًا يُكَفِّرْ عَنْهُ سَيِّئَاتِهِ وَيُدْخِلْهُ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا أَبَدًا ذَلِكَ الْفَوْزُ الْعَظِيمُ (9)","hl":[[66,112,1],[112,253,2]]}},{"id":"س-03160","fp":"8a3090055a6a","stateId":64,"easy":"إذا لقيت الله بملء الأرض خطايا لا تشرك به شيئاً ← يلقاك بمثلها مغفرة","cause":"ومَن لَقيَني بقُرابِ الأرضِ خَطيئةً لا يُشرِكُ بي شيئًا","result":"لَقيتُه بمِثلِها مَغفِرةً","explicit":true,"star":true,"similar":["س-04038"],"otherNeedIds":[17],"ref":"صحيح مسلم 2687","srcLabel":"متفق عليه","text":["يقولُ اللهُ عَزَّ وجَلَّ: مَن جاءَ بالحَسَنةِ فله عَشرُ أمثالِها وأزيدُ، ومَن جاءَ بالسَّيِّئةِ فجَزاؤُه سَيِّئةٌ مِثلُها أو أغفِرُ، ومَن تَقَرَّبَ مِنِّي شِبرًا تَقَرَّبتُ منه ذِراعًا، ومَن تَقَرَّبَ مِنِّي ذِراعًا تَقَرَّبتُ منه باعًا، ومَن أتاني يَمشي أتَيتُه هَرولةً، ",["ومَن لَقيَني بقُرابِ الأرضِ خَطيئةً لا يُشرِكُ بي شيئًا",1]," ",["لَقيتُه بمِثلِها مَغفِرةً",2],". وفي روايةٍ: فله عَشرُ أمثالِها، أو أزيدُ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"إيمان › توحيد الأسماء والصفات","dorar":"D1po7pkJ","merged":4,"otherRefs":["تخريج المسند لشعيب 21321 (صحيح)","تخريج المسند لشعيب 21311 (صحيح)","تخريج المسند لشعيب 21315 (صحيح)"]},{"id":"س-03378","fp":"52b539c14422","stateId":64,"easy":"إذا لم تشرك بالله شيئاً ← يُغفر لك","cause":"لا يُشرِكُ باللهِ شيئًا","result":"فيُغفَرُ","explicit":true,"star":true,"similar":["س-07531","س-06471"],"ref":"صحيح مسلم 2565","srcLabel":"متفق عليه","text":["تُفتَحُ أبوابُ الجَنَّةِ يَومَ الاثنَينِ، ويَومَ الخَميسِ، ",["فيُغفَرُ",2]," لكُلِّ عَبدٍ ",["لا يُشرِكُ باللهِ شيئًا",1],"، إلَّا رَجُلًا كانَت بينَه وبينَ أخيه شَحناءُ، فيُقالُ: أنظِروا هَذَينِ حتَّى يَصطَلِحا، أنظِروا هَذَينِ حتَّى يَصطَلِحا، أنظِروا هَذَينِ حتَّى يَصطَلِحا. [وفي روايةٍ]: إلَّا المُهتَجِرَينِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"استغفار › أسباب المغفرة","dorar":"hbubemo1","merged":2,"otherRefs":["صحيح الترمذي 2023 (صحيح)"]},{"id":"س-04038","fp":"173405cfa4a7","stateId":64,"easy":"إذا عملت ملء الأرض خطايا ثم لقيت الله لا تشرك به ← يجعل لك مثلها مغفرة","cause":"ومَنْ عمِلَ قُرابَ الأرضِ خطيئةً ، ثمَّ لَقِيَنِي لا يُشرِكُ بي شيئًا","result":"جعلتُ لهُ مِثلَها مَغفرِةً","explicit":true,"repOf":"س-03160","ref":"صحيح الجامع 8141","text":["يقولُ اللهُ تعالَى : مَنْ عمِلَ حسنةً ، فلهُ عشرُ أمثالِها . وأَزيدُ ، ومَنْ عمِلَ سيِّئةً فجزاؤُها مِثلُها ، أوْ أغفِرُ ، ",["ومَنْ عمِلَ قُرابَ الأرضِ خطيئةً ، ثمَّ لَقِيَنِي لا يُشرِكُ بي شيئًا",1]," ",["جعلتُ لهُ مِثلَها مَغفرِةً",2]," ، ومَنِ اقترَبَ إلىَّ شِبرًا ، اقْتربتُ إليه ذِراعًا ، ومَنِ اقترَبَ إليَّ ذِراعًا ، اقتربتُ إليه باعًا ، ومَنْ أتانِي يمشِي ، أتيتُهُ هرْولَةً"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2687)، وابن ماجه (3821)، وأحمد (21488) واللفظ له","bab":"توبة › سعة رحمة الله تعالى وأنها سبقت غضبه","dorar":"EG5gkzcM","merged":2,"otherRefs":["تخريج المسند لشعيب 21377 (حسن)"]},{"id":"س-01227","fp":"12b7587d99a9","stateId":64,"easy":"إذا قلت «لا إله إلا الله» ← يُغفر لك","cause":"بقولِ : لا إلَهَ إلا اللَّهُ","result":"قد غُفِرَ لَهُ","explicit":true,"star":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"similar":["س-01214","س-02474","س-01233"],"ref":"المهذب في اختصار السنن 8/4009","srcLabel":"مسلم","text":["أنَّ رسولَ اللَّهِ قالَ لرجلٍ : فعلتَ كذا وَكَذا ؟ قالَ : لا واللَّهِ الَّذي لا إلَهَ إلا هوَ فأتاهُ جبريلُ فقالَ : بلى قد فعلَهُ ولَكِن ",["قد غُفِرَ لَهُ",2]," ",["بقولِ : لا إلَهَ إلا اللَّهُ",1]," ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده على شرط مسلم","takhrij":"أخرجه أحمد (5986)، وأبو يعلى (5690)، والبيهقي (20373) باختلاف يسير","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"Jor2Kspo"},{"id":"س-03169","fp":"2d225d6320f3","stateId":64,"easy":"إذا حلفت كاذباً ثم شهدت بالتوحيد صادقاً ← يغفر الله لك (من واقعة)","cause":"باللهِ الَّذي لا إلهَ إلَّا هو","result":"فغُفِرَ له","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأحاديث المختارة 9 / 320","srcLabel":"متفق عليه","text":["«أنَّ رَجُلًا حَلَفَ ",["باللهِ الَّذي لا إلهَ إلَّا هو",1]," كاذِبًا، ",["فغُفِرَ له",2],"»."],"grade":"صحيح","narrator":"‌‌عبدالله بن الزبير بن العوام","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إيمان › توحيد الأسماء والصفات","dorar":"DZ2SYsDX"},{"id":"س-03460","fp":"5a6c5420f3e6","stateId":64,"easy":"إذا لقيت الله لا تشرك به شيئاً ← يأتيك بملء الأرض مغفرة","cause":"لا تُشْرِكُ بي شيئًا","result":"لَأَتَيْتُكَ بقُرَابِها مَغْفِرَةً","explicit":true,"otherNeedIds":[17],"ref":"هداية الرواة 2276","srcLabel":"الترمذي","text":["قال اللهُ – تعالى – يا ابنَ آدمَ ! إنك ما دَعَوْتَنِي ورَجَوْتَنِي ؛ غفرتُ لك ما كان فيك ولا أُبَالِي، يا ابنَ آدمَ ! لو بَلَغَتْ ذنوبُكَ عَنَانَ السماءِ، ثم استَغْفَرْتَنِي ؛ غفرتُ لك ولا أُبَالِي، يا ابنَ آدمَ ! إنك لو أَتَيْتَنِي بقُرَابِ الأرضِ خَطَايَا، ثم لَقِيتَنِي ",["لا تُشْرِكُ بي شيئًا",1]," ؛ ",["لَأَتَيْتُكَ بقُرَابِها مَغْفِرَةً",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"حسن بل صحيح","takhrij":"أخرجه الترمذي (3540) واللفظ له، وأحمد (13493) مختصراً بمعناه.","bab":"استغفار › فضل الاستغفار","dorar":"b0r8OsTX","merged":3,"otherRefs":["تخريج صحيح ابن حبان 226 (صحيح)","تخريج المسند لشعيب 21472 (حسن)"]},{"id":"س-05986","fp":"6ad00c3b92b3","stateId":64,"easy":"إذا اتقيت الشرك بالله ← فالله أهل أن يغفر لك","cause":"فمن اتَّقَى أنْ يَجْعَلَ معي إلهًا","result":"فأنا أهلٌ أنْ أغفرَ لهُ","explicit":true,"similar":["س-02893"],"ref":"الجامع الصغير 6051","srcLabel":"الترمذي","text":["قالَ ربُّكم : أنا أهلٌ أنْ أُتَّقَى فَلا يُجْعَلُ معي إلهٌ، ",["فمن اتَّقَى أنْ يَجْعَلَ معي إلهًا",1]," ",["فأنا أهلٌ أنْ أغفرَ لهُ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه أحمد (12442) بلفظه، والترمذي (3328)، وابن ماجه (4299) بنحوه.","bab":"رقائق وزهد › تقوى الله","dorar":"8xwZ6toj","merged":3,"otherRefs":["هداية الرواة 2/453 (حسن)","سير أعلام النبلاء 5/223 (حسن)"]},{"id":"س-02409","fp":"b4a1c8668a49","stateId":64,"easy":"إذا مِتّ وأنت تشهد أن لا إله إلا الله وأن محمداً رسول الله صادقاً من قلبك ← يغفر الله لك","cause":"ما مِن نَفْسٍ تَموتُ وهي تَشهَدُ أنْ لا إلهَ إلَّا اللهُ، وأنِّي رسولُ اللهِ، يَرجِعُ ذاك إلى قَلبٍ مُوقنٍ","result":"إلَّا غَفَرَ اللهُ لها","explicit":true,"ref":"تخريج المسند لشعيب 21998","srcLabel":"النسائي","text":["دَخَلتُ المسجدَ الجامعَ بالبَصرةِ، فجَلَستُ إلى شَيخٍ أبيَضِ الرَّأسِ واللِّحْيةِ، فقال: حَدَّثَني مُعاذُ بنُ جَبلٍ، عن رسولِ اللهِ صَلَّى اللهُ عليه وسلَّمَ أنَّه قال: ",["ما مِن نَفْسٍ تَموتُ وهي تَشهَدُ أنْ لا إلهَ إلَّا اللهُ، وأنِّي رسولُ اللهِ، يَرجِعُ ذاك إلى قَلبٍ مُوقنٍ، ",1],["إلَّا غَفَرَ اللهُ لها",2],"، قُلتُ له: أنت سَمِعتَه مِن مُعاذٍ؟ فكأنَّ القَومَ عَنَّفوني، قال: لا تُعنِّفوه، ولا تُؤَنِّبوه، دَعوه، نعمْ أنا سَمِعتُ ذاك مِن مُعاذٍ، يَذبُرُه عن رسولِ اللهِ صَلَّى اللهُ عليه وسلَّمَ، وقال إسماعيلُ مَرَّةً: يَأثُرُه عن رسولِ اللهِ صَلَّى اللهُ عليه وسلَّمَ، قال: قُلتُ لبعضِهم: مَن هذا؟ قال: هذا عبدُ الرَّحمنِ بنُ سَمُرةَ."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10975)، وابن ماجه (3796)، وأحمد (21998) واللفظ له","bab":"إسلام › فضل الشهادتين","dorar":"9Ip2s76Z","merged":2,"otherRefs":["المستدرك على الصحيحين 16 (صحيح)"]},{"id":"س-07531","fp":"35c13fde41c4","stateId":64,"easy":"إذا لم تشرك بالله ← يُغفر لك المقحمات","cause":"ما لم يشرِكوا باللَّهِ شيئًا","result":"وغُفِرَ لأمَّتِهِ المقحِماتُ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"repOf":"س-03378","otherNeedIds":[22],"ref":"صحيح الترمذي 3276","text":["لمَّا بلغَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ سدرةَ المنتهى قالَ انتهى إليها ما يعرجُ منَ الأرضِ وما ينزلُ من فوقٍ فأعطاهُ اللَّهُ عندَها ثلاثًا لم يعطِهنَّ نبيًّا كانَ قبلَهُ فُرِضت عليهِ الصَّلاةُ خمسًا وأعطيَ خواتيمَ سورةِ البقرةِ ",["وغُفِرَ لأمَّتِهِ المقحِماتُ",2]," ",["ما لم يشرِكوا باللَّهِ شيئًا",1]," قالَ ابنُ مسعودٍ { إِذْ يَغْشَى السِّدْرَةَ مَا يَغْشَى} قالَ السِّدرةُ في السَّماءِ السَّادسة قالَ سفيانُ فراشٌ من ذهبٍ وأشارَ سفيانُ بيدِهِ فأرعدَها وقالَ غيرُ مالكِ بنِ مغولٍ إليها ينتهي علمُ الخلقِ لا عِلمَ لهم بما فوقَ ذلك"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3276) واللفظ له، وأخرجه مسلم (173) بلفظ مقارب","bab":"فضائل النبي وصفته ودلائل النبوة › الإسراء والمعراج","dorar":"3M6Tuty7"},{"id":"س-00888","fp":"9b86b7aa10b6","stateId":64,"easy":"إذا صدّقت بلا إله إلا الله ← تُكفَّر ذنوبك","cause":"بتصديقِك بلا إلهَ إلَّا اللهُ","result":"كُفِّرَ عنك","explicit":true,"ref":"مجمع الزوائد 10/86","srcLabel":"عبد بن حميد","text":["يا فلانُ فعَلْتَ كذا وكذا قال لا والَّذي لا إلهَ إلَّا هو ما فعَلْتُ ورسولُ اللهِ صلَّى اللهُ عليه وسلَّم يعلَمُ أنَّه قد فعَله فكرَّر عليه مِرارًا فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["كُفِّرَ عنك",2]," ",["بتصديقِك بلا إلهَ إلَّا اللهُ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه عبد بن حميد في ((المسند)) (1374)، والبزار (6903)، وأبو يعلى (3368) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"paWB0S7a"},{"id":"س-01084","fp":"4fe0d9b4df63","stateId":64,"easy":"إذا قلت «لا إله إلا الله» ← لا تترك ذنباً","cause":"وقولُ لا إلَهَ إلَّا اللهُ","result":"لا يَترُكُ ذنبًا، ولا يُشبِهُها عَملٌ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"ref":"المستدرك على الصحيحين 1917","srcLabel":"الحاكم","text":["يا نَبيَّ اللهِ، إنِّي امرأةٌ قد كَبِرتُ وضَعُفتُ، فدُلَّني على عَمَلٍ، قالَ: كَبِّري اللهَ مائةَ مرَّةٍ، واحمَدِي اللهَ مائةَ مرَّةٍ، وسبِّحي اللهَ مائةَ مرَّةٍ؛ فهو خيرٌ لكِ مِن مائةِ بَدَنةٍ مُتقبَّلةٍ، وخيرٌ مِن مائةِ فرَسٍ مُسْرَجٍ مُلْجَمٍ في سبيلِ اللهِ، وخيرٌ مِن مائةِ رَقَبةٍ مُتقبَّلةٍ، ",["وقولُ لا إلَهَ إلَّا اللهُ",1]," ",["لا يَترُكُ ذنبًا، ولا يُشبِهُها عَملٌ",2],"."],"grade":"صحيح","narrator":"أم هانئ بنت أبي طالب","muhaddith":"صحيح الإسناد","bab":"أدعية وأذكار › فضل الذكر","dorar":"HoHh5PmN"},{"id":"س-01214","fp":"68e551b7e820","stateId":64,"easy":"إذا قلت «لا إله إلا الله» مخلصاً ← يُغفر لك","cause":"بإخلاصِ قولِ لا إلهَ إلا اللهُ","result":"قد غُفر لك","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-01227","ref":"صحيح أبي داود 3275","text":["أنَّ رجلين اختصما إلى النبيِّ صلَّى اللهُ عليهِ وسلَّمَ فسأل النبيُّ صلَّى اللهُ عليهِ وسلَّمَ الطالبَ البينةَ فلم تكن له بينةٌ فاستحلف المطلوبَ فحلف باللهِ الذي لا إلهَ إلا هو فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ بلى قد فعلتَ ولكن ",["قد غُفر لك",2]," ",["بإخلاصِ قولِ لا إلهَ إلا اللهُ",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3275) واللفظ له، وأحمد (2695) باختلاف يسير","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"dRJT5AGr"},{"id":"س-01231","fp":"40eb2c882dc8","stateId":64,"easy":"إذا أخلصت ← يغفر الله لك","cause":"بإخلاصِكَ","result":"إن اللهَ قد غفر لك","explicit":true,"ref":"البحر الزخار 6/135","srcLabel":"النسائي","text":["أنَّ رجلينِ تَدَاعَيَا عند رسولِ اللهِ صلَّى اللهُ عليه وسلَّم ، فحلف المُدَّعِى عليه باللهِ الذي لا إله إلا هو ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ",["إن اللهَ قد غفر لك",2]," ",["بإخلاصِكَ",1]],"grade":"صحيح","narrator":"عبدالله بن الزبير","muhaddith":"صحيح","takhrij":"أخرجه البيهقي (19905) بنحوه، وأحمد (16101 ) والنسائي في ((الكبرى)) (5962 ) بمعناه","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"xGPciUgW"},{"id":"س-01831","fp":"b6eef7f45cbc","stateId":64,"easy":"إذا مِتّ لا تشرك بالله شيئاً ← لا تضرك معه خطيئة (برحمة الله)","cause":"مَن ماتَ لا يُشرِكُ باللهِ شَيئًا","result":"لم يَضُرَّه معَها خَطيئةٌ","explicit":true,"similar":["س-03776"],"otherNeedIds":[66],"ref":"الأحكام الوسطى 1/ 78","srcLabel":"الأحكام الوسطى","text":["\"",["مَن ماتَ لا يُشرِكُ باللهِ شَيئًا",1],"...\"، ثُمَّ ذَكَرَ مِثلَه [",["لم يَضُرَّه معَها خَطيئةٌ",2],"، كما لو أَشرَكَ باللهِ لم تَنفَعْه معَها حَسَنة]."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","bab":"إحسان › إبطال الأعمال","dorar":"TPZs6ZRn"},{"id":"س-02474","fp":"ded374668a4e","stateId":64,"easy":"إذا صدّقت بلا إله إلا الله ← يُغفر لك كذبك","cause":"بتَصديقِه أنْ لا إلهَ إلَّا اللهُ","result":"غُفِرَ له كَذِبُه","explicit":true,"repOf":"س-01227","ref":"علل ابن أبي حاتم 1323","text":["حَديثٌ رواه أبو قُدامةَ الحارِثُ بنُ عُبَيدٍ، عن ثابِتٍ، عن أنَسٍ: أنَّ رَجُلًا حَلَف بـ «لا إلهَ إلَّا اللهُ» كاذِبًا، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["غُفِرَ له كَذِبُه",2]," ",["بتَصديقِه أنْ لا إلهَ إلَّا اللهُ",1],"؟"],"grade":"صحيح","narrator":"أنس","muhaddith":"حَمَّادُ بنُ سَلَمةَ يخالِفُه؛ يَقولُ: عن ثابتٍ، عن ابْنِ عُمَرَ، عن النَّبيِّ صلَّى اللهُ عليه وسلَّم؛ وهو أشبَهُ مِن حَديثِ أبي قُدامةَ.","bab":"إسلام › فضل الشهادتين","dorar":"atDHhXZM"},{"id":"س-02893","fp":"656394396ef6","stateId":64,"easy":"إذا اتقيت الشرك بالله ← فأنت أهل أن يغفر الله لك","cause":"لمَنِ اتَّقى أنْ يَجعلَ معي إلهًا آخرَ","result":"أنْ أغفِرَ له","explicit":true,"repOf":"س-05986","ref":"المستدرك على الصحيحين 3923","text":["سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قَرَأَ: {وَمَا يَذْكُرُونَ إِلَّا أَنْ يَشَاءَ اللَّهُ هُوَ أَهْلُ التَّقْوَى وَأَهْلُ الْمَغْفِرَةِ} [المدثر: 56] قالَ: «يقولُ ربُّكُم عزَّ وجلَّ: أنا أهلٌ أنْ أُتَّقى أنْ يُجعَلَ معي إلهٌ آخرُ، وأنا أهلٌ ",["لمَنِ اتَّقى أنْ يَجعلَ معي إلهًا آخرَ",1]," ",["أنْ أغفِرَ له",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (3328)، وابن ماجه (4299)، وأحمد (13349) بنحوه","bab":"إيمان › الوعد","dorar":"aYBP9b0V"},{"id":"س-03776","fp":"3b22537eb9d9","stateId":64,"easy":"إذا لقيت الله لا تشرك به شيئاً ← لا تضرّك معه خطيئة","cause":"من لقى اللَّهَ لا يشرِكُ بِهِ شيئًا","result":"لم تضُرَّهُ معَهُ خطيئةٌ","explicit":true,"repOf":"س-01831","ref":"تخريج المسند لشاكر 10/92","text":["من لقيَ اللَّهَ وَهوَ لا يشرِكُ بِهِ شيئًا دخلَ الجنَّةَ ، ولم تَضرَّ معَهُ خطيئةٌ ، كما لو لقيَهُ وَهوَ مشرِكٌ بِهِ دخلَ النَّارَ ، ولم تنفَعهُ معَهُ حسنةٌ قالَ أبو نُعَيْمٍ في حديثِهِ : جاءَ رجلٌ أو شيخٌ من أَهْلِ المدينةِ ، فنزلَ على مَسروقٍ فقالَ : سَمِعْتُ عبدَ اللَّهِ بنَ عمرٍو يقولُ : قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : ",["من لقى اللَّهَ لا يشرِكُ بِهِ شيئًا ",1],["لم تضُرَّهُ معَهُ خطيئةٌ ، ",2],"ومن ماتَ وَهوَ يشرِكُ بِهِ لم ينفعهُ معَهُ حسنةٌ قالَ عبدُ اللَّهِ بنُ أحمدَ بنِ حنبلٍ : والصَّوابُ ما قالَهُ أبو نُعَيْمٍ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6586) واللفظ له، والطبري في ((مسند ابن عباس)) (941)، والطبراني كما في ((مجمع الزوائد)) للهيثمي (1/24) مختصراً","bab":"الكفر والشرك › ذم الشرك وما ورد فيه من العقوبة","dorar":"EcBBHSSW"},{"id":"س-06618","fp":"40b5ce845538","stateId":64,"easy":"إذا لقيت الله لا تشرك به وتصلي الخمس وتصوم رمضان ← يُغفر لك","cause":"مَن لَقي اللهَ لا يُشرِكُ به شيئًا ، يُصلِّي الصلواتِ الخمسَ ، ويصومُ رمضانَ","result":"غُفِر له","explicit":true,"apply":{"k":"time","t":"في رمضان"},"ref":"السلسلة الصحيحة 1315","srcLabel":"أحمد","text":[["مَن لَقي اللهَ لا يُشرِكُ به شيئًا ، يُصلِّي الصلواتِ الخمسَ ، ويصومُ رمضانَ ",1],["غُفِر له",2]," قلتُ : أفلا أُبَشِّرُهم يا رسولَ اللهِ ؟ قال : دَعْهم يَعمَلوا"],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"إسناده صحيح، رجاله ثقات رجال الشيخين","takhrij":"أخرجه أحمد (22028) بلفظه، ومعمر في ((الجامع)) (20546)، والطبراني في ((لمعجم الكبير)) (20/ 126) (254) بنحوه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"BuBgI5gD"},{"id":"س-07524","fp":"ef38a9176e93","stateId":64,"easy":"إذا حلفت كاذباً ثم شهدت أن لا إله إلا الله ← تكون كفارة ليمينك (من واقعة)","cause":"شَهادتُكَ بأنْ لا إلَهَ إلَّا اللهُ","result":"كفَّارةٌ لِيَمينِكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 7230","srcLabel":"النسائي","text":["أنَّ رجُلًا ادَّعى عندَ رَجُلٍ حَقًّا، فاختَصَما إلى نَبِيِّ الله صلَّى اللهُ عليه وسلَّمَ، فسألَهُ البَيِّنةَ، فقال: ما عِندي بَيِّنةٌ، فقال للآخَرِ: احلِفْ، فحَلَفَ، فقال: واللهِ ما له عِندي شَيءٌ، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: بلْ هو عندكَ، ادْفَعْ إليهِ حَقَّه، ثمَّ قال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["شَهادتُكَ بأنْ لا إلَهَ إلَّا اللهُ",1]," ",["كفَّارةٌ لِيَمينِكَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (2695)، والنسائي في ((السنن الكبرى)) (5963)، والطحاوي في ((شرح مشكل الآثار)) (441) بنحوه","bab":"فضائل النبي وصفته ودلائل النبوة › اختصام المؤمنين إليه صلى الله عليه وسلم وحكمه عليهم","dorar":"aUXzGabS","merged":2,"otherRefs":["الأحكام الوسطى 3/ 363 (صحيح)"]},{"id":"س-01233","fp":"42760a486a01","stateId":64,"easy":"إذا صدّقت بلا إله إلا الله ← يغفر الله لك كذبك (من واقعة)","cause":"بتصديقِك ب لا إلهَ إلا اللهُ","result":"إنَّ اللهَ قد غفر لك كذبَك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-01227","ref":"السلسلة الصحيحة 3064","text":[["إنَّ اللهَ قد غفر لك كذبَك",2]," ",["بتصديقِك ب \" لا إلهَ إلا اللهُ",1]," \""],"grade":"صحيح","narrator":"أنس بن مالك وعبدالله بن عمر وابن عباس والحسن البصري","muhaddith":"صحيح","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (1/212) باختلاف يسير","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"CxM2prwR"},{"id":"س-02829","fp":"e44dc2f1c573","stateId":64,"easy":"إذا عظّمت الله وأجللته ← يغفر لك","cause":"أَجِلُّوا اللهَ","result":"يَغْفِرْ لكم","explicit":true,"ref":"الجامع الصغير 189","srcLabel":"أحمد","text":[["أَجِلُّوا اللهَ ",1],["يَغْفِرْ لكم",2]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"حسن","takhrij":"أخرجه أحمد (21734)، والطبراني في ((الشاميين)) (221)، وأبو نعيم في ((الحلية)) (1/ 226) واللفظ لهم.","bab":"إيمان › الوعد","dorar":"eUf0MwDM"},{"id":"س-03430","fp":"3e0fdfbc0f3b","stateId":64,"easy":"إذا مِتّ لا تشرك بالله ولم تكن ساحراً ولم تحقد على أخيك ← يغفر الله لك ما سوى ذلك","cause":"مَن ماتَ لا يُشرِكُ باللهِ شَيئًا، ولم يَكُنْ ساحِرًا يَتَّبِعُ السَّحَرةَ، ولم يَحقِدْ على أخيه","result":"ثَلاثٌ مَن كُنَّ فيه فإنَّ اللَّهَ تعالى يَغفِرُ له ما سِوى ذلك","explicit":true,"ref":"فيض القدير 3/ 289","srcLabel":"فيض القدير","text":[["ثَلاثٌ مَن كُنَّ فيه فإنَّ اللَّهَ تعالى يَغفِرُ له ما سِوى ذلك",2],": ",["مَن ماتَ لا يُشرِكُ باللهِ شَيئًا، ولم يَكُنْ ساحِرًا يَتَّبِعُ السَّحَرةَ، ولم يَحقِدْ على أخيه",1]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","bab":"استغفار › أسباب المغفرة","dorar":"AWShXDa9"},{"id":"س-06471","fp":"27fd5fddc2db","stateId":64,"easy":"إذا لم تشرك بالله ← يغفر لك المقحمات (الكبائر)","cause":"لمَن لا يُشرِكُ باللهِ عزَّ وجلَّ مِن أُمَّتِه","result":"وغُفِرَ لمَن لا يُشرِكُ باللهِ عزَّ وجلَّ مِن أُمَّتِه المُقحَماتُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03378","ref":"تخريج المسند لشعيب 4011","text":["لمَّا أُسرِيَ برسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ انتُهيَ به إلى سِدرةِ المُنتَهى، وهي في السَّماءِ السَّادسةِ، وإليها يَنتهي ما يُصعَدُ به مِن الأرضِ -وقال مرَّةً: وما يُعرَجُ به مِن الأرضِ- فيُقبَضُ منها، وإليها يَنتهي ما يُهبَطُ به مِن فوقِها، فيُقبَضُ منها، {إِذْ يَغْشَى السِّدْرَةَ مَا يَغْشَى} [النجم: 16]، قال: فَراشٌ مِن ذَهبٍ، قال: فأُعطِيَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ثلاثَ خِلالٍ: الصَّلَواتُ الخَمسُ، وخَواتيمُ سورةِ البَقرةِ، ",["وغُفِرَ لمَن لا يُشرِكُ باللهِ عزَّ وجلَّ مِن أُمَّتِه المُقحَماتُ",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (173)، والترمذي (3276)، والنسائي (451)، وأحمد (4011) واللفظ له","bab":"صلاة › فرض الصلاة","dorar":"I5NlJvXF"},{"id":"س-02436","fp":"14b1e648a99d","stateId":64,"easy":"إذا قلت لا إله إلا الله صادقاً ← أبشر فقد غفر الله لك (من واقعة)","cause":"ارفعوا أيدِيَكم وقولَا لَا إلهَ إلا اللهُ","result":"أبشروا فإنَّ الله قد غفر لكم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[67],"ref":"جامع المسانيد والسنن 5121","srcLabel":"أحمد","text":["كنَّا عند النبيِّ صلَّى اللهُ عليهِ وسلَّمَ، فقال: هلْ فِيكُم غَرِيبٌ؟ يعنى أهلَ الكتابِ، فقلنا: لا يا رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ، فأمر بغلقِ البابِ، وقال: ",["ارفعوا أيدِيَكم وقولَا لَا إلهَ إلا اللهُ",1],"، فرفعنا أيديَنا ساعةً، ثم وضع رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يدَه، ثم قال: الحمدُ للهِ، اللَّهم بعثتني بهذه الكلمةِ، وأمرتَني بها، ووعدتني عليها الجنَّةَ، وإنَّك لا تخلفُ الميعادَ، ثم قال: ",["أبشروا فإنَّ الله قد غفر لكم",2],"."],"grade":"حسن","narrator":"شداد بن أوس","muhaddith":"لا بأس بإسناده","takhrij":"أخرجه أحمد (17121)، والبزار (2717)، والدولابي في ((الكنى والأسماء)) (500)\n جميعا بلفظه .","bab":"إسلام › فضل الشهادتين","dorar":"jXwi6SF1"},{"id":"س-03935","fp":"4d0f8422681f","stateId":64,"easy":"إذا لم تشرك بالله ← فأنت في مشيئة الله إن شاء غفر لك","cause":"أن اللهَ لا يغفرُ أن يُشْرَكَ به ويغفرُ ما دون ذلك لمن يشاءُ","result":"فنهانا رسولُ اللهِ أن نوجبَ لأحدٍ من أهلِ الدِّينِ النارَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج كتاب السنة 973","srcLabel":"الطبراني","text":["قال كنا نوجِبُ لأهلِ الكبائرِ النارَ حتى نزلت هذه الآيةُ على النبيِّ ",["أن اللهَ لا يغفرُ أن يُشْرَكَ به ويغفرُ ما دون ذلك لمن يشاءُ",1]," ",["فنهانا رسولُ اللهِ أن نوجبَ لأحدٍ من أهلِ الدِّينِ النارَ",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"إسناده جيد","takhrij":"أخرجه البزار (5840)، وأبو يعلى (5813)، والطبراني في ((المعجم الأوسط)) (5942) باختلاف يسير","bab":"تفسير آيات › سورة النساء","dorar":"fwyGoWDq"},{"id":"س-01225","fp":"89ed8948eade","stateId":64,"easy":"إذا حلفت كاذباً ثم صدقت في الشهادة لله ← تُكفّر يمينك (من واقعة)","cause":"معرفتُه أنْ لا إلهَ إلا اللهُ أو شهادتُه","result":"وكفارةُ يمينِه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشاكر 4/244","srcLabel":"أبو داود","text":["اختصم إلى النبيِّ صلى اللهُ عليه وسلمُ رجلانِ فوقعت اليمينُ على أحدِهما فحلفَ باللهِ الذي لا إلهَ إلا هو مالَه عندَه شيءٌ قال : فنزل جبريلُ على النبيِّ صلَّى اللهُ عليهِ وسلَّمَ فقال : إنه كاذبٌ إنَّ لَه عندَه حقَّه فأمرَه أنْ يُعْطِيَه حقُّه ",["وكفارةُ يمينِه",2]," ",["معرفتُه أنْ لا إلهَ إلا اللهُ أو شهادتُه",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3275)، والنسائي في ((السنن الكبرى)) (6006) بنحوه","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"c9mqD3KT","merged":2,"otherRefs":["تخريج المسند لشاكر 4/345 (صحيح)"]},{"id":"س-03287","fp":"70388fd01d31","stateId":65,"easy":"إذا لم تشرك بالله ← يُغفر لك يومي الخميس والاثنين إلا المتشاحنين","cause":"لا يُشرِكُ باللهِ شيئًا","result":"فيَغفِرُ اللهُ عزَّ وجلَّ في ذلك اليَومِ لكُلِّ امرِئٍ لا يُشرِكُ باللهِ شيئًا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-02283"],"ref":"صحيح مسلم 2565","srcLabel":"متفق عليه","text":["تُعرَضُ الأعمالُ في كُلِّ يَومِ خَميسٍ واثنَينِ، ",["فيَغفِرُ اللهُ عزَّ وجلَّ في ذلك اليَومِ لكُلِّ امرِئٍ لا يُشرِكُ باللهِ شيئًا",2],"، إلَّا امرَأً كانَت بينَه وبينَ أخيه شَحناءُ، فيُقالُ: اركوا هَذَينِ حتَّى يَصطَلِحا، اركوا هَذَينِ حتَّى يَصطَلِحا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"استغفار › أسباب المغفرة","dorar":"0Kc6k1Dr","merged":2,"otherRefs":["مجمع الزوائد 8/69 (حسن)"]},{"id":"س-07166","fp":"9490f54eb7ba","stateId":65,"easy":"إذا كنت مسلماً لا شحناء بينك وبين أحد ← يغفر الله لك يومي الاثنين والخميس","cause":"لكلِّ مسلِمٍ","result":"يَغفرُ اللهُ فيهما","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-03267"],"ref":"هداية الرواة 2015","srcLabel":"مسلم","text":["أنَّ النَّبيَّ - صلَّى اللهُ عليهِ وسلَّمَ - كان يَصومُ يومَ الاثنينِ والخميسِ، فقيلَ: يا رسولَ اللهِ ! إنَّك تصومُ يومَ الاثنينِ والخميسِ ؟ ! فقالَ: إنَّ يومَ الاثنينِ والخميسِ ",["يَغفرُ اللهُ فيهما",2]," ",["لكلِّ مسلِمٍ",1]," ؛ إلَّا المتهاجرَينِ يقولُ: دَعهُما حتَّى يَصطلِحا"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه مسلم (2565)، وأبو داود (4916)، ومالك (3370) جميعهم بلفظ مقارب.","bab":"علم › حسن السؤال ونصح العالم","dorar":"aam6qJP5"},{"id":"س-02283","fp":"c4fb858165a1","stateId":65,"easy":"إذا لم تشرك بالله ولم تُشاحن أخاك ← يُغفر لك يوم الاثنين والخميس","cause":"لا يُشرِكُ باللهِ شيئًا","result":"ويُغفَرُ لكلِّ إنسانٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03287","ref":"تخريج شرح السنة 3524","text":["تُفتَحُ أبوابُ الجنَّةِ كُلَّ اثنَينِ وخَميسٍ، ",["ويُغفَرُ لكلِّ إنسانٍ",2]," ",["لا يُشرِكُ باللهِ شيئًا",1],"، إلَّا رجُلٌ بينَه وبينَ أخيهِ شَحناءُ، فيقولُ: اترُكوا هذَيْنِ حتى يَصطَلِحا."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه مسلم (2565) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"3iH2F528"},{"id":"س-03267","fp":"369b5a010a8a","stateId":65,"easy":"إذا كنت مؤمناً لا شحناء بينك وبين أخيك ← يُغفر لك يومي الاثنين والخميس","cause":"لكل عبدٍ مؤمن","result":"فيُغفرُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-07166","ref":"التمهيد 13/198","text":["عن أبي هريرةَ أنه قال : تُعرضُ أعمالُ الناسِ في كل جمعةٍ مرّتين : يومَ الاثنينِ ويومَ الخميسِ ",["فيُغفرُ",2]," ",["لكل عبدٍ مؤمن",1]," إلا عبدا كانت بينَهُ وبينَ أخيهِ شحناءُ فيقال : اتركوا هذينِ حتى يفيئَا أو اتركُوا هذينِ يفيئا"],"grade":"صحيح","narrator":"أبو صالح السمان.","muhaddith":"مرفوع من وجوه صحاح","takhrij":"أخرجه مالك (3370) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"xoSQxGzk"},{"id":"س-00854","fp":"c2b5bcde22f8","stateId":66,"easy":"إذا قلت «سبحان الله وبحمده» مئة مرة في يوم ← تُحط خطاياك ولو كانت مثل زبد البحر","cause":"ومَن قال: سُبحانَ اللهِ وبحَمدِه في يَومٍ مِائةَ مَرَّةٍ","result":"حُطَّت خَطاياه ولو كانَت مِثلَ زَبَدِ البَحرِ","explicit":true,"star":true,"apply":{"k":"say","t":"«سبحان الله وبحمده» · العدد: مئة مرة"},"ref":"صحيح مسلم 2691","srcLabel":"متفق عليه","text":["مَن قال: لا إلَهَ إلَّا اللهُ وحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كُلِّ شيءٍ قديرٌ، في يَومٍ مِائةَ مَرَّةٍ؛ كانَت له عَدلَ عَشرِ رِقابٍ، وكُتِبَت له مِائةُ حَسَنةٍ، ومُحيَت عنه مِائةُ سَيِّئةٍ، وكانَت له حِرزًا مِنَ الشَّيطانِ يَومَه ذلك حتَّى يُمسيَ، ولم يَأتِ أحَدٌ أفضَلَ ممَّا جاءَ به، إلَّا أحَدٌ عَمِلَ أكثَرَ مِن ذلك، ",["ومَن قال: سُبحانَ اللهِ وبحَمدِه في يَومٍ مِائةَ مَرَّةٍ، ",1],["حُطَّت خَطاياه ولو كانَت مِثلَ زَبَدِ البَحرِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3293)، ومسلم (2691) واللفظ له","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"nO8HQkLK","merged":4,"otherRefs":["صحيح الجامع 6431 (صحيح)","صحيح الترمذي 3466 (صحيح)","المستدرك على الصحيحين 1930 (صحيح)"]},{"id":"س-00942","fp":"4e787e8e9542","stateId":66,"easy":"إذا قلت «سبحان الله وبحمده» مئة صباحاً ومئة مساءً ← تُغفر ذنوبك ولو كانت أكثر من زبد البحر","cause":"مَن قال حينَ يُصبِحُ : سُبحانَ اللهِ وبحَمْدِه مِئةَ مرَّةٍ وإذا أمسى مِئةَ مرَّةٍ","result":"غُفِرَتْ ذُنوبُه وإنْ كانت أكثَرَ مِن زَبَدِ البحرِ","explicit":true,"star":true,"apply":{"k":"say","t":"«سبحان الله وبحمده» · الوقت: في الصباح، في المساء"},"ref":"صحيح ابن حبان 859","srcLabel":"البخاري","text":[["مَن قال حينَ يُصبِحُ : سُبحانَ اللهِ وبحَمْدِه مِئةَ مرَّةٍ وإذا أمسى مِئةَ مرَّةٍ ",1],["غُفِرَتْ ذُنوبُه وإنْ كانت أكثَرَ مِن زَبَدِ البحرِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (6405)، وأحمد (8009)، ومالك (713/ 230)، والطبراني في ((الدعاء)) (1683) واللفظ لهم.","bab":"أدعية وأذكار › فضل الذكر","dorar":"Ql00iOa0","merged":2,"otherRefs":["صحيح الترغيب 653 (صحيح)"]},{"id":"س-00850","fp":"f2a79f5fdad2","stateId":66,"easy":"إذا سبّحت وحمدت وكبّرت ثلاثاً وثلاثين دبر كل صلاة ← تُغفر خطاياك ولو كانت مثل زبد البحر","cause":"مَن سَبَّحَ اللهَ في دُبُرِ كُلِّ صَلاةٍ ثَلاثًا وثَلاثينَ، وحَمِدَ اللهَ ثَلاثًا وثَلاثينَ، وكَبَّرَ اللهَ ثَلاثًا وثَلاثينَ، فتلك تِسعةٌ وتِسعونَ، وقال تَمامَ المِئةِ: لا إلَهَ إلَّا اللهُ وحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ وهو على كُلِّ شيءٍ قديرٌ","result":"غُفِرَت خَطاياه وإن كانَت مِثلَ زَبَدِ البَحرِ","explicit":true,"star":true,"apply":{"k":"count","t":"ثلاثاً وثلاثين · الوقت: دبر كل صلاة"},"ref":"صحيح مسلم 597","srcLabel":"متفق عليه","text":["عَن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم: ",["مَن سَبَّحَ اللهَ في دُبُرِ كُلِّ صَلاةٍ ثَلاثًا وثَلاثينَ، وحَمِدَ اللهَ ثَلاثًا وثَلاثينَ، وكَبَّرَ اللهَ ثَلاثًا وثَلاثينَ، فتلك تِسعةٌ وتِسعونَ، وقال تَمامَ المِئةِ: لا إلَهَ إلَّا اللهُ وحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ وهو على كُلِّ شيءٍ قديرٌ",1],"، ",["غُفِرَت خَطاياه وإن كانَت مِثلَ زَبَدِ البَحرِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"0gxejrPz"},{"id":"س-01171","fp":"5d5da88fbc8e","stateId":66,"easy":"إذا قلت هذه الكلمات ← يُغفر لك","cause":"إذا قُلْتَهنَّ","result":"غُفِرَ لك","explicit":true,"ref":"الأحاديث المختارة 603","srcLabel":"البخاري","text":["«يا علِيُّ، أَلَا أُعَلِّمُك كَلِماتٍ ",["إذا قُلْتَهنَّ",1]," وعليك عَدَدُ الذَّرِّ مِن الخَطايا ",["غُفِرَ لك",2],"، على أنَّه مَغْفورٌ لك؟ تقولُ: لا إلهَ إلَّا اللهُ العَليُّ العَظيمُ، لا إلهَ إلَّا اللهُ الحَليمُ الكَريمُ، سُبْحانَ اللهِ وتَبارَكَ اللهُ رَبُّ العَرْشِ العَظيمِ، الحَمْدُ للهِ رَبِّ العالَمينَ»."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"أدعية وأذكار › فضل الذكر","dorar":"r5S0IaCP"},{"id":"س-01177","fp":"fe34d683fc46","stateId":66,"easy":"إذا قلت «لا إله إلا الله العلي العظيم...» ← يغفر الله لك","cause":"قُل: لا إلَهَ إلَّا اللهُ العَليُّ العَظيمُ، لا إلَهَ إلَّا اللهُ الحَكيمُ الكَريمُ، لا إلَهَ إلَّا اللهُ سُبحانَ اللهِ رَبِّ السَّمواتِ السَّبعِ ورَبِّ العَرشِ العَظيمِ، الحَمدُ للهِ رَبِّ العالَمينَ","result":"إذا قُلتَهنَّ غَفرَ اللهُ لكَ وإن كُنتَ مَغفورًا لكَ","explicit":true,"apply":{"k":"say","t":"«لا إلَهَ إلَّا اللهُ العَليُّ العَظيمُ، لا إلَهَ إلَّا اللهُ الحَكيمُ الكَريمُ، لا إلَهَ إلَّا اللهُ سُبحانَ اللهِ رَبِّ السَّمواتِ السَّبعِ ورَبِّ العَرشِ العَظيمِ، الحَمدُ للهِ رَبِّ العالَمين»"},"ref":"فيض القدير 3/ 112","srcLabel":"البخاري","text":["ألا أُعَلِّمُكَ كَلِماتٍ ",["إذا قُلتَهنَّ غَفرَ اللهُ لكَ وإن كُنتَ مَغفورًا لكَ",2],"؟ ",["قُل: لا إلَهَ إلَّا اللهُ العَليُّ العَظيمُ، لا إلَهَ إلَّا اللهُ الحَكيمُ الكَريمُ، لا إلَهَ إلَّا اللهُ سُبحانَ اللهِ رَبِّ السَّمواتِ السَّبعِ ورَبِّ العَرشِ العَظيمِ، الحَمدُ للهِ رَبِّ العالَمينَ",1]],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"[ورد] بمعناه وإسناده صحيح وأصله في البخاري من طريق آخر","bab":"أدعية وأذكار › فضل الذكر","dorar":"eSAGYnrP"},{"id":"س-01202","fp":"415c75ade531","stateId":66,"easy":"إذا قلت «سبحان الله والحمد لله ولا إله إلا الله والله أكبر» ← تنفض خطاياك كما تنفض الشجرة ورقها","cause":"سبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ واللهُ أكبرُ","result":"تنفُضُ الخطايا كما تنفضُ الشَّجرةُ ورقَها","explicit":true,"apply":{"k":"say","t":"«سبحان الله والحمد لله ولا إله إلا الله والله أكبر»"},"ref":"الترغيب والترهيب 2/356","srcLabel":"البخاري","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم أخذ غُصنًا فنفَضه فلم ينتفِضْ ثمَّ نفَضه فلم ينتفِضْ ثمَّ نفَضه فانتفَض فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم إنَّ ",["سبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ واللهُ أكبرُ",1]," ",["تنفُضُ الخطايا كما تنفضُ الشَّجرةُ ورقَها",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (12534) والبخاري في ((الأدب المفرد)) (634) بلفظه، والترمذي (3533) باختلاف يسير.","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"4FUuD6dk"},{"id":"س-01024","fp":"21100776c374","stateId":66,"easy":"إذا أكثرت ذكر الله ← يضع الذكر عنك أثقالك فتأتي يوم القيامة خفيفاً","cause":"المُسْتَهتَرون بذكرِ اللهِ","result":"يضعُ الذِّكرُ عنهم أثقالَهم فيأتون اللهَ يومَ القيامةِ خِفافًا","explicit":true,"otherNeedIds":[65],"ref":"الترغيب والترهيب 2/329","srcLabel":"مسلم","text":["يا رسولَ اللهِ وما المُفرِدون قال ",["المُسْتَهتَرون بذكرِ اللهِ",1]," ",["يضعُ الذِّكرُ عنهم أثقالَهم فيأتون اللهَ يومَ القيامةِ خِفافًا",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (3596)، وأحمد (8290) باختلاف يسير، وأخرجه مسلم (2676) بنحوه","bab":"أدعية وأذكار › فضل الذكر","dorar":"ngzhPgF2"},{"id":"س-01060","fp":"1e3b8a0cae2a","stateId":66,"easy":"إذا كبّرت وحمدت وسبّحت ثلاثاً وثلاثين وختمت المئة بالتهليل دبر كل صلاة ← تُغفر ذنوبك","cause":"تُكبِّرُ اللهَ دُبُرَ كلِّ صلاةٍ ثلاثًا وثلاثينَ، وتَحمَدُه ثلاثًا وثلاثينَ، وتُسبِّحُه ثلاثًا وثلاثينَ، وتَختِمُها بلا إلهَ إلَّا اللهُ وحدَه لا شريكَ له، له المُلكُ وله الحمدُ، وهو على كلِّ شيءٍ قديرٌ","result":"غُفِرَتْ له ذُنوبُه ولو كانتْ مِثلَ زَبَدِ البحرِ","explicit":true,"apply":{"k":"count","t":"ثلاثاً وثلاثين · الوقت: دبر كل صلاة"},"ref":"تخريج سنن أبي داود 1504","srcLabel":"مسلم","text":["يا رسولَ اللهِ، ذهَبَ أصحابُ الدُّثورِ بالأُجورِ؛ يُصلُّونَ كما نُصلِّي، ويصومونَ كما نصومُ، ولهم فُضولُ أموالٍ يَتصدَّقونَ بها، وليس لنا مالٌ نَتصدَّقُ به، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا أبا ذَرٍّ، ألا أُعلِّمُك كلِماتٍ تُدرِكُ بهنَّ مَن سبَقَك، ولا يَلحَقُك مَن خلْفَك، إلَّا مَن أخَذَ بمِثلِ عملِك؟، قال: بلى يا رسولَ اللهِ، قال: ",["تُكبِّرُ اللهَ دُبُرَ كلِّ صلاةٍ ثلاثًا وثلاثينَ، وتَحمَدُه ثلاثًا وثلاثينَ، وتُسبِّحُه ثلاثًا وثلاثينَ، وتَختِمُها بلا إلهَ إلَّا اللهُ وحدَه لا شريكَ له، له المُلكُ وله الحمدُ، وهو على كلِّ شيءٍ قديرٌ",1],"، ",["غُفِرَتْ له ذُنوبُه ولو كانتْ مِثلَ زَبَدِ البحرِ",2],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1504) بلفظه، ومسلم (1006)، وابن ماجه (927) كلاهما باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"LsrSKoiJ"},{"id":"س-02392","fp":"533dcae000bd","stateId":66,"easy":"إذا سبّحت مئة وهلّلت مئة دبر صلاة الفجر ← تُغفر ذنوبك ولو كانت مثل زبد البحر","cause":"مَن سبَّح في دُبرِ الصَّلاةِ الغداةِ مائةَ تسبيحةٍ ، و هلَّلَ مائةَ تَهليلةٍ","result":"غُفرتْ لهُ ذنوبُه ، و لَو كانَت مثلَ زبدِ البحرِ","explicit":true,"apply":{"k":"time","t":"دبر كل صلاة"},"ref":"الجامع الصغير 8719","srcLabel":"النسائي","text":[["مَن سبَّح في دُبرِ الصَّلاةِ الغداةِ مائةَ تسبيحةٍ ، و هلَّلَ مائةَ تَهليلةٍ ، ",1],["غُفرتْ لهُ ذنوبُه ، و لَو كانَت مثلَ زبدِ البحرِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (1354)، وعبد الرزاق (3194)، وأبو الشيخ في ((ما رواه الزبير)) (143) واللفظ لهم.","bab":"إسلام › فضل الشهادتين","dorar":"NNql5Jto","merged":2,"otherRefs":["صحيح النسائي 1353 (صحيح)"]},{"id":"س-00721","fp":"ab0f63ce584e","stateId":66,"easy":"إذا استيقظت من الليل فقلت «لا إله إلا الله وحده...» ← يُغفر لك","cause":"مَن تَعارَّ مِن اللَّيلِ فقال حِينَ يَستيقظُ: لا إلهَ إلَّا اللهُ وحْدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كلِّ شيءٍ قديرٌ، سُبحانَ اللهِ، والحمدُ للهِ، ولا إلهَ إلَّا اللهُ، واللهُ أكبرُ، ولا حولَ ولا قُوَّةَ إلَّا باللهِ العَليِّ العَظيمِ، ثمَّ دعا: ربِّ اغفِرْ لي","result":"غُفِرَ له","explicit":true,"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ وحْدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كلِّ شيءٍ قديرٌ، سُبحانَ اللهِ، والحمدُ للهِ، ولا إلهَ إلَّا اللهُ، واللهُ أكبرُ، ولا حولَ ولا قُوَّةَ إلَّا باللهِ العَليِّ العَظيمِ» · الوقت: عند الاستيقاظ"},"otherNeedIds":[29],"ref":"ما تمس إليه الحاجة 131","srcLabel":"ما تمس إليه الحاجة","text":[["مَن تَعارَّ مِن اللَّيلِ فقال حِينَ يَستيقظُ: لا إلهَ إلَّا اللهُ وحْدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كلِّ شيءٍ قديرٌ، سُبحانَ اللهِ، والحمدُ للهِ، ولا إلهَ إلَّا اللهُ، واللهُ أكبرُ، ولا حولَ ولا قُوَّةَ إلَّا باللهِ العَليِّ العَظيمِ، ثمَّ دعا: ربِّ اغفِرْ لي",1],"؛ ",["غُفِرَ له",2]," -قال الوَليدُ أحدُ رُواتِه: أو قال: دعا؛ استُجيبَ له-، فإنْ قامَ فتوضَّأ ثُمَّ صلَّى؛ قُبِلتْ صلاتُه."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"EgFiW0iu"},{"id":"س-00980","fp":"dc62d430d1a6","stateId":66,"easy":"إذا قلت بعد الصبح «سبحان الله العظيم وبحمده» مئة مرة ← تُغفر ذنوبك","cause":"مَن قال بعدَ الصبحِ: سبحانَ اللهِ العظيمِ وبحمدِه، مئةَ مرةٍ، ولا إلهَ إلَّا اللهُ وحدَه لا شريكَ له، مئةَ مرةٍ، وبعدَ العصرِ مِثلَ ذلك","result":"غُفِرَتْ له ذُنوبُه وإنْ كانتْ مِثلَ زَبَدِ البحرِ","explicit":true,"apply":{"k":"say","t":"«سبحان الله العظيم وبحمده» · العدد: مئة مرة"},"similar":["س-01102"],"ref":"تخريج مشكل الآثار 10/81","srcLabel":"الترمذي","text":[["مَن قال بعدَ الصبحِ: سبحانَ اللهِ العظيمِ وبحمدِه، مئةَ مرةٍ، ولا إلهَ إلَّا اللهُ وحدَه لا شريكَ له، مئةَ مرةٍ، وبعدَ العصرِ مِثلَ ذلك، ",1],["غُفِرَتْ له ذُنوبُه وإنْ كانتْ مِثلَ زَبَدِ البحرِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الطحاوي في  ((شرح مشكل الآثار)) (10/ 81) واللفظ له، والترمذي (3466) بدون: لا إله إلا الله وحده لا شريك له، والحاكم (1906) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"8jATXbFo"},{"id":"س-01102","fp":"0899b8f71536","stateId":66,"easy":"إذا قلت «سبحان الله وبحمده» مئة مرة كل يوم ← تُغفر ذنوبك","cause":"مَن قال: سُبحانَ اللهِ وبحمْدِه في كلِّ يومٍ مئةَ مرَّةٍ","result":"غُفِرَت ذُنوبُه","explicit":true,"apply":{"k":"say","t":"«سبحان الله وبحمده» · العدد: مئة مرة"},"repOf":"س-00980","ref":"عارضة الأحوذي 6/55","text":[["مَن قال: سُبحانَ اللهِ وبحمْدِه في كلِّ يومٍ مئةَ مرَّةٍ؛ ",1],["غُفِرَت ذُنوبُه",2],"."],"grade":"صحيح","muhaddith":"صحيح","bab":"أدعية وأذكار › فضل الذكر","dorar":"VYQkPBT2"},{"id":"س-01117","fp":"884e097d2ef9","stateId":66,"easy":"إذا قلت هذه الأذكار ثم مِتّ في يومك أو ليلتك ← يُغفر لك","cause":"من قالهنَّ في يومٍ أو في ليلةٍ أو في شهرٍ ، ثمَّ مات في ذلك اليومِ أو في تلك اللَّيلةِ أو في ذلك الشَّهرِ","result":"غُفِر له ذنبُه","explicit":true,"ref":"الترغيب والترهيب 4/250","srcLabel":"النسائي","text":["من قال : لا إلهَ إلَّا اللهُ ، واللهُ أكبرُ ، لا إلهَ إلَّا اللهُ وحدَه ، لا إلهَ إلَّا اللهُ ، ولا شريكَ له ، لا إلهَ إلَّا اللهُ ، له الملكُ وله الحمدُ ، لا إلهَ إلَّا اللهُ ، ولا حولَ ولا قوَّةَ إلَّا باللهِ ، يعقِدُهنَّ خمسًا بأصابِعه ، ثمَّ قال : ",["من قالهنَّ في يومٍ أو في ليلةٍ أو في شهرٍ ، ثمَّ مات في ذلك اليومِ أو في تلك اللَّيلةِ أو في ذلك الشَّهرِ ، ",1],["غُفِر له ذنبُه",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9857)، والإسماعيلي في ((المعجم)) (390)، والخطيب في ((تاريخ بغداد)) (2/184) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"VK0hidu4"},{"id":"س-01252","fp":"78fb22ae9334","stateId":66,"easy":"إذا قلت «لا إله إلا الله والله أكبر وسبحان الله والحمد لله ولا حول ولا قوة إلا بالله» ← تُكفّر ذنوبك","cause":"ما علَى الأرضِ رجلٌ يقولُ : لا إلَهَ إلَّا اللَّهُ ، واللَّهُ أَكْبرُ ، وسُبحانَ اللَّهِ ، والحمدُ للَّهِ ، ولا حَولَ ولا قوَّةَ إلَّا باللَّهِ","result":"إلَّا كَفَّرت عنهُ مِن ذنوبِهِ وإن كانَت مثلَ زبدِ البحرِ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله والله أكبر وسبحان الله والحمد لله ولا حول ولا قوة إلا بالله»"},"similar":["س-00904"],"ref":"تخريج المسند لشاكر 11/165","srcLabel":"الترمذي","text":[["ما علَى الأرضِ رجلٌ يقولُ : لا إلَهَ إلَّا اللَّهُ ، واللَّهُ أَكْبرُ ، وسُبحانَ اللَّهِ ، والحمدُ للَّهِ ، ولا حَولَ ولا قوَّةَ إلَّا باللَّهِ ، ",1],["إلَّا كَفَّرت عنهُ مِن ذنوبِهِ وإن كانَت مثلَ زبدِ البحرِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (3460)، والنسائي في ((عمل اليوم والليلة)) (124)، وأحمد (6479) واللفظ له.","bab":"أدعية وأذكار › فضل لا حول ولا قوة إلا بالله","dorar":"el6J24u5"},{"id":"س-03305","fp":"f2a885038843","stateId":66,"easy":"إذا قلت دبر كل صلاة «الله أكبر وسبحان الله والحمد لله...» مئة مرة ← تُمحى خطاياك ولو كانت مثل الزبد","cause":"كلماتٌ من ذكرهنَّ مائةَ مرَّةٍ دُبُرَ كلِّ صلاةٍ اللهُ أكبرُ وسبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ وحدَه لا شريكَ له ولاحولَ ولا قوَّةَ إلَّا باللهِ","result":"ثمَّ لو كانت خطاياه مثلَ زبدٍ لمحتهنَّ","explicit":true,"apply":{"k":"say","t":"«اللهُ أكبرُ وسبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ وحدَه لا شريكَ له ولاحولَ ولا قوَّةَ إلَّا بالله» · العدد: مئة مرة · الوقت: دبر كل صلاة"},"ref":"الترغيب والترهيب 2/374","srcLabel":"أحمد","text":["أنَّه سمِع أبا ذرٍّ الغِفاريَّ رضِي اللهُ عنه صاحبَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ ",["كلماتٌ من ذكرهنَّ مائةَ مرَّةٍ دُبُرَ كلِّ صلاةٍ اللهُ أكبرُ وسبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ وحدَه لا شريكَ له ولاحولَ ولا قوَّةَ إلَّا باللهِ",1]," ",["ثمَّ لو كانت خطاياه مثلَ زبدٍ لمحتهنَّ",2]],"grade":"صحيح","narrator":"أبو كثير مولى بني هاشم","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أحمد (21512) بلفظه.","bab":"استغفار › أسباب المغفرة","dorar":"xIEKQTxU"},{"id":"س-00904","fp":"03d82bd7633e","stateId":66,"easy":"إذا قلت «سبحان الله والحمد لله ولا إله إلا الله والله أكبر» ← تتساقط ذنوبك كورق الشجر","cause":"سبحانَ اللهِ ، والحمدُ للهِ ، ولا إلهَ إلَّا اللهُ ، واللهُ أكبرُ","result":"يُساقطنَ الذُّنوبَ كما تُسَاقِطُ هذهِ الشَّجرةُ ورقَها","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"apply":{"k":"say","t":"«سبحان الله والحمد لله ولا إله إلا الله والله أكبر»"},"repOf":"س-01252","ref":"سير أعلام النبلاء 6/240","text":["كنتُ مع النَّبيِّ صلَّى اللهُ عليْهِ وسلَّمَ في سفرٍ ، فمرَّ على شجرةٍ يابسةٍ فضربَها بعصًا كانت في يدِهِ فتناثرَ الورَقُ فقال : إنَّ ",["سبحانَ اللهِ ، والحمدُ للهِ ، ولا إلهَ إلَّا اللهُ ، واللهُ أكبرُ",1]," ",["يُساقطنَ الذُّنوبَ كما تُسَاقِطُ هذهِ الشَّجرةُ ورقَها",2]," ."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"غريب ورواته ثقات","takhrij":"أخرجه الترمذي (3533)، وأحمد (12534)، وأبو نعيم في ((حلية الأولياء)) (5/55) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"KHmbG3iF","merged":2,"otherRefs":["صحيح الجامع 1601 (حسن)"]},{"id":"س-01039","fp":"d7e821b3a8ef","stateId":67,"easy":"إذا جلست مع قوم يذكرون الله ← يغفر الله لكم","cause":"فإذا وجَدوا قومًا يذكُرونَ اللهَ","result":"أُشهِدُكم أنِّي قد غفَرْتُ لهم","explicit":true,"star":true,"otherNeedIds":[24],"ref":"تخريج صحيح ابن حبان 857","srcLabel":"متفق عليه","text":["إنَّ للهِ ملائكةً فُضُلًا عن كُتَّابِ النَّاسِ يطوفونَ في الطُّرقِ يلتَمِسونَ أهلَ الذِّكرِ ",["فإذا وجَدوا قومًا يذكُرونَ اللهَ",1]," تنادَوْا : هلُمُّوا إلى حاجتِكم فيحُفُّونَ بهم بأجنحتِهم إلى السَّماءِ الدُّنيا فيسأَلُهم ربُّهم - وهو أعلَمُ منهم - فيقولُ : ما يقولُ عبادي ؟ فيقولونَ : يُكبِّرونَكَ ويُمجِّدونَكَ ويُسبِّحونَك ويحمَدونَكَ فيقولُ : هل رأَوْني ؟ فيقولونَ : لا فيقولُ : فكيفَ لو رأَوْني ؟ فيقولونَ : لو رأَوْكَ لكانوا لكَ أشَدَّ عبادةً وأكثَرَ تسبيحًا وتحميدًا وتمجيدًا فيقولُ : وما يسأَلوني ؟ قال : فيقولونَ : يسأَلونَكَ الجنَّةَ فيقولُ : فهل رأَوْها ؟ فيقولونَ : لا واللهِ يا ربِّ فيقولُ : فكيفَ لو رأَوْها ؟ [ فيقولونَ : لو رأَوْها ] كانوا عليها أشَدَّ حِرصًا وأشَدَّ لها طلبًا وأعظَمَ فيها رغبةً فيقولُ : ومِمَّ يتعوَّذونَ ؟ فيقولونَ : مِن النَّارِ فيقولُ : وهل رأَوْها ؟ فيقولونَ : لا واللهِ يا ربِّ فيقولُ : فكيفَ لو رأَوْها ؟ فيقولونَ : لو رأَوْها لكانوا منها أشَدَّ فرارًا وأشَدَّ هرَبًا وأشَدَّ خوفًا فيقولُ اللهُ لِملائكتِه : ",["أُشهِدُكم أنِّي قد غفَرْتُ لهم",2]," قال : فقال : ملَكٌ مِن الملائكةِ : إنَّ فيهم فُلانًا ليس منهم إنَّما جاء لحاجةٍ قال : فهُمُ الجُلَساءُ لا يَشقى جليسُهم"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6408)، ومسلم (2689) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"Yrv7E83a","merged":4,"otherRefs":["صحيح ابن حبان 856 (صحيح)","صحيح الجامع 2173 (صحيح)","صحيح الترمذي 3600 (صحيح)"]},{"id":"س-08135","fp":"718b5a164fe5","stateId":67,"easy":"إذا جلست في مجلس ذكر تسبّح وتكبّر وتحمد وتسأل ← يغفر الله لكم ويعطيكم ما سألتم ويجيركم مما استجرتم","cause":"يُسَبِّحونَكَ ويُكَبِّرونَكَ ويُهَلِّلونَكَ ويَحمَدونَكَ ويَسألونَكَ","result":"قد غَفَرتُ لهم فأعطَيتُهم ما سَألوا، وأجَرتُهم ممَّا استَجاروا","explicit":true,"star":true,"similar":["س-00899"],"otherNeedIds":[67,66,24],"ref":"صحيح مسلم 2689","srcLabel":"البخاري","text":["إنَّ للَّهِ تَبارَكَ وتَعالى مَلائِكةً سَيَّارةً فُضُلًا يَتَبَّعونَ مَجالِسَ الذِّكرِ، فإذا وجَدوا مَجلِسًا فيه ذِكرٌ قَعَدوا معهُم، وحَفَّ بَعضُهم بَعضًا بأجنِحَتِهم، حتَّى يَملَؤوا ما بينَهم وبينَ السَّماءِ الدُّنيا، فإذا تَفَرَّقوا عَرَجوا وصَعِدوا إلى السَّماءِ، قال: فيَسألُهمُ اللهُ عَزَّ وجَلَّ، وهو أعلَمُ بهم: مِن أينَ جِئتُم؟ فيَقولونَ: جِئنا مِن عِندِ عِبادٍ لكَ في الأرضِ، ",["يُسَبِّحونَكَ ويُكَبِّرونَكَ ويُهَلِّلونَكَ ويَحمَدونَكَ ويَسألونَكَ",1],"، قال: وماذا يَسألوني؟ قالوا: يَسألونَكَ جَنَّتَكَ، قال: وهل رَأوا جَنَّتي؟ قالوا: لا، أي رَبِّ، قال: فكيفَ لو رَأوا جَنَّتي؟ قالوا: ويَستَجيرونَكَ، قال: ومِمَّ يَستَجيرونَني؟ قالوا: مِن نارِكَ يا رَبِّ، قال: وهل رَأوا ناري؟ قالوا: لا، قال: فكيفَ لو رَأوا ناري؟ قالوا: ويَستَغفِرونَكَ، قال: فيَقولُ: ",["قد غَفَرتُ لهم فأعطَيتُهم ما سَألوا، وأجَرتُهم ممَّا استَجاروا",2],"، قال: فيَقولونَ: رَبِّ، فيهم فُلانٌ عَبدٌ خَطَّاءٌ، إنَّما مَرَّ فجَلَسَ معهُم، قال: فيَقولُ: وله غَفَرتُ، هُمُ القَومُ لا يَشقى بهم جَليسُهم."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6408) باختلاف يسير","bab":"ملائكة › أعمال الملائكة","dorar":"vgLc7Z6G","merged":2,"otherRefs":["المستدرك على الصحيحين 1845 (صحيح)"]},{"id":"س-00899","fp":"477035a1c2a5","stateId":67,"easy":"إذا جلست في مجلس ذكر ← يعطيك الله ما سألت ويجيرك مما استجرت","cause":"فإذا مرُّوا بقومٍ يذكرون اللهَ","result":"فإنِّي أُشهدُكم أنِّي قد أعطيتُهم ما سألوا وأجرتُهم ممَّا استجاروا","explicit":true,"repOf":"س-08135","otherNeedIds":[24],"ref":"التمهيد 19/115","text":["إنَّ للهِ ملائكةً فُضَلاءَ سيَّارةً يلتمِسون مجالسَ الذِّكرِ ، ",["فإذا مرُّوا بقومٍ يذكرون اللهَ",1]," يحُفُّون بهم بأجنحتِهم فإذا انصرفوا عرجت الملائكةُ إلى السَّماءِ فيقولُ لهم ربُّنا تبارك وتعالَى وهو أعلمُ : من أين جئتم ؟ فيقولون من عند عبادِك يُسبِّحونك ويحمَدونك ويُهلِّلونك ويسألونك ويستجيرونك ، فيقولُ وهو أعلمُ : وما يسألون ؟ فيقولون : يسألونك الجنَّةَ ، فيقولُ : وهل رأَوْها ؟ فيقولون : لا ، فيقولُ : كيف لو رأَوْها ، ويقولُ : ممَّ يستجيرون وهو أعلمُ ؟ فيقولون من النَّارِ ، فيقولُ : وهل رأَوْها ؟ فيقولون : لا ، فيقولُ : كيف لو رأَوْها ، ثمَّ يقولُ : ",["فإنِّي أُشهدُكم أنِّي قد أعطيتُهم ما سألوا وأجرتُهم ممَّا استجاروا",2]," ، فيقولون : أيْ ربِّ فيهم عبدُك الخطَّاءُ ليس منهم إنَّما مرَّ بهم فجلس إليهم ، فيقولُ : وفلانٌ قد غفرتُ له هم القومُ لا يشقَى بهم جليسُهم"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح ثابت","takhrij":"أخرجه البخاري (6408)، ومسلم (2689) بنحوه","bab":"أدعية وأذكار › فضل الذكر","dorar":"Ud6DarDb"},{"id":"س-01167","fp":"b53782e6e719","stateId":67,"easy":"إذا اجتمعتم على ذكر الله لا تريدون إلا وجهه ← تُغفر ذنوبكم وتبدّل سيئاتكم حسنات","cause":"ما مِن قَوْمٍ اجْتَمَعوا يَذْكرونَ اللهَ تَبارَكَ وتَعالى لا يُريدونَ بذلك إلَّا وَجْهَه","result":"إلَّا ناداهم مُنادٍ مِن السَّماءِ: أن قوموا مَغْفورًا لكم، قد بُدِّلَتْ سَيِّئاتُكم حَسَناتٍ","explicit":true,"otherNeedIds":[45],"ref":"الأحاديث المختارة 2678","srcLabel":"متفق عليه","text":["«",["ما مِن قَوْمٍ اجْتَمَعوا يَذْكرونَ اللهَ تَبارَكَ وتَعالى لا يُريدونَ بذلك إلَّا وَجْهَه ",1],["إلَّا ناداهم مُنادٍ مِن السَّماءِ: أن قوموا مَغْفورًا لكم، قد بُدِّلَتْ سَيِّئاتُكم حَسَناتٍ»",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"أدعية وأذكار › فضل الذكر","dorar":"zkLOKgC8"},{"id":"س-08136","fp":"ce6365a3d2bf","stateId":67,"easy":"إذا جالست الذاكرين ولو مارّاً ← يغفر الله لك معهم، فهم القوم لا يشقى بهم جليسهم","cause":"إنَّما مَرَّ فجَلَسَ معهُم","result":"وله غَفَرتُ، هُمُ القَومُ لا يَشقى بهم جَليسُهم","explicit":true,"ref":"صحيح مسلم 2689","srcLabel":"البخاري","text":["إنَّ للَّهِ تَبارَكَ وتَعالى مَلائِكةً سَيَّارةً فُضُلًا يَتَبَّعونَ مَجالِسَ الذِّكرِ، فإذا وجَدوا مَجلِسًا فيه ذِكرٌ قَعَدوا معهُم، وحَفَّ بَعضُهم بَعضًا بأجنِحَتِهم، حتَّى يَملَؤوا ما بينَهم وبينَ السَّماءِ الدُّنيا، فإذا تَفَرَّقوا عَرَجوا وصَعِدوا إلى السَّماءِ، قال: فيَسألُهمُ اللهُ عَزَّ وجَلَّ، وهو أعلَمُ بهم: مِن أينَ جِئتُم؟ فيَقولونَ: جِئنا مِن عِندِ عِبادٍ لكَ في الأرضِ، يُسَبِّحونَكَ ويُكَبِّرونَكَ ويُهَلِّلونَكَ ويَحمَدونَكَ ويَسألونَكَ، قال: وماذا يَسألوني؟ قالوا: يَسألونَكَ جَنَّتَكَ، قال: وهل رَأوا جَنَّتي؟ قالوا: لا، أي رَبِّ، قال: فكيفَ لو رَأوا جَنَّتي؟ قالوا: ويَستَجيرونَكَ، قال: ومِمَّ يَستَجيرونَني؟ قالوا: مِن نارِكَ يا رَبِّ، قال: وهل رَأوا ناري؟ قالوا: لا، قال: فكيفَ لو رَأوا ناري؟ قالوا: ويَستَغفِرونَكَ، قال: فيَقولُ: قد غَفَرتُ لهم فأعطَيتُهم ما سَألوا، وأجَرتُهم ممَّا استَجاروا، قال: فيَقولونَ: رَبِّ، فيهم فُلانٌ عَبدٌ خَطَّاءٌ، ",["إنَّما مَرَّ فجَلَسَ معهُم",1],"، قال: فيَقولُ: ",["وله غَفَرتُ، هُمُ القَومُ لا يَشقى بهم جَليسُهم",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6408) باختلاف يسير","bab":"ملائكة › أعمال الملائكة","dorar":"vgLc7Z6G"},{"id":"س-00906","fp":"02c0bdb76f0c","stateId":67,"easy":"إذا اجتمعتم على الذكر ← يقال لكم: قوموا مغفوراً لكم","cause":"ما اجتمع قومٌ ، على ذِكرٍ فتفرَّقوا عنه","result":"إلا قيل لهم : قوموا مَغفورًا لكم","explicit":true,"ref":"صحيح الجامع 5507","srcLabel":"صحيح الجامع","text":[["ما اجتمع قومٌ ، على ذِكرٍ فتفرَّقوا عنه",1]," ",["إلا قيل لهم : قوموا مَغفورًا لكم",2]],"grade":"صحيح","narrator":"سهل بن الحنظلية وأنس بن مالك","muhaddith":"صحيح","bab":"أدعية وأذكار › فضل الذكر","dorar":"70mIZGyM"},{"id":"س-01139","fp":"951592a9b6a3","stateId":67,"easy":"إذا جلستم تذكرون الله ← يُقال لكم: قوموا قد غفر الله لكم وبُدّلت سيئاتكم حسنات","cause":"ما جلَسَ قومٌ يذْكُرونَ اللهَ","result":"قومُوا قَدْ غَفَرَ اللهُ لَكُمْ ذنوبَكُمْ ، وبُدِّلَتْ سيئاتُكُمْ حسناتٍ","explicit":true,"ref":"صحيح الجامع 5610","srcLabel":"الطبراني","text":[["ما جلَسَ قومٌ يذْكُرونَ اللهَ",1]," تعالى فيقومونَ حتَّى يقالَ لهم : ",["قومُوا قَدْ غَفَرَ اللهُ لَكُمْ ذنوبَكُمْ ، وبُدِّلَتْ سيئاتُكُمْ حسناتٍ",2]],"grade":"صحيح","narrator":"سهل ابن الحنظلية الأنصاري","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (6/212) (6039)، والبيهقي في ((شعب الإيمان)) (684)، وابن أبي شيبة (30091) بإختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"Nnf525Ib"},{"id":"س-07248","fp":"adf9704c18ef","stateId":67,"easy":"إذا جلست في مجلس ذكر تسأل الله الجنة وتستعيذ من النار وتستغفر ← يغفر الله لك","cause":"يَسأَلونكَ الجنَّةَ، ويَتعَوَّذون بك مِنَ النَّارِ، ويَستَغْفرونك","result":"فإنِّي قد غفَرتُ لهم","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[24],"ref":"تخريج المسند لشعيب 8704","srcLabel":"متفق عليه","text":["إنَّ للهِ عزَّ وجَلَّ ملائكةً فُضُلًا، يتَّبِعون مجالِسَ الذِّكْرِ، يَجتَمِعون عندَ الذِّكْرِ، فإذا مَرُّوا بمجْلسٍ عَلا بعضُهم على بعضٍ حتى يبلغوا العرْشَ، فيقولُ اللهُ عزَّ وجَلَّ لهم -وهو أَعلَمُ-: مِن أين جِئتُم؟ فيقولون: مِن عندِ عَبيدٍ لك، ",["يَسأَلونكَ الجنَّةَ، ويَتعَوَّذون بك مِنَ النَّارِ، ويَستَغْفرونك",1],"، فيقولُ عزَّ وجَلَّ: يسألوني جنَّتي، هل رَأَوْها؟ فكيفَ لو رَأَوْها؟ ويَتعَوَّذون مِن ناري، فكيف لو رَأَوْها؟ ",["فإنِّي قد غفَرتُ لهم",2],"، فيقولون: ربَّنا إنَّ فيهم عَبدَك الخطَّاءَ فلانًا، مَرَّ بهم لحاجةٍ له فجلَسَ إليهم، فقال اللهُ عزَّ وجَلَّ: أولئك الجُلساءُ لا يَشقَى بهم جَليسُهم."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (6408)، ومسلم (2689)، وأحمد (8704) واللفظ له، وأخرجه الترمذي (3600) على الشك في الراوي أبو هريرة أو أبو سعيد الخدري.","bab":"علم › فضل مجالس العلم والذكر","dorar":"3jIi1eCn"},{"id":"س-07249","fp":"c24a3375f6ef","stateId":67,"easy":"إذا جالست الذاكرين ← لا تشقى بهم ولو جئت لحاجة","cause":"مَرَّ بهم لحاجةٍ له فجلَسَ إليهم","result":"أولئك الجُلساءُ لا يَشقَى بهم جَليسُهم","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[53],"ref":"تخريج المسند لشعيب 8704","srcLabel":"متفق عليه","text":["إنَّ للهِ عزَّ وجَلَّ ملائكةً فُضُلًا، يتَّبِعون مجالِسَ الذِّكْرِ، يَجتَمِعون عندَ الذِّكْرِ، فإذا مَرُّوا بمجْلسٍ عَلا بعضُهم على بعضٍ حتى يبلغوا العرْشَ، فيقولُ اللهُ عزَّ وجَلَّ لهم -وهو أَعلَمُ-: مِن أين جِئتُم؟ فيقولون: مِن عندِ عَبيدٍ لك، يَسأَلونكَ الجنَّةَ، ويَتعَوَّذون بك مِنَ النَّارِ، ويَستَغْفرونك، فيقولُ عزَّ وجَلَّ: يسألوني جنَّتي، هل رَأَوْها؟ فكيفَ لو رَأَوْها؟ ويَتعَوَّذون مِن ناري، فكيف لو رَأَوْها؟ فإنِّي قد غفَرتُ لهم، فيقولون: ربَّنا إنَّ فيهم عَبدَك الخطَّاءَ فلانًا، ",["مَرَّ بهم لحاجةٍ له فجلَسَ إليهم",1],"، فقال اللهُ عزَّ وجَلَّ: ",["أولئك الجُلساءُ لا يَشقَى بهم جَليسُهم",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (6408)، ومسلم (2689)، وأحمد (8704) واللفظ له، وأخرجه الترمذي (3600) على الشك في الراوي أبو هريرة أو أبو سعيد الخدري.","bab":"علم › فضل مجالس العلم والذكر","dorar":"3jIi1eCn"},{"id":"س-03467","fp":"5f1f7c57018f","stateId":68,"easy":"إذا جلستم مجلس لغو فختمتموه بالاستغفار ← يُكتب مجلسكم كله استغفاراً","cause":"ما جلَسَ قَومٌ مجلِسَ لَغوٍ فخَتَموا باستِغفارٍ","result":"إلَّا كُتِبَ مَجلِسُهم ذلك استِغفارًا كُلَّه","explicit":true,"ref":"النكت على كتاب ابن الصلاح 2 / 743","srcLabel":"النكت على كتاب ابن الصلاح","text":[["ما جلَسَ قَومٌ مجلِسَ لَغوٍ فخَتَموا باستِغفارٍ",1]," ",["إلَّا كُتِبَ مَجلِسُهم ذلك استِغفارًا كُلَّه\"",2]],"grade":"حسن","narrator":"حسان بن عطية","muhaddith":"رجاله ثقات","bab":"استغفار › فضل الاستغفار","dorar":"xGDSGj7X"},{"id":"س-02414","fp":"72c1d5d5a970","stateId":68,"easy":"إذا قلت «سبحانك اللهم وبحمدك...» في مجلس لغو ← تكون كفارة لك","cause":"ومَنْ قالَها في مَجلِسِ لَغوٍ","result":"كانت كفَّارةً له","explicit":true,"apply":{"k":"say","t":"«سُبحانَكَ اللَّهُمَّ وبحمدِكَ، أَشهدُ أنْ لا إلَهَ إلَّا أنتَ، أَستغفرُكَ، وأَتوبُ إليكَ، فقالَها في مَجلِسِ ذِكرٍ؛ كانت كالطَّابِعِ يُطبَعُ عليه»"},"ref":"المستدرك على الصحيحين 1994","srcLabel":"مسلم","text":["مَنْ قالَ: سُبحانَ اللهِ وبحمدِهِ، سُبحانَكَ اللَّهُمَّ وبحمدِكَ، أَشهدُ أنْ لا إلَهَ إلَّا أنتَ، أَستغفرُكَ، وأَتوبُ إليكَ، فقالَها في مَجلِسِ ذِكرٍ؛ كانت كالطَّابِعِ يُطبَعُ عليه، ",["ومَنْ قالَها في مَجلِسِ لَغوٍ؛ ",1],["كانت كفَّارةً له",2],"."],"grade":"صحيح","narrator":"جبير بن مطعم","muhaddith":"صحيح على شرط مسلم","bab":"إسلام › فضل الشهادتين","dorar":"ThydINKD"},{"id":"س-00726","fp":"e6696687b61c","stateId":68,"easy":"إذا قلت عند قيامك من المجلس «سبحانك اللهم وبحمدك...» ← يُغفر لك ما كان في المجلس","cause":"ما من إنسانٍ يكونُ في مجلِسٍ ، فيقولُ حينَ يريدُ أن يقومَ : سبحانَكَ اللَّهمَّ وبحمدِكَ ، لا إلهَ إلَّا أنتَ ، أستغفرُكَ وأتوبُ إليكَ","result":"إلَّا غُفِرَ لهُ ما كانَ في ذلكَ المَجلِسِ","explicit":true,"apply":{"k":"say","t":"«سبحانَكَ اللَّهمَّ وبحمدِكَ ، لا إلهَ إلَّا أنتَ ، أستغفرُكَ وأتوبُ إليكَ ، إلَّا»"},"similar":["س-03320","س-03990"],"ref":"الصحيح المسند 362","srcLabel":"أحمد","text":[["ما من إنسانٍ يكونُ في مجلِسٍ ، فيقولُ حينَ يريدُ أن يقومَ : سبحانَكَ اللَّهمَّ وبحمدِكَ ، لا إلهَ إلَّا أنتَ ، أستغفرُكَ وأتوبُ إليكَ ، ",1],["إلَّا غُفِرَ لهُ ما كانَ في ذلكَ المَجلِسِ ",2],"."],"grade":"صحيح","narrator":"السائب بن يزيد","muhaddith":"صحيح","takhrij":"أخرجه أحمد (15729)، في ((شرح معاني الآثار)) (6959)، والطبراني (7/154) (6673)","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"1k3Uw6L9","merged":2,"otherRefs":["النكت على كتاب ابن الصلاح 2/734 (حسن)"]},{"id":"س-00747","fp":"759cc92f7187","stateId":68,"easy":"إذا قلت «سبحانك اللهم وبحمدك... أستغفرك وأتوب إليك» ← يكفّر ما كان في المجلس","cause":"سُبحانَكَ اللَّهُمَّ وبحَمدِكَ، أشهَدُ أنْ لا إلهَ إلَّا أنتَ، أستغفِرُكَ وأتوبُ إليكَ","result":"هذا كفَّارةُ ما يَكونُ في المَجلسِ","explicit":true,"apply":{"k":"say","t":"«سُبحانَكَ اللَّهُمَّ وبحَمدِكَ، أشهَدُ أنْ لا إلهَ إلَّا أنتَ، أستغفِرُكَ وأتوبُ إليك»"},"similar":["س-03450"],"ref":"تخريج المسند لشعيب 19812","srcLabel":"النسائي","text":["لمَّا كان بآخِرةٍ، كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ إذا جَلَسَ في المَجلسِ، فأرادَ أنْ يَقومَ قال: ",["سُبحانَكَ اللَّهُمَّ وبحَمدِكَ، أشهَدُ أنْ لا إلهَ إلَّا أنتَ، أستغفِرُكَ وأتوبُ إليكَ",1],"، فقالوا: يا رسولَ اللهِ، إنَّكَ تَقولُ الآن كَلامًا ما كنتَ تَقولُه فيما خَلا، قال: ",["هذا كفَّارةُ ما يَكونُ في المَجلسِ",2],"."],"grade":"صحيح","narrator":"أبو برزة الأسلمي نضلة بن عبيد","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو  داود (4859)، والنسائي في ((السنن الكبرى)) (10259)، وأحمد (19812) واللفظ له","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"WCq6pwLI","merged":2,"otherRefs":["صحيح أبي داود 4859 (صحيح)"]},{"id":"س-03320","fp":"9197f779fb0a","stateId":68,"easy":"إذا جلست في مجلس كثر فيه اللغط فقلت قبل قيامك «سبحانك اللهم وبحمدك...» ← يُغفر لك ما كان فيه","cause":"مَن جَلَسَ في مَجلِسٍ ، فَكَثُرَ فيه لَغَطُهُ ، فقال قَبلَ أنْ يَقومَ من مَجلِسِهِ ذلِكَ : سُبحانَكَ اللهُمَّ رَبَّنا و بِحمدِكَ ، أشْهدُ أنْ لا إِلهَ إلا أنْتَ ، أسْتغفِرُكَ و أتوبُ إِليكَ","result":"إلا غُفِرَ له ما كان في مَجلِسِهِ ذلِكَ","explicit":true,"apply":{"k":"say","t":"«سبحانك اللهم وبحمدك...»"},"repOf":"س-00726","ref":"صحيح الجامع 6192","text":[["مَن جَلَسَ في مَجلِسٍ ، فَكَثُرَ فيه لَغَطُهُ ، فقال قَبلَ أنْ يَقومَ من مَجلِسِهِ ذلِكَ : سُبحانَكَ اللهُمَّ رَبَّنا و بِحمدِكَ ، أشْهدُ أنْ لا إِلهَ إلا أنْتَ ، أسْتغفِرُكَ و أتوبُ إِليكَ ، ",1],["إلا غُفِرَ له ما كان في مَجلِسِهِ ذلِكَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3433)، والنسائي في ((السنن الكبرى)) (10230)، وأحمد (10415) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"0r4ci0eh"},{"id":"س-03450","fp":"b00913ec05c4","stateId":68,"easy":"إذا قلت «سبحانك اللهم وبحمدك لا إله إلا أنت أستغفرك وأتوب إليك» ← يُكفّر بها عنك","cause":"سُبْحانَك اللَّهُمَّ وبحَمْدِكَ، لا إلهَ إلَّا أنتَ، أسْتَغْفِرُك وأتوبُ إليكَ","result":"إلَّا كُفِّرَ بهِنَّ عنه","explicit":true,"apply":{"k":"say","t":"«سبحانك اللهم وبحمدك لا إله إلا أنت أستغفرك وأتوب إليك»"},"repOf":"س-00747","ref":"تخريج سنن أبي داود 4857","text":["عن عبدِ اللهِ بنِ عمرِو بنِ العاصِ، أنَّه قال: كَلِماتٌ لا يتكلَّمُ بِهِنَّ أحَدٌ في مَجلِسِه عندَ قيامِه ثلاثَ مرَّاتٍ ",["إلَّا كُفِّرَ بهِنَّ عنه",2],"، ولا يقولُهُنَّ في مَجلِسِ خَيرٍ ومَجلِسِ ذِكرٍ إلَّا خُتِمَ له بهِنَّ عليه، كما يُختَمُ بالخاتمِ على الصَّحيفةِ: ",["سُبْحانَك اللَّهُمَّ وبحَمْدِكَ، لا إلهَ إلَّا أنتَ، أسْتَغْفِرُك وأتوبُ إليكَ",1],"."],"grade":"صحيح","narrator":"سعيد بن أبي سعيد المقبري","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4857) بلفظه، وابن حبان (593)، والطبراني في ((الدعاء)) (1915) كلاهما باختلاف يسير، والضبي في ((الدعاء)) (107) مختصرا.","bab":"استغفار › فضل الاستغفار","dorar":"fB4DWege"},{"id":"س-03536","fp":"c6fe9b9c05f6","stateId":68,"easy":"إذا قلت كفارة المجلس حين تقوم منه ← يُغفر لك ما كان فيه","cause":"لا يقولُهُنَّ أحدٌ حينَ يقومُ من مجلِسِهِ","result":"إلَّا غُفِرَ لَهُ، ما كانَ في ذلِكَ المجلِسِ","explicit":true,"ref":"نخب الافكار 13/488","srcLabel":"الحاكم","text":["ما كانَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقومُ منَ مَجلسٍ إلَّا قالَ: سُبحانَكَ اللَّهمَّ ربِّي وبحَمدِكَ، لا إلَهَ إلَّا أنتَ، أستَغفرُكَ وأتوبُ إليكَ فقُلتُ لَهُ: يا رسولَ اللَّهِ، ما أَكْثرُ ما تَقولُ هذه الكلِماتِ، إذا قُمتُ ؟ فقالَ: إنَّهُ ",["لا يقولُهُنَّ أحدٌ حينَ يقومُ من مجلِسِهِ",1]," ",["إلَّا غُفِرَ لَهُ، ما كانَ في ذلِكَ المجلِسِ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح معاني الآثار)) (6960) بلفظه، والطبراني في ((الدعاء)) (1912) بنحوه، والحاكم (1827) باختلاف يسير.","bab":"استغفار › مكفرات الذنوب","dorar":"miHweuGS"},{"id":"س-03990","fp":"7c751459d21c","stateId":68,"easy":"إذا كثر لغطك في مجلس فقلت عند قيامك «سبحانك اللهم وبحمدك...» ← تُغفر خطاياك فيه","cause":"مَن كثُرَ لَغَطُه في مَجلِسٍ، فلْيَقُلْ بعْدَ أنْ يقومَ: سُبحانَك اللَّهمَّ وبحَمْدِك، أشهَدُ أنْ لا إلهَ إلَّا أنتَ، أستَغفِرُك وأتوبُ إليك","result":"تُغفَرُ خَطاياهُ في ذلك المجلِسِ","explicit":true,"apply":{"k":"say","t":"«سُبحانَك اللَّهمَّ وبحَمْدِك، أشهَدُ أنْ لا إلهَ إلَّا أنتَ، أستَغفِرُك وأتوبُ إليك»"},"repOf":"س-00726","ref":"فتاوى نور على الدرب لابن عثيمين 2/555","text":[["مَن كثُرَ لَغَطُه في مَجلِسٍ، فلْيَقُلْ بعْدَ أنْ يقومَ: سُبحانَك اللَّهمَّ وبحَمْدِك، أشهَدُ أنْ لا إلهَ إلَّا أنتَ، أستَغفِرُك وأتوبُ إليك؛ ",1],["تُغفَرُ خَطاياهُ في ذلك المجلِسِ",2],"."],"grade":"صحيح","muhaddith":"صحيح","bab":"توبة › الحض على التوبة","dorar":"DLrnSEDj"},{"id":"س-03997","fp":"15e613724a49","stateId":68,"easy":"إذا قلت شراً ثم قلت «سبحانك وبحمدك لا إله إلا أنت أستغفرك» ← تكون كفارة لك","cause":"مَن قال خيرًا خُتِمَ له طابَعٌ على ذلكَ الخيرِ، ومَن قال شرًّا","result":"كُنَّ له كفَّارةً: سُبحانَكَ وبحمدِكَ، لا إلهَ إلَّا أنتَ، أستغفِرُكَ وأتوبُ إليكَ، عن عائشةَ: أنَّ رسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّم كان إذا جلَس مجلِسًا أو صلَّى تكلَّم","explicit":true,"apply":{"k":"say","t":"«سبحانك وبحمدك لا إله إلا أنت أستغفرك»"},"similar":["س-03443"],"ref":"الصحيح المسند 1598","srcLabel":"النسائي","text":["ما جلَس رسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّم مجلِسًا، ولا تلا قُرْآنًا، ولا صلَّى صلاةً، إلَّا ختَم ذلكَ بكلِماتٍ، قالَتْ: فقُلْتُ: يا رسولَ اللهِ، أراك ما تجلِسُ مجلِسًا ولا تتلو قُرْآنًا، ولا تُصلِّي صلاةً، إلَّا ختَمْتَ بهؤلاءِ الكلِماتِ، قال: نَعم، ",["مَن قال خيرًا خُتِمَ له طابَعٌ على ذلكَ الخيرِ، ومَن قال شرًّا، ",1],["كُنَّ له كفَّارةً: سُبحانَكَ وبحمدِكَ، لا إلهَ إلَّا أنتَ، أستغفِرُكَ وأتوبُ إليكَ، عن عائشةَ: أنَّ رسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّم كان إذا جلَس مجلِسًا أو صلَّى تكلَّم",2]," بكلِماتٍ، فسأَلَتْه عائشةُ عنِ الكلِماتِ، فقال: إن تكلَّم بخيرٍ كان طابَعًا عليهنَّ إلى يومِ القيامةِ، وإن تكلَّم بغيرِ ذلكَ كان كفَّارةً: سُبحانَكَ وبحمدِكَ، لا إلهَ إلَّا أنتَ، أستغفِرُكَ وأتوبُ إليكَ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((عمل اليوم والليلة)) (308) واللفظ له، وأحمد (24486) مختصرا.","bab":"توبة › الحض على التوبة","dorar":"cB3qmhmb"},{"id":"س-04018","fp":"0fdde3480b98","stateId":68,"easy":"إذا قلت «سبحانك اللهم وبحمدك... عملت سوءاً وظلمت نفسي فاغفر لي» ← تكون كفارة المجلس","cause":"سبحانَك اللَّهمَّ وبحمدِك أشهدُ أن لا إله إلَّا أنت أستغفرُك وأتوبُ إليك عملتُ سوءًا وظلمتُ نفسي فاغفرْ لي إنَّه لا يغفرُ الذُّنوبَ إلَّا أنت","result":"هنَّ كفاراتُ المجلسِ","explicit":true,"apply":{"k":"say","t":"«سبحانَك اللَّهمَّ وبحمدِك أشهدُ أن لا إله إلَّا أنت أستغفرُك وأتوبُ إليك عملتُ سوءًا وظلمتُ نفسي فاغفرْ لي»"},"ref":"الترغيب والترهيب 2/338","srcLabel":"النسائي","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بأُخرةٍ إذا اجتمع إليه أصحابُه فأراد أن ينهضَ قال ",["سبحانَك اللَّهمَّ وبحمدِك أشهدُ أن لا إله إلَّا أنت أستغفرُك وأتوبُ إليك عملتُ سوءًا وظلمتُ نفسي فاغفرْ لي إنَّه لا يغفرُ الذُّنوبَ إلَّا أنت",1]," قال قلنا يا رسولَ اللهِ إنَّ هذه الكلماتِ أحدَثتهنَّ قال أجلْ جاءني جبرائيلُ فقال يا محمَّدُ ",["هنَّ كفاراتُ المجلسِ",2]],"grade":"صحيح","narrator":"رافع بن خديج","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه النسائي (10188)، والحاكم (1972)، والطبراني (4/ 287) (4445) باختلاف يسير.","bab":"توبة › الحض على التوبة","dorar":"z5mfrZvy"},{"id":"س-03380","fp":"71c92284d10a","stateId":68,"easy":"إذا ختمت مجلسك بـ«سبحانك اللهم وبحمدك... أستغفرك وأتوب إليك» ← يكون كفارة لما قلت فيه من شر","cause":"ومَن قال شرًّا","result":"كانت كفارةً له سبحانَك اللهمَّ وبحمدِك لا إلهَ إلا أنتَ أستغفرُك وأتوبُ إليك","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"apply":{"k":"say","t":"«سبحانَك اللهمَّ وبحمدِك لا إلهَ إلا أنتَ أستغفرُك وأتوبُ إليك»"},"ref":"النكت على كتاب ابن الصلاح 2/733","srcLabel":"النسائي","text":["عن عائشةَ _ رضِيَ اللهُ عنها _ قالت : ما جلس رسولُ اللهِ _ صلَّى اللهُ عليهِ وسلَّمَ – مجلسًا ولا تلا قرآنًا ولا صلَّى إلا ختمَ ذلك بكلماتٍ فقلتُ : يا رسولَ اللهِ ما أكثرَ ما تقولُ هذه الكلماتِ فقال _ صلَّى اللهُ عليهِ وسلَّمَ _ : نعم . من قال : خيرًا كنَّ طابعًا له على ذلك الخيرِ , ",["ومَن قال شرًّا ",1],["كانت كفارةً له سبحانَك اللهمَّ وبحمدِك لا إلهَ إلا أنتَ أستغفرُك وأتوبُ إليك",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح وله طريق أخرى عن عائشة","takhrij":"أخرجه النسائي (1344)، والطبراني في ((الدعاء)) (1912) باختلاف يسير، والحاكم (1827) بمعناه.","bab":"استغفار › أسباب المغفرة","dorar":"7a0hsFAb"},{"id":"س-03443","fp":"fd483e3c25cf","stateId":68,"easy":"إذا قلت «سبحانك اللهم وبحمدك أشهد أن لا إله إلا أنت أستغفرك وأتوب إليك» ← تكون كفارة لخطاياك","cause":"سبحانَكَ اللهمَّ وبحمدِكَ ، أشهدُ أنْ لا إلهَ إلَّا أنتَ ، أستغفرُكَ وأتوبُ إليكَ","result":"كَلِماتٌ عَلَّمَنِيهِنَّ جبريلُ – عليهِ السلامُ – كَفَّارَاتٌ لِخَطَايا المجلسِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"apply":{"k":"say","t":"«سبحانك اللهم وبحمدك أشهد أن لا إله إلا أنت أستغفرك وأتوب إليك»"},"repOf":"س-03997","ref":"المطالب العالية 4/26","text":["أنَّ رجلًا من أصحابِ رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ أنَّهُ جلسَ مجلَسًا فلمَّا أرادَ أنْ يقومَ قال : ",["سبحانَكَ اللهمَّ وبحمدِكَ ، أشهدُ أنْ لا إلهَ إلَّا أنتَ ، أستغفرُكَ وأتوبُ إليكَ",1]," ، قال : فقال رجلٌ مِنَ القومِ : ما هذا الحديثُ يا رسولَ اللهِ ؟ قال صلَّى اللهُ عليهِ وسلَّمَ : ",["كَلِماتٌ عَلَّمَنِيهِنَّ جبريلُ – عليهِ السلامُ – كَفَّارَاتٌ لِخَطَايا المجلسِ",2]],"grade":"صحيح","narrator":"رجل من أصحاب النبي.","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي شيبة في ((مسنده)) (954) واللفظ له، وابن منده في ((معرفة الصحابة)) (صـ894) بنحوه.","bab":"استغفار › فضل الاستغفار","dorar":"60p640Y3"},{"id":"س-03458","fp":"c446189d30ef","stateId":69,"easy":"إذا دعوت الله ورجوته ← يغفر لك ما كان منك ولا يبالي","cause":"ما دَعَوْتَنِي ورَجَوْتَنِي","result":"غفرتُ لك ما كان فيك ولا أُبَالِي","explicit":true,"star":true,"otherNeedIds":[29],"ref":"هداية الرواة 2276","srcLabel":"الترمذي","text":["قال اللهُ – تعالى – يا ابنَ آدمَ ! إنك ",["ما دَعَوْتَنِي ورَجَوْتَنِي",1]," ؛ ",["غفرتُ لك ما كان فيك ولا أُبَالِي",2],"، يا ابنَ آدمَ ! لو بَلَغَتْ ذنوبُكَ عَنَانَ السماءِ، ثم استَغْفَرْتَنِي ؛ غفرتُ لك ولا أُبَالِي، يا ابنَ آدمَ ! إنك لو أَتَيْتَنِي بقُرَابِ الأرضِ خَطَايَا، ثم لَقِيتَنِي لا تُشْرِكُ بي شيئًا ؛ لَأَتَيْتُكَ بقُرَابِها مَغْفِرَةً"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"حسن بل صحيح","takhrij":"أخرجه الترمذي (3540) واللفظ له، وأحمد (13493) مختصراً بمعناه.","bab":"استغفار › فضل الاستغفار","dorar":"b0r8OsTX","merged":6,"otherRefs":["الأحاديث المختارة 1571 (صحيح)","صحيح الجامع 4341 (صحيح)","تخريج المسند لشعيب 21472 (حسن)","تخريج المسند لشعيب 21368 (حسن)","الأحاديث المختارة 1572 (صحيح)"]},{"id":"س-03371","fp":"0dd06a363132","stateId":69,"easy":"إذا دعوت في مرضك بدعوة ذي النون أربعين مرة ← إن مت أُعطيت أجر شهيد، وإن برئت غُفرت ذنوبك","cause":"أيُّما مسلمٍ دعا بها في مرضِه أربعين مرَّةً فمات في مرضِه ذلك أُعطِي أجرَ شهيدٍ ، وإن برأ برأ وقد","result":"غُفِر له جميعُ ذنوبِه","explicit":true,"apply":{"k":"count","t":"أربعين مرة"},"ref":"الترغيب والترهيب 4/251","srcLabel":"أحمد","text":["لا إلهَ إلَّا أنت سبحانك إنِّي كنتُ من الظَّالمين : ",["أيُّما مسلمٍ دعا بها في مرضِه أربعين مرَّةً فمات في مرضِه ذلك أُعطِي أجرَ شهيدٍ ، وإن برأ برأ وقد ",1],["غُفِر له جميعُ ذنوبِه",2]],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أحمد (1462)، والحاكم (1865) كلاهمت بلفظه تاما.","bab":"استغفار › أسباب المغفرة","dorar":"qFQBLlVW"},{"id":"س-06850","fp":"df14f2df2271","stateId":69,"easy":"إذا دعوت «اللهم إني أسألك يا الله بأنك الواحد الأحد الصمد...» ← يغفر الله لك","cause":"اللَّهمَّ إنِّي أسألُكَ يا اللَّهُ بأنَّكَ الواحدُ الأحدُ الصَّمدُ ، الَّذي لم يَلِدْ ولم يولَدْ ولم يَكُنْ لَهُ كُفُوًا أَحَدٌ ، أن تغفِرَ لي ذُنوبي ، إنَّكَ أنتَ الغَفورُ الرَّحيمُ","result":"قَد غَفرَ اللَّهُ لَهُ ، ثلاثًا","explicit":true,"apply":{"k":"say","t":"«اللَّهمَّ إنِّي أسألُكَ يا اللَّهُ بأنَّكَ الواحدُ الأحدُ الصَّمدُ ، الَّذي لم يَلِدْ ولم يولَدْ ولم يَكُنْ لَهُ كُفُوًا أَحَدٌ ، أن»"},"ref":"صحيح النسائي 1300","srcLabel":"أبو داود","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ دخلَ المسجدَ ، إذا رجلٌ قد قَضى صلاتَهُ وَهوَ يتشَهَّدُ ، فقالَ: ",["اللَّهمَّ إنِّي أسألُكَ يا اللَّهُ بأنَّكَ الواحدُ الأحدُ الصَّمدُ ، الَّذي لم يَلِدْ ولم يولَدْ ولم يَكُنْ لَهُ كُفُوًا أَحَدٌ ، أن تغفِرَ لي ذُنوبي ، إنَّكَ أنتَ الغَفورُ الرَّحيمُ",1]," ، فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: ",["قَد غَفرَ اللَّهُ لَهُ ، ثلاثًا",2]],"grade":"صحيح","narrator":"محجن بن الأدرع","muhaddith":"صحيح","takhrij":"أخرجه النسائي (1301) واللفظ له، وأبو داود (985)  وأحمد (18974)باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"EP1jHA8m"},{"id":"س-00685","fp":"77241a6b96a7","stateId":69,"easy":"إذا قلت «اللهم مغفرتك أوسع من ذنوبي ورحمتك أرجى عندي من عملي» ← يغفر الله لك","cause":"قلِ اللَّهمَّ مغفرتُك أوسعُ من ذنوبي ورحمتُك أرجَى عندي من عملي","result":"قمْ فقد غفر اللهُ لك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«اللهم مغفرتك أوسع من ذنوبي ورحمتك أرجى عندي من عملي»"},"ref":"الترغيب والترهيب 2/386","srcLabel":"الحاكم","text":["جاء رجلٌ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقال واذنوباه واذنوباه فقال هذا القوْلَ مرَّتَيْن أو ثلاثًا فقال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["قلِ اللَّهمَّ مغفرتُك أوسعُ من ذنوبي ورحمتُك أرجَى عندي من عملي",1]," فقالها ثمَّ قال عدْ فعاد ثمَّ قال عدْ فعاد ثمَّ قال ",["قمْ فقد غفر اللهُ لك",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الحاكم (1994)، والبيهقي في ((شعب الإيمان)) (7126)","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"25V7fQ1M"},{"id":"س-03356","fp":"b4b138bd9e5d","stateId":70,"easy":"إذا صليت على النبي ﷺ مرة ← يصلي الله عليك عشراً ويحط عنك عشر خطيئات ويرفعك عشر درجات","cause":"من صلَّى عليَّ واحدةً","result":"صلَّى اللهُ عليه عشرَ صلواتٍ ، و حطَّ عنه عشرَ خطيئاتٍ ، و رفعَ له عشرَ درجاتٍ","explicit":true,"star":true,"otherNeedIds":[47],"ref":"صحيح الجامع 6359","srcLabel":"النسائي","text":[["من صلَّى عليَّ واحدةً",1]," ، ",["صلَّى اللهُ عليه  عشرَ صلواتٍ ، و حطَّ عنه عشرَ خطيئاتٍ ، و رفعَ له عشرَ درجاتٍ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه النسائي (1297)، وأحمد (11998) مختصراً واللفظ له","bab":"استغفار › أسباب المغفرة","dorar":"3liforVE"},{"id":"س-03414","fp":"72ce6ab371f0","stateId":70,"easy":"إذا صليت على النبي ﷺ يوم الجمعة ثمانين مرة ← يغفر الله لك ذنوب ثمانين سنة","cause":"من صلَّى عليَّ يومَ الجمعةِ ثمانين مرَّةً","result":"غفر اللهُ له ذنوبَ ثمانين سنةً","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"ref":"القول البديع 285","srcLabel":"الخطيب","text":[["من صلَّى عليَّ يومَ الجمعةِ ثمانين مرَّةً ",1],["غفر اللهُ له ذنوبَ ثمانين سنةً ",2],". قيل : يا رسولَ اللهِ ! كيف الصَّلاةُ عليك ؟ قال : تقولُ : اللَّهمَّ صَلِّ على محمَّدٍ عبدِك ونبيِّك ورسولِك ، النَّبيِّ الأمِّيِّ ، وتعقِدُ واحدةً"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسنه العراقي ويحتاج إلى نظر","takhrij":"أخرجه الخطيب في ((تاريخ بغداد)) (13/489)، وابن الجوزي في ((العلل المتناهية)) (796) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"me1wscUc"},{"id":"س-03385","fp":"580d22d2bc0c","stateId":70,"easy":"إذا جعلت دعاءك كله صلاة على النبي ﷺ ← يُغفر لك ذنبك كله","cause":"أفأجعلُ لك صلاتي كلَّها","result":"إذَنْ يُغْفَرُ لك ذنبُك كلُّه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"فضل الصلاة 14","srcLabel":"الترمذي","text":["كان رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم يخرجُ في ثُلُثَي الليلِ فيقول : جاءتِ الراجفةُ ، تتبعُها الرادفةُ ، جاء الموتُ بما فيه ، وقال أبي ؟ ؟ : يا رسولَ اللهِ إني أُصلِّي من الليلِ : أفأجعلُ لك ثلثَ صَلاتي ؟ قال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم : الشّطرَ . قال : أفأجعلُ لك شَطرَ صلاتي ؟ قال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم : الثُّلُثانِ أكثرُ . قال : ",["أفأجعلُ لك صلاتي كلَّها",1]," ؟ [ قال ] : ",["إذَنْ يُغْفَرُ لك ذنبُك كلُّه",2]],"grade":"حسن","narrator":"أبي بن كعب","muhaddith":"جيد","takhrij":"أخرجه الترمذي (2457)، وعبد بن حميد في ((المنتخب)) (170)، ومحمد بن نصر المروزي في ((مختصر قيام الليل)) (ص95) بلفظه.","bab":"استغفار › أسباب المغفرة","dorar":"1rY5OWyB"},{"id":"س-07273","fp":"eb72658442e5","stateId":71,"easy":"إذا افتتنت في أهلك ومالك وجارك ← تكفّرها الصلاة والصيام والصدقة","cause":"الصَّلاةُ والصِّيامُ والصَّدَقةُ","result":"تُكَفِّرُها","explicit":true,"star":true,"ref":"صحيح مسلم 144","srcLabel":"متفق عليه","text":["كُنَّا عِندَ عُمَرَ، فقال: أيُّكُم سَمِعَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَذكُرُ الفِتَنَ؟ فقال قومٌ: نَحنُ سَمِعناه، فقال: لَعَلَّكُم تَعنونَ فِتنةَ الرَّجُلِ في أهلِه وجارِه؟ قالوا: أجَل، قال: تلك ",["تُكَفِّرُها",2]," ",["الصَّلاةُ والصِّيامُ والصَّدَقةُ",1],"، ولَكِن أيُّكُم سَمِعَ النَّبيَّ صلَّى اللهُ عليه وسلَّم يَذكُرُ التي تَموجُ مَوجَ البَحرِ؟ قال حُذَيفةُ: فأسكَتَ القَومُ، فقُلتُ: أنا، قال: أنتَ للَّهِ أبوك! قال حُذَيفةُ: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: تُعرَضُ الفِتَنُ على القُلوبِ كالحَصيرِ عودًا عودًا، فأيُّ قَلبٍ أُشرِبَها نُكِتَ فيه نُكتةٌ سَوداءُ، وأيُّ قَلبٍ أنكَرَها نُكِتَ فيه نُكتةٌ بَيضاءُ، حتَّى تَصيرَ على قَلبَينِ: على أبيَضَ مِثلِ الصَّفا، فلا تَضُرُّه فِتنةٌ ما دامَتِ السَّمَواتُ والأرضُ، والآخَرُ أسودُ مُربادًّا كالكوزِ مُجَخِّيًا، لا يَعرِفُ مَعروفًا ولا يُنكِرُ مُنكَرًا إلَّا ما أُشرِبَ مِن هَواه. قال حُذَيفةُ: وحَدَّثتُه أنَّ بينَك وبينَها بابًا مُغلَقًا يوشِكُ أن يُكسَرَ، قال عُمَرُ: أكَسرًا لا أبا لَك؟ فلو أنَّه فُتِحَ لَعَلَّه كانَ يُعادُ، قُلتُ: لا، بَل يُكسَرُ، وحَدَّثتُه أنَّ ذلك البابَ رَجُلٌ يُقتَلُ أو يَموتُ، حَديثًا ليس بالأغاليطِ. قال أبو خالِدٍ: فقُلتُ لسَعدٍ: يا أبا مالِكٍ، ما أسودُ مُربادٌّ؟ قال: شِدَّةُ البَياضِ في سَوادٍ، قال: قُلتُ: فما الكوزُ مُجَخِّيًا؟ قال: مَنكوسًا. وفي روايةٍ: لَمَّا قدِمَ حُذَيفةُ مِن عِندِ عُمَرَ جَلَسَ، فحَدَّثَنا، فقال: إنَّ أميرَ المُؤمِنينَ أمسِ لَمَّا جَلَستُ إليه سَألَ أصحابَه، أيُّكُم يَحفَظُ قَولَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في الفِتَنِ؟ وساقَ الحَديثَ بمِثلِ حَديثِ أبي خالِدٍ، ولَم يَذكُرْ تَفسيرَ أبي مالِكٍ لقَولِه: مُربادًّا مُجَخِّيًا. وفي روايةٍ: أنَّ عُمَرَ قال: مَن يُحَدِّثُنا، أو قال: أيُّكُم يُحَدِّثُنا -وفيهم حُذَيفةُ- ما قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم في الفِتنةِ؟ قال حُذَيفةُ: أنا، وساقَ الحَديثَ كَنَحوِ حَديثِ أبي مالِكٍ، عن رِبعيٍّ، وقال في الحَديثِ: قال حُذَيفةُ: حَدَّثتُه حَديثًا ليس بالأغاليطِ، وقال: يَعني أنَّه عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (23440)، والبزار (2844)، وأبو عوانة في ((مستخرجه على مسلم)) (213) جميعا بنحوه، وأصل الحديث في ((صحيح البخاري)) (1435) دون قوله: ((تعرض الفتن على القلوب...)) .","bab":"فتن › ظهور الفتن","dorar":"uAVNb7mc","merged":12,"otherRefs":["صحيح الترمذي 2258 (صحيح)","صحيح الجامع 4195 (صحيح)","صحيح البخاري 3586 (صحيح)","صحيح مسلم 144 (صحيح)","صحيح البخاري 1435 (صحيح)","عارضة الأحوذي 5/98 (صحيح)","أحكام القرآن لابن العربي 2/390 (صحيح)","صحيح البخاري 1895 (صحيح)","تخريج المسند لشعيب 23280 (صحيح)","صحيح البخاري 525 (صحيح)","صحيح البخاري 7096 (صحيح)"]},{"id":"س-06634","fp":"7575a691b131","stateId":71,"easy":"إذا قمت إلى الصلاة فسجدت ← تتناثر عنك خطاياك يميناً وشمالاً","cause":"إذا قام إلى صَلاتِه؟ جُمِعَت خطاياه فجُعِلَت فَوقَ رأسِه، إذا خَرَّ ساجِدًا","result":"تناثَرَت عنه يمينًا وشِمالًا","explicit":true,"star":true,"similar":["س-03699"],"ref":"الأحاديث المختارة 2233","srcLabel":"البخاري","text":["«كُنَّا مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم -أحسَبُه قال:- في غَزاةٍ- قال: فإمَّا أَمَر رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم بعِذْقٍ فقُطِعَ، وإمَّا كان مقطوعًا قد هاج ورَقُه، وبيَدِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم قَضيبٌ يَضْرِبُ به، ووَرَقُه يتناثَرُ، قال: هل تَدْرون ما مَثَلُ المؤمِنِ ",["إذا قام إلى صَلاتِه؟ جُمِعَت خطاياه فجُعِلَت فَوقَ رأسِه، إذا خَرَّ ساجِدًا",1]," ",["تناثَرَت عنه يمينًا وشِمالًا",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"jE7n5PLh","merged":2,"otherRefs":["السلسلة الصحيحة 3402 (صحيح)"]},{"id":"س-08220","fp":"48133a7d00d6","stateId":71,"easy":"إذا أوقدت على نفسك نار الذنوب ← فأطفئها بالصلاة","cause":"فأطْفِئُوها بالصَّلاةِ","result":"قوموا إلى نيرانِكم الَّتي أوْقَدْتُموها على أنْفُسِكم","explicit":true,"ref":"الأحاديث المختارة 2590","srcLabel":"متفق عليه","text":["«إنَّ للهِ عَزَّ وجَلَّ مَلَكًا يُنادي عِنْدَ كلِّ صَلاةٍ: يا بَني آدَمَ ",["قوموا إلى نيرانِكم الَّتي أوْقَدْتُموها على أنْفُسِكم",2]," ",["فأطْفِئُوها بالصَّلاةِ",1],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"ملائكة › أعمال الملائكة","dorar":"J6DBsD6X","merged":2,"otherRefs":["صحيح الترغيب 359 (حسن)"]},{"id":"س-00505","fp":"1b958650e7cd","stateId":71,"easy":"إذا حافظت على الصلوات الخمس ← يمحو الله بها خطاياك","cause":"الصَّلَواتِ الخَمسِ","result":"يَمحو اللهُ به الخَطايا","explicit":true,"ref":"صحيح البخاري 528","srcLabel":"مسلم","text":["أنَّه سَمِعَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: أرَأيتُم لو أنَّ نَهَرًا ببابِ أحَدِكُم يَغتَسِلُ فيه كُلَّ يَومٍ خَمسًا، ما تَقولُ ذلك يُبقي مِن دَرَنِه؟ قالوا: لا يُبقي مِن دَرَنِه شيئًا، قال: فذلك مِثلُ ",["الصَّلَواتِ الخَمسِ",1],"، ",["يَمحو اللهُ به الخَطايا",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (667) باختلاف يسير","bab":"آداب عامة › ضرب الأمثال","dorar":"NCSBYdvR","merged":2,"otherRefs":["تخريج المسند لشعيب 8925 (صحيح)"]},{"id":"ق-0599","fp":"eb981d46ca16","stateId":71,"easy":"فعل الحسنات (الصلاة) ← ذهاب السيئات","cause":"فعل الحسنات (الصلاة)","result":"ذهاب السيئات","explicit":true,"ref":"سورة هود: 114","srcLabel":"القرآن الكريم","quran":{"s":11,"from":114,"to":114,"text":"وَأَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ إِنَّ الْحَسَنَاتِ يُذْهِبْنَ السَّيِّئَاتِ ذَلِكَ ذِكْرَى لِلذَّاكِرِينَ (114)","hl":[[0,84,1],[84,108,2]]}},{"id":"س-06568","fp":"64a376720974","stateId":71,"easy":"إذا حافظت على الصلوات الخمس والجمعة وأديت الأمانة ← تكون كفارة لما بينها","cause":"الصَّلواتُ الخَمسُ، والجُمُعةُ إلى الجُمُعةِ، وأداءُ الأمانةِ","result":"كفارةٌ لِمَا بينَها","explicit":true,"similar":["س-06487"],"ref":"شرح ابن ماجه لمغلطاي 2/254","srcLabel":"الطبراني","text":[["الصَّلواتُ الخَمسُ، والجُمُعةُ إلى الجُمُعةِ، وأداءُ الأمانةِ",1],": ",["كفارةٌ لِمَا بينَها",2],"، قُلتُ: وما أداءُ الأمانَةِ؟ قال: غُسلُ الجنابَةِ، فإنَّ تحتَ كُلِّ شَعْرةٍ جَنابةً."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجة (598 )، وابن نصر في ((تعظيم قدر الصلاة)) (511 )، والطبراني في ((المعجم الكبير)) (4/ 155) (3989 )","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"cjuAT4aG","merged":4,"otherRefs":["صحيح الجامع 3875 (صحيح)","السلسلة الصحيحة 1920 (صحيح)","السلسلة الصحيحة 3322 (صحيح)"]},{"id":"س-00590","fp":"9f87c121c7d2","stateId":71,"easy":"إذا صليت ← تذهب الصلاة ذنوبك كما يذهب الماء الوسخ","cause":"فإنَّ الصَّلَواتِ","result":"تُذهِبُ الذُّنوبَ كما يُذهِبُ الماءُ الدَّرَنَ","explicit":true,"ref":"تخريج مشكل الآثار 4962","srcLabel":"ابن ماجه","text":["سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: أرَأَيتَ لو كان بفِناءِ أحَدِكم نَهرٌ يَجري يَغتسِلُ منه كلَّ يومٍ خَمسَ مِرارٍ، ما كان مُبقِيًا مِن دَرَنِه؟ قال: لا شيءَ، قال: ",["فإنَّ الصَّلَواتِ ",1],["تُذهِبُ الذُّنوبَ كما يُذهِبُ الماءُ الدَّرَنَ",2],"."],"grade":"صحيح","narrator":"عثمان","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (4962)، والمروزي في ((تعظيم قدر الصلاة)) (84) واللفظ لهما، وابن ماجه (1397)، وأحمد (518)، وعبد بن حميد (56) جميعا باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"vtvyUYQG","merged":2,"otherRefs":["صحيح الجامع 1668 (صحيح)"]},{"id":"س-00560","fp":"92fdf86b45e8","stateId":71,"easy":"إذا حافظت على الصلوات الخمس ← تكفّر ما بينها","cause":"الصلواتُ الخمسُ","result":"كفارةٌ لمَّا بينَهُما ثُمَّ قال رسولُ اللهِ : أرأيْتَ لَوْ أنَّ رجلًا كان يعتملُ","explicit":true,"ref":"صحيح الترغيب 355","srcLabel":"الطبراني","text":[["الصلواتُ الخمسُ ",1],["كفارةٌ لمَّا بينَهُما ثُمَّ قال رسولُ اللهِ : أرأيْتَ لَوْ أنَّ رجلًا كان يعتملُ ",2],"، و كان بين منزلِه و بين مُعْتَمَلِه خمسَةُ أنهارٍ ، فإِذَا أتى مُعْتَمَلهُ عمل فيهِ ما شاءَ اللهُ ، فأصابَ الوسخُ أوْ العَرَقُ ، فَكلَّما مَرَّ بِنَهَرٍ اغتسلَ ما كان ذلكَ يُبْقِي من دَرَنِهِ ؟ فكذلكَ الصلاةُ ، كلمَّا عملَ خَطِيئَةً فدعَا و استغفرَ ، غُفِرَ لهُ ما كان قبلَها"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح لغيره","takhrij":"أخرجه البزار كما في ((مجمع الزوائد)) للهيثمي (1/303)، والطبراني (6/37) (5444) باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"JhYBVOPa"},{"id":"س-03386","fp":"8db56681e4f1","stateId":71,"easy":"إذا حافظت على الصلوات الخمس ← تكفّر ذنوبك ما لم تكن كبيرة مهلكة","cause":"حافِظُوا على هذه الصلواتِ الخمسِ","result":"فإنَّهُنَّ كَفَّارَاتٌ لِهَذِهِ الجِرَاحاتِ ، ما لمْ تُصِبِ المَقْتَلَةَ","explicit":true,"ref":"صحيح الترغيب 633","srcLabel":"أبو داود","text":["قال سلمانُ : ",["حافِظُوا على هذه الصلواتِ الخمسِ ، ",1],["فإنَّهُنَّ كَفَّارَاتٌ لِهَذِهِ الجِرَاحاتِ ، ما لمْ تُصِبِ المَقْتَلَةَ",2]," ، فإذا صلَّى الناسُ العِشاءَ صَدَرُوا عن ثلاثِ منازلٍ ، مِنْهُمْ مَنْ عليهِ ولا لهُ ، ومِنْهُمْ مَنْ لهُ ولا عليهِ ، ومِنْهُمْ مَنْ لا لهُ ولا عليهِ : فَرجلٌ اغْتَنَمَ ظُلْمَةَ الليلِ وغفلةَ الناسِ فركبَ فرسَهُ في المعاصِي ، فذلكَ عليهِ ولا لهُ ، ومن لهُ ولا عليهِ فَرجلٌ أغْتَنَمَ ظُلْمَةَ الليلِ وغَفْلَةَ الناسِ فقامَ يصلِّي ، فذلكَ لهُ ولا عليهِ ، ومَنْ لا لهُ ولا عليهِ : فَرجلٌ صلَّى ثُمَّ نامَ ، فذلكَ لا لهُ ولا عليهِ ، إِيَّاكَ والحَقْحَقَةَ ، وعليكَ بِالقَصْدِ ، وداومْ"],"grade":"صحيح","narrator":"طارق بن شهاب","muhaddith":"صحيح لغيره","takhrij":"أخرجه عبد الرزاق (148)، وأبو داود في ((الزهد)) (256)، والطبراني في ((المعجم الكبير)) (6/ 217) (6051) بنحوه.","bab":"استغفار › أسباب المغفرة","dorar":"r0MO4bjA"},{"id":"س-03694","fp":"40745fd5403d","stateId":71,"easy":"إذا صليت الصلاة ← تكون كفارة لما بينها وبين التي قبلها","cause":"الصَّلاةُ إلى الصَّلاةِ التي قَبلَها","result":"كَفَّارةٌ","explicit":true,"similar":["س-06535"],"ref":"تخريج المسند لشعيب 10576","srcLabel":"أحمد","text":[["الصَّلاةُ إلى الصَّلاةِ التي قَبلَها ",1],["كَفَّارةٌ",2],"، والجُمُعةُ إلى الجُمُعةِ التي قَبلَها كَفَّارةٌ، والشَّهرُ إلى الشَّهرِ الذي قَبلَهُ كَفَّارةٌ، إلَّا مِن ثلاثٍ -قال: فعَرَفْنا أنَّه أمْرٌ حدَثَ-: إلَّا مِنَ الشِّركِ باللهِ، ونَكثِ الصَّفقةِ، وتَركِ السُّنَّةِ. قال: قلنا: يا رسولَ اللهِ، هذا الشِّركُ باللهِ قد عرَفْناهُ، فما نَكثُ الصَّفقةِ، وتَركُ السُّنَّةِ؟ قال: أمَّا نَكثُ الصَّفقةِ؛ فأنْ تُعطيَ رَجُلًا بَيعَتَكَ، ثم تُقاتِلُهُ بسَيفِكَ، وأمَّا تَركُ السُّنَّةِ؛ فالخُروجُ مِن الجماعةِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح دون قوله: \"إلا من ثلاث\" إلخ","takhrij":"أخرجه أحمد (10576) واللفظ له، والحاكم (412)، والبيهقي في ((شعب الإيمان)) (3620)","bab":"اعتصام بالسنة › لزوم السنة","dorar":"ABD4mO4u"},{"id":"س-06487","fp":"2b796089554e","stateId":71,"easy":"إذا حافظت على الصلوات الخمس والجمعة واجتنبت الكبائر ← تكون كفارة لما بينهن","cause":"الصَّلَاةُ الخَمْسُ، وَالْجُمْعَةُ إلى الجُمْعَةِ","result":"كَفَّارَةٌ لِما بيْنَهُنَّ، ما لَمْ تُغْشَ الكَبَائِرُ","explicit":true,"repOf":"س-06568","ref":"عارضة الأحوذي 2/146","text":["حديث  إنَّ الصلاةَ تكفِّرُ الذنوبَ إلا الكبائرُ [يعني حديث: ",["الصَّلَاةُ الخَمْسُ، وَالْجُمْعَةُ إلى الجُمْعَةِ",1],"، ",["كَفَّارَةٌ لِما بيْنَهُنَّ، ما لَمْ تُغْشَ الكَبَائِرُ",2],".]"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"صحيح","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"kJTgGYRL"},{"id":"س-06503","fp":"04e9277a9f0a","stateId":71,"easy":"إذا صليت الصلاة بعد الصلاة واجتنبت الكبائر ← تكون كفارة لما بينهما","cause":"إنَّ الصَّلاةَ إلى الصَّلاةِ","result":"كفَّارةٌ لِما بينهما ما اجتنِبَتِ الكبائرُ","explicit":true,"apply":{"k":"time","t":"دبر كل صلاة"},"ref":"فتح الباري لابن حجر 8/208","srcLabel":"فتح الباري لابن حجر","text":[["إنَّ الصَّلاةَ إلى الصَّلاةِ ",1],["كفَّارةٌ لِما بينهما ما اجتنِبَتِ الكبائرُ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"FfJSGpaW"},{"id":"س-06533","fp":"65a11017d04c","stateId":71,"easy":"إذا صليت الخمس وحججت البيت وصمت رمضان ← كان حقاً على الله أن يغفر لك","cause":"مَن صَلَّى الصَّلَواتِ الخَمسَ، وحَجَّ البَيتَ، وصام رَمضانَ","result":"كان حَقًّا على اللهِ أنْ يَغفِرَ له","explicit":true,"apply":{"k":"time","t":"في رمضان"},"ref":"تخريج المسند لشعيب 22087","srcLabel":"الترمذي","text":[["مَن صَلَّى الصَّلَواتِ الخَمسَ، وحَجَّ البَيتَ، وصام رَمضانَ",1]," -ولا أدري أذَكَرَ الزَّكاةَ أم لا؟- ",["كان حَقًّا على اللهِ أنْ يَغفِرَ له",2]," إنْ هاجَرَ في سَبيلِه، أو مَكَثَ بأرضِه التي وُلِدَ بها، فقال مُعاذٌ: يا رسولَ اللهِ، أفأُخبِرُ النَّاسَ؟ قال: ذَرِ النَّاسَ يا مُعاذُ، في الجنَّةِ مِئةُ دَرَجةٍ، ما بيْنَ كلِّ دَرَجتَينِ مِئةُ سَنةٍ، والفِردَوسُ أعلى الجنَّةِ وأَوسطُها، ومنها تَفجَّرُ أنهارُ الجنَّةِ، فإذا سَأَلتُم اللهَ فاسأَلوه الفِردَوسَ."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2530) باختلاف يسير، وابن ماجه (4331) مختصراً، وأحمد (22087) واللفظ له","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"3EFOnLpI"},{"id":"س-06534","fp":"334492b649f4","stateId":71,"easy":"إذا صليت ← تحطّ كل صلاة ما بين يديها من خطيئة","cause":"إنَّ كُلَّ صَلاةٍ","result":"تَحُطُّ ما بيْنَ يَدَيها من خَطيئةٍ","explicit":true,"ref":"تخريج المسند لشعيب 23503","srcLabel":"أحمد","text":[["إنَّ كُلَّ صَلاةٍ ",1],["تَحُطُّ ما بيْنَ يَدَيها من خَطيئةٍ",2],"."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (23503) واللفظ له، والطبراني (4/127) (3881)، وتمام في ((الفوائد)) (1259)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"3faFZqRC"},{"id":"س-06535","fp":"ed339387b6c2","stateId":71,"easy":"إذا صليت المكتوبة ← تكون كفارة لما بينها وبين التي بعدها","cause":"الصَّلاةُ المكتوبةُ إلى الصَّلاةِ التي بَعدَها","result":"كفَّارةٌ لِما بَيْنَهما","explicit":true,"repOf":"س-03694","ref":"تخريج المسند لشعيب 7129","text":[["الصَّلاةُ المكتوبةُ إلى الصَّلاةِ التي بَعدَها ",1],["كفَّارةٌ لِما بَيْنَهما",2],"، قال: والـجُمُعةُ إلى الـجُمُعةِ، والشَّهرُ إلى الشَّهرِ -يَعْني رَمَضانَ إلى رَمَضانَ- كفَّارةٌ لِما بَيْنَهما، قال: ثم قال بعدَ ذلك: إلَّا مِن ثَلاثٍ -قال: فعَرَفتُ أنَّ ذلك لأَمْرٍ حَدَث-: إلَّا مِنَ الإشراكِ باللهِ، ونَكْثِ الصَّفْقةِ، وتَرْكِ السُّنَّةِ، قال: أمَّا نَكْثُ الصَّفْقةِ: أنْ تُبايِعَ رَجُلًا، ثم تُـخالِفَ إليه تُقاتِلُه بِسيفِك، وأما تَرْكُ السُّنَّةِ قال: قُلتُ: يا رسولَ اللهِ، أمَّا الإشراكُ باللهِ فقد عَرَفْناه، فما نَكْثُ الصَّفْقةِ؟ قال: فأنْ تُبايِعَ رَجُلًا ثم تُـخالِفَ إليه تُقاتِلُه بسَيفِك، وأمَّا تَرْكُ السُّنَّةِ فالـخُروجُ مِن الـجَماعةِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح دون قوله: إلا من ثلاث ... إلى آخر الحديث","takhrij":"أخرجه أحمد (7129) واللفظ له، والحاكم (412)، والبيهقي في ((شعب الإيمان)) (3620)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"dRf9RxIn"},{"id":"س-06623","fp":"82e8cbc9c5d5","stateId":71,"easy":"إذا قمت تصلي ← تُجعل ذنوبك على رأسك وعاتقك فتتساقط كلما ركعت وسجدت","cause":"إذا قامَ العبدُ يصلِّي أتى بذُنوبِهِ ، فجَعلتُ علَى رأسِهِ وعاتقَهِ ، فَكُلَّما رَكَعَ أو سَجدَ","result":"تساقَطَت عنهُ","explicit":true,"ref":"نخب الافكار 7/222","srcLabel":"ابن حبان","text":["أنَّ عبدَ اللَّهِ بنَ عمرَ ، رأى فتًا وَهوَ يصلِّي قد أطالَ صلاتَهُ . فلمَّا انصرفَ منها قالَ: مَن يعرفُ هذا قالَ رجلٌ أَنا ، فقالَ عبدُ اللَّهِ: لو كُنتُ أعرفُهُ لأمرتُهُ أن يُطيلَ الرُّكوعَ والسُّجودَ ، فإنِّي سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ: ",["إذا قامَ العبدُ يصلِّي أتى بذُنوبِهِ ، فجَعلتُ علَى رأسِهِ وعاتقَهِ ، فَكُلَّما رَكَعَ أو سَجدَ ، ",1],["تساقَطَت عنهُ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح معاني الآثار)) (2732) واللفظ له، وابن حبان (1734)، والطبراني (13/316) (14108) باختلاف يسير","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"eaahZgcF"},{"id":"س-03699","fp":"4ba7da0d506a","stateId":71,"easy":"إذا قمت إلى الصلاة ← تتحاتّ عنك خطاياك كما يتحاتّ ورق الشجر","cause":"إنَّ العَبدَ المُسلِمَ إذا قامَ إلى الصلاةِ","result":"تَحاتَّتْ عنه خَطاياهُ كما تَحاتُّ وَرَقُ هذه الشَّجَرةِ","explicit":true,"repOf":"س-06634","ref":"تخريج المسند لشعيب 23716","text":["كنَّا مع سَلْمانَ تَحتَ شجَرةٍ، فأخَذَ غُصْنًا منها فنَفَضَه فتَساقَطَ ورَقُه، فقال: ألَا تَسْألوني عمَّا صَنَعتُ؟ فقُلْنا: أخْبِرْنا، فقال: كنَّا مع رسولِ اللهِ صلَّى اللهُ عليه وسَلَّمَ في ظِلِّ شجَرةٍ فأخَذَ غُصْنًا منها فنَفَضَه فتَساقَطَ ورَقُه، فقال: ألَا تَسْألوني عمَّا صَنَعتُ؟ فقُلْنا: أخْبِرْنا يا رسولَ اللهِ، فقال: ",["إنَّ العَبدَ المُسلِمَ إذا قامَ إلى الصلاةِ، ",1],["تَحاتَّتْ عنه خَطاياهُ كما تَحاتُّ وَرَقُ هذه الشَّجَرةِ",2],"."],"grade":"حسن","narrator":"سلمان الفارسي","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (23716) واللفظ له، والطيالسي (687)، ومحمد بن نصر المروزي في ((تعظيم قدر الصلاة)) (83)","bab":"اعتصام بالسنة › لزوم السنة","dorar":"ErfWDlBk"},{"id":"س-04749","fp":"bba047653425","stateId":71,"easy":"إذا صليت تريد وجه الله ← تتساقط عنك ذنوبك كما يتساقط ورق الشجر","cause":"لَيُصلِّي الصَّلاةَ، يُريدُ بها وَجهَ اللهِ","result":"فتَهافَتُ عنه ذُنوبُه، كما يَتَهافَتُ هذا الوَرَقُ عن هذه الشجَرةِ","explicit":true,"ref":"تخريج المسند لشعيب 21556","srcLabel":"أحمد","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ خرَجَ زمنَ الشتاءِ والوَرَقُ يَتَهافَتُ، فأخَذَ بغُصنَيْنِ من شَجرةٍ، قال: فجعَلَ ذلك الورَقُ يَتَهافَتُ، قال: فقال: يا أبا ذَرٍّ، قُلْتُ: لبَّيْكَ يا رسولَ اللهِ، قال: إنَّ العَبدَ المُسلِمَ ",["لَيُصلِّي الصَّلاةَ، يُريدُ بها وَجهَ اللهِ",1],"، ",["فتَهافَتُ عنه ذُنوبُه، كما يَتَهافَتُ هذا الوَرَقُ عن هذه الشجَرةِ",2],"."],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (21556)","bab":"رقائق وزهد › الإخلاص","dorar":"wBGN2JuL"},{"id":"س-06509","fp":"c01805327d05","stateId":71,"easy":"إذا صليت في آخر الوقت ← فهو عفو الله (وأوله رضوانه)","cause":"والوقتُ الآخِرُ","result":"عفوُ اللَّهِ","explicit":true,"ref":"هداية الرواة 1/297","srcLabel":"الترمذي","text":["الوقتُ الأوَّلُ منَ الصَّلاةِ رضوانُ اللَّهِ ",["والوقتُ الآخِرُ",1]," ",["عفوُ اللَّهِ",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه الترمذي (172) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (7/148)، والبيهقي (2131) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"bOC7wao8"},{"id":"س-06556","fp":"191bccab3b41","stateId":71,"easy":"إذا أقمت الصلاة وآتيت الزكاة ومت لا تشرك بالله ← كان حقاً على الله أن يغفر لك","cause":"مَن أقامَ الصَّلاةَ ، وآتى الزَّكاةَ ، وماتَ لا يشرِكُ باللَّهِ شيئًا","result":"كانَ حقًّا على اللَّهِ عزَّ وجلَّ أن يغفِرَ لَهُ هاجرًا وماتَ في مولدِهِ فقُلنا : يا رسولَ اللَّهِ ، ألا نخبرُ بِها النَّاسَ فيستبشِروا بِها","explicit":true,"ref":"صحيح النسائي 3132","srcLabel":"النسائي","text":[["مَن أقامَ الصَّلاةَ ، وآتى الزَّكاةَ ، وماتَ لا يشرِكُ باللَّهِ شيئًا ، ",1],["كانَ حقًّا على اللَّهِ عزَّ وجلَّ أن يغفِرَ لَهُ هاجرًا وماتَ في مولدِهِ فقُلنا : يا رسولَ اللَّهِ ، ألا نخبرُ بِها النَّاسَ فيستبشِروا بِها ",2],"؟ فقالَ : إنَّ للجنَّةِ مائةَ درجةٍ ، بينَ كلِّ درجتينِ كما بينَ السَّماءِ والأرضِ ، أعدَّها اللَّهُ للمجاهِدينَ في سبيلِهِ ، ولولا أن أشقَّ على المؤمنينَ ، ولا أجدُ ما أحملُهُم علَيهِ ، ولا تَطيبُ أنفسُهُم أن يتخلَّفوا بعدي ، ما قعدتُ خلفَ سريَّةٍ ، ولوَدِدْتُ أن أُقتَلُ ، ثمَّ أُحيا ، ثمَّ أُقتَلُ"],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"إسناده حسن","takhrij":"أخرجه النسائي (3132)، والطبراني في ((الشاميين)) (1200)، وابن عساكر في ((تاريخ دمشق)) (52/ 135) واللفظ لهم.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"RrtkuYT1"},{"id":"س-06588","fp":"1a3bf67378eb","stateId":71,"easy":"إذا حافظت على الصلوات الخمس ← تطهرك كنهر تغتسل فيه خمس مرات","cause":"الصلواتِ الخمسِ","result":"كمَثَلِ نَهرٍ جارٍ ببابِ أحَدِكم، يَغتسِلُ منه كلَّ يومٍ خَمسَ مرَّاتٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"similar":["س-00549"],"ref":"تذكرة الحفاظ 287","srcLabel":"مسلم","text":["مَثَلُ ",["الصلواتِ الخمسِ",1]," [يعني حديث:  مَثَلُ الصَّلواتِ الخَمسِ المكتوباتِ، ",["كمَثَلِ نَهرٍ جارٍ ببابِ أحَدِكم، يَغتسِلُ منه كلَّ يومٍ خَمسَ مرَّاتٍ",2],".]"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه مسلم (668) مطولاً","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"zhKTl64F","merged":5,"otherRefs":["معجم الشيوخ 1/393 (حسن)","تخريج المسند لشعيب 9692 (صحيح)","تخريج المسند لشعيب 14853 (صحيح)","التمهيد 24/228 (صحيح)"]},{"id":"س-00549","fp":"410dd7081e90","stateId":71,"easy":"إذا حافظت على الصلوات الخمس ← تُطهّرك كما يطهّر النهر من اغتسل فيه خمساً","cause":"مَثلُ الصَّلاةِ","result":"كمَثلِ نَهَرٍ جارٍ ببابِ رجلٍ غَمرٍ عذبٍ يقتحمُ فيهِ كلَّ يومٍ خمسَ مرَّاتٍ فما ترونَ ذلِكَ يُبقي مِن درنِهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-06588","ref":"صحيح ابن خزيمة 1/ 413","text":["سَمِعْتُ سعدًا وَناسًا مِن أصحابِ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولونَ: كانَ رجلانِ أخَوانِ في عَهْدِ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ، وَكانَ أحدُهُما أفضلَ منَ الآخرِ، فتوُفِّيَ الَّذي هوَ أفضلُهُما، ثمَّ عُمِّرَ الآخرُ بعدَهُ أربَعينَ ليلةً ثمَّ توُفِّيَ، فذُكِرَ لرَسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فضيلةُ الأوَّلِ على الآخَرِ، فقالَ: ألم يَكُن يصلِّي؟ قالوا: بلَى يا رسولَ اللَّهِ، وَكانَ لا بأسَ بِهِ قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: فما يُدريكُم ماذا بلغَت بِهِ صلاتُهُ؟ إنَّما ",["مَثلُ الصَّلاةِ",1]," ",["كمَثلِ نَهَرٍ جارٍ ببابِ رجلٍ غَمرٍ عذبٍ يقتحمُ فيهِ كلَّ يومٍ خمسَ مرَّاتٍ فما ترونَ ذلِكَ يُبقي مِن درنِهِ",2]," لا تَدرونَ ماذا بلغَت بِهِ صلاتُهُ"],"grade":"صحيح","narrator":"سعد بن أبي وقاص وناس من أصحاب رسول الله","muhaddith":"أخرجه في صحيحه","bab":"آداب عامة › ضرب الأمثال","dorar":"b4WGGPe6","merged":2,"otherRefs":["صحيح الترغيب 371 (صحيح)"]},{"id":"س-06494","fp":"b86b13babfa4","stateId":71,"easy":"إذا أذنبت ثم صليت ← تغسل الصلاة ذنوبك","cause":"فإذا صلَّيتُم الصُّبحَ","result":"غَسَلَتْها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الترغيب 357","srcLabel":"الطبراني","text":["تحترِقونَ تحترِقونَ ، ",["فإذا صلَّيتُم الصُّبحَ",1]," ",["غَسَلَتْها",2]," ، ثمَّ تحترِقونَ تحترِقونَ ، فإذا صلَّيتُم الظُّهرَ غَسَلَتْها ، ثمَّ تحترِقونَ تحترِقونَ ، فإذا صلَّيتُم العصرَ غَسَلَتْها ، ثمَّ تحترِقونَ تحترِقونَ ، فإذا صلَّيتُم المَغربَ غَسَلَتْها ، ثمَّ تحترِقونَ تحترِقونَ ، فإذا صلَّيتُم العِشاءَ غَسَلَتْها ، ثمَّ تنامونَ فلا يُكْتَبُ عليكُم حتَّى تستَيقِظُوا"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"حسن صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (2224)، والخطيب في ((تاريخ بغداد)) (2091) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"Egi9O2TT"},{"id":"س-06573","fp":"421370c59010","stateId":72,"easy":"إذا صليت الفجر ثم قعدت في مكانك لا تلغو بأمر الدنيا تذكر الله ← تخرج من ذنوبك كيوم ولدتك أمك","cause":"مَن صلَّى الفجرَ ، أو قال الغداةَ ، فقعَد مقعَدَه فلم يَلغُ بشيءٍ مِن أمرِ الدنيا ، ويذكر اللهَ حتى يُصلِّيَ الضُّحى أربعَ ركعاتٍ","result":"خرَج مَن ذنوبِه كيومِ ولدَتْه أمُّه لا ذنبَ له","explicit":true,"ref":"إتحاف الخيرة المهرة 6/391","srcLabel":"الطبراني","text":[["مَن صلَّى الفجرَ ، أو قال الغداةَ ، فقعَد مقعَدَه فلم يَلغُ بشيءٍ مِن أمرِ الدنيا ، ويذكر اللهَ حتى يُصلِّيَ الضُّحى أربعَ ركعاتٍ",1]," ، ",["خرَج مَن ذنوبِه كيومِ ولدَتْه أمُّه لا ذنبَ له",2]],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده حسن","takhrij":"أخرجه أبو يعلى (4365) واللفظ له، والطبراني في ((المعجم الأوسط)) (5940) مختصراً","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"pYJAZCYD"},{"id":"س-02317","fp":"70596b31199b","stateId":72,"easy":"إذا صليت صلاة التسبيح (أربع ركعات بخمسة وسبعين تسبيحة في كل ركعة) ← يُغفر لك ولو كانت ذنوبك مثل زبد البحر","cause":"فذلك خَمْسةٌ وسَبْعونَ، تَفعَلُ ذلك في أرْبَعِ رَكَعاتٍ","result":"فلو كانَتْ ذُنوبُك مِثلَ زَبَدِ البَحْرِ أو رَمْلِ عالِجٍ غَفَرَ اللهُ لك","explicit":true,"apply":{"k":"count","t":"أربع ركعات"},"ref":"الأحاديث المختارة 11 / 328","srcLabel":"متفق عليه","text":["«أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قالَ للعبَّاسِ: يا عَمَّاه، أَلَا أُعْطيك، أَلَا أَمْنَحُك، أَلَا أُجيزُك، أَلَا أَفعَلُ بك عَشْرَ خِصالٍ إذا أنت فَعَلْتَ ذلك غَفَرَ اللهُ لك ذَنْبَك؛ أوَّلَه وآخِرَه، قَديمَه وحَديثَه، سِرَّه وعَلانِيَتَه، صَغيرَه وكَبيرَه، خَطَأَه وعَمْدَه؛ أن تُصَلِّيَ أرْبَعَ رَكَعاتٍ، تَقرَأُ في كلِّ رَكْعةٍ مِنها بفاتِحةِ الكِتابِ وسورةٍ، فإذا فَرَغْتَ مِن القِراءةِ أوَّلَ رَكْعةٍ، قُلْتَ وأنت قائِمٌ: سُبْحانَ اللهِ والحَمْدُ للهِ، ولا إلهَ إلَّا اللهُ واللهُ أَكبَرُ، خَمْسَ عَشْرةَ مَرَّةً، ثُمَّ تَركَعُ فتَقولُ وأنت راكِعٌ عَشْرًا، ثُمَّ تَرفَعُ رَأسَك فتقولُ وأنت قائِمٌ عَشْرًا، ثُمَّ تَسجُدُ فتَقولُها عَشْرًا، ثُمَّ تَرفَعُ رَأسَك فتقولُ وأنت جالِسٌ عَشْرًا، ثُمَّ تَسجُدُ فتَقولُها عَشْرًا، ثُمَّ تَرفَعُ رَأسَك فتَقولُها عَشْرًا، ",["فذلك خَمْسةٌ وسَبْعونَ، تَفعَلُ ذلك في أرْبَعِ رَكَعاتٍ",1],"، ",["فلو كانَتْ ذُنوبُك مِثلَ زَبَدِ البَحْرِ أو رَمْلِ عالِجٍ غَفَرَ اللهُ لك",2],"». \nلَفْظُ عيسى بنِ القاسِمِ.\n- ولَفْظُ ابنِ خُزَيْمةَ، أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قالَ للعبَّاسِ بنِ عَبْدِ المُطَّلِبِ: يا عبَّاسُ يا عَمَّاه، أَلَا أُعْطيك، أَلَا أُجيزُك، أَلَا أَفعَلُ لك عَشْرَ خِصالٍ إذا أنت فَعَلْتَ ذلك غَفَرَ اللهُ لك ذَنَبَك، أوَّلَه وآخِرَه، قَديمَه وحَديثَه، خَطَأَه وعَمْدَه، تَقرَأُ بفاتِحةِ الكِتابِ وسورةٍ، فإذا فَرَغْتَ مِن القِراءةِ في كلِّ رَكْعةٍ قُلْتَ وأنت قائِمٌ: سُبْحانَ اللهِ والحَمْدُ للهِ ولا إلهَ إلَّا اللهُ واللهُ أَكبَرُ خَمْسَ عَشْرةَ مَرَّةً، ثُمَّ تَركَعُ فتَقولُها وأنت راكِعٌ عَشْرًا، ثُمَّ تَرفَعُ رَأسَك مِن الرُّكوعِ فتَقولُها عَشْرًا، ثُمَّ تَسجُدُ فتَقولُها عَشْرًا، ثُمَّ تَرفَعُ رَأسَك فتَقولُها عَشْرًا، ثُمَّ تَسجُدُ فتَقولُها عَشْرًا، ثُمَّ تَرفَعُ رَأسَك فتَقولُها عَشْرًا، فذلك خَمْسٌ وسَبْعونَ في كلِّ رَكْعةٍ تَفعَلُ في أرْبَعِ رَكَعاتٍ إن اسْتَطَعْتَ أن تُصَلِّيَها في كلِّ يَوْمٍ مَرَّةً فافْعَلْ، فإن لم تَفعَلْ ففي كلِّ جُمُعةٍ مَرَّةً، فإن لم تَفعَلْ ففي كلِّ شَهْرٍ مَرَّةً، فإن لم تَفعَلْ ففي كلِّ سَنَةٍ مَرَّةً، فإن لم تَفعَلْ ففي عُمرِك مَرَّةً.\nوفي رواية أبي يعلى إسحاق .... بفاتحة الكتاب، ثُمَّ ترفع رأسك"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"e2TDwWJm"},{"id":"س-08374","fp":"c11fec390e0b","stateId":72,"easy":"إذا قمت فحمدت الله وأثنيت عليه وركعت ركعتين ← تخرج من ذنوبك كيوم ولدتك أمك","cause":"ثمَّ يَقومُ فيَحمَدُ اللهَ عزَّ وجلَّ ويُثْني عليه بالذي هو له أهْلٌ، ثمَّ يَركَعُ ركْعتَينِ","result":"إلَّا خرَجَ مِن ذُنوبِه كهَيئتِه يَومَ ولَدَتْهُ أُمُّه","explicit":true,"apply":{"k":"count","t":"ركعتين"},"ref":"تخريج المسند لشعيب 17019","srcLabel":"مسلم","text":["إنِّي كنتُ في الجاهِليَّةِ أَرى الناسَ على ضَلالةٍ، ولا أَرى الأَوثانَ شَيئًا، ثمَّ سمِعتُ عن رجُلٍ يُخبِرُ أخبارَ مكَّةَ، ويُحَدِّثُ أحاديثَ، فرَكِبْتُ راحِلَتي حتى قَدِمْتُ مكَّةَ، فإذا أنا برسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ مُستَخْفٍ، وإذا قَومُه عليه جُرَآءُ، فتلَطَّفْتُ له، فدخَلْتُ عليه، فقلْتُ: ما أنت؟ قال: أنا نَبيُّ اللهِ، فقلْتُ: وما نَبيُّ اللهِ؟ قال: رسولُ اللهِ، قال: قلْتُ: آللهُ أَرسَلَك؟ قال: نعَمْ، قلْتُ: بأيِّ شَيءٍ أَرسَلَك؟ قال: بأنْ يُوحَّدَ اللهُ ولا يُشرَكَ به شَيءٌ، وكَسرِ الأَوثانِ، وصِلَةِ الرَّحِمِ. فقلْتُ له: مَن معك على هذا؟ قال: حُرٌّ وعبْدٌ، أو: عبْدٌ وحُرٌّ. وإذا معه أبو بكرِ بنُ أبي قُحافةَ، وبِلالٌ مَوْلى أبي بكرٍ. قلْتُ: إنِّي مُتَّبِعُك، قال: إنَّك لا تَستطيعُ ذلك يَومَك هذا، ولكنِ ارجِعْ إلى أهْلِك، فإذا سمِعتَ بي قد ظهَرْتُ فالْحَقْ بي. قال: فرجَعْتُ إلى أهْلي وقد أَسلَمْتُ، فخرَجَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ مُهاجِرًا إلى المدينةِ، فجعَلْتُ أَتخَبَّرُ الأخبارَ، حتى جاء رَكَبةٌ مِن يَثْرِبَ، فقلْتُ: ما هذا المَكِّيُّ الذي أَتاكم؟ قالوا: أراد قَومُه قَتْلَه، فلمْ يَستطيعوا ذلك، وحِيلَ بيْنهم وبيْنه، وتَرَكْنا الناسَ سِراعًا. قال عَمرُو بنُ عَبَسةَ: فرَكِبتُ راحِلَتي حتى قَدِمتُ عليه المدينةَ، فدخَلْتُ عليه، فقلْتُ: يا رسولَ اللهِ، أتَعْرِفُني؟ قال: نعَمْ، ألَسْتَ أنت الذي أَتَيْتَني بمكَّةَ؟ قال: قلْتُ: بلى، فقلْتُ: يا رسولَ اللهِ، عَلِّمْني ممَّا علَّمَك اللهُ وأَجهَلُ، قال: إذا صَلَّيْتَ الصبحَ فأَقْصِرْ عنِ الصلاةِ حتى تَطلُعَ الشمسُ، فإذا طلَعَتْ فلا تُصَلِّ حتى تَرتفِعَ؛ فإنَّها تَطلُعُ حينَ تَطلُعُ بيْن قَرْنَيْ شَيطانٍ، وحينَئذٍ يَسجُدُ لها الكفَّارُ، فإذا ارتفَعَتْ قِيدَ رُمحٍ أو رُمحَينِ فصَلِّ؛ فإنَّ الصلاةَ مَشْهودةٌ مَحْضورةٌ حتى يَستقِلَّ الرُّمحُ بالظِّلِّ، ثمَّ أَقصِرْ عنِ الصلاةِ؛ فإنَّها حينَئذٍ تُسجَرُ جَهنَّمُ، فإذا فاءَ الفَيءُ فصَلِّ؛ فإنَّ الصلاةَ مَشْهودةٌ مَحْضورةٌ حتى تُصلِّيَ العصرَ، فإذا صَلَّيْتَ العصرَ فأَقصِرْ عنِ الصلاةِ حتى تَغرُبَ الشمسُ؛ فإنَّها تَغرُبُ حينَ تَغرُبُ بيْن قَرْنَيْ شَيطانٍ، وحينَئذٍ يَسجُدُ لها الكفَّارُ. \nقلْتُ: يا نَبيَّ اللهِ، أَخبِرْني عنِ الوُضوءِ؟ قال: ما منكم مِن أحَدٍ يُقَرِّبُ وَضوءَه ثمَّ يَتمَضْمَضُ ويَستنشِقُ ويَنتَثِرُ، إلَّا خَرَّتْ خَطاياهُ مِن فَمِه وخَياشيمِه مع الماءِ حين يَنتَثِرُ، ثمَّ يَغسِلُ وَجْهَه كما أمَرَه اللهُ تعالى، إلَّا خَرَّتْ خَطايا وجْهِه مِن أَطرافِ لِحيتِه مع الماءِ، ثمَّ يَغسِلُ يدَيهِ إلى المِرفقَينِ، إلَّا خَرَّتْ خَطايا يدَيهِ مِن أَطرافِ أَنامِلِه، ثمَّ يَمسَحُ رأسَه، إلَّا خَرَّتْ خَطايا رأسِه مِن أَطرافِ شَعَرِه مع الماءِ، ثمَّ يَغسِلُ قَدَمَيهِ إلى الكَعبَينِ كما أمَرَه اللهُ عزَّ وجلَّ، إلَّا خَرَّتْ خَطايا قدَمَيهِ مِن أَطرافِ أصابِعِه مع الماءِ، ",["ثمَّ يَقومُ فيَحمَدُ اللهَ عزَّ وجلَّ ويُثْني عليه بالذي هو له أهْلٌ، ثمَّ يَركَعُ ركْعتَينِ",1],"؛ ",["إلَّا خرَجَ مِن ذُنوبِه كهَيئتِه يَومَ ولَدَتْهُ أُمُّه",2],". قال أبو أُمامةَ: يا عَمرُو بنَ عَبَسةَ، انظُرْ ما تقولُ، أسمِعتَ هذا مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ أَيُعطى هذا الرَّجُلُ كلَّه في مَقامِه؟! قال: فقال عَمرُو بنُ عَبَسةَ: يا أبا أُمامةَ، لقد كَبِرَتْ سِنِّي، ورَقَّ عَظْمي، واقتَرَبَ أجَلي، وما بي مِن حاجةٍ أنْ أَكذِبَ على اللهِ عزَّ وجلَّ وعلى رسولِه، لو لم أَسمَعْهُ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ إلَّا مرَّةً أو مرَّتَينِ أو ثلاثًا، لقد سمِعتُه سبْعَ مرَّاتٍ أو أَكثَرَ مِن ذلك."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"إسناد صحيح على شرط مسلم","takhrij":"أخرجه أحمد (17019) واللفظ له، وابن أبي عاصم في ((الآحاد والمثاني)) (1330)، والطبراني في ((مسند الشاميين)) (863)","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"EMlQpOzh","merged":2,"otherRefs":["تخريج سنن الدارقطني 378 (صحيح)"]},{"id":"س-01405","fp":"46885e359f7d","stateId":72,"easy":"إذا سجدت لله بعد الوضوء ← تخرج من خطاياك كيوم ولدتك أمك","cause":"فإن أنتَ وضعتَ وجهَكَ للَّهِ عزَّ وجلَّ","result":"خرجْتَ مِن خطاياكَ كيومِ ولدَتكَ أمُّكَ","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"ref":"صحيح النسائي 147","srcLabel":"مسلم","text":["يا رسولَ اللَّهِ ! كيفَ الوضوءُ ؟ قالَ أمَّا الوضوءُ فإنَّكَ إذا تَوضَّأتَ فغَسلتَ كفَّيكَ فأنقَيتَهُما خرجَت خطاياكَ مِن بينِ أظفارِكَ وأناملِكَ فإذا مضمضتَ واستنشقتَ منخَرَيكَ وغسلتَ وجهَكَ ويدَيكَ إلى المرفقَينِ ومسحتَ رأسَكَ وغسَلتَ رجلَيكَ إلى الكعبَينِ اغتسَلتَ مِن عامَّةِ خطاياكَ ",["فإن أنتَ وضعتَ وجهَكَ للَّهِ عزَّ وجلَّ",1]," ",["خرجْتَ مِن خطاياكَ كيومِ ولدَتكَ أمُّكَ",2]],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (147) واللفظ له، ومسلم (832)، والحاكم (584) بنحوه مطولًا.","bab":"وضوء › صفة الوضوء","dorar":"CLXVQb2e"},{"id":"س-03324","fp":"428a1b66f28b","stateId":72,"easy":"إذا صليت أربع ركعات (صلاة التسبيح) ← يغفر الله لك ولو كانت ذنوبك مثل رمل عالج","cause":"صلِّ أربعَ رَكعاتٍ تقرأُ في كلِّ رَكعةٍ","result":"ولو كانَت ذنوبُكَ مثلَ رملِ عالجٍ غفرَها اللَّهُ لَكَ","explicit":true,"apply":{"k":"count","t":"أربع ركعات"},"ref":"صحيح الترمذي 482","srcLabel":"الترمذي","text":["قالَ رسولُ اللهِ صلَّى اللَّهُ عليْهِ وسلَّمَ للعبَّاسِ: يا عمِّ ألا أصلُكَ، ألا أحبوكَ، ألا أنفعُكَ، قالَ: بلى يا رسولَ اللهِ، قالَ: يا عمِّ، ",["صلِّ أربعَ رَكعاتٍ تقرأُ في كلِّ رَكعةٍ",1]," بفاتحةِ الكتابِ وسورةٍ، فإذا انقَضتِ القراءةُ، فقلِ: اللَّهُ أَكبرُ، والحمدُ للَّهِ، وسبحانَ اللهِ، خمسَ عشرةَ مرَّةً قبلَ أن ترْكعَ، ثمَّ ارْكع فقُلْها عشرًا، ثمَّ ارفع رأسَكَ فقُلْها عشرًا، ثمَّ اسجُد فقُلْها عشرًا، ثمَّ ارفع رأسَكَ فقُلْها عشرًا، ثمَّ اسجُد فقُلْها عشرًا، ثمَّ ارفع رأسَكَ فقُلْها عشرًا قبلَ أن تقومَ، فذلكَ خمسٌ وسبعونَ في كلِّ رَكعةٍ وَهيَ ثلاثُ مائةٍ في أربعِ رَكعاتٍ، ",["ولو كانَت ذنوبُكَ مثلَ رملِ عالجٍ غفرَها اللَّهُ لَكَ",2],"، قالَ: يا رسولَ اللهِ، ومن يَستطيعُ أن يقولَها في يومٍ، قالَ: إن لم تَستطِع أن تقولَها في يومٍ فقلْها في جمعةٍ، فإن لم تستطع أن تقولَها في جمعةٍ فقلْها في شَهرٍ، فلم يزل يقولُ لَهُ، حتَّى قالَ: فقلْها في سنَةٍ ."],"grade":"صحيح","narrator":"أبو رافع مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (482)، وابن ماجة (1386)، والروياني في ((مسنده)) (699) واللفظ لهم.","bab":"استغفار › أسباب المغفرة","dorar":"jkgDuKYM","merged":2,"otherRefs":["صحيح الترغيب 678 (صحيح)"]},{"id":"س-01009","fp":"7d1765f1bdee","stateId":72,"easy":"إذا صليت أربع ركعات بعد الزوال ← يُغفر لك ولو كنت أعظم الناس ذنباً","cause":"إذا زالَ النَّهارُ فقُم فصلِّ أربعَ رَكَعاتٍ","result":"فإنَّكَ لَو كنتَ أعظمَ أهْلِ الأرضِ ذنبًا غُفِرَ لَكَ بذلِكَ","explicit":true,"apply":{"k":"count","t":"أربع ركعات"},"ref":"صحيح أبي داود 1298","srcLabel":"أبو داود","text":["أنَّ عبدَ اللَّهِ بنَ عمرٍو قالَ : قالَ لي النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ ائتِني غدًا أحبوكَ وأثيبُكَ وأعطيك حتَّى ظنَنتُ أنَّهُ يعطيني عطيَّةً قالَ ",["إذا زالَ النَّهارُ فقُم فصلِّ أربعَ رَكَعاتٍ",1]," فذكرَ نحوَهُ قالَ ثمَّ ترفعُ رأسَكَ يعني منَ السَّجدةِ الثَّانيةِ فاستَوِ جالسًا ولا تقم حتَّى تسبِّحَ عشرًا وتحمدَ عشرًا وتُكَبِّرَ عشرًا وتُهَلِّلَ عشرًا ثمَّ تصنعَ ذلِكَ في الأربعِ الرَّكعات قالَ ",["فإنَّكَ لَو كنتَ أعظمَ أهْلِ الأرضِ ذنبًا غُفِرَ لَكَ بذلِكَ",2]," قلتُ فإن لم أستطِعْ أن أصلِّيَها تلكَ السَّاعةَ قالَ صلِّها منَ اللَّيلِ والنَّهارِ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"حسن صحيح","takhrij":"أخرجه أبو داود (1298) واللفظ له، والبيهقي في ((شعب الإيمان)) (611) مطولاً بنحوه","bab":"أدعية وأذكار › فضل الذكر","dorar":"RbAkIgvG"},{"id":"س-01452","fp":"ae84335ca60b","stateId":72,"easy":"إذا قمت فذكرت ربك وحمدته وصليت ركعتين بقلب حاضر ← تخرج من خطاياك كيوم ولدتك أمك","cause":"وإنْ قُمْتَ فَذَكَرْتَ رَبَّكَ، وحَمِدْتَه، ورَكَعتَهُ ركْعَتَيْنِ مُقْبِلًا عليهما بِقَلْبِكَ","result":"كُنْتَ مِنْ خَطاياكَ كَيَوْمِ وَلَدَتْكَ أُمُّكَ","explicit":true,"apply":{"k":"count","t":"ركعتين"},"ref":"المستدرك على الصحيحين 594","srcLabel":"أحمد","text":["أَتَيْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ في أَوَّلِ ما بُعِثَ وهو بِمكَّةَ، وهو حينَئذٍ مُسْتَخْفٍ، فقلتُ: ما أنتَ؟ قالَ: «أنا نَبيٌّ». قُلتُ: وما نَبيٌّ؟ قالَ: «رسولُ اللَّهِ». قلتُ: آللهُ أَرْسَلَكَ؟ قالَ: «نعم». قُلتُ: بما أَرْسَلَكَ؟ قالَ: «أنْ تَعْبُدَ اللَّهَ، وتَكْسِرَ الأَوْثانَ والأَدْيانَ، وتوصِلَ الأَرْحامَ». قُلْتُ: نِعْمَ ما أَرْسَلَكَ به. قُلْتُ: فَمَنْ يَتَّبِعُكَ على هذا؟ قالَ: «عَبْدٌ وحُرٌّ» -يعني أَبا بَكْرٍ وبِلالًا- فكان عَمرٌو يقولُ: لقد رَأَيْتُني وأَنا رُبْعُ –أَوْ: رابِعُ- الإسْلامِ، قالَ: فَأَسْلَمْتُ. قُلْتُ: أَتْبَعُكَ يا رسولَ اللهِ، قالَ: «لا، ولَكِنِ الْحَقْ بِقَوْمِكَ، فإذا أُخْبِرْتَ أَنِّي قدْ خَرَجْتُ فاتَّبِعْني». قالَ: فَلَحِقْتُ بِقَوْمي، وَجَعَلْتُ أَتَوَقَّع خَبَرَهُ وخُروجَهُ حتَّى أَقَبَلَتْ رُفْقَةٌ مِنْ يَثْرِبَ فَلَقيتُهُمْ، فَسَأَلْتُهُمْ عَنِ الخَبَرِ، فقالوا: قد خَرَجَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ مِنْ مَكَّةَ إلى المَدينَةِ، قلتُ: وقد أَتاها؟ قالوا: نَعَمْ، قالَ: فارْتَحَلْتُ حتَّى أَتَيْتُهُ. قُلتُ: أَتَعْرِفُني يا رسولَ اللَّهِ؟ قالَ: «نَعَمْ، أنتَ الرَّجُلُ الَّذي أَتاني بِمكَّةَ». فَجَعَلْتُ أَتَحَيَّنُ خَلْوَتَهُ، فلَمَّا خَلا قُلْتُ: يا رسولَ اللهِ، عَلِّمْني مِمَّا عَلَّمَكَ اللهُ وَأَجْهَلُ، قالَ: «فَسَلْ عَمَّ شِئْتَ»، قُلْتُ: أَيُّ اللَّيْلِ أَسْمَعُ؟ قالَ: «جَوْفُ اللَّيْلِ الآخِرِ فَصَلِّ ما شِئْتَ؛ فإنَّ الصَّلاةَ مَشْهودَةٌ، مَكْتوبةٌ حتَّى تُصَلِّيَ الصُّبْحَ، ثُمَّ أَقْصِرْ حتَّى تَطْلُعَ الشَّمْسُ فَتَرْتَفِعُ قِيدَ رُمْحٍ أَوْ رُمْحَيْنِ؛ فإنَّها تَطْلُعُ بينَ قَرْنَيْ شَيْطانٍ، وتُصَلِّي لها الكُفَّارُ، ثُمَّ صَلِّ ما شِئْتَ، فإنَّ الصَّلاةَ مَشْهودَةٌ مَكْتوبَةٌ حتَّى يَعْدِلَ الرُّمْحُ ظِلَّهُ، ثُمَّ أَقْصِرْ؛ فإنَّ جَهَنَّمَ تُسْجَرُ وتُفْتَحُ أَبْوابُها، فإذا زالَتِ الشَّمْسُ فَصَلِّ ما شِئْتَ، فإنَّ الصَّلاةَ مَشْهودَةٌ مَكْتوبَةٌ، ثُمَّ صَلِّ حتَّى تُصَلِّي العَصْرَ ثُمَّ أَقْصِرْ حتَّى تَغْربَ الشَّمْسُ؛ فإنَّها تَغْرُبُ بينَ قَرْنَيْ شَيْطانٍ، وتُصَلِّي لها الكُفَّارُ، وإذا تَوَضَّأْتَ فاغْسِلْ يَدَيْكَ؛ فإنَّكَ إذا غَسَلْتَ يَدَيْكَ خَرَجَتْ خَطاياكَ مِنْ أَظْفارِ أَنامِلِكَ، ثُمَّ إذا غَسَلْتَ وَجْهَكَ خَرَجَتْ خَطاياكَ مِنْ وَجْهِكَ، ثُمَّ إذا مَضْمَضْتَ واسْتَنْثَرْتَ خَرَجَتْ خَطاياكَ مِنْ مَناخِرِكَ، ثُمَّ إذا غَسَلْتَ يَدَيْكَ خَرَجَتْ خَطاياكَ مِنْ ذِراعَيْكَ، ثُمَّ إذا مَسَحْتَ بِرَأْسِكَ خَرَجَتْ خَطاياكَ مِنْ أَطْرافِ شَعْرِكَ، ثُمَّ إذا غَسَلْتَ رِجْلَيْكَ خَرَجَتْ خَطاياكَ مِنْ رِجْلَيْكَ، فإنْ ثَبَتَّ في مَجْلِسِكَ كان لكَ حَظُّكَ مِنْ وُضوئِكَ، ",["وإنْ قُمْتَ فَذَكَرْتَ رَبَّكَ، وحَمِدْتَه، ورَكَعتَهُ ركْعَتَيْنِ مُقْبِلًا عليهما بِقَلْبِكَ",1]," ",["كُنْتَ مِنْ خَطاياكَ كَيَوْمِ وَلَدَتْكَ أُمُّكَ",2],"»."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (17026)، وابن أبي شيبة في ((مسنده)) (755)، والطبراني في ((مسند الشاميين)) (1847) جميعا بطوله.","bab":"وضوء › فضل الوضوء","dorar":"C94n0qYy"},{"id":"س-03300","fp":"b9122b5f45ff","stateId":72,"easy":"إذا قمت من الليل وأيقظت زوجتك فصليتما ← يغفر الله لكما","cause":"ما مِن رجُلٍ يستيقِظُ منَ اللَّيلِ فيوقِظُ امرأتَهُ فإن غَلبَها النَّومُ نضحَ في وجهِها الماءِ ، فيَقومانِ في بيتِهِما فيذكُرانِ اللَّهَ عزَّ وجلَّ ساعةً منَ اللَّيلِ","result":"إلَّا غفرَ لَهُما","explicit":true,"apply":{"k":"time","t":"في الليل"},"ref":"الترغيب والترهيب 1/292","srcLabel":"الطبراني","text":[["ما مِن رجُلٍ يستيقِظُ منَ اللَّيلِ فيوقِظُ امرأتَهُ فإن غَلبَها النَّومُ نضحَ في وجهِها الماءِ ، فيَقومانِ في بيتِهِما فيذكُرانِ اللَّهَ عزَّ وجلَّ ساعةً منَ اللَّيلِ",1]," ",["إلَّا غفرَ لَهُما",2]],"grade":"صحيح","narrator":"أبو مالك الأشعري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني (3/295) (3448)","bab":"استغفار › أسباب المغفرة","dorar":"FpBDWDLD"},{"id":"س-03344","fp":"98ec58379824","stateId":72,"easy":"إذا صليت ركعتين ← تكفّران ما أمامهما من ذنوب","cause":"إنَّ كلَّ ركعتَيْنِ","result":"تُكفِّرانِ ما أمامَهما","explicit":true,"apply":{"k":"count","t":"ركعتين"},"ref":"صحيح الأدب المفرد 9","srcLabel":"الحسين","text":["شَهِدَ ابنَ عُمرَ رَضِيَ اللهُ عنهما ورجُلٌ يَمانيٌّ يطوفُ البَيتَ حمَلَ أُمَّهُ وراءَ ظَهْرِهِ يقولُ: إنِّي لها بَعيرُها المُذَلَّل، إنْ ذَعِرَتْ رِكابُها لم أَذْعَر، ثمَّ قال: يا بنَ عُمرَ، أَتُراني جَزَيْتُها؟ قال: لا، ولا بزَفْرَةٍ واحدةٍ، ثمَّ طاف ابنُ عُمرَ رَضِيَ اللهُ عنهما، فأتى المَقامَ، فصلَّى ركعتَيْنِ، ثمَّ قال: يا بنَ أبي موسى، ",["إنَّ كلَّ ركعتَيْنِ",1]," ",["تُكفِّرانِ ما أمامَهما",2],"."],"grade":"صحيح","narrator":"أبو بردة بن أبي موسى الأشعري","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الحسين بن حرب في ((البر والصلة)) (37) باختلاف يسير، والفاكهي في ((أخبار مكة)) (642)، وابن أبي الدنيا في ((مكارم الأخلاق)) (235) مختصرا باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"aS6UBd6I"},{"id":"س-03434","fp":"72557534558e","stateId":72,"easy":"إذا توضأت عند ارتفاع الشمس فأحسنت الوضوء ثم صليت ركعتين ← تُغفر خطاياك فتكون كيوم ولدتك أمك","cause":"مَن قامَ إذا استَقَلَّتِ الشَّمسُ فتَوضَّأ، فأحسَنَ الوُضوءَ، ثُمَّ قامَ فصَلَّى رَكعَتَينِ","result":"غُفِرَ له خَطاياه فكان كما ولَدَته أُمُّه","explicit":true,"apply":{"k":"count","t":"ركعتين · الوقت: بعد الوضوء"},"ref":"تخريج المسند لشعيب 121","srcLabel":"أحمد","text":["عن عُقبةَ بنِ عامِرٍ، أنَّه خَرَجَ مَعَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةِ تَبوكَ، فجَلَسَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يَومًا يُحَدِّثُ أصحابَه، فقال: ",["مَن قامَ إذا استَقَلَّتِ الشَّمسُ فتَوضَّأ، فأحسَنَ الوُضوءَ، ثُمَّ قامَ فصَلَّى رَكعَتَينِ، ",1],["غُفِرَ له خَطاياه فكان كما ولَدَته أُمُّه",2],". قال عُقبةُ بنُ عامِرٍ: فقُلتُ: الحَمدُ للَّهِ الذي رَزَقَني أن أسمَعَ هذا مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال لي عُمَرُ بنُ الخَطَّابِ، وكان تُجاهي جالِسًا: أتَعجَبُ مِن هذا؟ فقد قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم أعجَبَ مِن هذا قَبلَ أن تَأتيَ، فقُلتُ: وما ذاكَ بأبي أنتَ وأُمِّي؟ فقال عُمَرُ: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: مَن تَوضَّأ فأحسَنَ الوُضوءَ، ثُمَّ رَفَعَ نَظَرَه إلى السَّماءِ، فقال: أشهَدُ أنْ لا إلَهَ إلَّا اللهُ وحدَه لا شَريكَ له، وأشهَدُ أنَّ مُحَمَّدًا عَبدُه ورَسولُه، فُتِحَت له ثَمانيةُ أبوابِ الجَنَّةِ، يَدخُلُ مِن أيِّها شاءَ."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"صحيح لغيره","bab":"استغفار › أسباب المغفرة","dorar":"aJmGUGBX"},{"id":"س-03524","fp":"07d50666de32","stateId":72,"easy":"إذا قعدت في مصلاك بعد الصبح حتى تصلي الضحى لا تقول إلا خيراً ← تُغفر خطاياك ولو كانت أكثر من زبد البحر","cause":"من قَعَد في مُصَلَّاه حين ينصَرِفُ من الصُّبحِ حتَّى يُسَبِّحَ ركْعَتَيِ الضُّحى لا يقولُ إلَّا خيرًا","result":"غُفِرَ له خطاياه وإن كانت أكثَرَ مِن زَبَدِ البَحْرِ","explicit":true,"apply":{"k":"time","t":"الضحى"},"ref":"الأحكام الوسطى 1/416","srcLabel":"أبو داود","text":[["من قَعَد في مُصَلَّاه حين ينصَرِفُ من الصُّبحِ حتَّى يُسَبِّحَ ركْعَتَيِ الضُّحى لا يقولُ إلَّا خيرًا، ",1],["غُفِرَ له خطاياه وإن كانت أكثَرَ مِن زَبَدِ البَحْرِ",2]],"grade":"صحيح","narrator":"معاذ بن أنس","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (1287)، وأحمد (15623)، والطبراني في ((الكبير)) (20/ 196) (442) واللفظ لهم.","bab":"استغفار › مكفرات الذنوب","dorar":"GYYtgMmd"},{"id":"س-04049","fp":"ed22216561e1","stateId":72,"easy":"إذا أحسنت الوضوء ثم صليت ركعتين أو أربعاً تحسن فيها ← يُغفر لك","cause":"من توضأَ فأحسنَ وُضوءَه ، ثم قام فصلَّى ركعتَين - أو أربعًا ؛ شكَّ سهلٌ - ، يحسنُ فيها الذكرَ والخشوعَ ، ثم استغفر اللهَ","result":"غُفِر له","explicit":true,"apply":{"k":"count","t":"ركعتين · الوقت: بعد الوضوء"},"ref":"السلسلة الصحيحة 3398","srcLabel":"أحمد","text":[["من توضأَ فأحسنَ وُضوءَه ، ثم قام فصلَّى ركعتَين - أو أربعًا ؛ شكَّ سهلٌ - ، يحسنُ فيها الذكرَ والخشوعَ ، ثم استغفر اللهَ ؛ ",1],["غُفِر له",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"إسناده صحيح بنحوه","takhrij":"أخرجه أحمد (27546)، وابن أبي عاصم في ((الآحاد والمثاني)) (2040)، والطبراني في ((الدعاء)) (1848)","bab":"توبة › سقوط الذنوب بالاستغفار والتوبة","dorar":"r71KVq7z"},{"id":"س-06511","fp":"f65687955bfb","stateId":72,"easy":"إذا قمت في جوف الليل ← يكفّر كل خطيئة","cause":"وقيام العبد في جوف الليل","result":"يكفر كل خطيئة","explicit":true,"apply":{"k":"time","t":"في الليل"},"ref":"الأحكام الشرعية الكبرى 3/156","srcLabel":"النسائي","text":["أقبلنا مع رسول الله صلى الله عليه وسلم من غزوة تبوك قال فلما رأيته خالياً قلت يا رسول الله أخبرني بعمل يدخلني الجنة قال بخ لقد سألت عن عظيم وهو يسير على من يسر الله عليه تقيم الصلاة المكتوبة وتؤدي الزكاة المفروضة وتلقى الله لا تشرك به شيئاً أولا أدلك على رأس الأمر وعموده وذروة سنامه فأما رأس الأمر من أسلم يسلم وأما عموده فالصلاة وأما ذروة سنامه فالجهاد في سبيل الله أولا أدلك على أبواب الخير الصوم جنة والصدقة برهان ",["وقيام العبد في جوف الليل",1]," ",["يكفر كل خطيئة",2]," وتلا هذه الآية {تتجافى جنوبهم عن المضاجع يدعون ربهم خوفاً وطمعاً ومما رزقناهم ينفقون} أولا أدلك على أملك ذلك كله لله قال وأشار رسول الله صلى الله عليه وسلم بيده إلى لسانه قال قلت يا رسول الله وإنا لنؤاخذ بما نتكلم به قال ثكلتك أمك يا معاذ وهل يكب الناس على مناخرهم إلا حصائد ألسنتهم"],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي شيبة (30950)، وابن نصر في ((قيام الليل)) (صـ35) واللفظ لهما، والنسائي في ((الإغراب)) (92) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"hLyXOkA4"},{"id":"س-06686","fp":"2dc921195ffb","stateId":73,"easy":"إذا وافق تأمينك تأمين الملائكة ← يُغفر لك ما تقدّم من ذنبك","cause":"مَن وافَقَ تَأْمِينُهُ تَأْمِينَ المَلَائِكَةِ","result":"غُفِرَ له ما تَقَدَّمَ مِن ذَنْبِهِ - وقالَ ابنُ شِهَابٍ - وكانَ رَسولُ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ يقولُ: آمِينَ","explicit":true,"star":true,"similar":["س-03500","س-08151"],"ref":"علل الدارقطني 1422","srcLabel":"متفق عليه","text":["حديث يُروى عن سعيدٍ، وأبي سَلَمةَ، عن أبي هُرَيرةَ، عن النَّبيِّ صلَّى اللهُ عليه وسلَّم: إذا أمَّن الإمامُ فأمِّنوا [فإنَّه ",["مَن وافَقَ تَأْمِينُهُ تَأْمِينَ المَلَائِكَةِ ",1],["غُفِرَ له ما تَقَدَّمَ مِن ذَنْبِهِ - وقالَ ابنُ شِهَابٍ - وكانَ رَسولُ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ يقولُ: آمِينَ ",2],".]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"يرويه الزُّهريُّ، واختُلِف عنه، [ثُمَّ حكى فيه الخلافَ على الزُّهريِّ، ثُمَّ قال]: والحديثُ محفوظٌ عن الزُّهريِّ، عن سعيدٍ وأبي سَلَمةَ جميعًا، عن أبي هُرَيرةَ.","takhrij":"أخرجه البخاري (780)، ومسلم (410)، وأبو داود (936) بلفظه تامًا.","bab":"صلاة الجماعة والإمامة › الإمام","dorar":"GG66eN9U","merged":3,"otherRefs":["صحيح ابن خزيمة 1/ 612 (صحيح)","السلسلة الصحيحة 2534 (صحيح)"]},{"id":"س-03500","fp":"c19f868763a5","stateId":73,"easy":"إذا قلت «آمين» فوافق تأمينك تأمين الملائكة ← يُغفر لك ما تقدّم من ذنبك","cause":"إذا قال القارئُ: {غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ} [الفاتحة: 7]، فقال مَن خَلفَه: آمينَ، فوافَقَ ذلك قولَ أهلِ السَّماءِ: آمينَ","result":"غُفِرَ له ما تقَدَّمَ مِن ذَنبِه","explicit":true,"repOf":"س-06686","ref":"تخريج المسند لشعيب 9804","text":[["إذا قال القارئُ: {غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ} [الفاتحة: 7]، فقال مَن خَلفَه: آمينَ، فوافَقَ ذلك قولَ أهلِ السَّماءِ: آمينَ",1],"، ",["غُفِرَ له ما تقَدَّمَ مِن ذَنبِه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (782)، ومسلم (410)، وأبو داود (935)، والنسائي (927)، وأحمد (9804) واللفظ له","bab":"استغفار › مكفرات الذنوب","dorar":"uR2DI5Hc"},{"id":"س-03706","fp":"d254764eaa75","stateId":73,"easy":"إذا قلت «اللهم ربنا لك الحمد» فوافق قولك قول الملائكة ← يُغفر لك ما مضى من ذنبك","cause":"وإذا قالَ: سمِعَ اللَّهُ لمن حمدَهُ، فقولوا: اللَّهمَّ ربَّنا لَكَ الحمدُ، فإذا وافقَ قَولُ أَهْلِ الأرضِ قولَ أَهْلِ السَّماءِ","result":"غُفِرَ لَهُ ما مضَى مِن ذنبِهِ","explicit":true,"apply":{"k":"say","t":"«اللهم ربنا لك الحمد»"},"ref":"صحيح ابن خزيمة 3/ 104","srcLabel":"متفق عليه","text":["مَن أطاعَني فَقد أطاعَ اللَّهَ، ومَن عَصاني فقد عَصَى اللَّهَ، ومن أطاعَ الأميرَ فقد أطاعَني، ومَن عصا الأميرَ فقد عَصاني، إنَّما الإمامُ جنَّةٌ، فإذا صلَّى قاعدًا فصلُّوا قعودًا، ",["وإذا قالَ: سمِعَ اللَّهُ لمن حمدَهُ، فقولوا: اللَّهمَّ ربَّنا لَكَ الحمدُ، فإذا وافقَ قَولُ أَهْلِ الأرضِ قولَ أَهْلِ السَّماءِ",1]," ",["غُفِرَ لَهُ ما مضَى مِن ذنبِهِ",2],"، ويَهْلِكُ كِسرى ولا كِسرى بعدُ، ويَهْلِكُ قَيصرُ فلا قَيصرَ مِن بعدِهِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (7137)، ومسلم (1835)، والنسائي (4193) بلفظه مختصرًا.","bab":"اعتصام بالسنة › لزوم السنة","dorar":"KojlJ7bG"},{"id":"س-08151","fp":"b8236a275a6b","stateId":73,"easy":"إذا قلت «آمين» في الصلاة فوافقت تأمين الملائكة ← يُغفر لك","cause":"إذا قال أحدُكُمْ في الصَّلاةِ : آمِينَ","result":"قالتِ الملائكةُ في السماءِ : آمِينَ فوافقَتْ إحداهُما الأُخْرَى ، غُفِرَ لهُ ما تَقَدَّمَ من ذَنبِهِ","explicit":true,"repOf":"س-06686","ref":"صحيح الجامع 704","text":[["إذا قال أحدُكُمْ في الصَّلاةِ : آمِينَ ، ",1],"و ",["قالتِ الملائكةُ في السماءِ : آمِينَ فوافقَتْ إحداهُما الأُخْرَى ، غُفِرَ لهُ ما تَقَدَّمَ من ذَنبِهِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (781)، ومسلم (410) واللفظ له","bab":"ملائكة › أعمال الملائكة","dorar":"cMAJBYSc"},{"id":"س-08171","fp":"b682e75cc6e6","stateId":73,"easy":"إذا وافق تأمين أهل الأرض تأمين أهل السماء ← يُغفر لهم","cause":"إذا وافقَ تأمينُ أهلِ الأرضِ تأمينَ أهل ِالسماءِ","result":"غُفِرَ لهم","explicit":true,"ref":"السلسلة الصحيحة 6/80","srcLabel":"البيهقي","text":["أنَّ أبا هريرةَ كان يُؤذِّنُ لمروانَ بنِ الحكمِ ، فاشترط أن لا يسبقَه ب { الضَّالِّينَ } حتى يعلمَ أنه دخل الصفَّ ، وكان إذا قال مروانُ { وَلَا الضَّالِّينَ } قال أبو هريرة : آمين ، يمُدُّ بها صوتَه ، وقال : ",["إذا وافقَ تأمينُ أهلِ الأرضِ تأمينَ أهل ِالسماءِ ",1],["غُفِرَ لهم",2]],"grade":"صحيح","narrator":"أبو رافع مولى رسول الله صلى الله عليه وسلم","muhaddith":"سنده صحيح","takhrij":"أخرجه البيهقي (2491) بلفظه.","bab":"ملائكة › أعمال الملائكة","dorar":"IrfgF9cQ"},{"id":"س-03539","fp":"9579ff7b8abf","stateId":74,"easy":"إذا اغتسلت يوم الجمعة وتطهرت وادّهنت وتطيبت ← يُغفر لك ما بين الجمعتين","cause":"مَن اغتَسَل يومَ الجمعةِ فتطهَّر ما استطاع مِن طُهرٍ ثمَّ ادَّهَن مِن دُهنِه أو طِيبِ بيتِه ثمَّ راح إلى الجمعةِ ولم يُفرِّقْ بينَ اثنينِ ثمَّ صلَّى ما بدا له فإذا خرَج الإمامُ أنصَت","result":"غُفِر له ما بينَه وبينَ الجمعةِ الأخرى","explicit":true,"star":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"similar":["س-03396","س-03398","س-03538","س-03513","س-03321","س-03399","س-03400","س-03405","س-03507","س-03566","س-03571","س-03537"],"ref":"تخريج صحيح ابن حبان 2776","srcLabel":"البخاري","text":[["مَن اغتَسَل يومَ الجمعةِ فتطهَّر ما استطاع مِن طُهرٍ ثمَّ ادَّهَن مِن دُهنِه أو طِيبِ بيتِه ثمَّ راح إلى الجمعةِ ولم يُفرِّقْ بينَ اثنينِ ثمَّ صلَّى ما بدا له فإذا خرَج الإمامُ أنصَت ",1],["غُفِر له ما بينَه وبينَ الجمعةِ الأخرى",2]],"grade":"صحيح","narrator":"سلمان","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه البخاري (868) والدرامي (1582)، والطيالسي (694) بلفظه.","bab":"استغفار › مكفرات الذنوب","dorar":"yJ4dmadZ"},{"id":"س-03550","fp":"faecf4c2ed59","stateId":74,"easy":"إذا تطهرت يوم الجمعة كما أُمرت ثم خرجت حتى تأتيها ← تكون كفارة لما قبلها","cause":"ما من رَجُلٍ يَتطهَّرُ يَومَ الجُمُعةِ كما أُمِرَ، ثمَّ يَخرُجُ من بَيتِه حتَّى يَأتِيَ الجُمُعةَ، فيَقعُدُ، فيُنصِتُ حتَّى يَقضِيَ صَلاتَه","result":"إلَّا كان كَفارةً لِمَا قَبْلَه منَ الجُمُعةِ","explicit":true,"star":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"ref":"المستدرك على الصحيحين 1043","srcLabel":"البخاري","text":["قالَ لي رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا سَلمانُ، ما يَومُ الجُمُعةِ؟ قُلتُ: اللهُ ورَسولُه أعلَمُ، قالَ: يا سَلمانُ، يَومُ الجُمُعةِ فيه جُمِع أبوكَ -أو أبوكُم-، وأنا أُحَدِّثُكَ عنْ يَومِ الجُمُعةِ: ",["ما من رَجُلٍ يَتطهَّرُ يَومَ الجُمُعةِ كما أُمِرَ، ثمَّ يَخرُجُ من بَيتِه حتَّى يَأتِيَ الجُمُعةَ، فيَقعُدُ، فيُنصِتُ حتَّى يَقضِيَ صَلاتَه",1]," ",["إلَّا كان كَفارةً لِمَا قَبْلَه منَ الجُمُعةِ",2],"."],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن خزيمة (1732) بلفظه، والبخاري (883) بنحوه.","bab":"استغفار › مكفرات الذنوب","dorar":"DOD36Gqm"},{"id":"س-03396","fp":"3ae72dde40c6","stateId":74,"easy":"إذا أحسنت الوضوء يوم الجمعة وأتيتها فدنوت وأنصت ← يُغفر لك ما بين الجمعتين وثلاثة أيام زيادة","cause":"مَن تَوضَّأَ يومَ الجمعةِ ، فأحسَنَ الوُضوءَ ، ثُم أتَى الجمعةَ ، فدَنا ، و اسْتمَعَ ، و أنْصَتَ","result":"غُفِرَ له ما بَينهُ و بين الجمعةِ الأُخرَى ، و زِيادةُ ثلاثةِ أيامٍ ، و مَن مَسَّ الحَصَى فقدْ لَغَا","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","ref":"صحيح الجامع 6179","text":[["مَن تَوضَّأَ يومَ الجمعةِ ، فأحسَنَ الوُضوءَ ، ثُم أتَى الجمعةَ ، فدَنا ، و اسْتمَعَ ، و أنْصَتَ ، ",1],["غُفِرَ له ما بَينهُ و بين الجمعةِ الأُخرَى ، و زِيادةُ ثلاثةِ أيامٍ ، و مَن مَسَّ الحَصَى فقدْ لَغَا",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (857) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"ohe2ERMx","merged":2,"otherRefs":["صحيح ابن خزيمة 3/ 285 (صحيح)"]},{"id":"س-03292","fp":"155d2aab59e9","stateId":74,"easy":"إذا صليت الجمعة إلى الجمعة واجتنبت الكبائر ← تكون كفارة لما بينهما","cause":"الجمُعةُ إلى الجمُعةِ","result":"كفَّارةُ ما بينهما ما لم تُغْشَ الكبائرُ","explicit":true,"star":true,"similar":["س-03290","س-03695"],"ref":"صحيح الجامع 3110","srcLabel":"مسلم","text":[["الجمُعةُ إلى الجمُعةِ ",1],["كفَّارةُ ما بينهما ما لم تُغْشَ الكبائرُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (233) بزيادة فيه","bab":"استغفار › أسباب المغفرة","dorar":"IUWeF1mp"},{"id":"س-03398","fp":"e1834f600576","stateId":74,"easy":"إذا اغتسلت يوم الجمعة وصليت ما قُدّر لك ثم أنصت ← يُغفر لك ما بين الجمعتين وثلاثة أيام","cause":"مَنِ اغْتَسَلَ يومَ الجمعَةِ ، ثُمَّ أَتَى الجمعَةَ فصلَّى مَا قُدِّرَ له ، ثُمَّ أنصتَ حتَّى يفرَغَ الإمامُ مِنْ خُطْبَتِهِ ، ثُمَّ يصلِّى معَهُ","result":"غُفِرَ لَهُ مَا بينَه وبينَ الجمعَةِ الأخرى ، و فضلُ ثلاثَةِ أيَّامٍ","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","ref":"صحيح الجامع 6062","text":[["مَنِ اغْتَسَلَ يومَ الجمعَةِ ، ثُمَّ أَتَى الجمعَةَ فصلَّى مَا قُدِّرَ له ، ثُمَّ أنصتَ حتَّى يفرَغَ الإمامُ مِنْ خُطْبَتِهِ ، ثُمَّ يصلِّى معَهُ ، ",1],["غُفِرَ لَهُ مَا بينَه وبينَ الجمعَةِ الأخرى ، و فضلُ ثلاثَةِ أيَّامٍ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (857) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"MqLMxJYW"},{"id":"س-03538","fp":"7c7fb6c7ac58","stateId":74,"easy":"إذا اغتسلت يوم الجمعة وأحسنت ولبست صالح ثيابك وتطيبت ← يُغفر لك ما بين الجمعتين وثلاثة أيام","cause":"مَن اغتَسَل يومَ الجمعةِ فأحسَن غُسْلَه ولبِس مِن صالحِ ثيابِه ومسَّ مِن طِيبِ بيتِه أو دُهنِه","result":"غُفِر له ما بينَه وبينَ الجمعةِ الأخرى وزيادةُ ثلاثةِ أيَّامٍ مِن الَّتي بعدَها","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","ref":"تخريج صحيح ابن حبان 2780","text":[["مَن اغتَسَل يومَ الجمعةِ فأحسَن غُسْلَه ولبِس مِن صالحِ ثيابِه ومسَّ مِن طِيبِ بيتِه أو دُهنِه ",1],["غُفِر له ما بينَه وبينَ الجمعةِ الأخرى وزيادةُ ثلاثةِ أيَّامٍ مِن الَّتي بعدَها",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده قوي على شرط مسلم","takhrij":"أخرجه ابن حبان (2780) واللفظ له، ومسلم (857)، والترمذي (498) كلاهما بنحوه وزيادة في آخره.","bab":"استغفار › مكفرات الذنوب","dorar":"Z0XQyTcM"},{"id":"س-03513","fp":"aa7a4e305ec0","stateId":74,"easy":"إذا اغتسلت يوم الجمعة وتطيبت ولبست أحسن ثيابك ← تكون كفارة لما بين الجمعتين","cause":"مَنِ اغتَسَلَ يَوَم الجُمُعةِ، ومَسَّ من طِيبٍ إنْ كان عندَه، ولَبِسَ من أحسَنِ ثيابِه، ثم خَرَجَ حتى يأتيَ المَسجِدَ فيَركَعَ إنْ بَدا له، ولم يُؤْذِ أحَدًا، ثم أنصَتَ إذا خَرَجَ إمامُه حتى يُصلِّيَ","result":"كانت كفَّارةً لِمَا بيْنَها وبيْنَ الجُمُعةِ الأخرى","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","ref":"تخريج المسند لشعيب 23571","text":[["مَنِ اغتَسَلَ يَوَم الجُمُعةِ، ومَسَّ من طِيبٍ إنْ كان عندَه، ولَبِسَ من أحسَنِ ثيابِه، ثم خَرَجَ حتى يأتيَ المَسجِدَ فيَركَعَ إنْ بَدا له، ولم يُؤْذِ أحَدًا، ثم أنصَتَ إذا خَرَجَ إمامُه حتى يُصلِّيَ",1],"؛ ",["كانت كفَّارةً لِمَا بيْنَها وبيْنَ الجُمُعةِ الأخرى",2],".وقال في مَوضِعٍ آخَرَ: إنَّ عبدَ اللهِ بنَ كَعبِ بنِ مالكٍ السُّلَميَّ، حَدَّثَه أنَّ أبا أيُّوبَ صاحِبَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ حَدَّثَه، أنَّه سَمِعَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: مَنِ اغتَسَلَ يَومَ الجُمُعةِ.. وزادَ فيه: ثم خَرَجَ وعليه السَّكينةُ حتى يأتيَ المَسجِدَ."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (23571) واللفظ له، وابن خزيمة (1775)، والطبراني (4/160) (4006)","bab":"استغفار › مكفرات الذنوب","dorar":"n04NEtrz","merged":4,"otherRefs":["صحيح الترغيب 688 (صحيح)","صحيح ابن خزيمة 3/ 244 (صحيح)","تخريج المسند لشعيب 11768 (حسن)"]},{"id":"س-03519","fp":"422758d81a5b","stateId":74,"easy":"إذا حضرت الجمعة بوقار وإنصات ولم تتخطّ الرقاب ولم تؤذِ أحداً ← تكون كفارة لك إلى الجمعة التالية وثلاثة أيام","cause":"ورجلٌ حَضرَها بوقارٍ وإنصاتٍ وسُكونٍ، ولم يتخطَّ رقبةَ مسلِمٍ، ولم يؤذِ أحدًا","result":"فَهوَ كفَّارةٌ لَهُ إلى الجمعةِ الَّتي تَليها، وزيادةُ ثلاثةِ أيَّامٍ","explicit":true,"otherNeedIds":[51],"ref":"صحيح ابن خزيمة 3/ 283","srcLabel":"أبو داود","text":["يَحضُرُ الجمُعةَ ثلاثةٌ: رجلٌ يَحضرُها يَلغو، فَهوَ حظُّهُ منها، ورجلٌ حضرَها بدُعاءٍ، فَهوَ رجلٌ دعا اللَّهَ، فإن شاءَ اللَّهُ أعطاهُ، وإن شاءَ مَنعَهُ، ",["ورجلٌ حَضرَها بوقارٍ وإنصاتٍ وسُكونٍ، ولم يتخطَّ رقبةَ مسلِمٍ، ولم يؤذِ أحدًا",1],"، ",["فَهوَ كفَّارةٌ لَهُ إلى الجمعةِ الَّتي تَليها، وزيادةُ ثلاثةِ أيَّامٍ",2]," ؛ لأنَّ اللَّهَ يقولُ: {مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ عَشْرُ أَمْثَالِهَا} [الأنعامُ: 160]"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (1113)، وأحمد (7002)، والبيهقي (5897) باختلاف يسير","bab":"استغفار › مكفرات الذنوب","dorar":"I9wWla72","merged":4,"otherRefs":["صحيح الترغيب 723 (صحيح)","تخريج زاد المعاد 1/417 (حسن)","تخريج المسند لشاكر 10/174 (صحيح)"]},{"id":"س-03321","fp":"9f3ff19fb9ea","stateId":74,"easy":"إذا اغتسلت يوم الجمعة وتطيبت ولبست أحسن ثيابك ولم تتخطّ الناس ← تكون كفارة لما بين الجمعتين","cause":"مَنِ اغتسلَ يومَ الجمعةِ ، ومسَّ مِنْ طيبِ امرأتِهِ إِنْ كان لها ، ولبِسَ مِنْ صالِحِ ثيابِهِ ، ثُمَّ لم يتخَطَّ رِقابَ الناسِ ، ولم يلْغُ عندَ الموعِظَةِ","result":"كانَتْ كفَّارَةً لما بينَها","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","ref":"صحيح الجامع 6067","text":[["مَنِ اغتسلَ يومَ الجمعةِ ، ومسَّ مِنْ طيبِ امرأتِهِ إِنْ كان لها ، ولبِسَ مِنْ صالِحِ ثيابِهِ ، ثُمَّ لم يتخَطَّ رِقابَ الناسِ ، ولم يلْغُ عندَ الموعِظَةِ",1]," ، ",["كانَتْ كفَّارَةً لما بينَها",2]," ، ومَنْ لَغَا ، وتَخَطَّى رِقَابَ الناسِ ، كانَتْ لَهُ ظُهْرًا"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (347) واللفظ له، وابن خزيمة (1810)، والطحاوي في ((شرح معاني الآثار)) (2166) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"Nq2jmg1M","merged":2,"otherRefs":["صحيح الترغيب 721 (صحيح)"]},{"id":"س-03399","fp":"578453d983cf","stateId":74,"easy":"إذا اغتسلت يوم الجمعة وتطهرت ولبست أحسن ثيابك ← يغفر الله لك ما بين الجمعتين","cause":"منِ اغتسل يومَ الجمعَةِ ، فأحسنَ الغُسْلَ ، وتطهَّرَ فأحسَنَ الطُّهورَ ، ولبِسَ مِنْ أحسَنِ ثيابِهِ ، ومَسَّ مَا كتَبَ اللهُ لَهُ مِنْ طيبِ أوْ دُهْنِ أهلِهِ ، ثُمَّ أتى المسجدَ ، فلم يَلْغُ . ولم يُفَرِّقْ بينَ اثنينِ","result":"غفرَ اللهُ له ما بينَه وبينَ الجمعةِ الأُخْرى","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","otherNeedIds":[45],"ref":"صحيح الجامع 6064","text":[["منِ اغتسل يومَ الجمعَةِ ، فأحسنَ الغُسْلَ ، وتطهَّرَ فأحسَنَ الطُّهورَ ، ولبِسَ مِنْ أحسَنِ ثيابِهِ ، ومَسَّ مَا كتَبَ اللهُ لَهُ مِنْ طيبِ أوْ دُهْنِ أهلِهِ ، ثُمَّ أتى المسجدَ ، فلم يَلْغُ . ولم يُفَرِّقْ بينَ اثنينِ",1]," ، ",["غفرَ اللهُ له ما بينَه وبينَ الجمعةِ الأُخْرى",2]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (1097)، وأحمد (21569) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"9gViapAI","merged":2,"otherRefs":["صحيح ابن خزيمة 3/ 282 (صحيح)"]},{"id":"س-03290","fp":"b9f82ab2a557","stateId":74,"easy":"إذا صليت الجمعة ← تكون كفارة لما بينها وبين الجمعة التي تليها","cause":"الجمعةُ","result":"كَفَّارَةٌ لمَّا بينَها و بين الجمعةِ التي تَلِيها","explicit":true,"repOf":"س-03292","ref":"صحيح الترغيب 685","text":[["الجمعةُ ",1],["كَفَّارَةٌ لمَّا بينَها و بين الجمعةِ التي تَلِيها ",2],"، و زِيادَةُ ثلاثَةِ أيامٍ ، و ذلكَ بِأنَّ اللهَ عزَّ و جلَّ قال : ( مَنْ جاء بِالحَسَنَةِ فَلهُ عَشْرُ أَمْثَالِها )"],"grade":"صحيح","narrator":"أبو مالك الأشعري","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (3/ 298) (\n3459 )","bab":"استغفار › أسباب المغفرة","dorar":"VF3UlY7f"},{"id":"س-03375","fp":"228d1af88bde","stateId":74,"easy":"إذا اغتسلت يوم الجمعة وأتيت المسجد لا تؤذي أحداً ← تُغفر ذنوبك أو تكون كفارة إلى الجمعة التالية","cause":"إنَّ المسلِمَ إذا اغتسلَ يومَ الجمعَةِ ثمَّ أقبل إلى المسجِدِ لا يؤذي أحدًا فإن لم يجِدْ الإمامُ خرج صلَّى ما بدا له وإن وجد الإمامَ قد خرجَ جلس فاستمَع وأنصتَ حتى يقضِيَ الإمامُ جمعتَهُ وكلامَهُ","result":"إن لم يُغفَرْ له في جمعتِهِ تلك ذنوبُه كلُّها أن يكون كفارَّةً للجمعةِ التي تليها","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"ref":"مجمع الزوائد 2/174","srcLabel":"أحمد","text":[["إنَّ المسلِمَ إذا اغتسلَ يومَ الجمعَةِ ثمَّ أقبل إلى المسجِدِ لا يؤذي أحدًا فإن لم يجِدْ الإمامُ خرج صلَّى ما بدا له وإن وجد الإمامَ قد خرجَ جلس فاستمَع وأنصتَ حتى يقضِيَ الإمامُ جمعتَهُ وكلامَهُ",1]," ",["إن لم يُغفَرْ له في جمعتِهِ تلك ذنوبُه كلُّها أن يكون كفارَّةً للجمعةِ التي تليها",2]],"grade":"صحيح","narrator":"نبيشة الخير الهذلي","muhaddith":"رجاله رجال الصحيح خلا شيخ أحمد وهو ثقة","takhrij":"أخرجه أحمد (20721) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"vWIHO2jt"},{"id":"س-03376","fp":"9ae9fd100a2e","stateId":74,"easy":"إذا شهدت يوم الجمعة مسلماً ← يغفر الله لك","cause":"إنَّ اللَّهَ تباركَ وتعالى ليسَ بتاركٍ أحدًا منَ المسلمينَ يومَ الجمعةِ","result":"إلَّا غفرَ له","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"ref":"مجمع الزوائد 2/167","srcLabel":"الطبراني","text":[["إنَّ اللَّهَ تباركَ وتعالى ليسَ بتاركٍ أحدًا منَ المسلمينَ يومَ الجمعةِ",1]," ",["إلَّا غفرَ له",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"رجاله رجال الصحيح خلا شيخ الطبراني","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (4817)، وأبو نعيم في ((تاريخ أصبهان)) (1/360) واللفظ لهما، وابن عدي في ((الكامل في الضعفاء)) (3/185) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"mXiVyBAw"},{"id":"س-03400","fp":"1ebc53742989","stateId":74,"easy":"إذا اغتسلت يوم الجمعة وتطيبت ← يُغفر لك من الجمعة إلى الجمعة وثلاثة أيام","cause":"إذا كان يومُ الجُمُعَةِ فاغتسل الرجلُ ، وغسل رأسَه ، ثم تَطَيَّبَ من أَطْيَبِ طِيبِهِ ، ولَبِسَ من صالِحِ ثيابِهِ ، ثم خرج إلى الصلاةِ ولم يُفَرِّقْ بين اثْنَيْنِ ، ثم استمع للإمامِ","result":"غُفِرَ له من الجُمُعَةِ إلى الجُمُعَةِ وزيادةُ ثلاثةِ أيامٍ","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","ref":"صحيح ابن خزيمة 1803","text":[["إذا كان يومُ الجُمُعَةِ فاغتسل الرجلُ ، وغسل رأسَه ، ثم تَطَيَّبَ من أَطْيَبِ طِيبِهِ ، ولَبِسَ من صالِحِ ثيابِهِ ، ثم خرج إلى الصلاةِ ولم يُفَرِّقْ بين اثْنَيْنِ ، ثم استمع للإمامِ",1]," ، ",["غُفِرَ له من الجُمُعَةِ إلى الجُمُعَةِ وزيادةُ ثلاثةِ أيامٍ",2]," ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن خزيمة (1803)، والبيهقي (6169)","bab":"استغفار › أسباب المغفرة","dorar":"K2vujdRW"},{"id":"س-03405","fp":"b7be2b3ca4fc","stateId":74,"easy":"إذا اغتسلت وبكّرت ودنوت وأنصت يوم الجمعة ← يُغفر لك ما بين الجمعتين وثلاثة أيام","cause":"مَنْ غسَّل واغتسل ، وبكَّر وابتكر ، ودنا وأنصت واستمع","result":"غُفر له ما بينَ الجُمُعةِ إلى الجُمُعةِ ، وزيادةُ ثلاثةِ أيامٍ","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","ref":"السنن الكبرى للبيهقي 3/227","text":["قال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ وذَكَر يومَ الجُمُعةِ : ",["مَنْ غسَّل واغتسل ، وبكَّر وابتكر ، ودنا وأنصت واستمع ",1],["غُفر له ما بينَ الجُمُعةِ إلى الجُمُعةِ ، وزيادةُ ثلاثةِ أيامٍ ، ",2],"ومَنْ مسَّ الحصا فقد لغا"],"grade":"صحيح","narrator":"أوس بن أبي أوس وقيل أوس بن أوس والد عمرو","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (345)، وابن أبي شيبة (4990)، وابن حبان (116) واللفظ لهم.","bab":"استغفار › أسباب المغفرة","dorar":"UVAN0tG2"},{"id":"س-03423","fp":"4b6666ae238c","stateId":74,"easy":"إذا تطهرت ومشيت إلى الجمعة وأنصت حتى يقضي الإمام صلاته ← تكون كفارة لما بينها وبين الجمعة التالية ما اجتنبت الكبائر","cause":"لا يتَطَهَّرُ رَجُلٌ مُسلِمٌ، ثُمَّ يَمْشي إلى المسجِدِ، ثُمَّ يُنصِتُ حتى يَقضيَ الإمامُ صلاتَه","result":"إلَّا كان كفَّارةً لِما بَينَها وبَينَ الجُمُعةِ التي بَعدَها ما اجتُنِبَتِ المَقْتَلةُ","explicit":true,"ref":"تخريج المسند لشعيب 23729","srcLabel":"النسائي","text":["أتَدْري ما يومُ الجُمُعةِ؟ قُلتُ: اللهُ ورسولُه أعْلَمُ، ثُمَّ قال: أتَدْري ما يومُ الجُمُعةِ؟ قُلتُ: نَعَمْ -قال: لا أدْري، زَعَمَ سَألَه الرابِعةَ أمْ لا- قال: قلتُ: هو اليومُ الذي جُمِعَ فيه أبوه أو أبوكُم، قال النبيُّ صلَّى اللهُ عليه وسَلَّمَ: ألَا أُحَدِّثُكَ عن يَومِ الجُمُعةِ؟ ",["لا يتَطَهَّرُ رَجُلٌ مُسلِمٌ، ثُمَّ يَمْشي إلى المسجِدِ، ثُمَّ يُنصِتُ حتى يَقضيَ الإمامُ صلاتَه",1]," ",["إلَّا كان كفَّارةً لِما بَينَها وبَينَ الجُمُعةِ التي بَعدَها ما اجتُنِبَتِ المَقْتَلةُ",2],"."],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (1725)، وأحمد (23729) واللفظ له","bab":"استغفار › أسباب المغفرة","dorar":"sdAYrqiw"},{"id":"س-03427","fp":"096fec82306c","stateId":74,"easy":"إذا أحسنت الطهور ثم أتيت الجمعة فأنصت ← تكون كفارة لك إلى الجمعة التالية ما اجتنبت الكبائر","cause":"لا يتطَهَّرُ الرَّجُلُ فيُحسِنُ طُهورَه، ثمَّ يأتي الجمُعةَ، فيُنصِت حتَّى يقضيَ الإمامُ صلاتَه","result":"إلَّا كانت كفَّارةً له ما بينه وبَينَ الجمُعةِ المُقبِلةِ ما اجتَنَب المَقتَلةَ","explicit":true,"similar":["س-06561"],"ref":"المصابيح في الأحاديث المتواترة 581","srcLabel":"المصابيح في الأحاديث المتواترة","text":["أتدري ما يومُ الجُمعةِ؟ لكنِّي أدري ما يومُ الجُمعةِ! ",["لا يتطَهَّرُ الرَّجُلُ فيُحسِنُ طُهورَه، ثمَّ يأتي الجمُعةَ، فيُنصِت حتَّى يقضيَ الإمامُ صلاتَه",1],"، ",["إلَّا كانت كفَّارةً له ما بينه وبَينَ الجمُعةِ المُقبِلةِ ما اجتَنَب المَقتَلةَ",2]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"استغفار › أسباب المغفرة","dorar":"tVOSIbhK"},{"id":"س-03507","fp":"f07d13e8893f","stateId":74,"easy":"إذا اغتسلت يوم الجمعة ولبست ثيابك وتطيبت ومشيت إليها ← يُغفر لك ما بين الجمعتين","cause":"مَن اغتسَلَ يومَ الجُمعةِ، ثُمَّ لَبِسَ ثيابَه، ومَسَّ طِيبًا إنْ كان عندَه، ثُمَّ مَشى إلى الجُمعةِ وعليه السَّكينةُ، ولم يَتخَطَّ أحَدًا، ولم يُؤذِه، ورَكَعَ ما قُضيَ له، ثُمَّ انتظَرَ حتى يَنصرِفَ الإمامُ","result":"غُفِرَ له ما بيْنَ الجُمعتَينِ","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","ref":"تخريج المسند لشعيب 21729","text":[["مَن اغتسَلَ يومَ الجُمعةِ، ثُمَّ لَبِسَ ثيابَه، ومَسَّ طِيبًا إنْ كان عندَه، ثُمَّ مَشى إلى الجُمعةِ وعليه السَّكينةُ، ولم يَتخَطَّ أحَدًا، ولم يُؤذِه، ورَكَعَ ما قُضيَ له، ثُمَّ انتظَرَ حتى يَنصرِفَ الإمامُ",1],"؛ ",["غُفِرَ له ما بيْنَ الجُمعتَينِ",2],"."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (21729) واللفظ له، والطبراني كما في ((الترغيب والترهيب)) للمنذري (1/278)","bab":"استغفار › مكفرات الذنوب","dorar":"lJHUxnY5"},{"id":"س-03566","fp":"9876e1d1e9d8","stateId":74,"easy":"إذا اغتسلت يوم الجمعة وأحسنت ولبست صالح ثيابك وتطيبت ← يكفّر الله عنك ما بين الجمعتين","cause":"منِ اغتسلَ يومَ الجمُعةِ فأحسنَ الغسلَ، ثمَّ لبسَ من صالِحِ ثيابِهِ، ثمَّ مَسَّ مِن دُهْنِ بَيتِهِ ما كتبَ اللَّهُ لَهُ، أو مِن طيبِهِ، ثمَّ لم يُفرِّق بينَ اثنينِ","result":"كفَّرَ اللَّهُ عنهُ ما بينَهُ وبينَ الجمُعةِ قبلَها","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","ref":"صحيح ابن خزيمة 3/ 245","text":[["منِ اغتسلَ يومَ الجمُعةِ فأحسنَ الغسلَ، ثمَّ لبسَ من صالِحِ ثيابِهِ، ثمَّ مَسَّ مِن دُهْنِ بَيتِهِ ما كتبَ اللَّهُ لَهُ، أو مِن طيبِهِ، ثمَّ لم يُفرِّق بينَ اثنينِ",1]," ",["كفَّرَ اللَّهُ عنهُ ما بينَهُ وبينَ الجمُعةِ قبلَها",2]," . قالَ سعيدٌ: فذَكَرتُها لعمارةَ بنِ عَمرِو بنِ حزمٍ قالَ: صَدقَ، وزيادةُ ثلاثةِ أيَّامٍ. قالَ لَنا بُندارٌ: أحفظُهُ من فيهِ، وعن أبيهِ."],"grade":"صحيح","narrator":"أبو ذر","muhaddith":"أخرجه في صحيحه [وقال عن قول بندار]: هذا عندي وهم, والصحيح: عن سعيد، عن أبيه","takhrij":"أخرجه أحمد (21569)، والحاكم (1074)، وإسماعيل الأصبهاني في ((الترغيب والترهيب)) (916) واللفظ لهم.","bab":"استغفار › مكفرات الذنوب","dorar":"5azyolVb"},{"id":"س-03571","fp":"f2abe3250ef6","stateId":74,"easy":"إذا اغتسلت يوم الجمعة وتطهرت وادّهنت ← يُغفر لك ما بين الجمعتين","cause":"يَغتَسِلُ رَجُلٌ يَومَ الجُمُعةِ، ويَتَطَهَّرُ ما استَطاعَ مِن طُهرٍ، ويَدَّهِنُ مِن دُهنِه، أو يَمَسُّ مِن طيبِ بَيتِه، ثُمَّ يَخرُجُ فلا يُفَرِّقُ بَينَ اثنَينِ، ثُمَّ يُصَلِّي ما كُتِبَ لهُ، ثُمَّ يُنصِتُ إذا تَكَلَّمَ الإمامُ","result":"غُفِرَ له ما بَينَه وبَينَ الجُمُعةِ الأُخرى","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","ref":"مجموع الشروح الفقهية. 121/31","text":["لا ",["يَغتَسِلُ رَجُلٌ يَومَ الجُمُعةِ، ويَتَطَهَّرُ ما استَطاعَ مِن طُهرٍ، ويَدَّهِنُ مِن دُهنِه، أو يَمَسُّ مِن طيبِ بَيتِه، ثُمَّ يَخرُجُ فلا يُفَرِّقُ بَينَ اثنَينِ، ثُمَّ يُصَلِّي ما كُتِبَ لهُ، ثُمَّ يُنصِتُ إذا تَكَلَّمَ الإمامُ",1],"، إلَّا ",["غُفِرَ له ما بَينَه وبَينَ الجُمُعةِ الأُخرى",2],"."],"grade":"صحيح","narrator":"سلمان","muhaddith":"صحيح","bab":"استغفار › مكفرات الذنوب","dorar":"YnoXV0gx"},{"id":"س-03695","fp":"2d9d2d8c300a","stateId":74,"easy":"إذا صليت الجمعة ← تكون كفارة لما بينها وبين الجمعة التي قبلها","cause":"والجُمُعةُ إلى الجُمُعةِ التي قَبلَها","result":"كَفَّارةٌ","explicit":true,"repOf":"س-03292","ref":"تخريج المسند لشعيب 10576","text":["الصَّلاةُ إلى الصَّلاةِ التي قَبلَها كَفَّارةٌ، ",["والجُمُعةُ إلى الجُمُعةِ التي قَبلَها",1]," ",["كَفَّارةٌ",2],"، والشَّهرُ إلى الشَّهرِ الذي قَبلَهُ كَفَّارةٌ، إلَّا مِن ثلاثٍ -قال: فعَرَفْنا أنَّه أمْرٌ حدَثَ-: إلَّا مِنَ الشِّركِ باللهِ، ونَكثِ الصَّفقةِ، وتَركِ السُّنَّةِ. قال: قلنا: يا رسولَ اللهِ، هذا الشِّركُ باللهِ قد عرَفْناهُ، فما نَكثُ الصَّفقةِ، وتَركُ السُّنَّةِ؟ قال: أمَّا نَكثُ الصَّفقةِ؛ فأنْ تُعطيَ رَجُلًا بَيعَتَكَ، ثم تُقاتِلُهُ بسَيفِكَ، وأمَّا تَركُ السُّنَّةِ؛ فالخُروجُ مِن الجماعةِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح دون قوله: \"إلا من ثلاث\" إلخ","takhrij":"أخرجه أحمد (10576) واللفظ له، والحاكم (412)، والبيهقي في ((شعب الإيمان)) (3620)","bab":"اعتصام بالسنة › لزوم السنة","dorar":"ABD4mO4u"},{"id":"س-06561","fp":"a2c30efd0c28","stateId":74,"easy":"إذا أحسنت الطهور ثم أتيت الجمعة فلم تلغُ ولم تجهل ← تكون كفارة لما بين الجمعتين","cause":"إذا تَطهَّر الرَّجلُ فأَحسَنَ الطُّهورَ، ثُمَّ أَتى الجُمعةَ، فلم يَلْغُ، ولم يَجهَلْ حتَّى يَنصرِفَ الإمامُ","result":"كانت كَفَّارةً لِما بَينَها وبَينَ الجُمعةِ","explicit":true,"repOf":"س-03427","ref":"صحيح ابن خزيمة 1817","text":["عن نَبيِّ اللهِ صلَّى اللهُ عليهِ وسلَّم، قال: ",["إذا تَطهَّر الرَّجلُ فأَحسَنَ الطُّهورَ، ثُمَّ أَتى الجُمعةَ، فلم يَلْغُ، ولم يَجهَلْ حتَّى يَنصرِفَ الإمامُ",1],"، ",["كانت كَفَّارةً لِما بَينَها وبَينَ الجُمعةِ",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (11347)، وأبو نعيم الأصبهاني في ((مسانيد فراس)) (48) بلفظه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"BiGfXEMV"},{"id":"س-03331","fp":"650e2ca971d6","stateId":74,"easy":"إذا اغتسلت يوم الجمعة ← يسلّ الغسل الخطايا من أصول شعرك","cause":"الغُسلَ يومَ الجمعةِ","result":"ليَسلُّ الخطايا من أصولِ الشَّعرِ استلالًا","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"ref":"الترغيب والترهيب 1/341","srcLabel":"الطبراني","text":["إنَّ ",["الغُسلَ يومَ الجمعةِ",1]," ",["ليَسلُّ الخطايا من أصولِ الشَّعرِ استلالًا",2]],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"رواته ثقات","takhrij":"أخرجه ابن أبي حاتم في ((العلل)) (570)، والطبراني (8/ 256) (7996) واللفظ لهما.","bab":"استغفار › أسباب المغفرة","dorar":"hqanibdS"},{"id":"س-03537","fp":"6d5bb0048647","stateId":74,"easy":"إذا اغتسلت يوم الجمعة واستكت ولبست أحسن ثيابك وتطيبت ← تكون كفارة إلى الجمعة الأخرى","cause":"منِ اغتَسلَ يومَ الجمعةِ واستاكَ ولبسَ أحسنَ ثيابِهِ، وتطيَّبَ بطيبٍ -إِن وجدَهُ- ثُمَّ جاءَ ولَم يتَخطَّ النَّاسَ فَصلَّى ما شاءَ اللَّهُ أن يصلِّيَ، فإذا خرجَ الإمامُ سَكَتَ","result":"فذلِكَ كفَّارةٌ إلى الجُمعةِ الأخرى","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","ref":"نخب الافكار 2/487","text":[["منِ اغتَسلَ يومَ الجمعةِ واستاكَ ولبسَ أحسنَ ثيابِهِ، وتطيَّبَ بطيبٍ -إِن وجدَهُ- ثُمَّ جاءَ ولَم يتَخطَّ النَّاسَ فَصلَّى ما شاءَ اللَّهُ أن يصلِّيَ، فإذا خرجَ الإمامُ سَكَتَ ",1],["فذلِكَ كفَّارةٌ إلى الجُمعةِ الأخرى",2]],"grade":"حسن","narrator":"أبو هريرة وأبي سعيد","muhaddith":"إسناده صالح","takhrij":"أخرجه أبو داود (343)، وأحمد (11768)، وابن خزيمة (1762) جميعهم باختلاف يسير.","bab":"استغفار › مكفرات الذنوب","dorar":"FgVZGeLN"},{"id":"س-03556","fp":"1acdd08e2f18","stateId":74,"easy":"إذا اغتسلت يوم الجمعة ← تُكفّر ذنوبك وخطاياك، وبكل خطوة إليها أجر","cause":"مَن اغتَسَل يَومَ الجُمُعةِ","result":"كُفِّرت عنه ذُنوبُه وخَطاياه، وإذا أخَذ في المَشيِ إلى الجُمُعةِ كان له بكُلِّ خُطوةٍ عمَلُ عِشرين سنةً، فإذا فَرَغ من الجُمُعةِ أُجيزَ بعَملِ مِئَتي سَنةٍ","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"otherNeedIds":[45],"ref":"تراجم منتخبة من التهذيب 14/77","srcLabel":"أحمد","text":[["مَن اغتَسَل يَومَ الجُمُعةِ ",1],["كُفِّرت عنه ذُنوبُه وخَطاياه، وإذا أخَذ في المَشيِ إلى الجُمُعةِ كان له بكُلِّ خُطوةٍ عمَلُ عِشرين سنةً، فإذا فَرَغ من الجُمُعةِ أُجيزَ بعَملِ مِئَتي سَنةٍ",2],"."],"grade":"حسن","narrator":"عمران بن حصين وأبي بكر الصديق","muhaddith":"العجب من إسحاق من إمامته، كيف يحدث بمثل هذا؟! ثم يوثق الضحاك! فإن كانت العلة فيه من غيره، فكان عليه أن يبين ذلك، وأبو نصيرة الواسطي وثقه أحمد، وقال ابن معين: صالح","bab":"استغفار › مكفرات الذنوب","dorar":"jwor8jgS"},{"id":"س-06619","fp":"02d22ca9c917","stateId":75,"easy":"إذا توضأت فأحسنت ثم صليت مع الجماعة ← يغفر الله لك (من واقعة)","cause":"قد تَوضَّأتَ فأحسَنتَ الوُضوءَ؟ قال: بَلى يا رَسولَ اللهِ، قال: ثُمَّ شَهِدتَ الصَّلاةَ معنا","result":"فإنَّ اللهَ قد غَفَرَ لكَ حَدَّكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"apply":{"k":"time","t":"بعد الوضوء"},"ref":"صحيح مسلم 2765","srcLabel":"متفق عليه","text":["بينَما رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم في المَسجِدِ، ونَحنُ قُعودٌ معهُ، إذ جاءَ رَجُلٌ فقال: يا رَسولَ اللهِ، إنِّي أصَبتُ حَدًّا، فأقِمْه عليَّ، فسَكَتَ عنه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، ثُمَّ أعادَ فقال: يا رَسولَ اللهِ، إنِّي أصَبتُ حَدًّا، فأقِمْه عليَّ، فسَكَتَ عنه، وأُقيمَتِ الصَّلاةُ، فلَمَّا انصَرَفَ نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّم، قال أبو أُمامةَ: فاتَّبَعَ الرَّجُلُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم حينَ انصَرَفَ، واتَّبَعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم أنظُرُ ما يَرُدُّ على الرَّجُلِ، فلَحِقَ الرَّجُلُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: يا رَسولَ اللهِ، إنِّي أصَبتُ حَدًّا، فأقِمْه عليَّ، قال أبو أُمامةَ: فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أرَأيتَ حينَ خَرَجتَ مِن بَيتِكَ، أليسَ ",["قد تَوضَّأتَ فأحسَنتَ الوُضوءَ؟ قال: بَلى يا رَسولَ اللهِ، قال: ثُمَّ شَهِدتَ الصَّلاةَ معنا",1],"؟ فقال: نَعَم يا رَسولَ اللهِ، قال: فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["فإنَّ اللهَ قد غَفَرَ لكَ حَدَّكَ، ",2],"أو قال: ذَنبَكَ."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"hFknMbtE","merged":6,"otherRefs":["المستدرك على الصحيحين 7857 (صحيح)","سبل الهدى والرشاد 9/199 (حسن)","صحيح البخاري 6823 (صحيح)","صحيح مسلم 2764 (صحيح)","تخريج المسند لشعيب 22266 (صحيح)"]},{"id":"س-06594","fp":"7a5c6da604a1","stateId":75,"easy":"إذا تطهرت في بيتك ثم مشيت إلى المسجد لفريضة ← خطوة تحطّ خطيئة وأخرى ترفع درجة","cause":"مَنْ تَطَهَّرَ في بيْتِهِ ثُمَّ مشى إلى بيتٍ من بيوتِ اللهِ ، ليَقْضِيَ فريضَةً مِنْ فرائِضِ اللهِ","result":"كانتْ خطواتُهُ إحداهما تحطُّ خطيئَةً ، والأخرى ترفَعُ درجَةً","explicit":true,"star":true,"otherNeedIds":[47],"ref":"صحيح الجامع 6155","srcLabel":"مسلم","text":[["مَنْ تَطَهَّرَ في بيْتِهِ ثُمَّ مشى إلى بيتٍ من بيوتِ اللهِ ، ليَقْضِيَ فريضَةً مِنْ فرائِضِ اللهِ ، ",1],["كانتْ خطواتُهُ إحداهما تحطُّ خطيئَةً ، والأخرى ترفَعُ درجَةً",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن شاهين في ((الترغيب في فضائل الأعمال)) (88) واللفظ له، وأخرجه مسلم (666) باختلاف يسير","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"n5ehlVe5"},{"id":"س-01732","fp":"dbf267accf8c","stateId":75,"easy":"إذا أتيت بيت المقدس لا تريد إلا الصلاة فيه ← تخرج منه كيوم ولدتك أمك","cause":"مَن أتى هذا البيتَ - يُريدُ به بيتَ المقدِسِ - لا يُريدُ إلَّا الصَّلاةَ فيه","result":"أنْ يخرُجَ منه كيومَ ولَدَتْه أُمُّه","explicit":true,"similar":["س-03964"],"ref":"تخريج صحيح ابن حبان 1633","srcLabel":"النسائي","text":["أنَّ سُلَيمانَ بنَ داودَ سأَل اللهَ تبارَك وتعالى ثلاثًا فأعطاه اثنتَيْنِ وأرجو أنْ يكونَ قد أعطاه الثَّالثةَ سأَله مُلْكًا لا ينبغي لِأحَدٍ مِن بعدِه فأعطاه إيَّاه وسأَله حُكْمًا يُواطِئُ حُكْمَه فأعطاه إيَّاه وسأَله ",["مَن أتى هذا البيتَ - يُريدُ به بيتَ المقدِسِ - لا يُريدُ إلَّا الصَّلاةَ فيه",1]," ",["أنْ يخرُجَ منه كيومَ ولَدَتْه أُمُّه",2]," ) فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ( وأرجو أنْ يكونَ قد أعطاه الثَّالثَ )"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (693)، وابن ماجه (1408) باختلاف يسير، وأحمد (6644) مطولاً باختلاف يسير","bab":"أنبياء › عام","dorar":"IggiFtnt","merged":3,"otherRefs":["صحيح ابن خزيمة 1334 (صحيح)","المنار المنيف 74 (صحيح)"]},{"id":"س-03509","fp":"f27bdf091dee","stateId":75,"easy":"إذا مشيت إلى مسجد الجماعة ← خطوة تمحو سيئة وخطوة تكتب حسنة","cause":"مَن راحَ إلى مَسجِدِ الجَماعةِ","result":"فخُطْوةٌ تَمحو سيِّئةً، وخُطْوةٌ تكتُبُ له حسنةً","explicit":true,"otherNeedIds":[45],"ref":"تخريج المسند لشعيب 6599","srcLabel":"أحمد","text":[["مَن راحَ إلى مَسجِدِ الجَماعةِ",1],"؛ ",["فخُطْوةٌ تَمحو سيِّئةً، وخُطْوةٌ تكتُبُ له حسنةً",2],"، ذاهبًا وراجعًا."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (6599) واللفظ له، وابن حبان (2039)، والطبراني (14/78) (14683)","bab":"استغفار › مكفرات الذنوب","dorar":"SKYe9snb","merged":3,"otherRefs":["صحيح ابن حبان 2039 (صحيح)","صحيح النسائي 704 (صحيح)"]},{"id":"س-01474","fp":"68ced0ece1b9","stateId":75,"easy":"إذا مشيت إلى الجماعات وجلست في المسجد بعد الصلاة وأسبغت الوضوء في المكاره ← تعيش بخير وتموت بخير وتخرج من خطيئتك كيوم ولدتك أمك","cause":"المشيُ على الأقدامِ إلى الجماعاتِ، والجلوسُ في المساجِدِ خلفَ الصَّلواتِ، وإبلاغُ الوضوءِ أماكنَهُ في المكارِهِ، من يفعَلْ ذلِك","result":"يعِشْ بخيرٍ، وَيَمُت بخيرٍ، ويكونُ من خطيئتِهِ كيومِ ولدتْهُ أمُّهُ","explicit":true,"apply":{"k":"time","t":"دبر كل صلاة"},"otherNeedIds":[7,62],"ref":"هداية الرواة 693","srcLabel":"الترمذي","text":["رأيتُ ربِّي تبارَكَ وتعالى في أحسنِ صورةٍ فقالَ: فيمَ يختصمُ الملأُ الأعلى يا محمَّدُ ؟ قلتُ: أنت أعلَم أي ربِّ - مرَّتينِ -، قال: لا فوضعَ كفه بينَ كتفيَّ فوجدتُ بردَها بينَ ثديَيَّ؛ فعلِمتُ ما في السَّماء والأرضِ – ثمَّ تَلا هذه الآيةَ -:  كَذَلِكَ نُرِي إِبْرَاهِيمَ مَلَكُوتَ السَّمَاوَاتِ وَالْأَرْضِ وَلِيَكُونَ مِنَ الْمُوقِنِينَ، ثمَّ قالَ: فيمَ يختَصِمُ الملأُ الأعلَى يا محمَّدُ ؟ قُلتُ: في الكفَّاراتِ، قالَ: وما هنَّ؟ قلتُ: ",["المشيُ على الأقدامِ إلى الجماعاتِ، والجلوسُ في المساجِدِ خلفَ الصَّلواتِ، وإبلاغُ الوضوءِ أماكنَهُ في المكارِهِ، من يفعَلْ ذلِك",1]," ",["يعِشْ بخيرٍ، وَيَمُت بخيرٍ، ويكونُ من خطيئتِهِ كيومِ ولدتْهُ أمُّهُ",2],"، ومِن الدَّرجاتِ إطعامُ الطَّعامِ، وبذلُ السَّلامِ، وأن يقومَ باللَّيل والنَّاسُ نيامٌ، قال: قلِ: اللَّهمَّ إنِّي أسألُكَ الطَّيِّباتِ وتركَ المنكَراتِ وحبَّ المساكينِ وأن تغفِرَ لي خطيئتي وترحمَني وتتوبَ عليَّ وإذا أردتَ فتنةً في قومٍ ؛ فتوفَّني غيرَ مفتونٍ"],"grade":"صحيح","narrator":"عبدالرحمن بن عائش الحضرمي","muhaddith":"إسناده صحيح","takhrij":"أخرجه الدارمي (2195)، والترمذي في ((العلل الكبير)) (660)، والمعافى بن عمران في ((الزهد)) (115) بنحوه.","bab":"وضوء › فضل الوضوء","dorar":"HWckou6V"},{"id":"س-01721","fp":"399aae4373df","stateId":75,"easy":"إذا أتيت المسجد لا يدفعك إلا الصلاة فيه ← تخرج من خطيئتك كيوم ولدتك أمك","cause":"ألَّا يَأتيَه أحَدٌ لا يَنهَزُه إلَّا الصَّلاةُ فيه","result":"أن يُخرِجَه مِن خَطيئتِه كيَوْمَ وَلَدَتْه أُمُّه","explicit":true,"ref":"الأحكام الكبير 2/11","srcLabel":"النسائي","text":["حديث: أن الذي جدد بناءه إنما هو سليمان بن داود. [أنَّ سُلَيْمانَ بنَ داوُدَ صلَّى اللهُ عليه وسلَّمَ لمَّا بَنى بَيْتَ المَقدِسِ سألَ اللهَ عَزَّ وجَلَّ خِلالًا ثَلاثةً؛ سألَ اللهَ عَزَّ وجَلَّ حُكْمًا يُصادِفُ حُكْمَه فأُوتيه، وسَألَ اللهَ عَزَّ وجَلَّ مُلْكًا لا يَنْبَغي لأحَدٍ مِن بَعْدِه فأُوتيه، وسألَ اللهَ عَزَّ وجَلَّ حينَ فَرَغَ مِن بِناءِ المَسجِدِ ",["ألَّا يَأتيَه أحَدٌ لا يَنهَزُه إلَّا الصَّلاةُ فيه",1]," ",["أن يُخرِجَه مِن خَطيئتِه كيَوْمَ وَلَدَتْه أُمُّه",2],"]"],"grade":"صحيح","narrator":"[عبد الله بن عمرو]","muhaddith":"صحيح","takhrij":"أخرجه النسائي (693)، وابن ماجة (1408)، وابن خزيمة (1334) بنحوه تامًا.","bab":"أنبياء › عام","dorar":"OJ9ObYgs"},{"id":"س-03964","fp":"410bb4bc660f","stateId":75,"easy":"إذا أتيت بيت المقدس لا يدفعك إلا الصلاة فيه ← تخرج من خطيئتك كيوم ولدتك أمك","cause":"مَن أتَى بَيتَ المَقْدِسِ لا يَنْهَزُه إلَّا الصَّلاةُ فيهِ","result":"خَرَجَ مِن خَطِيئَتِه مِثْلَ يَوْمِ وَلَدَتْه أُمُّه","explicit":true,"repOf":"س-01732","ref":"تخريج المسند لشاكر 10/128","text":["دَخَلْتُ على عبْدِ اللهِ بنِ عمْرٍو وهوَ في حائِطٍ له بالطَّائفِ يُقالُ لهُ: الوَهْطُ، وهوَ مُخاصِرٌ فتًى مِن قُرَيشٍ يُزَنُّ بشُرْبِ الخَمْرِ، فقُلْتُ: بَلَغَني عنْكَ حَديثٌ: أنَّه مَن شَرِبَ شَرْبةَ خَمْرٍ لمْ يَقْبَلِ اللهُ له تَوْبةً أرْبَعينَ صَباحًا، وأنَّ الشَّقِيَّ مَن شَقِيَ في بَطْنِ أُمِّه ، وأنَّه ",["مَن أتَى بَيتَ المَقْدِسِ لا يَنْهَزُه إلَّا الصَّلاةُ فيهِ، ",1],["خَرَجَ مِن خَطِيئَتِه مِثْلَ يَوْمِ وَلَدَتْه أُمُّه،",2]," فلمَّا سَمِعَ الفَتَى ذِكْرَ الْخَمْرِ، اجْتَذَب يَدَهُ مِن يَدِه، ثمَّ انطَلَقَ، ثمَّ قال عَبدُ اللهِ بنُ عَمْرٍو: إنِّي لا أُحِلُّ لأحَدٍ أنْ يَقولَ علَيَّ ما لمْ أقُلْ؛ سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يَقولُ: مَن شربَ منَ الخمرِ شَربةً لم تُقبَلْ لَهُ صلاةٌ أربعينَ صباحًا، فإن تابَ تابَ اللَّهُ عليهِ ، فإن عادَ لم تُقبَلْ لَهُ صلاةٌ أربعينَ صباحًا، فإن تابَ تابَ اللَّهُ عليهِ ، فإن عادَ قالَ : فلا أدري في الثَّالثةِ أو في الرَّابعةِ - فإن عادَ كانَ حقًّا على اللَّهِ أن يُسقيَهُ من رَدغةِ الخبالِ يومَ القيامةِ قالَ وسَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ : إنَّ اللَّهَ عزَّ وجلَّ خلقَ خلقَهُ في ظلمةٍ، ثمَّ ألقَى عليهِم من نورِهِ يومئذٍ، فمَن أصابَهُ من نورِهِ يومئذٍ، اهتَدى، ومَن أخطأَهُ، ضلَّ فلذلِكَ أقولُ : جفَّ القلمُ على علمِ اللَّهِ عزَّ وجلَّ وسَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ : إنَّ سُلَيْمانَ بنَ داودَ عليهِ السَّلامُ سألَ اللَّهَ ثلاثًا، فأعطاهُ اثنتَينِ، ونحنُ نرجو أن تَكونَ لَهُ الثَّالثةُ : فسألَهُ حُكْمًا يصادِفُ حُكْمَهُ، فأعطاهُ اللَّهُ إيَّاهُ، وسألَهُ مُلكًا لا ينبَغي لأحَدٍ من بَعدِهِ، فأعطاهُ إيَّاهُ، وسألَهُ أيُّما رجلٍ خَرجَ من بيتِهِ لا يريدُ إلَّا الصَّلاةَ في هذا المسجدِ خرجَ من خَطيئتِهِ مثلَ يومِ ولدتهُ أمُّهُ، فَنحنُ نرجو أن يَكونَ اللَّهُ عزَّ وجلَّ قد أَعطاهُ إيَّاهُ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (693، 5664) مفرقاً مختصراً باختلاف يسير، وابن ماجه (1408، 3377) مفرقاً مختصراً باختلاف يسير","bab":"توبة › الحض على التوبة","dorar":"ktDNR7No"},{"id":"س-03966","fp":"1860859b2529","stateId":75,"easy":"إذا خرجت من بيتك لا تريد إلا الصلاة في المسجد الأقصى ← تخرج من خطيئتك كيوم ولدتك أمك","cause":"أيُّما رجلٍ خَرجَ من بيتِهِ لا يريدُ إلَّا الصَّلاةَ في هذا المسجدِ","result":"خرجَ من خَطيئتِهِ مثلَ يومِ ولدتهُ أمُّهُ","explicit":true,"apply":{"k":"time","t":"عند الخروج من البيت"},"ref":"تخريج المسند لشاكر 10/128","srcLabel":"النسائي","text":["دَخَلْتُ على عبْدِ اللهِ بنِ عمْرٍو وهوَ في حائِطٍ له بالطَّائفِ يُقالُ لهُ: الوَهْطُ، وهوَ مُخاصِرٌ فتًى مِن قُرَيشٍ يُزَنُّ بشُرْبِ الخَمْرِ، فقُلْتُ: بَلَغَني عنْكَ حَديثٌ: أنَّه مَن شَرِبَ شَرْبةَ خَمْرٍ لمْ يَقْبَلِ اللهُ له تَوْبةً أرْبَعينَ صَباحًا، وأنَّ الشَّقِيَّ مَن شَقِيَ في بَطْنِ أُمِّه ، وأنَّه مَن أتَى بَيتَ المَقْدِسِ لا يَنْهَزُه إلَّا الصَّلاةُ فيهِ، خَرَجَ مِن خَطِيئَتِه مِثْلَ يَوْمِ وَلَدَتْه أُمُّه، فلمَّا سَمِعَ الفَتَى ذِكْرَ الْخَمْرِ، اجْتَذَب يَدَهُ مِن يَدِه، ثمَّ انطَلَقَ، ثمَّ قال عَبدُ اللهِ بنُ عَمْرٍو: إنِّي لا أُحِلُّ لأحَدٍ أنْ يَقولَ علَيَّ ما لمْ أقُلْ؛ سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يَقولُ: مَن شربَ منَ الخمرِ شَربةً لم تُقبَلْ لَهُ صلاةٌ أربعينَ صباحًا، فإن تابَ تابَ اللَّهُ عليهِ ، فإن عادَ لم تُقبَلْ لَهُ صلاةٌ أربعينَ صباحًا، فإن تابَ تابَ اللَّهُ عليهِ ، فإن عادَ قالَ : فلا أدري في الثَّالثةِ أو في الرَّابعةِ - فإن عادَ كانَ حقًّا على اللَّهِ أن يُسقيَهُ من رَدغةِ الخبالِ يومَ القيامةِ قالَ وسَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ : إنَّ اللَّهَ عزَّ وجلَّ خلقَ خلقَهُ في ظلمةٍ، ثمَّ ألقَى عليهِم من نورِهِ يومئذٍ، فمَن أصابَهُ من نورِهِ يومئذٍ، اهتَدى، ومَن أخطأَهُ، ضلَّ فلذلِكَ أقولُ : جفَّ القلمُ على علمِ اللَّهِ عزَّ وجلَّ وسَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ : إنَّ سُلَيْمانَ بنَ داودَ عليهِ السَّلامُ سألَ اللَّهَ ثلاثًا، فأعطاهُ اثنتَينِ، ونحنُ نرجو أن تَكونَ لَهُ الثَّالثةُ : فسألَهُ حُكْمًا يصادِفُ حُكْمَهُ، فأعطاهُ اللَّهُ إيَّاهُ، وسألَهُ مُلكًا لا ينبَغي لأحَدٍ من بَعدِهِ، فأعطاهُ إيَّاهُ، وسألَهُ ",["أيُّما رجلٍ خَرجَ من بيتِهِ لا يريدُ إلَّا الصَّلاةَ في هذا المسجدِ ",1],["خرجَ من خَطيئتِهِ مثلَ يومِ ولدتهُ أمُّهُ",2],"، فَنحنُ نرجو أن يَكونَ اللَّهُ عزَّ وجلَّ قد أَعطاهُ إيَّاهُ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (693، 5664) مفرقاً مختصراً باختلاف يسير، وابن ماجه (1408، 3377) مفرقاً مختصراً باختلاف يسير","bab":"توبة › الحض على التوبة","dorar":"ktDNR7No"},{"id":"س-06562","fp":"4d2c0cc124a5","stateId":75,"easy":"إذا أسبغت الوضوء ثم صليت المكتوبة مع الإمام ← يُغفر لك ذنبك","cause":"مَن توضَّأَ فأسبغَ الوضوءَ ، ثمَّ مَشى إلى صلاةٍ مَكْتوبةٍ فصلَّاها معَ الإمامِ","result":"غُفِرَ لَهُ ذنبُهُ","explicit":true,"ref":"الترغيب والترهيب 1/200","srcLabel":"أحمد","text":[["مَن توضَّأَ فأسبغَ الوضوءَ ، ثمَّ مَشى إلى صلاةٍ مَكْتوبةٍ فصلَّاها معَ الإمامِ ، ",1],["غُفِرَ لَهُ ذنبُهُ",2]],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن خزيمة (1489) بلفظه، وأحمد (483)، والبزار (437) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"mKisZrOL"},{"id":"س-06607","fp":"7236c3ffb4cb","stateId":75,"easy":"إذا أحسنت الوضوء ثم خرجت إلى المسجد لا يخرجك إلا الصلاة ← رجلك اليسرى تمحو سيئة واليمنى تكتب حسنة","cause":"إذا تَوضَّأَ أحدُكُم فأحْسَنَ الوضوءَ ، ثمَّ خرجَ إلى المسجدِ لا ينزِعُهُ إلَّا الصَّلاةُ","result":"لَم تزَلْ رِجْلُهُ اليُسرَى تمحو عنهُ سَيئةً ، و تَكْتُبُ لهُ اليُمنَى حسنةً ، حتَّى يدخلَ المسجدَ ، ولَو يعلمُ النَّاسُ ما في العتْمَةِ والصُّبحِ لأتَوْهُما ولَو حَبْوًا","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"otherNeedIds":[45],"ref":"صحيح الجامع 441","srcLabel":"الحاكم","text":[["إذا تَوضَّأَ أحدُكُم فأحْسَنَ الوضوءَ ، ثمَّ خرجَ إلى المسجدِ لا ينزِعُهُ إلَّا الصَّلاةُ ، ",1],["لَم تزَلْ رِجْلُهُ اليُسرَى تمحو عنهُ سَيئةً ، و تَكْتُبُ لهُ اليُمنَى حسنةً ، حتَّى يدخلَ المسجدَ ، ولَو يعلمُ النَّاسُ ما في العتْمَةِ والصُّبحِ لأتَوْهُما ولَو حَبْوًا",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (12/355) (13328)، والحاكم (790)، والبيهقي في ((شعب الإيمان)) (2884) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"3HgftGgC"},{"id":"س-06627","fp":"4e44806f7cb3","stateId":75,"easy":"إذا صليت في المسجد (المساجد الفاضلة) ← يُغفر لك ذنبك","cause":"مَن صلَّى في المَسجِدِ -وقال حُجَينٌ: المساجِدِ الأربَعةِ","result":"غُفِرَ له ذَنْبُه","explicit":true,"apply":{"k":"time","t":"في السجود"},"ref":"تخريج المسند لشعيب 23595","srcLabel":"النسائي","text":["عن عاصِمِ بنِ سُفيانَ الثَّقَفيِّ، أنَّهم غَزَوْا غَزْوةَ السَّلاسِلِ، ففاتَهمُ الغَزْوُ فرابَطوا، ثم رَجَعوا إلى مُعاويةَ وعندَه أبو أيُّوبَ، وعُقْبةُ بنُ عامِرٍ، فقال عاصِمٌ: يا أبا أيُّوبَ، فاتَنا الغَزْوُ العامَ، وقد أُخْبِرْنا أنَّه ",["مَن صلَّى في المَسجِدِ -وقال حُجَينٌ: المساجِدِ الأربَعةِ- ",1],["غُفِرَ له ذَنْبُه",2],"، فقال: ابنَ أخي، أدُلُّك على أيسَرَ من ذلك؟ إنِّي سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: مَن تَوضَّأَ كما أُمِرَ، وصلَّى كما أُمِرَ، غُفِرَ له ما قَدَّمَ من عَمَلٍ، أكَذاكَ يا عُقْبةُ؟ قال: نَعَمْ."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"المرفوع منه صحيح لغيره","takhrij":"أخرجه النسائي (144)، وابن ماجه (1396)، وأحمد (23595) واللفظ له","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"W7Q9b4Py"},{"id":"س-07967","fp":"e1fcee0cb2e1","stateId":75,"easy":"إذا خرجت من بيتك غدوة أو عشية إلى المسجد ← خطوة كفارة وخطوة درجة","cause":"ما من عبدٍ يَخرُجُ من بيتِه إلى غُدوٍّ، أو رَواحٍ إلى المسجِدِ","result":"إلَّا كانتْ خُطاهُ خُطوةٌ كفَّارةٌ، وخُطوةٌ دَرجةٌ","explicit":true,"apply":{"k":"time","t":"عند الخروج من البيت"},"otherNeedIds":[47],"ref":"تخريج المسند لشعيب 17655","srcLabel":"أحمد","text":["رُحْتُ إلى المسجِدِ، فلقِيَني عُتْبةُ بنُ عبدٍ المازِنيُّ، فقال لي: أين تُريدُ؟ فقُلْتُ: إلى المسجِدِ، فقال: أبشِرْ؛ فإنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["ما من عبدٍ يَخرُجُ من بيتِه إلى غُدوٍّ، أو رَواحٍ إلى المسجِدِ،",1]," ",["إلَّا كانتْ خُطاهُ خُطوةٌ كفَّارةٌ، وخُطوةٌ دَرجةٌ",2],"."],"grade":"صحيح","narrator":"عتبة بن عبد السلمي","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (17655) واللفظ له، والطبراني (17/131) (321)","bab":"مساجد ومواضع الصلاة › فضل من غدا إلى المسجد أو راح","dorar":"7a6BP7En"},{"id":"س-01471","fp":"d6b9482dd97b","stateId":75,"easy":"إذا توضأت ثم أدركت الصلاة في جماعة ← يُغفر لك ما تقدّم من ذنبك","cause":"فإنْ أدرَكَ الصَّلاةَ في الجَماعةِ مع القَومِ","result":"غُفِرَ له ما تَقدَّمَ من ذَنْبِه","explicit":true,"ref":"تخريج مشكل الآثار 2322","srcLabel":"أبو داود","text":["عن سعيدِ بنِ المُسيِّبِ، قال: دَخَلْنا على رَجُلٍ من أصحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ منَ الأنصارِ وهو وَجِعٌ، فقال: مَن في البَيتِ؟ فقيلَ: أهلُكَ وولدُكَ وجُلساؤُكَ في المسجِدِ، قال: فأجْلِسوني، قال: فأسنَدَه ابنُه إلى صَدرِه، ثم قال: لأُحَدِّثَنَّكمُ اليومَ حديثًا ما حدَّثتُ به مُنذُ سَمِعتُه من رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ احتسابًا، وما أُحدِّثُكموهُ اليومَ إلَّا احتسابًا، سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: إنَّ العبدَ المُسلِمَ إذا توضَّأَ فأحسَنَ الوُضوءَ، ثم عَمَدَ إلى المسجِدِ؛ لم يَرفَعْ رِجْلَه اليُمنى إلَّا كُتِبَتْ له بها حَسَنةٌ، ولم يَضَعِ اليُسرى إلَّا حُطَّتْ عنه بها خَطيئةٌ، حتى يبلُغَ المسجِدَ، فلْيَتقرَّبْ أو لِيَتباعَدْ، ",["فإنْ أدرَكَ الصَّلاةَ في الجَماعةِ مع القَومِ",1]," ",["غُفِرَ له ما تَقدَّمَ من ذَنْبِه",2],"، وإنْ أدرَكَ منها بعضًا وسُبِقَ ببَعضٍ، فقَضى ما فاتَه، فأحسَنَ رُكوعَه وسُجودَه كان كذلك، وإنْ جاء والقومُ قُعودٌ كان كذلك."],"grade":"حسن","narrator":"رجل من الصحابة من الأنصار","muhaddith":"رجاله ثقات رجال الصحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (2322) بلفظه، وأبو داود (563)، والبيهقي (5075) بنحوه.","bab":"وضوء › فضل الوضوء","dorar":"cr6b1WZq"},{"id":"س-06661","fp":"a0e8d4b3bee7","stateId":75,"easy":"إذا سددت فرجة في الصف ← يُغفر لك","cause":"من سدَّ فرجةً في الصَّفِّ","result":"غُفِرَ له","explicit":true,"ref":"مجمع الزوائد 2/94","srcLabel":"البزار","text":["أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ ",["من سدَّ فرجةً في الصَّفِّ ",1],["غُفِرَ له",2]],"grade":"حسن","narrator":"وهب بن عبدالله السوائي أبو جحيفة","muhaddith":"إسناده حسن","takhrij":"أخرجه البزار (4232) واللفظ له، وأبو نعيم في ((معرفة الصحابة)) (6719) بنحوه.","bab":"صلاة الجماعة والإمامة › إقامة الصفوف ووصلها وفضائلها","dorar":"pMA4pMf9"},{"id":"س-01386","fp":"4936dd121db6","stateId":75,"easy":"إذا مشيت إلى الجماعات وجلست في المساجد بعد الصلاة وأسبغت الوضوء ← تكفّر خطاياك","cause":"نَقْلُ الأقدامِ إلى الجَماعاتِ، وجُلوسٌ في المساجِدِ بَعدَ الصَّلاةِ، وإسباغُ الوُضوءِ عِندَ الكريهاتِ","result":"وما الكفَّاراتُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"دبر كل صلاة، في السجود"},"ref":"تخريج شرح السنة 4/37","srcLabel":"الترمذي","text":["احْتَبَسَ عَلَيْنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ذاتَ غَداةٍ عَنْ صلاةِ الصُّبحِ حتَّى كِدْنا نَتَراءَى قَرْنَ الشَّمسِ، فخرَجَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ سريعًا، فثوَّبَ بالصَّلاةِ، وصلَّى وتجوَّزَ في صلاتِهِ، فلمَّا سلَّمَ قال: كما أنتُمْ على مَصَافِّكُمْ، ثُمَّ أقبَلَ إلينا فقالَ: إنِّي سأُحدِّثُكُمْ ما حَبَسَني عنكُمُ الغَداةَ، إنِّي قُمتُ مِنَ اللَّيلِ، فصلَّيْتُ ما قُدِّرَ لي، فنعَسْتُ في صلاتي حتَّى اسْتَثْقَلْتُ، (ووَقَعَ في مُسنَدِ أحمدَ استيقَظْتُ وهو تحريفٌ)، فإذا أنا بربِّي عزَّ وجَلَّ في أحسَنِ صورةٍ، قالَ: يا مُحمَّدُ أتَدْري فِيمَ يختصِمُ الملأُ الأعلى؟ قُلتُ: لا أَدْري يا ربِّ، قالَ: يا مُحمَّدُ، فِيمَ يختصِمُ الملأُ الأعلى؟ قُلتُ: لا أَدْري رَبِّ، فرأيتُهُ وَضَعَ كَفَّهُ بَينَ كَتِفَيَّ حتَّى وجدتُ بَرْدَ أنامِلِهِ بَينَ صَدْري، فتجلَّى لي كُلُّ شيءٍ، وعرَفْتُ، فقالَ: يا مُحمَّدُ، فِيمَ يختصِمُ الملأُ الأعلى؟ قُلتُ: في الكفَّاراتِ، قال: ",["وما الكفَّاراتُ",2],"؟ قُلتُ: ",["نَقْلُ الأقدامِ إلى الجَماعاتِ، وجُلوسٌ في المساجِدِ بَعدَ الصَّلاةِ، وإسباغُ الوُضوءِ عِندَ الكريهاتِ",1],"، قالَ: وما الدَّرجاتُ؟ قُلتُ: إطعامُ الطَّعامِ، ولِينُ الكلامِ، والصَّلاةُ والنَّاسُ نِيَامٌ، قالَ: سَلْ، قُلتُ: اللَّهمَّ إنِّي أسألُكَ فِعْلَ الخيراتِ وتَرْكَ المُنكَراتِ، وحُبَّ المساكينِ، وأنْ تغفِرَ لي وترحمَني، وإذا أردتَ فتنةً في قَومٍ، فتوفَّني غَيرَ مفتونٍ، وأسألُكَ حُبَّكَ وحُبَّ مَن يُحِبُّكَ، وحُبَّ عمَلٍ يُقرِّبُني إلى حُبِّكَ، وقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّها حَقٌّ، فادْرُسُوها وتعلَّموها."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (3235)، وأحمد (22109) كلاهما بلفظه، والطبراني (20/ 109)، (216) باختلاف يسير.","bab":"وضوء › إسباغ الوضوء","dorar":"AkMFqQCK","merged":8,"otherRefs":["أحكام القرآن لابن العربي 4/72 (حسن)","السلسلة الصحيحة 3169 (صحيح)","تخريج شرح السنة 925 (صحيح)","أطراف الغرائب 1/163 (صحيح)","بيان تلبيس الجهمية 7/205 (صحيح)","صحيح الترغيب 453 (حسن)","صحيح الترغيب 408 (صحيح)"]},{"id":"س-01508","fp":"0721e3ba0485","stateId":76,"easy":"إذا أذّنت للصلاة ← يُغفر لك مدى صوتك ويشهد لك كل من سمعك","cause":"والمُؤذِّنُ","result":"يُغفَرُ له مَدَّ صوتِه ويُصدِّقُه مَن سمِعه مِن رَطْبٍ ويابسٍ وله مِثْلُ أجرِ مَن صلَّى معه","explicit":true,"similar":["س-01501"],"otherNeedIds":[45,65],"ref":"تخريج العواصم والقواصم 9/ 135","srcLabel":"النسائي","text":["وله مِثلُ أجرِ مَن صلَّى [يعني حديث: إنَّ اللهَ وملائكتَه يُصلُّونَ على الصَّفِّ المُقدَّمِ ",["والمُؤذِّنُ",1]," ",["يُغفَرُ له مَدَّ صوتِه ويُصدِّقُه مَن سمِعه مِن رَطْبٍ ويابسٍ وله مِثْلُ أجرِ مَن صلَّى معه",2],"]"],"grade":"صحيح","narrator":"[البراء بن عازب]","muhaddith":"حديث صحيح","takhrij":"أخرجه النسائي (646)، وأحمد (18506) مطولاً من حديث البراء بن عازب رضي الله عنه","bab":"أذان › فضل التأذين","dorar":"IAQt4qlU","merged":6,"otherRefs":["صحيح الترغيب 234 (صحيح)","صحيح الجامع 6644 (صحيح)","تخريج المسند لشاكر 14/40 (صحيح)","نتائج الأفكار 1/313 (حسن)","صحيح الترغيب 235 (صحيح)"]},{"id":"س-01530","fp":"6ee2d58c09ab","stateId":76,"easy":"إذا قلت عند سماع الأذان «أشهد أن لا إله إلا الله... رضيت بالله رباً...» ← يُغفر لك ذنبك","cause":"مَن قال حينَ يَسمَعُ المُؤَذِّنَ: أشهَدُ أنْ لا إلَهَ إلَّا اللهُ وحدَه لا شَريك له، وأنَّ مُحَمَّدًا عَبدُه ورَسولُه، رَضيتُ باللهِ رَبًّا، وبمُحَمَّدٍ رَسولًا، وبالإسلامِ دينًا","result":"غُفِرَ له ذَنبُه","explicit":true,"apply":{"k":"say","t":"«أشهَدُ أنْ لا إلَهَ إلَّا اللهُ وحدَه لا شَريك له، وأنَّ مُحَمَّدًا عَبدُه ورَسولُه، رَضيتُ باللهِ رَبًّا» · الوقت: عند الأذان"},"ref":"صحيح مسلم 386","srcLabel":"أبو داود","text":[["مَن قال حينَ يَسمَعُ المُؤَذِّنَ: أشهَدُ أنْ لا إلَهَ إلَّا اللهُ وحدَه لا شَريك له، وأنَّ مُحَمَّدًا عَبدُه ورَسولُه، رَضيتُ باللهِ رَبًّا، وبمُحَمَّدٍ رَسولًا، وبالإسلامِ دينًا، ",1],["غُفِرَ له ذَنبُه",2],". قال ابنُ رُمحٍ في رِوايَتِه: مَن قال حينَ يَسمَعُ المُؤَذِّنَ: وأنا أشهَدُ، ولَم يَذكُرْ قُتَيبةُ قَولَه: وأنا."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"[صحيح]","takhrij":"أخرجه أبو داود (525)، والترمذي (210)، وابن ماجه (721)، وأحمد (1565) واللفظ لهم.","bab":"أذان › ما يقول إذا سمع المؤذن","dorar":"GtnoLpye","merged":2,"otherRefs":["صحيح الجامع 6422 (صحيح)"]},{"id":"س-01529","fp":"de62052612dd","stateId":76,"easy":"إذا رددت مع المؤذن ما يقول ← يُغفر لك وتدخل الجنة","cause":"من قال مثلَ ما يقولُ المؤذنُ","result":"غُفِرَ لهُ وأُدْخِلَ الجنةَ","explicit":true,"apply":{"k":"time","t":"عند الأذان"},"otherNeedIds":[67],"ref":"ذخيرة الحفاظ 4/2358","srcLabel":"ابن عدي","text":[["من قال مثلَ ما يقولُ المؤذنُ ",1],["غُفِرَ لهُ وأُدْخِلَ الجنةَ",2]],"grade":"صحيح","narrator":"المغيرة بن شعبة","muhaddith":"صحيح من غير هذا الوجه","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (3/ 108) بلفظه.","bab":"أذان › ما يقول إذا سمع المؤذن","dorar":"ZEvDyDlj"},{"id":"س-01510","fp":"0fc8742d75f5","stateId":76,"easy":"إذا أذّنت ← فلك دعوة النبي ﷺ بالمغفرة","cause":"للمؤذِّنينَ","result":"وغفرَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح ابن خزيمة 3/ 59","srcLabel":"أبو داود","text":["المؤذِّنونَ أُمَناءُ، والأئمَّةُ ضُمَناءُ، اللَّهمَّ اغفِر ",["للمؤذِّنينَ",1]," وسدِّدِ الأئمَّةَ ثلاثَ مرَّاتٍ هذا لفظُ حديثِ عليِّ بنِ حُجرٍ، وقالَ الحُسَيْنُ بنُ الحسنِ: أرشدَ اللَّهُ الأئمَّةَ، ",["وغفرَ",2]," للمؤذِّنينَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (517)، وأحمد (7169)، وابن حبان (1672) باختلاف يسير.","bab":"أذان › فضل التأذين","dorar":"C8PWGMWH","merged":4,"otherRefs":["هداية الرواة 1/317 (حسن)","تخريج المسند لشعيب 9428 (صحيح)","صحيح الترغيب 237 (صحيح)"]},{"id":"س-01501","fp":"94bfb7485246","stateId":76,"easy":"إذا أذّنت ← يغفر الله لك مدى صوتك ويستغفر لك كل رطب ويابس","cause":"للمؤذِّنِ","result":"يغفرُ اللهُ للمؤذِّنِ مُنتهى أذانِه ويستغفرُ له كلُّ رطبٍ ويابسٍ سمِع صوتَهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-01508","otherNeedIds":[24],"ref":"تخريج المسند لشاكر 9/72","text":[["يغفرُ اللهُ للمؤذِّنِ مُنتهى أذانِه ويستغفرُ له كلُّ رطبٍ ويابسٍ سمِع صوتَهُ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه البزار كما في ((كشف الأستار)) للهيثمي (355)، والطبراني (12/398) (13469)، والبيهقي (2109)","bab":"أذان › فضل التأذين","dorar":"XEulI7W0","merged":2,"otherRefs":["صحيح الترغيب 233 (صحيح)"]},{"id":"س-01399","fp":"985f77591c64","stateId":77,"easy":"إذا توضأت ← يحطّ الله عنك كل خطيئة أصابها كل عضو تغسله","cause":"إنَّ العبدَ إذا دَعَا بوَضوءٍ فَغَسَلَ وَجَهَهُ","result":"حَطَّ اللهُ عنه كلَّ خطيئةٍ أصابَهَا بوجْهِهِ فإذَا غسلَ ذِرَاعَيْهِ كانَ كذلك وإن مسح برأسِهِ كانَ كذلكَ وإذا طَهَّرَ قدمَيْهِ كانَ كذلكَ","explicit":true,"star":true,"ref":"تخريج المسند لشاكر 2/13","srcLabel":"متفق عليه","text":["عَن حُمرانَ بنِ أبانَ أنَّهُ شَهِدَ عُثمانَ رضيَ اللَّهُ عنهُ توضَّأَ يومًا فمَضمَضَ واستَنشَقَ وغسلَ وجهَهُ ثلاثًا وحدَّثَ عنِ النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ نحوَ حديثِ ابنِ جَعفرٍ عن سَعيدٍ [أي نحو حديث عن عثمانَ بنِ عفانَ رضي اللهُ عنه أنه دعا بماءٍ فتَوَضَّأَ ومضمضَ واستنشَقَ ثُمَّ غَسَلَ وجهَهُ ثلاثًا وذراعيْهِ ثلاثًا ثلاثًا ومَسَحَ برأسِهِ وظَهْرَ قَدَمَيْهِ ثم ضحِكَ فقال لأصحابِهِ: ألا تسألوني عما أضحَكَنِي فقالُوا: مما ضَحِكْتَ يا أميرَ المؤمنينَ قالَ: رأيتُ رسولَ الله صلَّى اللهُ عليه وسلَّم دَعَا بماءٍ قريبًا من هذِهِ البُقْعَةِ فَتَوضَّأَ كما توضأتُ ثم ضَحِكَ فقالَ: ألا تسألونِي ما أضْحَكَنِي فقالوا: ما أضْحَكَكَ يا رسولَ اللهِ فقالَ: ",["إنَّ العبدَ إذا دَعَا بوَضوءٍ فَغَسَلَ وَجَهَهُ ",1],["حَطَّ اللهُ عنه كلَّ خطيئةٍ أصابَهَا بوجْهِهِ فإذَا غسلَ ذِرَاعَيْهِ كانَ كذلك وإن مسح برأسِهِ كانَ كذلكَ وإذا طَهَّرَ قدمَيْهِ كانَ كذلكَ",2],"]"],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (159)، ومسلم (226) بلفظه بزيادة في آخره.","bab":"وضوء › صفة الوضوء","dorar":"1tU4a7Iu","merged":2,"otherRefs":["نخب الافكار 1/243 (صحيح)"]},{"id":"س-03364","fp":"086feb08706a","stateId":77,"easy":"إذا توضأت فغسلت وجهك ← تخرج كل خطيئة نظرت إليها عيناك مع الماء","cause":"إذا تَوضَّأ العَبدُ المُسلِمُ أوِ المُؤمِنُ، فغَسَلَ وجهَه","result":"خَرَجَ مِن وجهِه كُلُّ خَطيئةٍ نَظَرَ إليها بعَينَيه مع الماءِ، أو مع آخِرِ قَطرِ الماءِ، فإذا غَسَلَ يَدَيه خَرَجَ مِن يَدَيه كُلُّ خَطيئةٍ كان بَطَشَتها يَداه مع الماءِ، أو مع آخِرِ قَطرِ الماءِ، فإذا غَسَلَ رِجلَيه خَرَجَت كُلُّ خَطيئةٍ مَشَتها رِجلاه مع الماءِ، أو مع آخِرِ قَطرِ الماءِ، حتَّى يَخرُجَ نَقيًّا مِنَ الذُّنوبِ","explicit":true,"ref":"صحيح مسلم 244","srcLabel":"متفق عليه","text":[["إذا تَوضَّأ العَبدُ المُسلِمُ أوِ المُؤمِنُ، فغَسَلَ وجهَه",1]," ",["خَرَجَ مِن وجهِه كُلُّ خَطيئةٍ نَظَرَ إليها بعَينَيه مع الماءِ، أو مع آخِرِ قَطرِ الماءِ، فإذا غَسَلَ يَدَيه خَرَجَ مِن يَدَيه كُلُّ خَطيئةٍ كان بَطَشَتها يَداه مع الماءِ، أو مع آخِرِ قَطرِ الماءِ، فإذا غَسَلَ رِجلَيه خَرَجَت كُلُّ خَطيئةٍ مَشَتها رِجلاه مع الماءِ، أو مع آخِرِ قَطرِ الماءِ، حتَّى يَخرُجَ نَقيًّا مِنَ الذُّنوبِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"استغفار › أسباب المغفرة","dorar":"PAgX7KiU"},{"id":"س-07594","fp":"e8408598b9ad","stateId":77,"easy":"إذا غسلت وجهك (في الوضوء) ← يحطّ الله عنك كل خطيئة أصبتها بوجهك","cause":"أنَّ العبدَ إذا غسل وجهَه","result":"حطَّ اللهُ تعالَى عنه كلَّ خطيئةٍ أصابها بوجهِه","explicit":true,"ref":"حلية الأولياء 2/336","srcLabel":"متفق عليه","text":["سمِعتُ عثمانَ ، ودعا بماءٍ فغسل كفَّيْه ، ومضمض واستنشق ، وغسل وجهَه ثلاثًا وذراعَيْه ، ومسح برأسِه وطهَّر قدمَيْه ثمَّ ضحِك ، فقال : ألا تسألوني ما أضحكني ؟ فقلنا : ما أضحكك يا أميرَ المؤمنين ؟ قال : أضحكني أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ دعا بماءٍ في هذا المكانِ فتوضَّأ نحوًا ممَّا توضَّأتُ ثمَّ ضحِك ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ألا تسألوني ما أضحكني ؟ فقلنا : ما أضحكك يا رسولَ اللهِ ؟ قال : أضحكني ",["أنَّ العبدَ إذا غسل وجهَه",1]," ",["حطَّ اللهُ تعالَى عنه كلَّ خطيئةٍ أصابها بوجهِه",2]," ، فإذا غسل ذراعَيْه كذلك ، وإذا مسح برأسِه كذلك ، وإذا طهَّر قدمَيْه كذلك"],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"صحيح متفق عليه [أي:بين العلماء] من حديث حمران","takhrij":"أخرجه أحمد (415) والبزار (420) باختلف يسير وأخرجه البخاري (164) ومسلم (226) بنحوه.","bab":"فضائل النبي وصفته ودلائل النبوة › ضحك النبي صلى الله عليه وسلم وتبسمه","dorar":"xmM5QmUW"},{"id":"س-01403","fp":"91193c4e5e9f","stateId":77,"easy":"إذا غسلت كفّيك في الوضوء ← تخرج خطاياك من بين أظفارك","cause":"إذا تَوضَّأتَ فغَسلتَ كفَّيكَ فأنقَيتَهُما","result":"خرجَت خطاياكَ مِن بينِ أظفارِكَ وأناملِكَ","explicit":true,"similar":["س-01413"],"ref":"صحيح النسائي 147","srcLabel":"مسلم","text":["يا رسولَ اللَّهِ ! كيفَ الوضوءُ ؟ قالَ أمَّا الوضوءُ فإنَّكَ ",["إذا تَوضَّأتَ فغَسلتَ كفَّيكَ فأنقَيتَهُما",1]," ",["خرجَت خطاياكَ مِن بينِ أظفارِكَ وأناملِكَ",2]," فإذا مضمضتَ واستنشقتَ منخَرَيكَ وغسلتَ وجهَكَ ويدَيكَ إلى المرفقَينِ ومسحتَ رأسَكَ وغسَلتَ رجلَيكَ إلى الكعبَينِ اغتسَلتَ مِن عامَّةِ خطاياكَ فإن أنتَ وضعتَ وجهَكَ للَّهِ عزَّ وجلَّ خرجْتَ مِن خطاياكَ كيومِ ولدَتكَ أمُّكَ"],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (147) واللفظ له، ومسلم (832)، والحاكم (584) بنحوه مطولًا.","bab":"وضوء › صفة الوضوء","dorar":"CLXVQb2e"},{"id":"س-01404","fp":"c709964412e2","stateId":77,"easy":"إذا توضأت فأتممت الوضوء ← تغتسل من عامة خطاياك","cause":"فإذا مضمضتَ واستنشقتَ منخَرَيكَ وغسلتَ وجهَكَ ويدَيكَ إلى المرفقَينِ ومسحتَ رأسَكَ وغسَلتَ رجلَيكَ إلى الكعبَينِ","result":"اغتسَلتَ مِن عامَّةِ خطاياكَ","explicit":true,"ref":"صحيح النسائي 147","srcLabel":"مسلم","text":["يا رسولَ اللَّهِ ! كيفَ الوضوءُ ؟ قالَ أمَّا الوضوءُ فإنَّكَ إذا تَوضَّأتَ فغَسلتَ كفَّيكَ فأنقَيتَهُما خرجَت خطاياكَ مِن بينِ أظفارِكَ وأناملِكَ ",["فإذا مضمضتَ واستنشقتَ منخَرَيكَ وغسلتَ وجهَكَ ويدَيكَ إلى المرفقَينِ ومسحتَ رأسَكَ وغسَلتَ رجلَيكَ إلى الكعبَينِ",1]," ",["اغتسَلتَ مِن عامَّةِ خطاياكَ",2]," فإن أنتَ وضعتَ وجهَكَ للَّهِ عزَّ وجلَّ خرجْتَ مِن خطاياكَ كيومِ ولدَتكَ أمُّكَ"],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (147) واللفظ له، ومسلم (832)، والحاكم (584) بنحوه مطولًا.","bab":"وضوء › صفة الوضوء","dorar":"CLXVQb2e"},{"id":"س-01432","fp":"a8e588907c46","stateId":77,"easy":"إذا توضأت فغسلت يديك ← تخرّ خطاياك من بين أصابعك","cause":"وإذا توضَّأَ العبدُ فغسَلَ يَدَيْه","result":"خرَّتْ خَطاياهُ من بينِ يَدَيْه، فإذا غسَلَ وَجهَه خرَّتْ خَطاياهُ من وَجهِه، وإذا غسَلَ ذِراعَيْه خرَّتْ خَطاياهُ من ذِراعَيْه، وإذا غسَلَ رِجلَيْه خرَّتْ خَطاياهُ من رِجلَيْه","explicit":true,"similar":["س-01451"],"ref":"تخريج المسند لشعيب 18059","srcLabel":"مسلم","text":["سأَلْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ: أيُّ الليلِ أسمَعُ؟ قال: جَوفُ الليلِ الآخِرُ، ثُم قال: الصَّلاةُ مَقبولةٌ حتى تُصلِّيَ الصبْحَ، ثُم لا صلاةَ حتى تَطلُعَ الشَّمسُ، وتكونَ قِيدَ رُمحٍ، أو رُمحيْنِ، ثُم الصَّلاةُ مَقبولةٌ حتى يقومَ الظلُّ قيامَ الرمحِ، ثُم لا صلاةَ حتى تَزولَ الشَّمسُ، ثُم الصَّلاةُ مَقبولةٌ حتى تُصلِّيَ العصرَ، ثُم لا صلاةَ حتى تَغيبَ الشَّمسُ، ",["وإذا توضَّأَ العبدُ فغسَلَ يَدَيْه",1],"، ",["خرَّتْ خَطاياهُ من بينِ يَدَيْه، فإذا غسَلَ وَجهَه خرَّتْ خَطاياهُ من وَجهِه، وإذا غسَلَ ذِراعَيْه خرَّتْ خَطاياهُ من ذِراعَيْه، وإذا غسَلَ رِجلَيْه خرَّتْ خَطاياهُ من رِجلَيْه",2],"، قال شُعْبةُ: ولم يَذكُرْ مَسحَ الرأسِ، وأيُّما رَجلٍ أعتَقَ رَجلًا مُسلِمًا كان فِكاكَه منَ النارِ، يُجْزى بكلِّ عُضوٍ من أعضائِه عُضوًا من أعْضائِه، وأيُّما رَجلٍ مُسلِمٍ أعتَقَ امرأتَيْنِ مُسلِمتَيْنِ، كانَتا فِكاكَه منَ النارِ، يُجْزى بكلِّ عُضوَيْنِ من أعْضائِهما عُضوًا من أعْضائِه، وأيُّما امرأةٍ مُسلِمةٍ أعتَقَتِ امرأةً مُسلِمةً، كانت فِكاكَها منَ النارِ، تُجْزى بكلِّ عُضوٍ من أعْضائِها عُضوًا من أعْضائِها."],"grade":"صحيح","narrator":"كعب بن مرة أو مرة بن كعب","muhaddith":"صحيح لغيره دون قوله: \"أيما رجل مسلم أعتق امرأتين مسلمتين كانتا فكاكه من النار يجزى بكل عضوين من أعضائهما عضوا من أعضائه\"","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (4881)، وأحمد (18059) واللفظ له","bab":"وضوء › فضل الوضوء","dorar":"YzXRbObH"},{"id":"س-02916","fp":"bff06652168f","stateId":77,"easy":"إذا توضأت ← تخرج خطاياك","cause":"إذا تَوضَّأ العَبدُ","result":"خَرَجتْ خَطاياه","explicit":true,"ref":"إرشاد الساري 1/246","srcLabel":"مسلم","text":[["إذا تَوضَّأ العَبدُ ",1],["خَرَجتْ خَطاياه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (244) مطولاً باختلاف يسير","bab":"إيمان › الوعد","dorar":"YFSmWUYz"},{"id":"س-03266","fp":"8ad2f6167290","stateId":77,"easy":"إذا توضأت فأحسنت الوضوء ← تخرج خطاياك من جسدك حتى من تحت أظفارك","cause":"مَنْ تَوَضَّأَ فأحسنَ الوضوءَ","result":"خرجَتْ خطاياهُ مِنْ جسدِهِ ، حتى تَخْرُجَ مِنْ تحتِ أظفارِهِ","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"ref":"صحيح الجامع 6169","srcLabel":"مسلم","text":[["مَنْ تَوَضَّأَ فأحسنَ الوضوءَ ، ",1],["خرجَتْ خطاياهُ مِنْ جسدِهِ ، حتى تَخْرُجَ مِنْ تحتِ أظفارِهِ",2]],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"صحيح","takhrij":"أخرجه مسلم (245)، وأحمد (476)، وابن أبي شيبة (49) بلفظه.","bab":"استغفار › أسباب المغفرة","dorar":"CB5tlfpA"},{"id":"س-03328","fp":"f4093339b2aa","stateId":77,"easy":"إذا قرّبت وضوءك فتمضمضت واستنشقت ← تخرج خطايا وجهك وفمك وأنفك","cause":"ما من منكم أحدٌ يُقرِّبُ وضوءَه فيُمَضمضُ ، ويستنشقُ فينتثرُ","result":"إلا خرجتْ خطايا وجهِه ، وفيه ، وخياشيمِه","explicit":true,"similar":["س-08250","س-01396","س-01406"],"ref":"الإلمام بأحاديث الأحكام 1/72","srcLabel":"مسلم","text":[["ما من منكم أحدٌ يُقرِّبُ وضوءَه فيُمَضمضُ ، ويستنشقُ فينتثرُ",1]," ",["إلا خرجتْ خطايا وجهِه ، وفيه ، وخياشيمِه",2]],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"[اشترط في المقدمة أنه] صحيح على طريقة بعض أهل الحديث","takhrij":"أخرجه مسلم (832) بلفظه في أثناء حديث","bab":"استغفار › أسباب المغفرة","dorar":"UAwJZ9EH"},{"id":"ق-0284","fp":"343fb4c60791","stateId":77,"easy":"الوضوء والطهارة ← تطهير الله لعبده وإتمام نعمته","cause":"الوضوء والطهارة","result":"تطهير الله لعبده وإتمام نعمته","explicit":true,"otherNeedIds":[19],"ref":"سورة المائدة: 6","srcLabel":"القرآن الكريم","quran":{"s":5,"from":6,"to":6,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا قُمْتُمْ إِلَى الصَّلَاةِ فَاغْسِلُوا وُجُوهَكُمْ وَأَيْدِيَكُمْ إِلَى الْمَرَافِقِ وَامْسَحُوا بِرُءُوسِكُمْ وَأَرْجُلَكُمْ إِلَى الْكَعْبَيْنِ وَإِنْ كُنْتُمْ جُنُبًا فَاطَّهَّرُوا وَإِنْ كُنْتُمْ مَرْضَى أَوْ عَلَى سَفَرٍ أَوْ جَاءَ أَحَدٌ مِنْكُمْ مِنَ الْغَائِطِ أَوْ لَامَسْتُمُ النِّسَاءَ فَلَمْ تَجِدُوا مَاءً فَتَيَمَّمُوا صَعِيدًا طَيِّبًا فَامْسَحُوا بِوُجُوهِكُمْ وَأَيْدِيكُمْ مِنْهُ مَا يُرِيدُ اللَّهُ لِيَجْعَلَ عَلَيْكُمْ مِنْ حَرَجٍ وَلَكِنْ يُرِيدُ لِيُطَهِّرَكُمْ وَلِيُتِمَّ نِعْمَتَهُ عَلَيْكُمْ لَعَلَّكُمْ تَشْكُرُونَ (6)","hl":[[434,497,1],[497,554,2],[554,578,1]]}},{"id":"س-03365","fp":"fed96e34a9ca","stateId":77,"easy":"إذا أسبغت الوضوء ← يُغفر لك ما تقدّم من ذنبك وما تأخر","cause":"لا يسبِغُ عبدٌ الوضوءَ","result":"إلَّا غُفِرَ لَهُ ما تقدَّمَ مِن ذنبِهِ وما تأخَّرَ","explicit":true,"ref":"الترغيب والترهيب 1/125","srcLabel":"متفق عليه","text":["دعا عثمانُ رضيَ اللَّهُ عنهُ بوَضوءٍ وَهوَ يريدُ الخروجَ إلى الصَّلاةِ في ليلةٍ باردةٍ ، فَجِئْتُهُ بماءٍ ، فغسلَ وجهَهُ ويدَيهِ فقلتُ : حسبُكَ اللَّهُ واللَّيلةُ شديدةُ البردِ ، فقالَ : سَمِعْتُ رسولَ اللَّهِ - صلَّى اللَّهُ عليهِ وسلَّمَ - يقولُ : ",["لا يسبِغُ عبدٌ الوضوءَ",1]," ",["إلَّا غُفِرَ لَهُ ما تقدَّمَ مِن ذنبِهِ وما تأخَّرَ",2]],"grade":"حسن","narrator":"عثمان بن عفان","muhaddith":"إسناده حسن","takhrij":"أخرجه البزار (422) باختلاف يسير وابن أبي عاصم في ((الآحاد والمثاني)) (150) مختصرا وأخرجه البخاري (6433) ومسلم (227) بنحوه.","bab":"استغفار › أسباب المغفرة","dorar":"ozqItqBu"},{"id":"س-08250","fp":"1d5f249e675b","stateId":77,"easy":"إذا قرّبت وضوءك فتمضمضت واستنشقت ← تخرّ خطايا وجهك وفمك وأنفك","cause":"ما مِنكُم رَجُلٌ يُقَرِّبُ وَضوءَه فيَتَمَضمَضُ، ويَستَنشِقُ فيَنتَثِرُ","result":"إلَّا خَرَّت خَطايا وجهِه، وفيه: وخَياشيمِه، ثُمَّ إذا غَسَلَ وجهَه كما أمَرَه اللهُ، إلَّا خَرَّت خَطايا وجهِه مِن أطرافِ لحيَتِه مع الماءِ، ثُمَّ يَغسِلُ يَدَيه إلى المِرفَقَينِ، إلَّا خَرَّت خَطايا يَدَيه مِن أنامِلِه مع الماءِ، ثُمَّ يَمسَحُ رَأسَه، إلَّا خَرَّت خَطايا رَأسِه مِن أطرافِ شَعرِه مع الماءِ، ثُمَّ يَغسِلُ قدَمَيه إلى الكَعبَينِ، إلَّا خَرَّت خَطايا رِجلَيه مِن أنامِلِه مع الماءِ","explicit":true,"repOf":"س-03328","ref":"صحيح مسلم 832","text":["قال عَمرو بنُ عَبَسةَ السُّلَميُّ: كُنتُ وأنا في الجاهِليَّةِ أظُنُّ أنَّ النَّاسَ على ضَلالةٍ، وأنَّهُم لَيسوا على شيءٍ وهم يَعبُدونَ الأوثانَ، فسَمِعتُ برَجُلٍ بمَكَّةَ يُخبِرُ أخبارًا، فقَعَدتُ على راحِلَتي، فقدِمتُ عليه، فإذا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم مُستَخفيًا جُرَآءُ عليه قَومُه، فتَلَطَّفتُ حتَّى دَخَلتُ عليه بمَكَّةَ، فقُلتُ له: ما أنتَ؟ قال: أنا نَبيٌّ، فقُلتُ: وما نَبيٌّ؟ قال: أرسَلَني اللهُ، فقُلتُ: وبِأيِّ شَيءٍ أرسَلَكَ؟ قال: أرسَلَني بصِلةِ الأرحامِ، وكَسرِ الأوثانِ، وأن يوحَّدَ اللهُ لا يُشرَكُ به شَيءٌ، قُلتُ له: فمَن معكَ على هذا؟ قال: حُرٌّ وعَبدٌ، قال: ومعهُ يَومَئذٍ أبو بَكرٍ وبِلالٌ مِمَّن آمَنَ به، فقُلتُ: إنِّي مُتَّبِعُكَ، قال: إنَّكَ لا تَستَطيعُ ذلك يَومَكَ هذا؛ ألا تَرى حالي وحالَ النَّاسِ، ولَكِنِ ارجِعْ إلى أهلِكَ، فإذا سَمِعتَ بي قد ظَهَرتُ فأتِني. قال: فذَهَبتُ إلى أهلي، وقدِمَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم المَدينةَ، وكُنتُ في أهلي، فجَعَلتُ أتَخَبَّرُ الأخبارَ، وأسألُ النَّاسَ حينَ قدِمَ المَدينةَ، حتَّى قدِمَ عليَّ نَفَرٌ مِن أهلِ يَثرِبَ مِن أهلِ المَدينةَ، فقُلتُ: ما فعَلَ هذا الرَّجُلُ الذي قدِمَ المَدينةَ؟ فقالوا: النَّاسُ إليه سِراعٌ، وقد أرادَ قَومُه قَتلَه، فلَم يَستَطيعوا ذلك، فقدِمتُ المَدينةَ فدَخَلتُ عليه، فقُلتُ: يا رَسولَ اللهِ، أتَعرِفُني؟ قال: نَعَم، أنتَ الذي لَقيتَني بمَكَّةَ، قال: فقُلتُ: بَلى، فقُلتُ: يا نَبيَّ اللهِ، أخبِرْني عَمَّا عَلَّمَكَ اللهُ وأجهَلُه، أخبِرْني عَنِ الصَّلاةِ، قال: صَلِّ صَلاةَ الصُّبحِ، ثُمَّ أقصِرْ عَنِ الصَّلاةِ حتَّى تَطلُعَ الشَّمسُ حتَّى تَرتَفِعَ؛ فإنَّها تَطلُعُ حينَ تَطلُعُ بينَ قَرنَي شيطانٍ، وحينَئِذٍ يَسجُدُ لَها الكُفَّارُ، ثُمَّ صَلِّ؛ فإنَّ الصَّلاةَ مَشْهودةٌ مَحضورةٌ حتَّى يَستَقِلَّ الظِّلُّ بالرُّمحِ، ثُمَّ أقصِرْ عَنِ الصَّلاةِ؛ فإنَّ حينَئِذٍ تُسجَرُ جَهَنَّمُ، فإذا أقبَلَ الفَيءُ فصَلِّ؛ فإنَّ الصَّلاةَ مَشْهودةٌ مَحضورةٌ حتَّى تُصَلِّيَ العَصرَ، ثُمَّ أقصِرْ عَنِ الصَّلاةِ حتَّى تَغرُبَ الشَّمسُ؛ فإنَّها تَغرُبُ بينَ قَرنَي شيطانٍ، وحينَئِذٍ يَسجُدُ لَها الكُفَّارُ. قال: فقُلتُ: يا نَبيَّ اللهِ، فالوُضوءَ حَدِّثْني عنه، قال: ",["ما مِنكُم رَجُلٌ يُقَرِّبُ وَضوءَه فيَتَمَضمَضُ، ويَستَنشِقُ فيَنتَثِرُ،",1]," ",["إلَّا خَرَّت خَطايا وجهِه، وفيه: وخَياشيمِه، ثُمَّ إذا غَسَلَ وجهَه كما أمَرَه اللهُ، إلَّا خَرَّت خَطايا وجهِه مِن أطرافِ لحيَتِه مع الماءِ، ثُمَّ يَغسِلُ يَدَيه إلى المِرفَقَينِ، إلَّا خَرَّت خَطايا يَدَيه مِن أنامِلِه مع الماءِ، ثُمَّ يَمسَحُ رَأسَه، إلَّا خَرَّت خَطايا رَأسِه مِن أطرافِ شَعرِه مع الماءِ، ثُمَّ يَغسِلُ قدَمَيه إلى الكَعبَينِ، إلَّا خَرَّت خَطايا رِجلَيه مِن أنامِلِه مع الماءِ",2],"، فإن هو قامَ فصَلَّى، فحَمِدَ اللَّهَ وأثنى عليه، ومَجَّدَه بالذي هو له أهلٌ، وفَرَّغَ قَلبَه للَّهِ؛ إلَّا انصَرَفَ مِن خَطيئَتِه كَهَيئَتِه يَومَ ولَدَتْه أُمُّه. فحَدَّثَ عَمرو بنُ عَبَسةَ بهذا الحَديثِ أبا أُمامةَ صاحِبَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال له أبو أُمامةَ: يا عَمرَو بنَ عَبَسةَ، انظُرْ ما تَقولُ، في مَقامٍ واحِدٍ يُعطى هذا الرَّجُلُ، فقال عَمرٌو: يا أبا أُمامةَ، لقد كَبِرَت سِنِّي، ورَقَّ عَظمي، واقتَرَبَ أجَلي، وما بي حاجةٌ أن أكذِبَ على اللهِ ولا على رَسولِ اللهِ، لو لَم أسمَعْه مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم إلَّا مَرَّةً، أو مَرَّتَينِ، أو ثَلاثًا -حتَّى عَدَّ سَبعَ مَرَّاتٍ- ما حَدَّثتُ به أبَدًا، ولَكِنِّي سَمِعتُه أكثَرَ مِن ذلك."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (17019)، والطبراني في ((الأحاديث الطوال) (11)، والبيهقي (4442)، باختلاف يسير.","bab":"مناقب وفضائل › أبو بكر الصديق","dorar":"3ZpXpkjb","merged":3,"otherRefs":["تخريج سنن الدارقطني 378 (صحيح)","تخريج المسند لشعيب 17019 (صحيح)"]},{"id":"س-01413","fp":"2ac8340144df","stateId":77,"easy":"إذا غسلت يديك ثلاثاً في الوضوء ← تخرج خطاياك من بين أظفارك","cause":"إذا توضَّأتَ فغسَلتَ يَديكَ ثلاثًا","result":"خرجَت خطاياكَ من بينِ أظفارِكَ وأَناملِكَ","explicit":true,"repOf":"س-01403","ref":"نخب الافكار 1/331","text":["قلتُ: يا رسولَ اللَّهِ كيفَ الوضوءُ ؟ قالَ: ",["إذا توضَّأتَ فغسَلتَ يَديكَ ثلاثًا ",1],["خرجَت خطاياكَ من بينِ أظفارِكَ وأَناملِكَ",2],"، فإذا مَضمَضتَ واستنشَقتَ في منخَرِكَ وغسلتَ وجهَكَ وذراعيكَ إلى المرفَقينِ وغسَلتَ رِجليكَ إلى الكَعبينِ اغتسَلتَ من عامَّةِ خطاياكَ"],"grade":"حسن","narrator":"عمرو بن عبسة","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطحاوي في ((شرح معاني الآثار)) (185) واللفظ له، والنسائي (147) باختلاف يسير، ومسلم (832) مطولًا.","bab":"وضوء › صفة الوضوء","dorar":"zseSxBwX"},{"id":"س-01467","fp":"5b6cc282041c","stateId":77,"easy":"إذا توضأت فغسلت وجهك ويديك ← تسقط خطاياك من وجهك ثم من يديك","cause":"إذا دَعا الرَّجلُ بطَهورِهِ فغسلَ وجهَهُ","result":"سقَطَت خَطاياهُ مِن وجهِهِ وأطرافِ لِحيتِهِ، فإذا غَسلَ يديهِ سقَطَت خَطاياهُ مِن أطرافِ أَناملِهِ، فإذا مسحَ برأسِهِ سَقَطَت خَطاياهُ مِن أطرافِ شَعرِهِ، فإذا غَسلَ رِجليهِ خرجَت خَطاياهُ مِن بُطونِ قَدَميهِ","explicit":true,"ref":"نخب الافكار 1/330","srcLabel":"مسلم","text":["عن شُرَحبيلَ بنِ السِّمطِ، أنَّهُ قالَ: مَن يحدِّثُنا عن رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ؟ فقالَ عمرو بنُ عبسةَ: سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ، يقولُ: ",["إذا دَعا الرَّجلُ بطَهورِهِ فغسلَ وجهَهُ",1]," ",["سقَطَت خَطاياهُ مِن وجهِهِ وأطرافِ لِحيتِهِ، فإذا غَسلَ يديهِ سقَطَت خَطاياهُ مِن أطرافِ أَناملِهِ، فإذا مسحَ برأسِهِ سَقَطَت خَطاياهُ مِن أطرافِ شَعرِهِ، فإذا غَسلَ رِجليهِ خرجَت خَطاياهُ مِن بُطونِ قَدَميهِ",2]],"grade":"حسن","narrator":"عمرو بن عبسة","muhaddith":"رجاله ثقات","takhrij":"أخرجه مسلم (832) ، وأبو داوود (1277) ، وابن خزيمة في ((صحيحه)) (260) ، والحاكم في ((مستدركه)) (584) جميعا بمعناه مطولا .","bab":"وضوء › فضل الوضوء","dorar":"qMMcF0Md"},{"id":"س-01396","fp":"b175ca51e682","stateId":77,"easy":"إذا توضأت فتمضمضت واستنثرت وغسلت وجهك ← تخرج الخطايا من كل عضو تغسله","cause":"إذا تَوضَّأَ العبدُ المؤمِنُ فتَمضْمَضَ","result":"خَرجتِ الخَطايا من فيه ، فإذا اسْتنْثَر خَرجَتِ الخَطايا من أنْفِه ، فإذا غَسَلَ وجْهَهُ خَرَجَتِ الخَطايا من وجْهِهِ ، حتى تَخْرُجَ من تحتِ أشْفارِ عَينَيْهِ ، فإذا غَسَلَ يَدَيْهِ خَرَجَتِ الخطايا من يديه ، حتى تَخْرُجَ من تحتِ أظْفارِ يَدَيْهِ فإذا مَسَحَ بِرأسِه خَرَجَتِ الخَطايا من رأْسِهِ حتى تَخْرُجَ من أُذُنَيْهِ ، فإذا غَسَلَ رِجْلَيْهِ خَرَجَتِ الخَطايا من رِجَلَيْهِ حتى تَخْرُجَ من تَحتِ أظْفارِ رِجْلَيْهِ","explicit":true,"repOf":"س-03328","ref":"صحيح الجامع 449","text":[["إذا تَوضَّأَ العبدُ المؤمِنُ فتَمضْمَضَ",1]," ",["خَرجتِ الخَطايا من فيه ، فإذا اسْتنْثَر خَرجَتِ الخَطايا من أنْفِه ، فإذا غَسَلَ وجْهَهُ خَرَجَتِ الخَطايا من وجْهِهِ ، حتى تَخْرُجَ من تحتِ أشْفارِ عَينَيْهِ ، فإذا غَسَلَ يَدَيْهِ خَرَجَتِ الخطايا من يديه ، حتى تَخْرُجَ من تحتِ أظْفارِ يَدَيْهِ فإذا مَسَحَ بِرأسِه خَرَجَتِ الخَطايا من رأْسِهِ حتى تَخْرُجَ من أُذُنَيْهِ ، فإذا غَسَلَ رِجْلَيْهِ خَرَجَتِ الخَطايا من رِجَلَيْهِ حتى تَخْرُجَ من تَحتِ أظْفارِ رِجْلَيْهِ",2]," ثُم كان مَشْيُهُ إلى المسْجِدِ وصلاتُه له نافِلَةً"],"grade":"صحيح","narrator":"عبدالله الصنابحي","muhaddith":"صحيح","takhrij":"أخرجه النسائي (103) واللفظ له، وابن ماجه (282)، وأحمد (19091)، ومالك في ((الموطأ)) (30)","bab":"وضوء › صفة الوضوء","dorar":"kXbX8Dgs"},{"id":"س-01406","fp":"4cb0b6668fd9","stateId":77,"easy":"إذا توضأت فتمضمضت واستنشقت وغسلت وجهك ← تخرج الخطايا من فمك وأنفك ووجهك","cause":"من تَوضَّأ فمضمضَ واستنشقَ","result":"خرجت خطاياهُ من فيهِ وأنفِهِ فإذا غسلَ وجهَهُ خرجَت خطاياهُ من وجهِهِ حتَّى يخرُجَ من تحتِ أشفارِ عينيهِ فإذا غسلَ يدَيهِ خرجَت خطاياهُ من يدَيهِ فإذا مسحَ برأسِهِ خرجَت خطاياهُ","explicit":true,"repOf":"س-03328","ref":"صحيح ابن ماجه 231","text":[["من تَوضَّأ فمضمضَ واستنشقَ ",1],["خرجت خطاياهُ من فيهِ وأنفِهِ فإذا غسلَ وجهَهُ خرجَت خطاياهُ من وجهِهِ حتَّى يخرُجَ من تحتِ أشفارِ عينيهِ فإذا غسلَ يدَيهِ خرجَت خطاياهُ من يدَيهِ فإذا مسحَ برأسِهِ خرجَت خطاياهُ",2]," مِن رأسِهِ حتَّى تخرجَ من أذُنَيْهِ فإذا غسلَ رجليهِ خرجَت خطاياهُ من رجليهِ حتَّى تخرُجَ من تحتِ أظفارِ رجليهِ وَكانت صلاتُهُ ومشيُهُ إلى المسجدِ نافلةً"],"grade":"صحيح","narrator":"عبدالله الصنابحي","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجة (282) واللفظ له، والنسائي (103)، والبيهقي في ((الشعب)) (2478) بنحوه.","bab":"وضوء › صفة الوضوء","dorar":"whz58XCe"},{"id":"س-01407","fp":"902716f0ddbd","stateId":77,"easy":"إذا قمت إلى الوضوء تريد الصلاة ← تنزل خطاياك مع أول قطرة من كل عضو","cause":"أيُّما رجلٍ قامَ إلى وضُوئِهِ يُرِيدُ الصَّلاةَ ، ثُمَّ غَسَلَ كَفَّيْهِ","result":"نزلَتْ كلُّ خطيئةٍ من كَفَّيْهِ مع أولِ قَطْرَةٍ ، فإذا مَضْمَضَ و اسْتَنْشَقَ و اسْتَنْثَرَ ، نزلَتْ خَطِيئَتُهُ من لسانِهِ و شَفَتَيْهِ مع أولِ قَطْرَةٍ ، فإذا غَسَلَ يديْهِ إلى المِرْفَقَيْنِ ، و رِجْلَيْهِ إلى الكعبيْنِ ، سَلِمَ من كلِّ ذَنْبٍ كَهَيْئَتِه يومَ ولَدَتْهُ أمُّهُ","explicit":true,"ref":"صحيح الترغيب 187","srcLabel":"أحمد","text":[["أيُّما رجلٍ قامَ إلى وضُوئِهِ يُرِيدُ الصَّلاةَ ، ثُمَّ غَسَلَ كَفَّيْهِ ، ",1],["نزلَتْ كلُّ خطيئةٍ من كَفَّيْهِ مع أولِ قَطْرَةٍ ، فإذا مَضْمَضَ و اسْتَنْشَقَ و اسْتَنْثَرَ ، نزلَتْ خَطِيئَتُهُ من لسانِهِ و شَفَتَيْهِ مع أولِ قَطْرَةٍ ، فإذا غَسَلَ يديْهِ إلى المِرْفَقَيْنِ ، و رِجْلَيْهِ إلى الكعبيْنِ ، سَلِمَ من كلِّ ذَنْبٍ كَهَيْئَتِه يومَ ولَدَتْهُ أمُّهُ",2]," ( قال : ) فإذا قامَ إلى الصَّلاةِ رفعَ اللهُ درجتَهُ ، و إنْ قَعَدَ قَعَدَ سالِمًا"],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (22267) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (4397) بنحوه","bab":"وضوء › صفة الوضوء","dorar":"llT4ZOIe"},{"id":"س-01441","fp":"38fe97917737","stateId":77,"easy":"إذا توضأت تريد الصلاة وأتممت الوضوء على مواضعه ← تسلم من كل ذنب، فإن صليت رفعك الله درجة","cause":"وأيُّما رَجُلٍ قام إلى وُضوءٍ يُريدُ الصَّلاةَ، فأحصى الوُضوءَ إلى أماكنِه","result":"سَلِمَ مِن كلِّ ذَنبٍ أو خَطيئةٍ له، فإنْ قام إلى الصَّلاةِ، رَفَعَه اللهُ عزَّ وجلَّ بها دَرجةً، وإنْ قَعَدَ، قَعَدَ سالمًا","explicit":true,"otherNeedIds":[47],"ref":"تخريج المسند لشعيب 19439","srcLabel":"النسائي","text":["أيُّما رَجُلٍ رَمى بسَهمٍ في سَبيلِ اللهِ عزَّ وجلَّ، فبَلَغَ، مُخطِئًا أو مُصيبًا، فله مِن الأجْرِ كرَقبةٍ يُعتِقُها مِن وَلدِ إسماعيلَ، وأيُّما رَجُلٍ شاب شَيبةً في سَبيلِ اللهِ، فهي له نورٌ، وأيُّما رَجُلٍ مُسلِمٍ أعتَقَ رَجُلًا مُسلِمًا، فكلُّ عُضوٍ مِن المُعتَقِ بعُضوٍ مِن المُعتِقِ فِداءٌ له مِن النَّارِ، وأيُّما امرأةٍ مُسلِمةٍ أعتَقَتِ امرأةً مُسلِمةً، فكلُّ عُضوٍ مِن المُعتَقةِ بعُضوٍ مِن المُعتِقةِ فِداءٌ لها مِن النَّارِ، وأيُّما رَجُلٍ مُسلِمٍ قَدَّمَ للهِ عزَّ وجلَّ مِن صُلبِه ثلاثةً لم يَبلُغوا الحِنثَ، أو امرأةٍ، فهم له سُترةٌ مِن النَّارِ، ",["وأيُّما رَجُلٍ قام إلى وُضوءٍ يُريدُ الصَّلاةَ، فأحصى الوُضوءَ إلى أماكنِه",1],"، ",["سَلِمَ مِن كلِّ ذَنبٍ أو خَطيئةٍ له، فإنْ قام إلى الصَّلاةِ، رَفَعَه اللهُ عزَّ وجلَّ بها دَرجةً، وإنْ قَعَدَ، قَعَدَ سالمًا",2],". فقال شُرَحبيلُ بنُ السِّمطِ: آنتَ سَمِعتَ هذا الحديثَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يا ابنَ عَبَسةَ؟ قال: نَعَمْ، والذي لا إلهَ إلَّا هو، لو أنِّي لم أسمَعْ هذا الحديثَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ غيرَ مَرَّةٍ أو مَرَّتَينِ أو ثلاثٍ أو أربعٍ أو خَمسٍ أو ستٍّ أو سَبعٍ -فانتَهى عندَ سَبعٍ-، ما حَلَفتُ -يَعني ما بالَيتُ- ألَّا أُحدِّثَ به أحَدًا مِن النَّاسِ، ولكنِّي واللهِ ما أدري عَددَ ما سَمِعتُه مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح دون قوله: \"من ولد إسماعيل\"","takhrij":"أخرجه النسائي (3142) مختصراً، وأحمد (19439) واللفظ له","bab":"وضوء › فضل الوضوء","dorar":"LicciAss"},{"id":"س-01451","fp":"22fb2aa70549","stateId":77,"easy":"إذا توضأت فغسلت يديك ← تخرج خطاياك من أطراف أصابعك","cause":"وإذا تَوَضَّأْتَ فاغْسِلْ يَدَيْكَ","result":"فإنَّكَ إذا غَسَلْتَ يَدَيْكَ خَرَجَتْ خَطاياكَ مِنْ أَظْفارِ أَنامِلِكَ، ثُمَّ إذا غَسَلْتَ وَجْهَكَ خَرَجَتْ خَطاياكَ مِنْ وَجْهِكَ، ثُمَّ إذا مَضْمَضْتَ واسْتَنْثَرْتَ خَرَجَتْ خَطاياكَ مِنْ مَناخِرِكَ، ثُمَّ إذا غَسَلْتَ يَدَيْكَ خَرَجَتْ خَطاياكَ مِنْ ذِراعَيْكَ، ثُمَّ إذا مَسَحْتَ بِرَأْسِكَ خَرَجَتْ خَطاياكَ مِنْ أَطْرافِ شَعْرِكَ، ثُمَّ إذا غَسَلْتَ رِجْلَيْكَ خَرَجَتْ خَطاياكَ مِنْ رِجْلَيْكَ","explicit":true,"repOf":"س-01432","ref":"المستدرك على الصحيحين 594","text":["أَتَيْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ في أَوَّلِ ما بُعِثَ وهو بِمكَّةَ، وهو حينَئذٍ مُسْتَخْفٍ، فقلتُ: ما أنتَ؟ قالَ: «أنا نَبيٌّ». قُلتُ: وما نَبيٌّ؟ قالَ: «رسولُ اللَّهِ». قلتُ: آللهُ أَرْسَلَكَ؟ قالَ: «نعم». قُلتُ: بما أَرْسَلَكَ؟ قالَ: «أنْ تَعْبُدَ اللَّهَ، وتَكْسِرَ الأَوْثانَ والأَدْيانَ، وتوصِلَ الأَرْحامَ». قُلْتُ: نِعْمَ ما أَرْسَلَكَ به. قُلْتُ: فَمَنْ يَتَّبِعُكَ على هذا؟ قالَ: «عَبْدٌ وحُرٌّ» -يعني أَبا بَكْرٍ وبِلالًا- فكان عَمرٌو يقولُ: لقد رَأَيْتُني وأَنا رُبْعُ –أَوْ: رابِعُ- الإسْلامِ، قالَ: فَأَسْلَمْتُ. قُلْتُ: أَتْبَعُكَ يا رسولَ اللهِ، قالَ: «لا، ولَكِنِ الْحَقْ بِقَوْمِكَ، فإذا أُخْبِرْتَ أَنِّي قدْ خَرَجْتُ فاتَّبِعْني». قالَ: فَلَحِقْتُ بِقَوْمي، وَجَعَلْتُ أَتَوَقَّع خَبَرَهُ وخُروجَهُ حتَّى أَقَبَلَتْ رُفْقَةٌ مِنْ يَثْرِبَ فَلَقيتُهُمْ، فَسَأَلْتُهُمْ عَنِ الخَبَرِ، فقالوا: قد خَرَجَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ مِنْ مَكَّةَ إلى المَدينَةِ، قلتُ: وقد أَتاها؟ قالوا: نَعَمْ، قالَ: فارْتَحَلْتُ حتَّى أَتَيْتُهُ. قُلتُ: أَتَعْرِفُني يا رسولَ اللَّهِ؟ قالَ: «نَعَمْ، أنتَ الرَّجُلُ الَّذي أَتاني بِمكَّةَ». فَجَعَلْتُ أَتَحَيَّنُ خَلْوَتَهُ، فلَمَّا خَلا قُلْتُ: يا رسولَ اللهِ، عَلِّمْني مِمَّا عَلَّمَكَ اللهُ وَأَجْهَلُ، قالَ: «فَسَلْ عَمَّ شِئْتَ»، قُلْتُ: أَيُّ اللَّيْلِ أَسْمَعُ؟ قالَ: «جَوْفُ اللَّيْلِ الآخِرِ فَصَلِّ ما شِئْتَ؛ فإنَّ الصَّلاةَ مَشْهودَةٌ، مَكْتوبةٌ حتَّى تُصَلِّيَ الصُّبْحَ، ثُمَّ أَقْصِرْ حتَّى تَطْلُعَ الشَّمْسُ فَتَرْتَفِعُ قِيدَ رُمْحٍ أَوْ رُمْحَيْنِ؛ فإنَّها تَطْلُعُ بينَ قَرْنَيْ شَيْطانٍ، وتُصَلِّي لها الكُفَّارُ، ثُمَّ صَلِّ ما شِئْتَ، فإنَّ الصَّلاةَ مَشْهودَةٌ مَكْتوبَةٌ حتَّى يَعْدِلَ الرُّمْحُ ظِلَّهُ، ثُمَّ أَقْصِرْ؛ فإنَّ جَهَنَّمَ تُسْجَرُ وتُفْتَحُ أَبْوابُها، فإذا زالَتِ الشَّمْسُ فَصَلِّ ما شِئْتَ، فإنَّ الصَّلاةَ مَشْهودَةٌ مَكْتوبَةٌ، ثُمَّ صَلِّ حتَّى تُصَلِّي العَصْرَ ثُمَّ أَقْصِرْ حتَّى تَغْربَ الشَّمْسُ؛ فإنَّها تَغْرُبُ بينَ قَرْنَيْ شَيْطانٍ، وتُصَلِّي لها الكُفَّارُ، ",["وإذا تَوَضَّأْتَ فاغْسِلْ يَدَيْكَ",1],"؛ ",["فإنَّكَ إذا غَسَلْتَ يَدَيْكَ خَرَجَتْ خَطاياكَ مِنْ أَظْفارِ أَنامِلِكَ، ثُمَّ إذا غَسَلْتَ وَجْهَكَ خَرَجَتْ خَطاياكَ مِنْ وَجْهِكَ، ثُمَّ إذا مَضْمَضْتَ واسْتَنْثَرْتَ خَرَجَتْ خَطاياكَ مِنْ مَناخِرِكَ، ثُمَّ إذا غَسَلْتَ يَدَيْكَ خَرَجَتْ خَطاياكَ مِنْ ذِراعَيْكَ، ثُمَّ إذا مَسَحْتَ بِرَأْسِكَ خَرَجَتْ خَطاياكَ مِنْ أَطْرافِ شَعْرِكَ، ثُمَّ إذا غَسَلْتَ رِجْلَيْكَ خَرَجَتْ خَطاياكَ مِنْ رِجْلَيْكَ",2],"، فإنْ ثَبَتَّ في مَجْلِسِكَ كان لكَ حَظُّكَ مِنْ وُضوئِكَ، وإنْ قُمْتَ فَذَكَرْتَ رَبَّكَ، وحَمِدْتَه، ورَكَعتَهُ ركْعَتَيْنِ مُقْبِلًا عليهما بِقَلْبِكَ كُنْتَ مِنْ خَطاياكَ كَيَوْمِ وَلَدَتْكَ أُمُّكَ»."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (17026)، وابن أبي شيبة في ((مسنده)) (755)، والطبراني في ((مسند الشاميين)) (1847) جميعا بطوله.","bab":"وضوء › فضل الوضوء","dorar":"C94n0qYy"},{"id":"س-01458","fp":"c12c23365221","stateId":77,"easy":"إذا أسبغت الوضوء على مواضعه ← تخرج خطاياك من سمعك وبصرك ويديك ورجليك وتكون صلاتك زيادة لك","cause":"ما من مُسلِمٍ يتوضَّأُ فيُسبِغُ وُضوءَه مواضِعَه","result":"إلَّا خرجت خطاياه من سمعِه وبصَرِه ويدَيه ورِجلَيه، وكانت صلاتُه له فَضلًا","explicit":true,"ref":"المصابيح في الأحاديث المتواترة 616","srcLabel":"المصابيح في الأحاديث المتواترة","text":[["ما من مُسلِمٍ يتوضَّأُ فيُسبِغُ وُضوءَه مواضِعَه",1]," ",["إلَّا خرجت خطاياه من سمعِه وبصَرِه ويدَيه ورِجلَيه، وكانت صلاتُه له فَضلًا",2]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"وضوء › فضل الوضوء","dorar":"4zdl713D"},{"id":"س-01466","fp":"4d990a24b656","stateId":77,"easy":"إذا تمضمضت وغسلت وجهك ويديك ومسحت رأسك وغسلت قدميك ← يُحط عنك ما أصابته كل جارحة","cause":"إذا تمضمَضَ أحدُكُم حُطَّ ما أصابَ بفيهِ، وإذا غسلَ وجهَهُ حُطَّ ما أصابَ بوجهِهِ، وإذا غسلَ يديهِ حُطَّ ما أصابَ بيديهِ، وإذا مَسحَ برأسِهِ","result":"تَناثَرَت خطاياهُ مِن أصولِ الشَّعرِ، وإذا غسلَ قدميهِ حطَّ ما أصابَ برجليهِ","explicit":true,"ref":"نخب الافكار 1/333","srcLabel":"الطبراني","text":[["إذا تمضمَضَ أحدُكُم حُطَّ ما أصابَ بفيهِ، وإذا غسلَ وجهَهُ حُطَّ ما أصابَ بوجهِهِ، وإذا غسلَ يديهِ حُطَّ ما أصابَ بيديهِ، وإذا مَسحَ برأسِهِ ",1],["تَناثَرَت خطاياهُ مِن أصولِ الشَّعرِ، وإذا غسلَ قدميهِ حطَّ ما أصابَ برجليهِ",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"[رجاله] رجال الصحيح","takhrij":"أخرجه الطبراني (8/300) (7983)","bab":"وضوء › فضل الوضوء","dorar":"EktqsWTN"},{"id":"س-02048","fp":"fc02046fc7e6","stateId":77,"easy":"إذا توضأت ← يكفّر الوضوء ما قبله","cause":"الوُضوءُ","result":"يُكفِّرُ ما قَبلَه","explicit":true,"ref":"صحيح الترغيب 187","srcLabel":"أحمد","text":[["الوُضوءُ ",1],["يُكفِّرُ ما قَبلَه ",2],"، ثمَّ تَصيرُ الصَّلاةُ نافِلةً"],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (22307)، والطيالسي (1225)، والطبراني (8/147) (7570).","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"HWL0G4JD"},{"id":"س-03354","fp":"8fed3cc1e95d","stateId":77,"easy":"إذا توضأت ← تخرج ذنوبك من سمعك وبصرك ويديك ورجليك، فإن قعدت قعدت مغفوراً لك","cause":"إذا تَوضَّأَ الرَّجلُ المسلِمُ خرجَت ذنوبُه مِن سَمعِه و بصَرِه ، و يديْهِ و رجليْهِ","result":"فإن قعَدَ قعَدَ مَغفورًا لهُ","explicit":true,"similar":["س-01428"],"ref":"صحيح الترغيب 187","srcLabel":"أحمد","text":[["إذا تَوضَّأَ الرَّجلُ المسلِمُ خرجَت ذنوبُه مِن سَمعِه و بصَرِه ، و يديْهِ و رجليْهِ ، ",1],["فإن قعَدَ قعَدَ مَغفورًا لهُ ",2],"."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (22225)","bab":"استغفار › أسباب المغفرة","dorar":"eWxt94Fw"},{"id":"س-06495","fp":"dfdf0f239860","stateId":77,"easy":"إذا أحسنت الوضوء فغسلت وجهك حتى يسيل الماء على ذقنك ← يُغفر لك ما سلف من ذنبك","cause":"ما مِن عبدٍ يتَوضَّأُ فيُحْسِنُ الوُضوءَ فيغسِلُ وجهَه حتَّى يَسيلَ الماءُ على ذَقنِه ، ثمَّ يغسلُ ذراعيه حتَّى يَسيلَ الماءُ على مِرفَقيْهِ ، ثمَّ غسَل رِجلَيهِ حتَّى يَسيلَ الماءُ من كَعبيهِ ، ثمَّ يقومُ فيُصلِّي","result":"إلَّا غُفِرَ لهُ ما سلَفَ مِن ذنبِهِ","explicit":true,"ref":"صحيح الترغيب 188","srcLabel":"الطحاوي","text":[["ما مِن عبدٍ يتَوضَّأُ فيُحْسِنُ الوُضوءَ فيغسِلُ وجهَه حتَّى يَسيلَ الماءُ على ذَقنِه ، ثمَّ يغسلُ ذراعيه حتَّى يَسيلَ الماءُ على مِرفَقيْهِ ، ثمَّ غسَل رِجلَيهِ حتَّى يَسيلَ الماءُ من كَعبيهِ ، ثمَّ يقومُ فيُصلِّي",1]," ",["إلَّا غُفِرَ لهُ ما سلَفَ مِن ذنبِهِ",2]],"grade":"صحيح","narrator":"عباد العبدي البصري","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطحاوي في ((شرح معاني الآثار)) (182)، وأبو نعيم الأصبهاني في ((معرفة الصحابة)) (4861) كلاهما باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"N1ZeFgTI"},{"id":"س-06496","fp":"3221be4a01fb","stateId":77,"easy":"إذا توضأت فغسلت يديك ووجهك ← يُكفّر عنك ما عملت يداك وما نظرت إليه عيناك","cause":"إذا توضأ المسلمُ ، فغسل يدَيه","result":"كُفِّر عنه ما عملَت يداه ، فإذا غسل وجهَه كُفِّر عنه ما نظرَت إليه عيناه ، و إذا مسح برأسِه كُفِّرَ به ما سمعَت أُذُناه ، فإذا غسل رجلَيه كُفِّر عنه ما مشت إليه قدماه","explicit":true,"ref":"صحيح الترغيب 187","srcLabel":"الطبراني","text":[["إذا توضأ المسلمُ ، فغسل يدَيه ",1],["كُفِّر عنه ما عملَت يداه ، فإذا غسل وجهَه كُفِّر عنه ما نظرَت إليه عيناه ، و إذا مسح برأسِه كُفِّرَ به ما سمعَت أُذُناه ، فإذا غسل رجلَيه كُفِّر عنه ما مشت إليه قدماه",2]," ، ثم يقوم إلى الصلاةِ فهي فضيلةٌ"],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني في ((المعجم الصغير)) (1099)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"Csw1zbaS"},{"id":"س-01389","fp":"1bd5e0accbb3","stateId":77,"easy":"إذا أحسنت الوضوء ← إن قعدت قعدت مغفوراً لك، وإن صليت كانت لك فضيلة","cause":"إذا توضَّأ الرَّجُلُ المسلِمُ فأحسَن الوُضوءَ","result":"فإن قعد قعد مغفورًا له، وإن قام يصَلِّي كانت له فضيلةً","explicit":true,"ref":"سبل الهدى والرشاد 10/403","srcLabel":"أحمد","text":["«",["إذا توضَّأ الرَّجُلُ المسلِمُ فأحسَن الوُضوءَ، ",1],["فإن قعد قعد مغفورًا له، وإن قام يصَلِّي كانت له فضيلةً",2],"، قيل له: نافِلة؟ فقال: إنما النافلةُ للنَّبيِّ صلَّى اللهُ عليه وسلَّم، كيف يكونُ نافلةً وهو يسعى في الخطايا والذُّنوبِ؟ ولكِنْ فضيلةٌ»"],"grade":"حسن","narrator":"أبو أمامة","muhaddith":"إسناده جيد.","takhrij":"أخرجه أحمد (22196)، والبيهقي في ((شعب الإيمان)) (2779) واللفظ لهما، والطبراني (8/ 123) (7560) بنحوه.","bab":"وضوء › إسباغ الوضوء","dorar":"EynMX9VR"},{"id":"س-01428","fp":"cf29758a59c5","stateId":77,"easy":"إذا توضأت ← يذهب الإثم من سمعك وبصرك ويديك ورجليك","cause":"إذا توضأ المسلمُ","result":"ذهب الإثمُ من سمعِه وبصرِه ويدَيه ورجليه","explicit":true,"repOf":"س-03354","ref":"مجمع الزوائد 1/228","text":[["إذا توضأ المسلمُ ",1],["ذهب الإثمُ من سمعِه وبصرِه ويدَيه ورجليه",2]," قال فجاء أبو طيبةَ وهو يحدِّثُنا هذا فقال ما يحدثُكم فذكرنا له الذي حدثنا فقال رجلٌ سمعت عمرَو بنَ عبسةَ يذكرُ عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم وزاد فيه قال قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ما من مسلمٍ يبيتُ على طُهْرٍ ثم يتعارَّ من الليلِ فيذكرُ اللهَ ويسألُ اللهَ خيرًا من خيرِ الدنيا والآخرةِ إلا آتاه اللهُ إياه"],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (17062)","bab":"وضوء › فضل الوضوء","dorar":"CoEvxFS0"},{"id":"س-01431","fp":"6bc95c0a5bfa","stateId":77,"easy":"إذا توضأت لصلاتك ← يكفّر الله بالوضوء ذنوبك وتبقى صلاتك نافلة","cause":"وطُهورُ الرَّجُلِ لِصلاتِهِ","result":"يُكَفِّرُ اللهُ بِهِ ذنوبَهُ ، وتَبْقَى صلاتُهُ لَهُ نافلَةً","explicit":true,"otherNeedIds":[45],"ref":"الجامع الصغير 1958","srcLabel":"الطبراني","text":["إِنَّ الخصْلَةَ الصالِحَةَ تَكونُ في الرَّجُلِ ، فيُصْلِحُ اللهُ لَهُ بها عملَهُ كُلَّهُ ، ",["وطُهورُ الرَّجُلِ لِصلاتِهِ",1]," ",["يُكَفِّرُ اللهُ بِهِ ذنوبَهُ ، وتَبْقَى صلاتُهُ لَهُ نافلَةً",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"أخرجه البزار كما في ((كشف الأستار)) للهيثمي (253)، وأبو يعلى (3297)، والطبراني في ((المعجم الأوسط)) (2006) باختلاف يسير","bab":"وضوء › فضل الوضوء","dorar":"qnNtplqD"},{"id":"س-02027","fp":"f062f821816a","stateId":77,"easy":"إذا سمعت الأذان فقمت إلى الوضوء ← يُغفر لك بأول قطرة تصيب كفك","cause":"ما مِن عَبدٍ مُسلمٍ يسمعُ أذانَ صلاةٍ فقامَ إلى وضوئِهِ","result":"إلَّا غُفِرَ لَه بأوَّلِ قَطرةٍ تصيبُ كفَّهُ مِن ذلِكَ الماءِ ، فبعددِ ذلِكَ القَطرِ ، حتَّى يفرُغَ مِن وضوئِهِ إلَّا غُفِرَ لَه ما سلفَ مِن ذنوبِهِ وقامَ إلى صلاتِهِ وَهو","explicit":true,"apply":{"k":"time","t":"عند الأذان"},"ref":"الصحيح المسند 492","srcLabel":"أحمد","text":[["ما مِن عَبدٍ مُسلمٍ يسمعُ أذانَ صلاةٍ فقامَ إلى وضوئِهِ",1]," ",["إلَّا غُفِرَ لَه بأوَّلِ قَطرةٍ تصيبُ كفَّهُ مِن ذلِكَ الماءِ ، فبعددِ ذلِكَ القَطرِ ، حتَّى يفرُغَ مِن وضوئِهِ إلَّا غُفِرَ لَه ما سلفَ مِن ذنوبِهِ وقامَ إلى صلاتِهِ وَهو",2]," نافلةٌ قالَ أبو غالبٍ قُلتُ لأبي أُمامةَ أأنتَ سمِعتَ هذا مِن رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وعلَى آلِه وسلَّمَ قالَ إي والَّذي بعثَهُ بالحقِّ بَشيرًا ونَذيرًا غيرَ مرَّةٍ ولا مرَّتَينِ ولا ثلاثٍ ولا أربعٍ ولا خمسٍ ولا ستٍّ ولا سبعٍ ولا ثمانٍ ولا تِسعٍ ولا عَشرٍ وعَشرٍ وعَشرٍ وصفَّقَ بيدَيهِ"],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"حسن","takhrij":"أخرجه أحمد (22188)، وابن بشران في ((الأمالي)) (826) واللفظ لهما، والطيالسي (1231)، والروياني في ((المسند)) (2/ 271) بمعناه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"8HGusXoY"},{"id":"س-03372","fp":"9f3066900e0b","stateId":77,"easy":"إذا توضأت فتمضمضت ← تخرج مع الماء كل سيئة تكلم بها لسانك","cause":"ما من مسلمٍ يتوضأُ للصلاةِ فيمضمضُ","result":"إلا خرج معَ قطرِ الماءِ كلُّ سيئةٍ تكلَّم بها لسانُه ولا يستنشقُ إلا خرج معَ قطرِ الماءِ كلُّ سيئةٍ وجدَ ريحَها بأنفِه ولا يغسلُ وجهَه إلا تناثر من عينَيه معَ قطرِ الماءِ كلُّ سيئةٍ نظر إليها بهما","explicit":true,"ref":"مجمع الزوائد 1/231","srcLabel":"الطبراني","text":[["ما من مسلمٍ يتوضأُ للصلاةِ فيمضمضُ",1]," ",["إلا خرج معَ قطرِ الماءِ كلُّ سيئةٍ تكلَّم بها لسانُه ولا يستنشقُ إلا خرج معَ قطرِ الماءِ كلُّ سيئةٍ وجدَ ريحَها بأنفِه ولا يغسلُ وجهَه إلا تناثر من عينَيه معَ قطرِ الماءِ كلُّ سيئةٍ نظر إليها بهما",2]," ولا يغسلُ شيئًا من يديه إلا خرج معَ قطرِ الماءِ كلُّ سيئةٍ بطش بهما ولا يغسلُ شيئًا من رجليه إلا خرج معَ قطرِ الماءِ كلُّ سيئةٍ مشَى بهما إليها فإذا خرج إلى المسجدِ كُتِب له بكلِّ خطوةٍ خطاها حسنةٌ ومُحِيَ بها عنه سيئةٌ حتى يأتِيَ مقامَه"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"رجاله موثقون","takhrij":"أخرجه البزار (9116) باختلاف يسير، والعقيلي في ((الضعفاء الكبير)) (3/133) واللفظ له، والطبراني كما في ((المعجم الأوسط)) كما في ((مجمع الزوائد)) للهيثمي (1/231) مطولاً باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"nR27mGSO"},{"id":"س-07190","fp":"d0f414abcfa1","stateId":77,"easy":"إذا أتممت الوضوء على مواضعه ← تقوم مغفوراً لك","cause":"إذا وضَعْتَ الطَّهورَ مَواضِعَه","result":"قُمْتَ مَغْفورًا لكَ","explicit":true,"ref":"تخريج زاد المعاد 1/313","srcLabel":"أحمد","text":["حدَّثَنا أبو أُمامةَ، قال: ",["إذا وضَعْتَ الطَّهورَ مَواضِعَه",1],"، ",["قُمْتَ مَغْفورًا لكَ",2],"، فإنْ قُمْتَ تُصلِّي، كانت لكَ فَضيلةً وأجْرًا، فقال رجُلٌ: يا أبا أُمامةَ، أرأيْتَ إنْ قام يُصلِّي تكونُ له نافلةً؟ قال: لا، إنَّما النافلةُ للنبيِّ صلَّى اللهُ عليه وسلَّمَ، فكيف يكونُ له نافلةً، وهو يَسْعى في الذنوبِ والخَطايا؟! تكونُ له فَضيلةً وأجْرًا."],"grade":"حسن","narrator":"أبو غالب","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (22196)، والطبراني (8062)(8/ 276) باختلاف يسير، والبيهقي في ((شعب الإيمان))(2524) بنحوه.","bab":"علم › حسن السؤال ونصح العالم","dorar":"ct9ei1iw"},{"id":"س-01409","fp":"7ddb47b5b2ec","stateId":78,"easy":"إذا توضأت كوضوء النبي ﷺ ثم صليت ركعتين لا تحدّث فيهما نفسك ← يُغفر لك ما تقدّم من ذنبك","cause":"مَن تَوضَّأ نَحو وُضوئي هذا ثُمَّ قامَ فرَكَعَ رَكعَتَينِ لا يُحَدِّثُ فيهما نَفسَه","result":"غُفِرَ له ما تَقدَّمَ مِن ذَنبِه","explicit":true,"star":true,"apply":{"k":"count","t":"ركعتين"},"similar":["س-05441","س-01400","س-03729","س-04834","س-01132"],"ref":"صحيح مسلم 226","srcLabel":"البخاري","text":["أنَّ عُثمانَ بنَ عَفَّانَ رَضيَ اللهُ عنه دَعا بوَضوءٍ فتَوضَّأ، فغَسَلَ كَفَّيه ثَلاثَ مَرَّاتٍ، ثُمَّ مَضمَضَ واستَنثَرَ، ثُمَّ غَسَلَ وجهَه ثَلاثَ مَرَّاتٍ، ثُمَّ غَسَلَ يَدَه اليُمنى إلى المِرفقِ ثَلاثَ مَرَّاتٍ، ثُمَّ غَسَلَ يَدَه اليُسرى مِثلَ ذلك، ثُمَّ مَسَحَ رَأسَه، ثُمَّ غَسَلَ رِجلَه اليُمنى إلى الكَعبَينِ ثَلاثَ مَرَّاتٍ، ثُمَّ غَسَلَ اليُسرى مِثلَ ذلك. ثُمَّ قال: رَأيتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم تَوضَّأ نَحو وُضوئي هذا، ثُمَّ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["مَن تَوضَّأ نَحو وُضوئي هذا ثُمَّ قامَ فرَكَعَ رَكعَتَينِ لا يُحَدِّثُ فيهما نَفسَه، ",1],["غُفِرَ له ما تَقدَّمَ مِن ذَنبِه",2],". قال ابنُ شِهابٍ: وكانَ عُلَماؤُنا يقولونَ: هذا الوُضوءُ أسبَغُ ما يَتَوضَّأُ به أحَدٌ للصَّلاةِ."],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"[صحيح]","takhrij":"أخرجه ابن خزيمة (3) بلفظه، والنسائي (116) باختلاف يسير، والبخاري (1934) بنحوه.","bab":"وضوء › صفة الوضوء","dorar":"xD2QUBZa","merged":7,"otherRefs":["صحيح النسائي 85 (صحيح)","صحيح البخاري 1934 (صحيح)","تخريج المسند لشعيب 428 (صحيح)","صحيح البخاري 159 (صحيح)","صحيح البخاري 164 (صحيح)","تخريج المسند لشعيب 419 (صحيح)"]},{"id":"س-01419","fp":"2d6d744e3f59","stateId":78,"easy":"إذا توضأت ثم قمت إلى الصلاة ← تسقط خطاياك من وجهك ويديك ورجليك ورأسك","cause":"مَن تَوَضَّأَ وُضوئِي هذا ثُمَّ قامَ إلى الصَّلاة","result":"سَقطَتْ خطاياهُ يَعْنِي مِن وجهِهِ ويدَيْهِ ورِجْلَيْهِ ورأسِهِ","explicit":true,"star":true,"ref":"تخريج المسند لشاكر 1/242","srcLabel":"متفق عليه","text":["أنَّ عُثمانَ توضَّأَ بالمقاعِدِ فَغَسَل ثلاثًا ثلاثًا وقالَ: سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن تَوَضَّأَ وُضوئِي هذا ثُمَّ قامَ إلى الصَّلاة",1]," ",["سَقطَتْ خطاياهُ يَعْنِي مِن وجهِهِ ويدَيْهِ ورِجْلَيْهِ ورأسِهِ",2]],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (159)، ومسلم (226)، وأبو داود (106) جميعهم بنحوه.","bab":"وضوء › صفة الوضوء","dorar":"s9h8M52t","merged":2,"otherRefs":["تخريج شرح السنة 152 (صحيح)"]},{"id":"س-03296","fp":"6e913dca41c8","stateId":78,"easy":"إذا أحسنت الوضوء ثم دخلت فصليت ← يُغفر لك ما بينها وبين الصلاة التالية","cause":"مَن توضَّأَ فأحسنَ الوضوءَ ، ثمَّ دخلَ فصلَّى","result":"غفرَ لَهُ ما بينَهُ وبينَ الصَّلاةِ الأخرى حتَّى يصلِّيَها","explicit":true,"star":true,"apply":{"k":"time","t":"بعد الوضوء"},"similar":["س-06613","س-03422"],"ref":"تخريج المسند لشاكر 1/199","srcLabel":"متفق عليه","text":["توضَّأَ عُثمانُ رضيَ اللَّهُ عنهُ على البَلاطِ ثمَّ قالَ : لأحدِّثنَّكم حديثًا سَمِعْتُهُ مِن رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ، لولا آيةٌ في كتابِ اللَّهِ ما حدَّثتُكُموهُ ، سَمِعْتُ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ ، يقولُ : ",["مَن توضَّأَ فأحسنَ الوضوءَ ، ثمَّ دخلَ فصلَّى ، ",1],["غفرَ لَهُ ما بينَهُ وبينَ الصَّلاةِ الأخرى حتَّى يصلِّيَها",2]],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (159)، ومسلم (226)، وأبو داود (106) جميعهم بنحوه.","bab":"استغفار › أسباب المغفرة","dorar":"lPHIEwag","merged":2,"otherRefs":["صحيح ابن خزيمة 1/ 119 (صحيح)"]},{"id":"س-06613","fp":"b5e5af5ce6e2","stateId":78,"easy":"إذا أحسنت الوضوء ثم صليت ← يغفر الله لك ما بينها وبين الصلاة التي تليها","cause":"لا يَتَوضَّأُ رَجُلٌ مُسلِمٌ فيُحسِنُ الوُضوءَ فيُصَلِّي صَلاةً","result":"إلَّا غَفَرَ اللهُ له ما بينَه وبينَ الصَّلاةِ التي تَليها","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"repOf":"س-03296","ref":"صحيح مسلم 227","text":["سَمِعتُ عُثمانَ بنَ عَفَّانَ وهو بفِناءِ المَسجِدِ فجاءَه المُؤَذِّنُ عِندَ العَصرِ، فدَعا بوَضوءٍ فتَوضَّأ، ثُمَّ قال: واللهِ لأُحَدِّثَنَّكُم حَديثًا لَولا آيةٌ في كِتابِ اللهِ ما حَدَّثتُكُم، إنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["لا يَتَوضَّأُ رَجُلٌ مُسلِمٌ فيُحسِنُ الوُضوءَ فيُصَلِّي صَلاةً",1]," ",["إلَّا غَفَرَ اللهُ له ما بينَه وبينَ الصَّلاةِ التي تَليها",2],". وفي روايةٍ: فيُحسِنُ وُضوءَه ثُمَّ يُصَلِّي المَكتوبةَ."],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (400) باختلاف يسير وابن أبي شيبة (7727) والحميدي (35) مختصرا وأخرجه البخاري (6433) بنحوه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"3T3OfFfL","merged":2,"otherRefs":["صحيح مسلم 227 (صحيح)"]},{"id":"س-05441","fp":"0ff2a4d9cc1c","stateId":78,"easy":"إذا توضأت كوضوء النبي ﷺ ثم أتيت المسجد فركعت ركعتين ← يُغفر لك ما تقدّم من ذنبك","cause":"مَن تَوضَّأ مِثلَ هذا الوُضوءِ، ثُمَّ أتى المَسجِدَ فرَكَعَ رَكعَتَينِ، ثُمَّ جَلَسَ","result":"غُفِرَ له ما تَقدَّمَ مِن ذَنبِه","explicit":true,"apply":{"k":"count","t":"ركعتين"},"repOf":"س-01409","ref":"صحيح البخاري 6433","text":["أتَيتُ عُثمانَ بنَ عَفَّانَ بطَهورٍ وهو جالِسٌ على المَقاعِدِ، فتَوضَّأ فأحسَنَ الوُضوءَ، ثُمَّ قال: رَأيتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم تَوضَّأ وهو في هذا المَجلِسِ، فأحسَنَ الوُضوءَ، ثُمَّ قال: ",["مَن تَوضَّأ مِثلَ هذا الوُضوءِ، ثُمَّ أتى المَسجِدَ فرَكَعَ رَكعَتَينِ، ثُمَّ جَلَسَ، ",1],["غُفِرَ له ما تَقدَّمَ مِن ذَنبِه",2]," قال: وقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: لا تَغتَرُّوا."],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (226) باختلاف يسير","bab":"رقائق وزهد › الخوف من الله","dorar":"fmIsW9jO","merged":3,"otherRefs":["تخريج مشكل الآثار 2506 (صحيح)","تخريج المسند لشاكر 1/227 (صحيح)"]},{"id":"س-01400","fp":"f6cf6abc4657","stateId":78,"easy":"إذا توضأت كوضوء النبي ﷺ ثم صليت ركعتين بخشوع ← يُغفر لك ما بينها وبين صلاتك السابقة","cause":"مَن توضَّأَ كما توضَّأتُ ، ثمَّ رَكَعَ رَكْعتينِ لا يحدِّثُ فيهِما نفسَهُ","result":"غُفرَ لَهُ ما كانَ بينَهُما وبينَ صلاتِهِ بالأمسِ","explicit":true,"apply":{"k":"count","t":"ركعتين"},"repOf":"س-01409","ref":"تخريج المسند لشاكر 1/240","text":["رأيتُ عثمانَ بنَ عفَّانَ رضيَ اللَّهُ عنهُ دعا بوَضوءٍ وَهوَ على بابِ المسجدِ فغسلَ يديهِ ثمَّ مضمضَ واستنشقَ واستنثرَ ، ثمَّ غسلَ وجهَهُ ثلاثَ مرَّاتٍ ، ثمَّ غسلَ يديهِ إلى المرفقينِ ثلاثَ مرَّاتٍ ، ثمَّ مسحَ برأسِهِ وأمرَّ بيديهِ على ظاهرِ أذُنَيْهِ ، ثمَّ مرَّ بِهِما على لحيتِهِ ، ثمَّ غسلَ رجليهِ إلى الكعبينِ ثلاثَ مرَّاتٍ ، ثمَّ قامَ فرَكَعَ رَكْعتين ، ثمَّ قالَ : توضَّأتُ لَكُم كما رأيتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ توضَّأَ ، ثمَّ رَكَعتُ رَكْعتينِ كما رأيتُهُ رَكَعَ ، قالَ : ثمَّ قالَ : قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ حينَ فرغَ من رَكْعتيهِ : ",["مَن توضَّأَ كما توضَّأتُ ، ثمَّ رَكَعَ رَكْعتينِ لا يحدِّثُ فيهِما نفسَهُ ، ",1],["غُفرَ لَهُ ما كانَ بينَهُما وبينَ صلاتِهِ بالأمسِ",2]],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (1934)، ومسلم (226) باختلاف يسير","bab":"وضوء › صفة الوضوء","dorar":"TPN7Jmer"},{"id":"س-01423","fp":"30c7df13d43f","stateId":78,"easy":"إذا توضأت ثم صليت الظهر ← يُغفر لك ما بينها وبين الصبح، وكذلك بقية الصلوات","cause":"فمَن تَوَضَّأَ وُضوئي هذا ثُمَّ قامَ فصلَّى الظُّهْرَ","result":"غُفِرَ له ما كانَ بَيْنَها وبَيْنَ صَلاةِ الصُّبْحِ، ثُمَّ صلَّى العَصْرَ غُفِرَ له ما بَيْنَها وبَيْنَ الظُّهْرِ، ثُمَّ صلَّى المَغرِبَ غُفِرَ له ما كان بَيْنَها وبَيْنَ صَلاةِ العَصْرِ، ثُمَّ صلَّى","explicit":true,"star":true,"ref":"الأحاديث المختارة 323","srcLabel":"البخاري","text":["«جَلَسَ عُثْمانُ يَوْمًا وجَلَسْنا معَه فجاءَ المُؤَذِّنُ، فدَعا بماءٍ في إناءٍ -قالَ: أَظُنُّه يكونُ قَدْرَ مُدٍّ- فتَوَضَّأَ، ثُمَّ قالَ: رَأَيْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَتَوضَّأُ وُضوئي هذا، قالَ: ",["فمَن تَوَضَّأَ وُضوئي هذا ثُمَّ قامَ فصلَّى الظُّهْرَ، ",1],["غُفِرَ له ما كانَ بَيْنَها وبَيْنَ صَلاةِ الصُّبْحِ، ثُمَّ صلَّى العَصْرَ غُفِرَ له ما بَيْنَها وبَيْنَ الظُّهْرِ، ثُمَّ صلَّى المَغرِبَ غُفِرَ له ما كان بَيْنَها وبَيْنَ صَلاةِ العَصْرِ، ثُمَّ صلَّى",2]," العِشاءَ غُفِرَ له ما كانَ بَيْنَها وبَيْنَ صَلاةِ المَغرِبِ، ثُمَّ لَعلَّه أن يَبيتَ يَتَمرَّغُ لَيْلتَه، ثُمَّ إن قامَ فتَوَضَّأَ فصلَّى صَلاةَ الصُّبْحَ غُفِرَ له ما كانَ بَيْنَها وبَيْنَ العِشاءِ، هنَّ الحَسَناتُ يُذهِبْنَ السَّيِّئاتِ، قالوا: هذه الحَسَناتُ، فما الباقِياتُ الصَّالِحاتُ يا عُثْمانُ؟ قالَ: هنَّ (لا إلهَ إلَّا اللهُ، وسُبْحانَ اللهِ، والحَمْدُ للهِ، واللهُ أَكبَرُ، ولا حَوْلَ ولا قُوَّةَ إلَّا باللهِ)»."],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"وضوء › صفة الوضوء","dorar":"YWfWliGQ"},{"id":"س-03325","fp":"3a8621f80623","stateId":78,"easy":"إذا توضأت كوضوء النبي ﷺ ثم خرجت إلى المسجد لا يدفعك إلا الصلاة ← يُغفر لك ما مضى من ذنبك","cause":"مَن تَوضَّأ هَكَذا، ثُمَّ خَرَجَ إلى المَسجِدِ لا يَنهَزُه إلَّا الصَّلاةُ","result":"غُفِرَ له ما خَلا مِن ذَنبِه","explicit":true,"ref":"صحيح مسلم 232","srcLabel":"متفق عليه","text":["تَوضَّأ عُثمانُ بنُ عَفَّانَ يَومًا وُضوءًا حَسَنًا، ثُمَّ قال: رَأيتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم تَوضَّأ فأحسَنَ الوُضوءَ، ثُمَّ قال: ",["مَن تَوضَّأ هَكَذا، ثُمَّ خَرَجَ إلى المَسجِدِ لا يَنهَزُه إلَّا الصَّلاةُ، ",1],["غُفِرَ له ما خَلا مِن ذَنبِه",2],"."],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"[صحيح]","takhrij":"أخرجه أبو عوانة (1237)، وأبي نعيم في ((المستخرج على مسلم)) (549) كلاهم بلفظه، والبخاري (159) بمعناه أثناء حديث مطولا.","bab":"استغفار › أسباب المغفرة","dorar":"QStIw1o8"},{"id":"س-03729","fp":"3a759c3659ca","stateId":78,"easy":"إذا توضأت كوضوء النبي ﷺ ← يُغفر لك ما تقدّم من ذنبك وتكون صلاتك ومشيك نافلة","cause":"مَن تَوضَّأ هَكَذا","result":"غُفِرَ له ما تَقدَّمَ مِن ذَنبِه، وكانَت صَلاتُه ومَشيُه إلى المَسجِدِ نافِلةً","explicit":true,"repOf":"س-01409","ref":"صحيح مسلم 229","text":["أتَيتُ عُثمانَ بنَ عَفَّانَ بوَضوءٍ فتَوضَّأ، ثُمَّ قال: إنَّ ناسًا يَتَحَدَّثونَ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم أحاديثَ لا أدري ما هي؟ إلَّا أنِّي رَأيتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم تَوضَّأ مِثلَ وُضوئي هذا، ثُمَّ قال: ",["مَن تَوضَّأ هَكَذا ",1],["غُفِرَ له ما تَقدَّمَ مِن ذَنبِه، وكانَت صَلاتُه ومَشيُه إلى المَسجِدِ نافِلةً",2],"."],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (159) بنحوه","bab":"اعتصام بالسنة › لزوم السنة","dorar":"QvEGYo36"},{"id":"س-06614","fp":"436e270a5685","stateId":78,"easy":"إذا أتممت الطهور ثم صليت الخمس ← تكون كفارات لما بينها","cause":"ما مِن مُسلِمٍ يَتَطَهَّرُ، فيُتِمُّ الطُّهورَ الذي كَتَبَ اللهُ عليه، فيُصَلِّي هذه الصَّلَواتِ الخَمسَ","result":"إلَّا كانَت كَفَّاراتٍ لِما بينَها","explicit":true,"ref":"صحيح مسلم 231","srcLabel":"البخاري","text":["كُنتُ أضَعُ لعُثمانَ طَهورَه، فما أتى عليه يَومٌ إلَّا وهو يُفيضُ عليه نُطفةً، وقال عُثمانُ: حَدَّثَنا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم عِندَ انصِرافِنا مِن صَلاتِنا هذه، قال مِسعَرٌ: أُراها العَصرَ، فقال: ما أدري أُحَدِّثُكُم بشيءٍ أو أسكُتُ؟ فقُلنا: يا رَسولَ اللهِ، إن كانَ خَيرًا فحَدِّثْنا، وإن كانَ غيرَ ذلك فاللهُ ورسولُه أعلَمُ، قال: ",["ما مِن مُسلِمٍ يَتَطَهَّرُ، فيُتِمُّ الطُّهورَ الذي كَتَبَ اللهُ عليه، فيُصَلِّي هذه الصَّلَواتِ الخَمسَ،",1]," ",["إلَّا كانَت كَفَّاراتٍ لِما بينَها",2],"."],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"[صحيح]","takhrij":"أخرجه البيهقي بلفظه واختلاف يسير (2469)، والبخاري (159)، وأحمد (421)، والدارمي (720) بمعناه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"xlxZjB4f"},{"id":"س-06620","fp":"772953775fe2","stateId":78,"easy":"إذا أتممت الوضوء كما أمر الله ← تكون الصلوات المكتوبة كفارات لما بينهن","cause":"مَن أتَمَّ الوُضوءَ كما أمَرَه اللهُ تَعالى","result":"فالصَّلَواتُ المَكتوباتُ كَفَّاراتٌ لما بينَهنَّ","explicit":true,"similar":["س-01468"],"ref":"صحيح مسلم 231","srcLabel":"البخاري","text":["سَمِعتُ حُمرانَ بنَ أبانَ يُحَدِّثُ أبا بُردةَ في هذا المَسجِدِ في إمارةِ بشرٍ أنَّ عُثمانَ بنَ عَفَّانَ قال: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["مَن أتَمَّ الوُضوءَ كما أمَرَه اللهُ تَعالى ",1],["فالصَّلَواتُ المَكتوباتُ كَفَّاراتٌ لما بينَهنَّ",2],". هذا حَديثُ ابنِ مُعاذٍ، وليسَ في حَديثِ غُندَرٍ: في إمارةِ بشرٍ، ولا ذِكرُ المَكتوباتِ"],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (160) بنحوه، والنسائي (145) وابن ماجه (459) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"2nBEJRZ9"},{"id":"س-03422","fp":"d1b8f5b90bfe","stateId":78,"easy":"إذا أحسنت الوضوء ثم صليت ← يغفر الله لك ما بينها وبين الصلاة التالية","cause":"ما مِن امرئٍ يتوضَّأُ فيُحسِنُ الوضوءَ ثمَّ يُصَلِّي الصَّلاةَ","result":"إلَّا غفَر اللهُ له ما بينَه وبيْنَ الصَّلاةِ الأخرى حتَّى يُصَلِّيَها","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"repOf":"س-03296","ref":"تخريج صحيح ابن حبان 1041","text":["أنَّ عثمانَ بنَ عفَّانَ جلَس على المقاعدِ فجاءه المؤذِّنُ فآذَنه بصلاةِ العصرِ فدعا بماءٍ فتوضَّأ ثمَّ قال: لَأُحَدِّثَنَّكم حديثًا لولا آيةٌ في كتابِ اللهِ لَمَا حدَّثْتُكموه ثمَّ قال: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( ",["ما مِن امرئٍ يتوضَّأُ فيُحسِنُ الوضوءَ ثمَّ يُصَلِّي الصَّلاةَ",1]," ",["إلَّا غفَر اللهُ له ما بينَه وبيْنَ الصَّلاةِ الأخرى حتَّى يُصَلِّيَها )",2]," \nقال مالكٌ: أراه يُريدُ هذه الآيةَ: {أَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ إِنَّ الْحَسَنَاتِ يُذْهِبْنَ السَّيِّئَاتِ ذَلِكَ ذِكْرَى لِلذَّاكِرِينَ} [هود: 114]"],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه ابن حبان (1041) واللفظ له، ومسلم (227)، ومالك (83) كلاهما باختلاف يسير، وأحمد (400) بنحوه مختصرا.","bab":"استغفار › أسباب المغفرة","dorar":"trVTIDwj","merged":2,"otherRefs":["صحيح الجامع 5689 (صحيح)"]},{"id":"س-01468","fp":"5e236640cf93","stateId":78,"easy":"إذا أتممت الوضوء كما أمر الله ← تكون الصلوات الخمس كفارة لما بينها","cause":"مَن أتمَّ الوضوءَ كما أمَره اللهُ جلَّ وعلا","result":"فالصَّلواتُ الخَمْسُ كفَّارةٌ لِما بينهنَّ","explicit":true,"repOf":"س-06620","ref":"تخريج صحيح ابن حبان 1043","text":[["مَن أتمَّ الوضوءَ كما أمَره اللهُ جلَّ وعلا ",1],["فالصَّلواتُ الخَمْسُ كفَّارةٌ لِما بينهنَّ",2]],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"إسناده صحيح على شرطهما","takhrij":"أخرجه مسلم (231) بلفظه","bab":"وضوء › فضل الوضوء","dorar":"FEmnRdQV"},{"id":"س-06529","fp":"bb80304667cb","stateId":78,"easy":"إذا أحسنت الوضوء ثم أتممت ركوع الصلاة وسجودها ← تكفّر ما بينها وبين الصلاة الأخرى ما لم تكن كبيرة","cause":"مَن توضَّأَ هذا الوُضوءَ، فأحسَنَ الوُضوءَ، ثمَّ قامَ إلى الصلاةِ، فأتَمَّ ركوعَها وسجودَها","result":"كَفَّرَتْ عنه ما بينَها وبينَ الصلاةِ الأُخرى، ما لم يُصِبْ مَقتَلةً؛ يعني: كبيرةً","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"ref":"تخريج المسند لشعيب 484","srcLabel":"مسلم","text":["عن حُمْرانَ، قال: كان عُثمانُ يَغتسلُ كلَّ يومٍ مرَّةً منذُ أسلَمَ، فوَضَعتُ وَضوءًا له ذاتَ يومٍ للصلاةِ، فلمَّا توضَّأَ، قال: إنِّي أرَدتُ أنْ أُحدِّثَكم بحديثٍ سَمِعتُه مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، ثمَّ قال: بدا لي ألَّا أُحدِّثَكُموه. فقال الحَكَمُ بنُ أبي العاصِ: يا أميرَ المؤمنينَ، إنْ كان خيرًا فنأخُذُ به، أو شرًّا فنَتَّقِيهِ. قال: فقال: فإنِّي مُحدِّثُكم به؛ توضَّأَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ هذا الوُضوءَ، ثمَّ قال: ",["مَن توضَّأَ هذا الوُضوءَ، فأحسَنَ الوُضوءَ، ثمَّ قامَ إلى الصلاةِ، فأتَمَّ ركوعَها وسجودَها، ",1],["كَفَّرَتْ عنه ما بينَها وبينَ الصلاةِ الأُخرى، ما لم يُصِبْ مَقتَلةً؛ يعني: كبيرةً",2],"."],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"صحيح لغيره","takhrij":"أخرجه مسلم (228) بنحوه، وأحمد (484) واللفظ له","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"cLvby5j7"},{"id":"س-01412","fp":"7028aff1efd7","stateId":78,"easy":"إذا أسبغت الوضوء ثم صليت الفريضة ← يُغفر لك ما عملت جوارحك في ذلك اليوم","cause":"مَن توضَّأ فأسبَغ الوُضوءَ غسَل يدَيْه ووجهَه ومسَح على رأسِه وأذُنَيْه ثُمَّ قام إلى صلاةٍ مفروضةٍ","result":"غفَر اللهُ له في ذلك اليومِ ما مشَتْ إليه رِجلاه وقبَضَت عليه يداه وسمِعَتْ إليه أُذُناه ونظَرَت إليه عيناه وحدَّث به نفسَه من سوءٍ","explicit":true,"ref":"مجمع الزوائد 1/305","srcLabel":"مسلم","text":["دخَلْتُ على أبي أُمامةَ وهو يتفلَّى في المسجدِ ويدفِنُ القَمْلَ في الحصى فقُلْتُ يا أبا أُمامةَ إنَّ رجلًا حدَّثني عنك أنَّك سمِعْتَ رسول اللهِ صلَّى اللهُ عليه وسلَّم يقولُ ",["مَن توضَّأ فأسبَغ الوُضوءَ غسَل يدَيْه ووجهَه ومسَح على رأسِه وأذُنَيْه ثُمَّ قام إلى صلاةٍ مفروضةٍ ",1],["غفَر اللهُ له في ذلك اليومِ ما مشَتْ إليه رِجلاه وقبَضَت عليه يداه وسمِعَتْ إليه أُذُناه ونظَرَت إليه عيناه وحدَّث به نفسَه من سوءٍ",2]," فقال واللهِ لقد سمِعْتُه من النَّبيِّ صلَّى اللهُ عليه وسلَّم مرارًا"],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"من رواية أبي مسلم الثعلبي عنه ولم أر من ذكره وبقية رجاله موثقون","takhrij":"أخرجه أحمد (22326)، والطبراني (8/319) (8032)، وابن شاهين في ((الترغيب في فضائل الأعمال)) (28) باختلاف يسير.","bab":"وضوء › صفة الوضوء","dorar":"vapX2rZZ"},{"id":"س-06546","fp":"17d7ccf63154","stateId":78,"easy":"إذا أحسنت وضوء الصلوات وصليتها لوقتها وأتممت ركوعها وخشوعها ← كان لك عهد عند الله أن يغفر لك","cause":"مَن أَحسَنَ وُضوءَهنَّ، وصَلَّاهنَّ لوَقْتِهنَّ، وأَتَمَّ رُكوعَهنَّ وخُشوعَهنَّ","result":"كانَ على اللهِ عَهْدٌ أن يَغفِرَ له","explicit":true,"ref":"الأحكام الوسطى 1/ 247","srcLabel":"الأحكام الوسطى","text":["عن عَبْدِ اللهِ الصُّنابحيِّ، قالَ: زَعَمَ أبو مُحمَّدٍ أنَّ الوِتْرَ واجِبٌ، فقالَ عُبادةُ بنُ الصَّامِتِ: كَذَبَ أبو مُحمَّدٍ، أَشهَدُ أنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: \"خَمْسُ صَلَواتٍ افْتَرَضَهنَّ اللهُ عَزَّ وجَلَّ، ",["مَن أَحسَنَ وُضوءَهنَّ، وصَلَّاهنَّ لوَقْتِهنَّ، وأَتَمَّ رُكوعَهنَّ وخُشوعَهنَّ، ",1],["كانَ على اللهِ عَهْدٌ أن يَغفِرَ له، ",2],"ومَن لم يَفعَلْ فليس على اللهِ عَهْدٌ؛ إن شاءَ غَفَرَ له، وإن شاءَ عَذَّبَه\"."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"DVkj448X","merged":2,"otherRefs":["صحيح الترغيب 400 (صحيح)"]},{"id":"س-06595","fp":"2f14d932eb76","stateId":78,"easy":"إذا أحسنت وضوء المكتوبة وخشوعها وركوعها ← تكون كفارة لما قبلها ما لم تأتِ كبيرة","cause":"ما مِنِ امرِئٍ مُسلِمٍ تَحضُرُه صَلاةٌ مَكتوبةٌ، فيُحسِنُ وُضوءَها وخُشوعَها ورُكوعَها","result":"إلَّا كانَت كَفَّارةً لِما قَبلَها مِنَ الذُّنوبِ ما لَم يُؤتِ كَبيرةً، وذلك الدَّهرَ كُلَّه","explicit":true,"otherNeedIds":[49],"ref":"صحيح مسلم 228","srcLabel":"ابن حبان","text":["كُنتُ عِندَ عُثمانَ فدَعا بطَهورٍ، فقال: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["ما مِنِ امرِئٍ مُسلِمٍ تَحضُرُه صَلاةٌ مَكتوبةٌ، فيُحسِنُ وُضوءَها وخُشوعَها ورُكوعَها،",1]," ",["إلَّا كانَت كَفَّارةً لِما قَبلَها مِنَ الذُّنوبِ ما لَم يُؤتِ كَبيرةً، وذلك الدَّهرَ كُلَّه",2],"."],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"[صحيح]","takhrij":"أخرجه البزار (411)، وعبد بن حميد (57)، وابن حبان (1044) كلاهما باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"8eRoh96l","merged":2,"otherRefs":["صحيح الجامع 5686 (صحيح)"]},{"id":"س-01453","fp":"9d13b2fa080a","stateId":78,"easy":"إذا أسبغت الوضوء ثم صليت وأنت تعقل ما تقول ← تنصرف من صلاتك بلا ذنب كيوم ولدتك أمك","cause":"ما مِن مسلمٍ يَتوضَّأُ فيُسبِغُ الوُضوءَ، ثُمَّ يقومُ في صلاتِهِ فيَعلَمُ ما يَقولُ","result":"إلَّا انفَتَلَ كيومِ ولدَتْهُ أُمُّهُ مِنَ الخطايا، ليس عليه ذنبٌ","explicit":true,"ref":"المستدرك على الصحيحين 3554","srcLabel":"الروياني","text":["كنَّا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في سفَرٍ، فكنَّا نَتناوبُ الرِّعيَةَ، فلمَّا كانت نَوْبَتي سرَّحتُ إِبِلي، ثُمَّ رُحتُ، فجئتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ وهو يَخطُبُ النَّاسَ فسَمِعْتُهُ يقولُ: «",["ما مِن مسلمٍ يَتوضَّأُ فيُسبِغُ الوُضوءَ، ثُمَّ يقومُ في صلاتِهِ فيَعلَمُ ما يَقولُ",1]," ",["إلَّا انفَتَلَ كيومِ ولدَتْهُ أُمُّهُ مِنَ الخطايا، ليس عليه ذنبٌ»",2],". قالَ: فما مَلكْتُ نفْسي عند ذلك أنْ قلتُ: بَخٍ بَخٍ. فقالَ عُمَرُ -وكنتُ إلى جنبِهِ-: أتعجبُ مِن هذا؟ قد قالَ قبلَ أنْ تَجيءَ ما هو أجودُ منه. فقلتُ: ما هو فِداكَ أبي وأُمِّي؟ قالَ: قالَ: «ما مِن رَجلٍ يَتوضَّأُ فيُسبِغُ الوُضوءَ، ثُمَّ يقولُ عندَ فراغِهِ مِن وُضوئِهِ: أَشهدُ أنْ لا إلهَ إلَّا اللهُ وأَشهدُ أنَّ مُحمَّدًا عبدُهُ ورسولُهُ إلَّا فُتِحتْ له ثمانيةُ أبوابٍ مِنَ الجنَّةِ يَدخلُ مِنْ أيِّها شاءَ». ثُمَّ قالَ: «يُجمعُ النَّاسُ في صَعيدٍ واحدٍ، يَنفذُهم البَصرُ، ويُسمِعُهم الدَّاعي، فيُنادي مُنادٍ: سيَعلمُ أهلُ الجمعِ لمَنِ الكرمُ اليومَ». ثلاثَ مرَّاتٍ. «ثُمَّ يقولُ: «أين الَّذين كانت تَتجافى جُنوبُهم عنِ المضاجِعِ؟»، ثُمَّ يقولُ: «أين الَّذين كانوا {لَا تُلْهِيهِمْ تِجَارَةٌ وَلَا بَيْعٌ عَنْ ذِكْرِ اللَّهِ} [النور: 37] إلى آخرِ الآيةِ، ثُمَّ يُنادي مُنادٍ: سيَعلمُ الجمعُ لمَنِ الكرمُ اليومَ»، ثُمَّ يقولُ: «أين الحمَّادونَ الَّذين كانوا يَحمَدونَ ربَّهم؟»."],"grade":"صحيح","narrator":"عقبة بن عامر الجهني","muhaddith":"صحيح","takhrij":"أخرجه الروياني (251)، وابن عبد البر في ((التمهيد)) (1/ 51)، وأبو موسى المديني في ((اللطائف)) (719) جميعهم دون لفظه الأخير.","bab":"وضوء › فضل الوضوء","dorar":"jTAp8ilA"},{"id":"س-03527","fp":"7872c63ad2b6","stateId":78,"easy":"إذا توضأت كوضوء النبي ﷺ ثم قلت «أشهد أن لا إله إلا الله...» ← يُغفر لك ما بين الوضوءين","cause":"مَن تَوَضَّأَ هكذا، ولم يَتَكلَّمْ، ثُمَّ قالَ: أَشهَدُ أنْ لا إلهَ إلَّا اللهُ وَحْدَه لا شَريكَ له، وأنَّ مُحمَّدًا عَبْدُه ورَسولُه","result":"غُفِرَ له ما بَيْنَ الوُضوءَينِ","explicit":true,"apply":{"k":"say","t":"«أَشهَدُ أنْ لا إلهَ إلَّا اللهُ وَحْدَه لا شَريكَ له، وأنَّ مُحمَّدًا عَبْدُه ورَسولُه»"},"ref":"الأحكام الوسطى 1/ 187","srcLabel":"الأحكام الوسطى","text":["وتَوَضَّأَ ثَلاثًا ثَلاثًا، ثُمَّ قالَ: سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قالَ: \"",["مَن تَوَضَّأَ هكذا، ولم يَتَكلَّمْ، ثُمَّ قالَ: أَشهَدُ أنْ لا إلهَ إلَّا اللهُ وَحْدَه لا شَريكَ له، وأنَّ مُحمَّدًا عَبْدُه ورَسولُه",1],"، ",["غُفِرَ له ما بَيْنَ الوُضوءَينِ",2],"."],"grade":"صحيح","narrator":"عثمان","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","bab":"استغفار › مكفرات الذنوب","dorar":"xwJKlnkA"},{"id":"س-04834","fp":"16b9d48e4ebe","stateId":78,"easy":"إذا توضأت كوضوء النبي ﷺ ← يُغفر لك ما تقدّم من ذنبك","cause":"من تَوضَّأ مثلَ وُضُوئي هذا","result":"غُفرَ لَه ما تقدَّمَ من ذنبِه وقالَ رسولُ اللَّهِ صلَّى اللهُ عليهِ وسلَّمَ : ولا تغترُّوا","explicit":true,"repOf":"س-01409","ref":"صحيح الترغيب 182","text":["ولا يغترَّ أحدٌ [يعني حديث: [عن] حمران مولى عثمان بن عفان قال: رأيتُ عثمانَ بنَ عفَّانَ قاعدًا في المقاعدِ . فدعا بوَضُوءٍ فتَوضَّأ. ثمَّ قالَ : رأيتُ رسولَ اللَّهِ صلَّى اللهُ عليهِ وسلَّمَ في مقعدي هذا تَوضَّأ مثلَ وُضُوئي هذا ثمَّ قالَ ",["من تَوضَّأ مثلَ وُضُوئي هذا ",1],["غُفرَ لَه ما تقدَّمَ من ذنبِه وقالَ رسولُ اللَّهِ صلَّى اللهُ عليهِ وسلَّمَ : ولا تغترُّوا",2],"]"],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجة (285)، وأحمد (459)، وابن حبان (360) بنحوه في آخر حديث طويل.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"RQVmAAbp"},{"id":"س-06505","fp":"f4a5e64c879b","stateId":78,"easy":"إذا أسبغت الوضوء ثم مشيت إلى الصلاة المكتوبة فصليتها ← يغفر الله لك ذنوبك","cause":"مَن تَوضَّأ للصَّلاةِ فأسبَغَ الوُضوءَ، ثُمَّ مَشى إلى الصَّلاةِ المَكتوبةِ، فصَلَّاها مع النَّاسِ، أو مع الجَماعةِ، أو في المَسجِدِ","result":"غَفَرَ اللهُ له ذُنوبَه","explicit":true,"ref":"صحيح مسلم 232","srcLabel":"النسائي","text":[["مَن تَوضَّأ للصَّلاةِ فأسبَغَ الوُضوءَ، ثُمَّ مَشى إلى الصَّلاةِ المَكتوبةِ، فصَلَّاها مع النَّاسِ، أو مع الجَماعةِ، أو في المَسجِدِ ",1],["غَفَرَ اللهُ له ذُنوبَه",2],"."],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"[صحيح]","takhrij":"أخرجه النسائي (856)، وأبو عوانة (1572)، والبيهقي (386) واللفظ لهم، وأحمد (483) مختصرا.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"tovMUuQQ"},{"id":"س-06525","fp":"2551f2ad0724","stateId":78,"easy":"إذا أحسنت الوضوء ثم صليت غير ساهٍ ولا لاهٍ ← يُكفّر عنك ما قبلها","cause":"مَن تَوَضَّأَ فأَحسَنَ الوُضوءَ ثمَّ صَلَّى صَلاةً غَيْرَ ساهٍ ولا لاهٍ","result":"كُفِّر عنه ما كان قَبْلَها مِن شَيءٍ","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"ref":"تخريج المسند لشعيب 17449","srcLabel":"النسائي","text":[["مَن تَوَضَّأَ فأَحسَنَ الوُضوءَ ثمَّ صَلَّى صَلاةً غَيْرَ ساهٍ ولا لاهٍ، ",1],["كُفِّر عنه ما كان قَبْلَها مِن شَيءٍ",2],"."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي (151) بنحوه، وأحمد (17449) واللفظ له","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"l4ezIiT5"},{"id":"س-06526","fp":"0a870eb141c5","stateId":78,"easy":"إذا أحسنت الوضوء ثم صليت غير ساهٍ ولا لاهٍ ← يُغفر لك ما تقدّم من ذنبك","cause":"مَن تَوَضَّأَ فأَحسَنَ الوُضوءَ ثمَّ صَلَّى غَيْرَ ساهٍ ولا لاهٍ","result":"غُفِر له ما تقَدَّمَ مِن ذَنْبِه","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"ref":"تخريج المسند لشعيب 17448","srcLabel":"النسائي","text":[["مَن تَوَضَّأَ فأَحسَنَ الوُضوءَ ثمَّ صَلَّى غَيْرَ ساهٍ ولا لاهٍ، ",1],["غُفِر له ما تقَدَّمَ مِن ذَنْبِه",2],". وقال يحيى مرَّةً: غُفِر ما كان قَبْلَها مِن سَيِّئةٍ."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي (151) بنحوه، وأحمد (17448) واللفظ له","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"lNYwo2GO"},{"id":"س-06532","fp":"ef4591e0c559","stateId":78,"easy":"إذا حضرت الصلاة فأحسنت الوضوء والصلاة ← يغفر الله لك ما بينها وبين الصلاة التي قبلها","cause":"ما مِن امرِئٍ مُسلِمٍ تَحضُرُه صَلاةٌ مَكتوبةٌ، فيَقومُ فيَتوضَّأُ فيُحسِنُ الوُضوءَ، ويُصلِّي فيُحسِنُ الصَّلاةَ","result":"إلَّا غَفَرَ اللهُ له بها ما كان بيْنَها وبيْنَ الصَّلاةِ التي كانتْ قبلَها مِن ذُنوبِه","explicit":true,"ref":"تخريج المسند لشعيب 22237","srcLabel":"أحمد","text":[["ما مِن امرِئٍ مُسلِمٍ تَحضُرُه صَلاةٌ مَكتوبةٌ، فيَقومُ فيَتوضَّأُ فيُحسِنُ الوُضوءَ، ويُصلِّي فيُحسِنُ الصَّلاةَ،",1]," ",["إلَّا غَفَرَ اللهُ له بها ما كان بيْنَها وبيْنَ الصَّلاةِ التي كانتْ قبلَها مِن ذُنوبِه",2],"، ثُمَّ تَحضُرُ صَلاةٌ مَكتوبةٌ، فيُصلِّي فيُحسِنُ الصَّلاةَ، إلَّا غُفِرَ له ما بيْنَها وبيْنَ الصَّلاةِ التي كانتْ قبلَها مِن ذُنوبِه، ثُمَّ تَحضُرُ صَلاةٌ مَكتوبةٌ، فيُصلِّي فيُحسِنُ الصَّلاةَ، إلَّا غُفِرَ له ما بيْنَها وبيْنَ الصَّلاةِ التي كانتْ قبلَها مِن ذُنوبِه."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (22237) واللفظ له، والطبراني (8/318) (8031)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"7PS5RHwH"},{"id":"س-06564","fp":"7ccd7f575ebc","stateId":78,"easy":"إذا أحسنت الوضوء ثم صليت الخمس ← تتحاتّ خطاياك كما يتحاتّ الورق","cause":"إن المسلمَ إذا توضأ فأحسنَ الوضوءَ ثم صلَّى الصلواتِ الخمسَ","result":"تحاتَتْ خطاياه كما يتحاتُّ هذا الورقُ وقال َأَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ إِنَّ الْحَسَنَاتِ يُذْهِبْنَ السَّيِّئَاتِ ذَلِكَ ذِكْرَى لِلذَّاكِرِينَ","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"otherNeedIds":[45],"ref":"مجمع الزوائد 1/302","srcLabel":"أحمد","text":["هكذا فعل رسولُ اللهِ صلَّى اللهُ عليه وسلَّم وأنا معَه تحتَ شجرةٍ وأخذ منها غصنًا يابسًا فهزَّه حتى تحاتَّ ورقُه فقال يا سلمانُ ألا تسألُني لِمَ أفعلُ هذا قلت ولِمَ تفعلُه قال ",["إن المسلمَ إذا توضأ فأحسنَ الوضوءَ ثم صلَّى الصلواتِ الخمسَ ",1],["تحاتَتْ خطاياه كما يتحاتُّ هذا الورقُ وقال  َأَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ إِنَّ الْحَسَنَاتِ يُذْهِبْنَ السَّيِّئَاتِ ذَلِكَ ذِكْرَى لِلذَّاكِرِينَ",2]],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"في إسناد أحمد علي بن زيد وهو مختلف في الاحتجاج به وبقية رجاله رجال الصحيح","takhrij":"أخرجه أحمد (23707)، والطبراني (6/ 257) (6151) واللفظ لهما، والدارمي (746) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"4a8av2mQ"},{"id":"س-06628","fp":"67b8de9b6c44","stateId":78,"easy":"إذا توضأت كما أُمرت وصليت كما أُمرت ← يُغفر لك ما قدّمت من عمل","cause":"مَن تَوضَّأَ كما أُمِرَ، وصلَّى كما أُمِرَ","result":"غُفِرَ له ما قَدَّمَ من عَمَلٍ، أكَذاكَ يا عُقْبةُ","explicit":true,"ref":"تخريج المسند لشعيب 23595","srcLabel":"النسائي","text":["عن عاصِمِ بنِ سُفيانَ الثَّقَفيِّ، أنَّهم غَزَوْا غَزْوةَ السَّلاسِلِ، ففاتَهمُ الغَزْوُ فرابَطوا، ثم رَجَعوا إلى مُعاويةَ وعندَه أبو أيُّوبَ، وعُقْبةُ بنُ عامِرٍ، فقال عاصِمٌ: يا أبا أيُّوبَ، فاتَنا الغَزْوُ العامَ، وقد أُخْبِرْنا أنَّه مَن صلَّى في المَسجِدِ -وقال حُجَينٌ: المساجِدِ الأربَعةِ- غُفِرَ له ذَنْبُه، فقال: ابنَ أخي، أدُلُّك على أيسَرَ من ذلك؟ إنِّي سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن تَوضَّأَ كما أُمِرَ، وصلَّى كما أُمِرَ، ",1],["غُفِرَ له ما قَدَّمَ من عَمَلٍ، أكَذاكَ يا عُقْبةُ",2],"؟ قال: نَعَمْ."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"المرفوع منه صحيح لغيره","takhrij":"أخرجه النسائي (144)، وابن ماجه (1396)، وأحمد (23595) واللفظ له","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"W7Q9b4Py"},{"id":"س-01132","fp":"1d1c427d0908","stateId":78,"easy":"إذا توضأت كوضوء النبي ﷺ ثم صليت الصلوات ← يُغفر لك ما بين كل صلاتين","cause":"مَن تَوضَّأَ وُضوئي هذا ، ثمَّ قامَ يُصلِّي صَلاةَ الظُّهرِ","result":"غُفِرَ لهُ ما كان بَينَها و بينَ الصُّبحِ ، ثمَّ صلَّى العَصرَ غُفِرَله ما كان بَينَها و بينَ الظُّهرِ ، ثمَّ صلَّى المغرِبَ غُفِرَ لهُ ما كان بَينَها و بينَ العَصرِ ، ثمَّ صلَّى العِشاءَ غُفِرَله ماكان بَينَها و بينَ المغرِبِ ، ثمَّ لعلَّه يَبِيتُ يَتمرَّغُ ليلَتَه ، ثمَّ إن قامَ فَتَوضَّأَ فَصلَّى الصُّبحَ غُفِرَ لهُ ما بَينَها و بينَ صلاةِ العِشاءِ","explicit":true,"repOf":"س-01409","ref":"صحيح الترغيب 366","text":[["مَن تَوضَّأَ وُضوئي هذا ، ثمَّ قامَ يُصلِّي صَلاةَ الظُّهرِ ، ",1],["غُفِرَ لهُ ما كان بَينَها و بينَ الصُّبحِ ، ثمَّ صلَّى العَصرَ غُفِرَله ما كان بَينَها و بينَ الظُّهرِ ، ثمَّ صلَّى المغرِبَ غُفِرَ لهُ ما كان بَينَها و بينَ العَصرِ ، ثمَّ صلَّى العِشاءَ غُفِرَله ماكان بَينَها و بينَ المغرِبِ ، ثمَّ لعلَّه يَبِيتُ يَتمرَّغُ ليلَتَه ، ثمَّ إن قامَ فَتَوضَّأَ فَصلَّى الصُّبحَ غُفِرَ لهُ ما بَينَها و بينَ صلاةِ العِشاءِ",2]," ، و هُنَّ (الْحَسَنَاتُ يُذْهِبْنَ السَّيِّئَاتِ) قالوا : هذهِ الحسَناتُ ، فما الباقياتُ الصَّالحاتُ يا عُثمانُ ؟ قال : هيَ : لا إلهَ إلَّا اللهُ ، و سُبحانَ اللهِ ، و اللهُ أكبرُ ، و لا حَولَ و لا قُوَّةَ إلَّا باللهِ"],"grade":"حسن","narrator":"عثمان بن عفان","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (513)، والبزار (405)، والطبري في ((التفسير)) (12/ 615)، والبيهقي في ((شعب الإيمان)) (2817) واللفظ لهم.","bab":"أدعية وأذكار › فضل الذكر","dorar":"P15o4jjw"},{"id":"س-03309","fp":"aaa70c444129","stateId":78,"easy":"إذا أحسنت الوضوء ثم صليت ركعتين أو أربعاً تحسن فيها ← يغفر الله لك","cause":"من توضَّأَ فأحسنَ الوضوءَ ثمَّ صلَّى رَكعتينِ أو أربعًا مكتوبةً أو غير مكتوبَةٍ ، يحسِنُ الركوعَ والسجودَ ، ثم استغفرَ اللَّهَ","result":"إلا غَفرَ لَه","explicit":true,"apply":{"k":"count","t":"ركعتين · الوقت: بعد الوضوء"},"ref":"نتائج الأفكار 2/316","srcLabel":"أحمد","text":[["من توضَّأَ فأحسنَ الوضوءَ ثمَّ صلَّى رَكعتينِ أو أربعًا مكتوبةً أو غير مكتوبَةٍ ، يحسِنُ الركوعَ والسجودَ ، ثم استغفرَ اللَّهَ ",1],["إلا غَفرَ لَه",2]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (27546)، وابن أبي عاصم في ((الآحاد والمثاني)) (2040)، والطبراني في ((الدعاء)) (1848)","bab":"استغفار › أسباب المغفرة","dorar":"z1QBcpPu"},{"id":"س-06527","fp":"f3fe43d4857b","stateId":78,"easy":"إذا تطهرت كما أُمرت وصليت كما أُمرت ← تُكفّر عنك ذنوبك","cause":"مَن تَطهَّرَ كما أُمِر، وصلَّى كما أُمِر","result":"كُفِّرتْ عنه ذُنوبُه، فاستَشهَدَ على ذلك أربعةً مِن أصحابِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ","explicit":true,"ref":"تخريج المسند لشعيب 486","srcLabel":"أحمد","text":["حدَّثَني رجُلٌ مِن أهلِ المدينةِ: أنَّ المؤذِّنَ أذَّنَ لصلاةِ العصرِ، قال: فدعا عثمانُ بطَهورٍ فتَطهَّرَ، قال: ثمَّ قال: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن تَطهَّرَ كما أُمِر، وصلَّى كما أُمِر، ",1],["كُفِّرتْ عنه ذُنوبُه، فاستَشهَدَ على ذلك أربعةً مِن أصحابِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ",2],"، قال: فشَهِدوا له بذلك على النبيِّ صلَّى اللهُ عليه وسلَّمَ."],"grade":"حسن","narrator":"عثمان بن عفان","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (486) واللفظ له، والطبراني (1/92) (149)، وأبو نعيم في ((حلية الأولياء)) (5/8)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"5EAAPVjn"},{"id":"س-03338","fp":"00ce5b03b16f","stateId":79,"easy":"إذا أسبغت الوضوء وأكثرت الخطا إلى المساجد وانتظرت الصلاة بعد الصلاة ← تكفّر خطاياك","cause":"إسباغُ الوضوءِ وكثرَةُ الخُطا إلى المساجدِ وانتظارُ الصلاةِ بعدَ الصلاةِ","result":"وكفاراتُ الخطايا","explicit":true,"apply":{"k":"time","t":"دبر كل صلاة، في السجود"},"similar":["س-01381","س-03419","س-01376"],"ref":"مجمع الزوائد 2/40","srcLabel":"مسلم","text":["طَعِمَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم في بيتِ العباسِ أو في بيتِ حمزةَ فقال لَيَتَخَوَّضَنَّ ناسٌ من أمتي على ما أفاءَ اللهُ على رسولِهِ لا يكن لهم حظٌّ غيرَهُ ",["وكفاراتُ الخطايا",2]," ",["إسباغُ الوضوءِ وكثرَةُ الخُطا إلى المساجدِ وانتظارُ الصلاةِ بعدَ الصلاةِ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (251) بنحوه دون ذكر القصة في أوله، والبزار (8129) واللفظ له","bab":"استغفار › أسباب المغفرة","dorar":"yXmKXHPk"},{"id":"س-01381","fp":"d7bb1f41de69","stateId":79,"easy":"إذا أسبغت الوضوء في البرد، ومشيت إلى المساجد، وانتظرت الصلاة بعد الصلاة ← تُغسل خطاياك غسلاً","cause":"إسباغُ الوضوءِ في المكارِهِ وإعمالُ الأقدامِ إلى المساجدِ وانتظارُ الصَّلاةِ بعدَ الصَّلاةِ","result":"يغسلُ الخطايا غسلًا","explicit":true,"apply":{"k":"time","t":"دبر كل صلاة، في السجود"},"repOf":"س-03338","ref":"تحفة الأحوذي 1/130","text":["إنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ ",["إسباغُ الوضوءِ في المكارِهِ وإعمالُ الأقدامِ إلى المساجدِ وانتظارُ الصَّلاةِ بعدَ الصَّلاةِ",1]," ",["يغسلُ الخطايا غسلًا",2]],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"إسناده صحيح","takhrij":"أخرجه الحاكم (456)، وأبو يعلى (488)، والبزار (528) واللفظ لهم.","bab":"وضوء › إسباغ الوضوء","dorar":"EJS6KF12","merged":2,"otherRefs":["المستدرك على الصحيحين 461 (صحيح)"]},{"id":"س-03419","fp":"c16f8cbb18a3","stateId":79,"easy":"إذا أسبغت الوضوء في المكاره وأكثرت الخطا إلى المسجد وانتظرت الصلاة ← تُكفّر خطاياك وتزيد حسناتك","cause":"إسباغُ الوضوءِ والطَّهورِ في المكارهِ ، وكثرةُ الخُطَى إلى هذا المسجدِ ، والصَّلاةُ بعد الصَّلاةِ","result":"ألا أدلُّكم على شيءٍ يُكفِّرُ الخطايا ، ويزيدُ في الحسناتِ","explicit":true,"repOf":"س-03338","otherNeedIds":[45],"ref":"صحيح الموارد 355","text":[["ألا أدلُّكم على شيءٍ يُكفِّرُ الخطايا ، ويزيدُ في الحسناتِ",2]," ؟ ! . قالوا : بلَى يا رسولَ اللهِ ! قال : ",["إسباغُ الوضوءِ والطَّهورِ في المكارهِ ، وكثرةُ الخُطَى إلى هذا المسجدِ ، والصَّلاةُ بعد الصَّلاةِ",1]," ، وما من أحدٍ يخرُجُ من بيتِه مُتطهِّرًا ؛ يأتي المسجدَ ، فيُصلِّي مع المسلمين أو مع الإمامِ ، ثمَّ ينتظِرُ الصَّلاةَ الَّتي بعدُ ؛ إلَّا قالت الملائكةُ : اللَّهمَّ ! اغفِرْ له ، اللَّهمَّ ! ارحَمْه . فإذا قمتم إلى الصَّلاةِ ؛ فاعدِلوا صفوفَكم ، وسُدُّوا الفُرُجَ . فإذا كبَّر الإمامُ فكبِّروا ؛ فإنِّي أراكم من ورائي ، وإذا قال : سمِع اللهُ لمن حمِده ؛ فقولوا : ربَّنا ! ولك الحمدُ . وخيرُ صفوفِ الرِّجالِ المُقدَّمُ ، وشرُّ صفوفِ الرِّجالِ المُؤخَّرُ، وخيرُ صفوفِ النِّساءِ المُؤخَّرُ ، وشرُّ صفوفِ النِّساءِ المُقدَّمُ ، يا معشرَ النِّساءِ ! إذا سجد الرِّجالُ ؛ فاخفِضْن أبصارَكنَّ عن عوراتِ الرِّجالِ . فقلتُ لعبدِ اللهِ بنِ أبي بكرٍ : ما يعني بذلك ؟ قال : ضيقُ الأُزُرِ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (427، 776) مختصرًا، وأحمد (3/ 3) باختلاف يسير جدًّا، والدارمي (1/ 189) مختصرًا.","bab":"استغفار › أسباب المغفرة","dorar":"1bFZlrYc","merged":2,"otherRefs":["صحيح الترغيب 193 (صحيح)"]},{"id":"س-02726","fp":"382bd52c6345","stateId":79,"easy":"إذا بتّ على طهارة ← يبيت معك ملك يستغفر لك كلما تقلبت","cause":"مَن بات طاهرًا","result":"بات في شِعارِه مَلَكٌ فلَمْ يستيقِظْ إلَّا قال المَلَكُ : اللَّهمَّ اغفِرْ لعبدِك فلانٍ فإنَّه بات طاهرًا","explicit":true,"similar":["س-08182"],"otherNeedIds":[24],"ref":"صحيح ابن حبان 1051","srcLabel":"الطبراني","text":[["مَن بات طاهرًا ",1],["بات في شِعارِه مَلَكٌ فلَمْ يستيقِظْ إلَّا قال المَلَكُ : اللَّهمَّ اغفِرْ لعبدِك فلانٍ فإنَّه بات طاهرًا",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البزار كما في ((كشف الأستار)) للهيثمي (288)، والعقيلي في ((الضعفاء الكبير)) (3/362)، والطبراني (12/446) (13621) باختلاف يسير","bab":"إيمان › الملائكة","dorar":"rrlw0nnZ"},{"id":"س-05005","fp":"a25d668dd4d6","stateId":79,"easy":"إذا انتظرت الصلاة بعد الصلاة وأسبغت الوضوء في البرد ومشيت إلى الجماعات ← تكون كفارات لذنوبك","cause":"فانتِظارُ الصَّلاةِ بَعدَ الصَّلاةِ، وإسباغُ الوُضوءِ في السَّبَراتِ، ونَقلُ الأقدامِ إلى الجماعاتِ","result":"وثلاثٌ كفَّاراتٌ","explicit":true,"apply":{"k":"time","t":"دبر كل صلاة"},"ref":"المصابيح في الأحاديث المتواترة 608","srcLabel":"المصابيح في الأحاديث المتواترة","text":["ثلاثٌ مُهلِكاتٌ، وثلاثٌ مُنجياتٌ، ",["وثلاثٌ كفَّاراتٌ",2],"، وثلاثٌ دَرجاتٌ؛ فأمَّا المُهلِكاتُ: فشُحٌّ مُطاعٌ، وهوًى مُتَّبَعٌ، وإعجابُ المرءِ بنفسِه، وأمَّا المُنجياتُ: العَدلُ بالغَضَبِ والرِّضا، والقَصدُ في الفَقرِ والغِنى، وخَشيةُ اللهِ في السِّرِّ والعلانيةِ، وأمَّا الكفَّاراتُ: ",["فانتِظارُ الصَّلاةِ بَعدَ الصَّلاةِ، وإسباغُ الوُضوءِ في السَّبَراتِ، ونَقلُ الأقدامِ إلى الجماعاتِ",1],"، وأمَّا الدَّرجاتُ: فإطعامُ الطَّعامِ، وإفشاءُ السَّلامِ، والصَّلاةُ باللَّيلِ والنَّاسُ نيامٌ"],"grade":"صحيح","muhaddith":"هذه مجموعة هنا، وأكثر رواياتها متفرقة، وكلها متواترة","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"AFzHsVLC"},{"id":"س-08182","fp":"793164cc94d8","stateId":79,"easy":"إذا بتّ طاهراً ← يبيت معك ملك يستغفر لك كلما تقلبت","cause":"ليس مِن عبدٍ يبيتُ طاهرًا","result":"إلَّا بات معه في شِعارِه مَلَكٌ لا ينقلِبُ ساعةً مِنَ اللَّيلِ إلَّا قال اللهمَّ اغفِرْ لعبدِك فإنَّه بات طاهرًا","explicit":true,"repOf":"س-02726","otherNeedIds":[24],"ref":"مجمع الزوائد 10/131","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال طَهِّروا هذه الأجسادَ طهَّرَكم اللهُ فإنَّه ",["ليس مِن عبدٍ يبيتُ طاهرًا",1]," ",["إلَّا بات معه في شِعارِه مَلَكٌ لا ينقلِبُ ساعةً مِنَ اللَّيلِ إلَّا قال اللهمَّ اغفِرْ لعبدِك فإنَّه بات طاهرًا",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((الأوسط)) (5087) واللفظ له.","bab":"ملائكة › أعمال الملائكة","dorar":"dZ2EomOF"},{"id":"س-01376","fp":"91bf12415b66","stateId":79,"easy":"إذا أسبغت الوضوء على المكاره وأكثرت الخطا إلى المساجد وانتظرت الصلاة ← يكفّر الله خطاياك","cause":"قالوا: بَلى يا رسولَ اللهِ","result":"ألَا أَدُلُّكم على ما يُكفِّرُ اللهُ به الخَطايا، ويَزيدُ به في الحَسَناتِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"في السجود"},"repOf":"س-03338","otherNeedIds":[45,47],"ref":"تخريج المسند لشعيب 10994","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال: \"",["ألَا أَدُلُّكم على ما يُكفِّرُ اللهُ به الخَطايا، ويَزيدُ به في الحَسَناتِ",2],"؟",["\" قالوا: بَلى يا رسولَ اللهِ",1],"، قال: \"إسباغُ الوُضوءِ على المَكارِهِ، وكَثرةُ الخُطا إلى هذه المساجِدِ، وانتِظارُ الصَّلاةِ بعدَ الصَّلاةِ، ما منكم من رجُلٍ يَخرُجُ من بيتِه مُتطهِّرًا فيُصلِّي مع المُسلِمينَ الصَّلاةَ، ثُم يَجلِسُ في المَجلِسِ يَنتظِرُ الصَّلاةَ الأخرى، إنَّ الملائكةَ تقولُ: اللَّهُمَّ اغفِرْ له، اللَّهُمَّ ارحَمْه، فإذا قُمْتم إلى الصَّلاةِ فاعدِلوا صُفوفَكم، وأَقيموها، وسُدُّوا الفُرَجَ؛ فإنِّي أَراكم من وَراءِ ظَهري، فإذا قال إمامُكمُ: اللهُ أكبرُ، فقولوا: اللهُ أكبرُ، وإذا ركَع فارْكَعوا، وإذا قال: سمِع اللهُ لمَن حمِده، فقولوا: اللَّهُمَّ ربَّنا لكَ الحمدُ، وإنَّ خَيرَ الصُّفوفِ صُفوفِ الرِّجالِ المُقدَّمُ، وشرَّها المُؤخَّرُ، وخَيرَ صُفوفِ النِّساءِ المُؤخَّرُ، وشرَّها المُقدَّمُ، يا مَعشَرَ النِّساءِ، إذا سجَد الرِّجالُ فاغْضُضْنَ أبصارَكُنَّ لا تَرَيْنَ عَوْراتِ الرِّجالِ من ضيقِ الأُزُرِ\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (427) مختصراً، وأحمد (10994) واللفظ له","bab":"وضوء › إسباغ الوضوء","dorar":"gapK0cOd","merged":5,"otherRefs":["تخريج المسند لشعيب 22326 (صحيح)","صحيح ابن خزيمة 1/ 122 (صحيح)","تخريج المسند لشعيب 7209 (صحيح)","الإمام في معرفة أحاديث الأحكام 2/19 (حسن)"]},{"id":"س-03421","fp":"c7d39f296792","stateId":80,"easy":"إذا لازمت سورة الملك (ثلاثون آية) ← تستغفر لك حتى يُغفر لك","cause":"إنَّ سورةً في القُرآنِ - ثلاثونَ آيةً","result":"تستغفِرُ لصاحبِها حتَّى يُغفَرَ له","explicit":true,"star":true,"similar":["س-00780"],"otherNeedIds":[65,66,67],"ref":"صحيح ابن حبان 787","srcLabel":"أبو داود","text":[["إنَّ سورةً في القُرآنِ - ثلاثونَ آيةً",1]," - ",["تستغفِرُ لصاحبِها حتَّى يُغفَرَ له",2]," : {تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ} [الملك: 1] ) ؟ فأقَرَّ به أبو أُسامةَ وقال : نَعم"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (1400)، والترمذي (2891)، وابن ماجه (3786) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"oPcGl0Ok","merged":4,"otherRefs":["تخريج المسند لشاكر 15/129 (صحيح)","إتحاف الخيرة المهرة 6/290 (صحيح)","الأحاديث المختارة 1738 (صحيح)"]},{"id":"س-03304","fp":"a5be4a67fee5","stateId":80,"easy":"إذا قرأت سورة يس تريد الله والدار الآخرة ← يغفر الله لك","cause":"يس لا يقرؤُها رجلٌ يريدُ اللهَ والدَّارَ الآخرةَ","result":"إلَّا غفر اللهُ له","explicit":true,"star":true,"apply":{"k":"read","t":"سورة يس"},"ref":"الترغيب والترهيب 2/319","srcLabel":"النسائي","text":["قلبُ القرآنِ {",["يس} لا يقرؤُها رجلٌ يريدُ اللهَ والدَّارَ الآخرةَ",1]," ",["إلَّا غفر اللهُ له",2]," اقرؤُوها على موتاكم"],"grade":"صحيح","narrator":"معقل بن يسار","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أحمد (20300)، والطبراني (20/231) (541) مطولاً باختلاف يسير، والنسائي في ((السنن الكبرى)) (10914) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"AHvvBfqm"},{"id":"س-04616","fp":"ec77f6e15442","stateId":80,"easy":"إذا لازمت سورة تبارك ← تشفع لك","cause":"تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ","result":"تشفعُ لقائلِها","explicit":true,"star":true,"otherNeedIds":[65],"ref":"البدر المنير 3/561","srcLabel":"أبو داود","text":["سورةٌ ",["تشفعُ لقائلِها",2]," ، وهي ثلاثونَ آيةً ألا وهي ",["تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1400)، والترمذي (2891)، والنسائي في ((السنن الكبرى)) (10546)، وابن ماجه (3786)، وأحمد (7975)","bab":"دفن ومقابر › أحوال الميت في القبر","dorar":"Wj8i1r7C"},{"id":"س-06986","fp":"9e6930fcddc8","stateId":80,"easy":"إذا قرأت يس في ليلة ابتغاء وجه الله ← يغفر الله لك في تلك الليلة","cause":"مَن قرأ ياسينَ في ليلةٍ ابتِغاءَ وَجهِ اللهِ","result":"غفَر اللهُ له في تلك اللَّيلةِ","explicit":true,"ref":"علل الدارقطني 2003","srcLabel":"الطبراني","text":[["مَن قرأ ياسينَ في ليلةٍ ابتِغاءَ وَجهِ اللهِ ",1],["غفَر اللهُ له في تلك اللَّيلةِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"ليس فيها شيءٌ ثابِتٌ.","takhrij":"أخرجه الدارمي (3460)، والطبراني في ((الأوسط)) (3509)، وتمام (975) جميعهم بلفظه.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"rig5QmTo"},{"id":"س-07644","fp":"e6173004feba","stateId":80,"easy":"إذا قرأت «قل هو الله أحد» (محبّاً لها) ← يُغفر لك","cause":"يَقرَأُ قُلْ هُوَ اللَّهُ أَحَدٌ","result":"غُفِرَ له","explicit":true,"apply":{"k":"say","t":"«قل هو الله أحد»"},"similar":["س-07645"],"ref":"الصحيح المسند 1507","srcLabel":"الصحيح المسند","text":["جاءَ رَجُلٌ زَمَنَ زِيادٍ إلى الكوفةِ فسَمِعْتُه يُحدِّثُ: أنَّه كانَ معَ رَسولِ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ في مَسيرٍ له قالَ: ورُكْبتي تُصيبُ أو تَمَسُّ رُكْبتَه، فسَمِعَ رَجُلًا يَقرَأُ: {قُلْ يَا أَيُّهَا الْكَافِرُونَ}، قالَ: «بَرِئَ مِن الشِّرْكِ»، وسَمِعَ رَجُلًا ",["يَقرَأُ {قُلْ هُوَ اللَّهُ أَحَدٌ",1],"}، قالَ: «",["غُفِرَ له",2],"»."],"grade":"صحيح","narrator":"رجل","muhaddith":"صحيح، ورجاله رجال الصحيح","bab":"فضائل سور وآيات › سورة الإخلاص","dorar":"NLutCf5D"},{"id":"س-07645","fp":"76dee60fe2a6","stateId":80,"easy":"إذا قرأت «قل هو الله أحد» ← يُغفر لك","cause":"يقرأُ : قُلْ هو اللهُ أحَدٌ","result":"أما هذا فقد غُفِر له","explicit":true,"apply":{"k":"say","t":"«قل هو الله أحد»"},"repOf":"س-07644","ref":"إتحاف الخيرة المهرة 6/305","text":["بينما أنا أسيرُ مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّم في ليلةٍ ظَلماءَ فسمِع قارِئًا يقرأُ : قُلْ يأيُّها الكافِرونَ ، فقال : أما هذا فقد برِئَ منَ الشِّركِ ، ثم سِرْنا قريبًا فسمِع قارِئًا ",["يقرأُ : قُلْ هو اللهُ أحَدٌ",1]," ، فقال : ",["أما هذا فقد غُفِر له",2]],"grade":"صحيح","narrator":"شيخ في إمارة ابن أم الحكم","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي شيبة في ((المسند)) (962) بلفظه، وأحمد (16605) بلفظه، والنسائي في ((السنن الكبرى)) (7974) كلاهما باختلاف يسير.","bab":"فضائل سور وآيات › سورة الإخلاص","dorar":"WhFB6REo"},{"id":"س-03348","fp":"62e66935a043","stateId":80,"easy":"إذا قرأت يس في ليلة ← تصبح مغفوراً لك","cause":"مَنْ قرأَ يَس في ليلةٍ","result":"أصبحَ مَغْفُورًا لهُ","explicit":true,"ref":"تفسير القرآن العظيم 6/547","srcLabel":"الترمذي","text":[["مَنْ قرأَ يَس في ليلةٍ ",1],["أصبحَ مَغْفُورًا لهُ ، ",2],"مَنْ قرأَ حم التي يُذْكَرُ فيها الدُّخَانُ أصبحَ مَغْفُورًا لهُ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده جيد","takhrij":"أخرجه الترمذي (2889)، والعقيلي في ((الضعفاء الكبير)) (1/202) مختصراً، وأبو يعلى (6224) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"3MEYOjWG","merged":2,"otherRefs":["نتائج الأفكار 3/259 (حسن)"]},{"id":"س-00780","fp":"7e19d7a73c3c","stateId":80,"easy":"إذا قرأت سورة الملك ← تشفع لك حتى يُغفر لك","cause":"تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ","result":"شَفَعَت لصاحِبها حتَّى غُفِرَ له","explicit":true,"apply":{"k":"read","t":"سورة الملك"},"repOf":"س-03421","otherNeedIds":[65],"ref":"إثبات عذاب القبر 151","text":["في القُرآنِ سورةٌ ثَلاثونَ آيةً ",["شَفَعَت لصاحِبها حتَّى غُفِرَ له",2],": {",["تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ",1]," وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ} [الملك: 1]"],"grade":"حسن","narrator":"أبو هرَيرةَ","muhaddith":"إسناده حسن","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"s35vV9vI"},{"id":"س-02322","fp":"6dff52d743d9","stateId":80,"easy":"إذا قرأت سورة الدخان ليلة الجمعة ← يُغفر لك","cause":"مَن قَرَأ حَم الدُّخانِ في لَيلةِ الجُمُعةِ","result":"غُفِرَ له","explicit":true,"apply":{"k":"read","t":"سورة الدخان · الوقت: يوم الجمعة أو ليلتها"},"ref":"الفوائد المجموعة 301","srcLabel":"الترمذي","text":["بلفظِ (مَن قَرَأ سورةَ الدُّخانِ في لَيلةٍ أصبَحَ يَستَغفِرُ له سَبعونَ ألف مَلَكٍ) [وفي] لَفظٍ: ",["مَن قَرَأ حَم الدُّخانِ في لَيلةِ الجُمُعةِ ",1],["غُفِرَ له",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده أبو بدر شجاع ابن الوليد وهو صدوق له أوهام","takhrij":"أخرجه الترمذي (2888)، وأبو يعلى (6232)، والبيهقي في ((الشعب)) (2246) بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"OKeTwLsY"},{"id":"س-03349","fp":"b1d9510ba855","stateId":80,"easy":"إذا قرأت سورة الدخان في ليلة ← تصبح مغفوراً لك","cause":"مَنْ قرأَ حم التي يُذْكَرُ فيها الدُّخَانُ","result":"أصبحَ مَغْفُورًا لهُ","explicit":true,"apply":{"k":"read","t":"سورة الدخان"},"ref":"تفسير القرآن العظيم 6/547","srcLabel":"الترمذي","text":["مَنْ قرأَ يَس في ليلةٍ أصبحَ مَغْفُورًا لهُ ، ",["مَنْ قرأَ حم التي يُذْكَرُ فيها الدُّخَانُ ",1],["أصبحَ مَغْفُورًا لهُ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده جيد","takhrij":"أخرجه الترمذي (2889)، والعقيلي في ((الضعفاء الكبير)) (1/202) مختصراً، وأبو يعلى (6224) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"3MEYOjWG"},{"id":"س-07638","fp":"e10b41519c12","stateId":80,"easy":"إذا قرأت «قل هو الله أحد» كل يوم مئتي مرة ← تُمحى عنك ذنوب خمسين سنة إلا الدَّين","cause":"من قرأَ كلَّ يومٍ مئتي مرَّةٍ قل هوَ اللَّهُ أحدٌ","result":"مُحيَ عنهُ ذنوبُ خمسينَ سنةً إلَّا أن يكونَ عليهِ دينٌ","explicit":true,"apply":{"k":"say","t":"«قل هو الله أحد»"},"ref":"هداية الرواة 2/382","srcLabel":"الترمذي","text":[["من قرأَ كلَّ يومٍ مئتي مرَّةٍ قل هوَ اللَّهُ أحدٌ ",1],["مُحيَ عنهُ ذنوبُ خمسينَ سنةً إلَّا أن يكونَ عليهِ دينٌ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه الترمذي (2898)، وابن عدي في ((الكامل في الضعفاء)) (2/439) واللفظ لهما، والبيهقي في ((شعب الإيمان)) (2547) باختلاف يسير.","bab":"فضائل سور وآيات › سورة الإخلاص","dorar":"UwZWmYsE"},{"id":"س-03569","fp":"fae18ffd9737","stateId":81,"easy":"إذا أخرجت زكاة الفطر ← تطهّر صيامك من اللغو والرفث","cause":"زَكاةَ الفِطْرِ","result":"طُهْرةً للصِّيامِ مِن اللَّغْوِ والرَّفَثِ","explicit":true,"star":true,"otherNeedIds":[51],"ref":"الأحاديث المختارة 12 / 99","srcLabel":"متفق عليه","text":["«فَرَضَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ",["زَكاةَ الفِطْرِ",1]," ",["طُهْرةً للصِّيامِ مِن اللَّغْوِ والرَّفَثِ",2],"، وطُعْمةً للمَساكينِ، مَن أَدَّاها قَبْلَ الصَّلاةِ فهي زَكاةٌ مَقْبولةٌ، ومَن أَدَّاها بَعْدَ الصَّلاةِ فهي صَدَقةٌ مِن الصَّدَقاتِ»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"استغفار › مكفرات الذنوب","dorar":"DoXaHAM4"},{"id":"س-06734","fp":"46be81eea9c6","stateId":81,"easy":"إذا تصدقت ← تطفئ الصدقة خطيئتك كما يطفئ الماء النار","cause":"والصَّدَقةُ","result":"تُطفي الخطيئةَ كما يُطفئُ الماءُ النَّارَ","explicit":true,"star":true,"similar":["س-00517","س-01879"],"ref":"صحيح الترمذي 2616","srcLabel":"الترمذي","text":["كنتُ معَ النَّبيِّ صلَّى اللَّهُ علَيهِ وسلَّمَ في سفَرٍ ، فأصبَحتُ يومًا قريبًا منهُ ونحنُ نَسيرُ ، فقلتُ : يا رسولَ اللَّهِ أخبرني بعمَلٍ يُدخِلُني الجنَّةَ ويباعِدُني من النَّارِ ، قالَ : لقد سألتَني عَن عظيمٍ ، وإنَّهُ ليسيرٌ على من يسَّرَهُ اللَّهُ علَيهِ ، تعبدُ اللَّهَ ولا تشرِكْ بِهِ شيئًا ، وتُقيمُ الصَّلاةَ ، وتُؤتي الزَّكاةَ ، وتصومُ رمضانَ ، وتحجُّ البيتَ ، ثمَّ قالَ : ألا أدلُّكَ على أبوابِ الخيرِ : الصَّومُ جُنَّةٌ ، ",["والصَّدَقةُ",1]," ",["تُطفي الخطيئةَ كما يُطفئُ الماءُ النَّارَ",2]," ، وصلاةُ الرَّجلِ من جوفِ اللَّيلِ قالَ : ثمَّ تلا  تَتَجَافَى جُنُوبُهُمْ عَنِ الْمَضَاجِعِ يَدْعُونَ رَبَّهُمْ  ، حتَّى بلغَ يَعْمَلُونَ ، ثمَّ قالَ : ألا أخبرُكَ بِرَأسِ الأَمرِ كلِّهِ وعمودِهِ ، وذِروةِ سَنامِهِ ؟ قلتُ : بلى يا رسولَ اللَّهِ ، قالَ : رأسُ الأمرِ الإسلامُ ، وعمودُهُ الصَّلاةُ ، وذروةُ سَنامِهِ الجِهادُ ، ثمَّ قالَ : ألا أخبرُكَ بملاكِ ذلِكَ كلِّهِ ؟ قُلتُ : بلَى يا رسولَ اللَّهِ ، قال : فأخذَ بلِسانِهِ قالَ : كُفَّ عليكَ هذا ، فقُلتُ : يا نبيَّ اللَّهِ ، وإنَّا لمؤاخَذونَ بما نتَكَلَّمُ بِهِ ؟ فقالَ : ثَكِلَتكَ أمُّكَ يا معاذُ ، وَهَل يَكُبُّ النَّاسَ في النَّارِ على وجوهِهِم أو على مَناخرِهِم إلَّا حَصائدُ ألسنتِهِم ."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2616) بلفظه، وابن ماجه (3973)، وأحمد (22068) كلاهما باختلاف يسير.","bab":"صيام › فضل الصيام","dorar":"dad0NMIP","merged":9,"otherRefs":["الزواجر عن اقتراف الكبائر 1/193 (صحيح)","صحيح الترغيب 868 (صحيح)","صحيح الموارد 2166 (صحيح)","صحيح الترغيب 866 (صحيح)","تخريج صحيح ابن حبان 1723 (صحيح)","تخريج المسند لشعيب 15284 (صحيح)","المستدرك على الصحيحين 8522 (صحيح)","تخريج سنن الترمذي 2/513 (صحيح)"]},{"id":"ق-0101","fp":"aba177d0009b","stateId":81,"easy":"الإنفاق وعدم الخوف من الفقر ← مغفرة من الله وفضل","cause":"الإنفاق وعدم الخوف من الفقر","result":"مغفرة من الله وفضل","explicit":true,"star":true,"otherNeedIds":[1],"ref":"سورة البقرة: 268","srcLabel":"القرآن الكريم","quran":{"s":2,"from":268,"to":268,"text":"الشَّيْطَانُ يَعِدُكُمُ الْفَقْرَ وَيَأْمُرُكُمْ بِالْفَحْشَاءِ وَاللَّهُ يَعِدُكُمْ مَغْفِرَةً مِنْهُ وَفَضْلًا وَاللَّهُ وَاسِعٌ عَلِيمٌ (268)","hl":[[0,64,1],[64,112,2]]}},{"id":"ق-0105","fp":"5f2378a2fd87","stateId":81,"easy":"إخفاء الصدقة وإيتاؤها الفقراء ← خير للعبد وتكفير السيئات","cause":"إخفاء الصدقة وإيتاؤها الفقراء","result":"خير للعبد وتكفير السيئات","explicit":true,"otherNeedIds":[55],"ref":"سورة البقرة: 271","srcLabel":"القرآن الكريم","quran":{"s":2,"from":271,"to":271,"text":"إِنْ تُبْدُوا الصَّدَقَاتِ فَنِعِمَّا هِيَ وَإِنْ تُخْفُوهَا وَتُؤْتُوهَا الْفُقَرَاءَ فَهُوَ خَيْرٌ لَكُمْ وَيُكَفِّرُ عَنْكُمْ مِنْ سَيِّئَاتِكُمْ وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ (271)","hl":[[43,87,1],[87,148,2],[148,184,1]]}},{"id":"ق-0528","fp":"415f6c834a65","stateId":81,"easy":"الصدقة ← التطهير والتزكية","cause":"الصدقة","result":"التطهير والتزكية","explicit":true,"otherNeedIds":[19],"ref":"سورة التوبة: 103","srcLabel":"القرآن الكريم","quran":{"s":9,"from":103,"to":103,"text":"خُذْ مِنْ أَمْوَالِهِمْ صَدَقَةً تُطَهِّرُهُمْ وَتُزَكِّيهِمْ بِهَا وَصَلِّ عَلَيْهِمْ إِنَّ صَلَاتَكَ سَكَنٌ لَهُمْ وَاللَّهُ سَمِيعٌ عَلِيمٌ (103)","hl":[[0,33,1],[33,67,2]]}},{"id":"س-06269","fp":"53d5f1b00e97","stateId":81,"easy":"إذا تصدقت عن ميتك ← يكفّر عنه","cause":"أن تصدَّقتُ عنهُ","result":"فَهَل يُكَفِّرُ عنهُ أن تصدَّقتُ عنهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[37],"ref":"صحيح ابن ماجه 2213","srcLabel":"مسلم","text":["أنَّ رجلًا سألَ رسولَ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ قالَ: إنَّ أبي ماتَ وترَكَ مالًا ولم يوصِ، ",["فَهَل يُكَفِّرُ عنهُ أن تصدَّقتُ عنهُ؟",2]," قالَ: نعَم"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (2716) واللفظ له، وأخرجه مسلم (1630) باختلاف يسير","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"rCgAk1wb"},{"id":"س-06864","fp":"49fcab89c1f6","stateId":81,"easy":"إذا تصدقت في السر ← تطفئ غضب الرب","cause":"صدَقةُ السِّرِّ","result":"تُطفِئُ غَضبَ الرَّبِ","explicit":true,"ref":"صحيح الجامع 3760","srcLabel":"صحيح الجامع","text":[["صدَقةُ السِّرِّ ",1],["تُطفِئُ غَضبَ الرَّبِ ",2],"، و صِلَةُ الرَّحِمِ تَزِيدُ في العُمرِ ، و فِعلُ المَعروفِ يَقِي مَصارِعَ السُّوءِ"],"grade":"صحيح","narrator":"أبو سعيد الخدري وعبدالله بن عباس وأم سلمة وأبو أمامة ومعاوية بن حيدة","muhaddith":"صحيح","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"BkWIc29A","merged":2,"otherRefs":["المصابيح في الأحاديث المتواترة 610 (صحيح)"]},{"id":"س-00517","fp":"a1b81ff4f684","stateId":81,"easy":"إذا تصدقت ولو بتمرة ← تسدّ جوع الجائع وتطفئ خطيئتك كما يطفئ الماء النار","cause":"تَصَدَّقُوا و لَوْ بِتَمْرَةٍ","result":"فإنَّها تَسُدُّ من الجائِعِ ، و تُطفِئُ الخطِيئَةَ ، كَما يُطفِئُ الماءُ النارَ","explicit":true,"repOf":"س-06734","ref":"صحيح الجامع 2951","text":[["تَصَدَّقُوا و لَوْ بِتَمْرَةٍ ، ",1],["فإنَّها تَسُدُّ من الجائِعِ ، و تُطفِئُ الخطِيئَةَ ، كَما يُطفِئُ الماءُ النارَ",2]],"grade":"صحيح","narrator":"عكرمة مولى ابن عباس","muhaddith":"صحيح","takhrij":"أخرجه ابن المبارك في ((الزهد والرقائق)) (651)","bab":"آداب عامة › ضرب الأمثال","dorar":"99xXnduf"},{"id":"س-01879","fp":"2dcb69d79986","stateId":81,"easy":"إذا تصدقت ← تكفّر الصدقة خطيئتك","cause":"والصَّدقةُ","result":"تُكفِّرُ الخطيئةَ","explicit":true,"repOf":"س-06734","ref":"مختصر المقاصد 596","text":["الصَّومُ جُنَّةٌ [يعني حديث: بيْنَما نحن مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في غزوةِ تَبوكَ وقد أَصابَنا الحَرُّ، فتفَرَّقَ القومُ حتَّى نَظرتُ، فإذا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ أقرَبَهُم مِنِّي. قالَ: فدَنوتُ منه فقلتُ: يا رسولَ اللهِ، أَنبِئْني بعملٍ يُدخِلُني الجنَّةَ ويُباعِدُني مِنَ النَّارِ. قالَ: «لقد سألتَ عنْ عظيمٍ، وإنَّه ليَسيرٌ على مَنْ يَسَّرَهُ اللهُ عليه؛ تَعبدُ اللهَ ولا تُشركُ به شيئًا، وتُقيمُ الصَّلاةَ المكتوبةَ، وتُؤتي الزَّكاةَ المفروضةَ، وتَصومُ رمضانَ». قالَ: «وإنْ شئتَ أنبأتُكَ بأبوابِ الجنَّةِ». قلتُ: أجَلْ يا رسولَ اللهِ. قالَ: «الصَّومُ جُنَّةٌ، ",["والصَّدقةُ",1]," ",["تُكفِّرُ الخطيئةَ",2],"، وقيامُ الرَّجلِ في جوفِ اللَّيلِ يَبتغي وجهَ اللهِ». قالَ: ثُمَّ قَرَأَ هذه الآيةَ: {تَتَجَافَى جُنُوبُهُمْ عَنِ الْمَضَاجِعِ يَدْعُونَ رَبَّهُمْ خَوْفًا وَطَمَعًا وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ} [السجدة: 16] قالَ: «وإنْ شئتَ أنبأتُكَ برأسِ الأمرِ وعمودِهِ وذُروةِ سَنامِهِ» . قالَ: قلتُ: أجَلْ يا رسولَ اللهِ. قالَ: «أمَّا رأسُ الأمرِ فالإسلامُ، وأمَّا عمودُهُ فالصَّلاةُ، وأمَّا ذُروةُ سَنامِهِ فالجهادُ في سبيلِ اللهِ، وإنْ شئتَ أنبأتُكَ بأمْلَكِ ذلك كُلِّهِ». قالَ: فسَكَتَ، فإذا راكبانِ يُوضِعانِ قِبَلَنا، فخَشيتُ أنْ يَشغلاهُ عنْ حاجتي. قالَ: فقلتُ: ما هو يا رسولَ اللهِ؟ قالَ: فأَهْوَى بإصبَعِهِ إلى فيهِ. قالَ: فقلتُ: يا رسولَ اللهِ، وإنَّا لنُؤاخذُ بما نقولُ بألسِنَتِنا؟ قالَ: «ثَكِلتكَ أمُّكَ ابنَ جَبلٍ، هل يَكُبُّ النَّاسَ على مَناخِرِهم في جهنَّمَ إلَّا حصائدُ ألسنَتِهمْ؟».]"],"grade":"صحيح","narrator":"[معاذ بن جبل]","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (5/ 12)، والنسائي (2224 )، وابن ماجة (3973 )","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"snTBq0Xu"},{"id":"س-03280","fp":"8fd5c341e644","stateId":81,"easy":"إذا تصدقت ولو برغيف على سائل ← قد ترجح به حسناتك فيُغفر لك","cause":"فجاء سائلٌ فأومأ إليه أن يأخُذَ الرَّغيفَيْن","result":"ثمَّ وُضِع الرَّغيفُ أو الرَّغيفان مع حسناتِه فرجَحت حسناتُه فغُفِر له","explicit":true,"similar":["س-06371"],"otherNeedIds":[49],"ref":"الترغيب والترهيب 3/262","srcLabel":"ابن حبان","text":["تعبَّد عابدٌ من بني إسرائيلَ فعبد اللهَ في صومعتِه ستِّين عامًا فأُمطِرت الأرضُ فاخضرَّت فأشرف الرَّاهبُ من صومعتِه فقال لو نزلتُ فذكرتُ اللهَ فازددتُ خيرًا فنزل ومعه رغيفٌ أو رغيفان فبينما هو في الأرضِ لقِيتْه امرأةٌ فلم يزَلْ يُكلِّمُها وتُكلِّمُه حتَّى غشِيها ثمَّ أُغمي عليه فنزل الغديرَ يستحِمُّ ",["فجاء سائلٌ فأومأ إليه أن يأخُذَ الرَّغيفَيْن",1]," ثمَّ مات فوُزِنت عبادةُ ستِّين سنةً بتلك الزَّنيةِ فرجحت تلك الزَّنيةُ بحسناتِه ",["ثمَّ وُضِع الرَّغيفُ أو الرَّغيفان مع حسناتِه فرجَحت حسناتُه فغُفِر له",2]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن حبان (378).","bab":"استغفار › أسباب المغفرة","dorar":"DtzQp802"},{"id":"س-03301","fp":"a954451a0001","stateId":81,"easy":"إذا تصدقت ← يُهدم عنك من ذنوبك بقدر ما تصدقت","cause":"بقَدرِ ما تَصَدَّقَ به","result":"يُهدَمُ عنه مِن ذُنوبِه","explicit":true,"ref":"عمدة التفسير 1/687","srcLabel":"أسانيده صحاح","text":["رَأيتُ عَبدَ اللهِ بنَ عَمرٍو عِندَ مُعاويةَ أحمَرَ شَبيهًا بالمَوالي، فسَألتُه عن قَولِ اللهِ: {فَمَنْ تَصَدَّقَ بِهِ فَهُوَ كَفَّارَةٌ لَهُ} [المائدة: 45]، قال: ",["يُهدَمُ عنه مِن ذُنوبِه",2]," ",["بقَدرِ ما تَصَدَّقَ به",1],"."],"grade":"صحيح","narrator":"الهيثم أبو العريان النخعي","muhaddith":"أسانيده صحاح","takhrij":"أخرجه ابن أبي حاتم في ((تفسيره)) (6448)","bab":"استغفار › أسباب المغفرة","dorar":"iXq80quE"},{"id":"س-03551","fp":"ab01422fbb01","stateId":81,"easy":"إذا أطعمت مسلماً جائعاً ← فهو من موجبات المغفرة لك","cause":"إطعامُ المسلمِ السَّغْبانِ","result":"مِن مُوجِباتِ المَغفرةِ","explicit":true,"ref":"المستدرك على الصحيحين 3983","srcLabel":"الحاكم","text":["إسحاقُ بنُ سُليمانَ الرَّازيُّ، قالَ: سَمِعْتُ طلحةَ بنَ عمرٍو، وسُئلَ عنْ قولِ اللهِ عزَّ وجلَّ: {أَوْ إِطْعَامٌ فِي يَوْمٍ ذِي مَسْغَبَةٍ} [البلد: 14] فقالَ: حدَّثَنا مُحمَّدُ بنُ المُنكَدِرِ، عنْ جابرِ بنِ عبدِ اللهِ رَضيَ اللهُ عنهُما، قالَ: قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «",["مِن مُوجِباتِ المَغفرةِ",2]," ",["إطعامُ المسلمِ السَّغْبانِ",1],"»."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح الإسناد","bab":"استغفار › مكفرات الذنوب","dorar":"3uYRCRFY"},{"id":"س-03557","fp":"57f3d7e5b5e7","stateId":81,"easy":"إذا أخرجت زكاة مالك ← تطهّرك","cause":"تخرجُ الزَّكاةَ من مالِكَ","result":"فإنَّها طهرةٌ تطهِّرُكَ","explicit":true,"ref":"مجمع الزوائد 3/66","srcLabel":"أحمد","text":["أتى رجلٌ من بني تميمٍ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ يا رسولَ اللَّهِ إنِّي ذو مالٍ كثيرٍ وذو أهلٍ ومالٍ وحاضرةٍ فأخبرني كيفَ أصنعُ وكيفَ أنفقُ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ",["تخرجُ الزَّكاةَ من مالِكَ",1]," ",["فإنَّها طهرةٌ تطهِّرُكَ",2]," وتصلُ أقرباءَكَ وتعرفُ حقَّ المسكينِ والجارِ والسَّائلِ فقالَ يا رسولَ اللَّهِ أقلِل لي فقالَ آتِ ذا القربى حقَّهُ والمسكينَ وابنَ السَّبيلِ ولا تبذِّر تبذيرًا فقالَ [حسبي] يا رسولَ اللَّهِ إذا أدَّيتُ الزَّكاةَ إلى رسولِكَ فقد برئتُ منها إلى اللَّهِ ورسولهِ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ نعم إذا أدَّيتَها إلى رسولي فقد برئتَ منها ولكَ أجرُها وإثمُها على من بدَّلَها"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (12417)، والطبراني في ((المعجم الأوسط)) (8802)","bab":"استغفار › مكفرات الذنوب","dorar":"301XQaUt"},{"id":"س-07155","fp":"9aa972263856","stateId":81,"easy":"إذا أديت الزكاة المفروضة ← تطهّرك","cause":"أَدِّ الزَّكاةَ المفروضةَ","result":"طُهْرةً تُطهِّرُكَ","explicit":true,"ref":"المستدرك على الصحيحين 3417","srcLabel":"أحمد","text":["أنَّ رَجلَا قالَ: يا رسولَ اللهِ، إنِّي ذو مالٍ كثيرٍ، وذو أهلٍ ووَلَدٍ، فكيف يجبُ لي أنْ أصنعَ أوْ أُنفِقَ؟ قالَ: «",["أَدِّ الزَّكاةَ المفروضةَ",1]," ",["طُهْرةً تُطهِّرُكَ",2],"، وآتِ صِلَةَ الرَّحِمِ، واعرِفْ حقَّ السَّائلِ والجارِ والمسكينِ». قالَ: يا رسولَ اللهِ، أقْلِلْ لي. قالَ: فــ {آتِ ذَا الْقُرْبَى حَقَّهُ وَالْمِسْكِينَ وَابْنَ السَّبِيلِ وَلَا تُبَذِّرْ تَبْذِيرًا} [الإسراء: 26] قالَ: يا رسولَ اللهِ، إذا أدَّيتُ الزَّكاةَ إلى رسولِ رسولِ اللهِ فقد أدَّيتُها إلى اللهِ وإلى رسولِهِ؟ قالَ: «نَعَمْ، إذا أدَّيْتَها إلى رسولِ اللهِ فقد أدَّيْتَها، ولكَ أجرُها، وعلى مَنْ بَدَّلها إثمُها»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (12394)، والطبراني في ((المعجم الأوسط)) (8802) بنحوه، والبيهقي (7359) مختصرا","bab":"علم › حسن السؤال ونصح العالم","dorar":"jHERRDxD"},{"id":"س-06371","fp":"08fa71cd9ee6","stateId":81,"easy":"إذا تصدقت ولو برغيف ← قد ترجح بسيئات كثيرة (من قصة)","cause":"فأُتي برغيفٍ فكسره فأعطَى رجلًا عن يمينِه نصفَه وأعطَى آخرَ عن يسارِه نصفَه","result":"ثمَّ وُضِع الرَّغيفُ فرجح يعني رجح الرَّغيفُ السِّتَّةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-03280","otherNeedIds":[49],"ref":"الترغيب والترهيب 2/67","text":["عن ابنِ مسعودٍ [ قال ] إنَّ راهبًا عبد اللهَ في صومعتِه ستِّين سنةً فجاءت امرأةٌ فنزلت إلى جنبِه فنزل إليها فواقَعها ستَّ ليالٍ ثمَّ سُقِط في يدِه فهرب فأتَى مسجدًا فأوَى فيه ثلاثًا لا يطعمُ شيئًا ",["فأُتي برغيفٍ فكسره فأعطَى رجلًا عن يمينِه نصفَه وأعطَى آخرَ عن يسارِه نصفَه",1]," فبعث اللهُ إليه ملكَ الموتِ فقبض روحَه فوُضِعت السِّتُّون في كِفَّةٍ ووُضِعت السِّتَّةُ في كِفَّةٍ فرجحت يعني السِّتَّةَ ",["ثمَّ وُضِع الرَّغيفُ فرجح يعني رجح الرَّغيفُ السِّتَّةَ",2]],"grade":"صحيح","narrator":"[عبدالله بن هانئ الأودي أبو الزعراء]","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن أبي شيبة (35352)، والبيهقي في ((الشعب)) (3213)، وإسحاق كما في ((المطالب العالية)) (3468) بنحوه.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"uohlwSI5"},{"id":"س-07581","fp":"fe66d8a5e84f","stateId":82,"easy":"إذا قمت ليلة القدر إيماناً واحتساباً ← يغفر الله لك ما تقدّم من ذنبك","cause":"مَن قام ليلةَ القدرِ إيمانًا واحتسابًا","result":"غفَر اللهُ له ما تقدَّم مِن ذنبِه","explicit":true,"star":true,"apply":{"k":"time","t":"في العشر الأواخر"},"similar":["س-02634"],"ref":"تخريج صحيح ابن حبان 2543","srcLabel":"متفق عليه","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم خرَج في جوفِ اللَّيلِ فصلَّى في المسجدِ فصلَّى النَّاسُ فأصبَح النَّاسُ يتحدَّثونَ بذلك فكثُر النَّاسُ فخرَج عليهم اللَّيلةَ الثَّانيةَ فصلَّى فصلَّوا بصلاتِه فأصبَحوا يتحدَّثونَ بذلك حتَّى كثُر النَّاسُ فخرَج مِن اللَّيلةِ الثَّالثةِ فصلَّى فصلَّوا بصلاتِه فأصبَح النَّاسُ يتحدَّثونَ بذلك فكثُر النَّاسُ حتَّى عجَز المسجدُ عن أهلِه فلم يخرُجْ إليهم فطفِق النَّاسُ يقولونَ: الصَّلاةَ فلم يخرُجْ إليهم حتَّى خرَج لصلاةِ الفجرِ فلمَّا قضى صلاةَ الفجرِ أقبَل على النَّاسِ فتشهَّد ثمَّ قال: ( أمَّا بعدُ فإنَّه لم يخْفَ علَيَّ شأنُكم اللَّيلةَ ولكنِّي خشيتُ أنْ تُفرَضَ عليكم صلاةُ اللَّيلِ فتعجِزوا عن ذلك وكان يُرغِّبُهم في قيامِ رمضانَ مِن غيرِ أنْ يأمُرَهم بعزيمةٍ يقولُ: ( ",["مَن قام ليلةَ القدرِ إيمانًا واحتسابًا ",1],["غفَر اللهُ له ما تقدَّم مِن ذنبِه",2]," قال: فتوفِّي رسولُ اللهِ صلَّى اللهُ عليه وسلَّم والأمرُ على ذلك ثمَّ كذلك كان في خلافةِ أبي بكرٍ وصدرٍ مِن خلافةِ عمرَ حتَّى جمَعهم عمرُ بنُ الخطَّابِ على أُبَيِّ بنِ كعبٍ فقام بهم في رمضانَ وكان ذلك أوَّلَ اجتماعِ النَّاسِ على قارئٍ واحدٍ في رمضانَ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه إسحاق بن راهويه (827)، وابن حبان (2543) واللفظ لهما، والبخاري (924)، ومسلم (761) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › شفقته على أمته","dorar":"rdshaKdz","merged":5,"otherRefs":["تخريج المسند لشعيب 7280 (صحيح)","تخريج مشكل الآثار 2352 (حسن)","صحيح الترغيب 992 (صحيح)","صحيح ابن حبان 141 (صحيح)"]},{"id":"س-02640","fp":"341077ff02b2","stateId":82,"easy":"إذا قمت رمضان إيماناً واحتساباً ← يُغفر لك ما تقدّم من ذنبك","cause":"مَن قامَه إيمانًا واحتِسابًا","result":"غُفِرَ له ما تقدَّمَ مِن ذَنبِه","explicit":true,"star":true,"apply":{"k":"time","t":"في رمضان"},"ref":"تخريج المسند لشعيب 7881","srcLabel":"متفق عليه","text":["سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يُرَغِّبُ النَّاسَ في قِيامِ رَمضانَ، ويَقولُ: ",["مَن قامَه إيمانًا واحتِسابًا؛ ",1],["غُفِرَ له ما تقدَّمَ مِن ذَنبِه",2],". ولَم يَكُنْ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ جمَعَ النَّاسَ على القِيامِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (2008)، ومسلم (759)، وأبو داود (1371)، والترمذي (808)، والنسائي (2198)، وابن ماجه (1326)، وأحمد (7881) واللفظ له","bab":"إيمان › الاحتساب والنية","dorar":"f9w0QQJS","merged":3,"otherRefs":["حديث المساء 218 (حسن)","تخريج المسند لشعيب 22741 (حسن)"]},{"id":"س-02634","fp":"fa06ceddf520","stateId":82,"easy":"إذا قمت ليالي القدر تبتغي أجرها ← يغفر الله لك ما تقدّم من ذنبك وما تأخر","cause":"مَن قامَهنَّ ابْتِغاءَ حِسْبَتِهنَّ","result":"فإنَّ اللهَ تَبارَكَ وتَعالى يَغفِرُ له ما تَقدَّمَ مِن ذَنْبِه وما تَأخَّرَ، وهي لَيْلةُ وِتْرٍ؛ تِسْعٍ أو سَبْعٍ أو خامِسةٍ أو ثالِثةٍ أو آخِرِ لَيْلةٍ","explicit":true,"repOf":"س-07581","ref":"الأحاديث المختارة 8 / 279","text":["(«لَيْلةُ القَدْرِ في العَشْرِ البَواقي، ",["مَن قامَهنَّ ابْتِغاءَ حِسْبَتِهنَّ ",1],["فإنَّ اللهَ تَبارَكَ وتَعالى يَغفِرُ له ما تَقدَّمَ مِن ذَنْبِه وما تَأخَّرَ، وهي لَيْلةُ وِتْرٍ؛ تِسْعٍ أو سَبْعٍ أو خامِسةٍ أو ثالِثةٍ أو آخِرِ لَيْلةٍ)",2],".\nوقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: (إنَّ أمارةَ لَيْلةِ القَدْرِ أنَّها صافِيةٌ بَلْجةٌ كأنَّ فيها قَمَرًا ساطِعًا، ساكِنةٌ ساجِيةٌ، لا بَرْدَ فيها ولا حَرَّ، ولا يَحِلُّ لكَوْكَبٍ أن يُرْمى به فيها حتَّى يُصبِحَ، وأنَّ أمارتَها أنَّ الشَّمْسَ صَبيحتَها تَخرُجُ مُسْتوِيةً ليس لها شُعاعٌ مِثلَ القَمَرِ لَيْلةَ البَدْرِ، لا يَحِلُّ للشَّيْطانِ أن يَخرُجَ معَها يَوْمَئذٍ»)."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إيمان › الاحتساب والنية","dorar":"BadItbkB"},{"id":"س-03367","fp":"d675d56cab4a","stateId":82,"easy":"إذا قمت رمضان إيماناً واحتساباً ← تخرج من ذنوبك كيوم ولدتك أمك","cause":"من قامَ رمضانَ إيمانًا واحتسابًا","result":"خرج من ذنوبِه كيومِ ولدتْه أمُّه","explicit":true,"apply":{"k":"time","t":"في رمضان"},"ref":"الترغيب والترهيب 2/123","srcLabel":"النسائي","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ذكر رمضانَ يُفَضِّلُهُ على الشُّهورِ فقال ",["من قامَ رمضانَ إيمانًا واحتسابًا ",1],["خرج من ذنوبِه كيومِ ولدتْه أمُّه",2]],"grade":"صحيح","narrator":"عبدالرحمن بن عوف","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه النسائي (2208) واللفظ له، وابن ماجة (1328)، وأحمد (1660) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"Y4cF7DJm"},{"id":"س-03568","fp":"eb8f1414507f","stateId":82,"easy":"إذا كنت من أهل القبلة ← يغفر الله لك في أول ليلة من رمضان","cause":"لأهلِ هذه القِبْلةِ","result":"يَغفِرُ في أوَّلِ ليلةٍ مِن رَمَضانَ","explicit":true,"star":true,"ref":"الأحاديث المختارة 2111","srcLabel":"البخاري","text":["«أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم لَمَّا حضر رمضانُ قال: ماذا تَسْتَقبِلون ويُستقبَلُ بكم؟ -قالها ثلاثًا- فقال عُمَرُ بنُ الخَطَّابِ: أوَحْيٌ نَزَل أو عَدُوٌّ حَضَر؟ قال: لا، ولكِنَّ اللهَ عَزَّ وجَلَّ ",["يَغفِرُ في أوَّلِ ليلةٍ مِن رَمَضانَ",2]," ",["لأهلِ هذه القِبْلةِ",1],". قال: وفي ناحيةِ القَومِ رَجُلٌ يَهُزُّ رأسَه ويَقولُ: بَخٍ بَخٍ، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم كأنَّه ضاق صَدْرُك بما سَمِعْتَ؟ قال: لا واللهِ يا رَسولَ اللهِ، ولكِنْ ذكَرْتُ المنافِقينَ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: المنافِقُ كافِرٌ وليس لكافِرٍ في هذا شَيءٌ، أو كما قال النَّبيُّ صلَّى اللهُ عليه وسلَّم»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"استغفار › مكفرات الذنوب","dorar":"hAUZh2oT","merged":2,"otherRefs":["الأحاديث المختارة 2113 (صحيح)"]},{"id":"س-02646","fp":"e666fbab8426","stateId":82,"easy":"إذا صمت رمضان أو قمت ليلة القدر إيماناً واحتساباً ← يُغفر لك ما تقدّم من ذنبك","cause":"مَن صام رَمضانَ، وقال مَرَّةً: مَن قام- ومَن قام لَيلةَ القَدْرِ إيمانًا واحْتِسابًا","result":"غُفِرَ له ما تَقَدَّم مِن ذَنْبِه","explicit":true,"star":true,"apply":{"k":"time","t":"في رمضان، في العشر الأواخر"},"similar":["س-07577"],"ref":"تخريج المسند لشعيب 7280","srcLabel":"متفق عليه","text":["مَن صامَ رَمضانَ إيمانًا واحْتِسابًا غُفِرَ له ما تقدَّمَ مِن ذَنْبِه -قال عبدُ اللهِ بنُ أحمدَ: قال أَبِي: سـمعْتُه أَرْبَعَ مرَّاتٍ مِن سُفْيانَ، وقال مَرَّةً: ",["مَن صام رَمضانَ، وقال مَرَّةً: مَن قام- ومَن قام لَيلةَ القَدْرِ إيمانًا واحْتِسابًا ",1],["غُفِرَ له ما تَقَدَّم مِن ذَنْبِه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (1901)، ومسلم (760) باختلاف يسير","bab":"إيمان › الاحتساب والنية","dorar":"KacNFAPu"},{"id":"س-07577","fp":"a9a83ccda5a8","stateId":82,"easy":"إذا صمت رمضان إيماناً واحتساباً ← يُغفر لك ما تقدّم من ذنبك","cause":"مَن صامَ رمضانَ إيمانًا واحتسابًا","result":"غُفِرَ لَهُ ما تقدَّمَ من ذنبِهِ، فتوُفِّيَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فَكانَ الأمرُ كذلِكَ في خلافةِ أبي بَكْرٍ، وصدرًا من خلافةِ عمرَ، حتَّى جمعَهُم عمرُ على أبيِّ بنِ","explicit":true,"apply":{"k":"time","t":"في رمضان"},"repOf":"س-02646","ref":"صحيح ابن خزيمة 3/ 590","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ خرجَ في جوفِ اللَّيلِ فصلَّى في المسجِدِ، فصلَّى رجالٌ بصلاتِهِ، فأصبحَ ناسٌ يتحدَّثونَ بذلِكَ، فلمَّا كانتِ اللَّيلةُ الثَّالثةُ كثرَ أَهْلُ المسجدِ فخرجَ فصلَّى، فصلُّوا بصلاتِهِ، فلمَّا كانتِ اللَّيلةُ الرَّابعةُ عَجزَ المسجدُ عن أَهْلِهِ، فلم يخرُج إليهم رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ، فطفقَ رجالٌ منهم يُنادونَ: الصَّلاةَ، فلا يخرجُ، فَكَمنَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ حتَّى خرجَ لصلاةِ الفجرِ، فلمَّا قضَى الفجرَ قامَ فأقبلَ عليهم بوجهِهِ، فتشَهَّدَ، فحمدَ اللَّهَ وأثنى عليهِ، ثمَّ قالَ: أمَّا بعدُ؛ فإنَّهُ لم يَخفَ عليَّ شأنُكُم، ولَكِنِّي خشيتُ أن تُفتَرضَ عليكم صلاةُ اللَّيلِ فتَعجِزوا عنها، وَكانَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يرغِّبُهُم في قيامِ رمضانَ مِن غيرِ أن يأمرَ بِعَزيمةِ أمرٍ، فيقولُ: ",["مَن صامَ رمضانَ إيمانًا واحتسابًا ",1],["غُفِرَ لَهُ ما تقدَّمَ من ذنبِهِ، فتوُفِّيَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فَكانَ الأمرُ كذلِكَ في خلافةِ أبي بَكْرٍ، وصدرًا من خلافةِ عمرَ، حتَّى جمعَهُم عمرُ على أبيِّ بنِ",2]," كعبٍ، وصلَّى بِهِم، فَكانَ ذلِكَ أوَّلَ ما اجتمعَ النَّاسُ على قيامِ رمضانَ"],"grade":"صحيح","narrator":"عائشة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن حبان (6060) بلفظ مقارب، والبخاري (1908)، ومسلم (761) مختصرا","bab":"فضائل النبي وصفته ودلائل النبوة › شفقته على أمته","dorar":"uYJh7XlS"},{"id":"س-03362","fp":"67e52004300f","stateId":82,"easy":"إذا صمت رمضان إيماناً واحتساباً ← تخرج من ذنوبك كيوم ولدتك أمك","cause":"فمَن صامَهُ إيمانًا واحتسابًا","result":"خرجَ منَ الذُّنوبِ كيَومِ ولَدتهُ أمُّهُ","explicit":true,"apply":{"k":"time","t":"في رمضان"},"ref":"تخريج المسند لشاكر 3/142","srcLabel":"النسائي","text":["إنَّ رمضانَ شَهْرٌ افترضَ اللَّهُ عزَّ وجلَّ صيامَهُ ، وإنِّي سَننتُ للمُسلِمينَ قيامَهُ ، ",["فمَن صامَهُ إيمانًا واحتسابًا ، ",1],["خرجَ منَ الذُّنوبِ كيَومِ ولَدتهُ أمُّهُ",2]],"grade":"صحيح","narrator":"عبدالرحمن بن عوف","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (2210)، وابن ماجه (1328) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"eieRMAZX","merged":3,"otherRefs":["تخريج المسند لشاكر 3/128 (صحيح)","صحيح ابن ماجه 1101 (صحيح)"]},{"id":"س-03363","fp":"10671baa41e8","stateId":82,"easy":"إذا ملكت في رمضان سمعك وبصرك ولسانك ← يُغفر لك","cause":"من مَلَكَ فيهِ سَمْعَهُ وبَصَرَه ولسانَهُ","result":"غُفِرَ لهُ","explicit":true,"apply":{"k":"time","t":"في رمضان"},"ref":"تخريج المسند لشاكر 5/17","srcLabel":"أحمد","text":["كان فلانٌ رَدِيفَ رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يومَ عرفةَ قال : فجعلَ الفتى يُلاحِظُ النساءَ وينظرُ إليهنَّ قال : وجعلَ رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يَصرفُ وجهَهُ بيدِه من خلفهِ مرارًا قال : وجعلَ الفتى يُلاحِظُ إليهنَّ قال : فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ : ابنَ أخي إنَّ هذا يومٌ ",["من مَلَكَ فيهِ سَمْعَهُ وبَصَرَه ولسانَهُ",1]," ",["غُفِرَ لهُ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (3041) واللفظ له، وأبو يعلى (2441)، والطبراني (12/232) (12974)","bab":"استغفار › أسباب المغفرة","dorar":"J8w1u7Ty","merged":2,"otherRefs":["الترغيب والترهيب 2/195 (صحيح)"]},{"id":"س-03366","fp":"0a53d707d092","stateId":82,"easy":"إذا صمت رمضان وعرفت حدوده وتحفّظت فيه ← يكفّر ما قبله","cause":"من صام رمضانَ وعرف حدودَه وتحفَّظ ممَّا ينبغي له أن يتحفَّظَ","result":"كفَّر ما قبله","explicit":true,"apply":{"k":"time","t":"في رمضان"},"ref":"الترغيب والترهيب 2/112","srcLabel":"أحمد","text":[["من صام رمضانَ وعرف حدودَه وتحفَّظ ممَّا ينبغي له أن يتحفَّظَ ",1],["كفَّر ما قبله",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أحمد (11524)، وابن حبان (3433)، والبيهقي (8768) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"BSmCKoIb","merged":2,"otherRefs":["الزواجر عن اقتراف الكبائر 1/197 (حسن)"]},{"id":"س-03284","fp":"cee4e7e25a94","stateId":82,"easy":"إذا صمت رمضان إلى رمضان ← يكون كفارة لما بينهما","cause":"صيامُ رمضانَ إلى رمضانَ","result":"كفَّارةُ ما بينهما","explicit":true,"apply":{"k":"time","t":"في رمضان"},"similar":["س-06536"],"ref":"مجمع الزوائد 3/145","srcLabel":"الطبراني","text":[["صيامُ رمضانَ إلى رمضانَ ",1],["كفَّارةُ ما بينهما",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"فيه عبد الله بن قريظ ذكره ابن أبي حاتم وقال يروي عنه يحيى بن أيوب وبقية رجاله رجال الصحيح","takhrij":"أخرجه الطبراني ((6/ 38)) (5445) واللفظ له، وابن شاهين في ((فضائل رمضان)) (32) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"U0kd74qR"},{"id":"س-03499","fp":"c4bbd6657d68","stateId":82,"easy":"إذا صمت شهر رمضان ← يكفّر ما بينه وبين رمضان المقبل","cause":"شهرُ رمضانَ","result":"يُكَفِّرُ ما بينَ يديْهِ إلى شهرِ رمضانَ المقبلِ","explicit":true,"apply":{"k":"time","t":"في رمضان"},"similar":["س-03696"],"ref":"الجامع الصغير 4887","srcLabel":"ابن أبي الدنيا","text":[["شهرُ رمضانَ ",1],["يُكَفِّرُ ما بينَ يديْهِ إلى شهرِ رمضانَ المقبلِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي الدنيا في ((فضائل ‌رمضان)) (36) واللفظ له.","bab":"استغفار › مكفرات الذنوب","dorar":"ajGNazt8"},{"id":"س-03696","fp":"dc71398d3a7f","stateId":82,"easy":"إذا صمت الشهر (رمضان) ← يكون كفارة لما بينه وبين الذي قبله","cause":"والشَّهرُ إلى الشَّهرِ الذي قَبلَهُ","result":"كَفَّارةٌ","explicit":true,"apply":{"k":"time","t":"في رمضان"},"repOf":"س-03499","ref":"تخريج المسند لشعيب 10576","text":["الصَّلاةُ إلى الصَّلاةِ التي قَبلَها كَفَّارةٌ، والجُمُعةُ إلى الجُمُعةِ التي قَبلَها كَفَّارةٌ، ",["والشَّهرُ إلى الشَّهرِ الذي قَبلَهُ",1]," ",["كَفَّارةٌ",2],"، إلَّا مِن ثلاثٍ -قال: فعَرَفْنا أنَّه أمْرٌ حدَثَ-: إلَّا مِنَ الشِّركِ باللهِ، ونَكثِ الصَّفقةِ، وتَركِ السُّنَّةِ. قال: قلنا: يا رسولَ اللهِ، هذا الشِّركُ باللهِ قد عرَفْناهُ، فما نَكثُ الصَّفقةِ، وتَركُ السُّنَّةِ؟ قال: أمَّا نَكثُ الصَّفقةِ؛ فأنْ تُعطيَ رَجُلًا بَيعَتَكَ، ثم تُقاتِلُهُ بسَيفِكَ، وأمَّا تَركُ السُّنَّةِ؛ فالخُروجُ مِن الجماعةِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح دون قوله: \"إلا من ثلاث\" إلخ","takhrij":"أخرجه أحمد (10576) واللفظ له، والحاكم (412)، والبيهقي في ((شعب الإيمان)) (3620)","bab":"اعتصام بالسنة › لزوم السنة","dorar":"ABD4mO4u"},{"id":"س-06536","fp":"7f141c36d35f","stateId":82,"easy":"إذا صمت رمضان إلى رمضان ← يكون كفارة لما بينهما","cause":"والشَّهرُ إلى الشَّهرِ -يَعْني رَمَضانَ إلى رَمَضانَ","result":"كفَّارةٌ لِما بَيْنَهما","explicit":true,"apply":{"k":"time","t":"في رمضان"},"repOf":"س-03284","ref":"تخريج المسند لشعيب 7129","text":["الصَّلاةُ المكتوبةُ إلى الصَّلاةِ التي بَعدَها كفَّارةٌ لِما بَيْنَهما، قال: والـجُمُعةُ إلى الـجُمُعةِ، ",["والشَّهرُ إلى الشَّهرِ -يَعْني رَمَضانَ إلى رَمَضانَ",1],"- ",["كفَّارةٌ لِما بَيْنَهما",2],"، قال: ثم قال بعدَ ذلك: إلَّا مِن ثَلاثٍ -قال: فعَرَفتُ أنَّ ذلك لأَمْرٍ حَدَث-: إلَّا مِنَ الإشراكِ باللهِ، ونَكْثِ الصَّفْقةِ، وتَرْكِ السُّنَّةِ، قال: أمَّا نَكْثُ الصَّفْقةِ: أنْ تُبايِعَ رَجُلًا، ثم تُـخالِفَ إليه تُقاتِلُه بِسيفِك، وأما تَرْكُ السُّنَّةِ قال: قُلتُ: يا رسولَ اللهِ، أمَّا الإشراكُ باللهِ فقد عَرَفْناه، فما نَكْثُ الصَّفْقةِ؟ قال: فأنْ تُبايِعَ رَجُلًا ثم تُـخالِفَ إليه تُقاتِلُه بسَيفِك، وأمَّا تَرْكُ السُّنَّةِ فالـخُروجُ مِن الـجَماعةِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح دون قوله: إلا من ثلاث ... إلى آخر الحديث","takhrij":"أخرجه أحمد (7129) واللفظ له، والحاكم (412)، والبيهقي في ((شعب الإيمان)) (3620)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"dRf9RxIn"},{"id":"س-06555","fp":"94d2592103ef","stateId":82,"easy":"إذا صمت رمضان وصليت الصلوات وحججت البيت ← كان حقاً على الله أن يغفر لك","cause":"مَن صامَ رمضانَ وصلَّى الصَّلواتِ وحجَّ البيتَ ، لا أَدري أذَكَرَ الزَّكاةَ أم","result":"لا ، إلَّا كانَ حقًّا علَى اللَّهِ أن يغفرَ لَهُ ، إن هاجرَ في سبيلِ اللَّهِ ، أو مَكَثَ بأرضِهِ الَّتي وُلِدَ بِها","explicit":true,"apply":{"k":"time","t":"في رمضان"},"ref":"صحيح الترمذي 2530","srcLabel":"الترمذي","text":[["مَن صامَ رمضانَ وصلَّى الصَّلواتِ وحجَّ البيتَ ، لا أَدري أذَكَرَ الزَّكاةَ أم ",1],["لا ، إلَّا كانَ حقًّا علَى اللَّهِ أن يغفرَ لَهُ ، إن هاجرَ في سبيلِ اللَّهِ ، أو مَكَثَ بأرضِهِ الَّتي وُلِدَ بِها",2]," قالَ معاذٌ : ألا أخبرُ بِها النَّاسَ ؟ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ : ذرِ النَّاسَ يعمَلونَ فإنَّ في الجنَّةِ مائةَ درجةٍ ما بينَ كلِّ درجَتينِ كما بينَ السَّماءِ والأرضِ ، والفِردَوسُ أعلى الجنَّةِ وأوسطُها ، وفَوقَ ذلِكَ عرشُ الرَّحمنِ ، ومنها تُفجَّرُ أنهارُ الجنَّةِ ، فإذا سَألتُمُ اللَّهَ فسَلوهُ الفردوسَ ."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2530) واللفظ له، وابن ماجه (4331) مختصراً، وأحمد (22087) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"fgcWL0W3"},{"id":"س-02647","fp":"03f00ad43b3a","stateId":82,"easy":"إذا صمت رمضان وقمته إيماناً واحتساباً ويقيناً ← يكون كفارة لما مضى","cause":"فمَن صامَه وقامَه إيمانًا واحتسابًا ويقينًا","result":"كان كفَّارةً لِما مضى","explicit":true,"apply":{"k":"time","t":"في رمضان"},"ref":"التنوير شرح الجامع الصغير 3/274","srcLabel":"النسائي","text":["إنَّ اللهَ تعالى افترَض صَوْمَ رمضانَ، وسنَنْتُ لكم قيامَه؛ ",["فمَن صامَه وقامَه إيمانًا واحتسابًا ويقينًا، ",1],["كان كفَّارةً لِما مضى",2],"."],"grade":"حسن","narrator":"عبد الرحمن بن عوف","muhaddith":"إسناده حسن","takhrij":"أخرجه النسائي (2210)، وابن ماجه (1328)، والبيهقي في ((شعب الإيمان)) (3342) بلفظه.","bab":"إيمان › الاحتساب والنية","dorar":"0Q3ZOjsb"},{"id":"س-03332","fp":"6f59261b0592","stateId":82,"easy":"إذا أدركت رمضان شهر البركة ← تنزل فيه الرحمة وتُحط الخطايا ويُستجاب الدعاء","cause":"رمضانُ شهرُ بركةٍ","result":"فيُنزِلُ الرَّحمةَ ويحُطُّ الخطايا ويستجيبُ فيه الدُّعاءَ","explicit":true,"apply":{"k":"time","t":"في رمضان"},"otherNeedIds":[29],"ref":"الترغيب والترهيب 2/117","srcLabel":"الطبراني","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال يومًا وحضر رمضانُ أتاكم ",["رمضانُ شهرُ بركةٍ",1]," يغشاكم اللهُ فيه ",["فيُنزِلُ الرَّحمةَ ويحُطُّ الخطايا ويستجيبُ فيه الدُّعاءَ",2]," ينظرُ اللهُ تعالَى إلى تنافُسِكم فيه ويُباهي بكم ملائكتَه فأروا اللهَ من أنفسِكم خيرًا فإنَّ الشَّقِيَّ من حُرم فيه رحمةَ اللهِ عزَّ وجلَّ"],"grade":"حسن","narrator":"عبادة بن الصامت","muhaddith":"رواته ثقات إلا أن محمد بن قيس لا يحضرني فيه جرح ولا تعديل","takhrij":"أخرجه الشاشي في ((المسند)) (1224)، والطبراني في ((مسند الشاميين)) (2238) واللفظ لهما.","bab":"استغفار › أسباب المغفرة","dorar":"JZF6aUMP"},{"id":"س-08176","fp":"434c56974c55","stateId":82,"easy":"إذا كنت من الأمة في شهر رمضان ← ينظر الله إليك، ومن نظر الله إليه لم يعذبه","cause":"أمَّتي في شهرِ رمضانَ","result":"نظر اللهُ عزَّ وجلَّ إليهم ومن نظر اللهُ إليه لم يعذِّبْه أبدًا وأمَّا الثَّانيةُ فإنَّ خلوفَ أفواهِهم حين يُمسون أطيبُ عند اللهِ من ريحِ المسكِ وأمَّا الثَّالثةُ فإنَّ الملائكةَ تستغفِرُ لهم في كلِّ يومٍ وليلةٍ وأمَّا الرَّابعةُ فإنَّ اللهَ عزَّ وجلَّ يأمُرُ جنَّتَه فيقولُ لها استعدِّي وتزيَّني لعبادي أوْشَك أن يستريحوا من تعبِ الدُّنيا إلى داري وكرامتي وأمَّا الخامسةُ فإنَّه إذا كان آخرُ ليلةٍ غفر اللهُ لهم جميعًا","explicit":true,"apply":{"k":"time","t":"في رمضان"},"otherNeedIds":[66,23,24],"ref":"الترغيب والترهيب 2/113","srcLabel":"البيهقي","text":["أُعطِيَتْ ",["أمَّتي في شهرِ رمضانَ",1]," خمسًا لم يُعطَهنَّ نبيٌّ قبلي أمَّا واحدةٌ فإنَّه إذا كان أوَّلُ ليلةٍ من شهرِ رمضانَ ",["نظر اللهُ عزَّ وجلَّ إليهم ومن نظر اللهُ إليه لم يعذِّبْه أبدًا وأمَّا الثَّانيةُ فإنَّ خلوفَ أفواهِهم حين يُمسون أطيبُ عند اللهِ من ريحِ المسكِ وأمَّا الثَّالثةُ فإنَّ الملائكةَ تستغفِرُ لهم في كلِّ يومٍ وليلةٍ وأمَّا الرَّابعةُ فإنَّ اللهَ عزَّ وجلَّ يأمُرُ جنَّتَه فيقولُ لها استعدِّي وتزيَّني لعبادي أوْشَك أن يستريحوا من تعبِ الدُّنيا إلى داري وكرامتي وأمَّا الخامسةُ فإنَّه إذا كان آخرُ ليلةٍ غفر اللهُ لهم جميعًا",2]," فقال رجلٌ من القومِ أهي ليلةُ القدرِ فقال لا ألم ترَ إلى العمَّالِ يعملون فإذا فرغوا من أعمالِهم وُفُّوا أجورَهم"],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"إسناده مقارب أصلح مما قبله","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (3603)","bab":"ملائكة › أعمال الملائكة","dorar":"l5UNfhxc"},{"id":"س-03563","fp":"b83aa798a726","stateId":83,"easy":"إذا صمت يوم عرفة ← يكفّر سنتين: ماضية ومستقبلة","cause":"صَومِ يومِ عَرَفةَ","result":"أحتسِبُ على اللهِ كفَّارةَ سَنتَينِ: ماضيةٍ ومُستقبَلةٍ","explicit":true,"star":true,"apply":{"k":"time","t":"يوم عرفة"},"similar":["س-03504","س-03408"],"otherNeedIds":[49],"ref":"تخريج المسند لشعيب 22650","srcLabel":"مسلم","text":["أنَّ رَجُلًا سَأَلَ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ عن ",["صَومِ يومِ عَرَفةَ",1],"، فقال: ",["أحتسِبُ على اللهِ كفَّارةَ سَنتَينِ: ماضيةٍ ومُستقبَلةٍ",2],"، قال: يا رسولَ اللهِ، أرَأَيتَ رَجُلًا يَصومُ الدَّهرَ كلَّه؟ قال: لا صام ولا أفطَرَ -أو: ما صام وما أفطَرَ-، قال: يا رسولَ اللهِ، أرَأَيتَ رَجُلًا يَصومُ يومًا ويُفطِرُ يومًا؟ قال: ذاك صَومُ أخي داوُدَ عليه السَّلامُ، قال: يا رسولَ اللهِ، أرَأَيتَ رَجُلًا يَصومُ يومًا ويُفطِرُ يومَينِ؟ قال: وَدِدتُ أنِّي طُوِّقْتُ ذلك، قال: أرَأَيتَ رَجُلًا يَصومُ يومَينِ ويُفطِرُ يومًا؟ قال: ومَن يُطيقُ ذلك؟ قال: وسُئِلَ عن صَومِ يومِ عاشوراءَ؟ قال: أحتسِبُ على اللهِ كفَّارةَ سَنةٍ."],"grade":"صحيح","narrator":"أبو قتادة الحارث بن ربعي","muhaddith":"إسناده صحيح على شرط مسلم.","takhrij":"أخرجه مسلم (1162) مطولاً","bab":"استغفار › مكفرات الذنوب","dorar":"j7TL87CR","merged":9,"otherRefs":["صحيح الجامع 3805 (صحيح)","التمهيد 21/162 (صحيح)","عارضة الأحوذي 2/205 (صحيح)","تخريج المسند لشعيب 22531 (صحيح)","تخريج المسند لشعيب 22588 (صحيح)","تخريج صحيح ابن حبان 3631 (صحيح)","تخريج المسند لشعيب 22621 (صحيح)","الترغيب والترهيب 2/127 (حسن)"]},{"id":"س-03564","fp":"7c6074d4226f","stateId":83,"easy":"إذا صمت يوم عاشوراء ← يكفّر سنة","cause":"صَومِ يومِ عاشوراءَ","result":"أحتسِبُ على اللهِ كفَّارةَ سَنةٍ","explicit":true,"star":true,"similar":["س-02661","س-03562","س-01912"],"ref":"تخريج المسند لشعيب 22650","srcLabel":"مسلم","text":["أنَّ رَجُلًا سَأَلَ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ عن صَومِ يومِ عَرَفةَ، فقال: أحتسِبُ على اللهِ كفَّارةَ سَنتَينِ: ماضيةٍ ومُستقبَلةٍ، قال: يا رسولَ اللهِ، أرَأَيتَ رَجُلًا يَصومُ الدَّهرَ كلَّه؟ قال: لا صام ولا أفطَرَ -أو: ما صام وما أفطَرَ-، قال: يا رسولَ اللهِ، أرَأَيتَ رَجُلًا يَصومُ يومًا ويُفطِرُ يومًا؟ قال: ذاك صَومُ أخي داوُدَ عليه السَّلامُ، قال: يا رسولَ اللهِ، أرَأَيتَ رَجُلًا يَصومُ يومًا ويُفطِرُ يومَينِ؟ قال: وَدِدتُ أنِّي طُوِّقْتُ ذلك، قال: أرَأَيتَ رَجُلًا يَصومُ يومَينِ ويُفطِرُ يومًا؟ قال: ومَن يُطيقُ ذلك؟ قال: وسُئِلَ عن ",["صَومِ يومِ عاشوراءَ",1],"؟ قال: ",["أحتسِبُ على اللهِ كفَّارةَ سَنةٍ",2],"."],"grade":"صحيح","narrator":"أبو قتادة الحارث بن ربعي","muhaddith":"إسناده صحيح على شرط مسلم.","takhrij":"أخرجه مسلم (1162) مطولاً","bab":"استغفار › مكفرات الذنوب","dorar":"j7TL87CR","merged":6,"otherRefs":["التمهيد 21/162 (صحيح)","عارضة الأحوذي 2/205 (صحيح)","تخريج المسند لشعيب 22531 (صحيح)","تخريج المسند لشعيب 22588 (صحيح)","تخريج المسند لشعيب 22621 (صحيح)"]},{"id":"س-02660","fp":"a82720241dc7","stateId":83,"easy":"إذا صمت يوم عرفة ← يكفّر الله عنك السنة التي قبله والتي بعده","cause":"صِيامُ يومِ عَرَفَةَ","result":"إِنِّي أحْتَسِبُ على اللهِ أنْ يُكَفِّرَ السنَةَ التي قَبلَهُ ، و السنَةَ التي بَعدَهُ","explicit":true,"apply":{"k":"time","t":"يوم عرفة"},"similar":["س-03310"],"ref":"صحيح الجامع 3853","srcLabel":"مسلم","text":[["صِيامُ يومِ عَرَفَةَ",1]," ، ",["إِنِّي أحْتَسِبُ على اللهِ أنْ يُكَفِّرَ السنَةَ التي قَبلَهُ ، و السنَةَ التي بَعدَهُ",2]," ، و صِيامُ يومِ عاشُوراءَ ، إِنِّي أحْتَسِبُ على اللهِ أنْ يُكَفِّرَ السنَةَ التِي قَبْلَهُ"],"grade":"صحيح","narrator":"أبو قتادة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1162)، وأبو داود (2425)، وأحمد (22650) مطولاً، والترمذي (749، 752) مفرقاً، وابن ماجه (1730، 1738) مفرقاً، وابن حبان (3632) واللفظ له","bab":"إيمان › الاحتساب والنية","dorar":"Yjk7gFh8","merged":2,"otherRefs":["صحيح ابن خزيمة 3/ 500 (صحيح)"]},{"id":"س-02661","fp":"485b6bc3b768","stateId":83,"easy":"إذا صمت يوم عاشوراء ← يكفّر الله عنك السنة التي قبله","cause":"و صِيامُ يومِ عاشُوراءَ","result":"إِنِّي أحْتَسِبُ على اللهِ أنْ يُكَفِّرَ السنَةَ التِي قَبْلَهُ","explicit":true,"repOf":"س-03564","ref":"صحيح الجامع 3853","text":["صِيامُ يومِ عَرَفَةَ ، إِنِّي أحْتَسِبُ على اللهِ أنْ يُكَفِّرَ السنَةَ التي قَبلَهُ ، و السنَةَ التي بَعدَهُ ، ",["و صِيامُ يومِ عاشُوراءَ",1]," ، ",["إِنِّي أحْتَسِبُ على اللهِ أنْ يُكَفِّرَ السنَةَ التِي قَبْلَهُ",2]],"grade":"صحيح","narrator":"أبو قتادة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1162)، وأبو داود (2425)، وأحمد (22650) مطولاً، والترمذي (749، 752) مفرقاً، وابن ماجه (1730، 1738) مفرقاً، وابن حبان (3632) واللفظ له","bab":"إيمان › الاحتساب والنية","dorar":"Yjk7gFh8","merged":2,"otherRefs":["صحيح ابن خزيمة 3/ 500 (صحيح)"]},{"id":"س-03504","fp":"b137aeffd22f","stateId":83,"easy":"إذا صمت يوم عرفة ← يكفّر سنتين","cause":"صَومُ يومِ عَرَفةَ","result":"يُكفِّرُ سَنتَينِ","explicit":true,"apply":{"k":"time","t":"يوم عرفة"},"repOf":"س-03563","ref":"تخريج المسند لشعيب 22535","text":[["صَومُ يومِ عَرَفةَ ",1],["يُكفِّرُ سَنتَينِ",2],"؛ ماضيةً ومُستقبَلةً، وصَومُ عاشوراءَ يُكفِّرُ سَنةً ماضيةً."],"grade":"صحيح","narrator":"أبو قتادة الحارث بن ربعي","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1162) مطولاً","bab":"استغفار › مكفرات الذنوب","dorar":"sgIXjoIO"},{"id":"س-03562","fp":"a64e88dce415","stateId":83,"easy":"إذا صمت يوم عاشوراء ← يكفّر سنة","cause":"يصومُ يومَ عاشوراءَ","result":"ذاك صومُ سنَةٍ","explicit":true,"repOf":"س-03564","otherNeedIds":[49],"ref":"تخريج صحيح ابن حبان 3631","text":["أنَّ رجلًا سأَل النَّبيَّ صلَّى اللهُ عليه وسلَّم فقال: يا رسولَ اللهِ أرأَيْتَ رجلًا ",["يصومُ يومَ عاشوراءَ",1]," ؟ قال: ( ",["ذاك صومُ سنَةٍ",2]," ) قال: أرأَيْتَ رجلًا يصومُ يومَ عرفةَ قال: ( يُكفِّرُ السَّنةَ وما قبْلَها )"],"grade":"صحيح","narrator":"أبو قتادة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن حبان (3631) بلفظه، ومسلم (1162)، وأبو داود (2425) بنحوه.","bab":"استغفار › مكفرات الذنوب","dorar":"E4JlZ9ML"},{"id":"س-01912","fp":"d0504057e66b","stateId":83,"easy":"إذا صمت يوم عاشوراء ← يكفّر عنك سنة","cause":"صَومُهُ","result":"يكفِّرُ سنةً","explicit":true,"repOf":"س-03564","ref":"حقوق آل البيت 48","text":["عنِ النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ : أنه صامَ يومَ عاشوراءَ, وأمر بصيامِهِ و قال : ",["صَومُهُ ",1],["يكفِّرُ سنةً",2]],"grade":"صحيح","muhaddith":"ثابت","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"MuzPQT5H"},{"id":"س-03278","fp":"58b46d94a95c","stateId":83,"easy":"إذا صمت عاشوراء ← يكفّر العام الذي قبله، وصوم عرفة يكفّر عامين","cause":"صومُ يومِ عاشوراءَ","result":"يكفِّرُ العامَ الَّذي قبلَه وصومُ يومِ عرفةَ يُكفِّرُ العامَ الَّذي قبلَه والَّذي بعده","explicit":true,"ref":"معجم الشيوخ 2/747","srcLabel":"ابن عساكر","text":[["صومُ يومِ عاشوراءَ ",1],["يكفِّرُ العامَ الَّذي قبلَه وصومُ يومِ عرفةَ يُكفِّرُ العامَ الَّذي قبلَه والَّذي بعده",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"حسن صحيح غريب","takhrij":"أخرجه ابن عساكر في ((معجم الشيوخ)) (931)","bab":"استغفار › أسباب المغفرة","dorar":"doy9vxON"},{"id":"س-03393","fp":"ff2dbf92ce3d","stateId":83,"easy":"إذا صمت يوم عرفة ← يُغفر لك سنة أمامه وسنة خلفه، وعاشوراء سنة","cause":"من صام يومَ عرفةَ","result":"غُفِرَ له سنةٌ أمامَه ، وسنةٌ خلْفَه ، و من صام عاشوراءَ غُفِرَ له سنةٌ","explicit":true,"apply":{"k":"time","t":"يوم عرفة"},"similar":["س-03534"],"ref":"صحيح الترغيب 1021","srcLabel":"الطبراني","text":[["من صام يومَ عرفةَ ",1],["غُفِرَ له سنةٌ أمامَه ، وسنةٌ خلْفَه ، و من صام عاشوراءَ غُفِرَ له سنةٌ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح لغيره","takhrij":"أخرجه البزار كما في ((مجمع الزوائد)) للهيثمي (3/192) واللفظ له، وأخرجه الطبراني في ((المعجم الأوسط)) (2065) بنحوه مختصراً، وابن عساكر في ((تاريخ دمشق)) (43/230) مختصراً باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"bCdgGO2R"},{"id":"س-03408","fp":"ef5bf04464cc","stateId":83,"easy":"إذا صمت يوم عرفة ← يكفّر سنتين","cause":"صيامُ يومِ عرفةَ","result":"يكفِّرُ سنتَينِ","explicit":true,"apply":{"k":"time","t":"يوم عرفة"},"repOf":"س-03563","ref":"المستدرك على مجموع الفتاوى 3/126","text":[["صيامُ يومِ عرفةَ ",1],["يكفِّرُ سنتَينِ ",2],"، وصيامُ يومِ عاشوراءَ يكفِّرُ سنةً"],"grade":"صحيح","muhaddith":"صحيح","bab":"استغفار › أسباب المغفرة","dorar":"BN8kx2dA"},{"id":"س-03534","fp":"e0b4da1fa8c2","stateId":83,"easy":"إذا صمت يوم عرفة ← يُغفر لك سنتان متتابعتان","cause":"مَن صام عَرَفَةَ","result":"غُفِر له سنتينِ مُتتابعتينِ","explicit":true,"apply":{"k":"time","t":"يوم عرفة"},"repOf":"س-03393","ref":"إتحاف الخيرة المهرة 3/80","text":[["مَن صام عَرَفَةَ ",1],["غُفِر له سنتينِ مُتتابعتينِ",2]],"grade":"صحيح","narrator":"سهل بن سعد الساعدي","muhaddith":"سنده صحيح","takhrij":"أخرجه عبد بن حميد (463)، وأبو يعلى (7548)، والطبراني (6/179) (5923) باختلاف يسير","bab":"استغفار › مكفرات الذنوب","dorar":"SlDOTl7d"},{"id":"س-03310","fp":"0216eb6e3ee2","stateId":83,"easy":"إذا صمت يوم عرفة ← يُغفر لك ذنب سنة قبله وسنة بعده","cause":"مَن صامَ يومَ عرفةَ","result":"غُفِرَ لَهُ ما تقدَّمَ مِن ذنبِهِ سنَةً وما تأخَّرَ سنةً","explicit":true,"apply":{"k":"time","t":"يوم عرفة"},"repOf":"س-02660","ref":"الأمالي المطلقة 141","text":[["مَن صامَ يومَ عرفةَ ",1],["غُفِرَ لَهُ ما تقدَّمَ مِن ذنبِهِ سنَةً وما تأخَّرَ سنةً",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن","takhrij":"أخرجه أبو سعيد النقاش كما في ((الخصال المكفرة لابن حجر)) (27) واللفظ له، والطبراني في ((الأوسط)) (751)، وتمام في ((فوائده)) (1584) بمعناه.","bab":"استغفار › أسباب المغفرة","dorar":"pnRN0AlY"},{"id":"س-03503","fp":"2eed6ad4a61e","stateId":84,"easy":"إذا حججت فلم ترفث ولم تفسق ← ترجع من ذنوبك كيوم ولدتك أمك","cause":"مَن حَجَّ فلم يَرفُثْ ولم يَفسُقْ","result":"رَجَعَ مِن ذُنوبِه كَهَيئَتِه يَومَ وَلَدتْه أُمُّه","explicit":true,"star":true,"similar":["س-03299","س-03515"],"ref":"تخريج المسند لشعيب 23/255","srcLabel":"متفق عليه","text":[["مَن حَجَّ فلم يَرفُثْ ولم يَفسُقْ",1]," ",["رَجَعَ مِن ذُنوبِه كَهَيئَتِه يَومَ وَلَدتْه أُمُّه",2],"."],"grade":"صحيح","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1521)، ومسلم (1350) باختلاف يسير من حديث أبي هريرة رضي الله عنه.","bab":"استغفار › مكفرات الذنوب","dorar":"28I8nU4z","merged":3,"otherRefs":["صحيح الجامع 6197 (صحيح)","الزواجر عن اقتراف الكبائر 1/204 (صحيح)"]},{"id":"س-03257","fp":"41ebec12333d","stateId":84,"easy":"إذا اعتمرت ثم اعتمرت ← تكون كفارة لما بينهما","cause":"والعمرةُ إلى العمرةِ","result":"تكفيرٌ لما بينَهُما","explicit":true,"star":true,"similar":["س-03530","س-02290"],"ref":"المحلى 7/68","srcLabel":"متفق عليه","text":["الحجُّ المبرورُ ليس له جزاءٌ إلا الجنةُ ",["والعمرةُ إلى العمرةِ",1]," ",["تكفيرٌ لما بينَهُما",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"احتج به ، وقال في المقدمة: (لم نحتج إلا بخبر صحيح من رواية الثقات مسند)","takhrij":"أخرجه البخاري (1773)، ومسلم (1349) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"mZmpM1XG","merged":2,"otherRefs":["البحر الزخار 15/370 (حسن)"]},{"id":"س-03256","fp":"1b46d4cefd0f","stateId":84,"easy":"إذا حججت فلم ترفث ولم تفسق ← يُغفر لك ما تقدّم من ذنبك","cause":"من حَجَّ فلم يرفُث ولم يفسق","result":"غفرَ لَهُ ما تقدَّمَ من ذنبِهِ","explicit":true,"star":true,"ref":"صحيح الترمذي 811","srcLabel":"متفق عليه","text":[["من حَجَّ فلم يرفُث ولم يفسق ",1],["غفرَ لَهُ ما تقدَّمَ من ذنبِهِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1521)، ومسلم (1350)، والنسائي (2627)، وابن ماجه (2889)، وأحمد (9311) بنحوه، والترمذي (811) واللفظ له","bab":"استغفار › أسباب المغفرة","dorar":"roq1RkAL"},{"id":"س-03299","fp":"ac9c52f5fc28","stateId":84,"easy":"إذا حججت البيت فلم ترفث ولم تفسق ← ترجع كيوم ولدتك أمك","cause":"مَن أتى هذا البَيتَ، فلَم يَرفُثْ، ولَم يَفسُقْ","result":"رَجَعَ كما ولَدَتْه أُمُّه","explicit":true,"repOf":"س-03503","ref":"صحيح مسلم 1350","text":[["مَن أتى هذا البَيتَ، فلَم يَرفُثْ، ولَم يَفسُقْ، ",1],["رَجَعَ كما ولَدَتْه أُمُّه",2],". [وفي روايةٍ]: مَن حَجَّ فلَم يَرفُثْ، ولَم يَفسُقْ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1521)، ومسلم (1350) واللفظ له","bab":"استغفار › أسباب المغفرة","dorar":"2ZjJMK6x"},{"id":"س-03515","fp":"1117d0540c85","stateId":84,"easy":"إذا حججت أو اعتمرت فلم ترفث ولم تفسق ← ترجع كيوم ولدتك أمك","cause":"مَن حَجَّ أو اعتَمَرَ فلمْ يَرفُثْ ولم يَفسُقْ","result":"يَرجِعْ كهَيئَةِ يَومِ وَلَدَتْه أُمُّه","explicit":true,"repOf":"س-03503","ref":"تخريج سنن الدارقطني 2714","text":[["مَن حَجَّ أو اعتَمَرَ فلمْ يَرفُثْ ولم يَفسُقْ ",1],["يَرجِعْ كهَيئَةِ يَومِ وَلَدَتْه أُمُّه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الدارقطني (2714) بلفظه، والبخاري (6858)، ومسلم (1660) كلاهما بنحوه دون قوله:((أو اعتمر)).","bab":"استغفار › مكفرات الذنوب","dorar":"fKF7JVAv"},{"id":"س-03530","fp":"1baad8f8e54c","stateId":84,"easy":"إذا اعتمرت ثم اعتمرت ← تكون كفارة لما بينهما من الذنوب","cause":"العُمْرةُ إلى العُمْرةِ","result":"كَفَّارةٌ لِما بَيْنَهما مِن الذُّنوبِ والخَطايا","explicit":true,"repOf":"س-03257","ref":"الأحاديث المختارة 8 / 195","text":[["(«العُمْرةُ إلى العُمْرةِ ",1],["كَفَّارةٌ لِما بَيْنَهما مِن الذُّنوبِ والخَطايا",2],"، والحَجُّ المَبْرورُ ليس له جَزاءٌ إلَّا الجنَّةُ»)."],"grade":"صحيح","narrator":"عامر بن ربيعة","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"استغفار › مكفرات الذنوب","dorar":"KskKaMaJ"},{"id":"س-04573","fp":"0b0ccb027a97","stateId":84,"easy":"إذا حلقت رأسك في النسك ← فلك دعوة النبي ﷺ بالرحمة","cause":"المُحَلِّقينَ","result":"يَرحَمُ اللهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"الأحاديث المختارة 13 / 81","srcLabel":"متفق عليه","text":["«حَلَقَ رِجالٌ يَوْمَ الحُدَيْبِيَةِ، وقَصَّرَ آخَرونَ، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يَرحَمُ اللهُ ",["المُحَلِّقينَ",1],"، قالوا: يا رَسولَ اللهِ! والمُقَصِّرينَ؟ قالَ: ",["يَرحَمُ اللهُ",2]," المُحَلِّقينَ، قالوا: يا رَسولَ اللهِ! والمُقَصِّرينَ؟ قالَ: يَرحَمُ اللهُ المُحَلِّقينَ، قالوا: يا رَسولَ اللهِ! والمُقَصِّرينَ؟ قالَ: والمُقَصِّرينَ، قالوا: فما بالُ المُحَلِّقينَ يا رَسولَ اللهِ! ظاهَرْتَ لهم التَّرَحُّمَ؟ قالَ: لم يَشُكُّوا، قالَ: فانْصَرَفَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"حج › الحلق والتقصير","dorar":"Mpy0Ysd8","merged":15,"otherRefs":["صحيح مسلم 1302 (صحيح)","الإصابة في تمييز الصحابة 3/344 (حسن)","صحيح مسلم 1303 (صحيح)","حجة الوداع 202 (صحيح)","تخريج المسند لشعيب 27261 (صحيح)","تخريج المسند لشعيب 27267 (صحيح)","تخريج المسند لشعيب 27264 (صحيح)","تخريج المسند لشعيب 4897 (صحيح)","تخريج مشكل الآثار 1363 (صحيح)","التمهيد 15/234 (صحيح)","صحيح مسلم 1301 (صحيح)","الأحاديث المختارة 13 / 81 (صحيح)","تخريج المسند لشعيب 17598 (صحيح)","تخريج المسند لشعيب 27202 (صحيح)"]},{"id":"س-03560","fp":"56ca672c38be","stateId":84,"easy":"إذا مسحت الركنين (في الطواف) ← يكونان كفارة للخطايا","cause":"إنَّ مَسْحَهُما","result":"كفَّارةٌ لِلخطايا","explicit":true,"ref":"صحيح الترمذي 959","srcLabel":"الترمذي","text":["أنَّ ابنَ عُمرَ كان يُزاحِمُ على الركنينِ زِحامًا ما رأيتُ أحدًا مِن أصحابِ النَّبيِّ صلَّى اللهُ علَيه وسلَّم يَفعلُه، فقلتُ: يا أبا عبد الرحمن، إنَّك تُزاحِمُ على الُّركنينِ زِحامًا ما رأيتُ أحدًا من أصحابِ النَّبيِّ صلَّى اللهُ علَيه وسلَّم يُزاحِمُ عليه؟! فقال: إنْ أفعلْ، فإنِّي سمعتُ رسولَ اللهِ صلَّى اللهُ علَيه وسلَّم يقولُ: ",["إنَّ مَسْحَهُما",1]," ",["كفَّارةٌ لِلخطايا",2]," وسَمِعْتُهُ يَقولُ مَنْ طافَ بِهذا البيتِ أُسْبُوعًا فأَحْصاهُ كان كَعِتْقِ رَقَبَةٍ وسَمِعْتُهُ يَقولُ لا يَضَعُ قَدَمًا ولا يَرْفَعُ أُخْرَى إِلَّا حَطَّ اللهُ عنْهُ خَطِيئَتَهُ وكُتِبَ له بِها حَسنةٌ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (959) مطولاً واللفظ له، والنسائي (2919) مطولاً باختلاف يسير، وأحمد (4462) بنحوه","bab":"استغفار › مكفرات الذنوب","dorar":"PxAvHfZU","merged":7,"otherRefs":["الزواجر عن اقتراف الكبائر 1/205 (صحيح)","صحيح النسائي 2919 (صحيح)","شرح السنة 4/77 (حسن)","تخريج المسند لشعيب 5701 (حسن)","الأحكام الوسطى 2/285 (صحيح)","صحيح ابن خزيمة 4/ 379 (صحيح)"]},{"id":"س-03334","fp":"582ce5dda953","stateId":84,"easy":"إذا حججت أو استغفر لك الحاج ← يُغفر لك","cause":"للحاجِّ ولمن استغفر لهم الحاجُّ","result":"يُغفرُ","explicit":true,"ref":"الترغيب والترهيب 2/169","srcLabel":"الطبراني","text":[["يُغفرُ",2]," ",["للحاجِّ ولمن استغفر لهم الحاجُّ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه البزار (9726) واللفظ له، وابن خزيمة (2516)، والطبراني في ((المعجم الأوسط)) (8594) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"dlDwX1qY","merged":2,"otherRefs":["مختصر المقاصد 1233 (حسن)"]},{"id":"س-07560","fp":"180183152c5c","stateId":84,"easy":"إذا استغفر لك الحاج ← تنالك دعوة النبي ﷺ بالمغفرة","cause":"ولِمَنِ استَغفَرَ له الحاجُّ","result":"اللَّهُمَّ اغفِرْ للحاجِّ","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"otherNeedIds":[29],"ref":"المستدرك على الصحيحين 1632","srcLabel":"مسلم","text":[["اللَّهُمَّ اغفِرْ للحاجِّ",2],"، ",["ولِمَنِ استَغفَرَ له الحاجُّ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه ابن خزيمة (2516)، والطبراني في ((الأوسط)) (8594)، والبيهقي في ((الشعب)) (3817) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › دعاء النبي لبعض الناس","dorar":"TX9OBBcv"},{"id":"س-08442","fp":"8c3daa8308dc","stateId":84,"easy":"إذا مسحت الركن اليماني والحجر الأسود ← يحطّان الخطايا حطّاً","cause":"إنَّ مسحَ الركنِ اليمانيِّ والرُّكنِ الأسوَدِ","result":"يحطُّ الخطايا حطًّا","explicit":true,"similar":["س-08440"],"ref":"التعليقات الرضية 90/2","srcLabel":"الترمذي","text":[["إنَّ مسحَ الركنِ اليمانيِّ والرُّكنِ الأسوَدِ ",1],["يحطُّ الخطايا حطًّا",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (959) بنحوه مطولاً، والنسائي (2919) مطولاً باختلاف يسير، وأحمد (5621) واللفظ له","bab":"مناقب وفضائل › مكة شرفها الله تعالى","dorar":"kTLR0kIY","merged":2,"otherRefs":["صحيح ابن حبان 3698 (صحيح)"]},{"id":"س-02290","fp":"8b7e738ac3c8","stateId":84,"easy":"إذا اعتمرت ثم اعتمرت ← تكفّر العمرة ما بينهما","cause":"والعمرةُ إلى العمرةِ","result":"تُكفِّرُ ما بينَهما","explicit":true,"repOf":"س-03257","ref":"أطراف الغرائب 2/375","text":["حديثُ: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: الحَجُّ المَبرورُ ليس له جَزاءٌ إلَّا الجَنَّةُ [",["والعمرةُ إلى العمرةِ",1]," ",["تُكفِّرُ ما بينَهما",2],"]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"قال ابن صاعد: غريب الإسناد وما سمعناه إلا من ابن عَبد الحكم يعني محمد بن عَبد الله بن عَبد الحكم عن إسحاق بن الفرات قاضي مصر عن يحيى بن أيوب عن يحيى بن سَعِيد، عَن سهيل عن سمي. قال الدارقطني: غريبٌ من حديث يحيى الأنصاري عن سهيل، تَفَرَّدَ بهِ يحيى بن أيوب عنه، وتَفَرَّدَ بهِ إسحاق بن الفرات عنه وهو محفوظ عن سهيل.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"LxcogkZg"},{"id":"س-02802","fp":"1f3b0f9fb2bd","stateId":84,"easy":"إذا حججت حجاً مبروراً ← تُكفّر خطايا تلك السنة","cause":"حَجٌّ مَبْرورٌ يُكَفِّرُ","result":"يُكَفِّرُ خطايا تلك السَّنَةِ","explicit":true,"ref":"تخريج المسند لشعيب 7511","srcLabel":"أحمد","text":["أَفْضَلُ الأَعْمالِ عِنْدَ اللهِ: إيمانٌ لا شَكَّ فيه، وغَزْوٌ لا غُلولَ فيه، وحَجٌّ مَبْرورٌ، وقال أَبو هُريرةَ: ",["حَجٌّ مَبْرورٌ ",1],["يُكَفِّرُ خطايا تلك السَّنَةِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (7511) واللفظ له، والدارمي (2739)، والطيالسي (2640)","bab":"إيمان › الوسوسة في الإيمان وما يقول من وجدها","dorar":"nzuWYJsm"},{"id":"س-02823","fp":"6d3a6be642ae","stateId":84,"easy":"إذا وقفت بعرفة ← يباهي الله بك الملائكة ويغفر لك","cause":"فإذا وقَف بعرَفةَ","result":"فإنَّ اللهَ عزَّ وجلَّ ينزِلُ إلى السَّماءِ الدُّنيا فيقولُ : انظُروا إلى عبادي شُعْثًا غُبْرًا اشهَدوا أنِّي قد غفَرْتُ لهم ذُنوبَهم وإنْ كان عدَدَ قَطْرِ السَّماءِ ورَمْلِ عالجٍ","explicit":true,"apply":{"k":"time","t":"يوم عرفة"},"ref":"شرح البخاري لابن الملقن 12/123","srcLabel":"ابن حبان","text":["حديثُ أنَّ لمن حلقَ رأسَهُ بكلِّ شعرةٍ سقطتْ من رأسِهِ نورًا يومَ القيامةِ [يعني حديث: جاء رجُلٌ مِن الأنصارِ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم فقال : يا رسولَ اللهِ كلماتٌ أسأَلُ عنهنَّ قال : ( اجلِسْ ) وجاء رجُلٌ مِن ثَقيفٍ فقال : يا رسولَ اللهِ كلماتٌ أسأَلُ عنهنَّ فقال صلَّى اللهُ عليه وسلَّم : ( سبَقكَ الأنصاريُّ ) فقال الأنصاريُّ : إنَّه رجُلٌ غريبٌ وإنَّ للغريبِ حقًّا فابدَأْ به فأقبَل على الثَّقَفيِّ فقال : ( إنْ شِئْتَ أجبَتْكُ عمَّا كُنْتَ تسأَلُ وإنْ شِئْتَ سأَلْتَني وأُخبِرُكَ ) فقال : يا رسولَ اللهِ بل أجِبْني عمَّا كُنْتُ أسأَلُكَ قال : ( جِئْتَ تسأَلُني عنِ الرُّكوعِ والسُّجودِ والصَّلاةِ والصَّومِ ) فقال : لا والَّذي بعَثك بالحقِّ ما أخطَأْتَ ممَّا كان في نفسي شيئًا قال : ( فإذا ركَعْتَ فضَعْ راحتَيْكَ على رُكبَتْيكَ ثمَّ فرِّجْ بَيْنَ أصابعِكَ ثمَّ امكُثْ حتَّى يأخُذَ كلُّ عضوٍ مأخَذَه وإذا سجَدْتَ فمَكِّنْ جبهتَكَ ولا تنقُرْ نَقْرًا وصَلِّ أوَّلَ النَّهارِ وآخِرَه ) فقال : يا نَبيَّ اللهِ فإنْ أنا صلَّيْتُ بَيْنَهما ؟ قال : ( فأنتَ إذًا مُصلِّي وصُمْ مِن كلِّ شهرٍ ثلاثَ عَشْرةَ وأربعَ عَشْرةَ وخمسَ عَشْرةَ ) فقام الثَّقفيُّ ثمَّ أقبَل على الأنصاريِّ فقال : ( إنْ شِئْتَ أخبَرْتُكَ عمَّا جِئْتَ تسأَلُ وإنْ شِئْتَ سأَلْتَني فأُخبِرُكَ ) فقال : لا يا نَبيَّ اللهِ أخبِرْني عمَّا جِئْتُ أسأَلُكَ قال : ( جِئْتَ تسأَلُني عنِ الحاجِّ ما له حينَ يخرُجُ مِن بيتِه وما له حينَ يقومُ بعرَفاتٍ وما له حينَ يرمي الجِمارَ وما له حينَ يحلِقُ رأسَه وما له حينَ يقضي آخِرَ طوافٍ بالبيتِ ) فقال : يا نَبيَّ اللهِ والَّذي بعَثك بالحقِّ ما أخطَأْتَ ممَّا كان في نفسي شيئًا قال : ( فإنَّ له حينَ يخرُجُ مِن بيتِه أنَّ راحلتَه لا تخطو خُطوةً إلَّا كُتِب له بها حَسنةٌ أو حُطَّت عنه بها خطيئةٌ ",["فإذا وقَف بعرَفةَ",1]," ",["فإنَّ اللهَ عزَّ وجلَّ ينزِلُ إلى السَّماءِ الدُّنيا فيقولُ : انظُروا إلى عبادي شُعْثًا غُبْرًا اشهَدوا أنِّي قد غفَرْتُ لهم ذُنوبَهم وإنْ كان عدَدَ قَطْرِ السَّماءِ ورَمْلِ عالجٍ",2]," وإذا رمى الجِمارَ لا يدري أحَدٌ ما له حتَّى يُوفَّاه يومَ القيامةِ وإذا حلَق رأسَه فله بكلِّ شَعرةٍ سقَطَتْ مِن رأسِه نورٌ يومَ القيامةِ وإذا قضى آخِرَ طوافِه بالبيتِ خرَج مِن ذنوبِه كيومَ ولَدَتْه أُمُّه )]"],"grade":"صحيح","narrator":"[عبدالله بن عمر]","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (1887) بلفظه تامًا، وعبد الرزاق (8830)، والبيهقي في ((الدلائل)) (6/ 293) بنحوه تامًا.","bab":"إيمان › الوعد","dorar":"gtGMMaGB"},{"id":"س-03250","fp":"22778c068ffe","stateId":84,"easy":"إذا وقفت بعرفة ← تُغفر ذنوبك ولو كانت بعدد الرمل أو قطر المطر","cause":"والوقوفَ","result":"تُغفَرُ بهِ الذُّنوبُ ، وإن كانت بعدَدِ الرَّملِ أو كقَطرِ المطرِ ، أو كزَبَدِ البحرِ","explicit":true,"apply":{"k":"time","t":"يوم عرفة"},"ref":"الزواجر عن اقتراف الكبائر 1/205","srcLabel":"الزواجر عن اقتراف الكبائر","text":["إنَّ مَن أمَّ البَيتَ لا تضعُ ناقتُهُ خُفًّا ولا ترفعُهُ إلَّا كُتِبَ لَه بهِ حسنةٌ ومُحِيَ عنهُ خَطيئةٌ ، وإنَّ ركعتَي الطَّوافِ كَعِتقِ رقبةٍ مِن بَني إسماعيلَ والسَّعيَ كَعِتقِ سبعينَ رقبةً ، ",["والوقوفَ",1]," ",["تُغفَرُ بهِ الذُّنوبُ ، وإن كانت بعدَدِ الرَّملِ أو كقَطرِ المطرِ ، أو كزَبَدِ البحرِ",2]," ، وبكلِّ حصاةٍ مِن الجِمارِ تكفيرُ كبيرةٍ مِن الموبِقاتِ والنَّحرَ مَذخورٌ عندَ اللهِ ، وبكلِّ شعرةٍ حُلِقَت حسنةٌ ومَحوُ خَطيئةٍ ، وبالطَّوافِ بعدَ ذلكَ يضعُ مَلكٌ يدَيهِ بينَ كتفَيهِ فَيقولُ : اعمَل فيما استُقبِلَ ، فقَد غُفِرَ لكَ ما مضَى"],"grade":"صحيح","muhaddith":"صحيح أو حسن","bab":"استغفار › أسباب المغفرة","dorar":"JXahJfeA"},{"id":"س-03269","fp":"5539c2dfec57","stateId":84,"easy":"إذا استلمت الركنين في الطواف ← يحطّان عنك الذنوب","cause":"أن استلامَ الركنين","result":"يحطانِ الذنوبَ","explicit":true,"ref":"تخريج المسند لشاكر 6/267","srcLabel":"الترمذي","text":[["أن استلامَ الركنين ",1],["يحطانِ الذنوبَ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه مطولاً الترمذي (959) بنحوه، والفاكهي في ((أخبار مكة)) (122) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"z5tk38Rh"},{"id":"س-03277","fp":"abd1357a1cd7","stateId":84,"easy":"إذا طفت بالبيت خمسين مرة ← تخرج من ذنوبك كيوم ولدتك أمك","cause":"من طاف بالبيتِ خمسين مرَّةً","result":"خرج من ذنوبِه كيومِ ولدته أمُّه","explicit":true,"apply":{"k":"count","t":"خمسين مرة"},"ref":"الترغيب والترهيب 2/186","srcLabel":"الترمذي","text":[["من طاف بالبيتِ خمسين مرَّةً ",1],["خرج من ذنوبِه كيومِ ولدته أمُّه",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (866)، والمخلص في ((المخلصيات)) (1216)، وابن الجوزي في ((العلل المتناهية)) (942)","bab":"استغفار › أسباب المغفرة","dorar":"EPzsz4q9"},{"id":"س-03303","fp":"a25f2d6594ec","stateId":84,"easy":"إذا أحرمت بالعمرة من بيت المقدس ← يُغفر لك","cause":"من أهلَّ بعمرةٍ من بيتِ المقدسِ","result":"غُفر له","explicit":true,"ref":"الترغيب والترهيب 2/184","srcLabel":"أبو داود","text":[["من أهلَّ بعمرةٍ من بيتِ المقدسِ ",1],["غُفر له",2]],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1741)، وأحمد (26558) بمعناه مطولاً، وابن ماجه (3001) واللفظ له","bab":"استغفار › أسباب المغفرة","dorar":"yyrlANSq"},{"id":"س-03326","fp":"93909a03c272","stateId":84,"easy":"إذا أحرمت بحج أو عمرة من المسجد الأقصى ← يُغفر لك ما تقدّم من ذنبك وما تأخر","cause":"مَن أَهَلَّ بحَجَّةٍ أو عُمْرةٍ مِن المَسجِدِ الأَقْصى إلى المَسجِدِ الحَرامِ","result":"غُفِرَ له ما تَقدَّمَ مِن ذَنْبِه وما تَأخَّرَ\"، أو \"وَجَبَتْ له الجَنَّةُ","explicit":true,"similar":["س-08405"],"otherNeedIds":[67],"ref":"تحفة المحتاج 2/142","srcLabel":"أبو داود","text":[["مَن أَهَلَّ بحَجَّةٍ أو عُمْرةٍ مِن المَسجِدِ الأَقْصى إلى المَسجِدِ الحَرامِ ",1],["غُفِرَ له ما تَقدَّمَ مِن ذَنْبِه وما تَأخَّرَ\"، أو \"وَجَبَتْ له الجَنَّةُ\"",2],"."],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"صحيح أو حسن [كما اشترط على نفسه في المقدمة]","takhrij":"أخرجه أبو داود (1741) بلفظه، وأحمد (26558) بلفظ مقارب، وابن ماجه (3002) بنحوه دون ذكر الحج.","bab":"استغفار › أسباب المغفرة","dorar":"fPpqGRnu"},{"id":"س-03327","fp":"21d901668098","stateId":84,"easy":"إذا لبّيت في إحرامك حتى غروب الشمس ← تغيب الشمس بذنوبك فتعود كيوم ولدتك أمك","cause":"ما أضحى مؤمنٌ يلبي حتى تغرُبَ الشمسُ","result":"إلا غابت بذنوبِه حتى يعودَ كما ولَدَتْه أمُّه","explicit":true,"similar":["س-03496"],"ref":"تحفة المحتاج 2/153","srcLabel":"البيهقي","text":[["ما أضحى مؤمنٌ يلبي حتى تغرُبَ الشمسُ",1]," ",["إلا غابت بذنوبِه حتى يعودَ كما ولَدَتْه أمُّه",2]],"grade":"صحيح","narrator":"عامر بن ربيعة","muhaddith":"صحيح أو حسن [كما اشترط على نفسه في المقدمة]","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (6/ 393)، والبيهقي (9093)، والخطيب البغدادي في ((موضح أوهام الجمع والتفريق)) (1/ 158) واللفظ لهم جميعا.","bab":"استغفار › أسباب المغفرة","dorar":"M7o3inIg"},{"id":"س-03369","fp":"fa7f063cea59","stateId":84,"easy":"إذا وقفت عشية عرفة مستقبل القبلة تقول «لا إله إلا الله وحده...» ← يشهد الله ملائكته أنه غفر لك","cause":"ما من مسلمٍ يقِفُ عشيَّةَ عرفةَ بالموْقفِ فيستقبِلُ القِبلةَ بوجهِه ثمَّ يقولُ لا إلهَ إلَّا اللهُ وحدَه لا شريكَ له له الملكُ وله الحمدُ يُحيي ويُميتُ وهو على كلِّ شيءٍ قديرٌ مائةَ مرَّةٍ ثمَّ يقرأُ {قُلْ هُوَ اللهُ أَحَدٌ} مائةَ مرَّةٍ ثمَّ يقولُ اللَّهمَّ صلِّ على محمَّدٍ وعلى آلِ محمَّدٍ كما صلَّيتَ على إبراهيمَ وعلى آلِ إبراهيمَ إنَّك حميدٌ مجيدٌ وعلينا معهم مائةَ مرَّةٍ","result":"إلَّا قال اللهُ تعالّى يا ملائكتي ما جزاءُ عبدي هذا سبَّحني وهلَّلني وكبَّرني وعظَّمني وعرَفني وأثنَى عليَّ وصلَّى على نبيِّي اشهَدوا ملائكتي أنِّي قد غفرتُ له وشفَّعتُه في نفسِه ولو سألني عبدي هذا لشفَّعتُه في أهلِ الموقفِ","explicit":true,"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ وحدَه لا شريكَ له له الملكُ وله الحمدُ يُحيي ويُميتُ وهو على كلِّ شيءٍ قدير» · الوقت: يوم عرفة"},"otherNeedIds":[65],"ref":"الترغيب والترهيب 2/197","srcLabel":"البيهقي","text":[["ما من مسلمٍ يقِفُ عشيَّةَ عرفةَ بالموْقفِ فيستقبِلُ القِبلةَ بوجهِه ثمَّ يقولُ لا إلهَ إلَّا اللهُ وحدَه لا شريكَ له له الملكُ وله الحمدُ يُحيي ويُميتُ وهو على كلِّ شيءٍ قديرٌ مائةَ مرَّةٍ ثمَّ يقرأُ {قُلْ هُوَ اللهُ أَحَدٌ} مائةَ مرَّةٍ ثمَّ يقولُ اللَّهمَّ صلِّ على محمَّدٍ وعلى آلِ محمَّدٍ كما صلَّيتَ على إبراهيمَ وعلى آلِ إبراهيمَ إنَّك حميدٌ مجيدٌ وعلينا معهم مائةَ مرَّةٍ",1]," ",["إلَّا قال اللهُ تعالّى يا ملائكتي ما جزاءُ عبدي هذا سبَّحني وهلَّلني وكبَّرني وعظَّمني وعرَفني وأثنَى عليَّ وصلَّى على نبيِّي اشهَدوا ملائكتي أنِّي قد غفرتُ له وشفَّعتُه في نفسِه ولو سألني عبدي هذا لشفَّعتُه في أهلِ الموقفِ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (4074)","bab":"استغفار › أسباب المغفرة","dorar":"ZnKbDkQh"},{"id":"س-03478","fp":"1c8d80e23e04","stateId":84,"easy":"إذا دخلت الكعبة ← تدخل في حسنة وتخرج من سيئة مغفوراً لك","cause":"مَن دخلَ البَيتَ","result":"دخلَ في حسنةٍ وخرجَ مِن سيِّئةٍ مَغفورًا لَهُ","explicit":true,"ref":"صحيح ابن خزيمة 4/ 561","srcLabel":"الطبراني","text":[["مَن دخلَ البَيتَ",1]," ",["دخلَ في حسنةٍ وخرجَ مِن سيِّئةٍ مَغفورًا لَهُ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البزار (5205)، والطبراني (11490) (11/ 200)، وتمام (1283) بلفظه","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"bl4sGlkJ"},{"id":"س-08405","fp":"7a7e9fabf6fc","stateId":84,"easy":"إذا أحرمت بعمرة من المسجد الأقصى ← يُغفر لك ما تقدّم من ذنبك","cause":"مَن أهلَّ مِن المسجدِ الأقصى بعمرةٍ","result":"غُفِر له ما تقدَّم مِن ذنبِه","explicit":true,"repOf":"س-03326","otherNeedIds":[67],"ref":"صحيح ابن حبان 3701","text":["( ",["مَن أهلَّ مِن المسجدِ الأقصى بعمرةٍ ",1],["غُفِر له ما تقدَّم مِن ذنبِه )",2]," قال: فركِبَت أمُّ حكيمٍ إلى بيتِ المقدسِ حتَّى أهلَّت منه بعمرةٍ"],"grade":"صحيح","narrator":"أم سلمة","muhaddith":"أخرجه في صحيحه","bab":"مناقب وفضائل › فضائل أماكن متعددة من الأرض وما ورد ذمه","dorar":"OAfxxLlc"},{"id":"س-03342","fp":"41b68d0db77d","stateId":84,"easy":"إذا وقفت بعرفة ← يهب الله مسيئكم لمحسنكم","cause":"في جَمعِكم هذا","result":"فوَهبَ مسيئَكم لِمحسنِكم وأعطى محسنَكُم ما سألَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"time","t":"يوم عرفة"},"otherNeedIds":[29],"ref":"صحيح ابن ماجه 2468","srcLabel":"ابن ماجه","text":["يا بلالُ أسكِتِ النَّاسَ أو أنصتِ النَّاس ثمَّ قالَ إنَّ اللَّهَ تطوَّلَ عليْكم ",["في جَمعِكم هذا",1]," ",["فوَهبَ مسيئَكم لِمحسنِكم وأعطى محسنَكُم ما سألَ",2]," ادفعوا باسمِ اللَّهِ"],"grade":"صحيح","narrator":"بلال بن رباح","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (3024) واللفظ له، وتمام في ((الفوائد)) (331)، وابن عساكر في ((تاريخ دمشق)) (44/118)","bab":"استغفار › أسباب المغفرة","dorar":"o3iWMWVJ","merged":2,"otherRefs":["صحيح الجامع 1734 (صحيح)"]},{"id":"س-03496","fp":"6292a9a76525","stateId":84,"easy":"إذا ظللت ملبياً حتى تغيب الشمس ← تغيب بذنوبك فتعود كيوم ولدتك أمك","cause":"ما ضحى مؤمنٌ ملبيًا حتى تغيبَ الشمسُ","result":"إلا غابتْ بذنوبِهِ، فيعودُ كمَا ولدتْهُ أمُّهُ","explicit":true,"repOf":"س-03327","ref":"الجامع الصغير 7912","text":[["ما ضحى مؤمنٌ ملبيًا حتى تغيبَ الشمسُ،",1],"  ",["إلا غابتْ بذنوبِهِ،  فيعودُ كمَا ولدتْهُ أمُّهُ",2]],"grade":"حسن","narrator":"عامر بن ربيعة","muhaddith":"حسن","takhrij":"أخرجه الضياء المقدسي في ((الأحاديث المختارة)) (8/202) بلفظه، البيهقي(9093)، وابن عدي (5/227) بإختلاف يسير","bab":"استغفار › مكفرات الذنوب","dorar":"t1QxndoW"},{"id":"س-04575","fp":"f0a2d711bb27","stateId":84,"easy":"إذا وقفت بعرفة ومزدلفة ← يغفر الله لك ويضمن عنك التبعات","cause":"لِأهلِ عَرَفاتٍ، وأهلِ المَشعَرِ","result":"إنَّ اللهَ غَفَرَ لِأهلِ عَرَفاتٍ، وأهلِ المَشعَرِ، وضَمِنَ عنهمُ التَّبِعاتِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"time","t":"يوم عرفة"},"similar":["س-03381"],"ref":"تخريج شرح السنة 7/ 160","srcLabel":"ابن عبد","text":["وَقَفَ النَّبيُّ صَلَّي اللهُ عليه وسَلَّمَ بعَرَفاتٍ وكادَتِ الشَّمسُ أنْ تَؤوبَ، فقال: يا بِلالُ أنصِتْ ليَ الناسَ. فقامَ بِلالٌ، فقال: أنصِتوا لِرَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ. فأنصَتَ الناسُ، فقال: مَعاشِرَ الناسِ، أتاني جِبرائيلُ آنِفًا، فأقرَأني مِن رَبِّي السَّلامَ، وقال: ",["إنَّ اللهَ غَفَرَ لِأهلِ عَرَفاتٍ، وأهلِ المَشعَرِ، وضَمِنَ عنهمُ التَّبِعاتِ",2],". فقامَ عُمَرُ بنُ الخَطَّابِ، فقال: يا رَسولَ اللهِ، هذا لنا خاصَّةً؟ قال: هذا لكم ولِمَن أتى مِن بَعدِكم إلى يَومِ القيامةِ. فقال عُمَرُ بنُ الخَطَّابِ: كَثُرَ خَيرُ اللهِ وطابَ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن عبد البر في ((التمهيد)) (1 / 128) واللفظ له.","bab":"حج › الوقوف بعرفة وأحكامه","dorar":"RtIp1f6q"},{"id":"س-03381","fp":"ee1f0898c90f","stateId":84,"easy":"إذا وقفت بعرفة ← يغفر الله لك إلا التبعات بينك وبين الناس","cause":"في هذا اليومِ","result":"فغفرَ لكم إلا التَّبِعَاتِ فيما بينكم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"time","t":"يوم عرفة"},"repOf":"س-04575","ref":"القول المسدد 1/47","text":["أيُّها الناسُ ! إنَّ اللهَ عزَّ وجلَّ قدْ تَطَوَّلَ عليكم ",["في هذا اليومِ",1]," ",["فغفرَ لكم إلا التَّبِعَاتِ فيما بينكم",2]," ، ووهبَ مسيئَكم لمحسنِكم ، وأعطى محسنَكم ما سألَ ، فادفعوا باسمِ اللهِ ! فلما كانَ بجمعٍ قالَ : إنَّ اللهَ قدْ غفرَ لصالحِيكم وشفَّعَ صالحِيكم في طالحِيكم ، يُنْزِلُ المغفرةَ فيُعَمِّمُها . ثمَّ يُفَرِّقُ المغفرةَ في الأرضِ ، فتَقَعُ على كلِّ تائبٍ ممنْ حَفِظَ لسانَه ويدَه وإبليسُ وجنودُه على جبلِ عرفاتٍ ينظرونَ ما يصنعُ اللهُ بهم ، فإذا نزلتِ المغفرةُ دعا هوَ وجنودُه بالوَيْلِ يقولُ : كيفَ اسْتَفَزُّهم حِقَبًا منَ الدهرِ ! ثمَّ جاءتْ المغفرةُ فعمَّتْهم، يتفرَّقون وهمْ يدعونَ بالوَيْلِ والثُّبُورِ"],"grade":"حسن","narrator":"عبادة بن الصامت","muhaddith":"رجاله ثقات أثبات معروفون إلا الواسطة الذي بين معمر وقتادة","takhrij":"أخرجه عبد الرزاق (8831)، والطبراني كما في ((مجمع الزوائد)) للهيثمي (5568)، وابن الجوزي في ((الموضوعات)) (2/ 215) واللفظ لهم.","bab":"استغفار › أسباب المغفرة","dorar":"Ed4aN8aK"},{"id":"س-02826","fp":"35a74bad6386","stateId":84,"easy":"إذا طفت طواف الوداع ← تخرج من ذنوبك كيوم ولدتك أمك","cause":"وإذا قضى آخِرَ طوافِه بالبيتِ","result":"خرَج مِن ذنوبِه كيومَ ولَدَتْه أُمُّه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"شرح البخاري لابن الملقن 12/123","srcLabel":"ابن حبان","text":["حديثُ أنَّ لمن حلقَ رأسَهُ بكلِّ شعرةٍ سقطتْ من رأسِهِ نورًا يومَ القيامةِ [يعني حديث: جاء رجُلٌ مِن الأنصارِ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم فقال : يا رسولَ اللهِ كلماتٌ أسأَلُ عنهنَّ قال : ( اجلِسْ ) وجاء رجُلٌ مِن ثَقيفٍ فقال : يا رسولَ اللهِ كلماتٌ أسأَلُ عنهنَّ فقال صلَّى اللهُ عليه وسلَّم : ( سبَقكَ الأنصاريُّ ) فقال الأنصاريُّ : إنَّه رجُلٌ غريبٌ وإنَّ للغريبِ حقًّا فابدَأْ به فأقبَل على الثَّقَفيِّ فقال : ( إنْ شِئْتَ أجبَتْكُ عمَّا كُنْتَ تسأَلُ وإنْ شِئْتَ سأَلْتَني وأُخبِرُكَ ) فقال : يا رسولَ اللهِ بل أجِبْني عمَّا كُنْتُ أسأَلُكَ قال : ( جِئْتَ تسأَلُني عنِ الرُّكوعِ والسُّجودِ والصَّلاةِ والصَّومِ ) فقال : لا والَّذي بعَثك بالحقِّ ما أخطَأْتَ ممَّا كان في نفسي شيئًا قال : ( فإذا ركَعْتَ فضَعْ راحتَيْكَ على رُكبَتْيكَ ثمَّ فرِّجْ بَيْنَ أصابعِكَ ثمَّ امكُثْ حتَّى يأخُذَ كلُّ عضوٍ مأخَذَه وإذا سجَدْتَ فمَكِّنْ جبهتَكَ ولا تنقُرْ نَقْرًا وصَلِّ أوَّلَ النَّهارِ وآخِرَه ) فقال : يا نَبيَّ اللهِ فإنْ أنا صلَّيْتُ بَيْنَهما ؟ قال : ( فأنتَ إذًا مُصلِّي وصُمْ مِن كلِّ شهرٍ ثلاثَ عَشْرةَ وأربعَ عَشْرةَ وخمسَ عَشْرةَ ) فقام الثَّقفيُّ ثمَّ أقبَل على الأنصاريِّ فقال : ( إنْ شِئْتَ أخبَرْتُكَ عمَّا جِئْتَ تسأَلُ وإنْ شِئْتَ سأَلْتَني فأُخبِرُكَ ) فقال : لا يا نَبيَّ اللهِ أخبِرْني عمَّا جِئْتُ أسأَلُكَ قال : ( جِئْتَ تسأَلُني عنِ الحاجِّ ما له حينَ يخرُجُ مِن بيتِه وما له حينَ يقومُ بعرَفاتٍ وما له حينَ يرمي الجِمارَ وما له حينَ يحلِقُ رأسَه وما له حينَ يقضي آخِرَ طوافٍ بالبيتِ ) فقال : يا نَبيَّ اللهِ والَّذي بعَثك بالحقِّ ما أخطَأْتَ ممَّا كان في نفسي شيئًا قال : ( فإنَّ له حينَ يخرُجُ مِن بيتِه أنَّ راحلتَه لا تخطو خُطوةً إلَّا كُتِب له بها حَسنةٌ أو حُطَّت عنه بها خطيئةٌ فإذا وقَف بعرَفةَ فإنَّ اللهَ عزَّ وجلَّ ينزِلُ إلى السَّماءِ الدُّنيا فيقولُ : انظُروا إلى عبادي شُعْثًا غُبْرًا اشهَدوا أنِّي قد غفَرْتُ لهم ذُنوبَهم وإنْ كان عدَدَ قَطْرِ السَّماءِ ورَمْلِ عالجٍ وإذا رمى الجِمارَ لا يدري أحَدٌ ما له حتَّى يُوفَّاه يومَ القيامةِ وإذا حلَق رأسَه فله بكلِّ شَعرةٍ سقَطَتْ مِن رأسِه نورٌ يومَ القيامةِ ",["وإذا قضى آخِرَ طوافِه بالبيتِ",1]," ",["خرَج مِن ذنوبِه كيومَ ولَدَتْه أُمُّه",2]," )]"],"grade":"صحيح","narrator":"[عبدالله بن عمر]","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (1887) بلفظه تامًا، وعبد الرزاق (8830)، والبيهقي في ((الدلائل)) (6/ 293) بنحوه تامًا.","bab":"إيمان › الوعد","dorar":"gtGMMaGB"},{"id":"س-08440","fp":"69eb70d69eb8","stateId":84,"easy":"إذا مسحت الحجر الأسود والركن اليماني ← يحطّان خطاياك حطاً","cause":"مسحَ الحجرِ الأسودِ، و الركنَ اليمانيِّ","result":"يَحُطَّا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-08442","ref":"الجامع الصغير 2432","text":["إنَّ ",["مسحَ الحجرِ الأسودِ،  و الركنَ اليمانيِّ",1],"،  ",["يَحُطَّا",2],"نِ الخطايا حطًّا"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (959) بنحوه مطولاً، والنسائي (2919) مطولاً باختلاف يسير، والطبراني (12/389) (13438) واللفظ له","bab":"مناقب وفضائل › مكة شرفها الله تعالى","dorar":"FTvfhmsv"},{"id":"س-04449","fp":"02610a55110c","stateId":85,"easy":"إذا خرجت مجاهداً في سبيل الله ابتغاء مرضاته ← إن رجعت غفر لك ورحمك، وإن قُبضت أدخلك الجنة","cause":"أيُّما عَبْدٍ مِن عِبادي خَرَجَ مُجاهِدًا في سَبيلي وابْتِغاءَ مَرْضاتي، إن رَجَعْتُه رَجَعْتُه بما نالَ مِن أَجْرٍ وغَنيمةٍ، وإن قَبَضْتُه","result":"غَفَرْتُ له ورَحِمْتُه وأَدخَلْتُه الجنَّةَ","explicit":true,"star":true,"otherNeedIds":[67],"ref":"الأحاديث المختارة 13 / 167","srcLabel":"متفق عليه","text":["عن النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فيما يَحْكي عن رَبِّه عَزَّ وجَلَّ، قالَ: «",["أيُّما عَبْدٍ مِن عِبادي خَرَجَ مُجاهِدًا في سَبيلي وابْتِغاءَ مَرْضاتي، إن رَجَعْتُه رَجَعْتُه بما نالَ مِن أَجْرٍ وغَنيمةٍ، وإن قَبَضْتُه ",1],["غَفَرْتُ له ورَحِمْتُه وأَدخَلْتُه الجنَّةَ»",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"جهاد › فضل الجهاد","dorar":"4Q3rMjyJ"},{"id":"س-04507","fp":"f045cd2f8a82","stateId":85,"easy":"إذا قُتلت في سبيل الله ← يكفّر كل شيء إلا الدَّين","cause":"القَتلُ في سَبيلِ اللهِ","result":"يُكَفِّرُ كُلَّ شيءٍ إلَّا الدَّينَ","explicit":true,"star":true,"similar":["س-03329","س-02669","س-04521","س-02113"],"ref":"صحيح مسلم 1886","srcLabel":"متفق عليه","text":[["القَتلُ في سَبيلِ اللهِ ",1],["يُكَفِّرُ كُلَّ شيءٍ إلَّا الدَّينَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"جهاد › فضل الشهيد","dorar":"HQSLZ5iw"},{"id":"س-03329","fp":"2aa86c656b33","stateId":85,"easy":"إذا قُتلت في سبيل الله صابراً محتسباً مقبلاً ← تُكفّر خطاياك إلا الدين","cause":"إن قُتِلتَ في سَبيلِ اللهِ، وأنتَ صابِرٌ مُحتَسِبٌ، مُقبِلٌ غَيرُ مُدبِرٍ","result":"تُكَفَّرُ عَنِّي خَطايايَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04507","ref":"صحيح مسلم 1885","text":["أنَّه قامَ فيهم، فذَكَرَ لهم أنَّ الجِهادَ في سَبيلِ اللهِ والإيمانَ باللهِ أفضَلُ الأعمالِ، فقامَ رَجُلٌ، فقال: يا رَسولَ اللهِ، أرَأيتَ إن قُتِلتُ في سَبيلِ اللهِ، تُكَفَّرُ عَنِّي خَطايايَ؟ فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: نَعَم، ",["إن قُتِلتَ في سَبيلِ اللهِ، وأنتَ صابِرٌ مُحتَسِبٌ، مُقبِلٌ غَيرُ مُدبِرٍ",1],"، ثُمَّ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: كيفَ قُلتَ؟ قال: أرَأيتَ إن قُتِلتُ في سَبيلِ اللهِ، أ",["تُكَفَّرُ عَنِّي خَطايايَ",2],"؟ فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: نَعَم، وأنتَ صابِرٌ مُحتَسِبٌ، مُقبِلٌ غَيرُ مُدبِرٍ، إلَّا الدَّينَ؛ فإنَّ جِبريلَ عليه السَّلامُ قال لي ذلك. وفي روايةٍ: جاءَ رَجُلٌ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: أرَأيتَ إن قُتِلتُ في سَبيلِ اللهِ..."],"grade":"صحيح","narrator":"أبو قتادة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"استغفار › أسباب المغفرة","dorar":"oP4o6Lbl","merged":3,"otherRefs":["تخريج المسند لشعيب 22542 (صحيح)","تخريج صحيح ابن حبان 4654 (صحيح)"]},{"id":"ق-0177","fp":"7503d67fa6a0","stateId":85,"easy":"القتل أو الموت في سبيل الله ← مغفرة من الله ورحمة خير مما يجمعون","cause":"القتل أو الموت في سبيل الله","result":"مغفرة من الله ورحمة خير مما يجمعون","explicit":true,"star":true,"otherNeedIds":[24],"ref":"سورة آل عمران: 157","srcLabel":"القرآن الكريم","quran":{"s":3,"from":157,"to":157,"text":"وَلَئِنْ قُتِلْتُمْ فِي سَبِيلِ اللَّهِ أَوْ مُتُّمْ لَمَغْفِرَةٌ مِنَ اللَّهِ وَرَحْمَةٌ خَيْرٌ مِمَّا يَجْمَعُونَ (157)","hl":[[0,53,1],[53,115,2]]}},{"id":"ق-0199","fp":"fa4c982689cc","stateId":85,"easy":"الهجرة وتحمّل الأذى في سبيل الله والقتال ← تكفير السيئات ودخول الجنات","cause":"الهجرة وتحمّل الأذى في سبيل الله والقتال","result":"تكفير السيئات ودخول الجنات","explicit":true,"star":true,"otherNeedIds":[67],"ref":"سورة آل عمران: 195","srcLabel":"القرآن الكريم","quran":{"s":3,"from":195,"to":195,"text":"فَاسْتَجَابَ لَهُمْ رَبُّهُمْ أَنِّي لَا أُضِيعُ عَمَلَ عَامِلٍ مِنْكُمْ مِنْ ذَكَرٍ أَوْ أُنْثَى بَعْضُكُمْ مِنْ بَعْضٍ فَالَّذِينَ هَاجَرُوا وَأُخْرِجُوا مِنْ دِيَارِهِمْ وَأُوذُوا فِي سَبِيلِي وَقَاتَلُوا وَقُتِلُوا لَأُكَفِّرَنَّ عَنْهُمْ سَيِّئَاتِهِمْ وَلَأُدْخِلَنَّهُمْ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ ثَوَابًا مِنْ عِنْدِ اللَّهِ وَاللَّهُ عِنْدَهُ حُسْنُ الثَّوَابِ (195)","hl":[[121,219,1],[219,388,2]]}},{"id":"ق-0480","fp":"47f98da22437","stateId":85,"easy":"الإيمان والهجرة والجهاد والإيواء والنصرة ← الإيمان الحق ومغفرة ورزق كريم","cause":"الإيمان والهجرة والجهاد والإيواء والنصرة","result":"الإيمان الحق ومغفرة ورزق كريم","explicit":true,"otherNeedIds":[1,17],"ref":"سورة الأنفال: 74","srcLabel":"القرآن الكريم","quran":{"s":8,"from":74,"to":74,"text":"وَالَّذِينَ آمَنُوا وَهَاجَرُوا وَجَاهَدُوا فِي سَبِيلِ اللَّهِ وَالَّذِينَ آوَوْا وَنَصَرُوا أُولَئِكَ هُمُ الْمُؤْمِنُونَ حَقًّا لَهُمْ مَغْفِرَةٌ وَرِزْقٌ كَرِيمٌ (74)","hl":[[0,94,1],[94,165,2]]}},{"id":"ق-0684","fp":"fa64e1a3fb0d","stateId":85,"easy":"الهجرة بعد الفتنة والجهاد والصبر ← مغفرة الله ورحمته","cause":"الهجرة بعد الفتنة والجهاد والصبر","result":"مغفرة الله ورحمته","explicit":true,"otherNeedIds":[24],"ref":"سورة النحل: 110","srcLabel":"القرآن الكريم","quran":{"s":16,"from":110,"to":110,"text":"ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ هَاجَرُوا مِنْ بَعْدِ مَا فُتِنُوا ثُمَّ جَاهَدُوا وَصَبَرُوا إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ (110)","hl":[[20,93,1],[93,139,2]]}},{"id":"س-03374","fp":"1abe7106394e","stateId":85,"easy":"إذا استُشهدت ← يُغفر لك ذنبك كله إلا الدَّين","cause":"أولُ ما يُهْرَاقُ دمُ الشهيدِ","result":"يغفرُ له ذنبُهُ كلُّهُ إلَّا الدينَ","explicit":true,"similar":["س-03914"],"otherNeedIds":[62],"ref":"مجمع الزوائد 4/131","srcLabel":"الحاكم","text":[["أولُ ما يُهْرَاقُ دمُ الشهيدِ",1]," ",["يغفرُ له ذنبُهُ كلُّهُ إلَّا الدينَ",2]],"grade":"صحيح","narrator":"سهل بن حنيف","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني (6/73) (5552)، والحاكم (2555)، والبيهقي (18992) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"IbvVc4sE","merged":3,"otherRefs":["صحيح مسلم 1886 (صحيح)","فتح الباري لابن حجر 10/204 (صحيح)"]},{"id":"س-02669","fp":"24835e178e0b","stateId":85,"easy":"إذا قاتلت في سبيل الله صابراً محتسباً ← تُكفّر خطاياك إلا الدين","cause":"ضرَبْتُ بسيفي هذا في سبيلِ اللهِ صابرًا مُحتَسِبًا مُقبِلًا غيْرَ مُدبِرٍ","result":"أتُكَفَّرُ عنِّي خطايايَ؟ فقال: نَعمْ، فلمَّا أدبَرَ قال: تعالَ، هذا جِبريلُ يقولُ: إلَّا أنْ يكونَ عليكَ دَيْنٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04507","ref":"تخريج مشكل الآثار 83","text":["أنَّ رجُلًا أتى النَّبيَّ عليه السَّلامُ فقال: يا رسولَ اللهِ، أرأيْتَ إنْ ",["ضرَبْتُ بسيفي هذا في سبيلِ اللهِ صابرًا مُحتَسِبًا مُقبِلًا غيْرَ مُدبِرٍ",1]," ",["أتُكَفَّرُ عنِّي خطايايَ؟ فقال: نَعمْ، فلمَّا أدبَرَ قال: تعالَ، هذا جِبريلُ يقولُ: إلَّا أنْ يكونَ عليكَ دَيْنٌ",2],"."],"grade":"صحيح","narrator":"أبو قتادة الحارث بن ربعي","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (3158)، والطحاوي في ((شرح مشكل الآثار)) (1/ 80) و والبيهقي في ((معرفة السنن والآثار)) (17653) بلفظه، ومسلم (1885)، والترمذي (1712) بنحوه.","bab":"إيمان › الاحتساب والنية","dorar":"ic5lOjFh"},{"id":"س-06545","fp":"bca53d5d1ad3","stateId":85,"easy":"إذا شهدت (بدراً أو المشهد الفاضل) ← فأنت مغفور لك","cause":"شَهِدَها مِنكم","result":"إلَّا مَغْفورٌ له","explicit":true,"ref":"الأحكام الوسطى 2/ 114","srcLabel":"الطبراني","text":["إنَّ أَفضَلَ الصَّلَواتِ صَلاةُ الصُّبْحِ يَوْمَ الجُمُعةِ في جَماعةٍ، وما أَحسَبُه ",["شَهِدَها مِنكم",1]," ",["إلَّا مَغْفورٌ له",2],"."],"grade":"صحيح","narrator":"أبو عبيدة بن الجراح","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه البزار (1279) واللفظ له، والطبراني في ((الأوسط)) (184)، وأبو نعيم في ((معرفة الصحابة)) (592) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"4QFV1DL1","merged":2,"otherRefs":["الجامع الصغير 7650 (حسن)"]},{"id":"س-00649","fp":"3750435a87c4","stateId":85,"easy":"إذا رجف قلبك في سبيل الله ← تتساقط خطاياك","cause":"إذا رَجَف قَلبُ المُؤمِنِ في سَبيلِ اللهِ","result":"تَحاتَّت عَنه خَطاياه كما يتحاتُّ عَذقُ النَّخلةِ","explicit":true,"otherNeedIds":[67],"ref":"مشارع الأشواق 747","srcLabel":"الطبراني","text":["عن سَلمانَ رَضيَ اللهُ عنه قال: ",["إذا رَجَف قَلبُ المُؤمِنِ في سَبيلِ اللهِ ",1],["تَحاتَّت عَنه خَطاياه كما يتحاتُّ عَذقُ النَّخلةِ",2]],"grade":"صحيح","muhaddith":"[صحيح]","takhrij":"أخرجه الطبراني (6/ 235) (6086)، وأبو نعيم في ((حلية الأولياء)) (1/ 367) كلاهما بلفظه.","bab":"آداب عامة › ضرب الأمثال","dorar":"JiiyTNXZ"},{"id":"س-02784","fp":"21716962dc4a","stateId":85,"easy":"إذا كثرت ذنوبك ثم جاهدت بنفسك ومالك في سبيل الله حتى قُتلت ← تُمحى ذنوبك وخطاياك","cause":"ورجلٌ مؤمنٌ قرَف على نفسِه مِن الذُّنوبِ والخطايا جاهَد بنفسِه ومالِه في سبيلِ اللهِ حتَّى إذا لقي العدوَّ قاتَل حتَّى قُتِل","result":"فتلك مَصْمَصةٌ محَتْ ذنوبَه وخطاياه، إنَّ السَّيفَ محَّاءٌ للخطايا وأُدخِل مِن أيِّ أبوابِ الجنَّةِ شاء","explicit":true,"otherNeedIds":[67],"ref":"صحيح ابن حبان 4663","srcLabel":"أحمد","text":["القتلى ثلاثةٌ: رجلٌ مؤمنٌ جاهَد بنفسِه ومالِه في سبيلِ اللهِ حتَّى إذا لقي العدوَّ قاتَلهم حتَّى يُقتَلَ فذلك الشَّهيدُ الممتحَنُ في خيمةِ اللهِ تحتَ عرشِه ولا يفضُلُه النَّبيُّون إلَّا بفضلِ درجةِ النُّبوَّةِ، ",["ورجلٌ مؤمنٌ قرَف على نفسِه مِن الذُّنوبِ والخطايا جاهَد بنفسِه ومالِه في سبيلِ اللهِ حتَّى إذا لقي العدوَّ قاتَل حتَّى قُتِل",1]," ",["فتلك مَصْمَصةٌ محَتْ ذنوبَه وخطاياه، إنَّ السَّيفَ محَّاءٌ للخطايا وأُدخِل مِن أيِّ أبوابِ الجنَّةِ شاء",2]," فإنَّ لها ثمانيةَ أبوابٍ، ولجهنَّمَ سبعةَ أبوابٍ، وبعضُها أفضلُ مِن بعضٍ، ورجلٌ منافقٌ جاهَد بنفسِه ومالِه في سبيلِ اللهِ حتَّى إذا لقي العدوَّ قاتَل حتَّى قُتِل فذلك في النَّارِ إنَّ السَّيفَ لا يمحو النِّفاقَ"],"grade":"صحيح","narrator":"عتبة بن عبد السلمي","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (17657)، والطبراني (17/ 126) (311) كلاهما بلفظه، والدارمي (2455) بنحوه.","bab":"إيمان › النفاق","dorar":"3DmVqyKb"},{"id":"س-03283","fp":"daf235eccdaa","stateId":85,"easy":"إذا قُتلت في سبيل الله ← يكفّر الله ذنوبك كلها بأول قطرة من دمك","cause":"إذا قُتِلَ العبدُ في سبيلِ اللهِ فأولُ قطرةٍ تقعُ على الأرضِ من دمِه","result":"يُكفِّرُ اللهُ ذنوبَه كلَّها ثم يُرْسِلُ إليه بربطةٍ من الجنةِ فتُقبضُ فيها نفسُه وبجسدٍ من الجنةِ حتى تُركَّبَ فيه روحُه ثم يعرجُ مع الملائكةِ كأنَّهُ كان معهم منذُ خلقَه اللهُ حتى يُؤْتَى","explicit":true,"similar":["س-03555"],"otherNeedIds":[67],"ref":"مجمع الزوائد 5/301","srcLabel":"مجمع الزوائد","text":["عن عبدِ اللهِ بنِ عمرو قال ",["إذا قُتِلَ العبدُ في سبيلِ اللهِ فأولُ قطرةٍ تقعُ على الأرضِ من دمِه ",1],["يُكفِّرُ اللهُ ذنوبَه كلَّها ثم يُرْسِلُ إليه بربطةٍ من الجنةِ فتُقبضُ فيها نفسُه وبجسدٍ من الجنةِ حتى تُركَّبَ فيه روحُه ثم يعرجُ مع الملائكةِ كأنَّهُ كان معهم منذُ خلقَه اللهُ حتى يُؤْتَى",2]," به إلى السماءِ فما مرَّ ببابٍ إلا فُتِحَ له ولا مَلَكٌ إلا صلى عليه واستغفرَ له حتى يُؤْتَى به الرحمنَ عزَّ وجلَّ فيسجدُ قبلَ الملائكةِ ثم تسجدُ الملائكةُ بعدَه ثم يُغفرُ له ويُطهَّرُ ثم يُؤمرُ به إلى الشهداءِ فيجدُهم في رياضٍ خضرٍ وقِبابٍ من حريرٍ عندهم نورٌ وحورٌ يلعبانِ لهم كلَّ يومٍ بشيٍء لم يلعباهُ بالأمسِ يظلُّ الحوتُ في أنهارِ الجنةِ فيأكلُ من كلِّ رائحةٍ من أنهارِ الجنةِ فإذا أمسى وكزَه بقرنِه فذكَّاهُ فأكلوا من لحمِه فوجدوا في طعمِ لحمِه كلَّ رائحةٍ من أنهارِ الجنةِ ويبيتُ الثورُ نافشًا في الجنةِ يأكلُ من ثمرِ الجنةِ فإذا أصبح عدا عليه الحوتُ فذكَّاهُ بذنَبِه فأكلوا من لحمِه فوجدوا في طعمِ لحمِه كلَّ ثمرةٍ في الجنةِ ينظرون إلى منازلهم يدعون اللهَ بقيامِ الساعةِ"],"grade":"صحيح","muhaddith":"رجاله رجال الصحيح خلا عبد الرحمن بن البيلماني وهو ثقة","bab":"استغفار › أسباب المغفرة","dorar":"rCoFgcDx"},{"id":"س-03291","fp":"551db4713022","stateId":85,"easy":"إذا جُرحت في سبيل الله ← يحطّ الله عنك بأول قطرة من دمك خطاياك كما يحطّ الغصن ورقه","cause":"فإنَّ أولَ قَطْرَةٍ تَقْطُرُ من دَمِ أَحَدِكُمْ","result":"يَحُطُّ اللهُ مِنْهُ بِها خَطَاياهُ كما يَحُطُّ الغُصْنُ من ورَقِ الشجرَةِ","explicit":true,"ref":"صحيح الترغيب 1377","srcLabel":"الحاكم","text":["عن يزيدَ بنِ شَجَرَةَ قال : ",["فإنَّ أولَ قَطْرَةٍ تَقْطُرُ من دَمِ أَحَدِكُمْ ",1],["يَحُطُّ اللهُ مِنْهُ بِها خَطَاياهُ كما يَحُطُّ الغُصْنُ من ورَقِ الشجرَةِ ",2],"، وتَبْتَدِرُهُ اثْنَتَانِ من الحُورِ العِينِ ، ويَمْسَحانِ التُّرَابَ عن وجهِهِ ، ويقولُان : قد أنَى لكَ . ويقولُ : قد أنَى لَكُما . فَيُكْسَى مِائةَ حُلَّةٍ ، لَوْ وُضِعَتْ بين أُصْبُعَيَّ هاتَيْنِ لَوَسَعَتَاهُما ، ليسَتْ من نَسْجِ بَنِي آدمَ ، ولَكِنَّها من نباتِ الجنةِ ، مَكْتُوبُونَ عندَ اللهِ بِأَسْمائِكُمْ وسِماتِكُمْ . الحديثُ ."],"grade":"صحيح","narrator":"مجاهد بن جبر المكي","muhaddith":"صحيح","takhrij":"أخرجه البيهقي في ((البعث والنشور)) (562) واللفظ له وزيادة ،والطبراني ((22/ 246)) (641) ، والحاكم (6087) بنحوه","bab":"استغفار › أسباب المغفرة","dorar":"kJZKMYSB"},{"id":"س-03555","fp":"f7198b65c371","stateId":85,"easy":"إذا قُتلت في سبيل الله ← تُكفّر ذنوبك كلها إلا الأمانة","cause":"القتلُ في سبيلِ اللهِ","result":"يُكفِّرُ الذُّنوبَ كلَّها إلَّا الأمانةَ","explicit":true,"repOf":"س-03283","ref":"الترغيب والترهيب 4/74","text":["عن ابنِ مسعودٍ رضِي اللهُ عنه قال : ",["القتلُ في سبيلِ اللهِ ",1],["يُكفِّرُ الذُّنوبَ كلَّها إلَّا الأمانةَ",2]," قال : يُؤتَى العبدُ يومَ القيامةِ ، وإن قُتِل في سبيلِ اللهِ ، فيُقالُ : أدِّ أمانتَك ، فيقولُ : أيْ ربِّ كيف ، وقد ذهبت الدُّنيا ، فيُقالُ : انطلِقوا به إلى الهاويةِ ، فيُنطلَقُ به إلى الهاويةِ ، وتمثُلُ له أمانتُه كهيئتِها يومَ دُفِعت إليه ، فيراها فيعرِفُها ، فيهوي في أثرِها حتَّى يُدرِكَها ، فيحمِلُها على منكِبَيْه حتَّى إذا ظنَّ أنَّه خارجٌ قلَّت عن منكِبَيْه ، فهو يهوي في أثرِها أبدَ الآبدين ، ثمَّ قال : الصَّلاةُ أمانةٌ ، والوضوءُ أمانةٌ ، والوزنُ أمانةٌ ، والكيْلُ أمانةٌ ، وأشياءُ عدَّدها ، وأشدُّ ذلك الودائعُ . قال – يعني زاذانَ : فأتيْتُ البراءَ بنَ عازبَ فقلتُ : ألا ترَى إلى ما قال ابنُ مسعودٍ ؟ قال : كذا ، قال : صدق . أما سمِعتَ اللهَ يقولُ :  إِنَّ اللَّهَ يَأْمُرُكُمْ أَنْ تُؤَدُّوا الْأَمَانَاتِ إِلَى أَهْلِهَا"],"grade":"صحيح","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","bab":"استغفار › مكفرات الذنوب","dorar":"syukVliI"},{"id":"س-03567","fp":"e565f1a36972","stateId":85,"easy":"إذا استُشهدت ← يُغفر لك مع أول دفعة من دمك","cause":"الشَّهيدُ","result":"أوَّلُ دُفْعةٍ يَغفِرُ له ذُنوبَه، وأوَّلُ مَن يَمسَحُ التُّرابَ عن وَجْهِه زَوْجتُه مِن الحورِ العينِ، وإذا وَجَبَ إلى الأرْضِ وَقَعَ في الجَنَّةِ","explicit":true,"similar":["س-04551"],"otherNeedIds":[67],"ref":"علل ابن أبي حاتم 923","srcLabel":"الديلمي","text":["حَديثٌ عن موسى بنِ إسْماعيلَ، عن حمَّادٍ، عن أبانَ بنِ أبي عَيَّاشٍ، عن أَنَسٍ، عن النَّبيِّ صلَّى اللهُ عليه وسلَّم، قالَ: يُعْطى ",["الشَّهيدُ",1]," ثَلاثةً: ",["أوَّلُ دُفْعةٍ يَغفِرُ له ذُنوبَه، وأوَّلُ مَن يَمسَحُ التُّرابَ عن وَجْهِه زَوْجتُه مِن الحورِ العينِ، وإذا وَجَبَ إلى الأرْضِ وَقَعَ في الجَنَّةِ",2],"."],"grade":"صحيح","narrator":"أنس","muhaddith":"يَرْوي هذا الحَديثَ مُؤَمَّلٌ، عن حمَّادٍ، عن ثابِتٍ، عن أَنَسٍ، عن النَّبيِّ صلَّى اللهُ عليه وسلَّم؛ وأبانُ أَصَحُّ.","takhrij":"أخرجه الديلمي في ((مسند الفردوس)) كما في ((زهر الفردوس)) لابن حجر (3423) بنحوه.","bab":"استغفار › مكفرات الذنوب","dorar":"H2TfE6mR"},{"id":"س-03914","fp":"6fdc533858ae","stateId":85,"easy":"إذا استُشهدت ← تكفّر الشهادة كل ذنب إلا الأمانة","cause":"إنَّ الشَّهادةَ","result":"تُكَفِّرُ كلَّ ذَنبٍ إلَّا الأمانةَ","explicit":true,"repOf":"س-03374","ref":"عمدة التفسير 1/527","text":["عن ابنِ مَسعودٍ قالَ : ",["إنَّ الشَّهادةَ ",1],["تُكَفِّرُ كلَّ ذَنبٍ إلَّا الأمانةَ ",2],"، يُؤتَى بالرَّجلِ يومَ القِيامَةِ - وإن كان قُتِلَ في سبيلِ اللَّهِ - فيقالُ : أدِّ أمانتَكَ ، فيقولُ وأنَّى أؤدِّيها وقد ذَهَبتِ الدُّنيا ؟ ! فتُمَثَّلُ لَهُ الأمانةُ في قعرِ جَهَنَّمَ فيَهْوي إليها فيحمِلُها على عاتقِهِ ، قالَ : فتنزلُ على عاتقِهِ فيَهْوي على أثرِها أبدَ الآبدينَ قالَ زاذانُ : فأتيتُ البراءَ فحدَّثتُهُ ، فقالَ : صدقَ أخي :  إِنَّ اللَّهَ يَأْمُرُكُمْ أَنْ تُؤَدُّوا الْأَمَانَاتِ إِلَى أَهْلِهَا"],"grade":"صحيح","narrator":"زاذان أو زادان","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي حاتم في ((تفسيره)) (5512) واللفظ له، والبيهقي في ((شعب الإيمان)) (4885)، والدينوري في ((المجالسة وجواهر العلم)) (1701)، وابن جرير الطبري في ((تفسيره)) (19/ 201)، والخرائطي في ((مكارم الأخلاق)) (160) جميعا بنحوه.","bab":"تفسير آيات › سورة النساء","dorar":"JSs6cgTE"},{"id":"س-04521","fp":"9929f0134e28","stateId":85,"easy":"إذا قُتلت في سبيل الله ← يكفّر كل خطيئة","cause":"القَتلُ في سبيلِ اللَّهِ","result":"يُكَفِّرُ كلَّ خطيئةٍ","explicit":true,"repOf":"س-04507","ref":"صحيح الترمذي 1640","text":[["القَتلُ في سبيلِ اللَّهِ ",1],["يُكَفِّرُ كلَّ خطيئةٍ",2],"، فقالَ جِبريلُ: إلَّا الدَّينَ، فقالَ النَّبيُّ صلَّى اللَّهُ علَيهِ وسلَّمَ: إلَّا الدَّينَ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1640)","bab":"جهاد › فضل الشهيد","dorar":"3lPbDG5D"},{"id":"س-02667","fp":"0e422d551801","stateId":85,"easy":"إذا أصابك صداع في سبيل الله فاحتسبته ← يُغفر لك ما قبله من ذنب","cause":"من صدعَ رأسُهُ في سبيلِ اللَّهِ فاحتسبَ","result":"غفرَ لهُ ما كانَ قبلَ ذلكَ من ذنبٍ","explicit":true,"ref":"مجمع الزوائد 2/305","srcLabel":"الطبراني","text":[["من صدعَ رأسُهُ في سبيلِ اللَّهِ فاحتسبَ ",1],["غفرَ لهُ ما كانَ قبلَ ذلكَ من ذنبٍ",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني كما في ((مجمع الزوائد)) للهيثمي (2/305)","bab":"إيمان › الاحتساب والنية","dorar":"yk8M0d1H"},{"id":"س-02113","fp":"a104285ebfca","stateId":85,"easy":"إذا قُتلت في سبيل الله صابراً محتسباً مقبلاً ← يكفّر الله خطاياك إلا الدين","cause":"قُتِلتُ في سَبيلِ اللهِ صابِرًا مُحتَسِبًا، مُقبِلًا غَيرَ مُدبِرٍ","result":"كفَّرَ اللهُ عَنِّي خَطاياي","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-04507","ref":"تخريج المسند لشعيب 8075","text":["قام رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يَخطُبُ النَّاسَ، فذكَرَ الإيمانَ باللهِ، والجِهادَ في سَبيلِ اللهِ، مِن أَفضَلِ الأَعمالِ عنْدَ اللهِ، قال: فقام رَجُلٌ فقال: يا رسولَ اللهِ، أرأَيتَ إنْ قُتِلتُ في سَبيلِ اللهِ وأنا صابِرٌ مُحتَسِبٌ، مُقبِلٌ غَيرُ مُدبِرٍ، كفَّرَ اللهُ عَنِّي خَطاياي؟ قال: نَعَمْ. قال: فكيف قُلتَ؟ قال: فرَدَّ عليه القَولَ كما قال، قال: نَعَمْ. قال: فكيف قُلتَ؟ قال: فرَدَّ عليه القَولَ أَيضًا، قال: يا رسولَ اللهِ، أرأَيتَ إنْ ",["قُتِلتُ في سَبيلِ اللهِ صابِرًا مُحتَسِبًا، مُقبِلًا غَيرَ مُدبِرٍ",1],"، ",["كفَّرَ اللهُ عَنِّي خَطاياي؟",2]," قال: نَعَمْ، إلَّا الدَّيْنَ؛ فإنَّ جِبريلَ سارَّني بِذلك."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه النسائي (3155)، وأحمد (8075) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"JNC0vrjt","merged":3,"otherRefs":["صحيح النسائي 3155 (صحيح)","صحيح النسائي 3158 (صحيح)"]},{"id":"س-04551","fp":"3dd72540736a","stateId":85,"easy":"إذا استُشهدت ← تكون أول قطرة من دمك كفارة لخطاياك","cause":"وإنِ استُشهدَ","result":"كانت أوَّلُ نَضحةٍ كَفَّارةَ الخَطايا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03567","otherNeedIds":[62],"ref":"مشارع الأشواق 743","text":["قامَ يَزيدُ بنُ شَجَرةَ في أصحابِه، فقال: إنَّه قد أصبَحتُ عليكُم وأمسَيتُ مِن بَينِ أخضَرَ وأحمَرَ وأصفَرَ، وفي البُيوتِ ما فيها، فإذا لَقيتُمُ العَدوَّ غَدًا فقُدُمًا قُدُمًا، ما تَقدَّمَ رَجُلٌ مِن خُطوةٍ إلَّا تَقدَّم إلَيه الحُورُ العِينُ، فإن تَأخَّر استَتَرنَ مِنه، ",["وإنِ استُشهدَ",1]," ",["كانت أوَّلُ نَضحةٍ كَفَّارةَ الخَطايا",2],"، ويُنزِلُ اللهُ مِنَ الحُورِ العَينِ ثِنتَينِ، فتَنفُضانِ عَنه التُّرابَ، ويَقولانِ: مَرحَبًا قد آنَ لَك، ويَقولُ: مَرحَبًا قد آنَ لَكُما"],"grade":"صحيح","narrator":"يزيد بن شجرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي شيبة (20475)، وعبد بن حميد (440) كلاهما بلفظه مطولا، والطبراني (22/ 247) (642) بنحوه.","bab":"جهاد › فضل الشهيد","dorar":"YDJjKqdQ"},{"id":"س-07953","fp":"cfd02c6c897b","stateId":86,"easy":"إذا ابتلاك الله ببلاء في جسدك ← يكون حطّاً لذنوبك","cause":"ومَن ابْتَلاه اللهُ ببَلاءٍ في جَسَدِه","result":"فهو له حِطَّةٌ","explicit":true,"star":true,"otherNeedIds":[9],"ref":"الأحاديث المختارة 1120","srcLabel":"البخاري","text":["«دَخَلْنا على أبي عُبَيْدةَ بنِ الجَرَّاحِ نَعودُه مِن شَكْوى أصابَه، وامْرَأتُه تُحَيْفةُ قاعِدةٌ عنْدَ رأسِه، قُلْتُ: كيف باتَ أبو عُبَيْدةَ؟ قالَتْ: واللهِ لقد باتَ بأجْرٍ، فقالَ أبو عُبَيْدةَ: ما بِتُّ بأجْرٍ، وكانَ مُقبِلًا بوَجْهِه على الحائِطِ، فأَقبَلَ على القَوْمِ بوَجْهِه فقالَ: أَلَا تَسْألوني عمَّا قُلْتُ؟ قالوا: ما أَعْجَبَنا ما قُلْتَ فنَسأَلَك عنه، قالَ: سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: مَن أَنفَقَ نَفَقةً فاضِلةً في سَبيلِ اللهِ فبِسبعِمِئةٍ، ومَن أَنفَقَ على نفْسِه وأهْلِه أو عادَ مَريضًا أو مازَ أذًى فالحَسَنةُ بعَشْرِ أمْثالِها، والصَّوُمُ جُنَّةٌ ما لم يَخرِقْها، ",["ومَن ابْتَلاه اللهُ ببَلاءٍ في جَسَدِه",1]," ",["فهو له حِطَّةٌ",2],"»."],"grade":"صحيح","narrator":"أبو عبيدة بن الجراح","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"ZVLsU2Kt","merged":4,"otherRefs":["فتح الباري لابن حجر 10/114 (حسن)","تخريج مشكل الآثار 2215 (حسن)","تخريج سير أعلام النبلاء 1/19-20 (حسن)"]},{"id":"س-03318","fp":"6f39d4126d6d","stateId":86,"easy":"إذا مرضت ← يقصّ الله به من خطاياك","cause":"ما مِن مُؤمِنٍ و لا مُؤمِنةٍ ، ولا مُسلِمٍ و لا مُسلِمةٍ ، يمرَضُ مرضًا","result":"إلَّا قصَّ اللهُ بهِ عنهُ مِن خطاياهُ","explicit":true,"star":true,"similar":["س-03281","س-03426"],"ref":"صحيح الأدب المفرد 393","srcLabel":"البخاري","text":[["ما مِن مُؤمِنٍ و لا مُؤمِنةٍ ، ولا مُسلِمٍ و لا مُسلِمةٍ ، يمرَضُ مرضًا ،",1]," ",["إلَّا قصَّ اللهُ بهِ عنهُ مِن خطاياهُ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أحمد (15146)، والطيالسي في ((المسند)) (1882)، والبخاري في ((الأدب المفرد)) (508) واللفظ له","bab":"استغفار › أسباب المغفرة","dorar":"R4Rgdegd","merged":3,"otherRefs":["السلسلة الصحيحة 6/18 (صحيح)","تخريج المسند لشعيب 15146 (صحيح)"]},{"id":"س-05677","fp":"b7ce41e7b75e","stateId":86,"easy":"إذا ضرب عليك عِرق (ألم) ← يحطّ الله عنك خطيئة ويكتب لك حسنة ويرفعك درجة","cause":"ما ضَرَب من مُؤمِنٍ عِرقٌ","result":"إلَّا حَطَّ اللهُ عنه به خَطيئةٌ، وكَتَب له به حَسَنةً، ورَفَع له به دَرَجةً","explicit":true,"otherNeedIds":[47],"ref":"المستدرك على الصحيحين 1302","srcLabel":"متفق عليه","text":[["ما ضَرَب من مُؤمِنٍ عِرقٌ",1]," ",["إلَّا حَطَّ اللهُ عنه به خَطيئةٌ، وكَتَب له به حَسَنةً، ورَفَع له به دَرَجةً",2],"."],"grade":"صحيح","narrator":"عائشة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (9394) بلفظه، والبخاري (5640)، ومسلم (2572) بنحوه.","bab":"رقائق وزهد › الصبر على البلاء","dorar":"nIITCmuS","merged":2,"otherRefs":["فتح الباري لابن حجر 10/109 (حسن)"]},{"id":"س-07903","fp":"fdbae72c1857","stateId":86,"easy":"إذا أصابتك الحمى فلا تسبّها ← فإنها تُذهب الخطايا كما يُذهب الكير خبث الحديد","cause":"لا تسُبِّي الحمَّى","result":"فإنَّها تُذهِبُ خطايا ابنِ آدَمَ كما يُذهِبُ الكِيرُ خبَثَ الحديدِ","explicit":true,"similar":["س-07897","س-03263"],"otherNeedIds":[9],"ref":"تخريج صحيح ابن حبان 2938","srcLabel":"مسلم","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم دخَل على أمِّ السَّائبِ أو أمِّ المسيَّبِ وهي تُرفرفُ فقال: ( ما لك يا أمَّ السَّائبِ أو يا أمَّ المسيَّبِ تُرفرفينَ ؟ ) قالت: الحمَّى لا بارَك اللهُ فيها فقال صلَّى اللهُ عليه وسلَّم: ( ",["لا تسُبِّي الحمَّى ",1],["فإنَّها تُذهِبُ خطايا ابنِ آدَمَ كما يُذهِبُ الكِيرُ خبَثَ الحديدِ )",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه ابن حبان (2938) واللفظ له، ومسلم (2575)، وأبو يعلى (2083) باختلاف يسير.","bab":"مريض › فضل المرض والنوائب","dorar":"y0RrLEiO","merged":3,"otherRefs":["صحيح الأدب المفرد 401 (صحيح)","السلسلة الصحيحة 2/331 (حسن)"]},{"id":"س-00644","fp":"32702a90428c","stateId":86,"easy":"إذا مرضت ← يذهب المرض خطاياك كما يتساقط ورق الشجر","cause":"إنَّ المَرَضَ","result":"لَيُذهِبُ الخَطايا كما يَتَحاتُّ وَرَقُ الشَّجَرِ","explicit":true,"similar":["س-00536","س-00512"],"otherNeedIds":[9],"ref":"الأحاديث المختارة 1427","srcLabel":"البخاري","text":["«",["إنَّ المَرَضَ",1]," ",["لَيُذهِبُ الخَطايا كما يَتَحاتُّ وَرَقُ الشَّجَرِ",2],"»."],"grade":"صحيح","narrator":"أسد بن كرز","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"آداب عامة › ضرب الأمثال","dorar":"RbFKDU50"},{"id":"س-03314","fp":"606a19345555","stateId":86,"easy":"إذا مرضت فأبشر ← يجعل الله مرضك كفارة لك وفرصة للرجوع إليه","cause":"أَبْشِرْ","result":"فإنَّ مَرَضَ المُؤْمِنِ يَجْعَلُهُ اللهُ لهُ كَفَّارَةً ومُسْتَعْتَبًا وإِنَّ مَرَضَ الفاجرِ كَالبَعِيرِ عَقَلهُ أهلُهُ ثُمَّ أَرْسَلوهُ فلا يَدْرِي لِمَ عُقِلَ ولِمَ أُرْسِلَ","explicit":true,"otherNeedIds":[9],"ref":"صحيح الأدب المفرد 379","srcLabel":"البخاري","text":["كُنْتُ مع سَلْمانَ وعادَ مَرِيضًا في كِنْدَةَ فلمَّا دخلَ عليهِ قال ",["أَبْشِرْ ",1],["فإنَّ مَرَضَ المُؤْمِنِ يَجْعَلُهُ اللهُ لهُ كَفَّارَةً ومُسْتَعْتَبًا وإِنَّ مَرَضَ الفاجرِ كَالبَعِيرِ عَقَلهُ أهلُهُ ثُمَّ أَرْسَلوهُ فلا يَدْرِي لِمَ عُقِلَ ولِمَ أُرْسِلَ",2]],"grade":"صحيح","narrator":"[سعيد بن موهب]","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (493) بلفظه، وابن أبي شيبة (10918)، وابن أبي الدنيا في ((المرض والكفارات)) (45) كلاهما بألفاظ مقاربة.","bab":"استغفار › أسباب المغفرة","dorar":"8AGXtjbj"},{"id":"س-07897","fp":"b7f756faffcf","stateId":86,"easy":"إذا أصابتك الحمى فلا تسبّها ← فإنها تغسل الذنوب كما يُذهب الكير خبث الحديد","cause":"لا تَسُبِّيها","result":"فإنَّها تَغسِلُ ذُنوبَ العَبدِ كما يُذهِبُ الكِيرُ خَبَثَ الحَديدِ","explicit":true,"repOf":"س-07903","otherNeedIds":[9],"ref":"المستدرك على الصحيحين 1297","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ عادَ امرَأةً منَ الأنصارِ، فقالَ لها: أهِيَ أُمُّ مِلدَمٍ؟ قالتْ: نَعَم، فلَعَنَها اللهُ! فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["لا تَسُبِّيها؛ ",1],["فإنَّها تَغسِلُ ذُنوبَ العَبدِ كما يُذهِبُ الكِيرُ خَبَثَ الحَديدِ",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح على شرط مسلم","bab":"مريض › فضل المرض والنوائب","dorar":"NZD2fRlj"},{"id":"س-03547","fp":"8e32c1ce1eda","stateId":86,"easy":"إذا أصابك الوجع ← يكفّر الله به الخطايا","cause":"الوَجَعَ","result":"ولكِنَّ اللهَ يُكفِّرُ به الخطايا","explicit":true,"otherNeedIds":[9],"ref":"تخريج مشكل الآثار 5/ 464","srcLabel":"البيهقي","text":["قال عبدُ اللهِ: إنَّ ",["الوَجَعَ",1]," لا يُكتَبُ أجْرًا، فكان ذلك أشَدَّ، أو أشَقَّ علينا، وكان إذا حدَّثنا حديثًا لم نسأَلْه عن تَفسيرِه حتى يُبيِّنَه، قال: ",["ولكِنَّ اللهَ يُكفِّرُ به الخطايا",2],"."],"grade":"صحيح","narrator":"أبو معمر","muhaddith":"إسناده صحيح رجاله ثقات رجال الشيخين","takhrij":"أخرجه الطحاوي في ((شرح المشكل)) (5/ 464) بلفظه، وابن أبي شيبة (10926)، والبيهقي في ((شعب الإيمان)) (9388) كلاهما باختلاف يسير.","bab":"استغفار › مكفرات الذنوب","dorar":"M25lPm1A","merged":3,"otherRefs":["مجمع الزوائد 2/304 (حسن)","مسائل أحمد رواية ابن هانيء 2/237 (صحيح)"]},{"id":"س-00536","fp":"3a952477569a","stateId":86,"easy":"إذا مرضت ← تتساقط خطاياك كما يتساقط ورق الشجر","cause":"المريضُ","result":"تَحاتُّ خَطاياه كما يتَحاتُّ ورقُ الشجرةِ","explicit":true,"repOf":"س-00644","otherNeedIds":[9],"ref":"الجامع الصغير 9176","text":[["المريضُ",1]," ",["تَحاتُّ خَطاياه كما يتَحاتُّ ورقُ الشجرةِ",2]],"grade":"صحيح","narrator":"أسد بن كرز بن عامر البجلي","muhaddith":"صحيح","takhrij":"أخرجه أحمد (16654)، وابن أبي الدنيا في ((المرض والكفارات)) (ص166)، وابن أبي عاصم في ((الآحاد والمثاني)) (2543) بلفظه.","bab":"آداب عامة › ضرب الأمثال","dorar":"A1G3vl8c","merged":2,"otherRefs":["مجمع الزوائد 2/304 (حسن)"]},{"id":"س-00512","fp":"5f46df3aa936","stateId":86,"easy":"إذا مرضت ← يُذهب الله بمرضك خطاياك كما تُذهب النار خبث الذهب","cause":"أبشِري يا أمَّ العلاءِ","result":"فإنَّ مَرضَ المسلمِ يذهبُ اللَّهُ بِهِ خطاياهُ، كما تُذهبُ النَّارُ خَبثَ الذَّهبِ والفضَّةِ","explicit":true,"repOf":"س-00644","otherNeedIds":[9],"ref":"صحيح أبي داود 3092","text":["عادَني رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وأَنا مَريضةٌ، فقالَ: ",["أبشِري يا أمَّ العلاءِ، ",1],["فإنَّ مَرضَ المسلمِ يذهبُ اللَّهُ بِهِ خطاياهُ، كما تُذهبُ النَّارُ خَبثَ الذَّهبِ والفضَّةِ",2]],"grade":"صحيح","narrator":"أم العلاء عمة حزام بن حكيم","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3092) واللفظ له، وعبد بن حميد في ((المسند)) (1562)، والطبراني (25/141) (340)","bab":"آداب عامة › ضرب الأمثال","dorar":"48ggHYyw"},{"id":"س-00513","fp":"1ee5f240062a","stateId":86,"easy":"إذا أصابتك الحمى فلا تسبّها ← فإنها تنفي الذنوب","cause":"لا تَسبَّها","result":"فإنَّها تنفي الذُّنوبَ كما تَنفي النَّارُ خبثَ الحديدِ","explicit":true,"otherNeedIds":[9],"ref":"صحيح ابن ماجه 2810","srcLabel":"ابن ماجه","text":["ذُكِرتِ الحُمَّى عندَ رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ، فسبَّها رجلٌ فقالَ النَّبيُّ صلَّى اللَّهُ علَيهِ وسلَّمَ: ",["لا تَسبَّها ",1],["فإنَّها تنفي الذُّنوبَ كما تَنفي النَّارُ خبثَ الحديدِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (3469) واللفظ له، وابن أبي شيبة (10915)، والطبراني في ((المعجم الأوسط)) (6248) باختلاف يسير","bab":"آداب عامة › ضرب الأمثال","dorar":"vhBCWXeX"},{"id":"س-03251","fp":"85fc5f0ab19e","stateId":86,"easy":"إذا تعبت ومرضت ← يكون ذلك كفارة لخطاياك","cause":"وصبُ المؤمنُ","result":"كفارةٌ لخطاياه","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 1/164","srcLabel":"الزواجر عن اقتراف الكبائر","text":[["وصبُ المؤمنُ ",1],["كفارةٌ لخطاياه ",2],"، إذا اشتكى المؤمنُ أخلصَهُ اللَّه منَ الذُّنوبِ كما يخلِّصُ الكيرُ خبثَ الحديدِ"],"grade":"صحيح","muhaddith":"صحيح","bab":"استغفار › أسباب المغفرة","dorar":"iWtyMCuh"},{"id":"س-03252","fp":"73d5a097d0a4","stateId":86,"easy":"إذا اشتكيت مرضاً ← يخلّصك الله من الذنوب كما يخلّص الكير خبث الحديد","cause":"إذا اشتكى المؤمنُ","result":"أخلصَهُ اللَّه منَ الذُّنوبِ كما يخلِّصُ الكيرُ خبثَ الحديدِ","explicit":true,"apply":{"k":"time","t":"عند المرض والوجع"},"otherNeedIds":[9],"ref":"الزواجر عن اقتراف الكبائر 1/164","srcLabel":"الزواجر عن اقتراف الكبائر","text":["وصبُ المؤمنُ كفارةٌ لخطاياه ، ",["إذا اشتكى المؤمنُ",1]," ",["أخلصَهُ اللَّه منَ الذُّنوبِ كما يخلِّصُ الكيرُ خبثَ الحديدِ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"استغفار › أسباب المغفرة","dorar":"iWtyMCuh"},{"id":"س-03263","fp":"1118d8bb5964","stateId":86,"easy":"إذا أصابتك الحمّى ← تُخرج خبثك (ذنوبك) كما يُخرج الكير خبث الحديد","cause":"أُمَّ مِلْدَمٍ","result":"تُخرِجُ خَبَثَ ابنِ آدَمَ كما يُخرِجُ الكِيرُ خَبثَ الحدِيدِ","explicit":true,"repOf":"س-07903","otherNeedIds":[9],"ref":"صحيح الجامع 2006","text":["إنَّ ",["أُمَّ مِلْدَمٍ",1]," ، ",["تُخرِجُ خَبَثَ ابنِ آدَمَ كما يُخرِجُ الكِيرُ خَبثَ الحدِيدِ",2]],"grade":"صحيح","narrator":"عمة عبد ربه بن سعيد بن قيس","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي عاصم في ((الآحاد والمثاني)) (3377)، وأبو نعيم الأصبهاني في ((معرفة الصحابة)) (8095) كلاهما بلفظه.","bab":"استغفار › أسباب المغفرة","dorar":"dW5uBkHd"},{"id":"س-03264","fp":"37a48db9e109","stateId":86,"easy":"إذا ابتلاك الله بالمرض ← يكفّر عنك به كل ذنب","cause":"إنَّ اللهَ تعالى يَبتلِي عبدَهُ المؤمن بالسَّقَمِ","result":"حتى يُكفِّرَ عنهُ كلَّ ذنْبٍ","explicit":true,"similar":["س-03289","س-07910","س-03339"],"otherNeedIds":[9],"ref":"صحيح الجامع 1870","srcLabel":"صحيح الجامع","text":[["إنَّ اللهَ تعالى يَبتلِي عبدَهُ المؤمن بالسَّقَمِ",1]," ؛ ",["حتى يُكفِّرَ عنهُ كلَّ ذنْبٍ",2]],"grade":"صحيح","narrator":"جبير بن مطعم وأبو هريرة","muhaddith":"صحيح","bab":"استغفار › أسباب المغفرة","dorar":"WuSKgfVI"},{"id":"س-03281","fp":"afac7e3de891","stateId":86,"easy":"إذا مرضت ← يحطّ الله به خطيئتك","cause":"لا يمرضُ مؤمنٌ ولا مؤمنةٌ ، ولا مُسلمٌ ولا مُسلمةٌ","result":"إلَّا حطَّ اللهُ به خطيئتِه","explicit":true,"repOf":"س-03318","otherNeedIds":[9],"ref":"الترغيب والترهيب 4/230","text":[["لا يمرضُ مؤمنٌ ولا مؤمنةٌ ، ولا مُسلمٌ ولا مُسلمةٌ",1]," ",["إلَّا حطَّ اللهُ به خطيئتِه ،",2]," وفي روايةٍ : إلَّا حطَّ اللهُ عنه من خطاياه"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أحمد (14725)، والطحاوي في ((مشكل الآثار)) (2222)، وابن الأعرابي في ((معجمه)) (544) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"8k7KCXJA"},{"id":"س-03289","fp":"73328cbe9ff7","stateId":86,"easy":"إذا ابتلاك الله بالسقم ← يكفّر به عنك كل ذنب","cause":"أنَّ اللهَ لَيَبْتَلِي عَبْدَهُ بِالسَّقَمِ","result":"حتى يُكَفِّرَ ذلكَ عنهُ كلَّ ذَنْبٍ","explicit":true,"repOf":"س-03264","otherNeedIds":[9],"ref":"صحيح الترغيب 3435","text":[["أنَّ اللهَ لَيَبْتَلِي عَبْدَهُ بِالسَّقَمِ ",1],["حتى يُكَفِّرَ ذلكَ عنهُ كلَّ ذَنْبٍ ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه الحاكم (1304)، والبيهقي في ((شعب الإيمان)) (9397)","bab":"استغفار › أسباب المغفرة","dorar":"XLrwXrNu"},{"id":"س-03306","fp":"f41771056b3b","stateId":86,"easy":"إذا أصابتك حمّى ليلة ← يكفّر الله عنك خطاياك كلها","cause":"بحُمَّى ليلةٍ","result":"إنَّ اللهَ ليُكفِّرُ عن المؤمنِ خطاياه كلَّها","explicit":true,"otherNeedIds":[9],"ref":"الترغيب والترهيب 4/235","srcLabel":"البيهقي","text":[["إنَّ اللهَ ليُكفِّرُ عن المؤمنِ خطاياه كلَّها",2]," ",["بحُمَّى ليلةٍ",1]],"grade":"صحيح","narrator":"الحسن البصري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن أبي الدنيا في ((المرض والكفارات)) (28) واللفظ له، والبيهقي في ((شعب الإيمان)) (9400) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"6RXBmgHR"},{"id":"س-03340","fp":"3f04afbf725f","stateId":86,"easy":"إذا اشتد عليك (عند الموت أو البلاء) ← يكون كفارة لخطاياك","cause":"أنَّ المؤمنَ يُشدَّدُ عليْهِ","result":"ليكونَ كفارةً لخطاياهُ","explicit":true,"otherNeedIds":[9],"ref":"السلسلة الصحيحة 3/94","srcLabel":"ابن سعد","text":["مرض رسولُ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ مرضًا اشتدَّ منه ضجرُه أو وجعُه قالَتْ : فقلتُ : يا رسولَ اللهِ إنَّكَ لتجزعُ أو تضجرُ لو فعلَتْهُ امرأةٌ منا عجبتَ منها قال : أو ما علمتَ ",["أنَّ المؤمنَ يُشدَّدُ عليْهِ",1]," ",["ليكونَ كفارةً لخطاياهُ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه ابن سعد  في ((الطبقات الكبرى)) (2 / 207) بلفظه","bab":"استغفار › أسباب المغفرة","dorar":"bW5UXi55"},{"id":"س-03359","fp":"396cca7961e4","stateId":86,"easy":"إذا صُرعت (سقطت) من مرض ← يبعثك الله منه طاهراً","cause":"ما مِنْ عبدٍ يُصْرَعُ صرْعَةً مِنْ مَرَضٍ","result":"إلَّا بعَثَهُ اللهُ منْها طاهِرًا","explicit":true,"otherNeedIds":[9],"ref":"صحيح الجامع 5743","srcLabel":"الطبراني","text":[["ما مِنْ عبدٍ يُصْرَعُ صرْعَةً مِنْ مَرَضٍ ،",1]," ",["إلَّا بعَثَهُ اللهُ منْها طاهِرًا",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه الروياني في ((المسند)) (1270)، والطبراني (8/115) (7485) واللفظ لهما، والبيهقي في ((شعب الإيمان)) (9922) مختصراً","bab":"استغفار › أسباب المغفرة","dorar":"ssoS9We9"},{"id":"س-06054","fp":"4eb590d64aa4","stateId":86,"easy":"إذا أصابتك حمّى ليلة فصبرت ورضيت عن الله ← تخرج من ذنوبك كيوم ولدتك أمك","cause":"من وُعِك ليلةً فصبَر ورضِي بها عن اللهِ عزَّ وجلَّ","result":"خرج من ذنوبِه كيومِ ولدتْه أمُّه","explicit":true,"ref":"الترغيب والترهيب 4/235","srcLabel":"البيهقي","text":[["من وُعِك ليلةً فصبَر ورضِي بها عن اللهِ عزَّ وجلَّ ",1],["خرج من ذنوبِه كيومِ ولدتْه أمُّه",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن أبي الدنيا في ((الرضا عن الله بقضائه)) (75) واللفظ له، والبيهقي في ((شعب الإيمان)) (9868)","bab":"رقائق وزهد › فضل الصبر","dorar":"pESEX9lK"},{"id":"س-07910","fp":"771bdfa49510","stateId":86,"easy":"إذا ابتلاك الله بمرض ← يُكفّر به عنك من سيئاتك","cause":"ابتلاه بمرضٍ","result":"يُكفَّرُ به عنه من سيئاتِه","explicit":true,"repOf":"س-03264","otherNeedIds":[9],"ref":"التمهيد 24/57","text":["أنَّ رجُلًا جاءه الموتُ في زمنِ رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ فقال رجُلٌ : هَنيئًا له مات ولم يُبتَلَ بمرضٍ ، فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ : ويحك وما يدريك لو أنَّ اللهَ ",["ابتلاه بمرضٍ",1]," ",["يُكفَّرُ به عنه من سيئاتِه",2]],"grade":"صحيح","narrator":"يحيى بن سعيد","muhaddith":"لا أعلم هذا الخبر بهذا اللفظ يستند عن النبي صلى الله عليه وسلم من وجه محفوظ","takhrij":"أخرجه مالك (2/942) باختلاف يسير","bab":"مريض › فضل المرض والنوائب","dorar":"eOPWDQQs"},{"id":"س-00529","fp":"34af6aeb8ac7","stateId":86,"easy":"إذا مرضت ثم عافاك الله ← كان كفارة لما مضى وموعظة لما يأتي","cause":"إنَّ المؤمنَ إذا أصابهُ السَّقَمُ ثمَّ عافاهُ اللهُ","result":"كان كفَّارةً لما مضى من ذنوبهِ وموعظةً له فيما يَستقبلُ وإنَّ المنافقَ إذا مَرِض ثمَّ أُعفيَ كان كالبعيرِ عقَلهُ أهلُه ثمَّ أرسلوهُ فلم يدرِ لمَ عقَلوهُ ولمَ أرسلوهُ","explicit":true,"otherNeedIds":[9],"ref":"هداية الرواة 2/170","srcLabel":"أبو داود","text":[["إنَّ المؤمنَ إذا أصابهُ السَّقَمُ ثمَّ عافاهُ اللهُ ",1],["كان كفَّارةً لما مضى من ذنوبهِ وموعظةً له فيما يَستقبلُ وإنَّ المنافقَ إذا مَرِض ثمَّ أُعفيَ كان كالبعيرِ عقَلهُ أهلُه ثمَّ أرسلوهُ فلم يدرِ لمَ عقَلوهُ ولمَ أرسلوهُ",2]],"grade":"حسن","narrator":"عامر الرام أخو الخضر بن محارب","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه أبو داود (3089)، وأبو نعيم في ((معرفة الصحابة)) (5188)، والبيهقي في ((شعب الإيمان)) (7130) باختلاف يسير","bab":"آداب عامة › ضرب الأمثال","dorar":"YJN9ABg1"},{"id":"س-03260","fp":"d54c4b16cd72","stateId":86,"easy":"إذا أصابتك حمّى ليلة ← ترجو بها كفارة ما مضى من ذنوبك","cause":"كَانُوا يَرْجُونَ في حُمَّى ليلةٍ","result":"كَفَّارَةً لَما مَضى مِنَ الذُّنوبِ","explicit":true,"ref":"صحيح الترغيب 3441","srcLabel":"أحمد","text":[["كَانُوا يَرْجُونَ في حُمَّى ليلةٍ ",1],["كَفَّارَةً لَما مَضى مِنَ الذُّنوبِ ",2],"."],"grade":"حسن","narrator":"الحسن البصري","muhaddith":"حسن","takhrij":"أخرجه عبدالله بن أحمد في ((زوائد الزهد)) (1600)، وابن أبي الدنيا في ((المرض والكفارات)) (29)، والبيهقي في ((شعب الإيمان)) (9867)","bab":"استغفار › أسباب المغفرة","dorar":"jCoQn0ND"},{"id":"س-03285","fp":"f69330aeee72","stateId":86,"easy":"إذا تضرعت (ذللت لله) في مرضك ← يبعثك الله منه طاهراً","cause":"ما من عبدٍ تضرَّعَ من مرضٍ","result":"إلَّا بعثَهُ اللَّهُ منهُ طاهرًا","explicit":true,"otherNeedIds":[9],"ref":"مجمع الزوائد 2/305","srcLabel":"الطبراني","text":[["ما من عبدٍ تضرَّعَ من مرضٍ",1]," ",["إلَّا بعثَهُ اللَّهُ منهُ طاهرًا",2]],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"رجاله ثقات","takhrij":"أخرجه الروياني في ((المسند)) (1270)، والطبراني (8/115) (7485)، والبيهقي في ((شعب الإيمان)) (9922) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"Mx3tT7AQ"},{"id":"س-03339","fp":"c8f02e87465a","stateId":86,"easy":"إذا مرضت ← يُكفَّر عنك به","cause":"إذا مَرِضَ","result":"لم يُؤجَرْ في مَرَضِه، ولكن يُكفَّرُ عنه","explicit":true,"repOf":"س-03264","otherNeedIds":[9],"ref":"مجمع الزوائد 2/303","text":["خَرَجتُ مع أبي، ومعنا النَّاسُ إلى أبي الدَّرداءِ نَعودُه، وكان ببَيتٍ خَدينٍ في جِدارِه مُوليًا وَجهَه إلى الحائِطِ، ووَجَدْنا امرَأتَه عندَ رأسِه، فقال لها القَومُ: كيف باتَ أبو الدَّرداءِ؟ فقالت: باتَ بأجْرٍ، فحَرَفَ وَجهَه إلينا، وقال: ليس القَولُ ما قالت، فوَجَمَ القَومُ لذلك، فقال: ألَا تَسأَلوني لِمَ قُلتُ هذا؟ قالوا: ولِمَ؟ قال: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: المُؤمِنُ ",["إذا مَرِضَ",1]," ",["لم يُؤجَرْ في مَرَضِه، ولكن يُكفَّرُ عنه",2],"."],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"فيه حفص بن عمر بن أبي القاسم ولم أجد من ذكره وبقية رجاله ثقات","takhrij":"أخرجه ابن عساكر في ((تاريخ دمشق)) (64/ 161) واللفظ له، والطبراني كما في ((جامع المسانيد)) (12015) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"KcvbOqIc"},{"id":"س-03535","fp":"09e97e302b6c","stateId":86,"easy":"إذا أصابتك الحمّى والصداع ← لا يتركانك وعليك مثقال خردلة من ذنب","cause":"المليلةُ والصداعُ","result":"فما يدَعُهما وعليهِما مِثقالُ خردلةٍ","explicit":true,"otherNeedIds":[9],"ref":"إتحاف الخيرة المهرة 4/ 404","srcLabel":"أبو يعلى","text":["لا تَزالُ ",["المليلةُ والصداعُ",1]," بالعبدِ والأَمَةِ ، وإنَّ عليهِما منَ الخطايا مِثلَ أُحُدٍ ، ",["فما يدَعُهما وعليهِما مِثقالُ خردلةٍ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده رجاله ثقات","takhrij":"أخرجه أبو يعلى (6150) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (4/104) باختلاف يسير","bab":"استغفار › مكفرات الذنوب","dorar":"QS5PvvqZ"},{"id":"س-03570","fp":"78aaf43ab25b","stateId":86,"easy":"إذا اصبرت على الحمى ← تُذهب خبثك كما يُذهب الكير خبث الحديد","cause":"اصبري","result":"فإنها تُذهِبُ خَبَثَ ابنِ آدمَ كما يُذهِبُ الكِيرُ خَبَثَ الحديدِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[9],"ref":"سبل الهدى والرشاد 8/350","srcLabel":"الطبراني","text":["عاد رسولُ اللهِ صلَّى اللهُ عليه وسلَّم امرأةً من الأنصارِ وهي وَجِعةٌ، فقال لها: «كيف تجدينك؟» قالت بخيرٍ إلَّا أنَّ أمَّ مِلدَمٍ قد برَّحَت بي، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم «",["اصبري ",1],["فإنها تُذهِبُ خَبَثَ ابنِ آدمَ كما يُذهِبُ الكِيرُ خَبَثَ الحديدِ»",2]],"grade":"صحيح","narrator":"فاطمة الخزاعية","muhaddith":"[رجاله] رجال الصحيح","takhrij":"أخرجه معمر في ((الجامع)) (20306)، والطبراني (24/ 405)، (984) كلاهما بلفظه.","bab":"استغفار › مكفرات الذنوب","dorar":"XxUVygSY"},{"id":"س-03572","fp":"b7c8fe1e8de4","stateId":86,"easy":"إذا أصابتك الحمى فصبرت ← تكون لك طهوراً","cause":"فلقُوا منها ما يعلَمُ اللهُ","result":"أن تكونَ لكم طَهُورًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[9],"ref":"طرح التثريب 3/240","srcLabel":"أحمد","text":["عن جابرٍ قال: استأذَنَتِ الحُمَّى على رسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: مَن هذه؟ فقالت: أمُّ مِلْدَمٍ، فأمَر بها إلى أهلِ قُباءٍ، ",["فلقُوا منها ما يعلَمُ اللهُ",1],"، فأتَوْه فشكَوْا ذلكَ إليه، فقال: ما شِئْتُم، إنْ شِئْتُم دعَوْتُ اللهَ لكم فيكشِفُها عنكم، وإنْ شِئْتُم ",["أن تكونَ لكم طَهُورًا",2],"، قالوا: يا رسولَ اللهِ، وتفعَلُ؟! قال: نَعم، قالوا: فدَعْها."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (14393)، وهناد بن السري في ((الزهد)) (389) واللفظ لهما.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"Ff0uE5Zc"},{"id":"س-03353","fp":"ab66d914724f","stateId":86,"easy":"إذا ابتُليت في جسدك ← يُكتب لك ما كنت تعمل في صحتك، وإن مت غُفر لك","cause":"وإن قبضَه","result":"غُفِرَ لهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[9],"ref":"صحيح الأدب المفرد 386","srcLabel":"البخاري","text":["ما مِن مُسلمٍ ابتلاهُ اللهُ في جَسدِه إلَّا كُتِبَ لهُ ما كان يعملُ في صِحَّتِهِ ، ما كان مَريضًا فإن عافاهُ أراه قال عسَلَه وفي روايةٍ : ",["وإن قبضَه",1]," ",["غُفِرَ لهُ",2]," ، وإن شَفاه عسَلَهُ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"حسن صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (501) واللفظ له، وابن أبي الدنيا في ((المرض والكفارات)) (178)، وابن عساكر في ((معجم الشيوخ)) (1485)","bab":"استغفار › أسباب المغفرة","dorar":"w75IBaxi"},{"id":"س-03426","fp":"8f91ecd5ed56","stateId":86,"easy":"إذا مرضت ← تُحط عنك خطاياك","cause":"فما للمَريضِ","result":"تُحَطُّ عنه خَطاياه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03318","otherNeedIds":[9],"ref":"الأحاديث المختارة 2719","text":["«أتَيْنا أنَسَ بنَ مالِكٍ رَضيَ اللهُ عنه نَعودُه، فقُلْتُ له: يا أبا حَمْزةَ، إنَّ المَكانَ بَعيدٌ، ونحن يُعجِبُنا أن نَعودَك، فرَفَعَ رَأسَه فقالَ: سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: إنَّ الَّذي يَعودُ المَريضَ يَخوضُ في الرَّحْمةِ، فإذا جَلَسَ غَمَرَتْه، فقيلَ: يا أبا حَمْزةَ، هذا للصَّحيحِ، ",["فما للمَريضِ",1],"؟ قالَ: ",["تُحَطُّ عنه خَطاياه",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"استغفار › أسباب المغفرة","dorar":"NSZmd2Hv"},{"id":"س-02273","fp":"813c63f3420a","stateId":86,"easy":"إذا مرضت ← تُحط عنك ذنوبك","cause":"فالمريضُ ما له","result":"تُحَطُّ عنه ذُنوبُه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[9],"ref":"تخريج المسند لشعيب 12782","srcLabel":"أحمد","text":["أتَيتُ أنَسَ بنَ مالِكٍ، فقُلْتُ: يا أبا حَمزَةَ، إنَّ المكانَ بَعيدٌ ونحن يُعجِبُنا أنْ نَعودَكَ، فرَفَعَ رَأْسَه فقال: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: أيُّما رَجُلٍ يَعودُ مَريضًا، فإنَّما يَخوضُ في الرَّحمةِ، فإذا قَعَدَ عندَ المريضِ غَمَرَتْه الرَّحمةُ. قال: فقُلتُ: يا رسولَ اللهِ، هذا للصَّحيحِ الذي يَعودُ المريضَ، ",["فالمريضُ ما له",1],"؟ قال: ",["تُحَطُّ عنه ذُنوبُه",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (12782) واللفظ له، والطبراني في ((المعجم الأوسط)) (8851)، والبيهقي في ((شعب الإيمان)) (9181)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Yt3kqORY"},{"id":"س-02765","fp":"cc79d6aa7cbb","stateId":86,"easy":"إذا مرضت ← يكتب الله لك أجر ما كنت تعمل في صحتك","cause":"إنَّ العَبدَ إذا مَرِضَ","result":"أوْحى اللهُ إلى مَلائكَتِه: يا مَلائكَتي، أنا قَيَّدتُ عَبدِي بَقيدٍ مِن قُيودي، فإنْ أقْبِضْه أغفِرْ له، وإنْ أُعافِه فحينَئِذٍ يَقعُدُ لا ذَنْبَ له","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[9],"ref":"المستدرك على الصحيحين 8084","srcLabel":"البيهقي","text":[["إنَّ العَبدَ إذا مَرِضَ",1]," ",["أوْحى اللهُ إلى مَلائكَتِه: يا مَلائكَتي، أنا قَيَّدتُ عَبدِي بَقيدٍ مِن قُيودي، فإنْ أقْبِضْه أغفِرْ له، وإنْ أُعافِه فحينَئِذٍ يَقعُدُ لا ذَنْبَ له",2],"."],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن أبي الدنيا في ((المرض والكفارات)) (25)، والبيهقي في ((شعب الإيمان)) (9453) بلفظه.","bab":"إيمان › الملائكة","dorar":"aGsIZf3N"},{"id":"س-03390","fp":"95acb290fcd5","stateId":86,"easy":"إذا صبرت على المرض (الحمى) ولم تطلب رفعه ← تُسقط بقية ذنوبك","cause":"وإن شئتُم تركتُموها","result":"وأسقَطتْ بقيَّةَ ذنوبِكُم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[9],"ref":"صحيح الترغيب 3443","srcLabel":"الطبراني","text":["ما شئتُم ، إن شئتُم دَعوتُ اللهَ فدفعَها عنكُم ، ",["وإن شئتُم تركتُموها",1]," ",["وأسقَطتْ بقيَّةَ ذنوبِكُم",2]," ."],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (6113) (6/246) بلفظفه وفيه قصة","bab":"استغفار › أسباب المغفرة","dorar":"9YlMEBM8"},{"id":"س-03927","fp":"a2ae7f5da7ab","stateId":87,"easy":"إذا أصابك شيء وأنت مسلم ← يكون كفارة لك","cause":"فكُلُّ ما يُصابُ به الـمُسلِمُ","result":"كَفَّارةٌ","explicit":true,"star":true,"similar":["س-03512"],"otherNeedIds":[9,45],"ref":"تخريج المسند لشعيب 7386","srcLabel":"مسلم","text":["لَمَّا نَزَلَتْ: {مَنْ يَعْمَلْ سُوءًا يُـجْزَ بِهِ} [النساء: 123] شقَّتْ على الـمُسلِمين، وبلَغَتْ منهم ما شاء اللهُ أنْ تَبْلُغَ، فشكَوْا ذلك إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقال لَـهم رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: قَارِبوا وسَدِّدوا، ",["فكُلُّ ما يُصابُ به الـمُسلِمُ",1]," ",["كَفَّارةٌ",2],"، حتَّـى النَّكْبةُ يُنْكَبُها، والشَّوْكةُ يُشاكُها."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2574)، والترمذي (3038)، وأحمد (7386) واللفظ له","bab":"تفسير آيات › سورة النساء","dorar":"tln0yGuV","merged":5,"otherRefs":["تخريج المسند لشعيب 26104 (صحيح)","تخريج المسند لشعيب 25338 (صحيح)","صحيح الترمذي 3038 (صحيح)","صحيح مسلم 2574 (صحيح)"]},{"id":"س-03505","fp":"542ccab638f2","stateId":87,"easy":"إذا أصابتك شوكة فما فوقها ← تكون كفارة لك","cause":"ما أصابَ المُؤمِنَ شَوكةٌ، فما فَوقَها -تَعني","result":"إلَّا كان كَفَّارةً له","explicit":true,"star":true,"otherNeedIds":[9],"ref":"تخريج المسند لشعيب 25676","srcLabel":"متفق عليه","text":[["ما أصابَ المُؤمِنَ شَوكةٌ، فما فَوقَها -تَعني-",1]," ",["إلَّا كان كَفَّارةً له",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5640)، ومسلم (2572) مطولاً باختلاف يسير","bab":"استغفار › مكفرات الذنوب","dorar":"xKMGJGXf","merged":3,"otherRefs":["تخريج المسند لشعيب 26208 (صحيح)","صحيح الأدب المفرد 391 (صحيح)"]},{"id":"س-03510","fp":"3100959d4fb7","stateId":87,"easy":"إذا أصابك تعب أو مرض أو حزن أو أذى ← يكفّر الله به من سيئاتك","cause":"إنَّ المُؤمِنَ لا يُصيبُه وَصَبٌ، ولا نَصَبٌ، ولا حَزَنٌ، ولا سَقَمٌ، ولا أَذًى حتى الهَمُّ يُهَمُّه","result":"إلَّا يُكفِّرُ اللهُ عنه من سيِّئاتِه","explicit":true,"star":true,"similar":["س-03545","س-03508","س-03511","س-03272"],"otherNeedIds":[9],"ref":"تخريج المسند لشعيب 11007","srcLabel":"متفق عليه","text":["\"",["إنَّ المُؤمِنَ لا يُصيبُه وَصَبٌ، ولا نَصَبٌ، ولا حَزَنٌ، ولا سَقَمٌ، ولا أَذًى حتى الهَمُّ يُهَمُّه، ",1],["إلَّا يُكفِّرُ اللهُ عنه من سيِّئاتِه\"",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5641)، ومسلم (2573)، والترمذي (966)، وأحمد (11007) واللفظ له","bab":"استغفار › مكفرات الذنوب","dorar":"w4IGPKSD","merged":3,"otherRefs":["صحيح الجامع 5725 (صحيح)","تخريج المسند لشعيب 11770 (صحيح)"]},{"id":"س-01735","fp":"11cbd8183876","stateId":87,"easy":"إذا لازمك البلاء ← يتركك وما عليك خطيئة","cause":"البَلاءُ بالعَبْدِ","result":"حتَّى يَترُكَ العَبْدَ ما عليه خَطيئةٌ","explicit":true,"similar":["س-03298"],"otherNeedIds":[9],"ref":"الأحاديث المختارة 1059","srcLabel":"البخاري","text":["«سَألْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ: أيُّ النَّاسِ أشَدُّ بَلاءً؟ قالَ: الأنْبِياءُ ثُمَّ الأمْثَلُ فالأمْثَلُ، يُبْتَلى العَبْدُ على حسَبِ دينِه، فإن كانَ صُلْبَ الدِّينِ اشْتَدَّ به البَلاءُ، وإن كانَ في دينِه رِقَّةٌ ابْتُلِيَ على حسَبِ ذلك، فما يَبرَحُ ",["البَلاءُ بالعَبْدِ",1]," ",["حتَّى يَترُكَ العَبْدَ ما عليه خَطيئةٌ",2],"»."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"أنبياء › عام","dorar":"iWDz0A1y","merged":2,"otherRefs":["صحيح ابن حبان 2920 (صحيح)"]},{"id":"س-01780","fp":"bfd663503deb","stateId":87,"easy":"إذا أصابك أذى من مرض أو غيره ← يحطّ الله به سيئاتك كما تحطّ الشجرة ورقها","cause":"ما مِن مُسلِمٍ يُصيبُه أذًى مِن مَرَضٍ فما سِواه","result":"إلَّا حَطَّ اللهُ به سَيِّئاتِه كما تَحُطُّ الشَّجَرةُ ورَقَها","explicit":true,"similar":["س-03532","س-07607"],"otherNeedIds":[9],"ref":"صحيح مسلم 2571","srcLabel":"البخاري","text":["دَخَلتُ على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم وهو يوعَكُ، فمَسِستُه بيَدي، فقُلتُ: يا رَسولَ اللهِ، إنَّكَ لَتوعَكُ وعكًا شَديدًا، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أجَل، إنِّي أوعَكُ كما يوعَكُ رَجُلانِ مِنكُم! قال: فقُلتُ: ذلك أنَّ لكَ أجرَينِ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أجَل، ثُمَّ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["ما مِن مُسلِمٍ يُصيبُه أذًى مِن مَرَضٍ فما سِواه",1]," ",["إلَّا حَطَّ اللهُ به سَيِّئاتِه كما تَحُطُّ الشَّجَرةُ ورَقَها",2],". وليسَ في حَديثِ زُهَيرٍ: فمَسِستُه بيَدي. وزادَ في حَديثِ أبي مُعاويةَ، قال: نَعَم، والذي نَفسي بيَدِه ما على الأرضِ مُسلِمٌ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5660) باختلاف يسير","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"b0Bq8DHW","merged":2,"otherRefs":["تخريج المسند لشعيب 4346 (صحيح)"]},{"id":"س-03341","fp":"a1f88fc69af7","stateId":87,"easy":"إذا أصابتك مصيبة ولو شوكة ← يكفّر الله بها عنك","cause":"ما مِن مُصيبةٍ تُصيبُ المُسلِمَ","result":"إلَّا كَفَّرَ اللهُ بها عنه، حتَّى الشَّوكةِ يُشاكُها","explicit":true,"apply":{"k":"time","t":"عند المصيبة"},"similar":["س-03270","س-03521","س-03540"],"otherNeedIds":[9],"ref":"صحيح البخاري 5640","srcLabel":"متفق عليه","text":[["ما مِن مُصيبةٍ تُصيبُ المُسلِمَ",1]," ",["إلَّا كَفَّرَ اللهُ بها عنه، حتَّى الشَّوكةِ يُشاكُها",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5640)، ومسلم (2572)","bab":"استغفار › أسباب المغفرة","dorar":"JRcOlzym","merged":2,"otherRefs":["صحيح مسلم 2572 (صحيح)"]},{"id":"س-03545","fp":"7363e400fd74","stateId":87,"easy":"إذا أصابك تعب أو مرض أو هم أو حزن أو غمّ ← يكفّر الله به من خطاياك","cause":"ما يُصيبُ المَرءَ المُسلِمَ من نَصَبٍ، ولا وَصَبٍ، ولا هَمٍّ، ولا حَزَنٍ، ولا غَمٍّ، ولا أَذًى حتى الشَّوكةُ يُشاكُها","result":"إلَّا كفَّر اللهُ عزَّ وجلَّ عنه بها من خَطاياه","explicit":true,"repOf":"س-03510","ref":"تخريج المسند لشعيب 11141","text":["\"",["ما يُصيبُ المَرءَ المُسلِمَ من نَصَبٍ، ولا وَصَبٍ، ولا هَمٍّ، ولا حَزَنٍ، ولا غَمٍّ، ولا أَذًى حتى الشَّوكةُ يُشاكُها،",1]," ",["إلَّا كفَّر اللهُ عزَّ وجلَّ عنه بها من خَطاياه\"",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (5641)، ومسلم (2573)، والترمذي (966)، وأحمد (11141) واللفظ له","bab":"استغفار › مكفرات الذنوب","dorar":"7Qyo4Mbx","merged":2,"otherRefs":["صحيح الأدب المفرد 378 (صحيح)"]},{"id":"س-07603","fp":"d6bba98751e3","stateId":87,"easy":"إذا أصابك أذى ← يحاتّ الله عنك خطاياك كما يتحاتّ ورق الشجر","cause":"ما مِن مُسلِمٍ يُصيبُه أذًى","result":"إلَّا حاتَّ اللهُ عنه خَطاياه كما تَحاتُّ ورَقُ الشَّجَرِ","explicit":true,"otherNeedIds":[9],"ref":"صحيح البخاري 5647","srcLabel":"متفق عليه","text":["أتَيتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم في مَرَضِه، وهو يوعَكُ وعكًا شَديدًا، وقُلتُ: إنَّكَ لَتُوعَكُ وعكًا شَديدًا، قُلتُ: إنَّ ذاكَ بأنَّ لكَ أجرَينِ؟ قال: أجَل، ",["ما مِن مُسلِمٍ يُصيبُه أذًى ",1],["إلَّا حاتَّ اللهُ عنه خَطاياه كما تَحاتُّ ورَقُ الشَّجَرِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5661)، ومسلم (2571)","bab":"فضائل النبي وصفته ودلائل النبوة › مرض النبي وموته","dorar":"Ux1O6ieJ","merged":2,"otherRefs":["صحيح البخاري 5661 (صحيح)"]},{"id":"س-03270","fp":"dcdf3ed5e808","stateId":87,"easy":"إذا أصابتك مصيبة ولو شوكة ← يُكفّر بها من خطاياك","cause":"لا يصيبُ المؤمنَ من مُصيبةٍ حتى الشوكةَ","result":"إلا قُصَّ بها ، أو كُفِّر من خطاياه لا يدري يزيدُ أيُّهما","explicit":true,"apply":{"k":"time","t":"عند المصيبة"},"repOf":"س-03341","ref":"الاستذكار 7/413","text":[["لا يصيبُ المؤمنَ من مُصيبةٍ حتى الشوكةَ",1]," ",["إلا قُصَّ بها ، أو كُفِّر من خطاياه لا يدري يزيدُ أيُّهما",2]," قال عروةُ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"مسند صحيح","takhrij":"أخرجه البخاري (5640) مختصراً بنحوه، ومسلم (2572) باختلاف يسير دون قوله: \"لا يدري ...\"","bab":"استغفار › أسباب المغفرة","dorar":"k6bBoCeQ"},{"id":"س-03377","fp":"f8a713e04f03","stateId":87,"easy":"إذا أصابتك شوكة فما فوقها ← يقصّ الله بها من خطيئتك","cause":"لا تُصيبُ المُؤمِنَ شَوكةٌ فما فوقَها","result":"إلَّا قَصَّ اللهُ بها مِن خَطيئَتِه","explicit":true,"similar":["س-03546","س-03548"],"ref":"صحيح مسلم 2572","srcLabel":"البخاري","text":[["لا تُصيبُ المُؤمِنَ شَوكةٌ فما فوقَها",1]," ",["إلَّا قَصَّ اللهُ بها مِن خَطيئَتِه",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5640) بنحوه","bab":"استغفار › أسباب المغفرة","dorar":"PNQCKsFr"},{"id":"س-03389","fp":"0a990a6d77df","stateId":87,"easy":"إذا أصابك وجع أو مرض ولو شوكة ← يكون كفارة لذنوبك","cause":"ما مِن مُسلِمٍ يُصابُ بِمُصيبةٍ وجعٌ أو مرضٌ","result":"إلَّا كان كفَّارةَ ذُنوبِه حتَّى الشَّوكةُ يُشاكُها ، أو النَّكْبَةُ","explicit":true,"apply":{"k":"time","t":"عند المرض والوجع"},"ref":"صحيح الأدب المفرد 383","srcLabel":"متفق عليه","text":[["ما مِن مُسلِمٍ يُصابُ بِمُصيبةٍ وجعٌ أو مرضٌ",1]," ",["إلَّا كان كفَّارةَ ذُنوبِه حتَّى الشَّوكةُ يُشاكُها ، أو النَّكْبَةُ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5640)، وفي ((الأدب المفرد)) (498) واللفظ له، ومسلم (2572)","bab":"استغفار › أسباب المغفرة","dorar":"A518JfSK"},{"id":"س-03501","fp":"a2a231714f2d","stateId":87,"easy":"إذا أصابتك شوكة في الدنيا فاحتسبتها ← يُقصّ بها من خطاياك يوم القيامة","cause":"ما مِن مؤمنٍ يُشاكُ بشَوْكةٍ في الدُّنيا، يَحتسِبُها","result":"إلَّا قُصَّ بها مِن خطاياه يَومَ القِيامةِ","explicit":true,"ref":"تخريج المسند لشعيب 9219","srcLabel":"متفق عليه","text":[["ما مِن مؤمنٍ يُشاكُ بشَوْكةٍ في الدُّنيا، يَحتسِبُها؛",1]," ",["إلَّا قُصَّ بها مِن خطاياه يَومَ القِيامةِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (9219) واللفظ له. وأخرجه بمعناه البخاري (5642) من حديث أبي هريرة رضي الله عنه، ومسلم (2573) من حديث أبي سعيد الخدري وأبي هريرة رضي الله عنهما.","bab":"استغفار › مكفرات الذنوب","dorar":"Wi2TuRT0"},{"id":"س-03506","fp":"859411a68c24","stateId":87,"easy":"إذا أصابك شيء ولو شوكة ← يُنقص من ذنوبك","cause":"ما مِن شَيءٍ يُصيبُ المُسلِمَ حتى الشَّوكةُ يُشاكُها","result":"إلَّا قصَّرَ مِن ذُنوبِه","explicit":true,"ref":"تخريج المسند لشعيب 26246","srcLabel":"متفق عليه","text":[["ما مِن شَيءٍ يُصيبُ المُسلِمَ حتى الشَّوكةُ يُشاكُها،",1]," ",["إلَّا قصَّرَ مِن ذُنوبِه",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5640)، ومسلم (2572) بلفظ مقارب","bab":"استغفار › مكفرات الذنوب","dorar":"rqXR72aS"},{"id":"س-03508","fp":"bb2da47f2af2","stateId":87,"easy":"إذا أصابك هم أو حزن أو تعب أو مرض أو أذى ← يُكفّر به عنك","cause":"لا يُصيبُ المُؤمِنَ هَمٌّ ولا حَزَنٌ، ولا نَصَبٌ، ولا وَصَبٌ، ولا أَذًى","result":"إلَّا كُفِّرَ به عنه","explicit":true,"repOf":"س-03510","otherNeedIds":[9],"ref":"تخريج المسند لشعيب 11336","text":["\"",["لا يُصيبُ المُؤمِنَ هَمٌّ ولا حَزَنٌ، ولا نَصَبٌ، ولا وَصَبٌ، ولا أَذًى،",1]," ",["إلَّا كُفِّرَ به عنه\"",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح لغيره","takhrij":"أخرجه البخاري (5641)، ومسلم (2573)، والترمذي (966)، وأحمد (11336) واللفظ له","bab":"استغفار › مكفرات الذنوب","dorar":"zhHtsWR5"},{"id":"س-03511","fp":"554a487363f5","stateId":87,"easy":"إذا أصابك مرض أو تعب أو حزن حتى الهم ← يكفّر الله به من خطاياك","cause":"ما أَصاب المُسلِمُ من مرَضٍ، ولا وَصَبٍ، ولا حَزَنٍ، حتى الهَمُّ يُهَمُّه","result":"إلَّا يُكفِّرُ اللهُ عزَّ وجلَّ عنه من خَطاياه","explicit":true,"repOf":"س-03510","ref":"تخريج المسند لشعيب 11188","text":["\"",["ما أَصاب المُسلِمُ من مرَضٍ، ولا وَصَبٍ، ولا حَزَنٍ، حتى الهَمُّ يُهَمُّه",1]," ",["إلَّا يُكفِّرُ اللهُ عزَّ وجلَّ عنه من خَطاياه\"",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح لغيره","takhrij":"أخرجه البخاري (5641)، ومسلم (2573)، والترمذي (966)، وأحمد (11188) واللفظ له","bab":"استغفار › مكفرات الذنوب","dorar":"ytAmSM1h"},{"id":"س-03512","fp":"0cc3e4a295b6","stateId":87,"easy":"إذا أصابك شيء (مما تكره) ← يكون لك أجراً وكفارة","cause":"ما أصابَ المُسلِمَ من شَيءٍ","result":"كان له أجْرًا وكَفَّارةً","explicit":true,"repOf":"س-03927","otherNeedIds":[9,45],"ref":"تخريج المسند لشعيب 24264","text":[["ما أصابَ المُسلِمَ من شَيءٍ",1]," ",["كان له أجْرًا وكَفَّارةً",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه أحمد (24264) واللفظ له، والشجري في ((الأمالي)) (2852). والحديث أخرجه من طريق آخر البخاري (5640)، ومسلم (2572) بمعناه","bab":"استغفار › مكفرات الذنوب","dorar":"XHjqW7U2"},{"id":"س-03532","fp":"2117a61df993","stateId":87,"easy":"إذا أصابك أذى من شوكة فما فوقها ← يكفّر الله بها سيئاتك كما تحطّ الشجرة ورقها","cause":"ما مِن مُسلِمٍ يُصيبُه أذًى -شَوكةٌ فما فوقَها","result":"إلَّا كَفَّرَ اللهُ بها سَيِّئاتِه، كما تَحُطُّ الشَّجَرةُ ورَقَها","explicit":true,"repOf":"س-01780","otherNeedIds":[9],"ref":"صحيح البخاري 5648","text":["دَخَلتُ على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم وهو يوعَكُ، فقُلتُ: يا رَسولَ اللهِ، إنَّكَ لَتوعَكُ وعكًا شَديدًا؟ قال: أجَلْ، إنِّي أوعَكُ كما يوعَكُ رَجُلانِ مِنكُم، قُلتُ: ذلك أنَّ لكَ أجرَينِ؟ قال: أجَل، ذلك كَذلك، ",["ما مِن مُسلِمٍ يُصيبُه أذًى -شَوكةٌ فما فوقَها- ",1],["إلَّا كَفَّرَ اللهُ بها سَيِّئاتِه، كما تَحُطُّ الشَّجَرةُ ورَقَها",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5648)، ومسلم (2571)","bab":"استغفار › مكفرات الذنوب","dorar":"kNxeNRST"},{"id":"س-03544","fp":"82973ffa0715","stateId":87,"easy":"إذا أصابتك شوكة فما فوقها ← يحطّ الله عنك خطيئة ويرفعك درجة","cause":"ما مِن مُؤمِنٍ تَشوكُه شَوْكةٌ فما فوقَها","result":"إلَّا حَطَّ اللهُ عنه خَطيئةً، ورفَعَ له بها دَرَجةً","explicit":true,"otherNeedIds":[47],"ref":"تخريج المسند لشعيب 26175","srcLabel":"متفق عليه","text":["اعتَلَجَ ناسٌ فأصابَ طُنُبُ الفُسْطاطِ عَينَ رَجُلٍ منهم فضَحِكوا، فقالَتْ عائِشةُ: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["ما مِن مُؤمِنٍ تَشوكُه شَوْكةٌ فما فوقَها",1]," ",["إلَّا حَطَّ اللهُ عنه خَطيئةً، ورفَعَ له بها دَرَجةً",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (5640)، ومسلم (2572)، والترمذي (965)، والنسائي في ((السنن الكبرى)) (7487) المرفوع منه بنحوه، وأحمد (26175) واللفظ له","bab":"استغفار › مكفرات الذنوب","dorar":"XgWhhhak"},{"id":"س-03546","fp":"316d82cfbb99","stateId":87,"easy":"إذا أصابتك شوكة فما فوقها ← تُحطّ من خطيئتك","cause":"ما من مُسلِمٍ يُشاكُ بشَوكةٍ فما فوقَها","result":"إلَّا حَطَّتْ من خَطيئَتِه","explicit":true,"repOf":"س-03377","ref":"تخريج المسند لشعيب 24114","text":[["ما من مُسلِمٍ يُشاكُ بشَوكةٍ فما فوقَها،",1]," ",["إلَّا حَطَّتْ من خَطيئَتِه",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (5640)، ومسلم (2572)، والترمذي (965)، والنسائي في ((السنن الكبرى)) (7487) بنحوه، وأحمد (24114) واللفظ له","bab":"استغفار › مكفرات الذنوب","dorar":"AdIJT8vl"},{"id":"س-06060","fp":"8c5e65303bc7","stateId":87,"easy":"إذا أُصبت في مالك أو نفسك فكتمتها ولم تشكُها للناس ← كان حقاً على الله أن يغفر لك","cause":"مَن أُصيبَ بمُصيبةٍ بمالِه، أو في نَفْسِه، فكَتَمَها ولم يَشْكُها إلى النَّاسِ","result":"كانَ حقًّا على اللهِ أن يَغفِرَ له","explicit":true,"ref":"الأحاديث المختارة 11 / 226","srcLabel":"متفق عليه","text":["«",["مَن أُصيبَ بمُصيبةٍ بمالِه، أو في نَفْسِه، فكَتَمَها ولم يَشْكُها إلى النَّاسِ، ",1],["كانَ حقًّا على اللهِ أن يَغفِرَ له»",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › فضل الصبر","dorar":"GasTRtO1"},{"id":"س-07607","fp":"3eda800c2732","stateId":87,"easy":"إذا أصابك أذى شوكة فما فوقها ← يحطّ الله عنك خطاياك كما تحطّ الشجرة ورقها","cause":"ما مِن مُسلمٍ يُصيبُه أذًى؛ شَوكةٌ فما فوقَها","result":"إلَّا حَطَّ اللهُ عزَّ وجلَّ عنه خَطاياه كما تَحُتُّ الشَّجرةُ وَرقَها","explicit":true,"repOf":"س-01780","ref":"تخريج المسند لشعيب 4205","text":["دَخَلتُ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وهو يُوعَكُ، فقُلتُ: يا رسولَ اللهِ، إنَّكَ تُوعَكُ وَعكًا شَديدًا؟! فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنِّي أُوعَكُ وَعكَ رَجُلَينِ منكم، قُلتُ: بأنَّ لك أجرَينِ؟ قال: نَعَمْ -أو أجلْ-، ثُمَّ قال: ",["ما مِن مُسلمٍ يُصيبُه أذًى؛ شَوكةٌ فما فوقَها،",1]," ",["إلَّا حَطَّ اللهُ عزَّ وجلَّ عنه خَطاياه كما تَحُتُّ الشَّجرةُ وَرقَها",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (5648)، ومسلم (2571)، والنسائي في ((السنن الكبرى)) (7483)، وأحمد (4205) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › مرض النبي وموته","dorar":"kAACgxJM"},{"id":"س-03521","fp":"84885e1ff3c6","stateId":87,"easy":"إذا أصابك شيء ولو شوكة ← يكفّر الله به عنك","cause":"وكُلُّ ما يُصيبُ المؤمنَ","result":"يُكَفِّرُ اللهُ عنه حتَّى الشَّوْكةُ تَشوكُهُ","explicit":true,"repOf":"س-03341","otherNeedIds":[9],"ref":"المستدرك على الصحيحين 191","text":["عنْ عائشةَ قالتْ: سَمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ في بَعْضِ صَلاتِهِ: «اللَّهُمَّ حاسِبْني حِسابًا يَسيرًا». فلمَّا انصَرَفَ قُلتُ: يا رسولَ اللهِ، ما الحِسابُ اليَسيُر؟ قالَ: «يُنظَرُ في كِتابِهِ ويُتَجاوَزُ عنه؛ إنَّه مَنْ نُوقِشَ الحِسابَ يَوْمَئذٍ يا عائشةُ هَلَكَ، ",["وكُلُّ ما يُصيبُ المؤمنَ",1]," ",["يُكَفِّرُ اللهُ عنه حتَّى الشَّوْكةُ تَشوكُهُ»",2],"."],"grade":"صحيح","narrator":"عائشة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أحمد (24215)، وابن خزيمة (849) بلفظه.","bab":"استغفار › مكفرات الذنوب","dorar":"dPGGB2l8","merged":2,"otherRefs":["المستدرك على الصحيحين 8953 (صحيح)"]},{"id":"س-03540","fp":"26bf211966a4","stateId":87,"easy":"إذا أصابك شيء يؤذيك في جسدك ← يكفّر الله به من سيئاتك","cause":"ما مِن شَيءٍ يُصيبُ المؤْمِنَ في جسَدِه يؤْذيهِ","result":"إلَّا كَفَّرَ اللهُ عنه به مِن سَيِّئاتِه","explicit":true,"repOf":"س-03341","ref":"تخريج المسند لشعيب 16899","text":[["ما مِن شَيءٍ يُصيبُ المؤْمِنَ في جسَدِه يؤْذيهِ،",1]," ",["إلَّا كَفَّرَ اللهُ عنه به مِن سَيِّئاتِه",2],"."],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (16899) واللفظ له، وابن أبي شيبة (10914)، وعبد بن حميد (415)","bab":"استغفار › مكفرات الذنوب","dorar":"Xz8fAMt7"},{"id":"س-03298","fp":"28179665cd65","stateId":87,"easy":"إذا لازمك البلاء ← تمشي على الأرض وما عليك خطيئة","cause":"البَلايا عن العبدِ","result":"حتى يَمشيَ في الأرضِ يعني وما عليهِ من خطيئةٍ","explicit":true,"repOf":"س-01735","otherNeedIds":[9],"ref":"تخريج المسند لشاكر 3/78","text":["يا رسولَ اللهِ أيُّ الناسِ أشدُّ بلاءً قال : الأنبياءُ ثمَّ الامثلُ فالأمثلُ حتى يُبتلى العبدُ على قدرِ دِينِه ذاك فإنْ كان صُلْبَ الدِّينِ ابتُلِيَ على قدرِ ذاك وقال مرةً : أشدُّ بلاءً وإنْ كان في دِينِهِ رِقَّةٌ ابتُلِيَ على قَدْرِ ذاك وقال مرةً : على حَسَبِ دِينِهِ قال : فما تَبرحُ ",["البَلايا عن العبدِ",1]," ",["حتى يَمشيَ في الأرضِ يعني وما عليهِ من خطيئةٍ",2]," قال أبي : وقال مرةً عن سعدٍ قال : قلتُ : يا رسولَ اللهِ"],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (1555) بلفظه، والترمذي (2398)، وابن ماجه (4023) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"wzjUHv0k","merged":9,"otherRefs":["الأحاديث المختارة 1056 (صحيح)","الأحاديث المختارة 1057 (صحيح)","الترغيب والترهيب 4/226 (صحيح)","صحيح الأدب المفرد 380 (صحيح)","تخريج المسند لشاكر 3/97 (صحيح)","تخريج المسند لشاكر 3/52 (صحيح)","السلسلة الصحيحة 2280 (صحيح)","تخريج مشكل الآثار 2207 (حسن)"]},{"id":"س-03415","fp":"da33fbe15bc1","stateId":87,"easy":"إذا ظللت تُصاب في مالك ونفسك وصبرت ← تلقى الله وليس عليك خطيئة","cause":"ما يزالُ العبدُ المؤمنُ يُصابُ في مالِه وحُشاشتِه","result":"حتَّى يلقَى اللهَ عزَّ وجلَّ وليس عليه خطيئةٌ","explicit":true,"otherNeedIds":[9],"ref":"حلية الأولياء 3/303","srcLabel":"مالك","text":[["ما يزالُ العبدُ المؤمنُ يُصابُ في مالِه وحُشاشتِه ،",1]," ",["حتَّى يلقَى اللهَ عزَّ وجلَّ وليس عليه خطيئةٌ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح ثابت","takhrij":"أخرجه مالك (1/236) بنحوه، وأبو نعيم في ((حلية الأولياء)) (3/265) واللفظ له","bab":"استغفار › أسباب المغفرة","dorar":"TnhKAIzI","merged":2,"otherRefs":["التمهيد 24/180 (صحيح)"]},{"id":"س-07919","fp":"10dbf90a2579","stateId":87,"easy":"إذا ابتلاك الله فحمدته على بلائه ← تقوم من مضجعك كيوم ولدتك أمك من الخطايا","cause":"إنِّي إذا ابتلَيْتُ عبدًا مِن عِبادي مؤمِنًا، فحَمِدَني على ما ابتَلَيْتُه","result":"فإنَّه يَقومُ مِن مَضجَعِه ذلك كيَومَ ولَدَتْهُ أُمُّه مِنَ الخَطايا","explicit":true,"otherNeedIds":[9],"ref":"تخريج المسند لشعيب 17118","srcLabel":"أحمد","text":["عن أبي الأَشْعَثِ الصَّنْعانيِّ، أنَّه راحَ إلى مَسجِدِ دِمَشْقَ وهَجَّرَ بالرَّواحِ، فلَقيَ شَدَّادَ بنَ أَوْسٍ، والصُّنابِحيُّ معه، فقلْتُ: أين تُريدانِ يَرحَمُكما اللهُ؟ قالَا: نُريدُ هاهنا إلى أخٍ لنا مريضٍ نَعودُه. فانطلَقْتُ معهما حتى دخَلَا على ذلك الرجُلِ، فقالا له: كيف أَصبَحْتَ؟ قال: أَصبَحْتُ بنعْمةٍ. فقال له شَدَّادٌ: أَبشِرْ بكَفَّاراتِ السَّيِّئاتِ، وحَطِّ الخَطايا؛ فإنِّي سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: إنَّ اللهَ عزَّ وجلَّ يقولُ: ",["إنِّي إذا ابتلَيْتُ عبدًا مِن عِبادي مؤمِنًا، فحَمِدَني على ما ابتَلَيْتُه",1],"، ",["فإنَّه يَقومُ مِن مَضجَعِه ذلك كيَومَ ولَدَتْهُ أُمُّه مِنَ الخَطايا",2],"، ويقولُ الرَّبُّ عزَّ وجلَّ: أنا قَيَّدْتُ عَبدي، وابتَلَيْتُه، فأَجْرُوا له كما كنتم تُجْرُون له وهو صحيحٌ."],"grade":"صحيح","narrator":"شداد بن أوس","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (17118) واللفظ له، والطبراني (7/279) (7136)، وأبو نعيم في ((حلية الأولياء)) (9/309)","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"Vfj4yCxg","merged":2,"otherRefs":["السلسلة الصحيحة 2009 (حسن)"]},{"id":"س-03272","fp":"6050c7aa36cb","stateId":87,"easy":"إذا أصابك هم أو تعب أو حزن ← يكفّر الله به من خطاياك","cause":"ما يصيبُ المؤمِنَ مِن همٍّ ولا نَصَبٍ ، وَلا حَزَنٍ","result":"إلَّا كَفَّر اللَّهُ به مِنْ خطاياهُ","explicit":true,"repOf":"س-03510","ref":"مدارج السالكين 2/127","text":[["ما يصيبُ المؤمِنَ مِن همٍّ ولا نَصَبٍ ، وَلا حَزَنٍ ،",1]," ",["إلَّا كَفَّر اللَّهُ به مِنْ خطاياهُ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"استغفار › أسباب المغفرة","dorar":"rqR41Dcp"},{"id":"س-03282","fp":"1c7c6163da4e","stateId":87,"easy":"إذا ابتُليت بذهاب بصرك فصبرت ← يغفر الله لك","cause":"ولن يُبتلَى عبدٌ بذهابِ بصرِه فيصبِرَ","result":"إلَّا غفر اللهُ له","explicit":true,"otherNeedIds":[9],"ref":"الترغيب والترهيب 4/237","srcLabel":"البزار","text":["لن يُبتلَى عبدٌ بشيءٍ أشدَّ عليه من الشِّركِ باللهِ ، ولن يُبتلَى عبدٌ بشيءٍ بعد الشِّركِ باللهِ أشدَّ عليه من ذهابِ بصرِه ، ",["ولن يُبتلَى عبدٌ بذهابِ بصرِه فيصبِرَ",1]," ",["إلَّا غفر اللهُ له",2]],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه البزار (4388)","bab":"استغفار › أسباب المغفرة","dorar":"R8FeLXld"},{"id":"س-03370","fp":"aba4086f7dea","stateId":87,"easy":"إذا أصابك أذى في جسدك ← يكون كفارة لخطاياك","cause":"ما من مُسلمٍ يُصيبُه أذًى من جسدِه","result":"إلَّا كان كفَّارةً لخطاياه","explicit":true,"ref":"الترغيب والترهيب 4/225","srcLabel":"أحمد","text":[["ما من مُسلمٍ يُصيبُه أذًى من جسدِه ،",1]," ",["إلَّا كان كفَّارةً لخطاياه",2]],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أحمد (16899)، وعبد بن حميد في ((المسند)) (415) بنحوه، وابن أبي الدنيا في ((المرض والكفارات)) (161) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"pV9lYnAT"},{"id":"س-03548","fp":"cb30d0e46f81","stateId":87,"easy":"إذا أصابتك نكبة فما فوقها ← يقصّ الله بها عنك خطيئة","cause":"لا يُصيبُ المُؤمِنَ نَكبةٌ فما فوقَها","result":"إلَّا قصَّ اللهُ عنه بها خَطيئةً","explicit":true,"repOf":"س-03377","ref":"تخريج مشكل الآثار 2223","text":[["لا يُصيبُ المُؤمِنَ نَكبةٌ فما فوقَها",1]," ",["إلَّا قصَّ اللهُ عنه بها خَطيئةً",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (2223) واللفظ له، وأحمد (25804)، وابن حبان (2919) بنحوه مطولًا.","bab":"استغفار › مكفرات الذنوب","dorar":"jrZZh0Qf"},{"id":"س-05954","fp":"822210dd3c36","stateId":87,"easy":"إذا مات لكما (أنت وزوجك) ثلاثة من الأولاد صغاراً ← يغفر الله لكما","cause":"ما من مُسلِميْنِ يموتُ لهما ثلاثةٌ من أولادِهما لم يَبلُغوا الحِنثَ","result":"إلَّا غفَرَ اللهُ لهما","explicit":true,"ref":"تخريج المسند لشعيب 21341","srcLabel":"أحمد","text":["أتَيْتُ أبا ذَرٍّ، قُلْتُ: ما مالُكَ؟ قال: لي عَمَلي، قُلْتُ: حَدِّثْني، قال: نَعَمْ، قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["ما من مُسلِميْنِ يموتُ لهما ثلاثةٌ من أولادِهما لم يَبلُغوا الحِنثَ،",1]," ",["إلَّا غفَرَ اللهُ لهما",2],"، قُلْتُ: حَدِّثْني قال: نَعَمْ، قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ما من مُسلِمٍ يُنفِقُ من كلِّ مالٍ له زَوجَيْنِ في سَبيلِ اللهِ، إلَّا استَقبَلَتْه حَجَبةُ الجَنَّةِ، كلُّهم يَدْعوه إلى ما عندَه، قُلْتُ: وكيف ذاك؟ قال: إنْ كانت رِجالًا فرَجُلَيْنِ، وإنْ كانت إبلًا فبَعيرَيْنِ، وإنْ كانت بقَرًا فبَقرتَيْنِ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (21341) واللفظ له، والبزار (3909)، والطبراني في ((المعجم الأوسط)) (1366) مختصراً","bab":"رقائق وزهد › الوصايا النافعة","dorar":"wbIjeduF"},{"id":"س-03315","fp":"e48a5d86dc60","stateId":87,"easy":"إذا ابتلاك الله وأنت على حال يكرهها ← يجعل البلاء كفارة لك وطهوراً","cause":"ما ابْتَلَى اللهُ عبدًا بِبَلاءٍ و هو على طَرِيقَةٍ يَكْرَهُها","result":"إلَّا جعلَ اللهُ ذلكَ البَلاءَ لهُ كَفَّارَةً و طَهورًا","explicit":true,"otherNeedIds":[9],"ref":"السلسلة الصحيحة 2500","srcLabel":"ابن أبي الدنيا","text":[["ما ابْتَلَى اللهُ عبدًا بِبَلاءٍ و هو على طَرِيقَةٍ يَكْرَهُها",1]," ، ",["إلَّا جعلَ اللهُ ذلكَ البَلاءَ لهُ كَفَّارَةً و طَهورًا",2]," ، ما لمْ يُنْزِلْ ما أَصابَهُ مِنَ البلاءِ بغيرِ اللهِ ، أوْ يَدْعُو غيرَ اللهِ في كَشْفِهِ"],"grade":"حسن","narrator":"أم سلمة","muhaddith":"قوي بالطرق","takhrij":"أخرجه ابن أبي الدنيا في ((المرض والكفارات)) (43)","bab":"استغفار › أسباب المغفرة","dorar":"ymEppiSm"},{"id":"س-03910","fp":"60b95e16abd5","stateId":87,"easy":"إذا أصابتك الحمى والحزن والنكبة ← تخرج من ذنوبك كما يخرج الذهب الأحمر من الكير","cause":"بما يصيبُهُ منَ الحمَّى والحزَنِ والنَّكبةِ","result":"حتَّى أنَّ العبدَ ليخرجُ مِن ذنوبِهِ كما يخرُجُ التِّبرُ الأحمرُ منَ الكيرِ","explicit":true,"otherNeedIds":[9],"ref":"الأمالي المطلقة 79","srcLabel":"الترمذي","text":["عَن أميَّةَ بنتِ عبدِ اللَّهِ قالت سَألتُ عائشةَ رضيَ اللَّهُ عَنها عن هذِهِ الآيةِ  مَنْ يَعْمَلْ سُوءًا يُجْزَ بِهِ  فَقالت لقد سألتِني عن شيءٍ ما سألَني عنهُ أحدٌ بعدَ أن سألتُ عنهُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ سألتُ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ يا عائشةُ هذِهِ معاتبَةُ اللَّهِ العبدَ ",["بما يصيبُهُ منَ الحمَّى والحزَنِ والنَّكبةِ",1]," حتَّى البِضاعةِ يضَعُها في كمِّهِ فيفقِدُها فيفزعُ لَها فيجِدُها تحتَ ضَبنِهِ ",["حتَّى أنَّ العبدَ ليخرجُ مِن ذنوبِهِ كما يخرُجُ التِّبرُ الأحمرُ منَ الكيرِ",2]],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"حسن","takhrij":"أخرجه الترمذي (2991)، وأحمد (25835)، والطيالسي (1689) باختلاف يسير.","bab":"تفسير آيات › سورة النساء","dorar":"418Nd3Bv"},{"id":"س-03922","fp":"a044f0cffe99","stateId":88,"easy":"إذا أصابتك نكبة أو شوكة ← تُجزى بها عن أسوأ عملك","cause":"أنَّ المُؤمِنَ تُصيبُه النَّكْبةُ أو الشَّوْكةُ","result":"فيُكافَأُ بأَسوَأِ عَمَلِه","explicit":true,"otherNeedIds":[9],"ref":"الصحيح المسند 1584","srcLabel":"متفق عليه","text":["قُلْتُ: يا رَسولَ اللهِ، إنِّي لَأَعلَمُ أَشَدَّ آيةٍ في كِتابِ اللهِ عَزَّ وجَلَّ، قالَ: «أيَّةُ آيةٍ يا عائِشةُ؟»، قالَتْ: قَوْلُ اللهِ تَعالى: {مَنْ يَعْمَلْ سُوءًا يُجْزَ بِهِ}، قالَ: «أَمَا عَلِمْتِ يا عائِشةُ ",["أنَّ المُؤمِنَ تُصيبُه النَّكْبةُ أو الشَّوْكةُ",1]," ",["فيُكافَأُ بأَسوَأِ عَمَلِه",2],"، ومَن حُوسِبَ عُذِّبَ؟»، قالَتْ: أليس اللهُ يقولُ: {فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا}، قالَ: «ذاكم العَرْضُ يا عائِشةُ، مَن نُوقِشَ الحِسابَ عُذِّبَ»."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"حسن على شرط مُسلِم","takhrij":"أخرجه أبو داود (3093) واللفظ له، والبخاري (103)، ومسلم (2876) بنحوه.","bab":"تفسير آيات › سورة النساء","dorar":"UWkx5CGr"},{"id":"ق-0577","fp":"d3ce91f96aee","stateId":88,"easy":"الصبر والعمل الصالح ← مغفرة وأجر كبير","cause":"الصبر والعمل الصالح","result":"مغفرة وأجر كبير","explicit":true,"otherNeedIds":[45],"ref":"سورة هود: 11","srcLabel":"القرآن الكريم","quran":{"s":11,"from":11,"to":11,"text":"إِلَّا الَّذِينَ صَبَرُوا وَعَمِلُوا الصَّالِحَاتِ أُولَئِكَ لَهُمْ مَغْفِرَةٌ وَأَجْرٌ كَبِيرٌ (11)","hl":[[7,51,1],[51,95,2]]}},{"id":"س-03940","fp":"079c11eda0dd","stateId":88,"easy":"إذا عملت سوءاً وأنت مؤمن ← تُجزى به في الدنيا بمصيبة في جسدك (فتُكفّر عنك)","cause":"مَنْ يَعْمَلْ سُوءًا يُجْزَ بِهِ","result":"يُجْزى به المُؤمِنونَ في الدُّنيا في مُصيبةٍ في جَسَدِه فيما يُؤذيهِ","explicit":true,"otherNeedIds":[9],"ref":"تخريج المسند لشعيب 24368","srcLabel":"أحمد","text":["أنَّ رَجُلًا تَلا هذه الآيةَ: {",["مَنْ يَعْمَلْ سُوءًا يُجْزَ بِهِ",1],"} [النساء: 123]، قال: إنَّا لَنُجْزى بكُلِّ عَمَلِنا؟! هَلَكْنا إذَنْ، فبَلَغَ ذاك رسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: نَعَمْ، ",["يُجْزى به المُؤمِنونَ في الدُّنيا في مُصيبةٍ في جَسَدِه فيما يُؤذيهِ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (24368) واللفظ له، وأبو يعلى (4675)، وابن حبان (2923)","bab":"تفسير آيات › سورة النساء","dorar":"pXV3UVkJ","merged":4,"otherRefs":["عمدة التفسير 1/577 (صحيح)","مجمع الزوائد 7/15 (صحيح)"]},{"id":"س-03431","fp":"a3f3c9d12881","stateId":88,"easy":"إذا مِتّ مسلماً ← يكون الموت كفارة لك","cause":"الموتُ","result":"كَفَّارةٌ لكُلِّ مُسلِمٍ","explicit":true,"ref":"فيض القدير 6/ 279","srcLabel":"فيض القدير","text":[["الموتُ",1]," ",["كَفَّارةٌ لكُلِّ مُسلِمٍ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","bab":"استغفار › أسباب المغفرة","dorar":"G61YEqei"},{"id":"س-03491","fp":"08605cdb623f","stateId":88,"easy":"إذا قُتلت صبراً (ظلماً وأنت مقيد) ← يكون كفارة لما قبله من ذنوبك","cause":"قتلُ الرَّجلِ صبرًا","result":"كفَّارةٌ لما قبلَهُ مِنَ الذُّنوبِ","explicit":true,"ref":"الجامع الصغير 6075","srcLabel":"البزار","text":[["قتلُ الرَّجلِ صبرًا ",1],["كفَّارةٌ لما قبلَهُ مِنَ الذُّنوبِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البزار (8994) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (4/69) باختلاف يسير","bab":"استغفار › مكفرات الذنوب","dorar":"KQUdes09"},{"id":"س-03494","fp":"21e68f508676","stateId":88,"easy":"إذا قُتلت صبراً ← لا يمر بذنب إلا محاه","cause":"قَتْلُ الصَّبْرِ","result":"لا يَمُرُّ بذنبٍ إلا مَحَاهُ","explicit":true,"otherNeedIds":[9],"ref":"الجامع الصغير 6076","srcLabel":"ابن حبان","text":[["قَتْلُ الصَّبْرِ",1]," ",["لا يَمُرُّ بذنبٍ إلا مَحَاهُ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي عاصم في ((الديات)) (ص15)، والبزار (41)، وابن حبان في ((المجروحين)) (2/107)،","bab":"استغفار › مكفرات الذنوب","dorar":"BZrDWyEk"},{"id":"س-03531","fp":"7488ca67745f","stateId":88,"easy":"إذا أصابك ما تكره في الدنيا ← فهو مما تُجزى به، ويُدّخر الخير لأهله في الآخرة","cause":"ما ترونَ مِمَّا تَكْرَهونَ","result":"فَذلكَ مِمَّا تُجْزَوْنَ بهِ ، ويُؤَخَّرُ الخَيْرُ لأهلِهِ في الآخرةِ","explicit":true,"otherNeedIds":[9],"ref":"المطالب العالية 4/182","srcLabel":"الحاكم","text":["بَينما أبو بكرٍ رضيَ اللهُ عنهُ يَتَغَدَّى مع رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ إذ أنزلَتْ هذه الآيَةُ فمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خيرًا يَرَهُ 7 ومَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُ فَأَمْسَكَ أبو بكرٍ رضيَ اللهُ عنهُ وقال : يا رسولَ اللهِ ، كلُّ ما عَمِلْنا من سُوءٍ رَأَيْناهُ ؟ فقال صلَّى اللهُ عليهِ وسلَّمَ : ",["ما ترونَ مِمَّا تَكْرَهونَ",1]," ",["فَذلكَ مِمَّا تُجْزَوْنَ بهِ ، ويُؤَخَّرُ الخَيْرُ لأهلِهِ في الآخرةِ",2]],"grade":"صحيح","narrator":"أبو أسماء الرحبي","muhaddith":"إسناده صحيح إن كان أبو أسماء سمع من أبي بكر رضي الله عنه","takhrij":"أخرجه إسحق بن راهويه كما في ((المطالب العالية)) لابن حجر (4/24) واللفظ له، والمروزي في ((مسند أبي بكر)) (113)، والحاكم (4014) باختلاف يسير","bab":"استغفار › مكفرات الذنوب","dorar":"pbsDCJyg"},{"id":"س-03944","fp":"02a049288d78","stateId":88,"easy":"إذا نصبت وحزنت وأصابتك اللأواء ← فذلك ما تُجزى به من سيئاتك","cause":"ألَستَ تَنصَبُ؟ ألَستَ تَحزَنُ؟ ألَستَ تُصيبُكَ اللَّأواءُ","result":"فهذا ما تُجزَونَ به","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[9],"ref":"تخريج المسند لشعيب 71","srcLabel":"أحمد","text":["عن أبي بَكرِ بنِ أبي زُهَيرٍ الثَّقَفيِّ، قال: لَمَّا نَزَلَت: {ليس بأمانيِّكُم ولا أمانيِّ أهلِ الكِتابِ مَن يَعمَلْ سوءًا يُجزَ به} قال: قال أبو بَكرٍ: يا رَسولَ اللهِ، إنَّا لَنُجازى بكُلِّ سوءٍ نَعمَلُه؟ فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: يَرحَمُكَ اللهُ يا أبا بَكرٍ، ",["ألَستَ تَنصَبُ؟ ألَستَ تَحزَنُ؟ ألَستَ تُصيبُكَ اللَّأواءُ",1],"؟ ",["فهذا ما تُجزَونَ به",2],"."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"صحيح","bab":"تفسير آيات › سورة النساء","dorar":"VxEEMPcH","merged":5,"otherRefs":["صحيح الترغيب 3430 (صحيح)","الترغيب والترهيب 4/231 (صحيح)","تخريج المسند لشعيب 70 (صحيح)","الفوائد العلمية من الدروس البازية 2/219 (حسن)"]},{"id":"س-03930","fp":"630b7feccf65","stateId":88,"easy":"إذا كنت مؤمناً فأصابك سوء ← تُجزى به في الدنيا حتى تلقى الله وليس عليك ذنب","cause":"أمَّا أنتَ يا أبا بَكْرٍ وأصحابُكَ المؤمِنونَ","result":"فتُجزَونَ بِهِ فيِ الدُّنيا حتَّى تَلقَوا اللَّهَ عزَّ وجلَّ وليسَت لَكُم ذنوبٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"otherNeedIds":[9],"ref":"الأمالي المطلقة 76","srcLabel":"الترمذي","text":["عن أبي بَكْرٍ الصِّدِّيقِ رضيَ اللَّهُ عنهُ قالَ كنتُ عندَ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فنزلت عليهِ هذِهِ الآيةُ مَنْ يَعْمَلْ سُوءًا يُجْزَ بِهِ فقالَ يا أبا بَكْرٍ ألا أقرئُكَ آيةً أُنْزِلَت عليَّ قلتُ بلى يا رسولَ اللَّهِ فأقرأَنيها فَما أعلمُ إلَّا أنِّي وجدتُ انقِصافًا في ظَهْري حتَّى تمطَّأتُ لَها فقُلتُ يا رسولَ اللَّهِ وأيُّنا لم يعمَل سوءً وإنَّا لَمُجزَونَ بما عمِلنا فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ",["أمَّا أنتَ يا أبا بَكْرٍ وأصحابُكَ المؤمِنونَ",1]," ",["فتُجزَونَ بِهِ فيِ الدُّنيا حتَّى تَلقَوا اللَّهَ عزَّ وجلَّ وليسَت لَكُم ذنوبٌ",2]," وأمَّا الآخرونَ فيؤخَّرُ فيُجمَعُ ذلِكَ لَهُم حتَّى يُجزَوا بِهِ يومَ القيامةِ"],"grade":"حسن","narrator":"أبو بكر الصديق","muhaddith":"حسن غريب","takhrij":"أخرجه الترمذي (3039)، وعبد بن حميد (7)، والبزار (20) باختلاف يسير","bab":"تفسير آيات › سورة النساء","dorar":"xlo7f4uu"},{"id":"س-03323","fp":"8ac2dfc67865","stateId":88,"easy":"إذا كنت مؤمناً ← تُكفّر عنك ذنوبك بما يصيبك","cause":"المؤمنُ","result":"مُكَفَّرٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[9],"ref":"صحيح الجامع 6657","srcLabel":"الحاكم","text":[["المؤمنُ",1]," ",["مُكَفَّرٌ",2],"."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"صحيح","takhrij":"أخرجه البزار (1129)، والخطابي في ((غريب الحديث)) (1/ 690)، والحاكم (192) واللفظ لهم.","bab":"استغفار › أسباب المغفرة","dorar":"mb7liSW3"},{"id":"س-03425","fp":"b6d3d9f51025","stateId":89,"easy":"إذا لقيت أخاك فأخذت بيده ← يحضر الله دعاءكما ولا يفرّق بين أيديكما حتى يغفر لكما","cause":"ما مِن مُسْلِمَينِ الْتَقَيا، فأخَذَ أحَدُهما بيَدِ صاحِبِه","result":"إلَّا كانَ حَقًّا على اللهِ أن يَحضُرَ دُعاءَهما، ولا يُفَرِّقَ بَيْنَ أيْديهما حتَّى يَغفِرَ لهما","explicit":true,"star":true,"ref":"الأحاديث المختارة 2683","srcLabel":"متفق عليه","text":["«",["ما مِن مُسْلِمَينِ الْتَقَيا، فأخَذَ أحَدُهما بيَدِ صاحِبِه،",1]," ",["إلَّا كانَ حَقًّا على اللهِ أن يَحضُرَ دُعاءَهما، ولا يُفَرِّقَ بَيْنَ أيْديهما حتَّى يَغفِرَ لهما»",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"استغفار › أسباب المغفرة","dorar":"jmSeK2ZG"},{"id":"س-03492","fp":"9c2a0d9e3e48","stateId":89,"easy":"إذا لقيت أخاك فتصافحتما وحمدتما الله واستغفرتماه ← تفترقان وليس بينكما خطيئة","cause":"أيُّما مُسلمَيْنِ الْتقيا، فأخذَ أحدُهما بيدِ صاحبِه . فتصافحا، و حمدا اللهَ تعالى جميعًا","result":"تفرقا و ليسَ بينهما خطيئةٌ","explicit":true,"similar":["س-02813"],"ref":"الجامع الصغير 2962","srcLabel":"البخاري","text":[["أيُّما مُسلمَيْنِ الْتقيا،  فأخذَ أحدُهما بيدِ صاحبِه . فتصافحا،  و حمدا اللهَ تعالى جميعًا",1],"،  ",["تفرقا و ليسَ بينهما خطيئةٌ",2]],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح","takhrij":"أخرجه أحمد (18594)، والبخاري في ((التاريخ الكبير)) (11/ 73)، والخطيب البغدادي في ((المتفق والمفترق)) (1702)، والحاكم في ((الأسامي والكنى)) (1/ 38) جميعهم بلفظه.","bab":"استغفار › مكفرات الذنوب","dorar":"DhaMkZYr"},{"id":"س-00126","fp":"e727c54fc26b","stateId":89,"easy":"إذا لقيت أخاك فصافحته ← تتساقط ذنوبكما كما يتساقط ورق الشجر","cause":"إذا التقى المسلمانِ فتصافحا","result":"تحاتَت عنهما ذنوبُهما كما يتحاتُّ عن الشجرةِ اليابسةِ ورقُها","explicit":true,"similar":["س-01926","س-03392","س-03394","س-03432"],"ref":"مجموع فتاوى ابن باز 433/11","srcLabel":"البيهقي","text":[["إذا التقى المسلمانِ فتصافحا ",1],["تحاتَت عنهما ذنوبُهما كما يتحاتُّ عن الشجرةِ اليابسةِ ورقُها",2]],"grade":"صحيح","narrator":"[البراء بن عازب]","muhaddith":"[ثابت]","takhrij":"أخرجه بنحوه الخرائطي في ((مكارم الأخلاق)) (857)، والبيهقي في ((شعب الإيمان)) (8954).","bab":"آداب السلام › إفشاء السلام","dorar":"Cc7x1sVG"},{"id":"س-00133","fp":"46efe065cbbd","stateId":89,"easy":"إذا لقيت أخاك فصافحته وحمدتما الله واستغفرتماه ← يُغفر لكما","cause":"إذا التَقَى المُسلِمانِ، فتَصافَحا، وحَمِدَا اللهَ عزَّ وجلَّ واستَغْفَراهُ","result":"غُفِرَ لهما","explicit":true,"ref":"تخريج سنن أبي داود 5211","srcLabel":"أبو داود","text":[["إذا التَقَى المُسلِمانِ، فتَصافَحا، وحَمِدَا اللهَ عزَّ وجلَّ واستَغْفَراهُ، ",1],["غُفِرَ لهما",2],"."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح لغيره دون قوله: \"وحمدا الله عز وجل\"","takhrij":"أخرجه أبو داود (5211)، وأبو يعلى (1673)، وأبو داود الطيالسي (787)، ابن وهب في ((الجامع)) (185) جميعهم بلفظه.","bab":"آداب السلام › إفشاء السلام","dorar":"63nGfXOa"},{"id":"س-01926","fp":"147173585ce2","stateId":89,"easy":"إذا لقيت أخاك فتصافحتما ← تتساقط ذنوبكما كما يتساقط ورق الشجر","cause":"ما من مسلِمَينِ يتلاقيانِ فيتصافحانِ","result":"إلا تحاتَتْ عنهما ذنوبُهما كما يتحاتُّ عن الشجرةِ ورَقُها","explicit":true,"repOf":"س-00126","ref":"مجموع فتاوى ابن باز 200/11","text":[["ما من مسلِمَينِ يتلاقيانِ فيتصافحانِ",1]," ",["إلا تحاتَتْ عنهما ذنوبُهما كما يتحاتُّ عن الشجرةِ ورَقُها",2]],"grade":"صحيح","muhaddith":"[ثابت]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"9jqioeom"},{"id":"س-02813","fp":"2fb803448834","stateId":89,"easy":"إذا لقيت أخاك فتصافحتما ← يُغفر لكما قبل أن تفترقا","cause":"ما من مُسْلِمَيْنِ يَلْتَقِيانِ فَيَتَصافَحانِ","result":"إلَّا غُفِرَ لهُما قبلَ أنْ يَفْتَرِقَا","explicit":true,"repOf":"س-03492","ref":"صحيح الترغيب 2718","text":[["ما من مُسْلِمَيْنِ يَلْتَقِيانِ فَيَتَصافَحانِ ؛",1]," ",["إلَّا غُفِرَ لهُما قبلَ أنْ يَفْتَرِقَا ",2],"."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (5212) والترمذي (2727) وابن ماجه (3703)، وأحمد (18547)","bab":"إيمان › الوعد","dorar":"jOVG1juD"},{"id":"س-03317","fp":"1a75d84b9ea5","stateId":89,"easy":"إذا تصافحت مع أخيك المسلم ← لا تفترق أيديكما حتى يُغفر لكما","cause":"إذا تصافحَ المُسلمانِ لَم تَفْرُقْ أكُفُّهُما","result":"حتَّى يُغْفَرَ لهُما","explicit":true,"ref":"صحيح الجامع 433","srcLabel":"الطبراني","text":[["إذا تصافحَ المُسلمانِ لَم تَفْرُقْ أكُفُّهُما ",1],["حتَّى يُغْفَرَ لهُما",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (8/336) (8076)","bab":"استغفار › أسباب المغفرة","dorar":"lzR4VFBk"},{"id":"س-03392","fp":"4ab059260ced","stateId":89,"easy":"إذا لقيت أخاك فسلّمت عليه وصافحته ← تتناثر خطاياكما كما يتناثر ورق الشجر","cause":"إنَّ المؤمنَ إذا لقي المؤمنَ فسلَّم عليه ، وأخذ بيدِه فصافحَه","result":"تناثرت خطاياهما كما يتناثرُ ورقُ الشجرِ","explicit":true,"repOf":"س-00126","ref":"صحيح الترغيب 2720","text":[["إنَّ المؤمنَ إذا لقي المؤمنَ فسلَّم عليه ، وأخذ بيدِه فصافحَه ؛ ",1],["تناثرت خطاياهما كما يتناثرُ ورقُ الشجرِ ",2],"."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني في ((الأوسط)) (245) واللفظ له، والبيهقي في ((شعب الإيمان)) (8551) بنحوه، وابن وهب في ((الجامع)) (182).","bab":"استغفار › أسباب المغفرة","dorar":"B6wfyMcV"},{"id":"س-03394","fp":"3ae12f829e05","stateId":89,"easy":"إذا صافحت أخاك ← تتحاتّ خطاياكما كما يتحاتّ ورق الشجر","cause":"إنَّ المسلمَ إذا صافح أخاه","result":"تحاتَّتْ خطاياهما كما يتحاتُّ وَرَقُ الشجرِ","explicit":true,"repOf":"س-00126","ref":"صحيح الترغيب 2721","text":[["إنَّ المسلمَ إذا صافح أخاه ",1],["تحاتَّتْ خطاياهما كما يتحاتُّ وَرَقُ الشجرِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه البزار (8335) واللفظ له.","bab":"استغفار › أسباب المغفرة","dorar":"3fAycZB1"},{"id":"س-03432","fp":"730b527dbf51","stateId":89,"easy":"إذا لقيت أخاك فأخذت بيده ← تتحاتّ ذنوبكما كما يتحاتّ ورق الشجرة اليابسة","cause":"إنَّ المُسلِمَ إذا لقيَ أخاهُ المُسلِمَ فأخَذَ بيَدِه","result":"تَحاتَّت عَنهما ذُنوبُهما كما تَحاتُّ الورَقُ عَن الشَّجَرةِ اليابِسةِ في يَومِ ريحٍ عاصِفٍ، وإلَّا غُفِرَ لهُما ذُنوبُهما ولَو كانت مِثلَ زَبَدِ البَحرِ","explicit":true,"repOf":"س-00126","ref":"مجموع الشروح الفقهية. 139/30","text":[["إنَّ المُسلِمَ إذا لقيَ أخاهُ المُسلِمَ فأخَذَ بيَدِه ",1],["تَحاتَّت عَنهما ذُنوبُهما كما تَحاتُّ الورَقُ عَن الشَّجَرةِ اليابِسةِ في يَومِ ريحٍ عاصِفٍ، وإلَّا غُفِرَ لهُما ذُنوبُهما ولَو كانت مِثلَ زَبَدِ البَحرِ",2],"."],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"إسناده صحيح رجاله كلهم ثقات معروفون","takhrij":"أخرجه الطبراني (6/ 256) (6150)، والبيهقي في ((شعب الإيمان)) (8549) واللفظ لهما.","bab":"استغفار › أسباب المغفرة","dorar":"GKhajhzB"},{"id":"س-04713","fp":"087d5080ff17","stateId":89,"easy":"إذا لقيت أخاك فسلّمت عليه وأخذت بيده لله ← لا تفترقان حتى يُغفر لكما","cause":"ما مِنْ مسلِمَينِ يلتقيانِ فيُسَلِّمُ أحدُهما على صاحِبِهِ ، ويأخُذُ بيدِهِ ، لا يأخذُ بيدِهِ","result":"إلَّا للهِ ، فلا يفْتَرِقانِ حتى يُغْفَرَ لهما","explicit":true,"ref":"صحيح الجامع 5778","srcLabel":"أبو داود","text":[["ما مِنْ مسلِمَينِ يلتقيانِ فيُسَلِّمُ أحدُهما على صاحِبِهِ ، ويأخُذُ بيدِهِ ، لا يأخذُ بيدِهِ",1]," ",["إلَّا للهِ ، فلا يفْتَرِقانِ حتى يُغْفَرَ لهما",2]],"grade":"حسن","narrator":"البراء بن عازب","muhaddith":"حسن","takhrij":"أخرجه أبو داود (5212) والترمذي (2727) وابن ماجه (3703)، وأحمد (18547) باختلاف يسير","bab":"رقائق وزهد › الإخلاص","dorar":"ZgBQdXPk"},{"id":"س-00257","fp":"04c367bc44ec","stateId":90,"easy":"إذا تجاوزت عن المعسر ← يتجاوز الله عنك","cause":"كان رجُلٌ تاجرٌ يُدايِنُ النَّاسَ فإذا رأى إعسارَ المُعسِرِ قال لفتاه: تجاوَزْ لعلَّ اللهَ يتجاوَزُ عنَّا","result":"فلقي اللهَ فتجاوَز عنه","explicit":true,"star":true,"similar":["س-03794","س-02147","س-02155"],"ref":"تخريج صحيح ابن حبان 5042","srcLabel":"متفق عليه","text":[["كان رجُلٌ تاجرٌ يُدايِنُ النَّاسَ فإذا رأى إعسارَ المُعسِرِ قال لفتاه: تجاوَزْ لعلَّ اللهَ يتجاوَزُ عنَّا",1]," ) قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( ",["فلقي اللهَ فتجاوَز عنه",2]," )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (2078)، ومسلم (1562) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"ydzMRtP2","merged":2,"otherRefs":["صحيح النسائي 4709 (صحيح)"]},{"id":"س-03794","fp":"9e25bccdb7d3","stateId":90,"easy":"إذا تجاوزت عن المعسر رجاء أن يتجاوز الله عنك ← يتجاوز الله عنك","cause":"إذا أتَيتَ مُعسِرًا فتَجاوَزْ عنه؛ لَعَلَّ اللهَ أن يَتَجاوزَ عَنَّا، قال","result":"فلَقيَ اللهَ فتَجاوزَ عنه","explicit":true,"repOf":"س-00257","ref":"صحيح البخاري 3480","text":["كان الرَّجُلُ يُدايِنُ النَّاسَ، فكان يقولُ لفَتاه: ",["إذا أتَيتَ مُعسِرًا فتَجاوَزْ عنه؛ لَعَلَّ اللهَ أن يَتَجاوزَ عَنَّا، قال: ",1],["فلَقيَ اللهَ فتَجاوزَ عنه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3480)، ومسلم (1562)","bab":"بر وصلة › التجاوز والعفو وترك المكافأة","dorar":"Mofr932l"},{"id":"س-01885","fp":"79b21caad192","stateId":90,"easy":"إذا أنظرت المعسر ← يغفر الله لك","cause":"كُنتُ أُبايِعُ النَّاسَ، فكُنتُ أُنظِرُ المُعسِرَ","result":"فغُفِرَ له","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح مسلم 1560","srcLabel":"البخاري","text":["أنَّ رَجُلًا ماتَ فدَخَلَ الجَنَّةَ، فقيلَ له: ما كُنتَ تَعمَلُ؟ قال: فإمَّا ذَكَرَ وإمَّا ذُكِّرَ، فقال: إنِّي ",["كُنتُ أُبايِعُ النَّاسَ، فكُنتُ أُنظِرُ المُعسِرَ",1],"، وأتَجَوَّزُ في السِّكَّةِ، أو في النَّقدِ، ",["فغُفِرَ له",2],". فقال أبو مَسعودٍ: وأنا سَمِعتُه مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم."],"grade":"صحيح","narrator":"حذيفة بن اليمان [وأبو مسعود الأنصاري]","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2391) باختلاف يسير من حديث حذيفة بن اليمان رضي الله عنه","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"7tkuJS2E","merged":4,"otherRefs":["صحيح ابن ماجه 1979 (صحيح)","صحيح البخاري 2391 (صحيح)","تخريج مشكل الآثار 5536 (صحيح)"]},{"id":"س-03360","fp":"f2925e2a5780","stateId":90,"easy":"إذا كنت سهلاً إذا بعت واشتريت واقتضيت ← يغفر الله لك","cause":"كان سهْلًا إذا باع ، سهْلًا إذا اشترى ، سهْلًا إذا اقْتَضى","result":"غفر اللهُ لرجُلٍ مِمَّنْ كان قبْلَكُمْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[67],"ref":"صحيح الجامع 4162","srcLabel":"البخاري","text":[["غفر اللهُ لرجُلٍ مِمَّنْ كان قبْلَكُمْ",2]," ، ",["كان سهْلًا إذا باع ، سهْلًا إذا اشترى ، سهْلًا إذا اقْتَضى",1]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1320)، وأحمد (14658) باختلاف يسير، وأخرجه البخاري (2076) بلفظ مقارب","bab":"استغفار › أسباب المغفرة","dorar":"rd6WEsQ9","merged":3,"otherRefs":["الأمالي المطلقة 189 (حسن)","تخريج المسند لشاكر 11/160 (صحيح)"]},{"id":"س-03486","fp":"e765b4430ff5","stateId":90,"easy":"إذا كنت تتجاوز عن الناس ← يتجاوز الله عنك","cause":"كان يَتَجاوَزُ عنِ النَّاسِ","result":"تَجاوَزا عنه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج مشكل الآثار 5535","srcLabel":"البخاري","text":["نظَرَ اللهُ في عمَلِ رَجلٍ فلم يوجَدْ له شيءٌ إلَّا أنَّه ",["كان يَتَجاوَزُ عنِ النَّاسِ",1],"، فقال اللهُ عزَّ وجلَّ: ",["تَجاوَزا عنه",2],"."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"إسناده صحيح على شرط البخاري.","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (5535) واللفظ له.","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"chQEKY9y"},{"id":"س-02128","fp":"7cc00215c395","stateId":90,"easy":"إذا أقلت مسلماً (قبلت رجوعه في البيع) ← يقيلك الله عثرتك","cause":"مَن أقالَ مُسلِمًا","result":"أقالَه اللهُ عَثرَتَه","explicit":true,"similar":["س-00301","س-00303","س-02158","س-02188"],"ref":"تخريج سنن أبي داود 3460","srcLabel":"ابن ماجه","text":["قال: قال رَسولُ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ: ",["مَن أقالَ مُسلِمًا، ",1],["أقالَه اللهُ عَثرَتَه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (2199) مطولاً باختلاف يسير، وعبدالله بن أحمد في ((زوائد المسند)) (7431) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"DshenD9k","merged":2,"otherRefs":["صحيح الترغيب 1758 (صحيح)"]},{"id":"س-00301","fp":"b83c19bf640c","stateId":90,"easy":"إذا أقلت أحداً عثرته (قبلت فسخ بيعه) ← يقيلك الله يوم القيامة","cause":"مَن أَقالَ عَثْرَةً","result":"أَقالَه اللهُ يَوْمَ القِيامةِ","explicit":true,"repOf":"س-02128","ref":"تخريج المسند لشعيب 7431","text":[["مَن أَقالَ عَثْرَةً ",1],["أَقالَه اللهُ يَوْمَ القِيامةِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (3460)، وابن ماجه (2199) بنحوه، وعبدالله بن أحمد في ((زوائد المسند)) (7431) واللفظ له","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"jVYHLfrt"},{"id":"س-00303","fp":"77c21e4f26ea","stateId":90,"easy":"إذا أقلت مسلماً عثرته ← يقيلك الله عثرتك يوم القيامة","cause":"مَن أقالَ مُسلِمًا عَثَرَتَه","result":"أقالَه اللهُ عزَّ وجَلَّ يومَ القيامةِ","explicit":true,"repOf":"س-02128","ref":"تخريج سير أعلام النبلاء 9/32","text":[["مَن أقالَ مُسلِمًا عَثَرَتَه، ",1],["أقالَه اللهُ عزَّ وجَلَّ يومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه البيهقي (11461) واللفظ له، وأخرجه أبو داود (3460) مختصراً باختلاف يسير، وابن ماجه (2199) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"zLB0yhXl"},{"id":"س-02147","fp":"2696ce70b1b3","stateId":90,"easy":"إذا وجدت معسراً فتجاوزت عنه ← يتجاوز الله عنك","cause":"ومَنْ وجَدْتُموه مُعسِرًا، فتَجاوَزوا عنه","result":"أنا أَحَقُّ أنْ أَتجاوَزَ عنه","explicit":true,"repOf":"س-00257","ref":"المستدرك على الصحيحين 2260","text":["عَنْ أَبِي مَسعودٍ البَدريِّ قالَ: حُوسِبَ رَجلٌ، فلمْ يُوجدْ له خيرٌ، وكان ذا مالٍ، وكان يُدايِنُ النَّاسَ، وكان يقولُ لغِلمانِه: مَنْ وَجَدْتُموه غَنيًّا، فخُذوا منه، ",["ومَنْ وجَدْتُموه مُعسِرًا، فتَجاوَزوا عنه",1],"؛ لعلَّ اللهَ يَتَجاوزُ عنِّي، فقالَ اللهُ: ",["أنا أَحَقُّ أنْ أَتجاوَزَ عنه",2],"."],"grade":"صحيح","narrator":"أبو وائل","muhaddith":"إسناده صحيح على شرط الشيخين","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"5EMo8LZA"},{"id":"س-02158","fp":"3028c2c678f2","stateId":90,"easy":"إذا أقلت مسلماً بيعته ← يقيل الله عثرتك","cause":"مَن أقالَ مسلِمًا بيعتَهُ","result":"أقال اللَّهُ عَثرتَهُ","explicit":true,"repOf":"س-02128","ref":"بلوغ المرام 240","text":[["مَن أقالَ مسلِمًا بيعتَهُ ",1],["أقال اللَّهُ عَثرتَهُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3460)، وابن ماجه (2199)، وعبدالله بن أحمد في ((زوائد مسند أحمد)) (7431) باختلاف يسير، وابن حبان كما في ((موارد الظمآن)) للهيثمي (1104) مطولاً واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"YTiH4NFA"},{"id":"س-02182","fp":"18844bd5d4bb","stateId":90,"easy":"إذا أقلت أخاك صفقة كرهها ← يقيل الله عثرتك يوم القيامة","cause":"مَن أقالَ أخاهُ المُسْلِمَ صفقةً كرِهَها","result":"أقالَ اللَّهُ عثرتَهُ يومَ القيامةِ","explicit":true,"ref":"هداية الرواة 2812","srcLabel":"أبو داود","text":[["مَن أقالَ أخاهُ المُسْلِمَ صفقةً كرِهَها ؛ ",1],["أقالَ اللَّهُ عثرتَهُ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3460)، وابن ماجه (2199)، وعبدالله بن أحمد في ((زوائد مسند أحمد)) (7431) مختصراً","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"HBmCxH2x"},{"id":"س-02188","fp":"f2ce8bf4bf9f","stateId":90,"easy":"إذا أقلت نادماً ← يقيل الله عثرتك يوم القيامة","cause":"مَن أقال نادِمًا","result":"أقال اللهُ عَثرَتَه يومَ القيامَةِ","explicit":true,"repOf":"س-02128","ref":"السيل الجرار 3/139","text":[["مَن أقال نادِمًا ،",1]," وفي لفظٍ: مُسلِمًا ، ",["أقال اللهُ عَثرَتَه يومَ القيامَةِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صححه جماعة من الحفاظ","takhrij":"أخرجه البزار (8967) واللفظ له، والعقيلي في ((الضعفاء الكبير)) (1/106)، وابن حبان (5029).\nواللفظ: أخرجه أبو داود (3460)، وابن ماجه (2199) واللفظ له، وعبدالله بن أحمد في ((زوائد مسند أحمد)) (7431)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"NaNrvDPU"},{"id":"س-02155","fp":"e548b13f92a4","stateId":90,"easy":"إذا تجاوزت عن المعسر ← يتجاوز الله عنك","cause":"كان تاجِرٌ يُدايِنُ النَّاسَ، فإذا رَأى مُعسِرًا قال لفِتيانِه: تَجاوزوا عنه","result":"لَعَلَّ اللهَ أن يَتَجاوزَ عَنَّا، فتَجاوزَ اللهُ عنه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-00257","ref":"صحيح البخاري 2078","text":[["كان تاجِرٌ يُدايِنُ النَّاسَ، فإذا رَأى مُعسِرًا قال لفِتيانِه: تَجاوزوا عنه",1],"؛ ",["لَعَلَّ اللهَ أن يَتَجاوزَ عَنَّا، فتَجاوزَ اللهُ عنه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2078) واللفظ له، ومسلم (1562)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"VIBpFCEP"},{"id":"س-00464","fp":"db34b2553b1b","stateId":91,"easy":"إذا سقيت حيواناً عطشاناً ← يشكر الله لك ويغفر لك","cause":"فَسَقَى الكَلْبَ","result":"فَشَكَرَ اللَّهُ له فَغَفَرَ له","explicit":true,"star":true,"similar":["س-02194"],"otherNeedIds":[23],"ref":"المحلى 9/208","srcLabel":"متفق عليه","text":["في كلِّ ذي كبدٍ رطبةٍ أجرٌ [يعني حديث: بيْنَا رَجُلٌ بطَرِيقٍ، اشْتَدَّ عليه العَطَشُ، فَوَجَدَ بئْرًا، فَنَزَلَ فِيهَا، فَشَرِبَ ثُمَّ خَرَجَ، فَإِذَا كَلْبٌ يَلْهَثُ، يَأْكُلُ الثَّرَى مِنَ العَطَشِ، فَقالَ الرَّجُلُ: لقَدْ بَلَغَ هذا الكَلْبَ مِنَ العَطَشِ مِثْلُ الذي كانَ بَلَغَ مِنِّي، فَنَزَلَ البِئْرَ فَمَلَا خُفَّهُ مَاءً، ",["فَسَقَى الكَلْبَ",1],"، ",["فَشَكَرَ اللَّهُ له فَغَفَرَ له",2],"، قالوا: يا رَسُولَ اللَّهِ، وإنَّ لَنَا في البَهَائِمِ لَأَجْرًا؟ فَقالَ: في كُلِّ ذَاتِ كَبِدٍ رَطْبَةٍ أَجْرٌ.]"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"احتج به ، وقال في المقدمة: (لم نحتج إلا بخبر صحيح من رواية الثقات مسند)","takhrij":"أخرجه البيهقي في ((الآداب)) (34) مطولاً واللفظ له، وأخرجه البخاري (2363)، ومسلم (2244) مطولاً باختلاف يسير","bab":"آداب عامة › الرفق بالحيوان والطير ونحوهما","dorar":"NWMKxrXm","merged":4,"otherRefs":["غاية المرام 149 (صحيح)","غاية المرام 476 (صحيح)","صحيح البخاري 2363 (صحيح)"]},{"id":"س-03483","fp":"125365d095e7","stateId":91,"easy":"إذا أزلت غصن شوك من طريق الناس ← يغفر الله لك ويدخلك الجنة","cause":"وجَدَ غُصنَ شَوكٍ، فقال: لَأرفَعَنَّ هذا؛ لعَلَّ اللهَ عزَّ وجلَّ يَغفِرُ لي به، فرفَعَه","result":"فغفَرَ اللهُ له به، وأدخَلَهُ الجنَّةَ","explicit":true,"similar":["س-06087","س-04531"],"otherNeedIds":[67],"ref":"تخريج المسند لشعيب 10289","srcLabel":"متفق عليه","text":["بَينَما رَجُلٌ يَمشي على طَريقٍ ",["وجَدَ غُصنَ شَوكٍ، فقال: لَأرفَعَنَّ هذا؛ لعَلَّ اللهَ عزَّ وجلَّ يَغفِرُ لي به، فرفَعَه",1],"، ",["فغفَرَ اللهُ له به، وأدخَلَهُ الجنَّةَ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (652)، ومسلم (1914) باختلاف يسير","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"rISF5YLt"},{"id":"س-06087","fp":"5dccdc860cf7","stateId":91,"easy":"إذا أزلت غصن شوك من طريق الناس ← يُغفر لك ذنبك","cause":"أخَذ غُصْنَ شوكٍ عن طريقِ النَّاسِ","result":"غُفِر لرجُلٍ - أخَذ غُصْنَ شوكٍ عن طريقِ النَّاسِ - ذنبُه، ما تقدَّم مِن ذنبِه وما تأخَّر","explicit":true,"repOf":"س-03483","ref":"النكت على كتاب ابن الصلاح 1 / 273","text":["حديثٌ في غُفرانِ ما تقدَّمَ وتأخَّرَ [يعني حديث: ",["غُفِر لرجُلٍ - أخَذ غُصْنَ شوكٍ عن طريقِ النَّاسِ - ذنبُه، ما تقدَّم مِن ذنبِه وما تأخَّر",2]," ]"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"[صحيح]","takhrij":"أخرجه ابن حبان (539) واللفظ له، والبخاري (652)، ومسلم _1914) بنحوه.","bab":"رقائق وزهد › ما جاء في فعل الخير","dorar":"1ltmgKRZ"},{"id":"س-04531","fp":"55e7bad86579","stateId":91,"easy":"إذا أزلت غصن شوك عن الطريق ← يشكر الله لك ويغفر لك","cause":"وجَدَ غُصنَ شَوكٍ على الطَّريقِ فأخَّرَه","result":"فشَكَرَ اللهُ له فغَفَرَ له","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-03483","ref":"صحيح البخاري 652","text":["بينَما رَجُلٌ يَمشي بطَريقٍ ",["وجَدَ غُصنَ شَوكٍ على الطَّريقِ فأخَّرَه",1],"، ",["فشَكَرَ اللهُ له فغَفَرَ له",2],". ثُمَّ قال: الشُّهَداءُ خَمسةٌ: المَطعونُ، والمَبطونُ، والغَريقُ، وصاحِبُ الهَدمِ، والشَّهيدُ في سَبيلِ اللهِ، وقال: لو يَعلَمُ النَّاسُ ما في النِّداءِ والصَّفِّ الأوَّلِ، ثُمَّ لَم يَجِدوا إلَّا أن يَستَهِموا لاستَهَموا عليه. ولو يَعلَمونَ ما في التَّهجيرِ لاستَبَقوا إليه، ولو يَعلَمونَ ما في العَتَمةِ والصُّبحِ لَأتَوْهما ولو حَبوًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (652)، ومسلم (1914)","bab":"جهاد › فضل الشهيد","dorar":"DuXuhGJL","merged":5,"otherRefs":["تخريج صحيح ابن حبان 538 (صحيح)","تخريج المسند لشعيب 9669 (صحيح)","تخريج المسند لشعيب 7841 (صحيح)","تخريج المسند لشعيب 7847 (صحيح)"]},{"id":"س-03361","fp":"4fac776d0454","stateId":91,"easy":"إذا سقيت كلباً يلهث عطشاً ← يغفر الله لك ولو كنت مذنباً","cause":"فنَزَعَت خُفَّها، فأوثَقَتْه بخِمارِها، فنَزَعَت له مِنَ الماءِ","result":"غُفِرَ لامرَأةٍ مومِسةٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح البخاري 3321","srcLabel":"متفق عليه","text":[["غُفِرَ لامرَأةٍ مومِسةٍ",2]," مَرَّت بكَلبٍ على رَأسِ رَكيٍّ يَلهَثُ، قال: كادَ يَقتُلُه العَطَشُ، ",["فنَزَعَت خُفَّها، فأوثَقَتْه بخِمارِها، فنَزَعَت له مِنَ الماءِ",1],"، فغُفِرَ لَها بذلك."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3321)، ومسلم (2245)","bab":"استغفار › أسباب المغفرة","dorar":"R5lEwkfB","merged":3,"otherRefs":["صحيح مسلم 2245 (صحيح)"]},{"id":"س-02194","fp":"186fa37d7674","stateId":91,"easy":"إذا سقيت حيواناً عطشان ← يشكر الله لك ويغفر لك، وفي كل كبد رطبة أجر","cause":"فسقاهُ الرَّجلُ","result":"فشكرَ اللهَ له ذلك ، وغفرَ له بذلك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-00464","otherNeedIds":[23],"ref":"الاستذكار 7/507","text":["في الكلبِ الَّذي كان يلهثُ عطشًا ، ",["فسقاهُ الرَّجلُ",1]," ، ",["فشكرَ اللهَ له ذلك ، وغفرَ له بذلك",2]," ، وقال : في كلِّ كبدٍ رَطبةٍ أجْرٌ"],"grade":"صحيح","muhaddith":"صحيح","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"5qHbKzes"},{"id":"س-02115","fp":"5ef81ff2dc3c","stateId":91,"easy":"إذا أزلت الأذى عن طريق المسلمين ← يغفر الله لك","cause":"لَأُميطَنَّ هذا الشوكَ عَنِ الطريقِ ألَّا يَعقِرَ رجُلًا مُسلِمًا","result":"فغُفِرَ له","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"تخريج المسند لشعيب 8498","srcLabel":"متفق عليه","text":["مَرَّ رجُلٌ مِنَ المسلمينَ بجِذْلِ شَوْكٍ في الطريقِ، فقالَ: ",["لَأُميطَنَّ هذا الشوكَ عَنِ الطريقِ ألَّا يَعقِرَ رجُلًا مُسلِمًا",1],"، قال: ",["فغُفِرَ له",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (652)، ومسلم (1914)، وأبو داود (5245)، والترمذي (1958) بنحوه، وأحمد (8498) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"NE1JkIsi","merged":2,"otherRefs":["صحيح الأدب المفرد 169 (صحيح)"]},{"id":"س-05094","fp":"b045e362ee8e","stateId":92,"easy":"إذا كنت أسبق المتخاصمين إلى الصلح ← يكون سبقك كفارة لك","cause":"وأوَّلُهما فَيئًا","result":"فسَبْقُهُ بالفَيءِ كفَّارَتُهُ","explicit":true,"star":true,"otherNeedIds":[41],"ref":"تخريج المسند لشعيب 16257","srcLabel":"مسلم","text":["لا يَحِلُّ لِمُسلِمٍ أنْ يَهجُرَ مُسلِمًا فَوقَ ثَلاثِ ليالٍ، فإنْ كان تَصارَما فَوقَ ثَلاثٍ؛ فإنَّهما ناكِبانِ عن الحَقِّ ما داما على صُرامِهما، ",["وأوَّلُهما فَيئًا",1]," ",["فسَبْقُهُ بالفَيءِ كفَّارَتُهُ",2],"، فإنْ سلَّمَ عليه فلم يَرُدَّ عليهِ، ورَدَّ عليه سَلامَهُ؛ رَدَّتْ عليه المَلائكةُ، ورَدَّ على الآخَرِ الشَّيطانُ، فإنْ ماتا على صُرامِهما لم يَجتَمِعا في الجنَّةِ أبَدًا."],"grade":"صحيح","narrator":"هشام بن عامر","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (16257) واللفظ له، والطيالسي (1319)، وأبو يعلى (1557)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"lxjagY10","merged":4,"otherRefs":["صحيح الأدب المفرد 311 (صحيح)","الزواجر عن اقتراف الكبائر 2/42 (صحيح)","تخريج صحيح ابن حبان 5664 (صحيح)"]},{"id":"س-03565","fp":"832bc64f00f0","stateId":92,"easy":"إذا كنت البادئ بالرجوع عن الهجر ← يكون رجوعك كفارة لك","cause":"مَن بَدَأَ منهما بالرُّجوعِ عن ذلك","result":"كانتْ كَفَّارةً له","explicit":true,"ref":"تخريج العواصم والقواصم 9/ 103","srcLabel":"أحمد","text":["[في المتهاجِريْنِ، وأنَّ ",["مَن بَدَأَ منهما بالرُّجوعِ عن ذلك",1]," ",["كانتْ كَفَّارةً له",2],"]."],"grade":"صحيح","narrator":"هشام بن عامر","muhaddith":"حديث صحيح","takhrij":"الحديث أخرجه أحمد (16257)، والطيالسي (1319)، وأبو يعلى (1557)","bab":"استغفار › مكفرات الذنوب","dorar":"NxRdtn4B"},{"id":"س-07262","fp":"aed1ba69a40a","stateId":92,"easy":"إذا غسّلت ميتاً فأديت الأمانة وسترت ما ترى ← تخرج من ذنوبك كيوم ولدتك أمك","cause":"مَن غَسَّلَ مَيِّتًا فأدَّى فيه الأمانةَ وسَتَرَ ما يكونُ عنْدَ ذلك","result":"كانَ مِن ذُنوبِه كيَوْمَ وَلَدَتْه أمُّه","explicit":true,"ref":"الأحكام الوسطى 2/124","srcLabel":"أحمد","text":[["مَن غَسَّلَ مَيِّتًا فأدَّى فيه الأمانةَ وسَتَرَ ما يكونُ عنْدَ ذلك، ",1],["كانَ مِن ذُنوبِه كيَوْمَ وَلَدَتْه أمُّه",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أحمد (24881)، والطبرني في ((المعجم الأوسط)) واللفظ لهما، والبيهقي (6737) باختلاف يسير","bab":"غسل › التستر في الغسل","dorar":"4A2jL4KF"},{"id":"س-02499","fp":"ae11c46889b5","stateId":92,"easy":"إذا بادرت أخاك المهاجر بالصلح ← تُكفّر ذنوبك","cause":"وأيما بدا صاحبَه","result":"كُفِّرتْ ذنوبُه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الترغيب 2759","srcLabel":"البخاري","text":["لا يحلُّ أن يصطَرِما ما فوق ثلاثٍ فإن اصطَرما فوقَ ثلاثٍ لم يجتمِعا في الجنةِ أبدًا ",["وأيما بدا صاحبَه",1]," ",["كُفِّرتْ ذنوبُه",2]," وإن هو سلَّمَ فلم يَرُدَّ عليه ولم يقبلْ سلامَه ردَّ عليه الملَكُ وردَّ على ذلك الشيطانُ"],"grade":"صحيح","narrator":"هشام بن عامر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (16257)، والبخاري في ((الأدب المفرد)) (402)، والطيالسي (1319) واللفظ لهم.","bab":"إيمان › أعمال الجن والشياطين","dorar":"qPO5hRqk"},{"id":"س-03529","fp":"b61d8c6379aa","stateId":93,"easy":"إذا جُرحت فعفوت عن الجرح ← يكفّر الله عنك بمثل ما عفوت","cause":"مَن جُرِحَ في جَسَدِه جِراحةً فتَصَدَّقَ بها","result":"كَفَّرَ اللهُ عَزَّ وجَلَّ عنه بمِثلِ ما تَصدَّقَ به","explicit":true,"star":true,"similar":["س-03336"],"ref":"الأحاديث المختارة 8 / 299","srcLabel":"متفق عليه","text":["(«",["مَن جُرِحَ في جَسَدِه جِراحةً فتَصَدَّقَ بها، ",1],["كَفَّرَ اللهُ عَزَّ وجَلَّ عنه بمِثلِ ما تَصدَّقَ به»)",2],"."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"استغفار › مكفرات الذنوب","dorar":"mbX7fkXf"},{"id":"ق-0163","fp":"fef330ecb56a","stateId":93,"easy":"الإنفاق في السراء والضراء وكظم الغيظ والعفو عن الناس ← مغفرة وجنة عرضها السماوات والأرض ومحبة الله","cause":"الإنفاق في السراء والضراء وكظم الغيظ والعفو عن الناس","result":"مغفرة وجنة عرضها السماوات والأرض ومحبة الله","explicit":true,"star":true,"otherNeedIds":[67,23],"ref":"سورة آل عمران: 133–134","srcLabel":"القرآن الكريم","quran":{"s":3,"from":133,"to":134,"text":"وَسَارِعُوا إِلَى مَغْفِرَةٍ مِنْ رَبِّكُمْ وَجَنَّةٍ عَرْضُهَا السَّمَاوَاتُ وَالْأَرْضُ أُعِدَّتْ لِلْمُتَّقِينَ (133) الَّذِينَ يُنْفِقُونَ فِي السَّرَّاءِ وَالضَّرَّاءِ وَالْكَاظِمِينَ الْغَيْظَ وَالْعَافِينَ عَنِ النَّاسِ وَاللَّهُ يُحِبُّ الْمُحْسِنِينَ (134)","hl":[[0,18,1],[18,114,2],[114,227,1],[227,244,2],[244,259,1]]}},{"id":"ق-0271","fp":"90b12d8cf38b","stateId":93,"easy":"إبداء الخير أو إخفاؤه والعفو عن السوء ← عفو الله","cause":"إبداء الخير أو إخفاؤه والعفو عن السوء","result":"عفو الله","explicit":true,"star":true,"ref":"سورة النساء: 149","srcLabel":"القرآن الكريم","quran":{"s":4,"from":149,"to":149,"text":"إِنْ تُبْدُوا خَيْرًا أَوْ تُخْفُوهُ أَوْ تَعْفُوا عَنْ سُوءٍ فَإِنَّ اللَّهَ كَانَ عَفُوًّا قَدِيرًا (149)","hl":[[0,62,1],[62,101,2]]}},{"id":"ق-0309","fp":"79af1f6a7216","stateId":93,"easy":"التصدق بالقصاص (العفو) ← كفارة له","cause":"التصدق بالقصاص (العفو)","result":"كفارة له","explicit":true,"ref":"سورة المائدة: 45","srcLabel":"القرآن الكريم","quran":{"s":5,"from":45,"to":45,"text":"وَكَتَبْنَا عَلَيْهِمْ فِيهَا أَنَّ النَّفْسَ بِالنَّفْسِ وَالْعَيْنَ بِالْعَيْنِ وَالْأَنْفَ بِالْأَنْفِ وَالْأُذُنَ بِالْأُذُنِ وَالسِّنَّ بِالسِّنِّ وَالْجُرُوحَ قِصَاصٌ فَمَنْ تَصَدَّقَ بِهِ فَهُوَ كَفَّارَةٌ لَهُ وَمَنْ لَمْ يَحْكُمْ بِمَا أَنْزَلَ اللَّهُ فَأُولَئِكَ هُمُ الظَّالِمُونَ (45)","hl":[[173,195,1],[195,217,2],[217,218,1]]}},{"id":"ق-0852","fp":"04d1f277ec04","stateId":93,"easy":"العفو والصفح ← مغفرة الله","cause":"العفو والصفح","result":"مغفرة الله","explicit":true,"similar":["ق-1345","س-07731"],"ref":"سورة النور: 22","srcLabel":"القرآن الكريم","quran":{"s":24,"from":22,"to":22,"text":"وَلَا يَأْتَلِ أُولُو الْفَضْلِ مِنْكُمْ وَالسَّعَةِ أَنْ يُؤْتُوا أُولِي الْقُرْبَى وَالْمَسَاكِينَ وَالْمُهَاجِرِينَ فِي سَبِيلِ اللَّهِ وَلْيَعْفُوا وَلْيَصْفَحُوا أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللَّهُ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ (22)","hl":[[139,167,1],[167,212,2]]}},{"id":"ق-1345","fp":"06b53e9724d4","stateId":93,"easy":"العفو والصفح والمغفرة عن الأهل ← مغفرة الله ورحمته","cause":"العفو والصفح والمغفرة عن الأهل","result":"مغفرة الله ورحمته","explicit":true,"repOf":"ق-0852","otherNeedIds":[37],"ref":"سورة التغابن: 14","quran":{"s":64,"from":14,"to":14,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنَّ مِنْ أَزْوَاجِكُمْ وَأَوْلَادِكُمْ عَدُوًّا لَكُمْ فَاحْذَرُوهُمْ وَإِنْ تَعْفُوا وَتَصْفَحُوا وَتَغْفِرُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ (14)","hl":[[103,145,1],[145,176,2]]}},{"id":"س-07731","fp":"cc26c00ba1e7","stateId":93,"easy":"إذا عفوت وصفحت ← يغفر الله لك","cause":"وَلْيَعْفُوا وَلْيَصْفَحُوا","result":"أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللهُ لَكُمْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0852","otherNeedIds":[37],"ref":"مجمع الزوائد 9/235","text":["كان النَّبيُّ صلَّى اللهُ عليه وسلَّم إذا أراد أن يُسافِرَ أقرَع بينَ نسائِه فأيَّتُهنَّ خرَج سهمُها خرَج بها معه فخرَج سهمُ عائشةَ في غزوةِ النَّبيِّ صلَّى اللهُ عليه وسلَّم بني المُصْطَلِقِ مِن خُزاعةَ فلمَّا انصرَف رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فكان قريبًا مِنَ المدينةِ وكانت عائشةُ جُوَيريَةً حديثةَ السِّنِّ قليلةَ اللَّحمِ خفيفةً وكانت تلزَمُ خِدرَها فإذا أراد النَّاسُ الرَّحيلَ ذهَبَتْ ثمَّ رجَعَتْ فدخَلَتْ مِحَفَّتَها فيُرَحَّلُ بعيرُها ثمَّ تُحْمَلُ مِحَفَّتُها فتوضَعُ على البَعيرِ فكان أوَّلَ ما قال فيها المنافقون وغيرُهم ممَّنِ اشترَك في أمرِ عائشةَ إنَّها خرجَتْ تتوضَّأُ حينَ دنَوا مِنَ المدينةِ فانسَلَّ مِن عُنُقِها عِقْدٌ لها مِن جَزْعِ أظْفَارٍ فارتحَل رسولُ اللهِ صلَّى اللهُ عليه وسلَّم والنَّاسُ وهي في بُغاءِ العِقدِ ولم تعلَمْ برحيلِهم فشدُّوا على بعيرِها المِحَفَّةَ وهم يُرَوْنَ أنَّها فيها كما كانت تكونُ فرجَعَتْ عائشةُ إلى منزلِها فلم تجِدْ في العَسْكَرِ أحدًا فغلَبَتْها عيناها وكان صَفْوانُ بنُ المُعَطَّلِ السُّلَمِيُّ صاحبُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم تخلَّف تلك اللَّيلةَ عَنِ العَسْكَرِ حتَّى أصبَح قالت فمرَّ بي فرآني فاسترجَع وأعظَمَ مكاني حينَ رآني وقد كنْتُ أعرِفُه ويعرِفُني قبلَ أن يُضرَبَ علينا الحِجابُ قالت فسألني عن أمري فستَرْتُ وجهي عنه بجِلْبابي وأخبَرْتُه بأمري فقرَّب بعيرَه فوَطِئَ على ذِراعِه فولَّاني قفاه حتَّى رَكِبْتُ وسوَّيْتُ ثيابي ثمَّ بعَثَه فأقبَل يسيرُ بي حتَّى دخَلْنا المدينةَ نِصفَ النَّهارِ أو نحوَه فهنالك قال فيَّ وفيه مَن قال مِن أهلِ الإفكِ وأنا لا أعلَمُ شيئًا مِن ذلك ولا ممَّا يخوضُ النَّاسُ فيه مِن أمري وكنْتُ تلك اللَّياليَ شاكيةً وكان أوَّلَ ما أنكَرْتُ مِن أمرِ النَّبيِّ صلَّى اللهُ عليه وسلَّم أنَّه كان يعودُني قبلَ ذلك إذا مرِضْتُ وكان تلك اللَّياليَ لا يدخُلُ عليَّ ولا يعودُني إلَّا أنَّه كان يقولُ وهو مارٌّ كيف تِيكُمْ فيسألُ عنِّي أهلَ البيتِ فلمَّا بلَغ النَّبيَّ صلَّى اللهُ عليه وسلَّم ما أكثَرَ النَّاسُ فيه مِن أمري غمَّه ذلك وقد شكَوْتُ قَبلَ ذلك إلى أمِّي ما رأيْتُ مِنَ النَّبيِّ صلَّى اللهُ عليه وسلَّم مِن الجَفْوةِ فقالت لي يا بُنَيَّةُ اصبِري فواللهِ ما كانتِ امرأةٌ حَسْناءُ لها ضرائرُ إلَّا رمَيْنها قالت فوجَدْتُ حِسًّا تلك اللَّيلةَ الَّتي بعَث النَّبيُّ صلَّى اللهُ عليه وسلَّم مِن صُبحِها إلى عليِّ بنِ أبي طالبٍ وأسامةَ بنِ زيدٍ يستشيرُهما في أمري وكنَّا ذلك الزَّمانَ ليس لنا كُنُفٌ نذهَبُ فيها إنَّما كنَّا نذهَبُ كما يذهَبُ العربُ ليلًا إلى ليلٍ فقلْتُ لأمِّ مِسْطَحِ بنِ أُثاثةَ خُذي الإداوةَ فامْلَئيها ماءً فاذهَبي بها إلى المَناصِعِ وكانت هي وابنُها مِسْطَحٌ بينَهما وبينَ أبي بكرٍ قَرابةٌ وكان أبو بكرٍ يُنفِقُ عليهما فكانا يكونان عندَه ومع أهلِه فأخَذَتِ الإداوةَ وخرَجَتْ نحوَ المَناصِعِ فعثَرَتْ أمُّ مِسْطَحٍ فقالت تعِسَ مِسْطَحٌ فقلْتُ بئسَ ما قلْتِ قالت ثمَّ مشَيْنا فعثَرَتْ أيضًا فقالت تعِسَ مِسْطَحٌ فقلْتُ لها بئسَ ما قلْتِ لصاحبِ النَّبيِّ صلَّى اللهُ عليه وسلَّم وصاحبِ بَدْرٍ فقالت إنَّكِ لَغافلةٌ عمَّا فيه النَّاسُ مِن أمرِك فقلْتُ أجَلْ فما ذاك فقالت إنَّ مِسْطَحًا وفلانًا وفُلانةً فيمن استَزَلَّهُمُ الشَّيطانُ مِنَ المنافقين يجتمِعون في بيتِ عبدِ اللهِ بنِ أُبَيِّ بنِ سَلولٍ أخي بني الحارثِ بنِ الخزرجِ يتحدَّثون عنكِ وعن صَفْوانَ بنِ المُعَطَّلِ يَرْمونكِ به قالت فذهَب عنِّي ما كنْتُ أجِدُ مِنَ الغائطِ فرَجَعْتُ على يدَيَّ فلمَّا أصبَحْنا مِن تلك اللَّيلةِ بعَث النَّبيُّ صلَّى اللهُ عليه وسلَّم إلى عليِّ بنِ أبي طالبٍ وأسامةَ بنِ زيدٍ فأخبرَهما بما قيل فيَّ واستشارَهما في أمري فقال أسامةُ واللهِ يا رسولَ اللهِ ما علِمْنا على أهلِك سوءًا وقال عليٌّ له يا رسولَ اللهِ ما أكثَرَ النِّساءَ وإنْ أرَدْتَ أن تعلَمَ الخبرَ فتوعَّدِ الجاريةَ يعني بَريرةَ فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم لعليٍّ فشأنُك بالخادمِ فسَأَلَها عليٌّ عنِّي فلم تُخْبِرْه والحمدُ للهِ إلَّا بخيرٍ قالت واللهِ ما عَلِمْتُ على عائشةَ سوءًا إلَّا أنَّها جُوَيريَةٌ تُصبِحُ عن عجينِ أهلِها فتدخُلُ الشَّاةُ الدَّاجِنُ فتأكُلُ مِنَ العجينِ قالت ثمَّ خرَج النَّبيُّ صلَّى اللهُ عليه وسلَّم حينَ سمِعَ ما قالت بَريرةُ لِعَليٍّ إلى النَّاسِ فلمَّا اجتمَعوا إليه قال يا معشرَ المسلمين مَن لي مِن رجالٍ يُؤذونَني في أهلي فما علِمْتُ على أهلي سوءًا ويَرْمون رجُلًا مِن أصحابي ما علِمْتُ عليه سوءًا ولا خرَجْتُ مَخْرجًا إلَّا خرَج معي فيه قال سعدُ بنُ معاذٍ الأنصاريُّ الأشْهَلِيُّ مِنَ الأوسِ يا رسولَ اللهِ إنْ كان ذلك مِن أحَدٍ مِنَ الأوسِ كَفَيْنَاكَهُ وإنْ كان مِنَ الخزرجِ أمَرْتَنا فيه بأمرِك وقام سعدُ بنُ عُبادةَ الأنصاريُّ ثمَّ الخَزْرَجِيُّ فقال لسعدِ بنِ معاذٍ كذَبْتَ واللهِ وهذا الباطلُ فقام أُسَيدُ بنُ حُضَيرٍ الأنصاريُّ ثمَّ الأشْهَلِيُّ ورجالٌ مِنَ الفريقين فاستبُّوا وتنازَعوا حتَّى كاد أن يعظُمَ الأمرُ بينَهم فدخَل النَّبيُّ صلَّى اللهُ عليه وسلَّم بيتي وبعَث إلى أبويَّ فأتَياه فحمِد اللهَ وأثنى عليه بما هو أهلُه ثمَّ قال لي يا عائشةُ إنَّما أنتِ مِن بناتِ آدمَ فإنْ كنْتِ أخطأْتِ فتوبي إلى اللهِ واستَغْفِريه فقلْتُ لأبي أجِبْ عنِّي رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فقال لا أفعَلُ هو نبيُّ اللهِ والوحيُ يأتيه فقلْتُ لأمِّي أجيبي عنِّي رسولَ اللهِ صلَّى اللهُ عليه وسلَّم فقالت لي كما قال أبي فقلْتُ واللهِ لئن أقْرَرْتُ على نفسي بباطلٍ لتُصَدِّقُنَّني ولئن برَّأْتُ نفسي واللهُ يعلَمُ أنِّي بريئةٌ لتُكَذِّبُنَّني فما أجِدُ لي ولكم مَثَلًا إلَّا قولَ أبي يوسفَ { فَصَبْرٌ جَمِيلٌ وَاللهُ المُسْتَعانُ عَلَى مَا تَصِفُونَ } ونَسيتُ اسمَ يعقوبَ لِما بي مِنَ الحُزنِ والبُكاءِ واحتراقِ الجوفِ فتغشَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ما كان يتغشَّاه مِنَ الوحيِ ثمَّ سُرِّيَ عنه فمسَح وجهَه بيدِه ثمَّ قال أبْشِري يا عائشةُ قد أنزَل اللهُ عزَّ وجلَّ براءتَك فقالت عائشةُ واللهِ ما كنْتُ أظُنُّ أن ينزِلَ القرآنُ في أمري ولكنِّي كنْتُ أرجو لِما يعلَمُ اللهُ مِن براءتي أن يرى النَّبيُّ صلَّى اللهُ عليه وسلَّم في أمري رؤيا فيُبَرِّئَني اللهُ بها عندَ نبيِّه صلَّى اللهُ عليه وسلَّم فقال لي أبوايَ عندَ ذلك قومي فقبِّلي رأسَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقلْتُ واللهِ لا أفعَلُ بحمدِ اللهِ لا بحَمْدِكم قال وكان أبو بكرٍ يُنفِقُ على مِسْطَحٍ وأمِّه فلمَّا رماني حلَف أبو بكرٍ أن لا ينفَعَه بشيءٍ أبدًا قال فلمَّا تلا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم { ",["وَلْيَعْفُوا وَلْيَصْفَحُوا",1]," ",["أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللهُ لَكُمْ",2]," } بكى أبو بكرٍ قال بلى يا ربِّ وأعاد النَّفقةَ على مِسْطَحٍ وأمِّه قالت وقعَد صَفْوانُ بنُ المُعَطَّلِ لحسَّانَ بنِ ثابتٍ بالسَّيفِ فضرَبه ضربةً فقال صَفْوانُ لحسَّانَ حينَ ضرَبَه تَلَقَّ ذُبَابَ السَّيْفِ عَنْكَ فَإِنَّنِي ... غُلَامٌ إِذَا هُوجِيتُ لَسْتُ بِشَاعِرِ\nوَلَكِنَّنِي أَحْمِي حِمَايَ وأَنْتَقِمْ ... مِنَ الْبَاهِتِ الرَّامِي الْبُرَاةِ الطَّوَاهِرِ. ثمَّ صاح حسَّانُ فاستغاث النَّاسُ على صَفْوانَ فلمَّا جاء النَّاسُ فرَّ صَفْوانُ فجاء حسَّانُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم فاستَعْداه على صَفْوانَ في ضَرْبتِه إيَّاه فسألَه النَّبيُّ صلَّى اللهُ عليه وسلَّم أن يهَبَ له ضربةَ صَفْوانَ إيَّاه فوهَبها للنَّبيِّ صلَّى اللهُ عليه وسلَّم فعاوَضَه النَّبيُّ صلَّى اللهُ عليه وسلَّم حائطًا مِن نخلٍ عظيمٍ وجاريةٍ روميَّةٍ ويُقالُ قِبطيَّةٌ تُدعى سِيرينَ فولَدَتْ لحسَّانَ ابنَه عبدَ الرَّحمنِ الشَّاعرَ قال أبو أُوَيسٍ أخبَرَني بذلك حُسَينُ بنُ عبدِ اللهِ بنِ عُبيدِ اللهِ بنِ عبَّاسٍ عَن عِكرمةَ عنِ ابنِ عبَّاسٍ قالت عائشةُ ثمَّ باع حسَّانُ ذلك الحائطَ مِن معاويةَ بنِ أبي سفيانَ في ولايتِه بمالٍ عظيمٍ قالت عائشةُ رضِيَ اللهُ عنها وبلَغَني واللهِ أعلمُ أنَّ الَّذي قال اللهُ فيه { والَّذِي تَوَلَّى كِبْرَهُ مِنْهُمْ لَهُ عَذَابٌ عَظِيمٌ } أنَّه عبدُ اللهِ بنُ أُبَيِّ بنِ سَلولٍ أحدُ بني الحارثِ بن ِالخزرجِ قالت عائشةُ فقيل في أصحابِ الإفكِ الأشعارُ وقال أبو بكرٍ في مِسْطَحٍ في رَمْيِه عائشةَ فكان يُدعى عَوفًا يَا عَوْفُ وَيْحَكَ هَلَّا قُلْتَ عَارِفَةً ... مِنَ الْكَلَامِ وَلَمْ تَبْغِي بِهِ طَمَعَا\nفَأَدْرَكَتْكَ حُمَيَّا مَعْشَرٍ أُنُفٍ ... فَلَمْ يَكُنْ قَاطِعًا يَا عَوْفُ مَنْ قَطَعَا\nهَلَّا حَرِبْتَ مِنَ الْأَقْوَامِ إِذْ حَسَدُوا ... فَلَا تَقُولُ وَإِنْ عَادَيْتَهُمْ قَذَعَا\nلَمَّا رَمَيْتَ حَصَانًا غَيْرَ مُقْرِفَةٍ ... أَمِينَةَ الْجَيْبِ لَمْ نَعْلَمْ لَهَا خَضَعَا\nفِيمَنْ رَمَاهَا وَكُنْتُمْ مَعْشَرًا أُفُكًا ... فِي سَيِّئِ الْقَوْلِ مِنْ لَفْظِ الْخَنَا شَرَعَا\nفَأَنْزَلَ اللَّهُ عُذْرًا فِي بَرَاءَتِهَا ... وَبَيْنَ عَوْفٍ وَبَيْنَ اللَّهِ مَا صَنَعَا\nفَإِنْ أَعِشْ أَجْزِ عَوْفًا فِي مَقَالَتِهِ ... سُوءَ الْجَزَاءِ بِمَا أَلْفَيْتُهُ تَبَعَا. وقالَت أمُّ سعدِ بنِ معاذٍ في الَّذين رمَوا عائشةَ مِنَ الشِّعرِ تَشْهَدُ الْأَوْسُ كُلُّهَا وَفَتَاهَا ... بِحِقْدٍ وَذَلِكَ مَعْلُومُ\nنِسَاءُ الْخَزْرَجِيِّينَ يَشْهَدْنَ ... وَالْخُمَاسِيُّ مِنْ نَسْلِهَا وَالْعَظِيمُ\nأَنَّ بِنْتَ الصِّدِّيقِ كَانَتْ حَصَانًا ... عَفَّةَ الْجَيْبِ دِينُهَا مُسْتَقِيمُ\nتَتَّقِي اللَّهَ فِي الْمَغِيبِ عَلَيْهَا ... نِعْمَةُ اللَّهِ سِرُّهَا مَا يَرِيمُ\nخَيْرُ هَدْيِ النِّسَاءِ حَالًا وَنَفْسًا ... وَأَبًا لِلْعُلَا نَمَاهَا كَرِيمُ\nلِلْمَوَالِي إِذَا رَمَوهَا بِإِفْكٍ ... أَخَذَتْهُمْ مَقَامِعٌ وَجَحِيمُ\nلَيْتَ مَنْ كَانَ قَدْ قَفَاهَا بِسُوءٍ ... فِي حُطَامٍ حَتَّى يَبُولَ اللَّئِيمُ\nوَعَوَانٍ مِنَ الْحُرُوبِ تَلَظَّى ... ثَغْسًا قُوتُهَا عَقَارٌ صَرِيمُ\nلَيْتَ سَعْدًا وَمَنْ رَمَاهَا بِسُوءٍ ... فِي كَظَاظٍ حَتَّى يَتُوبَ الظَّلُومُ.\nوقال حسَّانُ وهو يُبَرِّئُ عائشةَ - رَضِيَ اللَّهُ عنها - فيما قيل فيها، ويعتذِرُ إليها:\nحَصَانٌ رَزَانٌ مَا تُزَنُّ بِرِيبَةٍ ... وَتُصْبِحُ غَرْثَى مِنْ لُحُومِ الْغَوَافِلِ\nخَلِيلَةُ خَيْرِ النَّاسِ دِينًا وَمَنْصِبًا ... نَبِيِّ الْهُدَى وَالْمَكْرُمَاتِ الْفَوَاضِلِ\nعَقِيلَةُ حَيٍّ مِنْ لُؤَيِّ بْنِ غَالِبٍ ... كِرَامِ الْمَسَاعِي مَجْدُهَا غَيْرُ زَائِلِ\nمُهَذَّبَةٌ قَدْ طَيَّبَ اللَّهُ خِيَمَهَا ... وَطَهَّرَهَا مِنْ كُلٍّ سُوءٍ وَبَاطِلِ\nفَإِنْ كَانَ مَا قَدْ جَاءَ عَنِّي قُلْتُهُ ... فَلَا رَفَعَتْ صَوْتِي إِلَىَّ أَنَامِلِي\nوَإِنَّ الَّذِي قَدْ قِيلَ لَيْسَ بِلَائِطٍ ... بِكِ الدَّهْرَ بَلْ قَوْلُ امْرِئٍ غَيْرِ هَائِلِ\nوَكَيْفَ وَوُدِّي مَا حَيِيتُ وَنُصْرَتِي ... لِآلِ رَسُولِ اللَّهِ زَيْنِ الْمَحَافِلِ\nلَهُ رَتْبٌ عَالٍ عَلَى النَّاسِ فَضْلُهَا ... تَقَاصَرُ عَنْهَا سَوْرَةُ الْمُتَطَاوِلِ.قال أبو يونسَ وحدَّثَني أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم أمَر بالَّذين رمَوا عائشةَ فجُلِدوا الحدَّ ثمانين وقال حسَّانُ بنُ ثابتٍ في الشِّعرِ حين جُلِدوا لَقَدْ ذَاقَ عَبْدُ اللَّهِ مَا كَانَ أَهْلَهُ ... وَحَمْنَةُ إِذْ قَالُوا هَجِيرًا وَمِسْطَحُ\nتَعَاطَوْا بِرَجْمِ الْغَيْبِ زَوْجَ نَبِيِّهِمْ ... وَسَخْطَةَ ذِي الْعَرْشِ الْكَرِيمِ فَأَنْزَحُوا\nفَآذَوْا رَسُولَ اللَّهِ فِيهَا وَعَمَّمُوا ... مَخَازِيَ سُوءٍ حَلَّلُوهَا وَفُضِّحُوا"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"رجاله رجال الصحيح إلا أن بعض هذا يخالف ما في الصحيح","takhrij":"أخرجه الطبراني (23/111) (151) واللفظ له، وأخرجه البخاري (4141)، ومسلم (2770) بلفظ مقارب","bab":"قرآن › أسباب النزول","dorar":"IoBb5HZx"},{"id":"س-04260","fp":"f989a58c2d26","stateId":93,"easy":"إذا عفوت عن قاتل وليّك ← يبوء القاتل بإثمه وإثم المقتول","cause":"إن عفوتَ عنهُ","result":"يُبوءُ بإثمِهِ وإثمِ صاحبِكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[45],"ref":"صحيح النسائي 5430","srcLabel":"مسلم","text":["شَهِدْتُ رسولَ اللَّهِ حينَ جاءَ بالقاتِلِ يقودُهُ وليُّ المقتولِ في نسعَه فقالَ رسولُ اللَّهِ لوليِّ المقتولِ : أتَعفو قالَ : لا قالَ : فتأخذُ الدِّيةَ قالَ : لا قالَ : فتقتلُهُ قالَ : نعَم قالَ : اذهَب بِهِ فلمَّا ذَهَبَ فولَّى من عندِهِ دعاهُ فقالَ : أتَعفو قالَ : لا قالَ : فتأخذُ الدِّيةَ قالَ : لا قالَ : فتقتلُهُ قالَ : نعَم قالَ : اذهَب بِهِ فلمَّا ذَهَبَ فولَّى من عندِهِ دعاهُ فقالَ : أتَعفو قالَ : لا قالَ : فتأخذُ الدِّيةَ قالَ : لا قالَ : فتقتلُهُ قالَ : نعَم قالَ : اذهَب بِهِ فقالَ رسولُ اللَّهِ عندَ ذلِكَ : أما إنَّكَ ",["إن عفوتَ عنهُ",1]," ",["يُبوءُ بإثمِهِ وإثمِ صاحبِكَ",2]],"grade":"صحيح","narrator":"وائل بن حجر","muhaddith":"صحيح","takhrij":"أخرجه النسائي (4724) بلفظه مطولًا، وأبو داود (4499)، والدارمي (2359) كلاهما باختلاف يسير مطولًا، وأصله في مسلم (1680) دون ذكر ((الدية))","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"pnrPdzZR","merged":2,"otherRefs":["تخريج مشكل الآثار 945 (صحيح)"]},{"id":"س-03265","fp":"33a43d05d010","stateId":93,"easy":"إذا تصدقت بشيء من جسدك (عفوت عن جناية عليك) ← تُعطى بقدر ما تصدقت","cause":"مَنْ تَصَدَّقَ بشيءٍ مِنْ جَسَدِهِ","result":"أُعْطِىَ بقدْرِ ما تَصَدَّقَ","explicit":true,"ref":"صحيح الجامع 6151","srcLabel":"أحمد","text":[["مَنْ تَصَدَّقَ بشيءٍ مِنْ جَسَدِهِ ، ",1],["أُعْطِىَ بقدْرِ ما تَصَدَّقَ",2]],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح","takhrij":"أخرجه الطبراني كما في ((مجمع الزوائد)) (6/305) واللفظ له، وأخرجه عبدالله بن أحمد في ((زوائد المسند)) (22794) باختلاف يسير، والبيهقي (16480) بنحوه مطولاً","bab":"استغفار › أسباب المغفرة","dorar":"WQYBUaLX"},{"id":"س-03336","fp":"88099d4ba79c","stateId":93,"easy":"إذا جُرحت فعفوت (تصدقت بالجرح) ← يكفّر الله عنك بمقدار ما عفوت","cause":"ما من رجلٍ يُجرحُ في جسدِه جِراحةً فيتصدَّقُ بها","result":"إلَّا كفَّر اللهُ تبارك وتعالَى عنه مثلَ ما تصدَّق به","explicit":true,"repOf":"س-03529","ref":"الترغيب والترهيب 3/283","text":[["ما من رجلٍ يُجرحُ في جسدِه جِراحةً فيتصدَّقُ بها",1]," ",["إلَّا كفَّر اللهُ تبارك وتعالَى عنه مثلَ ما تصدَّق به",2]],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (22701) واللفظ له، والطبراني كما في ((مجمع الزوائد)) (6/305) باختلاف يسير، والبيهقي (16480) بنحوه مطولاً","bab":"استغفار › أسباب المغفرة","dorar":"h58AeN4N"},{"id":"س-03525","fp":"bb124bf867ed","stateId":93,"easy":"إذا عفوت عن جناية على جسدك ← يكفّر الله عنك من ذنوبك بقدر ذلك","cause":"مَن تَصَدَّقَ مِن جَسَدِه بشيءٍ","result":"كَفَّرَ اللهُ عنه مِن ذُنوبِه بقَدْرِ ذلك","explicit":true,"ref":"الأحكام الوسطى 4/ 67","srcLabel":"الأحكام الوسطى","text":["\"",["مَن تَصَدَّقَ مِن جَسَدِه بشيءٍ ",1],["كَفَّرَ اللهُ عنه مِن ذُنوبِه بقَدْرِ ذلك\"",2],"."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","bab":"استغفار › مكفرات الذنوب","dorar":"rZRWVJVF"},{"id":"س-03355","fp":"77e0c608dbf0","stateId":93,"easy":"إذا أصابك شيء في جسدك فعفوت عنه لله ← يكون كفارة لك","cause":"مَن أُصيبَ بشيءٍ في جسدِه ، فتركَه للهِ عزَّ وجلَّ","result":"كانَ كفَّارةً لهُ","explicit":true,"ref":"صحيح الترغيب 2461","srcLabel":"أحمد","text":[["مَن أُصيبَ بشيءٍ في جسدِه ، فتركَه للهِ عزَّ وجلَّ ؛ ",1],["كانَ كفَّارةً لهُ",2]],"grade":"حسن","narrator":"رجل من الصحابة","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (23494)، وابن أبي عاصم في ((الديات)) (ص24)، وابن عساكر في ((تاريخ دمشق)) (57/ 73) بلفظه.","bab":"استغفار › أسباب المغفرة","dorar":"VRmnlOMr","merged":2,"otherRefs":["الجامع الصغير 8441 (حسن)"]},{"id":"س-06114","fp":"380c3d897d99","stateId":93,"easy":"إذا عفوت وأنت قادر ← يعفو الله عنك يوم الشدة","cause":"مَن عَفا عندَ القُدرةِ","result":"عَفا اللهُ عَنه يومَ العُسرةِ","explicit":true,"otherNeedIds":[65],"ref":"الجامع الصغير 8835","srcLabel":"الطبراني","text":[["مَن عَفا عندَ القُدرةِ ",1],["عَفا اللهُ عَنه يومَ العُسرةِ",2],"."],"grade":"حسن","narrator":"أبو أمامة","muhaddith":"حسن","takhrij":"أخرجه الطبراني (8/ 128) (7585) بلفظه.","bab":"رقائق وزهد › مكارم الأخلاق والعفو عمن ظلم","dorar":"kXdTQc9Y"},{"id":"س-07770","fp":"56d1ff44975a","stateId":93,"easy":"إذا عفوت عمّن أساء إليك ووصلته ← يغفر الله لك (من قصة أبي بكر)","cause":"ولا يَأتَلِ أُولُو الفَضلِ مِنكُم والسَّعةِ","result":"قال أبو بَكرٍ: بَلى، فوصَلَه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 27071","srcLabel":"أحمد","text":["عن أُمِّ رومانَ قالت: بَينا أنا عِندَ عائِشةَ إذ دَخَلَت علينا امرَأةٌ مِنَ الأنصارِ، فقالت: فعَلَ اللهُ بابنِها وفَعَلَ، قالت عائِشةُ: ولمَ؟ قالت: إنَّه كان فيمَن حَدَّثَ الحَديثَ، قالت عائِشةُ: وأيُّ حَديثٍ؟ قالت: كَذا وكَذا، قالت: وقد بَلَغَ ذاكَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم؟ قالت: نَعَم، وبَلَغَ أبا بَكرٍ؟ قالت: نَعَم، قالت فخَرَّت عائِشةُ مَغشيًّا عليها فما أفاقَت إلَّا وعليها حُمَّى بنافِضٍ، قالت: فقُمتُ فدَثَّرتُها، قالت: ودَخَلَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: ما شَأنُ هذه؟ قالت: قُلتُ: يا رَسولَ اللهِ، أخَذَتها حُمَّى بنافِضٍ، قال: \"فلَعَلَّه في حَديثٍ تُحُدِّثَ به، قالت: فاستَوت له عائِشةُ قاعِدةً، فقالت: واللهِ لَئِن حَلَفتُ لَكُم لا تُصَدِّقوني، ولَئِنِ اعتَذَرتُ إليكُم لا تَعذِروني، فمَثَلي ومَثَلُكُم كَمَثَلِ يَعقوبَ وبَنيه {واللهُ المُستَعانُ على ما تَصِفونَ} [يوسف: 18]، قالت: وخَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، قال: وأنزَلَ اللهُ عليه عُذرَها، فرَجَعَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، مَعَه أبو بَكرٍ، فدَخَلَ فقال: يا عائِشةُ، إنَّ اللهَ عَزَّ وجَلَّ قد أنزَلَ عُذرَكِ، قالت: بحَمدِ اللهِ لا بحَمدِكَ، قالت: قال لها أبو بَكرٍ: تَقولينَ هذا لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّم؟! قالت: نَعَم، قالت: فكان فيمَن حَدَّثَ الحَديثَ رَجُلٌ كان يَعولُه أبو بَكرٍ، فحَلَفَ أبو بَكرٍ أن لا يَصِلَه، فأنزَلَ اللهُ عَزَّ وجَلَّ: {",["ولا يَأتَلِ أُولُو الفَضلِ مِنكُم والسَّعةِ",1],"} إلى آخِرِ الآيةِ، ",["قال أبو بَكرٍ: بَلى، فوصَلَه",2],"\""],"grade":"صحيح","narrator":"أم رومان","muhaddith":"صحيح دون قولها: فكان فيمن حدث الحديث...\".","bab":"قرآن › أسباب النزول","dorar":"fYIzbumx"},{"id":"س-07975","fp":"d7d3727fc5c1","stateId":93,"easy":"إذا أصبحت لا تنوي ظلم أحد ← يُغفر لك ما اجترمت","cause":"منْ أصبحَ وهوَ لا يَهِمُّ بظُلمِ أحدٍ","result":"غُفرَ له مَا اجْتَرَمَ","explicit":true,"apply":{"k":"time","t":"في الصباح"},"ref":"الجامع الصغير 8432","srcLabel":"ابن عساكر","text":[["منْ أصبحَ وهوَ لا يَهِمُّ بظُلمِ أحدٍ ",1],["غُفرَ له مَا اجْتَرَمَ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"أخرجه ابن عساكر في (()) (53/ 273)، وأبو طاهر السلفي في ((المشيخة البغدادية)) (101) بلفظه، وابن شاهين في ((الترغيب)) (522) باختلاف يسير.","bab":"مظالم › التخلص من الظلم","dorar":"7IyQJXgB"},{"id":"س-03308","fp":"716aff0a098f","stateId":93,"easy":"إذا تصدقت بعرضك على من نال منك ← يغفر الله لك","cause":"جعلتُ عِرضي صدَقةً لمن أصابَ منهُ شيئًا","result":"أنَّهُ قد غفرَ لَه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[41],"ref":"نتائج الأفكار 2/418","srcLabel":"أحمد","text":["أنَّ رجُلًا مِنَ المسلِّمينَ قالَ : اللَّهُمَّ إنَّهُ ليسَ لي مالٌ أتصدَّقُ منه ، وإنِّي ",["جعلتُ عِرضي صدَقةً لمن أصابَ منهُ شيئًا",1]," ، قالَ : فأوجبَ النَّبِيُّ صلَّى اللَّهُ عليهِ وسلَّمَ ",["أنَّهُ قد غفرَ لَه",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"رجاله ثقات، ولكن في تسميته نظر","takhrij":"أخرجه أبو أحمد الحاكم في ((الأسامي والكنى)) (4/ 360) بلفظه.","bab":"استغفار › أسباب المغفرة","dorar":"Y5fxTLnK"},{"id":"س-03382","fp":"e41b33050cd7","stateId":93,"easy":"إذا حفظت لسانك ويدك ← تنالك المغفرة يوم عرفة","cause":"ممنْ حَفِظَ لسانَه ويدَه","result":"فتَقَعُ على كلِّ تائبٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"القول المسدد 1/47","srcLabel":"الطبراني","text":["أيُّها الناسُ ! إنَّ اللهَ عزَّ وجلَّ قدْ تَطَوَّلَ عليكم في هذا اليومِ فغفرَ لكم إلا التَّبِعَاتِ فيما بينكم ، ووهبَ مسيئَكم لمحسنِكم ، وأعطى محسنَكم ما سألَ ، فادفعوا باسمِ اللهِ ! فلما كانَ بجمعٍ قالَ : إنَّ اللهَ قدْ غفرَ لصالحِيكم وشفَّعَ صالحِيكم في طالحِيكم ، يُنْزِلُ المغفرةَ فيُعَمِّمُها . ثمَّ يُفَرِّقُ المغفرةَ في الأرضِ ، ",["فتَقَعُ على كلِّ تائبٍ",2]," ",["ممنْ حَفِظَ لسانَه ويدَه",1]," وإبليسُ وجنودُه على جبلِ عرفاتٍ ينظرونَ ما يصنعُ اللهُ بهم ، فإذا نزلتِ المغفرةُ دعا هوَ وجنودُه بالوَيْلِ يقولُ : كيفَ اسْتَفَزُّهم حِقَبًا منَ الدهرِ ! ثمَّ جاءتْ المغفرةُ فعمَّتْهم، يتفرَّقون وهمْ يدعونَ بالوَيْلِ والثُّبُورِ"],"grade":"حسن","narrator":"عبادة بن الصامت","muhaddith":"رجاله ثقات أثبات معروفون إلا الواسطة الذي بين معمر وقتادة","takhrij":"أخرجه عبد الرزاق (8831)، والطبراني كما في ((مجمع الزوائد)) للهيثمي (5568)، وابن الجوزي في ((الموضوعات)) (2/ 215) واللفظ لهم.","bab":"استغفار › أسباب المغفرة","dorar":"Ed4aN8aK"},{"id":"س-03337","fp":"e5e90ec93dbc","stateId":94,"easy":"إذا كنت عالماً ← يُغفر لك أربعون ذنباً قبل أن يُغفر للجاهل ذنب واحد","cause":"للعالمِ","result":"ليغفرُ للعالمِ أربعينَ ذنبًا قبلَ أنْ يغفرَ للجاهلِ ذنبًا واحدًا","explicit":true,"star":true,"otherNeedIds":[18],"ref":"الأباطيل والمناكير 1/226","srcLabel":"أبو نعيم","text":["خيارُ أُمتي عُلماؤُها وخيارُ علمائِها رُحماؤُها ألا وإنَّ اللهَ تعالى ",["ليغفرُ للعالمِ أربعينَ ذنبًا قبلَ أنْ يغفرَ للجاهلِ ذنبًا واحدًا",2]," ألا وإنَّ العالمَ الرحيمَ ليجيءُ يومَ القيامةِ وإنَّ لنورِهِ ضوءً يَمشي فيهِ ما بينَ المشرقِ والمغربِ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"غريب حسن","takhrij":"أخرجه أبو نعيم في ((حلية الأولياء)) (8/188)، والخطيب في ((تاريخ بغداد)) (1/237)، وابن عساكر في ((تاريخ دمشق)) (56/119) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"BzQytbed"},{"id":"س-07030","fp":"3a5611467bc6","stateId":94,"easy":"إذا لبست نعلك أو ثوبك خارجاً لطلب العلم ← تُغفر ذنوبك من حيث تخطو عتبة دارك","cause":"ما انتعلَ عبدٌ قطُّ ولا تخففَ ولا لبِس ثوبًا في طلبِ علمٍ","result":"إلا غُفرت له ذنوبُه حيث يخطو عتبةَ دارِه","explicit":true,"otherNeedIds":[18],"ref":"المتجر الرابح 22","srcLabel":"ابن حبان","text":[["ما انتعلَ عبدٌ قطُّ ولا تخففَ ولا لبِس ثوبًا في طلبِ علمٍ",1]," ",["إلا غُفرت له ذنوبُه حيث يخطو عتبةَ دارِه",2],"."],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه ابن حبان في ((المجروحين)) (1/153)، والطبراني في ((المعجم الأوسط)) (5722)، وابن عدي في ((الكامل في الضعفاء)) (1/307) باختلاف يسير.","bab":"علم › الحث على طلب العلم","dorar":"EGaYwz8j"},{"id":"س-02868","fp":"b21389f95cae","stateId":94,"easy":"إذا كنت عالماً عاملاً بعلمك ← يغفر الله لك يوم القيامة","cause":"العلماءَ","result":"قد غفرتُ لكم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[18],"ref":"تنزيه الشريعة 1/268","srcLabel":"الطبراني","text":["يبعثُ اللهُ ",["العلماءَ",1]," يومَ القيامةِ فيقولُ يا معشرَ العلماءِ إنِّي لم أضعْ علْمي فيكم إلا لِعلْمي بكم ولم أضعْ علْمي فيكم لِأُعذِّبَكم انطلقوا ف",["قد غفرتُ لكم",2]," ويقولُ اللهُ تعالى لا تحتقروا عبدًا أتيتُه علمًا فإنِّي لم أُحُقِّرْهُ حين علَّمْتُه"],"grade":"حسن","narrator":"أبو موسى الأشعري","muhaddith":"له شاهد رجاله موثقون","takhrij":"أخرجه الروياني في ((المسند)) (542)، والطبراني في ((المعجم الأوسط)) (4264) باختلاف يسير، وابن عدي في ((الكامل في الضعفاء)) (4/111) واللفظ له","bab":"إيمان › الوعد","dorar":"YlQUi9Mm","merged":2,"otherRefs":["إتحاف الخيرة المهرة 8/266 (حسن)"]},{"id":"س-07398","fp":"b747b60e1b6f","stateId":95,"easy":"إذا كرهت المنكر بقلبك ← فقد برئت من إثمه","cause":"فمَن كَرِهَ","result":"فقد بَرِئَ","explicit":true,"star":true,"otherNeedIds":[13,33],"ref":"صحيح مسلم 1854","srcLabel":"متفق عليه","text":["إنَّه يُستَعمَلُ علَيكُم أُمَراءُ، فتَعرِفونَ وتُنكِرونَ، ",["فمَن كَرِهَ",1]," ",["فقد بَرِئَ",2],"، ومَن أنكَرَ فقد سَلِمَ، ولَكِن مَن رَضيَ وتابَعَ، قالوا: يا رَسولَ اللهِ، ألا نُقاتِلُهم؟ قال: لا، ما صَلَّوا. أي: مَن كَرِهَ بقَلبِه وأنكَرَ بقَلبِه. وفي روايةٍ: بنَحوِ ذلك، غيرَ أنَّه قال: فمَن أنكَرَ فقد بَرِئَ، ومَن كَرِهَ فقد سَلِمَ. وفي روايةٍ: فذَكَرَ مِثلَه، إلَّا قَولَه: ولَكِن مَن رَضيَ وتابَعَ، لَم يَذكُرْه."],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"Q9skuOhv","merged":2,"otherRefs":["تخريج المسند لشعيب 26728 (صحيح)"]},{"id":"ق-0212","fp":"627573ca7140","stateId":95,"easy":"اجتناب الكبائر ← تكفير السيئات والمدخل الكريم","cause":"اجتناب الكبائر","result":"تكفير السيئات والمدخل الكريم","explicit":true,"star":true,"otherNeedIds":[67],"ref":"سورة النساء: 31","srcLabel":"القرآن الكريم","quran":{"s":4,"from":31,"to":31,"text":"إِنْ تَجْتَنِبُوا كَبَائِرَ مَا تُنْهَوْنَ عَنْهُ نُكَفِّرْ عَنْكُمْ سَيِّئَاتِكُمْ وَنُدْخِلْكُمْ مُدْخَلًا كَرِيمًا (31)","hl":[[0,50,1],[50,117,2]]}},{"id":"ق-0257","fp":"6c7c0b59414f","stateId":95,"easy":"الإصلاح والتقوى ← مغفرة الله ورحمته","cause":"الإصلاح والتقوى","result":"مغفرة الله ورحمته","explicit":true,"star":true,"ref":"سورة النساء: 129","srcLabel":"القرآن الكريم","quran":{"s":4,"from":129,"to":129,"text":"وَلَنْ تَسْتَطِيعُوا أَنْ تَعْدِلُوا بَيْنَ النِّسَاءِ وَلَوْ حَرَصْتُمْ فَلَا تَمِيلُوا كُلَّ الْمَيْلِ فَتَذَرُوهَا كَالْمُعَلَّقَةِ وَإِنْ تُصْلِحُوا وَتَتَّقُوا فَإِنَّ اللَّهَ كَانَ غَفُورًا رَحِيمًا (129)","hl":[[135,165,1],[165,204,2]]}},{"id":"ق-0854","fp":"1d95522db0b0","stateId":95,"easy":"الطيب والعفة ← البراءة ومغفرة ورزق كريم","cause":"الطيب والعفة","result":"البراءة ومغفرة ورزق كريم","explicit":true,"otherNeedIds":[1,42],"ref":"سورة النور: 26","srcLabel":"القرآن الكريم","quran":{"s":24,"from":26,"to":26,"text":"الْخَبِيثَاتُ لِلْخَبِيثِينَ وَالْخَبِيثُونَ لِلْخَبِيثَاتِ وَالطَّيِّبَاتُ لِلطَّيِّبِينَ وَالطَّيِّبُونَ لِلطَّيِّبَاتِ أُولَئِكَ مُبَرَّءُونَ مِمَّا يَقُولُونَ لَهُمْ مَغْفِرَةٌ وَرِزْقٌ كَرِيمٌ (26)","hl":[[60,122,1],[122,197,2]]}},{"id":"ق-1034","fp":"d93e7ce57b18","stateId":95,"easy":"اتباع الذكر وخشية الرحمن بالغيب ← مغفرة وأجر كريم","cause":"اتباع الذكر وخشية الرحمن بالغيب","result":"مغفرة وأجر كريم","explicit":true,"similar":["ق-1363"],"otherNeedIds":[45],"ref":"سورة يس: 11","srcLabel":"القرآن الكريم","quran":{"s":36,"from":11,"to":11,"text":"إِنَّمَا تُنْذِرُ مَنِ اتَّبَعَ الذِّكْرَ وَخَشِيَ الرَّحْمَنَ بِالْغَيْبِ فَبَشِّرْهُ بِمَغْفِرَةٍ وَأَجْرٍ كَرِيمٍ (11)","hl":[[0,75,1],[75,116,2]]}},{"id":"ق-1274","fp":"6c3fa16fd71b","stateId":95,"easy":"الإحسان واجتناب كبائر الإثم والفواحش ← الجزاء بالحسنى وسعة المغفرة","cause":"الإحسان واجتناب كبائر الإثم والفواحش","result":"الجزاء بالحسنى وسعة المغفرة","explicit":true,"otherNeedIds":[67],"ref":"سورة النجم: 31–32","srcLabel":"القرآن الكريم","quran":{"s":53,"from":31,"to":32,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ لِيَجْزِيَ الَّذِينَ أَسَاءُوا بِمَا عَمِلُوا وَيَجْزِيَ الَّذِينَ أَحْسَنُوا بِالْحُسْنَى (31) الَّذِينَ يَجْتَنِبُونَ كَبَائِرَ الْإِثْمِ وَالْفَوَاحِشَ إِلَّا اللَّمَمَ إِنَّ رَبَّكَ وَاسِعُ الْمَغْفِرَةِ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنْشَأَكُمْ مِنَ الْأَرْضِ وَإِذْ أَنْتُمْ أَجِنَّةٌ فِي بُطُونِ أُمَّهَاتِكُمْ فَلَا تُزَكُّوا أَنْفُسَكُمْ هُوَ أَعْلَمُ بِمَنِ اتَّقَى (32)","hl":[[98,142,2],[142,224,1],[224,259,2]]}},{"id":"ق-1353","fp":"dc67f284184a","stateId":95,"easy":"تقوى الله ← تكفير السيئات وإعظام الأجر","cause":"تقوى الله","result":"تكفير السيئات وإعظام الأجر","explicit":true,"otherNeedIds":[45],"ref":"سورة الطلاق: 5","srcLabel":"القرآن الكريم","quran":{"s":65,"from":5,"to":5,"text":"ذَلِكَ أَمْرُ اللَّهِ أَنْزَلَهُ إِلَيْكُمْ وَمَنْ يَتَّقِ اللَّهَ يُكَفِّرْ عَنْهُ سَيِّئَاتِهِ وَيُعْظِمْ لَهُ أَجْرًا (5)","hl":[[44,67,1],[67,120,2]]}},{"id":"ق-1363","fp":"04a82bd84e98","stateId":95,"easy":"خشية الله بالغيب ← مغفرة وأجر كبير","cause":"خشية الله بالغيب","result":"مغفرة وأجر كبير","explicit":true,"repOf":"ق-1034","otherNeedIds":[45],"ref":"سورة الملك: 12","quran":{"s":67,"from":12,"to":12,"text":"إِنَّ الَّذِينَ يَخْشَوْنَ رَبَّهُمْ بِالْغَيْبِ لَهُمْ مَغْفِرَةٌ وَأَجْرٌ كَبِيرٌ (12)","hl":[[0,49,1],[49,83,2]]}},{"id":"ق-1378","fp":"2ce8322115e4","stateId":95,"easy":"عبادة الله وتقواه وطاعة الرسول ← مغفرة الذنوب والتأخير إلى أجل مسمى","cause":"عبادة الله وتقواه وطاعة الرسول","result":"مغفرة الذنوب والتأخير إلى أجل مسمى","explicit":true,"otherNeedIds":[36],"ref":"سورة نوح: 3–4","srcLabel":"القرآن الكريم","quran":{"s":71,"from":3,"to":4,"text":"أَنِ اعْبُدُوا اللَّهَ وَاتَّقُوهُ وَأَطِيعُونِ (3) يَغْفِرْ لَكُمْ مِنْ ذُنُوبِكُمْ وَيُؤَخِّرْكُمْ إِلَى أَجَلٍ مُسَمًّى إِنَّ أَجَلَ اللَّهِ إِذَا جَاءَ لَا يُؤَخَّرُ لَوْ كُنْتُمْ تَعْلَمُونَ (4)","hl":[[0,52,1],[52,122,2]]}},{"id":"س-04075","fp":"69e64588c6de","stateId":95,"easy":"إذا اتقيت الله وقلت قولاً سديداً ← يصلح الله عملك ويغفر ذنوبك","cause":"اتَّقُوا اللَّهَ وَقُولُوا قَوْلًا سَدِيدًا","result":"يُصْلِحْ لَكُمْ أَعْمَالَكُمْ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ","explicit":true,"otherNeedIds":[53],"ref":"الأذكار للنووي 355","srcLabel":"أبو داود","text":["علَّمَنا رسولُ اللَّه صلَّى اللَّهُ عليهِ وسلَّمَ خُطبةَ الحاجةِ الحمدُ للَّهِ نستعينهُ ونستغفرهُ ونعوذُ بِهِ من شرورِ أنفسِنا من يهدِه اللَّهُ فلا مُضلَّ لهُ ومن يُضللْ فلا هاديَ لَهُ وأشهدُ أن لا إله إلَّا اللَّهُ وحدَهُ لا شريكَ له وأشهدُ أنَّ محمَّدًا عبدهُ ورسولُهُ  يَا أَيُّهَا النَّاسُ اتَّقُوا رَبَّكُمُ الَّذِي خَلَقَكُمْ مِنْ نَفْسٍ وَاحِدَةٍ وَخَلَقَ مِنْهَا زَوْجَهَا وَبَثَّ مِنْهُمَا رِجَالًا كَثِيرًا وَنِسَاءً وَاتَّقُوا اللَّهَ الَّذِي تَسَاءَلُونَ بِهِ وَالْأَرْحَامَ إِنَّ اللَّهَ كَانَ عَلَيْكُمْ رَقِيبًا  [ النساء : 1 ]  يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ حَقَّ تُقَاتِهِ وَلَا تَمُوتُنَّ إِلَّا وَأَنْتُمْ مُسْلِمُونَ  [ آل عمران : 102 ]  يَا أَيُّهَا الَّذِينَ آمَنُوا ",["اتَّقُوا اللَّهَ وَقُولُوا قَوْلًا سَدِيدًا",1]," 70 ",["يُصْلِحْ لَكُمْ أَعْمَالَكُمْ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ",2]," وَمَنْ يُطِعِ اللَّهَ وَرَسُولَهُ فَقَدْ فَازَ فَوْزًا عَظِيمًا  [ الأحزاب : 70 - 71 ] وفي رواية أخرى بعد قولِهِ ورسولِهِ أرسلَهُ بالحقِّ بشيرًا ونذيرًا بينَ يدَيِ السَّاعةِ من يُطعِ اللَّهَ ورسولَهُ فقد رشَدَ ومن يعصِهِما فإنَّهُ لا يضرُّ إلَّا نفسَهُ ولا يضرُّ اللَّهَ شيئًا"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2118)، والنسائي (1404) باختلاف يسير، والترمذي (1105) مطولاً باختلاف يسير","bab":"جمعة › كيفية الخطبة","dorar":"ro0xscE2","merged":2,"otherRefs":["صحيح ابن ماجه 1547 (صحيح)"]},{"id":"س-04076","fp":"2ade75d0345d","stateId":95,"easy":"إذا أطعت الله ورسوله ← فقد رشدت","cause":"مَنْ يُطِعِ اللَّهَ وَرَسُولَهُ","result":"فقد رشَدَ","explicit":true,"ref":"الأذكار للنووي 355","srcLabel":"أبو داود","text":["علَّمَنا رسولُ اللَّه صلَّى اللَّهُ عليهِ وسلَّمَ خُطبةَ الحاجةِ الحمدُ للَّهِ نستعينهُ ونستغفرهُ ونعوذُ بِهِ من شرورِ أنفسِنا من يهدِه اللَّهُ فلا مُضلَّ لهُ ومن يُضللْ فلا هاديَ لَهُ وأشهدُ أن لا إله إلَّا اللَّهُ وحدَهُ لا شريكَ له وأشهدُ أنَّ محمَّدًا عبدهُ ورسولُهُ  يَا أَيُّهَا النَّاسُ اتَّقُوا رَبَّكُمُ الَّذِي خَلَقَكُمْ مِنْ نَفْسٍ وَاحِدَةٍ وَخَلَقَ مِنْهَا زَوْجَهَا وَبَثَّ مِنْهُمَا رِجَالًا كَثِيرًا وَنِسَاءً وَاتَّقُوا اللَّهَ الَّذِي تَسَاءَلُونَ بِهِ وَالْأَرْحَامَ إِنَّ اللَّهَ كَانَ عَلَيْكُمْ رَقِيبًا  [ النساء : 1 ]  يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ حَقَّ تُقَاتِهِ وَلَا تَمُوتُنَّ إِلَّا وَأَنْتُمْ مُسْلِمُونَ  [ آل عمران : 102 ]  يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَقُولُوا قَوْلًا سَدِيدًا 70 يُصْلِحْ لَكُمْ أَعْمَالَكُمْ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ وَ",["مَنْ يُطِعِ اللَّهَ وَرَسُولَهُ",1]," فَقَدْ فَازَ فَوْزًا عَظِيمًا  [ الأحزاب : 70 - 71 ] وفي رواية أخرى بعد قولِهِ ورسولِهِ أرسلَهُ بالحقِّ بشيرًا ونذيرًا بينَ يدَيِ السَّاعةِ من يُطعِ اللَّهَ ورسولَهُ ",["فقد رشَدَ",2]," ومن يعصِهِما فإنَّهُ لا يضرُّ إلَّا نفسَهُ ولا يضرُّ اللَّهَ شيئًا"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2118)، والنسائي (1404) باختلاف يسير، والترمذي (1105) مطولاً باختلاف يسير","bab":"جمعة › كيفية الخطبة","dorar":"ro0xscE2","merged":2,"otherRefs":["صحيح مسلم 870 (صحيح)"]},{"id":"س-03936","fp":"578be0ff3f8e","stateId":95,"easy":"إذا اجتنبت كبائر ما نُهيت عنه ← يكفّر الله عنك سيئاتك ويدخلك مدخلاً كريماً","cause":"إِنْ تَجْتَنِبُوا كَبَائِرَ مَا تُنْهَوْنَ عَنْهُ","result":"نُكَفِّرْ عَنْكُمْ سَيِّئَاتِكُمْ وَنُدْخِلْكُمْ مُدْخَلًا كَرِيمًا","explicit":true,"ref":"عمدة التفسير 1/489","srcLabel":"عمدة التفسير","text":["عن أنسَ ، قالَ : لم أرَ مثلَ الَّذي بلغَنا عن ربِّنا ، لم نخرجْ لَهُ عن كلِّ أَهْلٍ ومالٍ . ثمَّ سَكَتَ هُنَيةً ثمَّ قالَ : واللَّهِ لقد كلَّفَنا ربُّنا أَهْونُ من ذلِكَ ، لقد تجاوزَ لَنا عمَّا دونَ الكبائرِ ، فما لَنا ولَها ، ثمَّ تلا  ",["إِنْ تَجْتَنِبُوا كَبَائِرَ مَا تُنْهَوْنَ عَنْهُ",1]," ",["نُكَفِّرْ عَنْكُمْ سَيِّئَاتِكُمْ وَنُدْخِلْكُمْ مُدْخَلًا كَرِيمًا",2]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"تفسير آيات › سورة النساء","dorar":"pQDQfRg6"},{"id":"س-05442","fp":"8dc39465a4f6","stateId":95,"easy":"إذا اقشعرّ جلدك من خشية الله ← تتحاتّ عنك خطاياك كما يتحاتّ ورق الشجرة البالية","cause":"إذا اقْشَعَرَّ جِلدُ العبدِ من خشيةِ اللهِ","result":"تحاتَّتْ عنهُ خطاياهُ كما تَحاتَّ عنِ الشجرةِ البالِيَةِ ورَقُها","explicit":true,"ref":"البحر الزخار 4/149","srcLabel":"البزار","text":[["إذا اقْشَعَرَّ جِلدُ العبدِ من خشيةِ اللهِ ",1],["تحاتَّتْ عنهُ خطاياهُ كما تَحاتَّ عنِ الشجرةِ البالِيَةِ ورَقُها",2]],"grade":"صحيح","narrator":"العباس بن عبدالمطلب","muhaddith":"محفوظ","takhrij":"أخرجه البزار (1322) واللفظ له، وأبو نعيم في ((معرفة الصحابة)) (8022)","bab":"رقائق وزهد › الخوف من الله","dorar":"MN7YwQ7T"},{"id":"س-04164","fp":"ab03a175a16d","stateId":95,"easy":"إذا خشيت الله حقاً ← يغفر لك ولو لم تعمل خيراً قط (من قصة)","cause":"فَرَقًا منكَ يا ربِّ","result":"قدْ غفَرْتُ لكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج مشكل الآثار 565","srcLabel":"متفق عليه","text":["إنَّ رجُلًا لمْ يعمَلْ خيرًا قَطُّ، فحضَرتْهُ الوفاةُ فقال لأهلِهِ: إذا مِتُّ فأحرِقوني بالنَّارِ حتى أصيرَ رمادًا، ثمَّ ذَرُّوني في الريحِ نِصفي في البَرِّ، ونِصفي في البَحرِ، ففُعِلَ ذلك به، فأمَر اللهُ به فجُمِعَ، ثمَّ قال: لِمَ فعَلْتَ هذا؟ قال: ",["فَرَقًا منكَ يا ربِّ",1],"، وأنتَ أعلَمُ، فقال اللهُ: ",["قدْ غفَرْتُ لكَ",2],"."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن، ابن عجلان وهو محمد صدوق حسن الحديث، روى له البخاري تعليقا، ومسلم متابعة، وباقي السند رجاله ثقات رجال الشيخين","takhrij":"أخرجه البخاري (3481)، ومسلم (2756) بلفظ مقارب","bab":"جنائز وموت › لقاء الله والمبادرة بالعمل الصالح","dorar":"9m6YD0R7"},{"id":"س-01098","fp":"ec471d557174","stateId":96,"easy":"إذا أكلت فقلت «الحمد لله الذي أطعمني هذا...» ← يُغفر لك ما تقدّم من ذنبك","cause":"مَن أكَلَ طعامًا، فقالَ: الحمْدُ للهِ الَّذي أطعَمَنِي هذا ورَزَقَنِيهِ مِن غيرِ حَوْلٍ مِنِّي ولا قُوَّةٍ","result":"غُفِرَ له ما تَقدَّمَ مِن ذنْبِه","explicit":true,"star":true,"apply":{"k":"say","t":"«الحمْدُ للهِ الَّذي أطعَمَنِي هذا ورَزَقَنِيهِ مِن غيرِ حَوْلٍ مِنِّي ولا قُوَّةٍ» · الوقت: عند الطعام"},"ref":"المستدرك على الصحيحين 7614","srcLabel":"الترمذي","text":[["مَن أكَلَ طعامًا، فقالَ: الحمْدُ للهِ الَّذي أطعَمَنِي هذا ورَزَقَنِيهِ مِن غيرِ حَوْلٍ مِنِّي ولا قُوَّةٍ؛ ",1],["غُفِرَ له ما تَقدَّمَ مِن ذنْبِه، ",2],"ومَن لَبِسَ ثوبًا، فقالَ: الحمْدُ للهِ الَّذي كَسانِي هذا ورَزَقَنيهِ مِن غيرِ حوْلٍ مِنِّي ولا قُوَّةٍ؛ غُفِرَ له ما تقدَّمَ مِن ذنْبِهِ."],"grade":"صحيح","narrator":"[معاذ بن أنس]","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (3458)، وابن ماجه (3285)، وأحمد (15632) بلفظه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"b0Le8axG"},{"id":"س-01099","fp":"5f2177bd4723","stateId":96,"easy":"إذا لبست ثوباً فقلت «الحمد لله الذي كساني هذا...» ← يُغفر لك ما تقدّم من ذنبك","cause":"ومَن لَبِسَ ثوبًا، فقالَ: الحمْدُ للهِ الَّذي كَسانِي هذا ورَزَقَنيهِ مِن غيرِ حوْلٍ مِنِّي ولا قُوَّةٍ","result":"غُفِرَ له ما تقدَّمَ مِن ذنْبِهِ","explicit":true,"apply":{"k":"say","t":"«الحمْدُ للهِ الَّذي كَسانِي هذا ورَزَقَنيهِ مِن غيرِ حوْلٍ مِنِّي ولا قُوَّةٍ»"},"ref":"المستدرك على الصحيحين 7614","srcLabel":"الترمذي","text":["مَن أكَلَ طعامًا، فقالَ: الحمْدُ للهِ الَّذي أطعَمَنِي هذا ورَزَقَنِيهِ مِن غيرِ حَوْلٍ مِنِّي ولا قُوَّةٍ؛ غُفِرَ له ما تَقدَّمَ مِن ذنْبِه، ",["ومَن لَبِسَ ثوبًا، فقالَ: الحمْدُ للهِ الَّذي كَسانِي هذا ورَزَقَنيهِ مِن غيرِ حوْلٍ مِنِّي ولا قُوَّةٍ؛ ",1],["غُفِرَ له ما تقدَّمَ مِن ذنْبِهِ",2],"."],"grade":"صحيح","narrator":"[معاذ بن أنس]","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (3458)، وابن ماجه (3285)، وأحمد (15632) بلفظه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"b0Le8axG"},{"id":"س-01939","fp":"654256cf8a20","stateId":96,"easy":"إذا قتلت وزغاً ← يكفّر الله عنك سبع خطيئات","cause":"منْ قَتَلَ وَزَغًا","result":"كَفَّرَ اللهُ عنهُ سبعَ خطيئاتٍ","explicit":true,"ref":"الجامع الصغير 8896","srcLabel":"الطبراني","text":[["منْ قَتَلَ وَزَغًا ",1],["كَفَّرَ اللهُ عنهُ سبعَ خطيئاتٍ",2]],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"حسن","takhrij":"أخرجه عبدالرزاق في ((المصنف)) (8394) واللفظ له، والطبراني في ((المعجم الأوسط)) (8900)، وابن عدي في ((الكامل في الضعفاء)) (5/340)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Mnlnt5M9"},{"id":"س-05698","fp":"94c58bedc7ae","stateId":96,"easy":"إذا أكلت في إناء فلحسته (لم تُضِع شيئاً) ← يستغفر لك الإناء","cause":"من أَكلَ في قصعةٍ فلحسَها","result":"استغفرت لَه القصعةُ","explicit":true,"ref":"هداية الرواة 4/157","srcLabel":"الترمذي","text":[["من أَكلَ في قصعةٍ فلحسَها ",1],["استغفرت لَه القصعةُ",2]],"grade":"حسن","narrator":"نبيشة الخير الهذلي","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه الترمذي (1804)، وابن ماجه (3271) واللفظ له، وأحمد (20724)","bab":"رقائق وزهد › الكبر والتواضع","dorar":"VPoP98Ku"},{"id":"س-03424","fp":"b24f7446064e","stateId":96,"easy":"إذا شهدت ذبح أضحيتك ← يُغفر لك عند أول قطرة من دمها","cause":"أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال: يا فاطمةُ، قُومِي إلى أُضْحِيَّتِكِ فاشْهَدِيها","result":"فإنَّه يُغفَرُ لكِ عندَ أوَّلِ قَطْرةٍ تَقْطُرُ مِن دَمِها كُلُّ ذنْبٍ عَمِلْتِيهِ، وقُولي: إنَّ صَلاتِي ونُسُكِي، ومَحْيايَ ومَمَاتِي؛ للهِ رَبِّ العالَمِينَ، لا شَريكَ له","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 7731","srcLabel":"الطبراني","text":[["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال: يا فاطمةُ، قُومِي إلى أُضْحِيَّتِكِ فاشْهَدِيها؛ ",1],["فإنَّه يُغفَرُ لكِ عندَ أوَّلِ قَطْرةٍ تَقْطُرُ مِن دَمِها كُلُّ ذنْبٍ عَمِلْتِيهِ، وقُولي: إنَّ صَلاتِي ونُسُكِي، ومَحْيايَ ومَمَاتِي؛ للهِ رَبِّ العالَمِينَ، لا شَريكَ له،",2]," وبذلكَ أُمِرْتُ، وأنا مِنَ المُسلِمِينَ.\n قالَ عِمرانُ: قلْتُ: يا رَسولَ اللهِ، هذا لكَ ولأهْلِ بيتِكَ خاصَّةً، فأهْلُ ذاكَ أنتْمُ، أمْ لِلمُسْلِمينَ عامَّةً؟ قالَ: لا، بل للمُسلِمينَ عامَّةً."],"grade":"صحيح","narrator":"عمران بن حصين","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الواحدي في ((التفسير الوسيط)) (347)، والطبراني (18/ 239) (600)، وابن عدي في ((الكامل)) (8/ 267) واللفظ لهم.","bab":"استغفار › أسباب المغفرة","dorar":"z9BURii8","merged":2,"otherRefs":["البدور السافرة 238 (حسن)"]},{"id":"س-03417","fp":"26ffa086c2af","stateId":96,"easy":"إذا خرجت (من الحج أو المسجد) ← تخرج بمغفرة ذنوبك","cause":"وإذا خرجَ","result":"خرجَ بمغفِرةِ ذنوبِهِم","explicit":true,"ref":"مختصر المقاصد 56","srcLabel":"الديلمي","text":["إذا دخلَ الضَّيفُ على قومٍ دخلَ بِرِزقِه ، ",["وإذا خرجَ",1]," ",["خرجَ بمغفِرةِ ذنوبِهِم",2]],"grade":"حسن","narrator":"[أنس بن مالك]","muhaddith":"حسن لغيره","takhrij":"أخرجه الديلمي في ((الفردوس)) كما في ((الجامع الصغير)) للسيوطي (589)","bab":"استغفار › أسباب المغفرة","dorar":"vfUyQuWb"},{"id":"س-03559","fp":"49e621d7e791","stateId":96,"easy":"إذا كتبت «بسم الله الرحمن الرحيم» فجوّدتها تعظيماً لله ← يغفر لك","cause":"من كتب بسمِ اللهِ الرحمنِ الرحيمِ فجوَّدهُ تعظيمًا للهِ","result":"غفَر له","explicit":true,"apply":{"k":"say","t":"«بسم الله الرحمن الرحيم»"},"ref":"النكت على الموضوعات 45","srcLabel":"ابن عدي","text":[["من كتب بسمِ اللهِ الرحمنِ الرحيمِ فجوَّدهُ تعظيمًا للهِ ",1],["غفَر له",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"له طريق آخر عن أنس وله شاهد قوي عن علي","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (5/49)، وأبو نعيم في ((تاريخ أصبهان)) (2/285) باختلاف يسير، وابن الجوزي في ((الموضوعات)) (1/227) مطولاً واللفظ له","bab":"استغفار › مكفرات الذنوب","dorar":"p1WRKZaf"},{"id":"س-03170","fp":"4685e56634bc","stateId":97,"easy":"إذا أذنبت فعوقبت عليه في الدنيا ← فالله أعدل من أن يعاقبك عليه مرة أخرى في الآخرة","cause":"مَن أصابَ ذَنْبًا في الدُّنْيا فعُوقِبَ به","result":"فاللهُ أَعدَلُ مِن أن يُثَنِّيَ عُقوبتَه على عَبْدِه في الآخِرةِ","explicit":true,"star":true,"otherNeedIds":[9],"ref":"الأحاديث المختارة 767","srcLabel":"البخاري","text":["«",["مَن أصابَ ذَنْبًا في الدُّنْيا فعُوقِبَ به",1],"، ",["فاللهُ أَعدَلُ مِن أن يُثَنِّيَ عُقوبتَه على عَبْدِه في الآخِرةِ",2],"، ومَن أصابَ ذَنْبًا في الدُّنْيا فسَتَرَه اللهُ عليه وعَفا عنه، فاللهُ أَجوَدُ مِن أن يَعودَ في شيءٍ قد عَفا عنه وسَتَرَه»."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"إيمان › توحيد الأسماء والصفات","dorar":"O2ZFdBZa","merged":5,"otherRefs":["المستدرك على الصحيحين 13 (صحيح)","الأحاديث المختارة 770 (صحيح)","تخريج سنن الدارقطني 3509 (حسن)","عمدة القاري 1/257 (حسن)"]},{"id":"س-03171","fp":"a56a11eeecb8","stateId":97,"easy":"إذا أذنبت فسترك الله وعفا عنك ← فالله أكرم من أن يرجع في عفوه","cause":"ومَن أصابَ ذَنْبًا في الدُّنْيا فسَتَرَه اللهُ عليه وعَفا عنه","result":"فاللهُ أَجوَدُ مِن أن يَعودَ في شيءٍ قد عَفا عنه","explicit":true,"star":true,"otherNeedIds":[42],"ref":"الأحاديث المختارة 767","srcLabel":"البخاري","text":["«مَن أصابَ ذَنْبًا في الدُّنْيا فعُوقِبَ به، فاللهُ أَعدَلُ مِن أن يُثَنِّيَ عُقوبتَه على عَبْدِه في الآخِرةِ، ",["ومَن أصابَ ذَنْبًا في الدُّنْيا فسَتَرَه اللهُ عليه وعَفا عنه",1],"، ",["فاللهُ أَجوَدُ مِن أن يَعودَ في شيءٍ قد عَفا عنه",2]," وسَتَرَه»."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"إيمان › توحيد الأسماء والصفات","dorar":"O2ZFdBZa","merged":4,"otherRefs":["المستدرك على الصحيحين 13 (صحيح)","الأحاديث المختارة 770 (صحيح)","تخريج سنن الدارقطني 3509 (حسن)"]},{"id":"س-04584","fp":"2da810676922","stateId":97,"easy":"إذا ارتكبت حداً فأُقيم عليك ← يكون كفارة لك","cause":"فمَن أتى منكم حَدًّا ممَّا نُهيَ عنه، فأُقيمَ عليه","result":"فهو كفَّارةٌ له","explicit":true,"similar":["س-03428","س-04583"],"ref":"تخريج المسند لشعيب 22732","srcLabel":"متفق عليه","text":["أخَذَ علينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ كما أخَذَ على النِّساءِ -أو النَّاسِ- ألَّا نُشرِكَ باللهِ شيئًا، ولا نَسرِقَ، ولا نَزنيَ، ولا نَقتُلَ أوْلادَنا، ولا نَغتابَ، ولا يَعضَهَ بعضُنا بعضًا، ولا نَعصيَه في مَعروفٍ، ",["فمَن أتى منكم حَدًّا ممَّا نُهيَ عنه، فأُقيمَ عليه",1],"، ",["فهو كفَّارةٌ له",2],"، ومَن أُخِّرَ، فأمْرُه إلى اللهِ؛ إنْ شاء عَذَّبَه، وإنْ شاء غَفَرَ له."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"إسناده صحيح على شرط مسلم.","takhrij":"أخرجه البخاري (4894)، ومسلم (1709) باختلاف يسير","bab":"حدود › الحث على إقامة الحدود","dorar":"vwwN0QCs","merged":4,"otherRefs":["صحيح الجامع 6039 (صحيح)","المستدرك على الصحيحين 8379 (صحيح)","عمدة القاري 1/257 (حسن)"]},{"id":"س-04585","fp":"6b3b266b83ff","stateId":97,"easy":"إذا أصبت حداً فعُجّلت لك عقوبته ← تكون كفارة لك","cause":"فمَن أصابَ منكم مِنهُنَّ حَدًّا، فعُجِّلَ له عُقوبَتُهُ","result":"فهو كَفَّارَتُهُ","explicit":true,"similar":["س-04591","س-03853","س-03040"],"ref":"تخريج المسند لشعيب 22670","srcLabel":"متفق عليه","text":["أخَذَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم علينا كما أخَذَ على النِّساءِ -أو: على النَّاسِ-.. فذكَرَ مَعناهُ [أي مَعْنى حَديثِ: أخَذَ علينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم كما أخَذَ على النِّساءِ سِتًّا: ألَّا تُشرِكوا باللهِ شيئًا، ولا تَسْرِقوا، ولا تَزْنوا، ولا تَقتُلوا أوْلادَكُم، ولا يَعضَهُ بعضُكم بَعضًا، ولا تَعْصُوني في مَعْروفٍ، ",["فمَن أصابَ منكم مِنهُنَّ حَدًّا، فعُجِّلَ له عُقوبَتُهُ",1]," ",["فهو كَفَّارَتُهُ",2],"، وإنْ أُخِّرَ عنه، فأمْرُهُ إلى اللهِ إنْ شاءَ عذَّبَه، وإنْ شاءَ رَحِمَهُ]"],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (4894)، ومسلم (1709) باختلاف يسير","bab":"حدود › الحث على إقامة الحدود","dorar":"78N1Qwdx","merged":2,"otherRefs":["تخريج مشكل الآثار 2184 (صحيح)"]},{"id":"س-04591","fp":"2d3da90bbe05","stateId":97,"easy":"إذا أصبت ذنباً فنالتك عقوبته ← تكون كفارة لك","cause":"فمن أصاب بعد ذلك شيئًا، فنالته عقوبةٌ","result":"فهو كفارةٌ","explicit":true,"repOf":"س-04585","ref":"صحيح النسائي 4173","text":["ألا تبايعوني على ما بايع عليهِ النساءُ ! أن لا تشركوا بالله شيئًا، ولا تسرقوا، ولا تزنوا، ولا تقتلوا أولادَكم، ولا تأتوا ببهتانٍ، تفترونه بين أيديكم وأرجلِكم، ولا تعصوني في معروفٍ ؟ قلنا بلى يا رسولَ اللهِ، فبايعناه على ذلك . فقال رسولُ اللهِ : ",["فمن أصاب بعد ذلك شيئًا، فنالته عقوبةٌ",1],"، ",["فهو كفارةٌ",2],"، ومن لم تنلْهُ عقوبةٌ، فأمرهُ إلى اللهِ، إن شاء غفر لهُ، وإن شاء عاقبه"],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح [لغيره]","takhrij":"أخرجه البخاري (18)، والنسائي (4161)، والشاشي في ((المسند)) (1231)، والطبراني في ((مسند الشاميين)) (3197)، وابن منده في ((الإيمان)) (47) واللفظ لهم جميعا.","bab":"حدود › تحريم السرقة","dorar":"6gI2sYHb"},{"id":"س-03853","fp":"e1d7ea937097","stateId":97,"easy":"إذا أصبت ذنباً فعوقبت عليه في الدنيا ← يكون كفارة لك","cause":"أصابَ مِن ذلك شيئًا فعوقِبَ في الدُّنيا","result":"فهو كَفَّارةٌ له","explicit":true,"repOf":"س-04585","ref":"صحيح البخاري 18","text":["أنَّ عُبادةَ بنَ الصَّامِتِ رَضيَ اللهُ عنه -وكان شَهِد بَدرًا، وهو أحَدُ النُّقَباءِ ليلةَ العَقَبةِ- قال: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال، وحَولَه عِصابةٌ مِن أصحابِه: بايِعوني على أن لا تُشرِكوا باللهِ شيئًا، ولا تَسرِقوا، ولا تَزنوا، ولا تَقتُلوا أولادَكُم، ولا تَأتوا ببُهتانٍ تَفتَرونَه بينَ أيديكُم وأرجُلِكُم، ولا تَعصوا في مَعروفٍ، فمَن وفى مِنكُم فأجرُه على اللهِ، ومَن ",["أصابَ مِن ذلك شيئًا فعوقِبَ في الدُّنيا",1]," ",["فهو كَفَّارةٌ له",2],"، ومَن أصابَ مِن ذلك شيئًا ثُمَّ سَتَرَه اللهُ فهو إلى اللهِ؛ إن شاءَ عَفا عنه، وإن شاءَ عاقَبَه، فبايَعناه على ذلك."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"[صحيح]","takhrij":"أخرجه النسائي (4161)، والشاشي في ((المسند)) (1231)، والطبراني في ((مسند الشاميين)) (3197)، وابن منده في ((الإيمان)) (47) واللفظ لهم جميعا.","bab":"بيعة › البيعة على ماذا تكون","dorar":"OgBhH0cs","merged":6,"otherRefs":["صحيح البخاري 4894 (صحيح)","صحيح مسلم 1709 (صحيح)","نخب الافكار 16/40 (صحيح)","صحيح النسائي 4172 (صحيح)","تخريج كتاب السنة 961 (صحيح)"]},{"id":"س-03428","fp":"67597447f340","stateId":97,"easy":"إذا أُقيم عليك الحد ← يكون كفارة لك","cause":"الحُدودِ","result":"إنَّها كَفَّارةٌ لمَن أُقيمَت عليه","explicit":true,"repOf":"س-04584","ref":"فتح البيان 9/ 181","text":["[قال صَلَّى اللهُ عليه وآله وسَلَّمَ في ",["الحُدودِ",1],"]: ",["إنَّها كَفَّارةٌ لمَن أُقيمَت عليه",2],"."],"grade":"صحيح","muhaddith":"ثابت","bab":"استغفار › أسباب المغفرة","dorar":"0TVpB7Dr","merged":2,"otherRefs":["مجموع فتاوى ابن باز 330/9 (صحيح)"]},{"id":"س-03040","fp":"87dd1d227d4a","stateId":97,"easy":"إذا أصبت ذنباً فعوقبت عليه في الدنيا ← تكون العقوبة كفارة لك","cause":"ومَنِ انتَقَصَ شيئًا أدرَكَهُ اللهُ بها في الدُّنيا","result":"كانت عُقوبتُهُ","explicit":true,"repOf":"س-04585","ref":"المستدرك على الصحيحين 3282","text":["قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «مَنْ يُبايعُني على هؤلاء الآياتِ؟». ثُمَّ قَرَأَ: {قُلْ تَعَالَوْا أَتْلُ مَا حَرَّمَ رَبُّكُمْ عَلَيْكُمْ} [الأنعام: 151] حتَّى خَتَمَ الآياتِ الثَّلاثَ. «فمَنْ وَفَّى فأجْرُهُ على اللهِ، ",["ومَنِ انتَقَصَ شيئًا أدرَكَهُ اللهُ بها في الدُّنيا",1]," ",["كانت عُقوبتُهُ",2],"، ومَنْ أخَّرَ إلى الآخِرةِ كان أمرُهُ إلى اللهِ، إنْ شاءَ عذَّبَهُ وإنْ شاءَ غَفَرَ له»."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الشاشي (مسنده) (1229) بلفظه، ومحمد بن نصر المروزي في ((تعظيم قدر الصلاة)) (660)","bab":"إيمان › الوعيد","dorar":"nYLKIfYT"},{"id":"س-07703","fp":"60c00cecd10d","stateId":97,"easy":"إذا أُقيم عليك الحد ثم تبت ← تكون اليوم من خطيئتك كيوم ولدتك أمك","cause":"فقُطِعَت يدُها اليُمنى . فقالتِ المرأةُ : هل لي من توبةٍ يا رسولَ اللَّهِ ؟ قالَ : نعَم","result":"أنتِ اليومَ من خطيئتِكِ كيومِ ولدتكِ أمُّكِ","explicit":true,"ref":"عمدة التفسير 1/677","srcLabel":"أحمد","text":["أنَّ امرأةً سرقت على عَهْدِ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ، فجاءَ بِها الَّذينَ سرقَتهم فقالوا : يا رسولَ اللَّهِ ، إنَّ هذِهِ المرأةَ سرقَتنا ! قالَ قومُها : فنَحنُ نَفديها ، فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : اقطَعوا يدَها فقالوا : نحنُ نَفديها بخَمسِمائةِ دينارٍ . فقالَ : اقطَعوا يدَها . ",["فقُطِعَت يدُها اليُمنى . فقالتِ المرأةُ : هل لي من توبةٍ يا رسولَ اللَّهِ ؟ قالَ : نعَم",1]," ، ",["أنتِ اليومَ من خطيئتِكِ كيومِ ولدتكِ أمُّكِ",2]," . فأنزلَ اللَّهُ في سورةِ المائدةِ :  فَمَنْ تَابَ مِنْ بَعْدِ ظُلْمِهِ وَأَصْلَحَ فَإِنَّ اللَّهَ يَتُوبُ عَلَيْهِ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6657) واللفظ له، والطبري في ((التفسير)) (11917)","bab":"قرآن › أسباب النزول","dorar":"T4YTUnkp"},{"id":"س-04597","fp":"1d6e2c2730a3","stateId":97,"easy":"إذا أُقيم عليك الحد تائباً ← تُطهّر من ذنبك (من قصة ماعز)","cause":"يُقتَلُ الكلبُ","result":"إنَّه لفي نهرٍ مِن أنهارِ الجنَّةِ يتقمَّصُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[67],"ref":"صحيح ابن حبان 4400","srcLabel":"الترمذي","text":["جاء ماعزُ بنُ مالكٍ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقال: إنَّ الأبعدَ قد زنى فقال له النَّبيُّ صلَّى اللهُ عليه وسلَّم: ( وَيْلَكَ وما يُدريكَ ما الزِّنا ؟ ) ثمَّ أمَر به فطُرِد وأُخرِج ثمَّ أتاه الثَّانيةَ فقال: يا رسولَ اللهِ إنَّ الأبعدَ قد زنى فقال: ( وَيْلَكَ وما يُدريكَ ما الزِّنا ؟ ) فطُرِد وأُخرِج ثمَّ أتاه الثَّالثةَ فقال: يا رسولَ اللهِ إنَّ الأبعدَ قد زنى قال: (  وَيْلَكَ وما يُدريكَ ما الزِّنا ؟ ) قال: أتَيْتُ امرأةً حرامًا مِثْلَ ما يأتي الرَّجلُ مِن امرأتِه فأمَر به فطُرِد وأُخرِج ثمَّ أتاه الرَّابعةَ فقال: يا رسولَ اللهِ إنَّ الأبعدَ قد زنى فقال: (  وَيْلَكَ وما يُدريكَ ما الزِّنا ؟ قال: أدخَلْتُ وأخرَجْتُ ؟ ) قال: نَعم، فأمَر به أنْ يُرجَمَ فلمَّا وجَد مسَّ الحجارةِ تحمَّل إلى شجرةٍ فرُجِم عندَها حتَّى مات \nفمرَّ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بعدَ ذلك معه نفرٌ مِن أصحابِه فقال رجلٌ منهم لصاحبِه: وأبيكَ إنَّ هذا لهو الخائبُ أتى النَّبيَّ صلَّى اللهُ عليه وسلَّم مرارًا كلُّ ذلك يرُدُّه حتَّى قُتِل كما ",["يُقتَلُ الكلبُ",1]," فسكَت عنهما النَّبيُّ صلَّى اللهُ عليه وسلَّم حتَّى مرَّ بجيفةِ حمارٍ شائلةٍ رِجْلَها فقال: ( كُلَا مِن هذا ) قالا: مِن جيفةِ حمارٍ يا رسولَ اللهِ ؟ قال: ( فالَّذي نِلْتُما مِن عِرْضِ أخيكما أكثرُ والَّذي نفسُ محمَّدٍ صلَّى اللهُ عليه وسلَّم بيدِه ",["إنَّه لفي نهرٍ مِن أنهارِ الجنَّةِ يتقمَّصُ",2]," )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الترمذي (1428)، وابن ماجه (2554)، وأحمد (9809) واللفظ لهم.","bab":"حدود › من أقر بالحد","dorar":"qROjKZrK","merged":2,"otherRefs":["صحيح ابن حبان 4399 (صحيح)"]},{"id":"س-04583","fp":"2629e37b00b7","stateId":97,"easy":"إذا أُقيم عليك الحد ← يكون كفارة لما صنعت","cause":"الرَّجمُ","result":"كفارةُ ما صنعتَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04584","ref":"صحيح الجامع 3546","text":[["الرَّجمُ",1]," ",["كفارةُ ما صنعتَ",2]," [يعني حديث: رجمتِ امرأة في عَهدِ رسولِ اللهِ صلَّى اللَّهُ عليهِ وسلَّمَ فلمَّا فرغنا منها جئتُ إلى رسولِ اللهِ صلَّى اللَّهُ عليهِ وسلَّمَ فقلتُ قد رجمنا هذِه الخبيثةَ فقالَ رسولُ اللهِ صلَّى اللَّهُ عليهِ وسلَّمَ الرجم كفَّارةُ ما صنعت]"],"grade":"صحيح","narrator":"الشريد بن سويد الثقفي","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (7232 )، والطبراني في ((المعجم الكبير)) (7/ 319) (7252)","bab":"حدود › الحث على إقامة الحدود","dorar":"WkqKP7I5"},{"id":"س-03488","fp":"1d8a46e1f917","stateId":98,"easy":"إذا صلى على جنازتك قوم فأثنوا عليك خيراً ← يقبل الله شهادتهم ويغفر لك ما لا يعلمون","cause":"إذا صلَّوا على جنازةٍ فأثنَوا خيرًا","result":"يقولُ الرَّبُّ : أجَزتُ شهادَتَهُم فيما يعلَمونَ ، و أغفِرُ لهُ ما لا يَعلِمونَ","explicit":true,"star":true,"ref":"صحيح الجامع 662","srcLabel":"البخاري","text":[["إذا صلَّوا على جنازةٍ فأثنَوا خيرًا",1]," ، ",["يقولُ الرَّبُّ : أجَزتُ شهادَتَهُم فيما يعلَمونَ ، و أغفِرُ لهُ ما لا يَعلِمونَ",2]],"grade":"صحيح","narrator":"الربيع بنت معوذ بن عفراء","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((التاريخ الكبير)) (3/168)، والعقيلي في ((الضعفاء الكبير)) (2/11) باختلاف يسير.","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"C9ugwGOI"},{"id":"س-04120","fp":"9b50ef265802","stateId":98,"easy":"إذا شهد لك أربعون فأكثر من المسلمين بالخير ← يجيز الله شهادتهم","cause":"إذا شَهِدَتْ أُمَّةٌ مِن الأُمَمِ وهُمْ أرْبَعونَ فصاعِدًا","result":"أجازَ اللهُ شَهادتَهم","explicit":true,"star":true,"ref":"الأحاديث المختارة 1417","srcLabel":"البخاري","text":["«",["إذا شَهِدَتْ أُمَّةٌ مِن الأُمَمِ وهُمْ أرْبَعونَ فصاعِدًا",1],"، ",["أجازَ اللهُ شَهادتَهم، ",2],"أو قالَ: صَدَّقَ شَهادتَهم»."],"grade":"صحيح","narrator":"أسامة بن عمير الهذلي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"جنائز وموت › الثناء على الجنازة والعكس","dorar":"woudSEIt"},{"id":"س-03201","fp":"7a767c1e2274","stateId":98,"easy":"إذا شفع لك أربعون مؤمناً (صلّوا على جنازتك) ← يشفّعهم الله فيك","cause":"ما مِن أربعينَ من مؤمِنٍ يشفعَونَ لمؤمنٍ","result":"إلَّا شفَّعَهُمُ اللَّهُ","explicit":true,"ref":"صحيح ابن ماجه 1219","srcLabel":"مسلم","text":[["ما مِن أربعينَ من مؤمِنٍ يشفعَونَ لمؤمنٍ",1]," ",["إلَّا شفَّعَهُمُ اللَّهُ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه مسلم (948) مطولاً بنحوه، وابن ماجه (1489) واللفظ له","bab":"إيمان › فضل الإيمان","dorar":"jngseLNK"},{"id":"س-03311","fp":"ee44b60c4f8f","stateId":98,"easy":"إذا قام على جنازتك أربعون رجلاً لا يشركون بالله ← يُشفَّعون فيك","cause":"فيَقومُ علَى جِنازتِهِ أربَعونَ رجُلًا ، لا يُشرِكونَ باللَّهِ شَيئًا","result":"إلَّا شفِّعوا فيهِ","explicit":true,"otherNeedIds":[62,65],"ref":"صحيح أبي داود 3170","srcLabel":"مسلم","text":["ما مِن مُسلِمٍ يَموتُ ",["فيَقومُ علَى جِنازتِهِ أربَعونَ رجُلًا ، لا يُشرِكونَ باللَّهِ شَيئًا",1]," ، ",["إلَّا شفِّعوا فيهِ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3170) واللفظ له، وأخرجه مسلم (948) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"4NKji9O1"},{"id":"س-03523","fp":"b1b673ea81d6","stateId":98,"easy":"إذا مِتّ فشهد لك أربعة من جيرانك بالخير ← يقبل الله قولهم ويغفر لك","cause":"ما من مُسلِمٍ يَموتُ فيَشهَدُ له أربعةٌ من أهلِ أبياتِ جيرانِه الأدْنَينَ أنَّهم لا يَعلَمون منه إلَّا خَيرًا","result":"إلَّا قالَ اللهُ تَبارَكَ وتَعالَى: قد قَبِلْتُ قَولَكُم -أو قالَ: شَهادَتَكُم-، وغَفَرتُ له ما لا تَعلَمون","explicit":true,"similar":["س-03475","س-03319"],"ref":"المستدرك على الصحيحين 1416","srcLabel":"مسلم","text":[["ما من مُسلِمٍ يَموتُ فيَشهَدُ له أربعةٌ من أهلِ أبياتِ جيرانِه الأدْنَينَ أنَّهم لا يَعلَمون منه إلَّا خَيرًا",1],"، ",["إلَّا قالَ اللهُ تَبارَكَ وتَعالَى: قد قَبِلْتُ قَولَكُم -أو قالَ: شَهادَتَكُم-، وغَفَرتُ له ما لا تَعلَمون",2],"."],"grade":"صحيح","narrator":"أنس","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أبو يعلى (3481)، والبيهقي في ((الشعب)) (9121)، وأبو نعيم في ((الحلية)) (9/ 252) باختلاف يسير.","bab":"استغفار › مكفرات الذنوب","dorar":"bYvIClSR"},{"id":"س-02915","fp":"70ce879ca788","stateId":98,"easy":"إذا صلت على جنازتك جماعة من المسلمين يشفعون لك ← يُشفَّعون فيك","cause":"ما من مُسلمٍ يُصلِّي عليه أُمَّةٌ","result":"إلَّا شُفِّعوا فيه","explicit":true,"otherNeedIds":[62,65],"ref":"تخريج المسند لشعيب 26812","srcLabel":"النسائي","text":["عن أبي بكَّارٍ قال: صلَّيتُ خلفَ أبي المَلِيحِ، على جَنازةٍ فقالَ: أقيموا صُفوفَكُم، وَلْتَحسُنْ شَفاعَتُكم، ولوِ اخترتُ رجُلًا، اخترْتُه، ثمَّ قال: حدَّثَني عبدُ اللهِ بنُ سَلِيلٍ، [قال عبدُ اللهِ:] قال أبي: وحدَّثَنا أبو عُبَيدةَ الحدَّادُ، قال: حدَّثَني عبدُ اللهِ بنُ سَلِيطٍ، عن بعضِ أزواجِ النَّبيِّ صلَّى اللهُ عليهِ وسلَّمَ مَيْمونةَ، وكان أخاها من الرَّضاعةِ، أنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ، قال: ",["ما من مُسلمٍ يُصلِّي عليه أُمَّةٌ",1]," ",["إلَّا شُفِّعوا فيه",2],". وقال أبو المَلِيحِ: الأُمَّةُ أربَعونَ إلى مِئةٍ، فصاعدًا."],"grade":"صحيح","narrator":"ميمونة بنت الحارث أم المؤمنين","muhaddith":"مرفوعه صحيح لغيره","takhrij":"أخرجه النسائي (1993)، وأحمد (26812) واللفظ له","bab":"إيمان › الوعد","dorar":"AKHKUXWh","merged":3,"otherRefs":["تخريج المسند لشعيب 26838 (صحيح)","صحيح الجامع 5786 (صحيح)"]},{"id":"س-02907","fp":"ca0d5b220ef2","stateId":98,"easy":"إذا صلى عليك (على جنازتك) مئة من المسلمين ← يُغفر لك","cause":"ما من رجلٍ يُصلِّي عليه مِائةٌ","result":"إلَّا غُفِرَ لهُ","explicit":true,"similar":["س-03391","س-03533"],"ref":"صحيح الجامع 5716","srcLabel":"صحيح الجامع","text":[["ما من رجلٍ يُصلِّي عليه مِائةٌ ،",1]," ",["إلَّا غُفِرَ لهُ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر وأبو هريرة","muhaddith":"صحيح","bab":"إيمان › الوعد","dorar":"NQ2MWPbc"},{"id":"س-03391","fp":"911258e61d90","stateId":98,"easy":"إذا صلى على جنازتك مئة مسلم ← يغفر الله لك","cause":"ما من رجلٍ يُصلِّي عليهِ مئةٌ","result":"إلَّا غَفر اللهُ لهُ","explicit":true,"repOf":"س-02907","ref":"صحيح الترغيب 3506","text":[["ما من رجلٍ يُصلِّي عليهِ مئةٌ ؛",1]," ",["إلَّا غَفر اللهُ لهُ ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني (1/190) (505)، وأبو نعيم في ((حلية الأولياء)) (8/391)","bab":"استغفار › أسباب المغفرة","dorar":"ZSM6ERy2"},{"id":"س-03471","fp":"559f36dd9afc","stateId":98,"easy":"إذا صلى على جنازتك ثلاثة صفوف من المسلمين ← يُغفر لك","cause":"ما مِن مسلمٍ يموتُ فيصلِّي عليه ثلاثةُ صفوفٍ من المسلمين","result":"إلا غُفِرَ له","explicit":true,"ref":"مجموع فتاوى ابن عثيمين 107/17","srcLabel":"مجموع فتاوى ابن عثيمين","text":[["ما مِن مسلمٍ يموتُ فيصلِّي عليه ثلاثةُ صفوفٍ من المسلمين",1]," ",["إلا غُفِرَ له",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"HjBcRpqQ"},{"id":"س-03475","fp":"29745e717ce2","stateId":98,"easy":"إذا مِتّ فشهد لك أربعة من جيرانك الأقربين بالخير ← يقبل الله شهادتهم ويغفر لك","cause":"ما مِن مسلمٍ يموتُ فيشهَدُ له أربعةُ أهلِ أبياتٍ مِن جيرتِه الأدنَيْنَ أنَّهم لا يعلَمونَ","result":"إلَّا خيرًا إلَّا قال اللهُ جلَّ وعلا: قد قبِلْتُ عِلْمَكم فيه وغفَرْتُ له ما لا تعلَمونَ","explicit":true,"repOf":"س-03523","ref":"صحيح ابن حبان 3026","text":[["ما مِن مسلمٍ يموتُ فيشهَدُ له أربعةُ أهلِ أبياتٍ مِن جيرتِه الأدنَيْنَ أنَّهم لا يعلَمونَ",1]," ",["إلَّا خيرًا إلَّا قال اللهُ جلَّ وعلا: ( قد قبِلْتُ عِلْمَكم فيه وغفَرْتُ له ما لا تعلَمونَ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (13541)، وأبو يعلى في ((معجمه)) (86)، والضياء في ((الأحاديث المختارة)) (1660) جميعًا بلفظه، وأخرجه الحاكم (1398)، والبيهقي في ((شعب الإيمان)) (9121) كلاهما بلفظ مقارب","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"kadY5WMs"},{"id":"س-03533","fp":"44f92c44cb72","stateId":98,"easy":"إذا صلى عليك (جنازتك) مئة من المسلمين ← يُغفر لك","cause":"مَنْ صلَّى عليهِ مِئَةٌ مِنَ المسلمِينَ","result":"غُفِرَ لَهُ","explicit":true,"repOf":"س-02907","ref":"عمدة القاري 8/167","text":[["مَنْ صلَّى عليهِ مِئَةٌ مِنَ المسلمِينَ ",1],["غُفِرَ لَهُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (1488)، والبزار (9219)، والطحاوي في ((شرح مشكل الآثار)) (269)","bab":"استغفار › مكفرات الذنوب","dorar":"ynBvNyqw"},{"id":"س-03319","fp":"7823475d87a7","stateId":98,"easy":"إذا مِتّ فشهد لك ثلاثة من جيرانك الأقربين بخير ← يقبل الله شهادتهم ويغفر لك","cause":"ما من عبدٍ مسلمٍ يموت فيشهدُ له ثلاثةُ أبياتٍ من جيرانِه الأَدْنَين بخيرٍ","result":"إلا قال اللهُ عزَّ وجلَّ : قد قبِلتُ شهادةَ عبادي على ما علِموا ، وغفَرتُ له ما أعلمُ","explicit":true,"repOf":"س-03523","ref":"صحيح الترغيب 3516","text":[["ما من عبدٍ مسلمٍ يموت فيشهدُ له ثلاثةُ أبياتٍ من جيرانِه الأَدْنَين بخيرٍ ؛",1]," ",["إلا قال اللهُ عزَّ وجلَّ : قد قبِلتُ شهادةَ عبادي على ما علِموا ، وغفَرتُ له ما أعلمُ ",2],"."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (8989)","bab":"استغفار › أسباب المغفرة","dorar":"pQrRy72s"},{"id":"س-06231","fp":"8eb2de59fc5a","stateId":99,"easy":"إذا عملت سيئة فأتبعها حسنة ← فلا إله إلا الله من الحسنات (تمحوها)","cause":"وإذا عمِلتَ سيِّئةً فأتبِعْها حسنةً","result":"لا إلهَ إلَّا اللهُ من الحسناتِ","explicit":true,"ref":"التمهيد 24/300","srcLabel":"ابن عبدالبر","text":["بعث النَّبيُّ صلَّى اللهُ عليه وسلَّم معاذَ بنَ جبلٍ إلى اليمنِ فقال : يا معاذُ اتَّقِ اللهَ وخالِقِ النَّاسَ بخُلقٍ حسنٍ ",["وإذا عمِلتَ سيِّئةً فأتبِعْها حسنةً",1]," قال : قلتُ يا رسولَ اللهِ ",["لا إلهَ إلَّا اللهُ من الحسناتِ ؟",2]," قال : هي من أكبرِ الحسناتِ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"ثابت","takhrij":"أخرجه ابن عبدالبر في ((التمهيد)) (6/55) باختلاف يسير.","bab":"سرايا › تأمير الأمراء على البعوث والسرايا ووصيتهم","dorar":"d69sDtPg"},{"id":"س-08222","fp":"f13cc0bf0cee","stateId":99,"easy":"إذا بدأت نهارك بخير وختمته بخير ← لا يُكتب عليك ما بينهما من الذنوب","cause":"مَن اسْتَفْتَحَ أوَّلَ نَهارِه بخَيْرٍ وخَتَمَه بالخَيْرِ","result":"لا تَكْتُبوا عليه ما بَيْنَ ذلك مِن الذُّنوبِ","explicit":true,"star":true,"ref":"الأحاديث المختارة 9 / 82","srcLabel":"متفق عليه","text":["«",["مَن اسْتَفْتَحَ أوَّلَ نَهارِه بخَيْرٍ وخَتَمَه بالخَيْرِ",1]," قالَ اللهُ عَزَّ وجَلَّ لمَلائِكتِه: ",["لا تَكْتُبوا عليه ما بَيْنَ ذلك مِن الذُّنوبِ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن بسر","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"ملائكة › أعمال الملائكة","dorar":"AHxqoJZ6"},{"id":"س-06013","fp":"a1f129de0199","stateId":99,"easy":"إذا أتبعت السيئة الحسنة ← تمحها","cause":"وَأَتْبِعِ السَّيِّئةَ الحَسَنةَ","result":"تَمْحُها","explicit":true,"star":true,"similar":["س-01221","س-05875"],"ref":"المستدرك على الصحيحين 179","srcLabel":"الحاكم","text":["«يا أَبا ذَرٍّ، اتَّقِ اللهَ حيْثُ كُنتَ، ",["وَأَتْبِعِ السَّيِّئةَ الحَسَنةَ",1]," ",["تَمْحُها",2],"، وخالِقِ النَّاسَ بِخُلُقٍ حَسَنٍ»."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح على شرط الشيخين","bab":"رقائق وزهد › تقوى الله","dorar":"EacoRcbN","merged":3,"otherRefs":["تخريج المسند لشعيب 22059 (حسن)","تخريج المسند لشعيب 21536 (حسن)"]},{"id":"س-01221","fp":"a738cb5cb900","stateId":99,"easy":"إذا عملت سيئة فأتبعها حسنة ← تمحها","cause":"فأتبِعْهَا حسنةً","result":"تَمحُهَا","explicit":true,"repOf":"س-06013","ref":"صحيح الترغيب 3162","text":["إذا عَمِلْتَ سيئةً ",["فأتبِعْهَا حسنةً",1]," ",["تَمحُهَا",2]," قالَ : قلتُ يا رسولَ اللهِ ! أمِنَ الحسَناتِ لا إلهَ إلَّا اللهُ ! قالَ : هيَ أفضَلُ الحسَناتِ"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (21525)","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"gIYb0yGz"},{"id":"س-03822","fp":"8a1c3af4063b","stateId":99,"easy":"إذا عملت الحسنة ← تمحو السيئة","cause":"بالحسنِ","result":"ولَكِن يمحو السَّيِّئَ","explicit":true,"ref":"عمدة التفسير 1/323","srcLabel":"أحمد","text":["إن اللَّهَ قسَّمَ بينَكُم أخلاقَكُم ، كما قسَّمَ بينَكُم أرزاقَكُم ، وإنَّ اللَّهَ يُعطي الدُّنيا مَن يحبُّ ومن لا يحبُّ ، ولا يعطي الدِّينَ إلَّا لمن أحبَّ ، فمَن أعطاهُ اللَّهُ الدِّينَ فقد أحبَّهُ ، والَّذي نَفسي بيدِهِ ، لا يُسلِمُ عبدٌّ حتَّى يسلمَ قلبُه ولسانُهُ ، ولا يؤمنُ حتَّى يأمنَ جارُه بوائقَهُ . قالوا : وما بوائقُهُ يا نبيَّ اللَّهِ ؟ . قالَ : غشمُه وظلمُهُ ، ولا يَكْسبُ عبدٌ مالًا من حرامٍ فينفقَ منهُ فيباركَ لَهُ فيهِ ، ولا يتصدقُ فيقبلَ منهُ ، ولا يترُكُهُ خلفَ ظَهْرِهِ إلَّا كانَ زادَهُ إلى النَّارِ ، إنَّ اللَّهَ لا يمحو السَّيِّئَ بالسَّيِّئِ ، ",["ولَكِن يمحو السَّيِّئَ",2]," ",["بالحسنِ",1]," ، إنَّ الخبيثَ لا يمحو الخبيثَ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (3672) واللفظ له، والحاكم (7301) مختصراً، والبيهقي في ((شعب الإيمان)) (5524) باختلاف يسير","bab":"بر وصلة › حق الجار والوصاة به","dorar":"2ncru5Qu"},{"id":"س-02171","fp":"e2f943733bcd","stateId":99,"easy":"إذا أحسنت فيما بقي من عمرك ← يُغفر لك ما مضى","cause":"مَن أحسنَ فيما بَقِيَ","result":"غُفِرَ لهُ ما مَضَى","explicit":true,"ref":"صحيح الترغيب 3156","srcLabel":"الطبراني","text":[["مَن أحسنَ فيما بَقِيَ ، ",1],["غُفِرَ لهُ ما مَضَى ، ",2],"ومَن أساءَ فيما بَقِيَ أُخِذَ بما مَضَى وما بَقِيَ"],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"حسن","takhrij":"أخرجه الفسوي في ((المعرفة والتاريخ)) (2/357) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (6806)، وابن عساكر في ((تاريخ دمشق)) (65/374) واللفظ لهما","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"pGu0ImVH"},{"id":"س-04733","fp":"070940e84284","stateId":99,"easy":"إذا عملت الصالحات ← تكون كفارة لذنوبك إلا الصوم فهو لله","cause":"كلُّ العملِ","result":"كفَّارةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"مجمع الزوائد 3/182","srcLabel":"البخاري","text":["سمعتُ أبا القاسمِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ قالَ اللَّهُ عزَّ وجلَّ ",["كلُّ العملِ",1]," ",["كفَّارةٌ",2]," إلَّا الصَّومَ والصَّومُ لي وأنا أجزي بهِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه البخاري (7538) مطولاً، وأحمد (10025) واللفظ له","bab":"رقائق وزهد › الإخلاص","dorar":"1tpcwb8C"},{"id":"س-00564","fp":"57106f534692","stateId":99,"easy":"إذا عملت حسنة بعد السيئة ← تنفك عنك قيود الذنب (مثَل الدرع الضيقة)","cause":"ثم عمِل حسنةً","result":"فانفَكَّت حَلْقَةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"هداية الرواة 2313","srcLabel":"ابن المبارك","text":["إن مَثَلَ الذي يعملُ السيئاتِ، ثم يَعملُ الحسناتِ : كَمَثَلِ رجلٍ كانت عليه دِرْعٌ ضَيِّقةٌ قد خَنَقَتْهُ، ",["ثم عمِل حسنةً",1]," ",["فانفَكَّت حَلْقَةٌ",2],"، ثم عمِل أخرى فانفَكَّت حَلْقَةٌ، ثم عمِل أخرى فانفَكَّت حَلْقَةٌ أخرى، حتى تَخرجَ إلى الأرضِ"],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه ابن المبارك في ((الزهد)) (44)، وابن أبي الدنيا في ((التوبة)) (137)، والروياني (165) باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"ANd3yLaR"},{"id":"س-05875","fp":"b87a8d2ff146","stateId":99,"easy":"إذا عملت سيئة فأتبعها حسنة ← تمحها","cause":"إذا عَمِلتَ سَيِّئةً فاعمَلْ حسنةً","result":"يقَرِّبني من الجنة، ويباعِدُني من النار","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-06013","ref":"كلمة الإخلاص وتحقيق معناها 56","text":["قال أبو ذر: قلتُ: يا رسولَ الله! كلِّمني بعمَلٍ ",["يقَرِّبني من الجنة، ويباعِدُني من النار",2],". قال: ",["إذا عَمِلتَ سَيِّئةً فاعمَلْ حسنةً",1],"، إنَّها عشرٌ أمثالُها. قلتُ: يا رسولَ الله، لا إلهَ إلا اللهُ من الحَسَناتِ؟ قال: هي أحسَنُ الحسَناتِ."],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"سنده حسن","takhrij":"أخرجه الطبراني في ((الدعاء)) (1498)، وأبو نعيم الأصبهاني في ((حلية الأولياء)) (4/ 217)، وابن بشران في ((الأمالي)) (615) جميعهم باختلاف يسير.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"2GcJF4im"}]}