فَقَطَّعَ أَمْعَاءَهُمْ (15)","hl":[[0,285,1]]}},{"id":"ق-1256","fp":"6f1a94719a51","stateId":714,"easy":"الأوبة وحفظ حدود الله وخشية الرحمن بالغيب والقلب المنيب ← الجنة بسلام والخلود والمزيد","cause":"الأوبة وحفظ حدود الله وخشية الرحمن بالغيب والقلب المنيب","result":"الجنة بسلام والخلود والمزيد","explicit":true,"otherNeedIds":[68],"ref":"سورة ق: 31–35","srcLabel":"القرآن الكريم","quran":{"s":50,"from":31,"to":35,"text":"وَأُزْلِفَتِ الْجَنَّةُ لِلْمُتَّقِينَ غَيْرَ بَعِيدٍ (31) هَذَا مَا تُوعَدُونَ لِكُلِّ أَوَّابٍ حَفِيظٍ (32) مَنْ خَشِيَ الرَّحْمَنَ بِالْغَيْبِ وَجَاءَ بِقَلْبٍ مُنِيبٍ (33) ادْخُلُوهَا بِسَلَامٍ ذَلِكَ يَوْمُ الْخُلُودِ (34) لَهُمْ مَا يَشَاءُونَ فِيهَا وَلَدَيْنَا مَزِيدٌ (35)","hl":[[0,276,1]]}},{"id":"ق-1268","fp":"1b2d257e4c2a","stateId":714,"easy":"التقوى ← جنات ونعيم والوقاية من عذاب الجحيم","cause":"التقوى","result":"جنات ونعيم والوقاية من عذاب الجحيم","explicit":true,"repOf":"ق-0656","otherNeedIds":[66],"ref":"سورة الطور: 17–20","quran":{"s":52,"from":17,"to":20,"text":"إِنَّ الْمُتَّقِينَ فِي جَنَّاتٍ وَنَعِيمٍ (17) فَاكِهِينَ بِمَا آتَاهُمْ رَبُّهُمْ وَوَقَاهُمْ رَبُّهُمْ عَذَابَ الْجَحِيمِ (18) كُلُوا وَاشْرَبُوا هَنِيئًا بِمَا كُنْتُمْ تَعْمَلُونَ (19) مُتَّكِئِينَ عَلَى سُرُرٍ مَصْفُوفَةٍ وَزَوَّجْنَاهُمْ بِحُورٍ عِينٍ (20)","hl":[[0,258,1]]}},{"id":"ق-1285","fp":"ab981eef451f","stateId":714,"easy":"التقوى ← جنات ونهر في مقعد صدق عند مليك مقتدر","cause":"التقوى","result":"جنات ونهر في مقعد صدق عند مليك مقتدر","explicit":true,"repOf":"ق-0200","otherNeedIds":[68],"ref":"سورة القمر: 54–55","quran":{"s":54,"from":54,"to":55,"text":"إِنَّ الْمُتَّقِينَ فِي جَنَّاتٍ وَنَهَرٍ (54) فِي مَقْعَدِ صِدْقٍ عِنْدَ مَلِيكٍ مُقْتَدِرٍ (55)","hl":[[0,92,1]]}},{"id":"ق-1287","fp":"47d8a95980b4","stateId":714,"easy":"خوف مقام الله ← جنتان","cause":"خوف مقام الله","result":"جنتان","explicit":true,"otherNeedIds":[68],"ref":"سورة الرحمن: 46","srcLabel":"القرآن الكريم","quran":{"s":55,"from":46,"to":46,"text":"وَلِمَنْ خَافَ مَقَامَ رَبِّهِ جَنَّتَانِ (46)","hl":[[0,41,1]]}},{"id":"ق-1369","fp":"53474a2f5832","stateId":714,"easy":"التقوى ← جنات النعيم","cause":"التقوى","result":"جنات النعيم","explicit":true,"repOf":"ق-0668","ref":"سورة القلم: 34","quran":{"s":68,"from":34,"to":34,"text":"إِنَّ لِلْمُتَّقِينَ عِنْدَ رَبِّهِمْ جَنَّاتِ النَّعِيمِ (34)","hl":[[0,57,1]]}},{"id":"ق-1406","fp":"e1efcd2b1621","stateId":714,"easy":"التقوى والإحسان ← ظلال وعيون وفواكه وهناء بما عملوا","cause":"التقوى والإحسان","result":"ظلال وعيون وفواكه وهناء بما عملوا","explicit":true,"ref":"سورة المرسلات: 41–44","srcLabel":"القرآن الكريم","quran":{"s":77,"from":41,"to":44,"text":"إِنَّ الْمُتَّقِينَ فِي ظِلَالٍ وَعُيُونٍ (41) وَفَوَاكِهَ مِمَّا يَشْتَهُونَ (42) كُلُوا وَاشْرَبُوا هَنِيئًا بِمَا كُنْتُمْ تَعْمَلُونَ (43) إِنَّا كَذَلِكَ نَجْزِي الْمُحْسِنِينَ (44)","hl":[[0,181,1]]}},{"id":"ق-1410","fp":"7750aa7ac892","stateId":714,"easy":"التقوى ← مفاز: حدائق وأعناب وكأس دهاق عطاءً حساباً","cause":"التقوى","result":"مفاز: حدائق وأعناب وكأس دهاق عطاءً حساباً","explicit":true,"ref":"سورة النبأ: 31–36","srcLabel":"القرآن الكريم","quran":{"s":78,"from":31,"to":36,"text":"إِنَّ لِلْمُتَّقِينَ مَفَازًا (31) حَدَائِقَ وَأَعْنَابًا (32) وَكَوَاعِبَ أَتْرَابًا (33) وَكَأْسًا دِهَاقًا (34) لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّابًا (35) جَزَاءً مِنْ رَبِّكَ عَطَاءً حِسَابًا (36)","hl":[[0,204,1]]}},{"id":"ق-1413","fp":"23e311d5753b","stateId":714,"easy":"خوف مقام الله ونهي النفس عن الهوى ← الجنة هي المأوى","cause":"خوف مقام الله ونهي النفس عن الهوى","result":"الجنة هي المأوى","explicit":true,"otherNeedIds":[20],"ref":"سورة النازعات: 40–41","srcLabel":"القرآن الكريم","quran":{"s":79,"from":40,"to":41,"text":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِ وَنَهَى النَّفْسَ عَنِ الْهَوَى (40) فَإِنَّ الْجَنَّةَ هِيَ الْمَأْوَى (41)","hl":[[0,107,1]]}},{"id":"ق-1452","fp":"a08ee17d74d7","stateId":714,"easy":"الإيمان والعمل الصالح وخشية الله ← خير البرية وجنات عدن ورضا الله","cause":"الإيمان والعمل الصالح وخشية الله","result":"خير البرية وجنات عدن ورضا الله","explicit":true,"otherNeedIds":[23],"ref":"سورة البينة: 7–8","srcLabel":"القرآن الكريم","quran":{"s":98,"from":7,"to":8,"text":"إِنَّ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ أُولَئِكَ هُمْ خَيْرُ الْبَرِيَّةِ (7) جَزَاؤُهُمْ عِنْدَ رَبِّهِمْ جَنَّاتُ عَدْنٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا أَبَدًا رَضِيَ اللَّهُ عَنْهُمْ وَرَضُوا عَنْهُ ذَلِكَ لِمَنْ خَشِيَ رَبَّهُ (8)","hl":[[0,114,1]]}},{"id":"س-02884","fp":"ab041ec225af","stateId":714,"easy":"إذا خفت مقام ربك ← فلك جنتان","cause":"خَافَ مَقَامَ رَبِّهِ","result":"جَنَّتَانِ [الرحمن: 46]، فقلتُ: وإنْ زَنَى، وإنْ سرَقَ","explicit":true,"otherNeedIds":[6],"ref":"تخريج المسند لشعيب 8683","srcLabel":"النسائي","text":["أنَّه سَمِعَ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ وهو يَقُصُّ على المِنبَرِ: {وَلِمَنْ ",["خَافَ مَقَامَ رَبِّهِ",1]," ",["جَنَّتَانِ} [الرحمن: 46]، فقلتُ: وإنْ زَنَى، وإنْ سرَقَ",2]," يا رسولَ اللهِ؟ فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: الثانيةَ: {وَلِمَنْ خَافَ مَقَامَ رَبِّهِ جَنَّتَانِ} [الرحمن: 46]، فقلتُ في الثانيةِ: وإنْ زَنَى، وإنْ سرَقَ يا رسولَ اللهِ؟ فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ الثالثةَ: {وَلِمَنْ خَافَ مَقَامَ رَبِّهِ جَنَّتَانِ} [الرحمن: 46] فقلتُ الثالثةَ: وإنْ زَنَى، وإنْ سرَقَ يا رسولَ اللهِ؟ قال: نعمْ، وإنْ رَغِمَ أنْفُ أبي الدرداءِ."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (11560)، وأحمد (8683) واللفظ له","bab":"إيمان › الوعد","dorar":"96jU4FxK","merged":3,"otherRefs":["تخريج الإحياء للعراقي 5/315 (صحيح)","الاستذكار 7/288 (حسن)"]},{"id":"س-04159","fp":"49b4fe916279","stateId":714,"easy":"إذا خفت فأدلجت (سرت مبكراً في الطاعة) ← تبلغ المنزل، فسلعة الله غالية هي الجنة","cause":"مَن خاف أَدْلَج ، ومَن أَدْلَج بلغ المنزلَ","result":"أَلَا إنَّ سِلْعَةَ اللهِ غاليةٌ ، أَلَا إنَّ سِلْعَةَ اللهِ الجنةُ","explicit":true,"ref":"صحيح الجامع 6222","srcLabel":"الترمذي","text":[["مَن خاف أَدْلَج ، ومَن أَدْلَج بلغ المنزلَ ، ",1],["أَلَا إنَّ سِلْعَةَ اللهِ غاليةٌ ، أَلَا إنَّ سِلْعَةَ اللهِ الجنةُ",2]],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2457) آخره في أثناء حديث، وأحمد (21241) مختصراً، والحاكم (7852) باختلاف يسير","bab":"جنائز وموت › لقاء الله والمبادرة بالعمل الصالح","dorar":"xLRK8dc2"},{"id":"س-05473","fp":"33f8d3f6d222","stateId":714,"easy":"إذا خفت الله ← لك في الجنة مثل ملك أعظم ملك وعشرة أمثاله","cause":"مِن مَخافَتِكَ","result":"انظُرْ إلى مُلكِ أعظَمِ مَلِكٍ؛ فإنَّ لَكَ مِثلَه وعَشَرةَ أمثالِه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[11,6,24],"ref":"مسند أبي بكر الصديق 700","srcLabel":"مسند أبي بكر الصديق","text":["أصبَحَ رَسولُ اللَّهِ صلَّى اللهُ عليه وسلَّم ذاتَ يَومٍ، فصَلَّى الغَداةَ، ثُمَّ جَلَسَ، حَتَّى إذا كانَ مِنَ الصُّبحِ ضَحِكَ رَسولُ اللَّهِ صلَّى اللهُ عليه وسلَّم، ثُمَّ جَلَسَ مَكانَه، حَتَّى صَلَّى الأولى والعَصرَ والمَغرِبَ، كُلَّ ذلك لا يَتَكَلَّمُ، حَتَّى صَلَّى العِشاءَ الآخِرةَ، ثُمَّ قامَ إلى أهلِه، فقال النَّاسُ لأبي بَكرٍ: ألا تَسألُ رَسولَ اللَّهِ صلَّى اللهُ عليه وسلَّم: ما شَأنُه؟ صَنَعَ اليَومَ شَيئًا لَم يَصنَعْه قَطُّ! فسَألَه، فقال: نَعَم، عُرِضَ عليَّ ما هو كائِنٌ مِن أمرِ الدُّنيا وأمرِ الآخِرةِ، يُجمَعُ الأوَّلونَ والآخِرونَ بصَعيدٍ واحِدٍ، فقَطَعَ النَّاسُ بذلك، حَتَّى انطَلَقوا إلى آدَمَ -والعَرَقُ يَكادُ يُلجِمُهم- فقالوا: يا آدَمُ، أنتَ أبو البَشَرِ، وأنتَ اصطَفاكَ اللَّهُ، اشفَعْ لَنا إلى رَبِّكَ. فقال: لَقد لَقيتُ مِثلَ الذي لَقيتُم، فانطَلِقوا إلى أبيكُم بَعدَ أبيكُم: إلى نوحٍ {إنَّ اللَّهَ اصطَفى آدَمَ ونوحًا وآلَ إبراهيمَ وآلَ عِمرانَ على العالَمينَ} [آل عمران: 33]. قال: فيَنطَلِقونَ إلى نوحٍ عليه السَّلامُ فيَقولونَ: اشفَعْ لَنا إلى رَبِّكَ، فأنتَ اصطَفاكَ اللَّهُ، واستَجابَ لَكَ في دُعائِكَ، ولَم يَدَعْ على الأرضِ مِنَ الكافِرينَ دَيَّارًا. فيَقولُ: ليس ذلك عِندي، انطَلِقوا إلى إبراهيمَ؛ فإنَّ اللَّهَ اتَّخَذَه خَليلًا. فيَنطَلِقونَ إلى إبراهيمَ فيَقولُ: ليس ذلكم عِندي، انطَلِقوا إلى موسى؛ فإنَّ اللَّهَ كَلَّمَه تَكليمًا. فيَقولُ موسى: ليس ذلكم عِندي، انطَلِقوا إلى عيسى ابنِ مَريَمَ؛ فإنَّه يُبرِئُ الأكمَهَ والأبرَصَ ويُحيي المَوتى. فيَقولُ عيسى: ليس ذلكم عِندي، ولَكِنِ انطَلِقوا إلى سَيِّدِ ولَدِ آدَمَ؛ فإنَّه أوَّلُ مَن تَنشَقُّ (عنه الأرضُ) يَومَ القيامةِ، انطَلِقوا إلى مُحَمَّدٍ فيَشفَعَ لَكُم إلى رَبِّكُم. قال: فيَنطَلِقُ (فيُنادي جِبريل، قال): فيَأتي جِبريلُ رَبَّه عَزَّ وجَلَّ، قال: فيَنطَلِقُ فيَأتي جِبريلُ رَبَّه تَعالى، فيَقولُ اللَّهُ تَعالى: (ائذَنْ لَه، وبَشِّرْهُ بالجَنَّةِ). قال: فيَنطَلِقُ به جِبريلُ فيَخِرُّ ساجِدًا قَدرَ جُمُعةٍ، ويَقولُ اللَّهُ عَزَّ وجَلَّ: (ارفَعْ رَأسَكَ [يا مُحَمَّدُ] وقُلْ يُسمَعْ، واشفَعْ تُشَفَّعْ). قال: فيَرفَعُ رَأسَه، فإذا نَظَرَ إلى رَبِّه عَزَّ وجَلَّ خَرَّ ساجِدًا قَدرَ جُمُعةٍ أُخرى، فيَقولُ اللَّهُ عَزَّ وجَلَّ: (ارفَعْ رَأسَكَ، وقُلْ يُسمَعْ، واشفَعْ تُشَفَّعْ). قال: فيَذهَبُ ليَقَعَ ساجِدًا، فيَأخُذُ جِبريلُ بضَبعَيه فيَفتَحُ عليه مِنَ الدُّعاءِ شَيئًا لَم يَفتَحْه على بَشَرٍ، فيَقولُ: أي رَبِّ، خَلَقتَني سَيِّدَ ولَدِ آدَمَ ولا فخرَ، وأوَّلَ مَن تَنشَقُّ عنه الأرضُ يَومَ القيامةِ ولا فَخرَ، حَتَّى إنَّه لَيَرِدُ عليَّ الحَوضَ أكثَرُ مِمَّا بَينَ صَنعاءَ وأَيلةَ. ثُمَّ يُقالُ: ادعوا الصِّدِّيقينَ. فيَشفَعونَ، ثُمَّ يُقالُ: ادعوا الأنبياءَ. قال: فيَجيءُ النَّبيُّ مَعَه العِصابةُ، والنَّبيُّ مَعَه الخَمسةُ والسِّتَّةُ، والنَّبيُّ ليس مَعَه أحَدٌ، ثُمَّ يُقالُ: ادعوا الشُّهَداءَ. فيَشفَعونَ لمَن أرادوا، قال: فإذا فعَلَتِ الشُّهَداءُ ذلك، قال: يَقولُ اللَّهُ عَزَّ وجَلَّ: (أنا أرحَمُ الرَّاحِمينَ، أدخِلوا جَنَّتي مَن كانَ لا يُشرِكُ بي شَيئًا). قال: فيَدخُلونَ الجَنَّةَ، قال: ثُمَّ يَقولُ اللَّهُ عَزَّ وجَلَّ: (انظُروا في النَّارِ، هَل تَلقَونَ مِن أحَدٍ عَمِلَ خَيرًا قَطُّ؟). قال: فيَجِدونَ في النَّارِ رَجُلًا، فيَقولُ لَه: هَل عَمِلتَ خَيرًا قَطُّ؟ فيَقولُ: لا، غَيرَ أنِّي كُنتُ أُسامِحُ النَّاسَ في البَيعِ. فيَقولُ اللَّه: (أسمِحوا لعَبدي كَإسماحِه إلى عَبيدي). ثُمَّ يُخرِجونَ مِنَ النَّارِ رَجُلًا، فيَقولُ لَه: هَل عَمِلتَ خَيرًا قَطُّ؟ فيَقولُ: لا، غَيرَ أنِّي قد أمَرتُ ولَدي: إذا مُتُّ فأحرِقوني بالنَّارِ، ثُمَّ اطحَنوني، حَتَّى إذا كُنتُ مِثلَ الكُحلِ فاذهَبوا بي إلى البَحرِ، فاذْرُوني في الرِّيحِ، فواللَّهِ لا يَقدِرُ عليَّ رَبُّ العالَمينَ أبَدًا. فقال اللَّهُ تَعالى: (لمَ فعَلتَ ذلك؟) قال: ",["مِن مَخافَتِكَ",1],". قال: فيَقولُ اللَّهُ عَزَّ وجَلَّ: (",["انظُرْ إلى مُلكِ أعظَمِ مَلِكٍ؛ فإنَّ لَكَ مِثلَه وعَشَرةَ أمثالِه",2],")، قال: فيَقولُ: لمَ تَسخَرُ بي وأنتَ المَلِكُ؟ قال: (يَعني: رَسولَ اللَّهِ صلَّى اللهُ عليه وسلَّم): (وذلك الذي ضَحِكتُ منه مِنَ الضُّحى)"],"grade":"صحيح","narrator":"حذيفة","muhaddith":"[صحيح]","bab":"رقائق وزهد › الخوف من الله","dorar":"On8AXZvT","merged":26,"otherRefs":["تخريج المسند لشعيب 20024 (صحيح)","صحيح البخاري 6480 (صحيح)","صحيح البخاري 6481 (صحيح)","تخريج المسند لشعيب 11128 (صحيح)","تخريج المسند لشعيب 20012 (صحيح)","تخريج المسند لشعيب 20039 (صحيح)","تخريج المسند لشعيب 20044 (صحيح)","صحيح البخاري 3481 (صحيح)","صحيح البخاري 7508 (صحيح)","السلسلة الصحيحة 3048 (صحيح)","صحيح مسلم 2757 (صحيح)","تخريج صحيح ابن حبان 650 (صحيح)","تخريج صحيح ابن حبان 649 (صحيح)","تخريج صحيح ابن حبان 651 (صحيح)","تخريج مشكل الآثار 560 (صحيح)","تخريج مشكل الآثار 559 (صحيح)","تخريج مشكل الآثار 557 (صحيح)","صحيح البخاري 3479 (صحيح)","صحيح النسائي 2078 (صحيح)","مجمع الزوائد 10/198 (صحيح)","صحيح مسلم 2756 (صحيح)","حلية الأولياء 2/297 (صحيح)","تخريج المسند لشعيب 3786 (صحيح)","صحيح البخاري 3478 (صحيح)","صحيح النسائي 2079 (صحيح)"]},{"id":"س-07725","fp":"ded60fcd0511","stateId":714,"easy":"إذا خشيت الله حتى غُشي عليك ← بُشّرت بالجنة (من واقعة)","cause":"فخَرَّ فتًى مَغشيًّا عليه","result":"فبَشَّرَهُ بالجنَّةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[6],"ref":"المستدرك على الصحيحين 3381","srcLabel":"البيهقي","text":["لمَّا أَنزلَ اللهُ عزَّ وجلَّ على نَبيِّهِ صلَّى اللهُ عليه وسلَّمَ: {يَا أَيُّهَا الَّذِينَ آمَنُوا قُوا أَنْفُسَكُمْ وَأَهْلِيكُمْ نَارًا} [التحريم: 6] تلاها رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ على أصحابِهِ ذاتَ ليلةٍ -أوْ قالَ: يومٍ- ",["فخَرَّ فتًى مَغشيًّا عليه",1],"، فوَضَعَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ يدَهُ على فؤادِهِ، فإذا هو يتحرَّكُ، فقالَ: «يا فتى، قُلْ لا إلهَ إلَّا اللهُ»، فقالَها ",["فبَشَّرَهُ بالجنَّةِ",2],"، فقالَ أصحابُهُ: يا رسولَ اللهِ، أمِنْ بيْنِنا؟ فقالَ صلَّى اللهُ عليه وسلَّمَ: «أما سَمِعْتُم قولَهُ تَعالَى: {ذَلِكَ لِمَنْ خَافَ مَقَامِي وَخَافَ وَعِيدِ} [إبراهيم: 14]."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (720) واللفظ له","bab":"قرآن › أسباب النزول","dorar":"ceoFBdTm"},{"id":"س-02521","fp":"748e18bf0a05","stateId":714,"easy":"إذا عصيت الشيطان في طرقه كلها ← فحق على الله أن يدخلك الجنة","cause":"إنَّ الشَّيْطانَ قَعَدَ لابنِ آدَمَ بأَطْرُقِه، فقَعَدَ له بطَريقِ الإسْلامِ فقالَ: تُسلِمُ وتَذَرُ دينَك ودينَ آبائِك وآباءِ أبيك، فعَصاه فأَسلَمَ، ثُمَّ قَعَدَ له بطَريقِ الهِجْرةِ فقالَ: تُهاجِرُ وتَذَرُ أرْضَك وسَماءَك، وإنَّما مَثَلُ المُهاجِرِ كمَثَلِ الفَرَسِ في الطِّوَلِ، فعَصاه فهاجَرَ، ثُمَّ قَعَدَ له بطَريقِ الجِهادِ، فقالَ: تُجاهِدُ، فهو جَهْدُ النَّفْسِ والمالِ، فتَقاتِلُ فتُقتَلُ، فتُنكَحُ المَرْأةُ، ويُقسَمُ المالُ، فعَصاه فجاهَدَ","result":"فمَن فَعَلَ ذلك كانَ حَقًّا على اللهِ أن يُدخِلَه الجَنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الأحكام الوسطى 2/356","srcLabel":"النسائي","text":["سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: \"",["إنَّ الشَّيْطانَ قَعَدَ لابنِ آدَمَ بأَطْرُقِه، فقَعَدَ له بطَريقِ الإسْلامِ فقالَ: تُسلِمُ وتَذَرُ دينَك ودينَ آبائِك وآباءِ أبيك، فعَصاه فأَسلَمَ، ثُمَّ قَعَدَ له بطَريقِ الهِجْرةِ فقالَ: تُهاجِرُ وتَذَرُ أرْضَك وسَماءَك، وإنَّما مَثَلُ المُهاجِرِ كمَثَلِ الفَرَسِ في الطِّوَلِ، فعَصاه فهاجَرَ، ثُمَّ قَعَدَ له بطَريقِ الجِهادِ، فقالَ: تُجاهِدُ، فهو جَهْدُ النَّفْسِ والمالِ، فتَقاتِلُ فتُقتَلُ، فتُنكَحُ المَرْأةُ، ويُقسَمُ المالُ، فعَصاه فجاهَدَ",1],"\"، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: \"",["فمَن فَعَلَ ذلك كانَ حَقًّا على اللهِ أن يُدخِلَه الجَنَّةَ",2],"، ومَن قُتِلَ كانَ حَقًّا على اللهِ أن يُدخِلَه الجَنَّةَ، وإن غَرِقَ كانَ حَقًّا على اللهِ أن يُدخِلَه الجَنَّةَ، أو وَقَصَتْه دابَّتُه كانَ حَقًّا على اللهِ أن يُدخِلَه الجَنَّةَ."],"grade":"صحيح","narrator":"[سبرة] بن أبي فاكه","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه النسائي (3134)، والبغوي في ((معجم الصحابة)) (1188)، وإسماعيل الأصفهاني في ((الترغيب والترهيب)) (839) .","bab":"إيمان › أعمال الجن والشياطين","dorar":"bfmcbg8p","merged":2,"otherRefs":["تخريج الإحياء للعراقي 3/35 (صحيح)"]},{"id":"س-02590","fp":"0f105e847662","stateId":715,"easy":"إذا تركت الديباج والحرير وآنية الذهب والفضة في الدنيا ← تكون لك في الآخرة","cause":"لا تَلبَسوا الدِّيباجَ والحَريرَ، ولا تَشْرَبوا في آنيةِ الفِضَّةِ والذَّهبِ","result":"فإنَّها لهُم في الدُّنْيا، ولنا في الآخِرةِ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 4538","srcLabel":"الحاكم","text":["عَنْ أَبِي وَائِلٍ، قَالَ: غزَوْتُ معَ عُمَرَ رَضيَ اللهُ عنه الشَّامَ، فنزَلْنا مَنزِلًا، فجاءَ دِهْقانٌ يَستدِلُّ على أميرِ المؤمِنينَ حتَّى أتاهُ، فلمَّا رَأى الدِّهْقانُ عُمَرَ سجَدَ، فقالَ عُمَرُ: «ما هذا السُّجودُ؟» فقالَ: هكذا نفعَلُ بالمُلوكِ، فقالَ عُمَرُ: «اسجُدْ لرَبِّكَ الَّذي خلَقَكَ»، فقالَ: يا أميرَ المؤمِنينَ، إنِّي قد صنَعْتُ لكَ طَعامًا فأْتِني، قالَ: فقالَ عُمَرُ: «هل في بَيتِكَ من تَصاويرِ العَجَمِ؟» قالَ: نعمْ، قالَ: «لا حاجةَ لي في بَيتِكَ، ولكنِ انطَلَقْ فابعَثْ لنا بلَونٍ منَ الطَّعامِ، ولا تَزِدْنا عليه»، قالَ: فانطَلَقَ فبعَثَ إليه بطَعامٍ فأكَلَ منه، ثمَّ قالَ عُمَرُ لغُلامِه: «هل في إداوَتِكَ شَيءٌ من ذلك النَّبيذِ؟» قالَ: نعمْ، فأتاهُ فصَبَّه في إناءٍ، ثمَّ شَمَّه فوجَدَه مُنكَرَ الرِّيحِ، فصَبَّ عليه ماءً، ثمَّ شَمَّه فوجَدَه مُنكَرَ الرِّيحِ، فصَبَّ عليه الماءَ ثَلاثَ مرَّاتٍ، ثمَّ شَرِبَه، ثمَّ قالَ: «إذا رابَكم من شَرابِكم شَيءٌ، فافْعَلوا به هكذا»، ثمَّ قالَ: سمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: «",["لا تَلبَسوا الدِّيباجَ والحَريرَ، ولا تَشْرَبوا في آنيةِ الفِضَّةِ والذَّهبِ",1],"؛ ",["فإنَّها لهُم في الدُّنْيا، ولنا في الآخِرةِ",2],"»."],"grade":"صحيح","narrator":"أبو وائل","muhaddith":"صحيح الإسناد","bab":"إيمان › أعمال تنافي الإيمان","dorar":"BA1LJ7ID","merged":11,"otherRefs":["تخريج صحيح ابن حبان 5339 (صحيح)","تخريج المسند لشعيب 23314 (صحيح)","صحيح النسائي 5316 (صحيح)","صحيح مسلم 2067 (صحيح)","غاية المرام 117 (صحيح)","البحر الزخار 7/217 (صحيح)","صحيح أبي داود 3723 (صحيح)","جامع العلوم والحكم 2/189 (صحيح)","الأوسط لابن المنذر 1/430 (صحيح)","تخريج المسند لشعيب 23401 (صحيح)"]},{"id":"س-06203","fp":"e7dba7e155e4","stateId":715,"easy":"إذا أحببت حلية الجنة وحريرها ← فلا تلبسها في الدنيا","cause":"فلا تَلْبَسوها في الدُّنيا","result":"إنْ كنتم تُحِبُّونَ حِلْيةَ الجَنَّةَ وحريرَها","explicit":true,"ref":"تخريج المسند لشعيب 17310","srcLabel":"النسائي","text":["يُخبِرُ عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ: أنَّه كان يَمنَعُ أهْلَه الحِلْيةَ والحريرَ، ويقولُ: ",["إنْ كنتم تُحِبُّونَ حِلْيةَ الجَنَّةَ وحريرَها",2]," ",["فلا تَلْبَسوها في الدُّنيا",1],"."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه النسائي (5136)، وأحمد (17310) واللفظ له","bab":"زينة اللباس › ما نهي عنه من اللباس","dorar":"IwgIKRo4","merged":2,"otherRefs":["تخريج مشكل الآثار 4837 (صحيح)"]},{"id":"س-04320","fp":"3748383b7ecc","stateId":715,"easy":"إذا تركت الخمر وأنت قادر عليها ← يسقيك الله منها في حظيرة القدس","cause":"من ترك الخمرَ وهو يقدرُ عليه","result":"لأسقيَنَّهُ منه في حظيرةِ القدسِ","explicit":true,"similar":["س-04321","س-05237"],"ref":"صحيح الترغيب 2375","srcLabel":"البزار","text":[["من ترك الخمرَ وهو يقدرُ عليه ؛ ",1],["لأسقيَنَّهُ منه في حظيرةِ القدسِ ، ",2],"ومن ترك الحريرَ وهو يقدرُ عليه ؛ لأكسُونَّهُ إياه في حظيرةِ القدسِ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح لغيره","takhrij":"أخرجه البزار (7381)","bab":"جنة › صفة أهل الجنة","dorar":"MvaVdZaU"},{"id":"س-04321","fp":"1a2a4f2f2708","stateId":715,"easy":"إذا تركت الحرير وأنت قادر عليه ← يكسوك الله إياه في حظيرة القدس","cause":"ومن ترك الحريرَ وهو يقدرُ عليه","result":"لأكسُونَّهُ إياه في حظيرةِ القدسِ","explicit":true,"repOf":"س-04320","ref":"صحيح الترغيب 2375","text":["من ترك الخمرَ وهو يقدرُ عليه ؛ لأسقيَنَّهُ منه في حظيرةِ القدسِ ، ",["ومن ترك الحريرَ وهو يقدرُ عليه ؛ ",1],["لأكسُونَّهُ إياه في حظيرةِ القدسِ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح لغيره","takhrij":"أخرجه البزار (7381)","bab":"جنة › صفة أهل الجنة","dorar":"MvaVdZaU"},{"id":"س-05237","fp":"07e717aaa9b0","stateId":715,"easy":"إذا تركت الخمر بعد تحريمها ← يسقيك الله منها في حظيرة القدس","cause":"من تركها بعدما حرَّمتُها","result":"لأسقِيَنَّهُ إياها في حظيرةِ القدسِ","explicit":true,"repOf":"س-04320","ref":"تفسير القرآن العظيم 3/178","text":["عن عبدِ اللهِ بنِ عمرو قال إنَّ هذه الآيةَ التي في القرآنِ  يَا أَيُّهَا الَّذِينَ آمَنُوْا إِنَّمَا الْخَمْرُ وَالْمَيْسِرُ وَالْأَنْصَابُ وَالْأَزْلَامُ رِجْسٌ مِنْ عَمَلِ الشَّيْطَانِ فَاجْتَنِبُوهُ لَعَلَّكُمْ تُفْلِحُونَ  قال هيَ في التوراةِ إنَّ اللهَ أنزل الحقَّ ليُذْهِبَ به الباطلَ ويُبْطِلَ به اللعبَ والمزاميرَ والزفنَ والكباراتِ يعني البرابطَ والزماراتِ يعني به الدُّفَّ والطنابيرَ والشِّعْرَ والخمرَ مرةً لمن طعمَها أقسم اللهُ بيمينِه وعِزَّةِ حَيْلِه من شربها بعدما حرَّمتُها لأُعطِّشَنَّه يومَ القيامةِ و",["من تركها بعدما حرَّمتُها",1]," ",["لأسقِيَنَّهُ إياها في حظيرةِ القدسِ",2]],"grade":"صحيح","narrator":"عطاء بن يسار","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي حاتم في ((تفسيره)) (6744) ، والبيهقي في ((السنن الكبرى)) (21042) بنحوه ، والخطيب البغدادي في ((المتفق والمفترق)) (1665) مطولا .","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"0dlqHhJd"},{"id":"س-06184","fp":"7c21071d8a07","stateId":715,"easy":"إذا سرّك أن يسقيك الله الخمر في الآخرة ← فاتركها في الدنيا","cause":"فَلْيتركْهَا في الدُّنيا","result":"مَن سَرَّه أن يَسقِيَه اللهُ الخمرَ في الآخرةِ","explicit":true,"ref":"صحيح الترغيب 2376","srcLabel":"الطبراني","text":[["مَن سَرَّه أن يَسقِيَه اللهُ الخمرَ في الآخرةِ ؛ ",2],["فَلْيتركْهَا في الدُّنيا",1]," ، ومَن سَرَّه أن يَكْسوَهُ اللهُ الحريرَ في الآخرةِ ؛ فَلْيتركْه في الدُّنيا"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن لغيره","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (8879)، والبيهقي في ((البعث والنشور)) (266)، وابن عساكر في ((تاريخ دمشق)) (40/413)","bab":"زينة اللباس › إباحة الذهب والحرير للنساء دون الرجال","dorar":"ZaADtMv2"},{"id":"س-06185","fp":"a2571e8c47ef","stateId":715,"easy":"إذا سرّك أن يكسوك الله الحرير في الآخرة ← فاتركه في الدنيا","cause":"فَلْيتركْه في الدُّنيا","result":"ومَن سَرَّه أن يَكْسوَهُ اللهُ الحريرَ في الآخرةِ","explicit":true,"ref":"صحيح الترغيب 2376","srcLabel":"الطبراني","text":["مَن سَرَّه أن يَسقِيَه اللهُ الخمرَ في الآخرةِ ؛ فَلْيتركْهَا في الدُّنيا ، ",["ومَن سَرَّه أن يَكْسوَهُ اللهُ الحريرَ في الآخرةِ",2]," ؛ ",["فَلْيتركْه في الدُّنيا",1]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن لغيره","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (8879)، والبيهقي في ((البعث والنشور)) (266)، وابن عساكر في ((تاريخ دمشق)) (40/413)","bab":"زينة اللباس › إباحة الذهب والحرير للنساء دون الرجال","dorar":"ZaADtMv2"},{"id":"س-08395","fp":"26bce76d872b","stateId":716,"easy":"إذا لم تسأل الناس شيئاً ← يتقبل لك النبي ﷺ بالجنة","cause":"لا تَسألِ الناسَ شَيئًا","result":"فأتَقبَّلُ له الجَنَّةَ","explicit":true,"similar":["س-08394","س-00266","س-04214"],"otherNeedIds":[5],"ref":"تخريج شرح السنة 1621","srcLabel":"النسائي","text":["قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: مَن يَتقَبَّلُ لي بواحِدةٍ، ",["فأتَقبَّلُ له الجَنَّةَ",2],"؟ قالَ ثَوبانُ: أنا. قالَ: ",["لا تَسألِ الناسَ شَيئًا",1],". وكانَ ثَوبانُ تَسقُطُ عَلاقةُ سَوْطِه، فلا يأمُرُ أحَدًا يُناوِلُه، ويَنزِلُ هو، فيأخُذُه."],"grade":"صحيح","narrator":"ثوبان","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (1837) بلفظه، والنسائي (2590)، وأحمد (22405) باختلاف يسير.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"Mw5DTUzO","merged":4,"otherRefs":["تخريج المسند لشعيب 22423 (صحيح)","صحيح ابن ماجه 1499 (صحيح)","مسند عمر 1/29 (صحيح)"]},{"id":"س-08394","fp":"e3c6ba1923be","stateId":716,"easy":"إذا لم تسأل الناس شيئاً ← يتكفل لك النبي ﷺ بالجنة","cause":"ألَّا يَسألَ الناسَ شَيئًا","result":"وأتَكفَّلُ له الجَنَّةَ","explicit":true,"repOf":"س-08395","otherNeedIds":[5],"ref":"تخريج شرح السنة 1620","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قالَ: مَن يَتكَفَّلُ ",["ألَّا يَسألَ الناسَ شَيئًا",1],"، ",["وأتَكفَّلُ له الجَنَّةَ",2],"؟ قال ثَوبانُ، مَولى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ: أنا. قالَ: فكانَ يُعلَمُ أنَّ ثَوبانَ لا يَسألُ أحَدًا شَيئًا."],"grade":"صحيح","narrator":"ثوبان","muhaddith":"إسناده صحيح","takhrij":"أخرجه البغوي في ((شرح السنة)) (1620)، وعبد الرزاق (20009)، والبيهقي في ((شعب الإيمان)) (3245) واللفظ لهم جميعا.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"82mW2xuY","merged":3,"otherRefs":["تخريج سنن أبي داود 1643 (صحيح)","مسند عمر 1/30 (صحيح)"]},{"id":"س-00266","fp":"29cc5e06a79c","stateId":716,"easy":"إذا لم تسأل الناس شيئاً ← يتكفل لك النبي ﷺ بالجنة","cause":"لا تَسأَلِ النَّاسَ","result":"وأتكفَّلُ له بالجنَّةِ","explicit":true,"repOf":"س-08395","otherNeedIds":[5],"ref":"تخريج المسند لشعيب 22366","text":["مَن يَتكفَّلُ لي بواحدةٍ ",["وأتكفَّلُ له بالجنَّةِ",2],"، قال ثَوبانُ: أنا، قال: ",["لا تَسأَلِ النَّاسَ",1],"، -يَعني شيئًا- قال: نعمْ، قال: فكان لا يَسأَلُ."],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه من طرق أبو داود (1643) باختلاف يسير، والنسائي في ((السنن الكبرى)) (2371)، وابن ماجه (1837) بنحوه، وأحمد (22366) واللفظ له","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"s7D4pYsV"},{"id":"س-04214","fp":"9460bcc98cce","stateId":716,"easy":"إذا لم تسأل الناس شيئاً ← فلك الجنة","cause":"أن لا يسألَ النَّاسَ شيئًا","result":"ولَهُ الجنَّةُ","explicit":true,"repOf":"س-08395","otherNeedIds":[5],"ref":"صحيح النسائي 2589","text":["من يضمَنُ لي واحدةً ",["ولَهُ الجنَّةُ",2],"؟ قالَ يحيى [ راويهِ ] هاهنا كلِمةً معناها ",["أن لا يسألَ النَّاسَ شيئًا",1]],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه النسائي (2590) واللفظ له، وأبو داود (1643)، والطيالسي (1087) بنحوه.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"Nci9E02s"},{"id":"س-05364","fp":"858e160a7b8a","stateId":717,"easy":"إذا لم تسترقِ ولم تتطير وتوكلت على ربك ← تدخل الجنة بغير حساب ولا عذاب","cause":"لا يَستَرقونَ، ولا يَتَطَيَّرونَ، وعلى رَبِّهم يَتَوكَّلونَ","result":"يَدخُلونَ الجَنَّةَ بغيرِ حِسابٍ ولا عَذابٍ","explicit":true,"star":true,"ref":"صحيح مسلم 220","srcLabel":"متفق عليه","text":["كُنتُ عِندَ سَعيدِ بنِ جُبَيرٍ، فقال: أيُّكُم رَأى الكَوكَبَ الذي انقَضَّ البارِحةَ؟ قُلتُ: أنا، ثُمَّ قُلتُ: أما إنِّي لَم أكُنْ في صَلاةٍ، ولَكِنِّي لُدِغتُ، قال: فماذا صَنَعتَ؟ قُلتُ: استَرقَيتُ، قال: فما حَمَلَك على ذلك؟ قُلتُ: حَديثٌ حَدَّثَناه الشَّعبيُّ، فقال: وما حَدَّثَكُمُ الشَّعبيُّ؟ قُلتُ: حَدَّثَنا عن بُرَيدةَ بنِ حُصَيبٍ الأسلَميِّ، أنَّه قال: لا رُقيةَ إلَّا مِن عَينٍ أو حُمَةٍ، فقال: قد أحسَنَ مَنِ انتَهى إلى ما سَمِعَ، ولَكِن حَدَّثَنا ابنُ عبَّاسٍ، عَنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم، قال: عُرِضَت عليَّ الأُمَمُ، فرَأيتُ النَّبيَّ ومعهُ الرُّهَيطُ، والنَّبيَّ ومعهُ الرَّجُلُ والرَّجُلانِ، والنَّبيَّ ليس معهُ أحَدٌ، إذ رُفِعَ لي سَوادٌ عَظيمٌ، فظَنَنتُ أنَّهم أُمَّتي، فقيلَ لي: هذا موسى صلَّى اللهُ عليه وسلَّم وقَومُه، ولَكِنِ انظُرْ إلى الأُفُقِ، فنَظَرتُ فإذا سَوادٌ عَظيمٌ، فقيلَ لي: انظُرْ إلى الأُفُقِ الآخَرِ، فإذا سَوادٌ عَظيمٌ، فقيلَ لي: هذه أُمَّتُك ومعهُم سَبعونَ ألفًا ",["يَدخُلونَ الجَنَّةَ بغيرِ حِسابٍ ولا عَذابٍ",2],". ثُمَّ نَهَضَ فدَخَلَ مَنزِلَه فخاضَ النَّاسُ في أولَئِك الذينَ يَدخُلونَ الجَنَّةَ بغيرِ حِسابٍ ولا عَذابٍ، فقال بَعضُهم: فلَعَلَّهمُ الذينَ صَحِبوا رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، وقال بَعضُهم: فلَعَلَّهمُ الذينَ وُلِدوا في الإسلامِ ولَم يُشرِكوا باللهِ، وذَكَروا أشياءَ، فخَرَجَ عليهم رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: ما الذي تَخوضونَ فيه؟ فأخبَروه، فقال: هُمُ الذينَ لا يَرقونَ، و",["لا يَستَرقونَ، ولا يَتَطَيَّرونَ، وعلى رَبِّهم يَتَوكَّلونَ",1],"، فقامَ عُكَّاشةُ بنُ مِحصَنٍ، فقال: ادعُ اللهَ أن يَجعَلَني منهم، فقال: أنتَ منهم، ثُمَّ قامَ رَجُلٌ آخَرُ، فقال: ادعُ اللهَ أن يَجعَلَني منهم، فقال: سَبَقَك بها عُكَّاشةُ. وفي روايةٍ: عُرِضَت عليَّ الأُمَمُ...، ثُمَّ ذَكَرَ باقيَ الحَديثِ نَحوَ حَديثِ هُشيمٍ، ولَم يَذكُرْ أوَّلَ حَديثِه."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5705)، ومسلم (220) واللفظ له","bab":"رقائق وزهد › التوكل واليقين","dorar":"myXsHg0H","merged":16,"otherRefs":["صحيح مسلم 218 (صحيح)","صحيح البخاري 6541 (صحيح)","صحيح الأدب المفرد 700 (صحيح)","صحيح ابن حبان 726 (صحيح)","تخريج المسند لشعيب 3819 (صحيح)","المصابيح في الأحاديث المتواترة 629 (صحيح)","صحيح الموارد 2236 (صحيح)","تفسير القرآن العظيم 2/79 (صحيح)","تخريج المسند لشاكر 6/161 (صحيح)","صحيح البخاري 5752 (صحيح)","صحيح ابن حبان 6089 (صحيح)","المستدرك على الصحيحين 8498 (صحيح)","صحيح الترمذي 2446 (صحيح)","تخريج صحيح ابن حبان 6430 (صحيح)","إتحاف الخيرة المهرة 8/250 (صحيح)"]},{"id":"س-05466","fp":"2582f087c230","stateId":717,"easy":"إذا رجوت الجنة (وعملت لها) ← تدخلها","cause":"مَن يَرْجوها","result":"إنَّما يَدخُلُ الجنَّةَ","explicit":true,"ref":"الأحاديث المختارة 13 / 191","srcLabel":"متفق عليه","text":["«",["إنَّما يَدخُلُ الجنَّةَ",2]," ",["مَن يَرْجوها",1]," ويُجَنَّبُ مِن النَّارِ مَن يَخافُها، وإنَّما يَرحَمُ اللهُ عَزَّ وجَلَّ مَن يَرحَمُ»."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الخوف من الله","dorar":"q9Fj4rWe"},{"id":"س-03472","fp":"44721e938f38","stateId":717,"easy":"إذا رجوت الله أن يدخلك الجنة ← يدخلك برحمته","cause":"كنتُ أرجو أن تدخلَني الجنَّةَ","result":"فيؤمرُ به إلى الجنَّةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"جامع المسانيد والسنن 5783","srcLabel":"أحمد","text":["إذا  كان يومُ القيامةِ، وفرغ اللهُ من قضاءِ الخلقِ، فبقيَ رجلان، فيؤمرُ بهما إلى النَّارِ، فيلتفتُ أحدُهما، فيقولُ الجبارُ تعالى: ردُّوه، فيردونه، قال له: لِمَ التفتَّ؟ قال: ",["كنتُ أرجو أن تدخلَني الجنَّةَ",1],"، ",["فيؤمرُ به إلى الجنَّةِ",2],"، فيقولُ: لقد أعطاني اللهُ حتى أني لو أطعمتُ أهلَ الجنَّةِ، ما نقَص ذلك مما عندي شيئًا: قال: فكان رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ إذا ذكره يُرى السرورُ في وجهِهِ."],"grade":"حسن","narrator":"عبادة بن الصامت","muhaddith":"إسناده حسن، ومتنه أحسن","takhrij":"أخرجه أحمد (22845)، وابن المبارك في ((الزهد)) (2/122)، وابن أبي الدنيا في ((حسن الظن بالله)) (58) باختلاف يسير.","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"1DAO1YfP"},{"id":"س-06069","fp":"297d63af6521","stateId":717,"easy":"إذا رجوت الله ← يدخلك الجنة ولو كنت آخر من يدخلها","cause":"نَعَمْ يا ربِّ كُنْتُ أرجو","result":"وهو آخرُ مَن يدخُلُ الجنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[6],"ref":"مجمع الزوائد 10/387","srcLabel":"أحمد","text":["آخرُ مَن يخرُجُ من النَّارِ رجلانِ يقولُ اللهُ لأحدِهما يا ابنَ آدمَ ما أعدَدْتَ لهذا اليومِ هل عمِلْتَ خيرًا قطُّ أو رجَوْتَني فيقولُ لا يا ربِّ فيُؤمَرُ به إلى النَّارِ وهو أشدُّ أهلِ النَّارِ حسرةً ويقولُ للآخرِ هل عمِلْتَ خيرًا قطُّ أو رجَوْتَني فيقولُ ",["نَعَمْ يا ربِّ كُنْتُ أرجو",1]," إن أخرَجْتَني ألَّا تُعِيدَني فيها ",["وهو آخرُ مَن يدخُلُ الجنَّةَ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري وأبو هريرة","muhaddith":"رجاله رجال الصحيح غير علي بن زيد وهو حسن الحديث","takhrij":"أخرجه أحمد (11685)، والبزار (7849) باختلاف يسير.","bab":"رقائق وزهد › ما جاء في فعل الخير","dorar":"n7E3g96h"},{"id":"س-00152","fp":"8542f8b25542","stateId":718,"easy":"إذا أفشيت السلام ووصلت الأرحام وصليت والناس نيام ← تدخل الجنة بسلام","cause":"أَفْشوا السَّلامَ، وصِلوا الأرْحامَ، وصَلُّوا والنَّاسُ نِيامٌ","result":"تَدْخُلوا الجنَّةَ بسَلامٍ","explicit":true,"star":true,"ref":"الأحاديث المختارة 9 / 432","srcLabel":"متفق عليه","text":["«لمَّا قَدِمَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ المَدينةَ انْجَفَلَ النَّاسُ قِبَلَه فكُنْتُ فيمَن خَرَجَ، فلمَّا رَأيْتُ وَجْهَه عَرَفْتُ أنَّه ليس بوَجْهِ كَذَّابٍ، فكانَ أوَّلَ ما سَمِعْتُه يقولُ: أَطْعِموا الطَّعامَ، و",["أَفْشوا السَّلامَ، وصِلوا الأرْحامَ، وصَلُّوا والنَّاسُ نِيامٌ",1],"؛ ",["تَدْخُلوا الجنَّةَ بسَلامٍ",2],".\nلَفْظُ رِوايةِ الطَّبَرانيِّ.\nورِوايةُ القَطيعيِّ قالَ: لمَّا وَرَدَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ المَدينةَ قالَ: فجِئْتُ في النَّاسِ أَنظُرُ، فلمَّا تَبَيَّنْتُ وَجْهَه عَرَفْتُ أنَّ وَجْهَه ليس بوَجْهِ كَذَّابٍ، فكانَ أوَّلَ شيءٍ سَمِعْتُه يَتَكلَّمُ به أن قالَ: يا أيُّها النَّاسُ أَفْشوا السَّلامَ، وأَطْعِموا الطَّعامَ»."],"grade":"صحيح","narrator":"عبدالله بن سلام","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"آداب السلام › إفشاء السلام","dorar":"FEsbSG2b","merged":9,"otherRefs":["السلسلة الصحيحة 569 (صحيح)","الترغيب والترهيب 2/89 (صحيح)","صحيح الجامع 1019 (صحيح)","فقه السيرة 199 (صحيح)","تخريج المسند لشعيب 8295 (صحيح)","سنن الترمذي 2485 (صحيح)","صحيح الترغيب 2691 (صحيح)","الأربعين المغنية 464 (صحيح)"]},{"id":"س-00150","fp":"b831ec052815","stateId":718,"easy":"إذا أطعمت الطعام وأفشيت السلام ← تورث الجنات","cause":"أَطْعِموا الطَّعامَ وأَفْشوا السَّلامَ","result":"تُورَثوا الجَنَّاتِ","explicit":true,"star":true,"similar":["س-00114","س-00132","س-00144","س-00147"],"ref":"الأحاديث المختارة 9 / 224","srcLabel":"متفق عليه","text":["«كانَ عَبْدُ اللهِ بنُ الحارِثِ يَمُرُّ بِنا فيقولُ: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قالَ: ",["أَطْعِموا الطَّعامَ وأَفْشوا السَّلامَ",1]," ",["تُورَثوا الجَنَّاتِ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن الحارث بن عبد المطلب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"آداب السلام › إفشاء السلام","dorar":"ra2AA3Ja"},{"id":"س-03726","fp":"1df3e7a40470","stateId":718,"easy":"إذا أكلت طيباً وعملت بالسنة وأمن الناس شرك ← تدخل الجنة","cause":"مَن أكَلَ طَيِّبًا، وعَمِلَ في سُنَّةٍ، وأمِنَ النَّاسُ بَوائقَه","result":"دخَلَ الجنَّةَ، قالوا: يا رسولَ اللهِ، إنَّ هذا في أُمَّتِكَ اليومَ كَثيرٌ","explicit":true,"ref":"المستدرك على الصحيحين 7269","srcLabel":"الترمذي","text":[["مَن أكَلَ طَيِّبًا، وعَمِلَ في سُنَّةٍ، وأمِنَ النَّاسُ بَوائقَه؛ ",1],["دخَلَ الجنَّةَ، قالوا: يا رسولَ اللهِ، إنَّ هذا في أُمَّتِكَ اليومَ كَثيرٌ",2],"، قالَ: وسيكونُ في قُرونٍ بَعْدي."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (2520)، والطبراني في ((المعجم الأوسط)) (3520) كلاهما بلفظه مطولا، وابن أبي الدنيا في ((الصمت وآداب اللسان)) (26) مختصرا .","bab":"اعتصام بالسنة › لزوم السنة","dorar":"ZaPArEWH","merged":2,"otherRefs":["الجامع الصغير 8503 (صحيح)"]},{"id":"س-00114","fp":"2f1344567928","stateId":718,"easy":"إذا أفشيت السلام وأطعمت الطعام وجاهدت ← تورث الجنان","cause":"أَفْشُوا السلامَ وأَطْعِمُوا الطعامَ واضْرِبُوا الهامَ","result":"تُورَثُوا الجِنانَ","explicit":true,"repOf":"س-00150","ref":"سنن الترمذي 1854","text":[["أَفْشُوا السلامَ وأَطْعِمُوا الطعامَ واضْرِبُوا الهامَ",1]," ",["تُورَثُوا الجِنانَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح غريب","takhrij":"أخرجه الترمذي (1854)","bab":"آداب السلام › إفشاء السلام","dorar":"xeLX30k3"},{"id":"س-00115","fp":"7c9561ad2a5d","stateId":718,"easy":"إذا بذلت السلام وأحسنت الكلام ← فهو من موجبات المغفرة ودخول الجنة","cause":"إنَّ مِن موجِباتِ المَغفرةِ بَذْلَ السَّلامِ، وحُسْنَ الكلامِ","result":"دُلَّني على عَملٍ يُدخِلُني الجَنَّةَ","explicit":true,"ref":"صحيح الترغيب 2699","srcLabel":"الطبراني","text":["يا رسولَ الله! ",["دُلَّني على عَملٍ يُدخِلُني الجَنَّةَ",2],"؟ قال: ",["إنَّ مِن موجِباتِ المَغفرةِ بَذْلَ السَّلامِ، وحُسْنَ الكلامِ",1]],"grade":"صحيح","narrator":"هانئ بن يزيد بن نهيك أبو شريح","muhaddith":"صحيح","takhrij":"أخرجه الخرائطي في ((مكارم الأخلاق)) (146)، وابن قانع في ((معجم الصحابة)) (3/ 202)، والطبراني (22/ 180) (469) واللفظ لهم.","bab":"آداب السلام › إفشاء السلام","dorar":"P1o9Hv1D"},{"id":"س-00132","fp":"bf6253837e92","stateId":718,"easy":"إذا عبدت الرحمن وأفشيت السلام وأطعمت الطعام ← تدخل الجنان","cause":"اعْبُدوا الرَّحمنَ، وأَفْشوا السَّلامَ، وأَطعِموا الطَّعامَ","result":"تدخُلونَ الجِنانَ","explicit":true,"repOf":"س-00150","ref":"تخريج المسند لشعيب 6587","text":[["اعْبُدوا الرَّحمنَ، وأَفْشوا السَّلامَ، وأَطعِموا الطَّعامَ",1],"؛ ",["تدخُلونَ الجِنانَ",2]," قال عبدُ الصَّمدِ: تدخُلونَ الجنَّةَ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (1855) باختلاف يسير، وابن ماجه (3694) مختصراً، وأحمد (6587) واللفظ له","bab":"آداب السلام › إفشاء السلام","dorar":"wOz5xddw"},{"id":"س-00144","fp":"aba2a1ebdec7","stateId":718,"easy":"إذا عبدت الرحمن وأطعمت الطعام وأفشيت السلام ← تدخل الجنة بسلام","cause":"اعبدُوا الرحمنَ ، و أَطْعِمُوا الطَّعَامَ ، و أَفْشُوا السلامَ","result":"تدخلَوا الجَنَّة بسلامٍ","explicit":true,"repOf":"س-00150","ref":"السلسلة الصحيحة 571","text":[["اعبدُوا الرحمنَ ، و أَطْعِمُوا الطَّعَامَ ، و أَفْشُوا السلامَ",1]," ، ",["تدخلَوا الجَنَّة بسلامٍ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"حسن صحيح","takhrij":"أخرجه الترمذي (1855) واللفظ له، وابن ماجه (3694) مختصراً، وأحمد (6587) باختلاف يسير","bab":"آداب السلام › إفشاء السلام","dorar":"HXMAXTK8"},{"id":"س-00147","fp":"504af72af1c3","stateId":718,"easy":"إذا عبدت الرحمن وأفشيت السلام وأطعمت الطعام ← تدخل الجنان","cause":"اعبُدوا الرحمنَ ، و أفشوا السَّلامَ ، و أطعِمُوا الطعامَ","result":"تَدخلوا الجِنانَ","explicit":true,"repOf":"س-00150","ref":"صحيح الجامع 1041","text":[["اعبُدوا الرحمنَ ، و أفشوا السَّلامَ ، و أطعِمُوا الطعامَ",1]," ، ",["تَدخلوا الجِنانَ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1855) باختلاف يسير، وابن ماجه (3694) مختصراً، والدارمي (2081) واللفظ له","bab":"آداب السلام › إفشاء السلام","dorar":"d0D0Mi4l"},{"id":"س-01547","fp":"42b7ef1c9672","stateId":718,"easy":"إذا طيّبت كلامك وبذلت السلام وأطعمت الطعام ← توجب لك الجنة","cause":"طِيبُ الكلامِ وبَذْلُ السَّلامِ وإطعامُ الطَّعامِ","result":"أخبِرْني بشيءٍ يوجِبُ لي الجنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"similar":["س-00124","س-00139"],"ref":"صحيح ابن حبان 504","srcLabel":"البخاري","text":["أنَّ هانئًا لمَّا وفَد إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم مع قومِه فسمِعهم يُكنُّون هانئًا أبا الحكَمِ فدعاه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فقال: ( إنَّ اللهَ هو الحَكَمُ وإليه الحُكْمُ فلِمَ تُكنَّى أبا الحَكَمِ ) ؟ قال: قومي إذا اختلفوا في شيءٍ رضوا بي حَكَمًا فأحكُمُ بينَهم فقال: ( إنَّ ذلك لَحسَنٌ فما لك مِن الولدِ ) ؟ قال: شُريحٌ وعبدُ اللهِ ومسلِمٌ قال: ( فأيُّهم أكبَرُ ) ؟ قال: شُريحٌ قال: ( فأنتَ أبو شُريحٍ ) فدعا له ولولدِه فلمَّا أراد القومُ الرُّجوعَ إلى بلادِهم أعطى كلَّ رجُلٍ منهم أرضًا حيثُ أحَبَّ في بلادِه قال: أبو شُريحٍ يا رسولَ اللهِ ",["أخبِرْني بشيءٍ يوجِبُ لي الجنَّةَ",2]," قال: ",["( طِيبُ الكلامِ وبَذْلُ السَّلامِ وإطعامُ الطَّعامِ )",1]],"grade":"صحيح","narrator":"هانئ بن يزيد","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (4955)، والنسائي (5387)، والبخاري في ((الأدب المفرد)) (811) باختلاف يسير.","bab":"أسماء › الأسماء المنهي عنها والمكروهة","dorar":"nrSSfPjX","merged":2,"otherRefs":["الترغيب والترهيب 3/368 (صحيح)"]},{"id":"س-00124","fp":"6903ffbbb1af","stateId":718,"easy":"إذا أطعمت الطعام وأفشيت السلام ← يقرّبك من الجنة","cause":"فتطعمُ الطَّعامَ وتفشي السَّلامَ","result":"بعملٍ يقرِّبني منَ الجنَّةِ ويباعدني عنِ النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-01547","otherNeedIds":[66],"ref":"مجمع الزوائد 3/135","text":["أنَّ أعرابيًّا أتى النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ أخبرني ",["بعملٍ يقرِّبني منَ الجنَّةِ ويباعدني عنِ النَّارِ",2]," فقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ أوَ هما أعملتاكَ قالَ نعم قالَ تقولُ العدلَ وتعطي الفضلَ قالَ واللَّهِ لا أستطيعُ أن أقولَ العدلَ كلَّ ساعةٍ وما أستطيعُ أن أعطيَ الفضل قالَ ",["فتطعمُ الطَّعامَ وتفشي السَّلامَ",1]," قالَ هذهِ أيضًا شديدةٌ قالَ فهل لكَ إبلٌ قالَ نعم قالَ فانظر إلى بعيرٍ من إبلِكَ وسقاءٍ ثمَّ اعمد إلى أهلِ بيتٍ لا يشربونَ الماءَ إلَّا غبًّا فاسقِهم فلعلَّكَ لا تهلكُ بعيرَكَ ولا يتخرَّقُ سقاؤكَ حتَّى تجبَ لكَ الجنَّةُ فانطلقَ الأعرابيُّ يكبِّرُ فما انخرقَ سقاؤهُ ولا هلكَ بعيرُهُ حتَّى قُتِلَ شهيدًا"],"grade":"صحيح","narrator":"كدير الضبي","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه عبد الرزاق (19691)، والطبراني في ((المعجم الكبير)) (19/ 187) (422) واللفظ لهما، وابن خزيمة (2503) بنحوه.","bab":"آداب السلام › إفشاء السلام","dorar":"xxPq5FjP"},{"id":"س-00139","fp":"55c7fc413e87","stateId":718,"easy":"إذا أطعمت الطعام وأفشيت السلام وحسّنت الكلام ← توجب لك الجنة","cause":"موجبُ الجنَّةِ: إطعامُ الطعامِ وإفشاءُ السلامِ وحسنُ الكلامِ","result":"حدثني بشيءٍ يوجبُ ليَ الجنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-01547","ref":"المتجر الرابح 289","text":["قلتُ: يا رسولَ اللهِ ",["حدثني بشيءٍ يوجبُ ليَ الجنَّةَ",2],"؟ قال: ",["موجبُ الجنَّةِ: إطعامُ الطعامِ وإفشاءُ السلامِ وحسنُ الكلامِ.",1]],"grade":"صحيح","narrator":"هانئ بن يزيد بن نهيك أبو شريح","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني (467) (22/ 180) واللفظ له، وابن أ[ي خيثمه في ((تاريخه-السفر الثاني)) (212)، وأبو نعيم في ((تاريخ أصبهان)) (1/ 459) باختلاف يسير.","bab":"آداب السلام › إفشاء السلام","dorar":"NEXMmjG9"},{"id":"س-02970","fp":"f9e03a3b28d6","stateId":719,"easy":"إذا عرفت الحق فقضيت به ← فأنت في الجنة","cause":"فرَجُلٌ عَرَفَ الحَقَّ، فقَضى به","result":"فهو في الجنَّةِ","explicit":true,"star":true,"similar":["س-02896"],"ref":"تخريج مشكل الآثار 9/209","srcLabel":"الطحاوي","text":["القُضاةُ ثلاثةٌ: قاضيانِ في النَّارِ، وقاضٍ في الجنَّةِ؛ فأمَّا الذي في الجنَّةِ، ",["فرَجُلٌ عَرَفَ الحَقَّ، فقَضى به",1],"؛ ",["فهو في الجنَّةِ",2],"، ورَجُلٌ عَرَفَ الحَقَّ فلمْ يَقْضِ به، وجار في الحُكمِ؛ فهو في النَّارِ، ورَجلٌ لم يَعرِفِ الحَقَّ، فقَضى للنَّاسِ على جَهلٍ؛ فهو في النَّار."],"grade":"صحيح","muhaddith":"صحيح","bab":"إيمان › الوعيد","dorar":"O3hrjtV1","merged":7,"otherRefs":["صحيح الترمذي 1322 (صحيح)","تخريج الإحياء للعراقي 1/93 (صحيح)","تخريج مشكل الآثار 54 (حسن)","المستدرك على الصحيحين 7207 (صحيح)","المستدرك على الصحيحين 7208 (صحيح)","صحيح الجامع 4298 (صحيح)"]},{"id":"س-01696","fp":"6aa6e7562a7c","stateId":719,"easy":"إذا قضيت فاجتهدت فأصبت ← فلك الجنة","cause":"فرجلٌ قَضَى فَاجْتَهَدَ فأصابَ","result":"فلَهُ الجنةُ","explicit":true,"similar":["س-01697","س-03093"],"ref":"مجمع الزوائد 4/198","srcLabel":"أبو داود","text":["القضاةُ ثلاثةٌ ",["فرجلٌ قَضَى فَاجْتَهَدَ فأصابَ",1]," ",["فلَهُ الجنةُ",2]," ورجلٌ قضى فاجْتَهَدَ فَأَخْطَأَ فله الجنةُ ورجلٌ قضى بجورٍ فَفِي النارِ"],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أبو داود (3573)، والترمذي (1322)، وابن ماجه (2315)، والنسائي في ((السنن الكبرى)) (5922) بنحوه مطولاً، والطبراني في ((المعجم الأوسط)) (3616) واللفظ له.","bab":"أقضية وأحكام › الحكم بالكتاب والسنة ثم باجتهاد الحاكم، والخطأ معذور","dorar":"ueK5IqIo"},{"id":"س-01697","fp":"2a6182d7dbb1","stateId":719,"easy":"إذا قضيت فاجتهدت فأخطأت (بعلم) ← فلك الجنة","cause":"ورجلٌ قضى فاجْتَهَدَ فَأَخْطَأَ","result":"فله الجنةُ","explicit":true,"repOf":"س-01696","ref":"مجمع الزوائد 4/198","text":["القضاةُ ثلاثةٌ فرجلٌ قَضَى فَاجْتَهَدَ فأصابَ فلَهُ الجنةُ ",["ورجلٌ قضى فاجْتَهَدَ فَأَخْطَأَ",1]," ",["فله الجنةُ",2]," ورجلٌ قضى بجورٍ فَفِي النارِ"],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أبو داود (3573)، والترمذي (1322)، وابن ماجه (2315)، والنسائي في ((السنن الكبرى)) (5922) بنحوه مطولاً، والطبراني في ((المعجم الأوسط)) (3616) واللفظ له.","bab":"أقضية وأحكام › الحكم بالكتاب والسنة ثم باجتهاد الحاكم، والخطأ معذور","dorar":"ueK5IqIo"},{"id":"س-03093","fp":"f4a99c73d55e","stateId":719,"easy":"إذا اجتهدت فأصبت الحق ← فأنت في الجنة","cause":"فرجُلٌ اجتهَد فأصاب الحقَّ","result":"فهو في الجنَّةِ","explicit":true,"repOf":"س-01696","ref":"تخريج شرح السنة 2497","text":["قال عليٌّ رَضِي اللهُ عنه: القضاةُ ثلاثةٌ: قاضيانِ في النارِ، وقاضٍ في الجنَّةِ، فأمَّا اللذانِ في النارِ، فرجُلٌ جارَ متعمِّدًا، فهو في النارِ، ورجُلٌ اجتهَد فأخطأ، فهو في النارِ، وأمَّا الذي في الجنَّةِ، ",["فرجُلٌ اجتهَد فأصاب الحقَّ",1],"، ",["فهو في الجنَّةِ",2],".\nقال قتادةُ: فقُلْتُ لأبي العاليةِ: ما ذَنْبُ هذا الذي اجتهَد فأخطأ؟ قال: ذَنْبُهُ أن لا يكونَ قاضيًا إذ لم يَعلَمْ."],"grade":"صحيح","narrator":"أبو العالية","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن الجعد (989)، والطحاوي في ((شرح السنة)) (2498) كلاهما بلفظه، والبيهقي (20383) بنحوه.","bab":"إيمان › الوعيد","dorar":"G5dammmW"},{"id":"س-03051","fp":"8124e8734867","stateId":719,"easy":"إذا وليت قضاء المسلمين فغلب عدلك جورك ← فلك الجنة","cause":"مَن طلَب قضاءَ المُسلِمينَ حتَّى ينالَه ثمَّ غلَب عَدْلُه جَوْرَه","result":"فله الجنَّةُ","explicit":true,"ref":"إرشاد الفقيه 2/390","srcLabel":"أبو داود","text":[["مَن طلَب قضاءَ المُسلِمينَ حتَّى ينالَه ثمَّ غلَب عَدْلُه جَوْرَه، ",1],["فله الجنَّةُ، ",2],"ومَن غلَب جَوْرُه عَدْلَه، فله النَّارُ."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه أبو داود (3575)، والبيهقي (20660)","bab":"إيمان › الوعيد","dorar":"zfz5WSJK"},{"id":"س-02530","fp":"f678c330caed","stateId":719,"easy":"إذا كنت ذا سلطان مقسطاً أو رحيماً رقيق القلب أو عفيفاً ذا عيال ← فأنت من أهل الجنة","cause":"ذو سُلطانٍ مُقسِطٌ مُتَصَدِّقٌ موفَّقٌ، ورَجُلٌ رَحيمٌ رَقيقُ القَلبِ لكُلِّ ذي قُربى ومُسلِمٍ، وعَفيفٌ مُتَعَفِّفٌ ذو عيالٍ","result":"وأهلُ الجَنَّةِ ثَلاثةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح مسلم 2865","srcLabel":"أبو داود","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال ذاتَ يَومٍ في خُطبَتِه: ألا إنَّ رَبِّي أمَرَني أن أُعَلِّمَكُم ما جَهِلتُم ممَّا عَلَّمَني يَومي هذا: كُلُّ مالٍ نَحَلتُه عَبدًا حَلالٌ، وإنِّي خَلَقتُ عِبادي حُنَفاءَ كُلَّهُم، وإنَّهُم أتَتْهمُ الشَّياطينُ فاجتالَتْهم عن دينِهم، وحَرَّمَت عليهم ما أحلَلتُ لهم، وأمَرَتْهم أن يُشرِكوا بي ما لَم أُنزِلْ به سُلطانًا، وإنَّ اللَّهَ نَظَرَ إلى أهلِ الأرضِ فمَقَتَهُم عَرَبَهُم وعَجَمَهُم إلَّا بَقايا مِن أهلِ الكِتابِ، وقال: إنَّما بَعَثتُكَ لأبتَليَكَ وأبتَليَ بكَ، وأنزَلتُ عليكَ كِتابًا لا يَغسِلُه الماءُ، تَقرَؤُه نائِمًا ويَقظانَ. وإنَّ اللَّهَ أمَرَني أن أُحَرِّقَ قُرَيشًا، فقُلتُ: رَبِّ، إذن يَثلَغوا رَأسي فيَدَعوه خُبزةً! قال: استَخرِجْهم كما استَخرَجوكَ، واغزُهم نُغزِكَ، وأنفِقْ فسَنُنفِقُ عليكَ، وابعَثْ جَيشًا نَبعَث خَمسةً مِثلَه، وقاتِلْ بمَن أطاعَكَ مَن عَصاكَ. قال: ",["وأهلُ الجَنَّةِ ثَلاثةٌ",2],[": ذو سُلطانٍ مُقسِطٌ مُتَصَدِّقٌ موفَّقٌ، ورَجُلٌ رَحيمٌ رَقيقُ القَلبِ لكُلِّ ذي قُربى ومُسلِمٍ، وعَفيفٌ مُتَعَفِّفٌ ذو عيالٍ",1],". قال: وأهلُ النَّارِ خَمسةٌ: الضَّعيفُ الذي لا زَبْرَ له، الذينَ هُم فيكُم تَبَعًا، لا يَبتَغونَ أهلًا ولا مالًا، والخائِنُ الذي لا يَخفى له طَمَعٌ وإن دَقَّ إلَّا خانَه، ورَجُلٌ لا يُصبِحُ ولا يُمسي إلَّا وهو يُخادِعُكَ عن أهلِكَ ومالِكَ، وذَكَرَ البُخلَ -أوِ الكَذِبَ- والشِّنظيرُ الفَحَّاشُ. [وفي روايةٍ] لَم يُذكَر: وأنفِقْ فسَنُنفِقُ عليكَ. [وفي روايةٍ] لَم يُذكَر: كُلُّ مالٍ نَحَلتُه عَبدًا حَلالٌ. وفي روايةٍ: قامَ فينا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم ذاتَ يَومٍ خَطيبًا، فقال: إنَّ اللَّهَ أمَرَني... وساقَ الحَديثَ. وزادَ فيه: وإنَّ اللَّهَ أوحى إليَّ أن تَواضَعوا حتَّى لا يَفخَرَ أحَدٌ على أحَدٍ، ولا يَبغي أحَدٌ على أحَدٍ، وقال في حَديثِه: وهم فيكُم تَبَعًا، لا يَبغونَ أهلًا ولا مالًا. فقُلتُ [قتادة]: فيَكونُ ذلك يا أبا عبدِ اللهِ؟ قال: نَعَم، واللَّهِ لقد أدرَكتُهم في الجاهِليَّةِ، وإنَّ الرَّجُلَ لَيَرعى على الحَيِّ، ما به إلَّا وليدَتُهم، يَطَؤُها."],"grade":"صحيح","narrator":"عياض بن حمار","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (17484)، وابن حبان (653)، والطبراني في ((المعجم الكبير)) (17/ 358) (987)، وأبو داود الطيالسي (1175)، باختلاف يسير.","bab":"إيمان › أعمال الجن والشياطين","dorar":"wCEWyYoh","merged":3,"otherRefs":["تخريج المسند لشعيب 18340 (صحيح)","تخريج صحيح ابن حبان 653 (صحيح)"]},{"id":"س-00123","fp":"72b1c005edd4","stateId":719,"easy":"إذا قلت العدل وأعطيت الفضل ← يقرّبك من الجنة ويباعدك من النار","cause":"تقولُ العدلَ وتعطي الفضلَ","result":"بعملٍ يقرِّبني منَ الجنَّةِ ويباعدني عنِ النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[66],"ref":"مجمع الزوائد 3/135","srcLabel":"الطبراني","text":["أنَّ أعرابيًّا أتى النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ أخبرني ",["بعملٍ يقرِّبني منَ الجنَّةِ ويباعدني عنِ النَّارِ",2]," فقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ أوَ هما أعملتاكَ قالَ نعم قالَ ",["تقولُ العدلَ وتعطي الفضلَ",1]," قالَ واللَّهِ لا أستطيعُ أن أقولَ العدلَ كلَّ ساعةٍ وما أستطيعُ أن أعطيَ الفضل قالَ فتطعمُ الطَّعامَ وتفشي السَّلامَ قالَ هذهِ أيضًا شديدةٌ قالَ فهل لكَ إبلٌ قالَ نعم قالَ فانظر إلى بعيرٍ من إبلِكَ وسقاءٍ ثمَّ اعمد إلى أهلِ بيتٍ لا يشربونَ الماءَ إلَّا غبًّا فاسقِهم فلعلَّكَ لا تهلكُ بعيرَكَ ولا يتخرَّقُ سقاؤكَ حتَّى تجبَ لكَ الجنَّةُ فانطلقَ الأعرابيُّ يكبِّرُ فما انخرقَ سقاؤهُ ولا هلكَ بعيرُهُ حتَّى قُتِلَ شهيدًا"],"grade":"صحيح","narrator":"كدير الضبي","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه عبد الرزاق (19691)، والطبراني في ((المعجم الكبير)) (19/ 187) (422) واللفظ لهما، وابن خزيمة (2503) بنحوه.","bab":"آداب السلام › إفشاء السلام","dorar":"xxPq5FjP"},{"id":"س-02896","fp":"7c3d03c677f1","stateId":719,"easy":"إذا عرفت الحق فقضيت به ← فأنت في الجنة","cause":"فرجُلٌ عرَفَ الحَقَّ فقَضى بهِ","result":"فأمَّا الَّذي في الجنَّةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-02970","ref":"إرواء الغليل 2628","text":["القضاةُ ثلاثةٌ : واحِدٌ في الجنةِ واثنَان في النَّارِ ",["فأمَّا الَّذي في الجنَّةِ",2]," ",["فرجُلٌ عرَفَ الحَقَّ فقَضى بهِ",1]," ، ورجلٌ عرفَ الحقَّ فجارَ في الحُكمِ فَهوَ في النَّارِ ، ورجلٌ قَضى للنَّاسِ على جَهْلٍ ، فَهوَ في النَّارِ"],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3573) واللفظ له، والترمذي (1322)، وابن ماجه (2315)، والنسائي في ((السنن الكبرى)) (5922).","bab":"إيمان › الوعد","dorar":"boxobiPX"},{"id":"س-03852","fp":"fdf7e12fe94f","stateId":720,"easy":"إذا بايعت على السمع والطاعة والنفقة والأمر بالمعروف ← فلك الجنة","cause":"تُبايِعوني على السمعِ و الطاعةِ ، في النشاطِ و الكسَلِ ، و النفقةِ في العُسرِ و اليُسرِ ، و على الأمرِ بالمعروفِ و النهيِ عن المنكرِ ، و أن تقولوا في اللهِ ، لا تخافونَ في اللهِ لومةَ لائمٍ ، و على أن تَنصُروني ، فتمنَعوني إذا قدِمتُ عليكم ، مما تمنَعون منه أنفُسَكم و أزواجَكم و أبناءَكم","result":"و لكم الجنَّةُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"السلسلة الصحيحة 63","srcLabel":"مسلم","text":[["تُبايِعوني على السمعِ و الطاعةِ ، في النشاطِ و الكسَلِ ، و النفقةِ في العُسرِ و اليُسرِ ، و على الأمرِ بالمعروفِ و النهيِ عن المنكرِ ، و أن تقولوا في اللهِ ، لا تخافونَ في اللهِ لومةَ لائمٍ ، و على أن تَنصُروني ، فتمنَعوني إذا قدِمتُ عليكم ، مما تمنَعون منه أنفُسَكم و أزواجَكم و أبناءَكم",1]," ",["و لكم الجنَّةُ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (14456)، وابن حبان (6274)، والحاكم (4251) جميعهم مطولا.","bab":"بيعة › البيعة على ماذا تكون","dorar":"fKWxZFdi"},{"id":"س-08389","fp":"b77434010b4d","stateId":720,"easy":"إذا أردت بحبوحة الجنة ← فالزم الجماعة","cause":"فليَلزَمِ الجَماعةَ","result":"فمَن أرادَ منكم بُحبوحةَ الجنَّةِ","explicit":true,"star":true,"otherNeedIds":[31],"ref":"تخريج مشكل الآثار 3708","srcLabel":"البخاري","text":["عن ابن عمر أنَّ عُمَرَ بنَ الخطَّابِ خَطَبَ النَّاسَ بالجابِيةِ، فقال: قام فينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ خَطيبًا مَقامي هذا فيكم، فقال: استَوصوا بأصحابي خيرًا، ثُمَّ الذين يَلونَهم، ثُمَّ يَفشُو الكَذِبُ، حتى إنَّ الرَّجُلَ ليَبدَأُ بالشَّهادةِ قبلَ أنْ يُسأَلَها، وباليَمينِ قبلَ أنْ يُسأَلَها، ",["فمَن أرادَ منكم بُحبوحةَ الجنَّةِ",2],"؛ ",["فليَلزَمِ الجَماعةَ",1],"؛ فإنَّ الشَّيطانَ مع الواحدِ، وهو مِن الاثنَينِ أبعدُ، ولا يَخلوَنَّ أحدُكم بامرأةٍ؛ فإنَّ الشَّيطانَ ثالثُهما، ومَن سَرَّتْه حَسَنتُه، وساءتْه سيِّئتُه؛ فهو مؤمنٌ، هكذا حَدَّثَنا محمَّدُ بنُ عليٍّ هذا الحديثَ، فقال فيه: بُحبوحةُ الجنَّةِ، قال: وقال عبدُ اللهِ، وقال غيرُه -كأنَّه يَعني غير محمَّدِ بنِ سُوقةَ-: بَحبَحةُ الجنَّةِ."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح على شرح البخاري","takhrij":"أخرجه أحمد (114)، وابن حبان (7254)، والحاكم (387) مطولاً باختلاف يسير","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"DzdB7trU","merged":9,"otherRefs":["تخريج كتاب السنة 88 (صحيح)","المستدرك على الصحيحين 392 (صحيح)","الأحكام الوسطى 2/ 374 (صحيح)","تخريج مشكل الآثار 3719 (صحيح)","المستدرك على الصحيحين 395 (صحيح)","تخريج شرح السنة 9 / 27 (صحيح)","الأحاديث المختارة 155 (صحيح)","الأحاديث المختارة 157 (صحيح)"]},{"id":"س-08355","fp":"9bb2155960b3","stateId":720,"easy":"إذا لزمت الجماعة ← فالشيطان مع الواحد وهو من الاثنين أبعد","cause":"فَلْيَلْزَمِ الجَماعَةَ","result":"فإنَّ الشَّيْطانَ مَعَ الواحِدِ، وهو مِنَ الاثْنَيْنِ أَبْعَدُ","explicit":true,"otherNeedIds":[31,25],"ref":"المستدرك على الصحيحين 392","srcLabel":"الترمذي","text":["خطبنا عمر بالجابية، فقال: إنِّي قُمْتُ فيكُمْ كمَقامِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فينا، فقالَ: «أوصيكُمْ بأَصْحابي، ثُمَّ الَّذين يَلونَهُمْ، ثُمَّ الَّذين يَلونَهُم، ثُمَّ يَفْشو الكَذِبُ حتَّى يَحْلِفَ الرَّجُلُ ولا يُسْتَحْلَفُ، ويَشْهَدُ الرَّجُلُ ولا يُسْتَشْهَدُ، فَمَنْ أَرادَ مِنْكُمْ بُحْبوحَةَ الجَنَّةِ ",["فَلْيَلْزَمِ الجَماعَةَ",1],"؛ ",["فإنَّ الشَّيْطانَ مَعَ الواحِدِ، وهو مِنَ الاثْنَيْنِ أَبْعَدُ",2],"، أَلا لا يَخْلوَنَّ رَجُلٌ بامْرَأَةٍ إلَّا كان ثالِثُهُما الشَّيْطانُ -قالَها ثلاثًا- وعَلَيْكُمْ بالجَماعَةِ، فإنَّ الشَّيْطانَ مع الواحِدِ وهو مِنَ الاثْنَينِ أَبْعَدُ، ألا وَمَن سَرَّتْهُ حَسَنتْهُ وساءتْهُ سَيِّئتُهُ فهو مُؤْمِنٌ»."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه الترمذي (2165)، وأحمد (114)، والنسائي في ((الكبرى)) (9181) جميعهم بلفظ مقارب.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"H6t62CbP","merged":2,"otherRefs":["الأحاديث المختارة 157 (صحيح)"]},{"id":"س-05859","fp":"dbb42ba20f46","stateId":720,"easy":"إذا لزمت جماعة الناس ← تسكن وسط الجنة","cause":"فالزمْ جماعةَ الناسِ","result":"أن تسكنَ وسطَ الجنةِ","explicit":true,"ref":"مجمع الزوائد 5/225","srcLabel":"سعيد","text":["قال لي عبدُ اللهِ بنُ مسعودٍ يا حارثُ بنُ قيسٍ أليسَ يسرُّكَ ",["أن تسكنَ وسطَ الجنةِ",2]," قال نعمْ قال ",["فالزمْ جماعةَ الناسِ",1]],"grade":"حسن","narrator":"الحارث بن قيس","muhaddith":"رجاله ثقات","takhrij":"أخرجه سعيد بن منصور في ((السنن)) (5716)، وابن أبي شيبة (38606) باختلاف يسير","bab":"رقائق وزهد › الوصايا النافعة","dorar":"hAtjEeEi"},{"id":"س-01769","fp":"c94e793a2848","stateId":720,"easy":"إذا لزمت الجماعة ← تكون من الفرقة التي في الجنة","cause":"الجماعَةُ","result":"واحدةٌ في الجنَّةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح ابن ماجه 3241","srcLabel":"ابن ماجه","text":["افترقتِ اليَهودُ علَى إحدَى وسبعينَ فرقةً فواحدةٌ في الجنَّةِ وسبعونَ في النَّارِ وافترقتِ النَّصارى علَى ثِنتينِ وسبعينَ فرقةً فإحدَى وسبعونَ في النَّارِ وواحدةٌ في الجنَّةِ والَّذي نفسُ محمَّدٍ بيدِهِ لتفترِقَنَّ أمَّتي علَى ثلاثٍ وسبعينَ فرقةً ",["واحدةٌ في الجنَّةِ",2]," وثِنتانِ وسبعونَ في النَّار قيلَ يا رسولَ اللَّهِ مَن هم قالَ ",["الجماعَةُ",1]],"grade":"صحيح","narrator":"عوف بن مالك الأشجعي","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (3992)، والطبراني في ((مسند الشاميين)) (988)، واللالكائي في ((شرح أصول الاعتقاد)) (149)، واللفظ لهم.","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"tRxzTyaS","merged":2,"otherRefs":["السلسلة الصحيحة 204 (صحيح)"]},{"id":"س-07345","fp":"21451ec079f9","stateId":720,"easy":"إذا أردت بحبوحة الجنة ← فالزم الجماعة","cause":"فَلْيَلْزَمْ الجماعةَ","result":"فَمَنْ أراد بَحْبَحَةَ الجنةِ","explicit":true,"ref":"تخريج كتاب السنة 897","srcLabel":"ابن أبي عاصم","text":["عليكم بالجماعةِ وإياكم والفُرْقَةَ ",["فَمَنْ أراد بَحْبَحَةَ الجنةِ",2]," ",["فَلْيَلْزَمْ الجماعةَ",1]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"صحيح","bab":"فتن › كراهية الاختلاف","dorar":"t4FjSa86"},{"id":"س-08334","fp":"61b4e0817218","stateId":721,"easy":"إذا أثنى عليك الناس خيراً ← وجبت لك الجنة","cause":"مَن أثنَيتُم عليه خَيرًا","result":"وجَبَت له الجَنَّةُ","explicit":true,"star":true,"similar":["س-04116"],"otherNeedIds":[23],"ref":"صحيح مسلم 949","srcLabel":"متفق عليه","text":["مُرَّ بجِنازةٍ فأُثنيَ عليها خَيرًا، فقال نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّم: وجَبَت، وجَبَت، وجَبَت، ومُرَّ بجِنازةٍ فأُثنيَ عليها شَرًّا، فقال نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّم: وجَبَت، وجَبَت، وجَبَت، قال عُمَرُ: فِدًى لكَ أبي وأُمِّي، مُرَّ بجِنازةٍ، فأُثنيَ عليها خَيرٌ، فقُلتَ: وجَبَت، وجَبَت، وجَبَت، ومُرَّ بجِنازةٍ، فأُثنيَ عليها شَرٌّ، فقُلتَ: وجَبَت، وجَبَت، وجَبَت، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["مَن أثنَيتُم عليه خَيرًا ",1],["وجَبَت له الجَنَّةُ، ",2],"ومَن أثنَيتُم عليه شَرًّا وجَبَت له النَّارُ، أنتُم شُهَداءُ اللهِ في الأرضِ، أنتُم شُهَداءُ اللهِ في الأرضِ، أنتُم شُهَداءُ اللهِ في الأرضِ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1367)، ومسلم (949).","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"6C8bFfIJ","merged":19,"otherRefs":["مجموع الفتاوى 28/371 (صحيح)","شرح الطحاوية 378 (صحيح)","تخريج المسند لشعيب 10076 (صحيح)","تخريج مشكل الآثار 3305 (صحيح)","مجمع الزوائد 7/3 (صحيح)","صحيح البخاري 2642 (صحيح)","مجموع الفتاوى 15/305 (صحيح)","تخريج المسند لشعيب 13996 (صحيح)","مجمع الزوائد 8/3 (صحيح)","صحيح النسائي 1932 (صحيح)","تخريج المسند لشعيب 10471 (صحيح)","تخريج صحيح ابن حبان 3027 (صحيح)","تخريج المسند لشعيب 10836 (صحيح)","تخريج المسند لشعيب 10013 (صحيح)","تخريج المسند لشعيب 7552 (صحيح)","تخريج صحيح ابن حبان 3025 (صحيح)","تخريج المسند لشعيب 13039 (صحيح)","تخريج مشكل الآثار 3301 (صحيح)"]},{"id":"س-03383","fp":"d6f229768e6f","stateId":721,"easy":"إذا شهد لك ثلاثة بالخير ← وجبت لك الجنة","cause":"ما من مسلمٍ يشهدُ لَه ثلاثةٌ","result":"إلَّا وجبت لَه الجنَّةُ","explicit":true,"star":true,"ref":"صحيح الترمذي 1059","srcLabel":"البخاري","text":["مرُّوا بجنازةٍ فأثنوا عليها خيرًا فقالَ عمرُ وجبت فقلتُ لعمرَ وما وجبت قالَ أقولُ كما قالَ رسولُ اللهِ صلَّى اللَّهُ عليهِ وسلَّمَ قال ",["ما من مسلمٍ يشهدُ لَه ثلاثةٌ",1]," ",["إلَّا وجبت لَه الجنَّةُ",2]," قالَ قلنا واثنانِ قالَ واثنانِ قالَ ولم نسأل رسولَ اللهِ صلَّى اللَّهُ عليهِ وسلَّمَ عنِ الواحدِ"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1059) بلفظه، والبخاري (1368)، والنسائي (1934) كلاهما  بلفظ مقارب","bab":"استغفار › أسباب المغفرة","dorar":"85rrwSRy"},{"id":"س-07221","fp":"65be8361ab1f","stateId":721,"easy":"إذا شهد لك أربعة بخير ← يدخلك الله الجنة","cause":"أيُّما مُسلِمٍ شَهِدَ له أربَعةٌ بخَيرٍ","result":"أدخَلَهُ اللهُ الجَنَّةَ","explicit":true,"similar":["س-02918"],"ref":"تخريج المسند لشاكر 1/84","srcLabel":"البخاري","text":["أتَيتُ المَدينةَ فوافَيتُها وقد وقَعَ فيها مَرَضٌ، فهم يَموتونَ مَوتًا ذَريعًا، فجلَستُ إلى عُمَرَ بنِ الخَطَّابِ رَضيَ اللهُ عنه، فمَرَّتْ به جِنازةٌ، فأُثْنيَ على صاحِبِها خَيرٌ، فقال عُمَرُ رَضيَ اللهُ عنه: وجَبَتْ. ثم مُرَّ بأُخرى، فأُثْنيَ على صاحِبِها خَيرٌ، فقال عُمَرُ رَضيَ اللهُ عنه: وجَبَتْ. ثم مُرَّ بالثَّالِثةِ، فأُثْنيَ عليها شَرٌّ، فقال عُمَرُ رَضيَ اللهُ عنه: وجَبَتْ. فقال أبو الأسوَدِ: ما وجَبَتْ يا أميرَ المُؤمِنينَ؟ قال: قُلتُ كما قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["أيُّما مُسلِمٍ شَهِدَ له أربَعةٌ بخَيرٍ، ",1],["أدخَلَهُ اللهُ الجَنَّةَ",2],". قال: فقُلنا: وثَلاثةٌ؟ قال: فقال: وثَلاثةٌ. قال: قُلنا: واثنانِ؟ قال: واثنانِ. قال ثم لم نَسألْهُ عنِ الواحِدِ."],"grade":"صحيح","narrator":"أبو الأسود الديلي","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (2643)","bab":"علم › حسن السؤال ونصح العالم","dorar":"5qPvyBlr"},{"id":"س-02918","fp":"1233cd5afc26","stateId":721,"easy":"إذا شهد لك أربعة أو ثلاثة أو اثنان بخير ← تدخل الجنة","cause":"مَن شَهدَ له أربَعةٌ، أو ثَلاثةٌ، أوِ اثنانِ","result":"دَخل الجَنَّة","explicit":true,"repOf":"س-07221","ref":"فتاوى صديق خان 644","text":[["مَن شَهدَ له أربَعةٌ، أو ثَلاثةٌ، أوِ اثنانِ، ",1],["دَخل الجَنَّة",2],"."],"grade":"صحيح","muhaddith":"صحيح.","bab":"إيمان › الوعد","dorar":"dojgpZ7Q"},{"id":"س-04192","fp":"34ea79f3e593","stateId":721,"easy":"إذا صلى على جنازتك ثلاثة صفوف ← فقد أوجبت","cause":"منْ صلَّى عليه ثلاثةُ صفوفٍ","result":"فقد أوجَبَ","explicit":true,"ref":"تحفة المحتاج 2/23","srcLabel":"أبو داود","text":["كان مالكُ بنُ هُبيرةَ رضي الله عنه إذا صلى على جَنازةٍ فاستقلَّ الناسَ عليها جزَّأهم ثلاثةَ أجزاءٍ ثم قال قال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ",["منْ صلَّى عليه ثلاثةُ صفوفٍ",1]," ",["فقد أوجَبَ",2]],"grade":"صحيح","narrator":"مالك بن هبيرة","muhaddith":"صحيح أو حسن [كما اشترط على نفسه في المقدمة]","takhrij":"أخرجه الترمذي (1028) واللفظ له، وأبو داود (3166)، وابن ماجة (1490) باختلاف يسير.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"oxovQpWy"},{"id":"س-04116","fp":"3e4b660b7526","stateId":721,"easy":"إذا أثنى عليك المؤمنون خيراً ← وجبت لك الجنة","cause":"نِعْمَ المَرْءُ ما عَلِمْنا؛ إنْ كان لعَفيفًا مُسلمًا","result":"وَجَبَتْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-08334","ref":"المستدرك على الصحيحين 3102","text":["كنتُ مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في جِنازةٍ فينا في بني سَلِمَةَ، وأنا أمْشي إلى جنبِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ رَجلٌ: ",["نِعْمَ المَرْءُ ما عَلِمْنا؛ إنْ كان لعَفيفًا مُسلمًا",1],"، إنْ كان. فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «أنتَ الَّذي تقولُ؟». قالَ: يا رسولَ اللهِ، ذاك بَدا لنا، واللهُ أعلمُ بالسَّرائرِ. فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «",["وَجَبَتْ",2],"». قالَ: وكنَّا معه في جِنازةِ رَجلٍ مِن بني حارِثَةَ -أوْ مِن بني عبدِ الأشْهَلِ- فقالَ رَجلٌ: بئسَ المَرْءُ ما عَلِمْنا؛ إنْ كان لفظًّا غليظًا، إنْ كان، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «أنتَ الَّذي تقولُ؟». قالَ: يا رسولَ اللهِ، اللهُ أعلمُ بالسَّرائرِ، فأمَّا الَّذي بَدا لنا منه فذاك، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «وَجَبَتْ». ثُمَّ تلا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: {وَكَذَلِكَ جَعَلْنَاكُمْ أُمَّةً وَسَطًا لِتَكُونُوا شُهَدَاءَ عَلَى النَّاسِ وَيَكُونَ الرَّسُولُ عَلَيْكُمْ شَهِيدًا} [البقرة: 143]."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح الإسناد","bab":"جنائز وموت › الثناء على الجنازة والعكس","dorar":"c2FVgvzE"},{"id":"س-04198","fp":"bcd0b55e1c8d","stateId":721,"easy":"إذا أحسن الناس الثناء عليك ← فأنت من أهل الجنة","cause":"بالثَّناءِ الحسَنِ والثَّناءِ السَّيِّئِ","result":"أهلَ الجنَّةِ مِن أهلِ النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[70],"ref":"صحيح ابن حبان 7384","srcLabel":"ابن ماجه","text":["سمِعْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم يقولُ في خُطبتِه بالنَّباءةِ أو النَّباوةِ مِن الطَّائفِ : ( تُوشِكونَ أنْ تعلَموا ",["أهلَ الجنَّةِ مِن أهلِ النَّارِ",2]," أو خيارَكم مِن شِرارِكم ولا أعلَمُه إلَّا قال : أهلَ الجنَّةِ مِن أهلِ النَّارِ ) فقال رجُلٌ مِن المُسلِمينَ : بمَ يا رسولَ اللهِ ؟ قال : ( ",["بالثَّناءِ الحسَنِ والثَّناءِ السَّيِّئِ",1]," أنتم شُهداءُ بعضُكم على بعضٍ )"],"grade":"صحيح","narrator":"أبو زهير الثقفي","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن ماجه (4221)، وأحمد (15439) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"dAIT4ZMx","merged":5,"otherRefs":["مصباح الزجاجة 4/241 (صحيح)","المستدرك على الصحيحين 8564 (صحيح)","الإصابة في تمييز الصحابة 4/77 (حسن)","مجمع الزوائد 10/274 (صحيح)"]},{"id":"س-07439","fp":"69a4b3eb7804","stateId":722,"easy":"إذا كنت شهيداً أو عبداً أحسن عبادة ربه أو عفيفاً متعففاً ذا عيال ← تكون من أول من يدخل الجنة","cause":"فالشَّهيدُ، وعبدٌ مملوكٌ أحسنَ عبادةَ ربِّهِ، ونَصحَ لسيِّدِهِ، وعفيفٌ مُتعفِّفٌ ذو عيالٍ","result":"أوَّلُ ثُلَّةٍ يدخلونَ الجنَّةَ","explicit":true,"ref":"صحيح ابن خزيمة 4/ 11","srcLabel":"أحمد","text":["عُرِضَ عليَّ ",["أوَّلُ ثُلَّةٍ يدخلونَ الجنَّةَ",2],"، وأوَّلُ ثُلَّةٍ يدخُلونَ النَّارَ، فأمَّا أوَّلُ ثُلَّةٍ يدخلونَ الجنَّةَ: ",["فالشَّهيدُ، وعبدٌ مملوكٌ أحسنَ عبادةَ ربِّهِ، ونَصحَ لسيِّدِهِ، وعفيفٌ مُتعفِّفٌ ذو عيالٍ",1],"، وأمَّا أوَّلُ ثلَّةٍ يدخلونَ النَّارَ: فأميرٌ مُسلَّطٌ، وذو ثَروةٍ مِن مالٍ لا يؤدِّي حقَّ اللَّهِ في مالِهِ، وفَقيرٌ فخورٌ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (9492)، والحاكم (1429)، والطيالسي (2690) بنحوه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"thGyc1mt","merged":2,"otherRefs":["الترغيب والترهيب 3/79 (صحيح)"]},{"id":"س-08306","fp":"e00b6858632e","stateId":722,"easy":"إذا كنت عاقلاً ← لا تعثر إلا رفعك الله حتى يجعل مصيرك إلى الجنة","cause":"أن لا يَعثَرَ عاقلٌ","result":"إلا رفعَه اللهُ حتى يجعلَ مصيرَه إلى الجنَّةِ","explicit":true,"otherNeedIds":[54],"ref":"مجمع الزوائد 6/285","srcLabel":"الطبراني","text":["أنا الشاهدُ على اللهِ ",["أن لا يَعثَرَ عاقلٌ",1]," ",["إلا رفعَه اللهُ حتى يجعلَ مصيرَه إلى الجنَّةِ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن أبي الدنيا في ((العقل وفضله)) (1)، والطبراني في ((المعجم الأوسط)) (6083)","bab":"مناقب وفضائل › بعض من شهد النبي بأنهم من أهل الجنة","dorar":"NBiLKrVM"},{"id":"س-03715","fp":"a5e4038d2b7a","stateId":722,"easy":"إذا لم تحمل نفسك من التشديد ما لا تطيق ← فأبشر بالجنة إن لزمت الطريق","cause":"لا تحمِلوا على الأنفسِ مِن التَّشديدِ ما لا تُطيقونَ وأبشِروا","result":"فإنَّ لكم الجنَّةَ إذا لزِمْتُم طريقتي في التَّسديدِ وقارَبْتُم في الأعمالِ","explicit":true,"star":true,"ref":"تخريج صحيح ابن حبان 358","srcLabel":"متفق عليه","text":["مرَّ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم على رهطٍ مِن أصحابِه وهم يضحَكون فقال: ( لو تعلَمون ما أعلَمُ لضحِكْتُم قليلًا ولبكَيْتُم كثيرًا ) فأتاه جبريلُ فقال: إنَّ اللهَ يقولُ لك: لِمَ تُقنِّطُ عبادي ؟ قال: فرجَع إليهم فقال: ( سدِّدوا وقارِبوا وأبشِروا ) قال أبو حاتمٍ رضِي اللهُ عنه: ( سدِّدوا ) يُريدُ به: كونوا مسدِّدينَ، والتَّسديدُ لزومُ طريقةِ النَّبيِّ صلَّى اللهُ عليه وسلَّم واتِّباعُ سنَّتِه، وقولُه: ( وقارِبوا ) يُريدُ به: ",["لا تحمِلوا على الأنفسِ مِن التَّشديدِ ما لا تُطيقونَ وأبشِروا ",1],["فإنَّ لكم الجنَّةَ إذا لزِمْتُم طريقتي في التَّسديدِ وقارَبْتُم في الأعمالِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن حبان (113) واللفظ له، والبخاري (6637)، والترمذي (2313) كلاهما مختصرا.","bab":"اعتصام بالسنة › لزوم السنة","dorar":"gOKQhmbz"},{"id":"س-00159","fp":"dab93fd02a14","stateId":722,"easy":"إذا عملت بخصلة من خصال الخير رجاء ثوابها وتصديق موعودها ← يدخلك الله بها الجنة","cause":"ما مِن عامِلٍ يَعمَلُ بخَصلةٍ منها رَجاءَ ثَوابِها، وتَصديقَ مَوعودِها","result":"إلَّا أدخَلَه اللهُ بها الجَنَّةَ","explicit":true,"star":true,"ref":"صحيح البخاري 2631","srcLabel":"متفق عليه","text":["قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أربَعونَ خَصلةً، أعلاهنَّ مَنيحةُ العَنزِ، ",["ما مِن عامِلٍ يَعمَلُ بخَصلةٍ منها رَجاءَ ثَوابِها، وتَصديقَ مَوعودِها",1],"؛ ",["إلَّا أدخَلَه اللهُ بها الجَنَّةَ",2],". قال حَسَّانُ: فعَدَدنا ما دونَ مَنيحةِ العَنزِ، مِن رَدِّ السَّلامِ، وتَشميتِ العاطِسِ، وإماطةِ الأذى عَنِ الطَّريقِ، ونَحوِه؛ فما استَطَعنا أن نَبلُغَ خَمسَ عَشرةَ خَصلةً."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[صحيح]","takhrij":"من أفراد البخاري على مسلم","bab":"آداب السلام › فضل السلام والرد عليه","dorar":"tPhHn2wn","merged":3,"otherRefs":["صحيح الجامع 891 (صحيح)","تخريج المسند لشاكر 11/78 (صحيح)"]},{"id":"س-03217","fp":"c4abc4f100c5","stateId":722,"easy":"إذا طلبت خصلة من خصال الخير ← تأخذ بيدك حتى تدخلك الجنة","cause":"ما من مؤمنٍ يطلبُ خَصلةً من هذه الخصالِ","result":"إلا أخذَتْ بيدِه حتى تُدخِلَه الجنَّةَ","explicit":true,"star":true,"similar":["س-02616"],"ref":"صحيح الترغيب 876","srcLabel":"متفق عليه","text":["ما ذا يُنجي العبدُ من النَّارِ ؟ قال : الإيمانُ بالله . قلتُ : يا نبيَّ اللهِ مع الإيمانِ عملٌ ؟ قال : أن تُرضِخَ مما خوَّلك اللهُ ، و تُرضِخَ مما رزقك اللهُ . قلتُ : يا نبيَّ اللهِ فإن كان فقيرًا لا يجدُ ما يرضَخُ ؟ قال : يأمرُ بالمعروفِ ، و ينهى عن المنكرِ . قلتُ : إن كان لايستطيعُ أن يأمرَ المعروفَ ، و لا ينهى عن المنكرِ ؟ قال : \" فلْيُعِنِ الأَخْرَقَ \" . قلتُ : يا رسولَ اللهِ : أرأيتَ ، إن كان لا يحسنُ أن يصنعَ ؟ قال : فلْيُعِنْ مظلومًا . قلتُ : يا نبيَّ اللهِ أرأيتَ إن كان ضعيفًا لا يستطيعُ أن يُعينَ مظلومًا ؟ قال : ما تريدُ أن تترك لصاحبِك من خيرٍ ؟ لِيُمْسِكْ أذاه عن الناسِ . قلتُ : يا رسولَ اللهِ أرأيتَ إن فعل هذا يدخلُه الجنَّةَ ؟ قال : ",["ما من مؤمنٍ يطلبُ خَصلةً من هذه الخصالِ",1]," ",["إلا أخذَتْ بيدِه حتى تُدخِلَه الجنَّةَ",2]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"حسن صحيح","takhrij":"أخرجه الطبراني (2/156) (1650)، وابن حبان (373)، والحاكم (213) باختلاف يسير. وأخرجه البخاري (2518)، ومسلم (84) مختصراً بنحوه","bab":"إيمان › فضل الإيمان","dorar":"io61WM9M"},{"id":"س-07914","fp":"1e91fcad76bf","stateId":722,"easy":"إذا أصبحت صائماً وتبعت جنازة وأطعمت مسكيناً وعدت مريضاً ← دخلت الجنة","cause":"مَنْ أصبحَ اليومَ مِنكمْ صائِمًا","result":"ما اجتمعَ هذه الخِصالُ في رجلٍ في يَوْمٍ ، إلَّا دخلَ الجنةَ","explicit":true,"apply":{"k":"time","t":"في الصباح"},"similar":["س-08254","س-08251"],"ref":"صحيح الأدب المفرد 400","srcLabel":"متفق عليه","text":[["مَنْ أصبحَ اليومَ مِنكمْ صائِمًا ؟",1]," قال أبو بكرٍ : أنا قال : مَنْ عادَ مِنكمْ مَرِيضًا ؟ ، قال أبو بكرٍ : أنا قال : مَنْ شَهِدَ مِنْكُمُ اليومَ جَنازَةً ؟ ، قال أبو بكرٍ : أنا ، قال : مَنْ أَطْعَمَ اليومَ مِسْكِينًا ؟ ، قال أبو بكرٍ : أنا ، قال : ",["ما اجتمعَ هذه الخِصالُ في رجلٍ في يَوْمٍ ، إلَّا دخلَ الجنةَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1028)، والبخاري في ((الأدب المفرد)) (515) واللفظ له","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"KhCnNPuG"},{"id":"س-08254","fp":"c312fcf306ad","stateId":722,"easy":"إذا أصبحت صائماً وعدت مريضاً وتبعت جنازة وأطعمت مسكيناً ← دخلت الجنة","cause":"مَن أصبَحَ مِنكُمُ اليومَ صائِمًا","result":"ما اجتَمَعنَ في امرِئٍ، إلَّا دَخَلَ الجَنَّةَ","explicit":true,"apply":{"k":"time","t":"في الصباح"},"repOf":"س-07914","ref":"صحيح مسلم 1028","text":[["مَن أصبَحَ مِنكُمُ اليومَ صائِمًا؟",1]," قال أبو بَكرٍ رَضيَ اللهُ عنه: أنا، قال: فمَن تَبِعَ مِنكُمُ اليومَ جِنازةً؟ قال أبو بَكرٍ رَضيَ اللهُ عنه: أنا، قال: فمَن أطعَمَ مِنكُمُ اليومَ مِسكينًا؟ قال أبو بَكرٍ رَضيَ اللهُ عنه: أنا، قال: فمَن عادَ مِنكُمُ اليومَ مَريضًا؟ قال أبو بَكرٍ رَضيَ اللهُ عنه: أنا، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["ما اجتَمَعنَ في امرِئٍ، إلَّا دَخَلَ الجَنَّةَ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"مناقب وفضائل › أبو بكر الصديق","dorar":"iC5GQUF6"},{"id":"س-08346","fp":"eb07d0f8a10a","stateId":722,"easy":"إذا داومت على عمل صالح ← تُدعى من بابه في الجنة","cause":"لكُلِّ أهْلِ عَمَلٍ","result":"بابٌ مِن أبوابِ الجنَّةِ، يُدعَوْن منه بذلكَ العَمَلِ","explicit":true,"ref":"تخريج المسند لشعيب 9800","srcLabel":"متفق عليه","text":[["لكُلِّ أهْلِ عَمَلٍ",1]," ",["بابٌ مِن أبوابِ الجنَّةِ، يُدعَوْن منه بذلكَ العَمَلِ",2],"، ولِأَهلِ الصِّيامِ بابٌ يُدعَوْن منه، يُقالُ له: الرَّيانُ. فقال أبو بكرٍ: يا رسولَ اللهِ، هل أحدٌ يُدعى مِن تلكَ الأبوابِ كُلِّها؟ قال: نَعَمْ، وأنا أرجو أنْ تَكونَ منهم يا أبا بكرٍ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1897)، ومسلم (1027)، والترمذي (3674)، والنسائي (2238) مطولاً، وأحمد (9800) واللفظ له","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"cri4f4zS"},{"id":"س-06311","fp":"750528b36183","stateId":722,"easy":"إذا عملت بخصلة منها تبتغي وجه الله ← تأخذ بيدك يوم القيامة حتى تدخلك الجنة","cause":"ما مِنْهُنَّ خَصْلَةٌ يَعْمَلُ بها عَبْدٌ يَبْتَغي بها وَجْهَ اللهِ","result":"إلَّا أَخَذَتْ بيدِهِ يوْمَ القيامَةِ فَلَمْ تُفارِقْهُ حتَّى تُدْخِلَهُ الجَنَّةَ","explicit":true,"ref":"المستدرك على الصحيحين 213","srcLabel":"مسلم","text":["عن أَبي كَثِيرٍ الزُّبَيْديّ، عنْ أَبيهِ، وكان يُجالِسُ أبا ذَرٍّ، قالَ: فَجَمَعَ حَديثًا فَلَقيَ أبا ذَرٍّ وهو عندَ الجَمْرَةِ الوسْطَى وحَوْلَهُ النَّاسُ، قالَ: فَجَلَسْتُ إليهِ حتَّى مَسَّتْ رُكْبَتي رُكْبَتَهُ، فَنَسِيتُ ذلك الحَديثَ وتَفَلَّتْ مِنِّي كُلُّ شَيءٍ أَرَدْتُ أَنْ أَسْأَلَهُ عنه، فَرَفَعْتُ رَأْسي إلى السَّماءِ، فجَعَلْتُ أتَذَكَّرُ، فقُلْتُ: يا أبا ذَرٍّ، دُلَّني على عَمَلٍ إذا عَمِلَ بهِ العَبْدُ دَخَل الجَنَّةَ، قالَ: قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «تُؤمِنُ باللهِ». قُلتُ: يا رسولَ اللهِ، إنَّ معَ الإيمانِ عَمَلًا؟ قالَ: «يَرْضَخُ مِمَّا رَزَقَهُ اللهُ». قُلتُ: يا رسولَ اللهِ، فإنْ كان مُعْدَمًا لا شَيءَ لهُ؟ قالَ: «يَقولُ مَعْروفًا بِلسانِهِ». قُلتُ: فإنْ كان عَيِيًّا لا يَبْلُغُ عنه لِسانُهُ؟ قالَ: «فَلْيُعِنْ مَغْلوبًا». قُلتُ: فإنْ كان ضَعيفًا لا قُوَّةَ له؟ قالَ: «فَلْيَصْنَعْ لِأَخْرَقَ». قُلتُ: فإنْ كان أَخْرقَ؟ فالتَفَتَ إليَّ فقالَ: «ما تُريدُ أنْ تَدَعَ في صاحِبِكَ خَيْرًا؟». قالَ: «يَدَعُ النَّاسَ مِنْ أَذاهُ». قُلتُ: يا رسولَ اللهِ، إنَّ هذا لَيَسيرٌ كُلُّهُ. قالَ: «والَّذي نَفْسي بيدِهِ ",["ما مِنْهُنَّ خَصْلَةٌ يَعْمَلُ بها عَبْدٌ يَبْتَغي بها وَجْهَ اللهِ",1]," ",["إلَّا أَخَذَتْ بيدِهِ يوْمَ القيامَةِ فَلَمْ تُفارِقْهُ حتَّى تُدْخِلَهُ الجَنَّةَ",2],"»."],"grade":"صحيح","muhaddith":"صحيح على شرط مسلم","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"qJenJzTM","merged":2,"otherRefs":["صحيح ابن حبان 373 (صحيح)"]},{"id":"س-06617","fp":"6d831a039797","stateId":722,"easy":"إذا كنت من أهل الصلاة أو الجهاد أو الصيام أو الصدقة ← تُدعى من الباب الخاص بعملك","cause":"فمَن كان مِن أهلِ الصَّلاةِ","result":"دُعيَ مِن بابِ الصَّلاةِ، ومَن كان مِن أهلِ الجِهادِ دُعيَ مِن بابِ الجِهادِ، ومَن كان مِن أهلِ الصِّيامِ دُعيَ مِن بابِ الرَّيَّانِ، ومَن كان مِن أهلِ الصَّدَقةِ دُعيَ مِن بابِ الصَّدَقةِ","explicit":true,"otherNeedIds":[47],"ref":"صحيح البخاري 1897","srcLabel":"مسلم","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: مَن أنفَقَ زَوجَينِ في سَبيلِ اللهِ نوديَ مِن أبوابِ الجَنَّةِ: يا عَبدَ اللهِ، هذا خَيرٌ، ",["فمَن كان مِن أهلِ الصَّلاةِ",1]," ",["دُعيَ مِن بابِ الصَّلاةِ، ومَن كان مِن أهلِ الجِهادِ دُعيَ مِن بابِ الجِهادِ، ومَن كان مِن أهلِ الصِّيامِ دُعيَ مِن بابِ الرَّيَّانِ، ومَن كان مِن أهلِ الصَّدَقةِ دُعيَ مِن بابِ الصَّدَقةِ",2],"، فقال أبو بَكرٍ رَضيَ اللهُ عنه: بأبي أنتَ وأُمِّي يا رَسولَ اللهِ، ما على مَن دُعيَ مِن تلك الأبوابِ مِن ضَرورةٍ، فهل يُدعى أحَدٌ مِن تلك الأبوابِ كُلِّها؟ قال: نَعَم، وأرجو أن تَكونَ منهم."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1027) باختلاف يسير","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"ZctSLGE5"},{"id":"س-02616","fp":"1b5824668938","stateId":722,"easy":"إذا فعلت خصلة من هؤلاء الخصال ← تأخذ بيدك حتى تدخلك الجنة","cause":"ما من مسلمٍ يفعلُ خَصلةً من هؤلاء","result":"إلا أخذَتْ بيدِه حتى تدخلَه الجنَّةَ","explicit":true,"repOf":"س-03217","ref":"المتجر الرابح 291","text":["سألتُ أبا ذرٍّ قلتُ: دلَّني على عملٍ إذا عملَ العبدُ به دخلَ الجنَّةَ؟ قال: سألتُ عن ذلك رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ قال: يؤمنُ باللهِ واليومِ الآخرِ قلتُ: يا رسولَ اللهِ إنَّ مع الإيمانِ عملًا؟ قال: يرضخُ مما رزقَه اللهُ قلتُ: يا رسولَ اللهِ أرأيتَ إن كان فقيرًا لا يجدُ ما يرضخُ به؟ قال: يأمرُ بالمعروفِ وينهى عن المنكرِ قلتُ: يا رسولَ اللهِ أرأيتَ إن كان عيِيًّا لا يستطيعُ أنْ يأمرَ بالمعروفِ وينهى عن المنكرِ؟ قال: يصنعُ لِأَخرقَ قلتُ: أرأيتَ إن كان أخرقَ؟ قلت: يعينُ مغلوبًا قال: أرأيتَ إن كان ضعيفًا لا يستطيعُ أنْ يعينَ مغلوبًا؟ قال: ما تريدُ أنْ يكونَ صاحبُك من خيرٍ يمسِكُ عن أذَى الناسِ فقلتُ: يا رسولَ اللهِ إذا فعل ذلك دخل الجنَّةَ؟ قال: ",["ما من مسلمٍ يفعلُ خَصلةً من هؤلاء",1]," ",["إلا أخذَتْ بيدِه حتى تدخلَه الجنَّةَ",2],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (373)، والطبراني (2/156) (1650)","bab":"إيمان › الأمر بالإيمان بالله تعالى ورسوله وشرائع الدين","dorar":"7ligBSWu"},{"id":"س-02221","fp":"ff710f3110bf","stateId":722,"easy":"إذا عملت عملاً صالحاً ← يكون لك باب في الجنة تُدعى منه","cause":"لِكُلِّ عاملٍ","result":"بابٌ من أبوابِ الجنَّةِ يُدعَى منهُ بذلِكَ العملِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"فتح الباري لابن حجر 7/34","srcLabel":"متفق عليه","text":[["لِكُلِّ عاملٍ",1]," ",["بابٌ من أبوابِ الجنَّةِ يُدعَى منهُ بذلِكَ العملِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (9800) باختلاف يسير، وأخرجه البخاري (1897)، ومسلم (1027) مطولاً بمعناه","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"uN7ZOXuu"},{"id":"س-08251","fp":"d0558e711747","stateId":722,"easy":"إذا صمت وتبعت جنازة وأطعمت مسكيناً وعدت مريضاً في يوم ← تدخل الجنة","cause":"مَن أصبحَ منكُمُ اليومَ صائمًا؟ فَقالَ أبو بَكْرٍ: أَنا، فقالَ: مَن أطعمَ منكُمُ اليومَ مِسكينًا","result":"ما اجتَمَعت هذِهِ الخِصالُ قطُّ في رجُلٍ إلَّا دَخلَ الجنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-07914","ref":"صحيح ابن خزيمة 3/ 530","text":[["مَن أصبحَ منكُمُ اليومَ صائمًا؟ فَقالَ أبو بَكْرٍ: أَنا، فقالَ: مَن أطعمَ منكُمُ اليومَ مِسكينًا؟",1]," قالَ أبو بَكْرٍ: أَنا، فقالَ: مَن تبعَ منكمُ اليومَ جَنازةً؟ فقالَ أبو بَكْرٍ: أَنا، قالَ: من عادَ منكمُ اليومَ مَريضًا؟ قالَ أبو بَكْرٍ: أَنا، فَقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: ",["ما اجتَمَعت هذِهِ الخِصالُ قطُّ في رجُلٍ إلَّا دَخلَ الجنَّةَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (1028)، والنسائي في ((الكبرى)) (8053)، والبخاري في ((الأدب المفرد)) (515) باختلاف يسير.","bab":"مناقب وفضائل › أبو بكر الصديق","dorar":"ZwDz4khn"},{"id":"س-00377","fp":"30d854ade02e","stateId":723,"easy":"إذا كنت ضعيفاً مظلوماً ← فأنت من أهل الجنة","cause":"همُ الضعفاءُ المظلومونَ، ألَا أُنبِئُكم بأهلِ النَّارِ؟ كلُّ شديدٍ جَعْظَرِيٍّ","result":"ألَا أُنبِئُكم بأهلِ الجنَّةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"تخريج المسند لشعيب 8821","srcLabel":"أحمد","text":[["ألَا أُنبِئُكم بأهلِ الجنَّةِ",2],"؟",[" همُ الضعفاءُ المظلومونَ، ألَا أُنبِئُكم بأهلِ النَّارِ؟ كلُّ شديدٍ جَعْظَرِيٍّ.",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (8821) واللفظ له، والطيالسي (2674)، والبزار (9442)","bab":"آداب عامة › الأخلاق المذمومة","dorar":"SNb2Cc00"},{"id":"س-07319","fp":"f362dc0578c7","stateId":723,"easy":"إذا ابتُليت فصبرت ← تدخل الجنة قبل الأغنياء وذوي السلطان","cause":"ربَّنا ابتَلَيْتَنا فصبَرْنا وآتَيْتَ الأموالَ والسُّلطانَ غيرَنا","result":"فيدخُلونَ الجنَّةَ قبْلَ النَّاسِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[9],"ref":"صحيح ابن حبان 7419","srcLabel":"الطبراني","text":["تجتمِعونَ يومَ القيامةِ فيُقالُ : أينَ فُقَراءُ هذه الأُمَّةِ ومساكينُها ؟ قال : فيقومونَ فيُقالُ لهم : ماذا عمِلْتُم ؟ فيقولونَ : ",["ربَّنا ابتَلَيْتَنا فصبَرْنا وآتَيْتَ الأموالَ والسُّلطانَ غيرَنا",1]," فيقولُ اللهُ : صدَقْتُم قال : ",["فيدخُلونَ الجنَّةَ قبْلَ النَّاسِ",2]," ويَبقى شِدَّةُ الحِسابِ على ذوي الأموالِ والسُّلطانِ ) قالوا : فأينَ المُؤمِنونَ يومَئذٍ ؟ قال : ( يُوضَعُ لهم كراسِيُّ مِن نورٍ وتُظلَّلُ عليهم الغَمامُ يكونُ ذلكَ اليومُ أقصَرَ على المُؤمِنينَ مِن ساعةٍ مِن نهارٍ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الطبراني (13/553) (14445)، وأبو نعيم في ((حلية الأولياء)) (7/206) باختلاف يسير","bab":"فتن › فتنة المال","dorar":"canpDkxD"},{"id":"س-04488","fp":"837aaa699a68","stateId":723,"easy":"إذا كنت من فقراء المهاجرين ← تكون من أول زمرة تدخل الجنة","cause":"فقراءُ المهاجرينَ","result":"أوَّلَ زُمرةٍ تدخُلُ الجنَّةَ مِن أُمَّتي","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 11/134","srcLabel":"مسلم","text":["عن عبدِ اللهِ بنِ عمرٍو قال: قال لى رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: أتعلَمُ ",["أوَّلَ زُمرةٍ تدخُلُ الجنَّةَ مِن أُمَّتي",2],"؟ قُلْنا: اللهُ ورسولُه أعلَمُ، قال: ",["فقراءُ المهاجرينَ",1],"، يَأْتُونَ يومَ القيامةِ إلى بابِ الجنَّةِ، ويستفتِحونَ، فتقولُ لهم الخَزَنةُ: أوَقَدْ حوسِبْتُمْ؟ قالوا: بأيِّ شيءٍ تحاسِبونا، وإنَّما كانتْ أسيافُنا على عواتقِنا في سَبيلِ اللهِ حتى مِتْنا على ذلك، قال: فيُفتَحُ لهم، فيَقيلونَ فيها أربعينَ عامًا قبلَ أنْ يدخُلَها النَّاسُ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"على شرط مسلم","takhrij":"أخرجه الحاكم (2389)، والبيهقي في ((شعب الإيمان)) (4260)","bab":"جهاد › فضل الجهاد","dorar":"KUNwOwVM"},{"id":"س-06045","fp":"b8c75539477b","stateId":723,"easy":"إذا كنت من فقراء المهاجرين ← تسبق الأغنياء إلى الجنة بأربعين خريفاً","cause":"إنَّ فُقَراءَ المُهاجِرينَ","result":"يَسبِقونَ الأغنياءَ يَومَ القيامةِ إلى الجَنَّةِ بأربَعينَ خَريفًا","explicit":true,"star":true,"otherNeedIds":[9,65],"ref":"صحيح مسلم 2979","srcLabel":"أحمد","text":["وجاءَ ثَلاثةُ نَفَرٍ إلى عبدِ اللهِ بنِ عَمرِو بنِ العاصِ وأنا عِندَه، فقالوا: يا أبا مُحَمَّدٍ، إنَّا واللَّهِ ما نَقدِرُ على شَيءٍ؛ لا نَفَقةٍ، ولا دابَّةٍ، ولا مَتاعٍ، فقال لهم: ما شِئتُم؛ إن شِئتُم رَجَعتُم إلينا فأعطَيناكُم ما يَسَّرَ اللهُ لَكُم، وإن شِئتُم ذَكَرنا أمرَكُم للسُّلطانِ، وإن شِئتُم صَبَرتُم، فإنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["إنَّ فُقَراءَ المُهاجِرينَ",1]," ",["يَسبِقونَ الأغنياءَ يَومَ القيامةِ إلى الجَنَّةِ بأربَعينَ خَريفًا",2],"، قالوا: فإنَّا نَصبِرُ، لا نَسألُ شيئًا."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[صحيح]","takhrij":"أخرجه أبو عوانة (12959) واللفظ له، وأحمد (6578)، وابن حبان (3628)، والطبراني (13/ 23) (42) مختصرا.","bab":"رقائق وزهد › فضل الصبر","dorar":"iiM31Gnf","merged":18,"otherRefs":["سنن الترمذي 2353 (صحيح)","صحيح الجامع 7976 (صحيح)","صحيح الترغيب 3186 (صحيح)","تخريج المسند لشعيب 9823 (صحيح)","المصابيح في الأحاديث المتواترة 629 (صحيح)","صحيح الترغيب 3189 (صحيح)","تخريج المسند لشعيب 10730 (صحيح)","تخريج المسند لشعيب 10654 (صحيح)","سنن الترمذي 2354 (صحيح)","اختيار الأولى 99 (صحيح)","مجموع الفتاوى 11/120 (صحيح)","عدة الصابرين 1/269 (صحيح)","الجامع الصغير 7521 (حسن)","صحيح الجامع 4228 (صحيح)","كشف المناهج والتناقيح 4/394 (صحيح)","تخريج صحيح ابن حبان 677 (صحيح)"]},{"id":"س-07578","fp":"c736775a0638","stateId":723,"easy":"إذا كنت ضعيفاً متضعفاً ← فأنت من أهل الجنة","cause":"كُلُّ ضَعيفٍ مُتضَعِّفٍ لو أقسم على اللهِ لأبَرَّه، ألا أخبِرُكم بأهلِ النَّارِ؟ كُلُّ عُتُلٍّ جوَّاظٍ جَعْظَريٍّ مُستكبِرٍ","result":"ألا أخبِرُكم بأهلِ الجنَّةِ","explicit":true,"ref":"المصابيح في الأحاديث المتواترة 603","srcLabel":"المصابيح في الأحاديث المتواترة","text":["إنَّها كانت صلاةَ رغبةٍ ورهبةٍ، سألتُ اللهَ فيها ثلاثًا، فأعطاني اثنتَينِ ومنعني واحدةً، سألتُه ألَّا يُسلِّطَ على أمَّتي عدوًّا من غيرِهم فيجتاحَهم، فأعطانيها، وسألتُه ألَّا يرسِلَ عليهم سَنةً فتُدَمِّرَهم، فأعطانيها، وسألتُه ألَّا يجعَلَ بأسَهم بينهم فزواها عنِّي. ",["ألا أخبِرُكم بأهلِ الجنَّةِ",2],"؟",[" كُلُّ ضَعيفٍ مُتضَعِّفٍ لو أقسم على اللهِ لأبَرَّه، ألا أخبِرُكم بأهلِ النَّارِ؟ كُلُّ عُتُلٍّ جوَّاظٍ جَعْظَريٍّ مُستكبِرٍ",1]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"فضائل النبي وصفته ودلائل النبوة › شفقته على أمته","dorar":"gcivwW6y","merged":7,"otherRefs":["صحيح مسلم 2853 (صحيح)","صحيح البخاري 6657 (صحيح)","المستدرك على الصحيحين 203 (صحيح)","تخريج المسند لشعيب 23131 (صحيح)","تخريج الإحياء للعراقي 4/244 (صحيح)","صحيح الجامع 2627 (صحيح)"]},{"id":"س-00385","fp":"79b405cd8f89","stateId":723,"easy":"إذا كنت ضعيفاً متضعفاً ← فأهل الجنة كل ضعيف متضعف لو أقسم على الله لأبره","cause":"فكلُّ ضَعيفٍ مُتَضَعِّفٍ، أشعَثَ ذي طِمرَيْنِ، لو أقسَمَ على اللهِ لأَبرَّه","result":"أمَّا أهلُ الجَنَّةِ","explicit":true,"ref":"تخريج المسند لشعيب 12476","srcLabel":"أحمد","text":["عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ أنَّه قال: ألَا أُخبِرُكم بأهلِ النَّارِ وأهلِ الجَنَّةِ؟ ",["أمَّا أهلُ الجَنَّةِ",2],"، ",["فكلُّ ضَعيفٍ مُتَضَعِّفٍ، أشعَثَ ذي طِمرَيْنِ، لو أقسَمَ على اللهِ لأَبرَّه",1],"، وأمَّا أهلُ النَّارِ، فكُلُّ جَعْظَريٍّ جَوَّاظٍ، جمَّاعٍ منَّاعٍ، ذي تَبَعٍ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (12476) واللفظ له، والحارث في ((المسند)) (1103) مطولاً، وأبو يعلى (3987) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"Pxas77Ky"},{"id":"س-02878","fp":"a3672ba1d709","stateId":723,"easy":"إذا كنت من ضعفاء الناس ← فأنت من أهل الجنة","cause":"ضُعفاءُ النَّاسِ وسَقَطُهم","result":"أي رَبِّ، ما لها يَدخُلُها","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"similar":["س-05737","س-02968"],"ref":"تخريج المسند لشعيب 10588","srcLabel":"متفق عليه","text":["اختصَمَتِ الجنَّةُ والنَّارُ، فقالتِ الجنَّةُ: ",["أي رَبِّ، ما لها يَدخُلُها",2]," ",["ضُعفاءُ النَّاسِ وسَقَطُهم",1],"؟ وقالت النَّارُ: يا رَبِّ، ما لها يَدخُلُها الجَبَّارون والمُتكَبِّرون؟ قال للجنَّةِ: أنتِ رَحمَتي أُصيبُ بكِ مَن أشاءُ، وقال للنَّارِ: أنتِ عَذابي أُصيبُ بكِ مَن أشاءُ، ولكُلِّ واحِدةٍ منكما مِلؤُها. قال: فأمَّا الجنَّةُ؛ فإنَّ اللهَ عزَّ وجلَّ لا يَظلِمُ مِن خَلقِهِ أحدًا، وإنَّه يُنشِئُ لها مِن خَلقِهِ ما شاءَ، وأمَّا النَّارُ؛ فيُلقَوْن فيها، وتَقولُ: هل مِن مَزيدٍ؟ ويُلقَوْن فيها، وتَقولُ: هل مِن مَزيدٍ، حتى يَضَعَ رَبُّنا عزَّ وجلَّ فيها قَدَمَهُ، فهُنالك تَمتَلئُ ويَنزَوي بَعضُها إلى بَعضٍ، وتَقولُ: قَطْ قَطْ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (7449)، ومسلم (2846)، والنسائي في ((السنن الكبرى)) (7740)، وأحمد (10588) واللفظ له","bab":"إيمان › الوعد","dorar":"RBlv8xU3"},{"id":"س-05737","fp":"c1de00fdc757","stateId":723,"easy":"إذا كنت من الضعفاء المغلوبين ← فأنت من أهل الجنة","cause":"الضُّعفاءُ المَغلوبونَ","result":"وأمَّا أهلُ الجَنَّةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-02878","ref":"تخريج المسند لشعيب 17585","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال له: يا سُراقةُ، ألَا أُخبِرُكَ بأهلِ الجَنَّةِ وأهلِ النارِ؟ قال: بَلى يا رسولَ اللهِ، قال: أمَّا أهلُ النارِ، فكلُّ جَعْظَريٍّ جَوَّاظٍ مُستَكبِرٍ، ",["وأمَّا أهلُ الجَنَّةِ",2]," ",["الضُّعفاءُ المَغلوبونَ",1],"."],"grade":"صحيح","narrator":"سراقة بن مالك","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (17585) واللفظ له، والطبراني (7/129) (6589)، والحاكم (6597)","bab":"رقائق وزهد › الكبر والتواضع","dorar":"SUd50FzR","merged":2,"otherRefs":["يقظة أولي الاعتبار 112 (صحيح)"]},{"id":"س-02968","fp":"8457130e5abd","stateId":723,"easy":"إذا كنت من الضعفاء والفقراء والمساكين ← تدخل الجنة","cause":"الضُّعَفاءُ والفُقراءُ والمساكينُ","result":"أيْ ربِّ، يَدخُلُني","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-02878","ref":"تخريج المسند لشعيب 11099","text":["\"افتَخَرتِ الجَنَّةُ والنَّارُ، فقالتِ النَّارُ: يا ربِّ، يَدخُلُني الجَبابرةُ والمُتكبِّرونَ والمُلوكُ والأشرافُ، وقالتِ الجَنَّةُ: ",["أيْ ربِّ، يَدخُلُني",2]," ",["الضُّعَفاءُ والفُقراءُ والمساكينُ",1],"، فيقولُ اللهُ تبارَك وتعالى للنَّارِ: أنتِ عَذابي أُصيبُ بكِ مَن أَشاءُ، وقال للجَنَّةِ: أنتِ رَحمَتي وسِعَتْ كلَّ شيءٍ، ولكلِّ واحدةٍ منكما مِلْؤُها، فيُلْقى في النَّارِ أهلُها، فتقولُ: هل من مَزيدٍ؟ قال: ويُلْقى فيها، وتقولُ: هل من مَزيدٍ؟ ويُلْقى فيها، وتقولُ: هل من مَزيدٍ؟ حتى يَأتِيَها تبارَك وتعالى، فيضَعُ قدَمَه عليها فتُزْوى، فتقولُ: قَدِي قَدِي، وأمَّا الجَنَّةُ فيَبْقى فيها أهلُها ما شاء اللهُ أنْ يَبْقى، فيُنشئُ اللهُ لها خَلْقًا ما يَشاءُ\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (11099) واللفظ له، وعبد بن حميد (906)، وأبو يعلى (1313)","bab":"إيمان › الوعيد","dorar":"Ezp3c6FA"},{"id":"س-02623","fp":"c0e883f534bb","stateId":724,"easy":"إذا رجحت حسناتك على سيئاتك ولو بحسنة ← يوسع الله لك في الجنة","cause":"يُؤتَى بحَسَناتِ العبدِ وسيِّئاتِه، فيُقَصُّ بعضُها ببَعضٍ، فإنْ بَقِيَتْ حَسَنةٌ","result":"وسَّعَ اللهُ له في الجنَّةِ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 7850","srcLabel":"الطبراني","text":["عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، عنِ الرُّوحِ الأمينِ قالَ: قالَ: قال الرَّبُّ عزَّ وجلَّ: ",["يُؤتَى بحَسَناتِ العبدِ وسيِّئاتِه، فيُقَصُّ بعضُها ببَعضٍ، فإنْ بَقِيَتْ حَسَنةٌ",1],"، ",["وسَّعَ اللهُ له في الجنَّةِ",2],". \n قالَ: فدخَلْتُ على يَزْدادَ، فحَدَّثَنا بمثْلِ هذا الحديثِ، قلْتُ لهُ: فإنْ ذهَبَتِ الحَسنةُ؟ قالَ: {أُولَئِكَ الَّذِينَ نَتَقَبَّلُ عَنْهُمْ أَحْسَنَ مَا عَمِلُوا} وقَرأَ إلى قولِهِ: {يُوعَدُونَ} [الأحقاف: 16]، قلْتُ له: أفَرأيْتَ قولَهُ عزَّ وجلَّ: {فَلَا تَعْلَمُ نَفْسٌ مَا أُخْفِيَ لَهُمْ مِنْ قُرَّةِ أَعْيُنٍ} [السجدة: 17] ؟ وقالَ: العبْدُ يَعمَلُ سِرًّا أجْرُهُ على اللهِ عزَّ وجلَّ، فلا يَعْلَمُ به النَّاسُ، فأسَرَّ اللهُ له يومَ القيامةِ قُرَّةَ عيْنٍ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه عبد بن حميد في ((المنتخب من مسنده)) (661)، والبزار (5272)، والدولابي في ((الكنى والأسماء)) (1987)، والطبراني (12832) (12/  183) بنحوه","bab":"إيمان › الإيمان بالوحي","dorar":"GLYl8HAd","merged":2,"otherRefs":["تخريج العواصم والقواصم 9/ 77 (حسن)"]},{"id":"س-07259","fp":"adf802d5f8f3","stateId":724,"easy":"إذا كنت سابقاً بالخيرات أو مقتصداً ← تدخل الجنة بغير حساب","cause":"السابقُ بالخيراتِ والمقتصدُ","result":"يدخلونَ الجنةَ بغيرِ حسابٍ","explicit":true,"star":true,"otherNeedIds":[65],"ref":"مجمع الزوائد 7/99","srcLabel":"أحمد","text":["سمعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ  فمنهم ظالِمٌ لنفْسِهِ ومنهم مقتصِدٌ ومنهم سابِقٌ بالخيراتِ  قال ",["السابقُ بالخيراتِ والمقتصدُ",1]," ",["يدخلونَ الجنةَ بغيرِ حسابٍ",2]," والظالِمُ لنفسِهِ يحاسَبُ حسابًا يسيرًا ثم يدخلُ الجنةَ"],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (21727)، وعبد الرزاق في ((تفسيره)) (2449)، وابن الفاخر في ((موجبات الجنة)) (277) بنحوه تامًا.","bab":"علم › ما بثه رسول الله صلى الله عليه وسلم من العلم","dorar":"HxLXqO3Z"},{"id":"س-07260","fp":"4208bd722b46","stateId":724,"easy":"إذا كنت ظالماً لنفسك (مع الإيمان) ← تُحاسب حساباً يسيراً ثم تدخل الجنة","cause":"والظالِمُ لنفسِهِ","result":"يحاسَبُ حسابًا يسيرًا ثم يدخلُ الجنةَ","explicit":true,"ref":"مجمع الزوائد 7/99","srcLabel":"أحمد","text":["سمعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ  فمنهم ظالِمٌ لنفْسِهِ ومنهم مقتصِدٌ ومنهم سابِقٌ بالخيراتِ  قال السابقُ بالخيراتِ والمقتصدُ يدخلونَ الجنةَ بغيرِ حسابٍ ",["والظالِمُ لنفسِهِ",1]," ",["يحاسَبُ حسابًا يسيرًا ثم يدخلُ الجنةَ",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (21727)، وعبد الرزاق في ((تفسيره)) (2449)، وابن الفاخر في ((موجبات الجنة)) (277) بنحوه تامًا.","bab":"علم › ما بثه رسول الله صلى الله عليه وسلم من العلم","dorar":"HxLXqO3Z"},{"id":"س-04101","fp":"93b34d8cedc5","stateId":724,"easy":"إذا عملت صالحاً ← فإنما تدخل الجنة برحمة الله","cause":"إلَّا أن يَتغمَّدَنيَ","result":"يُدخلُه عَملُه الجنَّةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[24],"ref":"المطالب العالية 4/215","srcLabel":"ابن حبان","text":["ما منكُم من أحدٍ إلَّا ومَعهُ شيطانٌ ، قالوا : ومعَكَ ؟ قال صلَّى اللهُ عليهِ وسلَّمَ : ومَعي إلَّا أنَّ اللهَ تعالى أَعانَنِي عليهِ فَأسلمَ ، وما مِنكُم مِن أحدٍ ",["يُدخلُه عَملُه الجنَّةَ",2]," . قالوا : ولا أَنتَ ؟ قال صلَّى اللهُ عليهِ وسلَّمَ : ولا أنا ",["إلَّا أن يَتغمَّدَنيَ",1]," اللهُ [ بِرحمَةٍ ]"],"grade":"صحيح","narrator":"شريك بن طارق","muhaddith":"صحيح","takhrij":"أخرجه ابن قانع في ((معجم الصحابة)) (1/ 338)، والبغوي في ((معجم الصحابة)) (1246) كلاهما بلفظه، وأخرجه الطبراني (7221، 7222) (7 / 309) مفرقًا باختلاف يسير، وأخرجه ابن حبان (6416) مختصرًا باختلاف يسير","bab":"جن › صفة إبليس وجنوده","dorar":"pBVT7wKb","merged":3,"otherRefs":["صحيح ابن ماجه 3405 (صحيح)","صحيح مسلم 2816 (صحيح)"]},{"id":"س-02237","fp":"bffa77426f3f","stateId":724,"easy":"إذا كُتبت لك حسنة عند الله ← يدخلك بها الجنة","cause":"ومَنْ كَتَبَ لَهُ عندَهُ حسنَةً","result":"أدْخَلَهُ بِها الجنَّةَ","explicit":true,"ref":"صحيح الجامع 5985","srcLabel":"الطبراني","text":["مَنْ أخرجَ مِنْ طريقِ المسلمينَ شيئًا يُؤْذِيهم ، كتبَ اللهُ لَهُ بِهِ حسَنَةً ، ",["ومَنْ كَتَبَ لَهُ عندَهُ حسنَةً ",1],["أدْخَلَهُ بِها الجنَّةَ",2]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (32)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"y3cJvS1l"},{"id":"س-07861","fp":"bd64d37a7143","stateId":724,"easy":"إذا بقيت لك حسنة واحدة بعد المقاصة ← يوسع الله لك في الجنة","cause":"يؤتَى بسيئاتِ العبدِ وحسناتِه فيقتصُّ بعضُها ببعضٍ فإنْ بقيَت له حسنةٌ واحدةٌ","result":"وسَّع اللهُ له في الجنةِ","explicit":true,"similar":["س-07854"],"ref":"لوائح الأنوار السنية 2/187","srcLabel":"ابن أبي الدنيا","text":["قال الربُّ تباركَ وتعالَى : ",["يؤتَى بسيئاتِ العبدِ وحسناتِه فيقتصُّ بعضُها ببعضٍ فإنْ بقيَت له حسنةٌ واحدةٌ",1]," ",["وسَّع اللهُ له في الجنةِ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن أبي الدنيا في ((التوبة)) (153)، وابن أبي حاتم في ((التفسير)) (19066)، والطبري في ((التفسير)) (22/116) باختلاف يسير","bab":"قيامة › الحساب والقصاص","dorar":"YkUlVR6f"},{"id":"س-07854","fp":"f2e332092f9d","stateId":724,"easy":"إذا بقيت لك حسنة واحدة بعد القصاص ← يدخلك الله بها الجنة","cause":"فإنْ بقِيَتْ حسنةٌ واحدةٌ","result":"أدخَله اللهُ الجَنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-07861","ref":"مجمع الزوائد 10/220","text":["قال الرَّبُّ عَزَّ وجَلَّ يؤتى بحسناتِ العبدِ وسيِّئاتِه يومَ القيامةِ فيَقيضُ بعضَها ببعضٍ ",["فإنْ بقِيَتْ حسنةٌ واحدةٌ",1]," ",["أدخَله اللهُ الجَنَّةَ",2]," قال قلتُ فإنْ لم يبْقَ قال { أُولَئِكَ الَّذِينَ نَتَقَبَّلُ عَنْهُمْ أَحْسَنَ مَا عَمِلُوا وَنَتَجَاوَزُ عَنْ سَيِّئَاتِهِمْ فِي أَصْحَابِ الْجَنَّةِ } قال قلتُ أرأَيْتَ قولَه { فَلَا تَعْلَمُ نَفْسٌ مَا أُخْفِيَ لِهُمْ مِنْ قُرَّةِ أَعْيُنٍ } قال هو العبدُ يعمَلُ السِّرَّ أسَرَّه اللهُ له يومَ القيامةِ فيرى قُرَّةَ أعينٍ"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده جيد","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (12/ 183) (12832)،والحاكم (7641 )، والبيهقي في ((شعب الإيمان)) (6515 )","bab":"قيامة › الحساب والقصاص","dorar":"8OMxOm6Y"}]}