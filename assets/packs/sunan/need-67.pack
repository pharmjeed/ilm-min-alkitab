{"schema":1,"kind":"sunan-chunk","version":"sunan-cb5af5731a1c","needId":67,"stateIds":[687,688,689,690,691,692,693,694,695,696,697,698,699,700,701,702,703,704,705,706,707,708,709,710,711,712,713,714,715,716,717,718,719,720,721,722,723,724],"items":[{"id":"س-05618","fp":"90a5ee6b4fa1","stateId":687,"easy":"إذا مت لا تشرك بالله شيئاً ← دخلت الجنة وإن زنيت وإن سرقت","cause":"مَن ماتَ مِن أُمَّتي لا يُشرِكُ باللهِ شيئًا","result":"دَخَلَ الجَنَّةَ، قُلتُ: يا رَسولَ اللهِ، وإن زَنى وإن سَرَقَ","explicit":true,"star":true,"similar":["س-02435","س-01007","س-02443","س-03479","س-02382","س-02471","س-03032","س-03654","س-01090","س-02395","س-02410","س-02439","س-02452","س-02476","س-02717","س-02821","س-03775","س-04230","س-04744","س-05818","س-06365","س-01215","س-01216","س-02438","س-07894","س-02718","س-05471","س-00849"],"ref":"صحيح البخاري 6268","srcLabel":"متفق عليه","text":["كُنتُ أمشي مع النَّبيِّ صلَّى اللهُ عليه وسلَّم في حَرَّةِ المَدينةِ عِشاءً، استَقبَلَنا أُحُدٌ، فقال: يا أبا ذَرٍّ، ما أُحِبُّ أنَّ أُحُدًا لي ذَهَبًا يَأتي عليَّ لَيلةٌ أو ثَلاثٌ عِندي منه دينارٌ إلَّا أرصُدُه لدَينٍ، إلَّا أن أقولَ به في عِبادِ اللهِ هَكَذا وهَكَذا وهَكَذا، وأرانا بيَدِه، ثُمَّ قال: يا أبا ذَرٍّ، قُلتُ: لَبَّيكَ وسَعدَيكَ يا رَسولَ اللهِ، قال: الأكثَرونَ هُمُ الأقَلُّونَ إلَّا مَن قال هَكَذا وهَكَذا، ثُمَّ قال لي: مَكانَكَ لا تَبرَحْ يا أبا ذَرٍّ حتَّى أرجِعَ، فانطَلَقَ حتَّى غابَ عَنِّي، فسَمِعتُ صَوتًا، فخَشيتُ أن يَكونَ عُرِضَ لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فأرَدتُ أن أذهَبَ، ثُمَّ ذَكَرتُ قَولَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم: لا تَبرَحْ، فمَكُثتُ، قُلتُ: يا رَسولَ اللهِ، سَمِعتُ صَوتًا خَشيتُ أن يَكونَ عُرِضَ لَكَ، ثُمَّ ذَكَرتُ قَولَكَ فقُمتُ، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ذاكَ جِبريلُ، أتاني فأخبَرَني أنَّه ",["مَن ماتَ مِن أُمَّتي لا يُشرِكُ باللهِ شيئًا ",1],["دَخَلَ الجَنَّةَ، قُلتُ: يا رَسولَ اللهِ، وإن زَنى وإن سَرَقَ",2],"؟ قال: وإن زَنى وإن سَرَقَ، قُلتُ لزَيدٍ: إنَّه بَلَغَني أنَّه أبو الدَّرداءِ، فقال: أشهَدُ لَحدَّثَنيه أبو ذَرٍّ بالرَّبَذةِ. قال الأعمَشُ: وحدَّثَني أبو صالِحٍ، عن أبي الدَّرداءِ، نَحوَه، وقال أبو شِهابٍ، عَنِ الأعمَشِ: يَمكُثُ عِندي فوقَ ثَلاثٍ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6268)، ومسلم (94)","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"QpySJ3jY","merged":23,"otherRefs":["حلية الأولياء 3/38 (صحيح)","صحيح الجامع 64 (صحيح)","تخريج المسند لشاكر 5/223 (صحيح)","تخريج صحيح ابن حبان 3326 (صحيح)","تخريج المسند لشعيب 13560 (صحيح)","تخريج المسند لشعيب 12606 (صحيح)","صحيح البخاري 129 (صحيح)","تخريج المسند لشعيب 4232 (صحيح)","فتح البيان 12/ 97 (صحيح)","تخريج المسند لشعيب 14711 (صحيح)","إتحاف الخيرة المهرة 1/119 (حسن)","حلية الأولياء 1/288 (صحيح)","إتحاف الخيرة المهرة 1/118 (حسن)","صحيح البخاري 2388 (صحيح)","صحيح البخاري 6444 (صحيح)","مجمع الزوائد 1/26 (صحيح)","صحيح مسلم 94 (صحيح)","صحيح الأدب المفرد 616 (صحيح)","تخريج صحيح ابن حبان 170 (صحيح)","تخريج المسند لشعيب 23560 (صحيح)","تخريج المسند لشعيب 23594 (صحيح)"]},{"id":"س-07455","fp":"fe2e1b8c4815","stateId":687,"easy":"إذا كنت مؤمناً ← فلا يدخل الجنة إلا مؤمن","cause":"إلَّا مُؤمِنٌ","result":"لا يَدخُلُ الجَنَّةَ","explicit":true,"star":true,"ref":"صحيح البخاري 4203","srcLabel":"متفق عليه","text":["شَهِدنا خَيبَرَ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم لرَجُلٍ مِمَّن معهُ يَدَّعي الإسلامَ: هذا مِن أهلِ النَّارِ. فلَمَّا حَضَرَ القِتالُ قاتَلَ الرَّجُلُ أشَدَّ القِتالِ، حتَّى كَثُرَت به الجِراحةُ، فكادَ بَعضُ النَّاسِ يَرتابُ، فوجَدَ الرَّجُلُ ألَمَ الجِراحةِ، فأهوى بيَدِه إلى كِنانَتِه فاستَخرَجَ منها أسهمًا فنَحَرَ بها نَفسَه، فاشتَدَّ رِجالٌ مِنَ المُسلِمينَ، فقالوا: يا رَسولَ اللهِ، صَدَّقَ اللهُ حَديثَك، انتَحَرَ فُلانٌ فقَتَلَ نَفسَه، فقال: قُمْ يا فُلانُ، فأذِّنْ أنَّه ",["لا يَدخُلُ الجَنَّةَ",2]," ",["إلَّا مُؤمِنٌ",1],"، إنَّ اللهَ يُؤَيِّدُ الدِّينَ بالرَّجُلِ الفاجِرِ. تابعه مَعمَرٌ عن الزُّهريِّ. وقال شبيبٌ عن يونُسَ عن ابنِ شِهابٍ: أخبَرَني ابنُ المُسَيَّبِ وعبدُ الرَّحمنِ بنُ عَبدِ اللهِ بنِ كَعبٍ أنَّ أبا هُرَيرةَ قال: (شَهِدْنا مع النَّبيِّ صلَّى اللهُ عليه وسلَّم حُنَينًا). وقال ابنُ المُبارَكِ عن يونُسَ عن الزُّهريِّ عن سعيدٍ عن النَّبيِّ صلَّى اللهُ عليه وسلَّم. تابعه صالحٌ عن الزُّهريِّ. وقال الزَّبيديُّ: أخبَرَني الزُّهريُّ أنَّ عبدَ الرَّحمنِ بنَ كَعبٍ أخبره أنَّ عُبَيدَ اللهِ بنَ كَعبٍ قال: أخبَرَني من شَهِد مع النَّبيِّ صلَّى اللهُ عليه وسلَّم خيبرَ. قال الزُّهريُّ: وأخبَرَني عُبَيدُ اللهِ بنُ عَبدِ اللهِ وسَعيدٌ عن النَّبيِّ صلَّى اللهُ عليه وسلَّم."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4203)، ومسلم (111)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"SEtJyJep","merged":17,"otherRefs":["صحيح مسلم 1142 (صحيح)","حلية الأولياء 8/372 (صحيح)","الإيمان لابن أبي شيبة 12 (صحيح)","تخريج المسند لشعيب 15430 (صحيح)","تخريج المسند لشعيب 18956 (صحيح)","المستدرك على الصحيحين 4430 (صحيح)","صحيح الترمذي 1574 (صحيح)","صحيح مسلم 114 (صحيح)","تخريج مشكل الآثار 360 (صحيح)","صحيح البخاري 6606 (صحيح)","المستدرك على الصحيحين 3317 (صحيح)","تخريج صحيح ابن حبان 4849 (صحيح)","تخريج المسند لشاكر 1/165 (صحيح)","تخريج مشكل الآثار 3593 (حسن)","المستدرك على الصحيحين 7559 (صحيح)","تخريج المسند لشعيب 15429 (صحيح)"]},{"id":"س-02859","fp":"f18428c0d557","stateId":687,"easy":"إذا أحصيت أسماء الله التسعة والتسعين ← تدخل الجنة","cause":"إنَّ للَّهِ تسعةً وتسعينَ اسمًا مائةً إلَّا واحدًا إنَّهُ وِترٌ يحبُّ الوِترَ من حفِظَها","result":"دخلَ الجنَّةَ","explicit":true,"star":true,"similar":["س-03101"],"ref":"صحيح ابن ماجه 3128","srcLabel":"متفق عليه","text":[["إنَّ للَّهِ تسعةً وتسعينَ اسمًا مائةً إلَّا واحدًا إنَّهُ وِترٌ يحبُّ الوِترَ من حفِظَها ",1],["دخلَ الجنَّةَ ",2],"[وَهيَ : اللَّهُ، الواحِدُ، الصَّمدُ، الأوَّلُ، الآخرُ، الظَّاهرُ ، الباطنُ ، الخالقُ ، البارئُ ، المصوِّرُ ، الملِكُ، الحقُّ، السَّلامُ، المؤمنُ، المُهَيْمنُ، العزيزُ، الجبَّارُ ، المتَكَبِّرُ، الرَّحمنُ، الرَّحيمُ، اللَّطيفُ، الخبيرُ، السَّميعُ ، البصيرُ، العَليمُ، العَظيمُ، البارُّ، المتعالِ ، الجليلُ، الجميلُ، الحيُّ، القيُّومُ، القادرُ، القاهرُ، العليُّ، الحَكيمُ، القَريبُ، المُجيبُ، الغَنيُّ، الوَهَّابُ، الودودُ ، الشَّكورُ، الماجدُ، الواجِدُ، الوالي، الرَّاشدُ، العَفوُّ، الغَفورُ ، الحَليمُ ، الكَريمُ، التَّوَّابُ، الرَّبُّ، المَجيدُ، الوليُّ ، الشَّهيدُ، المُبينُ، البُرهانُ، الرَّءوفُ، الرَّحيمُ، المُبدِئُ، المعيدُ ، الباعِثُ ، الوارثُ، القويُّ، الشَّديدُ، الضَّارُّ، النَّافعُ، الباقي ، الواقي، الخافضُ، الرَّافعُ ، القابضُ ، الباسطُ ، المعزُّ، المذلُّ، المقسِطُ، الرَّزَّاقُ، ذو القوَّةِ، المتينُ، القائمُ، الدَّائمُ، الحافِظُ، الوَكيلُ، الفاطرُ، السَّامعُ، المعطي، المُحيي، المميتُ، المانعُ ، الجامعُ ، الهادي ، الكافي، الأبَدُ، العالِمُ، الصَّادقُ، النُّورُ، المُنيرُ، التَّامُّ، القَديمُ، الوِترُ، الأحَدُ ، الصَّمدُ، الَّذي لم يلِدْ، ولم يولَدْ، ولم يَكُن لَهُ كفوًا أحدٌ قالَ زُهَيْرٌ : فبلغَنا من غيرِ واحدٍ من أَهْلِ العلمِ، أنَّ أوَّلَها يفتحُ بقولِ : لا إلَهَ إلَّا اللَّهُ وحدَهُ لا شريكَ لَهُ، لَهُ الملكُ ولَهُ الحمدُ، بيدِهِ الخيرُ وَهوَ على كلِّ شيءٍ قديرٌ، لا إلَهَ إلَّا اللَّهُ، لَهُ الأسماءُ الحُسنى]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2677) واللفظ له، وأخرجه البخاري (6410) باختلاف يسير","bab":"إيمان › الوعد","dorar":"TAFjmhj1","merged":5,"otherRefs":["الجامع الصغير 2351 (صحيح)","المستدرك على الصحيحين 42 (صحيح)","صحيح البخاري 6410 (صحيح)","صحيح مسلم 2677 (صحيح)"]},{"id":"س-02435","fp":"858bd095caf0","stateId":687,"easy":"إذا مت تشهد أن لا إله إلا الله ← فلك الجنة","cause":"من مات يشهدُ أنْ لا إلهَ إلَّا اللهُ","result":"فإنَّ له الجنَّةَ","explicit":true,"repOf":"س-05618","ref":"الإيمان لابن منده 47","text":["كنَّا مع رسولِ اللهِ صلَّى اللهُ عليه وسلم في مسيرٍ له فلمَّا كان بعضُ الليلِ تنحَّى فلبِث طويلًا ثمَّ أتانا فقال : أتاني آتٍ من ربِّي فأخبرَني أنه ",["من مات يشهدُ أنْ لا إلهَ إلَّا اللهُ ",1],["فإنَّ له الجنَّةَ ",2],". فقلتُ : وإنْ زنَى وإنْ سرق ؟ قال : نعمْ"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه البخاري (3222)، ومسلم (94) باختلاف يسير","bab":"إسلام › فضل الشهادتين","dorar":"DT1QbQDF","merged":3,"otherRefs":["مجموع الفتاوى 10/760 (صحيح)","مجمع الزوائد 1/23 (حسن)"]},{"id":"س-03680","fp":"1efa65fdba89","stateId":687,"easy":"إذا أطعت النبي ﷺ ← دخلت الجنة","cause":"مَنْ أَطَاعَنِي","result":"دخلَ الجنةَ","explicit":true,"star":true,"ref":"السلسلة الصحيحة 2044","srcLabel":"البخاري","text":["و الذي نَفسي بيدِهِ ، لَتَدْخُلُنَّ الجنةَ كلُّكُمْ إلَّا مَنْ أبى ، و شَرَدَ على اللهِ كشرودِ البَعِيرِ ، قالوا : و مَنْ يَأْبَى أنْ يَدْخُلَ الجنةَ ؟ فقال : ",["مَنْ أَطَاعَنِي ",1],["دخلَ الجنةَ",2]," ، و مَنْ عَصانِي فقد أبى"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه ابن حبان (17)، والطبراني في ((المعجم الأوسط)) (808) باختلاف يسير","bab":"اعتصام بالسنة › لزوم السنة","dorar":"bJhjk0og","merged":3,"otherRefs":["مجمع الزوائد 10/73 (صحيح)","صحيح البخاري 7280 (صحيح)"]},{"id":"س-03010","fp":"d0b201453386","stateId":687,"easy":"إذا مت لا تجعل لله نداً ← يدخلك الله الجنة","cause":"مَن مات وهو لا يَجعَلُ للهِ نِدًّا","result":"أدخَلَه اللهُ الجنَّةَ","explicit":true,"similar":["س-04270","س-04203"],"ref":"تخريج المسند لشعيب 4425","srcLabel":"متفق عليه","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ كَلِمةً، وأنا أقولُ أخرى؛ مَن مات وهو يَجعَلُ للهِ نِدًّا، أدخَلَه اللهُ النَّارَ، قال: وقال عبدُ اللهِ: وأنا أقولُ: ",["مَن مات وهو لا يَجعَلُ للهِ نِدًّا، ",1],["أدخَلَه اللهُ الجنَّةَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (1238)، ومسلم (92) بنحوه، وأحمد (4425) واللفظ له","bab":"إيمان › الوعيد","dorar":"wFSNmwQS","merged":2,"otherRefs":["السلسلة الصحيحة 7/1528 (حسن)"]},{"id":"س-04270","fp":"08ed60b86d04","stateId":687,"easy":"إذا مت لا تدعو لله نداً ← تدخل الجنة","cause":"مَن ماتَ وهو لا يَدعو للَّهِ نِدًّا","result":"دَخَلَ الجَنَّةَ","explicit":true,"repOf":"س-03010","ref":"صحيح البخاري 4497","text":["قال النَّبيُّ صلَّى اللهُ عليه وسلَّم كَلِمةً وقُلتُ أُخرى، قال النَّبيُّ صلَّى اللهُ عليه وسلَّم: مَن ماتَ وهو يَدعو مِن دونِ اللهِ نِدًّا دَخَلَ النَّارَ، وقُلتُ أنا: ",["مَن ماتَ وهو لا يَدعو للَّهِ نِدًّا ",1],["دَخَلَ الجَنَّةَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (92) بلفظ مقارب","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"H3qNJxlM","merged":3,"otherRefs":["صحيح البخاري 6683 (صحيح)","تخريج المسند لشعيب 3552 (صحيح)"]},{"id":"س-01007","fp":"bdce09d56d4b","stateId":687,"easy":"إذا شهدت أن لا إله إلا الله وأن محمداً عبده ورسوله وأن عيسى عبد الله... ← يدخلك الله الجنة على ما كان من العمل","cause":"مَن قال: أشهَدُ أنْ لا إلَهَ إلَّا اللهُ وحدَه لا شَريك له، وأنَّ مُحَمَّدًا عَبدُه ورَسولُه، وأنَّ عيسى عبدُ اللهِ، وابنُ أَمَتِه، وكَلِمَتُه ألقاها إلى مَريَمَ وروحٌ منه، وأنَّ الجَنَّةَ حَقٌّ، وأنَّ النَّارَ حَقٌّ","result":"أدخَلَه اللهُ مِن أيِّ أبوابِ الجَنَّةِ الثَّمانيةِ شاءَ","explicit":true,"repOf":"س-05618","ref":"صحيح مسلم 28","text":[["مَن قال: أشهَدُ أنْ لا إلَهَ إلَّا اللهُ وحدَه لا شَريك له، وأنَّ مُحَمَّدًا عَبدُه ورَسولُه، وأنَّ عيسى عبدُ اللهِ، وابنُ أَمَتِه، وكَلِمَتُه ألقاها إلى مَريَمَ وروحٌ منه، وأنَّ الجَنَّةَ حَقٌّ، وأنَّ النَّارَ حَقٌّ، ",1],["أدخَلَه اللهُ مِن أيِّ أبوابِ الجَنَّةِ الثَّمانيةِ شاءَ",2],". وفي روايةٍ: أدخَلَه اللهُ الجَنَّةَ على ما كانَ مِن عَمَلٍ، ولَم يَذكُرْ مِن أيِّ أبوابِ الجَنَّةِ الثَّمانيةِ شاءَ."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3435) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"pe2enzhy"},{"id":"س-02443","fp":"aa9546c8276e","stateId":687,"easy":"إذا شهدت أن لا إله إلا الله وأن محمداً رسول الله ← تدخل الجنة","cause":"مَن شهِد منهم أنْ لا إلهَ إلَّا اللهُ وأنَّ محمَّدًا رسوله الله","result":"دخَل الجنَّةَ","explicit":true,"repOf":"س-05618","ref":"تخريج صحيح ابن حبان 195","text":["انطلَق النَّبيُّ صلَّى اللهُ عليه وسلَّم نحوَ بقيعِ الغرقدِ فانطلَقْتُ خلْفَه فقال: ( يا أبا ذرٍّ ) فقُلْتُ: لبَّيْكَ ثمَّ سعدَيْكَ وأنا فداؤُك فقال: ( المُكثِرونَ هم المُقلُّونَ يومَ القيامةِ إلَّا مَن قال بالمالِ هكذا وهكذا عن يمينِه وعن شِمالِه ) قالها ثلاثًا - ثمَّ عرَض لنا أُحُدٌ فقال: ( يا أبا ذرٍّ ما يسُرُّني أنَّه لآلِ محمَّدٍ ذهبًا يُمسي معهم دينارٌ أو مثقالٌ ) فقُلْتُ: اللهُ ورسولُه أعلمُ ثمَّ عرَض لنا وادٍ فاستَبطَنه النَّبيُّ صلَّى اللهُ عليه وسلَّم ونزَل فيه وجلَسْتُ على شفيرِه فظنَنْتُ أنَّ له حاجةً فأبطأ عليَّ وساء ظنِّي فسمِعْتُ مناجاةً فقال: ( ذلك جبريلُ يُخبِرُني لأمَّتي ",["مَن شهِد منهم أنْ لا إلهَ إلَّا اللهُ وأنَّ محمَّدًا رسوله الله",1]," ",["دخَل الجنَّةَ",2]," ) فقُلْتُ: يا رسولَ اللهِ، وإنْ زنى وإنْ سرَق ؟ قال: ( وإنْ زنى وإنْ سرَق )"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (6268)، ومسلم (94) بنحوه","bab":"إسلام › فضل الشهادتين","dorar":"qqbqE1Tw"},{"id":"س-03141","fp":"29d950981a30","stateId":687,"easy":"إذا آمنت بالله ثم سددت ← تُسلك في الجنة","cause":"ما منكم مِن أحدٍ يؤمنُ باللهِ ثمَّ يُسدِّدُ","result":"إلَّا سُلِك به في الجنَّةِ","explicit":true,"similar":["س-02619"],"otherNeedIds":[65],"ref":"تخريج صحيح ابن حبان 212","srcLabel":"البخاري","text":["صدَرْنا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّم مِن مكَّةَ فجعَل ناسٌ يستأذِنون رسولَ اللهِ صلَّى اللهُ عليه وسلَّم فجعَل يأذَنُ لهم فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( ما بالُ شِقِّ الشَّجرةِ الَّتي تلي رسولَ اللهِ أبغضَ إليكم مِن الشِّقِّ الآخَرِ ؟ ) قال: فلم نرَ مِن القومِ إلَّا باكيًا قال يقولُ أبو بكرٍ: إنَّ الَّذي يستأذِنُك بعدَ هذا لسفيهٌ - في نفسي - فقام رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فحمِد اللهَ وأثنى عليه - وكان إذا حلف قال: والَّذي نفسي بيدِه: ( أشهَدُ عند اللهِ ",["ما منكم مِن أحدٍ يؤمنُ باللهِ ثمَّ يُسدِّدُ",1]," ",["إلَّا سُلِك به في الجنَّةِ",2]," ولقد وعَدني ربِّي أنْ يُدخِلَ مِن أمَّتي الجنَّةَ سبعينَ ألفًا بغيرِ حسابٍ ولا عذابٍ وإنِّي لأرجو ألَّا يدخُلوها حتَّى تتبوَّؤوا أنتم ومَن صلَح مِن أزواجِكم وذَرارِيُّكم مساكنَ في الجنَّةِ ) ثمَّ قال: ( إذا مضى شَطرُ اللَّيلِ أو ثُلثاه ينزِلُ اللهُ تبارَك وتعالى إلى السَّماءِ الدُّنيا فيقولُ: لا أسأَلُ عن عبادي غيري مَن ذا الَّذي يسأَلُني فأُعطيَه مَن ذا الَّذي يستغفرني فأغفِرَ له مَن ذا الَّذي يدعوني فأستجيب له حتَّى ينفجرَ الصُّبحُ )"],"grade":"صحيح","narrator":"رفاعة بن عرابة الجهني","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه ابن حبان (212)، وابن خزيمة (37) واللفظ لهما، وأحمد (212) بنحوه، والطبراني في ((المعجم الكبير)) (5/ 50) (4557)، والبيهقي في ((شعب الإيمان)) (400) مختصرا.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"JHx8x5ww"},{"id":"س-03479","fp":"16862dad9e86","stateId":687,"easy":"إذا قلت «لا إله إلا الله» ثم مت على ذلك ← تدخل الجنة","cause":"ما مِن عبدٍ قالَ لا إلَهَ","result":"إلا اللَّهُ ثمَّ ماتَ على ذلِكَ إلا دخلَ الجنَّةَ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-05618","ref":"تخريج كتاب السنة 958","text":["وإن زنَى وإن سرقَ مثلَهُ [يعني حديث: رأيتُ رسولَ اللَّهِ عليهِ ثوبٌ أبيضُ وَهوَ نائمٌ ثمَّ انتبه فإذا هو نائمٌ ثم انتبَهَ وهو نائِمٌ وقدِ استيقَظَ فجلسَ إليْهِ فقالَ: ",["ما مِن عبدٍ قالَ لا إلَهَ",1]," ",["إلا اللَّهُ ثمَّ ماتَ على ذلِكَ إلا دخلَ الجنَّةَ",2],". قلتُ: وإن زَنى وإن سَرقَ؟. قالَ: وإن زنى وإن سرَقَ. قلتُ: وإن زَنى وإن سَرقَ؟. قالَ: وإن زَنى وسرقَ وإن رغِمَ أنفُ أبي ذرٍّ. قالَ: فخرجَ أبو ذرٍّ وَهوَ يَجرُّ رداءَهُ وَهوَ يقولُ: نعَم وإن رغِمَ أنفُ أبي ذرٍّ. قالَ: فَكانَ أبو ذرٍّ يحدِّثُ ويقولُ وإن رغِمَ أنفُ أبي ذرٍّ.]"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (1237)، ومسلم (94) مطولاً باختلاف يسير","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"Wdu53Vzo"},{"id":"س-04203","fp":"a73f4ffe5e2c","stateId":687,"easy":"إذا مت لا تجعل لله نداً ← يدخلك الله الجنة","cause":"ومَن مات لا يجعَلُ للهِ نِدًّا","result":"أدخَلَه اللهُ عزَّ وجلَّ الجنَّةَ، وإنَّ هذه الصَّلَواتِ كَفَّاراتٌ لما بينهنَّ ما اجتُنِبَ المَقتَلُ","explicit":true,"repOf":"س-03010","otherNeedIds":[11],"ref":"تخريج المسند لشعيب 3865","text":["\"مَن جعَلَ للهِ نِدًّا؛ جعَلَه اللهُ في النَّارِ\"، قال: وأُخرى أَقولُها، لم أسمَعْها منه: ",["ومَن مات لا يجعَلُ للهِ نِدًّا؛ ",1],["أدخَلَه اللهُ عزَّ وجلَّ الجنَّةَ، وإنَّ هذه الصَّلَواتِ كَفَّاراتٌ لما بينهنَّ ما اجتُنِبَ المَقتَلُ",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6683) باختلاف يسير دون قوله: \"وإنَّ هذه الصَّلَواتِ كَفَّاراتٌ ...\"، ومسلم (92) بنحوه دون قوله: \"وإنَّ هذه الصَّلَواتِ كَفَّاراتٌ ...\"","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"R7EZbax3"},{"id":"س-02382","fp":"a7f22da1d17f","stateId":687,"easy":"إذا شهدت أن لا إله إلا الله مستيقناً بها قلبك ← فأبشر بالجنة","cause":"يَشهَدُ أن لا إلَهَ إلَّا اللهُ مُستَيقِنًا بها قَلبُه","result":"فبَشِّرْه بالجَنَّةِ","explicit":true,"repOf":"س-05618","ref":"صحيح مسلم 31","text":["كُنَّا قُعودًا حَولَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، معنا أبو بَكرٍ وعُمَرُ في نَفَرٍ، فقامَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم مِن بَينِ أظهُرِنا، فأبطَأ علينا، وخَشينا أن يُقتَطَعَ دونَنا، وفَزِعنا، فقُمنا، فكُنتُ أوَّلَ مَن فزِعَ، فخَرَجتُ أبتَغي رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم حتَّى أتَيتُ حائِطًا للأنصارِ لبَني النَّجَّارِ، فدُرتُ به هل أجِدُ له بابًا؟ فلَم أجِدْ، فإذا رَبيعٌ يَدخُلُ في جَوفِ حائِطٍ مِن بئرٍ خارِجةٍ -والرَّبيعُ الجَدولُ- فاحتَفَزتُ، فدَخَلتُ على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: أبو هُرَيرةَ! فقُلتُ: نَعَم يا رَسولَ اللهِ، قال: ما شَأنُك؟ قُلتُ: كُنتَ بينَ أظهُرِنا، فقُمتَ فأبطَأتَ علينا، فخَشينا أن تُقتَطَعَ دونَنا، ففَزِعنا، فكُنتُ أوَّلَ مَن فزِعَ، فأتَيتُ هذا الحائِطَ، فاحتَفَزتُ كما يَحتَفِزُ الثَّعلَبُ، وهؤلاء النَّاسُ ورائي، فقال: يا أبا هُرَيرةَ وأعطاني نَعلَيه، قال: اذهَبْ بنَعلَيَّ هاتَينِ، فمَن لَقيتَ مِن وراءِ هذا الحائِطِ ",["يَشهَدُ أن لا إلَهَ إلَّا اللهُ مُستَيقِنًا بها قَلبُه",1],"، ",["فبَشِّرْه بالجَنَّةِ",2],"، فكانَ أوَّلَ مَن لَقيتُ عُمَرُ، فقال: ما هاتانِ النَّعلانِ يا أبا هُرَيرةَ؟ فقُلتُ: هاتانِ نَعلا رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، بَعَثَني بهِما مَن لَقيتُ يَشهَدُ أن لا إلَهَ إلَّا اللهُ مُستَيقِنًا بها قَلبُه بَشَّرتُه بالجَنَّةِ، فضَرَبَ عُمَرُ بيَدِه بينَ ثَديَيَّ فخَرَرتُ لاسْتي، فقال: ارجِعْ يا أبا هُرَيرةَ، فرَجَعتُ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فأجهَشتُ بُكاءً، ورَكِبَني عُمَرُ، فإذا هو على أثَري، فقال لي رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ما لك يا أبا هُرَيرةَ؟ قُلتُ: لَقيتُ عُمَرَ، فأخبَرتُه بالذي بَعَثتَني به، فضَرَبَ بينَ ثَديَيَّ ضَربةً خَرَرتُ لاسْتي، قال: ارجِعْ، قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: يا عُمَرُ، ما حَمَلَك على ما فعَلتَ؟ قال: يا رَسولَ اللهِ، بأبي أنتَ وأُمِّي، أبَعَثتَ أبا هُرَيرةَ بنَعلَيك، مَن لَقيَ يَشهَدُ أن لا إلَهَ إلَّا اللهُ مُستَيقِنًا بها قَلبُه بَشَّرَه بالجَنَّةِ؟ قال: نَعَم، قال: فلا تَفعَلْ؛ فإنِّي أخشى أن يَتَّكِلَ النَّاسُ عليها، فخَلِّهم يَعمَلونَ، قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: فخَلِّهم."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (31)","bab":"إسلام › فضل الشهادتين","dorar":"OsibdGaK"},{"id":"س-02391","fp":"c55863330fac","stateId":687,"easy":"إذا لقيت الله بالشهادتين غير شاك ← تدخل الجنة","cause":"لا يلقى اللهَ بهما عبدٌ غيرُ شاكٍّ فيهما","result":"إلا دخل الجنةَ","explicit":true,"similar":["س-02403","س-02437","س-02444"],"ref":"العواصم والقواصم 5/392","srcLabel":"مسلم","text":["حديثُ أنَّ قولَ: لا إلهَ إلا اللهُ أفضلُ العملِ [يعني حديث: كنا مع النبيِّ صلَّى اللهُ عليهِ وآلهِ وسلَّمَ في مسيرٍ فنفدتْ أزوادُ القومِ قال حتى هم بنحْرِ بعضِ حمائلِهم قال فقال عمرُ يا رسولَ اللهِ لو جمعتَ ما بقي من أزوادِ القوم ِفدعوتَ اللهَ عليها قال ففعل قال فجاء ذو البُرِّ ببُرِّه وذو التمرِ بتمرِه وقال مجاهدٌ وذو النواةِ بنواهُ قلتُ وما كانوا يصنعون بالنواءِ قال كانوا يمصُّونه ويشربون عليه الماءَ قال فدعا عليها قال حتى ملأ القومُ أزودتَهم قال فقال عند ذلك أشهدُ أن لا إلهَ إلا اللهُ وأني رسولُ اللهِ ",["لا يلقى اللهَ بهما عبدٌ غيرُ شاكٍّ فيهما",1]," ",["إلا دخل الجنةَ",2],"]"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"ثابت","takhrij":"أخرجه مسلم (27)، وأبو عوانة في ((المستخرج)) (80)، والفريابي في ((دلائل النبوة)) (4) بنحوه تامًا.","bab":"إسلام › فضل الشهادتين","dorar":"hwgqvGoY"},{"id":"س-02403","fp":"6dcde7ceb68c","stateId":687,"easy":"إذا لقيت الله بالشهادتين غير شاك ← تدخل الجنة","cause":"ومَن لَقيَ اللهَ عزَّ وجلَّ بهما غَيرَ شَاكٍّ","result":"دخَلَ الجنَّةَ","explicit":true,"repOf":"س-02391","ref":"تخريج المسند لشعيب 9466","text":["خرَجَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ في غَزوَةٍ غزاها، فأرمَلَ فيها المُسلِمونَ، واحتاجوا إلى الطَّعامِ، فاستأذَنوا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ في نَحرِ الإبِلِ، فأَذِنَ لهم، فبلَغَ ذلك عُمَرَ بنَ الخَطَّابِ، قال: فجاءَ، فقال: يا رسولَ اللهِ، إبِلُهم تَحمِلُهم، وتُبَلِّغُهم عَدُوَّهم، يَنحَرونها؟! بلِ ادْعُ يا رسولَ اللهِ بغَبَراتِ الزَّادِ، فادْعُ اللهَ عزَّ وجلَّ فيها بالبَرَكةِ. قال: أجَلْ، قال: فدعا بغَبَراتِ الزَّادِ، فجاءَ النَّاسُ بما بَقيَ معهم فجمَعَه، ثم دعا اللهَ عزَّ وجلَّ فيها بالبَرَكةِ، ودعاهم بأَوعيَتِهم، فمَلَأَها، وفضَلَ فَضْلٌ كَثيرٌ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ عندَ ذلك: أشهَدُ أنْ لا إلهَ إلَّا اللهُ، وأشهَدُ أنِّي عبدُ اللهِ ورسولُه، ",["ومَن لَقيَ اللهَ عزَّ وجلَّ بهما غَيرَ شَاكٍّ؛ ",1],["دخَلَ الجنَّةَ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (27)، والنسائي في ((السنن الكبرى)) (8797)، وأحمد (9466) واللفظ له","bab":"إسلام › فضل الشهادتين","dorar":"pGuJ6iV1"},{"id":"س-02471","fp":"4451a1421cfc","stateId":687,"easy":"إذا قلت «لا إله إلا الله» صادقاً ← تدخل الجنة","cause":"مَن قال: لا إلهَ إلَّا اللهُ، صادقًا بها","result":"دخَلَ الجنَّةَ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-05618","ref":"تخريج مشكل الآثار 4003","text":["أنَّه أتَى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ في نفرٍ مِن قومِه، فقال: أَبشِروا وبشِّروا مَن وراءَكم أنَّه ",["مَن قال: لا إلهَ إلَّا اللهُ، صادقًا بها، ",1],["دخَلَ الجنَّةَ",2],"، فخرَجوا يُبشِّرونَ الناسَ، فلَقِيَهم عُمَرُ بنُ الخطَّابِ رضِي اللهُ عنه، فبشَّرُوهُ فرَدَّهُم، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: مَن رَدَّكم؟ فقالوا: رَدَّنا عُمَرُ، فقال: لمَ رَدَدْتَهم يا عُمَرُ؟ قال: إذَنْ يَتَّكِلُ الناسُ يا رسولَ اللهِ."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (19597)، والطحاوي في ((شرح مشكل الآثار)) (4003) واللفظ لهما.","bab":"إسلام › فضل الشهادتين","dorar":"9P4tfxJk"},{"id":"س-03032","fp":"e5ee8c3db2da","stateId":687,"easy":"إذا لقيت الله لا تشرك به شيئاً ← يدخلك الجنة","cause":"مَن لَقِيَ اللهَ عزَّ وجلَّ لا يُشرِكُ به شَيئًا","result":"أدْخَلَه الجَنَّةَ","explicit":true,"repOf":"س-05618","ref":"مجموع رسائل العلائي 1/165","text":[["مَن لَقِيَ اللهَ عزَّ وجلَّ لا يُشرِكُ به شَيئًا ",1],["أدْخَلَه الجَنَّةَ، ",2],"ومَن لَقِيَه يُشرِكُ به أدخَلَه النَّارَ."],"grade":"صحيح","narrator":"جابر","muhaddith":"إسناده على شرط مسلم","bab":"إيمان › الوعيد","dorar":"QQoyEuBE"},{"id":"س-03654","fp":"df1987928a49","stateId":687,"easy":"إذا شهدت أن لا إله إلا الله صادقاً ← دخلت الجنة","cause":"من شهد أن لا إله إلا اللهُ صادقًا","result":"دخل الجنَّةَ فخرجْنا من عندِ النبيِّ صلَّى اللهُ عليهِ وسلَّمَ نبشِّرُ الناسَ فاستقبلَنا عمرُ بنُ الخطابِ فرجع بنا إلى رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ فقال رسولُ اللهِ صلَّى اللهُ","explicit":true,"repOf":"س-05618","ref":"السلسلة الصحيحة 2/329","text":["أتيتُ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ ومعي نفرٌ من قومي فقال : أبشِروا وبشِّروا من وراءَكم أنه ",["من شهد أن لا إله إلا اللهُ صادقًا ",1],["دخل الجنَّةَ فخرجْنا من عندِ النبيِّ صلَّى اللهُ عليهِ وسلَّمَ نبشِّرُ الناسَ فاستقبلَنا عمرُ بنُ الخطابِ فرجع بنا إلى رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ فقال رسولُ اللهِ صلَّى اللهُ",2]," عليهِ وسلَّمَ : من ردَّكم ؟ قالوا : عمرُ قال : لمَ ردَدتَهم يا عمرُ ؟ فقال عمرُ إذًا يتَّكِلُ الناسُ قال فسكتَ رسولُ اللهِ صلَّى اللهُ عليهِ وسلَمَ"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (19612)","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"eIJmObqQ"},{"id":"س-07274","fp":"fde975cb28c1","stateId":687,"easy":"إذا أحببت أن تُزحزح عن النار وتُدخل الجنة ← فلتدركك موتتك وأنت مؤمن بالله","cause":"فمَن أحبَّ منكم أن يُزَحْزَحَ عن النارِ","result":"ويُدْخَلَ الجنةَ فلتُدْرِكْه موتَتُه ، وهو مؤمنٌ باللهِ واليومِ الآخرِ ، وليَأْتِ إلى الناسِ ما يُحِبُّ أن يُؤْتَى إليه","explicit":true,"ref":"صحيح النسائي 4202","srcLabel":"مسلم","text":["بينا نحن مع رسولِ اللهِ صلى الله عليه وسلم في سفرٍ ، إذ نَزَلْنَا منزلًا ، فمِنَّا مَن يَضْرِبُ خباءَه ، ومِنَّا مَن يَنْتَضَلُ ، ومِنَّا من هو في جَشْرَتِه ، إذ نادى منادي النبيِّ صلى الله عليه وسلم : الصلاةُ جامعةٌ . فاجتَمَعْنا فقام النبيُّ صلى الله عليه وسلم فخَطَبَنَا فقال : إنه لم يَكُنْ نبيٌّ قبلي إلا كان حقًا عليه ، أن يدلَ أمتَه على ما يَعْلَمَه خيرًا لهم ، ويُنْذِرَهم ما يَعْلَمُه شرًا لهم ، وإن أمتَكم هذه جُعِلَتْ عافيتُها في أولِها ، وإن آخرَها سيُصِيبُهم بلاءٌ وأمورٌ يُنْكِرُونها ، تَجِيءُ فتنٌ فيُدَقِّقُ بعضُها لبعضٍ ، فتَجِيءُ الفتنةُ فيقولُ المؤمنُ : هذه مُهْلِكَتي . ثم تَنْكَشِفُ ، ثم تجيءُ فيقولُ : هذه مُهْلِكَتي . ثم تَنْكَشِفُ ، ",["فمَن أحبَّ منكم أن يُزَحْزَحَ عن النارِ ، ",1],["ويُدْخَلَ الجنةَ فلتُدْرِكْه موتَتُه ، وهو مؤمنٌ باللهِ واليومِ الآخرِ ، وليَأْتِ إلى الناسِ ما يُحِبُّ أن يُؤْتَى إليه ، ",2],"ومَن بايع إمامًا فأعطاه صفقةَ يدِه ، وثمرةَ قلبِه ، فلْيُطِعْه ما استطاع ، فإن جاء أحدٌ يُنازِعُه فاضربوا رقبةَ الآخرِ، وذكر الحديث."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه النسائي (4191) بلفظه، ومسلم (1844)، وابن ماجه (3956) كلاهما بألفاظ مقاربة","bab":"فتن › ظهور الفتن","dorar":"SMPGm3Ee"},{"id":"س-04197","fp":"b85c07126ffa","stateId":687,"easy":"إذا كنت مسلماً ← فلا يدخل الجنة إلا نفس مسلمة","cause":"نفسٌ مُسلِمةٌ","result":"لا يدخُلُ الجنَّةَ إلَّا","explicit":true,"ref":"صحيح ابن حبان 7124","srcLabel":"أحمد","text":["كان أَبي مِن أبناءِ الأَساورةِ وكُنْتُ أختلِفُ إلى الكُتَّابِ وكان معي غُلامانِ إذا رجَعا مِن الكُتَّابِ دخَلا على قَسٍّ فدخَلْتُ معهما فقال لهما : ألَمْ أنهَكما أنْ تأتياني بأحَدٍ قال : فكُنْتُ أختلِفُ إليه حتَّى كُنْتُ أحَبَّ إليه منهما فقال لي : يا سَلمانُ إذا سأَلك أهلُكَ مَن حبَسكَ ؟ فقُلْ : مُعلِّمي وإذا سأَلك مُعلِّمُك : مَن حبَسكَ ؟ فقُلْ : أهلي وقال لي : يا سَلمانُ إنِّي أُريدُ أنْ أتحوَّلَ قال : قُلْتُ : أنا معكَ قال : فتحوَّل فأتى قريةً فنزَلها وكانتِ امرأةٌ تختلِفُ إليه فلمَّا حُضِر قال : يا سَلمانُ احتفِرْ قال : فاحتفَرْتُ فأخرَجْتُ جرَّةً مِن دراهمَ قال : صُبَّها على صدري فصبَبْتُها فجعَل يضرِبُ بيدِه على صدري ويقولُ : وَيْلٌ لِلقَسِّ فمات فنفَخْتُ في بُوقِهم ذلكَ فاجتَمَع القِسِّيسونَ والرُّهبانُ فحضَروه وقال : وهمَمْتُ بالمالِ أنْ أحتمِلَه ثمَّ إنَّ اللهَ صرَفني عنه فلمَّا اجتَمَع القِسِّيسونَ والرُّهبانُ قُلْتُ : إنَّه قد ترَك مالًا فوثَب شبابٌ مِن أهلِ القريةِ وقالوا : هذا مالُ أبينا كانت سُرِّيَّتُه تأتيه فأخَذوه فلمَّا دُفِن قُلْتُ : يا معشرَ القِسِّيسينَ دُلُّوني على عالِمٍ أكونُ معه قالوا : ما نعلَمُ في الأرضِ أعلَمَ مِن رجُلٍ كان يأتي بيتَ المقدِسِ وإنِ انطلَقْتَ الآنَ وجَدْتَ حِمارَه على بابِ بيتِ المقدِسِ فانطلَقْتُ فإذا أنا بحِمارٍ فجلَسْتُ عندَه حتَّى خرَج فقصَصْتُ عليه القصَّةَ فقال : اجلِس حتَّى أرجِعَ إليكَ قال : فلَمْ أرَه إلى الحَوْلِ وكان لا يأتي بيتَ المقدِسِ إلَّا في كلِّ سَنةٍ في ذلك الشَّهرِ فلمَّا جاء قُلْتُ : ما صنَعْتَ فيَّ ؟ قال : وإنَّكَ لَها هنا بعدُ ؟ قُلْتُ : نَعم قال : لا أعلَمُ في الأرضِ أحَدًا أعلَمَ مِن يتيمٍ خرَج في أرضِ تِهامةَ وإنْ تنطلِقِ الآنَ تُوافِقْهُ وفيه ثلاثٌ : يأكُلُ الهديَّةَ ولا يأكُلُ الصَّدقةَ وعندَ غُضروفِ كتِفِه اليُمنى خاتَمُ نبوَّةٍ مِثْلُ بَيضةٍ لونُها لونُ جِلدِه وإنِ انطلَقْتَ الآنَ وافَقْتَه فانطلَقْتُ ترفَعُني أرضٌ وتخفِضُني أخرى حتَّى أصابني قومٌ مِن الأعرابِ فاستعبَدوني فباعوني حتَّى وقَعْتُ إلى المدينةِ فسمِعْتُهم يذكُرونَ النَّبيَّ صلَّى اللهُ عليه وسلَّم وكان العيشُ عزيزًا فسأَلْتُ أهلي أنْ يهَبوا لي يومًا ففعَلوا فانطلَقْتُ فاحتطَبْتُ فبِعْتُه بشيءٍ يسيرٍ ثمَّ جِئْتُ به فوضَعْتُه بَيْنَ يدَيْهِ فقال صلَّى اللهُ عليه وسلَّم : ( ما هو ) ؟ فقُلْتُ : صدقةٌ فقال لأصحابِه : ( كُلوا ) وأبى أنْ يأكُلَ قُلْتُ : هذه واحدةٌ ثمَّ مكَثْتُ ما شاء اللهُ ثمَّ استوهَبْتُ أهلي يومًا فوهَبوا لي يومًا فانطلَقْتُ فاحتطَبْتُ فبِعْتُه بأفضَلَ مِن ذلكَ فصنَعْتُ طعامًا فأتَيْتُه فوضَعْتُه بَيْنَ يدَيْهِ فقال : ( ما هذا ) ؟ قُلْتُ : هديَّةٌ فقال بيدِه : ( باسمِ اللهِ خُذوا ) فأكَل وأكَلوا معه وقُمْتُ إلى خَلْفِه فوضَع رداءَه فإذا خاتَمُ النُّبوَّةِ كأنَّه بَيضةٌ قُلْتُ : أشهَدُ أنَّكَ رسولُ اللهِ قال : ( وما ذاكَ ) ؟ قال : فحدَّثْتُه فقُلْتُ : يا رسولَ اللهِ القَسُّ هل يدخُلُ الجنَّةَ فإنَّه زعَم أنَّكَ نَبيٌّ ؟ قال : ( ",["لا يدخُلُ الجنَّةَ إلَّا",2]," ",["نفسٌ مُسلِمةٌ",1]," ) قُلْتُ : يا رسولَ اللهِ أخبَرني أنَّكَ نَبيٌّ قال : ( لنْ يدخُلَ الجنَّةَ إلَّا نفسٌ مُسلِمةٌ )"],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البيهقي في ((دلائل النبوة)) (6/ 98) واللفظ له، وابن أبي شيبة (37760) باختلاف يسير، وأحمد (23712) مختصرًا.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"da15UrMr","merged":10,"otherRefs":["تخريج المسند لشاكر 6/126 (صحيح)","تخريج مشكل الآثار 363 (صحيح)","صحيح ابن حبان 7458 (صحيح)","صحيح الجامع 2424 (صحيح)","تخريج مشكل الآثار 362 (صحيح)","صحيح مسلم 221 (صحيح)","صحيح مسلم 111 (صحيح)","المستدرك على الصحيحين 7558 (صحيح)","تخريج المسند لشاكر 1/24 (صحيح)"]},{"id":"س-05267","fp":"dafb87540973","stateId":687,"easy":"إذا انتسبت إلى أهل الإيمان ← تكون معهم في الجنة","cause":"المُنْتَسِبُ إلى اثْنَينِ في الجنَّةِ","result":"فأنت ثالِثُهما في الجنَّةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأحاديث المختارة 1241","srcLabel":"البخاري","text":["«انْتَسَبَ رَجُلانِ على عَهْدِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقالَ أَحَدُهما: أنا فُلانُ بنُ فُلانِ بنِ فُلانٍ، فمَن أنت لا أُمَّ لك؟ فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: انْتَسَبَ رَجُلانِ على عَهْدِ موسى صلَّى اللهُ عليه وسلَّمَ، فقالَ أحَدُهما: أنا فُلانُ بنُ فُلانٍ، حتَّى عَدَّ تِسْعةً، فمَن أنت لا أُمَّ لك؟ قالَ: أنا فُلانُ بنُ فُلانِ بنِ الإسْلامِ، قالَ: فأَوْحى اللهُ إلى موسى عليه السَّلامُ: إنَّ هذَينِ المُنْتَسِبَينِ؛ أمَّا أنت أيُّها المُنْتَمي -أو المُنْتَسِبُ- إلى تِسْعةٍ في النَّارِ فأنت عاشِرُهم، وأمَّا أنت يا هذا ",["المُنْتَسِبُ إلى اثْنَينِ في الجنَّةِ",1]," ",["فأنت ثالِثُهما في الجنَّةِ",2],"»."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"sCfhYTR3"},{"id":"س-00606","fp":"8dce7866f81a","stateId":687,"easy":"إذا أجبت داعي الله ← تدخل الدار وتأكل من المأدبة","cause":"فمَن أجابَ الدَّاعيَ","result":"دَخَلَ الدَّارَ وأكَلَ مِنَ المَأدُبةِ","explicit":true,"similar":["س-00594"],"otherNeedIds":[23],"ref":"صحيح البخاري 7281","srcLabel":"الترمذي","text":["جاءَت مَلائِكةٌ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم وهو نائِمٌ، فقال بَعضُهم: إنَّه نائِمٌ، وقال بَعضُهم: إنَّ العَينَ نائِمةٌ، والقَلبَ يَقظانُ، فقالوا: إنَّ لصاحِبِكُم هذا مَثَلًا، فاضرِبوا له مَثَلًا، فقال بَعضُهم: إنَّه نائِمٌ، وقال بَعضُهم: إنَّ العَينَ نائِمةٌ، والقَلبَ يَقظانُ، فقالوا: مَثَلُه كَمَثَلِ رَجُلٍ بَنى دارًا، وجَعَلَ فيها مَأدُبةً وبَعَثَ داعيًا، ",["فمَن أجابَ الدَّاعيَ",1]," ",["دَخَلَ الدَّارَ وأكَلَ مِنَ المَأدُبةِ",2],"، ومَن لَم يُجِبِ الدَّاعيَ لَم يَدخُلِ الدَّارَ ولَم يَأكُلْ مِنَ المَأدُبةِ، فقالوا: أوِّلوها له يَفقَهْها، فقال بَعضُهم: إنَّه نائِمٌ، وقال بَعضُهم: إنَّ العَينَ نائِمةٌ، والقَلبَ يَقظانُ، فقالوا: فالدَّارُ الجَنَّةُ، والدَّاعي مُحَمَّدٌ صلَّى اللهُ عليه وسلَّم، فمَن أطاعَ مُحَمَّدًا صلَّى اللهُ عليه وسلَّم فقد أطاعَ اللهَ، ومَن عَصى مُحَمَّدًا صلَّى اللهُ عليه وسلَّم فقد عَصى اللهَ، ومُحَمَّدٌ صلَّى اللهُ عليه وسلَّم فَرقٌ بينَ النَّاسِ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[أورده في صحيحه] وقال : تابعه قتيبة عن ليث عن خالد عن سعيد بن أبي هلال عن جابر خرج علينا النبي صلى الله عيه وسلم ...","takhrij":"أخرجه أبو عوانة (10114)، والبيهقي في ((الآداب)) (858) كلاهما بلفظه، والترمذي (2860) بمعناه.","bab":"آداب عامة › ضرب الأمثال","dorar":"mmVpxzQK","merged":2,"otherRefs":["هداية الرواة 1/128 (حسن)"]},{"id":"س-02619","fp":"50b15a0d3d4a","stateId":687,"easy":"إذا آمنت بالله ثم سددت ← تُسلك في الجنة","cause":"ما مِن عَبدٍ يُؤمِنُ باللهِ، ثم يُسدِّدُ","result":"إلَّا سلَكَ في الجنَّةِ","explicit":true,"repOf":"س-03141","otherNeedIds":[65],"ref":"تخريج المسند لشعيب 16216","text":["صدَرْنا مع رسولِ اللهِ صَلَّى اللهُ عليه وسلَّمَ مِن مكةَ، فجعَلَ النَّاسُ يَستَأذِنونَهُ.. فذكَرَ الحَديثَ، قال: وقال أبو بكرٍ: إنَّ الذي يَستَأذِنُكَ بَعدَ هذا لَسَفيهٌ، في نَفْسي، ثم إنَّ النَّبيَّ صَلَّى اللهُ عليه وسلَّمَ حمِدَ اللهَ، وقال خَيرًا، ثم قال: أشهَدُ عِندَ اللهِ، وكان إذا حلَفَ قال: والذي نَفْسُ محمدٍ بِيَدِهِ، ",["ما مِن عَبدٍ يُؤمِنُ باللهِ، ثم يُسدِّدُ؛ ",1],["إلَّا سلَكَ في الجنَّةِ",2],".. فذكَرَ الحَديثَ."],"grade":"صحيح","narrator":"رفاعة بن عرابة الجهني","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (16216) واللفظ له، والطيالسي (1387)، والطبراني (5/51) (4558)","bab":"إيمان › الأمر بالإيمان بالله تعالى ورسوله وشرائع الدين","dorar":"jcbrErWN","merged":2,"otherRefs":["صحيح ابن ماجه 3477 (صحيح)"]},{"id":"س-00863","fp":"aa8cec88f2f7","stateId":687,"easy":"إذا لقيت الله تؤمن به وباليوم الآخر والجنة والنار والبعث والقدر ← تدخل الجنة","cause":"يُؤمِنُ باللهِ، واليَومِ الآخِرِ، وبالجَنَّةِ والنَّارِ، وبالبَعثِ بَعدَ المَوتِ، والحِسابِ","result":"مَن لَقيَ اللهَ مُستَيقِنًا بهنَّ، دَخَلَ الجَنَّةَ","explicit":true,"ref":"تخريج المسند لشعيب 18076","srcLabel":"أحمد","text":["بَخٍ بَخٍ لخَمسٍ، ما أثقَلَهنَّ في الميزانِ: لا إلَهَ إلَّا اللهُ، واللهُ أكبَرُ، وسُبحانَ اللهِ، والحَمدُ للَّهِ، والولَدُ الصَّالِحُ يُتَوفَّى فيَحتَسِبُه والِدُه. وقال: بَخٍ بَخٍ لخَمسٍ ",["مَن لَقيَ اللهَ مُستَيقِنًا بهنَّ، دَخَلَ الجَنَّةَ",2],": ",["يُؤمِنُ باللهِ، واليَومِ الآخِرِ، وبالجَنَّةِ والنَّارِ، وبالبَعثِ بَعدَ المَوتِ، والحِسابِ",1],"."],"grade":"صحيح","narrator":"مولى لرسول الله","muhaddith":"صحيح","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"oAW8RAq5"},{"id":"س-01090","fp":"ecd84ab8b3a0","stateId":687,"easy":"إذا قلت «لا إله إلا الله» ← تدخل الجنة أو تجب لك","cause":"مَن قالَ: لا إلَهَ إلَّا اللهُ","result":"دخَلَ الجنَّةَ، أو وجبَتْ له الجَنَّةُ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-05618","ref":"المستدرك على الصحيحين 7847","text":[["مَن قالَ: لا إلَهَ إلَّا اللهُ، ",1],["دخَلَ الجنَّةَ، أو وجبَتْ له الجَنَّةُ، ",2],"ومَن قالَ: سُبحانَ اللهِ وبحمدِهِ، مائةً، كتَبَ اللهُ له ألفَ حسنةٍ وأربعًا وعشرينَ ألْفَ حَسنةٍ، قالُوا: يا رسولَ اللهِ، إذنْ لا يَهْلِكُ منَّا أحدٌ، قالَ: بلَى؛ إنَّ أحدَكُمْ لَيَجيءُ بالحَسناتِ لو وُضِعَتْ على جبَلٍ أثقَلَتْه، ثمَّ تَجيءُ النِّعَمُ فتَذْهَبُ بتلكَ، ثمَّ يَتطاوَلُ الرَّبُّ بعْدَ ذلكَ برَحْمتِه."],"grade":"صحيح","narrator":"أبو طلحة الأنصاري","muhaddith":"صحيح الإسناد","takhrij":"لم نقف عليه إلا عند الحاكم (7638).","bab":"أدعية وأذكار › فضل الذكر","dorar":"4u78kqR4"},{"id":"س-02395","fp":"d960afe3226e","stateId":687,"easy":"إذا قلت «لا إله إلا الله» ← تدخل الجنة","cause":"مَن قال : لا إلهَ إلَّا اللهُ","result":"دخَل الجنَّةَ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-05618","ref":"صحيح ابن حبان 151","text":["بعَثني رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فقال : ( نادِ في النَّاسِ ",["مَن قال : لا إلهَ إلَّا اللهُ",1]," ",["دخَل الجنَّةَ",2]," ) فخرَج فلقِيَه عُمرُ في الطَّريقِ فقال : أين تُريدُ ؟ قُلْتُ : بعَثني رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بكذا وكذا قال : ارجِعْ فأبَيْتُ فلهَزني لَهْزَةً في صدري ألَمُها فرجَعْتُ ولَمْ أجِدْ بُدًّا قال : يا رسولَ اللهِ بعَثْتَ هذا بكذا وكذا ؟ قال : ( نَعم ) قال : يا رسولَ اللهِ إنَّ النَّاسَ قد طمِعوا وخَشُوا فقال صلَّى اللهُ عليه وسلَّم : ( اقعُدْ )"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن خزيمة ((التوحيد)) (2/ 801) بنحوه.","bab":"إسلام › فضل الشهادتين","dorar":"jPUWXmwR"},{"id":"س-02410","fp":"06d0c14b73f4","stateId":687,"easy":"إذا قلت «لا إله إلا الله وحده لا شريك له» ← تدخل الجنة وإن زنيت وإن سرقت (بعد عقوبة أو عفو)","cause":"مَن قالَ: لا إلهَ إلَّا اللهُ، وحدَه لا شريكَ لهُ","result":"دخَلَ الجَنَّةَ قالَ: قلْتُ: وإنْ زَنَى وإنْ سَرَقَ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله وحده لا شريك له»"},"repOf":"س-05618","ref":"تخريج المسند لشعيب 27491","text":[["مَن قالَ: لا إلهَ إلَّا اللهُ، وحدَه لا شريكَ لهُ، ",1],["دخَلَ الجَنَّةَ قالَ: قلْتُ: وإنْ زَنَى وإنْ سَرَقَ",2],"؟! قالَ: وإنْ زَنى، وإنْ سَرَقَ. قلتُ: وإنْ زَنى، وإنْ سَرَقَ؟! قالَ: وإنْ زَنَى، وإنْ سَرَقَ. قُلتُ: وإنْ زَنَى، وإنْ سَرَقَ؟! قالَ: وإنْ زَنَى، وإنْ سَرَقَ، على رَغْمِ أَنفِ أبي الدَّرداءِ. قالَ: فخرَجْتُ لأُنادِيَ بها في النَّاسِ، قالَ: فلَقِيَني عُمرُ، فقالَ: ارجِعْ، فإنَّ النَّاسَ إنْ عَلِموا بهذِه، اتَّكَلوا عليها، فرَجَعْتُ، فأخبَرْتُه صلَّى اللهُ عليه وسلَّمَ، فقالَ صلَّى اللهُ عليه وسلَّمَ: صدَقَ عُمَرُ."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح لكن من حديث أبي ذر","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10963)، وأحمد (27491) واللفظ له","bab":"إسلام › فضل الشهادتين","dorar":"WAwGBWF6"},{"id":"س-02420","fp":"9819117dee4f","stateId":687,"easy":"إذا مت تشهد الشهادتين صدقاً من قلبك ← تُسلك في الجنة","cause":"لا يَموتُ عَبْدٌ يَشهَدُ أنْ لا إلهَ إلَّا اللهُ وأنِّي رَسولُ اللهِ صِدْقًا مِن قَلْبِه ثُمَّ يُسَدِّدُ","result":"إلَّا سُلِكَ في الجَنَّةِ","explicit":true,"similar":["س-02448"],"ref":"الصحيح المسند 334","srcLabel":"أحمد","text":["أَقبَلْنا معَ رَسولِ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ حتَّى إذا كنَّا بالكَديدِ -أو قالَ: بقُدَيدٍ- فجَعَلَ رِجالٌ مِنَّا يَسْتَأذِنونَ إلى أهْليهم، فيَأذَنُ لهم، فقامَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، فحَمِدَ اللهَ وأَثْنى عليه، ثُمَّ قالَ: «ما بالُ رِجالٍ يكونُ شِقُّ الشَّجَرةِ الَّتي تَلي رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ أَبغَضَ إليهم مِن الشِّقِّ الآخَرِ؟»، فلم نَرَ عنْدَ ذلك مِن القَوْمِ إلَّا باكِيًا، فقالَ رَجُلٌ: إنَّ الَّذي يَسْتأذِنُك بَعْدَ هذا لَسَفيهٌ، فحَمِدَ اللهَ، وقالَ حينَئذٍ: «أَشهَدُ عنْدَ اللهِ ",["لا يَموتُ عَبْدٌ يَشهَدُ أنْ لا إلهَ إلَّا اللهُ وأنِّي رَسولُ اللهِ صِدْقًا مِن قَلْبِه ثُمَّ يُسَدِّدُ ",1],["إلَّا سُلِكَ في الجَنَّةِ",2],"»، قالَ: «وقد وَعَدَني رَبِّي عَزَّ وجَلَّ أن يُدخِلَ مِن أُمَّتي سَبْعينَ ألْفًا لا حِسابَ عليهم ولا عَذابَ، وإنِّي لَأَرْجو ألَّا يَدخُلوها حتَّى تَبوؤوا أنتم ومَن صَلَحَ مِن آبائِكم وأزْواجِكم وذُرِّيَّاتِكم مَساكِنَ في الجَنَّةِ»، وقالَ: «إذا مَضى نِصْفُ اللَّيْلِ -أو قالَ: ثُلُثا اللَّيْلِ- يَنزِلُ اللهُ عَزَّ وجَلَّ إلى السَّماءِ الدُّنْيا، فيَقولُ: لا أَسأَلُ عن عِبادي أحَدًا غَيْري، مَن ذا يَسْتغفِرُني فأَغفِرَ له؟ من الَّذي يَدْعوني أَستجيبُ له؟ مَن ذا الَّذي يَسأَلُني أُعْطيه، حتَّى يَنْفجِرَ الصُّبْحُ»."],"grade":"صحيح","narrator":"رفاعة بن عرابة","muhaddith":"صحيح، رجاله رجال الصحيح","takhrij":"أخرجه أحمد (16260) واللفظ له، والطبراني (5/51) (4558) باختلاف يسير.","bab":"إسلام › فضل الشهادتين","dorar":"KTsSWP6Q"},{"id":"س-02439","fp":"8763329254c4","stateId":687,"easy":"إذا مت وفي قلبك «لا إله إلا الله» موقناً ← تدخل الجنة","cause":"مَن مات وفي قلْبِه لا إلهَ إلَّا اللهُ مُوقنًا","result":"دخَلَ الجنَّةَ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-05618","ref":"إتحاف الخيرة المهرة 1/120","text":["قال مُعاذُ بنُ جَبلٍ في وصيَّتِه الَّتي تُوفِّيَ عنها: لولا أنْ تتَّكِلوا لحدَّثْتُكم حديثًا سمِعْتُه مِن رسولِ اللهِ صَلَّى اللهُ عليه وسلَّمَ، سمِعْتُ رسولَ اللهِ صَلَّى اللهُ عليه وسلَّمَ يقول: ",["مَن مات وفي قلْبِه لا إلهَ إلَّا اللهُ مُوقنًا؛ ",1],["دخَلَ الجنَّةَ",2],"."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"إسناده صحيح","takhrij":"أخرجه عبد بن حميد في (118)، والطبراني ( 20/ 40/ 59)، واللفظ لهما، وأحمد (2260)، باختلاف يسير، وابن ماجه (3796)، بمعناه.","bab":"إسلام › فضل الشهادتين","dorar":"uM5ptNFb"},{"id":"س-02448","fp":"8dd01530a473","stateId":687,"easy":"إذا مت تشهد الشهادتين صادقاً من قلبك ← تدخل الجنة","cause":"مَن مات وهو يَشهَدُ أنْ لا إلهَ إلَّا اللهُ، وأنَّ محمَّدًا رسولُ اللهِ، صادقًا مِن قَلبِه","result":"دَخَلَ الجنَّةَ، قال شُعبةُ: لم أسأَلْ قَتادةَ: أنَّه سَمِعَه عن أنسٍ","explicit":true,"repOf":"س-02420","ref":"تخريج المسند لشعيب 22003","text":["قال رسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ: ",["مَن مات وهو يَشهَدُ أنْ لا إلهَ إلَّا اللهُ، وأنَّ محمَّدًا رسولُ اللهِ، صادقًا مِن قَلبِه، ",1],["دَخَلَ الجنَّةَ، قال شُعبةُ: لم أسأَلْ قَتادةَ: أنَّه سَمِعَه عن أنسٍ",2],"."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10973)، وأحمد (22003) واللفظ له","bab":"إسلام › فضل الشهادتين","dorar":"ZM0WNJ2D"},{"id":"س-02452","fp":"92da040a4984","stateId":687,"easy":"إذا شهدت أن لا إله إلا الله ثم مت على ذلك ← تدخل الجنة","cause":"لا يَشهَدُ عبدٌ أنْ لا إلهَ","result":"إلَّا اللهُ، ثُمَّ يَموتُ على ذلك، إلَّا دَخَلَ الجنَّةَ","explicit":true,"repOf":"س-05618","ref":"تخريج المسند لشعيب 22009","text":["أنَّ النَّبيَّ صَلَّى اللهُ عليه وسلَّمَ قال له: يا مُعاذُ بنَ جَبلٍ، قال: لَبَّيكَ يا رسولَ اللهِ وسَعدَيكَ، قال: ",["لا يَشهَدُ عبدٌ أنْ لا إلهَ",1]," ",["إلَّا اللهُ، ثُمَّ يَموتُ على ذلك، إلَّا دَخَلَ الجنَّةَ",2],"، قال: قُلتُ: أفَلا أُحدِّثُ النَّاسَ؟ قال: لا؛ إنِّي أخشى أنْ يَتَّكِلوا عليه."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"إسناده صحيح على شرط الشيخين.","takhrij":"أخرجه أحمد (22009) واللفظ له، والطبراني (20/47) (76) مختصراً، وابن منده في ((الإيمان)) (93) باختلاف يسير","bab":"إسلام › فضل الشهادتين","dorar":"681lNqHn"},{"id":"س-02476","fp":"10b30373fe8e","stateId":687,"easy":"إذا قلت «لا إله إلا الله» ← يوجب الله لك الجنة ويعتقك من النار","cause":"مَن قال: لا إلَهَ إلَّا اللهُ أوجَبَ اللهُ عَزَّ وجَلَّ له بها الجَنَّةَ","result":"وأعتَقَه بها مِنَ النَّارِ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-05618","otherNeedIds":[66],"ref":"تخريج المسند لشعيب 15839","text":["نادى رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم ذاتَ لَيلةٍ وأنا رَديفُه: «يا سُهَيلُ بنَ بَيضاءَ» رافِعًا بها صَوتَه مِرارًا، حَتَّى سَمِعَ مَن خَلفَنا وأمامَنا، فاجتَمَعوا وعَلِموا أنَّه يُريدُ أن يَتَكَلَّمَ بشَيءٍ، «إنَّه ",["مَن قال: لا إلَهَ إلَّا اللهُ أوجَبَ اللهُ عَزَّ وجَلَّ له بها الجَنَّةَ، ",1],["وأعتَقَه بها مِنَ النَّارِ»",2],"."],"grade":"صحيح","narrator":"سهيل ابن بيضاء","muhaddith":"صحيح لغيره","bab":"إسلام › فضل الشهادتين","dorar":"z6fxpy0s"},{"id":"س-02717","fp":"083876f3a8bb","stateId":687,"easy":"إذا مت لا تشرك بالله شيئاً ← يجعلك الله في الجنة","cause":"مَن ماتَ لا يُشرِكُ باللهِ شيئًا","result":"جعَلَهُ اللهُ في الجَنَّةِ","explicit":true,"repOf":"س-05618","ref":"تخريج المسند لشعيب 27547","text":["عن مُعاذِ بنِ جَبلٍ أنَّه إذْ حُضِرَ، قالَ: أدْخِلُوا عليَّ النَّاسَ، فأُدْخِلُوا عليه، فقالَ: إنِّي سَمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["مَن ماتَ لا يُشرِكُ باللهِ شيئًا، ",1],["جعَلَهُ اللهُ في الجَنَّةِ",2],". وما كُنتُ أُحَدِّثُكُموهُ إلَّا عندَ الموتِ، والشَّهيدُ على ذلك عُوَيمرٌ أبو الدَّرداءِ، فأَتَوْا أبا الدَّرداءِ، فقالَ: صدَقَ أخي، وما كانَ يُحدِّثُكم بهِ إلَّا عندَ موتِه."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه أحمد (27547) واللفظ له، وابن خزيمة في ((التوحيد)) (2/798)، والطبراني (20/49) (82) باختلاف يسير","bab":"إيمان › القطع بدخول أحد الجنة أو النار","dorar":"HXIBWyQk"},{"id":"س-02821","fp":"970a86caaae3","stateId":687,"easy":"إذا مت تعبد الله لا تشرك به شيئاً ← فلك الجنة","cause":"من مات وهو يعبدُ اللهَ لا يشركُ به شيئًا","result":"فله الجنةَ","explicit":true,"repOf":"س-05618","ref":"الإيمان لابن منده 57","text":["لمَّا مرِض معاذٌ مرضَه الذي توفِّيَ فيه قال : ارفعوا عنِّي سَجْفَ هذه القُبَّةِ فإني سمعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلم يقولُ : ",["من مات وهو يعبدُ اللهَ لا يشركُ به شيئًا ",1],["فله الجنةَ",2]],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (20/ 40) (61)، وأبو نعيم في ((تاريخ أصبهان)) (1/ 127)، واللفظ لهما.","bab":"إيمان › الوعد","dorar":"10jzXYCc"},{"id":"س-02892","fp":"7105e352db24","stateId":687,"easy":"إذا أقبلت بوجهك إلى الله ورسوله ← يدخلك جنات تجري من تحتها الأنهار","cause":"أقْبِلوا بوُجوهِكم إلى اللهِ وإلى رَسولِه صلَّى اللهُ عليه وسلَّمَ","result":"يُدخِلْكم جنَّاتٍ تَجْري من تَحتِها الأنْهارُ","explicit":true,"ref":"المستدرك على الصحيحين 4421","srcLabel":"الحاكم","text":["ندَبَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يومَ حُنَينٍ الأنْصارَ، فقالَ: «يا مَعشَرَ الأنْصارِ»، فأجَابوهُ: لبَّيكَ بأبِينا أنتَ وأُمِّنا يا رَسولَ اللهِ، قالَ: «",["أقْبِلوا بوُجوهِكم إلى اللهِ وإلى رَسولِه صلَّى اللهُ عليه وسلَّمَ",1]," ",["يُدخِلْكم جنَّاتٍ تَجْري من تَحتِها الأنْهارُ",2],"»، فأقْبَلوا ولهُم حَنينٌ حتَّى أحْدَقوا به كَبْكَبةً تُحاكُ مَناكِبُهم يُقاتِلونَ حتَّى هزَمَ اللهُ المُشْركينَ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح الإسناد","bab":"إيمان › الوعد","dorar":"6ef75hSc"},{"id":"س-03216","fp":"c01198b1c04a","stateId":687,"easy":"إذا مت تؤمن بالله واليوم الآخر ← يقال لك: ادخل الجنة من أي أبوابها الثمانية شئت","cause":"من ماتَ يؤمنُ باللهِ واليوم الآخر","result":"قيلَ له ادخلِ الجنةَ من أي أبوابِ الجنةِ الثمانيةِ شئتَ","explicit":true,"ref":"تخريج المسند لشاكر 1/64","srcLabel":"الطيالسي","text":[["من ماتَ يؤمنُ باللهِ واليوم الآخر",1]," ",["قيلَ له ادخلِ الجنةَ من أي أبوابِ الجنةِ الثمانيةِ شئتَ",2]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطيالسي (30)، وأبو نعيم في ((صفة الجنة)) (164)","bab":"إيمان › فضل الإيمان","dorar":"61SbG1cX"},{"id":"س-03485","fp":"33be6d848391","stateId":687,"easy":"إذا لقيت الله لا تشرك به ولم تصب دماً حراماً ← تدخل من أي أبواب الجنة شئت","cause":"ليس مِن عبْدٍ يَلْقى اللهَ لا يُشرِكُ به شَيئًا، لم يَتَنَدَّ بدَمٍ حرامٍ","result":"إلَّا دخَلَ مِن أيِّ أبوابِ الجَنَّةِ شاءَ","explicit":true,"ref":"تخريج المسند لشعيب 17339","srcLabel":"أحمد","text":["انطلَقَ عُقْبةُ بنُ عامِرِ الجُهَنيُّ إلى المَسجِدِ الأَقْصى؛ ليُصلِّيَ فيه، فاتَّبَعَه ناسٌ، فقال: ما جاء بكم؟ قالوا: صُحْبَتُك رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، أَحبَبْنا أنْ نَسيرَ معك، ونُسلِّمَ عليك. قال: انزِلوا فصَلُّوا. فنَزَلوا فصَلَّى وصَلَّوْا معه، فقال حين سَلَّمَ: سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["ليس مِن عبْدٍ يَلْقى اللهَ لا يُشرِكُ به شَيئًا، لم يَتَنَدَّ بدَمٍ حرامٍ",1],"، ",["إلَّا دخَلَ مِن أيِّ أبوابِ الجَنَّةِ شاءَ",2],"."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"إسناده صحيح إن كان عبد الرحمن بن عائذ سمعه من عقبة بن عامر، وسماعه منه محتمل","takhrij":"أخرجه أحمد (17339) واللفظ له، وابن أبي شيبة (28312)، والطبراني (17/351) (969)","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"F19pAktQ"},{"id":"س-03775","fp":"9908084cd227","stateId":687,"easy":"إذا لقيت الله لا تشرك به شيئاً ← تدخل الجنة ولا تضرك معه خطيئة","cause":"من لقيَ اللَّهَ وَهوَ لا يشرِكُ بِهِ شيئًا","result":"دخلَ الجنَّةَ ، ولم تَضرَّ معَهُ خطيئةٌ ، كما لو لقيَهُ وَهوَ مشرِكٌ بِهِ دخلَ النَّارَ ، ولم تنفَعهُ معَهُ حسنةٌ","explicit":true,"repOf":"س-05618","otherNeedIds":[45],"ref":"تخريج المسند لشاكر 10/92","text":[["من لقيَ اللَّهَ وَهوَ لا يشرِكُ بِهِ شيئًا ",1],["دخلَ الجنَّةَ ، ولم تَضرَّ معَهُ خطيئةٌ ، كما لو لقيَهُ وَهوَ مشرِكٌ بِهِ دخلَ النَّارَ ، ولم تنفَعهُ معَهُ حسنةٌ",2]," قالَ أبو نُعَيْمٍ في حديثِهِ : جاءَ رجلٌ أو شيخٌ من أَهْلِ المدينةِ ، فنزلَ على مَسروقٍ فقالَ : سَمِعْتُ عبدَ اللَّهِ بنَ عمرٍو يقولُ : قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : من لقى اللَّهَ لا يشرِكُ بِهِ شيئًا لم تضُرَّهُ معَهُ خطيئةٌ ، ومن ماتَ وَهوَ يشرِكُ بِهِ لم ينفعهُ معَهُ حسنةٌ قالَ عبدُ اللَّهِ بنُ أحمدَ بنِ حنبلٍ : والصَّوابُ ما قالَهُ أبو نُعَيْمٍ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6586) واللفظ له، والطبري في ((مسند ابن عباس)) (941)، والطبراني كما في ((مجمع الزوائد)) للهيثمي (1/24) مختصراً","bab":"الكفر والشرك › ذم الشرك وما ورد فيه من العقوبة","dorar":"EcBBHSSW"},{"id":"س-04230","fp":"b8014b6c1180","stateId":687,"easy":"إذا قلت «لا إله إلا الله» مؤمناً بالله ← تدخل الجنة","cause":"مَن قال لا إلهَ إلَّا اللهُ أو قال : مؤمنًا باللهِ","result":"دخَل الجنَّةَ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-05618","ref":"تخريج صحيح ابن حبان 6171","text":["النَّاسُ أربعةٌ والأعمالُ ستَّةٌ مُوجبتانِ ومِثْلٌ بمِثْلٍ وحسَنةٌ بعَشْرِ أمثالِها وحسَنةٌ بسَبْعِمئةِ ضِعْفٍ والنَّاسُ موسَّعٌ عليه في الدُّنيا والآخرةِ وموسَّعٌ عليه في الدُّنيا مَقتورٌ عليه في الآخرةِ ومَقتورٌ عليه في الدُّنيا موسَّعٌ عليه في الآخرةِ ومَقتورٌ عليه في الدُّنيا والآخرةِ وشَقيٌّ في الدُّنيا وشَقيٌّ في الآخرةِ والمُوجِبتانِ : ",["مَن قال لا إلهَ إلَّا اللهُ أو قال : مؤمنًا باللهِ ",1],["دخَل الجنَّةَ ",2],"ومَن مات وهو يُشرِكُ باللهِ دخَل النَّارَ ومَن هَمَّ بحسَنةٍ فعمِلها كُتِبَتْ له عَشَرةُ أمثالِها ومَن هَمَّ بحسَنةٍ فلم يعمَلْها كُتِبَتْ له حسَنةٌ ومَن هَمَّ بسيِّئةٍ فلم يعمَلْها كُتِبَتْ له حسَنةٌ ومَن هَمَّ بسيِّئةٍ فعمِلها كُتِبَتْ له سيِّئةٌ واحدةٌ غيرُ مضعَّفةٍ ومَن أنفَق نفقةً فاضلةً في سبيلِ اللهِ فبِسَبْعِمِئةِ ضِعْفٍ"],"grade":"صحيح","narrator":"خريم بن فاتك الأسدي","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (6171) واللفظ له، وابن أبي شيبة في ((مسنده)) (743)، وابن ابي عاصم في ((الآحاد والمثاني)) (1047)، والطبراني (4/ 205)(4151) جميعهم باختلاف يسير .","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"0BwkAjc5"},{"id":"س-04744","fp":"896143f969a9","stateId":687,"easy":"إذا قلت «لا إله إلا الله» ابتغاء وجه الله فخُتم لك بها ← دخلت الجنة","cause":"مَن قال: لا إلهَ إلَّا اللهُ -قال حَسَنٌ: ابتِغاءَ وَجْهِ اللهِ- خُتِمَ له بها","result":"دَخَلَ الجَنَّةَ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-05618","ref":"تخريج المسند لشعيب 23324","text":["أسْنَدتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ إلى صَدْري، فقال: ",["مَن قال: لا إلهَ إلَّا اللهُ -قال حَسَنٌ: ابتِغاءَ وَجْهِ اللهِ- خُتِمَ له بها ",1],["دَخَلَ الجَنَّةَ، ",2],"ومَن صامَ يَومًا ابتِغاءَ وَجْهِ اللهِ خُتِمَ له بها دَخَلَ الجَنَّةَ، ومَن تَصدَّقَ بصَدَقةٍ ابتِغاءَ وَجْهِ اللهِ خُتِمَ له بها دَخَلَ الجَنَّةَ."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (23324) واللفظ له، وابن أبي شيبة كما في ((إتحاف الخيرة المهرة)) للبوصيري (6/420)، والبيهقي في ((الأسماء والصفات)) (651)","bab":"رقائق وزهد › الإخلاص","dorar":"YSSvEYh5"},{"id":"س-05360","fp":"492f60881e0b","stateId":687,"easy":"إذا مت موقناً أن الله حق والساعة قائمة والبعث حق ← تدخل الجنة","cause":"من مات وهو يُوقِنُ بثلاثةٍ : أن اللهَ حقٌّ وأن الساعةَ قائمةٌ، وأن اللهَ يبعثُ من في القبورِ","result":"دخل الجنةَ وإمَّا قال : نجا من النارِ","explicit":true,"otherNeedIds":[53,66],"ref":"تخريج كتاب السنة 888","srcLabel":"الطبراني","text":["كنا ثلاثةً نَخدُمُ معاذَ بنَ جبلٍ، فلما حضر قلنا له : يَرْحَمُكَ اللهُ إنما صَحِبناك وانقطعنا إليك، واتبعناك لِمِثلِ هذا اليومِ فحدِّثْنا بحديثٍ سَمِعْتَهُ من رسولِ اللهِ قال : نعم وما ساعةُ الكذبِ هذه سمعتُ رسولَ اللهِ يقولُ : ",["من مات وهو يُوقِنُ بثلاثةٍ : أن اللهَ حقٌّ وأن الساعةَ قائمةٌ، وأن اللهَ يبعثُ من في القبورِ",1]," قال ابنُ سيرين فأنَا نَسِيتُ إمَّا قال : ",["دخل الجنةَ وإمَّا قال : نجا من النارِ",2]],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ابي عاصم في ((السنة)) (888)، والطبراني (20/ 169) (359) واللفظ لهما، وابن خزيمة في ((التوحيد)) (73) بنحوه.","bab":"رقائق وزهد › التوكل واليقين","dorar":"GysWDyhX"},{"id":"س-05818","fp":"ef1224f4e2bf","stateId":687,"easy":"إذا مت لا تشرك بالله شيئاً ← يجعلك الله في الجنة","cause":"مَن ماتَ لا يُشرِكُ باللهِ شَيئًا","result":"جَعَلَه اللهُ في الجَنَّةِ، ولْيَنطَلِقوا بي، فلْيَبعُدوا بي في أرضِ الرُّومِ ما استَطاعوا، فحَدَّثَ النَّاسَ لمَّا ماتَ أبو أيُّوبَ، فاستَلأَمَ النَّاسُ، وانطَلَقوا بجِنازَتِه","explicit":true,"repOf":"س-05618","ref":"تخريج المسند لشعيب 23523","text":["عن رَجُلٍ مِن أهْلِ مَكَّةَ، أنَّ يزيدَ بنَ مُعاويةَ كان أميرًا على الجَيشِ الذي غَزا فيه أبو أيُّوبَ، فدَخَلَ عليه عندَ المَوتِ، فقال له أبو أيُّوبَ: إذا مِتُّ فاقْرَؤوا على النَّاس مِنِّي السَّلامَ، فأخْبِروهم أنِّي سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن ماتَ لا يُشرِكُ باللهِ شَيئًا ",1],["جَعَلَه اللهُ في الجَنَّةِ، ولْيَنطَلِقوا بي، فلْيَبعُدوا بي في أرضِ الرُّومِ ما استَطاعوا، فحَدَّثَ النَّاسَ لمَّا ماتَ أبو أيُّوبَ، فاستَلأَمَ النَّاسُ، وانطَلَقوا بجِنازَتِه",2],"."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرج المرفوع منه النسائي في ((السنن الكبرى)) (8655) مطولاً، وأحمد (23523) واللفظ له","bab":"رقائق وزهد › الوصايا النافعة","dorar":"of6pbPfe"},{"id":"س-06365","fp":"969c8fb21892","stateId":687,"easy":"إذا مت مسلماً مؤمناً لا تشرك بالله ← وجبت لك الجنة","cause":"مَن ماتَ مسلمًا مؤمنًا لا يشرِكُ باللَّهِ شيئًا","result":"وجبَتْ لَهُ الجنَّةُ","explicit":true,"repOf":"س-05618","ref":"عمدة التفسير 1/846","text":["النَّاسُ أربعةٌ ، والعمَّالُ ستَّةٌ . فالنَّاسُ موسَّعٌ لَهُ في الدُّنيا والآخرةِ ، وموسَّعٌ لَهُ في الدُّنيا مقتورٌ عليهِ في الآخرةِ ، ومقتورٌ عليهِ في الدُّنيا موسَّعٌ لَهُ في الآخرةِ ، وشقيٌ في الدُّنيا والآخرةِ . والأعمالُ موجبتانِ ، ومثلٌ بمثلٍ ، وعشرةُ أضعافٍ ، وسبعُمائةِ ضعفٍ ؛ فالموجبتانِ ",["مَن ماتَ مسلمًا مؤمنًا لا يشرِكُ باللَّهِ شيئًا",1]," ",["وجبَتْ لَهُ الجنَّةُ",2]," ، ومَن ماتَ كافرًا وجبَتْ لَهُ النَّارُ . ومَن همَّ بحسنةٍ فلَم يعملْها ، فعلِمَ اللَّهُ أنَّهُ قد أشعرَها قلبَه وحرصَ علَيها ، كُتبَت لَهُ حسنةً . ومَن همَّ بسيِّئةٍ لم تُكْتَب عليهِ ، ومَن عمِلَها كُتبَت واحدةً ولم تُضاعَف عليهِ . ومَن عملَ حسنةً كانت له بعشرةِ أمثالِها . ومَن أنفقَ نفقةً في سبيلِ اللَّهِ ، عزَّ وجلَّ ، كانت لَهُ بسبعِمائةِ ضعفٍ"],"grade":"صحيح","narrator":"خريم بن فاتك الأسدي","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي شيبة في ((مسنده)) (743)، وابن ابي عاصم في ((الآحاد والمثاني)) (1047)، وابن حبان (4630) جميعهم باختلاف يسير .","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"mVsonKjD"},{"id":"س-03856","fp":"77f86feab762","stateId":687,"easy":"إذا عبدت الله ونصرت النبي ﷺ ← فلك الجنة","cause":"أشترطُ لربي أن تعبدوهُ ولا تشركوا به شيئًا، وأشترط لنفسي أن تمنعوني ما تمنعون منه أنفسَكم وأهليكم، وأشترط لأصحابي المواساةَ في ذات أيديكم","result":"فما لنا ؟ قال : قال : الجنةُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-02610"],"otherNeedIds":[47],"ref":"أحكام القرآن لابن العربي 2/589","srcLabel":"أحمد","text":["ذهب النبيُّ صلَّى اللهُ عليهِ وسلَّمَ ليلةَ العقبةِ وذهب معه العباسُ بنُ عبدِ المطلبِ، فقال العباسُ : تكلَّموا يا معشرَ الأنصارِ وأوجِزوا، فإنَّ علينا عيونًا، قال الشعبي : فخطب أبو أمامةَ أسعدُ بنُ زرارةَ خطبةً ما خطب المردُ ولا الشيبُ مثلَها قطُّ، فقال : يا رسولَ اللهِ اشترطْ لربِّك واشترط لنفسِك واشترطْ لأصحابك، قال : ",["أشترطُ لربي أن تعبدوهُ ولا تشركوا به شيئًا، وأشترط لنفسي أن تمنعوني ما تمنعون منه أنفسَكم وأهليكم، وأشترط لأصحابي المواساةَ في ذات أيديكم",1]," . قالوا : هذا لك ",["فما لنا ؟ قال : قال : الجنةُ",2]," . قال : ابسطْ يدَك"],"grade":"صحيح","narrator":"الشعبي عامر بن شراحيل","muhaddith":"هذا وإن كان مقطوعا فإن معناه ثابت من طرق","takhrij":"أخرجه الدولابي في ((الكنى والأسماء)) (1/ 33) واللفظ له، وأحمد (17078) باختلاف يسير، وابن أبي شيبة (38258) باختلاف يسير.","bab":"بيعة › البيعة على ماذا تكون","dorar":"s47quNkw","merged":4,"otherRefs":["فتح الباري لابن حجر 7/263 (حسن)","المستدرك على الصحيحين 5501 (صحيح)","الأحاديث المختارة 1962 (صحيح)"]},{"id":"س-01215","fp":"9bd97dad0204","stateId":687,"easy":"إذا قلتها صادقاً ← يدخلك الله بها الجنة","cause":"مَن قالها صادقًا","result":"أدخَله اللهُ بها الجنَّةَ","explicit":true,"repOf":"س-05618","ref":"مجمع الزوائد 1/31","text":["إنَّ لا إلهَ إلَّا اللهُ كلمةٌ على اللهِ كريمةٌ لها عندَ اللهِ مكانٌ وهي كلمةٌ ",["مَن قالها صادقًا",1]," ",["أدخَله اللهُ بها الجنَّةَ",2]," ومَن قالها كاذبًا حقَنَت دمَه وأحرَزَت مالَه ولقي اللهَ غدًا فحاسَبه"],"grade":"حسن","narrator":"عياض الأنصاري","muhaddith":"رجاله موثقون إن كان تابعية عبد الرحمن بن عبد الله بن مسعود","takhrij":"أخرجه البزار كما في ((كشف الأستار)) (4)، والشجري في ((ترتيب الأمالي الخميسية)) (97)،  واللفظ لهما، وأبو نعيم في ((معرفة الصحابة)) (5442)، باختلاف يسير.","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"nBhcN8j3"},{"id":"س-01216","fp":"8828b2deafb7","stateId":687,"easy":"إذا قلت «لا إله إلا الله» مخلصاً ← تدخل الجنة","cause":"من قال لا إلهَ إلا اللهُ مخلصًا","result":"دخل الجنةَ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-05618","ref":"تخريج الإحياء للعراقي 2/98","text":[["من قال لا إلهَ إلا اللهُ مخلصًا ",1],["دخل الجنةَ ",2],", قيل وما إخلاصُها قال : تحجِزُه عما حرَّمَ اللهُ ."],"grade":"حسن","narrator":"زيد بن أرقم","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني (5/197) (5074)، والحكيم الترمذي في ((نوادر الأصول)) (1/90)، وأبو نعيم في ((حلية الأولياء)) (9/254) باختلاف يسير","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"XlJKyWWw"},{"id":"س-02437","fp":"d2dd2148063a","stateId":687,"easy":"إذا جئت بالشهادتين غير شاك ← لم تُحجب عن الجنة","cause":"مَن جاء بهِما غيرَ شاكٍّ بهما","result":"لم يُحجَبْ عنِ الجنةِ","explicit":true,"repOf":"س-02391","ref":"إتحاف الخيرة المهرة 1/117","text":["كنا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّم في سفَرٍ، فقال: أشهدُ أن لا إلهَ إلا اللهُ ، وأني رسولُ اللهِ ، ",["مَن جاء بهِما غيرَ شاكٍّ بهما ، ",1],["لم يُحجَبْ عنِ الجنةِ",2]],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"إسناده رجاله ثقات","takhrij":"أخرجه مسدد كما في ((إتحاف الخيرة المهرة)) للبوصيري (1/117) واللفظ له، والدارقطني في ((العلل)) (13/401)","bab":"إسلام › فضل الشهادتين","dorar":"cJSEPgWl"},{"id":"س-02438","fp":"d02bc216b6d1","stateId":687,"easy":"إذا شهدت أن لا إله إلا الله أو مت لا تشرك بالله ← تدخل الجنة","cause":"ما مِن رجلٍ يشهدُ أن لا إلهَ","result":"إلا اللهُ - أو مات لا يشركُ باللهِ شيئًا - إلا دخَل الجنةَ ، أو لم يدخُلِ النارَ","explicit":true,"repOf":"س-05618","otherNeedIds":[66],"ref":"إتحاف الخيرة المهرة 1/74","text":[["ما مِن رجلٍ يشهدُ أن لا إلهَ",1]," ",["إلا اللهُ - أو مات لا يشركُ باللهِ شيئًا - إلا دخَل الجنةَ ، أو لم يدخُلِ النارَ -",2]," قلتُ : وإن زنا وإن سرَق ، قال : وإن زنا وإن سرَق ورغِم أنفُ أبي الدرداءِ"],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"إسناده رجاله ثقات","bab":"إسلام › فضل الشهادتين","dorar":"AKWwPZJo"},{"id":"س-04709","fp":"f123a49cbfac","stateId":687,"easy":"إذا عبدت الله خالصاً ← يقال: صدق عبدي، انطلقوا به إلى الجنة","cause":"فرقةٌ تعبدُ اللهَ خالصًا","result":"قال : صدقَ عَبدي انطلِقوا به إلى الجنةِ","explicit":true,"otherNeedIds":[19],"ref":"البدور السافرة 196","srcLabel":"الطبراني","text":["إذا كان آخرُ الزمانِ صارَتْ أُمتي ثلاثَ فرقٍ : ",["فرقةٌ تعبدُ اللهَ خالصًا",1]," ، وفرقةٌ تعبدُ اللهَ رياءً ، وفرقةٌ يعبدونَ اللهَ ليستأكِلوا به الناسَ ، فإذا جمعَهمُ اللهُ يومَ القيامةِ قال للذي كان يستأكلُ الناسَ : بعزَّتي وجَلالي ما أردْتَ بعبادَتي ؟ فيقولُ : وعزَّتِكَ وجلالِكَ أستأكلُ به الناسَ ، قال : لم ينفعْكَ ما جمعْتَ شيئًا تلجأُ إليه انطلِقوا به إلى النارِ ، ثم يقولُ للذي كان يعبدُ رياءً : بعزَّتي وجلالي ما أردْتَ بعبادتي ؟ قال : بعزتِكَ وجلالِكَ أردْتَ بعبادتِكَ رياءً للناسِ قال : لم يصعدْ إليَّ منه شيءٌ انطلقوا به إلى النارِ ، ثم يقولُ للذي كان يعبدُهُ خالصًا ، بعزَّتي وجَلالي ما أردْتَ بعبادَتي ؟ قال : بعزتِكَ وجلالِكَ أنتَ أعلمُ بذلكَ مني أردْت به ذِكرَكَ ووجهَكَ ، ",["قال : صدقَ عَبدي انطلِقوا به إلى الجنةِ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (5105)، والبيهقي في ((شعب الإيمان)) (6808) باختلاف يسير.","bab":"رقائق وزهد › الإخلاص","dorar":"ysnCCp7U"},{"id":"س-03101","fp":"3cb5fcd88cf1","stateId":687,"easy":"إذا حفظت أسماء الله الحسنى ← تدخل الجنة","cause":"لا يحفظُها أحدٌ","result":"إلا دخل الجنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-02859","ref":"صحيح الجامع 2167","text":["إنَّ للهِ تعالى تسعةً و تسعين اسمًا مائةً غيرَ واحدٍ ، ",["لا يحفظُها أحدٌ",1]," ",["إلا دخل الجنَّةَ",2]," ، و هو وترٌ يحبُّ الوترَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6410)، ومسلم (2677) باختلاف يسير","bab":"إيمان › توحيد الأسماء والصفات","dorar":"S9GNWfZP"},{"id":"س-07894","fp":"15bf5190479c","stateId":687,"easy":"إذا شهدت أن لا إله إلا الله يوماً مخلصاً ومت عليها ← تدخل الجنة","cause":"مَن شَهِدَ أنْ لا إلهَ إلَّا اللهُ يَوْمًا واحِدًا مُخلِصًا، وماتَ على ذلك","result":"أَدخِلْ مِن أمَّتِك مِن خَلْقِ اللهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-05618","ref":"الأحاديث المختارة 2695","text":["«حَدَّثَني نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنِّي لقائِمٌ أنْتَظِرُ أمَّتي تَعبُرُ الصِّراطَ إذ جاءَني عيسى، قالَ: فقالَ: هذه الأنْبِياءُ قد جاءَتْك يا مُحمَّدُ يَسْألونَ، أو قالَ: يَجْتَمِعونَ إليك ويَدْعونَ اللهَ عَزَّ وجَلَّ أن تُفرِّقَ بَيْنَ جَمْعِ الأُمَمِ إلى حيثُ يَشاءُ اللهُ؛ لِغَمِّ ما هُمْ فيه، فالخَلْقُ مُلجَمونَ في العَرَقِ، فأمَّا المُؤْمِنُ فهو عليه كالزُّكْمةِ، وأمَّا الكافِرُ فيَتَغشَّاه المَوْتُ، قالَ: قالَ عيسى: انْتَظِرْ حتَّى أرْجِعَ إليك، قالَ: فذَهَبَ نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ فقامَ تحتَ العَرْشِ، فلَقيَ ما لم يَلْقَ مَلَكٌ مُصْطَفًى، ولا نَبِيٌّ مُرسَلٌ، فأَوْحى اللهُ عَزَّ وجَلَّ إلى جِبْريلَ أن اذْهَبْ إلى مُحمَّدٍ صلَّى اللهُ عليه وسلَّمَ فقُلْ له: ارْفَعْ رأسَك، سَلْ تُعْطَه، واشْفَعْ تُشَفَّعْ، قالَ: فشُفِّعْتُ في أمَّتي أن أُخرِجَ مِن كلِّ تِسْعةٍ وتِسْعينَ إنْسانًا واحِدًا، قالَ: فما زِلْتُ أتَرَدَّدُ على رَبِّي عَزَّ وجَلَّ فلا أقومُ مِنه مَقامًا إلَّا شُفِّعْتُ حتَّى أعْطاني اللهُ مِن ذلك أن قالَ: يا مُحمَّدُ، ",["أَدخِلْ مِن أمَّتِك مِن خَلْقِ اللهِ",2]," ",["مَن شَهِدَ أنْ لا إلهَ إلَّا اللهُ يَوْمًا واحِدًا مُخلِصًا، وماتَ على ذلك",1],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"قيامة › الشفاعة","dorar":"RwPYP6i7"},{"id":"س-02425","fp":"37cdadd85c10","stateId":687,"easy":"إذا وحّدت الله ← يدخلك الجنة برحمته لا بعملك","cause":"إلَّا بتوحيدٍ من اللهِ تعالى","result":"لا يُدخِلُ أحدًا منكُم الجنَّةَ عملُهُ ، ولا يجيرُهُ من النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"otherNeedIds":[66],"ref":"حادي الأرواح 82","srcLabel":"مسلم","text":[["لا يُدخِلُ أحدًا منكُم الجنَّةَ عملُهُ ، ولا يجيرُهُ من النَّارِ",2]," ، ولا أنا ",["إلَّا بتوحيدٍ من اللهِ تعالى",1]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده على شرط مسلم ، وأصل الحديث في الصحيح","takhrij":"أخرجه أبو نعيم في ((صفة الجنة)) (52) واللفظ له، ومسلم (2817)، وأحمد (15236) باختلاف يسير.","bab":"إسلام › فضل الشهادتين","dorar":"w4ET02lj"},{"id":"س-02444","fp":"a32b970997b5","stateId":687,"easy":"إذا لقيت الله بالشهادتين غير شاك ← لا تُحجب عن الجنة","cause":"عبدٌ غيرُ شاكٍّ","result":"لا يَلقى اللهَ بهما عبدٌ غيرُ شاكٍّ فيُحجَبَ عنِ الجنَّةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-02391","ref":"تخريج صحيح ابن حبان 6530","text":["لمَّا كان غزوةُ تبوكَ أصاب النَّاسَ مجاعةٌ فقالوا : يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّم لو أذِنْتَ لنا فنحَرْنا نواضحَنا فأكَلْنا فقال لهم رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ( افعَلوا ) فجاء عُمَرُ رضوانُ اللهِ عليه وقال : يا رسولَ اللهِ إنَّهم إنْ فعَلوا قلَّ الظَّهرُ ولكنِ ادعُهم بفضلِ أَزْوِدَتِهم ثمَّ ادعُ عليها بالبركةِ لعلَّ اللهَ أنْ يجعَلَ في ذلك قال : فدعا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بنِطْعٍ فبسَطْتُه ثمَّ دعاهم بفضلِ أَزْوِدَتِهم قال : فجعَل الرَّجُلُ يجيءُ بكَفِّ الذُّرَةِ والآخَرُ بكَفِّ التَّمرِ والآخَرُ بكِسرةٍ حتَّى اجتَمَع على النِّطعِ مِن ذلك يسيرٌ قال : فدعا عليه صلَّى اللهُ عليه وسلَّم بالبركةِ ثمَّ قال : ( خُذوا في أوعيتِكم ) فأخَذوا في أوعيتِهم حتَّى ما ترَكوا في العسكرِ وِعاءً إلَّا ملَؤوه وأكَلوا حتَّى شبِعوا وفضَل منه فَضْلةٌ قال : فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ( أشهَدُ أنْ لا إلهَ إلَّا اللهُ وأنِّي رسولُ اللهِ ",["لا يَلقى اللهَ بهما عبدٌ غيرُ شاكٍّ فيُحجَبَ عنِ الجنَّةِ",2]," )"],"grade":"صحيح","narrator":"أبو سعيد الخدري وأبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (27)، وأحمد (11080)، وأبو يعلى (1199) واللفظ لهم.","bab":"إسلام › فضل الشهادتين","dorar":"RUmFUffS"},{"id":"س-04106","fp":"28ffa807196a","stateId":687,"easy":"إذا أجبت الداعي إلى الله ← دخلت الجنة","cause":"فمن أجابَهُ","result":"دخلَ الجنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الترمذي 2861","srcLabel":"مسلم","text":["قالَ صلَّى رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ العشاءَ ثمَّ انصرفَ فاخذ بيدِ عبدِ اللَّهِ بنِ مسعودٍ حتَّى خرجَ بِهِ إلى بَطحاءِ مَكَّةَ فأجلسَهُ ثمَّ خطَّ علَيهِ خطًّا ثمَّ قالَ: لا تبرَحنَّ خطَّكَ فإنَّهُ سينتَهي إليكَ رجالٌ فلا تُكَلِّمهم فإنَّهم لا يُكَلِّمونَكَ، قالَ: ثمَّ مضى رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ حيثُ أرادَ، فبينا أَنا جالسٌ في خطِّي إذ أتاني رجالٌ كأنَّهمُ الزُّطُّ أشعارُهُم وأجسامُهُم لا أرى عورةً ولا أرى قِشرًا وينتَهونَ إليَّ، ولا يجاوزونَ الخطَّ ثمَّ يَصدرونَ إلى رسولِ اللَّهِ حتَّى إذا كانَ من آخرِ اللَّيلِ، لَكِن رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ قد جاءَني وأَنا جالسٌ، فقالَ: لقد أراني منذُ اللَّيلة ثمَّ دخلَ عليَّ في خطِّي فتوسَّدَ فخذي ورَقدَ وَكانَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ إذا رقدَ نفخَ، فبينا أَنا قاعدٌ ورسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ متوسِّدٌ فخذي إذا أَنا برجالٍ علَيهِم ثيابٌ بيضٌ اللَّهُ أعلمُ ما بِهِم منَ الجَمالِ فانتَهَوا إليَّ، فجلسَ طائفةٌ منهم عندَ رأسِ رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وطائفةٌ منهم عندَ رجليهِ ثمَّ قالوا بينَهُم: ما رَأينا عبدًا قطُّ أوتيَ مثلَ ما أوتيَ هذا النَّبيُّ صلَّى اللَّهُ علَيهِ وسلَّمَ إنَّ عينيهِ تَنامانِ وقلبُهُ يَقظانُ، اضربوا لَهُ مثلًا مثلُ سيِّدٍ بنى قصرًا ثمَّ جعلَ مائدة فدعا النَّاسَ إلى طعامِهِ وشرابِهِ، فمَن أجابَهُ أَكَلَ من طعامِهِ وشربَ من شرابِهِ ومن لم يجبهُ عاقبَهُ - أو قالَ: عذَّبَهُ - ثمَّ ارتفَعوا، واستيقَظَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ عندَ ذلِكَ فقالَ: سمعتَ ما قالَ هؤلاءِ؟ وَهَل تدري مَن هم؟ قلتُ: اللَّهُ ورسولُهُ أعلمُ، قالَ: همُ الملائِكَةُ، فتَدري ما المثلُ الَّذي ضرَبوه؟ قلتُ: اللَّهُ ورسولُهُ أعلمُ، قالَ: المثلُ الَّذي ضرَبوه الرَّحمنُ بنى الجنَّةَ ودعى إليها عِبادَه، ",["فمن أجابَهُ",1]," ",["دخلَ الجنَّةَ",2]," ومن لم يجبهُ عاقبَهُ أو عذَّبَهُ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"حسن صحيح","takhrij":"أخرجه الترمذي (2861) بلفظه، وقوام السنة في ((دلائل النبوة)) (65) باختلاف يسير، ومسلم (450) بنحوه.","bab":"جن › وفد الجن","dorar":"umsXQrcS"},{"id":"س-02583","fp":"54aa13c8e673","stateId":687,"easy":"إذا رفضت أن تقرّب لغير الله ولو ذباباً ← تدخل الجنة","cause":"ما كنتُ لأقرِّبَ لأحدٍ شيئًا دون اللهِ عزَّ وجلَّ","result":"فدخل الجنَّةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"شرح كتاب التوحيد لابن باز 100","srcLabel":"أحمد","text":["دخل الجنَّةَ رجلٌ في ذُبابٍ ودخل النارَ رجلٌ في ذُبابٍ قالوا: كيف ذلك يا رسولَ اللهِ؟ قال: مر رجلان على قومٍ لهم صنمٌ لا يجوزُه أحدٌ حتى يقربَ له شيئًا، فقالوا لأحدِهما: قربْ فقال: ليس عندي شيءٌ أقرِّبُ، قالوا له: قرِّبْ ولو ذُبابًا، فقرَّبَ ذبابًا، فخلوا سبيلَه فدخل النارَ، وقالوا للآخرِ: قرِّبْ فقال: ",["ما كنتُ لأقرِّبَ لأحدٍ شيئًا دون اللهِ عزَّ وجلَّ",1]," فضربوا عنقَه ",["فدخل الجنَّةَ",2],"."],"grade":"حسن","narrator":"[سلمان]","muhaddith":"إسناده جيد","takhrij":"أخرجه ابن أبي شيبة (33038)، وأحمد في ((الزهد)) (84)، وابن الأعرابي في ((معجم الشيوخ)) (1796)، وأبو نعيم في ((حلية الأولياء)) (1/ 203) واللفظ لهم.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"RI2lLIuE"},{"id":"س-02718","fp":"0cf9e507b059","stateId":687,"easy":"إذا شهدت أن محمداً رسول الله ← أوجبت الجنة","cause":"أشهدُ أنَّ محمدًا رسولُ اللهِ","result":"أَوجَب الجنةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-05618","ref":"إتحاف الخيرة المهرة 1/486","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّم في سفَرٍ ، فلما غابَتِ الشمسُ سمِع رجلًا يؤذِّنُ ، فقال : اللهُ أكبرُ اللهُ أكبرُ ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم مِثلَما قال ، فقال : أشهدُ أن لا إلهَ إلا اللهُ ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : شهِد شهادةَ الحقِّ ، فقال : ",["أشهدُ أنَّ محمدًا رسولُ اللهِ",1]," ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ",["أَوجَب الجنةَ",2]," ، ثم قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : اطلُبوه ، فإنَّكم تجِدونَه راعيًا معزبًا أو مكلبًا ، قال : فطلَبوا فوجَدوه راعيًا معزبًا"],"grade":"حسن","narrator":"أشياخ عبدالرحمن بن أبي ليلى","muhaddith":"إسناده رجاله ثقات","takhrij":"أخرجه ابن أبي شيبة في ((المسند)) (956)، وأحمد بن منيع كما في ((إتحاف الخيرة المهرة)) للبوصيري (907) باختلاف يسير","bab":"إيمان › القطع بدخول أحد الجنة أو النار","dorar":"juI6vnvy"},{"id":"س-00594","fp":"141bc29c591c","stateId":687,"easy":"إذا أجبت داعي الله ← تدخل الجنة وتأكل مما فيها","cause":"مَن أجابَكَ","result":"دخَلَ الجنَّةَ، ومَن دخَلَ الجنَّةَ أكَلَ ما فيها","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-00606","ref":"المستدرك على الصحيحين 8401","text":["خرَجَ إلينا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يومًا، فقال: إنِّي رَأيتُ في المنامِ كأنَّ جِبريلَ عليه الصَّلاةُ والسَّلامُ عِندَ رَأْسي، ومِيكائيلَ عِندَ رِجْلي، يَقولُ أحدُهما لِصاحبِه: اضْرِبْ له مثَلًا، فقال: اسْمَعْ سَمِعَت أُذنُكَ، واعْقِلْ عَقَل قلْبُكَ، مَثَلَك ومَثَلُ أُمَّتِك كمَثَلِ مَلِكٍ اتَّخَذَ دارًا، ثمَّ بَنى فيها بَيتًا، ثمَّ جَعَل فيها مائدةً، ثمَّ بَعَث رَسولًا يَدْعو النَّاسَ إلى طَعامِه، فمنْهم مَن أجاب الرَّسولَ، ومنْهم مَن تَرَكَه؛ واللهُ هو الملِكُ، والدَّارُ الإسلامُ، والبيتُ الجنَّةُ، وأنتَ يا محمَّدُ رَسولٌ؛ ",["مَن أجابَكَ",1]," ",["دخَلَ الجنَّةَ، ومَن دخَلَ الجنَّةَ أكَلَ ما فيها",2],"."],"grade":"صحيح","narrator":"جابر بن عبد اللهِ الأنصاري","muhaddith":"صحيح الإسناد ولم يخرجاه","bab":"آداب عامة › ضرب الأمثال","dorar":"eer0d9Mr"},{"id":"س-05471","fp":"6698693fddeb","stateId":687,"easy":"إذا لم تشرك بالله شيئاً ← يدخلك الله جنته","cause":"مَن كانَ لا يُشرِكُ بي شَيئًا","result":"أدخِلوا جَنَّتي","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-05618","otherNeedIds":[17],"ref":"مسند أبي بكر الصديق 700","text":["أصبَحَ رَسولُ اللَّهِ صلَّى اللهُ عليه وسلَّم ذاتَ يَومٍ، فصَلَّى الغَداةَ، ثُمَّ جَلَسَ، حَتَّى إذا كانَ مِنَ الصُّبحِ ضَحِكَ رَسولُ اللَّهِ صلَّى اللهُ عليه وسلَّم، ثُمَّ جَلَسَ مَكانَه، حَتَّى صَلَّى الأولى والعَصرَ والمَغرِبَ، كُلَّ ذلك لا يَتَكَلَّمُ، حَتَّى صَلَّى العِشاءَ الآخِرةَ، ثُمَّ قامَ إلى أهلِه، فقال النَّاسُ لأبي بَكرٍ: ألا تَسألُ رَسولَ اللَّهِ صلَّى اللهُ عليه وسلَّم: ما شَأنُه؟ صَنَعَ اليَومَ شَيئًا لَم يَصنَعْه قَطُّ! فسَألَه، فقال: نَعَم، عُرِضَ عليَّ ما هو كائِنٌ مِن أمرِ الدُّنيا وأمرِ الآخِرةِ، يُجمَعُ الأوَّلونَ والآخِرونَ بصَعيدٍ واحِدٍ، فقَطَعَ النَّاسُ بذلك، حَتَّى انطَلَقوا إلى آدَمَ -والعَرَقُ يَكادُ يُلجِمُهم- فقالوا: يا آدَمُ، أنتَ أبو البَشَرِ، وأنتَ اصطَفاكَ اللَّهُ، اشفَعْ لَنا إلى رَبِّكَ. فقال: لَقد لَقيتُ مِثلَ الذي لَقيتُم، فانطَلِقوا إلى أبيكُم بَعدَ أبيكُم: إلى نوحٍ {إنَّ اللَّهَ اصطَفى آدَمَ ونوحًا وآلَ إبراهيمَ وآلَ عِمرانَ على العالَمينَ} [آل عمران: 33]. قال: فيَنطَلِقونَ إلى نوحٍ عليه السَّلامُ فيَقولونَ: اشفَعْ لَنا إلى رَبِّكَ، فأنتَ اصطَفاكَ اللَّهُ، واستَجابَ لَكَ في دُعائِكَ، ولَم يَدَعْ على الأرضِ مِنَ الكافِرينَ دَيَّارًا. فيَقولُ: ليس ذلك عِندي، انطَلِقوا إلى إبراهيمَ؛ فإنَّ اللَّهَ اتَّخَذَه خَليلًا. فيَنطَلِقونَ إلى إبراهيمَ فيَقولُ: ليس ذلكم عِندي، انطَلِقوا إلى موسى؛ فإنَّ اللَّهَ كَلَّمَه تَكليمًا. فيَقولُ موسى: ليس ذلكم عِندي، انطَلِقوا إلى عيسى ابنِ مَريَمَ؛ فإنَّه يُبرِئُ الأكمَهَ والأبرَصَ ويُحيي المَوتى. فيَقولُ عيسى: ليس ذلكم عِندي، ولَكِنِ انطَلِقوا إلى سَيِّدِ ولَدِ آدَمَ؛ فإنَّه أوَّلُ مَن تَنشَقُّ (عنه الأرضُ) يَومَ القيامةِ، انطَلِقوا إلى مُحَمَّدٍ فيَشفَعَ لَكُم إلى رَبِّكُم. قال: فيَنطَلِقُ (فيُنادي جِبريل، قال): فيَأتي جِبريلُ رَبَّه عَزَّ وجَلَّ، قال: فيَنطَلِقُ فيَأتي جِبريلُ رَبَّه تَعالى، فيَقولُ اللَّهُ تَعالى: (ائذَنْ لَه، وبَشِّرْهُ بالجَنَّةِ). قال: فيَنطَلِقُ به جِبريلُ فيَخِرُّ ساجِدًا قَدرَ جُمُعةٍ، ويَقولُ اللَّهُ عَزَّ وجَلَّ: (ارفَعْ رَأسَكَ [يا مُحَمَّدُ] وقُلْ يُسمَعْ، واشفَعْ تُشَفَّعْ). قال: فيَرفَعُ رَأسَه، فإذا نَظَرَ إلى رَبِّه عَزَّ وجَلَّ خَرَّ ساجِدًا قَدرَ جُمُعةٍ أُخرى، فيَقولُ اللَّهُ عَزَّ وجَلَّ: (ارفَعْ رَأسَكَ، وقُلْ يُسمَعْ، واشفَعْ تُشَفَّعْ). قال: فيَذهَبُ ليَقَعَ ساجِدًا، فيَأخُذُ جِبريلُ بضَبعَيه فيَفتَحُ عليه مِنَ الدُّعاءِ شَيئًا لَم يَفتَحْه على بَشَرٍ، فيَقولُ: أي رَبِّ، خَلَقتَني سَيِّدَ ولَدِ آدَمَ ولا فخرَ، وأوَّلَ مَن تَنشَقُّ عنه الأرضُ يَومَ القيامةِ ولا فَخرَ، حَتَّى إنَّه لَيَرِدُ عليَّ الحَوضَ أكثَرُ مِمَّا بَينَ صَنعاءَ وأَيلةَ. ثُمَّ يُقالُ: ادعوا الصِّدِّيقينَ. فيَشفَعونَ، ثُمَّ يُقالُ: ادعوا الأنبياءَ. قال: فيَجيءُ النَّبيُّ مَعَه العِصابةُ، والنَّبيُّ مَعَه الخَمسةُ والسِّتَّةُ، والنَّبيُّ ليس مَعَه أحَدٌ، ثُمَّ يُقالُ: ادعوا الشُّهَداءَ. فيَشفَعونَ لمَن أرادوا، قال: فإذا فعَلَتِ الشُّهَداءُ ذلك، قال: يَقولُ اللَّهُ عَزَّ وجَلَّ: (أنا أرحَمُ الرَّاحِمينَ، ",["أدخِلوا جَنَّتي",2]," ",["مَن كانَ لا يُشرِكُ بي شَيئًا",1],"). قال: فيَدخُلونَ الجَنَّةَ، قال: ثُمَّ يَقولُ اللَّهُ عَزَّ وجَلَّ: (انظُروا في النَّارِ، هَل تَلقَونَ مِن أحَدٍ عَمِلَ خَيرًا قَطُّ؟). قال: فيَجِدونَ في النَّارِ رَجُلًا، فيَقولُ لَه: هَل عَمِلتَ خَيرًا قَطُّ؟ فيَقولُ: لا، غَيرَ أنِّي كُنتُ أُسامِحُ النَّاسَ في البَيعِ. فيَقولُ اللَّه: (أسمِحوا لعَبدي كَإسماحِه إلى عَبيدي). ثُمَّ يُخرِجونَ مِنَ النَّارِ رَجُلًا، فيَقولُ لَه: هَل عَمِلتَ خَيرًا قَطُّ؟ فيَقولُ: لا، غَيرَ أنِّي قد أمَرتُ ولَدي: إذا مُتُّ فأحرِقوني بالنَّارِ، ثُمَّ اطحَنوني، حَتَّى إذا كُنتُ مِثلَ الكُحلِ فاذهَبوا بي إلى البَحرِ، فاذْرُوني في الرِّيحِ، فواللَّهِ لا يَقدِرُ عليَّ رَبُّ العالَمينَ أبَدًا. فقال اللَّهُ تَعالى: (لمَ فعَلتَ ذلك؟) قال: مِن مَخافَتِكَ. قال: فيَقولُ اللَّهُ عَزَّ وجَلَّ: (انظُرْ إلى مُلكِ أعظَمِ مَلِكٍ؛ فإنَّ لَكَ مِثلَه وعَشَرةَ أمثالِه)، قال: فيَقولُ: لمَ تَسخَرُ بي وأنتَ المَلِكُ؟ قال: (يَعني: رَسولَ اللَّهِ صلَّى اللهُ عليه وسلَّم): (وذلك الذي ضَحِكتُ منه مِنَ الضُّحى)"],"grade":"صحيح","narrator":"حذيفة","muhaddith":"[صحيح]","bab":"رقائق وزهد › الخوف من الله","dorar":"On8AXZvT"},{"id":"س-00849","fp":"22304d3fc479","stateId":687,"easy":"إذا قلت لا إله إلا الله ← فهي موجبة للجنة","cause":"لا إلهَ إلَّا اللهُ","result":"أنَّها مُوجِبةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-05618","ref":"تخريج مسند أبي بكر 13","text":["أنَّ أبا بَكرٍ رضيَ اللهُ عنه لَقِيَ طَلحةَ بنَ عبدِ اللهِ، فقال: ما لي أَراكَ أَصبحْتَ واجِمًا؟ قال: كَلِمةٌ سمِعتُها مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يَزعُمُ ",["أنَّها مُوجِبةٌ",2]," فلمْ أَسألْهُ عنها، قال أبو بَكرٍ: أنا أَعلَمُ ما هيَ، قال: ما هيَ؟ قال: «",["لا إلهَ إلَّا اللهُ",1],"»."],"grade":"حسن","narrator":"أبو بكر الصديق","muhaddith":"رجاله ثقات","takhrij":"أخرجه المروزي في ((مسند أبي بكر الصديق)) (13) واللفظ له، وأبو يعلى (102)، والطبري في ((تهذيب الآثار- الجزء المفقود)) (672)","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"LfM4Ebp6","merged":3,"otherRefs":["إتحاف الخيرة المهرة 1/66 (حسن)","المطالب العالية 3/240 (حسن)"]},{"id":"س-02610","fp":"81b7a0eb119d","stateId":687,"easy":"إذا عبدت الله ولم تشرك ونصرت النبي ﷺ ← فلك الجنة","cause":"فتعبدوه ولا تُشركوا به شيئًا وأما الذي أسألُكم لنفسي فتمنعوني مما تمنعونَ منه أنفسَكم","result":"فما لنا إذا فعلنا ذلك","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-03856","ref":"مجمع الزوائد 6/51","text":["حمَّلني خالي جَدُّ بنُ قيسٍ في السبعينَ راكبًا الذين وفدوا على رسولِ اللهِ صلَّى اللهُ عليه وسلَّم من قِبَلِ الأنصارِ ليلةَ العقبةِ فخرج علينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ومعه عمُّه العباسُ بنُ عبدُ المطلبِ فقال يا عمِّ خذْ على أخوالِك فقال له السبعونَ يا محمدُ سلْ لربِّك ولنفسِك ما شئتَ فقال أما الذي أسألُكم لربي ",["فتعبدوه ولا تُشركوا به شيئًا وأما الذي أسألُكم لنفسي فتمنعوني مما تمنعونَ منه أنفسَكم",1]," قالوا ",["فما لنا إذا فعلنا ذلك",2]," قال الجنةُ"],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني في ((المعجم الصغير)) (1076)، والحاكم (5405)، وأبو نعيم الأصبهاني في ((معرفة الصحابة)) (1719) جميعهم بلفظه.","bab":"إيمان › الأمر بالإيمان بالله تعالى ورسوله وشرائع الدين","dorar":"1O5rprlj"},{"id":"س-06842","fp":"a7297c9d8991","stateId":687,"easy":"إذا آمنت بكتب الله ورسله ← تسجد له يوم القيامة ويُفدى بك كافر","cause":"فآمنَّا بكُتُبِه ورُسُلِه","result":"فيتجلَّى لهم تعالى فيخِرُّونَ له سُجَّدًا، فيُفدَى كلُّ واحدٍ بكافرٍ مِن الكفارِ، فيُدخِلُهم الجنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"حلية الأولياء 6/213","srcLabel":"غريب من حديث صالح ورياح","text":["إذا كان يَومُ القِيامةِ مثَّلَ اللهُ لكلِّ قومٍ آلهتَهم التي كانوا يَعْبدونَها، فيتَّبِعونَها، ويَبْقى الموحِّدونَ. فيقولُ اللهُ: لِمَ لا تَذْهبونَ حيثُ يذهَبُ الناسُ؟ قال: إنَّ لنا ربًّا كنَّا نعبُدُه. قال: هل رأَيتُموه؟ قالوا: لا. قال: فكيفَ عبَدتُم ما لم ترَوْه؟ قالوا: أنزَلَ علينا الكتابَ، وبعَثَ إلينا الرُّسُلَ، ",["فآمنَّا بكُتُبِه ورُسُلِه",1],". قال: فهل تعرِفونَ ربَّكم إذا رأَيتُموه؟ قالوا: إنْ شاء عرَّفَنا نَفْسَه، قال: ",["فيتجلَّى لهم تعالى فيخِرُّونَ له سُجَّدًا، فيُفدَى كلُّ واحدٍ بكافرٍ مِن الكفارِ، فيُدخِلُهم الجنَّةَ",2],"."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"غريب من حديث صالح ورياح","takhrij":"أخرجه أبو نعيم في ((حلية الأولياء)) (6/197)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"vEMDYe2k"},{"id":"س-06478","fp":"4b64af4e2ba4","stateId":688,"easy":"إذا عبدت الله لا تشرك به وأقمت الصلاة وآتيت الزكاة ووصلت الرحم ← تقربك من الجنة وتبعدك من النار","cause":"تَعبُدُ اللهَ لا تُشرِكُ به شيئًا، وتُقيمُ الصَّلاةَ، وتُؤتي الزَّكاةَ، وتَصِلُ الرَّحِمَ","result":"بما يُقَرِّبُني مِنَ الجَنَّةِ، وما يُباعِدُني مِنَ النَّارِ","explicit":true,"star":true,"similar":["س-06469","س-06159","س-02415","س-04378","س-06171","س-06464","س-06498","س-06559","س-06180","س-06597","س-06172","س-06162","س-01878"],"otherNeedIds":[66],"ref":"صحيح مسلم 13","srcLabel":"البخاري","text":["أنَّ أعرابيًّا عَرَضَ لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّم وهو في سَفَرٍ، فأخَذَ بخِطامِ ناقَتِه أو بزِمامِها، ثُمَّ قال: يا رَسولَ اللهِ -أو يا مُحَمَّدُ- أخبِرني ",["بما يُقَرِّبُني مِنَ الجَنَّةِ، وما يُباعِدُني مِنَ النَّارِ",2],"، قال: فكَفَّ النَّبيُّ صلَّى اللهُ عليه وسلَّم، ثُمَّ نَظَرَ في أصحابِه، ثُمَّ قال: لقد وُفِّقَ أو لقد هُديَ، قال: كيفَ قُلتَ؟ قال: فأعادَ، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ",["تَعبُدُ اللهَ لا تُشرِكُ به شيئًا، وتُقيمُ الصَّلاةَ، وتُؤتي الزَّكاةَ، وتَصِلُ الرَّحِمَ",1],"، دَعِ النَّاقةَ."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5983) باختلاف يسير","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"EOxbibAb","merged":6,"otherRefs":["السلسلة الصحيحة 7/1461 (حسن)","فتح الباري لابن حجر 3/311 (حسن)","تخريج صحيح ابن حبان 437 (صحيح)","صحيح مسلم 14 (صحيح)","علل ابن أبي حاتم 2040 (صحيح)"]},{"id":"س-06469","fp":"361e318899d6","stateId":688,"easy":"إذا صليت خمسك وصمت شهرك وأديت زكاة مالك وأطعت ذا أمرك ← تدخل جنة ربك","cause":"وصَلُّوا خَمسَكم، وصُوموا شَهرَكم، وأدُّوا زَكاةَ أموالِكم، وأطيعوا ذا أمرِكم","result":"تَدخُلوا جَنَّةَ رَبِّكم","explicit":true,"repOf":"س-06478","ref":"المستدرك على الصحيحين 1454","text":["قام رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فينا في حَجَّةِ الوَداعِ -وهو على ناقَتِه الجَدعاءِ، قد جَعَل رِجلَيه في غَرْزَيِ الرِّكابِ يَتَطاوَلُ ليُسمِعَ النَّاسَ- فقالَ: ألَا تَسمَعون صَوتي؟ فقالَ رَجُلٌ من طَوائفِ النَّاسِ: فماذا تَعهَدُ إلينا؟ فقالَ: اعبُدوا رَبَّكم، ",["وصَلُّوا خَمسَكم، وصُوموا شَهرَكم، وأدُّوا زَكاةَ أموالِكم، وأطيعوا ذا أمرِكم",1],"؛ ",["تَدخُلوا جَنَّةَ رَبِّكم",2]," قالَ: قُلتُ: يا أبا أُمامةَ، فمِثلُ مَن أنت يَومَئذٍ؟ قالَ: أنا يا ابنَ أخي يَومَئذٍ ابنُ ثَلاثين سَنةً، أُزاحِمُ البَعيَر أُزَحزِحُه قُربًا إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه الطبراني (8/ 161) (7676)، وابن ممك في ((حديث نضر الله)) (45) بلفظه.","bab":"صلاة › فرض الصلاة","dorar":"BICtmobN","merged":9,"otherRefs":["تخريج المسند لشعيب 22260 (صحيح)","صحيح الجامع 109 (صحيح)","تخريج سنن الدارقطني 2759 (صحيح)","السلسلة الصحيحة 3233 (حسن)","تخريج صحيح ابن حبان 4563 (صحيح)","تخريج المسند لشعيب 22161 (صحيح)","تخريج كتاب السنة 1061 (صحيح)","تخريج المسند لشعيب 22258 (صحيح)"]},{"id":"س-06159","fp":"6e57d80e1b55","stateId":688,"easy":"إذا شهدت الشهادتين وأقمت الصلاة وآتيت الزكاة وصمت وأديت الخمس ← تدخل الجنة","cause":"شَهادةُ أن لا إلَهَ إلَّا اللهُ وأنَّ مُحَمَّدًا رَسولُ اللهِ، وإقامُ الصَّلاةِ، وإيتاءُ الزَّكاةِ، وصَومُ رَمَضانَ، وأن تُؤَدُّوا خُمُسًا مِنَ المَغنَمِ","result":"فمُرنا بأمرٍ فصلٍ نُخبِرْ به مَن وراءَنا نَدخُلُ به الجَنَّةَ","explicit":true,"repOf":"س-06478","ref":"صحيح مسلم 17","text":["كُنتُ أُتَرجِمُ بينَ يَدَيِ ابنِ عبَّاسٍ وبينَ النَّاسِ، فأتَتْه امرَأةٌ تَسألُه عن نَبيذِ الجَرِّ، فقال: إنَّ وفدَ عبدِ القَيسِ أتَوا رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: مَنِ الوفدُ؟ أو مَنِ القَومُ؟ قالوا: رَبيعةُ، قال: مَرحَبًا بالقَومِ أو بالوفدِ، غيرَ خَزايا ولا النَّدامى، قال: فقالوا: يا رَسولَ اللهِ، إنَّا نَأتيك مِن شُقَّةٍ بَعيدةٍ، وإنَّ بينَنا وبينَك هذا الحَيَّ مِن كُفَّارِ مُضَرَ، وإنَّا لا نَستَطيعُ أن نَأتيك إلَّا في شَهرِ الحَرامِ، ",["فمُرنا بأمرٍ فصلٍ نُخبِرْ به مَن وراءَنا نَدخُلُ به الجَنَّةَ",2],"، قال: فأمَرَهم بأربَعٍ، ونَهاهم عن أربَعٍ، قال: أمَرَهم بالإيمانِ باللهِ وحدَه، وقال: هل تَدرونَ ما الإيمانُ باللهِ؟ قالوا: اللهُ ورَسولُه أعلَمُ، قال: ",["شَهادةُ أن لا إلَهَ إلَّا اللهُ وأنَّ مُحَمَّدًا رَسولُ اللهِ، وإقامُ الصَّلاةِ، وإيتاءُ الزَّكاةِ، وصَومُ رَمَضانَ، وأن تُؤَدُّوا خُمُسًا مِنَ المَغنَمِ",1],"، ونَهاهم عَنِ الدُّبَّاءِ، والحَنتَمِ، والمُزَفَّتِ. قال شُعبةُ: ورُبَّما قال، النَّقيرِ، قال شُعبةُ: ورُبَّما قال: المُقَيَّرِ. وقال: احفَظوه وأخبِروا به مِن ورائِكُم، وقال أبو بَكرٍ في رِوايَتِه: مَن وراءَكُم، وليسَ في رِوايَتِه: المُقَيَّر."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (53) باختلاف يسير","bab":"زكاة › فرض الزكاة","dorar":"M211BdxP","merged":4,"otherRefs":["صحيح البخاري 53 (صحيح)","صحيح البخاري 6176 (صحيح)","صحيح البخاري 7266 (صحيح)"]},{"id":"س-06553","fp":"e584084314d1","stateId":688,"easy":"إذا التزمت الفرائض لا تزيد ولا تنقص ← فأنت رجل من أهل الجنة","cause":"لا أزيدُ على هذا شيئًا أبَدًا ولا أنقُصُ منه","result":"مَن سَرَّه أن يَنظُرَ إلى رَجُلٍ مِن أهلِ الجَنَّةِ فليَنظُرْ إلى هذا","explicit":true,"otherNeedIds":[66],"ref":"صحيح مسلم 14","srcLabel":"البخاري","text":["أنَّ أعرابيًّا جاءَ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: يا رَسولِ اللهِ، دُلَّني على عَمَلٍ إذا عَمِلتُه دَخَلتُ الجَنَّةَ، قال: تَعبُدُ اللهَ لا تُشرِكُ به شيئًا، وتُقيمُ الصَّلاةَ المَكتوبةَ، وتُؤَدِّي الزَّكاةَ المَفروضةَ، وتَصومُ رَمَضانَ، قال: والذي نَفسي بيَدِه، ",["لا أزيدُ على هذا شيئًا أبَدًا ولا أنقُصُ منه",1],"، فلَمَّا ولَّى قال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ",["مَن سَرَّه أن يَنظُرَ إلى رَجُلٍ مِن أهلِ الجَنَّةِ فليَنظُرْ إلى هذا",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1397) باختلاف يسير","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"hGoydAzj","merged":3,"otherRefs":["إتحاف الخيرة المهرة 1/409 (حسن)","صحيح مسلم 13 (صحيح)"]},{"id":"س-04325","fp":"1f7bc36e5062","stateId":688,"easy":"إذا آمنت بالله ورسوله وأقمت الصلاة وصمت رمضان ← فحق على الله أن يدخلك الجنة","cause":"من آمن بالله ورسوله، وأقام الصلاة، وصام رمضان","result":"فإن حقا على الله أن يدخله الجنة، هاجر في سبيل الله، أو جلس في أرضه التي ولد فيها","explicit":true,"apply":{"k":"time","t":"في رمضان"},"ref":"تخريج المسند لشعيب 8420","srcLabel":"البخاري","text":["تَفَجَّرُ أنهارُ الجنَّةِ، وقال: أفلا نُنَبِّئُ الناسَ بذلك؟ قال: ثمَّ حدَّثَنا به فلَم يشُكَّ -يعني فُلَيْحًا- قال عطاءُ بنُ يَسارٍ.\n\nفذكر الحديث [أي حديث: ",["من آمن بالله ورسوله، وأقام الصلاة، وصام رمضان، ",1],["فإن حقا على الله أن يدخله الجنة، هاجر في سبيل الله، أو جلس في أرضه التي ولد فيها ",2],"\" قالوا: يا رسول الله، أفلا نخبر الناس\nقال: \" إن في الجنة مائة درجة أعدها الله للمجاهدين في سبيله، بين كل درجتين كما بين السماء والأرض، فإذا سألتم الله فسلوه الفردوس، فإنه وسط الجنة، وأعلى الجنة، وفوقه  عرش الرحمن ومنه يفجر، أو تفجر أنهار الجنة \" شك أبو عامر]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (7423) باختلاف يسير","bab":"جنة › صفة الجنة","dorar":"6xoQ0dTi","merged":2,"otherRefs":["صحيح البخاري 2790 (صحيح)"]},{"id":"س-06761","fp":"4143b03dc7c7","stateId":688,"easy":"إذا أديت الفرائض واجتنبت النواهي صادقاً ← تدخل الجنة","cause":"وسأُؤَدِّي هذه الفَرائِضَ وأَجْتَنِبُ ما نَهيْتَني عنه ثُمَّ لا أَزيدُ ولا أَنقُصُ","result":"إن يَصدُقْ ذو العَقيصتَينِ يَدخُلِ الجنَّةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[53],"ref":"الأحاديث المختارة 13 / 46","srcLabel":"متفق عليه","text":["«بَعَثَتْ بَنو سَعْدِ بنِ بَكْرٍ ضِمامَ بنَ ثَعْلَبةَ وافِدًا إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقَدِمَ عليه وأناخَ بَعيرَه على بابِ المَسجِدِ ثُمَّ عَقَلَه». بنَحْوِ: [ثُمَّ دَخَلَ المَسجِدَ ورَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ جالِسٌ في أصْحابِه، وكانَ ضِمامُ رَجُلًا جَلْدًا أَشعَرَ ذا غَديرتَينِ، فأَقبَلَ حتَّى وَقَفَ على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في أصْحابِه، فقالَ: أيُّكم ابنُ عَبْدِ المُطَّلِبِ؟ فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: أنا ابنُ عَبْدِ المُطَّلِبِ، قالَ: مُحمَّدٌ؟ قالَ: نَعمْ، قالَ: ابنَ عَبْدِ المُطَّلِبِ إنِّي سائِلُك ومُغْلِظٌ في المَسْألةِ فلا تَجِدَنَّ في نَفْسِك، قالَ: لا أَجِدُ في نَفْسي فسَلْ عمَّا بَدا لك، قالَ: أَنشُدُك اللهَ إلهَك وإلهَ مَن كانَ قَبْلَك وإلهَ مَن هو كائِنٌ بَعْدَك، آللهُ بَعَثَك إلينا رَسولًا؟ قالَ: اللَّهُمَّ نَعمْ، قالَ: فأَنشُدُك باللهِ إلهِك وإلهِ مَن كانَ قَبْلَك وإلهِ مَن هو كائِنٌ بَعْدَك، آللهُ أمَرَك أن تَأمُرَنا أن نَعبُدَه وَحْدَه لا نُشرِكُ به شَيئًا وأن نَخلَعَ هذه الأنْدادَ الَّتي كانَت آباؤُنا يَعبُدونَ معَه؟ قالَ: اللَّهُمَّ نَعمْ، قالَ: فأَنشُدُك اللهَ إلهَك وإلهَ مَن كانَ قَبْلَك وإلهَ مَن هو كائِنٌ بَعْدَك، آللهُ أمَرَك أن تُصَلِّيَ هذه الصَّلَواتِ الخَمْسَ؟ قالَ: اللَّهُمَّ نَعمْ، قالَ: ثُمَّ جَعَلَ يَذكُرُ فَرائِضَ الإسْلامِ فَريضةً فَريضةً؛ الزَّكاةَ والصِّيامَ والحَجَّ وشَرائِعَ الإسْلامِ كلَّها، يُناشِدُه في الَّتي قَبْلَها، حتَّى إذا فَرَغَ قالَ: فإنِّي أَشهَدُ أنْ لا إلهَ إلَّا اللهُ وأَشهَدُ أنَّ مُحمَّدًا رَسولُ اللهِ، ",["وسأُؤَدِّي هذه الفَرائِضَ وأَجْتَنِبُ ما نَهيْتَني عنه ثُمَّ لا أَزيدُ ولا أَنقُصُ",1],"، قالَ: ثُمَّ انْصَرَفَ راجِعًا إلى بَعيرِه، قالَ: فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ حينَ وَلَّى: ",["إن يَصدُقْ ذو العَقيصتَينِ يَدخُلِ الجنَّةَ",2],"، قالَ: فأتى إلى بَعيرِه فأَطْلَقَ عِقالَه، ثُمَّ خَرَجَ حتَّى قَدِمَ على قَوْمِه فاجْتَمَعوا إليه، فكانَ أوَّلَ ما تَكلَّمَ به أن قالَ: بِئْسَتِ اللَّاتُ والعُزَّى! قالوا: مهْ يا ضِمامُ! اتَّقِ البَرَصَ والجُذامَ! اتَّقِ الجُنونَ، قالَ: وَيْلَكم؛ إنَّهما واللهِ ما يَضُرَّانِ ولا يَنفَعانِ، إنَّ اللهَ عَزَّ وجَلَّ قد بَعَثَ رَسولًا وأَنزَلَ عليه كِتابًا اسْتَنْقَذَكم به مِمَّا كُنْتُم فيه، وإنِّي أَشهَدُ أنْ لا إلهَ إلَّا اللهُ وأَشهَدُ أنَّ مُحمَّدًا عَبْدُه ورَسولُه، قد جِئْتُكم مِن عِنْدِه بما أمَرَكم به ونَهاكم عنه، قالَ: فوَاللهِ ما أَمْسى مِن ذلك اليَوْمِ وفي حاضِرِه رَجُلٌ ولا امْرَأةٌ إلَّا مُسلِمًا! قالَ: يقولُ ابنُ عبَّاسٍ: فما سَمِعْنا بوافِدِ قَوْمٍ كانَ أَفضَلَ مِن ضِمامِ بنِ ثَعْلَبةَ!».]"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"صيام › فضل الصيام","dorar":"hMy4PkSI","merged":12,"otherRefs":["صحيح الترمذي 619 (صحيح)","تخريج المسند لشاكر 4/64 (صحيح)","صحيح النسائي 2090 (صحيح)","التمهيد 16/171 (صحيح)","تخريج صحيح ابن حبان 1724 (صحيح)","تخريج المسند لشاكر 2/362 (صحيح)","إرواء الغليل 2/4 (صحيح)","الصحيح المسند 30 (صحيح)","المحلى 7/17 (صحيح)","الأحاديث المختارة 2443 (صحيح)","المستدرك على الصحيحين 4012 (صحيح)"]},{"id":"س-07220","fp":"eca0ea968ce0","stateId":688,"easy":"إذا صليت المكتوبة وحرّمت الحرام وأحللت الحلال ← تدخل الجنة","cause":"إذا صَلَّيتُ المَكتوبةَ، وحَرَّمتُ الحَرامَ، وأحلَلتُ الحَلالَ","result":"أأدخُلُ الجَنَّةَ؟ فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: نَعَم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح مسلم 15","srcLabel":"متفق عليه","text":["أتى النَّبيَّ صلَّى اللهُ عليه وسلَّم النُّعمانُ بنُ قَوقَلٍ، فقال: يا رَسولَ اللهِ، أرَأيتَ ",["إذا صَلَّيتُ المَكتوبةَ، وحَرَّمتُ الحَرامَ، وأحلَلتُ الحَلالَ",1],"، ",["أأدخُلُ الجَنَّةَ؟ فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: نَعَم",2],". وفي رِوايةٍ: ولَم أزِدْ على ذلك شيئًا."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"علم › حسن السؤال ونصح العالم","dorar":"QkBPsKhy","merged":2,"otherRefs":["صحيح مسلم 15 (صحيح)"]},{"id":"س-03854","fp":"ec8326cf4ade","stateId":688,"easy":"إذا لم تشرك ولم تزنِ ولم تسرق ولم تقتل ← فلك الجنة","cause":"أن لا نُشرِكَ باللَّهِ شيئًا، ولا نَزنيَ، ولا نَسرِقَ، ولا نَقتُلَ النَّفسَ التي حَرَّمَ اللهُ إلَّا بالحَقِّ، ولا نَنتَهِبَ، ولا نَعصيَ","result":"فالجَنَّةُ إن فعَلنا ذلك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح مسلم 1709","srcLabel":"البخاري","text":["إنِّي لَمِنَ النُّقَباءِ الذينَ بايَعوا رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، وقال: بايَعناه على ",["أن لا نُشرِكَ باللَّهِ شيئًا، ولا نَزنيَ، ولا نَسرِقَ، ولا نَقتُلَ النَّفسَ التي حَرَّمَ اللهُ إلَّا بالحَقِّ، ولا نَنتَهِبَ، ولا نَعصيَ",1],"، ",["فالجَنَّةُ إن فعَلنا ذلك",2],"، فإن غَشِينا مِن ذلك شيئًا كان قَضاءُ ذلك إلى اللَّهِ."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3893)، والنسائي (4161)، وأحمد (22678) باختلاف يسير.","bab":"بيعة › البيعة على ماذا تكون","dorar":"AXB97EdI"},{"id":"س-02415","fp":"c92e9f82126e","stateId":688,"easy":"إذا شهدت الشهادتين وأقمت الصلاة وآتيت الزكاة وصمت وحججت ← فهو العمل الذي يدخلك الجنة","cause":"شَهادةُ أنْ لا إلهَ إلَّا اللهُ وأنِّي رسولُ اللهِ، وإقامُ الصَّلاةِ، وإيتاءُ الزَّكاةِ، وحَجُّ البَيتِ، وصَومُ رَمَضانَ","result":"العَمَلُ الذي يُدخِلُ الجَنَّةَ، ويُنَجِّي منَ النارِ","explicit":true,"repOf":"س-06478","otherNeedIds":[66],"ref":"تخريج مشكل الآثار 1478","text":["قُلتُ: يا رسولَ اللهِ، إنِّي أريدُ أنْ أسأَلَكَ عن أمْرٍ، ويَمنَعُني مكانُ هذه الآيةِ: {يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَسْأَلُوا عَنْ أَشْيَاءَ إِنْ تُبْدَ لَكُمْ تَسُؤْكُمْ} [المائدة: 101] قال: ما هو يا مُعاذُ؟، قُلتُ: ",["العَمَلُ الذي يُدخِلُ الجَنَّةَ، ويُنَجِّي منَ النارِ",2],"، قال: قد سَأَلتَ عظيمًا، وإنَّه لَيسيرٌ: ",["شَهادةُ أنْ لا إلهَ إلَّا اللهُ وأنِّي رسولُ اللهِ، وإقامُ الصَّلاةِ، وإيتاءُ الزَّكاةِ، وحَجُّ البَيتِ، وصَومُ رَمَضانَ",1],"."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح بطرقه دون ذكر الآية","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (1478) واللفظ له، والترمذي (2616)، وابن ماجة (3973) مطولًا.","bab":"إسلام › فضل الشهادتين","dorar":"yX7WnPgQ"},{"id":"س-03933","fp":"f33d52659d0a","stateId":688,"easy":"إذا صليت الخمس وصمت رمضان وأخرجت الزكاة واجتنبت الكبائر ← تُفتح لك أبواب الجنة","cause":"ما مِن رجُلٍ يصلِّي الصَّلواتِ الخمسَ ويصومُ رمضانَ ويُخرِجُ الزَّكاةَ ويجتنبُ الكبائرَ السَّبعَ","result":"إلَّا فُتِحت له أبوابُ الجنَّةِ الثَّمانيةُ يومَ القيامةِ حتَّى إنَّها لتَصطفقُ ثمَّ تلا إِنْ تَجْتَنِبُوا كَبَائِرَ مَا تُنْهَوْنَ عَنْهُ نُكَفِّرْ عَنْكُمْ سَيِّئَاتِكُمْ وَنُدْخِلْكُمْ مُدْخَلًا كَرِيمًا","explicit":true,"apply":{"k":"time","t":"في رمضان"},"similar":["س-03932"],"ref":"الترغيب والترهيب 1/185","srcLabel":"الترغيب والترهيب","text":["خطبَنا رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يومًا ، فقالَ والَّذي نَفسي بيدِهِ ثلاثَ مرَّاتٍ ثمَّ أكبَّ ، فأكبَّ كلُّ رجلٍ منَّا يبكي لا نَدري ماذا حلَف ثمَّ رفعَ رأسَهُ وفي وجهِهِ البُشرَى وكانَت أحبَّ إلَينا مِن حُمْرِ النَّعَمِ قالَ ",["ما مِن رجُلٍ يصلِّي الصَّلواتِ الخمسَ ويصومُ رمضانَ ويُخرِجُ الزَّكاةَ ويجتنبُ الكبائرَ السَّبعَ",1]," ",["إلَّا فُتِحت له أبوابُ الجنَّةِ الثَّمانيةُ يومَ القيامةِ حتَّى إنَّها لتَصطفقُ ثمَّ تلا  إِنْ تَجْتَنِبُوا كَبَائِرَ مَا تُنْهَوْنَ عَنْهُ نُكَفِّرْ عَنْكُمْ سَيِّئَاتِكُمْ وَنُدْخِلْكُمْ مُدْخَلًا كَرِيمًا",2]],"grade":"صحيح","narrator":"أبو هريرة وأبو سعيد الخدري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","bab":"تفسير آيات › سورة النساء","dorar":"vqHRUFDV"},{"id":"س-04378","fp":"d643c703c430","stateId":688,"easy":"إذا أقمت الصلاة وآتيت الزكاة وصمت رمضان واجتنبت الكبائر ← فلك الجنة","cause":"مَنْ أقام الصلاةَ ، وآتى الزكاةَ ، وصام رمضانَ ، واجتنَب الكبائرَ","result":"فله الجنةُ","explicit":true,"apply":{"k":"time","t":"في رمضان"},"repOf":"س-06478","ref":"تفسير الطبري 4/1/60","text":[["مَنْ أقام الصلاةَ ، وآتى الزكاةَ ، وصام رمضانَ ، واجتنَب الكبائرَ ، ",1],["فله الجنةُ ",2],"، قيل : وما الكبائرُ ؟ قال : الإشراكُ باللهِ ، وعقوقُ الوالدين ، والفرارُ يومَ الزحْفِ"],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"ثابت","takhrij":"أخرجه النسائي (4009)، وأحمد (23502) باختلاف يسير، والطبري في ((التفسير)) (9224) واللفظ له","bab":"جهاد › التولي والفرار من الزحف","dorar":"jnb1igii"},{"id":"س-06171","fp":"d0fee04294c2","stateId":688,"easy":"إذا عبدت الله لا تشرك به وأقمت الصلاة وآتيت الزكاة وصمت رمضان واجتنبت الكبائر ← فلك الجنة","cause":"من عبدَ اللَّهَ لا يشرِكُ بِهِ شيئًا ، وأقامَ الصَّلاةَ ، وآتَى الزَّكاةَ ، وصامَ رمضانَ ، واجتنبَ الكبائرَ","result":"فلَهُ الجنَّةُ - أو دخلَ الجنَّةَ - فسألَهُ رجلٌ : ما الكبائرُ","explicit":true,"apply":{"k":"time","t":"في رمضان"},"repOf":"س-06478","ref":"عمدة التفسير 1/491","text":[["من عبدَ اللَّهَ لا يشرِكُ بِهِ شيئًا ، وأقامَ الصَّلاةَ ، وآتَى الزَّكاةَ ، وصامَ رمضانَ ، واجتنبَ الكبائرَ ، ",1],["فلَهُ الجنَّةُ - أو دخلَ الجنَّةَ - فسألَهُ رجلٌ : ما الكبائرُ ",2],"؟ فقالَ الشِّركُ باللَّهِ ، وقتلُ نفسٍ مُسْلِمَةٍ ، والفرارُ يومَ الزَّحفِ"],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (4009)، وأحمد (23506) باختلاف يسير","bab":"زكاة › فرض الزكاة","dorar":"bb8LjQU1"},{"id":"س-06464","fp":"e72c50082d23","stateId":688,"easy":"إذا مت تعبد الله لا تشرك به وتقيم الصلاة وتؤتي الزكاة وتصوم رمضان ← تدخل الجنة","cause":"مَن مات يعبُدُ اللهَ لا يُشرِكُ به شيئًا، ويُقيمُ الصَّلاةَ","result":"ويُؤْتي الزَّكاةَ، ويصومُ شهرَ رمضانَ، ويجتنِبُ الكبائرَ، فله الجَنَّةُ، فسأَله رجُلٌ: ما الكبائرُ","explicit":true,"apply":{"k":"time","t":"في رمضان"},"repOf":"س-06478","ref":"تخريج مشكل الآثار 896","text":[["مَن مات يعبُدُ اللهَ لا يُشرِكُ به شيئًا، ويُقيمُ الصَّلاةَ، ",1],["ويُؤْتي الزَّكاةَ، ويصومُ شهرَ رمضانَ، ويجتنِبُ الكبائرَ، فله الجَنَّةُ، فسأَله رجُلٌ: ما الكبائرُ",2],"؟ قال: الإشراكُ باللهِ تعالى، وقَتْلُ النَّفْسِ التي حرَّم اللهُ، وفِرارٌ يومَ الزَّحفِ."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"صحيح","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (896) واللفظ له، والنسائي (4009)، وأحمد (23502) بنحوه.","bab":"صلاة › فرض الصلاة","dorar":"ll6CQ11y"},{"id":"س-06498","fp":"373a62531a73","stateId":688,"easy":"إذا لم تشرك بالله بعد إيمانك وأقمت الصلاة وأديت الزكاة ← وجبت لك الجنة","cause":"مَن لم يشرِكْ باللَّهِ شيئًا بعدَ أن آمنَ وأقامَ الصَّلاةَ المَكْتوبةَ وأدَّى الزَّكاةَ المفروضةَ وصامَ رمضانَ وسمعَ وأطاعَ فماتَ علَى ذلِكَ","result":"وجبت لهُ الجنَّةُ","explicit":true,"repOf":"س-06478","ref":"تخريج كتاب السنة 1047","text":[["مَن لم يشرِكْ باللَّهِ شيئًا بعدَ أن آمنَ وأقامَ الصَّلاةَ المَكْتوبةَ وأدَّى الزَّكاةَ المفروضةَ وصامَ رمضانَ وسمعَ وأطاعَ فماتَ علَى ذلِكَ ",1],["وجبت لهُ الجنَّةُ",2]],"grade":"صحيح","narrator":"أبو مالك الأشعري","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (1047)، والطبراني (3/ 293)، (3443) كلاهما بلفظه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"1k4lKHqh"},{"id":"س-06559","fp":"052bc6b1d677","stateId":688,"easy":"إذا عبدت الله لا تشرك به وأقمت الصلاة وآتيت الزكاة واجتنبت الكبائر ← تدخل الجنة","cause":"ما من عبدٍ يَعْبُدُ اللهَ – تعالى – لا يُشْرِكُ بهِ شيئًا ، ويُقِيمُ الصَّلاةَ ، ويُؤْتِي الزكاةَ ، ويَصُومُ رَمَضَانَ ، ويَجْتَنِبُ الكبائرَ","result":"إلَّا دخلَ الجنةَ","explicit":true,"repOf":"س-06478","ref":"المطالب العالية 3/270","text":[["ما من عبدٍ يَعْبُدُ اللهَ – تعالى – لا يُشْرِكُ بهِ شيئًا ، ويُقِيمُ الصَّلاةَ ، ويُؤْتِي الزكاةَ ، ويَصُومُ رَمَضَانَ ، ويَجْتَنِبُ الكبائرَ",1]," ",["إلَّا دخلَ الجنةَ ",2],"، قيل : وما الكَبائِرُ؟ قال صلَّى اللهُ عليهِ وسلَّمَ : الإِشْرَاكُ باللهِ – تعالى – وقَتْلُ النَّفْسِ"],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"صحيح","takhrij":"أخرجه النسائي (4009)، وأحمد (23502) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"WE2oPYAQ"},{"id":"س-03932","fp":"5296c9b5e08f","stateId":688,"easy":"إذا صليت الخمس وصمت رمضان وأديت الزكاة واجتنبت الكبائر السبع ← تُفتح لك أبواب الجنة الثمانية","cause":"ما من عبدٍ يُصلِّي الصَّلواتِ الخمسِ ، ويصومُ رمضانَ ، ويُؤدِّي الزَّكاةَ ، ويجتنِبُ الكبائرَ السَّبعَ","result":"إلَّا فُتِحت له أبوابُ الجنَّةِ ، حتَّى إنَّها لتصطفِقُ","explicit":true,"apply":{"k":"time","t":"في رمضان"},"repOf":"س-03933","ref":"موافقة الخبر الخبر 1/352","text":["والَّذي نفسي بيدِه . ثمَّ سكت فأكبَّ كلُّ رجلٍ منَّا يبكي حزنًا ليمينِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم ثمَّ قال : ",["ما من عبدٍ يُصلِّي الصَّلواتِ الخمسِ ، ويصومُ رمضانَ ، ويُؤدِّي الزَّكاةَ ، ويجتنِبُ الكبائرَ السَّبعَ",1]," ",["إلَّا فُتِحت له أبوابُ الجنَّةِ ، حتَّى إنَّها لتصطفِقُ ",2],". ثمَّ تلا :  إِنْ تَجْتَنِبُوا كَبَائِرَ مَا تُنْهَوْنَ عَنْهُ نُكَفِّرْ عَنْكُمْ سَيِّئَاتِكُمْ وَنُدْخِلْكُمْ مُدْخَلًا كَرِيمًا  السِّياقُ لابنِ وهبٍ ، وانتهَى سياقُ اللَّيْثِ إلى قولِه ( أبوابُ الجنَّةِ ) وزاد ( ثمَّ قيل له ادخُلِ الجنَّةَ بسلامٍ )"],"grade":"حسن","narrator":"أبو سعيد الخدري وأبو هريرة","muhaddith":"حسن","takhrij":"أخرجه النسائي (2438)، وابن خزيمة (315)، وابن حبان (1748) باختلاف يسير.","bab":"تفسير آيات › سورة النساء","dorar":"nwWoWbH2"},{"id":"س-06179","fp":"b66895d90d04","stateId":688,"easy":"إذا حفظت الصلاة والزكاة والأمانة والفرج والبطن واللسان ← يكفل لك النبي ﷺ الجنة","cause":"الصَّلاةُ ، والزَّكاةُ ، والأمانةُ ، والفَرجُ ، والبطنُ ، واللِّسانُ","result":"أَكْفلُ لَكُمُ الجنَّةَ","explicit":true,"ref":"الترغيب والترهيب 1/190","srcLabel":"الطبراني","text":["عن رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ، أنَّهُ قالَ لمن حولَهُ من أمَّتِهِ : اكفُلوا لي بستٍّ ",["أَكْفلُ لَكُمُ الجنَّةَ",2]," . قالوا وما هيَ يا رسولَ اللَّهِ ؟ قالَ : ",["الصَّلاةُ ، والزَّكاةُ ، والأمانةُ ، والفَرجُ ، والبطنُ ، واللِّسانُ",1]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"لا بأس بإسناده","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (4925) بلفظه.","bab":"زكاة › فرض الزكاة","dorar":"74mSMuLX"},{"id":"س-06180","fp":"6fced497f1c3","stateId":688,"easy":"إذا عبدت الله لا تشرك به وأقمت الصلاة وآتيت الزكاة وسمعت وأطعت ← يدخلك الله الجنة","cause":"من عبدَ اللهَ تبارَك وتعالَى لا يشركُ به شيئًا فأقام الصلاةَ وآتَى الزكاةَ وسمع وأطاع","result":"فإن اللهَ تبارَك وتعالَى يُدخِلُه من أيِّ أبوابِ الجنةِ شاء","explicit":true,"repOf":"س-06478","ref":"مجمع الزوائد 5/219","text":[["من عبدَ اللهَ تبارَك وتعالَى لا يشركُ به شيئًا فأقام الصلاةَ وآتَى الزكاةَ وسمع وأطاع",1]," ",["فإن اللهَ تبارَك وتعالَى يُدخِلُه من أيِّ أبوابِ الجنةِ شاء",2]," ولها ثمانيةُ أبوابٍ ومن عبدَ اللهَ تبارَكَ وتعالَى لا يشركُ به شيئًا وأقام الصلاةَ وآتَى الزكاةَ وسمِعَ وعصَى فإن اللهَ تباركَ وتعالَى من أمرِه بالخيارِ إنْ شاء رحِمه و إن شاء عذَّبه"],"grade":"حسن","narrator":"عبادة بن الصامت","muhaddith":"رجاله ثقات","takhrij":"أخرجه أحمد (22768)، وابن أبي عاصم في ((السنة)) (968)، والبزار (2704) واللفظ لهم.","bab":"زكاة › فرض الزكاة","dorar":"rb6guJaq"},{"id":"س-06597","fp":"e68cb538ecfc","stateId":688,"easy":"إذا أقمت الصلاة وآتيت الزكاة ومت تعبد الله لا تشرك به ← فحق على الله أن يدخلك الجنة","cause":"من أقام الصلاةَ وآتَى الزكاةَ ومات يعبدُ اللهَ لا يشركُ به شيئًا","result":"فإن حقًّا على اللهِ أن يدخلَه الجنةَ هاجر أو قعد في مولدِه","explicit":true,"repOf":"س-06478","ref":"مجمع الزوائد 5/278","text":[["من أقام الصلاةَ وآتَى الزكاةَ ومات يعبدُ اللهَ لا يشركُ به شيئًا ",1],["فإن حقًّا على اللهِ أن يدخلَه الجنةَ هاجر أو قعد في مولدِه",2]," فقال رجلٌ يا رسولَ اللهِ إن حدثت بها الناسَ يطمئنوا عليها فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم إن اللهَ أعدَّ للمجاهدِ في سبيلِه مائةَ درجةٍ بينَ كلِّ درجتينِ كما بينَ السماءِ والأرضِ فلو كان عندي ما أنفقُ به وأقوي المسلمين أو بأيديهم ما ينفقون ما انطلقت سريةٌ إلا كنتُ صاحبَها ولكن ليس بيدِي ولا بأيديهم ولو خرجت ما بقي أحدٌ فيه إلا انطلق معي وذلك يشقُّ عليَّ وعليهم ولوَدِدت أن أغزوَ فأُقتلَ ثم أحيا ثم أغزوَ فأُقتلَ ثم أحيا فأُقتلَ"],"grade":"حسن","narrator":"أبو مالك الأشعري","muhaddith":"فيه سعيد بن يوسف وبقية رجاله ثقات","takhrij":"أخرجه الطبراني (3/ 300)، (3464) بلفظه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"bRTTlhPp"},{"id":"س-06172","fp":"d96ea42bfe4c","stateId":688,"easy":"إذا عبدت الله ولم تشرك وأقمت الصلاة وآتيت الزكاة ← تدخل الجنة","cause":"أنْ يعبدوا اللهَ ولا يشرِكوا به شيئًا وأنْ يقيموا الصَّلاةَ وأنْ يُؤتوا الزَّكاةَ ويصوموا رمضانَ وأنْ يحجُّوا البيتَ وأنْ يُعطوا الخمُسَ من المغانمِ","result":"إذا عمِلناه دخلنا الجنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-06478","ref":"الإيمان لابن منده 81","text":["أنَّ وفدَ عبدَ القيسِ أتَوا النبيَّ صلَّى اللهُ عليه وسلم فقالوا : يا رسولَ اللهِ إنَّا حيٌّ من بني ربيعةَ وإنَّا بيننا وبينك كفَّارُ مُضَرَ وإنَّا لا نَصِلُ إليك إلَّا في شهرِ الحرامِ فمُرنا بأمرٍ ",["إذا عمِلناه دخلنا الجنَّةَ",2]," وندعو إليه من وراءَنا . فأمرَهم بأربعٍ ونهاهم عن أربعٍ ، أمرَهم ",["أنْ يعبدوا اللهَ ولا يشرِكوا به شيئًا وأنْ يقيموا الصَّلاةَ وأنْ يُؤتوا الزَّكاةَ ويصوموا رمضانَ وأنْ يحجُّوا البيتَ وأنْ يُعطوا الخمُسَ من المغانمِ",1]," ونهاهُمْ عن أربعٍ : عن شرابِ الدُّبَّاءِ والحَنتَمِ والنَّقيرِ والمُزَفَّتِ . قالوا : ففيمَ الشرابُ ؟ قال : عليكمْ بالأسقِيَةِ الأدمُ التي يلاثُ على أفواهِها"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح على رسم الجماعة","takhrij":"أخرجه البخاري (87)، ومسلم (17) باختلاف يسير","bab":"زكاة › فرض الزكاة","dorar":"HNrdMcO6","merged":2,"otherRefs":["تخريج المسند لشاكر 5/136 (صحيح)"]},{"id":"س-06162","fp":"1b8feee52812","stateId":688,"easy":"إذا شهدت وأقمت الصلاة وآتيت الزكاة وصمت رمضان وحججت ← تدخل الجنة","cause":"شَهادةُ أن لا إلَهَ إلَّا اللهُ، وإقامُ الصَّلاةِ، وإيتاءُ الزَّكاةِ، وصَومُ رَمَضانَ، وأن تُعطوا مِنَ المَغانِمِ الخُمُسَ","result":"بجُمَلٍ مِنَ الأمرِ إن عَمِلنا به دَخَلنا الجَنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"في رمضان"},"repOf":"س-06478","ref":"صحيح البخاري 4368","text":["قُلتُ لابنِ عَبَّاسٍ رَضيَ اللهُ عنهما: إنَّ لي جَرَّةً يُنتَبَذُ لي نَبيذٌ، فأشرَبُه حُلوًا في جَرٍّ، إن أكثَرتُ منه، فجالَستُ القَومَ فأطَلتُ الجُلوسَ، خَشيتُ أن أفتَضِحَ، فقال: قدِمَ وفدُ عبدِ القَيسِ على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: مَرحَبًا بالقَومِ، غيرَ خَزايا ولا النَّدامى، فقالوا: يا رَسولَ اللهِ، إنَّ بينَنا وبينَكَ المُشرِكينَ مِن مُضَرَ، وإنَّا لا نَصِلُ إليكَ إلَّا في أشْهرِ الحُرُمِ، حَدِّثنا ",["بجُمَلٍ مِنَ الأمرِ إن عَمِلنا به دَخَلنا الجَنَّةَ",2],"، ونَدعو به مَن وراءَنا. قال: آمُرُكُم بأربَعٍ، وأنهاكُم عن أربَعٍ: الإيمانِ باللهِ، هل تَدرونَ ما الإيمانُ باللهِ؟ ",["شَهادةُ أن لا إلَهَ إلَّا اللهُ، وإقامُ الصَّلاةِ، وإيتاءُ الزَّكاةِ، وصَومُ رَمَضانَ، وأن تُعطوا مِنَ المَغانِمِ الخُمُسَ",1],"، وأنهاكُم عن أربَعٍ: ما انتُبِذَ في الدُّبَّاءِ، والنَّقيرِ، والحَنتَمِ، والمُزَفَّتِ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (17) باختلاف يسير","bab":"زكاة › فرض الزكاة","dorar":"iI0LYTBM","merged":3,"otherRefs":["صحيح ابن خزيمة 3/ 331 (صحيح)","صحيح النسائي 5708 (صحيح)"]},{"id":"س-01878","fp":"9473c5422970","stateId":688,"easy":"إذا عبدت الله ولم تشرك وأقمت الصلاة وآتيت الزكاة ووصلت الرحم ← يدخلك الجنة","cause":"تَعبدُ اللهَ ولا تُشركُ به شيئًا، وتُقيمُ الصَّلاةَ المكتوبةَ، وتُؤتي الزَّكاةَ المفروضةَ، وتَصومُ رمضانَ","result":"بعملٍ يُدخِلُني الجنَّةَ ويُباعِدُني مِنَ النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-06478","otherNeedIds":[66],"ref":"مختصر المقاصد 596","text":["الصَّومُ جُنَّةٌ [يعني حديث: بيْنَما نحن مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في غزوةِ تَبوكَ وقد أَصابَنا الحَرُّ، فتفَرَّقَ القومُ حتَّى نَظرتُ، فإذا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ أقرَبَهُم مِنِّي. قالَ: فدَنوتُ منه فقلتُ: يا رسولَ اللهِ، أَنبِئْني ",["بعملٍ يُدخِلُني الجنَّةَ ويُباعِدُني مِنَ النَّارِ",2],". قالَ: «لقد سألتَ عنْ عظيمٍ، وإنَّه ليَسيرٌ على مَنْ يَسَّرَهُ اللهُ عليه؛ ",["تَعبدُ اللهَ ولا تُشركُ به شيئًا، وتُقيمُ الصَّلاةَ المكتوبةَ، وتُؤتي الزَّكاةَ المفروضةَ، وتَصومُ رمضانَ",1],"». قالَ: «وإنْ شئتَ أنبأتُكَ بأبوابِ الجنَّةِ». قلتُ: أجَلْ يا رسولَ اللهِ. قالَ: «الصَّومُ جُنَّةٌ، والصَّدقةُ تُكفِّرُ الخطيئةَ، وقيامُ الرَّجلِ في جوفِ اللَّيلِ يَبتغي وجهَ اللهِ». قالَ: ثُمَّ قَرَأَ هذه الآيةَ: {تَتَجَافَى جُنُوبُهُمْ عَنِ الْمَضَاجِعِ يَدْعُونَ رَبَّهُمْ خَوْفًا وَطَمَعًا وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ} [السجدة: 16] قالَ: «وإنْ شئتَ أنبأتُكَ برأسِ الأمرِ وعمودِهِ وذُروةِ سَنامِهِ» . قالَ: قلتُ: أجَلْ يا رسولَ اللهِ. قالَ: «أمَّا رأسُ الأمرِ فالإسلامُ، وأمَّا عمودُهُ فالصَّلاةُ، وأمَّا ذُروةُ سَنامِهِ فالجهادُ في سبيلِ اللهِ، وإنْ شئتَ أنبأتُكَ بأمْلَكِ ذلك كُلِّهِ». قالَ: فسَكَتَ، فإذا راكبانِ يُوضِعانِ قِبَلَنا، فخَشيتُ أنْ يَشغلاهُ عنْ حاجتي. قالَ: فقلتُ: ما هو يا رسولَ اللهِ؟ قالَ: فأَهْوَى بإصبَعِهِ إلى فيهِ. قالَ: فقلتُ: يا رسولَ اللهِ، وإنَّا لنُؤاخذُ بما نقولُ بألسِنَتِنا؟ قالَ: «ثَكِلتكَ أمُّكَ ابنَ جَبلٍ، هل يَكُبُّ النَّاسَ على مَناخِرِهم في جهنَّمَ إلَّا حصائدُ ألسنَتِهمْ؟».]"],"grade":"صحيح","narrator":"[معاذ بن جبل]","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (5/ 12)، والنسائي (2224 )، وابن ماجة (3973 )","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"snTBq0Xu","merged":5,"otherRefs":["صحيح ابن حبان 214 (صحيح)","صحيح البخاري 5983 (صحيح)","صحيح الترمذي 2616 (صحيح)","تخريج شرح السنة 9 (حسن)"]},{"id":"س-04374","fp":"80485f96a170","stateId":688,"easy":"إذا لقيت الله لا تشرك به وأديت زكاتك طيبة بها نفسك وسمعت وأطعت ← فلك الجنة","cause":"من لقِيَ اللهَ لا يشرك به شيئًا ، وأدَّى زكاةَ مالِه طيِّبةً بها نفسُه محتسبًا ، وسمع وأطاع","result":"فله الجنّةُ – أو دخل الجنَّةَ","explicit":true,"ref":"صحيح الترغيب 1339","srcLabel":"أحمد","text":[["من لقِيَ اللهَ لا يشرك به شيئًا ، وأدَّى زكاةَ مالِه طيِّبةً بها نفسُه محتسبًا ، وسمع وأطاع ؛ ",1],["فله الجنّةُ – أو دخل الجنَّةَ - ",2],". وخمسٌ ليس لهنَّ كفارةٌ : الشركُ بالله ، وقتلُ النَّفسِ بغير حقٍّ ، وبُهتُ مؤمنٍ ، والفرارُ من الزَّحفِ ، ويمينٌ صابرةٌ يقتطع بها مالًا بغير حقٍّ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (8737) باختلاف يسير، والطبراني في ((مسند الشاميين)) (1183) مختصراً","bab":"جهاد › التولي والفرار من الزحف","dorar":"4tcDs32F"},{"id":"ق-0008","fp":"07620347bb82","stateId":689,"easy":"الإيمان والعمل الصالح ← جنات تجري من تحتها الأنهار وأزواج مطهرة وخلود","cause":"الإيمان والعمل الصالح","result":"جنات تجري من تحتها الأنهار وأزواج مطهرة وخلود","explicit":true,"similar":["ق-0224","ق-0251","ق-0645","ق-0804","ق-1212"],"ref":"سورة البقرة: 25","srcLabel":"القرآن الكريم","quran":{"s":2,"from":25,"to":25,"text":"وَبَشِّرِ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ أَنَّ لَهُمْ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ كُلَّمَا رُزِقُوا مِنْهَا مِنْ ثَمَرَةٍ رِزْقًا قَالُوا هَذَا الَّذِي رُزِقْنَا مِنْ قَبْلُ وَأُتُوا بِهِ مُتَشَابِهًا وَلَهُمْ فِيهَا أَزْوَاجٌ مُطَهَّرَةٌ وَهُمْ فِيهَا خَالِدُونَ (25)","hl":[[10,292,1]]}},{"id":"ق-0024","fp":"e736b9ab4154","stateId":689,"easy":"الإيمان والعمل الصالح ← الخلود في الجنة","cause":"الإيمان والعمل الصالح","result":"الخلود في الجنة","explicit":true,"similar":["ق-0253","ق-0402","ق-0581","ق-1113"],"ref":"سورة البقرة: 82","srcLabel":"القرآن الكريم","quran":{"s":2,"from":82,"to":82,"text":"وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ أُولَئِكَ أَصْحَابُ الْجَنَّةِ هُمْ فِيهَا خَالِدُونَ (82)","hl":[[0,98,1]]}},{"id":"ق-0205","fp":"d7c1ee66e82c","stateId":689,"easy":"طاعة الله ورسوله ← جنات تجري من تحتها الأنهار والفوز العظيم","cause":"طاعة الله ورسوله","result":"جنات تجري من تحتها الأنهار والفوز العظيم","explicit":true,"similar":["ق-1237"],"otherNeedIds":[53],"ref":"سورة النساء: 13","srcLabel":"القرآن الكريم","quran":{"s":4,"from":13,"to":13,"text":"تِلْكَ حُدُودُ اللَّهِ وَمَنْ يُطِعِ اللَّهَ وَرَسُولَهُ يُدْخِلْهُ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا وَذَلِكَ الْفَوْزُ الْعَظِيمُ (13)","hl":[[23,160,1]]}},{"id":"ق-0224","fp":"596f2c1e9ed6","stateId":689,"easy":"الإيمان والعمل الصالح ← جنات وأزواج مطهرة وظل ظليل","cause":"الإيمان والعمل الصالح","result":"جنات وأزواج مطهرة وظل ظليل","explicit":true,"repOf":"ق-0008","ref":"سورة النساء: 57","quran":{"s":4,"from":57,"to":57,"text":"وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ سَنُدْخِلُهُمْ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا أَبَدًا لَهُمْ فِيهَا أَزْوَاجٌ مُطَهَّرَةٌ وَنُدْخِلُهُمْ ظِلًّا ظَلِيلًا (57)","hl":[[0,197,1]]}},{"id":"ق-0251","fp":"103ee012dd5a","stateId":689,"easy":"الإيمان والعمل الصالح ← جنات تجري من تحتها الأنهار خالدين فيها أبداً","cause":"الإيمان والعمل الصالح","result":"جنات تجري من تحتها الأنهار خالدين فيها أبداً","explicit":true,"repOf":"ق-0008","ref":"سورة النساء: 122","quran":{"s":4,"from":122,"to":122,"text":"وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ سَنُدْخِلُهُمْ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا أَبَدًا وَعْدَ اللَّهِ حَقًّا وَمَنْ أَصْدَقُ مِنَ اللَّهِ قِيلًا (122)","hl":[[0,188,1]]}},{"id":"ق-0253","fp":"eb6df576ae9c","stateId":689,"easy":"العمل الصالح مع الإيمان (ذكراً أو أنثى) ← دخول الجنة بلا ظلم","cause":"العمل الصالح مع الإيمان (ذكراً أو أنثى)","result":"دخول الجنة بلا ظلم","explicit":true,"repOf":"ق-0024","ref":"سورة النساء: 124","quran":{"s":4,"from":124,"to":124,"text":"وَمَنْ يَعْمَلْ مِنَ الصَّالِحَاتِ مِنْ ذَكَرٍ أَوْ أُنْثَى وَهُوَ مُؤْمِنٌ فَأُولَئِكَ يَدْخُلُونَ الْجَنَّةَ وَلَا يُظْلَمُونَ نَقِيرًا (124)","hl":[[0,137,1]]}},{"id":"ق-0331","fp":"2f0cf7789c1e","stateId":689,"easy":"التأثر بالحق والإيمان به والدعاء بالكتابة مع الشاهدين ← جنات جزاء المحسنين","cause":"التأثر بالحق والإيمان به والدعاء بالكتابة مع الشاهدين","result":"جنات جزاء المحسنين","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"سورة المائدة: 83–85","srcLabel":"القرآن الكريم","quran":{"s":5,"from":83,"to":85,"text":"وَإِذَا سَمِعُوا مَا أُنْزِلَ إِلَى الرَّسُولِ تَرَى أَعْيُنَهُمْ تَفِيضُ مِنَ الدَّمْعِ مِمَّا عَرَفُوا مِنَ الْحَقِّ يَقُولُونَ رَبَّنَا آمَنَّا فَاكْتُبْنَا مَعَ الشَّاهِدِينَ (83) وَمَا لَنَا لَا نُؤْمِنُ بِاللَّهِ وَمَا جَاءَنَا مِنَ الْحَقِّ وَنَطْمَعُ أَنْ يُدْخِلَنَا رَبُّنَا مَعَ الْقَوْمِ الصَّالِحِينَ (84) فَأَثَابَهُمُ اللَّهُ بِمَا قَالُوا جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا وَذَلِكَ جَزَاءُ الْمُحْسِنِينَ (85)","hl":[[0,449,1]]}},{"id":"ق-0376","fp":"825cf883344f","stateId":689,"easy":"التذكّر والعمل الصالح ← دار السلام وولاية الله","cause":"التذكّر والعمل الصالح","result":"دار السلام وولاية الله","explicit":true,"otherNeedIds":[25],"ref":"سورة الأنعام: 127","srcLabel":"القرآن الكريم","quran":{"s":6,"from":127,"to":127,"text":"لَهُمْ دَارُ السَّلَامِ عِنْدَ رَبِّهِمْ وَهُوَ وَلِيُّهُمْ بِمَا كَانُوا يَعْمَلُونَ (127)","hl":[[0,85,1]]}},{"id":"ق-0402","fp":"470b3bbf25d6","stateId":689,"easy":"الإيمان والعمل الصالح ← الخلود في الجنة ونزع الغل من الصدور","cause":"الإيمان والعمل الصالح","result":"الخلود في الجنة ونزع الغل من الصدور","explicit":true,"repOf":"ق-0024","otherNeedIds":[5],"ref":"سورة الأعراف: 42–43","quran":{"s":7,"from":42,"to":43,"text":"وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَا نُكَلِّفُ نَفْسًا إِلَّا وُسْعَهَا أُولَئِكَ أَصْحَابُ الْجَنَّةِ هُمْ فِيهَا خَالِدُونَ (42) وَنَزَعْنَا مَا فِي صُدُورِهِمْ مِنْ غِلٍّ تَجْرِي مِنْ تَحْتِهِمُ الْأَنْهَارُ وَقَالُوا الْحَمْدُ لِلَّهِ الَّذِي هَدَانَا لِهَذَا وَمَا كُنَّا لِنَهْتَدِيَ لَوْلَا أَنْ هَدَانَا اللَّهُ لَقَدْ جَاءَتْ رُسُلُ رَبِّنَا بِالْحَقِّ وَنُودُوا أَنْ تِلْكُمُ الْجَنَّةُ أُورِثْتُمُوهَا بِمَا كُنْتُمْ تَعْمَلُونَ (43)","hl":[[0,451,1]]}},{"id":"ق-0513","fp":"bf417af66509","stateId":689,"easy":"الإيمان ← جنات ومساكن طيبة ورضوان من الله أكبر","cause":"الإيمان","result":"جنات ومساكن طيبة ورضوان من الله أكبر","explicit":true,"otherNeedIds":[68,23],"ref":"سورة التوبة: 72","srcLabel":"القرآن الكريم","quran":{"s":9,"from":72,"to":72,"text":"وَعَدَ اللَّهُ الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا وَمَسَاكِنَ طَيِّبَةً فِي جَنَّاتِ عَدْنٍ وَرِضْوَانٌ مِنَ اللَّهِ أَكْبَرُ ذَلِكَ هُوَ الْفَوْزُ الْعَظِيمُ (72)","hl":[[0,185,1]]}},{"id":"ق-0581","fp":"54467505a106","stateId":689,"easy":"الإيمان والعمل الصالح والإخبات إلى الله ← الخلود في الجنة","cause":"الإيمان والعمل الصالح والإخبات إلى الله","result":"الخلود في الجنة","explicit":true,"repOf":"ق-0024","ref":"سورة هود: 23","quran":{"s":11,"from":23,"to":23,"text":"إِنَّ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَأَخْبَتُوا إِلَى رَبِّهِمْ أُولَئِكَ أَصْحَابُ الْجَنَّةِ هُمْ فِيهَا خَالِدُونَ (23)","hl":[[0,131,1]]}},{"id":"ق-0623","fp":"1c1ee3e59689","stateId":689,"easy":"الاستجابة لله ← الحسنى","cause":"الاستجابة لله","result":"الحسنى","explicit":true,"ref":"سورة الرعد: 18","srcLabel":"القرآن الكريم","quran":{"s":13,"from":18,"to":18,"text":"لِلَّذِينَ اسْتَجَابُوا لِرَبِّهِمُ الْحُسْنَى وَالَّذِينَ لَمْ يَسْتَجِيبُوا لَهُ لَوْ أَنَّ لَهُمْ مَا فِي الْأَرْضِ جَمِيعًا وَمِثْلَهُ مَعَهُ لَافْتَدَوْا بِهِ أُولَئِكَ لَهُمْ سُوءُ الْحِسَابِ وَمَأْوَاهُمْ جَهَنَّمُ وَبِئْسَ الْمِهَادُ (18)","hl":[[0,46,1]]}},{"id":"ق-0629","fp":"e33b47925980","stateId":689,"easy":"الإيمان والعمل الصالح ← طوبى وحسن مآب","cause":"الإيمان والعمل الصالح","result":"طوبى وحسن مآب","explicit":true,"otherNeedIds":[7],"ref":"سورة الرعد: 29","srcLabel":"القرآن الكريم","quran":{"s":13,"from":29,"to":29,"text":"الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ طُوبَى لَهُمْ وَحُسْنُ مَآبٍ (29)","hl":[[0,71,1]]}},{"id":"ق-0645","fp":"1c21cb52f105","stateId":689,"easy":"الإيمان والعمل الصالح ← جنات تجري من تحتها الأنهار تحيتهم فيها سلام","cause":"الإيمان والعمل الصالح","result":"جنات تجري من تحتها الأنهار تحيتهم فيها سلام","explicit":true,"repOf":"ق-0008","ref":"سورة إبراهيم: 23","quran":{"s":14,"from":23,"to":23,"text":"وَأُدْخِلَ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا بِإِذْنِ رَبِّهِمْ تَحِيَّتُهُمْ فِيهَا سَلَامٌ (23)","hl":[[0,164,1]]}},{"id":"ق-0804","fp":"1a1a926890b5","stateId":689,"easy":"الإيمان والعمل الصالح ← جنات تجري من تحتها الأنهار","cause":"الإيمان والعمل الصالح","result":"جنات تجري من تحتها الأنهار","explicit":true,"repOf":"ق-0008","ref":"سورة الحج: 14","quran":{"s":22,"from":14,"to":14,"text":"إِنَّ اللَّهَ يُدْخِلُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ إِنَّ اللَّهَ يَفْعَلُ مَا يُرِيدُ (14)","hl":[[0,110,1]]}},{"id":"ق-0807","fp":"97d78cd50880","stateId":689,"easy":"الإيمان والعمل الصالح ← جنات وأساور من ذهب ولؤلؤ وحرير والهداية إلى الطيب من القول","cause":"الإيمان والعمل الصالح","result":"جنات وأساور من ذهب ولؤلؤ وحرير والهداية إلى الطيب من القول","explicit":true,"ref":"سورة الحج: 23–24","srcLabel":"القرآن الكريم","quran":{"s":22,"from":23,"to":24,"text":"إِنَّ اللَّهَ يُدْخِلُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ يُحَلَّوْنَ فِيهَا مِنْ أَسَاوِرَ مِنْ ذَهَبٍ وَلُؤْلُؤًا وَلِبَاسُهُمْ فِيهَا حَرِيرٌ (23) وَهُدُوا إِلَى الطَّيِّبِ مِنَ الْقَوْلِ وَهُدُوا إِلَى صِرَاطِ الْحَمِيدِ (24)","hl":[[0,277,1]]}},{"id":"ق-0826","fp":"cc2d4d009df2","stateId":689,"easy":"الإيمان والعمل الصالح ← جنات النعيم","cause":"الإيمان والعمل الصالح","result":"جنات النعيم","explicit":true,"similar":["ق-0971","ق-0979","ق-1151","ق-1427"],"ref":"سورة الحج: 56","srcLabel":"القرآن الكريم","quran":{"s":22,"from":56,"to":56,"text":"الْمُلْكُ يَوْمَئِذٍ لِلَّهِ يَحْكُمُ بَيْنَهُمْ فَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فِي جَنَّاتِ النَّعِيمِ (56)","hl":[[49,117,1]]}},{"id":"ق-0954","fp":"bcaeccc9d203","stateId":689,"easy":"الإيمان والعمل الصالح ← في روضة يُحبرون","cause":"الإيمان والعمل الصالح","result":"في روضة يُحبرون","explicit":true,"ref":"سورة الروم: 15","srcLabel":"القرآن الكريم","quran":{"s":30,"from":15,"to":15,"text":"فَأَمَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَهُمْ فِي رَوْضَةٍ يُحْبَرُونَ (15)","hl":[[0,83,1]]}},{"id":"ق-0971","fp":"cf9944ba1076","stateId":689,"easy":"الإيمان والعمل الصالح ← جنات النعيم","cause":"الإيمان والعمل الصالح","result":"جنات النعيم","explicit":true,"repOf":"ق-0826","ref":"سورة لقمان: 8","quran":{"s":31,"from":8,"to":8,"text":"إِنَّ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ جَنَّاتُ النَّعِيمِ (8)","hl":[[0,75,1]]}},{"id":"ق-0979","fp":"61a0122a69f6","stateId":689,"easy":"الإيمان والعمل الصالح ← جنات المأوى نُزلاً","cause":"الإيمان والعمل الصالح","result":"جنات المأوى نُزلاً","explicit":true,"repOf":"ق-0826","ref":"سورة السجدة: 19","quran":{"s":32,"from":19,"to":19,"text":"أَمَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَلَهُمْ جَنَّاتُ الْمَأْوَى نُزُلًا بِمَا كَانُوا يَعْمَلُونَ (19)","hl":[[0,112,1]]}},{"id":"ق-1036","fp":"85cb39dc83e3","stateId":689,"easy":"نصرة الرسل والصدع بالحق والإيمان ← الجنة والمغفرة والإكرام","cause":"نصرة الرسل والصدع بالحق والإيمان","result":"الجنة والمغفرة والإكرام","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[11],"ref":"سورة يس: 20–27","srcLabel":"القرآن الكريم","quran":{"s":36,"from":20,"to":27,"text":"وَجَاءَ مِنْ أَقْصَى الْمَدِينَةِ رَجُلٌ يَسْعَى قَالَ يَا قَوْمِ اتَّبِعُوا الْمُرْسَلِينَ (20) اتَّبِعُوا مَنْ لَا يَسْأَلُكُمْ أَجْرًا وَهُمْ مُهْتَدُونَ (21) وَمَا لِيَ لَا أَعْبُدُ الَّذِي فَطَرَنِي وَإِلَيْهِ تُرْجَعُونَ (22) أَأَتَّخِذُ مِنْ دُونِهِ آلِهَةً إِنْ يُرِدْنِ الرَّحْمَنُ بِضُرٍّ لَا تُغْنِ عَنِّي شَفَاعَتُهُمْ شَيْئًا وَلَا يُنْقِذُونِ (23) إِنِّي إِذًا لَفِي ضَلَالٍ مُبِينٍ (24) إِنِّي آمَنْتُ بِرَبِّكُمْ فَاسْمَعُونِ (25) قِيلَ ادْخُلِ الْجَنَّةَ قَالَ يَا لَيْتَ قَوْمِي يَعْلَمُونَ (26) بِمَا غَفَرَ لِي رَبِّي وَجَعَلَنِي مِنَ الْمُكْرَمِينَ (27)","hl":[[0,569,1]]}},{"id":"ق-1042","fp":"f238bb04f806","stateId":689,"easy":"الإخلاص لله ← رزق معلوم وإكرام في جنات النعيم","cause":"الإخلاص لله","result":"رزق معلوم وإكرام في جنات النعيم","explicit":true,"ref":"سورة الصافات: 39–43","srcLabel":"القرآن الكريم","quran":{"s":37,"from":39,"to":43,"text":"وَمَا تُجْزَوْنَ إِلَّا مَا كُنْتُمْ تَعْمَلُونَ (39) إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ (40) أُولَئِكَ لَهُمْ رِزْقٌ مَعْلُومٌ (41) فَوَاكِهُ وَهُمْ مُكْرَمُونَ (42) فِي جَنَّاتِ النَّعِيمِ (43)","hl":[[0,193,1]]}},{"id":"ق-1113","fp":"9aca9cb6916e","stateId":689,"easy":"العمل الصالح مع الإيمان (ذكراً أو أنثى) ← الجنة يرزقون فيها بغير حساب","cause":"العمل الصالح مع الإيمان (ذكراً أو أنثى)","result":"الجنة يرزقون فيها بغير حساب","explicit":true,"repOf":"ق-0024","ref":"سورة غافر: 40","quran":{"s":40,"from":40,"to":40,"text":"مَنْ عَمِلَ سَيِّئَةً فَلَا يُجْزَى إِلَّا مِثْلَهَا وَمَنْ عَمِلَ صَالِحًا مِنْ ذَكَرٍ أَوْ أُنْثَى وَهُوَ مُؤْمِنٌ فَأُولَئِكَ يَدْخُلُونَ الْجَنَّةَ يُرْزَقُونَ فِيهَا بِغَيْرِ حِسَابٍ (40)","hl":[[53,187,1]]}},{"id":"ق-1151","fp":"c89ccbcd7001","stateId":689,"easy":"الإيمان والعمل الصالح ← روضات الجنات ولهم ما يشاءون عند ربهم","cause":"الإيمان والعمل الصالح","result":"روضات الجنات ولهم ما يشاءون عند ربهم","explicit":true,"repOf":"ق-0826","ref":"سورة الشورى: 22","quran":{"s":42,"from":22,"to":22,"text":"تَرَى الظَّالِمِينَ مُشْفِقِينَ مِمَّا كَسَبُوا وَهُوَ وَاقِعٌ بِهِمْ وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فِي رَوْضَاتِ الْجَنَّاتِ لَهُمْ مَا يَشَاءُونَ عِنْدَ رَبِّهِمْ ذَلِكَ هُوَ الْفَضْلُ الْكَبِيرُ (22)","hl":[[70,212,1]]}},{"id":"ق-1212","fp":"c72ee050f969","stateId":689,"easy":"الإيمان والعمل الصالح ← جنات تجري من تحتها الأنهار","cause":"الإيمان والعمل الصالح","result":"جنات تجري من تحتها الأنهار","explicit":true,"repOf":"ق-0008","ref":"سورة محمد: 12","quran":{"s":47,"from":12,"to":12,"text":"إِنَّ اللَّهَ يُدْخِلُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ وَالَّذِينَ كَفَرُوا يَتَمَتَّعُونَ وَيَأْكُلُونَ كَمَا تَأْكُلُ الْأَنْعَامُ وَالنَّارُ مَثْوًى لَهُمْ (12)","hl":[[0,110,1]]}},{"id":"ق-1237","fp":"2208ea352cb1","stateId":689,"easy":"طاعة الله ورسوله ← جنات تجري من تحتها الأنهار","cause":"طاعة الله ورسوله","result":"جنات تجري من تحتها الأنهار","explicit":true,"repOf":"ق-0205","ref":"سورة الفتح: 17","quran":{"s":48,"from":17,"to":17,"text":"لَيْسَ عَلَى الْأَعْمَى حَرَجٌ وَلَا عَلَى الْأَعْرَجِ حَرَجٌ وَلَا عَلَى الْمَرِيضِ حَرَجٌ وَمَنْ يُطِعِ اللَّهَ وَرَسُولَهُ يُدْخِلْهُ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ وَمَنْ يَتَوَلَّ يُعَذِّبْهُ عَذَابًا أَلِيمًا (17)","hl":[[92,182,1]]}},{"id":"ق-1290","fp":"a9d9c5258006","stateId":689,"easy":"العمل الصالح (أصحاب اليمين) ← سدر مخضود وطلح منضود وظل ممدود","cause":"العمل الصالح (أصحاب اليمين)","result":"سدر مخضود وطلح منضود وظل ممدود","explicit":true,"ref":"سورة الواقعة: 27–28","srcLabel":"القرآن الكريم","quran":{"s":56,"from":27,"to":28,"text":"وَأَصْحَابُ الْيَمِينِ مَا أَصْحَابُ الْيَمِينِ (27) فِي سِدْرٍ مَخْضُودٍ (28)","hl":[[0,73,1]]}},{"id":"ق-1427","fp":"d5bd5039b345","stateId":689,"easy":"الإيمان والعمل الصالح ← جنات والفوز الكبير","cause":"الإيمان والعمل الصالح","result":"جنات والفوز الكبير","explicit":true,"repOf":"ق-0826","otherNeedIds":[53],"ref":"سورة البروج: 11","quran":{"s":85,"from":11,"to":11,"text":"إِنَّ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ جَنَّاتٌ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ ذَلِكَ الْفَوْزُ الْكَبِيرُ (11)","hl":[[0,128,1]]}},{"id":"س-03947","fp":"054250c09f7b","stateId":689,"easy":"إذا كنت من عباد الله الصالحين ← أعد الله لك ما لا عين رأت ولا أذن سمعت","cause":"لعباديَ الصالحينَ","result":"أَعددتُ لعباديَ الصالحينَ ما لا عينُ رأتْ ، ولا أُذنٌ سمعتْ ، ولا خطرَ على قلبِ بشرٍ","explicit":true,"star":true,"otherNeedIds":[45],"ref":"شرح السنة 7/537","srcLabel":"متفق عليه","text":["قال رسولُ اللهِ صلى الله عليه وسلم : يقولُ اللهَ عز وجلَ : ",["أَعددتُ لعباديَ الصالحينَ ما لا عينُ رأتْ ، ولا أُذنٌ سمعتْ ، ولا خطرَ على قلبِ بشرٍ",2]," ، وأقرؤوا إن شئتُم { فَلَا تَعْلَمُ نَفْسٌ مَا أُخْفِيَ لهُمْ مِنْ قُرّةِ أَعْيُنٍ جَزَاءً بِمَا كَانُواْ يَعْمَلُونَ } وإنّ في الجنةِ لشجرةً يسيرُ الراكبُ في ظلهّا مائةَ عامٍ لا يقطعُها ، واقرؤوا إن شئتُم : { وَِظِلٍّ مَمْدُودٍ } ولموضعُ سوطٍ في الجنةِ خيرٌ من الدنيا وما عليْها ، واقرؤوا إن شئتُم { فَمَنْ زُحْزِحَ عَنِ النّارِ وَأُدْخِلَ الجَنَّةَ فَقَدْ فَازَ وَمَا الحَيَاةُ الدُّنْيَا إِلَّا مَتَاعُ الغُرُورِ }"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3197) باختلاف يسير، وأخرجه البخاري (3244)، ومسلم (2824) مختصراً","bab":"تفسير آيات › سورة الواقعة","dorar":"cQyMlOln"},{"id":"ق-1431","fp":"5093fa7775c3","stateId":689,"easy":"السعي الصالح ← نعومة الوجه والرضا في جنة عالية","cause":"السعي الصالح","result":"نعومة الوجه والرضا في جنة عالية","explicit":true,"ref":"سورة الغاشية: 8–10","srcLabel":"القرآن الكريم","quran":{"s":88,"from":8,"to":10,"text":"وُجُوهٌ يَوْمَئِذٍ نَاعِمَةٌ (8) لِسَعْيِهَا رَاضِيَةٌ (9) فِي جَنَّةٍ عَالِيَةٍ (10)","hl":[[0,80,1]]}},{"id":"س-00698","fp":"0e42fa0f576c","stateId":690,"easy":"إذا قلت سيد الاستغفار ليلاً موقناً فمت قبل أن تصبح ← فأنت من أهل الجنة","cause":"ومَنْ قالها مِنَ الليلِ وهو موقنُ بها ، فماتَ قبلَ أنْ يُصْبِحَ","result":"فهو مِنْ أهلِ الجنةِ","explicit":true,"star":true,"similar":["س-07104","س-03444"],"ref":"صحيح الجامع 3674","srcLabel":"البخاري","text":["سيدُ الاستغفارِ أنْ تقولَ : اللَّهمَّ أنتَ ربِي ، لَا إلهَ إلَّا أنتَ ، خلَقْتَني وأَنَا عبدُكَ ، وأنا علَى عَهْدِكَ وَوَعْدِكَ ما استطعتُ ، أعوذُ بِكُ مِنْ شَرِّ ما صنعْتُ ، أبوءُ لكَ بنعمتِكَ عَلَيَّ ، وأبوءُ لَكَ بذنبي ، فاغفرْ لِي ، فَإِنَّه لَا يغفرُ الذنوبَ إلَّا أَنْتَ . مَنْ قالها مِنَ النهارِ موقِنًا بها ، فماتَ مِنْ يومِهِ قبلَ أنْ يُمْسِيَ فهو مِنْ أهلِ الجنةِ ، ",["ومَنْ قالها مِنَ الليلِ وهو موقنُ بها ، فماتَ قبلَ أنْ يُصْبِحَ ، ",1],["فهو مِنْ أهلِ الجنةِ",2]],"grade":"صحيح","narrator":"شداد بن أوس","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6306) باختلاف يسير","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"0et7Q7dK"},{"id":"س-07104","fp":"0159af7a6958","stateId":690,"easy":"إذا قلت سيد الاستغفار «اللهم أنت ربي لا إله إلا أنت خلقتني...» مساءً فمت ← وجبت لك الجنة","cause":"اللَّهمَّ أنتَ ربِّي ، لا إلهَ إلَّا أنتَ ، خلقْتَني ، وأنا عبدُكَ ، وأنا على عهْدِكَ ووعدِكَ ما استطعْتُ ، أعوذُ بِكَ مِنْ شرِّ ما صنَعْتُ ، وأبوءُ لَكَ بنعمتِكَ علَيَّ ، وأعْتَرِفُ بذنوبي ، فاغفرْ لِي ذنوبي ، إِنَّه لَا يغفِرُ الذنوبَ إلَّا أنتَ","result":"لَا يقولُها أحدٌ حينَ يُمسي ، فيأتي عليه قدَرٌ قبلَ أنْ يُصْبِحَ إلَّا وجبَتْ لَهُ الجنةُ","explicit":true,"apply":{"k":"say","t":"«اللهم أنت ربي لا إله إلا أنت خلقتني...» · الوقت: في المساء"},"repOf":"س-00698","ref":"صحيح الجامع 2612","text":["أَلَا أدُلُّكَ على سيدِ الاستغفارِ ؟",[" اللَّهمَّ أنتَ ربِّي ، لا إلهَ إلَّا أنتَ ، خلقْتَني ، وأنا عبدُكَ ، وأنا على عهْدِكَ ووعدِكَ ما استطعْتُ ، أعوذُ بِكَ مِنْ شرِّ ما صنَعْتُ ، وأبوءُ لَكَ بنعمتِكَ علَيَّ ، وأعْتَرِفُ بذنوبي ، فاغفرْ لِي ذنوبي ، إِنَّه لَا يغفِرُ الذنوبَ إلَّا أنتَ",1]," ، ",["لَا يقولُها أحدٌ حينَ يُمسي ، فيأتي عليه قدَرٌ قبلَ أنْ يُصْبِحَ إلَّا وجبَتْ لَهُ الجنةُ",2]," ، ولَا يقولُها حينَ يصبِحُ ، فيأتي عليه قدَرٌ قبلَ أنْ يُمْسِيَ إلَّا وجبَتْ له الجنةُ"],"grade":"صحيح","narrator":"شداد بن أوس","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6323) باختلاف يسير","bab":"علم › تعليم الناس وفضل ذلك","dorar":"7C02mzUT"},{"id":"س-07105","fp":"d06e9c4adba4","stateId":690,"easy":"إذا قلته صباحاً فمت قبل أن تمسي ← وجبت لك الجنة","cause":"ولَا يقولُها حينَ يصبِحُ ، فيأتي عليه قدَرٌ قبلَ أنْ يُمْسِيَ","result":"إلَّا وجبَتْ له الجنةُ","explicit":true,"apply":{"k":"time","t":"في الصباح"},"ref":"صحيح الجامع 2612","srcLabel":"البخاري","text":["أَلَا أدُلُّكَ على سيدِ الاستغفارِ ؟ اللَّهمَّ أنتَ ربِّي ، لا إلهَ إلَّا أنتَ ، خلقْتَني ، وأنا عبدُكَ ، وأنا على عهْدِكَ ووعدِكَ ما استطعْتُ ، أعوذُ بِكَ مِنْ شرِّ ما صنَعْتُ ، وأبوءُ لَكَ بنعمتِكَ علَيَّ ، وأعْتَرِفُ بذنوبي ، فاغفرْ لِي ذنوبي ، إِنَّه لَا يغفِرُ الذنوبَ إلَّا أنتَ ، لَا يقولُها أحدٌ حينَ يُمسي ، فيأتي عليه قدَرٌ قبلَ أنْ يُصْبِحَ إلَّا وجبَتْ لَهُ الجنةُ ، ",["ولَا يقولُها حينَ يصبِحُ ، فيأتي عليه قدَرٌ قبلَ أنْ يُمْسِيَ",1]," ",["إلَّا وجبَتْ له الجنةُ",2]],"grade":"صحيح","narrator":"شداد بن أوس","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6323) باختلاف يسير","bab":"علم › تعليم الناس وفضل ذلك","dorar":"7C02mzUT"},{"id":"س-03444","fp":"d7c1ed5a1314","stateId":690,"easy":"إذا قلت سيد الاستغفار صباحاً أو مساءً فمت من يومك أو ليلتك ← تدخل الجنة","cause":"مَن قال حينَ يُصبِحُ وحين يُمسي","result":"فماتَ مِن يَومِه أو لَيلَتِه، دخَلَ الجنَّةَ","explicit":true,"apply":{"k":"time","t":"صباحاً ومساءً"},"repOf":"س-00698","otherNeedIds":[62],"ref":"الفتوحات الربانية 3/78","text":[["مَن قال حينَ يُصبِحُ وحين يُمسي",1],"... فذكَرَ مِثلَه، إلَّا أنَّه قال: فاغفِرْ لي ذُنوبي جميعًا.\nوقال في آخِرِه: ",["فماتَ مِن يَومِه أو لَيلَتِه، دخَلَ الجنَّةَ",2],"."],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"حسن صحيح","takhrij":"أخرجه أبو داود (5070)، والنسائي في ((السنن الكبرى)) (10417)، وابن ماجه (3872)، وأحمد (23013) بنحوه مطولاً","bab":"استغفار › فضل الاستغفار","dorar":"0Ja2ZKSh"},{"id":"س-00988","fp":"c34e7ad7ee99","stateId":691,"easy":"إذا حمدت الله في السراء والضراء ← تكون أول من يُدعى إلى الجنة","cause":"الَّذين يَحمَدونَ اللهَ في السَّرَّاءِ والضَّرَّاءِ","result":"أوَّلُ مَنْ يُدْعى إلى الجنَّةِ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 1875","srcLabel":"مسلم","text":[["أوَّلُ مَنْ يُدْعى إلى الجنَّةِ",2]," ",["الَّذين يَحمَدونَ اللهَ في السَّرَّاءِ والضَّرَّاءِ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه الطبراني في ((الدعاء)) (1768)، والبيهقي في ((الدعوات الكبير)) (135) واللفظ لهم","bab":"أدعية وأذكار › فضل الذكر","dorar":"upk1N4K3","merged":3,"otherRefs":["الأمالي المطلقة 24 (حسن)","الجامع الصغير 2820 (صحيح)"]},{"id":"س-02613","fp":"3f383ff68e2c","stateId":691,"easy":"إذا رضيت بالله رباً وبالإسلام ديناً وبمحمد رسولاً ← تدخل الجنة","cause":"مَن رضِي باللهِ ربًّا، وبالإسلامِ دِينًا، وبمحمَّدٍ رسولًا","result":"ثلاثةٌ مَن قالهُنَّ: دخَل الجَنَّةَ","explicit":true,"star":true,"similar":["س-02894","س-03212"],"ref":"تخريج المسند لشعيب 11102","srcLabel":"مسلم","text":["أخَذ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بيَدي فقال: \"يا أبا سعيدٍ، ",["ثلاثةٌ مَن قالهُنَّ: دخَل الجَنَّةَ",2],"\"، قُلتُ: ما هُنَّ يا رسولَ اللهِ؟ قال: \"",["مَن رضِي باللهِ ربًّا، وبالإسلامِ دِينًا، وبمحمَّدٍ رسولًا",1],"\"، ثُم قال: \"يا أبا سعيدٍ، والرابعةُ لها منَ الفضْلِ كما بيْنَ السَّماءِ إلى الأرضِ، وهي: الجِهادُ في سبيلِ اللهِ\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1884) باختلاف يسير","bab":"إيمان › الأمر بالإيمان بالله تعالى ورسوله وشرائع الدين","dorar":"oGO1vDwH"},{"id":"س-02894","fp":"fd53db695dc9","stateId":691,"easy":"إذا رضيت بالله رباً وبالإسلام ديناً وبمحمد رسولاً ← وجبت لك الجنة","cause":"مَنْ رَضيَ باللهِ ربًّا، وبالإسلامِ دينًا، وبمُحمَّدٍ رسولًا","result":"وجَبَتْ له الجنَّةُ","explicit":true,"repOf":"س-02613","ref":"المستدرك على الصحيحين 2496","text":[["مَنْ رَضيَ باللهِ ربًّا، وبالإسلامِ دينًا، وبمُحمَّدٍ رسولًا؛ ",1],["وجَبَتْ له الجنَّةُ",2],". قالَ أبو سعيدٍ: فحَمِدتُ اللهَ، وكبَّرتُ، وسُرِرتُ به. فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: وأُخْرى يَرْفَعُ اللهُ بها أَهلَها في الجنَّةِ مائةَ درجةٍ، ما بيْنَ كُلِّ درجتينِ كما بيْنَ السَّماءِ والأرضِ، أوْ أَبعدَ ما بيْنَ السَّماءِ والأرضِ، قالَ: قلتُ: وما ذاكَ يا رسولَ اللهِ؟ قالَ: الجهادُ في سبيلِ اللهِ، الجهادُ في سبيلِ اللهِ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح الإسناد","takhrij":"أخرجه مسلم (1884)، والنسائي (3131)، وأحمد (11102) جميعا بنحوه.","bab":"إيمان › الوعد","dorar":"fuapX2jC"},{"id":"س-03212","fp":"cb7cde525fbc","stateId":691,"easy":"إذا رضيت بالله رباً وبالإسلام ديناً وبمحمد نبياً ← وجبت لك الجنة","cause":"من رضيَ باللَّهِ ربًّا ، وبالإسلامِ دينًا ، وبمحمَّدٍ نبيًّا","result":"وجبت لَهُ الجنَّةُ قالَ : فعجبَ لَها أبو سعيدٍ","explicit":true,"repOf":"س-02613","ref":"صحيح النسائي 3131","text":["يا أبا سعيدٍ ، ",["من رضيَ باللَّهِ ربًّا ، وبالإسلامِ دينًا ، وبمحمَّدٍ نبيًّا ، ",1],["وجبت لَهُ الجنَّةُ قالَ : فعجبَ لَها أبو سعيدٍ ",2],"، قالَ : أعدْها عليَّ يا رسولَ اللهِ ، ففعلَ ، ثمَّ قالَ رسولُ اللهِ صلى الله عليه وسلم : وأخرى يرفعُ بِها العبدُ مائةَ درجةٍ في الجنَّةِ ، ما بينَ كلِّ درجتينِ كما بينَ السَّماءِ والأرضِ قالَ : وما هيَ يا رسولَ اللهِ ؟ قالَ : الجِهادُ في سبيلِ اللهِ ، الجِهادُ في سبيلِ اللَّه."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه النسائي (3131) واللفظ له، وأخرجه مسلم (1884) باختلاف يسير","bab":"إيمان › فضل الإيمان","dorar":"Y21zai6t"},{"id":"س-01043","fp":"ae84308df095","stateId":691,"easy":"إذا سبّحت وحمدت وكبّرت عشراً دبر كل صلاة وعند النوم ← فهما خصلتان لا يحافظ عليهما عبد إلا دخل الجنة","cause":"يُسبِّحُ اللهَ أحدُكم في دبُرِ كلِّ صلاةٍ عشْرًا ويحمَدُه عشْرًا ويُكبِّرُه عشْرًا فتلك خمسون ومئةٌ باللِّسانِ وألفٌ وخمسُمئةٍ في الميزانِ وإذا أوى إلى فراشِه يُسبِّحُ ثلاثًا وثلاثينَ ويحمَدُ ثلاثًا وثلاثينَ ويُكبِّرُ أربعًا وثلاثينَ فتلك مئةٌ باللِّسانِ وألفٌ في الميزانِ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فأيُّكم يعمَلُ في يومٍ وليلةٍ ألفينِ وخمسَمئةِ","result":"خَصلتانِ لا يُحصيهما عبدٌ إلَّا دخَل الجنَّةَ وهما يسيرٌ ومَن يعمَلُ بهما قليلٌ","explicit":true,"star":true,"apply":{"k":"time","t":"عند النوم، دبر كل صلاة"},"similar":["س-06411"],"ref":"تخريج صحيح ابن حبان 2018","srcLabel":"أبو داود","text":[["خَصلتانِ لا يُحصيهما عبدٌ إلَّا دخَل الجنَّةَ وهما يسيرٌ ومَن يعمَلُ بهما قليلٌ",2],"،",[" يُسبِّحُ اللهَ أحدُكم في دبُرِ كلِّ صلاةٍ عشْرًا ويحمَدُه عشْرًا ويُكبِّرُه عشْرًا فتلك خمسون ومئةٌ باللِّسانِ وألفٌ وخمسُمئةٍ في الميزانِ وإذا أوى إلى فراشِه يُسبِّحُ ثلاثًا وثلاثينَ ويحمَدُ ثلاثًا وثلاثينَ ويُكبِّرُ أربعًا وثلاثينَ فتلك مئةٌ باللِّسانِ وألفٌ في الميزانِ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ( فأيُّكم يعمَلُ في يومٍ وليلةٍ ألفينِ وخمسَمئةِ",1]," سيِّئةٍ ؟ ) قال عبدُ اللهِ بنُ عمرٍو: ورأَيْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يعقِدُهنَّ بيدِه قال: فقيل: يا رسولَ اللهِ وكيف لا يُحصيها ؟ قال: ( يأتي أحدَكم الشَّيطانُ وهو في صلاتِه فيقولُ: اذكُرْ كذا اذكُرْ كذا ويأتيه عندَ منامِه فيُنوِّمُه قال حمَّادُ بنُ زيدٍ: كان أيُّوبُ حدَّثنا عن عطاءِ بنِ السَّائبِ بهذا الحديثِ فلمَّا قدِم عطاءٌ البَصرةَ قال لنا أيُّوبُ: قد قدِم صاحبُ حديثِ التَّسبيحِ فاذهَبوا فاسمَعوه منه"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (5065)، والترمذي (3410)، والنسائي (1348) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"TDSB2G6n","merged":9,"otherRefs":["صحيح الترمذي 3410 (صحيح)","صحيح ابن ماجه 763 (صحيح)","صحيح النسائي 1347 (صحيح)","تخريج صحيح ابن حبان 2012 (صحيح)","تخريج مشكل الآثار 4089 (حسن)","تخريج مشكل الآثار 4091 (حسن)","تخريج مشكل الآثار 4090 (حسن)","تخريج سير أعلام النبلاء 6/ 111 (صحيح)"]},{"id":"س-01138","fp":"ce1b556a7c7d","stateId":691,"easy":"إذا قلت «سبحان الله العظيم وبحمده» ← تُغرس لك نخلة في الجنة","cause":"مَنْ قال : سُبحانَ اللهِ العظيمِ و بِحمْدِهِ","result":"غُرِسَتْ لهُ بِها نخلةٌ في الجنةِ","explicit":true,"star":true,"apply":{"k":"say","t":"«سبحان الله العظيم وبحمده»"},"similar":["س-00941"],"ref":"صحيح الجامع 6429","srcLabel":"الترمذي","text":[["مَنْ قال : سُبحانَ اللهِ العظيمِ و بِحمْدِهِ ، ",1],["غُرِسَتْ لهُ بِها نخلةٌ في الجنةِ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3464)، والنسائي في ((السنن الكبرى)) (10663) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"zK0erxLZ","merged":3,"otherRefs":["صحيح الترغيب 1540 (صحيح)","صحيح ابن حبان 826 (صحيح)"]},{"id":"س-06411","fp":"4f68738ff289","stateId":691,"easy":"إذا سبّحت وكبّرت وحمدت عشراً دبر كل صلاة ← فهما خصلتان لا يحافظ عليهما عبد إلا دخل الجنة","cause":"من سبَّحَ اللهَ في دُبِرِ كلِّ صلاةٍ عشرًا ، وكَبَّرَ اللهَ عشرًا ، وحَمِدَ اللهَ عشرًا ، فذلكَ خمسونَ ومئةٌ باللسانِ ، وألفٌ وخمسمئةٍ في الميزانِ ، وإذا آوَى إلى فراشِهِ سبَّحَ ثلاثًا وثلاثينَ وحمِدَ ثلاثًا وثلاثينَ وكبَّرَ أربعًا وثلاثينَ","result":"خصْلتَانِ مَنْ حافَظَ عليهِمَا دخَلَ الجنَّةَ","explicit":true,"apply":{"k":"time","t":"دبر كل صلاة"},"repOf":"س-01043","ref":"نتائج الأفكار 2/282","text":[["خصْلتَانِ مَنْ حافَظَ عليهِمَا دخَلَ الجنَّةَ",2]," – وفي روايةِ الثورِيِّ - لا يُحْصِيهُمَا رجلٌ مسلمٌ إلا دَخَلَ الجنةَ ، همَا يسِيرٌ ، ومَنْ يعملُ بهما قليلٌ ، ",["من سبَّحَ اللهَ في دُبِرِ كلِّ صلاةٍ عشرًا ، وكَبَّرَ اللهَ عشرًا ، وحَمِدَ اللهَ عشرًا ، فذلكَ خمسونَ ومئةٌ باللسانِ ، وألفٌ وخمسمئةٍ في الميزانِ ، وإذا آوَى إلى فراشِهِ سبَّحَ ثلاثًا وثلاثينَ وحمِدَ ثلاثًا وثلاثينَ وكبَّرَ أربعًا وثلاثينَ",1]," ، فذلِكَ مئةٌ باللسانِ وألفٌ في الميزانِ ، وأيُّكُمْ يعملُ في اليومِ والليلةِ ألفينِ وخمسمئةِ سيئةٍ ؟ . قالَ عبدُ اللهِ بنُ عمرٍو : فأنَا رأيتُ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يعقدُهَا بيدِهِ . قالوا : يا رسولَ اللهِ كيفَ من يعمَلُ بهمَا قليلٌ ، وفي روايةِ الثوريِّ : كيفَ لا يحصِيهمَا ؟ قالَ : يجِيءُ الشيطانُ أحدَكمْ في صلاتِهِ فيُذَكِّرُهُ حاجَةَ كذا وحاجَةَ كذَا ، فلا يَقُولُهَا ، ويأتِيهِ عندَ منَامِهِ فَيُنَوِّمُهُ فلا يَقُولُهَا"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح وله شاهد بإسناد قوي","takhrij":"أخرجه أبو داود (5065)، والترمذي (3410)، والنسائي (1348)، وابن ماجه (926)، وأحمد (6910) باختلاف يسير.","bab":"صلاة › أدعية دبر الصلوات","dorar":"oPe2p9ln","merged":3,"otherRefs":["تخريج المسند لشاكر 11/128 (صحيح)","صحيح الأدب المفرد 922 (صحيح)"]},{"id":"س-00753","fp":"5d5528f9efcf","stateId":691,"easy":"إذا قلت صباحاً «رضيت بالله رباً وبالإسلام ديناً وبمحمد نبياً» ← فالنبي ﷺ زعيم لك أن يأخذ بيدك حتى يدخلك الجنة","cause":"من قال إذا أصبحَ : رَضِيتُ باللهِ رَبًّا ، و بِالإسلامِ دِينًا و بِمحمدٍ نبيًّا","result":"فَأنا الزَّعِيمُ ، لآخُذَنَّ بيدِهِ حتى أُدْخِلَهُ الجنةَ","explicit":true,"star":true,"apply":{"k":"say","t":"«رضيت بالله رباً وبالإسلام ديناً وبمحمد نبياً» · الوقت: في الصباح"},"ref":"السلسلة الصحيحة 2686","srcLabel":"الطبراني","text":[["من قال إذا أصبحَ : \" رَضِيتُ باللهِ رَبًّا ، و بِالإسلامِ دِينًا و بِمحمدٍ نبيًّا",1]," \" ، ",["فَأنا الزَّعِيمُ ، لآخُذَنَّ بيدِهِ حتى أُدْخِلَهُ الجنةَ",2]],"grade":"صحيح","narrator":"المنيذر وقيل منذر الأسلمي","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني (20/355 رقم 838) واللفظ له، وابن قانع في ((معجم الصحابة)) (3/105)، وأبو نعيم في ((معرفة الصحابة)) (6107)","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"7zOUK5Uc"},{"id":"س-00941","fp":"5609ee75339b","stateId":691,"easy":"إذا قلت «سبحان الله العظيم» ← تُغرس لك شجرة في الجنة","cause":"مَن قال سُبحانَ اللهِ العظيمِ","result":"غُرِس له شجرةٌ في الجنَّةِ","explicit":true,"apply":{"k":"say","t":"«سبحان الله العظيم»"},"repOf":"س-01138","otherNeedIds":[45],"ref":"صحيح ابن حبان 827","text":[["مَن قال سُبحانَ اللهِ العظيمِ",1]," ",["غُرِس له شجرةٌ في الجنَّةِ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه النسائي في ((الكبرى)) (10594) باختلاف يسير، وابن أبي شيبة (30029) بلفظه غير أنه شك بين:\"شجرة أو نخلة\"، والحاكم (1888) وقال:\"نخلة\".","bab":"أدعية وأذكار › فضل الذكر","dorar":"Gg9WRd43"},{"id":"س-01141","fp":"ce663de2de60","stateId":691,"easy":"إذا اضطجعت على جنبك الأيمن وقلت «اللهم أسلمت نفسي إليك...» ← إن مت من ليلتك دخلت الجنة","cause":"إذا اضطجعَ أحدُكُم على جنبِهِ الأيمنِ ثمَّ قالَ اللَّهمَّ أسلَمتُ نفسي إليكَ ، ووجَّهتُ وجهي إليكَ ، وألجأتُ ظَهْري إليكَ ، وفوَّضتُ أمري إليكَ ، لا مَنجا منكَ ولا مَلجأَ إلَّا إليكَ ، أومنُ بِكِتابِكَ وبرسولِكَ","result":"فإن ماتَ مِن ليلتِهِ دخلَ الجنَّةَ","explicit":true,"apply":{"k":"say","t":"«اللَّهمَّ أسلَمتُ نفسي إليكَ ، ووجَّهتُ وجهي إليكَ ، وألجأتُ ظَهْري إليكَ ، وفوَّضتُ أمري إليكَ ، لا مَنجا منكَ ولا مَلجأَ إلَّا إليكَ ، أومنُ بِكِتابِكَ وبرسولِكَ» · الوقت: عند النوم"},"otherNeedIds":[62],"ref":"الترغيب والترهيب 1/281","srcLabel":"الترمذي","text":[["إذا اضطجعَ أحدُكُم على جنبِهِ الأيمنِ ثمَّ قالَ اللَّهمَّ أسلَمتُ نفسي إليكَ ، ووجَّهتُ وجهي إليكَ ، وألجأتُ ظَهْري إليكَ ، وفوَّضتُ أمري إليكَ ، لا مَنجا منكَ ولا مَلجأَ إلَّا إليكَ ، أومنُ بِكِتابِكَ وبرسولِكَ",1]," ، ",["فإن ماتَ مِن ليلتِهِ دخلَ الجنَّةَ",2]],"grade":"صحيح","narrator":"رافع بن خديج","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (3395)، والنسائي في ((السنن الكبرى)) (10607)، والطبراني (4/279) (4420) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"7Mt7vOY5"},{"id":"س-02557","fp":"c4dae1680251","stateId":691,"easy":"إذا قلت عند الاستيقاظ «الحمد لله الذي رد علي نفسي...» فمت ← تدخل الجنة","cause":"الحمدُ للهِ الَّذي ردَّ عليَّ نفسي ولم يُمِتْها في منامِها","result":"فَماتَ؛ دَخَلَ الجَنَّةَ","explicit":true,"apply":{"k":"say","t":"«الحمدُ للهِ الَّذي ردَّ عليَّ نفسي ولم يُمِتْها في منامِها الحمدُ للهِ الَّذي { يُمْسِكُ السَّمَوَاتِ وَالْأَرْضَ أَنْ تَزُولَا } إلى آخِرِ الآيةِ الحمدُ للهِ الَّذي { يُمْسِكُ السَّمَاءَ أَنْ تَقَعَ عَلَى الْأَرْضِ إلَّا بِإِذْنِهِ }فإنْ] وَوَقَعَ عَن سَريرِهِ فَماتَ» · الوقت: عند الاستيقاظ"},"ref":"الحرز الثمين 2/595","srcLabel":"الحرز الثمين","text":["إذا أوَى إلَى فِراشِهِ، فَإنْ قال [ابتدَره مَلَكٌ وشيطانٌ فيقولُ المَلَكُ اختِمْ بخيرٍ ويقولُ الشَّيطانُ اختِمْ بشرٍّ فإنْ ذكَر اللهَ ثمَّ نام بات المَلَكُ يَكْلَؤُه وإذا استيقَظَ قال المَلَكُ افتَحْ بخيرٍ وقال الشَّيطانُ افتَحْ بشرٍّ فإنْ قال ",["الحمدُ للهِ الَّذي ردَّ عليَّ نفسي ولم يُمِتْها في منامِها",1]," الحمدُ للهِ الَّذي { يُمْسِكُ السَّمَوَاتِ وَالْأَرْضَ أَنْ تَزُولَا } إلى آخِرِ الآيةِ الحمدُ للهِ الَّذي { يُمْسِكُ السَّمَاءَ أَنْ تَقَعَ عَلَى الْأَرْضِ إلَّا بِإِذْنِهِ }فإنْ] وَوَقَعَ عَن سَريرِهِ ",["فَماتَ؛ دَخَلَ الجَنَّةَ",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده صحيح","bab":"إيمان › أعمال الجن والشياطين","dorar":"dacsM6FX"},{"id":"س-05327","fp":"902ad49ecba8","stateId":691,"easy":"إذا اضطجعت وتوسدت يمينك وقلت «اللهم إليك أسلمت نفسي...» فمت ← يُبنى لك بيت في الجنة","cause":"إذا اضطجَعَ الرَّجُلُ فتَوسَّدَ يَمينَه، ثُمَّ قال: اللَّهُمَّ إليك أسلَمتُ نفْسي، وفَوَّضتُ إليك أمْري، وألجَأتُ إليك ظَهري، ووَجَّهتُ إليك وَجهي؛ رَهبةً منك، ورَغبةً إليك، لا مَلجأَ ولا مَنجا منك إلَّا إليك، آمَنتُ بكِتابِكَ الذي أنزَلتَ، وبنَبيِّكَ الذي أرسَلتَ، وبات على ذلك","result":"بُنيَ له بَيتٌ في الجنَّةِ","explicit":true,"apply":{"k":"say","t":"«اللَّهُمَّ إليك أسلَمتُ نفْسي، وفَوَّضتُ إليك أمْري، وألجَأتُ إليك ظَهري، ووَجَّهتُ إليك وَجهي؛ رَهبةً منك، ورَغبةً إليك، لا مَلجأَ ولا مَنجا منك إلَّا إليك، آمَنتُ بكِتابِكَ الذي أنزَلتَ، وبنَبيِّكَ الذي أرسَلتَ» · الوقت: عند النوم"},"ref":"تخريج المسند لشعيب 18617","srcLabel":"أحمد","text":[["إذا اضطجَعَ الرَّجُلُ فتَوسَّدَ يَمينَه، ثُمَّ قال: اللَّهُمَّ إليك أسلَمتُ نفْسي، وفَوَّضتُ إليك أمْري، وألجَأتُ إليك ظَهري، ووَجَّهتُ إليك وَجهي؛ رَهبةً منك، ورَغبةً إليك، لا مَلجأَ ولا مَنجا منك إلَّا إليك، آمَنتُ بكِتابِكَ الذي أنزَلتَ، وبنَبيِّكَ الذي أرسَلتَ، وبات على ذلك",1],"؛ ",["بُنيَ له بَيتٌ في الجنَّةِ",2],"، أو بُوِّئَ له بَيتٌ في الجنَّةِ."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح دون قوله: بني له بيت في الجنَّة، أو بوئ له بيت في الجنَّة","takhrij":"أخرجه أحمد (18617)","bab":"رقائق وزهد › التوكل واليقين","dorar":"hSlxpMZw"},{"id":"س-01244","fp":"894abf64f05b","stateId":691,"easy":"إذا أكثرت من غراس الجنة (الذكر) ← فماؤها عذب وترابها طيب","cause":"أَكثِروا من غِراسِ الجنَّةِ","result":"فإنه عَذبٌ ماؤها ، طَيِّبٌ ترابُها ، فأَكثِروا من غِراسِها","explicit":true,"ref":"صحيح الترغيب 1584","srcLabel":"الطبراني","text":[["أَكثِروا من غِراسِ الجنَّةِ ؛ ",1],["فإنه عَذبٌ ماؤها ، طَيِّبٌ ترابُها ، فأَكثِروا من غِراسِها ",2],". قالوا : يا رسولَ اللهِ ! وما غراسُها . قال : ما شاء اللهُ ، لا حولَ ولا قُوَّةَ إلا باللهِ ."],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن لغيره","takhrij":"أخرجه الطبراني في ((الكبير)) (12/ 364)، وفي ((الدعاء)) له (صـ 474). باختلاف يسير.","bab":"أدعية وأذكار › فضل لا حول ولا قوة إلا بالله","dorar":"tFKiyC1P","merged":2,"otherRefs":["صحيح الجامع 1213 (حسن)"]},{"id":"س-01256","fp":"0037769f3b58","stateId":691,"easy":"إذا قلت «لا حول ولا قوة إلا بالله» ← فهي كنز من كنوز الجنة","cause":"لا حَولَ ولا قوَّةَ إلَّا باللهِ","result":"ألا أدُلُّك على كَلِمةٍ مِن كَنزٍ مِن كُنوزِ الجَنَّةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«لا حول ولا قوة إلا بالله»"},"similar":["س-01247"],"otherNeedIds":[45],"ref":"صحيح البخاري 4205","srcLabel":"مسلم","text":["لَمَّا غَزا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم خَيبَرَ -أو قال: لَمَّا تَوجَّهَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم- أشرَفَ النَّاسُ على وادٍ، فرَفَعوا أصواتَهم بالتَّكبيرِ: اللهُ أكبَرُ اللهُ أكبَرُ، لا إلَهَ إلَّا اللهُ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: اربَعوا على أنفُسِكُم؛ إنَّكُم لا تَدعونَ أصَمَّ ولا غائِبًا، إنَّكُم تَدعونَ سَميعًا قَريبًا وهو معكُم. وأنا خَلفَ دابَّةِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فسَمِعَني وأنا أقولُ: ",["لا حَولَ ولا قوَّةَ إلَّا باللهِ",1],"، فقال لي: يا عَبدَ اللهِ بنَ قَيسٍ. قُلتُ: لَبَّيك يا رَسولَ اللهِ، قال: ",["ألا أدُلُّك على كَلِمةٍ مِن كَنزٍ مِن كُنوزِ الجَنَّةِ",2],"؟ قُلتُ: بَلى يا رَسولَ اللهِ، فداك أبي وأُمِّي، قال: لا حَولَ ولا قوَّةَ إلَّا باللهِ."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2704) باختلاف يسير","bab":"أدعية وأذكار › فضل لا حول ولا قوة إلا بالله","dorar":"8CkkHL8g","merged":24,"otherRefs":["صحيح أبي داود 1526 (صحيح)","صحيح الترمذي 3601 (صحيح)","صحيح البخاري 6384 (صحيح)","تخريج المسند لشاكر 15/220 (صحيح)","تخريج المسند لشعيب 7966 (صحيح)","تخريج المسند لشعيب 8426 (صحيح)","تخريج المسند لشعيب 10918 (صحيح)","تخريج المسند لشعيب 21349 (صحيح)","تخريج المسند لشعيب 19755 (صحيح)","المستدرك على الصحيحين 7997 (صحيح)","صحيح الترمذي 3461 (صحيح)","صحيح البخاري 6409 (صحيح)","صحيح مسلم 2704 (صحيح)","مجمع الزوائد 7/268 (صحيح)","تخريج صحيح ابن حبان 804 (صحيح)","تخريج المسند لشعيب 19599 (صحيح)","تخريج المسند لشعيب 19605 (صحيح)","تخريج سير أعلام النبلاء 2/397 (صحيح)","المستدرك على الصحيحين 1925 (صحيح)","مجمع الزوائد 10/100 (حسن)","المطالب العالية 4/43 (حسن)","تخريج صحيح ابن حبان 449 (صحيح)"]},{"id":"س-00804","fp":"9832ae4dcc72","stateId":691,"easy":"إذا حمدت الله على كل حال ← تقوم يوم القيامة فتسرح إلى الجنة","cause":"الحمَّادونَ للَّهِ على كلِّ حالٍ","result":"فيقومونَ فيسرَحونَ إلى الجنَّةِ","explicit":true,"ref":"الدر المنثور 10/111","srcLabel":"الحاكم","text":["عنِ ابنِ عبَّاسٍ قالَ: إذا كانَ يومُ القيامةِ مُدَّتِ الأرضُ مدَّ الأديمِ، وزيدَ في سَعتِها كذا وَكذا، وجمعَ الخلائقُ بصعيدٍ واحدٍ جنُّهمُ وَ إنسُهم، فإذا كانَ ذلِكَ اليومَ قُبِضت هذِهِ السَّماءُ الدُّنيا عن أَهلِها على وجْهِ الأرضِ ولأَهلُ السَّماءِ وحدُهم أَكثرُ من أَهلِ الأرضِ جنِّهم وَ إنسِهم بضِعفٍ، فإذا نُثِروا على وجْهِ الأرض فزعوا إليهِم فيقولون: أفيكم ربُّنا؟ فيفزعونَ من قولِهم ويقولونَ: سبحانَ ربِّنا ليس فينا وهو آتٍ، ثُمَّ تُقاضُ السَّماءُ الثَّانيةُ ولأَهلُ السَّماءِ الثَّانيةِ وحدَهم أَكثرَ من أهل السَّماءِ الدُّنيا، ومن جميعِ أهل الأرضِ بضِعفٍ جنِّهم وَ إنسِهم، فإذا نُثِروا على وجهِ الأرض فزعَ إليهم أهلُ الأرضِ فيقولونَ: أفيكُم ربُّنا؟ فيفزعونَ من قولِهم ويقولونَ: سبحانَ ربِّنا ليسَ فينا وهو آتٍ، ثم تُقاضُ السَّمواتُ سماءً سماءً كلَّما قيضَت سماءٌ عن أهلِها كانت أكثرَ من أهل السَّمواتِ الَّتي تحتَها ومن جميعِ أَهلِ الأرضِ بضِعفٍ، فإذا نُثِروا على أهل الأرضِ يفزعَ إليْهم أَهلُ الأرضِ فيقولونَ لَهم: مثلُ ذلِكَ فيرجعونَ إليهم مثل ذلك حتَّى تقاضَ السَّماءُ السَّابعةُ فلَأَهلُ السَّماءِ السَّابعةِ أَكثرُ من أهلِ ستِّ سمواتٍ ومن جميعِ أهلِ الأرضِ بضِعفٍ، فيجيءُ اللَّهُ فيهم والأممُ جثًى صفوفٌ فينادي منادٍ ستعلمونَ اليومَ من أصحابُ الْكرمِ ليقُمِ ",["الحمَّادونَ للَّهِ على كلِّ حالٍ",1]," ",["فيقومونَ فيسرَحونَ إلى الجنَّةِ",2]," ثمَّ ينادي الثَّانيةَ ستعلمون اليومَ من أصحابُ الْكرمِ أينَ الَّذينَ كانت تَتَجَافَى جُنُوبُهُمْ عَنِ المَضَاجِعِ يَدْعُونَ رَبَّهُمْ خَوْفًا وَطَمَعًا وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ [السجدة آية: 16] فيقومونَ فيسرَحونَ إلى الجنَّةِ، قالَ: ثمَّ ينادي الثَّالثةَ ستعلمون اليومَ من أصحابُ الْكرَمِ أين الَّذينَ لَا تُلْهِيهِمْ تِجَارَةٌ وَلَا بَيْعٌ عَنْ ذِكْرِ اللَّهِ وَإِقَامِ الصَّلَاةِ وَإِيتَاءِ الزَّكَاةِ يَخَافُونَ يَوْمًا تَتَقَلَّبُ فِيهِ الْقُلُوبُ وَالْأَبْصَارُ [النور آية: 37] فيقومونَ فيسرَحونَ إلى الجنَّةِ فإذا أخذَ كلٌّ من هؤلاءِ ثلاثةٌ خرجَ عنُقٌ منَ النَّارِ فأشرفَ على الخلائقِ لَهُ عينانِ تبصِرانِ ولسانٌ فصيحٌ فيقولُ: إنِّي وُكِّلتُ منكُم بثلاثةٍ بِكلِّ جبَّارٍ عنيدٍ فتلتقطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسِمِ، فتجلِسُ بِهم في جَهنَّمَ ثمَّ تخرجُ ثانيةً فتقولُ إنِّي وُكِّلتُ منكُم بمن آذى اللَّهَ تعالى ورسولَهُ، فتلتقِطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسمِ فتُحبَسُ بهم في جهنَّمَ، ثم تخرجُ ثالثةً فتقولُ: إنِّي وُكِّلتُ بأصحابِ التَّصاويرِ فتَلقطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسمِ فتُحبَسُ بِهم في جَهنَّمَ فإذا أُخذَ من هؤلاءِ ثلاثةً ومن هؤلاءِ ثلاثةً نشِرتِ الصُّحفَ ووُضِعتِ الموازينَ ودُعيَ الخلائقُ للحسابِ"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن المبارك في ((الزهد والرقائق)) (2/101) واللفظ له، والحاكم (8699)، والحارث بن أبي أسامة كما في ((بغية الباحث)) (1122) بلفظ مقارب","bab":"أدعية وأذكار › حمد الله في كل الأحوال","dorar":"TsRrl1QY"},{"id":"س-00806","fp":"b70350101699","stateId":691,"easy":"إذا لم تلهك تجارة ولا بيع عن ذكر الله ← تُدعى يوم القيامة فتسرح إلى الجنة","cause":"أين الَّذينَ لَا تُلْهِيهِمْ تِجَارَةٌ وَلَا بَيْعٌ عَنْ ذِكْرِ اللَّهِ","result":"فيقومونَ فيسرَحونَ إلى الجنَّةِ","explicit":true,"ref":"الدر المنثور 10/111","srcLabel":"الحاكم","text":["عنِ ابنِ عبَّاسٍ قالَ: إذا كانَ يومُ القيامةِ مُدَّتِ الأرضُ مدَّ الأديمِ، وزيدَ في سَعتِها كذا وَكذا، وجمعَ الخلائقُ بصعيدٍ واحدٍ جنُّهمُ وَ إنسُهم، فإذا كانَ ذلِكَ اليومَ قُبِضت هذِهِ السَّماءُ الدُّنيا عن أَهلِها على وجْهِ الأرضِ ولأَهلُ السَّماءِ وحدُهم أَكثرُ من أَهلِ الأرضِ جنِّهم وَ إنسِهم بضِعفٍ، فإذا نُثِروا على وجْهِ الأرض فزعوا إليهِم فيقولون: أفيكم ربُّنا؟ فيفزعونَ من قولِهم ويقولونَ: سبحانَ ربِّنا ليس فينا وهو آتٍ، ثُمَّ تُقاضُ السَّماءُ الثَّانيةُ ولأَهلُ السَّماءِ الثَّانيةِ وحدَهم أَكثرَ من أهل السَّماءِ الدُّنيا، ومن جميعِ أهل الأرضِ بضِعفٍ جنِّهم وَ إنسِهم، فإذا نُثِروا على وجهِ الأرض فزعَ إليهم أهلُ الأرضِ فيقولونَ: أفيكُم ربُّنا؟ فيفزعونَ من قولِهم ويقولونَ: سبحانَ ربِّنا ليسَ فينا وهو آتٍ، ثم تُقاضُ السَّمواتُ سماءً سماءً كلَّما قيضَت سماءٌ عن أهلِها كانت أكثرَ من أهل السَّمواتِ الَّتي تحتَها ومن جميعِ أَهلِ الأرضِ بضِعفٍ، فإذا نُثِروا على أهل الأرضِ يفزعَ إليْهم أَهلُ الأرضِ فيقولونَ لَهم: مثلُ ذلِكَ فيرجعونَ إليهم مثل ذلك حتَّى تقاضَ السَّماءُ السَّابعةُ فلَأَهلُ السَّماءِ السَّابعةِ أَكثرُ من أهلِ ستِّ سمواتٍ ومن جميعِ أهلِ الأرضِ بضِعفٍ، فيجيءُ اللَّهُ فيهم والأممُ جثًى صفوفٌ فينادي منادٍ ستعلمونَ اليومَ من أصحابُ الْكرمِ ليقُمِ الحمَّادونَ للَّهِ على كلِّ حالٍ فيقومونَ فيسرَحونَ إلى الجنَّةِ ثمَّ ينادي الثَّانيةَ ستعلمون اليومَ من أصحابُ الْكرمِ أينَ الَّذينَ كانت تَتَجَافَى جُنُوبُهُمْ عَنِ المَضَاجِعِ يَدْعُونَ رَبَّهُمْ خَوْفًا وَطَمَعًا وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ [السجدة آية: 16] فيقومونَ فيسرَحونَ إلى الجنَّةِ، قالَ: ثمَّ ينادي الثَّالثةَ ستعلمون اليومَ من أصحابُ الْكرَمِ ",["أين الَّذينَ لَا تُلْهِيهِمْ تِجَارَةٌ وَلَا بَيْعٌ عَنْ ذِكْرِ اللَّهِ",1]," وَإِقَامِ الصَّلَاةِ وَإِيتَاءِ الزَّكَاةِ يَخَافُونَ يَوْمًا تَتَقَلَّبُ فِيهِ الْقُلُوبُ وَالْأَبْصَارُ [النور آية: 37] ",["فيقومونَ فيسرَحونَ إلى الجنَّةِ",2]," فإذا أخذَ كلٌّ من هؤلاءِ ثلاثةٌ خرجَ عنُقٌ منَ النَّارِ فأشرفَ على الخلائقِ لَهُ عينانِ تبصِرانِ ولسانٌ فصيحٌ فيقولُ: إنِّي وُكِّلتُ منكُم بثلاثةٍ بِكلِّ جبَّارٍ عنيدٍ فتلتقطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسِمِ، فتجلِسُ بِهم في جَهنَّمَ ثمَّ تخرجُ ثانيةً فتقولُ إنِّي وُكِّلتُ منكُم بمن آذى اللَّهَ تعالى ورسولَهُ، فتلتقِطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسمِ فتُحبَسُ بهم في جهنَّمَ، ثم تخرجُ ثالثةً فتقولُ: إنِّي وُكِّلتُ بأصحابِ التَّصاويرِ فتَلقطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسمِ فتُحبَسُ بِهم في جَهنَّمَ فإذا أُخذَ من هؤلاءِ ثلاثةً ومن هؤلاءِ ثلاثةً نشِرتِ الصُّحفَ ووُضِعتِ الموازينَ ودُعيَ الخلائقُ للحسابِ"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن المبارك في ((الزهد والرقائق)) (2/101) واللفظ له، والحاكم (8699)، والحارث بن أبي أسامة كما في ((بغية الباحث)) (1122) بلفظ مقارب","bab":"أدعية وأذكار › حمد الله في كل الأحوال","dorar":"TsRrl1QY"},{"id":"س-00836","fp":"b01434098d04","stateId":691,"easy":"إذا كبّرت ← بُشّرت بالجنة","cause":"ولا كبَّرَ مُكبِّرٌ قطُّ","result":"إلَّا بُشِّرَ","explicit":true,"ref":"صحيح الترغيب 1137","srcLabel":"الطبراني","text":["ما أهلَّ مُهِلٌّ قطُّ إلَّا بُشِّرَ ، ",["ولا كبَّرَ مُكبِّرٌ قطُّ",1]," ",["إلَّا بُشِّرَ",2]," . قيلَ : يا رسولَ اللهِ ! بالجنَّةِ ؟ قال : نعَم ."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن لغيره","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (7779).","bab":"أدعية وأذكار › فضل التكبير","dorar":"alY4REID"},{"id":"س-01110","fp":"cfa60679d2e0","stateId":691,"easy":"إذا قلت في يوم مئة مرة «لا إله إلا الله الملك الحق المبين» ← تستقرع أبواب الجنة وتأمن من الفقر","cause":"مَن قال في يومٍ مِائَةَ مرَّةٍ: لا إلهَ إلَّا اللهُ الحقُّ المُبينُ","result":"استَقرَع أبوابَ الجنَّةِ, وأمِن مِنَ وَحشَةِ القبرِ, واستَجلَب به الرِّزقَ, وأمِن مِنَ الفَقرِ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله الملك الحق المبين» · العدد: مئة مرة"},"otherNeedIds":[63,1],"ref":"التمهيد 6/55","srcLabel":"مالك","text":[["مَن قال في يومٍ مِائَةَ مرَّةٍ: لا إلهَ إلَّا اللهُ الحقُّ المُبينُ, ",1],["استَقرَع أبوابَ الجنَّةِ, وأمِن مِنَ وَحشَةِ القبرِ, واستَجلَب به الرِّزقَ, وأمِن مِنَ الفَقرِ",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"لا يرويه عن مالك من يوثق به ولا هو معروف من حديثه وهو حديث حسن ترجى بركته إن شاء الله تعالى","takhrij":"أخرجه الشجري في ((الأمالي)) (20) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"FtZ12OYa"},{"id":"س-02455","fp":"773497ba7fec","stateId":691,"easy":"إذا قلت «اللهم فاطر السماوات والأرض... إني أعهد إليك...» ← يقال يوم القيامة: أدخلوه الجنة","cause":"مَن قال: اللَّهمَّ فاطِرَ السَّمواتِ والأرضِ، عالمَ الغَيبِ والشَّهادةِ، إنِّي أعهَدُ إليك في هذه الحَياةِ الدُّنيا أنِّي أشهَدُ أنْ لا إلهَ إلَّا أنتَ، وَحدَكَ لا شَريكَ لك، وأنَّ محمَّدًا عبدُكَ ورسولُكَ؛ فإنَّكَ إنْ تكِلْني إلى نفْسي تُقرِّبْني مِن الشَّرِّ، وتُباعِدْني مِن الخيرِ، وإنِّي لا أثِقُ إلَّا برَحمتِكَ؛ فاجعَلْ لي عندَكَ عَهدًا تُوَفِّينيهِ يومَ القِيامةِ؛ إنَّكَ لا تُخلِفُ الميعادَ","result":"إلَّا قال اللهُ لملائكتِه يومَ القِيامةِ: إنَّ عبدي قد عَهِدَ إليَّ عَهدًا، فأَوفوه إيَّاه، فيُدخِلُه اللهُ الجنَّةَ","explicit":true,"apply":{"k":"say","t":"«اللهم فاطر السماوات والأرض... إني أعهد إليك...»"},"ref":"تخريج المسند لشعيب 3916","srcLabel":"أحمد","text":[["مَن قال: اللَّهمَّ فاطِرَ السَّمواتِ والأرضِ، عالمَ الغَيبِ والشَّهادةِ، إنِّي أعهَدُ إليك في هذه الحَياةِ الدُّنيا أنِّي أشهَدُ أنْ لا إلهَ إلَّا أنتَ، وَحدَكَ لا شَريكَ لك، وأنَّ محمَّدًا عبدُكَ ورسولُكَ؛ فإنَّكَ إنْ تكِلْني إلى نفْسي تُقرِّبْني مِن الشَّرِّ، وتُباعِدْني مِن الخيرِ، وإنِّي لا أثِقُ إلَّا برَحمتِكَ؛ فاجعَلْ لي عندَكَ عَهدًا تُوَفِّينيهِ يومَ القِيامةِ؛ إنَّكَ لا تُخلِفُ الميعادَ",1],"؛ ",["إلَّا قال اللهُ لملائكتِه يومَ القِيامةِ: إنَّ عبدي قد عَهِدَ إليَّ عَهدًا، فأَوفوه إيَّاه، فيُدخِلُه اللهُ الجنَّةَ",2],"."],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"رجاله ثقات","takhrij":"أخرجه أحمد (3916)","bab":"إسلام › فضل الشهادتين","dorar":"JDnJCkaj"},{"id":"س-01187","fp":"c6264c96fcb5","stateId":691,"easy":"إذا قلت «سبحان الله والحمد لله ولا إله إلا الله والله أكبر» ← فهي غراس الجنة","cause":"سبحانَ اللهِ ، والحمدُ للهِ ، ولا إله إلا اللهُ ، واللهُ أكبرُ","result":"وأَنَّ غِراسَها","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«سبحان الله والحمد لله ولا إله إلا الله والله أكبر»"},"similar":["س-01146","س-01147"],"otherNeedIds":[45],"ref":"شرح الطحاوية 423","srcLabel":"الترمذي","text":["لَقِيتُ إبراهيمَ ليلةَ أُسْرِيَ بِي ، فقال : يا مُحَمَّدُ ، أَقْرِئْ أُمَّتَك مِنِّي السلامَ ، وأَخْبِرْهم أنَّ الجنةَ طَيِّبَةُ التُّرْبَةِ ، عَذْبَةُ الماءِ ، وأَنَّها قِيعانٌ ، ",["وأَنَّ غِراسَها",2]," ",["سبحانَ اللهِ ، والحمدُ للهِ ، ولا إله إلا اللهُ ، واللهُ أكبرُ",1]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3462) واللفظ له، والطبراني (10/214) (10363)، والخطيب في ((تاريخ بغداد)) (2/292) باختلاف يسير.","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"B67xJ6YQ","merged":2,"otherRefs":["السلسلة الصحيحة 105 (حسن)"]},{"id":"س-01086","fp":"3dda6915edf4","stateId":691,"easy":"إذا قلت «سبحان الله والحمد لله ولا إله إلا الله والله أكبر» ← يُغرس لك بكل واحدة شجرة في الجنة","cause":"قلتُ: ما هو؟ قالَ: سُبحانَ اللهِ، والحمدُ للهِ، ولا إلَهَ إلَّا اللهُ، واللهُ أَكبرُ؛ يُغرَسُ لكَ بكُلِّ واحدةٍ شجرةٌ","result":"ألا أَدلُّكَ على غَرسٍ خيرٌ لكَ منه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«سبحان الله والحمد لله ولا إله إلا الله والله أكبر»"},"ref":"المستدرك على الصحيحين 1911","srcLabel":"ابن ماجة","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ مَرَّ به وهو يَغرِسُ غَرسًا، فقالَ: ما تَصنعُ يا أبا هُريرةَ؟ قالَ: أَغرِسُ غَرسًا. فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["ألا أَدلُّكَ على غَرسٍ خيرٌ لكَ منه",2],"؟",[" قلتُ: ما هو؟ قالَ: سُبحانَ اللهِ، والحمدُ للهِ، ولا إلَهَ إلَّا اللهُ، واللهُ أَكبرُ؛ يُغرَسُ لكَ بكُلِّ واحدةٍ شجرةٌ.",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد، وله شاهد","takhrij":"أخرجه ابن ماجة (3807)، وابن الأعرابي في ((معجمه)) (2190)، وقوام السنة في ((الترغيب والترهيب)) (768) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"EagLZtg5"},{"id":"س-01146","fp":"c2da915627e5","stateId":691,"easy":"إذا قلت «سبحان الله والحمد لله ولا إله إلا الله والله أكبر» ← ترتع في رياض الجنة","cause":"سُبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ واللهُ أكبَرُ","result":"ألَا ترتَعُ في رَوضةِ الجَنَّة وتُريحُ فيها","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«سبحان الله والحمد لله ولا إله إلا الله والله أكبر»"},"repOf":"س-01187","ref":"مجمع الزوائد 10/94","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال لأبي بكرٍ رحِمَه اللهُ ",["ألَا ترتَعُ في رَوضةِ الجَنَّة وتُريحُ فيها",2]," قال يا رسولَ اللهِ وما الرَّتْعُ قال ",["سُبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ واللهُ أكبَرُ",1]," قال سلمانُ إنَّ لكلِّ شيءٍ غَرْسًا فما غِراسُ الجَنَّةِ قال سُبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ واللهُ أكبَرُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"فيه حميد المكي وليس هو حميد بن قيس هذا مولى ابن علقمة لم يرو عنه غير زيد بن الحباب وبقية رجاله رجال الصحيح","takhrij":"أخرجه البزار (9311) بلفظه، والترمذي (3509)، ومحمد بن عاصم الثقفي في ((جزئه)) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"ML3j2RuQ"},{"id":"س-01147","fp":"1bd4ddf3729a","stateId":691,"easy":"إذا قلت «سبحان الله والحمد لله ولا إله إلا الله والله أكبر» ← فهي غراس الجنة","cause":"سُبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ واللهُ أكبَرُ","result":"فما غِراسُ الجَنَّةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«سبحان الله والحمد لله ولا إله إلا الله والله أكبر»"},"repOf":"س-01187","ref":"مجمع الزوائد 10/94","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال لأبي بكرٍ رحِمَه اللهُ ألَا ترتَعُ في رَوضةِ الجَنَّة وتُريحُ فيها قال يا رسولَ اللهِ وما الرَّتْعُ قال ",["سُبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ واللهُ أكبَرُ",1]," قال سلمانُ إنَّ لكلِّ شيءٍ غَرْسًا ",["فما غِراسُ الجَنَّةِ",2]," قال سُبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ واللهُ أكبَرُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"فيه حميد المكي وليس هو حميد بن قيس هذا مولى ابن علقمة لم يرو عنه غير زيد بن الحباب وبقية رجاله رجال الصحيح","takhrij":"أخرجه البزار (9311) بلفظه، والترمذي (3509)، ومحمد بن عاصم الثقفي في ((جزئه)) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"ML3j2RuQ"},{"id":"س-01247","fp":"d37d3bd90765","stateId":691,"easy":"إذا قلت «لا حول ولا قوة إلا بالله» ← فهي غراس الجنة","cause":"لا حولَ ولا قوَّةَ إلَّا باللهِ","result":"وما غِراسُ الجنَّةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«لا حول ولا قوة إلا بالله»"},"repOf":"س-01256","ref":"صحيح ابن حبان 821","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ليلةَ أُسرِي به مَرَّ على إبراهيمَ خليلِ الرَّحمنِ فقال إبراهيمُ لجِبريلَ : مَن معك يا جِبريلُ ؟ قال جِبريلُ : هذا مُحمَّدٌ صلَّى اللهُ عليه وسلَّم فقال إبراهيمُ : يا مُحمَّدُ مُرْ أُمَّتَكَ أنْ يُكثِروا غِراسَ الجنَّةِ فإنَّ تُربتَها طيِّبةٌ وأرضَها واسعةٌ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم لإبراهيمَ : ( ",["وما غِراسُ الجنَّةِ",2]," ) ؟ قال : ",["لا حولَ ولا قوَّةَ إلَّا باللهِ",1]],"grade":"صحيح","narrator":"أبو أيوب","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (23552)، والطبراني (4/132) (3898)، والبيهقي في ((شعب الإيمان)) (657) باختلاف يسير","bab":"أدعية وأذكار › فضل لا حول ولا قوة إلا بالله","dorar":"BlQyQrs6"},{"id":"س-01255","fp":"a54bbd2fc0c5","stateId":691,"easy":"إذا قلت «لا حول ولا قوة إلا بالله» ← يقول الله: أسلم عبدي واستسلم","cause":"تقول : ( لا حولَ ولا قوَّةَ إلا بالله ) ، فيقول اللهُ : أسلمَ عَبدي واستسلَم","result":"ألا أَدُلُّك على - كلمةٍ من تحتِ العرشِ من كنزِ الجنةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«لا حول ولا قوة إلا بالله»"},"otherNeedIds":[45],"ref":"صحيح الترغيب 1580","srcLabel":"النسائي","text":["ألا أُعلِّمُك - أو ",["ألا أَدُلُّك على - كلمةٍ من تحتِ العرشِ من كنزِ الجنةِ ",2],"؟",[" تقول : ( لا حولَ ولا قوَّةَ إلا بالله ) ، فيقول اللهُ : أسلمَ عَبدي واستسلَم",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (2/ 298)، والنسائي في ((الكبرى)) (6/ 7)، والحاكم في ((المستدرك)) (1/ 71) واللفظ له.","bab":"أدعية وأذكار › فضل لا حول ولا قوة إلا بالله","dorar":"8qoyO0Iv"},{"id":"س-00978","fp":"3ff94e5947ec","stateId":691,"easy":"إذا حافظت على خلتين (التسبيح والتكبير والتحميد دبر الصلاة وعند النوم) ← تدخل الجنة","cause":"أَدخَلَتاه الجنَّةَ، وهما يسيرٌ، ومَن يَعمَلُ بهما قليلٌ! قالوا: وما هما يا رسولَ اللهِ؟ قال: أنْ تَحمَدَ اللهَ وتُكبِّرَه وتُسبِّحَه في دُبُرِ كلِّ صلاةٍ مكتوبةٍ عَشرًا عَشرًا، وإذا أوَيْتَ إلى مَضْجَعِكَ تُسبِّحُ اللهَ وتُكبِّرُه وتَحمَدُه مِئةَ مَرَّةٍ، فتلك خمسونَ ومِئتانِ باللِّسانِ، وألْفانِ وخَمسُ مِئةٍ في الميزانِ، فأَيُّكم يَعمَلُ في اليومِ واللَّيلةِ ألْفَينِ وخَمسَ مِئةِ","result":"خَلَّتانِ مَن حافَظَ عليهما","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"عند النوم، دبر كل صلاة"},"ref":"تخريج المسند لشعيب 6498","srcLabel":"أبو داود","text":[["خَلَّتانِ مَن حافَظَ عليهما",2],"؛",[" أَدخَلَتاه الجنَّةَ، وهما يسيرٌ، ومَن يَعمَلُ بهما قليلٌ! قالوا: وما هما يا رسولَ اللهِ؟ قال: أنْ تَحمَدَ اللهَ وتُكبِّرَه وتُسبِّحَه في دُبُرِ كلِّ صلاةٍ مكتوبةٍ عَشرًا عَشرًا، وإذا أوَيْتَ إلى مَضْجَعِكَ تُسبِّحُ اللهَ وتُكبِّرُه وتَحمَدُه مِئةَ مَرَّةٍ، فتلك خمسونَ ومِئتانِ باللِّسانِ، وألْفانِ وخَمسُ مِئةٍ في الميزانِ، فأَيُّكم يَعمَلُ في اليومِ واللَّيلةِ ألْفَينِ وخَمسَ مِئةِ",1]," سَيِّئةٍ؟ قالوا: كيف مَن يَعمَلُ بهما قليلٌ؟! قال: يَجيءُ أحدَكم الشَّيطانُ في صلاتِه، فيُذكِّرُه حاجةَ كذا وكذا، فلا يقولُها، ويَأْتيه عندَ مَنامِه، فيُنوِّمُه، فلا يقولُها قال: ورَأيتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَعقِدُهنَّ بيَدِه."],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن لغيره","takhrij":"أخرجه أبو داود (5065)، والترمذي (3410)، والنسائي (1348)، وابن ماجه (926)، وأحمد (6498) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"SPCPyXCd"},{"id":"س-04298","fp":"314e663c65f9","stateId":692,"easy":"إذا سألت الله الجنة ثلاث مرات ← تقول الجنة: اللهم أدخله الجنة","cause":"ما مِن مُسلِمٍ سأل اللهَ الجنَّةَ ثلاثَ مرَّاتٍ قطُّ","result":"إلَّا قالت الجنَّةُ: اللَّهُمَّ أدخِلْه الجنَّةَ، ولا استجارَ مِنَ النَّارِ ثَلاثَ مَرَّاتٍ إلَّا قالت النَّارُ: اللَّهُمَّ أجِرْه","explicit":true,"star":true,"apply":{"k":"count","t":"ثلاث مرات"},"similar":["س-04299","س-00678"],"otherNeedIds":[66,45],"ref":"الأحاديث المختارة 1557","srcLabel":"البخاري","text":["«",["ما مِن مُسلِمٍ سأل اللهَ الجنَّةَ ثلاثَ مرَّاتٍ قطُّ",1]," ",["إلَّا قالت الجنَّةُ: اللَّهُمَّ أدخِلْه الجنَّةَ، ولا استجارَ مِنَ النَّارِ ثَلاثَ مَرَّاتٍ إلَّا قالت النَّارُ: اللَّهُمَّ أجِرْه»",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"pwmIfKm4"},{"id":"س-04299","fp":"cba6a1aa584d","stateId":692,"easy":"إذا سألت الله الجنة ثلاثاً ← تقول الجنة: اللهم أدخله الجنة","cause":"من سأل اللهَ الجنَّةَ ثلاثًا، قالت الجنَّةُ: اللَّهُمَّ","result":"أدخِلْه الجنَّةَ","explicit":true,"repOf":"س-04298","ref":"الأحاديث المختارة 1560","text":["«",["من سأل اللهَ الجنَّةَ ثلاثًا، قالت الجنَّةُ: اللَّهُمَّ ",1],["أدخِلْه الجنَّةَ، ",2],"ومن تعوَّذَ باللهِ من النَّارِ ثلاثًا، قالت النَّارُ: اللَّهُمَّ أعِذْه مني»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"sxHj6p6z"},{"id":"س-00052","fp":"1f116397ebfa","stateId":692,"easy":"إذا فُتح لك باب الدعاء ← فُتحت لك أبواب الجنة","cause":"مَنْ فُتِحَ له في الدُّعاءِ منكم","result":"فُتِحَتْ له أَبوابُ الجنَّةِ","explicit":true,"otherNeedIds":[29],"ref":"المستدرك على الصحيحين 1857","srcLabel":"الترمذي","text":[["مَنْ فُتِحَ له في الدُّعاءِ منكم ",1],["فُتِحَتْ له أَبوابُ الجنَّةِ",2],"، ولا يَسألُ اللهَ عَبدٌ شيئًا أَحبَّ إليه مِن أنْ يَسألَ العافيةَ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الدينوري في ((المجالسة)) (1567) بلفظه، والترمذي (3548) باختلاف يسير، والطبراني في ((الدعاء)) (1296) مختصرا.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"Dp3V0dYp"},{"id":"س-00678","fp":"338031470eb6","stateId":692,"easy":"إذا سألت الله الجنة ثلاثاً ← تدعو لك الجنة: اللهم أدخله","cause":"من سأل اللهَ الجنةَ ثلاثَ مراتٍ","result":"قالتِ الجنةُ : اللهم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-04298","ref":"هداية الرواة 2412","text":["قال رسولُ اللهِ - صلَّى اللهُ عليهِ وسلَّم - :  ",["من سأل اللهَ الجنةَ ثلاثَ مراتٍ, ",1],["قالتِ الجنةُ : اللهم ",2],"! أَدخِله الجنةَ, ومَن استجار مِن النارِ ثلاثَ مراتٍ ؛ قالتِ النارُ : اللهم ! أَجِره مِن النارِ  ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2572)، والنسائي (5521)، وابن ماجه (4340) واللفظ لهم، وأحمد (12585) باختلاف يسير","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"FBbSD2hU"},{"id":"س-06643","fp":"4970ca4fef01","stateId":693,"easy":"إذا أديت الصلوات كما فُرضت لم تنقص منها استخفافاً ← لك عند الله عهد أن يدخلك الجنة","cause":"مَن أَدَّاهُنَّ كما افْتُرِضَ عليه لم يَنقُصْ مِن حَقِّهنَّ شَيئًا اسْتِخفافًا","result":"فإنَّ له عِنْدَ اللهِ عَهْدًا ألَّا يُعَذِّبَه","explicit":true,"star":true,"ref":"الأحاديث المختارة 8 / 354","srcLabel":"متفق عليه","text":["«امْتَرى رَجُلانِ مِن الأنْصارِ، فقالَ أحَدُهما: الوِتْرُ بَعْدَ العِشاءِ بمَنزِلةِ الفَريضةِ، فخَرَجا حتَّى أتَيا ابنَ مُحَيْريزٍ فذَكَرا له الَّذي امْتَرَيا فيه، فقالَ لهما ابنُ مُحَيْريزٍ: هي بمَنزِلةِ الفَريضةِ، فخَرَجا مِن عِنْدِه فلَقِيا عُبادةَ بنَ الصَّامِتِ فذَكَرا له الَّذي امْتَريا فيه والَّذي رَدَّ عليهما ابنُ مُحَيْريزٍ، فقالَ: أَشهَدُ لَسَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: (افْتَرَضَ اللهُ خَمْسَ صَلَواتٍ على خَلْقِه، ",["مَن أَدَّاهُنَّ كما افْتُرِضَ عليه لم يَنقُصْ مِن حَقِّهنَّ شَيئًا اسْتِخفافًا، ",1],["فإنَّ له عِنْدَ اللهِ عَهْدًا ألَّا يُعَذِّبَه، ",2],"ومَن انْتَقَصَ مِن حَقِّهنَّ شَيئًا اسْتِخْفافًا به فإنَّه يَلْقى اللهَ ولا عَهْدَ له؛ إن شاءَ عَذَّبَه، وإن شاءَ غَفَرَ له)، ولكنَّها سُنَّةٌ لا يَنْبَغي تَرْكُها»."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"U7lBfmtX"},{"id":"س-06641","fp":"532b63ebcc34","stateId":693,"easy":"إذا جئت بالصلوات لم تنتقص منها شيئاً ← يجعل الله لك يوم القيامة عهداً أن يدخلك الجنة","cause":"فمَن جاءَ بِهنَّ لم يَنْتَقِصْ مِنه شَيئًا اسْتِخْفافًا بحَقِّها","result":"فإنَّ اللهَ جاعِلٌ لهم يَوْمَ القِيامةِ عَهْدًا أن يُدخِلَه الجنَّةَ","explicit":true,"star":true,"similar":["س-06465","س-06629"],"ref":"الأحاديث المختارة 8 / 366","srcLabel":"متفق عليه","text":["«سألَ رَجُلٌ أبا مُحمَّدٍ -رَجُلًا مِن الأنْصارِ- عن الوِتْرِ، فقالَ: الوِتْرُ واجِبٌ كوُجوبِ الصَّلاةِ فأتى عُبادةَ فذَكَرَ ذلك له، فقالَ: كَذَبَ أبو مُحمَّدٍ، سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: (خَمْسُ صَلَواتٍ افْتَرَضَهنَّ اللهُ على عِبادِه، ",["فمَن جاءَ بِهنَّ لم يَنْتَقِصْ مِنه شَيئًا اسْتِخْفافًا بحَقِّها ",1],["فإنَّ اللهَ جاعِلٌ لهم يَوْمَ القِيامةِ عَهْدًا أن يُدخِلَه الجنَّةَ، ",2],"ومَن جاءَ بِهنَّ قد انْتَقَصَ مِنه شَيئًا اسْتِخْفافًا بحَقِّهنَّ لم يكنْ له عِنْدَ اللهِ عَهْدٌ؛ إن شاءَ عَذَّبَه، وإن شاءَ غَفَرَ له»)."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"8iPRmKyK"},{"id":"س-04190","fp":"37a5f792865d","stateId":693,"easy":"إذا صليت البردين (الفجر والعصر) ← دخلت الجنة","cause":"مَن صَلَّى البَردَينِ","result":"دَخَلَ الجَنَّةَ","explicit":true,"star":true,"ref":"صحيح البخاري 574","srcLabel":"مسلم","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: ",["مَن صَلَّى البَردَينِ ",1],["دَخَلَ الجَنَّةَ",2],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (635)","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"iMRMNM3G","merged":2,"otherRefs":["تخريج مشكل الآثار 998 (صحيح)"]},{"id":"س-06465","fp":"4257864c270b","stateId":693,"easy":"إذا جئت بالصلوات لم تضيع منهن شيئاً ← كان لك عند الله عهد أن يدخلك الجنة","cause":"فمَن جاءَ بهنَّ لم يُضيِّعْ مِنهنَّ شَيئًا اسْتِخْفافًا بحَقِّهنَّ","result":"كانَ له عنْدَ اللهِ عَهْدٌ أن يُدخِلَه الجَنَّةَ","explicit":true,"repOf":"س-06641","ref":"تخريج مشكل الآثار 3172","text":["عَنِ ابْنِ مُحَيْرِيزٍ، ذكَرَ رَجلٌ من أصحابِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يُقالُ له: أبو مُحمَّدٍ الوِترَ، فقال: إنَّه واجبٌ، فذكَرْتُ ذلك لعُبادةَ بنِ الصامِتِ، فقال: كذَبَ أبو محمَّدٍ، سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: خَمسُ صَلَواتٍ........ ثم ذكر بقية الحديث على مثل ما في حديثي مالك والليث [أي حديث: أنَّ رَجُلًا مِن بَني كِنانةَ يُدْعى المُخْدَجيَّ، سَمِعَ رَجُلًا بالشَّامِ يُدْعى أبا مُحمَّدٍ، يقولُ: إنَّ الوِتْرَ واجِبٌ، قالَ المُخْدَجيُّ: فرُحْتُ إلى عُبادةَ بنِ الصَّامِتِ، فاعتَرَضْتُه وهو رائحٌ إلى المسجِدِ، ، فأَخبَرْتُه، فأخبَرْتُه بالذي قال أبو محمَّدٍ فقالَ عُبادةُ: كَذَبَ أبو مُحمَّدٍ، سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: خَمْسُ صَلَواتٍ كَتَبَهنَّ اللهُ على العِبادِ، ",["فمَن جاءَ بهنَّ لم يُضيِّعْ مِنهنَّ شَيئًا اسْتِخْفافًا بحَقِّهنَّ ",1],["كانَ له عنْدَ اللهِ عَهْدٌ أن يُدخِلَه الجَنَّةَ، ",2],"ومَن لم يَأتِ بِهنَّ فليس له عنْدَ اللهِ عَهْدٌ، إن شاءَ عَذَّبَه، وإن شاءَ أَدخَلَه الجَنَّةَ]"],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (3172) واللفظ له، وأبو داود (1420)، والنسائي (461)، والبيهقي (2257) باختلاف يسير تاما.","bab":"صلاة › فرض الصلاة","dorar":"kQFSxhUM","merged":4,"otherRefs":["تخريج كتاب السنة 967 (صحيح)","صحيح ابن حبان 1732 (صحيح)","تخريج المسند لشعيب 22693 (صحيح)"]},{"id":"س-06629","fp":"fff2f1e9d8bc","stateId":693,"easy":"إذا جئت بالصلوات يوم القيامة لم تضيع منها شيئاً ← يدخلك الله بها الجنة","cause":"مَن جاءَهُنَّ يومَ القيامةِ لم يُضيِّعْ منهُنَّ شيئًا استِخفافًا بحَقِّهِنَّ لَقِيَه وله عليه عهدٌ","result":"يُدخِلُه به الجَنَّةَ","explicit":true,"repOf":"س-06641","ref":"تخريج مشكل الآثار 3171","text":["[عن عبد الله بن محيريز] أنَّ رَجلًا تَمارى هو ورَجلٌ منَ الأنصارِ يُقالُ له: أبو محمَّدٍ في الوِترِ، فقال أبو محمَّدٍ: هو بمَنزِلةِ الصَّلاةِ، وقال الرَّجلُ الآخَرُ: منَ السُّنَّةِ لا يَنْبَغي تَركُها، وليس بمَنزِلةِ الفَريضةِ، قال: فسأَلْتُ عن ذلك عُبادةَ بنَ الصامِتِ الأنصاريَّ، وأخبَرْتُه بما قُلْنا كِلانا، قال: وكان رَجلًا فيه حِدَّةٌ، فقال: كذَبَ أبو محمَّدٍ مِرارًا، قال لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّ اللهَ افتَرَضَ على عِبادِه خَمسَ صَلَواتٍ، ",["مَن جاءَهُنَّ يومَ القيامةِ لم يُضيِّعْ منهُنَّ شيئًا استِخفافًا بحَقِّهِنَّ لَقِيَه وله عليه عهدٌ ",1],["يُدخِلُه به الجَنَّةَ، ",2],"ومَن أضاعَ منهُنَّ شيئًا لَقِيَه ولا عهدَ له عنده، إنْ شاءَ عذَّبَه، وإنْ شاءَ أدخَلَه الجَنَّةَ."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (3171) واللفظ له، وأبو داود (425)، والنسائي (461)، ومالك (400/123) بنحوه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"blw9Ss5A","merged":3,"otherRefs":["تخريج المسند لشعيب 22720 (صحيح)","تخريج المسند لشعيب 22752 (صحيح)"]},{"id":"س-06486","fp":"e46c056f7354","stateId":693,"easy":"إذا علمت أن الصلاة حق مكتوب واجب ← تدخل الجنة","cause":"مَن علِمَ أنَّ الصَّلاةَ حقٌّ مَكْتوبٌ واجبٌ","result":"دخلَ الجنَّةَ","explicit":true,"ref":"الترغيب والترهيب 1/191","srcLabel":"أحمد","text":[["مَن علِمَ أنَّ الصَّلاةَ حقٌّ مَكْتوبٌ واجبٌ ",1],["دخلَ الجنَّةَ",2]],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه عبدالله بن أحمد في ((زوائد المسند)) (423)، والبزار (440)، وابن خزيمة في ((التوحيد)) (74) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"Z1IhDKfU","merged":2,"otherRefs":["الجامع الصغير 8840 (صحيح)"]},{"id":"س-06491","fp":"358a09757d74","stateId":693,"easy":"إذا وافيت الصلوات بوضوئهن ومواقيتهن وسجودهن ← فلك عند الله عهد أن يدخلك الجنة","cause":"مَنْ وافَّاهُنَّ على وُ ضُوئِهِنَّ ، و مَوَاقِيتِهنَّ ، و سُجُودِهنَّ","result":"فإنَّ لهُ بِهنَّ عِندي عَهْدًا أنْ أُدْخِلهُ بِهنَّ الجنةَ","explicit":true,"ref":"السلسلة الصحيحة 842","srcLabel":"الطيالسي","text":["أتاني جبريلُ عليهِ السلامُ من عِنْدِ اللهِ تَبارَكَ و تَعالَى ، فقال : يا محمدُ إنَّ اللهَ عزَّ وجلَّ قال لكَ : إنِّي قد فَرَضْتُ على أمتِكَ خمسَ صَلَوَاتٍ ، ",["مَنْ وافَّاهُنَّ على وُ ضُوئِهِنَّ ، و مَوَاقِيتِهنَّ ، و سُجُودِهنَّ ، ",1],["فإنَّ لهُ بِهنَّ عِندي عَهْدًا أنْ أُدْخِلهُ بِهنَّ الجنةَ",2]," ، و مَنْ لَقِيَنِي قَدِ أنقَصَ من ذلكَ شيئًا أوْ كَلِمَةً تُشْبِهُها فَليسَ لهُ عِندي عهدٌ ، إنْ شِئْتُ عَذَّبْتُهُ و إنْ شِئْتُ رَحِمْتُهُ"],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرجه الطيالسي (574)، وأبو نعيم في ((حلية الأولياء)) (5/126)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"THi352nu","merged":2,"otherRefs":["الأحاديث المختارة 8 / 305 (صحيح)"]},{"id":"س-03029","fp":"da30e3580b26","stateId":693,"easy":"إذا صليت الصلاة لوقتها وأقمت حدها ← لك على الله عهد أن يدخلك الجنة","cause":"مَن صلَّى الصَّلاةَ لِوَقتِها، وأقام حَدَّها","result":"كان له به على اللهِ عَهدٌ إذا جاءه؛ الجنَّةُ","explicit":true,"similar":["س-06625","س-06611","س-07409"],"ref":"تخريج مشكل الآثار 3174","srcLabel":"أحمد","text":["خرَجَ إلينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ذاتَ يومٍ ونحن في المسجِدِ، ثُم ذكَرَ مِثلَه. [أي: حَديثَ: خرج علينا رَسولُ الله صلَّى اللهُ عليه وسلَّم ونحن في المسجِدِ سَبعةٌ؛ مِنَّا ثلاثةٌ مِن عَرَبِنا، وأربعةٌ مِن مَوالينا، فقال: ما يُجلِسُكم هنا؟ قلنا: الصَّلاةُ. قال: فنَكَتَ بأُصبُعِه في الأرضِ ثمَّ نَكَسَ ساعةً، ثمَّ رفَعَ إلينا رأسَه فقال: تدرونَ ما يقولُ رَبُّكم؟ قُلْنا: اللهُ ورسولُه أعلَمُ. قال: إنَّه يقولُ: ",["مَن صلَّى الصَّلاةَ لِوَقتِها، وأقام حَدَّها؛ ",1],["كان له به على اللهِ عَهدٌ إذا جاءه؛ الجنَّةُ، ",2],"ومَن لم يُقِمِ الصَّلاةَ لِوَقتِها، ولم يُقِمْ حَدَّها، لم يكُنْ له به عندي عَهدٌ؛ إن شِئتُ أدخَلْتُه النَّارَ، وإن شِئتُ أدخَلْتُه الجنَّةَ]"],"grade":"صحيح","narrator":"كعب","muhaddith":"إسناده صحيح على شرط الشيخين.","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (3173) بلفظه، وأحمد (18132)، والدارمي (1262)، والطبراني (19/ 143) (314) جميعا بنحوه.","bab":"إيمان › الوعيد","dorar":"iugaM2VX"},{"id":"س-06492","fp":"5a6aab74819b","stateId":693,"easy":"إذا حافظت على الصلوات لوقتهن ← يدخلك الله الجنة","cause":"مَنْ حافَظَ عليهِنَّ لِوَقْتِهنَّ","result":"أَدْخَلْتُهُ الجنةَ","explicit":true,"similar":["س-06557","س-06567"],"ref":"السلسلة الصحيحة 4033","srcLabel":"أبو داود","text":["قال اللهُ عزَّ وجلَّ : افْتَرَضْتُ على أمتِكَ خمسَ صَلَوَاتٍ ، وعهدْتُ عِندي عَهْدًا : أنَّهُ ",["مَنْ حافَظَ عليهِنَّ لِوَقْتِهنَّ",1]," ؛ ",["أَدْخَلْتُهُ الجنةَ",2]," ، ومَنْ لمْ يُحافِظْ عليهِنَّ ؛ فلا عَهْدَ لهُ عِندي ."],"grade":"صحيح","narrator":"أبو قتادة الحارث بن ربعي","muhaddith":"ثابت","takhrij":"أخرجه أبو داود (430)، وابن ماجه (1403) واللفظ له","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"F3YeisD9"},{"id":"س-06557","fp":"eba18dc3f9c0","stateId":693,"easy":"إذا حافظت على الصلوات ← كان لك عهد عند الله أن يدخلك الجنة","cause":"من حافظ عليهنَّ","result":"كان له عهدٌ عند اللهِ أن يُدْخِلَه الجنةَ","explicit":true,"repOf":"س-06492","otherNeedIds":[11],"ref":"حكم تارك الصلاة 46","text":["خمسُ صلواتٍ كتبهنَّ اللهُ على العبادِ في اليومِ والليلةِ ، ",["من حافظ عليهنَّ : ",1],["كان له عهدٌ عند اللهِ أن يُدْخِلَه الجنةَ",2]," ، ومن لم يحافظ عليهنَّ : لم يكن له عهدٌ عند اللهِ ، إن شاء عذَّبَه ، وإن شاء غفرَ له"],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (425)، والنسائي (461)، وابن ماجه (1401)، وأحمد (22756) بنحوه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"7g4sE3mF"},{"id":"س-06567","fp":"12f27dc338a9","stateId":693,"easy":"إذا حافظت على الصلوات وعلمت أنهن حق من الله ← تدخل الجنة","cause":"من حافظ على الصلواتِ الخمسِ: ركوعِهن وسجودِهنَّ ومواقيتِهن، وعلم أنهنَّ حقٌّ من عندِ اللهِ","result":"دخل الجنَّةَ أو قال: وجبت له الجنةُ أو قال: حرُم على النارِ","explicit":true,"repOf":"س-06492","otherNeedIds":[66],"ref":"المتجر الرابح 43","text":[["من حافظ على الصلواتِ الخمسِ: ركوعِهن وسجودِهنَّ ومواقيتِهن، وعلم أنهنَّ حقٌّ من عندِ اللهِ – ",1],["دخل الجنَّةَ أو قال: وجبت له الجنةُ أو قال: حرُم على النارِ",2],"."],"grade":"صحيح","narrator":"حنظلة بن الربيع الكاتب الأسيدي","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (18345) واللفظ له مختصرا، وابن أبي شيبة في ((المسند)) (832)، والطبراني (4 / 12)(3494) بإختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"If6Ht9O1"},{"id":"س-06625","fp":"c7d0ef4999f3","stateId":693,"easy":"إذا صليت الصلاة لوقتها وحافظت عليها ← فلك على الله عهد أن يدخلك الجنة","cause":"مَن صَلَّى الصَّلاةَ لوَقتِها، وحافَظَ عليها، ولم يُضيِّعْها استِخفافًا بحَقِّها","result":"فله عليَّ عَهدٌ أنْ أُدخِلَه الجنَّةَ","explicit":true,"repOf":"س-03029","ref":"تخريج المسند لشعيب 18132","text":["بينما أنا جالسٌ في مسجدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، مُسنِدي ظُهورِنا إلى قِبلةِ مسجدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، سبعةُ رَهطٍ، أربعةٌ مِن مَوالينا، وثلاثةٌ مِن عَرَبِنا، إذ خَرَجَ إلينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ صَلاةَ الظُّهرِ، حتى انتَهى إلينا، فقال: ما يُجلِسُكم هاهنا؟ قُلْنا: يا رسولَ اللهِ، نَنتظِرُ الصَّلاةَ، قال: فأرَمَّ قليلًا، ثُمَّ رَفَعَ رأسَه، فقال: أتَدرون ما يقولُ ربُّكم عزَّ وجلَّ؟ قال: قُلْنا: اللهُ ورسولُه أعلمُ، قال: فإنَّ ربَّكم عزَّ وجلَّ يقولُ: ",["مَن صَلَّى الصَّلاةَ لوَقتِها، وحافَظَ عليها، ولم يُضيِّعْها استِخفافًا بحَقِّها",1],"؛ ",["فله عليَّ عَهدٌ أنْ أُدخِلَه الجنَّةَ، ",2],"ومَن لم يُصلِّها لوَقتِها، ولم يُحافِظْ عليها، وضَيَّعَها استِخفافًا بحَقِّها؛ فلا عَهدَ له، إنْ شِئتُ عَذَّبتُه، وإنْ شِئتُ غَفَرتُ له."],"grade":"صحيح","narrator":"كعب بن عجرة","muhaddith":"مرفوعه صحيح لغيره","takhrij":"أخرجه أحمد (18132) واللفظ له، والدارمي (1226)، والطبراني (19/142) (311)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"bpNDRbFU"},{"id":"س-06169","fp":"cdc796aa084a","stateId":693,"easy":"إذا حافظت على الصلوات بوضوئهن وركوعهن وسجودهن وصمت وحججت وأديت الزكاة والأمانة ← تدخل الجنة","cause":"مَنْ حافَظَ على الصلواتِ الخمسِ ، على وُضُوئِهِنَّ ، ورُكُوعِهِنَّ وسُجُودِهنَّ ، و مَوَاقِيتِهنَّ ، و صامَ رمضانَ ، و حجَّ البيتَ إن استطاعَ إليهِ سبيلًا ، و آتَى الزكاةَ طَيِّبَةً بِها نفسُهُ ، وآتَى الأَمانَةَ قيل : يا رسولَ اللهِ ! و ما أَدَاءُ الأَمانَةِ ؟ قال : الغُسْلُ مِنَ الجَنابَةِ","result":"خَمْسٌ مَنْ جاء بِهنَّ مع إِيمانٍ دخلَ الجنةَ","explicit":true,"ref":"صحيح الترغيب 369","srcLabel":"أبو داود","text":[["خَمْسٌ مَنْ جاء بِهنَّ مع إِيمانٍ دخلَ الجنةَ ",2],":",[" مَنْ حافَظَ على الصلواتِ الخمسِ ، على وُضُوئِهِنَّ ، ورُكُوعِهِنَّ وسُجُودِهنَّ ، و مَوَاقِيتِهنَّ ، و صامَ رمضانَ ، و حجَّ البيتَ إن استطاعَ إليهِ سبيلًا ، و آتَى الزكاةَ طَيِّبَةً بِها نفسُهُ ، وآتَى الأَمانَةَ قيل : يا رسولَ اللهِ ! و ما أَدَاءُ الأَمانَةِ ؟ قال : الغُسْلُ مِنَ الجَنابَةِ",1]," ، إِنَّ الله لمْ يأمن ابنَ آدمَ على شيءٍ من دِينِهِ غيرَها"],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"حسن","takhrij":"أخرجه أبو داود (429)، والطبراني في ((الصغير)) (772)، وابن الأعرابي في ((معجمه)) (130) واللفظ لهم.","bab":"زكاة › فرض الزكاة","dorar":"hQauuRCl"},{"id":"س-06501","fp":"9108ebdbaff6","stateId":693,"easy":"إذا صليت الخمس واجتنبت الكبائر ← تدخل من أي أبواب الجنة شئت","cause":"من صلَّى الصلواتِ الخمسِ واجتنبَ الكبائرَ","result":"دخلَ من أيِّ أبوابِ الجنةِ شاءَ","explicit":true,"ref":"السلسلة الصحيحة 7/1332","srcLabel":"الطبراني","text":["صعدَ رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ المنبرَ فقال لا أُقْسِمُ لا أُقْسِمُ لا أُقْسِمُ ثم نزلَ فقال أَبشروا أَبشروا إنهُ ",["من صلَّى الصلواتِ الخمسِ واجتنبَ الكبائرَ",1]," ",["دخلَ من أيِّ أبوابِ الجنةِ شاءَ",2]," قال المُطَّلِبُ سمعتُ رجلًا يَسألُ عبدَ اللهِ بنَ عمرٍو أسمعتَ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يذكرهُنَّ قال نعم عقوقُ الوالديْنِ والشِّرْكُ باللهِ وقتلُ النفسِ وقذفُ المحصناتِ وأكلُ مالِ اليتيمِ والفرارُ من الزَّحفِ وأكْلُ الرِّبَا"],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"إسناده حسن إن شاء الله تعالى","takhrij":"أخرجه ابن المنذر في ((التفسير)) (1654)، والفاكهي في ((الفوائد)) (137)، والطبراني (14/6) (14587) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"pRT2HfjG"},{"id":"س-06507","fp":"d3b941108b57","stateId":693,"easy":"إذا صليت قبل طلوع الشمس وقبل غروبها وشهدت أن لا إله إلا الله ← تدخل الجنة","cause":"مَن صلَّى قبلَ طلوعِ الشَّمسِ وقبلَ غروبِها وشهِد أن لا إلهَ إلَّا اللهُ","result":"دخَل الجنَّةَ","explicit":true,"ref":"مجمع الزوائد 1/323","srcLabel":"مجمع الزوائد","text":[["مَن صلَّى قبلَ طلوعِ الشَّمسِ وقبلَ غروبِها وشهِد أن لا إلهَ إلَّا اللهُ ",1],["دخَل الجنَّةَ",2]],"grade":"حسن","narrator":"عمارة بن رويبة","muhaddith":"رجاله موثقون","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"SiYyqHMy"},{"id":"س-06517","fp":"8f35fd0e726c","stateId":693,"easy":"إذا صليت ← فالصلاة مفتاح الجنة","cause":"الصلاةُ","result":"مفتاحُ الجنةِ","explicit":true,"ref":"الجامع الصغير 8173","srcLabel":"الترمذي","text":[["مفتاحُ الجنةِ",2]," ",["الصلاةُ",1],"،  و مفتاحُ الصلاةِ الطهورُ"],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"حسن","takhrij":"أخرجه أحمد (14662)، وابن عدي في ((الكامل في الضعفاء)) (3/ 257) كلاهما بلفظه، وأخرجه الترمذي (4)،والطبراني في ((المعجم الأوسط))  (4364)،  والبيهقي في ((شعب الإيمان)) (2456) جميعًا بلفظ: ((الوضوء))","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"ti5bs6U7"},{"id":"س-06611","fp":"8454f6ba46eb","stateId":693,"easy":"إذا صليت الصلاة لوقتها وحافظت عليها ← فلك على الله عهد أن يدخلك الجنة","cause":"من صلَّى الصلاةَ لوقتِها ، و حافظَ عليها و لم يُضيِّعْها استخفافًا بحقِّها","result":"فله عليَّ عهدٌ أن أُدخِلَه الجنَّةَ و من لم يُصَلِّها لوقتِها ، ولم يحافِظْ عليها ، و ضيَّعها استخفافًا بحقِّها ، فلا عهدَ له عليَّ ، إن شئتُ عذَّبتُه","explicit":true,"repOf":"س-03029","ref":"صحيح الترغيب 401","text":["خرج علينا رسولُ اللهِ و نحن سبعةُ نفَرٍ ، أربعةٌ من موالِينا ، و ثلاثةٌ من عَرَبِنا ، مُسنِدي ظهورِنا إلى مسجدِه ، فقال : ما أَجلَسَكم ؟ قلنا : جلَسْنا ننتظرُ الصلاةَ ، قال : فأَرَمَّ قليلًا ، ثم أقبَلَ علينا فقال : هل تدرون ما يقولُ ربُّكم ؟ قلنا : لا قال : فإنَّ ربَّكم يقول : ",["من صلَّى الصلاةَ لوقتِها ، و حافظَ عليها و لم يُضيِّعْها استخفافًا بحقِّها ، ",1],["فله عليَّ عهدٌ أن أُدخِلَه الجنَّةَ و من لم يُصَلِّها لوقتِها ، ولم يحافِظْ عليها ، و ضيَّعها استخفافًا بحقِّها ، فلا عهدَ له عليَّ ، إن شئتُ عذَّبتُه ،",2]," و إن شئتُ غفرتُ له"],"grade":"حسن","narrator":"كعب بن عجرة","muhaddith":"حسن لغيره","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (19/ 142) (311) واللفظ له، وأحمد (18132)، وابن أبي شيبة في ((مسنده)) (512)،  بنحوه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"d1uRYWmT"},{"id":"س-07409","fp":"bab4b759c16f","stateId":693,"easy":"إذا صليت الصلاة لوقتها ← يدخلك الله الجنة، ومن صلاها بغير وقتها فأمره إلى الله","cause":"لا يصلِّيها أحدٌ لوقتِها","result":"إلَّا أدخلتُهُ الجنَّةَ ، ومن صلَّاها بغيرِ وقتِها إن شئتُ رَحِمْتُهُ وإن شئتُ عذَّبتُهُ","explicit":true,"repOf":"س-03029","ref":"الترغيب والترهيب 1/198","text":["أنَّ النَّبيَّ - صلَّى اللَّهُ عليهِ وسلَّمَ - مرَّ على أصحابِهِ يومًا فقالَ لَهُم : هل تَدرونَ ما يقولُ ربُّكم - تبارَكَ وتعالى ؟ قالوا : اللَّهُ ورسولُهُ أعلَمُ . قالَها ثلاثًا . قالَ : وعزَّتي وجلالي ",["لا يصلِّيها أحدٌ لوقتِها",1]," ",["إلَّا أدخلتُهُ الجنَّةَ ، ومن صلَّاها بغيرِ وقتِها إن شئتُ رَحِمْتُهُ وإن شئتُ عذَّبتُهُ",2]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"إسناده حسن إن شاء الله تبارك وتعالى","takhrij":"أخرجه الشاشي في ((المسند)) (861)، والطبراني (10/281) (10555)، والبيهقي في ((الأسماء والصفات)) (266) باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"PTUquCqb"},{"id":"س-06488","fp":"929244da5019","stateId":693,"easy":"إذا صليت على مواقيتها وبررت والديك ← فهي أقرب الأعمال إلى الجنة","cause":"الصَّلاةُ على مَواقيتِها، قُلتُ: وماذا يا نَبيَّ اللهِ؟ قال: برُّ الوالِدَينِ. قُلتُ: وماذا يا نَبيَّ اللهِ؟ قال: الجِهادُ في سَبيلِ اللهِ","result":"أيُّ الأعمالِ أقرَبُ إلى الجَنَّةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح مسلم 85","srcLabel":"البخاري","text":["يا نَبيَّ اللهِ، ",["أيُّ الأعمالِ أقرَبُ إلى الجَنَّةِ",2],"؟ قال: ",["الصَّلاةُ على مَواقيتِها، قُلتُ: وماذا يا نَبيَّ اللهِ؟ قال: برُّ الوالِدَينِ. قُلتُ: وماذا يا نَبيَّ اللهِ؟ قال: الجِهادُ في سَبيلِ اللهِ",1],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2782) باختلاف يسير","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"M5g9szCB"},{"id":"س-01478","fp":"2636d9e9083b","stateId":694,"easy":"إذا صليت لله كل يوم اثنتي عشرة ركعة تطوعاً ← يبني الله لك بيتاً في الجنة","cause":"ما مِن عَبدٍ مُسلِمٍ يُصَلِّي للَّهِ كُلَّ يَومٍ ثِنتَي عَشرةَ رَكعةً تَطَوُّعًا، غيرَ فريضةٍ","result":"إلَّا بَنى اللهُ له بَيتًا في الجَنَّةِ، أو إلَّا بُنيَ له بَيتٌ في الجَنَّةِ","explicit":true,"star":true,"apply":{"k":"count","t":"اثنتي عشرة ركعة"},"similar":["س-03712","س-00752","س-02856","س-02904","س-05842"],"ref":"صحيح مسلم 728","srcLabel":"متفق عليه","text":[["ما مِن عَبدٍ مُسلِمٍ يُصَلِّي للَّهِ كُلَّ يَومٍ ثِنتَي عَشرةَ رَكعةً تَطَوُّعًا، غيرَ فريضةٍ،",1]," ",["إلَّا بَنى اللهُ له بَيتًا في الجَنَّةِ، أو إلَّا بُنيَ له بَيتٌ في الجَنَّةِ",2],"، قالت أمُّ حَبيبةَ: فما بَرِحتُ أُصَلِّيهنَّ بَعدُ. وقال عَمرٌو: ما بَرِحتُ أُصَلِّيهنَّ بَعدُ، وقال النُّعمانُ مِثلَ ذلك. [وفي روايةٍ]: ما مِن عَبدٍ مُسلِمٍ تَوضَّأ، فأسبَغَ الوُضوءَ، ثُمَّ صَلَّى للَّهِ كُلَّ يَومٍ، فذَكَرَ بمِثلِه."],"grade":"صحيح","narrator":"أم حبيبة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"وضوء › فضل الوضوء","dorar":"UySKEpkY","merged":9,"otherRefs":["صحيح النسائي 1795 (صحيح)","تخريج صحيح ابن حبان 2451 (صحيح)","صحيح النسائي 1804 (صحيح)","صحيح النسائي 1805 (صحيح)","صحيح النسائي 1807 (صحيح)","مجموع الفتاوى 22/281 (صحيح)","تخريج المسند لشعيب 19709 (صحيح)","صحيح ابن خزيمة 2/ 349 (صحيح)"]},{"id":"س-03712","fp":"fab8fd8584ba","stateId":694,"easy":"إذا صليت اثنتي عشرة ركعة في يوم وليلة ← يُبنى لك بهن بيت في الجنة","cause":"مَن صَلَّى اثنَتَي عَشرةَ رَكعةً في يَومٍ ولَيلةٍ","result":"بُنيَ له بهنَّ بَيتٌ في الجَنَّةِ","explicit":true,"apply":{"k":"count","t":"اثنتي عشرة ركعة"},"repOf":"س-01478","ref":"صحيح مسلم 728","text":[["مَن صَلَّى اثنَتَي عَشرةَ رَكعةً في يَومٍ ولَيلةٍ ",1],["بُنيَ له بهنَّ بَيتٌ في الجَنَّةِ",2],"، قالت أُمُّ حَبيبةَ: فما تَرَكتُهنَّ مُنذُ سَمِعتُهنَّ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم. وقال عَنبَسةُ: فما تَرَكتُهنَّ مُنذُ سَمِعتُهنَّ مِن أُمِّ حَبيبةَ، وقال عَمرو بنُ أوسٍ: ما تَرَكتُهنَّ مُنذُ سَمِعتُهنَّ مِن عَنبَسةَ، وقال النُّعمانُ بنُ سالِمٍ: ما تَرَكتُهنَّ مُنذُ سَمِعتُهنَّ مِن عَمرِو بنِ أوسٍ."],"grade":"صحيح","narrator":"أم حبيبة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"اعتصام بالسنة › لزوم السنة","dorar":"USL4fBoD"},{"id":"س-04077","fp":"230c8cbed815","stateId":694,"easy":"إذا قرأت آية السجدة فسجدت ← يبكي الشيطان ويقول: أُمر ابن آدم بالسجود فسجد فله الجنة","cause":"إذا قَرَأ ابنُ آدَمَ السَّجدةَ فسَجَدَ اعتَزَلَ الشَّيطانُ يَبكي، يقولُ: يا ويلَه","result":"فلَه الجَنَّةُ، وأُمِرتُ بالسُّجودِ فأبَيتُ فليَ النَّارُ","explicit":true,"star":true,"ref":"صحيح مسلم 81","srcLabel":"متفق عليه","text":[["إذا قَرَأ ابنُ آدَمَ السَّجدةَ فسَجَدَ اعتَزَلَ الشَّيطانُ يَبكي، يقولُ: يا ويلَه،",1]," وفي رِوايةِ أبي كُرَيبٍ: يا ويلي، أُمِرَ ابنُ آدَمَ بالسُّجودِ فسَجَدَ ",["فلَه الجَنَّةُ، وأُمِرتُ بالسُّجودِ فأبَيتُ فليَ النَّارُ",2],". وفي روايةٍ: فعَصَيتُ فليَ النَّارُ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"جن › صفة إبليس وجنوده","dorar":"TuJWUD4E"},{"id":"س-00752","fp":"08043cdad115","stateId":694,"easy":"إذا صليت اثنتي عشرة ركعة في اليوم والليلة سوى المكتوبة ← يبني الله لك بيتاً في الجنة","cause":"مَن ركعَ اثنتَيْ عشرةَ ركعةً ، في اليَومِ واللَّيلةِ","result":"سِوَى المكتوبةِ ، بنَى اللهُ عزَّ وجلَّ ، لهُ بَيتًا في الجنَّةِ","explicit":true,"apply":{"k":"count","t":"اثنتي عشرة ركعة"},"repOf":"س-01478","ref":"صحيح النسائي 1796","text":[["مَن ركعَ اثنتَيْ عشرةَ ركعةً ، في اليَومِ واللَّيلةِ ، ",1],["سِوَى المكتوبةِ ، بنَى اللهُ عزَّ وجلَّ ، لهُ بَيتًا في الجنَّةِ",2]],"grade":"صحيح","narrator":"أم حبيبة أم المؤمنين","muhaddith":"صحيح [لغيره]","takhrij":"أخرجه مسلم (728)، وأبو داود (1250)، والترمذي (415)، والنسائي (1797) واللفظ له، وابن ماجه (1141)، وأحمد (26769)","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"JWhBkjTY"},{"id":"س-02856","fp":"c8ff57ea1e4f","stateId":694,"easy":"إذا صليت اثنتي عشرة ركعة في النهار أو الليل ← يبني الله لك بيتاً في الجنة","cause":"مَنْ صلَّى ثِنتي عشرةَ ركعةً بالنَّهارِ ، أو بالليلِ ، بنى اللهُ عزَّ وجلَّ","result":"له بيتًا في الجنَّةِ","explicit":true,"apply":{"k":"count","t":"اثنتي عشرة ركعة"},"repOf":"س-01478","ref":"صحيح النسائي 1798","text":[["مَنْ صلَّى ثِنتي عشرةَ ركعةً بالنَّهارِ ، أو بالليلِ ، بنى اللهُ عزَّ وجلَّ ، ",1],["له بيتًا في الجنَّةِ",2]],"grade":"صحيح","narrator":"أم حبيبة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (1799) واللفظ له، وأخرجه مسلم (728) باختلاف يسير","bab":"إيمان › الوعد","dorar":"9wZB8LxW"},{"id":"س-08367","fp":"3354ab4f15e1","stateId":694,"easy":"إذا صليت بعد كل طهور ← تسمع خشخشتك في الجنة (من قصة بلال)","cause":"لا أتَطَهَّرُ طُهورًا تامًّا في ساعةٍ مِن لَيلٍ ولا نَهارٍ، إلَّا صَلَّيتُ بذلك الطُّهورِ","result":"فإنِّي سَمِعتُ اللَّيلةَ خَشفَ نَعلَيكَ بينَ يَدَيَّ في الجَنَّةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[47],"ref":"صحيح مسلم 2458","srcLabel":"متفق عليه","text":["قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم لبِلالٍ عِندَ صَلاةِ الغَداةِ: يا بلالُ حَدِّثني بأرجى عَمَلٍ عَمِلتَه عِندَكَ في الإسلامِ مَنفَعةً؛ ",["فإنِّي سَمِعتُ اللَّيلةَ خَشفَ نَعلَيكَ بينَ يَدَيَّ في الجَنَّةِ",2],"، قال بلالٌ: ما عَمِلتُ عَمَلًا في الإسلامِ أرجى عِندي مَنفَعةً مِن أنِّي ",["لا أتَطَهَّرُ طُهورًا تامًّا في ساعةٍ مِن لَيلٍ ولا نَهارٍ، إلَّا صَلَّيتُ بذلك الطُّهورِ",1]," ما كَتَبَ اللهُ لي أن أُصَلِّيَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1149)، ومسلم (2458) واللفظ له","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"ItBWY72K","merged":3,"otherRefs":["صحيح ابن خزيمة 2/ 368 (صحيح)","تخريج صحيح ابن حبان 7085 (صحيح)"]},{"id":"ق-0978","fp":"c7d767a82c10","stateId":694,"easy":"السجود والتسبيح وترك الاستكبار وقيام الليل والدعاء خوفاً وطمعاً والإنفاق ← ما أُخفي لهم من قرة أعين","cause":"السجود والتسبيح وترك الاستكبار وقيام الليل والدعاء خوفاً وطمعاً والإنفاق","result":"ما أُخفي لهم من قرة أعين","explicit":true,"apply":{"k":"time","t":"في السجود، في الليل"},"otherNeedIds":[68,5],"ref":"سورة السجدة: 15–17","srcLabel":"القرآن الكريم","quran":{"s":32,"from":15,"to":17,"text":"إِنَّمَا يُؤْمِنُ بِآيَاتِنَا الَّذِينَ إِذَا ذُكِّرُوا بِهَا خَرُّوا سُجَّدًا وَسَبَّحُوا بِحَمْدِ رَبِّهِمْ وَهُمْ لَا يَسْتَكْبِرُونَ (15) تَتَجَافَى جُنُوبُهُمْ عَنِ الْمَضَاجِعِ يَدْعُونَ رَبَّهُمْ خَوْفًا وَطَمَعًا وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ (16) فَلَا تَعْلَمُ نَفْسٌ مَا أُخْفِيَ لَهُمْ مِنْ قُرَّةِ أَعْيُنٍ جَزَاءً بِمَا كَانُوا يَعْمَلُونَ (17)","hl":[[0,358,1]]}},{"id":"ق-1258","fp":"e514c5d84c1a","stateId":694,"easy":"الإحسان: قلة الهجوع بالليل والاستغفار بالأسحار وحق السائل والمحروم في المال ← جنات وعيون","cause":"الإحسان: قلة الهجوع بالليل والاستغفار بالأسحار وحق السائل والمحروم في المال","result":"جنات وعيون","explicit":true,"ref":"سورة الذاريات: 15–19","srcLabel":"القرآن الكريم","quran":{"s":51,"from":15,"to":19,"text":"إِنَّ الْمُتَّقِينَ فِي جَنَّاتٍ وَعُيُونٍ (15) آخِذِينَ مَا آتَاهُمْ رَبُّهُمْ إِنَّهُمْ كَانُوا قَبْلَ ذَلِكَ مُحْسِنِينَ (16) كَانُوا قَلِيلًا مِنَ اللَّيْلِ مَا يَهْجَعُونَ (17) وَبِالْأَسْحَارِ هُمْ يَسْتَغْفِرُونَ (18) وَفِي أَمْوَالِهِمْ حَقٌّ لِلسَّائِلِ وَالْمَحْرُومِ (19)","hl":[[0,277,1]]}},{"id":"س-01459","fp":"81923cec2393","stateId":694,"easy":"إذا قمت في ليلة باردة من فراشك فتوضأت وصليت ← توجب لك الجنة","cause":"رجلٌ قام في ليلةٍ باردةٍ من فراشِه فتوضَّأ ثمَّ قام إلى الصَّلاةِ","result":"كلُّها تُوجِبُ لأهلِها الجنَّةَ","explicit":true,"ref":"الإصابة في تمييز الصحابة 3/24","srcLabel":"ابن سعد","text":["عن أبي تميمةَ الهُجَيميِّ : أتيتُ الشَّامَ فإذا أنا برجلٍ مجتمَعٌ عليه فإذا هو مجدودُ الأصابعِ ، قلتُ : من هذا ؟ قالوا : هذا أفقهُ من بقي على الأرضِ من أصحابِ رسولِ اللهِ صلَّى اللهُ عليه وآلِه وسلَّم ، هذا عمرُو البُكاليُّ ، قلتُ : فما شأنُ أصابعِه ؟ قالوا : أُصِيبت يومَ اليُرموكِ ، قال : فسمِعتُه يقولُ : يا أيُّها النَّاسُ اعملوا وأبشِروا فإنَّ فيكم ثلاثةَ أعمالٍ ",["كلُّها تُوجِبُ لأهلِها الجنَّةَ",2]," : ",["رجلٌ قام في ليلةٍ باردةٍ من فراشِه فتوضَّأ ثمَّ قام إلى الصَّلاةِ",1]," ، فيقولُ اللهُ لملائكتِه ما حمل عبدي على ما صنع ؟"],"grade":"صحيح","narrator":"أبو تميمة الهجيمي","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن سعد في ((الطبقات الكبرى)) (7/ 295)، وابن عساكر (46/ 459) واللفظ لهما.","bab":"وضوء › فضل الوضوء","dorar":"P6luyTY7"},{"id":"س-02904","fp":"1b179d3c9534","stateId":694,"easy":"إذا صليت الضحى اثنتي عشرة ركعة ← يبني الله لك قصراً من ذهب في الجنة","cause":"مَن صلَّى الضُّحَى ثِنْتَيْ عشرَةَ ركعةً","result":"بَنَى اللهُ له قصرًا في الجنةِ من ذَهَبٍ","explicit":true,"apply":{"k":"count","t":"اثنتي عشرة ركعة · الوقت: الضحى"},"repOf":"س-01478","ref":"تحفة المحتاج 1/415","text":[["مَن صلَّى الضُّحَى ثِنْتَيْ عشرَةَ ركعةً ",1],["بَنَى اللهُ له قصرًا في الجنةِ من ذَهَبٍ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح أو حسن [كما اشترط على نفسه في المقدمة]","takhrij":"أخرجه الترمذي (473)، وابن ماجه (1380) باختلاف يسير.","bab":"إيمان › الوعد","dorar":"iDAyHqUX"},{"id":"س-04290","fp":"dc92f3d38945","stateId":694,"easy":"إذا ثابرت على اثنتي عشرة ركعة في اليوم والليلة ← تدخل الجنة","cause":"من ثابرَ على اثنتي عشرةَ رَكعةً في اليومِ واللَّيلةِ","result":"دخلَ الجنَّةَ أربعًا قبلَ الظُّهرِ ، ورَكعتينِ بعدَها ، ورَكعتينِ بعدَ المغربِ ، ورَكعتينِ بعدَ العشاءِ ، ورَكعتينِ قبلَ الفجرِ","explicit":true,"apply":{"k":"count","t":"اثنتي عشرة ركعة"},"ref":"صحيح النسائي 1793","srcLabel":"الترمذي","text":[["من ثابرَ على اثنتي عشرةَ رَكعةً في اليومِ واللَّيلةِ ",1],["دخلَ الجنَّةَ أربعًا قبلَ الظُّهرِ ، ورَكعتينِ بعدَها ، ورَكعتينِ بعدَ المغربِ ، ورَكعتينِ بعدَ العشاءِ ، ورَكعتينِ قبلَ الفجرِ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (414)، والنسائي (1794) واللفظ له، وابن ماجه (1140)","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"mNZqLEH4"},{"id":"س-05842","fp":"ab564928a561","stateId":694,"easy":"إذا صليت اثنتي عشرة ركعة ← يبني الله لك بيتاً في الجنة","cause":"اثْنَتَا عَشْرةَ رَكعةً مَن صلَّاهُنَّ","result":"بنى اللهُ له بَيتًا في الجنَّةِ","explicit":true,"apply":{"k":"count","t":"اثنتي عشرة ركعة"},"repOf":"س-01478","ref":"الأحكام الوسطى 2/69","text":[["اثْنَتَا عَشْرةَ رَكعةً مَن صلَّاهُنَّ",1]," ",["بنى اللهُ له بَيتًا في الجنَّةِ",2],": أربَعُ رَكَعاتٍ قَبْلَ الظُّهرِ، وركعَتَينِ بَعْدَ الظُّهرِ، وركعَتَينِ قَبْلَ العَصْرِ، وركعَتَينِ بَعْدَ المَغرِبِ، وركعَتَينِ قَبْلَ صَلاةِ الصُّبحِ"],"grade":"صحيح","narrator":"أم حبيبة","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه النسائي (1801) واللفظ له، وابن خزيمة في ((صحيحه)) (2/ 204)، وابن حبان (2452)، والحاكم في ((مستدركه)) (2/ 119) ثلاثتهم باختلاف يسير.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"ThfKhdtv"},{"id":"س-04225","fp":"4461ff979bfc","stateId":694,"easy":"إذا قمتِ الليل وصمتِ النهار ولم تؤذِ أحداً ← فأنتِ من أهل الجنة","cause":"ولا تُؤذي أحدًا","result":"هي من أهلِ الجنَّةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[41],"ref":"السلسلة الصحيحة 1/369","srcLabel":"أحمد","text":["قيل للنبيِّ صلَّى اللهُ عليهِ وسلَّمَ : يا رسولَ اللهِ إنَّ فلانةً تقومُ الليلَ وتصومُ النهارَ وتفعلُ وتصدَّقُ وتُؤذي جيرانَها بلسانِها فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ : لا خيرَ فيها هي من أهلِ النَّارِ قال : وفلانةٌ تُصلِّي المكتوبةَ وتصدّقُ بأثوارٍ من الأقِطِ ",["ولا تُؤذي أحدًا",1]," فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ : ",["هي من أهلِ الجنَّةِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (9675)، والبزار (9713)، وابن حبان (5764) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"dbvXsh4A","merged":5,"otherRefs":["صحيح الأدب المفرد 88 (صحيح)","صحيح الترغيب 2560 (صحيح)","المستدرك على الصحيحين 7510 (صحيح)","تخريج صحيح ابن حبان 5764 (صحيح)"]},{"id":"س-02862","fp":"940b74f35df4","stateId":694,"easy":"إذا صليت الضحى أربعاً وقبل الظهر أربعاً ← يُبنى لك بيت في الجنة","cause":"مَنْ صلَّى الضُّحَى أربعًا ، و قبلَ الأُولَى أربعًا","result":"بُنِيَ لهُ بَيتًا في الجنَّةِ","explicit":true,"apply":{"k":"time","t":"الضحى"},"ref":"السلسلة الصحيحة 2349","srcLabel":"الطبراني","text":[["مَنْ صلَّى الضُّحَى أربعًا ، و قبلَ الأُولَى أربعًا ، ",1],["بُنِيَ لهُ بَيتًا في الجنَّةِ",2]],"grade":"حسن","narrator":"أبو موسى الأشعري","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (4753)","bab":"إيمان › الوعد","dorar":"vHDt0uRj","merged":2,"otherRefs":["صحيح الجامع 6340 (حسن)"]},{"id":"س-08300","fp":"5b6ef2831f56","stateId":694,"easy":"إذا صليت ركعتين بعد كل أذان ووضوء ← تسبق إلى الجنة (من قصة بلال)","cause":"ما أَذَّنْتُ قَطُّ إلَّا صَلَّيْتُ رَكْعتَينِ، وما أَصابَني حَدَثٌ قَطُّ إلَّا تَوَضَّأْتُ عنْدَها، ورَأيْتُ أنَّ للهِ علَيَّ رَكْعتَينِ","result":"بِمَ سَبَقْتَني إلى الجَنَّةِ؟ فما دَخَلْتُ الجَنَّةَ قَطُّ إلَّا سَمِعْتُ خَشْخَشتَك أمامي","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"count","t":"ركعتين"},"otherNeedIds":[47],"ref":"الأحكام الوسطى 1/ 150","srcLabel":"الترمذي","text":["أَصبَحَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فدَعا بِلالًا فقالَ: \"يا بِلالُ، ",["بِمَ سَبَقْتَني إلى الجَنَّةِ؟ فما دَخَلْتُ الجَنَّةَ قَطُّ إلَّا سَمِعْتُ خَشْخَشتَك أمامي",2],"، دَخَلْتُ البارِحةَ الجَنَّةَ فسَمِعْتُ خَشْخَشتَك أمامي، فأَتَيْتُ على قَصْرٍ مُرَبَّعٍ مُشرِفٍ مِن ذَهَبٍ، فقُلْتُ: لِمَن هذا القَصْرُ؟ فقالوا: لرَجُلٍ عَرَبيٍّ، فقُلْتُ أنا عَرَبيٌّ، لِمَن هذا القَصْرُ؟ قالوا: لِرَجُلٍ مِن قُرَيشٍ، فقُلْتُ: أنا قُرَشيٌّ، لِمَن هذا القَصْرُ؟ فقالوا: لرَجُلٍ مِن أُمَّةِ مُحمَّدٍ، فقُلْتُ: أنا مُحمَّدٌ، لِمَن هذا القَصْرُ؟ قالوا: لعُمَرَ بنِ الخَطَّابِ\"، فقالَ بِلالٌ: يا رَسولَ اللهِ، ",["ما أَذَّنْتُ قَطُّ إلَّا صَلَّيْتُ رَكْعتَينِ، وما أَصابَني حَدَثٌ قَطُّ إلَّا تَوَضَّأْتُ عنْدَها، ورَأيْتُ أنَّ للهِ علَيَّ رَكْعتَينِ",1],"، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: \"بِهما\"."],"grade":"صحيح","narrator":"بريدة بن خصيب","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه الترمذي (3689)، وأحمد (22996)، وابن خزيمة (1209) واللفظ لهم","bab":"مناقب وفضائل › بعض من شهد النبي بأنهم من أهل الجنة","dorar":"P0T59rX9","merged":2,"otherRefs":["تخريج المسند لشعيب 22996 (صحيح)"]},{"id":"س-00805","fp":"5945fff24593","stateId":694,"easy":"إذا تجافى جنبك عن المضجع (قيام الليل) ← تُدعى يوم القيامة فتسرح إلى الجنة","cause":"أينَ الَّذينَ كانت تَتَجَافَى جُنُوبُهُمْ عَنِ المَضَاجِعِ","result":"فيقومونَ فيسرَحونَ إلى الجنَّةِ","explicit":true,"apply":{"k":"time","t":"في الليل"},"ref":"الدر المنثور 10/111","srcLabel":"الحاكم","text":["عنِ ابنِ عبَّاسٍ قالَ: إذا كانَ يومُ القيامةِ مُدَّتِ الأرضُ مدَّ الأديمِ، وزيدَ في سَعتِها كذا وَكذا، وجمعَ الخلائقُ بصعيدٍ واحدٍ جنُّهمُ وَ إنسُهم، فإذا كانَ ذلِكَ اليومَ قُبِضت هذِهِ السَّماءُ الدُّنيا عن أَهلِها على وجْهِ الأرضِ ولأَهلُ السَّماءِ وحدُهم أَكثرُ من أَهلِ الأرضِ جنِّهم وَ إنسِهم بضِعفٍ، فإذا نُثِروا على وجْهِ الأرض فزعوا إليهِم فيقولون: أفيكم ربُّنا؟ فيفزعونَ من قولِهم ويقولونَ: سبحانَ ربِّنا ليس فينا وهو آتٍ، ثُمَّ تُقاضُ السَّماءُ الثَّانيةُ ولأَهلُ السَّماءِ الثَّانيةِ وحدَهم أَكثرَ من أهل السَّماءِ الدُّنيا، ومن جميعِ أهل الأرضِ بضِعفٍ جنِّهم وَ إنسِهم، فإذا نُثِروا على وجهِ الأرض فزعَ إليهم أهلُ الأرضِ فيقولونَ: أفيكُم ربُّنا؟ فيفزعونَ من قولِهم ويقولونَ: سبحانَ ربِّنا ليسَ فينا وهو آتٍ، ثم تُقاضُ السَّمواتُ سماءً سماءً كلَّما قيضَت سماءٌ عن أهلِها كانت أكثرَ من أهل السَّمواتِ الَّتي تحتَها ومن جميعِ أَهلِ الأرضِ بضِعفٍ، فإذا نُثِروا على أهل الأرضِ يفزعَ إليْهم أَهلُ الأرضِ فيقولونَ لَهم: مثلُ ذلِكَ فيرجعونَ إليهم مثل ذلك حتَّى تقاضَ السَّماءُ السَّابعةُ فلَأَهلُ السَّماءِ السَّابعةِ أَكثرُ من أهلِ ستِّ سمواتٍ ومن جميعِ أهلِ الأرضِ بضِعفٍ، فيجيءُ اللَّهُ فيهم والأممُ جثًى صفوفٌ فينادي منادٍ ستعلمونَ اليومَ من أصحابُ الْكرمِ ليقُمِ الحمَّادونَ للَّهِ على كلِّ حالٍ فيقومونَ فيسرَحونَ إلى الجنَّةِ ثمَّ ينادي الثَّانيةَ ستعلمون اليومَ من أصحابُ الْكرمِ ",["أينَ الَّذينَ كانت تَتَجَافَى جُنُوبُهُمْ عَنِ المَضَاجِعِ",1]," يَدْعُونَ رَبَّهُمْ خَوْفًا وَطَمَعًا وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ [السجدة آية: 16] ",["فيقومونَ فيسرَحونَ إلى الجنَّةِ",2],"، قالَ: ثمَّ ينادي الثَّالثةَ ستعلمون اليومَ من أصحابُ الْكرَمِ أين الَّذينَ لَا تُلْهِيهِمْ تِجَارَةٌ وَلَا بَيْعٌ عَنْ ذِكْرِ اللَّهِ وَإِقَامِ الصَّلَاةِ وَإِيتَاءِ الزَّكَاةِ يَخَافُونَ يَوْمًا تَتَقَلَّبُ فِيهِ الْقُلُوبُ وَالْأَبْصَارُ [النور آية: 37] فيقومونَ فيسرَحونَ إلى الجنَّةِ فإذا أخذَ كلٌّ من هؤلاءِ ثلاثةٌ خرجَ عنُقٌ منَ النَّارِ فأشرفَ على الخلائقِ لَهُ عينانِ تبصِرانِ ولسانٌ فصيحٌ فيقولُ: إنِّي وُكِّلتُ منكُم بثلاثةٍ بِكلِّ جبَّارٍ عنيدٍ فتلتقطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسِمِ، فتجلِسُ بِهم في جَهنَّمَ ثمَّ تخرجُ ثانيةً فتقولُ إنِّي وُكِّلتُ منكُم بمن آذى اللَّهَ تعالى ورسولَهُ، فتلتقِطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسمِ فتُحبَسُ بهم في جهنَّمَ، ثم تخرجُ ثالثةً فتقولُ: إنِّي وُكِّلتُ بأصحابِ التَّصاويرِ فتَلقطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسمِ فتُحبَسُ بِهم في جَهنَّمَ فإذا أُخذَ من هؤلاءِ ثلاثةً ومن هؤلاءِ ثلاثةً نشِرتِ الصُّحفَ ووُضِعتِ الموازينَ ودُعيَ الخلائقُ للحسابِ"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن المبارك في ((الزهد والرقائق)) (2/101) واللفظ له، والحاكم (8699)، والحارث بن أبي أسامة كما في ((بغية الباحث)) (1122) بلفظ مقارب","bab":"أدعية وأذكار › حمد الله في كل الأحوال","dorar":"TsRrl1QY"},{"id":"س-02835","fp":"e4d8bbd99f2a","stateId":694,"easy":"إذا ركعت عشر ركعات بين المغرب والعشاء ← يُبنى لك قصر في الجنة","cause":"من ركع عشرَ ركعاتٍ بين المغربِ والعشاءِ","result":"بُنيَ له قصرٌ في الجنةِ","explicit":true,"apply":{"k":"count","t":"عشر ركعات · الوقت: بين المغرب والعشاء"},"ref":"تفسير القرطبي 17/31","srcLabel":"ابن المبارك","text":[["من ركع عشرَ ركعاتٍ بين المغربِ والعشاءِ ",1],["بُنيَ له قصرٌ في الجنةِ ",2],". فقال له عمرُ بنُ الخطابِ : إذًا تكثرُ قصورُنا وبيوتُنا يا رسولَ اللهِ ؟ فقال رسولُ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ : اللهُ أكثرُ وأفضلُ. أو قال : أطيبُ"],"grade":"حسن","narrator":"عبدالكريم","muhaddith":"[حسن]","takhrij":"أخرجه ابن المبارك في ((الزهد)) (1264)، والمروزي في ((مختصر قيام الليل)) (صـ88)، واللفظ لهما.","bab":"إيمان › الوعد","dorar":"oY3wbPXz"},{"id":"س-04090","fp":"7e206226424c","stateId":694,"easy":"إذا سجدت لله ← فلك الجنة","cause":"إذا سجدَ ابنُ آدمَ قالَ الشَّيطانُ أمرَ ابنُ آدمَ بالسُّجودِ فسجدَ","result":"فلهُ الجنَّةُ وأمرتُ بالسُّجودِ فعصيتُ فليَ النَّارُ أو نحوَ هذا الكلامِ","explicit":true,"similar":["س-02934"],"ref":"مجمع الزوائد 2/287","srcLabel":"البزار","text":[["إذا سجدَ ابنُ آدمَ قالَ الشَّيطانُ أمرَ ابنُ آدمَ بالسُّجودِ فسجدَ ",1],["فلهُ الجنَّةُ وأمرتُ بالسُّجودِ فعصيتُ فليَ النَّارُ أو نحوَ هذا الكلامِ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"فيه كنانة بن جبلة   وسهيل بن أبي حزم وبقية رجاله ثقات","takhrij":"أخرجه البزار كما في ((مجمع الزوائد)) للهيثمي (2/287)","bab":"جن › صفة إبليس وجنوده","dorar":"CV5S5w9b"},{"id":"س-04485","fp":"fecbb163e865","stateId":694,"easy":"إذا أحسنت عبادة الله حيثما كنت ← فأبشر بالجنة","cause":"حيثُمَا كنتم فأحسنتمْ عبادةَ اللهِ","result":"فأَبْشِرُوا بالجنةِ","explicit":true,"ref":"السلسلة الصحيحة 7/408","srcLabel":"البيهقي","text":["أَتَى نفرٌ من أهلِ الباديةِ إلى رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ فقالوا يا رسولَ اللهِ إنَّ أهلَ قرآنٍ زعموا أنهُ لا ينفعُ عملٌ دونَ الهجرةِ والجهادِ في سبيلِ اللهِ فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ",["حيثُمَا كنتم فأحسنتمْ عبادةَ اللهِ",1]," ",["فأَبْشِرُوا بالجنةِ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه البيهقي (18231)","bab":"جهاد › فضل الجهاد","dorar":"YNzEBXEi"},{"id":"س-02934","fp":"eff87bd7e9a9","stateId":694,"easy":"إذا سجدت لله ← فلك الجنة","cause":"أمر اللهُ ابنَ آدمَ أن يسجدَ","result":"ولهُ الجنةُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-04090","ref":"صحيح الترغيب 1440","text":["عن ابنِ مسعودٍ قال : إذا رأى الشيطانُ ابنَ آدمَ ساجدًا صاح وقال : يا ويلَه ويلَ الشيطانِ ",["أمر اللهُ ابنَ آدمَ أن يسجدَ",1]," ",["ولهُ الجنةُ",2]," ؛ فأطاع ، وأمرني أن أسجدَ ؛ فعصيتُ ؛ فلي النارُ ."],"grade":"حسن","narrator":"أبو إسحاق السبيعي عمرو بن عبدالله","muhaddith":"حسن الإسناد مقطوع","takhrij":"أخرجه الطبراني (9/ 290) (9463)، وعبد الرزاق (9783) بلفظه، وابن المبارك في ((الزهد والرقائق)) (1286) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"SRLHNcMH"},{"id":"س-02065","fp":"4f5234fd94c5","stateId":695,"easy":"إذا غدوت إلى المسجد أو رحت ← يعد الله لك في الجنة نزلاً كلما غدوت أو رحت","cause":"مَن غَدا إلى المَسجِدِ أو راحَ","result":"أعَدَّ اللهُ له في الجَنَّةِ نُزُلًا كُلَّما غَدا أو راحَ","explicit":true,"star":true,"ref":"صحيح مسلم 669","srcLabel":"متفق عليه","text":[["مَن غَدا إلى المَسجِدِ أو راحَ، ",1],["أعَدَّ اللهُ له في الجَنَّةِ نُزُلًا كُلَّما غَدا أو راحَ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (662)، ومسلم (669).","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"TSMN5Gm0"},{"id":"س-01526","fp":"01253625d8e5","stateId":695,"easy":"إذا رددت مع المؤذن من قلبك ← دخلت الجنة","cause":"إذا قالَ المؤذِّنُ: اللَّهُ أَكْبرُ، اللَّهُ أَكْبرُ، فقالَ أحدُكُمُ: اللَّهُ أَكْبرُ، اللَّهُ أَكْبرُ، ثمَّ قالَ: أشهدُ أن لا إلَهَ إلَّا اللَّهُ، فقالَ: أشهَدُ أن لا إلَهَ إلَّا اللَّهُ، ثمَّ قالَ: أشهدُ أنَّ محمَّدًا رسولُ اللَّهِ قالَ: أشهَدُ أنَّ محمَّدًا رسولُ اللَّهِ، ثمَّ قالَ: حيَّ على الصَّلاةِ قالَ: لا حولَ ولا قوَّةَ إلَّا باللَّهِ، ثمَّ قالَ: حيَّ على الفلاحِ قالَ: لا حولَ ولا قوَّةَ إلَّا باللَّهِ، ثمَّ قالَ: اللَّهُ أَكْبرُ، اللَّهُ أَكْبرُ قالَ: اللَّهُ أَكْبرُ، اللَّهُ أَكْبرُ، ثمَّ قالَ: لا إلَهَ إلَّا اللَّهُ قالَ: لا إلَهَ إلَّا اللَّهُ مِن قلبِهِ","result":"دخلَ الجنَّةَ","explicit":true,"star":true,"apply":{"k":"time","t":"عند الأذان"},"similar":["س-01534"],"ref":"صحيح ابن خزيمة 1/ 498","srcLabel":"مسلم","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ: ",["إذا قالَ المؤذِّنُ: اللَّهُ أَكْبرُ، اللَّهُ أَكْبرُ، فقالَ أحدُكُمُ: اللَّهُ أَكْبرُ، اللَّهُ أَكْبرُ، ثمَّ قالَ: أشهدُ أن لا إلَهَ إلَّا اللَّهُ، فقالَ: أشهَدُ أن لا إلَهَ إلَّا اللَّهُ، ثمَّ قالَ: أشهدُ أنَّ محمَّدًا رسولُ اللَّهِ قالَ: أشهَدُ أنَّ محمَّدًا رسولُ اللَّهِ، ثمَّ قالَ: حيَّ على الصَّلاةِ قالَ: لا حولَ ولا قوَّةَ إلَّا باللَّهِ، ثمَّ قالَ: حيَّ على الفلاحِ قالَ: لا حولَ ولا قوَّةَ إلَّا باللَّهِ، ثمَّ قالَ: اللَّهُ أَكْبرُ، اللَّهُ أَكْبرُ قالَ: اللَّهُ أَكْبرُ، اللَّهُ أَكْبرُ، ثمَّ قالَ: لا إلَهَ إلَّا اللَّهُ قالَ: لا إلَهَ إلَّا اللَّهُ مِن قلبِهِ",1]," ",["دخلَ الجنَّةَ",2]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (385)، وأبو داود (527)، والبزار (258) واللفظ لهم.","bab":"أذان › ما يقول إذا سمع المؤذن","dorar":"HM1FedmB"},{"id":"س-01909","fp":"c75ead93f095","stateId":695,"easy":"إذا بنيت لله مسجداً ← يبني الله لك بيتاً في الجنة","cause":"مَن بنى للَّهِ مسجدًا","result":"بنى اللَّهُ لَهُ بيتًا في الجنَّةِ","explicit":true,"star":true,"similar":["س-01908","س-01971","س-02213","س-02327"],"ref":"فتح الباري لابن حجر 1/245","srcLabel":"متواتر","text":["حديث  من بنَى للهِ مسجدًا [حديث عثمان بن عفان: أنَّ عُثْمَانَ بنَ عَفَّانَ، أرَادَ بنَاءَ المَسْجِدِ، فَكَرِهَ النَّاسُ ذلكَ، فأحَبُّوا أنْ يَدَعَهُ علَى هَيْئَتِهِ، فَقالَ: سَمِعْتُ رَسولَ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ يقولُ: مَن بَنَى مَسْجِدًا لِلَّهِ بَنَى اللَّهُ له في الجَنَّةِ مِثْلَهُ.] [وحديث عبدالله بن عمر وأبو ذر الغفاري وأنس بن مالك وعبدالله بن عباس وعلي بن أبي طالب ونبيط بن شريط وأبو هريرة وعائشة أم المؤمنين: ",["مَن بنى للَّهِ مسجدًا ",1],["بنى اللَّهُ لَهُ بيتًا في الجنَّةِ",2],"]"],"grade":"صحيح","narrator":"[عثمان بن عفان عبدالله بن عمر وأبو ذر الغفاري وأنس بن مالك وعبدالله بن عباس وعلي بن أبي طالب ونبيط بن شريط وأبو هريرة وعائشة أم المؤمنين]","muhaddith":"متواتر","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"y7N7M6tR","merged":9,"otherRefs":["تخريج مشكل الآثار 4/ 212 (صحيح)","الضياء اللامع 554 (صحيح)","تخريج المسند لشعيب 27612 (صحيح)","صحيح مسلم 533 (صحيح)","تخريج مشكل الآثار 1556 (حسن)","إتحاف الخيرة المهرة 2/15 (صحيح)","الترغيب والترهيب 1/156 (صحيح)","تخريج المسند لشعيب 19440 (صحيح)"]},{"id":"س-01908","fp":"affab158632a","stateId":695,"easy":"إذا بنيت مسجداً لله ← يبني الله لك في الجنة مثله","cause":"مَن بَنَى مَسْجِدًا لِلَّهِ","result":"بَنَى اللَّهُ له في الجَنَّةِ مِثْلَهُ","explicit":true,"repOf":"س-01909","ref":"فتح الباري لابن حجر 1/245","text":["حديث  من بنَى للهِ مسجدًا [حديث عثمان بن عفان: أنَّ عُثْمَانَ بنَ عَفَّانَ، أرَادَ بنَاءَ المَسْجِدِ، فَكَرِهَ النَّاسُ ذلكَ، فأحَبُّوا أنْ يَدَعَهُ علَى هَيْئَتِهِ، فَقالَ: سَمِعْتُ رَسولَ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ يقولُ: ",["مَن بَنَى مَسْجِدًا لِلَّهِ ",1],["بَنَى اللَّهُ له في الجَنَّةِ مِثْلَهُ",2],".] [وحديث عبدالله بن عمر وأبو ذر الغفاري وأنس بن مالك وعبدالله بن عباس وعلي بن أبي طالب ونبيط بن شريط وأبو هريرة وعائشة أم المؤمنين: مَن بنى للَّهِ مسجدًا بنى اللَّهُ لَهُ بيتًا في الجنَّةِ]"],"grade":"صحيح","narrator":"[عثمان بن عفان عبدالله بن عمر وأبو ذر الغفاري وأنس بن مالك وعبدالله بن عباس وعلي بن أبي طالب ونبيط بن شريط وأبو هريرة وعائشة أم المؤمنين]","muhaddith":"متواتر","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"y7N7M6tR","merged":4,"otherRefs":["صحيح الجامع 6130 (صحيح)","تخريج المسند لشاكر 1/247 (صحيح)","تخريج صحيح ابن حبان 1609 (صحيح)"]},{"id":"س-02196","fp":"f454e96144d3","stateId":695,"easy":"إذا لقطت القذى من المسجد ← تدخل الجنة","cause":"كانت تلقُطُ القَذى منَ المسجِدِ","result":"رأيتُها في الجنَّةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الترغيب والترهيب 1/157","srcLabel":"البخاري","text":["أنَّ امرأةً ",["كانت تلقُطُ القَذى منَ المسجِدِ",1]," فتوُفِّيَت ، فلَم يؤذنِ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ بدفنِها فقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ إذا ماتَ لَكُم ميِّتٌ فآذِنوني وصلَّى علَيها وقالَ إنِّي ",["رأيتُها في الجنَّةِ",2]," تَلقُطُ القذى منَ المسجِدِ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه البخاري (1326) بمعناه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"riQCiESp"},{"id":"س-01493","fp":"0026577efa19","stateId":695,"easy":"إذا أذّنت اثنتي عشرة سنة ← وجبت لك الجنة ولك بكل أذان ستون حسنة","cause":"مَن أذَّن اثنَتَي عَشرةَ سنةً","result":"وجَبَتْ لهُ الجنَّةُ ، و كُتِبَ لهُ بتَأذينِه في كلَّ يومٍ ستُّونَ حسَنةً ، و بكلِّ إقامةٍ ثَلاثونَ حَسَنةً","explicit":true,"otherNeedIds":[45],"ref":"صحيح الترغيب 248","srcLabel":"ابن ماجه","text":[["مَن أذَّن اثنَتَي عَشرةَ سنةً ، ",1],["وجَبَتْ لهُ الجنَّةُ ، و كُتِبَ لهُ بتَأذينِه في كلَّ يومٍ ستُّونَ حسَنةً ، و بكلِّ إقامةٍ ثَلاثونَ حَسَنةً",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (728)، والبزار (5933)، وابن حبان في ((المجروحين)) (1/463) باختلاف يسير.","bab":"أذان › فضل التأذين","dorar":"Q1IXyRPf"},{"id":"س-01499","fp":"f7e9c45c0730","stateId":695,"easy":"إذا قلت مثل ما يقول المؤذن يقيناً ← دخلت الجنة","cause":"مَن قالَ مثلَ ما قالَ هذا يَقينًا","result":"دخلَ الجنَّةَ","explicit":true,"apply":{"k":"time","t":"عند الأذان"},"ref":"تخريج المسند لشاكر 16/256","srcLabel":"النسائي","text":["كنَّا معَ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ بتَلعانِ اليمَنِ ، فقامَ بلالٌ يُنادي ، فَلمَّا سَكَتَ ، قالَ رَسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : ",["مَن قالَ مثلَ ما قالَ هذا يَقينًا ، ",1],["دخلَ الجنَّةَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (674)، وأحمد (8624) واللفظ له","bab":"أذان › فضل التأذين","dorar":"ussbevLH"},{"id":"س-01534","fp":"99a5852b9fa0","stateId":695,"easy":"إذا قلتها من قلبك ← دخلت الجنة","cause":"إذا قاله مِن قَلبِه","result":"دَخَل الجَنَّةَ","explicit":true,"repOf":"س-01526","ref":"معرفة السنن والآثار 2570","text":["نَحو [عن عبدِ اللهِ بنِ عَلقَمةَ بنِ وقَّاصٍ، قال: إنِّي لعِندَ مُعاويةَ إذ أذَّنَ مُؤَذِّنُه، فقال مُعاويةُ كَما قال مُؤَذِّنُه، حتَّى إذا قال: حَيَّ على الصَّلاةِ، قال: «لا حَولَ ولا قوَّةَ إلَّا باللهِ»، ولمَّا قال: حَيَّ على الفلَّاحِ، قال: «لا حَولَ ولا قوَّةَ إلَّا باللهِ»، ثُمَّ قال ذلك بَعدَما قال المُؤَذِّنُ، ثُمَّ قال: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ ذلك] \nزادَ أبو سَعيدٍ في رِوايَتِه، قال الشَّافِعيُّ: وحَديثُ مُعاويةَ يوافِقُ حَديثَ أبي سَعيدٍ، وفيه تَفسيرٌ ليسَ في حَديثِ أبي سَعيدٍ. [وهو] عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم في التَّرغيبِ فيه بأنَّ أحَدَكُم ",["إذا قاله مِن قَلبِه",1]," ",["دَخَل الجَنَّةَ",2],"."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"[ثابت]","bab":"أذان › ما يقول إذا سمع المؤذن","dorar":"nbPG1gvj"},{"id":"س-01971","fp":"198879805933","stateId":695,"easy":"إذا بنيت مسجداً يُصلّى فيه ← يبني الله لك في الجنة أفضل منه","cause":"مَن بنَى مسجِدًا يصلَّى فيه","result":"بنَى اللهُ عزَّ وجلَّ له في الجَنَّةِ أفضَلَ منه","explicit":true,"repOf":"س-01909","ref":"تخريج المسند لشعيب 16005","text":[["مَن بنَى مسجِدًا يصلَّى فيه",1],"، ",["بنَى اللهُ عزَّ وجلَّ له في الجَنَّةِ أفضَلَ منه",2],"."],"grade":"صحيح","narrator":"واثلة بن الأسقع الليثي أبو فسيلة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (16005) واللفظ له، والعقيلي في ((الضعفاء الكبير)) (1/244)، والطبراني (22/88) (213)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"aeriCczH"},{"id":"س-02086","fp":"c5a8b9a06f65","stateId":695,"easy":"إذا أخرجت أذى من المسجد ← يبني الله لك بيتاً في الجنة","cause":"من أخرج أذى من المسجدِ","result":"بنى اللهُ له بيتًا في الجنَّةِ","explicit":true,"ref":"شرح ابن ماجه لمغلطاي 3/194","srcLabel":"ابن ماجه","text":[["من أخرج أذى من المسجدِ ",1],["بنى اللهُ له بيتًا في الجنَّةِ",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (757)، وأورده ابن حبان في ((المجروحين)) (2/194)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"2jblK6iy"},{"id":"س-02213","fp":"bcd618b8c5b9","stateId":695,"easy":"إذا بنيت مسجداً ولو مثل مفحص قطاة ← يبني الله لك بيتاً في الجنة","cause":"مَن بَنى مَسجِدًا ولو مِثلَ مَفحَصِ قَطاةٍ","result":"بَنى اللهُ له بَيْتًا في الجَنَّةِ","explicit":true,"repOf":"س-01909","ref":"علل ابن أبي حاتم 261","text":["حَديثٌ رَواه علِيُّ بنُ حَكيمٍ، عن شَريكٍ، عن الأَعمَشِ، عن إبراهيمَ التَّيْميِّ، عن أبيه، عن أبي ذَرٍّ -رَفَعَه- قالَ: ",["مَن بَنى مَسجِدًا ولو مِثلَ مَفحَصِ قَطاةٍ ",1],["بَنى اللهُ له بَيْتًا في الجَنَّةِ",2],"؟"],"grade":"صحيح","narrator":"أبو ذر","muhaddith":"حَديثُ الأَعمَشِ: مَن بَنى للهِ مَسجِدًا ولو كمَفحَصِ قَطاةٍ ...: ليس مِن صَحيحِ حَديثِ الأَعمَشِ.","takhrij":"أخرجه ابن أبي شيبة (3155)، والبزار (4017)، والطحاوي في ((شرح مشكل الآثار)) (1549)، وابن حبان (40) واللفظ لهم.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"y9QUjdcq"},{"id":"س-02327","fp":"5ab6b72efb03","stateId":695,"easy":"إذا بنيت لله بيتاً ← يبني الله لك بيتاً في الجنة، وإخراج القمامة منها مهور الحور","cause":"فمَن بنى للهِ بَيتًا","result":"بنى اللهُ له بيتًا في الجنَّةِ، وإخراجُ القمامةِ منها مهورُ الحُورِ العِينِ","explicit":true,"repOf":"س-01909","ref":"فيض القدير 62","text":["ابنوا المساجِدَ وأخرِجوا القمامةَ منها، ",["فمَن بنى للهِ بَيتًا ",1],["بنى اللهُ له بيتًا في الجنَّةِ، وإخراجُ القمامةِ منها مهورُ الحُورِ العِينِ",2],"."],"grade":"صحيح","narrator":"أبو قرصافة جندرة بن خيشنة","muhaddith":"[صحيح]","takhrij":"أخرجه الطبراني (3/ 19) (2521)، وابن عساكر (5/ 110) واللفظ لهما.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"tFtSasmF"},{"id":"س-01115","fp":"878db2b0f50c","stateId":695,"easy":"إذا صليت الفجر ثم قعدت تذكر الله حتى تطلع الشمس ← وجبت لك الجنة","cause":"مَن صلَّى صلاةَ الفَجرِ ثمَّ قعدَ يذكرُ اللَّهَ حتَّى تَطلعَ الشَّمسُ","result":"وجبت لَهُ الجنَّةُ","explicit":true,"ref":"الترغيب والترهيب 1/221","srcLabel":"أبو داود","text":[["مَن صلَّى صلاةَ الفَجرِ ثمَّ قعدَ يذكرُ اللَّهَ حتَّى تَطلعَ الشَّمسُ ",1],["وجبت لَهُ الجنَّةُ",2]],"grade":"حسن","narrator":"معاذ بن أنس","muhaddith":"حسن","takhrij":"أخرجه أبو داود (1287)، وأحمد (15623) بمعناه، وابن عدي في ((الكامل في الضعفاء)) (3/152) واللفظ له، من حديث معاذ بن أنس .","bab":"أدعية وأذكار › فضل الذكر","dorar":"KgL2di8p"},{"id":"س-08312","fp":"62db1b56ac17","stateId":695,"easy":"إذا زدت في بناء المسجد ← لك بيت في الجنة","cause":"مَن يزيدُ في هذا المسجدِ","result":"ببيتٍ في الجنَّةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[47],"ref":"صحيح النسائي 3611","srcLabel":"الترمذي","text":["أنَّ عثمانَ، أشرَفَ علَيهِم حينَ حصَروهُ ، فقالَ : أنشدُ باللَّهِ رجلًا سمعَ مِن رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ يقولُ يومَ الجبلِ حينَ اهتزَّ فرَكَلَهُ برجلِهِ ، وقالَ : اسكُن فإنَّهُ ليسَ عليكَ إلَّا نبيٌّ أو صدِّيقٌ أو شَهيدان وأَنا معَهُ ، فانتشدَ لَهُ رجالٌ، ثمَّ قالَ : أنشدُ باللَّهِ رجلًا شَهِدَ رسولَ اللَّهِ يومَ بيعةِ الرِّضوانِ يقولُ: هذِهِ يدُ اللَّهِ وَهَذِهِ يدُ عثمانَ فانتشدَ لَهُ رجالٌ، ثمَّ قالَ: أنشُدُ باللَّهِ رجلًا سمعَ رسولَ اللَّهِ يومَ جيشِ العسرةِ، يقولُ: مَن ينفقُ نفقةً مُتقبَّلةً؟ فجَهَّزتُ نصفَ الجيشِ من مالي، فانتشدَ لَهُ رجالٌ، ثمَّ قالَ: أنشدُ باللَّهِ رجلًا سمعَ رسولَ اللَّهِ يقولُ: ",["مَن يزيدُ في هذا المسجدِ",1]," ",["ببيتٍ في الجنَّةِ",2],"؟ فاشتريتُهُ من مالي، فانتشدَ لَهُ رجالٌ، ثمَّ قالَ: أنشدُ باللَّهِ رجلًا شَهِدَ رومةَ تباعُ فاشتريتُها من مالي فأبحتُها لابنِ السَّبيلِ، فانتشدَ لَهُ رجالٌ"],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"صحيح [لغيره]","takhrij":"أخرجه النسائي (3609) واللفظ له، والترمذي (3699)، وابن خزيمة (2492) بنحوه.","bab":"مناقب وفضائل › عثمان بن عفان","dorar":"rsGbZHKl"},{"id":"س-01523","fp":"7f62727e044f","stateId":695,"easy":"إذا كنت مؤذناً محتسباً ← تُبعث في زمرة المؤذنين المحتسبين لا يخالطهم غيرهم","cause":"المؤذِّنونَ المحتسِبونَ","result":"لا يُخالِطُهمْ أحدٌ إلَّا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[65],"ref":"صحيح الجامع 1872","srcLabel":"الحاكم","text":["إنَّ اللهَ : يَبعثُ الأيامَ يومَ القيامةِ على هيئَتِها ، ويبعثُ الجُمعةَ زهْراءَ مُنِيرةً لأهلِها ، فيَحُفُّونَ بِها كالعرُوسِ تُهدَى إلى كرِيمِها تُضِيءُ لهمْ ، يَمشونَ في ضَوْئِها ، ألوانُهمْ كالثَّلجِ بَياضًا ، رِياحُهمْ تَسطَعُ كالمِسكِ ، يَخوضُونَ في جِبالِ الكافورِ ، يَنظرُ إليهِمُ الثَّقلانِ ما يُطْرِقُونَ تعجُّبًا ، حتى يَدخلوا الجنةَ ، ",["لا يُخالِطُهمْ أحدٌ إلَّا",2]," ",["المؤذِّنونَ المحتسِبونَ",1]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح","takhrij":"أخرجه ابن خزيمة (1730)، والطبراني في ((مسند الشاميين)) (1557)، والحاكم (1042) باختلاف يسير","bab":"أذان › فضل التأذين","dorar":"5t7ylciK","merged":3,"otherRefs":["عمدة القاري 5/165 (حسن)","شرح ابن ماجه لمغلطاي 3/111 (صحيح)"]},{"id":"س-01517","fp":"5df2f73440a6","stateId":695,"easy":"إذا كنت من المؤذنين ← تكون من أول الناس دخولاً الجنة","cause":"الأنبياءُ ثُمَّ الشُّهداءُ ثُمَّ مؤذِنُوا الكعبةِ ثُمَّ مؤذنُوا بيتِ المقدسِ ثُمَّ مؤذنُوا مسجدِي هذَا ثُمَّ سائرُ المؤذنِينَ","result":"مَنْ أوَّلُ النَّاسِ دخولًا الجنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"عند الأذان"},"ref":"عمدة القاري 5/165","srcLabel":"ابن حبان","text":["قِيلَ يا رسولَ اللهِ ",["مَنْ أوَّلُ النَّاسِ دخولًا الجنَّةَ",2]," قالَ ",["الأنبياءُ ثُمَّ الشُّهداءُ ثُمَّ مؤذِنُوا الكعبةِ ثُمَّ مؤذنُوا بيتِ المقدسِ ثُمَّ مؤذنُوا مسجدِي هذَا ثُمَّ سائرُ المؤذنِينَ",1]],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"إسناده صالح","takhrij":"أخرجه ابن سعد في ((الطبقات)) (6862)، وابن حبان في ((المجروحين)) (2/257) باختلاف يسير، وابن فاخر في ((موجبات الجنة)) (374) واللفظ له","bab":"أذان › فضل التأذين","dorar":"LbQZKT9L"},{"id":"س-01472","fp":"45638c8d23ab","stateId":696,"easy":"إذا أحسنت الوضوء ثم ركعت ركعتين تقبل عليهما بقلبك ← أوجبت الجنة","cause":"ما منكم من أحدٍ يتوضَّأُ فيحسِنُ الوضوءَ ثمَّ يقومُ فيركعُ ركعتينِ يقبِلُ عليهما بقلبِهِ ووجههِ","result":"إلَّا قد أوجب فقلتُ بخٍ بخٍ ما أجودَ هذهِ فقالَ رجلٌ من بينِ يديَّ الَّتي قبلَها يا عقبةُ أجودُ منها فنظرتُ فإذا هوَ عمرُ بنُ الخطَّابِ فقلتُ ما هيَ يا","explicit":true,"star":true,"apply":{"k":"count","t":"ركعتين · الوقت: بعد الوضوء"},"similar":["س-01462"],"ref":"صحيح أبي داود 169","srcLabel":"مسلم","text":["كنَّا معَ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ خُدَّامَ أنفسِنا نتناوَبُ الرِّعايةَ - رعايةَ إبِلنا - فكانت عليَّ رعايةُ الإبلِ فروَّحتُها بالعشيِّ فأدركتُ رسولَ اللَّهِ يخطبُ النَّاسَ فسمعتُهُ يقولُ ",["ما منكم من أحدٍ يتوضَّأُ فيحسِنُ الوضوءَ ثمَّ يقومُ فيركعُ ركعتينِ يقبِلُ عليهما بقلبِهِ ووجههِ",1]," ",["إلَّا قد أوجب فقلتُ بخٍ بخٍ ما أجودَ هذهِ فقالَ رجلٌ من بينِ يديَّ الَّتي قبلَها يا عقبةُ أجودُ منها فنظرتُ فإذا هوَ عمرُ بنُ الخطَّابِ فقلتُ ما هيَ يا",2]," أبا حفصٍ قالَ إنَّهُ قالَ آنِفًا قبلَ أن تَجيءَ ما منكم من أحدٍ يتوضَّأُ فيُحسِنُ الوضوءَ ثمَّ يقولُ حينَ يفرُغُ من وضوئهِ أشهدُ أن لا إلهَ إلَّا اللَّهُ وحدَهُ لا شريكَ لهُ وأنَّ محمَّدًا عبدُهُ ورسولُهُ إلَّا فُتحَتْ لهُ أبوابُ الجنَّةِ الثَّمانيةُ يدخلُ من أيِّها شاءَ"],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (169) واللفظ له، وأخرجه مسلم (234) بلفظ مقارب","bab":"وضوء › فضل الوضوء","dorar":"id7sDH8B"},{"id":"س-01473","fp":"2d2b2fe72c82","stateId":696,"easy":"إذا أحسنت الوضوء ثم قلت «أشهد أن لا إله إلا الله...» ← تُفتح لك أبواب الجنة الثمانية","cause":"ما منكم من أحدٍ يتوضَّأُ فيُحسِنُ الوضوءَ ثمَّ يقولُ حينَ يفرُغُ من وضوئهِ أشهدُ أن لا إلهَ إلَّا اللَّهُ وحدَهُ لا شريكَ لهُ وأنَّ محمَّدًا عبدُهُ ورسولُهُ","result":"إلَّا فُتحَتْ لهُ أبوابُ الجنَّةِ الثَّمانيةُ يدخلُ من أيِّها شاءَ","explicit":true,"apply":{"k":"say","t":"«أشهدُ أن لا إلهَ إلَّا اللَّهُ وحدَهُ لا شريكَ لهُ وأنَّ محمَّدًا عبدُهُ ورسولُهُ إلَّا فُتحَتْ لهُ أبوابُ الجنَّةِ الثَّمانيةُ يدخلُ من أيِّها شاء» · الوقت: بعد الوضوء"},"similar":["س-01454","س-03435"],"ref":"صحيح أبي داود 169","srcLabel":"مسلم","text":["كنَّا معَ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ خُدَّامَ أنفسِنا نتناوَبُ الرِّعايةَ - رعايةَ إبِلنا - فكانت عليَّ رعايةُ الإبلِ فروَّحتُها بالعشيِّ فأدركتُ رسولَ اللَّهِ يخطبُ النَّاسَ فسمعتُهُ يقولُ ما منكم من أحدٍ يتوضَّأُ فيحسِنُ الوضوءَ ثمَّ يقومُ فيركعُ ركعتينِ يقبِلُ عليهما بقلبِهِ ووجههِ إلَّا قد أوجب فقلتُ بخٍ بخٍ ما أجودَ هذهِ فقالَ رجلٌ من بينِ يديَّ الَّتي قبلَها يا عقبةُ أجودُ منها فنظرتُ فإذا هوَ عمرُ بنُ الخطَّابِ فقلتُ ما هيَ يا أبا حفصٍ قالَ إنَّهُ قالَ آنِفًا قبلَ أن تَجيءَ ",["ما منكم من أحدٍ يتوضَّأُ فيُحسِنُ الوضوءَ ثمَّ يقولُ حينَ يفرُغُ من وضوئهِ أشهدُ أن لا إلهَ إلَّا اللَّهُ وحدَهُ لا شريكَ لهُ وأنَّ محمَّدًا عبدُهُ ورسولُهُ",1]," ",["إلَّا فُتحَتْ لهُ أبوابُ الجنَّةِ الثَّمانيةُ يدخلُ من أيِّها شاءَ",2]],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (169) واللفظ له، وأخرجه مسلم (234) بلفظ مقارب","bab":"وضوء › فضل الوضوء","dorar":"id7sDH8B"},{"id":"س-01462","fp":"a66e6778cf42","stateId":696,"easy":"إذا أحسنت الوضوء ثم صليت ركعتين مقبلاً بقلبك ووجهك ← وجبت لك الجنة","cause":"ما مِن مُسلِمٍ يَتَوضَّأُ فيُحسِنُ وُضوءَه، ثُمَّ يَقومُ فيُصَلِّي رَكعَتَينِ، مُقبِلٌ عليهما بقَلبِه ووجههِ","result":"إلَّا وجَبَت له الجَنَّةُ","explicit":true,"apply":{"k":"count","t":"ركعتين · الوقت: بعد الوضوء"},"repOf":"س-01472","otherNeedIds":[11],"ref":"صحيح مسلم 234","text":["كانَت علينا رِعايةُ الإبِلِ، فجاءَت نَوبَتي فرَوَّحتُها بعَشيٍّ، فأدرَكتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قائِمًا يُحَدِّثُ النَّاسَ فأدرَكتُ مِن قَولِه: ",["ما مِن مُسلِمٍ يَتَوضَّأُ فيُحسِنُ وُضوءَه، ثُمَّ يَقومُ فيُصَلِّي رَكعَتَينِ، مُقبِلٌ عليهما بقَلبِه ووجههِ،",1]," ",["إلَّا وجَبَت له الجَنَّةُ",2],"، قال: فقُلتُ: ما أجودَ هذه! فإذا قائِلٌ بينَ يَدَيَّ يقولُ: التي قَبلَها أجودُ، فنَظَرتُ فإذا عُمَرُ، قال: إنِّي قد رَأيتُك جِئتَ آنِفًا، قال: ما مِنكُم مِن أحَدٍ يَتَوضَّأُ فيُبلِغُ أو فيُسبِغُ الوضوءَ، ثُمَّ يقولُ: أشهَدُ أنْ لا إلَهَ إلَّا اللهُ وأنَّ مُحَمَّدًا عبدُ اللهِ ورَسولُه؛ إلَّا فُتِحَت له أبوابُ الجَنَّةِ الثَّمانيةُ يَدخُلُ مِن أيِّها شاءَ. وفي روايةٍ: فذَكَرَ مِثلَه، غيرَ أنَّه قال: مَن تَوضَّأ فقال: أشهَدُ أنْ لا إلَهَ إلَّا اللهُ وحدَه لا شَريك له وأشهَدُ أنَّ مُحَمَّدًا عَبدُه ورَسولُه."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (17393) بلفظه، والنسائي (151) مختصرا ببعض لفظه، وأبو يعلى (72) باختلاف يسير.","bab":"وضوء › فضل الوضوء","dorar":"jCKZqr5Z","merged":4,"otherRefs":["تخريج المسند لشعيب 17314 (صحيح)","صحيح الجامع 6166 (صحيح)","صحيح أبي داود 906 (صحيح)"]},{"id":"س-01454","fp":"989e1e3d724b","stateId":696,"easy":"إذا أسبغت الوضوء ثم قلت «أشهد أن لا إله إلا الله...» ← تُفتح لك أبواب الجنة الثمانية","cause":"ما مِن رَجلٍ يَتوضَّأُ فيُسبِغُ الوُضوءَ، ثُمَّ يقولُ عندَ فراغِهِ مِن وُضوئِهِ: أَشهدُ أنْ لا إلهَ","result":"إلَّا اللهُ وأَشهدُ أنَّ مُحمَّدًا عبدُهُ ورسولُهُ إلَّا فُتِحتْ له ثمانيةُ أبوابٍ مِنَ الجنَّةِ يَدخلُ مِنْ أيِّها شاءَ","explicit":true,"apply":{"k":"say","t":"«أَشهدُ أنْ لا إلهَ إلَّا اللهُ وأَشهدُ أنَّ مُحمَّدًا عبدُهُ ورسولُهُ إلَّا فُتِحتْ له ثمانيةُ أبوابٍ مِنَ الجنَّةِ يَدخلُ مِنْ أيِّها شاء»"},"repOf":"س-01473","ref":"المستدرك على الصحيحين 3554","text":["كنَّا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في سفَرٍ، فكنَّا نَتناوبُ الرِّعيَةَ، فلمَّا كانت نَوْبَتي سرَّحتُ إِبِلي، ثُمَّ رُحتُ، فجئتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ وهو يَخطُبُ النَّاسَ فسَمِعْتُهُ يقولُ: «ما مِن مسلمٍ يَتوضَّأُ فيُسبِغُ الوُضوءَ، ثُمَّ يقومُ في صلاتِهِ فيَعلَمُ ما يَقولُ إلَّا انفَتَلَ كيومِ ولدَتْهُ أُمُّهُ مِنَ الخطايا، ليس عليه ذنبٌ». قالَ: فما مَلكْتُ نفْسي عند ذلك أنْ قلتُ: بَخٍ بَخٍ. فقالَ عُمَرُ -وكنتُ إلى جنبِهِ-: أتعجبُ مِن هذا؟ قد قالَ قبلَ أنْ تَجيءَ ما هو أجودُ منه. فقلتُ: ما هو فِداكَ أبي وأُمِّي؟ قالَ: قالَ: «",["ما مِن رَجلٍ يَتوضَّأُ فيُسبِغُ الوُضوءَ، ثُمَّ يقولُ عندَ فراغِهِ مِن وُضوئِهِ: أَشهدُ أنْ لا إلهَ",1]," ",["إلَّا اللهُ وأَشهدُ أنَّ مُحمَّدًا عبدُهُ ورسولُهُ إلَّا فُتِحتْ له ثمانيةُ أبوابٍ مِنَ الجنَّةِ يَدخلُ مِنْ أيِّها شاءَ»",2],". ثُمَّ قالَ: «يُجمعُ النَّاسُ في صَعيدٍ واحدٍ، يَنفذُهم البَصرُ، ويُسمِعُهم الدَّاعي، فيُنادي مُنادٍ: سيَعلمُ أهلُ الجمعِ لمَنِ الكرمُ اليومَ». ثلاثَ مرَّاتٍ. «ثُمَّ يقولُ: «أين الَّذين كانت تَتجافى جُنوبُهم عنِ المضاجِعِ؟»، ثُمَّ يقولُ: «أين الَّذين كانوا {لَا تُلْهِيهِمْ تِجَارَةٌ وَلَا بَيْعٌ عَنْ ذِكْرِ اللَّهِ} [النور: 37] إلى آخرِ الآيةِ، ثُمَّ يُنادي مُنادٍ: سيَعلمُ الجمعُ لمَنِ الكرمُ اليومَ»، ثُمَّ يقولُ: «أين الحمَّادونَ الَّذين كانوا يَحمَدونَ ربَّهم؟»."],"grade":"صحيح","narrator":"عقبة بن عامر الجهني","muhaddith":"صحيح","takhrij":"أخرجه الروياني (251)، وابن عبد البر في ((التمهيد)) (1/ 51)، وأبو موسى المديني في ((اللطائف)) (719) جميعهم دون لفظه الأخير.","bab":"وضوء › فضل الوضوء","dorar":"jTAp8ilA","merged":3,"otherRefs":["تخريج المسند لشعيب 17314 (صحيح)","صحيح مسلم 234 (صحيح)"]},{"id":"س-03435","fp":"fc1bf3d681bc","stateId":696,"easy":"إذا أحسنت الوضوء ثم رفعت نظرك إلى السماء وقلت «أشهد أن لا إله إلا الله...» ← تُفتح لك أبواب الجنة الثمانية","cause":"مَن تَوضَّأ فأحسَنَ الوُضوءَ، ثُمَّ رَفَعَ نَظَرَه إلى السَّماءِ، فقال: أشهَدُ أنْ لا إلَهَ إلَّا اللهُ وحدَه لا شَريكَ له، وأشهَدُ أنَّ مُحَمَّدًا عَبدُه ورَسولُه","result":"فُتِحَت له ثَمانيةُ أبوابِ الجَنَّةِ، يَدخُلُ مِن أيِّها شاءَ","explicit":true,"apply":{"k":"say","t":"«أشهَدُ أنْ لا إلَهَ إلَّا اللهُ وحدَه لا شَريكَ له، وأشهَدُ أنَّ مُحَمَّدًا عَبدُه ورَسولُه، فُتِحَت له ثَمانيةُ أبوابِ الجَنَّةِ، يَدخُلُ مِن أيِّها شاء» · الوقت: بعد الوضوء"},"repOf":"س-01473","ref":"تخريج المسند لشعيب 121","text":["عن عُقبةَ بنِ عامِرٍ، أنَّه خَرَجَ مَعَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةِ تَبوكَ، فجَلَسَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يَومًا يُحَدِّثُ أصحابَه، فقال: مَن قامَ إذا استَقَلَّتِ الشَّمسُ فتَوضَّأ، فأحسَنَ الوُضوءَ، ثُمَّ قامَ فصَلَّى رَكعَتَينِ، غُفِرَ له خَطاياه فكان كما ولَدَته أُمُّه. قال عُقبةُ بنُ عامِرٍ: فقُلتُ: الحَمدُ للَّهِ الذي رَزَقَني أن أسمَعَ هذا مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال لي عُمَرُ بنُ الخَطَّابِ، وكان تُجاهي جالِسًا: أتَعجَبُ مِن هذا؟ فقد قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم أعجَبَ مِن هذا قَبلَ أن تَأتيَ، فقُلتُ: وما ذاكَ بأبي أنتَ وأُمِّي؟ فقال عُمَرُ: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["مَن تَوضَّأ فأحسَنَ الوُضوءَ، ثُمَّ رَفَعَ نَظَرَه إلى السَّماءِ، فقال: أشهَدُ أنْ لا إلَهَ إلَّا اللهُ وحدَه لا شَريكَ له، وأشهَدُ أنَّ مُحَمَّدًا عَبدُه ورَسولُه، ",1],["فُتِحَت له ثَمانيةُ أبوابِ الجَنَّةِ، يَدخُلُ مِن أيِّها شاءَ",2],"."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"صحيح لغيره","bab":"استغفار › أسباب المغفرة","dorar":"aJmGUGBX","merged":2,"otherRefs":["الأحكام الشرعية الصغرى 123 (صحيح)"]},{"id":"س-01416","fp":"6559924a4a38","stateId":696,"easy":"إذا أطلت الغرة والتحجيل في الوضوء ← فهو مبلغ الحلية","cause":"وغَسَلَ ذِراعَيْه حتى جاوَزَ الـمِرْفَقَيْن، فلمَّا غَسَلَ رِجْلَيْه جاوَزَ الكَعْبَيْن إلى السَّاقَيْن","result":"هذا مَبْلَغُ الـحِلْيَةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"تخريج المسند لشعيب 7166","srcLabel":"متفق عليه","text":["دخَلْتُ مع أبي هريرةَ دارَ مَرْوانَ بنِ الـحَكَمِ، فرَأى فيها تَصاوِيرَ، وهي تُبْنى، فقال: سـمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: يَقولُ اللهُ عزَّ وجلَّ: ومَن أَظْلَمُ مـمَّن ذهَبَ يَـخْلُقُ خَلْقًا كخَلْقي، فلْيَخْلُقوا ذَرَّةً، أو فَلْيَخْلُقوا حَبَّةً، أو لِيَخْلُقوا شَعِيرَةً، ثم دَعا بوَضوءٍ، فتَوَضَّأ ",["وغَسَلَ ذِراعَيْه حتى جاوَزَ الـمِرْفَقَيْن، فلمَّا غَسَلَ رِجْلَيْه جاوَزَ الكَعْبَيْن إلى السَّاقَيْن",1],"، فقُلْتُ: ما هذا؟ فقال: ",["هذا مَبْلَغُ الـحِلْيَةِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (5953)، ومسلم (2111) باختلاف يسير","bab":"وضوء › صفة الوضوء","dorar":"r1sB0lNw","merged":5,"otherRefs":["السلسلة الصحيحة 1/506 (حسن)","صحيح ابن خزيمة 1/ 125 (صحيح)","تخريج صحيح ابن حبان 1045 (صحيح)","السلسلة الصحيحة 1/506 (صحيح)"]},{"id":"س-01398","fp":"7384a41e8649","stateId":696,"easy":"إذا توضأت ← تبلغ حليتك يوم القيامة حيث يبلغ الوضوء","cause":"حَيثُ يَبلُغُ الوضوءُ","result":"تَبلُغُ الحِليةُ مِنَ المُؤمِنِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"صحيح مسلم 250","srcLabel":"مسلم","text":["كُنتُ خَلفَ أبي هُرَيرةَ وهو يَتَوضَّأُ للصَّلاةِ، فكانَ يَمُدُّ يَدَه حتَّى تَبلُغَ إبطَه، فقُلتُ له: يا أبا هُرَيرةَ، ما هذا الوُضوءُ؟ فقال: يا بَني فرُّوخَ، أنتُم هاهنا؟ لو عَلِمتُ أنَّكُم هاهنا ما تَوضَّأتُ هذا الوُضوءَ، سَمِعتُ خَليلي صلَّى اللهُ عليه وسلَّم يقولُ: ",["تَبلُغُ الحِليةُ مِنَ المُؤمِنِ",2]," ",["حَيثُ يَبلُغُ الوضوءُ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (250)","bab":"وضوء › صفة الوضوء","dorar":"CEmAPRTW","merged":2,"otherRefs":["صحيح النسائي 149 (صحيح)"]},{"id":"س-07810","fp":"685a92d1432b","stateId":697,"easy":"إذا قرأت آية الكرسي دبر كل صلاة ← لم يكن بينك وبين الجنة إلا أن تموت","cause":"من قرأ آيةَ الكرسيِّ دُبرَ كلِّ صلاةٍ لم يكنْ بينَه وبينَ","result":"أن يدخلَ الجنةَ إلا أن يموتَ","explicit":true,"star":true,"apply":{"k":"read","t":"آية الكرسي · الوقت: دبر كل صلاة"},"similar":["س-06405","س-00712","س-00713"],"ref":"تخريج الكشاف 1/160","srcLabel":"البخاري","text":[["من قرأ آيةَ الكرسيِّ دُبرَ كلِّ صلاةٍ لم يكنْ بينَه وبينَ ",1],["أن يدخلَ الجنةَ إلا أن يموتَ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"على شرط البخاري","takhrij":"أخرجه الحاكم كما في ((تخريج الكشاف)) للزيلعي (1/160)","bab":"قرآن › فضل قراءة القرآن","dorar":"m6l79R1c"},{"id":"س-08301","fp":"f050ec81d177","stateId":697,"easy":"إذا أحببت سورة الإخلاص ← يدخلك حبها الجنة","cause":"حبُّها","result":"أدخلَكَ الجنَّةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"صحيح الترمذي 2901","srcLabel":"البخاري","text":["كانَ رجلٌ منَ الأنصارِ يَؤمُّهم في مسجدِ قُباءَ ، فَكانَ كلَّما افتَتحَ سورةً يقرأُ لَهُم في الصَّلاةِ فقرأ بِها ، افتتحَ بقُلْ هُوَ اللَّهُ أَحَدٌ حتَّى يفرُغَ مِنها ، ثمَّ يقرأُ بسورةٍ أُخرَى معَها ، وَكانَ يصنعُ ذلِكَ في كلِّ رَكْعةٍ. فَكَلَّمَهُ أصحابُهُ ، فقالوا : إنَّكَ تقرأُ بِهَذِهِ السُّورةِ ، ثمَّ لا ترَى أنَّها تجزيكَ حتَّى تقرأَ بسورةٍ أُخرَى ، فإمَّا أن تقرأَ بِها ، وإمَّا أن تدعَها وتقرأَ بسورةٍ أُخرَى ، قالَ : ما أنا بتارِكِها ، إن أحبَبتُمْ أن أؤُمَّكُم بِها فعلتُ ، وإن كَرِهْتُم ترَكْتُكُم. وَكانوا يرَونَهُ أفضلَهُم ، وَكَرِهوا أن يؤُمَّهُم غيرُهُ. فلمَّا أتاهمُ النَّبيُّ صلَّى اللَّهُ علَيهِ وسلَّمَ أخبَروهُ الخبرَ. فقالَ : يا فلانُ ، ما يمنعُكَ ممَّا يأمرُ بِهِ أصحابُكَ ، وما يحمِلُكَ أن تقرأَ هذِهِ السُّورةَ في كلِّ رَكْعةٍ ؟ فقالَ : يا رسولَ اللَّهِ إنِّي أُ",["حبُّها",1],". فقالَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ : إنَّ حُبَّها ",["أدخلَكَ الجنَّةَ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"حسن صحيح","takhrij":"أخرجه البخاري معلقاً بصيغة الجزم (774)، وأخرجه موصولاً الترمذي (2901) واللفظ له","bab":"مناقب وفضائل › بعض من شهد النبي بأنهم من أهل الجنة","dorar":"62OuPZHT","merged":8,"otherRefs":["المستدرك على الصحيحين 798 (صحيح)","جامع الرسائل لابن تيمية 2/257 (صحيح)","تخريج المسند لشعيب 12433 (صحيح)","المستخرج على المستدرك 115 (صحيح)","الأحاديث المختارة 1749 (صحيح)","الأحاديث المختارة 1750 (صحيح)","الأحاديث المختارة 1751 (صحيح)"]},{"id":"س-04209","fp":"8a5ba6aeb793","stateId":697,"easy":"إذا قرأت القرآن وتعلمته وعملت به ← تُلبس يوم القيامة تاجاً من نور ضوؤه كالشمس","cause":"مَنْ قَرَأَ القرآنَ وتَعلَّمهُ وعَمِلَ به","result":"أُلبِسَ يومَ القيامةِ تاجًا مِن نورٍ ضَوؤهُ مثلُ ضَوءِ الشَّمسِ، ويُكسى والديهِ حُلَّتانِ لا يَقومُ لهما الدُّنيا فيقولانِ: بما كُسِينا هذا","explicit":true,"star":true,"similar":["س-04249"],"otherNeedIds":[15],"ref":"المستدرك على الصحيحين 2116","srcLabel":"مسلم","text":[["مَنْ قَرَأَ القرآنَ وتَعلَّمهُ وعَمِلَ به؛ ",1],["أُلبِسَ يومَ القيامةِ تاجًا مِن نورٍ ضَوؤهُ مثلُ ضَوءِ الشَّمسِ، ويُكسى والديهِ حُلَّتانِ لا يَقومُ لهما الدُّنيا فيقولانِ: بما كُسِينا هذا",2],"؟ فيقالُ: بأَخذِ ولَدِكُما القرآنَ."],"grade":"صحيح","narrator":"بريدة الأسلمي","muhaddith":"صحيح على شرط مسلم","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"VeJuGb00"},{"id":"ق-1029","fp":"e73c61d21ba8","stateId":697,"easy":"وراثة الكتاب والسبق بالخيرات ← جنات عدن وذهاب الحزن ودار المقامة بلا نصب","cause":"وراثة الكتاب والسبق بالخيرات","result":"جنات عدن وذهاب الحزن ودار المقامة بلا نصب","explicit":true,"star":true,"otherNeedIds":[6],"ref":"سورة فاطر: 32–35","srcLabel":"القرآن الكريم","quran":{"s":35,"from":32,"to":35,"text":"ثُمَّ أَوْرَثْنَا الْكِتَابَ الَّذِينَ اصْطَفَيْنَا مِنْ عِبَادِنَا فَمِنْهُمْ ظَالِمٌ لِنَفْسِهِ وَمِنْهُمْ مُقْتَصِدٌ وَمِنْهُمْ سَابِقٌ بِالْخَيْرَاتِ بِإِذْنِ اللَّهِ ذَلِكَ هُوَ الْفَضْلُ الْكَبِيرُ (32) جَنَّاتُ عَدْنٍ يَدْخُلُونَهَا يُحَلَّوْنَ فِيهَا مِنْ أَسَاوِرَ مِنْ ذَهَبٍ وَلُؤْلُؤًا وَلِبَاسُهُمْ فِيهَا حَرِيرٌ (33) وَقَالُوا الْحَمْدُ لِلَّهِ الَّذِي أَذْهَبَ عَنَّا الْحَزَنَ إِنَّ رَبَّنَا لَغَفُورٌ شَكُورٌ (34) الَّذِي أَحَلَّنَا دَارَ الْمُقَامَةِ مِنْ فَضْلِهِ لَا يَمَسُّنَا فِيهَا نَصَبٌ وَلَا يَمَسُّنَا فِيهَا لُغُوبٌ (35)","hl":[[0,544,1]]}},{"id":"س-06405","fp":"9071575f05cb","stateId":697,"easy":"إذا قرأت آية الكرسي دبر كل صلاة ← لا يمنعك من دخول الجنة إلا الموت","cause":"من قرأَ آيةَ الكرسيِّ في دُبرِ كلِّ صلاةٍ","result":"لم يمنعْهُ من دخولِ الجنَّةِ إلَّا الموتُ","explicit":true,"apply":{"k":"read","t":"آية الكرسي · الوقت: دبر كل صلاة"},"repOf":"س-07810","ref":"هداية الرواة 1/436","text":[["من قرأَ آيةَ الكرسيِّ في دُبرِ كلِّ صلاةٍ ؛ ",1],["لم يمنعْهُ من دخولِ الجنَّةِ إلَّا الموتُ",2]," ، ومن قرأها حينَ يأخذُ مضجعَهُ ؛ آمنَهُ اللَّهُ على دارِهِ ودارِ جارِهِ ، ودويراتٍ حولَهُ"],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"له شاهد صحيح","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (2395)، وابن الجوزي في ((الموضوعات)) (1/243) باختلاف يسير","bab":"صلاة › أدعية دبر الصلوات","dorar":"UvvMmMtc","merged":2,"otherRefs":["المقرر على أبواب المحرر (1/ 248) (صحيح)"]},{"id":"س-00683","fp":"d5fc7186b737","stateId":697,"easy":"إذا أقمت العشر الأولى من سورة المؤمنون ← تدخل الجنة","cause":"ثم قال: قد أفلح المؤمنون [ المؤمنون : 1 ] حتى خَتم عشْرَ آياتٍ","result":"عشْرُ آياتٍ من أقامهُن دخل الجنةَ","explicit":true,"similar":["س-04252"],"ref":"أحكام القرآن لابن العربي 3/311","srcLabel":"الترمذي","text":["[عن عبدالرحمن بن عبد القاري قال:] سمعتُ عمرَ بنَ الخطابِ, يقولُ: كان النبيُّ صلى الله عليه وسلم إذا أُنزِلَ عليه الوحيُ يسمعُ عند وجهِه كدويِّ النحلِ ، فأُنزِلَ عليه يومًا فلبثنا ساعةً ثم سُرِّيَ عنه، فاستقبل القبلةَ ورفع يديْه وقال:  اللهم زدنا ولا تَنقُصنا وأكرمنا ولا تُهنا وأعطنا ولا تَحرمنا وآثرنا ولا تؤْثِرَعلينا وأرْضِنا وارْضَ عنا، ثم قال: أُنزِلَ عليَّ ",["عشْرُ آياتٍ من أقامهُن دخل الجنةَ",2],"،",[" ثم قال:  قد أفلح المؤمنون  [ المؤمنون : 1 ] حتى خَتم عشْرَ آياتٍ.",1]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3173)، وأحمد (223)، والنسائي في ((الكبرى)) (1443) باختلاف يسير.","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"tVHt4Jpc"},{"id":"س-00702","fp":"75092c993465","stateId":697,"easy":"إذا قرأت سورة البقرة في ليلة ← تُتوّج بتاج في الجنة","cause":"ومن قرأَ سورةَ البقرةِ في ليلةٍ","result":"تُوِّجَ بتاجٍ في الجنةِ","explicit":true,"apply":{"k":"read","t":"سورة البقرة"},"ref":"فتح القدير 1/35","srcLabel":"البيهقي","text":["اقرؤُوا سورةَ البقرةِ في بيوتِكم ولا تجعلُوها قبورًا قال ",["ومن قرأَ سورةَ البقرةِ في ليلةٍ ",1],["تُوِّجَ بتاجٍ في الجنةِ",2]],"grade":"صحيح","narrator":"الصلصال بن الدلهمس","muhaddith":"سنده صحيح","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (2385) نصفه الأول.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"6A9lW0sc"},{"id":"س-00712","fp":"9e762dc5c1f4","stateId":697,"easy":"إذا قرأت آية الكرسي بعد كل صلاة ← لا يمنعك من دخول الجنة إلا أن تموت","cause":"من قالها [يعني : آيةَ الكرسيِّ] بعد كلِّ صلاةٍ","result":"لم يمنعْهُ من دخولِ الجنَّةِ إلَّا أن يموتَ","explicit":true,"apply":{"k":"read","t":"آية الكرسي · الوقت: دبر كل صلاة"},"repOf":"س-07810","ref":"مجموع فتاوى ابن باز 50/11","text":[["من قالها [يعني : آيةَ الكرسيِّ] بعد كلِّ صلاةٍ ",1],["لم يمنعْهُ من دخولِ الجنَّةِ إلَّا أن يموتَ",2]],"grade":"صحيح","muhaddith":"صحيح [بطرقه]","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"D5QVFxkD"},{"id":"س-02923","fp":"5045543f7b19","stateId":697,"easy":"إذا جعلت القرآن أمامك ← يقودك إلى الجنة","cause":"مَنْ جعلَهُ أمامَهُ","result":"قادَهُ إلى الجنةِ","explicit":true,"similar":["س-07690"],"ref":"صحيح الجامع 4443","srcLabel":"صحيح الجامع","text":["القرآنُ شافع مُشفَّعٌ ، وماحِلٌ مصدَّقٌ ، ",["مَنْ جعلَهُ أمامَهُ ",1],["قادَهُ إلى الجنةِ",2]," ، ومَنْ جعلَهُ خلْفَهُ ساقَهُ إلى النارِ"],"grade":"صحيح","narrator":"جابر بن عبدالله وابن مسعود","muhaddith":"صحيح","bab":"إيمان › الوعيد","dorar":"BSET0YTU"},{"id":"س-04249","fp":"585d5cd8019b","stateId":697,"easy":"إذا قرأت القرآن وعملت بما فيه ← يُلبس والدك يوم القيامة تاجاً أحسن من ضوء الشمس","cause":"مَنْ قَرَأَ القرآنَ، وعَمِلَ بما فيه","result":"أُلبِسَ والدُهُ يومَ القيامةِ تاجًا ضَوؤهُ أحسنُ مِن ضَوءِ الشَّمسِ في بيوتِ الدُّنيا لوْ كانت فيه، فما ظنُّكُم بالَّذي عَمِلَ به","explicit":true,"repOf":"س-04209","ref":"المستدرك على الصحيحين 2115","text":[["مَنْ قَرَأَ القرآنَ، وعَمِلَ بما فيه؛ ",1],["أُلبِسَ والدُهُ يومَ القيامةِ تاجًا ضَوؤهُ أحسنُ مِن ضَوءِ الشَّمسِ في بيوتِ الدُّنيا لوْ كانت فيه، فما ظنُّكُم بالَّذي عَمِلَ به",2],"؟"],"grade":"صحيح","narrator":"معاذ بن أنس الجهني","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داوود (1453)، وأحمد (15645) ،الترمذي (514)واللفظ لهم.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"HboFlUtJ"},{"id":"س-04252","fp":"35807ed6b318","stateId":697,"easy":"إذا أقمت العشر الأولى من «قد أفلح المؤمنون» ← تدخل الجنة","cause":"ثُمَّ قَرَأَ: {قَدْ أَفْلَحَ الْمُؤْمِنُونَ (1) الَّذِينَ هُمْ فِي صَلَاتِهِمْ خَاشِعُونَ} [المؤمنون: 1، 2] الآياتِ","result":"عشرُ آياتٍ مَنْ أقامهُنَّ دَخَلَ الجنَّةَ","explicit":true,"apply":{"k":"say","t":"«قد أفلح المؤمنون»"},"repOf":"س-00683","ref":"المستدرك على الصحيحين 3525","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ إذا نَزَلَ عليه الوحيُ سُمِعَ عنده دَويٌّ كدوِيِّ النَّحلِ، فمَكثْنا ساعةً، فاستقبلَ القِبلةَ، ورَفَعَ يديْهِ، فقالَ: «اللَّهُمَّ زِدْنا ولا تَنقُصْنا، وأكرِمْنا، ولا تُهِنَّا، وأَعطِنا، ولا تَحرِمْنا، وآثِرْنا، ولا تُؤثِرْ علينا، وارضَ عنَّا وأَرضِنا». ثُمَّ قالَ: «لقد أُنزلَ عَلَيَّ ",["عشرُ آياتٍ مَنْ أقامهُنَّ دَخَلَ الجنَّةَ»",2],"،",[" ثُمَّ قَرَأَ: {قَدْ أَفْلَحَ الْمُؤْمِنُونَ (1) الَّذِينَ هُمْ فِي صَلَاتِهِمْ خَاشِعُونَ} [المؤمنون: 1، 2] الآياتِ.",1]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (3173)، وأحمد (223)، والنسائي في ((الكبرى)) (1443) واللفظ لهم.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"Ethu8Orf"},{"id":"س-07647","fp":"3e8197848095","stateId":697,"easy":"إذا قرأت «قل هو الله أحد» عشر مرات ← يبني الله لك قصراً في الجنة","cause":"من قرأ { قُلْ هُوَ اللهُ أَحَدٌ } حتى يختمَها عشرَ مراتٍ","result":"بنى اللهُ له قصرًا في الجنَّةِ","explicit":true,"apply":{"k":"say","t":"«قل هو الله أحد» · العدد: عشر مرات"},"ref":"السلسلة الصحيحة 2/136","srcLabel":"الطبراني","text":[["من قرأ { قُلْ هُوَ اللهُ أَحَدٌ } حتى يختمَها عشرَ مراتٍ ",1],["بنى اللهُ له قصرًا في الجنَّةِ",2]," ومن قرأها عشرين مرةً بني له قصرانِ ومن قرأها ثلاثينَ مرَّةً بُنِيَ له ثلاثٌ"],"grade":"صحيح","narrator":"معاذ بن أنس","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (281).، من حديث  أبي هريرة .","bab":"فضائل سور وآيات › سورة الإخلاص","dorar":"mSVq39Dx"},{"id":"س-07648","fp":"180a81683a84","stateId":697,"easy":"إذا قرأتها عشرين مرة ← يُبنى لك قصران","cause":"ومن قرأها عشرين مرةً","result":"بني له قصرانِ","explicit":true,"apply":{"k":"count","t":"عشرين مرة"},"ref":"السلسلة الصحيحة 2/136","srcLabel":"الطبراني","text":["من قرأ { قُلْ هُوَ اللهُ أَحَدٌ } حتى يختمَها عشرَ مراتٍ بنى اللهُ له قصرًا في الجنَّةِ ",["ومن قرأها عشرين مرةً",1]," ",["بني له قصرانِ",2]," ومن قرأها ثلاثينَ مرَّةً بُنِيَ له ثلاثٌ"],"grade":"صحيح","narrator":"معاذ بن أنس","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (281).، من حديث  أبي هريرة .","bab":"فضائل سور وآيات › سورة الإخلاص","dorar":"mSVq39Dx"},{"id":"س-07649","fp":"48df5c2d628d","stateId":697,"easy":"إذا قرأتها ثلاثين مرة ← يُبنى لك ثلاثة","cause":"ومن قرأها ثلاثينَ مرَّةً","result":"بُنِيَ له ثلاثٌ","explicit":true,"apply":{"k":"count","t":"ثلاثين مرة"},"ref":"السلسلة الصحيحة 2/136","srcLabel":"الطبراني","text":["من قرأ { قُلْ هُوَ اللهُ أَحَدٌ } حتى يختمَها عشرَ مراتٍ بنى اللهُ له قصرًا في الجنَّةِ ومن قرأها عشرين مرةً بني له قصرانِ ",["ومن قرأها ثلاثينَ مرَّةً",1]," ",["بُنِيَ له ثلاثٌ",2]],"grade":"صحيح","narrator":"معاذ بن أنس","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (281).، من حديث  أبي هريرة .","bab":"فضائل سور وآيات › سورة الإخلاص","dorar":"mSVq39Dx"},{"id":"س-08393","fp":"dc0723d347be","stateId":697,"easy":"إذا قرأت «قل هو الله أحد» ← وجبت لك الجنة","cause":"يقرَأُ: قُلْ هُوَ اللَّهُ أَحَدٌ","result":"وَجَبَتْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«قل هو الله أحد»"},"ref":"تخريج شرح السنة 1211","srcLabel":"الترمذي","text":["أقبلتُ مَعَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فسمِعَ رجُلًا ",["يقرَأُ: {قُلْ هُوَ اللَّهُ أَحَدٌ",1]," (1) اللَّهُ الصَّمَدُ (2) لَمْ يَلِدْ وَلَمْ يُولَدْ (3) وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ} [الإخلاص: 1 - 4]، فقالَ: قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["وَجَبَتْ",2],"، فسألتُهُ: ماذا يا رسولَ اللهِ؟ فقالَ: الجنَّةُ، فقالَ أبو هُريرةَ: فأردْتُ أنْ أذهَبَ إلى الرَّجُلِ فأُبَشِّرَهُ، ثُمَّ فَرِقْتُ أنْ يَفوتَني الغَداءُ مَعَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فآثَرْتُ الغَداءَ، ثُمَّ ذهبتُ إلى الرَّجُلِ، فوجدتُهُ قدْ ذهَبَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه مالك (709) بلفظه، والترمذي (2897)، والنسائي (994)، وأحمد (8011) جميعا بلفظ مقارب دون قصة أبي هريرة .","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"EdLMI6rA","merged":6,"otherRefs":["تخريج المسند لشعيب 10919 (صحيح)","تخريج المسند لشعيب 22289 (صحيح)","تخريج المسند لشعيب 23194 (صحيح)","التمهيد 7/254 (صحيح)","صحيح النسائي 993 (صحيح)"]},{"id":"س-00713","fp":"755db1abaf0b","stateId":697,"easy":"إذا قرأت آية الكرسي عقب كل صلاة ← ليس بينك وبين الجنة إلا الموت","cause":"من قرأ آيةَ الكرسيِّ عقبَ كلِّ صلاةٍ","result":"ليس بينه وبين الجنَّةِ إلا أنْ يموتَ","explicit":true,"apply":{"k":"read","t":"آية الكرسي"},"repOf":"س-07810","ref":"فتاوى نور على الدرب لابن باز 4/299","text":[["من قرأ آيةَ الكرسيِّ عقبَ كلِّ صلاةٍ",1]," ",["ليس بينه وبين الجنَّةِ إلا أنْ يموتَ",2],"."],"grade":"حسن","muhaddith":"جاء في هذا عدة أحاديث مجموعها حسن","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"45dXlSSh"},{"id":"س-02906","fp":"0f06c297aa94","stateId":697,"easy":"إذا قرأت القرآن صابراً محتسباً ← لك بكل حرف زوجة من الحور العين (على رواية)","cause":"فمن قرأَهُ صابرًا مُحْتَسِبًا","result":"كان له بكلِّ حرفٍ زوجَةً منَ الحورِ العينِ","explicit":true,"ref":"مجمع الزوائد 7/166","srcLabel":"الطبراني","text":["القرآنُ ألفُ ألفِ حرفٍ وسبعةٌ وعشرونَ ألفَ حرفٍ ",["فمن قرأَهُ صابرًا مُحْتَسِبًا",1]," ",["كان له بكلِّ حرفٍ زوجَةً منَ الحورِ العينِ",2]],"grade":"حسن","narrator":"عمر بن الخطاب","muhaddith":"[فيه] محمد بن عبيد بن آدم بن أبي إياس ذكره الذهبي في الميزان لهذا الحديث ولم أجد لغيره في ذلك كلاما وبقية رجاله ثقات","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6616 )","bab":"إيمان › الوعد","dorar":"SGyhdZTU"},{"id":"س-04264","fp":"a135207f0ad7","stateId":697,"easy":"إذا تعلمت القرآن وحفظته ← يدخلك الله الجنة ويشفعك في عشرة من أهل بيتك","cause":"مَن تعلَّمَ القرآنَ وحفِظَه","result":"أدخلَه اللهُ الجنَّةَ ، وشَفَّعَه في عَشرةٍ مِن أهلِ بيتِه ، كلٌّ قَد استوجَبَ النارَ","explicit":true,"otherNeedIds":[65],"ref":"لسان الميزان 5/525","srcLabel":"الخطيب","text":[["مَن تعلَّمَ القرآنَ وحفِظَه : ",1],["أدخلَه اللهُ الجنَّةَ ، وشَفَّعَه في عَشرةٍ مِن أهلِ بيتِه ، كلٌّ قَد استوجَبَ النارَ",2]],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"رواته ثقات غير علي بن الحسين السقطي","takhrij":"أخرجه الخطيب في ((تاريخ بغداد)) (11/395) واللفظ له، وابن الجوزي في ((العلل المتناهية)) (154)","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"H9KyqjFW"},{"id":"س-07639","fp":"de28be5f7600","stateId":697,"easy":"إذا نمت على يمينك فقرأت «قل هو الله أحد» مئة مرة ← يقال لك يوم القيامة: ادخل على يمينك الجنة","cause":"من أرادَ أن ينامَ على فراشِهِ فنامَ على يمينِهِ ثمَّ قرأَ مئةَ مرَّةٍ قُلْ هُوَ اللَّهُ أَحَدٌ","result":"ادخل على يمينِكَ الجنَّةَ","explicit":true,"apply":{"k":"say","t":"«قل هو الله أحد» · العدد: مئة مرة · الوقت: عند النوم"},"ref":"هداية الرواة 2/382","srcLabel":"الترمذي","text":[["من أرادَ أن ينامَ على فراشِهِ فنامَ على يمينِهِ ثمَّ قرأَ مئةَ مرَّةٍ قُلْ هُوَ اللَّهُ أَحَدٌ",1]," فإذا كانَ يومُ القيامةِ يقولُ لهُ الرَّبُّ يا عبدِيَ ",["ادخل على يمينِكَ الجنَّةَ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه الترمذي (2898)، وابن عدي في ((الكامل في الضعفاء)) (2/439)، والبيهقي في ((شعب الإيمان)) (2549)","bab":"فضائل سور وآيات › سورة الإخلاص","dorar":"FEyImC3c"},{"id":"س-07690","fp":"fdef1a4fb06a","stateId":697,"easy":"إذا اتبعت القرآن ← يقودك إلى الجنة","cause":"ومنِ اتَّبعَهُ","result":"قادَهُ إلى الجنَّةِ","explicit":true,"repOf":"س-02923","otherNeedIds":[65],"ref":"الترغيب والترهيب 1/62","text":["عن عبدِ اللَّهِ بنِ مسعودٍ قالَ إنَّ هذا القرآنَ شافعٌ مشفَّعٌ ",["ومنِ اتَّبعَهُ",1]," ",["قادَهُ إلى الجنَّةِ",2]," ومن ترَكَهُ أو أعرضَ عنهُ ( أو كلمةً نحوَها ) زَجَّ في قفاهُ إلى النَّارِ"],"grade":"حسن","muhaddith":"[روي] مرفوعا من حديث جابر وإسناد المرفوع جيد","bab":"قرآن › آداب الناس كلهم مع القرآن","dorar":"V1VHEACZ"},{"id":"س-03664","fp":"d89aecaaf229","stateId":697,"easy":"إذا حفظت أمانة من حملك ← تُكسى حلة الإستبرق ويُعقد لك تاج الملك","cause":"ويُؤتى بالعَبدِ الصالِحِ قد كان حملَه فحفِظ أمرَه","result":"حتَّى يكسوَه حُلَّةَ الإستَبرقِ ، ويَعقدَ عليهِ تاجَ الملكِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[51],"ref":"المطالب العالية 4/73","srcLabel":"ابن أبي شيبة","text":["يتمثَّلُ القرآنُ يومَ القيامةِ ، فيُؤتى بالرَّجلِ قد كان حملَه [ فخالَف أمرَه ] ، فيتمثَّلُ خصمُا دونَه ، قال : فيقولُ : يا ربِّ ، حَمَّلتَه إيَّايَ ، فشرُّ حاملٍ ، تعدَّى حدودي ، وضيَّع فرائِضي ، وركِب معصيتي ، وترَك طاعتي ، فما يزالُ يقذِفُ عليهِ بالحُجَجِ حتَّى يُقالَ : فشأنَك بهِ ، فيأخذُ بيدِه ما يُرسلُه حتَّى يَكبَّه على صخرةٍ في النَّارِ ، ",["ويُؤتى بالعَبدِ الصالِحِ قد كان حملَه فحفِظ أمرَه",1]," ، فيتمثَّلُ خصمًا دونَه فيقولُ : يا ربِّ ، حمَّلتَه إيَّايَ فكان خيرَ حاملٍ ، حفِظ حدودي ، وعمِلَ بفرائضي ، واجتَنب مَعصيتي ، وعمِل بطاعَتي ، وما يزالُ يقذفُ لهُ بالحُججِ حتَّى يُقالَ [ لهُ ] : شأنُك بهِ ، فيأخذُ بيدِه فما يُرسلُه ",["حتَّى يكسوَه حُلَّةَ الإستَبرقِ ، ويَعقدَ عليهِ تاجَ الملكِ",2]," ، ويَسقيَه كأسَ الخَمرِ"],"grade":"حسن","narrator":"[جد عمرو بن شعيب]","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن أبي شيبة (30044) واللفظ له، وابن شاهين في ((الترغيب)) (207)، والخطيب في ((اقتضاء العلم)) (112) بنحوه.","bab":"اعتصام بالسنة › الأمر بالتمسك بالكتاب والسنة","dorar":"8ONK4OdI"},{"id":"س-07860","fp":"b49aa5dec08e","stateId":698,"easy":"إذا أنفقت زوجين من مالك ← تناديك كل خزنة الجنة","cause":"فَمَن أنفَقَ زَوجَينِ مِن مالِه","result":"فَكلُّ خَزَنةِ الجنَّةِ تُناديه","explicit":true,"star":true,"similar":["س-01786"],"ref":"تخريج كتاب السنة 632","srcLabel":"مسلم","text":["هلْ تَرونَ القَمرَ ليلةَ البَدرِ؟ قُلنا: نَعَم، قال: فَهلْ تَروْنَ الشَّمسَ في يومٍ مُصْحِيَةٍ؟ قالوا: نَعَم، قال: فإنَّكم سَتَروْنَ ربَّكُم كَما تَروْنَها، لا تُضارُّونَ في رُؤيَته، يَقولُ اللهُ تَبارَك وَتَعالى: أيْ فُلانُ، للرَّجلِ مِن أهلِ الجاهليَّةِ، أَلم أُكرِمْك؟ ألَمْ أُريِّسْكَ؟ ألَمْ أُسخِّرْ لكَ الخيلَ وَالإِبلَ؟ ألَمْ أَذرْكَ تَرأَسُ وَتربَعُ؟ فيَقولُ: بَلى يا ربِّ، قال: فيَقولُ: فهَل ظَننْتَ أنَّك مُلاقِيَّ؟ قال: فيَقولُ: لا واللهِ يا رَبِّ، قال: فيَقولُ: إنِّي أَنساكَ كَما نَسيتَني! قال: ثُمَّ يُؤتَى بِرجُلٍ، فيَقولُ اللهُ كَما قال لِلأوَّلِ، وَيقولُ مِثلَ ما قال الأوَّلُ، قال: فيَقولُ: فإنِّي أَنساكَ كَما نَسيتَني، قال: ثُمَّ يُؤتَى بِالثَّالثِ، فيَقولُ كَما قال للأوَّلِ وَللثَّاني، فيَقولُ: أيْ ربِّ، آمَنتُ بِك وَبِكتابِكَ وَبِرسولِك، وَتصدَّقتُ وصَلَّيتُ، فلا يَدَعُ أن يَأتيَ بِما استَطاع، فيَقولُ اللهُ تَباركَ وَتَعالى: فها هنا إذًا! فيَقولُ اللهُ: أفَلا نَبعَثُ شاهِدًا عليكَ؟ فيَتفكَّرَ في نَفسِه: مَن ذا الَّذي يَشهَدُ عليَّ؟! فيَختِمُ اللهُ على فيه، ويَنطِقُ فَخِذُه، ويَشهَدُ عَليهِ عِظامُه ولَحمُه بِما كانَ يَعمَلُ، وَذلكَ لِيُعذَرَ مِن نَفسِه، قال: وتَشهَدُ عليهِم أَلسِنَتُهم وأيديهِم وأرجُلُهم بِما كانوا يَعمَلونَ، قال: فيَقومُ مُنادٍ، فيُنادي: ألَا يَتْبَعُ كلُّ أُمَّةٍ ما كانتْ تَعبُدُ، فيَتبَعُ أَصحابُ الشَّياطينِ الشَّياطينَ، وأَصحابُ الأَصنامِ الأَصنامَ، وَمَن كانَ يَعبدُ شَيئًا اتَّبعَه، حتَّى يُورِدوهنَّ جَهنَّمَ! قال النَّبيُّ: وَنَبقى أيُّها المُؤمنونَ، فيَقولُها ثَلاثًا، فنُقامُ عَلى مَقامِ هؤلاءِ، فنَقولُ: نَحنُ المُؤمنونَ، فيَقولونَ: آمَنَّا باللهِ ولَم نُشرِكْ بِه شَيئًا، وهَذا مَقامُنا حتَّى يَأتيَنا رَبُّنا، وَهوَ يَأتينا، ثُمَّ يَنطَلِقونَ، حتَّى يَأتوا الصِّراطَ أوِ الجِسرَ، وعَليه كَلاليبُ مِن نارٍ يَخطَفُ النَّاسَ، فعِندَ ذلكَ حَلَّتِ الشَّفاعةُ: اللَّهمَّ سلِّمْ سلِّمْ، اللَّهمَّ سلِّمْ سلِّمْ، فإذا جاوَزَ الجِسرَ، ",["فَمَن أنفَقَ زَوجَينِ مِن مالِه",1]," ",["فَكلُّ خَزَنةِ الجنَّةِ تُناديه",2],": يا عَبدَ اللهِ، يا مُسلِمُ، هذا خيرٌ فتَعالَ، قال: فقال أبو بَكرٍ: إنَّ العبدَ لا ثِواءَ عَليهِ، قال: إنِّي لَأرجو أنْ تَكونَ مِنهُم."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده جيد على شرط مسلم","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (632) واللفظ له، ومسلم (2968) بنحوه، والترمذي (2428) بنحوه مختصرا.","bab":"قيامة › الحساب والقصاص","dorar":"MmopzfJ3","merged":9,"otherRefs":["صحيح ابن حبان 4641 (صحيح)","تخريج المسند لشعيب 8790 (صحيح)","تخريج المسند لشعيب 21341 (صحيح)","البحر الزخار 9/349 (صحيح)","تخريج صحيح ابن حبان 4645 (صحيح)","تخريج المسند لشعيب 21413 (صحيح)","صحيح البخاري 3216 (صحيح)","تخريج صحيح ابن حبان 4644 (صحيح)"]},{"id":"س-02286","fp":"7e16879f40f2","stateId":698,"easy":"إذا حفرت ماءً يشرب منه كبد حرى ← يأجرك الله ويبني لك بيتاً في الجنة","cause":"مَن حفرَ ماءً لم يشرَب منهُ كَبدٌ حرَّى مِن جنٍّ ولا إنسٍ ولا طائرٍ إلَّا آجرَهُ اللَّهُ يومَ القيامةِ، ومن بنى مسجدًا كمِفحَصِ قطاةٍ أو أصغرَ","result":"بنَى اللَّهُ لَهُ بَيتًا في الجنَّةِ","explicit":true,"star":true,"ref":"صحيح ابن خزيمة 2/ 444","srcLabel":"البخاري","text":[["مَن حفرَ ماءً لم يشرَب منهُ كَبدٌ حرَّى مِن جنٍّ ولا إنسٍ ولا طائرٍ إلَّا آجرَهُ اللَّهُ يومَ القيامةِ، ومن بنى مسجدًا كمِفحَصِ قطاةٍ أو أصغرَ ",1],["بنَى اللَّهُ لَهُ بَيتًا في الجنَّةِ ",2],"[وفي روايةٍ]: من سبعٍ ولا طائرٍ، وقالَ: كمِفحَصِ قطاةٍ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري في ((التاريخ الكبير)) (2/8) واللفظ له، وابن ماجه (738) بشطره الأخير، والطحاوي في ((شرح مشكل الآثار)) (1557)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"KpLw1v7a"},{"id":"س-06309","fp":"b8d7b3c1902b","stateId":698,"easy":"إذا تصدقت بلقمة الخبز أو قبضة التمر مما ينفع المسكين ← يدخل الله بها ثلاثة الجنة: الآمر والصانع والمناول","cause":"بلُقْمَةِ الخُبْزِ وقَبْضةِ التَّمرِ ومِثْلِهِ ممَّا يَنفَعُ المسكينَ","result":"ثَلاثةً الجَنَّةَ: الآمِرَ بِه، والزَّوجةَ المُصلِحةَ، والخادمَ الَّذي يُناوِلُ المِسكينَ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 7389","srcLabel":"مسلم","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: إنَّ اللهَ تَعالَى لَيُدْخِلُ ",["بلُقْمَةِ الخُبْزِ وقَبْضةِ التَّمرِ ومِثْلِهِ ممَّا يَنفَعُ المسكينَ",1],"؛ ",["ثَلاثةً الجَنَّةَ: الآمِرَ بِه، والزَّوجةَ المُصلِحةَ، والخادمَ الَّذي يُناوِلُ المِسكينَ",2],". وقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: الحمْدُ للهِ الَّذي لم يَنْسَ خَدَمَنا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه ابن شاهين في ((الترغيب)) (376)، وابن الفاخر في ((موجبات الجنة)) (229)، وابن عساكر في ((تاريخ دمشق)) (54/ 360) باختلاف يسير.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"5ZKQO5hH"},{"id":"س-06616","fp":"3c72443321d8","stateId":698,"easy":"إذا أنفقت زوجين في سبيل الله ← تُنادى من أبواب الجنة: يا عبد الله هذا خير","cause":"مَن أنفَقَ زَوجَينِ في سَبيلِ اللهِ","result":"نوديَ مِن أبوابِ الجَنَّةِ: يا عَبدَ اللهِ، هذا خَيرٌ","explicit":true,"star":true,"similar":["س-06796"],"ref":"صحيح البخاري 1897","srcLabel":"مسلم","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: ",["مَن أنفَقَ زَوجَينِ في سَبيلِ اللهِ ",1],["نوديَ مِن أبوابِ الجَنَّةِ: يا عَبدَ اللهِ، هذا خَيرٌ",2],"، فمَن كان مِن أهلِ الصَّلاةِ دُعيَ مِن بابِ الصَّلاةِ، ومَن كان مِن أهلِ الجِهادِ دُعيَ مِن بابِ الجِهادِ، ومَن كان مِن أهلِ الصِّيامِ دُعيَ مِن بابِ الرَّيَّانِ، ومَن كان مِن أهلِ الصَّدَقةِ دُعيَ مِن بابِ الصَّدَقةِ، فقال أبو بَكرٍ رَضيَ اللهُ عنه: بأبي أنتَ وأُمِّي يا رَسولَ اللهِ، ما على مَن دُعيَ مِن تلك الأبوابِ مِن ضَرورةٍ، فهل يُدعى أحَدٌ مِن تلك الأبوابِ كُلِّها؟ قال: نَعَم، وأرجو أن تَكونَ منهم."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1027) باختلاف يسير","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"ZctSLGE5"},{"id":"ق-1436","fp":"b3c5c291ad92","stateId":698,"easy":"فكّ الرقبة وإطعام اليتيم والمسكين في المسغبة مع الإيمان والتواصي بالصبر والمرحمة ← اقتحام العقبة وأصحاب الميمنة","cause":"فكّ الرقبة وإطعام اليتيم والمسكين في المسغبة مع الإيمان والتواصي بالصبر والمرحمة","result":"اقتحام العقبة وأصحاب الميمنة","explicit":true,"star":true,"otherNeedIds":[65],"ref":"سورة البلد: 11–18","srcLabel":"القرآن الكريم","quran":{"s":90,"from":11,"to":18,"text":"فَلَا اقْتَحَمَ الْعَقَبَةَ (11) وَمَا أَدْرَاكَ مَا الْعَقَبَةُ (12) فَكُّ رَقَبَةٍ (13) أَوْ إِطْعَامٌ فِي يَوْمٍ ذِي مَسْغَبَةٍ (14) يَتِيمًا ذَا مَقْرَبَةٍ (15) أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ (16) ثُمَّ كَانَ مِنَ الَّذِينَ آمَنُوا وَتَوَاصَوْا بِالصَّبْرِ وَتَوَاصَوْا بِالْمَرْحَمَةِ (17) أُولَئِكَ أَصْحَابُ الْمَيْمَنَةِ (18)","hl":[[0,328,1]]}},{"id":"س-04036","fp":"222711a2126d","stateId":698,"easy":"إذا سقيت كلباً يأكل الثرى من العطش ← يشكر الله لك ويدخلك الجنة","cause":"أنَّ رَجُلًا رَأى كَلبًا يَأكُلُ الثَّرى مِنَ العَطَشِ، فأخَذَ الرَّجُلُ خُفَّه، فجَعَلَ يَغرِفُ له به حتَّى أرواه","result":"فشَكَرَ اللهُ له فأدخَلَه الجَنَّةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[45],"ref":"صحيح البخاري 173","srcLabel":"مسلم","text":[["أنَّ رَجُلًا رَأى كَلبًا يَأكُلُ الثَّرى مِنَ العَطَشِ، فأخَذَ الرَّجُلُ خُفَّه، فجَعَلَ يَغرِفُ له به حتَّى أرواه",1],"، ",["فشَكَرَ اللهُ له فأدخَلَه الجَنَّةَ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2244) باختلاف يسير","bab":"توبة › سعة رحمة الله تعالى وأنها سبقت غضبه","dorar":"A9fE2wyx","merged":2,"otherRefs":["صحيح ابن حبان 543 (صحيح)"]},{"id":"س-06259","fp":"853af0ebc613","stateId":698,"easy":"إذا سقيت مؤمناً على ظمأ ← يسقيك الله يوم القيامة من الرحيق المختوم","cause":"وأيُّما مؤمنٍ سقَى مؤمنًا على ظمأٍ","result":"سقاه اللهُ يومَ القيامةِ من الرَّحيقِ المختومِ","explicit":true,"ref":"الترغيب والترهيب 2/92","srcLabel":"أبو داود","text":["أيُّما مؤمنٍ أطعم مؤمنًا على جوعٍ أطعمه اللهُ يومَ القيامةِ من ثمارِ الجنَّةِ ",["وأيُّما مؤمنٍ سقَى مؤمنًا على ظمأٍ",1]," ",["سقاه اللهُ يومَ القيامةِ من الرَّحيقِ المختومِ",2]," وأيُّما مؤمنٍ كسَا مؤمنًا على عُرْيٍ كساه اللهُ يومَ القيامةِ من حُلَلِ الجنَّةِ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (1682)، والترمذي (2449)، وأبو يعلى (1111) بنحوه.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"6x7scxJf","merged":3,"otherRefs":["الزواجر عن اقتراف الكبائر 1/193 (صحيح)","أسنى المطالب 2/532 (حسن)"]},{"id":"س-06258","fp":"bf8854803395","stateId":698,"easy":"إذا أطعمت مؤمناً على جوع ← يطعمك الله يوم القيامة من ثمار الجنة","cause":"أيُّما مؤمنٍ أطعم مؤمنًا على جوعٍ","result":"أطعمه اللهُ يومَ القيامةِ من ثمارِ الجنَّةِ","explicit":true,"ref":"الترغيب والترهيب 2/92","srcLabel":"أبو داود","text":[["أيُّما مؤمنٍ أطعم مؤمنًا على جوعٍ ",1],["أطعمه اللهُ يومَ القيامةِ من ثمارِ الجنَّةِ",2]," وأيُّما مؤمنٍ سقَى مؤمنًا على ظمأٍ سقاه اللهُ يومَ القيامةِ من الرَّحيقِ المختومِ وأيُّما مؤمنٍ كسَا مؤمنًا على عُرْيٍ كساه اللهُ يومَ القيامةِ من حُلَلِ الجنَّةِ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (1682)، والترمذي (2449)، وأبو يعلى (1111) بنحوه.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"6x7scxJf","merged":2,"otherRefs":["الزواجر عن اقتراف الكبائر 1/193 (صحيح)"]},{"id":"س-06260","fp":"7c0606a4504c","stateId":698,"easy":"إذا كسوت مؤمناً على عري ← يكسوك الله يوم القيامة من حلل الجنة","cause":"وأيُّما مؤمنٍ كسَا مؤمنًا على عُرْيٍ","result":"كساه اللهُ يومَ القيامةِ من حُلَلِ الجنَّةِ","explicit":true,"similar":["س-06337"],"ref":"الترغيب والترهيب 2/92","srcLabel":"أبو داود","text":["أيُّما مؤمنٍ أطعم مؤمنًا على جوعٍ أطعمه اللهُ يومَ القيامةِ من ثمارِ الجنَّةِ وأيُّما مؤمنٍ سقَى مؤمنًا على ظمأٍ سقاه اللهُ يومَ القيامةِ من الرَّحيقِ المختومِ ",["وأيُّما مؤمنٍ كسَا مؤمنًا على عُرْيٍ",1]," ",["كساه اللهُ يومَ القيامةِ من حُلَلِ الجنَّةِ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (1682)، والترمذي (2449)، وأبو يعلى (1111) بنحوه.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"6x7scxJf","merged":2,"otherRefs":["الزواجر عن اقتراف الكبائر 1/193 (صحيح)"]},{"id":"س-07522","fp":"ec47c39c3a39","stateId":698,"easy":"إذا بعت نخلتك أو وهبتها لأخيك ← لك بها نخلة في الجنة","cause":"فمُرْهُ فلْيَبِعْنيها، أو لِيَهَبَها لي، قال: فأبَى الرَّجُلُ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: افعَلْ","result":"ولك بها نَخْلةٌ في الجَنَّةِ","explicit":true,"ref":"تخريج المسند لشعيب 23085","srcLabel":"أحمد","text":["عن بعضِ أصحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ قال: جاء رَجُلٌ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فقال: يا رسولَ اللهِ، إنَّ لفُلانٍ نَخْلةً في حائِطي، ",["فمُرْهُ فلْيَبِعْنيها، أو لِيَهَبَها لي، قال: فأبَى الرَّجُلُ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: افعَلْ",1]," ",["ولك بها نَخْلةٌ في الجَنَّةِ",2],"، فأبَى، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: هذا أبخَلُ النَّاسِ."],"grade":"صحيح","narrator":"رجال من الصحابة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (23085)، وابن أبي شبية في ((المسند)) (967)","bab":"فضائل النبي وصفته ودلائل النبوة › اختصام المؤمنين إليه صلى الله عليه وسلم وحكمه عليهم","dorar":"RnI9NS2L","merged":2,"otherRefs":["مجمع الزوائد 3/130 (صحيح)"]},{"id":"س-00125","fp":"d8ebdfd0611e","stateId":698,"easy":"إذا سقيت أهل بيت لا يشربون الماء إلا غِبّاً ← تجب لك الجنة","cause":"فانظر إلى بعيرٍ من إبلِكَ وسقاءٍ ثمَّ اعمد إلى أهلِ بيتٍ لا يشربونَ الماءَ إلَّا غبًّا فاسقِهم","result":"حتَّى تجبَ لكَ الجنَّةُ","explicit":true,"ref":"مجمع الزوائد 3/135","srcLabel":"الطبراني","text":["أنَّ أعرابيًّا أتى النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ أخبرني بعملٍ يقرِّبني منَ الجنَّةِ ويباعدني عنِ النَّارِ فقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ أوَ هما أعملتاكَ قالَ نعم قالَ تقولُ العدلَ وتعطي الفضلَ قالَ واللَّهِ لا أستطيعُ أن أقولَ العدلَ كلَّ ساعةٍ وما أستطيعُ أن أعطيَ الفضل قالَ فتطعمُ الطَّعامَ وتفشي السَّلامَ قالَ هذهِ أيضًا شديدةٌ قالَ فهل لكَ إبلٌ قالَ نعم قالَ ",["فانظر إلى بعيرٍ من إبلِكَ وسقاءٍ ثمَّ اعمد إلى أهلِ بيتٍ لا يشربونَ الماءَ إلَّا غبًّا فاسقِهم",1]," فلعلَّكَ لا تهلكُ بعيرَكَ ولا يتخرَّقُ سقاؤكَ ",["حتَّى تجبَ لكَ الجنَّةُ",2]," فانطلقَ الأعرابيُّ يكبِّرُ فما انخرقَ سقاؤهُ ولا هلكَ بعيرُهُ حتَّى قُتِلَ شهيدًا"],"grade":"صحيح","narrator":"كدير الضبي","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه عبد الرزاق (19691)، والطبراني في ((المعجم الكبير)) (19/ 187) (422) واللفظ لهما، وابن خزيمة (2503) بنحوه.","bab":"آداب السلام › إفشاء السلام","dorar":"xxPq5FjP"},{"id":"س-04746","fp":"0a8806ea06d8","stateId":698,"easy":"إذا تصدقت بصدقة ابتغاء وجه الله فخُتم لك بها ← دخلت الجنة","cause":"ومَن تَصدَّقَ بصَدَقةٍ ابتِغاءَ وَجْهِ اللهِ خُتِمَ له بها","result":"دَخَلَ الجَنَّةَ","explicit":true,"ref":"تخريج المسند لشعيب 23324","srcLabel":"أحمد","text":["أسْنَدتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ إلى صَدْري، فقال: مَن قال: لا إلهَ إلَّا اللهُ -قال حَسَنٌ: ابتِغاءَ وَجْهِ اللهِ- خُتِمَ له بها دَخَلَ الجَنَّةَ، ومَن صامَ يَومًا ابتِغاءَ وَجْهِ اللهِ خُتِمَ له بها دَخَلَ الجَنَّةَ، ",["ومَن تَصدَّقَ بصَدَقةٍ ابتِغاءَ وَجْهِ اللهِ خُتِمَ له بها ",1],["دَخَلَ الجَنَّةَ",2],"."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (23324) واللفظ له، وابن أبي شيبة كما في ((إتحاف الخيرة المهرة)) للبوصيري (6/420)، والبيهقي في ((الأسماء والصفات)) (651)","bab":"رقائق وزهد › الإخلاص","dorar":"YSSvEYh5"},{"id":"س-06363","fp":"6ce10678fa75","stateId":698,"easy":"إذا تصدقت بصدقة ← فلك مثلها في الجنة","cause":"من تصدق بصدقةٍ","result":"فله مثلُها في الجنةِ","explicit":true,"ref":"العجاب في بيان الأسباب 1/603","srcLabel":"العجاب في بيان الأسباب","text":[["من تصدق بصدقةٍ ",1],["فله مثلُها في الجنةِ",2]," فقال أبو الدحداحِ : إن تصدقت بحديقتي فلي مثلُها في الجنةِ ؟ قال : نعم قال : وأمُّ الدحداحِ معي ؟ قال : نعم ، قال : والصبيةُ ؟ قال : نعم وكان له حديقتان ، فتصدق بأفضلِهما واسمُها الجنينةُ ، فضاعف اللهُ صدقتَه ألفي ألف ضعفٍ فذلك قولُه تعالى : { من ذا الذي يقرضُ اللهَ قرضًا حسنًا فيضاعفَه له أضعافًا كثيرةً } فرجع أبو الدحداحِ إلى حديقتِه فوجد أمَّ الدحداحِ والصبيةَ في الحديقةِ التي جعلها صدقةً فقام على بابِ الحديقةِ ، وتحرجَ أن يدخلها قال : يا أمَّ الدحداحِ قالت : لبيك يا أبا الدحداحِ ، قال : إني قد جعلت حديقتي هذه صدقةً ، واشترطت مثلَها في الجنةِ وأمُّ الدحداحِ معي والصبيةُ معي ، فقالت : بارك اللهُ في ما اشتريت ، فخرجوا منها ، وسلم الحديقةَ للنبيِّ صلى اللهُ عليهِ وسلَّمَ فقال النبيُّ صلى اللهُ عليهِ وسلَّمَ : كم من نخلةٍ تَدَلّي عذوقها لأبي الدحداحِ لو اجتمع على عذقٍ فيها أهل منى أن يقلوه ما أقلوه"],"grade":"صحيح","muhaddith":"[صححه]","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"YKmDYMce"},{"id":"س-06796","fp":"a5af86615f53","stateId":698,"easy":"إذا أنفقت زوجين في سبيل الله ← يدخلك الله من أي أبواب الجنة الثمانية شئت","cause":"ومَن أنفَقَ زَوجَينِ في سَبيلِ اللهِ عزَّ وجلَّ","result":"فإنَّ للجنَّةِ ثَمانيةَ أبْوابٍ، يُدخِلُه اللهُ عزَّ وجلَّ مِن أيِّ بابٍ شاء منها الجنَّةِ","explicit":true,"repOf":"س-06616","ref":"تخريج المسند لشعيب 19437","text":["مَن وُلِدَ له ثلاثةُ أَولادٍ في الإسلامِ، فماتوا قبلَ أنْ يَبلُغوا الحِنثَ، أدخَلَه اللهُ عزَّ وجلَّ الجنَّةَ برَحمتِه إيَّاهم، ومَن شاب شَيبةً في سَبيلِ اللهِ عزَّ وجلَّ كانتْ له نورًا يومَ القيامةِ، ومَن رَمى بسَهمٍ في سَبيلِ اللهِ عزَّ وجلَّ بَلَغَ به العَدوَّ، أصابَ أو أخطَأَ، كان له كعَدلِ رَقبةٍ، ومَن أعتَقَ رَقبةً مؤمنةً أعتَقَ اللهُ بكلِّ عُضوٍ منها عُضوًا منه مِن النَّارِ، ",["ومَن أنفَقَ زَوجَينِ في سَبيلِ اللهِ عزَّ وجلَّ، ",1],["فإنَّ للجنَّةِ ثَمانيةَ أبْوابٍ، يُدخِلُه اللهُ عزَّ وجلَّ مِن أيِّ بابٍ شاء منها الجنَّةِ",2],"."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح دون قوله: \"من ولد له....\" و\"ومن أنفق زوجين\" فصحيح لغيره","takhrij":"أخرجه أبو داود (3966)، والنسائي (3145) مختصرا، والترمذي (1635، 1638) مفرقاً مختصراً، وأحمد (19437) واللفظ له","bab":"عتق وولاء › فضل العتق","dorar":"bTRJfZ4H"},{"id":"س-02671","fp":"e99b63ac89b2","stateId":698,"easy":"إذا بعت مالك لله ← كم من عذق لك في الجنة (من قصة أبي الدحداح)","cause":"بِعني نخلتَكَ بحائطي","result":"كَم مِن عذقٍ رَداحٍ لأبي الدَّحداحِ في الجنَّةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الصحيح المسند 32","srcLabel":"أحمد","text":["أنَّ رجلًا قالَ : يا رسولَ اللَّهِ: إنَّ لفُلانٍ نَخلةً ، وأَنا أقيمُ حائطي بِها ، فأمرهُ أن يُعْطيَني حتَّى أقيمَ حائطي بِها ، فقالَ لَهُ النَّبيُّ صلَّى اللَّهُ عليهِ وعلى آلِهِ وصحبِهِ وسلَّمَ: أعطِها إيَّاهُ بنخلةٍ في الجنَّةِ فأبى ، فأتاهُ أبو الدَّحداحِ فقالَ: ",["بِعني نخلتَكَ بحائطي",1],". ففعلَ ، فأتى النَّبيَّ صلَّى اللَّهُ عليهِ وعلى آلِهِ وصحبِهِ وسلَّمَ فقالَ: يا رسولَ اللَّهِ ، إنِّي قدِ ابتَعتُ النَّخلةَ بحائطي. قالَ: فاجعَلها لَهُ ، فقد أعطيتُكَها. فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وعلى آلِهِ وصحبِهِ وسلَّمَ: ",["كَم مِن عذقٍ رَداحٍ لأبي الدَّحداحِ في الجنَّةِ",2]," قالَها مرارًا. قالَ: فأتى امرأتَهُ فقالَ: يا أمَّ الدَّحداحِ اخرُجي منَ الحائطِ ، فقد بعتُهُ بنخلةٍ في الجنَّةِ. فقالَت: ربحَ البيعُ. أو كلِمةً تشبِهُها ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه أحمد (3/146)، وعبد بن حميد في ((المنتخب)) (2/296)، وابن حبان (16/113) باختلاف يسير.","bab":"إيمان › الاحتساب والنية","dorar":"BWcpOQ9V"},{"id":"س-06336","fp":"5dcf813cf6d4","stateId":698,"easy":"إذا أطعمت جائعاً ← يطعمك الله من ثمار الجنة","cause":"مَن أطعَمَ جائعًا","result":"أطْعَمَه اللهُ مِن ثِمارِ الجنَّةِ","explicit":true,"ref":"أسنى المطالب 2/532","srcLabel":"أسنى المطالب","text":[["مَن أطعَمَ جائعًا ",1],["أطْعَمَه اللهُ مِن ثِمارِ الجنَّةِ، ",2],"ومَن سَقى مُؤمِنًا على ظَمأٍ سَقاهُ اللهُ عزَّ وجلَّ يوْمَ القيامةِ مِن الرَّحيقِ المَختومِ، ومَن كَسا مُؤمِنًا عاريًا كَساهُ اللهُ تعالَى مِن خُضرِ الجنَّةِ."],"grade":"حسن","muhaddith":"إسناده جيد","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"M5Hpafrz"},{"id":"س-06337","fp":"7ad0abc951a9","stateId":698,"easy":"إذا كسوت مؤمناً عارياً ← يكسوك الله من خضر الجنة","cause":"ومَن كَسا مُؤمِنًا عاريًا","result":"كَساهُ اللهُ تعالَى مِن خُضرِ الجنَّةِ","explicit":true,"repOf":"س-06260","ref":"أسنى المطالب 2/532","text":["مَن أطعَمَ جائعًا أطْعَمَه اللهُ مِن ثِمارِ الجنَّةِ، ومَن سَقى مُؤمِنًا على ظَمأٍ سَقاهُ اللهُ عزَّ وجلَّ يوْمَ القيامةِ مِن الرَّحيقِ المَختومِ، ",["ومَن كَسا مُؤمِنًا عاريًا ",1],["كَساهُ اللهُ تعالَى مِن خُضرِ الجنَّةِ",2],"."],"grade":"حسن","muhaddith":"إسناده جيد","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"M5Hpafrz"},{"id":"س-06340","fp":"d6995e8904c3","stateId":698,"easy":"إذا أقرضت الله ← يطلق قدميك (تسرع إلى الجنة)","cause":"فأقْرِضِ اللهَ","result":"يُطلِقْ قدَمَيْكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 5450","srcLabel":"الطبراني","text":["عنْ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أنَّه قالَ: يا ابنَ عَوفٍ، إنَّكَ منَ الأغْنياءِ، ولن تَدخُلَ الجنَّةَ إلَّا زَحفًا، ",["فأقْرِضِ اللهَ",1]," ",["يُطلِقْ قدَمَيْكَ",2]," قالَ ابنُ عَوفٍ: يا رَسولَ اللهِ، فما الَّذي أُقرِضُ اللهَ؟ قالَ: تَتبَرَّأُ ممَّا أنتَ فيه قالَ: يا رَسولَ اللهِ، مِن كلِّه أجمَعَ؟ قالَ: نعمْ، فخرَجَ ابنُ عَوفٍ وهو يهُمُّ بذلك، فأرسَلَ إليه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فقالَ: أتاني جِبْريلُ، فقالَ: مُرِ ابنَ عَوفٍ فلْيُضِفِ الضَّيفَ، ولْيُطعِمِ المِسْكينَ، ولْيُعطِ السَّائلَ، ويَبْدأْ بمَن يَتعَوَّلُ؛ فإنَّه إذا فعَل ذلك كانَ تَزْكيةَ ما هو فيه."],"grade":"صحيح","narrator":"عبدالرحمن بن عوف","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن زنجويه في ((الأموال)) (1366)، والآجري في ((الشريعة)) (5/  2304)، والطبراني في ((مسند الشاميين)) (1616) باختلاف يسير","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"JDKjkNCD"},{"id":"س-01786","fp":"205a9e0dccb2","stateId":698,"easy":"إذا أنفقت زوجين من مالك في سبيل الله ← يدعوك خزنة الجنة من كل باب","cause":"فكلُّ مَن أنفَق زوجًا مما ملَكَتْ يمينُه منَ المالِ في سبيلِ اللهِ","result":"فكلُّ خزنةِ الجنةِ يدعونَه: يا عبدَ اللهِ يا مسلمُ هذا خيرٌ فتعالَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-07860","ref":"إتحاف الخيرة المهرة 8/171","text":["يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّم  هل نَرى ربَّنا يومَ القيامةِ ؟ فقال: هل تُضارُّونَ في رؤيةِ الشمسِ في الظهيرةِ ليسَتْ في سحابةٍ ؟ قالوا: لا  قال: فهل تُضارُّونَ في رؤيةِ القمرِ ليلةَ البدرِ ليس في سحابةٍ ؟ قالوا: لا , قال  فوالذي نفسي بيدِه لا تُضارُّونَ في رؤيةِ ربِّكم إلا كما تُضارُّونَ في رؤيةِ أحدِهما  فيَلقى العبدُ ربَّه فيقولُ: أيْ فُل ألم أُكرِمْكَ  وأُسَوِّدْكَ  وأُزَوِّجْكَ  وأُسَخِّرْ لكَ الخيلَ والإبلَ وأذرَكَ ترأَسُ وتَربَعُ  قال: فيقولُ: بَلى يا ربِّ  قال: فيقولُ: فظننتَ أنكَ مُلاقِيَّ ؟ فيقولُ: لا فيقولُ: إني أنساكَ كما نَسيتَني ثم يَلقى الثانيَ فيقولُ  أيْ فُل ألم أُكرِمْكَ  وأُسَوِّدْكَ  وأُزَوِّجْكَ  وأُسَخِّرْ لكَ الخيلَ والإبلَ وأذرَكَ تَرأَسُ وتَربَعُ  قال: فيقولُ: بَلى يا ربِّ  قال: فيقولُ: فظننتَ أنكَ مُلاقِيَّ ؟ فيقولُ: لا , فيقولُ: فإني أنساكَ كما نَسيتَني  ثم يَلقى الثالثَ فيقول: أيْ فُل ألم أُكرِمْكَ  وأُسَوِّدْكَ  وأُزَوِّجْكَ  وأُسَخِّرْ لكَ الخيلَ والإبلَ وأذرَكَ تَرأَسُ وتَربَعُ ؟ فيقولُ: بَلى يا ربِّ فيقولُ: ظننتَ أنكَ مُلاقِيَّ ؟ فيقولُ: آمنتُ بكَ وبكتابِكَ وبرُسُلِكَ  وصلَّيتُ  وصُمتُ  وتصدَّقتُ  ويُثني بخيرٍ ما استَطاع قال: فيقولُ: فها هُنا إذًا  قال: ثم قال: ألا نبعثُ شاهدَنا عليكَ , فيفكرُ في نفسِه مَن ذا الذي يشهدُ عليَّ , فيختمُ على فيه ويقالُ لفخِذِه: انطِقي فينطقُ فخِذُه ولحمُه وعظامُه بعملِه ما كان  وذلك ليعذرَ مِن نفسِه وذلك المنافقُ  وذلك الذي يسخطُ اللهُ عليه ثم يُنادي منادٍ: ألا لتتبعْ كلُّ أمةٍ ما كانتْ تعبدُ مِن دونِ اللهِ فتتبعُ الشياطينَ والصلبَ أولياؤهم إلى جهنَّمَ قال: وبَقينا أيُّها المؤمنونَ فيأتينا ربُّنا  عزَّ وجلَّ  وهو ربُّنا وهو يُثيبُنا  فيقولَنَّ: علامَ هؤلاءِ ؟ فيقولونَ: نحن عبادُ اللهِ المؤمنينَ آمَنَّا باللهِ لا نُشرِكُ به شيئًا  وهذا مقامُنا حتى يأتيَنا ربُّنا  عزَّ وجلَّ  وهو ربُّنا وهو مُثبِتُنا  قال: ثم ينطلقُ حتى يأتيَ الجسرَ وعليه كلاليبُ مِن نارٍ تخطفُ الناسَ  فعندَ ذلك حلَّتِ الشفاعةُ ودعوى الرسلِ يومئذٍ: اللهم سلِّمْ  أي اللهم سلِّمْ  فإذا جاوَزوا الجسرَ ",["فكلُّ مَن أنفَق زوجًا مما ملَكَتْ يمينُه منَ المالِ في سبيلِ اللهِ",1]," ",["فكلُّ خزنةِ الجنةِ يدعونَه: يا عبدَ اللهِ  يا مسلمُ  هذا خيرٌ فتعالَ",2],"  قال: فقال أبو بكرٍ: يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّم  إنَّ هذا العبدَ لا تَوى عليه يدعُ بابًا ويلِجُ بابًا قال: فضرَبه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بيدِه ثم قال: والذي نفسُ محمدٍ بيدِه إني لأرجو أن تكونَ منهم"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سنده صحيح","takhrij":"أخرجه الحميدي (1178) واللفظ له، وأخرجه البخاري (6573) بنحوه، ومسلم (2968) باختلاف يسير","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"NJUioHng"},{"id":"س-02264","fp":"4a03742569a3","stateId":698,"easy":"إذا سقيت الماء في سبيل الله ← تبلغ به عمل الجنة","cause":"فاشترِ بها سقاءً جديدًا ثمَّ اسقِ فيها حتَّى تخرِقَها","result":"فإنك لن تخرِقَها حتَّى تبلغَ بها عملَ الجنةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الخصائص الكبرى 2/131","srcLabel":"الطبراني","text":["أتى النبيَّ صلَّى اللهُ عليه وسلم رجلٌ فقال : ما عملٌ إنْ عملتُ به دخلتُ الجنةَ ؟ قال : أنت ببلدٍ يُجلَبُ به الماءُ ، قال : نعم قال : ",["فاشترِ بها سقاءً جديدًا ثمَّ اسقِ فيها حتَّى تخرِقَها",1]," ",["فإنك لن تخرِقَها حتَّى تبلغَ بها عملَ الجنةِ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"رجاله ثقات إلا يحيى الحماني","takhrij":"أخرجه الطبراني (12/104) (12605)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"l5wiMY9e"},{"id":"س-00222","fp":"fc3ae46ddc2e","stateId":698,"easy":"إذا نحرت السمين وحملت على النجيب وحلبت يوم الورد ← تدخل الجنة بسلام","cause":"عليه وسلَّم انحَرْ سمينَها واحملْ على نجيبِها واحلبْ يومَ وِردِها","result":"تدخلُ الجنةَ بسلامٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"مجمع الزوائد 3/110","srcLabel":"البخاري","text":["جاء رجلٌ إلى النبيِّ صلَّى اللهُ عليه وسلَّم يسألُه عن شيءٍ من أمرِ الإبلِ فقال رسولُ اللهِ صلَّى اللهُ ",["عليه وسلَّم انحَرْ سمينَها واحملْ على نجيبِها واحلبْ يومَ وِردِها ",1],["تدخلُ الجنةَ بسلامٍ",2]],"grade":"حسن","narrator":"الشريد بن سويد الثقفي","muhaddith":"إسناده حسن","takhrij":"أخرجه البخاري في ((التاريخ الكبير)) (8/ 352) واللفظ له، والبغوي في ((معجم الصحابة)) (1241) باختلاف يسير.","bab":"آداب المجلس › الركوب على الدابة","dorar":"2qIPdKFS"},{"id":"س-00324","fp":"989449aa31fa","stateId":698,"easy":"إذا كنت سخياً ← فلك في الجنة بيت يُقال له بيت السخاء","cause":"السَّخاءِ","result":"إنَّ في الجنَّةِ بيتًا يُقالُ له بيتُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"الترغيب والترهيب 3/341","srcLabel":"الطبراني","text":[["إنَّ في الجنَّةِ بيتًا يُقالُ له بيتُ",2]," ",["السَّخاءِ",1]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((الأوسط)) (5742) بلفظه، والخرائطي في ((مكارم الأخلاق)) (597)، وابن عدي في ((الكامل)) (1/ 307) بنحوه.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"bgCDrffO"},{"id":"س-06803","fp":"7e408ffb483d","stateId":698,"easy":"إذا أعتقت النسمة وفككت الرقبة ← تدخل الجنة","cause":"أعتِقِ النَّسَمةَ، وفُكَّ الرَّقبةَ، فقال: يا رسولَ اللهِ، أوَليستا بواحدةٍ؟! قال: لا؛ إنَّ عِتقَ النَّسَمةِ أنْ تَفرَّدَ بعِتقِها، وفَكُّ الرَّقبةِ أنْ تُعينَ في عِتقِها، والمِنحةُ الوَكوفُ، والفَيءُ على ذي الرَّحِمِ الظَّالمِ، فإنْ لم تُطِقْ ذلك، فأطعِمِ الجائعَ، واسْقَ الظَّمآنَ، وأْمُرْ بالمَعروفِ، وانْهَ عن المُنكَرِ، فإنْ لم تُطِقْ ذلك، فكُفَّ لِسانَكَ إلَّا مِن الخيرِ","result":"عملًا يُدخِلُني الجنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"تخريج المسند لشعيب 18647","srcLabel":"أحمد","text":["جاء أعْرابيٌّ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فقال: يا رسولَ اللهِ، عَلِّمْني ",["عملًا يُدخِلُني الجنَّةَ",2],"؟ فقال: لئِن كنتَ أقصَرتَ الخُطبةَ، لقد أعرَضتَ المَسألةَ، ",["أعتِقِ النَّسَمةَ، وفُكَّ الرَّقبةَ، فقال: يا رسولَ اللهِ، أوَليستا بواحدةٍ؟! قال: لا؛ إنَّ عِتقَ النَّسَمةِ أنْ تَفرَّدَ بعِتقِها، وفَكُّ الرَّقبةِ أنْ تُعينَ في عِتقِها، والمِنحةُ الوَكوفُ، والفَيءُ على ذي الرَّحِمِ الظَّالمِ، فإنْ لم تُطِقْ ذلك، فأطعِمِ الجائعَ، واسْقَ الظَّمآنَ، وأْمُرْ بالمَعروفِ، وانْهَ عن المُنكَرِ، فإنْ لم تُطِقْ ذلك، فكُفَّ لِسانَكَ إلَّا مِن الخيرِ",1],"."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (18647) واللفظ له، والطيالسي (775)، والطحاوي في ((شرح مشكل الآثار)) (2743)","bab":"عتق وولاء › فضل العتق","dorar":"1h2L12D7"},{"id":"س-07211","fp":"f710e8deb803","stateId":698,"easy":"إذا سقيت الماء للناس وحملته إليهم ← تدخل الجنة","cause":"اسقِ الماءَ احملْهُ إليهم إذا غابوا واكفهم إيَّاهُ إذا حضروا","result":"عملٍ يدخلُهُ الجنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"مجمع الزوائد 3/134","srcLabel":"الطبراني","text":["سمعتُ عياضَ بنَ مرثدٍ أو مرثدَ بنَ عياضٍ يحدِّثُ رجلًا أنَّهُ سأل النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ عن ",["عملٍ يدخلُهُ الجنَّةَ",2]," قالَ هل من والديكَ أحدٌ حيٌّ قالَ لا فسألَهُ ثلاثًا قالَ ",["اسقِ الماءَ احملْهُ إليهم إذا غابوا واكفهم إيَّاهُ إذا حضروا",1]],"grade":"صحيح","narrator":"عياض بن مرثد أو مرثد بن عياض","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (17/ 370) (1014)، وأبو نعيم في ((معرفة الصحابة)) (5445)، وابن الأثير في ((أسد الغابة)) (4/ 330)، واللفظ لهم.","bab":"علم › حسن السؤال ونصح العالم","dorar":"cVGsUkrJ"},{"id":"س-08347","fp":"d076240d93ad","stateId":699,"easy":"إذا كنت من أهل الصيام ← تُدعى من باب الريان","cause":"ولِأَهلِ الصِّيامِ","result":"بابٌ يُدعَوْن منه، يُقالُ له: الرَّيانُ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 9800","srcLabel":"متفق عليه","text":["لكُلِّ أهْلِ عَمَلٍ بابٌ مِن أبوابِ الجنَّةِ، يُدعَوْن منه بذلكَ العَمَلِ، ",["ولِأَهلِ الصِّيامِ",1]," ",["بابٌ يُدعَوْن منه، يُقالُ له: الرَّيانُ",2],". فقال أبو بكرٍ: يا رسولَ اللهِ، هل أحدٌ يُدعى مِن تلكَ الأبوابِ كُلِّها؟ قال: نَعَمْ، وأنا أرجو أنْ تَكونَ منهم يا أبا بكرٍ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1897)، ومسلم (1027)، والترمذي (3674)، والنسائي (2238) مطولاً، وأحمد (9800) واللفظ له","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"cri4f4zS","merged":6,"otherRefs":["صحيح الجامع 5184 (صحيح)","تخريج صحيح ابن حبان 3421 (صحيح)","تخريج المسند لشعيب 22819 (صحيح)","تخريج المسند لشعيب 22842 (صحيح)","صحيح الجامع 4242 (صحيح)"]},{"id":"س-04745","fp":"f15b23e090ff","stateId":699,"easy":"إذا صمت يوماً ابتغاء وجه الله فخُتم لك به ← دخلت الجنة","cause":"ومَن صامَ يَومًا ابتِغاءَ وَجْهِ اللهِ خُتِمَ له بها","result":"دَخَلَ الجَنَّةَ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 23324","srcLabel":"أحمد","text":["أسْنَدتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ إلى صَدْري، فقال: مَن قال: لا إلهَ إلَّا اللهُ -قال حَسَنٌ: ابتِغاءَ وَجْهِ اللهِ- خُتِمَ له بها دَخَلَ الجَنَّةَ، ",["ومَن صامَ يَومًا ابتِغاءَ وَجْهِ اللهِ خُتِمَ له بها ",1],["دَخَلَ الجَنَّةَ، ",2],"ومَن تَصدَّقَ بصَدَقةٍ ابتِغاءَ وَجْهِ اللهِ خُتِمَ له بها دَخَلَ الجَنَّةَ."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (23324) واللفظ له، وابن أبي شيبة كما في ((إتحاف الخيرة المهرة)) للبوصيري (6/420)، والبيهقي في ((الأسماء والصفات)) (651)","bab":"رقائق وزهد › الإخلاص","dorar":"YSSvEYh5"},{"id":"س-06928","fp":"7976a9e174f6","stateId":699,"easy":"إذا خُتم لك بصيام يوم تريد به وجه الله ← يدخلك الله الجنة","cause":"مَن خُتَمَ له بصيامِ يومٍ ، يُريدُ بِه وجهَ اللهِ عزَّ وجلَّ","result":"أدخلَهَ اللهُ الجنةَ","explicit":true,"ref":"صحيح الترغيب 985","srcLabel":"أحمد","text":["يا حُذَيْفَةَ ! ",["مَن خُتَمَ له بصيامِ يومٍ ، يُريدُ بِه وجهَ اللهِ عزَّ وجلَّ ؛ ",1],["أدخلَهَ اللهُ الجنةَ",2]],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن الفاخر في ((موجبات الجنة)) (309) بلفظه في أثناء حديث طويل، والطبراني في ((الشاميين)) (2449) باختلاف يسير في أثناء حديث طويل، وأحمد (23324) بنحوه مطولًا.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"ICy6BeWo"},{"id":"س-02265","fp":"f93449ed327e","stateId":699,"easy":"إذا صمت ← تدخل من باب الريان","cause":"أين الصَّائمون","result":"إنَّ في الجنةِ بابًا يقالُ له : الريَّانُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"similar":["س-01869","س-01938"],"ref":"صحيح النسائي 2236","srcLabel":"متفق عليه","text":[["إنَّ في الجنةِ بابًا يقالُ له : الريَّانُ",2]," يقالُ يومَ القيامةِ : ",["أين الصَّائمون",1]," ؟ هل لكم إلى الريَّانِ ؟ من دخلَهُ لم يظمأْ أبدًا فإذا دخلوا أغلِقَ عليهم ، فلم يدخلْ فيه أحدٌ غيرُهم ."],"grade":"صحيح","narrator":"سهل بن سعد الساعدي","muhaddith":"صحيح","takhrij":"أخرجه النسائي (2237) واللفظ له، وأخرجه البخاري (1896)، ومسلم (1152) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"HEFa4M5Z","merged":4,"otherRefs":["صحيح ابن ماجه 1337 (صحيح)","تخريج شرح السنة 1709 (حسن)","مجمع الزوائد 10/401 (حسن)"]},{"id":"س-04337","fp":"968158bbd8b7","stateId":699,"easy":"إذا صنت نفسك في رمضان فلم تشرب مسكراً ولم ترمِ مؤمناً ببهتان ولم تعمل خطيئة ← يزوجك الله من الحور العين","cause":"فمن صانَ نفسَهُ في شهرِ رمضانَ فلم يشرب فيهِ مسكرًا ولم يرمِ فيهِ مؤمنًا بالبهتانِ ولم يعمل [فيهِ] خطيئةً","result":"زوَّجَهُ اللَّهُ كلَّ ليلةٍ مائةً حوراءَ وبنى لهُ قصرًا في الجنَّةِ","explicit":true,"apply":{"k":"time","t":"في رمضان"},"ref":"مجمع الزوائد 3/147","srcLabel":"أحمد","text":["إنَّ الجنَّةَ لتزيَّنُ منَ السَّنةِ إلى السَّنةِ لشهرَ رمضانَ فإذا دخلَ شهرُ رمضانُ قالتِ الجنَّةُ اللَّهمَّ اجعل لنا في هذا الشَّهرِ من عبادِكَ سكَّانًا ويقلنَ الحورُ العينُ اللَّهمَّ اجعل لنا من عبادِكَ في هذا الشَّهرِ أزواجًا قالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ ",["فمن صانَ نفسَهُ في شهرِ رمضانَ فلم يشرب فيهِ مسكرًا ولم يرمِ فيهِ مؤمنًا بالبهتانِ ولم يعمل [فيهِ] خطيئةً",1]," ",["زوَّجَهُ اللَّهُ كلَّ ليلةٍ مائةً حوراءَ وبنى لهُ قصرًا في الجنَّةِ",2]," من ذهبٍ وفضَّةٍ وياقوتٍ وزبرجدٍ لو أنَّ الدُّنيا جمعت فجعلت في ذلكَ القصرِ لم تكن فيهِ إلَّا كمربطِ عنزٍ في الدُّنيا ومن شربَ فيهِ مسكرًا أو رمى فيهِ مؤمنًا ببهتانٍ وعملَ فيهِ خطيئةً أحبطَ اللَّهُ عملَهُ سنةً فاتَّقوا شهرَ رمضانَ فإنَّهُ شهرُ اللَّهِ أن تفرِّطوا فيهِ فقد جعلَ اللَّهُ لكم أحدَ عشرَ شهرًا تنعمونَ فيها [وتلذُّونَ] وجعلَ لنفسِهِ شهرَ رمضانَ فاحذروا شهرَ رمضان"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"[فيه] أحمد بن أبيض  ولم أجد من ترجمه وبقية رجاله موثقون","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (3688) واللفظ له، وتمام في ((الفوائد)) (1127)، وابن عساكر في ((تاريخ دمشق)) (51/225)","bab":"جنة › نساء الجنة","dorar":"nYlUe9Rr"},{"id":"س-06746","fp":"c6ca0c6d5598","stateId":699,"easy":"إذا صمت رمضان وشوالاً والأربعاء والخميس ← تدخل الجنة (على رواية)","cause":"مَن صام رمضانَ وشوالًا والأربعاءَ والخميسَ","result":"دخَل الجنةَ","explicit":true,"apply":{"k":"time","t":"في رمضان"},"ref":"إتحاف الخيرة المهرة 3/86","srcLabel":"النسائي","text":[["مَن صام رمضانَ وشوالًا والأربعاءَ والخميسَ ",1],["دخَل الجنةَ",2]],"grade":"حسن","narrator":"[والد عريف من عرفاء قريش]","muhaddith":"رواته ثقات","takhrij":"أخرجه النسائي في ((الكبرى)) (2791) واللفظ له، وأحمد (16714)، والبيهقي في ((شعب الإيمان)) (3587)، وابن عدي في ((الكامل)) (7/ 121)باختلاف يسير.","bab":"صيام › فضل الصيام","dorar":"ca9ysjhV"},{"id":"س-01869","fp":"c540f4b25475","stateId":699,"easy":"إذا صمت ← تدخل الجنة من باب الريان","cause":"إنَّ في الجَنَّةِ بابًا يُقالُ له: الرَّيَّانُ، يَدخُلُ منه الصَّائِمونَ يَومَ القيامةِ","result":"لا يَدخُلُ منه أحَدٌ غَيرُهم، يُقالُ: أينَ الصَّائِمونَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-02265","ref":"صحيح البخاري 1896","text":[["إنَّ في الجَنَّةِ بابًا يُقالُ له: الرَّيَّانُ، يَدخُلُ منه الصَّائِمونَ يَومَ القيامةِ، ",1],["لا يَدخُلُ منه أحَدٌ غَيرُهم، يُقالُ: أينَ الصَّائِمونَ",2],"؟ فيَقومونَ، لا يَدخُلُ منه أحَدٌ غَيرُهم، فإذا دَخَلوا أُغلِقَ فلَم يَدخُلْ منه أحَدٌ."],"grade":"صحيح","narrator":"سهل بن سعد الساعدي","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1152) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"E5wMfmNc"},{"id":"س-01938","fp":"233a6b29d2f8","stateId":699,"easy":"إذا صمت ← تُدعى من باب الريان","cause":"الصيامِ","result":"يدعى الريانَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-02265","ref":"الجامع الصغير 7287","text":["لكلِّ بابٍ منْ أبوابِ البرِ،  بابُ منْ أبوابِ الجنةِ،  و إنْ بابَ ",["الصيامِ",1]," ",["يدعى الريانَ",2]],"grade":"حسن","narrator":"سهل بن سعد الساعدي","muhaddith":"حسن","takhrij":"أخرجه الشجري في ((الأمالي الخميسية)) (1937) واللفظ له، والطبراني في ((المعجم الكبير)) (6/ 192) (5970) باختلاف يسير، وأصل الحديث في البخاري (1896)، ومسلم (1152).","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"jcC59mVo"},{"id":"س-02289","fp":"ec73d165275d","stateId":700,"easy":"إذا حججت حجاً مبروراً ← فليس له جزاء إلا الجنة","cause":"الحَجُّ المَبرورُ","result":"ليس له جَزاءٌ إلَّا الجَنَّةُ","explicit":true,"star":true,"ref":"أطراف الغرائب 2/375","srcLabel":"أطراف الغرائب","text":["حديثُ: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["الحَجُّ المَبرورُ",1]," ",["ليس له جَزاءٌ إلَّا الجَنَّةُ",2]," [والعمرةُ إلى العمرةِ تُكفِّرُ ما بينَهما]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"قال ابن صاعد: غريب الإسناد وما سمعناه إلا من ابن عَبد الحكم يعني محمد بن عَبد الله بن عَبد الحكم عن إسحاق بن الفرات قاضي مصر عن يحيى بن أيوب عن يحيى بن سَعِيد، عَن سهيل عن سمي. قال الدارقطني: غريبٌ من حديث يحيى الأنصاري عن سهيل، تَفَرَّدَ بهِ يحيى بن أيوب عنه، وتَفَرَّدَ بهِ إسحاق بن الفرات عنه وهو محفوظ عن سهيل.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"LxcogkZg","merged":5,"otherRefs":["المحلى 7/68 (صحيح)","الأحاديث المختارة 8 / 195 (صحيح)","البحر الزخار 15/370 (حسن)","صحيح الترغيب 1104 (صحيح)"]},{"id":"س-00835","fp":"f9b2544ee86f","stateId":700,"easy":"إذا أهللت (لبّيت) ← بُشّرت بالجنة","cause":"ما أهلَّ مُهِلٌّ قطُّ","result":"إلَّا بُشِّرَ","explicit":true,"ref":"صحيح الترغيب 1137","srcLabel":"الطبراني","text":[["ما أهلَّ مُهِلٌّ قطُّ",1]," ",["إلَّا بُشِّرَ",2]," ، ولا كبَّرَ مُكبِّرٌ قطُّ إلَّا بُشِّرَ . قيلَ : يا رسولَ اللهِ ! بالجنَّةِ ؟ قال : نعَم ."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن لغيره","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (7779).","bab":"أدعية وأذكار › فضل التكبير","dorar":"alY4REID"},{"id":"س-04416","fp":"45522befb0ed","stateId":701,"easy":"إذا خرجت في سبيل الله إيماناً وتصديقاً ← يرجعك بما نلت من أجر أو غنيمة أو يدخلك الجنة","cause":"لِمَنْ خرَجَ في سبيلِهِ ، لا يُخرِجُهُ إلَّا إيمانٌ بِي ، وتَصديقٌ بِرُسلِي","result":"أنْ أُرجِعَهُ بِما نالَ من أجرِ أوْ غَنيمةٍ ؛ أوْ أُدخِلَهُ الجنةَ","explicit":true,"star":true,"otherNeedIds":[45,1,25],"ref":"صحيح الجامع 1491","srcLabel":"متفق عليه","text":["انْتدَبَ اللهُ ",["لِمَنْ خرَجَ في سبيلِهِ ، لا يُخرِجُهُ إلَّا إيمانٌ بِي ، وتَصديقٌ بِرُسلِي",1]," ، ",["أنْ أُرجِعَهُ بِما نالَ من أجرِ أوْ غَنيمةٍ ؛ أوْ أُدخِلَهُ الجنةَ",2]," ، ولوْلا أنْ أشُقَّ على أُمَّتِي ما قَعدْتُ خلْفَ سرِيَّةٍ ، ولوَدِدتُ أنِّي أُقتَلُ في سبيلِ اللهِ ، ثُمَّ أحْيا ، ثُمَّ أُقتَلُ ، ثُمَّ أُحْيا ، ثُمَّ أُقتَلُ ، ثُمَّ أُحْيا"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (36) واللفظ له، ومسلم (1876).","bab":"جهاد › النية في القتال والغزو","dorar":"LQgFTHqr","merged":6,"otherRefs":["تخريج المسند لشعيب 10407 (صحيح)","الجامع الصغير 6022 (صحيح)","الأحاديث المختارة 13 / 167 (صحيح)","تخريج المسند لشعيب 9477 (صحيح)","صحيح الجامع 5851 (صحيح)"]},{"id":"س-01301","fp":"a1044c9c5959","stateId":701,"easy":"إذا صنعت السهم محتسباً أو نبّلته أو رميت به في سبيل الله ← يدخلك الله الجنة","cause":"صانِعُه الَّذي احتَسَبَ في صَنْعتِه الخيرَ، ومُتَنبِّلُه، والرَّامي","result":"إنَّ اللهَ يُدخِلُ بالسَّهمِ الواحدِ ثلاثةَ نَفَرٍ الجنَّةَ","explicit":true,"star":true,"similar":["س-03126"],"ref":"المستدرك على الصحيحين 2502","srcLabel":"مسلم","text":["عنْ خالدِ بنِ زيدٍ قالَ: كنتُ راميًا أُرامي عُقبةَ بنَ عامِرٍ، فمَرَّ بي ذاتَ يومٍ، فقالَ: يا خالدُ، اخرُجْ بِنا نَرْمي، فأَبْطَأْتُ عليه، فقالَ: يا خالدُ، تعالَ أُحدِّثْكَ ما حدَّثَني رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، وأَقولُ لكَ كما قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["إنَّ اللهَ يُدخِلُ بالسَّهمِ الواحدِ ثلاثةَ نَفَرٍ الجنَّةَ",2],": ",["صانِعُه الَّذي احتَسَبَ في صَنْعتِه الخيرَ، ومُتَنبِّلُه، والرَّامي",1],"، ارْموا واركَبوا، وأنْ تَرْموا أَحبُّ إليَّ مِن أنْ ترْكَبوا، وليس مِنَ اللَّهوِ إلَّا ثلاثةٌ: تأديبُ الرَّجلِ فرَسَه، ومُلاعبتُه زوجتَه، ورميُه بنَبْلِه عن قومِه، ومَنْ عَلِمَ الرَّميَ ثُمَّ تَرَكَه؛ فهي نِعمةٌ كَفَرَها."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح الإسناد، وله شاهد صحيح على شرط مسلم","takhrij":"أخرجه الروياني (247) بلفظه، وأبو داود (2513)، والنسائي (3146) كلاهما ببعض لفظه.","bab":"نكاح › حسن العشرة بين الأزواج","dorar":"73ojelQY","merged":7,"otherRefs":["المستدرك على الصحيحين 2503 (صحيح)","سنن الترمذي 1637 (صحيح)","الأحكام الوسطى 3/7 (صحيح)","تخريج مشكل الآثار 295 (حسن)","مشارع الأشواق 783 (حسن)","الجامع الصغير 1897 (صحيح)"]},{"id":"س-04358","fp":"6bf0475bd49b","stateId":701,"easy":"إذا قاتلت في سبيل الله فواق ناقة ← وجبت لك الجنة","cause":"مَنْ قاتَلَ في سبيلِ الله فُواقَ ناقةٍ","result":"وَجَبَتْ له الجنَّةُ","explicit":true,"star":true,"similar":["س-06874","س-07137","س-04484","س-02522","س-08420","س-03190"],"ref":"المستدرك على الصحيحين 2417","srcLabel":"مسلم","text":["أنَّ رَجلًا مِن أصحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ مَرَّ بشِعْبٍ فيه عُيَينَةُ مِن ماءٍ عَذْبٍ، فأَعْجَبَه طيبُهُ وحُسنُه، فقالَ: لوِ اعتزلتُ النَّاسَ، وأَقمتُ في هذا الشِّعبِ؟ ثُمَّ قالَ: لا أَفعلُ حتَّى أَستأْمِرَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فذَكَرَ ذلك لرسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: لا تَفعلْ؛ فإنَّ مَقامَ أَحَدِكُم في سبيلِ اللهِ أفضلُ مِن صلاتِهِ في أَهلِهِ ستِّينَ عامًا، ألا تُحبُّونَ أنْ يَغفِرَ اللهُ لكم، ويُدخِلَكُم الجنَّةَ؛ اغزوا في سبيلِ اللهِ، ",["مَنْ قاتَلَ في سبيلِ الله فُواقَ ناقةٍ؛ ",1],["وَجَبَتْ له الجنَّةُ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه البيهقي (18543) واللفظ له، والترمذي (1650)، وأحمد (10786) بنحوه","bab":"جهاد › الترغيب في الجهاد","dorar":"7Vzc5L5E","merged":6,"otherRefs":["تخريج المسند لشعيب 22110 (صحيح)","تخريج المسند لشعيب 9762 (حسن)","تخريج سنن أبي داود 2541 (صحيح)","تخريج المسند لشعيب 22116 (صحيح)","الفتوحات الربانية 5/45 (صحيح)"]},{"id":"س-04527","fp":"47c5a1a2fd5f","stateId":701,"easy":"إذا قُتلت في سبيل الله ← تكون روحك في طير خضر تسرح في الجنة حيث شاءت","cause":"الَّذِينَ قُتِلُوا فِي سَبِيلِ اللَّهِ","result":"أنَّ أرواحَهُم في طيرٍ خضرٍ تسرحُ في الجنَّةِ حيثُ شاءت ، وتأوي إلى قَناديلَ معلَّقةٍ بالعرشِ","explicit":true,"star":true,"otherNeedIds":[63],"ref":"صحيح الترمذي 3011","srcLabel":"مسلم","text":["عَن عبدِ اللَّهِ بنِ مَسعودٍ ، أنَّهُ سُئِلَ عن قولِهِ : وَلَا تَحْسَبَنَّ ",["الَّذِينَ قُتِلُوا فِي سَبِيلِ اللَّهِ",1]," أَمْوَاتًا بَلْ أَحْيَاءٌ عِنْدَ رَبِّهِمْ يُرْزَقُونَ فقالَ : أما إنَّا قد سأَلْنا عن ذلِكَ ، فأُخبِرنا ",["أنَّ أرواحَهُم في طيرٍ خضرٍ تسرحُ في الجنَّةِ حيثُ شاءت ، وتأوي إلى قَناديلَ معلَّقةٍ بالعرشِ",2]," ، فاطَّلعَ إليهم ربُّكَ اطِّلاعةً ، فقالَ : هل تستَزيدونَ شيئًا فأزيدُكُم ؟ قالوا ربَّنا : وما نستزيدُ ونحنُ في الجنَّةِ نَسرحُ حيثُ شِئنا ؟ ثمَّ اطَّلعَ عليهمُ الثَّانيةَ ، فقالَ : هل تَستزيدونَ شيئًا فأزيدُكُم ؟ فلمَّا رأَوا أنَّهم لَا يُترَكونَ قالوا : تعيدُ أرواحَنا في أجسادِنا حتَّى نرجعَ إلى الدُّنيا ، فنُقتلَ في سبيلِكَ مرَّةً أخرى"],"grade":"صحيح","narrator":"مسروق بن الأجدع","muhaddith":"صحيح","takhrij":"أخرجه مسلم (3011)، والطبراني (9/ 209) (9023) باختلاف يسير.","bab":"جهاد › فضل الشهيد","dorar":"KgT6vDQS","merged":7,"otherRefs":["صحيح الترغيب 1368 (صحيح)","صحيح ابن ماجه 2277 (صحيح)","الآيات البينات 78 (صحيح)","صحيح الجامع 912 (صحيح)","تسديد القوس 1/290 (صحيح)","تسديد القوس 2/517 (صحيح)"]},{"id":"س-04372","fp":"08f512504d7b","stateId":701,"easy":"إذا جهزت غازياً أو بنيت مسجداً ← لك مثل أجره ويبني الله لك بيتاً في الجنة","cause":"ومَن جَهَّزَ غازِيًا في سَبيلِ اللهِ بجَهازِه له مِثلُ أَجْرِه، ومَن بَنى مَسجِدًا يُذكَرُ فيه اسمُ اللهِ جَلَّ وعَزَّ","result":"بَنى اللهُ له بَيْتًا في الجنَّةِ","explicit":true,"star":true,"ref":"الأحاديث المختارة 244","srcLabel":"البخاري","text":["«مَن أَظَلَّ رأسَ غازٍ أظَلَّه اللهُ يَوْمَ القِيامةِ، ",["ومَن جَهَّزَ غازِيًا في سَبيلِ اللهِ بجَهازِه له مِثلُ أَجْرِه، ومَن بَنى مَسجِدًا يُذكَرُ فيه اسمُ اللهِ جَلَّ وعَزَّ ",1],["بَنى اللهُ له بَيْتًا في الجنَّةِ»",2],"."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"جهاد › الترغيب في الجهاد","dorar":"G5Rs9KCv"},{"id":"س-04406","fp":"b04b5f56c167","stateId":701,"easy":"إذا جاهدت في سبيل الله لا يخرجك إلا الجهاد وتصديق كلماته ← تكفّل الله لك بالجنة","cause":"لِمْنَ جاهَدَ فِي سبيلِهِ لا يخرِجُهُ مِنْ بيتِهِ إلَّا الجهادُ في سبيلِهِ ، وتصديقُ كلماتِهِ","result":"بأنْ يُدْخِلَهُ الجنَّةَ ، أوْ يُرْجِعَهُ إلى مَسْكَنِهِ الذي خرج منه مع ما نال مِنْ أجرٍ أَوْ غنيمَةٍ","explicit":true,"otherNeedIds":[25],"ref":"صحيح الجامع 2985","srcLabel":"متفق عليه","text":["تَكَفَّلَ اللهُ ",["لِمْنَ جاهَدَ فِي سبيلِهِ لا يخرِجُهُ مِنْ بيتِهِ إلَّا الجهادُ في سبيلِهِ ، وتصديقُ كلماتِهِ",1]," ، ",["بأنْ يُدْخِلَهُ الجنَّةَ ، أوْ يُرْجِعَهُ إلى مَسْكَنِهِ الذي خرج منه مع ما نال مِنْ أجرٍ أَوْ غنيمَةٍ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (3123)، ومسلم (1876) باختلاف يسير","bab":"جهاد › النية في القتال والغزو","dorar":"1tNQJGiV"},{"id":"س-04420","fp":"7594705088b9","stateId":701,"easy":"إذا خرجت مجاهداً إيماناً بالله وتصديقاً برسله ← فأنت على الله ضامن أن يدخلك الجنة","cause":"لـمَن خرَجَ في سبيلِه، لا يَـخْرُجُ إلا جِهادًا في سَبِيلي، وإيمانًا بي، وتصديق رسولي","result":"فهو عَلَيَّ ضامِنٌ أنْ أُدْخِلَه الجنةَ، أو أُرْجِعَه إلى مَسْكنِه الذي خرَجَ منه، نَائِلًا ما نالَ مِن أَجْرٍ أو غَنيمَةٍ","explicit":true,"otherNeedIds":[45],"ref":"تخريج المسند لشعيب 7157","srcLabel":"متفق عليه","text":["انتَدَبَ اللهُ عزَّ وجلَّ ",["لـمَن خرَجَ في سبيلِه، لا يَـخْرُجُ إلا جِهادًا في سَبِيلي، وإيمانًا بي، وتصديق رسولي",1]," ؛ ",["فهو عَلَيَّ ضامِنٌ أنْ أُدْخِلَه الجنةَ، أو أُرْجِعَه إلى مَسْكنِه الذي خرَجَ منه، نَائِلًا ما نالَ مِن أَجْرٍ أو غَنيمَةٍ",2],"، والذي نَفْسُ محمدٍ بِيَدِه، ما مِن كَلْمٍ يُكْلَمُ في سَبيلِ اللهِ إلَّا جاء يَوْمَ القِيامةِ كهَيْئَتِه يَوْمَ كُلِم، لَوْنُه لَوْنُ دمٍ، ورِيـحُه ريحُ مِسكٍ. والذي نَفْسُ محمدٍ بِيَدِه، لَوْلا أنْ أَشُقَّ على المُسلِمين ما قعَدْتُ خِلافَ سَرِيَّةٍ تَغْزو في سَبيلِ اللهِ أَبَدًا، ولكنِّي لا أَجِدُ سَعَةً فيَتْبَعوني، ولا تَطِيبُ أَنْفُسُهم فيَتَخَلَّفون بَعْدِي، والذي نَفْسُ محمدٍ بِيَدِه، لَوَدِدْتُ أنْ  أَغزُوَ في سبيلِ اللهِ فأُقتَلَ، ثم أَغزُوَ فأُقتَلَ، ثم أَغزُوَ فأُقتَلَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (36)، ومسلم (1876) باختلاف يسير","bab":"جهاد › النية في القتال والغزو","dorar":"xIpjl4MF"},{"id":"س-06598","fp":"272eae72b38c","stateId":701,"easy":"إذا جاهدت في سبيل الله ← لك في الجنة مئة درجة، فسل الله الفردوس","cause":"إنَّ في الجَنَّةِ مِئةَ دَرَجةٍ، أعَدَّها اللهُ للمُجاهِدينَ في سَبيلِ اللهِ، ما بينَ الدَّرَجَتَينِ كما بينَ السَّماءِ والأرضِ، فإذا سَألتُمُ اللهَ فاسألوه الفِردَوسَ","result":"فإنَّه أوسَطُ الجَنَّةِ وأعلى الجَنَّةِ -أُراه- فوقَه عَرشُ الرَّحمَنِ، ومِنه تَفَجَّرُ أنهارُ الجَنَّةِ","explicit":true,"otherNeedIds":[68],"ref":"صحيح البخاري 2790","srcLabel":"البخاري","text":["مَن آمَنَ باللهِ وبرَسولِه، وأقامَ الصَّلاةَ، وصامَ رَمَضانَ؛ كان حَقًّا على اللهِ أن يُدخِلَه الجَنَّةَ، جاهَدَ في سَبيلِ اللهِ، أو جَلَسَ في أرضِه التي وُلِدَ فيها، فقالوا: يا رَسولَ اللهِ، أفَلا نُبَشِّرُ النَّاسَ؟ قال: ",["إنَّ في الجَنَّةِ مِئةَ دَرَجةٍ، أعَدَّها اللهُ للمُجاهِدينَ في سَبيلِ اللهِ، ما بينَ الدَّرَجَتَينِ كما بينَ السَّماءِ والأرضِ، فإذا سَألتُمُ اللهَ فاسألوه الفِردَوسَ؛ ",1],["فإنَّه أوسَطُ الجَنَّةِ وأعلى الجَنَّةِ -أُراه- فوقَه عَرشُ الرَّحمَنِ، ومِنه تَفَجَّرُ أنهارُ الجَنَّةِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2790)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"Ecaspomf"},{"id":"س-04352","fp":"a0364b335142","stateId":701,"easy":"إذا لقيت العدو فاصبر ← فالجنة تحت ظلال السيوف","cause":"فاصبِروا","result":"واعلَموا أنَّ الجَنَّةَ تَحتَ ظِلالِ السُّيوفِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح مسلم 1742","srcLabel":"البخاري","text":["عَن أبي النَّضرِ، عن كِتابِ رَجُلٍ مِن أسلَمَ، مِن أصحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّم يُقالُ له: عبدُ اللهِ بنُ أبي أوفى، فكَتَبَ إلى عُمَرَ بنِ عُبَيدِ اللهِ حينَ سارَ إلى الحَروريَّةِ، يُخبِرُه أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم كان في بَعضِ أيَّامِه التي لَقيَ فيها العَدوَّ، يَنتَظِرُ حتَّى إذا مالَتِ الشَّمسُ قامَ فيهم، فقال: يا أيُّها النَّاسُ، لا تَتَمَنَّوا لقاءَ العَدوِّ، واسألوا اللَّهَ العافيةَ، فإذا لَقيتُموهم ",["فاصبِروا",1],"، ",["واعلَموا أنَّ الجَنَّةَ تَحتَ ظِلالِ السُّيوفِ",2],"، ثُمَّ قامَ النَّبيُّ صلَّى اللهُ عليه وسلَّم، وقال: اللَّهُمَّ مُنزِلَ الكِتابِ، ومُجريَ السَّحابِ، وهازِمَ الأحزابِ، اهزِمْهم، وانصُرْنا عليهم."],"grade":"صحيح","narrator":"عبد الله بن أبي أوفى.","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3024)، وأبو داود (2631)، وأحمد (19114) باختلاف يسير.","bab":"جهاد › الترغيب في الجهاد","dorar":"XahiFpN4","merged":3,"otherRefs":["صحيح البخاري 3024 (صحيح)","صحيح الجامع 2750 (صحيح)"]},{"id":"ق-0051","fp":"bbe70ae902b8","stateId":701,"easy":"القتل في سبيل الله ← حياة عند الله","cause":"القتل في سبيل الله","result":"حياة عند الله","explicit":true,"similar":["ق-0186"],"ref":"سورة البقرة: 154","srcLabel":"القرآن الكريم","quran":{"s":2,"from":154,"to":154,"text":"وَلَا تَقُولُوا لِمَنْ يُقْتَلُ فِي سَبِيلِ اللَّهِ أَمْوَاتٌ بَلْ أَحْيَاءٌ وَلَكِنْ لَا تَشْعُرُونَ (154)","hl":[[0,101,1]]}},{"id":"ق-0168","fp":"2cad9b0ff811","stateId":701,"easy":"الجهاد والصبر ← دخول الجنة","cause":"الجهاد والصبر","result":"دخول الجنة","explicit":true,"ref":"سورة آل عمران: 142","srcLabel":"القرآن الكريم","quran":{"s":3,"from":142,"to":142,"text":"أَمْ حَسِبْتُمْ أَنْ تَدْخُلُوا الْجَنَّةَ وَلَمَّا يَعْلَمِ اللَّهُ الَّذِينَ جَاهَدُوا مِنْكُمْ وَيَعْلَمَ الصَّابِرِينَ (142)","hl":[[0,122,1]]}},{"id":"ق-0186","fp":"a217f2fb8da7","stateId":701,"easy":"القتل في سبيل الله ← حياة عند الله ورزق وفرح ولا خوف ولا حزن ولا يضيع أجر المؤمنين","cause":"القتل في سبيل الله","result":"حياة عند الله ورزق وفرح ولا خوف ولا حزن ولا يضيع أجر المؤمنين","explicit":true,"repOf":"ق-0051","otherNeedIds":[6,45],"ref":"سورة آل عمران: 169–171","quran":{"s":3,"from":169,"to":171,"text":"وَلَا تَحْسَبَنَّ الَّذِينَ قُتِلُوا فِي سَبِيلِ اللَّهِ أَمْوَاتًا بَلْ أَحْيَاءٌ عِنْدَ رَبِّهِمْ يُرْزَقُونَ (169) فَرِحِينَ بِمَا آتَاهُمُ اللَّهُ مِنْ فَضْلِهِ وَيَسْتَبْشِرُونَ بِالَّذِينَ لَمْ يَلْحَقُوا بِهِمْ مِنْ خَلْفِهِمْ أَلَّا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ (170) يَسْتَبْشِرُونَ بِنِعْمَةٍ مِنَ اللَّهِ وَفَضْلٍ وَأَنَّ اللَّهَ لَا يُضِيعُ أَجْرَ الْمُؤْمِنِينَ (171)","hl":[[0,386,1]]}},{"id":"ق-0533","fp":"7dad3b4edc48","stateId":701,"easy":"بيع النفس والمال لله (الجهاد والوفاء بالعهد) ← الجنة والفوز العظيم","cause":"بيع النفس والمال لله (الجهاد والوفاء بالعهد)","result":"الجنة والفوز العظيم","explicit":true,"otherNeedIds":[53],"ref":"سورة التوبة: 111","srcLabel":"القرآن الكريم","quran":{"s":9,"from":111,"to":111,"text":"إِنَّ اللَّهَ اشْتَرَى مِنَ الْمُؤْمِنِينَ أَنْفُسَهُمْ وَأَمْوَالَهُمْ بِأَنَّ لَهُمُ الْجَنَّةَ يُقَاتِلُونَ فِي سَبِيلِ اللَّهِ فَيَقْتُلُونَ وَيُقْتَلُونَ وَعْدًا عَلَيْهِ حَقًّا فِي التَّوْرَاةِ وَالْإِنْجِيلِ وَالْقُرْآنِ وَمَنْ أَوْفَى بِعَهْدِهِ مِنَ اللَّهِ فَاسْتَبْشِرُوا بِبَيْعِكُمُ الَّذِي بَايَعْتُمْ بِهِ وَذَلِكَ هُوَ الْفَوْزُ الْعَظِيمُ (111)","hl":[[0,355,1]]}},{"id":"ق-0828","fp":"6cb620970608","stateId":701,"easy":"الهجرة في سبيل الله ثم القتل أو الموت ← رزق حسن ومدخل يرضونه","cause":"الهجرة في سبيل الله ثم القتل أو الموت","result":"رزق حسن ومدخل يرضونه","explicit":true,"otherNeedIds":[1],"ref":"سورة الحج: 58–59","srcLabel":"القرآن الكريم","quran":{"s":22,"from":58,"to":59,"text":"وَالَّذِينَ هَاجَرُوا فِي سَبِيلِ اللَّهِ ثُمَّ قُتِلُوا أَوْ مَاتُوا لَيَرْزُقَنَّهُمُ اللَّهُ رِزْقًا حَسَنًا وَإِنَّ اللَّهَ لَهُوَ خَيْرُ الرَّازِقِينَ (58) لَيُدْخِلَنَّهُمْ مُدْخَلًا يَرْضَوْنَهُ وَإِنَّ اللَّهَ لَعَلِيمٌ حَلِيمٌ (59)","hl":[[0,235,1]]}},{"id":"س-06874","fp":"647b2042d1c7","stateId":701,"easy":"إذا قاتلت في سبيل الله فقُتلت ← يضحك الله إليك ويدخلك الجنة","cause":"يُقَاتِلُ هذا في سَبيلِ اللَّهِ، فيُقْتَلُ، ثُمَّ يَتُوبُ اللَّهُ علَى القَاتِلِ، فيُسْتَشْهَدُ","result":"يَضْحَكُ اللَّهُ إلى رَجُلَيْنِ يَقْتُلُ أحَدُهُما الآخَرَ يَدْخُلَانِ الجَنَّةَ","explicit":true,"repOf":"س-04358","otherNeedIds":[23],"ref":"العواصم من القواصم 224","text":["حديث: الضَّحِكُ والفَرَحُ [يعني حديث: أنَّ رَسولَ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ قَالَ: ",["يَضْحَكُ اللَّهُ إلى رَجُلَيْنِ يَقْتُلُ أحَدُهُما الآخَرَ يَدْخُلَانِ الجَنَّةَ",2],": ",["يُقَاتِلُ هذا في سَبيلِ اللَّهِ، فيُقْتَلُ، ثُمَّ يَتُوبُ اللَّهُ علَى القَاتِلِ، فيُسْتَشْهَدُ",1],".]             [وحديث: إنَّ المُؤْمِنَ يَرَى ذُنُوبَهُ كَأنَّهُ قاعِدٌ تَحْتَ جَبَلٍ يَخافُ أنْ يَقَعَ عليه، وإنَّ الفاجِرَ يَرَى ذُنُوبَهُ كَذُبابٍ مَرَّ علَى أنْفِهِ فقالَ به هَكَذا، قالَ أبو شِهابٍ: بيَدِهِ فَوْقَ أنْفِهِ. ثُمَّ قالَ: لَلَّهُ أفْرَحُ بتَوْبَةِ عَبْدِهِ مِن رَجُلٍ نَزَلَ مَنْزِلًا وبِهِ مَهْلَكَةٌ ، ومعهُ راحِلَتُهُ ، عليها طَعامُهُ وشَرابُهُ، فَوَضَعَ رَأْسَهُ فَنامَ نَوْمَةً، فاسْتَيْقَظَ وقدْ ذَهَبَتْ راحِلَتُهُ ، حتَّى إذا اشْتَدَّ عليه الحَرُّ والعَطَشُ أوْ ما شاءَ اللَّهُ، قالَ: أرْجِعُ إلى مَكانِي، فَرَجَعَ فَنامَ نَوْمَةً، ثُمَّ رَفَعَ رَأْسَهُ، فإذا راحِلَتُهُ عِنْدَهُ.]"],"grade":"صحيح","narrator":"[أبو هريرة]   [عبدالله بن مسعود]","muhaddith":"صحيح","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"3l1JaNIH","merged":5,"otherRefs":["تخريج المسند لشعيب 10636 (صحيح)","صحيح مسلم 1890 (صحيح)","تخريج المسند لشعيب 7326 (صحيح)"]},{"id":"س-08088","fp":"a4c5c6e99637","stateId":701,"easy":"إذا استُشهدت ← تكون روحك في أجواف طير خضر","cause":"لمَّا أُصيبَ إخْوانُكم بأُحُدٍ","result":"جَعَلَ اللهُ أرْواحَهم في أجْوافِ طَيْرٍ خُضْرٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-04140"],"otherNeedIds":[63],"ref":"الأحاديث المختارة 10 / 349","srcLabel":"متفق عليه","text":["«",["لمَّا أُصيبَ إخْوانُكم بأُحُدٍ",1]," ",["جَعَلَ اللهُ أرْواحَهم في أجْوافِ طَيْرٍ خُضْرٍ",2]," تَرِدُ أنْهارَ الجنَّةَ، وتَأكُلُ مِن ثِمارِها، وتَأوي إلى قَناديلَ مِن ذَهَبٍ مُعلَّقةٍ في ظِلِّ العَرْشِ، فلمَّا وَجَدوا طِيبَ مَأكَلِهم ومَشرَبِهم ومَقيلِهم قالوا: مَن يُبلِّغْ إخْوانَنا عنَّا أنَّا في الجنَّةِ نُرزَقُ؛ لئلَّا يَنكُلوا عِنْدَ الحَرْبِ، ولا يَزهَدوا في الجِهادِ؟ قالَ: فقالَ اللهُ عَزَّ وجَلَّ: أنا أُبلِّغُهم عنكم، قالَ: فأَنزَلَ اللهُ: {وَلَا تَحْسَبَنَّ الَّذِينَ قُتِلُوا فِي سَبِيلِ اللَّهِ أَمْوَاتًا بَلْ أَحْيَاءٌ عِنْدَ رَبِّهِمْ يُرْزَقُونَ}»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"مغازي › غزوة أحد","dorar":"aXGVhBIe","merged":2,"otherRefs":["سبل الهدى والرشاد 4/75 (حسن)"]},{"id":"س-04152","fp":"8410d03b4471","stateId":701,"easy":"إذا جاهدت بنفسك ومالك حتى قُتلت صابراً محتسباً مقبلاً ← تدخل الجنة","cause":"إن جاهدتُ في سبيلِ اللهِ بنفسي ومالي حتى أُقتَلَ صابِرًا مُحتَسِبًا مُقبِلًا غيرَ مُدْبرٍ","result":"أأدخُلُ الجنَّةَ؟ قال: نعم، فلما ولَّى دعاه، فقال: إلَّا أن يكونَ عليك دَينٌ ليس له عندك وَفاءٌ","explicit":true,"otherNeedIds":[2],"ref":"تخريج المسند لشعيب 14797","srcLabel":"أحمد","text":["فذكر معناه [أي: معنى حديث: جاء رجلٌ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: أرأيتَ ",["إن جاهدتُ في سبيلِ اللهِ بنفسي ومالي حتى أُقتَلَ صابِرًا مُحتَسِبًا مُقبِلًا غيرَ مُدْبرٍ",1],"، ",["أأدخُلُ الجنَّةَ؟ قال: \"نعم\"، فلما ولَّى دعاه، فقال: \"إلَّا أن يكونَ عليك دَينٌ ليس له عندك وَفاءٌ",2],"]"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (14797) واللفظ له، والحارث في ((المسند)) (443)، وأبو يعلى (1857)","bab":"جنائز وموت › قضاء دين الميت","dorar":"MQEoK8an","merged":3,"otherRefs":["تخريج المسند لشعيب 14490 (صحيح)","تخريج المسند لشعيب 19078 (صحيح)"]},{"id":"س-02524","fp":"0d8866ec2a72","stateId":701,"easy":"إذا خرجت في سبيل الله فوقصتك دابتك ← حق على الله أن يدخلك الجنة","cause":"أو وَقَصَتْه دابَّتُه","result":"كانَ حَقًّا على اللهِ أن يُدخِلَه الجَنَّةَ","explicit":true,"ref":"الأحكام الوسطى 2/356","srcLabel":"النسائي","text":["سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: \"إنَّ الشَّيْطانَ قَعَدَ لابنِ آدَمَ بأَطْرُقِه، فقَعَدَ له بطَريقِ الإسْلامِ فقالَ: تُسلِمُ وتَذَرُ دينَك ودينَ آبائِك وآباءِ أبيك، فعَصاه فأَسلَمَ، ثُمَّ قَعَدَ له بطَريقِ الهِجْرةِ فقالَ: تُهاجِرُ وتَذَرُ أرْضَك وسَماءَك، وإنَّما مَثَلُ المُهاجِرِ كمَثَلِ الفَرَسِ في الطِّوَلِ، فعَصاه فهاجَرَ، ثُمَّ قَعَدَ له بطَريقِ الجِهادِ، فقالَ: تُجاهِدُ، فهو جَهْدُ النَّفْسِ والمالِ، فتَقاتِلُ فتُقتَلُ، فتُنكَحُ المَرْأةُ، ويُقسَمُ المالُ، فعَصاه فجاهَدَ\"، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: \"فمَن فَعَلَ ذلك كانَ حَقًّا على اللهِ أن يُدخِلَه الجَنَّةَ، ومَن قُتِلَ كانَ حَقًّا على اللهِ أن يُدخِلَه الجَنَّةَ، وإن غَرِقَ كانَ حَقًّا على اللهِ أن يُدخِلَه الجَنَّةَ، ",["أو وَقَصَتْه دابَّتُه",1]," ",["كانَ حَقًّا على اللهِ أن يُدخِلَه الجَنَّةَ",2],"."],"grade":"صحيح","narrator":"[سبرة] بن أبي فاكه","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه النسائي (3134)، والبغوي في ((معجم الصحابة)) (1188)، وإسماعيل الأصفهاني في ((الترغيب والترهيب)) (839) .","bab":"إيمان › أعمال الجن والشياطين","dorar":"bfmcbg8p"},{"id":"س-03126","fp":"0a562b613716","stateId":701,"easy":"إذا صنعت السهم أو أمددت به أو رميت به في سبيل الله ← يدخلك الله الجنة","cause":"صانعَهُ والممدَّ بِهِ، والرَّاميَ بِهِ في سَبيلِ اللَّهِ","result":"إنَّ اللَّهَ يدخلُ الجنَّةَ بالسَّهمِ الواحدِ ثلاثةً","explicit":true,"repOf":"س-01301","ref":"صحيح ابن خزيمة 4/ 190","text":["غَيرتانِ إحداهُما يحبُّها اللَّهُ، والأُخرَى يبغضُها اللَّهُ: الغيرةُ في الرِّيبةِ يُحبُّها اللَّهُ والغَيرةُ في غيرِ ريبةٍ يبغضُها اللَّهُ، والمَخيلةُ إذا تَصدَّقَ الرَّجلُ يُحبُّها اللَّهُ، والمَخيلةُ في الكبرِ يُبغِضُها اللَّهُ. وقالَ: ثلاثةٌ تستجابُ دعوتُهُمُ، الوالدُ والمُسافرُ والمَظلومُ وقالَ: ",["إنَّ اللَّهَ يدخلُ الجنَّةَ بالسَّهمِ الواحدِ ثلاثةً",2],"، ",["صانعَهُ والممدَّ بِهِ، والرَّاميَ بِهِ في سَبيلِ اللَّهِ",1]],"grade":"صحيح","narrator":"عقبة بن عامر الجهني","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (17398)، والروياني في ((المسند)) (186)، والحاكم (1525) واللفظ لهم.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"CFBRAfYL"},{"id":"س-03206","fp":"13125d71199c","stateId":701,"easy":"إذا آمنت وأسلمت وهاجرت ← لك بيت في ربض الجنة وبيت في وسطها","cause":"لِمَنْ آمَنَ وأسلمَ وهاجَرَ","result":"بِبَيْتٍ في رَبَضِ الجنةِ ، وبِبَيْتٍ في وسَطِ الجنةِ","explicit":true,"ref":"صحيح الموارد 1313","srcLabel":"النسائي","text":["أنا زَعِيمٌ – والزَّعِيمُ الحَمِيلُ – ",["لِمَنْ آمَنَ وأسلمَ وهاجَرَ",1]," ؛ ",["بِبَيْتٍ في رَبَضِ الجنةِ ، وبِبَيْتٍ في وسَطِ الجنةِ",2]," ، وأنا زَعِيمٌ لِمَنْ آمَنَ بي وأسلمَ وجَاهَدَ في سبيلِ اللهِ ؛ بِبَيْتٍ في رَبَضِ الجنةِ ، وبِبَيْتٍ في وسَطِ الجنةِ ، وببيتٍ في أعَلَى غُرَفِ الجنةِ ، فمَنْ فعلَ ذلكَ ؛ لمْ يَدَعْ لِلْخَيْرِ مَطْلَبًا ، ولا مِنَ الشَّرِّ مَهْرَبًا ، يموتُ حيثُ شاءَ أنْ يَمُوتَ"],"grade":"صحيح","narrator":"فضالة بن عبيد","muhaddith":"صحيح","takhrij":"أخرجه النسائي (3133)، وابن حبان (353)، والبزار (3754) باختلاف يسير.","bab":"إيمان › فضل الإيمان","dorar":"eO6tsdoY"},{"id":"س-04266","fp":"188d3b02f6c6","stateId":701,"easy":"إذا قُتلت دون مالك مظلوماً ← فلك الجنة","cause":"مَنْ قُتِلَ دُونَ مالِهِ مَظلومًا","result":"فلهُ الجنةُ","explicit":true,"ref":"صحيح الجامع 6446","srcLabel":"النسائي","text":[["مَنْ قُتِلَ دُونَ مالِهِ مَظلومًا ",1],["فلهُ الجنةُ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه النسائي (4086)، وأحمد (7084)","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"13BJpqdD"},{"id":"س-04407","fp":"6475bf98ed70","stateId":701,"easy":"إذا قُتلت في سبيل الله ← فأنت في الجنة","cause":"مَن قُتِلَ في سبيلِ اللَّهِ","result":"فَهوَ في الجنَّةِ","explicit":true,"ref":"تخريج المسند لشاكر 1/169","srcLabel":"الترمذي","text":["عن أبي العجفاء قال: سَمِعْتُ عمرَ رضيَ اللَّهُ عنهُ يقولُ : لا تُغلوا صُدُقَ النِّساءِ فإنَّها لو كانت مَكْرمةً في الدُّنيا أو تَقوى في الآخرةِ لَكانَ أولاكم بِها النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ ما أنكحَ شيئًا من بَناتِهِ ولا نسائِهِ فوقَ اثنتَي عشرةَ وقيَّةً وأُخرى تقولونَها في مغازيكم : قُتِلَ فلانٌ شَهيدًا ، ماتَ فلانٌ شَهيدًا ، ولعلَّهُ أن يَكونَ قد أوقرَ عَجُزَ دابَّتِهِ ، أو دفَّ راحلتِهِ ذَهَبًا وفضَّةً يبتَغي التِّجارةَ ، فلا تَقولوا ذاكُم ولَكِن قولوا كما قالَ مُحمَّدٌ صلَّى اللَّهُ عليهِ وسلَّمَ : ",["مَن قُتِلَ في سبيلِ اللَّهِ ",1],["فَهوَ في الجنَّةِ",2]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (1114)، والنسائي (3349)، وابن ماجه (1887)، وأحمد (340) واللفظ له","bab":"جهاد › النية في القتال والغزو","dorar":"epASd6so"},{"id":"س-04423","fp":"b364a2044d88","stateId":701,"easy":"إذا سرّك أن تكتنفك الحور العين ← فتقدم بين الصفين محتسباً","cause":"فليتقدمْ بين الصفين محتسبًا","result":"من سره أن يكتنفَه الحورُ العينُ","explicit":true,"ref":"فتح الباري لابن حجر 13/92","srcLabel":"أحمد","text":["عن أبي الرضا سمعت عمارًا يوم صِفِّين يقولُ ",["من سره أن يكتنفَه الحورُ العينُ ",2],["فليتقدمْ بين الصفين محتسبًا",1]],"grade":"صحيح","narrator":"أبو الرضا","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي شيبة (38994) باختلاف يسير، وأحمد (18884)، والحاكم (5668) بنحوه.","bab":"جهاد › النية في القتال والغزو","dorar":"iaf5qWZN"},{"id":"س-04471","fp":"4ef82db494e8","stateId":701,"easy":"إذا قُتلت قعصاً (فوراً) في سبيل الله ← فقد استوجبت الجنة","cause":"ومَنْ قُتِلَ قَعْصًا","result":"فقد استَوْجَبَ الجنَّةَ","explicit":true,"ref":"المستدرك على الصحيحين 2480","srcLabel":"الحاكم","text":["مَنْ خَرَجَ مِن بيتِه مُجاهِدًا في سبيلِ اللهِ -قالَ: ثُمَّ ضَمَّ أَصابِعَهُ الثَّلاثَ- وأين المجاهدونَ في سبيلِ اللهِ؟ مَنْ خَرَجَ في سبيلِ اللهِ، فخَرَّ عنْ دابَّتِه، فماتَ؛ فقد وَقَعَ أَجرُهُ على اللهِ، وإنْ لَدَغَتْهُ دابَّةٌ فماتَ؛ فقد وَقَعَ أَجرُهُ على اللهِ، ومَنْ ماتَ حَتْفَ أَنفِهِ -قالَ: وإنَّها لكلمةٌ ما سَمِعْتُها مِن أَحَدٍ مِنَ العربِ أوَّلَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؛ يعني: بحَتفِ أَنفِهِ على فِراشِهِ- فقد وَقَعَ أَجرُهُ على اللهِ، ",["ومَنْ قُتِلَ قَعْصًا؛ ",1],["فقد استَوْجَبَ الجنَّةَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عتيك","muhaddith":"صحيح الإسناد","bab":"جهاد › فضل الجهاد","dorar":"fcQtrsbj"},{"id":"س-04550","fp":"2bc21d0b9b1d","stateId":701,"easy":"إذا استُشهدت ← لا تجف الأرض من دمك حتى تبتدرك زوجتاك من الحور","cause":"ذُكِر الشَّهيدُ","result":"‌لا ‌تجِفُّ ‌الأرضُ ‌مِن ‌دمِ ‌الشَّهيدِ حتَّى يبتدِرَه زوجتاه، كأنَّهما ظِئرانِ أظلَّتا -أو أضلَّتا- فَصيلَيهما ببَراحٍ مِن الأرضِ، بيدِ كُلِّ واحدةٍ -أو في يدِ كُلِّ واحِدةٍ- منهما حُلَّةٌ خيرٌ مِن الدُّنيا وما فيها","explicit":true,"ref":"علل الدارقطني 2101","srcLabel":"أحمد","text":["لا تجِفُّ الأرضُ مِن دمِ الشَّهيدِ حتَّى تبتدِرَه زوجتاه...، الحديث. [يعني حديثَ: عن أبي ‌هُرَيرةَ: أنَّه قال: ",["ذُكِر الشَّهيدُ",1]," عندَ النَّبيِّ صلَّى اللهُ عليه وسلَّم، فقال: \"",["‌لا ‌تجِفُّ ‌الأرضُ ‌مِن ‌دمِ ‌الشَّهيدِ حتَّى يبتدِرَه زوجتاه، كأنَّهما ظِئرانِ أظلَّتا -أو أضلَّتا- فَصيلَيهما ببَراحٍ مِن الأرضِ، بيدِ كُلِّ واحدةٍ -أو في يدِ كُلِّ واحِدةٍ- منهما حُلَّةٌ خيرٌ مِن الدُّنيا وما فيها",2],"\"]."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"يرويه ابنُ عَونٍ، عن هلالِ بنِ أبي زَينبَ، عن شهرِ بنِ حَوشَبٍ، فوقَفه حمَّادُ بنُ زيدٍ، عن ابنِ عَونٍ، ورفَعه غَيرُه، ورَفعُه صحيحٌ.","takhrij":"أخرجه ابن ماجة (2798)، وأحمد (9520)، وابن أبي شيبة (19668) باختلاف يسير.","bab":"جهاد › فضل الشهيد","dorar":"FLa6cWI3"},{"id":"س-06835","fp":"6c99a78bc3cd","stateId":701,"easy":"إذا جاهدت في سبيل الله ← فأنت على الله ضامن: إن قبضك أورثك الجنة وإن رجعك رجعك بأجر وغنيمة","cause":"المجاهِدُ في سبيلي","result":"هو علَيَّ ضامِنٌ ، إِنْ قبضتُّه أورثْتُهُ الجنَّةَ ، وإِنْ رجَّعْتُهُ رجَّعْتُهُ بأجرٍ أو غنيمَةٍ","explicit":true,"otherNeedIds":[45,1,25],"ref":"صحيح الجامع 8135","srcLabel":"الترمذي","text":["يقولُ اللهُ تعالى : ",["المجاهِدُ في سبيلي",1]," ",["هو علَيَّ ضامِنٌ ، إِنْ قبضتُّه أورثْتُهُ الجنَّةَ ، وإِنْ رجَّعْتُهُ رجَّعْتُهُ بأجرٍ أو غنيمَةٍ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1620) واللفظ له، وابن أبي عاصم في ((الجهاد)) (45)، والضياء في ((الأحاديث المختارة)) (2399)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"0mnH761h"},{"id":"س-07208","fp":"0fce2ad21fc8","stateId":701,"easy":"إذا أبى المعتدي إلا قتالك فقاتلته ← فإن قتلك فأنت في الجنة","cause":"فإن أبَى فقاتِلْه","result":"فإن قتلَكَ فأنت في الجنةِ وإن قتلتَهُ فإنه في النَّارِ","explicit":true,"otherNeedIds":[62],"ref":"السلسلة الصحيحة 7/746","srcLabel":"النسائي","text":["سأل سائلٌ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ فقال يا رسولَ اللهِ إنْ عدَا عليَّ عادٍ فقال له النبيُّ صلَّى اللهُ عليهِ وسلَّمَ ذكِّرْهُ باللهِ وأْمُرْهُ بتذكيرِه ثلاثَ مرَّاتٍ ",["فإن أبَى فقاتِلْه",1]," ",["فإن قتلَكَ فأنت في الجنةِ وإن قتلتَهُ فإنه في النَّارِ",2]],"grade":"صحيح","narrator":"قهيد الغفاري","muhaddith":"رجاله ثقات لكن فيه ثلاث علل [وروي] بإسناد صحيح عن أبي هريرة","takhrij":"أخرجه النسائي (4082)، وأحمد (15526) باختلاف يسير.","bab":"علم › حسن السؤال ونصح العالم","dorar":"7UabI6iq"},{"id":"س-07137","fp":"3c65bf8cb764","stateId":701,"easy":"إذا قاتلت في سبيل الله حتى قُتلت ← تدخل الجنة","cause":"قاتلتُ هؤلاءِ حتَّى أُقتَلَ","result":"أدخلِ الجنَّةَ؟ قالَ: نعَم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04358","otherNeedIds":[47],"ref":"تاريخ الإسلام 2/419","text":["أنَّ رجلًا أتى النَّبيَّ صلَّى اللَّهُ عليْهِ وسلَّمَ فقالَ: يا رسولَ اللَّهِ إنِّي رجلٌ أسوَدُ اللَّونِ قبيحُ الوجْهِ. منتنُ الرِّيحِ لا مالَ لي فإن ",["قاتلتُ هؤلاءِ حتَّى أُقتَلَ",1]," ",["أدخلِ الجنَّةَ؟ قالَ: نعَم",2]," . فتقدَّمَ فقاتلَ حتَّى قُتِلَ. فأتى عليْهِ النَّبيُّ صلَّى اللَّهُ عليْهِ وسلَّمَ وَهوَ مقتولٌ فقالَ: لقد أحسنَ اللَّهُ وجْهكَ وطيَّبَ روحَكَ وَكثَّرَ مالَكَ . قالَ: وقالَ لِهذا أو لغيرِهِ: لقد رأيتُ زوجتيْهِ منَ الحورِ العينِ يتنازعانِهِ جبَّتَهُ عنْهُ تدخلانِ فيما بينَ جلدِهِ وجبَّتِهِ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (2463)، والبيهقي في ((دلائل النبوة)) (4/221) يلفظه.","bab":"علم › حسن السؤال ونصح العالم","dorar":"Ou25wuAo","merged":5,"otherRefs":["المستدرك على الصحيحين 2498 (صحيح)","صحيح مسلم 1899 (صحيح)","حلية الأولياء 3/401 (صحيح)","تخريج صحيح ابن حبان 4653 (صحيح)"]},{"id":"س-04537","fp":"f8cef186dc93","stateId":701,"easy":"إذا قُتلت في سبيل الله ← فلك الجنة","cause":"إن قُتِلْتُ في سبيلِ اللهِ","result":"الجنة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[47],"ref":"تخريج المسند لشعيب 19077","srcLabel":"النسائي","text":["إنَّ رجلًا جاء إلى النبيِّ، فقال : يا رسولَ اللهِ : ما لي ",["إن قُتِلْتُ في سبيلِ اللهِ",1],"؟ قال: «",["الجنة",2],"» . قال: فلما ولَّى قال: « إلا الدَّيْنَ، سارَّنِي به جبريلُ آنِفًا »"],"grade":"صحيح","narrator":"محمد بن عبدالله بن جحش","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (17253)، وابن أبي شيبة (12144) بلفظه، والنسائي (4684) بنحوه.","bab":"جهاد › فضل الشهيد","dorar":"IRmklYxj","merged":2,"otherRefs":["صحيح النسائي 3154 (صحيح)"]},{"id":"س-07138","fp":"6ba2bca24e16","stateId":701,"easy":"إذا قاتلت حتى قُتلت ← يحسّن الله وجهك ويطيّب روحك","cause":"فتقدَّمَ فقاتلَ حتَّى قُتِلَ","result":"لقد أحسنَ اللَّهُ وجْهكَ وطيَّبَ روحَكَ وَكثَّرَ مالَكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[47],"ref":"تاريخ الإسلام 2/419","srcLabel":"الحاكم","text":["أنَّ رجلًا أتى النَّبيَّ صلَّى اللَّهُ عليْهِ وسلَّمَ فقالَ: يا رسولَ اللَّهِ إنِّي رجلٌ أسوَدُ اللَّونِ قبيحُ الوجْهِ. منتنُ الرِّيحِ لا مالَ لي فإن قاتلتُ هؤلاءِ حتَّى أُقتَلَ أدخلِ الجنَّةَ؟ قالَ: نعَم . ",["فتقدَّمَ فقاتلَ حتَّى قُتِلَ",1],". فأتى عليْهِ النَّبيُّ صلَّى اللَّهُ عليْهِ وسلَّمَ وَهوَ مقتولٌ فقالَ: ",["لقد أحسنَ اللَّهُ وجْهكَ وطيَّبَ روحَكَ وَكثَّرَ مالَكَ .",2]," قالَ: وقالَ لِهذا أو لغيرِهِ: لقد رأيتُ زوجتيْهِ منَ الحورِ العينِ يتنازعانِهِ جبَّتَهُ عنْهُ تدخلانِ فيما بينَ جلدِهِ وجبَّتِهِ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (2463)، والبيهقي في ((دلائل النبوة)) (4/221) يلفظه.","bab":"علم › حسن السؤال ونصح العالم","dorar":"Ou25wuAo","merged":2,"otherRefs":["المستدرك على الصحيحين 2498 (صحيح)"]},{"id":"س-08358","fp":"bb3e3ae290bf","stateId":701,"easy":"إذا جاهدت فلم تنزل إلا مصلياً أو لحاجة ← فقد أوجبت","cause":"هل نزَلْتَ اللَّيلةَ؟ قال: لا، إلَّا مُصَلِّيًا أو قاضيًا حاجةً","result":"قد أَوْجَبْتَ، فلا عليك ألَّا تعمَلَ بعدها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[47],"ref":"الصحيح المسند 462","srcLabel":"الصحيح المسند","text":["عن سهل بن الحنظلية: أنَّهم ساروا مع رسولِ اللهِ صلَّى اللهُ عليه وعلى آله وسلَّم يومَ حُنَيْنٍ، فأطْنَبوا السَّيرَ حتَّى كان عَشِيَّةً، فحضرَتْ صلاةٌ عند رسولِ اللهِ صلَّى اللهُ عليه وعلى آله وسلَّم، فجاء رجُلٌ فارِسٌ، فقال: يا رسولَ اللهِ، إنَّي انطلَقْتُ بين أيديكم حتَّى طلَعْتُ جبَلَ كذا وكذا، فإذا أنا بِهَوازِنَ على بكرةِ آبائِهم؛ بِظُعُنِهم ونَعَمِهم وشَائِهم، اجتَمَعوا إلى حُنَيْنٍ. فتبسَّمَ رسولُ اللهِ صلَّى اللهُ عليه وعلى آله وسلَّم، وقال: تلك غنيمةُ المُسلمينَ غدًا إنْ شاء اللهُ. ثمَّ قال: مَن يحرُسُنا اللَّيلةَ؟ قال أنسُ بنُ أبي مَرْثَدٍ الغَنَوِيُّ: أنا يا رسولَ اللهِ، قال: فارْكَبْ، فرَكِبَ فرَسًا له وجاء إلى رسولِ اللهِ صلَّى اللهُ عليه وعلى آله وسلَّم، فقال له رسولُ اللهِ صلَّى اللهُ عليه وعلى آله وسلَّم: استقْبِلْ هذا الشِّعْبَ حتَّى تكونَ في أعلاهُ، ولا نُغَرَّنَّ مِن قِبَلِك اللَّيلةَ. فلمَّا أصبَحْنا خرَجَ رسولُ اللهِ صلَّى اللهُ عليه وعلى آله وسلَّم إلى مُصلَّاه، فركَعَ ركعتينِ، ثمَّ قال: هل أحسسَتُم فارِسَكم؟ قالوا: يا رسولَ اللهِ، ما أحسَسْناه. فثُوِّبَ بالصَّلاةِ، فجعَلَ رسولُ اللهِ صلَّى اللهُ عليه وعلى آله وسلَّم يُصَلِّي وهو يلتَفِتُ إلى الشِّعبِ، حتَّى إذا قضى صلاتَه وسلَّمَ، فقال: أبْشِروا؛ فقد جاءكم فارِسُكم. فجعَلْنا ننظُرُ إلى خِلالِ الشَّجرِ في الشِّعبِ، فإذا هو قد جاء، حتَّى وقَفَ على رسولِ اللهِ صلَّى اللهُ عليه وعلى آله وسلَّم وقال: إنِّي انطلَقْتُ حتَّى كنْتُ في أعلى هذا الشِّعبِ حيث أمَرَني رسولُ اللهِ صلَّى اللهُ عليه وعلى آله وسلَّم، فلمَّا أصبَحْتُ اطَّلعْتُ الشِّعبَينِ كلَيْهما، فنظَرْتُ فلم أَرَ أحدًا. فقال له رسولُ اللهِ صلَّى اللهُ عليه وعلى آله وسلَّم: ",["هل نزَلْتَ اللَّيلةَ؟ قال: لا، إلَّا مُصَلِّيًا أو قاضيًا حاجةً",1],". فقال له رسولُ اللهِ صلَّى اللهُ عليه وعلى آله وسلَّمَ: ",["قد أَوْجَبْتَ، فلا عليك ألَّا تعمَلَ بعدها",2],"."],"grade":"صحيح","narrator":"سهل ابن الحنظلية الأنصاري","muhaddith":"صحيح","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"p8boniEK","merged":2,"otherRefs":["تخريج زاد المعاد 3/75 (صحيح)"]},{"id":"س-03624","fp":"ecaa6ebd5785","stateId":701,"easy":"إذا جاهدت ← فأبواب الجنة تحت ظلال السيوف","cause":"تحت ظِلالِ السُّيوفِ","result":"إنَّ أبْوابَ الجنَّةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"similar":["س-03395"],"ref":"تخريج المسند لشعيب 19680","srcLabel":"مسلم","text":[["إنَّ أبْوابَ الجنَّةِ",2]," ",["تحت ظِلالِ السُّيوفِ",1],"، قال: فقام رَجُلٌ مِن القَومِ رَثُّ الهَيئةِ فقال: يا أبا موسى، أأنتَ سَمِعتَ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ يقولُ هذا؟ قال: نَعَمْ، قال: فرَجَعَ إلى أصحابِه فقال: أقرَأُ عليكم السَّلامَ، ثُمَّ كَسَرَ جَفنَ سَيفِه، ثُمَّ مَشى بسَيفِه إلى العَدوِّ، فضَرَبَ به حتى قُتِلَ."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (1902)، وأحمد (19680) واللفظ له","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"8AY5nxkI","merged":5,"otherRefs":["صحيح الترمذي 1659 (صحيح)","حلية الأولياء 2/360 (صحيح)","المستدرك على الصحيحين 2423 (صحيح)","إرشاد الساري 5/53 (صحيح)"]},{"id":"س-04484","fp":"d23d8ee891a1","stateId":701,"easy":"إذا جاهدت في سبيل الله ← وجبت لك الجنة","cause":"من جاهد في سبيلِ اللهِ","result":"وجبَتْ له الجنَّةُ","explicit":true,"repOf":"س-04358","ref":"الترغيب والترهيب 2/256","text":["أنَّ رجلًا جاء إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم فقال يا رسولَ اللهِ إنَّ فلانًا هلك فصلِّ عليه فقال عمرُ إنَّه فاجرٌ فلا تصلِّ عليه فقال الرَّجلُ يا رسولَ اللهِ ألم ترَ اللَّيلةَ الَّتي صَبَّحتُ فيها في الحرسِ فإنَّه كان فيهم فقام رسولُ اللهِ فصلَّى عليه ثمَّ تبِعه حتَّى جاء قبرَه قعد حتَّى إذا فرغ منه حثَى عليه ثلاثَ حثياتٍ ثمَّ قال يُثني عليك النَّاسُ شرًّا وأُثني عليك خيرًا فقال عمرُ وما ذاك يا رسولَ اللهِ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم دعنْا منك يا بنَ الخطَّابِ ",["من جاهد في سبيلِ اللهِ ",1],["وجبَتْ له الجنَّةُ",2]],"grade":"حسن","narrator":"أبو المنذر الجهني","muhaddith":"إسناده لا بأس به إن شاء الله تعالى","takhrij":"أخرجه الطبراني (22/337) (846)، وأبو نعيم في ((معرفة الصحابة)) (7016) باختلاف يسير","bab":"جهاد › فضل الجهاد","dorar":"j3VrlOb2"},{"id":"س-04145","fp":"2c2f0d88cca8","stateId":701,"easy":"إذا استُشهدت ← تكون على بارق نهر بباب الجنة يأتيك رزقك","cause":"الشُّهَداءُ","result":"على بارِقِ نَهْرٍ ببابِ الجنَّةِ في قُبَّةٍ خَضْراءَ يَخرُجُ عليهم رِزْقُهم مِن الجنَّةِ بُكْرةً وعَشِيًّا","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[63,1],"ref":"الأحاديث المختارة 13 / 66","srcLabel":"متفق عليه","text":["«",["الشُّهَداءُ",1]," ",["على بارِقِ نَهْرٍ ببابِ الجنَّةِ في قُبَّةٍ خَضْراءَ يَخرُجُ عليهم رِزْقُهم مِن الجنَّةِ بُكْرةً وعَشِيًّا",2],"»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"جنائز وموت › روح المؤمن بعد الموت","dorar":"Lkd4wdJP","merged":2,"otherRefs":["أسئلة وأجوبة لابن حجر 32 (حسن)"]},{"id":"س-04505","fp":"a5d91152a553","stateId":701,"easy":"إذا استُشهدت ← تسكن دار الشهداء أحسن الدور","cause":"فدارُ الشُّهَداءِ","result":"دارًا هي أحسَنُ وأفضَلُ، لم أرَ قَطُّ أحسَنَ مِنها","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح البخاري 2791","srcLabel":"متفق عليه","text":["رَأيتُ اللَّيلةَ رَجُلَينِ أتَياني، فصَعِدا بي الشَّجَرةَ، فأدخَلاني ",["دارًا هي أحسَنُ وأفضَلُ، لم أرَ قَطُّ أحسَنَ مِنها",2],"، قالا: أمَّا هذه الدَّارُ ",["فدارُ الشُّهَداءِ",1],"."],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"[صحيح]","takhrij":"من أفراد البخاري على مسلم","bab":"جهاد › فضل الشهيد","dorar":"mrAHvWkk"},{"id":"س-04175","fp":"45ee5f27f823","stateId":701,"easy":"إذا دافعت عن مالك فقُتلت ← ففي الجنة","cause":"إن عُدِيَ على مالي ؟ قالَ : فأنشِدِ اللَّهَ قالَ : فإن أبَوا عليَّ قالَ : أنشِدِ اللَّهَ قالَ : فإن أبوا عليَّ قالَ : فأنشدِ اللَّه قالَ فإن أبوا عليَّ قالَ : فقاتِلْ ، فإن قُتِلتَ","result":"ففي الجنَّةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[62],"ref":"تخريج المسند لشاكر 16/199","srcLabel":"مسلم","text":["جاءَ رجلٌ إلى رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ : يا رسولَ اللَّهِ أرأيتَ ",["إن عُدِيَ على مالي ؟ قالَ : فأنشِدِ اللَّهَ قالَ : فإن أبَوا عليَّ قالَ : أنشِدِ اللَّهَ قالَ : فإن أبوا عليَّ قالَ : فأنشدِ اللَّه قالَ فإن أبوا عليَّ قالَ : فقاتِلْ ، فإن قُتِلتَ",1]," ",["ففي الجنَّةِ",2]," ، وإن قَتلتَ ففي النَّارِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (4082) باختلاف يسير، وأخرجه مسلم (140) بنحوه","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"I1lQ6JO2"},{"id":"س-02077","fp":"1d9a3cff6844","stateId":701,"easy":"إذا أصابك غبار في سبيل الله ← فهو ذريرة الجنة","cause":"كرهت الغبارَ","result":"إنه لذريرةُ الجنةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 5/290","srcLabel":"أبو داود","text":["بينما رسولُ اللهِ صلَّى اللهُ عليه وسلَّم يمشي معتدلًا عن الطريقِ إذ أبصر شابًا من قريشٍ يسيرُ معتزلًا فقال أليسَ ذاك فلانٌ قالوا نعم قال فادعوه فجاء فقال له النبيُّ صلَّى اللهُ عليه وسلَّم ما لك اعتزلت الطريقَ قال ",["كرهت الغبارَ",1]," قال فلا تعتزلْه فوالذي نفسي بيدِه ",["إنه لذريرةُ الجنةِ",2]],"grade":"حسن","narrator":"ربيع بن زيد","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني (5/ 69) (4608) واللفظ له، وأبو داود في ((المراسيل)) (305)، والدولابي في ((الكنى والأسماء)) (1644) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"2kH0Aay7"},{"id":"س-03395","fp":"6560d20170a3","stateId":701,"easy":"إذا جاهدت ← فالسيوف مفاتيح الجنة","cause":"السيوفَ","result":"مفاتيحُ الجنَّةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-03624","ref":"صحيح الترغيب 1377","text":["عن يزيدِ بنِ شجَرةَ قال : يا أيها الناسُ ! اذكُروا نعمةَ اللهِ عليكم ، ما أحسنَ نعمةَ اللهِ عليكم ، ترى من بين أخضرَ وأحمرَ وأصفرَ وفي الرِّحالِ ، ما فيها . وكان يقولُ : إذا صَفّ الناسُ للصلاةِ ، وصُفُّوا للقتالِ ، فُتِحَتْ أبوابُ السماءِ وأبوابِ الجنَّةِ ، وغُلِّقَتْ أبوابُ النَّارِ ، وزُيِّنَ الحورُ العينُ واطَّلَعْنَ ، فإذا أقبلَ الرجُلُ قلنَ : اللهمَّ انصُرْه ، وإذا أدْبَر احتجَبْن منه وقلنَ اللهمَّ : اغفِرْ له ، فأَنهَكوا وجوهَ القومِ فداءً لكم أبي وأمي ، ولا تُخزوا الحورَ العِينَ فإنَّ أولَ قطرةٍ تنضَحُ من دمِه يُكفَّرُ عنه كلُّ شيءٍ عمِلَه ، وتنزلُ إليه زوجتانِ من الحورِ العِينِ يمسحانِ التُّرابَ عن وجهِه ، ويقولان : قد آنَ لك ، ويقول : قد آن لكما . ثم يُكسَى مئةَ حُلَّةٍ ، ليس من نسيجِ بني آدمَ ، ولكن من نبْتِ الجنَّةِ ، لو وُضِعْنَ بين إصبِعَينِ لوَسِعْنَ . وكان يقول : نُبِّئتُ أنَّ ",["السيوفَ",1]," ",["مفاتيحُ الجنَّةِ",2]," ."],"grade":"صحيح","narrator":"مجاهد بن جبر المكي","muhaddith":"صحيح","takhrij":"أخرجه الطبراني ((22/ 246)\n) (641) واللفظ له، والحاكم (6087) والبيهقي في ((البعث والنشور)) (562) بنحوه","bab":"استغفار › أسباب المغفرة","dorar":"581jlFuy","merged":4,"otherRefs":["السلسلة الصحيحة 6/374 (حسن)","السلسلة الصحيحة 6/374 (صحيح)","مشارع الأشواق 769 (صحيح)"]},{"id":"س-04140","fp":"e598835ed85a","stateId":701,"easy":"إذا استُشهدت ← تكون روحك في طير يُرزق من ثمر الجنة","cause":"أرواحُ الشُّهداءِ","result":"في طيرٍ كالزَّرازيرِ يتعارفون، ويُرزقون من ثمرِ الجنَّةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-08088","otherNeedIds":[63],"ref":"الآيات البينات 79","text":["عن عبدالله بن عمرو قال: ",["أرواحُ الشُّهداءِ",1]," ",["في طيرٍ كالزَّرازيرِ يتعارفون، ويُرزقون من ثمرِ الجنَّةِ",2]],"grade":"صحيح","narrator":"خالد بن معدان","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي شيبة (35111)، والبيهقي في ((البعث والنشور)) (771)، وأبو نعيم في ((صفة الجنة)) (133) باختلاف يسير.","bab":"جنائز وموت › روح المؤمن بعد الموت","dorar":"wWBdc4g1","merged":2,"otherRefs":["مجمع الزوائد 2/332 (حسن)"]},{"id":"س-02504","fp":"2e9a4dfe1079","stateId":701,"easy":"إذا عصيت الشيطان فأسلمت وهاجرت وجاهدت ← فحق على الله أن يدخلك الجنة","cause":"إنَّ الشيطانَ قَعَدَ لِابنِ آدمَ ثلاثةَ مقاعدٍ : قعدَ لهُ في طريقِ الإسلامِ فقال : أتذرُ دينَكَ ودينَ آبائِكَ وتُسْلِمُ ؟ فخالفَهُ وأسلمَ . وقعد لهُ في طريقِ الهجرةِ فقال لهُ : أتذرُ أهلكَ ومالكَ فتهاجرُ ؟ فخالفَهُ ثُمَّ هاجرَ . وقعدَ لهُ في طريقِ الجهادِ فقال لهُ : تجاهدُ فتقتلُ وتنكحُ أهلُكَ ويقسمُ مالُكَ ، فخالفَهُ فجاهدَ فقتلَ","result":"فحقٌّ على اللهِ أنْ يُدْخِلهُ الجنةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"أحكام القرآن لابن العربي 2/463","srcLabel":"أحكام القرآن لابن العربي","text":[["إنَّ الشيطانَ قَعَدَ لِابنِ آدمَ ثلاثةَ مقاعدٍ : قعدَ لهُ في طريقِ الإسلامِ فقال : أتذرُ دينَكَ ودينَ آبائِكَ وتُسْلِمُ ؟ فخالفَهُ وأسلمَ . وقعد لهُ في طريقِ الهجرةِ فقال لهُ : أتذرُ أهلكَ ومالكَ فتهاجرُ ؟ فخالفَهُ ثُمَّ هاجرَ . وقعدَ لهُ في طريقِ الجهادِ فقال لهُ : تجاهدُ فتقتلُ وتنكحُ أهلُكَ ويقسمُ مالُكَ ، فخالفَهُ فجاهدَ فقتلَ",1]," ",["فحقٌّ على اللهِ أنْ يُدْخِلهُ الجنةَ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"إيمان › أعمال الجن والشياطين","dorar":"CKbA5kDw"},{"id":"س-02522","fp":"0cb4976ddd11","stateId":701,"easy":"إذا قُتلت في سبيل الله ← فحق على الله أن يدخلك الجنة","cause":"ومَن قُتِلَ","result":"كانَ حَقًّا على اللهِ أن يُدخِلَه الجَنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-04358","ref":"الأحكام الوسطى 2/356","text":["سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: \"إنَّ الشَّيْطانَ قَعَدَ لابنِ آدَمَ بأَطْرُقِه، فقَعَدَ له بطَريقِ الإسْلامِ فقالَ: تُسلِمُ وتَذَرُ دينَك ودينَ آبائِك وآباءِ أبيك، فعَصاه فأَسلَمَ، ثُمَّ قَعَدَ له بطَريقِ الهِجْرةِ فقالَ: تُهاجِرُ وتَذَرُ أرْضَك وسَماءَك، وإنَّما مَثَلُ المُهاجِرِ كمَثَلِ الفَرَسِ في الطِّوَلِ، فعَصاه فهاجَرَ، ثُمَّ قَعَدَ له بطَريقِ الجِهادِ، فقالَ: تُجاهِدُ، فهو جَهْدُ النَّفْسِ والمالِ، فتَقاتِلُ فتُقتَلُ، فتُنكَحُ المَرْأةُ، ويُقسَمُ المالُ، فعَصاه فجاهَدَ\"، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: \"فمَن فَعَلَ ذلك كانَ حَقًّا على اللهِ أن يُدخِلَه الجَنَّةَ، ",["ومَن قُتِلَ",1]," ",["كانَ حَقًّا على اللهِ أن يُدخِلَه الجَنَّةَ",2],"، وإن غَرِقَ كانَ حَقًّا على اللهِ أن يُدخِلَه الجَنَّةَ، أو وَقَصَتْه دابَّتُه كانَ حَقًّا على اللهِ أن يُدخِلَه الجَنَّةَ."],"grade":"صحيح","narrator":"[سبرة] بن أبي فاكه","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه النسائي (3134)، والبغوي في ((معجم الصحابة)) (1188)، وإسماعيل الأصفهاني في ((الترغيب والترهيب)) (839) .","bab":"إيمان › أعمال الجن والشياطين","dorar":"bfmcbg8p"},{"id":"س-02523","fp":"b328077a4847","stateId":701,"easy":"إذا غرقت في سبيل الله ← فحق على الله أن يدخلك الجنة","cause":"وإن غَرِقَ","result":"كانَ حَقًّا على اللهِ أن يُدخِلَه الجَنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الأحكام الوسطى 2/356","srcLabel":"النسائي","text":["سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: \"إنَّ الشَّيْطانَ قَعَدَ لابنِ آدَمَ بأَطْرُقِه، فقَعَدَ له بطَريقِ الإسْلامِ فقالَ: تُسلِمُ وتَذَرُ دينَك ودينَ آبائِك وآباءِ أبيك، فعَصاه فأَسلَمَ، ثُمَّ قَعَدَ له بطَريقِ الهِجْرةِ فقالَ: تُهاجِرُ وتَذَرُ أرْضَك وسَماءَك، وإنَّما مَثَلُ المُهاجِرِ كمَثَلِ الفَرَسِ في الطِّوَلِ، فعَصاه فهاجَرَ، ثُمَّ قَعَدَ له بطَريقِ الجِهادِ، فقالَ: تُجاهِدُ، فهو جَهْدُ النَّفْسِ والمالِ، فتَقاتِلُ فتُقتَلُ، فتُنكَحُ المَرْأةُ، ويُقسَمُ المالُ، فعَصاه فجاهَدَ\"، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: \"فمَن فَعَلَ ذلك كانَ حَقًّا على اللهِ أن يُدخِلَه الجَنَّةَ، ومَن قُتِلَ كانَ حَقًّا على اللهِ أن يُدخِلَه الجَنَّةَ، ",["وإن غَرِقَ",1]," ",["كانَ حَقًّا على اللهِ أن يُدخِلَه الجَنَّةَ",2],"، أو وَقَصَتْه دابَّتُه كانَ حَقًّا على اللهِ أن يُدخِلَه الجَنَّةَ."],"grade":"صحيح","narrator":"[سبرة] بن أبي فاكه","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه النسائي (3134)، والبغوي في ((معجم الصحابة)) (1188)، وإسماعيل الأصفهاني في ((الترغيب والترهيب)) (839) .","bab":"إيمان › أعمال الجن والشياطين","dorar":"bfmcbg8p"},{"id":"س-04509","fp":"ee06b5f34f4e","stateId":701,"easy":"إذا قُتلت في سبيل الله ← تصير إلى نعيم لم يُرَ مثله","cause":"مَن قُتِلَ مِنَّا","result":"صارَ إلى الجَنَّةِ في نَعيمٍ لَم يَرَ مِثلَها قَطُّ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح البخاري 3159","srcLabel":"الحاكم","text":["بَعَثَ عُمَرُ النَّاسَ في أفناءِ الأمصارِ يُقاتِلونَ المُشرِكينَ، فأسلَمَ الهُرمُزانُ، فقال: إنِّي مُستَشيرُكَ في مَغازيَّ هذه، قال: نَعَم، مَثَلُها ومَثَلُ مَن فيها مِنَ النَّاسِ مِن عَدوِّ المُسلِمينَ مَثَلُ طائِرٍ له رَأسٌ، وله جَناحانِ، وله رِجلانِ، فإن كُسِرَ أحَدُ الجَناحَينِ نَهَضَتِ الرِّجلانِ بجَناحٍ والرَّأسُ، فإن كُسِرَ الجَناحُ الآخَرُ نَهَضَتِ الرِّجلانِ والرَّأسُ، وإن شُدِخَ الرَّأسُ ذَهَبَتِ الرِّجلانِ والجَناحانِ والرَّأسُ؛ فالرَّأسُ كِسرى، والجَناحُ قَيصَرُ، والجَناحُ الآخَرُ فارِسُ، فمُرِ المُسلِمينَ، فليَنفِروا إلى كِسرى. قال: فنَدَبَنا عُمَرُ، واستَعمَلَ علينا النُّعمانَ بنَ مُقَرِّنٍ، حتَّى إذا كُنَّا بأرضِ العَدوِّ، وخَرَجَ علينا عامِلُ كِسرى في أربَعينَ ألفًا، فقامَ تَرجُمانٌ، فقال: ليُكَلِّمْني رَجُلٌ مِنكُم. فقال المُغيرةُ: سَلْ عَمَّا شِئتَ، قال: ما أنتُم؟ قال: نَحنُ أُناسٌ مِنَ العَرَبِ كُنَّا في شَقاءٍ شَديدٍ وبَلاءٍ شَديدٍ، نَمَصُّ الجِلدَ والنَّوى مِنَ الجوعِ، ونَلبَسُ الوبَرَ والشَّعَرَ، ونَعبُدُ الشَّجَرَ والحَجَرَ، فبينا نَحنُ كَذلك إذ بَعَثَ رَبُّ السَّمَواتِ ورَبُّ الأرَضينَ -تَعالى ذِكرُه وجَلَّت عَظَمَتُه- إلينا نَبيًّا مِن أنفُسِنا نَعرِفُ أباه وأُمَّه، فأمَرَنا نَبيُّنا رَسولُ رَبِّنا صلَّى اللهُ عليه وسلَّم أن نُقاتِلَكم حتَّى تَعبُدوا اللهَ وحدَه، أو تُؤَدُّوا الجِزيةَ، وأخبَرَنا نَبيُّنا صلَّى اللهُ عليه وسلَّم عن رِسالةِ رَبِّنا: أنَّه ",["مَن قُتِلَ مِنَّا",1]," ",["صارَ إلى الجَنَّةِ في نَعيمٍ لَم يَرَ مِثلَها قَطُّ",2],"، ومَن بَقيَ مِنَّا مَلَكَ رِقابَكُم. فقال النُّعمانُ: رُبَّما أشهَدَكَ اللهُ مِثلَها مع النَّبيِّ صلَّى اللهُ عليه وسلَّم، فلَم يُنَدِّمْكَ، ولَم يُخزِكَ، ولَكِنِّي شَهِدتُ القِتالَ مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم؛ كان إذا لَم يُقاتِلْ في أوَّلِ النَّهارِ انتَظَرَ حتَّى تَهبَّ الأرواحُ، وتَحضُرَ الصَّلَواتُ."],"grade":"صحيح","narrator":"المغيرة بن شعبة والنعمان بن مقرن","muhaddith":"[صحيح]","takhrij":"أخرجه البيهقي (18697) واللفظ له، والطبراني (20/ 406) (970)، والحاكم (5900) بنحوه مختصرا.","bab":"جهاد › فضل الشهيد","dorar":"10uKCST6"},{"id":"س-04511","fp":"04ad896eebb2","stateId":701,"easy":"إذا استُشهدت ← تصل إلى الجنة فتأكل وتشرب","cause":"الشهيدَ","result":"يصلُ إلى الجنةِ ويعلقُ منها ويأكلُ ويشربُ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"عارضة الأحوذي 4/124","srcLabel":"عارضة الأحوذي","text":["حديثٌ [ أن ",["الشهيدَ",1]," ] ",["يصلُ إلى الجنةِ ويعلقُ منها ويأكلُ ويشربُ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"جهاد › فضل الشهيد","dorar":"cd5q7cZ8"},{"id":"س-08420","fp":"2b1e9f310e75","stateId":701,"easy":"إذا قاتلت وقُتلت وأوذيت في سبيل الله ← تكون من أول من يدخل الجنة","cause":"الذينَ قاتَلوا في سَبيلِ اللهِ، وقُتِلوا في سَبيلي، وأوذوا في سَبيلي، وجاهَدوا في سَبيلي","result":"ادخُلوا الجَنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-04358","otherNeedIds":[47],"ref":"مشارع الأشواق 173","text":["إنَّ أوَّلَ ثُلَّةٍ تَدخُلُ الجَنَّةَ الفُقَراءُ المُهاجِرونَ، الذينَ تُتَّقى بهمُ المَكارِهُ، إذا أُمِروا سَمِعوا وأطاعوا، وإن كانت لرَجُلٍ مِنهم حاجةٌ إلى السُّلطانِ لَم تُقضَ له حَتَّى يَموتَ وهيَ في صَدرِه، وإنَّ اللَّهَ تَعالى يَدعو يَومَ القيامةِ الجَنَّةَ، فتَأتي بزُخرُفِها ورِيِّها، فيَقولُ: «أينَ عِبادي ",["الذينَ قاتَلوا في سَبيلِ اللهِ، وقُتِلوا في سَبيلي، وأوذوا في سَبيلي، وجاهَدوا في سَبيلي",1],"؟ ",["ادخُلوا الجَنَّةَ",2],"» فيَدخُلونَها بغَيرِ حِسابٍ ولا عَذابٍ، فتَأتي المَلائِكةُ فيَقولونَ: رَبَّنا نَحنُ نُسَبِّحُ لَك اللَّيلَ والنَّهارَ، ونُقدِّسُ لَك مِن هَؤُلاءِ الذينَ آثَرتَهم علينا، فيَقولُ الرَّبُّ تَبارَكَ وتَعالى: «هَؤُلاءِ الذينَ قاتَلوا في سَبيلي، وأوذوا في سَبيلي، فتَدخُلُ عليهمُ المَلائِكةُ مِن كُلِّ بابٍ سَلامٌ عليكُم بما صَبَرتُم، فنِعمَ عُقبى الدَّارِ»"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","bab":"مناقب وفضائل › فضائل المهاجرين ومناقبهم","dorar":"Cx15DsrI"},{"id":"س-03190","fp":"998625eb18b7","stateId":701,"easy":"إذا قُتلت في سبيل الله ← تدخل الجنة","cause":"مَن قُتِلَ منَّا","result":"دخَلَ الجَنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-04358","ref":"تخريج سير أعلام النبلاء 16/ 362- 363","text":["قال المُغيرةُ بنُ شُعْبةَ لصاحبِ فارِسَ: كُنَّا نَعبُدُ الحِجارةَ والأَوْثانَ، إذا رَأَيْنا حَجرًا أحسَنَ من حَجرٍ ألْقَيْناه وأخَذْنا غَيرَه، لا نَعرِفُ ربًّا، حتى بعَثَ اللهُ إلينا نبيًّا من أنْفُسِنا، فدَعانا إلى الإسلامِ، فأجَبْناهُ، وأخْبَرَنا أنَّ ",["مَن قُتِلَ منَّا",1]," ",["دخَلَ الجَنَّةَ",2],"."],"grade":"حسن","narrator":"المغيرة بن شعبة","muhaddith":"رجاله ثقات","takhrij":"أخرجه ابن سعد في ((الطبقات)) (5/ 178)،  والذهبي في ((السير)) (16/ 362) جميعا بلفظه، وأبو نعيم في ((معرفة الصحابة)) (6227) بنحوه.","bab":"إيمان › دعوة الكافر إلى الإسلام","dorar":"SSI4TEZk"},{"id":"س-04405","fp":"cbb867134f38","stateId":701,"easy":"إذا قُتلت أو مت في سبيل الله ← فأنت في الجنة","cause":"مَن قُتِلَ أو ماتَ في سبيلِ اللهِ","result":"فهو في الجنَّةِ","explicit":true,"star":true,"ref":"تخريج المسند لشاكر 1/145","srcLabel":"الترمذي","text":["عن أبي العجفاء قال: سمعتُ عمرَ يقولُ: ألَا لا تَغْلُوا صُدُقَ النساءِ ألا لا تَغْلُوا صُدُقَ النساءِ فإنها لو كانَتْ مكرَّمَةً في الدنيا وتَقْوَى عندَ اللهِ كانَ أَوْلاكُم بِهَا النبيُّ صلَّى اللهُ عليه وسلَّم ما أصدَقَ رسولُ الله صلَّى اللهُ عليه وسلَّم امرأةٌ من نسائِهِ ولا أُصْدِقَتِ امرأةٌ من بناتِهِ أكثر من اثنَتِي عشْرَةَ أوقِيَّةً وإن الرجلَ ليُبْتَلَى بصدَقَةِ امرأتِهِ وقالَ مرةً وإنَّ الرجلَ ليُغْلِي بصدَقَةِ امرأتِهِ حتى تكونَ لها عَدَاوَةٌ في نفسِهِ وحتى يقولَ كَلَّفْتُ إليكَ عَلَقَ القِرْبَةَ قالَ وكنتُ غلامًا عربيًّا مولَّدًا لم أَدْرِ ما عَلَقُ القِرْبَةَ قال وأخرى تقولونُها لِمَنْ قُتِل في مغازِيكُم وماتَ قتل فلانٌ شهيدًا وماتَ فلانٌ شهيدًا ولعلَّه أن يكونَ قد أَوْقَرَ عَجُزَ دابَّتِه أو دُفَّ راحلَتِه ذَهَبًا أو وَرِقًا يلْتَمِسُ التجَارَةَ لا تقولُوا ذاكُم ولكنْ قُولوا كمَا قال النبيُّ أو كما قال محمدٌ صلَّى اللهُ عليه وسلَّم: ",["مَن قُتِلَ أو ماتَ في سبيلِ اللهِ ",1],["فهو في الجنَّةِ",2]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (1114)، والنسائي (3349)، وابن ماجه (1887)، وأحمد (285) واللفظ له","bab":"جهاد › النية في القتال والغزو","dorar":"xJ8otLaQ","merged":3,"otherRefs":["تخريج مشكل الآثار 5102 (حسن)","الأحاديث المختارة 292 (صحيح)"]},{"id":"س-04384","fp":"47396a437463","stateId":702,"easy":"إذا ألنت الكلام لوالدتك وأطعمتها ← تدخل الجنة ما اجتنبت الكبائر","cause":"لَئِن أنتَ ألَنتَ لها الكَلامَ، وأطعَمتَها الطَّعامَ","result":"لَتَدخُلَنَّ الجَنَّةَ ما اجتَنَبتَ المُوجِباتِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[39],"ref":"عمدة التفسير 1/491","srcLabel":"البخاري","text":["كُنتُ مع النَّجِداتِ، فأصَبتُ ذُنوبًا لا أُراها إلَّا مِنَ الكَبائِرِ، فلَقيتُ ابنَ عُمَرَ فقُلتُ له: إنِّي أصَبتُ ذُنوبًا لا أُراها إلَّا مِنَ الكَبائِرِ. قال: ما هي؟ قُلتُ: أصَبتُ كذا وكذا؟ قال: ليس مِنَ الكَبائِرِ. قُلتُ: وأصَبتُ كذا وكذا؟ قال: ليس مِنَ الكَبائِرِ. قال لِشَيءٍ لم يُسَمِّه طَيسَلةُ، قال: هي تِسعٌ، وسأعُدُّهُنَّ عليكَ: الإشراكُ باللهِ، وقَتلُ النَّفسِ بغَيرِ حِلِّها، والفِرارُ مِنَ الزَّحفِ، وقَذفُ المُحصَنةِ، وأكْلُ الرِّبا، وأكلُ مالِ اليَتيمِ ظُلمًا، وإلحادٌ في المَسجِدِ الحَرامِ، والذي يَستَسحِرُ، وبُكاءُ الوالِدَيْنِ مِنَ العُقوقِ. قال طَيسَلةُ: لَمَّا رأى ابنُ عُمَرَ فَرَقي قال: أتَخافُ النارَ أنْ تَدخُلَها؟ قُلتُ: نَعَمْ. قال: وتُحِبُّ أنْ تَدخُلَ الجَنَّةَ؟ قُلتُ: نَعَمْ. قال: أحَيٌّ والِداكَ؟ قُلتُ: عِندي أُمِّي. قال: فواللهِ ",["لَئِن أنتَ ألَنتَ لها الكَلامَ، وأطعَمتَها الطَّعامَ",1],"، ",["لَتَدخُلَنَّ الجَنَّةَ ما اجتَنَبتَ المُوجِباتِ",2],"."],"grade":"صحيح","narrator":"طيسلة بن مياس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أخرجه البخاري في ((الأدب المفرد)) (8) بلفظه، وإسماعيل بن إسحاق الجهضمي في ((أحكام القرآن)) (35)، والطبري في ((التفسير)) (6/ 646)، وابن حجر في ((موافقة الخبر)) (1/ 343) جميعهم بألفاظ مقاربة.","bab":"جهاد › التولي والفرار من الزحف","dorar":"WFTQ9lK5","merged":3,"otherRefs":["إتحاف الخيرة المهرة 5/475 (حسن)","صحيح الأدب المفرد 6 (صحيح)"]},{"id":"س-04303","fp":"c2bdea780ef8","stateId":702,"easy":"إذا أمسيت مرضياً لوالديك ← يصبح لك بابان مفتوحان إلى الجنة","cause":"مَن أَمْسى مُرْضِيًا لوالِدَيه","result":"أَصبَحَ له بابانِ مَفْتوحانِ إلى الجنَّةِ","explicit":true,"star":true,"apply":{"k":"time","t":"في المساء"},"otherNeedIds":[39],"ref":"الأحاديث المختارة 11 / 228","srcLabel":"متفق عليه","text":["«",["مَن أَمْسى مُرْضِيًا لوالِدَيه",1]," -أَحسَبُه- ",["أَصبَحَ له بابانِ مَفْتوحانِ إلى الجنَّةِ",2],"، ومَن أَصبَحَ ساخِطًا لوالِدَيه أَصبَحَ له بابانِ مَفْتوحانِ مِن النَّارِ، وإن واحِدٌ فواحِدٌ، فقالَ رَجُلٌ: يا رَسولَ اللهِ، وإن ظَلَماه؟ قالَ: وإن ظَلَماه، وإن ظَلَماه، ثَلاثَ مَرَّاتٍ»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"l8AJolNy"},{"id":"س-07227","fp":"5491f3eb7ca4","stateId":702,"easy":"إذا بررت والدك ← فهو أوسط أبواب الجنة","cause":"الوالِدُ","result":"أوسَطُ أبوابِ الجنَّةِ","explicit":true,"star":true,"otherNeedIds":[39],"ref":"تخريج شرح السنة 3421","srcLabel":"الترمذي","text":["كانَ رجُلٌ مِنَّا بَرًّا بوالدَيْهِ فأمَراهُ، أو أمَرهُ أحدُهُما، أنْ يتزوَّجَ فتزوَّج، فوقَعَ بَينَ أُمِّهِ وبَينَ امرأتِهِ شرٌّ، ووافَقَهُ أهلُهُ، فقالتْ لهُ أُمُّهُ: طلِّقْها، قالَ: فاشتدَّ عليهِ أنْ يُطلِّقَ امرأتَهُ، واشتدَّ عليهِ أنْ يَعُقَّ أُمَّهُ، قالَ: فرحَلَ إلى أبي الدَّرْداءِ، فقَصَّ عليهِ قِصَّتَهُ، فقالَ: ما كُنتُ آمُرُكَ أنْ تُطلِّقَ امرأتَكَ، ولا أنْ تَعُقَّ أُمَّكَ، ولكِنْ إنْ شِئتَ حدَّثْتُكَ حديثًا سمِعْتُهُ مِنَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ: ",["الوالِدُ",1]," ",["أوسَطُ أبوابِ الجنَّةِ",2],"؛ فحافِظْ إنْ شِئتَ، أو ضيِّعْ. قالَ: فأنا أُشهِدُكُمْ أنَّها طالقٌ، فرجَعَ وقدْ طلَّقَ امرأتَهُ."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (1900)، وابن ماجة (2089)، وأحمد (21726) بنحوه.","bab":"علم › حسن السؤال ونصح العالم","dorar":"HOG0pSq9","merged":8,"otherRefs":["سنن الترمذي 1900 (صحيح)","تخريج المسند لشعيب 27528 (حسن)","تخريج المسند لشعيب 27552 (حسن)","تخريج رياض الصالحين 334 (صحيح)","المستدرك على الصحيحين 2838 (صحيح)","المستدرك على الصحيحين 7458 (صحيح)","صحيح ابن ماجه 1712 (صحيح)"]},{"id":"س-07194","fp":"b287e9c69db5","stateId":702,"easy":"إذا لزمت أمك ← فالجنة عند رجليها","cause":"الْزَمْها","result":"فإنَّ الجنَّةَ عندَ رِجلَيْها","explicit":true,"ref":"المستدرك على الصحيحين 2537","srcLabel":"البيهقي","text":["أنَّ جاهِمةَ رَضيَ اللهُ عنه أَتى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فقالَ: إنِّي أَردْتُ أنْ أَغزوَ؛ فجئتُ أَستَشيرُكَ، قالَ: أَلَكَ والِدةٌ؟ قالَ: نَعَمْ، قالَ: اذهَبْ ف",["الْزَمْها",1],"؛ ",["فإنَّ الجنَّةَ عندَ رِجلَيْها",2],"."],"grade":"صحيح","narrator":"معاوية بن جاهمة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((الشعب)) (7448)، وابن أبي خيثمة في ((التاريخ الكبير)) (1/ 134)، وابن أبي عاصم في ((الآحاد والمثاني)) (1371) جميعهم بلفظه.","bab":"علم › حسن السؤال ونصح العالم","dorar":"6cQp4Jlw","merged":3,"otherRefs":["صحيح الجامع 1249 (حسن)","فتح الغفار 1746/4 (حسن)"]},{"id":"س-04275","fp":"090601c1201f","stateId":702,"easy":"إذا بررت أمك ← فالجنة تحت أقدام الأمهات","cause":"الأمَّهاتِ","result":"الجنَّةُ تحت أقدامِ","explicit":true,"similar":["س-04240"],"otherNeedIds":[39],"ref":"مختصر المقاصد 348","srcLabel":"الدولابي","text":[["الجنَّةُ تحت أقدامِ",2]," ",["الأمَّهاتِ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الدولابي في ((الكنى)) (1911 )، وأبو الشيخ الأصبهاني في ((طبقات المحدثين بأصبهان)) (3/ 568)، والقضاعي في ((مسند الشهاب)) (119 )، والخطيب في ((الجامع لأخلاق الراوي)) (1702 ).","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"HjmBFTX2"},{"id":"س-01923","fp":"afe67996c364","stateId":702,"easy":"إذا وصلت رحمك ← يحبك أهلك ويوسع في رزقك وينسأ في أثرك ويدخلك الجنة","cause":"مَنْ ضَمِنَ لي واحدةً أضمنُ له أربعًا يصلُ رحمَهُ يحبُّه أهلُه ويوسَّعُ له في رزقِهِ وَيُزَادُ في عُمرِهِ","result":"ويدخلُه اللهُ الجنَّةَ","explicit":true,"ref":"شرح البخاري لابن الملقن 28/272","srcLabel":"أحمد","text":[["مَنْ ضَمِنَ لي واحدةً أضمنُ له أربعًا يصلُ رحمَهُ يحبُّه أهلُه ويوسَّعُ له في رزقِهِ وَيُزَادُ في عُمرِهِ ",1],["ويدخلُه اللهُ الجنَّةَ",2]],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"حسن","takhrij":"أخرجه النسفي في ((أخبار سمرقند)) (277)، وأبو خالد الواسطي في ((مسند زيد بن علي)) (صـ406) واللفظ لهما.وأحمد (1213) بمعناه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"qEXL0mVn"},{"id":"س-02091","fp":"3dc4449e7537","stateId":702,"easy":"إذا لزمت والديك ← فإن الجنة تحت أرجلهما","cause":"الزمْهُما","result":"فإنَّ الجنَّةَ تحت أرجلِهِما","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المتجر الرابح 249","srcLabel":"الطبراني","text":["أتيتُ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ أستشيرُه في الجهادِ؟ فقال النبيُّ صلَّى اللهُ عليهِ وسلَّمَ ألكَ والدان؟ قلت: نعم قال: ",["الزمْهُما ",1],["فإنَّ الجنَّةَ تحت أرجلِهِما",2],"."],"grade":"صحيح","narrator":"جاهمة السلمي","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني (2/289) (2202)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"L6RGccBf"},{"id":"س-04216","fp":"e4abf083f835","stateId":702,"easy":"إذا أصبحت مطيعاً لله في والديك ← يكون لك بابان مفتوحان من الجنة","cause":"مَن أصبَحَ مُطيعًا للهِ في والِدَيهِ","result":"أصبح لهُ بابانِ مَفتوحانِ مِن الجنَّةِ","explicit":true,"apply":{"k":"time","t":"في الصباح"},"otherNeedIds":[39],"ref":"لسان الميزان 5/39","srcLabel":"البيهقي","text":[["مَن أصبَحَ مُطيعًا للهِ في والِدَيهِ",1]," : ",["أصبح لهُ بابانِ مَفتوحانِ مِن الجنَّةِ",2]," ، وإن كانَ واحدًا فواحدٌ ، ومن أمسَى عاصيًا للهِ في والدَيهِ : أصبَحَ لهُ بابانِ مفتوحانِ من النَّارِ ، وإن كانَ واحدًا فواحدٌ ، قال الرَّجلُ : وإن ظلَماهُ ؟ قال : وإن ظَلماهُ ، وإن ظَلماهُ ، وإن ظَلَماهُ"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"رجاله ثقات أثبات، غير عبد الله بن يحيى السرخسي، فهو آفته","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (7916)، وابن عساكر في ((تاريخ دمشق)) (33/365) باختلاف يسير.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"2XPIzW9C"},{"id":"س-04240","fp":"666f097c32fa","stateId":702,"easy":"إذا بررت أمك ← تدخل الجنة (من قصة حارثة)","cause":"كذاكُمُ البِرُّ","result":"دَخَلتُ الجَنَّةَ فسَمِعتُ فيها قِراءةً","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04275","otherNeedIds":[39],"ref":"تخريج المسند لشعيب 24080","text":[["دَخَلتُ الجَنَّةَ فسَمِعتُ فيها قِراءةً",2],"، قُلتُ: مَن هذا؟ قالوا: حارثةُ بنُ النُّعمانِ، ",["كذاكُمُ البِرُّ",1],"، كذاكُمُ البِرُّ، وقال مَرَّةً عن عائشةَ: إنْ شاءَ اللهُ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (24080) واللفظ له، وأبو يعلى (4425)، وابن حبان (7014)","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"N1Qi6FbD"},{"id":"س-07188","fp":"e232b7e5bd2b","stateId":702,"easy":"إذا كانت لك أم فالزمها ← فإن الجنة عند رجلها","cause":"هل لكَ من أُمٍّ؟، قال: نَعَمْ، قال: فالْزَمْها","result":"فإنَّ الجَنَّةَ عندَ رِجْلِها","explicit":true,"otherNeedIds":[39],"ref":"تخريج مشكل الآثار 2132","srcLabel":"النسائي","text":["إنَّ جاهِمةَ جاء إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقال: يا رسولَ اللهِ، أَرَدتُ أنْ أغزُوَ، وقد جِئتُكَ أستَشيرُكَ، فقال: ",["هل لكَ من أُمٍّ؟، قال: نَعَمْ، قال: فالْزَمْها",1],"، ",["فإنَّ الجَنَّةَ عندَ رِجْلِها",2],"."],"grade":"حسن","narrator":"معاوية بن جاهمة السلمي","muhaddith":"إسناده حسن","takhrij":"أخرجه النسائي (3104)، وابن ماجه بعد حديث (2781)، وأحمد (15538) باختلاف يسير","bab":"علم › حسن السؤال ونصح العالم","dorar":"wG2LHzL6"},{"id":"س-04184","fp":"aa634140bbd7","stateId":703,"easy":"إذا كان لك ثلاث بنات تؤويهن وترحمهن وتكفلهن ← وجبت لك الجنة ألبتة","cause":"مَنْ كُنَّ لهُ ثلاثُ بناتٍ يُؤْوِيهِنَّ ويَرْحَمُهُنَّ ويَكْفُلُهُنَّ","result":"وجَبَتْ لهُ الجنةُ البَتَّةَ قيل : يا رسولَ اللهِ","explicit":true,"star":true,"similar":["س-02900"],"ref":"صحيح الترغيب 1975","srcLabel":"البخاري","text":[["مَنْ كُنَّ لهُ ثلاثُ بناتٍ يُؤْوِيهِنَّ ويَرْحَمُهُنَّ ويَكْفُلُهُنَّ ؛ ",1],["وجَبَتْ لهُ الجنةُ البَتَّةَ قيل : يا رسولَ اللهِ ",2],"! فإن كَانَتَا اثْنَتَيْنِ ؟ قال : وإنْ كَانَتا اثْنَتَيْنِ قال : فَرأى القومَ أن لَوْ قال : واحدةً ، لقال : واحدةً ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح لغيره","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (78)، وابن أبي الدنيا في ((النفقة على العيال)) (84)، والطبراني في ((المعجم الأوسط)) (4760) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"W8gm0mXO","merged":2,"otherRefs":["السلسلة الصحيحة 1027 (صحيح)"]},{"id":"س-01905","fp":"d4cc525fe1cc","stateId":703,"easy":"إذا علت جاريتين حتى تبلغا ← تدخل الجنة مع النبي ﷺ كهاتين","cause":"من عال جاريَتينِ حتى تُدركا","result":"دخلتُ الجنَّةَ أنا وهو كهاتينِ","explicit":true,"star":true,"otherNeedIds":[68],"ref":"السلسلة الصحيحة 3/113","srcLabel":"مسلم","text":[["من عال جاريَتينِ حتى تُدركا",1]," ",["دخلتُ الجنَّةَ أنا وهو كهاتينِ",2]," وأشار بإصبعَيه السَّبَّابةِ والوُسطى وبابانِ مُعجَّلانِ . . ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح الإسناد على شرط مسلم","takhrij":"أخرجه مسلم (2631)، والترمذي (1914) بنحوه مختصراً، وأحمد (12498) بنحوه مطولاً، والحاكم (7350) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"2idF4JDF","merged":3,"otherRefs":["صحيح الأدب المفرد 686 (صحيح)","صحيح الجامع 6391 (صحيح)"]},{"id":"س-02900","fp":"94d523a400e7","stateId":703,"easy":"إذا علت ثلاث بنات تكفيهن وترحمهن وترفق بهن ← فأنت في الجنة","cause":"مَنْ عالَ ثَلاثًا من بناتٍ يَكْفيهِنَّ ، و يَرْحَمُهُنَّ ، و يَرْفُقُ بِهنَّ","result":"فهوَ في الجنةِ","explicit":true,"repOf":"س-04184","ref":"السلسلة الصحيحة 2492","text":[["مَنْ عالَ ثَلاثًا من بناتٍ يَكْفيهِنَّ ، و يَرْحَمُهُنَّ ، و يَرْفُقُ بِهنَّ ",1],["فهوَ في الجنةِ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرجه أحمد (14247)، والبخاري في ((الأدب المفرد)) (78) مطولا باختلاف يسير، وابن أبي شيبة (25943) واللفظ له بزيادة في آخره","bab":"إيمان › الوعد","dorar":"hwX29wrL"},{"id":"س-02860","fp":"7ba4d488e595","stateId":703,"easy":"إذا علت ابنتين أو ثلاثاً أو أختين أو ثلاثاً ← تكون مع النبي ﷺ كهاتين","cause":"من عالَ ابنتيْنِ ، أو ثلاثَ بناتٍ ، أو أختيْنِ أو ثلاثَ أخواتٍ","result":"كنتُ أناو هوَ كهاتيْنِ","explicit":true,"star":true,"similar":["س-02863"],"otherNeedIds":[68],"ref":"السلسلة الصحيحة 296","srcLabel":"مسلم","text":[["من عالَ ابنتيْنِ ، أو ثلاثَ بناتٍ ، أو أختيْنِ أو ثلاثَ أخواتٍ",1]," ، حتى يَمُتْنَ و في روايةٍ : يَبِنَّ ، وفي أخرى يبلُغْنَ ) أو يموتُ عنهن ",["كنتُ أناو هوَ كهاتيْنِ",2]," ، وأشار بإصبعيْهِ السبابةَ و الوسطى"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (12498) باختلاف يسير، وأخرجه مسلم (2631) بنحوه مختصراً","bab":"إيمان › الوعد","dorar":"aNsap6b6"},{"id":"س-02863","fp":"455059a4f6f7","stateId":703,"easy":"إذا علت بنتين أو ثلاثاً أو أختين حتى يبنّ أو تموت عنهن ← تكون مع النبي ﷺ في الجنة","cause":"مَن عالَ ابنتينِ أو ثلاثًا ، أو أختينِ أو ثلاثًا حتَّى يَبِنَّ ، أو يَموتَ عنهنَّ","result":"كنتُ أنا وهوَ في الجنَّةِ كَهاتينِ","explicit":true,"repOf":"س-02860","otherNeedIds":[68],"ref":"صحيح الترغيب 1970","text":[["مَن عالَ ابنتينِ أو ثلاثًا ، أو أختينِ أو ثلاثًا حتَّى يَبِنَّ ، أو يَموتَ عنهنَّ ؛ ",1],["كنتُ أنا وهوَ في الجنَّةِ كَهاتينِ ",2],". وأشار بأُصْبُعيهِ السبَّابةَ والتي تلِيهَا"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان كما في ((موارد الظمآن)) للهيثمي (2045) واللفظ له، وأخرجه مسلم (2631) بنحوه مختصراً","bab":"إيمان › الوعد","dorar":"qbHCExBq"},{"id":"س-02715","fp":"b901c212814f","stateId":703,"easy":"إذا آثرت أولادك على نفسك ← يوجب الله لك بها الجنة","cause":"فأعطَت كُلَّ واحِدةٍ منهما تَمرةً","result":"أوجَبَ لَها بها الجَنَّةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[38],"ref":"صحيح مسلم 2630","srcLabel":"متفق عليه","text":["جاءَتني مِسكينةٌ تَحمِلُ ابنَتَينِ لَها، فأطعَمتُها ثَلاثَ تَمَراتٍ، ",["فأعطَت كُلَّ واحِدةٍ منهما تَمرةً",1],"، ورَفَعَت إلى فيها تَمرةً لتَأكُلَها، فاستَطعَمَتها ابنَتاها، فشَقَّتِ التَّمرةَ التي كانَت تُريدُ أن تَأكُلَها بينَهما، فأعجَبَني شَأنُها، فذَكَرتُ الذي صَنَعَت لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: إنَّ اللهَ قد ",["أوجَبَ لَها بها الجَنَّةَ",2],"، أو أعتَقَها بها مِنَ النَّارِ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"إيمان › القطع بدخول أحد الجنة أو النار","dorar":"1pmyYUIs","merged":2,"otherRefs":["صحيح ابن ماجه 2973 (صحيح)"]},{"id":"س-01967","fp":"3d8d8441724d","stateId":703,"easy":"إذا علت ثلاث بنات فأدبتهن ورحمتهن وأحسنت إليهن ← فلك الجنة","cause":"مَن عالَ ثلاثَ بَناتٍ فأدَّبَهُنَّ","result":"ورَحِمَهُنَّ، وأحسَنَ إليهِنَّ، فله الجَنَّةُ","explicit":true,"similar":["س-04204","س-04279","س-01927"],"otherNeedIds":[24],"ref":"تخريج المسند لشعيب 11924","srcLabel":"أبو داود","text":[["مَن عالَ ثلاثَ بَناتٍ فأدَّبَهُنَّ، ",1],["ورَحِمَهُنَّ، وأحسَنَ إليهِنَّ، فله الجَنَّةُ",2],"، قال عبدُ اللهِ: قال أَبي رَحِمَه اللهُ: ماتَ خالدُ بنُ عبدِ اللهِ يَعْني الطَّحَّانَ، ومالكُ بنُ أنَسٍ، وأبو الأحْوَصِ، وحمَّادُ بنُ زَيْدٍ في سَنَةِ تِسعٍ وسَبعين، إلَّا أنَّ مالِكًا ماتَ قبْلَ حمَّادِ بنِ زَيْدٍ بقَليلٍ، قال أَبي: وفي تلك السَّنَةِ طَلَبتُ الحَديثَ كُنَّا على بابِ هُشَيمٍ وهو يُملي علينا، إمَّا قال: الجَنائِزَ أوِ المَناسِكَ، فجاءَ رَجُلٌ بَصْريٌّ، فقال: ماتَ حمَّادُ بنُ زَيْدٍ! رَحْمةُ اللهِ عليهم أجْمعينَ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (5147) باختلاف يسير، والترمذي (1912) بنحوه، وأحمد (11924) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"rL3yPWvK","merged":2,"otherRefs":["تخريج سنن أبي داود 5148 (صحيح)"]},{"id":"س-03851","fp":"78f4d269b45c","stateId":703,"easy":"إذا أدركت ابنتين فأحسنت إليهما ما صحبتاك ← تدخلانك الجنة","cause":"ما مِن مُسلِمٍ يُدرِكُ ابْنتَينِ فيُحْسِنُ إليهِما ما صَحِبَتاهُ أو صَحِبَهما","result":"إلَّا أدْخَلَتاهُ الجنَّةَ","explicit":true,"similar":["س-04262"],"ref":"المستدرك على الصحيحين 7555","srcLabel":"ابن ماجه","text":["عنْ فِطْرِ بنِ خَليفةَ، قالَ: كُنتُ جالسًا عندَ زَيدِ بنِ عليٍّ رَضيَ اللهُ عنه بالمدينةِ، فمَرَّ عليه شَيخٌ يُقالُ لهُ: شُرَحْبِيلُ أبو سَعْدٍ، فقال له زَيدٌ: مِن أينَ جِئتَ يا أبا سَعْدٍ؟ قالَ: مِن عندِ أميرِ المدينةِ، حدَّثْتُه بحَديثٍ، قالَ: فحَدِّثْ به القومَ، قالَ: سَمِعْتُ ابنَ عبَّاسٍ رَضيَ اللهُ عنهُما يقولُ: قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["ما مِن مُسلِمٍ يُدرِكُ ابْنتَينِ فيُحْسِنُ إليهِما ما صَحِبَتاهُ أو صَحِبَهما؛",1]," ",["إلَّا أدْخَلَتاهُ الجنَّةَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (3424)، والبيهقي في ((شعب الإيمان)) (10512) باختلاف يسير، وابن ماجه (3670) مختصرا","bab":"بر وصلة › ملاطفة اليتيم والبنات وسائر الضعفة","dorar":"SsWVhwnG","merged":2,"otherRefs":["الأحاديث المختارة 10 / 424 (صحيح)"]},{"id":"س-08304","fp":"f46efe61d00c","stateId":703,"easy":"إذا كان لك ثلاث بنات فصبرت على لأوائهن وسرائهن ← يدخلك الله الجنة برحمته إياهن","cause":"مَن كُنَّ له ثَلاثُ بناتٍ فصَبَرَ على لَأْوائهِنَّ وسَرَّائهِنَّ","result":"أدخَلَهُ اللهُ الجنَّةَ برَحمتِه إيَّاهنَّ","explicit":true,"ref":"المستدرك على الصحيحين 7550","srcLabel":"أحمد","text":[["مَن كُنَّ له ثَلاثُ بناتٍ فصَبَرَ على لَأْوائهِنَّ وسَرَّائهِنَّ، ",1],["أدخَلَهُ اللهُ الجنَّةَ برَحمتِه إيَّاهنَّ",2],"، قالَ: فقال رجُلٌ: وابنتانِ يا رسولَ اللهِ؟ قالَ: ابنتَانِ، قال رَجلٌ: يا رسولَ اللهِ، وواحدةٌ؟ قالَ: وواحدةٌ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (8425)، والطبراني في ((الأوسط)) (6199)، والخرائطي في ((مكارم الأخلاق)) (650) باختلاف يسير.","bab":"مناقب وفضائل › بعض من شهد النبي بأنهم من أهل الجنة","dorar":"AumEtzbw","merged":2,"otherRefs":["تخريج المسند لشاكر 16/181 (صحيح)"]},{"id":"س-00305","fp":"3b771e4257f6","stateId":703,"easy":"إذا وُلدت لك أنثى فلم تئدها ولم تهنها ولم تؤثر الذكر عليها ← يدخلك الله بها الجنة","cause":"مَن وُلِدَتْ له أُنثى، فلَمْ يَئِدْها، ولم يُهِنْها، ولم يُؤثِرْ وَلدَهُ -يَعني الذَّكَرَ- عليها","result":"أدخَلَهُ اللهُ بها الجَنَّةَ","explicit":true,"ref":"المستدرك على الصحيحين 7552","srcLabel":"أحمد","text":[["مَن وُلِدَتْ له أُنثى، فلَمْ يَئِدْها، ولم يُهِنْها، ولم يُؤثِرْ وَلدَهُ -يَعني الذَّكَرَ- عليها",1],"؛ ",["أدخَلَهُ اللهُ بها الجَنَّةَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (1957) واللفظ له، والبيهقي ((الآداب)) (24)، ابن أبي الدنيا في ((النفقة على العيال)) (88) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"cJVN5l4Y"},{"id":"س-04177","fp":"a6e2974caa24","stateId":703,"easy":"إذا كانت لك أختان فأحسنت صحبتهما ← تدخل بهما الجنة","cause":"من كانت لهُ أختانِ فأَحْسَنَ صحبتهما ما صحبتَاهُ دخل بهما الجنةَ وقال محمدُ بنُ عبيدٍ : تُدْرَكُ لهُ ابنتانِ فأَحْسَنَ إليهما ما صحبتَاهُ","result":"إلا أدخلَهُ اللهُ تعالى الجنةَ","explicit":true,"ref":"تخريج المسند لشاكر 3/353","srcLabel":"ابن ماجه","text":[["من كانت لهُ أختانِ فأَحْسَنَ صحبتهما ما صحبتَاهُ دخل بهما الجنةَ وقال محمدُ بنُ عبيدٍ : تُدْرَكُ لهُ ابنتانِ فأَحْسَنَ إليهما ما صحبتَاهُ ",1],["إلا أدخلَهُ اللهُ تعالى الجنةَ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (3670)، وابن حبان (2945)، والحاكم (7351) مختصراً باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"imeDnWWG"},{"id":"س-04204","fp":"8cbd9a46dab1","stateId":703,"easy":"إذا كان لك ثلاث بنات أو أخوات أو اثنتان فاتقيت الله فيهن ← تدخل الجنة","cause":"لا يكونِ لأحَدٍ ثلاثُ بناتٍ، أو ثلاثُ أخواتٍ، أو ابْنَتانِ، أو أُختانِ، فيتَّقي اللهَ فيهِنَّ، ويُحسِنُ إليهِنَّ","result":"إلَّا دخَل الجَنَّةَ","explicit":true,"repOf":"س-01967","otherNeedIds":[38],"ref":"تخريج المسند لشعيب 11384","text":["\"",["لا يكونِ لأحَدٍ ثلاثُ بناتٍ، أو ثلاثُ أخواتٍ، أو ابْنَتانِ، أو أُختانِ، فيتَّقي اللهَ فيهِنَّ، ويُحسِنُ إليهِنَّ",1]," ",["إلَّا دخَل الجَنَّةَ",2],"\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (5148)، والترمذي (1912)، وأحمد (11384) واللفظ له","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"WofCo7w3"},{"id":"س-04271","fp":"4ee083596b30","stateId":703,"easy":"إذا كان لك أختان أو ابنتان فأحسنت إليهما ← تكون مع النبي ﷺ في الجنة كهاتين","cause":"من كان له أُختانِ أو ابنتانِ ، فأحسنَ إليهما ما صحبتاهُ","result":"كنتُ أنا وهو في الجنةِ كهاتينِ ، وقرنَ بين أُصبعيهِ","explicit":true,"otherNeedIds":[68],"ref":"السلسلة الصحيحة 1026","srcLabel":"أحمد","text":[["من كان له أُختانِ أو ابنتانِ ، فأحسنَ إليهما ما صحبتاهُ ، ",1],["كنتُ أنا وهو في الجنةِ كهاتينِ ، وقرنَ بين أُصبعيهِ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرجه أحمد (12593) بنحوه، وابن أبي شيبة (25945) باختلاف يسير، والخطيب في ((تاريخ بغداد)) (8/284) واللفظ له","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"fUHLSVPY"},{"id":"س-04279","fp":"a81e606c4158","stateId":703,"easy":"إذا كان لك ثلاث بنات أو أخوات أو اثنتان فأحسنت إليهن ← فلك الجنة","cause":"مَنْ كان لهُ ثلاثُ بناتٍ أوْ ثلاثُ أَخَوَاتٍ ، أوْ بنَتَانِ ، أوْ أُخْتَانِ ، فَأحسنَ صُحْبَتَهُنَّ واتَّقَى اللهَ فيهِنَّ","result":"فَلهُ الجنةُ","explicit":true,"repOf":"س-01967","ref":"صحيح الترغيب 1973","text":[["مَنْ كان لهُ ثلاثُ بناتٍ أوْ ثلاثُ أَخَوَاتٍ ، أوْ بنَتَانِ ، أوْ أُخْتَانِ ، فَأحسنَ صُحْبَتَهُنَّ واتَّقَى اللهَ فيهِنَّ ؛ ",1],["فَلهُ الجنةُ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (5148)، وأحمد (11384) بنحوه، والترمذي (1916) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"dsvruFra"},{"id":"س-01927","fp":"c86055dc4051","stateId":703,"easy":"إذا علت ثلاث بنات فأدبتهن وزوجتهن وأحسنت إليهن ← فلك الجنة","cause":"مَن عال ثلاثَ بناتٍ ، فأدَّبَهنَّ و زوَّجَهنَّ ، و أحسَن إليهنَّ","result":"فلَه الجنَّةُ","explicit":true,"repOf":"س-01967","ref":"الجامع الصغير 8828","text":[["مَن عال ثلاثَ بناتٍ ، فأدَّبَهنَّ و زوَّجَهنَّ ، و أحسَن إليهنَّ ، ",1],["فلَه الجنَّةُ",2]],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"حسن","takhrij":"أخرجه أبو داود (5147) واللفظ له، والترمذي (1912) مختصراً باختلاف يسير، وأحمد (11924) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"MKTGVx8U"},{"id":"س-04262","fp":"77fbcfa5fca8","stateId":703,"easy":"إذا أدركتك بنتان فأحسنت صحبتهما ← تدخلانك الجنة","cause":"ما مِن مُسلمٍ تُدْرِكُه بنتانِ ، فيُحْسِنُ صحبَتَهُمَا","result":"إلَّا أدخلَتاه الجنَّةَ","explicit":true,"repOf":"س-03851","ref":"صحيح الأدب المفرد 57","text":[["ما مِن مُسلمٍ تُدْرِكُه بنتانِ ، فيُحْسِنُ صحبَتَهُمَا ،",1]," ",["إلَّا أدخلَتاه الجنَّةَ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن لغيره","takhrij":"أخرجه ابن ماجه (3670)، وأحمد (3424) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"z4DXiTDJ"},{"id":"س-06812","fp":"753613fb1838","stateId":704,"easy":"إذا ضممت يتيماً من بين أبوين مسلمين إلى طعامك وشرابك حتى يستغني ← وجبت لك الجنة","cause":"ومَن ضَمَّ يَتيمًا مِن بَينِ أبَوينِ مُسلِمَينِ»، قال: عَفَّانُ: «إلى طَعامِه وشَرابِه حَتَّى يُغنيَه اللهُ","result":"وجَبَت له الجَنَّةُ","explicit":true,"similar":["س-01944"],"ref":"تخريج المسند لشعيب 19030","srcLabel":"أحمد","text":["«مَن أعتَقَ رَقَبةً مُسلِمةً فهيَ فِداؤُه مِنَ النَّارِ» قال: عَفَّانُ: «مَكانَ كُلِّ عَظمٍ مِن عِظامِ مُحَرَّرِه بعَظمٍ مِن عِظامِه، ومَن أدرَكَ أحَدَ والِدَيه، ثُمَّ لم يُغفَرْ له، فأبعَدَه اللهُ، ",["ومَن ضَمَّ يَتيمًا مِن بَينِ أبَوينِ مُسلِمَينِ»، قال: عَفَّانُ: «إلى طَعامِه وشَرابِه حَتَّى يُغنيَه اللهُ، ",1],["وجَبَت له الجَنَّةُ»",2]],"grade":"صحيح","narrator":"مالك بن عمرو القشيري","muhaddith":"صحيح لغيره","bab":"عتق وولاء › فضل العتق","dorar":"Ay0Owhv1","merged":4,"otherRefs":["صحيح الترغيب 2543 (صحيح)","تخريج المسند لشعيب 20330 (صحيح)","تخريج المسند لشعيب 19025 (صحيح)"]},{"id":"س-01876","fp":"baa1b5ae3f67","stateId":704,"easy":"إذا ضممت يتيماً إلى طعامك وشرابك ← يدخلك الله الجنة ألبتة إلا أن تعمل ذنباً لا يُغفر","cause":"من قبَض يتيمًا من بين مسلمَيْن إلى طعامِه وشرابِه","result":"أدخله اللهُ الجنَّةَ ألبتَّةَ إلَّا أن يعملَ ذنبًا لا يُغفرُ","explicit":true,"otherNeedIds":[11],"ref":"الترغيب والترهيب 3/313","srcLabel":"الترمذي","text":[["من قبَض يتيمًا من بين مسلمَيْن إلى طعامِه وشرابِه ",1],["أدخله اللهُ الجنَّةَ ألبتَّةَ إلَّا أن يعملَ ذنبًا لا يُغفرُ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (1917) واللفظ له، والحارث في ((المسند)) (903) باختلاف يسير، وأبو يعلى (2457) مطولاً","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"D1WLaPXs"},{"id":"س-02844","fp":"61163d7e5df6","stateId":704,"easy":"إذا أحسنت إلى يتيمة أو يتيم عندك ← تكون مع النبي ﷺ في الجنة كهاتين","cause":"ومَن أحسَنَ إلى يَتيمةٍ أو يَتيمٍ عندَه","result":"كنتُ أنا وهو في الجنَّةِ كهاتَينِ، وقَرَنَ بيْنَ إصبَعَيه: السَّبَّابةِ والوُسطى","explicit":true,"otherNeedIds":[68],"ref":"تخريج المسند لشعيب 22153","srcLabel":"أحمد","text":["أنَّ رسولَ اللهِ صَلَّى اللهُ عليه وسلَّمَ قال: مَن مَسَحَ رَأسَ يَتيمٍ لم يَمسَحْه إلَّا للهِ، كان له بكلِّ شَعرةٍ مَرَّتْ عليها يدُه حَسناتٌ، ",["ومَن أحسَنَ إلى يَتيمةٍ أو يَتيمٍ عندَه، ",1],["كنتُ أنا وهو في الجنَّةِ كهاتَينِ، وقَرَنَ بيْنَ إصبَعَيه: السَّبَّابةِ والوُسطى",2],"."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح لغيره دون الشطر الأول منه بقصة المسح على رأس اليتيم","takhrij":"أخرجه أحمد (22153) واللفظ له، والطبراني (8/239) (7821)، وأبو نعيم في ((حلية الأولياء)) (8/179)","bab":"إيمان › الوعد","dorar":"awBDh4rc"},{"id":"س-04310","fp":"497e14762d6c","stateId":704,"easy":"إذا ضممت يتيماً من بين أبويه ← فلك الجنة ألبتة","cause":"مَن ضَمَّ يَتيمًا بَينَ أبَويه","result":"فلَه الجَنَّةُ البَتَّةَ","explicit":true,"ref":"تخريج المسند لشعيب 19026","srcLabel":"أحمد","text":["«",["مَن ضَمَّ يَتيمًا بَينَ أبَويه ",1],["فلَه الجَنَّةُ البَتَّةَ»",2]],"grade":"صحيح","narrator":"عمرو بن مالك أو مالك بن عمرو","muhaddith":"صحيح","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"z63jBsKp"},{"id":"س-01882","fp":"942c259533c5","stateId":704,"easy":"إذا كفلت يتيماً لك أو لغيرك ← تكون مع النبي ﷺ في الجنة كهاتين","cause":"مَن كفَل يتيمًا له أو لغيرِه من النَّاسِ","result":"كُنْتُ أنا وهو في الجنَّةِ كهاتينِ","explicit":true,"otherNeedIds":[68],"ref":"مجمع الزوائد 8/166","srcLabel":"الطبراني","text":[["مَن كفَل يتيمًا له أو لغيرِه من النَّاسِ ",1],["كُنْتُ أنا وهو في الجنَّةِ كهاتينِ",2]],"grade":"حسن","narrator":"أم سعد بنت عمرو الجمحية","muhaddith":"رجاله ثقات","takhrij":"أخرجه ابن الأعرابي في ((المعجم)) (1414)، والطبراني (25/98) (255) واللفظ له، وأبو نعيم في ((معرفة الصحابة)) (7955)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"k0By92S6"},{"id":"س-01944","fp":"6ab64e5fcd37","stateId":704,"easy":"إذا ضممت يتيماً حتى يغنيه الله ← وجبت لك الجنة","cause":"مَن ضمَّ يتيمًا لَهُ أو لِغيرِهِ حتَّى يغنيَهُ اللَّهُ عنهُ","result":"وَجبت لَه الجنَّةُ","explicit":true,"repOf":"س-06812","ref":"الجامع الصغير 8812","text":[["مَن ضمَّ يتيمًا لَهُ أو لِغيرِهِ حتَّى يغنيَهُ اللَّهُ عنهُ ",1],["وَجبت لَه الجنَّةُ",2]],"grade":"حسن","narrator":"عدي بن حاتم الطائي","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((الأوسط)) (5345)، وابن الفاخر في ((موجبات الجنة)) (230) واللفظ لهما.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"OMIRIzew"},{"id":"س-02626","fp":"c668a026c0ef","stateId":704,"easy":"إذا آويت يتيماً أو يتيمين ثم صبرت واحتسبت ← تكون مع النبي ﷺ في الجنة كهاتين","cause":"منْ آوى يتيمًا أو يتيمينَ، ثمَّ صبرَ و احتسبَ","result":"كنتُ أنَا و هوَ في الجنةِ كهاتينِ","explicit":true,"otherNeedIds":[68],"ref":"الجامع الصغير 8254","srcLabel":"الطبراني","text":[["منْ آوى يتيمًا أو يتيمينَ،  ثمَّ صبرَ و احتسبَ،  ",1],["كنتُ أنَا و هوَ في الجنةِ كهاتينِ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (8477) بزيادة في آخره","bab":"إيمان › الاحتساب والنية","dorar":"ni7R4GXM"},{"id":"س-06499","fp":"3a639bbf883f","stateId":705,"easy":"إذا صلت المرأة خمسها وصامت شهرها وأحصنت فرجها وأطاعت بعلها ← فلتدخل من أي أبواب الجنة شاءت","cause":"المرأةُ إذا صَلَّتْ خَمسَها ، وصامتْ شَهرَها ، وأَحصنتْ فَرجَها ، وأطاعت بَعلَها","result":"فَلْتَدْخُلِ مِنْ أَيِّ أبوابِ الجنةِ شاءتْ","explicit":true,"similar":["س-06608"],"otherNeedIds":[37],"ref":"هداية الرواة 3190","srcLabel":"من","text":["قال رسولُ اللهِ - صلَّى اللهُ عليهِ وسلَّم - : ",["المرأةُ إذا صَلَّتْ خَمسَها ، وصامتْ شَهرَها ، وأَحصنتْ فَرجَها ، وأطاعت بَعلَها",1]," ؛ ",["فَلْتَدْخُلِ مِنْ أَيِّ أبوابِ الجنةِ شاءتْ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"حسن لغيره أو صحيح لغيره","takhrij":"أخرجه من طرق البزار (7480)، وابن عدي في ((الكامل في الضعفاء)) (3/176)، وأبو نعيم في ((حلية الأولياء)) (6/308) واللفظ له","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"wgLIAi5p","merged":2,"otherRefs":["البدور السافرة 396 (حسن)"]},{"id":"س-06608","fp":"034502311edc","stateId":705,"easy":"إذا صلت المرأة خمسها وصامت شهرها وحصنت فرجها وأطاعت زوجها ← يقال لها: ادخلي من أي أبواب الجنة شئت","cause":"إذا صلَّتِ المرأةُ خَمْسَها ، و صامَت شهرَها ، و حصَّنَتْ فرجَها ، وأطاعَت زوجَها","result":"قيلَ لها : ادخُلي الجنَّةَ مِن أيِّ أبوابِ الجنَّةِ شِئتِ","explicit":true,"repOf":"س-06499","ref":"صحيح الجامع 660","text":[["إذا صلَّتِ المرأةُ خَمْسَها ، و صامَت شهرَها ، و حصَّنَتْ فرجَها ، وأطاعَت زوجَها ، ",1],["قيلَ لها : ادخُلي الجنَّةَ مِن أيِّ أبوابِ الجنَّةِ شِئتِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (4163)، والطبراني في ((المعجم الأوسط)) (4715).","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"XaFBvMXA"},{"id":"س-04549","fp":"37335ad90c26","stateId":705,"easy":"إذا كانت المرأة ودوداً ولوداً تقول لزوجها إذا غضب «يدي في يدك...» ← فهي من نساء أهل الجنة","cause":"الوَلودُ الوَدودُ الَّتي إذا غَضِبَتْ أو غَضِبَ قالَتْ: يَدي في يَدِك لا أَكتَحِلُ بغَمْضٍ","result":"بنِسائِكم مِن أهْلِ الجنَّةِ","explicit":true,"star":true,"apply":{"k":"say","t":"«يَدي في يَدِك لا أَكتَحِلُ بغَمْض»"},"otherNeedIds":[37],"ref":"الأحاديث المختارة 10 / 403","srcLabel":"متفق عليه","text":["«أَلَا أُنَبِّئُكم برِجالِكم مِن أهْلِ الدُّنْيا في الجنَّةِ؟ قالوا: بَلى يا رَسولَ اللهِ، قالَ: النَّبيُّ صلَّى اللهُ عليه وسلَّمَ في الجنَّةِ، والصِّدِّيقُ في الجنَّةِ، والشَّهيدُ في الجنَّةِ، والمَوْلودُ مَوْلودُ الإسْلامِ في الجنَّةِ، والرَّجُلُ يكونُ في جانِبِ المِصْرِ يَزورُ أخاه لا يَزورُه إلَّا للهِ في الجنَّةِ، أَلَا أُنَبِّئُكم ",["بنِسائِكم مِن أهْلِ الجنَّةِ",2],"؟ قالوا: بَلى يا رَسولَ اللهِ، قالَ: ",["الوَلودُ الوَدودُ الَّتي إذا غَضِبَتْ أو غَضِبَ قالَتْ: يَدي في يَدِك لا أَكتَحِلُ بغَمْضٍ",1],"»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"جهاد › فضل الشهيد","dorar":"2YJKpcYW","merged":4,"otherRefs":["صحيح الترغيب 1941 (حسن)","الأحكام الوسطى 3/171 (صحيح)","السلسلة الصحيحة 1849 (صحيح)"]},{"id":"س-02217","fp":"f1ef8c9ccc80","stateId":705,"easy":"إذا بتّ وزوجك عنك راضٍ ← تدخلين الجنة","cause":"أيُّما امرَأةٍ باتَتْ وزوجُها عَنها راضٍ","result":"دخَلتِ الجَنَّةَ","explicit":true,"otherNeedIds":[37],"ref":"عارضة الأحوذي 3/93","srcLabel":"الترمذي","text":[["أيُّما امرَأةٍ باتَتْ وزوجُها عَنها راضٍ",1]," ",["دخَلتِ الجَنَّةَ",2]],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"حسن صحيح","takhrij":"أخرجه الترمذي (1161)، وابن ماجه (1854) بلفظ: \"ماتت\"","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"CCeO3FDp"},{"id":"س-02658","fp":"1236284c2c30","stateId":706,"easy":"إذا مات لك ثلاثة من الولد فاحتسبتهم ← تدخل الجنة","cause":"من ماتَ له ثلاثةٌ من الولَدِ فاحْتسَبَهُم","result":"دخلَ الجنةَ قال : قُلْنا : يا رسولَ اللهِ","explicit":true,"star":true,"similar":["س-02654","س-02668","س-07098","س-02819","س-02841","س-02804"],"ref":"صحيح الترغيب 2006","srcLabel":"البخاري","text":[["من ماتَ له ثلاثةٌ من الولَدِ فاحْتسَبَهُم ؛ ",1],["دخلَ الجنةَ قال : قُلْنا : يا رسولَ اللهِ ",2],"! واثنانِ ؟ قال : واثنانِ قال محمودٌ يعني ابنَ لبيدٍ : فقلتُ لجابرٍ : أراكُم لو قلتُم : وواحدٌ ؟ لقالَ : وواحدٌ . قال : وأنا [ واللهِ ] أظُنُّ ذلكَ ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"حسن صحيح","takhrij":"أخرجه أحمد (14285)، والبخاري في ((الأدب المفرد)) (146)، وابن حبان (2946) باختلاف يسير","bab":"إيمان › الاحتساب والنية","dorar":"eSEUbxhR","merged":3,"otherRefs":["صحيح ابن حبان 2946 (صحيح)","صحيح الأدب المفرد 109 (حسن)"]},{"id":"س-04237","fp":"d9ea88d28acb","stateId":706,"easy":"إذا صبرت على المكاره ← فالجنة حُفّت بالمكاره","cause":"بالمكارِهِ","result":"حُفَّتِ الجَنَّةُ","explicit":true,"star":true,"otherNeedIds":[69],"ref":"تخريج المسند لشعيب 12559","srcLabel":"مسلم","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قال: ",["حُفَّتِ الجَنَّةُ",2]," ",["بالمكارِهِ",1],"، وَحُفَّتِ النَّارُ بالشَّهواتِ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2822)","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"AJNwOS2x","merged":4,"otherRefs":["تخريج المسند لشعيب 8861 (حسن)","الجامع الصغير 3716 (صحيح)","تخريج المسند لشعيب 7530 (صحيح)"]},{"id":"س-02653","fp":"f08ca0baae68","stateId":706,"easy":"إذا قبض الله صفيك من الدنيا فاحتسبته ← فما لك عنده جزاء إلا الجنة","cause":"ما لعَبدي المُؤمِنِ عِندي جَزاءٌ إذا قَبَضتُ صَفيَّه مِن أهلِ الدُّنيا ثُمَّ احتَسَبَه","result":"إلَّا الجَنَّةُ","explicit":true,"star":true,"ref":"صحيح البخاري 6424","srcLabel":"البخاري","text":["يقولُ اللهُ تَعالى: ",["ما لعَبدي المُؤمِنِ عِندي جَزاءٌ إذا قَبَضتُ صَفيَّه مِن أهلِ الدُّنيا ثُمَّ احتَسَبَه،",1]," ",["إلَّا الجَنَّةُ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6424)","bab":"إيمان › الاحتساب والنية","dorar":"XI9QAdqH"},{"id":"س-02654","fp":"a09b86a59364","stateId":706,"easy":"إذا احتسبت ثلاثة من صلبك ← تدخل الجنة","cause":"مَن احتسبَ ثلاثةً مِن صُلبِهِ","result":"دخلَ الجنَّةَ","explicit":true,"repOf":"س-02658","ref":"صحيح النسائي 1871","text":[["مَن احتسبَ ثلاثةً مِن صُلبِهِ ، ",1],["دخلَ الجنَّةَ ",2],". فقامَتِ امرأةٌ ، فقالَت : أوِ اثنانِ ؟ قالَ : أوِ اثنانِ ، قالتِ المرأةُ : يا لَيتَني قلتُ واحدًا"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه النسائي (1872) واللفظ له، والبخاري في ((التاريخ الكبير)) (6/421)، وابن حبان (2943) مختصراً","bab":"إيمان › الاحتساب والنية","dorar":"rRC6Ekgg"},{"id":"س-02668","fp":"71d5242a0991","stateId":706,"easy":"إذا مات لكِ ثلاثة من الولد فاحتسبتهم ← تدخلين الجنة","cause":"لا يموتُ لإحداكنَّ ثلاثةٌ مِن الولدِ فتحتسبُه","result":"إلَّا دخَلتِ الجنَّةَ","explicit":true,"repOf":"س-02658","ref":"تخريج صحيح ابن حبان 2941","text":["أنَّ نسوةً مِن الأنصارِ قُلْنَ له: يا رسولَ اللهِ إنَّا لا نستطيعُ أنْ نأتيَك مع الرِّجالِ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( موعدُكنَّ بيتُ فلانةَ ) فجاء فتحدَّث معهنَّ ثمَّ قال: ( ",["لا يموتُ لإحداكنَّ ثلاثةٌ مِن الولدِ فتحتسبُه",1]," ",["إلَّا دخَلتِ الجنَّةَ )",2]," فقالتِ امرأةٌ منهنَّ: واثنتينِ يا رسولَ اللهِ ؟ قال: (واثنتينِ)"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن حبان (2941) واللفظ له، والبخاري (6656) بمعناه، ومسلم (2632) دون: أن نسوة من الأنصار...","bab":"إيمان › الاحتساب والنية","dorar":"u7AtKCy0"},{"id":"س-06059","fp":"db73a15f5d5e","stateId":706,"easy":"إذا مات لك فرطان (طفلان) ← يدخلك الله الجنة","cause":"مَن ماتَ له فَرَطانِ مِن أُمَّتي","result":"أَدخَلَه اللهُ الجنَّةَ","explicit":true,"star":true,"ref":"الأحاديث المختارة 10 / 421","srcLabel":"متفق عليه","text":["«",["مَن ماتَ له فَرَطانِ مِن أُمَّتي ",1],["أَدخَلَه اللهُ الجنَّةَ",2],"، قالَتْ عائِشةُ: ومَن ماتَ له فَرَطٌ؟ قالَ: ومَن ماتَ له فَرَطٌ يا مُوَفَّقةُ، قالَتْ: فمَن لم يكنْ له فَرَطٌ؟ قالَ: فأنا فَرَطُ أُمَّتي لم يُصابوا بمِثْلي»."],"grade":"صحيح","narrator":"سماك الحنفي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › فضل الصبر","dorar":"tGPZKJ6y"},{"id":"س-06061","fp":"d279a7a5c645","stateId":706,"easy":"إذا كان لك فرطان من الأمة ← تدخل الجنة","cause":"مَن كانَ له فَرَطانِ مِن أُمَّتي","result":"دَخَلَ الجنَّةَ، فقالَتْ عائِشةُ: بأبي","explicit":true,"ref":"الأحاديث المختارة 10 / 421","srcLabel":"متفق عليه","text":["«",["مَن كانَ له فَرَطانِ مِن أُمَّتي ",1],["دَخَلَ الجنَّةَ، فقالَتْ عائِشةُ: بأبي ",2],"فمَن كانَ له فَرَطٌ، فقالَ: ومَن كانَ له فَرَطٌ يا مُوَفَّقةُ، قالَتْ فمَن لم يكنْ له فَرَطٌ مِن أُمَّتِك، قالَ: فأنا فَرَطُ أُمَّتي؛ لم يُصابوا بِمْثْلي»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › فضل الصبر","dorar":"RlvXcVON"},{"id":"س-02648","fp":"c01014b826df","stateId":706,"easy":"إذا مات لكما أربعة من الولد ← يدخلكم الله الجنة بفضل رحمته","cause":"ما مِن المُسْلمَينِ يَموتُ لهما أربعةٌ","result":"إلَّا أدْخَلَهم اللهُ الجنَّة بفَضلِ رَحمتِه إيَّاهما","explicit":true,"similar":["س-06326"],"ref":"المستدرك على الصحيحين 8978","srcLabel":"مسلم","text":["كُنتُ أرفَعُ القضاءَ إلى أبي بُرْدةَ، فكنتُ عندَه فدَخَل عليه الحارثُ بنُ وُقَيشٍ -وكانت له صُحبةٌ- فحَدَّث لَيْلتَئِذٍ عن النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، قال: ",["ما مِن المُسْلمَينِ يَموتُ لهما أربعةٌ",1]," ",["إلَّا أدْخَلَهم اللهُ الجنَّة بفَضلِ رَحمتِه إيَّاهما",2],"، قُلنا: يا رَسولَ اللهِ، وثلاثةٌ؟ قال: وثلاثةٌ، قُلنا: يا رَسولَ اللهِ، واثنانِ؟ قال: واثنانِ، ثمَّ قال: إنَّ مِن أُمَّتي لَمَن يَعظُمَ للنَّارِ حتَّى يكونَ أحَدَ زَواياها، وإنَّ مِن أُمَّتي لَمَن يَدخُلُ بشَفاعتِه الجنَّةَ أكثَرُ مِن مُضَرَ."],"grade":"صحيح","narrator":"الحارث بن وقيش","muhaddith":"صحيح الإسناد على شرط مسلم ولم يخرجاه","bab":"إيمان › الاحتساب والنية","dorar":"VnvKazC5"},{"id":"س-07098","fp":"296496778733","stateId":706,"easy":"إذا قدّمت المرأة ثلاثاً من الولد تحتسبهن ← تدخل الجنة","cause":"ما مِن امْرَأَةٍ تُقَدِّمُ ثَلاثًا مِن الوَلَدِ تَـحْتَسِبُهنَّ","result":"إلَّا دَخَلَتِ الجنةَ","explicit":true,"repOf":"س-02658","ref":"تخريج المسند لشعيب 7357","text":["جاء نِسْوَةٌ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فقُلْنَ: يا رسولَ اللهِ، واللهِ ما نَقْدِرُ عَليك في مَـجْلِسِك مِن الرِّجالِ، فوَاعِدْنا مِنك يَوْمًا نَأتيك فيه، قال: مَوْعِدُكن بَيْتُ فُلانٍ، وأتاهُنَّ في ذلك اليَوْمِ، ولذلك الـمَوْعِدِ، قال: فكان مـمَّا قال لَـهُنَّ، يَعْني: ",["ما مِن امْرَأَةٍ تُقَدِّمُ ثَلاثًا مِن الوَلَدِ تَـحْتَسِبُهنَّ",1]," ",["إلَّا دَخَلَتِ الجنةَ",2],"، فقالتِ امرَأَةٌ مِنهنَّ: أَو اثْنانِ؟ قال: أَو اثْنانِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2632)، والنسائي في ((السنن الكبرى)) (5898)، وأحمد (7357) واللفظ له","bab":"علم › تعليم الناس وفضل ذلك","dorar":"iUfCnu4U"},{"id":"س-06334","fp":"783b9761ac93","stateId":706,"easy":"إذا تُوفي لكما ثلاثة من الولد صغاراً ← يدخلكما الله الجنة","cause":"ما من مُسلِميْنِ يُتَوفَّى لهم ثلاثةٌ منَ الوَلَدِ لم يَبلُغوا الحِنثَ","result":"إلَّا أدخَلَه اللهُ الجَنَّةَ بفَضلِ رَحمَتِه للصِّبْيةِ","explicit":true,"similar":["س-06794"],"otherNeedIds":[9,24,11],"ref":"تخريج المسند لشعيب 21413","srcLabel":"أحمد","text":["حدَّثَني صَعصَعةُ بنُ مُعاويةَ، قال: انتَهَيْتُ إلى الرَّبَذةِ، فإذا أنا بأبي ذَرٍّ، قد تَلَقَّاني برَواحلَ قد أورَدَها، ثُم أصدَرَها، وقد أعلَقَ قِربةً في عُنُقِ بَعيرٍ منها؛ ليَشرَبَ ويَسقيَ أصحابَه، وكان خُلُقًا من أخلاقِ العرَبِ، قُلْتُ: يا أبا ذَرٍّ ما لكَ؟ قال: لي عَمَلي، قُلْتُ: إيهٍ يا أبا ذَرٍّ، ما سمِعْتَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ؟ قال: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: مَن أنفَقَ زَوجَيْنِ من مالِه ابتَدَرَتْه حَجَبةُ الجَنَّةِ، قُلْنا: ما هذان الزَّوْجانِ؟ قال: إنْ كانت رِجالًا فرَجُلانِ، وإنْ كانت خَيلًا ففَرَسانِ، وإنْ كانت إبِلًا فبَعيرانِ، حتى عَدَّ أصنافَ المالِ كلِّه، قُلْتُ: يا أبا ذَرٍّ إيهٍ، ما سمِعْتَ من رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ؟ قال: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["ما من مُسلِميْنِ يُتَوفَّى لهم ثلاثةٌ منَ الوَلَدِ لم يَبلُغوا الحِنثَ،",1]," ",["إلَّا أدخَلَه اللهُ الجَنَّةَ بفَضلِ رَحمَتِه للصِّبْيةِ",2],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (21413) واللفظ له، والبزار (3909)، والطبراني في ((المعجم الأوسط)) (1366) مختصراً","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"FKmewTJK","merged":13,"otherRefs":["تخريج المسند لشعيب 27113 (صحيح)","عمدة القاري 8/46 (حسن)","تخريج المسند لشعيب 22090 (صحيح)","أحكام الجنائز 34 (صحيح)","المستدرك على الصحيحين 239 (صحيح)","الأحكام الوسطى 2/153 (صحيح)","تخريج المسند لشعيب 10622 (صحيح)","صحيح الأدب المفرد 113 (صحيح)","البحر الزخار 9/349 (صحيح)","تخريج صحيح ابن حبان 4645 (صحيح)","صحيح الأدب المفرد 112 (صحيح)","رياض الصالحين 959 (صحيح)"]},{"id":"س-02657","fp":"977cb330abc1","stateId":706,"easy":"إذا ماتت المرأة في نفاسها ← يجرها ولدها بسرره إلى الجنة","cause":"والنُّفَساءُ","result":"يجرُّها ولدُها بسرَرِه إلى الجنَّةِ","explicit":true,"otherNeedIds":[9,62],"ref":"صحيح الترغيب 1396","srcLabel":"أحمد","text":["أتعلَمون مَن الشَّهيدُ مِن أُمَّتِي ؟ فأرَمَّ القَومُ ، فقال عُبادةُ : سانِدُوني . فأسنَدوهُ ، فقالَ : يا رسولَ اللهِ ! الصَّابرُ المُحتَسبُ . فقال رسولُ اللهِ : إنَّ شُهداءَ أُمَّتِي إذًا لقَليلٌ ، القَتلُ في سبيلِ اللهِ عزَّ وجلَّ شَهادةٌ ، والطَّاعونُ شهادةٌ ، والغَرَقُ شهادةٌ ، والبَطنُ شهادةٌ ، ",["والنُّفَساءُ",1]," ",["يجرُّها ولدُها بسرَرِه إلى الجنَّةِ",2]," ، [ قال : وزادَ أبو العوامِ سادِنُ بيتِ المقدسِ : ] والحَرقُ ، والسُّلُّ"],"grade":"صحيح","narrator":"راشد بن حبيش","muhaddith":"حسن صحيح","takhrij":"أخرجه أحمد (16041)","bab":"إيمان › الاحتساب والنية","dorar":"0Rzsh73C","merged":4,"otherRefs":["مجمع الزوائد 5/302 (حسن)","الجامع الصغير 6159 (صحيح)","تخريج المسند لشعيب 22784 (صحيح)"]},{"id":"س-02635","fp":"3ba585ae742e","stateId":706,"easy":"إذا مات لك ولدان في الإسلام ← يدخلك الله الجنة بفضل رحمته إياهما","cause":"من مات له وَلدان في الإسلامِ","result":"أدخلَه اللهُ الجنَّةَ بفضلِ رحمتِه إياهما","explicit":true,"ref":"المتجر الرابح 98","srcLabel":"أحمد","text":["قلتُ: يا رسولَ اللهِ مات لي ولدان في الإسلامِ فقال: ",["من مات له وَلدان في الإسلامِ ",1],["أدخلَه اللهُ الجنَّةَ بفضلِ رحمتِه إياهما",2]," قال: فلما كان بعد ذلك لقِيَني أبو هريرةَ فقال لي: أنت الذي قال له رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ في الوَلَدَينِ ما قال؟ قلتُ: نعم قال: لأنْ يكونَ قاله لي أحبُّ إليَّ مما غلقت عليه حمصُ وفلسطينُ."],"grade":"صحيح","narrator":"أبو ثعلبة الأشجعي","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (27220)، والطبراني (22/384) (957) باختلاف يسير، وابن سعد في ((الطبقات الكبرى)) (5533) مختصراً باختلاف يسير","bab":"إيمان › الاحتساب والنية","dorar":"HvQyavtK","merged":2,"otherRefs":["مجمع الزوائد 12/3 (صحيح)"]},{"id":"س-02819","fp":"347298c20eef","stateId":706,"easy":"إذا مات لك ثلاثة من الولد تحتسبهم ← وجبت لك الجنة","cause":"لا يموتُ لامرأةٍ مسلِمَةٍ أوْ امرئٍ مسلمٍ نَسَمَةٌ أو قال ثلاثةٌ من ولدِهِ يَحْتَسِبُهُمْ","result":"إِلَّا وجبَتْ لَهُ الجنَّةُ","explicit":true,"repOf":"س-02658","otherNeedIds":[9],"ref":"مجمع الزوائد 11/3","text":["كنتُ عندَ النبيِّ صلَّى اللهُ عليه وسلَّمَ فبَلَغَهُ أنَّ امْرَأَةً مِنَ الْأَنْصَارِ مَاتَ ابْنٌ لَها فَجَزَعَتْ عَلَيْهِ فقامَ النبيُّ صلَّى اللهُ علَيْهِ وسلَّمَ ومعَهُ أصحابُهُ فلمَّا بَلَغَ بَابَ الْمَرْأَةِ قيلَ لِلْمَرْأَةِ إِنَّ نَبِيَّ اللهِ صلَّى اللهُ عليه وسلَّمَ يريدُ أنْ يَدْخُلَ يُعَزِيهَا فَدَخَلَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فقالَ أما أنَّهُ بلَغَني أَنَّكَ جَزَعْتَ عَلَى ابْنِكَ قَالَتْ يَا نَبِيَّ اللهِ مَا لي لا أَجْزَعُ وَأَنَا رَقُوبٌ لَا يَعِيشُ لي وَلَدٌ فَقَالَ رسولُ اللهِ صلَّى اللهُ علَيْهِ وَسَلَّمَ إِنَّما الرَّقوبُ الَّذِي يعيشُ ولدُها إنه ",["لا يموتُ لامرأةٍ مسلِمَةٍ أوْ امرئٍ مسلمٍ نَسَمَةٌ أو قال ثلاثةٌ من ولدِهِ يَحْتَسِبُهُمْ",1]," ",["إِلَّا وجبَتْ لَهُ الجنَّةُ",2]," فقال عمرُ وهو عَنْ يمينِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ بِأَبِي وَأُمِّي وَاثْنَيْنِ قَالَ نَبِيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ واثْنَيْنِ"],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه البزار (4401) باختلاف يسير، وأبو يعلى كما في ((المطالب العالية)) لابن حجر (793)، والحاكم (1416) بنحوه","bab":"إيمان › الوعد","dorar":"ladDnOab"},{"id":"س-02841","fp":"6c6dbd043b31","stateId":706,"easy":"إذا أُثكلت ثلاثة من صلبك فاحتسبتهم ← وجبت لك الجنة","cause":"مَن أُثكِلَ ثلاثةً مِن صُلْبِه، فاحتَسَبَهم على اللهِ","result":"وجَبَتْ له الجَنَّةُ","explicit":true,"repOf":"س-02658","ref":"تخريج المسند لشعيب 17298","text":[["مَن أُثكِلَ ثلاثةً مِن صُلْبِه، فاحتَسَبَهم على اللهِ",1]," -فقال أبو عُشَّانةَ مرَّةً: في سبيلِ اللهِ، ولم يَقُلْها مرَّةً أُخرى-، ",["وجَبَتْ له الجَنَّةُ",2],"."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17298)، والروياني في ((المسند)) (230)، والطبراني (17/300) (829)","bab":"إيمان › الوعد","dorar":"fQrP4c6p"},{"id":"س-03477","fp":"b6e58e368b8b","stateId":706,"easy":"إذا احتسبت السقط ← يجرك بسرره إلى الجنة","cause":"إذا احتسَبَتْه","result":"إنَّ السِّقطَ لَيَجُرُّ أُمَّه بسَرَرِه إلى الجنَّةِ","explicit":true,"otherNeedIds":[9],"ref":"تخريج المسند لشعيب 22090","srcLabel":"ابن ماجه","text":["ما مِن مُسلِمَينِ يُتوَفَّى لهما ثلاثةٌ، إلَّا أدخَلَهما اللهُ الجنَّةَ بفَضلِ رَحمتِه إيَّاهما، فقالوا: يا رسولَ اللهِ، أو اثنانِ؟ قال: أو اثنانِ، قالوا: أو واحدٌ؟ قال: أو واحدٌ، ثُمَّ قال: والذي نَفْسي بيَدِه، ",["إنَّ السِّقطَ لَيَجُرُّ أُمَّه بسَرَرِه إلى الجنَّةِ",2]," ",["إذا احتسَبَتْه",1],"."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح لغيره دون قصة السقط في آخره","takhrij":"أخرجه ابن ماجه (1609) مختصراً، وأحمد (22090) واللفظ له","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"vu9f6b0w"},{"id":"س-03806","fp":"5f94db893e84","stateId":706,"easy":"إذا صبرت على موت ولدك ← تجده عند كل باب من أبواب الجنة","cause":"فأخبره بأنه هَلَك","result":"تأتي غدًا إلى بابٍ من أبوابِ الجنةِ إلا وَجَدْتَه قد سبقك إليه يَفْتَحُه لك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[9],"ref":"أحكام الجنائز 205","srcLabel":"النسائي","text":["كان نبيُّ اللهِ صلَّى اللهُ عليه وسلم إذا جلس ، يجلسُ إليه نَفَرٌ من أصحابِه ، وفيهم رجلٌ له ابنٌ صغيرٌ ، يَأْتِيهِ من خَلْفِ ظهرِه فيُقْعِدُه بين يَدَيْهِ ، فقال له النبيُّ صلَّى اللهُ عليه وسلَّم تُحِبُّه ؟ فقال : يا رسولَ اللهِ أَحَبَّكَ اللهُ كما أُحِبُّه ! ، فهَلَك ، فامتَنَع الرجلُ أن يَحْضُرَ الحَلْقةَ ، لِذِكْرِ ابنِه ، فحَزِنَ عليه ، ففقده النبيُّ صلَّى اللهُ عليه وسلَّم ، فقال : ما لِي لا أَرَى فلانًا ؟ فقالوا : يا رسولَ اللهِ بُنَيُّه الذي رَأَيْتَه هَلَك ، فلَقِيَهُ النبيُّ صلَّى اللهُ عليه وسلَّم ، فسأله عن بُنَيِّهِ ؟ ",["فأخبره بأنه هَلَك",1]," ، فعَزَّاه عليه ، ثم قال : يا فلانُ ، أَيُّما كان أَحَبُّ إليكَ : أن تَمَتَّعَ به عُمُرَك ، أولا ",["تأتي غدًا إلى بابٍ من أبوابِ الجنةِ إلا وَجَدْتَه قد سبقك إليه يَفْتَحُه لك",2]," ؟ قال : يا نبيَّ اللهِ ، بل يسبقُني إلى بابِ الجنةِ فيفتحُها إليَّ ، لَهُوَ أَحَبُّ إلَيَّ ، قال : فذاك لك ، فقال رجلٌ من الأنصارِ : يا رسولَ اللهِ جعلني اللهُ فداءَك أله خاصةٌ أو لِكُلِّنا ؟ قال : بل لِكُلِّكم ."],"grade":"صحيح","narrator":"قرة بن إياس المزني","muhaddith":"إسناده صحيح وله شاهد","takhrij":"أخرجه النسائي (2088) واللفظ له، والطبراني في ((المعجم الكبير)) (19/ 31) (66) باختلاف يسير، وأحمد (15595) مختصرًا بنحوه.","bab":"بر وصلة › حب الولد","dorar":"Jczx1l57","merged":8,"otherRefs":["تخريج صحيح ابن حبان 2947 (صحيح)","الأحكام الوسطى 2/153 (صحيح)","إتحاف الخيرة المهرة 2/446 (صحيح)","التمهيد 6/351 (صحيح)","الصحيح المسند 1081 (صحيح)","التمهيد 6/349 (صحيح)","صحيح النسائي 1869 (صحيح)"]},{"id":"س-04172","fp":"85d0cad34f58","stateId":706,"easy":"إذا ذهب الله ببصرك فصبرت واحتسبت ← يدخلك الله الجنة","cause":"لا يَذْهَبُ اللهُ بِحَبيبَتَيْ عبدٍ ، فَيَصْبِرُ ويَحْتَسِبُ","result":"إلَّا أدخلَهُ اللهُ الجنةَ","explicit":true,"ref":"صحيح الموارد 584","srcLabel":"الترمذي","text":[["لا يَذْهَبُ اللهُ بِحَبيبَتَيْ عبدٍ ، فَيَصْبِرُ ويَحْتَسِبُ ؛",1]," ",["إلَّا أدخلَهُ اللهُ الجنةَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (2932) واللفظ له، وأخرجه الترمذي (2401)، وأحمد (7597) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"SAHtgq7f"},{"id":"س-04256","fp":"59aafceede00","stateId":706,"easy":"إذا مات لك ثلاثة أولاد ← يدخلك الله بهم الجنة","cause":"ما منِ امرِئٍ أوِ امرَأةٍ مُسلِمةٍ يَموتُ لها ثَلاثةُ أولادٍ","result":"إلَّا أدخَلَهُمُ اللهُ بِهِمُ الجَنَّةَ","explicit":true,"ref":"المستدرك على الصحيحين 1434","srcLabel":"الحاكم","text":["كان رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يَتعَهَّدُ الأنصارَ، ويَعودُهم، ويَسألُ عنهم، فبَلَغه عنِ امرَأةٍ منَ الأنصارِ مات ابنُها وليس لها غَيرُه، وأنها جَزِعَت عليه جَزَعًا شَديدًا، فأتاها النَّبيُّ صلَّى اللهُ عليه وسلَّمَ فأمَرَها بتَقوى اللهِ وبالصَّبرِ، فقالتْ: يا رَسولَ اللهِ، إنِّي امرَأةٌ رَقوبٌ لا ألِدُ، ولم يكن لي غَيرُه، فقالَ رسول اللهِ صلَّى اللهُ عليه وسلَّمَ: الرَّقوبُ الَّذي يَبقى وَلَدُها، ثمَّ قالَ: ",["ما منِ امرِئٍ أوِ امرَأةٍ مُسلِمةٍ يَموتُ لها ثَلاثةُ أولادٍ",1]," ",["إلَّا أدخَلَهُمُ اللهُ بِهِمُ الجَنَّةَ",2]," فقالَ عُمَرُ: يا رَسولَ اللهِ -بأبي أنت وأمِّي- واثنانِ؟ قالَ: واثنانِ."],"grade":"صحيح","narrator":"بريدة","muhaddith":"صحيح الإسناد","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"HC75t7YE"},{"id":"س-06326","fp":"5b60f0d02111","stateId":706,"easy":"إذا مات لكما ثلاثة من الولد صغاراً ← يدخلكما الله الجنة بفضل رحمته","cause":"ما مِن مسلِمَينِ يموتُ لهما ثلاثةٌ مِن الولدِ لم يبلُغوا الحِنْثَ","result":"إلَّا أدخَلهما اللهُ الجنَّةَ بفضلِ رحمتِه إيَّاهم ) وسمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( ما مِن رجلٍ أنفَق زوجينِ مِن مالِه في سبيلِ اللهِ إلَّا ابتدرَتْه حَجَبةُ","explicit":true,"repOf":"س-02648","ref":"تخريج صحيح ابن حبان 4643","text":["قدِمْتُ الرَّبَذةَ فلقيتُ أبا ذرٍّ فقُلْتُ: يا أبا ذرٍّ ما مالُك ؟ قال: مالي عملي قُلْتُ: يا أبا ذرٍّ ألَا تُحدِّثُني حديثًا سمِعْتَه مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم ؟ قال: بلى سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( ",["ما مِن مسلِمَينِ يموتُ لهما ثلاثةٌ مِن الولدِ لم يبلُغوا الحِنْثَ",1]," ",["إلَّا أدخَلهما اللهُ الجنَّةَ بفضلِ رحمتِه إيَّاهم ) وسمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( ما مِن رجلٍ أنفَق زوجينِ مِن مالِه في سبيلِ اللهِ إلَّا ابتدرَتْه حَجَبةُ",2]," الجنَّةِ ) قُلْتُ: وما زوجانِ مِن مالِه ؟ قال: عبدانِ مِن رقيقِه، فرسانِ مِن خيلِه، بعيرانِ مِن إبلِه،"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (4644) بلفظه، وأحمد (21413)، والدارمي (2431) كلاهما باختلاف يسير.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"8NtspKxv"},{"id":"س-06794","fp":"5cae4021b957","stateId":706,"easy":"إذا وُلد لك ثلاثة أولاد في الإسلام فماتوا صغاراً ← يدخلك الله الجنة برحمته إياهم","cause":"مَن وُلِدَ له ثلاثةُ أَولادٍ في الإسلامِ، فماتوا قبلَ أنْ يَبلُغوا الحِنثَ","result":"أدخَلَه اللهُ عزَّ وجلَّ الجنَّةَ برَحمتِه إيَّاهم","explicit":true,"repOf":"س-06334","ref":"تخريج المسند لشعيب 19437","text":[["مَن وُلِدَ له ثلاثةُ أَولادٍ في الإسلامِ، فماتوا قبلَ أنْ يَبلُغوا الحِنثَ، ",1],["أدخَلَه اللهُ عزَّ وجلَّ الجنَّةَ برَحمتِه إيَّاهم، ",2],"ومَن شاب شَيبةً في سَبيلِ اللهِ عزَّ وجلَّ كانتْ له نورًا يومَ القيامةِ، ومَن رَمى بسَهمٍ في سَبيلِ اللهِ عزَّ وجلَّ بَلَغَ به العَدوَّ، أصابَ أو أخطَأَ، كان له كعَدلِ رَقبةٍ، ومَن أعتَقَ رَقبةً مؤمنةً أعتَقَ اللهُ بكلِّ عُضوٍ منها عُضوًا منه مِن النَّارِ، ومَن أنفَقَ زَوجَينِ في سَبيلِ اللهِ عزَّ وجلَّ، فإنَّ للجنَّةِ ثَمانيةَ أبْوابٍ، يُدخِلُه اللهُ عزَّ وجلَّ مِن أيِّ بابٍ شاء منها الجنَّةِ."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح دون قوله: \"من ولد له....\" و\"ومن أنفق زوجين\" فصحيح لغيره","takhrij":"أخرجه أبو داود (3966)، والنسائي (3145) مختصرا، والترمذي (1635، 1638) مفرقاً مختصراً، وأحمد (19437) واللفظ له","bab":"عتق وولاء › فضل العتق","dorar":"bTRJfZ4H"},{"id":"س-02804","fp":"753338ed306e","stateId":706,"easy":"إذا مات لك ثلاثة من الولد أو اثنان ← فأنت في الجنة","cause":"لمن ماتَ لهُ ثلاثةٌ من الولدِ أو اثنانِ","result":"في الجنَّةِ","explicit":true,"repOf":"س-02658","otherNeedIds":[9],"ref":"الاستيعاب في معرفة الأصحاب 1/347","text":[["في الجنَّةِ",2]," ",["لمن ماتَ لهُ ثلاثةٌ من الولدِ أو اثنانِ",1]],"grade":"حسن","narrator":"الحارث بن أقيش الأنصاري","muhaddith":"حسن","takhrij":"أخرجه أحمد (17859 )، وابن أبي شيبة (12001) مطولا بنحوه، وابن عبد البر معلقا في ((الاستيعاب)) (1/282) واللفظ له","bab":"إيمان › الوعد","dorar":"Zokm1WRj"},{"id":"س-07133","fp":"f54c438e5b39","stateId":706,"easy":"إذا تُوفيت في غير مولدك ← يُقاس لك من مولدك إلى منقطع أثرك في الجنة","cause":"إذا توُفِّيَ في غيرِ مولدِهِ","result":"قِيسَ لَهُ من مولدِهِ إلى مُنقَطعِ أثرِهِ ، في الجنَّةِ","explicit":true,"ref":"تخريج المسند لشاكر 10/141","srcLabel":"النسائي","text":["توُفِّيَ رجلٌ بالمدينةِ ، فصلَّى عليهِ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ يا ليتَهُ ماتَ في غيرِ مولدِهِ ، فقالَ رجلٌ منَ النَّاسِ : لِمَ يا رسولَ اللَّهِ ؟ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : إنَّ الرَّجلَ ",["إذا توُفِّيَ في غيرِ مولدِهِ",1]," ",["قِيسَ لَهُ من مولدِهِ إلى مُنقَطعِ أثرِهِ ، في الجنَّةِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (1832)، وابن ماجه (1614) باختلاف يسير","bab":"علم › حسن السؤال ونصح العالم","dorar":"oXJb6CVY"},{"id":"س-02861","fp":"2ecce1b986a4","stateId":707,"easy":"إذا عدت أخاك ← تكون في خرفة الجنة","cause":"مَنْ عادَ أخاهُ","result":"كان في خُرْفَةِ الجنةِ","explicit":true,"star":true,"similar":["س-07923","س-01977"],"ref":"صحيح الأدب المفرد 406","srcLabel":"البخاري","text":[["مَنْ عادَ أخاهُ",1]," ",["كان في خُرْفَةِ الجنةِ",2]," .قُلْتُ لأَبي قِلابَةَ: ما خُرْفَةُ الجنةِ؟ قال: جَناها، قُلْتُ لأَبي قِلابَةَ: عن مَنْ حَدَّثَهُ أبو أسماءَ ؟ قال : عن ثَوْبانَ ، عن رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ"],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (968)، والبخاري في ((الأدب المفرد)) (521)، والبيهقي في ((الآداب)) (270) واللفظ لهم.","bab":"إيمان › الوعد","dorar":"pc1LQzMY"},{"id":"س-08226","fp":"44ceeb0bed59","stateId":707,"easy":"إذا عدت مريضاً بكراً ← يشيعك سبعون ألف ملك يستغفرون لك ولك خريف في الجنة","cause":"مَن عادَ مَريضًا بَكَرًا شَيَّعَه سَبْعونَ ألْفًا -يَعْني مَلَكًا- كلُّهم يَسْتَغْفِرُ له حتَّى يُمْسيَ","result":"وكانَ له خَريفٌ في الجنَّةِ، وإن عادَه مَساءً شَيَّعَه سَبْعونَ ألْفَ مَلَكٍ كلُّهم يَسْتَغْفِرُ له حتَّى يُصبِحَ، وكانَ له خَريفٌ في الجنَّةِ","explicit":true,"star":true,"otherNeedIds":[24],"ref":"الأحاديث المختارة 618","srcLabel":"البخاري","text":["«عادَ أبو موسى الأَشْعَرِيُّ الحَسَنَ بنَ علِيٍّ، فقالَ له علِيٌّ: أعائِدًا جِئْتَ أم زائِرًا؟ فقالَ أبو موسى: بلْ جِئْتُ عائِدًا، فقالَ علِيٌّ: سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: ",["مَن عادَ مَريضًا بَكَرًا شَيَّعَه سَبْعونَ ألْفًا -يَعْني مَلَكًا- كلُّهم يَسْتَغْفِرُ له حتَّى يُمْسيَ، ",1],["وكانَ له خَريفٌ في الجنَّةِ، وإن عادَه مَساءً شَيَّعَه سَبْعونَ ألْفَ مَلَكٍ كلُّهم يَسْتَغْفِرُ له حتَّى يُصبِحَ، وكانَ له خَريفٌ في الجنَّةِ»",2],"."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"ملائكة › أعمال الملائكة","dorar":"yOYMNrB1"},{"id":"س-07923","fp":"4073b2dcd513","stateId":707,"easy":"إذا عدت أخاك المسلم ← لم تزل في مخرفة الجنة حتى ترجع","cause":"إِنَّ المسلِمَ إذا عادَ أخاه المسلِمَ","result":"لِمْ يَزَلْ فِي مَخْرَفَةِ الجنةِ حتَّى يرْجِعَ","explicit":true,"repOf":"س-02861","ref":"صحيح الجامع 1948","text":[["إِنَّ المسلِمَ إذا عادَ أخاه المسلِمَ ",1],["لِمْ يَزَلْ فِي مَخْرَفَةِ الجنةِ حتَّى يرْجِعَ",2]],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2568)، وأحمد (22389)، والطبراني (2/ 101) (1445) واللفظ لهم.","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"KAahoULI","merged":2,"otherRefs":["تخريج المسند لشعيب 22451 (صحيح)"]},{"id":"س-01977","fp":"e1d0a7cc44cb","stateId":707,"easy":"إذا عدت أخاك المسلم ← فأنت في مخرفة الجنة","cause":"إذا عاد الرَّجُلُ المُسلِمُ أخاه المُسلِمَ","result":"فهو في مَخرَفةِ الجنَّةِ","explicit":true,"repOf":"س-02861","ref":"تخريج المسند لشعيب 22373","text":[["إذا عاد الرَّجُلُ المُسلِمُ أخاه المُسلِمَ، ",1],["فهو في مَخرَفةِ الجنَّةِ",2],"."],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2568)، والترمذي (967)، وأحمد (22373) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"p2dqOT9J"},{"id":"س-01947","fp":"1dae7747b685","stateId":707,"easy":"إذا عدت أخاك المسلم أو زرته ← يقول الله: طبت وطاب ممشاك وتبوأت منزلاً في الجنة","cause":"إذا عاد المسلمُ أخاه المسلمَ أو زاره","result":"قال اللهُ تبارَك وتعالى: طِبْتَ وطاب ممشاكَ وتبوَّأْتَ منزلًا في الجنَّةِ","explicit":true,"similar":["س-01894"],"ref":"صحيح ابن حبان 2961","srcLabel":"الترمذي","text":[["إذا عاد المسلمُ أخاه المسلمَ أو زاره ",1],["قال اللهُ تبارَك وتعالى: طِبْتَ وطاب ممشاكَ وتبوَّأْتَ منزلًا في الجنَّةِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الترمذي (2008)، وابن ماجه (1443)، وأحمد (8536) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"hwAxyPvb","merged":3,"otherRefs":["صحيح الترغيب 3474 (حسن)","صحيح الأدب المفرد 262 (حسن)"]},{"id":"س-01894","fp":"70b7025ae82e","stateId":707,"easy":"إذا عدت مريضاً أو زرت أخاً في الله ← يناديك منادٍ: طبت وطاب ممشاك وتبوأت من الجنة منزلاً","cause":"مَن عاد مريضًا ، أو زارَ أخًا لهُ في اللهِ","result":"ناداه مُنادٍ : أن طِبتَ وطابَ ممشاكَ ، وتبوَّأْتَ مِن الجنَّةِ منزلًا","explicit":true,"repOf":"س-01947","ref":"صحيح الترغيب 2578","text":[["مَن عاد مريضًا ، أو زارَ أخًا لهُ في اللهِ ؛ ",1],["ناداه مُنادٍ : أن طِبتَ وطابَ ممشاكَ ، وتبوَّأْتَ مِن الجنَّةِ منزلًا",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (2008) واللفظ له، وابن ماجه (1443)، وأحمد (8325)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"n8ZiLnYL","merged":2,"otherRefs":["صحيح الجامع 6387 (حسن)"]},{"id":"س-06807","fp":"5504eb97407c","stateId":707,"easy":"إذا عدت مريضاً وشهدت جنازة وصمت يوماً ورحت إلى الجمعة وأعتقت رقبة ← وجبت لك الجنة","cause":"مَنْ عادَ مَرِيضًا ، و شَهِدَ جَنازَةً ، و صامَ يومًا ، و رَاحَ يومَ الجمعةِ ، و أعتقَ رَقَبَةً","result":"مَنْ عَمِلهُنَّ في يَوْمٍ كتبَهُ اللهُ من أهلِ الجنةِ","explicit":true,"ref":"صحيح الترغيب 686","srcLabel":"ابن حبان","text":["خَمْسٌ ",["مَنْ عَمِلهُنَّ في يَوْمٍ كتبَهُ اللهُ من أهلِ الجنةِ",2]," ، ",["مَنْ عادَ مَرِيضًا ، و شَهِدَ جَنازَةً ، و صامَ يومًا ، و رَاحَ يومَ الجمعةِ ، و أعتقَ رَقَبَةً",1]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه أبو يعلى (1044)، وابن حبان (2771) واللفظ له، والديلمي في ((الفردوس)) (2973).","bab":"عتق وولاء › فضل العتق","dorar":"191lon6y","merged":2,"otherRefs":["الترغيب والترهيب 4/246 (صحيح)"]},{"id":"س-02809","fp":"940f18993150","stateId":707,"easy":"إذا عدت مريضاً ← لم تزل في خرفة الجنة","cause":"مَن عادَ مَريضًا","result":"لَم يَزَلْ في خُرفةِ الجَنَّةِ","explicit":true,"ref":"صحيح مسلم 2568","srcLabel":"الترمذي","text":[["مَن عادَ مَريضًا ",1],["لَم يَزَلْ في خُرفةِ الجَنَّةِ",2],"، قيلَ: يا رَسولَ اللهِ، وما خُرفةُ الجَنَّةِ؟ قال: جَناها."],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (22389)، وأبو عوانة (11203) واللفظ لهما، والترمذي (967)، وابن حبان (598) باختلاف يسير.","bab":"إيمان › الوعد","dorar":"C5JvShbV"},{"id":"س-07921","fp":"9c948d97d96d","stateId":707,"easy":"إذا أتيت أخاك عائداً ← فأنت في خرافة الجنة","cause":"مَن أتى أخاه عائدًا","result":"فهو في خُرافةِ الجَنَّةِ، فإذا جَلَس غَمَرَتْه الرَّحمةُ، وإن كان غُدْوةً صَلَّى عليه سَبعون ألفَ مَلَكٍ حتَّى يُمسِيَ، وإنْ كان مُمسِيًا صَلَّى عليه سَبعون ألفَ مَلَكٍ حتَّى يُصبِحَ","explicit":true,"otherNeedIds":[24],"ref":"المستدرك على الصحيحين 1311","srcLabel":"الترمذي","text":["جاءَ أبو موسى الأشعَريُّ يَعودُ الحَسَنَ بنَ عَلِيٍّ، فقالَ له عَلِيٌّ: أجِئْتَ عائدًا، أم شامِتًا؟ فقالَ: بل جِئتُ عائدًا، فقالَ عَلِيٌّ: إنْ جِئَت عائدًا؛ فإنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["مَن أتى أخاه عائدًا ",1],["فهو في خُرافةِ الجَنَّةِ، فإذا جَلَس غَمَرَتْه الرَّحمةُ، وإن كان غُدْوةً صَلَّى عليه سَبعون ألفَ مَلَكٍ حتَّى يُمسِيَ، وإنْ كان مُمسِيًا صَلَّى عليه سَبعون ألفَ مَلَكٍ حتَّى يُصبِحَ",2],"."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه الترمذي (969)، وابن ماجه (1442)، وأحمد (975) جميعهم بلفظ مقارب.","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"6vJJaQrH"},{"id":"س-07922","fp":"4958019d73c1","stateId":707,"easy":"إذا عدت المريض ← فأنت في مخرفة الجنة","cause":"عائدُ المريضِ","result":"في مَخْرَفَةِ الجنَّةِ","explicit":true,"ref":"صحيح الجامع 3963","srcLabel":"البزار","text":[["عائدُ المريضِ",1]," ",["في مَخْرَفَةِ الجنَّةِ",2]," ، فإذا جلس عنده غمرَتْه الرّحمةُ"],"grade":"صحيح","narrator":"عبدالرحمن بن عوف","muhaddith":"صحيح","takhrij":"أخرجه البزار (1036) بلفظه.","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"KVjnwZzU"},{"id":"س-08186","fp":"0a48c8c8e008","stateId":707,"easy":"إذا عدت مسلماً غدوة ← يصلي عليك سبعون ألف ملك حتى تمسي","cause":"ما مِن مسلِمٍ يعودُ مُسلِمًا غدوةً","result":"إلَّا صلَّى عليهِ سبعونَ ألفَ ملَكٍ حتَّى يُمسيَ ، وإن عادَهُ عشيَّةً ، إلَّا صلَّى عليهِ سبعونَ ألفَ ملَكٍ حتَّى يُصبِحَ ، وَكانَ لَه خريفٌ في الجنَّةِ","explicit":true,"similar":["س-02845"],"ref":"صحيح الترمذي 969","srcLabel":"الترمذي","text":["عن [سعيد بن علاقة] قال: أخذ علي بيدي قال انطلق بنا إلى الحسن نعوده فوجدنا عنده أبا موسى فقال علي عليه السلام أعائداً جئت يا أبا موسى ! أم زائرا ؟ فقال لا بل عائدا فقال علي سمعت رسول الله صلى الله عليه و سلم يقول ",["ما مِن مسلِمٍ يعودُ مُسلِمًا غدوةً ،",1]," ",["إلَّا صلَّى عليهِ سبعونَ ألفَ ملَكٍ حتَّى يُمسيَ ، وإن عادَهُ عشيَّةً ، إلَّا صلَّى عليهِ سبعونَ ألفَ ملَكٍ حتَّى يُصبِحَ ، وَكانَ لَه خريفٌ في الجنَّةِ",2]],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح إلا قوله زائرا والصواب شامتا","takhrij":"أخرجه الترمذي (969) واللفظ له، وأحمد (955)","bab":"ملائكة › أعمال الملائكة","dorar":"LgAmtZUQ"},{"id":"س-01922","fp":"584ed54407af","stateId":707,"easy":"إذا عزّيت ثكلى ← تُكسى برداً في الجنة","cause":"من عزَّى ثَكلَى","result":"كُسِيَ بُردًا في الجنَّةِ","explicit":true,"ref":"هداية الرواة 2/232","srcLabel":"الترمذي","text":[["من عزَّى ثَكلَى ",1],["كُسِيَ بُردًا في الجنَّةِ",2]],"grade":"حسن","narrator":"أبو برزة الأسلمي نضلة بن عبيد","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه الترمذي (1076) واللفظ له، وأبو يعلى (7439)، والبيهقي في ((شعب الإيمان)) (9281) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"qcueedxx"},{"id":"س-02845","fp":"db1e4686577a","stateId":707,"easy":"إذا عدت مسلماً ← يصلي عليك سبعون ألف ملك ولك خريف في الجنة","cause":"ما عاد مُسلِمٌ مُسلِمًا","result":"إلَّا صلَّى عليه سَبعونَ ألفَ مَلَكٍ من حينِ يُصبِحُ إلى أنْ يُمسيَ، وجعَل اللهُ تعالى له خَريفًا في الجَنَّةِ","explicit":true,"repOf":"س-08186","ref":"تخريج المسند لشعيب 702","text":["حدَّثني ثُوَيرُ بنُ أبي فاخِتةَ، عن أَبيه، قال: عاد أبو موسى الأَشْعريُّ الحَسَنَ بنَ عليٍّ، قال: فدخَل عليٌّ، فقال: أعائدًا جِئْتَ يا أبا موسى أَمْ زائرًا؟ فقال: يا أميرَ المُؤمِنينَ، لا بلْ عائدًا. فقال عليٌّ: فإنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["ما عاد مُسلِمٌ مُسلِمًا",1]," ",["إلَّا صلَّى عليه سَبعونَ ألفَ مَلَكٍ من حينِ يُصبِحُ إلى أنْ يُمسيَ، وجعَل اللهُ تعالى له خَريفًا في الجَنَّةِ",2],"، قال: فقُلْنا: يا أميرَ المُؤمِنينَ، وما الخَريفُ؟ قال: السَّاقيةُ التي تَسْقي النَّخلَ."],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"حسن والصحيح وقفه","takhrij":"أخرجه الترمذي (969)، وأحمد (702) واللفظ له","bab":"إيمان › الوعد","dorar":"JSUCKJip"},{"id":"س-02910","fp":"a8143836d70f","stateId":707,"easy":"إذا عزّيت أخاك المؤمن في مصيبته ← يكسوك الله حلة خضراء يوم القيامة","cause":"مَن عَزَّى أخاه المؤمنَ في مصيبةٍ","result":"كَسَاه اللهُ حُلَّةً خضراءَ يُحْبَرُ بها يومَ القيامةِ","explicit":true,"ref":"أحكام الجنائز 206","srcLabel":"ابن حبان","text":[["مَن عَزَّى أخاه المؤمنَ في مصيبةٍ ",1],["كَسَاه اللهُ حُلَّةً خضراءَ يُحْبَرُ بها يومَ القيامةِ ",2],"، قيل : يا رسولَ اللهِ ما يُحْبَرُ ؟ قال يُغْبَطُ ."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"له شاهد مقطوعا وهو حسن بمجموع الطريقين","takhrij":"أخرجه ابن حبان في ((المجروحين)) (2/150)، والطبراني في ((الدعاء)) (1226)، وابن عدي في ((الكامل في الضعفاء)) (4/260)","bab":"إيمان › الوعد","dorar":"tUjmSce4"},{"id":"س-03346","fp":"d8068709c26f","stateId":707,"easy":"إذا كفّنت مسلماً ← يكسوك الله من السندس","cause":"ومَنْ كَفَّنَ مسلمًا","result":"كَساهُ اللهُ مِنَ السُّنْدُسِ","explicit":true,"ref":"السلسلة الصحيحة 2353","srcLabel":"الطبراني","text":["مَنْ غَسَّلَ مَيِّتًا فَسترَهُ ، سترَهُ اللهُ مِنَ الذُّنوبِ ، ",["ومَنْ كَفَّنَ مسلمًا ، ",1],["كَساهُ اللهُ مِنَ السُّنْدُسِ",2]],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"ذكر له طرقا ثم قال وللحديث شاهد قوي","takhrij":"أخرجه الطبراني (8/337) (8077) واللفظ له، وابن بشران في ((الأمالي)) (1647)، والبيهقي في ((شعب الإيمان)) (9267) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"skkywlxb"},{"id":"س-01963","fp":"fdbec2831380","stateId":708,"easy":"إذا أمطت غصن شوك عن طريق المسلمين ← تدخل الجنة","cause":"بغُصْنِ شَوْكٍ على طَريقِ المُسلِمينَ، فأَماطَه عنه","result":"دخَلَ عبدٌ الجنَّةَ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 9246","srcLabel":"متفق عليه","text":[["دخَلَ عبدٌ الجنَّةَ",2]," ",["بغُصْنِ شَوْكٍ على طَريقِ المُسلِمينَ، فأَماطَه عنه",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (652)، ومسلم (1914) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"N7dLVhnm"},{"id":"س-01965","fp":"e6a5d68a44a5","stateId":708,"easy":"إذا نحيت غصن شوك عن الطريق ← يشكر الله لك ويدخلك الجنة","cause":"مَرَّ رَجُلٌ بغُصنِ شَوكٍ، فنَحَّاهُ عن الطَّريقِ","result":"فشكَرَ اللهُ له، فأدخَلَهُ الجنَّةَ","explicit":true,"star":true,"otherNeedIds":[45],"ref":"تخريج المسند لشعيب 10753","srcLabel":"متفق عليه","text":[["مَرَّ رَجُلٌ بغُصنِ شَوكٍ، فنَحَّاهُ عن الطَّريقِ",1],"، ",["فشكَرَ اللهُ له، فأدخَلَهُ الجنَّةَ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (652)، ومسلم (1914) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"v1KTnIr7"},{"id":"ق-1415","fp":"2adcb9c09596","stateId":708,"easy":"البرّ ← النعيم","cause":"البرّ","result":"النعيم","explicit":true,"similar":["ق-1421"],"ref":"سورة الانفطار: 13","srcLabel":"القرآن الكريم","quran":{"s":82,"from":13,"to":13,"text":"إِنَّ الْأَبْرَارَ لَفِي نَعِيمٍ (13)","hl":[[0,32,1]]}},{"id":"ق-1421","fp":"0e025a03f901","stateId":708,"easy":"البرّ ← كتاب في عليين ونعيم ورحيق مختوم","cause":"البرّ","result":"كتاب في عليين ونعيم ورحيق مختوم","explicit":true,"repOf":"ق-1415","otherNeedIds":[68],"ref":"سورة المطففين: 18–28","quran":{"s":83,"from":18,"to":28,"text":"كَلَّا إِنَّ كِتَابَ الْأَبْرَارِ لَفِي عِلِّيِّينَ (18) وَمَا أَدْرَاكَ مَا عِلِّيُّونَ (19) كِتَابٌ مَرْقُومٌ (20) يَشْهَدُهُ الْمُقَرَّبُونَ (21) إِنَّ الْأَبْرَارَ لَفِي نَعِيمٍ (22) عَلَى الْأَرَائِكِ يَنْظُرُونَ (23) تَعْرِفُ فِي وُجُوهِهِمْ نَضْرَةَ النَّعِيمِ (24) يُسْقَوْنَ مِنْ رَحِيقٍ مَخْتُومٍ (25) خِتَامُهُ مِسْكٌ وَفِي ذَلِكَ فَلْيَتَنَافَسِ الْمُتَنَافِسُونَ (26) وَمِزَاجُهُ مِنْ تَسْنِيمٍ (27) عَيْنًا يَشْرَبُ بِهَا الْمُقَرَّبُونَ (28)","hl":[[0,143,1]]}},{"id":"س-02153","fp":"199140860ffc","stateId":708,"easy":"إذا أزلت شجرة تؤذي المسلمين ← تدخل الجنة","cause":"فجاءَ رَجُلٌ فقَطَعَها","result":"فدَخَلَ الجَنَّةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح مسلم 1914","srcLabel":"متفق عليه","text":["إنَّ شَجَرةً كانَت تُؤذي المُسلِمينَ، ",["فجاءَ رَجُلٌ فقَطَعَها",1],"، ",["فدَخَلَ الجَنَّةَ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"7R9kZmrg"},{"id":"س-00142","fp":"b460afe14c31","stateId":708,"easy":"إذا تراحمتم ← تدخلون الجنة (ولا تدخلونها حتى تراحموا)","cause":"حتَّى تَراحَمُوا","result":"لا تَدخُلُوا الجنَّةَ","explicit":true,"ref":"المستدرك على الصحيحين 7516","srcLabel":"النسائي","text":["لنْ تُؤمِنوا حتَّى تَحابُّوا، أفلا أدُلُّكم على ما تَحابُّوا عليه؟ قالوا: بلى يا رسولَ اللهِ، قالَ: أفْشُوا السَّلامَ بيْنَكم تَحابُّوا، والَّذي نفْسِي بيَدِه، ",["لا تَدخُلُوا الجنَّةَ",2]," ",["حتَّى تَراحَمُوا",1],"، قالوا: يا رسولَ اللهِ، كُلُّنا رَحيمٌ، قالَ: إنَّه ليسَ برَحمةِ أحدِكم، ولكِنْ رَحمةُ العامَّةِ، رَحمةُ العامَّةِ."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح الإسناد","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (5928) واللفظ له.","bab":"آداب السلام › إفشاء السلام","dorar":"IdRRzV45"},{"id":"س-05785","fp":"9e73280d86ee","stateId":708,"easy":"إذا كنت من أهل المعروف في الدنيا ← تكون أول من يدخل الجنة","cause":"وأهلُ المعروفِ في الدنيا","result":"أولُ مَن يدخُلُ الجنةَ","explicit":true,"ref":"الجامع الصغير 5024","srcLabel":"الطبراني","text":["صنائعُ المعروفِ تَقي مصارعَ السوءِ والصدقةُ خُفيا تُطفِئُ غضبَ الربِّ، وصلةُ الرحِمِ زيادةٌ في العمُرِ، وكلُّ معروفٍ صدَقَةٌ، ",["وأهلُ المعروفِ في الدنيا",1]," هم أهلُ المعروفِ في الآخرةِ، وأهلُ المُنكَرِ في الدنيا هم أهلُ المُنكَرِ في الآخِرَةِ، و",["أولُ مَن يدخُلُ الجنةَ",2]," أهلُ المعروفِ"],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6086)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"FXfMwMQ4"},{"id":"س-08299","fp":"72310b95789e","stateId":708,"easy":"إذا عزلت شجرة تؤذي الناس عن الطريق ← تتقلب في ظلها في الجنة","cause":"فعَزَلَها عن طَريقِ النَّاسِ","result":"يتَقَلَّبُ في ظِلِّها في الجَنَّةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[47,11],"ref":"تخريج المسند لشعيب 12571","srcLabel":"أحمد","text":["كانت شَجَرةٌ في طريقِ النَّاسِ تُؤْذي النَّاسَ، فأتاها رَجُلٌ ",["فعَزَلَها عن طَريقِ النَّاسِ",1],"، قال: قال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: فلقدْ رأيْتُه ",["يتَقَلَّبُ في ظِلِّها في الجَنَّةِ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (12571) واللفظ له، وابن أبي شيبة (26874)، وأبو يعلى (3058)","bab":"مناقب وفضائل › بعض من شهد النبي بأنهم من أهل الجنة","dorar":"8rUcanAq","merged":7,"otherRefs":["تخريج المسند لشاكر 15/185 (صحيح)","الجامع الصغير 6194 (حسن)","صحيح مسلم 1914 (صحيح)","صحيح الترغيب 2976 (صحيح)","تخريج المسند لشعيب 13410 (صحيح)"]},{"id":"س-06780","fp":"75eeb2a639e5","stateId":708,"easy":"إذا رفقت بالضعيف وأشفقت على والديك وأحسنت إلى المملوك ← ينشر الله عليك كنفه ويدخلك الجنة","cause":"الرِّفْقُ بالضعيفِ ، والشفقةُ على الوالدينِ ، والإحسانُ إلى المملوكِ","result":"نَشَرَ اللهُ عليه كَنَفَه ، وأَدخله الجنةَ","explicit":true,"otherNeedIds":[42],"ref":"سنن الترمذي 2494","srcLabel":"الترمذي","text":["ثلاثٌ مَن كُنَّ فيه ، ",["نَشَرَ اللهُ عليه كَنَفَه ، وأَدخله الجنةَ",2]," : ",["الرِّفْقُ بالضعيفِ ، والشفقةُ على الوالدينِ ، والإحسانُ إلى المملوكِ",1]," ."],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"حسن غريب","takhrij":"أخرجه الترمذي (2494) واللفظ له، والديلمي في ((الفردوس)) (2453) باختلاف يسير.","bab":"عتق وولاء › الإحسان إلى العبيد","dorar":"obw6HsnX"},{"id":"س-07062","fp":"e3a98e101615","stateId":708,"easy":"إذا كنت محسناً ← تدخل الجنة","cause":"كُنْ مُحسِنًا","result":"عَمَلٍ إذا أنا عَمِلتُ به دَخَلتُ الجَنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"المستدرك على الصحيحين 1417","srcLabel":"البيهقي","text":["جاء رَجُلٌ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: يا رَسولَ اللهِ، دُلَّني على ",["عَمَلٍ إذا أنا عَمِلتُ به دَخَلتُ الجَنَّةَ",2],". قالَ: ",["كُنْ مُحسِنًا",1]," قالَ: كيف أعلَمُ أنِّي مُحسِنٌ؟ قالَ: سَلْ جيرانَكَ، فإنْ قالوا: إنَّكَ مُحسِنٌ؛ فأنت مُحسِنٌ، وإنْ قالوا: إنَّكَ مُسيءٌ؛ فأنت مُسيءٌ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه البيهقي في ((الشعب)) (9120)، وقوام السنة في ((الترغيب والترهيب)) (871)، والويزر ابن الجراح في ((حديثه)) (121) واللفظ لهم.","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"MlJdVu4G"},{"id":"س-00237","fp":"85d790f3437b","stateId":709,"easy":"إذا لزمت الصدق ← يهديك إلى البر ثم إلى الجنة","cause":"علَيكُم بالصِّدقِ","result":"فإنَّ الصِّدقَ يَهدي إلى البِرِّ، وإنَّ البِرَّ يَهدي إلى الجَنَّةِ، وما يَزالُ الرَّجُلُ يَصدُقُ ويَتَحَرَّى الصِّدقَ حتَّى يُكتَبَ عِندَ اللهِ صِدِّيقًا، وإيَّاكُم والكَذِبَ؛ فإنَّ الكَذِبَ يَهدي إلى الفُجورِ","explicit":true,"star":true,"similar":["س-00316","س-00198"],"otherNeedIds":[15],"ref":"صحيح مسلم 2607","srcLabel":"متفق عليه","text":[["علَيكُم بالصِّدقِ؛ ",1],["فإنَّ الصِّدقَ يَهدي إلى البِرِّ، وإنَّ البِرَّ يَهدي إلى الجَنَّةِ، وما يَزالُ الرَّجُلُ يَصدُقُ ويَتَحَرَّى الصِّدقَ حتَّى يُكتَبَ عِندَ اللهِ صِدِّيقًا، وإيَّاكُم والكَذِبَ؛ فإنَّ الكَذِبَ يَهدي إلى الفُجورِ،",2]," وإنَّ الفُجورَ يَهدي إلى النَّارِ، وما يَزالُ الرَّجُلُ يَكذِبُ ويَتَحَرَّى الكَذِبَ حتَّى يُكتَبَ عِندَ اللهِ كَذَّابًا. بهذا الإسنادِ، لَم يَذكُرْ في حَديثِ عيسى: ويَتَحَرَّى الصِّدقَ، ويَتَحَرَّى الكَذِبَ. وفي حَديثِ ابنِ مُسهرٍ: حتَّى يَكتُبَه اللهُ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6094)، ومسلم (2607).","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"tEl1hnq3","merged":2,"otherRefs":["صحيح الأدب المفرد 298 (صحيح)"]},{"id":"س-00316","fp":"e4b7a586b9e8","stateId":709,"easy":"إذا تحريت الصدق ← يهديك إلى البر والبر إلى الجنة","cause":"إنَّ الصِّدقَ برٌّ","result":"وإنَّ البِرَّ يَهدي إلى الجَنَّةِ، وإنَّ العَبدَ لَيَتَحَرَّى الصِّدقَ حتَّى يُكتَبَ عِندَ اللهِ صِدِّيقًا","explicit":true,"repOf":"س-00237","otherNeedIds":[47],"ref":"صحيح مسلم 2607","text":[["إنَّ الصِّدقَ برٌّ",1],"، ",["وإنَّ البِرَّ يَهدي إلى الجَنَّةِ، وإنَّ العَبدَ لَيَتَحَرَّى الصِّدقَ حتَّى يُكتَبَ عِندَ اللهِ صِدِّيقًا",2],"، وإنَّ الكَذِبَ فُجورٌ، وإنَّ الفُجورَ يَهدي إلى النَّارِ، وإنَّ العَبدَ لَيَتَحَرَّى الكَذِبَ حتَّى يُكتَبَ كَذَّابًا."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6094) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"iOeH5RT5"},{"id":"س-04188","fp":"64dfa58e191f","stateId":709,"easy":"إذا حفظت ما بين لحييك وما بين رجليك ← يتوكل لك النبي ﷺ بالجنة","cause":"مَن يَتَوَكَّلْ لي ما بين لَحْيَيْهِ ، وما بين رِجْلَيْهِ","result":"أَتَوَكَّلْ له الجنةَ","explicit":true,"star":true,"similar":["س-04283","س-02807","س-04282"],"ref":"صحيح الجامع 6605","srcLabel":"البخاري","text":[["مَن يَتَوَكَّلْ لي ما بين لَحْيَيْهِ ، وما بين رِجْلَيْهِ ، ",1],["أَتَوَكَّلْ له الجنةَ",2]],"grade":"صحيح","narrator":"سهل بن سعد الساعدي","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6474)، والترمذي (2408)، وأحمد (22823) واللفظ لهم.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"3OE9N3m8"},{"id":"س-05307","fp":"138826c865ba","stateId":709,"easy":"إذا لزمت الصدق ← فهو في الجنة","cause":"وعليكم بالصِّدقِ","result":"فإنَّهُ في الجنَّةِ","explicit":true,"star":true,"similar":["س-05375","س-02676"],"ref":"تخريج المسند لشاكر 1/38","srcLabel":"البخاري","text":["[عن] أوسط البجلي عن أبي بَكْرٍ الصِّدِّيقِ رضيَ اللَّهُ عنهُ قالَ : سَمِعْتُهُ يخطبُ النَّاسَ ، وقالَ مرَّةً : حينَ استُخْلِفَ فقالَ: رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قامَ عامَ الأوَّلِ مقامي هذا وبَكَى أبو بَكْرٍ ، رضيَ اللَّهُ عنهُ ، فقالَ : أسألُ اللَّهَ العفوَ والعافيةَ ، فإنَّ النَّاسَ لم يُعطَوا بعدَ اليقينِ شيئًا خيرًا منَ العافيةِ ، ",["وعليكم بالصِّدقِ",1]," ، ",["فإنَّهُ في الجنَّةِ",2]," ، وإيَّاكم والكَذِبَ ، فإنَّهُ معَ الفُجورِ ، وَهُما في النَّارِ ، ولا تَقاطَعوا ولا تباغَضوا ، ولا تحاسَدوا ، ولا تدابَروا ، وَكونوا إخوانًا كما أمرَ اللَّهُ عزَّ وجلَّ"],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (3849)، والبخاري في ((الأدب المفرد)) (724) باختلاف يسير.","bab":"رقائق وزهد › التوكل واليقين","dorar":"JsBQJgjg"},{"id":"س-05375","fp":"19b937229832","stateId":709,"easy":"إذا لزمت الصدق والبر ← فهما في الجنة","cause":"لم يُقسَمْ بَيْنَ النَّاسِ أفضَلُ مِنَ المعافاةِ بَعْدَ اليقينِ","result":"ألَا إنَّ الصِّدقَ والبِرَّ في الجنَّةِ، ألَا وإنَّ الكَذِبَ والفُجورَ في النَّارِ","explicit":true,"repOf":"س-05307","ref":"الأحاديث المختارة 1","text":["أن عمر بن الخطاب قال: «إنَّ أبا بكرٍ قام فينا خَطيبًا، فقال: إنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم قامَ فينا عامَ أوَّلَ، فقال: إنَّه ",["لم يُقسَمْ بَيْنَ النَّاسِ أفضَلُ مِنَ المعافاةِ بَعْدَ اليقينِ،",1]," ",["ألَا إنَّ الصِّدقَ والبِرَّ في الجنَّةِ، ألَا وإنَّ الكَذِبَ والفُجورَ في النَّارِ»",2],"."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › التوكل واليقين","dorar":"1LdJqJPV"},{"id":"س-00198","fp":"661d79145eea","stateId":709,"easy":"إذا صدقت ← فالصدق يهدي إلى البر","cause":"وإِنَّ الصدقَ","result":"يهدي إلى البرِ","explicit":true,"repOf":"س-00237","otherNeedIds":[15],"ref":"الجامع الصغير 2591","text":["إِنَّما هما اثنتانِ الكلامُ والهديُ ، فأحسنُ الكلامِ كلامُ اللهِ ، وأحسنُ الهدْيِ هديُ محمدٍ ، ألَا وإيَّاكم ومحدَثاتِ الأمورِ ، فإِنَّ شرَّ الأمورِ مُحْدَثاتُها ، وكُلَّ محدَثَةٍ بدعةٌ ، وكُلَّ بِدْعَةٍ ضلالَةٌ ، ألَا لَا يَطولَنَّ عليكم الأمَدُ فتقسو قلوبُكُم ، ألَا إِنَّ كُلَّ ما هو آتٍ قريبٌ ، وإِنَّما البعيدُ ما ليس بآتٍ ، ألَا إِنَّما الشَّقِيُّ مَنْ شقِيَ في بطنِ أُمِّهِ ، والسعيدُ مَنْ وُعِظَ بِغَيْرِهِ ، ألَا إِنَّ قتالَ المؤمِنِ كفْرٌ ، وسبابَهُ فسوقٌ ، ولَا يَحِلُ لمسلِمٍ أنْ يهجُرَ أخاهُ فوقَ ثلاثٍ ، ألَا وإيَّاكم والكذبَ ، فإِنَّ الكذبَ لا يصلُحُ لَا بالجدِّ ، ولَا بالْهَزْلِ ، ولَا يعِدُ الرجلُ صَبِيَّهُ ولَا يفِي ، وإِنَّ الكذِبَ يهدِي إلى الفجورِ ، وإِنَّ الفجورَ يهدي إلى النارِ ، ",["وإِنَّ الصدقَ",1]," ",["يهدي إلى البرِ",2]," ، وإِنَّ البرَّ يهدي إلى الجنَّةِ ، وإِنَّه يقالُ للصادقِ : صدقَ وبَرَّ ، ويقالُ للكاذِبِ : كذَبَ وفجرَ ، ألَا وإِنَّ العبدَ يكذِبُ حتى يُكْتَبَ عندَ اللهِ كذابًا"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (46) واللفظ له، والطبراني (9/99) (8520) باختلاف يسير، والبيهقي في ((شعب الإيمان)) (4787) مختصراً باختلاف يسير","bab":"آداب الكلام › الصدق وما جاء فيه","dorar":"UhkJzNNf","merged":8,"otherRefs":["تخريج مشكل الآثار 453 (صحيح)","الأحاديث المختارة 67 (صحيح)","شفاء العليل 1/105 (صحيح)","المستدرك على الصحيحين 445 (صحيح)","تخريج المسند لشاكر 1/31 (صحيح)","تخريج المسند لشاكر 1/41 (صحيح)","صحيح الأدب المفرد 557 (صحيح)"]},{"id":"ق-0344","fp":"f252dbc168c8","stateId":709,"easy":"الصدق ← جنات ورضا الله والفوز العظيم","cause":"الصدق","result":"جنات ورضا الله والفوز العظيم","explicit":true,"otherNeedIds":[23,53],"ref":"سورة المائدة: 119","srcLabel":"القرآن الكريم","quran":{"s":5,"from":119,"to":119,"text":"قَالَ اللَّهُ هَذَا يَوْمُ يَنْفَعُ الصَّادِقِينَ صِدْقُهُمْ لَهُمْ جَنَّاتٌ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا أَبَدًا رَضِيَ اللَّهُ عَنْهُمْ وَرَضُوا عَنْهُ ذَلِكَ الْفَوْزُ الْعَظِيمُ (119)","hl":[[14,206,1]]}},{"id":"س-04283","fp":"eb747cac4737","stateId":709,"easy":"إذا حفظت ما بين لحييك ورجليك ← تدخل الجنة","cause":"من حفِظ ما بين لَحْيَيْه و رِجلَيْه","result":"دخل الجنَّةَ","explicit":true,"repOf":"س-04188","ref":"صحيح الجامع 140","text":["اثنتانِ تُدخِلانِ الجنَّةَ : ",["من حفِظ ما بين لَحْيَيْه و رِجلَيْه ",1],["دخل الجنَّةَ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الخرائطي في ((مساوئ الأخلاق)) (479)، وأبو يعلى في ((المسند)) (4685) واللفظ لهما.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"CiFNBpPF","merged":3,"otherRefs":["صحيح الجامع 6593 (صحيح)","النوافح العطرة 375 (صحيح)"]},{"id":"س-00199","fp":"b21f924f799c","stateId":709,"easy":"إذا بررت ← فالبر يهدي إلى الجنة","cause":"وإِنَّ البرَّ","result":"يهدي إلى الجنَّةِ","explicit":true,"ref":"الجامع الصغير 2591","srcLabel":"ابن ماجه","text":["إِنَّما هما اثنتانِ الكلامُ والهديُ ، فأحسنُ الكلامِ كلامُ اللهِ ، وأحسنُ الهدْيِ هديُ محمدٍ ، ألَا وإيَّاكم ومحدَثاتِ الأمورِ ، فإِنَّ شرَّ الأمورِ مُحْدَثاتُها ، وكُلَّ محدَثَةٍ بدعةٌ ، وكُلَّ بِدْعَةٍ ضلالَةٌ ، ألَا لَا يَطولَنَّ عليكم الأمَدُ فتقسو قلوبُكُم ، ألَا إِنَّ كُلَّ ما هو آتٍ قريبٌ ، وإِنَّما البعيدُ ما ليس بآتٍ ، ألَا إِنَّما الشَّقِيُّ مَنْ شقِيَ في بطنِ أُمِّهِ ، والسعيدُ مَنْ وُعِظَ بِغَيْرِهِ ، ألَا إِنَّ قتالَ المؤمِنِ كفْرٌ ، وسبابَهُ فسوقٌ ، ولَا يَحِلُ لمسلِمٍ أنْ يهجُرَ أخاهُ فوقَ ثلاثٍ ، ألَا وإيَّاكم والكذبَ ، فإِنَّ الكذبَ لا يصلُحُ لَا بالجدِّ ، ولَا بالْهَزْلِ ، ولَا يعِدُ الرجلُ صَبِيَّهُ ولَا يفِي ، وإِنَّ الكذِبَ يهدِي إلى الفجورِ ، وإِنَّ الفجورَ يهدي إلى النارِ ، وإِنَّ الصدقَ يهدي إلى البرِ ، ",["وإِنَّ البرَّ",1]," ",["يهدي إلى الجنَّةِ",2]," ، وإِنَّه يقالُ للصادقِ : صدقَ وبَرَّ ، ويقالُ للكاذِبِ : كذَبَ وفجرَ ، ألَا وإِنَّ العبدَ يكذِبُ حتى يُكْتَبَ عندَ اللهِ كذابًا"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (46) واللفظ له، والطبراني (9/99) (8520) باختلاف يسير، والبيهقي في ((شعب الإيمان)) (4787) مختصراً باختلاف يسير","bab":"آداب الكلام › الصدق وما جاء فيه","dorar":"UhkJzNNf","merged":2,"otherRefs":["المستدرك على الصحيحين 445 (صحيح)"]},{"id":"س-00202","fp":"8639a69f71e0","stateId":709,"easy":"إذا تركت الكذب وإن كنت مازحاً ← لك بيت في وسط الجنة","cause":"لِمَن ترَك الكذِبَ وإنْ كان مازحًا","result":"وببَيْتٍ في وسَطِ الجنَّةِ","explicit":true,"ref":"مدارج السالكين 3/72","srcLabel":"الطبراني","text":["أنا زعيمٌ ببَيْتٍ في ربَضِ الجنَّةِ لِمَن ترَك المِراءَ وإنْ كان مُحِقًّا، ",["وببَيْتٍ في وسَطِ الجنَّةِ",2]," ",["لِمَن ترَك الكذِبَ وإنْ كان مازحًا",1],"، وببَيْتٍ في أعلى الجنَّةِ لِمَن حَسُنَ خُلُقُه."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي خيثمة في ((التاريخ الكبير-السفر الثاني)) (3946)، والطبراني في ((المعجم الأوسط)) (878) باختلاف يسير.","bab":"آداب الكلام › المزاح والمداعبة","dorar":"S83ffKYC","merged":2,"otherRefs":["صحيح الجامع 1464 (حسن)"]},{"id":"س-02808","fp":"fd00621a68df","stateId":709,"easy":"إذا حفظت فرجك ← فلك الجنة","cause":"مَنْ حَفِظَ فَرْجَهُ","result":"فَلَهُ الجنَّةُ","explicit":true,"ref":"مجمع الزوائد 4/255","srcLabel":"الطبراني","text":["يا شبابَ قريشٍ لا تَزْنُوا احْفَظُوا فُروجَكُمْ ألَا ",["مَنْ حَفِظَ فَرْجَهُ ",1],["فَلَهُ الجنَّةُ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (1534)، والبزار (4729) واللفظ له، والطبراني (12/165) (12776)","bab":"إيمان › الوعد","dorar":"gSGcCe9T","merged":2,"otherRefs":["الترغيب والترهيب 3/268 (صحيح)"]},{"id":"س-00194","fp":"242d8dcdb107","stateId":709,"easy":"إذا صدقت ووفيت وأديت الأمانة وحفظت فرجك وغضضت بصرك وكففت يدك ← يضمن لك النبي ﷺ الجنة","cause":"اصْدُقُوا إذا حَدَّثْتُمْ ، وأوْفُوا إذا وعَدْتُمْ ، وأَدُّوا الأمانةَ إذا ائتُمِنْتُمْ ، واحْفَظُوا فُرُوجَكُمْ ، وغُضُّوا أَبْصارَكُمْ ، وكُفُّوا أَيْدِيَكُمْ","result":"أَضْمَنْ لَكُمْ الجنةَ","explicit":true,"ref":"صحيح الترغيب 1901","srcLabel":"أحمد","text":["اضْمَنُوا لي سِتًّا من أنْفُسِكُمْ ",["أَضْمَنْ لَكُمْ الجنةَ",2]," : ",["اصْدُقُوا إذا حَدَّثْتُمْ ، وأوْفُوا إذا وعَدْتُمْ ، وأَدُّوا الأمانةَ إذا ائتُمِنْتُمْ ، واحْفَظُوا فُرُوجَكُمْ ، وغُضُّوا أَبْصارَكُمْ ، وكُفُّوا أَيْدِيَكُمْ",1]," ."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (22809)، وابن أبي الدنيا في ((مكارم الأخلاق)) (116)، وابن حبان (271).","bab":"آداب الكلام › الصدق وما جاء فيه","dorar":"t6EKnxGe"},{"id":"س-02676","fp":"e71575b33744","stateId":709,"easy":"إذا لزمت الصدق والبر ← فهما في الجنة","cause":"سَلُوا اللهَ المُعافاةَ -أو قال: العافيةَ- فلم يُؤتَ أحدٌ قطُّ بعدَ اليقينِ أفضَلَ مِن العافيةِ -أو المُعافاةِ-، عليكم بالصِّدقِ","result":"فإنَّه مع البِرِّ، وهما في الجنَّةِ، وإيَّاكم والكذبَ؛ فإنَّه مع الفجورِ، وهما في النارِ، ولا تَحاسَدوا، ولا تَباغَضوا، ولا تَقاطَعوا، ولا تَدابَروا، وكونوا إخوانًا كما أمَرَكم اللهُ","explicit":true,"repOf":"س-05307","otherNeedIds":[15],"ref":"تخريج المسند لشعيب 5","text":["خطَبَنا أبو بَكْرٍ، فقال: قام رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ مَقامي هذا عامَ الأوَّلِ، وبكَى أبو بَكْرٍ، فقال أبو بَكْرٍ: ",["سَلُوا اللهَ المُعافاةَ -أو قال: العافيةَ- فلم يُؤتَ أحدٌ قطُّ بعدَ اليقينِ أفضَلَ مِن العافيةِ -أو المُعافاةِ-، عليكم بالصِّدقِ؛ ",1],["فإنَّه مع البِرِّ، وهما في الجنَّةِ، وإيَّاكم والكذبَ؛ فإنَّه مع الفجورِ، وهما في النارِ، ولا تَحاسَدوا، ولا تَباغَضوا، ولا تَقاطَعوا، ولا تَدابَروا، وكونوا إخوانًا كما أمَرَكم اللهُ",2],"."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (3558) مختصراً بنحوه، والنسائي في ((السنن الكبرى)) (10718)، وابن ماجه (3849)، وأحمد (5) واللفظ له","bab":"إيمان › الحب في الله والبغض فيه من الإيمان","dorar":"U3a5bjQR"},{"id":"س-02807","fp":"ff4b97e4f1c9","stateId":709,"easy":"إذا ضمنت للنبي ﷺ ما بين لحييك (اللسان) وما بين رجليك (الفرج) ← يضمن لك الجنة","cause":"مَن ضمِنَ لي ما بينَ لحيَيهِ ورجلَيهِ","result":"ضَمِنْتُ لَهُ علَى اللَّهِ الجنَّةَ","explicit":true,"repOf":"س-04188","ref":"مختصر المقاصد 1046","text":[["مَن ضمِنَ لي ما بينَ لحيَيهِ ورجلَيهِ ",1],["ضَمِنْتُ لَهُ علَى اللَّهِ الجنَّةَ",2]],"grade":"صحيح","narrator":"[جابر بن عبدالله]","muhaddith":"صحيح","takhrij":"أخرجه أبو يعلى (1855)، والطبراني في ((المعجم الأوسط)) (4981) باختلاف يسير، والعسكري كما في ((المواهب اللدنية)) للقسطلاني (2/49) واللفظ له","bab":"إيمان › الوعد","dorar":"wMQMtMu8"},{"id":"س-02816","fp":"40690b606a74","stateId":709,"easy":"إذا بقيت في بيتك لا تغتاب المسلمين ولا تجر عليهم سخطاً ← كنت ضامناً على الله أن يدخلك الجنة","cause":"ورجلٌ في بيتِه لا يغتابُ المسلمين ، ولا يجرُّ إليهم سُخطًا ولا نِقمةً","result":"إلا كان ضامنًا على اللهِ أن يَدخلَ الجنّةَ","explicit":true,"ref":"صحيح الترغيب 2739","srcLabel":"الطبراني","text":["خِصالٌ سِتٌّ ؛ ما من مسلمٍ يموتُ في واحدةٍ منهنَّ ؛ ",["إلا كان ضامنًا على اللهِ أن يَدخلَ الجنّةَ",2]," ، فذكر منها : - ",["ورجلٌ في بيتِه لا يغتابُ المسلمين ، ولا يجرُّ إليهم سُخطًا ولا نِقمةً",1]," ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (3822) مطولاً","bab":"إيمان › الوعد","dorar":"jm1RDah9"},{"id":"س-04222","fp":"61106b525547","stateId":709,"easy":"إذا صدقت ← تبرّ، وإذا بررت آمنت، وإذا آمنت دخلت الجنة","cause":"الصِّدقُ ، وإذا صدَقَ العبدُ بَرَّ ، وإذا بَرَّ آمَنَ","result":"وإذا آمَنَ دخلَ الجنَّةَ","explicit":true,"otherNeedIds":[17],"ref":"تخريج المسند لشاكر 10/126","srcLabel":"أبو يعلى","text":["أنَّ رجلًا جاءَ إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ : يا رسولَ اللَّهِ ما عَملُ الجنَّةِ ؟ قالَ : ",["الصِّدقُ ، وإذا صدَقَ العبدُ بَرَّ ، وإذا بَرَّ آمَنَ",1]," ، ",["وإذا آمَنَ دخلَ الجنَّةَ",2]," ، قالَ : يا رسولَ اللَّهِ ، ما عمَلُ النَّارِ ؟ قالَ : الكذِبُ إذا كذَبَ العبدُ فجَرَ ، وإذا فجرَ كفَرَ ، وإذا كفَرَ دخلَ يعني النَّارَ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو يعلى كما في ((إتحاف الخيرة المهرة)) للبوصيري (6/85) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"DAP2yanO"},{"id":"س-04267","fp":"9509ae14d831","stateId":709,"easy":"إذا صدقت إذا حدثت ووفيت إذا وعدت وأديت إذا ائتمنت ← يتقبل لك النبي ﷺ بالجنة","cause":"إذا حَدَّثَ أحدُكُمْ فَلَا يَكْذِبْ ، وَإذا وَعَدَ فَلَا يُخْلِفْ ، وإذا ائتُمِنَ فلا يَخُنْ ، غُضُّوا أبصارَكُم ، وكُفُّوا أيديَكم ، واحفظُوا فُروجَكم","result":"تَقَبَّلُوا لِي بِسِتٍّ ، أَتَقَبَّلْ لَكُمُ بالجنةِ","explicit":true,"ref":"صحيح الجامع 2978","srcLabel":"الحاكم","text":[["تَقَبَّلُوا لِي بِسِتٍّ ، أَتَقَبَّلْ لَكُمُ بالجنةِ",2]," ، ",["إذا حَدَّثَ أحدُكُمْ فَلَا يَكْذِبْ ، وَإذا وَعَدَ فَلَا يُخْلِفْ ، وإذا ائتُمِنَ فلا يَخُنْ ، غُضُّوا أبصارَكُم ، وكُفُّوا أيديَكم ، واحفظُوا فُروجَكم",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه أبو يعلى (4257)، والحاكم (8067) باختلاف يسير، والخطيب في ((الموضح)) (2/168) واللفظ له","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"ZHoX18PQ"},{"id":"س-04282","fp":"84e93a80d5f6","stateId":709,"easy":"إذا وقاك الله شر ما بين لحييك وما بين رجليك ← تلج الجنة","cause":"من وقاه اللهُ شرَّ اثنَينِ","result":"ولِجَ الجنَّةَ : ما بين لَحْيَيه وما بين رِجلَيْه","explicit":true,"repOf":"س-04188","ref":"صحيح الترغيب 2859","text":["من وقاه اللهُ شرَّ اثنَين ولجَ الجنةَ . . فقال رجلٌ : يا رسولَ اللهِ ! ألا تخبِرُنا ؟ فسكت رسولُ اللهِ ، فأعاد رسولُ اللهِ مقالتَه . فقال الرجلُ : ألا تخبرنا يا رسولَ اللهِ ؟ ثم قال رسولُ اللهِ مثلَ ذلك أيضًا . ثم ذهب الرجلُ يقول مقالتَه ، فأسكتَه رجلٌ إلى جنبِه قال رسولُ اللهِ : ",["من وقاه اللهُ شرَّ اثنَينِ ؛ ",1],["ولِجَ الجنَّةَ : ما بين لَحْيَيه وما بين رِجلَيْه",2]],"grade":"صحيح","narrator":"عطاء بن يسار","muhaddith":"صحيح لغيره","takhrij":"أخرجه مالك (11)، وابن وهب في ((الجامع)) (309) واللفظ لهما","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"NL51U6l0"},{"id":"س-05870","fp":"623b45f1469f","stateId":709,"easy":"إذا لم تقل إلا حقاً ولم تعمل إلا صالحاً ← تدخل الجنة بغير حساب ولا عذاب","cause":"لا تقُلْ بهذا إلا حقًّا وأشار إلى لسانِه ولا تَعمَلْ بهذا إلا صلحًا","result":"تدخُلِ الجنةَ بغيرِ حسابٍ ولا عذابٍ","explicit":true,"ref":"إتحاف الخيرة المهرة 7/455","srcLabel":"ابن أبي شيبة","text":["كنتُ عندَ أبي فجاء رجلٌ  فقال:  إني ما رأيتُ عبدَ اللهِ بنَ عمرٍو أمسِ:  فأخافُ أنْ يكونَ مَقَتَني فأحبُّ أن تَسأَلَه لي عن شيءٍ  قال:  اذهَبْ أنتَ فاستَفتِه قال:  وعبدُ اللهِ قائمٌ بين يدَي فسطاطِه بمِنًى  إذ جاء رجلٌ إلى القصرِ  فأتاه ثم رجَع  قال:  فأخبرنا حين قال:  قلتُ:  يا عبدَ اللهِ بنَ عمرٍو  أفتِني  يا عبدَ اللهِ بنَ عمرٍو  أفتِني  يا عبدَ اللهِ بنَ عمرٍو  أفتِني  قال:  ",["لا تقُلْ بهذا إلا حقًّا  وأشار إلى لسانِه  ولا تَعمَلْ بهذا إلا صلحًا",1],"  ",["تدخُلِ الجنةَ بغيرِ حسابٍ  ولا عذابٍ",2],"  قال:  قلتُ:  قد جوَّزتَ في الفُتيا  قال:  إنَّكَ جئتَ وأنا أريدُ الكعبةَ وقد نُشِر بُردايَ  أو حُلَّتي  وإن قلتَ ذلك  لقد أوتي رسولُ اللهِ صلَّى اللهُ عليه وسلَّم وسطَ أمرِه  فقيل له:  قُمْ فجوِّزْ  فقام فجوَّز مَن قبلَه ومَن بعدَه  قال:  قلتُ:  يا عبدَ اللهِ بنَ عمرٍو  مِن كلِّ ذنبٍ يَقبَلُ اللهُ التوبةَ ؟ قال:  نعَم"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"سنده صحيح","takhrij":"أخرجه ابن أبي شيبة كما في ((إتحاف الخيرة المهرة)) للبوصيري  (1/ 237)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"MrUoWYbG"},{"id":"س-02953","fp":"4afad128c1bb","stateId":709,"easy":"إذا صدقت ← فالصدق عمل الجنة","cause":"الصدقُ","result":"عملُ الجنةِ","explicit":true,"ref":"الجامع الصغير 5599","srcLabel":"أحمد","text":[["عملُ الجنةِ",2]," ",["الصدقُ",1],"، و إذا صدقَ العبدُ برَّ، و إذا برَّ آمنَ، و إذا آمنَ دخلَ الجنةَ، و عملُ النارِ الكذبُ، و إذا كذبَ العبدُ فجرَ، و إذا فجرَ كفرَ، و إذا كفرَ دخلَ النارَ"],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن","takhrij":"أخرجه أحمد (6641) واللفظ له.","bab":"إيمان › الوعيد","dorar":"Bd26lIOj"},{"id":"س-05955","fp":"9df775831824","stateId":709,"easy":"إذا وقاك الله شر لسانك وفرجك ← تدخل الجنة","cause":"حتى إذا كانتِ الثالثةُ أجلَسَه أصْحابُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ","result":"اثْنانِ مَن وَقاهُ اللهُ شَرَّهما دَخَلَ الجَنَّةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 23065","srcLabel":"أحمد","text":["أخبَرَني تَميمُ بنُ يَزيدَ مَولَى بَني زَمْعةَ، عن رَجُلٍ من أصْحابِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ قال: خَطَبَنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ذاتَ يَومٍ، ثم قال: أيُّها النَّاسُ، ثِنْتانِ مَن وَقاهُ اللهُ شَرَّهما دَخَلَ الجَنَّةَ، قال: فقام رَجُلٌ من الأنصارِ، فقال: يا رسولَ اللهِ، لا تُخبِرْناهما، ثم قال: ",["اثْنانِ مَن وَقاهُ اللهُ شَرَّهما دَخَلَ الجَنَّةَ",2],"،",[" حتى إذا كانتِ الثالثةُ أجلَسَه أصْحابُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ",1],"، فقالوا: تَرى رسولَ اللهِ يُريدُ يُبشِّرُنا فتَمنَعُه؟ فقال: إنِّي أخافُ أنْ يَتَّكِلَ النَّاسُ، فقال: ثِنْتانِ مَن وَقاهُ اللهُ شَرَّهما دَخَلَ الجَنَّةَ؛ ما بيْنَ لَحْيَيهِ، وما بيْنَ رِجْلَيهِ."],"grade":"صحيح","narrator":"رجال من الصحابة","muhaddith":"المرفوع منه صحيح لغيره","takhrij":"أخرجه أحمد (23065) واللفظ له، وابن أبي شيبة في ((المسند)) (932)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"GQ4TeCcG"},{"id":"س-03050","fp":"13dc72815881","stateId":709,"easy":"إذا أمسكت لسانك ← يدخلك الجنة","cause":"أمسِكْ هذا وأشارَ إلى لسانِه","result":"دُلَّني على عَملٍ يُدخلُني الجنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"البحر الزخار 6/273","srcLabel":"مالك","text":["أنَّ رجلًا قال : يا رسولَ اللهِ ، ",["دُلَّني على عَملٍ يُدخلُني الجنَّةَ ،",2]," قال : ",["أمسِكْ هذا وأشارَ إلى لسانِه",1]," ، فأعادَها عليهِ ، فقال : ثَكَلَتْكَ أمُّك ، هل يُكَبُّ النَّاسُ علَى مناخرِهم في النَّارِ إلَّا حصائدُ ألسنتِهِم"],"grade":"حسن","narrator":"كعب بن عمرو","muhaddith":"[فيه] عمرو بن مالك لم نسمع أحداً تابعه، وإسناده حسن، ومتنه غريب","takhrij":"أخرجه الطبراني في ((الأوسط)) (7503) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"JZYuCxx3"},{"id":"س-05223","fp":"4bc25b8e578c","stateId":709,"easy":"إذا سلّم الله لك شبابك ← دخلت الجنة","cause":"من سلَّمَ اللهُ لهُ شبابَه","result":"دخلَ الجنةَ","explicit":true,"ref":"السلسلة الصحيحة 6/441","srcLabel":"البيهقي","text":["يا فتيانَ قُريشٍ ، لا تَزنوا ، فإنهُ ",["من سلَّمَ اللهُ لهُ شبابَه ",1],["دخلَ الجنةَ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[روي] نحوه بسند صحيح","takhrij":"أخرجه الطيالسي (2879)، والبيهقي في ((شعب الإيمان)) (5426)، وقوام السنة في ((الترغيب والترهيب)) (1491)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"WzTR5FSA"},{"id":"س-00344","fp":"9376c4ea94f9","stateId":709,"easy":"إذا عشقت فعففت فمت ← دخلت الجنة (على رواية)","cause":"مَن عَشِقَ فعَفَّ فماتَ","result":"دَخل الجَنَّةَ","explicit":true,"ref":"نشوة السكران 5","srcLabel":"نشوة السكران","text":[["مَن عَشِقَ فعَفَّ فماتَ ",1],["دَخل الجَنَّةَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"i6tmWcZu"},{"id":"س-00201","fp":"0d99e49fcfb6","stateId":710,"easy":"إذا تركت المراء وإن كنت محقاً ← لك بيت في ربض الجنة","cause":"لِمَن ترَك المِراءَ وإنْ كان مُحِقًّا","result":"أنا زعيمٌ ببَيْتٍ في ربَضِ الجنَّةِ","explicit":true,"similar":["س-00243"],"ref":"مدارج السالكين 3/72","srcLabel":"الطبراني","text":[["أنا زعيمٌ ببَيْتٍ في ربَضِ الجنَّةِ",2]," ",["لِمَن ترَك المِراءَ وإنْ كان مُحِقًّا",1],"، وببَيْتٍ في وسَطِ الجنَّةِ لِمَن ترَك الكذِبَ وإنْ كان مازحًا، وببَيْتٍ في أعلى الجنَّةِ لِمَن حَسُنَ خُلُقُه."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي خيثمة في ((التاريخ الكبير-السفر الثاني)) (3946)، والطبراني في ((المعجم الأوسط)) (878) باختلاف يسير.","bab":"آداب الكلام › المزاح والمداعبة","dorar":"S83ffKYC","merged":2,"otherRefs":["صحيح الجامع 1464 (حسن)"]},{"id":"س-00243","fp":"479d8ca36dc0","stateId":710,"easy":"إذا تركت المراء وأنت مبطل ← يُبنى لك بيت في ربض الجنة","cause":"مَن ترَكَ المِراءَ وَهو مُبطِلٌ","result":"بُنيَ لَهُ بيتٌ في رَبَضِ الجنَّةِ","explicit":true,"repOf":"س-00201","ref":"الترغيب والترهيب 1/106","text":[["مَن ترَكَ المِراءَ وَهو مُبطِلٌ ",1],["بُنيَ لَهُ بيتٌ في رَبَضِ الجنَّةِ ",2],"ومَن ترَكَهُ وَهو مُحِقٌّ بُنيَ لَهُ في وسطِها ومَن حسُنَ خُلقُهُ بُنيَ لَهُ في أعلاها"],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (4800)، والدولابي في ((الكنى والأسماء)) (1887)، والطبراني (8/117) (7488) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"hWG3mAib"},{"id":"س-00244","fp":"962124db8fab","stateId":710,"easy":"إذا تركته وأنت محق ← يُبنى لك بيت في وسطها","cause":"ومَن ترَكَهُ وَهو مُحِقٌّ","result":"بُنيَ لَهُ في وسطِها","explicit":true,"ref":"الترغيب والترهيب 1/106","srcLabel":"أبو داود","text":["مَن ترَكَ المِراءَ وَهو مُبطِلٌ بُنيَ لَهُ بيتٌ في رَبَضِ الجنَّةِ ",["ومَن ترَكَهُ وَهو مُحِقٌّ ",1],["بُنيَ لَهُ في وسطِها ",2],"ومَن حسُنَ خُلقُهُ بُنيَ لَهُ في أعلاها"],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (4800)، والدولابي في ((الكنى والأسماء)) (1887)، والطبراني (8/117) (7488) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"hWG3mAib"},{"id":"س-04340","fp":"9909b105bfaf","stateId":710,"easy":"إذا كظمت غيظاً وأنت قادر على إنفاذه ← يدعوك الله يوم القيامة حتى يخيرك من الحور ما شئت","cause":"من كظمَ غيظًا وَهوَ يستطيعُ أن ينفذَه","result":"دعاهُ اللَّهُ يومَ القيامةِ علَى رءوسِ الخلائقِ حتَّى يخيِّرَه في أيِّ الحورِ شاءَ","explicit":true,"similar":["س-04341","س-02838"],"ref":"صحيح الترمذي 2021","srcLabel":"أبو داود","text":[["من كظمَ غيظًا وَهوَ يستطيعُ أن ينفذَه ",1],["دعاهُ اللَّهُ يومَ القيامةِ علَى رءوسِ الخلائقِ حتَّى يخيِّرَه في أيِّ الحورِ شاءَ",2]],"grade":"صحيح","narrator":"معاذ بن أنس","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4777)، والترمذي (2021) واللفظ له، وابن ماجه (4186)، وأحمد (15637).","bab":"جنة › نساء الجنة","dorar":"TljLFCq7"},{"id":"س-04341","fp":"852d33b653ef","stateId":710,"easy":"إذا كتمت غيظاً وأنت قادر على إنفاذه ← يدعوك الله على رؤوس الخلائق حتى يخيرك من الحور","cause":"مَنْ كتَمَ غيظًا ، وهو قادِرٌ علَى أنْ يُنْفِذَهُ","result":"دعاه اللهُ علَى رؤوسِ الخلائِقِ ، حتَّى يخيِّرَهُ مِنَ الحورِ العينِ يُزَوِّجُهُ منها ما يشاءُ","explicit":true,"repOf":"س-04340","ref":"صحيح الجامع 6518","text":[["مَنْ كتَمَ غيظًا ، وهو قادِرٌ علَى أنْ يُنْفِذَهُ ، ",1],["دعاه اللهُ علَى رؤوسِ الخلائِقِ ، حتَّى يخيِّرَهُ مِنَ الحورِ العينِ يُزَوِّجُهُ منها ما يشاءُ",2]],"grade":"صحيح","narrator":"معاذ بن أنس","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4777)، والترمذي (2493)، وابن ماجه (4186)، وأحمد (15637) باختلاف يسير.","bab":"جنة › نساء الجنة","dorar":"GoBwhLf1"},{"id":"س-05214","fp":"81b49864f2d8","stateId":710,"easy":"إذا لم تغضب ← فلك الجنة","cause":"لا تغضبْ","result":"ولَكَ الجنَّةُ","explicit":true,"similar":["س-05860"],"ref":"صحيح الجامع 7374","srcLabel":"الطبراني","text":[["لا تغضبْ",1]," ، ",["ولَكَ الجنَّةُ",2]," [يعني حديث: قُلْتُ يا رسولَ اللهِ دُلَّني على عملٍ يُدخِلُني الجنَّةَ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم لا تغضَبْ ولك الجنَّةُ]"],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (2353) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (6/168)، والخطيب في ((الموضح)) (2/412) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"vt9rUzxZ"},{"id":"س-00261","fp":"00c22b9f6619","stateId":710,"easy":"إذا كنت سمحاً في البيع والشراء والقضاء والاقتضاء ← تدخل الجنة","cause":"كان رجُلٌ سَمْحًا بائعًا ومُبتاعًا، وقاضيًا ومُقتضِيًا","result":"فدخَلَ الجنَّةَ","explicit":true,"ref":"تخريج المسند لشعيب 414","srcLabel":"النسائي","text":[["كان رجُلٌ سَمْحًا بائعًا ومُبتاعًا، وقاضيًا ومُقتضِيًا",1],"، ",["فدخَلَ الجنَّةَ",2],"."],"grade":"حسن","narrator":"عثمان بن عفان","muhaddith":"حسن لغيره","takhrij":"أخرجه النسائي (4696)، وابن ماجه (2202)، وأحمد (414) واللفظ له","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"3ZsOJNFx"},{"id":"س-02670","fp":"89815524e65f","stateId":710,"easy":"إذا تنازلت عن حقك لأخيك ← لك بها نخلة في الجنة","cause":"أعطِها إيَّاهُ","result":"بنخلةٍ في الجنَّةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الصحيح المسند 32","srcLabel":"أحمد","text":["أنَّ رجلًا قالَ : يا رسولَ اللَّهِ: إنَّ لفُلانٍ نَخلةً ، وأَنا أقيمُ حائطي بِها ، فأمرهُ أن يُعْطيَني حتَّى أقيمَ حائطي بِها ، فقالَ لَهُ النَّبيُّ صلَّى اللَّهُ عليهِ وعلى آلِهِ وصحبِهِ وسلَّمَ: ",["أعطِها إيَّاهُ",1]," ",["بنخلةٍ في الجنَّةِ",2]," فأبى ، فأتاهُ أبو الدَّحداحِ فقالَ: بِعني نخلتَكَ بحائطي. ففعلَ ، فأتى النَّبيَّ صلَّى اللَّهُ عليهِ وعلى آلِهِ وصحبِهِ وسلَّمَ فقالَ: يا رسولَ اللَّهِ ، إنِّي قدِ ابتَعتُ النَّخلةَ بحائطي. قالَ: فاجعَلها لَهُ ، فقد أعطيتُكَها. فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وعلى آلِهِ وصحبِهِ وسلَّمَ: كَم مِن عذقٍ رَداحٍ لأبي الدَّحداحِ في الجنَّةِ قالَها مرارًا. قالَ: فأتى امرأتَهُ فقالَ: يا أمَّ الدَّحداحِ اخرُجي منَ الحائطِ ، فقد بعتُهُ بنخلةٍ في الجنَّةِ. فقالَت: ربحَ البيعُ. أو كلِمةً تشبِهُها ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه أحمد (3/146)، وعبد بن حميد في ((المنتخب)) (2/296)، وابن حبان (16/113) باختلاف يسير.","bab":"إيمان › الاحتساب والنية","dorar":"BWcpOQ9V"},{"id":"س-02838","fp":"d4cb20ec0f7d","stateId":710,"easy":"إذا كظمت غيظك وأنت قادر على الانتصار ← يدعوك الله على رؤوس الخلائق ويخيرك من الحور ما شئت","cause":"مَن كَظَمَ غَيْظَه وهو يَقدِرُ على أنْ يَنتصِرَ","result":"دَعاهُ اللهُ تبارَك وتعالَى على رؤوسِ الخَلائقِ حتى يُخَيِّرَه في حُورِ العِينِ أيَّتِهِنَّ شاءَ","explicit":true,"repOf":"س-04340","ref":"تخريج المسند لشعيب 15619","text":[["مَن كَظَمَ غَيْظَه وهو يَقدِرُ على أنْ يَنتصِرَ، ",1],["دَعاهُ اللهُ تبارَك وتعالَى على رؤوسِ الخَلائقِ حتى يُخَيِّرَه في حُورِ العِينِ أيَّتِهِنَّ شاءَ، ",2],"ومَن تَرَكَ أنْ يَلبَسَ صالحَ الثيابِ وهو يَقدِرُ عليه؛ تواضُعًا للهِ تبارَك وتعالَى؛ دَعاهُ اللهُ تبارَك وتعالَى على رؤوسِ الخَلائقِ حتى يُخَيِّرَه اللهُ تعالى في حُلَلِ الإيمانِ أيَّتِهِنَّ شاءَ."],"grade":"حسن","narrator":"معاذ بن أنس","muhaddith":"حسن","takhrij":"أخرجه الترمذي (2481) مختصراً، وأحمد (15619) واللفظ له","bab":"إيمان › الوعد","dorar":"fubnIFV0"},{"id":"س-08020","fp":"6e3302097f0f","stateId":710,"easy":"إذا عفوت عن أخيك ← يقول الله: خذ بيد أخيك فأدخله الجنة","cause":"بعَفوِك عن أخيكَ","result":"فخُذْ بيَدِ أخيكَ فأدْخِلْه الجنَّةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[41],"ref":"المستدرك على الصحيحين 8944","srcLabel":"البيهقي","text":["بيْنا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ جالسٌ، إذ رَأيناهُ ضَحِك حتَّى بَدَت ثَناياهُ، فقال له عُمرُ: ما أضْحَكَكَ يا رَسولَ اللهِ، بأبي أنتَ وأُمِّي؟ قال: رجُلانِ مِن أُمَّتي جَثَيَا بيْن يَدَي ربِّ العِزَّةِ، فقال أحدُهما: يا ربِّ، خُذْ لي مَظْلَمتي مِن أخي، فقال اللهُ تَباركَ وتعالَى للطَّالبِ: فكيْف تَصنَعُ بأخيكَ ولم يَبْقَ مِن حَسَناتِه شَيءٌ؟ قال: يا ربِّ، فلْيَحمِلْ مِن أوْزاري، قال: وفاضَتْ عَيْنا رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ بالبُكاءِ، ثمَّ قال: إنَّ ذاك اليومَ عَظيمٌ، يَحتاجُ النَّاسُ أنْ يُحمَلَ عنْهم مِن أوزارِهم، فقال اللهُ تعالَى للطَّالبِ: ارفَعْ بَصَرَك فانْظُرْ في الجِنانِ، فرَفَع رأْسَه، فقال: يا ربِّ، أرى مَدائنَ مِن ذهَبٍ، وقُصورًا مِن ذهَبٍ مُكلَّلةً باللُّؤلؤِ، لأيِّ نَبيٍّ هذا، أو لأيِّ صدِّيقٍ هذا، أو لأيِّ شَهيدٍ هذا؟ قال: هذا لمَن يُعطي الثَّمنَ، قال: يا ربِّ، ومَن يَملِكُ ذلكَ؟ قال: أنتَ تَملِكُه، قال: بماذا؟ قال: ",["بعَفوِك عن أخيكَ",1],"، قال: يا ربِّ، فإنِّي قدْ عفَوتُ عنه، قال اللهُ عزَّ وجلَّ: ",["فخُذْ بيَدِ أخيكَ فأدْخِلْه الجنَّةَ",2],"، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ عِندَ ذلكَ: اتَّقُوا اللهَ وأصْلِحوا ذاتَ بيْنِكم؛ فإنَّ اللهَ تعالَى يُصلِحُ بيْن المسْلِمين."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح الإسناد ولم يخرجاه","takhrij":"أخرجه البيهقي في ((البعث والنشور)) (393)، وابن أبي الدنيا في ((حسن الظن)) (118) بنحوه، والخرائطي في ((مساوئ الأخلاق )) (602) مختصرا","bab":"مظالم › تحريم الظلم","dorar":"4IyacTvF"},{"id":"س-06978","fp":"91e1bc701e3b","stateId":710,"easy":"إذا تركت حقك في الخصومة ← فلك الجنة","cause":"فمَن ترَكَها","result":"فله الجَنَّةُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج سنن الدارقطني 4342","srcLabel":"البيهقي","text":["أنَّه أتَى رَجُلانِ يَختَصِمانِ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم في أرضٍ، فقال أحَدُهما: هي لي، وقال الآخَرُ: هي لي حُزتُها فقَبَضتُها، فقال: فيها اليَمينُ للَّذي بيَدِه الأرضُ، فلمَّا تَفوَّهَ لِيَحلِفَ، قال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أمَا إنَّه مَن حلَفَ على مالِ امرئٍ مُسلِمٍ، لَقِيَ اللهَ عزَّ وجلَّ وهو عليه غَضبانُ، قال: ",["فمَن ترَكَها",1],"؟ قال: ",["فله الجَنَّةُ",2],"."],"grade":"صحيح","narrator":"عدي","muhaddith":"صحيح","takhrij":"أخرجه الدارقطني (4342) بهذا اللفظ وأخرجه الطحاوي في ((شرح مشكل الآثار)) (4478) والبيهقي (21253) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"J3LJS2Ia"},{"id":"س-05860","fp":"e308c116178f","stateId":710,"easy":"إذا لم تغضب ← يدخلك الجنة","cause":"لا تغضَبْ","result":"علِّمْني عملًا يُدخِلُني الجنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-05214","ref":"مجمع الزوائد 8/73","text":["أنَّه قال يا رسولَ اللهِ ",["علِّمْني عملًا يُدخِلُني الجنَّةَ",2]," ولا تُكثِرْ عليَّ قال ",["لا تغضَبْ",1]],"grade":"حسن","narrator":"بعض أصحاب النبي صلى الله عليه وسلم","muhaddith":"[فيه] صالح عن الأعمش ولم أعرف صالحا هذا وبقية رجاله ثقات","bab":"رقائق وزهد › الوصايا النافعة","dorar":"6m1uaslk"},{"id":"س-05719","fp":"b2a5d976fc26","stateId":711,"easy":"إذا فارقت الروح جسدك وأنت بريء من الكبر والغلول والدين ← فأنت في الجنة","cause":"مَن فارَقَ الرُّوحُ الجَسدَ وهو بَريءٌ مِن ثَلاثٍ: الكِبرِ، والغُلولِ، والدَّينِ","result":"فهو في الجنَّةِ -أو وَجَبَتْ له الجنَّةُ","explicit":true,"star":true,"similar":["س-05730"],"ref":"تخريج المسند لشعيب 22390","srcLabel":"مسلم","text":[["مَن فارَقَ الرُّوحُ الجَسدَ وهو بَريءٌ مِن ثَلاثٍ: الكِبرِ، والغُلولِ، والدَّينِ، ",1],["فهو في الجنَّةِ -أو وَجَبَتْ له الجنَّةُ",2],"."],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه الترمذي (1573)، والنسائي في ((السنن الكبرى)) (8764)، وابن ماجه (2412)، وأحمد (22390) واللفظ له","bab":"رقائق وزهد › الكبر والتواضع","dorar":"dG0xA2Kh","merged":2,"otherRefs":["البحر الزخار 10/95 (حسن)"]},{"id":"س-05914","fp":"d4b1839f337f","stateId":711,"easy":"إذا اتقيت الله وحسن خلقك ← فهما أكثر ما يدخل الناس الجنة","cause":"التَّقْوى وحُسْنُ الخُلُقِ","result":"أكثرِ ما يُدخِلُ النَّاسَ الجنَّةَ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 8132","srcLabel":"الترمذي","text":["سُئِلَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ عنْ ",["أكثرِ ما يُدخِلُ النَّاسَ الجنَّةَ",2],"، قالَ: ",["التَّقْوى وحُسْنُ الخُلُقِ",1],"، وسُئِلَ عنْ أكثَرِ ما يُدخِلُ النَّاسَ النَّارَ، فقال: الأجْوفانِ: الفَمُ والفَرْجُ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (2004)، وابن ماجة (4246)، وأحمد (7907) باختلاف يسير.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"NpzBpE76","merged":7,"otherRefs":["صحيح ابن حبان 476 (صحيح)","صحيح ابن ماجه 3443 (حسن)","تخريج المسند لشعيب 9096 (حسن)","تخريج مشكل الآثار 4429 (حسن)","صحيح الأدب المفرد 222 (حسن)","تخريج المسند لشعيب 9696 (حسن)"]},{"id":"س-01166","fp":"55fbb8adb51c","stateId":711,"easy":"إذا لم تجد في نفسك غشاً لمسلم ولم تحسد أحداً ← تبلغ الجنة","cause":"لا أجِدُ في نَفْسي لأحَدٍ مِن المُسلِمينَ غِشًّا، ولا أحْسُدُ أحَدًا على خَيْرٍ أعْطاه اللهُ عَزَّ وجَلَّ إيَّاه","result":"هذه الَّتي بَلَغَتْ بك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[19],"ref":"الأحاديث المختارة 2619","srcLabel":"متفق عليه","text":["«كُنَّا جُلوسًا معَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فقالَ: يَطلُعُ عليكم الآنَ رَجُلٌ مِن أهْلِ الجَنَّةِ، فطَلَعَ رَجُلٌ مِن الأنْصارِ تَنطِفُ لِحْيتُه مِن وَضوئِه، قد تَعلَّقَ نَعْلَيه في يَدِه الشِّمالِ، فلمَّا كانَ الغَدُ قالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ مِثلَ ذلك، فطَلَعَ ذلك الرَّجُلُ مِثلَ المَرَّةِ الأُولى، فلمَّا كانَ اليَوْمُ الثَّالِثُ قالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ مِثلَ مَقالتِه أيضًا، فطَلَعَ ذلك الرَّجُلُ على مِثلِ حالتِه الأُولى، فلمَّا قامَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ تَبِعَه عبْدُ اللهِ بنُ عَمْرِو بنِ العاصِ فقالَ: إنِّي لاحَيْتُ أبي فأقْسَمْتُ ألَّا أدْخُلَ عليه ثَلاثًا، فإن رأَيْتَ أن تُؤْويَني إليكَ حتَّى تَمْضيَ فَعَلْت؟ قالَ: نَعمْ.\nقالَ أنَسٌ: فكانَ عَبْدُ اللهِ يُحَدِّثُ أنَّه باتَ معَه تلك الثَّلاثَ اللَّيالي، فلم يَرَه يَقومُ مِن اللَّيلِ شَيئًا غيْرَ أنَّه إذا تَعارَّ وتَقَلَّبَ على فِراشِه ذَكَرَ اللهَ عَزَّ وجَلَّ وكَبَّرَ حتَّى تَقومَ صَلاةُ الفَجْرِ.\nقالَ عَبْدُ اللهِ: غيْرَ أنِّي لم أسْمَعْه يَقولُ إلَّا خَيْرًا، فلمَّا مَضَتِ الثَّلاثُ وكِدْتُ أن أحْتَقِرَ عَمَلَه، قُلْتُ: يا عَبْدَ اللهِ، لم يكنْ بَيْني وبَيْنَ أبي غَضَبٌ ولا هَجْرٌ، ولكنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ لك ثَلاثَ مَرَّاتٍ: يَطلُعُ عليكم الآنَ رَجُلٌ مِن أهْلِ الجنَّةِ، فطَلَعْتَ أنت الثَّلاثَ المَرَّاتِ، فأرَدْتُ أن آوِيَ إليك لأنْظُرَ ما عَمَلُك فأقْتَدِيَ به، فلم أرَك تَعمَلُ كَبيرَ عَمَلٍ، فما الَّذي بَلَغَ بك ما قالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ؟! قالَ: ما هو إلَّا ما رَأيْتَ، قالَ: فلمَّا وَلَّيْتُ دَعاني فقالَ: ما هو إلَّا ما رأَيْتَ غيْرَ أنِّي ",["لا أجِدُ في نَفْسي لأحَدٍ مِن المُسلِمينَ غِشًّا، ولا أحْسُدُ أحَدًا على خَيْرٍ أعْطاه اللهُ عَزَّ وجَلَّ إيَّاه",1],"، فقالَ عبْدُ اللهِ: ",["هذه الَّتي بَلَغَتْ بك",2],"، وهي الَّتي لا نُطيقُ»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"أدعية وأذكار › فضل الذكر","dorar":"aDdRlVq6"},{"id":"س-02888","fp":"6f8f886d16d7","stateId":711,"easy":"إذا تركت اللباس الفاخر تواضعاً لله وأنت قادر ← يدعوك الله يوم القيامة على رؤوس الخلائق ليختار لك","cause":"مَن ترَكَ اللِّباسَ وهو يَقدِرُ عليهِ تَواضعًا للهِ عزَّ وجلَّ","result":"دَعاهُ اللهُ عزَّ وجلَّ يومَ القِيامةِ على رُؤوسِ الخلائقِ حتَّى يُخيِّرَهُ مِن حُلَلِ الإيمانِ يَلْبَسُ أيُّها شاءَ","explicit":true,"similar":["س-02839"],"ref":"المستدرك على الصحيحين 7576","srcLabel":"أحمد","text":[["مَن ترَكَ اللِّباسَ وهو يَقدِرُ عليهِ تَواضعًا للهِ عزَّ وجلَّ، ",1],["دَعاهُ اللهُ عزَّ وجلَّ يومَ القِيامةِ على رُؤوسِ الخلائقِ حتَّى يُخيِّرَهُ مِن حُلَلِ الإيمانِ يَلْبَسُ أيُّها شاءَ",2],"."],"grade":"صحيح","narrator":"معاذ بن أنس الجهني","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (15619)، والطبراني في ((الأوسط)) (415)،والبيهقي في ((الشعب)) (5741) باختلاف يسير.","bab":"إيمان › الوعد","dorar":"VXgG5K7I","merged":2,"otherRefs":["السلسلة الصحيحة 718 (صحيح)"]},{"id":"س-00297","fp":"533f7907fe4e","stateId":711,"easy":"إذا ملأ الله أذنيك من ثناء الناس خيراً ← فأنت من أهل الجنة","cause":"مَن ملأَ اللَّهُ أذُنَيْهِ من ثَناءِ النَّاسِ خيرًا وَهوَ يسمعُ","result":"أَهْلُ الجنَّةِ","explicit":true,"ref":"مصباح الزجاجة 4/243","srcLabel":"ابن ماجه","text":[["أَهْلُ الجنَّةِ",2]," ",["مَن ملأَ اللَّهُ أذُنَيْهِ من ثَناءِ النَّاسِ خيرًا وَهوَ يسمعُ",1],"، وأَهْلُ النَّارِ من ملأَ أذُنَيْهِ من ثَناءِ النَّاسِ شرًّا وَهوَ يسمَعُ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح رجاله ثقات","takhrij":"أخرجه ابن ماجه (4224) واللفظ له، والطبراني (12/ 170) (12787)، وأبو نعيم في ((حلية الأولياء)) (3/ 80) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"4ipX0kYA"},{"id":"س-05730","fp":"af2f04a89781","stateId":711,"easy":"إذا فارقت روحك جسدك وأنت بريء من الكبر والدين والغلول ← دخلت الجنة","cause":"من فارق الروحُ جسدَه ، و هو بريءٌ من ثلاث","result":"دخل الجنةَ : الكِبْرُ ، و الدَّيْنُ ، و الغُلولُ","explicit":true,"repOf":"س-05719","ref":"صحيح الجامع 6411","text":[["من فارق الروحُ جسدَه ، و هو بريءٌ من ثلاث ",1],["دخل الجنةَ : الكِبْرُ ، و الدَّيْنُ ، و الغُلولُ",2]],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1573)، وابن ماجه (2412)، وأحمد (22369)، والدارمي (2634) واللفظ لهم.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"nkMjCD2B"},{"id":"س-00326","fp":"bf007b8b9409","stateId":711,"easy":"إذا أتيت الله بخلق من أخلاقه المئة والسبعة عشر ← تدخل الجنة","cause":"إنَّ للَّهِ تعالى مِائةَ خُلُقٍ وسبعةَ عشرَ خُلُقًا من أتاهُ بِخُلُقٍ منها","result":"دخلَ الجنَّةَ","explicit":true,"similar":["س-02475"],"ref":"الجامع الصغير (4/ 42)","srcLabel":"الطبراني","text":[["إنَّ للَّهِ تعالى مِائةَ خُلُقٍ وسبعةَ عشرَ خُلُقًا من أتاهُ بِخُلُقٍ منها ",1],["دخلَ الجنَّةَ",2]],"grade":"حسن","narrator":"عثمان بن عفان","muhaddith":"حسن","takhrij":"أخرجه الطيالسي (84)، وابن أبي الدنيا في ((مكارم الأخلاق)) (27)،  ابن عدي في ((الكامل في الضعفاء)) باختلاف يسير، والطبراني في ((مكارم الأخلاق )) (121)، والعقيلي في ((الضعفاء الكبير))  (3/ 54) كلاهما  بنحوه.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"D6b1A5tH"},{"id":"س-01765","fp":"35912b140d0a","stateId":711,"easy":"إذا حسن خلقك ← فهو من أعظم ما يدخلك الجنة","cause":"بحُسنِ الخُلُقِ","result":"لا يدخلُ أحدٌ الجنةَ إلا","explicit":true,"ref":"البداية والنهاية 5/61","srcLabel":"البيهقي","text":["عن عليِّ بنِ أبي طالبٍ قال يا سبحانَ اللهِ ما أزهد كثيرًا من الناسِ في خيرٍ عجبًا لرجلٍ يجيئُه أخوه المسلمُ في الحاجةِ فلا يرى نفسَه للخيرِ أهلًا فلو كان لا يرجو ثوابًا ولا يخشى عقابًا لكان ينبغي له أن يسارعَ في مكارمِ الأخلاقِ فإنها تدل على سبيلِ النجاحِ فقام إليه رجلٌ فقال فداك أبي وأمي يا أميرَ المؤمنين سمعتُه من رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ قال نعم وما هو خيرٌ منه لما أتى بسبايا طيِّءٍ وقفتْ جاريةٌ حمراءُ لعساءُ دلفاءُ عيطاءُ شماءُ الأنفِ معتدلةُ القامةِ والهامةِ درماءُ الكعبَينِ خدلَّةُ الساقَينِ لفَّاءُ الفخِذَينِ خميصةُ الخَصرَينِ ضامرةُ الكشحَينِ مصقولةُ المتْنَينِ قال فلما رأيتُها أعجبتُ بها وقلتُ لأطلبنَّ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يجعلها في فَيْئي فلما تكلمتْ أنسيتُ جمالَها من فصاحتِها فقالت يا محمدُ إن رأيتَ أن تُخلِّيَ عنا ولا تُشمِتْ بنا أحياءَ العربِ فإني ابنةُ سيِّدُ قومي وإنَّ أبي كان يحمي الذِّمارَ ويفكُّ العاني ويشبعُ الجائعَ ويكسو العاريَ ويَقري الضيفَ ويطعمُ الطعامَ ويفشِ السلامَ ولم يردَّ طالبَ حاجةٍ قطُّ أنا ابنةُ حاتمِ طيءٍ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يا جاريةُ هذه صفة المؤمنين حقًّا لو كان أبوك مسلمًا لترحَّمْنا عليه خلُّوا عنها فإنَّ أباها كان يحبُّ مكارمَ الأخلاقِ واللهُ يحبُّ مكارمَ الأخلاقِ فقام أبو بردةَ بنُ نيارٍ فقال يا رسولَ اللهِ تحبُّ مكارمَ الأخلاقِ فقال رسولُ اللهِ والذي نفسي بيده ",["لا يدخلُ أحدٌ الجنةَ إلا",2]," ",["بحُسنِ الخُلُقِ",1]],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"حسن المتن غريب الإسناد جدا عزيز المخرج","takhrij":"أخرجه البيهقي في ((دلائل النبوة)) (5/ 341)، وابن عساكر في ((تاريخ دمشق)) (69/ 202) كلاهما بلفظه، وابن حجر في ((تخريج أحاديث المختصر)) (1/ 197) بنحوه.","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"6JaYGGt1"},{"id":"س-02475","fp":"c01c9a1698ba","stateId":711,"easy":"إذا جئت بخلق من أخلاق الله مع الشهادة ← تدخل الجنة","cause":"من جاء بخُلُقٍ منها مع شهادةِ أنْ لا إلهَ إلَّا اللهُ","result":"دَخَل الجنَّةَ","explicit":true,"repOf":"س-00326","ref":"فيض القدير 2/ 482","text":["إنَّ للهِ عزَّ وجَلَّ لَوحًا من زَبَرجَدةٍ خَضراءَ تحتَ العَرشِ كُتِب فيه: أنا اللهُ لا إلهَ إلَّا أنا أرحَمُ الرَّاحمين، خَلَقتُ بِضعةَ عَشَرَ وثلاثَ مِئةِ خُلُقٍ، ",["من جاء بخُلُقٍ منها مع شهادةِ أنْ لا إلهَ إلَّا اللهُ ",1],["دَخَل الجنَّةَ",2]],"grade":"حسن","muhaddith":"إسناده حسن","bab":"إسلام › فضل الشهادتين","dorar":"2uzqAiDN"},{"id":"س-02839","fp":"5c0087f05751","stateId":711,"easy":"إذا تركت صالح الثياب تواضعاً لله وأنت قادر ← يدعوك الله يوم القيامة ويخيرك من حلل الإيمان","cause":"ومَن تَرَكَ أنْ يَلبَسَ صالحَ الثيابِ وهو يَقدِرُ عليه؛ تواضُعًا للهِ تبارَك وتعالَى","result":"دَعاهُ اللهُ تبارَك وتعالَى على رؤوسِ الخَلائقِ حتى يُخَيِّرَه اللهُ تعالى في حُلَلِ الإيمانِ أيَّتِهِنَّ شاءَ","explicit":true,"repOf":"س-02888","ref":"تخريج المسند لشعيب 15619","text":["مَن كَظَمَ غَيْظَه وهو يَقدِرُ على أنْ يَنتصِرَ، دَعاهُ اللهُ تبارَك وتعالَى على رؤوسِ الخَلائقِ حتى يُخَيِّرَه في حُورِ العِينِ أيَّتِهِنَّ شاءَ، ",["ومَن تَرَكَ أنْ يَلبَسَ صالحَ الثيابِ وهو يَقدِرُ عليه؛ تواضُعًا للهِ تبارَك وتعالَى؛ ",1],["دَعاهُ اللهُ تبارَك وتعالَى على رؤوسِ الخَلائقِ حتى يُخَيِّرَه اللهُ تعالى في حُلَلِ الإيمانِ أيَّتِهِنَّ شاءَ",2],"."],"grade":"حسن","narrator":"معاذ بن أنس","muhaddith":"حسن","takhrij":"أخرجه الترمذي (2481) مختصراً، وأحمد (15619) واللفظ له","bab":"إيمان › الوعد","dorar":"fubnIFV0"},{"id":"س-05399","fp":"1a67de542d3f","stateId":711,"easy":"إذا أحببت لأخيك ما تحب لنفسك ← تدخل الجنة","cause":"فأَحِبَّ لِأخيكَ المُسْلِمِ ما تُحِبُّ لنفسِكَ","result":"أتُحِبُّ الجَنَّةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 7519","srcLabel":"أحمد","text":["عنْ سَيَّارٍ أبي الحَكَمِ، أنَّه شَهِدَ خالِدَ بنَ عبدِ اللهِ القَسْرِيَّ وهو يَخطُبُ على مِنْبَرِ البَصرةِ، وهو يَقولُ: حدَّثَني أبي، عنْ جَدِّي، قالَ: قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا يَزيدُ بنَ أَسَدٍ، ",["أتُحِبُّ الجَنَّةَ",2],"؟ قلْتُ: نعمْ، قالَ: ",["فأَحِبَّ لِأخيكَ المُسْلِمِ ما تُحِبُّ لنفسِكَ",1],"."],"grade":"صحيح","narrator":"[يزيد بن أسد بن كرز القسري]","muhaddith":"صحيح الإسناد","takhrij":"أخرجه عبد الله أحمد في ((زوائد المسند)) (16655)، وابن عساكر في ((تاريخ دمشق)) (33/ 372) باختلاف يسير.","bab":"رقائق وزهد › الحب في الله","dorar":"G0YhOVVr"},{"id":"س-07943","fp":"5994b192b40d","stateId":711,"easy":"إذا تخلقت بمكارم الأخلاق ← فهي من أعمال الجنة","cause":"مكارمُ الأخلاقِ","result":"من أعمالِ الجنَّةِ","explicit":true,"ref":"الترغيب والترهيب 3/334","srcLabel":"الطبراني","text":["دخل عليه قومٌ يعودنه في مرضٍ له فقال يا جاريةُ هلمِّي لأصحابِنا ولو كِسرًا فإنِّي سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ ",["مكارمُ الأخلاقِ",1]," ",["من أعمالِ الجنَّةِ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده جيد","takhrij":"أخرجه ابن الأعرابي في ((المعجم)) (636)، والطبراني في ((المعجم الأوسط)) (6501)، وتمام في ((فوائد تمام)) (1370) واللفظ لهم جميعا.","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"e7zInCIt"},{"id":"س-08387","fp":"bcd282dcd675","stateId":711,"easy":"إذا نمت وليس في قلبك غل على أحد ← تكون من أهل الجنة","cause":"آخُذُ مضجعي ، وليس في قلبي غِمرٌ على أحدٍ","result":"ليطَّلِعنَّ عليكم رجلٌ من هذا البابِ من أهلِ الجنَّةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"time","t":"عند النوم"},"otherNeedIds":[19],"ref":"الترغيب والترهيب 4/33","srcLabel":"ابن حبان","text":["كنَّا جُلوسًا عند رسولِ اللهِ صلَّى اللهُ عليه وسلَّم قال : فقال : ",["ليطَّلِعنَّ عليكم رجلٌ من هذا البابِ من أهلِ الجنَّةِ",2]," ، فجاء سعدُ بنُ مالكٍ فدخل منه . قال البيهقيُّ : فذكر الحديثَ قال : فقال عبدُ اللهِ بنُ عمرٍو رضِي اللهُ عنهما : ما أنا بالَّذي أنتهي حتَّى أُبايِتَ هذا الرَّجلَ ، فأنظرَ عملَه قال : فذكر الحديثَ في دخولِه عليه قال : فناولني عباءةً ، فاضطجعتُ عليها قريبًا منه ، وجعلتُ أرمُقُه بعيني ليلةً كلَّما تعارَّ سبَّح ، وكبَّر ، وهلَّل ، وحمِد اللهَ حتَّى إذا كان في وجهِ السَّحَرِ قام فتوضَّأ ، ثمَّ دخل المسجدَ فصلَّى ثنتَيْ عشرةَ ركعةً باثنتَيْ عشرةَ سورةً من المُفصَّلِ ليس من طِوالِه ، ولا من قِصارِه ، يدعو في كلِّ ركعتَيْن بعد التَّشهُّدِ بثلاثِ دعواتٍ يقولُ : اللَّهمَّ آتِنا في الدُّنيا حسنةً وفي الآخرةِ حسنةً ، وقِنا عذابَ النَّارِ . اللَّهمَّ اكفِنا ما أهمَّنا من أمرِ آخرتِنا ودنيانا . اللَّهمَّ إنَّا نسألُك من الخيرِ كلِّه ، وأعوذُ بك من الشَّرِّ كلِّه حتَّى إذا فرغ قال ، فذكر الحديثَ في استقلالِه عملَه ، وعوْدِه إليه ثلاثًا إلى أن قال : فقال : ",["آخُذُ مضجعي ، وليس في قلبي غِمرٌ على أحدٍ",1]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه البزار (5836) بنحوه دون قول عبدالله بن عمرو، وابن حبان (6991) دون قول عبدالله بن عمرو، والبيهقي في ((شعب الإيمان)) (6607) واللفظ له","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"17AaLCmz"},{"id":"س-06822","fp":"3380a13b008a","stateId":711,"easy":"إذا حسّنت كلامك وبذلت الطعام ← توجب لك الجنة","cause":"عليكَ بحُسنِ الكَلامِ وبَذْلِ الطَّعامِ","result":"أَخبِرْني بأيِّ شيءٍ يوجِبُ لي الجنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"الإلزامات والتتبع 108","srcLabel":"البخاري","text":["أنَّه لَمَّا وَفَدَ إلى رَسولِ اللهِ صلَّى اللهُ عليهِ وآلِه وسلَّم مَع قَومِه سَمِعه يُكنُّونَه بأَبي الحَكَم، فَدَعاه رَسولُ اللهِ صلَّى اللهُ عليهِ وآلِه وسلَّم، فَقال: إنَّ اللهَ هوَ الحَكَمُ، وإليهِ الحُكْمُ، فَلِم تُكنَّى أبا الحَكمِ ؟! فقال: إنَّ قَومي إذا اختَلَفوا في شيءٍ أَتَوْني فحَكَمْتُ بَينَهم، فَرَضي كِلا الفَريقينِ، فَقال رَسولُ اللهِ صلَّى اللهُ عليهِ وآلِه وسلَّم: ما أَحسَن هَذا! فَما لكَ مِنَ الوَلدِ؟ قال: لي شُريحٌ ومُسلمٌ وعَبدُ اللهِ، قال: فَمَن أَكبَرُهُم؟ قال: شُريحٌ، قال: فأَنتَ أبو شُريحٍ. قال شُريحٌ: وأَنا هانِئٌ، لَمَّا حَضَر رُجوعُه إلى بِلادِه أَتى النَّبيَّ صلَّى اللهُ عليهِ وآلِه وسلَّم فَقال: ",["أَخبِرْني بأيِّ شيءٍ يوجِبُ لي الجنَّةَ",2],"؟ قال: ",["عليكَ بحُسنِ الكَلامِ وبَذْلِ الطَّعامِ",1],"."],"grade":"صحيح","narrator":"هانئ بن يزيد بن نهيك أبو شريح","muhaddith":"رجاله رجال الصحيح إلا يزيد بن المقدام وقد قال الحافظ في التقريب أنه صدوق","takhrij":"أخرجه أبو داود (4955)، والنسائي (5387)، والبخاري في ((الأدب المفرد)) (811) باختلاف يسير.","bab":"عقيدة › إثبات أسماء الله","dorar":"DiFShu32","merged":2,"otherRefs":["صحيح الأدب المفرد 623 (صحيح)"]},{"id":"س-00744","fp":"8bff44538c7a","stateId":712,"easy":"إذا سلكت طريقاً تلتمس فيه علماً ← يسهل الله لك به طريقاً إلى الجنة","cause":"وما مِن رَجُلٍ يَسلُكُ طَريقًا يَلتَمِسُ به العِلْمَ","result":"إلَّا سهَّلَ له به -أو سهَّلَ به- طَريقًا [إلى] الجنَّةِ","explicit":true,"star":true,"similar":["س-07089","س-08149","س-02052","س-08139"],"otherNeedIds":[18],"ref":"تخريج المسند لشعيب 9274","srcLabel":"مسلم","text":["ما مِن قَومٍ يَجتمِعون في بَيتٍ مِن بُيوتِ اللهِ عزَّ وجلَّ، يَقْرَؤون ويتَعَلَّمون كِتابَ اللهِ عزَّ وجلَّ، يتَدارَسونه بَينَهم، إلَّا حفَّتْ بهم الملائكةُ، وغشيَتْهم الرَّحمةُ، وذكَرَهم اللهُ فيمَن عِندَه، ",["وما مِن رَجُلٍ يَسلُكُ طَريقًا يَلتَمِسُ به العِلْمَ",1],"، ",["إلَّا سهَّلَ له به -أو سهَّلَ به- طَريقًا [إلى] الجنَّةِ",2],"، ومَن يُبطِئُ به عَمَلُه، لا يُسرِعُ به نَسَبُه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (2699)، والترمذي (2945)، وابن ماجه (225) مطولاً، وأبو داود (1455) مختصراً، وأحمد (9274) واللفظ له","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"n1MoFiZb"},{"id":"س-07089","fp":"9f214c8cb233","stateId":712,"easy":"إذا سلكت طريقاً تطلب فيه علماً ← يسلك الله بك طريقاً من طرق الجنة والملائكة تضع لك أجنحتها","cause":"مَن سلَك طريقًا يطلُبُ فيه عِلمًا","result":"سلَك اللهُ به طريقًا مِن طُرقِ الجنَّةِ والملائكةُ تضَعُ أجنحتَها رضًا لطالبِ العِلمِ وإنَّ العالِمَ يستغفِرُ له","explicit":true,"repOf":"س-00744","otherNeedIds":[24],"ref":"صحيح ابن حبان 88","text":["كُنْتُ جالسًا مع أبي الدَّرداءِ في مسجِدِ دِمَشقَ فأتاه رجُلٌ فقال يا أبا الدَّرداءِ إنِّي أتَيْتُكَ مِن مدينةِ الرَّسولِ في حديثٍ بلَغني أنَّكَ تُحدِّثُه عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقال أبو الدَّرادءِ : أمَا جِئْتَ لحاجةٍ أمَا جِئْتَ لتجارةٍ أمَا جِئْتَ إلَّا لهذا الحديثِ ؟ قال : نَعم قال : فإنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ : ( ",["مَن سلَك طريقًا يطلُبُ فيه عِلمًا ",1],["سلَك اللهُ به طريقًا مِن طُرقِ الجنَّةِ والملائكةُ تضَعُ أجنحتَها رضًا لطالبِ العِلمِ وإنَّ العالِمَ يستغفِرُ له ",2],"مَن في السَّمواتِ ومَن في الأرضِ والحِيتانُ في الماءِ وفَضْلُ العالِمِ على العابِدِ كفضلِ القمرِ ليلةَ البدرِ على سائرِ الكواكبِ إنَّ العلماءَ ورَثةُ الأنبياءِ إنَّ الأنبياءَ لَمْ يُورِثوا دينارًا ولا دِرهمًا وأورَثوا العِلْمَ فمَن أخَذه أخَذ بحظٍّ وافرٍ )"],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (3641)، والترمذي (2682)، وابن ماجه (223) باختلاف يسير","bab":"علم › تعليم الناس وفضل ذلك","dorar":"9zmkJf8x","merged":2,"otherRefs":["صحيح الترمذي 2682 (صحيح)"]},{"id":"س-08149","fp":"c4bbe36da0da","stateId":712,"easy":"إذا سلكت طريقاً تلتمس فيه علماً ← يسهل الله لك طريقاً إلى الجنة","cause":"من سلك طريقا يلتمس فيه علما","result":"سهل الله له طريقا إلى الجنة","explicit":true,"repOf":"س-00744","ref":"صحيح ابن ماجه 183","text":["كنتُ جالسًا عند أبي الدَّرداءِ في مَسجدِ دِمشقَ، فأتاه رجلٌ، فقال: يا أبا الدَّرداءِ، أتيتُكَ من المدينةِ، مدينةِ رسولِ الله صلَّى اللهُ عليه وسلَّمَ؛ لحديثٍ بَلَغني أنَّك تُحدِّثُ به عن النبيِّ صلَّى اللهُ عليه وسلَّمَ: قال: فما جاء بك تِجارةٌ؟ قال: لا، قال: ولا جاء بك غيرُه؟ قال: لا، قال: فإني سمعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["من سلك طريقا يلتمس فيه علما ، ",1],["سهل الله له طريقا إلى الجنة",2]," ، وإن الملائكة لتضع أجنحتها رضا لطالب العلم ، وإن طالب العلم يستغفر له من في السماء والأرض ، حتى الحيتان في الماء ، وإن فضل العالم على العابد كفضل القمر على سائر الكواكب ، إن العلماء هم ورثة الأنبياء إنَّ الأنبياءَ لم يُورِّثوا دِينارًا ولا دِرهمًا، إنَّما ورَّثوا العِلْمَ، فمَن أخَذَه أخَذَ بحظٍّ وافرٍ"],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3641)، والترمذي (2682)، وابن ماجه (223) واللفظ له، وأحمد (21715)","bab":"ملائكة › أعمال الملائكة","dorar":"xrxYmKdQ","merged":2,"otherRefs":["تخريج المسند لشعيب 7427 (صحيح)"]},{"id":"س-02052","fp":"67df35eef9e5","stateId":712,"easy":"إذا سلكت طريقاً تطلب فيه علماً ← يسهل الله لك طريق الجنة","cause":"ما من رجلٍ يَسلُكُ طرِيقًا ، يَطلُبُ فيه عِلْمًا","result":"إلَّا سَهَّلَ اللهُ لهُ طريقَ الجنةِ ، و مَنْ أبْطأَ بهِ عملُهُ لمْ يُسرِعْ بهِ نَسبُهُ","explicit":true,"repOf":"س-00744","ref":"صحيح الجامع 5715","text":[["ما من رجلٍ يَسلُكُ طرِيقًا ، يَطلُبُ فيه عِلْمًا",1]," ",["إلَّا سَهَّلَ اللهُ لهُ طريقَ الجنةِ ، و مَنْ أبْطأَ بهِ عملُهُ لمْ يُسرِعْ بهِ نَسبُهُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3643)، والدارمي (344)، وابن حبان (84).","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"b5gHp5Av"},{"id":"س-02056","fp":"16ad4586ac03","stateId":712,"easy":"إذا خرجت من بيتك تطلب علماً ← يسهل الله لك طريقاً إلى الجنة","cause":"ما خرج رجلٌ من بيتِهِ يطلُبُ علمًا","result":"إلَّا سهَّلَ اللهُ له طريقًا إلى الجنَّةِ","explicit":true,"star":true,"apply":{"k":"time","t":"عند الخروج من البيت"},"ref":"صحيح الجامع 5617","srcLabel":"صحيح الجامع","text":[["ما خرج رجلٌ من بيتِهِ يطلُبُ علمًا ،",1]," ",["إلَّا سهَّلَ اللهُ له طريقًا إلى الجنَّةِ",2]],"grade":"صحيح","narrator":"عائشة وأبو هريرة وأبو الدرداء","muhaddith":"صحيح","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"AKxhBduO"},{"id":"س-07018","fp":"187ded3d81eb","stateId":712,"easy":"إذا لم تشبع من سماع الخير ← يكون منتهاك الجنة","cause":"لن يشبَعَ المؤمنُ من خيرٍ يسمعُهُ","result":"حتَّى يكون منتهاه الجنَّةَ","explicit":true,"otherNeedIds":[18],"ref":"الجامع الصغير 7372","srcLabel":"الترمذي","text":[["لن يشبَعَ المؤمنُ من خيرٍ يسمعُهُ",1]," ",["حتَّى يكون منتهاه الجنَّةَ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2686) بلفظه، وابن حبان (903)، والحاكم (7352)، والبيهقي في ((شعب الإيمان)) (1176) جميعا مطولا بلفظ مقارب.","bab":"علم › الحث على طلب العلم","dorar":"BUvwoLtA"},{"id":"س-08139","fp":"a7685f6b1271","stateId":712,"easy":"إذا سلكت طريق علم ← يسهل الله لك طريقاً من طرق الجنة","cause":"مَن سلَكَ طريقَ عِلمٍ","result":"سَهَّلَ اللَّهُ تَبارك وتعالى لَهُ طريقًا مِن طُرقِ الجنَّةِ ، إنَّ الملائِكَةَ لتضعُ أجنَحتَها رضًى لطالِبِ العِلمِ ، وإنَّ السَّماواتِ والأرضَ والحوتَ في الماءِ لتَدعو لَهُ ، وإنَّ فضلَ العالِمِ","explicit":true,"repOf":"س-00744","ref":"معجم الشيوخ 1/574","text":["عن كثيرِ بنِ قَيسٍ ، قالَ : كنتُ معَ أبي الدَّرداءِ بمسجدِ دمشقَ ، فجاءَ رجلٌ ، فقالَ : يا أبا الدَّرداءِ ، إنِّي جئتُكَ من مدينةِ الرَّسولِ صلَّى اللَّهُ عليهِ وسلَّمَ في حَديثٍ بلغَني أنَّكَ تحدِّثُ به عن رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ، قالَ : ما كانَت لَكَ حاجةٌ غيرَهُ ؟ قالَ : لا ، قالَ : ولا جئتَ لتجارةٍ ؟ قالَ : لا ، قالَ : ولا جئتَ إلَّا فيهِ ؟ قالَ : نعَم ، قالَ : فإنِّي سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّم ، يقولُ : ",["مَن سلَكَ طريقَ عِلمٍ ",1],["سَهَّلَ اللَّهُ تَبارك وتعالى لَهُ طريقًا مِن طُرقِ الجنَّةِ ، إنَّ الملائِكَةَ لتضعُ أجنَحتَها رضًى لطالِبِ العِلمِ ، وإنَّ السَّماواتِ والأرضَ والحوتَ في الماءِ لتَدعو لَهُ ، وإنَّ فضلَ العالِمِ",2]," علَى العابِدِ كفَضلِ القَمرِ على سائرِ الكواكبِ ليلةَ البَدرِ ، والعلماءُ هم ورَثةُ الأنبياءِ ، إنَّ الأنبياءَ لم يورِّثوا دينارًا ولا درهمًا ، وإنَّما ورَّثوا العلمَ ، فمَن أخذَ بِهِ ، أخذَ بحظٍّ وافرٍ"],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"محفوظ من حديث أبي الدرداء مختلف في إسناده على عاصم بن رجاء بن حيوة","takhrij":"أخرجه أبو داود (3641)، والترمذي (2682)، وابن ماجة (223) واللفظ لهم.","bab":"ملائكة › أعمال الملائكة","dorar":"vmYUXuMj"},{"id":"س-07103","fp":"d010a81e0fa0","stateId":712,"easy":"إذا تعلمت كلمة أو كلمتين مما فرض الله فعلمتهن وعملت بهن ← تدخل الجنة","cause":"ما من رجلٍ تعلمَ كلمةً أو كلمتينِ أو ثلاثًا أو أربعًا أو خمسًا ممَّا فرضَ اللَّهُ عزَّ وجلَّ فيتعلَّمُهُنَّ ويعلِّمُهُنَّ","result":"إلَّا دخلَ الجنَّةَ","explicit":true,"ref":"الترغيب والترهيب 1/77","srcLabel":"أبو نعيم","text":[["ما من رجلٍ تعلمَ كلمةً أو كلمتينِ أو ثلاثًا أو أربعًا أو خمسًا ممَّا فرضَ اللَّهُ عزَّ وجلَّ فيتعلَّمُهُنَّ ويعلِّمُهُنَّ",1]," ",["إلَّا دخلَ الجنَّةَ",2]," قالَ أبو هُرَيْرةَ : فما نسيتُ حديثًا بعدَ إذ سَمِعْتُهنَّ من رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن لو صح سماع الحسن من أبي هريرة","takhrij":"أخرجه أبو نعيم في ((حلية الأولياء)) (2/159)، وابن عساكر في ((تاريخ دمشق)) (67/329)","bab":"علم › تعليم الناس وفضل ذلك","dorar":"LyXBiXSA"},{"id":"س-08148","fp":"de84534fa75d","stateId":712,"easy":"إذا غدوت لعلم تتعلمه ← يفتح الله لك به طريقاً إلى الجنة وتفرش لك الملائكة أكنافها","cause":"مَن غَدا لعِلمٍ يتعلَّمُه","result":"فتَح اللهُ له به طريقًا إلى الجنةِ وفَرَشَتْ له الملائكةُ أكنافَها ، وصلَّت عليه ملائكةُ السماءِ وحيتانُ البحرِ ، وللعالِمِ منَ الفضلِ على العابدِ كفضلِ القمرِ ليلةَ البدرِ على سائرِ","explicit":true,"otherNeedIds":[24],"ref":"مفتاح دار السعادة 1/254","srcLabel":"البيهقي","text":[["مَن غَدا لعِلمٍ يتعلَّمُه ",1],["فتَح اللهُ له به طريقًا إلى الجنةِ وفَرَشَتْ له الملائكةُ أكنافَها ، وصلَّت عليه ملائكةُ السماءِ وحيتانُ البحرِ ، وللعالِمِ منَ الفضلِ على العابدِ كفضلِ القمرِ ليلةَ البدرِ على سائرِ",2]," الكواكبِ ، والعلماءُ وَرَثَةُ الأنبياءِ ، إنَّ الأنبياءَ لم يُوَرِّثوا دينارًا ولا دِرهمًا إنما ورَّثوا العِلمَ ، فمَن أخَذ بالعِلمِ أخَذ بحظٍّ وافِرٍ ، وموتُ العالمِ مُصيبَةٌ لا تُجبَرُ ، وثُلمَةٌ لا تُسَدُّ ، ونجمٌ طُمِسَ ، وموتُ قبيلةٍ أيسَرُ مِن موتِ عالِمٍ"],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"حسن","takhrij":"أخرجه ابن شاهين في ((الترغيب في فضائل الأعمال)) (215)، والبيهقي في ((شعب الإيمان)) (1699)، وابن عبدالبر في ((جامع بيان العلم وفضله)) (179) باختلاف يسير","bab":"ملائكة › أعمال الملائكة","dorar":"465dG3Gq"},{"id":"س-02311","fp":"bd84a2941c49","stateId":713,"easy":"إذا زرت أخاً لك في الله ← يناديك منادٍ: طبت وطاب ممشاك وتبوأت من الجنة منزلاً","cause":"ما مِن عَبْدٍ مُسلِمٍ أتى أخًا له في اللهِ يَزورُه","result":"إلَّا نادى مُنادٍ مِن السَّماءِ: أن طِبْتَ وطابَتْ لك الجنَّةُ، وإلَّا قالَ اللهُ عَزَّ وجَلَّ في مَلَكوتِ عَرْشِه: عَبْدي زارَ فِيَّ، وعلَيَّ قِراه، ولن يَرْضى اللهُ لوَلِيِّه بقِرًى دونَ الجنَّةِ","explicit":true,"star":true,"otherNeedIds":[23],"ref":"الأحاديث المختارة 2680","srcLabel":"متفق عليه","text":["«",["ما مِن عَبْدٍ مُسلِمٍ أتى أخًا له في اللهِ يَزورُه",1]," ",["إلَّا نادى مُنادٍ مِن السَّماءِ: أن طِبْتَ وطابَتْ لك الجنَّةُ، وإلَّا قالَ اللهُ عَزَّ وجَلَّ في مَلَكوتِ عَرْشِه: عَبْدي زارَ فِيَّ، وعلَيَّ قِراه، ولن يَرْضى اللهُ لوَلِيِّه بقِرًى دونَ الجنَّةِ»",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"fTSjX01O"},{"id":"س-02920","fp":"e8e182fedaa1","stateId":713,"easy":"إذا سمّيت ولدك محمداً حباً للنبي ﷺ ← تكون أنت وهو في الجنة (على رواية)","cause":"من وُلِد له مولودٌ فسمَّاه محمدًا حبًّا لي وتبرّكًا باسمي","result":"كان هو ومولودُه في الجنَّةِ","explicit":true,"ref":"سبل الهدى والرشاد 1/414","srcLabel":"أحمد","text":[["من وُلِد له مولودٌ فسمَّاه محمدًا حبًّا لي وتبرّكًا باسمي",1]," ",["كان هو ومولودُه في الجنَّةِ",2]],"grade":"حسن","narrator":"أبو أمامة","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه الصيرفي في ((فضائل التسمية بأحمد ومحمد)) (30)، وابن الجوزي في ((الموضوعات))((1/ 157)) واللفظ لهما،  وقاضي المارستان في ((المشيخة)) (453) باختلاف يسير","bab":"إيمان › الوعد","dorar":"R3ELoXyW"},{"id":"س-04548","fp":"ff246d2e5957","stateId":713,"easy":"إذا زرت أخاك في الله ← فأنت في الجنة","cause":"والرَّجُلُ يكونُ في جانِبِ المِصْرِ يَزورُ أخاه لا يَزورُه إلَّا للهِ","result":"في الجنَّةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[41],"ref":"الأحاديث المختارة 10 / 403","srcLabel":"متفق عليه","text":["«أَلَا أُنَبِّئُكم برِجالِكم مِن أهْلِ الدُّنْيا في الجنَّةِ؟ قالوا: بَلى يا رَسولَ اللهِ، قالَ: النَّبيُّ صلَّى اللهُ عليه وسلَّمَ في الجنَّةِ، والصِّدِّيقُ في الجنَّةِ، والشَّهيدُ في الجنَّةِ، والمَوْلودُ مَوْلودُ الإسْلامِ في الجنَّةِ، ",["والرَّجُلُ يكونُ في جانِبِ المِصْرِ يَزورُ أخاه لا يَزورُه إلَّا للهِ",1]," ",["في الجنَّةِ",2],"، أَلَا أُنَبِّئُكم بنِسائِكم مِن أهْلِ الجنَّةِ؟ قالوا: بَلى يا رَسولَ اللهِ، قالَ: الوَلودُ الوَدودُ الَّتي إذا غَضِبَتْ أو غَضِبَ قالَتْ: يَدي في يَدِك لا أَكتَحِلُ بغَمْضٍ»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"جهاد › فضل الشهيد","dorar":"2YJKpcYW","merged":2,"otherRefs":["صحيح الترغيب 1941 (حسن)"]},{"id":"ق-0123","fp":"b7dacc220b85","stateId":714,"easy":"التقوى: الإيمان والصبر والصدق والقنوت والإنفاق والاستغفار بالأسحار ← جنات وأزواج مطهرة ورضوان من الله","cause":"التقوى: الإيمان والصبر والصدق والقنوت والإنفاق والاستغفار بالأسحار","result":"جنات وأزواج مطهرة ورضوان من الله","explicit":true,"star":true,"otherNeedIds":[23],"ref":"سورة آل عمران: 15–17","srcLabel":"القرآن الكريم","quran":{"s":3,"from":15,"to":17,"text":"قُلْ أَؤُنَبِّئُكُمْ بِخَيْرٍ مِنْ ذَلِكُمْ لِلَّذِينَ اتَّقَوْا عِنْدَ رَبِّهِمْ جَنَّاتٌ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا وَأَزْوَاجٌ مُطَهَّرَةٌ وَرِضْوَانٌ مِنَ اللَّهِ وَاللَّهُ بَصِيرٌ بِالْعِبَادِ (15) الَّذِينَ يَقُولُونَ رَبَّنَا إِنَّنَا آمَنَّا فَاغْفِرْ لَنَا ذُنُوبَنَا وَقِنَا عَذَابَ النَّارِ (16) الصَّابِرِينَ وَالصَّادِقِينَ وَالْقَانِتِينَ وَالْمُنْفِقِينَ وَالْمُسْتَغْفِرِينَ بِالْأَسْحَارِ (17)","hl":[[44,432,1]]}},{"id":"ق-0200","fp":"b18fb2e47fbb","stateId":714,"easy":"التقوى ← جنات تجري من تحتها الأنهار نزلاً من عند الله","cause":"التقوى","result":"جنات تجري من تحتها الأنهار نزلاً من عند الله","explicit":true,"star":true,"similar":["ق-1285"],"ref":"سورة آل عمران: 198","srcLabel":"القرآن الكريم","quran":{"s":3,"from":198,"to":198,"text":"لَكِنِ الَّذِينَ اتَّقَوْا رَبَّهُمْ لَهُمْ جَنَّاتٌ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا نُزُلًا مِنْ عِنْدِ اللَّهِ وَمَا عِنْدَ اللَّهِ خَيْرٌ لِلْأَبْرَارِ (198)","hl":[[7,176,1]]}},{"id":"ق-0351","fp":"fd07af38b237","stateId":714,"easy":"التقوى ← الدار الآخرة خير لهم","cause":"التقوى","result":"الدار الآخرة خير لهم","explicit":true,"star":true,"similar":["ق-0440","ق-0615","ق-1167"],"ref":"سورة الأنعام: 32","srcLabel":"القرآن الكريم","quran":{"s":6,"from":32,"to":32,"text":"وَمَا الْحَيَاةُ الدُّنْيَا إِلَّا لَعِبٌ وَلَهْوٌ وَلَلدَّارُ الْآخِرَةُ خَيْرٌ لِلَّذِينَ يَتَّقُونَ أَفَلَا تَعْقِلُونَ (32)","hl":[[51,102,1]]}},{"id":"ق-0440","fp":"b078b98952e6","stateId":714,"easy":"التقوى ← الدار الآخرة خير لهم","cause":"التقوى","result":"الدار الآخرة خير لهم","explicit":true,"repOf":"ق-0351","ref":"سورة الأعراف: 169","quran":{"s":7,"from":169,"to":169,"text":"فَخَلَفَ مِنْ بَعْدِهِمْ خَلْفٌ وَرِثُوا الْكِتَابَ يَأْخُذُونَ عَرَضَ هَذَا الْأَدْنَى وَيَقُولُونَ سَيُغْفَرُ لَنَا وَإِنْ يَأْتِهِمْ عَرَضٌ مِثْلُهُ يَأْخُذُوهُ أَلَمْ يُؤْخَذْ عَلَيْهِمْ مِيثَاقُ الْكِتَابِ أَنْ لَا يَقُولُوا عَلَى اللَّهِ إِلَّا الْحَقَّ وَدَرَسُوا مَا فِيهِ وَالدَّارُ الْآخِرَةُ خَيْرٌ لِلَّذِينَ يَتَّقُونَ أَفَلَا تَعْقِلُونَ (169)","hl":[[281,331,1]]}},{"id":"ق-0615","fp":"6a639714ea96","stateId":714,"easy":"التقوى ← دار الآخرة خير","cause":"التقوى","result":"دار الآخرة خير","explicit":true,"repOf":"ق-0351","ref":"سورة يوسف: 109","quran":{"s":12,"from":109,"to":109,"text":"وَمَا أَرْسَلْنَا مِنْ قَبْلِكَ إِلَّا رِجَالًا نُوحِي إِلَيْهِمْ مِنْ أَهْلِ الْقُرَى أَفَلَمْ يَسِيرُوا فِي الْأَرْضِ فَيَنْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الَّذِينَ مِنْ قَبْلِهِمْ وَلَدَارُ الْآخِرَةِ خَيْرٌ لِلَّذِينَ اتَّقَوْا أَفَلَا تَعْقِلُونَ (109)","hl":[[182,230,1]]}},{"id":"ق-0625","fp":"6bc62cfa5cff","stateId":714,"easy":"الوفاء بعهد الله ووصل ما أمر بوصله وخشيته والصبر ابتغاء وجهه وإقامة الصلاة والإنفاق ودرء السيئة بالحسنة ← عقبى الدار: جنات عدن مع الصالحين من الأهل والذرية وسلام الملائكة","cause":"الوفاء بعهد الله ووصل ما أمر بوصله وخشيته والصبر ابتغاء وجهه وإقامة الصلاة والإنفاق ودرء السيئة بالحسنة","result":"عقبى الدار: جنات عدن مع الصالحين من الأهل والذرية وسلام الملائكة","explicit":true,"star":true,"otherNeedIds":[37],"ref":"سورة الرعد: 20–24","srcLabel":"القرآن الكريم","quran":{"s":13,"from":20,"to":24,"text":"الَّذِينَ يُوفُونَ بِعَهْدِ اللَّهِ وَلَا يَنْقُضُونَ الْمِيثَاقَ (20) وَالَّذِينَ يَصِلُونَ مَا أَمَرَ اللَّهُ بِهِ أَنْ يُوصَلَ وَيَخْشَوْنَ رَبَّهُمْ وَيَخَافُونَ سُوءَ الْحِسَابِ (21) وَالَّذِينَ صَبَرُوا ابْتِغَاءَ وَجْهِ رَبِّهِمْ وَأَقَامُوا الصَّلَاةَ وَأَنْفَقُوا مِمَّا رَزَقْنَاهُمْ سِرًّا وَعَلَانِيَةً وَيَدْرَءُونَ بِالْحَسَنَةِ السَّيِّئَةَ أُولَئِكَ لَهُمْ عُقْبَى الدَّارِ (22) جَنَّاتُ عَدْنٍ يَدْخُلُونَهَا وَمَنْ صَلَحَ مِنْ آبَائِهِمْ وَأَزْوَاجِهِمْ وَذُرِّيَّاتِهِمْ وَالْمَلَائِكَةُ يَدْخُلُونَ عَلَيْهِمْ مِنْ كُلِّ بَابٍ (23) سَلَامٌ عَلَيْكُمْ بِمَا صَبَرْتُمْ فَنِعْمَ عُقْبَى الدَّارِ (24)","hl":[[0,389,1]]}},{"id":"ق-0633","fp":"64ad1aaff8c5","stateId":714,"easy":"التقوى ← الجنة أُكلها دائم وظلها","cause":"التقوى","result":"الجنة أُكلها دائم وظلها","explicit":true,"similar":["ق-0750","ق-0872","ق-0889"],"ref":"سورة الرعد: 35","srcLabel":"القرآن الكريم","quran":{"s":13,"from":35,"to":35,"text":"مَثَلُ الْجَنَّةِ الَّتِي وُعِدَ الْمُتَّقُونَ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ أُكُلُهَا دَائِمٌ وَظِلُّهَا تِلْكَ عُقْبَى الَّذِينَ اتَّقَوْا وَعُقْبَى الْكَافِرِينَ النَّارُ (35)","hl":[[0,146,1]]}},{"id":"ق-0656","fp":"4d7450a51709","stateId":714,"easy":"التقوى ← جنات وعيون ودخولها بسلام آمنين ونزع الغل ولا نصب","cause":"التقوى","result":"جنات وعيون ودخولها بسلام آمنين ونزع الغل ولا نصب","explicit":true,"similar":["ق-1181","ق-1268"],"otherNeedIds":[5,6],"ref":"سورة الحجر: 45–48","srcLabel":"القرآن الكريم","quran":{"s":15,"from":45,"to":48,"text":"إِنَّ الْمُتَّقِينَ فِي جَنَّاتٍ وَعُيُونٍ (45) ادْخُلُوهَا بِسَلَامٍ آمِنِينَ (46) وَنَزَعْنَا مَا فِي صُدُورِهِمْ مِنْ غِلٍّ إِخْوَانًا عَلَى سُرُرٍ مُتَقَابِلِينَ (47) لَا يَمَسُّهُمْ فِيهَا نَصَبٌ وَمَا هُمْ مِنْهَا بِمُخْرَجِينَ (48)","hl":[[0,233,1]]}},{"id":"ق-0668","fp":"8bece6a625a4","stateId":714,"easy":"التقوى ← جنات عدن لهم فيها ما يشاءون","cause":"التقوى","result":"جنات عدن لهم فيها ما يشاءون","explicit":true,"similar":["ق-1066","ق-1369"],"ref":"سورة النحل: 31","srcLabel":"القرآن الكريم","quran":{"s":16,"from":31,"to":31,"text":"جَنَّاتُ عَدْنٍ يَدْخُلُونَهَا تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ لَهُمْ فِيهَا مَا يَشَاءُونَ كَذَلِكَ يَجْزِي اللَّهُ الْمُتَّقِينَ (31)","hl":[[0,134,1]]}},{"id":"ق-0750","fp":"5944bb560aa4","stateId":714,"easy":"التقوى ← وراثة الجنة","cause":"التقوى","result":"و