{"schema":1,"kind":"sunan-chunk","version":"sunan-50a61695a4db","needId":50,"stateIds":[445,446,447,448,449,450,451,452,453,454],"items":[{"id":"س-05476","fp":"32adce58e7b7","stateId":445,"easy":"إذا ساء ظنك بالله ← يرديك كما أردى قوماً قبلك","cause":"سُوءُ ظَنِّهم باللهِ","result":"فإنَّ قَومًا قد أرْداهُم","explicit":true,"star":true,"otherNeedIds":[57],"ref":"تخريج المسند لشعيب 15197","srcLabel":"مسلم","text":["لا يَموتَنَّ أحدُكُم إلَّا وهو يُحسِنُ باللهِ الظنَّ؛ ",["فإنَّ قَومًا قد أرْداهُم",2]," ",["سُوءُ ظَنِّهم باللهِ",1],"، فقال اللهُ: {وَذَلِكُمْ ظَنُّكُمُ الَّذِي ظَنَنْتُمْ بِرَبِّكُمْ أَرْدَاكُمْ فَأَصْبَحْتُمْ مِنَ الْخَاسِرِينَ} [فصلت: 23]."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح دون قوله: فإن قوما قد أرداهم ... إلخ","takhrij":"أخرجه مسلم (2877) مختصراً، وأحمد (15197) واللفظ له","bab":"رقائق وزهد › الرجاء مع الخوف","dorar":"ouTGFlfO"},{"id":"ق-0005","fp":"2119bf53b188","stateId":445,"easy":"شراء الضلالة بالهدى ← خسارة التجارة وفقد الهداية","cause":"شراء الضلالة بالهدى","result":"خسارة التجارة وفقد الهداية","explicit":true,"star":true,"otherNeedIds":[19],"ref":"سورة البقرة: 16","srcLabel":"القرآن الكريم","quran":{"s":2,"from":16,"to":16,"text":"أُولَئِكَ الَّذِينَ اشْتَرَوُا الضَّلَالَةَ بِالْهُدَى فَمَا رَبِحَتْ تِجَارَتُهُمْ وَمَا كَانُوا مُهْتَدِينَ (16)","hl":[[0,109,1]]}},{"id":"ق-0041","fp":"d883d57c742b","stateId":445,"easy":"الكفر بالكتاب ← الخسران","cause":"الكفر بالكتاب","result":"الخسران","explicit":true,"star":true,"ref":"سورة البقرة: 121","srcLabel":"القرآن الكريم","quran":{"s":2,"from":121,"to":121,"text":"الَّذِينَ آتَيْنَاهُمُ الْكِتَابَ يَتْلُونَهُ حَقَّ تِلَاوَتِهِ أُولَئِكَ يُؤْمِنُونَ بِهِ وَمَنْ يَكْفُرْ بِهِ فَأُولَئِكَ هُمُ الْخَاسِرُونَ (121)","hl":[[91,142,1]]}},{"id":"ق-0057","fp":"ae9d274d4668","stateId":445,"easy":"اتخاذ الأنداد واتباع المتبوعين في الباطل ← تبرؤ المتبوعين والحسرات وعدم الخروج من النار","cause":"اتخاذ الأنداد واتباع المتبوعين في الباطل","result":"تبرؤ المتبوعين والحسرات وعدم الخروج من النار","explicit":true,"star":true,"otherNeedIds":[57],"ref":"سورة البقرة: 165–167","srcLabel":"القرآن الكريم","quran":{"s":2,"from":165,"to":167,"text":"وَمِنَ النَّاسِ مَنْ يَتَّخِذُ مِنْ دُونِ اللَّهِ أَنْدَادًا يُحِبُّونَهُمْ كَحُبِّ اللَّهِ وَالَّذِينَ آمَنُوا أَشَدُّ حُبًّا لِلَّهِ وَلَوْ يَرَى الَّذِينَ ظَلَمُوا إِذْ يَرَوْنَ الْعَذَابَ أَنَّ الْقُوَّةَ لِلَّهِ جَمِيعًا وَأَنَّ اللَّهَ شَدِيدُ الْعَذَابِ (165) إِذْ تَبَرَّأَ الَّذِينَ اتُّبِعُوا مِنَ الَّذِينَ اتَّبَعُوا وَرَأَوُا الْعَذَابَ وَتَقَطَّعَتْ بِهِمُ الْأَسْبَابُ (166) وَقَالَ الَّذِينَ اتَّبَعُوا لَوْ أَنَّ لَنَا كَرَّةً فَنَتَبَرَّأَ مِنْهُمْ كَمَا تَبَرَّءُوا مِنَّا كَذَلِكَ يُرِيهِمُ اللَّهُ أَعْمَالَهُمْ حَسَرَاتٍ عَلَيْهِمْ وَمَا هُمْ بِخَارِجِينَ مِنَ النَّارِ (167)","hl":[[0,591,1]]}},{"id":"ق-0173","fp":"6173263057b0","stateId":445,"easy":"طاعة الكافرين ← الارتداد على الأعقاب والخسران","cause":"طاعة الكافرين","result":"الارتداد على الأعقاب والخسران","explicit":true,"star":true,"ref":"سورة آل عمران: 149","srcLabel":"القرآن الكريم","quran":{"s":3,"from":149,"to":149,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ تُطِيعُوا الَّذِينَ كَفَرُوا يَرُدُّوكُمْ عَلَى أَعْقَابِكُمْ فَتَنْقَلِبُوا خَاسِرِينَ (149)","hl":[[31,123,1]]}},{"id":"ق-0250","fp":"fa73a79ecf5f","stateId":445,"easy":"اتخاذ الشيطان ولياً من دون الله ← خسران مبين","cause":"اتخاذ الشيطان ولياً من دون الله","result":"خسران مبين","explicit":true,"otherNeedIds":[32],"ref":"سورة النساء: 119","srcLabel":"القرآن الكريم","quran":{"s":4,"from":119,"to":119,"text":"وَلَأُضِلَّنَّهُمْ وَلَأُمَنِّيَنَّهُمْ وَلَآمُرَنَّهُمْ فَلَيُبَتِّكُنَّ آذَانَ الْأَنْعَامِ وَلَآمُرَنَّهُمْ فَلَيُغَيِّرُنَّ خَلْقَ اللَّهِ وَمَنْ يَتَّخِذِ الشَّيْطَانَ وَلِيًّا مِنْ دُونِ اللَّهِ فَقَدْ خَسِرَ خُسْرَانًا مُبِينًا (119)","hl":[[143,234,1]]}},{"id":"ق-0349","fp":"545aa7ee544d","stateId":445,"easy":"افتراء الكذب على الله أو التكذيب بآياته ← لا يفلح الظالمون","cause":"افتراء الكذب على الله أو التكذيب بآياته","result":"لا يفلح الظالمون","explicit":true,"similar":["ق-0550"],"ref":"سورة الأنعام: 21","srcLabel":"القرآن الكريم","quran":{"s":6,"from":21,"to":21,"text":"وَمَنْ أَظْلَمُ مِمَّنِ افْتَرَى عَلَى اللَّهِ كَذِبًا أَوْ كَذَّبَ بِآيَاتِهِ إِنَّهُ لَا يُفْلِحُ الظَّالِمُونَ (21)","hl":[[0,113,1]]}},{"id":"ق-0350","fp":"0b2c4147bbaf","stateId":445,"easy":"التكذيب بلقاء الله ← الحسرة وحمل الأوزار","cause":"التكذيب بلقاء الله","result":"الحسرة وحمل الأوزار","explicit":true,"otherNeedIds":[57],"ref":"سورة الأنعام: 31","srcLabel":"القرآن الكريم","quran":{"s":6,"from":31,"to":31,"text":"قَدْ خَسِرَ الَّذِينَ كَذَّبُوا بِلِقَاءِ اللَّهِ حَتَّى إِذَا جَاءَتْهُمُ السَّاعَةُ بَغْتَةً قَالُوا يَا حَسْرَتَنَا عَلَى مَا فَرَّطْنَا فِيهَا وَهُمْ يَحْمِلُونَ أَوْزَارَهُمْ عَلَى ظُهُورِهِمْ أَلَا سَاءَ مَا يَزِرُونَ (31)","hl":[[0,223,1]]}},{"id":"ق-0366","fp":"4b4e937d76aa","stateId":445,"easy":"العمى عن البصائر ← وباله على نفسه","cause":"العمى عن البصائر","result":"وباله على نفسه","explicit":true,"ref":"سورة الأنعام: 104","srcLabel":"القرآن الكريم","quran":{"s":6,"from":104,"to":104,"text":"قَدْ جَاءَكُمْ بَصَائِرُ مِنْ رَبِّكُمْ فَمَنْ أَبْصَرَ فَلِنَفْسِهِ وَمَنْ عَمِيَ فَعَلَيْهَا وَمَا أَنَا عَلَيْكُمْ بِحَفِيظٍ (104)","hl":[[69,94,1]]}},{"id":"ق-0393","fp":"5047d9395285","stateId":445,"easy":"ظلم آيات الله (خفة الموازين) ← خسران النفس","cause":"ظلم آيات الله (خفة الموازين)","result":"خسران النفس","explicit":true,"ref":"سورة الأعراف: 9","srcLabel":"القرآن الكريم","quran":{"s":7,"from":9,"to":9,"text":"وَمَنْ خَفَّتْ مَوَازِينُهُ فَأُولَئِكَ الَّذِينَ خَسِرُوا أَنْفُسَهُمْ بِمَا كَانُوا بِآيَاتِنَا يَظْلِمُونَ (9)","hl":[[0,109,1]]}},{"id":"ق-0418","fp":"8630bf1b1d25","stateId":445,"easy":"الأمن من مكر الله ← الخسران","cause":"الأمن من مكر الله","result":"الخسران","explicit":true,"ref":"سورة الأعراف: 97–99","srcLabel":"القرآن الكريم","quran":{"s":7,"from":97,"to":99,"text":"أَفَأَمِنَ أَهْلُ الْقُرَى أَنْ يَأْتِيَهُمْ بَأْسُنَا بَيَاتًا وَهُمْ نَائِمُونَ (97) أَوَأَمِنَ أَهْلُ الْقُرَى أَنْ يَأْتِيَهُمْ بَأْسُنَا ضُحًى وَهُمْ يَلْعَبُونَ (98) أَفَأَمِنُوا مَكْرَ اللَّهِ فَلَا يَأْمَنُ مَكْرَ اللَّهِ إِلَّا الْقَوْمُ الْخَاسِرُونَ (99)","hl":[[0,260,1]]}},{"id":"ق-0462","fp":"854ed91881dd","stateId":445,"easy":"الإنفاق للصد عن سبيل الله ← حسرة ثم هزيمة ثم الحشر إلى جهنم","cause":"الإنفاق للصد عن سبيل الله","result":"حسرة ثم هزيمة ثم الحشر إلى جهنم","explicit":true,"otherNeedIds":[39,57],"ref":"سورة الأنفال: 36","srcLabel":"القرآن الكريم","quran":{"s":8,"from":36,"to":36,"text":"إِنَّ الَّذِينَ كَفَرُوا يُنْفِقُونَ أَمْوَالَهُمْ لِيَصُدُّوا عَنْ سَبِيلِ اللَّهِ فَسَيُنْفِقُونَهَا ثُمَّ تَكُونُ عَلَيْهِمْ حَسْرَةً ثُمَّ يُغْلَبُونَ وَالَّذِينَ كَفَرُوا إِلَى جَهَنَّمَ يُحْشَرُونَ (36)","hl":[[0,203,1]]}},{"id":"ق-0550","fp":"f8edb56161c3","stateId":445,"easy":"افتراء الكذب على الله أو التكذيب بآياته ← لا يفلح المجرمون","cause":"افتراء الكذب على الله أو التكذيب بآياته","result":"لا يفلح المجرمون","explicit":true,"repOf":"ق-0349","ref":"سورة يونس: 17","quran":{"s":10,"from":17,"to":17,"text":"فَمَنْ أَظْلَمُ مِمَّنِ افْتَرَى عَلَى اللَّهِ كَذِبًا أَوْ كَذَّبَ بِآيَاتِهِ إِنَّهُ لَا يُفْلِحُ الْمُجْرِمُونَ (17)","hl":[[0,114,1]]}},{"id":"ق-0557","fp":"21581b3bf14a","stateId":445,"easy":"التكذيب بلقاء الله ← الخسران","cause":"التكذيب بلقاء الله","result":"الخسران","explicit":true,"ref":"سورة يونس: 45","srcLabel":"القرآن الكريم","quran":{"s":10,"from":45,"to":45,"text":"وَيَوْمَ يَحْشُرُهُمْ كَأَنْ لَمْ يَلْبَثُوا إِلَّا سَاعَةً مِنَ النَّهَارِ يَتَعَارَفُونَ بَيْنَهُمْ قَدْ خَسِرَ الَّذِينَ كَذَّبُوا بِلِقَاءِ اللَّهِ وَمَا كَانُوا مُهْتَدِينَ (45)","hl":[[102,177,1]]}},{"id":"ق-0560","fp":"927e80be8c67","stateId":445,"easy":"افتراء الكذب على الله ← لا يفلحون وعذاب شديد","cause":"افتراء الكذب على الله","result":"لا يفلحون وعذاب شديد","explicit":true,"similar":["ق-0687"],"otherNeedIds":[57],"ref":"سورة يونس: 69–70","srcLabel":"القرآن الكريم","quran":{"s":10,"from":69,"to":70,"text":"قُلْ إِنَّ الَّذِينَ يَفْتَرُونَ عَلَى اللَّهِ الْكَذِبَ لَا يُفْلِحُونَ (69) مَتَاعٌ فِي الدُّنْيَا ثُمَّ إِلَيْنَا مَرْجِعُهُمْ ثُمَّ نُذِيقُهُمُ الْعَذَابَ الشَّدِيدَ بِمَا كَانُوا يَكْفُرُونَ (70)","hl":[[5,195,1]]}},{"id":"ق-0574","fp":"8a453d0e71cd","stateId":445,"easy":"الضلال ← وباله على نفسه","cause":"الضلال","result":"وباله على نفسه","explicit":true,"similar":["ق-0699","ق-1091"],"ref":"سورة يونس: 108","srcLabel":"القرآن الكريم","quran":{"s":10,"from":108,"to":108,"text":"قُلْ يَا أَيُّهَا النَّاسُ قَدْ جَاءَكُمُ الْحَقُّ مِنْ رَبِّكُمْ فَمَنِ اهْتَدَى فَإِنَّمَا يَهْتَدِي لِنَفْسِهِ وَمَنْ ضَلَّ فَإِنَّمَا يَضِلُّ عَلَيْهَا وَمَا أَنَا عَلَيْكُمْ بِوَكِيلٍ (108)","hl":[[114,155,1]]}},{"id":"ق-0643","fp":"590ebf97ff8d","stateId":445,"easy":"الاستجابة لدعوة الشيطان ← خذلانه لأتباعه ولوم النفس","cause":"الاستجابة لدعوة الشيطان","result":"خذلانه لأتباعه ولوم النفس","explicit":true,"otherNeedIds":[32],"ref":"سورة إبراهيم: 22","srcLabel":"القرآن الكريم","quran":{"s":14,"from":22,"to":22,"text":"وَقَالَ الشَّيْطَانُ لَمَّا قُضِيَ الْأَمْرُ إِنَّ اللَّهَ وَعَدَكُمْ وَعْدَ الْحَقِّ وَوَعَدْتُكُمْ فَأَخْلَفْتُكُمْ وَمَا كَانَ لِيَ عَلَيْكُمْ مِنْ سُلْطَانٍ إِلَّا أَنْ دَعَوْتُكُمْ فَاسْتَجَبْتُمْ لِي فَلَا تَلُومُونِي وَلُومُوا أَنْفُسَكُمْ مَا أَنَا بِمُصْرِخِكُمْ وَمَا أَنْتُمْ بِمُصْرِخِيَّ إِنِّي كَفَرْتُ بِمَا أَشْرَكْتُمُونِ مِنْ قَبْلُ إِنَّ الظَّالِمِينَ لَهُمْ عَذَابٌ أَلِيمٌ (22)","hl":[[118,246,1]]}},{"id":"ق-0687","fp":"05c1583876a7","stateId":445,"easy":"افتراء الكذب على الله بالتحليل والتحريم ← لا يفلحون ومتاع قليل وعذاب أليم","cause":"افتراء الكذب على الله بالتحليل والتحريم","result":"لا يفلحون ومتاع قليل وعذاب أليم","explicit":true,"repOf":"ق-0560","otherNeedIds":[57],"ref":"سورة النحل: 116–117","quran":{"s":16,"from":116,"to":117,"text":"وَلَا تَقُولُوا لِمَا تَصِفُ أَلْسِنَتُكُمُ الْكَذِبَ هَذَا حَلَالٌ وَهَذَا حَرَامٌ لِتَفْتَرُوا عَلَى اللَّهِ الْكَذِبَ إِنَّ الَّذِينَ يَفْتَرُونَ عَلَى اللَّهِ الْكَذِبَ لَا يُفْلِحُونَ (116) مَتَاعٌ قَلِيلٌ وَلَهُمْ عَذَابٌ أَلِيمٌ (117)","hl":[[121,235,1]]}},{"id":"ق-0699","fp":"db3fd7ceedf0","stateId":445,"easy":"الضلال ← وباله على نفسه","cause":"الضلال","result":"وباله على نفسه","explicit":true,"repOf":"ق-0574","ref":"سورة الإسراء: 15","quran":{"s":17,"from":15,"to":15,"text":"مَنِ اهْتَدَى فَإِنَّمَا يَهْتَدِي لِنَفْسِهِ وَمَنْ ضَلَّ فَإِنَّمَا يَضِلُّ عَلَيْهَا وَلَا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَى وَمَا كُنَّا مُعَذِّبِينَ حَتَّى نَبْعَثَ رَسُولًا (15)","hl":[[46,87,1]]}},{"id":"ق-0760","fp":"7ef980becca1","stateId":445,"easy":"عدم الإيمان بالساعة واتباع الهوى ← الردى","cause":"عدم الإيمان بالساعة واتباع الهوى","result":"الردى","explicit":true,"otherNeedIds":[57],"ref":"سورة طه: 16","srcLabel":"القرآن الكريم","quran":{"s":20,"from":16,"to":16,"text":"فَلَا يَصُدَّنَّكَ عَنْهَا مَنْ لَا يُؤْمِنُ بِهَا وَاتَّبَعَ هَوَاهُ فَتَرْدَى (16)","hl":[[0,79,1]]}},{"id":"ق-0766","fp":"5a0920bff314","stateId":445,"easy":"افتراء الكذب على الله ← الاستئصال بالعذاب والخيبة","cause":"افتراء الكذب على الله","result":"الاستئصال بالعذاب والخيبة","explicit":true,"otherNeedIds":[49],"ref":"سورة طه: 61","srcLabel":"القرآن الكريم","quran":{"s":20,"from":61,"to":61,"text":"قَالَ لَهُمْ مُوسَى وَيْلَكُمْ لَا تَفْتَرُوا عَلَى اللَّهِ كَذِبًا فَيُسْحِتَكُمْ بِعَذَابٍ وَقَدْ خَابَ مَنِ افْتَرَى (61)","hl":[[31,119,1]]}},{"id":"ق-0803","fp":"51be7e2afce6","stateId":445,"easy":"عبادة الله على حَرف (بشرط النفع العاجل) ← خسران الدنيا والآخرة","cause":"عبادة الله على حَرف (بشرط النفع العاجل)","result":"خسران الدنيا والآخرة","explicit":true,"ref":"سورة الحج: 11","srcLabel":"القرآن الكريم","quran":{"s":22,"from":11,"to":11,"text":"وَمِنَ النَّاسِ مَنْ يَعْبُدُ اللَّهَ عَلَى حَرْفٍ فَإِنْ أَصَابَهُ خَيْرٌ اطْمَأَنَّ بِهِ وَإِنْ أَصَابَتْهُ فِتْنَةٌ انْقَلَبَ عَلَى وَجْهِهِ خَسِرَ الدُّنْيَا وَالْآخِرَةَ ذَلِكَ هُوَ الْخُسْرَانُ الْمُبِينُ (11)","hl":[[0,210,1]]}},{"id":"ق-0810","fp":"3f3bce2ff422","stateId":445,"easy":"الشرك بالله ← كمن خرّ من السماء فتخطفه الطير أو تهوي به الريح","cause":"الشرك بالله","result":"كمن خرّ من السماء فتخطفه الطير أو تهوي به الريح","explicit":true,"otherNeedIds":[19],"ref":"سورة الحج: 31","srcLabel":"القرآن الكريم","quran":{"s":22,"from":31,"to":31,"text":"حُنَفَاءَ لِلَّهِ غَيْرَ مُشْرِكِينَ بِهِ وَمَنْ يُشْرِكْ بِاللَّهِ فَكَأَنَّمَا خَرَّ مِنَ السَّمَاءِ فَتَخْطَفُهُ الطَّيْرُ أَوْ تَهْوِي بِهِ الرِّيحُ فِي مَكَانٍ سَحِيقٍ (31)","hl":[[42,172,1]]}},{"id":"ق-0846","fp":"9616eb2cee5f","stateId":445,"easy":"الشرك بالله ← لا يفلح الكافرون","cause":"الشرك بالله","result":"لا يفلح الكافرون","explicit":true,"ref":"سورة المؤمنون: 117","srcLabel":"القرآن الكريم","quran":{"s":23,"from":117,"to":117,"text":"وَمَنْ يَدْعُ مَعَ اللَّهِ إِلَهًا آخَرَ لَا بُرْهَانَ لَهُ بِهِ فَإِنَّمَا حِسَابُهُ عِنْدَ رَبِّهِ إِنَّهُ لَا يُفْلِحُ الْكَافِرُونَ (117)","hl":[[0,135,1]]}},{"id":"ق-0929","fp":"fbb4570b6175","stateId":445,"easy":"الكفر ← لا يفلحون","cause":"الكفر","result":"لا يفلحون","explicit":true,"ref":"سورة القصص: 82","srcLabel":"القرآن الكريم","quran":{"s":28,"from":82,"to":82,"text":"وَأَصْبَحَ الَّذِينَ تَمَنَّوْا مَكَانَهُ بِالْأَمْسِ يَقُولُونَ وَيْكَأَنَّ اللَّهَ يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ مِنْ عِبَادِهِ وَيَقْدِرُ لَوْلَا أَنْ مَنَّ اللَّهُ عَلَيْنَا لَخَسَفَ بِنَا وَيْكَأَنَّهُ لَا يُفْلِحُ الْكَافِرُونَ (82)","hl":[[197,237,1]]}},{"id":"ق-0949","fp":"1fcbc6a0c609","stateId":445,"easy":"الإيمان بالباطل والكفر بالله ← الخسران","cause":"الإيمان بالباطل والكفر بالله","result":"الخسران","explicit":true,"ref":"سورة العنكبوت: 52","srcLabel":"القرآن الكريم","quran":{"s":29,"from":52,"to":52,"text":"قُلْ كَفَى بِاللَّهِ بَيْنِي وَبَيْنَكُمْ شَهِيدًا يَعْلَمُ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ وَالَّذِينَ آمَنُوا بِالْبَاطِلِ وَكَفَرُوا بِاللَّهِ أُولَئِكَ هُمُ الْخَاسِرُونَ (52)","hl":[[94,176,1]]}},{"id":"ق-0963","fp":"0f01d5bdcb83","stateId":445,"easy":"الكفر ← عليه كفره","cause":"الكفر","result":"عليه كفره","explicit":true,"ref":"سورة الروم: 44","srcLabel":"القرآن الكريم","quran":{"s":30,"from":44,"to":44,"text":"مَنْ كَفَرَ فَعَلَيْهِ كُفْرُهُ وَمَنْ عَمِلَ صَالِحًا فَلِأَنْفُسِهِمْ يَمْهَدُونَ (44)","hl":[[0,32,1]]}},{"id":"ق-1012","fp":"905a5290f57c","stateId":445,"easy":"اتباع المستكبرين في الكفر ← الندامة والأغلال في الأعناق","cause":"اتباع المستكبرين في الكفر","result":"الندامة والأغلال في الأعناق","explicit":true,"otherNeedIds":[57],"ref":"سورة سبأ: 31–33","srcLabel":"القرآن الكريم","quran":{"s":34,"from":31,"to":33,"text":"وَقَالَ الَّذِينَ كَفَرُوا لَنْ نُؤْمِنَ بِهَذَا الْقُرْآنِ وَلَا بِالَّذِي بَيْنَ يَدَيْهِ وَلَوْ تَرَى إِذِ الظَّالِمُونَ مَوْقُوفُونَ عِنْدَ رَبِّهِمْ يَرْجِعُ بَعْضُهُمْ إِلَى بَعْضٍ الْقَوْلَ يَقُولُ الَّذِينَ اسْتُضْعِفُوا لِلَّذِينَ اسْتَكْبَرُوا لَوْلَا أَنْتُمْ لَكُنَّا مُؤْمِنِينَ (31) قَالَ الَّذِينَ اسْتَكْبَرُوا لِلَّذِينَ اسْتُضْعِفُوا أَنَحْنُ صَدَدْنَاكُمْ عَنِ الْهُدَى بَعْدَ إِذْ جَاءَكُمْ بَلْ كُنْتُمْ مُجْرِمِينَ (32) وَقَالَ الَّذِينَ اسْتُضْعِفُوا لِلَّذِينَ اسْتَكْبَرُوا بَلْ مَكْرُ اللَّيْلِ وَالنَّهَارِ إِذْ تَأْمُرُونَنَا أَنْ نَكْفُرَ بِاللَّهِ وَنَجْعَلَ لَهُ أَنْدَادًا وَأَسَرُّوا النَّدَامَةَ لَمَّا رَأَوُا الْعَذَابَ وَجَعَلْنَا الْأَغْلَالَ فِي أَعْنَاقِ الَّذِينَ كَفَرُوا هَلْ يُجْزَوْنَ إِلَّا مَا كَانُوا يَعْمَلُونَ (33)","hl":[[92,760,1]]}},{"id":"ق-1077","fp":"1ebd4aa3cde1","stateId":445,"easy":"عبادة غير الله ← الخسران المبين وظلل من النار","cause":"عبادة غير الله","result":"الخسران المبين وظلل من النار","explicit":true,"otherNeedIds":[57],"ref":"سورة الزمر: 15–16","srcLabel":"القرآن الكريم","quran":{"s":39,"from":15,"to":16,"text":"فَاعْبُدُوا مَا شِئْتُمْ مِنْ دُونِهِ قُلْ إِنَّ الْخَاسِرِينَ الَّذِينَ خَسِرُوا أَنْفُسَهُمْ وَأَهْلِيهِمْ يَوْمَ الْقِيَامَةِ أَلَا ذَلِكَ هُوَ الْخُسْرَانُ الْمُبِينُ (15) لَهُمْ مِنْ فَوْقِهِمْ ظُلَلٌ مِنَ النَّارِ وَمِنْ تَحْتِهِمْ ظُلَلٌ ذَلِكَ يُخَوِّفُ اللَّهُ بِهِ عِبَادَهُ يَا عِبَادِ فَاتَّقُونِ (16)","hl":[[38,308,1]]}},{"id":"ق-1091","fp":"4e151ce14a6d","stateId":445,"easy":"الضلال ← وباله على نفسه","cause":"الضلال","result":"وباله على نفسه","explicit":true,"repOf":"ق-0574","ref":"سورة الزمر: 41","quran":{"s":39,"from":41,"to":41,"text":"إِنَّا أَنْزَلْنَا عَلَيْكَ الْكِتَابَ لِلنَّاسِ بِالْحَقِّ فَمَنِ اهْتَدَى فَلِنَفْسِهِ وَمَنْ ضَلَّ فَإِنَّمَا يَضِلُّ عَلَيْهَا وَمَا أَنْتَ عَلَيْهِمْ بِوَكِيلٍ (41)","hl":[[89,164,1]]}},{"id":"ق-1095","fp":"356c019642fe","stateId":445,"easy":"التفريط في جنب الله والسخرية والتكذيب والاستكبار ← الحسرة عند رؤية العذاب","cause":"التفريط في جنب الله والسخرية والتكذيب والاستكبار","result":"الحسرة عند رؤية العذاب","explicit":true,"otherNeedIds":[57],"ref":"سورة الزمر: 56–59","srcLabel":"القرآن الكريم","quran":{"s":39,"from":56,"to":59,"text":"أَنْ تَقُولَ نَفْسٌ يَا حَسْرَتَا عَلَى مَا فَرَّطْتُ فِي جَنْبِ اللَّهِ وَإِنْ كُنْتُ لَمِنَ السَّاخِرِينَ (56) أَوْ تَقُولَ لَوْ أَنَّ اللَّهَ هَدَانِي لَكُنْتُ مِنَ الْمُتَّقِينَ (57) أَوْ تَقُولَ حِينَ تَرَى الْعَذَابَ لَوْ أَنَّ لِي كَرَّةً فَأَكُونَ مِنَ الْمُحْسِنِينَ (58) بَلَى قَدْ جَاءَتْكَ آيَاتِي فَكَذَّبْتَ بِهَا وَاسْتَكْبَرْتَ وَكُنْتَ مِنَ الْكَافِرِينَ (59)","hl":[[0,371,1]]}},{"id":"ق-1098","fp":"fdc5fe981693","stateId":445,"easy":"الكفر بآيات الله ← الخسران","cause":"الكفر بآيات الله","result":"الخسران","explicit":true,"ref":"سورة الزمر: 63","srcLabel":"القرآن الكريم","quran":{"s":39,"from":63,"to":63,"text":"لَهُ مَقَالِيدُ السَّمَاوَاتِ وَالْأَرْضِ وَالَّذِينَ كَفَرُوا بِآيَاتِ اللَّهِ أُولَئِكَ هُمُ الْخَاسِرُونَ (63)","hl":[[42,108,1]]}},{"id":"ق-1132","fp":"c0802a85c34e","stateId":445,"easy":"سوء الظن بالله ← الردى والخسران","cause":"سوء الظن بالله","result":"الردى والخسران","explicit":true,"otherNeedIds":[57],"ref":"سورة فصلت: 23","srcLabel":"القرآن الكريم","quran":{"s":41,"from":23,"to":23,"text":"وَذَلِكُمْ ظَنُّكُمُ الَّذِي ظَنَنْتُمْ بِرَبِّكُمْ أَرْدَاكُمْ فَأَصْبَحْتُمْ مِنَ الْخَاسِرِينَ (23)","hl":[[0,97,1]]}},{"id":"ق-1233","fp":"6fdb7c598526","stateId":445,"easy":"ظن السوء بالله ← البوار","cause":"ظن السوء بالله","result":"البوار","explicit":true,"ref":"سورة الفتح: 12","srcLabel":"القرآن الكريم","quran":{"s":48,"from":12,"to":12,"text":"بَلْ ظَنَنْتُمْ أَنْ لَنْ يَنْقَلِبَ الرَّسُولُ وَالْمُؤْمِنُونَ إِلَى أَهْلِيهِمْ أَبَدًا وَزُيِّنَ ذَلِكَ فِي قُلُوبِكُمْ وَظَنَنْتُمْ ظَنَّ السَّوْءِ وَكُنْتُمْ قَوْمًا بُورًا (12)","hl":[[124,178,1]]}},{"id":"س-02203","fp":"f65a4af065b0","stateId":445,"easy":"إذا خلا بيتك من كتاب الله ← فهو أصغر البيوت","cause":"بيتٌ ليس فيه شيءٌ من كتابِ اللهِ","result":"أصغرَ البيوتِ","explicit":true,"ref":"الترغيب والترهيب 2/305","srcLabel":"الطبراني","text":["عن عبدِ اللهِ بنِ مسعودٍ رضِي اللهُ عنه قال إنَّ ",["أصغرَ البيوتِ",2]," ",["بيتٌ ليس فيه شيءٌ من كتابِ اللهِ",1]],"grade":"صحيح","narrator":"[عوف بن مالك بن نضلة أبو الأحوص]","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((الكبير)) (9/ 129) (8645)، والفريابي في ((فضائل القرآن)) (41) بلفظه تامًا، وعبد الرزاق (20198) بنحوه مطولًا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"J218sdZc"},{"id":"س-05381","fp":"76b323a01dec","stateId":445,"easy":"إذا ظننت بالله شراً ← فلك الشر","cause":"و إنْ شَرًّا","result":"فَشَرٌّ","explicit":true,"ref":"السلسلة الصحيحة 1663","srcLabel":"أحمد","text":["إنَّ اللهَ تعالى يقولُ : أنا عندَ ظَنِّ عَبدي بي ، إنْ خيرًا فَخيرٌ ، ",["و إنْ شَرًّا",1]," ",["فَشَرٌّ",2]],"grade":"صحيح","narrator":"واثلة بن الأسقع.","muhaddith":"إسناده صحيح بلفظ آخر","takhrij":"أخرجه أحمد (16979)، وابن أبي الدنيا في ((حسن الظن بالله)) (2)، وابن حبان (1643)، والطبراني في ((المعجم الأوسط)) (7951) بلفظه وفيه قصة.","bab":"رقائق وزهد › الجزاء من جنس العمل","dorar":"U4pADjjQ"},{"id":"س-04602","fp":"d231f75ceb56","stateId":445,"easy":"إذا مت على الشرك ← فاتك خير كثير","cause":"قُبورِ المُشرِكينَ","result":"لقد سبَقَ هؤلاء خَيرًا كَثيرًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[20],"ref":"تخريج المسند لشعيب 20787","srcLabel":"أبو داود","text":["كنتُ أماشي رَسولَ اللهِ صلَّى اللهُ عليهِ وسَلَّمَ آخِذًا بِيَدِهِ، فقالَ لي: يا ابنَ الخَصاصِيةِ، ما أصبَحتَ تَنقِمُ على اللهِ؟ أصبَحتَ تُماشي رَسولَهُ. قالَ: أحسَبُهُ قالَ: آخِذًا بِيَدِهِ، قالَ: قُلتُ: ما أصبَحتُ أنقِمُ على اللهِ شَيئًا، قد أعطاني اللهُ كُلَّ خَيرٍ. قالَ: فأتَيْنا على ",["قُبورِ المُشرِكينَ",1],"، فقالَ: ",["لقد سبَقَ هؤلاء خَيرًا كَثيرًا",2],"، ثَلاثَ مَرَّاتٍ، ثم أتَيْنا على قُبورِ المُسلِمينَ، فقالَ: لقد أدرَكَ هؤلاء خَيرًا كَثيرًا، ثَلاثَ مَرَّاتٍ، يَقولُها، قالَ: فبَصُرَ بِرَجُلٍ يَمشي بَينَ المَقابِرِ في نَعْلَيْهِ، فقالَ: وَيحَكَ يا صاحِبَ السِّبْتِيَّتَيْنِ، ألْقِ سِبْتِيَّتَيْكَ، مَرَّتَيْنِ، أو ثَلاثًا، فنَظَرَ الرَّجُلُ، فلمَّا رَأى رَسولَ اللهِ صلَّى اللهُ عليهِ وسَلَّمَ خلَعَ نَعْلَيْهِ."],"grade":"صحيح","narrator":"بشير بن معبد بن الخصاصية","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3230)، والنسائي (2048)، وابن ماجه (1568)، وأحمد (20787) واللفظ له","bab":"دفن ومقابر › آداب المقبرة","dorar":"AX7H4DYE","merged":3,"otherRefs":["تخريج سنن أبي داود 3230 (صحيح)","الأحكام الوسطى 2/148 (صحيح)"]},{"id":"س-05537","fp":"d2959e866b07","stateId":445,"easy":"إذا لم تؤمن بالنبي ﷺ ← لا يُحبّب إليك لقاء الله ولا يُسهّل عليك قضاؤه","cause":"مَنْ لمْ يُؤْمِنْ بِكَ ، ولمْ يَشْهَدْ إنِّي رسولُكَ","result":"فلا تُحَبِّبْ إليهِ لِقَاءَكَ ، ولا تُسَهِّلْ عليهِ قَضَاءَكَ ، وأَكْثِرْ لهُ مِنَ الدنيا","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"ref":"صحيح الترغيب 3488","srcLabel":"ابن حبان","text":["اللهم مَنْ آمَنَ بِكَ ، وشَهِدَ إنِّي رسولُكَ ؛ فَحَبِّبْ إليهِ لِقَاءَكَ ، وسَهِّلْ عليهِ قَضَاءَكَ ، أَقْلِلْ لهُ مِنَ الدنيا ، و",["مَنْ لمْ يُؤْمِنْ بِكَ ، ولمْ يَشْهَدْ إنِّي رسولُكَ",1]," ؛ ",["فلا تُحَبِّبْ إليهِ لِقَاءَكَ ، ولا تُسَهِّلْ عليهِ قَضَاءَكَ ، وأَكْثِرْ لهُ مِنَ الدنيا",2]," ."],"grade":"صحيح","narrator":"فضالة بن عبيد","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (208) واللفظ له، والطبري في ((مسند ابن عباس)) (485)، والطبراني (18/313) (808) باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"GwzSxkRh"},{"id":"س-02946","fp":"aa0072040bd6","stateId":445,"easy":"إذا لم تؤمن بالشفاعة ← لم تكن من أهلها","cause":"فمنْ لمْ يؤمنْ بها","result":"لمْ يكنْ منْ أهلِها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الجامع الصغير 4879","srcLabel":"أحمد","text":["شفاعتِي يومَ القيامةِ حقٌ، ",["فمنْ لمْ يؤمنْ بها",1]," ",["لمْ يكنْ منْ أهلِها",2]],"grade":"صحيح","narrator":"زيد بن أرقم وبضعة عشر من الصحابة","muhaddith":"متواتر","takhrij":"أخرجه أحمد بن منيع كما في ((المطالب العالية)) (4562) واللفظ له.","bab":"إيمان › الوعيد","dorar":"bWLE6dWR"},{"id":"س-06166","fp":"0aba57bcc4f5","stateId":445,"easy":"إذا لم يكن لك سهم من أسهم الإسلام ← خبت (أثر حذيفة)","cause":"مَن لا سهمَ لهُ","result":"وخابَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"جامع العلوم والحكم 1/100","srcLabel":"الطيالسي","text":["عن حُذَيفةَ، قال : الإسلامُ ثمانيةُ أسهمٍ : الإسلامُ سهمٌ، والصَّلاةُ سهمٌ، والزَّكاةُ سهمٌ، وحجُّ البَيتِ سهمٌ، والجهادُ سهمٌ، وصَومُ رمضانَ سهمٌ، والأمرُ بالمعروفِ سهمٌ، والنَّهيُ عن المُنكرِ سهمٌ، ",["وخابَ",2]," ",["مَن لا سهمَ لهُ",1]," ."],"grade":"صحيح","narrator":"صلة بن زفر","muhaddith":"[صحيح]","takhrij":"أخرجه الطيالسي (413)، وابن أبي شيبة (19561)، والبزار (2928) واللفظ لهم جميعا.","bab":"زكاة › فرض الزكاة","dorar":"DlKXkspR"},{"id":"س-05264","fp":"22e0074c0f54","stateId":446,"easy":"إذا حاولت أمراً بمعصية ← يفوتك ما رجوت ويقرب ما خفت","cause":"مَن حاوَلَ أمْرًا بمَعْصيةٍ","result":"كانَ ذلك أَفوَتَ لِما رَجا، وأقْرَبَ لمَجيءِ ما اتَّقى","explicit":true,"star":true,"ref":"الأحاديث المختارة 9 / 51","srcLabel":"متفق عليه","text":["«",["مَن حاوَلَ أمْرًا بمَعْصيةٍ ",1],["كانَ ذلك أَفوَتَ لِما رَجا، وأقْرَبَ لمَجيءِ ما اتَّقى»",2],"."],"grade":"صحيح","narrator":"عبدالله بن بسر المازني","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"hPNc3YV0"},{"id":"س-04382","fp":"0f306f8709ff","stateId":446,"easy":"إذا أشركت أو سحرت أو قتلت أو أكلت الربا أو مال اليتيم أو توليت يوم الزحف أو قذفت ← وقعت في الموبقات السبع","cause":"الشِّركُ باللهِ، والسِّحرُ، وقتلُ النفسِ التي حرَّمَ اللهُ إلَّا بالحقِّ، وأكلُ الرِّبا، وأكلُ مالِ اليتيمِ، والتولِّي يومَ الزحفِ، وقذفُ المُحصَناتِ الغافلاتِ المؤمناتِ","result":"اجتنِبوا السَّبْعَ الموبِقاتِ","explicit":true,"star":true,"otherNeedIds":[12,20],"ref":"تخريج سنن أبي داود 2875","srcLabel":"أبو داود","text":["أنَّه حدَّثَه -وكانتْ له صُحبةٌ- أنَّ رجُلًا سأَله فقال: يا رسولَ اللهِ، ما الكبائرُ؟ فقال: هنَّ تِسعٌ، فذكَرَ معناهُ [أيْ معنى حديثِ: ",["اجتنِبوا السَّبْعَ الموبِقاتِ",2],"، قيل: يا رسولَ اللهِ، وما هنَّ؟ قال: ",["الشِّركُ باللهِ، والسِّحرُ، وقتلُ النفسِ التي حرَّمَ اللهُ إلَّا بالحقِّ، وأكلُ الرِّبا، وأكلُ مالِ اليتيمِ، والتولِّي يومَ الزحفِ، وقذفُ المُحصَناتِ الغافلاتِ المؤمناتِ",1],"]، زاد: وعقوقُ الوالدينِ المُسلمَينِ، واستحلالُ البيتِ الحرامِ قِبْلَتِكم أحياءً وأمواتًا."],"grade":"صحيح","narrator":"عمير بن قتادة الليثى","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (2875)، واللفظ له، والحاكم في ((المستدرك على الصحيحين)) (197)، والطحاوي في ((شرح مشكل الآثار)) (898)، والعقيلي في ((الضعفاء الكبير)) (3/ 45)،  واللفظ لهم مطولا.","bab":"جهاد › التولي والفرار من الزحف","dorar":"P9uegzsl","merged":9,"otherRefs":["الزواجر عن اقتراف الكبائر 1/27 (صحيح)","صحيح الجامع 144 (صحيح)","الأحاديث المختارة 9 / 16 (صحيح)","صحيح الترغيب 1848 (حسن)","المطالب العالية 4/100 (حسن)","الجامع الصغير 6432 (صحيح)","السلسلة الصحيحة 2244 (صحيح)","السنن الصغير للبيهقي 3/399 (صحيح)"]},{"id":"ق-0032","fp":"7540862e787d","stateId":446,"easy":"تعلّم السحر والعمل به ← لا نصيب في الآخرة","cause":"تعلّم السحر والعمل به","result":"لا نصيب في الآخرة","explicit":true,"star":true,"otherNeedIds":[57],"ref":"سورة البقرة: 102","srcLabel":"القرآن الكريم","quran":{"s":2,"from":102,"to":102,"text":"وَاتَّبَعُوا مَا تَتْلُو الشَّيَاطِينُ عَلَى مُلْكِ سُلَيْمَانَ وَمَا كَفَرَ سُلَيْمَانُ وَلَكِنَّ الشَّيَاطِينَ كَفَرُوا يُعَلِّمُونَ النَّاسَ السِّحْرَ وَمَا أُنْزِلَ عَلَى الْمَلَكَيْنِ بِبَابِلَ هَارُوتَ وَمَارُوتَ وَمَا يُعَلِّمَانِ مِنْ أَحَدٍ حَتَّى يَقُولَا إِنَّمَا نَحْنُ فِتْنَةٌ فَلَا تَكْفُرْ فَيَتَعَلَّمُونَ مِنْهُمَا مَا يُفَرِّقُونَ بِهِ بَيْنَ الْمَرْءِ وَزَوْجِهِ وَمَا هُمْ بِضَارِّينَ بِهِ مِنْ أَحَدٍ إِلَّا بِإِذْنِ اللَّهِ وَيَتَعَلَّمُونَ مَا يَضُرُّهُمْ وَلَا يَنْفَعُهُمْ وَلَقَدْ عَلِمُوا لَمَنِ اشْتَرَاهُ مَا لَهُ فِي الْآخِرَةِ مِنْ خَلَاقٍ وَلَبِئْسَ مَا شَرَوْا بِهِ أَنْفُسَهُمْ لَوْ كَانُوا يَعْلَمُونَ (102)","hl":[[499,571,1]]}},{"id":"ق-0298","fp":"1212ba456a6c","stateId":446,"easy":"قتل النفس بغير حق ← الخسران","cause":"قتل النفس بغير حق","result":"الخسران","explicit":true,"star":true,"ref":"سورة المائدة: 30","srcLabel":"القرآن الكريم","quran":{"s":5,"from":30,"to":30,"text":"فَطَوَّعَتْ لَهُ نَفْسُهُ قَتْلَ أَخِيهِ فَقَتَلَهُ فَأَصْبَحَ مِنَ الْخَاسِرِينَ (30)","hl":[[0,81,1]]}},{"id":"ق-0379","fp":"6f3ef5d787f1","stateId":446,"easy":"الظلم ← لا يفلحون","cause":"الظلم","result":"لا يفلحون","explicit":true,"star":true,"similar":["ق-0606"],"ref":"سورة الأنعام: 135","srcLabel":"القرآن الكريم","quran":{"s":6,"from":135,"to":135,"text":"قُلْ يَا قَوْمِ اعْمَلُوا عَلَى مَكَانَتِكُمْ إِنِّي عَامِلٌ فَسَوْفَ تَعْلَمُونَ مَنْ تَكُونُ لَهُ عَاقِبَةُ الدَّارِ إِنَّهُ لَا يُفْلِحُ الظَّالِمُونَ (135)","hl":[[119,153,1]]}},{"id":"ق-0380","fp":"123b019caa3b","stateId":446,"easy":"قتل الأولاد سفهاً وتحريم رزق الله افتراءً ← الخسران والضلال","cause":"قتل الأولاد سفهاً وتحريم رزق الله افتراءً","result":"الخسران والضلال","explicit":true,"otherNeedIds":[19],"ref":"سورة الأنعام: 140","srcLabel":"القرآن الكريم","quran":{"s":6,"from":140,"to":140,"text":"قَدْ خَسِرَ الَّذِينَ قَتَلُوا أَوْلَادَهُمْ سَفَهًا بِغَيْرِ عِلْمٍ وَحَرَّمُوا مَا رَزَقَهُمُ اللَّهُ افْتِرَاءً عَلَى اللَّهِ قَدْ ضَلُّوا وَمَا كَانُوا مُهْتَدِينَ (140)","hl":[[0,167,1]]}},{"id":"ق-0564","fp":"942f684afb7f","stateId":446,"easy":"السحر ← لا يفلح الساحرون","cause":"السحر","result":"لا يفلح الساحرون","explicit":true,"similar":["ق-0767"],"ref":"سورة يونس: 77","srcLabel":"القرآن الكريم","quran":{"s":10,"from":77,"to":77,"text":"قَالَ مُوسَى أَتَقُولُونَ لِلْحَقِّ لَمَّا جَاءَكُمْ أَسِحْرٌ هَذَا وَلَا يُفْلِحُ السَّاحِرُونَ (77)","hl":[[68,96,1]]}},{"id":"ق-0606","fp":"d6ccf975c58e","stateId":446,"easy":"الظلم ← لا يفلح الظالمون","cause":"الظلم","result":"لا يفلح الظالمون","explicit":true,"repOf":"ق-0379","ref":"سورة يوسف: 23","quran":{"s":12,"from":23,"to":23,"text":"وَرَاوَدَتْهُ الَّتِي هُوَ فِي بَيْتِهَا عَنْ نَفْسِهِ وَغَلَّقَتِ الْأَبْوَابَ وَقَالَتْ هَيْتَ لَكَ قَالَ مَعَاذَ اللَّهِ إِنَّهُ رَبِّي أَحْسَنَ مَثْوَايَ إِنَّهُ لَا يُفْلِحُ الظَّالِمُونَ (23)","hl":[[158,192,1]]}},{"id":"ق-0610","fp":"9bc786bf4192","stateId":446,"easy":"الخيانة ← لا يهدي الله كيد الخائنين","cause":"الخيانة","result":"لا يهدي الله كيد الخائنين","explicit":true,"ref":"سورة يوسف: 52","srcLabel":"القرآن الكريم","quran":{"s":12,"from":52,"to":52,"text":"ذَلِكَ لِيَعْلَمَ أَنِّي لَمْ أَخُنْهُ بِالْغَيْبِ وَأَنَّ اللَّهَ لَا يَهْدِي كَيْدَ الْخَائِنِينَ (52)","hl":[[51,99,1]]}},{"id":"ق-0622","fp":"4b1a80bfa695","stateId":446,"easy":"الباطل (الزبد) ← يذهب جُفاءً","cause":"الباطل (الزبد)","result":"يذهب جُفاءً","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"سورة الرعد: 17","srcLabel":"القرآن الكريم","quran":{"s":13,"from":17,"to":17,"text":"أَنْزَلَ مِنَ السَّمَاءِ مَاءً فَسَالَتْ أَوْدِيَةٌ بِقَدَرِهَا فَاحْتَمَلَ السَّيْلُ زَبَدًا رَابِيًا وَمِمَّا يُوقِدُونَ عَلَيْهِ فِي النَّارِ ابْتِغَاءَ حِلْيَةٍ أَوْ مَتَاعٍ زَبَدٌ مِثْلُهُ كَذَلِكَ يَضْرِبُ اللَّهُ الْحَقَّ وَالْبَاطِلَ فَأَمَّا الزَّبَدُ فَيَذْهَبُ جُفَاءً وَأَمَّا مَا يَنْفَعُ النَّاسَ فَيَمْكُثُ فِي الْأَرْضِ كَذَلِكَ يَضْرِبُ اللَّهُ الْأَمْثَالَ (17)","hl":[[242,279,1]]}},{"id":"ق-0641","fp":"327ca161f8a3","stateId":446,"easy":"التجبّر والعناد ← الخيبة وجهنم وماء صديد","cause":"التجبّر والعناد","result":"الخيبة وجهنم وماء صديد","explicit":true,"otherNeedIds":[57],"ref":"سورة إبراهيم: 15–17","srcLabel":"القرآن الكريم","quran":{"s":14,"from":15,"to":17,"text":"وَاسْتَفْتَحُوا وَخَابَ كُلُّ جَبَّارٍ عَنِيدٍ (15) مِنْ وَرَائِهِ جَهَنَّمُ وَيُسْقَى مِنْ مَاءٍ صَدِيدٍ (16) يَتَجَرَّعُهُ وَلَا يَكَادُ يُسِيغُهُ وَيَأْتِيهِ الْمَوْتُ مِنْ كُلِّ مَكَانٍ وَمَا هُوَ بِمَيِّتٍ وَمِنْ وَرَائِهِ عَذَابٌ غَلِيظٌ (17)","hl":[[0,243,1]]}},{"id":"ق-0647","fp":"51ab6e41c3f5","stateId":446,"easy":"الكلمة الخبيثة ← لا قرار لها","cause":"الكلمة الخبيثة","result":"لا قرار لها","explicit":true,"ref":"سورة إبراهيم: 26","srcLabel":"القرآن الكريم","quran":{"s":14,"from":26,"to":26,"text":"وَمَثَلُ كَلِمَةٍ خَبِيثَةٍ كَشَجَرَةٍ خَبِيثَةٍ اجْتُثَّتْ مِنْ فَوْقِ الْأَرْضِ مَا لَهَا مِنْ قَرَارٍ (26)","hl":[[0,104,1]]}},{"id":"ق-0720","fp":"b9c51180adc0","stateId":446,"easy":"الظلم ← لا يزيدهم القرآن إلا خساراً","cause":"الظلم","result":"لا يزيدهم القرآن إلا خساراً","explicit":true,"ref":"سورة الإسراء: 82","srcLabel":"القرآن الكريم","quran":{"s":17,"from":82,"to":82,"text":"وَنُنَزِّلُ مِنَ الْقُرْآنِ مَا هُوَ شِفَاءٌ وَرَحْمَةٌ لِلْمُؤْمِنِينَ وَلَا يَزِيدُ الظَّالِمِينَ إِلَّا خَسَارًا (82)","hl":[[72,115,1]]}},{"id":"ق-0767","fp":"9b89f7271fa1","stateId":446,"easy":"السحر ← لا يفلح الساحر حيث أتى","cause":"السحر","result":"لا يفلح الساحر حيث أتى","explicit":true,"repOf":"ق-0564","ref":"سورة طه: 69","quran":{"s":20,"from":69,"to":69,"text":"وَأَلْقِ مَا فِي يَمِينِكَ تَلْقَفْ مَا صَنَعُوا إِنَّمَا صَنَعُوا كَيْدُ سَاحِرٍ وَلَا يُفْلِحُ السَّاحِرُ حَيْثُ أَتَى (69)","hl":[[82,120,1]]}},{"id":"ق-0774","fp":"480eec722a25","stateId":446,"easy":"حمل الظلم ← الخيبة","cause":"حمل الظلم","result":"الخيبة","explicit":true,"ref":"سورة طه: 111","srcLabel":"القرآن الكريم","quran":{"s":20,"from":111,"to":111,"text":"وَعَنَتِ الْوُجُوهُ لِلْحَيِّ الْقَيُّومِ وَقَدْ خَابَ مَنْ حَمَلَ ظُلْمًا (111)","hl":[[42,74,1]]}},{"id":"ق-1111","fp":"f05eca216720","stateId":446,"easy":"سوء العمل والصد عن السبيل (فرعون) ← كيده في تباب","cause":"سوء العمل والصد عن السبيل (فرعون)","result":"كيده في تباب","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة غافر: 37","srcLabel":"القرآن الكريم","quran":{"s":40,"from":37,"to":37,"text":"أَسْبَابَ السَّمَاوَاتِ فَأَطَّلِعَ إِلَى إِلَهِ مُوسَى وَإِنِّي لَأَظُنُّهُ كَاذِبًا وَكَذَلِكَ زُيِّنَ لِفِرْعَوْنَ سُوءُ عَمَلِهِ وَصُدَّ عَنِ السَّبِيلِ وَمَا كَيْدُ فِرْعَوْنَ إِلَّا فِي تَبَابٍ (37)","hl":[[86,199,1]]}},{"id":"ق-1142","fp":"c8808052ecc8","stateId":446,"easy":"الإساءة ← وبالها على النفس","cause":"الإساءة","result":"وبالها على النفس","explicit":true,"similar":["ق-1185"],"ref":"سورة فصلت: 46","srcLabel":"القرآن الكريم","quran":{"s":41,"from":46,"to":46,"text":"مَنْ عَمِلَ صَالِحًا فَلِنَفْسِهِ وَمَنْ أَسَاءَ فَعَلَيْهَا وَمَا رَبُّكَ بِظَلَّامٍ لِلْعَبِيدِ (46)","hl":[[34,97,1]]}},{"id":"ق-1185","fp":"dfdde2717a7d","stateId":446,"easy":"الإساءة ← وبالها على النفس","cause":"الإساءة","result":"وبالها على النفس","explicit":true,"repOf":"ق-1142","ref":"سورة الجاثية: 15","quran":{"s":45,"from":15,"to":15,"text":"مَنْ عَمِلَ صَالِحًا فَلِنَفْسِهِ وَمَنْ أَسَاءَ فَعَلَيْهَا ثُمَّ إِلَى رَبِّكُمْ تُرْجَعُونَ (15)","hl":[[34,94,1]]}},{"id":"ق-1231","fp":"6b80bd3f6fc0","stateId":446,"easy":"نكث البيعة والعهد ← ينكث على نفسه","cause":"نكث البيعة والعهد","result":"ينكث على نفسه","explicit":true,"ref":"سورة الفتح: 10","srcLabel":"القرآن الكريم","quran":{"s":48,"from":10,"to":10,"text":"إِنَّ الَّذِينَ يُبَايِعُونَكَ إِنَّمَا يُبَايِعُونَ اللَّهَ يَدُ اللَّهِ فَوْقَ أَيْدِيهِمْ فَمَنْ نَكَثَ فَإِنَّمَا يَنْكُثُ عَلَى نَفْسِهِ وَمَنْ أَوْفَى بِمَا عَاهَدَ عَلَيْهُ اللَّهَ فَسَيُؤْتِيهِ أَجْرًا عَظِيمًا (10)","hl":[[93,142,1]]}},{"id":"ق-1439","fp":"b841669f0ce1","stateId":446,"easy":"تدسية النفس ← الخيبة","cause":"تدسية النفس","result":"الخيبة","explicit":true,"ref":"سورة الشمس: 10","srcLabel":"القرآن الكريم","quran":{"s":91,"from":10,"to":10,"text":"وَقَدْ خَابَ مَنْ دَسَّاهَا (10)","hl":[[0,27,1]]}},{"id":"س-05793","fp":"ccf2c61614e9","stateId":446,"easy":"إذا جعلك الله مفتاحاً للشر مغلاقاً للخير ← فويل لك","cause":"جعلَهُ اللهُ مِفتاحًا للشرِّ مغلاقًا للخيرِ","result":"وويلٌ لمنْ","explicit":true,"ref":"الجامع الصغير 5608","srcLabel":"الطبراني","text":["عندَ اللهِ خزائنُ الخيرِ والشرِّ، مفاتيحُها الرجالُ، فطوبَى لمنْ جعلهُ اللهُ مِفْتَاحًا للخيرِ، مِغْلَاقًا للشرِّ، ",["وويلٌ لمنْ",2]," ",["جعلَهُ اللهُ مِفتاحًا للشرِّ مغلاقًا للخيرِ",1]],"grade":"صحيح","narrator":"سهل بن سعد","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((الكبير)) (6/ 150) (5812) واللفظ له، وابن ماجة (238)، وأبو يعلى (7526) بنحوه.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"tc2xzsm7","merged":5,"otherRefs":["تخريج كتاب السنة 297 (حسن)","صحيح ابن ماجه 195 (حسن)","صحيح الترغيب 66 (حسن)","القضاء والقدر 153 (حسن)"]},{"id":"س-07755","fp":"204deb23c025","stateId":446,"easy":"إذا كذبت كما كذب المتخلفون ← تهلك كما هلكوا","cause":"صِدقي رَسولَ اللهِ","result":"فأهلِكَ كما هَلَكَ الذينَ كَذَبوا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[57],"ref":"صحيح مسلم 2769","srcLabel":"البخاري","text":["ثُمَّ غَزا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم غَزوةَ تَبوكَ، وهو يُريدُ الرُّومَ ونَصارى العَرَبِ بالشَّامِ، قال ابنُ شِهابٍ: فأخبَرَني عبدُ الرَّحمَنِ بنُ عبدِ اللهِ بنِ كَعبِ بنِ مالِكٍ، أنَّ عَبدَ اللهِ بنَ كَعبٍ كان قائِدَ كَعبٍ، مِن بَنيه، حينَ عَميَ، قال: سَمِعتُ كَعبَ بنَ مالِكٍ يُحَدِّثُ حَديثَه حينَ تَخَلَّفَ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةِ تَبوكَ، قال كَعبُ بنُ مالِكٍ: لم أتَخَلَّفْ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةٍ غَزاها قَطُّ إلَّا في غَزوةِ تَبوكَ، غيرَ أنِّي قد تَخَلَّفتُ في غَزوةِ بَدرٍ ولم يُعاتِبْ أحَدًا تَخَلَّفَ عنه، إنَّما خَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم والمُسلِمونَ يُريدونَ عيرَ قُرَيشٍ، حتَّى جَمع اللهُ بينَهم وبينَ عَدوِّهِم على غيرِ ميعادٍ، ولقد شَهِدتُ مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم لَيلةَ العَقَبةِ، حينَ تَواثَقنا على الإسلامِ، وما أُحِبُّ أنَّ لي بها مَشهَدَ بَدرٍ، وإن كانَت بَدرٌ أذكَرَ في النَّاسِ منها، وكانَ مِن خَبَري حينَ تَخَلَّفتُ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةِ تَبوكَ أنِّي لم أكُنْ قَطُّ أقوى ولا أيسَرَ مِنِّي حينَ تَخَلَّفتُ عنه في تلك الغَزوةِ، واللهِ ما جَمَعتُ قَبلَها راحِلَتَينِ قَطُّ، حتَّى جَمَعتُهما في تلك الغَزوةِ، فغَزاها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم في حَرٍّ شَديدٍ واستَقبَلَ سَفَرًا بَعيدًا ومَفازًا، واستَقبَلَ عَدوًّا كَثيرًا، فجَلا للمُسلِمينَ أمرَهم ليَتَأهَّبوا أُهبةَ غَزوِهم، فأخبَرَهم بوجهِهمِ الذي يُريدُ، والمُسلِمونَ مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم كَثيرٌ، ولا يَجمَعُهم كِتابُ حافِظٍ، يُريدُ بذلك الدِّيوانَ، قال كَعبٌ: فقَلَّ رَجُلٌ يُريدُ أن يَتَغَيَّبَ، يَظُنُّ أنَّ ذلك سَيَخفى له، ما لم يَنزِلْ فيه وحيٌ مِنَ اللهِ عَزَّ وجَلَّ، وغَزا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم تلك الغَزوةَ حينَ طابَتِ الثِّمارُ والظِّلالُ، فأنا إليها أصعَرُ، فتَجَهَّزَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم والمُسلِمونَ معهُ، وطَفِقتُ أغدو لكَي أتَجَهَّزَ معهُم، فأرجِعُ ولم أقضِ شيئًا، وأقولُ في نَفسي: أنا قادِرٌ على ذلك إذا أرَدتُ، فلم يَزَلْ ذلك يَتَمادى بي حتَّى استَمَرَّ بالنَّاسِ الجِدُّ، فأصبَحَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم غاديًا والمُسلِمونَ معهُ، ولم أقضِ مِن جَهازي شيئًا، ثُمَّ غَدَوتُ فرَجَعتُ ولم أقضِ شيئًا، فلم يَزَلْ ذلك يَتَمادى بي حتَّى أسرَعوا وتَفارَطَ الغَزوُ، فهَمَمتُ أن أرتَحِلَ فأُدرِكَهم، فيا لَيتَني فعَلتُ، ثُمَّ لم يُقدَّرْ ذلك لي، فطَفِقتُ إذا خَرَجتُ في النَّاسِ بَعدَ خُروجِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم يَحزُنُني أنِّي لا أرى لي أُسوةً إلَّا رَجُلًا مَغموصًا عليه في النِّفاقِ، أو رَجُلًا مِمَّن عَذَرَ اللهُ مِنَ الضُّعَفاءِ، ولم يَذكُرْني رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم حتَّى بَلَغَ تَبوكَ، فقال وهو جالِسٌ في القَومِ بتَبوكَ: ما فعَلَ كَعبُ بنُ مالِكٍ؟ قال رَجُلٌ مِن بَني سَلِمةَ: يا رَسولَ اللهِ، حَبَسَه بُرداه والنَّظَرُ في عِطفَيه، فقال له مُعاذُ بنُ جَبَلٍ: بئسَ ما قُلتَ! واللهِ يا رَسولَ اللهِ، ما عَلِمنا عليه إلَّا خَيرًا، فسَكَتَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فبينَما هو على ذلك رَأى رَجُلًا مُبَيِّضًا يَزولُ به السَّرابُ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: كُنْ أبا خَيثَمةَ، فإذا هو أبو خَيثَمةَ الأنصاريُّ، وهو الذي تَصَدَّقَ بصاعِ التَّمرِ حينَ لَمَزَه المُنافِقونَ. فقال كَعبُ بنُ مالِكٍ: فلَمَّا بَلَغَني أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قد تَوجَّهَ قافِلًا مِن تَبوكَ حَضَرَني بَثِّي، فطَفِقتُ أتَذَكَّرُ الكَذِبَ وأقولُ: بمَ أخرُجُ مِن سَخَطِه غَدًا؟ وأستَعينُ على ذلك كُلَّ ذي رَأيٍ مِن أهلي، فلَمَّا قيلَ لي: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قد أظَلَّ قادِمًا زاحَ عَنِّي الباطِلُ، حتَّى عَرَفتُ أنِّي لَن أنجوَ منه بشيءٍ أبَدًا، فأجمَعتُ صِدقَه، وصَبَّحَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم قادِمًا، وكانَ إذا قدِمَ مِن سَفَرٍ بَدَأ بالمَسجِدِ فرَكَعَ فيه رَكعَتَينِ، ثُمَّ جَلَسَ للنَّاسِ، فلَمَّا فعَلَ ذلك جاءَه المُخَلَّفونَ، فطَفِقوا يَعتَذِرونَ إليه، ويَحلِفونَ له، وكانوا بضعةً وثَمانينَ رَجُلًا، فقَبِلَ منهم رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم عَلانيَتَهم، وبايَعَهم واستَغفَرَ لهم، ووكَلَ سَرائِرَهم إلى اللهِ، حتَّى جِئتُ، فلَمَّا سَلَّمتُ تَبَسَّمَ تَبَسُّمَ المُغضَبِ، ثُمَّ قال: تَعالَ، فجِئتُ أمشي حتَّى جَلَستُ بينَ يَدَيه، فقال لي: ما خَلَّفَكَ؟ ألَم تَكُنْ قدِ ابتَعتَ ظَهرَكَ؟ قال: قُلتُ: يا رَسولَ اللهِ، إنِّي، واللهِ لو جَلَستُ عِندَ غيرِكَ مِن أهلِ الدُّنيا لَرَأيتُ أنِّي سَأخرُجُ مِن سَخَطِه بعُذرٍ، ولقد أُعطيتُ جَدَلًا، ولَكِنِّي واللهِ لقد عَلِمتُ لَئِن حَدَّثتُكَ اليومَ حَديثَ كَذِبٍ تَرضى به عَنِّي لَيوشِكَنَّ اللهُ أن يُسخِطَكَ عليَّ، ولَئِن حَدَّثتُكَ حَديثَ صِدقٍ تَجِدُ عليَّ فيه، إنِّي لأرجو فيه عُقبى اللهِ، واللهِ ما كان لي عُذرٌ، واللهِ ما كُنتُ قَطُّ أقوى ولا أيسَرَ مِنِّي حينَ تَخَلَّفتُ عَنكَ، قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أمَّا هذا فقد صَدَقَ، فقُمْ حتَّى يَقضيَ اللهُ فيكَ، فقُمتُ، وثارَ رِجالٌ مِن بَني سَلِمةَ فاتَّبَعوني، فقالوا لي: واللهِ ما عَلِمناكَ أذنَبتَ ذَنبًا قَبلَ هذا، لقد عَجَزتَ في أن لا تَكونَ اعتَذَرتَ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم بما اعتَذَرَ به إليه المُخَلَّفونَ؛ فقد كان كافيَكَ ذَنبَكَ استِغفارُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم لَكَ. قال: فواللهِ ما زالوا يُؤَنِّبوني حتَّى أرَدتُ أن أرجِعَ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فأُكَذِّبَ نَفسي، قال ثُمَّ قُلتُ لهم: هل لَقيَ هذا مَعي مِن أحَدٍ؟ قالوا: نَعَم، لَقيَه معكَ رَجُلانِ، قالا مِثلَ ما قُلتَ، فقيلَ لهما مِثلَ ما قيلَ لَكَ، قال: قُلتُ: مَن هُما؟ قالوا: مُرارةُ بنُ الرَّبيعةِ العامِريُّ، وهِلالُ بنُ أُمَيَّةَ الواقِفيُّ، قال: فذَكَروا لي رَجُلَينِ صالِحَينِ قد شَهِدا بَدرًا، فيهما أُسوةٌ، قال: فمَضَيتُ حينَ ذَكَروهما لي. قال: ونَهى رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم المُسلِمينَ عن كَلامِنا -أيُّها الثَّلاثةُ- مِن بَينِ مَن تَخَلَّفَ عنه. قال: فاجتَنَبَنا النَّاسُ، وقال: تَغَيَّروا لَنا حتَّى تَنَكَّرَت لي في نَفسيَ الأرضُ، فما هي بالأرضِ التي أعرِفُ، فلَبِثنا على ذلك خَمسينَ لَيلةً، فأمَّا صاحِبايَ فاستَكانا وقَعَدا في بُيوتِهما يَبكيانِ، وأمَّا أنا فكُنتُ أشَبَّ القَومِ وأجلَدَهم، فكُنتُ أخرُجُ فأشهَدُ الصَّلاةَ وأطوفُ في الأسواقِ ولا يُكَلِّمُني أحَدٌ، وآتي رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم فأُسَلِّمُ عليه وهو في مَجلِسِه بَعدَ الصَّلاةِ، فأقولُ في نَفسي: هل حَرَّكَ شَفَتَيه برَدِّ السَّلامِ، أم لا؟ ثُمَّ أُصَلِّي قَريبًا منه وأُسارِقُه النَّظَرَ، فإذا أقبَلتُ على صَلاتي نَظَرَ إليَّ، وإذا التَفَتُّ نَحوه أعرَضَ عَنِّي، حتَّى إذا طالَ ذلك عليَّ مِن جَفوةِ المُسلِمينَ مَشيتُ حتَّى تَسَوَّرتُ جِدارَ حائِطِ أبي قَتادةَ، وهو ابنُ عَمِّي، وأحَبُّ النَّاسِ إليَّ، فسَلَّمتُ عليه، فواللهِ ما رَدَّ عليَّ السَّلامَ. فقُلتُ له: يا أبا قَتادةَ، أنشُدُكَ باللهِ هل تَعلَمَنَّ أنِّي أُحِبُّ اللهَ ورَسولَه؟ قال: فسَكَتَ، فعُدتُ فناشَدتُه، فسَكَتَ، فعُدتُ فناشَدتُه، فقال: اللهُ ورَسولُه أعلَمُ، ففاضَت عَينايَ وتَولَّيتُ حتَّى تَسَوَّرتُ الجِدارَ. فبينا أنا أمشي في سوقِ المَدينةِ إذا نَبَطيٌّ مِن نَبَطِ أهلِ الشَّامِ، مِمَّن قدِمَ بالطَّعامِ يَبيعُه بالمَدينةِ، يقولُ: مَن يَدُلُّ على كَعبِ بنِ مالِكٍ؟ قال: فطَفِقَ النَّاسُ يُشيرونَ له إليَّ، حتَّى جاءَني فدَفَعَ إليَّ كِتابًا مِن مَلِكِ غَسَّانَ، وكُنتُ كاتِبًا، فقَرَأتُه فإذا فيه: أمَّا بَعدُ؛ فإنَّه قد بَلَغَنا أنَّ صاحِبَكَ قد جَفاكَ، ولم يَجعَلْكَ اللهُ بدارِ هَوانٍ ولا مَضيَعةٍ، فالحَقْ بنا نُواسِكَ، قال: فقُلتُ حينَ قَرَأتُها: وهذه أيضًا مِنَ البَلاءِ، فتَيامَمتُ بها التَّنُّورَ فسَجَرتُها بها، حتَّى إذا مَضَت أربَعونَ مِنَ الخَمسينَ، واستَلبَثَ الوحيُ، إذا رَسولُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم يَأتيني، فقال: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَأمُرُكَ أن تَعتَزِلَ امرَأتَكَ، قال: فقُلتُ: أُطَلِّقُها أم ماذا أفعَلُ؟ قال: لا، بَلِ اعتَزِلها، فلا تَقرَبَنَّها، قال: فأرسَلَ إلى صاحِبَيَّ بمِثلِ ذلك، قال: فقُلتُ لامرَأتي: الحَقي بأهلِكِ فكوني عِندَهم حتَّى يَقضيَ اللهُ في هذا الأمرِ، قال: فجاءَتِ امرَأةُ هِلالِ بنِ أُمَيَّةَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فقالت له: يا رَسولَ اللهِ، إنَّ هِلالَ بنَ أُمَيَّةَ شيخٌ ضائِعٌ ليس له خادِمٌ، فهل تَكرَهُ أن أخدُمَه؟ قال: لا، ولَكِن لا يَقرَبَنَّكِ، فقالت: إنَّه واللهِ ما به حَرَكةٌ إلى شيءٍ، وواللهِ ما زالَ يَبكي مُنذُ كان مِن أمرِه ما كانَ إلى يَومِه هذا، قال: فقال لي بَعضُ أهلي: لَوِ استَأذَنتَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم في امرَأتِكَ؟ فقد أذِنَ لامرَأةِ هِلالِ بنِ أُمَيَّةَ أن تَخدُمَه، قال: فقُلتُ: لا أستَأذِنُ فيها رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، وما يُدريني ماذا يقولُ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم إذا استَأذَنتُه فيها، وأنا رَجُلٌ شابٌّ، قال: فلَبِثتُ بذلك عَشرَ لَيالٍ، فكَمُلَ لَنا خَمسونَ لَيلةً مِن حينَ نُهي عن كَلامِنا، قال: ثُمَّ صَلَّيتُ صَلاةَ الفَجرِ صَباحَ خَمسينَ لَيلةً على ظَهرِ بَيتٍ مِن بُيوتِنا، فبينا أنا جالِسٌ على الحالِ التي ذَكَرَ اللهُ عَزَّ وجَلَّ مِنَّا قد ضاقَت عليَّ نَفسي وضاقَت عليَّ الأرضُ بما رَحُبَت، سَمِعتُ صَوتَ صارِخٍ أوفى على سَلعٍ يقولُ بأعلى صَوتِه: يا كَعبَ بنَ مالِكٍ أبشِرْ، قال: فخَرَرتُ ساجِدًا وعَرَفتُ أنْ قد جاءَ فرَجٌ. قال: فآذَنَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم النَّاسَ بتَوبةِ اللهِ علينا، حينَ صَلَّى صَلاةَ الفَجرِ، فذَهَبَ النَّاسُ يُبَشِّرونَنا، فذَهَبَ قِبَلَ صاحِبَيَّ مُبَشِّرونَ، ورَكَضَ رَجُلٌ إليَّ فرَسًا، وسَعى ساعٍ مِن أسلَمَ قِبَلي، وأوفى الجَبَلَ، فكانَ الصَّوتُ أسرَعَ مِنَ الفَرَسِ، فلَمَّا جاءَني الذي سَمِعتُ صَوتَه يُبَشِّرُني فنَزَعتُ له ثَوبَيَّ فكَسَوتُهما إيَّاه ببِشارَتِه، واللهِ ما أملِكُ غَيرَهما يَومَئذٍ، واستَعَرتُ ثَوبَينِ فلَبِستُهما، فانطَلَقتُ أتَأمَّمُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَتَلَقَّاني النَّاسُ فوجًا فوجًا، يُهَنِّئوني بالتَّوبةِ ويقولونَ: لتَهنِئْكَ تَوبةُ اللهِ عليكَ! حتَّى دَخَلتُ المَسجِدَ، فإذا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم جالِسٌ في المَسجِدِ وحَوله النَّاسُ، فقامَ طَلحةُ بنُ عُبَيدِ اللهِ يُهَروِلُ حتَّى صافَحَني وهَنَّأني، واللهِ ما قامَ رَجُلٌ مِنَ المُهاجِرينَ غَيرُه. قال: فكانَ كَعبٌ لا يَنساها لطَلحةَ. قال كَعبٌ: فلَمَّا سَلَّمتُ على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم قال وهو يَبرُقُ وجهُه مِنَ السُّرورِ ويقولُ: أبشِرْ بخَيرِ يَومٍ مَرَّ عليكَ مُنذُ ولَدَتكَ أُمُّكَ، قال: فقُلتُ: أمِن عِندِكَ يا رَسولَ اللهِ أم مِن عِندِ اللهِ؟ فقال: لا، بَل مِن عِندِ اللهِ، وكانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم إذا سُرَّ استَنارَ وجهُه، كَأنَّ وجهَه قِطعةُ قَمَرٍ، قال: وكُنَّا نَعرِفُ ذلك، قال: فلَمَّا جَلَستُ بينَ يَدَيه قُلتُ: يا رَسولَ اللهِ، إنَّ مِن تَوبَتي أن أنخَلِعَ مِن مالي صَدَقةً إلى اللهِ وإلى رَسولِه صلَّى اللهُ عليه وسلَّم، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أمسِكْ بَعضَ مالِكَ فهو خَيرٌ لكَ، قال: فقُلتُ: فإنِّي أُمسِكُ سَهميَ الذي بخَيبَرَ، قال: وقُلتُ: يا رَسولَ اللهِ، إنَّ اللهَ إنَّما أنجاني بالصِّدقِ، وإنَّ مِن تَوبَتي أن لا أُحَدِّثَ إلَّا صِدقًا ما بَقيتُ، قال: فواللهِ ما عَلِمتُ أنَّ أحَدًا مِنَ المُسلِمينَ أبلاه اللهُ في صِدقِ الحَديثِ مُنذُ ذَكَرتُ ذلك لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّم إلى يَومي هذا أحسَنَ ممَّا أبلاني اللهُ به، واللهِ ما تَعَمَّدتُ كَذبةً مُنذُ قُلتُ ذلك لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّم إلى يَومي هذا، وإنِّي لأرجو أن يَحفَظَني اللهُ فيما بَقيَ. قال: فأنزَلَ اللهُ عَزَّ وجَلَّ: {لقد تابَ اللهُ على النَّبيِّ والمُهاجِرينَ والأنصارِ الذينَ اتَّبَعوه في ساعةِ العُسرةِ مِن بَعدِ ما كادَ يَزيغُ قُلوبُ فريقٍ منهم ثُمَّ تابَ عليهم إنَّه بهم رَؤوفٌ رَحيمٌ وعلى الثَّلاثةِ الذينَ خُلِّفوا حتَّى إذا ضاقَت عليهمِ الأرضُ بما رَحُبَت وضاقَت عليهم أنفُسُهم} حتَّى بَلَغَ: {يا أيُّها الذينَ آمَنوا اتَّقوا اللهَ وكونوا مع الصَّادِقينَ}. قال كَعبٌ: واللهِ ما أنعَمَ اللهُ عليَّ مِن نِعمةٍ قَطُّ بَعدَ إذ هَداني اللهُ للإسلامِ أعظَمَ في نَفسي مِن ",["صِدقي رَسولَ اللهِ",1]," صلَّى اللهُ عليه وسلَّم أن لا أكونَ كَذَبتُه ",["فأهلِكَ كما هَلَكَ الذينَ كَذَبوا",2],"، إنَّ اللهَ قال للذينَ كَذَبوا حينَ أنزَلَ الوحيَ شَرَّ ما قال لأحَدٍ. وقال اللهُ: {سَيَحلِفونَ باللهِ لَكُم إذا انقَلَبتُم إليهم لتُعرِضوا عنهم فأعرِضوا عنهم إنَّهم رِجسٌ ومَأواهم جَهَنَّمُ جَزاءً بما كانوا يَكسِبونَ يَحلِفونَ لَكُم لتَرضَوا عنهم فإن تَرضَوا عنهم فإنَّ اللهَ لا يَرضى عَنِ القَومِ الفاسِقينَ}. قال كَعبٌ: كُنَّا خُلِّفنا أيُّها الثَّلاثةُ عن أمرِ أولَئِكَ الذينَ قَبِلَ منهم رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم حينَ حَلَفوا له، فبايَعَهم واستَغفَرَ لهم، وأرجَأ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم أمرَنا حتَّى قَضى اللهُ فيه، فبِذلك قال اللهُ عَزَّ وجَلَّ: وعلى الثَّلاثةِ الذينَ خُلِّفوا، وليسَ الذي ذَكَرَ اللهُ ممَّا خُلِّفنا تَخَلُّفَنا عَنِ الغَزوِ، وإنَّما هو تَخليفُه إيَّانا، وإرجاؤُه أمرَنا، عَمَّن حَلَفَ له واعتَذَرَ إليه فقَبِلَ منه. وفي روايةٍ: أنَّ عُبَيدَ اللهِ بنَ كَعبِ بنِ مالِكٍ، وكانَ قائِدَ كَعبٍ حينَ عَميَ، قال: سَمِعتُ كَعبَ بنَ مالِكٍ يُحَدِّثُ حَديثَه حينَ تَخَلَّفَ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةِ تَبوكَ، وساقَ الحَديثَ. وزادَ فيه، على يونُسَ: فكانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم قَلَّما يُريدُ غَزوةً إلَّا ورَّى بغَيرِها، حتَّى كانَت تلك الغَزوةُ."],"grade":"صحيح","narrator":"كعب بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4418)، وأحمد (15789) باختلاف يسير، والنسائي في ((الكبرى)) (11168) بنحوه.","bab":"قرآن › أسباب النزول","dorar":"MuC2vFZU"},{"id":"س-07758","fp":"b7450ee01fc3","stateId":446,"easy":"إذا كذبت واعتذرت بالباطل ← تُذكر بشر ما يُذكر به أحد","cause":"الذينَ كَذَبوا رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم مِنَ المُتَخَلِّفينَ واعتَذَروا بالباطِلِ","result":"ذُكِروا بشَرِّ ما ذُكِرَ به أحَدٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[57],"ref":"صحيح البخاري 4677","srcLabel":"مسلم","text":["سَمِعتُ أبي كَعبَ بنَ مالِكٍ -وهو أحَدُ الثَّلاثةِ الذينَ تِيبَ عليهم، أنَّه لَم يَتَخَلَّفْ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةٍ غَزاها قَطُّ، غيرَ غَزوتَينِ غَزوةِ العُسرةِ، وغَزوةِ بَدرٍ- قال: فأجمَعتُ صِدقي رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم ضُحًى، وكان قَلَّما يَقدَمُ مِن سَفَرٍ سافَرَه إلَّا ضُحًى، وكان يَبدَأُ بالمَسجِدِ فيَركَعُ رَكعَتَينِ، ونَهى النَّبيُّ صلَّى اللهُ عليه وسلَّم عن كَلامي، وكَلامِ صاحِبَيَّ، ولَم يَنهَ عن كَلامِ أحَدٍ مِنَ المُتَخَلِّفينَ غيرِنا، فاجتَنَبَ النَّاسُ كَلامَنا، فلَبِثتُ كَذلك حتَّى طالَ عليَّ الأمرُ، وما مِن شيءٍ أهَمُّ إليَّ مِن أن أموتَ فلا يُصَلِّي عليَّ النَّبيُّ صلَّى اللهُ عليه وسلَّم، أو يَموتَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم فأكونَ مِنَ النَّاسِ بتلك المَنزِلةِ فلا يُكَلِّمُني أحَدٌ منهم، ولا يُصَلِّي ولا يُسَلِّمُ عليَّ، فأنزَلَ اللهُ تَوبَتَنا على نَبيِّه صلَّى اللهُ عليه وسلَّم، حينَ بَقيَ الثُّلُثُ الآخِرُ مِنَ اللَّيلِ، ورَسولُ اللهِ صلَّى اللهُ عليه وسلَّم عِندَ أُمِّ سَلَمةَ، وكانَت أُمُّ سَلَمةَ مُحسِنةً في شَأني مَعنيَّةً في أمري، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: يا أُمَّ سَلَمةَ تيبَ على كَعبٍ، قالت: أفلا أُرسِلُ إليه فأُبَشِّرَه؟ قال: إذًا يَحطِمَكُمُ النَّاسُ، فيَمنَعونَكُمُ النَّومَ سائِرَ اللَّيلةِ، حتَّى إذا صَلَّى رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم صَلاةَ الفَجرِ آذَنَ بتَوبةِ اللهِ علينا، وكان إذا استَبشَرَ استَنارَ وجهُه، حتَّى كَأنَّه قِطعةٌ مِنَ القَمَرِ، وكُنَّا أيُّها الثَّلاثةُ الذينَ خُلِّفوا عَنِ الأمرِ الذي قُبِلَ مِن هؤلاء الذينَ اعتَذَروا، حينَ أنزَلَ اللهُ لَنا التَّوبةَ، فلَمَّا ذُكِرَ ",["الذينَ كَذَبوا رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم مِنَ المُتَخَلِّفينَ واعتَذَروا بالباطِلِ",1],"، ",["ذُكِروا بشَرِّ ما ذُكِرَ به أحَدٌ",2],"، قال اللهُ سُبحانَه: {يَعتَذِرونَ إليكُم إذا رَجَعتُم إليهم قُلْ لا تَعتَذِروا لَن نُؤمِنَ لَكُم قد نَبَّأَنَا اللهُ مِن أخبارِكُم وسَيَرى اللهُ عَمَلَكُم ورَسولُه} الآيةَ."],"grade":"صحيح","narrator":"كعب بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البيهقي في ((دلائل النبوة)) (3/ 28)، وابن الحداد في ((جامع الصحيحين)) (3760) واللفظ لهما، ومسلم (2769) بنحوه.","bab":"قرآن › أسباب النزول","dorar":"YiEEOMPe"},{"id":"س-02702","fp":"6c702bb9fd94","stateId":446,"easy":"إذا تكهنت أو استقسمت أو رجعت من سفر تطيراً ← لن تنال الدرجات العلا","cause":"من تَكَهَّنَ أو استقسَمَ أو رجعَ من سفرٍ تَطيُّرًا","result":"لن يَنالَ الدَّرجاتِ العُلا","explicit":true,"otherNeedIds":[20],"ref":"الزواجر عن اقتراف الكبائر 1/150","srcLabel":"الطبراني","text":[["لن يَنالَ الدَّرجاتِ العُلا",2]," ",["من تَكَهَّنَ أو استقسَمَ أو رجعَ من سفرٍ تَطيُّرًا",1]],"grade":"صحيح","narrator":"[أبو الدرداء]","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (2663)، وأبو نعيم في ((حلية الأولياء)) (5/174)، والبيهق في ((شعب الإيمان)) (10739) مطولاً باختلاف يسير.","bab":"إيمان › السحر والنشرة والكهانة","dorar":"iLsxGNH3"},{"id":"س-04067","fp":"a323e3fff887","stateId":446,"easy":"إذا ناصحت الظلمة وآزرتهم ← هلكت وأهلكت","cause":"فمن ناصَحَهم وآزَرَهم و شدَّ على أعضادِهم","result":"فأولئِك قد هلكُوا و أهلكُوا","explicit":true,"ref":"السلسلة الصحيحة 457","srcLabel":"الطبراني","text":["قام فينا رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم خطيبا فكان من خطبتِه أن قال ألا إني أُوشِكُ أن أُدْعَى فأُجيبُ ، فيليكُم عمالٌ من بعدي ، يقولون ما يعلمون ، و يعملونَ بما يعرفونَ ، و طاعةُ أولئِك طاعةٌ ، فتلبثون كذلك دهرًا ، ثم يليكُم عمالٌ من بعدِهم يقولون مالا يعلمونَ ، و يعملونَ مالا يعرفونَ ، ",["فمن ناصَحَهم وآزَرَهم و شدَّ على أعضادِهم",1]," ، ",["فأولئِك قد هلكُوا و أهلكُوا",2]," ، خالطُوهم بأجسادِكم ، و زايلُوهم بأعمالِكم ، و اشهدوا على المحسنِ بأنَّهُ محسنٌ ، و على المسيءِ بأنَّهُ مسيءٌ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6988) بلفظه، والبيهقي في ((الزهد)) (191) بلفظ مقارب.","bab":"جمعة › خطبة النبي صلى الله عليه وسلم","dorar":"NlvJLnBS"},{"id":"س-06009","fp":"bc8fddb945de","stateId":446,"easy":"إذا فجرت ← فالفجور أعجز العجز","cause":"الفجورُ","result":"أعجزَ العجزِ","explicit":true,"ref":"فتح الباري لابن حجر 13/68","srcLabel":"البيهقي","text":["لما صالح الحسنُ بنُ عليٍّ معاويةَ قال له معاويةُ قم فتكلم فقام فحمدَ اللهَ وأثنى عليه ثم قال أما بعدُ فإنَّ أكيسَ الكيِّسَ التُّقَى وإن ",["أعجزَ العجزِ",2]," ",["الفجورُ",1]," ألا وإنَّ هذا الأمرَ الذي اختلفتُ فيه أنا ومعاويةُ حقٌّ لامرئٍ كان أحقَّ به مني أو حقٌّ لي تركتُه لإرادةِ إصلاحِ المسلمين وحقنِ دمائِهم وإن أدري لعلَّهُ فتنةٌ لكم ومتاعٌ إلى حينٍ ثم استغفرَ ونزل"],"grade":"صحيح","narrator":"الشعبي عامر بن شراحيل","muhaddith":"محفوظ","takhrij":"أخرجه سعيد بن منصور في ((السنن)) (6092)، والبيهقي (17157) باختلاف يسير، وابن أبي شيبة (38527) بنحوه","bab":"رقائق وزهد › تقوى الله","dorar":"lkwHFKDI"},{"id":"س-05625","fp":"0b3bec6df959","stateId":446,"easy":"إذا زرعت شراً ← توشك أن تحصد ندامة","cause":"من زرعَ شرًّا","result":"يوشكُ أن يحصدَ ندامةً","explicit":true,"ref":"مجمع الزوائد 2/192","srcLabel":"السنة","text":["عن عبدِ اللَّهِ بنِ مسعودٍ أنَّهُ كانَ يقولُ إذا قعدَ إنَّكم في ممرِّ اللَّيلِ والنَّهارِ في آجالٍ منقوضةٍ وأعمالٍ محفوظةٍ والموتُ يأتي بغتةً فمن زرعَ خيرًا يوشِكُ أن يحصدَ رغبةً و",["من زرعَ شرًّا",1]," ",["يوشكُ أن يحصدَ ندامةً",2]," ولكلِّ زارعٍ ما زرعَ لا يسبقُ بطيءٌ بحظِّهِ ولا يدركُ حريصٌ بحرصهِ ما لم يقدَّر لهُ فمن أعطيَ خيرًا فاللَّهُ أعطاهُ ومن وُقيَ شرًّا فاللَّهُ وقاهُ المتَّقونَ سادةٌ والفقهاءُ قادةٌ ومجالستُهم زيادةٌ"],"grade":"حسن","muhaddith":"رجاله موثقون","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"PnV6D4wI"},{"id":"س-06927","fp":"28946479e411","stateId":446,"easy":"إذا حُرم أهل بيت الرفق ← حُرموا الخير","cause":"ما من أهلِ بيتٍ يُحرَمون الرِّفقَ","result":"إلا حُرِموا الخيرَ","explicit":true,"ref":"صحيح الترغيب 2666","srcLabel":"الطبراني","text":["إنَّ اللهَ عزَّ وجلَّ لَيُعطي على الرِّفقِ ما لا يُعطي على الخرقِ وإذا أحبَّ اللهُ عبدًا أعطاه الرِّفقَ ، ",["ما من أهلِ بيتٍ يُحرَمون الرِّفقَ",1]," ؛ ",["إلا حُرِموا الخيرَ",2]," ."],"grade":"حسن","narrator":"جرير بن عبدالله","muhaddith":"حسن لغيره","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (2/ 306) (2274)، وابن العديم في ((تاريخ حلب)) (7/ 3334)، وابن أبي الدنيا في ((ذم الغضب)) كما في ((كنز العمال)) (5459) واللفظ لهم.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"6x5bGN95"},{"id":"س-07268","fp":"fac30e6bfebb","stateId":446,"easy":"إذا خالطت أمراء الجور ← هلكت","cause":"ومَنْ خالَطَهم","result":"هَلَكَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الجامع 3661","srcLabel":"الطبراني","text":["سيكونُ أمراءٌ تعرِفونَ و تُنكِرونَ، فمَنْ نابَذَهمْ نَجَا، ومَنْ اعتزَلَهم سلِمَ، ",["ومَنْ خالَطَهم",1]," ",["هَلَكَ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي شيبة في ((المصنف)) (38898)، والطبراني (11/40) (10973)، وابن عدي في ((الكامل في الضعفاء)) (7/132) باختلاف يسير.","bab":"فتن › أمراء الجور","dorar":"YVAi1vMQ"},{"id":"س-07991","fp":"823a81936c02","stateId":446,"easy":"إذا أعنت قومك على غير الحق ← فمثلك كبعير تردّى يُجرّ بذنبه","cause":"الذي يُعينُ قومَه على غيرِ الحقِّ","result":"مثلُ بعيرٍ تردَّى ، و هو يُجَرُّ بذَنَبِه","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"صحيح الجامع 5838","srcLabel":"أبو داود","text":["مثلُ ",["الذي يُعينُ قومَه على غيرِ الحقِّ",1]," ، ",["مثلُ بعيرٍ تردَّى ، و هو يُجَرُّ بذَنَبِه",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5117) باختلاف يسير، وأحمد (3801) مطولاً","bab":"مظالم › تحريم الظلم","dorar":"A5fvdCRK"},{"id":"س-01112","fp":"ce4f3221f7a2","stateId":447,"easy":"إذا تفرقتم من مجلس لم تذكروا الله فيه ← فكأنما تفرقتم عن جيفة حمار","cause":"وما من قومٍ يجلسون مجلسًا فيتفرَّقون عنه لم يذكروا الله","result":"إلا كأنما تفرَّقوا عن جيفةِ حمارٍ","explicit":true,"star":true,"ref":"السلسلة الصحيحة 1/357","srcLabel":"البخاري","text":["قال لي أبي [ يعني قُرَّةَ بنَ إياسٍ ] : يا بُنيَّ إن كنتَ في مجلسٍ ترجو خيرَه فعجلتْ بك حاجةٌ فقل : سلامٌ عليكم فإنك تُشركُهم فيما أصابوا في ذلك المجلسِ ",["وما من قومٍ يجلسون مجلسًا فيتفرَّقون عنه لم يذكروا الله",1]," ",["إلا كأنما تفرَّقوا عن جيفةِ حمارٍ",2]],"grade":"صحيح","narrator":"معاوية بن قرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (1009) واللفظ له، والطبراني في ((المعجم الكبير)) (52) (19/ 25)، وأبو نعيم في ((حلية الأولياء)) (2/ 301) بالفقرة الأولى فقط.","bab":"أدعية وأذكار › فضل الذكر","dorar":"C96His8V","merged":2,"otherRefs":["المستدرك على الصحيحين 1833 (صحيح)"]},{"id":"س-01047","fp":"300565b20572","stateId":447,"easy":"إذا تفرقتم من مجلس عن غير ذكر الله ← تتفرقون عن مثل جيفة حمار","cause":"ما جلَسَ قَومٌ مَجلِسًا، فتفَرَّقوا عن غَيرِ ذِكْرِ اللهِ","result":"إلَّا تفَرَّقوا عن مِثلِ جِيفةِ حِمارٍ، وكان ذلك المَجلسُ حَسرةً عليهم يَومَ القيامةِ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 10825","srcLabel":"مسلم","text":[["ما جلَسَ قَومٌ مَجلِسًا، فتفَرَّقوا عن غَيرِ ذِكْرِ اللهِ،",1]," ",["إلَّا تفَرَّقوا عن مِثلِ جِيفةِ حِمارٍ، وكان ذلك المَجلسُ حَسرةً عليهم يَومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أبو داود (4856)، والنسائي في ((السنن الكبرى)) (10236)، وأحمد (10825) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"0p9BBJoI","merged":2,"otherRefs":["تخريج المسند لشعيب 9052 (صحيح)"]},{"id":"س-00784","fp":"314451f7fc7e","stateId":447,"easy":"إذا اجتمعتم ثم تفرقتم من غير ذكر الله والصلاة على النبي ﷺ ← تقومون عن أنتن من جيفة","cause":"ما اجتَمَعَ قَومٌ ثُمَّ تَفرَّقوا مِن غَيرِ ذِكرِ اللهِ عَزَّ وجَلَّ وصَلاةٍ على النَّبيِّ","result":"إلَّا قاموا عَن أنتَنَ مِن جيفةٍ","explicit":true,"star":true,"ref":"سبل الهدى والرشاد 12/420","srcLabel":"مسلم","text":["«",["ما اجتَمَعَ قَومٌ ثُمَّ تَفرَّقوا مِن غَيرِ ذِكرِ اللهِ عَزَّ وجَلَّ وصَلاةٍ على النَّبيِّ",1]," صلَّى الله عليه وسلَّم، ",["إلَّا قاموا عَن أنتَنَ مِن جيفةٍ",2],"»"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"على شرط مسلم","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"z1jOQeoI"},{"id":"ق-0727","fp":"402bc85cffd9","stateId":447,"easy":"الغفلة عن ذكر الله واتباع الهوى ← ضياع الأمر (فُرُطاً)","cause":"الغفلة عن ذكر الله واتباع الهوى","result":"ضياع الأمر (فُرُطاً)","explicit":true,"star":true,"otherNeedIds":[19],"ref":"سورة الكهف: 28","srcLabel":"القرآن الكريم","quran":{"s":18,"from":28,"to":28,"text":"وَاصْبِرْ نَفْسَكَ مَعَ الَّذِينَ يَدْعُونَ رَبَّهُمْ بِالْغَدَاةِ وَالْعَشِيِّ يُرِيدُونَ وَجْهَهُ وَلَا تَعْدُ عَيْنَاكَ عَنْهُمْ تُرِيدُ زِينَةَ الْحَيَاةِ الدُّنْيَا وَلَا تُطِعْ مَنْ أَغْفَلْنَا قَلْبَهُ عَنْ ذِكْرِنَا وَاتَّبَعَ هَوَاهُ وَكَانَ أَمْرُهُ فُرُطًا (28)","hl":[[170,267,1]]}},{"id":"ق-0873","fp":"d80ab654a78f","stateId":447,"easy":"الانغماس في المتاع حتى نسيان الذكر ← البوار","cause":"الانغماس في المتاع حتى نسيان الذكر","result":"البوار","explicit":true,"star":true,"otherNeedIds":[19],"ref":"سورة الفرقان: 18","srcLabel":"القرآن الكريم","quran":{"s":25,"from":18,"to":18,"text":"قَالُوا سُبْحَانَكَ مَا كَانَ يَنْبَغِي لَنَا أَنْ نَتَّخِذَ مِنْ دُونِكَ مِنْ أَوْلِيَاءَ وَلَكِنْ مَتَّعْتَهُمْ وَآبَاءَهُمْ حَتَّى نَسُوا الذِّكْرَ وَكَانُوا قَوْمًا بُورًا (18)","hl":[[91,175,1]]}},{"id":"ق-1339","fp":"1ce928888429","stateId":447,"easy":"الالتهاء بالأموال والأولاد عن ذكر الله ← الخسران","cause":"الالتهاء بالأموال والأولاد عن ذكر الله","result":"الخسران","explicit":true,"ref":"سورة المنافقون: 9","srcLabel":"القرآن الكريم","quran":{"s":63,"from":9,"to":9,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تُلْهِكُمْ أَمْوَالُكُمْ وَلَا أَوْلَادُكُمْ عَنْ ذِكْرِ اللَّهِ وَمَنْ يَفْعَلْ ذَلِكَ فَأُولَئِكَ هُمُ الْخَاسِرُونَ (9)","hl":[[31,153,1]]}},{"id":"س-01062","fp":"70b3071f9c39","stateId":447,"easy":"إذا اشتغلت بغير ذكر الله ← فهو لعب","cause":"كُلُّ شيءٍ ليْسَ من ذِكْرِ اللهِ","result":"فهو لَعِبٌ","explicit":true,"ref":"تخريج مشكل الآثار 1/ 271","srcLabel":"السنة","text":["عَنْ عطاءِ بنِ أبي رَباحٍ قَالَ: رَأَيْتُ جابرَ بنَ عبدِ اللهِ، وجابرَ بنَ عُمَيرٍ الأنْصارِيَّينِ يَرتَميانِ، فمَلَّ أحَدُهما، فجلَس، فقال له الآخَرُ: كسِلْتَ؟ قال: نَعمْ. قال: أمَا إنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["كُلُّ شيءٍ ليْسَ من ذِكْرِ اللهِ",1]," ",["فهو لَعِبٌ",2],"، إلَّا أربعةً: مُلاعبةُ الرَّجُلِ امرأتَهُ، وتأديبُ الرَّجُلِ فرَسَهُ، ومَشيُ الرَّجُلِ بيْنَ الغَرَضَيْنِ، وتَعليمُ الرَّجُلِ السِّباحةَ."],"grade":"صحيح","narrator":"جابر بن عبدالله وجابر بن عمير","muhaddith":"إسناده صحيح","bab":"أدعية وأذكار › فضل الذكر","dorar":"CSJwBp4W","merged":5,"otherRefs":["السلسلة الصحيحة 315 (صحيح)","آداب الزفاف 205 (صحيح)","الدراية تخريج أحاديث الهداية 2/240 (حسن)","تهذيب التهذيب 2/44 (صحيح)"]},{"id":"س-01046","fp":"310e08f2a3b7","stateId":447,"easy":"إذا قعدتم مقعداً لا تذكرون الله ولا تصلون على النبي ﷺ ← يكون عليكم حسرة يوم القيامة","cause":"ما قعَدَ قَومٌ مَقعَدًا لا يَذكُرون فيه اللهَ عزَّ وجلَّ، ويُصَلُّون على النَّبيِّ صلَّى اللهُ عليه وسلَّمَ","result":"إلَّا كان عليهم حَسرةً يَومَ القيامةِ، وإنْ دخَلوا الجنَّةَ؛ للثَّوابِ","explicit":true,"ref":"تخريج المسند لشعيب 9965","srcLabel":"أحمد","text":[["ما قعَدَ قَومٌ مَقعَدًا لا يَذكُرون فيه اللهَ عزَّ وجلَّ، ويُصَلُّون على النَّبيِّ صلَّى اللهُ عليه وسلَّمَ؛",1]," ",["إلَّا كان عليهم حَسرةً يَومَ القيامةِ، وإنْ دخَلوا الجنَّةَ؛ للثَّوابِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (9965) واللفظ له، وابن حبان (590) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (4834) بنحوه","bab":"أدعية وأذكار › فضل الذكر","dorar":"EbEI6eFA","merged":2,"otherRefs":["تخريج صحيح ابن حبان 591 (صحيح)"]},{"id":"س-01085","fp":"1297c560c41b","stateId":447,"easy":"إذا أطلتم الجلوس ثم تفرقتم قبل أن تذكروا الله ← كانت عليكم من الله ترة","cause":"أَيُّما قومٍ جَلَسوا فأَطالوا الجُلوسَ، ثُمَّ تَفرَّقوا قَبلَ أنْ يَذكُروا اللهَ، ويُصلُّوا على نَبيِّهِ صلَّى اللهُ عليه وسلَّمَ","result":"إلَّا كانت عليهم مِنَ اللهِ تِرَةٌ: إنْ شاءَ اللهُ عذَّبَهُم، وإنْ شاءَ غَفَرَ لهُم","explicit":true,"otherNeedIds":[57],"ref":"المستدرك على الصحيحين 1850","srcLabel":"أبو داود","text":[["أَيُّما قومٍ جَلَسوا فأَطالوا الجُلوسَ، ثُمَّ تَفرَّقوا قَبلَ أنْ يَذكُروا اللهَ، ويُصلُّوا على نَبيِّهِ صلَّى اللهُ عليه وسلَّمَ؛ ",1],["إلَّا كانت عليهم مِنَ اللهِ تِرَةٌ: إنْ شاءَ اللهُ عذَّبَهُم، وإنْ شاءَ غَفَرَ لهُم",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داود (5059)، وأحمد (9764)، والنسائي في ((الكبرى)) (10164) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"oMFtOKMF","merged":2,"otherRefs":["صحيح الجامع 2738 (صحيح)"]},{"id":"س-00716","fp":"98f7e77dce01","stateId":447,"easy":"إذا اجتمعتم في مجلس فتفرقتم ولم تذكروا الله وتصلوا على النبي ﷺ ← يكون مجلسكم عليكم ترة يوم القيامة","cause":"ما اجتمَعَ قَومٌ في مَجلِسٍ فتفَرَّقوا، ولم يَذكُروا اللهَ عزَّ وجلَّ، ويُصلُّوا على النَّبيِّ صلَّى اللهُ عليه وسلَّمَ","result":"إلَّا كان مَجلِسُهم تِرَةً عليهم يَومَ القِيامةِ","explicit":true,"similar":["س-01145","س-01143"],"ref":"تخريج المسند لشعيب 9764","srcLabel":"النسائي","text":[["ما اجتمَعَ قَومٌ في مَجلِسٍ فتفَرَّقوا، ولم يَذكُروا اللهَ عزَّ وجلَّ، ويُصلُّوا على النَّبيِّ صلَّى اللهُ عليه وسلَّمَ،",1]," ",["إلَّا كان مَجلِسُهم تِرَةً عليهم يَومَ القِيامةِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10241)، وأحمد (9764) واللفظ له","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"xxImRshO"},{"id":"س-00717","fp":"e87d43ff36c5","stateId":447,"easy":"إذا قعدتم في مجلس ثم قمتم ولم تذكروا الله فيه ← يكون عليكم حسرة يوم القيامة","cause":"إذا قعَدَ القَومُ في المَجلِسِ، ثم قاموا ولم يَذكُروا اللهَ فيه","result":"كانتْ عليهم فيه حَسرةٌ يَومَ القيامةِ","explicit":true,"ref":"تخريج المسند لشعيب 10422","srcLabel":"أحمد","text":[["إذا قعَدَ القَومُ في المَجلِسِ، ثم قاموا ولم يَذكُروا اللهَ فيه، ",1],["كانتْ عليهم فيه حَسرةٌ يَومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (10422) واللفظ له، وابن حبان (590) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (4834) بنحوه","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"vXLnkYxF"},{"id":"س-00725","fp":"a8c6510a4501","stateId":447,"easy":"إذا جلستم مجلساً لا تذكرون الله فيه ← يكون عليكم حسرة يوم القيامة وإن دخلتم الجنة","cause":"ما مِن قومٍ يجلِسونَ مجلسًا لا يذكُرونَ اللَّهَ فيهِ","result":"إلَّا كانَت عليهِمْ حَسرةٌ يومَ القيامَةِ ، وإن دخَلوا الجنَّةَ","explicit":true,"ref":"الصحيح المسند 395","srcLabel":"النسائي","text":[["ما مِن قومٍ يجلِسونَ مجلسًا لا يذكُرونَ اللَّهَ فيهِ",1]," ",["إلَّا كانَت عليهِمْ حَسرةٌ يومَ القيامَةِ ، وإن دخَلوا الجنَّةَ ",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10170)، وابن الجوزي في ((حفظ العمر)) (62) مطولا، وكلاهما بلفظه.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"Oh6zzZX4"},{"id":"س-00740","fp":"2542261e2ab7","stateId":447,"easy":"إذا تفرقتم من مجلس بغير ذكر الله والصلاة على النبي ﷺ ← يكون عليكم حسرة يوم القيامة","cause":"ما اجتمَع قومٌ في مجلِسٍ فتفرَّقوا مِن غيرِ ذِكْرِ اللهِ والصَّلاةِ على النَّبيِّ صلَّى اللهُ عليه وسلَّم","result":"إلَّا كان عليهم حسرةً يومَ القيامةِ","explicit":true,"ref":"تخريج صحيح ابن حبان 590","srcLabel":"أبو داود","text":[["ما اجتمَع قومٌ في مجلِسٍ فتفرَّقوا مِن غيرِ ذِكْرِ اللهِ والصَّلاةِ على النَّبيِّ صلَّى اللهُ عليه وسلَّم",1]," ",["إلَّا كان عليهم حسرةً يومَ القيامةِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (590) واللفظ له، وأبو داود (5059)، والترمذي (3380) كلاهما بنحوه.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"2euoLidE"},{"id":"س-00959","fp":"3562fd15c998","stateId":447,"easy":"إذا جلستم مجلساً فلم تذكروا الله ← كان عليكم ترة (حسرة ونقص)","cause":"ما جلَسَ قَومٌ مجلِسًا فلم يَذكُروا اللهَ","result":"إلَّا كان عليهم تِرَةٌ","explicit":true,"ref":"تخريج المسند لشعيب 9583","srcLabel":"أبو داود","text":[["ما جلَسَ قَومٌ مجلِسًا فلم يَذكُروا اللهَ؛",1]," ",["إلَّا كان عليهم تِرَةٌ",2],"، وما مِن رَجُلٍ مَشى طَريقًا فلم يَذكُرِ اللهَ؛ إلَّا كان عليه تِرَةٌ، وما مِن رَجُلٍ أوى إلى فِراشِه فلم يَذكُرِ اللهَ؛ إلَّا كان عليه تِرَةٌ. حدَّثَنا رَوْحٌ، قال: حدَّثَنا ابنُ أبي ذِئْبٍ، عن المَقبُريِّ عن إِسحاقَ، مَولى عَبدِ اللهِ بنِ الحارِثِ، ولم يَقُلْ: إذا أوى إلى فِراشِه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4856)، والترمذي (3380)، والنسائي في ((السنن الكبرى)) (10238)، وأحمد (9583) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"6gKCf5ET"},{"id":"س-00960","fp":"6bca17584426","stateId":447,"easy":"إذا مشيت طريقاً فلم تذكر الله ← كان عليك ترة","cause":"وما مِن رَجُلٍ مَشى طَريقًا فلم يَذكُرِ اللهَ","result":"إلَّا كان عليه تِرَةٌ","explicit":true,"ref":"تخريج المسند لشعيب 9583","srcLabel":"أبو داود","text":["ما جلَسَ قَومٌ مجلِسًا فلم يَذكُروا اللهَ؛ إلَّا كان عليهم تِرَةٌ، ",["وما مِن رَجُلٍ مَشى طَريقًا فلم يَذكُرِ اللهَ",1],"؛ ",["إلَّا كان عليه تِرَةٌ",2],"، وما مِن رَجُلٍ أوى إلى فِراشِه فلم يَذكُرِ اللهَ؛ إلَّا كان عليه تِرَةٌ. حدَّثَنا رَوْحٌ، قال: حدَّثَنا ابنُ أبي ذِئْبٍ، عن المَقبُريِّ عن إِسحاقَ، مَولى عَبدِ اللهِ بنِ الحارِثِ، ولم يَقُلْ: إذا أوى إلى فِراشِه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4856)، والترمذي (3380)، والنسائي في ((السنن الكبرى)) (10238)، وأحمد (9583) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"6gKCf5ET"},{"id":"س-00961","fp":"14ffd8c37de4","stateId":447,"easy":"إذا أويت إلى فراشك فلم تذكر الله ← كان عليك ترة","cause":"وما مِن رَجُلٍ أوى إلى فِراشِه فلم يَذكُرِ اللهَ","result":"إلَّا كان عليه تِرَةٌ","explicit":true,"ref":"تخريج المسند لشعيب 9583","srcLabel":"أبو داود","text":["ما جلَسَ قَومٌ مجلِسًا فلم يَذكُروا اللهَ؛ إلَّا كان عليهم تِرَةٌ، وما مِن رَجُلٍ مَشى طَريقًا فلم يَذكُرِ اللهَ؛ إلَّا كان عليه تِرَةٌ، ",["وما مِن رَجُلٍ أوى إلى فِراشِه فلم يَذكُرِ اللهَ",1],"؛ ",["إلَّا كان عليه تِرَةٌ",2],". حدَّثَنا رَوْحٌ، قال: حدَّثَنا ابنُ أبي ذِئْبٍ، عن المَقبُريِّ عن إِسحاقَ، مَولى عَبدِ اللهِ بنِ الحارِثِ، ولم يَقُلْ: إذا أوى إلى فِراشِه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4856)، والترمذي (3380)، والنسائي في ((السنن الكبرى)) (10238)، وأحمد (9583) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"6gKCf5ET"},{"id":"س-00981","fp":"3093fdbdd2a6","stateId":447,"easy":"إذا اضطجعت مضجعاً لم تذكر الله فيه ← كان عليك ترة يوم القيامة","cause":"مَنِ اضْطَجَعَ مَضجَعًا لم يذكُرِ اللهَ فيه","result":"إلَّا كان عليه تِرةً يومَ القيامةِ","explicit":true,"similar":["س-01015"],"ref":"تخريج سنن أبي داود 5059","srcLabel":"أبو داود","text":[["مَنِ اضْطَجَعَ مَضجَعًا لم يذكُرِ اللهَ فيه ",1],["إلَّا كان عليه تِرةً يومَ القيامةِ، ",2],"ومَن قعَدَ مَقعَدًا لم يذكُرِ اللهَ فيه إلَّا كان عليه تِرةً يومَ القيامةِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5059)، والنسائي في ((السنن الكبرى)) (10164)، والبيهقي في ((شعب الإيمان)) (541) كلاهما مطولا، وجميعا بلفظه، وأحمد (9583) بمعناه .","bab":"أدعية وأذكار › فضل الذكر","dorar":"8WtnlmOS"},{"id":"س-00982","fp":"a65da4c251b8","stateId":447,"easy":"إذا قعدت مقعداً لم تذكر الله فيه ← كان عليك ترة يوم القيامة","cause":"ومَن قعَدَ مَقعَدًا لم يذكُرِ اللهَ فيه","result":"إلَّا كان عليه تِرةً يومَ القيامةِ","explicit":true,"ref":"تخريج سنن أبي داود 5059","srcLabel":"أبو داود","text":["مَنِ اضْطَجَعَ مَضجَعًا لم يذكُرِ اللهَ فيه إلَّا كان عليه تِرةً يومَ القيامةِ، ",["ومَن قعَدَ مَقعَدًا لم يذكُرِ اللهَ فيه ",1],["إلَّا كان عليه تِرةً يومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5059)، والنسائي في ((السنن الكبرى)) (10164)، والبيهقي في ((شعب الإيمان)) (541) كلاهما مطولا، وجميعا بلفظه، وأحمد (9583) بمعناه .","bab":"أدعية وأذكار › فضل الذكر","dorar":"8WtnlmOS"},{"id":"س-01015","fp":"1439d0a848c9","stateId":447,"easy":"إذا قعدت مقعداً أو اضطجعت مضجعاً لم تذكر الله فيه ← كان عليك من الله ترة","cause":"من قعد مقعدًا لم يذكرِ اللهَ فيه","result":"كان عليه من اللهِ تِرَةٌ ، ومن اضطجع مضجعًا لا يذكرِ اللهَ فيه ؛ كانت عليه من اللهِ تِرَةٌ","explicit":true,"repOf":"س-00981","ref":"صحيح الترغيب 1512","text":[["من قعد مقعدًا لم يذكرِ اللهَ فيه ؛ ",1],["كان عليه من اللهِ تِرَةٌ ، ومن اضطجع مضجعًا لا يذكرِ اللهَ فيه ؛ كانت عليه من اللهِ تِرَةٌ ",2],". وما مشى أحدٌ ممشًى لم يذكرِ اللهَ فيه ؛ إلا كان عليه من اللهِ تِرَةٌ ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه أبو داود (4856)، والنسائي في ((السنن الكبرى)) (10237)","bab":"أدعية وأذكار › فضل الذكر","dorar":"jeV4tdyg"},{"id":"س-01018","fp":"c5ed8e221900","stateId":447,"easy":"إذا جلستم مجلساً لم تذكروا الله فيه ولم تصلوا على النبي ﷺ ← كان عليكم ترة إن شاء عذبكم وإن شاء غفر لكم","cause":"ما جلسَ قوْمٌ مجلسًا لم يذكُرُوا اللهَ تعالى فِيهِ ، ولَمْ يُصلُّوا علَى نَبِيِّهِمْ","result":"إلَّا كانَ علَيْهِمْ تِرَةٌ ، فإِنْ شاءَ عذَّبَهم ، وإِنْ شاءَ غفَرَ لَهُمْ","explicit":true,"similar":["س-01163"],"otherNeedIds":[57],"ref":"صحيح الجامع 5607","srcLabel":"السنة","text":[["ما جلسَ قوْمٌ مجلسًا لم يذكُرُوا اللهَ تعالى فِيهِ ، ولَمْ يُصلُّوا علَى نَبِيِّهِمْ ،",1]," ",["إلَّا كانَ علَيْهِمْ تِرَةٌ ، فإِنْ شاءَ عذَّبَهم ، وإِنْ شاءَ غفَرَ لَهُمْ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري وأبو هريرة","muhaddith":"صحيح","bab":"أدعية وأذكار › فضل الذكر","dorar":"2WxWwH7T"},{"id":"س-01020","fp":"576ce2f884fc","stateId":447,"easy":"إذا لم تفتتح كلامك أو أمرك ذا البال بذكر الله ← فهو أبتر (مقطوع البركة)","cause":"كلُّ كلامٍ ، أو أمرٍ ذي بالٍ لا يُفتَحُ بذِكْرِ اللَّهِ عزَّ وجلَّ","result":"فَهوَ أبترُ أو قالَ : أقطعُ","explicit":true,"ref":"تخريج المسند لشاكر 16/290","srcLabel":"أبو داود","text":[["كلُّ كلامٍ ، أو أمرٍ ذي بالٍ لا يُفتَحُ بذِكْرِ اللَّهِ عزَّ وجلَّ",1]," ",["فَهوَ أبترُ أو قالَ : أقطعُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4840)، والنسائي في ((السنن الكبرى)) (10328)، وابن ماجه (1894) بنحوه، وأحمد (8712) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"NvxdgX5j"},{"id":"س-01029","fp":"3cca876169b3","stateId":447,"easy":"إذا لم تبدأ أمرك ذا البال ببسم الله والحمد لله ← فهو أجذم أو أقطع أو أبتر","cause":"كلُّ أمرٍ ذي بالٍ لا يُبدأُ فيه ببسمِ اللهِ الرحمنِ الرحيمِ ، وبالحمدُ للهِ ، أو بحمدِ اللهِ أو بذِكرِ اللهِ","result":"فهو أجذَمُ أو أقطَعُ أو أبتَرُ","explicit":true,"ref":"شرح الأربعين لابن دقيق 14","srcLabel":"السنة","text":[["كلُّ أمرٍ ذي بالٍ لا يُبدأُ فيه ببسمِ اللهِ الرحمنِ الرحيمِ ، وبالحمدُ للهِ ، أو بحمدِ اللهِ أو بذِكرِ اللهِ",1]," ، ",["فهو أجذَمُ أو أقطَعُ أو أبتَرُ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"أدعية وأذكار › فضل الذكر","dorar":"JNIA88SI"},{"id":"س-01135","fp":"c255390c1d06","stateId":447,"easy":"إذا قمتم من مجلس لا تذكرون الله فيه ← قمتم عن مثل جيفة حمار وكان عليكم حسرة","cause":"ما من قومٍ يقومون من مجلسٍ ، لا يذكرون اللهَ تعالى فيه","result":"إلا قاموا عن مثلِ جِيفةِ حمارٍ ، و كان ذلك المجلسُ عليهم حسرةً يومَ القيامةِ","explicit":true,"ref":"صحيح الجامع 5750","srcLabel":"أبو داود","text":[["ما من قومٍ يقومون من مجلسٍ ، لا يذكرون اللهَ تعالى فيه ،",1]," ",["إلا قاموا عن مثلِ جِيفةِ حمارٍ ، و كان ذلك المجلسُ عليهم حسرةً يومَ القيامةِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4855)، والنسائي في ((السنن الكبرى)) (10241)، وأحمد (10680) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"NTCBRqoM"},{"id":"س-01145","fp":"c03b2f346de1","stateId":447,"easy":"إذا اجتمعتم في مجلس فتفرقتم ولم تذكروا الله ← كان المجلس حسرة عليكم يوم القيامة","cause":"ما مِن قومٍ اجتمَعوا في مَجْلِسٍ فتفرَّقوا ولم يذكُروا اللهَ عَزَّ وجَلَّ","result":"إلَّا كان ذلك المَجْلِسُ حَسْرةً عليهم يومَ القيامةِ","explicit":true,"repOf":"س-00716","ref":"مجمع الزوائد 10/83","text":[["ما مِن قومٍ اجتمَعوا في مَجْلِسٍ فتفرَّقوا ولم يذكُروا اللهَ عَزَّ وجَلَّ",1]," ",["إلَّا كان ذلك المَجْلِسُ حَسْرةً عليهم يومَ القيامةِ",2]],"grade":"صحيح","narrator":"عبدالله بن مغفل","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (2/185)، والطبراني في ((المعجم الأوسط)) (3744) واللفظ له، وأبو نعيم في ((معرفة الصحابة)) (4521).","bab":"أدعية وأذكار › فضل الذكر","dorar":"hHLDI7U8"},{"id":"س-01163","fp":"ef6c6175660b","stateId":447,"easy":"إذا جلستم مجلساً لم تذكروا الله ولم تصلوا على النبي ﷺ ← كان عليكم ترة يوم القيامة","cause":"ما جلَسَ قومٌ مجلِسًا لَمْ يذكُروا اللهَ فيهِ، ولَمْ يُصلُّوا فيهِ على النَّبيِّ صلَّى اللهُ عليه وسلَّمَ","result":"إلَّا كانَ عليهِمْ تِرَةً يومَ القيامةِ، إنْ شاءَ عَفَا عنهُمْ، وإنْ شاءَ أخذَهُمْ بِها","explicit":true,"repOf":"س-01018","ref":"تخريج شرح السنة 1254","text":["قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["ما جلَسَ قومٌ مجلِسًا لَمْ يذكُروا اللهَ فيهِ، ولَمْ يُصلُّوا فيهِ على النَّبيِّ صلَّى اللهُ عليه وسلَّمَ،",1]," ",["إلَّا كانَ عليهِمْ تِرَةً يومَ القيامةِ، إنْ شاءَ عَفَا عنهُمْ، وإنْ شاءَ أخذَهُمْ بِها",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3380)، والطبراني ((الدعاء)) (1923) كلاهما بلفظه، وأحمد (10277) بلفظ مقارب.","bab":"أدعية وأذكار › فضل الذكر","dorar":"5WBcYvjW"},{"id":"س-01157","fp":"623313c7ed9d","stateId":447,"easy":"إذا مرت بك ساعة لم تذكر الله فيها ← تتحسر عليها في الجنة","cause":"ساعَةٍ مرَّت بِهِم لم يذكُروا اللَّهَ عزَّ وجلَّ فيها","result":"ليسَ يتحسَّرُ أَهلُ الجنَّةِ","explicit":true,"ref":"الجامع الصغير 7682","srcLabel":"الطبراني","text":[["ليسَ يتحسَّرُ أَهلُ الجنَّةِ",2]," على شيءٍ إلَّا على ",["ساعَةٍ مرَّت بِهِم لم يذكُروا اللَّهَ عزَّ وجلَّ فيها",1]," ."],"grade":"حسن","narrator":"معاذ بن جبل","muhaddith":"حسن","takhrij":"أخرجه الطبراني (182) (20/ 93)، وابن السني في ((عمل اليوم والليلة)) (6)، والبيهقي في ((شعب الإيمان)) (509) واللفظ لهم جميعا.","bab":"أدعية وأذكار › فضل الذكر","dorar":"U1BagEQF","merged":2,"otherRefs":["المتجر الرابح 205 (حسن)"]},{"id":"س-01143","fp":"16a30e273742","stateId":447,"easy":"إذا قمتم من مجلس لم تذكروا الله ولم تصلوا على النبي ﷺ ← كان المجلس عليكم ترة","cause":"ما من قومٍ جلسوا مجلِسًا ثمَّ قاموا منه لم يذكروا اللهَ ولم يُصلُّوا على النَّبيِّ صلَّى اللهُ عليه وسلَّم","result":"إلَّا كان ذلك المجلسُ عليهم تِرةً","explicit":true,"repOf":"س-00716","ref":"القول البديع 220","text":[["ما من قومٍ جلسوا مجلِسًا ثمَّ قاموا منه لم يذكروا اللهَ ولم يُصلُّوا على النَّبيِّ صلَّى اللهُ عليه وسلَّم ،",1]," ",["إلَّا كان ذلك المجلسُ عليهم تِرةً",2]],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"إسناده رجاله ثقات","takhrij":"أخرجه الطبراني (8/213) (7751)","bab":"أدعية وأذكار › فضل الذكر","dorar":"OqcdbOkh"},{"id":"س-01144","fp":"9e58e28eace5","stateId":447,"easy":"إذا جلست أو اضطجعت أو مشيت لا تذكر الله ← كان عليك ترة يوم القيامة","cause":"ما جلسَ رجلٌ مجلسًا ولا أضجعَ مضجعًا ولا مشَى ممشى لا يذكرُ اللهَ فيهِ","result":"إلا كانَ تِرَةً عليهِ يومَ القيامةِ","explicit":true,"ref":"إتقان ما يحسن 2/496","srcLabel":"أبو داود","text":[["ما جلسَ رجلٌ مجلسًا ولا أضجعَ مضجعًا ولا مشَى ممشى لا يذكرُ اللهَ فيهِ",1]," ",["إلا كانَ تِرَةً عليهِ يومَ القيامةِ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه أبو داود (4856)، والترمذي (3380)، والنسائي في ((السنن الكبرى)) (10238)، وأحمد (9583) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"toneGyBR"},{"id":"س-00992","fp":"1b5144251ab7","stateId":448,"easy":"إذا ذكرتم الله ولم تصلّوا على النبي ﷺ ← كان المجلس عليكم ترة","cause":"ما جَلَسَ قومٌ يَذكُرونَ اللهَ لمْ يُصلُّوا على نَبيِّهِم صلَّى اللهُ عليه وسلَّمَ","result":"إلَّا كان ذلك المَجلسُ عليهم تِرَةً، ولا قَعَدَ قومٌ لمْ يَذكُروا اللهَ؛ إلَّا كان ذلك عليهم تِرَةً","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 2043","srcLabel":"البخاري","text":[["ما جَلَسَ قومٌ يَذكُرونَ اللهَ لمْ يُصلُّوا على نَبيِّهِم صلَّى اللهُ عليه وسلَّمَ؛",1]," ",["إلَّا كان ذلك المَجلسُ عليهم تِرَةً، ولا قَعَدَ قومٌ لمْ يَذكُروا اللهَ؛ إلَّا كان ذلك عليهم تِرَةً",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط البخاري","takhrij":"أخرجه أبو داود (5059)، وأحمد (9764)، والنسائي في ((الكبرى)) (10164) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"xo1ooBsI"},{"id":"س-02122","fp":"7dc303a4cf57","stateId":448,"easy":"إذا كفرت ← تُطعم بحسناتك في الدنيا ولا حسنة لك في الآخرة","cause":"وأمَّا الكافرُ","result":"فيُطعَمُ بحسناتِه في الدُّنيا، فإذا لقِيَ اللهَ يومَ القيامةِ، لم تكُنْ له حَسَنةٌ يُعْطى بها خَيرًا","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 12264","srcLabel":"مسلم","text":["إنَّ اللهَ لا يَظلِمُ المُؤمِنَ حَسَنةً، يُثابُ عليها الرزقَ في الدُّنيا، ويُجْزى بها في الآخِرةِ، ",["وأمَّا الكافرُ",1]," ",["فيُطعَمُ بحسناتِه في الدُّنيا، فإذا لقِيَ اللهَ يومَ القيامةِ، لم تكُنْ له حَسَنةٌ يُعْطى بها خَيرًا",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (2808)، وأحمد (12264) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Pnmtisrn","merged":2,"otherRefs":["صحيح الجامع 1853 (صحيح)"]},{"id":"س-03038","fp":"c51e7d538a9a","stateId":448,"easy":"إذا ذُكر النبي ﷺ عندك فلم تصلِّ عليه ← بعُدت","cause":"مَن ذُكِرْتَ عندَهُ، فلمْ يُصَلِّ عليكَ","result":"بَعُدَ","explicit":true,"ref":"المستدرك على الصحيحين 7462","srcLabel":"مالك","text":["قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: احضُرُوا المِنْبَرَ، فحضَرْنا، فلمَّا ارتَقى درَجةً قالَ: آمِين، فلمَّا ارتَقَى الدَّرَجةَ الثَّانِيةَ قالَ: آمِينَ، فلمَّا ارتقَى الدَّرَجةَ الثَّالثةَ قالَ: آمِينَ، فلمَّا نزَلَ قُلْنا: يا رسولَ اللهِ، لقَدْ سَمِعْنا منكَ اليومَ شيئًا ما كُنَّا نَسمَعُه، قالَ: إنَّ جِبريلَ عليهِ السَّلامُ عرَضَ لي فقال: بَعُدَ مَن أدرَكَ رمَضانَ فلَمْ يُغْفَرْ له، قلْتُ: آمِينَ، فلمَّا رَقِيتُ الثَّانيةَ، قالَ: بَعُدَ ",["مَن ذُكِرْتَ عندَهُ، فلمْ يُصَلِّ عليكَ",1],"، قلْتُ: آمِينَ، فلمَّا رَقِيتُ الثَّالثةَ قالَ: ",["بَعُدَ",2]," مَن أدْركَ أبويهِ الكِبَرُ عندَهُ أو أحدَهُما، فلمْ يُدْخِلاهُ الجنَّةَ، قلْتُ: آمِينَ."],"grade":"صحيح","narrator":"كعب بن عجرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني (19/ 144) (315)، والقاضي إسماعيل المالكي في ((فضل الصلاة على النبي)) (19)، وابن شاهين في ((فضائل رمضان)) (ص131) بلفظ قريب.","bab":"إيمان › الوعيد","dorar":"jaa1VQvy","merged":3,"otherRefs":["نيل الأوطار 2/323 (حسن)","صحيح الأدب المفرد 500 (صحيح)"]},{"id":"س-00783","fp":"456d8d0af9da","stateId":448,"easy":"إذا جلستم مجلساً لا تصلّون فيه على النبي ﷺ ← يكون عليكم حسرة وإن دخلتم الجنة","cause":"لا يَجلِسُ قَومٌ مَجلسًا لا يُصَلُّونَ فيه على رَسولِ اللهِ صلَّى الله عليه وسلَّم","result":"إلَّا كان عليهم حَسرةً، وإن دَخَلوا الجَنَّةَ؛ لِما يَرَونَ مِنَ الثَّوابِ","explicit":true,"ref":"سبل الهدى والرشاد 12/420","srcLabel":"البيهقي","text":[["لا يَجلِسُ قَومٌ مَجلسًا لا يُصَلُّونَ فيه على رَسولِ اللهِ صلَّى الله عليه وسلَّم",1]," ",["إلَّا كان عليهم حَسرةً، وإن دَخَلوا الجَنَّةَ؛ لِما يَرَونَ مِنَ الثَّوابِ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح.","takhrij":"أخرجه الدينوري في ((المجالسة وجواهر العلم)) (127)، وأبو بكر الشافعي في ((الفوائد)) (321)، والبيهقي في ((شعب الإيمان)) (1470) بلفظه.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"AKQGeTvN"},{"id":"س-00825","fp":"fafba2ac9ada","stateId":448,"easy":"إذا ذُكر النبي ﷺ عندك فلم تصلِّ عليه ← رغم أنفك","cause":"امرِئٍ ذُكِرتُ عِندَه فلَم يُصَلِّ عليَّ","result":"رَغِمَ أنفُ","explicit":true,"ref":"مجموع الشروح الفقهية. 19/21","srcLabel":"الترمذي","text":[["رَغِمَ أنفُ",2],[" امرِئٍ ذُكِرتُ عِندَه فلَم يُصَلِّ عليَّ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3545)، وأحمد (7451)، وابن خزيمة (1888) بلفظه وفيه زيادة.","bab":"أدعية وأذكار › دعاء النبي على بعض الأشخاص والأشياء والأمور","dorar":"cki2ITv3"},{"id":"س-03259","fp":"b0ea569915ea","stateId":448,"easy":"إذا ذُكر النبي ﷺ عندك فلم تصلِّ عليه ← أبعدك الله","cause":"ومَنْ ذُكِرْتَ عندَهُ فلمْ يُصَلِّ عليكَ","result":"فَأَبْعَدَهُ اللهُ ، قُلْ : آمِينَ","explicit":true,"ref":"صحيح الموارد 2024","srcLabel":"ابن حبان","text":["صَعِدَ رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ المِنْبَرَ فلمَّا رَقِيَ عَتَبَةً قال : آمِينَ ، ثُمَّ رَقِيَ [ عَتَبَةً ] أُخْرَى فقال : آمِينَ ، ثُمَّ رَقِيَ عَتَبَةً ثَالِثَةً فقال : آمِينَ ، ثُمَّ قال : أتاني جبريلُ فقال : يا محمدُ ! مَنْ أَدْرَكَ رَمَضَانَ فلمْ يُغْفَرْ لهُ ؛ فَأَبْعَدَهُ اللهُ ، فقُلْتُ : آمِينَ ! قال : ومَنْ أَدْرَكَ والدَيْهِ أوْ أحدَهُما، فَدخلَ النارَ ؛ فَأَبْعَدَهُ اللهُ ، فقُلْتُ : آمِينَ ! [ ف ] قال : ",["ومَنْ ذُكِرْتَ عندَهُ فلمْ يُصَلِّ عليكَ ؛ ",1],["فَأَبْعَدَهُ اللهُ ، قُلْ : آمِينَ ",2],"، فقُلْتُ : آمِينَ !"],"grade":"صحيح","narrator":"مالك بن الحويرث","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن حبان (409) واللفظ له، والطبراني (19/291) (649)، وابن عدي في ((الكامل في الضعفاء)) (6/381)","bab":"استغفار › أسباب المغفرة","dorar":"DBefBLRN"},{"id":"س-00768","fp":"7ea7fa6cf851","stateId":448,"easy":"إذا ذُكر النبي ﷺ عندك فلم تصلِّ عليه ← فقد شقيت","cause":"من ذُكِرْتُ عندَه ولم يُصلِّ عليَّ","result":"فقد شقِيَ","explicit":true,"ref":"النوافح العطرة 379","srcLabel":"الطبراني","text":[["من ذُكِرْتُ عندَه ولم يُصلِّ عليَّ ",1],["فقد شقِيَ",2]],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (3871) مطولاً، وابن السني في ((عمل اليوم والليلة)) (381)","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"MAchPpgO"},{"id":"س-05098","fp":"d91e99407854","stateId":449,"easy":"إذا تمادحتم ← فهو الذبح","cause":"وإيَّاكم والتَّمادُحَ","result":"فإنَّه الذَّبحُ","explicit":true,"star":true,"otherNeedIds":[12],"ref":"تخريج المسند لشعيب 16846","srcLabel":"متفق عليه","text":["كان مُعاويةُ قَلَّما يُحَدِّثُ عن النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، قال: فكان قَلَّما يَكادُ أنْ يَدَعَ يَومَ الجُمُعةِ هؤلاء الكَلِماتِ أنْ يُحَدِّثَ بهنَّ عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؛ يقولُ: مَن يُرِدِ اللهُ به خَيرًا يُفَقِّهْهُ في الدِّينِ، وإنَّ هذا المالَ حُلْوٌ خَضِرٌ، فمَن يأخُذْهُ بحَقِّه يُبارَكْ له فيه، ",["وإيَّاكم والتَّمادُحَ",1],"؛ ",["فإنَّه الذَّبحُ",2],"."],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (221، 3743) مفرقاً، وأحمد (16846) واللفظ له، وأخرج البخاري (71)، ومسلم (1037) لفظ: (( من يرد الله به خيرا، يفقهه في الدين))","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ICTG6cFU","merged":3,"otherRefs":["صحيح الأدب المفرد 256 (صحيح)","تخريج المسند لشعيب 16837 (صحيح)"]},{"id":"س-00340","fp":"5fdf07b926c4","stateId":449,"easy":"إذا نُزع الرفق من شيء ← شانه","cause":"ولم يُنزَعْ مِن شَيءٍ","result":"إلَّا شانه","explicit":true,"star":true,"ref":"الأحاديث المختارة 1669","srcLabel":"البخاري","text":["«دخلوا على النَّبيِّ صلَّى اللهُ عليه وسلَّم -يعني اليهودَ- فقالوا: السَّامُ عليك، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: السَّامُ عليكم، فقالت عائِشةُ: بل عليكم السَّامُ ولعْنَتُه وغَضَبُه يا إخوانَ القِرَدةِ والخنازيرِ، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: مَهْ يا عائِشةُ؟ فقالت: أمَّا سَمِعْتَ ما قالوا يا رَسولَ اللهِ؟ قال: وما سَمِعْتِ ما ردَدْتُ عليهم، يا عائِشةُ إنَّ الرِّفْقَ لم يدخُلْ في شَيءٍ إلَّا زانه، ",["ولم يُنزَعْ مِن شَيءٍ",1]," ",["إلَّا شانه",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"x4PsaH1h","merged":2,"otherRefs":["صحيح مسلم 2594 (صحيح)"]},{"id":"س-00422","fp":"bc48249e0a2a","stateId":449,"easy":"إذا أكثرت اللعن ← فلا ينبغي للصديق أن يكون لعّاناً","cause":"لعَّانًا","result":"لا يَنبَغي للصِّدِّيقِ أنْ يكونَ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 8782","srcLabel":"مسلم","text":[["لا يَنبَغي للصِّدِّيقِ أنْ يكونَ",2]," ",["لعَّانًا",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2597)، وأحمد (8782) واللفظ له","bab":"آداب عامة › الأخلاق المذمومة","dorar":"aGtoJvwW"},{"id":"س-06905","fp":"82d523030387","stateId":449,"easy":"إذا كان في قلبك شحناء أو أشركت ← لا يُغفر لك في ليلة المغفرة","cause":"إنسانٍ في قَلبِهِ شحناءٌ أو مُشرِكٍ باللَّهِ عزَّ وجلَّ","result":"فيغفرُ لِكُلِّ نفسٍ إلَّا","explicit":true,"star":true,"otherNeedIds":[11],"ref":"تخريج كتاب السنة 509","srcLabel":"ابن أبي الدنيا","text":["ينزلُ اللَّهُ ليلةَ النِّصفِ مِن شعبانَ إلى السَّماءِ الدُّنيا ",["فيغفرُ لِكُلِّ نفسٍ إلَّا",2]," ",["إنسانٍ في قَلبِهِ شحناءٌ أو مُشرِكٍ باللَّهِ عزَّ وجلَّ",1]],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي الدنيا في ((فضائل رمضان)) (2)، وابن أبي عاصم في ((السنة)) (509) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (5/309)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"O68svCvz","merged":6,"otherRefs":["السلسلة الصحيحة 1144 (صحيح)","صحيح الجامع 4268 (صحيح)","تخريج كتاب السنة 510 (صحيح)","البحر الزخار 1/207 (حسن)","الأمالي المطلقة 122 (حسن)"]},{"id":"س-08290","fp":"84942d871038","stateId":449,"easy":"إذا أكثرت اللعن ← لا تكون شفيعاً ولا شهيداً يوم القيامة","cause":"اللَّعَّانونَ","result":"لا يَكونُ اللَّعَّانونَ شُفَعاءَ ولا شُهَداءَ يَومَ القيامةِ","explicit":true,"star":true,"ref":"صحيح مسلم 2598","srcLabel":"أبو داود","text":["أنَّ عَبدَ المَلِكِ بنَ مَروانَ بَعَثَ إلى أُمِّ الدَّرداءِ بأنجادٍ مِن عِندِه، فلَمَّا أن كان ذاتَ لَيلةٍ قامَ عبدُ المَلِكِ مِنَ اللَّيلِ، فدَعا خادِمَه، فكَأنَّه أبطَأ عليه، فلَعَنَه، فلَمَّا أصبَحَ قالت له أُمُّ الدَّرداءِ: سَمِعتُكَ اللَّيلةَ لَعَنتَ خادِمَكَ حينَ دَعَوتَه، فقالت: سَمِعتُ أبا الدَّرداءِ يقولُ: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["لا يَكونُ اللَّعَّانونَ شُفَعاءَ ولا شُهَداءَ يَومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"[صحيح]","takhrij":"أخرجه أبو عوانة في ((المستخرج)) (11333)، وابن وهب في ((جامعه)) (353) واللفظ لهما، وأبو داود (4907) بلفظه دون القصة في أوله.","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"gqAnSooH","merged":5,"otherRefs":["صحيح الجامع 7773 (صحيح)","المستدرك على الصحيحين 150 (صحيح)","صحيح ابن حبان 5746 (صحيح)","صحيح الأدب المفرد 240 (صحيح)"]},{"id":"س-08328","fp":"a6f79d2bfc0e","stateId":449,"easy":"إذا لعنت ← لا تكون صدّيقاً","cause":"لعَّانِينَ","result":"كلاَّ وربِّ الكعبةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"هداية الرواة 4796","srcLabel":"البخاري","text":["مرَّ النبيُّ - صلَّى اللهُ عليهِ وسلَّمَ - بأبي بكرٍ وهو يلعنُ بعضَ رقيقهِ، فالتفتَ إليهِ ؛ فقال :",["لعَّانِينَ",1]," وصدِّيقِينَ ؟ ! ",["كلاَّ وربِّ الكعبةِ",2],"، فأعتق أبو بكرٍ - يومئذٍ - بعضَ رقيقِهِ، ثمَّ جاء النبيُّ - صلَّى اللهُ عليهِ وسلَّمَ -، فقال : لا أعودُ ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (4791) بلفظه، والبخاري في ((الأدب المفرد)) (319)، وابن أبي الدنيا في ((الصمت)) (689) كلاهما بنحوه","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"hedemuov","merged":2,"otherRefs":["صحيح الأدب المفرد 243 (صحيح)"]},{"id":"س-00145","fp":"25c60381615e","stateId":449,"easy":"إذا تباغضتم ← فالبغضة هي الحالقة","cause":"و إِيَّاكُمْ و البِغْضَةَ","result":"فإنَّها هيَ الحالِقَةُ","explicit":true,"otherNeedIds":[39],"ref":"صحيح الأدب المفرد 197","srcLabel":"متفق عليه","text":["و الذي نَفسي بيدِهِ ! لا تَدْخُلوا الجنةَ حتى تُسْلِمُوا، ولا تُسْلِمُوا حتى تَحابُّوا ، و أَفْشُوا السلامَ تَحابُّوا ، ",["و إِيَّاكُمْ و البِغْضَةَ",1],"؛ ",["فإنَّها هيَ الحالِقَةُ",2],"، لا أَقُولُ لَكُمْ : تَحْلِقُ الشَّعْرَ، و لكنْ تَحْلِقُ الدِّينَ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه مسلم (54) بنحوه مختصراً، والبخاري في ((الأدب المفرد)) (260) واللفظ له","bab":"آداب السلام › إفشاء السلام","dorar":"vwbhCj1M"},{"id":"س-05003","fp":"6c4de8fb9b7b","stateId":449,"easy":"إذا أطعت الشح واتبعت الهوى وأعجبت بنفسك ← فهي مهلكات","cause":"فشُحٌّ مُطاعٌ، وهوًى مُتَّبَعٌ، وإعجابُ المرءِ بنفسِه","result":"ثلاثٌ مُهلِكاتٌ","explicit":true,"similar":["س-05445"],"ref":"المصابيح في الأحاديث المتواترة 608","srcLabel":"السنة","text":[["ثلاثٌ مُهلِكاتٌ",2],"، وثلاثٌ مُنجياتٌ، وثلاثٌ كفَّاراتٌ، وثلاثٌ دَرجاتٌ؛ فأمَّا المُهلِكاتُ: ",["فشُحٌّ مُطاعٌ، وهوًى مُتَّبَعٌ، وإعجابُ المرءِ بنفسِه",1],"، وأمَّا المُنجياتُ: العَدلُ بالغَضَبِ والرِّضا، والقَصدُ في الفَقرِ والغِنى، وخَشيةُ اللهِ في السِّرِّ والعلانيةِ، وأمَّا الكفَّاراتُ: فانتِظارُ الصَّلاةِ بَعدَ الصَّلاةِ، وإسباغُ الوُضوءِ في السَّبَراتِ، ونَقلُ الأقدامِ إلى الجماعاتِ، وأمَّا الدَّرجاتُ: فإطعامُ الطَّعامِ، وإفشاءُ السَّلامِ، والصَّلاةُ باللَّيلِ والنَّاسُ نيامٌ"],"grade":"صحيح","muhaddith":"هذه مجموعة هنا، وأكثر رواياتها متفرقة، وكلها متواترة","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"AFzHsVLC","merged":3,"otherRefs":["هداية الرواة 5049 (حسن)","صحيح الجامع 3039 (حسن)"]},{"id":"س-00402","fp":"71556952b6ea","stateId":449,"easy":"إذا أكثرت اللعن ← لا ينبغي أن تكون وجيهاً عند الله","cause":"للعَّانٍ","result":"ما ينبغي للعَّانٍ أن يكونَ وجيهًا عندَ اللهِ عزَّ وجلَّ","explicit":true,"ref":"البحر الزخار 10/70","srcLabel":"مسلم","text":[["ما ينبغي للعَّانٍ أن يكونَ وجيهًا عندَ اللهِ عزَّ وجلَّ",2]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"إسناده حسن","takhrij":"أخرجه مسلم (2598)، وأبو داود (4907)، والحاكم (149) بمعناه.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"8kQ9Iqac"},{"id":"س-00241","fp":"14ab07e3347a","stateId":449,"easy":"إذا حُرمت حظك من الرفق ← فقد حُرمت حظك من الخير","cause":"ومَنْ حُرِمَ حظَّهُ مِنَ الرِّفْقِ","result":"فَقَدْ حُرِمَ حَظَّهُ مِنَ الخيرِ","explicit":true,"similar":["س-00347"],"ref":"صحيح الجامع 6055","srcLabel":"الترمذي","text":["مَنْ أُعْطِىَ حظَّهُ مِنَ الرِّفْقِ ، فقدْ أُعْطِىَ حظَّهُ مِنَ الخيرِ ، ",["ومَنْ حُرِمَ حظَّهُ مِنَ الرِّفْقِ ، ",1],["فَقَدْ حُرِمَ حَظَّهُ مِنَ الخيرِ",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2013) واللفظ له، وأحمد (27553) أوله في أثناء حديث","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"g2Qm5Eox"},{"id":"س-00251","fp":"f78f062704cd","stateId":449,"easy":"إذا كنت لا تألف ولا تُؤلف ← فلا خير فيك","cause":"منْ لا يألفُ و لايؤلفُ","result":"ولا خيرَ في","explicit":true,"otherNeedIds":[36],"ref":"الجامع الصغير 9127","srcLabel":"أحمد","text":["المؤمنُ يألفُ ويُؤلفُ،   ",["ولا خيرَ في",2],["منْ لا يألفُ و لايؤلفُ",1]],"grade":"صحيح","narrator":"سهل بن سعد الساعدي","muhaddith":"صحيح","takhrij":"أخرجه الروياني في ((مسنده)) (1048)، والبيهقي في ((الآداب)) (159) واللفظ لهما، وأحمد (22840) باختلاف يسير.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"2JHlVhUX"},{"id":"س-00333","fp":"8918343f7eaa","stateId":449,"easy":"إذا حُرمت الرفق ← تُحرم الخير","cause":"ومَن يُحرَمِ الرِّفقَ","result":"يُحرَمِ الخيرَ","explicit":true,"ref":"أطراف الغرائب 1/355","srcLabel":"السنة","text":["حديث: عَن النَّبيِّ صلَّى اللهُ عليه وسلَّم قال: الرِّفْقُ فيه زيادةُ بَرَكةٍ [ ",["ومَن يُحرَمِ الرِّفقَ",1]," ",["يُحرَمِ الخيرَ",2],"]"],"grade":"صحيح","narrator":"جرير بن عبد الله البجلي","muhaddith":"غريب من حديث أبي بردة بن أبي موسى عنه، تفرد به عمرو بن ثابت بن هرمز عن عمه أبي عبيدة بن هرمز عن أبي بردة","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"SgXHlUM8"},{"id":"س-00347","fp":"62716dcda570","stateId":449,"easy":"إذا حُرمت الرفق ← حُرمت الخير","cause":"مَن حُرِمَ الرِّفقَ","result":"حُرِمَ الخَيرَ، أو مَن يُحرَمِ الرِّفقَ يُحرَمِ الخَيرَ","explicit":true,"repOf":"س-00241","ref":"صحيح مسلم 2592","text":[["مَن حُرِمَ الرِّفقَ ",1],["حُرِمَ الخَيرَ، أو مَن يُحرَمِ الرِّفقَ يُحرَمِ الخَيرَ",2],"."],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه أبو داود (4809)، وابن ماجه (3687)، وأحمد (19252) واللفظ لهم.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"ekWEIlCl"},{"id":"س-05892","fp":"738b90ef6c7a","stateId":449,"easy":"إذا غضبت ← فالغضب يجمع الشر كله","cause":"الغَضَبُ","result":"يَجمَعُ الشَّرَّ كُلَّه","explicit":true,"otherNeedIds":[8],"ref":"تخريج المسند لشعيب 23171","srcLabel":"أحمد","text":["عن رَجُلٍ مِن أصْحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ قال: قال رَجُلٌ: يا رسولَ اللهِ، أوْصِني؟ قال: لا تَغضَبْ، قال: قال الرَّجُلُ: ففَكَّرتُ حين قال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ ما قال، فإذا ",["الغَضَبُ",1]," ",["يَجمَعُ الشَّرَّ كُلَّه",2],"."],"grade":"صحيح","narrator":"رجال من الصحابة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (23171)، وعبدالرزاق (20286)، والبيهقي (20775)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"TN3MI2ks"},{"id":"س-07355","fp":"f77a23bc47bf","stateId":449,"easy":"إذا ماريت ← فقد تمت خسارتك","cause":"المُماريَ","result":"قد تمت خسارتُه","explicit":true,"ref":"النوافح العطرة 148","srcLabel":"السنة","text":["ذَروا المِراءَ [يعني حديث: خرج علينا رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ونحن نتمارى في شيءٍ منَ الدِّينِ فغضب غضبًا شديدًا لم يغضبْ مثلَه ثم انتهرَنا فقال يا أمةَ محمدٍ لا تُهيِّجوا على أنفسِكم وهجَ النارِ ثم قال بهذا أمرتُكم أو ليس عن هذا نهيتُكم أليس قد كان هلك من كان قبلكم بهذا ثم قال ذروا المراءَ لقلةِ خيرِه ذروا المراءَ فإنَّ نفعَه قليلٌ ويُهيِّجُ العداءَ بينَ الإخوانِ ذروا المراءَ فإنَّ المراءَ لا تؤمنُ فتنتُه ذروا المراءَ فإنَّ المراءَ يورثُ الشكَّ ويحبطُ العملَ ذروا المراءَ فإنَّ المؤمنَ لا يُماري ذروا المِراءِ فإنَّ ",["المُماريَ",1]," ",["قد تمت خسارتُه",2]," ذروا المراءَ فكفاك إثمًا أن لا تزال مُماريًا ذروا المراءَ فإنَّ المُماريَ لا أشفعُ له يومَ القيامةِ ذروا المراءَ فأنا زعيمٌ بثلاثةِ أبياتٍ في الجنةِ في وسَطِها ورياضِها وأعلاها لمن يتركُ المراءَ وهو صادقٌ ذروا المراءَ فإنَّ أولَ ما نهاني عنه ربي عَزَّ وَجَلَّ بعد عبادةِ الأوثانِ وشربِ الخمرِ المراءُ ذروا المراءَ فإنَّ الشيطانَ قد أَيِسَ أن يُعبدَ ولكنه رضيَ منكم بالتَّحريشِ وهو المراءُ في الدِّينِ ذروا المراءَ فإنَّ بني إسرائيلَ افترقوا على إحدى وسبعين فرقةً والنصارى على اثنتين وسبيعن فرقةً وإنَّ أمتي ستفترقُ على ثلاثةٍ وسبعين فرقةً كلِّهم على الضلالةِ إلا السوادَ الأعظمَ قالوا يا رسولَ اللهِ وما السوادُ الأعظمُ قال ما أنا عليه وأصحابي مَنْ لم يمارِ في دينِ اللهِ ولم يكفِّرْ أحدًا من أهلِ التوحيدِ بذنبٍ ثم قال إنَّ الإسلامَ بدأ غريبًا وسيعودُ كما بدأ فطُوبى للغرباءِ قالوا يا رسولَ اللهِ ومَنِ الغرباءُ قال الذين يَصلُحون إذا فسد الناسُ ولا يمارون في دينِ اللهِ ولا يكفِّرون أحدًا مِنْ أهلِ التوحيدِ بذنبٍ]"],"grade":"صحيح","narrator":"[أبو الدرداء وأبو أمامة الباهلي وأنس بن مالك وواثلة بن الأسقع]","muhaddith":"صحيح","bab":"فتن › كراهية الاختلاف","dorar":"TMkPFVlz"},{"id":"س-07356","fp":"f3b194c6098d","stateId":449,"easy":"إذا ماريت ← فالنبي ﷺ لا يشفع لك يوم القيامة","cause":"المُماريَ","result":"لا أشفعُ له يومَ القيامةِ","explicit":true,"otherNeedIds":[57],"ref":"النوافح العطرة 148","srcLabel":"السنة","text":["ذَروا المِراءَ [يعني حديث: خرج علينا رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ونحن نتمارى في شيءٍ منَ الدِّينِ فغضب غضبًا شديدًا لم يغضبْ مثلَه ثم انتهرَنا فقال يا أمةَ محمدٍ لا تُهيِّجوا على أنفسِكم وهجَ النارِ ثم قال بهذا أمرتُكم أو ليس عن هذا نهيتُكم أليس قد كان هلك من كان قبلكم بهذا ثم قال ذروا المراءَ لقلةِ خيرِه ذروا المراءَ فإنَّ نفعَه قليلٌ ويُهيِّجُ العداءَ بينَ الإخوانِ ذروا المراءَ فإنَّ المراءَ لا تؤمنُ فتنتُه ذروا المراءَ فإنَّ المراءَ يورثُ الشكَّ ويحبطُ العملَ ذروا المراءَ فإنَّ المؤمنَ لا يُماري ذروا المِراءِ فإنَّ المُماريَ قد تمت خسارتُه ذروا المراءَ فكفاك إثمًا أن لا تزال مُماريًا ذروا المراءَ فإنَّ ",["المُماريَ",1]," ",["لا أشفعُ له يومَ القيامةِ",2]," ذروا المراءَ فأنا زعيمٌ بثلاثةِ أبياتٍ في الجنةِ في وسَطِها ورياضِها وأعلاها لمن يتركُ المراءَ وهو صادقٌ ذروا المراءَ فإنَّ أولَ ما نهاني عنه ربي عَزَّ وَجَلَّ بعد عبادةِ الأوثانِ وشربِ الخمرِ المراءُ ذروا المراءَ فإنَّ الشيطانَ قد أَيِسَ أن يُعبدَ ولكنه رضيَ منكم بالتَّحريشِ وهو المراءُ في الدِّينِ ذروا المراءَ فإنَّ بني إسرائيلَ افترقوا على إحدى وسبعين فرقةً والنصارى على اثنتين وسبيعن فرقةً وإنَّ أمتي ستفترقُ على ثلاثةٍ وسبعين فرقةً كلِّهم على الضلالةِ إلا السوادَ الأعظمَ قالوا يا رسولَ اللهِ وما السوادُ الأعظمُ قال ما أنا عليه وأصحابي مَنْ لم يمارِ في دينِ اللهِ ولم يكفِّرْ أحدًا من أهلِ التوحيدِ بذنبٍ ثم قال إنَّ الإسلامَ بدأ غريبًا وسيعودُ كما بدأ فطُوبى للغرباءِ قالوا يا رسولَ اللهِ ومَنِ الغرباءُ قال الذين يَصلُحون إذا فسد الناسُ ولا يمارون في دينِ اللهِ ولا يكفِّرون أحدًا مِنْ أهلِ التوحيدِ بذنبٍ]"],"grade":"صحيح","narrator":"[أبو الدرداء وأبو أمامة الباهلي وأنس بن مالك وواثلة بن الأسقع]","muhaddith":"صحيح","bab":"فتن › كراهية الاختلاف","dorar":"TMkPFVlz"},{"id":"س-00321","fp":"c0f00a726aa9","stateId":449,"easy":"إذا لم يجعل الله في قلبك رحمة للبشر ← خبت وخسرت","cause":"و خَسِرَ لَمْ يَجعلِ اللهُ تعالى في قلبِهِ رحمةً لِلبَشَرِ","result":"خابَ عبدٌ","explicit":true,"ref":"صحيح الجامع 3205","srcLabel":"الدولابي","text":[["خابَ عبدٌ",2],[" و خَسِرَ لَمْ يَجعلِ اللهُ تعالى في قلبِهِ رحمةً لِلبَشَرِ",1]],"grade":"حسن","narrator":"عمرو بن حبيب","muhaddith":"حسن","takhrij":"أخرجه الدولابي في ((الكنى والأسماء)) (971)، وأبو نعيم في ((معرفة الصحابة)) (5125)، وابن عساكر في ((تاريخ دمشق)) (21/ 54) واللفظ لهم.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"0scE6zsI"},{"id":"س-04726","fp":"f44559562819","stateId":449,"easy":"إذا غلب جهلك حلمك ← فلا خير فيك","cause":"يغلِبُ جهلُه حِلمَه","result":"لا خيرَ فيمن يغلِبُ","explicit":true,"ref":"تفسير القرآن العظيم 8/103","srcLabel":"أبو داود","text":["كان في خطبةِ أبي بكر الصدِّيقِ رضي اللهُ عنه : أما تعلمون أنكم تغدون وتروحون لأجلٍ معلومٍ ، فمن استطاع أن يقضيَ الأجلَ وهو في عملِ اللهِ عزَّ وجلَّ فليفعلْ ، ولن تنالوا ذلك إلا بالله عزَّ وجلَّ ، إنَّ قومًا جعلوا آجالَهم لغيرهم ، فنهاكم اللهُ أن تكونوا أمثالهم  وَلَا تَكُونُوا كَالَّذِينَ نَسُوا اللهَ فَأَنْسَاهُمْ أَنْفُسَهُمْ  أين مَن تعرفون من إخوانِكم ؟ قدِموا على ما قدِموا في أيامٍ سلَفِهم ، وخلَوْا بالشَّقوةِ والسعادةِ ، أين الجبارون الأولونَ الذين بنوا المدائنَ وحصَّنوها بالحوائطِ ؟ قد صاروا تحت الصَّخرِ والآبارِ ، هذا كتابُ اللهِ لا تَفْنى عجائبُه ، فاستَضيئوا منه ليوم الظُّلمةِ ، واستنصِحوا كتابَه وتبيانَه ، إنَّ اللهَ أثنى على زكريا وأهلَ بيتِه فقال  إِنَّهُمْ كَانُوا يُسَارِعُونَ فِي الْخَيْرَاتِ وَيَدْعُونَنَا رَغَبًا وَرَهَبًا وَكَانُوا لَنَا خَاشِعِينَ  لا خيرَ في قولٍ لا يرادُ به وجهُ اللهِ ولا خيرَ في مالٍ لا يُنفَقُ في سبيلِ اللهِ ، و",["لا خيرَ فيمن يغلِبُ",2],[" جهلُه حِلمَه",1]," ، ولا خيرَ فيمن يخافُ في الله لومةَ لائمٍ"],"grade":"حسن","narrator":"نعيم بن نمحة","muhaddith":"إسناده جيد","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (1/ 60) (39)، واللفظ له، وأبو داود في ((الزهد)) (26)، وأبو نعيم في ((حلية الأولياء)) (1/ 36)، بلفظ مقارب.","bab":"رقائق وزهد › الإخلاص","dorar":"z8Xyc5hX"},{"id":"س-01650","fp":"b93feffcf05a","stateId":449,"easy":"إذا بخلت بالسلام وعجزت عن الدعاء ← فأنت أبخل الناس وأعجزهم","cause":"مَن بخِل بالسَّلامِ وأعجَزَ النَّاسِ مَن عجَز عن الدُّعاءِ","result":"إنَّ أبخلَ النَّاسِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"تخريج صحيح ابن حبان 4498","srcLabel":"متفق عليه","text":["قسَم رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بينَنا تمرًا فأصابني منها خمسٌ أو أربعُ تمراتٍ قال: فرأَيْتُ الحشَفةَ هي أشدَّ لضِرْسي قال: فقال أبو هُريرةَ: ",["إنَّ أبخلَ النَّاسِ",2],[" مَن بخِل بالسَّلامِ وأعجَزَ النَّاسِ مَن عجَز عن الدُّعاءِ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (5441م) دون قول أبي هريرة","bab":"أطعمة › ما يحل من الأطعمة","dorar":"SripDiaw","merged":2,"otherRefs":["صحيح الترغيب 2714 (صحيح)"]},{"id":"س-00307","fp":"ed27567c990e","stateId":449,"easy":"إذا كنت لعّاناً ← لا تكون صدّيقاً","cause":"لَعَّانِينَ","result":"لَا يَجْتَمِعُ أَنْ تَكُونُوا لَعَّانِينَ صِدِّيقِينَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"المستدرك على الصحيحين 149","srcLabel":"متفق عليه","text":[["لَا يَجْتَمِعُ أَنْ تَكُونُوا لَعَّانِينَ صِدِّيقِينَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح الإسناد]","takhrij":"أخرجه مسلم (2597)، وأحمد (8447)، والبخاري في ((الأدب المفرد)) (317) بنحوه.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"uxdhYnvy"},{"id":"س-00506","fp":"270a72562e16","stateId":449,"easy":"إذا أفرطت في حب أحد أو بغضه ← تهلك فيه","cause":"محبٌّ مُفرِطٌ يُقرِّظُني بما ليس فيَّ ومُبغضٌ يحملُه شَنَآني على أن يَبْهتني","result":"يَهلَكُ فيَّ رجلان","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"similar":["س-08385"],"ref":"تخريج المسند لشاكر 2/355","srcLabel":"النسائي","text":["فيكَ مثلٌ مِنْ عيسى أبغضَتْه اليهودُ حتى بَهَتوا أمَّه وأحبَّتْه النصارى حتى أنزلوه بالمنزلةِ التي ليستْ بهِ ثم قال : ",["يَهلَكُ فيَّ رجلان",2]," ",["محبٌّ مُفرِطٌ يُقرِّظُني بما ليس فيَّ ومُبغضٌ يحملُه شَنَآني على أن يَبْهتني",1]],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"إسناده حسن","takhrij":"أخرجه عبد الله بن أحمد في ((زياداته على المسند)) (1376)، وابن الأعرابي في ((معجم شيوخه)) (1550) كلاهما بلفظه، وأبو يعلى (534) باختلاف يسير، والنسائي في ((السنن الكبرى)) (8434) مختصرا بلفظه دون آخره:(( هلك في رجلان...)).","bab":"آداب عامة › ضرب الأمثال","dorar":"4D2qq6es"},{"id":"س-08385","fp":"c601bec5b150","stateId":449,"easy":"إذا أفرطت في الحب أو البغض ← تهلك","cause":"مُفْرِطٌ في حُبِّي ومُفْرِطٌ في بُغْضِي","result":"يَهْلَكُ فِيَّ رجلان","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"repOf":"س-00506","ref":"تخريج كتاب السنة 984","text":["قال عليٌّ ",["يَهْلَكُ فِيَّ رجلان",2]," ",["مُفْرِطٌ في حُبِّي ومُفْرِطٌ في بُغْضِي",1]],"grade":"حسن","narrator":"شيحة بن عبدالله أبو حبرة","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن أبي شيبة (32797)، وابن أبي عاصم في ((السنة)) (984)، واللالكائي في ((شرح أصول الاعتقاد)) (2680) واللفظ لهم.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"rnKVadOf"},{"id":"س-03293","fp":"82428e0d597d","stateId":449,"easy":"إذا حقدت ← يدعك الله بحقدك حتى تدعه","cause":"أهلَ الحقدِ بحقدِهم","result":"فيغفِرُ للمؤمنين ، ويُمهِلُ الكافرين ، ويدَعُ أهلَ الحقدِ بحقدِهم حتى يدَعوه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[11],"ref":"صحيح الترغيب 2771","srcLabel":"الطبراني","text":["يطَّلِعُ اللهُ إلى عبادِه ليلةَ النِّصفِ من شعبانَ ؛ ",["فيغفِرُ للمؤمنين ، ويُمهِلُ الكافرين ، ويدَعُ أهلَ الحقدِ بحقدِهم حتى يدَعوه",2]," ."],"grade":"صحيح","narrator":"أبو ثعلبة الخشني","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (511)، وابن قانع في ((معجم الصحابة)) (1/160)، والطبراني (22/223) (590) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"gnpfRXGS","merged":3,"otherRefs":["تخريج كتاب السنة 511 (صحيح)","صحيح الجامع 1898 (حسن)"]},{"id":"س-05445","fp":"bf849fa3b05a","stateId":449,"easy":"إذا أطعت الشح واتبعت الهوى وأعجبت بنفسك ← فهي المهلكات","cause":"فشُحٌّ مُطاعٌ ، و هوًى مُتَّبَعٌ ، و إعجابُ المرءِ بنَفسِه","result":"أمَّا المهلِكاتُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-05003","ref":"صحيح الترغيب 453","text":["ثلاثٌ كفَّاراتٌ ، و ثلاثٌ درجاتٌ ، و ثلاثٌ مُنجِياتٌ ، و ثلاثٌ مُهلِكاتٌ ؛ فأما الكفَّاراتُ ، فإسباغُ الوُضوءِ في السَّبَرَاتِ ، و انتِظارُ الصَّلاةِ بعد الصَّلاةِ ، و نقلُ الأقدامِ إلى الجَماعاتِ ، وأمَّا الدَّرجاتُ فإطعامُ الطعامِ ، وإفشاءُ السلامِ ، والصَّلاةُ باللَّيلِ والنَّاسُ نيامٌ ، و أمَّا المنجِياتُ ، فالعَدلُ في الغَضبِ و الرِّضَا ، و القَصدُ في الفقرِ والغِنَى ، و خَشيةُ اللهِ في السِّرِّ و العَلانيةِ ، و ",["أمَّا المهلِكاتُ",2]," ، ",["فشُحٌّ مُطاعٌ ، و هوًى مُتَّبَعٌ ، و إعجابُ المرءِ بنَفسِه",1]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن لغيره","takhrij":"أخرجه البزار (6491)، وابن شاهين في ((الترغيب في فضائل الأعمال)) (33)، وأبو نعيم في ((حلية الأولياء)) (6/268) باختلاف يسير.","bab":"رقائق وزهد › الخوف من الله","dorar":"JrlsnqXs"},{"id":"س-07010","fp":"aa212d99e99d","stateId":450,"easy":"إذا كانت فترتك إلى غير السنة ← فقد هلكت","cause":"ومَن كانتْ فَترتُه إلى غيرِ ذلك","result":"فقد هلَك","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 6477","srcLabel":"متفق عليه","text":["قال: زوَّجَني أبي امرأةً مِن قُرَيشٍ، فلمَّا دخَلَتْ علَيَّ جعَلْتُ لا أنْحاشُ لها؛ ممَّا بي مِن القوَّةِ على العِبادةِ، مِن الصَّومِ والصَّلاةِ، فجاء عمرُو بنُ العاصِ إلى كَنَّتِه، حتى دخَلَ عليها، فقال لها: كيف وجَدْتِ بعْلَكِ؟ قالت: خيْرَ الرِّجالِ -أوْ كَخيْرِ البُعولةِ مِن رجُلٍ-؛ لم يُفتِّشْ لنا كَنَفًا، ولم يَعرِفْ لنا فِراشًا، فأقبَلَ علَيَّ، فعَذَمني وعضَّني بلِسانِه، فقال: أنْكحْتُكَ امرأةً من قُريشٍ ذاتَ حسَبٍ، فعضَلْتَها، وفعلْتَ، وفعلْتَ! ثُمَّ انطلَقَ إلى النبيِّ صلَّى اللهُ عليه وسلَّمَ فشَكاني، فأرسَلَ إليَّ النبيُّ صلَّى اللهُ عليه وسلَّمَ فأتَيْتُه، فقال لي: أتصومُ النَّهارَ؟ قُلْتُ: نعمْ، قال: وتقومُ اللَّيلَ؟ قُلْتُ: نعمْ، قال: لكِنِّي أصومُ وأُفطِرُ، وأُصلِّي وأنامُ، وأَمَسُّ النِّساءَ، فمَنْ رغِبَ عن سُنَّتي فليس منِّي.\nقال: اقْرَأِ القرآنَ في كلِّ شهرٍ، قُلْتُ: إنِّي أجِدُني أقوَى مِن ذلك، قال: فاقرَأْه في كلِّ عشَرةِ أيَّامٍ، قُلْتُ: إنِّي أجِدُني أقوَى مِن ذلك، -قال أحدُهما؛ إمَّا حُصَينٌ وإمَّا مُغيرةُ قال: فاقرَأْه في كلِّ ثلاثٍ- قال: ثُمَّ قال: صُمْ في كلِّ شهرٍ ثلاثةَ أيَّامٍ، قُلْتُ: إنِّي أقوَى مِن ذلك، قال: فلم يزَلْ يرفَعُني حتى قال: صُمْ يومًا وأفطِرْ يومًا؛ فإنَّه أفضلُ الصِّيامِ، وهو صيامُ أخي داوُدَ صلَّى اللهُ عليه وسلَّمَ.\nقال حُصَينٌ في حديثِه: ثُمَّ قال صلَّى اللهُ عليه وسلَّمَ: فإنَّ لِكلِّ عابدٍ شِرَّةً، ولِكلِّ شِرَّةٍ فَترَةٌ، فإمَّا إلى سُنَّةٍ، وإمَّا إلى بدعةٍ، فمَن كانتْ فَترتُه إلى سُنَّةٍ، فقدِ اهْتَدَى، ",["ومَن كانتْ فَترتُه إلى غيرِ ذلك ",1],["فقد هلَك",2],". قال مجاهدٌ: فكان عبدُ اللهِ بنُ عمرٍو حيثُ ضعُف وكبِر يصومُ الأيَّامَ كذلك، يصِلُ بعضَها إلى بعضٍ؛ لِيتقوَّى بذلك، ثُمَّ يُفطِرُ بعدَ تلك الأيَّامِ، قال: وكان يَقْرَأُ في كلِّ حِزْبِه كذلك، يَزيدُ أحيانًا، ويَنقُصُ أحيانًا، غيرَ أنَّه يُوَفِّي العَددَ؛ إمَّا في سَبعٍ، وإمَّا في ثلاثٍ، قال: ثُمَّ كان يقولُ بعدَ ذلك: لأَنْ أكونَ قبِلتُ رُخصةَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أحَبُّ إليَّ ممَّا عُدِلَ به -أو عدَل- لكنِّي فارَقْتُه على أمْرٍ أكرَهُ أنْ أُخالِفَه إلى غيرِه."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (5052)، ومسلم (1159)، والنسائي (2390)، وأحمد (6477) واللفظ له","bab":"علم › الحث على الأخذ بالسنة","dorar":"6BXZvhjv","merged":2,"otherRefs":["تخريج صحيح ابن حبان 11 (صحيح)"]},{"id":"س-00599","fp":"7ae8c4dfbe3f","stateId":450,"easy":"إذا لم تقم بالقرآن ← تنساه","cause":"وإذا لَم يَقُمْ به","result":"نَسيَه","explicit":true,"star":true,"ref":"صحيح مسلم 789","srcLabel":"البخاري","text":["إنَّما مَثَلُ صاحِبِ القُرآنِ كمَثَلِ الإبِلِ المُعَقَّلةِ، إن عاهَدَ عليها أمسَكَها، وإن أطلَقَها ذَهَبَت. [وفي روايةٍ]: وإذا قامَ صاحِبُ القُرآنِ فقَرَأه باللَّيلِ والنَّهارِ ذَكَرَه، ",["وإذا لَم يَقُمْ به",1]," ",["نَسيَه",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5031) باختلاف يسير ودون الرواية المذكورة","bab":"آداب عامة › ضرب الأمثال","dorar":"KvqlitTc"},{"id":"س-00745","fp":"19eef36c7226","stateId":450,"easy":"إذا أبطأ بك عملك ← لا يسرع بك نسبك","cause":"ومَن يُبطِئُ به عَمَلُه","result":"لا يُسرِعُ به نَسَبُه","explicit":true,"star":true,"similar":["س-07254"],"ref":"تخريج المسند لشعيب 9274","srcLabel":"مسلم","text":["ما مِن قَومٍ يَجتمِعون في بَيتٍ مِن بُيوتِ اللهِ عزَّ وجلَّ، يَقْرَؤون ويتَعَلَّمون كِتابَ اللهِ عزَّ وجلَّ، يتَدارَسونه بَينَهم، إلَّا حفَّتْ بهم الملائكةُ، وغشيَتْهم الرَّحمةُ، وذكَرَهم اللهُ فيمَن عِندَه، وما مِن رَجُلٍ يَسلُكُ طَريقًا يَلتَمِسُ به العِلْمَ، إلَّا سهَّلَ له به -أو سهَّلَ به- طَريقًا [إلى] الجنَّةِ، ",["ومَن يُبطِئُ به عَمَلُه، ",1],["لا يُسرِعُ به نَسَبُه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (2699)، والترمذي (2945)، وابن ماجه (225) مطولاً، وأبو داود (1455) مختصراً، وأحمد (9274) واللفظ له","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"n1MoFiZb"},{"id":"س-07254","fp":"ac186fb61b68","stateId":450,"easy":"إذا أبطأ بك عملك ← لم يسرع بك نسبك","cause":"ومَن أبْطَأَ به عَمَلُه","result":"لَـمْ يُسْرِعْ به نَسَبُه","explicit":true,"repOf":"س-00745","ref":"تخريج المسند لشعيب 7427","text":["مَن نفَّسَ عن مُؤْمنٍ كُرْبَةً مِن كُرَبِ الدُّنيا؛ نفَّسَ اللهُ عَنه كُرْبَةً مِن كُرَبِ يَوْمِ القِيامَةِ، ومَن ستَرَ مُسْلمًا ستَرَه اللهُ في الدُّنيا والآخِرَةِ، ومَن يسَّرَ على مُعْسِرٍ يسَّرَ اللهُ عليه في الدُّنيا والآخِرَةِ، واللهُ في عَوْنِ العَبْدِ ما كان العَبْدُ في عَوْنِ أَخيه، ومَن سلَكَ طَريقًا يَلْتَمِسُ فيه عِلْمًا سهَّلَ اللهُ له به طَريقًا إلى الجنةِ، وما اجتمَعَ قَوْمٌ في بَيْتٍ مِن بُيوتِ اللهِ يَتْلُون كِتابَ اللهِ، ويَتَدارَسُونه بَيْنَهم؛ إلَّا نزلَتْ عليهم السَّكِينَةُ، وغشِيَتْهم الرَّحْـمةُ، وحفَّتْهم الـمَلائِكةُ، وذكَرَهم اللهُ عزَّ وجلَّ فيمَن عِندَه، ",["ومَن أبْطَأَ به عَمَلُه، ",1],["لَـمْ يُسْرِعْ به نَسَبُه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (2699) باختلاف يسير","bab":"علم › فضل مجالس العلم والذكر","dorar":"hv3Ejh53"},{"id":"س-07491","fp":"1c28ad617226","stateId":450,"easy":"إذا تركت عشر ما تعلم ← هويت أو هلكت","cause":"ومَنْ تركَ فيه عشرَ ما يعلَمُ","result":"هوَى - أو قال هلَكَ","explicit":true,"star":true,"similar":["س-07481"],"ref":"الأمالي الحلبية 1/41","srcLabel":"البخاري","text":["إِنَّكُمْ فِي زَمِانٍ خُطَبَاؤُهُ قَلِيلٌ وَعُلَمَاؤُهُ كثيرٌ ",["ومَنْ تركَ فيه عشرَ ما يعلَمُ",1]," ",["هوَى - أو قال هلَكَ",2]," - وسَيَأْتِي زمانٌ كثيرٌ خطباؤُهُ قليلٌ علماؤُهُ مَنْ عَمِلَ فيه بِعُشْرِ مَا يعلَمُ نَجَا"],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"رجال هذا الإسناد لا بأس بهم إلا الرجل المبهم","takhrij":"أخرجه أحمد (21372)، والبخاري في ((التاريخ الكبير)) (3/ 299)، والهروي في ((ذم الكلام)) (97) واللفظ لهم.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"13FRtI24"},{"id":"س-07760","fp":"cc407089c236","stateId":450,"easy":"إذا لم تعمل لنفسك ← لا يغني عنك قريبك من الله شيئاً","cause":"اشتَروا أنفُسَكُم","result":"لا أُغني عَنكُم مِنَ اللهِ شيئًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[57],"ref":"صحيح البخاري 2753","srcLabel":"متفق عليه","text":["قامَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم حينَ أنزَلَ اللهُ عزَّ وجلَّ: {وأنذِر عَشيرَتَكَ الأقرَبينَ} [الشعراء: 214]، قال: يا مَعشَرَ قُرَيشٍ -أو كَلِمةً نَحوها- ",["اشتَروا أنفُسَكُم",1],"، ",["لا أُغني عَنكُم مِنَ اللهِ شيئًا",2],"، يا بَني عبدِ مَنافٍ لا أُغني عَنكُم مِنَ اللهِ شيئًا، يا عَبَّاسُ بنَ عبدِ المُطَّلِبِ لا أُغني عَنكَ مِنَ اللهِ شيئًا، ويا صَفيَّةُ عَمَّةَ رَسولِ اللهِ لا أُغني عَنكِ مِنَ اللهِ شيئًا، ويا فاطِمةُ بنتَ مُحَمَّدٍ، سَليني ما شِئتِ مِن مالي لا أُغني عَنكِ مِنَ اللهِ شيئًا"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2753)، ومسلم (206)","bab":"قرآن › أسباب النزول","dorar":"FDSaGPH5"},{"id":"س-02491","fp":"262047e9aca4","stateId":450,"easy":"إذا سألت الولاية أو حرصت عليها ← لا تُولّاها","cause":"أحدًا سأَله ولا أحدًا حرَص عليه","result":"لا نُولِّي على هذا العملِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح ابن حبان 4481","srcLabel":"مسلم","text":["دخَلْتُ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّم أنا ورجلانِ مِن بني عمِّي فقال أحدُ الرَّجُلينِ: يا رسولَ اللهِ أمِّرْنا على بعضِ ما ولَّاك اللهُ وقال الآخَرُ مِثْلَ ذلك فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ( إنَّا واللهِ ",["لا نُولِّي على هذا العملِ",2]," ",["أحدًا سأَله ولا أحدًا حرَص عليه",1]," )"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (1733)، وأبو يعلى (7320)، وابن أبي شيبة (32541)، وابن الجارود في ((المنتقى)) (372) واللفظ لهم.","bab":"إمامة وخلافة › تولية الولاة وغيرهم","dorar":"YHIk9K7r","merged":2,"otherRefs":["صحيح البخاري 7149 (صحيح)"]},{"id":"س-05211","fp":"b2363198c8cb","stateId":450,"easy":"إذا علّمت الناس الخير ونسيت نفسك ← فأنت كالفتيلة تضيء للناس وتحرق نفسها","cause":"يُعلِّمُ الناسَ الخيرَ ، و يَنسى نفسَه","result":"مثلُ الفتيلةِ ، تضيءُ للناسِ ، و تحرِقُ نفسَها","explicit":true,"ref":"صحيح الجامع 5837","srcLabel":"السنة","text":["مثلُ الذي ",["يُعلِّمُ الناسَ الخيرَ ، و يَنسى نفسَه",1]," ، ",["مثلُ الفتيلةِ ، تضيءُ للناسِ ، و تحرِقُ نفسَها",2]],"grade":"صحيح","narrator":"أبو برزة الأسلمي وجندب","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"m7qhrTGm","merged":3,"otherRefs":["صحيح الترغيب 2329 (صحيح)","صحيح الترغيب 131 (صحيح)"]},{"id":"س-07033","fp":"dc78ce961ec5","stateId":450,"easy":"إذا جئت المسجد لغير الخير ← فأنت كمن ينظر إلى متاع غيره","cause":"و مَن جاءَ لغيرِ ذلكَ","result":"فهوَ بِمنزِلَةِ الرَّجُلِ يَنظرُ إلى مَتاعِ غيرِه","explicit":true,"ref":"صحيح الترغيب 87","srcLabel":"ابن ماجه","text":["مَن جاءَ مَسجدي هذا ، لَم يَأْتِه إلَّا لخيرٍ يَتعلَّمُه ، أو يُعلِّمُه فهوَ بِمنزِلَةِ المجاهدينَ في سَبيلِ اللهِ ، ",["و مَن جاءَ لغيرِ ذلكَ",1]," ، ",["فهوَ بِمنزِلَةِ الرَّجُلِ يَنظرُ إلى مَتاعِ غيرِه",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (227)، وأحمد (9419)","bab":"علم › الحث على طلب العلم","dorar":"SGWXGx2r","merged":2,"otherRefs":["المستدرك على الصحيحين 314 (صحيح)"]},{"id":"س-04935","fp":"2509b74589ea","stateId":450,"easy":"إذا قرأت القرآن ثم نسيته ← تلقى الله يوم القيامة أجذم","cause":"وما مِن رَجُلٍ قَرَأَ القُرآنَ فنَسيَه","result":"إلَّا لَقِيَ اللهَ يومَ يَلقاه وهو أجذَمُ","explicit":true,"ref":"تخريج المسند لشعيب 22463","srcLabel":"أحمد","text":["ما مِن أميرِ عَشَرةٍ إلَّا يُؤتَى به يومَ القِيامةِ مَغلولًا، لا يَفُكُّه مِن ذلك الغُلِّ إلَّا العَدلُ، ",["وما مِن رَجُلٍ قَرَأَ القُرآنَ فنَسيَه",1],"، ",["إلَّا لَقِيَ اللهَ يومَ يَلقاه وهو أجذَمُ",2],"."],"grade":"صحيح","narrator":"سعد بن عبادة","muhaddith":"صحيح لغيره دون قوله: \"وما من رجل قرأ القرآن ... إلخ","takhrij":"أخرجه أحمد (22463) واللفظ له، والدارمي (3340)، وعبدالرزاق (5989) مختصراً","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"dmvn7UbW"},{"id":"س-06550","fp":"b6dfc84dd8d4","stateId":450,"easy":"إذا تعلمت كتاب الله لتجادل به المؤمنين ← تهلك","cause":"قَوْمٌ يَتَعلَّمونَ كِتابَ اللهِ لِيُجادِلوا الَّذين آمَنوا","result":"سيَهلِكُ مِن أُمَّتي أهْلُ الكِتابِ، وأهْلُ اللبن","explicit":true,"ref":"الصحيح المسند 944","srcLabel":"الحاكم","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ قالَ: «",["سيَهلِكُ مِن أُمَّتي أهْلُ الكِتابِ، وأهْلُ [اللبن",2],"]»، فقالَ عُقْبةُ: يا رَسولَ اللهِ، وما أهْلُ الكِتابِ؟ قالَ: «",["قَوْمٌ يَتَعلَّمونَ كِتابَ اللهِ لِيُجادِلوا الَّذين آمَنوا",1],"»، فقالَ عُقْبةُ: يا رَسولَ اللهِ، وما أهْلُ [اللبن]؟ قالَ: «قَوْمٌ يَتَّبِعونَ الشَّهَواتِ، ويُضَيِّعونَ الصَّلَواتِ»، قالَ أبو قَبيلٍ: لا أَحسَبُ المُكَذِّبينَ بالقَدَرِ إلَّا الَّذين يُجادِلونَ الَّذين آمَنوا، وأمَّا أهْلُ اللبن فلا أَحسَبُهم إلَّا أهْلَ العَمودِ، ليس عليهم إمامُ جَماعةٍ، ولا يَعرِفونَ شَهْرَ رَمَضانَ."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه الروياني في ((المسند)) (240)، والطبري في ((التفسير)) (20/ 361)، والحاكم (3417)، والبيهقي في ((شعب الإيمان)) (2964) واللفظ لهم.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"4QEExsVP"},{"id":"س-07481","fp":"c8d29f8ef449","stateId":450,"easy":"إذا تركت عشر ما أُمرت به (في زمن الخير) ← هلكت","cause":"من ترَك منكم عشرَ ما أمرَ بِه","result":"هلَك","explicit":true,"repOf":"س-07491","ref":"صحيح الترمذي 2267","text":["إنَّكم في زمانٍ ",["من ترَك منكم عشرَ ما أمرَ بِه ",1],["هلَك",2]," ثمَّ يأتي زمانٌ من عملَ منكم بعشرِ ما أمرَ بِه نجا"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2267)، والطبراني في ((الصغير)) (1156)، وتمام في ((فوائده)) (76) واللفظ لهم.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"acjfN6UV"},{"id":"س-00597","fp":"fd8794c8a719","stateId":450,"easy":"إذا أطلقت حفظك للقرآن (تركت تعاهده) ← ذهب","cause":"وإن أطلَقَها","result":"ذَهَبَت","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"otherNeedIds":[16],"ref":"صحيح مسلم 789","srcLabel":"البخاري","text":["إنَّما مَثَلُ صاحِبِ القُرآنِ كمَثَلِ الإبِلِ المُعَقَّلةِ، إن عاهَدَ عليها أمسَكَها، ",["وإن أطلَقَها",1]," ",["ذَهَبَت",2],". [وفي روايةٍ]: وإذا قامَ صاحِبُ القُرآنِ فقَرَأه باللَّيلِ والنَّهارِ ذَكَرَه، وإذا لَم يَقُمْ به نَسيَه."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5031) باختلاف يسير ودون الرواية المذكورة","bab":"آداب عامة › ضرب الأمثال","dorar":"KvqlitTc","merged":6,"otherRefs":["تخريج صحيح ابن حبان 765 (صحيح)","تخريج المسند لشعيب 5923 (صحيح)","تخريج المسند لشعيب 4845 (صحيح)","نتائج الأفكار 3/186 (صحيح)","تخريج المسند لشاكر 7/61 (صحيح)"]},{"id":"س-07050","fp":"50a424cb0cce","stateId":450,"easy":"إذا لم تكن عالماً ولا متعلماً ولا مستمعاً ولا محباً ← تهلك","cause":"اغدُ عالِمًا أو متعَلِّمًا أو مُستَمِعًا أو محِبًّا، ولا تكُنِ الخامِسةَ","result":"فتَهلِكَ","explicit":true,"ref":"فيض القدير 2/ 17","srcLabel":"الطبراني","text":[["اغدُ عالِمًا أو متعَلِّمًا أو مُستَمِعًا أو محِبًّا، ولا تكُنِ الخامِسةَ",1]," ",["فتَهلِكَ",2]],"grade":"حسن","narrator":"أبو بكرة","muhaddith":"رجاله موثقون","takhrij":"أخرجه البزار (3626)، والطبراني في ((المعجم الأوسط)) (5171)، والبيهقي في ((شعب الإيمان)) (1581) جميعا بلفظه.","bab":"علم › الحث على طلب العلم","dorar":"4TwwLsXb"},{"id":"س-00568","fp":"bb3369faed84","stateId":450,"easy":"إذا تعلمت علماً لا تنتفع به ← فمثله كنز لا يُنفق في سبيل الله","cause":"علمٍ لا ينفعُ","result":"كمثلِ كنزٍ لا يُنفَقُ منه في سبيلِ اللهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"similar":["س-07016"],"ref":"إتحاف الخيرة المهرة 1/255","srcLabel":"أحمد","text":["مثلُ ",["علمٍ لا ينفعُ",1]," ، ",["كمثلِ كنزٍ لا يُنفَقُ منه في سبيلِ اللهِ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (10476)، والدارمي (556)، والبزار (9818) واللفظ له","bab":"آداب عامة › ضرب الأمثال","dorar":"3DmioxKq","merged":2,"otherRefs":["صحيح الجامع 2112 (حسن)"]},{"id":"س-07016","fp":"6489d362abd6","stateId":450,"easy":"إذا تعلمت علماً لا تنتفع به ← فهو كنز لا يُنفق","cause":"علمٍ لا يُنتفعُ بهِ","result":"كمثلِ كَنزٍ لا ينفَقُ في سبيلِ اللهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-00568","ref":"هداية الرواة 269","text":["مَثلُ ",["علمٍ لا يُنتفعُ بهِ",1],": ",["كمثلِ كَنزٍ لا ينفَقُ في سبيلِ اللهِ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه أحمد (10476)، والدارمي (556) واللفظ له، والبزار (9818)","bab":"علم › الحث على طلب العلم","dorar":"WlhCKzs3","merged":2,"otherRefs":["العلم لأبي خيثمة 12 (حسن)"]},{"id":"س-00652","fp":"c49d1b9d3058","stateId":450,"easy":"إذا علّمت الناس الخير ولم تعمل به ← فمثلك كالسراج يضيء للناس ويحرق نفسه","cause":"العالمِ الذي يُعَلِّمُ النَّاسَ الخَيرَ ولا يَعمَلُ به","result":"كَمَثَلِ السِّراجِ يُضيءُ للنَّاسِ ويُحرِقُ نَفسَه","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"فتح البيان 1/ 157","srcLabel":"السنة","text":["مَثَلُ ",["العالمِ الذي يُعَلِّمُ النَّاسَ الخَيرَ ولا يَعمَلُ به",1]," ",["كَمَثَلِ السِّراجِ يُضيءُ للنَّاسِ ويُحرِقُ نَفسَه",2],"."],"grade":"حسن","narrator":"جندب بن عبد الله","muhaddith":"إسناده جيد","bab":"آداب عامة › ضرب الأمثال","dorar":"bgtCtXeN"},{"id":"س-07088","fp":"9d1f58cf11f1","stateId":450,"easy":"إذا لم تكن عالماً ولا متعلماً ← فلا خير فيك","cause":"وسائرُ الناسِ","result":"لا خَيْرَ فيه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الجامع الصغير 5638","srcLabel":"الطبراني","text":["العالمُ والمتعلمُ شَرِيكانِ في الخيرِ ، ",["وسائرُ الناسِ",1]," ",["لا خَيْرَ فيه",2]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((الشاميين)) (2218)، والقضاعي في ((مسند الشهاب)) (279)، وأبو علي الصدفي في ((معجمه)) (صـ257) باختلاف يسير.","bab":"علم › تعليم الناس وفضل ذلك","dorar":"uHmsz0sG"},{"id":"س-01588","fp":"b08928337841","stateId":451,"easy":"إذا أكلت الثوم أو البصل فلا تقرب المسجد ← فالملائكة تتأذى مما يتأذى منه الناس","cause":"مِن أكلِها فوجَد ريحَها فقال : ألَمْ أَنْهَكم عن هذه البَقْلةِ الخبيثةِ أو المُنتنةِ ؟ مَن أكَلها فلا يَغْشَنا في مساجِدِنا","result":"فإنَّ الملائكةَ تتأذَّى ممَّا يتأذَّى منه الإنس","explicit":true,"star":true,"similar":["س-03620"],"ref":"صحيح ابن حبان 1646","srcLabel":"متفق عليه","text":["نهى رسولُ اللهِ صلَّى اللهُ عليه وسلَّم عن أكلِ الكُرَّاثِ فلَمْ ينتَهوا ثمَّ لَمْ يجِدوا بُدًّا ",["مِن أكلِها فوجَد ريحَها فقال : ( ألَمْ أَنْهَكم عن هذه البَقْلةِ الخبيثةِ أو المُنتنةِ ؟ مَن أكَلها فلا يَغْشَنا في مساجِدِنا",1]," ",["فإنَّ الملائكةَ تتأذَّى ممَّا يتأذَّى منه الإنس",2],"انُ )"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه السراج في ((حديثه)) (2392) واللفظ له، وأخرجه البخاري (854)، ومسلم (563) باختلاف يسير.","bab":"أطعمة › أكل الثوم والبصل والكراث","dorar":"VUyus9Nr","merged":5,"otherRefs":["صحيح النسائي 706 (صحيح)","صحيح الجامع 6089 (صحيح)","صحيح مسلم 564 (صحيح)","حلية الأولياء 3/372 (صحيح)"]},{"id":"س-03620","fp":"067724b162ce","stateId":451,"easy":"إذا أكلت الثوم والبصل فلا تحضر المسجد ← فالملائكة تتأذى مما يتأذى منه بنو آدم","cause":"مَن أكَلَهُما فلا يَحضُرْ مسجِدَنا","result":"فإنَّ المَلائكةَ تتَأذَّى ممَّا يَتأذَّى منه بَنو آدَمَ","explicit":true,"repOf":"س-01588","ref":"تخريج المسند لشعيب 15159","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسَلَّم نَهى -زَمَنَ خَيبَرَ- عن البَصَلِ والكُرَّاثِ، فأكَلَهُما قَومٌ، ثُمَّ جاءوا إلى المسجِدِ، فقال النَّبيُّ صلَّى اللهُ عليه وسَلَّم: ألَمْ أنْهَ عن هاتَينِ الشَّجَرتَينِ المُنتِنَتَينِ؟ قالوا: بلى يا رسولَ اللهِ، ولكِنْ أجْهَدَنا الجوعُ. فقال رسولُ اللهِ صلَّى اللهُ عليه وسَلَّم: ",["مَن أكَلَهُما فلا يَحضُرْ مسجِدَنا",1],"؛ ",["فإنَّ المَلائكةَ تتَأذَّى ممَّا يَتأذَّى منه بَنو آدَمَ",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (855) بلفظ مقارب ودون ذكر الكراث، ومسلم (564) باختلاف يسير","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"XUTwOr5i","merged":3,"otherRefs":["صحيح ابن ماجه 2729 (صحيح)","صحيح ابن خزيمة 3/ 161 (صحيح)"]},{"id":"س-08224","fp":"56a1e968f272","stateId":451,"easy":"إذا كان في بيتك كلب أو جنب أو صورة ذي روح ← لا يدخله ملك","cause":"كَلْبُ أو جَنابةٌ أو صورةُ رُوحٍ","result":"ثَلاثٌ، لن يَلِجَ مَلَكٌ ما دامَ فيها أبَدًا","explicit":true,"star":true,"ref":"الأحاديث المختارة 757","srcLabel":"البخاري","text":["«كانَت لي مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم مَنزِلةٌ لم تكنْ لأحَدٍ مِن الخَلائِقِ، إنِّي كُنْتُ آتيه كلَّ سَحَرٍ فأُسَلِّمُ عليه حتَّى يَتَنَحْنَحَ، وإنِّي جِئْتُ ذاتَ لَيْلةٍ فسَلَّمْتُ عليه فقُلْتُ: السَّلامُ عليك يا نَبيَّ اللهِ، فقالَ: على رِسْلِك يا أبا حَسَنٍ حتَّى أَخرُجَ إليك، فلمَّا خَرَجَ إليَّ قُلْتُ: يا نَبيَّ اللهِ أَغْضَبَك أحَدٌ؟ قالَ: لا، قُلْتُ: فما لك لم تُكَلِّمْني فيما مَضى حتَّى كَلَّمْتَني اللَّيْلةَ؟ قالَ: إنِّي سَمِعْتُ في الحُجْرةِ حَرَكةً فقُلْتُ: مَن هذا؟ فقالَ: أنا جِبْريلُ، قُلْتُ: ادْخُلْ، قالَ: لا، اخْرُجْ إليَّ، فلمَّا خَرَجْتُ قالَ: إنَّ في بَيْتِك شَيئًا لا يَدخُلُه مَلَكٌ ما دامَ فيه، قُلْتُ: ما أَعلَمُه يا جِبْريلُ، قالَ: اذْهَبْ فانْظُرْ، ففَتَحْتُ البَيْتَ فلم أَجِدْ فيه شَيئًا غَيْرَ جَرْوٍ كانَ يَلعَبُ به الحَسَنُ، قُلْتُ: ما وَجَدْتُ إلَّا جَرْوًا، قالَ: إنَّها ",["ثَلاثٌ، لن يَلِجَ مَلَكٌ ما دامَ فيها أبَدًا",2]," واحِدٌ مِنها: ",["كَلْبُ أو جَنابةٌ أو صورةُ رُوحٍ",1],"»."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"ملائكة › أعمال الملائكة","dorar":"GyjTnu4a","merged":2,"otherRefs":["الأحاديث المختارة 755 (صحيح)"]},{"id":"س-02772","fp":"1a92a933152b","stateId":451,"easy":"إذا كان في بيتك تمثال وصورة وكلب ← تتأخر عنه الملائكة","cause":"إنَّ في البَيتِ تِمثالًا، وسِترًا فيه صورةٌ، وكَلبًا","result":"فتأخَّرَ عنه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-03653","س-02731"],"ref":"مجموع فتاوى ابن باز 92/8","srcLabel":"مسلم","text":["[أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم] كان على مَوعِدٍ مع جِبرائيلَ عليه السَّلامُ، ",["فتأخَّرَ عنه",2],"، فخرَجَ إليه يَنتظِرُه، فقال له جِبرائيلُ: ",["إنَّ في البَيتِ تِمثالًا، وسِترًا فيه صورةٌ، وكَلبًا",1],"؛ فمُرْ برَأسِ التِّمثالِ أنْ يُقطَعَ حتى يكونَ كهَيئَةِ الشَّجَرةِ، ومُرْ بالسِّتْرِ أنْ يُتَّخذَ منه وِسادَتانِ مُنتَبَذتانِ تُوطآنِ، ومُرْ بالكَلْبِ أنْ يُخرَجَ، ففعَلَ النَّبيُّ صلَّى اللهُ عليه وسلَّم، فدخَلَ جِبرائيلُ عليه السَّلامُ. قال أبو هُرَيرةَ: وكان الكَلبُ جَروًا تحت نَضَدٍ في البَيتِ، أدخَلَه الحَسنُ أو الحُسَينُ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4158)، والترمذي (2806) بلفظه، ومسلم (2112) مختصرا.","bab":"إيمان › الملائكة","dorar":"z2BBfFYt","merged":6,"otherRefs":["مجموع فتاوى ابن باز 223/4 (حسن)","تحفة المحتاج 2/387 (صحيح)","غاية المرام 130 (صحيح)","تخريج صحيح ابن حبان 5854 (صحيح)","تخريج سنن أبي داود 4158 (صحيح)"]},{"id":"س-02737","fp":"566c032a8e0c","stateId":451,"easy":"إذا كان معكم جرس في سفركم ← لا تصحبكم الملائكة","cause":"رَكْبًا معهم الجُلجُلُ","result":"لا تَصحَبُ الملائكةُ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 4811","srcLabel":"النسائي","text":["كُنتُ مع سالِمِ بنِ عبدِ اللهِ بنِ عُمَرَ، فمَرَّتْ رُفقَةٌ لأُمِّ البَنينَ فيها أجْراسٌ فحدَّثَ سالِمٌ، عن أبيه عن النَّبيِّ صلَّى اللهُ عليه وسلَّم أنَّه قال: ",["لا تَصحَبُ الملائكةُ",2]," ",["رَكْبًا معهم الجُلجُلُ",1],"، فكم تَرى في هؤلاء من جُلجُلٍ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي (5219)، وأحمد (4811) واللفظ له","bab":"إيمان › الملائكة","dorar":"e5NErNG7","merged":10,"otherRefs":["الجامع الصغير 4524 (صحيح)","تخريج المسند لشعيب 26771 (صحيح)","تخريج المسند لشعيب 26780 (صحيح)","جامع المسانيد والسنن 2699 (صحيح)","مجمع الزوائد 5/178 (حسن)","صحيح الترغيب 3117 (صحيح)","صحيح الترغيب 3121 (صحيح)","الترغيب والترهيب 4/112 (صحيح)","علل الأحاديث 114 (صحيح)"]},{"id":"س-03653","fp":"1f6820ba1f8c","stateId":451,"easy":"إذا كان في بيتك كلب ← لا تدخله الملائكة","cause":"بيتًا ؛ فيه كلبٌ","result":"لا تدخلُ الملائكةُ","explicit":true,"repOf":"س-02772","ref":"صحيح أبي داود 4153","text":[["لا تدخلُ الملائكةُ",2]," ",["بيتًا ؛ فيه كلبٌ",1]," ، ولا تمثالٌ . وقال : انطلق بنا إلى أمِّ المؤمنين عائشةَ نسألُها عن ذلك ، فانطلقنا فقلنا : يا أمَّ المؤمنين : إنَّ أبا طلحةَ ، حدَّثنا عن رسولِ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ ، بكذا وكذا ! ؟ فهل سمعتِ النبيَّ صلَّى اللهُ عليْهِ وسلَّمَ يذكرُ ذلك ؟ قالت : لا ! ولكن سأُحدِّثُكم بما رأيتُه فعل ، خرج رسولُ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ في بعضِ مغازيهِ ، وكنتُ أتحيَّنُ قُفُولَه ، فأخذتُ نَمَطًا كان لنا فسترتُه على العَرَضِ فلما جاء استقبلتُه ، فقلتُ : السلامُ عليك يا رسولَ اللهِ ورحمةُ اللهِ وبركاتُه ، الحمدُ للهِ الذي أعزَّك وأكرمَك . فنظر إلى البيتِ ، فرأى النَّمطَ ، فلم يردَّ عليَّ شيئًا ، ورأيتُ الكراهيةَ في وجهِه ، فأتى النَّمطَ حتى هتكَه ، ثم قال : إنَّ اللهَ لم يأْمُرنا فيما رزقنا أن نكسو الحجارةَ واللَّبِنَ . قالت : فقطعتُه وجعلتُه وسادتيْنِ وحشوتُهما ليفًا ، فلم يُنكر ذلك عليَّ"],"grade":"صحيح","narrator":"أبو طلحة الأنصاري زيد بن سهل","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4153)، والنسائي في ((الكبرى)) (10316)، وابن حبان (5468) واللفظ لهم.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"mgq7Vw2I","merged":25,"otherRefs":["سنن الترمذي 2805 (صحيح)","صحيح البخاري 3224 (صحيح)","تخريج صحيح ابن حبان 5853 (صحيح)","تخريج المسند لشعيب 25100 (صحيح)","تخريج مشكل الآثار 886 (صحيح)","صحيح ابن خزيمة 1/ 399 (صحيح)","الصحيح المسند 2/359 (صحيح)","نخب الافكار 13/468 (صحيح)","نخب الافكار 13/477 (صحيح)","تخريج صحيح ابن حبان 5468 (صحيح)","تخريج صحيح ابن حبان 5858 (صحيح)","صحيح مسلم 2106 (صحيح)","المجموع للنووي 2/157 (حسن)","صحيح الترغيب 3104 (صحيح)","صحيح الجامع 1330 (صحيح)","تخريج مشكل الآثار 883 (صحيح)","نخب الافكار 12/82 (صحيح)","الأحاديث المختارة 1349 (صحيح)","الأحاديث المختارة 1346 (صحيح)","الأحاديث المختارة 1348 (صحيح)","حلية الأولياء 3/295 (صحيح)","صحيح مسلم 2107 (صحيح)","صحيح البخاري 5960 (صحيح)","السلسلة الصحيحة 356 (صحيح)"]},{"id":"س-02553","fp":"ee7e8776c5d7","stateId":451,"easy":"إذا تخاصمتم ← تُرفع عنكم البركة (رُفعت ليلة القدر)","cause":"فجاء رجلانِ يَحْتَقَّانِ ، ومعهما الشيطانُ","result":"فنُسِّيتُها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[39],"ref":"صحيح الجامع 7874","srcLabel":"متفق عليه","text":["يا أَيُّها الناسُ ! إنها كانت أُبِينَتْ لي ليلةُ القَدْرِ : وإني خرجتُ لِأُخبرَكم بها ، ",["فجاء رجلانِ يَحْتَقَّانِ ، ومعهما الشيطانُ",1]," ",["فنُسِّيتُها",2]," ، فالتَمِسُوها في العَشْرِ الأواخِرِ من رمضانَ ، التَمِسُوها في التاسعةِ ، والسابعةِ ، والخامسةِ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1167) واللفظ له، والبخاري (2036) بمعناه، وأبو داود (1383) بنحوه.","bab":"إيمان › أعمال الجن والشياطين","dorar":"0HiJ3zVP"},{"id":"س-04868","fp":"2e95df83481c","stateId":451,"easy":"إذا كان فيكم قاطع رحم ← لا تنزل الرحمة عليكم","cause":"فيهم قاطعُ رَحِمٍ","result":"لا تَنزِلُ الرَّحمةُ على قومٍ","explicit":true,"otherNeedIds":[39],"ref":"هداية الرواة 4/413","srcLabel":"البخاري","text":[["لا تَنزِلُ الرَّحمةُ على قومٍ",2]," ",["فيهم قاطعُ رَحِمٍ",1]],"grade":"حسن","narrator":"عبدالله بن أبي أوفى","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه البخاري في ((التاريخ الكبير)) (4/14)، وابن عدي في ((الكامل في الضعفاء)) (3/258)، وأخرجه البيهقي في ((شعب الإيمان)) (7962) مطولاً","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"5UoYjCtB"},{"id":"س-07344","fp":"69469ee8a411","stateId":451,"easy":"إذا تلاحيتم ← تُرفع البركة","cause":"فتَلاحَى رجُلانِ","result":"فاخْتَلَجَتْ مِنِّي","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-05029"],"otherNeedIds":[39],"ref":"صحيح الجامع 3226","srcLabel":"البخاري","text":["خرجْتُ و أنا أُرِيدُ أنْ أُخْبِرَكُم بليلةِ القدْرِ ، ",["فتَلاحَى رجُلانِ",1]," ",["فاخْتَلَجَتْ مِنِّي",2]," ، فاطْلُبُوها في العشرِ الأواخرِ : في سابِعةٍ تبقى ، أو تاسعةٍ تبقى ، أو خامِسةٍ تَبقى"],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (3679) واللفظ له، وأخرجه البخاري (2023) باختلاف يسير","bab":"فتن › كراهية الاختلاف","dorar":"RjEN2Ecf"},{"id":"س-02749","fp":"f99c396a20fe","stateId":451,"easy":"إذا كان في بيتك تصاوير ← لا تدخله الملائكة","cause":"بَيْتًا فيه تَصاويرُ","result":"المَلائِكةَ لا تَدخُلُ","explicit":true,"similar":["س-02747","س-07629"],"ref":"الصحيح المسند 963","srcLabel":"النسائي","text":["عن علِيٍّ أنَّه صَنَعَ طَعامًا فدَعا رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، فجاءَ فرَأى في البَيْتِ سِتْرًا فيه تَصاويرُ، فرَجَعَ، قالَ: فقُلْتُ: يا رَسولَ اللهِ، ما رَجَعَك بأبي أنت وأمِّي؟ قالَ: إنَّ في البَيْتِ سِتْرًا فيه تَصاويرُ، وإنَّ ",["المَلائِكةَ لا تَدخُلُ",2]," ",["بَيْتًا فيه تَصاويرُ",1],"."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح","takhrij":"أخرجه النسائي (5351)، والبزار (523)، وأبو يعلى (436) واللفظ لهم.","bab":"إيمان › الملائكة","dorar":"QwrrYhfx","merged":3,"otherRefs":["الصحيح المسند 2/51 (صحيح)","البحر الزخار 2/157 (صحيح)"]},{"id":"س-08104","fp":"318a184f3605","stateId":451,"easy":"إذا كنت جنباً أو سكران أو متضمخاً بالخلوق ← لا تقربك الملائكة","cause":"الجنُبُ والسَّكرانُ والمُتضمِّخُ بالخَلوقِ","result":"ثلاثةٌ لا تقرَبُهم الملائكةُ","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 2/154","srcLabel":"الطبراني","text":[["ثلاثةٌ لا تقرَبُهم الملائكةُ",2]," ",["الجنُبُ والسَّكرانُ والمُتضمِّخُ بالخَلوقِ",1]],"grade":"صحيح","narrator":"[بريدة بن الحصيب الأسلمي]","muhaddith":"إسناده صحيح","takhrij":"أخرجه البزار (4446)، والعقيلي في ((الضعفاء الكبير)) (2/241)، والطبراني في ((المعجم الأوسط)) (5233) باختلاف يسير.","bab":"ملائكة › أعمال الملائكة","dorar":"BSNiyR3u","merged":3,"otherRefs":["صحيح أبي داود 4176 (حسن)","صحيح الجامع 1959 (حسن)"]},{"id":"س-02747","fp":"77e4016f36a1","stateId":451,"easy":"إذا كان في بيتك جرس ← لا تدخله الملائكة","cause":"بَيْتًا فيه جَرَسٌ","result":"لا تَدخُلُ المَلائِكةُ","explicit":true,"repOf":"س-02749","ref":"الأحكام الوسطى 4/ 206","text":["بَيْنَما هي عنْدَها إذ دَخَلَ عليها بجارِيةٍ وعليها خَلاخِلُ يُصَوِّتْنَ،\n فقالَتْ: لا تُدخِلَنَّها علَيَّ إلَّا أن تَقطَعَ جَلاجِلَها، وقالَتْ: سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: \"",["لا تَدخُلُ المَلائِكةُ",2]," ",["بَيْتًا فيه جَرَسٌ",1],"\"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (4231)، وأحمد (26052)، والطبراني في ((مسند الشاميين)) (2720) واللفظ لهم","bab":"إيمان › الملائكة","dorar":"CoeH5nlb","merged":2,"otherRefs":["الترغيب والترهيب 4/112 (صحيح)"]},{"id":"س-07629","fp":"8a368f3fad17","stateId":451,"easy":"إذا كان في بيتك ستر فيه تصاوير ← لا تدخله الملائكة","cause":"وفي بيتِك سِترٌ فيه تَصاويرُ","result":"كيفَ أدخلُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-02749","ref":"غاية المرام 141","text":["إنَّ جبريلَ استَأذَنَ علَى النَّبيِّ فقال: ادخُلْ، قال: ",["كيفَ أدخلُ",2]," ",["وفي بيتِك سِترٌ فيه تَصاويرُ",1],"؟ فإنْ كنتَ لا بدَّ فاعلًا فاقطعْ رأسَها أو اقطَعها وسائدَ أو اجعَلها بُسطًا"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2107) بمعناه.","bab":"فضائل النبي وصفته ودلائل النبوة › نزول الوحي عليه صلى الله عليه وسلم","dorar":"Wu8zGstJ"},{"id":"س-02750","fp":"be2a6162832d","stateId":451,"easy":"إذا كان في بيتك بول منتقع ← لا تدخله الملائكة","cause":"بيتًا فيه بولٌ مُنتقِعٌ","result":"الملائكةَ لا تدخلُ","explicit":true,"ref":"صحيح الترغيب 153","srcLabel":"الطبراني","text":["لا يُنقَعُ بولٌ في طَستٍ في البيتِ ، فإنَّ ",["الملائكةَ لا تدخلُ",2]," ",["بيتًا فيه بولٌ مُنتقِعٌ",1]," ، و لا تبولنَّ في مُغتَسَلِك"],"grade":"صحيح","narrator":"عبدالله بن يزيد الخطمي","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (2077)","bab":"إيمان › الملائكة","dorar":"aH3tSdK6"},{"id":"س-04845","fp":"2377ddeb128f","stateId":451,"easy":"إذا نحت أو صرخت ← لا تصلي عليك الملائكة","cause":"نائِحةٍ ، ولا عَلى مُرنَّةٍ","result":"لا تُصلِّي الملائِكَةُ","explicit":true,"ref":"تخريج المسند لشاكر 16/304","srcLabel":"أبو داود","text":[["لا تُصلِّي الملائِكَةُ",2]," على ",["نائِحةٍ ، ولا عَلى مُرنَّةٍ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود الطيالسي (2579)، وأحمد (8746)، وأبو يعلى (6137) جميعا بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"5duTUL9u"},{"id":"س-08060","fp":"c6ea10682764","stateId":451,"easy":"إذا تركت الاستخارة وسخطت بما قضى الله ← فهو من شقاوتك","cause":"تركُهُ استخارةَ اللهِ، و منْ شقاوةِ ابنِ آدمِ سخطُه بما قضى اللهُ لهُ","result":"ومنْ شَقَاوةِ ابنِ آدمَ","explicit":true,"otherNeedIds":[10],"ref":"الجامع الصغير 8233","srcLabel":"أحمد","text":["منْ سعادةِ ابنِ آدمَ استخارتُهُ اللهَ،  و منْ سعادةِ ابنِ آدمَ رضاهُ بما قضَى اللهُ ",["ومنْ شَقَاوةِ ابنِ آدمَ",2]," ",["تركُهُ استخارةَ اللهِ،  و منْ شقاوةِ ابنِ آدمِ سخطُه بما قضى اللهُ لهُ",1]],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"صحيح","takhrij":"أخرجه أحمد (1444)، والحاكم (1903)، والبزار (1097) باختلاف يسير.","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"9y7jfN90"},{"id":"س-08210","fp":"fce0083a4796","stateId":451,"easy":"إذا كذبت ← تباعد عنك الملك ميلاً من نتن ما جئت به","cause":"إذا كذب العبدُ","result":"تباعد الملَكُ عنه مِيلًا من نتنِ ما جاء به","explicit":true,"ref":"الترغيب والترهيب 4/55","srcLabel":"الترمذي","text":[["إذا كذب العبدُ",1]," ",["تباعد الملَكُ عنه مِيلًا من نتنِ ما جاء به",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (1972)، والكلاباذي في ((بحر الفوائد)) (ص52)","bab":"ملائكة › أعمال الملائكة","dorar":"rgXynfrm"},{"id":"س-02731","fp":"2d27ffcda5b8","stateId":451,"easy":"إذا كان في بيتك كلب أو تمثال صورة ← لا تدخله الملائكة","cause":"كَلبٌ كان في البَيتِ، وتِمثالُ صورةٍ في سِترٍ كان على البابِ","result":"فما منَعَني مِنَ الدُّخولِ عليكَ إلَّا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-02772","ref":"تخريج المسند لشعيب 10193","text":["جاءَ جِبريلُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقال: أتَيتُكَ البارِحةَ ",["فما منَعَني مِنَ الدُّخولِ عليكَ إلَّا",2]," ",["كَلبٌ كان في البَيتِ، وتِمثالُ صورةٍ في سِترٍ كان على البابِ",1],"، قال: فنَظَروا، فإذا جَرْوٌ للحَسَنِ أو الحُسَينِ، كان تَحتَ نَضَدٍ لهم، فأمَرَ بالكَلبِ فأُخرِجَ، وأن يُقطَعَ رَأسُ الصُّورةِ حتى تَكونَ مِثلَ الشَّجرةِ، ويُجعَلَ السِّترُ مِنبَذَتَيْنِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4158)، والترمذي (2806)، وأحمد (10193) واللفظ له","bab":"إيمان › الملائكة","dorar":"18ibX98H","merged":2,"otherRefs":["تخريج المسند لشعيب 9063 (صحيح)"]},{"id":"س-05029","fp":"a1b306fbd39f","stateId":451,"easy":"إذا تلاحيتم ← تُرفع البركة","cause":"فتَلاحى رَجُلانِ مِنَ المُسلِمينَ","result":"وإنَّها رُفِعَت","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-07344","otherNeedIds":[39],"ref":"صحيح البخاري 6049","text":["خَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم ليُخبِرَ النَّاسَ بلَيلةِ القدرِ، ",["فتَلاحى رَجُلانِ مِنَ المُسلِمينَ",1],"، قال النَّبيُّ صلَّى اللهُ عليه وسلَّم: خَرَجتُ لأُخبِرَكُم، فتَلاحى فُلانٌ وفُلانٌ، ",["وإنَّها رُفِعَت",2],"، وعَسى أن يَكونَ خَيرًا لَكُم، فالتَمِسوها في التَّاسِعةِ، والسَّابِعةِ، والخامِسةِ."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (22672)، والدارمي (1822)، وابن حبان (3679) واللفظ لهم جميعا.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Wouo73oL"},{"id":"س-07632","fp":"8c4298357403","stateId":451,"easy":"إذا كان في بيتك جرو ← تحتبس عنك الملائكة","cause":"جَرْوٌ في بَيتِكَ","result":"احتَبَسَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج مشكل الآثار 5236","srcLabel":"الطحاوي","text":["أنَّ جِبريلَ ",["احتَبَسَ",2]," عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ ثم أتاهُ، فقال: ما حبَسَكَ؟ قال: ",["جَرْوٌ في بَيتِكَ",1],". فنَظَروا، فإذا جَرْوٌ تحتَ السَّريرِ، فأمَرَ به النَّبيُّ صلَّى اللهُ عليه وسلَّمَ فأُخرِجَ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (5236) بلفظه، وابن راهويه (1069) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › نزول الوحي عليه صلى الله عليه وسلم","dorar":"S7XV9Lls"},{"id":"س-04859","fp":"80354c5f35f7","stateId":451,"easy":"إذا لغطت في المسجد ← تُرفع البركة (اختُلست ليلة القدر)","cause":"فسمعَ لغطًا في المسجدِ","result":"فاختُلِستْ منهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 3/179","srcLabel":"الطبراني","text":["خرجَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ ذاتَ ليلةٍ وهوَ يريدُ أن يخبرَنا بليلةِ القدرِ وقد أخبرَنا بهِ ",["فسمعَ لغطًا في المسجدِ",1]," ",["فاختُلِستْ منهُ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"رجاله ثقات","takhrij":"أخرجه أبو يعلى (4021) واللفظ له، والطبراني في ((المعجم الأوسط)) (8186) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"KQdhYMtF"},{"id":"س-08238","fp":"5abd4b366c58","stateId":451,"easy":"إذا لم تستك ولم تقلّم أظفارك ولم تقص شاربك ← يبطئ عنك الوحي (الملك)","cause":"لا تستنُّون ولا تُقلِّمون أظافرَكم ولا تقصُّون شواربَكم ولا تُنقُّون رواجِبَكم","result":"ولِمَ لا يبطئُ عني","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 5/170","srcLabel":"السنة","text":["عن النبيِّ صلَّى اللهُ عليه وسلَّم أنه قيل له يا رسولَ اللهِ لقد أبطأ عليك خبرُ جبريلَ قال ",["ولِمَ لا يبطئُ عني",2]," وأنتم حولي ",["لا تستنُّون ولا تُقلِّمون أظافرَكم ولا تقصُّون شواربَكم ولا تُنقُّون رواجِبَكم",1]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"فيه أبو كعب مولى ابن عباس ورجاله ثقات","bab":"ملائكة › فضل جبريل","dorar":"PpZ1lHU1"},{"id":"س-08190","fp":"52d032d66a54","stateId":451,"easy":"إذا قمت تتوضأ ولم تستك ← لا يضع الملك فاه على فيك","cause":"وإذا لمْ يَسْتَنَّ","result":"أَطَافَ بهِ ، ولا يَضَعُ فَاهُ على فيهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الجامع 723","srcLabel":"السنة","text":["إذا قامَ الرجلُ يَتَوَضَّأُ لَيْلا أوْ نَهارًا فَأحسنَ الوُضُوءَ واسْتَنَّ ، ثُمَّ قامَ فَصلَّى أَطَافَ بهِ المَلَكُ ودَنا مِنْهُ ؛ حتى يَضَعَ فَاهُ على فيهِ ، فما يقرأُ إلَّا في فيهِ ، ",["وإذا لمْ يَسْتَنَّ",1]," ",["أَطَافَ بهِ ، ولا يَضَعُ فَاهُ على فيهِ",2]],"grade":"صحيح","narrator":"ابن شهاب وعلي بن أبي طالب","muhaddith":"صحيح","bab":"ملائكة › أعمال الملائكة","dorar":"dRM4uiRO"},{"id":"س-08213","fp":"b8b862289e44","stateId":451,"easy":"إذا علّقت الجرس على الدابة ← لا تصحبها الملائكة","cause":"دابَّةً في عُنُقِهَا جَرَسٌ","result":"ملائكةً يَنْزِلُونَ في كلِّ ليلةٍ ، يحسون الكَلَالَ عن دَوَابِّ الغُزَاةِ ، إلا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الجامع الصغير (4/ 39)","srcLabel":"الطبراني","text":["إنَّ للهِ تعالى ",["ملائكةً يَنْزِلُونَ في كلِّ ليلةٍ ، يحسون الكَلَالَ عن دَوَابِّ الغُزَاةِ ، إلا",2]," ",["دابَّةً في عُنُقِهَا جَرَسٌ",1]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"حسن","takhrij":"أخرجه الطبراني كما في ((الجامع الصغير)) للسيوطي (1/198)","bab":"ملائكة › أعمال الملائكة","dorar":"FikZWSG6"},{"id":"س-06281","fp":"d591b5072a6e","stateId":452,"easy":"إذا كثرت أموالك ولم تنفقها يميناً وشمالاً ← تكون من الأخسرين","cause":"هُمُ الأكثَرونَ أموالًا، إلَّا مَن قال هَكَذا وهَكَذا وهَكَذا، مِن بينَ يَدَيه ومِن خَلفِه وعَن يَمينِه وعَن شِمالِه","result":"هُمُ الأخسَرونَ ورَبِّ الكَعبةِ","explicit":true,"star":true,"ref":"صحيح مسلم 990","srcLabel":"البخاري","text":["انتَهَيتُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم وهو جالِسٌ في ظِلِّ الكَعبةِ، فلَمَّا رَآني قال: ",["هُمُ الأخسَرونَ ورَبِّ الكَعبةِ",2],"! قال: فجِئتُ حتَّى جَلَستُ، فلَم أتَقارَّ أن قُمتُ فقُلتُ: يا رَسولَ اللهِ، فِداكَ أبي وأُمِّي، مَن هُم؟ قال: ",["هُمُ الأكثَرونَ أموالًا، إلَّا مَن قال هَكَذا وهَكَذا وهَكَذا، مِن بينَ يَدَيه ومِن خَلفِه وعَن يَمينِه وعَن شِمالِه",1],"، وقَليلٌ ما هُم، ما مِن صاحِبِ إبِلٍ ولا بَقَرٍ ولا غَنَمٍ لا يُؤَدِّي زَكاتَها إلَّا جاءَت يَومَ القيامةِ أعظَمَ ما كانَت وأسمَنَه، تَنطَحُه بقُرونِها وتَطَؤُه بأظلافِها، كُلَّما نَفِدَت أُخراها عادَت عليه أُولاها، حتَّى يُقضى بينَ النَّاسِ. [وفي روايةٍ]: انتَهَيتُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم وهو جالِسٌ في ظِلِّ الكَعبةِ، فذَكَرَ نَحوَ حَديثِ وكيعٍ، غيرَ أنَّه قال: والذي نَفسي بيَدِه ما على الأرضِ رَجُلٌ يَموتُ فيَدَعُ إبِلًا أو بَقَرًا أو غَنَمًا لَم يُؤَدِّ زَكاتَها."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1460) باختلاف يسير","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"idPGCs5y","merged":4,"otherRefs":["صحيح البخاري 6638 (صحيح)","صحيح الترمذي 617 (صحيح)","حلية الأولياء 7/421 (صحيح)"]},{"id":"س-07335","fp":"10bf840030c0","stateId":452,"easy":"إذا صرت عبداً للدينار والدرهم ترضى إن أُعطيت وتسخط إن مُنعت ← تعست وانتكست","cause":"الدِّينارِ، وعَبدُ الدِّرهَمِ، وعَبدُ الخَميصةِ، إن أُعطيَ رَضيَ، وإن لَم يُعطَ سَخِطَ، تَعِسَ وانتَكَسَ، وإذا شيكَ فلا انتَقَشَ، طوبى لعَبدٍ آخِذٍ بعِنانِ فرَسِه في سَبيلِ اللهِ، أشعَثَ رَأسُه، مُغبَرَّةٍ قدَماه، إن كان في الحِراسةِ كان في","result":"تَعِسَ عبدُ","explicit":true,"star":true,"otherNeedIds":[27],"ref":"صحيح البخاري 2887","srcLabel":"متفق عليه","text":[["تَعِسَ عبدُ",2],[" الدِّينارِ، وعَبدُ الدِّرهَمِ، وعَبدُ الخَميصةِ، إن أُعطيَ رَضيَ، وإن لَم يُعطَ سَخِطَ، تَعِسَ وانتَكَسَ، وإذا شيكَ فلا انتَقَشَ، طوبى لعَبدٍ آخِذٍ بعِنانِ فرَسِه في سَبيلِ اللهِ، أشعَثَ رَأسُه، مُغبَرَّةٍ قدَماه، إن كان في الحِراسةِ كان في",1]," الحِراسةِ، وإن كان في السَّاقةِ كان في السَّاقةِ، إنِ استَأذَنَ لَم يُؤذَنْ له، وإن شَفَعَ لَم يُشَفَّعْ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[أورده في صحيحه] وقال : لم يرفعه إسرائيل ومحمد بن جحادة عن أبي حصين وقال تعسا . كأنه يقول فأتعسهم الله . طوبى فعلى من كل شيء طيب ، وهي ياء حولت إلى الواو وهي من يطيب","takhrij":"من أفراد البخاري على مسلم","bab":"فتن › فتنة المال","dorar":"YUj7yoAl","merged":4,"otherRefs":["هداية الرواة 5/11 (صحيح)","سير أعلام النبلاء 8/301 (حسن)","صحيح البخاري 2886 (صحيح)"]},{"id":"س-07317","fp":"3151dd553c41","stateId":452,"easy":"إذا بعت آخرتك بدنيا غيرك ← تكون أشد الناس ندامة يوم القيامة","cause":"رجلٌ باع آخِرَتَه بدنيا غيرِه","result":"إنَّ أَشَدَّ الناسِ نَدامةً يومَ القيامةِ","explicit":true,"star":true,"otherNeedIds":[26,12],"ref":"الجامع الصغير 2195","srcLabel":"البخاري","text":[["إنَّ أَشَدَّ الناسِ نَدامةً يومَ القيامةِ",2]," ",["رجلٌ باع آخِرَتَه بدنيا غيرِه",1]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (3966)، والبخاري في ((التاريخ الكبير)) (6/ 128)، والطبراني (8/ 122) (7559) واللفظ لهم.","bab":"فتن › فتنة المال","dorar":"xbqctrn2","merged":2,"otherRefs":["إتحاف الخيرة المهرة 7/454 (حسن)"]},{"id":"س-07143","fp":"14f7ebea094b","stateId":452,"easy":"إذا تنعمت ولم تعبد الله ← فقد عُجّلت لك طيباتك","cause":"وهم لا يعبُدونَه","result":"أولئكَ قومٌ عُجِّلتْ لهم طيِّباتُهم في الحياةِ الدُّنيا","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"star":true,"similar":["س-01392"],"ref":"تخريج صحيح ابن حبان 4268","srcLabel":"متفق عليه","text":["عن ابن عباس قال: لم أزَلْ حريصًا أنْ أسأَلَ عمرَ بنَ الخطَّابِ عن المرأتينِ اللَّتينِ مِن أزواجِ النَّبيِّ صلَّى اللهُ عليه وسلَّم قال اللهُ: {إِنْ تَتُوبَا إِلَى اللَّهِ فَقَدْ صَغَتْ قُلُوبُكُمَا} [التحريم: 4] حتَّى حجَّ عمرُ فحجَجْتُ معه فلمَّا كان في بعضِ الطَّريقِ عدَل ليتوضَّأَ وعدَلْتُ معه بالإداوةِ فتبرَّز ثمَّ أتاني فسكَبْتُ على يديه فتوضَّأ فقُلْتُ: يا أميرَ المؤمنينَ مَن المرأتانِ مِن أزواجِ النَّبيِّ صلَّى اللهُ عليه وسلَّم اللَّتانِ قال اللهُ: {إِنْ تَتُوبَا إِلَى اللَّهِ فَقَدْ صَغَتْ قُلُوبُكُمَا} [التحريم: 4] ؟ فقال عمرُ: واعجبًا لك يا ابنَ عبَّاسٍ ثمَّ قال: هي عائشةُ وحفصةُ ثمَّ أنشَأ يسوقُ الحديثَ \nفقال: كنَّا معشرَ قريشٍ قومًا نغلِبُ النِّساءَ فلمَّا قدِمْنا المدينةَ وجَدْناهم قومًا تغلِبُهم نساؤُهم فطفِق نساؤُنا يتعلَّمْنَ مِن نسائِهم وكان منزلي في بني أميَّةَ بنِ زيدٍ في العوالي قال: فتغضَّبْتُ يومًا على امرأتي فإذا هي تُراجِعُني فأنكَرْتُ أنْ تُراجِعَني فقالت: ما تُنكِرُ أنْ أُراجِعَك فواللهِ إنَّ أزواجَ النَّبيِّ صلَّى اللهُ عليه وسلَّم لتُراجِعْنَه، وتهجُرُه إحداهنَّ اليومَ إلى اللَّيلِ قال: فانطلَقْتُ فدخَلْتُ على حفصةَ فقُلْتُ: أتُراجِعينَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ؟ قالت: نَعم وتهجُرُه إحدانا اليومَ إلى اللَّيلِ قال: قد قُلْتُ: قد خاب مَن فعَل ذلك منكنَّ وخسِر، أفتأمَنُ إحداكنَّ أنْ يغضَبَ اللهُ عليها لغضبِ رسولِه صلَّى اللهُ عليه وسلَّم فإذا هي قد هلَكتْ لا تُراجِعي رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ولا تسأَليه شيئًا وسَليني ما بدا لكِ، ولا يغُرَّنَّكِ أنْ كانت جارتُك هي أوسمَ وأحبَّ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم منكِ ـ يُريدُ عائشةَ \nقال: وكان لي جارٌ مِن الأنصارِ وكنَّا نتناوَبُ النُّزولَ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فينزِلُ يومًا وأنزِلُ يومًا فيأتيني بخبرِ الوحيِ وغيرِه وأنزِلُ فآتيه بمثلِ ذلك، وكنَّا نتحدَّثُ أنَّ غسَّانَ تنعَلُ الخيلَ لتغزوَنا قال: فنزَل صاحبي يومًا، ثمَّ أتاني فضرَب على بابي ثمَّ ناداني فخرَجْتُ إليه فقال: حدَث أمرٌ عظيمٌ فقُلْتُ: ماذا أجاءتْ غسَّانُ ؟ قال: بل أعظمُ مِن ذلك وأطولُ، طلَّق رسولُ اللهِ نساءَه فقُلْتُ: خابت حفصةُ وخسِرت قد كُنْتُ أظُنَّ هذا كائنًا \nفلمَّا صلَّيْتُ الصُّبحَ شدَدْتُ علَيَّ ثيابي ثمَّ نزَلْتُ فدخَلْتُ على حفصةَ فإذا هي تبكي فقُلْتُ: أَطلَّقكنَّ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ؟ فقالت: لا أدري هو ذا هو مُعتزِلٌ في هذه المَشرُبةِ قال: فأتَيْتُ غلامًا له أسودَ فقُلْتُ: استأذِنْ لعُمرَ فدخَل الغلامُ ثمَّ خرَج إليَّ وقال: قد ذكَرْتُكَ له فلم يقُلْ شيئًا فانطلَقْتُ حتَّى أتَيْتُ المسجدَ فإذا قومٌ حولَ المنبرِ جلوسٌ يبكي بعضُهم إلى بعضٍ قال: فجلَسْتُ قليلًا ثمَّ غلَبني ما أجِدُ فأتَيْتُ الغلامَ فقُلْتُ: استأذِنْ لعمرَ فدخَل ثمَّ خرَج إليَّ فقال: قد ذكَرْتُكَ له فصمَت فرجَعْتُ فجلَسْتُ إلى المنبرِ ثمَّ غلَبني ما أجِدُ فأتَيْتُ الغلامَ فقُلْتُ: استأذِنْ لعمرَ فدخَل ثمَّ خرَج إليَّ فقال: قد ذكَرْتُك له فسكَت فولَّيْتُ مدبِرًا فإذا الغلامُ يدعوني ويقولُ: ادخُلْ فقد أذِن لكَ \nفدخَلْتُ فسلَّمْتُ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فإذا هو متَّكئٌ على رملِ حصيرٍ قد أثَّر بجَنبِه فقُلْتُ: أطلَّقْتَ يا رسولَ اللهِ نساءَك ؟ قال: فرفَع رأسَه إليَّ وقال: ( لا ) فقُلْتُ: اللهُ أكبرُ لو رأيتَنا يا رسولَ اللهِ وكنَّا معشرَ قريشٍ قومًا نغلِبُ النِّساءَ فلمَّا قدِمْنا المدينةَ وجَدْنا قومًا تغلِبُهم نساؤُهم فطفِق نساؤُنا يتعلَّمْنَ مِن نسائِهم فتغضَّبْتُ على امرأتي يومًا فإذا هي تُراجِعُني فأنكَرْتُ ذلك عليها فقالت: أتُنكِرُ أنْ أُراجِعَكَ ؟ فواللهِ إنَّ أزواجَ النَّبيِّ صلَّى اللهُ عليه وسلَّم لَيُراجِعْنُه، وتهجُرُه إحداهنَّ اليومَ إلى اللَّيلِ قال: فقُلْتُ: قد خاب مَن فعَل ذلك منهنَّ وخسِرت أتأمَنُ إحداهنَّ أنْ يغضَبَ اللهُ عليها لغضبِ رسولِه صلَّى اللهُ عليه وسلَّم فإذا هي قد هلَكتْ ؟ ! قال: فتبسَّم رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فقُلْتُ: يا رسولَ اللهِ فدخَلْتُ على حفصةَ فقُلْتُ لها: لا تُراجِعي رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ولا تسأَليه شيئًا وسَليني ما بدا لكِ ولا يغُرَّنَّكِ أنْ كانت جارتُك هي أوسمَ وأحبَّ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم منكِ قال: فتبسَّم رسولُ اللهِ صلَّى اللهُ عليه وسلَّم أخرى فقُلْتُ: أستأنِسُ يا رسولَ اللهِ ؟ قال: ( نَعم ) فجلَسْتُ فرفَعْتُ رأسي في البيتِ فواللهِ ما رأَيْتُ فيه شيئًا يرُدُّ البصرَ إلَّا أُهُبًا ثلاثةً فقُلْتُ: يا رسولَ اللهِ ادعُ اللهَ أنْ يوسِّعَ على أمَّتِك فقد وسَّع اللهُ على فارسَ والرُّومِ ",["وهم لا يعبُدونَه",1]," قال: فاستوى جالسًا وقال: ( أفي شكٍّ أنتَ يا ابنَ الخطَّابِ ",["أولئكَ قومٌ عُجِّلتْ لهم طيِّباتُهم في الحياةِ الدُّنيا",2]," ) فقُلْتُ: استغفِرْ لي يا رسولَ اللهِ، وكان أقسَم لا يدخُلُ عليهنَّ شهرًا مِن شدَّةِ مَوْجِدتِه عليهنَّ حتَّى عاتَبه اللهُ \nقال الزُّهريُّ: فأخبَرني عروةُ عن عائشةَ قالت: فلمَّا مضى تسعٌ وعشرونَ دخَل عليَّ رسولُ صلَّى اللهُ عليه وسلَّم بدَأ بي فقُلْتُ: يا رسولَ اللهِ إنَّكَ أقسَمْتَ ألَّا تدخُلَ علينا شهرًا وإنَّك دخَلْتَ تسعًا وعشرينَ أعُدُّهنَّ فقال صلَّى اللهُ عليه وسلَّم: ( إنَّ الشَّهرَ تسعٌ وعشرونَ ) ثمَّ قال: ( يا عائشةُ إنِّي ذاكرٌ لكِ أمرًا فلا أُريدُ أنْ تعجَلي فيه حتَّى تستأمِري أبويكِ ) قالت: ثمَّ قرَأ عليَّ الآيةَ: {يَا أَيُّهَا النَّبِيُّ قُلْ لِأَزْوَاجِكَ إِنْ كُنْتُنَّ تُرِدْنَ الْحَيَاةَ الدُّنْيَا وَزِينَتَهَا فَتَعَالَيْنَ أُمَتِّعْكُنَّ وَأُسَرِّحْكُنَّ سَرَاحًا جَمِيلًا * وَإِنْ كُنْتُنَّ تُرِدْنَ اللَّهَ وَرَسُولَهُ وَالدَّارَ الْآخِرَةَ فَإِنَّ اللَّهَ أَعَدَّ لِلْمُحْسِنَاتِ مِنْكُنَّ أَجْرًا عَظِيمًا} [الأحزاب: 28، 29] قالت عائشةُ: قد علِم واللهِ أنَّ أبويَّ لم يكونا يأمُراني بفِراقِه فقُلْتُ: أفي هذا أستأمِرُ أبويَّ فإنِّي أُريدُ اللهَ ورسولَه والدَّارَ الآخرةَ"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5843)، ومسلم (1479) باختلاف يسير","bab":"علم › حسن السؤال ونصح العالم","dorar":"rmtuqsiF","merged":6,"otherRefs":["صحيح الترمذي 3318 (صحيح)","المستدرك على الصحيحين 7268 (صحيح)","تخريج مشكل الآثار 5016 (حسن)","تخريج المسند لشاكر 15/113 (صحيح)","الضعفاء الكبير 3/161 (صحيح)"]},{"id":"ق-0074","fp":"6f62d4e22cbf","stateId":452,"easy":"قصر الدعاء على طلب الدنيا ← لا نصيب في الآخرة","cause":"قصر الدعاء على طلب الدنيا","result":"لا نصيب في الآخرة","explicit":true,"star":true,"ref":"سورة البقرة: 200","srcLabel":"القرآن الكريم","quran":{"s":2,"from":200,"to":200,"text":"فَإِذَا قَضَيْتُمْ مَنَاسِكَكُمْ فَاذْكُرُوا اللَّهَ كَذِكْرِكُمْ آبَاءَكُمْ أَوْ أَشَدَّ ذِكْرًا فَمِنَ النَّاسِ مَنْ يَقُولُ رَبَّنَا آتِنَا فِي الدُّنْيَا وَمَا لَهُ فِي الْآخِرَةِ مِنْ خَلَاقٍ (200)","hl":[[98,196,1]]}},{"id":"ق-0706","fp":"923bfb3026d0","stateId":452,"easy":"البخل الشديد أو الإسراف ← اللوم والحسرة","cause":"البخل الشديد أو الإسراف","result":"اللوم والحسرة","explicit":true,"otherNeedIds":[3],"ref":"سورة الإسراء: 29","srcLabel":"القرآن الكريم","quran":{"s":17,"from":29,"to":29,"text":"وَلَا تَجْعَلْ يَدَكَ مَغْلُولَةً إِلَى عُنُقِكَ وَلَا تَبْسُطْهَا كُلَّ الْبَسْطِ فَتَقْعُدَ مَلُومًا مَحْسُورًا (29)","hl":[[0,113,1]]}},{"id":"ق-1149","fp":"10a05d3d8c21","stateId":452,"easy":"إرادة حرث الدنيا وحدها ← يؤتى منها ولا نصيب في الآخرة","cause":"إرادة حرث الدنيا وحدها","result":"يؤتى منها ولا نصيب في الآخرة","explicit":true,"ref":"سورة الشورى: 20","srcLabel":"القرآن الكريم","quran":{"s":42,"from":20,"to":20,"text":"مَنْ كَانَ يُرِيدُ حَرْثَ الْآخِرَةِ نَزِدْ لَهُ فِي حَرْثِهِ وَمَنْ كَانَ يُرِيدُ حَرْثَ الدُّنْيَا نُؤْتِهِ مِنْهَا وَمَا لَهُ فِي الْآخِرَةِ مِنْ نَصِيبٍ (20)","hl":[[62,156,1]]}},{"id":"ق-1227","fp":"7da2b4982fa5","stateId":452,"easy":"البخل ← يبخل عن نفسه","cause":"البخل","result":"يبخل عن نفسه","explicit":true,"otherNeedIds":[3],"ref":"سورة محمد: 38","srcLabel":"القرآن الكريم","quran":{"s":47,"from":38,"to":38,"text":"هَا أَنْتُمْ هَؤُلَاءِ تُدْعَوْنَ لِتُنْفِقُوا فِي سَبِيلِ اللَّهِ فَمِنْكُمْ مَنْ يَبْخَلُ وَمَنْ يَبْخَلْ فَإِنَّمَا يَبْخَلُ عَنْ نَفْسِهِ وَاللَّهُ الْغَنِيُّ وَأَنْتُمُ الْفُقَرَاءُ وَإِنْ تَتَوَلَّوْا يَسْتَبْدِلْ قَوْمًا غَيْرَكُمْ ثُمَّ لَا يَكُونُوا أَمْثَالَكُمْ (38)","hl":[[92,141,1]]}},{"id":"س-07702","fp":"9d657de0bb77","stateId":452,"easy":"إذا أمسكت عن النفقة في سبيل الله ← تلقي بيدك إلى التهلكة","cause":"فأَمْسَكوا عن النَّفَقةِ في سَبيلِ اللهِ","result":"وَلَا تُلْقُوا بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأحاديث المختارة 8 / 84","srcLabel":"متفق عليه","text":["عَنِ الضَّحَّاكِ بْنِ أَبِي جُبَيْرَةَ قَالَ «كانَتِ الأنْصارُ يَتَصَدَّقونَ ويُنْفِقونَ مِن أمْوالِهم فأصابَتْهم سَنَةٌ ",["فأَمْسَكوا عن النَّفَقةِ في سَبيلِ اللهِ",1],"؛ فنَزَلَتْ: {",["وَلَا تُلْقُوا بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ",2],"}»."],"grade":"صحيح","narrator":"الضحاك بن أبي جبيرة","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"قرآن › أسباب النزول","dorar":"scXixXQK"},{"id":"س-05563","fp":"d9e62846e0dd","stateId":452,"easy":"إذا تنافستم في الدنيا ← تهلككم كما أهلكت من قبلكم","cause":"فَتَنَافَسُوهَا كما تَنَافَسُوهَا","result":"ما الفَقْرَ أخْشَى علَيْكُم، ولَكِنْ","explicit":true,"ref":"ما تمس إليه الحاجة 190","srcLabel":"السنة","text":["حديثُ عَمرِو بنِ عَوفٍ حَليفِ بَني عامِرِ بنِ لُؤيٍّ، وكان شهِدَ بَدرًا مع رسولِ اللهِ: أنَّه عليه السَّلامُ بعَثَ أبا عُبَيدةَ بنَ الجرَّاحِ إلى البَحرينِ، فقدِمَ به، فقال عليه السَّلامُ للأنصارِ: (أبْشِرُوا وأمِّلُوا ما يَسرُّكم؛ فواللهِ ما الفَقرَ أخشَى عليكم [يعني حديث: أنَّ رَسولَ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ بَعَثَ أبَا عُبَيْدَةَ بنَ الجَرَّاحِ إلى البَحْرَيْنِ يَأْتي بجِزْيَتِهَا، وكانَ رَسولُ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ هو صَالَحَ أهْلَ البَحْرَيْنِ، وأَمَّرَ عليهمُ العَلَاءَ بنَ الحَضْرَمِيِّ، فَقَدِمَ أبو عُبَيْدَةَ بمَالٍ مِنَ البَحْرَيْنِ، فَسَمِعَتِ الأنْصَارُ بقُدُومِهِ، فَوَافَتْهُ صَلَاةَ الصُّبْحِ مع رَسولِ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ، فَلَمَّا انْصَرَفَ تَعَرَّضُوا له، فَتَبَسَّمَ رَسولُ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ حِينَ رَآهُمْ، وقَالَ: أظُنُّكُمْ سَمِعْتُمْ بقُدُومِ أبِي عُبَيْدَةَ، وأنَّهُ جَاءَ بشيءٍ قالوا: أجَلْ يا رَسولَ اللَّهِ، قَالَ: فأبْشِرُوا وأَمِّلُوا ما يَسُرُّكُمْ، فَوَاللَّهِ ",["ما الفَقْرَ أخْشَى علَيْكُم، ولَكِنْ",2]," أخْشَى علَيْكُم أنْ تُبْسَطَ عَلَيْكُمُ الدُّنْيَا، كما بُسِطَتْ علَى مَن كانَ قَبْلَكُمْ، ",["فَتَنَافَسُوهَا كما تَنَافَسُوهَا",1],"، وتُلْهيكُمْ كما ألْهَتْهُمْ .]"],"grade":"صحيح","narrator":"عمرو بن عوف","muhaddith":"صحيح","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"QpV9K0G7","merged":3,"otherRefs":["مجمع الزوائد 3/124 (صحيح)","تخريج صحيح ابن حبان 3199 (صحيح)"]},{"id":"س-05499","fp":"f38d8e565c38","stateId":452,"easy":"إذا طلبت الدنيا بعمل الآخرة ← لم يكن لك في الآخرة نصيب","cause":"فمَن طلَبَ الدُّنيا بعَملِ الآخرةِ","result":"لم يكُنْ له في الآخرةِ مِن نَصيبٍ","explicit":true,"otherNeedIds":[45],"ref":"المستدرك على الصحيحين 8108","srcLabel":"السنة","text":["بَشِّرْ أُمَّتي بالسَّناءِ والرِّفْعةِ والتَّمكينِ في البلادِ، ما لم يَطْلُبوا الدُّنْيا بعَملِ الآخرةِ، ",["فمَن طلَبَ الدُّنيا بعَملِ الآخرةِ",1]," ",["لم يكُنْ له في الآخرةِ مِن نَصيبٍ",2],"."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"صحيح الإسناد","bab":"رقائق وزهد › الرياء والسمعة","dorar":"5jJ5y4Lt","merged":2,"otherRefs":["الأحاديث المختارة 1154 (صحيح)"]},{"id":"س-05564","fp":"ace112e7589c","stateId":452,"easy":"إذا أردت الدنيا ← أضررت بالآخرة","cause":"مَن أراد الدُّنيا","result":"أضَرَّ بالآخرةِ","explicit":true,"ref":"المستدرك على الصحيحين 8711","srcLabel":"الطبراني","text":["عن عبدِ اللهِ بنِ مَسعودٍ رَضيَ اللهُ عنه، أنَّه قال: إنَّكم في زمانٍ كَثيرٌ عُلماؤه قَليلٌ خُطباؤه، كَثيرٌ مُعْطُوه، الصَّلاةُ فيها قَصيرةٌ، والخُطبةُ فيها طَويلةٌ، فأقْصِروا الخُطبةَ وأطِيلوا الصَّلاةَ، وإنَّ مِنَ البيانِ لَسِحْرًا، ومَن أراد الآخرةَ أضرَّ بالدُّنيا، و",["مَن أراد الدُّنيا",1]," ",["أضَرَّ بالآخرةِ",2],"، يا قومِ، فأَضِرُّوا بالفانيةِ للباقيةِ."],"grade":"صحيح","narrator":"هزيل بن شرحبيل","muhaddith":"صحيح على شرط الشيخين، ولم يخرجاه","takhrij":"أخرجه الطبراني (9/ 108) (8566) باختلاف يسير، ووكيع في ((الزهد)) (70)، وابن أبي شيبة (34519) كلاهما مختصرا.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"d1GZHjX0","merged":2,"otherRefs":["تخريج المسند لشعيب 32/471 (حسن)"]},{"id":"س-05576","fp":"383fefdbe0ea","stateId":452,"easy":"إذا أعطاك الله ما تحب وأنت مقيم على معاصيه ← فإنما هو استدراج","cause":"ما يُحبُّ ، و هو مقيمٌ على معاصِيه","result":"فإنَّما ذلك منه استدراجٌ","explicit":true,"otherNeedIds":[12],"ref":"صحيح الجامع 561","srcLabel":"الروياني","text":["إذا رأيتَ اللهَ تعالى يُعطي العبدَ من الدنيا ",["ما يُحبُّ ، و هو مقيمٌ على معاصِيه",1]," ؛ ",["فإنَّما ذلك منه استدراجٌ",2]],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه الروياني (261)، والخرائطي في ((فضيلة الشكر)) (70)، وابن قانع في ((معجم الصحابة)) (2/ 272) باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"nfeLijzu","merged":2,"otherRefs":["تخريج المسند لشعيب 17311 (حسن)"]},{"id":"س-05607","fp":"78fa36ccd426","stateId":452,"easy":"إذا تلذذت بحلاوة الدنيا ← فهي مرارة الآخرة","cause":"حُلوةُ الدُّنيا","result":"مُرَّةُ الآخِرةِ","explicit":true,"ref":"المستدرك على الصحيحين 8073","srcLabel":"أحمد","text":["عن شُرَيحِ بنِ عُبَيدٍ: أنَّ أبا مالِكٍ الأشعَريَّ لمَّا حَضَرَتْه الوَفاةُ قالَ: يا مَعشَرَ الأشعَرِيِّين، ليُبَلِّغِ الشَّاهِدُ مِنكُم الغائبَ، إنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["حُلوةُ الدُّنيا",1]," ",["مُرَّةُ الآخِرةِ",2],"، ومُرَّةُ الدُّنيا حُلوةُ الآخِرةِ."],"grade":"صحيح","narrator":"أبو مالك الأشعري","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (22899)، والطبراني (3/ 291)، (3438) كلاهما بلفظه، وابن أبي عاصم في ((الزهد)) (7861) مختصرا.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"yzJduXgE","merged":2,"otherRefs":["السلسلة الصحيحة 1817 (صحيح)"]},{"id":"س-01246","fp":"fc316f924611","stateId":452,"easy":"إذا أكثرت المال ولم تنفقه يميناً وشمالاً ← هلكت","cause":"الْمُكْثِرونَ إِلا من قَال: كَذا وَكَذا، وهَكَذا وَهَكَذا","result":"هَلَكَ","explicit":true,"ref":"تخريج المسند لشاكر 15/220","srcLabel":"النسائي","text":["كنتُ أَمشي مع رسولِ اللهِ صلى اللهُ علَيهِ وسلمَ في حَقٍّ لِبَعْضِ أَهلِ المدينَةِ، فَقَال: يا أَبا هريرَةَ، ",["هَلَكَ",2]," ",["الْمُكْثِرونَ إِلا من قَال: كَذا وَكَذا، وهَكَذا وَهَكَذا",1],"، وَقَليلٌ ما هُمْ ، ثُمَّ مَشَى ساعَةً، ثُمَّ قَال: يا أَبا هُرَيْرَةَ، أَلا أَدُلُّكَ عَلَى كَنْزٍ من كُنوزِ الْجَنَّةِ ، فَقُلْتُ: بَلى يا رَسولَ اللهِ، قَال: تَقولُ: لا حَوْلَ وَلا قوَّةَ إِلا بِاللهِ الْعَلِيِّ الْعَظيمِ، وَلا مَلْجَأَ من اللهِ إِلا إِلَيهِ ، قَال: ثُمَّ مَشَى ساعَةً فَقَال: يا أَبا هُرَيْرَةَ، هَل تَدْري ما حَقُّ اللهِ عَلى النَّاسِ، وَما حَقُّ النَّاسِ عَلى اللهِ؟ ، قَال: قُلْتُ: اللهُ وَرَسولُهُ أَعلَمُ قَال: حَقُّ اللهِ عَلى النَّاسِ أَنْ يَعْبُدوهُ وَلا يُشْرِكوا بِهِ شَيئًا، فَإِذا فَعَلوا ذَلِكَ فَحَقٌّ عَلى اللهِ أَن لا يُعَذِّبَهُمْ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10190) مختصراً، وابن ماجه (4131) بنحوه مختصراً، وأحمد (8085) واللفظ له","bab":"أدعية وأذكار › فضل لا حول ولا قوة إلا بالله","dorar":"rSAMuBbl"},{"id":"س-05158","fp":"9e4a60aac06c","stateId":452,"easy":"إذا وليت أمر الناس ← توشك أن تتمنى أنك خررت من الثريا","cause":"يَلِ مِن أمرِ النَّاسِ شيئًا","result":"لَيُوشِكُ رَجُلٌ أنْ يتمَنَّى أنَّه خَرَّ مِن الثُّرَيَّا","explicit":true,"otherNeedIds":[57],"ref":"المستدرك على الصحيحين 7210","srcLabel":"أحمد","text":["عن يَزِيدَ بْنِ شَرِيكٍ، أنَّ الضَّحَّاكَ بنَ قَيْسٍ بعَثَ معه بكُسْوةٍ إلى مَرْوانَ بنِ الحَكَمِ، فقال مَرْوانُ للبَوَّابِ: انظُرْ مَن بالبابِ؟ قالَ: أبو هُرَيرةَ، فأذِنَ له، فقالَ: يا أبا هُرَيرةَ، حَدِّثْنا شيئًا سَمِعْتَه مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، قالَ: سَمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["لَيُوشِكُ رَجُلٌ أنْ يتمَنَّى أنَّه خَرَّ مِن الثُّرَيَّا",2]," ولَمْ ",["يَلِ مِن أمرِ النَّاسِ شيئًا",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (10927)، والبزار (9629) باختلاف يسير، وابن حبان (4483) بنحوه دون ذكر قصته","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"4IjtsCwZ"},{"id":"س-05615","fp":"c1793e74dbbe","stateId":452,"easy":"إذا أحببت دنياك ← أضررت بآخرتك","cause":"مَنْ أحبَّ دُنْياهُ","result":"أَضَرَّ بِآخِرَتِه","explicit":true,"ref":"صحيح الترغيب 3247","srcLabel":"أحمد","text":[["مَنْ أحبَّ دُنْياهُ ؛ ",1],["أَضَرَّ بِآخِرَتِه ، ",2],"ومَنْ أحبَّ آخِرَتَهُ ؛ أَضَرَّ بِدُنْياهُ ، فَآثِرُوا ما يَبْقَى على ما يَفْنَى ."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (19697)، وابن أبي الدنيا في ((الزهد)) (8)، وابن حبان (709)","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"K1t4MJaf"},{"id":"س-05913","fp":"94e6488f584d","stateId":452,"easy":"إذا صدّتك الدنيا عن آخرتك وقصّرت بك عن رضا ربك ← فبئست الدار","cause":"لِمَن صَدَّتْه عنْ آخِرَتِه، وقَصَّرَت به عنْ رِضاءِ رَبِّه","result":"وبِئسَتِ الدَّارُ","explicit":true,"ref":"المستدرك على الصحيحين 8083","srcLabel":"العقيلي","text":["نِعمَتِ الدَّارُ الدُّنيا لِمَن تَزَوَّد منها لآخِرَتِه؛ حتَّى يُرضِيَ رَبَّه عزَّ وجلَّ، ",["وبِئسَتِ الدَّارُ",2]," ",["لِمَن صَدَّتْه عنْ آخِرَتِه، وقَصَّرَت به عنْ رِضاءِ رَبِّه",1],"، وإذا قال العَبدُ: قَبَّح اللهُ الدُّنيا! قالتِ الدُّنيا: قَبَّح اللهُ أعْصانا لرَبِّه!"],"grade":"صحيح","narrator":"طارق","muhaddith":"صحيح الإسناد","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (3/ 89)، والرامهرمزي في ((أمثال الحديث)) (ص59) باختلاف يسير.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"gS2YhOY9"},{"id":"س-05928","fp":"de232a3bb155","stateId":452,"easy":"إذا لزمت أبواب السلطان ← فقد أصبح صعباً هبوطاً","cause":"وأبوابَ السلطانِ","result":"فإِنَّه قَدْ أصبحَ صعبًا هُبُوطًا","explicit":true,"ref":"صحيح الجامع 2672","srcLabel":"البيهقي","text":["إيَّاكم ",["وأبوابَ السلطانِ",1]," ؛ ",["فإِنَّه قَدْ أصبحَ صعبًا هُبُوطًا",2]],"grade":"صحيح","narrator":"رجل من بني سليم","muhaddith":"صحيح","takhrij":"أخرجه البيهقي (8959)، وأبو نعيم في ((معرفة الصحابة)) (5072)، وابن عساكر في ((تاريخ دمشق)) (9970) جميعا بلفظه.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"4qFf8Ql5"},{"id":"س-06183","fp":"28dd0819eb3a","stateId":452,"easy":"إذا كنت جابياً أو تاجراً إلا في الخير ← تكون من المسبوقين في العمل","cause":"لا تكن جابيًا ولا تاجرًا إلا تاجرَ خيرٍ","result":"فإنَّ أولئك المسبوقون في العملِ","explicit":true,"ref":"مسند علي 45","srcLabel":"أحمد","text":["أمرني رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ أن لا أَدَعَ قبرًا شاخصًا بالمدينةِ إلا سويتُهُ ولا تمثالًا إلا لطَّختُهُ ففعلتُ ثم أتيتُهُ فقال فعلتَ قلتُ نعم قال يا عليُّ ",["لا تكن جابيًا ولا تاجرًا إلا تاجرَ خيرٍ",1]," ",["فإنَّ أولئك المسبوقون في العملِ",2]],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (657)، وأبو يعلى (506)، والطبراني في ((المعجم الأوسط)) (3412) واللفظ لهم.","bab":"زكاة › ما جاء في ذم العشور والمكوس","dorar":"JFS0PrK6"},{"id":"س-07265","fp":"3b22c6cbc9ca","stateId":452,"easy":"إذا أخذت الإمارة بغير حقها ← تكون عليك حسرة يوم القيامة","cause":"لمن أخذها بغيرِ حقِّها","result":"تكون عليه حسرةً يومَ القيامةِ","explicit":true,"ref":"مجمع الزوائد 5/203","srcLabel":"ابن حبان","text":["أنه قال عند النبيِّ صلَّى اللهُ عليه وسلَّمَ بئس الشيءُ الإمارةُ فقال النبيُّ صلَّى اللهُ عليه وسلَّمَ نعمَ الشيءِ الإمارةُ لمن أخذها بحقِّها وبئس الشيءُ الإمارةُ ",["لمن أخذها بغيرِ حقِّها",1]," ",["تكون عليه حسرةً يومَ القيامةِ",2]],"grade":"صحيح","narrator":"زيد بن ثابت","muhaddith":"[فيه] حفص بن عمر بن الصباح الرقي وثقه ابن حبان ، وبقية رجاله رجال الصحيح","takhrij":"أخرجه الطبراني (4831) (5/ 127) واللفظ له.","bab":"فتن › أمراء الجور","dorar":"ceMOHYQV"},{"id":"س-04196","fp":"3b4173876d07","stateId":452,"easy":"إذا حلفت كاذباً لتبيع ← بعت آخرتك بدنياك","cause":"قال: لا واللهِ ثمَّ باعنيها","result":"باع آخرتَه بدنياه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[12],"ref":"صحيح ابن حبان 4909","srcLabel":"ابن أبي الدنيا","text":["مرَّ أعرابيٌّ بشاةٍ فقُلْتُ: تبيعُنيها بثلاثةِ دراهمَ ؟ ",["قال: لا واللهِ ثمَّ باعنيها",1]," فذكَرْتُ ذلك لرسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقال: ( ",["باع آخرتَه بدنياه",2]," )"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن أبي الدنيا في ((الورع)) (162) بنحوه","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"iC78TvId","merged":3,"otherRefs":["الترغيب والترهيب 3/41 (صحيح)","السلسلة الصحيحة 364 (حسن)"]},{"id":"س-07337","fp":"265312964651","stateId":452,"easy":"إذا كان لك مئات الإبل ولم تؤد حقها ← فالويل لك","cause":"لأصحابِ المِئينَ، إلَّا مَن أَعْطَى في رِسْلِها ونجْدَتِها، وأفقَرَ ظهْرَها، وأطْرَقَ فَحْلَها، ونحَرَ سَمِينَها، وأطْعَمَ القانِعَ والمُعْتَرَّ","result":"وويلٌ لأصحابِ المِئينَ","explicit":true,"otherNeedIds":[57,46],"ref":"تهذيب الكمال 15/324","srcLabel":"الطبراني","text":["أتَيْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فلمَّا دَنَوْتُ منه سمِعْتُه يقول: هذا سيِّدُ أهْلِ الوبَرِ، فسلَّمْتُ وجلَسْتُ، فقلْتُ: يا رسولَ اللهِ، المالُ الَّذي لا يكونُ عليَّ فيه تَبِعَةٌ مِن ضعيفٍ ضافَنِي، أو عيالٍ إنْ كثُرُوا؟ قال: نِعْمَ المالُ أربعونُ مِن الإبلِ، والكثيرُ سِتُّونَ، ",["وويلٌ لأصحابِ المِئينَ",2],["، إلَّا مَن أَعْطَى في رِسْلِها ونجْدَتِها، وأفقَرَ ظهْرَها، وأطْرَقَ فَحْلَها، ونحَرَ سَمِينَها، وأطْعَمَ القانِعَ والمُعْتَرَّ",1],". قلت: يا رسولَ اللهِ، ما أكْرَمَ هذه الأخلاقَ وأحسَنَها، إنَّه لا يُحَلُّ بالوادي الَّذي أنا فيه مِن كثْرَةِ إبِلِي؟ قال: فكيف تصنَعُ بالمَنِيحَةِ؟ قلْتُ: إنِّي لأمْنَحُ في كلِّ عامٍ مِئَةً. قال: فكيف تصنَعُ بالعاريةِ؟ قلْتُ: تغْدُو الإبلُ ويغْدُو النَّاسُ، فمَن أخَذَ برأْسِ بعيرٍ ذهَبَ به. قال: فكيف تصنَعُ بالأفقارِ؟ قال: إنِّي أُفْقِرُ البِكْرَ الضَّرْعَ والنَّابَ المُدبرَ. قال: مالُك أحبُّ إليك أم مالُ مَوْلاك؟ قلْتُ: بلْ مالِي. قال: فإنَّما لك مِن مالِكَ ما أكَلْتَ فأفْنَيْتَ، أو لَبِسَت فأبْلَيْتَ، أو أعطَيْتَ فأمضَيْتَ، وما بَقِيَ فلِمولاكَ. قلْتُ: لِمَولايَ؟ قال: نعم. قلْتُ: واللهِ لئن بَقِيتُ لأدَعَنَّ عِدَّتَها قليلةً. قال الحسَنُ: ففعَلَ رحِمَه اللهُ. فلمَّا حضَرَتْه الوفاةُ دعا بَنِيه، فقال: يا بَنِيَّ، خُذُوا عنِّي؛ فلا أجِدُ أنصَحَ لكم مِنِّي، إذا أنا مِتُّ فسَوِّدُوا أكابرَكم، ولا تُسَوِّدُوا أصاغِرَكم، فَيَسْتَسْفِهَ النَّاسُ كِبارَكم، وتَهُونوا عليهم. وعليكم باستصلاحِ المالِ؛ فإنَّه مَنْبَهَةٌ للكريمِ، ويُسْتَغْنَى به عنِ اللَّئيمِ. وإيَّاكم والمسألةَ؛ فإنَّها آخِرُ كسْبِ المرْءِ، وإنَّ أحَدًا لم يسأَلْ إلَّا ترَكَ كسْبَه. فإذا أنا مِتُّ فكَفِّنوني في ثِيابي الَّتي كنْتُ أُصَلِّي فيها وأصومُ. وإيَّاكم والنِّياحةَ عليَّ؛ فإنِّي سمِعْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ ينهى عنها. وادْفِنوني في مكانٍ لا يعلَمُ به أحدٌ؛ فإنَّه قد كانت بيننا وبين بكْرِ بنِ وائلٍ خُماشاتٌ في الجاهليَّةِ، وأخافُ أنْ يُدْخِلوها عليكم في الإسلامِ، فيَعيثُوا عليكم دينَكم."],"grade":"حسن","narrator":"قيس بن عاصم","muhaddith":"حسن","takhrij":"أخرجه الطبراني (18/339) (870) باختلاف يسير.","bab":"فتن › فتنة المال","dorar":"k4pllV8f","merged":2,"otherRefs":["صحيح الأدب المفرد 730 (حسن)"]},{"id":"س-01392","fp":"7c879ea747be","stateId":452,"easy":"إذا تنعمت في الدنيا وأنت لا تعبد الله ← فقد عُجّلت لك طيباتك","cause":"وهُمْ لا يَعْبُدُونَ اللَّهَ","result":"إنَّ أُولَئِكَ قَوْمٌ عُجِّلُوا طَيِّبَاتِهِمْ في الحَيَاةِ الدُّنْيَا","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"repOf":"س-07143","ref":"أطراف الغرائب 1/56","text":["حديث: قُلتُ لعُمَرَ: ألَا تُخبِرُني عن المُتظاهِرَينِ [يعني حديث: عَنْ عبدِ اللَّهِ بنِ عَبَّاسٍ رَضِيَ اللَّهُ عنْهمَا، قالَ: لَمْ أزَلْ حَرِيصًا علَى أنْ أسْأَلَ عُمَرَ بنَ الخَطَّابِ، عَنِ المَرْأَتَيْنِ مِن أزْوَاجِ النبيِّ صَلَّى اللهُ عليه وسلَّمَ، اللَّتَيْنِ قالَ اللَّهُ تَعَالَى: {إنْ تَتُوبَا إلى اللَّهِ فقَدْ صَغَتْ قُلُوبُكُمَا} [التحريم: 4] حتَّى حَجَّ وحَجَجْتُ معهُ، وعَدَلَ وعَدَلْتُ معهُ بإدَاوَةٍ فَتَبَرَّزَ، ثُمَّ جَاءَ فَسَكَبْتُ علَى يَدَيْهِ منها فَتَوَضَّأَ، فَقُلتُ له: يا أمِيرَ المُؤْمِنِينَ مَنِ المَرْأَتَانِ مِن أزْوَاجِ النبيِّ صَلَّى اللهُ عليه وسلَّمَ، اللَّتَانِ قالَ اللَّهُ تَعَالَى: {إنْ تَتُوبَا إلى اللَّهِ فقَدْ صَغَتْ قُلُوبُكُمَا} [التحريم: 4]؟ قالَ: واعَجَبًا لكَ يا ابْنَ عَبَّاسٍ، هُما عَائِشَةُ وحَفْصَةُ، ثُمَّ اسْتَقْبَلَ عُمَرُ الحَدِيثَ يَسُوقُهُ قالَ: كُنْتُ أنَا وجَارٌ لي مِنَ الأنْصَارِ في بَنِي أُمَيَّةَ بنِ زَيْدٍ، وهُمْ مِن عَوَالِي المَدِينَةِ، وكُنَّا نَتَنَاوَبُ النُّزُولَ علَى النبيِّ صَلَّى اللهُ عليه وسلَّمَ، فَيَنْزِلُ يَوْمًا وأَنْزِلُ يَوْمًا، فَإِذَا نَزَلْتُ جِئْتُهُ بما حَدَثَ مِن خَبَرِ ذلكَ اليَومِ مِنَ الوَحْيِ أوْ غيرِهِ، وإذَا نَزَلَ فَعَلَ مِثْلَ ذلكَ، وكُنَّا مَعْشَرَ قُرَيْشٍ نَغْلِبُ النِّسَاءَ، فَلَمَّا قَدِمْنَا علَى الأنْصَارِ إذَا قَوْمٌ تَغْلِبُهُمْ نِسَاؤُهُمْ، فَطَفِقَ نِسَاؤُنَا يَأْخُذْنَ مِن أدَبِ نِسَاءِ الأنْصَارِ، فَصَخِبْتُ علَى امْرَأَتي فَرَاجَعَتْنِي، فأنْكَرْتُ أنْ تُرَاجِعَنِي، قالَتْ: ولِمَ تُنْكِرُ أنْ أُرَاجِعَكَ؟ فَوَاللَّهِ إنَّ أزْوَاجَ النبيِّ صَلَّى اللهُ عليه وسلَّمَ لَيُرَاجِعْنَهُ، وإنَّ إحْدَاهُنَّ لَتَهْجُرُهُ اليومَ حتَّى اللَّيْلِ، فأفْزَعَنِي ذلكَ وقُلتُ لَهَا: قدْ خَابَ مَن فَعَلَ ذَلِكِ منهنَّ، ثُمَّ جَمَعْتُ عَلَيَّ ثِيَابِي، فَنَزَلْتُ فَدَخَلْتُ علَى حَفْصَةَ فَقُلتُ لَهَا: أيْ حَفْصَةُ، أتُغَاضِبُ إحْدَاكُنَّ النبيَّ صَلَّى اللهُ عليه وسلَّمَ اليومَ حتَّى اللَّيْلِ؟ قالَتْ: نَعَمْ، فَقُلتُ: قدْ خِبْتِ وخَسِرْتِ، أفَتَأْمَنِينَ أنْ يَغْضَبَ اللَّهُ لِغَضَبِ رَسولِهِ صَلَّى اللهُ عليه وسلَّمَ فَتَهْلِكِي؟ لا تَسْتَكْثِرِي النبيَّ صَلَّى اللهُ عليه وسلَّمَ ولَا تُرَاجِعِيهِ في شيءٍ ولَا تَهْجُرِيهِ، وسَلِينِي ما بَدَا لَكِ، ولَا يَغُرَّنَّكِ أنْ كَانَتْ جَارَتُكِ أوْضَأَ مِنْكِ وأَحَبَّ إلى النبيِّ صَلَّى اللهُ عليه وسلَّمَ - يُرِيدُ عَائِشَةَ - قالَ عُمَرُ: وكُنَّا قدْ تَحَدَّثْنَا أنَّ غَسَّانَ تُنْعِلُ الخَيْلَ لِغَزْوِنَا، فَنَزَلَ صَاحِبِي الأنْصَارِيُّ يَومَ نَوْبَتِهِ، فَرَجَعَ إلَيْنَا عِشَاءً فَضَرَبَ بَابِي ضَرْبًا شَدِيدًا، وقالَ: أثَمَّ هُوَ؟ فَفَزِعْتُ فَخَرَجْتُ إلَيْهِ، فَقالَ: قدْ حَدَثَ اليومَ أمْرٌ عَظِيمٌ، قُلتُ: ما هُوَ، أجَاءَ غَسَّانُ؟ قالَ: لَا، بَلْ أعْظَمُ مِن ذلكَ وأَهْوَلُ، طَلَّقَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ نِسَاءَهُ، - وقالَ عُبَيْدُ بنُ حُنَيْنٍ: سَمِعَ ابْنَ عَبَّاسٍ عن عُمَرَ - فَقالَ: اعْتَزَلَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ أزْوَاجَهُ فَقُلتُ: خَابَتْ حَفْصَةُ وخَسِرَتْ، قدْ كُنْتُ أظُنُّ هذا يُوشِكُ أنْ يَكونَ، فَجَمَعْتُ عَلَيَّ ثِيَابِي، فَصَلَّيْتُ صَلَاةَ الفَجْرِ مع النبيِّ صَلَّى اللهُ عليه وسلَّمَ، فَدَخَلَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ مَشْرُبَةً له فَاعْتَزَلَ فِيهَا، ودَخَلْتُ علَى حَفْصَةَ فَإِذَا هي تَبْكِي، فَقُلتُ: ما يُبْكِيكِ ألَمْ أكُنْ حَذَّرْتُكِ هذا، أطَلَّقَكُنَّ النبيُّ صَلَّى اللهُ عليه وسلَّمَ؟ قالَتْ: لا أدْرِي، هَا هو ذَا مُعْتَزِلٌ في المَشْرُبَةِ، فَخَرَجْتُ فَجِئْتُ إلى المِنْبَرِ، فَإِذَا حَوْلَهُ رَهْطٌ يَبْكِي بَعْضُهُمْ، فَجَلَسْتُ معهُمْ قَلِيلًا، ثُمَّ غَلَبَنِي ما أجِدُ، فَجِئْتُ المَشْرُبَةَ الَّتي فِيهَا النبيُّ صَلَّى اللهُ عليه وسلَّمَ، فَقُلتُ لِغُلَامٍ له أسْوَدَ: اسْتَأْذِنْ لِعُمَرَ، فَدَخَلَ الغُلَامُ فَكَلَّمَ النبيَّ صَلَّى اللهُ عليه وسلَّمَ ثُمَّ رَجَعَ، فَقالَ: كَلَّمْتُ النبيَّ صَلَّى اللهُ عليه وسلَّمَ وذَكَرْتُكَ له فَصَمَتَ، فَانْصَرَفْتُ حتَّى جَلَسْتُ مع الرَّهْطِ الَّذِينَ عِنْدَ المِنْبَرِ، ثُمَّ غَلَبَنِي ما أجِدُ فَجِئْتُ فَقُلتُ لِلْغُلَامِ: اسْتَأْذِنْ لِعُمَرَ، فَدَخَلَ ثُمَّ رَجَعَ، فَقالَ: قدْ ذَكَرْتُكَ له فَصَمَتَ، فَرَجَعْتُ فَجَلَسْتُ مع الرَّهْطِ الَّذِينَ عِنْدَ المِنْبَرِ، ثُمَّ غَلَبَنِي ما أجِدُ، فَجِئْتُ الغُلَامَ فَقُلتُ: اسْتَأْذِنْ لِعُمَرَ، فَدَخَلَ ثُمَّ رَجَعَ إلَيَّ فَقالَ: قدْ ذَكَرْتُكَ له فَصَمَتَ، فَلَمَّا ولَّيْتُ مُنْصَرِفًا، قالَ: إذَا الغُلَامُ يَدْعُونِي، فَقالَ: قدْ أذِنَ لكَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ، فَدَخَلْتُ علَى رَسولِ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ فَإِذَا هو مُضْطَجِعٌ علَى رِمَالِ حَصِيرٍ، ليسَ بيْنَهُ وبيْنَهُ فِرَاشٌ، قدْ أثَّرَ الرِّمَالُ بجَنْبِهِ، مُتَّكِئًا علَى وِسَادَةٍ مِن أدَمٍ حَشْوُهَا لِيفٌ ، فَسَلَّمْتُ عليه، ثُمَّ قُلتُ وأَنَا قَائِمٌ: يا رَسولَ اللَّهِ، أطَلَّقْتَ نِسَاءَكَ؟ فَرَفَعَ إلَيَّ بَصَرَهُ فَقالَ: لا فَقُلتُ: اللَّهُ أكْبَرُ، ثُمَّ قُلتُ وأَنَا قَائِمٌ أسْتَأْنِسُ: يا رَسولَ اللَّهِ، لو رَأَيْتَنِي وكُنَّا مَعْشَرَ قُرَيْشٍ نَغْلِبُ النِّسَاءَ، فَلَمَّا قَدِمْنَا المَدِينَةَ إذَا قَوْمٌ تَغْلِبُهُمْ نِسَاؤُهُمْ، فَتَبَسَّمَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ، ثُمَّ قُلتُ: يا رَسولَ اللَّهِ لو رَأَيْتَنِي ودَخَلْتُ علَى حَفْصَةَ فَقُلتُ لَهَا: لا يَغُرَّنَّكِ أنْ كَانَتْ جَارَتُكِ أوْضَأَ مِنْكِ، وأَحَبَّ إلى النبيِّ صَلَّى اللهُ عليه وسلَّمَ - يُرِيدُ عَائِشَةَ - فَتَبَسَّمَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ تَبَسُّمَةً أُخْرَى، فَجَلَسْتُ حِينَ رَأَيْتُهُ تَبَسَّمَ، فَرَفَعْتُ بَصَرِي في بَيْتِهِ، فَوَاللَّهِ ما رَأَيْتُ في بَيْتِهِ شيئًا يَرُدُّ البَصَرَ، غيرَ أهَبَةٍ ثَلَاثَةٍ، فَقُلتُ: يا رَسولَ اللَّهِ ادْعُ اللَّهَ فَلْيُوَسِّعْ علَى أُمَّتِكَ، فإنَّ فَارِسَ والرُّومَ قدْ وُسِّعَ عليهم وأُعْطُوا الدُّنْيَا، ",["وهُمْ لا يَعْبُدُونَ اللَّهَ",1],"، فَجَلَسَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ وكانَ مُتَّكِئًا ، فَقالَ: أوفي هذا أنْتَ يا ابْنَ الخَطَّابِ، ",["إنَّ أُولَئِكَ قَوْمٌ عُجِّلُوا طَيِّبَاتِهِمْ في الحَيَاةِ الدُّنْيَا",2]," فَقُلتُ: يا رَسولَ اللَّهِ اسْتَغْفِرْ لِي، فَاعْتَزَلَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ نِسَاءَهُ مِن أجْلِ ذلكَ الحَديثِ حِينَ أفْشَتْهُ حَفْصَةُ إلى عَائِشَةَ تِسْعًا وعِشْرِينَ لَيْلَةً، وكانَ قالَ: ما أنَا بدَاخِلٍ عليهنَّ شَهْرًا مِن شِدَّةِ مَوْجِدَتِهِ عليهنَّ حِينَ عَاتَبَهُ اللَّهُ، فَلَمَّا مَضَتْ تِسْعٌ وعِشْرُونَ لَيْلَةً دَخَلَ علَى عَائِشَةَ فَبَدَأَ بهَا، فَقالَتْ له عَائِشَةُ: يا رَسولَ اللَّهِ، إنَّكَ كُنْتَ قدْ أقْسَمْتَ أنْ لا تَدْخُلَ عَلَيْنَا شَهْرًا، وإنَّما أصْبَحْتَ مِن تِسْعٍ وعِشْرِينَ لَيْلَةً أعُدُّهَا عَدًّا، فَقالَ: الشَّهْرُ تِسْعٌ وعِشْرُونَ لَيْلَةً فَكانَ ذلكَ الشَّهْرُ تِسْعًا وعِشْرِينَ لَيْلَةً، قالَتْ عَائِشَةُ: ثُمَّ أنْزَلَ اللَّهُ تَعَالَى آيَةَ التَّخَيُّرِ، فَبَدَأَ بي أوَّلَ امْرَأَةٍ مِن نِسَائِهِ فَاخْتَرْتُهُ، ثُمَّ خَيَّرَ نِسَاءَهُ كُلَّهُنَّ فَقُلْنَ مِثْلَ ما قالَتْ عَائِشَةُ.]"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"صحيح من حديث الزهري عن عبد الله عنه، وغريب من حديث أسيد بن أبي الأسود عن الزهري تفرد به عنه أخوه صالح","bab":"وضوء › المساعدة في الوضوء","dorar":"hRZAFsAG"},{"id":"س-04724","fp":"269221c32bf3","stateId":452,"easy":"إذا قلت قولاً لا تريد به وجه الله ← فلا خير فيه","cause":"قولٍ لا يرادُ به وجهُ اللهِ","result":"لا خيرَ في قولٍ","explicit":true,"otherNeedIds":[45],"ref":"تفسير القرآن العظيم 8/103","srcLabel":"أبو داود","text":["كان في خطبةِ أبي بكر الصدِّيقِ رضي اللهُ عنه : أما تعلمون أنكم تغدون وتروحون لأجلٍ معلومٍ ، فمن استطاع أن يقضيَ الأجلَ وهو في عملِ اللهِ عزَّ وجلَّ فليفعلْ ، ولن تنالوا ذلك إلا بالله عزَّ وجلَّ ، إنَّ قومًا جعلوا آجالَهم لغيرهم ، فنهاكم اللهُ أن تكونوا أمثالهم  وَلَا تَكُونُوا كَالَّذِينَ نَسُوا اللهَ فَأَنْسَاهُمْ أَنْفُسَهُمْ  أين مَن تعرفون من إخوانِكم ؟ قدِموا على ما قدِموا في أيامٍ سلَفِهم ، وخلَوْا بالشَّقوةِ والسعادةِ ، أين الجبارون الأولونَ الذين بنوا المدائنَ وحصَّنوها بالحوائطِ ؟ قد صاروا تحت الصَّخرِ والآبارِ ، هذا كتابُ اللهِ لا تَفْنى عجائبُه ، فاستَضيئوا منه ليوم الظُّلمةِ ، واستنصِحوا كتابَه وتبيانَه ، إنَّ اللهَ أثنى على زكريا وأهلَ بيتِه فقال  إِنَّهُمْ كَانُوا يُسَارِعُونَ فِي الْخَيْرَاتِ وَيَدْعُونَنَا رَغَبًا وَرَهَبًا وَكَانُوا لَنَا خَاشِعِينَ  ",["لا خيرَ في قولٍ",2],[" لا يرادُ به وجهُ اللهِ",1]," ولا خيرَ في مالٍ لا يُنفَقُ في سبيلِ اللهِ ، ولا خيرَ فيمن يغلِبُ جهلُه حِلمَه ، ولا خيرَ فيمن يخافُ في الله لومةَ لائمٍ"],"grade":"حسن","narrator":"نعيم بن نمحة","muhaddith":"إسناده جيد","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (1/ 60) (39)، واللفظ له، وأبو داود في ((الزهد)) (26)، وأبو نعيم في ((حلية الأولياء)) (1/ 36)، بلفظ مقارب.","bab":"رقائق وزهد › الإخلاص","dorar":"z8Xyc5hX"},{"id":"س-05590","fp":"e9bf063a877b","stateId":452,"easy":"إذا أطعت شهوة ساعة ← أورثتك حزناً طويلاً","cause":"شهوةِ ساعةٍ","result":"أورثَتْ حزنًا طويلًا","explicit":true,"otherNeedIds":[10],"ref":"شرح كتاب الشهاب 606","srcLabel":"البيهقي","text":["ألا رُبَّ نفسٍ طاعمةٍ ناعمةٍ في الدنيا جائعةٍ عاريةٍ يومَ القيامةِ ألا يا رُبَّ نفسٍ جائعةٍ عاريةٍ في الدنيا طاعمةٍ ناعمةٍ يومَ القيامةِ ألا رُبَّ مُكرمٍ لنفسهِ وهو لها مهينٌ ألا رُبَّ ",["شهوةِ ساعةٍ",1]," ",["أورثَتْ حزنًا طويلًا",2]],"grade":"حسن","narrator":"عفان بن بجير السلمي","muhaddith":"إسناده حسن","takhrij":"أخرجه البيهقي في ((الشعب)) (2/ 170)، وأبو نعيم في ((معرفة الصحابة)) (6/ 3056)ـ، وابن سعد في ((الطبقات)) (7/ 423). باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"3ScUTrpx"},{"id":"س-05628","fp":"eb9cd6610625","stateId":452,"easy":"إذا أخذت من الدنيا فوق ما يكفيك ← أخذت من حتفك وأنت لا تشعر","cause":"مَن أخَذَ مِنها فَوْقَ ما يَكْفيهِ","result":"أخَذَ من حتفِهِ وهو لا يَشْعُرُ","explicit":true,"otherNeedIds":[5],"ref":"كشف الخفاء 1/38","srcLabel":"الديلمي","text":["اتْرُكوا الدُّنيا لأهْلِها، فإنَّهُ ",["مَن أخَذَ مِنها فَوْقَ ما يَكْفيهِ",1]," ",["أخَذَ من حتفِهِ وهو لا يَشْعُرُ",2]],"grade":"حسن","narrator":"[أنس بن مالك]","muhaddith":"حسن لغيره","takhrij":"أخرجه الديلمي في ((الفردوس)) (363)","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"nkwlONoU"},{"id":"س-06020","fp":"646b776861f6","stateId":452,"easy":"إذا طلبت الدنيا ← تطلبك الآخرة حتى يدركك الموت","cause":"فمن طلب الدُّنيا","result":"طلبته الآخرةُ حتَّى يُدركَه الموتُ فيأخذَه","explicit":true,"ref":"الترغيب والترهيب 4/160","srcLabel":"الطبراني","text":["من أُشرِب حبَّ الدُّنيا الْتاط منها بثلاثٍ : شقاءٍ لا ينفَدُ عناه ، وحِرصٍ لا يبلغُ غناه ، وأملٍ لا يبلُغُ منتهاه فالدُّنيا طالبةٌ ومطلوبةٌ ، ",["فمن طلب الدُّنيا",1]," ",["طلبته الآخرةُ حتَّى يُدركَه الموتُ فيأخذَه",2]," ، ومن طلب الآخرةَ طلبته الدُّنيا حتَّى يستوفيَ منها رزقَه"],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني (10/201) (10328)، وأبو نعيم في ((حلية الأولياء)) (8/120)، والقضاعي في ((مسند الشهاب)) (541)","bab":"رقائق وزهد › ذم حب الدنيا","dorar":"TSdUq0FC"},{"id":"س-06400","fp":"52e4c18ca622","stateId":452,"easy":"إذا رددت المسكين ← لم تفلح","cause":"مَن رَدَّهم","result":"لولا أنَّ المَساكينَ يَكذِبونَ ما أفلَحَ","explicit":true,"ref":"الفروع لابن مفلح 4/ 325","srcLabel":"الطبراني","text":["\"",["لولا أنَّ المَساكينَ يَكذِبونَ ما أفلَحَ",2]," ",["مَن رَدَّهم",1],"\""],"grade":"حسن","narrator":"أبو أمامة","muhaddith":"إسناده جيد","takhrij":"أخرجه الطبراني (8/ 246)، (7967)، وابو الشيخ الأصبهاني في في ((جزء فيه أحاديثه)) (84) كلاهما بلفظه.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"g3x1ynL5"},{"id":"س-03073","fp":"74f23b386d10","stateId":452,"easy":"إذا حرصت على الإمارة ← تكون ندامة وحسرة عليك يوم القيامة","cause":"الإمارَةِ","result":"وإِنَّها ستكونُ ندامَةً وحسرَةً يومَ القيامَةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الجامع 2304","srcLabel":"البخاري","text":["إِنَّكم ستَحْرِصُونَ علَى ",["الإمارَةِ",1]," ، ",["وإِنَّها ستكونُ ندامَةً وحسرَةً يومَ القيامَةِ",2]," ، فنِعْمَ الْمُرِضَعَةُ ، وبئستِ الفاطِمَةُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (7148)، والنسائي (4211)، وأحمد (9791) واللفظ لهم.","bab":"إيمان › الوعيد","dorar":"YSwMypwZ","merged":3,"otherRefs":["صحيح النسائي 4222 (صحيح)","تخريج المسند لشعيب 10162 (صحيح)"]},{"id":"س-00601","fp":"15ee8e0b8753","stateId":452,"easy":"إذا تخلفت عن الحق واغتررت بالدنيا ← تصبح بين أسير وقتيل (مثَل)","cause":"وتخلَّفَ بقيَّتُهم","result":"فنَذِرَ بهم عدُوٌّ؛ فأصبَحوا بينَ أسيرٍ وقَتيلٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج الإحياء للعراقي 3/269","srcLabel":"ابن المبارك","text":["إنما مَثَلي ومَثَلُكم ومَثَلُ الدنيا كمَثَلِ قومٍ سلكوا مَفازةً غَبراءَ، حتى إذا لم يدروا ما سلَكوا منها أكثرُ أو ما بَقِيَ أنفَذوا الزادَ، وحَسَرُوا الظَّهْرَ، وبَقُوا بينَ ظَهْرَانَيِ المفازةِ، ولا زادَ ولا حَمولةَ؛ فأيقَنوا بالهلكةِ، فبينَما هم كذلك إذ خرج عليهم رجلٌ في حُلَّةٍ يَقْطُرُ رأسُه، فقالوا: هذا قريبُ عهدٍ بريفٍ، وما جاءكم هذا إلَّا مِن قريبٍ، فلمَّا انتهى إليهم قال: يا هؤلاءِ، فقالوا: يا هذا، فقال: عَلَامَ أنتم؟ فقالوا: على ما ترى، فقال: أرأيتم إنْ هَدَيْتُكم إلى ماءٍ رَواءٍ، ورياضٍ خُضْرٍ، ما تعملونَ؟ قالوا: لا نَعصيكَ شيئًا، قال: عهودَكم ومواثيقَكم باللهِ؛ فأعطَوْهُ عهودَهم ومواثيقَهم باللهِ لا يعصونَه شيئًا، قال: فأوردَهم ماءً رَواءً، ورياضًا خُضرًا، فمكَثَ فيهم ما شاء اللهُ، ثم قال: يا هؤلاءِ، قالوا: يا هذا، قال: الرحيلَ، قالوا: إلى أين؟ قال: إلى ماءٍ ليس كمائِكم، وإلى رياضٍ ليست كرياضِكم، فقال أكثرُهم: واللهِ، ما وجَدْنا هذا حتى ظننَّا أنَّا لن نجدَهُ، وما نصنَعُ بعيشٍ خيرٍ مِن هذا؟ فقالتْ طائفةٌ، وهُمْ أقلُّهم: ألم تُعطوا هذا الرجلَ عهودَكم ومواثيقَكم باللهِ ألَّا تعصوه شيئًا؟ وقد صَدَقَكم في أولِ حديثِه، فوالله لَيَصْدُقَنَّكم في آخِرِه, فراح فيمَنِ اتَّبعه، ",["وتخلَّفَ بقيَّتُهم",1],", ",["فنَذِرَ بهم عدُوٌّ؛ فأصبَحوا بينَ أسيرٍ وقَتيلٍ",2],"."],"grade":"حسن","narrator":"الحسن البصري","muhaddith":"نحوه أخصر منه وإسناده حسن","takhrij":"أخرجه ابن المبارك في ((الزهد)) (507)، والرامهرمزي في ((أمثال الحديث)) (صـ59)، وابن أبي الدنيا في ((الزهد)) (176) واللفظ لهم.","bab":"آداب عامة › ضرب الأمثال","dorar":"d4aPtvPQ"},{"id":"س-00268","fp":"230d281adce9","stateId":452,"easy":"إذا مت ولم تقدّم من مالك شيئاً ← فأنت الصعلوك حقاً","cause":"الذي له مالَ فماتَ ولم يُقدِّمْ منه شَيئًا","result":"الصُّعلوكُ كُلُّ الصُّعلوكِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج المسند لشعيب 23115","srcLabel":"أحمد","text":["عن رَجُلٍ شَهِدَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَخطُبُ فقال: تَدْرونَ ما الرَّقوبُ؟ قالوا: الذي لا وَلَدَ له، فقال: الرَّقوبُ كُلُّ الرَّقوبِ، الرَّقوبُ كُلُّ الرَّقوبِ، الرَّقوبُ كُلُّ الرَّقوبِ: الذي له وَلَدٌ فماتَ ولم يُقدِّمْ منهم شَيئًا، قال: تَدْرونَ ما الصُّعلوكُ؟ قالوا: الذي ليس له مالٌ، قال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",["الصُّعلوكُ كُلُّ الصُّعلوكِ",2],"، الصُّعلوكُ كُلُّ الصُّعلوكِ: ",["الذي له مالَ فماتَ ولم يُقدِّمْ منه شَيئًا",1],". قال: ثم قال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ما الصُّرَعةُ؟ قال: قالوا: الصَّريعُ، قال: فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: الصُّرَعةُ كُلُّ الصُّرَعةِ، الصُّرَعةُ كُلُّ الصُّرَعةِ: الرَّجُلُ يَغضَبُ فيَشتَدُّ غَضَبُه، ويَحمَرُّ وَجْهُه، ويَقشَعِرُّ شَعَرُه، فيَصرَعُ غَضَبَه."],"grade":"صحيح","narrator":"رجال من الصحابة","muhaddith":"صحيح لغيره دون قصة الصعلوك","takhrij":"أخرجه أحمد (23115)","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"w4wwUFDS"},{"id":"س-05619","fp":"522e0f4561a6","stateId":452,"easy":"إذا كانت الدنيا أحب إليك ← فكيف تفلح","cause":"والدُّنيا أحبُّ إليكَ","result":"كيفَ تُفلحُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"تاريخ بغداد 8/376","srcLabel":"الخطيب","text":["قال رسولُ اللهِ صلَّى اللهُ عليهِ وسلمَ  لرجلٍ من الأنصارِ : ",["كيفَ تُفلحُ",2]," ",["والدُّنيا أحبُّ إليكَ",1]," من أحنَى الناسِ عليك"],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"رجاله كلهم ثقات سوى داود، والحمل فيه عليه","takhrij":"أخرجه الخطيب في ((تاريخ بغداد)) (8/376) واللفظ له، والديلمي في ((الفردوس)) (4876)، وابن الجوزي في ((الموضوعات)) (3/131) باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"t3Q3tIaD"},{"id":"س-03644","fp":"67b323a974c5","stateId":453,"easy":"إذا نذرت ← فالنذر لا يرد شيئاً وإنما يُستخرج به من البخيل","cause":"ينهى عنِ النَّذر","result":"لا يردُّ شيئًا ، وإنَّما يُستَخرجُ بِهِ منَ البخيل","explicit":true,"star":true,"ref":"صحيح أبي داود 3287","srcLabel":"متفق عليه","text":["عن عبداللَّه بنِ عمرَ ، قالَ : أخذَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ ",["ينهى عنِ النَّذر",1]," ويقولُ : ",["لا يردُّ شيئًا ، وإنَّما يُستَخرجُ بِهِ منَ البخيل",2]," قالَ مسدَّدٌ : قالَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ : النَّذرُ لا يردُّ شيئًا"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3287) واللفظ له، وأخرجه البخاري (6693)، ومسلم (1639) باختلاف يسير","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"pYyEhBEq","merged":11,"otherRefs":["تخريج المسند لشعيب 7208 (صحيح)","تخريج مشكل الآثار 838 (صحيح)","صحيح الجامع 6910 (صحيح)","المحلى 8/3 (صحيح)","صحيح البخاري 6694 (صحيح)","صحيح ابن ماجه 1739 (صحيح)","صحيح أبي داود 3288 (صحيح)","صحيح الجامع 7466 (صحيح)","إرواء الغليل 8/209 (صحيح)","صحيح الجامع 4334 (صحيح)"]},{"id":"س-06189","fp":"029f94f798f0","stateId":453,"easy":"إذا لبست الحرير في الدنيا ← فلا خلاق لك في الآخرة","cause":"إنَّما يَلبَسُ الحَريرَ في الدُّنيا","result":"مَن لا خَلاقَ له في الآخِرةِ","explicit":true,"star":true,"otherNeedIds":[58],"ref":"صحيح مسلم 2068","srcLabel":"البخاري","text":["رَأى عُمَرُ عُطارِدًا التَّميميَّ يُقيمُ بالسُّوقِ حُلَّةً سيَراءَ، وكان رَجُلًا يَغشى المُلوكَ ويُصيبُ منهم، فقال عُمَرُ: يا رَسولَ اللهِ، إنِّي رَأيتُ عُطارِدًا يُقيمُ في السُّوقِ حُلَّةً سيَراءَ، فلَوِ اشتَرَيتَها فلَبِستَها لوُفودِ العَرَبِ إذا قدِموا عليكَ، وأظُنُّه قال: ولَبِستَها يَومَ الجُمُعةِ، فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["إنَّما يَلبَسُ الحَريرَ في الدُّنيا",1]," ",["مَن لا خَلاقَ له في الآخِرةِ",2],"، فلَمَّا كان بَعدَ ذلك أُتيَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم بحُلَلٍ سيَراءَ، فبَعَثَ إلى عُمَرَ بحُلَّةٍ، وبَعَثَ إلى أُسامةَ بنِ زَيدٍ بحُلَّةٍ، وأعطى عَليَّ بنَ أبي طالِبٍ حُلَّةً، وقال: شَقِّقْها خُمُرًا بينَ نِسائِكَ، قال: فجاءَ عُمَرُ بحُلَّتِه يَحمِلُها، فقال: يا رَسولَ اللهِ، بَعَثتَ إليَّ بهذه، وقد قُلتَ بالأمسِ في حُلَّةِ عُطارِدٍ ما قُلتَ! فقال: إنِّي لَم أبعَثْ بها إليكَ لتَلبَسَها، ولَكِنِّي بَعَثتُ بها إليكَ لتُصيبَ بها، وأمَّا أُسامةُ فراحَ في حُلَّتِه، فنَظَرَ إليه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم نَظَرًا عَرَفَ أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قد أنكَرَ ما صَنَعَ، فقال: يا رَسولَ اللهِ، ما تَنظُرُ إليَّ، فأنتَ بَعَثتَ إليَّ بها! فقال: إنِّي لَم أبعَثْ إليكَ لتَلبَسَها، ولَكِنِّي بَعَثتُ بها إليكَ لتُشَقِّقَها خُمُرًا بينَ نِسائِكَ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (886) مختصراً باختلاف يسير","bab":"زينة اللباس › إباحة الذهب والحرير للنساء دون الرجال","dorar":"tQ3aOJLO","merged":26,"otherRefs":["صحيح الأدب المفرد 52 (صحيح)","تخريج المسند لشاكر 1/129 (صحيح)","تخريج المسند لشاكر 7/115 (صحيح)","تخريج المسند لشعيب 6339 (صحيح)","نخب الافكار 13/262 (صحيح)","تخريج المسند لشعيب 345 (صحيح)","تخريج المسند لشعيب 8444 (صحيح)","نخب الافكار 13/261 (صحيح)","صحيح الأدب المفرد 20 (صحيح)","صحيح ابن ماجه 2908 (صحيح)","صحيح مسلم 2068 (صحيح)","صحيح النسائي 5321 (صحيح)","صحيح النسائي 5310 (صحيح)","صحيح البخاري 5841 (صحيح)","صحيح البخاري 886 (صحيح)","صحيح البخاري 2619 (صحيح)","تخريج المسند لشاكر 7/80 (صحيح)","تخريج صحيح ابن حبان 5113 (صحيح)","تخريج المسند لشعيب 123 (صحيح)","صحيح مسلم 2069 (صحيح)","صحيح البخاري 5830 (صحيح)","صحيح البخاري 5835 (صحيح)"]},{"id":"س-07360","fp":"e041e63f479d","stateId":453,"easy":"إذا ولّى القوم أمرهم امرأة ← لن يفلحوا","cause":"ولَّوا أمرَهمُ امرَأةً","result":"لَن يُفلِحَ قَومٌ","explicit":true,"star":true,"ref":"صحيح البخاري 4425","srcLabel":"متفق عليه","text":["لقد نَفَعَني اللهُ بكَلِمةٍ سَمِعتُها مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم أيَّامَ الجَمَلِ، بَعدَما كِدتُ أن ألحَقَ بأصحابِ الجَمَلِ فأُقاتِلَ معهم، قال: لَمَّا بَلَغَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم أنَّ أهلَ فارِسَ قد مَلَّكوا عليهم بنتَ كِسرى، قال: ",["لَن يُفلِحَ قَومٌ",2]," ",["ولَّوا أمرَهمُ امرَأةً",1],"."],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"[صحيح]","takhrij":"من أفراد البخاري على مسلم","bab":"فتن › موقعة الجمل","dorar":"gxmAI5T5","merged":9,"otherRefs":["تخريج المسند لشعيب 20508 (صحيح)","المستدرك على الصحيحين 4667 (صحيح)","المستدرك على الصحيحين 8000 (صحيح)","تخريج المسند لشعيب 34/107 (صحيح)","فتح الباري لابن حجر 13/60 (صحيح)","صحيح البخاري 7099 (صحيح)","المستدرك على الصحيحين 8823 (صحيح)","تخريج المسند لشعيب 20438 (صحيح)"]},{"id":"س-04574","fp":"7fc0943ed39b","stateId":453,"easy":"إذا أسرعت في الدفع من عرفة ← فالبر ليس بالإسراع، عليكم السكينة","cause":"عليكم السَّكينةَ","result":"فإنَّ البِرَّ ليس بالإيضاعِ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 21761","srcLabel":"متفق عليه","text":["كنتُ رِدفَ رسولِ اللهِ صَلَّى اللهُ عليه وسلَّمَ عَشيَّةَ عَرَفةَ، فلمَّا وَقَعَتِ الشَّمسُ دَفَعَ رسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ، فلمَّا سَمِعَ حَطْمةَ النَّاسِ خَلْفَه قال: رُوَيدًا أيُّها النَّاسُ، ",["عليكم السَّكينةَ",1],"؛ ",["فإنَّ البِرَّ ليس بالإيضاعِ",2],"، قال: فكان رسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ إذا التحَمَ عليه النَّاسُ أعنَقَ، وإذا وَجَدَ فُرْجةً نَصَّ، حتى مَرَّ بالشِّعبِ الذي يَزعُمُ كَثيرٌ مِن النَّاسِ أنَّه صَلَّى فيه، فنَزَلَ به فبالَ، ما يقولُ: أَهراقَ الماءَ كما تقولونَ، ثُمَّ جِئتُه بالإداوةِ فتَوضَّأَ، ثُمَّ قال: قُلتُ: الصَّلاةَ يا رسولَ اللهِ، قال: فقال: الصَّلاةُ أمامك، قال: فرَكِبَ رسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ وما صَلَّى حتى أتَى المُزدلِفةَ، فنَزَلَ بها فجَمَعَ بيْنَ الصَّلاتَينِ: المَغربِ، والعِشاءِ الآخِرةِ."],"grade":"صحيح","narrator":"أسامة بن زيد","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1669)، ومسلم (1280) باختلاف يسير","bab":"حج › الوقوف بعرفة وأحكامه","dorar":"5xgL7Ih6","merged":5,"otherRefs":["صحيح البخاري 1671 (صحيح)","تخريج سنن أبي داود 1920 (صحيح)","الإصابة في تمييز الصحابة 3/135 (صحيح)","صحيح ابن خزيمة 4/ 452 (صحيح)"]},{"id":"س-06186","fp":"ef684049f85e","stateId":453,"easy":"إذا لبست الحرير (للرجال) ← فهو لباس من لا خلاق له","cause":"إنَّما هذه لباسُ","result":"مَن لا خَلاقَ له","explicit":true,"star":true,"otherNeedIds":[58],"ref":"صحيح البخاري 948","srcLabel":"متفق عليه","text":["أخَذَ عُمَرُ جُبَّةً مِن إستَبرَقٍ تُباعُ في السُّوقِ، فأخَذَها، فأتى بها رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: يا رَسولَ اللهِ، ابتَعْ هذه تَجَمَّلْ بها للعيدِ والوُفودِ، فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["إنَّما هذه لباسُ",1]," ",["مَن لا خَلاقَ له",2],". فلَبِثَ عُمَرُ ما شاءَ اللهُ أن يَلبَثَ، ثُمَّ أرسَلَ إليه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم بجُبَّةِ ديباجٍ، فأقبَلَ بها عُمَرُ، فأتى بها رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: يا رَسولَ اللهِ، إنَّك قُلتَ: إنَّما هذه لباسُ مَن لا خَلاقَ له، وأرسَلتَ إليَّ بهذه الجُبَّةِ! فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: تَبيعُها أو تُصيبُ بها حاجَتَك."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (948)، ومسلم (2068)","bab":"زينة اللباس › إباحة الذهب والحرير للنساء دون الرجال","dorar":"aKKf1htM","merged":4,"otherRefs":["صحيح البخاري 2104 (صحيح)","تخريج المسند لشعيب 26469 (صحيح)","صحيح الأدب المفرد 267 (صحيح)"]},{"id":"س-05171","fp":"c02f1d5a52cd","stateId":453,"easy":"إذا تنطعت (تشددت وتكلفت) ← هلكت","cause":"ألَا هلَكَ المتنطِّعونَ ، ألَا هلكَ المتنطِّعونَ","result":"هلكَ الْمُتَنَطِّعونَ","explicit":true,"ref":"غاية المرام 7","srcLabel":"مسلم","text":["ألَا ",["هلكَ الْمُتَنَطِّعونَ",2],[" ألَا هلَكَ المتنطِّعونَ ، ألَا هلكَ المتنطِّعونَ",1]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2670) مع اختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"eN24n5Ma","merged":4,"otherRefs":["فتاوى نور على الدرب لابن عثيمين 5/405 (صحيح)","صحيح الجامع 7039 (صحيح)","صحيح أبي داود 4608 (صحيح)"]},{"id":"س-04165","fp":"c327b5e3bb34","stateId":453,"easy":"إذا لم تغتنم صحتك وفراغك ← غُبنت فيهما","cause":"الصِّحَّةُ والفَراغُ","result":"نِعمَتانِ مَغبونٌ فيهما كَثيرٌ مِنَ النَّاسِ","explicit":true,"ref":"صحيح البخاري 6412","srcLabel":"متفق عليه","text":[["نِعمَتانِ مَغبونٌ فيهما كَثيرٌ مِنَ النَّاسِ",2],": ",["الصِّحَّةُ والفَراغُ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"من أفراد البخاري على مسلم","bab":"جنائز وموت › لقاء الله والمبادرة بالعمل الصالح","dorar":"Pj2o0Vff"},{"id":"س-07940","fp":"fe05efe1c80c","stateId":453,"easy":"إذا رددت البشرى بالتشاؤم ← فنعم إذن (يكون كما قلت)","cause":"بَل هي حُمَّى تَفورُ -أو تَثورُ- على شَيخٍ كَبيرٍ، تُزيرُه القُبورَ","result":"فنَعَم إذَنْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح البخاري 3616","srcLabel":"متفق عليه","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم دَخَلَ على أعرابيٍّ يَعودُه، قال: وكان النَّبيُّ صلَّى اللهُ عليه وسلَّم إذا دَخَلَ على مَريضٍ يَعودُه، قال: لا بَأسَ، طَهورٌ إن شاءَ اللهُ، فقال له: لا بَأسَ، طَهورٌ إن شاءَ اللهُ، قال: قُلتَ: طَهورٌ؟ كَلَّا، ",["بَل هي حُمَّى تَفورُ -أو تَثورُ- على شَيخٍ كَبيرٍ، تُزيرُه القُبورَ",1],"، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ",["فنَعَم إذَنْ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"من أفراد البخاري على مسلم","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"pw1BlWJs","merged":5,"otherRefs":["الفتوحات الربانية 4/68 (حسن)","تخريج المسند لشعيب 13616 (صحيح)","صحيح البخاري 5662 (صحيح)","صحيح البخاري 7470 (صحيح)"]},{"id":"س-01985","fp":"ba85a31d0ee4","stateId":453,"easy":"إذا ذُكر النبي ﷺ عندك فلم تصلِّ عليه أو دخل عليك رمضان فلم يُغفر لك ← رغم أنفك","cause":"رَجُلٍ ذُكِرْتُ عِنْدَه فلَمْ يُصَلِّ علَيَّ، ورَغِمَ أَنْفُ رَجُلٍ دخَلَ عليه رَمضانُ فانْسَلخَ قَبْلَ أنْ يُغْفَرَ له، ورَغِمَ أَنْفُ رَجُلٍ أدرَكَ عِنْدَه أَبَواه الكِبَـرَ فلَمْ يُدْخِلاه الجنةَ","result":"رَغِمَ أَنْفُ","explicit":true,"ref":"تخريج المسند لشعيب 7451","srcLabel":"مسلم","text":[["رَغِمَ أَنْفُ",2],[" رَجُلٍ ذُكِرْتُ عِنْدَه فلَمْ يُصَلِّ علَيَّ، ورَغِمَ أَنْفُ رَجُلٍ دخَلَ عليه رَمضانُ فانْسَلخَ قَبْلَ أنْ يُغْفَرَ له، ورَغِمَ أَنْفُ رَجُلٍ أدرَكَ عِنْدَه أَبَواه الكِبَـرَ فلَمْ يُدْخِلاه الجنةَ",1],"، قال رِبْعِيٌّ: ولا أَعْلَمُه إلَّا قد قال: أو أَحَدُهما."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3545) باختلاف يسير، وإدراك الأبوين أصله في صحيح مسلم (2551)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"ycOd6Ua3"},{"id":"س-05826","fp":"3a0aa0d6f2b2","stateId":453,"easy":"إذا شاددت الدين ← يغلبك","cause":"من يشادَّ هذا الدِّينَ","result":"يغلبْهُ","explicit":true,"ref":"صحيح ابن خزيمة 2/ 343","srcLabel":"أحمد","text":["خرجتُ ذاتَ يومٍ أَمشي لحاجةٍ، فإذا أَنا بِرَسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يَمشي، فظَننتُهُ يريدُ حاجةً، فجعَلتُ أَكُفُّ عنهُ، فلم أزل أفعلُ ذلِكَ حتَّى رآني، فأشارَ إليَّ فأتيتُهُ، فأخذَ بيدي فانطَلقنا نمشي جميعًا، فإذا نحنُ برَجلٍ بينَ أيدينا يصلِّي، يُكْثرُ الرُّكوعَ والسُّجودَ، فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: أترَى يرائي؟، فقُلتُ: اللَّهُ ورسولُهُ أعلَمُ قالَ: فأرسلَ يدَهُ وطبَّقَ بينَ يديهِ ثلاثَ مرارٍ، يرفعُ يديهِ ويصوِّبُهُما ويقولُ: عليكُم هَديًا قاصدًا، عليكُم هديًا قاصِدًا، عليكُم هديًا قاصِدًا ؛ فإنَّهُ ",["من يشادَّ هذا الدِّينَ ",1],["يغلبْهُ",2],". [وفي لفظٍ]: لم يقُلْ: فإنَّهُ مَن يشادَّ هذا الدِّينَ يغلبْهُ"],"grade":"صحيح","narrator":"بريدة بن الحصيب","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الحاكم (1176) واللفظ له، وأحمد (22963)، والبيهقي (4805)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"bvG2cxWp","merged":10,"otherRefs":["صحيح الجامع 3420 (صحيح)","إتحاف الخيرة المهرة 1/112 (صحيح)","صحيح الجامع 1611 (صحيح)","الفتح الرباني 6/3207 (صحيح)","إتحاف الخيرة المهرة 1/113 (صحيح)","الصحيح المسند 166 (صحيح)","تخريج المسند لشعيب 19786 (صحيح)","تخريج شرح السنة 936 (صحيح)"]},{"id":"ق-0876","fp":"cbaac2c224a1","stateId":453,"easy":"مصاحبة خليل السوء وترك سبيل الرسول ← الندم وعضّ اليدين يوم القيامة والضلال عن الذكر","cause":"مصاحبة خليل السوء وترك سبيل الرسول","result":"الندم وعضّ اليدين يوم القيامة والضلال عن الذكر","explicit":true,"otherNeedIds":[19],"ref":"سورة الفرقان: 27–29","srcLabel":"القرآن الكريم","quran":{"s":25,"from":27,"to":29,"text":"وَيَوْمَ يَعَضُّ الظَّالِمُ عَلَى يَدَيْهِ يَقُولُ يَا لَيْتَنِي اتَّخَذْتُ مَعَ الرَّسُولِ سَبِيلًا (27) يَا وَيْلَتَى لَيْتَنِي لَمْ أَتَّخِذْ فُلَانًا خَلِيلًا (28) لَقَدْ أَضَلَّنِي عَنِ الذِّكْرِ بَعْدَ إِذْ جَاءَنِي وَكَانَ الشَّيْطَانُ لِلْإِنْسَانِ خَذُولًا (29)","hl":[[0,265,1]]}},{"id":"ق-1002","fp":"b6292309b7f2","stateId":453,"easy":"طاعة السادة والكبراء في الباطل ← الضلال والندم في النار","cause":"طاعة السادة والكبراء في الباطل","result":"الضلال والندم في النار","explicit":true,"otherNeedIds":[57,19],"ref":"سورة الأحزاب: 66–68","srcLabel":"القرآن الكريم","quran":{"s":33,"from":66,"to":68,"text":"يَوْمَ تُقَلَّبُ وُجُوهُهُمْ فِي النَّارِ يَقُولُونَ يَا لَيْتَنَا أَطَعْنَا اللَّهَ وَأَطَعْنَا الرَّسُولَا (66) وَقَالُوا رَبَّنَا إِنَّا أَطَعْنَا سَادَتَنَا وَكُبَرَاءَنَا فَأَضَلُّونَا السَّبِيلَا (67) رَبَّنَا آتِهِمْ ضِعْفَيْنِ مِنَ الْعَذَابِ وَالْعَنْهُمْ لَعْنًا كَبِيرًا (68)","hl":[[0,281,1]]}},{"id":"ق-1172","fp":"606d624e1a20","stateId":453,"easy":"الخلّة على غير التقوى ← العداوة يوم القيامة","cause":"الخلّة على غير التقوى","result":"العداوة يوم القيامة","explicit":true,"ref":"سورة الزخرف: 67","srcLabel":"القرآن الكريم","quran":{"s":43,"from":67,"to":67,"text":"الْأَخِلَّاءُ يَوْمَئِذٍ بَعْضُهُمْ لِبَعْضٍ عَدُوٌّ إِلَّا الْمُتَّقِينَ (67)","hl":[[0,52,1]]}},{"id":"ق-1195","fp":"cf559a5e2348","stateId":453,"easy":"عقوق الوالدين وإنكار البعث ← حقّ القول والخسران","cause":"عقوق الوالدين وإنكار البعث","result":"حقّ القول والخسران","explicit":true,"otherNeedIds":[57],"ref":"سورة الأحقاف: 17–18","srcLabel":"القرآن الكريم","quran":{"s":46,"from":17,"to":18,"text":"وَالَّذِي قَالَ لِوَالِدَيْهِ أُفٍّ لَكُمَا أَتَعِدَانِنِي أَنْ أُخْرَجَ وَقَدْ خَلَتِ الْقُرُونُ مِنْ قَبْلِي وَهُمَا يَسْتَغِيثَانِ اللَّهَ وَيْلَكَ آمِنْ إِنَّ وَعْدَ اللَّهِ حَقٌّ فَيَقُولُ مَا هَذَا إِلَّا أَسَاطِيرُ الْأَوَّلِينَ (17) أُولَئِكَ الَّذِينَ حَقَّ عَلَيْهِمُ الْقَوْلُ فِي أُمَمٍ قَدْ خَلَتْ مِنْ قَبْلِهِمْ مِنَ الْجِنِّ وَالْإِنْسِ إِنَّهُمْ كَانُوا خَاسِرِينَ (18)","hl":[[0,381,1]]}},{"id":"ق-1245","fp":"273aecd1a089","stateId":453,"easy":"ترك التثبّت من خبر الفاسق ← إصابة قوم بجهالة والندم","cause":"ترك التثبّت من خبر الفاسق","result":"إصابة قوم بجهالة والندم","explicit":true,"otherNeedIds":[39],"ref":"سورة الحجرات: 6","srcLabel":"القرآن الكريم","quran":{"s":49,"from":6,"to":6,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ جَاءَكُمْ فَاسِقٌ بِنَبَإٍ فَتَبَيَّنُوا أَنْ تُصِيبُوا قَوْمًا بِجَهَالَةٍ فَتُصْبِحُوا عَلَى مَا فَعَلْتُمْ نَادِمِينَ (6)","hl":[[31,156,1]]}},{"id":"س-04153","fp":"85884fdff753","stateId":453,"easy":"إذا مت وعليك دين ← نفسك معلقة بدينك","cause":"بدَينِهِ","result":"نَفسُ المؤمنِ معلَّقةٌ بدَينِهِ","explicit":true,"otherNeedIds":[2],"ref":"الاستذكار 4/101","srcLabel":"الترمذي","text":[["نَفسُ المؤمنِ معلَّقةٌ بدَينِهِ ، ",2],"أو قالَ : ما كانَ عليهِ دَينٌ حتَّى يُقضَى عنهُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1078)، وابن ماجه (2413)، وأحمد (9679).","bab":"جنائز وموت › قضاء دين الميت","dorar":"dqsTCFwn","merged":4,"otherRefs":["تاريخ دمشق 45/73 (صحيح)","أطراف الغرائب 2/351 (حسن)","الترغيب والترهيب 3/51 (صحيح)"]},{"id":"س-07964","fp":"26b763e31f33","stateId":453,"easy":"إذا نشدت ضالة في المسجد ← لا ردها الله عليك","cause":"مَن يَنشُدُ ضالَّةً في المَسجِدِ","result":"لا رَدَّها اللهُ عليك","explicit":true,"otherNeedIds":[49],"ref":"الأحكام الوسطى 1/ 295","srcLabel":"الترمذي","text":["إذا رَأيْتُم مَن يَبيعُ أو يَبْتاعُ في المَسجِدِ فقولوا: لا أَربَحَ اللهُ تِجارتَك، وإذا رَأيْتُم ",["مَن يَنشُدُ ضالَّةً في المَسجِدِ",1]," فقولوا: ",["لا رَدَّها اللهُ عليك",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه الترمذي (1321)، والدارمي (1441)، والنسائي في ((السنن الكبرى)) (9933) بلفظه.","bab":"مساجد ومواضع الصلاة › العناية بالمسجد","dorar":"E145Lb51","merged":4,"otherRefs":["صحيح النسائي 716 (صحيح)","تخريج المسند لشاكر 16/242 (صحيح)","معرفة السنن والآثار 19735 (صحيح)"]},{"id":"س-07180","fp":"2e0e59967303","stateId":453,"easy":"إذا عطست ولم تحمد الله ← لا تُشمّت","cause":"وإنَّ هذا لم يَحمَدِ اللهَ","result":"وتَرَكَ الآخَرَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-00180"],"ref":"تخريج المسند لشعيب 12798","srcLabel":"متفق عليه","text":["عَطَسَ رَجُلانِ عندَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فشَمَّتَ أحدَهما -أو قال: فسَمَّتَ أحدَهما- ",["وتَرَكَ الآخَرَ",2],". فقيلَ: هُما رَجُلانِ عَطَسا، فشَمَّتَ -أو قال: فسَمَّتَ أحدَهما- وتَرَكتَ الآخَرَ، فقال: إنَّ هذا حَمِدَ اللهَ، ",["وإنَّ هذا لم يَحمَدِ اللهَ",1],". قال سُليمانُ: أُراه نَحْوًا مِن هذا."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6221)، ومسلم (2991)، وأبو داود (5039)، والترمذي (2742)، والنسائي في ((السنن الكبرى)) (10050)، وابن ماجه (3713)، وأحمد (12798) واللفظ له","bab":"علم › حسن السؤال ونصح العالم","dorar":"AddQEBL0"},{"id":"س-03036","fp":"715f133dab95","stateId":453,"easy":"إذا أدركت والديك أو أحدهما عند الكبر فلم يدخلاك الجنة ← بعُدت","cause":"مَن أدْركَ أبويهِ الكِبَرُ عندَهُ أو أحدَهُما، فلمْ يُدْخِلاهُ الجنَّةَ","result":"بَعُدَ","explicit":true,"otherNeedIds":[35],"ref":"المستدرك على الصحيحين 7462","srcLabel":"مالك","text":["قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: احضُرُوا المِنْبَرَ، فحضَرْنا، فلمَّا ارتَقى درَجةً قالَ: آمِين، فلمَّا ارتَقَى الدَّرَجةَ الثَّانِيةَ قالَ: آمِينَ، فلمَّا ارتقَى الدَّرَجةَ الثَّالثةَ قالَ: آمِينَ، فلمَّا نزَلَ قُلْنا: يا رسولَ اللهِ، لقَدْ سَمِعْنا منكَ اليومَ شيئًا ما كُنَّا نَسمَعُه، قالَ: إنَّ جِبريلَ عليهِ السَّلامُ عرَضَ لي فقال: ",["بَعُدَ",2]," مَن أدرَكَ رمَضانَ فلَمْ يُغْفَرْ له، قلْتُ: آمِينَ، فلمَّا رَقِيتُ الثَّانيةَ، قالَ: بَعُدَ مَن ذُكِرْتَ عندَهُ، فلمْ يُصَلِّ عليكَ، قلْتُ: آمِينَ، فلمَّا رَقِيتُ الثَّالثةَ قالَ: بَعُدَ ",["مَن أدْركَ أبويهِ الكِبَرُ عندَهُ أو أحدَهُما، فلمْ يُدْخِلاهُ الجنَّةَ",1],"، قلْتُ: آمِينَ."],"grade":"صحيح","narrator":"كعب بن عجرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني (19/ 144) (315)، والقاضي إسماعيل المالكي في ((فضل الصلاة على النبي)) (19)، وابن شاهين في ((فضائل رمضان)) (ص131) بلفظ قريب.","bab":"إيمان › الوعيد","dorar":"jaa1VQvy","merged":3,"otherRefs":["صحيح الأدب المفرد 500 (صحيح)","تخريج المسند لشعيب 19030 (صحيح)"]},{"id":"س-03668","fp":"8e0bc5a91bfc","stateId":453,"easy":"إذا كانت فترتك إلى معاصي الله ← فأنت الهالك","cause":"ومَن كانت فترتُهُ إلى معاصي اللَّهِ","result":"فذلِكَ الهالِكُ","explicit":true,"otherNeedIds":[19],"ref":"تخريج المسند لشاكر 10/51","srcLabel":"أحمد","text":["ذُكِرَ لرسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ رجالٌ ينصَبونَ في العبادةِ من أصحابِهِ نصَبًا شديدًا ، قالَ : فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : تلكَ ضراوةُ الإسلامِ وشرَّتُهُ ، ولِكُلِّ ضراوةٍ شرَّةٌ ، ولِكُلِّ شرَّةٍ فَترةٌ ، فمن كانَت فَترتُهُ إلى الكِتابِ والسُّنَّةِ فلِأمٍّ ، ما هوَ ، ",["ومَن كانت فترتُهُ إلى معاصي اللَّهِ",1]," ",["فذلِكَ الهالِكُ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6540) واللفظ له، والبزار (2401)، والطبراني (13/429) (14274).","bab":"اعتصام بالسنة › الأمر بالتمسك بالكتاب والسنة","dorar":"UoPX2Itf","merged":2,"otherRefs":["مجمع الزوائد 2/261 (صحيح)"]},{"id":"س-04483","fp":"34c8739075a0","stateId":453,"easy":"إذا أتبعت نفسك هواها وتمنيت على الله ← فأنت العاجز","cause":"من أتبعَ نفسَه هواها وتمنى على اللهِ","result":"والعاجزُ","explicit":true,"ref":"مجموع الفتاوى 14/460","srcLabel":"السنة","text":["المجاهدُ منْ جاهدَ نفسَه في ذاتِ اللهِ ، والكيّسُ من دانَ نفسَه وعملَ لما بعد الموتِ ، ",["والعاجزُ",2]," ",["من أتبعَ نفسَه هواها وتمنى على اللهِ",1]],"grade":"صحيح","muhaddith":"ثابت","bab":"جهاد › فضل الجهاد","dorar":"Guxupdvm","merged":2,"otherRefs":["الجامع الصغير 6450 (صحيح)"]},{"id":"س-07004","fp":"ca4f294aae02","stateId":453,"easy":"إذا غلوت في الدين ← فإنما أهلك من قبلكم الغلو","cause":"والغُلُوَّ في الدِّينِ","result":"فإنَّما أَهلَكَ مَن كانَ قَبْلَكم الغُلُوُّ في الدِّينِ","explicit":true,"ref":"الأحكام الوسطى 2/ 301","srcLabel":"السنة","text":["قالَ لي رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ غَداةَ العَقَبةِ وهو على راحِلتِه: \"هاتِ الْقُطْ لي\"، فلَقَطْتُ له حَصَياتٍ مِن حَصى الخَذْفِ، فلمَّا وَضَعْتُهنَّ في يَدِه قالَ: \"بأمِثالِ هؤلاء، وإيَّاكم ",["والغُلُوَّ في الدِّينِ",1],"؛ ",["فإنَّما أَهلَكَ مَن كانَ قَبْلَكم الغُلُوُّ في الدِّينِ",2],"\"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","bab":"علم › الحث على الأخذ بالسنة","dorar":"htb6Vhe4","merged":2,"otherRefs":["البدر المنير 6/282 (حسن)"]},{"id":"س-07017","fp":"c6efc0e87f3b","stateId":453,"easy":"إذا تعلمت العلم ثم لم تحدث به ← فأنت كمن يكنز الكنز ولا ينفق منه","cause":"يتعلَّمُ العلمَ ثم لا يُحدِّثُ به","result":"كمثل الذي يكنزُ الكنزَ ثم لا يُنفِقُ منه","explicit":true,"otherNeedIds":[12],"ref":"صحيح الترغيب 122","srcLabel":"الطبراني","text":["مثل الذي ",["يتعلَّمُ العلمَ ثم لا يُحدِّثُ به",1]," ، ",["كمثل الذي يكنزُ الكنزَ ثم لا يُنفِقُ منه",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (689)، وابن عبدالبر في ((جامع بيان العلم وفضله)) (774)","bab":"علم › الحث على طلب العلم","dorar":"AJtAVQWM","merged":2,"otherRefs":["العلم لأبي خيثمة 162 (حسن)"]},{"id":"س-00818","fp":"abdaa304f83a","stateId":453,"easy":"إذا أدركت والديك أو أحدهما فلم يدخلاك الجنة ← رغم أنفك","cause":"عَبدٍ - أو بَعُدَ - أدرَكَ والديهِ أو أحدَهُما لم يُدخِلهُ الجنَّةَ","result":"رغمَ أنفُ","explicit":true,"ref":"صحيح ابن خزيمة 3/ 342","srcLabel":"الترمذي","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ رقِيَ المنبرَ فقالَ: آمينَ، آمينَ، آمينَ، فقيلَ لَهُ: يا رسولَ اللَّهِ، ما كنتَ تَصنعُ هذا فقالَ: قالَ لي جبريلُ: أرغَمَ اللَّهُ أنفَ عبدٍ - أو بَعُدَ - دخلَ رمضانَ فلم يُغفَرْ لَهُ، فقلتُ: آمينَ، ثمَّ قالَ: ",["رغمَ أنفُ",2],[" عَبدٍ - أو بَعُدَ - أدرَكَ والديهِ أو أحدَهُما لم يُدخِلهُ الجنَّةَ",1],"، فقُلتُ: آمينَ، ثمَّ قالَ: رغِمَ أنفُ عبدٍ - أو بعُدَ - ذُكِرتَ عندَهُ فلم يُصلِّ عليكَ، فقلتُ: آمينَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الترمذي (3545)، وأحمد (7451)، وابن حبان (907) بنحوه.","bab":"أدعية وأذكار › دعاء النبي على بعض الأشخاص والأشياء والأمور","dorar":"qlfy9zIk"},{"id":"س-02511","fp":"d65518894466","stateId":453,"easy":"إذا حُرمت خير ليلة القدر ← فقد حُرمت","cause":"مَن حُرِمَ خَيْرَها","result":"فقد حُرِم","explicit":true,"similar":["س-01888"],"ref":"تخريج المسند لشعيب 7148","srcLabel":"النسائي","text":["لَمَّا حضَرَ رَمَضانُ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: قد جاءَكم رَمَضانُ، شَهْرٌ مُبارَكٌ، افتَرَضَ اللهُ عليكم صِيامَه، تُفْتَحُ فيه أَبْوابُ الجنةِ، وتُغلقُ فيه أبوابُ الجحيمِ، وتُغَلُّ فيه الشَّياطينُ، فيه ليلَةٌ خَيْرٌ مِن أَلْفِ شَهرٍ، ",["مَن حُرِمَ خَيْرَها ",1],["فقد حُرِم",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (2106)، وأحمد (7148) واللفظ له","bab":"إيمان › أعمال الجن والشياطين","dorar":"IUbKzziZ"},{"id":"س-04885","fp":"5c5e54cedbdf","stateId":453,"easy":"إذا لقيت الله بغير أثر من جهاد ← تلقاه وفيك ثلمة","cause":"مَن لَقِيَ اللهَ بغيرِ أَثَرٍ من جهادٍ","result":"لَقِيَ اللهَ و فيه ثُلْمَةٌ","explicit":true,"ref":"الجامع الصغير 8993","srcLabel":"الترمذي","text":[["مَن لَقِيَ اللهَ بغيرِ أَثَرٍ من جهادٍ ، ",1],["لَقِيَ اللهَ و فيه ثُلْمَةٌ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1666) واللفظ له، وابن ماجه (2763) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"jxVFfHrh"},{"id":"س-05242","fp":"d5e6fdffc59c","stateId":453,"easy":"إذا أكثرت الحلف ← فهو حنث أو ندم","cause":"الحَلِفُ","result":"حِنْثٌ أو ندَمٌ","explicit":true,"ref":"صحيح ابن حبان 4356","srcLabel":"ابن ماجه","text":["إنَّما ",["الحَلِفُ",1]," ",["حِنْثٌ أو ندَمٌ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن ماجه (2103)، والطبراني في ((المعجم الأوسط)) (8425)، والحاكم (7835)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"T6TpJyfg"},{"id":"س-05567","fp":"c0bdb99e2faa","stateId":453,"easy":"إذا جمدت عينك وقسا قلبك وطال أملك وحرصت على الدنيا ← فهي من الشقاء","cause":"جُمودُ العَيْنِ، وقَساوةُ القَلْبِ، وطولُ الأمَلِ، والحِرْصُ على الدُّنْيا","result":"أرْبَعةٌ مِن الشَّقاءِ","explicit":true,"otherNeedIds":[19],"ref":"الأحكام الوسطى 4/ 279","srcLabel":"السنة","text":["\"",["أرْبَعةٌ مِن الشَّقاءِ",2],": ",["جُمودُ العَيْنِ، وقَساوةُ القَلْبِ، وطولُ الأمَلِ، والحِرْصُ على الدُّنْيا",1],"\"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"bA1ljMSq"},{"id":"س-05864","fp":"f6989c44fcc7","stateId":453,"easy":"إذا عجلت ← أخطأت أو كدت","cause":"ومن عجِلَ","result":"أخطأ أو كاد","explicit":true,"ref":"شرح كتاب الشهاب 469","srcLabel":"الطبراني","text":["من تأنَّى أصاب أو كاد ",["ومن عجِلَ",1]," ",["أخطأ أو كاد",2]],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني (17/310) (858)، والقضاعي في ((مسند الشهاب)) (362)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"eNEO70Ga"},{"id":"س-07573","fp":"83f26c443552","stateId":453,"easy":"إذا أطيع الشح واتُّبع الهوى وتولى إمام ضلال ← فهي أخوف ما يُخاف على الأمة","cause":"شُحٌّ مُطاعٌ ، وهوًى مُتَّبعٌ ، وإمامُ ضلالٍ","result":"ما أخاف على أمَّتي إلَّا ثلاثًا","explicit":true,"otherNeedIds":[19],"ref":"السلسلة الصحيحة 3237","srcLabel":"الدولابي","text":[["ما أخاف على أمَّتي إلَّا ثلاثًا",2]," : ",["شُحٌّ مُطاعٌ ، وهوًى مُتَّبعٌ ، وإمامُ ضلالٍ",1]],"grade":"صحيح","narrator":"عمرو بن سفيان بن عبد شمس السلمي","muhaddith":"إسناده صحيح رجاله ثقات","takhrij":"أخرجه الدولابي في ((الكنى والأسماء)) (113)، وابن قانع في ((معجم الصحابة)) (2/ 206)، وأبو نعيم في ((معرفة الصحابة)) (5071) واللفظ لهم جميعا.","bab":"فضائل النبي وصفته ودلائل النبوة › شفقته على أمته","dorar":"5DmE3QjK"},{"id":"س-07727","fp":"43eae7bbe67f","stateId":453,"easy":"إذا كان الأئمة أئمة حرج ← فإنما أهلك من قبلكم","cause":"أئمةُ الحرجِ","result":"إنَّما أهلك الذين قبلكم","explicit":true,"otherNeedIds":[20],"ref":"تفسير الطبري 5/1/109","srcLabel":"الطبراني","text":["قام رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ في الناسِ ، فقال : كُتِبَ عليكمُ الحجَّ ! فقام رجلٌ من الأعرابِ ، فقال : أفي كلِّ عامٍ ؟ قال : فغَلِقَ كلامُ رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ وأسكتَ واستَغْضَبَ ، فمكثَ طويلًا ، ثم تكلَّمَ فقال : من السائلُ ؟ فقال الأعرابيُّ : أنا ذا ، فقال : ويحكَ ماذا يُؤْمِنُكَ أن أقولَ : نعم ، ولو قلتُ : نعم لوجبتْ ، ولو وجبتْ لكفرتم ! ألا إنَّهُ ",["إنَّما أهلك الذين قبلكم",2]," ",["أئمةُ الحرجِ",1]," ، واللهِ لو أني أحللتُ لكم جميعَ ما في الأرضِ ، وحَرَّمْتُ عليكم منها موضعَ خُفٍّ لوقعتم فيهِ ! قال : فأنزل اللهُ تعالى عند ذلك : ?يَا أَيُّهَا الَّذِينَ آمَنُوْا لَا تَسْأَلُوْا عَنْ أَشْيَاءَ? . . . إلى آخرِ الآيةِ"],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه الطبري في ((التفسير)) (12807) واللفظ له، والطحاوي في ((شرح مشكل الآثار)) (1474)، والطبراني (8/186) (7671)","bab":"قرآن › أسباب النزول","dorar":"nw6nX2LT"},{"id":"س-01719","fp":"9b44b9931346","stateId":453,"easy":"إذا أكثرت النوم بالليل ← تدعك كثرته فقيراً يوم القيامة","cause":"لا تُكثِرِ النَّومَ باللَّيلِ","result":"فإنَّ كَثرةَ النَّومِ باللَّيلِ تَدَعُ الرجُلَ فَقيرًا يَومَ القيامةِ","explicit":true,"ref":"تنزيه الشريعة 2/106","srcLabel":"ابن ماجه","text":["قالتْ أُمُّ سُلَيمانَ بنِ داودَ لسُلَيمانَ بنِ داودَ عليهما الصَّلاةُ والسَّلامُ: يا بُنَيَّ، ",["لا تُكثِرِ النَّومَ باللَّيلِ؛ ",1],["فإنَّ كَثرةَ النَّومِ باللَّيلِ تَدَعُ الرجُلَ فَقيرًا يَومَ القيامةِ",2],"."],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"إن وجد له متابع حكم بحسنه على كل قول","takhrij":"أخرجه ابن ماجه (1332)، والعقيلي في ((الضعفاء الكبير)) (4/456)، وابن حبان في ((المجروحين)) (2/396)","bab":"أنبياء › عام","dorar":"lJUMDGgx"},{"id":"س-02495","fp":"381c6d3dba69","stateId":453,"easy":"إذا سألت العمل ← لا يُستعان بك","cause":"مَن سَأَلَناه","result":"إنَّا لا نَستعينُ في عملِنا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 19741","srcLabel":"النسائي","text":["عن أبي موسى الأشعَريِّ قال: أتاني ناسٌ مِن الأشعَريِّينَ فقالوا: اذهَبْ معنا إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؛ فإنَّ لنا حاجةً، قال: فقُمتُ معهم، فقالوا: يا رسولَ اللهِ، استعِنْ بنا في عملِكَ، فاعتَذَرتُ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ ممَّا قالوا، وقُلتُ: لم أدْرِ ما حاجتُهم، فصَدَّقَني رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ وعذَرَني، وقال: ",["إنَّا لا نَستعينُ في عملِنا",2]," ",["مَن سَأَلَناه",1],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه النسائي (5382)، وأحمد (19741) واللفظ له","bab":"إمامة وخلافة › تولية الولاة وغيرهم","dorar":"mFbKYviy"},{"id":"س-03747","fp":"a2aa44220f2d","stateId":453,"easy":"إذا عجلتم ← تشتتت بكم الطرق","cause":"وإنَّكم إنْ عجلْتُمْ","result":"تشَتَّتتْ بكمُ الطُّرُقُ ها هُنا وها هنا","explicit":true,"ref":"إتحاف الخيرة المهرة 8/96","srcLabel":"أبو داود","text":["لا تَعجَلوا بالبَليَّةِ قبل نُزولِها  فإنَّكم إلا تفعَلوا أوشَكَ أنْ يكونَ فيكم منْ إذا قال:  سُدِّدَ أو وُفِّقَ  ",["وإنَّكم إنْ عجلْتُمْ",1]," ",["تشَتَّتتْ بكمُ الطُّرُقُ ها هُنا وها هنا",2]],"grade":"حسن","narrator":"معاذ بن جبل","muhaddith":"رواته ثقات","takhrij":"أخرجه إسحاق بن راهويه كما في ((المطالب العالية)) لابن حجر (3029)، وأبو داود في ((المراسيل)) (457)، وابن بطة في ((الإبانة)) (1/رقم292) جميعهم بلفظه، والدارمي (155) باختلاف يسير.","bab":"اعتصام بالسنة › ما يكره من كثرة السؤال وتكلف ما لا يعنيه","dorar":"U2QwxQTu"},{"id":"س-03795","fp":"0411fb6f7028","stateId":453,"easy":"إذا أحسنت الظن بالناس كلهم ← كثرت ندامتك","cause":"مَن حسُنَ ظنُّه بالنَّاسِ","result":"كثُرَتْ ندامتُهُ","explicit":true,"ref":"مختصر المقاصد 1020","srcLabel":"تمام","text":[["مَن حسُنَ ظنُّه بالنَّاسِ ",1],["كثُرَتْ ندامتُهُ",2]],"grade":"حسن","narrator":"[عبدالله بن عباس]","muhaddith":"حسن لغيره","takhrij":"أخرجه تمام في ((فوائده)) (1188)، وابن عساكر في ((تاريخ دمشق)) (57/ 126) واللفظ لهما.","bab":"بر وصلة › تحري الجار والرفيق","dorar":"s7c1kq9q"},{"id":"س-04725","fp":"47be9951e8eb","stateId":453,"easy":"إذا لم تنفق مالك في سبيل الله ← فلا خير فيه","cause":"مالٍ لا يُنفَقُ في سبيلِ اللهِ","result":"لا خيرَ في مالٍ","explicit":true,"ref":"تفسير القرآن العظيم 8/103","srcLabel":"أبو داود","text":["كان في خطبةِ أبي بكر الصدِّيقِ رضي اللهُ عنه : أما تعلمون أنكم تغدون وتروحون لأجلٍ معلومٍ ، فمن استطاع أن يقضيَ الأجلَ وهو في عملِ اللهِ عزَّ وجلَّ فليفعلْ ، ولن تنالوا ذلك إلا بالله عزَّ وجلَّ ، إنَّ قومًا جعلوا آجالَهم لغيرهم ، فنهاكم اللهُ أن تكونوا أمثالهم  وَلَا تَكُونُوا كَالَّذِينَ نَسُوا اللهَ فَأَنْسَاهُمْ أَنْفُسَهُمْ  أين مَن تعرفون من إخوانِكم ؟ قدِموا على ما قدِموا في أيامٍ سلَفِهم ، وخلَوْا بالشَّقوةِ والسعادةِ ، أين الجبارون الأولونَ الذين بنوا المدائنَ وحصَّنوها بالحوائطِ ؟ قد صاروا تحت الصَّخرِ والآبارِ ، هذا كتابُ اللهِ لا تَفْنى عجائبُه ، فاستَضيئوا منه ليوم الظُّلمةِ ، واستنصِحوا كتابَه وتبيانَه ، إنَّ اللهَ أثنى على زكريا وأهلَ بيتِه فقال  إِنَّهُمْ كَانُوا يُسَارِعُونَ فِي الْخَيْرَاتِ وَيَدْعُونَنَا رَغَبًا وَرَهَبًا وَكَانُوا لَنَا خَاشِعِينَ  لا خيرَ في قولٍ لا يرادُ به وجهُ اللهِ و",["لا خيرَ في مالٍ",2],[" لا يُنفَقُ في سبيلِ اللهِ",1]," ، ولا خيرَ فيمن يغلِبُ جهلُه حِلمَه ، ولا خيرَ فيمن يخافُ في الله لومةَ لائمٍ"],"grade":"حسن","narrator":"نعيم بن نمحة","muhaddith":"إسناده جيد","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (1/ 60) (39)، واللفظ له، وأبو داود في ((الزهد)) (26)، وأبو نعيم في ((حلية الأولياء)) (1/ 36)، بلفظ مقارب.","bab":"رقائق وزهد › الإخلاص","dorar":"z8Xyc5hX"},{"id":"س-04727","fp":"4be6d610a889","stateId":453,"easy":"إذا خفت في الله لومة لائم ← فلا خير فيك","cause":"يخافُ في الله لومةَ لائمٍ","result":"لا خيرَ فيمن يخافُ","explicit":true,"ref":"تفسير القرآن العظيم 8/103","srcLabel":"أبو داود","text":["كان في خطبةِ أبي بكر الصدِّيقِ رضي اللهُ عنه : أما تعلمون أنكم تغدون وتروحون لأجلٍ معلومٍ ، فمن استطاع أن يقضيَ الأجلَ وهو في عملِ اللهِ عزَّ وجلَّ فليفعلْ ، ولن تنالوا ذلك إلا بالله عزَّ وجلَّ ، إنَّ قومًا جعلوا آجالَهم لغيرهم ، فنهاكم اللهُ أن تكونوا أمثالهم  وَلَا تَكُونُوا كَالَّذِينَ نَسُوا اللهَ فَأَنْسَاهُمْ أَنْفُسَهُمْ  أين مَن تعرفون من إخوانِكم ؟ قدِموا على ما قدِموا في أيامٍ سلَفِهم ، وخلَوْا بالشَّقوةِ والسعادةِ ، أين الجبارون الأولونَ الذين بنوا المدائنَ وحصَّنوها بالحوائطِ ؟ قد صاروا تحت الصَّخرِ والآبارِ ، هذا كتابُ اللهِ لا تَفْنى عجائبُه ، فاستَضيئوا منه ليوم الظُّلمةِ ، واستنصِحوا كتابَه وتبيانَه ، إنَّ اللهَ أثنى على زكريا وأهلَ بيتِه فقال  إِنَّهُمْ كَانُوا يُسَارِعُونَ فِي الْخَيْرَاتِ وَيَدْعُونَنَا رَغَبًا وَرَهَبًا وَكَانُوا لَنَا خَاشِعِينَ  لا خيرَ في قولٍ لا يرادُ به وجهُ اللهِ ولا خيرَ في مالٍ لا يُنفَقُ في سبيلِ اللهِ ، ولا خيرَ فيمن يغلِبُ جهلُه حِلمَه ، و",["لا خيرَ فيمن يخافُ",2],[" في الله لومةَ لائمٍ",1]],"grade":"حسن","narrator":"نعيم بن نمحة","muhaddith":"إسناده جيد","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (1/ 60) (39)، واللفظ له، وأبو داود في ((الزهد)) (26)، وأبو نعيم في ((حلية الأولياء)) (1/ 36)، بلفظ مقارب.","bab":"رقائق وزهد › الإخلاص","dorar":"z8Xyc5hX"},{"id":"س-07196","fp":"9f5e82951cef","stateId":453,"easy":"إذا عطست ولم تحمد الله ← نسيت الله فنسيك","cause":"فعَطَسَ الشَّريفُ، فلَمْ يحْمَدِ اللهَ","result":"إنَّكَ نَسِيتَ اللهَ فنَسِيتُكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 7898","srcLabel":"أحمد","text":["جَلَسَ عندَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ رَجُلانِ، أحَدُهُما أشْرَفُ مِن الآخَرِ، ",["فعَطَسَ الشَّريفُ، فلَمْ يحْمَدِ اللهَ",1],"، فلَمْ يُشَمِّتْه النَّبيُّ صلَّى اللهُ عليه وسلَّمَ، ثمَّ عطَسَ الآخرُ فحمِدَ اللهَ، فشَمَّتَه النَّبيُّ صلَّى اللهُ عليه وسلَّمَ، فقالَ الشَّريفُ: عطَسْتُ فلَمْ تُشَمِّتْني، وعطَسَ هذا فشَمَّتَّه، قالَ: ",["إنَّكَ نَسِيتَ اللهَ فنَسِيتُكَ",2],"، وإنَّ هذا ذَكَر اللهَ فذَكَرْتُه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (8346)، وابن حبان (7689)بنحوه، والطبراني في ((المعجم الأوسط ))(7580) مختصرا","bab":"علم › حسن السؤال ونصح العالم","dorar":"OBzRCApW"},{"id":"س-07592","fp":"f37505fd48df","stateId":453,"easy":"إذا آذيتم نبيكم ← فكيف تفلحون","cause":"فعلوا هذا بنبيِّهم","result":"كيفَ تُفلحُ أمَّةٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح الترمذي 3003","srcLabel":"الترمذي","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ شُجَّ في وجهِهِ وَكُسِرت رَباعيتُهُ ، ورميَ رميةً على كتِفِهِ ، فجعلَ الدَّمُ يسيلُ على وجهِهِ ، وَهوَ يمسحُهُ ويقولُ: ",["كيفَ تُفلحُ أمَّةٌ",2]," ",["فعلوا هذا بنبيِّهم",1]," وَهوَ يَدعوهُم إلى اللَّهِ ؟ فأنزلَ اللَّهُ تبارَكَ وتعالى : ( لَيْسَ لَكَ مِنَ الأَمْرِ شَيْءٌ أَوْ يَتُوبَ عَلَيْهِمْ أَوْ يُعَذِّبَهُمْ فَإِنَّهُمْ ظَالِمُونَ )"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3003) واللفظ له، وابن ماجه (4027)، وأحمد (3/201) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › صبره","dorar":"2gdTZU8z"},{"id":"س-08370","fp":"28707f1f6b7a","stateId":453,"easy":"إذا لم تحفظ النبي ﷺ في أصحابه ← لا ترد حوضه ولا تراه إلا من بعيد","cause":"ومن لم يحفَظني فيهم","result":"لم يرِد حَوضي ولم يرَني إلَّا من بعيدٍ","explicit":true,"ref":"در السحابة 35","srcLabel":"ابن عساكر","text":["احفَظوني في أصحابي فمن حفِظَني في أصحابي رافَقني وورد عليَّ الحَوضَ ",["ومن لم يحفَظني فيهم",1]," ",["لم يرِد حَوضي ولم يرَني إلَّا من بعيدٍ",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن عساكر في ((تاريخ دمشق)) (23/463)","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"Sq9X6rpZ"},{"id":"س-00179","fp":"310768c7ccfd","stateId":453,"easy":"إذا عطست ولم تحمد الله ← لا تستحق التشميت","cause":"ثمَّ عطَس آخَرُ، فسكَتَ","result":"فلمْ يَقُلْ له شيئًا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"تخريج مشكل الآثار 528","srcLabel":"متفق عليه","text":["كُنَّا جُلوسًا عندَ رسولِ اللهِ عليه السَّلامُ فعطَس رجُلٌ، فحمِد اللهَ، فقال نبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ: يرحَمُكَ اللهُ، ",["ثمَّ عطَس آخَرُ، فسكَتَ",1],"، ",["فلمْ يَقُلْ له شيئًا",2],"، فقال: يا رسولَ اللهِ، عطَس هذا، فقُلْتَ له: يرحَمُكَ اللهُ، وعطَسْتُ أنا فلمْ تَقُلْ لي شيئًا، فقال: إنَّ هذا حمِد اللهَ، وإنَّكَ سكَتَّ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم، رجاله ثقات رجال الشيخين غير يزيد بن كيسان، فمن رجال مسلم","takhrij":"أخرجه الطحاوي في  ((شرح مشكل الآثار)) (528) واللفظ له، والبخاري في ((الأدب المفرد)) (930)، وابن أبي شيبة في ((الأدب)) (318) كلاهما باختلاف يسير.","bab":"آداب العطاس › العطاس","dorar":"dXvUYanG"},{"id":"س-00180","fp":"d2a55ed1d984","stateId":453,"easy":"إذا عطست ولم تحمد الله ← لا تُشمّت","cause":"وإنَّكَ لم تحمَدِ اللَّهَ","result":"ولم يشمِّتِ الآخرَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-07180","ref":"صحيح الترمذي 2742","text":["أنَّ رجلينِ عطسا عندَ النَّبيِّ صلَّى اللَّهُ عليْهِ وسلَّمَ فشمَّتَ أحدَهُما ",["ولم يشمِّتِ الآخرَ",2]," فقالَ الَّذي لم يشمِّتْهُ يا رسولَ اللَّهِ شمَّتَّ هذا ولم تُشمِّتني فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّمَ إنَّهُ حمِدَ اللَّهَ ",["وإنَّكَ لم تحمَدِ اللَّهَ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2742) واللفظ له، وأخرجه البخاري (6221)، ومسلم (2991) باختلاف يسير.","bab":"آداب العطاس › العطاس","dorar":"2CkY6LU1"},{"id":"س-00566","fp":"6f1c95375ea0","stateId":453,"easy":"إذا تخلفت عن أهل بيت النبي ﷺ ← هلكت (على رواية)","cause":"ومن تخلَّف عنها","result":"هلك","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"البلدانيات 186","srcLabel":"الطبراني","text":["مثلُ أهلِ بيتي فيكم كمثلِ سفينةِ نوحٍ في قومِ نوحٍ من ركِبها نجا ",["ومن تخلَّف عنها",1]," ",["هلك",2]," ومثلُ بابِ حِطَّةٍ في بني إسرائيلَ"],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"حسن","takhrij":"أخرجه البزار (3900)، والطبراني (3/46) (2637) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (4/197)","bab":"آداب عامة › ضرب الأمثال","dorar":"b8aAxVcZ"},{"id":"س-03753","fp":"ca5fdc43660b","stateId":453,"easy":"إذا أحدثت في الدين بعد النبي ﷺ ← تُذاد عن الحوض: سحقاً سحقاً","cause":"لِمَن غَيَّرَ بَعْدِي","result":"سُحْقًا سُحْقًا","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[57,20],"ref":"المصابيح في الأحاديث المتواترة 637","srcLabel":"السنة","text":["لا تدري ما أحدَثوا بَعدَك [حديث عبدالله بن مسعود: أنا فَرَطُكُمْ علَى الحَوْضِ، ولَيُرْفَعَنَّ مَعِي رِجالٌ مِنكُم ثُمَّ لَيُخْتَلَجُنَّ دُونِي، فأقُولُ: يا رَبِّ أصْحابِي، فيُقالُ: إنَّكَ لا تَدْرِي ما أحْدَثُوا بَعْدَكَ.] [وحديث سهل بن سعد وأبي سعيد الخدري: إنِّي فَرَطُكُمْ علَى الحَوْضِ، مَن مَرَّ عَلَيَّ شَرِبَ، ومَن شَرِبَ لَمْ يَظْمَأْ أبَدًا، لَيَرِدَنَّ عَلَيَّ أقْوامٌ أعْرِفُهُمْ ويَعْرِفُونِي، ثُمَّ يُحالُ بَيْنِي وبيْنَهُمْ. قالَ أبو حازِمٍ: فَسَمِعَنِي النُّعْمانُ بنُ أبِي عَيَّاشٍ، فقالَ: هَكَذا سَمِعْتَ مِن سَهْلٍ؟ فَقُلتُ: نَعَمْ، فقالَ: أشْهَدُ علَى أبِي سَعِيدٍ الخُدْرِيِّ، لَسَمِعْتُهُ وهو يَزِيدُ فيها: فأقُولُ إنَّهُمْ مِنِّي، فيُقالُ: إنَّكَ لا تَدْرِي ما أحْدَثُوا بَعْدَكَ، فأقُولُ: ",["سُحْقًا سُحْقًا",2]," ",["لِمَن غَيَّرَ بَعْدِي",1],".]  [وحديث أنس بن مالك: لَيَرِدَنَّ عَلَيَّ ناسٌ مِن أصْحابِي الحَوْضَ، حتَّى عَرَفْتُهُمُ، اخْتُلِجُوا دُونِي، فأقُولُ: أصْحابِي! فيَقولُ: لا تَدْرِي ما أحْدَثُوا بَعْدَكَ.]                                       [وحديث ابن عباس: قَامَ فِينَا النبيُّ صَلَّى اللهُ عليه وسلَّمَ يَخْطُبُ، فَقالَ: إنَّكُمْ مَحْشُورُونَ حُفَاةً عُرَاةً غُرْلًا: {كما بَدَأْنَا أوَّلَ خَلْقٍ نُعِيدُهُ} [الأنبياء: 104] الآيَةَ، وإنَّ أوَّلَ الخَلَائِقِ يُكْسَى يَومَ القِيَامَةِ إبْرَاهِيمُ، وإنَّه سَيُجَاءُ برِجَالٍ مِن أُمَّتي فيُؤْخَذُ بهِمْ ذَاتَ الشِّمَالِ، فأقُولُ: يا رَبِّ أصْحَابِي، فيَقولُ: إنَّكَ لا تَدْرِي ما أحْدَثُوا بَعْدَكَ، فأقُولُ كما قالَ العَبْدُ الصَّالِحُ: {وَكُنْتُ عليهم شَهِيدًا ما دُمْتُ فيهم} [المائدة: 117]- إلى قَوْلِهِ - {الحَكِيمُ} [البقرة: 32] قالَ: فيُقَالُ: إنَّهُمْ لَمْ يَزَالُوا مُرْتَدِّينَ علَى أعْقَابِهِمْ.] [وحديث أم سلمة: كُنْتُ أَسْمَعُ النَّاسَ يَذْكُرُونَ الحَوْضَ، وَلَمْ أَسْمَعْ ذلكَ مِن رَسولِ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، فَلَمَّا كانَ يَوْمًا مِن ذلكَ، وَالْجَارِيَةُ تَمْشُطُنِي، فَسَمِعْتُ رَسولَ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ يقولُ: أَيُّهَا النَّاسُ، فَقُلتُ لِلْجَارِيَةِ: اسْتَأْخِرِي عَنِّي، قالَتْ: إنَّما دَعَا الرِّجَالَ وَلَمْ يَدْعُ النِّسَاءَ، فَقُلتُ: إنِّي مِنَ النَّاسِ، فَقالَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ: إنِّي لَكُمْ فَرَطٌ علَى الحَوْضِ، فَإِيَّايَ لا يَأْتِيَنَّ أَحَدُكُمْ فيُذَبُّ عَنِّي كما يُذَبُّ البَعِيرُ الضَّالُّ ، فأقُولُ: فِيمَ هذا؟ فيُقَالُ: إنَّكَ لا تَدْرِي ما أَحْدَثُوا بَعْدَكَ، فأقُولُ: سُحْقًا. وفي رِوايَةٍ: كَانَتْ أُمُّ سَلَمَةَ تُحَدِّثُ، أنَّهَا سَمِعَتِ النَّبيَّ صَلَّى اللَّهُ عليه وَسَلَّمَ يقولُ علَى المِنْبَرِ، وَهي تَمْتَشِطُ: أَيُّهَا النَّاسُ، فَقالَتْ لِمَاشِطَتِهَا: كُفِّي رَأْسِي .]"],"grade":"صحيح","narrator":"[عبدالله بن مسعود وسهل بن سعد الساعدي وأبو سعيد الخدري وأنس بن مالك وعبدالله بن عباس وأم سلمة أم المؤمنين]","muhaddith":"متواتر معنى، وقيل: متواتر لفظًا أيضًا","bab":"اعتصام بالسنة › مخالفة السنة","dorar":"djhGMoKW","merged":7,"otherRefs":["تخريج المسند لشعيب 9292 (صحيح)","تخريج المسند لشعيب 11220 (صحيح)","تخريج كتاب السنة 774 (صحيح)","صحيح البخاري 7050 (صحيح)","تخريج المسند لشعيب 22873 (صحيح)","صحيح ابن ماجه 3494 (صحيح)"]},{"id":"س-05170","fp":"932daf7035a8","stateId":453,"easy":"إذا اشتهرت بالمبالغة في العبادة ← فلا تعدّوه (يُخشى عليه)","cause":"وإِنْ أُشيرَ إليهِ بالأصابِعِ","result":"فلا تَعُدُّوهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الجامع 2151","srcLabel":"الترمذي","text":["إِنَّ لِكُلِّ شيءٍ شِرَّةً ، ولكلِّ شِرَّةٍ فَتْرَةً ، فإِنْ صاحبُها سدَّدَ و قارَبَ ، فارجوه ، ",["وإِنْ أُشيرَ إليهِ بالأصابِعِ",1]," ، ",["فلا تَعُدُّوهُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2453)، والطحاوي في ((شرح مشكل الآثار)) (1242)، وابن حبان (349) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"6n4oq09l","merged":3,"otherRefs":["تخريج مشكل الآثار 1242 (حسن)","صحيح الترغيب 57 (صحيح)"]},{"id":"س-00647","fp":"db2a36d04f31","stateId":453,"easy":"إذا شددت على نفسك في العبادة ← فالمنبتّ لا أرضاً قطع ولا ظهراً أبقى","cause":"فإنَّ المُنبَتَّ","result":"لم يقطَعْ سَفَرًا، ولم يُبْقِ ظَهرًا","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"علل الدارقطني 3693","srcLabel":"السنة","text":["إنَّ هذا الدِّينَ مَتينٌ فأوغِلوا فيه برِفقٍ، ولا تُبَغِّضوا إلى أنفُسِكم عبادةَ اللهِ؛ ",["فإنَّ المُنبَتَّ",1]," ",["لم يقطَعْ سَفَرًا، ولم يُبْقِ ظَهرًا",2]],"grade":"صحيح","narrator":"عائشة","muhaddith":"[حكى فيه الخلافَ على محَمَّدِ بنِ سوقةَ، ثمَّ قال]: ليس فيها حديثٌ ثابتٌ","bab":"آداب عامة › ضرب الأمثال","dorar":"m31EStUN","merged":2,"otherRefs":["المقاصد الحسنة 458 (صحيح)"]},{"id":"س-01329","fp":"08cee34abeb1","stateId":453,"easy":"إذا أطاع الرجال النساء (في الباطل) ← هلكوا","cause":"حين أطاعت النِّساءَ","result":"هلكتِ الرجالُ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"الجامع الصغير 9577","srcLabel":"أحمد","text":[["هلكتِ الرجالُ",2]," ",["حين أطاعت النِّساءَ",1],"."],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (425)، والحاكم (7789)، وابن عدي في ((الكامل في الضعفاء)) (2/218) جميعا بلفظه، وأحمد (20455) بلفظ مقارب، وجميعا مطولا.","bab":"نكاح › عشرة النساء","dorar":"NnFj6cL3"},{"id":"س-01888","fp":"d6202e542644","stateId":453,"easy":"إذا حُرمت خير ليلة القدر ← فقد حُرمت الخير كله","cause":"من حُرِمَها","result":"فقد حُرِمَ الخيرَ كُلَّهُ ولا يُحرَمُ خيرَها إلَّا محرومٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-02511","ref":"صحيح ابن ماجه 1341","text":["دخلَ رمضانُ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ إنَّ هذا الشَّهرَ قَد حضرَكُم وفيهِ ليلةٌ خيرٌ مِن ألفِ شَهْرٍ ",["من حُرِمَها",1]," ",["فقد حُرِمَ الخيرَ كُلَّهُ ولا يُحرَمُ خيرَها إلَّا محرومٌ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"حسن صحيح","takhrij":"أخرجه ابن ماجه (1644) واللفظ له، والقطيعي في ((جزء الألف دينار)) (299)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"YXPeNR1N"},{"id":"س-01950","fp":"d8ac5063c44e","stateId":453,"easy":"إذا وسّع الله عليك ثم لم تفد إلى البيت خمسة أعوام ← فأنت محروم","cause":"يمضي عليه خمسةُ أعوامٍ لا يفِدُ إليَّ","result":"لَمحرومٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"صحيح ابن حبان 3703","srcLabel":"البيهقي","text":["أنَّ الرَّسولَ صلَّى اللهُ عليه وسلَّم قال: ( قال اللهُ: إنَّ عبدًا صحَّحْتُ له جسمَه ووسَّعْتُ عليه في المعيشةِ ",["يمضي عليه خمسةُ أعوامٍ لا يفِدُ إليَّ",1]," ",["لَمحرومٌ",2]," )"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو يعلى (1031)، وابن عدي في ((الكامل في الضعفاء)) (3/63)، والبيهقي في ((شعب الإيمان)) (3838) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"oOQATYNE"},{"id":"س-06967","fp":"31cacc7a6aae","stateId":453,"easy":"إذا كنت بغياً أو عشّاراً ← لا يُغفر لك وإن استغفرت","cause":"لبغِّيٍّ بفرجهِا أو عشَّارٍ","result":"فيغفرُ لمن يستغفرُ إلا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الترغيب والترهيب 2/28","srcLabel":"الطبراني","text":["إنَّ اللهَ تعالَى يدنو من خلقِه ",["فيغفرُ لمن يستغفرُ إلا",2]," ",["لبغِّيٍّ بفرجهِا أو عشَّارٍ",1]],"grade":"صحيح","narrator":"عثمان بن أبي العاص الثقفي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني (9/ 54) (8371) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (ص104)، وابن قانع في ((معجم الصحابة)) (2/ 388) كلاهما باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"WCtsG8vl"},{"id":"س-07107","fp":"81373714b1c0","stateId":453,"easy":"إذا فرّطت في شعائر الإسلام ← فهي الهلكة (أثر)","cause":"تفريطِها","result":"الهلكةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"فتح الباري لابن رجب 3/30","srcLabel":"المروزي","text":["نُبئْتُ أن أبا بكرٍ وعمرَ – رضي اللهُ عنهما – كانا يعلمانِ الناسَ الإسلامُ : تعبدُ اللهَ ولا تشركُ به شيئًا ، وتقيمُ الصلاةَ التي افترضَ اللهُ لمواقيتِها ، فإنَّ في ",["تفريطِها",1]," ",["الهلكةَ",2]," ."],"grade":"صحيح","narrator":"محمد بن سيرين","muhaddith":"إسناده صحيح","takhrij":"أخرجه المروزي في ((تعظيم قدر الصلاة)) (395) واللفظ له، ومعمر بن راشد (20683)، والعدني في ((الإيمان)) (48) بنحوه مطولا، وعبد الرزاق (5013) مختصرا.","bab":"علم › تعليم الناس وفضل ذلك","dorar":"dNHF8QDx"},{"id":"س-01283","fp":"e8dafd8d2cec","stateId":453,"easy":"إذا عشت بلا زوجة ← فأنت مسكين وإن كثر مالك","cause":"رجلٌ ليسَ لَهُ امرأةٌ وإنْ كان كثيرَ المالِ","result":"مسكينٌ مسكينٌ مسكينٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"مجمع الزوائد 4/255","srcLabel":"الطبراني","text":[["مسكينٌ مسكينٌ مسكينٌ",2]," ",["رجلٌ ليسَ لَهُ امرأةٌ وإنْ كان كثيرَ المالِ",1]," مسكينةٌ مسكينةٌ مسكينةٌ امرأةٌ ليسَ لها زوجٌ وإن كانتْ كثيرةَ المالِ"],"grade":"حسن","narrator":"أبو نجيح يسار المكي","muhaddith":"رجاله ثقات إلا أن أبا نجيح لا صحبة له","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6589) واللفظ له، وأخرجه سعيد بن منصور في ((السنن)) (488)، والبيهقي في ((شعب الإيمان)) (5097) باختلاف يسير","bab":"نكاح › الحث على التزويج","dorar":"0tznxfgg"},{"id":"س-01284","fp":"e990d5fc3c5d","stateId":453,"easy":"إذا عاشت المرأة بلا زوج ← فهي مسكينة وإن كثر مالها","cause":"امرأةٌ ليسَ لها زوجٌ وإن كانتْ كثيرةَ المالِ","result":"مسكينةٌ مسكينةٌ مسكينةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"مجمع الزوائد 4/255","srcLabel":"الطبراني","text":["مسكينٌ مسكينٌ مسكينٌ رجلٌ ليسَ لَهُ امرأةٌ وإنْ كان كثيرَ المالِ ",["مسكينةٌ مسكينةٌ مسكينةٌ",2]," ",["امرأةٌ ليسَ لها زوجٌ وإن كانتْ كثيرةَ المالِ",1]],"grade":"حسن","narrator":"أبو نجيح يسار المكي","muhaddith":"رجاله ثقات إلا أن أبا نجيح لا صحبة له","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6589) واللفظ له، وأخرجه سعيد بن منصور في ((السنن)) (488)، والبيهقي في ((شعب الإيمان)) (5097) باختلاف يسير","bab":"نكاح › الحث على التزويج","dorar":"0tznxfgg"},{"id":"س-07782","fp":"3e716ea0622e","stateId":453,"easy":"إذا خرجت إلى البادية وتركت الجمعات ← فهو مما خافه النبي ﷺ على أمته","cause":"فيَخرُجونَ مِنَ الجَماعاتِ، ويَتْرُكونَ الجُمُعاتِ","result":"إنَّما أَخافُ على أُمَّتي الكِتابَ واللَّبَنَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشعيب 17318","srcLabel":"أحمد","text":[["إنَّما أَخافُ على أُمَّتي الكِتابَ واللَّبَنَ",2],". قال: قيل: يا رسولَ اللهِ، ما بالُ الكِتابِ؟ قال: يَتعلَّمُه المُنافِقونَ ثمَّ يُجادِلونَ به الذين آمَنوا. فقيل: وما بالُ اللَّبَنِ؟ قال: أُناسٌ يُحِبُّونَ اللَّبَنَ، ",["فيَخرُجونَ مِنَ الجَماعاتِ، ويَتْرُكونَ الجُمُعاتِ",1],"."],"grade":"حسن","narrator":"عقبة بن عامر","muhaddith":"حسن","takhrij":"أخرجه أحمد (17318) واللفظ له، وأبو يعلى (1746)، والطبراني (17/296) (816)","bab":"قرآن › النهي عن اتباع متشابه القرآن والاختلاف فيه","dorar":"qqhj7Eht"},{"id":"س-06671","fp":"9f09a0abf771","stateId":454,"easy":"إذا تأخرت عن الصفوف الأولى ← يؤخرك الله","cause":"لا يزالُ أقوامٌ يتأخَّرونَ","result":"حتَّى يؤخِّرَهُمُ اللَّهُ عزَّ وجلَّ","explicit":true,"star":true,"otherNeedIds":[57],"ref":"صحيح ابن خزيمة 3/ 77","srcLabel":"مسلم","text":["دخلَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ، فرأى ناسًا في مؤخَّرِ المسجِدِ، فقالَ: ما يؤخِّرُكُم؟ ",["لا يزالُ أقوامٌ يتأخَّرونَ",1]," ",["حتَّى يؤخِّرَهُمُ اللَّهُ عزَّ وجلَّ",2],"، تقدَّموا فأْتَمُّوا بي، وليأتمَّ بِكُم مَن بعدَكُم"],"grade":"صحيح","narrator":"أبو سعيد","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (438)، والنسائي (795)، وعبد بن حميد (872) باختلاف يسير.","bab":"صلاة الجماعة والإمامة › إقامة الصفوف ووصلها وفضائلها","dorar":"iJe4Qo3X","merged":6,"otherRefs":["صحيح ابن حبان 2156 (صحيح)","صحيح ابن خزيمة 3/ 77 (صحيح)","صحيح أبي داود 679 (صحيح)","مجموع فتاوى ابن باز 103/16 (حسن)","صحيح النسائي 794 (صحيح)"]},{"id":"س-07411","fp":"12bfbef453ba","stateId":454,"easy":"إذا فاتتك صلاة العصر ← فكأنما فقدت أهلك ومالك","cause":"صَلاةٌ مَن فاتَتْه","result":"فكَأنَّما وُتِرَ أهلَه ومالَه","explicit":true,"star":true,"similar":["س-05087"],"ref":"صحيح مسلم 2886","srcLabel":"متفق عليه","text":["سَتَكونُ فِتَنٌ القاعِدُ فيها خَيرٌ مِنَ القائِمِ، والقائِمُ فيها خَيرٌ مِنَ الماشي، والماشي فيها خَيرٌ مِنَ السَّاعي، مَن تَشَرَّفَ لها تَستَشرِفُه، ومَن وجَدَ فيها مَلجَأً فليَعُذْ بهِ. وفي روايةٍ: مِثلَ حَديثِ أبي هُرَيرةَ هذا. إلَّا أنَّ أبا بَكرٍ يَزيدُ: مِنَ الصَّلاةِ ",["صَلاةٌ مَن فاتَتْه",1]," ",["فكَأنَّما وُتِرَ أهلَه ومالَه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3601)، ومسلم (2886).","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"ptZVWPxz","merged":4,"otherRefs":["صحيح النسائي 477 (صحيح)","صحيح الموارد 245 (صحيح)","صحيح النسائي 479 (صحيح)"]},{"id":"س-05080","fp":"6b7bbd75a05c","stateId":454,"easy":"إذا تركت العصر حتى تفوتك ← فكأنما فقدت أهلك ومالك","cause":"مَن تَرَكَ العَصرَ حتى تَفوتَه","result":"فكأنَّما وُتِرَ أهْلَه ومالَه","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 5455","srcLabel":"متفق عليه","text":[["مَن تَرَكَ العَصرَ حتى تَفوتَه، ",1],["فكأنَّما وُتِرَ أهْلَه ومالَه",2],". وقال شَيْبانُ: يعني: غُلِبَ على أهْلِه ومالِه."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (552)، ومسلم (626)، وأبو داود (414)، والترمذي (175)، والنسائي (478)، وأحمد (5455) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ebK3JCFg","merged":2,"otherRefs":["تخريج المسند لشعيب 4805 (صحيح)"]},{"id":"س-05087","fp":"0e81eea6ca09","stateId":454,"easy":"إذا فاتتك صلاة العصر ← فكأنما فقدت أهلك ومالك","cause":"إنَّ الَّذي تَفوتُه صَلاةُ العَصرِ","result":"فكأنَّما وُتِرَ أهْلَه ومالَه","explicit":true,"repOf":"س-07411","ref":"تخريج المسند لشعيب 6358","text":[["إنَّ الَّذي تَفوتُه صَلاةُ العَصرِ",1],"، ",["فكأنَّما وُتِرَ أهْلَه ومالَه",2],"، قُلتُ لِنافِعٍ: حتى تَغيبَ الشَّمسُ، قال: نَعَمْ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (552)، ومسلم (626)، وأبو داود (414)، والترمذي (175)، والنسائي (478)، وأحمد (6358) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"QZjprVcd"},{"id":"س-06447","fp":"ccdf22b06200","stateId":454,"easy":"إذا لم تفصل بين الصلوات ← فبذلك هلك أهل الكتاب","cause":"أنَّه لم يَكُن بيْنَ صَلَواتِهم فَصلٌ","result":"فإنَّه لم يَهلِكْ أهلُ الكِتابِ إلَّا","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 1011","srcLabel":"مسلم","text":["عن الأزرقِ بنِ قَيسٍ، قال: صَلَّى بِنا إمامٌ لنا يُكْنَى أبا رِمْثةَ، قالَ: صَلَّيتُ هذه الصَّلاةَ -أو مِثلَ هذه الصَّلاةِ- مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، قالَ: وكان أبو بَكرٍ وعُمَرُ رَضيَ اللهُ عنهما يَقومانِ في الصَّفِّ المُقَدَّمِ، عنْ يَمينِه، وكان رَجُلٌ قد شَهِدَ التَّكبيرةَ الأُولى منَ الصَّلاةِ، فصَلَّى نَبِيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ ثمَّ سَلَّم، عنْ يَمينِه وعنْ يَسارِه، حتَّى رَأينا بَياضَ خَدِّه، ثمَّ انفَتَل كانفِتالِ أبي رِمثةَ -يعني: نَفْسَه-، فقام الرَّجُلُ الَّذي أدرَكَ معه التَّكبيرةَ الأُولى منَ الصَّلاةِ يَشفَعُ، فوَثَب إليه عُمَرُ فأخَذَ بمَنكِبِه فهَزَّهُ، ثمَّ قالَ: اجلِسْ! ",["فإنَّه لم يَهلِكْ أهلُ الكِتابِ إلَّا",2]," ",["أنَّه لم يَكُن بيْنَ صَلَواتِهم فَصلٌ",1],"، فرَفَع النَّبيُّ صلَّى اللهُ عليه وسلَّمَ بَصَرَه، فقالَ: أصابَ اللهُ بكَ يا ابنَ الخَطَّابِ."],"grade":"صحيح","narrator":"أبو رمثة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أبو داود (1007)، والبيهقي (3088) واللفظ لهما، والطبراني في ((الأوسط)) (6903) مختصرًا.","bab":"صلاة › صفة صلاة النبي صلى الله عليه وسلم","dorar":"zXjN0zQJ"},{"id":"س-03258","fp":"cca6e31bfcba","stateId":454,"easy":"إذا أدركت رمضان فلم يُغفر لك ← أبعدك الله","cause":"مَنْ أَدْرَكَ رَمَضَانَ فلمْ يُغْفَرْ لهُ","result":"فَأَبْعَدَهُ اللهُ","explicit":true,"ref":"صحيح الموارد 2024","srcLabel":"ابن حبان","text":["صَعِدَ رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ المِنْبَرَ فلمَّا رَقِيَ عَتَبَةً قال : آمِينَ ، ثُمَّ رَقِيَ [ عَتَبَةً ] أُخْرَى فقال : آمِينَ ، ثُمَّ رَقِيَ عَتَبَةً ثَالِثَةً فقال : آمِينَ ، ثُمَّ قال : أتاني جبريلُ فقال : يا محمدُ ! ",["مَنْ أَدْرَكَ رَمَضَانَ فلمْ يُغْفَرْ لهُ ؛ ",1],["فَأَبْعَدَهُ اللهُ ",2],"، فقُلْتُ : آمِينَ ! قال : ومَنْ أَدْرَكَ والدَيْهِ أوْ أحدَهُما، فَدخلَ النارَ ؛ فَأَبْعَدَهُ اللهُ ، فقُلْتُ : آمِينَ ! [ ف ] قال : ومَنْ ذُكِرْتَ عندَهُ فلمْ يُصَلِّ عليكَ ؛ فَأَبْعَدَهُ اللهُ ، قُلْ : آمِينَ ، فقُلْتُ : آمِينَ !"],"grade":"صحيح","narrator":"مالك بن الحويرث","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن حبان (409) واللفظ له، والطبراني (19/291) (649)، وابن عدي في ((الكامل في الضعفاء)) (6/381)","bab":"استغفار › أسباب المغفرة","dorar":"DBefBLRN","merged":3,"otherRefs":["الترغيب والترهيب 2/118 (صحيح)","صحيح الأدب المفرد 500 (صحيح)"]},{"id":"س-07546","fp":"d5f31e704158","stateId":454,"easy":"إذا كان دينك بلا ركوع (صلاة) ← فلا خير فيه","cause":"دينٍ ليس فيه ركوعٌ","result":"ولا خيرَ في","explicit":true,"ref":"تخريج سنن أبي داود 3026","srcLabel":"أبو داود","text":["أنَّ وفْدَ ثقيفٍ لمَّا قَدِموا على رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أنزَلَهم المسجدَ؛ ليكونَ أرَقَّ لقلوبِهم، فاشترَطوا عليه ألَّا يُحْشَروا، ولا يُعْشَروا ولا يُجَبُّوا، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: لكم ألَّا تُحشَروا ولا تُعشَروا، ",["ولا خيرَ في",2]," ",["دينٍ ليس فيه ركوعٌ",1],"."],"grade":"صحيح","narrator":"عثمان بن أبي العاص الثقفي","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (3026) واللفظ له، وأحمد (17913)، وابن الجارود (410)، والطبراني  (9/ 54) (8372) جميعا باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › حسن شمائله ووفاء عهده صلى الله عليه وسلم","dorar":"7P3623Xv","merged":2,"otherRefs":["العواصم والقواصم 2/213 (صحيح)"]},{"id":"س-03037","fp":"2c1390b94ee2","stateId":454,"easy":"إذا أدركت رمضان فلم يُغفر لك ← بعُدت","cause":"مَن أدرَكَ رمَضانَ فلَمْ يُغْفَرْ له","result":"بَعُدَ","explicit":true,"ref":"المستدرك على الصحيحين 7462","srcLabel":"مالك","text":["قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: احضُرُوا المِنْبَرَ، فحضَرْنا، فلمَّا ارتَقى درَجةً قالَ: آمِين، فلمَّا ارتَقَى الدَّرَجةَ الثَّانِيةَ قالَ: آمِينَ، فلمَّا ارتقَى الدَّرَجةَ الثَّالثةَ قالَ: آمِينَ، فلمَّا نزَلَ قُلْنا: يا رسولَ اللهِ، لقَدْ سَمِعْنا منكَ اليومَ شيئًا ما كُنَّا نَسمَعُه، قالَ: إنَّ جِبريلَ عليهِ السَّلامُ عرَضَ لي فقال: بَعُدَ ",["مَن أدرَكَ رمَضانَ فلَمْ يُغْفَرْ له",1],"، قلْتُ: آمِينَ، فلمَّا رَقِيتُ الثَّانيةَ، قالَ: ",["بَعُدَ",2]," مَن ذُكِرْتَ عندَهُ، فلمْ يُصَلِّ عليكَ، قلْتُ: آمِينَ، فلمَّا رَقِيتُ الثَّالثةَ قالَ: بَعُدَ مَن أدْركَ أبويهِ الكِبَرُ عندَهُ أو أحدَهُما، فلمْ يُدْخِلاهُ الجنَّةَ، قلْتُ: آمِينَ."],"grade":"صحيح","narrator":"كعب بن عجرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني (19/ 144) (315)، والقاضي إسماعيل المالكي في ((فضل الصلاة على النبي)) (19)، وابن شاهين في ((فضائل رمضان)) (ص131) بلفظ قريب.","bab":"إيمان › الوعيد","dorar":"jaa1VQvy"},{"id":"س-06432","fp":"41d81b2eb324","stateId":454,"easy":"إذا تركت صلاة واحدة سكراً ← فكأنما كانت لك الدنيا فسُلبتها","cause":"مَن ترَك الصلاةَ سُكْرًا مرَّةً واحِدَةً","result":"فكأنَّما كانَتْ له الدُّنيا وما عليها فسَلَبَها","explicit":true,"ref":"تخريج المسند لشاكر 10/143","srcLabel":"أحمد","text":[["مَن ترَك الصلاةَ سُكْرًا مرَّةً واحِدَةً ",1],["فكأنَّما كانَتْ له الدُّنيا وما عليها فسَلَبَها ",2],"ومَن ترَك الصلاةَ سُكْرًا أربعَ مرَّاتٍ كان حقًّا على اللهِ عزَّ وجَلَّ أنْ يَسقِيَه مِن طِينَةِ الخَبالِ قيل وما طِينَةُ الخَبالِ يا رسولَ اللهِ قال عُصارَةُ أهلِ جَهَنَّمَ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6659)، والحاكم (7233) واللفظ لهما، والطبراني في ((المعجم الأوسط)) (6371) باختلاف يسير.","bab":"صلاة › تارك الصلاة","dorar":"EATgevil"},{"id":"س-06551","fp":"3177e4916edf","stateId":454,"easy":"إذا اتبعت الشهوات وضيعت الصلوات ← تهلك","cause":"قَوْمٌ يَتَّبِعونَ الشَّهَواتِ، ويُضَيِّعونَ الصَّلَواتِ","result":"سيَهلِكُ مِن أُمَّتي أهْلُ الكِتابِ، وأهْلُ اللبن","explicit":true,"ref":"الصحيح المسند 944","srcLabel":"الحاكم","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ قالَ: «",["سيَهلِكُ مِن أُمَّتي أهْلُ الكِتابِ، وأهْلُ [اللبن",2],"]»، فقالَ عُقْبةُ: يا رَسولَ اللهِ، وما أهْلُ الكِتابِ؟ قالَ: «قَوْمٌ يَتَعلَّمونَ كِتابَ اللهِ لِيُجادِلوا الَّذين آمَنوا»، فقالَ عُقْبةُ: يا رَسولَ اللهِ، وما أهْلُ [اللبن]؟ قالَ: «",["قَوْمٌ يَتَّبِعونَ الشَّهَواتِ، ويُضَيِّعونَ الصَّلَواتِ",1],"»، قالَ أبو قَبيلٍ: لا أَحسَبُ المُكَذِّبينَ بالقَدَرِ إلَّا الَّذين يُجادِلونَ الَّذين آمَنوا، وأمَّا أهْلُ اللبن فلا أَحسَبُهم إلَّا أهْلَ العَمودِ، ليس عليهم إمامُ جَماعةٍ، ولا يَعرِفونَ شَهْرَ رَمَضانَ."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه الروياني في ((المسند)) (240)، والطبري في ((التفسير)) (20/ 361)، والحاكم (3417)، والبيهقي في ((شعب الإيمان)) (2964) واللفظ لهم.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"4QEExsVP"},{"id":"س-06558","fp":"7b6e6bcacd7f","stateId":454,"easy":"إذا لم تحافظ على الصلوات ← فليس لك عهد عند الله إن شاء عذبك وإن شاء غفر لك","cause":"ومن لم يحافظ عليهنَّ","result":"لم يكن له عهدٌ عند اللهِ ، إن شاء عذَّبَه ، وإن شاء غفرَ له","explicit":true,"otherNeedIds":[57],"ref":"حكم تارك الصلاة 46","srcLabel":"أبو داود","text":["خمسُ صلواتٍ كتبهنَّ اللهُ على العبادِ في اليومِ والليلةِ ، من حافظ عليهنَّ : كان له عهدٌ عند اللهِ أن يُدْخِلَه الجنةَ ، ",["ومن لم يحافظ عليهنَّ",1]," : ",["لم يكن له عهدٌ عند اللهِ ، إن شاء عذَّبَه ، وإن شاء غفرَ له",2]],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (425)، والنسائي (461)، وابن ماجه (1401)، وأحمد (22756) بنحوه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"7g4sE3mF"},{"id":"س-03333","fp":"ff89c710371e","stateId":454,"easy":"إذا حُرمت رحمة الله في رمضان ← فأنت الشقي","cause":"من حُرم فيه رحمةَ اللهِ","result":"فإنَّ الشَّقِيَّ","explicit":true,"ref":"الترغيب والترهيب 2/117","srcLabel":"الطبراني","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال يومًا وحضر رمضانُ أتاكم رمضانُ شهرُ بركةٍ يغشاكم اللهُ فيه فيُنزِلُ الرَّحمةَ ويحُطُّ الخطايا ويستجيبُ فيه الدُّعاءَ ينظرُ اللهُ تعالَى إلى تنافُسِكم فيه ويُباهي بكم ملائكتَه فأروا اللهَ من أنفسِكم خيرًا ",["فإنَّ الشَّقِيَّ",2]," ",["من حُرم فيه رحمةَ اللهِ",1]," عزَّ وجلَّ"],"grade":"حسن","narrator":"عبادة بن الصامت","muhaddith":"رواته ثقات إلا أن محمد بن قيس لا يحضرني فيه جرح ولا تعديل","takhrij":"أخرجه الشاشي في ((المسند)) (1224)، والطبراني في ((مسند الشاميين)) (2238) واللفظ لهما.","bab":"استغفار › أسباب المغفرة","dorar":"JZF6aUMP"},{"id":"س-03288","fp":"589e90e519c5","stateId":454,"easy":"إذا كانت بينك وبين أخيك شحناء ← تُؤخّر مغفرتك حتى تصطلحا","cause":"امرَأً كانَت بينَه وبينَ أخيه شَحناءُ","result":"فيُقالُ: اركوا هَذَينِ حتَّى يَصطَلِحا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح مسلم 2565","srcLabel":"متفق عليه","text":["تُعرَضُ الأعمالُ في كُلِّ يَومِ خَميسٍ واثنَينِ، فيَغفِرُ اللهُ عزَّ وجلَّ في ذلك اليَومِ لكُلِّ امرِئٍ لا يُشرِكُ باللهِ شيئًا، إلَّا ",["امرَأً كانَت بينَه وبينَ أخيه شَحناءُ",1],"، ",["فيُقالُ: اركوا هَذَينِ حتَّى يَصطَلِحا",2],"، اركوا هَذَينِ حتَّى يَصطَلِحا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"استغفار › أسباب المغفرة","dorar":"0Kc6k1Dr","merged":3,"otherRefs":["تخريج شرح السنة 3524 (حسن)","مجمع الزوائد 8/69 (حسن)"]},{"id":"س-03379","fp":"dc78f0f36eaf","stateId":454,"easy":"إذا هجرت أخاك ← تُؤخّر مغفرتك حتى تصطلحا","cause":"إلَّا المُهتَجِرَينِ","result":"أنظِروا هَذَينِ حتَّى يَصطَلِحا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح مسلم 2565","srcLabel":"متفق عليه","text":["تُفتَحُ أبوابُ الجَنَّةِ يَومَ الاثنَينِ، ويَومَ الخَميسِ، فيُغفَرُ لكُلِّ عَبدٍ لا يُشرِكُ باللهِ شيئًا، إلَّا رَجُلًا كانَت بينَه وبينَ أخيه شَحناءُ، فيُقالُ: ",["أنظِروا هَذَينِ حتَّى يَصطَلِحا",2],"، أنظِروا هَذَينِ حتَّى يَصطَلِحا، أنظِروا هَذَينِ حتَّى يَصطَلِحا. [وفي روايةٍ]: ",["إلَّا المُهتَجِرَينِ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"استغفار › أسباب المغفرة","dorar":"hbubemo1","merged":3,"otherRefs":["صحيح الترمذي 2023 (صحيح)","هداية الرواة 2015 (صحيح)"]},{"id":"س-06718","fp":"10a4cde5b5f7","stateId":454,"easy":"إذا لم تقل «آمين» خلف الإمام ← فاتك الأجر كمن غزا ولم يخرج سهمه","cause":"ومن لم يقُل آمينَ","result":"كمثَلِ رجلٍ غزا معَ قومٍ فاقترَعوا سِهامُهم ولم يخرُجْ سَهمَهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"الدر المنثور 1/89","srcLabel":"متفق عليه","text":["إذا قالَ الإمام:  غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ  قالَ: الَّذينَ خلفَهُ آمينَ التقَت من أَهلِ السَّماءِ وَ أَهلِ الأرضِ ",["ومن لم يقُل آمينَ",1]," ",["كمثَلِ رجلٍ غزا معَ قومٍ فاقترَعوا سِهامُهم ولم يخرُجْ سَهمَهُ",2],"، فقالَ: ما لِسَهمي لم يخرُجْ، قالَ: إنَّكَ لم تقُلْ آمينَ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده جيد","takhrij":"أخرجه أبو يعلى في ((مسنده)) (6411) واللفظ له، والبخاري (749)، ومسلم (410) كلاهما بمعناه.","bab":"صلاة الجماعة والإمامة › فضل صلاة الجماعة","dorar":"XKvFbfZu"},{"id":"س-03268","fp":"12d4b396eb35","stateId":454,"easy":"إذا كنت مشاحناً أو قاتل نفس ← لا يُغفر لك ليلة النصف","cause":"مُشاحنٍ ، وقاتلِ نفسٍ","result":"فيغفِرُ لعبادِهِ إلَّا لاثنينِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشاكر 10/127","srcLabel":"أحمد","text":["يطَّلعُ اللَّهُ عزَّ وجلَّ إلى خلقِهِ ليلةَ النِّصفِ مِن شعبانَ ",["فيغفِرُ لعبادِهِ إلَّا لاثنينِ",2]," : ",["مُشاحنٍ ، وقاتلِ نفسٍ",1]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6642)، والشجري في ((الأمالي)) (1539)","bab":"استغفار › أسباب المغفرة","dorar":"Ub54Ksnv"}]}