{"schema":1,"kind":"sunan-chunk","version":"sunan-c56d7b8d0f22","needId":50,"stateIds":[534,535,536,537,538,539],"items":[{"id":"س-06379","fp":"53087502fdb1","stateId":534,"easy":"إذا سننت في الإسلام سنة حسنة ← لك أجرها ومثل أجر من عمل بها بعدك","cause":"مَن سنَّ في الإسلامِ سُنَّةً حَسنةً","result":"فلَه أجرُها، و[ مثلُ ] أجرِ مَن عمِلَ بِها بعدَهُ، مِن غيرِ أن ينقُصَ مِن أجورِهم شيءٌ","explicit":true,"star":true,"similar":["س-02348","س-08065"],"otherNeedIds":[45,49],"ref":"أحكام الجنائز 225","srcLabel":"مسلم","text":["كنَّا عندَ رسولِ اللهِ صلَّى اللهُ علَيهِ وسلَّمَ في صدرِ النَّهار، فجاءَه أقوُمٌ حُفاةٌ عُراةٌ مُجتابي النِّمارِ أوِ العَباءِ، متقلِّدي السُّيوفِ ، [ ولَيس عليهِم أُزُرٌ ولا شَيءٌ غيرَها ] عامَّتُهم من مُضَر، بل كلُّهُم مِن مُضَرَ فتمعَّرَ ( وفي روايةٍ : فتغيَّرَ ومعناهُما واحِدٌ ) وجهُ رسولِ اللهِ صلَّى اللهُ علَيهِ وسلَّمَ لما رأى بِهم منَ الفاقةِ، فدخلَ ثمَّ خرجَ، فأمرَ بلالًا فأذَّنَ وصلَّى [ الظُّهرَ ، ثم صعِدَ منبرًا صغيرًا ] ، فصلَّى ثمَّ خطبَ [ فحمِدَ اللهَ وأثنَى علَيهِ ] فقال : [ أمَّا بعدُ فإنَّ اللهَ أنزلَ في كتابِهِ ] :  يَا أَيُّهَا النَّاسُ اتَّقُوا رَبَّكُمُ الَّذِي خَلَقَكُمْ مِنْ نَفْسٍ وَاحِدَةٍ وَخَلَقَ مِنْهَا زَوْجَهَا وَبَثَّ مِنْهُمَا رِجَالًا كَثِيرًا وَنِسَاءً وَاتَّقُوا اللَّهَ الَّذِي تَسَاءَلُونَ بهِ وَالْأَرْحَامَ إِنَّ اللَّهَ كَانَ عَلَيْكُمْ رَقِيبًا والآيةُ الَّتي في الحَشرِ  يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَلْتَنْظُرْ نَفْسٌ مَا قَدَّمَتْ لِغَدٍ وَاتَّقُوا اللَّهَ إِنَّ اللَّهَ خَبِيرٌ بِمَا تَعْمَلُونَ . [وَلَا تَكُونُوا كَالَّذِينَ نَسُوا اللَّهَ فَأَنْسَاهُمْ أَنْفُسَهُمْ أُولَئِكَ هُمُ الْفَاسِقُونَ . لَا يَسْتَوِي أَصْحَابُ النَّارِ وَأَصْحَابُ الْجَنَّةِ أَصْحَابُ الْجَنَّةِ هُمُ الْفَائِزُونَ . تصدَّقوا قبلَ أن يُحالَ بينَكُم وبينَ الصَّدَقةِ ] ، تصدَّقَ رجلٌ من دينارِه، من درهمِه، من ثَوبِه، من صاعِ برِّهِ ، [ مِن شعيرِهِ ] ، مِن صاعِ تمرِه حتَّى قالَ : [ ولا يحقِرَنَّ أحدُكُم شيئًا من الصَّدَقةِ ، ولَو بِشقِّ تمرةٍ ، [ فأبطَؤوا حتَّى بانَ في وجهِهِ الغضَبُ ] ، قال فجاءَ رجلٌ منَ الأنصارِ بصُرَّةٍ من وَرِق ( وفي روايةٍ : مِن ذهَبٍ ) كادَت كفُّهُ تعجِزُ عنها، بل قد عَجَزَت [ فناولَها رسولَ اللهِ صلَّى اللهُ علَيهِ وسلَّمَ وهو علَى مِنبرِهِ ] ، [ فقال : يا رسولَ اللهِ هذِهِ في سبيلِ اللَّهِ ] ، [ فقبضَها رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ ] ، [ ثمَّ قامَ أبو بكرٍ فأعطى ، ثمَّ قامَ عمرُ فأَعطى ، ثم قامَ المهاجِرونَ والأنصارُ فأعطَوا ] ، ثم تتابعَ النَّاسُ [ في الصَّدقاتِ ] ، [ فمِن ذي دينارٍ ، ومِن ذي درهَمٍ ، ومِن ذي ، ومِن ذي ] حتَّى رأيتُ كَومينِ من طَعامٍ وثيابٍ، حتَّى رأيتُ وجهَ رسولِ اللهِ صلَّى اللهُ علَيهِ وسلَّمَ يتَهلَّلُ، كأنَّهُ مُذهبةٌ، فقالَ رسولُ اللهِ صلَّى اللهُ علَيهِ وسلَّمَ: ",["مَن سنَّ في الإسلامِ سُنَّةً حَسنةً، ",1],["فلَه أجرُها، و[ مثلُ ] أجرِ مَن عمِلَ بِها بعدَهُ، مِن غيرِ أن ينقُصَ مِن أجورِهم شيءٌ",2],"، ومَن سنَّ في الإسلامِ سَيِّئةً، كانَ علَيهِ وزرُها ، و [ مِثلُ ] وِزرِ مَن عمِلَ بِها من بعدِه، من غيرِ أن ينقُصَ مِن أوزارِهم شيءٌ ، [ ثمَّ تلى هذِه الآيةَ :  وَنَكتُبُ مَا قَدَّمُوا وَآثَارَهُمْ ] ، [ قال : فقسَمهُ بينَهُم ] ."],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"أخرجه مسلم وابن أبي حاتم والزيادة التي قبل الأخيرة له، وإسنادها صحيح، وللترمذي وصححه الجملتان اللتان قبل الزيادة المشار إليها مع الزيادتين فيهما","takhrij":"أخرجه مسلم (1017)، والنسائي (2554)، وأحمد (19174)، والطيالسي (705)، والبيهقي (7816 )   .","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"VSNRsPPW","merged":3,"otherRefs":["صحيح مسلم 1017 (صحيح)","صحيح ابن خزيمة 4/ 189 (صحيح)"]},{"id":"س-02349","fp":"c79988323209","stateId":534,"easy":"إذا سننت سنة خير فاتُّبعت ← لك أجرها ومثل أجور من اتبعك","cause":"من سنَّ سُنَّةَ خيرٍ فاتُّبعَ عليْها","result":"فلَهُ أجرُهُ ومثلُ أجورِ من اتَّبعَهُ غيرَ منقوصٍ من أجورِهم شيئًا","explicit":true,"star":true,"similar":["س-02962"],"ref":"صحيح الترمذي 2675","srcLabel":"مسلم","text":[["من سنَّ سُنَّةَ خيرٍ فاتُّبعَ عليْها ",1],["فلَهُ أجرُهُ ومثلُ أجورِ من اتَّبعَهُ غيرَ منقوصٍ من أجورِهم شيئًا ، ",2],"ومن سنَّ سنَّةَ شرٍّ فاتُّبعَ عليْها ، كانَ عليْهِ وزرُهُ ومثلُ أوزارِ من اتَّبعَهُ غيرَ منقوصٍ من أوزارِهم شيئًا"],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2675) واللفظ له، ومسلم (1017) بنحوه وفيه قصة، وابن ماجة (203) بنحوه.","bab":"إحسان › الحسنات والسيئات","dorar":"uJX5MiDv"},{"id":"س-06338","fp":"ccb63a9352e1","stateId":534,"easy":"إذا استننت خيراً فاقتُدي بك ← لك أجرك ومثل أجور من اتبعك","cause":"مَنِ استَنَّ خيرًا فاستُنَّ به","result":"فله أجرُهُ، ومِثلُ أجورِ مَنِ اتَّبعَهُ غيرَ مُنتقِصٍ مِن أُجُورِهِم","explicit":true,"similar":["س-06248"],"ref":"المستدرك على الصحيحين 3954","srcLabel":"الحاكم","text":["قامَ سائلٌ على عهدِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فسَأَلَ فسَكَتَ القومُ، ثُمَّ إنَّ رَجلًا أعطاهُ، فأعطاهُ القومُ، فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: «",["مَنِ استَنَّ خيرًا فاستُنَّ به ",1],["فله أجرُهُ، ومِثلُ أجورِ مَنِ اتَّبعَهُ غيرَ مُنتقِصٍ مِن أُجُورِهِم، ",2],"ومَنِ استَنَّ شرًّا فاستُنَّ به فعليه وِزرُهُ، ومثلُ أوزارِ مَنِ اتَّبعَهُ غيرَ مُنتقِصٍ مِن أوْزارِهِم شيئًا». قالَ: وتلا حُذَيْفةُ بنُ اليَمانِ: {عَلِمَتْ نَفْسٌ مَا قَدَّمَتْ وَأَخَّرَتْ} [الانفطار: 5]."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح الإسناد","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"ymU0ouRX","merged":3,"otherRefs":["تخريج المسند لشعيب 23289 (صحيح)","الترغيب والترهيب 1/69 (صحيح)"]},{"id":"س-02348","fp":"b98770a39e93","stateId":534,"easy":"إذا سننت سنة حسنة فعُمل بها بعدك ← لك أجرها ومثل أجورهم","cause":"مَن سنَّ سنَّةً حسنةً فعُمِلَ بِها بعدَهُ","result":"كانَ لَهُ أجرُهُ وَمِثْلُ أجورِهِم ، من غيرِ أن ينقصَ من أجورِهِم شيئًا","explicit":true,"repOf":"س-06379","ref":"صحيح ابن ماجه 173","text":[["مَن سنَّ سنَّةً حسنةً فعُمِلَ بِها بعدَهُ ، ",1],["كانَ لَهُ أجرُهُ وَمِثْلُ أجورِهِم ، من غيرِ أن ينقصَ من أجورِهِم شيئًا ، ",2],"ومن سنَّ سنَّةً سيِّئةً فعملَ بِها بعدَهُ ، كانَ عليهِ وزرُهُ وَمِثْلُ أوزارِهِم ، من غيرِ أن ينقصَ من أوزارِهِم شيئًا"],"grade":"صحيح","narrator":"وهب بن عبدالله السوائي أبو جحيفة","muhaddith":"حسن صحيح","takhrij":"أخرجه ابن ماجة (207) واللفظ له، والطبراني في ((المعجم الأوسط)) (4386)، والبزار (4208) وفيه قصة.","bab":"إحسان › الحسنات والسيئات","dorar":"XTgPEYt2"},{"id":"س-02962","fp":"510ca3229e90","stateId":534,"easy":"إذا سننت سنة هدى فاتُّبعت ← لك مثل أجورهم","cause":"ومَن سَنَّ سُنَّةَ هُدًى فاتُّبِعَ عليها","result":"كان له مِثْلُ أُجورِهم مِن غَيرِ أنْ يَنقُصَ مِن أُجورِهم شيءٌ","explicit":true,"repOf":"س-02349","ref":"تخريج المسند لشعيب 10556","text":["مَن سَنَّ سُنَّةَ ضَلالٍ فاتُّبِعَ عليها، كان عليه مِثْلُ أوزارِهم مِن غَيرِ أنْ يَنقُصَ مِن أوزارِهم شيءٌ، ",["ومَن سَنَّ سُنَّةَ هُدًى فاتُّبِعَ عليها؛ ",1],["كان له مِثْلُ أُجورِهم مِن غَيرِ أنْ يَنقُصَ مِن أُجورِهم شيءٌ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (204)، وأحمد (10556) واللفظ له","bab":"إيمان › الوعيد","dorar":"TYKf3yEN"},{"id":"س-03750","fp":"1e379054d155","stateId":534,"easy":"إذا دعوت إلى الهدى فاتُّبعت ← لك مثل أجور من اتبعك","cause":"أيُّما داٍع دعا إلى الهدى فاتُّبِع","result":"فإنَّ له مِثلَ أجورِ مَن اتَّبَعَه، ولا يَنقُصُ مِن أجورِهم شَيئًا","explicit":true,"ref":"الجامع الصغير 2996","srcLabel":"ابن ماجة","text":["أيُّما داٍع دعا إلى ضلالةٍ فاتُّبِع، فإنَّ عليه مِثلَ أوزارِ مَن اتَّبَعَه، ولا يَنقُصُ مِن أوزارِهم شيئًا، ",["أيُّما داٍع دعا إلى الهدى فاتُّبِع، ",1],["فإنَّ له مِثلَ أجورِ مَن اتَّبَعَه، ولا يَنقُصُ مِن أجورِهم شَيئًا",2],"."],"grade":"صحيح","narrator":"أنس","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجة (205)، وابن بشران في ((أماليه-الجزء الأول)) (242) باختلاف يسير.","bab":"اعتصام بالسنة › مخالفة السنة","dorar":"7fbKIhAl"},{"id":"س-06248","fp":"fd270018151b","stateId":534,"easy":"إذا استننت خيراً فاقتُدي بك ← لك أجرك كاملاً ومن أجور من اقتدى بك","cause":"منِ استنَّ خيرًا فاستنَّ بِهِ","result":"كانَ لَهُ أجرُهُ كاملًا ، ومِن أجورِ منِ استنَّ بِهِ ، ولا يَنقُصُ من أجورِهِم شيئًا","explicit":true,"repOf":"س-06338","ref":"صحيح ابن ماجه 170","text":["جاءَ رجلٌ إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ: فحثَّ عليهِ ، فقالَ رجُلٌ ، عندي كذا وَكَذا ، قالَ ، فما بقيَ في المَجلسِ رجلٌ إلَّا تصدَّقَ عليهِ بما قلَّ أو كثرَ ، فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: ",["منِ استنَّ خيرًا فاستنَّ بِهِ ، ",1],["كانَ لَهُ أجرُهُ كاملًا ، ومِن أجورِ منِ استنَّ بِهِ ، ولا يَنقُصُ من أجورِهِم شيئًا",2]," ، ومنِ استنَّ سنَّةً سيِّئةً فاستنَّ بِهِ ، فعليهِ وزرُهُ كاملًا ، ومِن أوزارِ الَّذي استنَّ بِهِ ، ولا ينقصُ من أوزارِهِم شيئًا"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (204) واللفظ له، وأحمد (10759)","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"pTvMewrx"},{"id":"س-07034","fp":"89fd46592673","stateId":534,"easy":"إذا علّمت علماً ← لك أجر من عمل به","cause":"من علَّم علمًا","result":"فله أجرُ من عمِل به ، لا ينقصُ من أجرِ العاملِ","explicit":true,"similar":["س-06275"],"ref":"صحيح الجامع 6396","srcLabel":"ابن ماجه","text":[["من علَّم علمًا ",1],["فله أجرُ من عمِل به ، لا ينقصُ من أجرِ العاملِ",2]],"grade":"صحيح","narrator":"معاذ بن أنس","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (240) واللفظ له، والبغوي في ((معجم الصحابة)) (2112)، والطبراني (20/198) (446)","bab":"علم › الحث على طلب العلم","dorar":"oh9dIkiC"},{"id":"س-02911","fp":"ec9d3b07fbae","stateId":534,"easy":"إذا علّمت آية من كتاب الله ← لك ثوابها ما تُليت","cause":"من علمَ آيةً من كتابِ اللهِ عز وجل","result":"كانَ لهُ ثوابُها ما تليتْ","explicit":true,"ref":"السلسلة الصحيحة 1335","srcLabel":"السلسلة الصحيحة","text":[["من علمَ آيةً من كتابِ اللهِ عز وجل ، ",1],["كانَ لهُ ثوابُها ما تليتْ",2]],"grade":"حسن","narrator":"طارق بن أشيم الأشجعي","muhaddith":"إسناده جيد عزيز رجاله ثقات","bab":"إيمان › الوعد","dorar":"91ENw80N"},{"id":"س-06252","fp":"d3ea776d3812","stateId":534,"easy":"إذا تركت ولداً صالحاً يدعو لك أو صدقة تجري أو علماً يُعمل به ← فهو خير ما تخلّفه","cause":"يَخلُفُ المَرءُ بَعدَه ثَلاثًا: وَلدًا صالِحًا يَدعو لَه، فيَبلُغُه دُعاؤُه، أو صَدقةً تَجْري، فيَبلُغُه أَجرُها، أو عِلمًا يُعمَلُ بِه بَعدَه","result":"خيرُ ما","explicit":true,"ref":"صحيح ابن خزيمة 2495","srcLabel":"النسائي","text":["سَمِعتُ رَسولَ اللهِ صلَّى اللهِ عليهِ وسلَّم يَقولُ: ",["خيرُ ما ",2],["يَخلُفُ المَرءُ بَعدَه ثَلاثًا: وَلدًا صالِحًا يَدعو لَه، فيَبلُغُه دُعاؤُه، أو صَدقةً تَجْري، فيَبلُغُه أَجرُها، أو عِلمًا يُعمَلُ بِه بَعدَه",1],"."],"grade":"حسن","narrator":"أبو قتادة","muhaddith":"إسناده حسن لغيره","takhrij":"أخرجه ابن خزيمة (2495) واللفظ له، وأخرجه ابن ماجه (241)، والنسائي في ((السنن الكبرى)) (10863) باختلاف يسير","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"tZTxO0eq"},{"id":"س-06275","fp":"39d6827da8b4","stateId":534,"easy":"إذا علّمت علماً يُعمل به بعدك ← لك مثل أجر من عمل به","cause":"ورجلٌ عَلَّمَ عِلْمًا يُعْمَلُ بهِ من بعدِهِ","result":"فَلهُ مثلُ أَجْرِ مَنْ عَمِلَ بهِ ؛ من غَيْرِ أنْ يُنْتَقَصَ من [ أجرٍ ] عَمَلِه شيئًا","explicit":true,"repOf":"س-07034","otherNeedIds":[18],"ref":"السلسلة الصحيحة 3984","text":["أربعٌ من عَمَلِ الأَحْياءِ يَجري لِلأَمْوَاتِ : رجلٌ تركَ عَقِبًا صالِحًا فِيَدْعُو ، فَيبلغُهُ دُعَاؤُهُمْ . ورجلٌ تَصَدَّقَ بِصَدَقَةٍ جَارِيَةٍ ، لهُ من بعدِهِ أَجْرُها ما جَرَتْ . ",["ورجلٌ عَلَّمَ عِلْمًا يُعْمَلُ بهِ من بعدِهِ",1]," ، ",["فَلهُ مثلُ أَجْرِ مَنْ عَمِلَ بهِ ؛ من غَيْرِ أنْ يُنْتَقَصَ من [ أجرٍ ] عَمَلِه شيئًا",2]," . ورجلٌ مُرَابِطٌ يُنْمَى لهُ عملُهُ إلى يومِ الحِسابِ"],"grade":"حسن","narrator":"سلمان الفارسي","muhaddith":"حسن لغيره","takhrij":"أخرجه ابن أبي الدنيا في ((النفقة على العيال)) (431)، والطبراني (6/268) (6181) من حديث سلمان رضي الله عنه","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"4bs5AVc0"},{"id":"س-08065","fp":"adb3e3ce6a67","stateId":534,"easy":"إذا سننت سنة حسنة ← لك أجرها ما عُمل بها في حياتك وبعد مماتك","cause":"من سنَّ سُنَّةً حسنةً","result":"فلَهُ أجرُها ما عُمِلَ بِها في حياتِهِ وبعدَ مماتِهِ حتَّى تُترَكَ","explicit":true,"repOf":"س-06379","ref":"الدر المنثور 4/202","text":[["من سنَّ سُنَّةً حسنةً ",1],["فلَهُ أجرُها ما عُمِلَ بِها في حياتِهِ وبعدَ مماتِهِ حتَّى تُترَكَ ",2],"ومن سنَّ سنَّةً سيِّئةً فعليْهِ إثمُها حتَّى تُترَكَ ومن ماتَ مرابطًا في سبيلِ اللَّهِ جرى عليْهِ عملُ المرابطِ حتَّى يُبعثَ يومَ القيامةِ"],"grade":"حسن","narrator":"واثلة بن الأسقع الليثي أبو فسيلة","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه الطبراني (184) (22/ 74) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (7/ 398) بدون فقرة:\"من مات مرابطًا\"، وابن أبي عاصم في الجهاد (298) مختصرًا بالفقرة الأخيرة.","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"fhipisl2"},{"id":"س-01968","fp":"56a8c3fe3992","stateId":534,"easy":"إذا قلت حقاً يُعمل به بعدك ← يجري عليك أجره إلى يوم القيامة","cause":"ما مِن رجُلٍ يُنْعِشُ لسانُه حَقًّا يُعمَلُ به بعْدَه","result":"إلَّا جَرَى عليه أجْرُه إلى يَومِ القيامةِ، ثمَّ وَفَّاهُ اللهُ ثَوابَه يَومَ القيامةِ","explicit":true,"ref":"تخريج المسند لشعيب 13803","srcLabel":"أحمد","text":[["ما مِن رجُلٍ يُنْعِشُ لسانُه حَقًّا يُعمَلُ به بعْدَه،",1]," ",["إلَّا جَرَى عليه أجْرُه إلى يَومِ القيامةِ، ثمَّ وَفَّاهُ اللهُ ثَوابَه يَومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (13803) واللفظ له، والبيهقي في ((شعب الإيمان)) (7681)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"LGUKq1gN","merged":2,"otherRefs":["الجامع الصغير 8023 (حسن)"]},{"id":"س-06244","fp":"db6369c4aff7","stateId":534,"easy":"إذا سننت سنة صالحة في الإسلام فعُمل بها ← لك مثل أجورهم","cause":"مَن سَنَّ سُنَّةً صالِحةً في الإسلامِ، فعُمِلَ بها بَعدَهُ","result":"كانَ له مِثلُ أجورِهم، مِن غَيرِ أنْ يُنتَقَصَ مِن أُجورِهم شيءٌ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 19183","srcLabel":"مسلم","text":["أنَّ رَجُلًا مِنَ الأنصارِ جاءَ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ بِصُرَّةٍ مِن ذَهَبٍ تَملَأُ ما بَينَ أصابِعِهِ، فقالَ: هذه في سَبيلِ اللهِ عزَّ وجلَّ. ثم قامَ أبو بكرٍ رَضيَ اللهُ عنهُ، فأعطَوْا، فأعطى، ثم قامَ عُمَرُ رَضيَ اللهُ عنهُ فأعطى، ثم قامَ المُهاجِرونَ فأعطَوْا. قالَ: فأشرَقَ وَجْهُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ حتى رَأيتُ الإشراقَ في وَجنَتَيْهِ، ثم قال: ",["مَن سَنَّ سُنَّةً صالِحةً في الإسلامِ، فعُمِلَ بها بَعدَهُ، ",1],["كانَ له مِثلُ أجورِهم، مِن غَيرِ أنْ يُنتَقَصَ مِن أُجورِهم شيءٌ، ",2],"ومَن سَنَّ في الإسلامِ سُنَّةً سَيِّئةً، فعُمِلَ بها بَعدَهُ، كان عليه مِثلُ أوزارِهم، مِن غَيرِ أنْ يُنتَقَصَ مِن أوزارِهم شيءٌ."],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1017) مطولاً، وأحمد (19183) واللفظ له","bab":"صدقة › صدقة العلانية","dorar":"iSZ6vDKS"},{"id":"س-04166","fp":"c6f8acaf1dec","stateId":535,"easy":"إذا أوصيت بثلث مالك عند وفاتك ← جعله الله زيادة في أعمالك","cause":"عند وفاتِكم بثُلُثِ أموالِكم","result":"و جعل ذلك زيادةً لكم في أعمالِكم","explicit":true,"ref":"صحيح الجامع 1733","srcLabel":"صحيح الجامع","text":["إنَّ اللهَ تعالى تصدَّق عليكم ",["عند وفاتِكم بثُلُثِ أموالِكم",1]," ، ",["و جعل ذلك زيادةً لكم في أعمالِكم",2]],"grade":"حسن","narrator":"أبو هريرة ومعاذ بن جبل وأبو الدرداء","muhaddith":"حسن","bab":"جنائز وموت › لقاء الله والمبادرة بالعمل الصالح","dorar":"P8grW51h","merged":3,"otherRefs":["البدر المنير 7/255 (حسن)","مجمع الزوائد 4/215 (حسن)"]},{"id":"ق-0621","fp":"7f2fb3a338d8","stateId":535,"easy":"نفع الناس ← المكث والبقاء في الأرض","cause":"نفع الناس","result":"المكث والبقاء في الأرض","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"star":true,"otherNeedIds":[43],"ref":"سورة الرعد: 17","srcLabel":"القرآن الكريم","quran":{"s":13,"from":17,"to":17,"text":"أَنْزَلَ مِنَ السَّمَاءِ مَاءً فَسَالَتْ أَوْدِيَةٌ بِقَدَرِهَا فَاحْتَمَلَ السَّيْلُ زَبَدًا رَابِيًا وَمِمَّا يُوقِدُونَ عَلَيْهِ فِي النَّارِ ابْتِغَاءَ حِلْيَةٍ أَوْ مَتَاعٍ زَبَدٌ مِثْلُهُ كَذَلِكَ يَضْرِبُ اللَّهُ الْحَقَّ وَالْبَاطِلَ فَأَمَّا الزَّبَدُ فَيَذْهَبُ جُفَاءً وَأَمَّا مَا يَنْفَعُ النَّاسَ فَيَمْكُثُ فِي الْأَرْضِ كَذَلِكَ يَضْرِبُ اللَّهُ الْأَمْثَالَ (17)","hl":[[280,335,1]]}},{"id":"س-02040","fp":"45d15cfc6b02","stateId":535,"easy":"إذا أوصيت بثلث مالك في الخير ← يكون زيادة في أعمالك","cause":"ثلثَ أموالِكم في آخرِ أعمارِكم","result":"زيادةً في أعمالِكم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"القبس 3/951","srcLabel":"القبس","text":["إن اللهَ أعطاكم ",["ثلثَ أموالِكم في آخرِ أعمارِكم",1]," ",["زيادةً في أعمالِكم",2]],"grade":"صحيح","muhaddith":"هذا الحديث وإن لم يكن صحيحا فإن معناه صحيح","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"XbPheSbp"},{"id":"س-06274","fp":"29479cf68304","stateId":535,"easy":"إذا تصدقت بصدقة جارية ← لك أجرها بعدك ما جرت","cause":"ورجلٌ تَصَدَّقَ بِصَدَقَةٍ جَارِيَةٍ","result":"لهُ من بعدِهِ أَجْرُها ما جَرَتْ","explicit":true,"ref":"السلسلة الصحيحة 3984","srcLabel":"الطبراني","text":["أربعٌ من عَمَلِ الأَحْياءِ يَجري لِلأَمْوَاتِ : رجلٌ تركَ عَقِبًا صالِحًا فِيَدْعُو ، فَيبلغُهُ دُعَاؤُهُمْ . ",["ورجلٌ تَصَدَّقَ بِصَدَقَةٍ جَارِيَةٍ",1]," ، ",["لهُ من بعدِهِ أَجْرُها ما جَرَتْ",2]," . ورجلٌ عَلَّمَ عِلْمًا يُعْمَلُ بهِ من بعدِهِ ، فَلهُ مثلُ أَجْرِ مَنْ عَمِلَ بهِ ؛ من غَيْرِ أنْ يُنْتَقَصَ من [ أجرٍ ] عَمَلِه شيئًا . ورجلٌ مُرَابِطٌ يُنْمَى لهُ عملُهُ إلى يومِ الحِسابِ"],"grade":"حسن","narrator":"سلمان الفارسي","muhaddith":"حسن لغيره","takhrij":"أخرجه ابن أبي الدنيا في ((النفقة على العيال)) (431)، والطبراني (6/268) (6181) من حديث سلمان رضي الله عنه","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"4bs5AVc0"},{"id":"س-02087","fp":"8ab8db48ae8d","stateId":535,"easy":"إذا بنيت بيتاً أو غرست غرساً بلا ظلم ← يكون لك أجراً جارياً ما انتفع به أحد","cause":"من بنى بيتًا في غيرِ ظلمٍ، ولا اعتداءٍ أو غرسَ غرسًا في غيرِ ظلمٍ ولا اعتداءٍ","result":"كان له أجرًا جاريًا ما انتفع به أحدٌ من خلق اللهِ تبارك وتعالى","explicit":true,"ref":"المتجر الرابح 119","srcLabel":"أحمد","text":[["من بنى بيتًا في غيرِ ظلمٍ، ولا اعتداءٍ أو غرسَ غرسًا في غيرِ ظلمٍ ولا اعتداءٍ – ",1],["كان له أجرًا جاريًا ما انتفع به أحدٌ من خلق اللهِ تبارك وتعالى",2],"."],"grade":"حسن","narrator":"معاذ بن أنس","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (15616)، وابن عبد الحكم في ((فتوح مصر والمغرب))(ص331)، والطبراني (20/ 187) (410) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"iUyO0YdG"},{"id":"س-00857","fp":"458c8a63dc88","stateId":536,"easy":"إذا دعا لك ولدك بعد موتك ← تُرفع لك الدرجة","cause":"بدعاءِ ولدِك لك","result":"لَيَرْفَعُ للرَّجلِ الدَّرجةَ","explicit":true,"star":true,"otherNeedIds":[47],"ref":"مجمع الزوائد 10/156","srcLabel":"أحمد","text":["إنَّ اللهَ تبارَك وتعالى ",["لَيَرْفَعُ للرَّجلِ الدَّرجةَ",2]," فيقولُ أنَّى لي هذه فيقولُ ",["بدعاءِ ولدِك لك",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"رجاله رجال الصحيح غير عاصم بن بهدلة وهو حسن الحديث","takhrij":"أخرجه البزار (9024)، والبيهقي (13588) بلفظه، وأحمد (10610) باختلاف يسير.","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"PrzLDRxF","merged":3,"otherRefs":["المهذب في اختصار السنن 5/2650 (حسن)","تخريج شرح السنة 1396 (حسن)"]},{"id":"س-06273","fp":"df7de6155033","stateId":536,"easy":"إذا تركت عقباً صالحاً يدعو لك ← يبلغك دعاؤهم","cause":"رجلٌ تركَ عَقِبًا صالِحًا فِيَدْعُو","result":"فَيبلغُهُ دُعَاؤُهُمْ","explicit":true,"ref":"السلسلة الصحيحة 3984","srcLabel":"الطبراني","text":["أربعٌ من عَمَلِ الأَحْياءِ يَجري لِلأَمْوَاتِ : ",["رجلٌ تركَ عَقِبًا صالِحًا فِيَدْعُو",1]," ، ",["فَيبلغُهُ دُعَاؤُهُمْ",2]," . ورجلٌ تَصَدَّقَ بِصَدَقَةٍ جَارِيَةٍ ، لهُ من بعدِهِ أَجْرُها ما جَرَتْ . ورجلٌ عَلَّمَ عِلْمًا يُعْمَلُ بهِ من بعدِهِ ، فَلهُ مثلُ أَجْرِ مَنْ عَمِلَ بهِ ؛ من غَيْرِ أنْ يُنْتَقَصَ من [ أجرٍ ] عَمَلِه شيئًا . ورجلٌ مُرَابِطٌ يُنْمَى لهُ عملُهُ إلى يومِ الحِسابِ"],"grade":"حسن","narrator":"سلمان الفارسي","muhaddith":"حسن لغيره","takhrij":"أخرجه ابن أبي الدنيا في ((النفقة على العيال)) (431)، والطبراني (6/268) (6181) من حديث سلمان رضي الله عنه","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"4bs5AVc0"},{"id":"س-04647","fp":"5600de882ae0","stateId":537,"easy":"إذا مت مرابطاً ← يجري عليك أجر المرابط حتى تُبعث وتأمن الفتّان","cause":"إنْ ماتَ","result":"جَرى عليه أجْرُ المُرابِطِ حتى يُبعَثَ، ويُؤمَنُ الفتَّانَ","explicit":true,"star":true,"similar":["س-04519","س-04639","س-04644","س-04669","س-04419","س-04481","س-04645"],"otherNeedIds":[63],"ref":"تخريج المسند لشعيب 23728","srcLabel":"مسلم","text":["أنَّه سَمِعَ رسولَ اللهِ صلَّى اللهُ عليه وسَلَّمَ يقولُ: رِباطُ يَومٍ وليلةٍ في سَبيلِ اللهِ كصِيامِ شَهرٍ وقِيامِه، ",["إنْ ماتَ",1]," ",["جَرى عليه أجْرُ المُرابِطِ حتى يُبعَثَ، ويُؤمَنُ الفتَّانَ",2],"."],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1913)، والترمذي (1665)، وأحمد (23728) واللفظ له","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"AOt6l7gd","merged":5,"otherRefs":["صحيح الجامع 3483 (صحيح)","صحيح الترمذي 1665 (صحيح)","تخريج المسند لشعيب 23735 (صحيح)","تخريج المسند لشعيب 23954 (صحيح)"]},{"id":"س-04519","fp":"4f91ee64b0af","stateId":537,"easy":"إذا مت في سبيل الله ← يجري عليك أجرك حتى يُقضى بين أهل الجنة والنار","cause":"ومن مات في سبيلِ اللهِ","result":"أجرى اللهُ تعالَى عليه أجرَه حتى يقضيَ بينَ أهلِ الجنةِ والنارِ","explicit":true,"repOf":"س-04647","ref":"تخريج الكشاف 1/266","text":["أنهم كانوا في جندٍ من المسلمين مرةً فأصابهم ضُرٌّ وحصرٌ فقال سلمانُ لصاحبِ الجندِ ألا أحدثُك حديثًا سمعته من رسولِ اللهِ صلَّى اللهُ عليهِ وسلمَ  فيكونَ لك قوةٌ على الجندِ قال بلى قال سمعتُ رسولَ اللهِ صلَّى اللهُ عليهِ وسلمَ  يقولُ من رابط يومًا وليلةً في سبيلِ اللهِ كان كعدلِ صيامِ شهرٍ وقيامِه لا يفطرُ ولا ينفتلُ عن صلاتِه إلى لحاجةٍ ",["ومن مات في سبيلِ اللهِ ",1],["أجرى اللهُ تعالَى عليه أجرَه حتى يقضيَ بينَ أهلِ الجنةِ والنارِ",2]],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"معناه في صحيح مسلم","takhrij":"أخرجه مسلم (1913)  مختصرا والترمذي (1665) و النسائي (3167 ) بمعناه.","bab":"جهاد › فضل الشهيد","dorar":"d2PMaKNS"},{"id":"س-04639","fp":"414bcbad583c","stateId":537,"easy":"إذا مت مرابطاً ← يجري لك الأجر والرزق وتأمن من الفتّان","cause":"ومَن ماتَ مرابطًا أُجْريَ لَهُ مثلُ ذلِكَ منَ الأجرِ ، وأُجْريَ علَيهِ الرِّزقُ","result":"وأمِنَ منَ الفتَّانِ","explicit":true,"repOf":"س-04647","otherNeedIds":[63],"ref":"صحيح النسائي 3167","text":["مَن رابطَ يومًا وليلةً في سبيلِ اللَّهِ كانَ لَهُ كأجرِ صيامِ شَهْرٍ وقيامِهِ ، ",["ومَن ماتَ مرابطًا أُجْريَ لَهُ مثلُ ذلِكَ منَ الأجرِ ، وأُجْريَ علَيهِ الرِّزقُ ، ",1],["وأمِنَ منَ الفتَّانِ",2]],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (4361) واللفظ له، وأحمد (23728) باختلاف يسير، ومسلم (1913) بنحوه.","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"Q1d5EY3C"},{"id":"س-04644","fp":"963fba81e424","stateId":537,"easy":"إذا مت مرابطاً ← يجري عليك عملك ورزقك وتأمن الفتّان","cause":"مَن مات مرابطًا","result":"أُجرِيَ عليه عملُه الَّذي كان يعمَلُ وأُومِنَ الفتَّانَ ويَجري عليه رزقُه","explicit":true,"repOf":"س-04647","otherNeedIds":[63],"ref":"تخريج صحيح ابن حبان 4626","text":["أنَّه مرَّ عليه سَلمانُ وهو مُرابطٌ فقال: ",["مَن مات مرابطًا",1]," ",["أُجرِيَ عليه عملُه الَّذي كان يعمَلُ وأُومِنَ الفتَّانَ ويَجري عليه رزقُه",2]],"grade":"صحيح","narrator":"سلمان","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (4626) واللفظ له، ومسلم (1913)، والنسائي (3167)، والحاكم (2422) بنحوه تامًا.","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"9Z2yVonr"},{"id":"س-04669","fp":"01f8afcfe918","stateId":537,"easy":"إذا مت مرابطاً في سبيل الله ← يجري لك أجر صلاتك وصيامك ونفقتك","cause":"ومَن ماتَ مُرابِطًا في سَبيلِ اللهِ","result":"أجْرَى اللهُ له أجْرَه الذي كان يَعمَلُ: أجْرَ صَلاتِه وصِيامِه ونَفَقَتِه، ووُقِيَ مِن فتَّانِ القَبرِ، وأمِنَ مِن الفَزَعِ الأكبَرِ","explicit":true,"repOf":"س-04647","otherNeedIds":[63,65],"ref":"تخريج المسند لشعيب 23727","text":["أنَّه سَمِعَه وهو يُحَدِّثُ شُرَحْبيلَ بنَ السِّمْطِ وهو مُرابِطٌ على السَّاحِلِ، يقولُ: سَمِعتُ النبيَّ صلَّى اللهُ عليه وسَلَّمَ يقولُ: مَن رابَطَ يومًا أو ليلةً كان له كصيامِ شَهرٍ للقاعِدِ، ",["ومَن ماتَ مُرابِطًا في سَبيلِ اللهِ، ",1],["أجْرَى اللهُ له أجْرَه الذي كان يَعمَلُ: أجْرَ صَلاتِه وصِيامِه ونَفَقَتِه، ووُقِيَ مِن فتَّانِ القَبرِ، وأمِنَ مِن الفَزَعِ الأكبَرِ",2],"."],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1913)، والترمذي (1665)، والنسائي (3167) بنحوه، وأحمد (23727) واللفظ له","bab":"دفن ومقابر › عذاب القبر ونعيمه","dorar":"NOC7DQ1q"},{"id":"س-04419","fp":"b17136bb6765","stateId":537,"easy":"إذا مت مرابطاً في سبيل الله ← يجري عليك أجر عملك ورزقك وتأمن فتنة القبر","cause":"من مات مرابطًا في سبيلِ اللهِ أجرى اللهُ عليه أجرَ عملِه الصالحِ الذي كان يعملُ ، وأجرى عليه رزقُه","result":"وأمِنَ مِنَ الفَتَّانِ ، وبعثه اللهُ يومَ القيامةِ آمنا من الفزعِ","explicit":true,"repOf":"س-04647","otherNeedIds":[63],"ref":"تفسير القرطبي 5/490","text":[["من مات مرابطًا في سبيلِ اللهِ أجرى اللهُ عليه أجرَ عملِه الصالحِ الذي كان يعملُ ، وأجرى عليه رزقُه ، ",1],["وأمِنَ مِنَ الفَتَّانِ ، وبعثه اللهُ يومَ القيامةِ آمنا من الفزعِ",2],". وفي الحديثِ قيْدٌ ثانٍ ، وهو الموتُ حالةَ الرباطِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (2767) واللفظ له، وأحمد (9244)، وعبد الرزاق (9622) كلاهما بنحوه","bab":"جهاد › النية في القتال والغزو","dorar":"5TgbBx8q"},{"id":"س-04481","fp":"db2431ceb9f8","stateId":537,"easy":"إذا مت مرابطاً في سبيل الله ← يُنمّى لك عملك ويجري عليك رزقك إلى يوم القيامة","cause":"كلُّ عملٍ منقطِعٍ عن صاحبِهِ إذا ماتَ ، إلَّا المرابِطَ في سبيلِ اللهِ","result":"فإِنَّه يُنَمَّى له عملُهُ ، ويَجري عليه رزقُهُ إلى يومِ القيامَةِ","explicit":true,"repOf":"س-04647","ref":"صحيح الجامع 4539","text":[["كلُّ عملٍ منقطِعٍ عن صاحبِهِ إذا ماتَ ، إلَّا المرابِطَ في سبيلِ اللهِ ، ",1],["فإِنَّه يُنَمَّى له عملُهُ ، ويَجري عليه رزقُهُ إلى يومِ القيامَةِ",2]],"grade":"صحيح","narrator":"العرباض بن سارية","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي عاصم في ((الجهاد)) (296)، والطبراني (18/256) (641) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (6/401)","bab":"جهاد › فضل الجهاد","dorar":"NidpXAX1"},{"id":"س-04645","fp":"28efcd665c66","stateId":537,"easy":"إذا مت مرابطاً في سبيل الله ← يجري لك أجر عملك حتى تُبعث","cause":"كلُّ مَيِّتٍ يُختَمُ على عمَلِه، إلَّا المُرابِطَ في سبيلِ اللهِ","result":"فإنَّه يُجرى له أجْرُ عمَلِه حتى يُبعَثَ","explicit":true,"repOf":"س-04647","ref":"تخريج المسند لشعيب 17359","text":[["كلُّ مَيِّتٍ يُختَمُ على عمَلِه، إلَّا المُرابِطَ في سبيلِ اللهِ؛ ",1],["فإنَّه يُجرى له أجْرُ عمَلِه حتى يُبعَثَ",2],". حدَّثَنا قُتَيْبةُ، قال فيه: ويؤْمَنُ مِن فُتَّانِ القبرِ."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (17359) واللفظ له، والدارمي (2425)، والحارث في ((المسند)) (628)","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"BN06TFG3"},{"id":"س-06276","fp":"a34632192233","stateId":537,"easy":"إذا مت مرابطاً ← يُنمى لك عملك إلى يوم الحساب","cause":"ورجلٌ مُرَابِطٌ","result":"يُنْمَى لهُ عملُهُ إلى يومِ الحِسابِ","explicit":true,"ref":"السلسلة الصحيحة 3984","srcLabel":"الطبراني","text":["أربعٌ من عَمَلِ الأَحْياءِ يَجري لِلأَمْوَاتِ : رجلٌ تركَ عَقِبًا صالِحًا فِيَدْعُو ، فَيبلغُهُ دُعَاؤُهُمْ . ورجلٌ تَصَدَّقَ بِصَدَقَةٍ جَارِيَةٍ ، لهُ من بعدِهِ أَجْرُها ما جَرَتْ . ورجلٌ عَلَّمَ عِلْمًا يُعْمَلُ بهِ من بعدِهِ ، فَلهُ مثلُ أَجْرِ مَنْ عَمِلَ بهِ ؛ من غَيْرِ أنْ يُنْتَقَصَ من [ أجرٍ ] عَمَلِه شيئًا . ",["ورجلٌ مُرَابِطٌ",1]," ",["يُنْمَى لهُ عملُهُ إلى يومِ الحِسابِ",2]],"grade":"حسن","narrator":"سلمان الفارسي","muhaddith":"حسن لغيره","takhrij":"أخرجه ابن أبي الدنيا في ((النفقة على العيال)) (431)، والطبراني (6/268) (6181) من حديث سلمان رضي الله عنه","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"4bs5AVc0"},{"id":"س-05525","fp":"ec4a4d85aab7","stateId":537,"easy":"إذا مت ← يرجع أهلك ومالك ويبقى معك عملك","cause":"وعَمَلُه","result":"ويَبقى عَمَلُه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[63],"ref":"صحيح البخاري 6514","srcLabel":"متفق عليه","text":["يَتبَعُ المَيِّتَ ثَلاثةٌ، فيَرجِعُ اثنانِ ويَبقى معهُ واحِدٌ: يَتبَعُه أهلُه ومالُه ",["وعَمَلُه",1],"، فيَرجِعُ أهلُه ومالُه، ",["ويَبقى عَمَلُه",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6514)، ومسلم (2960)","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"49gAJi7g"},{"id":"س-01906","fp":"de6fa5ac1f33","stateId":538,"easy":"إذا تصدقت عن أمك الميتة ← فلك أجر","cause":"أن أتَصَدَّقَ عَنها","result":"فلي أجرٌ أن أتَصَدَّقَ عَنها","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[37],"ref":"صحيح مسلم 1004","srcLabel":"البخاري","text":["أنَّ رَجُلًا قال للنَّبيِّ صلَّى اللهُ عليه وسلَّم: إنَّ أُمِّيَ افتُلِتَت نَفسُها، وإنِّي أظُنُّها لو تَكَلَّمَت تَصَدَّقَت، ",["فلي أجرٌ أن أتَصَدَّقَ عَنها؟",2]," قال: نَعَم."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1388)، وسلم (1004).","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Y5M22VcS","merged":2,"otherRefs":["صحيح الأدب المفرد 30 (صحيح)"]},{"id":"س-06385","fp":"705da07dd2ef","stateId":538,"easy":"إذا تصدقت عن أمك الميتة ← ينفعها","cause":"أفأتَصدَّقُ عنها","result":"قال: نعَمْ، تصَدَّقْ عنها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-02186"],"otherNeedIds":[37,45],"ref":"تخريج المسند لشعيب 28/587","srcLabel":"متفق عليه","text":["أنَّ رجُلًا قال للنَّبيِّ صلَّى اللهُ عليه وسلَّمَ: إنَّ أُمِّي افتُلِتَتْ نفْسُها (أي: ماتت فجأةً)، وأَظُنُّها لو تكَلَّمَتْ تصَدَّقَتْ، ",["أفأتَصدَّقُ عنها",1],"؟ ",["قال: نعَمْ، تصَدَّقْ عنها",2],". وفي روايةٍ: فهلْ لها أجْرٌ إنْ تصَدَّقْتُ عنها؟"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه البخاري (2760) واللفظ له، ومسلم (1004). والرواية أخرجها البخاري (1388)","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"lXqALASC","merged":5,"otherRefs":["صحيح النسائي 3656 (صحيح)","الأوسط لابن المنذر 8/192 (صحيح)","صحيح البخاري 2770 (صحيح)","مجمع الزوائد 3/141 (صحيح)"]},{"id":"س-02693","fp":"bc61460d8493","stateId":538,"easy":"إذا حججت عن أبيك العاجز ← ينفعه ذلك","cause":"أَفَأَحُجُّ عنه","result":"أينفعُه ذلك ؟ قال : نَعَمْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[37],"ref":"المجموع للنووي 7/112","srcLabel":"متفق عليه","text":["أنَّ امرأةً مِنْ خَثْعَمٍ أَتَتِ النبيَّ صلَّى اللهُ عليهِ وسلَّم فقالت : يا رسولَ اللهِ إنَّ فريضةَ اللهِ في الحَجِّ على عبادِه أدركَتْ أبي شيخًا كبيرًا لا يستطيعُ أنْ يَسْتَمْسِكَ على الراحلةِ ",["أَفَأَحُجُّ عنه",1]," ؟ قال : نَعَمْ . قالت : ",["أينفعُه ذلك ؟ قال : نَعَمْ",2]," كما لو كان على أبيكِ دَيْنٌ فَقَضَيْتِه نَفَعَهُ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1513)، ومسلم (1334) دون قوله: \"أينفعُه ذلك ...\"","bab":"إيمان › الدين يسر","dorar":"bPgHEv3w"},{"id":"س-02186","fp":"19838a88b147","stateId":538,"easy":"إذا تصدقت عن أمك الميتة ← ينفعها","cause":"إن تَصَدَّقتُ به عَنها","result":"فهل يَنفَعُها شيءٌ إن تَصَدَّقتُ به عَنها","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-06385","otherNeedIds":[37,45],"ref":"صحيح البخاري 2762","text":["أنَّ سَعدَ بنَ عُبادةَ رَضيَ اللهُ عنه أخا بَني ساعِدةَ توفِّيَت أُمُّه وهو غائِبٌ عَنها، فأتى النَّبيَّ صلَّى اللهُ عليه وسلَّم فقال: يا رَسولَ اللهِ، إنَّ أُمِّي توفِّيَت وأنا غائِبٌ عَنها، ",["فهل يَنفَعُها شيءٌ إن تَصَدَّقتُ به عَنها؟",2]," قال: نَعَم، قال: فإنِّي أُشهدُكَ أنَّ حائِطيَ المِخرافَ صَدَقةٌ عليها."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"من أفراد البخاري على مسلم","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"KgUYBLMy","merged":9,"otherRefs":["الأوسط لابن المنذر 8/191 (صحيح)","صحيح مسلم 1004 (صحيح)","صحيح ابن ماجه 2214 (صحيح)","تخريج المسند لشعيب 28/587 (صحيح)","المستدرك على الصحيحين 1551 (صحيح)","صحيح ابن خزيمة 2501 (صحيح)","صحيح ابن خزيمة 4/ 209 (صحيح)","المغني لابن قدامة 3/519 (صحيح)"]},{"id":"س-02183","fp":"7668d37112df","stateId":538,"easy":"إذا مات أبوك مسلماً فأعتقت أو تصدقت أو حججت عنه ← يبلغه ذلك","cause":"لو كان مسلمًا, فأَعْتَقْتُم عنه, أو تَصَدَّقْتُم عنه, أو حَجَجْتُم عنه","result":"بَلَغَهُ ذلك","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"هداية الرواة 3013","srcLabel":"أبو داود","text":["إنه ",["لو كان مسلمًا, فأَعْتَقْتُم عنه, أو تَصَدَّقْتُم عنه, أو حَجَجْتُم عنه",1]," ؛ ",["بَلَغَهُ ذلك",2]],"grade":"حسن","narrator":"[جد عمرو بن شعيب]","muhaddith":"إسناده حسن","takhrij":"أخرجه أبو داود (2883)، والبيهقي (12763) واللفظ لهما، وأحمد (6704) بمعناه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"FXAWbA7i"},{"id":"س-06283","fp":"a4e6f70a9d7f","stateId":539,"easy":"إذا تركت صدقة جارية أو علماً يُنتفع به أو ولداً صالحاً يدعو لك ← لا ينقطع عملك بموتك","cause":"صَدَقةٍ جاريةٍ، أو عِلمٍ يُنتَفَعُ به، أو ولَدٍ صالِحٍ يَدعو له","result":"انقَطَعَ عنه عَمَلُه إلَّا مِن ثَلاثةٍ","explicit":true,"star":true,"ref":"صحيح مسلم 1631","srcLabel":"متفق عليه","text":["إذا ماتَ الإنسانُ ",["انقَطَعَ عنه عَمَلُه إلَّا مِن ثَلاثةٍ",2],": إلَّا مِن ",["صَدَقةٍ جاريةٍ، أو عِلمٍ يُنتَفَعُ به، أو ولَدٍ صالِحٍ يَدعو له",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"j8bVoD7A","merged":3,"otherRefs":["صحيح الترمذي 1376 (صحيح)","صحيح الترغيب 113 (صحيح)"]},{"id":"س-06387","fp":"169bfa9a36d8","stateId":539,"easy":"إذا تركت علماً نشرته أو ولداً صالحاً أو مسجداً بنيته أو بيتاً لابن السبيل ← يلحقك بعد موتك","cause":"علمًا عَلَّمَهُ ونشرَهُ، أو ولدًا صالحًا ترَكَهُ، أو مسجدًا بَناهُ، أو بيتًا لابنِ السَّبيلِ بَناهُ، أو نَهَرًا كراهُ، أو صدقةً أخرجَها مِن مالِهِ في صحَّتِهِ وحياتِهِ","result":"إنَّ مِمَّا يلحقُ المؤمنُ من عملِهِ وحسَناتِهِ بعدَ مَوتِهِ","explicit":true,"star":true,"ref":"صحيح ابن خزيمة 4/ 204","srcLabel":"مسلم","text":[["إنَّ مِمَّا يلحقُ المؤمنُ من عملِهِ وحسَناتِهِ بعدَ مَوتِهِ",2]," ",["علمًا عَلَّمَهُ ونشرَهُ، أو ولدًا صالحًا ترَكَهُ، أو مسجدًا بَناهُ، أو بيتًا لابنِ السَّبيلِ بَناهُ، أو نَهَرًا كراهُ، أو صدقةً أخرجَها مِن مالِهِ في صحَّتِهِ وحياتِهِ",1],"، تلحقُهُ من بَعدِ مَوتِهِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن ماجة (242)، والبيهقي في ((الشعب)) (3174) واللفظ لهما، ومسلم (1631) بنحوه.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"IY1NckZ9"},{"id":"ق-1035","fp":"5182ca8adf82","stateId":539,"easy":"ترك الآثار (العمل الباقي) ← كتابتها لصاحبها","cause":"ترك الآثار (العمل الباقي)","result":"كتابتها لصاحبها","explicit":true,"ref":"سورة يس: 12","srcLabel":"القرآن الكريم","quran":{"s":36,"from":12,"to":12,"text":"إِنَّا نَحْنُ نُحْيِي الْمَوْتَى وَنَكْتُبُ مَا قَدَّمُوا وَآثَارَهُمْ وَكُلَّ شَيْءٍ أَحْصَيْنَاهُ فِي إِمَامٍ مُبِينٍ (12)","hl":[[33,70,1]]}},{"id":"س-04134","fp":"aa63a923bbcc","stateId":539,"easy":"إذا تركت علماً يُعمل به أو صدقة جارية أو ولداً صالحاً ← تجري لك في قبرك","cause":"عالمٌ ترك عِلمًا يُعمَلُ به فهو يجري له ما عُمِل به ، ورجلٌ تصدَّق بصدقةٍ فهو يجري له ما عُمِل بما جرَتْ لأهلِها ، ورجلٌ ترك ولدًا صالحًا فهو يدعو له","result":"ثلاثٌ تجري للمؤمنِ في قبرِه","explicit":true,"similar":["س-06359"],"ref":"حلية الأولياء 4/296","srcLabel":"أبو نعيم","text":[["ثلاثٌ تجري للمؤمنِ في قبرِه",2]," : ",["عالمٌ ترك عِلمًا يُعمَلُ به فهو يجري له ما عُمِل به ، ورجلٌ تصدَّق بصدقةٍ فهو يجري له ما عُمِل بما جرَتْ لأهلِها ، ورجلٌ ترك ولدًا صالحًا فهو يدعو له",1]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"غريب من حديث عون عن أبيه تفرد به محمد بن أبي حميد وهو صحيح ثابت من حديث أبي هريرة وأبي قتادة","takhrij":"أخرجه أبو نعيم في ((حلية الأولياء)) (4/ 267)، واللفظ له.","bab":"جنائز وموت › روح المؤمن بعد الموت","dorar":"cOEows6z"},{"id":"س-06292","fp":"b6b829846dd7","stateId":539,"easy":"إذا مت مرابطاً أو علّمت علماً ← يجري عليك أجرك بعد الموت","cause":"رَجُلٌ مات مُرابطًا في سَبيلِ اللهِ، ورَجُلٌ عَلَّمَ عِلمًا فأجْرُه يَجري عليه ما عُمِلَ به، ورَجُلٌ أَجرى صَدقةً فأجْرُها يَجري عليه ما جَرَتْ عليهم، ورَجُلٌ تَرَكَ وَلدًا صالحًا يَدْعو له","result":"أربعٌ تَجري عليهم أُجورُهم بعدَ المَوتِ","explicit":true,"similar":["س-06319"],"ref":"تخريج المسند لشعيب 22318","srcLabel":"أحمد","text":[["أربعٌ تَجري عليهم أُجورُهم بعدَ المَوتِ",2],": ",["رَجُلٌ مات مُرابطًا في سَبيلِ اللهِ، ورَجُلٌ عَلَّمَ عِلمًا فأجْرُه يَجري عليه ما عُمِلَ به، ورَجُلٌ أَجرى صَدقةً فأجْرُها يَجري عليه ما جَرَتْ عليهم، ورَجُلٌ تَرَكَ وَلدًا صالحًا يَدْعو له",1],"."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (22318) واللفظ له، والبزار كما في ((مجمع الزوائد)) للهيثمي (1/172)، والطبراني (8/243) (7831)","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"rZvlr0cF"},{"id":"س-06321","fp":"c2b813714aef","stateId":539,"easy":"إذا علّمت علماً أو أجريت نهراً أو حفرت بئراً أو غرست نخلاً أو بنيت مسجداً أو ورّثت مصحفاً ← يجري لك بعد موتك","cause":"من علَّم عِلمًا أو كرَى نهرًا أو حفر بئرًا أو غرس نخلًا أو بنَى مسجدًا أو ورَّث مصحفًا أوترك ولدًا يستغفرُ له بعد موتِه","result":"سبعٌ تجري للعبدِ بعد موتِه وهو في قبرِه","explicit":true,"ref":"الترغيب والترهيب 2/98","srcLabel":"ابن حبان","text":[["سبعٌ تجري للعبدِ بعد موتِه وهو في قبرِه",2]," ",["من علَّم عِلمًا أو كرَى نهرًا أو حفر بئرًا أو غرس نخلًا أو بنَى مسجدًا أو ورَّث مصحفًا أوترك ولدًا يستغفرُ له بعد موتِه",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه البزار (7289)، وابن أبي داود في ((المصاحف)) (ص463)، وابن حبان في ((المجروحين)) (2/181) باختلاف يسير.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"hhgwYIgc"},{"id":"س-07090","fp":"ca7f9c1cde93","stateId":539,"easy":"إذا عملت عملاً يُقتدى به أو تصدقت بصدقة أو تركت ولداً يدعو لك ← يجري لك بعد موتك","cause":"ومَن عَمِلَ عملًا أُجريَ له مِثلُ ما عَمِلَ، ورَجُلٌ تَصدَّقَ بصَدقةٍ فأجْرُها له ما جَرَتْ، ورَجُلٌ تَرَكَ وَلدًا صالحًا","result":"فهو يَدْعو له","explicit":true,"ref":"تخريج المسند لشعيب 22247","srcLabel":"أحمد","text":["أربعةٌ تَجري عليهم أُجورُهم بعدَ المَوتِ: مُرابطٌ في سَبيلِ اللهِ، ",["ومَن عَمِلَ عملًا أُجريَ له مِثلُ ما عَمِلَ، ورَجُلٌ تَصدَّقَ بصَدقةٍ فأجْرُها له ما جَرَتْ، ورَجُلٌ تَرَكَ وَلدًا صالحًا ",1],["فهو يَدْعو له",2],"."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (22247) واللفظ له، والبزار كما في ((مجمع الزوائد)) للهيثمي (1/172)، والطبراني (8/243) (7831)","bab":"علم › تعليم الناس وفضل ذلك","dorar":"1PB1ouOs"},{"id":"س-06319","fp":"d1835e377769","stateId":539,"easy":"إذا مت مرابطاً أو علّمت علماً أو تركت ولداً صالحاً ← يجري لك عملك","cause":"من ماتَ مرابطًا في سبيلِ اللهِ ، و من علَّم علمًا أُجريَ له عملُه ماعُمِلَ به ، و من تصدَّق بصدقةٍ فأجرها يجري له ما وجدتْ ، و رجلٌ ترك ولدًا صالحًا","result":"فهو يدعو له","explicit":true,"repOf":"س-06292","ref":"صحيح الجامع 877","text":["أربعةٌ تجري عليهم أجورُهم بعد الموتِ : ",["من ماتَ مرابطًا في سبيلِ اللهِ ، و من علَّم علمًا أُجريَ له عملُه ماعُمِلَ به ، و من تصدَّق بصدقةٍ فأجرها يجري له ما وجدتْ ، و رجلٌ ترك ولدًا صالحًا ",1],["فهو يدعو له",2]],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"حسن","takhrij":"أخرجه أحمد (22301)","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"S4d8vROr"},{"id":"س-06359","fp":"f5e5b5ad34d9","stateId":539,"easy":"إذا تركت عقباً صالحاً أو صدقة جارية أو علماً ← تجري لك بعد موتك","cause":"رجلٌ ترك عقبًا صالحًا يدعو له ينفعُه دعاؤهم ، ورجلٌ تصدق بصدقةٍ جاريةٍ من بعدِه له أجرُها ما جرت بعدَه ، ورجلٌ علِم علمًا فعمِلَ به من بعدِه له مثلُ أجرِ من عمِلَ به من غيرِ أن ينقصَ من أجرِ من يعملَ به شيءٌ","result":"أربعٌ من عملِ الأحياءِ تجري للأمواتِ","explicit":true,"repOf":"س-04134","ref":"صحيح الجامع 888","text":[["أربعٌ من عملِ الأحياءِ تجري للأمواتِ",2]," : ",["رجلٌ ترك عقبًا صالحًا يدعو له ينفعُه دعاؤهم ، ورجلٌ تصدق بصدقةٍ جاريةٍ من بعدِه له أجرُها ما جرت بعدَه ، ورجلٌ علِم علمًا فعمِلَ به من بعدِه له مثلُ أجرِ من عمِلَ به من غيرِ أن ينقصَ من أجرِ من يعملَ به شيءٌ",1]],"grade":"حسن","narrator":"سلمان الفارسي","muhaddith":"حسن","takhrij":"أخرجه الطبراني (6/268) (6181)","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"du5f0Ray"}]}