{"schema":1,"kind":"sunan-chunk","version":"sunan-b53213585e2f","needId":57,"stateIds":[585,586,587,588],"items":[{"id":"س-06898","fp":"c4575d14cb96","stateId":585,"easy":"إذا نازعت الله رداءه أو شككت في أمره أو قنطت من رحمته ← فلا يُسأل عنك","cause":"رجلٌ نازعَ اللهَ رِداءَه ؛ فإنَّ رداءَه الكِبرياءُ و إزارَه عِزُّهُ ، و رجلٌ شكَّ في أمرِ اللهِ ، و القَنُوطُ مِن رحمةِ اللهِ","result":"و ثلاثةٌ لا يُسْأَلُ عنهُم","explicit":true,"star":true,"ref":"صحيح الأدب المفرد 458","srcLabel":"البخاري","text":["ثلاثةٌ لا يُسأَلُ عنهم : رجلٌ فارَقَ الجماعةَ و عصَى إمامَه فماتَ عاصيًا ؛ فلا يُسأَلُ عنهُ ، و أَمَةٌ أو عبدٌ أَبَقَ مِن سيدِه ، و امرأةٌ غاب عنها زوجُها و كَفاها مَؤونةَ الدُّنيا فتبرَّجَت و تمرَّجت بعدَه ",["و ثلاثةٌ لا يُسْأَلُ عنهُم",2]," : ",["رجلٌ نازعَ اللهَ رِداءَه ؛ فإنَّ رداءَه الكِبرياءُ و إزارَه عِزُّهُ ، و رجلٌ شكَّ في أمرِ اللهِ ، و القَنُوطُ مِن رحمةِ اللهِ",1]],"grade":"صحيح","narrator":"فضالة بن عبيد","muhaddith":"صحيح","takhrij":"أخرجه أحمد (23988)، والبخاري في ((الأدب المفرد)) (590)، والبزار (3749) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"G0aZMJSZ","merged":3,"otherRefs":["تخريج المسند لشعيب 23943 (صحيح)","صحيح الجامع 3059 (صحيح)"]},{"id":"س-02792","fp":"9a2f03534741","stateId":585,"easy":"إذا نسيت الله ← ينساك يوم القيامة","cause":"كما نسِيتَني","result":"اليومَ أنساكَ","explicit":true,"star":true,"similar":["س-01784"],"ref":"تخريج صحيح ابن حبان 7445","srcLabel":"مسلم","text":["قال ناسٌ : يا رسولَ اللهِ هل نرى ربَّنا يومَ القيامةِ ؟ قال : ( هل تُضارُّونَ في رؤيةِ الشَّمسِ في يومٍ صائفٍ والسَّماءُ مُصْحيةٌ غيرُ مُتغيِّمةٍ ليس فيها سَحابةٌ ؟ ) قالوا : لا قال : ( فهل تُضارُّونَ في رؤيةِ القمرِ ليلةَ البدرِ والسَّماءُ مُصحِيَةٌ غيرُ مُتغيِّمةٍ ليس فيها سَحابةٌ ؟ ) قالوا : لا قال : ( فوالَّذي نفسي بيدِه كذلك لا تُضارُّونَ في رؤيةِ ربِّكم يومَ القيامةِ كما لا تُضارُّونَ في رؤيةِ واحدٍ منهما يَلْقَى العبدُ ربَّه يومَ القيامةِ فيقولُ اللهُ جلَّ وعلا : أيْ فُلُ ألَمْ أخلُقْكَ ؟ ألَمْ أجعَلْكَ سميعًا بصيرًا ؟ ألَمْ أُزوِّجْكَ ؟ ألَمْ أُكرِمْكَ ؟ ألَمْ أُسخِّرْ لكَ الخيلَ والإبلَ ؟ ألَمْ أُسوِّدْكَ وأذَرْكَ ترأَسُ وتربَعُ ؟ فيقولُ : بلى أيْ ربِّ فيقولُ : فظنَنْتَ أنَّكَ مُلاقِيَّ ؟ فيقولُ : لا يا ربِّ فيقولُ : ",["اليومَ أنساكَ",2]," ",["كما نسِيتَني",1]," \nقال : ويَلقاه الآخَرُ فيقولُ : أيْ فُلُ ؟ ألَمْ أخلُقْكَ ؟ ألَمْ أجعَلْكَ سميعًا بصيرًا ؟ ألَمْ أُزوِّجْكَ ؟ ألَمْ أُكرِمْكَ ؟ ألَمْ أُسخِّرْ لكَ الخيلَ والإبلَ ؟ ألَمْ أُسوِّدْكَ وأذَرْكَ ترأَسُ وتربَعُ فيقولُ : بلى يا ربِّ فيقولُ : فماذا أعدَدْتَ لي ؟ فيقولُ : آمَنْتُ بكَ وبكتابِكَ وبرسولِكَ وصدَّقْتُ وصلَّيْتُ وصُمْتُ فيقولُ : فها هنا إذًا ثمَّ يقولُ : ألَا نبعَثُ عليكَ قال : فيُفكِّرُ في نفسِه مَن هذا الَّذي يشهَدُ علَيَّ ؟ قال : وذلكَ المُنافِقُ الَّذي يغضَبُ اللهُ عليه وذلكَ لِيُعذِرَ مِن نفسِه فيُختَمُ على فيه ويُقالُ لِفخِذِه : انطِقي فتنطِقُ فخِذُه وعِظامُه وعصَبُه بما كان يعمَلُ \nثم يُنادي مُنادٍ ألَا اتَّبَعَتْ كلُّ أمَّةٍ ما كانت تعبُدُ فيتَّبِعُ عبَدَةُ الصَّليبِ الصَّليبَ وعبَدَةُ النَّارِ النَّارَ وعبَدَةُ الأوثانِ الأوثانَ وعبَدَةُ الشَّيطانِ الشَّيطانَ ويتَّبِعُ كلُّ طاغيةٍ طاغيتَها إلى جَهنَّمَ ونَبقى أيُّها المُؤمِنونَ ونحنُ المُؤمِنونَ فيأتينا ربُّنا تبارَك وتعالى ونحنُ قيامٌ فيقولُ : علامَ هؤلاءِ قيامٌ ؟ فنقولُ : نحنُ عبادُ اللهِ المُؤمِنونَ آمنَّا به ولَمْ نُشرِكْ به شيئًا وهذا مَقامُنا ولنْ نبرَحَ حتَّى يأتيَنا ربُّنا وهو ربُّنا وهو يُثبِّتُنا فيقولُ : وهل تعرِفونَه ؟ فنقولُ : سُبحانَه إذا اعترَف لنا عرَفْناه ) قال سُفيانُ : وها هنا كلمةٌ لا أقولُها لكم قال : فننطلِقُ حتَّى نأتيَ الجِسرَ وعليه خَطاطيفُ مِن نارٍ تخطَفُ النَّاسَ وعندَها حلَّتِ الشَّفاعةُ اللَّهمَّ سلِّمْ سلِّمْ اللَّهمَّ سلِّمْ سلِّمْ اللَّهمَّ سلِّمْ سلِّمْ فإذا جاوَز الجِسرَ فكلُّ مَن أنفَق زوجًا مِن المالِ ممَّا يملِكُ في سبيلِ اللهِ فكلُّ خَزَنةِ الجنَّةِ تدعوه : يا عبدَ اللهِ يا مُسلِمُ هذا خيرٌ فتَعالَ يا عبدَ اللهِ يا مُسلِمُ هذا خيرٌ فتَعالَ يا عبدَ اللهِ يا مُسلِمُ هذا خيرٌ فتَعالَ ) فقال أبو بكرٍ وهو إلى جَنْبِ النَّبيِّ صلَّى اللهُ عليه وسلَّم : ذاكَ عبدٌ لا توَى عليه يدَعُ بابًا ويلِجُ مِن آخَرَ فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم ومسَح مَنْكِبَيْهِ : ( إنِّي لَأرجو أنْ تكونَ منهم )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (7445) بلفظه، ومسلم (2968) بنحوه مطولا، وأبو داود (4730) مختصرا.","bab":"إيمان › النفاق","dorar":"7VzIqY2F","merged":3,"otherRefs":["تخريج صحيح ابن حبان 4642 (صحيح)","صحيح الجامع 7997 (صحيح)"]},{"id":"س-03009","fp":"ebe81335b454","stateId":585,"easy":"إذا مت وأنت تجعل لله نداً ← يدخلك الله النار","cause":"مَن مات وهو يَجعَلُ للهِ نِدًّا","result":"أدخَلَه اللهُ النَّارَ","explicit":true,"star":true,"similar":["س-04202","س-04238","س-04189"],"ref":"تخريج المسند لشعيب 4425","srcLabel":"متفق عليه","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ كَلِمةً، وأنا أقولُ أخرى؛ ",["مَن مات وهو يَجعَلُ للهِ نِدًّا، ",1],["أدخَلَه اللهُ النَّارَ",2],"، قال: وقال عبدُ اللهِ: وأنا أقولُ: مَن مات وهو لا يَجعَلُ للهِ نِدًّا، أدخَلَه اللهُ الجنَّةَ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (1238)، ومسلم (92) بنحوه، وأحمد (4425) واللفظ له","bab":"إيمان › الوعيد","dorar":"wFSNmwQS"},{"id":"س-04202","fp":"892df83ca96d","stateId":585,"easy":"إذا جعلت لله نداً ← يجعلك الله في النار","cause":"مَن جعَلَ للهِ نِدًّا","result":"جعَلَه اللهُ في النَّارِ","explicit":true,"repOf":"س-03009","ref":"تخريج المسند لشعيب 3865","text":["\"",["مَن جعَلَ للهِ نِدًّا؛ ",1],["جعَلَه اللهُ في النَّارِ\"",2],"، قال: وأُخرى أَقولُها، لم أسمَعْها منه: ومَن مات لا يجعَلُ للهِ نِدًّا؛ أدخَلَه اللهُ عزَّ وجلَّ الجنَّةَ، وإنَّ هذه الصَّلَواتِ كَفَّاراتٌ لما بينهنَّ ما اجتُنِبَ المَقتَلُ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6683) باختلاف يسير دون قوله: \"وإنَّ هذه الصَّلَواتِ كَفَّاراتٌ ...\"، ومسلم (92) بنحوه دون قوله: \"وإنَّ هذه الصَّلَواتِ كَفَّاراتٌ ...\"","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"R7EZbax3"},{"id":"س-04235","fp":"b6c1d90e764b","stateId":585,"easy":"إذا لقيت الله تشرك به ← يدخلك النار","cause":"لا يلقى اللهَ عبدٌ يُشرِك به","result":"إلَّا أدخَله النَّارَ وأنا أقولُ لا يلقى اللهَ عبدٌ لم يُشرِكْ به إلَّا أدخَله الجنَّةَ","explicit":true,"star":true,"similar":["س-03033","س-04199"],"ref":"تخريج صحيح ابن حبان 251","srcLabel":"متفق عليه","text":["كلمتانِ سمِعْتُ إحداهما مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم والأخرى أنا أقولُها، سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( ",["لا يلقى اللهَ عبدٌ يُشرِك به",1]," ",["إلَّا أدخَله النَّارَ وأنا أقولُ لا يلقى اللهَ عبدٌ لم يُشرِكْ به إلَّا أدخَله الجنَّةَ )",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (1238)، ومسلم (92) بلفظ مقارب","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"4HDEhcHq"},{"id":"س-04238","fp":"389691306dde","stateId":585,"easy":"إذا مت وأنت تجعل لله نداً ← دخلت النار","cause":"مَن مات وهو يجعَلُ للهِ نِدًّا","result":"دخَلَ النَّارَ، وأنا أقولُ","explicit":true,"repOf":"س-03009","ref":"تخريج المسند لشعيب 3552","text":["خَصْلتانِ -يعني إحداهما- سمِعْتُها مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، والأُخرى مِن نفْسي: \"",["مَن مات وهو يجعَلُ للهِ نِدًّا؛ ",1],["دخَلَ النَّارَ\"، وأنا أقولُ: ",2],"مَن مات وهو لا يَجعَلُ للهِ نِدًّا، ولا يُشرِكُ به شيئًا؛ دخَلَ الجنَّةَ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (1238)، ومسلم (92) بنحوه، وأحمد (3552) واللفظ له","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"A1nAA2XS"},{"id":"س-05008","fp":"ff749ced9b0d","stateId":585,"easy":"إذا أحدثت بعد النبي ﷺ وارتددت ← تُحلّأ عن حوضه","cause":"بما أحدَثوا بَعدَك، إنَّهمُ ارتَدُّوا على أدبارِهمُ القَهقَرى","result":"فيُحَلَّؤونَ عنه","explicit":true,"star":true,"ref":"صحيح البخاري 6586","srcLabel":"البخاري","text":["يَرِدُ على الحَوضِ رِجالٌ مِن أصحابي، ",["فيُحَلَّؤونَ عنه",2],"، فأقولُ: يا رَبِّ، أصحابي، فيَقولُ: إنَّك لا عِلمَ لك ",["بما أحدَثوا بَعدَك، إنَّهمُ ارتَدُّوا على أدبارِهمُ القَهقَرى",1],". قال شُعَيبٌ عن الزُّهريِّ: كان أبو هُرَيرةَ يُحَدِّثُ عن النَّبيِّ صلَّى اللهُ عليه وسلَّم: فيُجْلَون. وقال عُقَيلٌ: فيُحَلَّؤون، وقال الزُّبَيديُّ عن الزُّهريِّ عن محمَّدِ بنِ عليٍّ عن عُبَيدِ اللهِ بنِ أبي رافعٍ عن أبي هُرَيرةَ عن النَّبيِّ صلَّى اللهُ عليه وسلَّم"],"grade":"صحيح","narrator":"أصحاب النبي صلى الله عليه وسلم","muhaddith":"[صحيح]","takhrij":"لم نقف عليه بهذا الإسناد إلا عند البخاري (6214).","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"KEJYpgjc"},{"id":"س-02609","fp":"23041eb3010a","stateId":585,"easy":"إذا سمعت بالنبي ﷺ ثم لم تؤمن به ← تكون من أهل النار","cause":"لا يسمعُ بي رجلٌ من هذه الأمَّةِ ، ولا يهوديٌّ ولا نصرانيٌّ ثمَّ لم يؤمِنْ بي","result":"إلَّا كان من أهلِ النَّارِ","explicit":true,"similar":["س-03002","س-02622","س-03031"],"otherNeedIds":[20],"ref":"السلسلة الصحيحة 157","srcLabel":"مسلم","text":["والَّذي نفسي بيدِه ",["لا يسمعُ بي رجلٌ من هذه الأمَّةِ ، ولا يهوديٌّ ولا نصرانيٌّ ثمَّ لم يؤمِنْ بي",1]," ",["إلَّا كان من أهلِ النَّارِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (153) باختلاف يسير","bab":"إيمان › الأمر بالإيمان بالله تعالى ورسوله وشرائع الدين","dorar":"XdieR8mY"},{"id":"س-02742","fp":"ffebb493ba0b","stateId":585,"easy":"إذا أبغضت الله ورسوله وعملت بالمعصية ← وجبت لك النار","cause":"كان يُبغِضُ اللهَ ورَسولَه، ويَعمَلُ بمَعصِيةِ اللهِ، ويَسعى فيها","result":"وَجَبَت، وَجَبَت","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[55],"ref":"المستدرك على الصحيحين 1415","srcLabel":"مسلم","text":["كُنتُ قاعِدًا مع النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فمَرت جِنازةٌ، فقالَ: ما هذه الجِنازةُ؟ قالوا: جِنازةُ فُلانٍ الفُلانيِّ، كان يُحِبُّ اللهَ ورَسولَه، ويَعمَلُ بطاعةِ اللهِ، ويَسعى فيها، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: وَجَبَت، وَجَبَت، وَجَبَت ومُرَّتْ بجِنازةٍ أخرى فقالَ: ما هذه الجِنازةُ؟ قالوا: جِنازةُ فُلانٍ الفُلانيِّ، ",["كان يُبغِضُ اللهَ ورَسولَه، ويَعمَلُ بمَعصِيةِ اللهِ، ويَسعى فيها",1],"، فقالَ: ",["وَجَبَت، وَجَبَت",2],"، وَجَبَت، فقالوا: يا رَسولَ اللهِ، قَولُكَ في الجِنازةِ، والثَّناءِ عليها، أُثنِيَ على الأوَّلِ خَيرٌ، وعلى الآخَرِ شَرٌّ فقُلتَ فيها: وَجَبَت، وَجَبَت، وَجَبَت، فقالَ: نَعَم يا أبا بَكرٍ، إنَّ للهِ مَلائكةً تَنطِقُ على ألسِنةِ بني آدَمَ بما في المَرءِ منَ الخَيرِ والشَّرِّ."],"grade":"صحيح","narrator":"أنس","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه مسلم (949)، وأحمد (12938)، والبيهقي في ((الشعب)) (8876) باختلاف يسير.","bab":"إيمان › الملائكة","dorar":"HLDFANZN","merged":10,"otherRefs":["تخريج مشكل الآثار 3305 (صحيح)","مجمع الزوائد 8/3 (صحيح)","الأحاديث المختارة 2697 (صحيح)","تخريج صحيح ابن حبان 3027 (صحيح)","تخريج المسند لشعيب 12837 (صحيح)","تخريج صحيح ابن حبان 3025 (صحيح)","تخريج صحيح ابن حبان 3023 (صحيح)","تخريج المسند لشعيب 13039 (صحيح)","تخريج مشكل الآثار 3301 (صحيح)"]},{"id":"س-03033","fp":"971ab0a10e0c","stateId":585,"easy":"إذا لقيت الله تشرك به ← يدخلك النار","cause":"ومَن لَقِيَه يُشرِكُ به","result":"أدخَلَه النَّارَ","explicit":true,"repOf":"س-04235","ref":"مجموع رسائل العلائي 1/165","text":["مَن لَقِيَ اللهَ عزَّ وجلَّ لا يُشرِكُ به شَيئًا أدْخَلَه الجَنَّةَ، ",["ومَن لَقِيَه يُشرِكُ به ",1],["أدخَلَه النَّارَ",2],"."],"grade":"صحيح","narrator":"جابر","muhaddith":"إسناده على شرط مسلم","bab":"إيمان › الوعيد","dorar":"QQoyEuBE"},{"id":"س-04189","fp":"4f684f5d89fb","stateId":585,"easy":"إذا مت تجعل لله نداً ← أُدخلت النار","cause":"مَن ماتَ يَجعَلُ للَّهِ نِدًّا","result":"أُدخِلَ النَّارَ","explicit":true,"repOf":"س-03009","otherNeedIds":[20],"ref":"صحيح البخاري 6683","text":["قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم كَلِمةً، وقُلتُ أُخرى: ",["مَن ماتَ يَجعَلُ للَّهِ نِدًّا",1]," ",["أُدخِلَ النَّارَ",2],"، وقُلتُ أُخرى: مَن ماتَ لا يَجعَلُ للَّهِ نِدًّا أُدخِلَ الجَنَّةَ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (92) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"iQUU9FH0"},{"id":"س-04199","fp":"c0582af015d2","stateId":585,"easy":"إذا لقيت الله وأنت تشرك ← دخلت النار","cause":"ومَنْ لَقِيَ اللهَ عزَّ وجلَّ وهو يُشْرِكُ","result":"دَخَلَ النَّارَ","explicit":true,"repOf":"س-04235","ref":"تخريج المسند لشعيب 14711","text":["الموجِبَتانِ: مَنْ لَقِيَ اللهَ عزَّ وجَلَّ ولا يُشرِكُ به شَيئًا، دَخَلَ الجَنَّةَ، ",["ومَنْ لَقِيَ اللهَ عزَّ وجلَّ وهو يُشْرِكُ، ",1],["دَخَلَ النَّارَ",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه مسلم (93)، وأحمد (14711) واللفظ له","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"OmmbRwyz"},{"id":"س-04269","fp":"23d4266e7a26","stateId":585,"easy":"إذا مت تدعو من دون الله نداً ← دخلت النار","cause":"مَن ماتَ وهو يَدعو مِن دونِ اللهِ نِدًّا","result":"دَخَلَ النَّارَ، وقُلتُ أنا","explicit":true,"ref":"صحيح البخاري 4497","srcLabel":"مسلم","text":["قال النَّبيُّ صلَّى اللهُ عليه وسلَّم كَلِمةً وقُلتُ أُخرى، قال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ",["مَن ماتَ وهو يَدعو مِن دونِ اللهِ نِدًّا ",1],["دَخَلَ النَّارَ، وقُلتُ أنا: ",2],"مَن ماتَ وهو لا يَدعو للَّهِ نِدًّا دَخَلَ الجَنَّةَ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (92) بلفظ مقارب","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"H3qNJxlM"},{"id":"ق-0007","fp":"62e47b1f50a1","stateId":585,"easy":"الكفر والتكذيب بآيات الله ← نار وقودها الناس والحجارة","cause":"الكفر والتكذيب بآيات الله","result":"نار وقودها الناس والحجارة","explicit":true,"similar":["ق-0012","ق-0034","ق-0120","ق-0223","ق-0287","ق-0332","ق-0387","ق-0400","ق-0827","ق-0942","ق-0955","ق-1183","ق-1303","ق-1343","ق-1437"],"ref":"سورة البقرة: 24","srcLabel":"القرآن الكريم","quran":{"s":2,"from":24,"to":24,"text":"فَإِنْ لَمْ تَفْعَلُوا وَلَنْ تَفْعَلُوا فَاتَّقُوا النَّارَ الَّتِي وَقُودُهَا النَّاسُ وَالْحِجَارَةُ أُعِدَّتْ لِلْكَافِرِينَ (24)","hl":[[41,128,1]]}},{"id":"ق-0012","fp":"2c2c97376e76","stateId":585,"easy":"الكفر والتكذيب بآيات الله ← الخلود في النار","cause":"الكفر والتكذيب بآيات الله","result":"الخلود في النار","explicit":true,"repOf":"ق-0007","ref":"سورة البقرة: 39","quran":{"s":2,"from":39,"to":39,"text":"وَالَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا أُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ (39)","hl":[[0,96,1]]}},{"id":"ق-0023","fp":"6c3a898e1c5d","stateId":585,"easy":"كسب السيئة حتى تحيط الخطيئة بصاحبها ← الخلود في النار","cause":"كسب السيئة حتى تحيط الخطيئة بصاحبها","result":"الخلود في النار","explicit":true,"ref":"سورة البقرة: 81","srcLabel":"القرآن الكريم","quran":{"s":2,"from":81,"to":81,"text":"بَلَى مَنْ كَسَبَ سَيِّئَةً وَأَحَاطَتْ بِهِ خَطِيئَتُهُ فَأُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ (81)","hl":[[6,110,1]]}},{"id":"ق-0026","fp":"ba117486125b","stateId":585,"easy":"شراء الحياة الدنيا بالآخرة ← لا يخفف العذاب ولا نصرة","cause":"شراء الحياة الدنيا بالآخرة","result":"لا يخفف العذاب ولا نصرة","explicit":true,"ref":"سورة البقرة: 86","srcLabel":"القرآن الكريم","quran":{"s":2,"from":86,"to":86,"text":"أُولَئِكَ الَّذِينَ اشْتَرَوُا الْحَيَاةَ الدُّنْيَا بِالْآخِرَةِ فَلَا يُخَفَّفُ عَنْهُمُ الْعَذَابُ وَلَا هُمْ يُنْصَرُونَ (86)","hl":[[0,124,1]]}},{"id":"ق-0034","fp":"b66631d90425","stateId":585,"easy":"الكفر والتكذيب بآيات الله ← عذاب أليم","cause":"الكفر والتكذيب بآيات الله","result":"عذاب أليم","explicit":true,"repOf":"ق-0007","ref":"سورة البقرة: 104","quran":{"s":2,"from":104,"to":104,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَقُولُوا رَاعِنَا وَقُولُوا انْظُرْنَا وَاسْمَعُوا وَلِلْكَافِرِينَ عَذَابٌ أَلِيمٌ (104)","hl":[[87,119,1]]}},{"id":"ق-0044","fp":"c7f8b4c32887","stateId":585,"easy":"الكفر ← متاع قليل ثم عذاب النار","cause":"الكفر","result":"متاع قليل ثم عذاب النار","explicit":true,"similar":["ق-0161","ق-0242","ق-0304","ق-0453","ق-0482","ق-0545","ق-0634","ق-0976","ق-0985","ق-1030","ق-1062","ق-1432"],"ref":"سورة البقرة: 126","srcLabel":"القرآن الكريم","quran":{"s":2,"from":126,"to":126,"text":"وَإِذْ قَالَ إِبْرَاهِيمُ رَبِّ اجْعَلْ هَذَا بَلَدًا آمِنًا وَارْزُقْ أَهْلَهُ مِنَ الثَّمَرَاتِ مَنْ آمَنَ مِنْهُمْ بِاللَّهِ وَالْيَوْمِ الْآخِرِ قَالَ وَمَنْ كَفَرَ فَأُمَتِّعُهُ قَلِيلًا ثُمَّ أَضْطَرُّهُ إِلَى عَذَابِ النَّارِ وَبِئْسَ الْمَصِيرُ (126)","hl":[[155,252,1]]}},{"id":"ق-0120","fp":"52827592a1a4","stateId":585,"easy":"الكفر والتكذيب بآيات الله ← عذاب شديد","cause":"الكفر والتكذيب بآيات الله","result":"عذاب شديد","explicit":true,"repOf":"ق-0007","ref":"سورة آل عمران: 4","quran":{"s":3,"from":4,"to":4,"text":"مِنْ قَبْلُ هُدًى لِلنَّاسِ وَأَنْزَلَ الْفُرْقَانَ إِنَّ الَّذِينَ كَفَرُوا بِآيَاتِ اللَّهِ لَهُمْ عَذَابٌ شَدِيدٌ وَاللَّهُ عَزِيزٌ ذُو انْتِقَامٍ (4)","hl":[[52,149,1]]}},{"id":"ق-0124","fp":"01d337029149","stateId":585,"easy":"الكفر بآيات الله ← سرعة الحساب","cause":"الكفر بآيات الله","result":"سرعة الحساب","explicit":true,"ref":"سورة آل عمران: 19","srcLabel":"القرآن الكريم","quran":{"s":3,"from":19,"to":19,"text":"إِنَّ الدِّينَ عِنْدَ اللَّهِ الْإِسْلَامُ وَمَا اخْتَلَفَ الَّذِينَ أُوتُوا الْكِتَابَ إِلَّا مِنْ بَعْدِ مَا جَاءَهُمُ الْعِلْمُ بَغْيًا بَيْنَهُمْ وَمَنْ يَكْفُرْ بِآيَاتِ اللَّهِ فَإِنَّ اللَّهَ سَرِيعُ الْحِسَابِ (19)","hl":[[150,217,1]]}},{"id":"ق-0126","fp":"08e00fac175f","stateId":585,"easy":"الكفر بآيات الله وقتل الأنبياء والآمرين بالقسط ← عذاب أليم وحبوط الأعمال ولا ناصرين","cause":"الكفر بآيات الله وقتل الأنبياء والآمرين بالقسط","result":"عذاب أليم وحبوط الأعمال ولا ناصرين","explicit":true,"otherNeedIds":[45],"ref":"سورة آل عمران: 21–22","srcLabel":"القرآن الكريم","quran":{"s":3,"from":21,"to":22,"text":"إِنَّ الَّذِينَ يَكْفُرُونَ بِآيَاتِ اللَّهِ وَيَقْتُلُونَ النَّبِيِّينَ بِغَيْرِ حَقٍّ وَيَقْتُلُونَ الَّذِينَ يَأْمُرُونَ بِالْقِسْطِ مِنَ النَّاسِ فَبَشِّرْهُمْ بِعَذَابٍ أَلِيمٍ (21) أُولَئِكَ الَّذِينَ حَبِطَتْ أَعْمَالُهُمْ فِي الدُّنْيَا وَالْآخِرَةِ وَمَا لَهُمْ مِنْ نَاصِرِينَ (22)","hl":[[0,286,1]]}},{"id":"ق-0133","fp":"bff5b8c0ff66","stateId":585,"easy":"الكفر ← عذاب شديد في الدنيا والآخرة ولا ناصرين","cause":"الكفر","result":"عذاب شديد في الدنيا والآخرة ولا ناصرين","explicit":true,"similar":["ق-1020","ق-1155"],"otherNeedIds":[49],"ref":"سورة آل عمران: 56","srcLabel":"القرآن الكريم","quran":{"s":3,"from":56,"to":56,"text":"فَأَمَّا الَّذِينَ كَفَرُوا فَأُعَذِّبُهُمْ عَذَابًا شَدِيدًا فِي الدُّنْيَا وَالْآخِرَةِ وَمَا لَهُمْ مِنْ نَاصِرِينَ (56)","hl":[[0,118,1]]}},{"id":"ق-0144","fp":"d049c389d7cc","stateId":585,"easy":"الموت على الكفر ← لا تقبل الفدية وعذاب أليم ولا ناصرين","cause":"الموت على الكفر","result":"لا تقبل الفدية وعذاب أليم ولا ناصرين","explicit":true,"similar":["ق-0209"],"ref":"سورة آل عمران: 91","srcLabel":"القرآن الكريم","quran":{"s":3,"from":91,"to":91,"text":"إِنَّ الَّذِينَ كَفَرُوا وَمَاتُوا وَهُمْ كُفَّارٌ فَلَنْ يُقْبَلَ مِنْ أَحَدِهِمْ مِلْءُ الْأَرْضِ ذَهَبًا وَلَوِ افْتَدَى بِهِ أُولَئِكَ لَهُمْ عَذَابٌ أَلِيمٌ وَمَا لَهُمْ مِنْ نَاصِرِينَ (91)","hl":[[0,190,1]]}},{"id":"ق-0151","fp":"f5a09720a0ae","stateId":585,"easy":"الكفر بعد الإيمان ← اسوداد الوجه والعذاب","cause":"الكفر بعد الإيمان","result":"اسوداد الوجه والعذاب","explicit":true,"ref":"سورة آل عمران: 106","srcLabel":"القرآن الكريم","quran":{"s":3,"from":106,"to":106,"text":"يَوْمَ تَبْيَضُّ وُجُوهٌ وَتَسْوَدُّ وُجُوهٌ فَأَمَّا الَّذِينَ اسْوَدَّتْ وُجُوهُهُمْ أَكَفَرْتُمْ بَعْدَ إِيمَانِكُمْ فَذُوقُوا الْعَذَابَ بِمَا كُنْتُمْ تَكْفُرُونَ (106)","hl":[[45,167,1]]}},{"id":"ق-0156","fp":"0b016d5518f9","stateId":585,"easy":"الكفر ← لا تغني عنهم أموالهم ولا أولادهم وهم أصحاب النار","cause":"الكفر","result":"لا تغني عنهم أموالهم ولا أولادهم وهم أصحاب النار","explicit":true,"similar":["ق-1451"],"ref":"سورة آل عمران: 116","srcLabel":"القرآن الكريم","quran":{"s":3,"from":116,"to":116,"text":"إِنَّ الَّذِينَ كَفَرُوا لَنْ تُغْنِيَ عَنْهُمْ أَمْوَالُهُمْ وَلَا أَوْلَادُهُمْ مِنَ اللَّهِ شَيْئًا وَأُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ (116)","hl":[[0,156,1]]}},{"id":"ق-0161","fp":"8d47d0460539","stateId":585,"easy":"الكفر ← النار المعدّة للكافرين","cause":"الكفر","result":"النار المعدّة للكافرين","explicit":true,"repOf":"ق-0044","ref":"سورة آل عمران: 131","quran":{"s":3,"from":131,"to":131,"text":"وَاتَّقُوا النَّارَ الَّتِي أُعِدَّتْ لِلْكَافِرِينَ (131)","hl":[[0,52,1]]}},{"id":"ق-0189","fp":"5463b9f0da59","stateId":585,"easy":"المسارعة في الكفر ← لا حظّ في الآخرة وعذاب عظيم","cause":"المسارعة في الكفر","result":"لا حظّ في الآخرة وعذاب عظيم","explicit":true,"ref":"سورة آل عمران: 176","srcLabel":"القرآن الكريم","quran":{"s":3,"from":176,"to":176,"text":"وَلَا يَحْزُنْكَ الَّذِينَ يُسَارِعُونَ فِي الْكُفْرِ إِنَّهُمْ لَنْ يَضُرُّوا اللَّهَ شَيْئًا يُرِيدُ اللَّهُ أَلَّا يَجْعَلَ لَهُمْ حَظًّا فِي الْآخِرَةِ وَلَهُمْ عَذَابٌ عَظِيمٌ (176)","hl":[[17,180,1]]}},{"id":"ق-0190","fp":"f788740faff9","stateId":585,"easy":"شراء الكفر بالإيمان ← عذاب أليم","cause":"شراء الكفر بالإيمان","result":"عذاب أليم","explicit":true,"ref":"سورة آل عمران: 177","srcLabel":"القرآن الكريم","quran":{"s":3,"from":177,"to":177,"text":"إِنَّ الَّذِينَ اشْتَرَوُا الْكُفْرَ بِالْإِيمَانِ لَنْ يَضُرُّوا اللَّهَ شَيْئًا وَلَهُمْ عَذَابٌ أَلِيمٌ (177)","hl":[[0,106,1]]}},{"id":"ق-0195","fp":"f830dc9704f8","stateId":585,"easy":"سوء القول في الله وقتل الأنبياء ← عذاب الحريق بما قدمت الأيدي","cause":"سوء القول في الله وقتل الأنبياء","result":"عذاب الحريق بما قدمت الأيدي","explicit":true,"ref":"سورة آل عمران: 181–182","srcLabel":"القرآن الكريم","quran":{"s":3,"from":181,"to":182,"text":"لَقَدْ سَمِعَ اللَّهُ قَوْلَ الَّذِينَ قَالُوا إِنَّ اللَّهَ فَقِيرٌ وَنَحْنُ أَغْنِيَاءُ سَنَكْتُبُ مَا قَالُوا وَقَتْلَهُمُ الْأَنْبِيَاءَ بِغَيْرِ حَقٍّ وَنَقُولُ ذُوقُوا عَذَابَ الْحَرِيقِ (181) ذَلِكَ بِمَا قَدَّمَتْ أَيْدِيكُمْ وَأَنَّ اللَّهَ لَيْسَ بِظَلَّامٍ لِلْعَبِيدِ (182)","hl":[[0,279,1]]}},{"id":"ق-0209","fp":"fde2f549c692","stateId":585,"easy":"الموت على الكفر ← عذاب أليم","cause":"الموت على الكفر","result":"عذاب أليم","explicit":true,"repOf":"ق-0144","ref":"سورة النساء: 18","quran":{"s":4,"from":18,"to":18,"text":"وَلَيْسَتِ التَّوْبَةُ لِلَّذِينَ يَعْمَلُونَ السَّيِّئَاتِ حَتَّى إِذَا حَضَرَ أَحَدَهُمُ الْمَوْتُ قَالَ إِنِّي تُبْتُ الْآنَ وَلَا الَّذِينَ يَمُوتُونَ وَهُمْ كُفَّارٌ أُولَئِكَ أَعْتَدْنَا لَهُمْ عَذَابًا أَلِيمًا (18)","hl":[[134,217,1]]}},{"id":"ق-0223","fp":"c459da4c37c7","stateId":585,"easy":"الكفر بآيات الله ← نار تُبدَّل فيها الجلود","cause":"الكفر بآيات الله","result":"نار تُبدَّل فيها الجلود","explicit":true,"repOf":"ق-0007","ref":"سورة النساء: 56","quran":{"s":4,"from":56,"to":56,"text":"إِنَّ الَّذِينَ كَفَرُوا بِآيَاتِنَا سَوْفَ نُصْلِيهِمْ نَارًا كُلَّمَا نَضِجَتْ جُلُودُهُمْ بَدَّلْنَاهُمْ جُلُودًا غَيْرَهَا لِيَذُوقُوا الْعَذَابَ إِنَّ اللَّهَ كَانَ عَزِيزًا حَكِيمًا (56)","hl":[[0,187,1]]}},{"id":"ق-0242","fp":"6d6a4ead9177","stateId":585,"easy":"الكفر ← عذاب مهين","cause":"الكفر","result":"عذاب مهين","explicit":true,"repOf":"ق-0044","ref":"سورة النساء: 102","quran":{"s":4,"from":102,"to":102,"text":"وَإِذَا كُنْتَ فِيهِمْ فَأَقَمْتَ لَهُمُ الصَّلَاةَ فَلْتَقُمْ طَائِفَةٌ مِنْهُمْ مَعَكَ وَلْيَأْخُذُوا أَسْلِحَتَهُمْ فَإِذَا سَجَدُوا فَلْيَكُونُوا مِنْ وَرَائِكُمْ وَلْتَأْتِ طَائِفَةٌ أُخْرَى لَمْ يُصَلُّوا فَلْيُصَلُّوا مَعَكَ وَلْيَأْخُذُوا حِذْرَهُمْ وَأَسْلِحَتَهُمْ وَدَّ الَّذِينَ كَفَرُوا لَوْ تَغْفُلُونَ عَنْ أَسْلِحَتِكُمْ وَأَمْتِعَتِكُمْ فَيَمِيلُونَ عَلَيْكُمْ مَيْلَةً وَاحِدَةً وَلَا جُنَاحَ عَلَيْكُمْ إِنْ كَانَ بِكُمْ أَذًى مِنْ مَطَرٍ أَوْ كُنْتُمْ مَرْضَى أَنْ تَضَعُوا أَسْلِحَتَكُمْ وَخُذُوا حِذْرَكُمْ إِنَّ اللَّهَ أَعَدَّ لِلْكَافِرِينَ عَذَابًا مُهِينًا (102)","hl":[[543,583,1]]}},{"id":"ق-0262","fp":"93a036a4c14d","stateId":585,"easy":"النفاق ← عذاب أليم","cause":"النفاق","result":"عذاب أليم","explicit":true,"ref":"سورة النساء: 138","srcLabel":"القرآن الكريم","quran":{"s":4,"from":138,"to":138,"text":"بَشِّرِ الْمُنَافِقِينَ بِأَنَّ لَهُمْ عَذَابًا أَلِيمًا (138)","hl":[[0,56,1]]}},{"id":"ق-0267","fp":"63cd0b44755e","stateId":585,"easy":"النفاق ← الدرك الأسفل من النار ولا نصير","cause":"النفاق","result":"الدرك الأسفل من النار ولا نصير","explicit":true,"ref":"سورة النساء: 145","srcLabel":"القرآن الكريم","quran":{"s":4,"from":145,"to":145,"text":"إِنَّ الْمُنَافِقِينَ فِي الدَّرْكِ الْأَسْفَلِ مِنَ النَّارِ وَلَنْ تَجِدَ لَهُمْ نَصِيرًا (145)","hl":[[0,91,1]]}},{"id":"ق-0287","fp":"47c47f767a02","stateId":585,"easy":"الكفر والتكذيب بآيات الله ← أصحاب الجحيم","cause":"الكفر والتكذيب بآيات الله","result":"أصحاب الجحيم","explicit":true,"repOf":"ق-0007","ref":"سورة المائدة: 10","quran":{"s":5,"from":10,"to":10,"text":"وَالَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا أُولَئِكَ أَصْحَابُ الْجَحِيمِ (10)","hl":[[0,75,1]]}},{"id":"ق-0304","fp":"65494952ebe8","stateId":585,"easy":"الكفر ← لا تُقبل فدية وعذاب أليم مقيم","cause":"الكفر","result":"لا تُقبل فدية وعذاب أليم مقيم","explicit":true,"repOf":"ق-0044","ref":"سورة المائدة: 36","quran":{"s":5,"from":36,"to":36,"text":"إِنَّ الَّذِينَ كَفَرُوا لَوْ أَنَّ لَهُمْ مَا فِي الْأَرْضِ جَمِيعًا وَمِثْلَهُ مَعَهُ لِيَفْتَدُوا بِهِ مِنْ عَذَابِ يَوْمِ الْقِيَامَةِ مَا تُقُبِّلَ مِنْهُمْ وَلَهُمْ عَذَابٌ أَلِيمٌ (36)","hl":[[0,186,1]]}},{"id":"ق-0332","fp":"72f2ca2c7012","stateId":585,"easy":"الكفر والتكذيب بآيات الله ← أصحاب الجحيم","cause":"الكفر والتكذيب بآيات الله","result":"أصحاب الجحيم","explicit":true,"repOf":"ق-0007","ref":"سورة المائدة: 86","quran":{"s":5,"from":86,"to":86,"text":"وَالَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا أُولَئِكَ أَصْحَابُ الْجَحِيمِ (86)","hl":[[0,75,1]]}},{"id":"ق-0343","fp":"bb3b25b44829","stateId":585,"easy":"الكفر بعد رؤية الآية ← عذاب لا يُعذَّبه أحد من العالمين","cause":"الكفر بعد رؤية الآية","result":"عذاب لا يُعذَّبه أحد من العالمين","explicit":true,"ref":"سورة المائدة: 115","srcLabel":"القرآن الكريم","quran":{"s":5,"from":115,"to":115,"text":"قَالَ اللَّهُ إِنِّي مُنَزِّلُهَا عَلَيْكُمْ فَمَنْ يَكْفُرْ بَعْدُ مِنْكُمْ فَإِنِّي أُعَذِّبُهُ عَذَابًا لَا أُعَذِّبُهُ أَحَدًا مِنَ الْعَالَمِينَ (115)","hl":[[45,149,1]]}},{"id":"ق-0357","fp":"8d6f5a76a1f4","stateId":585,"easy":"التكذيب بالآيات والفسق ← مسّ العذاب","cause":"التكذيب بالآيات والفسق","result":"مسّ العذاب","explicit":true,"similar":["ق-0765","ق-1236","ق-1238"],"ref":"سورة الأنعام: 49","srcLabel":"القرآن الكريم","quran":{"s":6,"from":49,"to":49,"text":"وَالَّذِينَ كَذَّبُوا بِآيَاتِنَا يَمَسُّهُمُ الْعَذَابُ بِمَا كَانُوا يَفْسُقُونَ (49)","hl":[[0,82,1]]}},{"id":"ق-0360","fp":"7a1983543199","stateId":585,"easy":"اتخاذ الدين لعباً ولهواً والاغترار بالدنيا ← الإبسال بما كسبوا وشراب من حميم وعذاب أليم","cause":"اتخاذ الدين لعباً ولهواً والاغترار بالدنيا","result":"الإبسال بما كسبوا وشراب من حميم وعذاب أليم","explicit":true,"ref":"سورة الأنعام: 70","srcLabel":"القرآن الكريم","quran":{"s":6,"from":70,"to":70,"text":"وَذَرِ الَّذِينَ اتَّخَذُوا دِينَهُمْ لَعِبًا وَلَهْوًا وَغَرَّتْهُمُ الْحَيَاةُ الدُّنْيَا وَذَكِّرْ بِهِ أَنْ تُبْسَلَ نَفْسٌ بِمَا كَسَبَتْ لَيْسَ لَهَا مِنْ دُونِ اللَّهِ وَلِيٌّ وَلَا شَفِيعٌ وَإِنْ تَعْدِلْ كُلَّ عَدْلٍ لَا يُؤْخَذْ مِنْهَا أُولَئِكَ الَّذِينَ أُبْسِلُوا بِمَا كَسَبُوا لَهُمْ شَرَابٌ مِنْ حَمِيمٍ وَعَذَابٌ أَلِيمٌ بِمَا كَانُوا يَكْفُرُونَ (70)","hl":[[0,364,1]]}},{"id":"ق-0387","fp":"ea8db8b28616","stateId":585,"easy":"التكذيب بآيات الله والصدف عنها ← سوء العذاب","cause":"التكذيب بآيات الله والصدف عنها","result":"سوء العذاب","explicit":true,"repOf":"ق-0007","ref":"سورة الأنعام: 157","quran":{"s":6,"from":157,"to":157,"text":"أَوْ تَقُولُوا لَوْ أَنَّا أُنْزِلَ عَلَيْنَا الْكِتَابُ لَكُنَّا أَهْدَى مِنْهُمْ فَقَدْ جَاءَكُمْ بَيِّنَةٌ مِنْ رَبِّكُمْ وَهُدًى وَرَحْمَةٌ فَمَنْ أَظْلَمُ مِمَّنْ كَذَّبَ بِآيَاتِ اللَّهِ وَصَدَفَ عَنْهَا سَنَجْزِي الَّذِينَ يَصْدِفُونَ عَنْ آيَاتِنَا سُوءَ الْعَذَابِ بِمَا كَانُوا يَصْدِفُونَ (157)","hl":[[144,241,1]]}},{"id":"ق-0395","fp":"1f38bd53c3c5","stateId":585,"easy":"اتباع الشيطان ← جهنم","cause":"اتباع الشيطان","result":"جهنم","explicit":true,"similar":["ق-0712","ق-1070"],"ref":"سورة الأعراف: 18","srcLabel":"القرآن الكريم","quran":{"s":7,"from":18,"to":18,"text":"قَالَ اخْرُجْ مِنْهَا مَذْءُومًا مَدْحُورًا لَمَنْ تَبِعَكَ مِنْهُمْ لَأَمْلَأَنَّ جَهَنَّمَ مِنْكُمْ أَجْمَعِينَ (18)","hl":[[44,113,1]]}},{"id":"ق-0400","fp":"aa656edfa69f","stateId":585,"easy":"التكذيب بالآيات والاستكبار عنها ← الخلود في النار","cause":"التكذيب بالآيات والاستكبار عنها","result":"الخلود في النار","explicit":true,"repOf":"ق-0007","ref":"سورة الأعراف: 36","quran":{"s":7,"from":36,"to":36,"text":"وَالَّذِينَ كَذَّبُوا بِآيَاتِنَا وَاسْتَكْبَرُوا عَنْهَا أُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ (36)","hl":[[0,109,1]]}},{"id":"ق-0444","fp":"0a68dc4afc48","stateId":585,"easy":"تعطيل القلب والسمع والبصر عن الحق (الغفلة) ← كالأنعام بل أضل وذُرئوا لجهنم","cause":"تعطيل القلب والسمع والبصر عن الحق (الغفلة)","result":"كالأنعام بل أضل وذُرئوا لجهنم","explicit":true,"otherNeedIds":[19],"ref":"سورة الأعراف: 179","srcLabel":"القرآن الكريم","quran":{"s":7,"from":179,"to":179,"text":"وَلَقَدْ ذَرَأْنَا لِجَهَنَّمَ كَثِيرًا مِنَ الْجِنِّ وَالْإِنْسِ لَهُمْ قُلُوبٌ لَا يَفْقَهُونَ بِهَا وَلَهُمْ أَعْيُنٌ لَا يُبْصِرُونَ بِهَا وَلَهُمْ آذَانٌ لَا يَسْمَعُونَ بِهَا أُولَئِكَ كَالْأَنْعَامِ بَلْ هُمْ أَضَلُّ أُولَئِكَ هُمُ الْغَافِلُونَ (179)","hl":[[0,252,1]]}},{"id":"ق-0453","fp":"3fb71c2a33e1","stateId":585,"easy":"الكفر ← عذاب النار","cause":"الكفر","result":"عذاب النار","explicit":true,"repOf":"ق-0044","ref":"سورة الأنفال: 14","quran":{"s":8,"from":14,"to":14,"text":"ذَلِكُمْ فَذُوقُوهُ وَأَنَّ لِلْكَافِرِينَ عَذَابَ النَّارِ (14)","hl":[[28,59,1]]}},{"id":"ق-0461","fp":"aff822426cae","stateId":585,"easy":"الصد عن المسجد الحرام والكفر ← ذوق العذاب","cause":"الصد عن المسجد الحرام والكفر","result":"ذوق العذاب","explicit":true,"similar":["ق-0675"],"ref":"سورة الأنفال: 34–35","srcLabel":"القرآن الكريم","quran":{"s":8,"from":34,"to":35,"text":"وَمَا لَهُمْ أَلَّا يُعَذِّبَهُمُ اللَّهُ وَهُمْ يَصُدُّونَ عَنِ الْمَسْجِدِ الْحَرَامِ وَمَا كَانُوا أَوْلِيَاءَهُ إِنْ أَوْلِيَاؤُهُ إِلَّا الْمُتَّقُونَ وَلَكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ (34) وَمَا كَانَ صَلَاتُهُمْ عِنْدَ الْبَيْتِ إِلَّا مُكَاءً وَتَصْدِيَةً فَذُوقُوا الْعَذَابَ بِمَا كُنْتُمْ تَكْفُرُونَ (35)","hl":[[0,316,1]]}},{"id":"ق-0482","fp":"b2dbe31886e0","stateId":585,"easy":"التولي والكفر ← عذاب أليم","cause":"التولي والكفر","result":"عذاب أليم","explicit":true,"repOf":"ق-0044","ref":"سورة التوبة: 3","quran":{"s":9,"from":3,"to":3,"text":"وَأَذَانٌ مِنَ اللَّهِ وَرَسُولِهِ إِلَى النَّاسِ يَوْمَ الْحَجِّ الْأَكْبَرِ أَنَّ اللَّهَ بَرِيءٌ مِنَ الْمُشْرِكِينَ وَرَسُولُهُ فَإِنْ تُبْتُمْ فَهُوَ خَيْرٌ لَكُمْ وَإِنْ تَوَلَّيْتُمْ فَاعْلَمُوا أَنَّكُمْ غَيْرُ مُعْجِزِي اللَّهِ وَبَشِّرِ الَّذِينَ كَفَرُوا بِعَذَابٍ أَلِيمٍ (3)","hl":[[169,283,1]]}},{"id":"ق-0506","fp":"7c3d4ce4fbfc","stateId":585,"easy":"إيذاء النبي ﷺ ← عذاب أليم","cause":"إيذاء النبي ﷺ","result":"عذاب أليم","explicit":true,"ref":"سورة التوبة: 61","srcLabel":"القرآن الكريم","quran":{"s":9,"from":61,"to":61,"text":"وَمِنْهُمُ الَّذِينَ يُؤْذُونَ النَّبِيَّ وَيَقُولُونَ هُوَ أُذُنٌ قُلْ أُذُنُ خَيْرٍ لَكُمْ يُؤْمِنُ بِاللَّهِ وَيُؤْمِنُ لِلْمُؤْمِنِينَ وَرَحْمَةٌ لِلَّذِينَ آمَنُوا مِنْكُمْ وَالَّذِينَ يُؤْذُونَ رَسُولَ اللَّهِ لَهُمْ عَذَابٌ أَلِيمٌ (61)","hl":[[178,238,1]]}},{"id":"ق-0507","fp":"2d7ef58d19a5","stateId":585,"easy":"محادّة الله ورسوله ← نار جهنم خالداً فيها والخزي العظيم","cause":"محادّة الله ورسوله","result":"نار جهنم خالداً فيها والخزي العظيم","explicit":true,"ref":"سورة التوبة: 63","srcLabel":"القرآن الكريم","quran":{"s":9,"from":63,"to":63,"text":"أَلَمْ يَعْلَمُوا أَنَّهُ مَنْ يُحَادِدِ اللَّهَ وَرَسُولَهُ فَأَنَّ لَهُ نَارَ جَهَنَّمَ خَالِدًا فِيهَا ذَلِكَ الْخِزْيُ الْعَظِيمُ (63)","hl":[[26,133,1]]}},{"id":"ق-0510","fp":"6b2f4a91ecd9","stateId":585,"easy":"النفاق والكفر ← نار جهنم ولعنة الله وعذاب مقيم","cause":"النفاق والكفر","result":"نار جهنم ولعنة الله وعذاب مقيم","explicit":true,"otherNeedIds":[27],"ref":"سورة التوبة: 68","srcLabel":"القرآن الكريم","quran":{"s":9,"from":68,"to":68,"text":"وَعَدَ اللَّهُ الْمُنَافِقِينَ وَالْمُنَافِقَاتِ وَالْكُفَّارَ نَارَ جَهَنَّمَ خَالِدِينَ فِيهَا هِيَ حَسْبُهُمْ وَلَعَنَهُمُ اللَّهُ وَلَهُمْ عَذَابٌ مُقِيمٌ (68)","hl":[[0,158,1]]}},{"id":"ق-0515","fp":"2766120dc065","stateId":585,"easy":"التولي عن التوبة ← عذاب أليم في الدنيا والآخرة ولا وليّ ولا نصير","cause":"التولي عن التوبة","result":"عذاب أليم في الدنيا والآخرة ولا وليّ ولا نصير","explicit":true,"otherNeedIds":[49,39],"ref":"سورة التوبة: 74","srcLabel":"القرآن الكريم","quran":{"s":9,"from":74,"to":74,"text":"يَحْلِفُونَ بِاللَّهِ مَا قَالُوا وَلَقَدْ قَالُوا كَلِمَةَ الْكُفْرِ وَكَفَرُوا بَعْدَ إِسْلَامِهِمْ وَهَمُّوا بِمَا لَمْ يَنَالُوا وَمَا نَقَمُوا إِلَّا أَنْ أَغْنَاهُمُ اللَّهُ وَرَسُولُهُ مِنْ فَضْلِهِ فَإِنْ يَتُوبُوا يَكُ خَيْرًا لَهُمْ وَإِنْ يَتَوَلَّوْا يُعَذِّبْهُمُ اللَّهُ عَذَابًا أَلِيمًا فِي الدُّنْيَا وَالْآخِرَةِ وَمَا لَهُمْ فِي الْأَرْضِ مِنْ وَلِيٍّ وَلَا نَصِيرٍ (74)","hl":[[243,384,1]]}},{"id":"ق-0519","fp":"7d9dbf16e60c","stateId":585,"easy":"الفرح بالتخلف عن الجهاد ← نار جهنم أشد حراً وبكاء كثير","cause":"الفرح بالتخلف عن الجهاد","result":"نار جهنم أشد حراً وبكاء كثير","explicit":true,"ref":"سورة التوبة: 81–82","srcLabel":"القرآن الكريم","quran":{"s":9,"from":81,"to":82,"text":"فَرِحَ الْمُخَلَّفُونَ بِمَقْعَدِهِمْ خِلَافَ رَسُولِ اللَّهِ وَكَرِهُوا أَنْ يُجَاهِدُوا بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ فِي سَبِيلِ اللَّهِ وَقَالُوا لَا تَنْفِرُوا فِي الْحَرِّ قُلْ نَارُ جَهَنَّمَ أَشَدُّ حَرًّا لَوْ كَانُوا يَفْقَهُونَ (81) فَلْيَضْحَكُوا قَلِيلًا وَلْيَبْكُوا كَثِيرًا جَزَاءً بِمَا كَانُوا يَكْسِبُونَ (82)","hl":[[0,324,1]]}},{"id":"ق-0522","fp":"eee1c5fd70a1","stateId":585,"easy":"النفاق ← رجس ومأواهم جهنم","cause":"النفاق","result":"رجس ومأواهم جهنم","explicit":true,"ref":"سورة التوبة: 95","srcLabel":"القرآن الكريم","quran":{"s":9,"from":95,"to":95,"text":"سَيَحْلِفُونَ بِاللَّهِ لَكُمْ إِذَا انْقَلَبْتُمْ إِلَيْهِمْ لِتُعْرِضُوا عَنْهُمْ فَأَعْرِضُوا عَنْهُمْ إِنَّهُمْ رِجْسٌ وَمَأْوَاهُمْ جَهَنَّمُ جَزَاءً بِمَا كَانُوا يَكْسِبُونَ (95)","hl":[[106,180,1]]}},{"id":"ق-0532","fp":"84f7e19e7e90","stateId":585,"easy":"تأسيس العمل على غير التقوى (الضرار والنفاق) ← الانهيار في نار جهنم","cause":"تأسيس العمل على غير التقوى (الضرار والنفاق)","result":"الانهيار في نار جهنم","explicit":true,"otherNeedIds":[45],"ref":"سورة التوبة: 109","srcLabel":"القرآن الكريم","quran":{"s":9,"from":109,"to":109,"text":"أَفَمَنْ أَسَّسَ بُنْيَانَهُ عَلَى تَقْوَى مِنَ اللَّهِ وَرِضْوَانٍ خَيْرٌ أَمْ مَنْ أَسَّسَ بُنْيَانَهُ عَلَى شَفَا جُرُفٍ هَارٍ فَانْهَارَ بِهِ فِي نَارِ جَهَنَّمَ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ (109)","hl":[[75,165,1]]}},{"id":"ق-0545","fp":"bfafa876b30f","stateId":585,"easy":"الكفر ← شراب من حميم وعذاب أليم","cause":"الكفر","result":"شراب من حميم وعذاب أليم","explicit":true,"repOf":"ق-0044","ref":"سورة يونس: 4","quran":{"s":10,"from":4,"to":4,"text":"إِلَيْهِ مَرْجِعُكُمْ جَمِيعًا وَعْدَ اللَّهِ حَقًّا إِنَّهُ يَبْدَأُ الْخَلْقَ ثُمَّ يُعِيدُهُ لِيَجْزِيَ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ بِالْقِسْطِ وَالَّذِينَ كَفَرُوا لَهُمْ شَرَابٌ مِنْ حَمِيمٍ وَعَذَابٌ أَلِيمٌ بِمَا كَانُوا يَكْفُرُونَ (4)","hl":[[162,254,1]]}},{"id":"ق-0546","fp":"1a0f50dee80a","stateId":585,"easy":"عدم رجاء لقاء الله والرضا بالحياة الدنيا والاطمئنان بها والغفلة عن الآيات ← مأواهم النار","cause":"عدم رجاء لقاء الله والرضا بالحياة الدنيا والاطمئنان بها والغفلة عن الآيات","result":"مأواهم النار","explicit":true,"ref":"سورة يونس: 7–8","srcLabel":"القرآن الكريم","quran":{"s":10,"from":7,"to":8,"text":"إِنَّ الَّذِينَ لَا يَرْجُونَ لِقَاءَنَا وَرَضُوا بِالْحَيَاةِ الدُّنْيَا وَاطْمَأَنُّوا بِهَا وَالَّذِينَ هُمْ عَنْ آيَاتِنَا غَافِلُونَ (7) أُولَئِكَ مَأْوَاهُمُ النَّارُ بِمَا كَانُوا يَكْسِبُونَ (8)","hl":[[0,198,1]]}},{"id":"ق-0576","fp":"676a5f145f56","stateId":585,"easy":"التولي عن الاستغفار والتوبة ← عذاب يوم كبير","cause":"التولي عن الاستغفار والتوبة","result":"عذاب يوم كبير","explicit":true,"ref":"سورة هود: 3","srcLabel":"القرآن الكريم","quran":{"s":11,"from":3,"to":3,"text":"وَأَنِ اسْتَغْفِرُوا رَبَّكُمْ ثُمَّ تُوبُوا إِلَيْهِ يُمَتِّعْكُمْ مَتَاعًا حَسَنًا إِلَى أَجَلٍ مُسَمًّى وَيُؤْتِ كُلَّ ذِي فَضْلٍ فَضْلَهُ وَإِنْ تَوَلَّوْا فَإِنِّي أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ كَبِيرٍ (3)","hl":[[142,210,1]]}},{"id":"ق-0579","fp":"99e0a0eb89a7","stateId":585,"easy":"الكفر بالقرآن ← النار موعده","cause":"الكفر بالقرآن","result":"النار موعده","explicit":true,"ref":"سورة هود: 17","srcLabel":"القرآن الكريم","quran":{"s":11,"from":17,"to":17,"text":"أَفَمَنْ كَانَ عَلَى بَيِّنَةٍ مِنْ رَبِّهِ وَيَتْلُوهُ شَاهِدٌ مِنْهُ وَمِنْ قَبْلِهِ كِتَابُ مُوسَى إِمَامًا وَرَحْمَةً أُولَئِكَ يُؤْمِنُونَ بِهِ وَمَنْ يَكْفُرْ بِهِ مِنَ الْأَحْزَابِ فَالنَّارُ مَوْعِدُهُ فَلَا تَكُ فِي مِرْيَةٍ مِنْهُ إِنَّهُ الْحَقُّ مِنْ رَبِّكَ وَلَكِنَّ أَكْثَرَ النَّاسِ لَا يُؤْمِنُونَ (17)","hl":[[149,314,1]]}},{"id":"ق-0624","fp":"910d0d6a95b6","stateId":585,"easy":"عدم الاستجابة لله ← لا تقبل الفدية وسوء الحساب وجهنم","cause":"عدم الاستجابة لله","result":"لا تقبل الفدية وسوء الحساب وجهنم","explicit":true,"ref":"سورة الرعد: 18","srcLabel":"القرآن الكريم","quran":{"s":13,"from":18,"to":18,"text":"لِلَّذِينَ اسْتَجَابُوا لِرَبِّهِمُ الْحُسْنَى وَالَّذِينَ لَمْ يَسْتَجِيبُوا لَهُ لَوْ أَنَّ لَهُمْ مَا فِي الْأَرْضِ جَمِيعًا وَمِثْلَهُ مَعَهُ لَافْتَدَوْا بِهِ أُولَئِكَ لَهُمْ سُوءُ الْحِسَابِ وَمَأْوَاهُمْ جَهَنَّمُ وَبِئْسَ الْمِهَادُ (18)","hl":[[47,241,1]]}},{"id":"ق-0634","fp":"238b9cd71a77","stateId":585,"easy":"الكفر ← عقباهم النار","cause":"الكفر","result":"عقباهم النار","explicit":true,"repOf":"ق-0044","ref":"سورة الرعد: 35","quran":{"s":13,"from":35,"to":35,"text":"مَثَلُ الْجَنَّةِ الَّتِي وُعِدَ الْمُتَّقُونَ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ أُكُلُهَا دَائِمٌ وَظِلُّهَا تِلْكَ عُقْبَى الَّذِينَ اتَّقَوْا وَعُقْبَى الْكَافِرِينَ النَّارُ (35)","hl":[[147,179,1]]}},{"id":"ق-0650","fp":"8578dd3d3a98","stateId":585,"easy":"تبديل نعمة الله كفراً ← دار البوار جهنم","cause":"تبديل نعمة الله كفراً","result":"دار البوار جهنم","explicit":true,"otherNeedIds":[49],"ref":"سورة إبراهيم: 28–29","srcLabel":"القرآن الكريم","quran":{"s":14,"from":28,"to":29,"text":"أَلَمْ تَرَ إِلَى الَّذِينَ بَدَّلُوا نِعْمَتَ اللَّهِ كُفْرًا وَأَحَلُّوا قَوْمَهُمْ دَارَ الْبَوَارِ (28) جَهَنَّمَ يَصْلَوْنَهَا وَبِئْسَ الْقَرَارُ (29)","hl":[[0,151,1]]}},{"id":"ق-0675","fp":"ab5e53312a6c","stateId":585,"easy":"الكفر والصد عن سبيل الله ← زيادة عذاب فوق العذاب","cause":"الكفر والصد عن سبيل الله","result":"زيادة عذاب فوق العذاب","explicit":true,"repOf":"ق-0461","ref":"سورة النحل: 88","quran":{"s":16,"from":88,"to":88,"text":"الَّذِينَ كَفَرُوا وَصَدُّوا عَنْ سَبِيلِ اللَّهِ زِدْنَاهُمْ عَذَابًا فَوْقَ الْعَذَابِ بِمَا كَانُوا يُفْسِدُونَ (88)","hl":[[0,114,1]]}},{"id":"ق-0697","fp":"41424bfc5de1","stateId":585,"easy":"عدم الإيمان بالآخرة ← عذاب أليم","cause":"عدم الإيمان بالآخرة","result":"عذاب أليم","explicit":true,"ref":"سورة الإسراء: 10","srcLabel":"القرآن الكريم","quran":{"s":17,"from":10,"to":10,"text":"وَأَنَّ الَّذِينَ لَا يُؤْمِنُونَ بِالْآخِرَةِ أَعْتَدْنَا لَهُمْ عَذَابًا أَلِيمًا (10)","hl":[[8,83,1]]}},{"id":"ق-0701","fp":"b36b6a4468a0","stateId":585,"easy":"إرادة العاجلة وحدها ← يُعجَّل له ما شاء الله ثم جهنم مذموماً مدحوراً","cause":"إرادة العاجلة وحدها","result":"يُعجَّل له ما شاء الله ثم جهنم مذموماً مدحوراً","explicit":true,"ref":"سورة الإسراء: 18","srcLabel":"القرآن الكريم","quran":{"s":17,"from":18,"to":18,"text":"مَنْ كَانَ يُرِيدُ الْعَاجِلَةَ عَجَّلْنَا لَهُ فِيهَا مَا نَشَاءُ لِمَنْ نُرِيدُ ثُمَّ جَعَلْنَا لَهُ جَهَنَّمَ يَصْلَاهَا مَذْمُومًا مَدْحُورًا (18)","hl":[[0,145,1]]}},{"id":"ق-0709","fp":"ba28b3e97d53","stateId":585,"easy":"الشرك بالله ← الإلقاء في جهنم ملوماً مدحوراً","cause":"الشرك بالله","result":"الإلقاء في جهنم ملوماً مدحوراً","explicit":true,"ref":"سورة الإسراء: 39","srcLabel":"القرآن الكريم","quran":{"s":17,"from":39,"to":39,"text":"ذَلِكَ مِمَّا أَوْحَى إِلَيْكَ رَبُّكَ مِنَ الْحِكْمَةِ وَلَا تَجْعَلْ مَعَ اللَّهِ إِلَهًا آخَرَ فَتُلْقَى فِي جَهَنَّمَ مَلُومًا مَدْحُورًا (39)","hl":[[56,141,1]]}},{"id":"ق-0712","fp":"2bdbc91cf421","stateId":585,"easy":"اتباع الشيطان ← جهنم جزاء موفوراً","cause":"اتباع الشيطان","result":"جهنم جزاء موفوراً","explicit":true,"repOf":"ق-0395","ref":"سورة الإسراء: 63","quran":{"s":17,"from":63,"to":63,"text":"قَالَ اذْهَبْ فَمَنْ تَبِعَكَ مِنْهُمْ فَإِنَّ جَهَنَّمَ جَزَاؤُكُمْ جَزَاءً مَوْفُورًا (63)","hl":[[14,87,1]]}},{"id":"ق-0715","fp":"0bd30a6b2893","stateId":585,"easy":"العمى عن الحق في الدنيا ← العمى في الآخرة وضلال السبيل","cause":"العمى عن الحق في الدنيا","result":"العمى في الآخرة وضلال السبيل","explicit":true,"otherNeedIds":[19],"ref":"سورة الإسراء: 72","srcLabel":"القرآن الكريم","quran":{"s":17,"from":72,"to":72,"text":"وَمَنْ كَانَ فِي هَذِهِ أَعْمَى فَهُوَ فِي الْآخِرَةِ أَعْمَى وَأَضَلُّ سَبِيلًا (72)","hl":[[0,80,1]]}},{"id":"ق-0721","fp":"c091fdc1abf6","stateId":585,"easy":"الكفر بالآيات وإنكار البعث ← الحشر على الوجوه عمياً وبكماً وصماً ومأواهم جهنم","cause":"الكفر بالآيات وإنكار البعث","result":"الحشر على الوجوه عمياً وبكماً وصماً ومأواهم جهنم","explicit":true,"ref":"سورة الإسراء: 97–98","srcLabel":"القرآن الكريم","quran":{"s":17,"from":97,"to":98,"text":"وَمَنْ يَهْدِ اللَّهُ فَهُوَ الْمُهْتَدِ وَمَنْ يُضْلِلْ فَلَنْ تَجِدَ لَهُمْ أَوْلِيَاءَ مِنْ دُونِهِ وَنَحْشُرُهُمْ يَوْمَ الْقِيَامَةِ عَلَى وُجُوهِهِمْ عُمْيًا وَبُكْمًا وَصُمًّا مَأْوَاهُمْ جَهَنَّمُ كُلَّمَا خَبَتْ زِدْنَاهُمْ سَعِيرًا (97) ذَلِكَ جَزَاؤُهُمْ بِأَنَّهُمْ كَفَرُوا بِآيَاتِنَا وَقَالُوا أَإِذَا كُنَّا عِظَامًا وَرُفَاتًا أَإِنَّا لَمَبْعُوثُونَ خَلْقًا جَدِيدًا (98)","hl":[[103,384,1]]}},{"id":"ق-0740","fp":"a44685216f82","stateId":585,"easy":"الكفر ← جهنم نُزلاً","cause":"الكفر","result":"جهنم نُزلاً","explicit":true,"similar":["ق-1100"],"ref":"سورة الكهف: 102","srcLabel":"القرآن الكريم","quran":{"s":18,"from":102,"to":102,"text":"أَفَحَسِبَ الَّذِينَ كَفَرُوا أَنْ يَتَّخِذُوا عِبَادِي مِنْ دُونِي أَوْلِيَاءَ إِنَّا أَعْتَدْنَا جَهَنَّمَ لِلْكَافِرِينَ نُزُلًا (102)","hl":[[80,131,1]]}},{"id":"ق-0746","fp":"4ed0c712225a","stateId":585,"easy":"الكفر ← ويل من مشهد يوم عظيم","cause":"الكفر","result":"ويل من مشهد يوم عظيم","explicit":true,"ref":"سورة مريم: 37","srcLabel":"القرآن الكريم","quran":{"s":19,"from":37,"to":37,"text":"فَاخْتَلَفَ الْأَحْزَابُ مِنْ بَيْنِهِمْ فَوَيْلٌ لِلَّذِينَ كَفَرُوا مِنْ مَشْهَدِ يَوْمٍ عَظِيمٍ (37)","hl":[[41,98,1]]}},{"id":"ق-0765","fp":"c4111a754805","stateId":585,"easy":"التكذيب والتولي ← العذاب","cause":"التكذيب والتولي","result":"العذاب","explicit":true,"repOf":"ق-0357","ref":"سورة طه: 48","quran":{"s":20,"from":48,"to":48,"text":"إِنَّا قَدْ أُوحِيَ إِلَيْنَا أَنَّ الْعَذَابَ عَلَى مَنْ كَذَّبَ وَتَوَلَّى (48)","hl":[[30,76,1]]}},{"id":"ق-0773","fp":"cdc5b6fd2e2b","stateId":585,"easy":"الإعراض عن القرآن ← حمل الوزر يوم القيامة خالدين فيه","cause":"الإعراض عن القرآن","result":"حمل الوزر يوم القيامة خالدين فيه","explicit":true,"otherNeedIds":[12],"ref":"سورة طه: 100–101","srcLabel":"القرآن الكريم","quran":{"s":20,"from":100,"to":101,"text":"مَنْ أَعْرَضَ عَنْهُ فَإِنَّهُ يَحْمِلُ يَوْمَ الْقِيَامَةِ وِزْرًا (100) خَالِدِينَ فِيهِ وَسَاءَ لَهُمْ يَوْمَ الْقِيَامَةِ حِمْلًا (101)","hl":[[0,133,1]]}},{"id":"ق-0780","fp":"7e427093439b","stateId":585,"easy":"الإسراف وعدم الإيمان بآيات الله ← عذاب الآخرة أشد وأبقى","cause":"الإسراف وعدم الإيمان بآيات الله","result":"عذاب الآخرة أشد وأبقى","explicit":true,"ref":"سورة طه: 127","srcLabel":"القرآن الكريم","quran":{"s":20,"from":127,"to":127,"text":"وَكَذَلِكَ نَجْزِي مَنْ أَسْرَفَ وَلَمْ يُؤْمِنْ بِآيَاتِ رَبِّهِ وَلَعَذَابُ الْآخِرَةِ أَشَدُّ وَأَبْقَى (127)","hl":[[0,106,1]]}},{"id":"ق-0787","fp":"ea5bccbd77e5","stateId":585,"easy":"ادعاء الألوهية والظلم ← جهنم","cause":"ادعاء الألوهية والظلم","result":"جهنم","explicit":true,"ref":"سورة الأنبياء: 29","srcLabel":"القرآن الكريم","quran":{"s":21,"from":29,"to":29,"text":"وَمَنْ يَقُلْ مِنْهُمْ إِنِّي إِلَهٌ مِنْ دُونِهِ فَذَلِكَ نَجْزِيهِ جَهَنَّمَ كَذَلِكَ نَجْزِي الظَّالِمِينَ (29)","hl":[[0,109,1]]}},{"id":"ق-0806","fp":"5f1b481a0461","stateId":585,"easy":"الكفر ← ثياب من نار والحميم ومقامع من حديد","cause":"الكفر","result":"ثياب من نار والحميم ومقامع من حديد","explicit":true,"ref":"سورة الحج: 19–22","srcLabel":"القرآن الكريم","quran":{"s":22,"from":19,"to":22,"text":"هَذَانِ خَصْمَانِ اخْتَصَمُوا فِي رَبِّهِمْ فَالَّذِينَ كَفَرُوا قُطِّعَتْ لَهُمْ ثِيَابٌ مِنْ نَارٍ يُصَبُّ مِنْ فَوْقِ رُءُوسِهِمُ الْحَمِيمُ (19) يُصْهَرُ بِهِ مَا فِي بُطُونِهِمْ وَالْجُلُودُ (20) وَلَهُمْ مَقَامِعُ مِنْ حَدِيدٍ (21) كُلَّمَا أَرَادُوا أَنْ يَخْرُجُوا مِنْهَا مِنْ غَمٍّ أُعِيدُوا فِيهَا وَذُوقُوا عَذَابَ الْحَرِيقِ (22)","hl":[[44,337,1]]}},{"id":"ق-0823","fp":"d46fdbe68a28","stateId":585,"easy":"السعي في إبطال آيات الله ← أصحاب الجحيم","cause":"السعي في إبطال آيات الله","result":"أصحاب الجحيم","explicit":true,"ref":"سورة الحج: 51","srcLabel":"القرآن الكريم","quran":{"s":22,"from":51,"to":51,"text":"وَالَّذِينَ سَعَوْا فِي آيَاتِنَا مُعَاجِزِينَ أُولَئِكَ أَصْحَابُ الْجَحِيمِ (51)","hl":[[0,77,1]]}},{"id":"ق-0827","fp":"0cad94c2f0ef","stateId":585,"easy":"الكفر والتكذيب بآيات الله ← عذاب مهين","cause":"الكفر والتكذيب بآيات الله","result":"عذاب مهين","explicit":true,"repOf":"ق-0007","ref":"سورة الحج: 57","quran":{"s":22,"from":57,"to":57,"text":"وَالَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا فَأُولَئِكَ لَهُمْ عَذَابٌ مُهِينٌ (57)","hl":[[0,79,1]]}},{"id":"ق-0871","fp":"49dd4c953f5a","stateId":585,"easy":"التكذيب بالساعة ← السعير","cause":"التكذيب بالساعة","result":"السعير","explicit":true,"ref":"سورة الفرقان: 11","srcLabel":"القرآن الكريم","quran":{"s":25,"from":11,"to":11,"text":"بَلْ كَذَّبُوا بِالسَّاعَةِ وَأَعْتَدْنَا لِمَنْ كَذَّبَ بِالسَّاعَةِ سَعِيرًا (11)","hl":[[28,78,1]]}},{"id":"ق-0890","fp":"1a5b19dfb4d4","stateId":585,"easy":"الغواية ← إبراز الجحيم","cause":"الغواية","result":"إبراز الجحيم","explicit":true,"ref":"سورة الشعراء: 91","srcLabel":"القرآن الكريم","quran":{"s":26,"from":91,"to":91,"text":"وَبُرِّزَتِ الْجَحِيمُ لِلْغَاوِينَ (91)","hl":[[0,35,1]]}},{"id":"ق-0907","fp":"deff100a96a5","stateId":585,"easy":"الظلم بالتكذيب ← وقوع القول عليهم","cause":"الظلم بالتكذيب","result":"وقوع القول عليهم","explicit":true,"ref":"سورة النمل: 85","srcLabel":"القرآن الكريم","quran":{"s":27,"from":85,"to":85,"text":"وَوَقَعَ الْقَوْلُ عَلَيْهِمْ بِمَا ظَلَمُوا فَهُمْ لَا يَنْطِقُونَ (85)","hl":[[0,67,1]]}},{"id":"ق-0942","fp":"4e5be44b6b0e","stateId":585,"easy":"الكفر بآيات الله ولقائه ← اليأس من رحمة الله وعذاب أليم","cause":"الكفر بآيات الله ولقائه","result":"اليأس من رحمة الله وعذاب أليم","explicit":true,"repOf":"ق-0007","otherNeedIds":[10],"ref":"سورة العنكبوت: 23","quran":{"s":29,"from":23,"to":23,"text":"وَالَّذِينَ كَفَرُوا بِآيَاتِ اللَّهِ وَلِقَائِهِ أُولَئِكَ يَئِسُوا مِنْ رَحْمَتِي وَأُولَئِكَ لَهُمْ عَذَابٌ أَلِيمٌ (23)","hl":[[0,118,1]]}},{"id":"ق-0955","fp":"6bdf52a513a0","stateId":585,"easy":"الكفر والتكذيب بآيات الله ← في العذاب محضرون","cause":"الكفر والتكذيب بآيات الله","result":"في العذاب محضرون","explicit":true,"repOf":"ق-0007","ref":"سورة الروم: 16","quran":{"s":30,"from":16,"to":16,"text":"وَأَمَّا الَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا وَلِقَاءِ الْآخِرَةِ فَأُولَئِكَ فِي الْعَذَابِ مُحْضَرُونَ (16)","hl":[[0,111,1]]}},{"id":"ق-0970","fp":"c80b00d375a4","stateId":585,"easy":"شراء لهو الحديث للإضلال والاستكبار عن آيات الله ← عذاب مهين وأليم","cause":"شراء لهو الحديث للإضلال والاستكبار عن آيات الله","result":"عذاب مهين وأليم","explicit":true,"ref":"سورة لقمان: 6–7","srcLabel":"القرآن الكريم","quran":{"s":31,"from":6,"to":7,"text":"وَمِنَ النَّاسِ مَنْ يَشْتَرِي لَهْوَ الْحَدِيثِ لِيُضِلَّ عَنْ سَبِيلِ اللَّهِ بِغَيْرِ عِلْمٍ وَيَتَّخِذَهَا هُزُوًا أُولَئِكَ لَهُمْ عَذَابٌ مُهِينٌ (6) وَإِذَا تُتْلَى عَلَيْهِ آيَاتُنَا وَلَّى مُسْتَكْبِرًا كَأَنْ لَمْ يَسْمَعْهَا كَأَنَّ فِي أُذُنَيْهِ وَقْرًا فَبَشِّرْهُ بِعَذَابٍ أَلِيمٍ (7)","hl":[[0,296,1]]}},{"id":"ق-0976","fp":"fcb16723add3","stateId":585,"easy":"الكفر ← متاع قليل ثم عذاب غليظ","cause":"الكفر","result":"متاع قليل ثم عذاب غليظ","explicit":true,"repOf":"ق-0044","ref":"سورة لقمان: 23–24","quran":{"s":31,"from":23,"to":24,"text":"وَمَنْ كَفَرَ فَلَا يَحْزُنْكَ كُفْرُهُ إِلَيْنَا مَرْجِعُهُمْ فَنُنَبِّئُهُمْ بِمَا عَمِلُوا إِنَّ اللَّهَ عَلِيمٌ بِذَاتِ الصُّدُورِ (23) نُمَتِّعُهُمْ قَلِيلًا ثُمَّ نَضْطَرُّهُمْ إِلَى عَذَابٍ غَلِيظٍ (24)","hl":[[0,204,1]]}},{"id":"ق-0977","fp":"4b129cdabaeb","stateId":585,"easy":"نسيان لقاء الله ← نسيان الله لهم وعذاب الخلد","cause":"نسيان لقاء الله","result":"نسيان الله لهم وعذاب الخلد","explicit":true,"ref":"سورة السجدة: 14","srcLabel":"القرآن الكريم","quran":{"s":32,"from":14,"to":14,"text":"فَذُوقُوا بِمَا نَسِيتُمْ لِقَاءَ يَوْمِكُمْ هَذَا إِنَّا نَسِينَاكُمْ وَذُوقُوا عَذَابَ الْخُلْدِ بِمَا كُنْتُمْ تَعْمَلُونَ (14)","hl":[[0,125,1]]}},{"id":"ق-0985","fp":"91b40ddd078e","stateId":585,"easy":"الكفر ← عذاب أليم","cause":"الكفر","result":"عذاب أليم","explicit":true,"repOf":"ق-0044","ref":"سورة الأحزاب: 8","quran":{"s":33,"from":8,"to":8,"text":"لِيَسْأَلَ الصَّادِقِينَ عَنْ صِدْقِهِمْ وَأَعَدَّ لِلْكَافِرِينَ عَذَابًا أَلِيمًا (8)","hl":[[41,83,1]]}},{"id":"ق-1006","fp":"1265e2b61659","stateId":585,"easy":"السعي في إبطال آيات الله ← عذاب من رجز أليم","cause":"السعي في إبطال آيات الله","result":"عذاب من رجز أليم","explicit":true,"similar":["ق-1014"],"ref":"سورة سبأ: 5","srcLabel":"القرآن الكريم","quran":{"s":34,"from":5,"to":5,"text":"وَالَّذِينَ سَعَوْا فِي آيَاتِنَا مُعَاجِزِينَ أُولَئِكَ لَهُمْ عَذَابٌ مِنْ رِجْزٍ أَلِيمٌ (5)","hl":[[0,91,1]]}},{"id":"ق-1014","fp":"bd2e6970b007","stateId":585,"easy":"السعي في إبطال آيات الله ← الإحضار في العذاب","cause":"السعي في إبطال آيات الله","result":"الإحضار في العذاب","explicit":true,"repOf":"ق-1006","ref":"سورة سبأ: 38","quran":{"s":34,"from":38,"to":38,"text":"وَالَّذِينَ يَسْعَوْنَ فِي آيَاتِنَا مُعَاجِزِينَ أُولَئِكَ فِي الْعَذَابِ مُحْضَرُونَ (38)","hl":[[0,86,1]]}},{"id":"ق-1019","fp":"e7be0b1e7339","stateId":585,"easy":"اتباع الشيطان والدخول في حزبه ← أصحاب السعير","cause":"اتباع الشيطان والدخول في حزبه","result":"أصحاب السعير","explicit":true,"otherNeedIds":[32],"ref":"سورة فاطر: 6","srcLabel":"القرآن الكريم","quran":{"s":35,"from":6,"to":6,"text":"إِنَّ الشَّيْطَانَ لَكُمْ عَدُوٌّ فَاتَّخِذُوهُ عَدُوًّا إِنَّمَا يَدْعُو حِزْبَهُ لِيَكُونُوا مِنْ أَصْحَابِ السَّعِيرِ (6)","hl":[[0,120,1]]}},{"id":"ق-1020","fp":"c7e96bd912ba","stateId":585,"easy":"الكفر ← عذاب شديد","cause":"الكفر","result":"عذاب شديد","explicit":true,"repOf":"ق-0133","ref":"سورة فاطر: 7","quran":{"s":35,"from":7,"to":7,"text":"الَّذِينَ كَفَرُوا لَهُمْ عَذَابٌ شَدِيدٌ وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ مَغْفِرَةٌ وَأَجْرٌ كَبِيرٌ (7)","hl":[[0,41,1]]}},{"id":"ق-1030","fp":"7fcbe5794760","stateId":585,"easy":"الكفر ← نار جهنم لا يقضى عليهم ولا يخفف من عذابها","cause":"الكفر","result":"نار جهنم لا يقضى عليهم ولا يخفف من عذابها","explicit":true,"repOf":"ق-0044","ref":"سورة فاطر: 36","quran":{"s":35,"from":36,"to":36,"text":"وَالَّذِينَ كَفَرُوا لَهُمْ نَارُ جَهَنَّمَ لَا يُقْضَى عَلَيْهِمْ فَيَمُوتُوا وَلَا يُخَفَّفُ عَنْهُمْ مِنْ عَذَابِهَا كَذَلِكَ نَجْزِي كُلَّ كَفُورٍ (36)","hl":[[0,150,1]]}},{"id":"ق-1044","fp":"ddb794dc7249","stateId":585,"easy":"تقليد الآباء الضالين ← شجرة الزقوم والحميم والجحيم","cause":"تقليد الآباء الضالين","result":"شجرة الزقوم والحميم والجحيم","explicit":true,"ref":"سورة الصافات: 62–70","srcLabel":"القرآن الكريم","quran":{"s":37,"from":62,"to":70,"text":"أَذَلِكَ خَيْرٌ نُزُلًا أَمْ شَجَرَةُ الزَّقُّومِ (62) إِنَّا جَعَلْنَاهَا فِتْنَةً لِلظَّالِمِينَ (63) إِنَّهَا شَجَرَةٌ تَخْرُجُ فِي أَصْلِ الْجَحِيمِ (64) طَلْعُهَا كَأَنَّهُ رُءُوسُ الشَّيَاطِينِ (65) فَإِنَّهُمْ لَآكِلُونَ مِنْهَا فَمَالِئُونَ مِنْهَا الْبُطُونَ (66) ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِنْ حَمِيمٍ (67) ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى الْجَحِيمِ (68) إِنَّهُمْ أَلْفَوْا آبَاءَهُمْ ضَالِّينَ (69) فَهُمْ عَلَى آثَارِهِمْ يُهْرَعُونَ (70)","hl":[[0,460,1]]}},{"id":"ق-1052","fp":"e105493d1cc1","stateId":585,"easy":"التكذيب ← الإحضار للعذاب إلا المخلصين","cause":"التكذيب","result":"الإحضار للعذاب إلا المخلصين","explicit":true,"ref":"سورة الصافات: 127–128","srcLabel":"القرآن الكريم","quran":{"s":37,"from":127,"to":128,"text":"فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ (127) إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ (128)","hl":[[0,82,1]]}},{"id":"ق-1062","fp":"ff8c805dc427","stateId":585,"easy":"الكفر ← ويل من النار","cause":"الكفر","result":"ويل من النار","explicit":true,"repOf":"ق-0044","ref":"سورة ص: 27","quran":{"s":38,"from":27,"to":27,"text":"وَمَا خَلَقْنَا السَّمَاءَ وَالْأَرْضَ وَمَا بَيْنَهُمَا بَاطِلًا ذَلِكَ ظَنُّ الَّذِينَ كَفَرُوا فَوَيْلٌ لِلَّذِينَ كَفَرُوا مِنَ النَّارِ (27)","hl":[[98,140,1]]}},{"id":"ق-1070","fp":"ab3b607aa62f","stateId":585,"easy":"اتباع إبليس ← جهنم","cause":"اتباع إبليس","result":"جهنم","explicit":true,"repOf":"ق-0395","ref":"سورة ص: 85","quran":{"s":38,"from":85,"to":85,"text":"لَأَمْلَأَنَّ جَهَنَّمَ مِنْكَ وَمِمَّنْ تَبِعَكَ مِنْهُمْ أَجْمَعِينَ (85)","hl":[[0,70,1]]}},{"id":"ق-1073","fp":"dd24d2534d60","stateId":585,"easy":"نسيان الله عند النعمة والشرك بعد كشف الضر ← أصحاب النار","cause":"نسيان الله عند النعمة والشرك بعد كشف الضر","result":"أصحاب النار","explicit":true,"ref":"سورة الزمر: 8","srcLabel":"القرآن الكريم","quran":{"s":39,"from":8,"to":8,"text":"وَإِذَا مَسَّ الْإِنْسَانَ ضُرٌّ دَعَا رَبَّهُ مُنِيبًا إِلَيْهِ ثُمَّ إِذَا خَوَّلَهُ نِعْمَةً مِنْهُ نَسِيَ مَا كَانَ يَدْعُو إِلَيْهِ مِنْ قَبْلُ وَجَعَلَ لِلَّهِ أَنْدَادًا لِيُضِلَّ عَنْ سَبِيلِهِ قُلْ تَمَتَّعْ بِكُفْرِكَ قَلِيلًا إِنَّكَ مِنْ أَصْحَابِ النَّارِ (8)","hl":[[0,268,1]]}},{"id":"ق-1086","fp":"5527f8220187","stateId":585,"easy":"الكذب على الله والتكذيب بالصدق ← مثوى في جهنم","cause":"الكذب على الله والتكذيب بالصدق","result":"مثوى في جهنم","explicit":true,"ref":"سورة الزمر: 32","srcLabel":"القرآن الكريم","quran":{"s":39,"from":32,"to":32,"text":"فَمَنْ أَظْلَمُ مِمَّنْ كَذَبَ عَلَى اللَّهِ وَكَذَّبَ بِالصِّدْقِ إِذْ جَاءَهُ أَلَيْسَ فِي جَهَنَّمَ مَثْوًى لِلْكَافِرِينَ (32)","hl":[[0,125,1]]}},{"id":"ق-1100","fp":"23bcabd5e8c1","stateId":585,"easy":"الكفر ← السَّوق إلى جهنم زمراً","cause":"الكفر","result":"السَّوق إلى جهنم زمراً","explicit":true,"repOf":"ق-0740","ref":"سورة الزمر: 71–72","quran":{"s":39,"from":71,"to":72,"text":"وَسِيقَ الَّذِينَ كَفَرُوا إِلَى جَهَنَّمَ زُمَرًا حَتَّى إِذَا جَاءُوهَا فُتِحَتْ أَبْوَابُهَا وَقَالَ لَهُمْ خَزَنَتُهَا أَلَمْ يَأْتِكُمْ رُسُلٌ مِنْكُمْ يَتْلُونَ عَلَيْكُمْ آيَاتِ رَبِّكُمْ وَيُنْذِرُونَكُمْ لِقَاءَ يَوْمِكُمْ هَذَا قَالُوا بَلَى وَلَكِنْ حَقَّتْ كَلِمَةُ الْعَذَابِ عَلَى الْكَافِرِينَ (71) قِيلَ ادْخُلُوا أَبْوَابَ جَهَنَّمَ خَالِدِينَ فِيهَا فَبِئْسَ مَثْوَى الْمُتَكَبِّرِينَ (72)","hl":[[0,402,1]]}},{"id":"ق-1116","fp":"400d40b133c7","stateId":585,"easy":"اتباع المستكبرين ← لا يغنون عنهم نصيباً من النار","cause":"اتباع المستكبرين","result":"لا يغنون عنهم نصيباً من النار","explicit":true,"otherNeedIds":[50],"ref":"سورة غافر: 47–48","srcLabel":"القرآن الكريم","quran":{"s":40,"from":47,"to":48,"text":"وَإِذْ يَتَحَاجُّونَ فِي النَّارِ فَيَقُولُ الضُّعَفَاءُ لِلَّذِينَ اسْتَكْبَرُوا إِنَّا كُنَّا لَكُمْ تَبَعًا فَهَلْ أَنْتُمْ مُغْنُونَ عَنَّا نَصِيبًا مِنَ النَّارِ (47) قَالَ الَّذِينَ اسْتَكْبَرُوا إِنَّا كُلٌّ فِيهَا إِنَّ اللَّهَ قَدْ حَكَمَ بَيْنَ الْعِبَادِ (48)","hl":[[0,265,1]]}},{"id":"ق-1123","fp":"33763b10417c","stateId":585,"easy":"الجدال في آيات الله والتكذيب بالكتاب ← الأغلال والسلاسل والسحب في الحميم والسجر في النار","cause":"الجدال في آيات الله والتكذيب بالكتاب","result":"الأغلال والسلاسل والسحب في الحميم والسجر في النار","explicit":true,"ref":"سورة غافر: 69–72","srcLabel":"القرآن الكريم","quran":{"s":40,"from":69,"to":72,"text":"أَلَمْ تَرَ إِلَى الَّذِينَ يُجَادِلُونَ فِي آيَاتِ اللَّهِ أَنَّى يُصْرَفُونَ (69) الَّذِينَ كَذَّبُوا بِالْكِتَابِ وَبِمَا أَرْسَلْنَا بِهِ رُسُلَنَا فَسَوْفَ يَعْلَمُونَ (70) إِذِ الْأَغْلَالُ فِي أَعْنَاقِهِمْ وَالسَّلَاسِلُ يُسْحَبُونَ (71) فِي الْحَمِيمِ ثُمَّ فِي النَّارِ يُسْجَرُونَ (72)","hl":[[0,291,1]]}},{"id":"ق-1134","fp":"fe6544edbc78","stateId":585,"easy":"اللغو في القرآن وجحود الآيات ← أسوأ الجزاء: النار دار الخلد","cause":"اللغو في القرآن وجحود الآيات","result":"أسوأ الجزاء: النار دار الخلد","explicit":true,"ref":"سورة فصلت: 26–28","srcLabel":"القرآن الكريم","quran":{"s":41,"from":26,"to":28,"text":"وَقَالَ الَّذِينَ كَفَرُوا لَا تَسْمَعُوا لِهَذَا الْقُرْآنِ وَالْغَوْا فِيهِ لَعَلَّكُمْ تَغْلِبُونَ (26) فَلَنُذِيقَنَّ الَّذِينَ كَفَرُوا عَذَابًا شَدِيدًا وَلَنَجْزِيَنَّهُمْ أَسْوَأَ الَّذِي كَانُوا يَعْمَلُونَ (27) ذَلِكَ جَزَاءُ أَعْدَاءِ اللَّهِ النَّارُ لَهُمْ فِيهَا دَارُ الْخُلْدِ جَزَاءً بِمَا كَانُوا بِآيَاتِنَا يَجْحَدُونَ (28)","hl":[[0,338,1]]}},{"id":"ق-1138","fp":"013a0ebdfc47","stateId":585,"easy":"الإلحاد في آيات الله والكفر بالذكر ← الإلقاء في النار","cause":"الإلحاد في آيات الله والكفر بالذكر","result":"الإلقاء في النار","explicit":true,"ref":"سورة فصلت: 40","srcLabel":"القرآن الكريم","quran":{"s":41,"from":40,"to":40,"text":"إِنَّ الَّذِينَ يُلْحِدُونَ فِي آيَاتِنَا لَا يَخْفَوْنَ عَلَيْنَا أَفَمَنْ يُلْقَى فِي النَّارِ خَيْرٌ أَمْ مَنْ يَأْتِي آمِنًا يَوْمَ الْقِيَامَةِ اعْمَلُوا مَا شِئْتُمْ إِنَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ (40)","hl":[[0,148,1]]}},{"id":"ق-1143","fp":"923afae988ba","stateId":585,"easy":"نسبة النعمة إلى النفس وإنكار الساعة بعد الرحمة ← عذاب غليظ","cause":"نسبة النعمة إلى النفس وإنكار الساعة بعد الرحمة","result":"عذاب غليظ","explicit":true,"ref":"سورة فصلت: 50","srcLabel":"القرآن الكريم","quran":{"s":41,"from":50,"to":50,"text":"وَلَئِنْ أَذَقْنَاهُ رَحْمَةً مِنَّا مِنْ بَعْدِ ضَرَّاءَ مَسَّتْهُ لَيَقُولَنَّ هَذَا لِي وَمَا أَظُنُّ السَّاعَةَ قَائِمَةً وَلَئِنْ رُجِعْتُ إِلَى رَبِّي إِنَّ لِي عِنْدَهُ لَلْحُسْنَى فَلَنُنَبِّئَنَّ الَّذِينَ كَفَرُوا بِمَا عَمِلُوا وَلَنُذِيقَنَّهُمْ مِنْ عَذَابٍ غَلِيظٍ (50)","hl":[[0,278,1]]}},{"id":"ق-1155","fp":"b6695cadda4f","stateId":585,"easy":"الكفر ← عذاب شديد","cause":"الكفر","result":"عذاب شديد","explicit":true,"repOf":"ق-0133","ref":"سورة الشورى: 26","quran":{"s":42,"from":26,"to":26,"text":"وَيَسْتَجِيبُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَيَزِيدُهُمْ مِنْ فَضْلِهِ وَالْكَافِرُونَ لَهُمْ عَذَابٌ شَدِيدٌ (26)","hl":[[85,123,1]]}},{"id":"ق-1183","fp":"29df5f37acd9","stateId":585,"easy":"الكفر بآيات الله ← عذاب من رجز أليم","cause":"الكفر بآيات الله","result":"عذاب من رجز أليم","explicit":true,"repOf":"ق-0007","ref":"سورة الجاثية: 11","quran":{"s":45,"from":11,"to":11,"text":"هَذَا هُدًى وَالَّذِينَ كَفَرُوا بِآيَاتِ رَبِّهِمْ لَهُمْ عَذَابٌ مِنْ رِجْزٍ أَلِيمٌ (11)","hl":[[12,86,1]]}},{"id":"ق-1190","fp":"ce4f19534f7f","stateId":585,"easy":"اتخاذ آيات الله هزواً والاغترار بالدنيا ونسيان لقاء الله ← نسيان الله لهم والنار ولا ناصرين","cause":"اتخاذ آيات الله هزواً والاغترار بالدنيا ونسيان لقاء الله","result":"نسيان الله لهم والنار ولا ناصرين","explicit":true,"ref":"سورة الجاثية: 33–35","srcLabel":"القرآن الكريم","quran":{"s":45,"from":33,"to":35,"text":"وَبَدَا لَهُمْ سَيِّئَاتُ مَا عَمِلُوا وَحَاقَ بِهِمْ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ (33) وَقِيلَ الْيَوْمَ نَنْسَاكُمْ كَمَا نَسِيتُمْ لِقَاءَ يَوْمِكُمْ هَذَا وَمَأْوَاكُمُ النَّارُ وَمَا لَكُمْ مِنْ نَاصِرِينَ (34) ذَلِكُمْ بِأَنَّكُمُ اتَّخَذْتُمْ آيَاتِ اللَّهِ هُزُوًا وَغَرَّتْكُمُ الْحَيَاةُ الدُّنْيَا فَالْيَوْمَ لَا يُخْرَجُونَ مِنْهَا وَلَا هُمْ يُسْتَعْتَبُونَ (35)","hl":[[0,375,1]]}},{"id":"ق-1213","fp":"5785aeabafd0","stateId":585,"easy":"الكفر ← تمتّع وأكل كالأنعام والنار مثوى لهم","cause":"الكفر","result":"تمتّع وأكل كالأنعام والنار مثوى لهم","explicit":true,"ref":"سورة محمد: 12","srcLabel":"القرآن الكريم","quran":{"s":47,"from":12,"to":12,"text":"إِنَّ اللَّهَ يُدْخِلُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ وَالَّذِينَ كَفَرُوا يَتَمَتَّعُونَ وَيَأْكُلُونَ كَمَا تَأْكُلُ الْأَنْعَامُ وَالنَّارُ مَثْوًى لَهُمْ (12)","hl":[[111,214,1]]}},{"id":"ق-1224","fp":"6beb6f35bd14","stateId":585,"easy":"الكفر والصد عن سبيل الله ثم الموت على الكفر ← لن يغفر الله لهم","cause":"الكفر والصد عن سبيل الله ثم الموت على الكفر","result":"لن يغفر الله لهم","explicit":true,"ref":"سورة محمد: 34","srcLabel":"القرآن الكريم","quran":{"s":47,"from":34,"to":34,"text":"إِنَّ الَّذِينَ كَفَرُوا وَصَدُّوا عَنْ سَبِيلِ اللَّهِ ثُمَّ مَاتُوا وَهُمْ كُفَّارٌ فَلَنْ يَغْفِرَ اللَّهُ لَهُمْ (34)","hl":[[0,116,1]]}},{"id":"ق-1234","fp":"9824e5a4153b","stateId":585,"easy":"عدم الإيمان بالله ورسوله ← السعير","cause":"عدم الإيمان بالله ورسوله","result":"السعير","explicit":true,"ref":"سورة الفتح: 13","srcLabel":"القرآن الكريم","quran":{"s":48,"from":13,"to":13,"text":"وَمَنْ لَمْ يُؤْمِنْ بِاللَّهِ وَرَسُولِهِ فَإِنَّا أَعْتَدْنَا لِلْكَافِرِينَ سَعِيرًا (13)","hl":[[0,87,1]]}},{"id":"ق-1236","fp":"724fc99b038d","stateId":585,"easy":"التولي ← عذاب أليم","cause":"التولي","result":"عذاب أليم","explicit":true,"repOf":"ق-0357","ref":"سورة الفتح: 16","quran":{"s":48,"from":16,"to":16,"text":"قُلْ لِلْمُخَلَّفِينَ مِنَ الْأَعْرَابِ سَتُدْعَوْنَ إِلَى قَوْمٍ أُولِي بَأْسٍ شَدِيدٍ تُقَاتِلُونَهُمْ أَوْ يُسْلِمُونَ فَإِنْ تُطِيعُوا يُؤْتِكُمُ اللَّهُ أَجْرًا حَسَنًا وَإِنْ تَتَوَلَّوْا كَمَا تَوَلَّيْتُمْ مِنْ قَبْلُ يُعَذِّبْكُمْ عَذَابًا أَلِيمًا (16)","hl":[[174,257,1]]}},{"id":"ق-1238","fp":"ca9d5c6cc76d","stateId":585,"easy":"التولي ← عذاب أليم","cause":"التولي","result":"عذاب أليم","explicit":true,"repOf":"ق-0357","ref":"سورة الفتح: 17","quran":{"s":48,"from":17,"to":17,"text":"لَيْسَ عَلَى الْأَعْمَى حَرَجٌ وَلَا عَلَى الْأَعْرَجِ حَرَجٌ وَلَا عَلَى الْمَرِيضِ حَرَجٌ وَمَنْ يُطِعِ اللَّهَ وَرَسُولَهُ يُدْخِلْهُ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ وَمَنْ يَتَوَلَّ يُعَذِّبْهُ عَذَابًا أَلِيمًا (17)","hl":[[182,228,1]]}},{"id":"ق-1255","fp":"0d44d9e56257","stateId":585,"easy":"الكفر والعناد ومنع الخير والاعتداء والريبة والشرك ← العذاب الشديد في جهنم","cause":"الكفر والعناد ومنع الخير والاعتداء والريبة والشرك","result":"العذاب الشديد في جهنم","explicit":true,"ref":"سورة ق: 24–26","srcLabel":"القرآن الكريم","quran":{"s":50,"from":24,"to":26,"text":"أَلْقِيَا فِي جَهَنَّمَ كُلَّ كَفَّارٍ عَنِيدٍ (24) مَنَّاعٍ لِلْخَيْرِ مُعْتَدٍ مُرِيبٍ (25) الَّذِي جَعَلَ مَعَ اللَّهِ إِلَهًا آخَرَ فَأَلْقِيَاهُ فِي الْعَذَابِ الشَّدِيدِ (26)","hl":[[0,175,1]]}},{"id":"ق-1267","fp":"99b96098f17f","stateId":585,"easy":"التكذيب والخوض واللعب ← الويل والدعّ إلى نار جهنم","cause":"التكذيب والخوض واللعب","result":"الويل والدعّ إلى نار جهنم","explicit":true,"ref":"سورة الطور: 11–16","srcLabel":"القرآن الكريم","quran":{"s":52,"from":11,"to":16,"text":"فَوَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ (11) الَّذِينَ هُمْ فِي خَوْضٍ يَلْعَبُونَ (12) يَوْمَ يُدَعُّونَ إِلَى نَارِ جَهَنَّمَ دَعًّا (13) هَذِهِ النَّارُ الَّتِي كُنْتُمْ بِهَا تُكَذِّبُونَ (14) أَفَسِحْرٌ هَذَا أَمْ أَنْتُمْ لَا تُبْصِرُونَ (15) اصْلَوْهَا فَاصْبِرُوا أَوْ لَا تَصْبِرُوا سَوَاءٌ عَلَيْكُمْ إِنَّمَا تُجْزَوْنَ مَا كُنْتُمْ تَعْمَلُونَ (16)","hl":[[0,352,1]]}},{"id":"ق-1299","fp":"86b082016ec0","stateId":585,"easy":"النفاق: فتنة النفس والتربص والارتياب والاغترار بالأماني ← الحرمان من النور ولا تؤخذ فدية ومأواهم النار","cause":"النفاق: فتنة النفس والتربص والارتياب والاغترار بالأماني","result":"الحرمان من النور ولا تؤخذ فدية ومأواهم النار","explicit":true,"otherNeedIds":[58],"ref":"سورة الحديد: 13–15","srcLabel":"القرآن الكريم","quran":{"s":57,"from":13,"to":15,"text":"يَوْمَ يَقُولُ الْمُنَافِقُونَ وَالْمُنَافِقَاتُ لِلَّذِينَ آمَنُوا انْظُرُونَا نَقْتَبِسْ مِنْ نُورِكُمْ قِيلَ ارْجِعُوا وَرَاءَكُمْ فَالْتَمِسُوا نُورًا فَضُرِبَ بَيْنَهُمْ بِسُورٍ لَهُ بَابٌ بَاطِنُهُ فِيهِ الرَّحْمَةُ وَظَاهِرُهُ مِنْ قِبَلِهِ الْعَذَابُ (13) يُنَادُونَهُمْ أَلَمْ نَكُنْ مَعَكُمْ قَالُوا بَلَى وَلَكِنَّكُمْ فَتَنْتُمْ أَنْفُسَكُمْ وَتَرَبَّصْتُمْ وَارْتَبْتُمْ وَغَرَّتْكُمُ الْأَمَانِيُّ حَتَّى جَاءَ أَمْرُ اللَّهِ وَغَرَّكُمْ بِاللَّهِ الْغَرُورُ (14) فَالْيَوْمَ لَا يُؤْخَذُ مِنْكُمْ فِدْيَةٌ وَلَا مِنَ الَّذِينَ كَفَرُوا مَأْوَاكُمُ النَّارُ هِيَ مَوْلَاكُمْ وَبِئْسَ الْمَصِيرُ (15)","hl":[[0,608,1]]}},{"id":"ق-1303","fp":"d92c656927a2","stateId":585,"easy":"الكفر والتكذيب بآيات الله ← أصحاب الجحيم","cause":"الكفر والتكذيب بآيات الله","result":"أصحاب الجحيم","explicit":true,"repOf":"ق-0007","ref":"سورة الحديد: 19","quran":{"s":57,"from":19,"to":19,"text":"وَالَّذِينَ آمَنُوا بِاللَّهِ وَرُسُلِهِ أُولَئِكَ هُمُ الصِّدِّيقُونَ وَالشُّهَدَاءُ عِنْدَ رَبِّهِمْ لَهُمْ أَجْرُهُمْ وَنُورُهُمْ وَالَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا أُولَئِكَ أَصْحَابُ الْجَحِيمِ (19)","hl":[[133,208,1]]}},{"id":"ق-1343","fp":"0350e509e7e2","stateId":585,"easy":"الكفر والتكذيب بآيات الله ← الخلود في النار","cause":"الكفر والتكذيب بآيات الله","result":"الخلود في النار","explicit":true,"repOf":"ق-0007","ref":"سورة التغابن: 10","quran":{"s":64,"from":10,"to":10,"text":"وَالَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا أُولَئِكَ أَصْحَابُ النَّارِ خَالِدِينَ فِيهَا وَبِئْسَ الْمَصِيرُ (10)","hl":[[0,111,1]]}},{"id":"ق-1358","fp":"6c72f029dcc0","stateId":585,"easy":"الكفر وخيانة الدين ولو مع قرابة الصالحين ← لا تغني القرابة شيئاً ودخول النار","cause":"الكفر وخيانة الدين ولو مع قرابة الصالحين","result":"لا تغني القرابة شيئاً ودخول النار","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة التحريم: 10","srcLabel":"القرآن الكريم","quran":{"s":66,"from":10,"to":10,"text":"ضَرَبَ اللَّهُ مَثَلًا لِلَّذِينَ كَفَرُوا امْرَأَتَ نُوحٍ وَامْرَأَتَ لُوطٍ كَانَتَا تَحْتَ عَبْدَيْنِ مِنْ عِبَادِنَا صَالِحَيْنِ فَخَانَتَاهُمَا فَلَمْ يُغْنِيَا عَنْهُمَا مِنَ اللَّهِ شَيْئًا وَقِيلَ ادْخُلَا النَّارَ مَعَ الدَّاخِلِينَ (10)","hl":[[0,240,1]]}},{"id":"ق-1362","fp":"4925821370e4","stateId":585,"easy":"الكفر بالرب والتكذيب بالنذير وترك السمع والعقل ← عذاب جهنم والسعير والسُّحق","cause":"الكفر بالرب والتكذيب بالنذير وترك السمع والعقل","result":"عذاب جهنم والسعير والسُّحق","explicit":true,"ref":"سورة الملك: 6–11","srcLabel":"القرآن الكريم","quran":{"s":67,"from":6,"to":11,"text":"وَلِلَّذِينَ كَفَرُوا بِرَبِّهِمْ عَذَابُ جَهَنَّمَ وَبِئْسَ الْمَصِيرُ (6) إِذَا أُلْقُوا فِيهَا سَمِعُوا لَهَا شَهِيقًا وَهِيَ تَفُورُ (7) تَكَادُ تَمَيَّزُ مِنَ الْغَيْظِ كُلَّمَا أُلْقِيَ فِيهَا فَوْجٌ سَأَلَهُمْ خَزَنَتُهَا أَلَمْ يَأْتِكُمْ نَذِيرٌ (8) قَالُوا بَلَى قَدْ جَاءَنَا نَذِيرٌ فَكَذَّبْنَا وَقُلْنَا مَا نَزَّلَ اللَّهُ مِنْ شَيْءٍ إِنْ أَنْتُمْ إِلَّا فِي ضَلَالٍ كَبِيرٍ (9) وَقَالُوا لَوْ كُنَّا نَسْمَعُ أَوْ نَعْقِلُ مَا كُنَّا فِي أَصْحَابِ السَّعِيرِ (10) فَاعْتَرَفُوا بِذَنْبِهِمْ فَسُحْقًا لِأَصْحَابِ السَّعِيرِ (11)","hl":[[0,475,1]]}},{"id":"ق-1387","fp":"4d022c588e6f","stateId":585,"easy":"الإعراض عن ذكر الله ← عذاب صَعَد","cause":"الإعراض عن ذكر الله","result":"عذاب صَعَد","explicit":true,"otherNeedIds":[10],"ref":"سورة الجن: 17","srcLabel":"القرآن الكريم","quran":{"s":72,"from":17,"to":17,"text":"لِنَفْتِنَهُمْ فِيهِ وَمَنْ يُعْرِضْ عَنْ ذِكْرِ رَبِّهِ يَسْلُكْهُ عَذَابًا صَعَدًا (17)","hl":[[21,84,1]]}},{"id":"ق-1390","fp":"ac394f4e8471","stateId":585,"easy":"التكذيب مع الترف ← أنكال وجحيم وطعام ذو غصّة وعذاب أليم","cause":"التكذيب مع الترف","result":"أنكال وجحيم وطعام ذو غصّة وعذاب أليم","explicit":true,"ref":"سورة المزمل: 11–13","srcLabel":"القرآن الكريم","quran":{"s":73,"from":11,"to":13,"text":"وَذَرْنِي وَالْمُكَذِّبِينَ أُولِي النَّعْمَةِ وَمَهِّلْهُمْ قَلِيلًا (11) إِنَّ لَدَيْنَا أَنْكَالًا وَجَحِيمًا (12) وَطَعَامًا ذَا غُصَّةٍ وَعَذَابًا أَلِيمًا (13)","hl":[[0,160,1]]}},{"id":"ق-1394","fp":"d1eb4c388874","stateId":585,"easy":"العناد لآيات الله بعد النعم والاستكبار عنها ← الإرهاق صعوداً وسقر","cause":"العناد لآيات الله بعد النعم والاستكبار عنها","result":"الإرهاق صعوداً وسقر","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة المدثر: 11–26","srcLabel":"القرآن الكريم","quran":{"s":74,"from":11,"to":26,"text":"ذَرْنِي وَمَنْ خَلَقْتُ وَحِيدًا (11) وَجَعَلْتُ لَهُ مَالًا مَمْدُودًا (12) وَبَنِينَ شُهُودًا (13) وَمَهَّدْتُ لَهُ تَمْهِيدًا (14) ثُمَّ يَطْمَعُ أَنْ أَزِيدَ (15) كَلَّا إِنَّهُ كَانَ لِآيَاتِنَا عَنِيدًا (16) سَأُرْهِقُهُ صَعُودًا (17) إِنَّهُ فَكَّرَ وَقَدَّرَ (18) فَقُتِلَ كَيْفَ قَدَّرَ (19) ثُمَّ قُتِلَ كَيْفَ قَدَّرَ (20) ثُمَّ نَظَرَ (21) ثُمَّ عَبَسَ وَبَسَرَ (22) ثُمَّ أَدْبَرَ وَاسْتَكْبَرَ (23) فَقَالَ إِنْ هَذَا إِلَّا سِحْرٌ يُؤْثَرُ (24) إِنْ هَذَا إِلَّا قَوْلُ الْبَشَرِ (25) سَأُصْلِيهِ سَقَرَ (26)","hl":[[0,518,1]]}},{"id":"ق-1397","fp":"07995884e98d","stateId":585,"easy":"حبّ العاجلة وترك الآخرة ← وجوه باسرة تظن أن يُفعل بها فاقرة","cause":"حبّ العاجلة وترك الآخرة","result":"وجوه باسرة تظن أن يُفعل بها فاقرة","explicit":true,"ref":"سورة القيامة: 20–21","srcLabel":"القرآن الكريم","quran":{"s":75,"from":20,"to":21,"text":"كَلَّا بَلْ تُحِبُّونَ الْعَاجِلَةَ (20) وَتَذَرُونَ الْآخِرَةَ (21)","hl":[[0,63,1]]}},{"id":"ق-1400","fp":"b9d3fa1fe78e","stateId":585,"easy":"الكفر ← سلاسل وأغلال وسعير","cause":"الكفر","result":"سلاسل وأغلال وسعير","explicit":true,"ref":"سورة الإنسان: 4","srcLabel":"القرآن الكريم","quran":{"s":76,"from":4,"to":4,"text":"إِنَّا أَعْتَدْنَا لِلْكَافِرِينَ سَلَاسِلَ وَأَغْلَالًا وَسَعِيرًا (4)","hl":[[7,67,1]]}},{"id":"ق-1404","fp":"93b045af68bf","stateId":585,"easy":"التكذيب ← ويل يومئذ","cause":"التكذيب","result":"ويل يومئذ","explicit":true,"ref":"سورة المرسلات: 15","srcLabel":"القرآن الكريم","quran":{"s":77,"from":15,"to":15,"text":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ (15)","hl":[[0,34,1]]}},{"id":"ق-1414","fp":"0487ea8f3b07","stateId":585,"easy":"الكفر والفجور ← غبرة وقترة على الوجوه","cause":"الكفر والفجور","result":"غبرة وقترة على الوجوه","explicit":true,"ref":"سورة عبس: 40–42","srcLabel":"القرآن الكريم","quran":{"s":80,"from":40,"to":42,"text":"وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ (40) تَرْهَقُهَا قَتَرَةٌ (41) أُولَئِكَ هُمُ الْكَفَرَةُ الْفَجَرَةُ (42)","hl":[[0,109,1]]}},{"id":"ق-1417","fp":"fb469f922bf0","stateId":585,"easy":"التطفيف في الكيل والميزان ← الويل","cause":"التطفيف في الكيل والميزان","result":"الويل","explicit":true,"otherNeedIds":[3],"ref":"سورة المطففين: 1–6","srcLabel":"القرآن الكريم","quran":{"s":83,"from":1,"to":6,"text":"وَيْلٌ لِلْمُطَفِّفِينَ (1) الَّذِينَ إِذَا اكْتَالُوا عَلَى النَّاسِ يَسْتَوْفُونَ (2) وَإِذَا كَالُوهُمْ أَوْ وَزَنُوهُمْ يُخْسِرُونَ (3) أَلَا يَظُنُّ أُولَئِكَ أَنَّهُمْ مَبْعُوثُونَ (4) لِيَوْمٍ عَظِيمٍ (5) يَوْمَ يَقُومُ النَّاسُ لِرَبِّ الْعَالَمِينَ (6)","hl":[[0,257,1]]}},{"id":"ق-1422","fp":"036d88f5c9b7","stateId":585,"easy":"السخرية بالمؤمنين ← يضحك منهم المؤمنون يوم القيامة","cause":"السخرية بالمؤمنين","result":"يضحك منهم المؤمنون يوم القيامة","explicit":true,"ref":"سورة المطففين: 29–36","srcLabel":"القرآن الكريم","quran":{"s":83,"from":29,"to":36,"text":"إِنَّ الَّذِينَ أَجْرَمُوا كَانُوا مِنَ الَّذِينَ آمَنُوا يَضْحَكُونَ (29) وَإِذَا مَرُّوا بِهِمْ يَتَغَامَزُونَ (30) وَإِذَا انْقَلَبُوا إِلَى أَهْلِهِمُ انْقَلَبُوا فَكِهِينَ (31) وَإِذَا رَأَوْهُمْ قَالُوا إِنَّ هَؤُلَاءِ لَضَالُّونَ (32) وَمَا أُرْسِلُوا عَلَيْهِمْ حَافِظِينَ (33) فَالْيَوْمَ الَّذِينَ آمَنُوا مِنَ الْكُفَّارِ يَضْحَكُونَ (34) عَلَى الْأَرَائِكِ يَنْظُرُونَ (35) هَلْ ثُوِّبَ الْكُفَّارُ مَا كَانُوا يَفْعَلُونَ (36)","hl":[[0,434,1]]}},{"id":"ق-1426","fp":"e8aaaa088dff","stateId":585,"easy":"فتنة المؤمنين والمؤمنات بلا توبة ← عذاب جهنم وعذاب الحريق","cause":"فتنة المؤمنين والمؤمنات بلا توبة","result":"عذاب جهنم وعذاب الحريق","explicit":true,"ref":"سورة البروج: 10","srcLabel":"القرآن الكريم","quran":{"s":85,"from":10,"to":10,"text":"إِنَّ الَّذِينَ فَتَنُوا الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ ثُمَّ لَمْ يَتُوبُوا فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ الْحَرِيقِ (10)","hl":[[0,132,1]]}},{"id":"ق-1432","fp":"506c9d4eb5cd","stateId":585,"easy":"التولي والكفر ← العذاب الأكبر","cause":"التولي والكفر","result":"العذاب الأكبر","explicit":true,"repOf":"ق-0044","ref":"سورة الغاشية: 23–24","quran":{"s":88,"from":23,"to":24,"text":"إِلَّا مَنْ تَوَلَّى وَكَفَرَ (23) فَيُعَذِّبُهُ اللَّهُ الْعَذَابَ الْأَكْبَرَ (24)","hl":[[0,79,1]]}},{"id":"ق-1437","fp":"e4174ceff4a0","stateId":585,"easy":"الكفر بآيات الله ← أصحاب المشأمة عليهم نار مؤصدة","cause":"الكفر بآيات الله","result":"أصحاب المشأمة عليهم نار مؤصدة","explicit":true,"repOf":"ق-0007","ref":"سورة البلد: 19–20","quran":{"s":90,"from":19,"to":20,"text":"وَالَّذِينَ كَفَرُوا بِآيَاتِنَا هُمْ أَصْحَابُ الْمَشْأَمَةِ (19) عَلَيْهِمْ نَارٌ مُؤْصَدَةٌ (20)","hl":[[0,94,1]]}},{"id":"ق-1443","fp":"6b42f68bbba3","stateId":585,"easy":"التكذيب والتولي (الشقاء) ← النار تلظّى","cause":"التكذيب والتولي (الشقاء)","result":"النار تلظّى","explicit":true,"ref":"سورة الليل: 14–16","srcLabel":"القرآن الكريم","quran":{"s":92,"from":14,"to":16,"text":"فَأَنْذَرْتُكُمْ نَارًا تَلَظَّى (14) لَا يَصْلَاهَا إِلَّا الْأَشْقَى (15) الَّذِي كَذَّبَ وَتَوَلَّى (16)","hl":[[0,102,1]]}},{"id":"ق-1451","fp":"f7fd0981219f","stateId":585,"easy":"الكفر (أهل الكتاب والمشركون) ← نار جهنم خالدين فيها وهم شر البرية","cause":"الكفر (أهل الكتاب والمشركون)","result":"نار جهنم خالدين فيها وهم شر البرية","explicit":true,"repOf":"ق-0156","ref":"سورة البينة: 6","quran":{"s":98,"from":6,"to":6,"text":"إِنَّ الَّذِينَ كَفَرُوا مِنْ أَهْلِ الْكِتَابِ وَالْمُشْرِكِينَ فِي نَارِ جَهَنَّمَ خَالِدِينَ فِيهَا أُولَئِكَ هُمْ شَرُّ الْبَرِيَّةِ (6)","hl":[[0,136,1]]}},{"id":"ق-1464","fp":"6989d9b08d27","stateId":585,"easy":"معاداة الرسول وإيذاؤه ← التباب ولا يغني المال وصَلي النار","cause":"معاداة الرسول وإيذاؤه","result":"التباب ولا يغني المال وصَلي النار","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[50],"ref":"سورة المسد: 1–3","srcLabel":"القرآن الكريم","quran":{"s":111,"from":1,"to":3,"text":"تَبَّتْ يَدَا أَبِي لَهَبٍ وَتَبَّ (1) مَا أَغْنَى عَنْهُ مَالُهُ وَمَا كَسَبَ (2) سَيَصْلَى نَارًا ذَاتَ لَهَبٍ (3)","hl":[[0,26,1]]}},{"id":"س-04231","fp":"bd4af8d14d32","stateId":585,"easy":"إذا مت تشرك بالله ← دخلت النار","cause":"ومَن مات وهو يُشرِكُ باللهِ","result":"دخَل النَّارَ","explicit":true,"similar":["س-03066"],"ref":"تخريج صحيح ابن حبان 6171","srcLabel":"ابن حبان","text":["النَّاسُ أربعةٌ والأعمالُ ستَّةٌ مُوجبتانِ ومِثْلٌ بمِثْلٍ وحسَنةٌ بعَشْرِ أمثالِها وحسَنةٌ بسَبْعِمئةِ ضِعْفٍ والنَّاسُ موسَّعٌ عليه في الدُّنيا والآخرةِ وموسَّعٌ عليه في الدُّنيا مَقتورٌ عليه في الآخرةِ ومَقتورٌ عليه في الدُّنيا موسَّعٌ عليه في الآخرةِ ومَقتورٌ عليه في الدُّنيا والآخرةِ وشَقيٌّ في الدُّنيا وشَقيٌّ في الآخرةِ والمُوجِبتانِ : مَن قال لا إلهَ إلَّا اللهُ أو قال : مؤمنًا باللهِ دخَل الجنَّةَ ",["ومَن مات وهو يُشرِكُ باللهِ ",1],["دخَل النَّارَ",2]," ومَن هَمَّ بحسَنةٍ فعمِلها كُتِبَتْ له عَشَرةُ أمثالِها ومَن هَمَّ بحسَنةٍ فلم يعمَلْها كُتِبَتْ له حسَنةٌ ومَن هَمَّ بسيِّئةٍ فلم يعمَلْها كُتِبَتْ له حسَنةٌ ومَن هَمَّ بسيِّئةٍ فعمِلها كُتِبَتْ له سيِّئةٌ واحدةٌ غيرُ مضعَّفةٍ ومَن أنفَق نفقةً فاضلةً في سبيلِ اللهِ فبِسَبْعِمِئةِ ضِعْفٍ"],"grade":"صحيح","narrator":"خريم بن فاتك الأسدي","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (6171) واللفظ له، وابن أبي شيبة في ((مسنده)) (743)، وابن ابي عاصم في ((الآحاد والمثاني)) (1047)، والطبراني (4/ 205)(4151) جميعهم باختلاف يسير .","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"0BwkAjc5","merged":4,"otherRefs":["تخريج المسند لشاكر 5/223 (صحيح)","تخريج المسند لشعيب 4232 (صحيح)","مجمع الزوائد 1/26 (صحيح)"]},{"id":"س-03002","fp":"3cb04e871397","stateId":585,"easy":"إذا سمعت بالنبي ﷺ ثم لم تؤمن به ← تكون من أصحاب النار","cause":"لن يَسمَعَ بي أحدٌ مِن هذه الأمةِ ، ولا يهوديٌّ ، ولا نصرانيٌّ ، ثم لا يؤمِنُ بي","result":"إلا كان مِن أصحابِ النارِ","explicit":true,"repOf":"س-02609","otherNeedIds":[20],"ref":"إتحاف الخيرة المهرة 6/220","text":[["لن يَسمَعَ بي أحدٌ مِن هذه الأمةِ ، ولا يهوديٌّ ، ولا نصرانيٌّ ، ثم لا يؤمِنُ بي",1]," ، ",["إلا كان مِن أصحابِ النارِ",2]," ، قال : قلتُ : ما قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم شيئًا إلا كان في كتابِ اللهِ عزَّ وجلَّ ، قال : فوجَدتُ ومَن يَكفُرْ به منَ الأحزابِ فالنارُ مَوعِدُه"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح","bab":"إيمان › الوعيد","dorar":"M8TKALit","merged":2,"otherRefs":["صحيح مسلم 153 (صحيح)"]},{"id":"س-03911","fp":"5b3f0c7f345e","stateId":585,"easy":"إذا نافقت ← فالمنافقون في الدرك الأسفل من النار","cause":"إنَّ المُنافِقينَ","result":"في الدَّركِ الأسفَلِ مِنَ النَّارِ","explicit":true,"otherNeedIds":[20],"ref":"صحيح البخاري 4602","srcLabel":"النسائي","text":["كُنَّا في حَلقةِ عبدِ اللهِ فجاءَ حُذَيفةُ حتَّى قامَ علينا فسَلَّمَ، ثُمَّ قال: لقد أُنزِلَ النِّفاقُ على قَومٍ خَيرٍ مِنكُم، قال الأسودُ: سُبحانَ اللهِ! إنَّ اللهَ يقولُ: {",["إنَّ المُنافِقينَ",1]," ",["في الدَّركِ الأسفَلِ مِنَ النَّارِ",2],"} [النساء: 145]، فتَبَسَّمَ عبدُ اللهِ، وجَلَسَ حُذَيفةُ في ناحيةِ المَسجِدِ، فقامَ عبدُ اللهِ فتَفَرَّقَ أصحابُه، فرَماني بالحَصى، فأتَيتُه، فقال حُذَيفةُ: عَجِبتُ مِن ضَحِكِه، وقد عَرَفَ ما قُلتُ، لقد أُنزِلَ النِّفاقُ على قَومٍ كانوا خَيرًا مِنكُم ثُمَّ تابوا، فتابَ اللهُ عليهم."],"grade":"صحيح","narrator":"الأسود بن يزيد","muhaddith":"[صحيح]","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (11532) باختلاف يسير، والبيهقي (16925) بنحوه مختصرا .","bab":"تفسير آيات › سورة النساء","dorar":"pab43FSU","merged":2,"otherRefs":["عمدة التفسير 1/592 (صحيح)"]},{"id":"س-08270","fp":"f3366fc255b8","stateId":585,"easy":"إذا أبغضت أهل بيت النبي ﷺ ← يدخلك الله النار","cause":"لا يُبغِضُنا أهْلَ البَيتِ أحَدٌ","result":"إلَّا أدخَلَه اللهُ النَّارَ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"المستدرك على الصحيحين 4776","srcLabel":"مسلم","text":["«والَّذي نَفْسي بيَدِه ",["لا يُبغِضُنا أهْلَ البَيتِ أحَدٌ",1]," ",["إلَّا أدخَلَه اللهُ النَّارَ",2],"»."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه ابن حبان (6978) بلفظه، والبزار كما في ((كشف الأستار)) للهيثمي (3348) مطولا ، ، وابن المغازلي في ((مناقب علي)) (181)  كلاهما بلفظ مقارب.","bab":"مناقب وفضائل › أهل البيت صلوات الله عليهم","dorar":"03YR5yU3"},{"id":"س-02622","fp":"f3f9730352b2","stateId":585,"easy":"إذا سمعت بالنبي ﷺ ولم تؤمن به ← تدخل النار","cause":"ما مِن أَحَدٍ يَسمعُ بي مِن هذه الأُمَّةِ، ولا يهوديٌّ ولا نصرانيٌّ، ولا يُؤمنُ بي","result":"إلَّا دَخَلَ النَّارَ، فجَعَلْتُ أقولُ: أين تصْديقُها في كتابِ اللهِ وقُلْ ما سَمِعْتَ حدَّثَنا عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ إلَّا وجَدْتُ تصديقَها في القرآنِ","explicit":true,"repOf":"س-02609","ref":"المستدرك على الصحيحين 3351","text":["«",["ما مِن أَحَدٍ يَسمعُ بي مِن هذه الأُمَّةِ، ولا يهوديٌّ ولا نصرانيٌّ، ولا يُؤمنُ بي",1]," ",["إلَّا دَخَلَ النَّارَ، فجَعَلْتُ أقولُ: أين تصْديقُها في كتابِ اللهِ وقُلْ ما سَمِعْتَ حدَّثَنا عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ إلَّا وجَدْتُ تصديقَها في القرآنِ",2],"؟ حتَّى وجدتُ هذه الآيةَ: {وَمَنْ يَكْفُرْ بِهِ مِنَ الْأَحْزَابِ فَالنَّارُ مَوْعِدُهُ} [هود: 17] قالَ: الأحزابُ: المِلَلُ كُلُّها."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه ابن أبي حاتم كما في ((الدر المنثور ف)) (4/  411) مختصرا","bab":"إيمان › الأمر بالإيمان بالله تعالى ورسوله وشرائع الدين","dorar":"EkgFE4Em"},{"id":"س-02785","fp":"e1002423bf84","stateId":585,"easy":"إذا جاهدت وأنت منافق ← فأنت في النار، فالسيف لا يمحو النفاق","cause":"ورجلٌ منافقٌ جاهَد بنفسِه ومالِه في سبيلِ اللهِ","result":"فذلك في النَّارِ إنَّ السَّيفَ لا يمحو النِّفاقَ","explicit":true,"otherNeedIds":[20],"ref":"صحيح ابن حبان 4663","srcLabel":"أحمد","text":["القتلى ثلاثةٌ: رجلٌ مؤمنٌ جاهَد بنفسِه ومالِه في سبيلِ اللهِ حتَّى إذا لقي العدوَّ قاتَلهم حتَّى يُقتَلَ فذلك الشَّهيدُ الممتحَنُ في خيمةِ اللهِ تحتَ عرشِه ولا يفضُلُه النَّبيُّون إلَّا بفضلِ درجةِ النُّبوَّةِ، ورجلٌ مؤمنٌ قرَف على نفسِه مِن الذُّنوبِ والخطايا جاهَد بنفسِه ومالِه في سبيلِ اللهِ حتَّى إذا لقي العدوَّ قاتَل حتَّى قُتِل فتلك مَصْمَصةٌ محَتْ ذنوبَه وخطاياه، إنَّ السَّيفَ محَّاءٌ للخطايا وأُدخِل مِن أيِّ أبوابِ الجنَّةِ شاء فإنَّ لها ثمانيةَ أبوابٍ، ولجهنَّمَ سبعةَ أبوابٍ، وبعضُها أفضلُ مِن بعضٍ، ",["ورجلٌ منافقٌ جاهَد بنفسِه ومالِه في سبيلِ اللهِ",1]," حتَّى إذا لقي العدوَّ قاتَل حتَّى قُتِل ",["فذلك في النَّارِ إنَّ السَّيفَ لا يمحو النِّفاقَ",2]],"grade":"صحيح","narrator":"عتبة بن عبد السلمي","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (17657)، والطبراني (17/ 126) (311) كلاهما بلفظه، والدارمي (2455) بنحوه.","bab":"إيمان › النفاق","dorar":"3DmVqyKb"},{"id":"س-03031","fp":"a2a46f21338a","stateId":585,"easy":"إذا سمعت بالنبي ﷺ ثم لم تسلم ← دخلت النار","cause":"مَن سمِعَ بي من يَهوديٍّ أو نَصْرانيٍّ، ثُمَّ لم يُسلِمْ","result":"دخَلَ النَّارَ","explicit":true,"repOf":"س-02609","ref":"تخريج سير أعلام النبلاء 10/330","text":[["مَن سمِعَ بي من يَهوديٍّ أو نَصْرانيٍّ، ثُمَّ لم يُسلِمْ، ",1],["دخَلَ النَّارَ",2],"."],"grade":"صحيح","narrator":"أبو موسى","muhaddith":"إسناده صحيح","takhrij":"أخرجه الذهبي في ((السير)) (10/ 330)، وأحمد (19536)، والنسائي في ((السنن الكبرى)) (11177)، وأبو بكر الشافعي في ((الغيلانيات)) (244) جميعهم بلفظه.","bab":"إيمان › الوعيد","dorar":"VjUgGVtd"},{"id":"س-03066","fp":"cff6c0475377","stateId":585,"easy":"إذا مت تشرك بالله ← تدخل النار ويحرم الله عليك الجنة","cause":"إنَّ من مات يُشركُ باللهِ","result":"دخل النارَ وحرَّمَ اللهُ عليهِ الجنةَ ومأواهُ النارُ","explicit":true,"repOf":"س-04231","otherNeedIds":[58],"ref":"عارضة الأحوذي 2/300","text":[["إنَّ من مات يُشركُ باللهِ",1]," ",["دخل النارَ وحرَّمَ اللهُ عليهِ الجنةَ ومأواهُ النارُ",2]],"grade":"صحيح","muhaddith":"ثابت","bab":"إيمان › الوعيد","dorar":"6NPYUg99"},{"id":"س-04308","fp":"9b534993d230","stateId":585,"easy":"إذا جعلت مع الله إلهاً آخر أو كنت جباراً أو قتلت نفساً بغير حق ← تنطلق بك النار","cause":"بمَن جَعَل مَعَ اللهِ إلهًا آخَرَ، وبكُلِّ جَبَّارٍ عنيدٍ، ومَن قَتَل نَفسًا بغَيرِ نَفسٍ","result":"فتَنطَلقُ بهم قَبلَ سائِرِ النَّاسِ بخَمسِمائةِ عامٍ","explicit":true,"similar":["س-05738"],"ref":"يقظة أولي الاعتبار 140","srcLabel":"أحمد","text":["يَخرُجُ عُنُقٌ مِنَ النَّارِ يَومَ القيامةِ فيُكَلِّمُ بلسانٍ طَلقٍ ذَلقٍ، لها عَينانِ تُبصِرُ بهما، ولها لسانٌ تَكَلَّمُ به، فيَقولُ: إنِّي أُمِرتُ ",["بمَن جَعَل مَعَ اللهِ إلهًا آخَرَ، وبكُلِّ جَبَّارٍ عنيدٍ، ومَن قَتَل نَفسًا بغَيرِ نَفسٍ",1],"، ",["فتَنطَلقُ بهم قَبلَ سائِرِ النَّاسِ بخَمسِمائةِ عامٍ.",2]," وفي رِوايةٍ: فتَنطَوي عليهم فتَقذِفُهم في جَهَنَّمَ"],"grade":"صحيح","narrator":"أبو سعيد","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (11354)، وابن أبي شيبة (35278)، وأبو يعلى (1146) بنحوه.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"yL8EqKit"},{"id":"س-05738","fp":"3f93932bea1a","stateId":585,"easy":"إذا كنت جباراً أو جعلت مع الله إلهاً أو قتلت نفساً ← يخرج عنق من النار يلتقطك","cause":"بكلِّ جبَّارٍ، وبمَن جعَل مع اللهِ إلَهًا آخَرَ، وبمَن قتَل نفْسًا بغيرِ نفْسٍ","result":"يَخرُجُ عُنُقٌ منَ النَّارِ","explicit":true,"repOf":"س-04308","ref":"تخريج المسند لشعيب 11354","text":["\"",["يَخرُجُ عُنُقٌ منَ النَّارِ",2]," يتكَلَّمُ يقولُ: وُكِّلتُ اليومَ بثلاثةٍ: ",["بكلِّ جبَّارٍ، وبمَن جعَل مع اللهِ إلَهًا آخَرَ، وبمَن قتَل نفْسًا بغيرِ نفْسٍ",1],"، فيَنْطَوي عليهم، فيَقذِفُهم في غَمَراتِ جَهَنَّمَ\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"بعضه صحيح لغيره","takhrij":"أخرجه أحمد (11354) واللفظ له، وابن أبي شيبة (35278)، وعبد بن حميد (894)","bab":"رقائق وزهد › الكبر والتواضع","dorar":"qLoo1zv4"},{"id":"س-06366","fp":"92240565859f","stateId":585,"easy":"إذا مت كافراً ← وجبت لك النار","cause":"ومَن ماتَ كافرًا","result":"وجبَتْ لَهُ النَّارُ","explicit":true,"ref":"عمدة التفسير 1/846","srcLabel":"ابن حبان","text":["النَّاسُ أربعةٌ ، والعمَّالُ ستَّةٌ . فالنَّاسُ موسَّعٌ لَهُ في الدُّنيا والآخرةِ ، وموسَّعٌ لَهُ في الدُّنيا مقتورٌ عليهِ في الآخرةِ ، ومقتورٌ عليهِ في الدُّنيا موسَّعٌ لَهُ في الآخرةِ ، وشقيٌ في الدُّنيا والآخرةِ . والأعمالُ موجبتانِ ، ومثلٌ بمثلٍ ، وعشرةُ أضعافٍ ، وسبعُمائةِ ضعفٍ ؛ فالموجبتانِ مَن ماتَ مسلمًا مؤمنًا لا يشرِكُ باللَّهِ شيئًا وجبَتْ لَهُ الجنَّةُ ، ",["ومَن ماتَ كافرًا ",1],["وجبَتْ لَهُ النَّارُ ",2],". ومَن همَّ بحسنةٍ فلَم يعملْها ، فعلِمَ اللَّهُ أنَّهُ قد أشعرَها قلبَه وحرصَ علَيها ، كُتبَت لَهُ حسنةً . ومَن همَّ بسيِّئةٍ لم تُكْتَب عليهِ ، ومَن عمِلَها كُتبَت واحدةً ولم تُضاعَف عليهِ . ومَن عملَ حسنةً كانت له بعشرةِ أمثالِها . ومَن أنفقَ نفقةً في سبيلِ اللَّهِ ، عزَّ وجلَّ ، كانت لَهُ بسبعِمائةِ ضعفٍ"],"grade":"صحيح","narrator":"خريم بن فاتك الأسدي","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي شيبة في ((مسنده)) (743)، وابن ابي عاصم في ((الآحاد والمثاني)) (1047)، وابن حبان (4630) جميعهم باختلاف يسير .","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"mVsonKjD"},{"id":"س-07659","fp":"f3e3f290e8f0","stateId":585,"easy":"إذا مت على غير الإيمان بالقدر ← تدخل النار","cause":"أَوصاني أبي رَحِمَه اللهُ فقال: يا بُنَيَّ، أُوصيكَ أنْ تُؤمِنَ بالقَدَرِ خَيرِه وشَرِّه","result":"فإنَّكَ إنْ لم تُؤمِنْ أدخَلَكَ اللهُ النَّارَ","explicit":true,"ref":"تخريج المسند لشعيب 22707","srcLabel":"أبو داود","text":[["أَوصاني أبي رَحِمَه اللهُ فقال: يا بُنَيَّ، أُوصيكَ أنْ تُؤمِنَ بالقَدَرِ خَيرِه وشَرِّه؛ ",1],["فإنَّكَ إنْ لم تُؤمِنْ أدخَلَكَ اللهُ النَّارَ",2],"، قال: وسَمِعتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ يقولُ: أوَّلُ ما خَلَقَ اللهُ القَلمُ، ثُمَّ قال له: اكتُبْ، قال: وما أكتُبُ؟ قال: القَدَرَ، قال: فكَتَبَ ما يَكونُ، وما هو كائنٌ إلى أنْ تَقومَ السَّاعةُ."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4700)، والترمذي (2155) باختلاف يسير، وأحمد (22707) واللفظ له","bab":"قدر › التكذيب بالقدر","dorar":"ucJ9mrW5"},{"id":"س-07884","fp":"f72dc009ef12","stateId":585,"easy":"إذا كذبت بالشفاعة ← فلا نصيب لك فيها","cause":"من كذَّبَ بالشَّفاعةِ","result":"فلا نصيبَ لَهُ فيها","explicit":true,"ref":"فتح الباري لابن حجر 11/434","srcLabel":"البيهقي","text":["عن أنسٍ قالَ : ",["من كذَّبَ بالشَّفاعةِ ",1],["فلا نصيبَ لَهُ فيها",2]],"grade":"صحيح","narrator":"سعيد بن منصور","muhaddith":"إسناده صحيح","takhrij":"أخرجه البيهقي في ((البعث والنشور)) (468) واللفظ له، والآجري في ((الشريعة)) (777) باختلاف يسير، وهناد في ((الزهد)) (189) مطولًا.","bab":"قيامة › الشفاعة","dorar":"KnHhLSFw"},{"id":"س-00808","fp":"93424e11e495","stateId":585,"easy":"إذا آذيت الله ورسوله ← تلتقطك النار من الصفوف","cause":"بمن آذى اللَّهَ تعالى ورسولَهُ","result":"فتلتقِطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسمِ فتُحبَسُ بهم في جهنَّمَ","explicit":true,"ref":"الدر المنثور 10/111","srcLabel":"الحاكم","text":["عنِ ابنِ عبَّاسٍ قالَ: إذا كانَ يومُ القيامةِ مُدَّتِ الأرضُ مدَّ الأديمِ، وزيدَ في سَعتِها كذا وَكذا، وجمعَ الخلائقُ بصعيدٍ واحدٍ جنُّهمُ وَ إنسُهم، فإذا كانَ ذلِكَ اليومَ قُبِضت هذِهِ السَّماءُ الدُّنيا عن أَهلِها على وجْهِ الأرضِ ولأَهلُ السَّماءِ وحدُهم أَكثرُ من أَهلِ الأرضِ جنِّهم وَ إنسِهم بضِعفٍ، فإذا نُثِروا على وجْهِ الأرض فزعوا إليهِم فيقولون: أفيكم ربُّنا؟ فيفزعونَ من قولِهم ويقولونَ: سبحانَ ربِّنا ليس فينا وهو آتٍ، ثُمَّ تُقاضُ السَّماءُ الثَّانيةُ ولأَهلُ السَّماءِ الثَّانيةِ وحدَهم أَكثرَ من أهل السَّماءِ الدُّنيا، ومن جميعِ أهل الأرضِ بضِعفٍ جنِّهم وَ إنسِهم، فإذا نُثِروا على وجهِ الأرض فزعَ إليهم أهلُ الأرضِ فيقولونَ: أفيكُم ربُّنا؟ فيفزعونَ من قولِهم ويقولونَ: سبحانَ ربِّنا ليسَ فينا وهو آتٍ، ثم تُقاضُ السَّمواتُ سماءً سماءً كلَّما قيضَت سماءٌ عن أهلِها كانت أكثرَ من أهل السَّمواتِ الَّتي تحتَها ومن جميعِ أَهلِ الأرضِ بضِعفٍ، فإذا نُثِروا على أهل الأرضِ يفزعَ إليْهم أَهلُ الأرضِ فيقولونَ لَهم: مثلُ ذلِكَ فيرجعونَ إليهم مثل ذلك حتَّى تقاضَ السَّماءُ السَّابعةُ فلَأَهلُ السَّماءِ السَّابعةِ أَكثرُ من أهلِ ستِّ سمواتٍ ومن جميعِ أهلِ الأرضِ بضِعفٍ، فيجيءُ اللَّهُ فيهم والأممُ جثًى صفوفٌ فينادي منادٍ ستعلمونَ اليومَ من أصحابُ الْكرمِ ليقُمِ الحمَّادونَ للَّهِ على كلِّ حالٍ فيقومونَ فيسرَحونَ إلى الجنَّةِ ثمَّ ينادي الثَّانيةَ ستعلمون اليومَ من أصحابُ الْكرمِ أينَ الَّذينَ كانت تَتَجَافَى جُنُوبُهُمْ عَنِ المَضَاجِعِ يَدْعُونَ رَبَّهُمْ خَوْفًا وَطَمَعًا وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ [السجدة آية: 16] فيقومونَ فيسرَحونَ إلى الجنَّةِ، قالَ: ثمَّ ينادي الثَّالثةَ ستعلمون اليومَ من أصحابُ الْكرَمِ أين الَّذينَ لَا تُلْهِيهِمْ تِجَارَةٌ وَلَا بَيْعٌ عَنْ ذِكْرِ اللَّهِ وَإِقَامِ الصَّلَاةِ وَإِيتَاءِ الزَّكَاةِ يَخَافُونَ يَوْمًا تَتَقَلَّبُ فِيهِ الْقُلُوبُ وَالْأَبْصَارُ [النور آية: 37] فيقومونَ فيسرَحونَ إلى الجنَّةِ فإذا أخذَ كلٌّ من هؤلاءِ ثلاثةٌ خرجَ عنُقٌ منَ النَّارِ فأشرفَ على الخلائقِ لَهُ عينانِ تبصِرانِ ولسانٌ فصيحٌ فيقولُ: إنِّي وُكِّلتُ منكُم بثلاثةٍ بِكلِّ جبَّارٍ عنيدٍ فتلتقطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسِمِ، فتجلِسُ بِهم في جَهنَّمَ ثمَّ تخرجُ ثانيةً فتقولُ إنِّي وُكِّلتُ منكُم ",["بمن آذى اللَّهَ تعالى ورسولَهُ",1],"، ",["فتلتقِطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسمِ فتُحبَسُ بهم في جهنَّمَ",2],"، ثم تخرجُ ثالثةً فتقولُ: إنِّي وُكِّلتُ بأصحابِ التَّصاويرِ فتَلقطُهم منَ الصُّفوفِ لقطَ الطَّيرِ حبَّ السِّمسمِ فتُحبَسُ بِهم في جَهنَّمَ فإذا أُخذَ من هؤلاءِ ثلاثةً ومن هؤلاءِ ثلاثةً نشِرتِ الصُّحفَ ووُضِعتِ الموازينَ ودُعيَ الخلائقُ للحسابِ"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن المبارك في ((الزهد والرقائق)) (2/101) واللفظ له، والحاكم (8699)، والحارث بن أبي أسامة كما في ((بغية الباحث)) (1122) بلفظ مقارب","bab":"أدعية وأذكار › حمد الله في كل الأحوال","dorar":"TsRrl1QY"},{"id":"س-03860","fp":"a4528d119627","stateId":585,"easy":"إذا بقيت على الشرك ← تكون حصباً للنار","cause":"وإِنَّا نَرْغَبُ بِكَ عَمَّا أَنْتَ فِيهِ","result":"أنْ تَكُونَ حَصَبًا لِلنَّارِ غَدًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[20],"ref":"مجمع الزوائد 6/45","srcLabel":"أحمد","text":["خَرَجْنَا في حُجَّاجِ قَوْمِنَا من المُشْرِكِينَ وقَدْ صَلَّيْنَا فُقِّهْنَا معنا البراءُ بنُ مَعْرُورٍ كبيرُنَا وسَيِّدُنَا فَلمَّا تَوَجَّهْنَا لِسَفَرِنَا وخَرَجْنَا من المَدِينَةِ قال البَرَاءُ لنا يا هؤلاءِ إنِّي قَدْ رَأَيْتُ - واللهِ - رَأْيًا وإِنِّي - واللهِ - ما أَدْرِي تُوَافِقُونِي عليْه أَمْ لا ؟ قُلْنَا لَهُ ومَا ذَاكَ؟ قال إنِّي قَدْ رَأَيْتُ أنْ لا أَدَعَ هذه البِنْيَةَ مِنِّي بِظَهْرٍ - يَعْنِي الكَعْبَةَ - وأَنْ أُصَلِّيَ إِلَيْهَا قال فَقُلْنَا واللهِ ما بَلَغَنَا أَنَّ نَبِيَّنَا صلَّى اللهُ عليه وسلَّمَ يُصَلِّي إِلَّا إلى الشَّامِ ومَا نُرِيدُ أنْ نُخالِفَهُ قال فَقُلْنَا لَكِنَّا لا نَفْعَلُ قال وكُنَّا إِذَا حَضَرَتِ الصَّلَاةُ صَلَّيْنَا إلى الشَّامِ وصَلَّى إلى الكَعْبَةِ حتى قَدِمْنَا مَكَّةَ قال أَخِي وقَدْ كُنَّا قَدْ عَتَبْنَا عليْه ما صَنَعَ وأَبَى إِلَّا الإِقَامَةَ عليْه فَلمَّا قَدِمْنَا مَكَّةَ قال يا ابنَ أَخِي انْطَلِقْ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ حتى أَسْأَلَهُ عَمَّا صَنَعْتُ في سَفَرِي هذا فَإِنَّهُ واللهِ قَدْ وقَعَ في نَفْسِي مِنْهُ شيءٌ لِمَا رَأَيْتُ من خِلَافِكُمْ إِيَّايَ فِيهِ قال فَخَرَجْنَا نَسْأَلُ عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وكُنَّا لا نَعْرِفُهُ لَمْ نَرَهُ من قَبْلُ فَلَقِيَنَا رَجُلٌ من أَهْلِ مَكَّةَ فَسَأَلْنَاهُ عن رسولِ اللهِ صَلَّى اللهُ عليْه وسَلَّمَ فقال هل تَعْرِفَانِهِ؟ قُلْنَا لا قال فهل تَعْرِفَانِ العَبَّاسَ بنَ عَبْدِ المُطَّلِبِ عَمَّهُ؟ قُلْنَا نَعَمْ قال وقَدْ كُنَّا نَعْرِفُ العَبَّاسَ كَانَ لا يَزَالُ يَقْدَمُ عَلَيْنَا تاجِرًا قال فَادْخُلَا المَسْجِدَ فَهُوَ الرَّجُلُ الجَالِسُ مع العَبَّاسِ قال فَدَخَلْنَا المَسْجِدَ فإذا العَبَّاسُ جَالِسٌ ورَسُولُ اللهِ صلَّى اللهُ عليه وسلَّمَ مَعَهُ جَالِسٌ فَسَلَّمْنَا ثمَّ جَلَسْنَا إليه فقال النبيُّ صلَّى اللهُ عليه وسلَّمَ لِلْعَبَّاسِ هل تَعْرِفُ هَذَيْنِ الرَّجُلَيْنِ يا أَبا الفَضْلِ؟ قال نَعَمْ هذا البَرَاءُ بنُ مَعْرُورٍ سَيِّدُ قَوْمِهِ وهَذَا كَعْبُ بنُ مَالِكٍ قال فَوَاللَّهِ ما أَنْسَى قَوْلَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ الشَّاعِرُ؟ قال نَعَمْ قال فقال البَرَاءُ بنُ مَعْرُورٍ يا نَبِيَّ اللهِ إنِّي خَرَجْتُ في سَفَرِي هذا وقَدْ هَدَانِي اللهُ لِلْإِسْلَامِ فَجَعَلْتُ لا أَجْعَلُ هذه البِنْيَةَ مِنِّي بِظَهْرٍ فَصَلَّيْتُ إِلَيْهَا وقَدْ خالَفَنِي أَصْحابِي في ذلك حتى وقَعَ في نَفْسِي من ذلك شيءٌ فَمَا تَرَى يا رسولَ اللَّهِ؟ قال لقد كُنْتَ على قِبْلَةٍ لَوْ صَبَرْتَ عَلَيْهَا قال فَرَجَعَ البَرَاءُ إلى قِبْلَةِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فَصَلَّى مَعَنَا إلى الشَّامِ قال وأَهْلُهُ يُصَلُّونَ إلى الكَعْبَةِ حتى مَاتَ ولَيْسَ كَذَلِكَ كَمَا قَالُوا نَحْنُ أَعْلَمُ بِهِ مِنْهُمْ\nقَالَ وخَرَجْنَا إلى الحَجِّ فَوَاعَدْنَا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ العَقَبَةَ في أَوْسَطِ أَيَّامِ التَّشْرِيقِ فَلمَّا فَرَغْنَا من الحجِّ وكانَتِ الليْلَةُ التي وعَدْنَا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ ومعنا عبدُ اللهِ بنُ عَمْرِو بنِ حرامٍ أَبُو جَابِرٍ سَيِّدٌ من سَادَتِنَا وكُنَّا نَكْتُمُ من قَوْمِنَا من المُشْرِكِينَ أَمْرَنَا فكَلَّمْنَاهُ فقُلْنَا لهُ يا أبا جَابِرٍ إِنَّكَ سَيِّدٌ من سَادَتِنَا وشَرِيفٌ من أَشْرَافِنَا ",["وإِنَّا نَرْغَبُ بِكَ عَمَّا أَنْتَ فِيهِ",1]," ",["أنْ تَكُونَ حَصَبًا لِلنَّارِ غَدًا",2]," ثمَّ دَعَوْتُهُ إلى الإِسْلَامِ وأَخْبَرْتُهُ بِمِيعَادِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فَأَسْلَمَ وشَهِدَ مَعَنَا العَقَبَةَ وكَانَ نَقِيبًا\nقَالَ فَنِمْنَا تِلْكَ اللَّيْلَةَ مع قَوْمِنَا في رِحالِنَا حتى إِذَا مَضَى ثُلُثُ اللَّيْلِ خَرَجْنَا من رِحالِنَا لِمِيعَادِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ نَتَسَلَّلُ مُسْتَخْفِينَ تَسَلُّلَ القَطَا حتى اجْتَمَعْنَا في الشِّعْبِ عِنْدَ العَقَبَةِ ونحن سَبْعُونَ رَجُلًا مَعَهُمُ امْرَأَتانِ من نِسَائِهِمْ نَسِيبَةُ بِنْتُ كَعْبٍ أُمُّ عُمَارَةَ إِحْدَى نِسَاءِ بَنِي مَازِنِ بنِ النَّجَّارِ وأَسْمَاءُ ابْنَةُ عَمْرِو بنِ عَدِيِّ بنِ ثَابِتٍ إِحْدَى نِسَاءِ بَنِي سَلَمَةَ وهِيَ أُمُّ مَنِيعٍ فَاجْتَمَعْنَا بِالشِّعْبِ نَنْتَظِرُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ حتى جَاءَنَا ومَعَهُ يَوْمَئِذٍ عَمُّهُ العَبَّاسُ بنُ عَبْدِ المُطَّلِبِ وهُوَ يَوْمَئِذٍ على دِينِ قَوْمِهِ إِلَّا أَنَّهُ أَحَبَّ أنْ يَحْضُرَ أَمْرَ ابنِ أَخِيهِ يَتَوَثَّقُ لَهُ فَلمَّا جَلَسْنَا كَانَ العَبَّاسُ بنُ عَبْدِ المُطَّلِبِ أَوَّلَ مَنْ تَكَلَّمَ فقال يا مَعْشَرَ الخَزْرَجِ - وكَانَتِ العَرَبُ مِمَّا يُسَمُّونَ هذا الحَيَّ من الأَنْصارِ الخَزْرَجَ أَوْسَهَا وخَزْرَجَهَا - إِنَّ مُحَمَّدًا مِنَّا حَيْثُ قَدْ عَلِمْتُمْ وقَدْ مَنَعْنَاهُ من قَوْمِنَا مِمَّنْ هو على مِثْلِ رَأْيِنَا فِيهِ وهُوَ في عِزٍّ من قَوْمِهِ ومَنْعَةٍ في بَلَدِهِ قال فَقُلْنَا قَدْ سَمِعْنَا ما قُلْتَ فَتَكَلَّمْ يا رسولَ اللهِ فَخُذْ لِرَبِّكَ ولِنَفْسِكَ ما أَحْبَبْتَ فَتَكَلَّمَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فَتَلَا ودَعَا إلى اللهِ عزَّ وجلَّ ورَغَّبَ في الإِسْلَامِ قال أُبايِعُكُمْ على أنْ تَمْنَعُونِي مِمَّا تَمْنَعُونَ مِنْهُ نِسَاءَكُمْ وأَبْنَاءَكُمْ قال فَأَخَذَ البَرَاءُ بنُ مَعْرُورٍ بِيَدِهِ ثمَّ قال نَعَمْ والَّذِي بَعَثَكَ بِالْحَقِّ لِنَمْنَعَنَّكَ مِمَّا نَمْنَعُ مِنْهُ أَزْرَنَا فَبايِعْنَا يا رسولَ اللهِ فَنَحْنُ واللهِ أَهْلُ الحُرُوبِ وأَهْلُ الحَلْقَةِ ورِثْنَاهَا كَابِرًا عن كَابِرٍ قال فَاعْتَرَضَ القَوْلَ - والْبَرَاءُ يُكَلِّمُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ أَبُو الهَيْثَمِ بنُ التَّيِّهَانِ حَلِيفُ بَنِي عَبْدِ الأَشْهَلِ فقال يا رسولَ اللهِ إِنَّ بَيْنَنَا وبَيْنَ الرِّجَالِ حِبالًا وإِنَّا قَاطِعُوهَا - وهِيَ العُهُودُ - فهل عَسَيْتَ إِنْ نَحْنُ فَعَلْنَا ذَلِكَ وأَظْهَرَكَ اللهُ عزَّ وجلَّ أنْ تَرْجِعَ وتَدَعَنَا؟ قال فَتَبَسَّمَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فقال بَلِ الدَّمَ الدَّمَ والْهَدْمَ الهَدْمَ أَنْتُمْ مِنِّي وأَنَا مِنْكُمْ أُحارِبُ مَنْ حارَبْتُمْ وأُسَالِمُ مَنْ سَالَمْتُمْ وَقَالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ أَخْرِجُوا إِلَيَّ مِنْكُمْ اثْنَيْ عَشَرَ نَقِيبًا مِنْكُمْ يَكُونُونَ على قَوْمِهِمْ فَأَخْرَجُوا مِنْهُمُ اثْنَيْ عَشَرَ نَقِيبًا مِنْهُمْ تِسْعَةٌ من الخَزْرَجِ وثَلَاثَةٌ من الأَوْسِ وَأَمَّا مَعْبَدُ بنُ كَعْبٍ فَحَدَّثَنِي في حَدِيثُهُ عن أَخِيهِ عن أَبِيهِ كَعْبِ بنِ مَالِكٍ قال كَانَ أَوَّلَ مَنْ ضَرَبَ على يَدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ البَرَاءُ بنُ مَعْرُورٍ ثمَّ تَبايَعَ القَوْمُ فَلمَّا بايَعْنَا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ صَرَخَ الشَّيْطَانُ من رَأْسِ العَقَبَةِ بِأَنْفَذِ صَوْتٍ سَمِعْتُهُ يا أَهْلَ الجَباجِبِ - والْجَباجِبُ المَنَازِلُ - هل لَكُمْ في مُذَمَّمٍ والصُّباةُ مَعَهُ قَدْ أَجْمَعُوا على حَرْبِكُمْ؟ قال عليُّ يَعْنِي ابنَ إسْحاقَ ما يقولُ عَدُوُّ اللهِ مُحَمَّدٌ قال فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ هذا أَزَبُّ العَقَبَةِ هذا ابنُ أَزْيَبَ اسْمَعْ أَيْ عَدُوَّ اللهِ أَمَا واللهِ لَأَفْرُغَنَّ لَكَ ثمَّ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ارْفَعُوا إِلَيَّ رِحالَكُمْ قال فقال لَهُ العَبَّاسُ بنُ عُبادَةَ بنِ نَضْلَةَ والَّذِي بَعَثَكَ بِالْحَقِّ لَئِنْ شِئْتَ لَنَمِيلَنَّ على أَهْلِ مِنًى غَدًا بِأَسْيافِنَا قال فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ لَمْ أُؤْمَرْ بِذَلِكَ قال فَرَجَعْنَا فَنِمْنَا حتى أَصْبَحْنَا فَلمَّا أَصْبَحْنَا غَدَتْ عَلَيْنَا جُلَّةُ قُرَيْشٍ حتى جَاءُونَا في منازِلِنَا فقالُوا يا مَعْشَرَ الخَزْرَجِ إنَّه قَدْ بَلَغَنَا أَنَّكُمْ قَدْ جِئْتُمْ إلى صاحِبِنَا هذا تَسْتَخْرِجُونَهُ من بينِ أَيْدِينَا وتُبايِعُونَهُ على حَرْبِنَا واللهِ إنَّه ما من العَرَبِ أَحَدٌ أَبْغَضُ إلَيْنَا أنْ تَنْشَبَ الحَرْبُ بَيْنَنَا وبَيْنَهُمْ مِنْكُمْ قال فَنَبْعَثُ من هُنَالِكَ من مُشْرِكِي قَوْمِنَا يَحْلِفُونَ لَهُمْ بِاللهِ ما كان من هذا من شَيْءٍ ومَا عَلِمْنَاهُ وقَدْ صدَقُوا لَمْ يعلمُوا ما كَانَ مِنَّا قال فَبَعْضُنَا يَنْظُرُ إلى بَعْضٍ قال وقَامَ القَوْمُ وفِيهِمُ الحارِثُ بنُ هِشَامِ بنِ المُغِيرَةِ وعَلَيْهِ نَعْلَانِ جَدِيدَانِ قال فَقُلْتُ كَلِمَةً كَأَنِّي أُرِيدُ أنْ أُشْرِكُ القَوْمَ بها فِيما قالُوا ما تسْتَطِيعُ يا أبا جابِرٍ وأنت سَيِّدٌ من سَادَاتِنَا أنْ تَتَّخِذَ نَعْلَيْنِ مثلَ نَعْلَيْ هذا الفَتَى من قُرَيْشٍ؟ قال فَسمِعَهَا الحارِثُ فَخَلَعَهُمَا ثمَّ رَمَى بِهِمَا إِلَيَّ قال واللهِ لَتَنْتَعِلَنَّهُمَا قال يقولُ أَبُو جَابِرٍ أَحْفَظْتَ - واللهِ - الفَتَى ارْدُدْ عليْه نَعْلَيْهِ قال فَقُلْتُ واللهِ لا أَرُدُّهُمَا قال ووَاللَّهِ صالِحٌ لَئِنْ صَدَقَ الفَأْلُ لَأَسْلُبَنَّهُ فَهذَا حَدِيثُ ابنِ مَالِكٍ عَنِ العَقَبَةِ ومَا حَضَرَ مِنْهَا"],"grade":"صحيح","narrator":"كعب بن مالك","muhaddith":"رجاله رجال الصحيح غير ابن إسحاق وقد صرح بالسماع","takhrij":"أخرجه أحمد (15798) واللفظ له، وأبو نعيم في ((معرفة الصحابة)) (1081) باختلاف يسير، وابن حبان (7011) بنحوه.","bab":"بيعة › مبايعة الإمام","dorar":"svQcExLh"},{"id":"س-06829","fp":"ef325d2bd585","stateId":585,"easy":"إذا كنت منافقاً ← لا تستطيع أن تسجد يوم القيامة","cause":"كلُّ مُنافِقٍ","result":"فلا يَسْتَطِيعُ أنْ يَسْجُدَ","explicit":true,"otherNeedIds":[20],"ref":"السلسلة الصحيحة 584","srcLabel":"الدارمي","text":["إذا جَمَعَ اللهُ العِبادَ بصَعِيدٍ و احِدٍ نادَى مُنادٍ : يَلْحَقُ كلُّ قومٍ بِما كَانُوا يَعْبُدُونَ ، و يَبْقَى الناسُ على حالِهمْ ، فَيأتيهِمْ فيقولُ : ما بالُ الناسِ ذَهَبُوا و أنْتُمْ هاهُنا ‍‍‍‍‍‍‍‍‍‍‍‍ ؟ فَيقولونَ نَنْتَظِرُ إلهَنا ، فيقولُ هل تَعْرِفُونَهُ ؟ فَيقولونَ : إذا تَعَرَّفَ إِلَيْنا عَرَفْناهُ ، فَيَكْشِفُ لهُمْ عن ساقِهِ ، فَيَقَعُونَ سُجُودًا ، و ذلكَ لقولِ اللهِ تعالى : \" يومَ يُكْشَفُ عن ساقٍ و يُدْعَوْنَ إلى السُّجُودِ فلا يَسْتَطِيعُونَ \" ، و يَبْقَى ",["كلُّ مُنافِقٍ",1]," ، ",["فلا يَسْتَطِيعُ أنْ يَسْجُدَ",2]," ، ثُمَّ يَقُودُهُمْ إلى الجنةِ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده جيد","takhrij":"أخرجه الدارمي (2803) واللفظ له، وابن أبي عاصم في ((السنة)) (732)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"D9OWUm6s"},{"id":"س-03768","fp":"1383bae23baf","stateId":585,"easy":"إذا أبيت إلا الشرك ← لن ينفعك فداء الأرض يوم القيامة","cause":"أن لا تُشرِكَ -أحسِبُه قال: ولا أُدخِلَك النَّارَ- فأبَيتَ إلَّا الشِّركَ","result":"لأهونِ أهلِ النَّارِ عَذابًا: لو كانَت لك الدُّنيا وما فيها أكُنتَ مُفتَديًا بها","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[20],"ref":"صحيح مسلم 2805","srcLabel":"متفق عليه","text":["يقولُ اللهُ تَبارَك وتَعالى ",["لأهونِ أهلِ النَّارِ عَذابًا: لو كانَت لك الدُّنيا وما فيها أكُنتَ مُفتَديًا بها",2],"؟ فيَقولُ: نَعَم، فيَقولُ: قد أرَدتُ مِنك أهونَ مِن هذا، وأنتَ في صُلبِ آدَمَ: ",["أن لا تُشرِكَ -أحسِبُه قال: ولا أُدخِلَك النَّارَ- فأبَيتَ إلَّا الشِّركَ",1],". وفي روايةٍ: عَنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم بمِثلِه، إلَّا قَولَه: ولا أُدخِلَك النَّارَ؛ فإنَّه لَم يَذكُرْه."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3334)، ومسلم (2805) .","bab":"الكفر والشرك › ذم الشرك وما ورد فيه من العقوبة","dorar":"FymQXk5O","merged":3,"otherRefs":["صحيح الجامع 8123 (صحيح)","صحيح البخاري 6557 (صحيح)"]},{"id":"س-03017","fp":"b9ae26a9c557","stateId":585,"easy":"إذا أسبلت أسفل الكعبين ← فهو في النار","cause":"ما كان أسفلَ من ذلك","result":"فهو في النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشعيب 11010","srcLabel":"مسلم","text":["حدَّثَنا محمَّدُ بنُ أبي عَديٍّ، عن شُعْبةَ، عنِ العَلاءِ بنِ عبدِ الرحمنِ، عن أبيه، أنَّه سمِع أبا سعيدٍ، سُئِلَ عنِ الإزارِ، فقال: على الخَبيرِ سقَطتَ، سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: \"إزْرةُ المُؤمِنِ إلى أنْصافِ السَّاقيْنِ، لا جُناحَ -أو لا حرَجَ- عليه فيما بيْنَه وبيْنَ الكَعبيْنِ، ",["ما كان أسفلَ من ذلك",1]," ",["فهو في النَّارِ",2],"، لا ينظُرُ اللهُ إلى مَن جرَّ إزارَه بَطَرًا\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أبو داود (4093)، والنسائي في ((السنن الكبرى)) (9716)، وابن ماجه (3573)، وأحمد (11010) واللفظ له","bab":"إيمان › الوعيد","dorar":"bHJRchRM","merged":4,"otherRefs":["تخريج صحيح ابن حبان 5450 (صحيح)","تخريج المسند لشعيب 7857 (صحيح)","تخريج المسند لشعيب 10555 (صحيح)"]},{"id":"س-01784","fp":"93a3634d4d59","stateId":585,"easy":"إذا نسيت لقاء الله ← ينساك الله يوم القيامة","cause":"فظننتَ أنكَ مُلاقِيَّ ؟ فيقولُ: لا","result":"إني أنساكَ كما نَسيتَني","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-02792","ref":"إتحاف الخيرة المهرة 8/171","text":["يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّم  هل نَرى ربَّنا يومَ القيامةِ ؟ فقال: هل تُضارُّونَ في رؤيةِ الشمسِ في الظهيرةِ ليسَتْ في سحابةٍ ؟ قالوا: لا  قال: فهل تُضارُّونَ في رؤيةِ القمرِ ليلةَ البدرِ ليس في سحابةٍ ؟ قالوا: لا , قال  فوالذي نفسي بيدِه لا تُضارُّونَ في رؤيةِ ربِّكم إلا كما تُضارُّونَ في رؤيةِ أحدِهما  فيَلقى العبدُ ربَّه فيقولُ: أيْ فُل ألم أُكرِمْكَ  وأُسَوِّدْكَ  وأُزَوِّجْكَ  وأُسَخِّرْ لكَ الخيلَ والإبلَ وأذرَكَ ترأَسُ وتَربَعُ  قال: فيقولُ: بَلى يا ربِّ  قال: فيقولُ: ",["فظننتَ أنكَ مُلاقِيَّ ؟ فيقولُ: لا",1]," فيقولُ: ",["إني أنساكَ كما نَسيتَني",2]," ثم يَلقى الثانيَ فيقولُ  أيْ فُل ألم أُكرِمْكَ  وأُسَوِّدْكَ  وأُزَوِّجْكَ  وأُسَخِّرْ لكَ الخيلَ والإبلَ وأذرَكَ تَرأَسُ وتَربَعُ  قال: فيقولُ: بَلى يا ربِّ  قال: فيقولُ: فظننتَ أنكَ مُلاقِيَّ ؟ فيقولُ: لا , فيقولُ: فإني أنساكَ كما نَسيتَني  ثم يَلقى الثالثَ فيقول: أيْ فُل ألم أُكرِمْكَ  وأُسَوِّدْكَ  وأُزَوِّجْكَ  وأُسَخِّرْ لكَ الخيلَ والإبلَ وأذرَكَ تَرأَسُ وتَربَعُ ؟ فيقولُ: بَلى يا ربِّ فيقولُ: ظننتَ أنكَ مُلاقِيَّ ؟ فيقولُ: آمنتُ بكَ وبكتابِكَ وبرُسُلِكَ  وصلَّيتُ  وصُمتُ  وتصدَّقتُ  ويُثني بخيرٍ ما استَطاع قال: فيقولُ: فها هُنا إذًا  قال: ثم قال: ألا نبعثُ شاهدَنا عليكَ , فيفكرُ في نفسِه مَن ذا الذي يشهدُ عليَّ , فيختمُ على فيه ويقالُ لفخِذِه: انطِقي فينطقُ فخِذُه ولحمُه وعظامُه بعملِه ما كان  وذلك ليعذرَ مِن نفسِه وذلك المنافقُ  وذلك الذي يسخطُ اللهُ عليه ثم يُنادي منادٍ: ألا لتتبعْ كلُّ أمةٍ ما كانتْ تعبدُ مِن دونِ اللهِ فتتبعُ الشياطينَ والصلبَ أولياؤهم إلى جهنَّمَ قال: وبَقينا أيُّها المؤمنونَ فيأتينا ربُّنا  عزَّ وجلَّ  وهو ربُّنا وهو يُثيبُنا  فيقولَنَّ: علامَ هؤلاءِ ؟ فيقولونَ: نحن عبادُ اللهِ المؤمنينَ آمَنَّا باللهِ لا نُشرِكُ به شيئًا  وهذا مقامُنا حتى يأتيَنا ربُّنا  عزَّ وجلَّ  وهو ربُّنا وهو مُثبِتُنا  قال: ثم ينطلقُ حتى يأتيَ الجسرَ وعليه كلاليبُ مِن نارٍ تخطفُ الناسَ  فعندَ ذلك حلَّتِ الشفاعةُ ودعوى الرسلِ يومئذٍ: اللهم سلِّمْ  أي اللهم سلِّمْ  فإذا جاوَزوا الجسرَ فكلُّ مَن أنفَق زوجًا مما ملَكَتْ يمينُه منَ المالِ في سبيلِ اللهِ فكلُّ خزنةِ الجنةِ يدعونَه: يا عبدَ اللهِ  يا مسلمُ  هذا خيرٌ فتعالَ  قال: فقال أبو بكرٍ: يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّم  إنَّ هذا العبدَ لا تَوى عليه يدعُ بابًا ويلِجُ بابًا قال: فضرَبه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بيدِه ثم قال: والذي نفسُ محمدٍ بيدِه إني لأرجو أن تكونَ منهم"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سنده صحيح","takhrij":"أخرجه الحميدي (1178) واللفظ له، وأخرجه البخاري (6573) بنحوه، ومسلم (2968) باختلاف يسير","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"NJUioHng","merged":2,"otherRefs":["فتح الباري لابن حجر 11/456 (صحيح)"]},{"id":"س-01785","fp":"47142a58fce0","stateId":585,"easy":"إذا نافقت ← يُختم على فيك وتنطق جوارحك بعملك","cause":"وذلك المنافقُ","result":"فيختمُ على فيه ويقالُ لفخِذِه: انطِقي فينطقُ فخِذُه ولحمُه وعظامُه بعملِه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"إتحاف الخيرة المهرة 8/171","srcLabel":"متفق عليه","text":["يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّم  هل نَرى ربَّنا يومَ القيامةِ ؟ فقال: هل تُضارُّونَ في رؤيةِ الشمسِ في الظهيرةِ ليسَتْ في سحابةٍ ؟ قالوا: لا  قال: فهل تُضارُّونَ في رؤيةِ القمرِ ليلةَ البدرِ ليس في سحابةٍ ؟ قالوا: لا , قال  فوالذي نفسي بيدِه لا تُضارُّونَ في رؤيةِ ربِّكم إلا كما تُضارُّونَ في رؤيةِ أحدِهما  فيَلقى العبدُ ربَّه فيقولُ: أيْ فُل ألم أُكرِمْكَ  وأُسَوِّدْكَ  وأُزَوِّجْكَ  وأُسَخِّرْ لكَ الخيلَ والإبلَ وأذرَكَ ترأَسُ وتَربَعُ  قال: فيقولُ: بَلى يا ربِّ  قال: فيقولُ: فظننتَ أنكَ مُلاقِيَّ ؟ فيقولُ: لا فيقولُ: إني أنساكَ كما نَسيتَني ثم يَلقى الثانيَ فيقولُ  أيْ فُل ألم أُكرِمْكَ  وأُسَوِّدْكَ  وأُزَوِّجْكَ  وأُسَخِّرْ لكَ الخيلَ والإبلَ وأذرَكَ تَرأَسُ وتَربَعُ  قال: فيقولُ: بَلى يا ربِّ  قال: فيقولُ: فظننتَ أنكَ مُلاقِيَّ ؟ فيقولُ: لا , فيقولُ: فإني أنساكَ كما نَسيتَني  ثم يَلقى الثالثَ فيقول: أيْ فُل ألم أُكرِمْكَ  وأُسَوِّدْكَ  وأُزَوِّجْكَ  وأُسَخِّرْ لكَ الخيلَ والإبلَ وأذرَكَ تَرأَسُ وتَربَعُ ؟ فيقولُ: بَلى يا ربِّ فيقولُ: ظننتَ أنكَ مُلاقِيَّ ؟ فيقولُ: آمنتُ بكَ وبكتابِكَ وبرُسُلِكَ  وصلَّيتُ  وصُمتُ  وتصدَّقتُ  ويُثني بخيرٍ ما استَطاع قال: فيقولُ: فها هُنا إذًا  قال: ثم قال: ألا نبعثُ شاهدَنا عليكَ , فيفكرُ في نفسِه مَن ذا الذي يشهدُ عليَّ , ",["فيختمُ على فيه ويقالُ لفخِذِه: انطِقي فينطقُ فخِذُه ولحمُه وعظامُه بعملِه",2]," ما كان  وذلك ليعذرَ مِن نفسِه ",["وذلك المنافقُ",1],"  وذلك الذي يسخطُ اللهُ عليه ثم يُنادي منادٍ: ألا لتتبعْ كلُّ أمةٍ ما كانتْ تعبدُ مِن دونِ اللهِ فتتبعُ الشياطينَ والصلبَ أولياؤهم إلى جهنَّمَ قال: وبَقينا أيُّها المؤمنونَ فيأتينا ربُّنا  عزَّ وجلَّ  وهو ربُّنا وهو يُثيبُنا  فيقولَنَّ: علامَ هؤلاءِ ؟ فيقولونَ: نحن عبادُ اللهِ المؤمنينَ آمَنَّا باللهِ لا نُشرِكُ به شيئًا  وهذا مقامُنا حتى يأتيَنا ربُّنا  عزَّ وجلَّ  وهو ربُّنا وهو مُثبِتُنا  قال: ثم ينطلقُ حتى يأتيَ الجسرَ وعليه كلاليبُ مِن نارٍ تخطفُ الناسَ  فعندَ ذلك حلَّتِ الشفاعةُ ودعوى الرسلِ يومئذٍ: اللهم سلِّمْ  أي اللهم سلِّمْ  فإذا جاوَزوا الجسرَ فكلُّ مَن أنفَق زوجًا مما ملَكَتْ يمينُه منَ المالِ في سبيلِ اللهِ فكلُّ خزنةِ الجنةِ يدعونَه: يا عبدَ اللهِ  يا مسلمُ  هذا خيرٌ فتعالَ  قال: فقال أبو بكرٍ: يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّم  إنَّ هذا العبدَ لا تَوى عليه يدعُ بابًا ويلِجُ بابًا قال: فضرَبه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بيدِه ثم قال: والذي نفسُ محمدٍ بيدِه إني لأرجو أن تكونَ منهم"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سنده صحيح","takhrij":"أخرجه الحميدي (1178) واللفظ له، وأخرجه البخاري (6573) بنحوه، ومسلم (2968) باختلاف يسير","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"NJUioHng"},{"id":"س-03150","fp":"d723f08ef0dd","stateId":585,"easy":"إذا عبدت غير الله ← تتساقط في النار","cause":"كان يَعبُدُ صَنمًا ولا وَثنًا ولا صُورةً","result":"إلَّا ذَهَبوا حتَّى يَتَساقطوا في النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"similar":["س-03164","س-08192"],"otherNeedIds":[20],"ref":"المستدرك على الصحيحين 8962","srcLabel":"متفق عليه","text":["قلْتُ: يا رَسولَ اللهِ، هل نَرى ربَّنا يَومَ القيامةِ؟ قال: هلْ تُضارُّون في رُؤيةِ الشَّمسِ بالظَّهيرةِ صَحْوًا ليْس فيها سِحابٌ؟ فقُلْنا: لا يا رَسولَ اللهِ، قال: فهلْ تُضارُّون في رُؤيةِ القمرِ في لَيلةِ البدْرِ صَحْوًا ليْس فيه سِحابٌ؟ قالوا: لا، قال: ما تُضارُّون في رُؤيتِه يَومَ القيامةِ إلَّا كما تُضارُّون في رُؤيةِ أحدِهما، إذا كان يَومُ القيامةِ نادى مُنادٍ: ألَا لِتَلحَقْ كلُّ أُمَّةٍ بما كانت تَعبُدُ، فلا يَبْقى أحدٌ ",["كان يَعبُدُ صَنمًا ولا وَثنًا ولا صُورةً",1],"؛ ",["إلَّا ذَهَبوا حتَّى يَتَساقطوا في النَّارِ",2],"، ويَبْقى مَن كان يَعبُدُ اللهَ وحْدَه مِن بَرٍّ وفاجرٍ وغَبَراتِ أهلِ الكتابِ، ثمَّ تَعرِضُ جَهنَّمُ كأنَّها سَرابٌ يَحطِمُ بعضُها بعضًا، ثمَّ يُدْعى اليهودُ فيَقولُ: ماذا كُنتُم تَعبُدون؟ فيَقولُون: عُزَيرًا ابنَ اللهِ، فيَقولُ: كذَبْتُم؛ ما اتَّخَذَ اللهُ مِن صاحبةٍ ولا ولَدٍ، فما تُرِيدون؟ فيَقولُون: أيْ ربَّنا، ظَمِئْنا، فيَقولُ: أفلَا تَرِدُون، فيَذهَبون حتَّى يَتساقَطوا في النَّارِ. ثمَّ يُدْعى النَّصارى، فيَقولُ: ماذا كُنتُم تَعبُدون؟ فيَقولُون: المسيحُ ابنُ اللهِ، فيَقولُ: كذَبْتُم، ما اتَّخَذَ اللهُ مِن صاحبةٍ ولا ولَدٍ، فماذا تُرِيدون؟ فيَقولُون: أيْ ربَّنا، ظَمِئْنا، اسْقِنا، فيَقولُ: أفلَا تَرِدون، فيَذهَبون حتَّى يَتساقَطوا في النَّارِ، فيَبْقى مَن كان يَعبُدُ اللهَ وحْدَه مِن بَرٍّ وفاجرٍ. ثمَّ يَتبدَّى اللهُ لنا في صُورةٍ غيرِ صُورتِه الَّتي كنَّا رَأيْناهُ فيه أوَّلَ مرَّةٍ، فيَقولُ: أيُّها النَّاسُ، لَحِقَت كلُّ أُمَّةٍ بما كانت تَعبُدُ وبَقِيتُم، فلا يُكلِّمُه يومئذٍ إلَّا الأنبياءُ، يَقولُون: فارَقْنا النَّاسَ في الدُّنيا ونحنُ كنَّا إلى صُحبتِهم فيها أحوَجَ، لَحِقَت كلُّ أُمَّةٍ بما كانت تَعبُدُ، ونحنُ نَنتظِرُ ربَّنا الَّذي كنَّا نَعبُدُ، فيَقولُ: أنا ربُّكم، فيَقولُون: نَعوذُ باللهِ منكَ، فيَقولُ: هلْ بيْنكم وبيْن اللهِ مِن آيةٍ تَعرِفونها؟ فيَقولُون: نعمْ، فيُكشَفُ عن ساقٍ، فيَخِرُّ ساجدًا أجْمَعون، ولا يَبْقى أحدٌ كان يَسجُدُ في الدُّنيا سُمعةً ولا رِياءً ولا نِفاقًا، إلَّا على ظَهرِه طبَقٌ واحدٌ، كلَّما أراد أنْ يَسجُدَ خرَّ على قَفاهُ. قال: ثمَّ يَرفَعُ بَرُّنا ومُسِيئُنا، وقدْ عاد لنا في صُورتِه الَّتي رأيْناه فيها أوَّلَ مرَّةٍ، فيَقولُ: أنا ربُّكم، فيَقولُون: نعمْ، أنتَ ربُّنا، ثلاثَ مرَّاتٍ، ثمَّ يُضرَبُ الجِسرُ على جَهنَّمَ، قُلْنا: وما الجِسرُ يا رَسولَ اللهِ، بأبِينا أنتَ وأُمِّنا؟ قال: دَحْضٌ مَزِلَّةٌ، لها كَلاليبُ وخَطاطيفُ وحَسَكةٌ، بنَجْدٍ عَقيقٍ، يُقالُ لها: السَّعدانُ، فيَمُرُّ المؤمنُ كلَمْحِ البرْقِ، وكالطَّرْفِ، وكالرِّيحِ، وكالطَّيرِ، وكأجاوِدِ الخيْلِ والمراكِبِ، فناجٍ مُسَلَّمٌ، ومَخدوشٌ مُرسَلٌ، ومُكَرْدَسٌ في نارِ جَهنَّمَ، والَّذي نَفْسي بيَدِه، ما أحدُكم بأشدَّ منا شِدَّةً في الحقِّ يَراه مِنَ المُؤمنينَ في إخوانِهم إذا رَأَوهم قدْ خَلَصوا مِنَ النَّارِ، يَقولُون: أيْ ربَّنا، إخوانُنا كانوا يُصَلُّون معنا، ويَصومون معنا، ويَحُجُّون معنا، ويُجاهِدون معنا، قدْ أخَذَتْهم النَّارُ، فيَقولُ اللهُ تَبارك وتعالَى: اذْهَبوا، فمَن عرَفْتُم صُورتَه فأخْرِجوه، وتُحرَّمُ صُورتُهم على النَّارِ، فيَجِدُ الرَّجلَ قدْ أخَذَتْه النَّارُ إلى قَدَمَيه، وإلى أنصافِ ساقيْه، وإلى رُكبَتَيْه، وإلى حِقْوَيْه، فيَخرُجون منها بشَرًا، ثمَّ يَعودون فيَتكلَّمون، فلا يَزالُ يَقولُ لهم حتَّى يَقولَ: اذْهَبوا، فأخْرِجوا مَن وجَدْتُم في قَلبِه مِثقالَ ذرَّةٍ مِن خَيرٍ فأخْرِجوه. فكان أبو سَعيدٍ إذا حدَّث بهذا الحديثِ، يَقولُ: إنْ لم تُصَدِّقوا فاقْرَؤوا {إِنَّ اللَّهَ لَا يَظْلِمُ مِثْقَالَ ذَرَّةٍ وَإِنْ تَكُ حَسَنَةً يُضَاعِفْهَا وَيُؤْتِ مِنْ لَدُنْهُ أَجْرًا عَظِيمًا} [النساء: 40]، فيَقولُون: ربَّنا، لم نَذَرْ فيها خَيرًا، فيَقولُ: هلْ بقِيَ إلَّا أرحمُ الرَّاحمينَ؟ قدْ شَفَعَت الملائكةُ وشَفَع الأنبياءُ، فهلْ بَقِيَ إلَّا أرحَمُ الرَّاحمينَ؟ قال: فيَأخُذُ قَبْضةً مِنَ النَّارِ، فيُخرِجُ قومًا قدْ عادُوا حُمَمةً، لم يَعمَلوا له عمَلَ خَيرٍ قطُّ، فيُطرَحون في نَهرٍ يُقالُ له: نَهرُ الحياةِ، فيَنبُتون فيه -والَّذي نَفْسي بيَدِه- كما تَنبُتُ الحِبَّةُ في حَمِيلِ السَّيلِ، ألمْ تَرَوها وما يَلِيها مِن الظِّلِّ أصفَرَ، وما يَلِيها مِنَ الشَّمسِ أخضَرَ؟ قال: قُلْنا: يا رَسولَ اللهِ، كأنَّك تكونُ في الماشيةِ، قال: يَنبُتون كذلك، فيَخرُجون أمثالَ اللُّؤلؤِ، يُجعَلُ في رِقابِهم الخواتيمُ، ثمَّ يُرسَلون في الجنَّةِ، فيَقولُ أهلُ الجنَّةِ: هؤلاء الجَهنَّميون، هؤلاء الَّذين أخْرَجَهم مِنَ النَّارِ بغيرِ عَملٍ عَمِلوه ولا خَيرٍ قَدَّموه. يَقولُ اللهُ تعالَى: خُذوا، فلكمْ ما أخَذْتُم، فيَأخُذون حتَّى يَنتهَوا، ثمَّ يَقولُون: لنْ يُعطِينا اللهُ عزَّ وجلَّ ما أخَذْنا، فيَقولُ اللهُ تَبارك وتعالَى: فإنِّي أعْطَيْتُكم أفضَلَ ممَّا أخَذْتُم، فيَقولُون: ربَّنا، وما أفضَلُ مِن ذلكَ وممَّا أخَذْنا؟ فيَقولُ: رِضواني بلا سَخطٍ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح الإسناد ولم يخرجاه بهذه السياقة","takhrij":"أخرجه البخاري (7439)، ومسلم (183)، وأحمد (11127) جميعا بنحوه.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"9E4GpFz1"},{"id":"س-04187","fp":"93d60f5de623","stateId":585,"easy":"إذا ارتددت على عقبيك ← تُساق إلى النار","cause":"إنَّهمْ ارْتدُّوا بعدَكَ على أدْبارِهِمْ القَهْقَرَى","result":"إلى النارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[20],"ref":"صحيح الجامع 2867","srcLabel":"البخاري","text":["بيْنما أنا نائِمٌ إذا زُمْرَةٌ ، حتى إذا عرَفْتُهُمْ ، خرَجَ رجلٌ من بيْنِي وبيْنِهِمْ فقال : هَلُمَّ ، قُلتُ : أيْنَ ؟ قال : إلى النارِ واللهِ ، قُلتُ : ما شأنُهُمْ ؟ قال : ",["إنَّهمْ ارْتدُّوا بعدَكَ على أدْبارِهِمْ القَهْقَرَى",1]," ، ثمَّ إذا زُمرةٌ ، حتى إذا عرَفتُهُمْ خرَجَ رجلٌ من بينِي وبينِهِمْ فقال : هلُمَّ ، قُلتُ : أيْنَ ؟ قال : ",["إلى النارِ",2]," ، قُلتُ : ما شأنُهُمْ ؟ قال : إنَّهمْ ارتَدُّوا بعدَكَ على أدْبارِهِمْ القَهْقَرَى ، فلا أُراهُ يَخلُصُ مِنهُمْ إلَّا مثْلُ هَمَلِ النَّعَمِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6587) واللفظ له، وأبو عوانة في ((المستخرج)) (10164)، وابن عبد البر في ((التمهيد)) (2/ 296) بنحوه.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"tWLctCbb"},{"id":"س-07893","fp":"4c2770700ab4","stateId":585,"easy":"إذا كنت كافراً ← يتغشاك الموت يوم القيامة","cause":"وأمَّا الكافِرُ","result":"فيَتَغشَّاه المَوْتُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-03205","س-00545"],"ref":"الأحاديث المختارة 2695","srcLabel":"متفق عليه","text":["«حَدَّثَني نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنِّي لقائِمٌ أنْتَظِرُ أمَّتي تَعبُرُ الصِّراطَ إذ جاءَني عيسى، قالَ: فقالَ: هذه الأنْبِياءُ قد جاءَتْك يا مُحمَّدُ يَسْألونَ، أو قالَ: يَجْتَمِعونَ إليك ويَدْعونَ اللهَ عَزَّ وجَلَّ أن تُفرِّقَ بَيْنَ جَمْعِ الأُمَمِ إلى حيثُ يَشاءُ اللهُ؛ لِغَمِّ ما هُمْ فيه، فالخَلْقُ مُلجَمونَ في العَرَقِ، فأمَّا المُؤْمِنُ فهو عليه كالزُّكْمةِ، ",["وأمَّا الكافِرُ",1]," ",["فيَتَغشَّاه المَوْتُ",2],"، قالَ: قالَ عيسى: انْتَظِرْ حتَّى أرْجِعَ إليك، قالَ: فذَهَبَ نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ فقامَ تحتَ العَرْشِ، فلَقيَ ما لم يَلْقَ مَلَكٌ مُصْطَفًى، ولا نَبِيٌّ مُرسَلٌ، فأَوْحى اللهُ عَزَّ وجَلَّ إلى جِبْريلَ أن اذْهَبْ إلى مُحمَّدٍ صلَّى اللهُ عليه وسلَّمَ فقُلْ له: ارْفَعْ رأسَك، سَلْ تُعْطَه، واشْفَعْ تُشَفَّعْ، قالَ: فشُفِّعْتُ في أمَّتي أن أُخرِجَ مِن كلِّ تِسْعةٍ وتِسْعينَ إنْسانًا واحِدًا، قالَ: فما زِلْتُ أتَرَدَّدُ على رَبِّي عَزَّ وجَلَّ فلا أقومُ مِنه مَقامًا إلَّا شُفِّعْتُ حتَّى أعْطاني اللهُ مِن ذلك أن قالَ: يا مُحمَّدُ، أَدخِلْ مِن أمَّتِك مِن خَلْقِ اللهِ مَن شَهِدَ أنْ لا إلهَ إلَّا اللهُ يَوْمًا واحِدًا مُخلِصًا، وماتَ على ذلك»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"قيامة › الشفاعة","dorar":"RwPYP6i7"},{"id":"س-02618","fp":"38435534fef2","stateId":585,"easy":"إذا مت كافراً ← لا يُقبل منك ملء الأرض ذهباً فداءً","cause":"يُجاءُ بالكافرِ يَومَ القيامةِ","result":"فَلَنْ يُقْبَلَ مِنْ أَحَدِهِمْ مِلْءُ الْأَرْضِ ذَهَبًا وَلَوِ افْتَدَى بِهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج المسند لشعيب 13288","srcLabel":"مسلم","text":[["يُجاءُ بالكافرِ يَومَ القيامةِ",1],"، فيُقالُ له: أرأيْتَ لو كان لك مِلْءُ الأرضِ ذهَبًا، أكنتَ مُفْتَديًا به؟ فيقولُ: نعَمْ يا ربِّ. قال: فيُقالُ: لقد سُئلْتَ أيْسَرَ مِن ذلك. فذلك قَولُه عزَّ وجلَّ: {إِنَّ الَّذِينَ كَفَرُوا وَمَاتُوا وَهُمْ كُفَّارٌ ",["فَلَنْ يُقْبَلَ مِنْ أَحَدِهِمْ مِلْءُ الْأَرْضِ ذَهَبًا وَلَوِ افْتَدَى بِهِ",2],"} [آل عمران: 91]."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (2805)، وأحمد (13288) واللفظ له","bab":"إيمان › الأمر بالإيمان بالله تعالى ورسوله وشرائع الدين","dorar":"uF4Q4N8E"},{"id":"س-04107","fp":"53b049e5b126","stateId":585,"easy":"إذا لم تجب داعي الله ← يعاقبك أو يعذبك","cause":"ومن لم يجبهُ","result":"عاقبَهُ أو عذَّبَهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الترمذي 2861","srcLabel":"مسلم","text":["قالَ صلَّى رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ العشاءَ ثمَّ انصرفَ فاخذ بيدِ عبدِ اللَّهِ بنِ مسعودٍ حتَّى خرجَ بِهِ إلى بَطحاءِ مَكَّةَ فأجلسَهُ ثمَّ خطَّ علَيهِ خطًّا ثمَّ قالَ: لا تبرَحنَّ خطَّكَ فإنَّهُ سينتَهي إليكَ رجالٌ فلا تُكَلِّمهم فإنَّهم لا يُكَلِّمونَكَ، قالَ: ثمَّ مضى رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ حيثُ أرادَ، فبينا أَنا جالسٌ في خطِّي إذ أتاني رجالٌ كأنَّهمُ الزُّطُّ أشعارُهُم وأجسامُهُم لا أرى عورةً ولا أرى قِشرًا وينتَهونَ إليَّ، ولا يجاوزونَ الخطَّ ثمَّ يَصدرونَ إلى رسولِ اللَّهِ حتَّى إذا كانَ من آخرِ اللَّيلِ، لَكِن رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ قد جاءَني وأَنا جالسٌ، فقالَ: لقد أراني منذُ اللَّيلة ثمَّ دخلَ عليَّ في خطِّي فتوسَّدَ فخذي ورَقدَ وَكانَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ إذا رقدَ نفخَ، فبينا أَنا قاعدٌ ورسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ متوسِّدٌ فخذي إذا أَنا برجالٍ علَيهِم ثيابٌ بيضٌ اللَّهُ أعلمُ ما بِهِم منَ الجَمالِ فانتَهَوا إليَّ، فجلسَ طائفةٌ منهم عندَ رأسِ رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وطائفةٌ منهم عندَ رجليهِ ثمَّ قالوا بينَهُم: ما رَأينا عبدًا قطُّ أوتيَ مثلَ ما أوتيَ هذا النَّبيُّ صلَّى اللَّهُ علَيهِ وسلَّمَ إنَّ عينيهِ تَنامانِ وقلبُهُ يَقظانُ، اضربوا لَهُ مثلًا مثلُ سيِّدٍ بنى قصرًا ثمَّ جعلَ مائدة فدعا النَّاسَ إلى طعامِهِ وشرابِهِ، فمَن أجابَهُ أَكَلَ من طعامِهِ وشربَ من شرابِهِ ومن لم يجبهُ عاقبَهُ - أو قالَ: عذَّبَهُ - ثمَّ ارتفَعوا، واستيقَظَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ عندَ ذلِكَ فقالَ: سمعتَ ما قالَ هؤلاءِ؟ وَهَل تدري مَن هم؟ قلتُ: اللَّهُ ورسولُهُ أعلمُ، قالَ: همُ الملائِكَةُ، فتَدري ما المثلُ الَّذي ضرَبوه؟ قلتُ: اللَّهُ ورسولُهُ أعلمُ، قالَ: المثلُ الَّذي ضرَبوه الرَّحمنُ بنى الجنَّةَ ودعى إليها عِبادَه، فمن أجابَهُ دخلَ الجنَّةَ ",["ومن لم يجبهُ",1]," ",["عاقبَهُ أو عذَّبَهُ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"حسن صحيح","takhrij":"أخرجه الترمذي (2861) بلفظه، وقوام السنة في ((دلائل النبوة)) (65) باختلاف يسير، ومسلم (450) بنحوه.","bab":"جن › وفد الجن","dorar":"umsXQrcS"},{"id":"س-04524","fp":"079cae6aabcd","stateId":585,"easy":"إذا أبيت التوحيد وقد سُئلت ما هو أيسر منه ← تُرد إلى النار","cause":"قد سألتُكَ أَقَلَّ من ذلك وأَيْسَرَ ، فلم تفعلْ","result":"فيُرَدُّ إلى النارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح الجامع 7996","srcLabel":"مسلم","text":["يُؤْتَى بالرجلِ يومَ القيامةِ من أهلِ الجنةِ ، فيقولُ له : يا ابنَ آدمَ ! كيف وَجَدْتَ مَنْزِلَكَ ؟ فيقولُ : أَيْ رَبِّ ! خيرُ مَنْزِلٍ ، فيقولُ : سَلْ وتَمَنَّ ، فيقولُ : يا ربِّ ما أسألُ ولا أَتَمَنَّى إلَّا أن تَرُدَّنِي إلى الدنيا ، فأُقْتَلَ في سبيلِك عَشْرَ مِرَارٍ ، لِمَا يَرَى من فضلِ الشهادةِ ، ويُؤْتَى بالرجلِ من أهلِ النارِ ، فيقولُ له : يا ابنَ آدمَ ! كيف وَجَدْتَ مَنْزِلَكَ ؟ فيقولُ : أَيْ رَبِّ ! شَرُّ مَنْزِلٍ ، فيقولُ له : أَتَفْتَدِي منه بطِلَاعِ الأرضِ ذهبًا ؟ فيقولُ : أَيْ رَبِّ ! نعم ، فيقولُ : كَذَبْتَ ",["قد سألتُكَ أَقَلَّ من ذلك وأَيْسَرَ ، فلم تفعلْ",1]," ",["فيُرَدُّ إلى النارِ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2805)، والنسائي (3160) مختصراً، وأحمد (13162) واللفظ له","bab":"جهاد › فضل الشهيد","dorar":"TsXcFLkC"},{"id":"س-02582","fp":"fb1b87fff9d4","stateId":585,"easy":"إذا قرّبت لغير الله ولو ذباباً ← تدخل النار","cause":"فقرَّبَ ذبابًا","result":"فدخل النارَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[20],"ref":"شرح كتاب التوحيد لابن باز 100","srcLabel":"أحمد","text":["دخل الجنَّةَ رجلٌ في ذُبابٍ ودخل النارَ رجلٌ في ذُبابٍ قالوا: كيف ذلك يا رسولَ اللهِ؟ قال: مر رجلان على قومٍ لهم صنمٌ لا يجوزُه أحدٌ حتى يقربَ له شيئًا، فقالوا لأحدِهما: قربْ فقال: ليس عندي شيءٌ أقرِّبُ، قالوا له: قرِّبْ ولو ذُبابًا، ",["فقرَّبَ ذبابًا",1],"، فخلوا سبيلَه ",["فدخل النارَ",2],"، وقالوا للآخرِ: قرِّبْ فقال: ما كنتُ لأقرِّبَ لأحدٍ شيئًا دون اللهِ عزَّ وجلَّ فضربوا عنقَه فدخل الجنَّةَ."],"grade":"حسن","narrator":"[سلمان]","muhaddith":"إسناده جيد","takhrij":"أخرجه ابن أبي شيبة (33038)، وأحمد في ((الزهد)) (84)، وابن الأعرابي في ((معجم الشيوخ)) (1796)، وأبو نعيم في ((حلية الأولياء)) (1/ 203) واللفظ لهم.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"RI2lLIuE"},{"id":"س-08350","fp":"9517871914f7","stateId":585,"easy":"إذا كذّبت بالحوض ← لا يسقيك الله منه","cause":"فمَن كذَّبَ به","result":"فلا سَقاهُ الله منه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج سنن أبي داود 4749","srcLabel":"أبو داود","text":["شَهِدتُ أبا بَرْزةَ دخَلَ على عُبيدِ اللهِ بنِ زيادٍ فحدَّثَني فُلانٌ -سمَّاه مُسلمٌ-، وكان في السِّماطِ: فلمَّا رآه عُبَيدُ اللهِ، قال: إنَّ مُحمَّديَّكم هذا الدَّحداحَ، ففَهِمَها الشَّيخُ، فقال: ما كنتُ أحسِبُ أنِّي أبْقى في قَومٍ يُعيِّروني بصُحبةِ مُحمَّدٍ صلَّى اللهُ عليه وسلَّمَ! فقال له عُبَيدُ اللهِ: إنَّ صُحبةَ مُحمَّدٍ صلَّى اللهُ عليه وسلَّمَ لك زَينٌ غيرُ شَينٍ، ثُمَّ قال: إنَّما بُعِثتُ إليكَ لِأسأَلَك عن الحَوضِ، سَمِعتَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يذكُرُ فيه شيئًا؟ قال أبو بَرْزةَ: نَعَمْ، لا مرَّةً، ولا ثِنْتَينِ، ولا ثلاثًا، ولا أرْبعًا، ولا خَمسًا، ",["فمَن كذَّبَ به",1]," ",["فلا سَقاهُ الله منه",2],"، ثُمَّ خرَجَ مُغضَبًا."],"grade":"صحيح","narrator":"أبو برزة الأسلمي نضلة بن عبيد","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4749) واللفظ له، وأحمد (19807) مختصرا، والبيهقي في ((البعث والنشور)) (154) بنحوه.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"IgYVwo6K","merged":4,"otherRefs":["تخريج كتاب السنة 720 (صحيح)","تخريج المسند لشعيب 19763 (صحيح)","تخريج المسند لشعيب 19779 (صحيح)"]},{"id":"س-02393","fp":"4823deb87473","stateId":585,"easy":"إذا تمردت على الله وأبيت أن تقول لا إله إلا الله ← تُعذّب","cause":"الماردُ المتمردُ، الذي يتمردُ على اللهِ وأبى أنْ يقولَ، لا إلهَ إلا اللهُ","result":"لا يعذبُ منْ عبادِه إلا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"الجامع الصغير 1818","srcLabel":"ابن ماجه","text":["إنَّ الله تعالى ",["لا يعذبُ منْ عبادِه إلا",2]," ",["الماردُ المتمردُ،  الذي يتمردُ على اللهِ وأبى أنْ يقولَ،  لا إلهَ إلا اللهُ",1]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (4297)، والعقيلي في ((الضعفاء الكبير)) (1/96)، والواحدي في ((التفسير الوسيط)) (367) مطولاً","bab":"إسلام › فضل الشهادتين","dorar":"oe6Hl90m"},{"id":"س-02786","fp":"fa59ed455ac8","stateId":585,"easy":"إذا نافقت ← يُطفأ نورك يوم القيامة","cause":"المُنافِقينَ","result":"ثُمَّ يُطفَأُ نورُ المُنافِقينَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-02798","س-08446"],"otherNeedIds":[20],"ref":"تخريج المسند لشعيب 14721","srcLabel":"أحمد","text":["نحنُ يومَ القيامةِ على كَوْمٍ فوقَ النَّاسِ، فيُدعى بالأُمَمِ بأَوْثانِها، وما كانت تَعبُدُ، الأوَّلَ، فالأوَّلَ، ثُمَّ يأتينا رَبُّنا عزَّ وجلَّ بعدَ ذلك، فيقولُ: ما تَنتظرون؟ فيقولونَ: نَنتَظِرُ ربَّنا عزَّ وجلَّ، فيقولُ: أنا رَبُّكُم، فيقولونَ: حتى نَنظُرَ إليه، قال: فيَتَجَلَّى لهم وهو يَضحَكُ، ويُعْطي كلَّ إنسانٍ منهم مُنافِقٍ ومُؤمِنٍ نورًا، وتَغْشاهُ ظُلْمةٌ، ثُمَّ يَتْبَعونَه معهم، المُنافِقون على جِسْرِ جَهنَّمَ، فيه كَلاليبُ وحَسَكٌ يَأخُذونَ مَنْ شاءَ، ",["ثُمَّ يُطفَأُ نورُ المُنافِقينَ",2],"، ويَنجو المُؤمِنونَ، فتَنْجو أوَّلُ زُمْرةٍ وُجوهُهم كالقَمَرِ ليلَةَ البَدْرِ، سَبعونَ ألفًا لا يُحاسَبونَ، ثُمَّ الذين يَلونَهم، كأَضْوَأِ نَجمٍ في السَّماءِ، ثُمَّ ذلك حتى تَحِلَّ الشفاعةُ، فيَشْفَعونَ حتى يَخْرُجَ مَن قال: لا إلهَ إلَّا اللهُ ممَّن في قلبِه ميزانُ شَعيرةٍ، فيُجْعَلُ بفِناءِ الجَنَّةِ، ويَجْعَلُ أهلَ الجَنَّةِ يُهْريقونَ عليهم مِن الماءِ، حتى يَنْبُتون نَباتَ الشَّيءِ في السَّيلِ، ويَذهَبُ حَرَقُهم، ثُمَّ يَسْألُ اللهَ عزَّ وجلَّ حتى يَجْعَلَ له الدُّنيا، وعَشَرةَ أمْثالِها."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أحمد (14721) واللفظ له، والدارمي في ((الرد على الجهمية)) (185) مختصراً، والطبراني في ((المعجم الأوسط)) (9075) باختلاف يسير","bab":"إيمان › النفاق","dorar":"UPme3nkI"},{"id":"س-02798","fp":"65df7a68eff8","stateId":585,"easy":"إذا نافقت ← يُطفأ نورك","cause":"المنافقُ","result":"فيُطفئُ نورَهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-02786","otherNeedIds":[20],"ref":"المستدرك على الصحيحين 3878","text":["عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهُما في قولِ اللهِ عزَّ وجلَّ: {يَوْمَ لَا يُخْزِي اللَّهُ النَّبِيَّ وَالَّذِينَ آمَنُوا مَعَهُ نُورُهُمْ يَسْعَى بَيْنَ أَيْدِيهِمْ وَبِأَيْمَانِهِمْ يَقُولُونَ رَبَّنَا أَتْمِمْ لَنَا نُورَنَا} [التحريم: 8] قالَ: ليس أَحَدٌ مِنَ الموحِّدينَ إلَّا يُعطى نورًا يومَ القيامةِ، فأمَّا ",["المنافقُ",1]," ",["فيُطفئُ نورَهُ",2],"، والمؤمنُ مُشفِقٌ ممَّا رَأى مِن إطفاءِ نورِ المنافقِ، فهو يقولُ: {رَبَّنَا أَتْمِمْ لَنَا نُورَنَا}."],"grade":"صحيح","narrator":"عكرمة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن أبي حاتم كما في ((تفسير)) لابن كثير (1/ 192) بلفظ مقارب.","bab":"إيمان › النفاق","dorar":"ozt0akKO"},{"id":"س-02980","fp":"fb90076c12d5","stateId":585,"easy":"إذا أنكرت الصلوات الخمس ← تكون من أهل الضلال","cause":"قومٌ يَقولُون: إنْ كان أوَّلِيَّتُنا ضُلَّالًا ما بال خمْسُ صَلواتٍ في اليومِ واللَّيلةِ؟! إنَّما هو صَلاتانِ العصرُ والفجرُ، وقومٌ يَقولُون: إنَّما الإيمانٌ كلامٌ، وإنْ زَنى وإنْ قَتَل","result":"أهلَ دِينينِ مِن أُمَّةِ محمَّدٍ صلَّى اللهُ عليه وسلَّمَ في النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"المستدرك على الصحيحين 8514","srcLabel":"الحاكم","text":["عن حُذَيفةَ بنِ اليَمانِ، قال: إنِّي لَأعلَمُ ",["أهلَ دِينينِ مِن أُمَّةِ محمَّدٍ صلَّى اللهُ عليه وسلَّمَ في النَّارِ",2],": ",["قومٌ يَقولُون: إنْ كان أوَّلِيَّتُنا ضُلَّالًا ما بال خمْسُ صَلواتٍ في اليومِ واللَّيلةِ؟! إنَّما هو صَلاتانِ العصرُ والفجرُ، وقومٌ يَقولُون: إنَّما الإيمانٌ كلامٌ، وإنْ زَنى وإنْ قَتَل",1],"."],"grade":"صحيح","narrator":"ابن الديلمي","muhaddith":"صحيح على شرط الشيخين، ولم يخرجاه","bab":"إيمان › الوعيد","dorar":"NElFZPs0"},{"id":"س-03164","fp":"0fe95cab0b4c","stateId":585,"easy":"إذا عبدت غير الله ← تتبع معبودك حتى يُقحمك النار","cause":"ما كانوا يَعبُدونَ","result":"فيَتبَعونَهم حتى يُقحِّمونَهم النَّارَ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-03150","ref":"تخريج المسند لشعيب 19654","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يَجمَعُ اللهُ عزَّ وجلَّ الأُمَمَ في صَعيدٍ واحدٍ يومَ القيامةِ، فإذا بَدا للهِ عزَّ وجلَّ أنْ يَصدَعَ بيْنَ خَلقِه، مَثَّلَ لكلِّ قَومٍ ",["ما كانوا يَعبُدونَ",1],"، ",["فيَتبَعونَهم حتى يُقحِّمونَهم النَّارَ",2],"، ثُمَّ يَأتينا ربُّنا عزَّ وجلَّ ونحن على مَكانٍ رَفيعٍ فيَقولُ: مَن أنتم؟ فنَقولُ: نحن المُسلِمونَ، فيَقولُ: ما تَنتظِرونَ؟ فيَقولونَ: نَنتظِرُ ربَّنا عزَّ وجلَّ، قال: فيَقولُ: وهل تَعرِفونَه إنْ رَأَيتُموه؟ فيَقولونَ: نَعَمْ، فيَقولُ: كيف تَعرِفونَه ولم تَرَوْه؟ فيَقولونَ: نَعَمْ، إنَّه لا عِدلَ له، فيَتجَلَّى لنا ضاحكًا، يقولُ: أبشِروا أيُّها المُسلِمونَ؛ فإنَّه ليس منكم أحَدٌ إلَّا جَعَلتُ مَكانَه في النَّارِ يهوديًّا أو نصرانيًّا."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"قوله: \"ليس منكم أحد إلا جعلت مكانه في النار يهوديا أو نصرانيا\" صحيح","takhrij":"أخرجه أحمد (19654) واللفظ له، والدارمي في ((الرد على الجهمية)) (180) باختلاف يسير، وابن خزيمة في ((التوحيد)) (2/577) مختصراً","bab":"إيمان › توحيد الأسماء والصفات","dorar":"ofp5NH1J"},{"id":"س-03945","fp":"43e20e3d6fcb","stateId":585,"easy":"إذا كفرت ← تجيء يوم القيامة تحسب عملك شيئاً فلا تجده","cause":"وَالَّذِينَ كَفَرُوا أَعْمَالُهُمْ كَسَرَابٍ بِقِيعَةٍ","result":"وكذلكَ الكافرُ يَجيءُ يومَ القيامةِ وهو يحسِبُ أنَّ له عند اللهِ خيرًا فلا يجدُهُ، ويُدخلُهُ اللهُ النَّارَ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"otherNeedIds":[45],"ref":"المستدرك على الصحيحين 3556","srcLabel":"ابن أبي حاتم","text":["عنْ أُبيِّ بنِ كَعْبٍ رَضيَ اللهُ عنه في قولِ اللهِ عزَّ وجلَّ: {اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ} [النور: 35]، فقَرَأَ الآيةَ، ثُمَّ قالَ: {",["وَالَّذِينَ كَفَرُوا أَعْمَالُهُمْ كَسَرَابٍ بِقِيعَةٍ",1]," يَحْسَبُهُ الظَّمْآنُ مَاءً حَتَّى إِذَا جَاءَهُ لَمْ يَجِدْهُ شَيْئًا وَوَجَدَ اللَّهَ عِنْدَهُ فَوَفَّاهُ حِسَابَهُ وَاللَّهُ سَرِيعُ الْحِسَابِ} [النور: 39] قالَ: ",["وكذلكَ الكافرُ يَجيءُ يومَ القيامةِ وهو يحسِبُ أنَّ له عند اللهِ خيرًا فلا يجدُهُ، ويُدخلُهُ اللهُ النَّارَ",2],". قالَ: وضَرَبَ مثلًا آخرَ للكافرِ، فقالَ: {أَوْ كَظُلُمَاتٍ فِي بَحْرٍ لُجِّيٍّ يَغْشَاهُ مَوْجٌ مِنْ فَوْقِهِ مَوْجٌ مِنْ فَوْقِهِ سَحَابٌ ظُلُمَاتٌ بَعْضُهَا فَوْقَ بَعْضٍ إِذَا أَخْرَجَ يَدَهُ لَمْ يَكَدْ يَرَاهَا وَمَنْ لَمْ يَجْعَلِ اللَّهُ لَهُ نُورًا فَمَا لَهُ مِنْ نُورٍ} [النور: 40]، فهو ينقُلُهُ في خمسٍ مِنَ الظُّلَمِ؛ فكلامُهُ ظُلمةٌ، وعَملُهُ ظُلمةٌ، ومَدخلُهُ ظُلمةٌ، ومَخرجُهُ ظُلمةٌ، ومَصيرُهُ إلى الظُّلماتِ إلى النَّارِ يومَ القيامةِ."],"grade":"صحيح","narrator":"أبو العالية","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن أبي حاتم في ((التفسير)) (14667)، والطبري في ((جامع البيان)) (19/ 196) كلاهما مختصرا.","bab":"تفسير آيات › سورة النور","dorar":"bND77vuO"},{"id":"س-08192","fp":"e618f095ad8e","stateId":585,"easy":"إذا عبدت غير الله ← تتبع معبودك حتى يوردك النار","cause":"آلهتُهُم الَّتي كانوا يعبدونَها","result":"فيتبِعونَها حتَّى تُوردَهم النَّارُ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-03150","ref":"المطالب العالية 5/100","text":["إنَّ عبدَ اللهِ بنَ مسعودٍ رضيَ اللهُ عنهُ حدَّثَ عمرَ بنَ الخطَّابِ رضيَ اللهُ عنهُ هذا الحديثَ فقال : إذا حُشِرَ النَّاسُ يومَ القيامةِ قاموا أربعينَ ، على رؤوسِهِم الشَّمسُ ، شاخصةً أبصارُهُم إلى السَّماءِ ، ينتظرونَ الفصلَ ، كلُّ برٍّ منهُم وفاجرٍ ، لا يتكلمُ منهُم بشرٌ ، ثمَّ يُنادي مُنادٍ : أليسَ عدلًا من ربِّكُم الَّذي خلقَكُم وصوَّرَكُم ورزقَكُم ثمَّ عبدتُم غيرَهُ أن يُولِّي كلَّ قَومٍ ما تولَّوْا ؟ فيقولونَ : بلَى . فيُنادي بذلكَ ملَكٌ ثلاثَ مرَّاتٍ ، ثمَّ يُمَثَّلُ لكلِّ قَومٍ ",["آلهتُهُم الَّتي كانوا يعبدونَها",1]," ، ",["فيتبِعونَها حتَّى تُوردَهم النَّارُ",2]," ، فيبقَى المؤمنونَ والمنافقونَ ، فيخرُّ المؤمنونَ سُجَّدًا ، وتُدْمَجُ أصلابُ المنافقينَ فتكونُ عظمًا واحدًا كأنَّها صَيَاصِيُّ البقرِ ، ويخرُّونَ على أقْفيتِهِم ، فيقولُ اللهُ تعالى لهُم : ارفَعوا رؤوسَكُم إلى نورِكم بقدرِ أعمالِكُم ، فيرفعُ الرَّجلُ رأسَهُ ونورُهُ بينَ يدَيْهِ مثلُ الجبلِ ، ويرفعُ الرَّجلُ رأسَهُ ونورُهُ بينَ يدَيهِ مثلُ القصرِ ، ويرفعُ الرَّجلُ رأسَهُ ونورُهُ بينَ يدَيهِ مثلُ البَيتِ ، حتَّى ذكرَ مثلَ الشَّجرةِ ، فيمضونَ على الصِّراطِ كالبرقِ ، وكالرِّيحِ ، وكحضرِ الفرسِ ، وكاشتدادِ الرَّجلِ ، حتَّى يبقَى آخرَ النَّاسِ نورُهُ على إبهامِ رجلِهِ مثلُ السِّراجِ ، فأحيانًا يُضيءُ لهُ ، وأحيانًا يخفَى عليهِ ، فتنفثُ منهُ النَّارُ ، فلا يزالُ كذلكَ حتَّى يخرجَ فيقولُ : ما يدري أحدٌ ما نجا منهُ غَيري ، ولا أصابَ أحدٌ مثلَ ما أصبتَ ، إنَّما أصابَني حرُّها ونجَوتُ منها ، قال : فيُفتَحُ لهُ بابٌ من الجنَّةِ فيقولُ : يا ربِّ ، أدخِلْني هذا ، فيقولُ : عبدي لعلِّي إن أدخلتُكَ تسألْني غيرَهُ . قال : فيُدخِلُهُ ، فبَينا هوَ يعجبُ بما هوَ فيهِ إذ فُتِحَ لهُ بابٌ آخرُ ، فيستَحقِرُ في عَينِهِ الَّذي هوَ فيهِ ، فيقولُ : يا ربِّ ، أدخِلْني هذا . فيقولُ : أو لَم تزعُمْ أنَّكَ لا تسألْني غيرَهُ ، فيقولُ : وعزَّتِكَ وجلالِكَ لئن أدخلتَنِيهِ لا أسألُكَ غيرَهُ . قال : فيُدخِلُهُ حتَّى يُدْخِلَهُ أربعةَ أبوابٍ كلَّها يسألُها ، ثمَّ يستقبلُهُ رجلٌ مثلُ النُّورِ ، فإذا رآهُ هوَى يسجدُ لهُ فيقولُ : ما شأنُكَ ؟ فيقولُ : ألستَ بربِّي ؟ فيقولُ : إنَّما أنا قَهرمانٌ لكَ في الجنَّةِ [ من ] ألفِ قَهرمانٍ على ألفِ قصرٍ ، بينَ كلِّ قصرَيْنِ مسيرةُ ( ألفِ سنةٍ ) ، يُرَى أقصاها كما يُرَى أدناها ، ثمَّ يُفْتَحُ لهُ بابٌ من زَبرجَدةٍ خضراءَ ، فيها سبعونَ بابًا ، في كلِّ بابٍ منها أزواجٌ وسُرُرٌ ومناصفٌ ، فيقعدُ مع زوجتِهِ فتُناولُهُ الكأسَ ، فتقولُ : لأنتَ منذُ ناولتُكَ الكأسَ أحسنُ منكَ قبلَ ذلكَ بسبعينَ ضِعْفًا ، علَيها سبعونَ حُلَّةً ، ألوانُها شتَّى يُرَى مخُّ ساقِها ، ويلبسُ الرَّجلُ ثيابَهُ على كبدِها ، وكبدُها مِرْآتُهُ"],"grade":"صحيح","narrator":"قيس بن السكن وأبو عبيدة بن عبدالله","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبري في ((تفسيره)) (23/ 190) بلفظ قريب، وأورده البلوصيري في ((الإتحاف)) (7684) وعزاه لإسحاق.","bab":"ملائكة › أعمال الملائكة","dorar":"II3fMWHr"},{"id":"س-08193","fp":"4ca62cb15d5c","stateId":585,"easy":"إذا نافقت ← يُدمج صلبك فلا تستطيع السجود","cause":"المنافقينَ","result":"وتُدْمَجُ أصلابُ المنافقينَ فتكونُ عظمًا واحدًا كأنَّها صَيَاصِيُّ البقرِ ، ويخرُّونَ على أقْفيتِهِم","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"المطالب العالية 5/100","srcLabel":"الطبري","text":["إنَّ عبدَ اللهِ بنَ مسعودٍ رضيَ اللهُ عنهُ حدَّثَ عمرَ بنَ الخطَّابِ رضيَ اللهُ عنهُ هذا الحديثَ فقال : إذا حُشِرَ النَّاسُ يومَ القيامةِ قاموا أربعينَ ، على رؤوسِهِم الشَّمسُ ، شاخصةً أبصارُهُم إلى السَّماءِ ، ينتظرونَ الفصلَ ، كلُّ برٍّ منهُم وفاجرٍ ، لا يتكلمُ منهُم بشرٌ ، ثمَّ يُنادي مُنادٍ : أليسَ عدلًا من ربِّكُم الَّذي خلقَكُم وصوَّرَكُم ورزقَكُم ثمَّ عبدتُم غيرَهُ أن يُولِّي كلَّ قَومٍ ما تولَّوْا ؟ فيقولونَ : بلَى . فيُنادي بذلكَ ملَكٌ ثلاثَ مرَّاتٍ ، ثمَّ يُمَثَّلُ لكلِّ قَومٍ آلهتُهُم الَّتي كانوا يعبدونَها ، فيتبِعونَها حتَّى تُوردَهم النَّارُ ، فيبقَى المؤمنونَ والمنافقونَ ، فيخرُّ المؤمنونَ سُجَّدًا ، ",["وتُدْمَجُ أصلابُ المنافقينَ فتكونُ عظمًا واحدًا كأنَّها صَيَاصِيُّ البقرِ ، ويخرُّونَ على أقْفيتِهِم",2]," ، فيقولُ اللهُ تعالى لهُم : ارفَعوا رؤوسَكُم إلى نورِكم بقدرِ أعمالِكُم ، فيرفعُ الرَّجلُ رأسَهُ ونورُهُ بينَ يدَيْهِ مثلُ الجبلِ ، ويرفعُ الرَّجلُ رأسَهُ ونورُهُ بينَ يدَيهِ مثلُ القصرِ ، ويرفعُ الرَّجلُ رأسَهُ ونورُهُ بينَ يدَيهِ مثلُ البَيتِ ، حتَّى ذكرَ مثلَ الشَّجرةِ ، فيمضونَ على الصِّراطِ كالبرقِ ، وكالرِّيحِ ، وكحضرِ الفرسِ ، وكاشتدادِ الرَّجلِ ، حتَّى يبقَى آخرَ النَّاسِ نورُهُ على إبهامِ رجلِهِ مثلُ السِّراجِ ، فأحيانًا يُضيءُ لهُ ، وأحيانًا يخفَى عليهِ ، فتنفثُ منهُ النَّارُ ، فلا يزالُ كذلكَ حتَّى يخرجَ فيقولُ : ما يدري أحدٌ ما نجا منهُ غَيري ، ولا أصابَ أحدٌ مثلَ ما أصبتَ ، إنَّما أصابَني حرُّها ونجَوتُ منها ، قال : فيُفتَحُ لهُ بابٌ من الجنَّةِ فيقولُ : يا ربِّ ، أدخِلْني هذا ، فيقولُ : عبدي لعلِّي إن أدخلتُكَ تسألْني غيرَهُ . قال : فيُدخِلُهُ ، فبَينا هوَ يعجبُ بما هوَ فيهِ إذ فُتِحَ لهُ بابٌ آخرُ ، فيستَحقِرُ في عَينِهِ الَّذي هوَ فيهِ ، فيقولُ : يا ربِّ ، أدخِلْني هذا . فيقولُ : أو لَم تزعُمْ أنَّكَ لا تسألْني غيرَهُ ، فيقولُ : وعزَّتِكَ وجلالِكَ لئن أدخلتَنِيهِ لا أسألُكَ غيرَهُ . قال : فيُدخِلُهُ حتَّى يُدْخِلَهُ أربعةَ أبوابٍ كلَّها يسألُها ، ثمَّ يستقبلُهُ رجلٌ مثلُ النُّورِ ، فإذا رآهُ هوَى يسجدُ لهُ فيقولُ : ما شأنُكَ ؟ فيقولُ : ألستَ بربِّي ؟ فيقولُ : إنَّما أنا قَهرمانٌ لكَ في الجنَّةِ [ من ] ألفِ قَهرمانٍ على ألفِ قصرٍ ، بينَ كلِّ قصرَيْنِ مسيرةُ ( ألفِ سنةٍ ) ، يُرَى أقصاها كما يُرَى أدناها ، ثمَّ يُفْتَحُ لهُ بابٌ من زَبرجَدةٍ خضراءَ ، فيها سبعونَ بابًا ، في كلِّ بابٍ منها أزواجٌ وسُرُرٌ ومناصفٌ ، فيقعدُ مع زوجتِهِ فتُناولُهُ الكأسَ ، فتقولُ : لأنتَ منذُ ناولتُكَ الكأسَ أحسنُ منكَ قبلَ ذلكَ بسبعينَ ضِعْفًا ، علَيها سبعونَ حُلَّةً ، ألوانُها شتَّى يُرَى مخُّ ساقِها ، ويلبسُ الرَّجلُ ثيابَهُ على كبدِها ، وكبدُها مِرْآتُهُ"],"grade":"صحيح","narrator":"قيس بن السكن وأبو عبيدة بن عبدالله","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبري في ((تفسيره)) (23/ 190) بلفظ قريب، وأورده البلوصيري في ((الإتحاف)) (7684) وعزاه لإسحاق.","bab":"ملائكة › أعمال الملائكة","dorar":"II3fMWHr"},{"id":"س-08446","fp":"fe55ecab8dc9","stateId":585,"easy":"إذا نافقت ← تكون من أشد الناس عذاباً يوم القيامة","cause":"المُنافقونَ","result":"إنَّ أشدَّ النَّاسِ عذابًا يومَ القيامةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-02786","ref":"عمدة التفسير 1/756","text":["عن عبدِ اللَّهِ بنِ عمرٍو قالَ : ",["إنَّ أشدَّ النَّاسِ عذابًا يومَ القيامةِ",2]," ثلاثةٌ : ",["المُنافقونَ",1]," ، ومَن كفرَ مِن أصحابِ المائدةِ ، وآلُ فرعونَ"],"grade":"صحيح","narrator":"أبو المغيرة","muhaddith":"إسناده صحيح","bab":"نفاق › المنافق وما جاء فيه من الوعيد","dorar":"puHvtOE9"},{"id":"س-03205","fp":"c433e1497c08","stateId":585,"easy":"إذا كنت كافراً ← يلجمك العرق يوم القيامة","cause":"الكافرَ","result":"وإنَّهُم ليلقونَ من هولِ ذلك اليومِ شدَّةً حتى يُلجِمَ الكافرَ العرقُ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-07893","ref":"البدور السافرة 92","text":["لم يبلغْ ابنَ آدمَ شيئًا منذُ خلقَهُ اللهُ أشدَّ عليْهِ منَ الموتِ ، ثم إنَّ الموتَ أهونُ عليْهِ ممَّا بعدَهُ ، ",["وإنَّهُم ليلقونَ من هولِ ذلك اليومِ شدَّةً حتى يُلجِمَ الكافرَ العرقُ",2]," ، قيلَ له : فأينَ المؤمنونَ ؟ قال : على كراسيٍّ من ذهبٍ ويظللُ عليْهِم الغمامُ ، وما طولُ ذلك اليومِ عليْهِم إلا كساعةٍ من نهارٍ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده جيد","takhrij":"أخرجه أحمد (12566) مختصراً، والطبراني في ((المعجم الأوسط)) (1976)، وابن عدي في ((الكامل في الضعفاء)) (3/463) باختلاف يسير","bab":"إيمان › فضل الإيمان","dorar":"3RoIPsMu","merged":2,"otherRefs":["عمدة القاري 23/171 (حسن)"]},{"id":"س-00545","fp":"8e73049b7c15","stateId":585,"easy":"إذا مت كافراً ← يغشاك الموت (لا تحيا ولا تموت)","cause":"وأما الكافِرُ","result":"فيغشاهُ الموتُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-07893","ref":"تخريج العواصم والقواصم 8/ 424","text":["عن النَّبيِّ صلَّى اللهُ عليه وسلَّمَ في ذِكرِ الشَّفاعَةِ: أنَّ الخلْقَ يُلجَمون بالعَرَقِ في يومِ القيامَةِ، فأما المُؤمِنُ، فهو عليه كالزُّكْمةِ، ",["وأما الكافِرُ",1],"، ",["فيغشاهُ الموتُ",2],"."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حديث حسن","takhrij":"أخرجه أحمد (12824)، وابن خزيمة في ((التوحيد)) (2/616)، والضياء في ((الأحاديث المختارة)) (2695) مطولاً","bab":"آداب عامة › ضرب الأمثال","dorar":"iUwAGHPX"},{"id":"س-03931","fp":"e09403d813f7","stateId":585,"easy":"إذا كنت كافراً ← تُجمع لك سيئاتك حتى تُجزى بها يوم القيامة","cause":"وأمَّا الآخرونَ","result":"فيؤخَّرُ فيُجمَعُ ذلِكَ لَهُم حتَّى يُجزَوا بِهِ يومَ القيامةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الأمالي المطلقة 76","srcLabel":"الترمذي","text":["عن أبي بَكْرٍ الصِّدِّيقِ رضيَ اللَّهُ عنهُ قالَ كنتُ عندَ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فنزلت عليهِ هذِهِ الآيةُ مَنْ يَعْمَلْ سُوءًا يُجْزَ بِهِ فقالَ يا أبا بَكْرٍ ألا أقرئُكَ آيةً أُنْزِلَت عليَّ قلتُ بلى يا رسولَ اللَّهِ فأقرأَنيها فَما أعلمُ إلَّا أنِّي وجدتُ انقِصافًا في ظَهْري حتَّى تمطَّأتُ لَها فقُلتُ يا رسولَ اللَّهِ وأيُّنا لم يعمَل سوءً وإنَّا لَمُجزَونَ بما عمِلنا فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ أمَّا أنتَ يا أبا بَكْرٍ وأصحابُكَ المؤمِنونَ فتُجزَونَ بِهِ فيِ الدُّنيا حتَّى تَلقَوا اللَّهَ عزَّ وجلَّ وليسَت لَكُم ذنوبٌ ",["وأمَّا الآخرونَ",1]," ",["فيؤخَّرُ فيُجمَعُ ذلِكَ لَهُم حتَّى يُجزَوا بِهِ يومَ القيامةِ",2]],"grade":"حسن","narrator":"أبو بكر الصديق","muhaddith":"حسن غريب","takhrij":"أخرجه الترمذي (3039)، وعبد بن حميد (7)، والبزار (20) باختلاف يسير","bab":"تفسير آيات › سورة النساء","dorar":"xlo7f4uu"},{"id":"س-08033","fp":"44ac5cdf7cc6","stateId":586,"easy":"إذا أخذت شبراً من الأرض ظلماً ← تُطوّقه إلى سبع أرضين","cause":"مَن أخَذَ شِبرًا مِنَ الأرضِ ظُلمًا","result":"طُوِّقَه إلى سَبعِ أرَضينَ","explicit":true,"star":true,"similar":["س-08000","س-08034","س-08039","س-05132","س-08050"],"otherNeedIds":[45],"ref":"صحيح مسلم 1610","srcLabel":"البخاري","text":["أنَّ أروى بنتَ أويسٍ ادَّعَت على سَعيدِ بنِ زَيدٍ أنَّه أخَذَ شيئًا مِن أرضِها، فخاصَمَتْه إلى مَروانَ بنِ الحَكَمِ، فقال سَعيدٌ: أنا كُنتُ آخُذُ مِن أرضِها شيئًا بَعدَ الذي سَمِعتُ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم! قال: وما سَمِعتَ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم؟ قال: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["مَن أخَذَ شِبرًا مِنَ الأرضِ ظُلمًا ",1],["طُوِّقَه إلى سَبعِ أرَضينَ",2],"، فقال له مَروانُ: لا أسألُكَ بَيِّنةً بَعدَ هذا. فقال: اللَّهُمَّ إن كانَت كاذِبةً فعَمِّ بَصَرَها، واقتُلْها في أرضِها. قال: فما ماتَت حتَّى ذَهَبَ بَصَرُها، ثُمَّ بينا هي تَمشي في أرضِها إذ وقَعَت في حُفرةٍ فماتَت."],"grade":"صحيح","narrator":"عروة بن الزبير","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3198) وأحمد (1640) بنحوه والدارمي (2648) مختصرا.","bab":"مظالم › تحريم الظلم","dorar":"71gAeqmi","merged":16,"otherRefs":["تخريج المسند لشعيب 9582 (صحيح)","صحيح البخاري 3195 (صحيح)","الترغيب والترهيب 3/72 (صحيح)","تخريج المسند لشعيب 1639 (صحيح)","تخريج مشكل الآثار 6146 (صحيح)","تخريج المسند لشاكر 3/117 (صحيح)","المصابيح في الأحاديث المتواترة 618 (صحيح)","المصابيح في الأحاديث المتواترة 615 (صحيح)","تخريج صحيح ابن حبان 3195 (صحيح)","تخريج مشكل الآثار 6145 (صحيح)","المستدرك على الصحيحين 8017 (صحيح)","صحيح مسلم 1612 (صحيح)","تخريج المسند لشعيب 26224 (صحيح)","تخريج شرح السنة 2564 (صحيح)","المصابيح في الأحاديث المتواترة 624 (صحيح)"]},{"id":"س-07863","fp":"09b905ef6cad","stateId":586,"easy":"إذا كان لأحد عندك مظلمة ← لا تدخل الجنة حتى يُقتص منك","cause":"لا يَنْبغي لِأحدٍ مِن أهلِ الجنَّةِ أنْ يَدخُلَ الجنَّةَ، ولأحدٍ مِن أهلِ النَّارِ عليه مَظْلَمةٌ","result":"حتَّى أقُصَّه منه، ولا يَنْبغي لأحدٍ مِن أهلِ النَّارِ أنْ يَدخُلَ النَّارَ، ولأحدٍ مِن أهلِ الجنَّةِ مَظْلَمةٌ حتَّى أقْضِهِ منه حتَّى اللَّطمةِ","explicit":true,"star":true,"otherNeedIds":[45,12,58],"ref":"المستدرك على الصحيحين 8941","srcLabel":"البخاري","text":["عن جابرِ بنِ عبدِ اللهِ رَضيَ اللهُ عنهُما، قال: بَلَغني عن رجُلٍ مِن أصحابِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ حَديثٌ سَمِعه مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في القِصاصِ لم أسْمَعْه منه، فابتَعْتُ بَعيرًا، فشَدَدتُ رَحْلي، ثمَّ سِرتُ إليه شَهرًا حتَّى قَدِمتُ مِصرَ -أو قال: الشَّامَ- فأتَيتُ عبدَ اللهِ بنَ أُنَيسٍ، فقُلتُ: حَديثٌ بَلَغَني عنكَ تُحدِّثُ به سَمِعتَه مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ ولم أسْمَعْه في القِصاصِ، خَشِيتُ أنْ أموتُ قبْلَ أنْ أسْمَعَه، فقال عبدُ اللهِ: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: يوْمَ يُحشَرُ العِبادُ -أو قال: النَّاسُ- عُراةً غُرْلًا بُهْمًا، ليْس معهم شَيءٌ، ثمَّ يُنادِيهم بصَوتٍ يَسمَعُه مَن بعُدَ كما يَسمَعُه مَن قرُبَ: أنا الملِكُ، أنا الدَّيَّانُ، ",["لا يَنْبغي لِأحدٍ مِن أهلِ الجنَّةِ أنْ يَدخُلَ الجنَّةَ، ولأحدٍ مِن أهلِ النَّارِ عليه مَظْلَمةٌ",1]," ",["حتَّى أقُصَّه منه، ولا يَنْبغي لأحدٍ مِن أهلِ النَّارِ أنْ يَدخُلَ النَّارَ، ولأحدٍ مِن أهلِ الجنَّةِ مَظْلَمةٌ حتَّى أقْضِهِ منه حتَّى اللَّطمةِ",2],"، قال: قُلنا: كيْف وإنَّما نَأتي اللهَ عزَّ وجلَّ عُراةً حُفاةً غُرْلًا بُهْمًا؟ قال: الحسناتُ والسَّيِّئاتُ."],"grade":"صحيح","narrator":"عبدالله بن أنيس","muhaddith":"صحيح الإسناد ولم يخرجاه","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (970) باختلاف يسير، وابن أبي شيبة في ((مسنده)) (851)، وابن أبي عاصم  ((السنة)) (514) مختصرا","bab":"قيامة › الحساب والقصاص","dorar":"bA2b6ggn","merged":5,"otherRefs":["الزواجر عن اقتراف الكبائر 2/243 (صحيح)","تخريج كتاب السنة 514 (صحيح)","حديث جابر لابن ناصر الدين 34 (حسن)","تخريج العواصم والقواصم 3/ 222 (حسن)"]},{"id":"س-07452","fp":"a395f7e2d8b5","stateId":586,"easy":"إذا غدرت ← يكون لك لواء يوم القيامة","cause":"لِكُلِّ غادرٍ","result":"لواءٌ يومَ القيامةِ","explicit":true,"star":true,"otherNeedIds":[39],"ref":"سنن الترمذي 2191","srcLabel":"مسلم","text":["صلَّى بنا رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يومًا صلاةَ العصرِ بنَهارٍ ثمَّ قامَ خَطيبًا فلَم يدَع شيئًا يَكونُ إلى قيامِ السَّاعةِ إلَّا أَخبرَنا بِهِ ، حفِظَهُ من حفظَهُ ، ونَسيَهُ من نسيَهُ ، وَكانَ فيما قالَ : إنَّ الدُّنيا خضرةٌ حُلوةٌ ، وإنَّ اللَّهَ مُستَخلفُكُم فيها فَناظرٌ كيفَ تعمَلونَ ، ألا فاتَّقوا الدُّنيا واتَّقوا النِّساء وَكانَ فيما قالَ : ألا لا تَمنعنَّ رجلًا هيبةُ النَّاسِ أن يقولَ بحقٍّ إذا علمَهُ قالَ : فبَكَى أبو سعيدٍ فقالَ : قد واللَّهِ رأينا أشياءَ فَهِبنا ، كانَ فيما قالَ : ألا إنَّهُ يُنصَبُ ",["لِكُلِّ غادرٍ",1]," ",["لواءٌ يومَ القيامةِ",2]," بقدرِ غدرتِهِ ، ولا غَدرةَ أعظمُ من غدرةِ إمامِ عامَّةٍ يركزُ لواؤُهُ عندَ استِهِ وكانَ فيما حفِظنا يومئذٍ : ألا إنَّ بَني آدمَ خُلِقوا على طَبقاتٍ شتَّى ، فَمِنْهُم مَن يولَدُ مُؤمنًا ويَحيا مؤمنًا ويموتُ مؤمنًا ، وَمِنْهُم من يولَدُ كافرًا ويَحيا كافرًا ويموتُ كافرًا ، وَمِنْهُم من يولَدُ مؤمنًا ويحيا مؤمنًا ويموتُ كافرًا ، وَمِنْهُم من يولَدُ كافرًا ويَحيا كافرًا ويموتُ مؤمنًا ، ألا وإنَّ منهمُ البطيءَ الغضبِ سريعَ الفَيءِ ، وَمِنْهُم سريعُ الغَضَبِ سريعُ الفيءِ ، فتِلكَ بتلكَ ، ألا وإنَّ منهُم سريعَ الغَضَبِ بطيءَ الفيءِ ، ألا وخيرُهُم بطيءُ الغضَبِ سريعُ الفيءِ ، وشرُّهم سريعُ الغضَبِ بطيءُ الفيءِ ، ألا وإنَّ منهُم حَسنَ القضاءِ حَسنَ الطَّلبِ ، وَمِنْهُم سيِّئُ القضاءِ حسنُ الطَّلبِ ، وَمِنْهُم حسنُ القضاءِ سيِّئُ الطَّلبِ ، فتلكَ بتِلكَ ، ألا وإنَّ منهمُ السَّيِّئَ القَضاءِ السَّيِّئَ الطَّلبِ ، ألا وخيرُهُمُ الحسَنُ القضاءِ الحسَنُ الطَّلبِ ، ألا وشرُّهم سيِّئُ القضاءِ سيِّئُ الطَّلبِ ، ألا وإنَّ الغضبَ جمرةٌ في قلبِ ابنِ آدمَ ، أما رأيتُمْ إلى حُمرةِ عَينيهِ وانتِفاخِ أوداجِهِ ، فمَن أحسَّ بشَيءٍ من ذلِكَ فليُلصِق بالأرضِ قالَ : وجعَلنا نَلتَفتُ إلى الشَّمسِ هل بقيَ منها شيءٌ ؟ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : ألا إنَّهُ لم يبقَ منَ الدُّنيا فيما مضى منها إلَّا كما بقيَ من يومِكُم هذا فيما مضى منهُ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"حسن صحيح","takhrij":"أخرجه مسلم (2252)، وأبو داود (4344) بنحوه مختصرا.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"zoHZhCNo","merged":18,"otherRefs":["صحيح البخاري 3186 (صحيح)","صحيح الجامع 3435 (صحيح)","صحيح البخاري 3188 (صحيح)","صحيح مسلم 1736 (صحيح)","صحيح مسلم 1738 (صحيح)","تخريج المسند لشاكر 8/66 (صحيح)","تخريج المسند لشعيب 6093 (صحيح)","تخريج المسند لشعيب 11351 (صحيح)","تخريج المسند لشعيب 11038 (صحيح)","تخريج المسند لشعيب 5804 (صحيح)","تخريج المسند لشعيب 12518 (صحيح)","تخريج المسند لشعيب 3959 (صحيح)","تخريج المسند لشعيب 4839 (صحيح)","صحيح البخاري 7111 (صحيح)","الأمالي المطلقة 194 (صحيح)","تخريج المسند لشعيب 11796 (صحيح)"]},{"id":"س-08441","fp":"8d8cca536d80","stateId":586,"easy":"إذا أردت أهل المدينة بسوء ← يذيبك الله كما يذوب الملح في الماء","cause":"مَن أراد أهْلَها بسُوءٍ","result":"أذابَه اللهُ كما يَذوبُ المِلحُ في الماءِ","explicit":true,"star":true,"similar":["س-07876"],"otherNeedIds":[49],"ref":"المستدرك على الصحيحين 8853","srcLabel":"مسلم","text":["اللَّهمَّ بارِكْ لأهلِ المدينةِ في مُدِّهم وفي صاعِهم، وبارِكْ لهم في مَدينتِهم، اللَّهمَّ إنَّ إبراهيمَ عليه السَّلامُ عبْدُك وخَليلُك، وأنا عبْدُك ورَسولُك، وإنَّ إبراهيمَ سَألَك لِمكَّةَ وإنِّي أسْألُكَ للمدينةِ مِثلَ ما سَألَك إبراهيمُ لمكَّةَ ومِثلَه معه، ألَا إنَّ المدينةَ مُشْتبِكةٌ بالملائكةِ، على كلِّ نَقْبٍ منها مَلَكانِ يَحرُسانِها، لا يَدخُلُها الطَّاعونُ والدَّجَّالُ، ",["مَن أراد أهْلَها بسُوءٍ",1]," ",["أذابَه اللهُ كما يَذوبُ المِلحُ في الماءِ",2],"."],"grade":"صحيح","narrator":"سعد بن مالك، وأبو هُرَيرةَ","muhaddith":"صحيح على شرط مسلم، ولم يخرجاه","bab":"مناقب وفضائل › مكة شرفها الله تعالى","dorar":"TS965jeB","merged":6,"otherRefs":["سير أعلام النبلاء 9/105 (صحيح)","الترغيب والترهيب 2/219 (حسن)","صحيح مسلم 1386 (صحيح)","صحيح مسلم 1387 (صحيح)","تخريج المسند لشعيب 8373 (صحيح)"]},{"id":"س-06897","fp":"4ca8c215b95d","stateId":586,"easy":"إذا فارقت الجماعة وعصيت إمامك فمت عاصياً ← فلا يُسأل عنك (من الهالكين)","cause":"رجلٌ فارَقَ الجماعةَ و عصَى إمامَه فماتَ عاصيًا ؛ فلا يُسأَلُ عنهُ ، و أَمَةٌ أو عبدٌ أَبَقَ مِن سيدِه ، و امرأةٌ غاب عنها زوجُها و كَفاها مَؤونةَ الدُّنيا فتبرَّجَت و تمرَّجت بعدَه","result":"ثلاثةٌ لا يُسْأَلُ عنهُم","explicit":true,"star":true,"ref":"صحيح الأدب المفرد 458","srcLabel":"البخاري","text":["ثلاثةٌ لا يُسأَلُ عنهم : ",["رجلٌ فارَقَ الجماعةَ و عصَى إمامَه فماتَ عاصيًا ؛ فلا يُسأَلُ عنهُ ، و أَمَةٌ أو عبدٌ أَبَقَ مِن سيدِه ، و امرأةٌ غاب عنها زوجُها و كَفاها مَؤونةَ الدُّنيا فتبرَّجَت و تمرَّجت بعدَه",1]," و ",["ثلاثةٌ لا يُسْأَلُ عنهُم",2]," : رجلٌ نازعَ اللهَ رِداءَه ؛ فإنَّ رداءَه الكِبرياءُ و إزارَه عِزُّهُ ، و رجلٌ شكَّ في أمرِ اللهِ ، و القَنُوطُ مِن رحمةِ اللهِ"],"grade":"صحيح","narrator":"فضالة بن عبيد","muhaddith":"صحيح","takhrij":"أخرجه أحمد (23988)، والبخاري في ((الأدب المفرد)) (590)، والبزار (3749) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"G0aZMJSZ","merged":3,"otherRefs":["صحيح الجامع 3058 (صحيح)","تخريج المسند لشعيب 23943 (صحيح)"]},{"id":"س-07978","fp":"073bfc95ffdd","stateId":586,"easy":"إذا كانت عندك مظلمة لأخيك ← تحلّلها اليوم وإلا أُخذ من حسناتك","cause":"مَن كانَتْ عِندَه مَظلَمةٌ مِن أخيهِ، مِن عِرضِهِ أو مالِهِ، فليتحَلَّلْهُ اليَومَ قَبلَ أنْ يُؤخَذَ حينَ لا يَكونُ دينارٌ ولا دِرهمٌ","result":"كان له عَمَلٌ صالِحٌ؛ أُخِذَ منه بقَدْرِ مَظلَمَتِهِ، وإنْ لم يَكُنْ له؛ أُخِذَ مِن سَيِّئاتِ صاحِبِهِ فجُعِلتْ عليه","explicit":true,"similar":["س-07977","س-07979","س-07983"],"ref":"تخريج المسند لشعيب 10573","srcLabel":"البخاري","text":[["مَن كانَتْ عِندَه مَظلَمةٌ مِن أخيهِ، مِن عِرضِهِ أو مالِهِ، فليتحَلَّلْهُ اليَومَ قَبلَ أنْ يُؤخَذَ حينَ لا يَكونُ دينارٌ ولا دِرهمٌ",1],"، وإنْ ",["كان له عَمَلٌ صالِحٌ؛ أُخِذَ منه بقَدْرِ مَظلَمَتِهِ، وإنْ لم يَكُنْ له؛ أُخِذَ مِن سَيِّئاتِ صاحِبِهِ فجُعِلتْ عليه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6534)، وأحمد (10573) واللفظ له","bab":"مظالم › التخلص من الظلم","dorar":"Lp0CJmgh","merged":2,"otherRefs":["صحيح الجامع 6511 (صحيح)"]},{"id":"س-02976","fp":"fbf00bc9e52b","stateId":586,"easy":"إذا هممت بالإلحاد في الحرم ← يذيقك الله عذاباً أليماً","cause":"هَمَّ فيه بإلحادٍ","result":"لأذاقهُ اللهُ عذابًا أليمًا","explicit":true,"otherNeedIds":[49],"ref":"المستدرك على الصحيحين 3506","srcLabel":"مسلم","text":["عنْ عبدِ اللهِ رَضيَ اللهُ عنه، رَفَعَهُ في قولِ اللهِ عزَّ وجلَّ: {وَمَنْ يُرِدْ فِيهِ بِإِلْحَادٍ بِظُلْمٍ نُذِقْهُ مِن عَذَابٍ أَلِيمٍ} [الحج: 25] قالَ: «لوْ أنَّ رَجلًا ",["هَمَّ فيه بإلحادٍ",1]," وهو بعَدَنِ أبْيَنَ ",["لأذاقهُ اللهُ عذابًا أليمًا",2],"»."],"grade":"صحيح","narrator":"مرة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أحمد (4316)، والطبري في ((تاريخه)) (16/ 508)، والدارقطني في ((علله)) (781) جميعهم بلفظ قريب.","bab":"إيمان › الوعيد","dorar":"ugYr7wrS","merged":3,"otherRefs":["الزواجر عن اقتراف الكبائر 1/201 (صحيح)","أضواء البيان 5/62 (صحيح)"]},{"id":"س-08040","fp":"0ebb7d487186","stateId":586,"easy":"إذا ظلمت ← يكون ظلمك ظلمات عليك يوم القيامة","cause":"اتَّقُوا الظُّلمَ","result":"فإنَّ الظُّلمَ ظُلُماتٌ يومَ القيامةِ","explicit":true,"similar":["س-08008"],"otherNeedIds":[12],"ref":"صحيح الأدب المفرد 373","srcLabel":"مسلم","text":[["اتَّقُوا الظُّلمَ ؛ ",1],["فإنَّ الظُّلمَ ظُلُماتٌ يومَ القيامةِ",2]," ، واتَّقُوا الشُّحَّ ؛ فإنَّ الشُّحَّ أهلكَ مَن كانَ قبلَكُم ، حملَهُم على أنْ سَفكُوا دِمائَهم ، واستَحَلُّوا مَحارِمَهم"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2578)","bab":"مظالم › تحريم الظلم","dorar":"OUCammRa","merged":3,"otherRefs":["تخريج المسند لشعيب 5662 (صحيح)","تخريج المسند لشعيب 6206 (صحيح)"]},{"id":"س-00468","fp":"a69bf4b65778","stateId":586,"easy":"إذا حبست هرة فلم تطعمها ولم تتركها ← تُعذّب بسببها","cause":"في هِرَّةٍ لَم تُطعِمْها ولَم تَسقِها، ولَم تَترُكْها تَأكُلُ مِن خَشاشِ الأرضِ","result":"عُذِّبَتِ امرَأةٌ","explicit":true,"similar":["س-01790"],"ref":"صحيح مسلم 2243","srcLabel":"متفق عليه","text":[["عُذِّبَتِ امرَأةٌ",2]," ",["في هِرَّةٍ لَم تُطعِمْها ولَم تَسقِها، ولَم تَترُكْها تَأكُلُ مِن خَشاشِ الأرضِ",1],". وفي روايةٍ: رَبَطَتها. وفي حَديثِ أبي مُعاويةَ: حَشَراتِ الأرضِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3318)، ومسلم (2243) واللفظ له","bab":"آداب عامة › الرفق بالحيوان والطير ونحوهما","dorar":"zDWDaP1V"},{"id":"س-03607","fp":"c1e8aecb8f00","stateId":586,"easy":"إذا أطعت أميرك في معصية ← ما خرجت منها أبداً","cause":"لَو دخلتُموها","result":"ما خرجتُمْ منها أبدًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشاكر 2/47","srcLabel":"متفق عليه","text":["بعثَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ سريَّةً ، واستعملَ عليهِم رجلًا منَ الأنصارِ قالَ : فلمَّا خرجوا قالَ : وجدَ عليهِم في شيءٍ فقالَ : قالَ لَهُم : أليسَ قد أمرَكُم رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ أن تُطيعوني قالَ : قالوا : بلَى . قالَ : فقالَ : اجمَعوا حطبًا ، ثمَّ دعا بنارٍ فأضرمَها فيهِ ، ثمَّ قالَ : عزمتُ عليكُم : لتدخلنَّها . قالَ : فَهَمَّ القَومُ أن يدخُلوها ، قالَ : فقالَ لَهُم شابٌّ منهُم : إنَّما فرَرتُمْ إلى رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ منَ النَّارِ ، فلا تعجَلوا حتَّى تلْقوا النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ ، فإن أمرَكُم أن تدخُلوها فادخُلوا ، قالَ : فرجَعوا إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ فأخبروهُ ، فقالَ لَهُم : ",["لَو دخلتُموها",1]," ",["ما خرجتُمْ منها أبدًا",2]," ، إنَّما الطَّاعةُ في المعروفِ"],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (7257)، ومسلم (1840)، وأبو داود (2625) بنحوه.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"9l45XLe9","merged":6,"otherRefs":["المحلى 10/340 (صحيح)","البحر الزخار 2/203 (صحيح)","حلية الأولياء 5/44 (صحيح)","صحيح مسلم 1840 (صحيح)","صحيح أبي داود 2625 (صحيح)"]},{"id":"س-04560","fp":"7dd60091bf1c","stateId":586,"easy":"إذا حبست هرة حتى ماتت جوعاً ← تُعذّب بها في النار","cause":"حَبَسَتها حتَّى ماتَت جوعًا، لا أطعَمَتها، ولا أرسَلَتها تَأكُلُ","result":"فإذا امرَأةٌ -حَسِبتُ أنَّه قال- تَخدِشُها هِرَّةٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح البخاري 745","srcLabel":"متفق عليه","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم صَلَّى صَلاةَ الكُسوفِ، فقامَ فأطالَ القيامَ، ثُمَّ رَكَعَ فأطالَ الرُّكوعَ، ثُمَّ قامَ فأطالَ القيامَ، ثُمَّ رَكَعَ فأطالَ الرُّكوعَ، ثُمَّ رَفَعَ، ثُمَّ سَجَدَ فأطالَ السُّجودَ، ثُمَّ رَفَعَ، ثُمَّ سَجَدَ فأطالَ السُّجودَ، ثُمَّ قامَ فأطالَ القيامَ، ثُمَّ رَكَعَ فأطالَ الرُّكوعَ، ثُمَّ رَفَعَ فأطالَ القيامَ، ثُمَّ رَكَعَ فأطالَ الرُّكوعَ، ثُمَّ رَفَعَ، فسَجَدَ فأطالَ السُّجودَ، ثُمَّ رَفَعَ، ثُمَّ سَجَدَ فأطالَ السُّجودَ، ثُمَّ انصَرَفَ، فقال: قد دَنَت مِنِّي الجَنَّةُ حتَّى لَوِ اجتَرَأتُ عليها لَجِئتُكُم بقِطافٍ مِن قِطافِها، ودَنَت مِنِّي النَّارُ حتَّى قُلتُ: أي رَبِّ، وأنا معهُم! ",["فإذا امرَأةٌ -حَسِبتُ أنَّه قال- تَخدِشُها هِرَّةٌ",2],"، قُلتُ: ما شَأنُ هذه؟ قالوا: ",["حَبَسَتها حتَّى ماتَت جوعًا، لا أطعَمَتها، ولا أرسَلَتها تَأكُلُ",1]," -قال نافِعٌ: حَسِبتُ أنَّه قال: مِن خَشيشِ- أو خَشاشِ الأرضِ."],"grade":"صحيح","narrator":"أسماء بنت أبي بكر","muhaddith":"[صحيح]","takhrij":"من أفراد البخاري على مسلم","bab":"جهنم › صفة عذاب أهل النار","dorar":"ZU7NYi2p","merged":10,"otherRefs":["تخريج المسند لشعيب 10501 (صحيح)","تخريج المسند لشعيب 7847 (صحيح)","صحيح البخاري 2365 (صحيح)","تخريج صحيح ابن حبان 7489 (صحيح)","صحيح البخاري 3482 (صحيح)","تخريج المسند لشعيب 10584 (صحيح)","مجمع الزوائد 1/121 (صحيح)","تخريج المسند لشعيب 14602 (صحيح)","صحيح مسلم 2619 (صحيح)"]},{"id":"س-04787","fp":"16026a926ec8","stateId":586,"easy":"إذا أعطيت بالله ثم غدرت أو بعت حراً أو استأجرت أجيراً فلم تعطه ← فالله خصمك يوم القيامة","cause":"رَجُلٌ أعطى بي ثُمَّ غَدَرَ، ورَجُلٌ باعَ حُرًّا وأكَلَ ثَمَنَه، ورَجُلٌ استَأجَرَ أجيرًا فاستَوفى مِنه ولَم يوفِّه أجرَه","result":"ثَلاثةٌ أنا خَصمُهم يَومَ القيامةِ","explicit":true,"otherNeedIds":[27],"ref":"مجموع الشروح الفقهية. 255/10","srcLabel":"البخاري","text":["يَقولُ اللهُ عَزَّ وجلَّ: ",["ثَلاثةٌ أنا خَصمُهم يَومَ القيامةِ",2],"، ومَن كُنتُ خَصمَه خَصَمتُه: ",["رَجُلٌ أعطى بي ثُمَّ غَدَرَ، ورَجُلٌ باعَ حُرًّا وأكَلَ ثَمَنَه، ورَجُلٌ استَأجَرَ أجيرًا فاستَوفى مِنه ولَم يوفِّه أجرَه",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (2270)، وأحمد (8692)، وابن الجارود (630)، والطحاوي في ((شرح مشكل الآثار)) (1878) بلفظه.","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"uy1Jvrs8"},{"id":"س-06645","fp":"577b1f37c615","stateId":586,"easy":"إذا نكثت العهد فمت ناكثاً ← تأتي يوم القيامة لا حجة لك","cause":"ومَن نَكَثَ العَهْدَ فماتَ ناكِثًا للعَهْدِ","result":"جاءَ يَوْمَ القِيامةِ لا حُجَّةَ له","explicit":true,"ref":"الأحاديث المختارة 8 / 193","srcLabel":"متفق عليه","text":["«إنَّها ستَكونُ أُمَراءُ مِن بَعْدي يُصَلُّونَ الصَّلاةَ لوَقْتِها ويُؤَخِّرونَها عن وَقْتِها، فصَلُّوا معَهم؛ فإن صَلَّوها لوَقْتِها وصَلَّيْتُموها معَهم فلكم ولهم، وإن أخَّروها عن وَقْتِها فصَلُّوها معَهم، فلكم وعليهم، مَن فارَقَ الجَماعةَ ماتَ مِيتةً جاهِليَّةً، ",["ومَن نَكَثَ العَهْدَ فماتَ ناكِثًا للعَهْدِ ",1],["جاءَ يَوْمَ القِيامةِ لا حُجَّةَ له)",2],".\nلَفْظُ عَبْدِ الرَّزَّاقِ.\nولَفْظُ حَديثِ حَجَّاجٍ: أخْبَرَني عاصِمُ بنُ عُبَيْدِ اللهِ: أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قالَ: إنَّها ستَكونُ أُمَراءُ مِن بَعْدي يُصَلُّونَ الصَّلاةَ لغَيْرِ وَقْتِها، ويُؤَخِّرونَها عن وَقْتِها، فصَلُّوها معَهم؛ فإن صَلَّوْها لوَقْتِها وصَلَّيْتُموها معَهم فلكم ولهم، وإن صَلَّوها لغَيْرِ وَقْتِها وصَلَّيْتُموها معَهم فلكم وعليهم، مَن فارَقَ الجَماعةَ ماتَ مِيتةً جاهِليَّةً، ومَن نَكَثَ العَهْدَ فماتَ ناكِثًا للعَهْدِ جاءَ يَوْمَ القِيامةِ لا حُجَّةَ له»."],"grade":"صحيح","narrator":"عامر بن ربيعة","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"H5hyB60Z"},{"id":"س-07465","fp":"84b888f1a85c","stateId":586,"easy":"إذا سعيت في الفتنة ← فويل لك من الله يوم القيامة","cause":"للسَّاعي فيها","result":"ويلٌ للسَّاعي فيها مِن اللهِ يومَ القيامةِ","explicit":true,"ref":"تخريج صحيح ابن حبان 6705","srcLabel":"متفق عليه","text":["ويلٌ للعرَبِ مِن شرٍّ قد اقتَرَب مِن فتنةٍ عَمياءَ صمَّاءَ بَكماءَ القاعدُ فيها خيرٌ مِن القائمِ والقائمُ فيها خيرٌ مِن الماشي والماشي فيها خيرٌ مِن السَّاعي ",["ويلٌ للسَّاعي فيها مِن اللهِ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (3601)، ومسلم (2886) مختصراً","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"OEOCu03P"},{"id":"س-07509","fp":"96a2b60e45e7","stateId":586,"easy":"إذا ظلمت أهل الجنة في الدنيا ← تُحبس عن الجنة حتى يُقتص منك","cause":"مَظالِمُهم الَّتي تَظالَموها في الدُّنيا","result":"لَيُحبَسُ أهلُ الجنَّةِ بعْدما يُجاوِزون الصِّراطَ على قَنطرةٍ","explicit":true,"ref":"المستدرك على الصحيحين 8932","srcLabel":"البخاري","text":[["لَيُحبَسُ أهلُ الجنَّةِ بعْدما يُجاوِزون الصِّراطَ على قَنطرةٍ",2],"، فيُؤخَذُ لبَعضِهم مِن بَعضٍ ",["مَظالِمُهم الَّتي تَظالَموها في الدُّنيا",1],"، حتَّى إذا هُذِّبوا ونُقِّوا أُذِن في دُخولِ الجنَّةِ، فلَأحَدُهم أعرَفُ بمَنزلتِهم في الآخرةِ منه بمَنزلِه كان في الدُّنيا. قال قَتادةُ: قال أبو عُبَيدةَ بنُ عبدِ اللهِ بنِ مَسعودٍ: ما يُشبِهُ إلَّا أهلَ جُمْعةٍ انْصَرَفوا مِن جُمعتِهم."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح الإسناد ولم يخرجاه","takhrij":"أخرجه البخاري (2440)، وأحمد (11095)، والطبراني في ((المعجم الأوسط)) (2749) مطولا، وجميعا بنحوه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"8YHPrnJO"},{"id":"س-07977","fp":"bae6721127f5","stateId":586,"easy":"إذا كانت لأخيك عندك مظلمة في عرض أو مال ← فاستحلّه اليوم قبل يوم لا دينار فيه ولا درهم","cause":"مَن كانت عندَه مَظلَمةٌ لأخيه مِن عِرضِه ومالِه","result":"فلْيستحِلَّه اليومَ قبْلَ أنْ يأخُذَه به حينَ لا دينارَ ولا درهمَ فإنْ كان له عمَلٌ صالحٌ أُخِذ منه بقدرِ مَظلَمتِه فإنْ لَمْ يكُنْ أُخِذ مِن سيِّئاتِ صاحبِه فجُعِلَتْ عليه","explicit":true,"repOf":"س-07978","ref":"تخريج صحيح ابن حبان 7361","text":[["مَن كانت عندَه مَظلَمةٌ لأخيه مِن عِرضِه ومالِه ",1],["فلْيستحِلَّه اليومَ قبْلَ أنْ يأخُذَه به حينَ لا دينارَ ولا درهمَ فإنْ كان له عمَلٌ صالحٌ أُخِذ منه بقدرِ مَظلَمتِه فإنْ لَمْ يكُنْ أُخِذ مِن سيِّئاتِ صاحبِه فجُعِلَتْ عليه",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الترمذي (2419)، وأحمد (9615) باختلاف يسير، وأخرجه البخاري (6534) بلفظ مقارب","bab":"مظالم › التخلص من الظلم","dorar":"aqJNxCOB"},{"id":"س-07979","fp":"fb3a073bc24d","stateId":586,"easy":"إذا كانت عندك مظلمة لأخيك ← فاستحلّه منها قبل أن يُؤخذ من حسناتك","cause":"مَن كانت عندَهُ مَظلِمَةٌ لأخيهِ في عِرضٍ، أو في مالٍ، فلْيأتِهِ فلْيُحَلِّلْهُ منها","result":"فإنَّه ليْسَ ثَمَّ دِينارٌ ولا دِرهمٌ، مِن قَبلِ أنْ يُؤخَذَ لأخيهِ من حسناتِهِ، فإنْ لمْ يكُنْ له حسناتٌ أُخِذَ من سيِّئاتِ أخيهِ فطُرِحَتْ عليه","explicit":true,"repOf":"س-07978","ref":"تخريج مشكل الآثار 189","text":[["مَن كانت عندَهُ مَظلِمَةٌ لأخيهِ في عِرضٍ، أو في مالٍ، فلْيأتِهِ فلْيُحَلِّلْهُ منها، ",1],["فإنَّه ليْسَ ثَمَّ دِينارٌ ولا دِرهمٌ، مِن قَبلِ أنْ يُؤخَذَ لأخيهِ من حسناتِهِ، فإنْ لمْ يكُنْ له حسناتٌ أُخِذَ من سيِّئاتِ أخيهِ فطُرِحَتْ عليه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الترمذي (2419)، وأحمد (9615) باختلاف يسير، وأخرجه البخاري (6534) بلفظ مقارب","bab":"مظالم › التخلص من الظلم","dorar":"KMNgu1wW"},{"id":"س-07982","fp":"3945638e1b7c","stateId":586,"easy":"إذا كانت عندك مظلمة لأخيك في عرض أو مال ← يُؤخذ من عملك الصالح بقدرها، فإن لم يكن حُمل عليك من سيئاته","cause":"كانتْ لهُ عندَ أخيه مظلمةٌ في عرضٍ أو مالٍ","result":"كان لهُ عملٌ صالحٌ ؛ أُخذَ منه بقدرِ مَظلمتِه ، وإن لَم تكن لهُ حسَناتٌ ؛ أُخذِ من سيِّئاتِ صاحِبِه فحُملَ علَيهِ","explicit":true,"ref":"صحيح الترغيب 2222","srcLabel":"البخاري","text":["رحَمَ اللهُ عبدًا ",["كانتْ لهُ عندَ أخيه مظلمةٌ في عرضٍ أو مالٍ",1]," فلْيتحلَّلْه منه اليومَ ، من قبلِ أن لا يكونَ دينارٌ ولا درهمٌ ، إن ",["كان لهُ عملٌ صالحٌ ؛ أُخذَ منه بقدرِ مَظلمتِه ، وإن لَم تكن لهُ حسَناتٌ ؛ أُخذِ من سيِّئاتِ صاحِبِه فحُملَ علَيهِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (2419)، وأحمد (9613) باختلاف يسير، وأخرجه البخاري (2449) بنحوه","bab":"مظالم › التوبة ورد المظالم والحقوق","dorar":"BHtDLUT8"},{"id":"س-08000","fp":"10301b78b87c","stateId":586,"easy":"إذا ظلمت شبراً من الأرض ← تُطوّقه يوم القيامة","cause":"من ظلَمَ شِبرًا منَ الأرضِ","result":"خنقَ بهِ يومَ القيامَةِ","explicit":true,"repOf":"س-08033","ref":"حلية الأولياء 8/182","text":[["من ظلَمَ شِبرًا منَ الأرضِ ",1],["خنقَ بهِ يومَ القيامَةِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح من حديث موسى عن سالم تفرد به عبد الله عنه","takhrij":"أخرجه أبو عوانة في ((المستخرج)) (5966)، والخرائطي في ((مساويء الأخلاق)) (634) بنحوه، والبخاري (2454) بمعناه.","bab":"مظالم › تحريم الظلم","dorar":"mhrPBHaP"},{"id":"س-08034","fp":"bcfbf299ec41","stateId":586,"easy":"إذا أخذت شبراً من الأرض بغير حقه ← تُطوّقه في سبع أرضين يوم القيامة","cause":"مَن أخَذَ شِبرًا مِنَ الأرضِ بغيرِ حَقِّه","result":"طُوِّقَه في سَبعِ أرَضينَ يَومَ القيامةِ، اللَّهُمَّ إن كانَت كاذِبةً فأعمِ بَصَرَها، واجعَلْ قَبرَها في دارِها","explicit":true,"repOf":"س-08033","ref":"صحيح مسلم 1610","text":["أنَّ أروى خاصَمَتْه في بَعضِ دارِه، فقال: دَعوها وإيَّاها؛ فإنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["مَن أخَذَ شِبرًا مِنَ الأرضِ بغيرِ حَقِّه، ",1],["طُوِّقَه في سَبعِ أرَضينَ يَومَ القيامةِ، اللَّهُمَّ إن كانَت كاذِبةً فأعمِ بَصَرَها، واجعَلْ قَبرَها في دارِها",2],". قال: فرَأيتُها عَمياءَ تَلتَمِسُ الجُدُرَ تَقولُ: أصابَتني دَعوةُ سَعيدِ بنِ زَيدٍ، فبينَما هي تَمشي في الدَّارِ مَرَّت على بئرٍ في الدَّارِ، فوقَعَت فيها، فكانَت قَبرَها."],"grade":"صحيح","narrator":"سعيد بن زيد","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3198)","bab":"مظالم › تحريم الظلم","dorar":"XNJMNK6Y"},{"id":"س-02977","fp":"fc38e8411041","stateId":586,"easy":"إذا كذبت على النبي ﷺ ← تلج النار","cause":"مَن كَذَب عَلَيَّ","result":"يَلِجِ النَّارَ","explicit":true,"ref":"المستدرك على الصحيحين 8029","srcLabel":"مسلم","text":["لمَّا افتَتَح رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ مَكَّةَ أتاه ناسٌ مِن قُرَيشٍ، فقالوا: إنَّه قدْ لَحِقَ بكَ ناسٌ مِن مَوالينا وأرِقَّائِنا، ليْس لهم رَغبةٌ في الدِّينِ إلَّا فِرارًا مِن مَواشينا وزَرعِنا، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: واللهِ يا مَعشَرَ قُرَيشٍ، لَتُقيمُنَّ الصَّلاةَ، ولَتُؤْتُنَّ الزَّكاةَ، أو لَأَبْعَثَنَّ عليكم رَجُلًا فيَضرِبُ أعناقَكُم على الدِّينِ، ثمَّ قالَ: أنا أو خاصِفُ النَّعلِ، قال عَلِيٌّ: وأنا أخصِفُ نَعْلَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، ثمَّ قال عَلِيٌّ: سَمِعتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["مَن كَذَب عَلَيَّ",1]," ",["يَلِجِ النَّارَ",2],"."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح على شرط مسلم","bab":"إيمان › الوعيد","dorar":"ueGxtwVP"},{"id":"س-03042","fp":"1e47ccfcdfa5","stateId":586,"easy":"إذا قضيت بغير علم ← ففي النار","cause":"وقاضي قَضَى بغَيْرِ عِلْمٍ","result":"فهُو في النَّارِ","explicit":true,"similar":["س-03043","س-03044","س-02972","س-02855","س-05022","س-01698","س-02854","س-02858"],"ref":"المستدرك على الصحيحين 7207","srcLabel":"مسلم","text":["القُضاةُ ثَلاثةٌ: قاضيانِ في النَّارِ، وقاضِي في الجَنَّةِ؛ قاضِي عَرَفَ الحَقَّ فقَضَى بهِ، فهُو في الجَنَّةِ، وقاضِي عرَفَ الحَقَّ، فجارَ مُتَعَمِّدًا، فهو في النَّارِ، ",["وقاضي قَضَى بغَيْرِ عِلْمٍ",1],"، ",["فهُو في النَّارِ",2],"."],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"صحيح الإسناد ...، وله شاهد بإسناد صحيح على شرط مسلم","bab":"إيمان › الوعيد","dorar":"cziWmKOJ"},{"id":"س-03043","fp":"3e9ddfea27eb","stateId":586,"easy":"إذا قضيت بجور ← ففي النار","cause":"وقاضٍ قضَى بجَوْرٍ","result":"فهُو في النَّارِ","explicit":true,"repOf":"س-03042","ref":"المستدرك على الصحيحين 7208","text":["قاضِيانِ في النَّارِ، وقاضٍ في الجنَّةِ؛ قاضٍ قَضَى بالحَقِّ فهو في الجَنَّةِ، ",["وقاضٍ قضَى بجَوْرٍ",1]," ",["فهُو في النَّارِ",2],"، وقاضٍ قضَى بجَهْلِه فهُو في النَّارِ. قالوا: فما ذَنْبُ هذا الَّذي يَجْهَلُ؟ قالَ: ذَنْبُه ألَّا يكونَ قاضِيًا حتَّى يَعْلَمَ."],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"[إسناده صحيح على شرط مسلم]","bab":"إيمان › الوعيد","dorar":"UozvicWh"},{"id":"س-03044","fp":"a516e8ccf7b4","stateId":586,"easy":"إذا قضيت بجهلك ← ففي النار","cause":"وقاضٍ قضَى بجَهْلِه","result":"فهُو في النَّارِ","explicit":true,"repOf":"س-03042","ref":"المستدرك على الصحيحين 7208","text":["قاضِيانِ في النَّارِ، وقاضٍ في الجنَّةِ؛ قاضٍ قَضَى بالحَقِّ فهو في الجَنَّةِ، وقاضٍ قضَى بجَوْرٍ فهُو في النَّارِ، ",["وقاضٍ قضَى بجَهْلِه",1]," ",["فهُو في النَّارِ",2],". قالوا: فما ذَنْبُ هذا الَّذي يَجْهَلُ؟ قالَ: ذَنْبُه ألَّا يكونَ قاضِيًا حتَّى يَعْلَمَ."],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"[إسناده صحيح على شرط مسلم]","bab":"إيمان › الوعيد","dorar":"UozvicWh"},{"id":"س-04937","fp":"52c31dfcce13","stateId":586,"easy":"إذا خلفت مجاهداً في أهله فخنته ← توقف له يوم القيامة فيأخذ من حسناتك ما شاء","cause":"وما من قاعِدٍ يَخلُفُ مُجاهِدًا في أهْلِه، فيَخونُه في أهْلِه","result":"إلَّا وُقِّفَ له يَومَ القيامةِ، قيلَ له: إنَّ هذا خانَك في أهْلِكَ، فخُذْ مِن عَمَلِه ما شِئتَ","explicit":true,"similar":["س-07867","س-07846"],"otherNeedIds":[45],"ref":"تخريج المسند لشعيب 23004","srcLabel":"مسلم","text":["فضْلُ نِساءِ المُجاهِدينَ على القاعِدينَ في الحُرْمةِ كفَضْلِ أُمَّهاتِهم، ",["وما من قاعِدٍ يَخلُفُ مُجاهِدًا في أهْلِه، فيَخونُه في أهْلِه",1],"؛ ",["إلَّا وُقِّفَ له يَومَ القيامةِ، قيلَ له: إنَّ هذا خانَك في أهْلِكَ، فخُذْ مِن عَمَلِه ما شِئتَ",2],". قال: فما ظَنُّكم؟"],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1897)، وأبو داود (2496)، والنسائي (3190)، وأحمد (23004) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"2AXelzf6"},{"id":"س-05216","fp":"22ae428676ce","stateId":586,"easy":"إذا نكثت بيعتك ← فلا حجة لك","cause":"مَنْ نكث صفْقتَه","result":"فلا حُجَّةَ له","explicit":true,"ref":"تخريج كتاب السنة 1081","srcLabel":"مسلم","text":["لمَّا كان مِنْ أمرِ عبدِ اللهِ بنِ مُطيعٍ ما كان أتاه عبدُ اللهِ بنُ عمرَ وأنَا معه فأَلْقَى له وسادةً فقال ابنُ عمرَ : إني لم أَجِئْكَ لِأَجلسَ ولكن جِئْتُكَ لِأُحَدِّثَك حديثين سمِعتُهما مِنْ رسولِ اللهِ سمِعتُه يقولُ : ",["مَنْ نكث صفْقتَه ",1],["فلا حُجَّةَ له ",2],"ومَنْ مات وهو مُفارِقٌ للجماعةِ فَمَوْتُه مِيتةٌ جاهليةٌ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1851) بنحوه","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"GgBjQ37J"},{"id":"س-07867","fp":"fbfc5fca7a0b","stateId":586,"easy":"إذا خلفت مجاهداً في أهله بسوء ← يُنصب لك يوم القيامة فيأخذ من حسناتك","cause":"وما من رَجُلٍ مِنَ القاعدينَ يخلفُ رجلًا منَ المجاهدينَ في أهلِهِ","result":"إلَّا نصبَ لهُ يومَ القيامةِ فيقالُ يا فلانُ هذا فلانٌ فخُذْ من حسناتِهِ ما شئتَ","explicit":true,"repOf":"س-04937","otherNeedIds":[45],"ref":"صحيح النسائي 3191","text":["حُرمةُ نساءِ المجاهدينَ على القاعدينَ في الحرمةِ كأمَّهاتِهم ",["وما من رَجُلٍ مِنَ القاعدينَ يخلفُ رجلًا منَ المجاهدينَ في أهلِهِ",1]," ",["إلَّا نصبَ لهُ يومَ القيامةِ فيقالُ يا فلانُ هذا فلانٌ فخُذْ من حسناتِهِ ما شئتَ",2]," ثمَّ التفتَ النَّبيُّ إلى أصحابِهِ فقالَ ما ظنُّكم تَرونَ يدعُ لهُ مِن حسناتِهِ شيئًا"],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"صحيح","takhrij":"أخرجه النسائي (3191) واللفظ له، ومسلم (1897)، وأبو داود (2496) باختلاف يسير.","bab":"قيامة › الحساب والقصاص","dorar":"G5R6rkty"},{"id":"س-07976","fp":"3e13531d8c95","stateId":586,"easy":"إذا كان عليك حق ← لتؤدينه يوم القيامة حتى يُقاد للشاة الجلحاء من القرناء","cause":"الحُقوقَ","result":"لتؤدُّنَّ الحُقوقَ إلى أَهلِها ، حتَّى يقادَ الشَّاةُ الجلحاءُ منَ الشَّاةِ القرناءِ","explicit":true,"ref":"صحيح الترمذي 2420","srcLabel":"مسلم","text":[["لتؤدُّنَّ الحُقوقَ إلى أَهلِها ، حتَّى يقادَ الشَّاةُ الجلحاءُ منَ الشَّاةِ القرناءِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2582)","bab":"مظالم › التخلص من الظلم","dorar":"GuNDY5Vb"},{"id":"س-05379","fp":"2d5a4f2a1685","stateId":586,"easy":"إذا عذبت الناس في الدنيا (ظلماً) ← يعذبك الله","cause":"يُعَذِّبونَ النَّاسَ في الدُّنيا","result":"إنَّ اللهَ يُعَذِّبُ الذينَ","explicit":true,"ref":"صحيح مسلم 2613","srcLabel":"أبو داود","text":["مَرَّ هِشامُ بنُ حَكيمِ بنِ حِزامٍ على أُناسٍ مِنَ الأنباطِ بالشَّامِ، قد أُقيموا في الشَّمسِ، فقال: ما شَأنُهم؟ قالوا: حُبِسوا في الجِزيةِ، فقال هِشامٌ: أشهَدُ لَسَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["إنَّ اللهَ يُعَذِّبُ الذينَ",2],[" يُعَذِّبونَ النَّاسَ في الدُّنيا",1],". [وفي روايةٍ]: وأميرُهم يَومَئذٍ عُمَيرُ بنُ سَعدٍ على فِلَسطينَ، فدَخَلَ عليه فحَدَّثَه، فأمَرَ بهم فخُلُّوا."],"grade":"صحيح","narrator":"هشام بن حكيم بن حزام","muhaddith":"[صحيح]","takhrij":"أخرجه أبو داود (3045)، والنسائي في ((الكبرى)) (8718)، وأحمد (15336) باختلاف يسير","bab":"رقائق وزهد › الجزاء من جنس العمل","dorar":"mVg4f3Ho","merged":6,"otherRefs":["صحيح مسلم 2613 (صحيح)","صحيح ابن حبان 5613 (صحيح)","فيض القدير 2/ 304 (صحيح)","صحيح أبي داود 3045 (صحيح)","صحيح ابن حبان 5612 (صحيح)"]},{"id":"س-02230","fp":"737366924511","stateId":586,"easy":"إذا أطعت في معصية الله ← هلكت (ما خرجوا منها أبداً)","cause":"لو دَخَلُوهَا","result":"ما خَرَجُوا منها أبَدًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح الجامع 2327","srcLabel":"متفق عليه","text":["إنما الطاعةُ في المعروفِ [يعني حديث: بَعَثَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ سَرِيَّةً، وأَمَّرَ عليهم رَجُلًا مِنَ الأنْصَارِ، وأَمَرَهُمْ أنْ يُطِيعُوهُ، فَغَضِبَ عليهم، وقالَ: أليسَ قدْ أمَرَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ أنْ تُطِيعُونِي؟ قالوا: بَلَى، قالَ: قدْ عَزَمْتُ علَيْكُم لَما جَمَعْتُمْ حَطَبًا، وأَوْقَدْتُمْ نَارًا، ثُمَّ دَخَلْتُمْ فِيهَا فَجَمَعُوا حَطَبًا، فأوْقَدُوا نَارًا، فَلَمَّا هَمُّوا بالدُّخُولِ، فَقَامَ يَنْظُرُ بَعْضُهُمْ إلى بَعْضٍ، قالَ بَعْضُهُمْ: إنَّما تَبِعْنَا النبيَّ صَلَّى اللهُ عليه وسلَّمَ فِرَارًا مِنَ النَّارِ أفَنَدْخُلُهَا؟ فَبيْنَما هُمْ كَذلكَ، إذْ خَمَدَتِ النَّارُ، وسَكَنَ غَضَبُهُ، فَذُكِرَ للنبيِّ صَلَّى اللهُ عليه وسلَّمَ، فَقالَ: ",["لو دَخَلُوهَا",1]," ",["ما خَرَجُوا منها أبَدًا",2],"، إنَّما الطَّاعَةُ في المَعروفِ.]"],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح","takhrij":"أخرجه البخاري (7257)، ومسلم (1840)، وأبو داود (2625) بلفظه تامًا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"zfmAtC4J","merged":3,"otherRefs":["تخريج المسند لشعيب 1018 (صحيح)","صحيح البخاري 4340 (صحيح)"]},{"id":"ق-0022","fp":"5dfd40ec2b01","stateId":586,"easy":"تحريف الكتاب والتكسّب به ← الويل","cause":"تحريف الكتاب والتكسّب به","result":"الويل","explicit":true,"ref":"سورة البقرة: 79","srcLabel":"القرآن الكريم","quran":{"s":2,"from":79,"to":79,"text":"فَوَيْلٌ لِلَّذِينَ يَكْتُبُونَ الْكِتَابَ بِأَيْدِيهِمْ ثُمَّ يَقُولُونَ هَذَا مِنْ عِنْدِ اللَّهِ لِيَشْتَرُوا بِهِ ثَمَنًا قَلِيلًا فَوَيْلٌ لَهُمْ مِمَّا كَتَبَتْ أَيْدِيهِمْ وَوَيْلٌ لَهُمْ مِمَّا يَكْسِبُونَ (79)","hl":[[0,178,1]]}},{"id":"ق-0060","fp":"54f3023de639","stateId":586,"easy":"الاعتداء بعد العفو وأخذ الدية ← عذاب أليم","cause":"الاعتداء بعد العفو وأخذ الدية","result":"عذاب أليم","explicit":true,"ref":"سورة البقرة: 178","srcLabel":"القرآن الكريم","quran":{"s":2,"from":178,"to":178,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا كُتِبَ عَلَيْكُمُ الْقِصَاصُ فِي الْقَتْلَى الْحُرُّ بِالْحُرِّ وَالْعَبْدُ بِالْعَبْدِ وَالْأُنْثَى بِالْأُنْثَى فَمَنْ عُفِيَ لَهُ مِنْ أَخِيهِ شَيْءٌ فَاتِّبَاعٌ بِالْمَعْرُوفِ وَأَدَاءٌ إِلَيْهِ بِإِحْسَانٍ ذَلِكَ تَخْفِيفٌ مِنْ رَبِّكُمْ وَرَحْمَةٌ فَمَنِ اعْتَدَى بَعْدَ ذَلِكَ فَلَهُ عَذَابٌ أَلِيمٌ (178)","hl":[[285,337,1]]}},{"id":"ق-0076","fp":"ce8798fcd4df","stateId":586,"easy":"الإفساد في الأرض والعزّة بالإثم عند النصيحة ← جهنم وبئس المهاد","cause":"الإفساد في الأرض والعزّة بالإثم عند النصيحة","result":"جهنم وبئس المهاد","explicit":true,"ref":"سورة البقرة: 204–206","srcLabel":"القرآن الكريم","quran":{"s":2,"from":204,"to":206,"text":"وَمِنَ النَّاسِ مَنْ يُعْجِبُكَ قَوْلُهُ فِي الْحَيَاةِ الدُّنْيَا وَيُشْهِدُ اللَّهَ عَلَى مَا فِي قَلْبِهِ وَهُوَ أَلَدُّ الْخِصَامِ (204) وَإِذَا تَوَلَّى سَعَى فِي الْأَرْضِ لِيُفْسِدَ فِيهَا وَيُهْلِكَ الْحَرْثَ وَالنَّسْلَ وَاللَّهُ لَا يُحِبُّ الْفَسَادَ (205) وَإِذَا قِيلَ لَهُ اتَّقِ اللَّهَ أَخَذَتْهُ الْعِزَّةُ بِالْإِثْمِ فَحَسْبُهُ جَهَنَّمُ وَلَبِئْسَ الْمِهَادُ (206)","hl":[[0,378,1]]}},{"id":"ق-0206","fp":"328a93a500f6","stateId":586,"easy":"معصية الله ورسوله وتعدّي حدوده ← نار خالداً فيها وعذاب مهين","cause":"معصية الله ورسوله وتعدّي حدوده","result":"نار خالداً فيها وعذاب مهين","explicit":true,"similar":["ق-1388"],"ref":"سورة النساء: 14","srcLabel":"القرآن الكريم","quran":{"s":4,"from":14,"to":14,"text":"وَمَنْ يَعْصِ اللَّهَ وَرَسُولَهُ وَيَتَعَدَّ حُدُودَهُ يُدْخِلْهُ نَارًا خَالِدًا فِيهَا وَلَهُ عَذَابٌ مُهِينٌ (14)","hl":[[0,112,1]]}},{"id":"ق-0252","fp":"c1af465dc15b","stateId":586,"easy":"عمل السوء ← يُجزى به ولا وليّ ولا نصير","cause":"عمل السوء","result":"يُجزى به ولا وليّ ولا نصير","explicit":true,"otherNeedIds":[49],"ref":"سورة النساء: 123","srcLabel":"القرآن الكريم","quran":{"s":4,"from":123,"to":123,"text":"لَيْسَ بِأَمَانِيِّكُمْ وَلَا أَمَانِيِّ أَهْلِ الْكِتَابِ مَنْ يَعْمَلْ سُوءًا يُجْزَ بِهِ وَلَا يَجِدْ لَهُ مِنْ دُونِ اللَّهِ وَلِيًّا وَلَا نَصِيرًا (123)","hl":[[59,152,1]]}},{"id":"ق-0337","fp":"ae4ef07a484b","stateId":586,"easy":"الاعتداء بعد النهي ← عذاب أليم","cause":"الاعتداء بعد النهي","result":"عذاب أليم","explicit":true,"ref":"سورة المائدة: 94","srcLabel":"القرآن الكريم","quran":{"s":5,"from":94,"to":94,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَيَبْلُوَنَّكُمُ اللَّهُ بِشَيْءٍ مِنَ الصَّيْدِ تَنَالُهُ أَيْدِيكُمْ وَرِمَاحُكُمْ لِيَعْلَمَ اللَّهُ مَنْ يَخَافُهُ بِالْغَيْبِ فَمَنِ اعْتَدَى بَعْدَ ذَلِكَ فَلَهُ عَذَابٌ أَلِيمٌ (94)","hl":[[163,215,1]]}},{"id":"ق-0348","fp":"2b91629ed464","stateId":586,"easy":"معصية الله ← عذاب يوم عظيم","cause":"معصية الله","result":"عذاب يوم عظيم","explicit":true,"ref":"سورة الأنعام: 15","srcLabel":"القرآن الكريم","quran":{"s":6,"from":15,"to":15,"text":"قُلْ إِنِّي أَخَافُ إِنْ عَصَيْتُ رَبِّي عَذَابَ يَوْمٍ عَظِيمٍ (15)","hl":[[5,63,1]]}},{"id":"ق-0554","fp":"b1c8fcae1d42","stateId":586,"easy":"كسب السيئات ← جزاء سيئة بمثلها وذلة ولا عاصم من الله والخلود في النار","cause":"كسب السيئات","result":"جزاء سيئة بمثلها وذلة ولا عاصم من الله والخلود في النار","explicit":true,"ref":"سورة يونس: 27","srcLabel":"القرآن الكريم","quran":{"s":10,"from":27,"to":27,"text":"وَالَّذِينَ كَسَبُوا السَّيِّئَاتِ جَزَاءُ سَيِّئَةٍ بِمِثْلِهَا وَتَرْهَقُهُمْ ذِلَّةٌ مَا لَهُمْ مِنَ اللَّهِ مِنْ عَاصِمٍ كَأَنَّمَا أُغْشِيَتْ وُجُوهُهُمْ قِطَعًا مِنَ اللَّيْلِ مُظْلِمًا أُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ (27)","hl":[[0,243,1]]}},{"id":"ق-0598","fp":"8b7912c538d9","stateId":586,"easy":"الركون إلى الظالمين ← مسّ النار وفقد الولاية والنصر","cause":"الركون إلى الظالمين","result":"مسّ النار وفقد الولاية والنصر","explicit":true,"otherNeedIds":[39],"ref":"سورة هود: 113","srcLabel":"القرآن الكريم","quran":{"s":11,"from":113,"to":113,"text":"وَلَا تَرْكَنُوا إِلَى الَّذِينَ ظَلَمُوا فَتَمَسَّكُمُ النَّارُ وَمَا لَكُمْ مِنْ دُونِ اللَّهِ مِنْ أَوْلِيَاءَ ثُمَّ لَا تُنْصَرُونَ (113)","hl":[[0,135,1]]}},{"id":"ق-0644","fp":"c0c7f8e48eb6","stateId":586,"easy":"الظلم ← عذاب أليم","cause":"الظلم","result":"عذاب أليم","explicit":true,"similar":["ق-0738","ق-0874","ق-1016","ق-1150","ق-1163","ق-1171","ق-1266","ق-1403"],"ref":"سورة إبراهيم: 22","srcLabel":"القرآن الكريم","quran":{"s":14,"from":22,"to":22,"text":"وَقَالَ الشَّيْطَانُ لَمَّا قُضِيَ الْأَمْرُ إِنَّ اللَّهَ وَعَدَكُمْ وَعْدَ الْحَقِّ وَوَعَدْتُكُمْ فَأَخْلَفْتُكُمْ وَمَا كَانَ لِيَ عَلَيْكُمْ مِنْ سُلْطَانٍ إِلَّا أَنْ دَعَوْتُكُمْ فَاسْتَجَبْتُمْ لِي فَلَا تَلُومُونِي وَلُومُوا أَنْفُسَكُمْ مَا أَنَا بِمُصْرِخِكُمْ وَمَا أَنْتُمْ بِمُصْرِخِيَّ إِنِّي كَفَرْتُ بِمَا أَشْرَكْتُمُونِ مِنْ قَبْلُ إِنَّ الظَّالِمِينَ لَهُمْ عَذَابٌ أَلِيمٌ (22)","hl":[[351,393,1]]}},{"id":"ق-0652","fp":"e79f5c90d57c","stateId":586,"easy":"الظلم ← الإمهال ليوم تشخص فيه الأبصار","cause":"الظلم","result":"الإمهال ليوم تشخص فيه الأبصار","explicit":true,"otherNeedIds":[49],"ref":"سورة إبراهيم: 42","srcLabel":"القرآن الكريم","quran":{"s":14,"from":42,"to":42,"text":"وَلَا تَحْسَبَنَّ اللَّهَ غَافِلًا عَمَّا يَعْمَلُ الظَّالِمُونَ إِنَّمَا يُؤَخِّرُهُمْ لِيَوْمٍ تَشْخَصُ فِيهِ الْأَبْصَارُ (42)","hl":[[0,124,1]]}},{"id":"ق-0716","fp":"21f41882fb83","stateId":586,"easy":"الركون إلى أهل الباطل ← ضعف الحياة وضعف الممات ولا نصير","cause":"الركون إلى أهل الباطل","result":"ضعف الحياة وضعف الممات ولا نصير","explicit":true,"otherNeedIds":[39],"ref":"سورة الإسراء: 74–75","srcLabel":"القرآن الكريم","quran":{"s":17,"from":74,"to":75,"text":"وَلَوْلَا أَنْ ثَبَّتْنَاكَ لَقَدْ كِدْتَ تَرْكَنُ إِلَيْهِمْ شَيْئًا قَلِيلًا (74) إِذًا لَأَذَقْنَاكَ ضِعْفَ الْحَيَاةِ وَضِعْفَ الْمَمَاتِ ثُمَّ لَا تَجِدُ لَكَ عَلَيْنَا نَصِيرًا (75)","hl":[[0,182,1]]}},{"id":"ق-0728","fp":"b36af7b6e13c","stateId":586,"easy":"الظلم ← نار أحاط بهم سرادقها وماء كالمهل","cause":"الظلم","result":"نار أحاط بهم سرادقها وماء كالمهل","explicit":true,"ref":"سورة الكهف: 29","srcLabel":"القرآن الكريم","quran":{"s":18,"from":29,"to":29,"text":"وَقُلِ الْحَقُّ مِنْ رَبِّكُمْ فَمَنْ شَاءَ فَلْيُؤْمِنْ وَمَنْ شَاءَ فَلْيَكْفُرْ إِنَّا أَعْتَدْنَا لِلظَّالِمِينَ نَارًا أَحَاطَ بِهِمْ سُرَادِقُهَا وَإِنْ يَسْتَغِيثُوا يُغَاثُوا بِمَاءٍ كَالْمُهْلِ يَشْوِي الْوُجُوهَ بِئْسَ الشَّرَابُ وَسَاءَتْ مُرْتَفَقًا (29)","hl":[[83,261,1]]}},{"id":"ق-0738","fp":"ee9893b74224","stateId":586,"easy":"الظلم ← العذاب في الدنيا ثم عذاب نُكر عند الله","cause":"الظلم","result":"العذاب في الدنيا ثم عذاب نُكر عند الله","explicit":true,"repOf":"ق-0644","otherNeedIds":[49],"ref":"سورة الكهف: 87","quran":{"s":18,"from":87,"to":87,"text":"قَالَ أَمَّا مَنْ ظَلَمَ فَسَوْفَ نُعَذِّبُهُ ثُمَّ يُرَدُّ إِلَى رَبِّهِ فَيُعَذِّبُهُ عَذَابًا نُكْرًا (87)","hl":[[13,104,1]]}},{"id":"ق-0752","fp":"011e79483935","stateId":586,"easy":"الظلم ← البقاء في النار جثياً","cause":"الظلم","result":"البقاء في النار جثياً","explicit":true,"ref":"سورة مريم: 72","srcLabel":"القرآن الكريم","quran":{"s":19,"from":72,"to":72,"text":"ثُمَّ نُنَجِّي الَّذِينَ اتَّقَوْا وَنَذَرُ الظَّالِمِينَ فِيهَا جِثِيًّا (72)","hl":[[35,73,1]]}},{"id":"ق-0758","fp":"424646ee45bc","stateId":586,"easy":"الإجرام ← السَّوق إلى جهنم ورداً","cause":"الإجرام","result":"السَّوق إلى جهنم ورداً","explicit":true,"ref":"سورة مريم: 86","srcLabel":"القرآن الكريم","quran":{"s":19,"from":86,"to":86,"text":"وَنَسُوقُ الْمُجْرِمِينَ إِلَى جَهَنَّمَ وِرْدًا (86)","hl":[[0,48,1]]}},{"id":"ق-0769","fp":"1f98b8746c85","stateId":586,"easy":"إتيان الله مجرماً ← جهنم لا يموت فيها ولا يحيى","cause":"إتيان الله مجرماً","result":"جهنم لا يموت فيها ولا يحيى","explicit":true,"ref":"سورة طه: 74","srcLabel":"القرآن الكريم","quran":{"s":20,"from":74,"to":74,"text":"إِنَّهُ مَنْ يَأْتِ رَبَّهُ مُجْرِمًا فَإِنَّ لَهُ جَهَنَّمَ لَا يَمُوتُ فِيهَا وَلَا يَحْيَى (74)","hl":[[8,93,1]]}},{"id":"ق-0808","fp":"f938ac1e5740","stateId":586,"easy":"الإلحاد بظلم في الحرم والصد عن سبيل الله ← عذاب أليم","cause":"الإلحاد بظلم في الحرم والصد عن سبيل الله","result":"عذاب أليم","explicit":true,"ref":"سورة الحج: 25","srcLabel":"القرآن الكريم","quran":{"s":22,"from":25,"to":25,"text":"إِنَّ الَّذِينَ كَفَرُوا وَيَصُدُّونَ عَنْ سَبِيلِ اللَّهِ وَالْمَسْجِدِ الْحَرَامِ الَّذِي جَعَلْنَاهُ لِلنَّاسِ سَوَاءً الْعَاكِفُ فِيهِ وَالْبَادِ وَمَنْ يُرِدْ فِيهِ بِإِلْحَادٍ بِظُلْمٍ نُذِقْهُ مِنْ عَذَابٍ أَلِيمٍ (25)","hl":[[0,220,1]]}},{"id":"ق-0874","fp":"9c16471e4540","stateId":586,"easy":"الظلم ← عذاب كبير","cause":"الظلم","result":"عذاب كبير","explicit":true,"repOf":"ق-0644","ref":"سورة الفرقان: 19","quran":{"s":25,"from":19,"to":19,"text":"فَقَدْ كَذَّبُوكُمْ بِمَا تَقُولُونَ فَمَا تَسْتَطِيعُونَ صَرْفًا وَلَا نَصْرًا وَمَنْ يَظْلِمْ مِنْكُمْ نُذِقْهُ عَذَابًا كَبِيرًا (19)","hl":[[80,131,1]]}},{"id":"ق-0909","fp":"0a8e24685a0a","stateId":586,"easy":"المجيء بالسيئة ← كبّ الوجوه في النار","cause":"المجيء بالسيئة","result":"كبّ الوجوه في النار","explicit":true,"ref":"سورة النمل: 90","srcLabel":"القرآن الكريم","quran":{"s":27,"from":90,"to":90,"text":"وَمَنْ جَاءَ بِالسَّيِّئَةِ فَكُبَّتْ وُجُوهُهُمْ فِي النَّارِ هَلْ تُجْزَوْنَ إِلَّا مَا كُنْتُمْ تَعْمَلُونَ (90)","hl":[[0,110,1]]}},{"id":"ق-0980","fp":"8cddc5bbbced","stateId":586,"easy":"الفسق ← مأواهم النار كلما أرادوا الخروج أعيدوا","cause":"الفسق","result":"مأواهم النار كلما أرادوا الخروج أعيدوا","explicit":true,"ref":"سورة السجدة: 20","srcLabel":"القرآن الكريم","quran":{"s":32,"from":20,"to":20,"text":"وَأَمَّا الَّذِينَ فَسَقُوا فَمَأْوَاهُمُ النَّارُ كُلَّمَا أَرَادُوا أَنْ يَخْرُجُوا مِنْهَا أُعِيدُوا فِيهَا وَقِيلَ لَهُمْ ذُوقُوا عَذَابَ النَّارِ الَّذِي كُنْتُمْ بِهِ تُكَذِّبُونَ (20)","hl":[[0,185,1]]}},{"id":"ق-1008","fp":"44ca0bdd0e3f","stateId":586,"easy":"الزيغ عن أمر الله ← عذاب السعير","cause":"الزيغ عن أمر الله","result":"عذاب السعير","explicit":true,"ref":"سورة سبأ: 12","srcLabel":"القرآن الكريم","quran":{"s":34,"from":12,"to":12,"text":"وَلِسُلَيْمَانَ الرِّيحَ غُدُوُّهَا شَهْرٌ وَرَوَاحُهَا شَهْرٌ وَأَسَلْنَا لَهُ عَيْنَ الْقِطْرِ وَمِنَ الْجِنِّ مَنْ يَعْمَلُ بَيْنَ يَدَيْهِ بِإِذْنِ رَبِّهِ وَمَنْ يَزِغْ مِنْهُمْ عَنْ أَمْرِنَا نُذِقْهُ مِنْ عَذَابِ السَّعِيرِ (12)","hl":[[160,230,1]]}},{"id":"ق-1016","fp":"d1293febf1ab","stateId":586,"easy":"الظلم ← عذاب النار","cause":"الظلم","result":"عذاب النار","explicit":true,"repOf":"ق-0644","ref":"سورة سبأ: 42","quran":{"s":34,"from":42,"to":42,"text":"فَالْيَوْمَ لَا يَمْلِكُ بَعْضُكُمْ لِبَعْضٍ نَفْعًا وَلَا ضَرًّا وَنَقُولُ لِلَّذِينَ ظَلَمُوا ذُوقُوا عَذَابَ النَّارِ الَّتِي كُنْتُمْ بِهَا تُكَذِّبُونَ (42)","hl":[[76,156,1]]}},{"id":"ق-1023","fp":"e0e76ff13a75","stateId":586,"easy":"مكر السيئات ← عذاب شديد وبوار المكر","cause":"مكر السيئات","result":"عذاب شديد وبوار المكر","explicit":true,"otherNeedIds":[50],"ref":"سورة فاطر: 10","srcLabel":"القرآن الكريم","quran":{"s":35,"from":10,"to":10,"text":"مَنْ كَانَ يُرِيدُ الْعِزَّةَ فَلِلَّهِ الْعِزَّةُ جَمِيعًا إِلَيْهِ يَصْعَدُ الْكَلِمُ الطَّيِّبُ وَالْعَمَلُ الصَّالِحُ يَرْفَعُهُ وَالَّذِينَ يَمْكُرُونَ السَّيِّئَاتِ لَهُمْ عَذَابٌ شَدِيدٌ وَمَكْرُ أُولَئِكَ هُوَ يَبُورُ (10)","hl":[[133,225,1]]}},{"id":"ق-1067","fp":"acd7c05c763e","stateId":586,"easy":"الطغيان ← شر مآب: جهنم","cause":"الطغيان","result":"شر مآب: جهنم","explicit":true,"ref":"سورة ص: 55–56","srcLabel":"القرآن الكريم","quran":{"s":38,"from":55,"to":56,"text":"هَذَا وَإِنَّ لِلطَّاغِينَ لَشَرَّ مَآبٍ (55) جَهَنَّمَ يَصْلَوْنَهَا فَبِئْسَ الْمِهَادُ (56)","hl":[[6,89,1]]}},{"id":"ق-1092","fp":"3f47d20c5ec8","stateId":586,"easy":"الظلم ← لا تقبل الفدية وبدا لهم من الله ما لم يحتسبوا","cause":"الظلم","result":"لا تقبل الفدية وبدا لهم من الله ما لم يحتسبوا","explicit":true,"ref":"سورة الزمر: 47–48","srcLabel":"القرآن الكريم","quran":{"s":39,"from":47,"to":48,"text":"وَلَوْ أَنَّ لِلَّذِينَ ظَلَمُوا مَا فِي الْأَرْضِ جَمِيعًا وَمِثْلَهُ مَعَهُ لَافْتَدَوْا بِهِ مِنْ سُوءِ الْعَذَابِ يَوْمَ الْقِيَامَةِ وَبَدَا لَهُمْ مِنَ اللَّهِ مَا لَمْ يَكُونُوا يَحْتَسِبُونَ (47) وَبَدَا لَهُمْ سَيِّئَاتُ مَا كَسَبُوا وَحَاقَ بِهِمْ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ (48)","hl":[[0,290,1]]}},{"id":"ق-1106","fp":"15d056cc7a30","stateId":586,"easy":"الظلم ← لا حميم ولا شفيع يطاع","cause":"الظلم","result":"لا حميم ولا شفيع يطاع","explicit":true,"otherNeedIds":[39],"ref":"سورة غافر: 18","srcLabel":"القرآن الكريم","quran":{"s":40,"from":18,"to":18,"text":"وَأَنْذِرْهُمْ يَوْمَ الْآزِفَةِ إِذِ الْقُلُوبُ لَدَى الْحَنَاجِرِ كَاظِمِينَ مَا لِلظَّالِمِينَ مِنْ حَمِيمٍ وَلَا شَفِيعٍ يُطَاعُ (18)","hl":[[79,132,1]]}},{"id":"ق-1150","fp":"dfca7a36abbf","stateId":586,"easy":"الظلم ← عذاب أليم","cause":"الظلم","result":"عذاب أليم","explicit":true,"repOf":"ق-0644","ref":"سورة الشورى: 21","quran":{"s":42,"from":21,"to":21,"text":"أَمْ لَهُمْ شُرَكَاءُ شَرَعُوا لَهُمْ مِنَ الدِّينِ مَا لَمْ يَأْذَنْ بِهِ اللَّهُ وَلَوْلَا كَلِمَةُ الْفَصْلِ لَقُضِيَ بَيْنَهُمْ وَإِنَّ الظَّالِمِينَ لَهُمْ عَذَابٌ أَلِيمٌ (21)","hl":[[132,176,1]]}},{"id":"ق-1161","fp":"97c91d5078d2","stateId":586,"easy":"ظلم الناس والبغي في الأرض بغير الحق ← عذاب أليم","cause":"ظلم الناس والبغي في الأرض بغير الحق","result":"عذاب أليم","explicit":true,"ref":"سورة الشورى: 42","srcLabel":"القرآن الكريم","quran":{"s":42,"from":42,"to":42,"text":"إِنَّمَا السَّبِيلُ عَلَى الَّذِينَ يَظْلِمُونَ النَّاسَ وَيَبْغُونَ فِي الْأَرْضِ بِغَيْرِ الْحَقِّ أُولَئِكَ لَهُمْ عَذَابٌ أَلِيمٌ (42)","hl":[[26,133,1]]}},{"id":"ق-1163","fp":"3c662034237f","stateId":586,"easy":"الظلم ← عذاب مقيم ولا أولياء ينصرونهم","cause":"الظلم","result":"عذاب مقيم ولا أولياء ينصرونهم","explicit":true,"repOf":"ق-0644","otherNeedIds":[39],"ref":"سورة الشورى: 45–46","quran":{"s":42,"from":45,"to":46,"text":"وَتَرَاهُمْ يُعْرَضُونَ عَلَيْهَا خَاشِعِينَ مِنَ الذُّلِّ يَنْظُرُونَ مِنْ طَرْفٍ خَفِيٍّ وَقَالَ الَّذِينَ آمَنُوا إِنَّ الْخَاسِرِينَ الَّذِينَ خَسِرُوا أَنْفُسَهُمْ وَأَهْلِيهِمْ يَوْمَ الْقِيَامَةِ أَلَا إِنَّ الظَّالِمِينَ فِي عَذَابٍ مُقِيمٍ (45) وَمَا كَانَ لَهُمْ مِنْ أَوْلِيَاءَ يَنْصُرُونَهُمْ مِنْ دُونِ اللَّهِ وَمَنْ يُضْلِلِ اللَّهُ فَمَا لَهُ مِنْ سَبِيلٍ (46)","hl":[[203,324,1]]}},{"id":"ق-1171","fp":"52ac3bd4cca1","stateId":586,"easy":"الظلم ← ويل من عذاب يوم أليم","cause":"الظلم","result":"ويل من عذاب يوم أليم","explicit":true,"repOf":"ق-0644","ref":"سورة الزخرف: 65","quran":{"s":43,"from":65,"to":65,"text":"فَاخْتَلَفَ الْأَحْزَابُ مِنْ بَيْنِهِمْ فَوَيْلٌ لِلَّذِينَ ظَلَمُوا مِنْ عَذَابِ يَوْمٍ أَلِيمٍ (65)","hl":[[41,97,1]]}},{"id":"ق-1175","fp":"f289f814334c","stateId":586,"easy":"الإجرام ← الخلود في عذاب جهنم لا يُفتَّر عنهم","cause":"الإجرام","result":"الخلود في عذاب جهنم لا يُفتَّر عنهم","explicit":true,"ref":"سورة الزخرف: 74–75","srcLabel":"القرآن الكريم","quran":{"s":43,"from":74,"to":75,"text":"إِنَّ الْمُجْرِمِينَ فِي عَذَابِ جَهَنَّمَ خَالِدُونَ (74) لَا يُفَتَّرُ عَنْهُمْ وَهُمْ فِيهِ مُبْلِسُونَ (75)","hl":[[0,106,1]]}},{"id":"ق-1180","fp":"f9b6533da327","stateId":586,"easy":"الإثم ← شجرة الزقوم والحميم","cause":"الإثم","result":"شجرة الزقوم والحميم","explicit":true,"ref":"سورة الدخان: 43–50","srcLabel":"القرآن الكريم","quran":{"s":44,"from":43,"to":50,"text":"إِنَّ شَجَرَتَ الزَّقُّومِ (43) طَعَامُ الْأَثِيمِ (44) كَالْمُهْلِ يَغْلِي فِي الْبُطُونِ (45) كَغَلْيِ الْحَمِيمِ (46) خُذُوهُ فَاعْتِلُوهُ إِلَى سَوَاءِ الْجَحِيمِ (47) ثُمَّ صُبُّوا فَوْقَ رَأْسِهِ مِنْ عَذَابِ الْحَمِيمِ (48) ذُقْ إِنَّكَ أَنْتَ الْعَزِيزُ الْكَرِيمُ (49) إِنَّ هَذَا مَا كُنْتُمْ بِهِ تَمْتَرُونَ (50)","hl":[[0,319,1]]}},{"id":"ق-1266","fp":"bb1b4334e668","stateId":586,"easy":"الظلم ← نصيب من العذاب مثل نصيب أصحابهم","cause":"الظلم","result":"نصيب من العذاب مثل نصيب أصحابهم","explicit":true,"repOf":"ق-0644","otherNeedIds":[49],"ref":"سورة الذاريات: 59","quran":{"s":51,"from":59,"to":59,"text":"فَإِنَّ لِلَّذِينَ ظَلَمُوا ذَنُوبًا مِثْلَ ذَنُوبِ أَصْحَابِهِمْ فَلَا يَسْتَعْجِلُونِ (59)","hl":[[8,87,1]]}},{"id":"ق-1273","fp":"4088ef5e1ad1","stateId":586,"easy":"الإساءة ← الجزاء بما عملوا","cause":"الإساءة","result":"الجزاء بما عملوا","explicit":true,"ref":"سورة النجم: 31","srcLabel":"القرآن الكريم","quran":{"s":53,"from":31,"to":31,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ لِيَجْزِيَ الَّذِينَ أَسَاءُوا بِمَا عَمِلُوا وَيَجْزِيَ الَّذِينَ أَحْسَنُوا بِالْحُسْنَى (31)","hl":[[52,97,1]]}},{"id":"ق-1284","fp":"c3271736ceb0","stateId":586,"easy":"الإجرام ← ضلال وسُعر والسحب في النار على الوجوه","cause":"الإجرام","result":"ضلال وسُعر والسحب في النار على الوجوه","explicit":true,"ref":"سورة القمر: 47–48","srcLabel":"القرآن الكريم","quran":{"s":54,"from":47,"to":48,"text":"إِنَّ الْمُجْرِمِينَ فِي ضَلَالٍ وَسُعُرٍ (47) يَوْمَ يُسْحَبُونَ فِي النَّارِ عَلَى وُجُوهِهِمْ ذُوقُوا مَسَّ سَقَرَ (48)","hl":[[0,117,1]]}},{"id":"ق-1286","fp":"2d0da4c618d8","stateId":586,"easy":"الإجرام ← الأخذ بالنواصي والأقدام","cause":"الإجرام","result":"الأخذ بالنواصي والأقدام","explicit":true,"ref":"سورة الرحمن: 41","srcLabel":"القرآن الكريم","quran":{"s":55,"from":41,"to":41,"text":"يُعْرَفُ الْمُجْرِمُونَ بِسِيمَاهُمْ فَيُؤْخَذُ بِالنَّوَاصِي وَالْأَقْدَامِ (41)","hl":[[0,76,1]]}},{"id":"ق-1291","fp":"267cfd4492a5","stateId":586,"easy":"الترف والإصرار على الحنث العظيم وإنكار البعث ← سَموم وحميم وظل من يحموم","cause":"الترف والإصرار على الحنث العظيم وإنكار البعث","result":"سَموم وحميم وظل من يحموم","explicit":true,"ref":"سورة الواقعة: 41–47","srcLabel":"القرآن الكريم","quran":{"s":56,"from":41,"to":47,"text":"وَأَصْحَابُ الشِّمَالِ مَا أَصْحَابُ الشِّمَالِ (41) فِي سَمُومٍ وَحَمِيمٍ (42) وَظِلٍّ مِنْ يَحْمُومٍ (43) لَا بَارِدٍ وَلَا كَرِيمٍ (44) إِنَّهُمْ كَانُوا قَبْلَ ذَلِكَ مُتْرَفِينَ (45) وَكَانُوا يُصِرُّونَ عَلَى الْحِنْثِ الْعَظِيمِ (46) وَكَانُوا يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا أَإِنَّا لَمَبْعُوثُونَ (47)","hl":[[0,330,1]]}},{"id":"ق-1310","fp":"7c515d2bc1b2","stateId":586,"easy":"التناجي بالإثم والعدوان ومعصية الرسول ← حسبهم جهنم","cause":"التناجي بالإثم والعدوان ومعصية الرسول","result":"حسبهم جهنم","explicit":true,"ref":"سورة المجادلة: 8","srcLabel":"القرآن الكريم","quran":{"s":58,"from":8,"to":8,"text":"أَلَمْ تَرَ إِلَى الَّذِينَ نُهُوا عَنِ النَّجْوَى ثُمَّ يَعُودُونَ لِمَا نُهُوا عَنْهُ وَيَتَنَاجَوْنَ بِالْإِثْمِ وَالْعُدْوَانِ وَمَعْصِيَتِ الرَّسُولِ وَإِذَا جَاءُوكَ حَيَّوْكَ بِمَا لَمْ يُحَيِّكَ بِهِ اللَّهُ وَيَقُولُونَ فِي أَنْفُسِهِمْ لَوْلَا يُعَذِّبُنَا اللَّهُ بِمَا نَقُولُ حَسْبُهُمْ جَهَنَّمُ يَصْلَوْنَهَا فَبِئْسَ الْمَصِيرُ (8)","hl":[[88,343,1]]}},{"id":"ق-1385","fp":"d2563d63252f","stateId":586,"easy":"القسوط (الجور عن الحق) ← حطب لجهنم","cause":"القسوط (الجور عن الحق)","result":"حطب لجهنم","explicit":true,"ref":"سورة الجن: 15","srcLabel":"القرآن الكريم","quran":{"s":72,"from":15,"to":15,"text":"وَأَمَّا الْقَاسِطُونَ فَكَانُوا لِجَهَنَّمَ حَطَبًا (15)","hl":[[0,52,1]]}},{"id":"ق-1388","fp":"a894e64a0266","stateId":586,"easy":"معصية الله ورسوله ← نار جهنم خالدين فيها أبداً","cause":"معصية الله ورسوله","result":"نار جهنم خالدين فيها أبداً","explicit":true,"repOf":"ق-0206","ref":"سورة الجن: 23","quran":{"s":72,"from":23,"to":23,"text":"إِلَّا بَلَاغًا مِنَ اللَّهِ وَرِسَالَاتِهِ وَمَنْ يَعْصِ اللَّهَ وَرَسُولَهُ فَإِنَّ لَهُ نَارَ جَهَنَّمَ خَالِدِينَ فِيهَا أَبَدًا (23)","hl":[[44,132,1]]}},{"id":"ق-1403","fp":"740865a8bd1c","stateId":586,"easy":"الظلم ← عذاب أليم","cause":"الظلم","result":"عذاب أليم","explicit":true,"repOf":"ق-0644","ref":"سورة الإنسان: 31","quran":{"s":76,"from":31,"to":31,"text":"يُدْخِلُ مَنْ يَشَاءُ فِي رَحْمَتِهِ وَالظَّالِمِينَ أَعَدَّ لَهُمْ عَذَابًا أَلِيمًا (31)","hl":[[37,85,1]]}},{"id":"ق-1407","fp":"847febd57684","stateId":586,"easy":"الإجرام ← متاع قليل","cause":"الإجرام","result":"متاع قليل","explicit":true,"ref":"سورة المرسلات: 46","srcLabel":"القرآن الكريم","quran":{"s":77,"from":46,"to":46,"text":"كُلُوا وَتَمَتَّعُوا قَلِيلًا إِنَّكُمْ مُجْرِمُونَ (46)","hl":[[0,51,1]]}},{"id":"ق-1409","fp":"09c4aba010e0","stateId":586,"easy":"الطغيان وعدم رجاء الحساب والتكذيب بالآيات ← جهنم مرصاداً أحقاباً وزيادة العذاب","cause":"الطغيان وعدم رجاء الحساب والتكذيب بالآيات","result":"جهنم مرصاداً أحقاباً وزيادة العذاب","explicit":true,"ref":"سورة النبأ: 21–30","srcLabel":"القرآن الكريم","quran":{"s":78,"from":21,"to":30,"text":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا (21) لِلطَّاغِينَ مَآبًا (22) لَابِثِينَ فِيهَا أَحْقَابًا (23) لَا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا (24) إِلَّا حَمِيمًا وَغَسَّاقًا (25) جَزَاءً وِفَاقًا (26) إِنَّهُمْ كَانُوا لَا يَرْجُونَ حِسَابًا (27) وَكَذَّبُوا بِآيَاتِنَا كِذَّابًا (28) وَكُلَّ شَيْءٍ أَحْصَيْنَاهُ كِتَابًا (29) فَذُوقُوا فَلَنْ نَزِيدَكُمْ إِلَّا عَذَابًا (30)","hl":[[0,376,1]]}},{"id":"ق-1412","fp":"047d6598678c","stateId":586,"easy":"الطغيان وإيثار الحياة الدنيا ← الجحيم هي المأوى","cause":"الطغيان وإيثار الحياة الدنيا","result":"الجحيم هي المأوى","explicit":true,"ref":"سورة النازعات: 37–39","srcLabel":"القرآن الكريم","quran":{"s":79,"from":37,"to":39,"text":"فَأَمَّا مَنْ طَغَى (37) وَآثَرَ الْحَيَاةَ الدُّنْيَا (38) فَإِنَّ الْجَحِيمَ هِيَ الْمَأْوَى (39)","hl":[[0,94,1]]}},{"id":"ق-1416","fp":"754aa7fe46fa","stateId":586,"easy":"الفجور ← الجحيم","cause":"الفجور","result":"الجحيم","explicit":true,"ref":"سورة الانفطار: 14","srcLabel":"القرآن الكريم","quran":{"s":82,"from":14,"to":14,"text":"وَإِنَّ الْفُجَّارَ لَفِي جَحِيمٍ (14)","hl":[[0,33,1]]}},{"id":"ق-1429","fp":"5c4759fbff39","stateId":586,"easy":"تجنّب الذكرى (الشقاء) ← النار الكبرى لا يموت فيها ولا يحيى","cause":"تجنّب الذكرى (الشقاء)","result":"النار الكبرى لا يموت فيها ولا يحيى","explicit":true,"ref":"سورة الأعلى: 11–13","srcLabel":"القرآن الكريم","quran":{"s":87,"from":11,"to":13,"text":"وَيَتَجَنَّبُهَا الْأَشْقَى (11) الَّذِي يَصْلَى النَّارَ الْكُبْرَى (12) ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَى (13)","hl":[[0,112,1]]}},{"id":"س-08008","fp":"133487bbf346","stateId":586,"easy":"إذا ظلمت ← يكون ظلمك ظلمات عليك يوم القيامة","cause":"إيَّاكُمْ والظُّلْمَ","result":"فَإنَّ الظُّلْمَ ظُلُماتٌ يومَ القيامَةِ","explicit":true,"repOf":"س-08040","otherNeedIds":[12],"ref":"المستدرك على الصحيحين 26","text":["قالَ: خَطَبَنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: «",["إيَّاكُمْ والظُّلْمَ؛ ",1],["فَإنَّ الظُّلْمَ ظُلُماتٌ يومَ القيامَةِ",2],"، وَإيَّاكُمْ والفُحْشَ والتَّفَحُّشَ، وإيَّاكُمْ والشُّحَّ؛ فإنَّما هَلَكَ مَنْ كان قَبْلَكُمْ بِالشُّحِّ، أَمَرَهُمْ بالقَطيعَةِ فقَطَعوا، والبُخْلَ فَبَخِلوا، وبالفُجورِ فَفَجَروا». فقامَ رَجُلٌ فقالَ: يا رسولَ اللهِ، أيُّ الإسْلامِ أفْضَلُ؟ قالَ: «أنْ يَسْلَمَ المسْلِمونَ مِنْ لِسانِكَ ويَدِكَ». فقالَ ذلك الرَّجلُ أو غَيرُهُ: يا رسولَ اللهِ، أيُّ الهِجْرةِ أَفْضَلُ؟ قالَ: «أنْ تَهْجُرَ ما كَرِهَ رَبُّكَ». قالَ: «والهِجْرَةُ هِجْرَتانِ: هِجْرَةُ الحاضِرِ، وهِجْرَةُ البادي؛ فَهِجْرَةُ البادي: أنْ يُجيبَ إذا دُعِيَ، ويُطيعَ إذا أُمِرَ، وهِجْرَةُ الحاضِرِ أَعْظَمُهُما بَلِيَّةً وأَفْضَلُهُما أَجْرًا»."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[صحيح سليم من رواية المجروحين]","takhrij":"أخرجه ابن حبان (5176) بلفظه، وأحمد (6837)، الدارمي (2558) كلاهما ببعض لفظه.","bab":"مظالم › تحريم الظلم","dorar":"2XPZM3DI","merged":5,"otherRefs":["تخريج المسند لشعيب 9569 (صحيح)","فوائد الحنائي الحنائيات 2/1197 (حسن)","صحيح الترغيب 2217 (صحيح)","تخريج المسند لشاكر 11/71 (صحيح)"]},{"id":"س-07454","fp":"291e2f8af046","stateId":586,"easy":"إذا قلت ولم يُرد عليك قولك (من الأمراء الظلمة) ← تتقاحم في النار","cause":"يقولونَ ، فلا يُرَدُّ عليهم قولُهُمْ","result":"يَتَقَاحَمُونَ في النارِ","explicit":true,"ref":"صحيح الجامع 3615","srcLabel":"الطبراني","text":["سَتَكُونُ أَئِمَّةٌ من بَعْدِي ، ",["يقولونَ ، فلا يُرَدُّ عليهم قولُهُمْ",1]," ، ",["يَتَقَاحَمُونَ في النارِ",2]," كما تَقَاحُمَ القِرَدَةِ"],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((الأوسط)) (5311)، وأبو الشيخ في ((أمثال الحديث)) (271) واللفظ لهما، وأبو يعلى (7382) بلفظه مطولًا.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"jMJ3iJ3o","merged":4,"otherRefs":["صحيح الجامع 2990 (صحيح)","مجمع الزوائد 5/239 (حسن)","السلسلة الصحيحة 1790 (حسن)"]},{"id":"س-02971","fp":"3199de4ed64b","stateId":586,"easy":"إذا عرفت الحق فلم تقضِ به وجرت ← ففي النار","cause":"ورَجُلٌ عَرَفَ الحَقَّ فلمْ يَقْضِ به، وجار في الحُكمِ","result":"فهو في النَّارِ","explicit":true,"ref":"تخريج مشكل الآثار 9/209","srcLabel":"الطحاوي","text":["القُضاةُ ثلاثةٌ: قاضيانِ في النَّارِ، وقاضٍ في الجنَّةِ؛ فأمَّا الذي في الجنَّةِ، فرَجُلٌ عَرَفَ الحَقَّ، فقَضى به؛ فهو في الجنَّةِ، ",["ورَجُلٌ عَرَفَ الحَقَّ فلمْ يَقْضِ به، وجار في الحُكمِ",1],"؛ ",["فهو في النَّارِ",2],"، ورَجلٌ لم يَعرِفِ الحَقَّ، فقَضى للنَّاسِ على جَهلٍ؛ فهو في النَّار."],"grade":"صحيح","muhaddith":"صحيح","bab":"إيمان › الوعيد","dorar":"O3hrjtV1","merged":3,"otherRefs":["إرواء الغليل 2628 (صحيح)","المستدرك على الصحيحين 7207 (صحيح)"]},{"id":"س-02972","fp":"565f6a951351","stateId":586,"easy":"إذا قضيت للناس على جهل ← ففي النار","cause":"ورَجلٌ لم يَعرِفِ الحَقَّ، فقَضى للنَّاسِ على جَهلٍ","result":"فهو في النَّار","explicit":true,"repOf":"س-03042","ref":"تخريج مشكل الآثار 9/209","text":["القُضاةُ ثلاثةٌ: قاضيانِ في النَّارِ، وقاضٍ في الجنَّةِ؛ فأمَّا الذي في الجنَّةِ، فرَجُلٌ عَرَفَ الحَقَّ، فقَضى به؛ فهو في الجنَّةِ، ورَجُلٌ عَرَفَ الحَقَّ فلمْ يَقْضِ به، وجار في الحُكمِ؛ فهو في النَّارِ، ",["ورَجلٌ لم يَعرِفِ الحَقَّ، فقَضى للنَّاسِ على جَهلٍ",1],"؛ ",["فهو في النَّار",2],"."],"grade":"صحيح","muhaddith":"صحيح","bab":"إيمان › الوعيد","dorar":"O3hrjtV1","merged":3,"otherRefs":["إرواء الغليل 2628 (صحيح)","مجموع الشروح الفقهية. 204/2 (صحيح)"]},{"id":"س-04934","fp":"1d2bbdfc46ba","stateId":586,"easy":"إذا كنت أميراً على عشرة ← يُؤتى بك يوم القيامة مغلولاً لا يفكك إلا العدل","cause":"ما مِن أميرِ عَشَرةٍ","result":"إلَّا يُؤتَى به يومَ القِيامةِ مَغلولًا، لا يَفُكُّه مِن ذلك الغُلِّ إلَّا العَدلُ","explicit":true,"ref":"تخريج المسند لشعيب 22463","srcLabel":"أحمد","text":[["ما مِن أميرِ عَشَرةٍ",1]," ",["إلَّا يُؤتَى به يومَ القِيامةِ مَغلولًا، لا يَفُكُّه مِن ذلك الغُلِّ إلَّا العَدلُ",2],"، وما مِن رَجُلٍ قَرَأَ القُرآنَ فنَسيَه، إلَّا لَقِيَ اللهَ يومَ يَلقاه وهو أجذَمُ."],"grade":"صحيح","narrator":"سعد بن عبادة","muhaddith":"صحيح لغيره دون قوله: \"وما من رجل قرأ القرآن ... إلخ","takhrij":"أخرجه أحمد (22463) واللفظ له، والدارمي (3340)، وعبدالرزاق (5989) مختصراً","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"dmvn7UbW","merged":3,"otherRefs":["تخريج المسند لشعيب 22456 (صحيح)","الأحكام الوسطى 2/365 (صحيح)"]},{"id":"س-05253","fp":"a82e8c70a5a4","stateId":586,"easy":"إذا كنت أشد الناس تعذيباً للناس في الدنيا ← تكون أشد الناس عذاباً يوم القيامة","cause":"أشدُّ النَّاسِ عَذابًا للنَّاسِ في الدُّنْيا","result":"أشَدَّ النَّاسِ عَذابًا يومَ القيامةِ","explicit":true,"ref":"المستدرك على الصحيحين 5359","srcLabel":"أحمد","text":["أنَّ عِياضَ بنَ غَنْمٍ الأشْعَريَّ وقَعَ على صاحِبِ دارٍ حينَ فُتِحَتْ، فأتاهُ هِشامُ بنُ حَكيمٍ، فأغلَظَ له القَولَ، ومكَثَ هِشامٌ لَياليَ، فأتاهُ هِشامٌ مُعتَذِرًا، فقالَ له هِشامٌ: ألم تَعلَمْ أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، قالَ: إنَّ ",["أشَدَّ النَّاسِ عَذابًا يومَ القيامةِ",2]," ",["أشدُّ النَّاسِ عَذابًا للنَّاسِ في الدُّنْيا",1],"؟! فقالَ له عِياضٌ: يا هِشامُ، إنَّا قد سَمِعْنا الَّذي قد سمِعْتَ، ورَأيْنا الَّذي قد رَأيْتَ، وصَحِبْنا مَن صحِبْتَ، ألم تَسمَعْ يا هِشامُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: مَن كانتْ عندَه نَصيحةٌ لذي سُلْطانٍ فلا يُكلِّمْه بها عَلانيَةً، ولْيأخُذْ بيَدِه، ولْيَخلُ به؛ فإنْ قَبِلَها قَبِلَها، وإلَّا كانَ قد أدَّى الَّذي عليه؟! وإنَّكَ يا هِشامُ، لأنتَ المُجتَرئُ، أنْ تَجتَرئَ على سُلطانِ اللهِ، فهلَّا خَشِيتَ أنْ يَقتُلَكَ سُلطانُ اللهِ، فتَكونَ قَتيلَ سُلطانِ اللهِ."],"grade":"صحيح","narrator":"عياض بن غنم الأشعري وهشام بن حكيم","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (15333)، والطبراني (17/ 367) (1007)، والبيهقي (16738) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"4oG4GL9F","merged":3,"otherRefs":["الجامع الصغير 1043 (صحيح)","إتحاف الخيرة المهرة 8/175 (حسن)"]},{"id":"س-07269","fp":"0e4da034d040","stateId":586,"easy":"إذا كنت إماماً ظلوماً غشوماً أو غالياً في الدين مارقاً ← لا تنالك شفاعة النبي ﷺ","cause":"إمامٌ ظَلومٌ غشومٌ ، وآخرُ غالٍ في الدِّينِ مارقٌ منهُ","result":"رجلانِ ما تَنالُهُما شفاعَتي","explicit":true,"ref":"تخريج كتاب السنة 41","srcLabel":"الطبراني","text":[["رجلانِ ما تَنالُهُما شفاعَتي ",2],":",[" إمامٌ ظَلومٌ غشومٌ ، وآخرُ غالٍ في الدِّينِ مارقٌ منهُ",1]],"grade":"صحيح","narrator":"معقل بن يسار","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (423) واللفظ له، والطبراني (20/214) (496)، وابن سمعون في ((أماليه)) (240) باختلاف يسير.","bab":"فتن › أمراء الجور","dorar":"YhyyMQji","merged":3,"otherRefs":["فتاوى صديق خان 341 (حسن)","صحيح الجامع 3798 (حسن)"]},{"id":"س-08015","fp":"db086a89cb77","stateId":586,"easy":"إذا كانت لك زوجتان فملت إلى إحداهما ← تجيء يوم القيامة يجرّ أحد شقيك ساقطاً","cause":"مَن كانت له امرَأَتان يَميلُ لِإحداهما على الأُخرى","result":"جاء يَومَ القِيامَةِ يَجُرُّ أَحدَ شِقَّيْه ساقِطًا أو مائِلًا","explicit":true,"similar":["س-08029"],"ref":"تخريج المسند لشعيب 7936","srcLabel":"النسائي","text":[["مَن كانت له امرَأَتان يَميلُ لِإحداهما على الأُخرى؛ ",1],["جاء يَومَ القِيامَةِ يَجُرُّ أَحدَ شِقَّيْه ساقِطًا أو مائِلًا",2],". شَكَّ يَزيدُ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه النسائي (3942)، وابن ماجه (1969)، وأحمد (7936) واللفظ له","bab":"مظالم › تحريم الظلم","dorar":"IIcqHOfM","merged":3,"otherRefs":["تخريج مشكل الآثار 234 (صحيح)","تخريج المسند لشعيب 10090 (صحيح)"]},{"id":"س-02855","fp":"5960b3314e55","stateId":586,"easy":"إذا قضيت بلا علم فأهلكت حقوق الناس ← ففي النار","cause":"وقاضٍ لا يعلَمُ ، فأَهلَكَ حقوقَ النَّاسِ","result":"فَهُوَ في النَّارِ","explicit":true,"repOf":"س-03042","ref":"صحيح الترمذي 1322","text":["القُضاةُ ثلاثةٌ : قاضيانِ في النَّارِ ، وقاضٍ في الجنَّةِ : رجلٌ قضى بغيرِ الحقِّ فعلِمَ ذاكَ فذاكَ في النَّارِ ، ",["وقاضٍ لا يعلَمُ ، فأَهلَكَ حقوقَ النَّاسِ",1]," ",["فَهُوَ في النَّارِ",2]," ، وقاضٍ قضى بالحقِّ فذلِك في الجنَّةِ"],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3573)، والترمذي (1322) واللفظ له، وابن ماجه (2315)، والنسائي في ((السنن الكبرى)) (5922).","bab":"إيمان › الوعد","dorar":"wC73r4Us","merged":2,"otherRefs":["تخريج الإحياء للعراقي 1/93 (صحيح)"]},{"id":"س-02975","fp":"ddf1f0c4e30c","stateId":586,"easy":"إذا فرقت بين والدة وولدها ← يفرق الله بينك وبين أحبتك يوم القيامة","cause":"مَن فرَّق بين والدةٍ وولَدِها","result":"فرَّق اللهُ بينه وبين أحِبَّتِهِ يومَ القيامةِ","explicit":true,"ref":"تخريج زاد المعاد 3/104","srcLabel":"الترمذي","text":["وكان صلَّى اللهُ عليه وسلَّمَ يَمنَعُ التفريقَ في السَّبْيِ بين الوالدةِ وولَدِها، ويقولُ: ",["مَن فرَّق بين والدةٍ وولَدِها، ",1],["فرَّق اللهُ بينه وبين أحِبَّتِهِ يومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1283)، وأحمد (23513)، والدارمي (2522) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"ZetTVFTN","merged":2,"otherRefs":["صحيح الجامع 6412 (صحيح)"]},{"id":"س-05022","fp":"0a130717d338","stateId":586,"easy":"إذا عرفت الحق فجرت أو قضيت بغير علم ← ففي النار","cause":"وقاضٍ عرفَ الحقَّ فجارَ مُتَعَمِّدًا أَوْ قَضَى بِغَيْرِ عِلْمٍ","result":"فهما في النارِ","explicit":true,"repOf":"س-03042","ref":"صحيح الجامع 4298","text":["قاضيانِ في النارِ ، وقاضٍ في الجنةِ، قاضٍ عرفَ الحقَّ فقَضَى بِهِ فهو في الجنةِ ، ",["وقاضٍ عرفَ الحقَّ فجارَ مُتَعَمِّدًا أَوْ قَضَى بِغَيْرِ عِلْمٍ",1]," ",["فهما في النارِ",2]],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3573)، والترمذي (1322)، والنسائي في ((السنن الكبرى)) (5922)، وابن ماجه (2315) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"NF4IRtT0","merged":2,"otherRefs":["تخريج مشكل الآثار 54 (حسن)"]},{"id":"س-05835","fp":"0b08d3690664","stateId":586,"easy":"إذا فارقت الجماعة واستذللت الإمارة ← تلقى الله ولا حجة لك","cause":"مَنْ فارَقَ الجَماعَةَ، واسْتَذَلَّ الإمارَةَ","result":"لَقِيَ اللهَ ولا حُجَّةَ له عندَ اللَّهِ","explicit":true,"similar":["س-05900"],"ref":"المستدرك على الصحيحين 415","srcLabel":"الحاكم","text":["عنْ رِبْعِيِّ بنِ حِراشٍ، أنَّه أَتَى حُذَيْفَةَ بنَ اليَمانِ يَزورُهُ، وكانتْ أُخْتُهُ تَحْتَ حُذَيْفَةَ، فقالَ لهُ حُذَيْفَةُ: يا رِبْعِيُّ، ما فَعَلَ قَوْمُكَ؟ وَذلك زَمَنَ خَرَجَ النَّاسُ إلى عُثْمانَ، قالَ: قَدْ خَرَجَ مِنْهُمْ ناسٌ، قالَ: فَسَمَّى مِنْهُمْ، فقالَ حُذَيْفَةُ: سَمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: «",["مَنْ فارَقَ الجَماعَةَ، واسْتَذَلَّ الإمارَةَ ",1],["لَقِيَ اللهَ ولا حُجَّةَ له عندَ اللَّهِ»",2],"."],"grade":"صحيح","narrator":"حذيفة","muhaddith":"صحيح","bab":"رقائق وزهد › الوصايا النافعة","dorar":"AGUiuEqD","merged":2,"otherRefs":["المستدرك على الصحيحين 414 (صحيح)"]},{"id":"س-07195","fp":"a9f788e2dbc3","stateId":586,"easy":"إذا قتلت عصفوراً فما فوقه بغير حقه ← يسألك الله عنه يوم القيامة","cause":"ما مِن إنسانٍ يَقتُلُ عُصفورًا فما فوْقَها بغيرِ حَقِّها","result":"سألَهُ اللهُ عزَّ وجلَّ عنها يومَ القِيامةِ","explicit":true,"similar":["س-00460"],"ref":"المستدرك على الصحيحين 7782","srcLabel":"النسائي","text":[["ما مِن إنسانٍ يَقتُلُ عُصفورًا فما فوْقَها بغيرِ حَقِّها",1],"، إلَّا ",["سألَهُ اللهُ عزَّ وجلَّ عنها يومَ القِيامةِ",2],"، قيل: يا رَسولَ اللهِ، وما حَقُّها؟ قالَ: حَقُّها أنْ يَذْبَحَها فيَأْكُلَها، ولا يَقْطَعَ رأْسَها فيَرْمِيَ بهِ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح الإسناد","takhrij":"أخرجه النسائي في ((الكبرى)) (4841) بلفظه، وأحمد (6551)، والدارمي (2021) كلاهما بلفظ مقارب.","bab":"علم › حسن السؤال ونصح العالم","dorar":"qflLUpJA","merged":2,"otherRefs":["الأحكام الوسطى 4/ 123 (صحيح)"]},{"id":"س-07272","fp":"1e576cf16dac","stateId":586,"easy":"إذا وليت أمة قلّت أو كثرت فلم تعدل ← يكبك الله على وجهك في النار","cause":"ليس مِن والي أُمَّةٍ قَلَّت أو كَثُرَت، لا يَعدِلُ فيها","result":"إلَّا كَبَّه اللهُ على وَجههِ في النَّارِ","explicit":true,"similar":["س-03034"],"ref":"تخريج المسند لشعيب 20296","srcLabel":"أحمد","text":["عنِ ابنةِ مَعقِلٍ المُزَنيِّ، قالت: لَمَّا ثَقُلَ أبي أتاه ابنُ زيادٍ وساقَه، يَعني: وساقَ الحَديثَ [يَعني حَديثَ: ",["ليس مِن والي أُمَّةٍ قَلَّت أو كَثُرَت، لا يَعدِلُ فيها",1],"، ",["إلَّا كَبَّه اللهُ على وَجههِ في النَّارِ",2],"]"],"grade":"صحيح","narrator":"معقل [بن يسار] المزني","muhaddith":"صحيح","bab":"فتن › أمراء الجور","dorar":"MhBWjqS7","merged":2,"otherRefs":["صحيح الجامع 2713 (صحيح)"]},{"id":"س-07440","fp":"55a4183e7bcd","stateId":586,"easy":"إذا كنت أميراً متسلطاً أو ذا ثروة لا يؤدي حق الله أو فقيراً فخوراً ← تكون من أول من يدخل النار","cause":"فأميرٌ مُسلَّطٌ، وذو ثَروةٍ مِن مالٍ لا يؤدِّي حقَّ اللَّهِ في مالِهِ، وفَقيرٌ فخورٌ","result":"أوَّلُ ثُلَّةٍ يدخُلونَ النَّارَ","explicit":true,"ref":"صحيح ابن خزيمة 4/ 11","srcLabel":"أحمد","text":["عُرِضَ عليَّ أوَّلُ ثُلَّةٍ يدخلونَ الجنَّةَ، و",["أوَّلُ ثُلَّةٍ يدخُلونَ النَّارَ",2],"، فأمَّا أوَّلُ ثُلَّةٍ يدخلونَ الجنَّةَ: فالشَّهيدُ، وعبدٌ مملوكٌ أحسنَ عبادةَ ربِّهِ، ونَصحَ لسيِّدِهِ، وعفيفٌ مُتعفِّفٌ ذو عيالٍ، وأمَّا أوَّلُ ثلَّةٍ يدخلونَ النَّارَ: ",["فأميرٌ مُسلَّطٌ، وذو ثَروةٍ مِن مالٍ لا يؤدِّي حقَّ اللَّهِ في مالِهِ، وفَقيرٌ فخورٌ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (9492)، والحاكم (1429)، والطيالسي (2690) بنحوه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"thGyc1mt","merged":2,"otherRefs":["الكبائر للذهبي 197 (صحيح)"]},{"id":"س-07876","fp":"4e846a73de8a","stateId":586,"easy":"إذا أردت أهل المدينة بسوء ← يذيبك الله في النار ذوب الرصاص","cause":"ولا يُريدُ أحَدٌ أهلَ المَدينةِ بسوءٍ","result":"إلَّا أذابَه اللهُ في النَّارِ ذَوبَ الرَّصاصِ، أو ذَوبَ المِلحِ في الماءِ","explicit":true,"repOf":"س-08441","otherNeedIds":[27,45],"ref":"صحيح مسلم 1363","text":["إنِّي أُحَرِّمُ ما بينَ لابَتَيِ المَدينةِ أن يُقطَعَ عِضاهُها، أو يُقتَلَ صَيدُها، وقال: المَدينةُ خَيرٌ لهم لو كانوا يَعلَمونَ، لا يَدَعُها أحَدٌ رَغبةً عَنها إلَّا أبدَلَ اللهُ فيها مَن هو خَيرٌ منه، ولا يَثبُتُ أحَدٌ على لَأوائِها وجَهدِها إلَّا كُنتُ له شَفيعًا، أو شَهيدًا يَومَ القيامةِ. [وفي روايةٍ]: ",["ولا يُريدُ أحَدٌ أهلَ المَدينةِ بسوءٍ",1]," ",["إلَّا أذابَه اللهُ في النَّارِ ذَوبَ الرَّصاصِ، أو ذَوبَ المِلحِ في الماءِ",2],"."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (1573)، وعبد بن حميد في ((المنتخب)) (153)، والبيهقي (10053) واللفظ لهم.","bab":"قيامة › الشفاعة","dorar":"hpxIUgNd","merged":2,"otherRefs":["المحلى 7/282 (صحيح)"]},{"id":"س-07983","fp":"241c8176dc54","stateId":586,"easy":"إذا كانت عندك مظلمة لأخيك في دم أو مال ← فتحلّله قبل يوم ليس فيه درهم ولا دينار إلا الحسنات والسيئات","cause":"من كانت عندَهُ مظلِمةٌ لأخيهِ في دمٍ أو مالٍ","result":"قبلِ أن يأتي يوم ليسَ فيهِ درْهمٌ ولا دينارٌ, إلا الحسناتِ والسيِّئاتِ فإن كانت لَهُ حسناتٌ أُخِذَ من حسناتِهِ بقدرِ مظلِمتهِ , وإلَّا أخذَ من سيِّئاتِ صاحبِهِ فطُرِحت عليهِ ثمَّ طُرِحَ في النَّارِ","explicit":true,"repOf":"س-07978","ref":"الفتح الرباني 11/5531","text":[["من كانت عندَهُ مظلِمةٌ لأخيهِ في دمٍ أو مالٍ",1]," , فليتحلَّلْها منْه ",["قبلِ أن يأتي يوم ليسَ فيهِ درْهمٌ ولا دينارٌ, إلا الحسناتِ والسيِّئاتِ فإن كانت لَهُ حسناتٌ أُخِذَ من حسناتِهِ بقدرِ مظلِمتهِ , وإلَّا أخذَ من سيِّئاتِ صاحبِهِ فطُرِحت عليهِ ثمَّ طُرِحَ في النَّارِ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"مظالم › التوبة ورد المظالم والحقوق","dorar":"3yP2vz2n","merged":2,"otherRefs":["الفتاوى الكبرى 1/113 (صحيح)"]},{"id":"س-07988","fp":"d48e4538e36c","stateId":586,"easy":"إذا ظلم العباد بعضهم بعضاً ← فالقصاص يوم القيامة لا محالة","cause":"فظلمُ العبادِ بعضِهِم بعضًا","result":"القصاصُ لا محالةَ","explicit":true,"otherNeedIds":[12],"ref":"عمدة التفسير 1/520","srcLabel":"أحمد","text":["الدَّواوينُ عندَ اللَّهِ ثلاثةٌ ؛ ديوانٌ لا يعبأُ اللَّهُ بِهِ شيئًا ، وديوانٌ لا يترُكُ اللَّهُ منهُ شيئًا ، وديوانٌ لا يغفرُهُ اللَّهُ . فأمَّا الدِّيوانُ الَّذي لا يغفرُهُ اللَّهُ ، فالشِّركُ باللَّهِ ، قالَ اللَّهُ عزَّ وجلَّ :  مَنْ يُشْرِكْ بِاللَّهِ فَقَدْ حَرَّمَ اللَّهُ عَلَيْهِ الْجَنَّةَ  المائدةِ :72 وأمَّا الدِّيوانُ الَّذي لا يعبأُ اللَّهُ بِهِ شيئًا ، فظلمُ العبدِ نفسَهُ فيما بينَهُ وبينَ ربِّهِ ، من صومِ يومٍ تركَهُ ، أو صلاةٍ تركَها ؛ فإنَّ اللَّهَ يغفرُ ذلِكَ ويتجاوزُ إن شاءَ . وأمَّا الدِّيوانُ الَّذي لا يترُكُ اللَّهُ منهُ شيئًا ، ",["فظلمُ العبادِ بعضِهِم بعضًا",1]," ؛ ",["القصاصُ لا محالةَ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (26073 )، والحاكم في ((المستدرك)) (8717 )، والبيهقي في ((شعب الإيمان)) (7069 )،","bab":"مظالم › تحريم الظلم","dorar":"ybNV1Rpi","merged":2,"otherRefs":["المستدرك على الصحيحين 8943 (صحيح)"]},{"id":"س-08010","fp":"e4fe2ad8358c","stateId":586,"easy":"إذا ظلمت بني آدم ← تتبعك مظالمهم حتى لا تبقى لك حسنة ويُزاد عليك من سيئاتهم","cause":"مَظالمُ بني آدَمَ تَتْبَعُه","result":"حتَّى ما تَبْقَى له حسنةٌ، ويُزادُ عليه مِن سيِّئاتِهِم","explicit":true,"otherNeedIds":[45],"ref":"المستدرك على الصحيحين 2302","srcLabel":"الحاكم","text":["عَنْ أَبِي عُثْمَانَ النَّهْدِيَّ أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قالَ: تُرفَعُ للرَّجلِ صحيفةٌ يومَ القيامةِ، حتَّى يَرى أنَّه ناجٍ، فما تَزالُ ",["مَظالمُ بني آدَمَ تَتْبَعُه",1]," ",["حتَّى ما تَبْقَى له حسنةٌ، ويُزادُ عليه مِن سيِّئاتِهِم",2],". قالَ: فقلتُ له -أوْ قالَ له عاصِمٌ-: عمَّن يا أبا عُثمانَ؟ قالَ: عنْ سَلمانَ، وسَعدٍ، وابنِ مسعودٍ، ورَجلينِ آخرَينِ لمْ يَحفظْهُما. قالَ شُعبَةُ: فسَألتُ عاصِمًا عنْ هذا الحديثِ فحَدَّثَنيهِ عنْ أبي عُثمانَ، عنْ سَلمانَ، وأَخْبَرني عُثمانُ بنُ غِياثٍ، أنَّه سَمِعَ أبا عُثمانَ يُحدِّثُ بهذا عنْ سَلمانَ وأصحابِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"سلمان وسعد وابن مسعود","muhaddith":"صحيح على شرط الشيخين","bab":"مظالم › تحريم الظلم","dorar":"qV1yfQA6","merged":2,"otherRefs":["صحيح الترغيب 2224 (صحيح)"]},{"id":"س-08029","fp":"98677d0ea00f","stateId":586,"easy":"إذا كانت لك زوجتان فملت إلى إحداهما ← تجيء يوم القيامة وشقك مائل","cause":"مَنْ كانَتْ لهُ امْرَأَتَانِ فمالَ إلى إحداهُما","result":"جاء يومَ القيامةِ وشِقُّهُ مائِلٌ","explicit":true,"repOf":"س-08015","ref":"بلوغ المرام 315","text":[["مَنْ كانَتْ لهُ امْرَأَتَانِ فمالَ إلى إحداهُما ",1],["جاء يومَ القيامةِ وشِقُّهُ مائِلٌ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2133) واللفظ له، والترمذي (1141)، والنسائي (3942)، وابن ماجه (1969)، وأحمد (7936)","bab":"مظالم › تحريم الظلم","dorar":"yaoSMFWl","merged":2,"otherRefs":["إرواء الغليل 2017 (صحيح)"]},{"id":"س-08039","fp":"3239db8d7b98","stateId":586,"easy":"إذا ظلمت شبراً من الأرض ← يكلفك الله أن تحفره حتى آخر سبع أرضين","cause":"أيُّما رجلٍ ظَلَمَ شِبْرًا مِنَ الأرضِ","result":"كَلَّفَهُ اللهُ عزَّ وجلَّ أنْ يَحْفِرَهُ حتى يَبْلُغَ بهِ سبعَ أَرَضِينَ ، ثُمَّ يُطَوَّقُهُ يومَ القيامةِ حتى يُقْضَى بين الناسِ","explicit":true,"repOf":"س-08033","ref":"صحيح الترغيب 1868","text":[["أيُّما رجلٍ ظَلَمَ شِبْرًا مِنَ الأرضِ ؛ ",1],["كَلَّفَهُ اللهُ عزَّ وجلَّ أنْ يَحْفِرَهُ حتى يَبْلُغَ بهِ سبعَ أَرَضِينَ ، ثُمَّ يُطَوَّقُهُ يومَ القيامةِ حتى يُقْضَى بين الناسِ ",2],"."],"grade":"صحيح","narrator":"يعلى بن مرة الثقفي","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17571)، وعبد بن حميد (407)، والخرائطي في ((مساوئ الأخلاق)) (633)، وابن حبان (2830)، والطبراني (22/ 270) (692) واللفظ لهم.","bab":"مظالم › تحريم الظلم","dorar":"UzpTBmlX","merged":2,"otherRefs":["الترغيب والترهيب 3/72 (صحيح)"]},{"id":"س-00460","fp":"255a7ad180cd","stateId":586,"easy":"إذا قتلت عصفوراً بغير حق ← يسألك الله عنه يوم القيامة","cause":"مَن قتلَ عصفورًا بغير حقٍ","result":"سألَهُ اللَّهُ عنهُ يومَ القيامةِ قيلَ يا رسولَ اللَّهِ وما حقُّهُ","explicit":true,"repOf":"س-07195","ref":"تخريج المسند لشاكر 10/59","text":[["مَن قتلَ عصفورًا بغير حقٍ ",1],["سألَهُ اللَّهُ عنهُ يومَ القيامةِ قيلَ يا رسولَ اللَّهِ وما حقُّهُ",2]," قالَ يَذبحُهُ ذبحًا ولا يأخذُ بعنقِهِ فيقطعُهُ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (4445)، وأحمد (6551) واللفظ له","bab":"آداب عامة › الرفق بالحيوان والطير ونحوهما","dorar":"69sqffgZ"},{"id":"س-01698","fp":"3518f8f79362","stateId":586,"easy":"إذا قضيت بجور ← ففي النار","cause":"ورجلٌ قضى بجورٍ","result":"فَفِي النارِ","explicit":true,"repOf":"س-03042","ref":"مجمع الزوائد 4/198","text":["القضاةُ ثلاثةٌ فرجلٌ قَضَى فَاجْتَهَدَ فأصابَ فلَهُ الجنةُ ورجلٌ قضى فاجْتَهَدَ فَأَخْطَأَ فله الجنةُ ",["ورجلٌ قضى بجورٍ",1]," ",["فَفِي النارِ",2]],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أبو داود (3573)، والترمذي (1322)، وابن ماجه (2315)، والنسائي في ((السنن الكبرى)) (5922) بنحوه مطولاً، والطبراني في ((المعجم الأوسط)) (3616) واللفظ له.","bab":"أقضية وأحكام › الحكم بالكتاب والسنة ثم باجتهاد الحاكم، والخطأ معذور","dorar":"ueK5IqIo"},{"id":"س-02854","fp":"b5e61b50c185","stateId":586,"easy":"إذا قضيت بغير الحق وأنت تعلم ← ففي النار","cause":"رجلٌ قضى بغيرِ الحقِّ فعلِمَ ذاكَ","result":"فذاكَ في النَّارِ","explicit":true,"repOf":"س-03042","ref":"صحيح الترمذي 1322","text":["القُضاةُ ثلاثةٌ : قاضيانِ في النَّارِ ، وقاضٍ في الجنَّةِ : ",["رجلٌ قضى بغيرِ الحقِّ فعلِمَ ذاكَ",1]," ",["فذاكَ في النَّارِ",2]," ، وقاضٍ لا يعلَمُ ، فأَهلَكَ حقوقَ النَّاسِ فَهُوَ في النَّارِ ، وقاضٍ قضى بالحقِّ فذلِك في الجنَّةِ"],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3573)، والترمذي (1322) واللفظ له، وابن ماجه (2315)، والنسائي في ((السنن الكبرى)) (5922).","bab":"إيمان › الوعد","dorar":"wC73r4Us"},{"id":"س-02858","fp":"6ea621682c24","stateId":586,"easy":"إذا قضيت بغير ما أمر الله ← ففي النار","cause":"وقاضٍ قضَى بغيرِ ما أمَرَ اللهُ به","result":"فهو في النارِ","explicit":true,"repOf":"س-03042","ref":"تخريج الإحياء للعراقي 1/93","text":["القضاةُ ثلاثةٌ: قاضٍ قضَى بالحقِّ وهو يعلمُ؛ فذلك في الجنَّةِ, وقاضٍ قضى بالجَوْرِ وهو يعلمُ أو لا يعلمُ؛ فهو في النارِ, ",["وقاضٍ قضَى بغيرِ ما أمَرَ اللهُ به",1],"؛ ",["فهو في النارِ",2],"."],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3573)، والترمذي (1322)، وابن ماجه (2315)، والنسائي في ((السنن الكبرى)) (5922) مطولاً.","bab":"إيمان › الوعد","dorar":"214Y1nIN"},{"id":"س-02928","fp":"013383ae5fc8","stateId":586,"easy":"إذا كانت لك امرأتان فلم تعدل بينهما ← تأتي يوم القيامة وشقك مائل","cause":"إذا كانت عندَ الرجلِ امرأتانِ ، فلم يعدلْ بينَهما","result":"جاء يومَ القيامةِ وشقُّه مائلٌ أو ساقطٌ","explicit":true,"ref":"البدر المنير 8/37","srcLabel":"الترمذي","text":[["إذا كانت عندَ الرجلِ امرأتانِ ، فلم يعدلْ بينَهما ، ",1],["جاء يومَ القيامةِ وشقُّه مائلٌ أو ساقطٌ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1141)، والحاكم (2759)","bab":"إيمان › الوعيد","dorar":"nYHKAhrY"},{"id":"س-03004","fp":"206f3969bcd0","stateId":586,"easy":"إذا سمّعت يهودياً أو نصرانياً (بالأذى) ← دخلت النار","cause":"مَن سمَّع يهوديًّا أو نصرانيًّا","result":"دخَل النَّارَ","explicit":true,"ref":"تخريج صحيح ابن حبان 4880","srcLabel":"النسائي","text":[["مَن سمَّع يهوديًّا أو نصرانيًّا ",1],["دخَل النَّارَ",2]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح على شرطهما. [ثم نبه الشيخ على أن هذه الرواية مختصرة ومحرفة ]","takhrij":"أخرجه ابن حبان (2941) واللفظ له، وأحمد (19536)، والنسائي في ((السنن الكبرى)) (11177)، والروياني في ((المسند)) (526) بنحوه.","bab":"إيمان › الوعيد","dorar":"rJse3WG7"},{"id":"س-03034","fp":"346364590016","stateId":586,"easy":"إذا وليت شيئاً من أمور الأمة فلم تعدل ← يكبك الله في النار","cause":"ما مِن أحَدٍ يكونُ على شَيءٍ مِن أمورِ هذِه الأُمَّةِ، قَلَّتْ أَمْ كَثُرَتْ، فلا يَعْدِلُ فيهِمْ","result":"إلَّا أكَبَّهُ اللهُ في النَّارِ","explicit":true,"repOf":"س-07272","ref":"المستدرك على الصحيحين 7209","text":[["ما مِن أحَدٍ يكونُ على شَيءٍ مِن أمورِ هذِه الأُمَّةِ، قَلَّتْ أَمْ كَثُرَتْ، فلا يَعْدِلُ فيهِمْ؛",1]," ",["إلَّا أكَبَّهُ اللهُ في النَّارِ",2],"."],"grade":"صحيح","narrator":"والد أم معقل","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني (20/ 221) (514)، وابن أبي شيبة  (37722) كلاهما باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"XjU2UfIg"},{"id":"س-03049","fp":"10afbbb4369c","stateId":586,"easy":"إذا أُمّرت على عشرة فأكثر فلم تقسط فيهم ← تأتي يوم القيامة في الأصفاد","cause":"ما مِن أحَدٍ يُؤَمَّرُ على عَشَرةٍ فصاعِدًا لا يُقْسِطُ فيهم","result":"إلَّا جاءَ يومَ القِيامةِ في الأصفادِ والأغْلالِ","explicit":true,"ref":"المستدرك على الصحيحين 7204","srcLabel":"أحمد","text":[["ما مِن أحَدٍ يُؤَمَّرُ على عَشَرةٍ فصاعِدًا لا يُقْسِطُ فيهم؛",1]," ",["إلَّا جاءَ يومَ القِيامةِ في الأصفادِ والأغْلالِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (9573)، والدارمي (2557)، والطبراني في ((المعجم الأوسط)) (272) بنحوه","bab":"إيمان › الوعيد","dorar":"eZhsgbnr"},{"id":"س-03091","fp":"be5b0103e10d","stateId":586,"easy":"إذا جرت في الحكم متعمداً ← ففي النار","cause":"فرجُلٌ جارَ متعمِّدًا","result":"فهو في النارِ","explicit":true,"ref":"تخريج شرح السنة 2497","srcLabel":"البيهقي","text":["قال عليٌّ رَضِي اللهُ عنه: القضاةُ ثلاثةٌ: قاضيانِ في النارِ، وقاضٍ في الجنَّةِ، فأمَّا اللذانِ في النارِ، ",["فرجُلٌ جارَ متعمِّدًا",1],"، ",["فهو في النارِ",2],"، ورجُلٌ اجتهَد فأخطأ، فهو في النارِ، وأمَّا الذي في الجنَّةِ، فرجُلٌ اجتهَد فأصاب الحقَّ، فهو في الجنَّةِ.\nقال قتادةُ: فقُلْتُ لأبي العاليةِ: ما ذَنْبُ هذا الذي اجتهَد فأخطأ؟ قال: ذَنْبُهُ أن لا يكونَ قاضيًا إذ لم يَعلَمْ."],"grade":"صحيح","narrator":"أبو العالية","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن الجعد (989)، والطحاوي في ((شرح السنة)) (2498) كلاهما بلفظه، والبيهقي (20383) بنحوه.","bab":"إيمان › الوعيد","dorar":"G5dammmW"},{"id":"س-03092","fp":"88e3d4f2857c","stateId":586,"easy":"إذا اجتهدت فأخطأت (وأنت جاهل) ← ففي النار","cause":"ورجُلٌ اجتهَد فأخطأ","result":"فهو في النارِ","explicit":true,"ref":"تخريج شرح السنة 2497","srcLabel":"البيهقي","text":["قال عليٌّ رَضِي اللهُ عنه: القضاةُ ثلاثةٌ: قاضيانِ في النارِ، وقاضٍ في الجنَّةِ، فأمَّا اللذانِ في النارِ، فرجُلٌ جارَ متعمِّدًا، فهو في النارِ، ",["ورجُلٌ اجتهَد فأخطأ",1],"، ",["فهو في النارِ",2],"، وأمَّا الذي في الجنَّةِ، فرجُلٌ اجتهَد فأصاب الحقَّ، فهو في الجنَّةِ.\nقال قتادةُ: فقُلْتُ لأبي العاليةِ: ما ذَنْبُ هذا الذي اجتهَد فأخطأ؟ قال: ذَنْبُهُ أن لا يكونَ قاضيًا إذ لم يَعلَمْ."],"grade":"صحيح","narrator":"أبو العالية","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن الجعد (989)، والطحاوي في ((شرح السنة)) (2498) كلاهما بلفظه، والبيهقي (20383) بنحوه.","bab":"إيمان › الوعيد","dorar":"G5dammmW"},{"id":"س-03921","fp":"3b17542b4c49","stateId":586,"easy":"إذا أضررت في الوصية ← تجب لك النار","cause":"فيُضارَّانِ في الوَصيَّةِ","result":"فتَجِبُ لهما النَّارُ","explicit":true,"ref":"الأحكام الوسطى 3/ 322","srcLabel":"أبو داود","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قالَ: \"إنَّ الرَّجُلَ والمَرْأةَ لَيَعمَلان بطاعةِ اللهِ سِتَّينَ سَنَةً ثُمَّ يَحضُرُهما المَوْتُ ",["فيُضارَّانِ في الوَصيَّةِ",1],"، ",["فتَجِبُ لهما النَّارُ",2],"\"، قالَ: قَرَأَ علَيَّ أبو هُرَيرةَ مِن هاهنا: {مِنْ بَعْدِ وَصِيَّةٍ يُوصَي بِهَا أَوْ دَيْنٍ غَيْرَ مُضَارٍّ...} حتَّى بَلَغَ: {وَذَلِكَ الْفَوْزُ الْعَظِيمُ}."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (2867)، والترمذي (2117)، والبيهقي (12711) بلفظه.","bab":"تفسير آيات › سورة النساء","dorar":"rfI8H6MP"},{"id":"س-04185","fp":"d0e929934bcd","stateId":586,"easy":"إذا وليت شيئاً من أمور المسلمين فغششتهم ← ففي النار","cause":"من وَلِيَ من أمورِ المسلمين شيئًا ، فغشَّهم","result":"فهو في النَّارِ","explicit":true,"ref":"صحيح الترغيب 2206","srcLabel":"الطبراني","text":[["من وَلِيَ من أمورِ المسلمين شيئًا ، فغشَّهم ؛ ",1],["فهو في النَّارِ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (3481)، وفي ((المعجم الصغير)) (392) باختلاف يسير.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"fneIy5cf"},{"id":"س-04810","fp":"d7f5e5f7ee7f","stateId":586,"easy":"إذا ظلمت معاهداً أو انتقصته أو كلفته فوق طاقته أو أخذت منه بغير طيب نفس ← فالنبي ﷺ حجيجك يوم القيامة","cause":"مَن ظلَمَ مُعَاهَدًا ، أو انْتَقَصَهُ حَقَّهُ ، أو كَلَّفَهُ فَوقَ طاقَتِه ، أو أخَذَ مِنهُ شيئًا بِغيرِ طِيبِ نَفْسٍ مِنهُ","result":"فأنَا حَجِيجُهُ يَومَ القِيامةِ","explicit":true,"ref":"صحيح الجامع 2655","srcLabel":"أبو داود","text":["ألا ",["مَن ظلَمَ مُعَاهَدًا ، أو انْتَقَصَهُ حَقَّهُ ، أو كَلَّفَهُ فَوقَ طاقَتِه ، أو أخَذَ مِنهُ شيئًا بِغيرِ طِيبِ نَفْسٍ مِنهُ",1]," ، ",["فأنَا حَجِيجُهُ يَومَ القِيامةِ",2]],"grade":"صحيح","narrator":"عدة آباء من أصحاب النبي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3052)، وابن زنجويه في ((الأموال)) (621)، والبيهقي (18765) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"0qY788Cc"},{"id":"س-04815","fp":"f73a927ebbc2","stateId":586,"easy":"إذا سرّك أن يقوم لك بنو آدم ← وجبت لك النار","cause":"من سرَّهُ أن يقومَ له بنو آدمَ","result":"وجبتْ له النَّارُ","explicit":true,"ref":"السلسلة الصحيحة 1/695","srcLabel":"أبو داود","text":["خرج معاويةُ فرآهم قيامًا لخروجِه فقال لهم : اجلِسوا فإنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ قال : ",["من سرَّهُ أن يقومَ له بنو آدمَ ",1],["وجبتْ له النَّارُ",2]],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"إسناده صحيح","takhrij":"أخرجه المخلص في ((المخلصيات)) (2955) واللفظ له، وأخرجه أبو داود (5229)، والترمذي (2755) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"SX1tqgVz"},{"id":"س-04920","fp":"ea82fc09b0c1","stateId":586,"easy":"إذا مثّلت بذي الروح ثم لم تتب ← يمثل الله بك يوم القيامة","cause":"مَن مَثَّلَ بِذي الرُّوحِ، ثُمَّ لم يَتُبْ","result":"مَثَّلَ اللهُ به يَومَ القيامَةِ","explicit":true,"ref":"تخريج المسند لشعيب 5956","srcLabel":"أحمد","text":["عن رَجُلٍ من أصْحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ أُراهُ ابنَ عُمَرَ، قال: سَمِعتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن مَثَّلَ بِذي الرُّوحِ، ثُمَّ لم يَتُبْ",1]," ",["مَثَّلَ اللهُ به يَومَ القيامَةِ",2],"، قال حُسَينٌ: مَن مَثَّلَ بِذي رُوحٍ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (5956)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"YprZUoAR"},{"id":"س-04930","fp":"18d77da12b6c","stateId":586,"easy":"إذا وليت أمر عشرة فما فوق ← تأتي الله مغلولاً يوم القيامة لا يفكك إلا العدل","cause":"ما مِن رَجُلٍ يَلي أمْرَ عَشَرةٍ فما فوقَ ذلك","result":"إلَّا أتى اللهَ مَغلولًا يومَ القيامةِ يدُه إلى عُنُقِه؛ فَكَّه بِرُّه، أو أَوبَقَه إثمُه، أوَّلُها مَلامةٌ، وأَوسطُها نَدامةٌ، وآخِرُها خِزيٌ يومَ القيامةِ","explicit":true,"ref":"تخريج المسند لشعيب 22300","srcLabel":"أحمد","text":[["ما مِن رَجُلٍ يَلي أمْرَ عَشَرةٍ فما فوقَ ذلك،",1]," ",["إلَّا أتى اللهَ مَغلولًا يومَ القيامةِ يدُه إلى عُنُقِه؛ فَكَّه بِرُّه، أو أَوبَقَه إثمُه، أوَّلُها مَلامةٌ، وأَوسطُها نَدامةٌ، وآخِرُها خِزيٌ يومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (22300) واللفظ له، والحارث (599)، والطبراني (8/202) (7720)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"aAglTVrg"},{"id":"س-04948","fp":"a5221c91a049","stateId":586,"easy":"إذا كنت في قوم يُعمل فيهم بالمعاصي ويقدرون على التغيير فلم يغيروا ← يصيبهم الله بعقاب قبل أن يموتوا","cause":"ما من رجُلٍ يكونُ في قومٍ يُعمَلُ فيهم بالمعاصي يقدِرونَ على أنْ يُغيِّروا عليه، فلا يُغيِّروا","result":"إلَّا أصابَهم اللهُ بعذابٍ من قبلِ أنْ يموتوا","explicit":true,"ref":"تخريج سنن أبي داود 4339","srcLabel":"أبو داود","text":[["ما من رجُلٍ يكونُ في قومٍ يُعمَلُ فيهم بالمعاصي يقدِرونَ على أنْ يُغيِّروا عليه، فلا يُغيِّروا",1]," ",["إلَّا أصابَهم اللهُ بعذابٍ من قبلِ أنْ يموتوا",2],"."],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (4339)، ابن حبان (300)، والطبراني (2/ 332) (2382) بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"yl3xomfN"},{"id":"س-04992","fp":"26dfb6b73c11","stateId":586,"easy":"إذا كنت أمير عشيرة ← تؤتى يوم القيامة مغلولة يداك إلى عنقك أطلقك العدل أو أوبقك الجور","cause":"أميرِ عشيرة","result":"إلَّا يُؤتَى بِهِ يومَ القيامةِ ، مَغلولةٌ يداهُ إلى عنُقِهِ ، أطلقَهُ الحقُّ أو أوبقَهُ","explicit":true,"ref":"الصحيح المسند 1395","srcLabel":"أحمد","text":["ما من ",["أميرِ عشيرة",1],"، ",["إلَّا يُؤتَى بِهِ يومَ القيامةِ ، مَغلولةٌ يداهُ إلى عنُقِهِ ، أطلقَهُ الحقُّ أو أوبقَهُ",2]," ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (9573)، والدارمي (2515) واللفظ له، والبزار (8492)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"vfgdItzi"},{"id":"س-05026","fp":"4b279d3b6452","stateId":586,"easy":"إذا أخفرت ذمة النبي ﷺ ← يكون خصمك ومن خاصمه خصمه","cause":"مَن يُخْفِرْ ذِمَّتِي","result":"كنتُ خَصْمَه ، ومَن خاصَمْتُه خَصَمْتُه","explicit":true,"otherNeedIds":[27],"ref":"صحيح الجامع 6607","srcLabel":"الطبراني","text":[["مَن يُخْفِرْ ذِمَّتِي",1]," ",["كنتُ خَصْمَه ، ومَن خاصَمْتُه خَصَمْتُه",2]],"grade":"صحيح","narrator":"جندب بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (1668) (2/ 162)، وابن مردويه في ((جزء فيه أحاديث ابن حيان)) (96) واللفظ لهما.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"grqVIRlS"},{"id":"س-05037","fp":"e9919b049b6f","stateId":586,"easy":"إذا طلبك الله من ذمته بشيء (بإخفارها) ← يدركك ثم يكبك على وجهك في جهنم","cause":"مَن يَطلُبْه مِن ذِمَّتِه بشيءٍ","result":"يُدرِكْه، ثُمَّ يَكُبَّه على وجهِه في نارِ جَهَنَّمَ","explicit":true,"ref":"صحيح مسلم 657","srcLabel":"أحمد","text":["مَن صَلَّى صَلاةَ الصُّبحِ فهو في ذِمَّةِ اللهِ، فلا يَطلُبَنَّكُمُ اللهُ مِن ذِمَّتِه بشيءٍ؛ فإنَّه ",["مَن يَطلُبْه مِن ذِمَّتِه بشيءٍ",1]," ",["يُدرِكْه، ثُمَّ يَكُبَّه على وجهِه في نارِ جَهَنَّمَ",2],"."],"grade":"صحيح","narrator":"جندب بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (1683) (2/ 166)، والروياني (955) باختلاف يسير، وأحمد (18814) مختصرًا.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"v64OngYp"},{"id":"س-05178","fp":"e588224eb165","stateId":586,"easy":"إذا أدركت الفتن فلم تتقِ الله ولم تأمر بالمعروف وكذبت على النبي ﷺ ← فتبوأ مقعدك من النار","cause":"فمن أدرك ذلك مِنْكم فلْيَتَّقِ اللهَ ولْيَأمُرْ بالمعروفِ ولْيَنْهَ عن المنكَرِ، ومَن كَذَب عَلَيَّ مُتعَمِّدًا","result":"فلْيتبَوَّأْ مَقعَدَه مِنَ النَّارِ","explicit":true,"ref":"تخريج المسند لشاكر 5/257","srcLabel":"الترمذي","text":["جمَعَنا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم ونحن أربَعونَ، قال عبدُ اللهِ: فكُنتُ مِن آخِرِ مَن أتاه فقال: إنَّكم مُصيِبون ومَنصورون ومفتوحٌ لكم، ",["فمن أدرك ذلك مِنْكم فلْيَتَّقِ اللهَ ولْيَأمُرْ بالمعروفِ ولْيَنْهَ عن المنكَرِ، ومَن كَذَب عَلَيَّ مُتعَمِّدًا ",1],["فلْيتبَوَّأْ مَقعَدَه مِنَ النَّارِ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (2257) باختلاف يسير، وابن ماجه (30) مختصراً","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"9ptYiwKC"},{"id":"س-06229","fp":"4cc728788588","stateId":586,"easy":"إذا وليت ثلاثة ← تلقى الله مغلولة يمينك: يفكها عدلك أو يغلها جورك","cause":"ما مِن والي ثلاثةٍ","result":"إلَّا لقي اللهَ مغلولةً يمينُه: فكَّه عدلُه أو غلَّه جَورُه","explicit":true,"ref":"صحيح ابن حبان 4525","srcLabel":"الطبراني","text":["بَيْنا أبو الدَّرداءِ يومًا يسيرُ شاذًّا مِن الجيشِ إذ لقيه رجلانِ شاذَّانِ مِن الجيشِ فقال: يا هذانِ إنَّه لم يكُنْ ثلاثةٌ في مِثْلِ هذا المكانِ إلَّا أمَّروا عليهم فلْيتأمَّرْ أحدُكم قالا: أنتَ يا أبا الدَّرداءِ قال: بل أنتما، سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( ",["ما مِن والي ثلاثةٍ",1]," ",["إلَّا لقي اللهَ مغلولةً يمينُه: فكَّه عدلُه أو غلَّه جَورُه )",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الطبراني في ((الشاميين)) (316)، وابن عساكر في ((تاريخ دمشق)) (46/ 312) واللفظ لهما.","bab":"سرايا › تأمير الأمراء على البعوث والسرايا ووصيتهم","dorar":"ImA3xA0m"},{"id":"س-06566","fp":"9a91836a9ca1","stateId":586,"easy":"إذا أخفرت ذمة الله ← يكبك الله في النار لوجهك","cause":"فمن أخفرَ ذمَّةَ اللَّهِ","result":"كبَّهُ اللَّهُ في النَّارِ لوجهه","explicit":true,"ref":"مجمع الزوائد 2/44","srcLabel":"الطبراني","text":["من صلَّى الصُّبحَ في جماعةٍ فهوَ في ذمَّةِ اللَّهِ ",["فمن أخفرَ ذمَّةَ اللَّهِ ",1],["كبَّهُ اللَّهُ في النَّارِ لوجهه",2]],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني كما في ((مجمع الزوائد)) للهيثمي (1646)، والدارقطني في ((العلل)) (1274) واللفظ لهما، والبزار (‌3616) بنحوه مطولا.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"7SqYWwUp"},{"id":"س-06610","fp":"8c88dd51ae74","stateId":586,"easy":"إذا أخفرت ذمة الله ← يطلبك حتى يكبك على وجهك","cause":"من أخفَر ذِمَّتَه","result":"طلبه اللهُ تبارك و تعالى ، حتى يُكبَّه على وجهِه","explicit":true,"ref":"صحيح الترغيب 462","srcLabel":"أحمد","text":["من صلَّى الصبحَ فهو في ذِمَّةِ اللهِ تبارك و تعالى ، فلا تُخفِروا اللهَ تبارك و تعالى في ذِمَّتِه ، فإنه ",["من أخفَر ذِمَّتَه ",1],["طلبه اللهُ تبارك و تعالى ، حتى يُكبَّه على وجهِه",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (5898)، والبزار (5988) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (8548) مختصراً","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"sECvm2kY"},{"id":"س-07403","fp":"5ef57b053f93","stateId":586,"easy":"إذا سألك ذو رحمك فضلاً فبخلت عليه ← يخرج الله لك من جهنم حية تتلمظ","cause":"ما من ذي رحمٍ يأتي ذا رَحِمَهِ فيسألُه فَضلًا أعطاه اللهُ إياه فيبخلُ علَيهِ","result":"إلَّا أخرج اللهُ لهُ من جهنَّمَ حيَّةً يُقال : لها ( شُجاعٌ ) يَتلمَّظُ ، فيطوَّقُ بهِ","explicit":true,"ref":"صحيح الترغيب 896","srcLabel":"الطبراني","text":[["ما من ذي رحمٍ يأتي ذا رَحِمَهِ فيسألُه فَضلًا أعطاه اللهُ إياه فيبخلُ علَيهِ",1]," ، ",["إلَّا أخرج اللهُ لهُ من جهنَّمَ حيَّةً يُقال : لها ( شُجاعٌ ) يَتلمَّظُ ، فيطوَّقُ بهِ",2]],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"حسن صحيح","takhrij":"أخرجه الطبراني (2/ 322) (2343) واللفظ له.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"v8ZFsGkl"},{"id":"س-07404","fp":"4e8dbbf1ea42","stateId":586,"easy":"إذا ظلمت ولو شاة ← لتُختصمن يوم القيامة حتى الشاتان فيما انتطحتا","cause":"حتَّى الشَّاتانِ فيما انْتطَحَتا","result":"لَيختصمَنَّ كلُّ شَيءٍ يومَ القيامةِ","explicit":true,"ref":"صحيح الترغيب 3604","srcLabel":"أحمد","text":[["لَيختصمَنَّ كلُّ شَيءٍ يومَ القيامةِ",2]," ، ",["حتَّى الشَّاتانِ فيما انْتطَحَتا",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (9072)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"PCBvO8wp"},{"id":"س-07437","fp":"1dd8dd5092d6","stateId":586,"easy":"إذا حكمت بين الناس ← تُبعث يوم القيامة وملك آخذ بقفاك","cause":"ما من حاكِمٍ يَحكُمُ بيْنَ النَّاسِ","result":"ويُبعَثُ يَومَ القيامةِ ومَلَكٌ آخِذٌ بقَفاهُ","explicit":true,"similar":["س-08205"],"ref":"تخريج سنن الدارقطني 4465","srcLabel":"ابن ماجه","text":[["ما من حاكِمٍ يَحكُمُ بيْنَ النَّاسِ",1]," إلَّا ",["ويُبعَثُ يَومَ القيامةِ ومَلَكٌ آخِذٌ بقَفاهُ",2]," حتى يُوقِفَه على شَفيرِ جَهنَّمَ، ثُمَّ يَلتَفِتُ إلى اللهِ مُغضبًا، فإنْ قال: ألْقِه، ألْقاهُ في المَهْوى أربَعينَ خَريفًا."],"grade":"صحيح","narrator":"عبدالله","muhaddith":"صحيح","takhrij":"أخرجه الدارقطني (4465) بلفظه، وابن ماجه (2311)، وأحمد (4097) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"XoDOjOQF"},{"id":"س-07674","fp":"0945638ac2b8","stateId":586,"easy":"إذا خلعت البيعة بعد عقدها في عنقك ← تلقى الله وليست لك حجة","cause":"فإنْ خلَعَها مِن بَعدِ عَقْدِها في عُنُقِه","result":"لَقيَ اللهَ تبارَك وتعالَى وليستْ له حُجَّةٌ","explicit":true,"ref":"تخريج المسند لشعيب 15696","srcLabel":"أحمد","text":["مَن مات وليست عليه طاعةٌ، مات مِيتةً جاهليَّةً، ",["فإنْ خلَعَها مِن بَعدِ عَقْدِها في عُنُقِه",1],"، ",["لَقيَ اللهَ تبارَك وتعالَى وليستْ له حُجَّةٌ",2],".\n ألَا لا يَخْلُوَنَّ رجُلٌ بامرأةٍ لا تَحِلُّ له؛ فإنَّ ثالثَهما الشَّيطانُ، إلَّا مَحْرَمٌ؛ فإنَّ الشَّيطانَ مع الواحدِ، وهو مِنَ الاثنَينِ أَبْعَدُ.\n مَن ساءَتْهُ سَيِّئتُه، وسَرَّتْهُ حسَنتُه فهو مؤْمِنٌ. قال حُسَينٌ: بعْدَ عَقْدِه إيَّاها في عُنُقِه."],"grade":"صحيح","narrator":"عامر بن ربيعة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (15696) واللفظ له، والروياني في ((المسند)) (1341)، والضياء في ((الأحاديث المختارة)) (230)","bab":"قدر › العمل بالخواتيم","dorar":"dR5FfB9U"},{"id":"س-07846","fp":"f3c65ef75a89","stateId":586,"easy":"إذا خلفت مجاهداً في أهله فخنته ← توقف يوم القيامة فيأخذ من حسناتك ما شاء","cause":"وما مِن رَجُلٍ مِنَ القاعِدينَ يَخلُفُ رَجُلًا مِنَ المُجاهِدينَ في أهلِه فيَخونُه فيهم","result":"إلَّا وُقِفَ له يَومَ القيامةِ، فيَأخُذُ مِن عَمَلِه ما شاءَ","explicit":true,"repOf":"س-04937","otherNeedIds":[45],"ref":"صحيح مسلم 1897","text":["حُرمةُ نِساءِ المُجاهِدينَ على القاعِدينَ كَحُرمةِ أُمَّهاتِهم، ",["وما مِن رَجُلٍ مِنَ القاعِدينَ يَخلُفُ رَجُلًا مِنَ المُجاهِدينَ في أهلِه فيَخونُه فيهم",1],"، ",["إلَّا وُقِفَ له يَومَ القيامةِ، فيَأخُذُ مِن عَمَلِه ما شاءَ",2],"، فما ظَنُّكُم؟ وفي روايةٍ: فخُذْ مِن حَسَناتِه ما شِئتَ، فالتَفَتَ إلَينا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: فما ظَنُّكُم؟"],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"[صحيح]","takhrij":"أخرجه أبو داود (2496)، والنسائي (3189)، وأحمد (23004) واللفظ لهم جميعا","bab":"قيامة › الحساب والقصاص","dorar":"pISHNWcX"},{"id":"س-07847","fp":"a76a49970562","stateId":586,"easy":"إذا وليت عشرة ← تُؤتى يوم القيامة مغلولة يدك إلى عنقك","cause":"ما من رجلٍ ولِيَ عشرَةً","result":"إلَّا أُتِيَ بهِ يومَ القيامةِ مَغْلولَةٌ يَدُهُ إلى عُنُقِهِ ، حتى يُقْضَى بينَهُ وبينَهُمْ","explicit":true,"ref":"صحيح الترغيب 2201","srcLabel":"الطبراني","text":[["ما من رجلٍ ولِيَ عشرَةً ؛",1]," ",["إلَّا أُتِيَ بهِ يومَ القيامةِ مَغْلولَةٌ يَدُهُ إلى عُنُقِهِ ، حتى يُقْضَى بينَهُ وبينَهُمْ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"حسن صحيح","takhrij":"أخرجه الطبراني (12/135) (12689)","bab":"قيامة › الحساب والقصاص","dorar":"A445kjhl"},{"id":"س-07850","fp":"0017a9bfa6de","stateId":586,"easy":"إذا ذبحت عصفوراً أو قتلته في غير شيء ← يسألك الله عنه يوم القيامة","cause":"مَن ذبحَ عصفورًا أو قتلَهُ في غيرِ شيءٍ","result":"سألَهُ اللَّهُ عنهُ يومَ القيامةِ","explicit":true,"ref":"تخريج المسند لشاكر 10/59","srcLabel":"النسائي","text":[["مَن ذبحَ عصفورًا أو قتلَهُ في غيرِ شيءٍ",1]," قالَ عَمرٌو أحسبُهُ قالَ إلَّا بحقِّهِ ",["سألَهُ اللَّهُ عنهُ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (4445)، وأحمد (6550) واللفظ له","bab":"قيامة › الحساب والقصاص","dorar":"MD7F0RbO"},{"id":"س-07857","fp":"8012f048157b","stateId":586,"easy":"إذا استرعاك الله رعية ← يسألك عنها يوم القيامة","cause":"لا يَستَرعي اللهُ تَبارك وتَعالى عبدًا رعيَّةً، قَلَّتْ أو كَثُرَتْ","result":"إلَّا سَأَلَه اللهُ تَبارك وتَعالى عنها يَومَ القيامَةِ، أقامَ فيهم أمْرَ اللهِ تَبارك وتَعالى أم أضاعَه؟ حتى يَسأَلَه عن أهْلِ بَيتِه خاصَّةً","explicit":true,"ref":"تخريج المسند لشعيب 4637","srcLabel":"أحمد","text":[["لا يَستَرعي اللهُ تَبارك وتَعالى عبدًا رعيَّةً، قَلَّتْ أو كَثُرَتْ",1],"، ",["إلَّا سَأَلَه اللهُ تَبارك وتَعالى عنها يَومَ القيامَةِ، أقامَ فيهم أمْرَ اللهِ تَبارك وتَعالى أم أضاعَه؟ حتى يَسأَلَه عن أهْلِ بَيتِه خاصَّةً",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (4637)، وابن أبي الدنيا في ((النفقة على العيال)) (325)، وتمام في ((الفوائد)) (1757)","bab":"قيامة › الحساب والقصاص","dorar":"C1LC1L6j"},{"id":"س-07986","fp":"04afafbc9e23","stateId":586,"easy":"إذا ضربت عبداً لك ظالماً له ← يُقاد منك يوم القيامة","cause":"لا يضربُ أحدٌ عبدًا له وهو ظالمٌ له","result":"إلا أُقِيدَ منه يومَ القيامةِ","explicit":true,"similar":["س-08031","س-08076"],"ref":"صحيح الأدب المفرد 134","srcLabel":"البخاري (الأدب المفرد)","text":["عن عمار بنِ ياسرٍ قال ",["لا يضربُ أحدٌ عبدًا له وهو ظالمٌ له",1]," ",["إلا أُقِيدَ منه يومَ القيامةِ",2]],"grade":"صحيح","muhaddith":"صحيح الإسناد","bab":"مظالم › تحريم الظلم","dorar":"DxjH6pkQ"},{"id":"س-08018","fp":"3709a4a16081","stateId":586,"easy":"إذا كنت من أهل الجور أو أعوانهم ← فأنت في النار","cause":"أهْلُ الجَوْرِ وأعوانُهم","result":"في النَّارِ","explicit":true,"ref":"المستدرك على الصحيحين 7202","srcLabel":"العقيلي","text":[["أهْلُ الجَوْرِ وأعوانُهم",1]," ",["في النَّارِ",2],"."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح الإسناد","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (4/ 203) بلفظه.","bab":"مظالم › تحريم الظلم","dorar":"2GfrJNMz"},{"id":"س-08031","fp":"08220b1cdc65","stateId":586,"easy":"إذا ضربت مملوكك ظالماً ← يُقاد منك يوم القيامة","cause":"من ضرب مملوكَه ظالمًا","result":"أُقِيدَ منه يومَ القيامةِ","explicit":true,"repOf":"س-07986","ref":"صحيح الجامع 6376","text":[["من ضرب مملوكَه ظالمًا ، ",1],["أُقِيدَ منه يومَ القيامةِ",2]],"grade":"صحيح","narrator":"عمار بن ياسر","muhaddith":"صحيح","takhrij":"أخرجه الطبراني كما في ((الترغيب والترهيب)) للمنذري (3/148)، وأبو نعيم في ((حلية الأولياء)) (4/378) واللفظ له","bab":"مظالم › تحريم الظلم","dorar":"3xPbiWUY"},{"id":"س-08032","fp":"5e0bb5f8ae85","stateId":586,"easy":"إذا ضربت مملوكك سوطاً ظلماً ← يُقتص منك يوم القيامة","cause":"من ضرب مملوكَه سوطًا ظُلمًا","result":"اقتُصَّ منه يومَ القيامةِ","explicit":true,"similar":["س-07989"],"ref":"صحيح الترغيب 3607","srcLabel":"الطبراني","text":[["من ضرب مملوكَه سوطًا ظُلمًا ",1],["اقتُصَّ منه يومَ القيامةِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه البزار (9446)، والطبراني في ((المعجم الأوسط)) (1445)، وابن عدي في ((الكامل في الضعفاء)) (4/168) باختلاف يسير","bab":"مظالم › تحريم الظلم","dorar":"fSTzeeSD"},{"id":"س-08038","fp":"db7fffa54119","stateId":586,"easy":"إذا ظلمت ← تُمحى حسناتك يوم القيامة حتى لا تبقى لك حسنة","cause":"اتَّقوا الظُّلمَ ما استطعتُم","result":"فيقول : امْحُوا من حسناتِه . وما يزالُ كذلك حتى ما يَبْقى له حسنةٌ","explicit":true,"otherNeedIds":[45],"ref":"صحيح الترغيب 2221","srcLabel":"الحاكم","text":["إنَّ الشيطانَ قد يَئِسَ أن تُعبَدَ الأصنامُ في أرضِ العربِ ، ولكنه سَيرضى منكم بدونِ ذلك بالمحَقِّراتِ ، وهي الموبِقاتُ يومَ القيامةِ ، ",["اتَّقوا الظُّلمَ ما استطعتُم",1]," ؛ فإنَّ العبدَ يَجيءُ بالحسناتِ يومَ القيامةِ يَرى أنها ستُنْجِيه ، فمازالَ عبدٌ يقومُ يقول : يا ربِّ ظلَمَني عبدُك مَظلَمَةً . ",["فيقول : امْحُوا من حسناتِه . وما يزالُ كذلك حتى ما يَبْقى له حسنةٌ",2]," من الذُّنوبِ ، وإنَّ مَثَلَ ذلك كسَفْرٍ نزلوا بفلاةٍ من الأرضِ ليس معهم حطبٌ ، فتفرَّقُ القومُ ليحتَطِبوا فلم يَلْبَثوا أن حَطِبوا ، فأَعظَموا النَّارَ وطبَخوا ما أرادوا ، وكذلك الذُّنوبُ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو يعلى (5122)، والحاكم (2221)، والبيهقي في ((شعب الإيمان)) (7263) باختلاف يسير","bab":"مظالم › تحريم الظلم","dorar":"CJ5GF7rQ"},{"id":"س-08078","fp":"894fc0b61baf","stateId":586,"easy":"إذا اعتديت بعد (حد الله) ← فلك نار جهنم خالداً فيها","cause":"ومنِ اعتدى بعدَ ذلِكَ","result":"فلَهُ نارَ جَهَنَّمَ خالِدًا فيها","explicit":true,"ref":"عمدة التفسير 1/213","srcLabel":"أبو داود","text":["مَن أصيبَ بقتلٍ أو خَبَلٍ فإنَّهُ يختارُ إحدى ثلاثٍ : إمَّا أن يَقتصَّ ، وإمَّا أن يَعفوَ ، وإمَّا أن يأخذَ الدِّيةَ ، فإن أرادَ الرَّابعةَ فخُذوا على يديهِ ، ",["ومنِ اعتدى بعدَ ذلِكَ",1]," ",["فلَهُ نارَ جَهَنَّمَ خالِدًا فيها",2]],"grade":"صحيح","narrator":"أبو شريح العدوي خويلد بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4496)، وابن ماجه (2623)، وأحمد (16375)","bab":"مظالم › قصاص المظالم","dorar":"6uh9FbBq"},{"id":"س-04862","fp":"c6d145ea2ca7","stateId":586,"easy":"إذا كنت عريفاً (تتولى على قوم بلا عدل) ← فالعرفاء في النار","cause":"ولكنَّ العرفاءَ","result":"في النَّارِ","explicit":true,"ref":"هداية الرواة 3/466","srcLabel":"أبو داود","text":["إن العِرافة حقٌّ ولابد للنَّاسِ من عرفاءَ ",["ولكنَّ العرفاءَ",1]," ",["في النَّارِ",2]],"grade":"حسن","narrator":"جد رجل","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه أبو داود (2934)، والبيهقي (13180) واللفظ لهما في آخر حديث طويل، وابن أبي شيبة (27249) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ntjLX5zO","merged":3,"otherRefs":["السلسلة الصحيحة 1417 (حسن)","صحيح الجامع 7185 (حسن)"]},{"id":"س-05900","fp":"24afc2ed9d2a","stateId":586,"easy":"إذا خرجت من الجماعة واستذللت الإمارة ← تلقى الله ولا وجه لك عنده","cause":"مَن خَرَجَ مِن الجَماعةِ، واستَذَلَّ الإمارةَ","result":"لَقِيَ اللهَ ولا وَجْهَ له عندَه","explicit":true,"repOf":"س-05835","ref":"تخريج المسند لشعيب 23288","text":["عن رِبْعيٍّ، أنَّه أتَى حُذَيفةَ بنَ اليَمانِ بالمَدائِنِ يَزورهُ ويَزورُ أُختَه، قال: فقال حُذَيفةُ: ما فَعَلَ قَومُكَ يا رِبعيُّ؟ أخَرَجَ منهم أحَدٌ؟ قال: نَعَمْ، فسَمَّى نَفَرًا، وذلك في زَمَنِ خُروجِ النَّاسِ إلى عُثْمانَ، فقال حُذَيفةُ: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن خَرَجَ مِن الجَماعةِ، واستَذَلَّ الإمارةَ؛ ",1],["لَقِيَ اللهَ ولا وَجْهَ له عندَه",2],"."],"grade":"حسن","narrator":"حذيفة بن اليمان","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (23288) واللفظ له، والقضاعي في ((المسند)) (449)، والحاكم (410)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"zPU4BPhU","merged":2,"otherRefs":["تخريج المسند لشعيب 23452 (حسن)"]},{"id":"س-00465","fp":"a92aa8c407d3","stateId":586,"easy":"إذا وسمت الحيوان في وجهه ← فأمامك القصاص","cause":"قد وسمتُها في أنفِها","result":"أما إنَّ أمامَك القصاصُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الترغيب والترهيب 3/225","srcLabel":"الطبراني","text":["أتيتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم بإبلٍ ",["قد وسمتُها في أنفِها",1]," فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم يا جُنادةُ فما وجدتَ عضوًا تسِمُه إلَّا في الوجهِ ",["أما إنَّ أمامَك القصاصُ",2]," فقال أمرُها إليك يا رسولَ اللهِ"],"grade":"صحيح","narrator":"جنادة بن جرادة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن أبي عاصم في ((الآحاد والمثاني)) (1256)، والطبري في ((تهذيب الآثار)) (661)، والطبراني (2/283) (2179) باختلاف يسير.","bab":"آداب عامة › الرفق بالحيوان والطير ونحوهما","dorar":"LN8DkwjB"},{"id":"س-01790","fp":"281dd5bbb037","stateId":586,"easy":"إذا حبست هرة فلم تطعمها ولم ترسلها ← تُعذّب في النار","cause":"ربطَتها ، فلا هي أطعَمتْها ، ولا هي أرسَلَتْها","result":"وإذا فيها الحِميَريَّةُ صاحبَةُ القطَّةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-00468","ref":"صحيح الموارد 433","text":["صلَّينا مع رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّم يومًا ، فأطالَ القيامَ ، وكان إذا صلَّى بنا خفَّفَ ، ثُمَّ لا نسمَعُ منه شيئًا غير أنه يقولُ : ربِّ وأنا فيهِم ؟ ! ثم رأيته أهوى بيدِهِ ليتناولَ شيئًا ، ثمَّ إنه ركَعَ ، ثمَّ أسرعَ بعدَ ذلكَ ، فلمَّا سلَّمَ رسولُ اللهَ صَلَّى اللَّهُ علَيهِ وسلَّمَ ؛ جلَس وجلَسنا حولَهُ ، فقال رسولُ اللهِ صَلَّى اللَّهُ علَيهِ وسلَّمَ : قد علِمتُ أنه رابكُم طولُ صلاتي وقيامي . قُلنا : أجَل يا رسولَ اللَّهِ ! وسمعناك تقولُ : ربِّ وأنا فيهِم ؟ ! فقال رسولُ اللهِ صَلَّى اللَّهُ علَيهِ وسلَّمَ : والَّذي نفسي بيدِهِ ؛ ما من شيءٍ وُعِدتُموهُ في الآخرةِ ؛ إلَّا قد عُرِضَ عليَّ في مقامي هذا ، حتَّى لقد عُرِضَت عليَّ النارُ ، وأقبلَ عليَّ منها شيءٌ حتَّى دنا مكاني هذا ، فخشيتُ أن تغشاكُم ، فقلتُ : ربِّ ! وأنا فيهِم ؟ ! فصرَفها ، فأدبرَتْ قِطعًا كأنَّها الزَّرابِّيُّ ، فنظرتُ فيها نظرةً ، فرأيتُ فيها عمرَو بنَ خرثَانَ – أخا بني غِفارٍ – متَّكئًا في جهنَّمَ على قوسِهِ ، ",["وإذا فيها الحِميَريَّةُ صاحبَةُ القطَّةِ",2]," ؛ ",["ربطَتها ، فلا هي أطعَمتْها ، ولا هي أرسَلَتْها",1]],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه الروياني (193)، وابن حبان (6432) كلاهما بلفظه، والطبراني في ((المعجم الأوسط)) (3197) بنحوه.","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"X99NXf1y"},{"id":"س-02941","fp":"748ccd0c7560","stateId":586,"easy":"إذا روّعت مؤمناً ← لا يؤمّن الله روعتك يوم القيامة","cause":"مَنْ رَوَّعَ مؤمنًا","result":"لمْ يَؤمِّنِ اللهُ رَوْعَتَهُ يومَ القيامةِ","explicit":true,"ref":"الجامع الصغير 8695","srcLabel":"البيهقي","text":[["مَنْ رَوَّعَ مؤمنًا، ",1],["لمْ يَؤمِّنِ اللهُ رَوْعَتَهُ يومَ القيامةِ، ",2],"ومَنْ سَعَى بمؤمنٍ، أقامَهُ اللهُ مقامَ ذلٍّ وخزيٍ يومَ القيامَةِ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (11117) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (6/ 322)، وأبو طاهر المخلص في ((المخلصيات)) (2434)، بنحوه.","bab":"إيمان › الوعيد","dorar":"aZur3Nkt"},{"id":"س-03052","fp":"9ff846d8158a","stateId":586,"easy":"إذا غلب جورك عدلك في القضاء ← فلك النار","cause":"ومَن غلَب جَوْرُه عَدْلَه","result":"فله النَّارُ","explicit":true,"ref":"إرشاد الفقيه 2/390","srcLabel":"أبو داود","text":["مَن طلَب قضاءَ المُسلِمينَ حتَّى ينالَه ثمَّ غلَب عَدْلُه جَوْرَه، فله الجنَّةُ، ",["ومَن غلَب جَوْرُه عَدْلَه، ",1],["فله النَّارُ",2],"."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه أبو داود (3575)، والبيهقي (20660)","bab":"إيمان › الوعيد","dorar":"zfz5WSJK"},{"id":"س-04181","fp":"ffe348fc41a7","stateId":586,"easy":"إذا توليت عملاً وأنت تعلم أنك لست أهله ← فتبوأ مقعدك من النار","cause":"من تولى عملاً وهو يعلمُ أنَّه ليس لذلكَ العملِ أهلً","result":"فليتبوَّأْ مقعدَهُ من النَّارِ","explicit":true,"ref":"السلسلة الصحيحة 5/364","srcLabel":"الروياني","text":[["من تولى عملاً وهو يعلمُ أنَّه ليس لذلكَ العملِ أهلً ",1],["فليتبوَّأْ مقعدَهُ من النَّارِ",2],"."],"grade":"حسن","narrator":"أبو موسى الأشعري","muhaddith":"إسناده حسن","takhrij":"أخرجه الروياني في ((المسند)) (495)، وابن عساكر (26/ 57) واللفظ لهما.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"qco7Usdv"},{"id":"س-05132","fp":"3253f8ac54ff","stateId":586,"easy":"إذا ظلمت شبراً من الأرض ← تأتي يوم القيامة تحمله على عنقك","cause":"مَن ظلَمَ شِبرًا منَ الأرضِ","result":"جاءَ يَحمِلُه على عُنقِه يومَ القيامةِ","explicit":true,"repOf":"س-08033","ref":"تخريج مشكل الآثار 6149","text":[["مَن ظلَمَ شِبرًا منَ الأرضِ؛ ",1],["جاءَ يَحمِلُه على عُنقِه يومَ القيامةِ",2],"."],"grade":"حسن","narrator":"يعلى بن مرة الثقفي","muhaddith":"إسناده حسن.","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (6149) باللفظ نفسه، وأحمد (17558) ، والطبراني (691) (22 / 270) بنحوه","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"39Sr8lI3"},{"id":"س-05252","fp":"cfb76f5be89a","stateId":586,"easy":"إذا أعطيت بيعة ثم نكثتها ← تلقى الله وليست معك يمينك","cause":"مَن أعطى بيعةً ثم نكَثَها","result":"لَقِيَ اللهَ وليست معه يمينُهُ","explicit":true,"ref":"إرشاد الساري 10/270","srcLabel":"الطبراني","text":[["مَن أعطى بيعةً ثم نكَثَها ",1],["لَقِيَ اللهَ وليست معه يمينُهُ",2],"."],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"إسناده جيد","takhrij":"لم نقف عليه إلا عند الطبراني في ((المعجم الأوسط)) (9106) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"otZPuySp"},{"id":"س-06891","fp":"160d03b9f802","stateId":586,"easy":"إذا ظلمت ← فإن الله لا يجاوزه ظلم ظالم","cause":"ظُلمُ ظالمٍ","result":"وعزَّتي وجَلالي لا يُجاوزُني","explicit":true,"ref":"البدور السافرة 287","srcLabel":"الطبراني","text":["يُقبِلُ الجبارُ تباركَ وتعالى يومَ القيامةِ فيثني رجلَهُ على الجسرِ فيقولُ : ",["وعزَّتي وجَلالي لا يُجاوزُني",2]," ",["ظُلمُ ظالمٍ",1]," ، فينصفُ الخلقَ بعضَهم من بعضٍ حتى إنَّهُ لينصِفُ الشاةَ الجماءَ منَ الشاةِ العضباءِ بنطحةٍ تنطحُها"],"grade":"حسن","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني (2/ 95)، (1421)، وابن منده في ((الرد على الجهمية)) (ص: 20) كلاهما باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"pJENcPC1"},{"id":"س-07366","fp":"33cf9710ed62","stateId":586,"easy":"إذا ظلمت ولو بهيمة ← يُقاد منك يوم القيامة","cause":"فنطَحَتْ إحْداهُما الأُخْرى","result":"لَيُقادَنَّ لها يومَ القيامةِ","explicit":true,"ref":"تخريج المسند لشعيب 21511","srcLabel":"أحمد","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ كان جالسًا، وشاتانِ تَعتَلِفانِ، ",["فنطَحَتْ إحْداهُما الأُخْرى",1],"، فأجهَضَتْها، قال: فضَحِكَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقيلَ له: ما يُضحِكُكَ يا رسولَ اللهِ؟ قال: عجِبْتُ لها، والذي نَفْسي بيَدِه، ",["لَيُقادَنَّ لها يومَ القيامةِ",2],"."],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"حسن","takhrij":"أخرجه أحمد (21511) واللفظ له، والبزار (4032)، والطبراني في ((لمعجم الأوسط)) (6110)","bab":"فضائل النبي وصفته ودلائل النبوة › أحوال النبي","dorar":"eAiD6FEC"},{"id":"س-07495","fp":"31de0bef2d9c","stateId":586,"easy":"إذا أكلت مال أخيك وسفكت دمه وعصيت ربك وكفرت بخالقك ← تجب لك جهنم","cause":"فيأكلُ مالَ أخيه ، ويسفِكُ دمَه ، ويعصي ربَّه ، ويَكفُرُ بخالقِهِ","result":"وتجِبُ [ لهُ ] جهنَّمُ","explicit":true,"otherNeedIds":[20],"ref":"المطالب العالية 5/8","srcLabel":"الطبراني","text":["ستكونُ بَعدي فتَنٌ كقِطعِ اللَّيلِ المظلِمِ ، يُصدَمُ الرَّجلُ كصَدمِ جباهِ فُحولِ الثِّيرانِ ، يُصبِحُ الرَّجلُ فيها مُسلمًا ويُمسي كافرًا ، ويُمسي مُؤمنًا ويُصبِحُ كافرًا ، فقال رجلٌ : فكيفَ نصنعُ عندَ ذلكَ يا رسولَ اللهِ ؟ قال صلَّى اللهُ عليْهِ وسلَّمَ : ادخُلوا بيوتَكم ، وأَخمِلوا ذِكرَكُم ، فقال رجلٌ : أرأيتَ إن دُخِلَ على أحدِنا بيتُهُ ؟ قال : فلْيُمسكْ بيدِه ، ولْيكن [ عبدَ ] اللهِ المقتولَ ، ولا يكن [ عبدَ ] اللهِ القاتلَ ، فإنَّ الرَّجلَ يكونُ في [ فئةِ ] الإسلامِ ، ",["فيأكلُ مالَ أخيه ، ويسفِكُ دمَه ، ويعصي ربَّه ، ويَكفُرُ بخالقِهِ",1]," ، ",["وتجِبُ [ لهُ ] جهنَّمُ",2]],"grade":"حسن","narrator":"جندب بن عبدالله","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن أبي شيبة (38585)، وأبو يعلى (1523) واللفظ لهما، والطبراني في ((المعجم الكبير)) (2/ 177) (1724) بنحوه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"8Mc7b36f"},{"id":"س-07845","fp":"893ac5cf2a11","stateId":586,"easy":"إذا استُرعيت رعية ← تُسأل يوم القيامة: أقمت فيها أمر الله أم أضعته","cause":"ما من راعٍ يُستَرعَى رعيةً","result":"إلا سُئِلَ يومَ القيامةِِ أقام فيها أمرَ اللهِ أم أضاعَه","explicit":true,"ref":"مجمع الزوائد 5/210","srcLabel":"الطبراني","text":[["ما من راعٍ يُستَرعَى رعيةً",1]," ",["إلا سُئِلَ يومَ القيامةِِ أقام فيها أمرَ اللهِ أم أضاعَه",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"فيه أبو عياش المصري وهو مستور ، وبقية رجاله ثقات وفي بعضهم كلام","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (4916) واللفظ له، وأبو سعيد النقاش في ((القضاة)) كما في ((كنز العمال)) للمتقي الهندي (6/33)","bab":"قيامة › الحساب والقصاص","dorar":"ZQohX70Q"},{"id":"س-07989","fp":"226bb6178371","stateId":586,"easy":"إذا ضربت مملوكك ظلماً ← يُقاد منك يوم القيامة","cause":"مَنْ ضَرَبَ مَمْلُوكَهُ ظُلْمًا","result":"أُقِيلَ مِنْهُ يومَ الْقِيامَةِ","explicit":true,"repOf":"س-08032","ref":"مجمع الزوائد 4/241","text":[["مَنْ ضَرَبَ مَمْلُوكَهُ ظُلْمًا",1]," ",["أُقِيلَ مِنْهُ يومَ الْقِيامَةِ",2]],"grade":"حسن","narrator":"عمار بن ياسر","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني كما في ((الترغيب والترهيب)) للمنذري (3/148)، وأبو نعيم في ((حلية الأولياء)) (4/378) باختلاف يسير.","bab":"مظالم › تحريم الظلم","dorar":"6Tkhe42i"},{"id":"س-08001","fp":"5dca1c697fca","stateId":586,"easy":"إذا ظلمت رجلاً مظلمة في الدنيا ولم تقضها من نفسك ← يقضيها الله منك يوم القيامة","cause":"ما من عبدٍ يظلمُ رجلًا مظلمةً في الدنيا لا يقضيِه من نفسِه","result":"إلا أقضاه اللهُ تعالى منه يومَ القيامةِ","explicit":true,"ref":"النوافح العطرة 321","srcLabel":"البيهقي","text":[["ما من عبدٍ يظلمُ رجلًا مظلمةً في الدنيا لا يقضيِه من نفسِه",1]," ",["إلا أقضاه اللهُ تعالى منه يومَ القيامةِ",2]],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"إسناده حسن","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (7484) باختلاف يسير.","bab":"مظالم › تحريم الظلم","dorar":"HRDYSpAp"},{"id":"س-08002","fp":"d8d1926d595a","stateId":586,"easy":"إذا انتقصت ذراعاً من أرض أخيك ← تُطوّقه يوم القيامة، ولو حصاة","cause":"ذراعٌ مِنَ الأرضِ ينتقصُهُ المرءُ منْ حقِّ أخيهِ","result":"ليستْ حصاةٌ أخذَهَا إلَّا طُوِّقَها يومَ القيامةِ","explicit":true,"ref":"الجامع الصغير 1178","srcLabel":"أحمد","text":["أعظمُ الظلمِ ",["ذراعٌ مِنَ الأرضِ ينتقصُهُ المرءُ منْ حقِّ أخيهِ",1]," ، ",["ليستْ حصاةٌ أخذَهَا إلَّا طُوِّقَها يومَ القيامةِ",2]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"حسن","takhrij":"أخرجه أحمد (3767)، والطبراني (10/267) (10516) باختلاف يسير","bab":"مظالم › تحريم الظلم","dorar":"Relid3jZ"},{"id":"س-08050","fp":"0565f57c9bd7","stateId":586,"easy":"إذا أخذت حصاة من الأرض ظلماً ← تُطوّقها يوم القيامة إلى قعر الأرض","cause":"فليسَ حَصاةٌ مِنَ الأرضِ يَأخُذُها","result":"إلَّا طُوِّقَها يَومَ القيامةِ إلى قَعرِ الأرضِ","explicit":true,"repOf":"س-08033","ref":"تنبيه الغافلين 255","text":["عن ابنِ مَسعودٍ رَضيَ اللهُ عنه، قال: قُلتُ: يا رسولَ اللَّهِ، أيُّ الظُّلمِ أظلمُ؟ فقال: «ذِراعٌ مِنَ الأرضِ يَنتَقِصُها المَرءُ المُسلمُ مِن حَقِّ أخيه، ",["فليسَ حَصاةٌ مِنَ الأرضِ يَأخُذُها",1]," ",["إلَّا طُوِّقَها يَومَ القيامةِ إلى قَعرِ الأرضِ",2],"، ولا يَعلمُ قَعرَها إلَّا الذي خَلقَها»"],"grade":"حسن","narrator":"ابن مسعود","muhaddith":"إسناده حسن.","takhrij":"أخرجه أحمد (3767)، والطبراني في ((الكبير)) (10/ 216) (10516) واللفظ لهما.","bab":"مظالم › تحريم الظلم","dorar":"lx7LXXuh"},{"id":"س-08076","fp":"e3c5ce959bfd","stateId":586,"easy":"إذا ضربت عبداً لك (ظلماً) ← يُقاد منك يوم القيامة","cause":"ما من رجلٍ يضرِبُ عبدًا له","result":"إلَّا أُقِيدَ منه يومَ القيامةِ","explicit":true,"repOf":"س-07986","ref":"مجمع الزوائد 10/356","text":[["ما من رجلٍ يضرِبُ عبدًا له",1]," ",["إلَّا أُقِيدَ منه يومَ القيامةِ",2]],"grade":"حسن","narrator":"عمار بن ياسر","muhaddith":"رجاله ثقات","takhrij":"أخرجه البزار (1399) بلفظه، وأبو نعيم الأصبهاني في ((حلية الأولياء)) (4/378) باختلاف يسير.","bab":"مظالم › قصاص المظالم","dorar":"4GhkJjnt"},{"id":"س-08205","fp":"cab27eb58b55","stateId":586,"easy":"إذا حكمت بين الناس ← تُحبس يوم القيامة وملك آخذ بقفاك حتى يوقفك على جهنم","cause":"ما من حكَمٍ يحكمُ بينَ الناسِ","result":"إلا حُبِس يومَ القيامةِ وملَكٌ آخذٌ بقَفاه حتى يقِفَه على جهنمَ ثم يرفعَ رأسَه إلى اللهِ عزَّ وجلَّ فإن قال الخطأَ ألقاه في جهنمَ يهوي أربعينَ خريفًا","explicit":true,"repOf":"س-07437","ref":"تخريج المسند لشاكر 6/74","text":[["ما من حكَمٍ يحكمُ بينَ الناسِ",1]," ",["إلا حُبِس يومَ القيامةِ وملَكٌ آخذٌ بقَفاه حتى يقِفَه على جهنمَ ثم يرفعَ رأسَه إلى اللهِ عزَّ وجلَّ فإن قال الخطأَ ألقاه في جهنمَ يهوي أربعينَ خريفًا",2]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن ماجه (2311)، وأحمد (4097) واللفظ له","bab":"ملائكة › أعمال الملائكة","dorar":"JOkzpUsQ"},{"id":"س-02497","fp":"8147487cdc89","stateId":586,"easy":"إذا توليت الإمارة بغير حقها ← تكون عليك خزياً وندامة يوم القيامة","cause":"وإنَّها أمانةٌ","result":"وإنَّها يومَ القِيامةِ خِزيٌ وندامةٌ إلَّا مَن أخذَها بحقِّها، وأدَّى الذي عليه فيها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[39],"ref":"تخريج مشكل الآثار 57","srcLabel":"مسلم","text":["قُلْتُ: يا رسولَ اللهِ، ألَا تَستعمِلُني؟ قال: فضرَب بيَدِهِ على مَنْكِبِي، ثمَّ قال: يا أبا ذَرٍّ، إنَّكَ ضعيفٌ، ",["وإنَّها أمانةٌ",1],"، ",["وإنَّها يومَ القِيامةِ خِزيٌ وندامةٌ إلَّا مَن أخذَها بحقِّها، وأدَّى الذي عليه فيها",2],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (1825)، والطحاوي في ((شرح المشكل)) (57) كلاهما بلفظه، وأحمد (21513) باختلاف يسير.","bab":"إمامة وخلافة › تولية الولاة وغيرهم","dorar":"ui6GCbKd","merged":2,"otherRefs":["المستدرك على الصحيحين 7214 (صحيح)"]},{"id":"س-04176","fp":"cd00b3ca0d97","stateId":586,"easy":"إذا قتلت ظالماً لك دفاعاً ← فالظالم في النار","cause":"وإن قَتلتَ","result":"ففي النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشاكر 16/199","srcLabel":"مسلم","text":["جاءَ رجلٌ إلى رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ : يا رسولَ اللَّهِ أرأيتَ إن عُدِيَ على مالي ؟ قالَ : فأنشِدِ اللَّهَ قالَ : فإن أبَوا عليَّ قالَ : أنشِدِ اللَّهَ قالَ : فإن أبوا عليَّ قالَ : فأنشدِ اللَّه قالَ فإن أبوا عليَّ قالَ : فقاتِلْ ، فإن قُتِلتَ ففي الجنَّةِ ، ",["وإن قَتلتَ",1]," ",["ففي النَّارِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (4082) باختلاف يسير، وأخرجه مسلم (140) بنحوه","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"I1lQ6JO2"},{"id":"س-01667","fp":"2200c65ef3a9","stateId":586,"easy":"إذا كنت قاضياً جائراً ← فويل لك من ديّان السماء (أثر عمر)","cause":"لديَّانِ الأرضِ","result":"ويلٌ لديَّانِ الأرضِ مِن ديَّانِ السَّماءِ يومَ يلقونَهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"مختصر العلو 47","srcLabel":"أحمد","text":["قال عمر بن الخطاب: ",["ويلٌ لديَّانِ الأرضِ مِن ديَّانِ السَّماءِ يومَ يلقونَهُ",2]," ، إلَّا من أمَرَ بالعدلَ ، فقَضى بالحقِّ، ولم يَقضِ علَى هوًى، ولا علَى قرابةٍ، ولا علَى رَغبةٍ، ولا رَهَبٍ، وجعلَ كتابَ اللَّهِ مِرآةً بينَ عينيهِ، قالَ ابنُ غنيم: فحدِّثتُ بهذا عثمانَ ومعاويةَ، ويزيدَ، وعبدِ الملِكِ"],"grade":"صحيح","narrator":"عبدالرحمن بن غنم","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد في ((الزهد)) (663) واللفظ له، وابن أبي شيبة (23416)، وأبو نعيم في ((فضيلة العادلين)) (44) باختلاف يسير.","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"UnzzgZrD"},{"id":"س-01669","fp":"2da72db8d636","stateId":586,"easy":"إذا قضيت بين الناس ← تلقى شدة الحساب ولو كنت عادلاً","cause":"بالقاضي العادلِ","result":"فيَلقى مِن شدَّةِ الحسابِ ما يتمنَّى أنَّه لم يقضِ بيْنَ اثنينِ في عمرِه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"صحيح ابن حبان 5055","srcLabel":"أحمد","text":["يُدعى ",["بالقاضي العادلِ",1]," يومَ القيامةِ ",["فيَلقى مِن شدَّةِ الحسابِ ما يتمنَّى أنَّه لم يقضِ بيْنَ اثنينِ في عمرِه",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (24464)، والطبراني في ((المعجم الأوسط)) (2619)، والبيهقي (20717) باختلاف يسير","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"VtN0RuEP"},{"id":"س-08082","fp":"e881e5f993cf","stateId":586,"easy":"إذا عاقبت من تحت يدك فوق ذنوبهم ← يُقتص لهم منك الفضل","cause":"إنْْ كان عِقابُك إيَّاهُم فَوقَ ذُنُوبِهِمُ","result":"اقْتُصَّ لهمْ مِنكَ الفَضلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح الترغيب 3606","srcLabel":"الترمذي","text":["أنَّ رجلاً مِنْ أصْحابِ رسولهِ الله - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جلسَ بينَ يديْهِ، فقال: يا رسولَ الله! إنَّ لي مَمْلوكين يكذِّبونَني وَيخونونني وَيعْصونَني، وأضْرِبُهم وأشْتُمهمْ، فكيفَ أنا منهم؟ فقالَ له رسولُ الله - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: يُحسَبُ ما خانُوك وعَصَوكَ وكذَّبُوك وعِقابُك إيَّاهُم ، فإنْ كان عِقابُك إيَّاهُم دُونَ ذُنُوبِهمْ ؛ كان فَضْلًا لكَ ( عليهِم ) وإنْ كان عِقابُك إيَّاهم بقدرِ ذُنوبِهمْ ؛ كان كَفَافًا ولا لكَ ولا عليكَ ، و",["إنْْ كان عِقابُك إيَّاهُم فَوقَ ذُنُوبِهِمُ",1]," ",["اقْتُصَّ لهمْ مِنكَ الفَضلُ",2]," الذِي بَقِيَ قِبَلَكَ فجَعلَ الرجلُ يبْكِي بين يَدَيْ رسولِ اللهِ ويَهتِفُ فقال رسولُ اللهِ مالَكَ ؟ ما تَقرأُ كتابَ اللهِ \"ونَضَعُ الموازِين القِسطَ ليومِ القيامةِ فلا تظلمُ نفسٌ شيئًا وإن كان مثقالَ حبةٍ من خردلِ أتينا بها وكفى بنا حاسِبين\" ؟ فقال الرجلُ يا رسولَ الله ! ما أجِدُ شيئًا خيرًا من فِراقِ هؤلاءِ – يعني عَبِيدَهُ ( إنِّي ) أُشْهِدُكَ أنَّهم كلَّهم أحْرَارٌ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3165)، وأحمد (26401) باختلاف يسير","bab":"مظالم › قصاص المظالم","dorar":"C83DM1UR"},{"id":"س-08024","fp":"31babccaae35","stateId":586,"easy":"إذا ظلمت ← يقتص منك المظلومون حتى ينزعوا ما في يديك","cause":"يجيءُ الظالمُ يومَ القيامةِ","result":"فما يبرحُ الذين ظلموا يقصونَ منَ الذينَ ظَلموا حتى يَنزعوا ما في أيديهُمْ منَ الحسناتِ ، فإن لم تكنْ لهم حسناتٌ رُدَّ عليْهِم من سيئاتِهم حتى يوردَ الدركَ الأسفلَ منَ النارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[45],"ref":"البدور السافرة 288","srcLabel":"الطبراني","text":[["يجيءُ الظالمُ يومَ القيامةِ",1]," حتى إذا كان على جسرِ جهنمَ بين الظلمةِ والوعرةِ لقيَهُ المظلومُ فعرفَهُ ، وعرفَ ما ظلمَهُ به ، ",["فما يبرحُ الذين ظلموا يقصونَ منَ الذينَ ظَلموا حتى يَنزعوا ما في أيديهُمْ منَ الحسناتِ ، فإن لم تكنْ لهم حسناتٌ رُدَّ عليْهِم من سيئاتِهم حتى يوردَ الدركَ الأسفلَ منَ النارِ",2]],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (5976)","bab":"مظالم › تحريم الظلم","dorar":"tpPzx9Yz"},{"id":"س-08046","fp":"118b0368eb7d","stateId":586,"easy":"إذا ظلمت العباد ← يقص الله بعضهم من بعض","cause":"وأمَّا الذي لا يُترَكُ","result":"يُقِصُّ اللَّهُ بَعضَهم مِن بَعضٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-08048"],"ref":"البعث والنشور 393","srcLabel":"الطيالسي","text":["الظُّلمُ ثَلاثةٌ: فظُلمٌ لا يَترُكُه اللهُ، وظُلمٌ يُغفَرُ، وظُلمٌ لا يُغفَرُ؛ فأمَّا الظُّلمُ الذي لا يُغفَرُ فالشِّركُ، لا يَغفِرُه اللهُ، والظُّلمُ الذي يُغفَرُ فظُلمُ العَبدِ فيما بَينَه وبَينَ رَبِّه، ",["وأمَّا الذي لا يُترَكُ",1],"، ",["يُقِصُّ اللَّهُ بَعضَهم مِن بَعضٍ",2]],"grade":"حسن","narrator":"أنس","muhaddith":"[غير قوي]","takhrij":"أخرجه الطيالسي (2223)، وأبو نعيم في ((الحلية)) (6/ 309)، والبزار كما في ((كشف الأستار)) (3439) باختلاف يسير.","bab":"مظالم › تحريم الظلم","dorar":"82Dfcjav"},{"id":"س-08048","fp":"3c7d902d7989","stateId":586,"easy":"إذا ظلمت العباد ← تُقاضى حتى يُدان بعضكم من بعض","cause":"فظُلمُ العِبادِ بَعضِهم بَعضًا","result":"حتَّى يدينَ بَعضُهم مِن بَعضٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-08046","ref":"البعث والنشور 292","text":["«الظُّلمُ ثَلاثةٌ: فظُلمٌ لا يَغفِرُه اللهُ عَزَّ وجَلَّ، وظُلمٌ يَغفِرُه، وظُلمٌ لا يَترُكُه اللهُ عَزَّ وجَلَّ؛ فأمَّا الظُّلمُ الذي لا يَغفِرُه اللهُ فالشِّركُ، قال اللهُ عَزَّ وجَلَّ: {إِنَّ الشِّرْكَ لَظُلْمٌ عَظِيمٌ}، وأمَّا الظُّلمُ الذي يَغفِرُه اللهُ فظُلمُ العِبادِ أنفُسَهم فيما بَينَهم وبَينَ رَبِّهم، وأمَّا الظُّلمُ الذي لا يَترُكُه ",["فظُلمُ العِبادِ بَعضِهم بَعضًا",1],"، ",["حتَّى يدينَ بَعضُهم مِن بَعضٍ",2],"»."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده غير قوي.","bab":"مظالم › تحريم الظلم","dorar":"eiFC1szY"},{"id":"س-03943","fp":"dfc371489294","stateId":587,"easy":"إذا قتلت رجلاً متعمداً ← يجيء يوم القيامة آخذاً بك","cause":"رَجُلٌ قَتَلَ رَجُلًا مُتَعَمِّدًا","result":"فجيءَ يَوْمَ القِيامةِ آخِذًا قاتِلُه بيَمينِه","explicit":true,"star":true,"similar":["س-03915"],"otherNeedIds":[12],"ref":"الأحاديث المختارة 10 / 45","srcLabel":"متفق عليه","text":["«أنَّ رَجُلًا أتاه، فقالَ: أَرأيْتَ رَجُلًا قَتَلَ رَجُلًا مُتَعَمِّدًا؟ قالَ: {فَجَزَاؤُهُ جَهَنَّمُ خَالِدًا فِيهَا وَغَضِبَ اللَّهُ عَلَيْهِ وَلَعَنَهُ وَأَعَدَّ لَهُ عَذَابًا عَظِيمًا} قالَ: لقد نَزَلَتْ في آخِرِ ما نَزَلَ، ما نَسَخَها شيءٌ حتَّى قُبِضَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ وما نَزَلَ وَحْيٌ بَعْدَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، قالَ: أَرأيْتَ إن تابَ وآمَنَ وعَمِلَ صالِحًا ثُمَّ اهْتَدى، قالَ: وأنَّى له التَّوْبةُ وقدْ سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ثَكِلَتْه أُمُّه ",["رَجُلٌ قَتَلَ رَجُلًا مُتَعَمِّدًا",1]," ",["فجيءَ يَوْمَ القِيامةِ آخِذًا قاتِلُه بيَمينِه",2]," أو يَسارِه، وآخِذًا رَأسَه بيَمينِه أو شِمالِه تَشخَبُ أوْداجُه دَمًا في قُبُلِ العَرْشِ، يقولُ: يا رَبِّ، سَلْ عَبْدَك فيمَ قَتَلَني»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"تفسير آيات › سورة النساء","dorar":"hrJtxCcM","merged":8,"otherRefs":["صحيح ابن ماجه 2139 (صحيح)","تخريج المسند لشعيب 2683 (صحيح)","السلسلة الصحيحة 6/444 (صحيح)","تخريج المسند لشعيب 1941 (صحيح)","صحيح الجامع 8032 (صحيح)","الأحاديث المختارة 10 / 47 (صحيح)","تخريج المسند لشعيب 3445 (صحيح)"]},{"id":"س-05751","fp":"ee143a49005e","stateId":587,"easy":"إذا تواجه مسلمان بسيفيهما ← فكلاهما من أهل النار","cause":"تَواجَهَ المُسلِمانِ بسَيفَيهما","result":"فكِلاهما مِن أهلِ النَّارِ","explicit":true,"star":true,"ref":"صحيح البخاري 7083","srcLabel":"مسلم","text":["عَنِ الحَسَنِ، قال: خَرَجتُ بسِلاحي لَياليَ الفِتنةِ، فاستَقبَلَني أبو بَكرةَ، فقال: أينَ تُريدُ؟ قُلتُ: أُريدُ نُصرةَ ابنِ عَمِّ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، قال: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: إذا ",["تَواجَهَ المُسلِمانِ بسَيفَيهما",1]," ",["فكِلاهما مِن أهلِ النَّارِ",2],"، قيلَ: فهذا القاتِلُ، فما بالُ المَقتولِ؟ قال: إنَّه أرادَ قَتلَ صاحِبِه."],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"[أورده في صحيحه وعلق عليه]","takhrij":"أخرجه مسلم (2888) باختلاف يسير","bab":"رقائق وزهد › النية","dorar":"U91Fsdvz","merged":5,"otherRefs":["التذكرة للقرطبي 556 (صحيح)","الجامع الصغير 483 (صحيح)","تخريج المسند لشعيب 20493 (صحيح)","تخريج المسند لشعيب 19590 (صحيح)"]},{"id":"س-01561","fp":"1d6c5216bc89","stateId":587,"easy":"إذا تواجه مسلمان بسيفيهما فقتل أحدهما الآخر ← فهما في النار","cause":"إذا تواجَهَ المُسلِمانِ بسيفَيْهِما فقتَلَ أحدُهما صاحِبَه","result":"فهما في النَّارِ","explicit":true,"star":true,"similar":["س-07280"],"ref":"تخريج مشكل الآثار 4087","srcLabel":"متفق عليه","text":["عن الأَحْنَفِ بنِ قيسٍ قال: أخَذتُ سِلاحي وأنا أُريدُ أنْ أنصُرَ ابنَ عمِّ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فلَقِيَني أبو بَكْرَةَ، فقال: أين تُريدُ؟ قُلتُ: أنصُرُ ابنَ عمِّ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، قال: أفلا أُحدِّثُك حديثًا سمعتُه مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ قال: بلى، قُلتُ: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["إذا تواجَهَ المُسلِمانِ بسيفَيْهِما فقتَلَ أحدُهما صاحِبَه",1],"، ",["فهما في النَّارِ",2],"، قيل: يا رسولَ اللهِ، هذا القاتلُ، فما بالُ المقتولِ؟! قال: إنَّه قد أراد يقتُلُ صاحِبَه."],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (4087) بلفظه، والبخاري (6875)، وأبو داود (4268) كلاهما بلفظ مقارب ، ومسلم (2888) بنحوه .","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"ix1EodgO","merged":3,"otherRefs":["تخريج المسند لشعيب 20518 (صحيح)","تخريج المسند لشعيب 19751 (صحيح)"]},{"id":"س-05297","fp":"09ccb3843bb3","stateId":587,"easy":"إذا قتلت لتكون العزة لغير الله ← يجيء المقتول آخذاً بك تشخب أوداجه دماً","cause":"قتَلْتُه لِتكونَ العِزَّةُ لِفلانٍ","result":"يجِئُ المَقتولُ آخذًا قاتلَهُ وأوْداجُه تَشْخُبُ دَمًا عند ذِي العِزَّةِ ، فيقولُ : يا ربِّ ! سلْ هذا فِيمَ قَتَلَنِي","explicit":true,"star":true,"ref":"صحيح الترغيب 2448","srcLabel":"متفق عليه","text":[["يجِئُ المَقتولُ آخذًا قاتلَهُ وأوْداجُه تَشْخُبُ دَمًا عند ذِي العِزَّةِ ، فيقولُ : يا ربِّ ! سلْ هذا فِيمَ قَتَلَنِي",2]," ؟ فيقولُ : فِيمَ قَتلْتَه ؟ قال : ",["قتَلْتُه لِتكونَ العِزَّةُ لِفلانٍ",1]," . قِيلَ : هي للهِ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (766)، واللفظ له، وأصله في البخاري (6864)، ومسلم (1678)","bab":"رقائق وزهد › الترهيب من مواقعة الحدود وانتهاك المحارم","dorar":"Y9sfYBdi","merged":3,"otherRefs":["تخريج المسند لشعيب 16600 (صحيح)","الصحيح المسند 2/453 (صحيح)"]},{"id":"س-01752","fp":"937299ba392c","stateId":587,"easy":"إذا قتلت نفسك بشيء ← يعذبك الله به في نار جهنم","cause":"ومَن قَتَلَ نَفسَه بشيءٍ","result":"عَذَّبَه اللهُ به في نارِ جَهَنَّمَ","explicit":true,"star":true,"similar":["س-02375","س-02368","س-04918","س-05122","س-05162","س-05163","س-05164","س-04259"],"ref":"صحيح مسلم 110","srcLabel":"متفق عليه","text":["مَن حَلَفَ بمِلَّةٍ سِوى الإسلامِ كاذِبًا مُتَعَمِّدًا، فهو كما قال، ",["ومَن قَتَلَ نَفسَه بشيءٍ ",1],["عَذَّبَه اللهُ به في نارِ جَهَنَّمَ",2],". وفي روايةٍ: مَن حَلَفَ بمِلَّةٍ سِوى الإسلامِ كاذِبًا، فهو كما قال، ومَن ذَبَحَ نَفسَه بشيءٍ ذُبِحَ به يَومَ القيامةِ."],"grade":"صحيح","narrator":"ثابت بن الضحاك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1363)، ومسلم (110).","bab":"أيمان › الحلف بغير الله عز وجل","dorar":"GdyJNve4","merged":2,"otherRefs":["الإحكام في أصول الأحكام 2/504 (صحيح)"]},{"id":"س-02375","fp":"3001b57f2178","stateId":587,"easy":"إذا قتلت نفسك بشيء في الدنيا ← تُعذّب به يوم القيامة","cause":"ومَن قَتَلَ نَفسَه بشيءٍ في الدُّنيا","result":"عُذِّبَ به يَومَ القيامةِ","explicit":true,"repOf":"س-01752","ref":"صحيح مسلم 110","text":["ليس على رَجُلٍ نَذرٌ فيما لا يَملِكُ، ولَعنُ المُؤمِنِ كَقَتلِه، ",["ومَن قَتَلَ نَفسَه بشيءٍ في الدُّنيا",1]," ",["عُذِّبَ به يَومَ القيامةِ",2],"، ومَنِ ادَّعى دَعوى كاذِبةً ليَتَكَثَّرَ بها لم يَزِدْه اللهُ إلَّا قِلَّةً، ومَن حَلَفَ على يَمينِ صَبرٍ فاجِرةٍ."],"grade":"صحيح","narrator":"ثابت بن الضحاك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6047)، ومسلم (110).","bab":"إسلام › حرمة المسلم","dorar":"LmqD8FfX","merged":2,"otherRefs":["تخريج المسند لشعيب 16391 (صحيح)"]},{"id":"س-04965","fp":"b31466b6e8c7","stateId":587,"easy":"إذا حمل أحدكما السلاح على أخيه ← فأنتما على جرف جهنم، فإن قتله دخلاها","cause":"حمَل أحدُهما -يَعني على أخيه السَّلاحَ","result":"فهُما على جُرُفِ جهنَّمَ، فإذا قتَلَ أحدُهما صاحبَه دَخلاها جَميعًا","explicit":true,"ref":"ما تمس إليه الحاجة 176","srcLabel":"متفق عليه","text":["إذا الْتقَي المسلِمانِ ",["حمَل أحدُهما -يَعني على أخيه السَّلاحَ",1],"-؛ ",["فهُما على جُرُفِ جهنَّمَ، فإذا قتَلَ أحدُهما صاحبَه دَخلاها جَميعًا",2],"."],"grade":"صحيح","narrator":"أبو بكرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2888)، وابن ماجه (3965) كلاهما بلفظه، والنسائي (4116) بلفظ مقارب، والبخاري (7083) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"eQCvSc2h","merged":2,"otherRefs":["الجامع الصغير 438 (صحيح)"]},{"id":"س-02368","fp":"a72be3ffd479","stateId":587,"easy":"إذا قتلت نفسك بشيء ← يعذبك الله بما قتلت به نفسك يوم القيامة","cause":"ومَن قَتَل نَفْسَه بِشَيءٍ","result":"عذَّبَه اللهُ بِما قَتَل بِه نَفسَه يومَ القيامَةِ","explicit":true,"repOf":"س-01752","ref":"صحيح الترغيب 2776","text":["لَيسَ على المَرءِ نَذرٌ فيما لا يَملِكُ، ولاعِنُ المُؤمنِ كقاتِلِه، ومَن قَذَف مُؤمِنًا بِكُفرٍ فهوَ كقاتِلِه، ",["ومَن قَتَل نَفْسَه بِشَيءٍ ",1],["عذَّبَه اللهُ بِما قَتَل بِه نَفسَه يومَ القيامَةِ",2],"."],"grade":"صحيح","narrator":"ثابت بن الضحاك","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6047)، ومسلم (110) باختلاف يسير.","bab":"إسلام › حرمة المسلم","dorar":"XyD8F1In"},{"id":"س-02527","fp":"3ae2b46ca1cf","stateId":587,"easy":"إذا أشرت إلى أخيك بالسلاح ← قد يقع في حفرة من النار","cause":"لا يُشيرُ أحَدُكُم إلى أخيه بالسِّلاحِ","result":"فيَقَعُ في حُفرةٍ مِنَ النَّارِ","explicit":true,"ref":"صحيح مسلم 2617","srcLabel":"البخاري","text":[["لا يُشيرُ أحَدُكُم إلى أخيه بالسِّلاحِ",1],"؛ فإنَّه لا يَدري أحَدُكُم لَعَلَّ الشَّيطانَ يَنزِعُ في يَدِه، ",["فيَقَعُ في حُفرةٍ مِنَ النَّارِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7072) باختلاف يسير","bab":"إيمان › أعمال الجن والشياطين","dorar":"3gjwyteA"},{"id":"س-04916","fp":"92942480a781","stateId":587,"easy":"إذا خنقت نفسك في الدنيا ← تخنق نفسك في النار","cause":"مَن خنَق نفسَه في الدُّنيا فقتَلها خنَق نفسَه","result":"في النَّارِ","explicit":true,"ref":"تخريج صحيح ابن حبان 5987","srcLabel":"البخاري","text":[["مَن خنَق نفسَه في الدُّنيا فقتَلها خنَق نفسَه ",1],["في النَّارِ ",2],"ومَن طعَن نفسَه طعَنها في النَّارِ ومَن اقتحَم فقتَل نفسَه اقتحَم في النَّارِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1365) بلفظ مقارب دون قوله: \"ومن اقتحم ...\"","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"eZWd2Yyg"},{"id":"س-04917","fp":"12d78919ffca","stateId":587,"easy":"إذا طعنت نفسك ← تطعنها في النار","cause":"ومَن طعَن نفسَه طعَنها","result":"في النَّارِ","explicit":true,"ref":"تخريج صحيح ابن حبان 5987","srcLabel":"البخاري","text":["مَن خنَق نفسَه في الدُّنيا فقتَلها خنَق نفسَه في النَّارِ ",["ومَن طعَن نفسَه طعَنها ",1],["في النَّارِ ",2],"ومَن اقتحَم فقتَل نفسَه اقتحَم في النَّارِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1365) بلفظ مقارب دون قوله: \"ومن اقتحم ...\"","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"eZWd2Yyg"},{"id":"س-04918","fp":"44ee14f4b0e3","stateId":587,"easy":"إذا اقتحمت فقتلت نفسك ← تقتحم في النار","cause":"ومَن اقتحَم فقتَل نفسَه اقتحَم","result":"في النَّارِ","explicit":true,"repOf":"س-01752","ref":"تخريج صحيح ابن حبان 5987","text":["مَن خنَق نفسَه في الدُّنيا فقتَلها خنَق نفسَه في النَّارِ ومَن طعَن نفسَه طعَنها في النَّارِ ",["ومَن اقتحَم فقتَل نفسَه اقتحَم ",1],["في النَّارِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1365) بلفظ مقارب دون قوله: \"ومن اقتحم ...\"","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"eZWd2Yyg"},{"id":"س-05122","fp":"c819e45570cf","stateId":587,"easy":"إذا قتلت نفسك بحديدة أو تردّيت ← تُعذب بها في نار جهنم خالداً","cause":"مَن قتَل نفْسَهُ بحَديدةٍ، فحَديدتُهُ في يدِهِ في نارِ جَهنَّمَ، يتوجَّأُ بها في بطنِهِ في نارِ جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا، ومَن تردَّى من جبَلٍ فقتَل نفْسَهُ","result":"فهو يتردَّى في جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا","explicit":true,"repOf":"س-01752","ref":"تخريج مشكل الآثار 196","text":[["مَن قتَل نفْسَهُ بحَديدةٍ، فحَديدتُهُ في يدِهِ في نارِ جَهنَّمَ، يتوجَّأُ بها في بطنِهِ في نارِ جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا، ومَن تردَّى من جبَلٍ فقتَل نفْسَهُ، ",1],["فهو يتردَّى في جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا",2],"، ومَن قتَل نفْسَهُ بسُمٍّ، فسُمُّهُ في يدِهِ يتحسَّاهُ في نارِ جَهنَّمَ خالدًا فيها، مُخلَّدًا فيها أبدًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (5778)، ومسلم (109) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"GpQmPCdR"},{"id":"س-05162","fp":"101c1c122b18","stateId":587,"easy":"إذا تردّيت من جبل فقتلت نفسك ← تتردى في نار جهنم خالداً","cause":"مَن تردَّى مِن جبَلٍ فقتَلَ نفْسَه","result":"فهو في نارِ جَهنَّمَ، يتردَّى خالدًا مُخلَّدًا فيها أبدًا","explicit":true,"repOf":"س-01752","ref":"صحيح النسائي 1964","text":[["مَن تردَّى مِن جبَلٍ فقتَلَ نفْسَه ",1],["فهو في نارِ جَهنَّمَ، يتردَّى خالدًا مُخلَّدًا فيها أبدًا، ",2],"ومَن تحسَّى سُمًّا فقتَلَ نفْسَه، فسُمُّه في يدِهِ، يتحسَّاه في نارِ جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا، ومَن قتَلَ نفْسَه بحَديدةٍ -ثمَّ انقطَعَ عليَّ شيء، خالِدٌ يقولُ- كانتْ حديدتُه في يدِه، يَجَأُ بها في بطنِه في نارِ جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5778)، ومسلم (109)، والترمذي (2044)، والنسائي (1965) واللفظ له، وأحمد (7448)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"aoL3jt3Q"},{"id":"س-05163","fp":"c48be0a1b5c7","stateId":587,"easy":"إذا تحسّيت سماً فقتلت نفسك ← تتحساه في نار جهنم خالداً","cause":"ومَن تحسَّى سُمًّا فقتَلَ نفْسَه، فسُمُّه في يدِهِ","result":"يتحسَّاه في نارِ جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا","explicit":true,"repOf":"س-01752","ref":"صحيح النسائي 1964","text":["مَن تردَّى مِن جبَلٍ فقتَلَ نفْسَه فهو في نارِ جَهنَّمَ، يتردَّى خالدًا مُخلَّدًا فيها أبدًا، ",["ومَن تحسَّى سُمًّا فقتَلَ نفْسَه، فسُمُّه في يدِهِ، ",1],["يتحسَّاه في نارِ جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا، ",2],"ومَن قتَلَ نفْسَه بحَديدةٍ -ثمَّ انقطَعَ عليَّ شيء، خالِدٌ يقولُ- كانتْ حديدتُه في يدِه، يَجَأُ بها في بطنِه في نارِ جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5778)، ومسلم (109)، والترمذي (2044)، والنسائي (1965) واللفظ له، وأحمد (7448)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"aoL3jt3Q"},{"id":"س-05164","fp":"d745d355bb83","stateId":587,"easy":"إذا قتلت نفسك بحديدة ← تجأ بها بطنك في نار جهنم خالداً","cause":"ومَن قتَلَ نفْسَه بحَديدةٍ","result":"كانتْ حديدتُه في يدِه، يَجَأُ بها في بطنِه في نارِ جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا","explicit":true,"repOf":"س-01752","ref":"صحيح النسائي 1964","text":["مَن تردَّى مِن جبَلٍ فقتَلَ نفْسَه فهو في نارِ جَهنَّمَ، يتردَّى خالدًا مُخلَّدًا فيها أبدًا، ومَن تحسَّى سُمًّا فقتَلَ نفْسَه، فسُمُّه في يدِهِ، يتحسَّاه في نارِ جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا، ",["ومَن قتَلَ نفْسَه بحَديدةٍ",1]," -ثمَّ انقطَعَ عليَّ شيء، خالِدٌ يقولُ- ",["كانتْ حديدتُه في يدِه، يَجَأُ بها في بطنِه في نارِ جَهنَّمَ خالدًا مُخلَّدًا فيها أبدًا",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5778)، ومسلم (109)، والترمذي (2044)، والنسائي (1965) واللفظ له، وأحمد (7448)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"aoL3jt3Q"},{"id":"ق-0211","fp":"e14fa3748aaa","stateId":587,"easy":"أكل الأموال بالباطل وقتل النفس عدواناً وظلماً ← صَلي النار","cause":"أكل الأموال بالباطل وقتل النفس عدواناً وظلماً","result":"صَلي النار","explicit":true,"ref":"سورة النساء: 30","srcLabel":"القرآن الكريم","quran":{"s":4,"from":30,"to":30,"text":"وَمَنْ يَفْعَلْ ذَلِكَ عُدْوَانًا وَظُلْمًا فَسَوْفَ نُصْلِيهِ نَارًا وَكَانَ ذَلِكَ عَلَى اللَّهِ يَسِيرًا (30)","hl":[[0,107,1]]}},{"id":"ق-0237","fp":"e8a470d26b5e","stateId":587,"easy":"قتل المؤمن عمداً ← جهنم خالداً فيها وغضب الله ولعنته وعذاب عظيم","cause":"قتل المؤمن عمداً","result":"جهنم خالداً فيها وغضب الله ولعنته وعذاب عظيم","explicit":true,"otherNeedIds":[27],"ref":"سورة النساء: 93","srcLabel":"القرآن الكريم","quran":{"s":4,"from":93,"to":93,"text":"وَمَنْ يَقْتُلْ مُؤْمِنًا مُتَعَمِّدًا فَجَزَاؤُهُ جَهَنَّمُ خَالِدًا فِيهَا وَغَضِبَ اللَّهُ عَلَيْهِ وَلَعَنَهُ وَأَعَدَّ لَهُ عَذَابًا عَظِيمًا (93)","hl":[[0,146,1]]}},{"id":"ق-0882","fp":"1fb93158a850","stateId":587,"easy":"الشرك وقتل النفس والزنا ← الأثام ومضاعفة العذاب والخلود مهاناً","cause":"الشرك وقتل النفس والزنا","result":"الأثام ومضاعفة العذاب والخلود مهاناً","explicit":true,"otherNeedIds":[12],"ref":"سورة الفرقان: 68–69","srcLabel":"القرآن الكريم","quran":{"s":25,"from":68,"to":69,"text":"وَالَّذِينَ لَا يَدْعُونَ مَعَ اللَّهِ إِلَهًا آخَرَ وَلَا يَقْتُلُونَ النَّفْسَ الَّتِي حَرَّمَ اللَّهُ إِلَّا بِالْحَقِّ وَلَا يَزْنُونَ وَمَنْ يَفْعَلْ ذَلِكَ يَلْقَ أَثَامًا (68) يُضَاعَفْ لَهُ الْعَذَابُ يَوْمَ الْقِيَامَةِ وَيَخْلُدْ فِيهِ مُهَانًا (69)","hl":[[139,254,1]]}},{"id":"س-07496","fp":"831741b98b24","stateId":587,"easy":"إذا انتحرت ← فأنت من أهل النار","cause":"فانتَزَعَ مِنها سَهمًا، فانتَحَرَ به","result":"أما إنَّه مِن أهلِ النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح البخاري 6606","srcLabel":"متفق عليه","text":["شَهِدنا مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم خَيبَرَ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم لرَجُلٍ مِمَّن معهُ يَدَّعي الإسلامَ: هذا مِن أهلِ النَّارِ. فلَمَّا حَضَرَ القِتالُ قاتَلَ الرَّجُلُ مِن أشَدِّ القِتالِ، وكَثُرَت به الجِراحُ فأثبَتَته، فجاءَ رَجُلٌ مِن أصحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّم، فقال: يا رَسولَ اللهِ، أرَأيتَ الرَّجُلَ الذي تَحَدَّثتَ أنَّه مِن أهلِ النَّارِ، قد قاتَلَ في سَبيلِ اللهِ مِن أشَدِّ القِتالِ، فكَثُرَت به الجِراحُ! فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ",["أما إنَّه مِن أهلِ النَّارِ",2],". فكادَ بَعضُ المُسلِمينَ يَرتابُ، فبينَما هو على ذلك إذ وجَدَ الرَّجُلُ ألَمَ الجِراحِ، فأهوى بيَدِه إلى كِنانَتِه، ",["فانتَزَعَ مِنها سَهمًا، فانتَحَرَ به",1],"ا، فاشتَدَّ رِجالٌ مِنَ المُسلِمينَ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقالوا: يا رَسولَ اللهِ، صَدَّقَ اللهُ حَديثَك؛ قدِ انتَحَرَ فُلانٌ فقَتَلَ نَفسَه! فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: يا بلالُ، قُمْ فأذِّنْ: لا يَدخُلُ الجَنَّةَ إلَّا مُؤمِنٌ، وإنَّ اللهَ لَيُؤَيِّدُ هذا الدِّينَ بالرَّجُلِ الفاجِرِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6606)، ومسلم (111)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"2cXWlLL0","merged":2,"otherRefs":["تخريج المسند لشعيب 17218 (صحيح)"]},{"id":"س-03027","fp":"0b98496a7c82","stateId":587,"easy":"إذا تحلمت كذباً ← تُكلّف أن تعقد شعيرة","cause":"ومَن تحلَّمَ","result":"كُلِّفَ أنْ يَعقِدَ شَعيرةً","explicit":true,"ref":"تخريج سنن أبي داود 5024","srcLabel":"أبو داود","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قال: مَن صوَّرَ صُورةً عذَّبَه اللهُ بها يومَ القيامةِ حتى يَنفُخَ فيها، وليس بنافِخٍ، ",["ومَن تحلَّمَ",1]," ",["كُلِّفَ أنْ يَعقِدَ شَعيرةً",2],"، ومَن استَمَعَ إلى حَديثِ قَومٍ يَفِرُّون به منه، صُبَّ في أُذُنِه الآنُكُ يومَ القيامةِ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (5024) واللفظ له، وأحمد (1866)، وابن حبان (5685) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"yjg5dgGL","merged":3,"otherRefs":["تخريج المسند لشعيب 1070 (حسن)","صحيح الجامع 6139 (صحيح)"]},{"id":"س-04991","fp":"24414d06d37a","stateId":587,"easy":"إذا وأدت ← فالوائدة في النار","cause":"الوائدةُ","result":"في النَّارِ","explicit":true,"similar":["س-02433"],"otherNeedIds":[11],"ref":"الصحيح المسند 452","srcLabel":"الصحيح المسند","text":["انطلَقتُ أَنا وأخي إلى رسولِ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ ، قالَ: قُلنا: يا رسولَ اللَّهِ ، إنَّ أمَّنا مُلَيْكةَ كانت تَصِلُ الرَّحمَ ، وتَقري الضَّيفَ ، وتَفعلُ ، وتَفعلُ هلَكَت في الجاهليَّةِ ، فَهَل ذلِكَ نافعُها شيئًا ؟ قالَ: لا قالَ: قُلنا: فإنَّها كانَت وأدت أختًا لَنا في الجاهليَّةِ ، فَهَل ذلِكَ نافعُها شيئًا ؟ قالَ: ",["الوائدةُ",1]," والمؤودةُ ",["في النَّارِ",2]," ، إلَّا أن تُدْرِكَ الوائدةُ الإسلامَ ، فيَعفوَ اللَّهُ عنها ."],"grade":"صحيح","narrator":"سلمة بن يزيد الأشجعي","muhaddith":"صحيح ، رجاله رجال الصحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"n6mxc2KE","merged":3,"otherRefs":["طريق الهجرتين 327 (حسن)","تخريج مشكل الآثار 11/ 154 (صحيح)"]},{"id":"س-04429","fp":"f2bf2ab7e745","stateId":587,"easy":"إذا قتلت نبياً أو قتلك نبي أو كنت إمام ضلالة أو ممثلاً ← تكون من أشد الناس عذاباً","cause":"يَومَ القيامةِ مَن قَتَلَ نَبيًّا، أو قَتَلَه نَبيٌّ، وإمامُ ضَلالةٍ، ومُمَثِّلٌ مِن المُمَثِّلينَ","result":"أشَدُّ النَّاسِ عَذابًا","explicit":true,"ref":"مجموع الشروح الفقهية. 213/30","srcLabel":"أحمد","text":[["أشَدُّ النَّاسِ عَذابًا",2],[" يَومَ القيامةِ مَن قَتَلَ نَبيًّا، أو قَتَلَه نَبيٌّ، وإمامُ ضَلالةٍ، ومُمَثِّلٌ مِن المُمَثِّلينَ",1],"."],"grade":"صحيح","narrator":"ابن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (3868)، والطحاوي في ((شرح مشكل الآثار)) (6) كلاهما بلفظه، والطبراني (10/211) (10497) بلفظ مقارب.","bab":"جهاد › عقوبة من قتله نبي أو قتل نبيا","dorar":"YReRXJ6b","merged":2,"otherRefs":["تخريج المسند لشاكر 5/333 (صحيح)"]},{"id":"س-05133","fp":"5483719ac839","stateId":587,"easy":"إذا أمّنت رجلاً على نفسه فقتلته ← تُعطى لواء الغدر يوم القيامة","cause":"مَن أمَّنَ رَجُلًا على نَفْسِه، فقَتَلَه","result":"أُعطيَ لِواءَ الغَدرِ يَومَ القيامةِ","explicit":true,"ref":"تخريج سير أعلام النبلاء 3/ 539","srcLabel":"أحمد","text":["عن رِفاعَةَ بنِ شَدَّادٍ الفِتْيانيِّ قال: كُنتُ أقومُ على رَأْسِ المُختارِ، فلمَّا تبَيَّنَتْ كِذابَتُه، هَمَمتُ وايْمُ اللهِ أنْ أسُلَّ سَيفي، فأضرِبَ عُنُقَه، حتى ذَكَرتُ حَديثًا حَدَّثَنيه عَمْرُو بنُ الحَمِقِ، قال: سمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["مَن أمَّنَ رَجُلًا على نَفْسِه، فقَتَلَه، ",1],["أُعطيَ لِواءَ الغَدرِ يَومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"عمرو بن الحمق","muhaddith":"إسناده صحيح.","takhrij":"أخرجه ابن ماجة (2688)، وأحمد (21946)، والطحاوي في ((مشكل الآثار)) (201) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"WrscSmah","merged":2,"otherRefs":["تخريج العواصم والقواصم 3/ 204 (صحيح)"]},{"id":"س-07369","fp":"acd186476a67","stateId":587,"easy":"إذا قتلت مؤمناً ← فإن الله أبى أن يجعل لك توبة (على رواية)","cause":"فضربَهُ فقتلَهُ","result":"إنَّ اللَّهَ أبى عليَّ فيمن قتلَ مُؤمنًا","explicit":true,"otherNeedIds":[12],"ref":"الصحيح المسند 948","srcLabel":"النسائي","text":["بعثَ النَّبيُّ - صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ - سَريَّةً فأغارت على القومِ . فَشذَّ رجلٌ منَ القومِ واتَّبعَهُ رجلٌ منَ السَّريَّةِ ومعَهُ سيفٌ شاهرٌ فقالَ : الشَّاذُّ منَ القومِ: إنِّي مُسلمٌ ، فلم ينظُر فيما قالَ : ",["فضربَهُ فقتلَهُ",1]," ، فنُمِيَ الحديثُ إلى النَّبيِّ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ فقالَ النَّبيُّ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ قولًا شَديدًا فبلغَ القاتلَ ، فبينَما النَّبيُّ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ يخطبُ إذ قالَ القاتلُ: واللَّهِ يا نبيَّ اللَّهِ ، ما قالَ الَّذي قالَ إلَّا تعوُّذًا منَ القَتلِ ، فأعرضَ عنهُ النَّبيُّ صلَّى اللَّهُ عليهِ وعلى آلِهِ وسلَّمَ وعمَّن يليهِ منَ النَّاسِ ، فعلَ ذلِكَ مرَّتينِ ، كلُّ ذلِكَ يُعرِضُ عنهُ النَّبيُّ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ ، فلم يصبِرْ أن قالَ الثَّالثةَ مثلَ ذلِكَ ، فأقبلَ عليهِ النَّبيُّ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ بوجهِهِ تُعرَفُ المساءةُ في وجهِهِ ، فقالُ: ",["إنَّ اللَّهَ أبى عليَّ فيمن قتلَ مُؤمنًا",2]," ثلاثَ مرَّاتٍ يقولُ ذلِكَ"],"grade":"صحيح","narrator":"عقبة بن مالك","muhaddith":"صحيح","takhrij":"أخرجه أحمد (22543)، والنسائي في ((السنن الكبرى)) (8593).","bab":"فضائل النبي وصفته ودلائل النبوة › أحوال النبي","dorar":"dSJxJn0D","merged":2,"otherRefs":["الأحاديث المختارة 2164 (صحيح)"]},{"id":"س-07851","fp":"56dac164f42b","stateId":587,"easy":"إذا قتلت لتكون العزة لفلان ← تبوء بإثمه","cause":"قتلتُهُ لتكونَ العزَّةُ لفلانٍ","result":"فإنَّها ليسَت لَهُ فيبوءُ بإثمِهِ","explicit":true,"otherNeedIds":[12],"ref":"عمدة التفسير 1/553","srcLabel":"النسائي","text":["يجيءُ المقتولُ متعلِّقًا بقاتلِهِ يومَ القيامةِ ، آخذًا رأسَهُ بيدِهِ الأُخرى فيقولُ : يا ربُّ ، سَل هذا فيمَ قتلَني ؟ قال : فيقولُ : قتلتُهُ لتكونَ العزَّةُ لَكَ . فَيقولُ : إنَّها لي . قالَ : ويَجيءُ آخرُ متعلِّقًا بقاتلِهِ فيقولُ : ربِّ ، سل هذا فيمَ قتلَني ؟ قال : فيقولُ ",["قتلتُهُ لتكونَ العزَّةُ لفلانٍ",1]," . قالَ : ",["فإنَّها ليسَت لَهُ فيبوءُ بإثمِهِ .",2]," قالَ : فيَهْوي في النَّارِ سَبعينَ خريفًا"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (3997)، والطبراني (10/119) (10075)، وأبو نعيم في ((حلية الأولياء)) (4/147) بنحوه.","bab":"قيامة › الحساب والقصاص","dorar":"EvdZtBUr","merged":2,"otherRefs":["صحيح الجامع 8029 (صحيح)"]},{"id":"س-02371","fp":"82a24da1f4eb","stateId":587,"easy":"إذا اشترك أهل السماوات والأرض في دم مؤمن ← يدخلهم الله النار","cause":"ولو أنَّ أهلَ سماواتِه وأهلَ أرضِه اشتركوا في دمِ مؤمنٍ","result":"لأَدخلَهم اللهُ النَّارَ","explicit":true,"similar":["س-03191"],"ref":"صحيح الترغيب 2438","srcLabel":"ابن ماجه","text":[["ولو أنَّ أهلَ سماواتِه وأهلَ أرضِه اشتركوا في دمِ مؤمنٍ ؛",1],[" لأَدخلَهم اللهُ النَّارَ",2]],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (2619)، وابن أبي الدنيا في ((الأهوال)) (191) بنحوه، وقوام السنة في ((الترغيب والترهيب))  (2323) مطولا واللفظ له","bab":"إسلام › حرمة المسلم","dorar":"QoF9F7x4"},{"id":"س-03191","fp":"53844feabe46","stateId":587,"easy":"إذا اشترك أهل السماء والأرض في دم مؤمن ← يكبهم الله في النار","cause":"لو أنَّ أَهلَ السَّماءِ وأَهلَ الأرضِ اشترَكوا في دمِ مؤمنٍ","result":"لأَكبَّهمُ اللَّهُ في النَّارِ","explicit":true,"repOf":"س-02371","ref":"صحيح الترمذي 1398","text":[["لو أنَّ أَهلَ السَّماءِ وأَهلَ الأرضِ اشترَكوا في دمِ مؤمنٍ",1]," ",["لأَكبَّهمُ اللَّهُ في النَّارِ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري وأبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1398)، وعبد الغني المقدسي في ((تحريم القتل وتعظيمه)) (82) واللفظ لهما.","bab":"إيمان › فضل الإيمان","dorar":"IAI4l1o2"},{"id":"س-03915","fp":"1b4102c91b85","stateId":587,"easy":"إذا قتلت مؤمناً متعمداً ← يأتي يوم القيامة آخذاً بك تشخب أوداجه دماً","cause":"قاتِلُ مؤمنٍ متعمِّدًا","result":"جاءَ يومَ القيامةِ آخذَهُ بيمينِهِ أو بشمالِهِ ، تشخَبُ أوداجُهُ في قِبَلِ عرشِ الرَّحمنِ ، يلزمُ قاتلَهُ بيدِهِ الأخرى ، يقولُ : يا ربِّ سَل هذا فيمَ قتلَني","explicit":true,"repOf":"س-03943","ref":"عمدة التفسير 1/552","text":["فأتاهُ رجلٌ فَناداهُ : يا عبدَ اللَّهِ بنَ عبَّاسٍ ، ما تَرى في رجُلٍ قتلَ مُؤمنًا متعمِّدًا ؟ فقالَ :  جَزَاؤُهُ جَهَنَّمُ خَالِدًا فِيهَا وَغَضِبَ اللَّهُ عَلَيْهِ وَلَعَنَهُ وَأَعَدَّ لَهُ عَذَابًا عَظِيمًا  قالَ : أفرأيتَ إِن تابَ وعملَ صالحًا ثمَّ اهتَدى ؟ قالَ ابنُ عبَّاسٍ : ثَكِلتهُ أمُّهُ ، وأنَّى لَهُ التَّوبةُ والهُدى ؟ والَّذي نَفسي بيدِهِ ! لقَد سَمِعْتُ نبيَّكم صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ : ثَكِلتهُ أمُّهُ ، ",["قاتِلُ مؤمنٍ متعمِّدًا",1]," ، ",["جاءَ يومَ القيامةِ آخذَهُ بيمينِهِ أو بشمالِهِ ، تشخَبُ أوداجُهُ في قِبَلِ عرشِ الرَّحمنِ ، يلزمُ قاتلَهُ بيدِهِ الأخرى ، يقولُ : يا ربِّ سَل هذا فيمَ قتلَني",2]," ؟ وأيمُ الَّذي نفسُ عبدِ اللَّهِ بيدِهِ ! لقد أُنْزِلَت هذِهِ الآيةُ ، فما نسخَتها مِن آيةٍ حتَّى قُبِضَ نبيُّكم صلَّى اللَّهُ عليهِ وسلَّمَ ، وما نَزل بعدَها مِن بُرهانٍ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (2621)، وأحمد (1941)، وابن أبي عاصم في ((الديات)) (8) واللفظ لهم","bab":"تفسير آيات › سورة النساء","dorar":"42ignlne"},{"id":"س-04553","fp":"39e7ae6bd607","stateId":587,"easy":"إذا سللت سيفك على الأمة ← فلجهنم باب لك","cause":"لمن سلَّ سيفَه على أمتي","result":"لجهنَّمَ سبعةُ أبوابٍ بابٌ منها","explicit":true,"ref":"تخريج المسند لشاكر 8/56","srcLabel":"الترمذي","text":[["لجهنَّمَ سبعةُ أبوابٍ بابٌ منها",2]," ",["لمن سلَّ سيفَه على أمتي",1]," أو قال أمةِ محمدٍ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (3123)، والبزار (5372)، وابن حبان في ((المجروحين)) (1/248) باختلاف يسير","bab":"جهنم › شدة نار جهنم وبعد قعرها","dorar":"VniSFZF2"},{"id":"س-04853","fp":"4c9ae7fff664","stateId":587,"easy":"إذا اجتمع أهل السماء والأرض على قتل امرئ ظلماً ← لعذبهم الله","cause":"اجتمع أهلُ السَّماءِ والأرضِ على قتْلِ امرئٍ","result":"لعذَّبهم اللهُ","explicit":true,"ref":"الترغيب والترهيب 3/276","srcLabel":"الطبراني","text":["قُتِل بالمدينةِ قتيلٌ على عهدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم لم يعلمْ من قتله فصعِد النَّبيُّ صلَّى اللهُ عليه وسلَّم المنبرَ فقال يا أيُّها النَّاسُ يُقتلُ قتيلٌ وأنا فيكم ولا يُعلمُ من قتله لو ",["اجتمع أهلُ السَّماءِ والأرضِ على قتْلِ امرئٍ",1]," ",["لعذَّبهم اللهُ",2]," إلَّا أن يفعلَ ما يشاءُ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني (12/133) (12681)، وابن عدي في ((الكامل في الضعفاء)) (5/367)، والبيهقي (16287) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"N7ClFSYU"},{"id":"س-05144","fp":"8914ff845868","stateId":587,"easy":"إذا اطمأن إليك رجل ثم قتلته ← يُنصب لك يوم القيامة لواء غدر","cause":"إذا اطمأنَّ الرَّجلُ إلى الرَّجلِ، ثمَّ قتَلَه بعْدَما اطمَأنَّ إليه","result":"نُصِبَ له يَومَ القيامةِ لِواءُ غَدرٍ","explicit":true,"otherNeedIds":[39],"ref":"المستدرك على الصحيحين 8251","srcLabel":"النسائي","text":["عن عامرِ بنِ شدَّادٍ، قال: كنتُ أُبطِنُ شَيئًا بالكذَّابِ أدْخُلُ عليه بسَيفي، فدخَلْتُ عليه ذاتَ يوْمٍ، فقال: جِئتَني واللهِ، ولقدْ قام جِبريلُ عن هذا الكُرسيِّ، فأهْوَيْتُ إلى قائمِ سَيفي، فقلْتُ: ما أنتَظِرُ أنْ أمشِيَ بيْن رأْسِه وجسَدِه حتَّى ذكَرتُ حدَيثًا حدَّثَناه عمْرُو بنُ الحَمِقِ رَضيَ اللهُ عنه قال: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["إذا اطمأنَّ الرَّجلُ إلى الرَّجلِ، ثمَّ قتَلَه بعْدَما اطمَأنَّ إليه",1],"؛ ",["نُصِبَ له يَومَ القيامةِ لِواءُ غَدرٍ",2],"."],"grade":"صحيح","narrator":"عمرو بن الحمق","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن ماجه (2688)، والنسائي في ((الكبرى)) (8688)، وابن أبي شيبة في ((مسنده)) (863) جميعهم باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"CUNTNVs3"},{"id":"س-07280","fp":"7822a2d47330","stateId":587,"easy":"إذا التقيت مع مسلم بسيفيكما فقتل أحدكما الآخر ← دخلتما النار","cause":"ما مَن مُسلِمَينِ التقَيا بسَيفَيهما، فقَتَلَ أحَدُهما الآخَرَ","result":"إلَّا دَخَلا جَميعًا النَّارَ","explicit":true,"repOf":"س-01561","ref":"تخريج المسند لشعيب 19609","text":["أنَّ أبا موسى الأشعَريَّ كان له أخٌ يُقالُ له: أبو رُهمٍ، وكان يَتسرَّعُ في الفِتنةِ، وكان الأشعَريُّ يَكرَهُ الفِتنةَ، فقال له: لَولا ما أبلَغتَ إليَّ ما حَدَّثتُكَ إنِّي سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["ما مَن مُسلِمَينِ التقَيا بسَيفَيهما، فقَتَلَ أحَدُهما الآخَرَ",1]," ",["إلَّا دَخَلا جَميعًا النَّارَ",2],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي (4124)، وأحمد (19609) واللفظ له","bab":"فتن › ظهور الفتن","dorar":"8RY7vHKe"},{"id":"س-02433","fp":"19504432244c","stateId":587,"easy":"إذا وأدت ولدك ← فأنت في النار","cause":"الوائدةَ","result":"فإنَّهما في النارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04991","ref":"التمهيد 18/119","text":["أتيتُ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ أنا وأخي فقلنا يا رسولَ اللهِ إنَّ أُمنا ماتتْ في الجاهليةِ وكانتْ تُقري الضيفَ وتصلُ الرحمَ وتفعلُ وتفعلُ فهلْ يَنفعُها مِنْ عملِها ذلكَ شيءٌ قال لا قال فقلْنا إنَّ أُمنا ولدتْ أختًا لنا في الجاهليةِ لمْ تبلغْ الحنثَ فهلْ ذلكَ نافعُ أختَنا فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ أرأيتمُ ",["الوائدةَ",1]," والموؤدةَ ",["فإنَّهما في النارِ",2]," إلا أنْ تُدركَ الوائدةُ الإسلامَ فيغفرُ اللهُ لها"],"grade":"صحيح","narrator":"سلمة بن يزيد الجعفي","muhaddith":"صحيح من جهة الإسناد","takhrij":"أخرجه أحمد (15965)","bab":"إسلام › فضل الشهادتين","dorar":"fEak09qd","merged":2,"otherRefs":["عمدة القاري 8/44 (صحيح)"]},{"id":"س-04989","fp":"b9eeed997772","stateId":587,"easy":"إذا قتلت صادقاً ← دخلت النار","cause":"إِن كانَ صادقًا، ثمَّ قتلتَهُ","result":"دخَلتَ النَّارَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الصحيح المسند 1257","srcLabel":"أبو داود","text":["قُتِلَ رجلٌ على عَهْدِ النَّبيِّ - صلَّى اللَّهُ عليهِ وعلى آلِهِ وسلَّمَ - فرُفِعَ ذلِكَ إلى النَّبيِّ صلَّى اللَّهُ عليهِ وعلى آلِهِ وسلَّمَ فدفعَهُ إلى وليِّ المقتولِ، فقالَ القاتلُ: يا رسولَ اللَّهِ، ما أرَدتُ قتلَهُ، قالَ: فقالَ رسولُ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ للوليِّ: أما إنَّهُ ",["إِن كانَ صادقًا، ثمَّ قتلتَهُ",1],"، ",["دخَلتَ النَّارَ",2]," قالَ: فخلَّى سَبيلَهُ، قالَ: وَكانَ مَكْتوفًا بنِسعةٍ، فخرجَ يجرُّ نِسعتَهُ فسُمِّيَ ذا النِّسعَةِ ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (4498)، والترمذي (1407)، والنسائي (4722)، وابن ماجه (2690)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"BnTICpb7","merged":2,"otherRefs":["تخريج شرح السنة 10/ 162 (صحيح)"]},{"id":"س-04259","fp":"726e09d7bd76","stateId":587,"easy":"إذا قتلت نفسك ← تبقى في النار","cause":"انطلقت أنحرُ نفسي","result":"لو فعلتَ ما زلتَ في نارِ جَهنَّمَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-01752","ref":"المحلى 8/16","text":["جاءَ رجلٌ إلى ابنِ عبَّاسٍ فقالَ لَهُ : كنت أسيرًا في أرضِ العدوِّ فنذرت إن نجَّاني اللَّهُ أن أفعلَ كذا وأن أنحرَ نفسي وإنِّي قد فعلت ذلِكَ قالَ وفي عنقِهِ قدٌّ فأقبلَ ابنُ عبَّاسٍ على امرأةٍ سألتْهُ وغفلَ عن الرَّجلِ فانطلقَ لينحَرَ نفسَهُ فسألَ ابنَ عبَّاسٍ عنْهُ فقيلَ لَهُ ذَهبَ لينحرَ نفسَهُ فقالَ عليَّ بالرَّجلِ فجاءَ فقالَ لمَّا أعرضتَ عنِّي ",["انطلقت أنحرُ نفسي",1]," فقالَ لَهُ ابنُ عبَّاسٍ ",["لو فعلتَ ما زلتَ في نارِ جَهنَّمَ",2]," انظر ديتَك فاجعلْها في بُدنٍ فأَهدِها في كلِّ عامٍ شيئًا ولولا أنَّك شدَّدتَ على نفسِك لرجوتُ أن يجزيكَ كبشٌ"],"grade":"صحيح","narrator":"سالم بن أبي الجعد","muhaddith":"في غاية الصحة","takhrij":"لم نقف عليه إلا عند ابن حزم في ((المحلى)) (6/ 262) .","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"mRMp6Chk"},{"id":"س-04292","fp":"18a0c94d16a4","stateId":587,"easy":"إذا أمّنت رجلاً ثم قتلته ← وجبت لك النار وإن كان كافراً","cause":"مَن أمَّنَ رجلًا ثمَّ قتلَهُ","result":"وجبَت لَهُ النَّارُ وإن كانَ المقتولُ كافِرًا","explicit":true,"otherNeedIds":[27],"ref":"تاريخ الإسلام 13/238","srcLabel":"الطبراني","text":[["مَن أمَّنَ رجلًا ثمَّ قتلَهُ ",1],["وجبَت لَهُ النَّارُ وإن كانَ المقتولُ كافِرًا",2]],"grade":"حسن","narrator":"معاذ","muhaddith":"[روي  بإسناد صالح عن عمرو بن الحمق]","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (2/ 215)، والطبراني (20/ 41) (64)، وابن عدي في ((الكامل في الضعفاء)) (5/ 138) بلفظه.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"pXoQnqU1"},{"id":"س-07882","fp":"bb6c235fb934","stateId":587,"easy":"إذا وأدت في الجاهلية ولم تسلم ← فأنت في النار","cause":"وقد وَأَدَتْ في الجاهليَّةِ","result":"أُمُّكُما في النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 3428","srcLabel":"أحمد","text":["جاءَ ابنا مُلَيْكةَ، وهما مِنَ الأنصارِ، فقالا: يا رسولَ اللهِ، إنَّ أُمَّنا تَحفظُ على البَعْلِ، وتُكرِمُ الضَّيفَ، ",["وقد وَأَدَتْ في الجاهليَّةِ",1]," فأين أُمُّنا؟ قالَ: «",["أُمُّكُما في النَّارِ",2],"». فقاما قد شَقَّ ذلك عليهِما فدَعاهُما رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فرَجَعا فقالَ: «إنَّ أُمِّي مع أُمِّكُما». فقالَ منافقٌ مِنَ النَّاسِ لي: ما يُغني هذا عن أُمِّهِ إلَّا ما يُغني ابنا مُلَيْكةَ عنْ أُمِّهما ونحن نَطَأُ عَقِبيهِ، فقالَ رَجلٌ شابٌّ مِنَ الأنصارِ لمْ أرَ رَجلًا كان أكثرَ سؤالًا لرسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ منه: يا رسولَ اللهِ، إنَّ أبَواكَ في النَّارِ؟ قالَ: فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «ما سألتُهُما ربِّي فيُعطيني فيهما، وإنِّي لقائمٌ يومئذٍ المَقامَ المحمودَ». قالَ: فقالَ المنافقُ للشَّابِ الأنصاريِّ: سلْهُ وما المقامُ المحمودُ؟ قالَ: يا رسولَ اللهِ، وما المقامُ المحمودُ؟ قالَ: «يومَ يَنزلُ اللهُ فيه على كُرسيِّهِ يَئطُّ به كما يَئطُّ به الرَّحْلُ مِن تضايُقِهِ كسَعةِ ما بيْنَ السَّماءِ والأرضِ، ويُجاءُ بكم حُفاةً عُراةً غُرلًا، فيكونُ أوَّلَ مَنْ يُكْسى إبراهيمُ، يقولُ اللهُ عزَّ وجلَّ: اكسُوا خليلي رَيْطَتينِ بَيضاوَيْنِ مِن رياطِ الجنَّةِ، ثُمَّ أُكْسى على أَثرِهِ فأقومُ عن يمينِ اللهِ عزَّ وجلَّ مَقامًا يَغبِطُني فيه الأوَّلونَ والآخرونَ، ويُشقُّ لي نَهَرٌ مِنَ الكوثرِ إلى حَوْضي». قالَ: يقولُ المنافقُ: لمْ أسمعْ كاليومِ قطُّ، لقَلَّ ما جرى نَهَرٌ قطُّ إلَّا وكان في فخَّارةٍ أوْ رَضْراضٍ، فسَلْه فيما يجري النَّهرُ؟ قالَ: «في حالةٍ مِنَ المِسكِ ورَضْراضٍ». قالَ: يقولُ المنافقُ: لمْ أسمعْ كاليومِ قطُّ، لقَلَّ ما جرى نَهَرٌ قطُّ إلَّا كان له نباتٌ. قالَ: «نَعَمْ». قالَ: ما هو؟ قالَ: «قُضبانُ الذَّهبِ». قالَ: يقولُ المنافقُ: لمْ أسمعْ كاليومِ قطُّ، واللهِ ما نَبَتَ قَضيبٌ قطُّ إلَّا كان له ثَمَرٌ، فسَلْهُ هل لتلك القُضبانِ ثمارٌ؟ قالَ: «نَعَمِ، اللُّؤلؤ والجَوْهرُ». قالَ: فقالَ المنافقُ: لمْ أسمعْ كاليومِ قطُّ، سَلْهُ عنْ شرابِ الحوضِ، فقالَ الأنصاريُّ: يا رسولَ اللهِ، وما شرابُ الحوضِ؟ قالَ: «أشدُّ بياضًا مِنَ اللَّبنِ، وأحلى مِنَ العَسلِ، مَنْ سقاهُ اللهُ منه شَربةً لمْ يَظْمأْ بعدَها، ومَنْ حَرَمَهُ لمْ يَروِ بعدَها»."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (3787) بلفظ مقارب، والبزار (1534)، والطبراني في ((الأوسط)) (2559) كلاهما مختصرا ببعض لفظه.","bab":"قيامة › الشفاعة","dorar":"v8A9yW64"},{"id":"س-07451","fp":"92fbaa3ddf71","stateId":587,"easy":"إذا اقتتلتم في الهرج ← فالقاتل والمقتول في النار","cause":"الهَرجُ، القاتِلُ والمَقتولُ","result":"في النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[31],"ref":"صحيح مسلم 2908","srcLabel":"مسلم","text":["والذي نَفسي بيَدِه، لا تَذهَبُ الدُّنيا حتَّى يَأتيَ على النَّاسِ يَومٌ لا يَدري القاتِلُ فيمَ قَتَلَ، ولا المَقتولُ فيمَ قُتِلَ. فقيلَ: كيفَ يَكونُ ذلك؟ قال: ",["الهَرجُ، القاتِلُ والمَقتولُ",1]," ",["في النَّارِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2908)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"dIGLYggF"},{"id":"س-07870","fp":"57719aadce58","stateId":587,"easy":"إذا أمرك أحد بقتل ظلماً ففعلت ← تُقذفان في النار جميعاً","cause":"أَمَرِني هذَا","result":"فيؤْخَذُ بأيديهِما جميعًا فيُقْذَفانِ في النارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"مجمع الزوائد 7/302","srcLabel":"الطبراني","text":["يُؤْتَى بالقاتِلِ والمقتولُ يومَ القيامَةِ فيقولُ أيْ رَبِّ سلْ هذا فيمَ قَتَلَني فيقولُ أيْ ربِّ ",["أَمَرِني هذَا",1]," ",["فيؤْخَذُ بأيديهِما جميعًا فيُقْذَفانِ في النارِ",2]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"رجاله كلهم ثقات","takhrij":"أخرجه الطبراني كما في ((جامع المسانيد)) (12098) واللفظ له، وأبو نعيم في ((الحلية)) (7/ 132)، وابن أبي عاصم في ((الديات)) (صـ9) بنحوه.","bab":"قيامة › الحساب والقصاص","dorar":"NfGEGbpV"},{"id":"س-07527","fp":"5b22f1fd5d9f","stateId":588,"easy":"إذا قُضي لك من حق أخيك شيئاً ← فلا تأخذه فإنما هو قطعة من النار","cause":"فمَن قضَيتُ له من حقِّ أخيهِ شَيئًا","result":"فلا يَأخُذْه، فإنَّما أقطَعُ له قِطعةً من النَّارِ يأتِي بها إِسْطامًا في عُنُقِه يومَ القِيامةِ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 26717","srcLabel":"متفق عليه","text":["جاء رجُلانِ من الأنصارِ يختَصِمانِ إلى رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ في مواريثَ بينَهما قد دُرِسَتْ، ليس بينَهما بيِّنةٌ، فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ: إنَّكم تَختَصِمونَ إليَّ، وإنَّما أنا بشَرٌ، ولعلَّ بعضَكُم أَلحَنُ بحُجَّتِه -أو قد قال: لِحُجَّتِه- من بعضٍ، فإنَّما أقضي بينَكم على نحوِ ما أسمَعُ، ",["فمَن قضَيتُ له من حقِّ أخيهِ شَيئًا، ",1],["فلا يَأخُذْه، فإنَّما أقطَعُ له قِطعةً من النَّارِ يأتِي بها إِسْطامًا في عُنُقِه يومَ القِيامةِ",2],". فبَكى الرَّجُلانِ، وقال كلُّ واحدٍ منهما: حقِّي لأخي، قال: فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ: أمَا إذْ قُلتُما، فاذهبا فاقتَسِما، ثمَّ توخَّيا الحقَّ، ثمَّ استَهِما، ثمَّ لِيَحْلِلْ كلُّ واحدٍ منكما صاحِبَه."],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"قوله: \"إنكم تختصمون إلي ... \" إلى قوله: \"فإنما أقطع له قطعة من النار\" صحيح","takhrij":"أخرجه البخاري (2680)، ومسلم (1713)، والترمذي (1339)، والنسائي (5401)، وابن ماجه (2317) مختصراً، وأبو داود (3583، 3584) مفرقاً، وأحمد (26717) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › اختصام المؤمنين إليه صلى الله عليه وسلم وحكمه عليهم","dorar":"Ip1bHpmQ","merged":8,"otherRefs":["مجموع فتاوى ابن عثيمين 121/3 (صحيح)","هداية الرواة 3/490 (حسن)","الفتح الرباني 5/2310 (صحيح)","الأم 8/185 (صحيح)","صحيح الترمذي 1339 (صحيح)","المحلى 9/422 (صحيح)","حلية الأولياء 3/261 (صحيح)"]},{"id":"س-02988","fp":"006ff451f919","stateId":588,"easy":"إذا غللت بعيراً أو شاة ← تأتي يوم القيامة تحمله","cause":"مَن غَلَّ فيها بَعيرًا أو شاةً","result":"أتى به يَحمِلُه يَوْمَ القِيامةِ","explicit":true,"star":true,"ref":"الأحاديث المختارة 9 / 18","srcLabel":"متفق عليه","text":["«أنَّه تَذاكَرَ هو وعُمَرُ بنُ الخَطَّابِ رَضيَ اللهُ عنه يَوْمًا الصَّدَقةَ، فقالَ عُمَرُ: أَلَمْ تَسمَعْ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ حينَ ذَكَرَ غُلولَ الصَّدَقةِ أنَّه: ",["مَن غَلَّ فيها بَعيرًا أو شاةً",1]," ",["أتى به يَحمِلُه يَوْمَ القِيامةِ",2],"؟ قالَ عَبْدُ اللهِ بنُ أُنَيْسٍ: بَلى»."],"grade":"صحيح","narrator":"عبدالله بن أنيس الجهني","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إيمان › الوعيد","dorar":"l3sJrNLR","merged":3,"otherRefs":["السلسلة الصحيحة 2354 (صحيح)","صحيح الجامع 6409 (صحيح)"]},{"id":"س-05069","fp":"c68ba4e2ccf8","stateId":588,"easy":"إذا أخذت شيئاً بغير حقه ← تأتي يوم القيامة تحمله على عاتقك","cause":"لا يأخُذُ أحدٌ منكم شيئًا بغيرِ حقِّه","result":"إلَّا جاء يومَ القيامةِ يحمِلُه على عاتقِه","explicit":true,"star":true,"similar":["س-01773","س-05119","س-01767"],"ref":"تخريج صحيح ابن حبان 4515","srcLabel":"متفق عليه","text":["استعمَل رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ابنَ اللُّتْبِيَّةِ على الصَّدقةِ فلمَّا جاء حاسَبه النَّبيُّ صلَّى اللهُ عليه وسلَّم فقال: هذا لكم وهذه هديَّةٌ أُهديت إليَّ فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ( ألا جلَسْتَ في بيتِ أبيك وأمِّك حتَّى تأتيَك هديَّتُك ) فلمَّا صلَّى رسولُ اللهِ صلَّى اللهُ عليه وسلَّم الظُّهرَ قام فخطَب فحمِد اللهَ وأثنى عليه ثمَّ قال: ( أمَّا بعدُ ما بالُ أقوامٍ نُولِّيهم أمورًا ممَّا ولَّانا اللهُ ونستعمِلُهم على أمورٍ ممَّا ولَّاني اللهُ ثمَّ يأتي أحدُهم فيقولُ: هذا لكم وهذه أُهديت إليَّ ألا جلَس في بيتِ أبيه وأمِّه حتَّى تأتيَه هديَّتُه والَّذي نفسُ محمَّدٍ بيدِه ",["لا يأخُذُ أحدٌ منكم شيئًا بغيرِ حقِّه",1]," ",["إلَّا جاء يومَ القيامةِ يحمِلُه على عاتقِه",2]," فلا أعرِفَنَّ رجلًا يحمِلُ على عنقِه يومَ القيامةِ بعيرًا له رُغاءٌ أو بقرةً لها خُوَارٌ أو شاةً تيعَرُ ) ثمَّ بسَط يدَه حتَّى رأَيْتُ بياضَ إِبْطيه بَصْرَ عيني وسَمْعَ أذني ثمَّ قال: ( ألا هل بلَّغْتُ ـ ثلاثًا ) الشَّهيدُ على ذلك زيدُ بنُ ثابتٍ الأنصاريُّ يحُكُّ مَنكِبي مَنكِبَه"],"grade":"صحيح","narrator":"أبو حميد الساعدي","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (6979)، ومسلم (1832) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"KDV1Rm55","merged":2,"otherRefs":["تخريج مشكل الآثار 4338 (حسن)"]},{"id":"س-03621","fp":"b329504b3ba5","stateId":588,"easy":"إذا كتمت مخيطاً من عمل وُليته ← فهو غُلّ تأتي به يوم القيامة","cause":"مَنِ استَعمَلْناه منكم على عملٍ فكتَمَنا مِخيَطًا","result":"فهو غُلٌّ يَأْتي به يومَ القيامةِ، فقامَ رَجلٌ منَ القومِ آدَمُ طُوالٌ منَ الأنصارِ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 17723","srcLabel":"مسلم","text":[["مَنِ استَعمَلْناه منكم على عملٍ فكتَمَنا مِخيَطًا، ",1],["فهو غُلٌّ يَأْتي به يومَ القيامةِ، فقامَ رَجلٌ منَ القومِ آدَمُ طُوالٌ منَ الأنصارِ",2],"، فقال: لا حاجةَ لي في عمَلِكَ، فقال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: لمَ؟ قال: إنِّي سمِعْتُكَ آنِفًا تقولُ، قال: وأنا أقولُ الآنَ: مَنِ استَعمَلْناه منكم على عمَلٍ، فلْيأتِ بقَليلِه وكَثيرِه، فإنْ أُتيَ بشيءٍ أخَذَه، وإنْ نُهيَ عنه انْتَهى."],"grade":"صحيح","narrator":"عدي بن عميرة الكندي","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (1833) باختلاف يسير","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"snN7lIU6","merged":3,"otherRefs":["تخريج صحيح ابن حبان 5078 (صحيح)","صحيح ابن خزيمة 4/ 91 (صحيح)"]},{"id":"س-01711","fp":"fbf74de32162","stateId":588,"easy":"إذا اقتطعت مالاً بيمين ← تلقى الله يوم القيامة أجذم","cause":"إنَّه لا يَقْتَطِعُ رَجُلٌ مالًا","result":"إلَّا لَقِيَ اللهَ عَزَّ وجَلَّ يَوْمَ القِيامةِ وهو أَجذَمُ","explicit":true,"star":true,"similar":["س-07520"],"ref":"الأحاديث المختارة 1484","srcLabel":"البخاري","text":["«أنَّ رَجُلًا مِن كِنْدةَ ورَجُلًا مِن حَضْرَمَوْتَ اخْتَصَما إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ في أرْضٍ باليَمَنِ، فقالَ الحَضْرَميُّ: يا رَسولَ اللهِ، أرْضي اغْتَصَبَها أبو هذا، فقالَ للكِنْديِّ: ما تَقولُ؟ قالَ: أقولُ إنَّ أرْضي في يَدي وَرِثْتُها مِن أبي، فقالَ للحَضْرَميِّ: هل لك مِن بَيِّنةٍ؟ قالَ: لا، ولكنْ يَحلِفُ يا رَسولَ اللهِ بالَّذي لا إلهَ إلَّا هو ما يَعلَمُ أنَّها أرْضي اغْتَصَبَها أبوه، فتَهَيَّأَ الكِنْديُّ لليَمينِ، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["إنَّه لا يَقْتَطِعُ رَجُلٌ مالًا",1]," ",["إلَّا لَقِيَ اللهَ عَزَّ وجَلَّ يَوْمَ القِيامةِ وهو أَجذَمُ",2],"، فرَدَّها الكِنْديُّ»."],"grade":"صحيح","narrator":"الأشعث بن قيس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"أقضية وأحكام › قضايا حكم فيها النبي صلى الله عليه وسلم","dorar":"Xtt1p1J0"},{"id":"س-01773","fp":"7e8afdfa230f","stateId":588,"easy":"إذا أخذت من المال العام شيئاً بغير حقه ← تلقى الله يوم القيامة تحمله","cause":"لا يَأخُذُ أحَدٌ مِنكُم منها شيئًا بغيرِ حَقِّه","result":"إلَّا لَقيَ اللَّهَ تَعالى يَحمِلُه يَومَ القيامةِ","explicit":true,"repOf":"س-05069","ref":"صحيح مسلم 1832","text":["استَعمَلَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم رَجُلًا مِنَ الأَزْدِ على صَدَقاتِ بَني سُلَيمٍ، يُدعى ابنَ الأُتْبيَّةِ، فلَمَّا جاءَ حاسَبَه، قال: هذا مالُكُم، وهذا هَديَّةٌ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: فهَلَّا جَلَستَ في بَيتِ أبيكَ وأُمِّكَ حتَّى تَأتيَكَ هَديَّتُكَ إن كُنتَ صادِقًا! ثُمَّ خَطَبَنا فحَمِدَ اللَّهَ، وأثنى عليه، ثُمَّ قال: أمَّا بَعدُ، فإنِّي أستَعمِلُ الرَّجُلَ مِنكُم على العَمَلِ ممَّا ولَّاني اللهُ، فيَأتي فيَقولُ: هذا مالُكُم، وهذا هَديَّةٌ أُهديَت لي، أفلا جَلَسَ في بَيتِ أبيه وأُمِّه حتَّى تَأتيَه هَديَّتُه إن كان صادِقًا! واللَّهِ ",["لا يَأخُذُ أحَدٌ مِنكُم منها شيئًا بغيرِ حَقِّه",1]," ",["إلَّا لَقيَ اللَّهَ تَعالى يَحمِلُه يَومَ القيامةِ",2],"، فلأعرِفَنَّ أحَدًا مِنكُم لَقيَ اللَّهَ يَحمِلُ بَعيرًا له رُغاءٌ، أو بَقَرةً لَها خوارٌ، أو شاةً تَيعَرُ، ثُمَّ رَفَعَ يَدَيه حتَّى رُئيَ بَياضُ إبْطَيه، ثُمَّ قال: اللَّهُمَّ هل بَلَّغتُ؟ بَصُرَ عَيني، وسَمِعَ أُذُني. وفي حَديثِ ابنِ نُمَيرٍ: تَعلَمُنَّ واللَّهِ، والذي نَفسي بيَدِه، لا يَأخُذُ أحَدُكُم منها شيئًا. وزادَ في حَديثِ سُفيانَ، قال: بَصُرَ عَيني، وسَمِعَ أُذُنايَ، وسَلوا زَيدَ بنَ ثابِتٍ؛ فإنَّه كان حاضِرًا مَعي. وفي روايةٍ: أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم استَعمَلَ رَجُلًا على الصَّدَقةِ، فجاءَ بسَوادٍ كَثيرٍ، فجَعَلَ يقولُ: هذا لَكُم، وهذا أُهديَ إليَّ، فذَكَرَ نَحوَه. قال عُروةُ: فقُلتُ لأبي حُمَيدٍ السَّاعِديِّ: أسَمِعتَه مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم؟ فقال: مِن فيه إلى أُذُني."],"grade":"صحيح","narrator":"أبو حميد الساعدي","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6979)، ومسلم (1832) .","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"tf6pAYlR"},{"id":"س-04490","fp":"b69637df8127","stateId":588,"easy":"إذا غللت ← فالغلول خزي عليك يوم القيامة فأدّ الخيط والمخيط","cause":"إيَّاكم والغُلولَ","result":"فإنَّ الغُلولَ خِزْيٌ على صاحِبِه يَوْمَ القِيامةِ، فأدُّوا الخَيْطَ والمِخْيَطَ وما فَوْقَ ذلك، وجاهِدوا في اللهِ القَريبَ والبَعيدَ في الحَضَرِ والسَّفَرِ، فإنَّ الجِهادَ بابٌ مِن الجنَّةِ، إنَّه يُنَجِّي","explicit":true,"similar":["س-05225","س-07872","س-04051","س-05032","س-01794","س-04849"],"ref":"الأحاديث المختارة 8 / 280","srcLabel":"متفق عليه","text":["«كانَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ يَأخُذُ الوَبَرةَ مِن جَنْبِ البَعيرِ مِن المَغنَمِ ثُمَّ يقولُ: (ما لي فيه إلَّا مِثلُ ما لأحَدِكم) ثُمَّ يقولُ: (",["إيَّاكم والغُلولَ؛ ",1],["فإنَّ الغُلولَ خِزْيٌ على صاحِبِه يَوْمَ القِيامةِ، فأدُّوا الخَيْطَ والمِخْيَطَ وما فَوْقَ ذلك، وجاهِدوا في اللهِ القَريبَ والبَعيدَ في الحَضَرِ والسَّفَرِ، فإنَّ الجِهادَ بابٌ مِن الجنَّةِ، إنَّه يُنَجِّي",2]," صاحِبَه مِن الهَمِّ والغَمِّ، وأقيموا حُدودَ اللهِ في القَريبِ والبَعيدِ، ولا تَأخُذْكم في اللهِ لَوْمةُ لائِمٍ)»."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"جهاد › فضل الجهاد","dorar":"6hPpVwtc"},{"id":"س-05119","fp":"84e15fa7051e","stateId":588,"easy":"إذا أخذت من الغنيمة شيئاً ← تأتي به يوم القيامة على رقبتك تحمله","cause":"لا يَأخُذُ أحدٌ منه شَيئًا","result":"إلَّا جاءَ به على رَقَبتِهِ يَحمِلُهُ يَومَ القيامةِ، بَعيرًا له رُغاءٌ، أو بَقَرةً لها خوارٌ، أو شاةً تَيْعَرُ","explicit":true,"repOf":"س-05069","ref":"تخريج مشكل الآثار 4340","text":["استَعمَلَ رسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ رَجُلًا مِنَ الأزْدِ يُقالُ له ابنُ الأُتبِيَّةِ على صَدَقةٍ، فلمَّا قدِمَ قال: هذا لكم، وهذا أُهديَ إليَّ. فقامَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ على المِنبَرِ، فحمِدَ اللهَ عزَّ وجلَّ، وأثْنى عليه، ثم قال: ما بالُ العامِلِ نَبعَثُهُ فيَجيءُ فيَقولُ: هذا لكم، وهذا أُهديَ إليَّ، فهَلَّا جلَسَ في بَيتِ أُمِّهِ أو بَيتِ أبيهِ فيَنظُرَ مَن يُهدي إليه، والذي نفْسُ مُحمَّدٍ بيَدِهِ، ",["لا يَأخُذُ أحدٌ منه شَيئًا",1]," ",["إلَّا جاءَ به على رَقَبتِهِ يَحمِلُهُ يَومَ القيامةِ، بَعيرًا له رُغاءٌ، أو بَقَرةً لها خوارٌ، أو شاةً تَيْعَرُ",2],". ثم رفَعَ يَدَيْهِ حتى رأيْنا عُقدةَ إبْطَيْهِ، فقال: اللَّهمَّ هل بلَّغتُ، اللَّهمَّ هل بلَّغتُ، اللَّهمَّ هل بلَّغتُ."],"grade":"صحيح","narrator":"أبو حميد الساعدي","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (2597)، ومسلم (1832) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"MFDLHhr8"},{"id":"س-05262","fp":"ff67273e5a89","stateId":588,"easy":"إذا تزوجت امرأة وأنت عازم ألا توفيها صداقها ← تلقى الله وأنت زانٍ","cause":"مَن أصْدَقَ امْرَأةً صَداقًا وهو مُجمِعٌ ألَّا يُوَفِّيَها إيَّاه","result":"لَقيَ اللهَ تعالى وهو زانٍ","explicit":true,"ref":"الأحاديث المختارة 8 / 70","srcLabel":"متفق عليه","text":["«",["مَن أصْدَقَ امْرَأةً صَداقًا وهو مُجمِعٌ ألَّا يُوَفِّيَها إيَّاه ",1],["لَقيَ اللهَ تعالى وهو زانٍ، ",2],"ومَن ادَّانَ دَيْنًا وهو مُجمِعٌ ألَّا يُوَفِّيَه لَقيَ اللهَ وهو سارِقٌ»)."],"grade":"صحيح","narrator":"‌‌صهيب بن سنان الرومي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"5LzDr6dR"},{"id":"س-05263","fp":"67b0df2565e6","stateId":588,"easy":"إذا استدنت وأنت عازم ألا توفي ← تلقى الله وأنت سارق","cause":"ومَن ادَّانَ دَيْنًا وهو مُجمِعٌ ألَّا يُوَفِّيَه","result":"لَقيَ اللهَ وهو سارِقٌ","explicit":true,"ref":"الأحاديث المختارة 8 / 70","srcLabel":"متفق عليه","text":["«مَن أصْدَقَ امْرَأةً صَداقًا وهو مُجمِعٌ ألَّا يُوَفِّيَها إيَّاه لَقيَ اللهَ تعالى وهو زانٍ، ",["ومَن ادَّانَ دَيْنًا وهو مُجمِعٌ ألَّا يُوَفِّيَه ",1],["لَقيَ اللهَ وهو سارِقٌ»)",2],"."],"grade":"صحيح","narrator":"‌‌صهيب بن سنان الرومي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"5LzDr6dR"},{"id":"س-05273","fp":"b1d8ee155928","stateId":588,"easy":"إذا قبلت هدية على تعليم القرآن ← يطوقك الله طوقاً من نار (على رواية)","cause":"فاقْبَلْها","result":"إن أرَدْتَ أن يُطَوِّقَك اللهُ طَوْقًا مِن نارٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأحاديث المختارة 8 / 252","srcLabel":"متفق عليه","text":["«كُنْتُ أُعَلِّمُ ناسًا مِن أهْلِ الصُّفَّةِ الكِتابَ والقُرآنَ، فأَهْدى إليَّ رَجُلٌ مِنهم قَوْسًا فقُلْتُ: أَرْمي عنها -وليسَتْ بمالٍ- في سَبيلِ اللهِ، ثُمَّ بَدا لي أن أَسْتَفْتيَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فاسْتَفْتَيْتُه فقُلْتُ: يا رَسولَ اللهِ إنِّي كُنْتُ أُعَلِّمُ ناسًا مِن أهْلِ الصُّفَّةِ الكِتابَ والقُرآنَ، فأَهْدى إليَّ رَجُلٌ مِنهم قَوْسًا، فقُلْتُ: أَرْمي عنها في سَبيلِ اللهِ، وليسَتْ بمالٍ، فقالَ: (",["إن أرَدْتَ أن يُطَوِّقَك اللهُ طَوْقًا مِن نارٍ ",2],["فاقْبَلْها)»",1],"."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Llf3sbNi","merged":5,"otherRefs":["صحيح ابن ماجه 1765 (صحيح)","الأحاديث المختارة 9 / 103 (صحيح)","صحيح أبي داود 3416 (صحيح)","أضواء البيان 3/27 (حسن)"]},{"id":"س-04229","fp":"cbaf81f880af","stateId":588,"easy":"إذا أخذت ضالة المسلم (لتتملكها) ← فهي حرق النار","cause":"ضالَّةَ المسلِمِ","result":"حَرقُ النَّارِ","explicit":true,"similar":["س-02380"],"ref":"نخب الافكار 16/388","srcLabel":"النسائي","text":["كنَّا قدِمنا علَى رَسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ في نَفرٍ مِن بَني عامرٍ . فقالَ: ألا أحملُكُم ؟ فَقُلتُ: إنَّا نجدُ في الطَّريقِ هوامِّي الإبلِ، فقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ: إنَّ ",["ضالَّةَ المسلِمِ",1]," ",["حَرقُ النَّارِ",2]],"grade":"صحيح","narrator":"عبدالله بن الشخير","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح معاني الآثار)) (6059) بلفظه، والنسائي في ((السنن الكبرى)) (5758)، وابن حبان (4888) كلاهما بنحوه .","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"wALBHCkD","merged":8,"otherRefs":["الأحاديث المختارة 9 / 474 (صحيح)","تخريج مشكل الآثار 4725 (حسن)","الأحكام الوسطى 2022/10/4 (صحيح)","تخريج مشكل الآثار 4723 (حسن)","تخريج مشكل الآثار 4724 (صحيح)","الأحاديث المختارة 9 / 473 (صحيح)","الإعراب عن الحيرة والالتباس 2/544 (صحيح)"]},{"id":"ق-0111","fp":"73018fd9311b","stateId":588,"easy":"العود إلى الربا ← الخلود في النار","cause":"العود إلى الربا","result":"الخلود في النار","explicit":true,"ref":"سورة البقرة: 275","srcLabel":"القرآن الكريم","quran":{"s":2,"from":275,"to":275,"text":"الَّذِينَ يَأْكُلُونَ الرِّبَا لَا يَقُومُونَ إِلَّا كَمَا يَقُومُ الَّذِي يَتَخَبَّطُهُ الشَّيْطَانُ مِنَ الْمَسِّ ذَلِكَ بِأَنَّهُمْ قَالُوا إِنَّمَا الْبَيْعُ مِثْلُ الرِّبَا وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا فَمَنْ جَاءَهُ مَوْعِظَةٌ مِنْ رَبِّهِ فَانْتَهَى فَلَهُ مَا سَلَفَ وَأَمْرُهُ إِلَى اللَّهِ وَمَنْ عَادَ فَأُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ (275)","hl":[[318,384,1]]}},{"id":"ق-0182","fp":"3005f0c9fdc4","stateId":588,"easy":"الغلول ← يأتي بما غلّ يوم القيامة","cause":"الغلول","result":"يأتي بما غلّ يوم القيامة","explicit":true,"ref":"سورة آل عمران: 161","srcLabel":"القرآن الكريم","quran":{"s":3,"from":161,"to":161,"text":"وَمَا كَانَ لِنَبِيٍّ أَنْ يَغُلَّ وَمَنْ يَغْلُلْ يَأْتِ بِمَا غَلَّ يَوْمَ الْقِيَامَةِ ثُمَّ تُوَفَّى كُلُّ نَفْسٍ مَا كَسَبَتْ وَهُمْ لَا يُظْلَمُونَ (161)","hl":[[35,89,1]]}},{"id":"ق-0204","fp":"08562d67bef2","stateId":588,"easy":"أكل أموال اليتامى ظلماً ← نار في البطون وصَلي السعير","cause":"أكل أموال اليتامى ظلماً","result":"نار في البطون وصَلي السعير","explicit":true,"ref":"سورة النساء: 10","srcLabel":"القرآن الكريم","quran":{"s":4,"from":10,"to":10,"text":"إِنَّ الَّذِينَ يَأْكُلُونَ أَمْوَالَ الْيَتَامَى ظُلْمًا إِنَّمَا يَأْكُلُونَ فِي بُطُونِهِمْ نَارًا وَسَيَصْلَوْنَ سَعِيرًا (10)","hl":[[0,125,1]]}},{"id":"ق-1418","fp":"2a88914f8683","stateId":588,"easy":"التكذيب بيوم الدين والاعتداء والإثم ← الويل","cause":"التكذيب بيوم الدين والاعتداء والإثم","result":"الويل","explicit":true,"ref":"سورة المطففين: 10–13","srcLabel":"القرآن الكريم","quran":{"s":83,"from":10,"to":13,"text":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ (10) الَّذِينَ يُكَذِّبُونَ بِيَوْمِ الدِّينِ (11) وَمَا يُكَذِّبُ بِهِ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ (12) إِذَا تُتْلَى عَلَيْهِ آيَاتُنَا قَالَ أَسَاطِيرُ الْأَوَّلِينَ (13)","hl":[[0,205,1]]}},{"id":"س-02958","fp":"8ceb41a12c80","stateId":588,"easy":"إذا غللت ولو شراكين ← يُعدّ لك مثلهما في النار","cause":"أصَبْتُ يومَئذٍ شِراكينِ","result":"يُعدَّدُ لك مِثلُهما في نارِ جهنَّمَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح ابن حبان 4852","srcLabel":"متفق عليه","text":["أهدى رفاعةُ لرسولِ اللهِ صلَّى اللهُ عليه وسلَّم غلامًا فخرَج به معه إلى خيبرَ فأتى سهمٌ غَرْبٌ فقتَله فقُلْنا: هنيئًا له الجنَّةُ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( والَّذي نفسي بيدِه الشَّملةُ لَتحترقُ عليه الآنَ في النَّارِ غَلَّها مِن المسلِمينَ يومَ خيبرَ ) فقال رجلٌ مِن الأنصارِ: يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ",["أصَبْتُ يومَئذٍ شِراكينِ",1]," قال: ( ",["يُعدَّدُ لك مِثلُهما في نارِ جهنَّمَ",2]," )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن أبي شيبة (33537) واللفظ له، والبخاري (‌4234)، ومسلم (‌115) بنحوه مطولا.","bab":"إيمان › الوعيد","dorar":"7AfObEXp","merged":2,"otherRefs":["تخريج زاد المعاد 3/307 (صحيح)"]},{"id":"س-05660","fp":"479d70857214","stateId":588,"easy":"إذا تخوضت في مال الله ورسوله بغير حق ← فلك النار","cause":"مُتَخَوِّضٍ في مالِ اللهِ ورَسولِه","result":"له النَّارُ","explicit":true,"similar":["س-07332"],"ref":"تخريج المسند لشعيب 27055","srcLabel":"أحمد","text":["عن خَولةَ، أنَّها سَمِعَت حَمزةَ يُذاكِرُ النَّبيَّ صلَّى اللهُ عليه وسلَّم الدُّنيا، فقال: «إنَّ الدُّنيا حُلوةٌ خَضِرةٌ، ورُبَّ ",["مُتَخَوِّضٍ في مالِ اللهِ ورَسولِه",1],"، ",["له النَّارُ",2],"»."],"grade":"صحيح","narrator":"خولة","muhaddith":"صحيح","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"y2vsJ1oj","merged":3,"otherRefs":["الأمالي المطلقة 179 (صحيح)","صحيح البخاري 3118 (صحيح)"]},{"id":"س-07832","fp":"10480ff2b628","stateId":588,"easy":"إذا استدنت ديناً لا تريد أداءه ← تلقى الله سارقاً","cause":"وأيُّما رجلٍ اسْتَدَانَ دَيْنًا لا يُرِيدُ أنْ يُؤَدِّيَ إلى صاحِبِه حقَّهُ ؛ خَدْعَةً حتى أَخَذَ مالهُ ، فماتَ ولمْ يَرُدَّ إليهِ دِينَهُ","result":"لَقِيَ اللهَ وهوَ سارِقٌ","explicit":true,"ref":"صحيح الترغيب 1807","srcLabel":"صحيح الترغيب","text":["أيُّما رجلٍ تَزَوَّجَ امرأةً على ما قَلَّ مِنَ المَهْرِ أوْ كَثُرَ ، ليس في نفسِهِ أنْ يُؤَدِّيَ إليها حقَّها ؛ خَدَعَها ، فماتَ ولمْ يُؤَدِّ إليها حقَّها ؛ لَقِيَ اللهَ يومَ القيامةِ وهوَ زَانٍ ، ",["وأيُّما رجلٍ اسْتَدَانَ دَيْنًا لا يُرِيدُ أنْ يُؤَدِّيَ إلى صاحِبِه حقَّهُ ؛ خَدْعَةً حتى أَخَذَ مالهُ ، فماتَ ولمْ يَرُدَّ إليهِ دِينَهُ ؛ ",1],["لَقِيَ اللهَ وهوَ سارِقٌ ",2],"."],"grade":"صحيح","narrator":"أبو ميمون الكردي","muhaddith":"صحيح","takhrij":"أخرجه ((المعجم الصغير)) (111) واللفظ له.","bab":"قرض › الترهيب من الدين","dorar":"E2T5oPo8","merged":3,"otherRefs":["صحيح الترغيب 1802 (حسن)","صحيح الجامع 2720 (صحيح)"]},{"id":"س-03074","fp":"e20ff7f8f62c","stateId":588,"easy":"إذا أخذت على تعليم القرآن قوساً (أجرة) ← يقلدك الله مكانها قوساً من نار يوم القيامة","cause":"مَنْ أخذَ علَى تعليمِ القرآنِ قوْسًا","result":"قلَّدَهُ اللهُ مكانَها قوسًا مِنْ نارِ جَهَنَّمَ يومَ القيامَةِ","explicit":true,"ref":"صحيح الجامع 5982","srcLabel":"الطبراني","text":[["مَنْ أخذَ علَى تعليمِ القرآنِ قوْسًا ، ",1],["قلَّدَهُ اللهُ مكانَها قوسًا مِنْ نارِ جَهَنَّمَ يومَ القيامَةِ",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((مسند الشاميين)) (279)، وأبو نعيم في ((حلية الأولياء)) (6/86)، والبيهقي (12020) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"RoguYiGv","merged":2,"otherRefs":["البدر المنير 8/301 (صحيح)"]},{"id":"س-05083","fp":"8668127b131b","stateId":588,"easy":"إذا مت وعليك دين ← يُقضى من حسناتك لا بالدينار والدرهم","cause":"ومَن مات وعليه دَيْنٌ","result":"فليس بالدِّينارِ ولا بالدِّرهمِ، ولكنَّها الحسَناتُ والسَّيِّئاتُ","explicit":true,"similar":["س-07836","س-07841","س-07837"],"otherNeedIds":[45],"ref":"تخريج المسند لشعيب 5385","srcLabel":"أبو داود","text":["خرَجْنا حُجَّاجًا عَشَرةً مِن أهلِ الشَّامِ، حتى أَتَيْنا مكَّةَ، فذَكَر الحديثَ، قال: فأَتَيْناهُ، فخَرَج إلينا -يعني: ابنَ عُمرَ، فقال: سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقول: مَن حالَتْ شَفاعَتُه دُونَ حدٍّ مِن حُدودِ اللهِ عزَّ وجلَّ، فقد ضادَّ اللهَ أَمْرَه، ",["ومَن مات وعليه دَيْنٌ، ",1],["فليس بالدِّينارِ ولا بالدِّرهمِ، ولكنَّها الحسَناتُ والسَّيِّئاتُ، ",2],"ومَن خاصَمَ في باطِلٍ وهو يَعْلَمُه، لم يَزَلْ في سَخَطِ اللهِ حتى يَنزِعَ، ومَن قال في مؤْمِنٍ ما ليس فيه، أَسْكَنَه اللهُ رَدْغةَ الخَبَالِ حتى يَخرُجَ ممَّا قالَ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3597)، وأحمد (5385) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"jwOzDMmj","merged":2,"otherRefs":["السلسلة الصحيحة 437 (صحيح)"]},{"id":"س-05117","fp":"f6c676ed6565","stateId":588,"easy":"إذا حلفت على مال آخر فاقتطعته بيمينك ← وجبت لك النار وبرئت منك الجنة","cause":"يحلِفُ على مالِ آخَرَ، فيقتطِعُهُ بيَمينِهِ","result":"وجَبتْ له النَّارُ، وبَرِئَتْ منه الجَنَّةُ","explicit":true,"otherNeedIds":[58],"ref":"تخريج مشكل الآثار 445","srcLabel":"مسلم","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ في الذي ",["يحلِفُ على مالِ آخَرَ، فيقتطِعُهُ بيَمينِهِ",1],": قدْ ",["وجَبتْ له النَّارُ، وبَرِئَتْ منه الجَنَّةُ",2],"."],"grade":"حسن","narrator":"أبو أمامة","muhaddith":"إسناده حسن","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (445)، ومسلم (137)، والسائي في ((السنن الكبرى) (5939) كلاهما بمعناه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ZXCd0O4g"},{"id":"س-07332","fp":"91b4c62952a9","stateId":588,"easy":"إذا تخوضت في مال الله ورسوله فيما اشتهت نفسك ← فلك النار يوم القيامة","cause":"ورُبَّ مُتخَوِّضٍ في مالِ اللهِ عزَّ وجلَّ ورسولِه صلَّى اللهُ عليه وسلَّمَ فيما اشتهَتْ نَفْسُه","result":"له النَّارُ يومَ القيامةِ","explicit":true,"repOf":"س-05660","ref":"تخريج مشكل الآثار 4887","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قال: إنَّ هذا المالَ خَضِرةٌ حُلْوةٌ، فمَن أخَذَه بحَقِّه بُورِكَ له فيه، ",["ورُبَّ مُتخَوِّضٍ في مالِ اللهِ عزَّ وجلَّ ورسولِه صلَّى اللهُ عليه وسلَّمَ فيما اشتهَتْ نَفْسُه",1],"، ",["له النَّارُ يومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في  ((شرح مشكل الآثار)) (4887) واللفظ له، وأبو يعلى (6606) باختلاف يسير.، وابن أبي خيثمة في ((التاريخ الكبير- السفر الثاني)) (1783) باختلاف يسير وزيادة في آخره.","bab":"فتن › فتنة المال","dorar":"pmFHNzzU","merged":2,"otherRefs":["صحيح الترمذي 2374 (صحيح)"]},{"id":"س-07521","fp":"286e22e083f7","stateId":588,"easy":"إذا قُضي لك بحق مسلم (وأنت تعلم بطلانه) ← فإنما هي قطعة من النار","cause":"فَمن قَضيتُ لَهُ بحقِّ مُسلِمٍ","result":"فإنَّما هيَ قطعةٌ منَ النَّارِ","explicit":true,"similar":["س-01699"],"ref":"نخب الافكار 14/488","srcLabel":"نخب الافكار","text":["جَاءَ رجُلانِ منَ الأنصارِ يختَصِمانِ إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ في مَواريثَ بينَهُما قد دَرسَت وليسَت بينَهُما بيِّنةٌ . فقالَ رَسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: إنَّما أَنا بَشرٌ فإنَّهُ يَأتيني الخَصمُ ولعلَّ بعضَكُم أن يَكونَ أبلغَ مِن بَعضٍ فأقضيَ لَهُ بذلِكَ وأحسَبُ أنَّهُ صادقٌ ",["فَمن قَضيتُ لَهُ بحقِّ مُسلِمٍ ",1],["فإنَّما هيَ قطعةٌ منَ النَّارِ",2]," فليأخُذها أو ليدَعْها . فبَكَى الرَّجلانِ وقالَ كلُّ واحدٍ منهما حقِّي لأخي الآخر فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: أمَّا إذا فَعلتُما هذا فاذهَبا فاقتسِما وتوخَّيا الحقَّ ثمَّ استَهِما ثمَّ ليُحلِلْ كلُّ واحدٍ منكُما صاحبَهُ"],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"[له] ثلاث طرق صحاح","bab":"فضائل النبي وصفته ودلائل النبوة › اختصام المؤمنين إليه صلى الله عليه وسلم وحكمه عليهم","dorar":"62Dy8l3D","merged":2,"otherRefs":["صحيح الجامع 2342 (صحيح)"]},{"id":"س-01767","fp":"40855828ee28","stateId":588,"easy":"إذا أخذت شيئاً بغير حق ← تأتي الله يوم القيامة تحمله","cause":"لا يأخذُ أحدٌ منكم شيئاًَ بغيرِ حقٍّ","result":"إلا أتى اللهَ ليحملَه - يعني يومَ القيامةِ","explicit":true,"repOf":"س-05069","ref":"غاية المرام 461","text":["وبعث الرسولُ واليًا يجمعُ صدقاتِ الأزدِ - قبيلة - فلما جاء إلى الرسولِ أمسك بعضَ ما معه وقال : هذا لكم وهذا لي هديةٌ . فغضب النبيُّ وقال : ألا جلستَ في بيتِ أبيك وبيتِ أمِّك حتى تأتيَك هديتُك إن كنتَ صادقًا ؟ ! ثم قال : مالي أستعملُ الرجلَ منكم فيقولُ : هذا لكم . وهذا لي هديةٌ ؟ ألا جلس في بيتِ أمِّه ليُهدَى له ! والذي نفسي بيدِه ، ",["لا يأخذُ أحدٌ منكم شيئاًَ بغيرِ حقٍّ",1]," ",["إلا أتى اللهَ ليحملَه - يعني يومَ القيامةِ",2]," - فلا يأتين أحدُكم يوم القيامةِ ببعيرٍ له رغاءٌ ، أو بقرةٍ لها خوارٌ ، أو بشاةٍ تيعرُ ! ! ثم رفع يديه حتى رئى بياضَ إبطيه ثم قال : اللهمَّ هل بلغتُ ؟"],"grade":"صحيح","muhaddith":"صحيح","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"kuvyLI7v"},{"id":"س-02365","fp":"ffa25215ad34","stateId":588,"easy":"إذا أخذت مال مسلم بيمين فاجرة ← فتبوأ بيتاً في النار","cause":"مَنْ أخَذَ شيئًا مِنْ مالِ امرئٍ مسلِمٍ بيمينٍ فاجِرَةٍ","result":"فلْيَتَبَوَّأْ بيتًا في النارِ","explicit":true,"similar":["س-03045"],"ref":"مجمع الزوائد 4/184","srcLabel":"الطبراني","text":["سمعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ وهو يمشي بينَ جَمْرَتَيْنِ منَ الجمارِ وهو يقولُ ",["مَنْ أخَذَ شيئًا مِنْ مالِ امرئٍ مسلِمٍ بيمينٍ فاجِرَةٍ ",1],["فلْيَتَبَوَّأْ بيتًا في النارِ",2]],"grade":"صحيح","narrator":"الحارث بن مالك بن البرصاء","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الحميدي (573)، والطحاوي في ((شرح مشكل الآثار)) (446) مختصرا بنحوه، والطبراني (3/256) (3330) واللفظ له","bab":"إسلام › حرمة المسلم","dorar":"KPl5AX6Q"},{"id":"س-02989","fp":"ea0330fcf713","stateId":588,"easy":"إذا أكلت الربا ← تُبعث يوم القيامة كالمجنون يُخنق","cause":"آكلُ الرِّبا","result":"يبعثُ يومَ القيامةِ مجنونًا يُخنَقُ","explicit":true,"similar":["س-04052"],"ref":"البدور السافرة 64","srcLabel":"البدور السافرة","text":["عنِ ابنِ عباسٍ في الآيةِ  الَّذِينَ يَأْكُلُونَ الرِّبَا  قال : ",["آكلُ الرِّبا",1]," ",["يبعثُ يومَ القيامةِ مجنونًا يُخنَقُ",2]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"إيمان › الوعيد","dorar":"9hd4wAb5"},{"id":"س-03045","fp":"1a7640a19369","stateId":588,"easy":"إذا اقتطعت مال أخيك بيمين فاجرة ← فتبوأ مقعدك من النار","cause":"مَنِ اقتَطَع مالَ أخيه المُسلِم بيَمينٍ فاجِرةٍ","result":"فلْيَتبَوَّأْ مَقعَدَه مِن النَّارِ، ليُبَلِّغْ شاهِدُكم غائِبَكم","explicit":true,"repOf":"س-02365","ref":"المستدرك على الصحيحين 8013","text":["سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ في الحَجِّ بيْنَ الجَمرَتَينِ وهو يَقولُ: ",["مَنِ اقتَطَع مالَ أخيه المُسلِم بيَمينٍ فاجِرةٍ، ",1],["فلْيَتبَوَّأْ مَقعَدَه مِن النَّارِ، ليُبَلِّغْ شاهِدُكم غائِبَكم",2],". مَرَّتَينِ أو ثَلاثًا."],"grade":"صحيح","narrator":"الحارث بن البرصاء","muhaddith":"صحيح الإسناد","bab":"إيمان › الوعيد","dorar":"xHw7UwY6"},{"id":"س-03918","fp":"eab8ba9cfd12","stateId":588,"easy":"إذا أكلت أموال اليتامى ظلماً ← تُبعث يوم القيامة وفمك يتأجج ناراً","cause":"إِنَّ الَّذِينَ يَأْكُلُونَ أَمْوَالَ الْيَتَامَى ظُلْمًا","result":"يُبعَثُ يومَ القيامةِ قومٌ مِن قبورِهم تَأَجَّجُ أفواهُهم نارًا","explicit":true,"ref":"صحيح ابن حبان 5566","srcLabel":"أبو يعلى","text":["( ",["يُبعَثُ يومَ القيامةِ قومٌ مِن قبورِهم تَأَجَّجُ أفواهُهم نارًا",2]," ) فقيل: مَن هم يا رسولَ اللهِ ؟ قال: ( ألم ترَ اللهَ يقولُ: {",["إِنَّ الَّذِينَ يَأْكُلُونَ أَمْوَالَ الْيَتَامَى ظُلْمًا",1]," إِنَّمَا يَأْكُلُونَ فِي بُطُونِهِمْ نَارًا} [النساء: 10] )"],"grade":"صحيح","narrator":"أبو برزة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو يعلى (7440)، وابن أبي حاتم في ((التفسير)) (4881) كلاهما بلفظه، وابن عدي في ((الكامل في الضعفاء)) (4/ 134)","bab":"تفسير آيات › سورة النساء","dorar":"1f4KHS8o"},{"id":"س-04274","fp":"1960d9d3d6b1","stateId":588,"easy":"إذا اقتطعت بيمينك مال مسلم ولو قضيباً من أراك ← يوجب الله لك النار","cause":"من اقتطع بيمينِه مالَ مسلمٍ ولو قضيبًا من أراكٍ","result":"أوجب اللهُ له النارَ","explicit":true,"ref":"المحلى 9/433","srcLabel":"المحلى","text":[["من اقتطع بيمينِه مالَ مسلمٍ ولو قضيبًا من أراكٍ ",1],["أوجب اللهُ له النارَ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"rV475KBn"},{"id":"س-04277","fp":"4aed7a261298","stateId":588,"easy":"إذا دخلت في أسعار المسلمين لتغليها ← كان حقاً على الله أن يقعدك بعظم من النار","cause":"مَنْ دخل في شيءٍ مِنْ أسعارِ المسلمينَ لِيُغْلِيَهُ عليهم","result":"كان حقًّا على اللهِ تبارَكَ وتعالى أنْ يَقْذِفَهُ في معظَمٍ منَ النارِ","explicit":true,"ref":"مجمع الزوائد 4/104","srcLabel":"أحمد","text":[["مَنْ دخل في شيءٍ مِنْ أسعارِ المسلمينَ لِيُغْلِيَهُ عليهم ",1],["كان حقًّا على اللهِ تبارَكَ وتعالى أنْ يَقْذِفَهُ في معظَمٍ منَ النارِ",2]],"grade":"صحيح","narrator":"معقل بن يسار","muhaddith":"فيه زيد بن مرة أبو المعلى ولم أجد من ترجمه وبقية رجاله رجال الصحيح","takhrij":"أخرجه أحمد (20313)، والطيالسي في ((المسند)) (970) واللفظ له، والطبراني (20/210) (480)","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"evV8DRmX"},{"id":"س-04665","fp":"a194fb9ce4f5","stateId":588,"easy":"إذا أكلت الربا ← فخذ سلاحك للحرب (مع الله)","cause":"لآكلِ الرِّبا","result":"خُذ سلاحَكَ للحَربِ","explicit":true,"ref":"عمدة التفسير 1/330","srcLabel":"عمدة التفسير","text":["عنِ ابنِ عبَّاسٍ قالَ : يقالُ يومَ القيامةِ ",["لآكلِ الرِّبا",1]," : ",["خُذ سلاحَكَ للحَربِ",2]," . وقرأَ :  الَّذِينَ يَأْكُلُونَ الرِّبَا لَا يَقُومُونَ إِلَّا كَمَا يَقُومُ الَّذِي يَتَخَبَّطُهُ الشَّيْطَانُ مِنَ الْمَسِّ  قالَ : وذلِكَ حينَ يقومُ مِن قبرِهِ"],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"دفن ومقابر › عذاب القبر ونعيمه","dorar":"abs4WmHX"},{"id":"س-04879","fp":"bd1ac692b91a","stateId":588,"easy":"إذا اقتطعت من حظ صاحبك ذراعاً ← تُطوّقه من سبع أرضين يوم القيامة","cause":"فيَقْتَطِعُ أحدُهما مِنْ حظِّ صاحبِهِ ذراعًا ، فإذا اقتطعَهُ","result":"طُوِّقَهُ مِنْ سبعِ أرَضينَ يومَ القيامَةِ","explicit":true,"similar":["س-05296"],"ref":"الجامع الصغير 1177","srcLabel":"الجامع الصغير","text":["أعظمُ الغُلولِ عندَ اللهِ تعالى يومَ القيامَةِ ، ذراعٌ منَ الأرضِ ، تجدونَ الرجلََّينِ جارَينِ في الأرضِ أوْ في الدارِ ، ",["فيَقْتَطِعُ أحدُهما مِنْ حظِّ صاحبِهِ ذراعًا ، فإذا اقتطعَهُ",1]," ",["طُوِّقَهُ مِنْ سبعِ أرَضينَ يومَ القيامَةِ",2]," ."],"grade":"صحيح","narrator":"أبو مالك الأشجعي سعد بن طارق","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"cIfGeib7"},{"id":"س-04980","fp":"c89c33cf0474","stateId":588,"easy":"إذا قلت في القرآن برأيك ← فتبوأ مقعدك من النار","cause":"ومَن قالَ في القُرْآنِ برَأيِه","result":"فلْيَتَبوَّأْ مَقعَدَه مِن النَّارِ","explicit":true,"ref":"الأحكام الوسطى 4/ 339","srcLabel":"الأحكام الوسطى","text":["\"اتَّقوا الحَديثَ عنِّي إلَّا ما عَلِمْتُم، فمَن كَذَبَ علَيَّ مُتَعمِّدًا فلْيَتَبوَّأْ مَقعَدَه مِن النَّارِ، ",["ومَن قالَ في القُرْآنِ برَأيِه ",1],["فلْيَتَبوَّأْ مَقعَدَه مِن النَّارِ\"",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"0CdBJsP2"},{"id":"س-05225","fp":"f95ec7668ea1","stateId":588,"easy":"إذا غللت ← تأتي يوم القيامة بما غللت من بقر وغنم ومال","cause":"الغالَّ","result":"يأتي بما غلَّ من بقرٍ وغنمٍ وصامتٍ ورِقاعٍ تخفِقُ","explicit":true,"repOf":"س-04490","ref":"فتح الباري لابن رجب 3/435","text":["أنَّ ",["الغالَّ",1]," ",["يأتي بما غلَّ من بقرٍ وغنمٍ وصامتٍ ورِقاعٍ تخفِقُ",2]," ."],"grade":"صحيح","muhaddith":"صحيح.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"IKsHOPOv"},{"id":"س-05621","fp":"8199d9590bac","stateId":588,"easy":"إذا طلبت الرزق من غير حله ← تكون أشقى الأشقياء: فقر الدنيا وعذاب الآخرة","cause":"طلبِ الرِّزقِ من غيرِ حِلِّه","result":"فإنَّ أشقَى الأشقياءِ من اجتمع عليه فقرُ الدُّنيا ، وعذابُ الآخرةِ","explicit":true,"otherNeedIds":[3],"ref":"الترغيب والترهيب 4/141","srcLabel":"الحاكم","text":["يا أيُّها النَّاسُ لا تحمِلنَّكم العُسرةُ على ",["طلبِ الرِّزقِ من غيرِ حِلِّه",1]," ، فإنِّي سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ : اللَّهمَّ تَوفَّني فقيرًا ، ولا تَوفَّني غنيًّا واحشُرْني في زُمرةِ المساكينِ ، ",["فإنَّ أشقَى الأشقياءِ من اجتمع عليه فقرُ الدُّنيا ، وعذابُ الآخرةِ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (1887)، والحاكم (7911) مختصراً باختلاف يسير، والبيهقي (13282) باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"PMLC066f"},{"id":"س-07412","fp":"6b69f619c533","stateId":588,"easy":"إذا غللت ولو بردة ← رآك النبي ﷺ في النار","cause":"في بُردةٍ غَلَّها أو عَباءةٍ","result":"كَلَّا، إنِّي رَأيتُه في النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[45],"ref":"صحيح مسلم 114","srcLabel":"أحمد","text":["لَمَّا كانَ يَومُ خَيبَرَ أقبَلَ نَفَرٌ مِن صَحابةِ النَّبيِّ صلَّى اللهُ عليه وسلَّم، فقالوا: فُلانٌ شَهيدٌ، فُلانٌ شَهيدٌ، حتَّى مَرُّوا على رَجُلٍ، فقالوا: فُلانٌ شَهيدٌ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["كَلَّا، إنِّي رَأيتُه في النَّارِ",2]," ",["في بُردةٍ غَلَّها أو عَباءةٍ",1],"، ثُمَّ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: يا ابنَ الخَطَّابِ، اذهَبْ فنادِ في النَّاسِ أنَّه لا يَدخُلُ الجَنَّةَ إلَّا المُؤمِنونَ، قال: فخَرَجتُ فنادَيتُ: ألا إنَّه لا يَدخُلُ الجَنَّةَ إلَّا المُؤمِنونَ."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (203)، وابن أبي شيبة (36885)، وابن حبان (4857)، واللفظ لهم.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"dEtLw5GQ","merged":6,"otherRefs":["تخريج المسند لشعيب 12528 (صحيح)","صحيح الترمذي 1574 (صحيح)","تخريج المسند لشعيب 20736 (صحيح)","تخريج صحيح ابن حبان 4849 (صحيح)","تخريج المسند لشاكر 1/165 (صحيح)"]},{"id":"س-07426","fp":"4ed45de1ee1e","stateId":588,"easy":"إذا لم تأكل الربا (في آخر الزمان) ← يصيبك من غباره","cause":"إلَّا أكلَ الرِّبا","result":"فإنْ لمْ يَأكلْهُ ، أصابَهُ من غُبارِهِ","explicit":true,"ref":"الجامع الصغير 7513","srcLabel":"ابن ماجه","text":["لَيَأْتِيَنَّ على الناسِ زمانٌ لا يَبْقَى مِنهُمْ أحدٌ ",["إلَّا أكلَ الرِّبا",1]," ، ",["فإنْ لمْ يَأكلْهُ ، أصابَهُ من غُبارِهِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داوود (3331)، زابن ماجه (2278)، والبزار في ((مسنده)) (9562) واللفظ لهم.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"lmrTKOvE"},{"id":"س-07520","fp":"9b45319234da","stateId":588,"easy":"إذا اقتطعت مالاً بيمين ← تلقى الله وأنت أجذم","cause":"لا يَقتَطِعُ أحَدٌ مالًا بيَمينٍ","result":"إلا لَقيَ اللهَ وهو أجذَمُ","explicit":true,"repOf":"س-01711","ref":"تخريج سنن أبي داود 3244","text":["أنَّ رَجُلًا مِن كِندةَ ورَجُلًا مِن حَضْرَمَوْتَ اختَصَما إلى النَّبيِّ صلَّى اللَّهُ عليه وسلَّمَ في أرضٍ مِنَ اليَمَنِ، فقال الحَضرَميُّ: يا رَسولَ اللَّهِ، إنَّ أرضي اغتَصَبَنيها أبو هذا، وهي في يَدِه. قال: هل لكَ بَيِّنةٌ؟ قال: لا، ولكنْ أُحَلِّفُه، واللهُ يَعلَمُ أنَّها أرضي، اغتَصَبَنيها أبوه. فتَهيَّأَ الكِنديُّ لِليَمينِ، فقال رَسولُ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ: ",["لا يَقتَطِعُ أحَدٌ مالًا بيَمينٍ",1]," ",["إلا لَقيَ اللهَ وهو أجذَمُ",2],". فقال الكِنديُّ: هي أرضُه."],"grade":"صحيح","narrator":"الأشعث بن قيس","muhaddith":"صحيح، دون قوله: \"إلا لقي الله وهو أجذم\"","takhrij":"أخرجه أحمد (21849)، والنسائي في ((السنن الكبرى)) (6002)، وابن الجارود في ((المنتقى)) (1005) باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › اختصام المؤمنين إليه صلى الله عليه وسلم وحكمه عليهم","dorar":"2pnyLyaX"},{"id":"س-07831","fp":"3975bc56fd3c","stateId":588,"easy":"إذا تزوجت امرأة على مهر وليس في نفسك أن تؤديه ← تلقى الله زانياً","cause":"أيُّما رجلٍ تَزَوَّجَ امرأةً على ما قَلَّ مِنَ المَهْرِ أوْ كَثُرَ ، ليس في نفسِهِ أنْ يُؤَدِّيَ إليها حقَّها ؛ خَدَعَها ، فماتَ ولمْ يُؤَدِّ إليها حقَّها","result":"لَقِيَ اللهَ يومَ القيامةِ وهوَ زَانٍ","explicit":true,"ref":"صحيح الترغيب 1807","srcLabel":"صحيح الترغيب","text":[["أيُّما رجلٍ تَزَوَّجَ امرأةً على ما قَلَّ مِنَ المَهْرِ أوْ كَثُرَ ، ليس في نفسِهِ أنْ يُؤَدِّيَ إليها حقَّها ؛ خَدَعَها ، فماتَ ولمْ يُؤَدِّ إليها حقَّها ؛ ",1],["لَقِيَ اللهَ يومَ القيامةِ وهوَ زَانٍ ، ",2],"وأيُّما رجلٍ اسْتَدَانَ دَيْنًا لا يُرِيدُ أنْ يُؤَدِّيَ إلى صاحِبِه حقَّهُ ؛ خَدْعَةً حتى أَخَذَ مالهُ ، فماتَ ولمْ يَرُدَّ إليهِ دِينَهُ ؛ لَقِيَ اللهَ وهوَ سارِقٌ ."],"grade":"صحيح","narrator":"أبو ميمون الكردي","muhaddith":"صحيح","takhrij":"أخرجه ((المعجم الصغير)) (111) واللفظ له.","bab":"قرض › الترهيب من الدين","dorar":"E2T5oPo8"},{"id":"س-07835","fp":"37dd00e4f72e","stateId":588,"easy":"إذا مت وأنت لا تنوي قضاء دينك ← يُؤخذ من حسناتك","cause":"ومن مات وهو لا ينوي قضاءَه","result":"فذاك الذي يُؤخَذُ من حسناتِه","explicit":true,"otherNeedIds":[2],"ref":"صحيح الترغيب 1803","srcLabel":"الطبراني","text":["الدَّينُ دَيْنانِ ، فمن مات وهو ينوي قضاءَه ؛ فأنا وليُّه ، ",["ومن مات وهو لا ينوي قضاءَه",1]," ؛ ",["فذاك الذي يُؤخَذُ من حسناتِه",2]," ، ليس يومئذٍ دينارٌ ولا درهمٌ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (13/ 336) (\n14146)","bab":"قرض › الترهيب من الدين","dorar":"71SmOwWP"},{"id":"س-07836","fp":"004b802242e4","stateId":588,"easy":"إذا مت وعليك دين ← فإنما هي الحسنات والسيئات ليس ثَمّ دينار ولا درهم","cause":"لا تموتَن َّوعليك دَيْنٌ","result":"فإنَّما هي الحسناتُ والسيِّئاتُ ، ليس ثَمَّ دينارٌ ولا درهمٌ ، وليس يظلِمُ اللهُ أحدًا","explicit":true,"repOf":"س-05083","ref":"حلية الأولياء 3/345","text":[["لا تموتَن َّوعليك دَيْنٌ ، ",1],["فإنَّما هي الحسناتُ والسيِّئاتُ ، ليس ثَمَّ دينارٌ ولا درهمٌ ، وليس يظلِمُ اللهُ أحدًا",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح ثابت من حديث المقبري عن أبي هريرة مشهور من حديث ابن عمر، وهو غريب تفرد به عبد الرحمن بن مغراء","takhrij":"أخرجه ابن أبي الدنيا كما في ((البداية والنهاية)) (17/ 305)، وابن الأعرابي في ((معجم شيوخ ابن الأعرابي)) (2/ 384)، باختلاف يسير، والطبراني في ((المعجم الأوسط)) (13504)، بلفظ مقارب.","bab":"قرض › الترهيب من الدين","dorar":"E4MeBp1H"},{"id":"س-07841","fp":"8a085ca87deb","stateId":588,"easy":"إذا مت وعليك دينار أو درهم ← يُقضى من حسناتك","cause":"مَنْ ماتَ و عليْهِ دِينارٌ أوْ دِرْهَمٌ","result":"قُضِيَ من حسناتِه ، ليْسَ ثَمَّ دِينارٌ و لا دِرهَمٌ","explicit":true,"repOf":"س-05083","ref":"صحيح الجامع 6546","text":[["مَنْ ماتَ و عليْهِ دِينارٌ أوْ دِرْهَمٌ ، ",1],["قُضِيَ من حسناتِه ، ليْسَ ثَمَّ دِينارٌ و لا دِرهَمٌ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (2414) واللفظ له، والطبراني (12/408) (13504)، وابن عدي في ((الكامل في الضعفاء)) (3/413)","bab":"قرض › الترهيب من الدين","dorar":"fVdeCZH6"},{"id":"س-07872","fp":"8654d1134255","stateId":588,"easy":"إذا غللت ← تأتي به حاملاً له على ظهرك يوم القيامة","cause":"ومَن يَغلُلْ","result":"يَأتِ به حامِلًا له على ظَهرِه يَومَ القيامةِ","explicit":true,"repOf":"س-04490","ref":"فتح البيان 2/ 367","text":["(",["ومَن يَغلُلْ",1]," يَأتِ بما غَلَّ) أي ",["يَأتِ به حامِلًا له على ظَهرِه (يَومَ القيامةِ",2],")."],"grade":"صحيح","muhaddith":"[صحيح]","bab":"قيامة › الحساب والقصاص","dorar":"cOdU0bh5"},{"id":"س-04956","fp":"d9023a19475f","stateId":588,"easy":"إذا سرقت الحجاج ← تُعذّب في النار (صاحب المحجن)","cause":"كانَ يسرِقُ الحاجَّ بمِحجنِهِ","result":"ورأيتُ صاحبَ المِحجنِ في النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح ابن خزيمة 2/ 520","srcLabel":"النسائي","text":["انكسَفتِ الشَّمسُ يومًا علَى عَهْدِ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ، فقامَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ليصلِّيَ، فقامَ حتَّى لم يَكَد أن يركعَ، ثمَّ رَكَعَ حتَّى لم يَكَد يَرفعُ رأسَهُ، ثمَّ رفعَ رأسَهُ فلم يَكَد أن يسجُدَ، ثمَّ سجدَ فلم يَكَد أن يَرفعَ رأسَهُ، فجعلَ ينفُخُ ويَبكي، ويقولُ: ربِّ، ألَم تعِدْني أن لا تعذِّبَهُم وأَنا فيهِم؟ ربِّ، ألم تعِدْني أن لا تعذِّبَهُم ونحنُ نَستغفرُكَ؟، فلمَّا صلَّى رَكْعتَينِ انجلتِ الشَّمسُ، فقامَ فحمِدَ اللَّهَ وأثنى عليهِ، وقالَ: إنَّ الشَّمسَ والقَمرَ آيتانِ من آياتِ اللَّهِ فإذا انكسَفا فافزَعوا إلى ذَكَرِ اللَّهِ، ثمَّ قالَ: لقد عُرِضَت عليَّ الجنَّةُ حتَّى لو شئتُ تعاطيتُ قِطفًا مِن قطوفُها، وعُرِضت عليَّ النَّارُ فجعلتُ أنفخُها، فَخِفْتُ أن يغشاكُم، فجعلتُ أقولُ: ربِّ، ألم تعِدني أن لا تعذِّبَهُم وأَنا فيهِم؟ ربِّ، ألم تعِدني ألا تعذِّبَهُم وَهُم يستَغفِرونَ؟، قالَ: فرأيتُ فيها الحميريَّةَ السَّوداءَ الطَّويلةَ صاحبةَ الهرَّةِ، كانت تحبسُها فلم تُطعِمها ولم تَسقِها ولا تترُكُها تأكلُ من خَشاشِ الأرضِ، فرأيتُها كلَّما أدبرَت نَهَشتها، وَكُلَّما أقبَلت نَهَشتها في النَّارِ، ورأيتُ صاحبَ السِّبتيَّتينِ أخا بَني دَعدعٍ، يُدفَعُ في النَّارِ بعصًا ذي شُعبتَينِ، ",["ورأيتُ صاحبَ المِحجنِ في النَّارِ",2]," الَّذي ",["كانَ يسرِقُ الحاجَّ بمِحجنِهِ",1],"، ويقولُ: إنِّي لا أسرقُ إنَّما يسرقُ المِحجنُ، فرأيتُهُ في النَّارِ متَّكئًا على مِحجَنِهِ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه النسائي (1482)، وابن حبان (7089) بلفظ مقارب، والحاكم (1229) بنحوه مختصرا","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"AhWp7xdI","merged":2,"otherRefs":["تخريج صحيح ابن حبان 7489 (صحيح)"]},{"id":"س-01699","fp":"bc0746bb169e","stateId":588,"easy":"إذا قُضي لك بحق أخيك (وأنت تعلم) ← فإنما هي قطعة من النار","cause":"فقضَيْتُ لهُ، وأنا أرَى أنَّه حقُّهُ، وإنَّما هو مِن حقِّ أخيهِ","result":"فإنَّما أَقْضي له بقِطعةٍ منَ النَّارِ يُطَوَّقُها مِن سَبْعِ أرَضِينَ، يأْتي بها إِسْطَامًا في عُنُقِهِ يومَ القِيامةِ","explicit":true,"repOf":"س-07521","ref":"تخريج مشكل الآثار 756","text":["أنَّ رَجُلَيْنِ منَ الأنصارِ استَأْذَنا على رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فأذِن لهما، فاختَصَما إليه في أرضٍ قدْ تقدَّم شأْنُها، وهلَك مَن يعرِفُ أمْرَها، فقال لهما رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّما أَقْضي بيْنَكما بجَهْدِ رَأْيي فيما لمْ ينزِلْ علَيَّ، وأنا أَقْضي بيْنَكما على نَحْوِ ما أسمَعُ منكما، وأيُّكما كان له في الكلامِ فَضلٌ على صاحبِهِ ",["فقضَيْتُ لهُ، وأنا أرَى أنَّه حقُّهُ، وإنَّما هو مِن حقِّ أخيهِ",1],"، ",["فإنَّما أَقْضي له بقِطعةٍ منَ النَّارِ يُطَوَّقُها مِن سَبْعِ أرَضِينَ، يأْتي بها إِسْطَامًا في عُنُقِهِ يومَ القِيامةِ",2],"، فلمَّا سَمِعَا ذلك بكَيَا جميعًا، وقال كلُّ واحدٍ منهما: يا رسولَ اللهِ: حظِّي له، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: اذهَبا فاجتَهِدا في قَسْمِ الأرضِ شَطْرَيْنِ، ثمَّ اسْتَهِمَا، فإذا أخَذ كلُّ واحدٍ منكما نَصيبَهُ فلْيُحْلِلْ أخاهُ."],"grade":"حسن","narrator":"أم سلمة أم المؤمنين","muhaddith":"إسناده حسن","bab":"أقضية وأحكام › الحكم بالكتاب والسنة ثم باجتهاد الحاكم، والخطأ معذور","dorar":"NF3Kx356"},{"id":"س-04051","fp":"08071aa3b692","stateId":588,"easy":"إذا غللت شيئاً ← تأتي به يوم القيامة","cause":"فمن غَلَّ شيئًا","result":"أُتِيَ به يومَ القيامةِ","explicit":true,"repOf":"س-04490","ref":"السلسلة الصحيحة 3313","text":["إياك والذنوبَ التي لا تُغفَرُ ، ( وفي رواية : وما لا كفارةَ من الذنوبِ ) ، ",["فمن غَلَّ شيئًا",1]," ",["أُتِيَ به يومَ القيامةِ",2]," ، وأكلَ الرِّبا ؛ فمن أكل الرِّبا بُعِثَ يومَ القيامةِ مجنونًا يتخبَّطُ ، ثم قرأ :  الَّذِينَ يَأْكُلُونَ الرِّبَا لَا يَقُومُونَ إِلَّا كَمَا يَقُومُ الَّذِي يَتَخَبَّطُهُ الشَّيْطَانُ مِنَ الْمَسِّ  [ البقرة : 275 ]"],"grade":"حسن","narrator":"عوف بن مالك الأشجعي","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (18/ 60) (110)، باختلاف يسير، والخطيب في ((تاريخ بغداد)) (9/ 53)، واللفظ له دون قول:\"\"ثم قرأ: {الذين يأكلون...\"","bab":"توبة › ما يقبل فيه التوبة وما لا يقبل","dorar":"nh8Uqpyl"},{"id":"س-04052","fp":"356999372314","stateId":588,"easy":"إذا أكلت الربا ← تُبعث يوم القيامة مجنوناً يتخبط","cause":"فمن أكل الرِّبا","result":"بُعِثَ يومَ القيامةِ مجنونًا يتخبَّطُ","explicit":true,"repOf":"س-02989","ref":"السلسلة الصحيحة 3313","text":["إياك والذنوبَ التي لا تُغفَرُ ، ( وفي رواية : وما لا كفارةَ من الذنوبِ ) ، فمن غَلَّ شيئًا أُتِيَ به يومَ القيامةِ ، وأكلَ الرِّبا ؛ ",["فمن أكل الرِّبا",1]," ",["بُعِثَ يومَ القيامةِ مجنونًا يتخبَّطُ",2]," ، ثم قرأ :  الَّذِينَ يَأْكُلُونَ الرِّبَا لَا يَقُومُونَ إِلَّا كَمَا يَقُومُ الَّذِي يَتَخَبَّطُهُ الشَّيْطَانُ مِنَ الْمَسِّ  [ البقرة : 275 ]"],"grade":"حسن","narrator":"عوف بن مالك الأشجعي","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (18/ 60) (110)، باختلاف يسير، والخطيب في ((تاريخ بغداد)) (9/ 53)، واللفظ له دون قول:\"\"ثم قرأ: {الذين يأكلون...\"","bab":"توبة › ما يقبل فيه التوبة وما لا يقبل","dorar":"nh8Uqpyl"},{"id":"س-04193","fp":"271aa3c22310","stateId":588,"easy":"إذا أخذت الربا بعد التحريم ← فلك النار خالداً فيها","cause":"فإن أخذَ من ذلكَ شيئًا ثمَّ عدا بعدَ ذلكَ","result":"فلهُ النَّارُ خالدًا مخلَّدًا فيها","explicit":true,"ref":"هداية الرواة 3/381","srcLabel":"أبو داود","text":["من أصيبَ بدمٍ أو خبلٍ والخبلُ الجرحُ فهوَ بالخيارِ بينَ إحدى ثلاثٍ فإن أرادَ الرَّابعةَ فخذوا على يديهِ بينَ أن يقتصَّ أو يعفوَ أو يأخذَ العقلَ ",["فإن أخذَ من ذلكَ شيئًا ثمَّ عدا بعدَ ذلكَ",1]," ",["فلهُ النَّارُ خالدًا مخلَّدًا فيها",2]],"grade":"حسن","narrator":"أبو شريح العدوي خويلد بن عمرو","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه أبو داود (4496)، وابن ماجه (2623)، وأحمد (16375)","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"mqdkpOWo"},{"id":"س-04809","fp":"5ef058ce0d02","stateId":588,"easy":"إذا اكتسبت مالاً من إثم فوصلت به رحمك أو تصدقت ← يُجمع ذلك كله فيُقذف في جهنم","cause":"من اكتسب مالًا من مأْثَمٍ ، فوصَل به رَحِمَه ، أو تصدَّق به ، أو أنفقَه في سبيل اللهِ","result":"جُمِعَ ذلك كلُّه جميعًا ، فقُذِفَ به في جهنَّمَ","explicit":true,"ref":"صحيح الترغيب 1721","srcLabel":"أبو داود","text":[["من اكتسب مالًا من مأْثَمٍ ، فوصَل به رَحِمَه ، أو تصدَّق به ، أو أنفقَه في سبيل اللهِ ؛ ",1],["جُمِعَ ذلك كلُّه جميعًا ، فقُذِفَ به في جهنَّمَ ",2],"."],"grade":"حسن","narrator":"القاسم بن مخيمرة","muhaddith":"حسن لغيره","takhrij":"أخرجه أبو داود في ((المراسيل)) (131) واللفظ له، وابن المبارك في ((الزهد)) (625)، وأبو بكر الدينوري في ((المجالسة وجواهر العلم)) (1491)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Sl1zscGN"},{"id":"س-05032","fp":"d3fee1a54a3e","stateId":588,"easy":"إذا غللت من الغنيمة ← تأتي به يوم القيامة","cause":"هذه مِن غَنيمَةٍ كنتُ أصَبتُها","result":"لَن أقبَلَه حتى تَكونَ أنتَ الذي تُوافِيَني به يومَ القيامَةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04490","ref":"تخريج المسند لشاكر 11/178","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّم إذا أراد أنْ يُقَسِّمَ غَنيمَةً أمَر بِلالًا رضي اللهُ تَعالى عنه فنادَى ثَلاثًا فأَتى رجُلٌ بزِمامٍ مِن شَعرٍ إلى النبيِّ صلَّى اللهُ عليه وسلَّم بعدَ أنْ قَسَّم الغَنيمَةَ فقال يا رسولَ اللهِ ",["هذه مِن غَنيمَةٍ كنتُ أصَبتُها",1]," قال أما سمِعتَ بِلالًا يُنادي ثلاثًا ؟ قال: نَعَمْ قال فما منَعكَ أنْ تَأتِيَني به ؟ فاعتَلَّ له فقال النبيُّ صلَّى اللهُ عليه وسلَّم: إنِّي ",["لَن أقبَلَه حتى تَكونَ أنتَ الذي تُوافِيَني به يومَ القيامَةِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2712)، وابن حبان (4809)، والطبراني (13/516) (14397) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"K7ClToAs"},{"id":"س-05296","fp":"1e71330ea213","stateId":588,"easy":"إذا سرقت من صاحبك ذراعاً من أرض ← تُطوّقه من سبع أرضين","cause":"فيَسرِقُ أحَدُهما مِن صاحِبِه ذِراعًا مِن أرضٍ","result":"فيُطَوَّقُه مِن سَبعِ أَرَضينَ","explicit":true,"repOf":"س-04879","ref":"تخريج المسند لشعيب 22917","text":["[«أعظَمُ الغُلولِ عِندَ اللهِ يَومَ القيامةِ ذِراعٌ مِن أرضٍ يَكونُ بَينَ الرَّجُلَينِ أو بَينَ الشَّريكَينِ للدَّارِ، فيَقتَسِمانِ، ",["فيَسرِقُ أحَدُهما مِن صاحِبِه ذِراعًا مِن أرضٍ",1]," ",["فيُطَوَّقُه مِن سَبعِ أَرَضينَ",2],"»]."],"grade":"حسن","narrator":"أبو مالك الأشجعي","muhaddith":"إسناده حسن","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"vm7H9KW2"},{"id":"س-07792","fp":"59d840144edb","stateId":588,"easy":"إذا علّمت سورة من القرآن فقبلت عليها ثوباً ← تُلبس ثوباً من نار","cause":"علَّم رجلًا سورةً منَ القرآنِ فأهدى إليه ثوبًا","result":"أُلبِستَ ثوبًا مِن نارٍ","explicit":true,"otherNeedIds":[45],"ref":"إتحاف الخيرة المهرة 6/326","srcLabel":"إتحاف الخيرة المهرة","text":["عن أُبَيِّ بنِ كعبٍ : أنه ",["علَّم رجلًا سورةً منَ القرآنِ فأهدى إليه ثوبًا",1]," , أو قال : خميصةً , قال : فذكَر ذلك للنبيِّ صلَّى اللهُ عليه وسلَّم فقال : لو أنَّكَ أخَذتَه ، أو قال : إنْ أخَذتَه شَكَّ محمدٌ ",["أُلبِستَ ثوبًا مِن نارٍ",2]],"grade":"حسن","narrator":"أبي بن كعب","muhaddith":"رجاله ثقات","bab":"قرآن › تعلم القرآن وتعليمه","dorar":"sJx6hq1W"},{"id":"س-07837","fp":"4651db90196a","stateId":588,"easy":"إذا مت وعليك دين ← يُقضى منك يوم القيامة","cause":"الدَّيْنَ","result":"يُقضَى من صاحبِهِ يومَ القيامَةِ إذا ماتَ","explicit":true,"repOf":"س-05083","otherNeedIds":[2],"ref":"الأجوبة المرضية 3/1184","text":["إنَّ ",["الدَّيْنَ",1]," ",["يُقضَى من صاحبِهِ يومَ القيامَةِ إذا ماتَ",2]," إلا من تَدَيَّنَ في ثلاثِ خِصَالٍ رجُلٌ يُضعِفُ قوتَهُ في سبيلِ الله فيستدينُ يتقَوَّى به لعدوِّ الله وعدوِّه ورجلٌ يموتُ عنده مسلمٌ لا يجِدُ ما يُكَفِّنُهُ ويُوارِيِهِ إلا بِدَيْنٍ ورجلٌ خافَ اللهُ على نفسِهِ العَزَبَةَ فينكِحُ خشيةً على دِينِهِ فإنَّ اللهَ يقضِي عن هؤلاءِ يومَ القيامةِ"],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن","takhrij":"أخرجه ابن ماجه (2435)، والبزار كما في ((الترغيب والترهيب)) للمنذري (2/375)، والبيهقي في ((شعب الإيمان)) (5559) باختلاف يسير","bab":"قرض › الترهيب من الدين","dorar":"OVPdf0Ha"},{"id":"س-07856","fp":"244225cf23c2","stateId":588,"easy":"إذا غللت مخيطاً ← تُكلّف يوم القيامة أن تأتي به","cause":"مَنْ غلَّ مخيطًا أو خَيَّاطًا","result":"كُلِّفَ يومَ القيامةِ أن يجيءَ بهِ و ليسَ بجاءٍ","explicit":true,"ref":"الجامع الصغير 4437","srcLabel":"الطبراني","text":["رُدُّوا المِخْيَطَ والخَيَّاطَ ",["مَنْ غلَّ مخيطًا أو خَيَّاطًا",1]," ",["كُلِّفَ يومَ القيامةِ أن يجيءَ بهِ و ليسَ بجاءٍ",2]],"grade":"حسن","narrator":"المستورد بن شداد","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (20/ 303) (721) واللفظ له.","bab":"قيامة › الحساب والقصاص","dorar":"3B0dNNzu"},{"id":"س-08310","fp":"051a5cc7e924","stateId":588,"easy":"إذا وُليت الصدقة فغللت ← تجيء يوم القيامة ببعير له رغاء","cause":"بَعَثَ سَعْدَ بنَ عُبادةَ مُصَدِّقًا","result":"أن تَجيءَ يَوْمَ القِيامةِ ببَعيرٍ له رُغاءٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-08309"],"ref":"الصحيح المسند 769","srcLabel":"ابن حبان","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ ",["بَعَثَ سَعْدَ بنَ عُبادةَ مُصَدِّقًا",1],"، وقالَ: «إيَّاك يا سَعْدُ ",["أن تَجيءَ يَوْمَ القِيامةِ ببَعيرٍ له رُغاءٌ",2],"»، فقالَ: لا أَجِدُه ولا أَجيءُ به، فأَعْفاه."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح، رجاله رجال الصحيح","takhrij":"أخرجه أبو يعلى في ((معجمه)) (110)، والطبري في ((التفسير)) (6/ 206)، وابن حبان (2429) واللفظ لهم.","bab":"مناقب وفضائل › سعد بن عبادة","dorar":"jekNlYUy"},{"id":"س-01794","fp":"fee497fe4877","stateId":588,"easy":"إذا غللت شيئاً ← تأتي به يوم القيامة تحمله على عنقك","cause":"لا يَغُلُّ أحَدُكُم مِنها شيئًا","result":"إلَّا جاءَ به يَومَ القيامةِ يَحمِلُه على عُنُقِه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-04490","ref":"صحيح البخاري 6636","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم استَعمَلَ عامِلًا، فجاءَه العامِلُ حينَ فرَغَ مِن عَمَلِه، فقال: يا رَسولَ اللهِ، هذا لَكُم، وهذا أُهديَ لي. فقال له: أفَلا قَعَدتَ في بَيتِ أبيك وأُمِّك فنَظَرتَ أيُهدى لك أم لا؟! ثُمَّ قامَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم عَشيَّةً بَعدَ الصَّلاةِ، فتَشَهَّدَ وأثنى على اللهِ بما هو أهلُه، ثُمَّ قال: أمَّا بَعدُ، فما بالُ العامِلِ نَستَعمِلُه فيَأتينا فيَقولُ: هذا مِن عَمَلِكُم، وهذا أُهديَ لي؟! أفَلا قَعَدَ في بَيتِ أبيه وأُمِّه فنَظَرَ هل يُهدى له أم لا؟! فوالذي نَفسُ مُحَمَّدٍ بيَدِه ",["لا يَغُلُّ أحَدُكُم مِنها شيئًا",1]," ",["إلَّا جاءَ به يَومَ القيامةِ يَحمِلُه على عُنُقِه",2],"؛ إن كان بَعيرًا جاءَ به له رُغاءٌ، وإن كانَت بَقَرةً جاءَ بها لها خُوارٌ، وإن كانَت شاةً جاءَ بها تَيعَرُ، فقد بَلَّغتُ. فقال أبو حُمَيدٍ: ثُمَّ رَفَعَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يَدَه، حتَّى إنَّا لَنَنظُرُ إلى عُفرةِ إبْطَيه."],"grade":"صحيح","narrator":"أبو حميد الساعدي","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1832) باختلاف يسير","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"hm14eIXT","merged":4,"otherRefs":["صحيح البخاري 7174 (صحيح)","صحيح مسلم 1832 (صحيح)","صحيح ابن خزيمة 4/ 92 (صحيح)"]},{"id":"س-02380","fp":"e5cc3bc5ca05","stateId":588,"easy":"إذا أخذت ضالة المؤمن (بلا تعريف) ← فهي حرق النار","cause":"ضالَّةُ المُؤمِنِ","result":"حَرَقُ النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-04229","ref":"الأحاديث المختارة 9 / 473","text":["«",["ضالَّةُ المُؤمِنِ",1]," ",["حَرَقُ النَّارِ",2],"»."],"grade":"صحيح","narrator":"‌‌عبدالله بن الشخير","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إسلام › حرمة المسلم","dorar":"zRsu1bMh"},{"id":"س-04849","fp":"26a90500f43d","stateId":588,"easy":"إذا غللت ← تجيء يوم القيامة وعلى رقبتك بعير له رغاء","cause":"فذَكَرَ الغُلولَ، فعَظَّمَه وعَظَّمَ أمرَه","result":"لا أُلفيَنَّ أحَدَكُم يَجيءُ يَومَ القيامةِ على رَقَبَتِه بَعيرٌ له رُغاءٌ، يقولُ: يا رَسولَ اللهِ، أغِثْني، فأقولُ: لا أملِكُ لكَ شيئًا، قد أبلَغتُكَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-04490","ref":"صحيح مسلم 1831","text":["قامَ فينا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم ذاتَ يَومٍ، ",["فذَكَرَ الغُلولَ، فعَظَّمَه وعَظَّمَ أمرَه",1],"، ثُمَّ قال: ",["لا أُلفيَنَّ أحَدَكُم يَجيءُ يَومَ القيامةِ على رَقَبَتِه بَعيرٌ له رُغاءٌ، يقولُ: يا رَسولَ اللهِ، أغِثْني، فأقولُ: لا أملِكُ لكَ شيئًا، قد أبلَغتُكَ",2],"، لا أُلفيَنَّ أحَدَكُم يَجيءُ يَومَ القيامةِ على رَقَبَتِه فرَسٌ له حَمحَمةٌ، فيَقولُ: يا رَسولَ اللهِ، أغِثْني، فأقولُ: لا أملِكُ لكَ شيئًا، قد أبلَغتُكَ، لا أُلفيَنَّ أحَدَكُم يَجيءُ يَومَ القيامةِ على رَقَبَتِه شاةٌ لَها ثُغاءٌ، يقولُ: يا رَسولَ اللهِ، أغِثْني، فأقولُ: لا أملِكُ لكَ شيئًا، قد أبلَغتُكَ، لا أُلفيَنَّ أحَدَكُم يَجيءُ يَومَ القيامةِ على رَقَبَتِه نَفسٌ لَها صياحٌ، فيَقولُ: يا رَسولَ اللهِ، أغِثْني، فأقولُ: لا أملِكُ لكَ شيئًا، قد أبلَغتُكَ، لا أُلفيَنَّ أحَدَكُم يَجيءُ يَومَ القيامةِ على رَقَبَتِه رِقاعٌ تَخفِقُ، فيَقولُ: يا رَسولَ اللهِ، أغِثْني، فأقولُ: لا أملِكُ لكَ شيئًا، قد أبلَغتُكَ، لا أُلفيَنَّ أحَدَكُم يَجيءُ يَومَ القيامةِ على رَقَبَتِه صامِتٌ، فيَقولُ: يا رَسولَ اللهِ، أغِثني، فأقولُ: لا أملِكُ لكَ شيئًا، قد أبلَغتُكَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3073)، ومسلم (1831).","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"NTy7sy0P"},{"id":"س-04997","fp":"b50aa374929b","stateId":588,"easy":"إذا تعاملت بالصرف الربوي ← أبشر بالنار (أثر)","cause":"مَعشَرَ الصَّيارِفةِ","result":"أَبْشِروا بالنَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الأحاديث المختارة 13 / 126","srcLabel":"متفق عليه","text":["القاسِمُ بنُ عَبْدِ الواحِدِ الوَزَّانُ، قالَ: «رَأيْتُ عَبْدَ اللهِ بنَ أبي أَوْفى في السُّوقِ في الصَّيارِفةِ، فقالَ: يا ",["مَعشَرَ الصَّيارِفةِ",1]," أَبْشِروا، قالوا: بَشَّرَك اللهُ بالجنَّةِ، بما تُبَشِّرُنا يا أبا مُحمَّدٍ؟ قالَ: قالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["أَبْشِروا بالنَّارِ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن أبي أوفى","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"2um1UZ7s"},{"id":"س-05283","fp":"1f6fa3f4a0c9","stateId":588,"easy":"إذا غللت ولو ديناراً ← لا يُصلّى عليك","cause":"فأصيبَت دينارٌ أو ديناران","result":"صَلُّوا على صاحِبِكم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سبل الهدى والرشاد 8/376","srcLabel":"أحمد","text":["توفِّيَ رجلٌ على عهدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقال: انظُروا داخِلةَ إزارِه «",["فأصيبَت دينارٌ أو ديناران",1],"»، فقال لنا «",["صَلُّوا على صاحِبِكم",2],"»"],"grade":"حسن","narrator":"أبو أمامة","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني ((8/ 105)) (7506) بنحوه، وأحمد (22221)، والبيهقي في ((شعب الإيمان)) (3238) مختصرا","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"veeEp5Fr"},{"id":"س-07853","fp":"4618db5eaba6","stateId":588,"easy":"إذا غششت اللبن بالماء ← تُكلّف يوم القيامة أن تخلصه","cause":"قد خلطه بالماءِ","result":"كيف بك إذا قيل لك يومَ القيامةِ خلِّصِ الماءَ من اللَّبنِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الترغيب والترهيب 3/32","srcLabel":"البيهقي","text":["أنَّ أبا هريرةَ رضِي اللهُ عنه مرَّ بناحيةِ الحَرَّةِ فإذا إنسانٌ يحمِلُ لبنًا يبيعُه فنظر إليه أبو هريرةَ فإذا هو ",["قد خلطه بالماءِ",1]," فقال له أبو هريرةَ ",["كيف بك إذا قيل لك يومَ القيامةِ خلِّصِ الماءَ من اللَّبنِ",2]],"grade":"حسن","narrator":"صفوان بن سليم","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه الأصبهاني في ((الترغيب والترهيب)) (252) بلفظه، والبيهقي في ((شعب الإيمان)) (4927) باختلاف يسير.","bab":"قيامة › الحساب والقصاص","dorar":"QjiO2ZDw"},{"id":"س-08309","fp":"775eebe8c205","stateId":588,"easy":"إذا وُليت الصدقة فغللت منها ← تأتي يوم القيامة بما غللت على رقبتك","cause":"قُمْ علَى صَدقةِ بَني فلانٍ","result":"لا تأتي يومَ القِيامةِ ببقرٍ تحمِلُه على رقَبتِك لهُ رغاءٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-08310","ref":"البحر الزخار 9/190","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ قالَ لي : ",["قُمْ علَى صَدقةِ بَني فلانٍ",1]," ، وانظُر ",["لا تأتي يومَ القِيامةِ ببقرٍ تحمِلُه على رقَبتِك لهُ رغاءٌ",2]," ، قال : اقبَل عنِّي صدقتَكَ ، فقبِلَها عنه"],"grade":"حسن","narrator":"سعد بن عبادة","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (22461)، وابن قانع في ((معجم الصحابة)) (1/ 248)، والطبراني (6/ 17)، (5363) جميعهم بلفظه.","bab":"مناقب وفضائل › سعد بن عبادة","dorar":"9l2x24yl"},{"id":"س-02997","fp":"292f3fb8ceae","stateId":588,"easy":"إذا كنت تاجراً ← تُحشر مع الفجار إلا إن اتقيت ربك وبررت وصدقت","cause":"التُّجَّارِ","result":"تُحشرون مع الفُجَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[12],"ref":"مسند علي 47","srcLabel":"الطبري","text":["يا معشرَ ",["التُّجَّارِ",1]," ",["تُحشرون مع الفُجَّارِ",2]," إلا منِ اتَّقى ربَّه وصدق"],"grade":"صحيح","narrator":"رفاعة بن رافع","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبري في ((تهذيب الآثار - علي)) (94) بلفظه","bab":"إيمان › الوعيد","dorar":"kjjNw4tH"},{"id":"س-07620","fp":"5a1485f1ee44","stateId":588,"easy":"إذا أكلت الربا ← تسبح في نهر الدم وتُلقم الحجارة","cause":"آكِلُ الرِّبا","result":"رَجُلًا يَسبَحُ في نَهرٍ ويُلقَمُ الحِجارةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج المسند لشعيب 20101","srcLabel":"أحمد","text":["رَأَيتُ لَيلةَ أُسريَ بي ",["رَجُلًا يَسبَحُ في نَهرٍ ويُلقَمُ الحِجارةَ",2],"، فسَأَلتُ: ما هذا؟ فقِيلَ لي: ",["آكِلُ الرِّبا",1],"."],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"صحيح","takhrij":"أخرجه أحمد (20101) واللفظ له، والحارث في ((المسند)) (736)، والروياني في ((المسند)) (836) مطولاً","bab":"فضائل النبي وصفته ودلائل النبوة › معجزات النبي","dorar":"CzlMn5qU"},{"id":"س-08083","fp":"17e59d4bfbcf","stateId":588,"easy":"إذا زدت في العقوبة ← يُقتص منك","cause":"وإن زِدْتَ","result":"اقْتُصَّ مِنك","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"علل ابن أبي حاتم 2342","srcLabel":"الترمذي","text":["حَديثٌ رَواه قُرادٌ، عن اللَّيْثِ، عن مالِكٍ، عن الزُّهْريِّ، عن عُرْوةَ، عن عائِشةَ، عن النَّبيِّ صلَّى اللهُ عليه وسلَّم: أنَّ رَجُلًا أتى النَّبيَّ صلَّى اللهُ عليه وسلَّم، فقالَ: إنَّ لي مَماليكَ أَضرِبُهم، قالَ: إن ضَرَبْتَهم بقَدْرِ ذَنْبِهم فلا بَأسَ، ",["وإن زِدْتَ",1]," ",["اقْتُصَّ مِنك",2],"، فقالَ الرَّجُلُ: فمَماليكي أحْرارٌ، لا أَملِكُ بَعْدَ اليَوْمِ؟"],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"نَرى أنَّ قُراد غَلِطَ، بَحَثْنا عن هذا الحَديثِ مِن حَديثِ مالِكٍ، ولم نُصِبْ له أصْل، وبَحَثْنا مِن حَديثِ اللَّيْثِ، فإذا حَدَّثَنا أبو صالِحٍ، عن اللَّيْثِ، عن ابنِ الهادِ، عن زِيادٍ مَوْلى ابنِ عيَّاشٍ: أنَّ رَجُلُا أتى النَّبيَّ صلَّى اللهُ عليه وسلَّم...","takhrij":"أخرجه الترمذي (3165)، والبيهقي في ((الشعب)) (8223)، وتمام في ((فوائده)) (1192) ثلاثتهم بمعناه.","bab":"مظالم › قصاص المظالم","dorar":"5zKqZaFE"}]}