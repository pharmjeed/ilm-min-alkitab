{"schema":1,"kind":"sunan-chunk","version":"sunan-820d161722ab","needId":2,"stateIds":[20,21],"items":[{"id":"س-04923","fp":"4219616ab407","stateId":20,"easy":"إذا أخذت أموال الناس تريد أداءها ← يؤدّيها الله عنك","cause":"مَن أخَذَ أموالَ النَّاسِ يُريدُ أداءَها","result":"أدَّى اللهُ عنه","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 9407","srcLabel":"البخاري","text":[["مَن أخَذَ أموالَ النَّاسِ يُريدُ أداءَها، ",1],["أدَّى اللهُ عنه",2],"، ومَن أخَذَها يُريدُ -يَعني- تَلَفَها، أتلَفَه اللهُ عزَّ وجلَّ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (2387) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"m1Lb2310"},{"id":"س-07108","fp":"53bf43e6a90a","stateId":20,"easy":"إذا دعوت بدعاء «اللهم مالك الملك...» ← يقضي الله دينك ولو كان مثل جبل","cause":"اللَّهُمَّ مالِكَ المُلْكِ، تُؤْتي المُلْكَ مَن تَشاءُ، وتَنزِعُ المُلْكَ مِمَّن تَشاءُ، وتُعِزُّ مَن تَشاءُ، وتُذِلُّ مَن تَشاءُ، بيَدِك الخَيْرُ إنَّك على كلِّ شيءٍ قَديرٌ، رَحْمانُ الدُّنْيا والآخِرةِ ورَحيمُهما، تُعْطيهما مَن تَشاءُ، وتَمنَعُ مِنهما مَن تَشاءُ، ارْحَمْني رَحْمةً تُغْنيني بها عن رَحْمةِ مَن سِواك","result":"لو كانَ عليك مِثلُ جَبَلٍ دَيْنًا لأدَّاه اللهُ عنك","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"star":true,"apply":{"k":"say","t":"«اللَّهُمَّ مالِكَ المُلْكِ، تُؤْتي المُلْكَ مَن تَشاءُ، وتَنزِعُ المُلْكَ مِمَّن تَشاءُ، وتُعِزُّ مَن تَشاءُ، وتُذِلُّ مَن تَشاءُ، بيَدِك الخَيْرُ إنَّك على كلِّ شيءٍ قَديرٌ، رَحْمانُ الدُّنْيا والآخِرةِ ورَحيمُهما، تُعْطيهما مَن تَشاءُ، وتَمنَعُ مِنهما مَن تَشاءُ، ارْحَمْني رَحْمةً تُغْنيني بها عن رَحْمةِ مَن سِواك»"},"ref":"الأحاديث المختارة 2633","srcLabel":"متفق عليه","text":["«قالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ لمُعاذِ بنِ جَبَلٍ: ألَا أُعَلِّمُك دُعاءً تَدْعو به، ",["لو كانَ عليك مِثلُ جَبَلٍ دَيْنًا لأدَّاه اللهُ عنك",2],"؟ قُلْ يا مَعاذُ: ",["اللَّهُمَّ مالِكَ المُلْكِ، تُؤْتي المُلْكَ مَن تَشاءُ، وتَنزِعُ المُلْكَ مِمَّن تَشاءُ، وتُعِزُّ مَن تَشاءُ، وتُذِلُّ مَن تَشاءُ، بيَدِك الخَيْرُ إنَّك على كلِّ شيءٍ قَديرٌ، رَحْمانُ الدُّنْيا والآخِرةِ ورَحيمُهما، تُعْطيهما مَن تَشاءُ، وتَمنَعُ مِنهما مَن تَشاءُ، ارْحَمْني رَحْمةً تُغْنيني بها عن رَحْمةِ مَن سِواك",1],"».\nقالَ الطَّبَرانِيُّ: لم يَرْوِه عن الزُّهْرِيِّ إلَّا يونُسُ، ولا عنه إلَّا وَهْبُ اللهِ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"علم › تعليم الناس وفضل ذلك","dorar":"harp7m5M"},{"id":"س-07113","fp":"714aefe57edb","stateId":20,"easy":"إذا دعوت «اللهم اكفني بحلالك عن حرامك وأغنني بفضلك عمن سواك» ← يقضي الله دينك ولو كان مثل جبل","cause":"اللَّهُمَّ اكْفِني بحَلالِك، عن حَرامِك، وأَغْنِني بفَضْلِك عمَّن سِواك","result":"لو كانَ عليك مِثلُ جَبَلِ صيرٍ دَنانيرَ لَأدَّاه اللهُ عنك","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"star":true,"apply":{"k":"say","t":"«اللهم اكفني بحلالك عن حرامك وأغنني بفضلك عمن سواك»"},"ref":"الأحاديث المختارة 489","srcLabel":"البخاري","text":["«أتى علِيًّا رَجُلٌ، فقالَ: يا أميرَ المُؤمِنينَ، إنِّي عَجَزْتُ عن مُكاتَبتي، فأَعِنِّي، فقالَ: أَلَا أُعَلِّمُك كَلِماتٍ عَلَّمَنيهنَّ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["لو كانَ عليك مِثلُ جَبَلِ صيرٍ دَنانيرَ لَأدَّاه اللهُ عنك",2],"؟ قُل: ",["اللَّهُمَّ اكْفِني بحَلالِك، عن حَرامِك، وأَغْنِني بفَضْلِك عمَّن سِواك",1],"»."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"علم › تعليم الناس وفضل ذلك","dorar":"q8qzL2r9"},{"id":"س-03129","fp":"0e0f452ab53c","stateId":20,"easy":"إذا دعوت بدعاء «اللهم فارج الهم كاشف الغم...» ← يقضي الله عنك دَينك","cause":"اللَّهُمَّ فارِجَ الهَمِّ، كاشِفَ الغَمِّ، مُجيبَ دَعوةِ المُضطَّرينَ، رحمانَ الدُّنيا والآخرةِ ورَحيمَهُما، أنتَ تَرحمُني، فارْحمْني برحمةٍ تُغنيني بها عنْ رحمةِ مَنْ سِواكَ","result":"لقَضاهُ اللهُ عنه","explicit":true,"apply":{"k":"say","t":"«اللهم فارج الهم كاشف الغم...»"},"otherNeedIds":[4],"ref":"المستدرك على الصحيحين 1922","srcLabel":"البيهقي","text":["دَخَلَ عَلَيَّ أبو بكرٍ، فقالَ: هل سَمِعْتِ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ دُعاءً علَّمَنيهِ؟ قلتُ: ما هو؟ قالَ: كان عيسى بنُ مريمَ يُعلِّمُه أَصحابَه، قالَ: لوْ كان على أَحدِكُم جَبلُ ذهبٍ دَينًا، فدَعا اللهَ بذلك ",["لقَضاهُ اللهُ عنه",2],": ",["اللَّهُمَّ فارِجَ الهَمِّ، كاشِفَ الغَمِّ، مُجيبَ دَعوةِ المُضطَّرينَ، رحمانَ الدُّنيا والآخرةِ ورَحيمَهُما، أنتَ تَرحمُني، فارْحمْني برحمةٍ تُغنيني بها عنْ رحمةِ مَنْ سِواكَ",1],". قالَ أبو بكرٍ الصِّدِّيقُ: وكانت عَلَيَّ بَقيَّةٌ مِن الدَّينِ، وكنتُ للدَّينِ كارهًا، فكنتُ أَدعو بذلك، فأَتاني اللهُ بفائدةٍ، فقَضاهُ اللهُ عنِّي، قالتْ عائشةُ: لأسماءَ بنتِ عُميسٍ عَلَيَّ دينارٌ وثلاثةُ دراهمَ، فكانتْ تَدخُلُ عَلَيَّ فأَستحيي أنْ أَنظُرَ في وَجهِها؛ لأنِّي لا أَجِدُ ما أَقضيها، فكنتُ أَدعو بذلك، فما لَبِثْتُ إلَّا يَسيرًا حتَّى رَزَقني اللهُ رِزقًا ما هو بصدقةٍ تُصُدِّقَ بها عَلَيَّ، ولا ميراثٍ ورِثتُهُ، وقَضاهُ اللهُ عنِّي، وقَسَمتُ في أهلي قَسْمًا حَسنًا، وحلَّيتُ ابنةَ عبدِ الرَّحمنِ بثلاثِ أَواقٍ وَرِقٍ، وفَضَلَ لنا فَضْلٌ حَسنٌ."],"grade":"صحيح","narrator":"عائشة","muhaddith":"صحيح","takhrij":"أخرجه إسماعيل الأصفهاني في ((الترغيب والترهيب)) (1281) بلفظه، والبيهقي في ((دلائل النبوة)) (6/ 172) باختلاف يسير.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"Xf43XcXB"},{"id":"س-07843","fp":"0270ca99bfab","stateId":20,"easy":"إذا اجتهدت في قضاء دَينك ← يؤدّيه الله عنك","cause":"من حُمِّلَ من أمَّتي دَينًا ثمَّ جَهدَ في قضائِهِ ثم ماتَ قبل أن يقضيَهِ فأنا وليُّهُ ما من أحدٍ يدَّانُ دَينًا يعلمَ اللَّهُ أنَّهُ يريدُ قضاءَهُ","result":"إلَّا أدَّاهُ اللَّهُ عنْهُ في الدُّنيا","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 1/248","srcLabel":"النسائي","text":[["من حُمِّلَ من أمَّتي دَينًا ثمَّ جَهدَ في قضائِهِ ثم ماتَ قبل أن يقضيَهِ فأنا وليُّهُ ما من أحدٍ يدَّانُ دَينًا يعلمَ اللَّهُ أنَّهُ يريدُ قضاءَهُ ",1],["إلَّا أدَّاهُ اللَّهُ عنْهُ في الدُّنيا",2]],"grade":"صحيح","narrator":"أم المؤمنين ميمونة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (4686)، وابن ماجه (2408) باختلاف يسير","bab":"قرض › من ضمن دين ميت","dorar":"vKkm6pZG"},{"id":"س-04157","fp":"b8683bdbe66f","stateId":20,"easy":"إذا عجزت عن قضاء الدين فاستعن بالله «يا مولاي» ← يقضيه عنك (من فعل الزبير)","cause":"إلَّا قُلتُ: يا مَولى الزُّبَيرِ اقضِ عنه دَينَه","result":"فيَقضيه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«يا مولاي»"},"otherNeedIds":[29],"ref":"صحيح البخاري 3129","srcLabel":"الحاكم","text":["لَمَّا وقَفَ الزُّبَيرُ يَومَ الجَمَلِ دَعاني، فقُمتُ إلى جَنبِه فقال: يا بُنَيِّ، إنَّه لا يُقتَلُ اليومَ إلَّا ظالِمٌ أو مَظلومٌ، وإنِّي لا أُراني إلَّا سَأُقتَلُ اليومَ مَظلومًا، وإنَّ مِن أكبَرِ هَمِّي لَدَيني، أفَتُرى يُبقي دَينُنا مِن مالِنا شيئًا؟ فقال: يا بُنَيِّ بِعْ مالَنا، فاقضِ دَيني. وأوصى بالثُّلُثِ وثُلُثِه لبَنيه -يَعني بَني عبدِ اللهِ بنِ الزُّبَيرِ- يقولُ: ثُلُثُ الثُّلُثِ، فإن فضَلَ مِن مالِنا فضلٌ بَعدَ قَضاءِ الدَّينِ شَيءٌ، فثُلُثُه لولَدِكَ -قال هِشامٌ: وكان بَعضُ ولَدِ عبدِ اللهِ قد وازى بَعضَ بَني الزُّبَيرِ؛ خُبَيبٌ وعَبَّادٌ، وله يَومَئذٍ تِسعةُ بَنينَ، وتِسعُ بَناتٍ- قال عبدُ اللهِ: فجَعَلَ يوصيني بدَينِه، ويقولُ: يا بُنَيِّ إن عَجَزتَ عنه في شَيءٍ فاستَعِنْ عليه مَولايَ، قال: فواللهِ ما دَرَيتُ ما أرادَ حتَّى قُلتُ: يا أبةِ مَن مَولاكَ؟ قال: اللهُ، قال: فواللهِ ما وقَعتُ في كُربةٍ مِن دَينِه ",["إلَّا قُلتُ: يا مَولى الزُّبَيرِ اقضِ عنه دَينَه",1],"، ",["فيَقضيه",2],"، فقُتِلَ الزُّبَيرُ رَضيَ اللهُ عنه، ولَم يَدَعْ دينارًا ولا دِرهَمًا إلَّا أرَضينَ، منها الغابةُ، وإحدى عَشرةَ دارًا بالمَدينةِ، ودارَينِ بالبَصرةِ، ودارًا بالكوفةِ، ودارًا بمِصرَ، قال: وإنَّما كان دَينُه الذي عليه أنَّ الرَّجُلَ كان يَأتيه بالمالِ، فيَستَودِعُه إيَّاه، فيَقولُ الزُّبَيرُ: لا، ولَكِنَّه سَلَفٌ؛ فإنِّي أخشى عليه الضَّيعةَ، وما وليَ إمارةً قَطُّ ولا جِبايةَ خَراجٍ، ولا شيئًا إلَّا أن يَكونَ في غَزوةٍ مع النَّبيِّ صلَّى اللهُ عليه وسلَّم، أو مع أبي بَكرٍ وعُمَرَ وعُثمانَ رَضيَ اللهُ عنهم، قال عبدُ اللهِ بنُ الزُّبَيرِ: فحَسَبتُ ما عليه مِنَ الدَّينِ، فوجَدتُه ألفَي ألفٍ ومِئَتَي ألفٍ، قال: فلَقيَ حَكيمُ بنُ حِزامٍ عَبدَ اللهِ بنَ الزُّبَيرِ، فقال: يا ابنَ أخي، كَم على أخي مِنَ الدَّينِ؟ فكَتَمَه، فقال: مِئةُ ألفٍ، فقال حَكيمٌ: واللهِ ما أُرى أموالَكُم تَسَعُ لهذه! فقال له عبدُ اللهِ: أفَرَأيتَكَ إن كانَت ألفَي ألفٍ ومِئَتَي ألفٍ؟! قال: ما أُراكُم تُطيقونَ هذا، فإن عَجَزتُم عن شَيءٍ منه فاستَعينوا بي، قال: وكان الزُّبَيرُ اشتَرى الغابةَ بسَبعينَ ومِئةِ ألفٍ، فباعَها عبدُ اللهِ بألفِ ألفٍ وسِتِّ مِئةِ ألفٍ، ثُمَّ قامَ فقال: مَن كان له على الزُّبَيرِ حَقٌّ فليوافِنا بالغابةِ، فأتاه عبدُ اللهِ بنُ جَعفَرٍ، وكان له على الزُّبَيرِ أربَعُ مِئةِ ألفٍ، فقال لعَبدِ اللهِ: إن شِئتُم تَرَكتُها لَكُم، قال عبدُ اللهِ: لا، قال: فإن شِئتُم جَعَلتُموها فيما تُؤَخِّرونَ إن أخَّرتُم، فقال عبدُ اللهِ: لا، قال: قال: فاقطَعوا لي قِطعةً، فقال عبدُ اللهِ: لكَ مِن هاهنا إلى هاهنا، قال: فباعَ منها، فقَضى دَينَه فأوفاه، وبَقيَ منها أربَعةُ أسهُمٍ ونِصفٌ، فقدِمَ على مُعاويةَ، وعِندَه عَمرو بنُ عُثمانَ، والمُنذِرُ بنُ الزُّبَيرِ، وابنُ زَمعةَ، فقال له مُعاويةُ: كَم قومَتِ الغابةُ؟ قال: كُلُّ سَهمٍ مِئةَ ألفٍ، قال: كَم بَقيَ؟ قال: أربَعةُ أسهُمٍ ونِصفٌ، قال المُنذِرُ بنُ الزُّبَيرِ: قد أخَذتُ سَهمًا بمِئةِ ألفٍ، قال عَمرو بنُ عُثمانَ: قد أخَذتُ سَهمًا بمِئةِ ألفٍ، وقال ابنُ زَمعةَ: قد أخَذتُ سَهمًا بمِئةِ ألفٍ، فقال مُعاويةُ: كَم بَقيَ؟ فقال: سَهمٌ ونِصفٌ، قال: قد أخَذتُه بخَمسينَ ومِئةِ ألفٍ، قال: وباعَ عبدُ اللهِ بنُ جَعفَرٍ نَصيبَه مِن مُعاويةَ بسِتِّ مِئةِ ألفٍ، فلَمَّا فرَغَ ابنُ الزُّبَيرِ مِن قَضاءِ دَينِه، قال بَنو الزُّبَيرِ: اقسِمْ بينَنا ميراثَنا، قال: لا واللهِ لا أقسِمُ بينَكُم حتَّى أُناديَ بالمَوسِمِ أربَعَ سِنينَ: ألا مَن كان له على الزُّبَيرِ دَينٌ فليَأتِنا فلنَقضِه، قال: فجَعَلَ كُلَّ سَنةٍ يُنادي بالمَوسِمِ، فلَمَّا مَضى أربَعُ سِنينَ قَسَمَ بينَهم، قال: فكان للزُّبَيرِ أربَعُ نِسوةٍ، ورَفَعَ الثُّلُثَ، فأصابَ كُلَّ امرَأةٍ ألفُ ألفٍ ومِئَتا ألفٍ، فجَميعُ مالِه خَمسونَ ألفَ ألفٍ، ومِئَتا ألفٍ."],"grade":"صحيح","narrator":"عبدالله بن الزبير","muhaddith":"[صحيح]","takhrij":"أخرجه البيهقي (12807) باختلاف يسير، والبلاذري في ((أنساب الأشراف)) (9/ 425) بنحوه، والحاكم (5566) مختصرا.","bab":"جنائز وموت › قضاء دين الميت","dorar":"PIreueCT"},{"id":"س-05753","fp":"59b8a98b353d","stateId":20,"easy":"إذا استدنت وأنت تنوي الأداء صادقاً ← يؤدّيه الله عنك","cause":"ما مِن أحَدٍ يَستَدينُ دَينًا يعلمُ اللَّهُ عزَّ وجلَّ أنَّهُ يريدُ أداءَهُ","result":"إلَّا أدَّاهُ اللَّهُ عزَّ وجلَّ عنهُ","explicit":true,"ref":"الآداب الشرعية 1/103","srcLabel":"النسائي","text":[["ما مِن أحَدٍ يَستَدينُ دَينًا يعلمُ اللَّهُ عزَّ وجلَّ أنَّهُ يريدُ أداءَهُ",1]," ",["إلَّا أدَّاهُ اللَّهُ عزَّ وجلَّ عنهُ",2]],"grade":"حسن","narrator":"ميمونة بنت الحارث أم المؤمنين","muhaddith":"إسناده حسن","takhrij":"أخرجه النسائي (4686)، وابن ماجه (2408)، وأحمد (26816) جميعهم باختلاف يسير.","bab":"رقائق وزهد › النية","dorar":"GaQWUzCN"},{"id":"س-07838","fp":"8079df6c711a","stateId":20,"easy":"إذا استدنت لحاجة مشروعة (كالجهاد أو تكفين مسلم) ← يقضيه الله عنك يوم القيامة","cause":"رجُلٌ يُضعِفُ قوتَهُ في سبيلِ الله فيستدينُ يتقَوَّى به لعدوِّ الله وعدوِّه ورجلٌ يموتُ عنده مسلمٌ لا يجِدُ ما يُكَفِّنُهُ ويُوارِيِهِ إلا بِدَيْنٍ ورجلٌ خافَ اللهُ على نفسِهِ العَزَبَةَ فينكِحُ خشيةً على دِينِهِ","result":"فإنَّ اللهَ يقضِي عن هؤلاءِ يومَ القيامةِ","explicit":true,"otherNeedIds":[65],"ref":"الأجوبة المرضية 3/1184","srcLabel":"ابن ماجه","text":["إنَّ الدَّيْنَ يُقضَى من صاحبِهِ يومَ القيامَةِ إذا ماتَ إلا من تَدَيَّنَ في ثلاثِ خِصَالٍ ",["رجُلٌ يُضعِفُ قوتَهُ في سبيلِ الله فيستدينُ يتقَوَّى به لعدوِّ الله وعدوِّه ورجلٌ يموتُ عنده مسلمٌ لا يجِدُ ما يُكَفِّنُهُ ويُوارِيِهِ إلا بِدَيْنٍ ورجلٌ خافَ اللهُ على نفسِهِ العَزَبَةَ فينكِحُ خشيةً على دِينِهِ",1]," ",["فإنَّ اللهَ يقضِي عن هؤلاءِ يومَ القيامةِ",2]],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن","takhrij":"أخرجه ابن ماجه (2435)، والبزار كما في ((الترغيب والترهيب)) للمنذري (2/375)، والبيهقي في ((شعب الإيمان)) (5559) باختلاف يسير","bab":"قرض › الترهيب من الدين","dorar":"OVPdf0Ha"},{"id":"س-07839","fp":"b132760ef1cb","stateId":20,"easy":"إذا ذهب مالك في غرق أو حرق أو سرقة وبقي دَينك ← يقضيه الله عنك ويرجّح حسناتك","cause":"إنما ذهب في غرقٍ أو حرقٍ أو سرقةٍ أو وضيعَةٍ","result":"فيدعو اللهُ عزَّ وجلَّ بشيٍء فيضعُهُ في ميزانِهِ فترجحُ حسناتُهُ","explicit":true,"otherNeedIds":[65],"ref":"تخريج المسند لشاكر 3/157","srcLabel":"الطبراني","text":["إنَّ اللهَ عزَّ وجلَّ ليدعو بصاحبِ الدَّيْنِ يومَ القيامةِ فيُقيمُهُ بين يديهِ فيقولُ : أي عبدي فيم أذهبتَ مالَ الناسِ فيقولُ : أي ربِّ قد علمتَ أني لم أُفسدْهُ ",["إنما ذهب في غرقٍ أو حرقٍ أو سرقةٍ أو وضيعَةٍ",1]," ",["فيدعو اللهُ عزَّ وجلَّ بشيٍء فيضعُهُ في ميزانِهِ فترجحُ حسناتُهُ",2]],"grade":"حسن","narrator":"عبدالرحمن بن أبي بكر الصديق","muhaddith":"إسناده حسن","takhrij":"أخرجه الطيالسي (1423)، والبزار (2272)، والطبراني كما في ((مجمع الزوائد)) للهيثمي (4/136) باختلاف يسير","bab":"قرض › الترهيب من الدين","dorar":"s9k85sew"},{"id":"س-08311","fp":"5312190a90e1","stateId":20,"easy":"إذا نويت أداء دَينك ← يكون لك عون من الله","cause":"ما من عبدٍ كانت له نِيَّةٌ في أداءِ دَيْنِه","result":"إلَّا كان له منَ اللهِ عزَّ وجلَّ عونٌ، فأنا ألتَمِسُ ذلك العَونَ","explicit":true,"otherNeedIds":[25],"ref":"تخريج المسند لشعيب 24993","srcLabel":"أحمد","text":["كانت عائشةُ تَدَّانُ، فقيلَ لها: ما لكِ وللدَّيْنِ؟ قالت: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["ما من عبدٍ كانت له نِيَّةٌ في أداءِ دَيْنِه،",1]," ",["إلَّا كان له منَ اللهِ عزَّ وجلَّ عونٌ، فأنا ألتَمِسُ ذلك العَونَ",2],"."],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"حسن","takhrij":"أخرجه أحمد (24993) واللفظ له، والطيالسي (1628)، والطحاوي في ((شرح مشكل الآثار)) (4288)","bab":"مناقب وفضائل › عائشة بنت أبي بكر الصديق","dorar":"Rhvvd8uO"},{"id":"س-07840","fp":"fb169afe321c","stateId":20,"easy":"إذا استدنت بنيّة الوفاء فتلف المال بغير تفريط ← يقضي الله عنك يوم القيامة","cause":"أخذْتُه فلم آكُلْ ولم أشرَبْ، ولم ألبَسْ ولم أُضيِّعْ، ولكن إمَّا حَرقٌ، وإمَّا سَرَقٌ، وإمَّا وَضِيعَةٌ","result":"أنا أحَقُّ مَن قَضَى عنك، فيَدْعو اللهُ بشَيءٍ، فيضَعُه في كِفَّةِ ميزانِه، فترجَحُ حَسَناتُه على سيِّئاتِه، فيدخُلُ الجنَّةَ بفضْلِ رحمَتِه","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[65],"ref":"الزواجر عن اقتراف الكبائر 1/247","srcLabel":"الزواجر عن اقتراف الكبائر","text":["يَدْعو اللهُ بصاحِبِ الدَّينِ يومَ القيامةِ حتَّى يقِفَ بين يدَيْه، فيقالُ: يا ابنَ آدمَ، فِيمَ أخذْتَ هذا الدَّينَ؟ وفِيمَ ضيَّعْتَ حُقوقَ النَّاسِ؟ فيقولُ: يا ربِّ، إنَّك تعلَمُ أنِّي ",["أخذْتُه فلم آكُلْ ولم أشرَبْ، ولم ألبَسْ ولم أُضيِّعْ، ولكن إمَّا حَرقٌ، وإمَّا سَرَقٌ، وإمَّا وَضِيعَةٌ",1]," فيقولُ اللهُ: صدَقَ عبْدي، ",["أنا أحَقُّ مَن قَضَى عنك، فيَدْعو اللهُ بشَيءٍ، فيضَعُه في كِفَّةِ ميزانِه، فترجَحُ حَسَناتُه على سيِّئاتِه، فيدخُلُ الجنَّةَ بفضْلِ رحمَتِه",2],"."],"grade":"حسن","muhaddith":"إسناده حسن","bab":"قرض › الترهيب من الدين","dorar":"UmfqzfoL"},{"id":"س-03757","fp":"f742caba1ee3","stateId":20,"easy":"إذا استدنت لحاجة مشروعة ← فالله مع المدين حتى يقضي دينه","cause":"حتى يَقْضِيَ دَيْنَهُ ما لمْ يكنْ فيما يكرهُهُ اللهُ","result":"إِنَّ اللهَ مع الدَّائِنِ","explicit":true,"star":true,"ref":"صحيح الترغيب 1808","srcLabel":"ابن ماجه","text":[["إِنَّ اللهَ مع الدَّائِنِ",2]," ",["حتى يَقْضِيَ دَيْنَهُ ما لمْ يكنْ فيما يكرهُهُ اللهُ",1]," . قال : وكان عبدُ اللهِ بْنُ جَعْفَرٍ يقولُ لِخَازِنِهِ : اذْهَبْ فَخُذْ لي بِدَيْن ؛ فإني أَكْرَهُ أنْ أبيتَ ليلةً إلَّا واللهُ مَعِي ؛ بعدَ إذ سمعْتُهُ من رسولِ اللهِ ."],"grade":"صحيح","narrator":"عبدالله بن جعفر بن أبي طالب","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (2409)، والدارمي (2637)، والحاكم (2205) واللفظ لهم.","bab":"اعتصام بالسنة › نقل السنة وروايتها","dorar":"rktXxQwL"},{"id":"س-07833","fp":"e3c1a83920ab","stateId":21,"easy":"إذا مت وعليك دين ← لا تُترك بلا قضاء (والنبي ﷺ يمتنع من الصلاة على المدين)","cause":"الرَّجُلِ المُتَوفَّى عليه الدَّينُ","result":"وإلَّا قال للمُسلِمينَ: صَلُّوا على صاحِبِكُم","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"star":true,"otherNeedIds":[57],"ref":"صحيح البخاري 2298","srcLabel":"مسلم","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم كان يُؤتى ب",["الرَّجُلِ المُتَوفَّى عليه الدَّينُ",1],"، فيَسألُ: هل تَرَكَ لدَينِه فضلًا؟ فإن حُدِّثَ أنَّه تَرَكَ لدَينِه وفاءً صَلَّى، ",["وإلَّا قال للمُسلِمينَ: صَلُّوا على صاحِبِكُم",2],"، فلَمَّا فتَحَ اللهُ عليه الفُتوحَ، قال: أنا أولى بالمُؤمِنينَ مِن أنفُسِهم، فمَن توفِّيَ مِنَ المُؤمِنينَ فتَرَكَ دَينًا فعليَّ قَضاؤُه، ومَن تَرَكَ مالًا فلورَثَتِه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1619)، والترمذي (1070)، والنسائي (1963) باختلاف يسير.","bab":"قرض › الترهيب من الدين","dorar":"JPC9NWUN"},{"id":"س-04156","fp":"ea07d2c83acf","stateId":21,"easy":"إذا مت وعليك دين ← تكون مأسوراً به عن الجنة حتى يُفدى","cause":"بدَينِه","result":"إنَّ فلانًا لرَجلٍ منهُم مأسورٌ بدَينِه عن الجنَّةِ ، فإن شئتُم فافدوهُ ، وإن شئتُم فأسلِموهُ إلى عذابِ اللَّهِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-03956"],"otherNeedIds":[69,71,64],"ref":"أحكام الجنائز 26","srcLabel":"أبو داود","text":["أنَّ النَّبيَّ صلَّى اللهُ علَيهِ وسلَّمَ صلَّى علَى جنازةٍ وفي روايةٍ : صلَّى الصُّبحَ فلمَّا انصرفَ قالَ : أَها هُنا من آلِ فلانٍ أحدٌ . فسكَت القومُ ، وكان إذا ابتدأَهُم بشيءٍ سكَتوا فقالَ ذلكَ مرارًا ثلاثا لا يجيبُهُ أحدٌ ، فقال رجلٌ : هوَ ذا ، قالَ فقامَ رجلٌ يَجرُّ إزارَه مِن مؤخَّرة النَّاسِ فقالَ لَه النَّبيُّ -صلَّى اللهُ علَيهِ وسلَّمَ: ما مَنعكَ في المرَّتينِ الأوَّلينِ أن تكونَ أجَبتَني . أما إنِّى لم أنوِّه باسمِك إلَّا لخيرٍ ",["إنَّ فلانًا لرَجلٍ منهُم مأسورٌ بدَينِه عن الجنَّةِ ، فإن شئتُم فافدوهُ ، وإن شئتُم فأسلِموهُ إلى عذابِ اللَّهِ",2]," ، فلو رأيتَ أَهلَه ومَن يتحرَّونَ أمره قاموا فقضَوا عَنهُ ، حتَّى ما أحدٌ يطلُبُهُ بشَيءٍ ."],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"على الوجه الأول صحيح على شرط الشيخين وعلى الوجه الثاني صحيح","takhrij":"أخرجه أبو داود(3341) وأحمد (20231) والبيهقي (11377) بنحوه","bab":"جنائز وموت › قضاء دين الميت","dorar":"PQrKEPNR","merged":8,"otherRefs":["تخريج المسند لشعيب 20157 (صحيح)","الاستذكار 4/101 (صحيح)","تخريج المسند لشعيب 20222 (صحيح)","السلسلة الصحيحة 3415 (صحيح)","الروضة الندية 2/321 (صحيح)","المستدرك على الصحيحين 2248 (صحيح)","صحيح النسائي 4699 (صحيح)"]},{"id":"س-04615","fp":"af2910f02e6e","stateId":21,"easy":"إذا مِتّ وعليك دَين ← تبقى محبوساً بدَينك يوم القيامة","cause":"صاحِبُ الدَّينِ","result":"مَأسورٌ يومَ القِيامةِ في الدَّينِ","explicit":true,"otherNeedIds":[70],"ref":"الاستذكار 4/102","srcLabel":"الطبراني","text":[["صاحِبُ الدَّينِ",1]," ",["مَأسورٌ يومَ القِيامةِ في الدَّينِ",2]],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح","takhrij":"أخرجه الروياني في ((المسند)) (429)، والطبراني في ((المعجم الأوسط)) (893) باختلاف يسير، وأورده ابن عبدالبر في ((الاستذكار)) (5/111) واللفظ له","bab":"دفن ومقابر › أحوال الميت في القبر","dorar":"cPvOxnt4"},{"id":"س-07834","fp":"e82b20699153","stateId":21,"easy":"إذا مِتّ وأنت تنوي قضاء دَينك ← فالنبي ﷺ وليّك","cause":"فمن مات وهو ينوي قضاءَه","result":"فأنا وليُّه","explicit":true,"otherNeedIds":[25],"ref":"صحيح الترغيب 1803","srcLabel":"الطبراني","text":["الدَّينُ دَيْنانِ ، ",["فمن مات وهو ينوي قضاءَه",1]," ؛ ",["فأنا وليُّه",2]," ، ومن مات وهو لا ينوي قضاءَه ؛ فذاك الذي يُؤخَذُ من حسناتِه ، ليس يومئذٍ دينارٌ ولا درهمٌ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (13/ 336) (\n14146)","bab":"قرض › الترهيب من الدين","dorar":"71SmOwWP"},{"id":"س-03709","fp":"2076aa8f5058","stateId":21,"easy":"إذا مت وتركت ديناً أو عيالاً ضياعاً ← فقضاؤه على ولي الأمر (خاص بالنبي ﷺ والإمام)","cause":"وَمَن تَرَكَ دَيْنًا أَوْ ضَيَاعًا","result":"فَإِلَيَّ وَعَلَيَّ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"فتاوى النووي 47","srcLabel":"النسائي","text":["حديثُ: النَّهيِ عنْ مُحْدَثاتِ الأُمورِ، وأنَّ كُلَّ بِدعةٍ ضَلالةٌ [يعني حديث: كانَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ إذَا خَطَبَ احْمَرَّتْ عَيْنَاهُ، وَعَلَا صَوْتُهُ، وَاشْتَدَّ غَضَبُهُ، حتَّى كَأنَّهُ مُنْذِرُ جَيْشٍ يقولُ: صَبَّحَكُمْ وَمَسَّاكُمْ، ويقولُ: بُعِثْتُ أَنَا وَالسَّاعَةُ كَهَاتَيْنِ، وَيَقْرُنُ بيْنَ إصْبَعَيْهِ: السَّبَّابَةِ وَالْوُسْطَى، ويقولُ: أَمَّا بَعْدُ؛ فإنَّ خَيْرَ الحَديثِ كِتَابُ اللهِ، وَخَيْرُ الهُدَى هُدَى مُحَمَّدٍ، وَشَرُّ الأُمُورِ مُحْدَثَاتُهَا، وَكُلُّ بدْعَةٍ ضَلَالَةٌ، ثُمَّ يقولُ: أَنَا أَوْلَى بكُلِّ مُؤْمِنٍ مِن نَفْسِهِ؛ مَن تَرَكَ مَالًا فَلأَهْلِهِ، ",["وَمَن تَرَكَ دَيْنًا أَوْ ضَيَاعًا",1]," ، ",["فَإِلَيَّ وَعَلَيَّ",2],". [وفي رواية]: كَانَتْ خُطْبَةُ النَّبيِّ صَلَّى اللَّهُ عليه وَسَلَّمَ يَومَ الجُمُعَةِ يَحْمَدُ اللَّهَ، وَيُثْنِي عليه، ثُمَّ يقولُ علَى إثْرِ ذلكَ، وَقَدْ عَلَا صَوْتُهُ، ثُمَّ سَاقَ الحَدِيثَ، بمِثْلِهِ.]"],"grade":"صحيح","narrator":"[جابر بن عبدالله]","muhaddith":"ثابت صحيح","takhrij":"أخرجه النسائي (1578)، وابن خزيمة (1785)، وابو نعيم الأصبهاني في ((المستخرج)) (1953) جميعهم بلفظه تاما.","bab":"اعتصام بالسنة › لزوم السنة","dorar":"uH5EXzV5","merged":5,"otherRefs":["تخريج المسند لشعيب 14630 (صحيح)","تخريج المسند لشعيب 14334 (صحيح)","الفتح الرباني 10/5162 (صحيح)","غاية المرام 358 (صحيح)"]},{"id":"س-03956","fp":"85975a4dee6a","stateId":21,"easy":"إذا مت وعليك دين ← تكون مأسوراً به حتى يُقضى","cause":"بدَيْنِه","result":"إنَّ صاحِبَكم مَأْسورٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04156","otherNeedIds":[69],"ref":"تخريج سنن أبي داود 3341","text":["قال: خَطَبَنا رَسولُ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ، فقال: هاهنا أحَدٌ مِن بَني فُلانٍ؟ فلم يُجِبْه أحَدٌ، ثم قال: هاهنا أحَدٌ مِن بَني فُلانٍ؟ فلم يُجِبْه أحَدٌ، ثم قال: هاهنا أحَدٌ مِن بَني فُلانٍ؟ فقامَ رَجُلٌ، فقال: أنا يا رَسولَ اللَّهِ. فقال صلَّى اللَّهُ عليه وسلَّمَ: ما مَنعَكَ أنْ تُجيبَني في المَرَّتَيْنِ الأُولَيَيْنِ؟ إنِّي لم أُنَوِّهْ بكم إلَّا خَيرًا، ",["إنَّ صاحِبَكم مَأْسورٌ",2]," ",["بدَيْنِه",1],". فلقد رَأيتُه أُدِّيَ عنه، حتى ما أحَدٌ يَطلُبُه بشَيءٍ."],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3341)، واللفظ له، والنسائي (4685)، وعبد الرزاق (15263)، باختلاف يسير.","bab":"تفليس › حلول الدين على الميت","dorar":"EkREmoSe"},{"id":"س-03330","fp":"bfc1cbfe242e","stateId":21,"easy":"إذا قُتلت شهيداً ← تُكفّر خطاياك إلا الدين","cause":"الدَّينَ","result":"إلَّا الدَّينَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[13],"ref":"صحيح مسلم 1885","srcLabel":"متفق عليه","text":["أنَّه قامَ فيهم، فذَكَرَ لهم أنَّ الجِهادَ في سَبيلِ اللهِ والإيمانَ باللهِ أفضَلُ الأعمالِ، فقامَ رَجُلٌ، فقال: يا رَسولَ اللهِ، أرَأيتَ إن قُتِلتُ في سَبيلِ اللهِ، تُكَفَّرُ عَنِّي خَطايايَ؟ فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: نَعَم، إن قُتِلتَ في سَبيلِ اللهِ، وأنتَ صابِرٌ مُحتَسِبٌ، مُقبِلٌ غَيرُ مُدبِرٍ، ثُمَّ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: كيفَ قُلتَ؟ قال: أرَأيتَ إن قُتِلتُ في سَبيلِ اللهِ، أتُكَفَّرُ عَنِّي خَطايايَ؟ فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: نَعَم، وأنتَ صابِرٌ مُحتَسِبٌ، مُقبِلٌ غَيرُ مُدبِرٍ، ",["إلَّا الدَّينَ",2],"؛ فإنَّ جِبريلَ عليه السَّلامُ قال لي ذلك. وفي روايةٍ: جاءَ رَجُلٌ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: أرَأيتَ إن قُتِلتُ في سَبيلِ اللهِ..."],"grade":"صحيح","narrator":"أبو قتادة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"استغفار › أسباب المغفرة","dorar":"oP4o6Lbl"},{"id":"س-04563","fp":"c5b4df8f6ab1","stateId":21,"easy":"إذا مت وفي عنقك أموال الناس لم تجعل لها وفاءً ← تُعذّب في النار","cause":"مات وفي عنقِه أموالُ الناسِ ما يجدُ لها قضاءً أو وفاءً","result":"فرجلٌ مغلقٌ عليه تابوتٌ من جمرٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[70],"ref":"مجمع الزوائد 1/213","srcLabel":"الطبراني","text":["أربعةٌ يُؤذونَ أهلَ النارِ على ما بهم من الأذَى يسعونَ بينَ الحميمِ والجحيمِ يدعونَ بالويلِ والثبورِ يقولُ أهلُ النارِ بعضُهم لبعضٍ ما بالُ هؤلاءِ قد آذونا على ما بنا من الأذَى قال ",["فرجلٌ مغلقٌ عليه تابوتٌ من جمرٍ",2]," ورجلٌ يجرُّ أمعاءَه ورجلٌ يسيلُ فوه قيحًا ودمًا ورجلٌ يأكلُ لحمَه قال فيُقالُ لصاحبِ التابوتِ ما بالُ الأبعدِ قد آذانا على ما بنا من الأذَى قال فيقولُ إن الأبعدَ ",["مات وفي عنقِه أموالُ الناسِ ما يجدُ لها قضاءً أو وفاءً",1]," ثم قال للذي يجرُّ أمعاءَه ما بالُ الأبعدِ قد آذانا على ما بنا من الأذَى فقال إن الأبعدَ كان لا يُبالِي أينَ أصاب البولُ منه لا يغسلُه ثم قال للذي يسيلُ فوه قيحًا ودمًا ما بالُ الأبعدِ قد آذانا على ما بنا من الأذَى فيقولُ إن الأبعدَ كان يأكلُ لحمَ الناسِ"],"grade":"حسن","narrator":"شفي بن ماتع الأصبحي","muhaddith":"رجاله موثقون","takhrij":"أخرجه ابن المبارك في ((الزهد)) (2/94)، وابن أبي الدنيا في ((صفة النار)) (229)، والطبراني (7/311) (7226) باختلاف يسير.","bab":"جهنم › صفة عذاب أهل النار","dorar":"SXiXxY4A"},{"id":"س-07844","fp":"4ee883fbfdbb","stateId":21,"easy":"إذا قُضي دين الميت ← برد عليه جلده","cause":"قد قضيتُهما يا رسولَ اللهِ","result":"الآنَ حين بردَتْ عليه جلدُه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[63],"ref":"الإلمام بأحاديث الأحكام 2/535","srcLabel":"الحاكم","text":["مات رجلٌ فغسَّلْناه وكفَّناه وحنَّطناه ووضعنَاه لرسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ حيث توضعُ الجنائزُ عند مقامِ جبريلَ ، ثم آذنَّا رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ بالصلاةِ عليه فجاء معنا خطى ثم قال : لعلَّ على صاحبِكم دَينًا ؟ قالوا : نعم دينارانِ ، فتخلَّف فقال رجلٌ منا يقال له أبو قَتادةَ : يا رسولَ اللهِ هما عليَّ ، فجعل رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يقول : هما عليك وفي مالكَ والميتُ منهما بريءٌ ؟ فقال : نعم ، فصلَّى عليه ، فجعل رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ إذا لقي أبا قَتادةَ يقول : ما صنعتِ الدِّينارانِ ؟ حتى كان آخرُ ذلك قال : ",["قد قضيتُهما يا رسولَ اللهِ",1]," . قال : ",["الآنَ حين بردَتْ عليه جلدُه",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"قال الحاكم : صحيح الإسناد ولم يخرجاه . هذا بناء على قول من يحتج بحديث عبد الله بن محمد بن عقيل","takhrij":"أخرجه الدارقطني (3/79)، والحاكم (2346)","bab":"قرض › من ضمن دين ميت","dorar":"MrbdKqCF","merged":4,"otherRefs":["الأحكام الوسطى 3/280 (صحيح)","فتح الغفار 697/2 (حسن)","مجمع الزوائد 3/43 (حسن)"]},{"id":"س-01662","fp":"1b4c9f126260","stateId":21,"easy":"إذا مات قريبك وعليه دين ← فاقضِ دينه أولاً فإنه محبوس به","cause":"إنَّ أخاك محبوسٌ بدَيْنِه","result":"فاذهَبْ، فاقْضِ دَينَه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[69],"ref":"تخريج شرح الطحاوية 585","srcLabel":"ابن ماجه","text":["عن سعدِ بنِ الأطوَلِ أنَّ أخاه مات وترَكَ ثلاثَ مِئةِ دِرْهمٍ، وترَكَ عِيالًا، قال: فأرَدتُ أن أُنفِقَها على عِيالِه، قال: فقال لي النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: (",["إنَّ أخاك محبوسٌ بدَيْنِه",1],"، ",["فاذهَبْ، فاقْضِ دَينَه",2],")، فذَهَبتُ فقضَيتُ عنه، ثمَّ جِئتُ، قلتُ: يا رسولَ اللهِ، قد قضَيتُ عنه إلَّا دِينارَيْنِ ادَّعَتْهما امرأةٌ، وليس لها بَيِّنةٌ، قال: (أعطِها؛ فإنَّها مُحِقَّةٌ)، وفي روايةٍ: (فإنَّها صادِقةٌ)."],"grade":"صحيح","muhaddith":"[فيه] عبد الملك أبو جعفر ذكره ابن حبان في (الثقات)، وباقي رجال الإسناد على شرط الشيخين","takhrij":"أخرجه ابن ماجه (2433)، وأحمد (20076) من حديث سعد بن الأطول رضي الله عنه.","bab":"أقضية وأحكام › آداب القضاء وكيفية الحكم","dorar":"a6ZyJnGV","merged":2,"otherRefs":["تخريج المسند لشعيب 17227 (صحيح)"]},{"id":"س-04153","fp":"85884fdff753","stateId":21,"easy":"إذا مت وعليك دين ← نفسك معلقة بدينك","cause":"بدَينِهِ","result":"نَفسُ المؤمنِ معلَّقةٌ بدَينِهِ","explicit":true,"star":true,"ref":"الاستذكار 4/101","srcLabel":"الترمذي","text":[["نَفسُ المؤمنِ معلَّقةٌ بدَينِهِ ، ",2],"أو قالَ : ما كانَ عليهِ دَينٌ حتَّى يُقضَى عنهُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1078)، وابن ماجه (2413)، وأحمد (9679).","bab":"جنائز وموت › قضاء دين الميت","dorar":"dqsTCFwn","merged":4,"otherRefs":["تاريخ دمشق 45/73 (صحيح)","أطراف الغرائب 2/351 (حسن)","الترغيب والترهيب 3/51 (صحيح)"]}]}