{"schema":1,"kind":"sunan-chunk","version":"sunan-820d161722ab","needId":23,"stateIds":[223,224,225,226,227,228,229,230,231,232,233,234,235,236,237,238,239,240,241,242,243,244],"items":[{"id":"ق-0084","fp":"3854175a9473","stateId":223,"easy":"التوبة والتطهر ← محبة الله","cause":"التوبة والتطهر","result":"محبة الله","explicit":true,"star":true,"ref":"سورة البقرة: 222","srcLabel":"القرآن الكريم","quran":{"s":2,"from":222,"to":222,"text":"وَيَسْأَلُونَكَ عَنِ الْمَحِيضِ قُلْ هُوَ أَذًى فَاعْتَزِلُوا النِّسَاءَ فِي الْمَحِيضِ وَلَا تَقْرَبُوهُنَّ حَتَّى يَطْهُرْنَ فَإِذَا تَطَهَّرْنَ فَأْتُوهُنَّ مِنْ حَيْثُ أَمَرَكُمُ اللَّهُ إِنَّ اللَّهَ يُحِبُّ التَّوَّابِينَ وَيُحِبُّ الْمُتَطَهِّرِينَ (222)","hl":[[191,255,1]]}},{"id":"س-03984","fp":"cfc470c2be89","stateId":223,"easy":"إذا ابتُليت بالذنب فأكثرت التوبة ← يحبك الله (المفتّن التواب)","cause":"العبدَ المؤمنَ المُفتَّنَ التوَّابَ","result":"إنَّ اللَّه تعالى يُحبُّ","explicit":true,"ref":"الجامع الصغير 1864","srcLabel":"أحمد","text":[["إنَّ اللَّه تعالى يُحبُّ",2],[" العبدَ المؤمنَ المُفتَّنَ التوَّابَ",1]],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح","takhrij":"أخرجه أحمد (605)، وأبو يعلى (483)، والدولابي في ((الكنى والأسماء)) (1469) واللفظ لهم.","bab":"توبة › الحض على التوبة","dorar":"fgaPbdhN"},{"id":"س-06916","fp":"dbe577047812","stateId":223,"easy":"إذا كنت شاباً تائباً ← يحبك الله","cause":"الشَّابَّ التَّائبَ","result":"إنَّ اللهَ يُحبُّ","explicit":true,"ref":"مختصر المقاصد 218","srcLabel":"ابن أبي الدنيا","text":[["إنَّ اللهَ يُحبُّ",2],[" الشَّابَّ التَّائبَ",1]],"grade":"حسن","narrator":"[أنس بن مالك]","muhaddith":"حسن لغيره","takhrij":"أخرجه ابن أبي الدنيا في ((التوبة)) (184)، وعبد الخالق بن أسد في ((المعجم)) (226) كلاهما بلفظه.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"0uwREPCX"},{"id":"س-00582","fp":"718ca99a9291","stateId":223,"easy":"إذا تبت ← يفرح الله بتوبتك","cause":"بتَوبةِ أحدِكم","result":"لَلَّهُ أفرَحُ","explicit":true,"star":true,"similar":["س-06875"],"otherNeedIds":[12],"ref":"تخريج المسند لشعيب 3627","srcLabel":"متفق عليه","text":["حدَّثَنا عبدُ اللهِ حديثَينِ: أحدُهما عن نفْسِه، والآخَرُ عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، قال: قال عبدُ اللهِ: إنَّ المؤمنَ يَرى ذُنوبَه كأنَّه في أَصلِ جَبلٍ يَخافُ أنْ يقَعَ عليه، وإنَّ الفاجرَ يَرى ذُنوبَه كذُبابٍ وقَعَ على أنْفِه، فقال له هكذا، فطار\".\nقال: وقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: \"",["لَلَّهُ أفرَحُ",2]," ",["بتَوبةِ أحدِكم",1],"، مِن رَجُلٍ خرَجَ بأَرضٍ دَوِّيَّةٍ مَهلَكةٍ، معه راحِلتُه عليها طعامُه وشرابُه وزادُه وما يُصلِحُه، فأضَلَّها، فخرَجَ في طَلبِها، حتى إذا أدرَكَه المَوتُ فلم يجِدْها، قال: أرجِعُ إلى مَكاني الذي أضلَلْتُها فيه، فأَموتُ فيه، قال: فأَتى مَكانَه، فغلَبَتْه عينُه، فاستَيقَظَ، فإذا راحِلتُه عندَ رأْسِه، عليها طعامُه وشرابُه وزادُه وما يُصلِحُه\"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"الحديث الموقوف: أخرجه البخاري (6308)، والترمذي (2497)، وأحمد (3627). والحديث المرفوع: أخرجه البخاري (6308)، ومسلم (2744)، والترمذي (2498)، والنسائي في ((السنن الكبرى)) (7742)، وأحمد (3627)","bab":"آداب عامة › ضرب الأمثال","dorar":"3Iayf7wS","merged":3,"otherRefs":["تخريج صحيح ابن حبان 618 (صحيح)","صحيح ابن ماجه 3444 (صحيح)"]},{"id":"س-06875","fp":"eff64f0e745d","stateId":223,"easy":"إذا تبت ← فالله أفرح بتوبتك","cause":"بتَوْبَةِ عَبْدِهِ","result":"لَلَّهُ أفْرَحُ","explicit":true,"repOf":"س-00582","otherNeedIds":[12],"ref":"العواصم من القواصم 224","text":["حديث: الضَّحِكُ والفَرَحُ [يعني حديث: أنَّ رَسولَ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ قَالَ: يَضْحَكُ اللَّهُ إلى رَجُلَيْنِ يَقْتُلُ أحَدُهُما الآخَرَ يَدْخُلَانِ الجَنَّةَ: يُقَاتِلُ هذا في سَبيلِ اللَّهِ، فيُقْتَلُ، ثُمَّ يَتُوبُ اللَّهُ علَى القَاتِلِ، فيُسْتَشْهَدُ.]             [وحديث: إنَّ المُؤْمِنَ يَرَى ذُنُوبَهُ كَأنَّهُ قاعِدٌ تَحْتَ جَبَلٍ يَخافُ أنْ يَقَعَ عليه، وإنَّ الفاجِرَ يَرَى ذُنُوبَهُ كَذُبابٍ مَرَّ علَى أنْفِهِ فقالَ به هَكَذا، قالَ أبو شِهابٍ: بيَدِهِ فَوْقَ أنْفِهِ. ثُمَّ قالَ: ",["لَلَّهُ أفْرَحُ",2]," ",["بتَوْبَةِ عَبْدِهِ",1]," مِن رَجُلٍ نَزَلَ مَنْزِلًا وبِهِ مَهْلَكَةٌ ، ومعهُ راحِلَتُهُ ، عليها طَعامُهُ وشَرابُهُ، فَوَضَعَ رَأْسَهُ فَنامَ نَوْمَةً، فاسْتَيْقَظَ وقدْ ذَهَبَتْ راحِلَتُهُ ، حتَّى إذا اشْتَدَّ عليه الحَرُّ والعَطَشُ أوْ ما شاءَ اللَّهُ، قالَ: أرْجِعُ إلى مَكانِي، فَرَجَعَ فَنامَ نَوْمَةً، ثُمَّ رَفَعَ رَأْسَهُ، فإذا راحِلَتُهُ عِنْدَهُ.]"],"grade":"صحيح","narrator":"[أبو هريرة]   [عبدالله بن مسعود]","muhaddith":"صحيح","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"3l1JaNIH","merged":19,"otherRefs":["تخريج المسند لشعيب 10498 (صحيح)","تخريج المسند لشعيب 18423 (صحيح)","المستدرك على الصحيحين 7819 (صحيح)","تخريج صحيح ابن حبان 617 (صحيح)","تخريج المسند لشعيب 10909 (صحيح)","صحيح ابن حبان 621 (صحيح)","تخريج المسند لشعيب 11791 (صحيح)","تخريج المسند لشعيب 18408 (صحيح)","تخريج المسند لشعيب 18492 (صحيح)","صحيح الجامع 5033 (صحيح)","صحيح مسلم 2745 (صحيح)","مجموع الفتاوى 7/445 (صحيح)","صحيح مسلم 2744 (صحيح)","معجم الشيوخ 2/950 (صحيح)","مجمع الزوائد 10/199 (صحيح)","صحيح البخاري 6309 (صحيح)","صحيح الجامع 5030 (صحيح)","صحيح الجامع 5031 (صحيح)"]},{"id":"س-01100","fp":"07a7026fb39e","stateId":224,"easy":"إذا قلت «سبحان الله والحمد لله ولا إله إلا الله والله أكبر» ← فهي أحب الكلام إلى الله","cause":"أربَعٌ: سُبحانَ اللهِ، والحَمدُ للَّهِ، ولا إلَهَ إلَّا اللهُ، واللهُ أكبَرُ، لا يَضُرُّك بأيِّهنَّ بَدَأتَ","result":"أحَبُّ الكَلامِ إلى اللهِ","explicit":true,"star":true,"apply":{"k":"say","t":"«سبحان الله والحمد لله ولا إله إلا الله والله أكبر»"},"ref":"صحيح مسلم 2137","srcLabel":"متفق عليه","text":[["أحَبُّ الكَلامِ إلى اللهِ",2],[" أربَعٌ: سُبحانَ اللهِ، والحَمدُ للَّهِ، ولا إلَهَ إلَّا اللهُ، واللهُ أكبَرُ، لا يَضُرُّك بأيِّهنَّ بَدَأتَ",1],". ولا تُسَمِّيَنَّ غُلامَك يَسارًا، ولا رَباحًا، ولا نَجيحًا، ولا أفلَحَ؛ فإنَّك تَقولُ: أثَمَّ هو؟ فلا يَكونُ، فيَقولُ: لا. [قال سَمُرةُ]: إنَّما هُنَّ أربَعٌ، فلا تَزيدُنَّ عليَّ."],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"أدعية وأذكار › فضل الذكر","dorar":"HXVwMxNV","merged":2,"otherRefs":["صحيح الجامع 173 (صحيح)"]},{"id":"س-00773","fp":"5a1b5855e988","stateId":224,"easy":"إذا حمدت الله ← فإنه يحب أن يُحمد","cause":"أن يُحمَدَ","result":"إنَّ اللهَ عَزَّ وجَلَّ يُحِبُّ","explicit":true,"star":true,"similar":["س-06932","س-06981"],"ref":"الأحاديث المختارة 1448","srcLabel":"البخاري","text":["«أنَّه أتى رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: يا رَسولَ اللهِ، إنِّي حَمِدْتُك بمَحامِدَ، فقالَ: ",["إنَّ اللهَ عَزَّ وجَلَّ يُحِبُّ",2]," ",["أن يُحمَدَ",1],"، ولم يَسْتَنْشِدْه»."],"grade":"صحيح","narrator":"الأسود بن سريع","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"wdwm85jK"},{"id":"س-06932","fp":"1a176071a547","stateId":224,"easy":"إذا حمدت الله ← فهو يحب المحامد","cause":"المحامدَ","result":"يُحِبُّ","explicit":true,"repOf":"س-00773","ref":"السلسلة الصحيحة 7/543","text":["كنتُ شاعرًا فقلتُ يا رسولَ اللهِ امتدحتُ ربِّي فقالَ أما إنَّ ربَّكَ ",["يُحِبُّ",2]," ",["المحامدَ",1]," وما استزادني على ذلكَ"],"grade":"صحيح","narrator":"الأسود بن سريع","muhaddith":"إسناده صحيح","takhrij":"أخرجه واللفظ له البخاري في ((الأدب المفرد)) (868)، والنسائي في ((السنن الكبرى)) (7745) باختلاف يسير، وأحمد (15590) بنحوه مطولا","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"vnKiL4dU"},{"id":"س-01114","fp":"5c8671795672","stateId":224,"easy":"إذا جلست تذكر الله وتحمده على نعمة الإسلام ← يباهي الله بك الملائكة","cause":"جَلَسنا نَذكُرُ اللَّهَ ونَحمَدُه على ما هَدانا للإسلامِ، ومَنَّ به علينا","result":"أنَّ اللَّهَ عَزَّ وجَلَّ يُباهي بكُمُ المَلائِكةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"صحيح مسلم 2701","srcLabel":"متفق عليه","text":["خَرَجَ مُعاويةُ على حَلقةٍ في المَسجِدِ، فقال: ما أجلَسَكُم؟ قالوا: جَلَسنا نَذكُرُ اللَّهَ، قال: آللَّهِ ما أجلَسَكُم إلَّا ذاكَ؟ قالوا: واللَّهِ ما أجلَسَنا إلَّا ذاكَ، قال: أما إنِّي لَم أستَحلِفكُم تُهمةً لَكُم، وما كان أحَدٌ بمَنزِلَتي مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم أقَلَّ عنه حَديثًا مِنِّي، وإنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم خَرَجَ على حَلقةٍ مِن أصحابِه، فقال: ما أجلَسَكُم؟ قالوا: ",["جَلَسنا نَذكُرُ اللَّهَ ونَحمَدُه على ما هَدانا للإسلامِ، ومَنَّ به علينا",1],"، قال: آللَّهِ ما أجلَسَكُم إلَّا ذاكَ؟ قالوا: واللَّهِ ما أجلَسَنا إلَّا ذاكَ، قال: أما إنِّي لَم أستَحلِفْكُم تُهمةً لَكُم، ولَكِنَّه أتاني جِبريلُ فأخبَرَني ",["أنَّ اللَّهَ عَزَّ وجَلَّ يُباهي بكُمُ المَلائِكةَ",2],"."],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"أدعية وأذكار › فضل الذكر","dorar":"sK9y3dfj","merged":2,"otherRefs":["صحيح النسائي 5441 (صحيح)"]},{"id":"س-01128","fp":"78c333d27f88","stateId":224,"easy":"إذا قلت «سبحانك اللهم وبحمدك وتبارك اسمك...» ← فهو أحب الكلام إلى الله","cause":"أن يقولَ العبدُ : سبحانَكَ اللَّهمَّ وبحمدِكَ ، وتبارَكَ اسمُكَ ، وتعالى جدُّكَ ، ولا إلَهَ غيرُكَ","result":"إنَّ أحبَّ الكلامِ إلى اللَّهِ","explicit":true,"apply":{"k":"say","t":"«سبحانك اللهم وبحمدك وتبارك اسمك...»"},"similar":["س-00856","س-01048"],"ref":"السلسلة الصحيحة 2939","srcLabel":"النسائي","text":[["إنَّ أحبَّ الكلامِ إلى اللَّهِ",2],[" أن يقولَ العبدُ : سبحانَكَ اللَّهمَّ وبحمدِكَ ، وتبارَكَ اسمُكَ ، وتعالى جدُّكَ ، ولا إلَهَ غيرُكَ",1]," ، وإنَّ أبغضَ الكلامِ إلى اللَّهِ أن يقولَ الرَّجلُ للرَّجلِ : اتَّقِ اللَّهَ ، فيقولُ عليكَ نفسَكَ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح رجاله ثقات","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10685)، والبيهقي في ((شعب الإيمان)) (630)، وقوام السنة في ((الترغيب والترهيب)) (766)","bab":"أدعية وأذكار › فضل الذكر","dorar":"kYlnAznC","merged":2,"otherRefs":["إتحاف الخيرة المهرة 6/426 (صحيح)"]},{"id":"س-00803","fp":"d95db8fa5136","stateId":224,"easy":"إذا حمدت الله وروحك تخرج ← فأنت بكل خير","cause":"تخرُجُ نفسُه مِن بينِ جنبيهِ وهو يحمَدُ اللهَ","result":"المؤمنُ بكلِّ خيرِ","explicit":true,"similar":["س-00811","س-01001"],"otherNeedIds":[62],"ref":"تخريج صحيح ابن حبان 2914","srcLabel":"النسائي","text":["كان ابنُ عبَّاسٍ يُكثِرُ أنْ يُحدِّثَ بهذا الحديثِ: أنَّ ابنةً لرسولِ اللهِ صلَّى اللهُ عليه وسلَّم حضَرَتها الوفاةُ فأخَذها فجعَلها بينَ يدَيهِ ثمَّ احتضَنها وهي تنزِعُ حتَّى خرَج نفسُها وهو يبكي فوضَعها فصاحت أمُّ أيمنَ ـ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( لا تبكي ) فقالت: ألا أرى رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يبكي ؟ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( إنْ أَبْكِ فإنَّما هي رحمةٌ، ",["المؤمنُ بكلِّ خيرِ",2]," ",["تخرُجُ نفسُه مِن بينِ جنبيهِ وهو يحمَدُ اللهَ",1]," )"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"الحديث صحيح","takhrij":"أخرجه النسائي (1843)، وأحمد (2412) باختلاف يسير","bab":"أدعية وأذكار › حمد الله في كل الأحوال","dorar":"w3sgDBps"},{"id":"س-00811","fp":"26feb38ba33b","stateId":224,"easy":"إذا حمدت الله حين تُنزع روحك ← فأنت عنده بكل خير","cause":"أنزِعُ نفْسَهُ مِنْ بَيْنِ جنبيْهِ وهو يَحْمَدُنِي","result":"إِنَّ الْمؤمِنَ مِنِّي بِعَرْضِ كُلِّ خيرٍ","explicit":true,"repOf":"س-00803","otherNeedIds":[62],"ref":"صحيح الجامع 4318","text":["قال اللهُ تعالَى : ",["إِنَّ الْمؤمِنَ مِنِّي بِعَرْضِ كُلِّ خيرٍ",2]," إِنَّي ",["أنزِعُ نفْسَهُ مِنْ بَيْنِ جنبيْهِ وهو يَحْمَدُنِي",1]],"grade":"صحيح","narrator":"أبو هريرة وابن عباس","muhaddith":"صحيح","bab":"أدعية وأذكار › حمد الله في كل الأحوال","dorar":"vq4KeuSQ"},{"id":"س-01106","fp":"7fd30cbb2e9b","stateId":224,"easy":"إذا هالك قيام الليل أو بخلت بالإنفاق أو جبنت عن الجهاد ← فأكثر من «سبحان الله وبحمده» فهي أحب إلى الله","cause":"من هالَه الليلُ أن يكابدَه ، أو بخِلَ بالمالِ أن يُنفِقَه ، أو جَبُنَ عن العدوِّ أن يقاتلَه ، فلْيُكثِر من سبحان اللهِ وبحمدِه","result":"فإنها أحبُّ إلى اللهِ","explicit":true,"apply":{"k":"time","t":"في الليل"},"otherNeedIds":[49],"ref":"صحيح الترغيب 1541","srcLabel":"الطبراني","text":[["من هالَه الليلُ أن يكابدَه ، أو بخِلَ بالمالِ أن يُنفِقَه ، أو جَبُنَ عن العدوِّ أن يقاتلَه ، فلْيُكثِر من ( سبحان اللهِ وبحمدِه ) ؛ ",1],["فإنها أحبُّ إلى اللهِ ",2],"من جبلِ ذهبٍ ينفقُه في سبيل اللهِ عزَّ وجلَّ ."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني (8/230) (7800)","bab":"أدعية وأذكار › فضل الذكر","dorar":"GJVQ379r"},{"id":"س-02263","fp":"c52cd0ccc302","stateId":224,"easy":"إذا مدحت الله ← فهو يحب المدح","cause":"المدحَ","result":"يحبُّ","explicit":true,"ref":"مجمع الزوائد 10/98","srcLabel":"أحمد","text":["أتيت النبيَّ صلَّى اللهُ عليه وسلَّم فقلت يا رسولَ اللهِ إني حمدتُ ربِّي تباركَ وتعالَى بمحامدَ ومِدَحٍ وإيَّاك فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم أما إن ربَّك تباركَ وتعالَى ",["يحبُّ",2]," ",["المدحَ",1]],"grade":"صحيح","narrator":"الأسود بن سريع","muhaddith":"أحد أسانيد أحمد رجاله رجال الصحيح","takhrij":"أخرجه أحمد (15628)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"DgE42KAm"},{"id":"س-00738","fp":"0fa6b67f841a","stateId":224,"easy":"إذا أكثرت من ذكر الله ← فلا تأتين الله بشيء أحب إليه منه","cause":"وأكثري من ذكرِ اللهِ","result":"فإنك لا تأتين اللهَ بشيءٍ أحبَّ إليه من كثرةِ ذكرِه","explicit":true,"ref":"المتجر الرابح 203","srcLabel":"الطبراني","text":["عن أمِّ أنسٍ رضي الله عنهما أنها قالت: يا رسولَ اللهِ أوصني قال: اهجري المعاصيَ فإنها أفضلُ الهجرةِ وحافظي على الفرائضِ فإنها أفضلُ الجهادِ ",["وأكثري من ذكرِ اللهِ",1]," ",["فإنك لا تأتين اللهَ بشيءٍ أحبَّ إليه من كثرةِ ذكرِه",2],"."],"grade":"حسن","narrator":"أم سليم بنت ملحان أم أنس بن مالك","muhaddith":"إسناده جيد","takhrij":"أخرجه ابن أبي الدنيا في ((الورع)) (48)، والطبراني (25/129) (313)، وابن شاهين في ((الترغيب في فضائل الأعمال)) (164) باختلاف يسير","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"Up6VLEuB"},{"id":"س-00910","fp":"fd2e3bfc1993","stateId":224,"easy":"إذا ذكرت الله وأنت ملاقٍ عدوك ← فأنت عبد الله حقاً","cause":"الذي يذكُرُني وهو مُلاقٍ قِرْنَه","result":"إنَّ عَبْدي كلَّ عَبْدي","explicit":true,"ref":"الفتوحات الربانية 5/62","srcLabel":"الترمذي","text":["إنَّ اللهَ تعالى يقولُ: ",["إنَّ عَبْدي كلَّ عَبْدي",2]," ",["الذي يذكُرُني وهو مُلاقٍ قِرْنَه",1],". يعني: عندَ القِتالِ."],"grade":"حسن","narrator":"عمارة بن زعكرة","muhaddith":"حسن غريب","takhrij":"أخرجه الترمذي (3580) واللفظ له، وابن سعد في ((الطبقات الكبرى)) (9612)، والبيهقي في ((شعب الإيمان)) (557) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"UpBHrLbH"},{"id":"س-01153","fp":"7a684a3952c7","stateId":224,"easy":"إذا ذكرت الله كثيراً ← فهو أحب ما تلقين الله به","cause":"واذكُري اللهَ كثيرًا","result":"فإنَّه أحَبُّ الأعمالِ إلى اللهِ أن تَلْقَينَه به","explicit":true,"ref":"مجمع الزوائد 10/78","srcLabel":"الطبراني","text":["أتَيتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم فقُلْتُ جعَلك اللهُ في الرَّفيقِ الأعلى مِنَ الجَنَّةِ وأنا معك وقُلْتُ يا رسولَ اللهِ عَلِّمْني عمَلًا صالحًا أعمَلُه فقال أقيمي الصَّلاةَ فإنَّها أعظَمُ الجهادِ واهجُري المعاصيَ فإنَّها أفضَلُ الهِجْرةِ ",["واذكُري اللهَ كثيرًا",1]," ",["فإنَّه أحَبُّ الأعمالِ إلى اللهِ أن تَلْقَينَه به",2]],"grade":"حسن","narrator":"أم سليم بنت ملحان أم أنس بن مالك","muhaddith":"[فيه] محمد بن إسماعيل الأنصاري عن يونس بن عمران بن أبي أنس وكلاهما ذكره ابن أبي حاتم ولم يذكر فيه جرحا وبقية رجاله ثقات","takhrij":"أخرجه  الطبراني (25/149) (359) باختلاف يسير، والبغوي في ((معجم الصحابة)) (45) بنحوه","bab":"أدعية وأذكار › فضل الذكر","dorar":"GRFNiP5n"},{"id":"س-06981","fp":"9a5908c05d3f","stateId":224,"easy":"إذا حمدت الله ← فإن ربك يحب الحمد","cause":"الحَمْدَ","result":"يُحِبُّ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-00773","ref":"الأحاديث المختارة 1451","text":["«كانَ الأَسوَدُ بنُ سَريعٍ رَجُلًا شاعِرًا، فقالَ: يا نَبيَّ اللهَ، أَلَا أُسْمِعُك مَحامِدَ حَمِدْتُ بها رَبِّي، قالَ: أَمَا إنَّ رَبَّك ",["يُحِبُّ",2]," ",["الحَمْدَ",1],"، أو: ما شيءٌ أَحَبُّ إليه الحَمْدُ مِن اللهِ عَزَّ وجَلَّ»."],"grade":"صحيح","narrator":"الأسود بن سريع","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"rY9hYWPR","merged":3,"otherRefs":["المستدرك على الصحيحين 6740 (صحيح)","شرح معاني الآثار 4/298 (صحيح)"]},{"id":"س-00856","fp":"02183685ed97","stateId":224,"easy":"إذا قلت «سبحان ربي وبحمده» ← فهو أحب الكلام إلى الله","cause":"سُبحانَ ربِّي وبحمدِهِ، سُبحانَ ربِّي وبحمدِهِ","result":"أيُّ الكَلامِ أحبُّ إلى اللَّهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«سبحان ربي وبحمده»"},"repOf":"س-01128","ref":"صحيح الترمذي 3593","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ عادَهُ، - أو أنَّ أبا ذرٍّ عادَ رَسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ - فقالَ: بأبي أنتَ وأمِّي يا رسولَ اللَّهِ، ",["أيُّ الكَلامِ أحبُّ إلى اللَّهِ",2]," قالَ ما اصطَفاهُ اللَّهُ لملائِكَتِهِ: ",["سُبحانَ ربِّي وبحمدِهِ، سُبحانَ ربِّي وبحمدِهِ",1]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3593)، وأحمد (21529) كلاهما بلفظه، ومسلم (2731) باختلاف يسير.","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"xVo36pxt","merged":3,"otherRefs":["صحيح الجامع 175 (صحيح)","صحيح مسلم 2731 (صحيح)"]},{"id":"س-01048","fp":"d09bd77c4c8b","stateId":224,"easy":"إذا قلت «سبحان الله وبحمده» ← فهو ما اصطفاه الله لملائكته وأحب الكلام إليه","cause":"ما اصْطَفاهُ لمَلائكتِه: سُبحانَ اللهِ وبحَمدِه، سُبحانَ اللهِ وبحَمدِه، ثلاثًا تَقولُها","result":"أيُّ الكلامِ أحَبُّ إلى اللهِ عزَّ وجلَّ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«سبحان الله وبحمده»"},"repOf":"س-01128","ref":"تخريج المسند لشعيب 21529","text":["قُلْتُ: يا رسولَ اللهِ، ",["أيُّ الكلامِ أحَبُّ إلى اللهِ عزَّ وجلَّ",2],"؟ قال: ",["ما اصْطَفاهُ لمَلائكتِه: سُبحانَ اللهِ وبحَمدِه، سُبحانَ اللهِ وبحَمدِه، ثلاثًا تَقولُها.",1]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2731)، والترمذي (3593)، والنسائي في ((السنن الكبرى)) (10661)، وأحمد (21529) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"bpiWTNhZ"},{"id":"س-01001","fp":"e6922e68bf99","stateId":224,"easy":"إذا حمدت الله عند نزع روحك ← تكون عنده بمنزلة كل خير","cause":"يحمَدُني وأَنا أنزعُ نفسَهُ من بينِ جَنبيهِ","result":"إنَّ عَبدي المُؤْمِنَ عندي بمنزلةِ كلِّ خَيرٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-00803","otherNeedIds":[62],"ref":"الصحيح المسند 1268","text":["إنَّ اللَّهَ عزَّ وجلَّ يقولُ : ",["إنَّ عَبدي المُؤْمِنَ عندي بمنزلةِ كلِّ خَيرٍ",2]," ، ",["يحمَدُني وأَنا أنزعُ نفسَهُ من بينِ جَنبيهِ",1]," ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح ، رجاله رجال الصحيح","takhrij":"أخرجه أحمد (8492)، والبزار (8471)، والحارث كما في ((بغية الباحث)) (259) واللفظ لهم.","bab":"أدعية وأذكار › فضل الذكر","dorar":"xUh2TF2x"},{"id":"س-01180","fp":"479ff17d8b18","stateId":224,"easy":"إذا راعيت أوقات الصلاة لذكر الله ← تكون من أحب عباد الله إليه","cause":"الذينَ يُراعونَ الشَّمسَ والقَمَرَ -وفي لفظٍ: والنُّجومَ- والأظِلَّةَ لذِكرِ اللَّهِ","result":"أحَبُّ عِبادِ اللَّهِ إلى اللَّهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تمهيد الفرش 99","srcLabel":"تمهيد الفرش","text":[["أحَبُّ عِبادِ اللَّهِ إلى اللَّهِ",2],[" الذينَ يُراعونَ الشَّمسَ والقَمَرَ -وفي لفظٍ: والنُّجومَ- والأظِلَّةَ لذِكرِ اللَّهِ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","bab":"أدعية وأذكار › فضل الذكر","dorar":"SYQFwd1c"},{"id":"س-04095","fp":"cab1b0dccb3e","stateId":224,"easy":"إذا حمدت الله ← فلا أحد أحب إليه الحمد من الله","cause":"الحمدِ","result":"وما من","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"مجمع الزوائد 8/22","srcLabel":"البيهقي","text":["التَّأنِّي من اللهِ والعَجَلةُ من الشَّيطانِ وما أحدٌ أكثرُ معاذيرَ من اللهِ ",["وما من",2]," شيءٍ أحبُّ إلى اللهِ من ",["الحمدِ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أبو يعلى (4256 )، والبيهقي في ((شعب الإيمان)) (4058 )","bab":"جن › صفة إبليس وجنوده","dorar":"mbnPxq0F"},{"id":"س-00681","fp":"c046d9ca7902","stateId":225,"easy":"إذا سألت الله المعافاة والعافية في الدنيا والآخرة ← فهي أحب الدعاء إلى الله","cause":"اللَّهمَّ إني أسألُكَ المعافاةَ والعافيَةَ في الدُّنيا والآخرةِ","result":"ما من دعوةٍ أحبَّ إلى اللهِ","explicit":true,"star":true,"otherNeedIds":[35,29],"ref":"تحفة الذاكرين 495","srcLabel":"الطبراني","text":["قالَ رسولُ اللَّهِ صلَّى اللهُ عليْهِ وسلَّمَ ",["ما من دعوةٍ أحبَّ إلى اللهِ",2]," من أن يدعوَ بِها أحدٌ مِن أن يقولَ ",["اللَّهمَّ إني أسألُكَ المعافاةَ والعافيَةَ في الدُّنيا والآخرةِ",1]],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (20/ 165) (346) بلفظه.","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"4tLsKMUj","merged":2,"otherRefs":["صحيح ابن ماجه 3120 (صحيح)"]},{"id":"س-00767","fp":"36edaae61ecd","stateId":225,"easy":"إذا دعوت الله ← فليس شيء أكرم على الله من الدعاء","cause":"الدُّعاءِ","result":"ليس شيءٌ أكرمَ على اللهِ","explicit":true,"otherNeedIds":[29],"ref":"الترغيب والترهيب 2/388","srcLabel":"الترمذي","text":[["ليس شيءٌ أكرمَ على اللهِ",2]," من ",["الدُّعاءِ",1]," في الرَّخاءِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (3370)، وابن ماجه (3829)، وأحمد (8748) باختلاف يسير.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"uCyW0VJC"},{"id":"س-05663","fp":"e9ebf80b2478","stateId":225,"easy":"إذا سألت الله من فضله ← فإنه يحب أن يُسأل","cause":"سلُوا اللهَ مِنْ فضْلِهِ","result":"فإِنَّ اللهَ يُحِبُّ أنْ يُسْأَلَ","explicit":true,"ref":"الجامع الصغير 4685","srcLabel":"الترمذي","text":[["سلُوا اللهَ مِنْ فضْلِهِ ، ",1],["فإِنَّ اللهَ يُحِبُّ أنْ يُسْأَلَ",2]," ، و أفضلُ العبادَةِ انتظارُ الفرَجِ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3571)، والطبراني (10/124) (10088)، والبيهقي في ((شعب الإيمان)) (1124)","bab":"رقائق وزهد › الصبر على البلاء","dorar":"qWdhTPE3"},{"id":"س-03163","fp":"be054fdcac17","stateId":225,"easy":"إذا ألححت في الدعاء ← يحبك الله","cause":"المُلِحِّينَ في الدُّعاءِ","result":"إنَّ اللهَ يُحِبُّ","explicit":true,"ref":"تخريج شرح الطحاوية 677","srcLabel":"الطبراني","text":["(",["إنَّ اللهَ يُحِبُّ",2],[" المُلِحِّينَ في الدُّعاءِ)",1],"."],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"سند رجاله ثقات إلا أن فيه عنعنة بقية","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (4/452)، والطبراني في ((الدعاء)) (20)، وابن عدي في ((الكامل في الضعفاء)) (7/163)","bab":"إيمان › توحيد الأسماء والصفات","dorar":"1Wr9I3I7"},{"id":"س-03128","fp":"9ef0c9fb63c8","stateId":225,"easy":"إذا قلت «لا إله إلا أنت، إني ظلمت نفسي فاغفر لي...» ← يعجب الله منك","cause":"إذا قالَ: لا إلَهَ إلَّا أنتَ، إنِّي قد ظَلمتُ نَفسي، فاغفِرْ لي ذُنوبي؛ إنَّه لا يَغفِرُ الذُّنوبَ إلَّا أنتَ","result":"إنَّ اللهَ ليَعْجبُ إلى العبدِ","explicit":true,"star":true,"apply":{"k":"say","t":"«لا إلَهَ إلَّا أنتَ، إنِّي قد ظَلمتُ نَفسي، فاغفِرْ لي ذُنوبي؛ إنَّه لا يَغفِرُ الذُّنوبَ إلَّا أنتَ»"},"otherNeedIds":[11],"ref":"المستدرك على الصحيحين 2517","srcLabel":"مسلم","text":["عنْ عَليّ بنِ رَبيعةَ أَنَّهُ كَانَ رِدْفًا لعَليٍّ رَضيَ اللهُ عنه، فلمَّا وَضَعَ رِجلَهُ في الرِّكابِ قالَ: باسمِ اللهِ، فلمَّا اسْتَوى على ظَهْرِ الدَّابَّةِ، قالَ: الحمدُ للهِ ثلاثًا، واللهُ أكبرُ ثلاثًا، {سُبْحَانَ الَّذِي سَخَّرَ لَنَا هَذَا وَمَا كُنَّا لَهُ مُقْرِنِينَ} [الزخرف: 13] الآيةَ، ثُمَّ قالَ: لا إلَهَ إلَّا أنتَ سُبحانَكَ، قد ظَلمتُ نَفسي فاغفِرْ لي ذُنوبي؛ إنَّه لا يَغفِرُ الذُّنوبَ إلَّا أنتَ، ثُمَّ مالَ إلى أَحدِ شِقَّيهِ فضَحِكَ، فقلتُ: يا أميرَ المؤمنينَ، ما يُضحِكُكَ؟ قالَ: إنِّي كنتُ رِدْفَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فصَنَعَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ كما صَنعتُ، فسَألتُهُ كما سَألْتَني، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["إنَّ اللهَ ليَعْجبُ إلى العبدِ",2]," ",["إذا قالَ: لا إلَهَ إلَّا أنتَ، إنِّي قد ظَلمتُ نَفسي، فاغفِرْ لي ذُنوبي؛ إنَّه لا يَغفِرُ الذُّنوبَ إلَّا أنتَ",1],"، قالَ: عَبدي عَرَفَ أنَّ له ربًّا يَغفِرُ ويُعاقِبُ."],"grade":"صحيح","narrator":"علي","muhaddith":"صحيح على شرط مسلم [وله شاهد]","takhrij":"أخرجه أبو داود (2602)، والترمذي (3446)، وأحمد (930) جميعهم بلفظ مقارب.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"aASAcGPW","merged":6,"otherRefs":["الكلم الطيب 173 (صحيح)","هداية الرواة 2368 (صحيح)","الكامل في الضعفاء 2/138 (حسن)","تخريج المسند لشاكر 2/110 (صحيح)","الأحاديث المختارة 677 (صحيح)"]},{"id":"س-06631","fp":"0490a3303764","stateId":226,"easy":"إذا صليت الصلاة على وقتها ← فهي أحب الأعمال إلى الله","cause":"الصَّلاةُ على وَقْتِها","result":"أيُّ الأعْمالِ أَحَبُّ إلى اللهِ","explicit":true,"star":true,"otherNeedIds":[45],"ref":"الأحكام الوسطى 1/ 248","srcLabel":"الأحكام الوسطى","text":["[عن عَبْدِ اللهِ بنِ مَسْعودٍ قالَ: سَألْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["أيُّ الأعْمالِ أَحَبُّ إلى اللهِ",2],"؟ قالَ: \"",["الصَّلاةُ على وَقْتِها\"",1],"، قُلْتُ: ثُمَّ أيُّ؟ قالَ: \"بِرُّ الوالِدَينِ\"، قُلْتُ: ثُمَّ أيُّ؟ قالَ: \"ثُمَّ الجِهادُ في سَبيلِ اللهِ\"، قالَ: حَدَّثَني بِهنَّ ولو اسْتَزَدْتُه لزادَني].\nوفي رِوايةٍ: الصَّلاةُ أوَّلَ وَقْتِها."],"grade":"صحيح","narrator":"عبد الله بن مسعود","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"kKJ3ekil","merged":19,"otherRefs":["تخريج سنن الدارقطني 967 (صحيح)","هداية الرواة 579 (صحيح)","الأحكام الشرعية الصغرى 153 (صحيح)","صحيح الجامع 1095 (صحيح)","صحيح الترمذي 173 (صحيح)","صحيح النسائي 609 (صحيح)","تخريج المسند لشاكر 6/107 (صحيح)","عارضة الأحوذي 1/238 (صحيح)","صحيح البخاري 7534 (صحيح)","صحيح البخاري 2782 (صحيح)","الجامع الصغير 195 (صحيح)","تخريج مشكل الآثار 2127 (صحيح)","تخريج المسند لشعيب 4313 (صحيح)","الأوسط لابن المنذر 2/182 (صحيح)","تخريج المسند لشعيب 3973 (صحيح)","الفتاوى الكبرى 5 / 117 (صحيح)","تخريج صحيح ابن حبان 1477 (صحيح)","صحيح أبي داود 426 (صحيح)"]},{"id":"س-06690","fp":"2ee620b3f952","stateId":226,"easy":"إذا صليت النافلة في بيتك ← فهي أحب من صلاتها في المسجد","cause":"ولأنْ أُصَلِّيَ -يَعْني في بَيْتي","result":"أَحَبُّ إليَّ مِن أن أُصَلِّيَ في المَسجِدِ إلَّا أن تكونَ صَلاةً مَكْتوبةً","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[47],"ref":"الأحاديث المختارة 9 / 409","srcLabel":"متفق عليه","text":["«سألَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ عمَّا يُوجِبُ الغُسْلَ، وعن الماءِ يكونُ بَعْدَ الماءِ، وعن الصَّلاةِ في بَيْتي، وعن الصَّلاةِ في المَسجِدِ، وعن مُؤاكَلةِ الحائِضِ، فقالَ: إنَّ اللهَ لا يَسْتَحي مِن الحَقِّ، أَمَّا أنا إذا فَعَلْتُ كَذا وكَذا -فذَكَرَ الغُسْلَ- قالَ: أَتَوَضَّأُ وُضوئي للصَّلاةِ أَغسِلُ فَرْجي -ثُمَّ ذَكَرَ الغُسْلَ- وأمَّا الماءُ يكونُ بَعْدَ الماءِ فذلك المَذْيُ، وكلُّ فَحْلٍ يُمْذي فأَغسِلُ مِن ذلك فَرْجي وأَتَوَضَّأُ، أمَّا الصَّلاةُ في المَسجِدِ والصَّلاةُ في بَيْتي فقدْ ترَى ما أَقرَبَ بَيْتي مِن المَسجِدِ، ",["ولأنْ أُصَلِّيَ -يَعْني في بَيْتي",1],"- ",["أَحَبُّ إليَّ مِن أن أُصَلِّيَ في المَسجِدِ إلَّا أن تكونَ صَلاةً مَكْتوبةً",2],"، وأمَّا مُؤاكَلةُ الحائِضِ فواكِلْها»."],"grade":"صحيح","narrator":"عبدالله بن سعد الأنصاري","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"صلاة الجماعة والإمامة › الحرص على حضور الجماعة","dorar":"mDjY1Gt4","merged":2,"otherRefs":["إرواء الغليل 2/190 (صحيح)"]},{"id":"س-03121","fp":"535aebf815b0","stateId":226,"easy":"إذا أوترت يا صاحب القرآن ← فالله وتر يحب الوتر","cause":"يا أَهْلَ القرآنِ أوتِروا","result":"فإنَّ اللَّهَ وترٌ يحبُّ الوترَ","explicit":true,"star":true,"similar":["س-03099"],"ref":"صحيح ابن خزيمة 2/ 254","srcLabel":"الترمذي","text":["قالَ عليٌّ: إنَّ الوترَ ليسَ بِحَتمٍ، ولا كصلاتِكُمُ المَكْتوبةِ، ولَكِنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ أوترَ، ثمَّ قالَ: ",["يا أَهْلَ القرآنِ أوتِروا",1]," ؛ ",["فإنَّ اللَّهَ وترٌ يحبُّ الوترَ",2]," [وفي روايةٍ] لَم يذكرْ: يا أَهْلَ القرآنِ أوتِروا"],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الترمذي (453)، وابن ماجه (1169) واللفظ لهما، وأحمد (1232)، والدارمي (1620) بنحوه.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"JZsyXNDb","merged":4,"otherRefs":["الترغيب والترهيب 1/277 (صحيح)","صحيح ابن ماجه 968 (صحيح)","تخريج المسند لشاكر 2/310 (صحيح)"]},{"id":"س-06909","fp":"3b8542d8004e","stateId":226,"easy":"إذا قمت من فراشك ودفئك وأهلك إلى صلاتك ← يعجب ربك منك","cause":"رجلٌ ثار عن وِطائِهِ ولِحافِهِ من بينِ حِبِّهِ وأهلِهِ إلى صلاتِهِ","result":"عَجِبَ ربُّنا من رَجُلَيْنِ","explicit":true,"otherNeedIds":[47],"ref":"هداية الرواة 1207","srcLabel":"أحمد","text":[["عَجِبَ ربُّنا من رَجُلَيْنِ",2]," : ",["رجلٌ ثار عن وِطائِهِ ولِحافِهِ من بينِ حِبِّهِ وأهلِهِ إلى صلاتِهِ",1],"، فيقولُ اللهُ لملائكتِهِ : انظُروا إلى عبدي ؛ ثار عن فراشِهِ ووِطائِهِ من بينِ حِبِّهِ وأهلِهِ إلى صلاتِهِ، رغبةً فيما عندي، وشَفَقًا مما عندي، ورجلٌ غَزَا في سبيلِ اللهِ، فانهزم مع أصحابِهِ، فَعَلِمَ ما عليه في الانهزامِ، وما له في الرجوعِ، فرجع حتى هُرِيقَ دَمُهُ، فيقولُ اللهُ – تعالى – لملائكتِهِ : انظُروا إلى عبدي، رجع رغبةً فيما عندي، وشَفَقًا مما عندي حتى هُرِيقَ دَمُهُ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"حسن أو صحيح","takhrij":"أخرجه أحمد (3949)، وابن خزيمة في ((التوحيد)) (2/895)، وابن حبان (2557) باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"ORDx8vif","merged":3,"otherRefs":["صحيح الترغيب 630 (صحيح)","مشارع الأشواق 929 (صحيح)"]},{"id":"س-06467","fp":"55d68c6fd836","stateId":226,"easy":"إذا صلّت المرأة في أخفى مكان من بيتها ← فهي أحب صلاتها إلى الله","cause":"أن تصلِّيَ في أشدِّ مَكانٍ مِن بَيتِها ظلمةً","result":"إنَّ أحبَّ صلاةٍ تصلِّيها المرأةُ إلى اللَّهِ","explicit":true,"ref":"صحيح ابن خزيمة 3/ 180","srcLabel":"ابن عدي","text":[["إنَّ أحبَّ صلاةٍ تصلِّيها المرأةُ إلى اللَّهِ",2]," ",["أن تصلِّيَ في أشدِّ مَكانٍ مِن بَيتِها ظلمةً",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن عدي في ((الكامل)) (4/ 179) بنحوه، وابن عبد البر في ((التمهيد)) (23/ 399) بنحوه مطولًا.","bab":"صلاة › فرض الصلاة","dorar":"2bOSHiIb","merged":2,"otherRefs":["الجامع الصغير 7908 (حسن)"]},{"id":"س-00009","fp":"5d8081427e20","stateId":226,"easy":"إذا تقربت إلى الله بالنوافل ← يحبك الله","cause":"يتقرَّبُ إليَّ بالنَّوافلِ","result":"حتَّى أحبَّهُ","explicit":true,"similar":["س-01004"],"ref":"مجمع الزوائد 2/250","srcLabel":"أحمد","text":["من آذى وليًّا فقدِ استحلَّ محاربتي وما تقرَّبَ إليَّ عبدي بمثلِ الفرائضِ وما يزالُ العبدُ ",["يتقرَّبُ إليَّ بالنَّوافلِ",1]," ",["حتَّى أحبَّهُ",2]," إنَّ سألني أعطيتُهُ وإن دعاني أجبتُهُ وما تردَّدتُ عن شيءٍ أنا فاعلُهُ تردُّدي عن وفاتِهِ لأنَّهُ يكرَهُ الموتَ وأكرَهُ مساءتَهُ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"فيه عبد الواحد بن قيس وبقية رجاله رجال الصحيح","takhrij":"أخرجه أحمد (26193)، وابن أبي الدنيا في ((الأولياء)) (45)، والبزار (99) باختلاف يسير","bab":"آداب الدعاء › استجابة الدعاء","dorar":"63PS0rcn"},{"id":"س-00909","fp":"f792ea4131d0","stateId":226,"easy":"إذا أديت فريضة ثم انتظرت أخرى ← يباهي الله بك الملائكة","cause":"أدَّوا حقًّا من حقِّي ثمَّ هم ينتَظِرونَ أداءَ حقٍّ آخرَ يؤدُّونَهُ","result":"ففاخَرَ بِكُمُ الملائِكَةَ","explicit":true,"similar":["س-01236"],"ref":"تخريج المسند لشاكر 11/82","srcLabel":"ابن ماجه","text":["حدَّثَنا رجُلٌ منَ الشَّامِ وَكانَ يتبعُ عبدَ اللَّهِ بنَ عمرو بنِ العاصِ ويسمَعُ قالَ :كُنتُ معَهُ فلقيَ نوفًا فقالَ نوفٌ : ذُكِرَ لَنا أنَّ اللَّهَ تعالى قالَ لملائِكَتِهِ ادعوا لي عِبادي قالوا يا ربِّ كيفَ والسَّمواتُ السَّبعُ دونَهُم والعَرشُ فوقَ ذلِكَ قالَ إنَّهم إذا قالوا لا إلَهَ إلَّا اللَّهُ استَجابوا قالَ يقولُ لَهُ عبدُ اللَّهِ بنُ عمرٍو صلَّينا معَ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ صلاةَ المغربِ أو غيرَها قالَ فجلَسَ قومٌ أَنا فيهم ينتَظِرونَ الصَّلاةَ الأُخرى قالَ فأقبلَ إلَينا يُسرِعُ المشيَ كأنِّي أنظرُ إلى رَفعِهِ إزارَهُ ليَكونَ أحثَّ لَهُ في المشيِ فانتَهَى إلَينا فقالَ ألا أبشِروا هذاكَ ربُّكم أمرَ ببابِ السَّماءِ الوُسطى - أو قالَ ببابِ السَّماءِ - ففُتِحَ ",["ففاخَرَ بِكُمُ الملائِكَةَ",2]," قالَ انظُروا إلى عبادي ",["أدَّوا حقًّا من حقِّي ثمَّ هم ينتَظِرونَ أداءَ حقٍّ آخرَ يؤدُّونَهُ",1]],"grade":"صحيح","narrator":"ثابت البناني","muhaddith":"إسناده صحيح","takhrij":"أخرجه الدارمي في ((الرد على الجهمية)) (38) بلفظه، وابن ماجه (801) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"hOfjwH7B"},{"id":"س-01004","fp":"1ba0d448a93d","stateId":226,"easy":"إذا تقربت إلى الله بالنوافل ← يحبك، فيكون سمعك وبصرك ويدك ورجلك","cause":"ولا يزالُ عَبْدي يتقَرَّبُ إليَّ بالنَّوافِلِ","result":"حتَّى أُحِبَّه، فإذا أحبَبْتُه كُنتُ سَمْعَه الذي يَسمَعُ به، وبَصَرَه الذي يُبصِرُ به، ويدَه التي يَبطِشُ بها، ورِجْلَه التي يمشي بها. فبي يَسْمَعُ، وبي يُبصِرُ، وبي يَبطِشُ، وبي يَمْشي، ولَئِنْ سَأَلني لأُعطِيَنَّه، ولئِنْ استعاذَني لأُعيذَنَّه","explicit":true,"repOf":"س-00009","otherNeedIds":[25,29],"ref":"الفتاوى الكبرى 1/206","text":["عن النَّبيِّ صلَّى اللهُ عليه وسلَّم أنَّه قال: يقولُ اللهُ تعالى: مَن عادى لي وَلِيًّا فقد بارَزَني بالمحارَبةِ، وما تقَرَّب إليَّ عَبْدي بمِثْلِ أداءِ ما افتَرَضْتُ عليه، ",["ولا يزالُ عَبْدي يتقَرَّبُ إليَّ بالنَّوافِلِ",1]," ",["حتَّى أُحِبَّه، فإذا أحبَبْتُه كُنتُ سَمْعَه الذي يَسمَعُ به، وبَصَرَه الذي يُبصِرُ به، ويدَه التي يَبطِشُ بها، ورِجْلَه التي يمشي بها. فبي يَسْمَعُ، وبي يُبصِرُ، وبي يَبطِشُ، وبي يَمْشي، ولَئِنْ سَأَلني لأُعطِيَنَّه، ولئِنْ استعاذَني لأُعيذَنَّه",2],"، وما ترَدَّدْتُ في شَيءٍ أنا فاعِلُه ترَدُّدي في قَبْضِ نَفْسِ عَبْديَ المؤمِنِ؛ يَكرَهُ الموتَ وأكرَهُ مَساءَتَه، ولا بُدَّ له منه»"],"grade":"صحيح","muhaddith":"صحيح","bab":"أدعية وأذكار › فضل الذكر","dorar":"wJbFCjFe"},{"id":"س-01480","fp":"3a36e3b8b1ea","stateId":226,"easy":"إذا صليت من الليل والنهار ما استطعت ← تحبك الحفظة","cause":"وصَلِّ مِن اللَّيلِ والنَّهارِ ما استطَعْتَ","result":"يُحِبَّكَ الحَفَظَةُ","explicit":true,"ref":"الضعفاء الكبير 1/148","srcLabel":"البزار","text":["يا أَنَسُ، أسبِغِ الوضوءَ يَزِدْ في عُمُرِكَ، ",["وصَلِّ مِن اللَّيلِ والنَّهارِ ما استطَعْتَ",1]," ",["يُحِبَّكَ الحَفَظَةُ",2],"، وصَلِّ صلاةَ الضُّحى؛ فإنَّها صلاةُ الأوَّابينَ، فإنِ استطَعْتَ ألَّا تنامَ إلَّا على طهارةٍ، فإنَّكَ إن مِتَّ مِتَّ شهيدًا، وسلِّمْ على أهلِ بيتِكَ يكثُرْ خيرُ بيتِكَ، ووقِّرِ الكبيرَ، وارحَمِ الصَّغيرَ، تُرافِقْني في الجنَّةِ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"ليس لهذا المتن عن أنس إسناد صحيح","takhrij":"أخرجه البزار (7396)، وأبو يعلى (4183)، والعقيلي في ((الضعفاء الكبير)) (1/148) واللفظ له","bab":"وضوء › فضل الوضوء","dorar":"CfQ83tTb"},{"id":"س-06596","fp":"adf7a954a68f","stateId":226,"easy":"إذا سجدت معفّراً وجهك في التراب ← فهي أحب حال تكون عليها إلى الله","cause":"أن يراهُ ساجدًا يُعفِّرُ وجهَهُ في التُّرابِ","result":"ما مِن حالةٍ يَكونُ العبدُ عليها أحبُّ إلى اللَّهِ","explicit":true,"otherNeedIds":[26],"ref":"الترغيب والترهيب 1/193","srcLabel":"الطبراني","text":[["ما مِن حالةٍ يَكونُ العبدُ عليها أحبُّ إلى اللَّهِ",2]," من ",["أن يراهُ ساجدًا يُعفِّرُ وجهَهُ في التُّرابِ",1]],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6075) بلفظه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"hNv7zxcF"},{"id":"س-06882","fp":"e79badbab984","stateId":226,"easy":"إذا قمت في جوف الليل خفية فتوضأت وصليت ← يضحك الله إليك","cause":"رجلٌ قام في جوْفِ اللَّيلِ لا يعلمُ به أحدٌ فتوضَّأ فأسبغ الوضوءَ ، ثمَّ حمِد اللهَ ومجَّده ، وصلَّى على النَّبيِّ صلَّى اللهُ عليه وسلَّم ، واستفتح القرآنَ","result":"فذاك الَّذي يضحكُ اللهُ إليه","explicit":true,"apply":{"k":"time","t":"في الليل"},"ref":"القول البديع 264","srcLabel":"النسائي","text":["عن ابنِ مسعودٍ رضِي اللهُ عنه ، قال : يضحكُ اللهُ إلى رجلَيْن ، رجلٌ لَقي العدوَّ وهو على فرسٍ من أمْثَلِ خيلِ أصحابِه فانهزموا ، وثبُت ، فإن قُتِل استُشهِد ، وإن بَقي فذاك الَّذي يضحكُ اللهُ إليه ، و",["رجلٌ قام في جوْفِ اللَّيلِ لا يعلمُ به أحدٌ فتوضَّأ فأسبغ الوضوءَ ، ثمَّ حمِد اللهَ ومجَّده ، وصلَّى على النَّبيِّ صلَّى اللهُ عليه وسلَّم ، واستفتح القرآنَ",1]," ، ",["فذاك الَّذي يضحكُ اللهُ إليه",2]," ، يقولُ : انظُروا إلى عبدي قائمًا لا يراه أحدٌ غيري"],"grade":"صحيح","narrator":"[أبو عبيدة]","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((الكبرى)) (10637) واللفظ له، وابن السني في ((عمل اليوم والليلة)) (صـ688)، وأبو نعيم في ((الحلية)) (4/ 205) بنحوه.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"JIS6fpb9"},{"id":"س-05705","fp":"bfa7ee0df9d6","stateId":226,"easy":"إذا قمت تصلي والناس نيام في سفرك ← تكون ممن يحبهم الله","cause":"رَجلٌ يُسافرُ مع قومٍ، فأَدْلَجوا حتَّى إذا كانوا مِن آخِرِ اللَّيلِ، وَقَعَ عليهم الكَرَى والنُّعاسُ، فضَرَبوا رؤوسَهُم، ثُمَّ قامَ فتَطَهَّرَ رَهبةً للهِ ورَغبةً لما عندَهُ","result":"الَّذين يُحِبُّهُم اللهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"المستدرك على الصحيحين 2481","srcLabel":"مسلم","text":["كان يَبلُغُني عنْ أَبي ذَرٍّ حديثٌ، فكنتُ أَشْتَهي لقاءَهُ، فلَقِيتُه، فقلتُ له: يا أَبا ذَرٍّ، كان يَبلُغُني عنكَ حديثٌ، فكنتُ أَشْتَهي لقاءَكَ، قالَ: للهِ أبوكَ، فقد لَقِيتَني، قالَ: قلتُ: حديثٌ بَلَغَني أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ حدَّثَكَ، قالَ: إنَّ اللهَ يُحِبُّ ثلاثةً ويُبغِضُ ثلاثةً؟ قالَ: فلا أَخالُني أَكذِبُ على خَليلي. قالَ: قلتُ: مَنْ هؤلاء ",["الَّذين يُحِبُّهُم اللهُ",2],"؟ قالَ: رَجلٌ غَزا في سبيلِ اللهِ صابِرًا مُحتَسِبًا مُجاهدًا، فلَقِيَ العدوَّ فقاتَلَ حتَّى قُتِلَ، وأنتم تَجِدونَه عندَكُم في كتابِ اللهِ المُنزَّلِ، ثُمَّ قَرَأَ هذه الآيةَ: {إِنَّ اللَّهَ يُحِبُّ الَّذِينَ يُقَاتِلُونَ فِي سَبِيلِهِ صَفًّا كَأَنَّهُم بُنْيَانٌ مَّرْصُوصٌ} [الصف: 4] قلتُ: ومَنْ؟ قالَ: رَجلٌ له جارُ سوءٍ يُؤذيهِ، فيَصبِرُ على إيذائهِ حتَّى يَكفيَهُ اللهُ إيَّاهُ؛ إمَّا بحياةٍ أوْ موتٍ، قلتُ: ومَنْ؟ قالَ: ",["رَجلٌ يُسافرُ مع قومٍ، فأَدْلَجوا حتَّى إذا كانوا مِن آخِرِ اللَّيلِ، وَقَعَ عليهم الكَرَى والنُّعاسُ، فضَرَبوا رؤوسَهُم، ثُمَّ قامَ فتَطَهَّرَ رَهبةً للهِ ورَغبةً لما عندَهُ",1],"، قلتُ: فمَنِ الثَّلاثةُ الَّذين يُبغِضُهُم اللهُ؟ قالَ: المُختالُ الفَخورُ، وأنتم تَجدونَهُ في كتابِ اللهِ المُنزَّلِ: {إِنَّ اللَّهَ لَا يُحِبُّ كُلَّ مُخْتَالٍ فَخُورٍ} [لقمان: 18]، قلتُ: ومَنْ؟ قالَ: البَخيلُ المَنَّانُ، قالَ: ومَنْ؟ قالَ: التَّاجِرُ الحلَّافُ أوِ البائعُ الحلَّافُ."],"grade":"صحيح","narrator":"أبو ذر","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه الترمذي (2568)، والنسائي (2570)، وأحمد (21355)، وابن خزيمة (2456) واللفظ لهم.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"szU2OW1W"},{"id":"س-03099","fp":"78384f36f851","stateId":226,"easy":"إذا أوترت ← فإن الله وتر يحب الوتر","cause":"الوَترَ، خلَقَ مِن خَلْقِه سَبعَ سَمواتٍ، فاستوى عليهِنَّ، وخلَقَ الأرضَ سبعًا، وجعَلَ عِدَّةَ الأيَّامِ سبعًا، ورَمْيَ الجِمارِ سبعًا، وخَلَقَ الإنسانَ مِن سبعٍ، وجعَلَ رزقَهُ مِن سبعٍ","result":"إنَّ اللهَ وَترٌ يُحِبُّ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-03121","ref":"لطائف المعارف 364","text":["كان ناسٌ مِنَ المهاجرينَ وجَدوا على عمرَ رَضِيَ اللهُ عنه في إدنائِهِ ابنَ عبَّاسٍ رَضِيَ اللهُ عنهما؛ فجمَعَهم، ثمَّ سألَهم عن ليلةِ القَدرِ، فأكثَروا فيها، فقال بعضُهم: كنَّا نراها في العَشرِ الأوسطِ، ثمَّ بلَغَنا أنَّها في العشرِ الأواخِرِ، فأكثَروا فيها، فقال بعضُهم: ليلةُ إحدى وعشرينَ، وقال بعضُهم: ليلةُ ثلاثٍ وعِشرينَ، وقال بعضُهم: ليلةُ سبعٍ وعشرينَ، فقال عُمرُ رَضِيَ اللهُ عنه: يا بنَ عبَّاسٍ، تكلَّمْ، فقال: اللهُ أعلَمُ، قال عمرُ: قد نعلَمُ أنَّ اللهَ يعلَمُ، وإنَّما نسألُكَ عن عِلمِكَ، فقال ابنُ عبَّاسٍ رَضِيَ اللهُ عنهما: ",["إنَّ اللهَ وَترٌ يُحِبُّ",2],[" الوَترَ، خلَقَ مِن خَلْقِه سَبعَ سَمواتٍ، فاستوى عليهِنَّ، وخلَقَ الأرضَ سبعًا، وجعَلَ عِدَّةَ الأيَّامِ سبعًا، ورَمْيَ الجِمارِ سبعًا، وخَلَقَ الإنسانَ مِن سبعٍ، وجعَلَ رزقَهُ مِن سبعٍ",1],"، فقال عمرُ: خلَقَ الإنسانَ مِن سبعٍ، وجعَلَ رزقَهُ مِن سبعٍ، هذا أمْرٌ ما فهِمْتُه، فقال: إنَّ اللهَ تعالى يقولُ: {وَلَقَدْ خَلَقْنَا الْإِنْسَانَ مِنْ سُلَالَةٍ مِنْ طِينٍ} [المؤمنون: 12]، حتَّى بلَغَ آخِرَ الآياتِ، وقرأَ: {أَنَّا صَبَبْنَا الْمَاءَ صَبًّا (25) ثُمَّ شَقَقْنَا الْأَرْضَ شَقًّا (26) فَأَنْبَتْنَا فِيهَا حَبًّا (27) وَعِنَبًا وَقَضْبًا (28) وَزَيْتُونًا وَنَخْلًا (29) وَحَدَائِقَ غُلْبًا (30) وَفَاكِهَةً وَأَبًّا (31) مَتَاعًا لَكُمْ وَلِأَنْعَامِكُمْ} [عبس: 25 - 32]، ثمَّ قال: والأبُّ للدَّوابِّ."],"grade":"صحيح","narrator":"سعيد بن جبير","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن سعد في ((الطبقات الكبرى)) (6/ 328)، وابن عبد البر في ((التمهيد)) (2/ 209)، والبلاذري في ((أنساب الأشراف)) (4/ 33) بنحوه مطولًا.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"8hg94Dfq","merged":8,"otherRefs":["صحيح الجامع 2167 (صحيح)","تخريج المسند لشعيب 5880 (صحيح)","تسديد القوس 1/200 (صحيح)","تخريج المسند لشاكر 2/124 (صحيح)","صحيح البخاري 6410 (صحيح)","صحيح مسلم 2677 (صحيح)","الأحاديث المختارة 534 (صحيح)"]},{"id":"س-03879","fp":"f009418359a7","stateId":226,"easy":"إذا تهجدت في الليل ← فهو مما كان يعجب النبي ﷺ","cause":"التهجدَ منَ الليلِ","result":"كانَ يعجبُه","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"الجامع الصغير 7077","srcLabel":"الطبراني","text":[["كانَ يعجبُه",2]," ",["التهجدَ منَ الليلِ",1]],"grade":"حسن","narrator":"جندب بن عبدالله","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((الأوسط)) (5654)، وفي ((المعجم الكبير)) (2/ 175) (1720) واللفظ له.","bab":"تراويح وتهجد وقيام ليل › فضل قيام الليل","dorar":"IEdOi3TD"},{"id":"س-01236","fp":"1f5b904a93ee","stateId":226,"easy":"إذا أديت فريضة وانتظرت أخرى ← يباهي الله بك الملائكة","cause":"أدَّوا فَريضةً وهم ينتظِرونَ أُخرى","result":"يُباهي بكم الملائكةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-00909","ref":"تخريج المسند لشعيب 6946","text":["أنَّ نَوفًا وعبدَ اللهِ بنَ عمرٍو اجتَمَعا، فقال نَوفٌ، فذكَرَ الحديثَ، فقال عبدُ اللهِ بنُ عمرِو بنِ العاصِ: وأنا أحدِّثُكَ عن النَّبيِّ صلَّى اللهُ عليه وسلَّمَ: صلَّيْنا مع النَّبيِّ صلَّى اللهُ عليه وسلَّمَ ذاتَ لَيلةٍ، فعقَّبَ مَن عقَّبَ، ورجَعَ مَن رجَعَ، فجاء رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ قبلَ أنْ يثورَ النَّاسُ بصلاةِ العِشاءِ، فجاء وقد حفَزَه النَّفَسُ، رافعًا إصبعَه هكذا، وعقَدَ تِسعًا وعشرينَ، وأشارَ بإصبعِه السَّبَّابةِ إلى السَّماءِ، وهو يقولُ: أبشِروا مَعشرَ المُسلمينَ، هذا ربُّكم عزَّ وجلَّ قد فتَحَ بابًا مِن أبوابِ السَّماءِ، ",["يُباهي بكم الملائكةَ",2],"، يقولُ: يا ملائكتي، انظُروا إلى عِبادي هؤلاء ",["أدَّوا فَريضةً وهم ينتظِرونَ أُخرى",1],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (801) المرفوع منه، وأحمد (6946) واللفظ له","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"rxfen3fC","merged":2,"otherRefs":["طرح التثريب 2/366 (صحيح)"]},{"id":"س-03147","fp":"63c0db1b7bb4","stateId":226,"easy":"إذا كنت راعياً في جبل تؤذن وتصلي ← يغفر الله لك ويدخلك الجنة","cause":"راعي غَنَمٍ في رَأسِ الشَّظيَّةِ للجَبَلِ يُؤذِّنُ بالصَّلاةِ ويُصلِّي","result":"قد غَفَرتُ له وأدخَلتُهُ الجَنَّةَ","explicit":true,"star":true,"otherNeedIds":[11,67],"ref":"تخريج المسند لشعيب 17443","srcLabel":"أبو داود","text":["يَعجَبُ ربُّك... فذكَرَ مَعناهُ، إلَّا أنَّه قال: يَخافُ مِنِّي؟! قد غَفَرْتُ له، فأَدخَلْتُه الجَنَّةَ. [أي مَعْنى حديثِ: يَعجَبُ ربُّك من ",["راعي غَنَمٍ في رَأسِ الشَّظيَّةِ للجَبَلِ يُؤذِّنُ بالصَّلاةِ ويُصلِّي",1],"، فيقولُ اللهُ: انْظُروا إلى عَبْدي هذا، يُؤذِّنُ ويُقيمُ، يخافُ شَيئًا؟ ",["قد غَفَرتُ له وأدخَلتُهُ الجَنَّةَ",2],"]"],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1203)، والنسائي (666)، وأحمد (17443) واللفظ له","bab":"إيمان › توحيد الأسماء والصفات","dorar":"k0woA5nI","merged":3,"otherRefs":["تخريج كتاب السنة 572 (حسن)","صحيح الجامع 8102 (صحيح)"]},{"id":"س-02851","fp":"ada55f04c410","stateId":226,"easy":"إذا أحسنت الصلاة في العلانية والسر ← يقول الله: هذا عبدي حقاً","cause":"إنَّ العَبْدَ إذا صلَّى في العَلانيَةِ فأَحسَنَ، ثُمَّ صلَّى في السِّرِّ فأَحسَنَ","result":"قالَ اللهُ تَبارَكَ وتَعالى: هذا عَبْدي حَقًّا","explicit":true,"star":true,"ref":"الأحكام الوسطى 4/ 277","srcLabel":"ابن ماجه","text":["\"",["إنَّ العَبْدَ إذا صلَّى في العَلانيَةِ فأَحسَنَ، ثُمَّ صلَّى في السِّرِّ فأَحسَنَ، ",1],["قالَ اللهُ تَبارَكَ وتَعالى: هذا عَبْدي حَقًّا\"",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه ابن ماجه (4200) بلفظه.","bab":"إيمان › الوعد","dorar":"4qAPkeo1"},{"id":"س-06720","fp":"f4117bb8d105","stateId":226,"easy":"إذا قضيت فريضة وجلست تنتظر أخرى ← يباهي الله بك الملائكة","cause":"مَلائكتَه بمَن قَضى فَريضةً وجلَسَ يَنتَظِرُ أُخْرى","result":"أنَّ اللهَ يُباهي","explicit":true,"ref":"تخريج زاد المعاد 1/394","srcLabel":"ابن ماجه","text":[["أنَّ اللهَ يُباهي",2],[" مَلائكتَه بمَن قَضى فَريضةً وجلَسَ يَنتَظِرُ أُخْرى",1],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (801)، وأحمد (6750)، والبزار (2365)، والطبراني (13/ 588) (14502) واللفظ لهم مطولا.","bab":"صلاة الجماعة والإمامة › فضل صلاة الجماعة","dorar":"08jy5rSu"},{"id":"س-03103","fp":"b38bb09ad58f","stateId":226,"easy":"إذا قمت الليل تصلي أو اصطففت في الصلاة أو في القتال ← يضحك الله إليك","cause":"الرَّجلُ إذا قام باللَّيلِ يصلِّي والقومُ إذا صَفُّوا في الصلاةِ والقومُ إذا صَفُّوا في قتالِ العدوِّ","result":"ثلاثةٌ يضحكُ اللَّهُ إليهمْ","explicit":true,"apply":{"k":"time","t":"في الليل"},"ref":"هداية الرواة 2/46","srcLabel":"أحمد","text":[["ثلاثةٌ يضحكُ اللَّهُ إليهمْ",2]," ",["الرَّجلُ إذا قام باللَّيلِ يصلِّي والقومُ إذا صَفُّوا في الصلاةِ والقومُ إذا صَفُّوا في قتالِ العدوِّ",1]],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه ابن أبي شيبة (19663)، وابن أبي عاصم في ((الجهاد)) (140) واللفظ لهما، وأحمد (11761) باختلاف يسير.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"7mkRa9O0"},{"id":"س-06508","fp":"1928a6c8f5ab","stateId":226,"easy":"إذا صليت في أول الوقت ← فهو رضوان الله","cause":"الوقتُ الأوَّلُ منَ الصَّلاةِ","result":"رضوانُ اللَّهِ","explicit":true,"ref":"هداية الرواة 1/297","srcLabel":"الترمذي","text":[["الوقتُ الأوَّلُ منَ الصَّلاةِ",1]," ",["رضوانُ اللَّهِ",2]," والوقتُ الآخِرُ عفوُ اللَّهِ"],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه الترمذي (172) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (7/148)، والبيهقي (2131) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"bOC7wao8"},{"id":"س-06638","fp":"e3a973cc4c69","stateId":227,"easy":"إذا كثر الجمع (في الصلاة) ← فهو أحب إلى الله","cause":"وما كانَ أَكثَرَ","result":"فهو أَحَبُّ إلى اللهِ","explicit":true,"star":true,"ref":"الأحاديث المختارة 1196","srcLabel":"البخاري","text":["«كُنْتُ معَ أُبَيِّ بنِ كَعْبٍ في مَرَضِه، فسَمِعَ المُناديَ بالأذانِ، فقالَ: الأذانُ هذا أو الإقامةُ؟ فقُلْنا: الإقامةُ، فقالَ: ما تَنْتَظِرونَ؟ أَلَا تَنْهَضونَ إلى صَلاتِكم؟ فقُلْنا: ما بِنا إلَّا مَكانُك، فقالَ: لا تَفعَلوا قُوموا، إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ صلَّى بِنا صَلاةَ الفَجْرِ، فلمَّا سلَّمَ أَقبَلَ على القَوْمِ بوَجْهِه، فقالَ: أَشاهِدٌ فُلانٌ، حتَّى دَعا ثَلاثةً كلُّهم في مَنازِلِهم لم يَحْضُروا، فقالَ: إنَّ أَثقَلَ الصَّلاةِ على المُنافِقينَ صَلاةُ الفَجْرِ والعِشاءِ، ولو يَعلَمونَ ما فيهما لَأَتَوْهما ولو حَبْوًا، واعْلَمْ أنَّ صَلاتَك معَ رَجُلٍ أَفضَلُ مِن صَلاتِك وَحْدَك، وأنَّ صَلاتَك معَ رَجُلَينِ أَفضَلُ مِن صَلاتِك معَ رَجُلٍ، ",["وما كانَ أَكثَرَ",1]," ",["فهو أَحَبُّ إلى اللهِ",2],"، أَلَا وإنَّ الصَّفَّ المُقدَّمَ على مِثلِ صَفِّ المَلائِكةِ، ولو تَعلَمونَ فَضيلتَه لابْتَدَرْتُموه، أَلَا وإنَّ صَلاةَ الجَماعةِ تَفضُلُ على صِلاةِ الرَّجُلِ وَحْدَه أرْبَعًا وعِشْرينَ أو خَمْسًا وعِشْرينَ دَرَجةً»."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"EGIRXhcj","merged":12,"otherRefs":["تخريج المسند لشعيب 21266 (حسن)","صحيح ابن حبان 2056 (صحيح)","المستدرك على الصحيحين 831 (صحيح)","تحفة المحتاج 1/437 (صحيح)","صحيح ابن خزيمة 3/ 11 (صحيح)","صحيح ابن خزيمة 3/ 13 (صحيح)","الترغيب والترهيب 1/202 (صحيح)","صحيح الترغيب 411 (حسن)","الأحاديث المختارة 1199 (صحيح)","الأحاديث المختارة 1197 (صحيح)","الأحاديث المختارة 1198 (صحيح)"]},{"id":"س-07059","fp":"7360cace80a1","stateId":227,"easy":"إذا لازمت المساجد ← فهي خير البقاع","cause":"المساجدُ","result":"خيرَ البِقاعِ","explicit":true,"apply":{"k":"time","t":"في السجود"},"otherNeedIds":[47],"ref":"المستدرك على الصحيحين 2181","srcLabel":"البيهقي","text":["جاءَ رَجلٌ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقالَ: يا رسولَ اللهِ، أيُّ البِقاعِ خيرٌ؟ فقالَ: لا أَدْري. قالَ: فأيُّ البِقاعِ شرٌّ؟ فقالَ: لا أَدْري. فقالَ: سَلْ ربَّكَ. فقالَ جِبريلُ: ما نَسألُه عنْ شيءٍ، قالَ: فانتَفَضَ انتِفاضةً، كادَ أنْ يُصعَقَ منها مُحمَّدٌ صلَّى اللهُ عليه وسلَّمَ، فلمَّا صَعِدَ جِبريلُ قالَ اللهُ تَعالَى: سَألَكَ مُحمَّدٌ أيُّ البِقاعِ خيرٌ؟ فقلتَ: لا أَدْري، وسَألَكَ: أيُّ البقاعِ شرٌّ؟ فقلتَ: لا أَدْري، قالَ: فقالَ: نَعَمْ، قالَ: فحدِّثْهُ أنَّ ",["خيرَ البِقاعِ",2]," ",["المساجدُ",1],"، وأنَّ شرَّ البِقاعِ الأَسواقُ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"]صحيح[","takhrij":"أخرجه البيهقي (5049)، وابن عبد البر في ((جامع بيان العلم (1550) كلاهما بلفظه، والحارث بن أبي أسامة في ((بغية الباحث)) (124) باختلاف يسير.","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"54yhHQhp","merged":6,"otherRefs":["فتاوى نور على الدرب لابن باز 33/231 (صحيح)","الترغيب والترهيب 1/173 (صحيح)","العلو للذهبي 99 (حسن)","صحيح مسلم 671 (صحيح)","المهذب في اختصار السنن 2/995 (حسن)"]},{"id":"س-08126","fp":"35253a438ec2","stateId":227,"easy":"إذا مشيت خطوة تصل بها صفاً ← فلا خطوة أحب إلى الله منها","cause":"خطوةٍ يمشيها العبدُ يصِلُ بها صفًّا","result":"وما من خطوةٍ أحبُّ إلى اللهِ","explicit":true,"ref":"صحيح الترغيب 507","srcLabel":"أبو داود","text":["إنَّ اللهَ وملائكتَه يصلُّون على الذين يَصلون الصفوفِ الأُوَلِ ، ",["وما من خطوةٍ أحبُّ إلى اللهِ",2]," من ",["خطوةٍ يمشيها العبدُ يصِلُ بها صفًّا",1]],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (543)، والبيهقي (3/ 348) بلفظه، وأحمد (18646) بنحوه مختصرا.","bab":"ملائكة › أعمال الملائكة","dorar":"nkWA3EOS"},{"id":"س-04820","fp":"64af6e00a581","stateId":227,"easy":"إذا سددت خللاً في الصف ← فهي أحب الخطا إلى الله","cause":"فرجلٌ نظرَ إلى خَللٍ في الصَّفِّ فسدَّهُ","result":"فأمَّا الَّتي يحبُّها اللَّهُ عزَّ وجلَّ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الترغيب والترهيب 1/235","srcLabel":"الحاكم","text":["خُطوتانِ إحداهما أحبُّ الخُطا إلى اللَّهِ والأُخرى أبغضُ الخطا إلى اللَّهِ ، ",["فأمَّا الَّتي يحبُّها اللَّهُ عزَّ وجلَّ",2]," ",["فرجلٌ نظرَ إلى خَللٍ في الصَّفِّ فسدَّهُ",1]," ، وأمَّا الَّتي يبغَضُها اللَّهُ فإذا أرادَ الرَّجلُ أن يقومَ مدَّ رجلَهُ اليُمنى ووضعَ يدَهُ عليه أو أثبتَ اليُسرَى ثمَّ قامَ"],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الحاكم (1008)، والبيهقي (3712)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"jHfZbRTz"},{"id":"س-03168","fp":"9b7fee1f75ca","stateId":227,"easy":"إذا استجمرت فأوترت ← فالله وتر يحب الوتر","cause":"إذا اسْتَجْمَرَ أَحَدُكُمْ فَلْيوتِرْ","result":"فإنَّ اللهَ وِتْرٌ يُحِبُّ الوِتْرَ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 571","srcLabel":"متفق عليه","text":["«",["إذا اسْتَجْمَرَ أَحَدُكُمْ فَلْيوتِرْ",1],"؛ ",["فإنَّ اللهَ وِتْرٌ يُحِبُّ الوِتْرَ",2],"، أَما تَرى السَّمَواتِ سَبْعًا، والأَرَضينَ سَبْعًا، والطَّوافَ [والطَّوافَ والجِمَارَ وذكَر أشياءَ]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه ابن حبان (1437) واللفظ له، والبخاري (161)، ومسلم (237) مقتصر على جملة منه","bab":"إيمان › توحيد الأسماء والصفات","dorar":"5S4NhzPi","merged":2,"otherRefs":["صحيح الجامع 1830 (صحيح)"]},{"id":"ق-0530","fp":"2c13bada801e","stateId":227,"easy":"حب التطهر ← محبة الله","cause":"حب التطهر","result":"محبة الله","explicit":true,"ref":"سورة التوبة: 108","srcLabel":"القرآن الكريم","quran":{"s":9,"from":108,"to":108,"text":"لَا تَقُمْ فِيهِ أَبَدًا لَمَسْجِدٌ أُسِّسَ عَلَى التَّقْوَى مِنْ أَوَّلِ يَوْمٍ أَحَقُّ أَنْ تَقُومَ فِيهِ فِيهِ رِجَالٌ يُحِبُّونَ أَنْ يَتَطَهَّرُوا وَاللَّهُ يُحِبُّ الْمُطَّهِّرِينَ (108)","hl":[[108,186,1]]}},{"id":"س-07708","fp":"a2fb30cbcdf6","stateId":227,"easy":"إذا أحسنت الطهارة (الاستنجاء بالماء) ← يحسن الله عليك الثناء","cause":"يَغسِلونَ أدبارَهُم منَ الغائطِ فغَسلنا كما غَسَلوا","result":"إنَّ اللَّهَ قد أحسنَ عليكُمُ الثَّناءَ في الطُّهورِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح ابن خزيمة 1/ 203","srcLabel":"أحمد","text":["أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ لأَهْلِ قُباءَ: ",["إنَّ اللَّهَ قد أحسنَ عليكُمُ الثَّناءَ في الطُّهورِ",2],"، وقالَ: { فِيهِ رِجَالٌ يُحِبُّونَ أَنْ يَتَطَهَّرُوا } [التوبة: 108] حتَّى انقَضتِ الآيةُ، فقالَ لَهُم: ما هذا الطُّهورُ؟ فقالوا: ما نَعلمُ شيئًا إلَّا أنَّهُ كانَ لَنا جيرانٌ منَ اليَهودِ، وَكانوا ",["يَغسِلونَ أدبارَهُم منَ الغائطِ فغَسلنا كما غَسَلوا",1]],"grade":"صحيح","narrator":"عويم بن ساعدة الأنصاري ثم العجلاني","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (15485)، والطبري في ((التفسير)) (11/ 690)، وأبو نعيم في ((معرفة الصحابة)) (5322) واللفظ لهم.","bab":"قرآن › أسباب النزول","dorar":"pNzDJrqA"},{"id":"س-00930","fp":"1d50307074c2","stateId":227,"easy":"إذا لازمت المساجد للصلاة والذكر ← يفرح الله بك كما يفرح أهل الغائب بقدومه","cause":"ما تَوَطَّنَ رجلٌ مسلمٌ المساجِدَ للصلاةِ والذكْرِ","result":"إلَّا تَبَشْبَشَ اللهُ لَهُ منْ حينِ يَخْرُجُ مِنْ بَيْتِهِ ، كَمَا يتَبَشْبَشُ أهلُ الغائِبِ بغائِبِهِمْ ، إذا قدِمَ علَيْهم","explicit":true,"star":true,"apply":{"k":"time","t":"في السجود"},"similar":["س-03138"],"ref":"الجامع الصغير 7861","srcLabel":"ابن ماجه","text":[["ما تَوَطَّنَ رجلٌ مسلمٌ المساجِدَ للصلاةِ والذكْرِ ،",1]," ",["إلَّا تَبَشْبَشَ اللهُ لَهُ منْ حينِ يَخْرُجُ مِنْ بَيْتِهِ ، كَمَا يتَبَشْبَشُ أهلُ الغائِبِ بغائِبِهِمْ ، إذا قدِمَ علَيْهم",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (8332)،  وابن ماجه (800)، وابن الجعد في ((مسنده)) (2838) واللفظ لهم.","bab":"أدعية وأذكار › فضل الذكر","dorar":"TmlZfhSf","merged":2,"otherRefs":["صحيح الترغيب 327 (صحيح)"]},{"id":"س-02006","fp":"1933a8df2924","stateId":227,"easy":"إذا كنت تلازم المساجد فشغلك أمر ثم عدت ← يفرح الله بعودتك كما يفرح أهل الغائب","cause":"ما مِن رجُلٍ كانَ يوطِّنُ المساجِدَ فشغلَهُ أمرٌ أو علَّةٌ، ثُمَّ عادَ إلى ما كانَ","result":"إلَّا تَبشَبشَ اللَّهُ إليهِ كما يتَبَشبَشُ أَهْلُ الغائبِ بغائبِهِم إذا قدِمَ","explicit":true,"apply":{"k":"time","t":"في السجود"},"ref":"صحيح ابن خزيمة 1/ 451","srcLabel":"أحمد","text":[["ما مِن رجُلٍ كانَ يوطِّنُ المساجِدَ فشغلَهُ أمرٌ أو علَّةٌ، ثُمَّ عادَ إلى ما كانَ",1]," ",["إلَّا تَبشَبشَ اللَّهُ إليهِ كما يتَبَشبَشُ أَهْلُ الغائبِ بغائبِهِم إذا قدِمَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن ماجة (800)، وأحمد (9841)، والحاكم (771) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"F8dPH0bl"},{"id":"س-03138","fp":"dfd7dfe04e5a","stateId":227,"easy":"إذا لازمت المسجد للصلاة والذكر ← يفرح الله بك كما يفرح أهل الغائب بقدومه","cause":"لا يُوطِّنُ الرَّجُلُ المسجِدَ للصَّلاةِ أو لذِكْرِ اللهِ","result":"إلَّا تَبَشْبَشَ اللهُ به كما يَتَبَشْبَشُ أهلُ الغائبِ إذا قدِم عليهم غائبُهم","explicit":true,"repOf":"س-00930","ref":"تخريج صحيح ابن حبان 1607","text":[["لا يُوطِّنُ الرَّجُلُ المسجِدَ للصَّلاةِ أو لذِكْرِ اللهِ",1]," ",["إلَّا تَبَشْبَشَ اللهُ به كما يَتَبَشْبَشُ أهلُ الغائبِ إذا قدِم عليهم غائبُهم",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح، على شرط الشيخين","takhrij":"أخرجه ابن حبان (1607) واللفظ له، وابن ماجه (800)، وأحمد (9841) كلاهما باختلاف يسير.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"tWEiJt1Q"},{"id":"س-06841","fp":"d1f50a28ffa4","stateId":227,"easy":"إذا صليت في جماعة ← يعجب الله منك","cause":"الصَّلاةِ في الجمعِ","result":"إنَّ اللَّهَ تبارَكَ وتعالى ليَعجبُ منَ","explicit":true,"ref":"الترغيب والترهيب 1/200","srcLabel":"أحمد","text":[["إنَّ اللَّهَ تبارَكَ وتعالى ليَعجبُ منَ",2],[" الصَّلاةِ في الجمعِ",1]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (5112) واللفظ له، وابن المبارك في ((الزهد والرقائق)) (الملحق/ 29) وفيه قصة.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"5vDvcw6B"},{"id":"س-05824","fp":"8f377c6cfd9e","stateId":227,"easy":"إذا استكت ← يطهر فمك ويرضى ربك","cause":"السِّواكُ","result":"مطهرةٌ للفَمِ مَرضاةٌ للرَّبِّ","explicit":true,"star":true,"ref":"صحيح ابن خزيمة 1/ 254","srcLabel":"النسائي","text":["قالَت: قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: ",["السِّواكُ ",1],["مطهرةٌ للفَمِ مَرضاةٌ للرَّبِّ",2]],"grade":"صحيح","narrator":"عائشة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (24203)، والدارمي (711)، والنسائي (5) بلفظه","bab":"رقائق وزهد › الوصايا النافعة","dorar":"OZLQMENy","merged":4,"otherRefs":["تخريج المسند لشعيب 26014 (صحيح)","الجامع الصغير 4818 (حسن)","صحيح ابن حبان 1070 (صحيح)"]},{"id":"س-01380","fp":"6939458b0046","stateId":227,"easy":"إذا أحسنت الوضوء ثم أتيت المسجد لا تريد إلا الصلاة ← يفرح الله بك كما يفرح أهل الغائب بطلعته","cause":"لا يَتَوضَّأُ أحَدٌ فيُحسِنُ وُضوءَه ويُسبِغُه، ثُمَّ يَأتي المَسجِدَ لا يُريدُ إلَّا الصَّلاةَ","result":"إلَّا تَبَشْبَشَ اللهُ به كما يَتَبَشْبَشُ أهْلُ الغائِبِ بطَلْعتِه","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"ref":"الصحيح المسند 2/307","srcLabel":"الصحيح المسند","text":["أنَّه سَمِعَ أبا هُرَيْرةَ يقولُ: ",["لا يَتَوضَّأُ أحَدٌ فيُحسِنُ وُضوءَه ويُسبِغُه، ثُمَّ يَأتي المَسجِدَ لا يُريدُ إلَّا الصَّلاةَ ",1],["إلَّا تَبَشْبَشَ اللهُ به كما يَتَبَشْبَشُ أهْلُ الغائِبِ بطَلْعتِه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","bab":"وضوء › إسباغ الوضوء","dorar":"qYApAF5q"},{"id":"س-05925","fp":"361cfb726b98","stateId":227,"easy":"إذا لزمت السواك ← يطيب فمك ويرضى عنك ربك","cause":"عليكُمْ بِالسِّوَاكِ","result":"فإنَّهُ مَطْيَبَةٌ لِلْفَمِ ، مَرْضَاةٌ لِلرَّبِّ تَبارَكَ وتَعالَى","explicit":true,"ref":"صحيح الترغيب 210","srcLabel":"أحمد","text":[["عليكُمْ بِالسِّوَاكِ ؛ ",1],["فإنَّهُ مَطْيَبَةٌ لِلْفَمِ ، مَرْضَاةٌ لِلرَّبِّ تَبارَكَ وتَعالَى",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (5865) واللفظ له، والطبراني في ((المعجم الأوسط)) (3113)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"qddhReDv"},{"id":"س-06958","fp":"f7f47a99d923","stateId":228,"easy":"إذا أحببت سورة الإخلاص لأنها صفة الرحمن ← يحبك الله","cause":"لأنَّها صِفةُ الرَّحمَنِ","result":"أخبِروه أنَّ اللَّهَ يُحِبُّه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"صحيح مسلم 813","srcLabel":"البخاري","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم بَعَثَ رَجُلًا على سَريَّةٍ، وكان يَقرَأُ لأصحابِه في صَلاتِهم، فيَختِمُ بقُل هو اللهُ أحَدٌ، فلَمَّا رَجَعوا ذُكِرَ ذلك لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: سَلوه لأيِّ شيءٍ يَصنَعُ ذلك؟ فسَألوه، فقال: ",["لأنَّها صِفةُ الرَّحمَنِ",1],"، فأنا أُحِبُّ أن أقرَأ بها، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["أخبِروه أنَّ اللَّهَ يُحِبُّه",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7375)، والنسائي (993)، وابن حبان (793) جميعهم باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"oNlxj41K","merged":2,"otherRefs":["تخريج صحيح ابن حبان 793 (صحيح)"]},{"id":"س-06823","fp":"dead9a8677e3","stateId":228,"easy":"إذا قرأت «قل أعوذ برب الفلق» ← فلن تقرأ سورة أحب إلى الله ولا أبلغ عنده منها","cause":"اقرأ بأَعُوذُ بِرَبِّ الْفَلَقِ","result":"فإنَّكَ لن تقرأَ بسورةٍ أحبَّ إلى اللَّهِ منْها، وأبلغَ عندَهُ منْها فإن استطعتَ أن لا تفوتَكَ فافعلْ","explicit":true,"apply":{"k":"say","t":"«قل أعوذ برب الفلق»"},"ref":"الآداب الشرعية 3/232","srcLabel":"مسلم","text":["قلتُ يا رسولَ اللَّهِ أقرأُ من سورةِ يوسفَ ومن سورةِ هودٍ ؟ قالَ يا عقبةُ ",["اقرأ بأَعُوذُ بِرَبِّ الْفَلَقِ ",1],["فإنَّكَ لن تقرأَ بسورةٍ أحبَّ إلى اللَّهِ منْها، وأبلغَ عندَهُ منْها فإن استطعتَ أن لا تفوتَكَ فافعلْ",2]],"grade":"حسن","narrator":"عقبة بن عامر","muhaddith":"إسناده جيد","takhrij":"أخرجه الحاكم (4046) واللفظ له، والنسائي (5439)، وأحمد (17455) بنحوه، وأصل الحديث في مسلم (814).","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"ZtUpmPKI"},{"id":"س-07812","fp":"eebf22632505","stateId":228,"easy":"إذا أحببت القرآن ← فأنت تحب الله ورسوله","cause":"فإنْ كان يُحِبُّ القرآنَ","result":"فهو يُحِبُّ اللهَ ورسولَهُ","explicit":true,"ref":"مجمع الزوائد 7/168","srcLabel":"الطبراني","text":["عنْ عبدِ اللهِ يعني ابنَ مسعودٍ قال مَنْ أَحَبَّ أنْ يُحِبَّهُ اللهُ ورسولُهُ فلْيَنْظُرْ ",["فإنْ كان يُحِبُّ القرآنَ",1]," ",["فهو يُحِبُّ اللهَ ورسولَهُ",2]],"grade":"حسن","narrator":"[عبدالرحمن بن يزيد]","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني (9/ 132) (8657)، والبيهقي في ((الشعب)) (1861) واللفظ لهم.ا، وابن المبارك في ((الزهد والرقائق)) (ص388) بنحوه.","bab":"قرآن › فضل قراءة القرآن","dorar":"027S39FW"},{"id":"س-07817","fp":"07e1d294cad4","stateId":228,"easy":"إذا قرأت في المصحف ← تحب الله ورسوله","cause":"فليَقرأْ في المُصْحَفِ","result":"مَنْ سَرَّهُ أنْ يُحِبَّ اللهَ و رسولَهُ","explicit":true,"ref":"السلسلة الصحيحة 2342","srcLabel":"البيهقي","text":[["مَنْ سَرَّهُ أنْ يُحِبَّ اللهَ و رسولَهُ",2]," ",["فليَقرأْ في \" المُصْحَفِ",1]," \""],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (2/449)، وأبو نعيم في ((حلية الأولياء)) (7/209) واللفظ له، والبيهقي في ((شعب الإيمان)) (2219)","bab":"قرآن › فضل قراءة القرآن","dorar":"LzQxgkub"},{"id":"س-08022","fp":"a50065a92a3a","stateId":229,"easy":"إذا أعطيت سائلاً سراً لا يعلمه إلا الله ← تكون ممن يحبهم الله","cause":"فرَجلٌ أَتى قومًا، فسَأَلَهُم باللهِ، ولمْ يَسأَلْهم بقَرابةٍ بيْنَهم وبيْنَه، فتَخلَّفَ رَجلٌ بأَعْقابِهم، فأَعْطاهُ سِرًّا، لا يَعلَمُ بعطيَّتِه إلَّا اللهُ والَّذي أَعْطاهُ، وقومٌ ساروا لَيلَهُم حتَّى إذا كان النَّومُ أَحَبَّ إليهم ممَّا يَعدِلُ نَزَلوا، فَوَضَعوا رؤوسَهُم، فقامَ يَتمَلَّقُني ويَتْلو ورَجلٌ كان في سَريَّةٍ، فلَقِيَ العَدوَّ فهُزِموا، فأَقْبَلَ بصدْرِه، حتَّى يُقتَلَ أوْ يُفتَحَ له","result":"أمَّا الَّذين يُحِبُّهُم اللهُ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 2568","srcLabel":"الترمذي","text":["ثلاثةٌ يُحِبُّهُم اللهُ، وثلاثةٌ يُبغِضُهُم اللهُ: ",["أمَّا الَّذين يُحِبُّهُم اللهُ",2],"، ",["فرَجلٌ أَتى قومًا، فسَأَلَهُم باللهِ، ولمْ يَسأَلْهم بقَرابةٍ بيْنَهم وبيْنَه، فتَخلَّفَ رَجلٌ بأَعْقابِهم، فأَعْطاهُ سِرًّا، لا يَعلَمُ بعطيَّتِه إلَّا اللهُ والَّذي أَعْطاهُ، وقومٌ ساروا لَيلَهُم حتَّى إذا كان النَّومُ أَحَبَّ إليهم ممَّا يَعدِلُ نَزَلوا، فَوَضَعوا رؤوسَهُم، فقامَ يَتمَلَّقُني ويَتْلو ورَجلٌ كان في سَريَّةٍ، فلَقِيَ العَدوَّ فهُزِموا، فأَقْبَلَ بصدْرِه، حتَّى يُقتَلَ أوْ يُفتَحَ له",1],"، والثَّلاثةُ الَّذين يُبغِضُهُم اللهُ: الشَّيخُ الزَّاني، والفقيرُ المُخْتالُ، والغَنيُّ الظُّلومُ."],"grade":"صحيح","narrator":"أبو ذر","muhaddith":"[إسناده صحيح]","takhrij":"أخرجه الترمذي (2568)، والنسائي (2570)، وأحمد (21355)، وابن خزيمة (2456) واللفظ لهم.","bab":"مظالم › تحريم الظلم","dorar":"LHuTXdJR","merged":2,"otherRefs":["تخريج صحيح ابن حبان 3350 (صحيح)"]},{"id":"س-03123","fp":"8a0fb393e0b7","stateId":229,"easy":"إذا افتخرت بالصدقة (أظهرت السخاء) ← فهو خيلاء يحبها الله","cause":"والمَخيلةُ إذا تَصدَّقَ الرَّجلُ","result":"يُحبُّها اللَّهُ","explicit":true,"star":true,"ref":"صحيح ابن خزيمة 4/ 190","srcLabel":"أحمد","text":["غَيرتانِ إحداهُما يحبُّها اللَّهُ، والأُخرَى يبغضُها اللَّهُ: الغيرةُ في الرِّيبةِ يُحبُّها اللَّهُ والغَيرةُ في غيرِ ريبةٍ يبغضُها اللَّهُ، ",["والمَخيلةُ إذا تَصدَّقَ الرَّجلُ",1]," ",["يُحبُّها اللَّهُ",2],"، والمَخيلةُ في الكبرِ يُبغِضُها اللَّهُ. وقالَ: ثلاثةٌ تستجابُ دعوتُهُمُ، الوالدُ والمُسافرُ والمَظلومُ وقالَ: إنَّ اللَّهَ يدخلُ الجنَّةَ بالسَّهمِ الواحدِ ثلاثةً، صانعَهُ والممدَّ بِهِ، والرَّاميَ بِهِ في سَبيلِ اللَّهِ"],"grade":"صحيح","narrator":"عقبة بن عامر الجهني","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (17398)، والروياني في ((المسند)) (186)، والحاكم (1525) واللفظ لهم.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"CFBRAfYL"},{"id":"س-04891","fp":"99f4372ecb30","stateId":229,"easy":"إذا كنت جاهلاً سخياً ← فأنت أحب إلى الله من عابد بخيل","cause":"و الجاهلُ السخيُّ","result":"أحبَّ إلى الله من عابدٍ بخيلٍ","explicit":true,"ref":"الجامع الصغير 4788","srcLabel":"الطبراني","text":["السخيُّ قريبٌ من اللهِ،  قريبٌ من الناسِ،  قريبٌ من الجنةِ،  بعيدٌ من النارِ،  و البخيلُ بعيدٌ من اللهِ،  بعيدٌ من الناسِ،  بعيدٌ من الجنةِ،  قريبٌ من النارِ،  ",["و الجاهلُ السخيُّ",1]," ",["أحبَّ إلى الله من عابدٍ بخيلٍ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (2363) واللفظ له، والخطيب في ((البخلاء)) (50)، وقاضي المارستان في ((المشيخة الكبرى)) (168) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"hnNRxHyo"},{"id":"س-06929","fp":"63e1933393cc","stateId":229,"easy":"إذا آثرت ضيفك على نفسك وأهلك ← يعجب الله من فعلك (من قصة)","cause":"فجَعَلا يُريانِه أنَّهما يَأكُلانِ، فباتا طاويَينِ","result":"ضَحِكَ اللهُ اللَّيلةَ -أو عَجِبَ- مِن فعالِكُما","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح البخاري 3798","srcLabel":"ابن حبان","text":["أنَّ رَجُلًا أتى النَّبيَّ صلَّى اللهُ عليه وسلَّم، فبَعَثَ إلى نِسائِه، فقُلنَ: ما معنا إلَّا الماءُ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: مَن يَضُمُّ -أو يُضيفُ- هذا؟ فقال رَجُلٌ مِنَ الأنصارِ: أنا، فانطَلَقَ به إلى امرَأتِه، فقال: أكرِمي ضَيفَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقالت: ما عِندَنا إلَّا قوتُ صِبياني، فقال: هَيِّئي طَعامَكِ، وأصبِحي سِراجَكِ، ونَوِّمي صِبيانَكِ إذا أرادوا عَشاءً، فهَيَّأت طَعامَها، وأصبَحَت سِراجَها، ونَوَّمَت صِبيانَها، ثُمَّ قامَت كَأنَّها تُصلِحُ سِراجَها فأطفَأتْه، ",["فجَعَلا يُريانِه أنَّهما يَأكُلانِ، فباتا طاويَينِ",1],"، فلَمَّا أصبَحَ غَدا إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: ",["ضَحِكَ اللهُ اللَّيلةَ -أو عَجِبَ- مِن فعالِكُما",2],". فأنزَلَ اللهُ: {ويُؤثِرونَ على أنفُسِهم ولَو كان بهم خَصاصةٌ ومَن يُوقَ شُحَّ نَفسِه فَأُولَئِكَ هُمُ المُفلِحونَ} [الحشر: 9]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه ابن حبان (7264)، والحاكم (7176)، وأبو يعلى (6194) بنحوه.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"0hRNFkL7","merged":4,"otherRefs":["صحيح مسلم 2054 (صحيح)","تخريج كتاب السنة 570 (صحيح)","المستدرك على الصحيحين 7372 (صحيح)"]},{"id":"س-01622","fp":"3406f2ca4bb3","stateId":229,"easy":"إذا صنعت طعاماً ودعوت المساكين ← فالله يحب اليتامى والمساكين (من قصة يعقوب)","cause":"فاصنَعْ طعامًا وادْعُ المساكينَ","result":"إنِّي لم أحبَّ شيئًا من خلقي حبِّي اليتامَى والمساكينَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الترغيب والترهيب 3/316","srcLabel":"الحاكم","text":["أنَّ رجلًا قال ليعقوبَ عليه السَّلامُ ما الَّذي أذهب بصرَك وحنَى ظهرَك قال أمَّا الَّذي أذهب بصري فالبكاءُ على يوسفَ وأمَّا الَّذي حنَى ظهري فالحزنُ على أخيه بنيامينَ فأتاه جبريلُ عليه السَّلامُ فقال أتشكو اللهَ عزَّ وجلَّ قال إنَّما أشكو بثِّي وحُزني إلى اللهِ قال جبريلُ عليه السَّلامُ اللهُ أعلمُ بما قلتَ منك قال ثمَّ انطلق جبريلُ عليه السَّلامُ ودخل يعقوبُ عليه السَّلامُ بيتَه فقال أيْ ربِّ أما ترحمُ الشَّيخَ الكبيرَ أذهبتَ بصري وحنَيْتَ ظهري فاردُدْ عليَّ ريحانتَيَّ فأشُمَّهما شمَّةً واحدةً ثمَّ اصنَعْ بي بعد ما شئتَ فأتاه جبريلُ فقال يا يعقوبُ إنَّ اللهَ عزَّ وجلَّ يُقرِئُك السَّلامَ ويقولُ أبشِرْ فإنَّهما لو كانا ميِّتَيْن لنشرتُهما لك لأُقِرَّ بهما عينَك ويقولُ لك يا يعقوبُ أتدري لم أذهبتُ بصرَك وحنَيْتُ ظهرَك ولِمَ فعل إخوةُ يوسفَ بيوسفَ ما فعلوه قال لا قال إنَّه أتاك يتيمٌ مسكينٌ وهو صائمٌ جائعٌ وذبحتَ أنت وأهلُك شاةً فأكلتموها ولم تطعِموه ويقولُ ",["إنِّي لم أحبَّ شيئًا من خلقي حبِّي اليتامَى والمساكينَ",2]," ",["فاصنَعْ طعامًا وادْعُ المساكينَ",1]," قال أنسٌ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فكان يعقوبُ كلَّما أمسَى نادَى مناديه من كان صائمًا فليحضُرْ طعامَ يعقوبَ وإذا أصبح نادَى مناديه من كان مُفطرًا فليفطِرْ على طعامِ يعقوبَ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((الأوسط)) (6/170)، ووالحاكم (2/378)، والبيهقي في ((الشعب)) (3/230) باختلاف يسير.","bab":"أطعمة › إطعام الطعام","dorar":"DmIQUj0a"},{"id":"س-02000","fp":"7ac9ae4e33cf","stateId":229,"easy":"إذا تصدقت سراً ← تطفئ غضب الله","cause":"وعليكم بصدَقةِ السِّرِّ","result":"فإنَّها تُطفِئُ غضَبَ اللهِ عزَّ وجلَّ","explicit":true,"star":true,"similar":["س-05783"],"ref":"التنوير شرح الجامع الصغير 7/309","srcLabel":"ابن أبي الدنيا","text":["عليكم باصطناعِ المعروفِ؛ فإنَّه يَمنَعُ مَصارِعَ السُّوءِ، ",["وعليكم بصدَقةِ السِّرِّ",1],"؛ ",["فإنَّها تُطفِئُ غضَبَ اللهِ عزَّ وجلَّ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"متنه صحيح","takhrij":"أخرجه ابن أبي الدنيا في ((اصطناع المعروف)) (6)، وابن الخطاب في ((مشيخته)) (105)، وإسماعيل الأصبهاني في ((الترغيب والترهيب)) (315) بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"8QIIya4I"},{"id":"س-05783","fp":"b44b3774a680","stateId":229,"easy":"إذا تصدقت سراً ← تطفئ غضب الرب","cause":"والصدقةُ خُفيا","result":"تُطفِئُ غضبَ الربِّ","explicit":true,"repOf":"س-02000","ref":"الجامع الصغير 5024","text":["صنائعُ المعروفِ تَقي مصارعَ السوءِ ",["والصدقةُ خُفيا",1]," ",["تُطفِئُ غضبَ الربِّ",2],"، وصلةُ الرحِمِ زيادةٌ في العمُرِ، وكلُّ معروفٍ صدَقَةٌ، وأهلُ المعروفِ في الدنيا هم أهلُ المعروفِ في الآخرةِ، وأهلُ المُنكَرِ في الدنيا هم أهلُ المُنكَرِ في الآخِرَةِ، وأولُ مَن يدخُلُ الجنةَ أهلُ المعروفِ"],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6086)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"FXfMwMQ4"},{"id":"س-06940","fp":"ea29cf3b11f8","stateId":229,"easy":"إذا تصدقت ← تطفئ غضب الرب وتدفع عنك ميتة السوء","cause":"إنَّ الصَّدقةَ","result":"لتطفئُ غضبَ الرَّبِّ وتدفعُ مَيتةَ السُّوءِ","explicit":true,"otherNeedIds":[62],"ref":"الزواجر عن اقتراف الكبائر 1/193","srcLabel":"الزواجر عن اقتراف الكبائر","text":[["إنَّ الصَّدقةَ",1]," ",["لتطفئُ غضبَ الرَّبِّ وتدفعُ مَيتةَ السُّوءِ",2]," ، وفي روايةٍ :  إِنَّ اللَّهَ ليَدرأُ بالصَّدقةِ سبعينَ بابًا من ميتةِ السُّوءِ"],"grade":"صحيح","muhaddith":"صحيح أو حسن","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"D4BOOjCz"},{"id":"س-01843","fp":"42f0dda476d9","stateId":230,"easy":"إذا صمت يوماً وأفطرت يوماً ← فهو أحب الصيام إلى الله","cause":"صيامِ داوُدَ، صُمْ يومًا وأفطِرْ يومًا","result":"أحبَّ الصِّيامِ إلى اللهِ","explicit":true,"star":true,"otherNeedIds":[47],"ref":"تخريج المسند لشعيب 7023","srcLabel":"متفق عليه","text":["يا عبدَ اللهِ بنَ عَمرٍو، في كم تقرَأُ القرآنَ؟ قال: قُلْتُ: في يَومي ولَيلتي، قال: فقال لي: ارقُدْ وصَلِّ، وصَلِّ وارقُدْ، واقرَأْه في كلِّ شهرٍ، قال: فما زِلْتُ أُناقِصُه ويُناقِصُني، إلى أنْ قال: اقرَأْه في كلِّ سَبعِ لَيالٍ، -قال أبي: ولم أفهَمْ، وسقَطَتْ علَيَّ كَلمةٌ- قال: ثُمَّ قال: قُلْتُ: إنِّي أصومُ ولا أُفطِرُ؟ قال: فقال لي: صُمْ وأفطِرْ، وصُمْ ثلاثةَ أيَّامٍ مِن كلِّ شهرٍ، فما زِلْتُ أُناقِصُه ويُناقِصُني، حتى قال: صُمْ ",["أحبَّ الصِّيامِ إلى اللهِ",2]," عزَّ وجلَّ، ",["صيامِ داوُدَ، صُمْ يومًا وأفطِرْ يومًا",1],"، فقال عبدُ اللهِ بنُ عَمرٍو: لَأنْ أكونَ قبِلْتُ رُخصةَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أحبُّ إليَّ مِن أنْ يكونَ لي حُمرُ النَّعَمِ. -حسِبْتُه شَكَّ عَبيدةُ-."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1978)، ومسلم (1159)، وأبو داود (1389) مختصراً، وأحمد (7023) واللفظ له","bab":"إحسان › الأخذ بالرخصة","dorar":"h2Drcdeq","merged":6,"otherRefs":["صحيح البخاري 3420 (صحيح)","نخب الافكار 8/471 (صحيح)","تخريج مشكل الآثار 1253 (صحيح)","تخريج مشكل الآثار 5890 (صحيح)","تخريج مشكل الآثار 1254 (صحيح)"]},{"id":"س-03951","fp":"15d605b147fa","stateId":230,"easy":"إذا صمت ← فرائحة فمك أطيب عند الله من المسك","cause":"رِيحُ فَمِ الصَّائمِ","result":"أطيبُ عندي مِن رِيحِ المِسْكِ","explicit":true,"ref":"إتحاف الخيرة المهرة 6/234","srcLabel":"النسائي","text":["سألْتُ عبدَ اللهِ بنَ عبَّاسٍ رضِيَ اللهُ عنهما عن قولِ اللهِ عَزَّ وجَلَّ لموسى صَلَّى اللهُ عليه وسلَّمَ: {وَفَتَنَّاكَ فُتُونًا} [طه: 40]، فسألْتُه عن الفُتونِ؟ فقال: استأنِفِ النَّهارَ يا ابنَ جُبيرٍ؛ فإنَّ لها حديثًا طويلًا.\nقال: فغدوْتُ على ابنِ عبَّاسٍ لأنتجِزَ ما وَعَدني مِن حديثِ الفُتونِ، فقال: تذاكَرَ فِرعونُ وجُلساؤُه ما كان اللهُ عَزَّ وجَلَّ وعَدَ إبراهيمَ صَلَّى اللهُ عليه وسلَّمَ مِن أنْ يجعَلَ في ذُرِّيتَه أنبياءَ ومُلوكًا؛ فقال بعضُهم: إنَّ بني إسرائيلَ لينتظِرونَ ذلك ما يشُكُّون فيه، وقد كانوا يظنُّونَ أنَّه يُوسفُ بنُ يعقوبَ عليهما الصَّلاةُ والسَّلامُ، فلمَّا هلَكَ قالوا: ليس هكذا كان، إنَّ اللهَ عَزَّ وجَلَّ وعَدَ إبراهيمَ صَلَّى اللهُ عليه وسلَّمَ. قال فِرعونُ: فكيف تَرَونَ؟ فائْتَمَروا، واجتمَعوا أمْرَهم على أنْ يبعَثَ رِجالًا بالشِّفارِ، يَطُوفون في بني إسرائيلَ، فلا يَجِدون مولودًا ذكَرًا إلَّا ذَبَحوه، ففَعَلوا ذلك، فلمَّا أنْ رَأَوا أنَّ الكبارَ في بني إسرائيلَ يموتونَ بآجالِهم، والصِّغارَ يُذْبَحونَ، قالوا: أتوشِكونَ أنْ تُفْنوا بني إسرائيلَ، فتَصيروا إلى أنْ تُباشِروا مِن الأعمالِ والخدمةِ الَّتي كانوا يَكْفُونكم؟ فاقْتُلوا عامًا كلَّ مولودٍ ذكرٍ، فيقِلَّ نَباتُهم، ودَعُوا عامًا، فلا تَقْتلوا منهم أحدًا، فيشِبَّ الصِّغارُ مكانَ مَن يموتُ مِن الكبارِ، فإنَّهم لنْ يَكْثروا بمَن تَسْتحيون، فتخافوا مُكاثرتَهم إياكم، ولنْ يَفْنَوا بمَن تقتُلونَ، فتحتاجونَ إليهم، فأجْمَعوا أمْرَهم على ذلك، فحمَلَت أُمُّ موسى بهارونَ عليهما السَّلامُ العامَ الَّذي لا يُذْبَحُ فيه الغِلمانُ، فولدَتْه عَلانيةً، فلمَّا كان مِن قابلٍ حمَلَتْ بمُوسى عليه السَّلامُ، فوقَعَ في قلْبِها مِن الهَمِّ والحزنِ. فذلك مِن الفُتونِ يا ابنَ جُبيرٍ، ما دخَلَ عليه في دهو بَطْنِ أُمِّه ممَّا يُرادُ به، فأوحَى اللهُ تعالى إليها: {وَلَا تَخَافِي وَلَا تَحْزَنِي إِنَّا رَادُّوهُ إِلَيْكِ وَجَاعِلُوهُ مِنَ الْمُرْسَلِينَ} [القصص: 7]، وأمَرَها أنْ إذا ولَدَتْ أنْ تجعَلَه في تابوتٍ، ثمَّ تُلْقِيه في اليمِّ، فلمَّا ولَدَت فعَلَت ذلك به، فألْقَته في اليمِّ، فلمَّا توارى عنها ابنُها أتاها الشَّيطانُ، فقالت في نفْسِها: ما فعَلْتُ بابني؟! لو ذُبِحَ لبِثَ عندي فرأيْتُه وكفَّنْتُه، كان أحَبَّ إليَّ مِن أنْ أُلْقِيَه بيدي إلى دوابِّ البحرِ وحِيتانِه، وانتهى الماءُ به حتَّى أرفَأَ به عند فُرْضَةُ مُسْتَقى جواري امرأةِ فِرعونَ، فلمَّا رأيْنَه أخذْنَه، فهمَمْنَ أنْ يفتحْنَ التَّابوتَ، فقالت بعضُهنَّ: إنَّ في هذا مالًا، وإنَّا إنْ فتحْناه لم تُصدِّقْنا امرأةُ الملِكِ بما وجَدْنا فيه، فحمَلْنَه بهيئةٍ لم يُحرِّكْنَ منه شيئًا، دفعْنَه إليها، فلمَّا فتحَتْه رأتْ فيه غُلامًا، فأُلْقِيَ عليه منها محبَّةٌ لم تُلْقَ مثْلُها على البشَرِ قطُّ، وأصبَحَ فُؤَادُ أُمِّ موسى فارغًا مِن ذِكْرِ كلِّ شَيءٍ إلَّا مِن ذِكْرِ مُوسى عليه السَّلامُ، فلمَّا سمِعَ الذَّابِحونَ بأمْرِه أقبلوا بشِفارِهم إلى امرأةِ فرعونَ ليذبَحُوه -وذلك مِن الفُتونِ يا ابنَ جُبيرٍ- فقالت للذَّبَّاحينَ: أقِرُّوه؛ فإنَّ هذا الواحدَ لا يَزيدُ في بني إسرائيلَ حتَّى آتِيَ فِرعونَ فأسْتَوْهِبَه منه، فإنْ وهَبَه لي كنْتُم قد أحسنْتُم وأجمَلْتُم، وإنْ أمَرَ بذبْحِه لم أَلُمْكم، فأتَتْ به فرعونَ، فقالت: قُرَّةُ عينٍ لي ولك، قال فِرعونُ: يكونُ لك، فأمَّا لي فلا حاجةَ لي في ذلك. قال رسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ: والَّذي أحلِفُ به، لو أقَرَّ فِرعونُ بأنْ يكونَ له قُرَّةَ عينٍ كما أقَرَّت امرأتُه، لهداهُ اللهُ به كما هدى به امرأتَه، ولكنَّ اللهَ حرَمَه ذلك.\nفأرسَلَتْ إلى مَن حولَها، مِن كلِّ امرأةٍ لها لبنٌ، تختارُ لها ظِئرًا، فجعَلَ كلَّما أخذَتْه امرأةٌ منهنَّ، فترُضِعُه، لم يَقْبَلْ ثَدْيَها، حتَّى أشفَقَت عليه امرأةُ فِرعونَ أنْ يَمتنِعَ مِن اللَّبنِ فيموتَ، فأحْزَنَها ذلك، فأمرَتْ به، فأُخْرِجَ إلى السُّوقِ وتجمَّعَ النَّاسُ، تَرْجو أنْ تجِدَ له ظِئرًا يأخُذُ منها، فلم يَقْبَلْ، وأصبَحَتْ أُمُّ موسى والهةً، فقالت لأُخْتِه: قُصِّيه -يعني: أثَرَهُ- واطْلُبِيه، هل تسمعينَ له ذِكْرًا؟ أحيٌّ ابْني أمْ قد أكلَتْه الدَّوابُّ؟ ونسِيَت ما كان اللهُ عَزَّ وجَلَّ وعَدَها فيه، فبَصُرتْ به أختُه عن جُنُبٍ وهم لا يَشعُرونَ، والجُنُبُ: أنْ يبصِرَ الإنسانُ إلى الشَّيءِ البعيدِ وهو إلى جَنْبِه لا يشعُرُ به، فقالت مِن الفرحِ حين أعياهم الظُّؤارتُ: أنا {أَدُلُّكُمْ عَلَى أَهْلِ بَيْتٍ يَكْفُلُونَهُ لَكُمْ وَهُمْ لَهُ نَاصِحُونَ} [القصص: 12]، فأخَذُوها فقالوا: ما يُدريك ما نُصْحُهم له؟ هل يعرِفونَه؟ حتَّى شكُّوا في ذلك -فذلك مِن الفُتونِ يا ابنَ جُبيرٍ- فقالت: نصيحَتُهم له وشفقَتُهم عليه رغبةً في صِهر الـمَلِك، ورجاءَ مَنفعتِه، فأرْسَلوها، فانطلَقَتْ إلى أُمِّها فأخبرتْها الخبرَ، فجاءتْ أُمُّه، فلمَّا وضعَتْه في حِجْرِها، نزَا إلى ثَدْيِها، فمَصَّه حتَّى امتلَأَ جَنباهُ رِيًّا، وانطلَقَ البشيرُ إلى امرأةِ فرعونَ: أنْ قد وجَدْنا لابْنِك، فأرسَلَتْ إليها، فأُوتِيتْ بها وبه، فلمَّا رأت ما يصنَعُ، قالت لها: امْكُثي عندي؛ تُرْضِعي ابني هذا، فإنِّي لم أحجِبْه شيئًا قطُّ، فقالت أُمُّ مُوسى: لا أستطيعُ أنْ أدَعَ بيتي وولدي، فيَضيعَ، فإنْ طابتْ نفْسُك أنْ تُعْطِيَنه، فأذهَبَ به إلى مَنْزلي، فيكونَ معي لا آلوهُ خيرًا، فعلْتُ، وإلَّا فإنِّي غيرُ تاركةٍ بيتي وولدي، وذكَرَت أُمُّ مُوسى عليه السَّلامُ ما كان اللهُ عَزَّ وجَلَّ وعَدَها، فتعاسَرَت على امرأةِ فرعونَ، وأيقنَتْ بأنَّ اللهَ عَزَّ وجَلَّ يُنْجِزُ موعودَه، فرجَعَتْ إلى بيتِها بابنِها مِن يومِها، فأنبَتَه اللهُ نباتًا حسنًا، وحفِظَه لِمَا قد قَضى فيه، فلم يزَلْ بنو إسرائيلَ وهم في ناحيةِ القريةِ مُمْتنعينَ يَمْتنعونَ به مِن السُّخرةِ ما كان فيهم.\nفلمَّا تَرعرَعَ قالت امرأةُ فرعونَ لأُمِّ مُوسى: أريدُ أنْ تُرِيني ابني، فوعَدَتْها يومًا تُرِيها فيه إيَّاه، فقالتِ امرأةُ فِرعونَ لخُزَّانِها، وظُؤورتِها، وقَهارِمَتِها: لا يَبْقينَّ أحدٌ منكم إلَّا استقبَلَ ابني اليومَ بهَديَّةٍ وكَرامةٍ؛ لِأَرى ذلك فيه، وأنا باعثةٌ أمينًا يُحْصِي ما يصنَعُ كلُّ إنسانٍ منكم، فلم تَزَلِ الهدايا والكرامةُ والنِّحلةُ، تَستقبِلُه مِن حينِ خرَجَ مِن بيتِ أُمِّه إلى أنْ دخَلَ على امرأةِ فرعونَ، فلمَّا دخَلَ عليها بجَّلَتْه، وأكرمَتْه، وفرِحَت به، وأعجَبَها، ونحَلَت أُمَّه؛ لحُسْنِ أثَرِه، ثمَّ قالت: لآتيَنَّ به فِرعونَ، فليَنْحَلَنَّه، وليُكْرِمَنَّه، فلمَّا دخَلَتْ به عليه، جعَلَه في حِجْرِه، فتناوَلَ مُوسى لِحيةَ فرعونَ، فمَدَّها إلى الأرضِ، فقال الغواةُ مِن أعداءِ اللهِ لفرعونَ: ألَا ترى إلى ما وعَدَ اللهُ عَزَّ وجَلَّ إبراهيمَ نَبِيَّه عليه السَّلامُ أنَّه يرِثُك، ويَعْلوك، ويصرَعُك، فأرسَلَ إلى الذَّبَّاحينَ، وذلك مِن الفُتونِ يا ابنَ جُبيرٍ، بعدَ كلِّ بلاءٍ ابتُلِيَ به، أو أُرِيدَ به فُتونًا.\nفجاءت امرأةُ فِرعونَ تَسْعى إلى فرعونَ، فقالت: ما بدا لك في هذا الغلامِ الَّذي وهَبْتَه لي؟ قال: ألَا تَرَيْنَه يزعُمُ أنَّه يصرَعُني ويَعْلوني؟ قالت: اجْعَلْ بيني وبينك أمرًا تعرِفُ فيه الحقَّ؛ ائْتِ بجَمْرتينِ ولُؤلؤتَينِ، فقَرِّبْهما إليه، فإنْ بطَش باللُّؤلؤتَينِ واجتنَبَ الجَمْرتينِ، عرَفْتَ أنَّه يعقِلُ، وإنْ تَناوَلَ الجَمْرتَينِ ولم يُرِدِ اللُّؤلؤتَينِ، علِمْتَ أنَّ أحدًا لا يُؤثِرُ الجَمرتينِ على اللُّؤلؤتينَ وهو يعقِلُ، فقُرِّبَ ذلك إليه، فتناوَلَ الجَمرتَينِ، فانْتَزَعوهما مِن يَدِه، وخافت أنْ يحرِقَا يدَيْه، فقالت المرأةُ: ألَا ترى؟! فصرَفَه اللهُ عنه بعدما كان قد هَمَّ به، وكان الله عَزَّ وجَلَّ بالغًا فيه أمْرَه.\nفلمَّا بلَغَ أشُدَّه وصار مِن الرِّجالِ، لم يكُنْ أحدٌ مِن آلِ فِرعونَ يخلُصُ إلى أحدٍ مِن بني إسرائيلَ معه بظُلمٍ، ولا يخرُجُ حتَّى امْتَنعوا كلَّ الامتناعِ.\nفبينما مُوسى عليه السَّلامُ يَمْشي في ناحيةِ المدينةِ، إذ هو برجُلينِ يَقْتتلانِ؛ أحدُهما فرعونيٌّ، والآخرُ إسرائيليٌّ، فاستغاثَه الإسرائيليُّ على الفرعونيِّ، فغضِبَ مُوسى عليه السَّلامُ غضبًا شديدًا؛ لأنَّه تناوَلَ وهو يعلَمُ منزلةَ مُوسى عليه السَّلامُ مِن بَني إسرائيلَ، وحِفْظَه لهم، لا يعلَمُ النَّاسُ إلَّا إنَّما ذلك مِن الرَّضاعِ إلَّا أُمُّ مُوسى، إلَّا أنْ يكونَ اللهُ عَزَّ وجَلَّ أَطْلَعَ مُوسى عليه السَّلامُ مِن ذلك على ما لم يُطْلِعْ عليه غيرَه. فوكَزَ مُوسى عليه السَّلامُ الفرعونيَّ، فقتَلَه، وليس يراهما أحدٌ إلَّا اللهُ عَزَّ وجَلَّ، فقال مُوسى عليه السَّلامُ حين قتَلَ الرَّجلَ: هذا مِن عمَلِ الشَّيطانِ؛ إنَّه عدُوٌّ مُضِلٌّ مُبينٌ، ثمَّ قال: {رَبِّ إِنِّي ظَلَمْتُ}، إلى قولِه: {إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ} [القصص: 16].\n{فَأَصْبَحَ فِي الْمَدِينَةِ خَائِفًا يَتَرَقَّبُ} [القصص: 18] الأخبارَ، فأُتِيَ فِرعونُ فقيلَ: إنَّ بني إسرائيلَ قد قتَلَتْ رجُلًا مِن آلِ فرعونَ، فخُذْ لنا بحَقِّنا، ولا تُرخِّصْ لهم، فقال: ابْغُوني قاتِلَه ومَن شهِدَ عليه؛ فإنَّ الملِكَ وإنْ كان صَفْوُه مع قومِه، لا يستقيمُ له أنْ يُقِيدَ بغيرِ بيِّنةٍ، ولا ثَبَتٍ، فانْظُروا في عِلْمِ ذلك آخُذْ لكم بحَقِّكم، فبينا هم يَطوفونَ لا يَجِدونَ شيئًا، إذا موسى عليه السَّلامُ قد رأى في الغدِ ذلك الإسرائيليَّ يقتُلُ رجُلًا مِن آلِ فرعونَ آخرَ، فاستغاثَه الإسرائيليُّ على الفرعونيِّ، فصادَفَ مُوسى عليه السَّلامُ قد ندِمَ على ما كان منه، فكَرِهَ الَّذي رأى، فغضِبَ الإسرائيليُّ وهو يُريدُ أنْ يبطِشَ بالفرعونيِّ، فقال للإسرائيليِّ -لِمَا فعَلَ أمسِ واليومَ-: {إِنَّكَ لَغَوِيٌّ مُبِينٌ} [القصص: 18]. فنظَرَ الإسرائيليُّ إلى مُوسى عليه السَّلامُ بعدما قال له ما قال، فإذا هو غضبانُ كغضَبِه بالأمسِ الَّذي قتَلَ به الفرعونيَّ، فخاف أنْ يكونَ بعدما قال له: {إِنَّكَ لَغَوِيٌّ مُبِينٌ} إيَّاه أراد، ولم يكُنْ أراده، إنَّما أراد الفرعونيَّ، فخاف الإسرائيليُّ، فحاجَزَ الفرعونيَّ، فقال: {يَا مُوسَى أَتُرِيدُ أَنْ تَقْتُلَنِي كَمَا قَتَلْتَ نَفْسًا بِالْأَمْسِ} [القصص: 19]؟ وإنَّما قال ذلك؛ مخافةَ أنْ يكون إيَّاهُ أراد مُوسى عليه السَّلامُ أنْ يقتُلَه، فتنازَعَا. فانطلَقَ الفرعونيُّ إلى قومِه، فأخبَرَهم بما سمِعَ مِن الإسرائيليِّ مِن الخبرِ حين يقولُ: {أَتُرِيدُ أَنْ تَقْتُلَنِي كَمَا قَتَلْتَ نَفْسًا بِالْأَمْسِ} [القصص: 19]، فأرسَلَ فرعونُ الذَّبَّاحينَ ليقتُلوا موسى عليه السَّلامُ، فأخَذَ رُسلُ فرعونَ الطَّريقَ الأعظمَ يَمْشون على هَيئتِهم يطلُبونَ مُوسى عليه السَّلامُ، وهم لا يخافونَ أنْ يفوتَهم، فجاء رجُلٌ مِن شِيعَةِ مُوسى عليه السَّلامُ مِن أَقْصى المدينةِ، فاختصَرَ طريقًا قريبًا حتَّى سبَقَهم إلى موسى عليه السَّلامُ فأخْبَرَه. فذلك مِن الفُتونِ يا ابنَ جُبيرٍ.\nفخرَجَ مُوسى عليه السَّلامُ مُتوجِّهًا نحوَ مدينَ لم يلْقَ بلاءً قبلَ ذلك، وليس له علمٌ بالطَّريقِ إلَّا حُسْنَ الظَّنِّ بربِّه عَزَّ وجَلَّ، فإنَّه قال: {عَسَى رَبِّي أَنْ يَهْدِيَنِي سَوَاءَ السَّبِيلِ} [القصص: 22].\n{وَلَمَّا وَرَدَ مَاءَ مَدْيَنَ وَجَدَ عَلَيْهِ أُمَّةً مِنَ النَّاسِ يَسْقُونَ} إلى {تَذُودَانِ} [القصص: 23]، يعني بذلك: حابستَينِ غنَمَهما، فقال لهما: ما خطْبُكما مُعتزلتَينِ لا تَسْقيانِ مع النَّاسِ؟ قالتا: ليس لنا قُوَّةٌ نُزاحِمُ القومَ، وإنَّما ننتظِرُ فُضولَ حياضِهم، فسقى لهما، فجعَلَ يغرِفُ بالدَّلْوِ ماءً كثيرًا، حتَّى كانتا أوَّلَ الرِّعاءِ فراغًا، فانصرَفَتا بغنَمِهما إلى أبيهما، وانصرَفَ موسى عليه السَّلامُ، فاستظَلَّ بشجرةٍ، وقال: {رَبِّ إِنِّي لِمَا أَنْزَلْتَ إِلَيَّ مِنْ خَيْرٍ فَقِيرٌ} [القصص: 24]، فاستنكَرَ أبوهما سُرعةَ صُدورِهما بغنَمِهما حُفَّلًا بطانًا، فقال: إنَّ لكما اليومَ لشأنًا، فأخبَرَتَاه بما صنَعَ موسى عليه السَّلامُ، فأمَرَ إحداهما أنْ تَدْعُوَه له، فأتَتْ موسى عليه السَّلامُ فدَعَتْه، فلمَّا كلَّمَه قال: {لَا تَخَفْ نَجَوْتَ مِنَ الْقَوْمِ الظَّالِمِينَ} [القصص: 25]، ليس لفِرعونَ ولا لقومِه علينا سُلطانٌ، ولسْنا في مَمْلكتِه.\nقال: فقالت إحداهما: {يَا أَبَتِ اسْتَأْجِرْهُ إِنَّ خَيْرَ مَنِ اسْتَأْجَرْتَ الْقَوِيُّ الْأَمِينُ} [القصص: 26]، فاحتمَلَتْه الغَيرةُ على أنْ قال: وما يُدريكِ ما قُوَّتُه؟ وما أمانَتُه؟ قالت: أمَّا قُوَّتُه: فما رأيْتُ في الدَّلوِ حين سَقى لنا، لم أرَ رجُلًا قطُّ في ذلك المَسْقى أقوى منه، وأمَّا أمانَتُه: فإنَّه نظَرَ إليَّ حين أقبلْتُ إليه وشَخَصْتُ له، فلمَّا علِمَ إنِّي امرأةٌ، صوَّبَ رأْسَه لم يرفَعْه، ولم ينظُرْ إليَّ حتَّى بلَّغْتُه رِسالتَك، ثمَّ قال لي: امشِي خلفي، وانْعَتي لي الطَّريقَ، لم يفعَلْ هذا إلَّا وهو أمينٌ، فسُرِّيَ عن أبيها وصدَّقَها، وظَنَّ به الَّذي قالت له.\nفقال له: هل لك {أَنْ أُنْكِحَكَ إِحْدَى ابْنَتَيَّ هَاتَيْنِ}، إلى قوله: {مِنَ الصَّالِحِينَ} [القصص: 27]، ففعَلَ، فكانت على نَبِيِّ اللهِ موسى عليه السَّلامُ ثمانيَ سنينَ واجبةً، وكانت سنتانِ عِدَةً منه، فقَضَى اللهُ عَزَّ وجَلَّ عنه عِدَتَه فأتمَّها عشْرًا.\nقال سَعيدٌ: فلَقِيَني رجُلٌ مِن أهلِ النَّصرانيَّةِ مِن عُلمائِهم، فقال: هلْ تَدْري أيَّ الأجلينِ قضى مُوسى عليه السَّلامُ؟ قلْتُ: لا، وأنا يومئذٍ لا أدري، فلقِيتُ ابنَ عبَّاسٍ، فذكَرْتُ ذلك له، فقال: أمَا علِمْتَ أنَّ ثمانيًا كانت على نبيِّ اللهِ عليه السَّلامُ واجبةً، لم يكُنْ نبيُّ اللهِ ليَنْقُصَ منها شيئًا، وتعلَمُ أنَّ اللهَ عَزَّ وجَلَّ كان قاضيًا عن مُوسى عليه السَّلامُ عِدَتَه الَّتي وعَدَ، فإنَّه قضى عشْرَ سنينَ. فلقِيتُ النَّصرانيَّ، فأخبَرْتُه بذلك، فقال: الَّذي سألْتَه فأخبَرَك أعلَمُ منك بذلك؟ قلْتُ: أجلْ، وأَولى.\nفلمَّا سار مُوسى عليه السَّلامُ بأهلِه كان مِن أمْرِ النَّارِ ما قَصَّ اللهُ عليك في القُرآنِ، وأمْرِ العصا ويَدِه، فشكا إلى ربِّه عَزَّ وجَلَّ ما يتخوَّفُ مِن آلِ فرعونَ في القتيلِ، وعُقدةَ لسانِه، فآتاهُ اللهُ عَزَّ وجَلَّ سُؤْلَه، وحَلَّ عُقدةً مِن لسانِه، وأوحى اللهُ عَزَّ وجَلَّ إلى هارونَ عليه السَّلامُ، وأمَرَه أنْ يلقاهُ، واندفَعَ مُوسى عليه السَّلامُ بعصاهُ، حتَّى لقِيَ هارونَ عليه السَّلامُ، وانطلَقَا جميعًا إلى فرعونَ، فأقاما حِينًا على بابِه لا يُؤْذَنُ لهما، فقالا: إنَّا رسولَا ربِّك، قال: فمَن ربُّكما يا موسى؟ فأخبراهُ بالَّذي قَصَّ اللهُ عَزَّ وجَلَّ عليك في القُرآنِ، قال: فما تُريدانِ؟ وذكَّرَه القتيلَ، واعتذَرَ بما قد سمِعْتَ، وقال: أريدُ أنْ تُؤمِنَ باللهِ، وأنْ تُرْسِلَ معي بني إسرائيلَ، فأبى عليه، وقال: ائتِ بآيةٍ إنْ كنْتَ مِن الصَّادقينَ، فألقى عصاه فإذا هي حيَّةٌ عظيمةٌ، فازعةٌ، فاغرةٌ فاها، مُسرعةٌ إلى فرعونَ، فلمَّا رآها فِرعونُ قاصدةً إليه خافها، فاقتحَمَ عن سَريرِه، واستغاثَ بمُوسى عليه السَّلامُ أنْ يكُفَّها عنه، ففعَلَ، ثمَّ أخرَجَ يَدَه مِن جَيْبِه، فرآها بيضاءَ مِن غيرِ سُوءٍ، يعني: مِن غيرِ برَصٍ، فرَدَّها، فعادت إلى لونِها الأوَّلِ.\nفاستشارَ الملَأَ حولَه فيما رأى، فقالوا له: {هَذَانِ لَسَاحِرَانِ يُرِيدَانِ أَنْ يُخْرِجَاكُمْ مِنْ أَرْضِكُمْ} [طه: 63] الآيةَ، والمُثْلى: مُلْكُهم الَّذي هم فيه والعيشُ. فأَبَوا على مُوسى عليه السَّلامُ أنْ يُعْطُوه شيئًا ممَّا طلَبَ، وقالوا له: اجمَعْ لهما السَّحرةَ؛ فإنَّهم بأرضِك كثيرٌ، حتَّى نغلِبَ سِحْرَهما، وأرسَلَ في المدائنِ، فحُشِرَ له كلُّ ساحرٍ مُتعالمٍ، فلمَّا أَتَوا على فرعونَ، قالوا: ما يعمَلُ هذا السَّاحرُ؟ قالوا: يعمَلُ الحيَّاتِ، قالوا: فلا واللهِ ما أحدٌ في الأرضِ يعمَلُ السِّحرَ والحيَّاتِ والحبالَ والعِصِيَّ الَّذي نعمَلُ، فما أجْرُنا إنْ نحن غلَبْنا؟ قال لهم: أنتم أقاربي وخاصَّتي، وأنا صانعٌ إليكم كلَّ شَيءٍ أحببتم، فتَواعَدوا يومَ الزِّينةِ وأنْ يُحْشَرَ النَّاسُ ضُحًى.\nقال سعيدٌ: فحدَّثني ابنُ عبَّاسٍ: أنَّ يومَ الزِّينةِ اليومُ الَّذي أظهَرَ اللهُ عَزَّ وجَلَّ فيه مُوسى عليه السَّلامُ على فِرعونَ والسَّحرةِ هو يومُ عاشوراءَ.\nفلمَّا اجتمعوا في صَعيدٍ، قال النَّاسُ بعضُهم لبعضٍ: انطَلِقوا، فنتخبَّرْ هذا الأمْرَ، {لَعَلَّنَا نَتَّبِعُ السَّحَرَةَ إِنْ كَانُوا هُمُ الْغَالِبِينَ} [الشعراء: 40]، يعنون مُوسى وهارونَ عليهما السَّلامُ؛ استهزاءً بهما، فقالوا: يا موسى -لِقُدْرتِهم في أنفُسِهم بسِحْرِهم- إمَّا أنْ تُلْقِيَ، وإمَّا أنْ نكونَ نحن المُلْقينَ، قال: بل ألْقُوا. {فَأَلْقَوْا حِبَالَهُمْ وَعِصِيَّهُمْ وَقَالُوا بِعِزَّةِ فِرْعَوْنَ إِنَّا لَنَحْنُ الْغَالِبُونَ} [الشعراء: 44]، فرأى مُوسى عليه السَّلامُ مِن سِحْرِهم ما أوجَسَ في نفْسِه خِيفةً، فأوحى اللهُ عَزَّ وجَلَّ إليه: أنْ ألْقِ عصاك، فلمَّا ألقاها، صارت ثُعبانًا عظيمًا فاغرةً فاها، فجُعِلَتِ العِصِيُّ بدَعوةِ مُوسي عليه السَّلامُ تلتبِسُ بالحبالِ، حتَّى صارتْ جُرُزًا إلى الثُّعبانِ تَدخُل فيه، حتَّى ما أبقَتْ عصًا ولا حبلًا إلَّا ابتلعَتْه. فلمَّا عرَفَ السَّحرةُ ذلك، قالوا: لو كان هذا سِحرٌ لم يَبلُغْ مِن سِحرِنا كلَّ هذا، ولكنَّه أمْرٌ مِن اللهِ، آمنَّا باللهِ ربِّنا وما جاء به مُوسى عليه السَّلامُ، ونتوبُ إلى اللهِ عَزَّ وجَلَّ ممَّا كنَّا عليه. وكسَرَ اللهُ ظهْرَ فِرعونَ في ذلك الموطنِ وأشياعِه، وأظهَرَ الحقَّ، وبطَلَ ما كانوا يعمَلونَ، فغُلِبوا هنالك وانقَلَبوا صاغِرينَ. وامرأةُ فِرعونَ بارزةٌ مُتبذِّلَةٌ تَدْعو بالنَّصرِ لمُوسى عليه السَّلامُ على فِرعونَ، فمَن رآها مِن آلِ فرعونَ ظَنَّ أنَّها إنَّما تبذَّلَتْ للشفقةِ على فِرعونَ وأشياعِه، وإنَّما كان حُزْنُها وهمُّها لمُوسى عليه السَّلامُ. فلمَّا طال مُكْثُ مُوسى عليه السَّلامُ لمواعيدِ فِرعونَ الكاذبةِ، كلَّما جاءه بآيةٍ وعَدَه عندها أنْ يُرْسِلَ معه بني إسرائيلَ، فإذا مضَتْ أخلَفَ موعِدَه، وقال: هل يستطيعُ ربُّك أنْ يصنَعَ غيرَ هذا؟ فأرسَلَ اللهُ عليه وعلى قومِه الطُّوفانَ، والجرادَ، والقُمَّلَ، والضَّفادعَ، آياتٍ مُفصَّلاتٍ، كلُّ ذلك يَشْكو إلى موسى عليه السَّلامُ، ويطلُبُ إليه أنْ يكُفَّها عنه، ويُواثِقُه على أنْ يُرسِلَ معه بني إسرائيلَ، فإذا كَفَّ ذلك عنه، أخلَفَ موعِدَه ونكَثَ عهدَه. فأُمِرَ موسى عليه السَّلامُ بالخُروجِ بقومِه، فخرَجَ بهم ليلًا، فلمَّا أصبَحَ فرعونُ ورأى أنَّهم قد مَضَوا، أرسَلَ في المدائنِ حاشرينَ، فتبِعَهم بجُنودٍ عظيمةٍ كثيرةٍ، وأوحى اللهُ عَزَّ وجَلَّ إلى البحرِ: أنْ إذا ضرَبَك مُوسى بعصاهُ، فانفرِقْ له اثنتَيْ عشْرةَ فِرقةً، حتَّى يجوزَ موسى عليه السَّلامُ ومَن معه، ثمَّ الْتَئَمَ على مَن بقِيَ بعدُ مِن فرعونَ وأشياعِه، فنسِيَ مُوسى عليه السَّلامُ أنْ يضرِبَ البحرَ بالعصا، فانْتَهى إلى البحرِ وله قصيفٌ؛ مخافةَ أنْ يَضرِبَه موسى عليه السَّلامُ، وهو غافِلٌ، فيصيرَ عاصيًا اللهَ عَزَّ وجَلَّ. فلمَّا تراءى الجَمْعانِ وتقارَبَا، قال أصحابُ موسى: إنَّا لمُدْرَكونَ، افعَلْ ما أمرَكَ به ربُّك عَزَّ وجَلَّ؛ فإنَّك لم تكذِبْ ولم تُكْذَبْ، فقال: وعَدَني ربِّي عَزَّ وجَلَّ إذا أتيْتُ البحرَ، انفرَقَ لي اثنتيْ عشْرةَ فِرقةً حتَّى أُجاوزَه، ثمَّ ذكَرَ بعدَ ذلك العصا، فضرَبَ البحرَ بعصاه حين دنا أوائلُ جُندِ فرعونَ مِن أواخرِ جُندِ مُوسى عليه السَّلامُ، فانفرَقَ البحرُ كما أمَرَه اللهُ عَزَّ وجَلَّ، وكما وُعِدَ مُوسى عليه السَّلامُ، فلمَّا أنْ جاوَزَ موسى عليه السَّلامُ وأصحابُه البحرَ، ودخَلَ فِرعونُ وأصحابُه، الْتَقى عليهم البحرُ كما أُمِرَ. فلمَّا جاوَزَ مُوسى عليه السَّلامُ البحرَ، قال أصحابُه: إنَّا نخافُ ألَّا يكونَ فِرعونُ قد غرِقَ، فلا نُؤمِنُ بهلاكِه، فدعا ربَّه عَزَّ وجَلَّ، فأخرَجَه له ببدنه حتَّى استيْقَنوا بهلاكِه.\nثمَّ مَرُّوا بعدَ ذلك {عَلَى قَوْمٍ يَعْكُفُونَ عَلَى أَصْنَامٍ لَهُمْ قَالُوا يَا مُوسَى اجْعَلْ لَنَا إِلَهًا كَمَا لَهُمْ آلِهَةٌ} [الأعراف: 138]، إلى {وَبَاطِلٌ مَا كَانُوا يَعْمَلُونَ} [الأعراف: 139]، قد رأيتُمْ مِن العِبَرِ، وسمِعْتُم ما يَكْفيكم، ومَضَى. فأنزَلَهم مُوسى عليه السَّلامُ منزلًا، ثمَّ قال لهم: أطيعوا هارونَ عليه السَّلامُ؛ فإنِّي قد استخلفْتُه عليكم، وإنِّي ذاهبٌ إلى ربِّي عَزَّ وجَلَّ، وأجَّلَهم ثلاثينَ يومًا أنْ يَرجِعَ إليهم فيها، فلمَّا أتى ربَّه وأراد أنْ يُكلِّمَه ثلاثينَ يومًا، وقد صامهنَّ: ليلَهنَّ ونهارَهنَّ، وكرِهَ أنْ يُكلِّمَ ربَّه عَزَّ وجَلَّ ورِيحُ فَمِه ",["رِيحُ فَمِ الصَّائمِ",1],"، فتناوَلَ مُوسى عليه السَّلامُ مِن نباتِ الأرضِ شيئًا فمضَغَه، فقال له ربُّه عَزَّ وجَلَّ حين لقاه: لِمَ أفطرْتَ؟ -وهو أعلَمُ بالَّذي كان- قال: يا ربِّ، إنِّي كرِهْتُ أنْ أُكلِّمَك إلَّا وفَمِي طيِّبُ الرِّيحِ، قال: أوما علِمْتَ يا مُوسى أنْ رِيحَ فَمِ الصَّائمِ ",["أطيبُ عندي مِن رِيحِ المِسْكِ",2],"؟ ارجِعْ حتَّى تصومَ عشْرًا ثمَّ ائْتِني، ففعَلَ مُوسى عليه السَّلامُ ما أُمِرَ به.\nفلمَّا رأى قومُ مُوسى عليه السَّلامُ أنَّه لم يرجِعْ إليهم للأجَلِ ساءَهم ذلك، وكان هارونُ عليه السَّلامُ قد خطَبَهم، فقال لهم: خرجْتُم مِن مِصْرَ ولقومِ فرعونَ عندي عواري وودائعُ، ولكم فيهم مثلُ ذلك، وأنا أرى أنْ تحتَسِبوا ما لكم عندهم، ولا أحلَّ لكم وديعةً اسْتُودِعْتُمُوها، ولا عاريَّةً، ولسنا برادِّين إليهم شيئًا مِن ذلك، ولا مُمْسِكيه لأنفُسِنا، فحفَرَ حفيرًا، وأمَرَ كلَّ قومٍ عليهم شَيءٌ مِن ذلك؛ مِن متاعٍ أو حِليةٍ أنْ يَقْذِفوه في ذلك الحفيرِ، ثمَّ أوقَدَ عليه النَّارَ، فأحرَقَه، فقال: لا يكونُ لنا، ولا لهم.\nوكان السَّامريُّ رجلًا مِن قومٍ يَعْبُدون البقرَ جيرانٍ لهم، ولم يكُنْ مِن بني إسرائيلَ، فاحتملَ مع مُوسى عليه السَّلامُ وبني إسرائيلَ حين احْتملوا، فقُضِيَ له أنْ رأى أثرًا، فأخَذَ منه بقبْضَتِه، فمَرَّ بهارونَ، فقال له هارونُ عليه السَّلامُ: يا سامريُّ، ألَا تُلْقي ما في يدَيْك؟ وهو قابضٌ عليه لا يَراه أحدٌ طوالَ ذلك، فقال: هذه قبْضةٌ مِن أثرِ الرَّسولِ الَّذي جاوَزَ بكم البحرَ، ولا أُلْقيها لشَيءٍ إلَّا أنْ تَدْعُوَ اللهَ إذا ألقيْتُها أنْ تكونَ ما أُرِيدُ، فألْقاها، ودعا اللهَ هارونُ عليه السَّلامُ، فقال: أريدُ أنْ يكونَ عِجْلًا، واجتمَعَ ما كان في الحُفرةِ مِن متاعٍ له، أو حِلْيةٍ، أو نحاسٍ، أو حديدٍ، فصار عِجْلًا أجوفَ ليس فيه رُوحٌ، له خُوارٌ.\nقال ابنُ عبَّاسٍ: لا واللهِ ما كان له صوتٌ قطُّ، إنَّما كانت الرِّيحُ تدخُلُ مِن دُبُرِه وتخرُجُ مِن فَمِه، فكان ذلك الصَّوتُ مِن ذلك.\nفتفرَّقَ بنو إسرائيلَ فِرَقًا؛ فقالت فِرقةٌ: يا سامريُّ، ما هذا فأنت أعلَمُ به؟ قال: هذا ربُّكم عَزَّ وجَلَّ، ولكنَّ مُوسى عليه السَّلامُ أضَلَّ الطَّريقَ. وقالت فِرقةٌ: لا نُكذِّب بهذا حتَّى يرجِعَ إلينا مُوسى، فإنْ كان ربَّنا لم نكُنْ ضيَّعْناه وعجَزْنا فيه حِينَ رأيْناه، وإنْ لم يكُنْ ربَّنا، فإنَّا نتَّبِعُ قولَ مُوسى عليه السَّلامُ. وقالت فِرقةٌ: هذا عمَلُ الشَّيطانِ، وليس بربِّنا، ولا نُؤْمِنُ، ولا نُصدِّقُ.\nوأُشْرِبَ فِرقةٌ في قُلوبِهم التَّصديقَ بما قال السَّامريُّ في العجلِ، وأعْلَنوا التَّكذيبَ، فقال لهم هارونُ عليه السَّلامُ: {يَا قَوْمِ إِنَّمَا فُتِنْتُمْ بِهِ} [طه: 90]، وإنَّ ربَّكم ليس هكذا، قالوا: فما بالُ مُوسى عليه السَّلامُ؛ وعَدَنا ثلاثينَ يومًا ثمَّ أخلَفَنا، فهذه أربعونَ قد مَضَت؟! فقال سُفهاؤُهم: أخطَأَ ربَّه، فهو يطلُبُه ويتبَعُه. فلمَّا كلَّمَ اللهُ عَزَّ وجَلَّ مُوسى عليه السَّلامُ وقال له ما قال، أخبَرَه بما لقِيَ قومُه بعده. {فَرَجَعَ مُوسَى إِلَى قَوْمِهِ غَضْبَانَ أَسِفًا} [طه: 86]، وقال لهم ما سمِعْتُم في القُرآنِ وأخَذَ برأْسِ أخِيه، وألْقى الألواحَ مِن الغضَبِ، ثمَّ عذَرَ أخاه بعُذْرِه، واستغفَرَ له، وانصرَفَ إلى السَّامريِّ، فقال له: ما حمَلَك على ما صنعْتَ؟ قال: قبَضْتُ قبضةً مِن أثرِ الرَّسولِ وفطِنْتُ لها، وعُمِّيَت عليكم، فقَذفْتُها؛ وكذلك سوَّلَت لي نَفْسي.\nقال: {اذْهَبْ فَإِنَّ لَكَ فِي الْحَيَاةِ أَنْ تَقُولَ لَا مِسَاسَ وَإِنَّ لَكَ مَوْعِدًا لَنْ تُخْلَفَهُ وَانْظُرْ إِلَى إِلَهِكَ} إلى قولِه: {نَسْفًا} [طه: 97]، ولو كان إلهًا لم يُخْلَصْ إلى ذلك منه. فاستيقَنَ بنو إسرائيلَ بالفتنةِ، واغْتَبَطَ الَّذين كان رأيُهم فيه مثلَ رأيِ هارونَ عليه السَّلامُ، فقالوا بجماعتِهم لمُوسى عليه السَّلامُ: سَلْ لنا ربَّك عَزَّ وجَلَّ أنْ يفتَحَ لنا بابَ توبةٍ نصنَعُها؛ فيُكَفِّرَ عنَّا ما عمِلْنا، فاختارَ موسى عليه السَّلامُ قومَه سبعينَ رجُلًا لذلك -لا يأْلُو الخيرَ- خيارَ بني إسرائيلَ، ومَن لم يُشْرِكْ في العجلِ. فانطلَقَ بهم ليسأَلَ لهم التَّوبةَ، فرجَفَتْ بهم الأرضُ، فاستحيا نبيُّ اللهِ صَلَّى اللهُ عليه وسلَّمَ من قومِه ووفْدِه حين فُعِلَ بهم ما فُعِلَ، فقال: {رَبِّ لَوْ شِئْتَ أَهْلَكْتَهُمْ مِنْ قَبْلُ وَإِيَّايَ أَتُهْلِكُنَا بِمَا فَعَلَ السُّفَهَاءُ مِنَّا} [الأعراف: 155]، وفيهم مَن قد كان اللهُ عَزَّ وجَلَّ اطَّلَعَ على ما أُشْرِبَ قلبُه من حُبِّ العجلِ وإيمانِه به؛ فلذلك رجَفَت بهم الأرضُ.\nفقال: {وَرَحْمَتِي وَسِعَتْ كُلَّ شَيْءٍ فَسَأَكْتُبُهَا لِلَّذِينَ يَتَّقُونَ} [الأعراف: 156] إلى: {فِي التَّوْرَاةِ وَالْإِنْجِيلِ} [الأعراف: 157]، فقال: رَبِّ سألْتُك التَّوبةَ لقومي، فقلْتَ: إنَّ رحمتي كتبْتُها لقومٍ غيرِ قومي، فليتَكَ أخَّرْتَني حين تُخْرِجُني حيًّا في أُمَّةِ ذلك الرَّجلِ المرحومةِ، فقال اللهُ له: إنَّ توبتَهم أنْ يقتُلَ كلُّ رجُلٍ منهم مَن لقِيَ مِن والدٍ أو ولدٍ، فيقتُلَه بالسَّيفِ لا يُبَالي مَن قتَلَ في ذلك الموطنِ، وتاب أولئك الَّذين كان خفِيَ على موسى وهارونَ عليهما السلام ما اطَّلَعُ اللهُ عليهم من ذُنوبِهم، فاعتَرَفوا بها، وفعَلوا ما أُمِروا، وغفَرَ اللهُ للقاتِلِ والمقتولِ. ثمَّ سار بهم مُوسى عليه السَّلامُ مُتوجِّهًا نحوَ الأرضِ المُقدَّسةِ، وأخَذَ الألواحَ بعدما سكَتَ عنه الغضبُ، وأمَرَهم بالَّذي أُمِرَ به أنْ يُبَلِّغَهم من الوظائفِ، فثقُلَ ذلك عليهم، وأبَوا أنْ يُقِرُّوا بها، فنتَقَ اللهُ عليهم الجبلَ كأنَّه ظُلَّةٌ، ودنا منهم حتَّى خافوا أنْ يقَعَ عليهم، فأخَذُوا الكتابَ بأيمانِهم وهم يَصْغُون ينظُرونَ إلى الجبلِ والأرضِ، والكتابُ بأيديهم وهم يَنظُرونَ إلى الجبلِ؛ مخافةَ أنْ يقَعَ عليهم، ثمَّ مَضَوا إلى الأرضِ المُقدَّسةِ، فوَجَدوا مدينةَ قومٍ جبَّارينَ خَلْقُهم مُنْكرٌ، وذكَرَ من ثِمارِهم أمرًا عجَبًا من عِظَمِها، فقالوا: يا موسى، إنَّ فيها قومًا جبَّارينَ لا طاقةَ لنا بهم، ولا ندخُلُها ما داموا فيها، فإنْ يَخْرجوا منها فإنَّا داخِلونَ، قال رجُلانِ من الَّذين يَخافونَ مِن الجبَّارينَ: آمنَّا بمُوسى عليه السَّلامُ، فخرَجَا إليه، فقالا: نحنُ أعلَمُ بقومِنا، إنْ كنتُمْ إنَّما تَخافونَ ما رأيتُمْ من أجسامِهم وعدَدِهم، فإنَّهم لا قُلوبَ لهم، ولا مَنعةَ عندهم، فادْخُلوا عليهم البابَ، فإذا دخلْتُموه فإنَّكم غالِبونَ. ويقولُ أناسٌ: إنَّهما من قومِ مُوسى عليه السَّلامُ. وزعَمَ سعيدُ بنُ جُبيرٍ أنَّهما من الجبَّارينَ آمَنَا بمُوسى، بقولِه: {مِنَ الَّذِينَ يَخَافُونَ} [المائدة: 23]: إنَّما عَنى بذلك: مِن الَّذين يَخافونَ بني إسرائيلَ.\n{قَالُوا يَا مُوسَى إِنَّا لَنْ نَدْخُلَهَا أَبَدًا مَا دَامُوا فِيهَا فَاذْهَبْ أَنْتَ وَرَبُّكَ فَقَاتِلَا إِنَّا هَاهُنَا قَاعِدُونَ} [المائدة: 24]، فأغْضَبوا مُوسَى عليه السَّلامُ، فدعا عليهم، وسمَّاهم فاسقينَ، ولم يدْعُ عليهم قبلَ ذلك؛ لِمَا رأى منهم من المعصيةِ وإساءتِهم حتَّى كان يومئذٍ، فاستجابَ اللهُ عَزَّ وجَلَّ له، فسمَّاهم كما سمَّاهم مُوسى عليه السَّلامُ فاسقينَ، فحرَّمَها عليهم أربعينَ سَنةً يَتِيهون في الأرضِ؛ يُصْبِحون كلَّ يومٍ، فيَسِيرونَ ليس لهم قرارٌ، ثمَّ ظلَّلَ عليهم الغمامَ في التِّيهِ، وأنزَلَ عليهم المَنَّ والسَّلوى، وجعَلَ لهم ثيابًا لا تَبْلى، ولا تتَّسِخُ، وجعَلَ بين ظَهرِهم حَجرًا مُربَّعًا، وأمَرَ مُوسى عليه السَّلامُ فضرَبَه بعصاهُ، فانفجَرَ منه اثنتا عشْرةَ عينًا، في كلِّ ناحيةٍ ثلاثةُ أعينٍ، وأعلَمَ كلَّ سِبْطٍ عينَهم الَّتي يَشْربون منها، فلا يَرْتحِلونَ من مَنزلٍ إلَّا وجدوا ذلك الحجرَ منهم بالمكانِ الَّذي كان منه أمسِ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (11263)، وأبو يعلى (2618)، والطحاوي في ((شرح مشكل الآثار)) (66) بنحوه.","bab":"تفسير آيات › سورة طه","dorar":"n97bkyvU","merged":21,"otherRefs":["تخريج المسند لشعيب 10564 (صحيح)","تخريج المسند لشعيب 17800 (صحيح)","صحيح الجامع 3878 (صحيح)","صحيح الترغيب 978 (صحيح)","تخريج المسند لشعيب 11359 (صحيح)","صحيح ابن خزيمة 3/ 349 (صحيح)","لطائف المعارف 312 (صحيح)","تخريج المسند لشعيب 9275 (صحيح)","تخريج المسند لشعيب 10693 (صحيح)","تخريج المسند لشعيب 10218 (صحيح)","تخريج المسند لشعيب 9363 (صحيح)","صحيح النسائي 2214 (صحيح)","صحيح مسلم 1151 (صحيح)","تخريج المسند لشعيب 10691 (صحيح)","تخريج المسند لشعيب 7195 (صحيح)","تخريج المسند لشعيب 4256 (صحيح)","تخريج سنن الدارقطني 2370 (صحيح)","مجمع الزوائد 3/185 (حسن)","أطراف الغرائب 2/382 (حسن)"]},{"id":"س-02849","fp":"bf87edfd3172","stateId":230,"easy":"إذا عجّلت فطرك ← تكون من أحب عباد الله إليه","cause":"أعجَلُهُم فِطرًا","result":"أحبُّ عبادي إليَّ","explicit":true,"ref":"صحيح ابن خزيمة 3/ 477","srcLabel":"الترمذي","text":["عَن رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ: قالَ اللَّهُ تبارَكَ وتعالى: ",["أحبُّ عبادي إليَّ",2]," ",["أعجَلُهُم فِطرًا",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الترمذي (700)، وأحمد (8360)، وابن حبان (3508) واللفظ لهم.","bab":"إيمان › الوعد","dorar":"EGPobzCs"},{"id":"س-01984","fp":"4d879ade7a11","stateId":230,"easy":"إذا عملت صالحاً في عشر ذي الحجة ← فهي أحب الأيام إلى الله للعمل","cause":"العملُ فيهن","result":"ما مِن أيَّامٍ أَحَبُّ إلى اللهِ العملُ فيهن مِن هذه الأيَّامِ","explicit":true,"star":true,"similar":["س-00739","س-00759"],"otherNeedIds":[49],"ref":"تخريج المسند لشعيب 6505","srcLabel":"أحمد","text":[["ما مِن أيَّامٍ أَحَبُّ إلى اللهِ العملُ فيهن مِن هذه الأيَّامِ",2],"، قيل: ولا الجهادُ في سبيلِ اللهِ؟ قال: ولا الجهادُ في سبيلِ اللهِ، إلَّا مَن خرَجَ بنَفْسِه ومالِه، ثُمَّ لم يَرجِعْ حتى تُهْراقَ مُهْجَةُ دمِه. قال: فلقِيتُ حَبيبَ بنَ أبي ثابتٍ فسألْتُه عن هذا الحديثِ؟ فحدَّثَني بنحوٍ مِن هذا الحديثِ، قال: وقال عَبْدةُ: هي الأيامُ العَشرُ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (6505) واللفظ له، والطيالسي (2397)، والطبراني (13/418) (14259)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Go4ur9GL","merged":2,"otherRefs":["الكافي لابن قدامة 1/362 (صحيح)"]},{"id":"س-00739","fp":"f7be4085f589","stateId":230,"easy":"إذا عملت الصالحات في عشر ذي الحجة ← فهو أحب العمل إلى الله","cause":"فيهِنَّ العملُ مِن هذه الأيامِ : عشرُ ذي الحجةِ","result":"ما مِن أيامٍ أعظمَ عندَ اللهِ ولا أحَبَّ إليه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-01984","otherNeedIds":[49],"ref":"إتحاف الخيرة المهرة 3/170","text":[["ما مِن أيامٍ أعظمَ عندَ اللهِ ولا أحَبَّ إليه",2]," ",["فيهِنَّ العملُ مِن هذه الأيامِ : عشرُ ذي الحجةِ",1]," - أو قال : العشرِ - فأكثِروا فيهِنَّ منَ التهليلِ والتسبيحِ , والتكبيرِ والتحميدِ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"سنده صحيح. وله شاهد","takhrij":"أخرجه أحمد (5446)، وعبد بن حميد في ((المسند)) (805) باختلاف يسير، والطحاوي في ((شرح مشكل الآثار)) (2971) واللفظ له","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"QAmzH0wv","merged":2,"otherRefs":["فتح الغفار 658/2 (حسن)"]},{"id":"س-00759","fp":"c1dd0669d194","stateId":230,"easy":"إذا عملت في عشر ذي الحجة ← فعملك فيها أحب إلى الله من غيرها","cause":"العملُ فيهنَّ","result":"أحبُّ إلى اللهِ عزَّ وجلَّ من هذه الأيَّامِ يعني من العشرِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-01984","otherNeedIds":[49],"ref":"الترغيب والترهيب 2/191","text":["ما من أيَّامٍ أفضلُ عند اللهِ ولا ",["العملُ فيهنَّ",1]," ",["أحبُّ إلى اللهِ عزَّ وجلَّ من هذه الأيَّامِ يعني من العشرِ",2]," فأكثِروا فيهنَّ من التَّهليلِ والتَّكبير وذكرِ اللهِ وإنَّ صيامَ يومٍ منها يُعدَلُ بصيامِ سنةٍ والعملُ فيهنَّ يُضاعَفُ بسبعِمائةِ ضِعفٍ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني (11/82) (11116)، والشجري في ((الأمالي)) (1745) مختصراً، والبيهقي في ((شعب الإيمان)) (3758) واللفظ له","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"Z6ZIb878"},{"id":"س-02144","fp":"c7f18c417ccb","stateId":230,"easy":"إذا ضحّيت يوم النحر ← فهو أحب العمل إلى الله يومها","cause":"إهراقِ الدَّمِ","result":"يومَ النَّحْرِ بشَيءٍ هو أحَبُّ إلى اللهِ تعالَى","explicit":true,"star":true,"similar":["س-02216"],"ref":"المستدرك على الصحيحين 7730","srcLabel":"الحاكم","text":["ما تُقُرِّبَ إلى اللهِ تَعالَى ",["يومَ النَّحْرِ بشَيءٍ هو أحَبُّ إلى اللهِ تعالَى",2]," مِن ",["إهراقِ الدَّمِ",1],"، وإنَّها لَتَأتي يومَ القيامةِ بقُرونِها وأشعارِها، وأظْلَافِها وإنَّ الدَّمَ ليَقَعُ مِن اللهِ تَعالَى بمكانٍ قبْلَ أنْ يقَعَ على الأرضِ، فيَطِيبوا بها نفْسًا."],"grade":"صحيح","narrator":"عائشة","muhaddith":"صحيح الإسناد","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"nLuzcK3y"},{"id":"س-02216","fp":"d94129fd80d8","stateId":230,"easy":"إذا ضحّيت يوم النحر ← فهو أحب ما يعمله الآدمي ذلك اليوم","cause":"إهراقِ الدَّمِ","result":"ما عمِلَ آدمِيٌّ مِن عمَلٍ يومَ النَّحرِ أحبَّ إلى اللهِ","explicit":true,"repOf":"س-02144","ref":"عارضة الأحوذي 4/3","text":[["ما عمِلَ آدمِيٌّ مِن عمَلٍ يومَ النَّحرِ أحبَّ إلى اللهِ",2]," مِن ",["إهراقِ الدَّمِ",1],"؛ إنَّها لتَأْتي يومَ القيامةِ بقُرونِها وأشعارِها وأظْلافِها، وإنَّ الدَّمَ لَيَقَعُ مِن اللهِ بمكانٍ قبلَ أنْ يقَعَ مِن الأرضِ، فَطِيبوا بها نفسًا."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"ليس في فضل الأضحية حديث صحيح","takhrij":"أخرجه الترمذي (1493) واللفظ له، وابن ماجه (3126)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"kkF5vu98"},{"id":"س-02162","fp":"84356c3c8d3d","stateId":230,"easy":"إذا ضحّيت بالبيضاء ← فهي أحب إلى الله من غيرها","cause":"دمُ عَفْراءَ","result":"أحبُّ إلى اللهِ من دمِ سوداوَيْن","explicit":true,"ref":"السلسلة الصحيحة 1861","srcLabel":"أحمد","text":[["دمُ عَفْراءَ",1]," ",["أحبُّ إلى اللهِ من دمِ سوداوَيْن",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (9393)، والحارث في ((مسنده)) (402) واللفظ له، والحاكم (7543).","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"IrWCrrtB"},{"id":"ق-0172","fp":"bdf40d1fda62","stateId":231,"easy":"الثبات وعدم الوهن والاستغفار والدعاء بالثبات والنصر ← ثواب الدنيا وحسن ثواب الآخرة ومحبة الله","cause":"الثبات وعدم الوهن والاستغفار والدعاء بالثبات والنصر","result":"ثواب الدنيا وحسن ثواب الآخرة ومحبة الله","explicit":true,"star":true,"otherNeedIds":[45,25],"ref":"سورة آل عمران: 146–148","srcLabel":"القرآن الكريم","quran":{"s":3,"from":146,"to":148,"text":"وَكَأَيِّنْ مِنْ نَبِيٍّ قَاتَلَ مَعَهُ رِبِّيُّونَ كَثِيرٌ فَمَا وَهَنُوا لِمَا أَصَابَهُمْ فِي سَبِيلِ اللَّهِ وَمَا ضَعُفُوا وَمَا اسْتَكَانُوا وَاللَّهُ يُحِبُّ الصَّابِرِينَ (146) وَمَا كَانَ قَوْلَهُمْ إِلَّا أَنْ قَالُوا رَبَّنَا اغْفِرْ لَنَا ذُنُوبَنَا وَإِسْرَافَنَا فِي أَمْرِنَا وَثَبِّتْ أَقْدَامَنَا وَانْصُرْنَا عَلَى الْقَوْمِ الْكَافِرِينَ (147) فَآتَاهُمُ اللَّهُ ثَوَابَ الدُّنْيَا وَحُسْنَ ثَوَابِ الْآخِرَةِ وَاللَّهُ يُحِبُّ الْمُحْسِنِينَ (148)","hl":[[0,461,1]]}},{"id":"ق-0316","fp":"f7fb6264ff84","stateId":231,"easy":"الذلة على المؤمنين والعزة على الكافرين والجهاد وعدم خوف اللوم ← محبة الله وفضله","cause":"الذلة على المؤمنين والعزة على الكافرين والجهاد وعدم خوف اللوم","result":"محبة الله وفضله","explicit":true,"star":true,"ref":"سورة المائدة: 54","srcLabel":"القرآن الكريم","quran":{"s":5,"from":54,"to":54,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا مَنْ يَرْتَدَّ مِنْكُمْ عَنْ دِينِهِ فَسَوْفَ يَأْتِي اللَّهُ بِقَوْمٍ يُحِبُّهُمْ وَيُحِبُّونَهُ أَذِلَّةٍ عَلَى الْمُؤْمِنِينَ أَعِزَّةٍ عَلَى الْكَافِرِينَ يُجَاهِدُونَ فِي سَبِيلِ اللَّهِ وَلَا يَخَافُونَ لَوْمَةَ لَائِمٍ ذَلِكَ فَضْلُ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ (54)","hl":[[102,301,1]]}},{"id":"ق-1327","fp":"3136d8089ed3","stateId":231,"easy":"القتال في سبيل الله صفاً كالبنيان المرصوص ← محبة الله","cause":"القتال في سبيل الله صفاً كالبنيان المرصوص","result":"محبة الله","explicit":true,"star":true,"similar":["س-04426"],"ref":"سورة الصف: 4","srcLabel":"القرآن الكريم","quran":{"s":61,"from":4,"to":4,"text":"إِنَّ اللَّهَ يُحِبُّ الَّذِينَ يُقَاتِلُونَ فِي سَبِيلِهِ صَفًّا كَأَنَّهُمْ بُنْيَانٌ مَرْصُوصٌ (4)","hl":[[0,97,1]]}},{"id":"س-04346","fp":"f1d3e92a8e0e","stateId":231,"easy":"إذا اعتززت بنفسك عند القتال والصدقة ← فهي الخيلاء التي يحبها الله","cause":"أنْ يتخيَّلَ العبدُ بنفسِه عندَ القتالِ وأنْ يتخيَّلَ عندَ الصَّدقةِ","result":"فأمَّا الخُيلاءُ الَّتي يُحِبُّ اللهُ","explicit":true,"ref":"إكمال المعلم 6/599","srcLabel":"إكمال المعلم","text":["حديث الرُّخصةِ في الخُيَلاءِ على الكُفارِ أو في الحَربِ.[إنَّ مِن الغَيرةِ ما يُحِبُّ اللهُ ومنها ما يُبغِضُ اللهُ فأمَّا الغَيرةُ الَّتي يُحِبُّ اللهُ فالغَيرةُ في اللهِ وأمَّا الغَيرةُ الَّتي يُبغِضُ اللهُ فالغَيرةُ في غيرِ اللهِ وإنَّ مِن الخُيلاءِ ما يُحِبُّ اللهُ ومنها ما يُبغِضُ اللهُ ",["فأمَّا الخُيلاءُ الَّتي يُحِبُّ اللهُ",2]," ",["أنْ يتخيَّلَ العبدُ بنفسِه عندَ القتالِ وأنْ يتخيَّلَ عندَ الصَّدقةِ",1]," وأمَّا الخُيلاءُ الَّتي يُبغِضُ اللهُ فالخُيلاءُ لغيرِ الدِّينِ]"],"grade":"صحيح","narrator":"[عتيك الأنصاري]","muhaddith":"صحيح","bab":"جهاد › استحباب الخيلاء في الحرب","dorar":"hbPVovb7","merged":5,"otherRefs":["صحيح ابن حبان 4762 (صحيح)","تخريج المسند لشعيب 23750 (حسن)","تخريج مشكل الآثار 4576 (حسن)","تخريج المسند لشعيب 23748 (حسن)"]},{"id":"س-05706","fp":"d76acf1fe273","stateId":231,"easy":"إذا غزوت فلقيت العدو صابراً محتسباً حتى قُتلت ← تكون ممن يحبهم الله","cause":"رَجُلٌ غَزا في سَبيلِ اللهِ فلَقِيَ العَدُوَّ مُجاهِدًا مُحْتَسِبًا، فقاتَلَ حتَّى قُتِلَ، وأنتم تَجِدونَ في كِتابِ اللهِ عَزَّ وجَلَّ: {إِنَّ اللَّهَ يُحِبُّ الَّذِينَ يُقَاتِلُونَ فِي سَبِيلِهِ صَفًّا}، ورَجُلٌ له جارٌ يُؤْذيه فيَصبِرُ على أذاه، ويَحْتَسِبُه حتَّى يَكْفيه اللهُ إيَّاه بمَوْتٍ أو حَياةٍ، ورَجُلٌ يكونُ معَ قَوْمٍ فيَسيرونَ حتَّى يَشُقَّ عليهم الكَرى -أو النُّعاسُ- فيَنزِلونَ في آخِرِ اللَّيْلِ، فيَقومُ إلى وَضوئِه وصَلاتِه","result":"ثَلاثةٌ يُحِبُّهم اللهُ عَزَّ وجَلَّ","explicit":true,"similar":["س-06980","س-00386","س-00428"],"ref":"الصحيح المسند 272","srcLabel":"الترمذي","text":["عن مُطَرِّفِ بنِ عَبْدِ اللهِ بنِ الشِّخِّيرِ قالَ: بَلَغَني عن أبي ذَرٍّ حَديثٌ، فكُنْتُ أُحِبُّ أن أَلْقاه، فلَقِيتُه، فقُلْتُ له: يا أبا ذَرٍّ، بَلَغَني عنك حَديثٌ، فكُنْتُ أُحِبُّ أن أَلْقاك فأَسأَلَك عنه، فقالَ: قد لَقيْتَ فاسْأَلْ، قالَ: قُلْتُ: بَلَغَني أنَّك تقولُ: سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ يقولُ: «",["ثَلاثةٌ يُحِبُّهم اللهُ عَزَّ وجَلَّ",2],"، وثَلاثةٌ يُبغِضُهم اللهُ عَزَّ وجَلَّ»، قالَ: نَعمْ، فما إخالُني أَكذِبُ على خَليلي مُحمَّدٍ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ ثَلاثًا يَقولُها، قالَ: قُلْتُ: مَن الثَّلاثةُ الَّذين يُحِبُّهم اللهُ عَزَّ وجَلَّ، قالَ: «",["رَجُلٌ غَزا في سَبيلِ اللهِ فلَقِيَ العَدُوَّ مُجاهِدًا مُحْتَسِبًا، فقاتَلَ حتَّى قُتِلَ، وأنتم تَجِدونَ في كِتابِ اللهِ عَزَّ وجَلَّ: {إِنَّ اللَّهَ يُحِبُّ الَّذِينَ يُقَاتِلُونَ فِي سَبِيلِهِ صَفًّا}، ورَجُلٌ له جارٌ يُؤْذيه فيَصبِرُ على أذاه، ويَحْتَسِبُه حتَّى يَكْفيه اللهُ إيَّاه بمَوْتٍ أو حَياةٍ، ورَجُلٌ يكونُ معَ قَوْمٍ فيَسيرونَ حتَّى يَشُقَّ عليهم الكَرى -أو النُّعاسُ- فيَنزِلونَ في آخِرِ اللَّيْلِ، فيَقومُ إلى وَضوئِه وصَلاتِه",1],"»، قالَ: قُلْتُ: مَن الثَّلاثةُ الَّذين يُبغِضُهم اللهُ؟ قالَ: «الفَخورُ المُخْتالُ، وأنتم تَجِدونَ في كِتابِ اللهِ عَزَّ وجَلَّ: {إِنَّ اللَّهَ لا يُحِبُّ كُلَّ مُخْتَالٍ فَخُورٍ}، والبَخيلُ المَنَّانُ، والتَّاجِرُ والبَيَّاعُ الحَلَّافُ»، قالَ: قُلْتُ: يا أبا ذَرٍّ، ما المالُ؟ قالَ: فِرْقٌ لنا وذَوْدٌ -يَعْني بالفِرْقِ غَنَمًا يَسيرةً- قالَ: قُلْتُ: لسْتُ عن هذا أَسأَلُ، إنَّما أَسأَلُك عن صامِتِ المالِ، قالَ: ما أَصبَحَ لا أَمْسى، وما أَمْسى لا أَصبَحَ، قالَ: قُلْتُ: يا أبا ذَرٍّ، ما لك ولإخوَتِك قُرَيْشٍ، قالَ: واللهِ لا أَسأَلُهم دُنْيا، ولا أَسْتَفْتيهم عن دينِ اللهِ تَبارَكَ وتَعالى حتَّى أَلْقى اللهَ ورَسولَه، ثَلاثًا يَقولُها."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2568)، والنسائي (2570)، وأحمد (21355)، وابن خزيمة (2456) واللفظ لهم.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"3HEcsZeh","merged":2,"otherRefs":["المستدرك على الصحيحين 2481 (صحيح)"]},{"id":"س-06980","fp":"e2b552c47832","stateId":231,"easy":"إذا انكشف أصحابك فقاتلت وراءهم بنفسك لله ← تكون ممن يحبهم الله ويضحك إليهم","cause":"الَّذي إذا انْكَشَفَ فِئةٌ قاتَلَ وَراءَها بِنَفْسِهِ لِلَّهِ عزَّ وجلَّ","result":"ثَلاثةٌ يُحِبُّهُمُ اللهُ ويَضْحَكُ إليْهِمُ","explicit":true,"repOf":"س-05706","ref":"المستدرك على الصحيحين 68","text":["«",["ثَلاثةٌ يُحِبُّهُمُ اللهُ ويَضْحَكُ إليْهِمُ",2],": ",["الَّذي إذا انْكَشَفَ فِئةٌ قاتَلَ وَراءَها بِنَفْسِهِ لِلَّهِ عزَّ وجلَّ",1],"»."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه البيهقي في ((الأسماء والصفات)) (983)، والطبراني كما في ((جامع المسانيد)) (11904) بنحوه.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"SGlpOIOG","merged":2,"otherRefs":["مجمع الزوائد 2/258 (حسن)"]},{"id":"س-00386","fp":"3c574db88b94","stateId":231,"easy":"إذا ثبتّ أمام العدو حتى تُقتل أو يُفتح لأصحابك ← تكون ممن يحبهم الله","cause":"الرَّجلُ يَلْقى العَدوَّ في الفِئةِ فيَنصِبُ لهم نَحرَه حتى يُقتَلَ، أو يُفتَحَ لأصحابِه، والقومُ يُسافِرونَ فيَطولُ سُراهُم حتى يُحِبُّوا أنْ يَمَسُّوا الأرضَ، فيَنزِلونَ، فيَتنَحَّى أحَدُهم، فيُصلِّي حتى يوقِظَهم لرَحيلِهم، والرَّجلُ يكونُ له الجارُ يُؤْذيهِ جِوارُه، فيَصبِرُ على أَذاهُ حتى يُفرِّقَ بينَهما موتٌ أو ظَعنٌ","result":"ثلاثةٌ يُحِبُّهمُ اللهُ","explicit":true,"repOf":"س-05706","ref":"تخريج المسند لشعيب 21340","text":["لَقيتُ أبا ذَرٍّ، فقُلْتُ له: بلَغَني عنكَ أنَّكَ تُحدِّثُ حَديثًا عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقال: أمَا إنَّه لا تَخالُني أكذِبُ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ بعدَما سمِعْتُه منه، فما الذي بلَغَكَ عنِّي؟ قُلْتُ: بلَغَني أنَّكَ تَقولُ: ",["ثلاثةٌ يُحِبُّهمُ اللهُ",2],"، وثلاثةٌ يَشنَؤُهمُ اللهُ، قال: قُلْتُه وسمِعْتُه؟ قُلْتُ: فمَن هؤلاء الذين يُحِبُّ اللهُ؟ قال: ",["الرَّجلُ يَلْقى العَدوَّ في الفِئةِ فيَنصِبُ لهم نَحرَه حتى يُقتَلَ، أو يُفتَحَ لأصحابِه، والقومُ يُسافِرونَ فيَطولُ سُراهُم حتى يُحِبُّوا أنْ يَمَسُّوا الأرضَ، فيَنزِلونَ، فيَتنَحَّى أحَدُهم، فيُصلِّي حتى يوقِظَهم لرَحيلِهم، والرَّجلُ يكونُ له الجارُ يُؤْذيهِ جِوارُه، فيَصبِرُ على أَذاهُ حتى يُفرِّقَ بينَهما موتٌ أو ظَعنٌ",1],"، قُلْتُ: ومَن هؤلاء الذين يَشنَؤُهمُ اللهُ؟ قال: التاجِرُ الحلَّافُ، أو قال: البائعُ الحلَّافُ، والبَخيلُ المَنَّانُ، والفقيرُ المُختالُ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (1315) بنحوه، وأحمد (21340) واللفظ له","bab":"آداب عامة › الأخلاق المذمومة","dorar":"B9lMc7gg"},{"id":"س-00428","fp":"8fe8fe327b4c","stateId":231,"easy":"إذا انكشف أصحابك فلقيت العدو بنفسك حتى تُقتل ← تكون ممن يحبهم الله","cause":"رجُلٌ لقِيَ فِئةً أو سَرِيَّةً فانكَشَفَ أصحابُهُ فلقِيَهم بنفْسِهِ ونَحرِهِ حتَّى قُتِلَ أو فتَحَ اللهُ عزَّ وجلَّ، ورجُلٌ كان مع قومٍ، فأطالوا السُّرى حتَّى أَعجَبهم أنْ يَمَسُّوا الأرضَ فنزَلوا، فتَنحَّى، فصلَّى حتَّى أيقَظَ أصحابَهُ للرحيلِ، ورجُلٌ كان له جارُ سُوءٍ، فصبَر على أذاهُ حتَّى يُفرِّقَ بيْنَهما موتٌ أو ظَعْنٌ","result":"ثلاثةٌ يُحبُّهمُ اللهُ","explicit":true,"repOf":"س-05706","ref":"تخريج مشكل الآثار 2783","text":["عن ابن الأَحْمَسِ أنَّه قال: بلَغَني أنَّ أبا ذَرٍّ رضِيَ اللهُ عنه يقولُ: ",["ثلاثةٌ يُحبُّهمُ اللهُ",2]," عزَّ وجلَّ، وثلاثةٌ يَشْنَؤُهمُ اللهُ عزَّ وجلَّ، قال: فلقِيتُهُ، فقُلْتُ: يا أبا ذَرٍّ، ما حديثٌ بلَغَني عنكِ تُحُدِّثَ به عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أَحبَبْتُ أنْ أَسمَعَهُ منك؟ قال: ما هو؟ قُلْتُ: ثلاثةٌ يُحبُّهمُ اللهُ عزَّ وجلَّ، وثلاثةٌ يَشْنَؤُهمُ اللهُ عزَّ وجلَّ، قال أبو ذَرٍّ: قُلْتُهُ وسمِعْتُه. قال: قُلْتُ: مَنِ الذينَ يُحبُّهمُ اللهُ؟ قال: ",["رجُلٌ لقِيَ فِئةً أو سَرِيَّةً فانكَشَفَ أصحابُهُ فلقِيَهم بنفْسِهِ ونَحرِهِ حتَّى قُتِلَ أو فتَحَ اللهُ عزَّ وجلَّ، ورجُلٌ كان مع قومٍ، فأطالوا السُّرى حتَّى أَعجَبهم أنْ يَمَسُّوا الأرضَ فنزَلوا، فتَنحَّى، فصلَّى حتَّى أيقَظَ أصحابَهُ للرحيلِ، ورجُلٌ كان له جارُ سُوءٍ، فصبَر على أذاهُ حتَّى يُفرِّقَ بيْنَهما موتٌ أو ظَعْنٌ",1],". قال: قُلْتُ: هؤلاءِ الذينَ يُحبُّهمُ اللهُ فمَنِ الذينَ يَشْنَؤُهم؟ قال: التَّاجرُ الحلَّافُ، أوِ البائعُ الحلَّافُ -شكَّ الجُرَيريُّ- والبخيلُ المنَّانُ، والفقيرُ المُختالُ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح المشكل)) (2783) بلفظه، والترمذي (2568)، وأحمد (21530)، والبزار (3908) جميعهم باختلاف يسير.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"16anvgz0"},{"id":"س-06910","fp":"1a37652553de","stateId":231,"easy":"إذا انهزم أصحابك فرجعت رغبة فيما عند الله حتى قُتلت ← يباهي الله بك الملائكة","cause":"رجلٌ غَزَا في سبيلِ اللهِ، فانهزم مع أصحابِهِ، فَعَلِمَ ما عليه في الانهزامِ، وما له في الرجوعِ، فرجع حتى هُرِيقَ دَمُهُ","result":"انظُروا إلى عبدي، رجع رغبةً فيما عندي، وشَفَقًا مما عندي حتى هُرِيقَ دَمُهُ","explicit":true,"ref":"هداية الرواة 1207","srcLabel":"أحمد","text":["عَجِبَ ربُّنا من رَجُلَيْنِ : رجلٌ ثار عن وِطائِهِ ولِحافِهِ من بينِ حِبِّهِ وأهلِهِ إلى صلاتِهِ، فيقولُ اللهُ لملائكتِهِ : انظُروا إلى عبدي ؛ ثار عن فراشِهِ ووِطائِهِ من بينِ حِبِّهِ وأهلِهِ إلى صلاتِهِ، رغبةً فيما عندي، وشَفَقًا مما عندي، و",["رجلٌ غَزَا في سبيلِ اللهِ، فانهزم مع أصحابِهِ، فَعَلِمَ ما عليه في الانهزامِ، وما له في الرجوعِ، فرجع حتى هُرِيقَ دَمُهُ",1],"، فيقولُ اللهُ – تعالى – لملائكتِهِ : ",["انظُروا إلى عبدي، رجع رغبةً فيما عندي، وشَفَقًا مما عندي حتى هُرِيقَ دَمُهُ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"حسن أو صحيح","takhrij":"أخرجه أحمد (3949)، وابن خزيمة في ((التوحيد)) (2/895)، وابن حبان (2557) باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"ORDx8vif"},{"id":"س-00489","fp":"84eb99baa9ec","stateId":231,"easy":"إذا تدربت على الخيل والرمي ← فهو أحب اللهو إلى الله","cause":"إجراءُ الخيلِ، والرميُ","result":"أحبُّ اللهوِ إلى اللهِ تعالى","explicit":true,"ref":"الجامع الصغير 215","srcLabel":"ابن عدي","text":[["أحبُّ اللهوِ إلى اللهِ تعالى",2]," ",["إجراءُ الخيلِ،  والرميُ",1]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (6/ 177) واللفظ له.","bab":"آداب عامة › المباحات من الأفعال والأقوال","dorar":"pWU3JZEe"},{"id":"س-04426","fp":"bc7f3892e65f","stateId":231,"easy":"إذا قاتلت في سبيل الله صفاً كالبنيان المرصوص ← يحبك الله","cause":"الذينَ يُقاتِلونَ في سَبيله صَفًّا كَأنَّهم بُنيانٌ مَرصوصٌ)، وقال اللهُ: (ولا تُلقوا بأيديكُم إلى التَّهلُكةِ","result":"إنَّ اللَّهَ يُحِبُّ","explicit":true,"repOf":"ق-1327","ref":"مشارع الأشواق 938","text":["أنَّهم حاصَروا دِمَشقَ، وانطَلَقَ رَجُلٌ مِن أسَد شَنوءةَ فأسرَعَ إلى العَدوِّ وحدَه ليَستَقتِلَ، فعابَ ذلك المُسلمونَ عليه، ورُفِع حَديثُه إلى عَمرِو بنِ العاصِ رَضيَ اللهُ عنه وهو على جُندٍ مِنَ الأجنادِ، فأرسَلَ إلَيه عَمرٌو، فرَدَّه، فقال له عَمرٌو: (",["إنَّ اللَّهَ يُحِبُّ",2],[" الذينَ يُقاتِلونَ في سَبيله صَفًّا كَأنَّهم بُنيانٌ مَرصوصٌ)، وقال اللهُ: (ولا تُلقوا بأيديكُم إلى التَّهلُكةِ)",1],"، فقال له الرَّجُلُ: يا عَمرُو، أُذَكِّرُك اللَّهَ - الذي وجَدَك رَأسَ كُفرٍ فجَعَلَك رَأسَ الإسلامِ- أن تَصُدَّني عَن أمرٍ قد جَعَلتُه في نَفسي؛ فإنِّي أُريدُ أن أمشيَ حَتَّى يَزولَ هذا -وأشارَ إلى جَبَلِ الثَّلجِ- فلَم يَزَلْ يُناشِدُ عَمرًا حَتَّى خَلَّى عَمرٌو سَبيلَه، فانطَلَقَ حَتَّى أمسى وجُنح اللَّيلِ قِبَلَ العَدوِّ، ثُمَّ رَجَعَ، فقال له المُسلمونَ: الحَمدُ للهِ الذي رَجَعَك وأراك غَيرَ رَأيِك الذي كُنتَ عليه، قال: فإنِّي واللَّهِ ما انثَنَيتُ عَمَّا كان في نَفسي، ولَكِنِّي رَأيتُ المَساءَ وخَشِيتُ أن أهلِكَ بمَضيعةٍ، فلَمَّا أصبَحَ غَدا إلى العَدوِّ وَحدَه فقاتَلَهم حَتَّى قُتِل رَحِمَه اللهُ."],"grade":"حسن","narrator":"عبد الرحمن بن الأسود بن عبد يغوث","muhaddith":"إسناده جيد","takhrij":"أخرجه ابن أبي حاتم في ((تفسيره)) (1747)، والطحاوي في ((شرح مشكل الآثار)) (12/ 105)، وابن عساكر (34/ 220) واللفظ لهم.","bab":"جهاد › النية في القتال والغزو","dorar":"aXkYJW7e"},{"id":"س-04986","fp":"39536c0eeb8d","stateId":231,"easy":"إذا اختلت (تبخترت) عند القتال ← فهي خيلاء يحبها الله","cause":"فاخْتِيالُ الرَّجُلِ عنْدَ القِتالِ","result":"ومِنها ما يُحِبُّ اللهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الأحكام الوسطى 3/ 55","srcLabel":"أبو داود","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ كانَ يَقولُ: \"مِن الغَيْرةِ ما يُحِبُّ اللهُ، ومِنها ما يُبغِضُ اللهُ؛ فأمَّا الَّتي يُحِبُّ اللهُ فالغَيْرةُ في ريبةٍ، وأمَّا الَّتي يُبغِضُها اللهُ فالغَيْرةُ في غَيْرِ ريبةٍ، وإنَّ مِن الخُيَلاءِ ما يُبغِضُ اللهُ عَزَّ وجَلَّ، ",["ومِنها ما يُحِبُّ اللهُ",2],"؛ فأمَّا الَّتي يُحِبُّ اللهُ ",["فاخْتِيالُ الرَّجُلِ عنْدَ القِتالِ",1],"، وأمَّا الَّتي يُبغِضُ اللهُ فاخْتِيالُه في البَغْيِ والفَخْرِ\"."],"grade":"صحيح","narrator":"جابر بن عتيك","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (2659)، والنسائي (2558)، وأحمد (23747) واللفظ لهم","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"blc8OLUy"},{"id":"س-06881","fp":"7844a6b693d4","stateId":231,"easy":"إذا ثبتّ في القتال حين انهزم أصحابك ← يضحك الله إليك","cause":"رجلٌ لَقي العدوَّ وهو على فرسٍ من أمْثَلِ خيلِ أصحابِه فانهزموا ، وثبُت","result":"يضحكُ اللهُ إلى رجلَيْن","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"القول البديع 264","srcLabel":"النسائي","text":["عن ابنِ مسعودٍ رضِي اللهُ عنه ، قال : ",["يضحكُ اللهُ إلى رجلَيْن",2]," ، ",["رجلٌ لَقي العدوَّ وهو على فرسٍ من أمْثَلِ خيلِ أصحابِه فانهزموا ، وثبُت",1]," ، فإن قُتِل استُشهِد ، وإن بَقي فذاك الَّذي يضحكُ اللهُ إليه ، ورجلٌ قام في جوْفِ اللَّيلِ لا يعلمُ به أحدٌ فتوضَّأ فأسبغ الوضوءَ ، ثمَّ حمِد اللهَ ومجَّده ، وصلَّى على النَّبيِّ صلَّى اللهُ عليه وسلَّم ، واستفتح القرآنَ ، فذاك الَّذي يضحكُ اللهُ إليه ، يقولُ : انظُروا إلى عبدي قائمًا لا يراه أحدٌ غيري"],"grade":"صحيح","narrator":"[أبو عبيدة]","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((الكبرى)) (10637) واللفظ له، وابن السني في ((عمل اليوم والليلة)) (صـ688)، وأبو نعيم في ((الحلية)) (4/ 205) بنحوه.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"JIS6fpb9"},{"id":"س-04454","fp":"c56c25fe72cb","stateId":231,"easy":"إذا قُتلت في سبيل الله ← رضي الله عنك ورضيت عنه (من واقعة)","cause":"فعَرَضوا لهم، فقَتَلوهم قَبلَ أن يَبلُغوا المَكانَ","result":"أنَّا قد لَقيناكَ فرَضينا عَنكَ، ورَضيتَ عَنَّا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[62],"ref":"صحيح مسلم 677","srcLabel":"البخاري","text":["جاءَ ناسٌ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم، فقالوا: أنِ ابعَثْ معنا رِجالًا يُعَلِّمونا القُرآنَ والسُّنَّةَ، فبَعَثَ إليهم سَبعينَ رَجُلًا مِنَ الأنصارِ، يُقالُ لهم: القُرَّاءُ، فيهم خالي حَرامٌ، يَقرَؤونَ القُرآنَ، ويَتَدارَسونَ باللَّيلِ يَتَعَلَّمونَ، وكانوا بالنَّهارِ يَجيئونَ بالماءِ فيَضَعونَه في المَسجِدِ، ويَحتَطِبونَ فيَبيعونَه، ويَشتَرونَ به الطَّعامَ لأهلِ الصُّفَّةِ ولِلفُقَراءِ، فبَعَثَهُمُ النَّبيُّ صلَّى اللهُ عليه وسلَّم إليهم، ",["فعَرَضوا لهم، فقَتَلوهم قَبلَ أن يَبلُغوا المَكانَ",1],"، فقالوا: اللَّهُمَّ بَلِّغْ عَنَّا نَبيَّنا ",["أنَّا قد لَقيناكَ فرَضينا عَنكَ، ورَضيتَ عَنَّا",2],"، قال: وأتى رَجُلٌ حَرامًا، خالَ أنَسٍ مِن خَلفِه، فطَعَنَه برُمحٍ حتَّى أنفَذَه، فقال حَرامٌ: فُزتُ ورَبِّ الكَعبةِ! فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم لأصحابِه: إنَّ إخوانَكُم قد قُتِلوا، وإنَّهُم قالوا: اللَّهُمَّ بَلِّغْ عَنَّا نَبيَّنا أنَّا قد لَقيناكَ فرَضينا عَنكَ، ورَضيتَ عَنَّا."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2801)، وأحمد (12402)، وعبد بن حميد في ((المنتخب)) (1276) بنحوه.","bab":"جهاد › فضل الجهاد","dorar":"gVZXSr8W"},{"id":"س-02620","fp":"7d996acb176c","stateId":232,"easy":"إذا آمنت بالله ثم وصلت رحمك ← فهو من أحب الأعمال إلى الله","cause":"الإيمانُ بالله قال : قلتُ : يا رسولَ اللهِ ! ثم مَهْ ؟ قال : ثم صِلَةُ الرَّحِمِ قال : قلتُ : يا رسولَ اللهِ ! ثم مَهْ ؟ قال : ثم الأمرُ بالمعروفِ ، والنهيُ عن المنكرِ","result":"أيُّ الأعمالِ أَحَبُّ إلى اللهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"star":true,"otherNeedIds":[45],"ref":"صحيح الترغيب 2522","srcLabel":"أبو يعلى","text":["أتيتُ النَّبيَّ وهو في نفرٍ من أصحابِه ، فقلتُ : أنت الذي تزعمُ أنك رسولُ اللهِ ؟ قال : نعم قال : قلتُ : يا رسولَ اللهِ ! ",["أيُّ الأعمالِ أَحَبُّ إلى اللهِ",2]," ؟ قال : ",["الإيمانُ بالله قال : قلتُ : يا رسولَ اللهِ ! ثم مَهْ ؟ قال : ثم صِلَةُ الرَّحِمِ قال : قلتُ : يا رسولَ اللهِ ! ثم مَهْ ؟ قال : ثم الأمرُ بالمعروفِ ، والنهيُ عن المنكرِ",1]," قال : قلتُ : يا رسولَ اللهِ ! أيُّ الأعمالِ أبغضُ إلى اللهِ ؟ قال : الإشراكُ باللهِ قال : قلتُ : يا رسولَ اللهِ ! ثم مَهْ ؟ قال : ثم قطيعةُ الرَّحِمِ قال : قلتُ : يا رسولَ اللهِ ! ثم مَه ؟ قال : ثم الأمرُ بالمنكرِ ، والنهيُ عن المعروفِ"],"grade":"صحيح","narrator":"رجل من خثعم","muhaddith":"صحيح","takhrij":"أخرجه أبو يعلى (6839)","bab":"إيمان › الأمر بالإيمان بالله تعالى ورسوله وشرائع الدين","dorar":"MpspMCwp","merged":2,"otherRefs":["صحيح الجامع 166 (حسن)"]},{"id":"س-04344","fp":"b0281fced7aa","stateId":232,"easy":"إذا غرت في الله ← فهي الغيرة التي يحبها الله","cause":"فالغَيرةُ في اللهِ","result":"فأمَّا الغَيرةُ الَّتي يُحِبُّ اللهُ","explicit":true,"star":true,"ref":"إكمال المعلم 6/599","srcLabel":"إكمال المعلم","text":["حديث الرُّخصةِ في الخُيَلاءِ على الكُفارِ أو في الحَربِ.[إنَّ مِن الغَيرةِ ما يُحِبُّ اللهُ ومنها ما يُبغِضُ اللهُ ",["فأمَّا الغَيرةُ الَّتي يُحِبُّ اللهُ",2]," ",["فالغَيرةُ في اللهِ",1]," وأمَّا الغَيرةُ الَّتي يُبغِضُ اللهُ فالغَيرةُ في غيرِ اللهِ وإنَّ مِن الخُيلاءِ ما يُحِبُّ اللهُ ومنها ما يُبغِضُ اللهُ فأمَّا الخُيلاءُ الَّتي يُحِبُّ اللهُ أنْ يتخيَّلَ العبدُ بنفسِه عندَ القتالِ وأنْ يتخيَّلَ عندَ الصَّدقةِ وأمَّا الخُيلاءُ الَّتي يُبغِضُ اللهُ فالخُيلاءُ لغيرِ الدِّينِ]"],"grade":"صحيح","narrator":"[عتيك الأنصاري]","muhaddith":"صحيح","bab":"جهاد › استحباب الخيلاء في الحرب","dorar":"hbPVovb7","merged":5,"otherRefs":["صحيح الجامع 5905 (صحيح)","صحيح ابن حبان 4762 (صحيح)","الأحكام الوسطى 3/ 55 (صحيح)","تخريج المسند لشعيب 23750 (حسن)"]},{"id":"س-03122","fp":"b58a18744be7","stateId":232,"easy":"إذا غرت في موضع الريبة ← يحب الله غيرتك","cause":"الغيرةُ في الرِّيبةِ","result":"يُحبُّها اللَّهُ والغَيرةُ في غيرِ ريبةٍ يبغضُها اللَّهُ","explicit":true,"star":true,"otherNeedIds":[27],"ref":"صحيح ابن خزيمة 4/ 190","srcLabel":"أحمد","text":["غَيرتانِ إحداهُما يحبُّها اللَّهُ، والأُخرَى يبغضُها اللَّهُ: ",["الغيرةُ في الرِّيبةِ ",1],["يُحبُّها اللَّهُ والغَيرةُ في غيرِ ريبةٍ يبغضُها اللَّهُ",2],"، والمَخيلةُ إذا تَصدَّقَ الرَّجلُ يُحبُّها اللَّهُ، والمَخيلةُ في الكبرِ يُبغِضُها اللَّهُ. وقالَ: ثلاثةٌ تستجابُ دعوتُهُمُ، الوالدُ والمُسافرُ والمَظلومُ وقالَ: إنَّ اللَّهَ يدخلُ الجنَّةَ بالسَّهمِ الواحدِ ثلاثةً، صانعَهُ والممدَّ بِهِ، والرَّاميَ بِهِ في سَبيلِ اللَّهِ"],"grade":"صحيح","narrator":"عقبة بن عامر الجهني","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (17398)، والروياني في ((المسند)) (186)، والحاكم (1525) واللفظ لهم.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"CFBRAfYL"},{"id":"س-03167","fp":"1eaf866474d4","stateId":232,"easy":"إذا عدلت بين أولادك حتى في القبل ← يحب الله ذلك","cause":"أن تَعدِلوا بين أولادِكم، حتَّى في القُبَلِ","result":"إنَّ اللهَ تعالى يُحِبُّ","explicit":true,"ref":"التنوير شرح الجامع الصغير 3/390","srcLabel":"الطبراني","text":[["إنَّ اللهَ تعالى يُحِبُّ",2],[" أن تَعدِلوا بين أولادِكم، حتَّى في القُبَلِ",1],"."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"أصله في الصحيح","takhrij":"أخرجه الطبراني (21/ 80) (77)، والدارقطني (2963)، وابن بشكوال في ((غوامض الأسماء المبهمة)) (1/ 489) باختلاف يسير.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"FjZLZAb6"},{"id":"س-05865","fp":"066574cda51d","stateId":232,"easy":"إذا كنت أنفع الناس لعيالك ← تكون أحبهم إلى الله","cause":"أنفعُهم لعيالِهِ","result":"فأحَبُّهم إلى اللهِ","explicit":true,"ref":"شرح كتاب الشهاب 566","srcLabel":"الطبراني","text":["الخلقُ كلُّهم عيالُ اللهِ ",["فأحَبُّهم إلى اللهِ",2]," ",["أنفعُهم لعيالِهِ",1]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"جميع رجال إسناده ثقات","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (5541 )، وأبو نعيم في ((حلية الأولياء )) (2/ 102)، والبيهقي في ((شعب الإيمان)) (7048) بنحوه","bab":"رقائق وزهد › الوصايا النافعة","dorar":"MxsCi3Gu","merged":2,"otherRefs":["صحيح الجامع 172 (حسن)"]},{"id":"س-05797","fp":"9be8d2c9d889","stateId":232,"easy":"إذا تزوجت امرأة ولوداً ← فهي أحب إلى الله من حسناء لا تلد","cause":"امرأةٌ ولودٌ","result":"أحبَّ إلى اللهِ تعالى منِ امرأةٍ حسناءَ لا تلدُ","explicit":true,"otherNeedIds":[39],"ref":"الجامع الصغير 1620","srcLabel":"ابن قانع","text":[["امرأةٌ ولودٌ",1]," ",["أحبَّ إلى اللهِ تعالى منِ امرأةٍ حسناءَ لا تلدُ",2],"،  إني مكاثرٌ بكمُ الأممَ يومَ القيامةِ"],"grade":"حسن","narrator":"حرملة بن النعمان","muhaddith":"حسن","takhrij":"أخرجه ابن قانع كما في ((البدر المنير)) لابن الملقن (7/ 424) بلفظه.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"YxkSORBa"},{"id":"س-05250","fp":"07ea9d6794d3","stateId":232,"easy":"إذا أرضيت والدك ← رضي عنك الرب","cause":"في رِضَا الوالِدِ","result":"رِضَا الرَّبِّ","explicit":true,"star":true,"ref":"تخريج شرح السنة 1/13","srcLabel":"الترمذي","text":[["رِضَا الرَّبِّ",2]," ",["في رِضَا الوالِدِ",1],"، وسَخَطُ الرَّبِّ في سَخَطِ الوالِدِ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي بعد حديث (1899)، والخطيب في ((الجامع)) (1698)، وأخرجه الطبراني (13/494) (14367) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"8f3GCGqQ","merged":4,"otherRefs":["تخريج شرح السنة 3424 (صحيح)","بلوغ المرام 434 (صحيح)","صحيح الجامع 3507 (صحيح)"]},{"id":"س-03844","fp":"67b9466b5f74","stateId":232,"easy":"إذا أطعت والدك ← فهي طاعة لله","cause":"طاعةُ الوالِدِ","result":"طاعةُ اللهِ","explicit":true,"otherNeedIds":[39],"ref":"صحيح الترغيب 2502","srcLabel":"الطبراني","text":[["طاعةُ اللهِ",2]," ",["طاعةُ الوالِدِ",1]," ، ومعصيةُ اللهِ معصيةُ الوالِدِ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن لغيره","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (2255)","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"9xSWwQlH"},{"id":"س-06821","fp":"b0c900d5e4f4","stateId":233,"easy":"إذا أحسنت ← فالله محسن يحب الإحسان","cause":"الإحسانَ","result":"محسنٌ يُحبُّ","explicit":true,"star":true,"similar":["س-03189"],"ref":"صحيح الجامع 1824","srcLabel":"مسلم","text":["إنَّ اللهَ ",["محسنٌ يُحبُّ",2]," ",["الإحسانَ",1]," ، فإذا قتلتُم فأحْسِنوا القتْلةَ ، و إذا ذبحتُم فأحْسِنوا الذبْحَ ، و لْيُحدَّ أحدُكم شفرتَه ، ثم لِيُرحْ ذبيحتَه"],"grade":"صحيح","narrator":"شداد بن أوس","muhaddith":"صحيح","takhrij":"أخرجه عبد الرزاق (8603) واللفظ له، ومسلم (1955)، والترمذي (1409)، والنسائي (4405)، وابن ماجه (3170) باختلاف يسير.","bab":"عقيدة › إثبات أسماء الله","dorar":"VVxdbK90"},{"id":"ق-0072","fp":"ae447958879f","stateId":233,"easy":"الإحسان ← محبة الله","cause":"الإحسان","result":"محبة الله","explicit":true,"star":true,"ref":"سورة البقرة: 195","srcLabel":"القرآن الكريم","quran":{"s":2,"from":195,"to":195,"text":"وَأَنْفِقُوا فِي سَبِيلِ اللَّهِ وَلَا تُلْقُوا بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ وَأَحْسِنُوا إِنَّ اللَّهَ يُحِبُّ الْمُحْسِنِينَ (195)","hl":[[82,131,1]]}},{"id":"ق-1324","fp":"0dc64184bdca","stateId":233,"easy":"البرّ والقسط مع غير المحاربين ← محبة الله","cause":"البرّ والقسط مع غير المحاربين","result":"محبة الله","explicit":true,"star":true,"ref":"سورة الممتحنة: 8","srcLabel":"القرآن الكريم","quran":{"s":60,"from":8,"to":8,"text":"لَا يَنْهَاكُمُ اللَّهُ عَنِ الَّذِينَ لَمْ يُقَاتِلُوكُمْ فِي الدِّينِ وَلَمْ يُخْرِجُوكُمْ مِنْ دِيَارِكُمْ أَنْ تَبَرُّوهُمْ وَتُقْسِطُوا إِلَيْهِمْ إِنَّ اللَّهَ يُحِبُّ الْمُقْسِطِينَ (8)","hl":[[110,188,1]]}},{"id":"س-06819","fp":"16090c5722d9","stateId":233,"easy":"إذا سترت ← فالله ستّير يحب الستر","cause":"السِّترَ","result":"سِتِّيرٌ يُحبُّ","explicit":true,"ref":"تفسير القرآن العظيم 6/90","srcLabel":"أبو داود","text":["عَن ابنِ عبَّاسٍ أن رجُلَين سألاه عَن الاستئذانِ في الثَّلاثِ عوراتِ الَّتي أمرَ اللهُ بها في القُرآنِ فقالَ ابنُ عبَّاسٍ : إنَّ اللهَ ",["سِتِّيرٌ يُحبُّ",2]," ",["السِّترَ",1]," ، كانَ النَّاسُ ليسَ لهم سُتورٌ على أبوابِهم ولا حِجالَ في بُيوتِهم ، فربَّما فاجأَ الرَّجلُ خادمَه أو ولدَه أو يتيمَه في حِجرِه وهوَ علَى أهلِه ، فأمرَهم اللهُ أن يستأذِنوا في تلك العَوراتِ الَّتي سمَّى اللهُ ، ثمَّ جاء اللهُ بعد بالسُّتورِ فبَسَط عليهِم الرِّزقَ فاتخَذوا السُّتورَ واتَّخذوا الحِجالَ ، فرأى النَّاسُ أنَّ ذلكَ قد كَفاهم مِن الاستئذانِ الَّذي أُمروا بهِ"],"grade":"صحيح","narrator":"عكرمة مولى ابن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي حاتم في ((تفسيره)) (14787) واللفظ له، وأبو داود (5192)، وأبو عبيد في ((الناسخ والمنسوخ)) (406) بنحوه.","bab":"عقيدة › إثبات أسماء الله","dorar":"sbWzvOkP","merged":4,"otherRefs":["فتح الباري لابن حجر 11/33 (حسن)","إرواء الغليل 2335 (صحيح)","النظر في أحكام النظر 99 (حسن)"]},{"id":"س-06830","fp":"09cf306d798a","stateId":233,"easy":"إذا كنت سمحاً في البيع والشراء والقضاء ← يحبك الله","cause":"سَمْحَ البَيعِ ، سَمْحَ الشِّراءِ ، سَمْحَ القَضاءِ","result":"إنَّ اللهَ تعالى يُحِبُّ","explicit":true,"ref":"صحيح الجامع 1888","srcLabel":"الترمذي","text":[["إنَّ اللهَ تعالى يُحِبُّ",2],[" سَمْحَ البَيعِ ، سَمْحَ الشِّراءِ ، سَمْحَ القَضاءِ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1319)، وأبو يعلى (6238)، والحاكم (2338)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"jW5YEQ3C","merged":2,"otherRefs":["شرح كتاب الشهاب 564 (حسن)"]},{"id":"س-07150","fp":"4e72d4ac0ab9","stateId":233,"easy":"إذا نفعت الناس ← تكون أحب الناس إلى الله","cause":"أنفَعُ النَّاسِ للنَّاسِ","result":"أحبُّ النَّاسِ إلى اللَّهِ","explicit":true,"similar":["س-01611"],"ref":"تخريج سير أعلام النبلاء 14/ 124","srcLabel":"مسلم","text":["أنَّ رجُلًا أتَى النَّبيَّ صلَّى اللَّهُ عليه وسلَّمَ فقال: مَنْ ",["أحبُّ النَّاسِ إلى اللَّهِ",2],"؟ قال: ",["أنفَعُ النَّاسِ للنَّاسِ",1],"."],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"[فيه] أبو قتادة البدري لم نظفر له بترجمة، وابن أخي الزهري واسمه محمد بن عبد الله ابن مسلم صدوق له أوهام، وباقي رجاله ثقات.\nوله شاهد يتقوى به","takhrij":"أخرجه الذهبي في ((سير أعلام النبلاء)) (14/ 124) واللفظ له.","bab":"علم › حسن السؤال ونصح العالم","dorar":"st3Jbi9g"},{"id":"س-01611","fp":"227f542250cb","stateId":233,"easy":"إذا نفعت الناس ← تكون أحب الناس إلى الله","cause":"أنْفَعُهُمْ لِلنَّاسِ","result":"أحبُّ الناسِ إلى اللهِ","explicit":true,"repOf":"س-07150","ref":"السلسلة الصحيحة 906","text":[["أحبُّ الناسِ إلى اللهِ",2]," ",["أنْفَعُهُمْ لِلنَّاسِ",1],"، وأحبُّ الأعمالِ إلى اللهِ عزَّ وجلَّ سُرُورٌ يدْخِلُهُ على مسلمٍ، أوْ يكْشِفُ عنهُ كُرْبَةً، أوْ يقْضِي عنهُ دَيْنًا، أوْ يَطْرُدُ عنهُ جُوعًا، ولأنْ أَمْشِيَ مع أَخٍ لي في حاجَةٍ أحبُّ إِلَيَّ من أنْ أعْتَكِفَ في هذا المسجدِ -يعني: مسجدَ المدينةِ- شهرًا، و مَنْ كَفَّ غضبَهُ سترَ اللهُ عَوْرَتَهُ، ومَنْ كَظَمَ غَيْظَهُ و لَوْ شاءَ أنْ يُمْضِيَهُ أَمْضَاهُ مَلأَ اللهُ قلبَهُ رَجَاءً يومَ القيامةِ، ومَنْ مَشَى مع أَخِيهِ في حاجَةٍ حتى تتَهَيَّأَ لهُ أَثْبَتَ اللهُ قَدَمَهُ يومَ تَزُولُ الأَقْدَامِ، [و إِنَّ سُوءَ الخُلُقِ يُفْسِدُ العَمَلَ، كما يُفْسِدُ الخَلُّ العَسَلَ]"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6026)، وأبو الشيخ في ((التوبيخ والتنبيه)) (97) باختلاف يسير.","bab":"أطعمة › إطعام الطعام","dorar":"3mmEYTsk"},{"id":"س-01612","fp":"0ef714c5be36","stateId":233,"easy":"إذا أدخلت السرور على مسلم ← فهو من أحب الأعمال إلى الله","cause":"سُرُورٌ يدْخِلُهُ على مسلمٍ","result":"وأحبُّ الأعمالِ إلى اللهِ عزَّ وجلَّ","explicit":true,"ref":"السلسلة الصحيحة 906","srcLabel":"الطبراني","text":["أحبُّ الناسِ إلى اللهِ أنْفَعُهُمْ لِلنَّاسِ، ",["وأحبُّ الأعمالِ إلى اللهِ عزَّ وجلَّ",2]," ",["سُرُورٌ يدْخِلُهُ على مسلمٍ",1],"، أوْ يكْشِفُ عنهُ كُرْبَةً، أوْ يقْضِي عنهُ دَيْنًا، أوْ يَطْرُدُ عنهُ جُوعًا، ولأنْ أَمْشِيَ مع أَخٍ لي في حاجَةٍ أحبُّ إِلَيَّ من أنْ أعْتَكِفَ في هذا المسجدِ -يعني: مسجدَ المدينةِ- شهرًا، و مَنْ كَفَّ غضبَهُ سترَ اللهُ عَوْرَتَهُ، ومَنْ كَظَمَ غَيْظَهُ و لَوْ شاءَ أنْ يُمْضِيَهُ أَمْضَاهُ مَلأَ اللهُ قلبَهُ رَجَاءً يومَ القيامةِ، ومَنْ مَشَى مع أَخِيهِ في حاجَةٍ حتى تتَهَيَّأَ لهُ أَثْبَتَ اللهُ قَدَمَهُ يومَ تَزُولُ الأَقْدَامِ، [و إِنَّ سُوءَ الخُلُقِ يُفْسِدُ العَمَلَ، كما يُفْسِدُ الخَلُّ العَسَلَ]"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6026)، وأبو الشيخ في ((التوبيخ والتنبيه)) (97) باختلاف يسير.","bab":"أطعمة › إطعام الطعام","dorar":"3mmEYTsk"},{"id":"س-02250","fp":"2bd916460555","stateId":233,"easy":"إذا أغثت الملهوف ← يحب الله ذلك","cause":"إغاثةَ اللهفانِ","result":"واللهُ يحبُّ","explicit":true,"ref":"النوافح العطرة 141","srcLabel":"البيهقي","text":["الدالُ على الخيرِ كفاعلِه [يعني حديث: كلُّ معروفٍ صدقةٌ والدالُّ على الخيرِ كفاعلِه ",["واللهُ يحبُّ",2]," ",["إغاثةَ اللهفانِ",1],".]"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (7251 )، وابن عساكر في ((معجم الشيوخ)) (1272)،","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"wTwdLYzv"},{"id":"س-00128","fp":"bbc832667afe","stateId":233,"easy":"إذا لقيت أخاك فسلّمت عليه بوجه بشوش ← تكون أحبكما إلى الله","cause":"إذا التَقى المسلِمانِ فَسلَّمَ أحدُهُما عَلى صاحبِه","result":"كانَ أحبُّهُما إلى اللَّهِ أحسنَهُما بشرًا بصاحبِه","explicit":true,"ref":"الجامع الصغير 485","srcLabel":"البيهقي","text":[["إذا التَقى المسلِمانِ فَسلَّمَ أحدُهُما عَلى صاحبِه",1]," ",["كانَ أحبُّهُما إلى اللَّهِ أحسنَهُما بشرًا بصاحبِه",2]," فإذا تصافَحا أنزلَ اللَّهُ عليهِما مائةَ رحمَةٍ للبادئِ تِسعونَ وللمصافِحِ عشرةٌ"],"grade":"حسن","narrator":"عمر بن الخطاب","muhaddith":"حسن","takhrij":"أخرجه البزار (308)، والبيهقي في ((الشعب)) (7692)، وابن أبي الدنيا في ((مداراه الناس)) (65) باختلاف يسير.","bab":"آداب السلام › إفشاء السلام","dorar":"6pdQN3cF"},{"id":"س-02488","fp":"212a0d2b63b2","stateId":233,"easy":"إذا نصحت لله ← فهو أحب ما يُتعبّد به إليه","cause":"النُّصحُ لي","result":"أحَبُّ ما تعبَّدَّني بهِ عَبدي إليَّ","explicit":true,"ref":"الجامع الصغير 6021","srcLabel":"أحمد","text":["قالَ اللَّهُ تعالى : ",["أحَبُّ ما تعبَّدَّني بهِ عَبدي إليَّ",2]," ",["النُّصحُ لي",1]],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"حسن","takhrij":"أخرجه أحمد (22191)، وابن المبارك في ((الزهد والرقائق)) (204)، والروياني في ((المسند)) (1193)، والبغوي في ((شرح السنة)) (3515) واللفظ لهم.","bab":"إمامة وخلافة › النصح لأئمة المسلمين وولاتهم","dorar":"rg4MmGx3"},{"id":"س-03189","fp":"0086deb19989","stateId":233,"easy":"إذا أحسنت ← فإن الله يحب المحسنين","cause":"وأَصلِحوا وَأَحْسِنُوا","result":"إِنَّ اللَّهَ يُحِبُّ الْمُحْسِنِينَ","explicit":true,"repOf":"س-06821","ref":"تخريج سنن أبي داود 2614","text":["انطلِقوا باسمِ اللهِ، وباللهِ، وعلى مِلَّةِ رسولِ اللهِ، ولا تقتُلوا شيخًا فانيًا، ولا طفلًا، ولا صغيرًا، ولا امرأةً، ولا تغُلُّوا، وضُمُّوا غنائمَكم، ",["وأَصلِحوا {وَأَحْسِنُوا",1]," ",["إِنَّ اللَّهَ يُحِبُّ الْمُحْسِنِينَ",2],"} [البقرة: 195]."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن لغيره","takhrij":"أخرجه أبو داود (2614)، والبيهقي (18153) واللفظ لهما، وابن أبي شيبة (33118)، وتمام في ((فوائد تمام)) (200) بنحوه.","bab":"إيمان › دعوة الكافر إلى الإسلام","dorar":"RDE6kZrF"},{"id":"س-02206","fp":"7b780826f205","stateId":233,"easy":"إذا أصلحت بين الناس إذا تباغضوا ← فهي صدقة يحبها الله ورسوله","cause":"تصلِحُ بين النَّاسِ إذا تباغَضوا وتفاسَدوا","result":"ألا أدلُّك على صدقةٍ يحبُّها اللهُ ورسولُه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[45],"ref":"الترغيب والترهيب 3/406","srcLabel":"الطبراني","text":["قال لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّم يا أبا أيُّوبَ ",["ألا أدلُّك على صدقةٍ يحبُّها اللهُ ورسولُه",2]," ",["تصلِحُ بين النَّاسِ إذا تباغَضوا وتفاسَدوا",1]],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني (4/138) (3922) واللفظ له، وأخرجه الطيالسي (599)، والبيهقي في ((شعب الإيمان)) (10583) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"7DDO8RIM","merged":2,"otherRefs":["الترغيب والترهيب 3/406 (صحيح)"]},{"id":"س-06990","fp":"49c46ab35579","stateId":233,"easy":"إذا أفشيت السلام ← فإنه لله رضا","cause":"أفْشوا السَّلامَ","result":"فإنَّه للهِ تعالى رِضًا","explicit":true,"star":true,"ref":"فيض القدير 2/ 23","srcLabel":"فيض القدير","text":[["أفْشوا السَّلامَ؛ ",1],["فإنَّه للهِ تعالى رِضًا",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"رمز المصنف لحسنه غير مرضي","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"yMLfX0h2"},{"id":"س-05704","fp":"0d151142991c","stateId":234,"easy":"إذا صبرت على أذى جارك حتى يكفيك الله إياه ← تكون ممن يحبهم الله","cause":"رَجلٌ له جارُ سوءٍ يُؤذيهِ، فيَصبِرُ على إيذائهِ حتَّى يَكفيَهُ اللهُ إيَّاهُ؛ إمَّا بحياةٍ أوْ موتٍ","result":"الَّذين يُحِبُّهُم اللهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"star":true,"otherNeedIds":[25],"ref":"المستدرك على الصحيحين 2481","srcLabel":"مسلم","text":["كان يَبلُغُني عنْ أَبي ذَرٍّ حديثٌ، فكنتُ أَشْتَهي لقاءَهُ، فلَقِيتُه، فقلتُ له: يا أَبا ذَرٍّ، كان يَبلُغُني عنكَ حديثٌ، فكنتُ أَشْتَهي لقاءَكَ، قالَ: للهِ أبوكَ، فقد لَقِيتَني، قالَ: قلتُ: حديثٌ بَلَغَني أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ حدَّثَكَ، قالَ: إنَّ اللهَ يُحِبُّ ثلاثةً ويُبغِضُ ثلاثةً؟ قالَ: فلا أَخالُني أَكذِبُ على خَليلي. قالَ: قلتُ: مَنْ هؤلاء ",["الَّذين يُحِبُّهُم اللهُ",2],"؟ قالَ: رَجلٌ غَزا في سبيلِ اللهِ صابِرًا مُحتَسِبًا مُجاهدًا، فلَقِيَ العدوَّ فقاتَلَ حتَّى قُتِلَ، وأنتم تَجِدونَه عندَكُم في كتابِ اللهِ المُنزَّلِ، ثُمَّ قَرَأَ هذه الآيةَ: {إِنَّ اللَّهَ يُحِبُّ الَّذِينَ يُقَاتِلُونَ فِي سَبِيلِهِ صَفًّا كَأَنَّهُم بُنْيَانٌ مَّرْصُوصٌ} [الصف: 4] قلتُ: ومَنْ؟ قالَ: ",["رَجلٌ له جارُ سوءٍ يُؤذيهِ، فيَصبِرُ على إيذائهِ حتَّى يَكفيَهُ اللهُ إيَّاهُ؛ إمَّا بحياةٍ أوْ موتٍ",1],"، قلتُ: ومَنْ؟ قالَ: رَجلٌ يُسافرُ مع قومٍ، فأَدْلَجوا حتَّى إذا كانوا مِن آخِرِ اللَّيلِ، وَقَعَ عليهم الكَرَى والنُّعاسُ، فضَرَبوا رؤوسَهُم، ثُمَّ قامَ فتَطَهَّرَ رَهبةً للهِ ورَغبةً لما عندَهُ، قلتُ: فمَنِ الثَّلاثةُ الَّذين يُبغِضُهُم اللهُ؟ قالَ: المُختالُ الفَخورُ، وأنتم تَجدونَهُ في كتابِ اللهِ المُنزَّلِ: {إِنَّ اللَّهَ لَا يُحِبُّ كُلَّ مُخْتَالٍ فَخُورٍ} [لقمان: 18]، قلتُ: ومَنْ؟ قالَ: البَخيلُ المَنَّانُ، قالَ: ومَنْ؟ قالَ: التَّاجِرُ الحلَّافُ أوِ البائعُ الحلَّافُ."],"grade":"صحيح","narrator":"أبو ذر","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه الترمذي (2568)، والنسائي (2570)، وأحمد (21355)، وابن خزيمة (2456) واللفظ لهم.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"szU2OW1W"},{"id":"س-06174","fp":"d10c2a4ed9db","stateId":234,"easy":"إذا كنت حليماً متأنياً ← يحبك الله","cause":"الحِلمَ والأناةَ","result":"يُحِبُّهما اللهُ","explicit":true,"star":true,"similar":["س-06925","س-06869","س-06173","س-01577"],"ref":"صحيح مسلم 18","srcLabel":"متفق عليه","text":["أنَّ أُناسًا مِن عبدِ القَيسِ قدِموا على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقالوا: يا نَبيَّ اللهِ، إنَّا حَيٌّ مِن رَبيعةَ، وبينَنا وبينَك كُفَّارُ مُضَرَ، ولا نَقدِرُ عليك إلَّا في أشهُرِ الحُرُمِ، فمُرنا بأمرٍ نَأمُرُ به مَن وراءَنا، ونَدخُلُ به الجَنَّةَ إذا نَحنُ أخَذنا به، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: آمُرُكُم بأربَعٍ، وأنهاكُم عن أربَعٍ: اعبُدوا اللهَ ولا تُشرِكوا به شيئًا، وأقيموا الصَّلاةَ، وآتوا الزَّكاةَ، وصوموا رَمَضانَ، وأعطوا الخُمُسَ مِنَ الغَنائِمِ، وأنهاكُم عن أربَعٍ: عَنِ الدُّبَّاءِ، والحَنتَمِ، والمُزَفَّتِ، والنَّقيرِ، قالوا: يا نَبيَّ اللهِ، ما عِلمُك بالنَّقيرِ؟ قال: بَلى، جِذعٌ تَنقُرونَه، فتَقذِفونَ فيه مِنَ القُطَيعاءِ، قال سَعيدٌ: أو قال: مِنَ التَّمرِ، ثُمَّ تَصُبُّونَ فيه مِنَ الماءِ حتَّى إذا سَكَنَ غَلَيانُه شَرِبتُموه، حتَّى إنَّ أحَدَكُم أو إنَّ أحَدَهم لَيَضرِبُ ابنَ عَمِّه بالسَّيفِ، قال: وفي القَومِ رَجُلٌ أصابَتْه جِراحةٌ كَذلك قال، وكُنتُ أخبَؤُها حَياءً مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقُلتُ: ففيمَ نَشرَبُ يا رَسولَ اللهِ؟ قال: في أسقيةِ الأدَمِ التي يُلاثُ على أفواهِها، قالوا: يا رَسولَ اللهِ، إنَّ أرضَنا كَثيرةُ الجِرذانِ، ولا تَبقى بها أسقيةُ الأدَمِ، فقال نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّم: وإن أكَلَتها الجِرذانُ، وإن أكَلَتها الجِرذانُ، وإن أكَلَتها الجِرذانُ، قال: وقال نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّم لأشَجِّ عبدِ القَيسِ: إنَّ فيك لَخَصلَتَينِ ",["يُحِبُّهما اللهُ",2],": ",["الحِلمَ والأناةَ",1],". وذَكَرَ أبا نَضرةَ، عن أبي سَعيدٍ الخُدريِّ، أنَّ وفدَ عبدِ القَيسِ لَمَّا قدِموا على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم... بمِثلِ حَديثِ ابنِ عُلَيَّةَ، غيرَ أنَّ فيه: وتَذيفونَ فيه مِنَ القُطَيعاءِ، أوِ التَّمرِ والماءِ، ولَم يَقُلْ: قال سَعيدٌ، أو قال مِنَ التَّمرِ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"زكاة › فرض الزكاة","dorar":"XHiCn79V","merged":8,"otherRefs":["تخريج شرح الطحاوية 651 (صحيح)","تخريج رياض الصالحين 1/217 (صحيح)","تخريج صحيح ابن حبان 7204 (صحيح)","تخريج صحيح ابن حبان 4541 (صحيح)","المقاصد الحسنة 182 (صحيح)","صحيح الجامع 2136 (صحيح)","در السحابة 420 (صحيح)"]},{"id":"س-06925","fp":"fc072440b8b0","stateId":234,"easy":"إذا كنت حليماً حيياً ← يحبك الله","cause":"الحِلْمُ و الحَياءُ","result":"يحبُّهُما اللهُ","explicit":true,"repOf":"س-06174","ref":"صحيح الأدب المفرد 454","text":["إِنَّ فيكَ لَخُلُقَيْنِ ",["يحبُّهُما اللهُ",2]," قُلْتُ : و ما هُما يا رسولَ اللهِ ؟ قال : ",["الحِلْمُ و الحَياءُ",1]," قُلْتُ : قَدِيمًا كان أوْحديثًا ؟ قال : قَدِيمًا قُلْتُ : الحمدُ للهِ الذي جَبَلَنِي على خُلُقَيْنِ أحبَّهُما اللَّهُ"],"grade":"صحيح","narrator":"أشج عبدالقيس المنذر بن عائذ بن المنذر","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (584) واللفظ له،و ابن شبة في ((تاريخ المدينة)) (2/ 589)، وابن أبي عاصم في ((السنة)) (190)، وابن منده في ((التوحيد)) (55) ثلاثتهم باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"DxcKB8Wn","merged":2,"otherRefs":["تخريج المسند لشعيب 17828 (صحيح)"]},{"id":"س-07388","fp":"3677b92d27a4","stateId":234,"easy":"إذا رفقت في الأمر كله ← يحبك الله","cause":"الرِّفقَ في الأمرِ كُلِّه","result":"إنَّ اللهَ يُحِبُّ","explicit":true,"star":true,"ref":"صحيح البخاري 6024","srcLabel":"متفق عليه","text":["دَخَلَ رَهطٌ مِنَ اليَهودِ على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقالوا: السَّامُ علَيكُم، قالت عائِشةُ: ففَهِمتُها، فقُلتُ: وعليكُمُ السَّامُ واللَّعنةُ، قالت: فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: مَهلًا يا عائِشةُ، ",["إنَّ اللهَ يُحِبُّ",2],[" الرِّفقَ في الأمرِ كُلِّه",1],"، فقُلتُ: يا رَسولَ اللهِ، أولَم تَسمَعْ ما قالوا؟ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: قد قُلتُ: وعلَيكُم"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6024)، ومسلم (2165)","bab":"فضائل النبي وصفته ودلائل النبوة › أخلاق النبي","dorar":"UqMG52nd","merged":2,"otherRefs":["صحيح البخاري 6395 (صحيح)"]},{"id":"س-00210","fp":"59e37c2a5337","stateId":234,"easy":"إذا كنت غنياً حليماً متعففاً ← يحبك الله","cause":"الغَنيَّ الحليمَ المُتَعففَ","result":"إنَّ اللهَ يحبُّ","explicit":true,"star":true,"ref":"صحيح الترغيب 819","srcLabel":"متفق عليه","text":["لا يُؤمنُ عبدٌ حتَّى يأمنَ جارُهُ بوائِقَهُ ، ومنْ كان يُؤمنُ باللهِ واليومِ الآخرِ ؛ فلْيُكرِمْ ضَيفَهُ ، ومنْ كان يُؤمنُ باللهِ واليومِ الآخرِ فلْيقلْ خيرًا أو ليسكُتْ ، ",["إنَّ اللهَ يحبُّ",2]," ",["الغَنيَّ الحليمَ المُتَعففَ",1]," ، ويبغضُ البذيءَ الفاجرَ السَّائلَ الملحَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه البزار (9362) باختلاف يسير، وأخرجه البخاري (6018)، ومسلم (47) بلفظ مقارب دون قوله: \"إن الله يحب الغني ...\"","bab":"آداب المجلس › إكرام الضيف","dorar":"O4X319HX"},{"id":"س-00240","fp":"05b8aefd984d","stateId":234,"easy":"إذا صدقت ← فأحب الحديث إلى الله أصدقه","cause":"أصدَقُه","result":"أَحَبُّ الحديثِ إليَّ","explicit":true,"star":true,"ref":"صحيح الجامع 169","srcLabel":"البخاري","text":[["أَحَبُّ الحديثِ إليَّ",2]," ",["أصدَقُه",1]],"grade":"صحيح","narrator":"المسور بن مخرمة ومروان بن الحكم","muhaddith":"صحيح","takhrij":"أخرجه البخاري (2307، 2308)","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"HrAYe8kl"},{"id":"س-06869","fp":"83fae67c1842","stateId":234,"easy":"إذا كنت حليماً حيياً ← يحبك الله","cause":"الحِلمُ والحياءُ","result":"يحبُّهما اللَّهُ عزَّ وجلَّ","explicit":true,"repOf":"س-06174","ref":"تخريج كتاب السنة 190","text":["إنَّ فيكَ لَخَلَّتينِ ",["يحبُّهما اللَّهُ عزَّ وجلَّ",2]," قالَ قلتُ : وما هما قالَ ",["الحِلمُ والحياءُ",1]," قالَ قُلت قديمًا كانَتا فيَّ أمْ حديثًا ؟ قالَ قديمًا قالَ : الحمدُ للَّهِ الَّذي جَبلَني علَى خَلَّتينِ يحبُّهما اللَّهُ عزَّ وجلَّ"],"grade":"صحيح","narrator":"أشج عبدالقيس المنذر بن عائذ بن المنذر","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (190)، وابن شبة في ((تاريخ المدينة)) (2/ 589) واللفظ لهما، والبخاري في ((الأدب المفرد)) (584)، وابن منده في ((التوحيد)) (55) كلاهما باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"t6XeEiew"},{"id":"س-05074","fp":"bcafd9290d9f","stateId":234,"easy":"إذا حسن خلقك ← تكون أحب الناس إلى الله","cause":"أحسنُهم خُلقًا","result":"أحَبُّ النَّاسِ إلى اللهِ","explicit":true,"star":true,"ref":"تخريج صحيح ابن حبان 486","srcLabel":"مسلم","text":["كنَّا عندَ النَّبيِّ صلَّى اللهُ عليه وسلَّم كأنَّ على رؤوسِنا الرَّخَمَ ما يتكلَّمُ منَّا متكلِّمٌ إذ جاءه ناسٌ مِن الأعرابِ فقالوا: يا رسولَ اللهِ أفْتِنا في كذا أفْتِنا في كذا فقال: ( أيُّها النَّاسُ إنَّ اللهَ قد وضَع عنكم الحرَجَ إلَّا امرأً اقتَرَض مِن عِرْضِ أخيه فذاك الَّذي حرِج وهلَك ) قالوا: أفنتداوى يا رسولَ اللهِ ؟ قال: ( نَعم فإنَّ اللهَ لم يُنزِلْ داءً إلَّا أنزَل له دواءً، غيرَ داءٍ واحدٍ ) قالوا: وما هو يا رسولَ اللهِ ؟ قال: ( الهَرَمُ ) قالوا: فأيُّ النَّاسِ أحَبُّ إلى اللهِ يا رسولَ اللهِ ؟ قال: ( ",["أحَبُّ النَّاسِ إلى اللهِ",2],[" أحسنُهم خُلقًا )",1]],"grade":"صحيح","narrator":"أسامة بن شريك","muhaddith":"إسناده صحيح، على شرط مسلم، غير صحابيه أسامة بن شريك","takhrij":"أخرجه ابن حبان (486)، والحاكم (8214)، والطبراني في ((المعجم الأوسط)) (6380) بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"u5RgGeCN","merged":2,"otherRefs":["مجمع الزوائد 8/27 (صحيح)"]},{"id":"س-06173","fp":"81271d31f578","stateId":234,"easy":"إذا كنت حليماً متأنياً ← يحبك الله","cause":"الحِلمُ، والأَناةُ","result":"يُحِبُّهما اللهُ عزَّ وجلَّ","explicit":true,"repOf":"س-06174","ref":"تخريج المسند لشعيب 11175","text":["أنَّ وفدَ عبدِ القَيسِ لمَّا قَدِموا على رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ قالوا: إنَّا حَيٌّ من رَبيعةَ، وبيْنَنا وبيْنَك كُفَّارُ مُضَرَ، ولسْنا نَستطيعُ أنْ نَأتيَكَ إلَّا في أَشهُرِ الحُرُمِ، فمُرْنا بأمْرٍ إذا نحن أَخَذْنا به دخَلْنا الجَنَّةَ، ونأمُرُ به، أو نَدْعو مَن وَراءَنا، فقال: \"آمُرُكم بأربعٍ، وأَنْهاكم عن أربعٍ: اعبُدوا اللهَ، ولا تُشرِكوا به شيئًا، فهذا ليس منَ الأربعِ، وأَقيموا الصلاةَ، وآتوا الزَّكاةَ، وصوموا رمضانَ، وأَعْطوا منَ الغنائمِ الخُمسَ، وأَنْهاكم عن أربعٍ عنِ الدُّبَّاءِ، والنَّقيرِ، والحَنْتَمِ، والمُزَفَّتِ\"، قالوا: وما عِلمُكَ بالنَّقيرِ؟ قال: \"جِذعٌ يُنقَرُ، ثُم يُلْقونَ فيه منَ القُطْيعاءِ أوِ التَّمْرِ  والماءِ، حتى إذا سكَن غَلَيانُه شرِبْتُموه، حتى إنَّ أَحَدَكم لَيضرِبُ ابنَ عمِّه بالسيْفِ\"، وفي القومِ رجُلٌ أصابَتْه جِراحةٌ من ذلك، فجعَلْتُ أُخبِّئُها حَياءً من رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، قالوا: فما تأمُرُنا أنْ نشرَبَ؟ قال: \"في الأَسْقيةِ التي يُلاثُ على أَفْواهِها\"، قالوا: إنَّ أرضَنا أرضٌ كثيرةُ الجِرْذانِ، لا تَبْقى فيها أَسْقيةُ الأَدَمِ، قال: \"وإنْ أكَلتْه الجِرْذانُ\" مرَّتيْنِ أو ثلاثًا، وقال لأشَجِّ عبدِ القَيسِ: \"إنَّ فيك خَلَّتيْنِ ",["يُحِبُّهما اللهُ عزَّ وجلَّ",2],": ",["الحِلمُ، والأَناةُ",1],"\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (18) باختلاف يسير","bab":"زكاة › فرض الزكاة","dorar":"mfjMCGIW"},{"id":"س-06971","fp":"84090ce36307","stateId":234,"easy":"إذا رفقت ← فالله رفيق يحب الرفق ويعين عليه ما لا يعين على العنف","cause":"الرِّفقَ ويرضاهُ ويعينُ عليهِ ما لا يعينُ على العنفِ فإذا ركبتم هذهِ الدَّوابَّ العجمَ فنزِّلوها منازلَها فإن أجدبتِ الأرضُ فانجوا عليها فإنَّ الأرضَ تطوى باللَّيلِ ما لا تطوى بالنَّهارِ وإيَّاكم والتَّعريسَ بالطَّريقِ فإنَّهُ طريقُ الدَّوابِّ ومأوى","result":"إنَّ اللَّهَ رفيقٌ يحبُّ","explicit":true,"otherNeedIds":[54,1],"ref":"مجمع الزوائد 3/216","srcLabel":"مجمع الزوائد","text":[["إنَّ اللَّهَ رفيقٌ يحبُّ",2],[" الرِّفقَ ويرضاهُ ويعينُ عليهِ ما لا يعينُ على العنفِ فإذا ركبتم هذهِ الدَّوابَّ العجمَ فنزِّلوها منازلَها فإن أجدبتِ الأرضُ فانجوا عليها فإنَّ الأرضَ تطوى باللَّيلِ ما لا تطوى بالنَّهارِ وإيَّاكم والتَّعريسَ بالطَّريقِ فإنَّهُ طريقُ الدَّوابِّ ومأوى",1]," الحيَّات"],"grade":"صحيح","narrator":"معدان والد خالد","muhaddith":"رجاله رجال الصحيح","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"9EYqQ7hi","merged":6,"otherRefs":["صحيح الجامع 7921 (صحيح)","صحيح الجامع 1771 (صحيح)","الاستذكار 7/545 (صحيح)","صحيح الترغيب 2666 (حسن)","صحيح الترغيب 2672 (صحيح)"]},{"id":"ق-0137","fp":"d48a48f142b5","stateId":234,"easy":"الوفاء بالعهد والتقوى ← محبة الله","cause":"الوفاء بالعهد والتقوى","result":"محبة الله","explicit":true,"similar":["ق-0483"],"ref":"سورة آل عمران: 76","srcLabel":"القرآن الكريم","quran":{"s":3,"from":76,"to":76,"text":"بَلَى مَنْ أَوْفَى بِعَهْدِهِ وَاتَّقَى فَإِنَّ اللَّهَ يُحِبُّ الْمُتَّقِينَ (76)","hl":[[6,77,1]]}},{"id":"ق-0291","fp":"d09889d9de1e","stateId":234,"easy":"العفو والصفح ← محبة الله","cause":"العفو والصفح","result":"محبة الله","explicit":true,"ref":"سورة المائدة: 13","srcLabel":"القرآن الكريم","quran":{"s":5,"from":13,"to":13,"text":"فَبِمَا نَقْضِهِمْ مِيثَاقَهُمْ لَعَنَّاهُمْ وَجَعَلْنَا قُلُوبَهُمْ قَاسِيَةً يُحَرِّفُونَ الْكَلِمَ عَنْ مَوَاضِعِهِ وَنَسُوا حَظًّا مِمَّا ذُكِّرُوا بِهِ وَلَا تَزَالُ تَطَّلِعُ عَلَى خَائِنَةٍ مِنْهُمْ إِلَّا قَلِيلًا مِنْهُمْ فَاعْفُ عَنْهُمْ وَاصْفَحْ إِنَّ اللَّهَ يُحِبُّ الْمُحْسِنِينَ (13)","hl":[[231,294,1]]}},{"id":"ق-0483","fp":"6912be966a72","stateId":234,"easy":"الوفاء بالعهد (التقوى) ← محبة الله","cause":"الوفاء بالعهد (التقوى)","result":"محبة الله","explicit":true,"repOf":"ق-0137","ref":"سورة التوبة: 4","quran":{"s":9,"from":4,"to":4,"text":"إِلَّا الَّذِينَ عَاهَدْتُمْ مِنَ الْمُشْرِكِينَ ثُمَّ لَمْ يَنْقُصُوكُمْ شَيْئًا وَلَمْ يُظَاهِرُوا عَلَيْكُمْ أَحَدًا فَأَتِمُّوا إِلَيْهِمْ عَهْدَهُمْ إِلَى مُدَّتِهِمْ إِنَّ اللَّهَ يُحِبُّ الْمُتَّقِينَ (4)","hl":[[120,207,1]]}},{"id":"ق-0484","fp":"3f812e77f9d0","stateId":234,"easy":"الاستقامة على العهد (التقوى) ← محبة الله","cause":"الاستقامة على العهد (التقوى)","result":"محبة الله","explicit":true,"ref":"سورة التوبة: 7","srcLabel":"القرآن الكريم","quran":{"s":9,"from":7,"to":7,"text":"كَيْفَ يَكُونُ لِلْمُشْرِكِينَ عَهْدٌ عِنْدَ اللَّهِ وَعِنْدَ رَسُولِهِ إِلَّا الَّذِينَ عَاهَدْتُمْ عِنْدَ الْمَسْجِدِ الْحَرَامِ فَمَا اسْتَقَامُوا لَكُمْ فَاسْتَقِيمُوا لَهُمْ إِنَّ اللَّهَ يُحِبُّ الْمُتَّقِينَ (7)","hl":[[131,214,1]]}},{"id":"س-01577","fp":"3a99123cfca7","stateId":234,"easy":"إذا كنت حليماً متأنياً ← يحبك الله ورسوله","cause":"الأناةُ والحِلْمُ","result":"يُحِبُّهما اللهُ ورسولُه","explicit":true,"repOf":"س-06174","ref":"صحيح ابن حبان 7203","text":["أنَّه أتى النَّبيَّ صلَّى اللهُ عليه وسلَّم في رُفقةٍ مِن عبدِ القَيْسِ لِيزورَه فأقبَلوا فلمَّا قدِموا رفَع لهم النَّبيُّ صلَّى اللهُ عليه وسلَّم فأناخوا رِكابَهم فابتدَر القومُ ولَمْ يلبَسوا إلَّا ثيابَ سفَرِهم وأقام العَصَريُّ فعقَل رَكائبَ أصحابِه وبعيرَه ثمَّ أخرَج ثيابَه مِن عَيْبَتِه وذلكَ بعينِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم ثمَّ أقبَل إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم فسلَّم عليه فقال له النَّبيُّ صلَّى اللهُ عليه وسلَّم : ( إنَّ فيكَ لَخَصْلتَيْنِ ",["يُحِبُّهما اللهُ ورسولُه",2]," ) قال : ما هما ؟ قال : ( ",["الأناةُ والحِلْمُ",1]," ) قال : شيءٌ جُبِلْتُ عليه أو شيءٌ أتخلَّقُه ؟ قال : ( لا بل جُبِلْتَ عليه ) قال : الحمدُ للهِ ثمَّ قال صلَّى اللهُ عليه وسلَّم : ( معشَرَ عبدِ القَيْسِ ما لي أرى وجوهَكم قد تغيَّرَتْ ) قالوا : يا نَبيَّ اللهِ نحنُ بأرضٍ وَخِمةٍ كنَّا نتَّخِذُ مِن هذه الأنبذةِ ما يقطَعُ اللُّحمانَ في بطونِنا فلمَّا نُهِينا عنِ الظُّروفِ فذلكَ الَّذي ترى في وجوهِنا فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم : ( إنَّ الظُّروفَ لا تُحِلُّ ولا تُحرِّمُ ولكنْ كُلُّ مُسكِرٍ حرامٌ وليس أنْ تحبِسوا فتشرَبوا حتَّى إذا امتلَأَتِ العروقُ تناحَرْتُم فوثَب الرَّجُلُ على ابنِ عمِّه فضرَبه بالسَّيفِ فترَكه أعرَجَ ) قال : وهو يومَئذٍ في القومِ الأعرجُ الَّذي أصابه ذلكَ"],"grade":"صحيح","narrator":"الأشج العصري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو يعلى (6849) بلفظه، والبغوي في ((معجم الصحابة)) (149) بنحوه مختصرا.","bab":"أشربة › ما يحل من الأشربة","dorar":"mksORDsw","merged":4,"otherRefs":["تخريج شرح الطحاوية 651 (صحيح)","تخريج رياض الصالحين 1/217 (صحيح)","مجمع الزوائد 9/390 (صحيح)"]},{"id":"س-06867","fp":"e0e3549bce32","stateId":234,"easy":"إذا كنت كريماً جواداً ذا أخلاق عالية ← يحبك الله ويكره سفاسف الأخلاق","cause":"الكُرَماءَ ، جوادٌ يُحبُّ الجَوَدَةَ ، يُحبُّ معاليَ الأخلاقِ ، و يكرَهُ سَفْسافَها","result":"إنَّ اللهَ كريمٌ يُحبُّ","explicit":true,"ref":"صحيح الجامع 1800","srcLabel":"الترمذي","text":[["إنَّ اللهَ كريمٌ يُحبُّ",2],[" الكُرَماءَ ، جوادٌ يُحبُّ الجَوَدَةَ ، يُحبُّ معاليَ الأخلاقِ ، و يكرَهُ سَفْسافَها",1]],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي الدنيا في ((مكارم الأخلاق)) (8) واللفظ له، والترمذي (2799)، والبزار (1114)، وأبو يعلى (790) بنحوه مطولا.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"cdiGip7B","merged":3,"otherRefs":["التنوير شرح الجامع الصغير 3/329 (صحيح)","صحيح الجامع 1743 (صحيح)"]},{"id":"س-06899","fp":"a97f3f36a20c","stateId":234,"easy":"إذا طلبت معالي الأمور وأشرافها ← يحبك الله ويكره سفسافها","cause":"مَعاليَ الأُمورِ ، و أَشرافَها ، و يَكرَهُ سَفْسافَها","result":"إنَّ اللهَ تعالى يُحِبُّ","explicit":true,"ref":"صحيح الجامع 1890","srcLabel":"الطبراني","text":[["إنَّ اللهَ تعالى يُحِبُّ",2],[" مَعاليَ الأُمورِ ، و أَشرافَها ، و يَكرَهُ سَفْسافَها",1]],"grade":"صحيح","narrator":"الحسين بن علي بن أبي طالب","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (3/ 131) (2894)، والقضاعي في ((مسند الشهاب)) (1076)، وابن عدي في ((الكامل في الضعفاء)) (3/ 6) واللفظ لهم، والخطيب في ((الجامع لأخلاق الراوي)) (39) باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"jeAM4iwa","merged":3,"otherRefs":["صفة الفتوى 93 (صحيح)","تخريج الإحياء للعراقي 2/439 (حسن)"]},{"id":"س-07376","fp":"7bb26f242b21","stateId":234,"easy":"إذا عفوت ← فالله عفو يحب العفو","cause":"العفْوَ","result":"عفوٌّ يُحِبُّ","explicit":true,"ref":"المستدرك على الصحيحين 8367","srcLabel":"أحمد","text":["سَمِعتُ أبا ماجدةَ يَقولُ: كُنتُ قاعدًا مع عبدِ اللهِ بنِ مَسعودٍ رَضيَ اللهُ عنه، فقال: إنِّي لا أذْكُرُ أوَّلَ رجُلٍ قَطَعَه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ؛ أُتِيَ بسارقٍ، فأمَرَ بقَطعِه، فكأنَّما أُسِفَ وجْهُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فقالوا: يا رَسولَ اللهِ، كأنَّك كَرِهْتَ قَطْعَه، قال: وما يَمنَعُني، لا تَكونوا أعوانًا للشَّيطانِ على أخِيكم؛ إنَّه لا يَنْبغي للإمامِ إذا انْتَهى إليه حدٌّ إلَّا أنْ يُقِيمَه، إنَّ اللهَ ",["عفوٌّ يُحِبُّ",2]," ",["العفْوَ",1],"، {وَلْيَعْفُوا وَلْيَصْفَحُوا أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللَّهُ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ} [النور: 22]."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح الإسناد ولم يخرجاه","takhrij":"أخرجه أحمد (3977)، وابن أبي حاتم في ((التفسير)) (14279)، والطبراني في ((الأوائل)) (33) جميعهم بلفظ مقارب.","bab":"فضائل النبي وصفته ودلائل النبوة › أحوال النبي","dorar":"FT5MdKJd","merged":2,"otherRefs":["الجامع الصغير 1743 (صحيح)"]},{"id":"س-07532","fp":"cad6b500e94e","stateId":234,"easy":"إذا أديت الأمانة وصدقت وأحسنت الجوار ← يحبك الله ورسوله","cause":"فأدُّوا إذا ائتُمِنتم ، واصدُقوا إذا حدَّثتم ، وأحسِنوا جِوارَ من جاوركم","result":"فإن أحببتم أن يُحِبَّكم اللهُ ورسولُه","explicit":true,"similar":["س-02044"],"ref":"الترغيب والترهيب 4/50","srcLabel":"الطبراني","text":["كنَّا عند النَّبيِّ صلَّى اللهُ عليه وسلَّم فدعا بطَهورٍ ، فغمَس يدَه فتوضَّأ فتتبَّعناه فحسوْناه فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم : ما حملكم على ما فعلتم ؟ قلنا : حبُّ اللهِ ورسولُه قال : ",["فإن أحببتم أن يُحِبَّكم اللهُ ورسولُه ، ",2],["فأدُّوا إذا ائتُمِنتم ، واصدُقوا إذا حدَّثتم ، وأحسِنوا جِوارَ من جاوركم",1]],"grade":"صحيح","narrator":"عبدالرحمن بن أبي قراد","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن أبي عاصم في ((الآحاد والمثاني)) (1397)، والطبراني في ((المعجم الأوسط)) (6517)، وأبو نعيم في ((معرفة الصحابة)) (6963) جميعا بلفظه .","bab":"فضائل النبي وصفته ودلائل النبوة › بركة النبي","dorar":"Pg6ULqzc","merged":2,"otherRefs":["هداية الرواة 4920 (حسن)"]},{"id":"س-03105","fp":"efb3a0cfd099","stateId":234,"easy":"إذا تواضعت في لباسك ← يحبك الله","cause":"المؤمنَ المبتذلَ، الذي لا يُبالي ما يلبَسُ","result":"إنَّ اللهَ تعالى يحبُّ","explicit":true,"ref":"الجامع الصغير 1866","srcLabel":"البيهقي","text":[["إنَّ اللهَ تعالى يحبُّ",2],[" المؤمنَ المبتذلَ، الذي لا يُبالي ما يلبَسُ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (6176)، والديلمي في ((الفردوس)) (568) باختلاف يسير","bab":"إيمان › توحيد الأسماء والصفات","dorar":"0KK4jq9J"},{"id":"س-05430","fp":"f472093c40f0","stateId":234,"easy":"إذا كنت حيياً عفيفاً متعففاً ← يحبك الله","cause":"الحييَّ العفيفَ المتعفِّفَ","result":"ويحبُّ","explicit":true,"ref":"صحيح الجامع 1711","srcLabel":"أحمد","text":["إنَّ اللهَ تعالى إذا أنعَم على عبدٍ نعمةً ، يحبُّ أن يرى أثرَ النِّعمةِ عليه ، ويكره البُؤسَ والتَّباؤسَ ، ويُبغِضُ السائلَ الملْحِفَ ، ",["ويحبُّ",2]," ",["الحييَّ العفيفَ المتعفِّفَ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الإسماعيلي في ((معجم شيوخه)) (224) واللفظ له، وأحمد (8107)، والبيهقي في ((شعب الإيمان)) (6202) باختلاف يسير","bab":"رقائق وزهد › الحياء","dorar":"eZAqAcuc"},{"id":"س-06863","fp":"54da6a3362f8","stateId":234,"easy":"إذا حلفت فاحلف بالله وبرّ واصدق ← فإن الله يحب أن يُحلف به","cause":"احلِفوا بالله و بَرُّوا و اصدُقوا","result":"فإنَّ اللهَ يحبُّ أن يُحلَفَ به","explicit":true,"ref":"صحيح الجامع 211","srcLabel":"الجرجاني","text":[["احلِفوا بالله و بَرُّوا و اصدُقوا ، ",1],["فإنَّ اللهَ يحبُّ أن يُحلَفَ به",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الجرجاني في ((تاريخ جرجان)) (599)، وأبو نعيم في ((حلية الأولياء)) (7/267) واللفظ له، والديلمي في ((الفردوس)) (333)، من حديث ابن عمر.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"pKUaYnQi"},{"id":"س-01764","fp":"be97fe51affa","stateId":234,"easy":"إذا تخلّقت بمكارم الأخلاق ← يحبك الله","cause":"كان يحبُّ مكارمَ الأخلاقِ","result":"واللهُ يحبُّ مكارمَ الأخلاقِ","explicit":true,"ref":"البداية والنهاية 5/61","srcLabel":"البيهقي","text":["عن عليِّ بنِ أبي طالبٍ قال يا سبحانَ اللهِ ما أزهد كثيرًا من الناسِ في خيرٍ عجبًا لرجلٍ يجيئُه أخوه المسلمُ في الحاجةِ فلا يرى نفسَه للخيرِ أهلًا فلو كان لا يرجو ثوابًا ولا يخشى عقابًا لكان ينبغي له أن يسارعَ في مكارمِ الأخلاقِ فإنها تدل على سبيلِ النجاحِ فقام إليه رجلٌ فقال فداك أبي وأمي يا أميرَ المؤمنين سمعتُه من رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ قال نعم وما هو خيرٌ منه لما أتى بسبايا طيِّءٍ وقفتْ جاريةٌ حمراءُ لعساءُ دلفاءُ عيطاءُ شماءُ الأنفِ معتدلةُ القامةِ والهامةِ درماءُ الكعبَينِ خدلَّةُ الساقَينِ لفَّاءُ الفخِذَينِ خميصةُ الخَصرَينِ ضامرةُ الكشحَينِ مصقولةُ المتْنَينِ قال فلما رأيتُها أعجبتُ بها وقلتُ لأطلبنَّ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يجعلها في فَيْئي فلما تكلمتْ أنسيتُ جمالَها من فصاحتِها فقالت يا محمدُ إن رأيتَ أن تُخلِّيَ عنا ولا تُشمِتْ بنا أحياءَ العربِ فإني ابنةُ سيِّدُ قومي وإنَّ أبي كان يحمي الذِّمارَ ويفكُّ العاني ويشبعُ الجائعَ ويكسو العاريَ ويَقري الضيفَ ويطعمُ الطعامَ ويفشِ السلامَ ولم يردَّ طالبَ حاجةٍ قطُّ أنا ابنةُ حاتمِ طيءٍ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يا جاريةُ هذه صفة المؤمنين حقًّا لو كان أبوك مسلمًا لترحَّمْنا عليه خلُّوا عنها فإنَّ أباها ",["كان يحبُّ مكارمَ الأخلاقِ",1]," ",["واللهُ يحبُّ مكارمَ الأخلاقِ",2]," فقام أبو بردةَ بنُ نيارٍ فقال يا رسولَ اللهِ تحبُّ مكارمَ الأخلاقِ فقال رسولُ اللهِ والذي نفسي بيده لا يدخلُ أحدٌ الجنةَ إلا بحُسنِ الخُلُقِ"],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"حسن المتن غريب الإسناد جدا عزيز المخرج","takhrij":"أخرجه البيهقي في ((دلائل النبوة)) (5/ 341)، وابن عساكر في ((تاريخ دمشق)) (69/ 202) كلاهما بلفظه، وابن حجر في ((تخريج أحاديث المختصر)) (1/ 197) بنحوه.","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"6JaYGGt1"},{"id":"س-02044","fp":"c79c1fc09cbe","stateId":234,"easy":"إذا صدقت في الحديث وأديت الأمانة وأحسنت الجوار ← يحبك الله ورسوله","cause":"فَحافِظُوا على ثلاثِ خِصالٍ : صِدْقِ الحَدِيثِ ، و أَدَاءِ الأَمانَةِ ، و حُسْنِ الجِوَارِ","result":"إنْ كنتُمْ تُحِبُّونَ أنْ يُحِبَّكُمُ اللهُ و رسولُهُ","explicit":true,"repOf":"س-07532","ref":"السلسلة الصحيحة 2998","text":[["إنْ كنتُمْ تُحِبُّونَ أنْ يُحِبَّكُمُ اللهُ و رسولُهُ",2]," ",["فَحافِظُوا على ثلاثِ خِصالٍ : صِدْقِ الحَدِيثِ ، و أَدَاءِ الأَمانَةِ ، و حُسْنِ الجِوَارِ",1]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن بجموع الطرق","takhrij":"لم نقف عليه إلا عند الألباني في ((السلسلة الصحيحة)) (2998) وعزاه للخلعي في ((فوائده)).","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"B7x5Zl6y"},{"id":"س-05405","fp":"702a701fd6e5","stateId":234,"easy":"إذا أحبك الناس (بخلقك) ← تكون أحب الناس إلى الله","cause":"أحَبُّكم إلى النَّاسِ","result":"إنَّ أحَبَّكم إلى اللهِ","explicit":true,"otherNeedIds":[41],"ref":"المعجم الأوسط 6/136","srcLabel":"أحمد","text":["ألَا أُخبِرُكم بأحَبِّكم إلى اللهِ قُلْنا بلى يا رسولَ اللهِ وظنَنَّا أنَّه يُسمِّي رجُلًا فقال ",["إنَّ أحَبَّكم إلى اللهِ",2]," ",["أحَبُّكم إلى النَّاسِ",1]," ثمَّ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ألَا أُخبِرُكم بأبغَضِكم إلى اللهِ قُلْنا بلى يا رسولَ اللهِ فظنَنَّا أنَّه يُسمِّي رجُلًا فقال إنَّ أبغَضَكم إلى اللهِ أبغَضُكم إلى النَّاسِ"],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"لا يروى هذا الحديث عن أبي سعيد إلا بهذا الإسناد تفرد به بن المبارك ولم يروه عن بن المبارك إلا علي بن الحسن بن شقيق حدثنا بهذا الحديث قال محمد بن الحسن بن شقيق حدثت بهذا الحديث أحمد بن حنبل فاستحسنه","takhrij":"أخرجه ابن أبي الدنيا في ((الأولياء)) (34) بلفظه، وابن المرزبان في ((ذم الثقلاء)) (15) بلفظه دون شطره:(( ألا أخبركم بأحبكم إلى الله...)).","bab":"رقائق وزهد › الحب في الله","dorar":"2aqRaHL0"},{"id":"س-05681","fp":"7d1b7727c70d","stateId":234,"easy":"إذا رضيت بالبلاء ← فلك الرضا من الله","cause":"فمن رضِي","result":"فله الرِّضا","explicit":true,"star":true,"otherNeedIds":[9],"ref":"الترغيب والترهيب 4/223","srcLabel":"الترمذي","text":["إنَّ عِظَمَ الجزاءِ مع عِظَمِ البلاءِ ، وإنَّ اللهَ تعالَى إذا أحبَّ قومًا ابتلاهم ، ",["فمن رضِي ",1],["فله الرِّضا ",2],"ومن سخِط فله السُّخطُ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي بعد حديث (2396)، وابن ماجه (4031)","bab":"رقائق وزهد › الصبر على البلاء","dorar":"6JAtSMug"},{"id":"س-06826","fp":"ddcf77586752","stateId":234,"easy":"إذا يسّرت ← فقد رضي الله اليسر لهذه الأمة","cause":"اليُسْرَ","result":"رضيَ لهذه الأُمَّةِ","explicit":true,"star":true,"ref":"السلسلة الصحيحة 1635","srcLabel":"البخاري","text":["إنَّ اللهَ ",["رضيَ لهذه الأُمَّةِ",2]," ",["اليُسْرَ",1]," ، و كرِهَ لهم العُسْرَ ، قالها ثلاثَ مراتٍ ، و إنَّ هذا أخذ بالعُسْرِ ، و ترك اليُسْرَ"],"grade":"صحيح","narrator":"محجن بن الأدرع","muhaddith":"إسناده صحيح رجاله ثقات","takhrij":"أخرجه الواحدي في ((الوسيط)) (85) واللفظ له وزيادة، وأحمد (18976) والبخاري في ((الأدب المفرد)) (341) بنحوه مطولا","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"u37fsU2W"},{"id":"س-06122","fp":"cbe1e0a0440c","stateId":234,"easy":"إذا تكلمت بكلمة من رضوان الله ← يكتب الله لك بها رضوانه إلى يوم القيامة","cause":"ليتَكَلَّمُ بالكلِمةِ من رضوانِ اللَّهِ ما يظنُّ أن تبلُغَ ما بلغت","result":"يَكْتبُ اللَّهُ عزَّ وجلَّ لَه بِها رِضوانَهُ إلى يومِ القيامةِ","explicit":true,"similar":["س-00204","س-06118"],"otherNeedIds":[47],"ref":"صحيح ابن ماجه 3220","srcLabel":"الترمذي","text":["مرَّ بهِ رجلٌ لَه شرَفٌ فقالَ لَه علقَمةُ إنَّ لَكَ رحِمًا وإنَّ لَكَ حقًّا وإنِّي رأيتُكَ تدخُلُ علَى هؤلاءِ الأمراءِ وتتَكَلَّمُ عندَهُم بما شاءَ اللَّهُ أن تتَكَلَّمَ بهِ وإنِّي سمِعتُ بلالَ بنَ الحارثِ المزَنيَّ صاحبَ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ إنَّ أحدَكُم ",["ليتَكَلَّمُ بالكلِمةِ من رضوانِ اللَّهِ ما يظنُّ أن تبلُغَ ما بلغت",1]," ف",["يَكْتبُ اللَّهُ عزَّ وجلَّ لَه بِها رِضوانَهُ إلى يومِ القيامةِ",2]," وإنَّ أحدَكُم ليتَكَلَّمُ بالكلِمةِ من سَخَطِ اللَّهِ ما يَظنُّ أن تبلُغَ ما بلغت فيَكْتبُ اللَّهُ عزَّ وجلَّ عليهِ بِها سَخطَهُ إلى يومِ يلقاهُ قالَ عَلقَمَةُ فانظُرْ ويحَكَ ماذا تَقولُ وماذا تَكَلَّمُ بهِ فرُبَّ كلامٍ قد منعَني أن أتَكَلَّمَ بهِ ما سمِعتُ من بلالِ بنِ الحارثِ"],"grade":"صحيح","narrator":"بلال بن الحارث المزني.","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2319)، وابن ماجة (3969)، والحاكم (136) واللفظ لهم.","bab":"رقائق وزهد › من أرضى الناس بسخط الله","dorar":"LoykDRa9","merged":3,"otherRefs":["صحيح البخاري 6478 (صحيح)","تخريج المسند لشعيب 15852 (صحيح)"]},{"id":"س-00204","fp":"e110f68a9b92","stateId":234,"easy":"إذا تكلمت بكلمة من رضوان الله ولو لم تلقِ لها بالاً ← يرضى الله عنك بها إلى يوم تلقاه","cause":"إنَّ العَبْدَ ليَتَكَلَّمُ بالكَلِمَةِ مِنْ رِضْوانِ اللهِ، ما يَظُنُّ أَنْ تَبْلُغَ ما بَلَغَتْ","result":"فيَرْضَى اللهُ بها عنه إلى يوْمِ يَلْقاهُ","explicit":true,"repOf":"س-06122","ref":"المستدرك على الصحيحين 137","text":["عنْ عَلْقَمةَ بنِ وَقَّاصٍ قالَ: كان رَجُلٌ بَطَّالٌ يدْخُلُ على الأُمَراءِ فَيُضْحِكُهُمْ، فقالَ لهُ جدِّي: وَيْحَكَ يا فُلانُ، لِمَ تدْخُلُ على هؤلاء وتُضْحِكُهُمْ؟ فإني سَمِعْتُ بلالَ بنَ الحارثِ المُزَنِيَّ صاحِبَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يُحدِّثُ أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قالَ: «",["إنَّ العَبْدَ ليَتَكَلَّمُ بالكَلِمَةِ مِنْ رِضْوانِ اللهِ، ما يَظُنُّ أَنْ تَبْلُغَ ما بَلَغَتْ",1],"، ",["فيَرْضَى اللهُ بها عنه إلى يوْمِ يَلْقاهُ",2],"، وإنَّ العَبْدَ ليَتَكَلَّمُ بِالكَلِمةِ مِنْ سَخَطِ اللهِ، ما يَظُنُّ أنْ تَبْلُغَ ما بَلَغَتْ، فيَسْخَطُ اللهُ بها إلى يَوْمِ يَلْقاهُ»."],"grade":"صحيح","narrator":"بلال بن الحارث المزني","muhaddith":"صحيح","bab":"آداب الكلام › المزاح والمداعبة","dorar":"UlpYjYwQ"},{"id":"س-06118","fp":"78da54389084","stateId":234,"easy":"إذا تكلمت بكلمة خير ← يكتب الله لك بها رضوانه إلى يوم تلقاه","cause":"إنَّ الرَّجُلَ لَيَتكلَّمُ بالكَلِمةِ مِن الخَيْرِ ما يَعلَمُ مَبلَغَها","result":"يَكتُبُ اللهُ له رِضوانَه إلى يَوْمِ يَلْقاه","explicit":true,"repOf":"س-06122","ref":"الصحيح المسند 183","text":["أنَّ بِلالَ بنَ الحارِثِ المُزَنيَّ قالَ له: إنِّي رَأيْتُك تَدخُلُ على هؤلاء الأُمَراءِ وتَغْشاهم، فانْظُرْ ماذا تُحاضِرُهم به؛ فإنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ يقولُ: «",["إنَّ الرَّجُلَ لَيَتكلَّمُ بالكَلِمةِ مِن الخَيْرِ ما يَعلَمُ مَبلَغَها",1],"، ",["يَكتُبُ اللهُ له رِضوانَه إلى يَوْمِ يَلْقاه",2],"، وإنَّ الرَّجُلَ لَيَتكلَّمُ بالكَلِمةِ مِن الشَّرِّ ما يَعلَمُ مَبلَغَها، يَكتُبُ اللهُ عليه بِها سَخَطَه إلى يَوْمِ يَلْقاه»، وكانَ عَلْقمةُ يقولُ: رُبَّ حَديثٍ قد حالَ بَيْني وبَيْنَه ما سَمِعْتُ مِن بِلالٍ."],"grade":"صحيح","narrator":"بلال بن الحارث","muhaddith":"صحيح على شرط الشَّيْخين","bab":"رقائق وزهد › من أرضى الناس بسخط الله","dorar":"0boLB4EF"},{"id":"س-06872","fp":"2d0bb6dae7d2","stateId":234,"easy":"إذا لم تغضب ← تتباعد عن غضب الله","cause":"لا تَغضَبْ","result":"ماذا يُباعِدُني مِن غَضَبِ اللهِ عزَّ وجَلَّ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[8],"ref":"تخريج المسند لشاكر 10/124","srcLabel":"أحمد","text":["عن عبدِ اللهِ بنِ عَمرٍو أنَّه سأَل رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ",["ماذا يُباعِدُني مِن غَضَبِ اللهِ عزَّ وجَلَّ",2]," قال ",["لا تَغضَبْ",1]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6635) بلفظه، وابن حبان (296) بلفظ مقارب .","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"AjGh52Pm","merged":2,"otherRefs":["صحيح الموارد 1655 (حسن)"]},{"id":"س-08439","fp":"a88dc982456e","stateId":235,"easy":"إذا تحاببت وتواصلت وتزاورت في الله ← حقّت لك محبة الله","cause":"للمُتحابِّينَ فيَّ، وحقَّتْ للمُتواصِلينَ فيَّ، وحقَّتْ محبَّتي للمُتزاوِرينَ فيَّ، وحقَّتْ محبَّتي للمُتباذِلينَ فيَّ","result":"حَقَّتْ مَحَبَّتِي","explicit":true,"star":true,"similar":["س-05394"],"ref":"تخريج مشكل الآثار 3892","srcLabel":"أحمد","text":["دخَلتُ مسجدَ حِمْصَ فقعَدْتُ في حَلْقةٍ فيها نيِّفٌ وثلاثونَ مِن أصحابِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، منهم يقولُ: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ كذا وكذا، ويُنصِتُ الآخَرونَ، ويقولُ الرجلُ منهم: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ كذا، ويُنصِتُ الآخَرونَ، وفيهم فتًى أَدْعَجُ بَرَّاقُ الثَّنَايَا، إذا اختلَفوا في شيءٍ انتهَوْا إلى قولِه، فلمَّا انصرَفتُ إلى منزلي بِتُّ بأطوَلِ ليلةٍ، فقلتُ: جلَستُ في حلْقةٍ فيها كذا وكذا مِن أصحابِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، لا أعرِفُ مَنازِلَهم ولا أسماءَهم! فلمَّا أصبحتُ غَدَوْتُ إلى المسجدِ، فإذا الفتى الأدعَجُ قاعدٌ إلى ساريَةٍ، فجلَستُ إليه، فقلتُ: إنِّي لَأُحِبُّكَ للهِ عزَّ وجلَّ، قال: آللهِ، إنَّك لَتُحِبُّني للهِ تبارَكَ وتعالى؟ فقلتُ: آللهِ، إنِّي لأُحِبُّك للهِ عزَّ وجلَّ، فأخَذَ بحُبْوَتِي حتى مَسَّتْ رُكبتِي رُكبتَه، ثمَّ قال: آللهِ، إنَّك لَتُحبُّني للهِ عزَّ وجلَّ؟ فقلتُ: آللهِ، إنِّي لأُحبُّك للهِ عزَّ وجلَّ، فقال: أفلا أُخبِرُك بشيءٍ سمعتُه مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ فقلتُ: بلى، فقال: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: المُتحابُّونَ في اللهِ عزَّ وجلَّ يُظِلُّهم اللهُ عزَّ وجلَّ بظِلِّ عرشِه يومَ لا ظِلَّ إلَّا ظِلُّه، قال: فبَيْنا نحن كذلك إذ مَرَّ رجلٌ ممَّن كان في الحلْقةِ، فقُمتُ إليه فقلتُ: إنَّ هذا حدَّثَني بحديثٍ عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فهل سمعتَه منه؟ قال: وما حدَّثَك؟ ما كان لِيُحدِّثَك إلَّا حقًّا، قال: فأخبَرتُه، فقال: سَمِعتُ هذا مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وما هو أفضَلُ منه، سمعتُه يقولُ يَأْثُرُ عن اللهِ عزَّ وجلَّ: ",["حَقَّتْ مَحَبَّتِي",2]," ",["للمُتحابِّينَ فيَّ، وحقَّتْ للمُتواصِلينَ فيَّ، وحقَّتْ محبَّتي للمُتزاوِرينَ فيَّ، وحقَّتْ محبَّتي للمُتباذِلينَ فيَّ",1],"، قُلتُ: مَن أنت يَرحَمُك اللهُ؟ قال: أنا عُبادةُ بنُ الصامتِ، قُلتُ: فمَن الفتى؟ قال: معاذُ بنُ جبلٍ."],"grade":"صحيح","narrator":"معاذ بن جبل وعبادة بن الصامت","muhaddith":"إسناده صحيح على شرطهما","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (3892) واللفظ له، وأحمد (22782)، والطبراني في ((الشاميين)) (625) بنحوه.","bab":"مناقب وفضائل › معاذ بن جبل","dorar":"u6v81otP","merged":8,"otherRefs":["تخريج المسند لشعيب 22131 (صحيح)","المستدرك على الصحيحين 7521 (صحيح)","الأحاديث المختارة 8 / 312 (صحيح)","تخريج رياض الصالحين 382 (صحيح)","فتاوى نور على الدرب لابن باز 2/199 (صحيح)","هداية الرواة 4939 (صحيح)","الأحاديث المختارة 8 / 306 (صحيح)"]},{"id":"ق-0129","fp":"632023b41e83","stateId":235,"easy":"اتباع النبي ﷺ ← محبة الله ومغفرة الذنوب","cause":"اتباع النبي ﷺ","result":"محبة الله ومغفرة الذنوب","explicit":true,"star":true,"otherNeedIds":[11],"ref":"سورة آل عمران: 31","srcLabel":"القرآن الكريم","quran":{"s":3,"from":31,"to":31,"text":"قُلْ إِنْ كُنْتُمْ تُحِبُّونَ اللَّهَ فَاتَّبِعُونِي يُحْبِبْكُمُ اللَّهُ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ (31)","hl":[[5,129,1]]}},{"id":"س-05395","fp":"4e76f023ee36","stateId":235,"easy":"إذا زرت أخاك في الله ← يحبك الله كما أحببته فيه","cause":"بِحُبِّكَ إيَّاه فيهِ","result":"إنَّ اللهَ عزَّ وجلَّ يِحِبُّكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"تخريج المسند لشعيب 10601","srcLabel":"مسلم","text":["فذكَرَ معناه [أي معنى حَديثِ: خرَجَ رَجُلٌ يَزورُ أخًا له في اللهِ، في قَريةٍ أُخرى، فأرصَدَ اللهُ عزَّ وجلَّ على مَدرَجَتِهِ مَلَكًا، فلمَّا مَرَّ به قال: أين تُريدُ؟ قال: أُريدُ فُلانًا. قال: ألِقرابةٍ؟ قال: لا. قال: فلِنِعمةٍ له عِندَكَ تَرُبُّها؟ قال: لا. قال: فلِمَ تَأتيهِ؟ قال: إنِّي أُحِبُّهُ في اللهِ عزَّ وجلَّ. قال: فإنِّي رسولُ اللهِ إليكَ: ",["إنَّ اللهَ عزَّ وجلَّ يِحِبُّكَ",2]," ",["بِحُبِّكَ إيَّاه فيهِ",1],"]."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2567)، وأحمد (10601) واللفظ له","bab":"رقائق وزهد › الحب في الله","dorar":"d4UzCy7m","merged":3,"otherRefs":["تخريج المسند لشعيب 9291 (صحيح)","تخريج المسند لشعيب 10247 (صحيح)"]},{"id":"س-05394","fp":"ee9b0f606c76","stateId":235,"easy":"إذا تحاببت وتصافيت في الله ← حقّت لك محبة الله","cause":"للذين يَتحابُّونَ مِن أجْلي، وحَقَّتْ مَحبَّتي للذين يَتصافَوْنَ مِن أجْلي، وحَقَّتْ مَحبَّتي للذين يَتزاوَرونَ مِن أجْلي، وحَقَّتْ مَحبَّتي للذين يَتباذَلونَ مِن أجْلي، وحَقَّتْ مَحبَّتي للذين يَتناصَرونَ مِن أجْلي","result":"قد حَقَّتْ مَحبَّتي","explicit":true,"repOf":"س-08439","ref":"تخريج المسند لشعيب 19438","text":["إنَّ اللهَ عزَّ وجلَّ يقولُ: ",["قد حَقَّتْ مَحبَّتي",2]," ",["للذين يَتحابُّونَ مِن أجْلي، وحَقَّتْ مَحبَّتي للذين يَتصافَوْنَ مِن أجْلي، وحَقَّتْ مَحبَّتي للذين يَتزاوَرونَ مِن أجْلي، وحَقَّتْ مَحبَّتي للذين يَتباذَلونَ مِن أجْلي، وحَقَّتْ مَحبَّتي للذين يَتناصَرونَ مِن أجْلي",1],"."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (19438) واللفظ له، وعبد بن حميد (304)، والطبراني في ((المعجم الأوسط)) (9080)","bab":"رقائق وزهد › الحب في الله","dorar":"PtPbdHqb","merged":2,"otherRefs":["صحيح الجامع 4320 (صحيح)"]},{"id":"س-06970","fp":"413183c2604e","stateId":235,"easy":"إذا أحببت أخاك في الله بظهر الغيب ← يكون أشدكما حباً أحبكما إلى الله","cause":"ما من رَجُلينِ تحابَّا في اللهِ بظهرِ الغيبِ","result":"إلَّا كان أحبُّهما إلى اللهِ أشدَّهما حبًّا لصاحبِه","explicit":true,"ref":"مجمع الزوائد 10/279","srcLabel":"الطبراني","text":[["ما من رَجُلينِ تحابَّا في اللهِ بظهرِ الغيبِ",1]," ",["إلَّا كان أحبُّهما إلى اللهِ أشدَّهما حبًّا لصاحبِه",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"رجاله رجال الصحيح غير المعافى بن سليمان وهو ثقة","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (5279)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"tcr9gmwG"},{"id":"س-07245","fp":"894c451f20aa","stateId":235,"easy":"إذا تحاببت في الله وتباذلت فيه ← يحبك الله","cause":"الذين يتحابُّونَ في اللهِ ، ويحبُّ الذين يتقاعدون فيهِ ، ويحبُّ الذين يتباذلونَ فيه ، ويحبُّ الذين يتزاورُونَ فيه ، ويحبُّ الذين يتجاورونَ فيهِ","result":"إنَّ اللهَ يحبُّ","explicit":true,"ref":"التمهيد 21/134","srcLabel":"البيهقي","text":["عن رجلٍ قال : قلتُ لمعاذِ بنِ جبلٍ : إني أحبُّك في اللهِ أو أُحبُّك للهِ ، فقال لي : انظر ما تقولُ ، قالها ثلاثَ مراتٍ ثم قال : إني سمعتُ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّم يقول : ",["إنَّ اللهَ يحبُّ",2],[" الذين يتحابُّونَ في اللهِ ، ويحبُّ الذين يتقاعدون فيهِ ، ويحبُّ الذين يتباذلونَ فيه ، ويحبُّ الذين يتزاورُونَ فيه ، ويحبُّ الذين يتجاورونَ فيهِ",1]],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"محفوظ","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (8995)، وابن عبدالبر في ((التمهيد)) (21/133) واللفظ له","bab":"علم › فضل مجالس العلم والذكر","dorar":"hN5LIKSm"},{"id":"س-02675","fp":"757297e93d85","stateId":235,"easy":"إذا أحببت في الله ← فهو من أحب الأعمال إلى الله","cause":"الحُبُّ في اللهِ","result":"إنَّ أحَبَّ الأعمالِ إلى اللهِ","explicit":true,"ref":"تخريج المسند لشعيب 21303","srcLabel":"أبو داود","text":["خرَجَ إلينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فقال: أتَدْرونَ أيُّ الأعمالِ أحَبُّ إلى اللهِ؟ قال قائلٌ: الصَّلاةُ والزكاةُ، وقال قائلٌ: الجِهادُ، قال: ",["إنَّ أحَبَّ الأعمالِ إلى اللهِ",2]," ",["الحُبُّ في اللهِ",1],"، والبُغضُ في اللهِ."],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"حسن لغيره","takhrij":"أخرجه أبو داود (4599)، وأحمد (21303) واللفظ له","bab":"إيمان › الحب في الله والبغض فيه من الإيمان","dorar":"ipcZCjPc"},{"id":"س-03702","fp":"d8b807a454bb","stateId":235,"easy":"إذا أطعت النبي ﷺ ← فقد أطعت الله","cause":"مَن أطاعَني","result":"فَقد أطاعَ اللَّهَ","explicit":true,"star":true,"similar":["س-00608"],"ref":"صحيح ابن خزيمة 3/ 104","srcLabel":"متفق عليه","text":[["مَن أطاعَني",1]," ",["فَقد أطاعَ اللَّهَ",2],"، ومَن عَصاني فقد عَصَى اللَّهَ، ومن أطاعَ الأميرَ فقد أطاعَني، ومَن عصا الأميرَ فقد عَصاني، إنَّما الإمامُ جنَّةٌ، فإذا صلَّى قاعدًا فصلُّوا قعودًا، وإذا قالَ: سمِعَ اللَّهُ لمن حمدَهُ، فقولوا: اللَّهمَّ ربَّنا لَكَ الحمدُ، فإذا وافقَ قَولُ أَهْلِ الأرضِ قولَ أَهْلِ السَّماءِ غُفِرَ لَهُ ما مضَى مِن ذنبِهِ، ويَهْلِكُ كِسرى ولا كِسرى بعدُ، ويَهْلِكُ قَيصرُ فلا قَيصرَ مِن بعدِهِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (7137)، ومسلم (1835)، والنسائي (4193) بلفظه مختصرًا.","bab":"اعتصام بالسنة › لزوم السنة","dorar":"KojlJ7bG","merged":3,"otherRefs":["صحيح النسائي 5525 (صحيح)","صحيح البخاري 2957 (صحيح)"]},{"id":"ق-0233","fp":"95fecd0a1ed4","stateId":235,"easy":"طاعة الرسول ← طاعة الله","cause":"طاعة الرسول","result":"طاعة الله","explicit":true,"ref":"سورة النساء: 80","srcLabel":"القرآن الكريم","quran":{"s":4,"from":80,"to":80,"text":"مَنْ يُطِعِ الرَّسُولَ فَقَدْ أَطَاعَ اللَّهَ وَمَنْ تَوَلَّى فَمَا أَرْسَلْنَاكَ عَلَيْهِمْ حَفِيظًا (80)","hl":[[0,46,1]]}},{"id":"س-00608","fp":"17b328f9b8c2","stateId":235,"easy":"إذا أطعت محمداً ﷺ ← فقد أطعت الله","cause":"فمَن أطاعَ مُحَمَّدًا","result":"فقد أطاعَ اللهَ","explicit":true,"repOf":"س-03702","ref":"صحيح البخاري 7281","text":["جاءَت مَلائِكةٌ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم وهو نائِمٌ، فقال بَعضُهم: إنَّه نائِمٌ، وقال بَعضُهم: إنَّ العَينَ نائِمةٌ، والقَلبَ يَقظانُ، فقالوا: إنَّ لصاحِبِكُم هذا مَثَلًا، فاضرِبوا له مَثَلًا، فقال بَعضُهم: إنَّه نائِمٌ، وقال بَعضُهم: إنَّ العَينَ نائِمةٌ، والقَلبَ يَقظانُ، فقالوا: مَثَلُه كَمَثَلِ رَجُلٍ بَنى دارًا، وجَعَلَ فيها مَأدُبةً وبَعَثَ داعيًا، فمَن أجابَ الدَّاعيَ دَخَلَ الدَّارَ وأكَلَ مِنَ المَأدُبةِ، ومَن لَم يُجِبِ الدَّاعيَ لَم يَدخُلِ الدَّارَ ولَم يَأكُلْ مِنَ المَأدُبةِ، فقالوا: أوِّلوها له يَفقَهْها، فقال بَعضُهم: إنَّه نائِمٌ، وقال بَعضُهم: إنَّ العَينَ نائِمةٌ، والقَلبَ يَقظانُ، فقالوا: فالدَّارُ الجَنَّةُ، والدَّاعي مُحَمَّدٌ صلَّى اللهُ عليه وسلَّم، ",["فمَن أطاعَ مُحَمَّدًا",1]," صلَّى اللهُ عليه وسلَّم ",["فقد أطاعَ اللهَ",2],"، ومَن عَصى مُحَمَّدًا صلَّى اللهُ عليه وسلَّم فقد عَصى اللهَ، ومُحَمَّدٌ صلَّى اللهُ عليه وسلَّم فَرقٌ بينَ النَّاسِ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[أورده في صحيحه] وقال : تابعه قتيبة عن ليث عن خالد عن سعيد بن أبي هلال عن جابر خرج علينا النبي صلى الله عيه وسلم ...","takhrij":"أخرجه أبو عوانة (10114)، والبيهقي في ((الآداب)) (858) كلاهما بلفظه، والترمذي (2860) بمعناه.","bab":"آداب عامة › ضرب الأمثال","dorar":"mmVpxzQK"},{"id":"س-05389","fp":"e97594e4e7a7","stateId":235,"easy":"إذا أحببت أحداً لله ← فقد أكرمت ربك","cause":"ما أَحَبَّ عَبْدٌ عَبْدًا لِلَّهِ","result":"إلا أَكرَمَ رَبَّه - عَزَّ وَجَلَّ","explicit":true,"ref":"هداية الرواة 4949","srcLabel":"أحمد","text":[["ما أَحَبَّ عَبْدٌ عَبْدًا لِلَّهِ ؛",1]," ",["إلا أَكرَمَ رَبَّه - عَزَّ وَجَلَّ - ",2],"."],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (22229) واللفظ له، وابن أبي الدنيا في ((الأخوان)) (20) باختلاف يسير، والبيهقي في ((شعب الإيمان)) (9017) مطولاً","bab":"رقائق وزهد › الحب في الله","dorar":"xo1f7Nr0"},{"id":"س-03145","fp":"76b5c9e46bc2","stateId":236,"easy":"إذا أحببت الأنصار ← يحبك الله","cause":"مَن أحَبَّهم","result":"فأحَبَّه اللهُ","explicit":true,"star":true,"similar":["س-08343","س-01798","س-03760"],"ref":"تخريج المسند لشعيب 18576","srcLabel":"متفق عليه","text":["أنَّه قال في الأنصارِ: لا يُحِبُّهم إلَّا مؤمنٌ، ولا  يُبغِضُهم إلَّا مُنافقٌ، ",["مَن أحَبَّهم؛ ",1],["فأحَبَّه اللهُ، ",2],"ومَن أبغَضَهم؛ فأبغَضَه اللهُ، قال: قُلتُ له: أنت سَمِعتَ البَراءَ؟ قال: إيَّاي يُحدِّثُ."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (3783)، ومسلم (75)، والترمذي (3900)، والنسائي في ((السنن الكبرى)) (8334)، وابن ماجه (163)، وأحمد (18576) واللفظ له","bab":"إيمان › توحيد الأسماء والصفات","dorar":"YSJUPqV0","merged":2,"otherRefs":["تخريج المسند لشعيب 18500 (صحيح)"]},{"id":"س-08343","fp":"dfdd79b8c09d","stateId":236,"easy":"إذا أحببت الأنصار ← أحبك الله ورسوله","cause":"مَن أحَبَّ الأنصارَ","result":"فقد أحَبَّه اللهُ ورسولُه","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"repOf":"س-03145","ref":"صحيح ابن حبان 7272","text":[["مَن أحَبَّ الأنصارَ ",1],["فقد أحَبَّه اللهُ ورسولُه ",2],"ومَن أبغَض الأنصارَ فقد أبغَض اللهَ ورسولَه لا يُحِبُّهم إلَّا مُؤمِنٌ ولا يُبغِضُهم إلَّا مُنافِقٌ"],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن عساكر في ((تاريخ دمشق)) (31/ 52)  بلفظه، وأخرجه البخاري (3783)، ومسلم (75) بلفظ مقارب","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"5oasDf0x"},{"id":"س-01798","fp":"b4351e82a287","stateId":236,"easy":"إذا أحببت الأنصار ← تلقى الله وهو يحبك","cause":"لا يُحِبُّ رجُلٌ الأنصارَ","result":"إلَّا لَقِيَ اللهَ تبارَكَ وتعالى وهو يُحبُّه","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"repOf":"س-03145","ref":"محجة القرب 251","text":["عنِ الحارثِ بنِ زيادٍ السَّاعديِّ الأنصاريِّ، أنَّه أتى النبيَّ صلَّى اللهُ عليه وسلَّمَ يومَ الخندقِ وهو يُبايِعُ الناسَ على الهجرةِ، فقال: يا رسولَ اللهِ، بايِعْ هذا، قال: ومَن هذا؟ قال: ابنُ عمِّي، حَوْطُ بنُ يَزيدَ -أو يَزيدُ بنُ حوْطٍ-، قال: فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: لا أُبايعُكم، إنَّ الناسَ يُهاجِرونَ إليكم ولا تُهاجِرونَ إليهم، والذي نَفْسي بيدِهِ ",["لا يُحِبُّ رجُلٌ الأنصارَ",1]," حتَّى يَلْقى اللهَ تبارَكَ وتعالى ",["إلَّا لَقِيَ اللهَ تبارَكَ وتعالى وهو يُحبُّه",2],"، ولا يُبغِضُ الأنصارَ رجُلٌ حتَّى يَلْقى اللهَ تبارَكَ وتعالى إلَّا لَقِيَ اللهَ تبارَكَ وتعالى وهو يُبغِضُه."],"grade":"صحيح","narrator":"الحارث بن زياد الساعدي","muhaddith":"صحيح","takhrij":"أخرجه أحمد (15540)، والطبراني (3/ 263) واللفظ لهما، والطحاوي في ((شرح مشكل الآثار)) (2637) باختلاف يسير.","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"kXtXuFbr","merged":3,"otherRefs":["السلسلة الصحيحة 1672 (حسن)","سبل الهدى والرشاد 3/184 (صحيح)"]},{"id":"س-08356","fp":"e1901b8f3fa7","stateId":236,"easy":"إذا أحببت علياً ← فقد أحببت النبي ﷺ","cause":"مَن أَحَبَّ علِيًّا","result":"فقد أَحَبَّني","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"الصحيح المسند 442","srcLabel":"الصحيح المسند","text":["قالَ رَجُلٌ لِسَلْمانَ: ما أَشَدَّ حُبَّك لعلِيٍّ! قالَ: سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ يقولُ: «",["مَن أَحَبَّ علِيًّا",1]," ",["فقد أَحَبَّني",2],"، ومَن أَبغَضَ علِيًّا فقد أَبغَضَني»."],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"vRIW0qZ2","merged":2,"otherRefs":["السلسلة الصحيحة 1299 (صحيح)"]},{"id":"س-08364","fp":"caf07c25592b","stateId":236,"easy":"إذا أحببت الحسن والحسين ← فقد أحببت النبي ﷺ","cause":"من أحبَّهما","result":"فقد أحبَّني","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"similar":["س-08268","س-08338"],"ref":"السلسلة الصحيحة 2895","srcLabel":"النسائي","text":[["من أحبَّهما",1]," ",["فقد أحبَّني",2]," ، و من أبغضَهما فقد أبغضَني يعني الحسَنَ و الحُسَينَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (8168)، وابن ماجه (143)، وأحمد (7876) باختلاف يسير.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"o9DPTHbK","merged":2,"otherRefs":["تخريج سير أعلام النبلاء 3/284 (حسن)"]},{"id":"س-03182","fp":"18273f5bb68e","stateId":236,"easy":"إذا أحببت العرب ← فقد أحببت النبي ﷺ","cause":"فمن أحبَّ العربَ","result":"فقد أحبَّني","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"حلية الأولياء 2/378","srcLabel":"البزار","text":["حبُّ العربِ إيمانٌ ، وبغضُّ العربِ كفرٌ ، ",["فمن أحبَّ العربَ",1]," ",["فقد أحبَّني",2]," ، ومن أبغضَ العربَ فقد أبغضني"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"غريب من حديث ثابت عن أنس تفرد به الهيثم بن جماز","takhrij":"أخرجه البزار (6997) بنحوه، والعقيلي في ((الضعفاء الكبير)) (4/355) باختلاف يسير، وأبو نعيم في ((حلية الأولياء)) (2/333) واللفظ له","bab":"إيمان › حب الرسول","dorar":"EboA4xY3"},{"id":"س-03760","fp":"188bbf0e25b0","stateId":236,"easy":"إذا أحببت الأنصار ← أحبك الله","cause":"مَن أَحَبَّ الأنصارَ","result":"أَحَبَّه اللهُ عزَّ وجلَّ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"repOf":"س-03145","ref":"تخريج المسند لشعيب 16871","text":["أنَّ يَزيدَ بنَ جاريةَ الأنصاريَّ، أَخبَرَه أنَّه كان جالِسًا في نَفَرٍ مِنَ الأنصارِ، فخرَجَ علَيهِم معاويةُ، فسألَهم عن حَديثِهم، فقالوا: كنَّا في حديثٍ مِن حديثِ الأنصارِ، فقال معاويةُ: ألَا أَزيدُكم حديثًا سمِعتُه مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ قالوا: بلى يا أميرَ المؤْمِنينَ، قال: سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن أَحَبَّ الأنصارَ، ",1],["أَحَبَّه اللهُ عزَّ وجلَّ، ",2],"ومَن أَبغَضَ الأَنصارَ، أَبغَضَه اللهُ عزَّ وجلَّ."],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (8332)، وأحمد (16871) واللفظ له","bab":"اعتصام بالسنة › نقل السنة وروايتها","dorar":"Gq2pjn9e"},{"id":"س-08268","fp":"2b3430393cda","stateId":236,"easy":"إذا أحببت الحسن والحسين ← أحبك النبي ﷺ وأحبك الله وأدخلك الجنة","cause":"مَن أحَبَّهما","result":"أحَبَّني، ومَن أحَبَّني أحَبَّه اللهُ، ومَن أحَبَّه اللهُ أدخَلَه الجنَّةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"repOf":"س-08364","otherNeedIds":[67],"ref":"المستدرك على الصحيحين 4840","text":["«الحسَنُ والحُسَينُ ابْنايَ، ",["مَن أحَبَّهما",1]," ",["أحَبَّني، ومَن أحَبَّني أحَبَّه اللهُ، ومَن أحَبَّه اللهُ أدخَلَه الجنَّةَ",2],"، ومَن أبغَضَهما أبغَضَني، ومَن أبغَضَني أبغَضَه اللهُ، ومَن أبغَضَه اللهُ أدخَلَه النَّارَ»."],"grade":"صحيح","narrator":"سلمان","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه الطبراني (3/ 50) (2655)، وأبو نعيم في ((معرفة الصحابة)) (1797) بلفظه.","bab":"مناقب وفضائل › أهل البيت صلوات الله عليهم","dorar":"h4HspJIR"},{"id":"س-08338","fp":"fff91c3acfe1","stateId":236,"easy":"إذا أحببت الحسن والحسين ← فقد أحببت النبي ﷺ","cause":"مَن أَحَبَّ الحَسَنَ و الحُسَيْنَ","result":"فقد أَحَبَّنِي","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"repOf":"س-08364","ref":"الجامع الصغير 8299","text":[["مَن أَحَبَّ الحَسَنَ و الحُسَيْنَ",1]," ، ",["فقد أَحَبَّنِي",2]," ، ومَن بَغَضَهُما فقد أَبْغَضَنِي"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (143)، وأحمد (7863)، والنسائي في ((الكبرى)) (8112)، والحاكم في ((مستدركه)) (4777) واللفظ لهم جميعا.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"yXvUUa3c"},{"id":"س-08398","fp":"644cc52aa96f","stateId":236,"easy":"إذا أحببت علياً وصدّقت فيه ← فطوبى لك","cause":"لمَن أحبَّكَ وصدَّقَ فيكَ","result":"طُوبى","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"المستدرك على الصحيحين 4716","srcLabel":"أحمد","text":["«يا عَليُّ، ",["طُوبى",2]," ",["لمَن أحبَّكَ وصدَّقَ فيكَ",1],"، ووَيلٌ لمَن أبغَضَكَ وكذَّبَ فيكَ»."],"grade":"صحيح","narrator":"عمار بن ياسر","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد في ((فضائل الصحابة)) (1162)، وأبو يعلى في ((مسنده)) (1602)، وابن عدي في ((الكامل)) (6/ 318) جميعا بلفظه.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"aU1i44bw"},{"id":"س-08401","fp":"6d7c50d90f8f","stateId":236,"easy":"إذا أحببت الأنصار ← فبحب النبي ﷺ أحببتهم","cause":"من أحَبَّ الأنصارَ","result":"فبحُبِّي أحَبَّهم","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"سبل الهدى والرشاد 3/185","srcLabel":"النسائي","text":["«",["من أحَبَّ الأنصارَ",1]," ",["فبحُبِّي أحَبَّهم",2],"، ومن أبغَضَ الأنصارَ فببُغضي أبغَضَهم»"],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"صحيح.","takhrij":"أخرجه أحمد (16871)، والطيالسي (1049)، والنسائي في ((الكبرى)) (8274) جميعهم باختلاف يسير.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"G2Ynx0eW"},{"id":"س-08403","fp":"0585549dbe78","stateId":236,"easy":"إذا أحببت عمر ← فقد أحببت النبي ﷺ","cause":"مَن أحَبَّ عُمَرَ","result":"فقد أحَبَّني","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"سبل الهدى والرشاد 11/449","srcLabel":"أحمد","text":["«",["مَن أحَبَّ عُمَرَ",1]," ",["فقد أحَبَّني",2],"، ومَن أبغَضَ عُمَرَ فقد أبغَضَني»"],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6726)، وابن عدي في ((الكامل في الضعفاء)) (1/ 309)، وابن عساكر في ((تاريخ دمشق)) (14/ 22) ثلاثتهم مطولا، وأبو أحمد الحاكم في ((الأسامي والكنى)) (3/ 448) جميعا بلفظه.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"H8uLSqrZ"},{"id":"س-08265","fp":"ef61d39be001","stateId":236,"easy":"إذا أحببت من أحبه النبي ﷺ ← فقد أحببت الله","cause":"مَن أحبَّه","result":"أحَبَّ اللهَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"مجمع الزوائد 9/184","srcLabel":"البخاري","text":["كنَّا مع النَّبيِّ صلَّى اللهُ عليه وسلَّم ثمَّ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم حُسَينٌ منِّي وأنا منه ",["أحَبَّ اللهَ",2]," ",["مَن أحبَّه",1]," الحَسَنُ والحُسَينُ سِبطانِ مِنَ الأسباطِ"],"grade":"حسن","narrator":"يعلى بن مرة الثقفي","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني (2586)، وأبو نعيم في ((معرفة الصحابة)) (6644)، وابن عساكر في ((تاريخ دمشق)) (14/ 150) جميعا بلفظه وفي أوله قصة، والبخاري في ((الأدب المفرد)) (364) باختلاف يسير، وفي أوله قصة .","bab":"مناقب وفضائل › أهل البيت صلوات الله عليهم","dorar":"ZPOytF18"},{"id":"س-05581","fp":"9a13d1b9dc6d","stateId":237,"easy":"إذا كنت تقياً غنياً خفياً ← يحبك الله","cause":"العَبدَ التَّقيَّ، الغَنيَّ، الخَفيَّ","result":"إنَّ اللهَ يُحِبُّ","explicit":true,"star":true,"similar":["س-05491"],"ref":"صحيح مسلم 2965","srcLabel":"أحمد","text":["كانَ سَعدُ بنُ أبي وقَّاصٍ في إبِلِه، فجاءَه ابنُه عُمَرُ، فلَمَّا رَآهُ سَعدٌ قال: أعوذُ باللهِ مِن شَرِّ هذا الرَّاكِبِ! فنَزَلَ فقال له: أنَزَلتَ في إبِلِكَ وغَنَمِكَ، وتَرَكتَ النَّاسَ يَتَنازَعونَ المُلكَ بينَهم؟ فضَرَبَ سَعدٌ في صَدرِه، فقال: اسكُتْ، سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["إنَّ اللهَ يُحِبُّ",2],[" العَبدَ التَّقيَّ، الغَنيَّ، الخَفيَّ",1],"."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (1441)، وأبو يعلى (‌737)، والطحاوي في ((شرح مشكل الآثار)) (6050) واللفظ لهم.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"HKewQ8gW","merged":5,"otherRefs":["تخريج المسند لشاكر 3/65 (صحيح)","تخريج المسند لشاكر 3/26 (صحيح)","الأسرار المرفوعة 199 (صحيح)","مجمع الزوائد 7/237 (حسن)"]},{"id":"س-05491","fp":"b01639b666c8","stateId":237,"easy":"إذا كنت تقياً خفياً لا يُفتقد إذا غاب ← يحبك الله","cause":"الأَخفياءَ الأتقياءَ الَّذين إنْ غابوا لم يُفتَقَدوا","result":"وإنَّ اللهَ يُحِبُّ","explicit":true,"repOf":"س-05581","ref":"المستدرك على الصحيحين 8146","text":["عن أسْلَمَ: أنَّ عمَرَ بنَ الخَطَّابِ رَضيَ اللهُ عنه خرَجَ إلى مَسجدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فإذا هو بمُعاذِ بنِ جبَلٍ رَضيَ اللهُ عنه عندَ قبْرِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يَبْكِي، فقال: ما يُبكِيكَ يا مُعاذُ؟ قالَ: يُبكِيني شَيءٌ سَمِعْتُهُ مِن صاحبِ هذا القَبْرِ، قالَ: وما سَمِعتَهُ؟ قالَ: سَمِعتُه يقولُ: إنَّ اليسيرَ مِن الرِّياءِ شِركٌ، وإنَّ مَن عادى وَلِيَّ اللهِ، فقَدْ بارَزَ اللهَ تَعالَى بالمُحارَبةِ، ",["وإنَّ اللهَ يُحِبُّ",2]," ",["الأَخفياءَ الأتقياءَ الَّذين إنْ غابوا لم يُفتَقَدوا",1],"، وإنْ حَضَروا لم يُدعَوا ولَمْ يُعرَفوا، قُلوبُهم مَصابيحُ الهُدى، يَخرُجونَ مِن كُلِّ غَبراءَ مُظلِمةٍ."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن ماجه (3989)، والطبراني (20/ 153) (321)، وابن أبي الدنيا في ((الأولياء)) (6) واللفظ لهم.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"jFEme96y","merged":3,"otherRefs":["الترغيب والترهيب 4/148 (صحيح)","المستدرك على الصحيحين 5270 (صحيح)"]},{"id":"س-05612","fp":"6487f81bdba1","stateId":237,"easy":"إذا زهدت في الدنيا ← يحبك الله","cause":"ازهَد في الدُّنيا","result":"يحبَّكَ اللَّهُ","explicit":true,"similar":["س-05528"],"ref":"صحيح ابن ماجه 3326","srcLabel":"الطبراني","text":["يا رسولَ اللَّهِ دلَّني على عَملٍ إذا أَنا عَمِلْتُهُ أحبَّني اللَّهُ وأحبَّني النَّاسُ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ ",["ازهَد في الدُّنيا ",1],["يحبَّكَ اللَّهُ",2]," وازهد فيما في أيدي النَّاسِ يحبُّوكَ"],"grade":"صحيح","narrator":"سهل بن سعد الساعدي","muhaddith":"صحيح","takhrij":"أخرجه أبو عبيد في ((الخطب والمواعظ)) (131) والطبراني (5972) بلفظه.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"pJKVGlLe","merged":2,"otherRefs":["صحيح الجامع 923 (صحيح)"]},{"id":"س-03106","fp":"e0734017bad3","stateId":237,"easy":"إذا حزن قلبك (خشية) ← يحب الله القلب الحزين","cause":"كلَّ قلْبٍ حزينٍ","result":"إِنَّ اللهَ تعالى يُحِبُّ","explicit":true,"ref":"الجامع الصغير 1882","srcLabel":"الحاكم","text":[["إِنَّ اللهَ تعالى يُحِبُّ",2],[" كلَّ قلْبٍ حزينٍ",1]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (7884)، والبزار (4150)، والطبراني في ((الشاميين)) (1480) واللفظ لهم.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"ttWebA4e"},{"id":"س-05464","fp":"555467dc03b9","stateId":237,"easy":"إذا دمعت عينك من خشية الله أو أُريق دمك في سبيله ← فلا شيء أحب إلى الله من هاتين القطرتين","cause":"قطرةُ دموعٍ مِن خشيةِ الله تعالى، وقَطرةُ دمٍ تُهراقُ في سبيل الله تعالى، وأمَّا الأثرانِ: فأثَرٌ في سبيلِ الله تعالى، وأثَرٌ في فريضةٍ مِن فرائضِ الله تعالى","result":"ليس شيءٌ أحبَّ إلى الله تعالى مِن قطرتينِ وأثَرَين","explicit":true,"ref":"الجامع الصغير 7582","srcLabel":"الترمذي","text":[["ليس شيءٌ أحبَّ إلى الله تعالى مِن قطرتينِ وأثَرَين",2],": ",["قطرةُ دموعٍ مِن خشيةِ الله تعالى، وقَطرةُ دمٍ تُهراقُ في سبيل الله تعالى، وأمَّا الأثرانِ: فأثَرٌ في سبيلِ الله تعالى، وأثَرٌ في فريضةٍ مِن فرائضِ الله تعالى",1],"."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1669)، وابن أبي عاصم في ((الجهاد)) (108)، والطبراني (8/ 235) (7918)، وابن عدي في ((الكامل في الضعفاء)) (8/ 363) واللفظ لهم.","bab":"رقائق وزهد › الخوف من الله","dorar":"yrneFDS1"},{"id":"س-02165","fp":"11f969ac4c57","stateId":237,"easy":"إذا لان قلبك ورقّ ← تكون أحب القلوب إلى الله","cause":"أليَنُها و أرَقُّها","result":"و أحبُّها إليه","explicit":true,"otherNeedIds":[19],"ref":"السلسلة الصحيحة 1691","srcLabel":"الطبراني","text":["إنَّ للهِ آنيةً من أهلِ الأرضِ ، و آنيةُ ربِّكم قلوبُ عبادِه الصالحين ، ",["و أحبُّها إليه",2]," ",["أليَنُها و أرَقُّها",1]],"grade":"حسن","narrator":"أبو عنبة الخولاني","muhaddith":"إسناده قوي","takhrij":"أخرجه الطبراني في ((مسند الشاميين)) (840)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"a8C1N7HC"},{"id":"س-00467","fp":"cea28aedd604","stateId":237,"easy":"إذا أطعت ربك ولم تخنه ولم تكذبه ← تكون عنده كالعبد الأمين عند سيده","cause":"أحَدُهما يُطيعُك ولا يَخونُك ولا يَكْذِبُك","result":"كذاكُم أنتم عِندَ ربِّكم عزَّ وجلَّ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"تخريج المسند لشعيب 17228","srcLabel":"النسائي","text":["أتَيْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فصَعَّدَ فيَّ النظَرَ وصَوَّبَ، وقال: أَرَبُّ إبِلٍ أنت أو رَبُّ غَنَمٍ؟ قال: مِن كُلٍّ قد آتاني اللهُ، فأَكثَرَ وأَطْيَبَ، قال: فتُنْتِجُها وافيةً أَعْيُنُها وآذانُها، فتَجْدَعُ هذه فتقولُ صُرُمًا -ثمَّ تَكلَّمَ سُفْيانُ بكَلِمةٍ لم أَفهَمْها- وتقولُ: بَحِيرةَ اللهِ؟ فساعِدُ اللهِ أشَدُّ، ومُوساهُ أحَدُّ، ولو شاء أنْ يأتيَك بها صُرُمًا أَتاكَ. قلْتُ: إلى ما تَدْعو؟ قال: إلى اللهِ وإلى الرَّحِمِ. قلْتُ: يأتيني الرجُلُ مِن بَني عَمِّي، فأَحلِفُ أنْ لا أُعْطيَه ثمَّ أُعطيهِ؟ قال: فكَفِّرْ عن يَمينِكَ، وأْتِ الذي هو خَيرٌ، أَرأيْتَ لو كان لك عَبْدانِ ",["أحَدُهما يُطيعُك ولا يَخونُك ولا يَكْذِبُك",1],"، والآخَرُ يَخونُك ويَكْذِبُك؟ قال: قلْتُ: لا، بلِ الذي لا يَخونُني ولا يَكْذِبُني ويَصْدُقُني الحديثَ أَحَبُّ إلَيَّ. قال: ",["كذاكُم أنتم عِندَ ربِّكم عزَّ وجلَّ",2],"."],"grade":"صحيح","narrator":"مالك بن نضلة الجشمي","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (3788)، وابن ماجه (2109) مختصراً، وأحمد (17228) واللفظ له","bab":"آداب عامة › الرفق بالحيوان والطير ونحوهما","dorar":"p6XgyxJt"},{"id":"س-05528","fp":"fac3f4c708c0","stateId":237,"easy":"إذا زهدت في الدنيا ← يحبك الله","cause":"فالزُّهدُ في الدنيا","result":"يحبُّك اللهُ عليه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-05612","ref":"صحيح الترغيب 3214","text":["أما العملُ الذي ",["يحبُّك اللهُ عليه",2]," ",["فالزُّهدُ في الدنيا",1]," ، وأما العملُ الذي يحبُّك الناسُ عليه فانبِذْ إليهم ما في يدَيك من الحُطامِ"],"grade":"حسن","narrator":"إبراهيم بن أدهم","muhaddith":"حسن لغيره","takhrij":"أخرجه ابن أبي الدنيا في ((مداراة الناس)) (33) باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"iLy3kLax"},{"id":"س-06920","fp":"143138fc0445","stateId":237,"easy":"إذا قمت الليل تتلو القرآن أو تصدقت خفية أو ثبتّ في القتال ← تكون ممن يحبهم الله","cause":"رجلٌ قامَ منَ اللَّيلِ يتلو كتابَ اللَّهِ ورجلٌ تصدَّقَ بصدقةٍ يخفيها من شمالِهِ ورجلٌ كانَ في سريَّةٍ فانهزمَ أصحابُهُ فاستقبلَ العدوَّ","result":"ثلاثةٌ يحبُّهمُ اللَّهُ عزَّ وجلَّ","explicit":true,"star":true,"apply":{"k":"time","t":"في الليل"},"ref":"مجمع الزوائد 2/258","srcLabel":"الترمذي","text":[["ثلاثةٌ يحبُّهمُ اللَّهُ عزَّ وجلَّ",2]," ",["رجلٌ قامَ منَ اللَّيلِ يتلو كتابَ اللَّهِ ورجلٌ تصدَّقَ بصدقةٍ يخفيها من شمالِهِ ورجلٌ كانَ في سريَّةٍ فانهزمَ أصحابُهُ فاستقبلَ العدوَّ",1]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الترمذي (2567)، والطبراني (10/256) (10486)، والشجري في ((أماليه)) (975) واللفظ له","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"r7C1abTz"},{"id":"س-03110","fp":"20b2684be9ac","stateId":237,"easy":"إذا كنت شاباً لا صبوة لك ← يعجب الله منك","cause":"الشَّابِّ ليسَتْ لَهُ صَبوةٌ","result":"إنَّ اللَّهَ تعَالى لَيَعجَبُ منَ","explicit":true,"star":true,"ref":"الجامع الصغير 1793","srcLabel":"أحمد","text":[["إنَّ اللَّهَ تعَالى لَيَعجَبُ منَ",2],[" الشَّابِّ ليسَتْ لَهُ صَبوةٌ",1]],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17371) واللفظ له، وأبو يعلى (1749)، والطبراني (17/309) (853) باختلاف يسير","bab":"إيمان › توحيد الأسماء والصفات","dorar":"hVjSwMcZ","merged":4,"otherRefs":["مختصر المقاصد 634 (حسن)","المقاصد الحسنة 151 (حسن)","السلسلة الصحيحة 2843 (حسن)"]},{"id":"س-06952","fp":"f160240c8e5c","stateId":237,"easy":"إذا أرضيت الله بسخط الناس ← يرضى الله عنك ويرضي عنك الناس","cause":"من أرْضَى اللهَ بِسَخَطِ الناسِ","result":"رَضِيَ اللهُ عنه وأَرْضَى عنه الناسَ","explicit":true,"similar":["س-06884"],"otherNeedIds":[41],"ref":"شرح الطحاوية 268","srcLabel":"الترمذي","text":[["من أرْضَى اللهَ بِسَخَطِ الناسِ ، ",1],["رَضِيَ اللهُ عنه  وأَرْضَى عنه الناسَ ، ",2],"ومن أرْضَى الناسَ بسَخَطِ اللهِ ، عادَ حامِدُهُ مِنَ الناسِ ( لَهُ ) ذَامًّا"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2414) بنحوه، وعبد بن حميد في ((المسند)) (1522)، وابن حبان (277) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"NIKhkxFv","merged":2,"otherRefs":["صحيح الترغيب 2250 (صحيح)"]},{"id":"س-06884","fp":"1135a5d4aa79","stateId":237,"easy":"إذا أرضيت الله ولو أسخطت الناس ← يرضى الله عنك ويُرضي عنك الناس","cause":"ومَن أرضى اللهَ في سَخَطِ النَّاسِ","result":"رضِيَ اللهُ عنه وأرضى عنه مَن أسخَطه في رِضاه حتَّى يُزَيِّنَه ويُزَيِّنَ قولَه وعملَه في عينِه","explicit":true,"repOf":"س-06952","otherNeedIds":[41],"ref":"مجمع الزوائد 10/227","text":["مَن أسخَط اللهَ [ في رِضا النَّاسِ سخِطَ اللهُ عليه ] وأسخَط عليه مَن أرضاه في سَخَطِه ",["ومَن أرضى اللهَ في سَخَطِ النَّاسِ",1]," ",["رضِيَ اللهُ عنه وأرضى عنه مَن أسخَطه في رِضاه حتَّى يُزَيِّنَه ويُزَيِّنَ قولَه وعملَه في عينِه",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"رجاله رجال الصحيح غير يحيى بن سليمان الحفري وقد وثقه الذهبي","takhrij":"أخرجه  الطبراني (11/268) (11696)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"3rZo1QHq"},{"id":"ق-0336","fp":"ed70d2549c7f","stateId":238,"easy":"الإيمان والعمل الصالح والتقوى والإحسان ← رفع الجناح ومحبة الله","cause":"الإيمان والعمل الصالح والتقوى والإحسان","result":"رفع الجناح ومحبة الله","explicit":true,"star":true,"ref":"سورة المائدة: 93","srcLabel":"القرآن الكريم","quran":{"s":5,"from":93,"to":93,"text":"لَيْسَ عَلَى الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ جُنَاحٌ فِيمَا طَعِمُوا إِذَا مَا اتَّقَوْا وَآمَنُوا وَعَمِلُوا الصَّالِحَاتِ ثُمَّ اتَّقَوْا وَآمَنُوا ثُمَّ اتَّقَوْا وَأَحْسَنُوا وَاللَّهُ يُحِبُّ الْمُحْسِنِينَ (93)","hl":[[161,222,1]]}},{"id":"س-03820","fp":"97296b9bdf90","stateId":238,"easy":"إذا أعطاك الله الدين ← فقد أحبك","cause":"فمَن أعطاهُ اللَّهُ الدِّينَ","result":"فقد أحبَّهُ ، والَّذي نَفسي بيدِهِ ، لا يُسلِمُ عبدٌّ حتَّى يسلمَ قلبُه ولسانُهُ ، ولا يؤمنُ حتَّى يأمنَ جارُه بوائقَهُ","explicit":true,"ref":"عمدة التفسير 1/323","srcLabel":"أحمد","text":["إن اللَّهَ قسَّمَ بينَكُم أخلاقَكُم ، كما قسَّمَ بينَكُم أرزاقَكُم ، وإنَّ اللَّهَ يُعطي الدُّنيا مَن يحبُّ ومن لا يحبُّ ، ولا يعطي الدِّينَ إلَّا لمن أحبَّ ، ",["فمَن أعطاهُ اللَّهُ الدِّينَ ",1],["فقد أحبَّهُ ، والَّذي نَفسي بيدِهِ ، لا يُسلِمُ عبدٌّ حتَّى يسلمَ قلبُه ولسانُهُ ، ولا يؤمنُ حتَّى يأمنَ جارُه بوائقَهُ ",2],". قالوا : وما بوائقُهُ يا نبيَّ اللَّهِ ؟ . قالَ : غشمُه وظلمُهُ ، ولا يَكْسبُ عبدٌ مالًا من حرامٍ فينفقَ منهُ فيباركَ لَهُ فيهِ ، ولا يتصدقُ فيقبلَ منهُ ، ولا يترُكُهُ خلفَ ظَهْرِهِ إلَّا كانَ زادَهُ إلى النَّارِ ، إنَّ اللَّهَ لا يمحو السَّيِّئَ بالسَّيِّئِ ، ولَكِن يمحو السَّيِّئَ بالحسنِ ، إنَّ الخبيثَ لا يمحو الخبيثَ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (3672) واللفظ له، والحاكم (7301) مختصراً، والبيهقي في ((شعب الإيمان)) (5524) باختلاف يسير","bab":"بر وصلة › حق الجار والوصاة به","dorar":"2ncru5Qu"},{"id":"س-02695","fp":"f7e46a6cc15e","stateId":238,"easy":"إذا تمسكت بالحنيفية السمحة ← فهي أحب الأديان إلى الله","cause":"الحَنيفيَّةُ السَّمحةُ","result":"أيُّ الأديانِ أحبُّ إلى اللَّهِ تعالى","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"عمدة التفسير 1/847","srcLabel":"البخاري","text":["قيلَ لرسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلّم : ",["أيُّ الأديانِ أحبُّ إلى اللَّهِ تعالى ",2],"؟ قالَ : ",["الحَنيفيَّةُ السَّمحةُ",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري معلقاً بصيغة الجزم قبل حديث (39) مختصراً، وأخرجه موصولاً أحمد (2107) واللفظ له","bab":"إيمان › الدين يسر","dorar":"PK21maNZ"},{"id":"س-08271","fp":"27b330b67188","stateId":238,"easy":"إذا تأملت نعم الله عليك ← أحببته","cause":"لِما يَغْذوكم به مِن نِعَمِه","result":"أَحِبُّوا اللهَ","explicit":true,"star":true,"ref":"الأحاديث المختارة 12 / 348","srcLabel":"متفق عليه","text":["«",["أَحِبُّوا اللهَ",2]," ",["لِما يَغْذوكم به مِن نِعَمِه",1],"، وأَحِبُّوني بحُبِّ اللهِ، وأَحِبُّوا أهْلَ بَيْتي بحُبِّي.\nفي رِوايةِ عَبْدِ اللهِ بنِ أحْمَدَ: يَغْذوكم مِن نِعَمِه»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"مناقب وفضائل › أهل البيت صلوات الله عليهم","dorar":"FB30qu7f"},{"id":"ق-0180","fp":"070c585d6c08","stateId":238,"easy":"التوكل على الله بعد المشاورة والعزم ← محبة الله","cause":"التوكل على الله بعد المشاورة والعزم","result":"محبة الله","explicit":true,"ref":"سورة آل عمران: 159","srcLabel":"القرآن الكريم","quran":{"s":3,"from":159,"to":159,"text":"فَبِمَا رَحْمَةٍ مِنَ اللَّهِ لِنْتَ لَهُمْ وَلَوْ كُنْتَ فَظًّا غَلِيظَ الْقَلْبِ لَانْفَضُّوا مِنْ حَوْلِكَ فَاعْفُ عَنْهُمْ وَاسْتَغْفِرْ لَهُمْ وَشَاوِرْهُمْ فِي الْأَمْرِ فَإِذَا عَزَمْتَ فَتَوَكَّلْ عَلَى اللَّهِ إِنَّ اللَّهَ يُحِبُّ الْمُتَوَكِّلِينَ (159)","hl":[[176,258,1]]}},{"id":"س-03107","fp":"9dbc721c21e5","stateId":238,"easy":"إذا كنت فقيراً متعففاً ذا عيال ← يحبك الله","cause":"عبدَه المؤمنَ الفقيرَ المتعففَ أبا العيالِ","result":"إنَّ اللهَ تعالى يحبُّ","explicit":true,"ref":"الجامع الصغير 1881","srcLabel":"ابن ماجة","text":[["إنَّ اللهَ تعالى يحبُّ",2],[" عبدَه المؤمنَ الفقيرَ المتعففَ أبا العيالِ",1]],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجة (4121)، وابن أبي الدنيا في ((النفقة على العيال)) (96)، ووكيع في ((الزهد)) (134) واللفظ لهم.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"pz5jjKU5"},{"id":"س-01705","fp":"f206e68754e5","stateId":238,"easy":"إذا أخذت بالحزم والأسباب ← فالله يحمد على الكيس ويلوم على العجز","cause":"على الكَيْسِ ويَلومُ على العَجْزِ","result":"إنَّ اللهَ يَحمَدُ على الكَيْسِ ويَلومُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[56],"ref":"الفتوحات الربانية 4/24","srcLabel":"أبو داود","text":["قضى رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم بين رجُلَينِ فقال المقضِيُّ عليه: حَسْبيَ اللهُ ونِعْمَ الوكيلُ، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: عَلَيَّ بالرَّجُلِ -يعني نجا- فقال: ",["إنَّ اللهَ يَحمَدُ على الكَيْسِ ويَلومُ",2],[" على العَجْزِ",1],"، فإنْ غَلَبَك الشَّيءُ -أو قال: الأمرُ- فقُلْ: حَسْبِيَ اللهُ ونِعْمَ الوَكيلُ"],"grade":"حسن","narrator":"عوف بن مالك الأشجعي","muhaddith":"حسن","takhrij":"أخرجه أبو داود (3627)، وأحمد (23983)، والبزار (2749) واللفظ لهم.","bab":"أقضية وأحكام › قضايا حكم فيها النبي صلى الله عليه وسلم","dorar":"3sG3ahKb"},{"id":"ق-0526","fp":"33b4d55174ef","stateId":238,"easy":"السبق إلى الإيمان واتباع السابقين بإحسان ← رضا الله وجنات خالدين فيها والفوز العظيم","cause":"السبق إلى الإيمان واتباع السابقين بإحسان","result":"رضا الله وجنات خالدين فيها والفوز العظيم","explicit":true,"star":true,"otherNeedIds":[67,53],"ref":"سورة التوبة: 100","srcLabel":"القرآن الكريم","quran":{"s":9,"from":100,"to":100,"text":"وَالسَّابِقُونَ الْأَوَّلُونَ مِنَ الْمُهَاجِرِينَ وَالْأَنْصَارِ وَالَّذِينَ اتَّبَعُوهُمْ بِإِحْسَانٍ رَضِيَ اللَّهُ عَنْهُمْ وَرَضُوا عَنْهُ وَأَعَدَّ لَهُمْ جَنَّاتٍ تَجْرِي تَحْتَهَا الْأَنْهَارُ خَالِدِينَ فِيهَا أَبَدًا ذَلِكَ الْفَوْزُ الْعَظِيمُ (100)","hl":[[0,254,1]]}},{"id":"ق-0743","fp":"6a914b8f4de7","stateId":238,"easy":"العمل الصالح الخالص من الشرك ← لقاء الله (لمن يرجوه)","cause":"العمل الصالح الخالص من الشرك","result":"لقاء الله (لمن يرجوه)","explicit":true,"star":true,"otherNeedIds":[68],"ref":"سورة الكهف: 110","srcLabel":"القرآن الكريم","quran":{"s":18,"from":110,"to":110,"text":"قُلْ إِنَّمَا أَنَا بَشَرٌ مِثْلُكُمْ يُوحَى إِلَيَّ أَنَّمَا إِلَهُكُمْ إِلَهٌ وَاحِدٌ فَمَنْ كَانَ يَرْجُو لِقَاءَ رَبِّهِ فَلْيَعْمَلْ عَمَلًا صَالِحًا وَلَا يُشْرِكْ بِعِبَادَةِ رَبِّهِ أَحَدًا (110)","hl":[[88,197,1]]}},{"id":"ق-1239","fp":"57287f0bb1a9","stateId":238,"easy":"البيعة مع صدق ما في القلب ← رضا الله وإنزال السكينة وفتح قريب ومغانم كثيرة","cause":"البيعة مع صدق ما في القلب","result":"رضا الله وإنزال السكينة وفتح قريب ومغانم كثيرة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[5,43,1],"ref":"سورة الفتح: 18–19","srcLabel":"القرآن الكريم","quran":{"s":48,"from":18,"to":19,"text":"لَقَدْ رَضِيَ اللَّهُ عَنِ الْمُؤْمِنِينَ إِذْ يُبَايِعُونَكَ تَحْتَ الشَّجَرَةِ فَعَلِمَ مَا فِي قُلُوبِهِمْ فَأَنْزَلَ السَّكِينَةَ عَلَيْهِمْ وَأَثَابَهُمْ فَتْحًا قَرِيبًا (18) وَمَغَانِمَ كَثِيرَةً يَأْخُذُونَهَا وَكَانَ اللَّهُ عَزِيزًا حَكِيمًا (19)","hl":[[0,217,1]]}},{"id":"س-04753","fp":"17394808c123","stateId":238,"easy":"إذا فارقت الدنيا مخلصاً لله مقيماً للصلاة مؤتياً للزكاة ← تفارقها والله عنك راضٍ","cause":"مَنْ فارَقَ الدُّنيا على الإخلاصِ للهِ وحْدَهُ لا شريكَ له، وإقامِ الصَّلاةِ، وإيتاءِ الزَّكاةِ","result":"فارَقَها واللهُ عنه راضٍ","explicit":true,"otherNeedIds":[62],"ref":"المستدرك على الصحيحين 3319","srcLabel":"ابن ماجه","text":["«",["مَنْ فارَقَ الدُّنيا على الإخلاصِ للهِ وحْدَهُ لا شريكَ له، وإقامِ الصَّلاةِ، وإيتاءِ الزَّكاةِ",1],"، ",["فارَقَها واللهُ عنه راضٍ",2],"، وهو دينُ اللهِ الَّذي جاءتْ به الرُّسلُ، وبلَّغوهُ عنْ ربِّهِم قبلَ مَرْجِ الأحاديثِ، واختلافِ الأهواءِ، وتَصديقُ ذلك في كتابِ اللهِ: {فَإِنْ تَابُوا وَأَقَامُوا الصَّلَاةَ وَآتَوُا الزَّكَاةَ فَخَلُّوا سَبِيلَهُمْ} [التوبة: 5]، وقولُهُ عزَّ وجلَّ: {فَإِنْ تَابُوا} [التوبة: 5] يقولُ: خلَعوا الأوثانَ وعِبادَتَها. {وَأَقَامُوا الصَّلَاةَ وَآتَوُا الزَّكَاةَ فَخَلُّوا سَبِيلَهُمْ} [التوبة: 5]. وقالَ عزَّ وجلَّ في آيةٍ أُخرى: {فَإِنْ تَابُوا وَأَقَامُوا الصَّلَاةَ وَآتَوُا الزَّكَاةَ فَإِخْوَانُكُمْ فِي الدِّينِ} [التوبة: 11]."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن ماجه (70) باختلاف يسير، والبيهقي في ((شعب الإيمان)) (6440)، والبزار (6524) بنحوه","bab":"رقائق وزهد › الإخلاص","dorar":"ilanwGiE"},{"id":"س-06843","fp":"6a838c741a60","stateId":238,"easy":"إذا قلت «لا إله إلا الله» ← تمنعك من سخط الله","cause":"لا إلهَ إلَّا اللهُ","result":"تمنَعُ [ العبدَ ] مِنْ سخَطِ اللهِ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"otherNeedIds":[31],"ref":"مجمع الزوائد 7/280","srcLabel":"ابن أبي الدنيا","text":[["لا إلهَ إلَّا اللهُ",1]," ",["تمنَعُ [ العبدَ ] مِنْ سخَطِ اللهِ",2]," مَا لَمْ يُؤْثِرُوا سَفْعَةَ دنياهم على دينِهِم فإِذَا فعَلُوا ذَلِكَ ثم قالوا لَا إِلَهَ إلَّا اللهُ قال اللهُ كَذَبْتُمْ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن أبي الدنيا في ((العقوبات)) (6)، والبزار كما في ((مجمع الزوائد)) (7/280) واللفظ له، وأبو يعلى (4034)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"jDMn61nP"},{"id":"س-02487","fp":"b9d44f3ed384","stateId":238,"easy":"إذا عبدت الله ولم تشرك واعتصمت بحبله ونصحت لولاة أمرك ← يرضى الله عنك","cause":"ثَلاثًا، ويَكرَهُ لكم ثَلاثًا، فيَرضى لكم: أن تَعبُدوه ولا تُشرِكوا به شيئًا، وأن تَعتَصِموا بحَبلِ اللهِ جَميعًا ولا تَفَرَّقوا، ويَكرَهُ لكم: قيلَ وقال، وكَثرةَ السُّؤالِ، وإضاعةَ المالِ","result":"إنَّ اللهَ يَرضى لكم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-02489"],"ref":"صحيح مسلم 1715","srcLabel":"متفق عليه","text":[["إنَّ اللهَ يَرضى لكم",2],[" ثَلاثًا، ويَكرَهُ لكم ثَلاثًا، فيَرضى لكم: أن تَعبُدوه ولا تُشرِكوا به شيئًا، وأن تَعتَصِموا بحَبلِ اللهِ جَميعًا ولا تَفَرَّقوا، ويَكرَهُ لكم: قيلَ وقال، وكَثرةَ السُّؤالِ، وإضاعةَ المالِ",1],". وفي روايةٍ: مِثلَه، غيرَ أنَّه قال: ويَسخَطُ لكم ثَلاثًا، ولَم يَذكُرْ: ولا تَفَرَّقوا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"إمامة وخلافة › النصح لأئمة المسلمين وولاتهم","dorar":"Y8yHPARZ"},{"id":"س-02489","fp":"a10220d8c44d","stateId":238,"easy":"إذا عبدت الله ولم تشرك ونصحت لولاة أمرك ← فهو ما رضيه الله لك","cause":"أنْ تَعبُدوه ولا تُشرِكوا به شيئًا، وأنْ تَنصَحوا لِمَن ولَّاه اللهُ أَمرَكم، وأنْ تَعتَصِموا بحَبْلِ اللهِ جميعًا، ولا تَفَرَّقوا","result":"رَضِيَ لكم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-02487","ref":"تخريج المسند لشعيب 8718","text":["إنَّ الله عزَّ وجَلَّ ",["رَضِيَ لكم",2]," ثلاثًا، وكَرِهَ لكم ثلاثًا: رَضِيَ لكم ",["أنْ تَعبُدوه ولا تُشرِكوا به شيئًا، وأنْ تَنصَحوا لِمَن ولَّاه اللهُ أَمرَكم، وأنْ تَعتَصِموا بحَبْلِ اللهِ جميعًا، ولا تَفَرَّقوا",1],"، وكَرِهَ لكم: قيلَ وقال، وكثرةَ السؤالِ، وإضاعةَ المالِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (1715)، وأحمد (8718) واللفظ له","bab":"إمامة وخلافة › النصح لأئمة المسلمين وولاتهم","dorar":"dRjVB6Nf"},{"id":"ق-1072","fp":"b58f351b2181","stateId":238,"easy":"الشكر ← رضا الله","cause":"الشكر","result":"رضا الله","explicit":true,"star":true,"ref":"سورة الزمر: 7","srcLabel":"القرآن الكريم","quran":{"s":39,"from":7,"to":7,"text":"إِنْ تَكْفُرُوا فَإِنَّ اللَّهَ غَنِيٌّ عَنْكُمْ وَلَا يَرْضَى لِعِبَادِهِ الْكُفْرَ وَإِنْ تَشْكُرُوا يَرْضَهُ لَكُمْ وَلَا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَى ثُمَّ إِلَى رَبِّكُمْ مَرْجِعُكُمْ فَيُنَبِّئُكُمْ بِمَا كُنْتُمْ تَعْمَلُونَ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ (7)","hl":[[85,118,1]]}},{"id":"س-06888","fp":"ed82d69136e4","stateId":238,"easy":"إذا شكرت النعمة وأعطيت منها ← يرضى الله عنك (من قصة الأعمى)","cause":"قد كُنتُ أعمى فرَدَّ اللهُ إلَيَّ بَصَري، فخُذْ ما شِئتَ، ودَعْ ما شِئتَ، فواللهِ لا أجهَدُك اليومَ شيئًا أخَذتَه للَّهِ","result":"أمسِكْ مالَك، فإنَّما ابتُليتُم فقد رُضيَ عَنك وسُخِطَ على صاحِبَيك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[1],"ref":"صحيح مسلم 2964","srcLabel":"البخاري","text":["إنَّ ثَلاثةً في بَني إسرائيلَ: أبرَصَ، وأقرَعَ، وأعمى، فأرادَ اللهُ أن يَبتَليَهم، فبَعَثَ إليهم مَلَكًا، فأتى الأبرَصَ، فقال: أيُّ شيءٍ أحَبُّ إلَيك؟ قال: لَونٌ حَسَنٌ، وجِلدٌ حَسَنٌ، ويَذهَبُ عَنِّي الذي قد قَذِرَني النَّاسُ، قال: فمَسَحَه فذَهَبَ عنه قَذَرُه، وأُعطيَ لَونًا حَسَنًا وجِلدًا حَسَنًا، قال: فأيُّ المالِ أحَبُّ إلَيك؟ قال: الإبِلُ أو قال البَقَرُ، شَكَّ إسحاقُ، إلَّا أنَّ الأبرَصَ أوِ الأقرَعَ، قال أحَدُهما: الإبِلُ، وقال الآخَرُ: البَقَرُ، قال: فأُعطيَ ناقةً عُشَراءَ، فقال: بارَك اللهُ لك فيها، قال: فأتى الأقرَعَ، فقال: أيُّ شيءٍ أحَبُّ إلَيك؟ قال: شَعَرٌ حَسَنٌ، ويَذهَبُ عَنِّي هذا الذي قد قَذِرَني النَّاسُ، قال: فمَسَحَه فذَهَبَ عنه، وأُعطيَ شَعَرًا حَسَنًا، قال: فأيُّ المالِ أحَبُّ إلَيك؟ قال: البَقَرُ، فأُعطيَ بَقَرةً حامِلًا، فقال: بارَك اللهُ لك فيها، قال: فأتى الأعمى، فقال: أيُّ شيءٍ أحَبُّ إلَيك؟ قال: أن يَرُدَّ اللهُ إلَيَّ بَصَري، فأُبصِرَ به النَّاسَ، قال: فمَسَحَه فرَدَّ اللهُ إليه بَصَرَه، قال: فأيُّ المالِ أحَبُّ إلَيك؟ قال: الغَنَمُ، فأُعطيَ شاةً والِدًا، فأُنتِجَ هذانِ وولَّدَ هذا، قال: فكانَ لهذا وادٍ مِنَ الإبِلِ، ولهذا وادٍ مِنَ البَقَرِ، ولهذا وادٍ مِنَ الغَنَمِ. قال: ثُمَّ إنَّه أتى الأبرَصَ في صورَتِه وهَيئَتِه، فقال: رَجُلٌ مِسكينٌ، قدِ انقَطَعَت بيَ الحِبالُ في سَفَري، فلا بَلاغَ لي اليومَ إلَّا باللهِ ثُمَّ بك، أسألُك بالذي أعطاك اللَّونَ الحَسَنَ والجِلدَ الحَسَنَ والمالَ، بَعيرًا أتَبَلَّغُ عليه في سَفَري، فقال: الحُقوقُ كَثيرةٌ، فقال له: كَأنِّي أعرِفُك، ألَم تَكُنْ أبرَصَ يَقذَرُك النَّاسُ؟ فقيرًا فأعطاك اللهُ؟ فقال: إنَّما ورِثتُ هذا المالَ كابِرًا عن كابِرٍ، فقال: إن كُنتَ كاذِبًا فصَيَّرَك اللهُ إلى ما كُنتَ. قال: وأتى الأقرَعَ في صورَتِه، فقال له مِثلَ ما قال لهذا، ورَدَّ عليه مِثلَ ما رَدَّ على هذا، فقال: إن كُنتَ كاذِبًا فصَيَّرَك اللهُ إلى ما كُنتَ، قال: وأتى الأعمى في صورَتِه وهَيئَتِه، فقال: رَجُلٌ مِسكينٌ وابنُ سَبيلٍ، انقَطَعَت بيَ الحِبالُ في سَفَري، فلا بَلاغَ لي اليومَ إلَّا باللهِ، ثُمَّ بك، أسألُك بالذي رَدَّ عليك بَصَرَك شاةً أتَبَلَّغُ بها في سَفَري، فقال: ",["قد كُنتُ أعمى فرَدَّ اللهُ إلَيَّ بَصَري، فخُذْ ما شِئتَ، ودَعْ ما شِئتَ، فواللهِ لا أجهَدُك اليومَ شيئًا أخَذتَه للَّهِ",1],"، فقال: ",["أمسِكْ مالَك، فإنَّما ابتُليتُم فقد رُضيَ عَنك وسُخِطَ على صاحِبَيك",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3464) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"xELD1ioR"},{"id":"س-04080","fp":"b3dd5e7e978c","stateId":239,"easy":"إذا عطست ← فالله يحب العطاس","cause":"العُطاسُ","result":"وإنَّ اللهَ يحِبُّ","explicit":true,"star":true,"similar":["س-00182"],"ref":"عارضة الأحوذي 5/382","srcLabel":"متفق عليه","text":[["العُطاسُ",1]," مِن اللهِ، والتَّثاؤُبُ مِن الشَّيطانِ، فإذا تثاءَبَ أحدُكم فلْيضَعْ يَدَهُ على فِيهِ، وإذا قال: (آهْ آهْ) فإنَّ الشَّيطانَ يضحَكُ مِن جَوْفِه، ",["وإنَّ اللهَ يحِبُّ",2]," العُطاسَ ويكْرَهُ التَّثاؤُبَ، فإذا قال الرَّجلُ: (آهْ آهْ) إذا تثاءَبَ، فإنَّ الشَّيطانَ يضحَكُ مِن جَوْفِه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2746) واللفظ له، وأخرجه البخاري (6223) بلفظ مقارب، ومسلم (2994) باختلاف يسير مختصراً","bab":"جن › صفة إبليس وجنوده","dorar":"idSw1nPQ","merged":6,"otherRefs":["صحيح ابن خزيمة 2/ 130 (صحيح)","المستدرك على الصحيحين 7895 (صحيح)","تخريج المسند لشعيب 7599 (حسن)","مختصر الأحكام 2/288 (حسن)","صحيح أبي داود 5028 (صحيح)"]},{"id":"س-00182","fp":"2b62f1662412","stateId":239,"easy":"إذا عطست فحمدت الله ← يحب الله العطاس ويحق على من سمعك أن يشمّتك","cause":"العُطاسَ، ويَكرَهُ التَّثاؤُبَ، فإذا عَطَسَ أحَدُكم وحَمِدَ اللهَ كانَ حَقًّا على كلِّ مُسلِمٍ سَمِعَه أن يَقولُ له: يَرحَمُك اللهُ، وأمَّا التَّثاؤُبُ فإنَّما هو مِن الشَّيْطانِ، فإذا تَثاءَبَ أحَدُكم فلْيَرُدَّ ما اسْتَطاعَ؛ فإنَّ أحَدَكم إذا تَثاءَبَ ضَحِكَ","result":"إنَّ اللهَ يُحِبُّ","explicit":true,"repOf":"س-04080","ref":"الأحكام الوسطى 4/ 221","text":["[\"",["إنَّ اللهَ يُحِبُّ",2],[" العُطاسَ، ويَكرَهُ التَّثاؤُبَ، فإذا عَطَسَ أحَدُكم وحَمِدَ اللهَ كانَ حَقًّا على كلِّ مُسلِمٍ سَمِعَه أن يَقولُ له: يَرحَمُك اللهُ، وأمَّا التَّثاؤُبُ فإنَّما هو مِن الشَّيْطانِ، فإذا تَثاءَبَ أحَدُكم فلْيَرُدَّ ما اسْتَطاعَ؛ فإنَّ أحَدَكم إذا تَثاءَبَ ضَحِكَ",1]," مِنه الشَّيْطانُ\"]، وقالَ النَّسائيُّ: \"يَغفِرُ اللهُ لنا ولكم\"."],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه البخاري (6226)، والترمذي (2747)، وأحمد (9530) واللفظ لهم.","bab":"آداب العطاس › العطاس","dorar":"FvDm70y2","merged":3,"otherRefs":["المستدرك على الصحيحين 7892 (صحيح)","فتاوى نور على الدرب لابن عثيمين 4/579 (صحيح)"]},{"id":"س-06892","fp":"c518954c4f38","stateId":239,"easy":"إذا أحببت التمر ← فالله يحب من يحب التمر","cause":"مَنْ يحبُّ التَّمْرَ","result":"إنَّ اللهَ يحبُّ","explicit":true,"star":true,"ref":"الكامل في الضعفاء 5/249","srcLabel":"البخاري","text":[["إنَّ اللهَ يحبُّ",2]," ",["مَنْ يحبُّ التَّمْرَ",1]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"أتي فيه من مجاعة بن ثابت","takhrij":"أخرجه البخاري في ((التاريخ الكبير)) (8/44)، والطبراني (14/132) (14752)، والخطيب في ((تاريخ بغداد)) (3/166)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"HZUmZZOV"},{"id":"س-03117","fp":"967edda0ef2e","stateId":239,"easy":"إذا أنعم الله عليك فأظهرت أثرها ← يحب الله ذلك","cause":"أنْ تُرى عليه","result":"إنَّ اللهَ إذا أنعَمَ على عبدِه نِعمةً أحَبَّ","explicit":true,"star":true,"similar":["س-00480","س-05799"],"otherNeedIds":[27],"ref":"تخريج مشكل الآثار 3038","srcLabel":"الطحاوي","text":["أتَيْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ وأنا أشعَثُ أغبَرُ، فقال: أما لكَ منَ المالِ؟ فقُلْتُ: كلُّ المالِ قد آتاني اللهُ عزَّ وجلَّ، ثُم قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["إنَّ اللهَ إذا أنعَمَ على عبدِه نِعمةً أحَبَّ",2]," ",["أنْ تُرى عليه",1],"."],"grade":"صحيح","narrator":"مالك بن نضلة الجشمي","muhaddith":"صحيح","bab":"إيمان › توحيد الأسماء والصفات","dorar":"Hxu160g3","merged":9,"otherRefs":["تخريج سير أعلام النبلاء 2/511 (صحيح)","علل الدارقطني 1121 (صحيح)","صحيح الجامع 1711 (صحيح)","المستدرك على الصحيحين 7390 (صحيح)","تخريج الإحياء للعراقي 1/306 (صحيح)","صحيح الجامع 1742 (صحيح)","عمدة التفسير 1/507 (صحيح)","الإلمام بأحاديث الأحكام 1/263 (صحيح)"]},{"id":"س-05713","fp":"d9fd5f81d134","stateId":239,"easy":"إذا أكلت وشربت ولبست وتصدقت بلا مخيلة ولا سرف ← يحب الله أن يرى نعمته عليك","cause":"كُلوا واشرَبوا وتَصَدَّقوا والبَسوا في غيرِ مَخيلَةٍ ولا سَرَفٍ","result":"إنَّ اللهَ يُحِبُّ أن تُرَى نِعمَتُه على عَبدِهِ","explicit":true,"ref":"تخريج المسند لشاكر 10/178","srcLabel":"الترمذي","text":[["كُلوا واشرَبوا وتَصَدَّقوا والبَسوا في غيرِ مَخيلَةٍ ولا سَرَفٍ",1]," ",["إنَّ اللهَ يُحِبُّ أن تُرَى نِعمَتُه على عَبدِهِ",2]],"grade":"صحيح","narrator":"[جد عمرو بن شعيب]","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6708) واللفظ له، وابن ماجه (3605) باختلاف يسير، والترمذي (2819) مختصرا.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"NL0Xywnm","merged":2,"otherRefs":["الأمالي المطلقة 32 (حسن)"]},{"id":"س-00479","fp":"ddc3d6b9a262","stateId":239,"easy":"إذا أنعم الله عليك ← يحب أن يرى أثر نعمته عليك","cause":"مَن أنعَمَ اللهُ عليه نِعمةً","result":"فإنَّ اللهَ يُحِبُّ أنْ يُرى أثرُ نِعمتِه على خَلقِه","explicit":true,"similar":["س-05428"],"ref":"تخريج المسند لشعيب 19934","srcLabel":"أحمد","text":["خَرَجَ علينا عِمرانُ بنُ حُصَينٍ وعليه مِطرَفٌ مِن خَزٍّ لم نَرَه عليه قبلَ ذلك ولا بَعدَه، فقال: إنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال: ",["مَن أنعَمَ اللهُ عليه نِعمةً، ",1],["فإنَّ اللهَ يُحِبُّ أنْ يُرى أثرُ نِعمتِه على خَلقِه",2],". قال رَوحٌ ببَغدادَ: يُحِبُّ أنْ يُرى أثرُ نِعمتِه على عَبدِه."],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (19934)، والطحاوي في ((شرح مشكل الآثار)) (3037)، والطبراني (18/135) (281)","bab":"آداب عامة › المباحات من الأفعال والأقوال","dorar":"ZyfzaO3l"},{"id":"س-00480","fp":"1a0cfde12eed","stateId":239,"easy":"إذا أظهرت أثر نعمة الله عليك ← يحب الله ذلك","cause":"أنْ يَرى أثَرَ نِعمَتِه عليه","result":"إنَّ اللهَ إذا أنعَمَ على عبدِه نِعمةً أحَبَّ","explicit":true,"repOf":"س-03117","ref":"تخريج مشكل الآثار 3037","text":["خرَجَ علينا عِمرانُ بنُ حُصَينٍ وعليه مِطرَفُ خَزٍّ لم أَرَه عليه قبلُ ولا بعدُ، فقال: قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["إنَّ اللهَ إذا أنعَمَ على عبدِه نِعمةً أحَبَّ",2]," ",["أنْ يَرى أثَرَ نِعمَتِه عليه",1],"."],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"إسناده صحيح","bab":"آداب عامة › المباحات من الأفعال والأقوال","dorar":"0JDVfDbV"},{"id":"س-01362","fp":"9599614d7439","stateId":239,"easy":"إذا اجتمعت الأيدي على الطعام ← فهو أحب الطعام إلى الله","cause":"ما كثرتْ عليهِ الأيدِي","result":"أحبُّ الطعامِ إلى اللهِ","explicit":true,"ref":"الجامع الصغير 212","srcLabel":"الطبراني","text":[["أحبُّ الطعامِ إلى اللهِ",2],[" ما كثرتْ عليهِ الأيدِي",1]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أبو يعلى (2045)، والطبراني في ((الأوسط)) (7317)، والبيهقي في ((الشعب)) (9174) واللفظ لهم.","bab":"نكاح › وليمة النكاح","dorar":"SRDPfSHj"},{"id":"س-01549","fp":"11c3625eca2a","stateId":239,"easy":"إذا سمّيت ولدك عبد الله أو عبد الرحمن ← فهي أحب الأسماء إلى الله","cause":"لا تُسمِّه عَزيزًا ولكن سمِّه عبدَ الرَّحمنِ","result":"فإنَّ أحبَّ الأسماءِ إلى اللهِ عبدُ اللهِ وعبدُ الرَّحمنِ","explicit":true,"similar":["س-01544"],"ref":"مجمع الزوائد 8/52","srcLabel":"أحمد","text":["أتَيْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم مع أبي وأنا غلامٌ فقال له النَّبيُّ صلَّى اللهُ عليه وسلَّم ما اسمُ ابنِك هذا قال اسمُه عَزيزٌ فقال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["لا تُسمِّه عَزيزًا ولكن سمِّه عبدَ الرَّحمنِ ",1],["فإنَّ أحبَّ الأسماءِ إلى اللهِ عبدُ اللهِ وعبدُ الرَّحمنِ",2]],"grade":"صحيح","narrator":"عبدالرحمن بن سبرة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (17643)","bab":"أسماء › الأسماء المنهي عنها والمكروهة","dorar":"OlCeuxMs"},{"id":"س-05428","fp":"5c05917e752d","stateId":239,"easy":"إذا أنعم الله عليك ← يحب أن يرى أثر نعمته عليك","cause":"أن يرى أثرَ النِّعمةِ عليه","result":"إنَّ اللهَ تعالى إذا أنعَم على عبدٍ نعمةً ، يحبُّ","explicit":true,"repOf":"س-00479","ref":"صحيح الجامع 1711","text":[["إنَّ اللهَ تعالى إذا أنعَم على عبدٍ نعمةً ، يحبُّ",2]," ",["أن يرى أثرَ النِّعمةِ عليه",1]," ، ويكره البُؤسَ والتَّباؤسَ ، ويُبغِضُ السائلَ الملْحِفَ ، ويحبُّ الحييَّ العفيفَ المتعفِّفَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الإسماعيلي في ((معجم شيوخه)) (224) واللفظ له، وأحمد (8107)، والبيهقي في ((شعب الإيمان)) (6202) باختلاف يسير","bab":"رقائق وزهد › الحياء","dorar":"eZAqAcuc"},{"id":"س-05799","fp":"bc4ecd0ac158","stateId":239,"easy":"إذا آتاك الله مالاً فأظهر أثره عليك ← فإن الله يحب ذلك","cause":"إذا آتاكَ اللهُ مالًا فليُرَ عليكَ","result":"فإنَّ اللهَ يحبُّ أنْ يَرَى أثرَه على عبدِه","explicit":true,"repOf":"س-03117","ref":"الجامع الصغير 330","text":[["إذا آتاكَ اللهُ مالًا فليُرَ عليكَ ، ",1],["فإنَّ اللهَ يحبُّ أنْ يَرَى أثرَه على عبدِه",2]," حَسَنًا ، ولا يحبُّ البؤسَ ولا التباؤسَ"],"grade":"صحيح","narrator":"زهير بن أبي علقمة","muhaddith":"صحيح","takhrij":"أخرجه الحارث كما في ((بغية الباحث)) (570)، والطبراني في ((المعجم الكبير)) (5/ 273) (5308)، وأبو نعيم في ((معرفة الصحابة)) (3075) واللفظ لهم.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"7eK6TpGC"},{"id":"س-06989","fp":"e4242e0abf9a","stateId":239,"easy":"إذا عجّلت الفطر وأخّرت السحور ووضعت يمينك على شمالك في الصلاة ← فهي ثلاث يحبها الله","cause":"تعجيلُ الإفطارِ، وتأخيرُ السُّحورِ، وضَربُ اليَدَينِ إحداهما بالأخرى في الصَّلاةِ","result":"ثلاثةٌ يُحِبُّها اللهُ عزَّ وجَلَّ","explicit":true,"ref":"سبل الهدى والرشاد 8/114","srcLabel":"الطبراني","text":["«",["ثلاثةٌ يُحِبُّها اللهُ عزَّ وجَلَّ",2],": ",["تعجيلُ الإفطارِ، وتأخيرُ السُّحورِ، وضَربُ اليَدَينِ إحداهما بالأخرى في الصَّلاةِ",1],"»"],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"[صحيح]","takhrij":"أخرجه الطبراني كما في ((نصب الراية)) (2/ 470) بنحوه.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"7CsywAQS"},{"id":"س-07147","fp":"33b8c4ac6dac","stateId":239,"easy":"إذا أحببت الجمال في لباسك ← فليس من الكبر، فإن الله جميل يحب الجمال","cause":"لَأُحِبُّ الجَمالَ وأَشتَهِيه","result":"إنَّ اللهَ عزَّ وجلَّ جميلٌ يُحِبُّ الجَمالَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 17369","srcLabel":"أحمد","text":["ما مِن رجُلٍ يَموتُ حين يَموتُ وفي قلْبِه مِثقالُ حَبَّةٍ مِن خَرْدَلٍ مِن كِبْرٍ، تَحِلُّ له الجَنَّةُ أنْ يَرِيحَ رِيحَها ولا يَراها. فقال رجُلٌ مِن قُرَيشٍ يُقالُ له أبو رَيْحانةَ: يا رسولَ اللهِ، واللهِ إنِّي ",["لَأُحِبُّ الجَمالَ وأَشتَهِيه",1],"، حتى إنِّي لَأُحِبُّه في عِلاقةِ سَوْطي، وفي شِراكِ نَعْلي. قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ليس ذاك الكِبْرُ، ",["إنَّ اللهَ عزَّ وجلَّ جميلٌ يُحِبُّ الجَمالَ",2],"، ولكنَّ الكِبْرَ مَن سَفِهَ الحقَّ، وغَمَصَ الناسَ بعَيْنَيْهِ."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (17369)","bab":"علم › حسن السؤال ونصح العالم","dorar":"Y7QffLgB","merged":9,"otherRefs":["الصحيح المسند 810 (حسن)","تخريج مشكل الآثار 5558 (صحيح)","تخريج المسند لشعيب 3789 (صحيح)","صحيح الترمذي 1999 (صحيح)","السلسلة الصحيحة 1626 (صحيح)","السلسلة الصحيحة 4/167 (صحيح)","فتح الباري لابن رجب 2/206 (صحيح)","فتح البيان 10/ 157 (صحيح)"]},{"id":"س-03173","fp":"66afe6302b35","stateId":239,"easy":"إذا تجمّلت في هيئتك بلا كبر ← فإن الله جميل يحب الجمال","cause":"أتَجَمَّلَ بحُبلَّانِ سَوطي، وشِسعِ نَعلي","result":"إنَّ اللهَ عَزَّ وجَلَّ جَميلٌ يُحِبُّ الجَمالَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 17207","srcLabel":"أحمد","text":["«لا يَدخُلُ شَيءٌ مِنَ الكِبرِ الجَنَّةَ». فقال قائِلٌ: يا نَبيَّ اللهِ، إنِّي أُحِبُّ أن ",["أتَجَمَّلَ بحُبلَّانِ سَوطي، وشِسعِ نَعلي",1],"، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: «إنَّ ذلك ليس بالكِبرِ، ",["إنَّ اللهَ عَزَّ وجَلَّ جَميلٌ يُحِبُّ الجَمالَ",2],"، إنَّما الكِبرُ مَن سَفِهَ الحَقَّ، وغَمَصَ النَّاسَ بعَينَيه». يَعني بالحُبلَّانِ: سَيرَ السَّوطِ وشِسعَ النَّعلِ."],"grade":"صحيح","narrator":"أبو ريحانة","muhaddith":"صحيح لغيره","bab":"إيمان › توحيد الأسماء والصفات","dorar":"WIz44Fj4"},{"id":"س-01544","fp":"643804ee14aa","stateId":239,"easy":"إذا سميت عبد الله أو عبد الرحمن ← فهي أحب الأسماء إلى الله","cause":"عَبْدُ اللهِ وعَبْدُ الرَّحْمن","result":"وأَحَبُّ الأسْماءِ إلى اللهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-01549","otherNeedIds":[47],"ref":"الأحكام الوسطى 3/9","text":["تَسمَّوا بأسْماءِ الأنْبِياءِ، ",["وأَحَبُّ الأسْماءِ إلى اللهِ",2]," ",["عَبْدُ اللهِ وعَبْدُ الرَّحْمن",1],"، وارْتَبِطوا الخَيْلَ، وامْسَحوا بنَواصيها وأكْفالِها وقَلِّدوها، ولا تُقلِّدوها الأوْتارَ، وعليكم بكلِّ كُمَيْتٍ أَغَرَّ مُحَجَّلٍ، أو أَشقَرَ أَغَرَّ مُحَجَّلٍ، أو أَدهَمَ أَغَرَّ مُحَجَّلٍ."],"grade":"صحيح","narrator":"أبو وهب الجشمي","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","bab":"أسماء › الأسماء المستحبة","dorar":"wQyBUurF","merged":6,"otherRefs":["شرح مسلم لابن عثيمين 7/258 (صحيح)","المستدرك على الصحيحين 7928 (صحيح)","صحيح الأدب المفرد 625 (صحيح)","السلسلة الصحيحة 1040 (حسن)","تخريج المسند لشعيب 17606 (صحيح)"]},{"id":"س-00831","fp":"ae682c477006","stateId":239,"easy":"إذا أكلت أو شربت فحمدت الله ← يرضى الله عنك","cause":"العَبدِ أن يَأكُلَ الأَكلةَ فيَحمَدَه عليها، أو يَشرَبَ الشَّربةَ فيَحمَدَه عليها","result":"إنَّ اللهَ لَيَرضى عَنِ","explicit":true,"star":true,"ref":"صحيح مسلم 2734","srcLabel":"الترمذي","text":[["إنَّ اللهَ لَيَرضى عَنِ",2],[" العَبدِ أن يَأكُلَ الأَكلةَ فيَحمَدَه عليها، أو يَشرَبَ الشَّربةَ فيَحمَدَه عليها",1],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه الترمذي (1816)، وابن أبي شيبة (24499)، وابن منده في ((التوحيد)) (ص251) واللفظ لهم.","bab":"أدعية وأذكار › فضل التحميد والتسبيح والدعاء","dorar":"oOabSoIV","merged":4,"otherRefs":["زاد المعاد 2/370 (صحيح)","مجموع الفتاوى 17/180 (صحيح)","صحيح الجامع 1816 (صحيح)"]},{"id":"ق-0307","fp":"44745f81810f","stateId":240,"easy":"الحكم بالقسط ← محبة الله","cause":"الحكم بالقسط","result":"محبة الله","explicit":true,"star":true,"ref":"سورة المائدة: 42","srcLabel":"القرآن الكريم","quran":{"s":5,"from":42,"to":42,"text":"سَمَّاعُونَ لِلْكَذِبِ أَكَّالُونَ لِلسُّحْتِ فَإِنْ جَاءُوكَ فَاحْكُمْ بَيْنَهُمْ أَوْ أَعْرِضْ عَنْهُمْ وَإِنْ تُعْرِضْ عَنْهُمْ فَلَنْ يَضُرُّوكَ شَيْئًا وَإِنْ حَكَمْتَ فَاحْكُمْ بَيْنَهُمْ بِالْقِسْطِ إِنَّ اللَّهَ يُحِبُّ الْمُقْسِطِينَ (42)","hl":[[157,242,1]]}},{"id":"ق-1246","fp":"dcf33f28e758","stateId":240,"easy":"الإصلاح بالعدل والقسط ← محبة الله","cause":"الإصلاح بالعدل والقسط","result":"محبة الله","explicit":true,"ref":"سورة الحجرات: 9","srcLabel":"القرآن الكريم","quran":{"s":49,"from":9,"to":9,"text":"وَإِنْ طَائِفَتَانِ مِنَ الْمُؤْمِنِينَ اقْتَتَلُوا فَأَصْلِحُوا بَيْنَهُمَا فَإِنْ بَغَتْ إِحْدَاهُمَا عَلَى الْأُخْرَى فَقَاتِلُوا الَّتِي تَبْغِي حَتَّى تَفِيءَ إِلَى أَمْرِ اللَّهِ فَإِنْ فَاءَتْ فَأَصْلِحُوا بَيْنَهُمَا بِالْعَدْلِ وَأَقْسِطُوا إِنَّ اللَّهَ يُحِبُّ الْمُقْسِطِينَ (9)","hl":[[237,286,1]]}},{"id":"س-07447","fp":"84fb66f5a02f","stateId":240,"easy":"إذا كنت إماماً عادلاً ← تكون أحب الناس إلى الله وأقربهم مجلساً يوم القيامة","cause":"يَوْمَ القِيامةِ وأَدْناهم مِنه مَجلِسًا إمامٌ عادِلٌ","result":"إنَّ أَحَبَّ النَّاسِ إلى اللهِ","explicit":true,"otherNeedIds":[26,45],"ref":"الأحكام الوسطى 2/365","srcLabel":"الترمذي","text":[["إنَّ أَحَبَّ النَّاسِ إلى اللهِ",2],[" يَوْمَ القِيامةِ وأَدْناهم مِنه مَجلِسًا إمامٌ عادِلٌ",1],"، وأَبغَضَ النَّاسِ إلى اللهِ وأَبعَدَهم مِنه مَجلِسًا إمامٌ جائِرٌ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه الترمذي (1329) واللفظ له، وأحمد (11174)، والبغوي في ((الجعديات)) (2035) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"Jup4rQ9h","merged":3,"otherRefs":["شرح السنة 5/314 (حسن)","الزواجر عن اقتراف الكبائر 2/115 (حسن)"]},{"id":"س-06820","fp":"ea562c1eb27d","stateId":240,"easy":"إذا عدلت في الحكم وأحسنت حتى في القتل ← فالله محسن يحب المحسنين","cause":"إذا حكمتم فاعدِلُوا وإذا قتلتم فأحسِنُوا","result":"فإنَّ اللهَ عزَّ وجلَّ محسنٌ يحبُّ المُحسنينَ","explicit":true,"ref":"مجمع الزوائد 5/200","srcLabel":"الطبراني","text":[["إذا حكمتم فاعدِلُوا وإذا قتلتم فأحسِنُوا ",1],["فإنَّ اللهَ عزَّ وجلَّ محسنٌ يحبُّ المُحسنينَ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"رجاله ثقات","takhrij":"أخرجه ابن أبي عاصم في ((الديات)) (ص52)، والطبراني في ((المعجم الأوسط)) (5735)","bab":"عقيدة › إثبات أسماء الله","dorar":"lI7fyCDb"},{"id":"س-05047","fp":"740a30d6aa87","stateId":241,"easy":"إذا كنت مؤمناً قوياً ← فأنت خير وأحب إلى الله من المؤمن الضعيف","cause":"الْمُؤْمِنُ القَوِيُّ","result":"خَيْرٌ وَأَحَبُّ إلى اللهِ مِنَ المُؤْمِنِ الضَّعِيفِ","explicit":true,"star":true,"otherNeedIds":[16],"ref":"مختصر المقاصد 824","srcLabel":"مسلم","text":["لو تفتحُ عملَ الشَّيطانِ [يعني حديث: ",["الْمُؤْمِنُ القَوِيُّ",1]," ",["خَيْرٌ وَأَحَبُّ إلى اللهِ مِنَ المُؤْمِنِ الضَّعِيفِ",2],"، وفي كُلٍّ خَيْرٌ. احْرِصْ علَى ما يَنْفَعُكَ، وَاسْتَعِنْ باللَّهِ وَلَا تَعْجِزْ، وإنْ أَصَابَكَ شَيءٌ، فلا تَقُلْ: لو أَنِّي فَعَلْتُ كانَ كَذَا وَكَذَا، وَلَكِنْ قُلْ: قَدَرُ اللهِ وَما شَاءَ فَعَلَ؛ فإنَّ (لو) تَفْتَحُ عَمَلَ الشَّيْطَانِ.]"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2664) مطولاً","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"V6LVEaum","merged":2,"otherRefs":["صحيح ابن حبان 5721 (صحيح)"]},{"id":"س-06933","fp":"f6567361728a","stateId":241,"easy":"إذا أخذت برخص الله ← فإنه يحب أن تُؤتى رخصه","cause":"أن يُؤخذَ برُخصِهِ","result":"إنَّ اللهَ يحبُّ","explicit":true,"ref":"مسند عمر 1/235","srcLabel":"ابن عدي","text":["أنَّ رجلًا قال لرسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ أَقصُرُ الصلاةَ في سفري؟ قال نعم ",["إنَّ اللهَ يحبُّ",2]," ",["أن يُؤخذَ برُخصِهِ",1]," كما يُحبُّ أن يُؤخذَ بفريضتِهِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (5/ 64) بزيادة في آخره.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"vgLAvNBB","merged":5,"otherRefs":["مجموع فتاوى ابن باز 238/15 (صحيح)","إتحاف الخيرة المهرة 1/388 (حسن)","التمهيد 24/67 (صحيح)","الترغيب والترهيب 1/147 (صحيح)"]},{"id":"س-07576","fp":"d6e09535986a","stateId":241,"easy":"إذا داومت على العمل وإن قل ← فهو أحب الأعمال إلى الله","cause":"أدْوَمُها، وإنْ قَلَّ","result":"إنَّ أحَبَّ الأعمالِ إلى اللهِ","explicit":true,"star":true,"similar":["س-01884","س-01857","س-01807"],"otherNeedIds":[45,47],"ref":"تخريج المسند لشعيب 26307","srcLabel":"متفق عليه","text":["كان النَّاسُ يُصَلُّونَ في مسجِدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في رَمَضانَ باللَّيلِ أوْزاعًا، يَكونُ مع الرَّجُلِ الشَّيءُ مِنَ القُرآنِ، فيكونُ معه النَّفَرُ الخَمسةُ، أوِ السِّتَّةُ، أو أقَلُّ مِن ذلك أو أكثَرُ، يُصَلُّونَ بصَلاتِه، قالَتْ: فأمَرَني رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ لَيلةً مِن ذلك أنْ أنْصِبَ له حَصيرًا على بابِ حُجْرَتي، ففعَلتُ، فخرَجَ إليهِ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بَعدَ أنْ صلَّى العِشاءَ الآخِرةَ، قالَتْ: فاجتَمَعَ إليه مَن في المسجِدِ، فصلَّى بهم رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ لَيلًا طَويلًا، ثم انصَرَفَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فدخَلَ، وترَكَ الحَصيرَ على حالِه، فلمَّا أصبَحَ النَّاسُ تَحَدَّثوا بِصلاةِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ بمَن كان معه في المسجِدِ تلك اللَّيلةَ، قالَتْ: وأمْسى المسجِدُ راجًّا بِالنَّاسِ، فصلَّى بهم رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ العِشاءَ الآخِرةَ، ثم دخَلَ بَيتَه وثبَتَ النَّاسُ، قالَتْ: فقال لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ما شَأنُ النَّاسِ يا عائِشةُ؟ قالَتْ: فقُلتُ له: يا رسولَ اللهِ، سمِعَ النَّاسُ بِصَلاتِكَ البارِحةَ بمَن كان في المسجِدِ، فحشَدوا لذلك؛ لتُصَلِّيَ بهم، قالَتْ: فقال: اطْوِ عنَّا حَصيرَكِ يا عائِشةُ، قالَتْ: ففَعَلتُ، وباتَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ غَيرَ غافِلٍ، وثبَتَ النَّاسُ مَكانَهُم حتى خرَجَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ إلى الصُّبحِ، فقالَتْ: فقال: أيُّها النَّاسُ، أمَا واللهِ ما بِتُّ -والحَمدُ للهِ- لَيلَتي هذه غافِلًا، وما خَفِيَ علَيَّ مَكانُكُم، ولكنِّي تَخوَّفتُ أنْ يُفتَرَضَ عليكم؛ فاكْلَفوا مِنَ الأعمالِ ما تُطيقونَ؛ فإنَّ اللهَ لا يَمَلُّ حتى تَمَلُّوا، قال: وكانَتْ عائِشةُ تَقولُ: ",["إنَّ أحَبَّ الأعمالِ إلى اللهِ",2],[" أدْوَمُها، وإنْ قَلَّ",1],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح لغيره","takhrij":"أخرجه البخاري (5861)، ومسلم (782)، وأبو داود (1368)، والترمذي (2856)، والنسائي (762) مختصراً، وأحمد (26307) واللفظ له.","bab":"فضائل النبي وصفته ودلائل النبوة › شفقته على أمته","dorar":"uov3XybL","merged":23,"otherRefs":["صحيح النسائي 1654 (صحيح)","صحيح البخاري 6464 (صحيح)","تخريج المسند لشعيب 25632 (صحيح)","صحيح مسلم 785 (صحيح)","تخريج المسند لشعيب 24322 (صحيح)","تخريج المسند لشعيب 25945 (صحيح)","تخريج مشكل الآثار 650 (صحيح)","الجامع الصغير 6498 (صحيح)","تخريج المسند لشعيب 26131 (صحيح)","صحيح ابن ماجه 1017 (صحيح)","صحيح النسائي 1615 (صحيح)","تخريج المسند لشعيب 24043 (صحيح)","صحيح الجامع 4626 (صحيح)","صحيح ابن خزيمة 2/ 437 (صحيح)","صحيح مسلم 782 (صحيح)","صحيح النسائي 1641 (صحيح)","صحيح البخاري 6461 (صحيح)","صحيح مسلم 741 (صحيح)","معجم الشيوخ 2/1214 (حسن)","صحيح البخاري 6465 (صحيح)","صحيح ابن حبان 2444 (صحيح)","صحيح مسلم 783 (صحيح)"]},{"id":"س-01884","fp":"09fe84666318","stateId":241,"easy":"إذا داومت على العمل وإن قل ← فهو أحب العمل إلى الله","cause":"أدومُه وإن قَلَّ","result":"أنَّ أحَبَّ العَمَلِ إلى اللهِ","explicit":true,"repOf":"س-07576","ref":"صحيح مسلم 2818","text":["سَدِّدوا وقارِبوا وأبشِروا؛ فإنَّه لَن يُدخِلَ الجَنَّةَ أحَدًا عَمَلُه، قالوا: ولا أنتَ يا رَسولَ اللهِ؟ قال: ولا أنا، إلَّا أن يَتَغَمَّدَنيَ اللهُ منه برَحمةٍ، واعلَموا ",["أنَّ أحَبَّ العَمَلِ إلى اللهِ",2]," ",["أدومُه وإن قَلَّ",1],". وفي روايةٍ بهذا الإسنادِ، ولَم يَذكُرْ: وأبشِروا."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6464)، ومسلم (2818).","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"maPTtpOF","merged":2,"otherRefs":["تخريج المسند لشعيب 25431 (صحيح)"]},{"id":"س-01857","fp":"c1d477b7dc6d","stateId":241,"easy":"إذا تكلفت من العمل ما تطيق وداومت عليه ← فهو أحب العمل إلى الله","cause":"اكلَفوا منَ العمَلِ ما تُطيقونَ","result":"فإنَّ اللَّهَ عزَّ وجلَّ لا يَملُّ حتَّى تَملُّوا وإنَّ أحبَّ الأعمالِ إلى اللَّهِ عزَّ وجلَّ أدوَمُهُ ، وإن قَلَّ","explicit":true,"repOf":"س-07576","ref":"صحيح النسائي 761","text":["كانَ لِرَسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ حَصيرةٌ ، يَبسُطُها بالنَّهارِ ويحتَجِرُها باللَّيلِ فيصلِّي فيها ففَطِنَ لَه النَّاسُ فَصلَّوا بصَلاتِه وبينَه وبينَهمُ الحصيرَةُ فقالَ ",["اكلَفوا منَ العمَلِ ما تُطيقونَ ",1],["فإنَّ اللَّهَ عزَّ وجلَّ لا يَملُّ حتَّى تَملُّوا وإنَّ أحبَّ الأعمالِ إلى اللَّهِ عزَّ وجلَّ أدوَمُهُ ، وإن قَلَّ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"حسن صحيح","takhrij":"أخرجه النسائي (762) واللفظ له، وأخرجه البخاري (730، 1970) مفرقاً باختلاف يسير، ومسلم (782) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"b82SNW04"},{"id":"س-02697","fp":"95f9d81f50d8","stateId":241,"easy":"إذا أخذت من العمل ما تطيق ← لا يمل الله حتى تملّ","cause":"خُذوا مِن العملِ ما تُطيقونَ","result":"لا يسأَمُ اللهُ حتَّى تسأَموا","explicit":true,"similar":["س-06911"],"ref":"تخريج صحيح ابن حبان 2586","srcLabel":"مسلم","text":["أنَّ عائشةَ أخبَرَته أنَّ الحولاءَ بنتَ تُوَيتِ بنِ حبيبِ بنِ عبدِ العزَّى مرَّت بها وعندها رسولُ اللهِ صلَّى اللهُ عليه وسلَّم قالت: فقُلْتُ: هذه الحولاءُ بنتُ تُوَيْتٍ زعَموا أنَّها لا تنامُ باللَّيلِ قالت: فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ( لا تنامُ اللَّيلَ ! ",["خُذوا مِن العملِ ما تُطيقونَ",1]," فواللهِ ",["لا يسأَمُ اللهُ حتَّى تسأَموا",2]," )"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (785)، وأحمد (26095)، وعبد بن حميد (1483)، وابن حبان (2586) واللفظ لهم جميعا.","bab":"إيمان › الدين يسر","dorar":"dylY5BGV","merged":2,"otherRefs":["صحيح ابن خزيمة 2/ 437 (صحيح)"]},{"id":"س-06911","fp":"eb23263e8809","stateId":241,"easy":"إذا أخذت من الأعمال ما تطيق ← فالله لا يمل حتى تملّ، وأحب العمل أدومه","cause":"خُذوا مِنَ الأعمالِ ما تُطيقونَ","result":"فإنَّ اللهَ لا يَمَلُّ حتَّى تَمَلُّوا، وإنَّ أحَبَّ الأعمالِ إلى اللهِ ما دامَ وإن قَلَّ","explicit":true,"repOf":"س-02697","ref":"صحيح البخاري 5861","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم كان يَحتَجِرُ حَصيرًا باللَّيلِ فيُصَلِّي عليه، ويَبسُطُه بالنَّهارِ فيَجلِسُ عليه، فجَعَلَ النَّاسُ يَثوبونَ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم فيُصَلُّونَ بصَلاتِه حتَّى كَثُروا، فأقبَلَ فقال: يا أيُّها النَّاسُ، ",["خُذوا مِنَ الأعمالِ ما تُطيقونَ؛ ",1],["فإنَّ اللهَ لا يَمَلُّ حتَّى تَمَلُّوا، وإنَّ أحَبَّ الأعمالِ إلى اللهِ ما دامَ وإن قَلَّ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (782) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"58UdDzUM","merged":2,"otherRefs":["صحيح مسلم 782 (صحيح)"]},{"id":"س-01807","fp":"81ed893409c6","stateId":241,"easy":"إذا داومت على عمل ولو كان يسيراً ← فهو أحب العمل إلى الله","cause":"الذي يدومُ عليه العبدُ، وإن كان يَسيرًا","result":"وكان أَعجَبُ العمَلِ إليه","explicit":true,"repOf":"س-07576","otherNeedIds":[45],"ref":"تخريج المسند لشعيب 26599","text":["والذي توفَّى نفسَه -تَعني النَّبيَّ صلَّى اللهُ عليهِ وسلَّمَ- ما تُوُفِّيَ حتى كانَتْ أكثرُ صَلاتِه قاعدًا إلَّا المكتوبةَ، ",["وكان أَعجَبُ العمَلِ إليه",2]," ",["الذي يدومُ عليه العبدُ، وإن كان يَسيرًا",1],"."],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (1655)، وابن ماجه (1225)، وأحمد (26599) واللفظ له","bab":"أيمان › لفظ اليمين وما يحلف به","dorar":"GRCJL7XP"},{"id":"س-06900","fp":"ecc71a951715","stateId":241,"easy":"إذا عملت عملاً فأحسنته ← يحبك الله","cause":"منَ العامِلِ إذا عَمِلَ أن يُحْسنَ","result":"إنَّ اللهَ تعالى يُحِبُّ","explicit":true,"star":true,"similar":["س-06949"],"ref":"صحيح الجامع 1891","srcLabel":"البيهقي","text":[["إنَّ اللهَ تعالى يُحِبُّ",2],[" منَ العامِلِ إذا عَمِلَ أن يُحْسنَ",1]],"grade":"حسن","narrator":"كليب الجهني","muhaddith":"حسن","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (4932)، وابن أبي خيثمة في ((تاريخه-السفر الثاني)) (1/ 521)، والبغوي في ((معجم الصحابة)) (2037) بلفظه تامًا.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"0RcZpNgp"},{"id":"س-06949","fp":"e5dcfe00b954","stateId":241,"easy":"إذا عملت عملاً فأتقنته ← يحب الله ذلك","cause":"إذا عمِلَ أحدُكمْ عملًا أنْ يُتقِنَهُ","result":"إنَّ اللهَ تعالى يُحِبُّ","explicit":true,"repOf":"س-06900","ref":"صحيح الجامع 1880","text":[["إنَّ اللهَ تعالى يُحِبُّ",2],[" إذا عمِلَ أحدُكمْ عملًا أنْ يُتقِنَهُ",1]],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"حسن","takhrij":"أخرجه أبو يعلى الموصلي (4386)، والطبراني في ((المعجم الأوسط)) (897)، والبيهقي في ((شعب الإيمان)) (4929) جميعهم بلفظه.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"UtSlZmEN"},{"id":"س-03480","fp":"ded40a6005ed","stateId":242,"easy":"إذا وقفت بعرفة أشعث أغبر ← يباهي الله بك ملائكة السماء","cause":"بأهلِ عرفاتٍ ملائكةَ السَّماءِ ، يقولُ : انظروا إلى عبادي ، أتَوْني شُعثًا غُبرًا من كلِّ فجٍّ عميقٍ ، أُشهِدُكم أنِّي قد غفرتُ لهم","result":"إنَّ اللهَ تعالَى يُباهي","explicit":true,"star":true,"apply":{"k":"time","t":"يوم عرفة"},"otherNeedIds":[11],"ref":"حلية الأولياء 3/349","srcLabel":"أحمد","text":[["إنَّ اللهَ تعالَى يُباهي",2],[" بأهلِ عرفاتٍ ملائكةَ السَّماءِ ، يقولُ : انظروا إلى عبادي ، أتَوْني شُعثًا غُبرًا من كلِّ فجٍّ عميقٍ ، أُشهِدُكم أنِّي قد غفرتُ لهم",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح من حديث سعيد بن المسيب عن عائشة غريب من حديث مجاهد عن أبي هريرة","takhrij":"أخرجه أحمد (8047)، وابن خزيمة (2839)، وابن حبان (3852) مختصراً باختلاف يسير","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"9GzHerPI","merged":6,"otherRefs":["مجموع الفتاوى 5/130 (صحيح)","صحيح الموارد 836 (صحيح)","الفتاوى الكبرى 1/ 335 (صحيح)","صحيح الجامع 1868 (صحيح)","تخريج المسند لشاكر 15/193 (صحيح)"]},{"id":"س-06234","fp":"e92450604fa7","stateId":243,"easy":"إذا طلبت العلم ← تضع لك الملائكة أجنحتها رضاً بما تطلب","cause":"لطالِبِ العِلمِ","result":"إنَّ المَلائِكةَ تَضَعُ أجْنِحتَها لطالِبِ العِلمِ رِضًا بما يَطلُبُ","explicit":true,"star":true,"similar":["س-07255"],"otherNeedIds":[18],"ref":"الأحاديث المختارة 8 / 33","srcLabel":"متفق عليه","text":["«أتَيْتُ صَفْوانَ بنَ عَسَّالٍ المُرادِيَّ رَضيَ اللهُ عنه؛ فقالَ: ما جاءَ بك؟ قُلْتُ: جِئْتُ ابْتِغاءَ العِلمِ، قالَ: ف",["إنَّ المَلائِكةَ تَضَعُ أجْنِحتَها لطالِبِ العِلمِ رِضًا بما يَطلُبُ",2],"، قالَ: قُلْتُ: حَكَّ في نَفْسي أو صَدْري مَسْحٌ على الخُفَّينِ بَعْدَ الغائِطِ والبَوْلِ، فهلْ سَمِعْتَ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في ذلك شَيئًا؟ قالَ: نَعمْ، كانَ يَأمُرُنا إذا كُنَّا سَفَرًا أو مُسافِرينَ ألَّا نَنزِعَ خِفافَنا ثَلاثةَ أيَّامٍ ولَياليهنَّ إلَّا مِن جَنابةٍ؛ ولكنْ مِن غائِطٍ وبَوْلٍ ونَوْمٍ، قُلْتُ: هلْ سَمِعْتَه يَذكُرُ الهَوى؟ قالَ: نَعمْ، بَيْنا نحن معَه في مَسيرٍ إذ ناداه أعْرابيٌّ بصَوْتٍ جَهْوَرِيٍّ فقالَ: يا مُحمَّدُ، فأجابَه على نَحْوٍ مِن كَلامِه: (هاء). وقالَ: أرَأَيْتَ رَجُلًا أحَبَّ قَوْمًا ولمَّا يَلحَقْ بهم؟ قالَ: (المَرْءُ معَ مَن أَحَبَّ). ثُمَّ لم يَزَلْ يُحَدِّثُنا (إنَّ مِن قِبَلِ المَغرِبِ بابًا يَفتَحُ اللهُ للتَّوبةِ، مَسيرةُ عَرْضِه أرْبَعونَ سَنَةً، فلا يُغلَقُ حتَّى تَطلُعَ الشَّمْسُ) يَعْني مِنه.\nلَفْظُ حَديثِ مُحمَّدِ بنِ عاصِمٍ.\nوفي رِوايةِ عَبْدِ الرَّزَّاقِ قالَ: أتَيْتُ صَفْوانَ بنَ عَسَّالٍ؛ فقالَ: ما جاءَ بك؟ قُلْتُ: ابْتِغاء العِلمِ.\nوعِنْدَه قُلْتُ: حاكَ في صَدْري مَسْحٌ على الخُفَّينِ بَعْدَ الغائِطِ والبَوْلِ، وكُنْتُ امْرَأً مِن أصْحابِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فأتَيْتُك أسْأَلُك عن ذلك، هلْ سَمِعْتَ مِنه في ذلك شَيئًا؟ قالَ: نَعمْ.\nوعِنْدَه: أو كُنَّا مُسافِرينَ.\nوعِنْدَه: قُلْتُ: أسَمِعْتَه يَذكُرُ الهَوى؟\nوعِنْدَه: بصَوْتٍ جَهْوَريٍّ -أو قالَ: (جَوْهَريٍّ) -ابنُ عُيَيْنةَ شَكَّ- قالَ:\nوعِنْدَه: فأجابَه بنَحْوٍ مِن كَلامِه، فقالَ: مَهْ، قالَ: أرَأَيْتَ.\nوعِنْدَه: ولم يَلحَقْ بهم، قالَ: (هو يَوْمَ القِيامةِ معَ مَن أحَبَّ). قالَ: فلم يَزَلْ يُحَدِّثُنا حتَّى قالَ: (إنَّ مِن قِبَلِ المَغرِبِ بابًا مَسيرةُ عَرْضِه سَبْعونَ سَنَةً، فَتَحَه اللهُ للتَّوْبةِ يَوْمَ خَلَقَ السَّمواتِ والأرْضَ، ولا يُغلِقُه حتَّى تَطلُعَ الشَّمْسُ مِن نَحْوِه»."],"grade":"صحيح","narrator":"صفوان بن عسال المرادي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"سفر › المسح على الخفين في السفر","dorar":"0S0WIi8D","merged":5,"otherRefs":["الأحاديث المختارة 8 / 36 (صحيح)","صحيح النسائي 158 (حسن)","الأحاديث المختارة 8 / 35 (صحيح)","تخريج العواصم والقواصم 4/ 25 (حسن)"]},{"id":"س-07255","fp":"1a416a5cce1a","stateId":243,"easy":"إذا خرجت في طلب العلم ← تبسط لك الملائكة أجنحتها رضاً بما تفعل","cause":"ما مِنْ رَجُلٍ يَخْرُجُ في طَلَبِ العِلْمِ","result":"إلَّا بَسَطَتْ له المَلائكَةُ أَجْنِحَتَها؛ رضًا بما يَفْعَلُ حتَّى يَرْجِعَ","explicit":true,"repOf":"س-06234","otherNeedIds":[18],"ref":"المستدرك على الصحيحين 344","text":["عنْ صَفْوانَ بِنْ عَسَّالٍ المُراديِّ، أنَّه جاءَ يَسْأَلُهُ عن شَيءٍ، فقالَ: ما أَعْمَلَكَ إلَيَّ إلَّا ذلك؟ قالَ: ما أَعْمَلْتُ إليكَ إلَّا لِذلك، قالَ: فَأَبْشِرْ؛ فإنَّه ",["ما مِنْ رَجُلٍ يَخْرُجُ في طَلَبِ العِلْمِ،",1]," ",["إلَّا بَسَطَتْ له المَلائكَةُ أَجْنِحَتَها؛ رضًا بما يَفْعَلُ حتَّى يَرْجِعَ",2],"."],"grade":"صحيح","narrator":"زر بن حبيش","muhaddith":"[إسناده صحيح]","takhrij":"أخرجه ابن ماجه (226)، وأحمد (18093) بنحوه.","bab":"علم › فضل مجالس العلم والذكر","dorar":"28RpkhRD"},{"id":"س-03672","fp":"2a32f64496a1","stateId":244,"easy":"إذا أطعت الأمير ← فقد أطعت النبي ﷺ","cause":"ومَن يُطِعِ الأميرَ","result":"فقد أطاعَني","explicit":true,"star":true,"similar":["س-03704"],"ref":"صحيح البخاري 2957","srcLabel":"متفق عليه","text":["مَن أطاعَني فقد أطاعَ اللهَ، ومَن عَصاني فقد عَصى اللهَ، ",["ومَن يُطِعِ الأميرَ",1]," ",["فقد أطاعَني",2],"، ومَن يَعصِ الأميرَ فقد عَصاني، وإنَّما الإمامُ جُنَّةٌ يُقاتَلُ مِن ورائِه ويُتَّقى به، فإن أمَرَ بتَقوى اللهِ وعَدَلَ فإنَّ له بذلك أجرًا، وإن قال بغَيرِه فإنَّ عليه منه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2957)، ومسلم (1835)","bab":"اعتصام بالسنة › الأمر بالتمسك بالكتاب والسنة","dorar":"50wib7r4"},{"id":"س-03704","fp":"ddd93abb6ad7","stateId":244,"easy":"إذا أطعت الأمير ← فقد أطعت النبي ﷺ","cause":"ومن أطاعَ الأميرَ","result":"فقد أطاعَني","explicit":true,"repOf":"س-03672","ref":"صحيح ابن خزيمة 3/ 104","text":["مَن أطاعَني فَقد أطاعَ اللَّهَ، ومَن عَصاني فقد عَصَى اللَّهَ، ",["ومن أطاعَ الأميرَ",1]," ",["فقد أطاعَني",2],"، ومَن عصا الأميرَ فقد عَصاني، إنَّما الإمامُ جنَّةٌ، فإذا صلَّى قاعدًا فصلُّوا قعودًا، وإذا قالَ: سمِعَ اللَّهُ لمن حمدَهُ، فقولوا: اللَّهمَّ ربَّنا لَكَ الحمدُ، فإذا وافقَ قَولُ أَهْلِ الأرضِ قولَ أَهْلِ السَّماءِ غُفِرَ لَهُ ما مضَى مِن ذنبِهِ، ويَهْلِكُ كِسرى ولا كِسرى بعدُ، ويَهْلِكُ قَيصرُ فلا قَيصرَ مِن بعدِهِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (7137)، ومسلم (1835)، والنسائي (4193) بلفظه مختصرًا.","bab":"اعتصام بالسنة › لزوم السنة","dorar":"KojlJ7bG"}]}