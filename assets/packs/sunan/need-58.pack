{"schema":1,"kind":"sunan-chunk","version":"sunan-b41390b43331","needId":58,"stateIds":[625],"items":[{"id":"س-01574","fp":"9276b57d41ed","stateId":625,"easy":"إذا استقامت الأئمة ← استقام أمر الناس","cause":"ما استقامَتِ الأئمَّةُ","result":"حتَّى مَتى أمرُ النَّاسِ هكذا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[53],"ref":"المستدرك على الصحيحين 8614","srcLabel":"البخاري","text":["عَنْ حَيَّةَ بِنْتِ أَبِي حَيَّةَ، قَالَتْ: دخَلَ علَيَّ رجُلٌ بالظَّهيرةِ، قُلتُ: يا عبْدَ اللهِ، ما حاجتُك؟ قال: أقبَلْتُ وصاحبٌ لي في بُغاءِ إبلٍ لنا، فدخَلْتُ أستَظِلُّ بالظِّلِّ، وأشْرَبُ مِنَ الشَّرابِ، فقُمتُ إلى ضَيْحةٍ حامضةٍ ولُبَيْنةٍ حامضةٍ، فسَقَيْتُه، وقلْتُ: يا عبْدَ اللهِ، مَن أنتَ؟ قال: أنا أبو بَكرٍ صاحبُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ الَّذي سَمِعتَ به، قال: فذكَرْتُ خَثْعَمًا، وغزْوَ بعضِنا بعضًا في الجاهليَّةِ، وما جاء اللهُ مِنَ الإلفةِ وأطنابِ الفَساطيطِ هكذا -وشبَّكَ بيْن أصابعِه- قالت: فقُلتُ: يا عبْدَ اللهِ، ",["حتَّى مَتى أمرُ النَّاسِ هكذا",2],"؟ قال: ",["ما استقامَتِ الأئمَّةُ",1],"، قالت: قُلتُ: وما الأئمَّةُ؟ قال: ألمْ تَرَي إلى الحُوى يكونُ فيه السَّيِّدُ يَتْبَعونَه ويُطِيعونه ما استقامَ أولئكَ؟"],"grade":"صحيح","narrator":"حية بنت أبي حية","muhaddith":"صحيح الإسناد، ولم يخرجاه","takhrij":"أخرجه مسدد كما في ((المطالب العالية)) (2128) بلفظه، والبخاري (3834) بنحوه.","bab":"أشربة › اللبن","dorar":"VRJw7YWA"},{"id":"س-01243","fp":"15aa986d4cfe","stateId":625,"easy":"إذا قلت لا إله إلا الله ← تدين لك العرب والعجم","cause":"لا إلهَ إلَّا اللهُ","result":"كَلِمةٍ واحِدةٍ تَدينُ لهم بها العَربُ وتُؤَدِّي إليهم بها العَجَمُ الجِزْيةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"الأحاديث المختارة 10 / 392","srcLabel":"متفق عليه","text":["«لمَّا مَرِضَ أبو طالِبٍ دَخَلَ عليه رَهْطٌ مِن قُرَيشٍ فيهم أبو جَهْلٍ، فقالوا يا أبا طالِبٍ: إنَّ ابنَ أخيك يَشتِمُ آلِهتَنا يقولُ ويقولُ، ويَفعَلُ ويَفعَلُ، فأَرْسِلْ إليه فانْهَه، قالَ: فأَرسَلَ إليه أبو طالِبٍ، وكانَ قُرْبَ أبي طالِبٍ مَوضِعُ رِجْلٍ، فخَشِيَ إن دَخَلَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ على عَمِّه يكونُ أَرَقَّ له عليه، فوَثَبَ فجَلَسَ في ذلك المَجلِسِ، فلمَّا دَخَلَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ فلم يَجِدْ مَجلِسًا إلَّا عِنْدَ البابِ فجَلَسَ، فقالَ له أبو طالِبٍ: يا بنَ أخي، إنَّ قَوْمَك يَشكُونَك يَزعُمونَ أنَّك تَشتُمُ آلِهتَهم وتَقولُ وتَقولُ وتَفعَلُ وتَفعَلُ، فقالَ: يا عَمِّ إنِّي إنَّما أرَدْتُهم على ",["كَلِمةٍ واحِدةٍ تَدينُ لهم بها العَربُ وتُؤَدِّي إليهم بها العَجَمُ الجِزْيةَ",2],"، قالوا: وما هي؟ نَعمْ وأبيك وعَشْرًا! قالَ: ",["لا إلهَ إلَّا اللهُ",1],"، قالَ: فقاموا وهُمْ يَنْفُضونَ ثِيابَهم وهُمْ يَقولونَ: {أَجَعَلَ الْآلِهَةَ إِلَهًا وَاحِدًا إِنَّ هَذَا لَشَيْءٌ عُجَابٌ}، قالَ: ثُمَّ قَرَأَ حتَّى بَلَغَ: {لَمَّا يَذُوقُوا عَذَابِ}»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"HO1Sjx6n","merged":6,"otherRefs":["سنن الترمذي 3232 (حسن)","صحيح ابن حبان 6686 (صحيح)","المستدرك على الصحيحين 3663 (صحيح)","الأحاديث المختارة 10 / 389 (صحيح)"]},{"id":"ق-0042","fp":"f845f5989a48","stateId":625,"easy":"إتمام ما ابتلى الله به عبده من التكاليف ← الإمامة في الدين","cause":"إتمام ما ابتلى الله به عبده من التكاليف","result":"الإمامة في الدين","explicit":true,"star":true,"ref":"سورة البقرة: 124","srcLabel":"القرآن الكريم","quran":{"s":2,"from":124,"to":124,"text":"وَإِذِ ابْتَلَى إِبْرَاهِيمَ رَبُّهُ بِكَلِمَاتٍ فَأَتَمَّهُنَّ قَالَ إِنِّي جَاعِلُكَ لِلنَّاسِ إِمَامًا قَالَ وَمِنْ ذُرِّيَّتِي قَالَ لَا يَنَالُ عَهْدِي الظَّالِمِينَ (124)","hl":[[0,64,1],[64,105,2]]}},{"id":"ق-0061","fp":"4576b80b83c0","stateId":625,"easy":"إقامة القصاص ← حياة للناس وأمن وتقوى","cause":"إقامة القصاص","result":"حياة للناس وأمن وتقوى","explicit":true,"star":true,"otherNeedIds":[17],"ref":"سورة البقرة: 179","srcLabel":"القرآن الكريم","quran":{"s":2,"from":179,"to":179,"text":"وَلَكُمْ فِي الْقِصَاصِ حَيَاةٌ يَا أُولِي الْأَلْبَابِ لَعَلَّكُمْ تَتَّقُونَ (179)","hl":[[0,24,1],[24,31,2],[31,56,1],[56,78,2]]}},{"id":"ق-0153","fp":"c0d4983a3ef4","stateId":625,"easy":"الأمر بالمعروف والنهي عن المنكر والإيمان بالله ← الخيرية بين الأمم","cause":"الأمر بالمعروف والنهي عن المنكر والإيمان بالله","result":"الخيرية بين الأمم","explicit":true,"star":true,"ref":"سورة آل عمران: 110","srcLabel":"القرآن الكريم","quran":{"s":3,"from":110,"to":110,"text":"كُنْتُمْ خَيْرَ أُمَّةٍ أُخْرِجَتْ لِلنَّاسِ تَأْمُرُونَ بِالْمَعْرُوفِ وَتَنْهَوْنَ عَنِ الْمُنْكَرِ وَتُؤْمِنُونَ بِاللَّهِ وَلَوْ آمَنَ أَهْلُ الْكِتَابِ لَكَانَ خَيْرًا لَهُمْ مِنْهُمُ الْمُؤْمِنُونَ وَأَكْثَرُهُمُ الْفَاسِقُونَ (110)","hl":[[0,44,2],[44,125,1]]}},{"id":"ق-0166","fp":"888e3c3bcb56","stateId":625,"easy":"الإيمان ← العلو وذهاب الوهن والحزن","cause":"الإيمان","result":"العلو وذهاب الوهن والحزن","explicit":true,"star":true,"similar":["ق-1225"],"otherNeedIds":[6],"ref":"سورة آل عمران: 139","srcLabel":"القرآن الكريم","quran":{"s":3,"from":139,"to":139,"text":"وَلَا تَهِنُوا وَلَا تَحْزَنُوا وَأَنْتُمُ الْأَعْلَوْنَ إِنْ كُنْتُمْ مُؤْمِنِينَ (139)","hl":[[0,56,2],[56,82,1]]}},{"id":"ق-0317","fp":"f0902a557d3b","stateId":625,"easy":"تولّي الله ورسوله والمؤمنين ← الغلبة (حزب الله هم الغالبون)","cause":"تولّي الله ورسوله والمؤمنين","result":"الغلبة (حزب الله هم الغالبون)","explicit":true,"otherNeedIds":[25],"ref":"سورة المائدة: 56","srcLabel":"القرآن الكريم","quran":{"s":5,"from":56,"to":56,"text":"وَمَنْ يَتَوَلَّ اللَّهَ وَرَسُولَهُ وَالَّذِينَ آمَنُوا فَإِنَّ حِزْبَ اللَّهِ هُمُ الْغَالِبُونَ (56)","hl":[[0,57,1],[57,98,2]]}},{"id":"ق-0422","fp":"ac5a81e2494c","stateId":625,"easy":"الاستعانة بالله والصبر والتقوى ← وراثة الأرض وحسن العاقبة","cause":"الاستعانة بالله والصبر والتقوى","result":"وراثة الأرض وحسن العاقبة","explicit":true,"similar":["ق-0425"],"otherNeedIds":[53],"ref":"سورة الأعراف: 128","srcLabel":"القرآن الكريم","quran":{"s":7,"from":128,"to":128,"text":"قَالَ مُوسَى لِقَوْمِهِ اسْتَعِينُوا بِاللَّهِ وَاصْبِرُوا إِنَّ الْأَرْضَ لِلَّهِ يُورِثُهَا مَنْ يَشَاءُ مِنْ عِبَادِهِ وَالْعَاقِبَةُ لِلْمُتَّقِينَ (128)","hl":[[24,59,1],[59,136,2],[136,151,1]]}},{"id":"ق-0425","fp":"ce5a29a347b8","stateId":625,"easy":"الصبر (المستضعفون) ← وراثة الأرض وتمام كلمة الله الحسنى","cause":"الصبر (المستضعفون)","result":"وراثة الأرض وتمام كلمة الله الحسنى","explicit":true,"repOf":"ق-0422","ref":"سورة الأعراف: 137","quran":{"s":7,"from":137,"to":137,"text":"وَأَوْرَثْنَا الْقَوْمَ الَّذِينَ كَانُوا يُسْتَضْعَفُونَ مَشَارِقَ الْأَرْضِ وَمَغَارِبَهَا الَّتِي بَارَكْنَا فِيهَا وَتَمَّتْ كَلِمَتُ رَبِّكَ الْحُسْنَى عَلَى بَنِي إِسْرَائِيلَ بِمَا صَبَرُوا وَدَمَّرْنَا مَا كَانَ يَصْنَعُ فِرْعَوْنُ وَقَوْمُهُ وَمَا كَانُوا يَعْرِشُونَ (137)","hl":[[0,181,2],[181,196,1]]}},{"id":"ق-0611","fp":"70a479dce53d","stateId":625,"easy":"الإحسان والإيمان والتقوى ← التمكين في الأرض ولا يضيع الأجر وأجر الآخرة خير","cause":"الإحسان والإيمان والتقوى","result":"التمكين في الأرض ولا يضيع الأجر وأجر الآخرة خير","explicit":true,"otherNeedIds":[45,67],"ref":"سورة يوسف: 56–57","srcLabel":"القرآن الكريم","quran":{"s":12,"from":56,"to":57,"text":"وَكَذَلِكَ مَكَّنَّا لِيُوسُفَ فِي الْأَرْضِ يَتَبَوَّأُ مِنْهَا حَيْثُ يَشَاءُ نُصِيبُ بِرَحْمَتِنَا مَنْ نَشَاءُ وَلَا نُضِيعُ أَجْرَ الْمُحْسِنِينَ (56) وَلَأَجْرُ الْآخِرَةِ خَيْرٌ لِلَّذِينَ آمَنُوا وَكَانُوا يَتَّقُونَ (57)","hl":[[0,135,2],[135,156,1],[156,184,2],[184,224,1]]}},{"id":"ق-0618","fp":"6d43ed532fe9","stateId":625,"easy":"تغيير ما بالأنفس (صلاحاً أو فساداً) ← تغيير الله ما بالقوم من حال","cause":"تغيير ما بالأنفس (صلاحاً أو فساداً)","result":"تغيير الله ما بالقوم من حال","explicit":true,"otherNeedIds":[61],"ref":"سورة الرعد: 11","srcLabel":"القرآن الكريم","quran":{"s":13,"from":11,"to":11,"text":"لَهُ مُعَقِّبَاتٌ مِنْ بَيْنِ يَدَيْهِ وَمِنْ خَلْفِهِ يَحْفَظُونَهُ مِنْ أَمْرِ اللَّهِ إِنَّ اللَّهَ لَا يُغَيِّرُ مَا بِقَوْمٍ حَتَّى يُغَيِّرُوا مَا بِأَنْفُسِهِمْ وَإِذَا أَرَادَ اللَّهُ بِقَوْمٍ سُوءًا فَلَا مَرَدَّ لَهُ وَمَا لَهُمْ مِنْ دُونِهِ مِنْ وَالٍ (11)","hl":[[89,129,2],[129,167,1]]}},{"id":"ق-0640","fp":"d349b0f86e90","stateId":625,"easy":"خوف مقام الله ووعيده والصبر على أذى الظالمين والتوكل ← إهلاك الظالمين وإسكان الأرض من بعدهم","cause":"خوف مقام الله ووعيده والصبر على أذى الظالمين والتوكل","result":"إهلاك الظالمين وإسكان الأرض من بعدهم","explicit":true,"otherNeedIds":[25],"ref":"سورة إبراهيم: 13–14","srcLabel":"القرآن الكريم","quran":{"s":14,"from":13,"to":14,"text":"وَقَالَ الَّذِينَ كَفَرُوا لِرُسُلِهِمْ لَنُخْرِجَنَّكُمْ مِنْ أَرْضِنَا أَوْ لَتَعُودُنَّ فِي مِلَّتِنَا فَأَوْحَى إِلَيْهِمْ رَبُّهُمْ لَنُهْلِكَنَّ الظَّالِمِينَ (13) وَلَنُسْكِنَنَّكُمُ الْأَرْضَ مِنْ بَعْدِهِمْ ذَلِكَ لِمَنْ خَافَ مَقَامِي وَخَافَ وَعِيدِ (14)","hl":[[106,137,1],[137,215,2],[215,260,1]]}},{"id":"ق-0737","fp":"1998ade249e5","stateId":625,"easy":"اتباع الأسباب ← بلوغ المقاصد والتمكين في الأرض","cause":"اتباع الأسباب","result":"بلوغ المقاصد والتمكين في الأرض","explicit":true,"otherNeedIds":[54],"ref":"سورة الكهف: 84–85","srcLabel":"القرآن الكريم","quran":{"s":18,"from":84,"to":85,"text":"إِنَّا مَكَّنَّا لَهُ فِي الْأَرْضِ وَآتَيْنَاهُ مِنْ كُلِّ شَيْءٍ سَبَبًا (84) فَأَتْبَعَ سَبَبًا (85)","hl":[[0,35,2],[35,98,1]]}},{"id":"ق-0786","fp":"556be5695966","stateId":625,"easy":"الحق ← يدمغ الباطل فإذا هو زاهق","cause":"الحق","result":"يدمغ الباطل فإذا هو زاهق","explicit":true,"ref":"سورة الأنبياء: 18","srcLabel":"القرآن الكريم","quran":{"s":21,"from":18,"to":18,"text":"بَلْ نَقْذِفُ بِالْحَقِّ عَلَى الْبَاطِلِ فَيَدْمَغُهُ فَإِذَا هُوَ زَاهِقٌ وَلَكُمُ الْوَيْلُ مِمَّا تَصِفُونَ (18)","hl":[[0,42,1],[42,75,2]]}},{"id":"ق-0800","fp":"fdb2357ffa5e","stateId":625,"easy":"الصلاح ← وراثة الأرض","cause":"الصلاح","result":"وراثة الأرض","explicit":true,"ref":"سورة الأنبياء: 105","srcLabel":"القرآن الكريم","quran":{"s":21,"from":105,"to":105,"text":"وَلَقَدْ كَتَبْنَا فِي الزَّبُورِ مِنْ بَعْدِ الذِّكْرِ أَنَّ الْأَرْضَ يَرِثُهَا عِبَادِيَ الصَّالِحُونَ (105)","hl":[[56,81,2],[81,105,1]]}},{"id":"ق-0867","fp":"d4d74161cee5","stateId":625,"easy":"الإيمان والعمل الصالح ← الاستخلاف في الأرض وتمكين الدين وتبديل الخوف أمناً","cause":"الإيمان والعمل الصالح","result":"الاستخلاف في الأرض وتمكين الدين وتبديل الخوف أمناً","explicit":true,"otherNeedIds":[6],"ref":"سورة النور: 55","srcLabel":"القرآن الكريم","quran":{"s":24,"from":55,"to":55,"text":"وَعَدَ اللَّهُ الَّذِينَ آمَنُوا مِنْكُمْ وَعَمِلُوا الصَّالِحَاتِ لَيَسْتَخْلِفَنَّهُمْ فِي الْأَرْضِ كَمَا اسْتَخْلَفَ الَّذِينَ مِنْ قَبْلِهِمْ وَلَيُمَكِّنَنَّ لَهُمْ دِينَهُمُ الَّذِي ارْتَضَى لَهُمْ وَلَيُبَدِّلَنَّهُمْ مِنْ بَعْدِ خَوْفِهِمْ أَمْنًا يَعْبُدُونَنِي لَا يُشْرِكُونَ بِي شَيْئًا وَمَنْ كَفَرَ بَعْدَ ذَلِكَ فَأُولَئِكَ هُمُ الْفَاسِقُونَ (55)","hl":[[0,67,1],[67,256,2],[256,299,1]]}},{"id":"ق-0912","fp":"6cbda56fbc31","stateId":625,"easy":"الاستضعاف مع الإيمان والصبر ← الإمامة والوراثة والتمكين في الأرض","cause":"الاستضعاف مع الإيمان والصبر","result":"الإمامة والوراثة والتمكين في الأرض","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة القصص: 5–6","srcLabel":"القرآن الكريم","quran":{"s":28,"from":5,"to":6,"text":"وَنُرِيدُ أَنْ نَمُنَّ عَلَى الَّذِينَ اسْتُضْعِفُوا فِي الْأَرْضِ وَنَجْعَلَهُمْ أَئِمَّةً وَنَجْعَلَهُمُ الْوَارِثِينَ (5) وَنُمَكِّنَ لَهُمْ فِي الْأَرْضِ وَنُرِيَ فِرْعَوْنَ وَهَامَانَ وَجُنُودَهُمَا مِنْهُمْ مَا كَانُوا يَحْذَرُونَ (6)","hl":[[0,28,2],[28,67,1],[67,157,2],[157,236,1]]}},{"id":"ق-0983","fp":"c66f1efb35d6","stateId":625,"easy":"الصبر واليقين بآيات الله ← الإمامة في الدين","cause":"الصبر واليقين بآيات الله","result":"الإمامة في الدين","explicit":true,"otherNeedIds":[18],"ref":"سورة السجدة: 24","srcLabel":"القرآن الكريم","quran":{"s":32,"from":24,"to":24,"text":"وَجَعَلْنَا مِنْهُمْ أَئِمَّةً يَهْدُونَ بِأَمْرِنَا لَمَّا صَبَرُوا وَكَانُوا بِآيَاتِنَا يُوقِنُونَ (24)","hl":[[0,52,2],[52,101,1]]}},{"id":"ق-1059","fp":"e441fcbbed6e","stateId":625,"easy":"الأوبة إلى الله والتسبيح ← شدّ الملك والحكمة وفصل الخطاب","cause":"الأوبة إلى الله والتسبيح","result":"شدّ الملك والحكمة وفصل الخطاب","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[18],"ref":"سورة ص: 17–20","srcLabel":"القرآن الكريم","quran":{"s":38,"from":17,"to":20,"text":"اصْبِرْ عَلَى مَا يَقُولُونَ وَاذْكُرْ عَبْدَنَا دَاوُودَ ذَا الْأَيْدِ إِنَّهُ أَوَّابٌ (17) إِنَّا سَخَّرْنَا الْجِبَالَ مَعَهُ يُسَبِّحْنَ بِالْعَشِيِّ وَالْإِشْرَاقِ (18) وَالطَّيْرَ مَحْشُورَةً كُلٌّ لَهُ أَوَّابٌ (19) وَشَدَدْنَا مُلْكَهُ وَآتَيْنَاهُ الْحِكْمَةَ وَفَصْلَ الْخِطَابِ (20)","hl":[[29,224,1],[224,289,2]]}},{"id":"ق-1225","fp":"572d66575e81","stateId":625,"easy":"الإيمان والثبات وترك الوهن ← العلوّ ومعية الله ولا ينقص العمل","cause":"الإيمان والثبات وترك الوهن","result":"العلوّ ومعية الله ولا ينقص العمل","explicit":true,"repOf":"ق-0166","otherNeedIds":[25,45],"ref":"سورة محمد: 35","quran":{"s":47,"from":35,"to":35,"text":"فَلَا تَهِنُوا وَتَدْعُوا إِلَى السَّلْمِ وَأَنْتُمُ الْأَعْلَوْنَ وَاللَّهُ مَعَكُمْ وَلَنْ يَتِرَكُمْ أَعْمَالَكُمْ (35)","hl":[[0,42,1],[42,117,2]]}},{"id":"ق-1315","fp":"f56e6ae5dee2","stateId":625,"easy":"الانحياز إلى الله ورسله ← الغلبة","cause":"الانحياز إلى الله ورسله","result":"الغلبة","explicit":true,"ref":"سورة المجادلة: 21","srcLabel":"القرآن الكريم","quran":{"s":58,"from":21,"to":21,"text":"كَتَبَ اللَّهُ لَأَغْلِبَنَّ أَنَا وَرُسُلِي إِنَّ اللَّهَ قَوِيٌّ عَزِيزٌ (21)","hl":[[0,28,2],[28,44,1]]}},{"id":"ق-1338","fp":"daffe421c6dc","stateId":625,"easy":"الإيمان ← العزة لله ولرسوله وللمؤمنين","cause":"الإيمان","result":"العزة لله ولرسوله وللمؤمنين","explicit":true,"ref":"سورة المنافقون: 8","srcLabel":"القرآن الكريم","quran":{"s":63,"from":8,"to":8,"text":"يَقُولُونَ لَئِنْ رَجَعْنَا إِلَى الْمَدِينَةِ لَيُخْرِجَنَّ الْأَعَزُّ مِنْهَا الْأَذَلَّ وَلِلَّهِ الْعِزَّةُ وَلِرَسُولِهِ وَلِلْمُؤْمِنِينَ وَلَكِنَّ الْمُنَافِقِينَ لَا يَعْلَمُونَ (8)","hl":[[91,101,1],[101,111,2],[111,143,1]]}},{"id":"س-05498","fp":"65d53b545c4d","stateId":625,"easy":"إذا لم تطلب الدنيا بعمل الآخرة ← تُبشّر الأمة بالسناء والرفعة والتمكين","cause":"ما لم يَطْلُبوا الدُّنْيا بعَملِ الآخرةِ","result":"بالسَّناءِ والرِّفْعةِ والتَّمكينِ في البلادِ","explicit":true,"ref":"المستدرك على الصحيحين 8108","srcLabel":"الحاكم","text":["بَشِّرْ أُمَّتي ",["بالسَّناءِ والرِّفْعةِ والتَّمكينِ في البلادِ",2],"، ",["ما لم يَطْلُبوا الدُّنْيا بعَملِ الآخرةِ",1],"، فمَن طلَبَ الدُّنيا بعَملِ الآخرةِ لم يكُنْ له في الآخرةِ مِن نَصيبٍ."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"صحيح الإسناد","bab":"رقائق وزهد › الرياء والسمعة","dorar":"5jJ5y4Lt"},{"id":"س-02294","fp":"f34be10c124b","stateId":625,"easy":"إذا عجّل الناس الفطر ← يبقى الدين ظاهراً","cause":"ما عَجَّل النَّاسُ الفِطرَ","result":"لا يَزالُ الدِّينُ ظاهِرًا","explicit":true,"ref":"المستدرك على الصحيحين 1593","srcLabel":"مسلم","text":[["لا يَزالُ الدِّينُ ظاهِرًا",2]," ",["ما عَجَّل النَّاسُ الفِطرَ",1],"؛ لأنَّ اليَهودَ والنَّصارى يُؤَخِّرون."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أبو داود (2353)، وأحمد (9810)، وابن خزيمة (2060) واللفظ لهم.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"4TfXs3HY"}]}