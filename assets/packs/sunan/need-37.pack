{"schema":1,"kind":"sunan-chunk","version":"sunan-b41390b43331","needId":37,"stateIds":[382,383,384],"items":[{"id":"س-05565","fp":"410d34dd06a2","stateId":382,"easy":"إذا يُسّر المهر ← كانت المرأة أعظم بركة","cause":"أَيسَرُهنَّ صَداقًا","result":"أَعظَمُ النِّساءِ بَركَةً","explicit":true,"star":true,"similar":["س-05832","س-01266","س-01267","س-01881","س-05946"],"ref":"المستدرك على الصحيحين 2770","srcLabel":"مسلم","text":[["أَعظَمُ النِّساءِ بَركَةً",2],"؛ ",["أَيسَرُهنَّ صَداقًا",1],"."],"grade":"صحيح","narrator":"عائشة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه البيهقي (14472) بلفظه، وأحمد (25119) باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"BlZnfIsG"},{"id":"س-05832","fp":"51270bfe6ebd","stateId":382,"easy":"إذا تيسرت خطبة المرأة وصداقها ورحمها ← فهو من يُمنها","cause":"أنْ يَتيَسَّرَ خِطبَتُها، وأنْ يَتيَسَّرَ صَداقُها، وأنْ يَتيَسَّرَ رَحِمُها","result":"مِن يُمنِ المرأةِ","explicit":true,"repOf":"س-05565","otherNeedIds":[1],"ref":"المستدرك على الصحيحين 2777","text":["قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["مِن يُمنِ المرأةِ",2]," ",["أنْ يَتيَسَّرَ خِطبَتُها، وأنْ يَتيَسَّرَ صَداقُها، وأنْ يَتيَسَّرَ رَحِمُها",1],"، قالَ عُروَةُ: يعني يَتيَسَّرُ رَحِمُها للولادةِ، قالَ عِروَةُ: وأنا أَقولُ مِن عندي: مِن أَوَّلِ شُؤْمِها أنْ يَكثُرَ صَداقُها."],"grade":"صحيح","narrator":"عائشة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أحمد (24478) بلفظه، وابن حبان (4095) باختلاف يسير.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"IlPq6qIC","merged":2,"otherRefs":["كشف الخفاء 1/465 (حسن)"]},{"id":"س-02220","fp":"dacc433dd95c","stateId":382,"easy":"إذا رُزقت امرأة صالحة ← فليس في متاع الدنيا أفضل منها","cause":"المرأةِ الصَّالِحةِ","result":"ولَيسَ مِن متاعِ الدُّنيا شَيءٌ أفضلَ","explicit":true,"star":true,"otherNeedIds":[7],"ref":"صحيح ابن ماجه 1516","srcLabel":"مسلم","text":["إنَّما الدُّنيا متاعٌ ",["ولَيسَ مِن متاعِ الدُّنيا شَيءٌ أفضلَ",2]," منَ ",["المرأةِ الصَّالِحةِ",1]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1467) بنحوه، وابن ماجه (1855) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"lw1vuInB"},{"id":"س-01269","fp":"0e1e9eb52934","stateId":382,"easy":"إذا خطبت امرأة فانظر إليها ← فهو أجدر أن يؤلف بينكما","cause":"فانظُرْ إليها","result":"فإنَّه أجدَرُ أنْ يُؤدَمَ بينكما","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 18137","srcLabel":"الترمذي","text":["أتَيتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فذَكَرتُ له امرأةً أخطُبُها، فقال: اذهَبْ، ",["فانظُرْ إليها",1],"؛ ",["فإنَّه أجدَرُ أنْ يُؤدَمَ بينكما",2],"، قال: فأتَيتُ امرأةً مِن الأنصارِ، فخَطَبتُها إلى أبَوَيْها، وأخبَرتُهما بقَولِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فكأنَّهما كَرِها ذلك، قال: فسَمِعَتْ ذلك المَرأةُ وهي في خِدرِها، فقالتْ: إنْ كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ أمَرَكَ أنْ تنظُرَ، فانظُرْ، وإلا فإنِّي أنشُدُكَ. كأنَّها عَظَّمَتْ ذلك عليه، قال: فنَظَرتُ إليها؛ فتَزوَّجتُها، فذَكَرَ مِن مُوَافَقتِها."],"grade":"صحيح","narrator":"المغيرة بن شعبة","muhaddith":"صحيح إن صح سماع بكر بن عبد الله المزني من المغيرة","takhrij":"أخرجه الترمذي (1087) مختصراً، وابن ماجه (1866) باختلاف يسير، وأحمد (18137) واللفظ له","bab":"نكاح › الحث على التزويج","dorar":"vDwiQPSQ","merged":9,"otherRefs":["تخريج مشكل الآثار 11/289 (صحيح)","تخريج المسند لشعيب 18154 (صحيح)","تخريج سنن الدارقطني 3622 (صحيح)","المستدرك على الصحيحين 2734 (صحيح)","تخريج صحيح ابن حبان 4043 (صحيح)","تحفة المحتاج 2/358 (صحيح)","الإلمام بأحاديث الأحكام 2/623 (صحيح)","صحيح النسائي 3235 (صحيح)"]},{"id":"ق-0956","fp":"ff16bfcf0ca5","stateId":382,"easy":"الزواج ← السكن والمودة والرحمة","cause":"الزواج","result":"السكن والمودة والرحمة","explicit":true,"star":true,"otherNeedIds":[5],"ref":"سورة الروم: 21","srcLabel":"القرآن الكريم","quran":{"s":30,"from":21,"to":21,"text":"وَمِنْ آيَاتِهِ أَنْ خَلَقَ لَكُمْ مِنْ أَنْفُسِكُمْ أَزْوَاجًا لِتَسْكُنُوا إِلَيْهَا وَجَعَلَ بَيْنَكُمْ مَوَدَّةً وَرَحْمَةً إِنَّ فِي ذَلِكَ لَآيَاتٍ لِقَوْمٍ يَتَفَكَّرُونَ (21)","hl":[[0,64,1],[64,127,2]]}},{"id":"س-03743","fp":"b108bd53490d","stateId":382,"easy":"إذا تزوجت ← فخير هذه الأمة أكثرها نساء","cause":"تَزَوَّج","result":"فإنَّ خَيرَ هذه الأُمَّةِ كان أكثَرَها نِساءً","explicit":true,"otherNeedIds":[47],"ref":"تخريج المسند لشعيب 2048","srcLabel":"أحمد","text":["عن سَعيدِ بنِ جُبَيرٍ، قال: لَقيَني ابنُ عَبَّاسٍ، فقال: ",["تَزَوَّج",1],"تَ؟ قال: قُلتُ: لا، قال: تَزَوَّج، ثُمَّ لَقيَني بَعدَ ذلك. فقال: تَزَوَّجتَ؟ قال: قُلتُ: لا، قال: تَزَوَّج؛ ",["فإنَّ خَيرَ هذه الأُمَّةِ كان أكثَرَها نِساءً",2],"."],"grade":"صحيح","narrator":"سعيد بن جبير","muhaddith":"صحيح لغيره","bab":"اعتصام بالسنة › لزوم السنة","dorar":"lQRLzgyr","merged":4,"otherRefs":["صحيح البخاري 5069 (صحيح)","تخريج المسند لشعيب 2179 (صحيح)","المستدرك على الصحيحين 2711 (صحيح)"]},{"id":"س-03631","fp":"bb3ba0e3c865","stateId":382,"easy":"إذا تزوجت الودود الولود ← فالنبي ﷺ مكاثر بكم الأمم","cause":"تَزوَّجوا الوَدودَ الوَلودَ","result":"فإنِّي مُكاثِرٌ بكم الأُمَمَ","explicit":true,"similar":["س-01276"],"ref":"المستدرك على الصحيحين 2722","srcLabel":"ابن حبان","text":["جاءَ رَجلٌ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: يا رسولَ اللهِ، إنِّي أَصبْتُ امرأةً ذاتَ حَسَبٍ ومَنصِبٍ ومالٍ، إلَّا أنَّها لا تَلِدُ، أفأَتزوَّجُها؟ فنَهاه، ثُمَّ أَتاهُ الثَّانيةَ، فقالَ له مِثلَ ذلك، فنَهاه، ثُمَّ أَتاهُ الثَّالثةَ، فقالَ له مِثلَ ذلك، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["تَزوَّجوا الوَدودَ الوَلودَ",1],"؛ ",["فإنِّي مُكاثِرٌ بكم الأُمَمَ",2],"."],"grade":"صحيح","narrator":"معقل بن يسار","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داوود (2050)، وابن حبان (2358)، والبيهقي في ((معرفة السنن والآثار)) (13458) جميعا بلفظه.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"TcysexEE","merged":3,"otherRefs":["مجمع الزوائد 4/255 (صحيح)","الصحيح المسند 1126 (صحيح)"]},{"id":"س-01276","fp":"ef0af17da105","stateId":382,"easy":"إذا تزوجت فلا تتزوج عاقراً ← فالنبي ﷺ مكاثر بكم","cause":"لا تَزَّوَّجَنَّ عَجوزًا، ولا عاقِرًا","result":"فإنِّي مُكاثِرٌ بكُم","explicit":true,"repOf":"س-03631","ref":"المستدرك على الصحيحين 5360","text":["قالَ لي رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ذاتَ يومٍ: يا عِياضُ، ",["لا تَزَّوَّجَنَّ عَجوزًا، ولا عاقِرًا",1],"؛ ",["فإنِّي مُكاثِرٌ بكُم",2],"."],"grade":"صحيح","narrator":"عياض بن غنم","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني (17/ 368) (1008)، وابن عدي في ((الكامل)) (6/ 250)، والخطيب في ((تاريخه)) (4/ 264) واللفظ لهم.","bab":"نكاح › الحث على التزويج","dorar":"we7RdR3P","merged":2,"otherRefs":["السلسلة الصحيحة 1782 (صحيح)"]},{"id":"س-05822","fp":"e17ac5c02bce","stateId":382,"easy":"إذا تحاب اثنان ← فلا شيء لهما مثل النكاح","cause":"النِّكاحِ","result":"لم نَرَ لِلْمُتحابَّينِ مِثلَ","explicit":true,"similar":["س-01271"],"ref":"تخريج زاد المعاد 4/250","srcLabel":"ابن ماجه","text":[["لم نَرَ لِلْمُتحابَّينِ مِثلَ",2]," ",["النِّكاحِ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (1847) واللفظ له، والبزار (4856) بلفظ: ((التزويج)).","bab":"رقائق وزهد › الوصايا النافعة","dorar":"UNh0EUDf","merged":2,"otherRefs":["هداية الرواة 3029 (صحيح)"]},{"id":"س-01266","fp":"b2df8ef9d5e0","stateId":382,"easy":"إذا تيسر صداق المرأة ← فهي من خير النساء","cause":"أيسرُهنَّ صداقًا","result":"خيرُهنَّ","explicit":true,"repOf":"س-05565","ref":"صحيح ابن حبان 4034","text":[["خيرُهنَّ",2]," ",["أيسرُهنَّ صداقًا",1],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (2/61)، والطبراني (11/78) (11100)","bab":"نكاح › الحث على التزويج","dorar":"N6P6e3Y5"},{"id":"س-01267","fp":"f64188bd9f5c","stateId":382,"easy":"إذا تيسر أمر المرأة وقلّ صداقها ← فهو من يُمنها","cause":"تسهيلُ أمرِها وقلَّةُ صداقِها","result":"مِن يُمنِ المرأةِ","explicit":true,"repOf":"س-05565","ref":"صحيح ابن حبان 4095","text":[["مِن يُمنِ المرأةِ",2]," ",["تسهيلُ أمرِها وقلَّةُ صداقِها",1]," ) قال عروةُ: وأنا أقولُ مِن عندي: ومِن شؤمِها تعسيرُ أمرِها وكثرةُ صداقِها"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (24607)، والحاكم (2739)، والطبراني في ((الأوسط)) (3612) جميعا بإختلاف يسير.","bab":"نكاح › الحث على التزويج","dorar":"Ir5UKWun"},{"id":"س-01881","fp":"c3f51e52c820","stateId":382,"easy":"إذا يسّرت الصداق ← فهو خير الصداق","cause":"أيسرُه","result":"خيرُ الصداقِ","explicit":true,"repOf":"س-05565","ref":"النوافح العطرة 136","text":["خيرُ الصَّداقِ ",["أيسرُه",1]," [يعني حديث:  أنَّ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ قال لرجلٍ أترضَى أن أُزوِّجَك فلانةً قال نعم وقال للمرأةِ أترضَينَ أن أُزوِّجكِ فلانًا قالت نعم فزوَّج أحدَهما صاحبَه ولم يفرضْ لها صداقًا ولم يعطِها شيئًا وكان ممن شهد الحُديبيةَ وكان من شهد الحُديبيةَ له سهمٌ بخيبرَ فلما حضرتْه الوفاةُ قال إنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ زوَّجني فلانةً ولم أفرضْ لها صداقًا ولم أُعطِها شيئًا وإني أُشهدُكم أني أعطيتُها صداقًا سهمي بخيبرَ فأخذتْ سهمًا فباعتْه بمائةِ ألفٍ.\n قال: وقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ",["خيرُ الصداقِ",2]," أيسرُه]"],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (2742)، والبيهقي (14448) بلفظه تامًا، وأبو داود (2117) بنحوه تامًا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"eK2sVMZB"},{"id":"س-05777","fp":"aaa5e27e26ae","stateId":382,"easy":"إذا تزوجت فاظفر بذات الدين والخلق ← تربت يداك","cause":"فعليك بذاتِ الدِّينِ والخُلقِ","result":"ترِبت يمينُك","explicit":true,"similar":["س-01261","س-01268"],"ref":"الترغيب والترهيب 3/93","srcLabel":"أحمد","text":["تُنكحُ المرأةُ على إحدَى خصالٍ لجمالِها ومالِها وخُلقِها ودينِها ",["فعليك بذاتِ الدِّينِ والخُلقِ",1]," ",["ترِبت يمينُك",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (11782)، وأبو يعلى (1012)، وابن حبان (4037) باختلاف يسير.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"wHe9Oh6j"},{"id":"س-05787","fp":"966de5f254ff","stateId":382,"easy":"إذا تسرّيت بالإماء ← فهن مباركات الأرحام","cause":"بالسَّراري","result":"فإنَّهنَّ مبارَكاتُ الأرحامِ","explicit":true,"ref":"الجامع الصغير 5509","srcLabel":"العقيلي","text":["عليكُم ",["بالسَّراري",1]," ، ",["فإنَّهنَّ مبارَكاتُ الأرحامِ",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه العقيلي في ((الضعفاء)) (1338)، وابن الجوزي في ((الموضوعات)) (1254)، والسيوطي في ((رفع شأن الحبشان)) (صـ213) واللفظ لهم.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"osO4p1Wc"},{"id":"س-05849","fp":"7b893518b0cd","stateId":382,"easy":"إذا تزوجت الشابة ← فهي أطيب فماً وأنتق رحماً","cause":"عَليكُم بِشَوابِّ النِّساءِ","result":"فإنَّهنَّ أطيبُ أفواهًا، وأَنتقُ أرحامًا، وَأسخَنُ أَقْبالًا","explicit":true,"similar":["س-05850"],"ref":"صحيح الجامع 4078","srcLabel":"صحيح الجامع","text":[["عَليكُم بِشَوابِّ النِّساءِ؛ ",1],["فإنَّهنَّ أطيبُ أفواهًا، وأَنتقُ أرحامًا، وَأسخَنُ أَقْبالًا",2],"."],"grade":"صحيح","narrator":"سفيان بن عبدالله الثقفي","muhaddith":"صحيح","takhrij":"لم نقف عليه مسنداً.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"afYl0bXZ"},{"id":"س-01261","fp":"f1253207670a","stateId":382,"easy":"إذا اخترت للزواج ذات الدين ← تربح (تربت يداك)","cause":"فعليكَ بذاتِ الدِّينِ","result":"تَرِبَت يَداكَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-05777","ref":"صحيح مسلم 715","text":["تَزَوَّجتُ امرَأةً في عَهدِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فلَقيتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم، فقال: يا جابِرُ تَزَوَّجتَ؟ قُلتُ: نَعَم، قال: بكرٌ أم ثَيِّبٌ؟ قُلتُ: ثَيِّبٌ، قال: فهَلَّا بكرًا تُلاعِبُها؟ قُلتُ: يا رَسولَ اللهِ، إنَّ لي أخَواتٍ، فخَشيتُ أن تَدخُلَ بَيني وبينَهُنَّ، قال: فذاكَ إذَن، إنَّ المَرأةَ تُنكَحُ على دينِها، ومالِها، وجَمالِها، ",["فعليكَ بذاتِ الدِّينِ",1]," ",["تَرِبَت يَداكَ",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5080)، ومسلم (715).","bab":"نكاح › الحث على التزويج","dorar":"SWEIa9vx","merged":8,"otherRefs":["صحيح البخاري 5090 (صحيح)","تخريج سنن الدارقطني 3803 (صحيح)","إتحاف الخيرة المهرة 4/ 6 (حسن)","تخريج صحيح ابن حبان 4036 (صحيح)","مجمع الزوائد 4/257 (صحيح)","صحيح الجامع 3003 (صحيح)","مختصر المقاصد 327 (صحيح)"]},{"id":"س-05850","fp":"cceec376c7f2","stateId":382,"easy":"إذا تزوجت البكر ← فهي أعذب فماً وأنتق رحماً وأرضى باليسير","cause":"عليكم بالأبكارِ","result":"فإنهنَّ أعذبُ أفواهًا ، وأنتَقُ أرحامًا ، وأسخَنُ أقبالًا ، وأرضى باليسيرِ من العملِ","explicit":true,"repOf":"س-05849","ref":"صحيح الجامع 4053","text":[["عليكم بالأبكارِ ، ",1],["فإنهنَّ أعذبُ أفواهًا ، وأنتَقُ أرحامًا ، وأسخَنُ أقبالًا ، وأرضى باليسيرِ من العملِ",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن","takhrij":"أخرجه ابن السني كما في ((الجامع الصغير)) للسيوطي (2/98)، وأبو نعيم في ((الطب النبوي)) (448)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"5xGwcoS7","merged":2,"otherRefs":["السلسلة الصحيحة 623 (حسن)"]},{"id":"س-05946","fp":"b444908e5345","stateId":382,"easy":"إذا تيسر صداقكِ ← تكونين من خير النساء","cause":"أيسرُكنَّ صَداقًا","result":"خيرُكنَّ","explicit":true,"repOf":"س-05565","ref":"مختصر المقاصد 424","text":[["خيرُكنَّ",2]," ",["أيسرُكنَّ صَداقًا",1]],"grade":"حسن","narrator":"[عبدالله بن عباس]","muhaddith":"حسن لغيره","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (2/61)، وابن حبان (4034)، والطبراني (11/78) (11100) باختلاف يسير.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"t4LCTieY"},{"id":"س-01271","fp":"d43a6769d72e","stateId":382,"easy":"إذا تحاب اثنان فتزوجا ← فلم يُرَ للمتحابين مثل الزواج","cause":"التَّزوُّجِ","result":"لمْ يُرَ للمُتَحابِّينَ مِثلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-05822","ref":"المستدرك على الصحيحين 2714","text":[["لمْ يُرَ للمُتَحابِّينَ مِثلُ",2]," ",["التَّزوُّجِ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح على شرط مسلم... لأن سفيان بن عيينة، ومعمر بن راشد أوقفاه عن إبراهيم بن ميسرة، عن ابن عباس","takhrij":"أخرجه ابن ماجه (1847) والطبراني (10895) 11/  17)، والبيهقي (13453) واللفظ لهم","bab":"نكاح › الحث على التزويج","dorar":"Zhb1cfXS"},{"id":"س-07543","fp":"f5ea1e623963","stateId":382,"easy":"إذا عُقد لك النكاح فدُعي لك ← تُرجى لك البركة والألفة والسعة في الرزق","cause":"إمْلاكَ رجلٍ من أصحابِهِ","result":"على الخيرِ والبركةِ والأُلْفَةِ والطائِرِ الميمونِ والسعةِ في الرزقِ باركَ اللهُ لكم","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"otherNeedIds":[1],"ref":"مجمع الزوائد 4-59","srcLabel":"الطبراني","text":["شهِدَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["إمْلاكَ رجلٍ من أصحابِهِ",1]," فقال ",["على الخيرِ والبركةِ والأُلْفَةِ والطائِرِ الميمونِ والسعةِ في الرزقِ باركَ اللهُ لكم",2]," دفِّفُوا على رأْسِهِ فَجِيءَ بِدُفٍّ فضُرِبَ به فأَقْبَلَتْ الأطباقُ عليها فاكهةٌ وسُكَّرٌ فنُثِرَ علَيْهِ وكَفَّ الناسُ أيدِيَهم فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ما لكم لا تَنْتَهِبُونَ قالوا يا رسولَ اللهِ أَوَ لم تَنْهَ عن النُّهْبَةِ قال إِنَّما نَهَيْتُكُمْ عنِ نُهْبَةِ العساكرِ فأمَّا العُرْساتُ فلا فحادَثَهم وحادَثُوهُ"],"grade":"حسن","narrator":"معاذ بن جبل","muhaddith":"فيه حازم مولى بني هاشم عن لمازة ولم أجد من ترجمهما وبقية رجاله ثقات","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (1/142)، والطحاوي في ((شرح معاني الآثار)) (4449)، والطبراني (20/97) (191) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › تواضعه صلى الله عليه وسلم","dorar":"E2i9PRir"},{"id":"س-01268","fp":"163e68dadd7d","stateId":382,"easy":"إذا اخترت للزواج ذات الدين والخلق ← تربح","cause":"فخُذْ ذاتَ الدِّينِ والخُلُقِ","result":"تَرِبَتْ يَمينُك","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-05777","ref":"تخريج المسند لشعيب 11765","text":["تُنكَحُ المرَأةُ على إحدى خِصالٍ ثلاثٍ: تُنكَحُ المرَأةُ على مالِها، وتُنكَحُ المرَأةُ على جَمالِها، وتُنكَحُ المرَأةُ على دِينِها، ",["فخُذْ ذاتَ الدِّينِ والخُلُقِ",1]," ",["تَرِبَتْ يَمينُك",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (11765) واللفظ له، وابن أبي شيبة (17434)، وعبد بن حميد (986)","bab":"نكاح › الحث على التزويج","dorar":"jeofnJXo"},{"id":"س-03924","fp":"16ea9bea44cf","stateId":382,"easy":"إذا يسّرت المهر ← فلو كان الإكثار تقوى لسبق إليه النبي ﷺ (أثر عمر)","cause":"إنَّما الصَّدقاتُ فيما بينَهُم أربَعمِائةِ درهَمٍ","result":"وَلو كانَ الإِكْثارُ في ذلِكَ تقوًى عندَ اللَّهِ أو مَكْرُمةً لم تسبِقُوهم إلَيها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المقاصد الحسنة 379","srcLabel":"الخطيب","text":["رَكِبَ عُمرُ منبرِ النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ ثمَّ قالَ : أيُّها النَّاسُ ما إِكْثارُكُم في صَداقِ النِّساءِ وقد كانَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ وأصحابُهُ، ",["إنَّما الصَّدقاتُ فيما بينَهُم أربَعمِائةِ درهَمٍ",1]," فما دونَ ذلِكَ، ",["وَلو كانَ الإِكْثارُ في ذلِكَ تقوًى عندَ اللَّهِ أو مَكْرُمةً لم تسبِقُوهم إلَيها",2]," فلا أعرِفنَّ ما زادَ رجلٌ في صداقَ امرأة على أربعِمائةِ قالَ: ثمَّ نزلَ فاعتَرضتهُ امرأةٌ مِن قُرَيْشٍ فقالت لَه يا أميرَ المؤمنينَ نَهَيتَ النَّاسَ أن يَزيدوا النِّساءَ في صدقاتِهِنَّ على أربعمائةِ درهمٍ ؟ قالَ: نعَم فقالت: أما سمعتَ ما أنزلَ اللَّهُ في القرآنِ ؟ قالَ: وأيُّ ذلِكَ ؟ فقالَت أما سمعتَ اللَّهَ يقولُ:  وَآتَيْتُمْ إِحْدَاهُنَّ قِنْطَارًا فَلَا تَأْخُذُوا مِنْهُ شَيْئًا أَتَأْخُذُونَهُ بُهْتَانًا وَإِثْمًا مُبِينًا  قالَ: اللَّهُمَّ غُفرًا كلُّ النَّاسِ أفقَهُ مِن عمرَ قالَ: ثمَّ رجعَ فرَكِبَ المنبرَ فقالَ: أيُّها النَّاسُ إنِّي كُنتُ نَهَيتُ أن تزيدوا النِّساءَ في صدُقاتِهِن على أربعمائةِ درهمٍ فمن شاءَ أن يُعْطيَ من مالِهِ ما أحبَّ قالَ أبو يعلى: وأظنُّهُ قالَ: فمن طابَت نفسُهُ فليفعَلْ"],"grade":"حسن","narrator":"مسروق بن الأجدع","muhaddith":"إسناده جيد قوي","takhrij":"أخرجه الخطيب في ((الفقيه والمتفقه)) (1/370)","bab":"تفسير آيات › سورة النساء","dorar":"dRTc19x4"},{"id":"س-01283","fp":"e8dafd8d2cec","stateId":382,"easy":"إذا عشت بلا زوجة ← فأنت مسكين وإن كثر مالك","cause":"رجلٌ ليسَ لَهُ امرأةٌ وإنْ كان كثيرَ المالِ","result":"مسكينٌ مسكينٌ مسكينٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"مجمع الزوائد 4/255","srcLabel":"الطبراني","text":[["مسكينٌ مسكينٌ مسكينٌ",2]," ",["رجلٌ ليسَ لَهُ امرأةٌ وإنْ كان كثيرَ المالِ",1]," مسكينةٌ مسكينةٌ مسكينةٌ امرأةٌ ليسَ لها زوجٌ وإن كانتْ كثيرةَ المالِ"],"grade":"حسن","narrator":"أبو نجيح يسار المكي","muhaddith":"رجاله ثقات إلا أن أبا نجيح لا صحبة له","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6589) واللفظ له، وأخرجه سعيد بن منصور في ((السنن)) (488)، والبيهقي في ((شعب الإيمان)) (5097) باختلاف يسير","bab":"نكاح › الحث على التزويج","dorar":"0tznxfgg"},{"id":"س-01284","fp":"e990d5fc3c5d","stateId":382,"easy":"إذا عاشت المرأة بلا زوج ← فهي مسكينة وإن كثر مالها","cause":"امرأةٌ ليسَ لها زوجٌ وإن كانتْ كثيرةَ المالِ","result":"مسكينةٌ مسكينةٌ مسكينةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"مجمع الزوائد 4/255","srcLabel":"الطبراني","text":["مسكينٌ مسكينٌ مسكينٌ رجلٌ ليسَ لَهُ امرأةٌ وإنْ كان كثيرَ المالِ ",["مسكينةٌ مسكينةٌ مسكينةٌ",2]," ",["امرأةٌ ليسَ لها زوجٌ وإن كانتْ كثيرةَ المالِ",1]],"grade":"حسن","narrator":"أبو نجيح يسار المكي","muhaddith":"رجاله ثقات إلا أن أبا نجيح لا صحبة له","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6589) واللفظ له، وأخرجه سعيد بن منصور في ((السنن)) (488)، والبيهقي في ((شعب الإيمان)) (5097) باختلاف يسير","bab":"نكاح › الحث على التزويج","dorar":"0tznxfgg"},{"id":"ق-0214","fp":"b37fd08097ce","stateId":383,"easy":"إرادة الإصلاح بين الزوجين ← توفيق الله بينهما","cause":"إرادة الإصلاح بين الزوجين","result":"توفيق الله بينهما","explicit":true,"star":true,"otherNeedIds":[54],"ref":"سورة النساء: 35","srcLabel":"القرآن الكريم","quran":{"s":4,"from":35,"to":35,"text":"وَإِنْ خِفْتُمْ شِقَاقَ بَيْنِهِمَا فَابْعَثُوا حَكَمًا مِنْ أَهْلِهِ وَحَكَمًا مِنْ أَهْلِهَا إِنْ يُرِيدَا إِصْلَاحًا يُوَفِّقِ اللَّهُ بَيْنَهُمَا إِنَّ اللَّهَ كَانَ عَلِيمًا خَبِيرًا (35)","hl":[[95,120,1],[120,149,2]]}},{"id":"ق-0255","fp":"c06f6ccebd46","stateId":383,"easy":"الصلح ← خير","cause":"الصلح","result":"خير","explicit":true,"otherNeedIds":[55],"ref":"سورة النساء: 128","srcLabel":"القرآن الكريم","quran":{"s":4,"from":128,"to":128,"text":"وَإِنِ امْرَأَةٌ خَافَتْ مِنْ بَعْلِهَا نُشُوزًا أَوْ إِعْرَاضًا فَلَا جُنَاحَ عَلَيْهِمَا أَنْ يُصْلِحَا بَيْنَهُمَا صُلْحًا وَالصُّلْحُ خَيْرٌ وَأُحْضِرَتِ الْأَنْفُسُ الشُّحَّ وَإِنْ تُحْسِنُوا وَتَتَّقُوا فَإِنَّ اللَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًا (128)","hl":[[126,138,1],[138,144,2]]}},{"id":"س-01323","fp":"85236768c94b","stateId":383,"easy":"إذا خفت نفرة زوجتك فصلّيا معاً ركعتين وادعُ ← يؤلّف الله بينكما (أثر ابن مسعود)","cause":"فأْمُرْها أنْ تُصَلِّيَ وراءَكَ رَكْعَتَيْنِ","result":"وإِنَّي أخافُ أنْ تفرُكَنِي","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"count","t":"ركعتين"},"similar":["س-01328"],"ref":"آداب الزفاف 23","srcLabel":"الطبراني","text":["جاءَ رجلٌ يقالُ له : أبو حَرِيْزٍ ، فقال : إِنَّي تزوجْتُ جاريَةً شابَّةً [ بكرًا ] ، ",["وإِنَّي أخافُ أنْ تفرُكَنِي",2]," ، فقال عبدُ الله ( يعني ابنُ مسعودٍ ) : إِنَّ الإلْفَ مِنَ اللهِ ، والفَرَكَ مِنَ الشيطانِ ، يُريدُ أنْ يُكَرِّهَ إليكم ما أَحَلَّ اللهُ لكم ، فإذا أَتَتْكَ ",["فأْمُرْها أنْ تُصَلِّيَ وراءَكَ رَكْعَتَيْنِ",1]," . زاد في روايَةٍ أُخْرَى عنِ ابنِ مسعودٍ : وقلْ : اللهمَّ باركْ لي في أهلِي ، وباركْ لَهُمْ فِيَّ ، اللهمَّ اجمعْ بينَنَا ما جمَعْتَ بخيرٍ ؛ وفَرِّقْ بينَنَا إذا فرقْتَ إلى خيرٍ ."],"grade":"صحيح","narrator":"شقيق بن سلمة","muhaddith":"إسناده صحيح","takhrij":"أخرجه عبد الرزاق (10460)، وابن أبي شيبة (17441)،  والطبراني (9/ 204)، (8993) جميعهم باختلاف يسير.","bab":"نكاح › عشرة النساء","dorar":"WkS0cYaA"},{"id":"س-01328","fp":"945cd7afd913","stateId":383,"easy":"إذا خشيت أن تبغضك زوجتك فصلّيا ركعتين معاً ← يؤلّف الله بينكما (أثر ابن مسعود)","cause":"فمرْها فلْتُصَلِّ خَلْفَكَ رَكْعَتَيْنِ","result":"وَإِنِّي خَشِيتُ أنْ تَفْرُكَنِي","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"count","t":"ركعتين"},"repOf":"س-01323","ref":"مجمع الزوائد 4/295","text":["جاء رجلٌ من بُجَيْلَةَ إلى عبدِ اللهِ يَعْنِي ابْنَ مسعودٍ فقال إِنِّي تَزَوَّجْتُ جَارِيَةً بِكْرًا ",["وَإِنِّي خَشِيتُ أنْ تَفْرُكَنِي",2]," فَقَالَ عَبْدُ اللهِ إنَّ الْإِلْفَ مِنَ اللهِ وَإِنَّ الْفَرَكَ مِنَ الشَّيْطَانِ يُكَرِّهُ إلِيهِمَا فإِذَا دخلتَ علَيْهَا ",["فمرْها فلْتُصَلِّ خَلْفَكَ رَكْعَتَيْنِ",1]," قال الأعمشُ فذَكَرْتُهُ لِإِبْرَاهيمَ قال عبدُ اللهِ قلِ اللَّهمَّ بارِكْ لي في أهْلِي وبارِكْ لهم فِيَّ اللَّهمَّ ارْزُقْهُمْ مِنِّي وارزُقْنِي منهم اللهمَّ اجمعْ بيْنَنَا مَا جَمَعْتَ إِلَى خَيْرٍ وفَرِّقْ بَيْنَنَا إِذَا فَرَّقْتَ إِلَى خَيْرٍ"],"grade":"صحيح","narrator":"شقيق بن سلمة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه عبد الرزاق (10460)، والطبراني (9/ 204)، (8993) كلاهما بلفظه، وابن أبي شيبة (17441) باختلاف يسير.","bab":"نكاح › عشرة النساء","dorar":"jEKpbKqG"},{"id":"س-05141","fp":"91fe5914d1e7","stateId":383,"easy":"إذا غاضبتِ زوجك فأتيه حتى ترضيه ← فإن قبل فبها، وإلا فقد أعذرتِ عند الله","cause":"فلتَأْتِه حتَّى تُرضِيَه","result":"فإنْ كان هو قَبِلَ منها فبِها ونِعْمَتْ، وقَبِلَ اللهُ عُذرَها، وأَفلَحَ حُجَّتَها، ولا إثْمَ عليها، وإنْ هو أَبَى يَرْضى عنها، فقد أَبلَغَتْ عندَ اللهِ عُذرَها","explicit":true,"otherNeedIds":[11],"ref":"المستدرك على الصحيحين 2808","srcLabel":"الطبراني","text":["لا يَحِلُّ لامرأةٍ تُؤمِنُ باللهِ واليومِ الآخِرِ، أنْ تَأذَنَ في بيتِ زَوجِها وهو كارِهٌ، ولا تَخرُجَ وهو كارِهٌ، ولا تُطيعَ فيه أَحدًا، ولا تَخشَنَ بصدرِه، ولا تَعتَزِلَ فِراشَه، ولا تَضرِبَه، فإنْ كان هو أَظلَمَ، ",["فلتَأْتِه حتَّى تُرضِيَه",1],"، ",["فإنْ كان هو قَبِلَ منها فبِها ونِعْمَتْ، وقَبِلَ اللهُ عُذرَها، وأَفلَحَ حُجَّتَها، ولا إثْمَ عليها، وإنْ هو أَبَى يَرْضى عنها، فقد أَبلَغَتْ عندَ اللهِ عُذرَها",2],"."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني (20/ 107) (210)، والبيهقي (14831)، وإسماعيل الأصفهاني في ((الترغيب والترهيب)) (2110) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"C5Raj7QE"},{"id":"س-01360","fp":"97d7a94485ce","stateId":384,"easy":"إذا كنت خيراً لأهلك ← تكون من خير الناس","cause":"خَيْرُكم لأهْلِه، وأنا مِن خَيْرِكم لأهْلي","result":"خَيْرُكم","explicit":true,"star":true,"otherNeedIds":[47,45],"ref":"الأحاديث المختارة 11 / 203","srcLabel":"متفق عليه","text":["«أنَّ الرِّجالَ اسْتَأذَنوا رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ في ضَرْبِ النِّساءِ، فأَذِنَ لهم، فباتَ يَسمَعُ صَوْتًا عالِيًا، فقالَ: ما هذا؟ قالوا: أَذِنْتَ للرِّجالِ في ضَرْبِ النِّساءِ، فضَرَبوهم، فنَهاهم، وقالَ: ",["خَيْرُكم",2],[" خَيْرُكم لأهْلِه، وأنا مِن خَيْرِكم لأهْلي»",1],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"نكاح › عشرة النساء","dorar":"F6rTrM3b","merged":10,"otherRefs":["السلسلة الصحيحة 285 (صحيح)","صحيح الجامع 3266 (صحيح)","هداية الرواة 3189 (صحيح)","مسند عمر 1/409 (صحيح)","الإفصاح عن أحاديث النكاح 184 (صحيح)","المستدرك على الصحيحين 7533 (صحيح)","السلسلة الصحيحة 1835 (حسن)","تخريج مشكل الآثار 2523 (صحيح)","فيض القدير 3/ 497 (حسن)"]},{"id":"س-01361","fp":"c898218f476f","stateId":384,"easy":"إذا أدت المرأة حق زوجها كله ← تؤدي حق الله عليها","cause":"حتَّى تُؤَدِّيَ حَقَّ زَوْجِها كلَّه","result":"ولا تُؤَدِّي المَرْأةُ حَقَّ اللهِ عليها كلَّه","explicit":true,"star":true,"otherNeedIds":[51],"ref":"الأحاديث المختارة 13 / 124","srcLabel":"متفق عليه","text":["«قَدِمَ مُعاذٌ اليَمَنَ -أو قالَ: الشَّامَ- فرأى النَّصارى تَسجُدُ لبَطارِقتِها أو أَساقِفتِها، فرَوَّى في نَفْسِه أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ أَحَقُّ أن يُعظَّمَ. فلمَّا قَدِمَ، قالَ: يا رَسولَ اللهِ! رَأيْتُ النَّصارى تَسجُدُ لبَطارِقتِها وأَساقِفتِها فرَوَّأْتُ في نَفْسي أنَّك أَحَقُّ أن تُعَظَّمَ، فقالَ: لو كُنْتُ آمِرًا أحَدًا يَسجُدُ لأحَدٍ لأَمَرْتُ المَرْأةَ أن تَسجُدَ لزَوْجِها، ",["ولا تُؤَدِّي المَرْأةُ حَقَّ اللهِ عليها كلَّه",2]," ",["حتَّى تُؤَدِّيَ حَقَّ زَوْجِها كلَّه",1],"، حتَّى لو سَأَلَها نَفْسَها وهي على ظَهْرِ قَتَبٍ لأَعْطَتْه إيَّاه»."],"grade":"صحيح","narrator":"عبدالله بن أبي أوفى","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"نكاح › عشرة النساء","dorar":"BUvF1ggk","merged":5,"otherRefs":["مجمع الزوائد 4/311 (صحيح)","الأحاديث المختارة 13 / 124 (صحيح)","صحيح ابن ماجه 1515 (صحيح)","صحيح ابن حبان 4171 (صحيح)"]},{"id":"س-05889","fp":"eef7bf0d17b7","stateId":384,"easy":"إذا تركتها على عوجها ← تستمتع بها","cause":"وإنْ تَترُكْها","result":"تستَمتِعْ بها وفيها عِوَجٌ","explicit":true,"star":true,"similar":["س-01348","س-01345","س-01343"],"ref":"تخريج المسند لشعيب 10856","srcLabel":"متفق عليه","text":["لا تستَقيمُ لكَ المرأةُ على خَليقةٍ واحِدةٍ، وإنَّما هي كالضِّلعِ، إنْ تُقِمْها تَكسِرْها، ",["وإنْ تَترُكْها",1]," ",["تستَمتِعْ بها وفيها عِوَجٌ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (5184) دون لفظ: \"لا تستَقيمُ لكَ المرأةُ على خَليقةٍ واحِدةٍ\"، ومسلم (1468) بلفظ: \" لن تستقيم لك على طريقة\"","bab":"رقائق وزهد › الوصايا النافعة","dorar":"pr6A68nJ","merged":3,"otherRefs":["صحيح الجامع 1942 (حسن)","تخريج المسند لشعيب 21339 (حسن)"]},{"id":"س-01336","fp":"e708c10f8e7d","stateId":384,"easy":"إذا كانت زوجتك تسرّك إذا نظرت وتطيعك إذا أمرت وتحفظك إذا غبت ← فهي خير النساء","cause":"الَّتي إذا نَظَر إليها زوجُها سَرَّتْه، وإذا أمَرَها أطاعَتْه، وإذا غابَ عنها حَفِظَتْه في نفسِها ومالِه","result":"خَيرُ نِسائكمُ","explicit":true,"similar":["س-07129","س-03894","س-05985","س-01337"],"ref":"الإفصاح عن أحاديث النكاح 29","srcLabel":"الإفصاح عن أحاديث النكاح","text":[["خَيرُ نِسائكمُ",2],[" الَّتي إذا نَظَر إليها زوجُها سَرَّتْه، وإذا أمَرَها أطاعَتْه، وإذا غابَ عنها حَفِظَتْه في نفسِها ومالِه",1],".\nوفي [رِوايةٍ]: ولا تُخالِفُه في نَفسِها ولا مالِها. وفي أُخرى: في نَفسِها ومالِهِ."],"grade":"صحيح","muhaddith":"[روايات] صحيحة","bab":"نكاح › عشرة النساء","dorar":"oisG01CO","merged":4,"otherRefs":["الأحاديث المختارة 9 / 456 (صحيح)","صحيح الجامع 3299 (صحيح)","المصابيح في الأحاديث المتواترة 609 (صحيح)"]},{"id":"س-07129","fp":"d920c892d042","stateId":384,"easy":"إذا أطاعت المرأة زوجها وسرّته وحفظته ← فهي خير النساء","cause":"الَّتي تُطيعُ زوجَها إذا أمرَ، وتسرُّهُ إذا نظرَ، وتحفظُهُ في نفسِها ومالِهِ","result":"خيرِ النِّساءِ","explicit":true,"repOf":"س-01336","ref":"المحلى 10/334","text":["أنَّهُ سُئِلَ عن ",["خيرِ النِّساءِ",2],"؟ فقالَ: ",["الَّتي تُطيعُ زوجَها إذا أمرَ، وتسرُّهُ إذا نظرَ، وتحفظُهُ في نفسِها ومالِهِ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (3231)، وأحمد (7421)، والبيهقي (13606) باختلاف يسير.","bab":"علم › حسن السؤال ونصح العالم","dorar":"PJNN4qmd","merged":2,"otherRefs":["الفتح السماوي 2/488 (حسن)"]},{"id":"س-03894","fp":"e826c4878b57","stateId":384,"easy":"إذا رُزقت امرأة صالحة تسرك وتطيعك وتحفظك ← فهي خير ما تكنزه","cause":"المرأةُ الصَّالحةُ، إذا نَظَرَ إليها سرَّتْهُ، وإذا أمَرَها أطاعَتْهُ، وإذا غابَ عنها حَفِظتْهُ","result":"ألا أُخْبرُكَ بخيرِ ما يَكنِزُهُ المرءُ","explicit":true,"repOf":"س-01336","otherNeedIds":[55],"ref":"المستدرك على الصحيحين 3323","text":["عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهُما، قالَ: لمَّا نَزَلَتْ: {وَالَّذِينَ يَكْنِزُونَ الذَّهَبَ وَالْفِضَّةَ وَلَا يُنْفِقُونَهَا فِي سَبِيلِ اللَّهِ} [التوبة: 34] كَبُرَ ذلك على المسلمينَ وقالوا: ما يَستطيعُ أَحدُنا أنْ يترُكَ مالًا لولدِهِ يبقى بعدَهُ. فقالَ عُمَرُ: أنا أُفَرِّجُ عنكم. قالَ: فانطَلَقوا وانطَلَقَ عُمَرُ، واتَّبعَهُ ثَوْبانُ فأَتَوْا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ عُمَرُ: يا نَبيَّ اللهِ، قد كَبُرَ على أصحابِكَ هذه الآيةُ. فقالَ نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ: «إنَّ اللهَ لمْ يَفرِضِ الزَّكاةَ إلَّا لِيُطَيِّبَ بها ما بَقِيَ مِن أموالِكُم، وإنَّما فَرَضَ المواريثَ في أموالٍ تَبْقى بعْدَكم». قالَ: فكَبَّرَ عُمَرُ، ثُمَّ قالَ له النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: «",["ألا أُخْبرُكَ بخيرِ ما يَكنِزُهُ المرءُ",2],"؛ ",["المرأةُ الصَّالحةُ، إذا نَظَرَ إليها سرَّتْهُ، وإذا أمَرَها أطاعَتْهُ، وإذا غابَ عنها حَفِظتْهُ",1],"»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داود (1664)، والبيهقي(7235) واللفظ لهما","bab":"تفسير آيات › سورة التوبة","dorar":"DefeprPc"},{"id":"س-02981","fp":"fe0caaa8e04b","stateId":384,"easy":"إذا كنتِ متزوجة ← فزوجك جنتك ونارك","cause":"فأين أنتِ منه","result":"فإنَّما هو جَنَّتُكِ ونارُكِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-01356"],"otherNeedIds":[67],"ref":"المستدرك على الصحيحين 2807","srcLabel":"الطبراني","text":["عنْ حُصَينِ بنِ مِحصَنٍ، قالَ: حدَّثَتْني عَمَّتي، قالتْ: أَتيتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ في بعضِ الحاجةِ، فقالَ: أيْ هذه، أذاتُ بَعْلٍ أنتِ؟ قلتُ: نَعَمْ، قالَ: كيف أنتِ له؟ قالتْ: ما آلوهُ إلَّا ما عَجَزْتُ عنه، قالَ: ",["فأين أنتِ منه",1],"؛ ",["فإنَّما هو جَنَّتُكِ ونارُكِ",2],"؟"],"grade":"صحيح","narrator":"[عمة حصين بن محصن]","muhaddith":"صحيح","takhrij":"أخرجه الحميدي (358)، والطبراني في ((الكبير)) (25/ 183) (449)، وأبو نعيم في ((معرفة الصحابة)) (8071) بنحوه.","bab":"إيمان › الوعيد","dorar":"voXm1A5Y","merged":3,"otherRefs":["السلسلة الصحيحة 2612 (حسن)","الفروع لابن مفلح 8/ 413 (حسن)"]},{"id":"س-01348","fp":"19841eec8af6","stateId":384,"easy":"إذا استمتعت بزوجتك على عوجها ← تستمتع بها، وإن أقمتها كسرتها","cause":"فإِنَّ استمْتَعْتَ بِها","result":"استمتعْتَ بِها وبِها عِوَجٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-05889","ref":"صحيح الجامع 1943","text":["إِنَّ المرأةَ خُلِقَتْ مِنْ ضِلَعٍ ، لَنْ تستقيمَ لَكَ علَى طريقَةٍ ، ",["فإِنَّ استمْتَعْتَ بِها",1]," ",["استمتعْتَ بِها وبِها عِوَجٌ",2]," ، وإِنْ ذهبْتَ تقيمُها كسرْتَهَا ، وكسرُها طلاقُها"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1468) واللفظ له، وأخرجه البخاري (3331، 5184) مفرقاً بنحوه","bab":"نكاح › عشرة النساء","dorar":"cHcxL7m5","merged":5,"otherRefs":["صحيح ابن حبان 4180 (صحيح)","صحيح البخاري 5184 (صحيح)","صحيح مسلم 1468 (صحيح)","تخريج صحيح ابن حبان 4179 (صحيح)"]},{"id":"س-05985","fp":"ed267410fef5","stateId":384,"easy":"إذا رُزقت زوجة صالحة تطيعك وتسرك وتبرّك ← فهي خير ما تستفيده بعد التقوى","cause":"زَوجةٍ صالحةٍ ، إن أمرَها أطاعتْهُ ، وإن نظرَ إليها سرَّتهُ ، وإن أقسمَ عليها أبرَّتهُ ، وإن غابَ عنها نصحَتهُ في نفسِها ومالِهِ","result":"ما استفادَ المؤمنُ بعدَ تقوى اللَّهِ عزَّ وجلَّ ، خيرًا لهُ مِن","explicit":true,"repOf":"س-01336","otherNeedIds":[7],"ref":"الجامع الصغير 7792","text":[["ما استفادَ المؤمنُ بعدَ تقوى اللَّهِ عزَّ وجلَّ ، خيرًا لهُ مِن",2]," ",["زَوجةٍ صالحةٍ ، إن أمرَها أطاعتْهُ ، وإن نظرَ إليها سرَّتهُ ، وإن أقسمَ عليها أبرَّتهُ ، وإن غابَ عنها نصحَتهُ في نفسِها ومالِهِ",1]],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"حسن","takhrij":"أخرجه ابن ماجه (1857)، والطبراني (8/ 222) (7881)، وابن عساكر (43/ 279) واللفظ لهم.","bab":"رقائق وزهد › تقوى الله","dorar":"4K4UxlzC"},{"id":"س-01337","fp":"b7b86626dd14","stateId":384,"easy":"إذا كانت زوجتك تسرّك وتطيعك وتحفظك ← فهي خير النساء","cause":"خَيرُ النِّساءِ مَنْ تَسَرُّ إذا نَظَرَ، وتُطيعُ إذا أَمَرَ، ولا تُخالِفُه في نَفسِها ومالِها","result":"أيُّ النِّساءِ خيرٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-01336","ref":"المستدرك على الصحيحين 2720","text":["عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ مثلَهُ: [سُئلَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",["أيُّ النِّساءِ خيرٌ",2],"؟ فقالَ: ",["خَيرُ النِّساءِ مَنْ تَسَرُّ إذا نَظَرَ، وتُطيعُ إذا أَمَرَ، ولا تُخالِفُه في نَفسِها ومالِها.]",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه النسائي (3231)، وأحمد (9587) والبيهقي في ((شعب الإيمان)) (8363) بلفظ مقارب","bab":"نكاح › عشرة النساء","dorar":"JMbW5T9Q","merged":3,"otherRefs":["تخريج سنن أبي داود 3/98 (صحيح)","صحيح الجامع 3298 (صحيح)"]},{"id":"س-01345","fp":"5b05fb863c6b","stateId":384,"easy":"إذا داريت زوجتك ← فإن فيها أوداً وبلغة","cause":"و إنْ تدارِيَها","result":"فإنْ فيها أَودًا و بَلغةً","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-05889","ref":"صحيح الأدب المفرد 574","text":["إِنَّ المرأةَ خُلِقَتْ من ضِلَعٍ ، و إنَّكَ إنْ تريدَ أنْ تقيمَها تكسرُها ، ",["و إنْ تدارِيَها",1]," ",["فإنْ فيها أَودًا و بَلغةً",2]],"grade":"حسن","narrator":"أبو ذر.","muhaddith":"حسن","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (747) بلفظه مطولًا، والدارمي (2267)، والنسائي في ((الكبرى)) (9107) باختلاف يسير.","bab":"نكاح › عشرة النساء","dorar":"1ts9uPLO"},{"id":"س-01343","fp":"31e53d6cc5f6","stateId":384,"easy":"إذا داريت زوجتك ← تعيش بها","cause":"فَدارِها","result":"تَعِشْ بِها","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-05889","ref":"المستدرك على الصحيحين 7539","text":["ألَا إنَّ المرأةَ خُلِقَتْ مِن ضِلَعٍ، وإنَّكَ إنْ تُرِدْ إقامتَها تَكْسِرْها، ",["فَدارِها",1]," ",["تَعِشْ بِها",2],". ثَلاثَ مرَّاتٍ."],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"صحيح الإسناد على شرط الشيخين","takhrij":"أخرجه أحمد (20093)، وابن أبي الدنيا في ((النفقة على العيال)) (470) بلفظه.","bab":"نكاح › عشرة النساء","dorar":"mPzaJmFk","merged":3,"otherRefs":["الجامع الصغير 2106 (صحيح)","صحيح الموارد 1090 (صحيح)"]},{"id":"س-01349","fp":"22c4e8cb24eb","stateId":384,"easy":"إذا تزوجت المرأة بعد وفاة زوجها ← فهي لآخر أزواجها في الجنة","cause":"فتزوَّجَتْ بعدَهُ","result":"فِهِي لآخِرِ أزواجِها","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[67],"ref":"صحيح الجامع 2704","srcLabel":"الطبراني","text":["أيُّما امرأةٍ تُوُفِّي عنها زوجها ، ",["فتزوَّجَتْ بعدَهُ",1]," ، ",["فِهِي لآخِرِ أزواجِها",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (3130) واللفظ له، وأخرجه أبو يعلى كما في ((إتحاف الخيرة المهرة)) للبوصيري (4/115) باختلاف يسير، وأبو الشيخ في ((طبقات المحدثين)) (4/36) مختصراً","bab":"نكاح › عشرة النساء","dorar":"4NO8kHTi"},{"id":"س-01356","fp":"59022c96231b","stateId":384,"easy":"إذا كنتِ ذات زوج ← فهو جنتك ونارك","cause":"فكيف أنتِ له","result":"فإنه جنتُكِ ونارُكِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-02981","otherNeedIds":[67],"ref":"المتجر الرابح 314","text":["أنَّ عمَّةً له أتتِ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ فقال لها: أذاتُ زوجٍ أنتِ؟ قالت: نعم قال: فأين أنتِ منه؟ قالت: ما آلوه إلا ما عجزتُ عنه قال: ",["فكيف أنتِ له",1]," ",["فإنه جنتُكِ ونارُكِ",2],"."],"grade":"صحيح","narrator":"حصين بن محصن","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (19003)، والحميدي (358)، والنسائي في ((السنن الكبرى)) (8914) جميعهم بلفظه.","bab":"نكاح › عشرة النساء","dorar":"ezq61oeT"},{"id":"س-06328","fp":"c12535fb5fd6","stateId":384,"easy":"إذا تصدقتِ على زوجك وولدك ← فهم أحق من تصدقت عليهم","cause":"زوجُك وولَدُك","result":"أحقُّ مَن تصدَّقْتِ به عليهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[47],"ref":"تخريج صحيح ابن حبان 5744","srcLabel":"متفق عليه","text":["خرَج رسولُ اللهِ صلَّى اللهُ عليه وسلَّم في أضحى أو فِطْرٍ إلى المُصلَّى فصلَّى ثمَّ انصرَف فقام فوعَظ النَّاسَ وأمَرهم بالصَّدقةِ قال: ( أيُّها النَّاسُ تصدَّقوا ) ثمَّ انصرَف فمرَّ على النِّساءِ فقال: ( يا معشرَ النِّساءِ تصدَّقْنَ فإنِّي أراكنَّ أكثَرَ أهلِ النَّارِ ) فقُلْنَ: ولمَ ذلك يا رسولَ اللهِ ؟ قال: ( تُكثِرْنَ اللَّعنَ وتكفُرْنَ العشيرَ ما رأَيْتُ مِن ناقصاتِ عقلٍ ودِينٍ أذهَبَ لِلُبِّ الرَّجُلِ الحازمِ مِن إحداكنَّ يا معشرَ النِّساءِ ) فقُلْنُ له: ما نقصانُ دِينِنا وعقلِنا يا رسولَ اللهِ ؟ قال: ( أليس شَهادةُ المرأةِ مِثْلَ نصفِ شَهادةِ الرَّجُلِ ) قُلْنَ: بلى قال: ( فذاك نُقصانُ عقلِها أوَليسَتْ إذا حاضتِ المرأةُ لم تُصَلِّ ولم تَصُمْ ) ؟ قُلْنَ: بلى قال ( فذاك نُقصانُ دِينِها ) ثمَّ انصرَف رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فلمَّا صار إلى منزلِه جاءتْ زينبُ امرأةُ عبدِ اللهِ بنِ مسعودٍ تستأذِنُ عليه فقيل: يا رسولَ اللهِ هذه زينبُ تستأذِنُ عليك فقال: ( أيُّ الزَّيانبِ ) ؟ قيل: امرأةُ عبدِ اللهِ بنِ مسعودٍ قال: ( نَعم ائذَنوا لها ) فأذِن لها فقالت: يا نبيَّ اللهِ إنَّك أمَرْتَنا اليومَ بالصَّدقةِ وكان عندي حُلِيٌّ فأرَدْتُ أنْ أتصدَّقَ فزعَم ابنُ مسعودٍ أنَّه وولَدَه أحقُّ مَن تصدَّقْتُ به عليهم فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ( صدَق ",["زوجُك وولَدُك",1]," ",["أحقُّ مَن تصدَّقْتِ به عليهم",2]," )"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه البخاري (1462) باختلاف يسير، ومسلم (80) دون ذكر لفظه","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"0z0NtOOk","merged":2,"otherRefs":["صحيح الجامع 3755 (صحيح)"]},{"id":"س-04761","fp":"375752d38e53","stateId":384,"easy":"إذا أُعطي أهل البيت الرفق ← نفعهم، وإذا مُنعوه ضرّهم","cause":"ما أُعْطِيَ أهلُ بَيتِ الرِّفْقَ","result":"إلَّا نَفَعَهُمْ، و لا مُنِعُوهُ إلَّا ضَرَّهُمْ","explicit":true,"similar":["س-08456"],"otherNeedIds":[55],"ref":"السلسلة الصحيحة 942","srcLabel":"ابن قانع","text":[["ما أُعْطِيَ أهلُ بَيتِ الرِّفْقَ",1]," ",["إلَّا نَفَعَهُمْ، و لا مُنِعُوهُ إلَّا ضَرَّهُمْ",2],"."],"grade":"صحيح","narrator":"عبيدالله بن معمر","muhaddith":"إسناده صحيح رجاله ثقات","takhrij":"أخرجه ابن قانع في ((معجم الصحابة)) (2/ 178)، وأبو نعيم في ((معرفة الصحابة)) (4722)، وابن الأثير في ((أسد الغابة)) (3/ 526)، وابن عساكر (38/ 123) واللفظ لهم جميعا.","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"LEXLUFDj"},{"id":"س-05521","fp":"835696572851","stateId":384,"easy":"إذا خرجت تسعى على أولادك الصغار ← فأنت في سبيل الله","cause":"خَرَجَ يَسعى على ولدِه صِغارًا","result":"فهو في سَبيل اللهِ","explicit":true,"otherNeedIds":[49],"ref":"حسن الأسوة بما ثبت في النسوة 564","srcLabel":"الطبراني","text":["مَرَّ على النَّبيِّ صلَّى اللهُ عليه وسلَّم رَجُلٌ فرَأى أصحابُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم مِن جَلَدِه ونَشاطِه، فقالوا: يا رَسولَ اللهِ، لو كان هذا في سَبيلِ اللهِ! فقال رسولُ اللهِ: إن كان ",["خَرَجَ يَسعى على ولدِه صِغارًا",1]," ",["فهو في سَبيل اللهِ",2],"، وإن كان خَرَجَ يَسعى على أبَوينِ شَيخَينِ كَبيرَينِ فهو في سَبيلِ اللهِ، وإن كان خَرَجَ يَسعى على نَفسِه يُعِفُّها فهو في سَبيلِ اللهِ، وإن كان خَرَجَ يَسعى رياءً ومُفاخَرةً فهو في سَبيلِ الشَّيطانِ"],"grade":"صحيح","narrator":"كعب بن عجرة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((الأوسط)) (6835)، وبحشل في ((تاريخ واسط)) (صـ162) واللفظ لهما.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"yhlIFCs7"},{"id":"س-08456","fp":"e3e6077ddbd6","stateId":384,"easy":"إذا رفقت في بيتك ← فإن الله إذا أراد بأهل بيت خيراً دلهم على الرفق","cause":"ارْفُقي","result":"فإنَّ اللهَ إذا أرادَ بأهلِ بيتٍ خَيرًا، دَلَّهم على بابِ الرِّفقِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04761","ref":"تخريج المسند لشعيب 24734","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال لها: يا عائشةُ، ",["ارْفُقي؛ ",1],["فإنَّ اللهَ إذا أرادَ بأهلِ بيتٍ خَيرًا، دَلَّهم على بابِ الرِّفقِ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (24734) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (4/295)، والبيهقي في ((شعب الإيمان)) (6560) بنحوه","bab":"نفقة › نفقة الرقيق والرفق بهم والإحسان إليهم","dorar":"otWQKxhk"},{"id":"س-00488","fp":"e00eb723415f","stateId":384,"easy":"إذا خفضت (الخاتنة) فلا تنهك ← فهو أحظى للمرأة وأحب إلى الزوج","cause":"لا تُنهِكي","result":"فإنَّ ذلِك أحظى للمرأةِ وأحبُّ إلى البَعلِ","explicit":true,"similar":["س-01317"],"ref":"هداية الرواة 4/245","srcLabel":"أبو داود","text":["أنَّ امرأةً كانت تختِنُ بالمدينةِ فقالَ لَها النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ ",["لا تُنهِكي ",1],["فإنَّ ذلِك أحظى للمرأةِ وأحبُّ إلى البَعلِ",2]],"grade":"حسن","narrator":"أم عطية نسيبة بنت كعب","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه أبو داود (5271)، والبيهقي (18015) واللفظ لهما، وابن عدي في ((الكامل في الضعفاء)) (6/217) باختلاف يسير","bab":"آداب عامة › المباحات من الأفعال والأقوال","dorar":"yXLPyP3s"},{"id":"س-01317","fp":"63d192d41764","stateId":384,"easy":"إذا خُتنت الأنثى فلا تُنهك ← فهو أسرى للوجه وأحظى عند الزوج","cause":"إذا خفضتِ فأشِمِّي ولا تنهكي","result":"فإنَّهُ أسرى للوجهِ وأحظى عند الزوجِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-00488","ref":"مجمع الزوائد 5/175","text":["أنَّ النبيَّ صلَّى اللهُ عليه وسلَّمَ قال لأمِّ عطيةَ ختانةٌ كانت بالمدينةِ ",["إذا خفضتِ فأشِمِّي ولا تنهكي",1]," ",["فإنَّهُ أسرى للوجهِ وأحظى عند الزوجِ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((المعجم الصغير)) (122) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (3/228)، والبيهقي (18017) باختلاف يسير","bab":"نكاح › حق الزوج على المرأة","dorar":"K9dos3a5"}]}