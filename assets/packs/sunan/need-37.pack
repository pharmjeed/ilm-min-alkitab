{"schema":1,"kind":"sunan-chunk","version":"sunan-50a61695a4db","needId":37,"stateIds":[308,309,310],"items":[{"id":"س-06217","fp":"e49d60109b7c","stateId":308,"easy":"إذا استطعت ألا يرى عورتك أحد فافعل ← فالله أحق أن يُستحيا منه","cause":"إن استَطعتَ أن لا يراها أحدٌ فافعَل","result":"اللَّهُ أحقُّ أن يُستَحى مِنهُ منَ النَّاسِ","explicit":true,"star":true,"otherNeedIds":[21],"ref":"السيل الجرار 2/300","srcLabel":"البخاري","text":["عَوراتُنا ما نأتي منها وما نذَرُ ؟ فقال صلَّى اللَّهُ عليهِ وآلِهِ وسلَّمَ : ",["إن استَطعتَ أن لا يراها أحدٌ فافعَل",1]," ، فقال : الرَّجلُ يكونُ خاليًا ؟ قال : ",["اللَّهُ أحقُّ أن يُستَحى مِنهُ منَ النَّاسِ",2]],"grade":"صحيح","narrator":"[معاوية بن حيدة القشيري]","muhaddith":"صحيح","takhrij":"أخرجه البخاري معلقاً بصيغة الجزم قبل حديث (278) مختصراً، وأخرجه أبو داود (4017)، والترمذي (2769)، والنسائي في ((السنن الكبرى)) (8972)، وابن ماجه (1920)، وأحمد (20034) مطولاً.","bab":"ستر العورة › وجوب سترها","dorar":"SyEXfjwo"},{"id":"س-07251","fp":"0d38c108ceef","stateId":308,"easy":"إذا سترت مسلماً ← يسترك الله في الدنيا والآخرة","cause":"ومَن ستَرَ مُسْلمًا","result":"ستَرَه اللهُ في الدُّنيا والآخِرَةِ","explicit":true,"star":true,"similar":["س-08043"],"ref":"تخريج المسند لشعيب 7427","srcLabel":"مسلم","text":["مَن نفَّسَ عن مُؤْمنٍ كُرْبَةً مِن كُرَبِ الدُّنيا؛ نفَّسَ اللهُ عَنه كُرْبَةً مِن كُرَبِ يَوْمِ القِيامَةِ، ",["ومَن ستَرَ مُسْلمًا ",1],["ستَرَه اللهُ في الدُّنيا والآخِرَةِ، ",2],"ومَن يسَّرَ على مُعْسِرٍ يسَّرَ اللهُ عليه في الدُّنيا والآخِرَةِ، واللهُ في عَوْنِ العَبْدِ ما كان العَبْدُ في عَوْنِ أَخيه، ومَن سلَكَ طَريقًا يَلْتَمِسُ فيه عِلْمًا سهَّلَ اللهُ له به طَريقًا إلى الجنةِ، وما اجتمَعَ قَوْمٌ في بَيْتٍ مِن بُيوتِ اللهِ يَتْلُون كِتابَ اللهِ، ويَتَدارَسُونه بَيْنَهم؛ إلَّا نزلَتْ عليهم السَّكِينَةُ، وغشِيَتْهم الرَّحْـمةُ، وحفَّتْهم الـمَلائِكةُ، وذكَرَهم اللهُ عزَّ وجلَّ فيمَن عِندَه، ومَن أبْطَأَ به عَمَلُه، لَـمْ يُسْرِعْ به نَسَبُه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (2699) باختلاف يسير","bab":"علم › فضل مجالس العلم والذكر","dorar":"hv3Ejh53","merged":2,"otherRefs":["عمدة القاري 12/405 (صحيح)"]},{"id":"س-00526","fp":"95d492bab15c","stateId":308,"easy":"إذا سترت عورة مؤمن ← يستر الله عورتك ويعينك ما دمت في عونه","cause":"من ستر على مؤمنٍ عورتَه","result":"ستر اللهُ عورتَه ولا يزالُ اللهُ في عونِه ما دام في عونِ أخيه","explicit":true,"star":true,"ref":"معجم الشيوخ 2/921","srcLabel":"مسلم","text":[["من ستر على مؤمنٍ عورتَه ",1],["ستر اللهُ عورتَه ولا يزالُ اللهُ في عونِه ما دام في عونِ أخيه",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه مسلم (2699) مطولاً باختلاف يسير","bab":"آداب عامة › ضرب الأمثال","dorar":"jMwt741W"},{"id":"س-02877","fp":"aa7341832ea2","stateId":308,"easy":"إذا سترت أخاك المسلم ← يسترك الله يوم القيامة","cause":"مَن ستَرَ أخاه المُسلِمَ","result":"ستَرَ اللهُ عليه يَومَ القيامةِ","explicit":true,"similar":["س-07054","س-07055"],"ref":"تخريج المسند لشعيب 10761","srcLabel":"مسلم","text":[["مَن ستَرَ أخاه المُسلِمَ، ",1],["ستَرَ اللهُ عليه يَومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2699) مطولاً بلفظ مقارب","bab":"إيمان › الوعد","dorar":"UqRfx5Tj"},{"id":"س-08043","fp":"990a60d1d37c","stateId":308,"easy":"إذا سترت مسلماً ← يسترك الله يوم القيامة","cause":"ومَن سَتَرَ مُسلِمًا","result":"سَتَرَه اللهُ يَومَ القيامةِ","explicit":true,"repOf":"س-07251","ref":"صحيح البخاري 2442","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: المُسلِمُ أخو المُسلِمِ لا يَظلِمُه ولا يُسلِمُه، ومَن كان في حاجةِ أخيه كان اللهُ في حاجَتِه، ومَن فرَّجَ عن مُسلِمٍ كُربةً فرَّجَ اللهُ عنه كُربةً مِن كُرُباتِ يَومِ القيامةِ، ",["ومَن سَتَرَ مُسلِمًا",1]," ",["سَتَرَه اللهُ يَومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2580) باختلاف يسير","bab":"مظالم › تحريم الظلم","dorar":"jlxZZOdn"},{"id":"س-00313","fp":"fdcc001cdf6e","stateId":308,"easy":"إذا علمت من أخيك سيئة فسترتها ← يسترك الله يوم القيامة","cause":"من علِم من أخيه سيِّئةً فسترها","result":"ستر اللهُ عليه يومَ القيامةِ قال نعم","explicit":true,"similar":["س-07053"],"ref":"الترغيب والترهيب 3/240","srcLabel":"السنة","text":["أنَّ عقبةَ بنَ عامرٍ رضِي اللهُ عنه أتَى مسلمةَ بنَ مخلَدٍ فكان بينه وبين البوَّابِ شيءٌ فسمِع صوتَه فأذِن له فقال إنِّي لم آتِك زائرًا ولكن جئتُك لحاجةٍ أتذكرُ يومَ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["من علِم من أخيه سيِّئةً فسترها ",1],["ستر اللهُ عليه يومَ القيامةِ قال نعم",2]," قال لهذا جئتُ"],"grade":"صحيح","narrator":"عقبة بن عامر الجهني ومسلمة بن مخلد","muhaddith":"رجاله رجال الصحيح","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"AsZvLgPe"},{"id":"س-00328","fp":"b953dd9e8665","stateId":308,"easy":"إذا سترت مؤمناً على عورة في الدنيا ← يسترك الله يوم القيامة","cause":"مَن سَتَرَ مؤْمِنًا في الدُّنيا على عَورةٍ","result":"سَتَرَه اللهُ يَومَ القيامةِ","explicit":true,"ref":"تخريج المسند لشعيب 17454","srcLabel":"أحمد","text":["رَكِبَ أبو أيوبَ إلى عُقْبةَ بنِ عامِرٍ إلى مِصرَ، فقال: إنِّي سائِلُك عن أمْرٍ لم يَبْقَ ممَّن حضَرَه مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ إلَّا أنا وأنت، كيف سمِعتَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ في سَترِ المؤْمِنِ؟ فقال: سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن سَتَرَ مؤْمِنًا في الدُّنيا على عَورةٍ ",1],["سَتَرَه اللهُ يَومَ القيامةِ",2],". فرجَعَ إلى المدينةِ، فما حَلَّ رَحْلَه يُحَدِّثُ هذا الحديثَ."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"المرفوع منه صحيح لغيره","takhrij":"أخرجه أحمد (17454) واللفظ له، وعبدالرزاق بعد حديث (18936)، والحميدي (384)","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"VRU9YbQB"},{"id":"س-02805","fp":"99fd6185bdf2","stateId":308,"easy":"إذا سترت عورة أخيك المسلم ← يستر الله عورتك يوم القيامة","cause":"مَن سترَ عورةَ أخيهِ المسلمِ","result":"سترَ اللَّهُ عورتَهُ يومَ القيامةِ","explicit":true,"ref":"صحيح ابن ماجه 2079","srcLabel":"ابن ماجه","text":[["مَن سترَ عورةَ أخيهِ المسلمِ ",1],["سترَ اللَّهُ عورتَهُ يومَ القيامةِ",2]," ومن كشفَ عورةَ أخيهِ المسلمِ كشفَ اللَّهُ عورتَهُ حتَّى يفضحَهُ بِها في بيتِهِ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (2546)","bab":"إيمان › الوعد","dorar":"Rpx6G8YD"},{"id":"س-07053","fp":"b75930001357","stateId":308,"easy":"إذا علمت من أخيك سيئة فسترتها ← يسترك الله بها يوم القيامة","cause":"مَن عَلِمَ مِن أخيه سَيِّئةً فسَتَرَها","result":"سَتَرَه اللهُ عَزَّ وجَلَّ بها يَومَ القيامةِ","explicit":true,"repOf":"س-00313","ref":"تخريج المسند لشعيب 16960","text":["«",["مَن عَلِمَ مِن أخيه سَيِّئةً فسَتَرَها ",1],["سَتَرَه اللهُ عَزَّ وجَلَّ بها يَومَ القيامةِ",2],"» فقال: نَعَم، فقال: لهذا جِئتُ، قال ابنُ أبي عَديٍّ في حَديثِه: رَكِبَ عُقبةُ بنُ عامِرٍ إلى مَسلَمةَ بنِ مُخَلَّدٍ، وهو أميرٌ على مِصرَ."],"grade":"صحيح","narrator":"مسلمة بن مخلد","muhaddith":"صحيح","bab":"علم › الحث على طلب العلم","dorar":"WkTguE3S"},{"id":"س-07054","fp":"3045bcc6698d","stateId":308,"easy":"إذا سترت أخاك المسلم في الدنيا ← يسترك الله يوم القيامة","cause":"مَن سَتَرَ أخاه المُسلِمَ في الدُّنيا","result":"سَتَرَه اللهُ يَومَ القيامةِ، فرَحَلَ إليه وهو بمِصرَ فسَألَه عنِ الحَديثِ","explicit":true,"repOf":"س-02877","ref":"تخريج المسند لشعيب 16596","text":["«",["مَن سَتَرَ أخاه المُسلِمَ في الدُّنيا ",1],["سَتَرَه اللهُ يَومَ القيامةِ»، فرَحَلَ إليه وهو بمِصرَ فسَألَه عنِ الحَديثِ",2],"، قال: نَعَم، سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: «مَن سَتَرَ أخاه المُسلِمَ في الدُّنيا سَتَرَه اللهُ يَومَ القيامةِ»، قال: وأنا قد سَمِعتُه مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم."],"grade":"صحيح","narrator":"عم منيب","muhaddith":"صحيح لغيره","bab":"علم › الحث على طلب العلم","dorar":"FfRa6IEd"},{"id":"س-07055","fp":"9dd964a211d9","stateId":308,"easy":"إذا سترت أخاك المسلم في الدنيا ← يسترك الله يوم القيامة","cause":"مَن سَتَرَ أخاه المُسلِمَ في الدُّنيا","result":"سَتَرَه اللهُ يَومَ القيامةِ","explicit":true,"repOf":"س-02877","ref":"تخريج المسند لشعيب 16596","text":["«مَن سَتَرَ أخاه المُسلِمَ في الدُّنيا سَتَرَه اللهُ يَومَ القيامةِ»، فرَحَلَ إليه وهو بمِصرَ فسَألَه عنِ الحَديثِ، قال: نَعَم، سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: «",["مَن سَتَرَ أخاه المُسلِمَ في الدُّنيا ",1],["سَتَرَه اللهُ يَومَ القيامةِ»",2],"، قال: وأنا قد سَمِعتُه مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم."],"grade":"صحيح","narrator":"عم منيب","muhaddith":"صحيح لغيره","bab":"علم › الحث على طلب العلم","dorar":"FfRa6IEd"},{"id":"س-03345","fp":"661fda6f2171","stateId":308,"easy":"إذا غسّلت ميتاً فسترته ← يسترك الله من الذنوب","cause":"مَنْ غَسَّلَ مَيِّتًا فَسترَهُ","result":"سترَهُ اللهُ مِنَ الذُّنوبِ","explicit":true,"otherNeedIds":[11],"ref":"السلسلة الصحيحة 2353","srcLabel":"الطبراني","text":[["مَنْ غَسَّلَ مَيِّتًا فَسترَهُ ، ",1],["سترَهُ اللهُ مِنَ الذُّنوبِ ، ",2],"ومَنْ كَفَّنَ مسلمًا ، كَساهُ اللهُ مِنَ السُّنْدُسِ"],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"ذكر له طرقا ثم قال وللحديث شاهد قوي","takhrij":"أخرجه الطبراني (8/337) (8077) واللفظ له، وابن بشران في ((الأمالي)) (1647)، والبيهقي في ((شعب الإيمان)) (9267) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"skkywlxb"},{"id":"س-04599","fp":"aa4405240a8a","stateId":308,"easy":"إذا رأيت مذنباً فسترته ← كان خيراً لك","cause":"لو سترتَه بثوبِك","result":"كان خيرًا لك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[30],"ref":"الترغيب والترهيب 3/240","srcLabel":"أبو داود","text":["أنَّ ماعزًا أتَى النَّبيَّ صلَّى اللهُ عليه وسلَّم فأقرَّ عنده أربعَ مرَّاتٍ فأمر برجمِه وقال لهزَّالٍ ",["لو سترتَه بثوبِك",1]," ",["كان خيرًا لك",2]],"grade":"صحيح","narrator":"يزيد بن نعيم الأسلمي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (4377)، وأحمد (21892) واللفظ لهما.","bab":"حدود › من أقر بالحد","dorar":"olC07qnr"},{"id":"س-04000","fp":"846d12ba0466","stateId":309,"easy":"إذا ألممت بذنب فاستتر بستر الله وتب ← فمن أبدى صفحته أُقيم عليه الحد","cause":"فمن ألَمَّ بشيءٍ منها فلْيستَتِرْ بسِترِ اللهِ ، و لْيَتُبْ إلى اللهِ","result":"فإنه من يُبدِ لنا صفحتَه ، نُقِمْ عليه كتابَ اللهِ","explicit":true,"star":true,"otherNeedIds":[11],"ref":"صحيح الجامع 149","srcLabel":"الحاكم","text":["أنَّ رسول الله صلَّى الله عليه وسلم قام بعد أنْ رجَم الأسْلَميَّ فقال: اجتنِبوا هذه القاذوراتِ التي نهى اللهُ تعالى عنها ، ",["فمن ألَمَّ بشيءٍ منها فلْيستَتِرْ بسِترِ اللهِ ، و لْيَتُبْ إلى اللهِ",1]," ، ",["فإنه من يُبدِ لنا صفحتَه ، نُقِمْ عليه كتابَ اللهِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (91)، والحاكم (7615)، والبيهقي (18056) باختلاف يسير","bab":"توبة › الحض على التوبة","dorar":"W2yBTJ9P","merged":2,"otherRefs":["خلاصة البدر المنير 2/303 (صحيح)"]},{"id":"س-03998","fp":"0c8c275afc78","stateId":309,"easy":"إذا وقعت في شيء من القاذورات فاستتر ← يسترك الله","cause":"مَن أتَى شيئًا مِن هذِهِ القاذوراتِ فليستَتر","result":"يسِترِ اللَّهِ عليهِ","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 2/127","srcLabel":"السنة","text":[["مَن أتَى شيئًا مِن هذِهِ القاذوراتِ فليستَتر",1]," ",["يسِترِ اللَّهِ عليهِ",2]],"grade":"حسن","muhaddith":"إسناده جيد","bab":"توبة › الحض على التوبة","dorar":"gbeIifBD"},{"id":"س-06222","fp":"0194315f6369","stateId":309,"easy":"إذا سترت أخاك ← سترك الله","cause":"ستَرْتُه بالثَّوبِ","result":"لو فعَلْتُما غَيرَ ذلك لسَتَرْتُكما","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[30],"ref":"المستدرك على الصحيحين 4948","srcLabel":"الحاكم","text":["جاءَ عَليٌّ وحَمْزةُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ وقدِ اغتَسَلَا، فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: «كيف صنَعْتُما؟» قالَ أحَدُهما: يا رَسولَ اللهِ، ",["ستَرْتُه بالثَّوبِ",1],"، وقالَ الآخَرُ: فعَلْتُ مِثلَ ذلك، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «",["لو فعَلْتُما غَيرَ ذلك لسَتَرْتُكما",2],"»."],"grade":"صحيح","narrator":"[الحسين بن علي]","muhaddith":"صحيح الإسناد","takhrij":"لم نقف عليه إلا عند الحاكم (4879).","bab":"ستر العورة › وجوب سترها","dorar":"TsGBTvk5"},{"id":"س-03465","fp":"4c0b0a74d46b","stateId":310,"easy":"إذا حفظت لسانك ← يستر الله عورتك","cause":"ومَن خَزَنَ لِسانَه","result":"سَتَرَ اللهُ عَزَّ وجَلَّ عَوْرتَه","explicit":true,"star":true,"ref":"الأحاديث المختارة 2751","srcLabel":"متفق عليه","text":["«مَن كَفَّ غَضَبَه كَفَّ اللهُ عنه عَذابَه، ",["ومَن خَزَنَ لِسانَه",1]," ",["سَتَرَ اللهُ عَزَّ وجَلَّ عَوْرتَه",2],"، ومَن اعْتَذَرَ إلى اللهِ عَزَّ وجَلَّ عَذَرَه»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"استغفار › فضل الاستغفار","dorar":"sfCSIGM2"},{"id":"س-05505","fp":"4cb36b8578bb","stateId":310,"easy":"إذا ربطت الخيل تعففاً ولم تنسَ حق الله فيها ← فهي لك ستر","cause":"رَبَطَها تَغَنِّيًا وتَعَفُّفًا، ثُمَّ لَم يَنسَ حَقَّ اللهِ في رِقابِها ولا ظُهورِها","result":"فهي لذلك سِترٌ","explicit":true,"otherNeedIds":[1],"ref":"صحيح البخاري 2371","srcLabel":"متفق عليه","text":["الخَيلُ لرَجُلٍ أجرٌ، ولرَجُلٍ سِترٌ، وعلى رَجُلٍ وِزرٌ؛ فأمَّا الذي له أجرٌ فرَجُلٌ رَبَطَها في سَبيلِ اللهِ، فأطالَ بها في مَرجٍ أو رَوضةٍ، فما أصابَت في طِيَلِها ذلك مِنَ المَرجِ أوِ الرَّوضةِ كانَت له حَسَناتٍ، ولو أنَّه انقَطَعَ طِيَلُها فاستَنَّت شَرَفًا أو شَرَفَينِ، كانَت آثارُها وأرواثُها حَسَناتٍ له، ولو أنَّها مَرَّت بنَهَرٍ، فشَرِبَت منه ولَم يُرِدْ أن يَسقيَ، كان ذلك حَسَناتٍ له، فهي لذلك أجرٌ. ورَجُلٌ ",["رَبَطَها تَغَنِّيًا وتَعَفُّفًا، ثُمَّ لَم يَنسَ حَقَّ اللهِ في رِقابِها ولا ظُهورِها",1],"؛ ",["فهي لذلك سِترٌ",2],". ورَجُلٌ رَبَطَها فخرًا ورياءً ونِواءً لأهلِ الإسلامِ، فهي على ذلك وِزرٌ. وسُئِلَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم عَنِ الحُمُرِ، فقال: ما أُنزِلَ عليَّ فيها شَيءٌ إلَّا هذه الآيةُ الجامِعةُ الفاذَّةُ: {فمَن يَعمَل مِثقالَ ذَرَّةٍ خَيرًا يَرَه * ومَن يَعمَلْ مِثقال ذَرَّةٍ شَرًّا يَرَه} [الزلزلة: 7، 8]."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2371 )، ومسلم (987) بنحوه","bab":"رقائق وزهد › الرياء والسمعة","dorar":"SaBaf4mu"},{"id":"س-01614","fp":"0ffd8ef78b93","stateId":310,"easy":"إذا كففت غضبك ← يستر الله عورتك","cause":"و مَنْ كَفَّ غضبَهُ","result":"سترَ اللهُ عَوْرَتَهُ","explicit":true,"ref":"السلسلة الصحيحة 906","srcLabel":"الطبراني","text":["أحبُّ الناسِ إلى اللهِ أنْفَعُهُمْ لِلنَّاسِ، وأحبُّ الأعمالِ إلى اللهِ عزَّ وجلَّ سُرُورٌ يدْخِلُهُ على مسلمٍ، أوْ يكْشِفُ عنهُ كُرْبَةً، أوْ يقْضِي عنهُ دَيْنًا، أوْ يَطْرُدُ عنهُ جُوعًا، ولأنْ أَمْشِيَ مع أَخٍ لي في حاجَةٍ أحبُّ إِلَيَّ من أنْ أعْتَكِفَ في هذا المسجدِ -يعني: مسجدَ المدينةِ- شهرًا، ",["و مَنْ كَفَّ غضبَهُ",1]," ",["سترَ اللهُ عَوْرَتَهُ",2],"، ومَنْ كَظَمَ غَيْظَهُ و لَوْ شاءَ أنْ يُمْضِيَهُ أَمْضَاهُ مَلأَ اللهُ قلبَهُ رَجَاءً يومَ القيامةِ، ومَنْ مَشَى مع أَخِيهِ في حاجَةٍ حتى تتَهَيَّأَ لهُ أَثْبَتَ اللهُ قَدَمَهُ يومَ تَزُولُ الأَقْدَامِ، [و إِنَّ سُوءَ الخُلُقِ يُفْسِدُ العَمَلَ، كما يُفْسِدُ الخَلُّ العَسَلَ]"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6026)، وأبو الشيخ في ((التوبيخ والتنبيه)) (97) باختلاف يسير.","bab":"أطعمة › إطعام الطعام","dorar":"3mmEYTsk"},{"id":"س-02891","fp":"fc76beb0d434","stateId":310,"easy":"إذا كسوت مسلماً ثوباً ← تبقى في ستر الله ما دام عليه منه خيط","cause":"مَن كَسا مُسْلِمًا ثَوْبًا","result":"لم يَزَلْ في سِتْرِ اللهِ ما دامَ عليهِ منه خَيطٌ أو سِلْكٌ","explicit":true,"otherNeedIds":[30],"ref":"المستدرك على الصحيحين 7627","srcLabel":"الترمذي","text":["عنْ حُصَينٍ قالَ: كُنتُ عندَ ابنِ عبَّاسٍ، فجاءَ سائلٌ فسألَ، فقالَ له ابنُ عبَّاسٍ: أتشْهَدُ أنْ لا إلَهَ إلَّا اللهُ؟ قالَ: نعمْ. قالَ: وتَشهَدُ أنَّ مُحمَّدًا رسولُ اللهِ؟ قالَ: نعَمْ. وتُصَلِّي الخَمْسَ؟ قالَ: نعمْ. قالَ: وتَصومُ رمَضانَ؟ قالَ: نعمْ. قالَ: أمَا إنَّ لكَ علينا حَقًّا يا غُلامُ، اكْسُه ثَوْبًا؛ فإنِّي سَمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن كَسا مُسْلِمًا ثَوْبًا ",1],["لم يَزَلْ في سِتْرِ اللهِ ما دامَ عليهِ منه خَيطٌ أو سِلْكٌ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (2484)، والخرائطي في ((مكارم الأخلاق)) (603)، والطبراني (12591) (12/  97) باختلاف يسير","bab":"إيمان › الوعد","dorar":"8iPjp7iq"}]}