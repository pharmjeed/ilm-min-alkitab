{"schema":1,"kind":"sunan-chunk","version":"sunan-b53213585e2f","needId":11,"stateIds":[48,49,50,51,52,53,54],"items":[{"id":"س-03160","fp":"8a3090055a6a","stateId":48,"easy":"إذا لقيت الله بملء الأرض خطايا لا تشرك به شيئاً ← يلقاك بمثلها مغفرة","cause":"ومَن لَقيَني بقُرابِ الأرضِ خَطيئةً لا يُشرِكُ بي شيئًا","result":"لَقيتُه بمِثلِها مَغفِرةً","explicit":true,"star":true,"similar":["س-04038"],"otherNeedIds":[15],"ref":"صحيح مسلم 2687","srcLabel":"متفق عليه","text":["يقولُ اللهُ عَزَّ وجَلَّ: مَن جاءَ بالحَسَنةِ فله عَشرُ أمثالِها وأزيدُ، ومَن جاءَ بالسَّيِّئةِ فجَزاؤُه سَيِّئةٌ مِثلُها أو أغفِرُ، ومَن تَقَرَّبَ مِنِّي شِبرًا تَقَرَّبتُ منه ذِراعًا، ومَن تَقَرَّبَ مِنِّي ذِراعًا تَقَرَّبتُ منه باعًا، ومَن أتاني يَمشي أتَيتُه هَرولةً، ",["ومَن لَقيَني بقُرابِ الأرضِ خَطيئةً لا يُشرِكُ بي شيئًا",1]," ",["لَقيتُه بمِثلِها مَغفِرةً",2],". وفي روايةٍ: فله عَشرُ أمثالِها، أو أزيدُ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"إيمان › توحيد الأسماء والصفات","dorar":"D1po7pkJ","merged":4,"otherRefs":["تخريج المسند لشعيب 21321 (صحيح)","تخريج المسند لشعيب 21311 (صحيح)","تخريج المسند لشعيب 21315 (صحيح)"]},{"id":"س-05129","fp":"c445366bc0e9","stateId":48,"easy":"إذا أحسنت في الإسلام ← لا تؤاخذ بما عملت في الجاهلية","cause":"مَن أحسَن في الإسلامِ","result":"لمْ يُؤاخَذْ بما عمِل في الجاهليَّةِ","explicit":true,"star":true,"ref":"تخريج مشكل الآثار 506","srcLabel":"متفق عليه","text":["قال النَّاسُ: يا رسولَ اللهِ، ثمَّ ذكَر مِثْلَهُ سَواءً. [يعني حديثَ: قال رجُلٌ: يا رسولَ اللهِ، أيُؤاخَذُ أحَدُنا بما عمِل في الجاهليَّةِ؟ فقال: ",["مَن أحسَن في الإسلامِ",1]," ",["لمْ يُؤاخَذْ بما عمِل في الجاهليَّةِ",2],"، ومَن أساء في الإسلامِ أُخِذَ بالأَوَّلِ والآخِرِ.]"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (6921)، ومسلم (120) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"NJJzACMW","merged":4,"otherRefs":["تخريج المسند لشعيب 4408 (صحيح)","تخريج المسند لشاكر 5/213 (صحيح)","صحيح مسلم 120 (صحيح)"]},{"id":"س-03378","fp":"52b539c14422","stateId":48,"easy":"إذا لم تشرك بالله شيئاً ← يُغفر لك","cause":"لا يُشرِكُ باللهِ شيئًا","result":"فيُغفَرُ","explicit":true,"star":true,"similar":["س-07531","س-06471"],"ref":"صحيح مسلم 2565","srcLabel":"متفق عليه","text":["تُفتَحُ أبوابُ الجَنَّةِ يَومَ الاثنَينِ، ويَومَ الخَميسِ، ",["فيُغفَرُ",2]," لكُلِّ عَبدٍ ",["لا يُشرِكُ باللهِ شيئًا",1],"، إلَّا رَجُلًا كانَت بينَه وبينَ أخيه شَحناءُ، فيُقالُ: أنظِروا هَذَينِ حتَّى يَصطَلِحا، أنظِروا هَذَينِ حتَّى يَصطَلِحا، أنظِروا هَذَينِ حتَّى يَصطَلِحا. [وفي روايةٍ]: إلَّا المُهتَجِرَينِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"استغفار › أسباب المغفرة","dorar":"hbubemo1","merged":2,"otherRefs":["صحيح الترمذي 2023 (صحيح)"]},{"id":"س-06313","fp":"a2c03ec0c5bf","stateId":48,"easy":"إذا حلفت باللات (أو بغير الله) سهواً ← فقل «لا إله إلا الله» كفارة","cause":"فليَقُلْ: لا إلَهَ إلَّا اللهُ","result":"مَن حَلَفَ مِنكُم فقال في حَلِفِه: باللَّاتِ","explicit":true,"star":true,"ref":"صحيح مسلم 1647","srcLabel":"متفق عليه","text":[["مَن حَلَفَ مِنكُم فقال في حَلِفِه: باللَّاتِ",2],"، ",["فليَقُلْ: لا إلَهَ إلَّا اللهُ",1],"، ومَن قال لصاحِبِه: تَعالَ أُقامِرْك، فليَتَصَدَّقْ. [وفي روايةٍ]: فليَتَصَدَّقْ بشيءٍ. وفي حَديثِ الأوزاعيِّ: مَن حَلَفَ باللَّاتِ والعُزَّى."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4860)، ومسلم (1647).","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"Y0whuWoU"},{"id":"س-04038","fp":"173405cfa4a7","stateId":48,"easy":"إذا عملت ملء الأرض خطايا ثم لقيت الله لا تشرك به ← يجعل لك مثلها مغفرة","cause":"ومَنْ عمِلَ قُرابَ الأرضِ خطيئةً ، ثمَّ لَقِيَنِي لا يُشرِكُ بي شيئًا","result":"جعلتُ لهُ مِثلَها مَغفرِةً","explicit":true,"repOf":"س-03160","ref":"صحيح الجامع 8141","text":["يقولُ اللهُ تعالَى : مَنْ عمِلَ حسنةً ، فلهُ عشرُ أمثالِها . وأَزيدُ ، ومَنْ عمِلَ سيِّئةً فجزاؤُها مِثلُها ، أوْ أغفِرُ ، ",["ومَنْ عمِلَ قُرابَ الأرضِ خطيئةً ، ثمَّ لَقِيَنِي لا يُشرِكُ بي شيئًا",1]," ",["جعلتُ لهُ مِثلَها مَغفرِةً",2]," ، ومَنِ اقترَبَ إلىَّ شِبرًا ، اقْتربتُ إليه ذِراعًا ، ومَنِ اقترَبَ إليَّ ذِراعًا ، اقتربتُ إليه باعًا ، ومَنْ أتانِي يمشِي ، أتيتُهُ هرْولَةً"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2687)، وابن ماجه (3821)، وأحمد (21488) واللفظ له","bab":"توبة › سعة رحمة الله تعالى وأنها سبقت غضبه","dorar":"EG5gkzcM","merged":2,"otherRefs":["تخريج المسند لشعيب 21377 (حسن)"]},{"id":"س-01227","fp":"12b7587d99a9","stateId":48,"easy":"إذا قلت «لا إله إلا الله» ← يُغفر لك","cause":"بقولِ : لا إلَهَ إلا اللَّهُ","result":"قد غُفِرَ لَهُ","explicit":true,"star":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"similar":["س-01214","س-02474","س-01233"],"ref":"المهذب في اختصار السنن 8/4009","srcLabel":"مسلم","text":["أنَّ رسولَ اللَّهِ قالَ لرجلٍ : فعلتَ كذا وَكَذا ؟ قالَ : لا واللَّهِ الَّذي لا إلَهَ إلا هوَ فأتاهُ جبريلُ فقالَ : بلى قد فعلَهُ ولَكِن ",["قد غُفِرَ لَهُ",2]," ",["بقولِ : لا إلَهَ إلا اللَّهُ",1]," ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده على شرط مسلم","takhrij":"أخرجه أحمد (5986)، وأبو يعلى (5690)، والبيهقي (20373) باختلاف يسير","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"Jor2Kspo"},{"id":"س-03976","fp":"3623f22cdec7","stateId":48,"easy":"إذا أسلمت ← يهدم الإسلام ما كان قبله","cause":"أما عَلِمْتَ أنَّ الإسْلامَ","result":"يَهْدِمُ ما كانَ قَبْلَهُ","explicit":true,"similar":["س-04040","س-04042"],"ref":"مجموع فتاوى ابن باز 297/6","srcLabel":"مسلم","text":["التوبةُ تجُبُّ ما قبلَها [يعني حديث: حَضَرْنا عَمْرَو بنَ العاصِ، وهو في سِياقَةِ المَوْتِ، يَبَكِي طَوِيلًا، وحَوَّلَ وجْهَهُ إلى الجِدارِ، فَجَعَلَ ابنُهُ يقولُ: يا أبَتاهُ، أما بَشَّرَكَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ بكَذا؟ أما بَشَّرَكَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ بكَذا؟ قالَ: فأقْبَلَ بوَجْهِهِ، فقالَ: إنَّ أفْضَلَ ما نُعِدُّ شَهادَةُ أنْ لا إلَهَ إلَّا اللَّهُ، وأنَّ مُحَمَّدًا رَسولُ اللهِ، إنِّي قدْ كُنْتُ علَى أطْباقٍ ثَلاثٍ، لقَدْ رَأَيْتُنِي وما أحَدٌ أشَدَّ بُغْضًا لِرَسولِ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ مِنِّي، ولا أحَبَّ إلَيَّ أنْ أكُونَ قَدِ اسْتَمْكَنْتُ منه، فَقَتَلْتُهُ، فلوْ مُتُّ علَى تِلكَ الحالِ لَكُنْتُ مِن أهْلِ النَّارِ، فَلَمَّا جَعَلَ اللَّهُ الإسْلامَ في قَلْبِي أتَيْتُ النبيَّ صَلَّى اللَّهُ عليه وسلَّمَ، فَقُلتُ: ابْسُطْ يَمِينَكَ فَلأُبايِعْكَ، فَبَسَطَ يَمِينَهُ، قالَ: فَقَبَضْتُ يَدِي، قالَ: ما لكَ يا عَمْرُو؟ قالَ: قُلتُ: أرَدْتُ أنْ أشْتَرِطَ، قالَ: تَشْتَرِطُ بماذا؟ قُلتُ: أنْ يُغْفَرَ لِي، قالَ: ",["أما عَلِمْتَ أنَّ الإسْلامَ ",1],["يَهْدِمُ ما كانَ قَبْلَهُ",2],"؟ وأنَّ الهِجْرَةَ تَهْدِمُ ما كانَ قَبْلَها؟ وأنَّ الحَجَّ يَهْدِمُ ما كانَ قَبْلَهُ؟ وما كانَ أحَدٌ أحَبَّ إلَيَّ مِن رَسولِ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ، ولا أجَلَّ في عَيْنِي منه، وما كُنْتُ أُطِيقُ أنْ أمْلأَ عَيْنَيَّ منه إجْلالًا له، ولو سُئِلْتُ أنْ أصِفَهُ ما أطَقْتُ؛ لأَنِّي لَمْ أكُنْ أمْلأُ عَيْنَيَّ منه، ولو مُتُّ علَى تِلكَ الحالِ لَرَجَوْتُ أنْ أكُونَ مِن أهْلِ الجَنَّةِ، ثُمَّ ولِينا أشْياءَ ما أدْرِي ما حالِي فيها، فإذا أنا مُتُّ فلا تَصْحَبْنِي نائِحَةٌ، ولا نارٌ، فإذا دَفَنْتُمُونِي فَشُنُّوا عَلَيَّ التُّرابَ شَنًّا، ثُمَّ أقِيمُوا حَوْلَ قَبْرِي قَدْرَ ما تُنْحَرُ جَزُورٌ ويُقْسَمُ لَحْمُها، حتَّى أسْتَأْنِسَ بكُمْ، وأَنْظُرَ ماذا أُراجِعُ به رُسُلَ رَبِّي.]"],"grade":"صحيح","narrator":"[عمرو بن العاص]","muhaddith":"صحيح","takhrij":"أخرجه مسلم (121)، وأحمد (17827)، وابن أبي خيثمة في ((تاريخه-السفر الثاني)) (2642) بنحوه تامًا.","bab":"توبة › الحض على التوبة","dorar":"ytm0uPWI"},{"id":"ق-0069","fp":"66050dd71ef7","stateId":48,"easy":"الانتهاء عن العدوان والكفر ← مغفرة الله ورحمته","cause":"الانتهاء عن العدوان والكفر","result":"مغفرة الله ورحمته","explicit":true,"ref":"سورة البقرة: 192","srcLabel":"القرآن الكريم","quran":{"s":2,"from":192,"to":192,"text":"فَإِنِ انْتَهَوْا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ (192)","hl":[[0,49,1]]}},{"id":"ق-0286","fp":"7b9b9f9c6e32","stateId":48,"easy":"الإيمان والعمل الصالح ← مغفرة وأجر عظيم","cause":"الإيمان والعمل الصالح","result":"مغفرة وأجر عظيم","explicit":true,"similar":["ق-0822","ق-1005","ق-1021"],"otherNeedIds":[40],"ref":"سورة المائدة: 9","srcLabel":"القرآن الكريم","quran":{"s":5,"from":9,"to":9,"text":"وَعَدَ اللَّهُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ مَغْفِرَةٌ وَأَجْرٌ عَظِيمٌ (9)","hl":[[15,92,1]]}},{"id":"ق-0320","fp":"5c7fb0ca2983","stateId":48,"easy":"الإيمان والتقوى ← تكفير السيئات وجنات النعيم","cause":"الإيمان والتقوى","result":"تكفير السيئات وجنات النعيم","explicit":true,"otherNeedIds":[55],"ref":"سورة المائدة: 65","srcLabel":"القرآن الكريم","quran":{"s":5,"from":65,"to":65,"text":"وَلَوْ أَنَّ أَهْلَ الْكِتَابِ آمَنُوا وَاتَّقَوْا لَكَفَّرْنَا عَنْهُمْ سَيِّئَاتِهِمْ وَلَأَدْخَلْنَاهُمْ جَنَّاتِ النَّعِيمِ (65)","hl":[[0,127,1]]}},{"id":"ق-0463","fp":"7513ea64975c","stateId":48,"easy":"الانتهاء عن الكفر ← مغفرة ما قد سلف","cause":"الانتهاء عن الكفر","result":"مغفرة ما قد سلف","explicit":true,"ref":"سورة الأنفال: 38","srcLabel":"القرآن الكريم","quran":{"s":8,"from":38,"to":38,"text":"قُلْ لِلَّذِينَ كَفَرُوا إِنْ يَنْتَهُوا يُغْفَرْ لَهُمْ مَا قَدْ سَلَفَ وَإِنْ يَعُودُوا فَقَدْ مَضَتْ سُنَّتُ الْأَوَّلِينَ (38)","hl":[[25,73,1]]}},{"id":"ق-0639","fp":"5e2889387ca3","stateId":48,"easy":"إجابة دعوة الله إلى الإيمان ← مغفرة الذنوب والتأخير إلى أجل مسمى","cause":"إجابة دعوة الله إلى الإيمان","result":"مغفرة الذنوب والتأخير إلى أجل مسمى","explicit":true,"similar":["ق-1201"],"otherNeedIds":[34],"ref":"سورة إبراهيم: 10","srcLabel":"القرآن الكريم","quran":{"s":14,"from":10,"to":10,"text":"قَالَتْ رُسُلُهُمْ أَفِي اللَّهِ شَكٌّ فَاطِرِ السَّمَاوَاتِ وَالْأَرْضِ يَدْعُوكُمْ لِيَغْفِرَ لَكُمْ مِنْ ذُنُوبِكُمْ وَيُؤَخِّرَكُمْ إِلَى أَجَلٍ مُسَمًّى قَالُوا إِنْ أَنْتُمْ إِلَّا بَشَرٌ مِثْلُنَا تُرِيدُونَ أَنْ تَصُدُّونَا عَمَّا كَانَ يَعْبُدُ آبَاؤُنَا فَأْتُونَا بِسُلْطَانٍ مُبِينٍ (10)","hl":[[73,157,1]]}},{"id":"ق-0768","fp":"a3375f148728","stateId":48,"easy":"الإيمان ← مغفرة الخطايا","cause":"الإيمان","result":"مغفرة الخطايا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة طه: 73","srcLabel":"القرآن الكريم","quran":{"s":20,"from":73,"to":73,"text":"إِنَّا آمَنَّا بِرَبِّنَا لِيَغْفِرَ لَنَا خَطَايَانَا وَمَا أَكْرَهْتَنَا عَلَيْهِ مِنَ السِّحْرِ وَاللَّهُ خَيْرٌ وَأَبْقَى (73)","hl":[[0,54,1]]}},{"id":"ق-0822","fp":"88c7186a6ced","stateId":48,"easy":"الإيمان والعمل الصالح ← مغفرة ورزق كريم","cause":"الإيمان والعمل الصالح","result":"مغفرة ورزق كريم","explicit":true,"repOf":"ق-0286","otherNeedIds":[1],"ref":"سورة الحج: 50","quran":{"s":22,"from":50,"to":50,"text":"فَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ مَغْفِرَةٌ وَرِزْقٌ كَرِيمٌ (50)","hl":[[0,79,1]]}},{"id":"ق-0935","fp":"59dc89f9237e","stateId":48,"easy":"الإيمان والعمل الصالح ← تكفير السيئات والجزاء بأحسن العمل","cause":"الإيمان والعمل الصالح","result":"تكفير السيئات والجزاء بأحسن العمل","explicit":true,"similar":["ق-1342"],"otherNeedIds":[40],"ref":"سورة العنكبوت: 7","srcLabel":"القرآن الكريم","quran":{"s":29,"from":7,"to":7,"text":"وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَنُكَفِّرَنَّ عَنْهُمْ سَيِّئَاتِهِمْ وَلَنَجْزِيَنَّهُمْ أَحْسَنَ الَّذِي كَانُوا يَعْمَلُونَ (7)","hl":[[0,140,1]]}},{"id":"ق-0993","fp":"7cf72676973e","stateId":48,"easy":"الإسلام والإيمان والقنوت والصدق والصبر والخشوع والتصدق والصوم وحفظ الفرج وذكر الله كثيراً ← مغفرة وأجر عظيم","cause":"الإسلام والإيمان والقنوت والصدق والصبر والخشوع والتصدق والصوم وحفظ الفرج وذكر الله كثيراً","result":"مغفرة وأجر عظيم","explicit":true,"otherNeedIds":[40],"ref":"سورة الأحزاب: 35","srcLabel":"القرآن الكريم","quran":{"s":33,"from":35,"to":35,"text":"إِنَّ الْمُسْلِمِينَ وَالْمُسْلِمَاتِ وَالْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ وَالْقَانِتِينَ وَالْقَانِتَاتِ وَالصَّادِقِينَ وَالصَّادِقَاتِ وَالصَّابِرِينَ وَالصَّابِرَاتِ وَالْخَاشِعِينَ وَالْخَاشِعَاتِ وَالْمُتَصَدِّقِينَ وَالْمُتَصَدِّقَاتِ وَالصَّائِمِينَ وَالصَّائِمَاتِ وَالْحَافِظِينَ فُرُوجَهُمْ وَالْحَافِظَاتِ وَالذَّاكِرِينَ اللَّهَ كَثِيرًا وَالذَّاكِرَاتِ أَعَدَّ اللَّهُ لَهُمْ مَغْفِرَةً وَأَجْرًا عَظِيمًا (35)","hl":[[0,417,1]]}},{"id":"ق-1005","fp":"f41c7f9a1cee","stateId":48,"easy":"الإيمان والعمل الصالح ← مغفرة ورزق كريم","cause":"الإيمان والعمل الصالح","result":"مغفرة ورزق كريم","explicit":true,"repOf":"ق-0286","otherNeedIds":[1],"ref":"سورة سبأ: 4","quran":{"s":34,"from":4,"to":4,"text":"لِيَجْزِيَ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ أُولَئِكَ لَهُمْ مَغْفِرَةٌ وَرِزْقٌ كَرِيمٌ (4)","hl":[[11,98,1]]}},{"id":"ق-1021","fp":"c648021081aa","stateId":48,"easy":"الإيمان والعمل الصالح ← مغفرة وأجر كبير","cause":"الإيمان والعمل الصالح","result":"مغفرة وأجر كبير","explicit":true,"repOf":"ق-0286","otherNeedIds":[40],"ref":"سورة فاطر: 7","quran":{"s":35,"from":7,"to":7,"text":"الَّذِينَ كَفَرُوا لَهُمْ عَذَابٌ شَدِيدٌ وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ مَغْفِرَةٌ وَأَجْرٌ كَبِيرٌ (7)","hl":[[42,121,1]]}},{"id":"ق-1087","fp":"b4569a1e8716","stateId":48,"easy":"المجيء بالصدق والتصديق به (التقوى والإحسان) ← لهم ما يشاءون وتكفير أسوأ العمل والجزاء بأحسنه","cause":"المجيء بالصدق والتصديق به (التقوى والإحسان)","result":"لهم ما يشاءون وتكفير أسوأ العمل والجزاء بأحسنه","explicit":true,"otherNeedIds":[40,55],"ref":"سورة الزمر: 33–35","srcLabel":"القرآن الكريم","quran":{"s":39,"from":33,"to":35,"text":"وَالَّذِي جَاءَ بِالصِّدْقِ وَصَدَّقَ بِهِ أُولَئِكَ هُمُ الْمُتَّقُونَ (33) لَهُمْ مَا يَشَاءُونَ عِنْدَ رَبِّهِمْ ذَلِكَ جَزَاءُ الْمُحْسِنِينَ (34) لِيُكَفِّرَ اللَّهُ عَنْهُمْ أَسْوَأَ الَّذِي عَمِلُوا وَيَجْزِيَهُمْ أَجْرَهُمْ بِأَحْسَنِ الَّذِي كَانُوا يَعْمَلُونَ (35)","hl":[[0,270,1]]}},{"id":"ق-1201","fp":"74eb6755d536","stateId":48,"easy":"إجابة داعي الله والإيمان به ← مغفرة الذنوب والإجارة من عذاب أليم","cause":"إجابة داعي الله والإيمان به","result":"مغفرة الذنوب والإجارة من عذاب أليم","explicit":true,"repOf":"ق-0639","otherNeedIds":[54],"ref":"سورة الأحقاف: 31","quran":{"s":46,"from":31,"to":31,"text":"يَا قَوْمَنَا أَجِيبُوا دَاعِيَ اللَّهِ وَآمِنُوا بِهِ يَغْفِرْ لَكُمْ مِنْ ذُنُوبِكُمْ وَيُجِرْكُمْ مِنْ عَذَابٍ أَلِيمٍ (31)","hl":[[0,121,1]]}},{"id":"ق-1205","fp":"5ee63b82f9cc","stateId":48,"easy":"الإيمان والعمل الصالح والإيمان بما نزل على محمد ﷺ ← تكفير السيئات وإصلاح البال","cause":"الإيمان والعمل الصالح والإيمان بما نزل على محمد ﷺ","result":"تكفير السيئات وإصلاح البال","explicit":true,"otherNeedIds":[17,5],"ref":"سورة محمد: 2","srcLabel":"القرآن الكريم","quran":{"s":47,"from":2,"to":2,"text":"وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَآمَنُوا بِمَا نُزِّلَ عَلَى مُحَمَّدٍ وَهُوَ الْحَقُّ مِنْ رَبِّهِمْ كَفَّرَ عَنْهُمْ سَيِّئَاتِهِمْ وَأَصْلَحَ بَالَهُمْ (2)","hl":[[0,168,1]]}},{"id":"ق-1242","fp":"1929bae5bc90","stateId":48,"easy":"الإيمان والعمل الصالح مع الشدة على الكفار والرحمة بالمؤمنين والركوع والسجود ابتغاء فضل الله ← مغفرة وأجر عظيم","cause":"الإيمان والعمل الصالح مع الشدة على الكفار والرحمة بالمؤمنين والركوع والسجود ابتغاء فضل الله","result":"مغفرة وأجر عظيم","explicit":true,"apply":{"k":"time","t":"في السجود"},"otherNeedIds":[40],"ref":"سورة الفتح: 29","srcLabel":"القرآن الكريم","quran":{"s":48,"from":29,"to":29,"text":"مُحَمَّدٌ رَسُولُ اللَّهِ وَالَّذِينَ مَعَهُ أَشِدَّاءُ عَلَى الْكُفَّارِ رُحَمَاءُ بَيْنَهُمْ تَرَاهُمْ رُكَّعًا سُجَّدًا يَبْتَغُونَ فَضْلًا مِنَ اللَّهِ وَرِضْوَانًا سِيمَاهُمْ فِي وُجُوهِهِمْ مِنْ أَثَرِ السُّجُودِ ذَلِكَ مَثَلُهُمْ فِي التَّوْرَاةِ وَمَثَلُهُمْ فِي الْإِنْجِيلِ كَزَرْعٍ أَخْرَجَ شَطْأَهُ فَآزَرَهُ فَاسْتَغْلَظَ فَاسْتَوَى عَلَى سُوقِهِ يُعْجِبُ الزُّرَّاعَ لِيَغِيظَ بِهِمُ الْكُفَّارَ وَعَدَ اللَّهُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ مِنْهُمْ مَغْفِرَةً وَأَجْرًا عَظِيمًا (29)","hl":[[0,506,1]]}},{"id":"ق-1304","fp":"599adcebbfcd","stateId":48,"easy":"الإيمان بالله ورسله والمسابقة إلى المغفرة ← مغفرة وجنة عرضها كعرض السماء والأرض","cause":"الإيمان بالله ورسله والمسابقة إلى المغفرة","result":"مغفرة وجنة عرضها كعرض السماء والأرض","explicit":true,"otherNeedIds":[55],"ref":"سورة الحديد: 21","srcLabel":"القرآن الكريم","quran":{"s":57,"from":21,"to":21,"text":"سَابِقُوا إِلَى مَغْفِرَةٍ مِنْ رَبِّكُمْ وَجَنَّةٍ عَرْضُهَا كَعَرْضِ السَّمَاءِ وَالْأَرْضِ أُعِدَّتْ لِلَّذِينَ آمَنُوا بِاللَّهِ وَرُسُلِهِ ذَلِكَ فَضْلُ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ (21)","hl":[[0,143,1]]}},{"id":"ق-1342","fp":"63cb9d5cf676","stateId":48,"easy":"الإيمان بالله والعمل الصالح ← تكفير السيئات وجنات والفوز العظيم","cause":"الإيمان بالله والعمل الصالح","result":"تكفير السيئات وجنات والفوز العظيم","explicit":true,"repOf":"ق-0935","otherNeedIds":[55,46],"ref":"سورة التغابن: 9","quran":{"s":64,"from":9,"to":9,"text":"يَوْمَ يَجْمَعُكُمْ لِيَوْمِ الْجَمْعِ ذَلِكَ يَوْمُ التَّغَابُنِ وَمَنْ يُؤْمِنْ بِاللَّهِ وَيَعْمَلْ صَالِحًا يُكَفِّرْ عَنْهُ سَيِّئَاتِهِ وَيُدْخِلْهُ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا أَبَدًا ذَلِكَ الْفَوْزُ الْعَظِيمُ (9)","hl":[[66,253,1]]}},{"id":"س-03169","fp":"2d225d6320f3","stateId":48,"easy":"إذا حلفت كاذباً ثم شهدت بالتوحيد صادقاً ← يغفر الله لك (من واقعة)","cause":"باللهِ الَّذي لا إلهَ إلَّا هو","result":"فغُفِرَ له","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأحاديث المختارة 9 / 320","srcLabel":"متفق عليه","text":["«أنَّ رَجُلًا حَلَفَ ",["باللهِ الَّذي لا إلهَ إلَّا هو",1]," كاذِبًا، ",["فغُفِرَ له",2],"»."],"grade":"صحيح","narrator":"‌‌عبدالله بن الزبير بن العوام","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إيمان › توحيد الأسماء والصفات","dorar":"DZ2SYsDX"},{"id":"س-03460","fp":"5a6c5420f3e6","stateId":48,"easy":"إذا لقيت الله لا تشرك به شيئاً ← يأتيك بملء الأرض مغفرة","cause":"لا تُشْرِكُ بي شيئًا","result":"لَأَتَيْتُكَ بقُرَابِها مَغْفِرَةً","explicit":true,"otherNeedIds":[15],"ref":"هداية الرواة 2276","srcLabel":"الترمذي","text":["قال اللهُ – تعالى – يا ابنَ آدمَ ! إنك ما دَعَوْتَنِي ورَجَوْتَنِي ؛ غفرتُ لك ما كان فيك ولا أُبَالِي، يا ابنَ آدمَ ! لو بَلَغَتْ ذنوبُكَ عَنَانَ السماءِ، ثم استَغْفَرْتَنِي ؛ غفرتُ لك ولا أُبَالِي، يا ابنَ آدمَ ! إنك لو أَتَيْتَنِي بقُرَابِ الأرضِ خَطَايَا، ثم لَقِيتَنِي ",["لا تُشْرِكُ بي شيئًا",1]," ؛ ",["لَأَتَيْتُكَ بقُرَابِها مَغْفِرَةً",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"حسن بل صحيح","takhrij":"أخرجه الترمذي (3540) واللفظ له، وأحمد (13493) مختصراً بمعناه.","bab":"استغفار › فضل الاستغفار","dorar":"b0r8OsTX","merged":3,"otherRefs":["تخريج صحيح ابن حبان 226 (صحيح)","تخريج المسند لشعيب 21472 (حسن)"]},{"id":"س-04040","fp":"c49639d42145","stateId":48,"easy":"إذا أسلمت ← يمحو الإسلام ما قبله","cause":"الإسلامُ","result":"يجبُّ ما قَبلَهُ","explicit":true,"repOf":"س-03976","ref":"إرواء الغليل 1280","text":[["الإسلامُ ",1],["يجبُّ ما قَبلَهُ ",2],"[يعني حديث: لمَّا أَلْقى اللهُ عزَّ وجلَّ في قَلْبي الإسلامَ، قال: أتَيْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ ليُبايعَني، فبسَطَ يَدَه إليَّ، فقُلْتُ: لا أُبايعُكَ يا رسولَ اللهِ حتى تَغفِرَ لي ما تقَدَّمَ من ذَنْبي، قال: فقال لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا عَمرُو، أمَا علِمْتَ أنَّ الهِجرةَ تَجُبُّ ما قَبلَها منَ الذنوبِ، يا عَمرُو، أمَا علِمْتَ أنَّ الإسلامَ يَجُبُّ ما كان قَبلَه منَ الذنوبِ.]"],"grade":"صحيح","narrator":"عمرو بن العاص","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17812)، والطحاوي في ((شرح مشكل الآثار)) (507) باختلاف يسير، وأبو نعيم في ((معرفة الصحابة)) (4993) واللفظ له.","bab":"توبة › سقوط الذنوب بالاستغفار والتوبة","dorar":"kHG0XXKn","merged":3,"otherRefs":["صحيح الجامع 2777 (صحيح)","تخريج المسند لشعيب 17813 (حسن)"]},{"id":"س-05986","fp":"6ad00c3b92b3","stateId":48,"easy":"إذا اتقيت الشرك بالله ← فالله أهل أن يغفر لك","cause":"فمن اتَّقَى أنْ يَجْعَلَ معي إلهًا","result":"فأنا أهلٌ أنْ أغفرَ لهُ","explicit":true,"similar":["س-02893"],"ref":"الجامع الصغير 6051","srcLabel":"الترمذي","text":["قالَ ربُّكم : أنا أهلٌ أنْ أُتَّقَى فَلا يُجْعَلُ معي إلهٌ، ",["فمن اتَّقَى أنْ يَجْعَلَ معي إلهًا",1]," ",["فأنا أهلٌ أنْ أغفرَ لهُ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه أحمد (12442) بلفظه، والترمذي (3328)، وابن ماجه (4299) بنحوه.","bab":"رقائق وزهد › تقوى الله","dorar":"8xwZ6toj","merged":3,"otherRefs":["هداية الرواة 2/453 (حسن)","سير أعلام النبلاء 5/223 (حسن)"]},{"id":"س-02409","fp":"b4a1c8668a49","stateId":48,"easy":"إذا مِتّ وأنت تشهد أن لا إله إلا الله وأن محمداً رسول الله صادقاً من قلبك ← يغفر الله لك","cause":"ما مِن نَفْسٍ تَموتُ وهي تَشهَدُ أنْ لا إلهَ إلَّا اللهُ، وأنِّي رسولُ اللهِ، يَرجِعُ ذاك إلى قَلبٍ مُوقنٍ","result":"إلَّا غَفَرَ اللهُ لها","explicit":true,"ref":"تخريج المسند لشعيب 21998","srcLabel":"النسائي","text":["دَخَلتُ المسجدَ الجامعَ بالبَصرةِ، فجَلَستُ إلى شَيخٍ أبيَضِ الرَّأسِ واللِّحْيةِ، فقال: حَدَّثَني مُعاذُ بنُ جَبلٍ، عن رسولِ اللهِ صَلَّى اللهُ عليه وسلَّمَ أنَّه قال: ",["ما مِن نَفْسٍ تَموتُ وهي تَشهَدُ أنْ لا إلهَ إلَّا اللهُ، وأنِّي رسولُ اللهِ، يَرجِعُ ذاك إلى قَلبٍ مُوقنٍ، ",1],["إلَّا غَفَرَ اللهُ لها",2],"، قُلتُ له: أنت سَمِعتَه مِن مُعاذٍ؟ فكأنَّ القَومَ عَنَّفوني، قال: لا تُعنِّفوه، ولا تُؤَنِّبوه، دَعوه، نعمْ أنا سَمِعتُ ذاك مِن مُعاذٍ، يَذبُرُه عن رسولِ اللهِ صَلَّى اللهُ عليه وسلَّمَ، وقال إسماعيلُ مَرَّةً: يَأثُرُه عن رسولِ اللهِ صَلَّى اللهُ عليه وسلَّمَ، قال: قُلتُ لبعضِهم: مَن هذا؟ قال: هذا عبدُ الرَّحمنِ بنُ سَمُرةَ."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10975)، وابن ماجه (3796)، وأحمد (21998) واللفظ له","bab":"إسلام › فضل الشهادتين","dorar":"9Ip2s76Z","merged":2,"otherRefs":["المستدرك على الصحيحين 16 (صحيح)"]},{"id":"س-07531","fp":"35c13fde41c4","stateId":48,"easy":"إذا لم تشرك بالله ← يُغفر لك المقحمات","cause":"ما لم يشرِكوا باللَّهِ شيئًا","result":"وغُفِرَ لأمَّتِهِ المقحِماتُ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"repOf":"س-03378","otherNeedIds":[20],"ref":"صحيح الترمذي 3276","text":["لمَّا بلغَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ سدرةَ المنتهى قالَ انتهى إليها ما يعرجُ منَ الأرضِ وما ينزلُ من فوقٍ فأعطاهُ اللَّهُ عندَها ثلاثًا لم يعطِهنَّ نبيًّا كانَ قبلَهُ فُرِضت عليهِ الصَّلاةُ خمسًا وأعطيَ خواتيمَ سورةِ البقرةِ ",["وغُفِرَ لأمَّتِهِ المقحِماتُ",2]," ",["ما لم يشرِكوا باللَّهِ شيئًا",1]," قالَ ابنُ مسعودٍ { إِذْ يَغْشَى السِّدْرَةَ مَا يَغْشَى} قالَ السِّدرةُ في السَّماءِ السَّادسة قالَ سفيانُ فراشٌ من ذهبٍ وأشارَ سفيانُ بيدِهِ فأرعدَها وقالَ غيرُ مالكِ بنِ مغولٍ إليها ينتهي علمُ الخلقِ لا عِلمَ لهم بما فوقَ ذلك"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3276) واللفظ له، وأخرجه مسلم (173) بلفظ مقارب","bab":"فضائل النبي وصفته ودلائل النبوة › الإسراء والمعراج","dorar":"3M6Tuty7"},{"id":"س-00888","fp":"9b86b7aa10b6","stateId":48,"easy":"إذا صدّقت بلا إله إلا الله ← تُكفَّر ذنوبك","cause":"بتصديقِك بلا إلهَ إلَّا اللهُ","result":"كُفِّرَ عنك","explicit":true,"ref":"مجمع الزوائد 10/86","srcLabel":"عبد بن حميد","text":["يا فلانُ فعَلْتَ كذا وكذا قال لا والَّذي لا إلهَ إلَّا هو ما فعَلْتُ ورسولُ اللهِ صلَّى اللهُ عليه وسلَّم يعلَمُ أنَّه قد فعَله فكرَّر عليه مِرارًا فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["كُفِّرَ عنك",2]," ",["بتصديقِك بلا إلهَ إلَّا اللهُ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه عبد بن حميد في ((المسند)) (1374)، والبزار (6903)، وأبو يعلى (3368) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"paWB0S7a"},{"id":"س-01084","fp":"4fe0d9b4df63","stateId":48,"easy":"إذا قلت «لا إله إلا الله» ← لا تترك ذنباً","cause":"وقولُ لا إلَهَ إلَّا اللهُ","result":"لا يَترُكُ ذنبًا، ولا يُشبِهُها عَملٌ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"ref":"المستدرك على الصحيحين 1917","srcLabel":"الحاكم","text":["يا نَبيَّ اللهِ، إنِّي امرأةٌ قد كَبِرتُ وضَعُفتُ، فدُلَّني على عَمَلٍ، قالَ: كَبِّري اللهَ مائةَ مرَّةٍ، واحمَدِي اللهَ مائةَ مرَّةٍ، وسبِّحي اللهَ مائةَ مرَّةٍ؛ فهو خيرٌ لكِ مِن مائةِ بَدَنةٍ مُتقبَّلةٍ، وخيرٌ مِن مائةِ فرَسٍ مُسْرَجٍ مُلْجَمٍ في سبيلِ اللهِ، وخيرٌ مِن مائةِ رَقَبةٍ مُتقبَّلةٍ، ",["وقولُ لا إلَهَ إلَّا اللهُ",1]," ",["لا يَترُكُ ذنبًا، ولا يُشبِهُها عَملٌ",2],"."],"grade":"صحيح","narrator":"أم هانئ بنت أبي طالب","muhaddith":"صحيح الإسناد","bab":"أدعية وأذكار › فضل الذكر","dorar":"HoHh5PmN"},{"id":"س-01214","fp":"68e551b7e820","stateId":48,"easy":"إذا قلت «لا إله إلا الله» مخلصاً ← يُغفر لك","cause":"بإخلاصِ قولِ لا إلهَ إلا اللهُ","result":"قد غُفر لك","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-01227","ref":"صحيح أبي داود 3275","text":["أنَّ رجلين اختصما إلى النبيِّ صلَّى اللهُ عليهِ وسلَّمَ فسأل النبيُّ صلَّى اللهُ عليهِ وسلَّمَ الطالبَ البينةَ فلم تكن له بينةٌ فاستحلف المطلوبَ فحلف باللهِ الذي لا إلهَ إلا هو فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ بلى قد فعلتَ ولكن ",["قد غُفر لك",2]," ",["بإخلاصِ قولِ لا إلهَ إلا اللهُ",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3275) واللفظ له، وأحمد (2695) باختلاف يسير","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"dRJT5AGr"},{"id":"س-01230","fp":"b6eada388f37","stateId":48,"easy":"إذا حلفت بغير الله فقل «لا إله إلا الله» واتفل عن شمالك وتعوّذ ← يُكفّر ذلك","cause":"قُلْ: لا إلهَ إلَّا اللهُ وَحدَهُ، ثَلاثًا، واتفُلْ عن شِمالِكَ ثَلاثًا، وتعَوَّذْ باللهِ مِنَ الشَّيطانِ، ولا تَعُدْ","result":"وإنِّي حَلَفتُ باللَّاتِ والعُزَّى","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«لا إله إلا الله»"},"similar":["س-02595"],"ref":"تخريج المسند لشاكر 3/103","srcLabel":"النسائي","text":["عن سَعدِ بنِ أبي وَقَّاصٍ أنَّه حَلَفَ باللَّاتِ والعُزَّى، فقال له أصحابُهُ: قد قُلتَ هُجْرًا. فأتى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ فقال: إنَّ العَهدَ كان حَديثًا، ",["وإنِّي حَلَفتُ باللَّاتِ والعُزَّى",2],". فقال له النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",["قُلْ: لا إلهَ إلَّا اللهُ وَحدَهُ، ثَلاثًا، واتفُلْ عن شِمالِكَ ثَلاثًا، وتعَوَّذْ باللهِ مِنَ الشَّيطانِ، ولا تَعُدْ",1],"."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (1622)، والنسائي (3777) بلفظه، وابن حبان (4365) باختلاف يسير.","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"3ePmZCEF","merged":6,"otherRefs":["تخريج سنن أبي داود 5/151 (صحيح)","الأحاديث المختارة 1060 (صحيح)","الصحيح المسند 369 (صحيح)","البحر الزخار 3/341 (صحيح)","تخريج مشكل الآثار 832 (صحيح)"]},{"id":"س-01231","fp":"40eb2c882dc8","stateId":48,"easy":"إذا أخلصت ← يغفر الله لك","cause":"بإخلاصِكَ","result":"إن اللهَ قد غفر لك","explicit":true,"ref":"البحر الزخار 6/135","srcLabel":"النسائي","text":["أنَّ رجلينِ تَدَاعَيَا عند رسولِ اللهِ صلَّى اللهُ عليه وسلَّم ، فحلف المُدَّعِى عليه باللهِ الذي لا إله إلا هو ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ",["إن اللهَ قد غفر لك",2]," ",["بإخلاصِكَ",1]],"grade":"صحيح","narrator":"عبدالله بن الزبير","muhaddith":"صحيح","takhrij":"أخرجه البيهقي (19905) بنحوه، وأحمد (16101 ) والنسائي في ((الكبرى)) (5962 ) بمعناه","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"xGPciUgW"},{"id":"س-01831","fp":"b6eef7f45cbc","stateId":48,"easy":"إذا مِتّ لا تشرك بالله شيئاً ← لا تضرك معه خطيئة (برحمة الله)","cause":"مَن ماتَ لا يُشرِكُ باللهِ شَيئًا","result":"لم يَضُرَّه معَها خَطيئةٌ","explicit":true,"similar":["س-03776"],"otherNeedIds":[54],"ref":"الأحكام الوسطى 1/ 78","srcLabel":"الأحكام الوسطى","text":["\"",["مَن ماتَ لا يُشرِكُ باللهِ شَيئًا",1],"...\"، ثُمَّ ذَكَرَ مِثلَه [",["لم يَضُرَّه معَها خَطيئةٌ",2],"، كما لو أَشرَكَ باللهِ لم تَنفَعْه معَها حَسَنة]."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","bab":"إحسان › إبطال الأعمال","dorar":"TPZs6ZRn"},{"id":"س-02474","fp":"ded374668a4e","stateId":48,"easy":"إذا صدّقت بلا إله إلا الله ← يُغفر لك كذبك","cause":"بتَصديقِه أنْ لا إلهَ إلَّا اللهُ","result":"غُفِرَ له كَذِبُه","explicit":true,"repOf":"س-01227","ref":"علل ابن أبي حاتم 1323","text":["حَديثٌ رواه أبو قُدامةَ الحارِثُ بنُ عُبَيدٍ، عن ثابِتٍ، عن أنَسٍ: أنَّ رَجُلًا حَلَف بـ «لا إلهَ إلَّا اللهُ» كاذِبًا، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["غُفِرَ له كَذِبُه",2]," ",["بتَصديقِه أنْ لا إلهَ إلَّا اللهُ",1],"؟"],"grade":"صحيح","narrator":"أنس","muhaddith":"حَمَّادُ بنُ سَلَمةَ يخالِفُه؛ يَقولُ: عن ثابتٍ، عن ابْنِ عُمَرَ، عن النَّبيِّ صلَّى اللهُ عليه وسلَّم؛ وهو أشبَهُ مِن حَديثِ أبي قُدامةَ.","bab":"إسلام › فضل الشهادتين","dorar":"atDHhXZM"},{"id":"س-02893","fp":"656394396ef6","stateId":48,"easy":"إذا اتقيت الشرك بالله ← فأنت أهل أن يغفر الله لك","cause":"لمَنِ اتَّقى أنْ يَجعلَ معي إلهًا آخرَ","result":"أنْ أغفِرَ له","explicit":true,"repOf":"س-05986","ref":"المستدرك على الصحيحين 3923","text":["سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قَرَأَ: {وَمَا يَذْكُرُونَ إِلَّا أَنْ يَشَاءَ اللَّهُ هُوَ أَهْلُ التَّقْوَى وَأَهْلُ الْمَغْفِرَةِ} [المدثر: 56] قالَ: «يقولُ ربُّكُم عزَّ وجلَّ: أنا أهلٌ أنْ أُتَّقى أنْ يُجعَلَ معي إلهٌ آخرُ، وأنا أهلٌ ",["لمَنِ اتَّقى أنْ يَجعلَ معي إلهًا آخرَ",1]," ",["أنْ أغفِرَ له",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (3328)، وابن ماجه (4299)، وأحمد (13349) بنحوه","bab":"إيمان › الوعد","dorar":"aYBP9b0V"},{"id":"س-03776","fp":"3b22537eb9d9","stateId":48,"easy":"إذا لقيت الله لا تشرك به شيئاً ← لا تضرّك معه خطيئة","cause":"من لقى اللَّهَ لا يشرِكُ بِهِ شيئًا","result":"لم تضُرَّهُ معَهُ خطيئةٌ","explicit":true,"repOf":"س-01831","ref":"تخريج المسند لشاكر 10/92","text":["من لقيَ اللَّهَ وَهوَ لا يشرِكُ بِهِ شيئًا دخلَ الجنَّةَ ، ولم تَضرَّ معَهُ خطيئةٌ ، كما لو لقيَهُ وَهوَ مشرِكٌ بِهِ دخلَ النَّارَ ، ولم تنفَعهُ معَهُ حسنةٌ قالَ أبو نُعَيْمٍ في حديثِهِ : جاءَ رجلٌ أو شيخٌ من أَهْلِ المدينةِ ، فنزلَ على مَسروقٍ فقالَ : سَمِعْتُ عبدَ اللَّهِ بنَ عمرٍو يقولُ : قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : ",["من لقى اللَّهَ لا يشرِكُ بِهِ شيئًا ",1],["لم تضُرَّهُ معَهُ خطيئةٌ ، ",2],"ومن ماتَ وَهوَ يشرِكُ بِهِ لم ينفعهُ معَهُ حسنةٌ قالَ عبدُ اللَّهِ بنُ أحمدَ بنِ حنبلٍ : والصَّوابُ ما قالَهُ أبو نُعَيْمٍ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6586) واللفظ له، والطبري في ((مسند ابن عباس)) (941)، والطبراني كما في ((مجمع الزوائد)) للهيثمي (1/24) مختصراً","bab":"الكفر والشرك › ذم الشرك وما ورد فيه من العقوبة","dorar":"EcBBHSSW"},{"id":"س-04042","fp":"dd28b643ff03","stateId":48,"easy":"إذا أسلمت ← يمحو الإسلام ما قبله من الذنوب","cause":"أمَا علِمْتَ أنَّ الإسلامَ","result":"يَجُبُّ ما كان قَبلَه منَ الذنوبِ","explicit":true,"repOf":"س-03976","ref":"إرواء الغليل 1280","text":["الإسلامُ يجبُّ ما قَبلَهُ [يعني حديث: لمَّا أَلْقى اللهُ عزَّ وجلَّ في قَلْبي الإسلامَ، قال: أتَيْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ ليُبايعَني، فبسَطَ يَدَه إليَّ، فقُلْتُ: لا أُبايعُكَ يا رسولَ اللهِ حتى تَغفِرَ لي ما تقَدَّمَ من ذَنْبي، قال: فقال لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا عَمرُو، أمَا علِمْتَ أنَّ الهِجرةَ تَجُبُّ ما قَبلَها منَ الذنوبِ، يا عَمرُو، ",["أمَا علِمْتَ أنَّ الإسلامَ ",1],["يَجُبُّ ما كان قَبلَه منَ الذنوبِ",2],".]"],"grade":"صحيح","narrator":"عمرو بن العاص","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17812)، والطحاوي في ((شرح مشكل الآثار)) (507) باختلاف يسير، وأبو نعيم في ((معرفة الصحابة)) (4993) واللفظ له.","bab":"توبة › سقوط الذنوب بالاستغفار والتوبة","dorar":"kHG0XXKn"},{"id":"س-06231","fp":"8eb2de59fc5a","stateId":48,"easy":"إذا عملت سيئة فأتبعها حسنة ← فلا إله إلا الله من الحسنات (تمحوها)","cause":"وإذا عمِلتَ سيِّئةً فأتبِعْها حسنةً","result":"لا إلهَ إلَّا اللهُ من الحسناتِ","explicit":true,"ref":"التمهيد 24/300","srcLabel":"ابن عبدالبر","text":["بعث النَّبيُّ صلَّى اللهُ عليه وسلَّم معاذَ بنَ جبلٍ إلى اليمنِ فقال : يا معاذُ اتَّقِ اللهَ وخالِقِ النَّاسَ بخُلقٍ حسنٍ ",["وإذا عمِلتَ سيِّئةً فأتبِعْها حسنةً",1]," قال : قلتُ يا رسولَ اللهِ ",["لا إلهَ إلَّا اللهُ من الحسناتِ ؟",2]," قال : هي من أكبرِ الحسناتِ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"ثابت","takhrij":"أخرجه ابن عبدالبر في ((التمهيد)) (6/55) باختلاف يسير.","bab":"سرايا › تأمير الأمراء على البعوث والسرايا ووصيتهم","dorar":"d69sDtPg"},{"id":"س-06618","fp":"40b5ce845538","stateId":48,"easy":"إذا لقيت الله لا تشرك به وتصلي الخمس وتصوم رمضان ← يُغفر لك","cause":"مَن لَقي اللهَ لا يُشرِكُ به شيئًا ، يُصلِّي الصلواتِ الخمسَ ، ويصومُ رمضانَ","result":"غُفِر له","explicit":true,"apply":{"k":"time","t":"في رمضان"},"ref":"السلسلة الصحيحة 1315","srcLabel":"أحمد","text":[["مَن لَقي اللهَ لا يُشرِكُ به شيئًا ، يُصلِّي الصلواتِ الخمسَ ، ويصومُ رمضانَ ",1],["غُفِر له",2]," قلتُ : أفلا أُبَشِّرُهم يا رسولَ اللهِ ؟ قال : دَعْهم يَعمَلوا"],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"إسناده صحيح، رجاله ثقات رجال الشيخين","takhrij":"أخرجه أحمد (22028) بلفظه، ومعمر في ((الجامع)) (20546)، والطبراني في ((لمعجم الكبير)) (20/ 126) (254) بنحوه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"BuBgI5gD"},{"id":"س-07524","fp":"ef38a9176e93","stateId":48,"easy":"إذا حلفت كاذباً ثم شهدت أن لا إله إلا الله ← تكون كفارة ليمينك (من واقعة)","cause":"شَهادتُكَ بأنْ لا إلَهَ إلَّا اللهُ","result":"كفَّارةٌ لِيَمينِكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 7230","srcLabel":"النسائي","text":["أنَّ رجُلًا ادَّعى عندَ رَجُلٍ حَقًّا، فاختَصَما إلى نَبِيِّ الله صلَّى اللهُ عليه وسلَّمَ، فسألَهُ البَيِّنةَ، فقال: ما عِندي بَيِّنةٌ، فقال للآخَرِ: احلِفْ، فحَلَفَ، فقال: واللهِ ما له عِندي شَيءٌ، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: بلْ هو عندكَ، ادْفَعْ إليهِ حَقَّه، ثمَّ قال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["شَهادتُكَ بأنْ لا إلَهَ إلَّا اللهُ",1]," ",["كفَّارةٌ لِيَمينِكَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (2695)، والنسائي في ((السنن الكبرى)) (5963)، والطحاوي في ((شرح مشكل الآثار)) (441) بنحوه","bab":"فضائل النبي وصفته ودلائل النبوة › اختصام المؤمنين إليه صلى الله عليه وسلم وحكمه عليهم","dorar":"aUXzGabS","merged":2,"otherRefs":["الأحكام الوسطى 3/ 363 (صحيح)"]},{"id":"س-01233","fp":"42760a486a01","stateId":48,"easy":"إذا صدّقت بلا إله إلا الله ← يغفر الله لك كذبك (من واقعة)","cause":"بتصديقِك ب لا إلهَ إلا اللهُ","result":"إنَّ اللهَ قد غفر لك كذبَك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-01227","ref":"السلسلة الصحيحة 3064","text":[["إنَّ اللهَ قد غفر لك كذبَك",2]," ",["بتصديقِك ب \" لا إلهَ إلا اللهُ",1]," \""],"grade":"صحيح","narrator":"أنس بن مالك وعبدالله بن عمر وابن عباس والحسن البصري","muhaddith":"صحيح","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (1/212) باختلاف يسير","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"CxM2prwR"},{"id":"س-02385","fp":"fb2848acd3ea","stateId":48,"easy":"إذا شهدت أن لا إله إلا الله ← تُغفر لك غدراتك وفجراتك","cause":"تَشهَدُ أنْ لا إلهَ إلَّا اللهُ","result":"غُفِرَ لك غَدَراتُك وفَجَراتُك","explicit":true,"ref":"مجمع الزوائد 1/37","srcLabel":"أحمد","text":["أقْبَلَ شَيخٌ يَدَّعِمُ على عَصًا حتى قام بين يَدَيِ النَّبيِّ صلَّى اللهُ عليه وسلَّم، فقال: يا نَبيَّ اللهِ، إنَّ لي غَدَراتٍ وفَجَراتٍ، فهل يُغفَرُ لي؟ قال: أليس ",["تَشهَدُ أنْ لا إلهَ إلَّا اللهُ",1],"، قال: نَعَمْ، وأشهَدُ أنَّ مُحمَّدًا رسولُ اللهِ، فقال: فقد ",["غُفِرَ لك غَدَراتُك وفَجَراتُك",2],"."],"grade":"حسن","narrator":"عمرو بن عبسة","muhaddith":"رجاله موثقون إلا أنه من رواية مكحول عن عمرو بن عبسة فلا أدري أسمع منه أم لا","takhrij":"أخرجه أحمد (19451)، والطبراني في ((مسند الشاميين)) (3500) باختلاف يسير.","bab":"إسلام › فضل الشهادتين","dorar":"zjWg9lPi"},{"id":"س-02463","fp":"3252fab263f7","stateId":48,"easy":"إذا شهدت أن لا إله إلا الله وأن محمداً رسول الله ← تأتي على ذنوبك (تمحوها)","cause":"أليسَ تشهدُ أن لا إلهَ إلَّا اللَّهَ وأنَّ مُحمَّد رسولُ اللَّهِ","result":"فإنَّ ذلِكَ يأتي على ذلِكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-02466","س-02412"],"ref":"الأمالي المطلقة 143","srcLabel":"الطبراني","text":["عن أنسِ بنِ مالِكٍ رضيَ اللَّهُ تعالى عنهُ قالَ جاءَ رجلٌ إلى رَسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ ما ترَكْتُ من حاجَّةٍ ولا داجَّةٍ إلَّا أتيتُ قالَ ",["أليسَ تشهدُ أن لا إلهَ إلَّا اللَّهَ وأنَّ مُحمَّد رسولُ اللَّهِ",1]," ؟ قالَها ثلاثَ مراتٍ قالَ نعَم قالَ ",["فإنَّ ذلِكَ يأتي على ذلِكَ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"حسن صحيح غريب وله شاهد","takhrij":"أخرجه أبو يعلى (3433) بلفظه، والبزار (6887)، والطبراني في ((المعجم الأوسط)) (7077) كلاهما باختلاف يسير.","bab":"إسلام › فضل الشهادتين","dorar":"pfqVaiun"},{"id":"س-02466","fp":"1c0dd716cefb","stateId":48,"easy":"إذا شهدت أن لا إله إلا الله وأن محمداً رسول الله ← تمحو ما قبلها من الذنوب","cause":"تشْهَدُ أن لا إلَهَ إلَّا اللَّهُ وأنِّي رسولُ اللَّهِ","result":"فإنَّ هذا يأبَى على ذلِكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-02463","ref":"البحر الزخار 13/299","text":["أنَّ رجلًا قال: يا رسولَ اللَّهِ ما ترَكتُ من حاجَّةٍ ولا داجَّةٍ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليه وسلَّم: ",["تشْهَدُ أن لا إلَهَ إلَّا اللَّهُ وأنِّي رسولُ اللَّهِ",1]," قالَ: بلى قالَ ",["فإنَّ هذا يأبَى على ذلِكَ",2]],"grade":"صحيح","narrator":"أنس","muhaddith":"لا نعلم روى مستور بن عباد، عن ثابت، عن أنس إلا هذا الحديث","takhrij":"أخرجه أبو يعلى (3433)، والطبراني في ((الأوسط)) (7077)، والبيهقي في ((الشعب)) (6684) بنحوه.","bab":"إسلام › فضل الشهادتين","dorar":"ZIXNg8OF"},{"id":"س-02595","fp":"6e32e31e21d4","stateId":48,"easy":"إذا حلفت باللات والعزى (بغير الله) فقل «لا إله إلا الله وحده...» ← يُكفّر ذلك","cause":"قل : لا إلهَ إلَّا اللهُ وحدَه لا شريكَ له ثلاثَ مراتٍ وتعوَّذْ باللهِ من الشيطانِ ثلاثَ مراتٍ وانفُثْ عن شمالِك ثلاثَ مراتٍ ولا تَعُدْ لهُ","result":"حلفتُ باللاتِ والعُزَّى","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ وحدَه لا شريكَ له»"},"repOf":"س-01230","ref":"المحلى 8/51","text":[["حلفتُ باللاتِ والعُزَّى",2]," فقال لي أصحابُ رسولِ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ بئس ما قلتَ إئتِ رسولَ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ فأخبِرْهُ فإنَّا لا نراك إلا قد كفرتَ فلقيتُه فأخبرتُه فقال لي : ",["قل : لا إلهَ إلَّا اللهُ وحدَه لا شريكَ له ثلاثَ مراتٍ وتعوَّذْ باللهِ من الشيطانِ ثلاثَ مراتٍ وانفُثْ عن شمالِك ثلاثَ مراتٍ ولا تَعُدْ لهُ",1]],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"احتج به ، وقال في المقدمة: (لم نحتج إلا بخبر صحيح من رواية الثقات مسند)","takhrij":"أخرجه النسائي في ((الكبرى)) (4699) واللفظ له، وابن ماجه (2097)، وأحمد (1590) بنحوه","bab":"إيمان › أعمال تنافي الإيمان","dorar":"QWuTjtFL"},{"id":"س-02829","fp":"e44dc2f1c573","stateId":48,"easy":"إذا عظّمت الله وأجللته ← يغفر لك","cause":"أَجِلُّوا اللهَ","result":"يَغْفِرْ لكم","explicit":true,"ref":"الجامع الصغير 189","srcLabel":"أحمد","text":[["أَجِلُّوا اللهَ ",1],["يَغْفِرْ لكم",2]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"حسن","takhrij":"أخرجه أحمد (21734)، والطبراني في ((الشاميين)) (221)، وأبو نعيم في ((الحلية)) (1/ 226) واللفظ لهم.","bab":"إيمان › الوعد","dorar":"eUf0MwDM"},{"id":"س-03430","fp":"3e0fdfbc0f3b","stateId":48,"easy":"إذا مِتّ لا تشرك بالله ولم تكن ساحراً ولم تحقد على أخيك ← يغفر الله لك ما سوى ذلك","cause":"مَن ماتَ لا يُشرِكُ باللهِ شَيئًا، ولم يَكُنْ ساحِرًا يَتَّبِعُ السَّحَرةَ، ولم يَحقِدْ على أخيه","result":"ثَلاثٌ مَن كُنَّ فيه فإنَّ اللَّهَ تعالى يَغفِرُ له ما سِوى ذلك","explicit":true,"ref":"فيض القدير 3/ 289","srcLabel":"فيض القدير","text":[["ثَلاثٌ مَن كُنَّ فيه فإنَّ اللَّهَ تعالى يَغفِرُ له ما سِوى ذلك",2],": ",["مَن ماتَ لا يُشرِكُ باللهِ شَيئًا، ولم يَكُنْ ساحِرًا يَتَّبِعُ السَّحَرةَ، ولم يَحقِدْ على أخيه",1]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","bab":"استغفار › أسباب المغفرة","dorar":"AWShXDa9"},{"id":"س-03287","fp":"70388fd01d31","stateId":48,"easy":"إذا لم تشرك بالله ← يُغفر لك يومي الخميس والاثنين إلا المتشاحنين","cause":"لا يُشرِكُ باللهِ شيئًا","result":"فيَغفِرُ اللهُ عزَّ وجلَّ في ذلك اليَومِ لكُلِّ امرِئٍ لا يُشرِكُ باللهِ شيئًا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-02283"],"ref":"صحيح مسلم 2565","srcLabel":"متفق عليه","text":["تُعرَضُ الأعمالُ في كُلِّ يَومِ خَميسٍ واثنَينِ، ",["فيَغفِرُ اللهُ عزَّ وجلَّ في ذلك اليَومِ لكُلِّ امرِئٍ لا يُشرِكُ باللهِ شيئًا",2],"، إلَّا امرَأً كانَت بينَه وبينَ أخيه شَحناءُ، فيُقالُ: اركوا هَذَينِ حتَّى يَصطَلِحا، اركوا هَذَينِ حتَّى يَصطَلِحا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"استغفار › أسباب المغفرة","dorar":"0Kc6k1Dr","merged":2,"otherRefs":["مجمع الزوائد 8/69 (حسن)"]},{"id":"س-06471","fp":"27fd5fddc2db","stateId":48,"easy":"إذا لم تشرك بالله ← يغفر لك المقحمات (الكبائر)","cause":"لمَن لا يُشرِكُ باللهِ عزَّ وجلَّ مِن أُمَّتِه","result":"وغُفِرَ لمَن لا يُشرِكُ باللهِ عزَّ وجلَّ مِن أُمَّتِه المُقحَماتُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03378","ref":"تخريج المسند لشعيب 4011","text":["لمَّا أُسرِيَ برسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ انتُهيَ به إلى سِدرةِ المُنتَهى، وهي في السَّماءِ السَّادسةِ، وإليها يَنتهي ما يُصعَدُ به مِن الأرضِ -وقال مرَّةً: وما يُعرَجُ به مِن الأرضِ- فيُقبَضُ منها، وإليها يَنتهي ما يُهبَطُ به مِن فوقِها، فيُقبَضُ منها، {إِذْ يَغْشَى السِّدْرَةَ مَا يَغْشَى} [النجم: 16]، قال: فَراشٌ مِن ذَهبٍ، قال: فأُعطِيَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ثلاثَ خِلالٍ: الصَّلَواتُ الخَمسُ، وخَواتيمُ سورةِ البَقرةِ، ",["وغُفِرَ لمَن لا يُشرِكُ باللهِ عزَّ وجلَّ مِن أُمَّتِه المُقحَماتُ",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (173)، والترمذي (3276)، والنسائي (451)، وأحمد (4011) واللفظ له","bab":"صلاة › فرض الصلاة","dorar":"I5NlJvXF"},{"id":"س-07166","fp":"9490f54eb7ba","stateId":48,"easy":"إذا كنت مسلماً لا شحناء بينك وبين أحد ← يغفر الله لك يومي الاثنين والخميس","cause":"لكلِّ مسلِمٍ","result":"يَغفرُ اللهُ فيهما","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-03267"],"ref":"هداية الرواة 2015","srcLabel":"مسلم","text":["أنَّ النَّبيَّ - صلَّى اللهُ عليهِ وسلَّمَ - كان يَصومُ يومَ الاثنينِ والخميسِ، فقيلَ: يا رسولَ اللهِ ! إنَّك تصومُ يومَ الاثنينِ والخميسِ ؟ ! فقالَ: إنَّ يومَ الاثنينِ والخميسِ ",["يَغفرُ اللهُ فيهما",2]," ",["لكلِّ مسلِمٍ",1]," ؛ إلَّا المتهاجرَينِ يقولُ: دَعهُما حتَّى يَصطلِحا"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه مسلم (2565)، وأبو داود (4916)، ومالك (3370) جميعهم بلفظ مقارب.","bab":"علم › حسن السؤال ونصح العالم","dorar":"aam6qJP5"},{"id":"س-02436","fp":"14b1e648a99d","stateId":48,"easy":"إذا قلت لا إله إلا الله صادقاً ← أبشر فقد غفر الله لك (من واقعة)","cause":"ارفعوا أيدِيَكم وقولَا لَا إلهَ إلا اللهُ","result":"أبشروا فإنَّ الله قد غفر لكم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[55],"ref":"جامع المسانيد والسنن 5121","srcLabel":"أحمد","text":["كنَّا عند النبيِّ صلَّى اللهُ عليهِ وسلَّمَ، فقال: هلْ فِيكُم غَرِيبٌ؟ يعنى أهلَ الكتابِ، فقلنا: لا يا رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ، فأمر بغلقِ البابِ، وقال: ",["ارفعوا أيدِيَكم وقولَا لَا إلهَ إلا اللهُ",1],"، فرفعنا أيديَنا ساعةً، ثم وضع رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يدَه، ثم قال: الحمدُ للهِ، اللَّهم بعثتني بهذه الكلمةِ، وأمرتَني بها، ووعدتني عليها الجنَّةَ، وإنَّك لا تخلفُ الميعادَ، ثم قال: ",["أبشروا فإنَّ الله قد غفر لكم",2],"."],"grade":"حسن","narrator":"شداد بن أوس","muhaddith":"لا بأس بإسناده","takhrij":"أخرجه أحمد (17121)، والبزار (2717)، والدولابي في ((الكنى والأسماء)) (500)\n جميعا بلفظه .","bab":"إسلام › فضل الشهادتين","dorar":"jXwi6SF1"},{"id":"س-03935","fp":"4d0f8422681f","stateId":48,"easy":"إذا لم تشرك بالله ← فأنت في مشيئة الله إن شاء غفر لك","cause":"أن اللهَ لا يغفرُ أن يُشْرَكَ به ويغفرُ ما دون ذلك لمن يشاءُ","result":"فنهانا رسولُ اللهِ أن نوجبَ لأحدٍ من أهلِ الدِّينِ النارَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج كتاب السنة 973","srcLabel":"الطبراني","text":["قال كنا نوجِبُ لأهلِ الكبائرِ النارَ حتى نزلت هذه الآيةُ على النبيِّ ",["أن اللهَ لا يغفرُ أن يُشْرَكَ به ويغفرُ ما دون ذلك لمن يشاءُ",1]," ",["فنهانا رسولُ اللهِ أن نوجبَ لأحدٍ من أهلِ الدِّينِ النارَ",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"إسناده جيد","takhrij":"أخرجه البزار (5840)، وأبو يعلى (5813)، والطبراني في ((المعجم الأوسط)) (5942) باختلاف يسير","bab":"تفسير آيات › سورة النساء","dorar":"fwyGoWDq"},{"id":"س-04055","fp":"a7fe4ad90472","stateId":48,"easy":"إذا أسلمت بعد ذنوب الجاهلية ← عفا الله عما سلف","cause":"وَأدْتُ في الجاهليَّةِ","result":"عَفا اللهُ عمَّا سلَفَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 21339","srcLabel":"النسائي","text":["أتَيْتُ أبا ذَرٍّ، فلم أجِدْه، ورَأيْتُ المرأةَ فسأَلْتُها، فقالت: هو ذاك في ضَيْعةٍ له، فجاءَ يَقودُ، أو يَسوقُ بَعيرَيْنِ، قاطرًا أحَدَهما في عَجُزِ صاحِبِه، في عُنُقِ كلِّ واحدٍ منهما قِربةٌ، فوضَعَ القِربَتيْنِ، قُلْتُ: يا أبا ذَرٍّ، ما كان منَ الناسِ أحَدٌ أحَبَّ إليَّ أنْ أَلْقاهُ منكَ، ولا أبغَضَ أنْ أَلْقاهُ منكَ، قال: للهِ أبوكَ، وما يَجمَعُ هذا؟ قال: قُلْتُ: إنِّي كُنْتُ ",["وَأدْتُ في الجاهليَّةِ",1],"، وكُنْتُ أَرْجو في لِقائِكَ أنْ تُخبِرَني أنَّ لي تَوبةً ومَخرَجًا، وكُنْتُ أَخْشى في لِقائِكَ أنْ تُخبِرَني أنَّه لا تَوبةَ لي، فقال: أفي الجاهليَّةِ؟ قُلْتُ: نَعَمْ، فقال: ",["عَفا اللهُ عمَّا سلَفَ",2],"، ثُم عاجَ برأسِه إلى المرأةِ، فأمَرَ لي بطَعامٍ، فالتَوَتْ عليه، ثُم أمَرَها فالتَوَتْ عليه، حتى ارتَفَعَتْ أصواتُهما، قال: إيهًا، دَعينا عنكِ؛ فإنَّكُنَّ لن تَعْدُونَ ما قال لنا فيكُنَّ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، قُلْتُ: وما قال لكم فيهِنَّ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ قال: المرأةُ ضِلَعٌ، فإنْ تَذهَبْ تُقَوِّمُها تَكسِرْها، وإنْ تَدَعْها ففيها أَوَدٌ وبُلْغةٌ، فوَلَّتْ فجاءَتْ بثَريدةٍ كأنَّها قَطاةٌ، فقال: كُلْ ولا أَهولَنَّكَ، إنِّي صائمٌ، ثُم قامَ يُصلِّي، فجعَلَ يُهذِّبُ الركوعَ ويُخفِّفُه، ورَأيْتُه يَتَحرَّى أنْ أشبَعَ أو أُقارِبَ، ثُم جاءَ فوضَعَ يَدَه معي، فقُلْتُ: إنَّا للهِ وإنَّا إليه راجِعونَ، فقال: ما لكَ؟ فقُلْتُ: مَن كُنْتُ أَخْشى منَ الناسِ أنْ يَكذِبَني، فما كُنْتُ أَخْشى أنْ تَكذِبَني، قال: للهِ أبوكَ، إنْ كذَبْتُكَ كَذْبةً منذ لَقيتَني، فقال: ألم تُخبِرْني أنَّكَ صائمٌ، ثُم أراكَ تأكُلُ؟ قال: بَلى، إنِّي صُمْتُ ثلاثةَ أيامٍ من هذا الشهْرِ، فوجَبَ لي أجْرُه، وحَلَّ لي الطعامُ معكَ."],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"رجاله ثقات","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9152) المرفوع منه، وأحمد (21339) واللفظ له","bab":"توبة › ما يقبل فيه التوبة وما لا يقبل","dorar":"pfpPzGmr"},{"id":"س-01225","fp":"89ed8948eade","stateId":48,"easy":"إذا حلفت كاذباً ثم صدقت في الشهادة لله ← تُكفّر يمينك (من واقعة)","cause":"معرفتُه أنْ لا إلهَ إلا اللهُ أو شهادتُه","result":"وكفارةُ يمينِه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشاكر 4/244","srcLabel":"أبو داود","text":["اختصم إلى النبيِّ صلى اللهُ عليه وسلمُ رجلانِ فوقعت اليمينُ على أحدِهما فحلفَ باللهِ الذي لا إلهَ إلا هو مالَه عندَه شيءٌ قال : فنزل جبريلُ على النبيِّ صلَّى اللهُ عليهِ وسلَّمَ فقال : إنه كاذبٌ إنَّ لَه عندَه حقَّه فأمرَه أنْ يُعْطِيَه حقُّه ",["وكفارةُ يمينِه",2]," ",["معرفتُه أنْ لا إلهَ إلا اللهُ أو شهادتُه",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3275)، والنسائي في ((السنن الكبرى)) (6006) بنحوه","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"c9mqD3KT","merged":2,"otherRefs":["تخريج المسند لشاكر 4/345 (صحيح)"]},{"id":"س-02283","fp":"c4fb858165a1","stateId":48,"easy":"إذا لم تشرك بالله ولم تُشاحن أخاك ← يُغفر لك يوم الاثنين والخميس","cause":"لا يُشرِكُ باللهِ شيئًا","result":"ويُغفَرُ لكلِّ إنسانٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03287","ref":"تخريج شرح السنة 3524","text":["تُفتَحُ أبوابُ الجنَّةِ كُلَّ اثنَينِ وخَميسٍ، ",["ويُغفَرُ لكلِّ إنسانٍ",2]," ",["لا يُشرِكُ باللهِ شيئًا",1],"، إلَّا رجُلٌ بينَه وبينَ أخيهِ شَحناءُ، فيقولُ: اترُكوا هذَيْنِ حتى يَصطَلِحا."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه مسلم (2565) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"3iH2F528"},{"id":"س-02412","fp":"50a649c764de","stateId":48,"easy":"إذا شهدت أن لا إله إلا الله وأن محمداً رسول الله ← يُسقط الله ما كان قبلها","cause":"لا يَأْتيه أحَدٌ يَشهَدُ أنْ لا إلَهَ إلَّا اللهُ، وأنَّ مُحمَّدًا رَسولُ اللهِ","result":"إلَّا قبِلَ ذلك، وأسقَطَ ما كانَ قبلَ ذلك","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-02463","ref":"المستدرك على الصحيحين 6638","text":["عنِ الحجَّاجِ بنِ ذي الرُّقَيْبةِ بنِ عَبدِ الرَّحمَنِ بنِ كَعبِ بنِ زُهَيرِ بنِ أبي سُلْمى المُزَنيِّ، عنْ أبيهِ، عنْ جدِّه، قالَ: خرَجَ كَعبٌ وبُجَيرٌ ابْنا زُهَيرٍ حتَّى أتَيا أبرَقَ العزَّافِ، فقالَ بُجَيرٌ لكَعبٍ: اثبُتْ في عجَلِ هذا المكانِ حتَّى آتيَ هذا الرَّجلَ، يَعني رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فأسمَعَ ما يَقولُ، فثبَتَ كَعبٌ وخرَجَ بُجَيرٌ، فجاءَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فعرَضَ عليه الإسْلامَ، فأسلَمَ، فبلَغَ ذلك كَعبًا، فقالَ:\n ألَا أبْلِغا عَنِّي بُجَيرًا رِسالةً ... على أيِّ شَيءٍ وَيحَ غَيرِكَ دلَّكَا\n على خُلُقٍ لم تُلفِ أمًّا ولا أبًا ... عليه ولم تُدرِكْ عليه أخًا لَكَا \n سَقَاكَ أبو بَكرٍ بكأسٍ رَوِيَّةٍ ... وأنْهَلَكَ المَأْمونُ منها وعَلَّكَا\n فلمَّا بلغَتِ الأبْياتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ أهدَرَ دمَه، فقالَ: مَن لَقِيَ كَعبًا فلْيَقتُلْه، فكتَبَ بذلك بُجَيرٌ إلى أخيه يَذكُرُ له أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قد أهدَرَ دمَه، ويقولُ له: النَّجاءَ وما أراكَ تَنفَلِتُ، ثمَّ كتَبَ إليه بعدَ ذلك: اعلَمْ أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ ",["لا يَأْتيه أحَدٌ يَشهَدُ أنْ لا إلَهَ إلَّا اللهُ، وأنَّ مُحمَّدًا رَسولُ اللهِ",1]," ",["إلَّا قبِلَ ذلك، وأسقَطَ ما كانَ قبلَ ذلك",2],"، فإذا جاءَكَ كِتابي هذا فأسلِمْ وأقبِلْ، فأسلَمَ كَعبٌ وقالَ القَصيدةَ الَّتي يَمدَحُ فيها رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، ثمَّ أقبَلَ حتَّى أناخَ راحِلَتَه ببابِ مَسجِدِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، ثمَّ دخَلَ المَسجِدَ ورَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ معَ أصْحابِه مَكانَ المائدةِ منَ القَومِ مُتَحلِّقونَ معَه حَلْقةً دونَ حَلْقةٍ، يَلتفِتُ إلى هؤلاء مرَّةً، فيُحدِّثُهم، وإلى هؤلاء مرَّةً فيُحدِّثُهم، قالَ كَعبٌ: فأنَخْتُ راحِلَتي ببابِ المَسجِدِ، فعرَفْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ بالصِّفةِ، فتَخطَّيْتُ حتَّى جلَسْتُ إليه، فأسلَمْتُ، فقُلْتُ: أشهَدُ أنْ لا إلَهَ إلَّا اللهُ، وأنَّكَ رَسولُ اللهِ، الأمانَ يا رَسولَ اللهِ، قالَ: ومَن أنتَ؟ قُلْتُ: أنا كَعبُ بنُ زُهَيرٍ، قالَ: الَّذي تَقولُ، ثمَّ التَفَتَ إلى أبي بَكرٍ، فقالَ: كيف قالَ يا أبا بَكرٍ؟ فأنشَدَه أبو بَكرٍ:\n سَقاكَ أبو بَكرٍ بكأسٍ رَويَّةٍ ... وأنْهلَكَ المأمونُ منها وعلَّكَا\n قالَ: يا رَسولَ اللهِ، ما قُلْتُ هكذا، قالَ: وكيف قُلْتَ؟ قالَ: إنَّما قُلْتُ:\n سَقاكَ أبو بَكرٍ بكأْسٍ رَويَّةٍ ... وأنْهلَكَ المأْمورُ منها وعلَّكَا\n فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: مأمورٌ واللهِ ثمَّ أنشَدَه القَصيدةَ كلَّها حتَّى أتَى على آخِرِها وأمْلاها على الحجَّاجِ بنِ ذي الرُّقَيْبةِ حتَّى أتَى على آخِرِها، وهي هذه القَصيدةُ:\n بانَتْ سُعادٌ فَقَلْبي اليَومَ مَتْبولُ ... مُتيَّمٌ عندَها لم يُفْدَ مَغْلولُ\n وما سَعادُ غَداةَ البَيْنِ إذْ رَحَلوا ... إلَّا أغَنُّ غَضيضُ الطَّرفِ مَكْحولُ\n تَجْلو عَوارِضَ ذي ظَلْمٍ إذا ابتسَمَتْ ... كأنَّها مُنهَلٌ بالكأْسِ مَعْلولُ\n سحَّ السُّقاةُ عليه ماءَ مَحْنيةٍ ... مِن ماءِ أبطَحَ أمْسَى وهو مَشْمولُ\n تَنْفي الرِّياحُ القَذى عنه وأفْرَطَه ... مِن صَوبِ عاديةٍ بِيضٍ يَعالِيلُ\n سَقْيًا لَهَا خُلَّةٌ لَوْ أَنَّهَا صَدَقَتْ ... مَوْعُودَهَا وَلَوْ أَنَّ النُّصْحَ مَقْبُولُ\n لَكِنَّهَا خُلَّةٌ قَدْ سِيطَ مِنْ دَمِهَا ... فَجْعٌ وَوَلْعٌ وَإِخْلَافٌ وَتَبْدِيلُ\n فَمَا تَدُومُ عَلَى حَالٍ تَكُونُ بِهَا ... كَمَا تَلَوَّنَ فِي أَثْوَابِهَا الغُولُ\n ولَا تَمَسَّكُ بِالوَصْلِ الَّذِي زَعَمَتْ ... إلَّا كَمَا يُمْسِكُ المَاءَ الغَرَابِيلُ\n كَانَتْ مَوَاعِيدُ عُرْقُوبٍ لَهَا مَثَلًا ... وَمَا مَوَاعِيدُهَا إلَّا الأَبَاطِيلُ\n فَلَا يَغُرَّنَّكَ مَا مَنَّتْ وَمَا وَعَدَتْ ... إلَّا الأَمَانِيَّ وَالأَحْلَامَ تَضْلِيلُ\n أَمْسَتْ سُعَادُ بِأَرْضٍ مَا يُبَلِّغُهَا ... إلَّا الْعِتَاقُ النَّجِيبَاتُ الْمَرَاسِيلُ\n وَلَنْ يُبَلِّغَهَا إِلَّا عُذَافِرةٌ ... فِيهَا عَلَى الأَيْنِ إِرْقَالٌ وَتَبْغِيلُ\n مِنْ كُلِّ نَضَّاخةِ الذَّفْرَى إِذَا عَرِقَتْ ... عُرْضَتُهَا طَامِسُ الأَعْلَامِ مَجْهُولُ\n يَمْشِي القُرَادُ عَلَيهَا ثُمَّ يُزْلِقُهُ ... عنْهَا اللَّبَانُ وَأقْرَابٌ زَهَالِيلُ\n عَيْرَانةٌ قُذِفَتْ بِالنَّحْضِ عَنْ عُرُضٍ ... وَمِرْفَقٍ عَنْ ضُلُوعِ الزُّورِ مَفْتُولُ\n كَأَنَّ مَا فَاتَ عَيْنَيْهَا وَمَذْبَحَهَا ... مِنْ خَطْمِهَا وَمِنَ اللَّحْيَيْنِ بِرْطِيلُ\n تُمِرُّ مِثْلَ عَسِيبِ النَّحْلِ ذَا خُصَلٍ ... بغَارِبٍ لم تُخوِّنْهُ الأَحَالِيلُ\n قَنْوَاءُ فِي حَرَّتَيْهَا لِلبَصِيرِ بِهَا ... عِتْقٌ مُبِينٌ وَفِي الْخَدَّيْنِ تَسْهِيلُ\n تَخْدي عَلَى يَسَرَاتٍ وَهْيَ لَاهِيةٌ ... ذَاوَبِلٌ وَقْعُوهُنَّ الأَرْضَ تَحْلِيلُ\n حَرْفٌ أَبُوهَا أَخُوهَا مِنْ مُهَجَّنَةٍ ... وَعَمُّهَا خَالُهَا قَوْدَاءُ شَمْلِيلُ\n سُمرُ العُجَايَاتِ يَتْرُكْنَ الْحَصَا زِيمًا ... مَا إِنْ يَقيهِنَّ حَدَّ الْأُكْمِ تَنْعِيلُ\n يَوْمًا تَظَلُّ حِدَابُ الأَرْضِ تَرفَعُهَا ... مِنَ اللَّوَامِعِ تَخْلِيطٌ وَتَزْيِيلُ\n كَأنَّ أَوْبَ يَدَيْهَا بَعْدَمَا نَجَدَتْ ... وَقَدْ تَلَفَّعَ بِالقُورِ العَسَاقِيلُ\n أَوْبُ يَدَيْ ثاكِلٍ شَمْطَاءَ مُعْوِلةً ... قَامَتْ تُجَاوِبُهَا شُمْطٌ مَثَاكِيلُ\n نُوَاحةٌ رَخْوةُ الضَّبْعَيْنِ لَيسَ لَهَا ... لَمَّا نَعَى بَكْرَهَا النَّاعُونَ مَعْقُولُ\n تَسْعَى الوُشَاةُ بدَفَّيْهَا وَقِيلِهِمُ ... بأنَّكَ يَا ابْنَ أَبِي سُلْمَى لَمَقْتُولُ\n خَلُّوا طَرِيقَ يَدَيْهَا لَا أَبَا لَكُمُ ... فَكُلُّ مَا قَدَّرَ الرَّحْمَنُ مَفْعُولُ\n كُلُّ ابْنِ أُنْثَى وَإِنْ طَالَتْ سَلَامَتُهُ ... يَوْمًا عَلَى آلَةٍ حَدْبَاءَ مَحْمُولُ\n أُنْبِئْتُ أَنَّ رَسُولَ اللهِ أَوْعَدَنِي ... وَالْعَفْوُ عِنْدَ رَسُولِ اللهِ مَأْمُولُ\n فَقَدْ أَتَيْتُ رَسُولَ اللهِ مُعْتَذِرًا ... وَالْعُذْرُ عِنْدَ رَسُولِ اللهِ مَقْبُولُ\n مَهْلًا رَسُولَ الَّذِي أَعْطَاكَ نَافِلَةَ ... الْقُرْآنِ فِيه مَوَاعِيظٌ وَتَفْصِيلُ\n لَا تَأْخُذَنِّي بِأَقْوَالِ الوُشَاةِ وَلَمْ ... أُجْرِمْ وَلَوْ كَثُرَتْ عَنِّي الأقَاوِيلُ\n لَقَدْ أَقُومُ مَقَامًا لَوْ يَقُومُ لَهُ ... أَرَى وَأَسمَعُ مَا لَوْ يَسْمَعُ الْفِيلُ\n لَظَلَّ يُرْعَدُ إِلَّا أَنْ يَكُونَ لَهُ ... عِنْدَ الرَّسُولِ بِإِذْنِ اللهِ تَنْوِيلُ\n حَتَّى وَضَعْتُ يَمِينِي لَا أُنَازِعُهُ ... فِي كَفٍّ ذِي نَقِمَاتٍ قَوْلُهُ الْقِيلُ\n فَكَانَ أَخْوَفَ عِنْدِي إِذْ أُكَلِّمُهُ ... إِذْ قِيلَ إِنَّكَ مَنْسُوبٌ وَمَسْؤُولُ\n مِنْ خَادِرٍ شَبَّكَ الأنْيَابَ طَاعَ لَهُ ... بِبَطْنِ عَثَّرَ غِيلٌ دُونَهُ غِيلُ\n يَغْدُو فَيُلْحِمُ ضِرْغَامَيْنِ عِنْدَهُمَا ... لَحْمٌ مِنَ الْقَوْمِ مَنْثُورٌ خَرَادِيلُ\n مِنْهُ تَظَلُّ حَمِيرُ الْوَحْشِ ضَامِرَةً ... وَلَا تَمشَّى بِوَادِيهِ الأرَاجِيلُ\n وَلَا يَزَالُ بِوَادِيهِ أَخُو ثِقَةٍ ... مُطَرَّحُ الْبَزِّ وَالدِّرْسَانِ مَأْكُولُ\n إِنَّ الرَّسُولَ لَنُورٌ يُسْتَضَاءُ بِهِ ... وَصَارِمٌ مِنْ سُيُوفِ اللهِ مَسْلُولُ\n فِي فِتْيَةٍ مِنْ قُرَيْشٍ قَالَ قَائِلُهُمْ ... بِبَطْنِ مَكَّةَ لَمَّا أَسْلَمُوا زُولُوا\n زَالُوا فَمَا زَالَ أنْكاسٌ وَلَا كُشُفٌ ... عِنْدَ اللِّقَاءِ وَلَا مِيلٌ مَعَازِيلُ\n شُمُّ الْعَرَانِينِ أَبْطَالٌ لِباسُهُمُ ... مِنْ نَسْجِ دَاوُدَ فِي الهَيْجَا سَرَابِيلُ\n بِيضٌ سَوَابِغُ قَدْ شُكَّتْ لَهَا حَلَقٌ ... كَأَنَّهَا حَلَقُ الْقَفْعَاءِ مَجْدُولُ\n يَمْشُونَ مَشْيَ الْجِمَالِ البُزْلِ يَعْصِمُهُم ... ضَرْبٌ إِذَا عَرَّدَ السُّودُ التَّنَابِيلُ\n لَا يَفْرَحُونَ إِذَا نَالَتْ رِمَاحُهُمُ ... قَوْمًا وَلَيْسوا مَجَازِيعًا إِذَا نِيلُوا\n مَا يَقَعُ الطَّعْنُ إِلَّا فِي نُحُورِهُمُ ... وَمَا لَهُمْ عَنْ حِيَاضِ الْمَوْتِ تَهْلِيلُ"],"grade":"صحيح","narrator":"ذي الرقيبة بن عبد الرحمن بن كعب بن زهير بن أبي سلمى","muhaddith":"[صحيح]","takhrij":"أخرجه البيهقي (21182)، وابن أبي عاصم في ((الآحاد والمثاني)) (2706) بنحوه.","bab":"إسلام › فضل الشهادتين","dorar":"SX1HCfCK"},{"id":"س-02434","fp":"233905be87f3","stateId":48,"easy":"إذا أدركت الإسلام بعد ذنب كبير ← يغفر الله لك","cause":"أنْ تُدركَ الوائدةُ الإسلامَ","result":"فيغفرُ اللهُ لها","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"التمهيد 18/119","srcLabel":"أحمد","text":["أتيتُ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ أنا وأخي فقلنا يا رسولَ اللهِ إنَّ أُمنا ماتتْ في الجاهليةِ وكانتْ تُقري الضيفَ وتصلُ الرحمَ وتفعلُ وتفعلُ فهلْ يَنفعُها مِنْ عملِها ذلكَ شيءٌ قال لا قال فقلْنا إنَّ أُمنا ولدتْ أختًا لنا في الجاهليةِ لمْ تبلغْ الحنثَ فهلْ ذلكَ نافعُ أختَنا فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ أرأيتمُ الوائدةَ والموؤدةَ فإنَّهما في النارِ إلا ",["أنْ تُدركَ الوائدةُ الإسلامَ",1]," ",["فيغفرُ اللهُ لها",2]],"grade":"صحيح","narrator":"سلمة بن يزيد الجعفي","muhaddith":"صحيح من جهة الإسناد","takhrij":"أخرجه أحمد (15965)","bab":"إسلام › فضل الشهادتين","dorar":"fEak09qd"},{"id":"س-03267","fp":"369b5a010a8a","stateId":48,"easy":"إذا كنت مؤمناً لا شحناء بينك وبين أخيك ← يُغفر لك يومي الاثنين والخميس","cause":"لكل عبدٍ مؤمن","result":"فيُغفرُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-07166","ref":"التمهيد 13/198","text":["عن أبي هريرةَ أنه قال : تُعرضُ أعمالُ الناسِ في كل جمعةٍ مرّتين : يومَ الاثنينِ ويومَ الخميسِ ",["فيُغفرُ",2]," ",["لكل عبدٍ مؤمن",1]," إلا عبدا كانت بينَهُ وبينَ أخيهِ شحناءُ فيقال : اتركوا هذينِ حتى يفيئَا أو اتركُوا هذينِ يفيئا"],"grade":"صحيح","narrator":"أبو صالح السمان.","muhaddith":"مرفوع من وجوه صحاح","takhrij":"أخرجه مالك (3370) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"xoSQxGzk"},{"id":"س-03774","fp":"1b037f1fec04","stateId":48,"easy":"إذا ردّتك الطيرة عن حاجتك فقل «اللهم لا خير إلا خيرك...» ← يكون كفارة لذلك","cause":"أن يَقولَ أحدُهُم اللَّهمَّ لا خَيرَ إلَّا خيرُكَ","result":"ما كفَّارةُ ذلِكَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«اللَّهمَّ لا خَيرَ إلَّا خيرُكَ ولا طيرَ إلَّا طيرُكَ ولا إلَهَ غَيرُك»"},"otherNeedIds":[30],"ref":"تخريج المسند لشاكر 12/10","srcLabel":"أحمد","text":["من ردَّتهُ الطِّيَرةُ مِن حاجةٍ فقد أشرَكَ قالوا يا رسولَ اللَّهِ ",["ما كفَّارةُ ذلِكَ",2]," قالَ ",["أن يَقولَ أحدُهُم اللَّهمَّ لا خَيرَ إلَّا خيرُكَ",1]," ولا طيرَ إلَّا طيرُكَ ولا إلَهَ غَيرُكَ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (7045) واللفظ له، والطبراني (14/35) (14622)","bab":"الكفر والشرك › ذم الشرك وما ورد فيه من العقوبة","dorar":"c4gxT93I"},{"id":"س-01803","fp":"d8034051adf0","stateId":49,"easy":"إذا أخطأت ثم استغفرت الله ← يغفر لك","cause":"يُخطِئون، ثُمَّ يَستَغفِرونَ اللهَ","result":"فيَغفِرُ لهم","explicit":true,"star":true,"similar":["س-06976","س-03459","س-07479","س-01101"],"ref":"الأحاديث المختارة 1544","srcLabel":"البخاري","text":["«دخَلْتُ على أنَسِ بنِ مالِكٍ قال: سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: والذي نفسي بيَدِه -أو والذي نَفْسُ مُحَمَّدٍ بيَدِه- لو أخطَأْتُم حتَّى تملأَ خطاياكم ما بَيْنَ السَّماءِ والأرضِ، ثُمَّ استغفَرْتُم اللهَ لغَفَر لكم، والذي نَفْسُ مُحَمَّد بيَدِه -أو والذي نفسي بيَدِه لو لم تُخِطئوا لجاء اللهُ بقومٍ ",["يُخطِئون، ثُمَّ يَستَغفِرونَ اللهَ",1]," ",["فيَغفِرُ لهم",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"cMqHprTP","merged":5,"otherRefs":["تخريج شرح السنة 1295 (صحيح)","صحيح الجامع 5243 (صحيح)","صحيح مسلم 2749 (صحيح)","صحيح الجامع 5329 (صحيح)"]},{"id":"س-03454","fp":"6c9851540584","stateId":49,"easy":"إذا أذنبت فقلت «اللهم اغفر لي ذنبي» (وتكرر ذلك صادقاً) ← يقول الله: قد غفرت لك","cause":"أذنَبَ عَبدٌ ذَنبًا، فقال: اللَّهمَّ اغفِرْ لي ذَنبي","result":"اعمَلْ ما شِئتَ فقد غَفَرتُ لَكَ","explicit":true,"star":true,"apply":{"k":"say","t":"«اللهم اغفر لي ذنبي»"},"similar":["س-03442"],"ref":"صحيح مسلم 2758","srcLabel":"البخاري","text":["عَنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم، فيما يَحكي عن رَبِّه عَزَّ وجَلَّ، قال: ",["أذنَبَ عَبدٌ ذَنبًا، فقال: اللَّهمَّ اغفِرْ لي ذَنبي",1],"، فقال تَبارَكَ وتَعالى: أذنَبَ عَبدي ذَنبًا، فعَلِمَ أنَّ له رَبًّا يَغفِرُ الذَّنبَ، ويَأخُذُ بالذَّنبِ، ثُمَّ عادَ فأذنَبَ، فقال: أي رَبِّ اغفِرْ لي ذَنبي، فقال تَبارَكَ وتَعالى: عَبدي أذنَبَ ذَنبًا، فعَلِمَ أنَّ له رَبًّا يَغفِرُ الذَّنبَ، ويَأخُذُ بالذَّنبِ، ثُمَّ عادَ فأذنَبَ، فقال: أي رَبِّ اغفِرْ لي ذَنبي، فقال تَبارَكَ وتَعالى: أذنَبَ عَبدي ذَنبًا، فعَلِمَ أنَّ له رَبًّا يَغفِرُ الذَّنبَ، ويَأخُذُ بالذَّنبِ، ",["اعمَلْ ما شِئتَ فقد غَفَرتُ لَكَ",2],"، قال عبدُ الأعلى: لا أدري أقال في الثَّالِثةِ أوِ الرَّابِعةِ: اعمَلْ ما شِئتَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7507) باختلاف يسير","bab":"استغفار › فضل الاستغفار","dorar":"g3g2Cr2h","merged":4,"otherRefs":["تخريج صحيح ابن حبان 625 (صحيح)","المستدرك على الصحيحين 7817 (صحيح)","تخريج صحيح ابن حبان 622 (صحيح)"]},{"id":"س-03137","fp":"bd723a80654c","stateId":49,"easy":"إذا أذنبت بالليل فتبت بالنهار (والعكس) ← يبسط الله يده ليتوب عليك","cause":"ليتوبَ بالنَّهارِ","result":"واضعٌ يدَه لِمُسيءِ اللَّيلِ","explicit":true,"star":true,"ref":"تخريج صحيح ابن حبان 266","srcLabel":"متفق عليه","text":["إنَّ اللهَ لا ينامُ ولا ينبغي له أنْ ينامَ يخفِضُ القِسطَ ويرفَعُه يُرفَعُ إليه عملُ النَّهارِ قبْلَ اللَّيلِ وعمَلُ اللَّيلِ قبْلَ النَّهارِ حجابُه النُّورُ لو كُشِف طبَقُها أحرَق سُبُحاتُ وجهِه كلَّ شيءٍ أدرَكه بصرُه ",["واضعٌ يدَه لِمُسيءِ اللَّيلِ",2]," ",["ليتوبَ بالنَّهارِ",1]," ولِمُسيءِ النَّهارِ ليتوبَ باللَّيلِ حتَّى تطلُعَ الشَّمسُ مِن مغربِها"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه مسلم (179) باختلاف يسير دون قوله: \"واضع يده ...\"","bab":"إيمان › توحيد الأسماء والصفات","dorar":"dKHdWH3P","merged":3,"otherRefs":["تخريج كتاب السنة 615 (صحيح)","صحيح مسلم 2759 (صحيح)"]},{"id":"س-03436","fp":"79a3d898b358","stateId":49,"easy":"إذا علمت أن الله قادر على مغفرتك فاستغفرته ← يغفر لك ولا يبالي","cause":"فمَن علم منكم أنني ذو قدرةٍ على المغفرةِ فاستغفرَني","result":"غفرتُ له ولا أُباِلِي","explicit":true,"star":true,"ref":"هداية الرواة 2/453","srcLabel":"مسلم","text":["يقولُ اللهُ تعالَى : يا عبادِي ! كلُّكم ضالٌّ إلا مَن هديتُ ؛ فسَلوني الهدَى أهدِكم ، وكلُّكم فقراءُ إلا من أغنيتُ ؛ فسلوني الرزقَ أرزقُكم ، وكلُّكم مذنبٌ إلا من عافيتُ ؛ ",["فمَن علم منكم أنني ذو قدرةٍ على المغفرةِ فاستغفرَني",1]," ؛ ",["غفرتُ له ولا أُباِلِي",2]," ، ولو أن أولَكم وآخرَكم وحيَّكم وميِّتَكم ورطبَكم ويابسَكم اجتمعوا على أتقَى قلبِ عبدٍ من عبادِي ؛ ما زاد ذلك من ملكِي جناحَ بعوضةٍ ، ولو أن أولَكم وآخرَكم وحيَّكم وميِّتَكم ورطْبَكم ويابسَكم اجتمعوا على أشقَى قلبِ عبدٍ من عبادي ؛ ما نقصَ ذلك من ملكِي جناحَ بعوضةٍ ، ولو أن أولَكم وآخرَكم وحيَّكم وميتَكم ورطْبَكم ويابسَكم اجتمعوا في صعيدٍ واحدٍ ، فسأل كلُّ إنسانٍ منكم ما بلغت أمنيتُه ، فأعطيتُ كلَّ سائلٍ منكم ما سأل ؛ ما نقصَ ذلك من ملكي إلا كما لو أن أحدَكم مرَّ بالبحرِ ، فغمس فيه إبرةً ثم رفعها ، ذلك بأني جوادٌ ماجدٌ أفعلُ ما أريدُ ، عطائي كلامٌ ، وعذابي كلامٌ ، إنما أمري لشيءٍ – إذا أردتُه أن أقولَ له : كنْ ، فيكونُ"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"أصله في مسلم","takhrij":"أخرجه الترمذي (2495)، وابن ماجه (4257)، وأحمد (21367) باختلاف يسير","bab":"استغفار › فضل الاستغفار","dorar":"OV8RfHWy","merged":4,"otherRefs":["تخريج المسند لشعيب 21540 (صحيح)","المستدرك على الصحيحين 7885 (صحيح)","الأسماء والصفات للبيهقي 1/211 (صحيح)"]},{"id":"س-01802","fp":"db72ab92dbf5","stateId":49,"easy":"إذا أخطأت حتى ملأت خطاياك ما بين السماء والأرض ثم استغفرت ← يغفر الله لك","cause":"لو أخطَأْتُم حتَّى تملأَ خطاياكم ما بَيْنَ السَّماءِ والأرضِ، ثُمَّ استغفَرْتُم اللهَ","result":"لغَفَر لكم","explicit":true,"star":true,"ref":"الأحاديث المختارة 1544","srcLabel":"البخاري","text":["«دخَلْتُ على أنَسِ بنِ مالِكٍ قال: سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: والذي نفسي بيَدِه -أو والذي نَفْسُ مُحَمَّدٍ بيَدِه- ",["لو أخطَأْتُم حتَّى تملأَ خطاياكم ما بَيْنَ السَّماءِ والأرضِ، ثُمَّ استغفَرْتُم اللهَ",1]," ",["لغَفَر لكم",2],"، والذي نَفْسُ مُحَمَّد بيَدِه -أو والذي نفسي بيَدِه لو لم تُخِطئوا لجاء اللهُ بقومٍ يُخطِئون، ثُمَّ يَستَغفِرونَ اللهَ فيَغفِرُ لهم»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"cMqHprTP","merged":2,"otherRefs":["تخريج شرح السنة 1295 (صحيح)"]},{"id":"س-03946","fp":"8c8da2cbf1c0","stateId":49,"easy":"إذا اعترفت بذنبك ثم تبت ← يتوب الله عليك","cause":"فإنَّ العَبْدَ إذَا اعْتَرَفَ بذَنْبٍ، ثُمَّ تَابَ","result":"تَابَ اللَّهُ عليه قالَتْ: فَلَمَّا قَضَى رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، مَقالَتَهُ قَلَصَ دَمْعِي حتَّى ما أُحِسُّ منه","explicit":true,"similar":["س-04601"],"ref":"تفسير القرطبي 15/161","srcLabel":"متفق عليه","text":["حديثُ الإفكِ الطويلِ في قصةِ عائشةَ رضوانُ اللهِ عليها [يعني حديث: كانَ رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ إذَا أَرَادَ أَنْ يَخْرُجَ سَفَرًا، أَقْرَعَ بيْنَ نِسَائِهِ، فأيَّتُهُنَّ خَرَجَ سَهْمُهَا خَرَجَ بهَا رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ معهُ . قالَتْ عَائِشَةُ: فأقْرَعَ بيْنَنَا في غَزْوَةٍ غَزَاهَا، فَخَرَجَ فِيهَا سَهْمِي، فَخَرَجْتُ مع رَسُولِ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، وَذلكَ بَعْدَ ما أُنْزِلَ الحِجَابُ، فأنَا أُحْمَلُ في هَوْدَجِي، وَأُنْزَلُ فيه مَسِيرَنَا حتَّى إذَا فَرَغَ رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ مِن غَزْوِهِ، وَقَفَلَ، وَدَنَوْنَا مِنَ المَدِينَةِ، آذَنَ لَيْلَةً بالرَّحِيلِ فَقُمْتُ حِينَ آذَنُوا بالرَّحِيلِ، فَمَشيتُ حتَّى جَاوَزْتُ الجَيْشَ، فَلَمَّا قَضَيْتُ مِن شَأْنِي أَقْبَلْتُ إلى الرَّحْلِ، فَلَمَسْتُ صَدْرِي فَإِذَا عِقْدِي مِن جَزْعِ ظَفَارِ قَدِ انْقَطَعَ، فَرَجَعْتُ فَالْتَمَسْتُ عِقْدِي فَحَبَسَنِي ابْتِغَاؤُهُ وَأَقْبَلَ الرَّهْطُ الَّذِينَ كَانُوا يَرْحَلُونَ لي فَحَمَلُوا هَوْدَجِي فَرَحَلُوهُ علَى بَعِيرِيَ الذي كُنْتُ أَرْكَبُ وَهُمْ يَحْسِبُونَ أَنِّي فِيهِ . قالَتْ: وَكَانَتِ النِّسَاءُ إذْ ذَاكَ خِفَافًا، لَمْ يُهَبَّلْنَ وَلَمْ يَغْشَهُنَّ اللَّحْمُ، إنَّما يَأْكُلْنَ العُلْقَةَ مِنَ الطَّعَامِ، فَلَمْ يَسْتَنْكِرِ القَوْمُ ثِقَلَ الهَوْدَجِ حِينَ رَحَلُوهُ وَرَفَعُوهُ، وَكُنْتُ جَارِيَةً حَدِيثَةَ السِّنِّ، فَبَعَثُوا الجَمَلَ وَسَارُوا، وَوَجَدْتُ عِقْدِي بَعْدَ ما اسْتَمَرَّ الجَيْشُ، فَجِئْتُ مَنَازِلَهُمْ وَليسَ بهَا دَاعٍ وَلَا مُجِيبٌ، فَتَيَمَّمْتُ مَنْزِلِي الذي كُنْتُ فِيهِ، وَظَنَنْتُ أنَّ القَوْمَ سَيَفْقِدُونِي فَيَرْجِعُونَ إلَيَّ، فَبيْنَا أَنَا جَالِسَةٌ في مَنْزِلِي غَلَبَتْنِي عَيْنِي فَنِمْتُ، وَكانَ صَفْوَانُ بنُ المُعَطَّلِ السُّلَمِيُّ ثُمَّ الذَّكْوَانِيُّ قدْ عَرَّسَ مِن وَرَاءِ الجَيْشِ فَادَّلَجَ، فأصْبَحَ عِنْدَ مَنْزِلِي فَرَأَى سَوَادَ إنْسَانٍ نَائِمٍ، فأتَانِي فَعَرَفَنِي حِينَ رَآنِي، وَقَدْ كانَ يَرَانِي قَبْلَ أَنْ يُضْرَبَ الحِجَابُ عَلَيَّ، فَاسْتَيْقَظْتُ باسْتِرْجَاعِهِ حِينَ عَرَفَنِي، فَخَمَّرْتُ وَجْهِي بجِلْبَابِي، وَوَاللَّهِ ما يُكَلِّمُنِي كَلِمَةً وَلَا سَمِعْتُ منه كَلِمَةً غيرَ اسْتِرْجَاعِهِ، حتَّى أَنَاخَ رَاحِلَتَهُ، فَوَطِئَ علَى يَدِهَا فَرَكِبْتُهَا، فَانْطَلَقَ يَقُودُ بيَ الرَّاحِلَةَ، حتَّى أَتَيْنَا الجَيْشَ، بَعْدَ ما نَزَلُوا مُوغِرِينَ في نَحْرِ الظَّهِيرَةِ، فَهَلَكَ مَن هَلَكَ في شَأْنِي، وَكانَ الذي تَوَلَّى كِبْرَهُ عبدُ اللهِ بنُ أُبَيٍّ ابنُ سَلُولَ، فَقَدِمْنَا المَدِينَةَ فَاشْتَكَيْتُ، حِينَ قَدِمْنَا المَدِينَةَ شَهْرًا، وَالنَّاسُ يُفِيضُونَ في قَوْلِ أَهْلِ الإفْكِ، وَلَا أَشْعُرُ بشيءٍ مِن ذلكَ، وَهو يَرِيبُنِي في وَجَعِي أَنِّي لا أَعْرِفُ مِن رَسُولِ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ اللُّطْفَ، الذي كُنْتُ أَرَى منه حِينَ أَشْتَكِي، إنَّما يَدْخُلُ رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ فيُسَلِّمُ، ثُمَّ يقولُ: كيفَ تِيكُمْ؟ فَذَاكَ يَرِيبُنِي، وَلَا أَشْعُرُ بالشَّرِّ، حتَّى خَرَجْتُ بَعْدَ ما نَقَهْتُ وَخَرَجَتْ مَعِي أُمُّ مِسْطَحٍ قِبَلَ المَنَاصِعِ، وَهو مُتَبَرَّزُنَا، وَلَا نَخْرُجُ إلَّا لَيْلًا إلى لَيْلٍ وَذلكَ قَبْلَ أَنْ نَتَّخِذَ الكُنُفَ قَرِيبًا مِن بُيُوتِنَا، وَأَمْرُنَا أَمْرُ العَرَبِ الأُوَلِ في التَّنَزُّهِ، وَكُنَّا نَتَأَذَّى بالكُنُفِ أَنْ نَتَّخِذَهَا عِنْدَ بُيُوتِنَا، فَانْطَلَقْتُ أَنَا وَأُمُّ مِسْطَحٍ، وَهي بنْتُ أَبِي رُهْمِ بنِ المُطَّلِبِ بنِ عبدِ مَنَافٍ، وَأُمُّهَا ابْنَةُ صَخْرِ بنِ عَامِرٍ، خَالَةُ أَبِي بَكْرٍ الصِّدِّيقِ، وَابنُهَا مِسْطَحُ بنُ أُثَاثَةَ بنِ عَبَّادِ بنِ المُطَّلِبِ، فأقْبَلْتُ أَنَا وَبِنْتُ أَبِي رُهْمٍ قِبَلَ بَيْتِي، حِينَ فَرَغْنَا مِن شَأْنِنَا، فَعَثَرَتْ أُمُّ مِسْطَحٍ في مِرْطِهَا، فَقالَتْ: تَعِسَ مِسْطَحٌ فَقُلتُ لَهَا: بئْسَ ما قُلْتِ، أَتَسُبِّينَ رَجُلًا قدْ شَهِدَ بَدْرًا، قالَتْ: أَيْ هَنْتَاهْ، أَوْ لَمْ تَسْمَعِي ما قالَ؟ قُلتُ: وَمَاذَا قالَ؟ قالَتْ: فأخْبَرَتْنِي بقَوْلِ أَهْلِ الإفْكِ فَازْدَدْتُ مَرَضًا إلى مَرَضِي، فَلَمَّا رَجَعْتُ إلى بَيْتِي، فَدَخَلَ عَلَيَّ رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، فَسَلَّمَ، ثُمَّ قالَ: كيفَ تِيكُمْ؟ قُلتُ: أَتَأْذَنُ لي أَنْ آتِيَ أَبَوَيَّ؟ قالَتْ: وَأَنَا حِينَئِذٍ أُرِيدُ أَنْ أَتَيَقَّنَ الخَبَرَ مِن قِبَلِهِمَا، فأذِنَ لي رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، فَجِئْتُ أَبَوَيَّ فَقُلتُ لِأُمِّي: يا أُمَّتَاهْ ما يَتَحَدَّثُ النَّاسُ؟ فَقالَتْ: يا بُنَيَّةُ هَوِّنِي عَلَيْكِ فَوَاللَّهِ لَقَلَّما كَانَتِ امْرَأَةٌ قَطُّ وَضِيئَةٌ عِنْدَ رَجُلٍ يُحِبُّهَا، وَلَهَا ضَرَائِرُ، إلَّا كَثَّرْنَ عَلَيْهَا، قالَتْ قُلتُ: سُبْحَانَ اللهِ وَقَدْ تَحَدَّثَ النَّاسُ بهذا؟ قالَتْ: فَبَكَيْتُ تِلكَ اللَّيْلَةَ حتَّى أَصْبَحْتُ لا يَرْقَأُ لي دَمْعٌ وَلَا أَكْتَحِلُ بنَوْمٍ، ثُمَّ أَصْبَحْتُ أَبْكِي، وَدَعَا رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ عَلِيَّ بنَ أَبِي طَالِبٍ وَأُسَامَةَ بنَ زَيْدٍ حِينَ اسْتَلْبَثَ الوَحْيُ، يَسْتَشِيرُهُما في فِرَاقِ أَهْلِهِ، قالَتْ فأمَّا أُسَامَةُ بنُ زَيْدٍ فأشَارَ علَى رَسُولِ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ بالَّذِي يَعْلَمُ مِن بَرَاءَةِ أَهْلِهِ، وَبِالَّذِي يَعْلَمُ في نَفْسِهِ لهمْ مِنَ الوُدِّ، فَقالَ: يا رَسُولَ اللهِ، هُمْ أَهْلُكَ وَلَا نَعْلَمُ إلَّا خَيْرًا، وَأَمَّا عَلِيُّ بنُ أَبِي طَالِبٍ، فَقالَ: لَمْ يُضَيِّقِ اللَّهُ عَلَيْكَ وَالنِّسَاءُ سِوَاهَا كَثِيرٌ، وإنْ تَسْأَلِ الجَارِيَةَ تَصْدُقْكَ، قالَتْ: فَدَعَا رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ بَرِيرَةَ فَقالَ: أَيْ بَرِيرَةُ هلْ رَأَيْتِ مِن شيءٍ يَرِيبُكِ مِن عَائِشَةَ؟ قالَتْ له بَرِيرَةُ: وَالَّذِي بَعَثَكَ بالحَقِّ إنْ رَأَيْتُ عَلَيْهَا أَمْرًا قَطُّ أَغْمِصُهُ عَلَيْهَا، أَكْثَرَ مِن أنَّهَا جَارِيَةٌ حَدِيثَةُ السِّنِّ، تَنَامُ عن عَجِينِ أَهْلِهَا، فَتَأْتي الدَّاجِنُ فَتَأْكُلُهُ، قالَتْ: فَقَامَ رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ علَى المِنْبَرِ، فَاسْتَعْذَرَ مِن عبدِ اللهِ بنِ أُبَيٍّ ابْنِ سَلُولَ، قالَتْ: فَقالَ رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ وَهو علَى المِنْبَرِ: يا مَعْشَرَ المُسْلِمِينَ مَن يَعْذِرُنِي مِن رَجُلٍ قدْ بَلَغَ أَذَاهُ في أَهْلِ بَيْتي فَوَاللَّهِ ما عَلِمْتُ علَى أَهْلِي إلَّا خَيْرًا، وَلقَدْ ذَكَرُوا رَجُلًا ما عَلِمْتُ عليه إلَّا خَيْرًا، وَما كانَ يَدْخُلُ علَى أَهْلِي إلَّا مَعِي فَقَامَ سَعْدُ بنُ مُعَاذٍ الأنْصَارِيُّ، فَقالَ: أَنَا أَعْذِرُكَ منه، يا رَسُولَ اللهِ، إنْ كانَ مِنَ الأوْسِ ضَرَبْنَا عُنُقَهُ وإنْ كانَ مِن إخْوَانِنَا الخَزْرَجِ أَمَرْتَنَا فَفَعَلْنَا أَمْرَكَ، قالَتْ: فَقَامَ سَعْدُ بنُ عُبَادَةَ وَهو سَيِّدُ الخَزْرَجِ، وَكانَ رَجُلًا صَالِحًا، وَلَكِنِ اجْتَهَلَتْهُ الحَمِيَّةُ، فَقالَ لِسَعْدِ بنِ مُعَاذٍ: كَذَبْتَ لَعَمْرُ اللهِ لا تَقْتُلُهُ، وَلَا تَقْدِرُ علَى قَتْلِهِ فَقَامَ أُسَيْدُ بنُ حُضَيْرٍ، وَهو ابنُ عَمِّ سَعْدِ بنِ مُعَاذٍ، فَقالَ لِسَعْدِ بنِ عُبَادَةَ: كَذَبْتَ لَعَمْرُ اللهِ لَنَقْتُلَنَّهُ فإنَّكَ مُنَافِقٌ تُجَادِلُ عَنِ المُنَافِقِينَ فَثَارَ الحَيَّانِ الأوْسُ وَالْخَزْرَجُ حتَّى هَمُّوا أَنْ يَقْتَتِلُوا وَرَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، قَائِمٌ علَى المِنْبَرِ، فَلَمْ يَزَلْ رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ يُخَفِّضُهُمْ حتَّى سَكَتُوا وَسَكَتَ، قالَتْ: وَبَكَيْتُ يَومِي ذلكَ لا يَرْقَأُ لي دَمْعٌ وَلَا أَكْتَحِلُ بنَوْمٍ، ثُمَّ بَكَيْتُ لَيْلَتي المُقْبِلَةَ لا يَرْقَأُ لي دَمْعٌ وَلَا أَكْتَحِلُ بنَوْمٍ وَأَبَوَايَ يَظُنَّانِ أنَّ البُكَاءَ فَالِقٌ كَبِدِي، فَبيْنَما هُما جَالِسَانِ عِندِي وَأَنَا أَبْكِي اسْتَأْذَنَتْ عَلَيَّ امْرَأَةٌ مِنَ الأنْصَارِ، فأذِنْتُ لَهَا فَجَلَسَتْ تَبْكِي، قالَتْ: فَبيْنَا نَحْنُ علَى ذلكَ دَخَلَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، فَسَلَّمَ، ثُمَّ جَلَسَ، قالَتْ: وَلَمْ يَجْلِسْ عِندِي مُنْذُ قيلَ لي ما قيلَ، وَقَدْ لَبِثَ شَهْرًا لا يُوحَى إلَيْهِ في شَأْنِي بشيءٍ، قالَتْ: فَتَشَهَّدَ رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ حِينَ جَلَسَ، ثُمَّ قالَ: أَمَّا بَعْدُ يا عَائِشَةُ، فإنَّه قدْ بَلَغَنِي عَنْكِ كَذَا وَكَذَا، فإنْ كُنْتِ بَرِيئَةً، فَسَيُبَرِّئُكِ اللَّهُ وإنْ كُنْتِ أَلْمَمْتِ بذَنْبٍ فَاسْتَغْفِرِي اللَّهَ وَتُوبِي إلَيْهِ، ",["فإنَّ العَبْدَ إذَا اعْتَرَفَ بذَنْبٍ، ثُمَّ تَابَ",1]," ",["تَابَ اللَّهُ عليه قالَتْ: فَلَمَّا قَضَى رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، مَقالَتَهُ قَلَصَ دَمْعِي حتَّى ما أُحِسُّ منه",2]," قَطْرَةً، فَقُلتُ لأَبِي: أَجِبْ عَنِّي رَسُولَ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، فِيما قالَ فَقالَ: وَاللَّهِ ما أَدْرِي ما أَقُولُ لِرَسُولِ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ فَقُلتُ لِأُمِّي: أَجِيبِي عَنِّي رَسُولَ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، فَقالَتْ: وَاللَّهِ ما أَدْرِي ما أَقُولُ لِرَسُولِ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، فَقُلتُ وَأَنَا جَارِيَةٌ حَدِيثَةُ السِّنِّ لا أَقْرَأُ كَثِيرًا مِنَ القُرْآنِ إنِّي وَاللَّهِ لقَدْ عَرَفْتُ أنَّكُمْ قدْ سَمِعْتُمْ بهذا حتَّى اسْتَقَرَّ في نُفُوسِكُمْ وَصَدَّقْتُمْ به، فإنْ قُلتُ لَكُمْ إنِّي بَرِيئَةٌ وَاللَّهُ يَعْلَمُ أَنِّي بَرِيئَةٌ لا تُصَدِّقُونِي بذلكَ، وَلَئِنِ اعْتَرَفْتُ لَكُمْ بأَمْرٍ وَاللَّهُ يَعْلَمُ أَنِّي بَرِيئَةٌ لَتُصَدِّقُونَنِي وإنِّي، وَاللَّهِ ما أَجِدُ لي وَلَكُمْ مَثَلًا إلَّا كما قالَ أَبُو يُوسُفَ {فَصَبْرٌ جَمِيلٌ وَاللَّهُ المُسْتَعَانُ علَى ما تَصِفُونَ} . قالَتْ: ثُمَّ تَحَوَّلْتُ فَاضْطَجَعْتُ علَى فِرَاشِي، قالَتْ: وَأَنَا، وَاللَّهِ حِينَئِذٍ أَعْلَمُ أَنِّي بَرِيئَةٌ وَأنَّ اللَّهَ مُبَرِّئِي ببَرَاءَتِي، وَلَكِنْ، وَاللَّهِ ما كُنْتُ أَظُنُّ أَنْ يُنْزَلَ في شَأْنِي وَحْيٌ يُتْلَى، وَلَشَأْنِي كانَ أَحْقَرَ في نَفْسِي مِن أَنْ يَتَكَلَّمَ اللَّهُ عَزَّ وَجَلَّ فِيَّ بأَمْرٍ يُتْلَى، وَلَكِنِّي كُنْتُ أَرْجُو أَنْ يَرَى رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ في النَّوْمِ رُؤْيَا يُبَرِّئُنِي اللَّهُ بهَا، قالَتْ: فَوَاللَّهِ ما رَامَ رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ مَجْلِسَهُ، وَلَا خَرَجَ مِن أَهْلِ البَيْتِ أَحَدٌ حتَّى أَنْزَلَ اللَّهُ عَزَّ وَجَلَّ علَى نَبِيِّهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، فأخَذَهُ ما كانَ يَأْخُذُهُ مِنَ البُرَحَاءِ عِنْدَ الوَحْيِ، حتَّى إنَّه لَيَتَحَدَّرُ منه مِثْلُ الجُمَانِ مِنَ العَرَقِ، في اليَومِ الشَّاتِ، مِن ثِقَلِ القَوْلِ الذي أُنْزِلَ عليه، قالَتْ: فَلَمَّا سُرِّيَ عن رَسُولِ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، وَهو يَضْحَكُ، فَكانَ أَوَّلَ كَلِمَةٍ تَكَلَّمَ بهَا أَنْ قالَ: أَبْشِرِي يا عَائِشَةُ أَمَّا اللَّهُ فقَدْ بَرَّأَكِ فَقالَتْ لي أُمِّي: قُومِي إلَيْهِ، فَقُلتُ: وَاللَّهِ لا أَقُومُ إلَيْهِ، وَلَا أَحْمَدُ إلَّا اللَّهَ، هو الذي أَنْزَلَ بَرَاءَتِي، قالَتْ: فأنْزَلَ اللَّهُ عَزَّ وَجَلَّ: {إنَّ الَّذِينَ جَاؤُوا بالإِفْكِ عُصْبَةٌ مِنكُم} عَشْرَ آيَاتٍ فأنْزَلَ اللَّهُ عَزَّ وَجَلَّ هَؤُلَاءِ الآيَاتِ بَرَاءَتِي، قالَتْ: فَقالَ أَبُو بَكْرٍ وَكانَ يُنْفِقُ علَى مِسْطَحٍ لِقَرَابَتِهِ منه وَفَقْرِهِ: وَاللَّهِ لا أُنْفِقُ عليه شيئًا أَبَدًا بَعْدَ الذي قالَ لِعَائِشَةَ فأنْزَلَ اللَّهُ عَزَّ وَجَلَّ: {وَلَا يَأْتَلِ أُولو الفَضْلِ مِنكُم وَالسَّعَةِ أَنْ يُؤْتُوا أُولِي القُرْبَى} إلى قَوْلِهِ: {أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللَّهُ لَكُمْ} . قالَ حِبَّانُ بنُ مُوسَى: قالَ عبدُ اللهِ بنُ المُبَارَكِ: هذِه أَرْجَى آيَةٍ في كِتَابِ اللَّهِ . فَقالَ أَبُو بَكْرٍ: وَاللَّهِ إنِّي لأُحِبُّ أَنْ يَغْفِرَ اللَّهُ لِي، فَرَجَعَ إلى مِسْطَحٍ النَّفَقَةَ الَّتي كانَ يُنْفِقُ عليه، وَقالَ: لا أَنْزِعُهَا منه أَبَدًا . قالَتْ عَائِشَةُ: وَكانَ رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ سَأَلَ زَيْنَبَ بنْتَ جَحْشٍ، زَوْجَ النبيِّ صَلَّى اللَّهُ عليه وَسَلَّمَ عن أَمْرِي ما عَلِمْتِ؟ أَوْ ما رَأَيْتِ؟ فَقالَتْ: يا رَسُولَ اللهِ، أَحْمِي سَمْعِي وَبَصَرِي، وَاللَّهِ ما عَلِمْتُ إلَّا خَيْرًا . قالَتْ عَائِشَةُ: وَهي الَّتي كَانَتْ تُسَامِينِي مِن أَزْوَاجِ النبيِّ صَلَّى اللَّهُ عليه وَسَلَّمَ، فَعَصَمَهَا اللَّهُ بالوَرَعِ، وَطَفِقَتْ أُخْتُهَا حَمْنَةُ بنْتُ جَحْشٍ تُحَارِبُ لَهَا، فَهَلَكَتْ فِيمَن هَلَكَ . قالَ الزُّهْرِيُّ: فَهذا ما انْتَهَى إلَيْنَا مِن أَمْرِ هَؤُلَاءِ الرَّهْطِ . وقالَ في حَديثِ يُونُسَ: احْتَمَلَتْهُ الحَمِيَّةُ .]"],"grade":"صحيح","narrator":"[عائشة أم المؤمنين]","muhaddith":"صحيح مشهور","takhrij":"أخرجه البخاري (2518)، ومسلم (2770) والطبري في ((تفسيره)) (17/ 197) جميعهم بطوله  .","bab":"تفسير آيات › سورة النور","dorar":"HNxlBrLI","merged":2,"otherRefs":["اللطائف من دقائق المعارف 183 (صحيح)"]},{"id":"س-06983","fp":"1abfbcc6bbd7","stateId":49,"easy":"إذا قلت «سبحانك إني ظلمت نفسي فاغفر لي» ← يقول الله: علم عبدي أن له رباً يغفر الذنوب","cause":"سُبْحانَك إنِّي ظَلَمْتُ نَفْسي فاغْفِرْ لي","result":"عَلِمَ عَبْدي أنَّ له رَبًّا يَغفِرُ الذُّنوبَ","explicit":true,"apply":{"k":"say","t":"«سبحانك إني ظلمت نفسي فاغفر لي»"},"otherNeedIds":[22],"ref":"الأحاديث المختارة 676","srcLabel":"البخاري","text":["«رَأيْتُ علِيًّا أُتِيَ بدابَّةٍ فوَضَعَ رِجْلَه في الرِّكابِ، فقالَ: بِسْمِ اللهِ، فلمَّا اسْتَوى عليها قالَ: الحَمْدُ للهِ، ثُمَّ قالَ: {سُبْحانَ الَّذِي سَخَّرَ لَنَا هَذَا وَمَا كُنَّا لَهُ مُقْرِنِينَ * وَإِنَّا إِلَى رَبِّنَا لَمُنْقَلِبُونَ} ثُمَّ كَبَّرَ ثَلاثًا، ثُمَّ قالَ: لا إلهَ إلَّا أنت ",["سُبْحانَك إنِّي ظَلَمْتُ نَفْسي فاغْفِرْ لي",1],"؛ إنَّه لا يَغفِرُ الذُّنوبَ إلَّا أنت، ثُمَّ اسْتَضْحَكَ، فقُلْتُ: مِمَّ اسْتَضْحَكْتَ؟ فقالَ: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قالَ مِثلَ ما قُلْتُ ثُمَّ اسْتَضْحَكَ، فقُلْتُ: مِمَّ اسْتَضْحَكْتَ يا رَسولَ اللهِ؟ قالَ: يَعجَبُ رَبُّنا جَلَّ وعَزَّ مِن قَوْلِ عَبْدِه: سُبْحانَك إنِّي ظَلَمْتُ نَفْسي فاغْفِرْ لي؛ إنَّه لا يَغفِرُ الذُّنوبَ إلَّا أنت. قالَ: ",["عَلِمَ عَبْدي أنَّ له رَبًّا يَغفِرُ الذُّنوبَ",2],"»."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"gc5COypR","merged":2,"otherRefs":["تخريج المسند لشاكر 2/234 (صحيح)"]},{"id":"س-01365","fp":"5e7242bb580a","stateId":49,"easy":"إذا تبت من السيئة ← تُمحى عنك","cause":"فإنْ تاب منها","result":"فامحوها عنه","explicit":true,"ref":"صحيح ابن حبان 381","srcLabel":"متفق عليه","text":["إذا همَّ عبدي بسيِّئةٍ فلم يعمَلْها فاكتُبوها له حسنةً فإنْ عمِلها فاكتُبوها له سيِّئةً ",["فإنْ تاب منها",1]," ",["فامحوها عنه",2]," وإذا همَّ عبدي بحسنةٍ فلم يعمَلْها فاكتُبوها له حسنةً فإنْ عمِلها فاكتُبوها له بعشَرةِ أمثالِها إلى سبعِمئةِ ضِعْفٍ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (7501)، ومسلم (128) بمعناه","bab":"نية › النية في العبادات","dorar":"X0fEzP4v"},{"id":"س-03463","fp":"de15e8071ffb","stateId":49,"easy":"إذا أُلهمت الاستغفار ← لا تُحرم المغفرة","cause":"ومَن أُلهِمَ الاستِغفارَ","result":"لم يُحرَمِ المغفِرةَ","explicit":true,"ref":"الأحاديث المختارة 1814","srcLabel":"البخاري","text":["«مَن أُلهِمَ خَمسةً لم يُحرَمْ خَمسةً: من أُلهِمَ الدُّعاءَ لم يُحرَمِ الإجابةَ؛ لأنَّ اللهَ تعالى يَقولُ: {وَقَالَ رَبُّكُم ادْعُونِي أَسْتَجِبْ لَكُمْ} ومَن أُلهِمَ التَّوبةَ لم يُحرَمِ القَبولَ؛ لأنَّ اللهَ تعالى يَقولُ: {وَهُوَ الَّذِي يَقْبَلُ التَّوْبَةَ عَنْ عِبَادِهِ}، ومَن أُلهِمَ الشُّكرَ لم يُحرَمِ الزِّيادةَ؛ لأنَّ اللهَ تعالى يَقولُ: {لَئِنْ شَكَرْتُمْ لَأَزِيدَنَّكُمْ}، ",["ومَن أُلهِمَ الاستِغفارَ ",1],["لم يُحرَمِ المغفِرةَ",2],"؛ لأنَّ اللهَ يَقولُ: {اسْتَغْفِرُوا رَبَّكُمْ إِنَّهُ كَانَ غَفَّارًا}، ومن أُلهِمَ النَّفَقةَ لم يُحرَمِ الخَلَفَ؛ لأنَّ اللهَ تعالى يَقولُ: {وَمَا أَنْفَقْتُمْ مِنْ شَيْءٍ فَهُوَ يُخْلِفُهُ}»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"استغفار › فضل الاستغفار","dorar":"NfsF3PxX"},{"id":"س-03466","fp":"254caee6d646","stateId":49,"easy":"إذا اعتذرت إلى الله ← يعذرك","cause":"ومَن اعْتَذَرَ إلى اللهِ عَزَّ وجَلَّ","result":"عَذَرَه","explicit":true,"ref":"الأحاديث المختارة 2751","srcLabel":"متفق عليه","text":["«مَن كَفَّ غَضَبَه كَفَّ اللهُ عنه عَذابَه، ومَن خَزَنَ لِسانَه سَتَرَ اللهُ عَزَّ وجَلَّ عَوْرتَه، ",["ومَن اعْتَذَرَ إلى اللهِ عَزَّ وجَلَّ",1]," ",["عَذَرَه",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"استغفار › فضل الاستغفار","dorar":"sfCSIGM2"},{"id":"س-07061","fp":"6c82ad4134eb","stateId":49,"easy":"إذا أذنبت ثم استغفرت وتبت ← يُغفر لك ويُتاب عليك","cause":"ثُمَّ يَسْتَغْفِرُ مِنهُ ويَتوبُ","result":"يُغْفَرُ لهُ، ويُتابُ عليه","explicit":true,"similar":["س-03440","س-04017","س-03973","س-08211"],"ref":"المستدرك على الصحيحين 196","srcLabel":"البخاري","text":["أنَّ رَجُلًا أَتَى رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: يا رسولَ اللهِ، أَحَدُنا يُذْنِبُ، قالَ: «يُكْتَبُ عليه». قالَ: ",["ثُمَّ يَسْتَغْفِرُ مِنهُ ويَتوبُ",1],"، قالَ: «",["يُغْفَرُ لهُ، ويُتابُ عليه».",2]," قالَ: فيَعودُ فيُذْنِبُ، قالَ: «يُكْتَبُ عليه»، قالَ: ثُمَّ يَسْتغْفِرُ مِنهُ ويَتوبُ، قالَ: «يُغْفَرُ لهُ، ويُتابُ عليه»، قالَ: فَيعودُ فَيُذْنبُ، قالَ: «يُكْتبُ عليه»، قالَ: ثُمَّ يَسْتَغْفِرُ مِنهُ ويَتوبُ، قالَ: «يُغْفَرُ لهُ، ويُتابُ عليه، ولا يَمَلُّ اللهُ حتَّى تَمَلُّوا»."],"grade":"صحيح","narrator":"عقبة بن عامر الجهني","muhaddith":"صحيح على شرط البخاري","takhrij":"أخرجه الروياني (173)، والطبراني في ((الأوسط)) (8689)، والبيهقي في ((شعب الإيمان)) (6695) جميعهم بلفظه.","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"6WZa7LqV"},{"id":"س-07750","fp":"48ad8da052dc","stateId":49,"easy":"إذا تركت الشرك والقتل والزنا وتبت وعملت صالحاً ← يبدّل الله سيئاتك حسنات","cause":"وَالَّذِينَ لَا يَدْعُونَ مَعَ اللَّهِ إِلَهًا آَخَرَ","result":"فَأُولَئِكَ يُبَدِّلُ اللَّهُ سَيِّئَاتِهِمْ حَسَنَاتٍ","explicit":true,"ref":"صحيح النسائي 4014","srcLabel":"متفق عليه","text":["أنَّ قومًا كانوا قتلوا فأكثروا ، وزنَوْا فأكثروا ، وانتهكوا ، فأتَوُا النَّبيَّ صلَّى اللهُ عليه وسلَّم ، قالوا : يا محمَّدُ ! إنَّ الَّذي تقولُ وتدعو إليه لحسنٌ ! لو تُخبِرُنا أنَّ لما عمِلنا كفَّارةً ؟ فأنزل اللهُ عزَّ وجلَّ  ",["وَالَّذِينَ لَا يَدْعُونَ مَعَ اللَّهِ إِلَهًا آَخَرَ",1],"  ، إلى :  ",["فَأُولَئِكَ يُبَدِّلُ اللَّهُ سَيِّئَاتِهِمْ حَسَنَاتٍ",2],"  ، قال : يُبدِّلُ اللهُ شِركَهم إيمانًا ، وزناهم إحصانًا . ونزلت  قُلْ يَا عِبَادِيَ الَّذِينَ أَسْرَفُوا عَلَى أَنْفُسِهِمْ  . الآيةُ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح [لغيره]","takhrij":"أخرجه النسائي (4003) واللفظ له، ومسلم (122) بنحوه، وأصله عند البخاري (3855)","bab":"قرآن › أسباب النزول","dorar":"zT5O4Lxk"},{"id":"س-08124","fp":"203b0b8ebf8b","stateId":49,"easy":"إذا خرجت تائباً صادقاً ولو مت في الطريق ← تقبضك ملائكة الرحمة","cause":"إنَّه خرَجَ تائبًا","result":"فقَبَضَتْهُ ملائكةُ الرَّحمةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[51],"ref":"السلسلة الصحيحة 2640","srcLabel":"متفق عليه","text":["إنَّ عبدًا قتَلَ تسعةً وتسعينَ نفْسًا، ثمَّ عَرَضَتْ له التَّوبةُ، فسأل عن أعلَمِ أهلِ الأرضِ، فدُلَّ على رجُلٍ -وفي روايةٍ: راهبٍ-، فأتاهُ، فقال: إنِّي قتلْتُ تسعةً وتسعينَ نفْسًا، فهل لي مِن توبةٍ؟ قال: بَعدَ قتْلِ تسعةٍ وتسعينَ نفْسًا؟! قال: فانتَضَى سيفَهُ فقَتَلَهُ به، فأكمَلَ به مِئةً، ثمَّ عَرَضَتْ له التَّوبةُ، فسأل عن أعلَمِ أهلِ الأرضِ، فدُلَّ على رجُلٍ [عالِمٍ]، فأتاهُ، فقال: إنِّي قتَلْتُ مِئةَ نفْسٍ، فهل لي مِن توبةٍ؟ فقال: ومَن يَحولُ بينَكَ وبينَ التَّوبةِ؟ اخرُجْ مِنَ القريةِ الخبيثةِ التي أنتَ فيها إلى القريةِ الصَّالحةِ؛ قريةِ كذا وكذا؛ [فإنَّ بها أُناسًا يَعْبُدونَ اللهَ]، فاعبُدْ ربَّكَ [معهم] فيها، [ولا تَرجِعْ إلى أرضِكَ؛ فإنَّها أرضُ سوءٍ]، قال: فخرَجَ إلى القريةِ الصَّالحةِ، فعرَضَ له أَجَلُهُ في [بعضِ] الطَّريقِ، [فناءَ بصَدْرِهِ نَحْوَها]، قال: فاختَصَمَتْ فيه ملائكةُ الرَّحمةِ وملائكةُ العذابِ، قال: فقال إبليسُ: أنا أَوْلَى بهِ؛ إنَّه لم يَعصِني ساعةً قَطُّ، قال: فقالتْ ملائكةُ الرَّحمةِ: ",["إنَّه خرَجَ تائبًا",1]," مُقْبِلًا بقلبِهِ إلى اللهِ، وقالتْ ملائكةُ العذابِ: إنَّه لم يعمَلْ خيرًا قَطُّ]، فبعَثَ اللهُ عزَّ وجلَّ مَلَكًا [في صورةِ آدَميٍّ]، فاختصَموا إليه، قال: فقال: انظُروا أيُّ القَرْيَتَيْنِ كانتْ أَقرَبَ إليه فأَلْحِقوهُ بأهلِها، [فأوحى اللهُ إلى هذهِ أنْ تَقَرَّبي، وأوحى إلى هذهِ أنْ تَباعَدي]، [فقاسوهُ، فوجدوهُ أدنَى إلى الأرضِ التي أرادَ [بشِبْرٍ]؛ ",["فقَبَضَتْهُ ملائكةُ الرَّحمةِ",2],"] [فغُفِرَ له]، قال الحَسَنُ: لمَّا عرَفَ الموتَ احتَفَزَ بنفْسِه، وفي روايةٍ: ناءَ بصَدْرِهِ؛ فقرَّبَ اللهُ عزَّ وجلَّ منه القريةَ الصَّالحةَ، وباعَدَ منه القريةَ الخبيثةَ؛ فألحَقوهُ بأهلِ القريةِ الصَّالحةِ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه ابن ماجه (2622)، وأحمد (11154) باختلاف يسير، وأخرجه البخاري (3470) مختصراً بلفظ مقارب، ومسلم (2766) بلفظ مقارب","bab":"ملائكة › أعمال الملائكة","dorar":"j4qLNkrx","merged":8,"otherRefs":["تخريج المسند لشعيب 11687 (صحيح)","إتحاف الخيرة المهرة 7/411 (صحيح)","صحيح مسلم 2766 (صحيح)","صحيح الجامع 4459 (صحيح)","مجمع الزوائد 10/214 (صحيح)","الترغيب والترهيب 4/123 (صحيح)"]},{"id":"س-03442","fp":"aa0c7d16ac34","stateId":49,"easy":"إذا أذنبت فقلت «ربّ أذنبت فاغفر لي» ← يقول الله: غفرت لعبدي","cause":"فقال: رَبِّ أذنَبتُ -ورُبَّما قال: أصَبتُ- فاغفِرْ لي","result":"غَفَرتُ لعَبدي","explicit":true,"apply":{"k":"say","t":"«ربّ أذنبت فاغفر لي»"},"repOf":"س-03454","ref":"صحيح البخاري 7507","text":["إنَّ عَبدًا أصابَ ذَنبًا -ورُبَّما قال: أذنَبَ ذَنبًا- ",["فقال: رَبِّ أذنَبتُ -ورُبَّما قال: أصَبتُ- فاغفِرْ لي",1],"، فقال رَبُّه: أعَلِمَ عَبدي أنَّ له رَبًّا يَغفِرُ الذَّنبَ ويَأخُذُ به؟ ",["غَفَرتُ لعَبدي",2],"، ثُمَّ مَكَثَ ما شاءَ اللهُ، ثُمَّ أصابَ ذَنبًا، أو أذنَبَ ذَنبًا، فقال: رَبِّ أذنَبتُ -أو أصَبتُ- آخَرَ، فاغفِرْه، فقال: أعَلِمَ عَبدي أنَّ له رَبًّا يَغفِرُ الذَّنبَ ويَأخُذُ به؟ غَفَرتُ لعَبدي، ثُمَّ مَكَثَ ما شاءَ اللهُ، ثُمَّ أذنَبَ ذَنبًا، ورُبَّما قال: أصابَ ذَنبًا، قال: قال: رَبِّ أصَبتُ -أو قال أذنَبتُ- آخَرَ، فاغفِرْه لي، فقال: أعَلِمَ عَبدي أنَّ له رَبًّا يَغفِرُ الذَّنبَ ويَأخُذُ به؟ غَفَرتُ لعَبدي، ثَلاثًا، فليَعمَلْ ما شاءَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2758) باختلاف يسير","bab":"استغفار › فضل الاستغفار","dorar":"lBPrgPzp","merged":2,"otherRefs":["تخريج المسند لشعيب 9256 (صحيح)"]},{"id":"س-03972","fp":"2852ced2eeb6","stateId":49,"easy":"إذا تبت قبل أن تطلع الشمس من مغربها ← يتوب الله عليك","cause":"مَنْ تابَ قبلَ أنْ تطْلُعَ الشمسُ مِنْ مَغْرِبِها","result":"تابَ اللهُ عليْهِ","explicit":true,"similar":["س-01563"],"ref":"صحيح الجامع 6133","srcLabel":"مسلم","text":[["مَنْ تابَ قبلَ أنْ تطْلُعَ الشمسُ مِنْ مَغْرِبِها ، ",1],["تابَ اللهُ عليْهِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2703)","bab":"توبة › الحض على التوبة","dorar":"XjgBd9LQ"},{"id":"س-03975","fp":"0bf41b5f8458","stateId":49,"easy":"إذا تبت ← تمحو التوبة ما قبلها","cause":"التوبةُ","result":"تجُبُّ ما قبلَها","explicit":true,"ref":"مجموع فتاوى ابن باز 297/6","srcLabel":"مسلم","text":[["التوبةُ ",1],["تجُبُّ ما قبلَها ",2],"[يعني حديث: حَضَرْنا عَمْرَو بنَ العاصِ، وهو في سِياقَةِ المَوْتِ، يَبَكِي طَوِيلًا، وحَوَّلَ وجْهَهُ إلى الجِدارِ، فَجَعَلَ ابنُهُ يقولُ: يا أبَتاهُ، أما بَشَّرَكَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ بكَذا؟ أما بَشَّرَكَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ بكَذا؟ قالَ: فأقْبَلَ بوَجْهِهِ، فقالَ: إنَّ أفْضَلَ ما نُعِدُّ شَهادَةُ أنْ لا إلَهَ إلَّا اللَّهُ، وأنَّ مُحَمَّدًا رَسولُ اللهِ، إنِّي قدْ كُنْتُ علَى أطْباقٍ ثَلاثٍ، لقَدْ رَأَيْتُنِي وما أحَدٌ أشَدَّ بُغْضًا لِرَسولِ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ مِنِّي، ولا أحَبَّ إلَيَّ أنْ أكُونَ قَدِ اسْتَمْكَنْتُ منه، فَقَتَلْتُهُ، فلوْ مُتُّ علَى تِلكَ الحالِ لَكُنْتُ مِن أهْلِ النَّارِ، فَلَمَّا جَعَلَ اللَّهُ الإسْلامَ في قَلْبِي أتَيْتُ النبيَّ صَلَّى اللَّهُ عليه وسلَّمَ، فَقُلتُ: ابْسُطْ يَمِينَكَ فَلأُبايِعْكَ، فَبَسَطَ يَمِينَهُ، قالَ: فَقَبَضْتُ يَدِي، قالَ: ما لكَ يا عَمْرُو؟ قالَ: قُلتُ: أرَدْتُ أنْ أشْتَرِطَ، قالَ: تَشْتَرِطُ بماذا؟ قُلتُ: أنْ يُغْفَرَ لِي، قالَ: أما عَلِمْتَ أنَّ الإسْلامَ يَهْدِمُ ما كانَ قَبْلَهُ؟ وأنَّ الهِجْرَةَ تَهْدِمُ ما كانَ قَبْلَها؟ وأنَّ الحَجَّ يَهْدِمُ ما كانَ قَبْلَهُ؟ وما كانَ أحَدٌ أحَبَّ إلَيَّ مِن رَسولِ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ، ولا أجَلَّ في عَيْنِي منه، وما كُنْتُ أُطِيقُ أنْ أمْلأَ عَيْنَيَّ منه إجْلالًا له، ولو سُئِلْتُ أنْ أصِفَهُ ما أطَقْتُ؛ لأَنِّي لَمْ أكُنْ أمْلأُ عَيْنَيَّ منه، ولو مُتُّ علَى تِلكَ الحالِ لَرَجَوْتُ أنْ أكُونَ مِن أهْلِ الجَنَّةِ، ثُمَّ ولِينا أشْياءَ ما أدْرِي ما حالِي فيها، فإذا أنا مُتُّ فلا تَصْحَبْنِي نائِحَةٌ، ولا نارٌ، فإذا دَفَنْتُمُونِي فَشُنُّوا عَلَيَّ التُّرابَ شَنًّا، ثُمَّ أقِيمُوا حَوْلَ قَبْرِي قَدْرَ ما تُنْحَرُ جَزُورٌ ويُقْسَمُ لَحْمُها، حتَّى أسْتَأْنِسَ بكُمْ، وأَنْظُرَ ماذا أُراجِعُ به رُسُلَ رَبِّي.]"],"grade":"صحيح","narrator":"[عمرو بن العاص]","muhaddith":"صحيح","takhrij":"أخرجه مسلم (121)، وأحمد (17827)، وابن أبي خيثمة في ((تاريخه-السفر الثاني)) (2642) بنحوه تامًا.","bab":"توبة › الحض على التوبة","dorar":"ytm0uPWI"},{"id":"س-03468","fp":"384089b3c965","stateId":49,"easy":"إذا أذنبت فتوضأت فأحسنت وصليت ركعتين واستغفرت ← يغفر الله لك","cause":"ليسَ مِن عَبدٍ يُذنِبُ ذَنبًا فيَقومُ فيَتَوضَّأُ فيُحسِنُ الوُضوءَ ثُمَّ يُصَلِّي رَكعَتَينِ، ثُمَّ يَستَغفِرُ اللَّهَ","result":"إلَّا غَفرَ اللهُ له","explicit":true,"apply":{"k":"count","t":"ركعتين · الوقت: بعد الوضوء"},"similar":["س-03461","س-03246","س-03447","س-03926","س-03448"],"ref":"الأربعون البلدانية 53","srcLabel":"أبو داود","text":["عن أسماءَ بنِ الحَكَمِ الفزاريِّ، قال: سَمِعتُ عليَّ بنَ أبي طالبٍ رَضِيَ الله عنه يَقولُ: كُنتُ إذا سَمِعتُ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم حَديثًا نَفعني اللهُ مِنه بما شاءَ أن يَنفعَني مِنه، وإذا حَدَّثَني غَيرُه استَحلفتُه، فإذا حَلَف لي صَدَّقتُه؛ فحَدَّثَني أبو بَكرٍ الصِّدِّيقُ رَضِيَ اللهُ عنه، وصَدَقَ أبو بَكرٍ رَضِيَ اللهُ عنه، قال: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: ",["ليسَ مِن عَبدٍ يُذنِبُ ذَنبًا فيَقومُ فيَتَوضَّأُ فيُحسِنُ الوُضوءَ ثُمَّ يُصَلِّي رَكعَتَينِ، ثُمَّ يَستَغفِرُ اللَّهَ",1],"، ",["إلَّا غَفرَ اللهُ له",2]],"grade":"صحيح","narrator":"أبو بكر","muhaddith":"محفوظ.","takhrij":"أخرجه النسائي في ((الكبرى)) (10175) واللفظ له، وأبو داود (1521) ، والترمذي (406) بنحوه.","bab":"استغفار › فضل الاستغفار","dorar":"vKdksWWB","merged":14,"otherRefs":["مجموع فتاوى ابن باز 28/441 (صحيح)","صحيح ابن حبان 623 (صحيح)","تخريج مشكل الآثار 6048 (حسن)","تخريج مشكل الآثار 6047 (حسن)","الأحاديث المختارة 9 (صحيح)","مجموع فتاوى ابن باز 25/165 (صحيح)","تخريج المسند لشعيب 48 (صحيح)","تخريج العواصم والقواصم 1/ 284 (صحيح)","تخريج مسند أبي بكر 9 (صحيح)","تخريج مشكل الآثار 6039 (حسن)","تخريج مشكل الآثار 6043 (حسن)","السلسلة الصحيحة 7/1179 (صحيح)","تخريج شرح السنة 1015 (حسن)"]},{"id":"س-04014","fp":"9bf75098bbf2","stateId":49,"easy":"إذا تبت ← يتوب الله عليك","cause":"ومَن تابَ","result":"تابَ اللهُ عليهِ","explicit":true,"similar":["س-04013"],"ref":"المطالب العالية 4/61","srcLabel":"إسحاق","text":["عنِ ابنِ مسعودٍ رَضِيَ اللهُ عنه، قال: قتَلَ رجُلٌ تسعةً وتسعينَ نفْسًا، ثمَّ أراد التَّوبةَ؛ فأتى راهبًا بأرضٍ (عَرِيَّةٍ)، فقال: يا راهبُ، قتلْتُ تسعةً وتسعينَ نفْسًا، فهل لي مِن تَوبةٍ؟ قال: لا، قال: لا جَرَمَ، واللهِ لأُكْمِلَنَّهُم بكَ مِئةً، ثمَّ أتى راهبًا آخَرَ، قال: إنِّي قتلْتُ تسعةً وتسعينَ نفْسًا، وكمَّلْتُهم مِئةً براهبٍ، فهل مِن تَوبةٍ؟ فقال: لقدْ أسرَفْتَ على نفْسِكَ، وركِبْتَ عظيمًا، ",["ومَن تابَ",1]," ",["تابَ اللهُ عليهِ",2],"، قال: فنَبَذَ السَّيفَ، وقال: واللهِ، لَأَخْدُمَنَّكَ حتَّى يُفَرِّقَ بينَنا الموتُ، قال: وعاهَدَهُ ألَّا يَعصيَهُ، قال: فجاءَهُ قومٌ سَفْرٌ أوْ مُسْنِتونَ، وكان يتطَبَّبُ، فقال الرجُلُ: [هل] تأمُرُني بشيْءٍ؟ قال: اذهَبْ فاسجُرِ التَّنُّورَ، قال: فذهَبَ فسَجَرَهُ حتَّى حَمِيَ، فقال: قد حَمِيَ، فما تأمُرُني؟ قال: اذهَبْ فقَعْ فيه، قال: فذهَبَ فوقَعَ فيه، ثمَّ اذَّكَّرَ الرَّاهبُ، فقام وقام مَن معه، فإذا هو في التَّنُّورِ يَرْشَحُ عَرَقًا لم تَضُرَّهُ النَّارُ، فقال الرَّاهبُ: قد علِمْتُ أنَّ تَوبَتَكَ قد قُبِلَتْ، فلَأَخْدُمَنَّكَ أبدًا حتَّى تُفارِقَني، قال ابنُ مسعودٍ رَضِيَ اللهُ عنه: وكانوا بَنو إسرائيلَ إذا أذنَبَ أحدُهم أصبَحَ وقد كُتِبَ كَفَّارةُ ذنبِهِ على أُسْكُفَّةِ بابِهِ، ففَضَّلَكُمُ اللهُ عليهم، فأُمِرْتم بالاستِغفارِ، فتستغفِرونَ اللهَ تعالى، قال: ولقد أعطى هذهِ الأُمَّةَ آيةً ما أُحِبُّ أنَّ لهم بها الدُّنيا وما فيها: {وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ ذَكَرُوا اللَّهَ فَاسْتَغْفَرُوا لِذُنُوبِهِمْ} [آل عمران: 135]."],"grade":"صحيح","narrator":"شقيق بن سلمة","muhaddith":"إسناده صحيح","takhrij":"أخرجه إسحاق بن راهويه كما في ((المطالب العالية)) لابن حجر (3465) بلفظه.","bab":"توبة › الحض على التوبة","dorar":"kO1LMXZ0","merged":23,"otherRefs":["مصباح الزجاجة 4/244 (صحيح)","المستدرك على الصحيحين 7862 (صحيح)","سنن الترمذي 3793 (صحيح)","مجمع الزوائد 7/144 (حسن)","صحيح البخاري 6439 (صحيح)","صحيح الموارد 2105 (صحيح)","الصحيح المسند 345 (صحيح)","صحيح البخاري 6437 (صحيح)","تخريج الإحياء للعراقي 3/293 (صحيح)","صحيح مسلم 1049 (صحيح)","تخريج المسند لشعيب 9007 (صحيح)","السلسلة الصحيحة 2910 (صحيح)","صحيح البخاري 6438 (صحيح)","تخريج المسند لشعيب 13587 (صحيح)","السلسلة الصحيحة 1639 (صحيح)","المستدرك على الصحيحين 2929 (صحيح)","تخريج المسند لشعيب 21111 (صحيح)","صحيح مسلم 1048 (صحيح)","تخريج المسند لشعيب 13873 (صحيح)","السلسلة الصحيحة 2907 (صحيح)","تخريج المسند لشعيب 24276 (صحيح)","تخريج مشكل الآثار 5/ 277 (صحيح)"]},{"id":"س-06824","fp":"16028e07d968","stateId":49,"easy":"إذا استغفرت في وقت النزول الإلهي ← يغفر الله لك","cause":"ألَا مُستغفرٌ فيستغفرُنِي","result":"فأغفِرَ لهُ","explicit":true,"similar":["س-00001","س-02770"],"otherNeedIds":[28,33],"ref":"البحر الزخار 10/18","srcLabel":"الطبراني","text":["إنَّ اللهَ تباركَ وتعالَى ينزِلُ في ثَلاثِ ساعاتٍ بَقينَ من اللَّيلِ ، فيُفتحُ الذِّكرَ السَّاعةَ الأُولَى الَّذي لَم يرَهُ أحدٌ غيرُه ، فيَمحُو اللهُ ما يشاءُ ويُثبتُ ما يشاءُ ، ثمَّ ينزلُ السَّاعةَ الثَّانيةَ إلى جنَّةِ عدنٍ ، وهيَ الَّتي لَم يرَهَا غيرَه ، ولم تخطُرَ على قَلبِ بشرٍ ، لا يُسكنُهَا معهُ من بنِي آدمَ غيرَ ثلاثةٍ : النبيِّينَ والصِّدِّيقينَ والشُّهداءِ ، ثمَّ يقولُ : طُوبَى لمَن دخلَكِ ، ثمَّ ينزلُ في الساعةِ الثَّالثةِ إلى سماءِ الدُّنيا ، فيقولُ : ",["ألَا مُستغفرٌ فيستغفرُنِي",1]," ",["فأغفِرَ لهُ",2]," ! ألَا مِن سائلٍ يسألُنِي فأعطِيَهُ ! ألا من داعٍ يدعُوني فأُجِيبَه ! حتَّى تكونَ صَلاةُ الفجرِ ، وكذلك يقولُ اللهُ عزَّ وجلَّ : ?وَقُرْآنَ الْفَجْرِ إِنَّ قُرْآنَ الْفَجْرِ كَانَ مَشْهُودًا? قال : تَشهدُه ملائكةُ اللَّيلِ والنَّهارِ"],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"محفوظ","takhrij":"أخرجه ابن خزيمة في ((التوحيد)) (46)، والعقيلي في ((الضعفاء الكبير)) (2/93)، والطبراني في ((المعجم الأوسط)) (8635) بنحوه","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"RscjYhUL","merged":17,"otherRefs":["تخريج المسند لشعيب 10756 (صحيح)","تخريج المسند لشعيب 10544 (صحيح)","تخريج المسند لشعيب 4268 (صحيح)","شرح ابن ماجه لمغلطاي 2/511 (صحيح)","تخريج المسند لشعيب 11295 (صحيح)","صحيح الجامع 1917 (صحيح)","فتاوى نور على الدرب لابن باز 10/164 (صحيح)","تخريج صحيح ابن حبان 921 (صحيح)","تحفة المحتاج 1/425 (صحيح)","تخريج المسند لشعيب 9591 (صحيح)","تخريج كتاب السنة 502 (صحيح)","مختصر الصواعق المرسلة 444 (صحيح)","تخريج كتاب السنة 499 (صحيح)","صحيح مسلم 758 (صحيح)","تلخيص العلل المتناهية 27 (صحيح)","معارج القبول 296/1 (حسن)"]},{"id":"س-08381","fp":"543bb911d39d","stateId":49,"easy":"إذا عملت سوءاً ثم استغفرت الله ← تجد الله غفوراً رحيماً","cause":"ثُمَّ يَسْتَغْفِرِ اللَّهَ","result":"يَجِدِ اللَّهَ غَفُورًا رَحِيمًا","explicit":true,"similar":["س-03939"],"ref":"المستدرك على الصحيحين 3236","srcLabel":"الطبراني","text":["عنْ عبدِ اللهِ بنِ مسعودٍ رَضيَ اللهُ عنه قالَ: إنَّ في سورةِ النِّساءِ لخمسُ آياتٍ ما يَسُرُّني أنَّ لي بها الدُّنيا وما فيها: {إِنَّ اللَّهَ لَا يَظْلِمُ مِثْقَالَ ذَرَّةٍ وَإِنْ تَكُ حَسَنَةً يُضَاعِفْهَا وَيُؤْتِ مِن لَدُنْهُ أَجْرًا عَظِيمًا} [النساء: 40]، {إِنْ تَجْتَنِبُوا كَبَائِرَ مَا تُنْهَوْنَ عَنْهُ نُكَفِّرْ عَنْكُمْ سَيِّئَاتِكُمْ وَنُدْخِلْكُمْ مُدْخَلًا كَرِيمًا} [النساء: 31]، {إِنَّ اللَّهَ لَا يَغْفِرُ أَنْ يُشْرَكَ بِهِ وَيَغْفِرُ مَا دُونَ ذَلِكَ لِمَنْ يَشَاءُ} [النساء: 48]، {وَلَوْ أَنَّهُمْ إِذْ ظَلَمُوا أَنْفُسَهُمْ جَاؤُوكَ فَاسْتَغْفَرُوا اللَّهَ وَاسْتَغْفَرَ لَهُمُ الرَّسُولُ لَوَجَدُوا اللَّهَ تَوَّابًا رَحِيمًا} [النساء: 64]، {وَمَنْ يَعْمَلْ سُوءًا أَوْ يَظْلِمْ نَفْسَهُ ",["ثُمَّ يَسْتَغْفِرِ اللَّهَ",1]," ",["يَجِدِ اللَّهَ غَفُورًا رَحِيمًا",2],"} [النساء: 110]. قالَ عبدُ اللهِ: ما يسُرُّني أنَّ لي بها الدُّنيا وما فيها."],"grade":"صحيح","narrator":"عبد الرحمن بن عبدالله بن مسعود","muhaddith":"[إسناده صحيح إن كان عبد الرحمن سمع من أبيه فقد اختلف في ذلك]","takhrij":"أخرجه الطبراني (9069) (9/  220)، واللالكائي في ((شرح أصول الاعتقاد)) (2000)، والبيهقي في ((شعب الإيمان)) (2202) بنحوه","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"6kfGWkBb","merged":9,"otherRefs":["تخريج شرح السنة 1015 (حسن)","العجاب في بيان الأسباب 1/352 (حسن)","مجمع الزوائد 7/14 (صحيح)","إتحاف الخيرة المهرة 6/198 (صحيح)","تخريج المسند لشعيب 47 (صحيح)","عمدة التفسير 1/571 (صحيح)"]},{"id":"ق-0010","fp":"97cd7d0a3c14","stateId":49,"easy":"التوبة بكلمات الاستغفار ← توبة الله على العبد","cause":"التوبة بكلمات الاستغفار","result":"توبة الله على العبد","explicit":true,"ref":"سورة البقرة: 37","srcLabel":"القرآن الكريم","quran":{"s":2,"from":37,"to":37,"text":"فَتَلَقَّى آدَمُ مِنْ رَبِّهِ كَلِمَاتٍ فَتَابَ عَلَيْهِ إِنَّهُ هُوَ التَّوَّابُ الرَّحِيمُ (37)","hl":[[0,92,1]]}},{"id":"ق-0015","fp":"b5339180a2c9","stateId":49,"easy":"التوبة إلى الله ← توبة الله ورحمته","cause":"التوبة إلى الله","result":"توبة الله ورحمته","explicit":true,"similar":["ق-0327"],"ref":"سورة البقرة: 54","srcLabel":"القرآن الكريم","quran":{"s":2,"from":54,"to":54,"text":"وَإِذْ قَالَ مُوسَى لِقَوْمِهِ يَا قَوْمِ إِنَّكُمْ ظَلَمْتُمْ أَنْفُسَكُمْ بِاتِّخَاذِكُمُ الْعِجْلَ فَتُوبُوا إِلَى بَارِئِكُمْ فَاقْتُلُوا أَنْفُسَكُمْ ذَلِكُمْ خَيْرٌ لَكُمْ عِنْدَ بَارِئِكُمْ فَتَابَ عَلَيْكُمْ إِنَّهُ هُوَ التَّوَّابُ الرَّحِيمُ (54)","hl":[[102,251,1]]}},{"id":"ق-0016","fp":"d552e7be3a18","stateId":49,"easy":"الاستغفار (قول حطة) والدخول سجّداً ← مغفرة الخطايا وزيادة المحسنين","cause":"الاستغفار (قول حطة) والدخول سجّداً","result":"مغفرة الخطايا وزيادة المحسنين","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["ق-0433"],"otherNeedIds":[40],"ref":"سورة البقرة: 58","srcLabel":"القرآن الكريم","quran":{"s":2,"from":58,"to":58,"text":"وَإِذْ قُلْنَا ادْخُلُوا هَذِهِ الْقَرْيَةَ فَكُلُوا مِنْهَا حَيْثُ شِئْتُمْ رَغَدًا وَادْخُلُوا الْبَابَ سُجَّدًا وَقُولُوا حِطَّةٌ نَغْفِرْ لَكُمْ خَطَايَاكُمْ وَسَنَزِيدُ الْمُحْسِنِينَ (58)","hl":[[85,188,1]]}},{"id":"ق-0055","fp":"c4302e950254","stateId":49,"easy":"التوبة والإصلاح والبيان ← توبة الله ورحمته","cause":"التوبة والإصلاح والبيان","result":"توبة الله ورحمته","explicit":true,"similar":["ق-0142","ق-0848"],"ref":"سورة البقرة: 160","srcLabel":"القرآن الكريم","quran":{"s":2,"from":160,"to":160,"text":"إِلَّا الَّذِينَ تَابُوا وَأَصْلَحُوا وَبَيَّنُوا فَأُولَئِكَ أَتُوبُ عَلَيْهِمْ وَأَنَا التَّوَّابُ الرَّحِيمُ (160)","hl":[[7,111,1]]}},{"id":"ق-0110","fp":"413dfb8e5769","stateId":49,"easy":"الانتهاء عن الربا بعد الموعظة ← العفو عمّا سلف","cause":"الانتهاء عن الربا بعد الموعظة","result":"العفو عمّا سلف","explicit":true,"ref":"سورة البقرة: 275","srcLabel":"القرآن الكريم","quran":{"s":2,"from":275,"to":275,"text":"الَّذِينَ يَأْكُلُونَ الرِّبَا لَا يَقُومُونَ إِلَّا كَمَا يَقُومُ الَّذِي يَتَخَبَّطُهُ الشَّيْطَانُ مِنَ الْمَسِّ ذَلِكَ بِأَنَّهُمْ قَالُوا إِنَّمَا الْبَيْعُ مِثْلُ الرِّبَا وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا فَمَنْ جَاءَهُ مَوْعِظَةٌ مِنْ رَبِّهِ فَانْتَهَى فَلَهُ مَا سَلَفَ وَأَمْرُهُ إِلَى اللَّهِ وَمَنْ عَادَ فَأُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ (275)","hl":[[225,317,1]]}},{"id":"ق-0142","fp":"95572d89f7c3","stateId":49,"easy":"التوبة والإصلاح ← مغفرة الله ورحمته","cause":"التوبة والإصلاح","result":"مغفرة الله ورحمته","explicit":true,"repOf":"ق-0055","ref":"سورة آل عمران: 89","quran":{"s":3,"from":89,"to":89,"text":"إِلَّا الَّذِينَ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ (89)","hl":[[7,88,1]]}},{"id":"ق-0164","fp":"3926aa7918b2","stateId":49,"easy":"ذكر الله والاستغفار بعد الفاحشة وظلم النفس وترك الإصرار ← مغفرة من الله وجنات ونعم أجر العاملين","cause":"ذكر الله والاستغفار بعد الفاحشة وظلم النفس وترك الإصرار","result":"مغفرة من الله وجنات ونعم أجر العاملين","explicit":true,"otherNeedIds":[55],"ref":"سورة آل عمران: 135–136","srcLabel":"القرآن الكريم","quran":{"s":3,"from":135,"to":136,"text":"وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ ذَكَرُوا اللَّهَ فَاسْتَغْفَرُوا لِذُنُوبِهِمْ وَمَنْ يَغْفِرُ الذُّنُوبَ إِلَّا اللَّهُ وَلَمْ يُصِرُّوا عَلَى مَا فَعَلُوا وَهُمْ يَعْلَمُونَ (135) أُولَئِكَ جَزَاؤُهُمْ مَغْفِرَةٌ مِنْ رَبِّهِمْ وَجَنَّاتٌ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا وَنِعْمَ أَجْرُ الْعَامِلِينَ (136)","hl":[[0,356,1]]}},{"id":"ق-0207","fp":"bb962cf0d14f","stateId":49,"easy":"التوبة من قريب بعد السوء بجهالة ← توبة الله عليهم","cause":"التوبة من قريب بعد السوء بجهالة","result":"توبة الله عليهم","explicit":true,"ref":"سورة النساء: 17","srcLabel":"القرآن الكريم","quran":{"s":4,"from":17,"to":17,"text":"إِنَّمَا التَّوْبَةُ عَلَى اللَّهِ لِلَّذِينَ يَعْمَلُونَ السُّوءَ بِجَهَالَةٍ ثُمَّ يَتُوبُونَ مِنْ قَرِيبٍ فَأُولَئِكَ يَتُوبُ اللَّهُ عَلَيْهِمْ وَكَانَ اللَّهُ عَلِيمًا حَكِيمًا (17)","hl":[[35,181,1]]}},{"id":"ق-0227","fp":"88c7af29f114","stateId":49,"easy":"المجيء إلى الرسول واستغفار الله بعد ظلم النفس ← وجدان الله تواباً رحيماً","cause":"المجيء إلى الرسول واستغفار الله بعد ظلم النفس","result":"وجدان الله تواباً رحيماً","explicit":true,"similar":["ق-0244"],"ref":"سورة النساء: 64","srcLabel":"القرآن الكريم","quran":{"s":4,"from":64,"to":64,"text":"وَمَا أَرْسَلْنَا مِنْ رَسُولٍ إِلَّا لِيُطَاعَ بِإِذْنِ اللَّهِ وَلَوْ أَنَّهُمْ إِذْ ظَلَمُوا أَنْفُسَهُمْ جَاءُوكَ فَاسْتَغْفَرُوا اللَّهَ وَاسْتَغْفَرَ لَهُمُ الرَّسُولُ لَوَجَدُوا اللَّهَ تَوَّابًا رَحِيمًا (64)","hl":[[65,211,1]]}},{"id":"ق-0244","fp":"af2994790d9e","stateId":49,"easy":"الاستغفار بعد السوء وظلم النفس ← وجدان الله غفوراً رحيماً","cause":"الاستغفار بعد السوء وظلم النفس","result":"وجدان الله غفوراً رحيماً","explicit":true,"repOf":"ق-0227","ref":"سورة النساء: 110","quran":{"s":4,"from":110,"to":110,"text":"وَمَنْ يَعْمَلْ سُوءًا أَوْ يَظْلِمْ نَفْسَهُ ثُمَّ يَسْتَغْفِرِ اللَّهَ يَجِدِ اللَّهَ غَفُورًا رَحِيمًا (110)","hl":[[0,105,1]]}},{"id":"ق-0268","fp":"b1ee23138dd0","stateId":49,"easy":"التوبة والإصلاح والاعتصام بالله وإخلاص الدين له ← مع المؤمنين وأجر عظيم","cause":"التوبة والإصلاح والاعتصام بالله وإخلاص الدين له","result":"مع المؤمنين وأجر عظيم","explicit":true,"otherNeedIds":[40],"ref":"سورة النساء: 146","srcLabel":"القرآن الكريم","quran":{"s":4,"from":146,"to":146,"text":"إِلَّا الَّذِينَ تَابُوا وَأَصْلَحُوا وَاعْتَصَمُوا بِاللَّهِ وَأَخْلَصُوا دِينَهُمْ لِلَّهِ فَأُولَئِكَ مَعَ الْمُؤْمِنِينَ وَسَوْفَ يُؤْتِ اللَّهُ الْمُؤْمِنِينَ أَجْرًا عَظِيمًا (146)","hl":[[7,180,1]]}},{"id":"ق-0302","fp":"ce438beb4859","stateId":49,"easy":"التوبة قبل القدرة عليهم ← مغفرة الله ورحمته","cause":"التوبة قبل القدرة عليهم","result":"مغفرة الله ورحمته","explicit":true,"ref":"سورة المائدة: 34","srcLabel":"القرآن الكريم","quran":{"s":5,"from":34,"to":34,"text":"إِلَّا الَّذِينَ تَابُوا مِنْ قَبْلِ أَنْ تَقْدِرُوا عَلَيْهِمْ فَاعْلَمُوا أَنَّ اللَّهَ غَفُورٌ رَحِيمٌ (34)","hl":[[0,105,1]]}},{"id":"ق-0305","fp":"19690a5f7b75","stateId":49,"easy":"التوبة بعد الظلم والإصلاح ← توبة الله عليه","cause":"التوبة بعد الظلم والإصلاح","result":"توبة الله عليه","explicit":true,"ref":"سورة المائدة: 39","srcLabel":"القرآن الكريم","quran":{"s":5,"from":39,"to":39,"text":"فَمَنْ تَابَ مِنْ بَعْدِ ظُلْمِهِ وَأَصْلَحَ فَإِنَّ اللَّهَ يَتُوبُ عَلَيْهِ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ (39)","hl":[[0,107,1]]}},{"id":"ق-0327","fp":"17171e84e305","stateId":49,"easy":"التوبة إلى الله واستغفاره ← مغفرة الله ورحمته","cause":"التوبة إلى الله واستغفاره","result":"مغفرة الله ورحمته","explicit":true,"repOf":"ق-0015","ref":"سورة المائدة: 73–74","quran":{"s":5,"from":73,"to":74,"text":"لَقَدْ كَفَرَ الَّذِينَ قَالُوا إِنَّ اللَّهَ ثَالِثُ ثَلَاثَةٍ وَمَا مِنْ إِلَهٍ إِلَّا إِلَهٌ وَاحِدٌ وَإِنْ لَمْ يَنْتَهُوا عَمَّا يَقُولُونَ لَيَمَسَّنَّ الَّذِينَ كَفَرُوا مِنْهُمْ عَذَابٌ أَلِيمٌ (73) أَفَلَا يَتُوبُونَ إِلَى اللَّهِ وَيَسْتَغْفِرُونَهُ وَاللَّهُ غَفُورٌ رَحِيمٌ (74)","hl":[[207,285,1]]}},{"id":"ق-0358","fp":"5cb63a1d221d","stateId":49,"easy":"التوبة والإصلاح بعد السوء بجهالة ← مغفرة الله ورحمته","cause":"التوبة والإصلاح بعد السوء بجهالة","result":"مغفرة الله ورحمته","explicit":true,"similar":["ق-0688"],"ref":"سورة الأنعام: 54","srcLabel":"القرآن الكريم","quran":{"s":6,"from":54,"to":54,"text":"وَإِذَا جَاءَكَ الَّذِينَ يُؤْمِنُونَ بِآيَاتِنَا فَقُلْ سَلَامٌ عَلَيْكُمْ كَتَبَ رَبُّكُمْ عَلَى نَفْسِهِ الرَّحْمَةَ أَنَّهُ مَنْ عَمِلَ مِنْكُمْ سُوءًا بِجَهَالَةٍ ثُمَّ تَابَ مِنْ بَعْدِهِ وَأَصْلَحَ فَأَنَّهُ غَفُورٌ رَحِيمٌ (54)","hl":[[128,230,1]]}},{"id":"ق-0429","fp":"6523d8788fc0","stateId":49,"easy":"التوبة والإيمان بعد عمل السيئات ← مغفرة الله ورحمته","cause":"التوبة والإيمان بعد عمل السيئات","result":"مغفرة الله ورحمته","explicit":true,"ref":"سورة الأعراف: 153","srcLabel":"القرآن الكريم","quran":{"s":7,"from":153,"to":153,"text":"وَالَّذِينَ عَمِلُوا السَّيِّئَاتِ ثُمَّ تَابُوا مِنْ بَعْدِهَا وَآمَنُوا إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ (153)","hl":[[0,120,1]]}},{"id":"ق-0433","fp":"124d5869b560","stateId":49,"easy":"قول حطة والدخول سجّداً ← مغفرة الخطيئات وزيادة المحسنين","cause":"قول حطة والدخول سجّداً","result":"مغفرة الخطيئات وزيادة المحسنين","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0016","otherNeedIds":[40],"ref":"سورة الأعراف: 161","quran":{"s":7,"from":161,"to":161,"text":"وَإِذْ قِيلَ لَهُمُ اسْكُنُوا هَذِهِ الْقَرْيَةَ وَكُلُوا مِنْهَا حَيْثُ شِئْتُمْ وَقُولُوا حِطَّةٌ وَادْخُلُوا الْبَابَ سُجَّدًا نَغْفِرْ لَكُمْ خَطِيئَاتِكُمْ سَنَزِيدُ الْمُحْسِنِينَ (161)","hl":[[82,185,1]]}},{"id":"ق-0527","fp":"0ba937c2b973","stateId":49,"easy":"الاعتراف بالذنب ← عسى الله أن يتوب عليهم","cause":"الاعتراف بالذنب","result":"عسى الله أن يتوب عليهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة التوبة: 102","srcLabel":"القرآن الكريم","quran":{"s":9,"from":102,"to":102,"text":"وَآخَرُونَ اعْتَرَفُوا بِذُنُوبِهِمْ خَلَطُوا عَمَلًا صَالِحًا وَآخَرَ سَيِّئًا عَسَى اللَّهُ أَنْ يَتُوبَ عَلَيْهِمْ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ (102)","hl":[[0,147,1]]}},{"id":"ق-0529","fp":"de3bd9e47395","stateId":49,"easy":"التوبة والصدقة ← قبول الله لهما","cause":"التوبة والصدقة","result":"قبول الله لهما","explicit":true,"otherNeedIds":[44],"ref":"سورة التوبة: 104","srcLabel":"القرآن الكريم","quran":{"s":9,"from":104,"to":104,"text":"أَلَمْ يَعْلَمُوا أَنَّ اللَّهَ هُوَ يَقْبَلُ التَّوْبَةَ عَنْ عِبَادِهِ وَيَأْخُذُ الصَّدَقَاتِ وَأَنَّ اللَّهَ هُوَ التَّوَّابُ الرَّحِيمُ (104)","hl":[[0,140,1]]}},{"id":"ق-0688","fp":"537629a9b39f","stateId":49,"easy":"التوبة والإصلاح بعد السوء بجهالة ← مغفرة الله ورحمته","cause":"التوبة والإصلاح بعد السوء بجهالة","result":"مغفرة الله ورحمته","explicit":true,"repOf":"ق-0358","ref":"سورة النحل: 119","quran":{"s":16,"from":119,"to":119,"text":"ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ عَمِلُوا السُّوءَ بِجَهَالَةٍ ثُمَّ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ (119)","hl":[[20,153,1]]}},{"id":"ق-0704","fp":"c763fb673dcb","stateId":49,"easy":"الصلاح والأوبة إلى الله ← مغفرة الله","cause":"الصلاح والأوبة إلى الله","result":"مغفرة الله","explicit":true,"ref":"سورة الإسراء: 25","srcLabel":"القرآن الكريم","quran":{"s":17,"from":25,"to":25,"text":"رَبُّكُمْ أَعْلَمُ بِمَا فِي نُفُوسِكُمْ إِنْ تَكُونُوا صَالِحِينَ فَإِنَّهُ كَانَ لِلْأَوَّابِينَ غَفُورًا (25)","hl":[[41,107,1]]}},{"id":"ق-0749","fp":"0636508f0b3c","stateId":49,"easy":"التوبة والإيمان والعمل الصالح ← دخول الجنة بلا ظلم","cause":"التوبة والإيمان والعمل الصالح","result":"دخول الجنة بلا ظلم","explicit":true,"otherNeedIds":[55],"ref":"سورة مريم: 60","srcLabel":"القرآن الكريم","quran":{"s":19,"from":60,"to":60,"text":"إِلَّا مَنْ تَابَ وَآمَنَ وَعَمِلَ صَالِحًا فَأُولَئِكَ يَدْخُلُونَ الْجَنَّةَ وَلَا يُظْلَمُونَ شَيْئًا (60)","hl":[[0,104,1]]}},{"id":"ق-0772","fp":"f5b134de006a","stateId":49,"easy":"التوبة والإيمان والعمل الصالح ثم الاهتداء ← مغفرة الله","cause":"التوبة والإيمان والعمل الصالح ثم الاهتداء","result":"مغفرة الله","explicit":true,"ref":"سورة طه: 82","srcLabel":"القرآن الكريم","quran":{"s":20,"from":82,"to":82,"text":"وَإِنِّي لَغَفَّارٌ لِمَنْ تَابَ وَآمَنَ وَعَمِلَ صَالِحًا ثُمَّ اهْتَدَى (82)","hl":[[0,73,1]]}},{"id":"ق-0777","fp":"802a0bac73cd","stateId":49,"easy":"التوبة بعد المعصية ← الاجتباء والتوبة والهداية","cause":"التوبة بعد المعصية","result":"الاجتباء والتوبة والهداية","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[13],"ref":"سورة طه: 122","srcLabel":"القرآن الكريم","quran":{"s":20,"from":122,"to":122,"text":"ثُمَّ اجْتَبَاهُ رَبُّهُ فَتَابَ عَلَيْهِ وَهَدَى (122)","hl":[[0,49,1]]}},{"id":"ق-0848","fp":"41f356db1772","stateId":49,"easy":"التوبة والإصلاح ← مغفرة الله ورحمته","cause":"التوبة والإصلاح","result":"مغفرة الله ورحمته","explicit":true,"repOf":"ق-0055","ref":"سورة النور: 5","quran":{"s":24,"from":5,"to":5,"text":"إِلَّا الَّذِينَ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ (5)","hl":[[7,88,1]]}},{"id":"ق-0883","fp":"1e5a4240a83a","stateId":49,"easy":"التوبة والإيمان والعمل الصالح ← تبديل السيئات حسنات","cause":"التوبة والإيمان والعمل الصالح","result":"تبديل السيئات حسنات","explicit":true,"ref":"سورة الفرقان: 70","srcLabel":"القرآن الكريم","quran":{"s":25,"from":70,"to":70,"text":"إِلَّا مَنْ تَابَ وَآمَنَ وَعَمِلَ عَمَلًا صَالِحًا فَأُولَئِكَ يُبَدِّلُ اللَّهُ سَيِّئَاتِهِمْ حَسَنَاتٍ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا (70)","hl":[[0,140,1]]}},{"id":"ق-0884","fp":"4882d399424b","stateId":49,"easy":"التوبة والعمل الصالح ← متاب مقبول إلى الله","cause":"التوبة والعمل الصالح","result":"متاب مقبول إلى الله","explicit":true,"ref":"سورة الفرقان: 71","srcLabel":"القرآن الكريم","quran":{"s":25,"from":71,"to":71,"text":"وَمَنْ تَابَ وَعَمِلَ صَالِحًا فَإِنَّهُ يَتُوبُ إِلَى اللَّهِ مَتَابًا (71)","hl":[[0,71,1]]}},{"id":"ق-0899","fp":"e4b8cdae99ae","stateId":49,"easy":"تبديل الحسن بعد السوء (التوبة) ← مغفرة الله ورحمته","cause":"تبديل الحسن بعد السوء (التوبة)","result":"مغفرة الله ورحمته","explicit":true,"ref":"سورة النمل: 11","srcLabel":"القرآن الكريم","quran":{"s":27,"from":11,"to":11,"text":"إِلَّا مَنْ ظَلَمَ ثُمَّ بَدَّلَ حُسْنًا بَعْدَ سُوءٍ فَإِنِّي غَفُورٌ رَحِيمٌ (11)","hl":[[0,78,1]]}},{"id":"ق-0915","fp":"7b07cea51bfd","stateId":49,"easy":"الاعتراف بالذنب والاستغفار ← المغفرة","cause":"الاعتراف بالذنب والاستغفار","result":"المغفرة","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"سورة القصص: 16","srcLabel":"القرآن الكريم","quran":{"s":28,"from":16,"to":16,"text":"قَالَ رَبِّ إِنِّي ظَلَمْتُ نَفْسِي فَاغْفِرْ لِي فَغَفَرَ لَهُ إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ (16)","hl":[[0,63,1]]}},{"id":"ق-1060","fp":"dca81e99c094","stateId":49,"easy":"الاستغفار والركوع والإنابة ← المغفرة والزلفى وحسن المآب","cause":"الاستغفار والركوع والإنابة","result":"المغفرة والزلفى وحسن المآب","explicit":true,"otherNeedIds":[25],"ref":"سورة ص: 24–25","srcLabel":"القرآن الكريم","quran":{"s":38,"from":24,"to":25,"text":"قَالَ لَقَدْ ظَلَمَكَ بِسُؤَالِ نَعْجَتِكَ إِلَى نِعَاجِهِ وَإِنَّ كَثِيرًا مِنَ الْخُلَطَاءِ لَيَبْغِي بَعْضُهُمْ عَلَى بَعْضٍ إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَقَلِيلٌ مَا هُمْ وَظَنَّ دَاوُودُ أَنَّمَا فَتَنَّاهُ فَاسْتَغْفَرَ رَبَّهُ وَخَرَّ رَاكِعًا وَأَنَابَ (24) فَغَفَرْنَا لَهُ ذَلِكَ وَإِنَّ لَهُ عِنْدَنَا لَزُلْفَى وَحُسْنَ مَآبٍ (25)","hl":[[197,359,1]]}},{"id":"ق-1094","fp":"6fecfdd65bb9","stateId":49,"easy":"ترك القنوط والإنابة إلى الله والإسلام له ← مغفرة الذنوب جميعاً","cause":"ترك القنوط والإنابة إلى الله والإسلام له","result":"مغفرة الذنوب جميعاً","explicit":true,"ref":"سورة الزمر: 53–54","srcLabel":"القرآن الكريم","quran":{"s":39,"from":53,"to":54,"text":"قُلْ يَا عِبَادِيَ الَّذِينَ أَسْرَفُوا عَلَى أَنْفُسِهِمْ لَا تَقْنَطُوا مِنْ رَحْمَةِ اللَّهِ إِنَّ اللَّهَ يَغْفِرُ الذُّنُوبَ جَمِيعًا إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ (53) وَأَنِيبُوا إِلَى رَبِّكُمْ وَأَسْلِمُوا لَهُ مِنْ قَبْلِ أَنْ يَأْتِيَكُمُ الْعَذَابُ ثُمَّ لَا تُنْصَرُونَ (54)","hl":[[0,287,1]]}},{"id":"ق-1103","fp":"d72aa520f512","stateId":49,"easy":"الإيمان والتوبة واتباع سبيل الله ← استغفار حملة العرش ودعاؤهم بالوقاية والجنة مع الصالحين من الأهل","cause":"الإيمان والتوبة واتباع سبيل الله","result":"استغفار حملة العرش ودعاؤهم بالوقاية والجنة مع الصالحين من الأهل","explicit":true,"otherNeedIds":[54,55,35],"ref":"سورة غافر: 7–9","srcLabel":"القرآن الكريم","quran":{"s":40,"from":7,"to":9,"text":"الَّذِينَ يَحْمِلُونَ الْعَرْشَ وَمَنْ حَوْلَهُ يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ وَيُؤْمِنُونَ بِهِ وَيَسْتَغْفِرُونَ لِلَّذِينَ آمَنُوا رَبَّنَا وَسِعْتَ كُلَّ شَيْءٍ رَحْمَةً وَعِلْمًا فَاغْفِرْ لِلَّذِينَ تَابُوا وَاتَّبَعُوا سَبِيلَكَ وَقِهِمْ عَذَابَ الْجَحِيمِ (7) رَبَّنَا وَأَدْخِلْهُمْ جَنَّاتِ عَدْنٍ الَّتِي وَعَدْتَهُمْ وَمَنْ صَلَحَ مِنْ آبَائِهِمْ وَأَزْوَاجِهِمْ وَذُرِّيَّاتِهِمْ إِنَّكَ أَنْتَ الْعَزِيزُ الْحَكِيمُ (8) وَقِهِمُ السَّيِّئَاتِ وَمَنْ تَقِ السَّيِّئَاتِ يَوْمَئِذٍ فَقَدْ رَحِمْتَهُ وَذَلِكَ هُوَ الْفَوْزُ الْعَظِيمُ (9)","hl":[[0,548,1]]}},{"id":"ق-1153","fp":"e960e01bf687","stateId":49,"easy":"التوبة ← قبولها والعفو عن السيئات","cause":"التوبة","result":"قبولها والعفو عن السيئات","explicit":true,"ref":"سورة الشورى: 25","srcLabel":"القرآن الكريم","quran":{"s":42,"from":25,"to":25,"text":"وَهُوَ الَّذِي يَقْبَلُ التَّوْبَةَ عَنْ عِبَادِهِ وَيَعْفُو عَنِ السَّيِّئَاتِ وَيَعْلَمُ مَا تَفْعَلُونَ (25)","hl":[[0,79,1]]}},{"id":"ق-1357","fp":"f43f9a4ac587","stateId":49,"easy":"التوبة النصوح ← تكفير السيئات ودخول الجنات والنور يوم القيامة","cause":"التوبة النصوح","result":"تكفير السيئات ودخول الجنات والنور يوم القيامة","explicit":true,"otherNeedIds":[55,53],"ref":"سورة التحريم: 8","srcLabel":"القرآن الكريم","quran":{"s":66,"from":8,"to":8,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا تُوبُوا إِلَى اللَّهِ تَوْبَةً نَصُوحًا عَسَى رَبُّكُمْ أَنْ يُكَفِّرَ عَنْكُمْ سَيِّئَاتِكُمْ وَيُدْخِلَكُمْ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ يَوْمَ لَا يُخْزِي اللَّهُ النَّبِيَّ وَالَّذِينَ آمَنُوا مَعَهُ نُورُهُمْ يَسْعَى بَيْنَ أَيْدِيهِمْ وَبِأَيْمَانِهِمْ يَقُولُونَ رَبَّنَا أَتْمِمْ لَنَا نُورَنَا وَاغْفِرْ لَنَا إِنَّكَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ (8)","hl":[[31,400,1]]}},{"id":"ق-1393","fp":"d11a37e1d847","stateId":49,"easy":"الاستغفار ← مغفرة الله ورحمته","cause":"الاستغفار","result":"مغفرة الله ورحمته","explicit":true,"ref":"سورة المزمل: 20","srcLabel":"القرآن الكريم","quran":{"s":73,"from":20,"to":20,"text":"إِنَّ رَبَّكَ يَعْلَمُ أَنَّكَ تَقُومُ أَدْنَى مِنْ ثُلُثَيِ اللَّيْلِ وَنِصْفَهُ وَثُلُثَهُ وَطَائِفَةٌ مِنَ الَّذِينَ مَعَكَ وَاللَّهُ يُقَدِّرُ اللَّيْلَ وَالنَّهَارَ عَلِمَ أَنْ لَنْ تُحْصُوهُ فَتَابَ عَلَيْكُمْ فَاقْرَءُوا مَا تَيَسَّرَ مِنَ الْقُرْآنِ عَلِمَ أَنْ سَيَكُونُ مِنْكُمْ مَرْضَى وَآخَرُونَ يَضْرِبُونَ فِي الْأَرْضِ يَبْتَغُونَ مِنْ فَضْلِ اللَّهِ وَآخَرُونَ يُقَاتِلُونَ فِي سَبِيلِ اللَّهِ فَاقْرَءُوا مَا تَيَسَّرَ مِنْهُ وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ وَأَقْرِضُوا اللَّهَ قَرْضًا حَسَنًا وَمَا تُقَدِّمُوا لِأَنْفُسِكُمْ مِنْ خَيْرٍ تَجِدُوهُ عِنْدَ اللَّهِ هُوَ خَيْرًا وَأَعْظَمَ أَجْرًا وَاسْتَغْفِرُوا اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ (20)","hl":[[624,677,1]]}},{"id":"س-01981","fp":"78a83eb92e80","stateId":49,"easy":"إذا ندمت على ذنبك ← فالندم توبة","cause":"النَّدمُ","result":"تَوبةٌ","explicit":true,"ref":"تخريج المسند لشعيب 3568","srcLabel":"ابن ماجه","text":["عن عبدِ اللهِ بنِ مَعقِلِ بنِ مُقَرِّنٍ قال: دخَلْتُ مع أبي على عبدِ اللهِ بنِ مَسعودٍ، فقال: أنتَ سمِعْتَ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ يقولُ: \"",["النَّدمُ",1]," ",["تَوبةٌ",2],"\"؟ قال: نعمْ، وقال مرَّةً: سمِعْتُه يقولُ: \"النَّدمُ تَوبةٌ\"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (4252)، وأحمد (3568)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"JacHHtOo","merged":5,"otherRefs":["تخريج المسند لشعيب 4124 (صحيح)","صحيح ابن حبان 613 (صحيح)","المستدرك على الصحيحين 7823 (صحيح)","الأحاديث المختارة 2089 (صحيح)"]},{"id":"س-04012","fp":"ab44264dd875","stateId":49,"easy":"إذا تبت قبل موتك ولو بنصف يوم ← يقبل الله توبتك","cause":"توبةَ العبدِ","result":"إنَّ اللَّهَ يقبلُ توبةَ العبدِ قبلَ أن يموتَ بنصفِ يومٍ","explicit":true,"similar":["س-04004"],"ref":"عمدة التفسير 1/475","srcLabel":"أحمد","text":["اجتمعَ أربعةٌ من أصحابِ النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ ، فقالَ أحدُهُم سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ إنَّ اللَّهَ يقبلُ ",["توبةَ العبدِ",1]," قبلَ أن يموتَ بيومٍ ، فقالَ الآخرُ : أنتَ سمِعتَ هذا من رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ؟ قالَ : نعم . قالَ : وأَنا سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ ",["إنَّ اللَّهَ يقبلُ توبةَ العبدِ قبلَ أن يموتَ بنصفِ يومٍ ،",2]," فقالَ الثَّالثُ : أنتَ سمِعتَ هذا من رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ؟ قالَ : نعم . قالَ : وأَنا سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقول إنَّ اللَّهَ يقبلُ توبةَ العبدِ قبلَ أن يموتَ بضحوةَ ، قالَ الرَّابعُ : أنتَ سمِعتَ هذا من رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ؟ قالَ : نعم . قالَ : وأَنا سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ إنَّ اللَّهَ يقبلُ توبةَ العبدِ ما لم يُغَرْغِرْ بنفسِهِ"],"grade":"صحيح","narrator":"أربعة من أصحاب النبي صلى الله عليه وسلم","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (15499)، وابن أبي الدنيا في ((التوبة)) (150)، والثعلبي في ((التفسير)) (10/ 139) بلفظه.","bab":"توبة › الحض على التوبة","dorar":"9M71Svu0","merged":5,"otherRefs":["المستدرك على الصحيحين 7868 (صحيح)","عمدة التفسير 1/476 (صحيح)","فتح الباري لابن حجر 11/360 (صحيح)","الأحاديث المختارة 13 / 150 (صحيح)"]},{"id":"س-06976","fp":"d7fa8d9d0261","stateId":49,"easy":"إذا استغفرت الله ← يغفر لك","cause":"فاستَغفِروني","result":"أغفِرْ لكم","explicit":true,"repOf":"س-01803","ref":"تخريج المسند لشعيب 21367","text":["يقولُ اللهُ عزَّ وجلَّ: يا عِبادي، كلُّكم مُذنبٌ إلَّا مَن عافَيْتُ، ",["فاستَغفِروني",1]," ",["أغفِرْ لكم",2],"، ومَن علِمَ أنِّي أقدِرُ على المَغفِرةِ، فاستَغفَرَني بقُدْرَتي غفَرْتُ له ولا أُبالي، وكلُّكم ضالٌّ إلَّا مَن هدَيْتُ، فاسْتَهْدوني أَهْدِكم، وكلُّكم فَقيرٌ إلَّا مَن أغنَيْتُ، فاسْأَلوني أُغْنِكم، ولو أنَّ أوَّلَكم وآخِرَكم، وحَيَّكم وميِّتَكم، ورَطْبَكم ويابِسَكم، اجْتَمَعوا على أَشْقى قَلبٍ من قُلوبِ عِبادي، ما نقَصَ في مُلْكي جَناحَ بَعوضةٍ، ولوِ اجْتَمَعوا على أَتْقى قَلبِ عبدٍ من عِبادي، ما زادَ في مُلْكي جَناحَ بَعوضةٍ، ولو أنَّ أوَّلَكم وآخِرَكم، وحَيَّكم وميِّتَكم، ورَطْبَكم ويابِسَكم اجْتَمَعوا فسأَلَني كلُّ سائلٍ منهم ما بلَغَتْ أُمنِيَّتُه، فأَعْطيْتُ كلَّ سائلٍ منهم ما سأَلَ ما نَقَصَني، كما لو أنَّ أحَدَكم مَرَّ بشَفَةِ البَحرِ، فغمَسَ فيه إبرةً، ثُم انتَزَعها، كذلك لا يَنقُصُ من مُلْكي؛ ذلك بأنِّي جَوادٌ ماجدٌ صَمَدٌ، عَطائي كلامٌ، وعَذابي كلامٌ، إذا أرَدْتُ شيئًا فإنَّما أقولُ له: كُنْ، فيكونُ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (4257)، وأحمد (21367) واللفظ له","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"QBOFJGqb","merged":4,"otherRefs":["تخريج المسند لشعيب 21540 (صحيح)","حلية الأولياء 5/144 (صحيح)","الأسماء والصفات للبيهقي 1/211 (صحيح)"]},{"id":"س-03455","fp":"9608e174076c","stateId":49,"easy":"إذا ألممت بذنب فاستغفري الله وتوبي ← فالتوبة الندم والاستغفار","cause":"فاستغفِري اللهَ","result":"فإنَّ التَّوبةَ مِنَ الذَّنبِ النَّدامةُ والاستغفارُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 10/201","srcLabel":"متفق عليه","text":["قال لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّم يا عائشةُ إنْ كنتِ ألمَمْتِ بذنبٍ ",["فاستغفِري اللهَ",1]," ",["فإنَّ التَّوبةَ مِنَ الذَّنبِ النَّدامةُ والاستغفارُ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"رجاله رجال الصحيح غير محمد بن يزيد الواسطي وهو ثقة","takhrij":"أخرجه أحمد (26279)، واللفظ له، والبخاري (4670)، باختلاف يسير، ومسلم (2770)، مطولا.","bab":"استغفار › فضل الاستغفار","dorar":"qDXSwZsQ"},{"id":"س-07730","fp":"0e0b0db127a3","stateId":49,"easy":"إذا ألممت بذنب فتوبي إلى الله واستغفريه ← يتوب الله عليك","cause":"فتوبي إلى اللهِ واستَغْفِريه","result":"إنَّما أنتِ مِن بناتِ آدمَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 9/235","srcLabel":"متفق عليه","text":["كان النَّبيُّ صلَّى اللهُ عليه وسلَّم إذا أراد أن يُسافِرَ أقرَع بينَ نسائِه فأيَّتُهنَّ خرَج سهمُها خرَج بها معه فخرَج سهمُ عائشةَ في غزوةِ النَّبيِّ صلَّى اللهُ عليه وسلَّم بني المُصْطَلِقِ مِن خُزاعةَ فلمَّا انصرَف رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فكان قريبًا مِنَ المدينةِ وكانت عائشةُ جُوَيريَةً حديثةَ السِّنِّ قليلةَ اللَّحمِ خفيفةً وكانت تلزَمُ خِدرَها فإذا أراد النَّاسُ الرَّحيلَ ذهَبَتْ ثمَّ رجَعَتْ فدخَلَتْ مِحَفَّتَها فيُرَحَّلُ بعيرُها ثمَّ تُحْمَلُ مِحَفَّتُها فتوضَعُ على البَعيرِ فكان أوَّلَ ما قال فيها المنافقون وغيرُهم ممَّنِ اشترَك في أمرِ عائشةَ إنَّها خرجَتْ تتوضَّأُ حينَ دنَوا مِنَ المدينةِ فانسَلَّ مِن عُنُقِها عِقْدٌ لها مِن جَزْعِ أظْفَارٍ فارتحَل رسولُ اللهِ صلَّى اللهُ عليه وسلَّم والنَّاسُ وهي في بُغاءِ العِقدِ ولم تعلَمْ برحيلِهم فشدُّوا على بعيرِها المِحَفَّةَ وهم يُرَوْنَ أنَّها فيها كما كانت تكونُ فرجَعَتْ عائشةُ إلى منزلِها فلم تجِدْ في العَسْكَرِ أحدًا فغلَبَتْها عيناها وكان صَفْوانُ بنُ المُعَطَّلِ السُّلَمِيُّ صاحبُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم تخلَّف تلك اللَّيلةَ عَنِ العَسْكَرِ حتَّى أصبَح قالت فمرَّ بي فرآني فاسترجَع وأعظَمَ مكاني حينَ رآني وقد كنْتُ أعرِفُه ويعرِفُني قبلَ أن يُضرَبَ علينا الحِجابُ قالت فسألني عن أمري فستَرْتُ وجهي عنه بجِلْبابي وأخبَرْتُه بأمري فقرَّب بعيرَه فوَطِئَ على ذِراعِه فولَّاني قفاه حتَّى رَكِبْتُ وسوَّيْتُ ثيابي ثمَّ بعَثَه فأقبَل يسيرُ بي حتَّى دخَلْنا المدينةَ نِصفَ النَّهارِ أو نحوَه فهنالك قال فيَّ وفيه مَن قال مِن أهلِ الإفكِ وأنا لا أعلَمُ شيئًا مِن ذلك ولا ممَّا يخوضُ النَّاسُ فيه مِن أمري وكنْتُ تلك اللَّياليَ شاكيةً وكان أوَّلَ ما أنكَرْتُ مِن أمرِ النَّبيِّ صلَّى اللهُ عليه وسلَّم أنَّه كان يعودُني قبلَ ذلك إذا مرِضْتُ وكان تلك اللَّياليَ لا يدخُلُ عليَّ ولا يعودُني إلَّا أنَّه كان يقولُ وهو مارٌّ كيف تِيكُمْ فيسألُ عنِّي أهلَ البيتِ فلمَّا بلَغ النَّبيَّ صلَّى اللهُ عليه وسلَّم ما أكثَرَ النَّاسُ فيه مِن أمري غمَّه ذلك وقد شكَوْتُ قَبلَ ذلك إلى أمِّي ما رأيْتُ مِنَ النَّبيِّ صلَّى اللهُ عليه وسلَّم مِن الجَفْوةِ فقالت لي يا بُنَيَّةُ اصبِري فواللهِ ما كانتِ امرأةٌ حَسْناءُ لها ضرائرُ إلَّا رمَيْنها قالت فوجَدْتُ حِسًّا تلك اللَّيلةَ الَّتي بعَث النَّبيُّ صلَّى اللهُ عليه وسلَّم مِن صُبحِها إلى عليِّ بنِ أبي طالبٍ وأسامةَ بنِ زيدٍ يستشيرُهما في أمري وكنَّا ذلك الزَّمانَ ليس لنا كُنُفٌ نذهَبُ فيها إنَّما كنَّا نذهَبُ كما يذهَبُ العربُ ليلًا إلى ليلٍ فقلْتُ لأمِّ مِسْطَحِ بنِ أُثاثةَ خُذي الإداوةَ فامْلَئيها ماءً فاذهَبي بها إلى المَناصِعِ وكانت هي وابنُها مِسْطَحٌ بينَهما وبينَ أبي بكرٍ قَرابةٌ وكان أبو بكرٍ يُنفِقُ عليهما فكانا يكونان عندَه ومع أهلِه فأخَذَتِ الإداوةَ وخرَجَتْ نحوَ المَناصِعِ فعثَرَتْ أمُّ مِسْطَحٍ فقالت تعِسَ مِسْطَحٌ فقلْتُ بئسَ ما قلْتِ قالت ثمَّ مشَيْنا فعثَرَتْ أيضًا فقالت تعِسَ مِسْطَحٌ فقلْتُ لها بئسَ ما قلْتِ لصاحبِ النَّبيِّ صلَّى اللهُ عليه وسلَّم وصاحبِ بَدْرٍ فقالت إنَّكِ لَغافلةٌ عمَّا فيه النَّاسُ مِن أمرِك فقلْتُ أجَلْ فما ذاك فقالت إنَّ مِسْطَحًا وفلانًا وفُلانةً فيمن استَزَلَّهُمُ الشَّيطانُ مِنَ المنافقين يجتمِعون في بيتِ عبدِ اللهِ بنِ أُبَيِّ بنِ سَلولٍ أخي بني الحارثِ بنِ الخزرجِ يتحدَّثون عنكِ وعن صَفْوانَ بنِ المُعَطَّلِ يَرْمونكِ به قالت فذهَب عنِّي ما كنْتُ أجِدُ مِنَ الغائطِ فرَجَعْتُ على يدَيَّ فلمَّا أصبَحْنا مِن تلك اللَّيلةِ بعَث النَّبيُّ صلَّى اللهُ عليه وسلَّم إلى عليِّ بنِ أبي طالبٍ وأسامةَ بنِ زيدٍ فأخبرَهما بما قيل فيَّ واستشارَهما في أمري فقال أسامةُ واللهِ يا رسولَ اللهِ ما علِمْنا على أهلِك سوءًا وقال عليٌّ له يا رسولَ اللهِ ما أكثَرَ النِّساءَ وإنْ أرَدْتَ أن تعلَمَ الخبرَ فتوعَّدِ الجاريةَ يعني بَريرةَ فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم لعليٍّ فشأنُك بالخادمِ فسَأَلَها عليٌّ عنِّي فلم تُخْبِرْه والحمدُ للهِ إلَّا بخيرٍ قالت واللهِ ما عَلِمْتُ على عائشةَ سوءًا إلَّا أنَّها جُوَيريَةٌ تُصبِحُ عن عجينِ أهلِها فتدخُلُ الشَّاةُ الدَّاجِنُ فتأكُلُ مِنَ العجينِ قالت ثمَّ خرَج النَّبيُّ صلَّى اللهُ عليه وسلَّم حينَ سمِعَ ما قالت بَريرةُ لِعَليٍّ إلى النَّاسِ فلمَّا اجتمَعوا إليه قال يا معشرَ المسلمين مَن لي مِن رجالٍ يُؤذونَني في أهلي فما علِمْتُ على أهلي سوءًا ويَرْمون رجُلًا مِن أصحابي ما علِمْتُ عليه سوءًا ولا خرَجْتُ مَخْرجًا إلَّا خرَج معي فيه قال سعدُ بنُ معاذٍ الأنصاريُّ الأشْهَلِيُّ مِنَ الأوسِ يا رسولَ اللهِ إنْ كان ذلك مِن أحَدٍ مِنَ الأوسِ كَفَيْنَاكَهُ وإنْ كان مِنَ الخزرجِ أمَرْتَنا فيه بأمرِك وقام سعدُ بنُ عُبادةَ الأنصاريُّ ثمَّ الخَزْرَجِيُّ فقال لسعدِ بنِ معاذٍ كذَبْتَ واللهِ وهذا الباطلُ فقام أُسَيدُ بنُ حُضَيرٍ الأنصاريُّ ثمَّ الأشْهَلِيُّ ورجالٌ مِنَ الفريقين فاستبُّوا وتنازَعوا حتَّى كاد أن يعظُمَ الأمرُ بينَهم فدخَل النَّبيُّ صلَّى اللهُ عليه وسلَّم بيتي وبعَث إلى أبويَّ فأتَياه فحمِد اللهَ وأثنى عليه بما هو أهلُه ثمَّ قال لي يا عائشةُ ",["إنَّما أنتِ مِن بناتِ آدمَ",2]," فإنْ كنْتِ أخطأْتِ ",["فتوبي إلى اللهِ واستَغْفِريه",1]," فقلْتُ لأبي أجِبْ عنِّي رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فقال لا أفعَلُ هو نبيُّ اللهِ والوحيُ يأتيه فقلْتُ لأمِّي أجيبي عنِّي رسولَ اللهِ صلَّى اللهُ عليه وسلَّم فقالت لي كما قال أبي فقلْتُ واللهِ لئن أقْرَرْتُ على نفسي بباطلٍ لتُصَدِّقُنَّني ولئن برَّأْتُ نفسي واللهُ يعلَمُ أنِّي بريئةٌ لتُكَذِّبُنَّني فما أجِدُ لي ولكم مَثَلًا إلَّا قولَ أبي يوسفَ { فَصَبْرٌ جَمِيلٌ وَاللهُ المُسْتَعانُ عَلَى مَا تَصِفُونَ } ونَسيتُ اسمَ يعقوبَ لِما بي مِنَ الحُزنِ والبُكاءِ واحتراقِ الجوفِ فتغشَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ما كان يتغشَّاه مِنَ الوحيِ ثمَّ سُرِّيَ عنه فمسَح وجهَه بيدِه ثمَّ قال أبْشِري يا عائشةُ قد أنزَل اللهُ عزَّ وجلَّ براءتَك فقالت عائشةُ واللهِ ما كنْتُ أظُنُّ أن ينزِلَ القرآنُ في أمري ولكنِّي كنْتُ أرجو لِما يعلَمُ اللهُ مِن براءتي أن يرى النَّبيُّ صلَّى اللهُ عليه وسلَّم في أمري رؤيا فيُبَرِّئَني اللهُ بها عندَ نبيِّه صلَّى اللهُ عليه وسلَّم فقال لي أبوايَ عندَ ذلك قومي فقبِّلي رأسَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقلْتُ واللهِ لا أفعَلُ بحمدِ اللهِ لا بحَمْدِكم قال وكان أبو بكرٍ يُنفِقُ على مِسْطَحٍ وأمِّه فلمَّا رماني حلَف أبو بكرٍ أن لا ينفَعَه بشيءٍ أبدًا قال فلمَّا تلا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم { وَلْيَعْفُوا وَلْيَصْفَحُوا أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللهُ لَكُمْ } بكى أبو بكرٍ قال بلى يا ربِّ وأعاد النَّفقةَ على مِسْطَحٍ وأمِّه قالت وقعَد صَفْوانُ بنُ المُعَطَّلِ لحسَّانَ بنِ ثابتٍ بالسَّيفِ فضرَبه ضربةً فقال صَفْوانُ لحسَّانَ حينَ ضرَبَه تَلَقَّ ذُبَابَ السَّيْفِ عَنْكَ فَإِنَّنِي ... غُلَامٌ إِذَا هُوجِيتُ لَسْتُ بِشَاعِرِ\nوَلَكِنَّنِي أَحْمِي حِمَايَ وأَنْتَقِمْ ... مِنَ الْبَاهِتِ الرَّامِي الْبُرَاةِ الطَّوَاهِرِ. ثمَّ صاح حسَّانُ فاستغاث النَّاسُ على صَفْوانَ فلمَّا جاء النَّاسُ فرَّ صَفْوانُ فجاء حسَّانُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم فاستَعْداه على صَفْوانَ في ضَرْبتِه إيَّاه فسألَه النَّبيُّ صلَّى اللهُ عليه وسلَّم أن يهَبَ له ضربةَ صَفْوانَ إيَّاه فوهَبها للنَّبيِّ صلَّى اللهُ عليه وسلَّم فعاوَضَه النَّبيُّ صلَّى اللهُ عليه وسلَّم حائطًا مِن نخلٍ عظيمٍ وجاريةٍ روميَّةٍ ويُقالُ قِبطيَّةٌ تُدعى سِيرينَ فولَدَتْ لحسَّانَ ابنَه عبدَ الرَّحمنِ الشَّاعرَ قال أبو أُوَيسٍ أخبَرَني بذلك حُسَينُ بنُ عبدِ اللهِ بنِ عُبيدِ اللهِ بنِ عبَّاسٍ عَن عِكرمةَ عنِ ابنِ عبَّاسٍ قالت عائشةُ ثمَّ باع حسَّانُ ذلك الحائطَ مِن معاويةَ بنِ أبي سفيانَ في ولايتِه بمالٍ عظيمٍ قالت عائشةُ رضِيَ اللهُ عنها وبلَغَني واللهِ أعلمُ أنَّ الَّذي قال اللهُ فيه { والَّذِي تَوَلَّى كِبْرَهُ مِنْهُمْ لَهُ عَذَابٌ عَظِيمٌ } أنَّه عبدُ اللهِ بنُ أُبَيِّ بنِ سَلولٍ أحدُ بني الحارثِ بن ِالخزرجِ قالت عائشةُ فقيل في أصحابِ الإفكِ الأشعارُ وقال أبو بكرٍ في مِسْطَحٍ في رَمْيِه عائشةَ فكان يُدعى عَوفًا يَا عَوْفُ وَيْحَكَ هَلَّا قُلْتَ عَارِفَةً ... مِنَ الْكَلَامِ وَلَمْ تَبْغِي بِهِ طَمَعَا\nفَأَدْرَكَتْكَ حُمَيَّا مَعْشَرٍ أُنُفٍ ... فَلَمْ يَكُنْ قَاطِعًا يَا عَوْفُ مَنْ قَطَعَا\nهَلَّا حَرِبْتَ مِنَ الْأَقْوَامِ إِذْ حَسَدُوا ... فَلَا تَقُولُ وَإِنْ عَادَيْتَهُمْ قَذَعَا\nلَمَّا رَمَيْتَ حَصَانًا غَيْرَ مُقْرِفَةٍ ... أَمِينَةَ الْجَيْبِ لَمْ نَعْلَمْ لَهَا خَضَعَا\nفِيمَنْ رَمَاهَا وَكُنْتُمْ مَعْشَرًا أُفُكًا ... فِي سَيِّئِ الْقَوْلِ مِنْ لَفْظِ الْخَنَا شَرَعَا\nفَأَنْزَلَ اللَّهُ عُذْرًا فِي بَرَاءَتِهَا ... وَبَيْنَ عَوْفٍ وَبَيْنَ اللَّهِ مَا صَنَعَا\nفَإِنْ أَعِشْ أَجْزِ عَوْفًا فِي مَقَالَتِهِ ... سُوءَ الْجَزَاءِ بِمَا أَلْفَيْتُهُ تَبَعَا. وقالَت أمُّ سعدِ بنِ معاذٍ في الَّذين رمَوا عائشةَ مِنَ الشِّعرِ تَشْهَدُ الْأَوْسُ كُلُّهَا وَفَتَاهَا ... بِحِقْدٍ وَذَلِكَ مَعْلُومُ\nنِسَاءُ الْخَزْرَجِيِّينَ يَشْهَدْنَ ... وَالْخُمَاسِيُّ مِنْ نَسْلِهَا وَالْعَظِيمُ\nأَنَّ بِنْتَ الصِّدِّيقِ كَانَتْ حَصَانًا ... عَفَّةَ الْجَيْبِ دِينُهَا مُسْتَقِيمُ\nتَتَّقِي اللَّهَ فِي الْمَغِيبِ عَلَيْهَا ... نِعْمَةُ اللَّهِ سِرُّهَا مَا يَرِيمُ\nخَيْرُ هَدْيِ النِّسَاءِ حَالًا وَنَفْسًا ... وَأَبًا لِلْعُلَا نَمَاهَا كَرِيمُ\nلِلْمَوَالِي إِذَا رَمَوهَا بِإِفْكٍ ... أَخَذَتْهُمْ مَقَامِعٌ وَجَحِيمُ\nلَيْتَ مَنْ كَانَ قَدْ قَفَاهَا بِسُوءٍ ... فِي حُطَامٍ حَتَّى يَبُولَ اللَّئِيمُ\nوَعَوَانٍ مِنَ الْحُرُوبِ تَلَظَّى ... ثَغْسًا قُوتُهَا عَقَارٌ صَرِيمُ\nلَيْتَ سَعْدًا وَمَنْ رَمَاهَا بِسُوءٍ ... فِي كَظَاظٍ حَتَّى يَتُوبَ الظَّلُومُ.\nوقال حسَّانُ وهو يُبَرِّئُ عائشةَ - رَضِيَ اللَّهُ عنها - فيما قيل فيها، ويعتذِرُ إليها:\nحَصَانٌ رَزَانٌ مَا تُزَنُّ بِرِيبَةٍ ... وَتُصْبِحُ غَرْثَى مِنْ لُحُومِ الْغَوَافِلِ\nخَلِيلَةُ خَيْرِ النَّاسِ دِينًا وَمَنْصِبًا ... نَبِيِّ الْهُدَى وَالْمَكْرُمَاتِ الْفَوَاضِلِ\nعَقِيلَةُ حَيٍّ مِنْ لُؤَيِّ بْنِ غَالِبٍ ... كِرَامِ الْمَسَاعِي مَجْدُهَا غَيْرُ زَائِلِ\nمُهَذَّبَةٌ قَدْ طَيَّبَ اللَّهُ خِيَمَهَا ... وَطَهَّرَهَا مِنْ كُلٍّ سُوءٍ وَبَاطِلِ\nفَإِنْ كَانَ مَا قَدْ جَاءَ عَنِّي قُلْتُهُ ... فَلَا رَفَعَتْ صَوْتِي إِلَىَّ أَنَامِلِي\nوَإِنَّ الَّذِي قَدْ قِيلَ لَيْسَ بِلَائِطٍ ... بِكِ الدَّهْرَ بَلْ قَوْلُ امْرِئٍ غَيْرِ هَائِلِ\nوَكَيْفَ وَوُدِّي مَا حَيِيتُ وَنُصْرَتِي ... لِآلِ رَسُولِ اللَّهِ زَيْنِ الْمَحَافِلِ\nلَهُ رَتْبٌ عَالٍ عَلَى النَّاسِ فَضْلُهَا ... تَقَاصَرُ عَنْهَا سَوْرَةُ الْمُتَطَاوِلِ.قال أبو يونسَ وحدَّثَني أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم أمَر بالَّذين رمَوا عائشةَ فجُلِدوا الحدَّ ثمانين وقال حسَّانُ بنُ ثابتٍ في الشِّعرِ حين جُلِدوا لَقَدْ ذَاقَ عَبْدُ اللَّهِ مَا كَانَ أَهْلَهُ ... وَحَمْنَةُ إِذْ قَالُوا هَجِيرًا وَمِسْطَحُ\nتَعَاطَوْا بِرَجْمِ الْغَيْبِ زَوْجَ نَبِيِّهِمْ ... وَسَخْطَةَ ذِي الْعَرْشِ الْكَرِيمِ فَأَنْزَحُوا\nفَآذَوْا رَسُولَ اللَّهِ فِيهَا وَعَمَّمُوا ... مَخَازِيَ سُوءٍ حَلَّلُوهَا وَفُضِّحُوا"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"رجاله رجال الصحيح إلا أن بعض هذا يخالف ما في الصحيح","takhrij":"أخرجه الطبراني (23/111) (151) واللفظ له، وأخرجه البخاري (4141)، ومسلم (2770) بلفظ مقارب","bab":"قرآن › أسباب النزول","dorar":"IoBb5HZx"},{"id":"س-00001","fp":"1bf1125a68e3","stateId":49,"easy":"إذا استغفرت أو تبت في وقت النزول الإلهي ← يُغفر لك ويُتاب عليك","cause":"هل مِن مُستغفرٍ","result":"يُغفَرُ لهُ هَل من تائبٍ يُتابُ عليهِ","explicit":true,"repOf":"س-06824","ref":"الزواجر عن اقتراف الكبائر 1/198","text":["إذا كانَ أوَّلُ ليلةٍ مِن شهرِ رمضانَ فُتِحَت أبوابُ الجِنانِ فلَم يُغلَق منها بابٌ واحدٌ الشَّهرَ كلَّهُ ، وغُلِّقَت أبوابُ النَّارِ فلم يُفتَح منها بابٌ واحدٌ الشَّهرَ كلَّهُ وغُلَّت عُتاةُ الجنِّ وَنادَى مُنادٍ منَ السَّماءِ كلَّ ليلةٍ إلى انفِجارِ الصُّبحِ يا باغيَ الخَيرِ تَمِّم وأبشِر ويا باغيَ الشَّرِّ أقصِر وأبصِر ",["هل مِن مُستغفرٍ",1]," ",["يُغفَرُ لهُ هَل من تائبٍ يُتابُ عليهِ",2]," هل من داعٍ يُستَجابُ لهُ هل مِن سائلٍ يُعطَى سؤلَهُ وللَّهِ عزَّ وجلَّ عندَ كلِّ فطرٍ مِن شهرِ رمضانَ كلَّ لَيلةٍ عتقاءُ منَ النَّارِ ستُّونَ ألفًا فإذا كانَ يومُ الفطرِ أعتقَ اللَّهُ مثلَ ما أعتقَ في جميعِ الشَّهرِ ثَلاثينَ مرَّةً ستِّينَ ألفًا"],"grade":"صحيح","muhaddith":"صحيح أو حسن","bab":"آداب الدعاء › استجابة الدعاء","dorar":"sHjgh6Tp","merged":3,"otherRefs":["المتجر الرابح 142 (حسن)","تخريج كتاب السنة 513 (صحيح)"]},{"id":"س-04016","fp":"4a4437efb588","stateId":49,"easy":"إذا تبت ← فالتوبة مقبولة حتى تطلع الشمس من المغرب","cause":"التَّوبةُ","result":"ولا تزالُ التَّوبةُ مقبولةً حتَّى تطلُعَ الشَّمسُ منَ المغرِبِ","explicit":true,"similar":["س-03971"],"ref":"تخريج المسند لشاكر 3/133","srcLabel":"النسائي","text":["لا تنقَطعُ الهِجرةُ ما دامَ العدوُّ يقاتلُ فقالَ مُعاويةُ ، وعبدُ الرَّحمنِ بنُ عوفٍ ، وعبدُ اللَّهِ بنُ عمرو بنِ العاصِ : إنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ ، قالَ : إنَّ الهجرةَ خَصلتانِ : إحداهما أن تَهْجرَ السَّيِّئاتِ ، والأخرى أن تُهاجرَ إلى اللَّهِ ورسولِهِ . ولا تنقطعُ الهجرةُ ما تُقُبِّلَتِ ",["التَّوبةُ",1]," ، ",["ولا تزالُ التَّوبةُ مقبولةً حتَّى تطلُعَ الشَّمسُ منَ المغرِبِ",2]," ، فإذا طلعَت طُبِعَ على كلِّ قَلبٍ بما فيهِ ، وَكُفيَ النَّاسُ العَملَ"],"grade":"صحيح","narrator":"عبدالله بن وقدان ابن السعدي","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (1671)، وابن عساكر في ((تاريخ دمشق)) (31/ 306) بلفظهأخرجه النسائي في ((السنن الكبرى)) (7748) باختلاف يسير.","bab":"توبة › الحض على التوبة","dorar":"aKzBrJNi","merged":3,"otherRefs":["تفسير الطبري 3/2/377 (صحيح)","تخريج مشكل الآثار 2634 (صحيح)"]},{"id":"س-02337","fp":"2efaf8d4b4d3","stateId":49,"easy":"إذا أكثرت التوبة كلما أخطأت ← تكون من خير الخطّائين","cause":"التَّوَّابونَ","result":"وخَيرُ الخَطَّائينَ","explicit":true,"ref":"مجموع الشروح الفقهية. 209/30","srcLabel":"مجموع الشروح الفقهية","text":["كُلُّ بَني آدَمَ خَطَّاءٌ، ",["وخَيرُ الخَطَّائينَ",2]," ",["التَّوَّابونَ",1],"."],"grade":"صحيح","narrator":"أنس","muhaddith":"صحيح","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"cHZWtJ7w","merged":2,"otherRefs":["القائد إلى تصحيح العقائد 27 (حسن)"]},{"id":"س-03451","fp":"057e597d16a1","stateId":49,"easy":"إذا ندمت على ذنبك صادقاً ← يغفر الله لك قبل أن تستغفره","cause":"ما عَلِمَ اللهُ مِن عبْدٍ نَدامةً على ذنْبٍ","result":"إلَّا غفَرَ لهُ قبْلَ أنْ يَستَغْفِرَه منْه","explicit":true,"ref":"المستدرك على الصحيحين 7855","srcLabel":"الحاكم","text":[["ما عَلِمَ اللهُ مِن عبْدٍ نَدامةً على ذنْبٍ",1]," ",["إلَّا غفَرَ لهُ قبْلَ أنْ يَستَغْفِرَه منْه",2],"."],"grade":"صحيح","narrator":"عائشة","muhaddith":"صحيح الإسناد","bab":"استغفار › فضل الاستغفار","dorar":"t0dBMWIL","merged":2,"otherRefs":["النوافح العطرة 313 (صحيح)"]},{"id":"س-03452","fp":"83ec7219471e","stateId":49,"easy":"إذا عملت ذنباً ثم استغفرت خلال ساعات ← لا يكتبه الملك عليك","cause":"ما مِن مُسلِمٍ يَعمَلُ ذنْبًا","result":"إلَّا وقَفَ الملَكُ المُوَكَّلُ بإحصاءِ ذُنوبِه ثَلاثَ ساعاتٍ؛ فإنِ استغفَرَ اللهَ مِن ذنْبِه ذلكَ في شَيءٍ مِن تلكَ الساعاتِ، لم يُوقِفْه عليهِ، ولم يُعذَّبْ يومَ القِيامةِ","explicit":true,"ref":"المستدرك على الصحيحين 7884","srcLabel":"الحاكم","text":[["ما مِن مُسلِمٍ يَعمَلُ ذنْبًا",1]," ",["إلَّا وقَفَ الملَكُ المُوَكَّلُ بإحصاءِ ذُنوبِه ثَلاثَ ساعاتٍ؛ فإنِ استغفَرَ اللهَ مِن ذنْبِه ذلكَ في شَيءٍ مِن تلكَ الساعاتِ، لم يُوقِفْه عليهِ، ولم يُعذَّبْ يومَ القِيامةِ",2],"."],"grade":"صحيح","narrator":"أم عصمة العوصية","muhaddith":"صحيح الإسناد","bab":"استغفار › فضل الاستغفار","dorar":"dGutninJ","merged":2,"otherRefs":["الجامع الصغير 8084 (صحيح)"]},{"id":"س-03459","fp":"e1d3ef703121","stateId":49,"easy":"إذا استغفرت الله ← يغفر لك","cause":"ثم استَغْفَرْتَنِي","result":"غفرتُ لك","explicit":true,"repOf":"س-01803","ref":"هداية الرواة 2276","text":["قال اللهُ – تعالى – يا ابنَ آدمَ ! إنك ما دَعَوْتَنِي ورَجَوْتَنِي ؛ غفرتُ لك ما كان فيك ولا أُبَالِي، يا ابنَ آدمَ ! لو بَلَغَتْ ذنوبُكَ عَنَانَ السماءِ، ",["ثم استَغْفَرْتَنِي",1]," ؛ ",["غفرتُ لك",2]," ولا أُبَالِي، يا ابنَ آدمَ ! إنك لو أَتَيْتَنِي بقُرَابِ الأرضِ خَطَايَا، ثم لَقِيتَنِي لا تُشْرِكُ بي شيئًا ؛ لَأَتَيْتُكَ بقُرَابِها مَغْفِرَةً"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"حسن بل صحيح","takhrij":"أخرجه الترمذي (3540) واللفظ له، وأحمد (13493) مختصراً بمعناه.","bab":"استغفار › فضل الاستغفار","dorar":"b0r8OsTX","merged":2,"otherRefs":["الأحاديث المختارة 1571 (صحيح)"]},{"id":"س-03461","fp":"5b413a0db166","stateId":49,"easy":"إذا أذنبت فأحسنت الطهور وصليت ركعتين واستغفرت ← يغفر الله لك","cause":"ما مِن عبدٍ يذنبُ ذنبًا، فيُحسنُ الطُّهورَ، ثمَّ يقومُ فيُصلِّي رَكْعتينِ، ثمَّ يستغفِرُ اللَّهَ","result":"إلَّا غفرَ اللَّهُ لَهُ، ثمَّ قرأَ هذِهِ الآيةَ: وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ ذَكَرُوا اللَّهَ إلى آخرِ الآيةِ","explicit":true,"apply":{"k":"count","t":"ركعتين"},"repOf":"س-03468","ref":"صحيح أبي داود 1521","text":["عن أسماءَ بنِ الحَكَمِ الفزازي ، قالَ: سَمِعْتُ عليًّا رضيَ اللَّهُ عنهُ يقولُ: كنتُ رجلًا إذا سَمِعْتُ من رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ حديثًا نفعَني اللَّهُ منهُ بما شاءَ أن ينفعَني، وإذا حدَّثَني أحدٌ من أصحابِهِ استَحلفتُهُ، فإذا حلَفَ لي صدَّقتُهُ، قالَ: وحدَّثَني أبو بَكْرٍ وصدقَ أبو بَكْرٍ رضيَ اللَّهُ عنهُ، أنَّهُ قالَ: سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ يقولُ: ",["ما مِن عبدٍ يذنبُ ذنبًا، فيُحسنُ الطُّهورَ، ثمَّ يقومُ فيُصلِّي رَكْعتينِ، ثمَّ يستغفِرُ اللَّهَ،",1]," ",["إلَّا غفرَ اللَّهُ لَهُ، ثمَّ قرأَ هذِهِ الآيةَ:  وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ ذَكَرُوا اللَّهَ  إلى آخرِ الآيةِ",2]],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1521)، وأحمد (56)، واللفظ لهما، والترمذي (406)، والنسائي في ((السنن الكبرى)) (10178)، باختلاف يسير.","bab":"استغفار › فضل الاستغفار","dorar":"sQqXwrY7","merged":2,"otherRefs":["تخريج المسند لشاكر 1/46 (صحيح)"]},{"id":"س-03968","fp":"97bdbf0ca067","stateId":49,"easy":"إذا استغفرت ← لا تبقى كبيرة (مع الاستغفار)","cause":"معَ استِغفارٍ","result":"لا كبيرةَ","explicit":true,"ref":"الآداب الشرعية 1/153","srcLabel":"الطبري","text":["أنَّ رجلًا قالَ لابنِ عبَّاسٍ : كَم الكبائرُ ، أسَبعٌ هي ؟ قالَ : هيَ إلى سَبعِمائةٍ أقربُ منها إلى سبعٍ غيرَ أنَّهُ ",["لا كبيرةَ",2]," ",["معَ استِغفارٍ",1]," ولا صغيرةَ معَ إصرارٍ"],"grade":"صحيح","narrator":"سعيد بن جبير","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبري في ((جامع البيان)) (6/ 651)، وابن المنذر في ((التفسير)) (1670)، وابن أبي حاتم في ((التفسير)) (5217) واللفظ لهم جميعا.","bab":"توبة › الحض على التوبة","dorar":"VVQkUQf0","merged":2,"otherRefs":["أصول الفقه لابن مفلح 2/534 (صحيح)"]},{"id":"س-07479","fp":"690c11f194e9","stateId":49,"easy":"إذا استغفرت الله ← لا يزال يغفر لك","cause":"ما استَغْفَروني","result":"لا أزالُ أغفِرُ لهم","explicit":true,"repOf":"س-01803","ref":"المستدرك على الصحيحين 7881","text":["إنَّ الشَّيْطانَ قالَ: وعزَّتِكَ يا ربِّ، لا أبرَحُ أُغوي عِبادَكَ ما دامَتْ أرواحُهُم في أجسادِهِم، فقالَ الرَّبُّ تباركَ وتَعالَى: وعِزَّتي وجَلالِي ",["لا أزالُ أغفِرُ لهم",2]," ",["ما استَغْفَروني",1],"."],"grade":"صحيح","narrator":"أبو سعيد","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو يعلى (1399)، والبغوي في ((شرح السنة)) (1293) واللفظ لهما، وأحمد (11244) بنحوه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"dOkTbUuG","merged":2,"otherRefs":["مجمع الزوائد 10/210 (صحيح)"]},{"id":"س-00859","fp":"35dfab110d6e","stateId":49,"easy":"إذا قلت «أستغفر الله الذي لا إله إلا هو الحي القيوم وأتوب إليه» ثلاثاً ← تُغفر ذنوبك","cause":"مَنْ قال : أستغفرُ اللهَ الذي لا إلهُ إلَّا هو الحيُّ القيومُ و أتوبُ إليهِ ، ثلاثًا","result":"غُفِرَتْ لهُ ذنوبُهُ ، و إن كان فارًا مِنَ الزحفِ","explicit":true,"apply":{"k":"say","t":"«أستغفر الله الذي لا إله إلا هو الحي القيوم وأتوب إليه»"},"ref":"السلسلة الصحيحة 2727","srcLabel":"السلسلة الصحيحة","text":[["مَنْ قال : أستغفرُ اللهَ الذي لا إلهُ إلَّا هو الحيُّ القيومُ و أتوبُ إليهِ ، ثلاثًا ، ",1],["غُفِرَتْ لهُ ذنوبُهُ ، و إن كان فارًا مِنَ الزحفِ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود وزيد مولى رسول الله وأبو بكر الصديق وأبو سعيد الخدري وأنس بن مالك والبراء بن عازب","muhaddith":"صحيح","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"48OdleHQ"},{"id":"س-02770","fp":"6b7699723df2","stateId":49,"easy":"إذا استغفرت في وقت النزول الإلهي آخر الليل ← يغفر الله لك","cause":"هل من مستغفِرٍ","result":"فأغفرَ لَه","explicit":true,"apply":{"k":"time","t":"في الليل"},"repOf":"س-06824","ref":"شرح البخاري لابن الملقن 22/551","text":["ثلاثُ ساعاتٍ يبقَينَ منَ اللَّيلِ يفتحُ اللَّهُ عزَّ وجلَّ الذِّكرَ الَّذي لم يرَه أحدٌ غيرُه فيمحُو ما شاء ويُثبتُ ثمَّ في السَّاعةِ الثَّانيةِ ينزلُ إلى عَدْنٍ فيقولُ طوبى لمن دخلَكِ ثمَّ ينزلُ في السَّاعةِ الثَّالثةِ إلى السَّماءِ الدُّنيا بملائكةٍ فيقولُ ",["هل من مستغفِرٍ",1]," ",["فأغفرَ لَه",2]," هَل من داعٍ فأُجيبُهُ حتَّى يصلَّى الفجرُ وذلِكَ قولُه { وَقُرْآنَ الْفَجْرِ إِنَّ قُرْآنَ الْفَجْرِ كَانَ مَشْهُودًا} يقول يشهدُهُ اللَّهُ وملائكتُهُ وملائكةُ الليلِ وملائِكةُ النَّهارِ."],"grade":"صحيح","muhaddith":"روى الحاكم نحوه على شرط الشيخين عن أبي هريرة رضي الله عنه وأبي سعيد مرفوعاً","bab":"إيمان › الملائكة","dorar":"dUCLAyKW"},{"id":"س-03118","fp":"916697231b45","stateId":49,"easy":"إذا قلت «أستغفر الله الذي لا إله إلا هو الحي القيوم وأتوب إليه» ← يُغفر لك ولو كنت فررت من الزحف","cause":"مَن قال: أَستغفِرُ اللهَ الذي لا إلهَ إلَّا هو الحيُّ القيومُ وأتوبُ إليه","result":"غُفِر له وإنْ كان فَرَّ مِن الزَّحفِ","explicit":true,"apply":{"k":"say","t":"«أستغفر الله الذي لا إله إلا هو الحي القيوم وأتوب إليه»"},"ref":"تخريج سنن أبي داود 1517","srcLabel":"أبو داود","text":["سَمِعتُ أَبي يُحدِّثُنيه عن جدِّي أنَّه سَمِع النَّبيَّ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن قال: أَستغفِرُ اللهَ الذي لا إلهَ إلَّا هو الحيُّ القيومُ وأتوبُ إليه، ",1],["غُفِر له وإنْ كان فَرَّ مِن الزَّحفِ",2],"."],"grade":"صحيح","narrator":"زيد بن حارثة مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (3577)، وأبو داود (1517)، وابن سعد في ((الطبقات الكبرى)) (7/ 66) بلفظه.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"L0RfFw8a"},{"id":"س-03246","fp":"9b1ddaa662b2","stateId":49,"easy":"إذا أذنبت ثم أحسنت الوضوء وصليت ركعتين واستغفرت الله ← يغفر الله لك","cause":"ما من مسلمٍ يذنبُ ذنبًا فيتوضأُ ويحسِنُ الوضوءَ ثمَّ يصلِّي رَكعتينِ ويستغفرُ اللَّهَ","result":"إلَّا غَفَرَ لَه ، وقرأَ هذِه الآيةَ","explicit":true,"apply":{"k":"count","t":"ركعتين"},"repOf":"س-03468","ref":"الاستقامة 2/184","text":[["ما من مسلمٍ يذنبُ ذنبًا فيتوضأُ ويحسِنُ الوضوءَ ثمَّ يصلِّي رَكعتينِ ويستغفرُ اللَّهَ",1]," ",["إلَّا غَفَرَ لَه ، وقرأَ هذِه الآيةَ ",2],"{ وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ ذَكَرُوا اللَّهَ }"],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"محفوظ في السنن","takhrij":"أخرجه أبو داود (1521)، والترمذي (406)، والنسائي في ((السنن الكبرى)) (11078)، وابن ماجه (1395)، وأحمد (2) بنحوه، والبزار (6) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"lM9oRpCm"},{"id":"س-03440","fp":"a6a8d591f687","stateId":49,"easy":"إذا ألممت بذنب ثم تبت واستغفرت ← يغفر الله لك","cause":"فإنَّ العَبدَ إذا ألَمَّ بذَنبٍ، ثم تابَ واستَغْفَرَ","result":"غَفَرَ اللهُ له","explicit":true,"repOf":"س-07061","ref":"تخريج المسند لشعيب 43/315","text":["أنَّ النبيَّ صلَّى اللهُ عليه وسلَّمَ قال لها: \"يا عائِشةُ، إنْ كُنتِ ألْمَمْتِ بذَنبٍ فاستَغْفِري اللهَ؛ ",["فإنَّ العَبدَ إذا ألَمَّ بذَنبٍ، ثم تابَ واستَغْفَرَ",1]," اللهَ عزَّ وجلَّ ",["غَفَرَ اللهُ له\"",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح بهذا السياق، إلا أن سفيان لم يحفظه","takhrij":"أخرجه الحميدي (284)، وابن حبان (624)","bab":"استغفار › فضل الاستغفار","dorar":"QrZkH2hK"},{"id":"س-03441","fp":"0308a5c7fe30","stateId":49,"easy":"إذا ساء لسانك على أهلك فأكثر من الاستغفار ← (علاج نبوي)","cause":"أين أنتَ من الاستِغْفارِ","result":"كان في لِساني ذَرَبٌ على أهْلي","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[35],"ref":"تخريج المسند لشعيب 23340","srcLabel":"النسائي","text":[["كان في لِساني ذَرَبٌ على أهْلي",2]," لم أعْدُه إلى غَيرِه، فذَكَرتُ ذلك لِلنَّبيِّ صلَّى اللهُ عليه وسلَّمَ قال: ",["أين أنتَ من الاستِغْفارِ",1]," يا حُذَيفةُ، إنِّي لَأستغفِرُ اللهَ كُلَّ يَومٍ مِئَةَ مَرَّةٍ، وأتوبُ إليه. قال: فذَكَرتُه لأبي بُرْدةَ بنِ أبي موسى فحَدَّثَني، عن أبي موسى، أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال: إنِّي لَأستَغفِرُ اللهَ كُلَّ يَومٍ ولَيْلةٍ مِئَةَ مَرَّةٍ، وأتوبُ إليه."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح لغيره دون قصة ذرابة اللسان","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10287)، وابن ماجه (3817)، وأحمد (23340) واللفظ له","bab":"استغفار › فضل الاستغفار","dorar":"keiBfcv1","merged":6,"otherRefs":["تخريج المسند لشعيب 23371 (صحيح)","الأمالي المطلقة 252 (حسن)","المستدرك على الصحيحين 3752 (صحيح)","تخريج المسند لشعيب 23421 (صحيح)","تخريج المسند لشعيب 23362 (صحيح)"]},{"id":"س-03447","fp":"001dec50465b","stateId":49,"easy":"إذا أذنبت ثم توضأت فأحسنت وصليت واستغفرت ← يغفر الله لك","cause":"ما مِن رجُلٍ يُذنِبُ ذَنْبًا، فيَتوضَّأُ، فأَحسَنَ الوُضوءَ، ثمَّ صَلَّى واستَغفَرَ اللهَ مِنهُ","result":"إلَّا غَفَر اللهُ لهُ","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"repOf":"س-03468","ref":"تخريج مسند أبي بكر 11","text":["سمِعتُ عليًّا رضيَ اللهُ عنه يقولُ: كنتُ امرَأً إذا سمِعتُ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ حديثًا نفَعَني اللهُ بما شاء أنْ يَنفَعَني، وإذا حدَّثَني عنهُ أحدٌ مِن أَصحابِه استَحلَفْتُه، فإذا حلَف لي صَدَّقْتُه، وحلَفَ لي أبو بَكرٍ -وصدَقَ أبو بَكرٍ- أنَّه سمِع النَّبيَّ صلَّى اللهُ عليه وسلَّمَ يقولُ: «",["ما مِن رجُلٍ يُذنِبُ ذَنْبًا، فيَتوضَّأُ، فأَحسَنَ الوُضوءَ، ثمَّ صَلَّى واستَغفَرَ اللهَ مِنهُ،",1]," ",["إلَّا غَفَر اللهُ لهُ»",2],". قال: ثمَّ تلَا: {وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ ذَكَرُوا اللَّهَ فَاسْتَغْفِرُوا لِذُنُوبِهِمْ} [آل عمران: 135]."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1521)، والترمذي (406)، والنسائي في ((السنن الكبرى)) (11078)، وابن ماجه (1395)، وأحمد (47) باختلاف يسير، والمروزي في ((مسند أبي بكر الصديق)) (11) واللفظ له","bab":"استغفار › فضل الاستغفار","dorar":"yB1PLhX0"},{"id":"س-03926","fp":"5fe3a4facdbc","stateId":49,"easy":"إذا أذنبت فتوضأت وصليت ركعتين واستغفرت ← يُغفر لك","cause":"ما مِن مسلمٍ يُذنِبُ ذنبًا، ثمَّ يَتوضَّأُ فيُصلِّي ركعتينِ، ثمَّ يَستغفِرُ اللهَ لذلك الذنبِ","result":"إلَّا غُفِر له، وقرَأَ هاتينِ الآيتينِ","explicit":true,"apply":{"k":"count","t":"ركعتين"},"repOf":"س-03468","ref":"تخريج المسند لشعيب 47","text":["قال عليٌّ رضِي اللهُ عنه: كنتُ إذا سَمِعتُ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ شيئًا، نفَعَني اللهُ بما شاء أنْ ينفَعَني منه، وحدَّثَني أبو بَكْرٍ -وصدَقَ أبو بَكْرٍ- قال: قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["ما مِن مسلمٍ يُذنِبُ ذنبًا، ثمَّ يَتوضَّأُ فيُصلِّي ركعتينِ، ثمَّ يَستغفِرُ اللهَ لذلك الذنبِ،",1]," ",["إلَّا غُفِر له، وقرَأَ هاتينِ الآيتينِ: ",2],"{وَمَنْ يَعْمَلْ سُوءًا أوْ يَظْلِمْ نَفْسَهُ ثُمَّ يَسْتَغْفِرِ اللَّهَ يَجِدِ اللَّهَ غَفُورًا رَحِيمًا} [النساء: 110]، {وَالَّذِينَ إذَا فَعَلُوا فَاحِشَةً أوْ ظَلَمُوا أنْفُسَهُمْ} [آل عمران: 135]."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1521)، والترمذي (406)، والنسائي في ((السنن الكبرى)) (11078)، وابن ماجه (1395)، وأحمد (47) واللفظ له","bab":"تفسير آيات › سورة النساء","dorar":"TPxwKVBk"},{"id":"س-03934","fp":"1c3be169d527","stateId":49,"easy":"إذا أذنبت فقرأت الآيتين واستغفرت الله ← يغفر لك","cause":"ما أذنب عبدٌ ذنبًا فقرأَهما واستغفرَ اللهَ","result":"إلا غَفَرَ لَهُ","explicit":true,"ref":"مجمع الزوائد 7/14","srcLabel":"الطبراني","text":["عنِ ابنِ مسعودِ رَضِيَ اللهُ عنه قال إنَّ في كتابِ اللهِ لَآيَتَيْنِ ",["ما أذنب عبدٌ ذنبًا فقرأَهما واستغفرَ اللهَ",1]," ",["إلا غَفَرَ لَهُ",2],"   وَالَّذِينَ إِذَا فَعَلُواْ فَاحِشَةً أَوْ ظَلَمُواْ أَنْفُسَهُمْ ذَكَرُواْ اللَّهَ فَاسْتَغْفَرُواْ لِذُنُوبِهِمْ وَمَن يَغْفِرُ الذُّنُوبَ إِلاَّ اللَّهُ   وَمَن يَعْمَلْ سُوءًا أَوْ يَظْلِمْ نَفْسَهُ ثُمَّ يَسْتَغْفِرِ اللَّهَ يَجِدِ اللَّهَ غَفُورًا رَّحِيمًا"],"grade":"صحيح","narrator":"محمد بن سيرين","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (9/ 212) (9035) واللفظ له، وابن أبي الدنيا في ((التوبة)) (20)، والبيهقي في ((شعب الإيمان)) (6743) بنحوه.","bab":"تفسير آيات › سورة النساء","dorar":"tQiiqGpj"},{"id":"س-03959","fp":"dce713f57a2a","stateId":49,"easy":"إذا أخطأت حتى بلغت خطاياك السماء ثم تبت ← يتوب الله عليك","cause":"لَوْ أَخْطَأْتُمْ حتى تَبْلُغَ السَّماءَ ، ثُمَّ تُبْتُمْ","result":"لتابَ اللهُ عليكُمْ","explicit":true,"ref":"صحيح الترغيب 3138","srcLabel":"ابن ماجه","text":[["لَوْ أَخْطَأْتُمْ حتى تَبْلُغَ السَّماءَ ، ثُمَّ تُبْتُمْ",1]," ، ",["لتابَ اللهُ عليكُمْ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه ابن ماجه (4248) باختلاف يسير.","bab":"توبة › الحض على التوبة","dorar":"4LQ0utTl"},{"id":"س-03985","fp":"068818e177a6","stateId":49,"easy":"إذا تبت من الذنب ← تكون كمن لا ذنب له","cause":"التَّائبُ منَ الذَّنبِ","result":"كمن لا ذنبَ لَهُ","explicit":true,"ref":"فتاوى نور على الدرب لابن باز 17/70","srcLabel":"فتاوى نور على الدرب لابن باز","text":[["التَّائبُ منَ الذَّنبِ",1]," ",["كمن لا ذنبَ لَهُ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"توبة › الحض على التوبة","dorar":"hZKqYVWl"},{"id":"س-03991","fp":"c954478e4a34","stateId":49,"easy":"إذا تبت توبة نصوحاً ← تكفّر كل سيئة","cause":"التَّوبةُ النَّصوحُ","result":"تُكفِّرُ كُلَّ سيِّئةٍ","explicit":true,"ref":"المستدرك على الصحيحين 3877","srcLabel":"أحمد","text":["قالَ عبدُ اللهِ بنُ مسعودٍ رَضيَ اللهُ عنه، ",["التَّوبةُ النَّصوحُ",1]," ",["تُكفِّرُ كُلَّ سيِّئةٍ",2],"، وهو في القرآنِ، ثُمَّ قَرَأَ: {يَا أَيُّهَا الَّذِينَ آمَنُوا تُوبُوا إِلَى اللَّهِ تَوْبَةً نَصُوحًا عَسَى رَبُّكُمْ أَنْ يُكَفِّرَ عَنْكُمْ سَيِّئَاتِكُمْ} [التحريم: 8] الآيةَ."],"grade":"صحيح","narrator":"عباية الأسدي","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (6741) بلفظه، وابن أبي شيبة (34560)، وأحمد (4264) بنحوه","bab":"توبة › الحض على التوبة","dorar":"kBnUkNQU"},{"id":"س-03993","fp":"80b7825735e8","stateId":49,"easy":"إذا أخطأت فأحببت التوبة فأتيت مكاناً مرتفعاً فدعوت وتبت ← يغفر الله لك ما لم ترجع","cause":"فإذا أخطَأَ خَطيئةً فأحَبَّ أنْ يَتوبَ إلى اللهِ عزَّ وجلَّ، فلْيَأْتِ بُقْعةً رَفيعةً، فلْيَمْدُدْ يدَيْهِ إلى اللهِ عزَّ وجلَّ، ثمَّ يقولُ: اللَّهُمَّ إنِّي أتوبُ إليكَ منها، لا أرجِعُ إليها أبدًا","result":"فإنَّه يَغفِرُ له ما لم يَرجِعْ في عَملِهِ ذلكَ","explicit":true,"ref":"المستدرك على الصحيحين 7882","srcLabel":"الطبراني","text":["كُلُّ شَيْءٍ تكلَّمَ بهِ ابنُ آدَمَ، فإنَّه مكتوبٌ عليهِ، ",["فإذا أخطَأَ خَطيئةً فأحَبَّ أنْ يَتوبَ إلى اللهِ عزَّ وجلَّ، فلْيَأْتِ بُقْعةً رَفيعةً، فلْيَمْدُدْ يدَيْهِ إلى اللهِ عزَّ وجلَّ، ثمَّ يقولُ: اللَّهُمَّ إنِّي أتوبُ إليكَ منها، لا أرجِعُ إليها أبدًا",1],"؛ ",["فإنَّه يَغفِرُ له ما لم يَرجِعْ في عَملِهِ ذلكَ",2],"."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه الطبراني في ((الدعاء)) (صـ85)، والبيهقي (20598)، وقوام السنة في ((الترغيب والترهيب)) (784) باختلاف يسير.","bab":"توبة › الحض على التوبة","dorar":"Gg65jSVO"},{"id":"س-04001","fp":"b1dd01592473","stateId":49,"easy":"إذا تبت إلى الله قبل أن تبلغ روحك الحلقوم ← يقبل الله منك","cause":"مَنْ تابَ إلى اللهِ قبلَ أنْ يُغَرْغِرَ","result":"قَبِلَ اللهُ مِنْهُ","explicit":true,"otherNeedIds":[44],"ref":"صحيح الجامع 6132","srcLabel":"صحيح الجامع","text":[["مَنْ تابَ إلى اللهِ قبلَ أنْ يُغَرْغِرَ ، ",1],["قَبِلَ اللهُ مِنْهُ",2]],"grade":"صحيح","narrator":"رجل وعبدالله بن عمر","muhaddith":"صحيح","bab":"توبة › الحض على التوبة","dorar":"qf0O4Dl4"},{"id":"س-04013","fp":"613ee906a330","stateId":49,"easy":"إذا تبت ← فعسى الله أن يتوب عليك","cause":"كلُّ تائبٍ","result":"عسى اللهُ أنْ يتوبَ عليه","explicit":true,"repOf":"س-04014","ref":"تفسير الطبري 3/2/377","text":[["كلُّ تائبٍ",1]," ",["عسى اللهُ أنْ يتوبَ عليه",2],"."],"grade":"صحيح","muhaddith":"ثابت","bab":"توبة › الحض على التوبة","dorar":"KJSNQbNt"},{"id":"س-04025","fp":"eeb60306ed32","stateId":49,"easy":"إذا تبت توبة صادقة ← تسع توبتك ولو قُسمت على سبعين","cause":"لقد تابت توبةً","result":"لو قُسِمت توبتُها بينَ سبعينَ رجلًا مِن أهلِ المدينةِ لوسِعتْهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-04600"],"otherNeedIds":[44],"ref":"تخريج صحيح ابن حبان 4442","srcLabel":"ابن حبان","text":["جاءتِ امرأةٌ إلى نبيِّ اللهِ صلَّى اللهُ عليه وسلَّم فقالت: قد أحدَثْتُ، وهي حُبْلى، فأمَرها نبيُّ اللهِ صلَّى اللهُ عليه وسلَّم أنْ تذهَبَ حتَّى تضَعَ ما في بطنِها فلمَّا وضَعتْ جاءت فأمَرها أنْ تذهَبَ فتُرضِعَه حتَّى تفطِمَه ففعَلتْ ثمَّ جاءت فأمَرها أنْ تدفَعَ ولدَها إلى أُناسٍ ففعَلتْ ثمَّ جاءت فسأَلها: ( إلى مَن دفَعْتِ ) فأخبَرتْ أنَّها دفَعتْه إلى فلانٍ فأمَرها أنْ تأخُذَه وتدفَعَه إلى آلِ فلانٍ ناسٍ مِن الأنصارِ ثمَّ إنَّها جاءت فأمَرها أنْ تشُدَّ عليها ثيابَها ثمَّ إنَّه أمَر بها فرُجِمتْ ثمَّ إنَّه كفَّنها وصلَّى عليها ثمَّ دفَنها فقال النَّاسُ: رجَمها ثمَّ كفَّنها وصلَّى عليها ثمَّ دفَنها ! فبلغ النَّبيَّ صلَّى اللهُ عليه وسلَّم ما يقولُ النَّاسُ فقال: ( ",["لقد تابت توبةً",1]," ",["لو قُسِمت توبتُها بينَ سبعينَ رجلًا مِن أهلِ المدينةِ لوسِعتْهم",2]," )"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح","takhrij":"لم أقف عليه إلا عند ابن حبان في الصحيح","bab":"توبة › تبشير التائب بالغفران","dorar":"HfbYLa85","merged":6,"otherRefs":["الاستذكار 6/478 (صحيح)","سفر السعادة 140 (صحيح)","تخريج مشكل الآثار 428 (صحيح)","تخريج صحيح ابن حبان 4403 (صحيح)","تهذيب التهذيب 12/249 (صحيح)"]},{"id":"س-04048","fp":"bb82c39be572","stateId":49,"easy":"إذا أذنبت فاستغفر الله ← فالاستغفار دواء الذنوب","cause":"أنْ تَستغفِرَ اللهَ عزَّ وجلَّ","result":"ودَواءُ الذُّنوبِ","explicit":true,"ref":"المستدرك على الصحيحين 7816","srcLabel":"الدولابي","text":["عنْ أنسِ بنِ مالكٍ رَضيَ اللهُ عنه، أنَّ أبا ذَرٍّ الغِفاريَّ بالَ قائمًا، فانتَضَحَ مِن بَوْلِه على ساقَيْهِ وقَدَمَيْه، فقالَ له رَجُلٌ: إنَّه أصابَ مِن بَوْلِكَ قَدَمَيْكَ وساقَيْكَ، فلمْ يَرُدَّ عليه شيئًا حتَّى انْتَهى إلى دارِ قَوْمٍ، فاسْتَوْهَبَهم طَهورًا فأخْرَجوا إليه، فتَوَضَّأَ وغَسَلَ ساقَيْهِ وقَدَمَيْهِ، ثمَّ أقبَلَ على الرَّجُلِ، فقال: ماذا قُلْتَ؟ فقال: أمَّا الآنَ فقَدْ فعَلْتَ، فقال أبو ذَرٍّ رَضيَ اللهُ عنه: هذا دَواءُ هذا، ",["ودَواءُ الذُّنوبِ",2]," ",["أنْ تَستغفِرَ اللهَ عزَّ وجلَّ",1],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح","takhrij":"أخرجه الدولابي في ((الكنى)) (695)","bab":"توبة › سقوط الذنوب بالاستغفار والتوبة","dorar":"mx3VAzPW"},{"id":"س-05451","fp":"a884d0bba137","stateId":49,"easy":"إذا ندمت على معصية وتركتها قبل أن تقع فيها ← يغفر الله لك","cause":"فندِم ذو الكِفلِ وقام مِن غيرِ أنْ يكونَ منه شيءٌ","result":"فلمَّا أصبَح وجَدوا على بابِه مكتوبًا: إنَّ اللهَ قد غفَر لك","explicit":true,"ref":"صحيح ابن حبان 387","srcLabel":"الترمذي","text":["سمِعْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم أكثرَ مِن عشرينَ مرَّةً يقولُ: ( كان ذو الكفلِ مِن بني إسرائيلَ لا يتورَّعُ مِن شيءٍ فهوي امرأةً فراوَدها على نفسِها وأعطاها ستِّينَ دينارًا فلمَّا جلَس منها بكت وأُرعِدت فقال لها: ما لكِ ؟ فقالت: إنِّي واللهِ لم أعمَلْ هذا العملَ قطُّ وما عمِلْتُه إلَّا مِن حاجةٍ قال: ",["فندِم ذو الكِفلِ وقام مِن غيرِ أنْ يكونَ منه شيءٌ",1]," فأدرَكه الموتُ مِن ليلتِه ",["فلمَّا أصبَح وجَدوا على بابِه مكتوبًا: إنَّ اللهَ قد غفَر لك",2]," )"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الترمذي (2496)، وأحمد (4747) باختلاف يسير","bab":"رقائق وزهد › الخوف من الله","dorar":"exyhTiCY"},{"id":"س-03971","fp":"6d3a5966b6e3","stateId":49,"easy":"إذا تبت ← فباب التوبة واسع مفتوح حتى تطلع الشمس من مغربها","cause":"للتوبةِ","result":"بابًا عرضُ ما بين مِصراعَيه ما بين المشرقِ و المغربِ لا يُغلَقُ حتى تطلعَ الشمسُ من مغربِها","explicit":true,"repOf":"س-04016","ref":"صحيح الجامع 2177","text":["إنَّ ",["للتوبةِ",1]," ",["بابًا عرضُ ما بين مِصراعَيه ما بين المشرقِ و المغربِ لا يُغلَقُ حتى تطلعَ الشمسُ من مغربِها",2]],"grade":"حسن","narrator":"صفوان بن عسال","muhaddith":"حسن","takhrij":"أخرجه الترمذي (3536)، والنسائي في ((السنن الكبرى)) (11114)، والطبراني (8/ 65)، (7383) جميعهم مطولا.","bab":"توبة › الحض على التوبة","dorar":"mBG9CCsM","merged":2,"otherRefs":["صحيح الجامع 4191 (حسن)"]},{"id":"س-04021","fp":"c321d5d4739d","stateId":49,"easy":"إذا استغفرت (ولم تُصرّ) ← فأنت غير مُصرّ ولو عدت","cause":"مَنِ استَغفَرَ","result":"ما أَصَرَّ","explicit":true,"ref":"تخريج مسند أبي بكر 122","srcLabel":"أبو داود","text":["«",["ما أَصَرَّ",2]," ",["مَنِ استَغفَرَ",1],"، وإنْ عاد في النَّهارِ سَبعينَ مرَّةً»."],"grade":"حسن","narrator":"أبو بكر الصديق","muhaddith":"حسن","takhrij":"أخرجه أبو داود (1514)، والترمذي (3559) باختلاف يسير، وأبو بكر المروزي في ((مسند أبي بكر)) (122) واللفظ له","bab":"توبة › الحض على التوبة","dorar":"k0im2FbZ","merged":2,"otherRefs":["تخريج مسند أبي بكر 121 (حسن)"]},{"id":"س-01101","fp":"dc089c97bbab","stateId":49,"easy":"إذا استغفرت الله ← يُغفر لك","cause":"ومَن استغفرَ اللهَ","result":"غُفِرَ لهُ","explicit":true,"repOf":"س-01803","ref":"سنن الترمذي 3470","text":["قولوا : سبحانَ اللهِ ، وبحمدِهِ ، مائةَ مرَّةٍ ، مَن قالَها مرَّةً كُتِبَتْ لهُ عشرًا ، ومَن قالها عشرًا كُتِبَتْ لهُ مائةً ، ومَن قالها مائةً كُتِبَتْ لهُ ألفًا ، ومَن زادَ زادَهُ اللهُ ، ",["ومَن استغفرَ اللهَ ",1],["غُفِرَ لهُ",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن غريب","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9987) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (2921)، والبيهقي (18073) باختلاف يسير مطولاً","bab":"أدعية وأذكار › فضل الذكر","dorar":"dOVtJg0J"},{"id":"س-03312","fp":"52e93e7e8135","stateId":49,"easy":"إذا فعلت الخيرات وتركت السيئات بعد ذنوب كثيرة ← يبدّلها الله لك حسنات","cause":"تَفعلُ الخيراتِ وتترُكَ السَّيِّئاتِ","result":"فيَّجعلُهنَّ اللَّهُ لَكَ حسَناتٍ كُلَّهُنَّ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأمالي المطلقة 144","srcLabel":"الطبراني","text":["عَن أبي طويلٍ شَطَبٍ المَمدودِ رضيَ اللَّهُ تعالى عنهُ أنَّهُ أتى النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ أرأيتَ رجلًا عملَ الذُّنوبَ كلَّها فلم يترُكْ منها شيئًا وَهوَ مع ذلِكَ لم يترُكْ حاجَّةً ولا داجَّةً إلَّا أتاها فَهَل لذلِكَ من توبةٍ قالَ أليسَ قد أسلَمتَ قالَ أمَّا أَنا فأشهَدُ أن لا إلَهَ إلَّا اللَّهَ وحدَهُ لا شريكَ لَهُ وأنَّ محمَّدًا رسولُ اللَّهِ قالَ نعَم ",["تَفعلُ الخيراتِ وتترُكَ السَّيِّئاتِ",1]," ",["فيَّجعلُهنَّ اللَّهُ لَكَ حسَناتٍ كُلَّهُنَّ",2]," قالَ وغدَراتي وفجَراتي قالَ نعَم قالَ اللَّهُ أَكْبرُ فما زالَ يُكَبِّرُ حتَّى توارَى"],"grade":"صحيح","narrator":"شطب الممدود أبو الطويل","muhaddith":"حسن صحيح غريب","takhrij":"أخرجه ابن أبي عاصم في ((الآحاد والمثاني)) (2718)، والبغوي في ((معجم الصحابة)) (1713)، والطبراني (7/ 314) (7235) جميعهم بلفظه.","bab":"استغفار › أسباب المغفرة","dorar":"dMjqqfMG"},{"id":"س-03448","fp":"3ec2223b3bc8","stateId":49,"easy":"إذا أذنبت فتطهرت وصليت ركعتين واستغفرت ← يُغفر لك","cause":"ما من عبدٍ أصابَ ذَنبًا فتَطهَّرَ، فأحسَنَ الطُّهورَ، وصلَّى رَكعتَيْنِ، واستَغفَرَ اللهَ تَعالى","result":"إلَّا غُفِرَ له، ثُم قرَأَ","explicit":true,"apply":{"k":"count","t":"ركعتين"},"repOf":"س-03468","ref":"تخريج مشكل الآثار 6045","text":["[عن] علي رضي الله عنه يقول: كُنْتُ إذا سمِعْتُ من رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ حَديثًا يَنفَعُني اللهُ بما شاءَ أنْ يَنفَعَني به منه، فإذا حدَّثَني بعضُ أصحابِه استَحلَفْتُه، وصدَّقْتُه، وإنَّه حدَّثَني أبو بَكرٍ، وصدَقَ أبو بَكرٍ، قال: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["ما من عبدٍ أصابَ ذَنبًا فتَطهَّرَ، فأحسَنَ الطُّهورَ، وصلَّى رَكعتَيْنِ، واستَغفَرَ اللهَ تَعالى",1]," ",["إلَّا غُفِرَ له، ثُم قرَأَ: ",2],"{أَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ إِنَّ الْحَسَنَاتِ يُذْهِبْنَ السَّيِّئَاتِ} [هود: 114]."],"grade":"حسن","narrator":"أبو بكر الصديق","muhaddith":"إسناده قوي","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (6045) بلفظه، وأبو داود (1521)، والترمذي (406)، وابن ماجه (1395)، وأحمد (56) جميعا بلفظ مقارب.","bab":"استغفار › فضل الاستغفار","dorar":"fu2vsTOQ"},{"id":"س-03467","fp":"5f1f7c57018f","stateId":49,"easy":"إذا جلستم مجلس لغو فختمتموه بالاستغفار ← يُكتب مجلسكم كله استغفاراً","cause":"ما جلَسَ قَومٌ مجلِسَ لَغوٍ فخَتَموا باستِغفارٍ","result":"إلَّا كُتِبَ مَجلِسُهم ذلك استِغفارًا كُلَّه","explicit":true,"ref":"النكت على كتاب ابن الصلاح 2 / 743","srcLabel":"النكت على كتاب ابن الصلاح","text":[["ما جلَسَ قَومٌ مجلِسَ لَغوٍ فخَتَموا باستِغفارٍ",1]," ",["إلَّا كُتِبَ مَجلِسُهم ذلك استِغفارًا كُلَّه\"",2]],"grade":"حسن","narrator":"حسان بن عطية","muhaddith":"رجاله ثقات","bab":"استغفار › فضل الاستغفار","dorar":"xGDSGj7X"},{"id":"س-03469","fp":"a49c8d00171e","stateId":49,"easy":"إذا عملت سيئة ثم استغفرت منها ← لا تُكتب عليك، وإلا كُتبت واحدة","cause":"فإنِ استَغفرَ اللهَ مِنها","result":"لَم يَكتُبْ عليه شَيئًا، وإن لَم يَستَغفِرْ كَتَبَ عليه سيِّئةً واحِدةً","explicit":true,"ref":"فيض القدير 4/ 190","srcLabel":"الطبراني","text":["صاحِبُ اليَمينِ أميرٌ على صاحِبِ الشِّمالِ، فإذا عَمِلَ العَبدُ حَسَنةً كَتَبَها بعَشرِ أمثالِها، وإذا عَمِلَ سيِّئةً فأرادَ صاحِبُ الشِّمالِ أن يَكتُبَها قال صاحِبُ اليَمينِ: أمسِكْ، فيُمسِكُ سِتَّ ساعاتٍ، ",["فإنِ استَغفرَ اللهَ مِنها ",1],["لَم يَكتُبْ عليه شَيئًا، وإن لَم يَستَغفِرْ كَتَبَ عليه سيِّئةً واحِدةً",2]],"grade":"حسن","narrator":"أبو أمامة","muhaddith":"جيد","takhrij":"أخرجه الطبراني في ((الشاميين)) (468)، والبيهقي في ((الشعب)) (6648)، وابن شاهين في ((فضائل الأعمال)) (182) باختلاف يسير.","bab":"استغفار › فضل الاستغفار","dorar":"YCON0g7H"},{"id":"س-03497","fp":"d7bb5eba1525","stateId":49,"easy":"إذا ندمت ← فالندم كفارة الذنب","cause":"الندامةُ","result":"كفارةُ الذنبِ","explicit":true,"ref":"الجامع الصغير 6238","srcLabel":"أحمد","text":[["كفارةُ الذنبِ",2]," ",["الندامةُ",1],"، و لوْ لمْ تُذْنِبُوا لأتَى اللهُ بقومٍ يُذنِبُونَ ليغفرَ لهمْ"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن","takhrij":"أخرجه أحمد (2623) واللفظ له، والطبراني (12/172) (12795) مختصراً، وابن عدي في ((الكامل في الضعفاء)) (7/205) باختلاف يسير","bab":"استغفار › مكفرات الذنوب","dorar":"kgxe332l"},{"id":"س-03939","fp":"b043b9ea7356","stateId":49,"easy":"إذا عملت سوءاً أو ظلمت نفسك ثم استغفرت الله ← تجد الله غفوراً رحيماً","cause":"مَنْ يَعْمَلْ سُوءًا أَوْ يَظْلِمْ نَفْسَهُ ثُمَّ يَسْتَغْفِرِ اللَّهَ","result":"يَجِدِ اللَّهَ غَفُورًا رَحِيمًا","explicit":true,"repOf":"س-08381","ref":"فتح الباري لابن حجر 11/272","text":["أتاني آتٍ من ربِّي فقالَ: ",["مَنْ يَعْمَلْ سُوءًا أَوْ يَظْلِمْ نَفْسَهُ ثُمَّ يَسْتَغْفِرِ اللَّهَ",1]," ",["يَجِدِ اللَّهَ غَفُورًا رَحِيمًا",2]," فقلتُ: يا رسولَ اللَّهِ وإن زنى وإن سرَقَ قالَ: نعَم ثمَّ ثلَّثتُ فقالَ: على رُغمِ أنفِ عويمرٍ فردَّدَها قالَ: فأنا رأيتُ أبا الدَّرداءِ يضربُ أنفَهُ بإصبعِهِ"],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"إسناده جيد","takhrij":"أخرجه أبو يعلى كما في ((إتحاف الخيرة المهرة)) للبوصيري (6/199)","bab":"تفسير آيات › سورة النساء","dorar":"GawtaOqJ"},{"id":"س-03952","fp":"fb5b56b059e1","stateId":49,"easy":"إذا اعترفت بذنبك وفعلت ما أُمرت ← يغفر الله لك (من قصة بني إسرائيل)","cause":"فاعتَرَفوا بها، وفعَلوا ما أُمِروا","result":"وغفَرَ اللهُ للقاتِلِ والمقتولِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"إتحاف الخيرة المهرة 6/234","srcLabel":"النسائي","text":["سألْتُ عبدَ اللهِ بنَ عبَّاسٍ رضِيَ اللهُ عنهما عن قولِ اللهِ عَزَّ وجَلَّ لموسى صَلَّى اللهُ عليه وسلَّمَ: {وَفَتَنَّاكَ فُتُونًا} [طه: 40]، فسألْتُه عن الفُتونِ؟ فقال: استأنِفِ النَّهارَ يا ابنَ جُبيرٍ؛ فإنَّ لها حديثًا طويلًا.\nقال: فغدوْتُ على ابنِ عبَّاسٍ لأنتجِزَ ما وَعَدني مِن حديثِ الفُتونِ، فقال: تذاكَرَ فِرعونُ وجُلساؤُه ما كان اللهُ عَزَّ وجَلَّ وعَدَ إبراهيمَ صَلَّى اللهُ عليه وسلَّمَ مِن أنْ يجعَلَ في ذُرِّيتَه أنبياءَ ومُلوكًا؛ فقال بعضُهم: إنَّ بني إسرائيلَ لينتظِرونَ ذلك ما يشُكُّون فيه، وقد كانوا يظنُّونَ أنَّه يُوسفُ بنُ يعقوبَ عليهما الصَّلاةُ والسَّلامُ، فلمَّا هلَكَ قالوا: ليس هكذا كان، إنَّ اللهَ عَزَّ وجَلَّ وعَدَ إبراهيمَ صَلَّى اللهُ عليه وسلَّمَ. قال فِرعونُ: فكيف تَرَونَ؟ فائْتَمَروا، واجتمَعوا أمْرَهم على أنْ يبعَثَ رِجالًا بالشِّفارِ، يَطُوفون في بني إسرائيلَ، فلا يَجِدون مولودًا ذكَرًا إلَّا ذَبَحوه، ففَعَلوا ذلك، فلمَّا أنْ رَأَوا أنَّ الكبارَ في بني إسرائيلَ يموتونَ بآجالِهم، والصِّغارَ يُذْبَحونَ، قالوا: أتوشِكونَ أنْ تُفْنوا بني إسرائيلَ، فتَصيروا إلى أنْ تُباشِروا مِن الأعمالِ والخدمةِ الَّتي كانوا يَكْفُونكم؟ فاقْتُلوا عامًا كلَّ مولودٍ ذكرٍ، فيقِلَّ نَباتُهم، ودَعُوا عامًا، فلا تَقْتلوا منهم أحدًا، فيشِبَّ الصِّغارُ مكانَ مَن يموتُ مِن الكبارِ، فإنَّهم لنْ يَكْثروا بمَن تَسْتحيون، فتخافوا مُكاثرتَهم إياكم، ولنْ يَفْنَوا بمَن تقتُلونَ، فتحتاجونَ إليهم، فأجْمَعوا أمْرَهم على ذلك، فحمَلَت أُمُّ موسى بهارونَ عليهما السَّلامُ العامَ الَّذي لا يُذْبَحُ فيه الغِلمانُ، فولدَتْه عَلانيةً، فلمَّا كان مِن قابلٍ حمَلَتْ بمُوسى عليه السَّلامُ، فوقَعَ في قلْبِها مِن الهَمِّ والحزنِ. فذلك مِن الفُتونِ يا ابنَ جُبيرٍ، ما دخَلَ عليه في دهو بَطْنِ أُمِّه ممَّا يُرادُ به، فأوحَى اللهُ تعالى إليها: {وَلَا تَخَافِي وَلَا تَحْزَنِي إِنَّا رَادُّوهُ إِلَيْكِ وَجَاعِلُوهُ مِنَ الْمُرْسَلِينَ} [القصص: 7]، وأمَرَها أنْ إذا ولَدَتْ أنْ تجعَلَه في تابوتٍ، ثمَّ تُلْقِيه في اليمِّ، فلمَّا ولَدَت فعَلَت ذلك به، فألْقَته في اليمِّ، فلمَّا توارى عنها ابنُها أتاها الشَّيطانُ، فقالت في نفْسِها: ما فعَلْتُ بابني؟! لو ذُبِحَ لبِثَ عندي فرأيْتُه وكفَّنْتُه، كان أحَبَّ إليَّ مِن أنْ أُلْقِيَه بيدي إلى دوابِّ البحرِ وحِيتانِه، وانتهى الماءُ به حتَّى أرفَأَ به عند فُرْضَةُ مُسْتَقى جواري امرأةِ فِرعونَ، فلمَّا رأيْنَه أخذْنَه، فهمَمْنَ أنْ يفتحْنَ التَّابوتَ، فقالت بعضُهنَّ: إنَّ في هذا مالًا، وإنَّا إنْ فتحْناه لم تُصدِّقْنا امرأةُ الملِكِ بما وجَدْنا فيه، فحمَلْنَه بهيئةٍ لم يُحرِّكْنَ منه شيئًا، دفعْنَه إليها، فلمَّا فتحَتْه رأتْ فيه غُلامًا، فأُلْقِيَ عليه منها محبَّةٌ لم تُلْقَ مثْلُها على البشَرِ قطُّ، وأصبَحَ فُؤَادُ أُمِّ موسى فارغًا مِن ذِكْرِ كلِّ شَيءٍ إلَّا مِن ذِكْرِ مُوسى عليه السَّلامُ، فلمَّا سمِعَ الذَّابِحونَ بأمْرِه أقبلوا بشِفارِهم إلى امرأةِ فرعونَ ليذبَحُوه -وذلك مِن الفُتونِ يا ابنَ جُبيرٍ- فقالت للذَّبَّاحينَ: أقِرُّوه؛ فإنَّ هذا الواحدَ لا يَزيدُ في بني إسرائيلَ حتَّى آتِيَ فِرعونَ فأسْتَوْهِبَه منه، فإنْ وهَبَه لي كنْتُم قد أحسنْتُم وأجمَلْتُم، وإنْ أمَرَ بذبْحِه لم أَلُمْكم، فأتَتْ به فرعونَ، فقالت: قُرَّةُ عينٍ لي ولك، قال فِرعونُ: يكونُ لك، فأمَّا لي فلا حاجةَ لي في ذلك. قال رسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ: والَّذي أحلِفُ به، لو أقَرَّ فِرعونُ بأنْ يكونَ له قُرَّةَ عينٍ كما أقَرَّت امرأتُه، لهداهُ اللهُ به كما هدى به امرأتَه، ولكنَّ اللهَ حرَمَه ذلك.\nفأرسَلَتْ إلى مَن حولَها، مِن كلِّ امرأةٍ لها لبنٌ، تختارُ لها ظِئرًا، فجعَلَ كلَّما أخذَتْه امرأةٌ منهنَّ، فترُضِعُه، لم يَقْبَلْ ثَدْيَها، حتَّى أشفَقَت عليه امرأةُ فِرعونَ أنْ يَمتنِعَ مِن اللَّبنِ فيموتَ، فأحْزَنَها ذلك، فأمرَتْ به، فأُخْرِجَ إلى السُّوقِ وتجمَّعَ النَّاسُ، تَرْجو أنْ تجِدَ له ظِئرًا يأخُذُ منها، فلم يَقْبَلْ، وأصبَحَتْ أُمُّ موسى والهةً، فقالت لأُخْتِه: قُصِّيه -يعني: أثَرَهُ- واطْلُبِيه، هل تسمعينَ له ذِكْرًا؟ أحيٌّ ابْني أمْ قد أكلَتْه الدَّوابُّ؟ ونسِيَت ما كان اللهُ عَزَّ وجَلَّ وعَدَها فيه، فبَصُرتْ به أختُه عن جُنُبٍ وهم لا يَشعُرونَ، والجُنُبُ: أنْ يبصِرَ الإنسانُ إلى الشَّيءِ البعيدِ وهو إلى جَنْبِه لا يشعُرُ به، فقالت مِن الفرحِ حين أعياهم الظُّؤارتُ: أنا {أَدُلُّكُمْ عَلَى أَهْلِ بَيْتٍ يَكْفُلُونَهُ لَكُمْ وَهُمْ لَهُ نَاصِحُونَ} [القصص: 12]، فأخَذُوها فقالوا: ما يُدريك ما نُصْحُهم له؟ هل يعرِفونَه؟ حتَّى شكُّوا في ذلك -فذلك مِن الفُتونِ يا ابنَ جُبيرٍ- فقالت: نصيحَتُهم له وشفقَتُهم عليه رغبةً في صِهر الـمَلِك، ورجاءَ مَنفعتِه، فأرْسَلوها، فانطلَقَتْ إلى أُمِّها فأخبرتْها الخبرَ، فجاءتْ أُمُّه، فلمَّا وضعَتْه في حِجْرِها، نزَا إلى ثَدْيِها، فمَصَّه حتَّى امتلَأَ جَنباهُ رِيًّا، وانطلَقَ البشيرُ إلى امرأةِ فرعونَ: أنْ قد وجَدْنا لابْنِك، فأرسَلَتْ إليها، فأُوتِيتْ بها وبه، فلمَّا رأت ما يصنَعُ، قالت لها: امْكُثي عندي؛ تُرْضِعي ابني هذا، فإنِّي لم أحجِبْه شيئًا قطُّ، فقالت أُمُّ مُوسى: لا أستطيعُ أنْ أدَعَ بيتي وولدي، فيَضيعَ، فإنْ طابتْ نفْسُك أنْ تُعْطِيَنه، فأذهَبَ به إلى مَنْزلي، فيكونَ معي لا آلوهُ خيرًا، فعلْتُ، وإلَّا فإنِّي غيرُ تاركةٍ بيتي وولدي، وذكَرَت أُمُّ مُوسى عليه السَّلامُ ما كان اللهُ عَزَّ وجَلَّ وعَدَها، فتعاسَرَت على امرأةِ فرعونَ، وأيقنَتْ بأنَّ اللهَ عَزَّ وجَلَّ يُنْجِزُ موعودَه، فرجَعَتْ إلى بيتِها بابنِها مِن يومِها، فأنبَتَه اللهُ نباتًا حسنًا، وحفِظَه لِمَا قد قَضى فيه، فلم يزَلْ بنو إسرائيلَ وهم في ناحيةِ القريةِ مُمْتنعينَ يَمْتنعونَ به مِن السُّخرةِ ما كان فيهم.\nفلمَّا تَرعرَعَ قالت امرأةُ فرعونَ لأُمِّ مُوسى: أريدُ أنْ تُرِيني ابني، فوعَدَتْها يومًا تُرِيها فيه إيَّاه، فقالتِ امرأةُ فِرعونَ لخُزَّانِها، وظُؤورتِها، وقَهارِمَتِها: لا يَبْقينَّ أحدٌ منكم إلَّا استقبَلَ ابني اليومَ بهَديَّةٍ وكَرامةٍ؛ لِأَرى ذلك فيه، وأنا باعثةٌ أمينًا يُحْصِي ما يصنَعُ كلُّ إنسانٍ منكم، فلم تَزَلِ الهدايا والكرامةُ والنِّحلةُ، تَستقبِلُه مِن حينِ خرَجَ مِن بيتِ أُمِّه إلى أنْ دخَلَ على امرأةِ فرعونَ، فلمَّا دخَلَ عليها بجَّلَتْه، وأكرمَتْه، وفرِحَت به، وأعجَبَها، ونحَلَت أُمَّه؛ لحُسْنِ أثَرِه، ثمَّ قالت: لآتيَنَّ به فِرعونَ، فليَنْحَلَنَّه، وليُكْرِمَنَّه، فلمَّا دخَلَتْ به عليه، جعَلَه في حِجْرِه، فتناوَلَ مُوسى لِحيةَ فرعونَ، فمَدَّها إلى الأرضِ، فقال الغواةُ مِن أعداءِ اللهِ لفرعونَ: ألَا ترى إلى ما وعَدَ اللهُ عَزَّ وجَلَّ إبراهيمَ نَبِيَّه عليه السَّلامُ أنَّه يرِثُك، ويَعْلوك، ويصرَعُك، فأرسَلَ إلى الذَّبَّاحينَ، وذلك مِن الفُتونِ يا ابنَ جُبيرٍ، بعدَ كلِّ بلاءٍ ابتُلِيَ به، أو أُرِيدَ به فُتونًا.\nفجاءت امرأةُ فِرعونَ تَسْعى إلى فرعونَ، فقالت: ما بدا لك في هذا الغلامِ الَّذي وهَبْتَه لي؟ قال: ألَا تَرَيْنَه يزعُمُ أنَّه يصرَعُني ويَعْلوني؟ قالت: اجْعَلْ بيني وبينك أمرًا تعرِفُ فيه الحقَّ؛ ائْتِ بجَمْرتينِ ولُؤلؤتَينِ، فقَرِّبْهما إليه، فإنْ بطَش باللُّؤلؤتَينِ واجتنَبَ الجَمْرتينِ، عرَفْتَ أنَّه يعقِلُ، وإنْ تَناوَلَ الجَمْرتَينِ ولم يُرِدِ اللُّؤلؤتَينِ، علِمْتَ أنَّ أحدًا لا يُؤثِرُ الجَمرتينِ على اللُّؤلؤتينَ وهو يعقِلُ، فقُرِّبَ ذلك إليه، فتناوَلَ الجَمرتَينِ، فانْتَزَعوهما مِن يَدِه، وخافت أنْ يحرِقَا يدَيْه، فقالت المرأةُ: ألَا ترى؟! فصرَفَه اللهُ عنه بعدما كان قد هَمَّ به، وكان الله عَزَّ وجَلَّ بالغًا فيه أمْرَه.\nفلمَّا بلَغَ أشُدَّه وصار مِن الرِّجالِ، لم يكُنْ أحدٌ مِن آلِ فِرعونَ يخلُصُ إلى أحدٍ مِن بني إسرائيلَ معه بظُلمٍ، ولا يخرُجُ حتَّى امْتَنعوا كلَّ الامتناعِ.\nفبينما مُوسى عليه السَّلامُ يَمْشي في ناحيةِ المدينةِ، إذ هو برجُلينِ يَقْتتلانِ؛ أحدُهما فرعونيٌّ، والآخرُ إسرائيليٌّ، فاستغاثَه الإسرائيليُّ على الفرعونيِّ، فغضِبَ مُوسى عليه السَّلامُ غضبًا شديدًا؛ لأنَّه تناوَلَ وهو يعلَمُ منزلةَ مُوسى عليه السَّلامُ مِن بَني إسرائيلَ، وحِفْظَه لهم، لا يعلَمُ النَّاسُ إلَّا إنَّما ذلك مِن الرَّضاعِ إلَّا أُمُّ مُوسى، إلَّا أنْ يكونَ اللهُ عَزَّ وجَلَّ أَطْلَعَ مُوسى عليه السَّلامُ مِن ذلك على ما لم يُطْلِعْ عليه غيرَه. فوكَزَ مُوسى عليه السَّلامُ الفرعونيَّ، فقتَلَه، وليس يراهما أحدٌ إلَّا اللهُ عَزَّ وجَلَّ، فقال مُوسى عليه السَّلامُ حين قتَلَ الرَّجلَ: هذا مِن عمَلِ الشَّيطانِ؛ إنَّه عدُوٌّ مُضِلٌّ مُبينٌ، ثمَّ قال: {رَبِّ إِنِّي ظَلَمْتُ}، إلى قولِه: {إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ} [القصص: 16].\n{فَأَصْبَحَ فِي الْمَدِينَةِ خَائِفًا يَتَرَقَّبُ} [القصص: 18] الأخبارَ، فأُتِيَ فِرعونُ فقيلَ: إنَّ بني إسرائيلَ قد قتَلَتْ رجُلًا مِن آلِ فرعونَ، فخُذْ لنا بحَقِّنا، ولا تُرخِّصْ لهم، فقال: ابْغُوني قاتِلَه ومَن شهِدَ عليه؛ فإنَّ الملِكَ وإنْ كان صَفْوُه مع قومِه، لا يستقيمُ له أنْ يُقِيدَ بغيرِ بيِّنةٍ، ولا ثَبَتٍ، فانْظُروا في عِلْمِ ذلك آخُذْ لكم بحَقِّكم، فبينا هم يَطوفونَ لا يَجِدونَ شيئًا، إذا موسى عليه السَّلامُ قد رأى في الغدِ ذلك الإسرائيليَّ يقتُلُ رجُلًا مِن آلِ فرعونَ آخرَ، فاستغاثَه الإسرائيليُّ على الفرعونيِّ، فصادَفَ مُوسى عليه السَّلامُ قد ندِمَ على ما كان منه، فكَرِهَ الَّذي رأى، فغضِبَ الإسرائيليُّ وهو يُريدُ أنْ يبطِشَ بالفرعونيِّ، فقال للإسرائيليِّ -لِمَا فعَلَ أمسِ واليومَ-: {إِنَّكَ لَغَوِيٌّ مُبِينٌ} [القصص: 18]. فنظَرَ الإسرائيليُّ إلى مُوسى عليه السَّلامُ بعدما قال له ما قال، فإذا هو غضبانُ كغضَبِه بالأمسِ الَّذي قتَلَ به الفرعونيَّ، فخاف أنْ يكونَ بعدما قال له: {إِنَّكَ لَغَوِيٌّ مُبِينٌ} إيَّاه أراد، ولم يكُنْ أراده، إنَّما أراد الفرعونيَّ، فخاف الإسرائيليُّ، فحاجَزَ الفرعونيَّ، فقال: {يَا مُوسَى أَتُرِيدُ أَنْ تَقْتُلَنِي كَمَا قَتَلْتَ نَفْسًا بِالْأَمْسِ} [القصص: 19]؟ وإنَّما قال ذلك؛ مخافةَ أنْ يكون إيَّاهُ أراد مُوسى عليه السَّلامُ أنْ يقتُلَه، فتنازَعَا. فانطلَقَ الفرعونيُّ إلى قومِه، فأخبَرَهم بما سمِعَ مِن الإسرائيليِّ مِن الخبرِ حين يقولُ: {أَتُرِيدُ أَنْ تَقْتُلَنِي كَمَا قَتَلْتَ نَفْسًا بِالْأَمْسِ} [القصص: 19]، فأرسَلَ فرعونُ الذَّبَّاحينَ ليقتُلوا موسى عليه السَّلامُ، فأخَذَ رُسلُ فرعونَ الطَّريقَ الأعظمَ يَمْشون على هَيئتِهم يطلُبونَ مُوسى عليه السَّلامُ، وهم لا يخافونَ أنْ يفوتَهم، فجاء رجُلٌ مِن شِيعَةِ مُوسى عليه السَّلامُ مِن أَقْصى المدينةِ، فاختصَرَ طريقًا قريبًا حتَّى سبَقَهم إلى موسى عليه السَّلامُ فأخْبَرَه. فذلك مِن الفُتونِ يا ابنَ جُبيرٍ.\nفخرَجَ مُوسى عليه السَّلامُ مُتوجِّهًا نحوَ مدينَ لم يلْقَ بلاءً قبلَ ذلك، وليس له علمٌ بالطَّريقِ إلَّا حُسْنَ الظَّنِّ بربِّه عَزَّ وجَلَّ، فإنَّه قال: {عَسَى رَبِّي أَنْ يَهْدِيَنِي سَوَاءَ السَّبِيلِ} [القصص: 22].\n{وَلَمَّا وَرَدَ مَاءَ مَدْيَنَ وَجَدَ عَلَيْهِ أُمَّةً مِنَ النَّاسِ يَسْقُونَ} إلى {تَذُودَانِ} [القصص: 23]، يعني بذلك: حابستَينِ غنَمَهما، فقال لهما: ما خطْبُكما مُعتزلتَينِ لا تَسْقيانِ مع النَّاسِ؟ قالتا: ليس لنا قُوَّةٌ نُزاحِمُ القومَ، وإنَّما ننتظِرُ فُضولَ حياضِهم، فسقى لهما، فجعَلَ يغرِفُ بالدَّلْوِ ماءً كثيرًا، حتَّى كانتا أوَّلَ الرِّعاءِ فراغًا، فانصرَفَتا بغنَمِهما إلى أبيهما، وانصرَفَ موسى عليه السَّلامُ، فاستظَلَّ بشجرةٍ، وقال: {رَبِّ إِنِّي لِمَا أَنْزَلْتَ إِلَيَّ مِنْ خَيْرٍ فَقِيرٌ} [القصص: 24]، فاستنكَرَ أبوهما سُرعةَ صُدورِهما بغنَمِهما حُفَّلًا بطانًا، فقال: إنَّ لكما اليومَ لشأنًا، فأخبَرَتَاه بما صنَعَ موسى عليه السَّلامُ، فأمَرَ إحداهما أنْ تَدْعُوَه له، فأتَتْ موسى عليه السَّلامُ فدَعَتْه، فلمَّا كلَّمَه قال: {لَا تَخَفْ نَجَوْتَ مِنَ الْقَوْمِ الظَّالِمِينَ} [القصص: 25]، ليس لفِرعونَ ولا لقومِه علينا سُلطانٌ، ولسْنا في مَمْلكتِه.\nقال: فقالت إحداهما: {يَا أَبَتِ اسْتَأْجِرْهُ إِنَّ خَيْرَ مَنِ اسْتَأْجَرْتَ الْقَوِيُّ الْأَمِينُ} [القصص: 26]، فاحتمَلَتْه الغَيرةُ على أنْ قال: وما يُدريكِ ما قُوَّتُه؟ وما أمانَتُه؟ قالت: أمَّا قُوَّتُه: فما رأيْتُ في الدَّلوِ حين سَقى لنا، لم أرَ رجُلًا قطُّ في ذلك المَسْقى أقوى منه، وأمَّا أمانَتُه: فإنَّه نظَرَ إليَّ حين أقبلْتُ إليه وشَخَصْتُ له، فلمَّا علِمَ إنِّي امرأةٌ، صوَّبَ رأْسَه لم يرفَعْه، ولم ينظُرْ إليَّ حتَّى بلَّغْتُه رِسالتَك، ثمَّ قال لي: امشِي خلفي، وانْعَتي لي الطَّريقَ، لم يفعَلْ هذا إلَّا وهو أمينٌ، فسُرِّيَ عن أبيها وصدَّقَها، وظَنَّ به الَّذي قالت له.\nفقال له: هل لك {أَنْ أُنْكِحَكَ إِحْدَى ابْنَتَيَّ هَاتَيْنِ}، إلى قوله: {مِنَ الصَّالِحِينَ} [القصص: 27]، ففعَلَ، فكانت على نَبِيِّ اللهِ موسى عليه السَّلامُ ثمانيَ سنينَ واجبةً، وكانت سنتانِ عِدَةً منه، فقَضَى اللهُ عَزَّ وجَلَّ عنه عِدَتَه فأتمَّها عشْرًا.\nقال سَعيدٌ: فلَقِيَني رجُلٌ مِن أهلِ النَّصرانيَّةِ مِن عُلمائِهم، فقال: هلْ تَدْري أيَّ الأجلينِ قضى مُوسى عليه السَّلامُ؟ قلْتُ: لا، وأنا يومئذٍ لا أدري، فلقِيتُ ابنَ عبَّاسٍ، فذكَرْتُ ذلك له، فقال: أمَا علِمْتَ أنَّ ثمانيًا كانت على نبيِّ اللهِ عليه السَّلامُ واجبةً، لم يكُنْ نبيُّ اللهِ ليَنْقُصَ منها شيئًا، وتعلَمُ أنَّ اللهَ عَزَّ وجَلَّ كان قاضيًا عن مُوسى عليه السَّلامُ عِدَتَه الَّتي وعَدَ، فإنَّه قضى عشْرَ سنينَ. فلقِيتُ النَّصرانيَّ، فأخبَرْتُه بذلك، فقال: الَّذي سألْتَه فأخبَرَك أعلَمُ منك بذلك؟ قلْتُ: أجلْ، وأَولى.\nفلمَّا سار مُوسى عليه السَّلامُ بأهلِه كان مِن أمْرِ النَّارِ ما قَصَّ اللهُ عليك في القُرآنِ، وأمْرِ العصا ويَدِه، فشكا إلى ربِّه عَزَّ وجَلَّ ما يتخوَّفُ مِن آلِ فرعونَ في القتيلِ، وعُقدةَ لسانِه، فآتاهُ اللهُ عَزَّ وجَلَّ سُؤْلَه، وحَلَّ عُقدةً مِن لسانِه، وأوحى اللهُ عَزَّ وجَلَّ إلى هارونَ عليه السَّلامُ، وأمَرَه أنْ يلقاهُ، واندفَعَ مُوسى عليه السَّلامُ بعصاهُ، حتَّى لقِيَ هارونَ عليه السَّلامُ، وانطلَقَا جميعًا إلى فرعونَ، فأقاما حِينًا على بابِه لا يُؤْذَنُ لهما، فقالا: إنَّا رسولَا ربِّك، قال: فمَن ربُّكما يا موسى؟ فأخبراهُ بالَّذي قَصَّ اللهُ عَزَّ وجَلَّ عليك في القُرآنِ، قال: فما تُريدانِ؟ وذكَّرَه القتيلَ، واعتذَرَ بما قد سمِعْتَ، وقال: أريدُ أنْ تُؤمِنَ باللهِ، وأنْ تُرْسِلَ معي بني إسرائيلَ، فأبى عليه، وقال: ائتِ بآيةٍ إنْ كنْتَ مِن الصَّادقينَ، فألقى عصاه فإذا هي حيَّةٌ عظيمةٌ، فازعةٌ، فاغرةٌ فاها، مُسرعةٌ إلى فرعونَ، فلمَّا رآها فِرعونُ قاصدةً إليه خافها، فاقتحَمَ عن سَريرِه، واستغاثَ بمُوسى عليه السَّلامُ أنْ يكُفَّها عنه، ففعَلَ، ثمَّ أخرَجَ يَدَه مِن جَيْبِه، فرآها بيضاءَ مِن غيرِ سُوءٍ، يعني: مِن غيرِ برَصٍ، فرَدَّها، فعادت إلى لونِها الأوَّلِ.\nفاستشارَ الملَأَ حولَه فيما رأى، فقالوا له: {هَذَانِ لَسَاحِرَانِ يُرِيدَانِ أَنْ يُخْرِجَاكُمْ مِنْ أَرْضِكُمْ} [طه: 63] الآيةَ، والمُثْلى: مُلْكُهم الَّذي هم فيه والعيشُ. فأَبَوا على مُوسى عليه السَّلامُ أنْ يُعْطُوه شيئًا ممَّا طلَبَ، وقالوا له: اجمَعْ لهما السَّحرةَ؛ فإنَّهم بأرضِك كثيرٌ، حتَّى نغلِبَ سِحْرَهما، وأرسَلَ في المدائنِ، فحُشِرَ له كلُّ ساحرٍ مُتعالمٍ، فلمَّا أَتَوا على فرعونَ، قالوا: ما يعمَلُ هذا السَّاحرُ؟ قالوا: يعمَلُ الحيَّاتِ، قالوا: فلا واللهِ ما أحدٌ في الأرضِ يعمَلُ السِّحرَ والحيَّاتِ والحبالَ والعِصِيَّ الَّذي نعمَلُ، فما أجْرُنا إنْ نحن غلَبْنا؟ قال لهم: أنتم أقاربي وخاصَّتي، وأنا صانعٌ إليكم كلَّ شَيءٍ أحببتم، فتَواعَدوا يومَ الزِّينةِ وأنْ يُحْشَرَ النَّاسُ ضُحًى.\nقال سعيدٌ: فحدَّثني ابنُ عبَّاسٍ: أنَّ يومَ الزِّينةِ اليومُ الَّذي أظهَرَ اللهُ عَزَّ وجَلَّ فيه مُوسى عليه السَّلامُ على فِرعونَ والسَّحرةِ هو يومُ عاشوراءَ.\nفلمَّا اجتمعوا في صَعيدٍ، قال النَّاسُ بعضُهم لبعضٍ: انطَلِقوا، فنتخبَّرْ هذا الأمْرَ، {لَعَلَّنَا نَتَّبِعُ السَّحَرَةَ إِنْ كَانُوا هُمُ الْغَالِبِينَ} [الشعراء: 40]، يعنون مُوسى وهارونَ عليهما السَّلامُ؛ استهزاءً بهما، فقالوا: يا موسى -لِقُدْرتِهم في أنفُسِهم بسِحْرِهم- إمَّا أنْ تُلْقِيَ، وإمَّا أنْ نكونَ نحن المُلْقينَ، قال: بل ألْقُوا. {فَأَلْقَوْا حِبَالَهُمْ وَعِصِيَّهُمْ وَقَالُوا بِعِزَّةِ فِرْعَوْنَ إِنَّا لَنَحْنُ الْغَالِبُونَ} [الشعراء: 44]، فرأى مُوسى عليه السَّلامُ مِن سِحْرِهم ما أوجَسَ في نفْسِه خِيفةً، فأوحى اللهُ عَزَّ وجَلَّ إليه: أنْ ألْقِ عصاك، فلمَّا ألقاها، صارت ثُعبانًا عظيمًا فاغرةً فاها، فجُعِلَتِ العِصِيُّ بدَعوةِ مُوسي عليه السَّلامُ تلتبِسُ بالحبالِ، حتَّى صارتْ جُرُزًا إلى الثُّعبانِ تَدخُل فيه، حتَّى ما أبقَتْ عصًا ولا حبلًا إلَّا ابتلعَتْه. فلمَّا عرَفَ السَّحرةُ ذلك، قالوا: لو كان هذا سِحرٌ لم يَبلُغْ مِن سِحرِنا كلَّ هذا، ولكنَّه أمْرٌ مِن اللهِ، آمنَّا باللهِ ربِّنا وما جاء به مُوسى عليه السَّلامُ، ونتوبُ إلى اللهِ عَزَّ وجَلَّ ممَّا كنَّا عليه. وكسَرَ اللهُ ظهْرَ فِرعونَ في ذلك الموطنِ وأشياعِه، وأظهَرَ الحقَّ، وبطَلَ ما كانوا يعمَلونَ، فغُلِبوا هنالك وانقَلَبوا صاغِرينَ. وامرأةُ فِرعونَ بارزةٌ مُتبذِّلَةٌ تَدْعو بالنَّصرِ لمُوسى عليه السَّلامُ على فِرعونَ، فمَن رآها مِن آلِ فرعونَ ظَنَّ أنَّها إنَّما تبذَّلَتْ للشفقةِ على فِرعونَ وأشياعِه، وإنَّما كان حُزْنُها وهمُّها لمُوسى عليه السَّلامُ. فلمَّا طال مُكْثُ مُوسى عليه السَّلامُ لمواعيدِ فِرعونَ الكاذبةِ، كلَّما جاءه بآيةٍ وعَدَه عندها أنْ يُرْسِلَ معه بني إسرائيلَ، فإذا مضَتْ أخلَفَ موعِدَه، وقال: هل يستطيعُ ربُّك أنْ يصنَعَ غيرَ هذا؟ فأرسَلَ اللهُ عليه وعلى قومِه الطُّوفانَ، والجرادَ، والقُمَّلَ، والضَّفادعَ، آياتٍ مُفصَّلاتٍ، كلُّ ذلك يَشْكو إلى موسى عليه السَّلامُ، ويطلُبُ إليه أنْ يكُفَّها عنه، ويُواثِقُه على أنْ يُرسِلَ معه بني إسرائيلَ، فإذا كَفَّ ذلك عنه، أخلَفَ موعِدَه ونكَثَ عهدَه. فأُمِرَ موسى عليه السَّلامُ بالخُروجِ بقومِه، فخرَجَ بهم ليلًا، فلمَّا أصبَحَ فرعونُ ورأى أنَّهم قد مَضَوا، أرسَلَ في المدائنِ حاشرينَ، فتبِعَهم بجُنودٍ عظيمةٍ كثيرةٍ، وأوحى اللهُ عَزَّ وجَلَّ إلى البحرِ: أنْ إذا ضرَبَك مُوسى بعصاهُ، فانفرِقْ له اثنتَيْ عشْرةَ فِرقةً، حتَّى يجوزَ موسى عليه السَّلامُ ومَن معه، ثمَّ الْتَئَمَ على مَن بقِيَ بعدُ مِن فرعونَ وأشياعِه، فنسِيَ مُوسى عليه السَّلامُ أنْ يضرِبَ البحرَ بالعصا، فانْتَهى إلى البحرِ وله قصيفٌ؛ مخافةَ أنْ يَضرِبَه موسى عليه السَّلامُ، وهو غافِلٌ، فيصيرَ عاصيًا اللهَ عَزَّ وجَلَّ. فلمَّا تراءى الجَمْعانِ وتقارَبَا، قال أصحابُ موسى: إنَّا لمُدْرَكونَ، افعَلْ ما أمرَكَ به ربُّك عَزَّ وجَلَّ؛ فإنَّك لم تكذِبْ ولم تُكْذَبْ، فقال: وعَدَني ربِّي عَزَّ وجَلَّ إذا أتيْتُ البحرَ، انفرَقَ لي اثنتيْ عشْرةَ فِرقةً حتَّى أُجاوزَه، ثمَّ ذكَرَ بعدَ ذلك العصا، فضرَبَ البحرَ بعصاه حين دنا أوائلُ جُندِ فرعونَ مِن أواخرِ جُندِ مُوسى عليه السَّلامُ، فانفرَقَ البحرُ كما أمَرَه اللهُ عَزَّ وجَلَّ، وكما وُعِدَ مُوسى عليه السَّلامُ، فلمَّا أنْ جاوَزَ موسى عليه السَّلامُ وأصحابُه البحرَ، ودخَلَ فِرعونُ وأصحابُه، الْتَقى عليهم البحرُ كما أُمِرَ. فلمَّا جاوَزَ مُوسى عليه السَّلامُ البحرَ، قال أصحابُه: إنَّا نخافُ ألَّا يكونَ فِرعونُ قد غرِقَ، فلا نُؤمِنُ بهلاكِه، فدعا ربَّه عَزَّ وجَلَّ، فأخرَجَه له ببدنه حتَّى استيْقَنوا بهلاكِه.\nثمَّ مَرُّوا بعدَ ذلك {عَلَى قَوْمٍ يَعْكُفُونَ عَلَى أَصْنَامٍ لَهُمْ قَالُوا يَا مُوسَى اجْعَلْ لَنَا إِلَهًا كَمَا لَهُمْ آلِهَةٌ} [الأعراف: 138]، إلى {وَبَاطِلٌ مَا كَانُوا يَعْمَلُونَ} [الأعراف: 139]، قد رأيتُمْ مِن العِبَرِ، وسمِعْتُم ما يَكْفيكم، ومَضَى. فأنزَلَهم مُوسى عليه السَّلامُ منزلًا، ثمَّ قال لهم: أطيعوا هارونَ عليه السَّلامُ؛ فإنِّي قد استخلفْتُه عليكم، وإنِّي ذاهبٌ إلى ربِّي عَزَّ وجَلَّ، وأجَّلَهم ثلاثينَ يومًا أنْ يَرجِعَ إليهم فيها، فلمَّا أتى ربَّه وأراد أنْ يُكلِّمَه ثلاثينَ يومًا، وقد صامهنَّ: ليلَهنَّ ونهارَهنَّ، وكرِهَ أنْ يُكلِّمَ ربَّه عَزَّ وجَلَّ ورِيحُ فَمِه رِيحُ فَمِ الصَّائمِ، فتناوَلَ مُوسى عليه السَّلامُ مِن نباتِ الأرضِ شيئًا فمضَغَه، فقال له ربُّه عَزَّ وجَلَّ حين لقاه: لِمَ أفطرْتَ؟ -وهو أعلَمُ بالَّذي كان- قال: يا ربِّ، إنِّي كرِهْتُ أنْ أُكلِّمَك إلَّا وفَمِي طيِّبُ الرِّيحِ، قال: أوما علِمْتَ يا مُوسى أنْ رِيحَ فَمِ الصَّائمِ أطيبُ عندي مِن رِيحِ المِسْكِ؟ ارجِعْ حتَّى تصومَ عشْرًا ثمَّ ائْتِني، ففعَلَ مُوسى عليه السَّلامُ ما أُمِرَ به.\nفلمَّا رأى قومُ مُوسى عليه السَّلامُ أنَّه لم يرجِعْ إليهم للأجَلِ ساءَهم ذلك، وكان هارونُ عليه السَّلامُ قد خطَبَهم، فقال لهم: خرجْتُم مِن مِصْرَ ولقومِ فرعونَ عندي عواري وودائعُ، ولكم فيهم مثلُ ذلك، وأنا أرى أنْ تحتَسِبوا ما لكم عندهم، ولا أحلَّ لكم وديعةً اسْتُودِعْتُمُوها، ولا عاريَّةً، ولسنا برادِّين إليهم شيئًا مِن ذلك، ولا مُمْسِكيه لأنفُسِنا، فحفَرَ حفيرًا، وأمَرَ كلَّ قومٍ عليهم شَيءٌ مِن ذلك؛ مِن متاعٍ أو حِليةٍ أنْ يَقْذِفوه في ذلك الحفيرِ، ثمَّ أوقَدَ عليه النَّارَ، فأحرَقَه، فقال: لا يكونُ لنا، ولا لهم.\nوكان السَّامريُّ رجلًا مِن قومٍ يَعْبُدون البقرَ جيرانٍ لهم، ولم يكُنْ مِن بني إسرائيلَ، فاحتملَ مع مُوسى عليه السَّلامُ وبني إسرائيلَ حين احْتملوا، فقُضِيَ له أنْ رأى أثرًا، فأخَذَ منه بقبْضَتِه، فمَرَّ بهارونَ، فقال له هارونُ عليه السَّلامُ: يا سامريُّ، ألَا تُلْقي ما في يدَيْك؟ وهو قابضٌ عليه لا يَراه أحدٌ طوالَ ذلك، فقال: هذه قبْضةٌ مِن أثرِ الرَّسولِ الَّذي جاوَزَ بكم البحرَ، ولا أُلْقيها لشَيءٍ إلَّا أنْ تَدْعُوَ اللهَ إذا ألقيْتُها أنْ تكونَ ما أُرِيدُ، فألْقاها، ودعا اللهَ هارونُ عليه السَّلامُ، فقال: أريدُ أنْ يكونَ عِجْلًا، واجتمَعَ ما كان في الحُفرةِ مِن متاعٍ له، أو حِلْيةٍ، أو نحاسٍ، أو حديدٍ، فصار عِجْلًا أجوفَ ليس فيه رُوحٌ، له خُوارٌ.\nقال ابنُ عبَّاسٍ: لا واللهِ ما كان له صوتٌ قطُّ، إنَّما كانت الرِّيحُ تدخُلُ مِن دُبُرِه وتخرُجُ مِن فَمِه، فكان ذلك الصَّوتُ مِن ذلك.\nفتفرَّقَ بنو إسرائيلَ فِرَقًا؛ فقالت فِرقةٌ: يا سامريُّ، ما هذا فأنت أعلَمُ به؟ قال: هذا ربُّكم عَزَّ وجَلَّ، ولكنَّ مُوسى عليه السَّلامُ أضَلَّ الطَّريقَ. وقالت فِرقةٌ: لا نُكذِّب بهذا حتَّى يرجِعَ إلينا مُوسى، فإنْ كان ربَّنا لم نكُنْ ضيَّعْناه وعجَزْنا فيه حِينَ رأيْناه، وإنْ لم يكُنْ ربَّنا، فإنَّا نتَّبِعُ قولَ مُوسى عليه السَّلامُ. وقالت فِرقةٌ: هذا عمَلُ الشَّيطانِ، وليس بربِّنا، ولا نُؤْمِنُ، ولا نُصدِّقُ.\nوأُشْرِبَ فِرقةٌ في قُلوبِهم التَّصديقَ بما قال السَّامريُّ في العجلِ، وأعْلَنوا التَّكذيبَ، فقال لهم هارونُ عليه السَّلامُ: {يَا قَوْمِ إِنَّمَا فُتِنْتُمْ بِهِ} [طه: 90]، وإنَّ ربَّكم ليس هكذا، قالوا: فما بالُ مُوسى عليه السَّلامُ؛ وعَدَنا ثلاثينَ يومًا ثمَّ أخلَفَنا، فهذه أربعونَ قد مَضَت؟! فقال سُفهاؤُهم: أخطَأَ ربَّه، فهو يطلُبُه ويتبَعُه. فلمَّا كلَّمَ اللهُ عَزَّ وجَلَّ مُوسى عليه السَّلامُ وقال له ما قال، أخبَرَه بما لقِيَ قومُه بعده. {فَرَجَعَ مُوسَى إِلَى قَوْمِهِ غَضْبَانَ أَسِفًا} [طه: 86]، وقال لهم ما سمِعْتُم في القُرآنِ وأخَذَ برأْسِ أخِيه، وألْقى الألواحَ مِن الغضَبِ، ثمَّ عذَرَ أخاه بعُذْرِه، واستغفَرَ له، وانصرَفَ إلى السَّامريِّ، فقال له: ما حمَلَك على ما صنعْتَ؟ قال: قبَضْتُ قبضةً مِن أثرِ الرَّسولِ وفطِنْتُ لها، وعُمِّيَت عليكم، فقَذفْتُها؛ وكذلك سوَّلَت لي نَفْسي.\nقال: {اذْهَبْ فَإِنَّ لَكَ فِي الْحَيَاةِ أَنْ تَقُولَ لَا مِسَاسَ وَإِنَّ لَكَ مَوْعِدًا لَنْ تُخْلَفَهُ وَانْظُرْ إِلَى إِلَهِكَ} إلى قولِه: {نَسْفًا} [طه: 97]، ولو كان إلهًا لم يُخْلَصْ إلى ذلك منه. فاستيقَنَ بنو إسرائيلَ بالفتنةِ، واغْتَبَطَ الَّذين كان رأيُهم فيه مثلَ رأيِ هارونَ عليه السَّلامُ، فقالوا بجماعتِهم لمُوسى عليه السَّلامُ: سَلْ لنا ربَّك عَزَّ وجَلَّ أنْ يفتَحَ لنا بابَ توبةٍ نصنَعُها؛ فيُكَفِّرَ عنَّا ما عمِلْنا، فاختارَ موسى عليه السَّلامُ قومَه سبعينَ رجُلًا لذلك -لا يأْلُو الخيرَ- خيارَ بني إسرائيلَ، ومَن لم يُشْرِكْ في العجلِ. فانطلَقَ بهم ليسأَلَ لهم التَّوبةَ، فرجَفَتْ بهم الأرضُ، فاستحيا نبيُّ اللهِ صَلَّى اللهُ عليه وسلَّمَ من قومِه ووفْدِه حين فُعِلَ بهم ما فُعِلَ، فقال: {رَبِّ لَوْ شِئْتَ أَهْلَكْتَهُمْ مِنْ قَبْلُ وَإِيَّايَ أَتُهْلِكُنَا بِمَا فَعَلَ السُّفَهَاءُ مِنَّا} [الأعراف: 155]، وفيهم مَن قد كان اللهُ عَزَّ وجَلَّ اطَّلَعَ على ما أُشْرِبَ قلبُه من حُبِّ العجلِ وإيمانِه به؛ فلذلك رجَفَت بهم الأرضُ.\nفقال: {وَرَحْمَتِي وَسِعَتْ كُلَّ شَيْءٍ فَسَأَكْتُبُهَا لِلَّذِينَ يَتَّقُونَ} [الأعراف: 156] إلى: {فِي التَّوْرَاةِ وَالْإِنْجِيلِ} [الأعراف: 157]، فقال: رَبِّ سألْتُك التَّوبةَ لقومي، فقلْتَ: إنَّ رحمتي كتبْتُها لقومٍ غيرِ قومي، فليتَكَ أخَّرْتَني حين تُخْرِجُني حيًّا في أُمَّةِ ذلك الرَّجلِ المرحومةِ، فقال اللهُ له: إنَّ توبتَهم أنْ يقتُلَ كلُّ رجُلٍ منهم مَن لقِيَ مِن والدٍ أو ولدٍ، فيقتُلَه بالسَّيفِ لا يُبَالي مَن قتَلَ في ذلك الموطنِ، وتاب أولئك الَّذين كان خفِيَ على موسى وهارونَ عليهما السلام ما اطَّلَعُ اللهُ عليهم من ذُنوبِهم، ",["فاعتَرَفوا بها، وفعَلوا ما أُمِروا",1],"، ",["وغفَرَ اللهُ للقاتِلِ والمقتولِ",2],". ثمَّ سار بهم مُوسى عليه السَّلامُ مُتوجِّهًا نحوَ الأرضِ المُقدَّسةِ، وأخَذَ الألواحَ بعدما سكَتَ عنه الغضبُ، وأمَرَهم بالَّذي أُمِرَ به أنْ يُبَلِّغَهم من الوظائفِ، فثقُلَ ذلك عليهم، وأبَوا أنْ يُقِرُّوا بها، فنتَقَ اللهُ عليهم الجبلَ كأنَّه ظُلَّةٌ، ودنا منهم حتَّى خافوا أنْ يقَعَ عليهم، فأخَذُوا الكتابَ بأيمانِهم وهم يَصْغُون ينظُرونَ إلى الجبلِ والأرضِ، والكتابُ بأيديهم وهم يَنظُرونَ إلى الجبلِ؛ مخافةَ أنْ يقَعَ عليهم، ثمَّ مَضَوا إلى الأرضِ المُقدَّسةِ، فوَجَدوا مدينةَ قومٍ جبَّارينَ خَلْقُهم مُنْكرٌ، وذكَرَ من ثِمارِهم أمرًا عجَبًا من عِظَمِها، فقالوا: يا موسى، إنَّ فيها قومًا جبَّارينَ لا طاقةَ لنا بهم، ولا ندخُلُها ما داموا فيها، فإنْ يَخْرجوا منها فإنَّا داخِلونَ، قال رجُلانِ من الَّذين يَخافونَ مِن الجبَّارينَ: آمنَّا بمُوسى عليه السَّلامُ، فخرَجَا إليه، فقالا: نحنُ أعلَمُ بقومِنا، إنْ كنتُمْ إنَّما تَخافونَ ما رأيتُمْ من أجسامِهم وعدَدِهم، فإنَّهم لا قُلوبَ لهم، ولا مَنعةَ عندهم، فادْخُلوا عليهم البابَ، فإذا دخلْتُموه فإنَّكم غالِبونَ. ويقولُ أناسٌ: إنَّهما من قومِ مُوسى عليه السَّلامُ. وزعَمَ سعيدُ بنُ جُبيرٍ أنَّهما من الجبَّارينَ آمَنَا بمُوسى، بقولِه: {مِنَ الَّذِينَ يَخَافُونَ} [المائدة: 23]: إنَّما عَنى بذلك: مِن الَّذين يَخافونَ بني إسرائيلَ.\n{قَالُوا يَا مُوسَى إِنَّا لَنْ نَدْخُلَهَا أَبَدًا مَا دَامُوا فِيهَا فَاذْهَبْ أَنْتَ وَرَبُّكَ فَقَاتِلَا إِنَّا هَاهُنَا قَاعِدُونَ} [المائدة: 24]، فأغْضَبوا مُوسَى عليه السَّلامُ، فدعا عليهم، وسمَّاهم فاسقينَ، ولم يدْعُ عليهم قبلَ ذلك؛ لِمَا رأى منهم من المعصيةِ وإساءتِهم حتَّى كان يومئذٍ، فاستجابَ اللهُ عَزَّ وجَلَّ له، فسمَّاهم كما سمَّاهم مُوسى عليه السَّلامُ فاسقينَ، فحرَّمَها عليهم أربعينَ سَنةً يَتِيهون في الأرضِ؛ يُصْبِحون كلَّ يومٍ، فيَسِيرونَ ليس لهم قرارٌ، ثمَّ ظلَّلَ عليهم الغمامَ في التِّيهِ، وأنزَلَ عليهم المَنَّ والسَّلوى، وجعَلَ لهم ثيابًا لا تَبْلى، ولا تتَّسِخُ، وجعَلَ بين ظَهرِهم حَجرًا مُربَّعًا، وأمَرَ مُوسى عليه السَّلامُ فضرَبَه بعصاهُ، فانفجَرَ منه اثنتا عشْرةَ عينًا، في كلِّ ناحيةٍ ثلاثةُ أعينٍ، وأعلَمَ كلَّ سِبْطٍ عينَهم الَّتي يَشْربون منها، فلا يَرْتحِلونَ من مَنزلٍ إلَّا وجدوا ذلك الحجرَ منهم بالمكانِ الَّذي كان منه أمسِ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (11263)، وأبو يعلى (2618)، والطحاوي في ((شرح مشكل الآثار)) (66) بنحوه.","bab":"تفسير آيات › سورة طه","dorar":"n97bkyvU"},{"id":"س-03983","fp":"d63424ffd00e","stateId":49,"easy":"إذا أخطأت أو أذنبت ثم ندمت ← فندمك كفارته","cause":"من أخطأَ خطيئةً أو أذنبَ ذنبًا ثُمَّ ندِمَ","result":"فَهوَ كفَّارتُه","explicit":true,"ref":"الجامع الصغير 8341","srcLabel":"الطبراني","text":[["من أخطأَ خطيئةً أو أذنبَ ذنبًا ثُمَّ ندِمَ ",1],["فَهوَ كفَّارتُه",2]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"حسن","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (4/14)، والبيهقي في ((شعب الإيمان)) (7033) واللفظ لهما، وأخرجه الطبراني (10/274) (10537) باختلاف يسير","bab":"توبة › الحض على التوبة","dorar":"TYvNsYlZ"},{"id":"س-04004","fp":"1f9c9042be20","stateId":49,"easy":"إذا تبت إلى الله ولو قبل موتك بيوم ← تُقبل توبتك","cause":"لو أذنَب كلَّ ذنبٍ ثمَّ تاب إلى اللهِ قَبلَ موتِه بيومٍ","result":"قُبِلَ منه","explicit":true,"repOf":"س-04012","ref":"مجمع الزوائد 10/201","text":["عن عبدِ اللهِ بنِ سَلَامٍ قال لا أُحَدِّثُكم إلَّا عن نبيٍّ مُرْسَلٍ أو كِتابٍ مُنْزَلٍ إنَّ عبدًا ",["لو أذنَب كلَّ ذنبٍ ثمَّ تاب إلى اللهِ قَبلَ موتِه بيومٍ",1]," ",["قُبِلَ منه",2]],"grade":"حسن","narrator":"[خرشة بن الحر]","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني (جـ 13، 14 (ص: 48)) (14978) واللفظ له، والضبي في ((الدعاء)) (143) بنحوه.","bab":"توبة › الحض على التوبة","dorar":"qimsj1vp"},{"id":"س-04020","fp":"8d0862a993da","stateId":49,"easy":"إذا تبت قبل موتك ولو بيوم ← يُتاب عليك","cause":"مَن تاب قبلَ مَوتِه عامًا","result":"تيبَ عليه، ومَن تاب قبلَ مَوتِه بشهرٍ؛ تيبَ عليه، حتى قال: يومًا، حتى قال: ساعةً، حتى قال: فُوَاقًا","explicit":true,"ref":"تخريج المسند لشعيب 6920","srcLabel":"أحمد","text":["يقولُ: ",["مَن تاب قبلَ مَوتِه عامًا",1],"؛ ",["تيبَ عليه، ومَن تاب قبلَ مَوتِه بشهرٍ؛ تيبَ عليه، حتى قال: يومًا، حتى قال: ساعةً، حتى قال: فُوَاقًا",2],"، قال: قال الرَّجُلُ: أرأَيْتَ إن كان مُشركًا أسلَمَ؟ قال: إنَّما أحدِّثُكم كما سمِعْتُ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ."],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (6920) واللفظ له، والطيالسي (2398)، والحاكم (7664) باختلاف يسير","bab":"توبة › الحض على التوبة","dorar":"xsLmBbYA"},{"id":"س-04026","fp":"e1af0e9a3ed9","stateId":49,"easy":"إذا أذنبت حتى بلغت ذنوبك عنان السماء ثم استغفرت الله ← يغفر لك ولا يبالي","cause":"إنَّكَ إنْ تُذنِبْ حتى يَبلُغَ ذَنبُكَ عَنانَ السماءِ، ثُم تَستَغفِرْني","result":"أغفِرْ لكَ ولا أُبالي","explicit":true,"ref":"تخريج المسند لشعيب 21472","srcLabel":"أحمد","text":["عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ يَرْويهِ عن رَبِّه، قال: ابنَ آدَمَ، إنَّكَ ما دَعَوْتَني، ورَجَوْتَني غَفَرْتُ لكَ على ما كان فيكَ، ابنَ آدَمَ، إنْ تَلْقَني بقُرابِ الأرضِ خَطايا لَقيتُكَ بقُرابِها مَغفِرةً، بعدَ ألَّا تُشرِكَ بي شيئًا، ابنَ آدَمَ، ",["إنَّكَ إنْ تُذنِبْ حتى يَبلُغَ ذَنبُكَ عَنانَ السماءِ، ثُم تَستَغفِرْني ",1],["أغفِرْ لكَ ولا أُبالي",2],"."],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"حسن","takhrij":"أخرجه أحمد (21472) واللفظ له، والدارمي (2788)، والبزار (3988)","bab":"توبة › تبشير التائب بالغفران","dorar":"tO3SI8Jh"},{"id":"س-04600","fp":"2ea1952662df","stateId":49,"easy":"إذا تبت توبة صادقة ← تسع توبتك أمة (من قصة ماعز)","cause":"فوضَعَ يَدَه في يَدِه، ثُمَّ قال: اقتُلْني بالحِجارةِ","result":"لقد تابَ تَوبةً لو قُسِمَت بينَ أُمَّةٍ لَوسِعَتْهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04025","otherNeedIds":[44],"ref":"صحيح مسلم 1695","text":["جاءَ ماعِزُ بنُ مالِكٍ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم، فقال: يا رَسولَ اللهِ، طَهِّرْني، فقال: ويحَكَ! ارجِعْ فاستَغفِرِ اللَّهَ وتُبْ إليه، قال: فرَجَعَ غيرَ بَعيدٍ، ثُمَّ جاءَ، فقال: يا رَسولَ اللهِ، طَهِّرْني، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ويحَكَ! ارجِعْ فاستَغفِرِ اللَّهَ وتُبْ إليه، قال: فرَجَعَ غيرَ بَعيدٍ، ثُمَّ جاءَ، فقال: يا رَسولَ اللهِ، طَهِّرْني، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم مِثلَ ذلك، حتَّى إذا كانَتِ الرَّابِعةُ قال له رَسولُ اللهِ: فيمَ أُطَهِّرُكَ؟ فقال: مِنَ الزِّنى، فسَألَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أبِه جُنونٌ؟ فأُخبِرَ أنَّه ليس بمَجنونٍ، فقال: أشَرِبَ خَمرًا؟ فقامَ رَجُلٌ فاستَنكَهَه، فلَم يَجِدْ منه ريحَ خَمرٍ، قال: فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أزَنَيتَ؟ فقال: نَعَم، فأمَرَ به فرُجِمَ، فكان النَّاسُ فيه فِرقَتَينِ؛ قائِلٌ يقولُ: لقد هَلَكَ؛ لقد أحاطَت به خَطيئَتُه، وقائِلٌ يقولُ: ما تَوبةٌ أفضَلَ مِن تَوبةِ ماعِزٍ؛ أنَّه جاءَ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم ",["فوضَعَ يَدَه في يَدِه، ثُمَّ قال: اقتُلْني بالحِجارةِ",1],"، قال: فلَبِثوا بذلك يَومَينِ أو ثَلاثةً، ثُمَّ جاءَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم وهم جُلوسٌ، فسَلَّمَ ثُمَّ جَلَسَ، فقال: استَغفِروا لماعِزِ بنِ مالِكٍ، قال: فقالوا: غَفَرَ اللهُ لماعِزِ بنِ مالِكٍ، قال: فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["لقد تابَ تَوبةً لو قُسِمَت بينَ أُمَّةٍ لَوسِعَتْهم",2],"! قال: ثُمَّ جاءَتْه امرَأةٌ مِن غامِدٍ مِنَ الأزدِ، فقالت: يا رَسولَ اللهِ، طَهِّرْني، فقال: ويحَكِ! ارجِعي فاستَغفِري اللَّهَ وتوبي إليه، فقالت: أراكَ تُريدُ أن تُرَدِّدَني كما رَدَّدتَ ماعِزَ بنَ مالِكٍ، قال: وما ذاكِ؟ قالت: إنَّها حُبلى مِنَ الزِّنا، فقال: آنتِ؟ قالت: نَعَم، فقال لَها: حتَّى تَضَعي ما في بَطنِكِ، قال: فكَفَلَها رَجُلٌ مِنَ الأنصارِ حتَّى وضَعَت، قال: فأتى النَّبيَّ صلَّى اللهُ عليه وسلَّم، فقال: قد وضَعَتِ الغامِديَّةُ، فقال: إذَنْ لا نَرجُمُها ونَدَعُ ولَدَها صَغيرًا ليس له مَن يُرضِعُه، فقامَ رَجُلٌ مِنَ الأنصارِ، فقال: إليَّ رَضاعُه يا نَبيَّ اللهِ، قال: فرَجَمَها."],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"[صحيح]","takhrij":"أخرجه أبو عوانة في ((المستخرج)) (6732) واللفظ له، والبيهقي في ((الصغير)) (2535) باختلاف يسير، والنسائي في ((الكبرى)) (7125) بلفظه دون قصة الغامدية.","bab":"حدود › من أقر بالحد","dorar":"sL8GdORo"},{"id":"س-07705","fp":"abfd2dce1dd1","stateId":49,"easy":"إذا ارتددت ثم رجعت تائباً ← يقبل الله توبتك (من واقعة)","cause":"فبعَثَ بها قومُه","result":"فرجَعَ تائبًا، فقبِلَ النبيُّ صلَّى اللهُ عليه وسلَّمَ ذلك منه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 2218","srcLabel":"النسائي","text":["أنَّ رجلًا من الأنصارِ ارتَدَّ عن الإسلامِ، ولحِقَ بالمشركينَ، فأنزَلَ اللهُ تعالى: {كَيْفَ يَهْدِي اللهُ قَوْمًا كَفَرُوا بَعْدَ إِيمَانِهِمْ...} [آل عمران: 86] إلى آخِرِ الآيةِ، ",["فبعَثَ بها قومُه",1],"، ",["فرجَعَ تائبًا، فقبِلَ النبيُّ صلَّى اللهُ عليه وسلَّمَ ذلك منه",2],"، وخلَّى عنه."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه النسائي (11065)، وأحمد (2218) واللفظ له","bab":"قرآن › أسباب النزول","dorar":"9HULEn8v"},{"id":"س-04017","fp":"3cc231783840","stateId":49,"easy":"إذا أذنبت فاستغفرت ← يغفر الله لك","cause":"بقَومٍ لهم ذُنوبٌ","result":"يَغفِرُها لهم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-07061","ref":"صحيح مسلم 2748","text":["لَو أنَّكُم لم تَكُنْ لَكُم ذُنوبٌ يَغفِرُها اللهُ لَكُم، لَجاءَ اللهُ ",["بقَومٍ لهم ذُنوبٌ",1]," ",["يَغفِرُها لهم",2],"."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"توبة › الحض على التوبة","dorar":"MpTnTYBI","merged":2,"otherRefs":["المستدرك على الصحيحين 7831 (صحيح)"]},{"id":"س-06972","fp":"70bb9dee3a7b","stateId":49,"easy":"إذا استغفرت في جوف الليل ← يغفر الله لك إلا الشرك والبغي","cause":"في جوفِ اللَّيلِ","result":"فيغفِرُ إلَّا ما كان من الشِّركِ والبَغيِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"apply":{"k":"time","t":"في الليل"},"ref":"التمهيد 4/15","srcLabel":"مسلم","text":["عن عمرِو بنِ عَبْسةَ قال : أتيتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم وهو بعُكاظٍ قلتُ من معك على هذا الأمرِ ؟ قال : حُرٌّ وعبدٌ ومعه أبو بكرٍ وبلالٌ ثمَّ قال : فارجِعْ حتَّى يمكِّنَ اللهُ لرسولِه قال فأتيتُه بعدُ فقلتُ يا رسولَ اللهِ - جعلني اللهُ فداك - شيئَّا تَعلمُه وأجهلُه لا يضُرُّك وينفعُني اللهُ به ، هل من ساعةٍ أفضلُ من ساعةٍ ؟ وهل من ساعةٍ لا يُصلَّى فيها ؟ قال لقد سألتني عن شيءٍ ما سألني عنه أحدٌ ، إنَّ اللهَ تبارك وتعالَى ينزِلُ ",["في جوفِ اللَّيلِ",1]," ",["فيغفِرُ إلَّا ما كان من الشِّركِ والبَغيِ",2]," والصَّلاةُ مشهودةٌ ، فصَلِّ حتَّى تطلُعَ الشَّمسُ فإذا طلعت فأقصِرْ فإنَّها تطلُعُ على قرْنِ شيطانٍ وهي صلاةُ الكفَّارِ حتَّى ترتفعَ فإذا استقلَّت الشَّمسُ فصَلِّ ، فإنَّ الصَّلاةِ مشهودةٌ محضورةٌ حتَّى يعتدِلَ النَّهارُ فإذا اعتدل النَّهارُ فأقصِرْ عن الصَّلاةِ فإنَّها ساعةٌ تُسجَرُ فيها جهنَّمُ حتَّى يفيءَ الفيْءُ فإذا أفاء الفيْءُ فصَلِّ فإنَّ الصَّلاةَ محضورةٌ مشهودةٌ حتَّى تدنوَ الشَّمسُ للغروبِ فإذا تدلَّت فاقصِر عن الصَّلاةِ فإنَّها تغيبُ على قرْنِ شيطانٍ وهي صلاةُ الكفَّارِ"],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (832) ، وأبو داوود (1277) ، وابن خزيمة في ((صحيحه)) (260) ، والحاكم في ((مستدركه)) (584) جميعا بمعناه مطولا .","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"qFFA6fOq"},{"id":"س-04045","fp":"1991496308ed","stateId":49,"easy":"إذا تبت وتركت أرض المعصية إلى أرض الصالحين ← يغفر الله لك ولو كثرت ذنوبك","cause":"فتوجَّهَ إليهم","result":"فغُفُِرَ لَهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-04163"],"ref":"الزواجر عن اقتراف الكبائر 2/238","srcLabel":"الزواجر عن اقتراف الكبائر","text":["أنَّ رجلًا أسرفَ على نفسِهِ فلقيَ رجلًا فقالَ إنَّ الآخرَ قتلَ تسعًا وتسعينَ نفسًا كلَّهم ظُلمًا فَهل تجدُ لي من توبةٍ قالَ لا فقتلَهُ وأتى آخرَ فقالَ إنَّ الآخرَ قتلَ مائةَ نفسٍ كلَّها ظلمًا فَهل تجدُ لي من توبةٍ فقالَ إن حدَّثتُك أنَّ اللَّهَ لا يتوبُ على من تابَ كذبتُك هَهنا قومٌ يتعبَّدونَ فأتِهم تعبُدِ اللَّهَ معَهم ",["فتوجَّهَ إليهم",1]," فماتَ على ذلِكَ فاختَصمت ملائِكةُ الرَّحمةِ وملائِكةُ العذابِ فبعثَ اللَّهُ إليهم ملَكًا فقالَ قيسوا ما بينَ المَكانينِ فأيُّهم كانَ أقربَ فَهوَ منهم فوجدوهُ أقربَ إلى ديرِ التَّوَّابينَ بأنملةٍ ",["فغُفُِرَ لَهُ",2]],"grade":"حسن","muhaddith":"إسناده جيد","bab":"توبة › سقوط الذنوب بالاستغفار والتوبة","dorar":"tpJo2oGe"},{"id":"س-04163","fp":"a3fa08451e22","stateId":49,"easy":"إذا تبت وانتقلت إلى أرض الصالحين ← يغفر الله لك","cause":"فانطَلَق إليهِم","result":"فغفَر اللهُ له","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04045","ref":"إتحاف الخيرة المهرة 7/411","text":["إنَّ رجلًا ممن كان قَبلَكم  لَقي رجلًا عالمًا أو عابدًا  فقال:  إن الآخرَ قتَل تسعةً وتِسعينَ نفسًا كلُّها يقتلُها ظلمًا  فهل تجِدُ له مِن توبةٍ ؟ قال:  لئِنْ قلتُ لكَ:  إنَّ اللهَ لا يتوبُ على مَن تاب قد كذَبتُ  هاهُنا ديرٌ فيه قومٌ يتعبَّدونَ  فائتِهِم فاعبُدِ اللهَ معهم  لعلَّ اللهَ يتوبُ عليكَ  ",["فانطَلَق إليهِم",1],"  فمات قبلَ أن يأتيَهم  فاختَصَم فيه ملائكةُ العذابِ وملائكةُ الرحمةِ  فبعَث اللهُ ملَكًا أن قيسوا ما بين المكانينِ  فأيُّهما كان أقربَ فهم منه  فقاسوه  فوجَدوه أقربَ إلى ديرِ التوابينَ بأنملةٍ  ",["فغفَر اللهُ له",2]],"grade":"حسن","narrator":"معاوية بن أبي سفيان","muhaddith":"إسناده جيد","takhrij":"أخرجه أبو يعلى (7361) واللفظ له، ، والطبراني في ((المعجم الكبير)) (19/ 369) (867)، وابن أبي عاصم في ((الديات)) (صـ55) بنحوه.","bab":"جنائز وموت › لقاء الله والمبادرة بالعمل الصالح","dorar":"XoqdNPIg"},{"id":"س-04601","fp":"fc7164765fdb","stateId":49,"easy":"إذا اعترفت بذنبك وتبت ← يقبل الله توبتك (من قصة)","cause":"لا تَرجُموه وارجُموني، أنا الذي فعَلتُ بها، فاعتَرَف","result":"قد تابَ إلى اللهِ تَوبةً لو تابَها أهلُ المَدينةِ لقُبِلَ مِنهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-03946","otherNeedIds":[44],"ref":"معرفة السنن والآثار 17285","text":["في قِصَّةِ المَرأةِ التي وقَعَ عليها رَجُلٌ في سَوادِ الصُّبحِ، وهيَ تَعَمَدُ إلى المَسجِدِ، ثُمَّ فرَّ، وأُخِذَ مَنِ استَغاثَت به، فلَمَّا أُمِرَ به قامَ صاحِبُها الذي وقَعَ عليها، فقال: ",["لا تَرجُموه وارجُموني، أنا الذي فعَلتُ بها، فاعتَرَف",1],"، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم للمَرأةِ: أمَّا أنتِ فقد غُفِرَ لكِ، وقال للرَّجُلِ الذي أُخِذَ قَولًا حَسَنًا، فقيلَ له: ارجُمِ الذي اعتَرَف، فقال: لا، إنَّه ",["قد تابَ إلى اللهِ تَوبةً لو تابَها أهلُ المَدينةِ لقُبِلَ مِنهم",2],"، فأرسَلَهم"],"grade":"حسن","narrator":"وائل بن حجر","muhaddith":"إسناده حسن","bab":"حدود › من أقر بالحد","dorar":"u77Z5N43"},{"id":"س-01563","fp":"26019b06ea09","stateId":49,"easy":"إذا تبت قبل طلوع الشمس من مغربها ← يقبل الله توبتك","cause":"للتوبة","result":"إنَّ من قبل المغرب لبابا مسيرة عرضه أربعون عاما أو سبعون سنة فتحه الله عزَّ وجلَّ للتوبة يوم خلق السماوات والأرض فلا يغلقه حتَّى يطلع الشمس منه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03972","ref":"الترغيب والترهيب 4/118","text":[["إنَّ من قبل المغرب لبابا مسيرة عرضه أربعون عاما أو سبعون سنة فتحه الله عزَّ وجلَّ للتوبة يوم خلق السماوات والأرض فلا يغلقه حتَّى يطلع الشمس منه",2]],"grade":"صحيح","narrator":"صفوان بن عسال","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (6674) بلفظه، والحميدي (905)، وأبو نعيم في ((حلية الأولياء)) (7/ 308) كلاهما مطولا.","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"MFEet3bO","merged":2,"otherRefs":["تخريج سير أعلام النبلاء 15/8 (حسن)"]},{"id":"س-03973","fp":"bf8605c36a51","stateId":49,"easy":"إذا أذنبت فاستغفرت ← يغفر الله لك، فالله يحب أن يغفر","cause":"يُذْنِبونَ","result":"ليغفِرَ لهم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-07061","ref":"صحيح الجامع 5301","text":["لو لم تُذنِبوا لجاءَ اللهَ تعالى بقومٍ ",["يُذْنِبونَ",1]," ، ",["ليغفِرَ لهم",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه أحمد (2623) واللفظ له، والبزار (5299)، وابن عدي في ((الكامل في الضعفاء)) (7/205) باختلاف يسير","bab":"توبة › الحض على التوبة","dorar":"3RHcJTPG","merged":2,"otherRefs":["الجامع الصغير 6238 (حسن)"]},{"id":"س-08211","fp":"713ed8ca615b","stateId":49,"easy":"إذا أذنبت فاستغفرت ← يغفر الله لك، ولو لم تذنبوا لجاء بقوم يذنبون فيغفر لهم","cause":"كي يُذنِبوا","result":"فيغفرَ لَهُم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-07061","ref":"صحيح الترمذي 2526","text":["قُلنا يا رسولَ اللَّهِ : ما لَنا إذا كنَّا عندَكَ رقَّت قلوبُنا ، وزَهِدنا في الدُّنيا ، وَكُنَّا من أَهْلِ الآخرةِ ، فإذا خَرجنا من عِندِكَ فآنَسنا أَهالينا ، وشَمِمنا أولادَنا أنكَرنا أنفسَنا فقالَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ : لو أنَّكم تَكونونَ إذا خرجتُمْ من عندي كنتُمْ على حالِكُم ذلِكَ لزارتْكمُ الملائِكَةُ في بيوتِكُم ، ولو لم تُذنِبوا لجاءَ اللَّهُ بخَلقٍ جديدٍ ",["كي يُذنِبوا",1]," ",["فيغفرَ لَهُم",2]," قالَ : قلتُ يا رسولَ اللَّهِ ممَّ خُلِقَ الخلقُ ؟ قالَ : منَ الماءِ ، قلتُ : الجنَّةُ ما بناؤُها ؟ قالَ : لبِنةٌ من فضَّةٍ ولبنةٌ من ذَهَبٍ ، وملاطُها المسكُ الأذفرُ ، وحصباؤُها اللُّؤلؤُ والياقوتُ ، وتُربتُها الزَّعفرانُ مَن دخلَها ينعَمُ ولا يبأسُ ، ويخلدُ ولا يموتُ ، لا تبلَى ثيابُهُم ، ولا يفنى شَبابُهُم ثمَّ قالَ : ثلاثٌ لا تُرَدُّ دعوتُهُم ، الإمامُ العادلُ ، والصَّائمُ حينَ يُفطرُ ، ودعوةُ المظلومِ يرفعُها فوقَ الغمامِ ، وتُفتَّحُ لَها أبوابُ السَّماءِ ، ويقولُ الرَّبُّ تبارك وتعالى : وعزَّتي لأنصرنَّكِ ولو بعدَ حينٍ ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح دون قوله مم خلق الخلق","takhrij":"أخرجه الترمذي (2526)، وأحمد (8043) باختلاف يسير.","bab":"ملائكة › أعمال الملائكة","dorar":"UXjjPkwr","merged":2,"otherRefs":["علل الدارقطني 2258 (صحيح)"]},{"id":"س-03980","fp":"8a0b0521625b","stateId":49,"easy":"إذا أذنبت ذنباً بينك وبين الله ← فهو الذي يُرجى أن يغفره","cause":"فذنبُ العبدِ بينه و بينَ اللهِ عزَّ و جلَّ","result":"و أما الذي يُغفرُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-03987","س-08047"],"ref":"الجامع الصغير 4320","srcLabel":"ابن حبان","text":["ذنبٌ لا يغفرُ،  وذنبٌ لا يتركُ،  و ذنبٌ يغفرُ،  فأما الذي لا يغفرُ : فالشركُ باللهِ،  ",["و أما الذي يُغفرُ",2]," ",["فذنبُ العبدِ بينه و بينَ اللهِ عزَّ و جلَّ",1],"،  و أما الذي لا يُتركُ : فظلمُ العبادِ بعضُهمِ بعضًا"],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((الصغير)) (102)، وابن حبان في ((المجروحين)) (2/ 452)، والخطيب في ((تاريخ بغداد)) (5/ 547) واللفظ لهم.","bab":"توبة › الحض على التوبة","dorar":"aeocCyIX"},{"id":"س-03982","fp":"66b31eb53cd0","stateId":49,"easy":"إذا تبت قبل طلوع الشمس من مغربها ← فباب التوبة مفتوح لك","cause":"للتَّوبةِ","result":"للجنَّةِ ثمانيةُ أبوابٍ سبعَةٌ مُغْلَقةٌ وبابٌ مَفتوحٌ للتَّوبةِ حتَّى تطلعَ الشَّمسُ من نحوِه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[55],"ref":"الجامع الصغير 7320","srcLabel":"الحاكم","text":[["للجنَّةِ ثمانيةُ أبوابٍ سبعَةٌ مُغْلَقةٌ وبابٌ مَفتوحٌ للتَّوبةِ حتَّى تطلعَ الشَّمسُ من نحوِه",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (7671)، وأبو يعلى (5012)، والطبراني في ((المعجم الكبير)) (10/ 206) (10479) واللفظ لهم.","bab":"توبة › الحض على التوبة","dorar":"8W3qaije"},{"id":"س-03987","fp":"ffaf08784fe2","stateId":49,"easy":"إذا أذنبت فيما بينك وبين ربك ← فهو الذنب الذي يُغفر","cause":"فعَمَلُكَ بينَكَ وبينَ ربِّكَ","result":"وأمَّا الذنْبُ الذى يُغْفَرُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03980","ref":"الجامع الصغير 4321","text":["ذنبٌ يُغْفَرُ ، وذنبٌ لا يُغْفَرُ ، وذنبٌ يُجَازَى بِهِ ، فأمَّا الذنبُ الذي لَا يُغْفَرُ : فالشِّرْكُ باللهِ ، ",["وأمَّا الذنْبُ الذى يُغْفَرُ",2]," : ",["فعَمَلُكَ بينَكَ وبينَ ربِّكَ",1]," ، وأمَّا الذنْبُ الذي يُجَازَى بِهِ : فظلْمُكَ أخاكَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (7595) باختلاف يسير","bab":"توبة › الحض على التوبة","dorar":"s3XdCCjy"},{"id":"س-03996","fp":"bed34bbd66c1","stateId":49,"easy":"إذا تبت بعد إقامة الحد عليك ← يتوب الله عليك","cause":"وإن تابَ","result":"اسْتَشْلاها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[54],"ref":"الأحكام الوسطى 4/ 98","srcLabel":"عبد الرزاق","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قَطَعَ رَجُلًا، ثُمَّ أمَرَ به فحُسِمَ، ثُمَّ قالَ: \"تُبْ إلى اللهِ\"، قالَ: أَتوبُ إلى اللهِ، فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: \"إذا قُطِعَتْ يَدُه وَقَعَتْ في النَّارِ، فإن عادَ تَبِعَها، ",["وإن تابَ",1]," ",["اسْتَشْلاها",2],"\".\nقالَ عَبْدُ الرَّزَّاقِ: يقولُ: اسْتَرْجَعَها."],"grade":"صحيح","narrator":"ابن المنكدر","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه عبد الرزاق (13585) واللفظ له","bab":"توبة › الحض على التوبة","dorar":"b6AtCVgU"},{"id":"س-04008","fp":"7ca405cf13f2","stateId":49,"easy":"إذا تاب الناس ← تاب الله عليهم","cause":"فإنْ تابوا","result":"تابَ اللهُ عليهم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"المستدرك على الصحيحين 8772","srcLabel":"نعيم","text":["لنْ تَبلُغوا بخيرٍ ما اسْتَغنى أهلُ بَدْوِكم عن أهلِ حَضرِكم، قال: ولَتَسُوقَنَّهم السِّنينُ والسِّناتُ حتَّى يَكونوا معكم في الدِّيارِ، ولا تَمْنَعوا منهم لكَثرةِ مَن يَسْتَنُّ عليكم، قال: يَقولون: طالَما جُعْنا وشَبِعْتم، وطالَما شَقِينا ونَعِمتُم، فواسُونا اليومَ، ولَنَسْتصْعِبَنَّ بكم الأرضَ، حتَّى يَغبِطَ أهلُ حَضرِكم مِن استصعابِ الأرضِ. قال: ولَتَمِيلَنَّ بكم الأرضُ مَيْلةً، يَهلِكُ منها مَن هَلَك، ويَبْقى مَن بَقِي حتَّى تَعْنُوا الرِّقابُ، ثمَّ تَهدَأُ بكم الأرضُ بعْدَ ذلكَ حتَّى يَندَمَ المُعتِقون، قال: ثمَّ تَميلُ بكم الأرضُ مِن بعدِ ذلكَ مَيلةً أُخرى، فيَهلِكُ فيها مَن هَلَكَ، ويَبْقى مَن بَقِي، فيَقولُون: ربَّنا نُعتِقُ، ربَّنا نُعتِقُ، فيُكذِّبُهم اللهُ: كذَبْتُم كذَبْتُم، أنا أُعتِقُ. قال: ولَيُبْتَلَينَّ أُخْرياتُ هذه الأُمَّةِ بالرَّجفِ؛ ",["فإنْ تابوا",1]," ",["تابَ اللهُ عليهم",2],"، قال: وإنْ عادوا أعاد اللهُ عليهم بالرَّجفِ والقذْفِ والخسْفِ والمسْخِ والصَّواعقِ، فإذا قِيل: هَلَك النَّاسُ، هَلَك النَّاسُ، هَلَك النَّاسُ، فقدْ هَلَكوا، ولنْ يُعذِّبَ اللهُ تعالَى أُمَّةً حتَّى يَعذِرَ، قالوا: وما عُذرُها؟ قال: يَعترِفون بالذُّنوبِ ولا يَتوبون، ولَتَطْمَئنَّ بالقلوبِ بما فِيها مِن بِرِّها وفُجورِها كما تَطْمَئنُّ الشَّجرةُ بما فيها، حتَّى لا يَستطيعَ مُحسِنٌ أنْ يَزدادَ إحسانًا، ولا يَستطيعَ مُسِيءٌ استعتابًا، وذلك بأنَّ اللهَ عزَّ وجلَّ قال: {كَلَّا بَلْ رَانَ عَلَى قُلُوبِهِمْ مَا كَانُوا يَكْسِبُونَ} [المطففين:14]"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح الإسناد، ولم يخرجاه","takhrij":"أخرجه نعيم بن حماد في ((الفتن)) (685) ببعض لفظه.","bab":"توبة › الحض على التوبة","dorar":"unIdEOfM"},{"id":"س-04043","fp":"f9128b144fdf","stateId":49,"easy":"إذا وقعت في الذنب فعجّل بالتوبة ← يتوب الله عليك","cause":"لعلَّه أنْ يتوبَ","result":"فيتوبَ اللهُ عزَّ وجَلَّ عليه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج سنن أبي داود 4419","srcLabel":"أبو داود","text":["كان ماعزُ بنُ مالكٍ يتيمًا في حَجْرِ أبي، فأصاب جاريةً من الحيِّ، فقال له أبي: ائْتِ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فأخبِرْه بما صنَعتَ، لعلَّه يستغفِرُ لك، وإنَّما يريدُ بذلك رجاءَ أنْ يكونَ له مخرجًا، قال: فأتاه فقال: يا رسولَ اللهِ، إنِّي زنَيتُ فأقِمْ عليَّ كتابَ اللهِ، فأعرَضَ عنه، فعاد فقال: يا رسولَ اللهِ:  إنِّي زنَيتُ فأقِمْ عليَّ كتابَ اللهِ، فأعرَضَ عنه، فعاد فقال: يا رسولَ اللهِ،  إنِّي زنَيتُ فأقِمْ عليَّ كتابَ اللهِ؛ حتى قالَها أربعَ مِرارٍ، قال صلَّى اللهُ عليه وسلَّمَ: إنَّك قد قُلتَها أربعَ مراتٍ، فبمن؟ قال: بفلانةَ، فقال: هل ضاجَعْتَها؟ قال: نعَمْ، قال: هل باشَرْتَها؟ قال: نعَمْ، قال: هل جامَعْتَها؟ قال: نعَمْ، قال: فأمَرَ به أنْ يُرجَمَ، فأُخرِجَ به إلى الحَرَّةِ، فلمَّا رُجِم، فوجَدَ مَسَّ الحِجارةِ، فجزِعَ، فخرَجَ يشتَدُّ، فلقِيَه عبدُ اللهِ بنُ أُنَيسٍ، وقد عجَزَ أصحابُه، فنزَعَ له بوظيفِ بعيرٍ، فرماه به، فقتَلَه، ثم أتى النبيَّ صلَّى اللهُ عليه وسلَّمَ، فذكَرَ ذلك له، فقال: هلا ترَكتُموه، ",["لعلَّه أنْ يتوبَ",1]," ",["فيتوبَ اللهُ عزَّ وجَلَّ عليه",2],"."],"grade":"صحيح","narrator":"نعيم بن هزال الأسلمي","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (4419) بلفظه، وأحمد (21890) باختلاف يسير، والنسائي في ((السنن الكبرى)) (7234) مختصرا.","bab":"توبة › سقوط الذنوب بالاستغفار والتوبة","dorar":"LsKyqcIj"},{"id":"س-06966","fp":"813c553fa714","stateId":49,"easy":"إذا استغفرت ← يغفر الله لك إلا البغي والمكس","cause":"لمن يستغفرُ","result":"إنَّ اللهَ تعالَى يدنو من خلقِه فيغفرُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الترغيب والترهيب 2/28","srcLabel":"الطبراني","text":[["إنَّ اللهَ تعالَى يدنو من خلقِه فيغفرُ",2]," ",["لمن يستغفرُ",1]," إلا لبغِّيٍّ بفرجهِا أو عشَّارٍ"],"grade":"صحيح","narrator":"عثمان بن أبي العاص الثقفي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني (9/ 54) (8371) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (ص104)، وابن قانع في ((معجم الصحابة)) (2/ 388) كلاهما باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"WCtsG8vl"},{"id":"س-08047","fp":"ca5065371ca8","stateId":49,"easy":"إذا ظلمت نفسك فيما بينك وبين ربك ← فهو الظلم الذي يُرجى أن يغفره الله","cause":"فظُلمُ العِبادِ أنفُسَهم فيما بَينَهم وبَينَ رَبِّهم","result":"وأمَّا الظُّلمُ الذي يَغفِرُه اللهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03980","ref":"البعث والنشور 292","text":["«الظُّلمُ ثَلاثةٌ: فظُلمٌ لا يَغفِرُه اللهُ عَزَّ وجَلَّ، وظُلمٌ يَغفِرُه، وظُلمٌ لا يَترُكُه اللهُ عَزَّ وجَلَّ؛ فأمَّا الظُّلمُ الذي لا يَغفِرُه اللهُ فالشِّركُ، قال اللهُ عَزَّ وجَلَّ: {إِنَّ الشِّرْكَ لَظُلْمٌ عَظِيمٌ}، ",["وأمَّا الظُّلمُ الذي يَغفِرُه اللهُ",2]," ",["فظُلمُ العِبادِ أنفُسَهم فيما بَينَهم وبَينَ رَبِّهم",1],"، وأمَّا الظُّلمُ الذي لا يَترُكُه فظُلمُ العِبادِ بَعضِهم بَعضًا، حتَّى يدينَ بَعضُهم مِن بَعضٍ»."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده غير قوي.","bab":"مظالم › تحريم الظلم","dorar":"eiFC1szY","merged":2,"otherRefs":["البعث والنشور 393 (حسن)"]},{"id":"س-08153","fp":"f8bbaac4a5a4","stateId":49,"easy":"إذا أخطأت فندمت واستغفرت قبل ست ساعات ← لا تُكتب عليك السيئة","cause":"فإن ندِم و استغفر اللهَ منها","result":"ألقاها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الجامع 2097","srcLabel":"الطبراني","text":["إنَّ صاحبَ الشمالِ ليرفعُ القلمَ ستّ ساعاتٍ عن العبدِ المسلمِ المخطىءِ ، ",["فإن ندِم و استغفر اللهَ منها",1]," ",["ألقاها",2]," ، وإلا كُتِبَتْ واحدةٌ"],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"حسن","takhrij":"أخرجه الطبراني (8/217) (7765)، وأبو نعيم في ((حلية الأولياء)) (6/124)، والبيهقي في ((شعب الإيمان)) (7051) باختلاف يسير","bab":"ملائكة › أعمال الملائكة","dorar":"gySjziQg"},{"id":"س-00854","fp":"c2b5bcde22f8","stateId":50,"easy":"إذا قلت «سبحان الله وبحمده» مئة مرة في يوم ← تُحط خطاياك ولو كانت مثل زبد البحر","cause":"ومَن قال: سُبحانَ اللهِ وبحَمدِه في يَومٍ مِائةَ مَرَّةٍ","result":"حُطَّت خَطاياه ولو كانَت مِثلَ زَبَدِ البَحرِ","explicit":true,"star":true,"apply":{"k":"say","t":"«سبحان الله وبحمده» · العدد: مئة مرة"},"ref":"صحيح مسلم 2691","srcLabel":"متفق عليه","text":["مَن قال: لا إلَهَ إلَّا اللهُ وحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كُلِّ شيءٍ قديرٌ، في يَومٍ مِائةَ مَرَّةٍ؛ كانَت له عَدلَ عَشرِ رِقابٍ، وكُتِبَت له مِائةُ حَسَنةٍ، ومُحيَت عنه مِائةُ سَيِّئةٍ، وكانَت له حِرزًا مِنَ الشَّيطانِ يَومَه ذلك حتَّى يُمسيَ، ولم يَأتِ أحَدٌ أفضَلَ ممَّا جاءَ به، إلَّا أحَدٌ عَمِلَ أكثَرَ مِن ذلك، ",["ومَن قال: سُبحانَ اللهِ وبحَمدِه في يَومٍ مِائةَ مَرَّةٍ، ",1],["حُطَّت خَطاياه ولو كانَت مِثلَ زَبَدِ البَحرِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3293)، ومسلم (2691) واللفظ له","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"nO8HQkLK","merged":4,"otherRefs":["صحيح الجامع 6431 (صحيح)","صحيح الترمذي 3466 (صحيح)","المستدرك على الصحيحين 1930 (صحيح)"]},{"id":"س-01039","fp":"d7e821b3a8ef","stateId":50,"easy":"إذا جلست مع قوم يذكرون الله ← يغفر الله لكم","cause":"فإذا وجَدوا قومًا يذكُرونَ اللهَ","result":"أُشهِدُكم أنِّي قد غفَرْتُ لهم","explicit":true,"star":true,"otherNeedIds":[23],"ref":"تخريج صحيح ابن حبان 857","srcLabel":"متفق عليه","text":["إنَّ للهِ ملائكةً فُضُلًا عن كُتَّابِ النَّاسِ يطوفونَ في الطُّرقِ يلتَمِسونَ أهلَ الذِّكرِ ",["فإذا وجَدوا قومًا يذكُرونَ اللهَ",1]," تنادَوْا : هلُمُّوا إلى حاجتِكم فيحُفُّونَ بهم بأجنحتِهم إلى السَّماءِ الدُّنيا فيسأَلُهم ربُّهم - وهو أعلَمُ منهم - فيقولُ : ما يقولُ عبادي ؟ فيقولونَ : يُكبِّرونَكَ ويُمجِّدونَكَ ويُسبِّحونَك ويحمَدونَكَ فيقولُ : هل رأَوْني ؟ فيقولونَ : لا فيقولُ : فكيفَ لو رأَوْني ؟ فيقولونَ : لو رأَوْكَ لكانوا لكَ أشَدَّ عبادةً وأكثَرَ تسبيحًا وتحميدًا وتمجيدًا فيقولُ : وما يسأَلوني ؟ قال : فيقولونَ : يسأَلونَكَ الجنَّةَ فيقولُ : فهل رأَوْها ؟ فيقولونَ : لا واللهِ يا ربِّ فيقولُ : فكيفَ لو رأَوْها ؟ [ فيقولونَ : لو رأَوْها ] كانوا عليها أشَدَّ حِرصًا وأشَدَّ لها طلبًا وأعظَمَ فيها رغبةً فيقولُ : ومِمَّ يتعوَّذونَ ؟ فيقولونَ : مِن النَّارِ فيقولُ : وهل رأَوْها ؟ فيقولونَ : لا واللهِ يا ربِّ فيقولُ : فكيفَ لو رأَوْها ؟ فيقولونَ : لو رأَوْها لكانوا منها أشَدَّ فرارًا وأشَدَّ هرَبًا وأشَدَّ خوفًا فيقولُ اللهُ لِملائكتِه : ",["أُشهِدُكم أنِّي قد غفَرْتُ لهم",2]," قال : فقال : ملَكٌ مِن الملائكةِ : إنَّ فيهم فُلانًا ليس منهم إنَّما جاء لحاجةٍ قال : فهُمُ الجُلَساءُ لا يَشقى جليسُهم"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6408)، ومسلم (2689) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"Yrv7E83a","merged":4,"otherRefs":["صحيح ابن حبان 856 (صحيح)","صحيح الجامع 2173 (صحيح)","صحيح الترمذي 3600 (صحيح)"]},{"id":"س-00942","fp":"4e787e8e9542","stateId":50,"easy":"إذا قلت «سبحان الله وبحمده» مئة صباحاً ومئة مساءً ← تُغفر ذنوبك ولو كانت أكثر من زبد البحر","cause":"مَن قال حينَ يُصبِحُ : سُبحانَ اللهِ وبحَمْدِه مِئةَ مرَّةٍ وإذا أمسى مِئةَ مرَّةٍ","result":"غُفِرَتْ ذُنوبُه وإنْ كانت أكثَرَ مِن زَبَدِ البحرِ","explicit":true,"star":true,"apply":{"k":"say","t":"«سبحان الله وبحمده» · الوقت: في الصباح، في المساء"},"ref":"صحيح ابن حبان 859","srcLabel":"البخاري","text":[["مَن قال حينَ يُصبِحُ : سُبحانَ اللهِ وبحَمْدِه مِئةَ مرَّةٍ وإذا أمسى مِئةَ مرَّةٍ ",1],["غُفِرَتْ ذُنوبُه وإنْ كانت أكثَرَ مِن زَبَدِ البحرِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (6405)، وأحمد (8009)، ومالك (713/ 230)، والطبراني في ((الدعاء)) (1683) واللفظ لهم.","bab":"أدعية وأذكار › فضل الذكر","dorar":"Ql00iOa0","merged":2,"otherRefs":["صحيح الترغيب 653 (صحيح)"]},{"id":"س-08135","fp":"718b5a164fe5","stateId":50,"easy":"إذا جلست في مجلس ذكر تسبّح وتكبّر وتحمد وتسأل ← يغفر الله لكم ويعطيكم ما سألتم ويجيركم مما استجرتم","cause":"يُسَبِّحونَكَ ويُكَبِّرونَكَ ويُهَلِّلونَكَ ويَحمَدونَكَ ويَسألونَكَ","result":"قد غَفَرتُ لهم فأعطَيتُهم ما سَألوا، وأجَرتُهم ممَّا استَجاروا","explicit":true,"star":true,"similar":["س-00899"],"otherNeedIds":[55,54,23],"ref":"صحيح مسلم 2689","srcLabel":"البخاري","text":["إنَّ للَّهِ تَبارَكَ وتَعالى مَلائِكةً سَيَّارةً فُضُلًا يَتَبَّعونَ مَجالِسَ الذِّكرِ، فإذا وجَدوا مَجلِسًا فيه ذِكرٌ قَعَدوا معهُم، وحَفَّ بَعضُهم بَعضًا بأجنِحَتِهم، حتَّى يَملَؤوا ما بينَهم وبينَ السَّماءِ الدُّنيا، فإذا تَفَرَّقوا عَرَجوا وصَعِدوا إلى السَّماءِ، قال: فيَسألُهمُ اللهُ عَزَّ وجَلَّ، وهو أعلَمُ بهم: مِن أينَ جِئتُم؟ فيَقولونَ: جِئنا مِن عِندِ عِبادٍ لكَ في الأرضِ، ",["يُسَبِّحونَكَ ويُكَبِّرونَكَ ويُهَلِّلونَكَ ويَحمَدونَكَ ويَسألونَكَ",1],"، قال: وماذا يَسألوني؟ قالوا: يَسألونَكَ جَنَّتَكَ، قال: وهل رَأوا جَنَّتي؟ قالوا: لا، أي رَبِّ، قال: فكيفَ لو رَأوا جَنَّتي؟ قالوا: ويَستَجيرونَكَ، قال: ومِمَّ يَستَجيرونَني؟ قالوا: مِن نارِكَ يا رَبِّ، قال: وهل رَأوا ناري؟ قالوا: لا، قال: فكيفَ لو رَأوا ناري؟ قالوا: ويَستَغفِرونَكَ، قال: فيَقولُ: ",["قد غَفَرتُ لهم فأعطَيتُهم ما سَألوا، وأجَرتُهم ممَّا استَجاروا",2],"، قال: فيَقولونَ: رَبِّ، فيهم فُلانٌ عَبدٌ خَطَّاءٌ، إنَّما مَرَّ فجَلَسَ معهُم، قال: فيَقولُ: وله غَفَرتُ، هُمُ القَومُ لا يَشقى بهم جَليسُهم."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6408) باختلاف يسير","bab":"ملائكة › أعمال الملائكة","dorar":"vgLc7Z6G","merged":2,"otherRefs":["المستدرك على الصحيحين 1845 (صحيح)"]},{"id":"س-00850","fp":"f2a79f5fdad2","stateId":50,"easy":"إذا سبّحت وحمدت وكبّرت ثلاثاً وثلاثين دبر كل صلاة ← تُغفر خطاياك ولو كانت مثل زبد البحر","cause":"مَن سَبَّحَ اللهَ في دُبُرِ كُلِّ صَلاةٍ ثَلاثًا وثَلاثينَ، وحَمِدَ اللهَ ثَلاثًا وثَلاثينَ، وكَبَّرَ اللهَ ثَلاثًا وثَلاثينَ، فتلك تِسعةٌ وتِسعونَ، وقال تَمامَ المِئةِ: لا إلَهَ إلَّا اللهُ وحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ وهو على كُلِّ شيءٍ قديرٌ","result":"غُفِرَت خَطاياه وإن كانَت مِثلَ زَبَدِ البَحرِ","explicit":true,"star":true,"apply":{"k":"count","t":"ثلاثاً وثلاثين · الوقت: دبر كل صلاة"},"ref":"صحيح مسلم 597","srcLabel":"متفق عليه","text":["عَن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم: ",["مَن سَبَّحَ اللهَ في دُبُرِ كُلِّ صَلاةٍ ثَلاثًا وثَلاثينَ، وحَمِدَ اللهَ ثَلاثًا وثَلاثينَ، وكَبَّرَ اللهَ ثَلاثًا وثَلاثينَ، فتلك تِسعةٌ وتِسعونَ، وقال تَمامَ المِئةِ: لا إلَهَ إلَّا اللهُ وحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ وهو على كُلِّ شيءٍ قديرٌ",1],"، ",["غُفِرَت خَطاياه وإن كانَت مِثلَ زَبَدِ البَحرِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"0gxejrPz"},{"id":"س-00899","fp":"477035a1c2a5","stateId":50,"easy":"إذا جلست في مجلس ذكر ← يعطيك الله ما سألت ويجيرك مما استجرت","cause":"فإذا مرُّوا بقومٍ يذكرون اللهَ","result":"فإنِّي أُشهدُكم أنِّي قد أعطيتُهم ما سألوا وأجرتُهم ممَّا استجاروا","explicit":true,"repOf":"س-08135","otherNeedIds":[23],"ref":"التمهيد 19/115","text":["إنَّ للهِ ملائكةً فُضَلاءَ سيَّارةً يلتمِسون مجالسَ الذِّكرِ ، ",["فإذا مرُّوا بقومٍ يذكرون اللهَ",1]," يحُفُّون بهم بأجنحتِهم فإذا انصرفوا عرجت الملائكةُ إلى السَّماءِ فيقولُ لهم ربُّنا تبارك وتعالَى وهو أعلمُ : من أين جئتم ؟ فيقولون من عند عبادِك يُسبِّحونك ويحمَدونك ويُهلِّلونك ويسألونك ويستجيرونك ، فيقولُ وهو أعلمُ : وما يسألون ؟ فيقولون : يسألونك الجنَّةَ ، فيقولُ : وهل رأَوْها ؟ فيقولون : لا ، فيقولُ : كيف لو رأَوْها ، ويقولُ : ممَّ يستجيرون وهو أعلمُ ؟ فيقولون من النَّارِ ، فيقولُ : وهل رأَوْها ؟ فيقولون : لا ، فيقولُ : كيف لو رأَوْها ، ثمَّ يقولُ : ",["فإنِّي أُشهدُكم أنِّي قد أعطيتُهم ما سألوا وأجرتُهم ممَّا استجاروا",2]," ، فيقولون : أيْ ربِّ فيهم عبدُك الخطَّاءُ ليس منهم إنَّما مرَّ بهم فجلس إليهم ، فيقولُ : وفلانٌ قد غفرتُ له هم القومُ لا يشقَى بهم جليسُهم"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح ثابت","takhrij":"أخرجه البخاري (6408)، ومسلم (2689) بنحوه","bab":"أدعية وأذكار › فضل الذكر","dorar":"Ud6DarDb"},{"id":"س-01167","fp":"b53782e6e719","stateId":50,"easy":"إذا اجتمعتم على ذكر الله لا تريدون إلا وجهه ← تُغفر ذنوبكم وتبدّل سيئاتكم حسنات","cause":"ما مِن قَوْمٍ اجْتَمَعوا يَذْكرونَ اللهَ تَبارَكَ وتَعالى لا يُريدونَ بذلك إلَّا وَجْهَه","result":"إلَّا ناداهم مُنادٍ مِن السَّماءِ: أن قوموا مَغْفورًا لكم، قد بُدِّلَتْ سَيِّئاتُكم حَسَناتٍ","explicit":true,"otherNeedIds":[40],"ref":"الأحاديث المختارة 2678","srcLabel":"متفق عليه","text":["«",["ما مِن قَوْمٍ اجْتَمَعوا يَذْكرونَ اللهَ تَبارَكَ وتَعالى لا يُريدونَ بذلك إلَّا وَجْهَه ",1],["إلَّا ناداهم مُنادٍ مِن السَّماءِ: أن قوموا مَغْفورًا لكم، قد بُدِّلَتْ سَيِّئاتُكم حَسَناتٍ»",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"أدعية وأذكار › فضل الذكر","dorar":"zkLOKgC8"},{"id":"س-01171","fp":"5d5da88fbc8e","stateId":50,"easy":"إذا قلت هذه الكلمات ← يُغفر لك","cause":"إذا قُلْتَهنَّ","result":"غُفِرَ لك","explicit":true,"ref":"الأحاديث المختارة 603","srcLabel":"البخاري","text":["«يا علِيُّ، أَلَا أُعَلِّمُك كَلِماتٍ ",["إذا قُلْتَهنَّ",1]," وعليك عَدَدُ الذَّرِّ مِن الخَطايا ",["غُفِرَ لك",2],"، على أنَّه مَغْفورٌ لك؟ تقولُ: لا إلهَ إلَّا اللهُ العَليُّ العَظيمُ، لا إلهَ إلَّا اللهُ الحَليمُ الكَريمُ، سُبْحانَ اللهِ وتَبارَكَ اللهُ رَبُّ العَرْشِ العَظيمِ، الحَمْدُ للهِ رَبِّ العالَمينَ»."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"أدعية وأذكار › فضل الذكر","dorar":"r5S0IaCP"},{"id":"س-01177","fp":"fe34d683fc46","stateId":50,"easy":"إذا قلت «لا إله إلا الله العلي العظيم...» ← يغفر الله لك","cause":"قُل: لا إلَهَ إلَّا اللهُ العَليُّ العَظيمُ، لا إلَهَ إلَّا اللهُ الحَكيمُ الكَريمُ، لا إلَهَ إلَّا اللهُ سُبحانَ اللهِ رَبِّ السَّمواتِ السَّبعِ ورَبِّ العَرشِ العَظيمِ، الحَمدُ للهِ رَبِّ العالَمينَ","result":"إذا قُلتَهنَّ غَفرَ اللهُ لكَ وإن كُنتَ مَغفورًا لكَ","explicit":true,"apply":{"k":"say","t":"«لا إلَهَ إلَّا اللهُ العَليُّ العَظيمُ، لا إلَهَ إلَّا اللهُ الحَكيمُ الكَريمُ، لا إلَهَ إلَّا اللهُ سُبحانَ اللهِ رَبِّ السَّمواتِ السَّبعِ ورَبِّ العَرشِ العَظيمِ، الحَمدُ للهِ رَبِّ العالَمين»"},"ref":"فيض القدير 3/ 112","srcLabel":"البخاري","text":["ألا أُعَلِّمُكَ كَلِماتٍ ",["إذا قُلتَهنَّ غَفرَ اللهُ لكَ وإن كُنتَ مَغفورًا لكَ",2],"؟ ",["قُل: لا إلَهَ إلَّا اللهُ العَليُّ العَظيمُ، لا إلَهَ إلَّا اللهُ الحَكيمُ الكَريمُ، لا إلَهَ إلَّا اللهُ سُبحانَ اللهِ رَبِّ السَّمواتِ السَّبعِ ورَبِّ العَرشِ العَظيمِ، الحَمدُ للهِ رَبِّ العالَمينَ",1]],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"[ورد] بمعناه وإسناده صحيح وأصله في البخاري من طريق آخر","bab":"أدعية وأذكار › فضل الذكر","dorar":"eSAGYnrP"},{"id":"س-01202","fp":"415c75ade531","stateId":50,"easy":"إذا قلت «سبحان الله والحمد لله ولا إله إلا الله والله أكبر» ← تنفض خطاياك كما تنفض الشجرة ورقها","cause":"سبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ واللهُ أكبرُ","result":"تنفُضُ الخطايا كما تنفضُ الشَّجرةُ ورقَها","explicit":true,"apply":{"k":"say","t":"«سبحان الله والحمد لله ولا إله إلا الله والله أكبر»"},"ref":"الترغيب والترهيب 2/356","srcLabel":"البخاري","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم أخذ غُصنًا فنفَضه فلم ينتفِضْ ثمَّ نفَضه فلم ينتفِضْ ثمَّ نفَضه فانتفَض فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم إنَّ ",["سبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ واللهُ أكبرُ",1]," ",["تنفُضُ الخطايا كما تنفضُ الشَّجرةُ ورقَها",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (12534) والبخاري في ((الأدب المفرد)) (634) بلفظه، والترمذي (3533) باختلاف يسير.","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"4FUuD6dk"},{"id":"س-08136","fp":"ce6365a3d2bf","stateId":50,"easy":"إذا جالست الذاكرين ولو مارّاً ← يغفر الله لك معهم، فهم القوم لا يشقى بهم جليسهم","cause":"إنَّما مَرَّ فجَلَسَ معهُم","result":"وله غَفَرتُ، هُمُ القَومُ لا يَشقى بهم جَليسُهم","explicit":true,"ref":"صحيح مسلم 2689","srcLabel":"البخاري","text":["إنَّ للَّهِ تَبارَكَ وتَعالى مَلائِكةً سَيَّارةً فُضُلًا يَتَبَّعونَ مَجالِسَ الذِّكرِ، فإذا وجَدوا مَجلِسًا فيه ذِكرٌ قَعَدوا معهُم، وحَفَّ بَعضُهم بَعضًا بأجنِحَتِهم، حتَّى يَملَؤوا ما بينَهم وبينَ السَّماءِ الدُّنيا، فإذا تَفَرَّقوا عَرَجوا وصَعِدوا إلى السَّماءِ، قال: فيَسألُهمُ اللهُ عَزَّ وجَلَّ، وهو أعلَمُ بهم: مِن أينَ جِئتُم؟ فيَقولونَ: جِئنا مِن عِندِ عِبادٍ لكَ في الأرضِ، يُسَبِّحونَكَ ويُكَبِّرونَكَ ويُهَلِّلونَكَ ويَحمَدونَكَ ويَسألونَكَ، قال: وماذا يَسألوني؟ قالوا: يَسألونَكَ جَنَّتَكَ، قال: وهل رَأوا جَنَّتي؟ قالوا: لا، أي رَبِّ، قال: فكيفَ لو رَأوا جَنَّتي؟ قالوا: ويَستَجيرونَكَ، قال: ومِمَّ يَستَجيرونَني؟ قالوا: مِن نارِكَ يا رَبِّ، قال: وهل رَأوا ناري؟ قالوا: لا، قال: فكيفَ لو رَأوا ناري؟ قالوا: ويَستَغفِرونَكَ، قال: فيَقولُ: قد غَفَرتُ لهم فأعطَيتُهم ما سَألوا، وأجَرتُهم ممَّا استَجاروا، قال: فيَقولونَ: رَبِّ، فيهم فُلانٌ عَبدٌ خَطَّاءٌ، ",["إنَّما مَرَّ فجَلَسَ معهُم",1],"، قال: فيَقولُ: ",["وله غَفَرتُ، هُمُ القَومُ لا يَشقى بهم جَليسُهم",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6408) باختلاف يسير","bab":"ملائكة › أعمال الملائكة","dorar":"vgLc7Z6G"},{"id":"س-01024","fp":"21100776c374","stateId":50,"easy":"إذا أكثرت ذكر الله ← يضع الذكر عنك أثقالك فتأتي يوم القيامة خفيفاً","cause":"المُسْتَهتَرون بذكرِ اللهِ","result":"يضعُ الذِّكرُ عنهم أثقالَهم فيأتون اللهَ يومَ القيامةِ خِفافًا","explicit":true,"otherNeedIds":[53],"ref":"الترغيب والترهيب 2/329","srcLabel":"مسلم","text":["يا رسولَ اللهِ وما المُفرِدون قال ",["المُسْتَهتَرون بذكرِ اللهِ",1]," ",["يضعُ الذِّكرُ عنهم أثقالَهم فيأتون اللهَ يومَ القيامةِ خِفافًا",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (3596)، وأحمد (8290) باختلاف يسير، وأخرجه مسلم (2676) بنحوه","bab":"أدعية وأذكار › فضل الذكر","dorar":"ngzhPgF2"},{"id":"س-01060","fp":"1e3b8a0cae2a","stateId":50,"easy":"إذا كبّرت وحمدت وسبّحت ثلاثاً وثلاثين وختمت المئة بالتهليل دبر كل صلاة ← تُغفر ذنوبك","cause":"تُكبِّرُ اللهَ دُبُرَ كلِّ صلاةٍ ثلاثًا وثلاثينَ، وتَحمَدُه ثلاثًا وثلاثينَ، وتُسبِّحُه ثلاثًا وثلاثينَ، وتَختِمُها بلا إلهَ إلَّا اللهُ وحدَه لا شريكَ له، له المُلكُ وله الحمدُ، وهو على كلِّ شيءٍ قديرٌ","result":"غُفِرَتْ له ذُنوبُه ولو كانتْ مِثلَ زَبَدِ البحرِ","explicit":true,"apply":{"k":"count","t":"ثلاثاً وثلاثين · الوقت: دبر كل صلاة"},"ref":"تخريج سنن أبي داود 1504","srcLabel":"مسلم","text":["يا رسولَ اللهِ، ذهَبَ أصحابُ الدُّثورِ بالأُجورِ؛ يُصلُّونَ كما نُصلِّي، ويصومونَ كما نصومُ، ولهم فُضولُ أموالٍ يَتصدَّقونَ بها، وليس لنا مالٌ نَتصدَّقُ به، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا أبا ذَرٍّ، ألا أُعلِّمُك كلِماتٍ تُدرِكُ بهنَّ مَن سبَقَك، ولا يَلحَقُك مَن خلْفَك، إلَّا مَن أخَذَ بمِثلِ عملِك؟، قال: بلى يا رسولَ اللهِ، قال: ",["تُكبِّرُ اللهَ دُبُرَ كلِّ صلاةٍ ثلاثًا وثلاثينَ، وتَحمَدُه ثلاثًا وثلاثينَ، وتُسبِّحُه ثلاثًا وثلاثينَ، وتَختِمُها بلا إلهَ إلَّا اللهُ وحدَه لا شريكَ له، له المُلكُ وله الحمدُ، وهو على كلِّ شيءٍ قديرٌ",1],"، ",["غُفِرَتْ له ذُنوبُه ولو كانتْ مِثلَ زَبَدِ البحرِ",2],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1504) بلفظه، ومسلم (1006)، وابن ماجه (927) كلاهما باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"LsrSKoiJ"},{"id":"س-02414","fp":"72c1d5d5a970","stateId":50,"easy":"إذا قلت «سبحانك اللهم وبحمدك...» في مجلس لغو ← تكون كفارة لك","cause":"ومَنْ قالَها في مَجلِسِ لَغوٍ","result":"كانت كفَّارةً له","explicit":true,"apply":{"k":"say","t":"«سُبحانَكَ اللَّهُمَّ وبحمدِكَ، أَشهدُ أنْ لا إلَهَ إلَّا أنتَ، أَستغفرُكَ، وأَتوبُ إليكَ، فقالَها في مَجلِسِ ذِكرٍ؛ كانت كالطَّابِعِ يُطبَعُ عليه»"},"ref":"المستدرك على الصحيحين 1994","srcLabel":"مسلم","text":["مَنْ قالَ: سُبحانَ اللهِ وبحمدِهِ، سُبحانَكَ اللَّهُمَّ وبحمدِكَ، أَشهدُ أنْ لا إلَهَ إلَّا أنتَ، أَستغفرُكَ، وأَتوبُ إليكَ، فقالَها في مَجلِسِ ذِكرٍ؛ كانت كالطَّابِعِ يُطبَعُ عليه، ",["ومَنْ قالَها في مَجلِسِ لَغوٍ؛ ",1],["كانت كفَّارةً له",2],"."],"grade":"صحيح","narrator":"جبير بن مطعم","muhaddith":"صحيح على شرط مسلم","bab":"إسلام › فضل الشهادتين","dorar":"ThydINKD"},{"id":"س-00726","fp":"e6696687b61c","stateId":50,"easy":"إذا قلت عند قيامك من المجلس «سبحانك اللهم وبحمدك...» ← يُغفر لك ما كان في المجلس","cause":"ما من إنسانٍ يكونُ في مجلِسٍ ، فيقولُ حينَ يريدُ أن يقومَ : سبحانَكَ اللَّهمَّ وبحمدِكَ ، لا إلهَ إلَّا أنتَ ، أستغفرُكَ وأتوبُ إليكَ","result":"إلَّا غُفِرَ لهُ ما كانَ في ذلكَ المَجلِسِ","explicit":true,"apply":{"k":"say","t":"«سبحانَكَ اللَّهمَّ وبحمدِكَ ، لا إلهَ إلَّا أنتَ ، أستغفرُكَ وأتوبُ إليكَ ، إلَّا»"},"similar":["س-03320","س-03990"],"ref":"الصحيح المسند 362","srcLabel":"أحمد","text":[["ما من إنسانٍ يكونُ في مجلِسٍ ، فيقولُ حينَ يريدُ أن يقومَ : سبحانَكَ اللَّهمَّ وبحمدِكَ ، لا إلهَ إلَّا أنتَ ، أستغفرُكَ وأتوبُ إليكَ ، ",1],["إلَّا غُفِرَ لهُ ما كانَ في ذلكَ المَجلِسِ ",2],"."],"grade":"صحيح","narrator":"السائب بن يزيد","muhaddith":"صحيح","takhrij":"أخرجه أحمد (15729)، في ((شرح معاني الآثار)) (6959)، والطبراني (7/154) (6673)","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"1k3Uw6L9","merged":2,"otherRefs":["النكت على كتاب ابن الصلاح 2/734 (حسن)"]},{"id":"س-00747","fp":"759cc92f7187","stateId":50,"easy":"إذا قلت «سبحانك اللهم وبحمدك... أستغفرك وأتوب إليك» ← يكفّر ما كان في المجلس","cause":"سُبحانَكَ اللَّهُمَّ وبحَمدِكَ، أشهَدُ أنْ لا إلهَ إلَّا أنتَ، أستغفِرُكَ وأتوبُ إليكَ","result":"هذا كفَّارةُ ما يَكونُ في المَجلسِ","explicit":true,"apply":{"k":"say","t":"«سُبحانَكَ اللَّهُمَّ وبحَمدِكَ، أشهَدُ أنْ لا إلهَ إلَّا أنتَ، أستغفِرُكَ وأتوبُ إليك»"},"similar":["س-03450"],"ref":"تخريج المسند لشعيب 19812","srcLabel":"النسائي","text":["لمَّا كان بآخِرةٍ، كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ إذا جَلَسَ في المَجلسِ، فأرادَ أنْ يَقومَ قال: ",["سُبحانَكَ اللَّهُمَّ وبحَمدِكَ، أشهَدُ أنْ لا إلهَ إلَّا أنتَ، أستغفِرُكَ وأتوبُ إليكَ",1],"، فقالوا: يا رسولَ اللهِ، إنَّكَ تَقولُ الآن كَلامًا ما كنتَ تَقولُه فيما خَلا، قال: ",["هذا كفَّارةُ ما يَكونُ في المَجلسِ",2],"."],"grade":"صحيح","narrator":"أبو برزة الأسلمي نضلة بن عبيد","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو  داود (4859)، والنسائي في ((السنن الكبرى)) (10259)، وأحمد (19812) واللفظ له","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"WCq6pwLI","merged":2,"otherRefs":["صحيح أبي داود 4859 (صحيح)"]},{"id":"س-02392","fp":"533dcae000bd","stateId":50,"easy":"إذا سبّحت مئة وهلّلت مئة دبر صلاة الفجر ← تُغفر ذنوبك ولو كانت مثل زبد البحر","cause":"مَن سبَّح في دُبرِ الصَّلاةِ الغداةِ مائةَ تسبيحةٍ ، و هلَّلَ مائةَ تَهليلةٍ","result":"غُفرتْ لهُ ذنوبُه ، و لَو كانَت مثلَ زبدِ البحرِ","explicit":true,"apply":{"k":"time","t":"دبر كل صلاة"},"ref":"الجامع الصغير 8719","srcLabel":"النسائي","text":[["مَن سبَّح في دُبرِ الصَّلاةِ الغداةِ مائةَ تسبيحةٍ ، و هلَّلَ مائةَ تَهليلةٍ ، ",1],["غُفرتْ لهُ ذنوبُه ، و لَو كانَت مثلَ زبدِ البحرِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (1354)، وعبد الرزاق (3194)، وأبو الشيخ في ((ما رواه الزبير)) (143) واللفظ لهم.","bab":"إسلام › فضل الشهادتين","dorar":"NNql5Jto","merged":2,"otherRefs":["صحيح النسائي 1353 (صحيح)"]},{"id":"س-00721","fp":"ab0f63ce584e","stateId":50,"easy":"إذا استيقظت من الليل فقلت «لا إله إلا الله وحده...» ← يُغفر لك","cause":"مَن تَعارَّ مِن اللَّيلِ فقال حِينَ يَستيقظُ: لا إلهَ إلَّا اللهُ وحْدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كلِّ شيءٍ قديرٌ، سُبحانَ اللهِ، والحمدُ للهِ، ولا إلهَ إلَّا اللهُ، واللهُ أكبرُ، ولا حولَ ولا قُوَّةَ إلَّا باللهِ العَليِّ العَظيمِ، ثمَّ دعا: ربِّ اغفِرْ لي","result":"غُفِرَ له","explicit":true,"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ وحْدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كلِّ شيءٍ قديرٌ، سُبحانَ اللهِ، والحمدُ للهِ، ولا إلهَ إلَّا اللهُ، واللهُ أكبرُ، ولا حولَ ولا قُوَّةَ إلَّا باللهِ العَليِّ العَظيمِ» · الوقت: عند الاستيقاظ"},"otherNeedIds":[28],"ref":"ما تمس إليه الحاجة 131","srcLabel":"ما تمس إليه الحاجة","text":[["مَن تَعارَّ مِن اللَّيلِ فقال حِينَ يَستيقظُ: لا إلهَ إلَّا اللهُ وحْدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كلِّ شيءٍ قديرٌ، سُبحانَ اللهِ، والحمدُ للهِ، ولا إلهَ إلَّا اللهُ، واللهُ أكبرُ، ولا حولَ ولا قُوَّةَ إلَّا باللهِ العَليِّ العَظيمِ، ثمَّ دعا: ربِّ اغفِرْ لي",1],"؛ ",["غُفِرَ له",2]," -قال الوَليدُ أحدُ رُواتِه: أو قال: دعا؛ استُجيبَ له-، فإنْ قامَ فتوضَّأ ثُمَّ صلَّى؛ قُبِلتْ صلاتُه."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"EgFiW0iu"},{"id":"س-00906","fp":"02c0bdb76f0c","stateId":50,"easy":"إذا اجتمعتم على الذكر ← يقال لكم: قوموا مغفوراً لكم","cause":"ما اجتمع قومٌ ، على ذِكرٍ فتفرَّقوا عنه","result":"إلا قيل لهم : قوموا مَغفورًا لكم","explicit":true,"ref":"صحيح الجامع 5507","srcLabel":"صحيح الجامع","text":[["ما اجتمع قومٌ ، على ذِكرٍ فتفرَّقوا عنه",1]," ",["إلا قيل لهم : قوموا مَغفورًا لكم",2]],"grade":"صحيح","narrator":"سهل بن الحنظلية وأنس بن مالك","muhaddith":"صحيح","bab":"أدعية وأذكار › فضل الذكر","dorar":"70mIZGyM"},{"id":"س-00980","fp":"dc62d430d1a6","stateId":50,"easy":"إذا قلت بعد الصبح «سبحان الله العظيم وبحمده» مئة مرة ← تُغفر ذنوبك","cause":"مَن قال بعدَ الصبحِ: سبحانَ اللهِ العظيمِ وبحمدِه، مئةَ مرةٍ، ولا إلهَ إلَّا اللهُ وحدَه لا شريكَ له، مئةَ مرةٍ، وبعدَ العصرِ مِثلَ ذلك","result":"غُفِرَتْ له ذُنوبُه وإنْ كانتْ مِثلَ زَبَدِ البحرِ","explicit":true,"apply":{"k":"say","t":"«سبحان الله العظيم وبحمده» · العدد: مئة مرة"},"similar":["س-01102"],"ref":"تخريج مشكل الآثار 10/81","srcLabel":"الترمذي","text":[["مَن قال بعدَ الصبحِ: سبحانَ اللهِ العظيمِ وبحمدِه، مئةَ مرةٍ، ولا إلهَ إلَّا اللهُ وحدَه لا شريكَ له، مئةَ مرةٍ، وبعدَ العصرِ مِثلَ ذلك، ",1],["غُفِرَتْ له ذُنوبُه وإنْ كانتْ مِثلَ زَبَدِ البحرِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الطحاوي في  ((شرح مشكل الآثار)) (10/ 81) واللفظ له، والترمذي (3466) بدون: لا إله إلا الله وحده لا شريك له، والحاكم (1906) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"8jATXbFo"},{"id":"س-01102","fp":"0899b8f71536","stateId":50,"easy":"إذا قلت «سبحان الله وبحمده» مئة مرة كل يوم ← تُغفر ذنوبك","cause":"مَن قال: سُبحانَ اللهِ وبحمْدِه في كلِّ يومٍ مئةَ مرَّةٍ","result":"غُفِرَت ذُنوبُه","explicit":true,"apply":{"k":"say","t":"«سبحان الله وبحمده» · العدد: مئة مرة"},"repOf":"س-00980","ref":"عارضة الأحوذي 6/55","text":[["مَن قال: سُبحانَ اللهِ وبحمْدِه في كلِّ يومٍ مئةَ مرَّةٍ؛ ",1],["غُفِرَت ذُنوبُه",2],"."],"grade":"صحيح","muhaddith":"صحيح","bab":"أدعية وأذكار › فضل الذكر","dorar":"VYQkPBT2"},{"id":"س-01117","fp":"884e097d2ef9","stateId":50,"easy":"إذا قلت هذه الأذكار ثم مِتّ في يومك أو ليلتك ← يُغفر لك","cause":"من قالهنَّ في يومٍ أو في ليلةٍ أو في شهرٍ ، ثمَّ مات في ذلك اليومِ أو في تلك اللَّيلةِ أو في ذلك الشَّهرِ","result":"غُفِر له ذنبُه","explicit":true,"ref":"الترغيب والترهيب 4/250","srcLabel":"النسائي","text":["من قال : لا إلهَ إلَّا اللهُ ، واللهُ أكبرُ ، لا إلهَ إلَّا اللهُ وحدَه ، لا إلهَ إلَّا اللهُ ، ولا شريكَ له ، لا إلهَ إلَّا اللهُ ، له الملكُ وله الحمدُ ، لا إلهَ إلَّا اللهُ ، ولا حولَ ولا قوَّةَ إلَّا باللهِ ، يعقِدُهنَّ خمسًا بأصابِعه ، ثمَّ قال : ",["من قالهنَّ في يومٍ أو في ليلةٍ أو في شهرٍ ، ثمَّ مات في ذلك اليومِ أو في تلك اللَّيلةِ أو في ذلك الشَّهرِ ، ",1],["غُفِر له ذنبُه",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9857)، والإسماعيلي في ((المعجم)) (390)، والخطيب في ((تاريخ بغداد)) (2/184) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"VK0hidu4"},{"id":"س-01139","fp":"951592a9b6a3","stateId":50,"easy":"إذا جلستم تذكرون الله ← يُقال لكم: قوموا قد غفر الله لكم وبُدّلت سيئاتكم حسنات","cause":"ما جلَسَ قومٌ يذْكُرونَ اللهَ","result":"قومُوا قَدْ غَفَرَ اللهُ لَكُمْ ذنوبَكُمْ ، وبُدِّلَتْ سيئاتُكُمْ حسناتٍ","explicit":true,"ref":"صحيح الجامع 5610","srcLabel":"الطبراني","text":[["ما جلَسَ قومٌ يذْكُرونَ اللهَ",1]," تعالى فيقومونَ حتَّى يقالَ لهم : ",["قومُوا قَدْ غَفَرَ اللهُ لَكُمْ ذنوبَكُمْ ، وبُدِّلَتْ سيئاتُكُمْ حسناتٍ",2]],"grade":"صحيح","narrator":"سهل ابن الحنظلية الأنصاري","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (6/212) (6039)، والبيهقي في ((شعب الإيمان)) (684)، وابن أبي شيبة (30091) بإختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"Nnf525Ib"},{"id":"س-01252","fp":"78fb22ae9334","stateId":50,"easy":"إذا قلت «لا إله إلا الله والله أكبر وسبحان الله والحمد لله ولا حول ولا قوة إلا بالله» ← تُكفّر ذنوبك","cause":"ما علَى الأرضِ رجلٌ يقولُ : لا إلَهَ إلَّا اللَّهُ ، واللَّهُ أَكْبرُ ، وسُبحانَ اللَّهِ ، والحمدُ للَّهِ ، ولا حَولَ ولا قوَّةَ إلَّا باللَّهِ","result":"إلَّا كَفَّرت عنهُ مِن ذنوبِهِ وإن كانَت مثلَ زبدِ البحرِ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله والله أكبر وسبحان الله والحمد لله ولا حول ولا قوة إلا بالله»"},"similar":["س-00904"],"ref":"تخريج المسند لشاكر 11/165","srcLabel":"الترمذي","text":[["ما علَى الأرضِ رجلٌ يقولُ : لا إلَهَ إلَّا اللَّهُ ، واللَّهُ أَكْبرُ ، وسُبحانَ اللَّهِ ، والحمدُ للَّهِ ، ولا حَولَ ولا قوَّةَ إلَّا باللَّهِ ، ",1],["إلَّا كَفَّرت عنهُ مِن ذنوبِهِ وإن كانَت مثلَ زبدِ البحرِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (3460)، والنسائي في ((عمل اليوم والليلة)) (124)، وأحمد (6479) واللفظ له.","bab":"أدعية وأذكار › فضل لا حول ولا قوة إلا بالله","dorar":"el6J24u5"},{"id":"س-03305","fp":"f2a885038843","stateId":50,"easy":"إذا قلت دبر كل صلاة «الله أكبر وسبحان الله والحمد لله...» مئة مرة ← تُمحى خطاياك ولو كانت مثل الزبد","cause":"كلماتٌ من ذكرهنَّ مائةَ مرَّةٍ دُبُرَ كلِّ صلاةٍ اللهُ أكبرُ وسبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ وحدَه لا شريكَ له ولاحولَ ولا قوَّةَ إلَّا باللهِ","result":"ثمَّ لو كانت خطاياه مثلَ زبدٍ لمحتهنَّ","explicit":true,"apply":{"k":"say","t":"«اللهُ أكبرُ وسبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ وحدَه لا شريكَ له ولاحولَ ولا قوَّةَ إلَّا بالله» · العدد: مئة مرة · الوقت: دبر كل صلاة"},"ref":"الترغيب والترهيب 2/374","srcLabel":"أحمد","text":["أنَّه سمِع أبا ذرٍّ الغِفاريَّ رضِي اللهُ عنه صاحبَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ ",["كلماتٌ من ذكرهنَّ مائةَ مرَّةٍ دُبُرَ كلِّ صلاةٍ اللهُ أكبرُ وسبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ وحدَه لا شريكَ له ولاحولَ ولا قوَّةَ إلَّا باللهِ",1]," ",["ثمَّ لو كانت خطاياه مثلَ زبدٍ لمحتهنَّ",2]],"grade":"صحيح","narrator":"أبو كثير مولى بني هاشم","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أحمد (21512) بلفظه.","bab":"استغفار › أسباب المغفرة","dorar":"xIEKQTxU"},{"id":"س-03320","fp":"9197f779fb0a","stateId":50,"easy":"إذا جلست في مجلس كثر فيه اللغط فقلت قبل قيامك «سبحانك اللهم وبحمدك...» ← يُغفر لك ما كان فيه","cause":"مَن جَلَسَ في مَجلِسٍ ، فَكَثُرَ فيه لَغَطُهُ ، فقال قَبلَ أنْ يَقومَ من مَجلِسِهِ ذلِكَ : سُبحانَكَ اللهُمَّ رَبَّنا و بِحمدِكَ ، أشْهدُ أنْ لا إِلهَ إلا أنْتَ ، أسْتغفِرُكَ و أتوبُ إِليكَ","result":"إلا غُفِرَ له ما كان في مَجلِسِهِ ذلِكَ","explicit":true,"apply":{"k":"say","t":"«سبحانك اللهم وبحمدك...»"},"repOf":"س-00726","ref":"صحيح الجامع 6192","text":[["مَن جَلَسَ في مَجلِسٍ ، فَكَثُرَ فيه لَغَطُهُ ، فقال قَبلَ أنْ يَقومَ من مَجلِسِهِ ذلِكَ : سُبحانَكَ اللهُمَّ رَبَّنا و بِحمدِكَ ، أشْهدُ أنْ لا إِلهَ إلا أنْتَ ، أسْتغفِرُكَ و أتوبُ إِليكَ ، ",1],["إلا غُفِرَ له ما كان في مَجلِسِهِ ذلِكَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3433)، والنسائي في ((السنن الكبرى)) (10230)، وأحمد (10415) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"0r4ci0eh"},{"id":"س-03450","fp":"b00913ec05c4","stateId":50,"easy":"إذا قلت «سبحانك اللهم وبحمدك لا إله إلا أنت أستغفرك وأتوب إليك» ← يُكفّر بها عنك","cause":"سُبْحانَك اللَّهُمَّ وبحَمْدِكَ، لا إلهَ إلَّا أنتَ، أسْتَغْفِرُك وأتوبُ إليكَ","result":"إلَّا كُفِّرَ بهِنَّ عنه","explicit":true,"apply":{"k":"say","t":"«سبحانك اللهم وبحمدك لا إله إلا أنت أستغفرك وأتوب إليك»"},"repOf":"س-00747","ref":"تخريج سنن أبي داود 4857","text":["عن عبدِ اللهِ بنِ عمرِو بنِ العاصِ، أنَّه قال: كَلِماتٌ لا يتكلَّمُ بِهِنَّ أحَدٌ في مَجلِسِه عندَ قيامِه ثلاثَ مرَّاتٍ ",["إلَّا كُفِّرَ بهِنَّ عنه",2],"، ولا يقولُهُنَّ في مَجلِسِ خَيرٍ ومَجلِسِ ذِكرٍ إلَّا خُتِمَ له بهِنَّ عليه، كما يُختَمُ بالخاتمِ على الصَّحيفةِ: ",["سُبْحانَك اللَّهُمَّ وبحَمْدِكَ، لا إلهَ إلَّا أنتَ، أسْتَغْفِرُك وأتوبُ إليكَ",1],"."],"grade":"صحيح","narrator":"سعيد بن أبي سعيد المقبري","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4857) بلفظه، وابن حبان (593)، والطبراني في ((الدعاء)) (1915) كلاهما باختلاف يسير، والضبي في ((الدعاء)) (107) مختصرا.","bab":"استغفار › فضل الاستغفار","dorar":"fB4DWege"},{"id":"س-03536","fp":"c6fe9b9c05f6","stateId":50,"easy":"إذا قلت كفارة المجلس حين تقوم منه ← يُغفر لك ما كان فيه","cause":"لا يقولُهُنَّ أحدٌ حينَ يقومُ من مجلِسِهِ","result":"إلَّا غُفِرَ لَهُ، ما كانَ في ذلِكَ المجلِسِ","explicit":true,"ref":"نخب الافكار 13/488","srcLabel":"الحاكم","text":["ما كانَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقومُ منَ مَجلسٍ إلَّا قالَ: سُبحانَكَ اللَّهمَّ ربِّي وبحَمدِكَ، لا إلَهَ إلَّا أنتَ، أستَغفرُكَ وأتوبُ إليكَ فقُلتُ لَهُ: يا رسولَ اللَّهِ، ما أَكْثرُ ما تَقولُ هذه الكلِماتِ، إذا قُمتُ ؟ فقالَ: إنَّهُ ",["لا يقولُهُنَّ أحدٌ حينَ يقومُ من مجلِسِهِ",1]," ",["إلَّا غُفِرَ لَهُ، ما كانَ في ذلِكَ المجلِسِ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح معاني الآثار)) (6960) بلفظه، والطبراني في ((الدعاء)) (1912) بنحوه، والحاكم (1827) باختلاف يسير.","bab":"استغفار › مكفرات الذنوب","dorar":"miHweuGS"},{"id":"س-03990","fp":"7c751459d21c","stateId":50,"easy":"إذا كثر لغطك في مجلس فقلت عند قيامك «سبحانك اللهم وبحمدك...» ← تُغفر خطاياك فيه","cause":"مَن كثُرَ لَغَطُه في مَجلِسٍ، فلْيَقُلْ بعْدَ أنْ يقومَ: سُبحانَك اللَّهمَّ وبحَمْدِك، أشهَدُ أنْ لا إلهَ إلَّا أنتَ، أستَغفِرُك وأتوبُ إليك","result":"تُغفَرُ خَطاياهُ في ذلك المجلِسِ","explicit":true,"apply":{"k":"say","t":"«سُبحانَك اللَّهمَّ وبحَمْدِك، أشهَدُ أنْ لا إلهَ إلَّا أنتَ، أستَغفِرُك وأتوبُ إليك»"},"repOf":"س-00726","ref":"فتاوى نور على الدرب لابن عثيمين 2/555","text":[["مَن كثُرَ لَغَطُه في مَجلِسٍ، فلْيَقُلْ بعْدَ أنْ يقومَ: سُبحانَك اللَّهمَّ وبحَمْدِك، أشهَدُ أنْ لا إلهَ إلَّا أنتَ، أستَغفِرُك وأتوبُ إليك؛ ",1],["تُغفَرُ خَطاياهُ في ذلك المجلِسِ",2],"."],"grade":"صحيح","muhaddith":"صحيح","bab":"توبة › الحض على التوبة","dorar":"DLrnSEDj"},{"id":"س-03997","fp":"15e613724a49","stateId":50,"easy":"إذا قلت شراً ثم قلت «سبحانك وبحمدك لا إله إلا أنت أستغفرك» ← تكون كفارة لك","cause":"مَن قال خيرًا خُتِمَ له طابَعٌ على ذلكَ الخيرِ، ومَن قال شرًّا","result":"كُنَّ له كفَّارةً: سُبحانَكَ وبحمدِكَ، لا إلهَ إلَّا أنتَ، أستغفِرُكَ وأتوبُ إليكَ، عن عائشةَ: أنَّ رسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّم كان إذا جلَس مجلِسًا أو صلَّى تكلَّم","explicit":true,"apply":{"k":"say","t":"«سبحانك وبحمدك لا إله إلا أنت أستغفرك»"},"similar":["س-03443"],"ref":"الصحيح المسند 1598","srcLabel":"النسائي","text":["ما جلَس رسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّم مجلِسًا، ولا تلا قُرْآنًا، ولا صلَّى صلاةً، إلَّا ختَم ذلكَ بكلِماتٍ، قالَتْ: فقُلْتُ: يا رسولَ اللهِ، أراك ما تجلِسُ مجلِسًا ولا تتلو قُرْآنًا، ولا تُصلِّي صلاةً، إلَّا ختَمْتَ بهؤلاءِ الكلِماتِ، قال: نَعم، ",["مَن قال خيرًا خُتِمَ له طابَعٌ على ذلكَ الخيرِ، ومَن قال شرًّا، ",1],["كُنَّ له كفَّارةً: سُبحانَكَ وبحمدِكَ، لا إلهَ إلَّا أنتَ، أستغفِرُكَ وأتوبُ إليكَ، عن عائشةَ: أنَّ رسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّم كان إذا جلَس مجلِسًا أو صلَّى تكلَّم",2]," بكلِماتٍ، فسأَلَتْه عائشةُ عنِ الكلِماتِ، فقال: إن تكلَّم بخيرٍ كان طابَعًا عليهنَّ إلى يومِ القيامةِ، وإن تكلَّم بغيرِ ذلكَ كان كفَّارةً: سُبحانَكَ وبحمدِكَ، لا إلهَ إلَّا أنتَ، أستغفِرُكَ وأتوبُ إليكَ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((عمل اليوم والليلة)) (308) واللفظ له، وأحمد (24486) مختصرا.","bab":"توبة › الحض على التوبة","dorar":"cB3qmhmb"},{"id":"س-04018","fp":"0fdde3480b98","stateId":50,"easy":"إذا قلت «سبحانك اللهم وبحمدك... عملت سوءاً وظلمت نفسي فاغفر لي» ← تكون كفارة المجلس","cause":"سبحانَك اللَّهمَّ وبحمدِك أشهدُ أن لا إله إلَّا أنت أستغفرُك وأتوبُ إليك عملتُ سوءًا وظلمتُ نفسي فاغفرْ لي إنَّه لا يغفرُ الذُّنوبَ إلَّا أنت","result":"هنَّ كفاراتُ المجلسِ","explicit":true,"apply":{"k":"say","t":"«سبحانَك اللَّهمَّ وبحمدِك أشهدُ أن لا إله إلَّا أنت أستغفرُك وأتوبُ إليك عملتُ سوءًا وظلمتُ نفسي فاغفرْ لي»"},"ref":"الترغيب والترهيب 2/338","srcLabel":"النسائي","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بأُخرةٍ إذا اجتمع إليه أصحابُه فأراد أن ينهضَ قال ",["سبحانَك اللَّهمَّ وبحمدِك أشهدُ أن لا إله إلَّا أنت أستغفرُك وأتوبُ إليك عملتُ سوءًا وظلمتُ نفسي فاغفرْ لي إنَّه لا يغفرُ الذُّنوبَ إلَّا أنت",1]," قال قلنا يا رسولَ اللهِ إنَّ هذه الكلماتِ أحدَثتهنَّ قال أجلْ جاءني جبرائيلُ فقال يا محمَّدُ ",["هنَّ كفاراتُ المجلسِ",2]],"grade":"صحيح","narrator":"رافع بن خديج","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه النسائي (10188)، والحاكم (1972)، والطبراني (4/ 287) (4445) باختلاف يسير.","bab":"توبة › الحض على التوبة","dorar":"z5mfrZvy"},{"id":"س-06573","fp":"421370c59010","stateId":50,"easy":"إذا صليت الفجر ثم قعدت في مكانك لا تلغو بأمر الدنيا تذكر الله ← تخرج من ذنوبك كيوم ولدتك أمك","cause":"مَن صلَّى الفجرَ ، أو قال الغداةَ ، فقعَد مقعَدَه فلم يَلغُ بشيءٍ مِن أمرِ الدنيا ، ويذكر اللهَ حتى يُصلِّيَ الضُّحى أربعَ ركعاتٍ","result":"خرَج مَن ذنوبِه كيومِ ولدَتْه أمُّه لا ذنبَ له","explicit":true,"ref":"إتحاف الخيرة المهرة 6/391","srcLabel":"الطبراني","text":[["مَن صلَّى الفجرَ ، أو قال الغداةَ ، فقعَد مقعَدَه فلم يَلغُ بشيءٍ مِن أمرِ الدنيا ، ويذكر اللهَ حتى يُصلِّيَ الضُّحى أربعَ ركعاتٍ",1]," ، ",["خرَج مَن ذنوبِه كيومِ ولدَتْه أمُّه لا ذنبَ له",2]],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده حسن","takhrij":"أخرجه أبو يعلى (4365) واللفظ له، والطبراني في ((المعجم الأوسط)) (5940) مختصراً","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"pYJAZCYD"},{"id":"س-07248","fp":"adf9704c18ef","stateId":50,"easy":"إذا جلست في مجلس ذكر تسأل الله الجنة وتستعيذ من النار وتستغفر ← يغفر الله لك","cause":"يَسأَلونكَ الجنَّةَ، ويَتعَوَّذون بك مِنَ النَّارِ، ويَستَغْفرونك","result":"فإنِّي قد غفَرتُ لهم","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[23],"ref":"تخريج المسند لشعيب 8704","srcLabel":"متفق عليه","text":["إنَّ للهِ عزَّ وجَلَّ ملائكةً فُضُلًا، يتَّبِعون مجالِسَ الذِّكْرِ، يَجتَمِعون عندَ الذِّكْرِ، فإذا مَرُّوا بمجْلسٍ عَلا بعضُهم على بعضٍ حتى يبلغوا العرْشَ، فيقولُ اللهُ عزَّ وجَلَّ لهم -وهو أَعلَمُ-: مِن أين جِئتُم؟ فيقولون: مِن عندِ عَبيدٍ لك، ",["يَسأَلونكَ الجنَّةَ، ويَتعَوَّذون بك مِنَ النَّارِ، ويَستَغْفرونك",1],"، فيقولُ عزَّ وجَلَّ: يسألوني جنَّتي، هل رَأَوْها؟ فكيفَ لو رَأَوْها؟ ويَتعَوَّذون مِن ناري، فكيف لو رَأَوْها؟ ",["فإنِّي قد غفَرتُ لهم",2],"، فيقولون: ربَّنا إنَّ فيهم عَبدَك الخطَّاءَ فلانًا، مَرَّ بهم لحاجةٍ له فجلَسَ إليهم، فقال اللهُ عزَّ وجَلَّ: أولئك الجُلساءُ لا يَشقَى بهم جَليسُهم."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (6408)، ومسلم (2689)، وأحمد (8704) واللفظ له، وأخرجه الترمذي (3600) على الشك في الراوي أبو هريرة أو أبو سعيد الخدري.","bab":"علم › فضل مجالس العلم والذكر","dorar":"3jIi1eCn"},{"id":"س-07249","fp":"c24a3375f6ef","stateId":50,"easy":"إذا جالست الذاكرين ← لا تشقى بهم ولو جئت لحاجة","cause":"مَرَّ بهم لحاجةٍ له فجلَسَ إليهم","result":"أولئك الجُلساءُ لا يَشقَى بهم جَليسُهم","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[46],"ref":"تخريج المسند لشعيب 8704","srcLabel":"متفق عليه","text":["إنَّ للهِ عزَّ وجَلَّ ملائكةً فُضُلًا، يتَّبِعون مجالِسَ الذِّكْرِ، يَجتَمِعون عندَ الذِّكْرِ، فإذا مَرُّوا بمجْلسٍ عَلا بعضُهم على بعضٍ حتى يبلغوا العرْشَ، فيقولُ اللهُ عزَّ وجَلَّ لهم -وهو أَعلَمُ-: مِن أين جِئتُم؟ فيقولون: مِن عندِ عَبيدٍ لك، يَسأَلونكَ الجنَّةَ، ويَتعَوَّذون بك مِنَ النَّارِ، ويَستَغْفرونك، فيقولُ عزَّ وجَلَّ: يسألوني جنَّتي، هل رَأَوْها؟ فكيفَ لو رَأَوْها؟ ويَتعَوَّذون مِن ناري، فكيف لو رَأَوْها؟ فإنِّي قد غفَرتُ لهم، فيقولون: ربَّنا إنَّ فيهم عَبدَك الخطَّاءَ فلانًا، ",["مَرَّ بهم لحاجةٍ له فجلَسَ إليهم",1],"، فقال اللهُ عزَّ وجَلَّ: ",["أولئك الجُلساءُ لا يَشقَى بهم جَليسُهم",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (6408)، ومسلم (2689)، وأحمد (8704) واللفظ له، وأخرجه الترمذي (3600) على الشك في الراوي أبو هريرة أو أبو سعيد الخدري.","bab":"علم › فضل مجالس العلم والذكر","dorar":"3jIi1eCn"},{"id":"س-03380","fp":"71c92284d10a","stateId":50,"easy":"إذا ختمت مجلسك بـ«سبحانك اللهم وبحمدك... أستغفرك وأتوب إليك» ← يكون كفارة لما قلت فيه من شر","cause":"ومَن قال شرًّا","result":"كانت كفارةً له سبحانَك اللهمَّ وبحمدِك لا إلهَ إلا أنتَ أستغفرُك وأتوبُ إليك","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"apply":{"k":"say","t":"«سبحانَك اللهمَّ وبحمدِك لا إلهَ إلا أنتَ أستغفرُك وأتوبُ إليك»"},"ref":"النكت على كتاب ابن الصلاح 2/733","srcLabel":"النسائي","text":["عن عائشةَ _ رضِيَ اللهُ عنها _ قالت : ما جلس رسولُ اللهِ _ صلَّى اللهُ عليهِ وسلَّمَ – مجلسًا ولا تلا قرآنًا ولا صلَّى إلا ختمَ ذلك بكلماتٍ فقلتُ : يا رسولَ اللهِ ما أكثرَ ما تقولُ هذه الكلماتِ فقال _ صلَّى اللهُ عليهِ وسلَّمَ _ : نعم . من قال : خيرًا كنَّ طابعًا له على ذلك الخيرِ , ",["ومَن قال شرًّا ",1],["كانت كفارةً له سبحانَك اللهمَّ وبحمدِك لا إلهَ إلا أنتَ أستغفرُك وأتوبُ إليك",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح وله طريق أخرى عن عائشة","takhrij":"أخرجه النسائي (1344)، والطبراني في ((الدعاء)) (1912) باختلاف يسير، والحاكم (1827) بمعناه.","bab":"استغفار › أسباب المغفرة","dorar":"7a0hsFAb"},{"id":"س-03443","fp":"fd483e3c25cf","stateId":50,"easy":"إذا قلت «سبحانك اللهم وبحمدك أشهد أن لا إله إلا أنت أستغفرك وأتوب إليك» ← تكون كفارة لخطاياك","cause":"سبحانَكَ اللهمَّ وبحمدِكَ ، أشهدُ أنْ لا إلهَ إلَّا أنتَ ، أستغفرُكَ وأتوبُ إليكَ","result":"كَلِماتٌ عَلَّمَنِيهِنَّ جبريلُ – عليهِ السلامُ – كَفَّارَاتٌ لِخَطَايا المجلسِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"apply":{"k":"say","t":"«سبحانك اللهم وبحمدك أشهد أن لا إله إلا أنت أستغفرك وأتوب إليك»"},"repOf":"س-03997","ref":"المطالب العالية 4/26","text":["أنَّ رجلًا من أصحابِ رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ أنَّهُ جلسَ مجلَسًا فلمَّا أرادَ أنْ يقومَ قال : ",["سبحانَكَ اللهمَّ وبحمدِكَ ، أشهدُ أنْ لا إلهَ إلَّا أنتَ ، أستغفرُكَ وأتوبُ إليكَ",1]," ، قال : فقال رجلٌ مِنَ القومِ : ما هذا الحديثُ يا رسولَ اللهِ ؟ قال صلَّى اللهُ عليهِ وسلَّمَ : ",["كَلِماتٌ عَلَّمَنِيهِنَّ جبريلُ – عليهِ السلامُ – كَفَّارَاتٌ لِخَطَايا المجلسِ",2]],"grade":"صحيح","narrator":"رجل من أصحاب النبي.","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي شيبة في ((مسنده)) (954) واللفظ له، وابن منده في ((معرفة الصحابة)) (صـ894) بنحوه.","bab":"استغفار › فضل الاستغفار","dorar":"60p640Y3"},{"id":"س-00904","fp":"03d82bd7633e","stateId":50,"easy":"إذا قلت «سبحان الله والحمد لله ولا إله إلا الله والله أكبر» ← تتساقط ذنوبك كورق الشجر","cause":"سبحانَ اللهِ ، والحمدُ للهِ ، ولا إلهَ إلَّا اللهُ ، واللهُ أكبرُ","result":"يُساقطنَ الذُّنوبَ كما تُسَاقِطُ هذهِ الشَّجرةُ ورقَها","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"apply":{"k":"say","t":"«سبحان الله والحمد لله ولا إله إلا الله والله أكبر»"},"repOf":"س-01252","ref":"سير أعلام النبلاء 6/240","text":["كنتُ مع النَّبيِّ صلَّى اللهُ عليْهِ وسلَّمَ في سفرٍ ، فمرَّ على شجرةٍ يابسةٍ فضربَها بعصًا كانت في يدِهِ فتناثرَ الورَقُ فقال : إنَّ ",["سبحانَ اللهِ ، والحمدُ للهِ ، ولا إلهَ إلَّا اللهُ ، واللهُ أكبرُ",1]," ",["يُساقطنَ الذُّنوبَ كما تُسَاقِطُ هذهِ الشَّجرةُ ورقَها",2]," ."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"غريب ورواته ثقات","takhrij":"أخرجه الترمذي (3533)، وأحمد (12534)، وأبو نعيم في ((حلية الأولياء)) (5/55) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"KHmbG3iF","merged":2,"otherRefs":["صحيح الجامع 1601 (حسن)"]},{"id":"س-03458","fp":"c446189d30ef","stateId":51,"easy":"إذا دعوت الله ورجوته ← يغفر لك ما كان منك ولا يبالي","cause":"ما دَعَوْتَنِي ورَجَوْتَنِي","result":"غفرتُ لك ما كان فيك ولا أُبَالِي","explicit":true,"star":true,"otherNeedIds":[28],"ref":"هداية الرواة 2276","srcLabel":"الترمذي","text":["قال اللهُ – تعالى – يا ابنَ آدمَ ! إنك ",["ما دَعَوْتَنِي ورَجَوْتَنِي",1]," ؛ ",["غفرتُ لك ما كان فيك ولا أُبَالِي",2],"، يا ابنَ آدمَ ! لو بَلَغَتْ ذنوبُكَ عَنَانَ السماءِ، ثم استَغْفَرْتَنِي ؛ غفرتُ لك ولا أُبَالِي، يا ابنَ آدمَ ! إنك لو أَتَيْتَنِي بقُرَابِ الأرضِ خَطَايَا، ثم لَقِيتَنِي لا تُشْرِكُ بي شيئًا ؛ لَأَتَيْتُكَ بقُرَابِها مَغْفِرَةً"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"حسن بل صحيح","takhrij":"أخرجه الترمذي (3540) واللفظ له، وأحمد (13493) مختصراً بمعناه.","bab":"استغفار › فضل الاستغفار","dorar":"b0r8OsTX","merged":6,"otherRefs":["الأحاديث المختارة 1571 (صحيح)","صحيح الجامع 4341 (صحيح)","تخريج المسند لشعيب 21472 (حسن)","تخريج المسند لشعيب 21368 (حسن)","الأحاديث المختارة 1572 (صحيح)"]},{"id":"س-03371","fp":"0dd06a363132","stateId":51,"easy":"إذا دعوت في مرضك بدعوة ذي النون أربعين مرة ← إن مت أُعطيت أجر شهيد، وإن برئت غُفرت ذنوبك","cause":"أيُّما مسلمٍ دعا بها في مرضِه أربعين مرَّةً فمات في مرضِه ذلك أُعطِي أجرَ شهيدٍ ، وإن برأ برأ وقد","result":"غُفِر له جميعُ ذنوبِه","explicit":true,"apply":{"k":"count","t":"أربعين مرة"},"ref":"الترغيب والترهيب 4/251","srcLabel":"أحمد","text":["لا إلهَ إلَّا أنت سبحانك إنِّي كنتُ من الظَّالمين : ",["أيُّما مسلمٍ دعا بها في مرضِه أربعين مرَّةً فمات في مرضِه ذلك أُعطِي أجرَ شهيدٍ ، وإن برأ برأ وقد ",1],["غُفِر له جميعُ ذنوبِه",2]],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أحمد (1462)، والحاكم (1865) كلاهمت بلفظه تاما.","bab":"استغفار › أسباب المغفرة","dorar":"qFQBLlVW"},{"id":"س-06850","fp":"df14f2df2271","stateId":51,"easy":"إذا دعوت «اللهم إني أسألك يا الله بأنك الواحد الأحد الصمد...» ← يغفر الله لك","cause":"اللَّهمَّ إنِّي أسألُكَ يا اللَّهُ بأنَّكَ الواحدُ الأحدُ الصَّمدُ ، الَّذي لم يَلِدْ ولم يولَدْ ولم يَكُنْ لَهُ كُفُوًا أَحَدٌ ، أن تغفِرَ لي ذُنوبي ، إنَّكَ أنتَ الغَفورُ الرَّحيمُ","result":"قَد غَفرَ اللَّهُ لَهُ ، ثلاثًا","explicit":true,"apply":{"k":"say","t":"«اللَّهمَّ إنِّي أسألُكَ يا اللَّهُ بأنَّكَ الواحدُ الأحدُ الصَّمدُ ، الَّذي لم يَلِدْ ولم يولَدْ ولم يَكُنْ لَهُ كُفُوًا أَحَدٌ ، أن»"},"ref":"صحيح النسائي 1300","srcLabel":"أبو داود","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ دخلَ المسجدَ ، إذا رجلٌ قد قَضى صلاتَهُ وَهوَ يتشَهَّدُ ، فقالَ: ",["اللَّهمَّ إنِّي أسألُكَ يا اللَّهُ بأنَّكَ الواحدُ الأحدُ الصَّمدُ ، الَّذي لم يَلِدْ ولم يولَدْ ولم يَكُنْ لَهُ كُفُوًا أَحَدٌ ، أن تغفِرَ لي ذُنوبي ، إنَّكَ أنتَ الغَفورُ الرَّحيمُ",1]," ، فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: ",["قَد غَفرَ اللَّهُ لَهُ ، ثلاثًا",2]],"grade":"صحيح","narrator":"محجن بن الأدرع","muhaddith":"صحيح","takhrij":"أخرجه النسائي (1301) واللفظ له، وأبو داود (985)  وأحمد (18974)باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"EP1jHA8m"},{"id":"س-00685","fp":"77241a6b96a7","stateId":51,"easy":"إذا قلت «اللهم مغفرتك أوسع من ذنوبي ورحمتك أرجى عندي من عملي» ← يغفر الله لك","cause":"قلِ اللَّهمَّ مغفرتُك أوسعُ من ذنوبي ورحمتُك أرجَى عندي من عملي","result":"قمْ فقد غفر اللهُ لك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«اللهم مغفرتك أوسع من ذنوبي ورحمتك أرجى عندي من عملي»"},"ref":"الترغيب والترهيب 2/386","srcLabel":"الحاكم","text":["جاء رجلٌ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقال واذنوباه واذنوباه فقال هذا القوْلَ مرَّتَيْن أو ثلاثًا فقال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["قلِ اللَّهمَّ مغفرتُك أوسعُ من ذنوبي ورحمتُك أرجَى عندي من عملي",1]," فقالها ثمَّ قال عدْ فعاد ثمَّ قال عدْ فعاد ثمَّ قال ",["قمْ فقد غفر اللهُ لك",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الحاكم (1994)، والبيهقي في ((شعب الإيمان)) (7126)","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"25V7fQ1M"},{"id":"س-03356","fp":"b4b138bd9e5d","stateId":52,"easy":"إذا صليت على النبي ﷺ مرة ← يصلي الله عليك عشراً ويحط عنك عشر خطيئات ويرفعك عشر درجات","cause":"من صلَّى عليَّ واحدةً","result":"صلَّى اللهُ عليه عشرَ صلواتٍ ، و حطَّ عنه عشرَ خطيئاتٍ ، و رفعَ له عشرَ درجاتٍ","explicit":true,"star":true,"otherNeedIds":[41],"ref":"صحيح الجامع 6359","srcLabel":"النسائي","text":[["من صلَّى عليَّ واحدةً",1]," ، ",["صلَّى اللهُ عليه  عشرَ صلواتٍ ، و حطَّ عنه عشرَ خطيئاتٍ ، و رفعَ له عشرَ درجاتٍ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه النسائي (1297)، وأحمد (11998) مختصراً واللفظ له","bab":"استغفار › أسباب المغفرة","dorar":"3liforVE"},{"id":"س-03414","fp":"72ce6ab371f0","stateId":52,"easy":"إذا صليت على النبي ﷺ يوم الجمعة ثمانين مرة ← يغفر الله لك ذنوب ثمانين سنة","cause":"من صلَّى عليَّ يومَ الجمعةِ ثمانين مرَّةً","result":"غفر اللهُ له ذنوبَ ثمانين سنةً","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"ref":"القول البديع 285","srcLabel":"الخطيب","text":[["من صلَّى عليَّ يومَ الجمعةِ ثمانين مرَّةً ",1],["غفر اللهُ له ذنوبَ ثمانين سنةً ",2],". قيل : يا رسولَ اللهِ ! كيف الصَّلاةُ عليك ؟ قال : تقولُ : اللَّهمَّ صَلِّ على محمَّدٍ عبدِك ونبيِّك ورسولِك ، النَّبيِّ الأمِّيِّ ، وتعقِدُ واحدةً"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسنه العراقي ويحتاج إلى نظر","takhrij":"أخرجه الخطيب في ((تاريخ بغداد)) (13/489)، وابن الجوزي في ((العلل المتناهية)) (796) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"me1wscUc"},{"id":"س-03385","fp":"580d22d2bc0c","stateId":52,"easy":"إذا جعلت دعاءك كله صلاة على النبي ﷺ ← يُغفر لك ذنبك كله","cause":"أفأجعلُ لك صلاتي كلَّها","result":"إذَنْ يُغْفَرُ لك ذنبُك كلُّه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"فضل الصلاة 14","srcLabel":"الترمذي","text":["كان رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم يخرجُ في ثُلُثَي الليلِ فيقول : جاءتِ الراجفةُ ، تتبعُها الرادفةُ ، جاء الموتُ بما فيه ، وقال أبي ؟ ؟ : يا رسولَ اللهِ إني أُصلِّي من الليلِ : أفأجعلُ لك ثلثَ صَلاتي ؟ قال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم : الشّطرَ . قال : أفأجعلُ لك شَطرَ صلاتي ؟ قال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم : الثُّلُثانِ أكثرُ . قال : ",["أفأجعلُ لك صلاتي كلَّها",1]," ؟ [ قال ] : ",["إذَنْ يُغْفَرُ لك ذنبُك كلُّه",2]],"grade":"حسن","narrator":"أبي بن كعب","muhaddith":"جيد","takhrij":"أخرجه الترمذي (2457)، وعبد بن حميد في ((المنتخب)) (170)، ومحمد بن نصر المروزي في ((مختصر قيام الليل)) (ص95) بلفظه.","bab":"استغفار › أسباب المغفرة","dorar":"1rY5OWyB"},{"id":"س-07273","fp":"eb72658442e5","stateId":53,"easy":"إذا افتتنت في أهلك ومالك وجارك ← تكفّرها الصلاة والصيام والصدقة","cause":"الصَّلاةُ والصِّيامُ والصَّدَقةُ","result":"تُكَفِّرُها","explicit":true,"star":true,"ref":"صحيح مسلم 144","srcLabel":"متفق عليه","text":["كُنَّا عِندَ عُمَرَ، فقال: أيُّكُم سَمِعَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَذكُرُ الفِتَنَ؟ فقال قومٌ: نَحنُ سَمِعناه، فقال: لَعَلَّكُم تَعنونَ فِتنةَ الرَّجُلِ في أهلِه وجارِه؟ قالوا: أجَل، قال: تلك ",["تُكَفِّرُها",2]," ",["الصَّلاةُ والصِّيامُ والصَّدَقةُ",1],"، ولَكِن أيُّكُم سَمِعَ النَّبيَّ صلَّى اللهُ عليه وسلَّم يَذكُرُ التي تَموجُ مَوجَ البَحرِ؟ قال حُذَيفةُ: فأسكَتَ القَومُ، فقُلتُ: أنا، قال: أنتَ للَّهِ أبوك! قال حُذَيفةُ: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: تُعرَضُ الفِتَنُ على القُلوبِ كالحَصيرِ عودًا عودًا، فأيُّ قَلبٍ أُشرِبَها نُكِتَ فيه نُكتةٌ سَوداءُ، وأيُّ قَلبٍ أنكَرَها نُكِتَ فيه نُكتةٌ بَيضاءُ، حتَّى تَصيرَ على قَلبَينِ: على أبيَضَ مِثلِ الصَّفا، فلا تَضُرُّه فِتنةٌ ما دامَتِ السَّمَواتُ والأرضُ، والآخَرُ أسودُ مُربادًّا كالكوزِ مُجَخِّيًا، لا يَعرِفُ مَعروفًا ولا يُنكِرُ مُنكَرًا إلَّا ما أُشرِبَ مِن هَواه. قال حُذَيفةُ: وحَدَّثتُه أنَّ بينَك وبينَها بابًا مُغلَقًا يوشِكُ أن يُكسَرَ، قال عُمَرُ: أكَسرًا لا أبا لَك؟ فلو أنَّه فُتِحَ لَعَلَّه كانَ يُعادُ، قُلتُ: لا، بَل يُكسَرُ، وحَدَّثتُه أنَّ ذلك البابَ رَجُلٌ يُقتَلُ أو يَموتُ، حَديثًا ليس بالأغاليطِ. قال أبو خالِدٍ: فقُلتُ لسَعدٍ: يا أبا مالِكٍ، ما أسودُ مُربادٌّ؟ قال: شِدَّةُ البَياضِ في سَوادٍ، قال: قُلتُ: فما الكوزُ مُجَخِّيًا؟ قال: مَنكوسًا. وفي روايةٍ: لَمَّا قدِمَ حُذَيفةُ مِن عِندِ عُمَرَ جَلَسَ، فحَدَّثَنا، فقال: إنَّ أميرَ المُؤمِنينَ أمسِ لَمَّا جَلَستُ إليه سَألَ أصحابَه، أيُّكُم يَحفَظُ قَولَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في الفِتَنِ؟ وساقَ الحَديثَ بمِثلِ حَديثِ أبي خالِدٍ، ولَم يَذكُرْ تَفسيرَ أبي مالِكٍ لقَولِه: مُربادًّا مُجَخِّيًا. وفي روايةٍ: أنَّ عُمَرَ قال: مَن يُحَدِّثُنا، أو قال: أيُّكُم يُحَدِّثُنا -وفيهم حُذَيفةُ- ما قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم في الفِتنةِ؟ قال حُذَيفةُ: أنا، وساقَ الحَديثَ كَنَحوِ حَديثِ أبي مالِكٍ، عن رِبعيٍّ، وقال في الحَديثِ: قال حُذَيفةُ: حَدَّثتُه حَديثًا ليس بالأغاليطِ، وقال: يَعني أنَّه عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (23440)، والبزار (2844)، وأبو عوانة في ((مستخرجه على مسلم)) (213) جميعا بنحوه، وأصل الحديث في ((صحيح البخاري)) (1435) دون قوله: ((تعرض الفتن على القلوب...)) .","bab":"فتن › ظهور الفتن","dorar":"uAVNb7mc","merged":12,"otherRefs":["صحيح الترمذي 2258 (صحيح)","صحيح الجامع 4195 (صحيح)","صحيح البخاري 3586 (صحيح)","صحيح مسلم 144 (صحيح)","صحيح البخاري 1435 (صحيح)","عارضة الأحوذي 5/98 (صحيح)","أحكام القرآن لابن العربي 2/390 (صحيح)","صحيح البخاري 1895 (صحيح)","تخريج المسند لشعيب 23280 (صحيح)","صحيح البخاري 525 (صحيح)","صحيح البخاري 7096 (صحيح)"]},{"id":"س-07581","fp":"fe66d8a5e84f","stateId":53,"easy":"إذا قمت ليلة القدر إيماناً واحتساباً ← يغفر الله لك ما تقدّم من ذنبك","cause":"مَن قام ليلةَ القدرِ إيمانًا واحتسابًا","result":"غفَر اللهُ له ما تقدَّم مِن ذنبِه","explicit":true,"star":true,"apply":{"k":"time","t":"في العشر الأواخر"},"similar":["س-02634"],"ref":"تخريج صحيح ابن حبان 2543","srcLabel":"متفق عليه","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم خرَج في جوفِ اللَّيلِ فصلَّى في المسجدِ فصلَّى النَّاسُ فأصبَح النَّاسُ يتحدَّثونَ بذلك فكثُر النَّاسُ فخرَج عليهم اللَّيلةَ الثَّانيةَ فصلَّى فصلَّوا بصلاتِه فأصبَحوا يتحدَّثونَ بذلك حتَّى كثُر النَّاسُ فخرَج مِن اللَّيلةِ الثَّالثةِ فصلَّى فصلَّوا بصلاتِه فأصبَح النَّاسُ يتحدَّثونَ بذلك فكثُر النَّاسُ حتَّى عجَز المسجدُ عن أهلِه فلم يخرُجْ إليهم فطفِق النَّاسُ يقولونَ: الصَّلاةَ فلم يخرُجْ إليهم حتَّى خرَج لصلاةِ الفجرِ فلمَّا قضى صلاةَ الفجرِ أقبَل على النَّاسِ فتشهَّد ثمَّ قال: ( أمَّا بعدُ فإنَّه لم يخْفَ علَيَّ شأنُكم اللَّيلةَ ولكنِّي خشيتُ أنْ تُفرَضَ عليكم صلاةُ اللَّيلِ فتعجِزوا عن ذلك وكان يُرغِّبُهم في قيامِ رمضانَ مِن غيرِ أنْ يأمُرَهم بعزيمةٍ يقولُ: ( ",["مَن قام ليلةَ القدرِ إيمانًا واحتسابًا ",1],["غفَر اللهُ له ما تقدَّم مِن ذنبِه",2]," قال: فتوفِّي رسولُ اللهِ صلَّى اللهُ عليه وسلَّم والأمرُ على ذلك ثمَّ كذلك كان في خلافةِ أبي بكرٍ وصدرٍ مِن خلافةِ عمرَ حتَّى جمَعهم عمرُ بنُ الخطَّابِ على أُبَيِّ بنِ كعبٍ فقام بهم في رمضانَ وكان ذلك أوَّلَ اجتماعِ النَّاسِ على قارئٍ واحدٍ في رمضانَ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه إسحاق بن راهويه (827)، وابن حبان (2543) واللفظ لهما، والبخاري (924)، ومسلم (761) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › شفقته على أمته","dorar":"rdshaKdz","merged":5,"otherRefs":["تخريج المسند لشعيب 7280 (صحيح)","تخريج مشكل الآثار 2352 (حسن)","صحيح الترغيب 992 (صحيح)","صحيح ابن حبان 141 (صحيح)"]},{"id":"س-02640","fp":"341077ff02b2","stateId":53,"easy":"إذا قمت رمضان إيماناً واحتساباً ← يُغفر لك ما تقدّم من ذنبك","cause":"مَن قامَه إيمانًا واحتِسابًا","result":"غُفِرَ له ما تقدَّمَ مِن ذَنبِه","explicit":true,"star":true,"apply":{"k":"time","t":"في رمضان"},"ref":"تخريج المسند لشعيب 7881","srcLabel":"متفق عليه","text":["سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يُرَغِّبُ النَّاسَ في قِيامِ رَمضانَ، ويَقولُ: ",["مَن قامَه إيمانًا واحتِسابًا؛ ",1],["غُفِرَ له ما تقدَّمَ مِن ذَنبِه",2],". ولَم يَكُنْ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ جمَعَ النَّاسَ على القِيامِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (2008)، ومسلم (759)، وأبو داود (1371)، والترمذي (808)، والنسائي (2198)، وابن ماجه (1326)، وأحمد (7881) واللفظ له","bab":"إيمان › الاحتساب والنية","dorar":"f9w0QQJS","merged":3,"otherRefs":["حديث المساء 218 (حسن)","تخريج المسند لشعيب 22741 (حسن)"]},{"id":"س-06686","fp":"2dc921195ffb","stateId":53,"easy":"إذا وافق تأمينك تأمين الملائكة ← يُغفر لك ما تقدّم من ذنبك","cause":"مَن وافَقَ تَأْمِينُهُ تَأْمِينَ المَلَائِكَةِ","result":"غُفِرَ له ما تَقَدَّمَ مِن ذَنْبِهِ - وقالَ ابنُ شِهَابٍ - وكانَ رَسولُ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ يقولُ: آمِينَ","explicit":true,"star":true,"similar":["س-03500","س-08151"],"ref":"علل الدارقطني 1422","srcLabel":"متفق عليه","text":["حديث يُروى عن سعيدٍ، وأبي سَلَمةَ، عن أبي هُرَيرةَ، عن النَّبيِّ صلَّى اللهُ عليه وسلَّم: إذا أمَّن الإمامُ فأمِّنوا [فإنَّه ",["مَن وافَقَ تَأْمِينُهُ تَأْمِينَ المَلَائِكَةِ ",1],["غُفِرَ له ما تَقَدَّمَ مِن ذَنْبِهِ - وقالَ ابنُ شِهَابٍ - وكانَ رَسولُ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ يقولُ: آمِينَ ",2],".]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"يرويه الزُّهريُّ، واختُلِف عنه، [ثُمَّ حكى فيه الخلافَ على الزُّهريِّ، ثُمَّ قال]: والحديثُ محفوظٌ عن الزُّهريِّ، عن سعيدٍ وأبي سَلَمةَ جميعًا، عن أبي هُرَيرةَ.","takhrij":"أخرجه البخاري (780)، ومسلم (410)، وأبو داود (936) بلفظه تامًا.","bab":"صلاة الجماعة والإمامة › الإمام","dorar":"GG66eN9U","merged":3,"otherRefs":["صحيح ابن خزيمة 1/ 612 (صحيح)","السلسلة الصحيحة 2534 (صحيح)"]},{"id":"س-06634","fp":"7575a691b131","stateId":53,"easy":"إذا قمت إلى الصلاة فسجدت ← تتناثر عنك خطاياك يميناً وشمالاً","cause":"إذا قام إلى صَلاتِه؟ جُمِعَت خطاياه فجُعِلَت فَوقَ رأسِه، إذا خَرَّ ساجِدًا","result":"تناثَرَت عنه يمينًا وشِمالًا","explicit":true,"star":true,"similar":["س-03699"],"ref":"الأحاديث المختارة 2233","srcLabel":"البخاري","text":["«كُنَّا مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم -أحسَبُه قال:- في غَزاةٍ- قال: فإمَّا أَمَر رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم بعِذْقٍ فقُطِعَ، وإمَّا كان مقطوعًا قد هاج ورَقُه، وبيَدِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم قَضيبٌ يَضْرِبُ به، ووَرَقُه يتناثَرُ، قال: هل تَدْرون ما مَثَلُ المؤمِنِ ",["إذا قام إلى صَلاتِه؟ جُمِعَت خطاياه فجُعِلَت فَوقَ رأسِه، إذا خَرَّ ساجِدًا",1]," ",["تناثَرَت عنه يمينًا وشِمالًا",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"jE7n5PLh","merged":2,"otherRefs":["السلسلة الصحيحة 3402 (صحيح)"]},{"id":"س-08220","fp":"48133a7d00d6","stateId":53,"easy":"إذا أوقدت على نفسك نار الذنوب ← فأطفئها بالصلاة","cause":"فأطْفِئُوها بالصَّلاةِ","result":"قوموا إلى نيرانِكم الَّتي أوْقَدْتُموها على أنْفُسِكم","explicit":true,"ref":"الأحاديث المختارة 2590","srcLabel":"متفق عليه","text":["«إنَّ للهِ عَزَّ وجَلَّ مَلَكًا يُنادي عِنْدَ كلِّ صَلاةٍ: يا بَني آدَمَ ",["قوموا إلى نيرانِكم الَّتي أوْقَدْتُموها على أنْفُسِكم",2]," ",["فأطْفِئُوها بالصَّلاةِ",1],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"ملائكة › أعمال الملائكة","dorar":"J6DBsD6X","merged":2,"otherRefs":["صحيح الترغيب 359 (حسن)"]},{"id":"س-02317","fp":"70596b31199b","stateId":53,"easy":"إذا صليت صلاة التسبيح (أربع ركعات بخمسة وسبعين تسبيحة في كل ركعة) ← يُغفر لك ولو كانت ذنوبك مثل زبد البحر","cause":"فذلك خَمْسةٌ وسَبْعونَ، تَفعَلُ ذلك في أرْبَعِ رَكَعاتٍ","result":"فلو كانَتْ ذُنوبُك مِثلَ زَبَدِ البَحْرِ أو رَمْلِ عالِجٍ غَفَرَ اللهُ لك","explicit":true,"apply":{"k":"count","t":"أربع ركعات"},"ref":"الأحاديث المختارة 11 / 328","srcLabel":"متفق عليه","text":["«أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قالَ للعبَّاسِ: يا عَمَّاه، أَلَا أُعْطيك، أَلَا أَمْنَحُك، أَلَا أُجيزُك، أَلَا أَفعَلُ بك عَشْرَ خِصالٍ إذا أنت فَعَلْتَ ذلك غَفَرَ اللهُ لك ذَنْبَك؛ أوَّلَه وآخِرَه، قَديمَه وحَديثَه، سِرَّه وعَلانِيَتَه، صَغيرَه وكَبيرَه، خَطَأَه وعَمْدَه؛ أن تُصَلِّيَ أرْبَعَ رَكَعاتٍ، تَقرَأُ في كلِّ رَكْعةٍ مِنها بفاتِحةِ الكِتابِ وسورةٍ، فإذا فَرَغْتَ مِن القِراءةِ أوَّلَ رَكْعةٍ، قُلْتَ وأنت قائِمٌ: سُبْحانَ اللهِ والحَمْدُ للهِ، ولا إلهَ إلَّا اللهُ واللهُ أَكبَرُ، خَمْسَ عَشْرةَ مَرَّةً، ثُمَّ تَركَعُ فتَقولُ وأنت راكِعٌ عَشْرًا، ثُمَّ تَرفَعُ رَأسَك فتقولُ وأنت قائِمٌ عَشْرًا، ثُمَّ تَسجُدُ فتَقولُها عَشْرًا، ثُمَّ تَرفَعُ رَأسَك فتقولُ وأنت جالِسٌ عَشْرًا، ثُمَّ تَسجُدُ فتَقولُها عَشْرًا، ثُمَّ تَرفَعُ رَأسَك فتَقولُها عَشْرًا، ",["فذلك خَمْسةٌ وسَبْعونَ، تَفعَلُ ذلك في أرْبَعِ رَكَعاتٍ",1],"، ",["فلو كانَتْ ذُنوبُك مِثلَ زَبَدِ البَحْرِ أو رَمْلِ عالِجٍ غَفَرَ اللهُ لك",2],"». \nلَفْظُ عيسى بنِ القاسِمِ.\n- ولَفْظُ ابنِ خُزَيْمةَ، أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قالَ للعبَّاسِ بنِ عَبْدِ المُطَّلِبِ: يا عبَّاسُ يا عَمَّاه، أَلَا أُعْطيك، أَلَا أُجيزُك، أَلَا أَفعَلُ لك عَشْرَ خِصالٍ إذا أنت فَعَلْتَ ذلك غَفَرَ اللهُ لك ذَنَبَك، أوَّلَه وآخِرَه، قَديمَه وحَديثَه، خَطَأَه وعَمْدَه، تَقرَأُ بفاتِحةِ الكِتابِ وسورةٍ، فإذا فَرَغْتَ مِن القِراءةِ في كلِّ رَكْعةٍ قُلْتَ وأنت قائِمٌ: سُبْحانَ اللهِ والحَمْدُ للهِ ولا إلهَ إلَّا اللهُ واللهُ أَكبَرُ خَمْسَ عَشْرةَ مَرَّةً، ثُمَّ تَركَعُ فتَقولُها وأنت راكِعٌ عَشْرًا، ثُمَّ تَرفَعُ رَأسَك مِن الرُّكوعِ فتَقولُها عَشْرًا، ثُمَّ تَسجُدُ فتَقولُها عَشْرًا، ثُمَّ تَرفَعُ رَأسَك فتَقولُها عَشْرًا، ثُمَّ تَسجُدُ فتَقولُها عَشْرًا، ثُمَّ تَرفَعُ رَأسَك فتَقولُها عَشْرًا، فذلك خَمْسٌ وسَبْعونَ في كلِّ رَكْعةٍ تَفعَلُ في أرْبَعِ رَكَعاتٍ إن اسْتَطَعْتَ أن تُصَلِّيَها في كلِّ يَوْمٍ مَرَّةً فافْعَلْ، فإن لم تَفعَلْ ففي كلِّ جُمُعةٍ مَرَّةً، فإن لم تَفعَلْ ففي كلِّ شَهْرٍ مَرَّةً، فإن لم تَفعَلْ ففي كلِّ سَنَةٍ مَرَّةً، فإن لم تَفعَلْ ففي عُمرِك مَرَّةً.\nوفي رواية أبي يعلى إسحاق .... بفاتحة الكتاب، ثُمَّ ترفع رأسك"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"e2TDwWJm"},{"id":"س-02634","fp":"fa06ceddf520","stateId":53,"easy":"إذا قمت ليالي القدر تبتغي أجرها ← يغفر الله لك ما تقدّم من ذنبك وما تأخر","cause":"مَن قامَهنَّ ابْتِغاءَ حِسْبَتِهنَّ","result":"فإنَّ اللهَ تَبارَكَ وتَعالى يَغفِرُ له ما تَقدَّمَ مِن ذَنْبِه وما تَأخَّرَ، وهي لَيْلةُ وِتْرٍ؛ تِسْعٍ أو سَبْعٍ أو خامِسةٍ أو ثالِثةٍ أو آخِرِ لَيْلةٍ","explicit":true,"repOf":"س-07581","ref":"الأحاديث المختارة 8 / 279","text":["(«لَيْلةُ القَدْرِ في العَشْرِ البَواقي، ",["مَن قامَهنَّ ابْتِغاءَ حِسْبَتِهنَّ ",1],["فإنَّ اللهَ تَبارَكَ وتَعالى يَغفِرُ له ما تَقدَّمَ مِن ذَنْبِه وما تَأخَّرَ، وهي لَيْلةُ وِتْرٍ؛ تِسْعٍ أو سَبْعٍ أو خامِسةٍ أو ثالِثةٍ أو آخِرِ لَيْلةٍ)",2],".\nوقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: (إنَّ أمارةَ لَيْلةِ القَدْرِ أنَّها صافِيةٌ بَلْجةٌ كأنَّ فيها قَمَرًا ساطِعًا، ساكِنةٌ ساجِيةٌ، لا بَرْدَ فيها ولا حَرَّ، ولا يَحِلُّ لكَوْكَبٍ أن يُرْمى به فيها حتَّى يُصبِحَ، وأنَّ أمارتَها أنَّ الشَّمْسَ صَبيحتَها تَخرُجُ مُسْتوِيةً ليس لها شُعاعٌ مِثلَ القَمَرِ لَيْلةَ البَدْرِ، لا يَحِلُّ للشَّيْطانِ أن يَخرُجَ معَها يَوْمَئذٍ»)."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إيمان › الاحتساب والنية","dorar":"BadItbkB"},{"id":"س-03500","fp":"c19f868763a5","stateId":53,"easy":"إذا قلت «آمين» فوافق تأمينك تأمين الملائكة ← يُغفر لك ما تقدّم من ذنبك","cause":"إذا قال القارئُ: {غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ} [الفاتحة: 7]، فقال مَن خَلفَه: آمينَ، فوافَقَ ذلك قولَ أهلِ السَّماءِ: آمينَ","result":"غُفِرَ له ما تقَدَّمَ مِن ذَنبِه","explicit":true,"repOf":"س-06686","ref":"تخريج المسند لشعيب 9804","text":[["إذا قال القارئُ: {غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ} [الفاتحة: 7]، فقال مَن خَلفَه: آمينَ، فوافَقَ ذلك قولَ أهلِ السَّماءِ: آمينَ",1],"، ",["غُفِرَ له ما تقَدَّمَ مِن ذَنبِه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (782)، ومسلم (410)، وأبو داود (935)، والنسائي (927)، وأحمد (9804) واللفظ له","bab":"استغفار › مكفرات الذنوب","dorar":"uR2DI5Hc"},{"id":"س-03706","fp":"d254764eaa75","stateId":53,"easy":"إذا قلت «اللهم ربنا لك الحمد» فوافق قولك قول الملائكة ← يُغفر لك ما مضى من ذنبك","cause":"وإذا قالَ: سمِعَ اللَّهُ لمن حمدَهُ، فقولوا: اللَّهمَّ ربَّنا لَكَ الحمدُ، فإذا وافقَ قَولُ أَهْلِ الأرضِ قولَ أَهْلِ السَّماءِ","result":"غُفِرَ لَهُ ما مضَى مِن ذنبِهِ","explicit":true,"apply":{"k":"say","t":"«اللهم ربنا لك الحمد»"},"ref":"صحيح ابن خزيمة 3/ 104","srcLabel":"متفق عليه","text":["مَن أطاعَني فَقد أطاعَ اللَّهَ، ومَن عَصاني فقد عَصَى اللَّهَ، ومن أطاعَ الأميرَ فقد أطاعَني، ومَن عصا الأميرَ فقد عَصاني، إنَّما الإمامُ جنَّةٌ، فإذا صلَّى قاعدًا فصلُّوا قعودًا، ",["وإذا قالَ: سمِعَ اللَّهُ لمن حمدَهُ، فقولوا: اللَّهمَّ ربَّنا لَكَ الحمدُ، فإذا وافقَ قَولُ أَهْلِ الأرضِ قولَ أَهْلِ السَّماءِ",1]," ",["غُفِرَ لَهُ ما مضَى مِن ذنبِهِ",2],"، ويَهْلِكُ كِسرى ولا كِسرى بعدُ، ويَهْلِكُ قَيصرُ فلا قَيصرَ مِن بعدِهِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (7137)، ومسلم (1835)، والنسائي (4193) بلفظه مختصرًا.","bab":"اعتصام بالسنة › لزوم السنة","dorar":"KojlJ7bG"},{"id":"س-03948","fp":"105980444704","stateId":53,"easy":"إذا نسيت صلاة ← فصلّها إذا ذكرتها، ولا كفارة لها غير ذلك","cause":"مَن نَسيَ صَلاةً فليُصَلِّ إذا ذَكَرَها","result":"لا كَفَّارةَ لَها إلَّا ذلك","explicit":true,"ref":"صحيح البخاري 597","srcLabel":"متفق عليه","text":[["مَن نَسيَ صَلاةً فليُصَلِّ إذا ذَكَرَها",1],"، ",["لا كَفَّارةَ لَها إلَّا ذلك",2]," {وأقِمِ الصَّلاةَ لذِكري} [طه: 14]. قال موسى: قال هَمَّامٌ: سَمِعتُه يقولُ: بَعدُ: وأقِمِ الصَّلاةَ للذِّكْرى."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (597)، ومسلم (684)","bab":"تفسير آيات › سورة طه","dorar":"NNCrx3cP"},{"id":"س-08151","fp":"b8236a275a6b","stateId":53,"easy":"إذا قلت «آمين» في الصلاة فوافقت تأمين الملائكة ← يُغفر لك","cause":"إذا قال أحدُكُمْ في الصَّلاةِ : آمِينَ","result":"قالتِ الملائكةُ في السماءِ : آمِينَ فوافقَتْ إحداهُما الأُخْرَى ، غُفِرَ لهُ ما تَقَدَّمَ من ذَنبِهِ","explicit":true,"repOf":"س-06686","ref":"صحيح الجامع 704","text":[["إذا قال أحدُكُمْ في الصَّلاةِ : آمِينَ ، ",1],"و ",["قالتِ الملائكةُ في السماءِ : آمِينَ فوافقَتْ إحداهُما الأُخْرَى ، غُفِرَ لهُ ما تَقَدَّمَ من ذَنبِهِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (781)، ومسلم (410) واللفظ له","bab":"ملائكة › أعمال الملائكة","dorar":"cMAJBYSc"},{"id":"س-00505","fp":"1b958650e7cd","stateId":53,"easy":"إذا حافظت على الصلوات الخمس ← يمحو الله بها خطاياك","cause":"الصَّلَواتِ الخَمسِ","result":"يَمحو اللهُ به الخَطايا","explicit":true,"ref":"صحيح البخاري 528","srcLabel":"مسلم","text":["أنَّه سَمِعَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: أرَأيتُم لو أنَّ نَهَرًا ببابِ أحَدِكُم يَغتَسِلُ فيه كُلَّ يَومٍ خَمسًا، ما تَقولُ ذلك يُبقي مِن دَرَنِه؟ قالوا: لا يُبقي مِن دَرَنِه شيئًا، قال: فذلك مِثلُ ",["الصَّلَواتِ الخَمسِ",1],"، ",["يَمحو اللهُ به الخَطايا",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (667) باختلاف يسير","bab":"آداب عامة › ضرب الأمثال","dorar":"NCSBYdvR","merged":2,"otherRefs":["تخريج المسند لشعيب 8925 (صحيح)"]},{"id":"س-08374","fp":"c11fec390e0b","stateId":53,"easy":"إذا قمت فحمدت الله وأثنيت عليه وركعت ركعتين ← تخرج من ذنوبك كيوم ولدتك أمك","cause":"ثمَّ يَقومُ فيَحمَدُ اللهَ عزَّ وجلَّ ويُثْني عليه بالذي هو له أهْلٌ، ثمَّ يَركَعُ ركْعتَينِ","result":"إلَّا خرَجَ مِن ذُنوبِه كهَيئتِه يَومَ ولَدَتْهُ أُمُّه","explicit":true,"apply":{"k":"count","t":"ركعتين"},"ref":"تخريج المسند لشعيب 17019","srcLabel":"مسلم","text":["إنِّي كنتُ في الجاهِليَّةِ أَرى الناسَ على ضَلالةٍ، ولا أَرى الأَوثانَ شَيئًا، ثمَّ سمِعتُ عن رجُلٍ يُخبِرُ أخبارَ مكَّةَ، ويُحَدِّثُ أحاديثَ، فرَكِبْتُ راحِلَتي حتى قَدِمْتُ مكَّةَ، فإذا أنا برسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ مُستَخْفٍ، وإذا قَومُه عليه جُرَآءُ، فتلَطَّفْتُ له، فدخَلْتُ عليه، فقلْتُ: ما أنت؟ قال: أنا نَبيُّ اللهِ، فقلْتُ: وما نَبيُّ اللهِ؟ قال: رسولُ اللهِ، قال: قلْتُ: آللهُ أَرسَلَك؟ قال: نعَمْ، قلْتُ: بأيِّ شَيءٍ أَرسَلَك؟ قال: بأنْ يُوحَّدَ اللهُ ولا يُشرَكَ به شَيءٌ، وكَسرِ الأَوثانِ، وصِلَةِ الرَّحِمِ. فقلْتُ له: مَن معك على هذا؟ قال: حُرٌّ وعبْدٌ، أو: عبْدٌ وحُرٌّ. وإذا معه أبو بكرِ بنُ أبي قُحافةَ، وبِلالٌ مَوْلى أبي بكرٍ. قلْتُ: إنِّي مُتَّبِعُك، قال: إنَّك لا تَستطيعُ ذلك يَومَك هذا، ولكنِ ارجِعْ إلى أهْلِك، فإذا سمِعتَ بي قد ظهَرْتُ فالْحَقْ بي. قال: فرجَعْتُ إلى أهْلي وقد أَسلَمْتُ، فخرَجَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ مُهاجِرًا إلى المدينةِ، فجعَلْتُ أَتخَبَّرُ الأخبارَ، حتى جاء رَكَبةٌ مِن يَثْرِبَ، فقلْتُ: ما هذا المَكِّيُّ الذي أَتاكم؟ قالوا: أراد قَومُه قَتْلَه، فلمْ يَستطيعوا ذلك، وحِيلَ بيْنهم وبيْنه، وتَرَكْنا الناسَ سِراعًا. قال عَمرُو بنُ عَبَسةَ: فرَكِبتُ راحِلَتي حتى قَدِمتُ عليه المدينةَ، فدخَلْتُ عليه، فقلْتُ: يا رسولَ اللهِ، أتَعْرِفُني؟ قال: نعَمْ، ألَسْتَ أنت الذي أَتَيْتَني بمكَّةَ؟ قال: قلْتُ: بلى، فقلْتُ: يا رسولَ اللهِ، عَلِّمْني ممَّا علَّمَك اللهُ وأَجهَلُ، قال: إذا صَلَّيْتَ الصبحَ فأَقْصِرْ عنِ الصلاةِ حتى تَطلُعَ الشمسُ، فإذا طلَعَتْ فلا تُصَلِّ حتى تَرتفِعَ؛ فإنَّها تَطلُعُ حينَ تَطلُعُ بيْن قَرْنَيْ شَيطانٍ، وحينَئذٍ يَسجُدُ لها الكفَّارُ، فإذا ارتفَعَتْ قِيدَ رُمحٍ أو رُمحَينِ فصَلِّ؛ فإنَّ الصلاةَ مَشْهودةٌ مَحْضورةٌ حتى يَستقِلَّ الرُّمحُ بالظِّلِّ، ثمَّ أَقصِرْ عنِ الصلاةِ؛ فإنَّها حينَئذٍ تُسجَرُ جَهنَّمُ، فإذا فاءَ الفَيءُ فصَلِّ؛ فإنَّ الصلاةَ مَشْهودةٌ مَحْضورةٌ حتى تُصلِّيَ العصرَ، فإذا صَلَّيْتَ العصرَ فأَقصِرْ عنِ الصلاةِ حتى تَغرُبَ الشمسُ؛ فإنَّها تَغرُبُ حينَ تَغرُبُ بيْن قَرْنَيْ شَيطانٍ، وحينَئذٍ يَسجُدُ لها الكفَّارُ. \nقلْتُ: يا نَبيَّ اللهِ، أَخبِرْني عنِ الوُضوءِ؟ قال: ما منكم مِن أحَدٍ يُقَرِّبُ وَضوءَه ثمَّ يَتمَضْمَضُ ويَستنشِقُ ويَنتَثِرُ، إلَّا خَرَّتْ خَطاياهُ مِن فَمِه وخَياشيمِه مع الماءِ حين يَنتَثِرُ، ثمَّ يَغسِلُ وَجْهَه كما أمَرَه اللهُ تعالى، إلَّا خَرَّتْ خَطايا وجْهِه مِن أَطرافِ لِحيتِه مع الماءِ، ثمَّ يَغسِلُ يدَيهِ إلى المِرفقَينِ، إلَّا خَرَّتْ خَطايا يدَيهِ مِن أَطرافِ أَنامِلِه، ثمَّ يَمسَحُ رأسَه، إلَّا خَرَّتْ خَطايا رأسِه مِن أَطرافِ شَعَرِه مع الماءِ، ثمَّ يَغسِلُ قَدَمَيهِ إلى الكَعبَينِ كما أمَرَه اللهُ عزَّ وجلَّ، إلَّا خَرَّتْ خَطايا قدَمَيهِ مِن أَطرافِ أصابِعِه مع الماءِ، ",["ثمَّ يَقومُ فيَحمَدُ اللهَ عزَّ وجلَّ ويُثْني عليه بالذي هو له أهْلٌ، ثمَّ يَركَعُ ركْعتَينِ",1],"؛ ",["إلَّا خرَجَ مِن ذُنوبِه كهَيئتِه يَومَ ولَدَتْهُ أُمُّه",2],". قال أبو أُمامةَ: يا عَمرُو بنَ عَبَسةَ، انظُرْ ما تقولُ، أسمِعتَ هذا مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ أَيُعطى هذا الرَّجُلُ كلَّه في مَقامِه؟! قال: فقال عَمرُو بنُ عَبَسةَ: يا أبا أُمامةَ، لقد كَبِرَتْ سِنِّي، ورَقَّ عَظْمي، واقتَرَبَ أجَلي، وما بي مِن حاجةٍ أنْ أَكذِبَ على اللهِ عزَّ وجلَّ وعلى رسولِه، لو لم أَسمَعْهُ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ إلَّا مرَّةً أو مرَّتَينِ أو ثلاثًا، لقد سمِعتُه سبْعَ مرَّاتٍ أو أَكثَرَ مِن ذلك."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"إسناد صحيح على شرط مسلم","takhrij":"أخرجه أحمد (17019) واللفظ له، وابن أبي عاصم في ((الآحاد والمثاني)) (1330)، والطبراني في ((مسند الشاميين)) (863)","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"EMlQpOzh","merged":2,"otherRefs":["تخريج سنن الدارقطني 378 (صحيح)"]},{"id":"س-01405","fp":"46885e359f7d","stateId":53,"easy":"إذا سجدت لله بعد الوضوء ← تخرج من خطاياك كيوم ولدتك أمك","cause":"فإن أنتَ وضعتَ وجهَكَ للَّهِ عزَّ وجلَّ","result":"خرجْتَ مِن خطاياكَ كيومِ ولدَتكَ أمُّكَ","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"ref":"صحيح النسائي 147","srcLabel":"مسلم","text":["يا رسولَ اللَّهِ ! كيفَ الوضوءُ ؟ قالَ أمَّا الوضوءُ فإنَّكَ إذا تَوضَّأتَ فغَسلتَ كفَّيكَ فأنقَيتَهُما خرجَت خطاياكَ مِن بينِ أظفارِكَ وأناملِكَ فإذا مضمضتَ واستنشقتَ منخَرَيكَ وغسلتَ وجهَكَ ويدَيكَ إلى المرفقَينِ ومسحتَ رأسَكَ وغسَلتَ رجلَيكَ إلى الكعبَينِ اغتسَلتَ مِن عامَّةِ خطاياكَ ",["فإن أنتَ وضعتَ وجهَكَ للَّهِ عزَّ وجلَّ",1]," ",["خرجْتَ مِن خطاياكَ كيومِ ولدَتكَ أمُّكَ",2]],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (147) واللفظ له، ومسلم (832)، والحاكم (584) بنحوه مطولًا.","bab":"وضوء › صفة الوضوء","dorar":"CLXVQb2e"},{"id":"ق-0599","fp":"eb981d46ca16","stateId":53,"easy":"فعل الحسنات (الصلاة) ← ذهاب السيئات","cause":"فعل الحسنات (الصلاة)","result":"ذهاب السيئات","explicit":true,"ref":"سورة هود: 114","srcLabel":"القرآن الكريم","quran":{"s":11,"from":114,"to":114,"text":"وَأَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ إِنَّ الْحَسَنَاتِ يُذْهِبْنَ السَّيِّئَاتِ ذَلِكَ ذِكْرَى لِلذَّاكِرِينَ (114)","hl":[[0,108,1]]}},{"id":"س-06568","fp":"64a376720974","stateId":53,"easy":"إذا حافظت على الصلوات الخمس والجمعة وأديت الأمانة ← تكون كفارة لما بينها","cause":"الصَّلواتُ الخَمسُ، والجُمُعةُ إلى الجُمُعةِ، وأداءُ الأمانةِ","result":"كفارةٌ لِمَا بينَها","explicit":true,"similar":["س-06487"],"ref":"شرح ابن ماجه لمغلطاي 2/254","srcLabel":"الطبراني","text":[["الصَّلواتُ الخَمسُ، والجُمُعةُ إلى الجُمُعةِ، وأداءُ الأمانةِ",1],": ",["كفارةٌ لِمَا بينَها",2],"، قُلتُ: وما أداءُ الأمانَةِ؟ قال: غُسلُ الجنابَةِ، فإنَّ تحتَ كُلِّ شَعْرةٍ جَنابةً."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجة (598 )، وابن نصر في ((تعظيم قدر الصلاة)) (511 )، والطبراني في ((المعجم الكبير)) (4/ 155) (3989 )","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"cjuAT4aG","merged":4,"otherRefs":["صحيح الجامع 3875 (صحيح)","السلسلة الصحيحة 1920 (صحيح)","السلسلة الصحيحة 3322 (صحيح)"]},{"id":"س-04050","fp":"f3e92257db01","stateId":53,"easy":"إذا أذنبت فصلِّ ← فإن الحسنات يذهبن السيئات","cause":"صَلِّ أرْبَعَ رَكَعاتٍ","result":"إِنَّ الْحَسَنَاتِ يُذْهِبْنَ السَّيِّئَاتِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-06599","س-07766","س-07151","س-07709"],"ref":"الأحاديث المختارة 11 / 160","srcLabel":"مسلم","text":["«كانَ رَجُلٌ مِن أصْحابِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يَهْوى امْرَأةً، وكانَ ذاتَ يَوْمٍ جالِسًا عِنْدَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فاسْتَأْذَنَه في حاجةٍ، فأَذِنَ له، فخَرَجَ في يَوْمٍ مَطيرٍ فإذا هو بامْرَأةٍ على غَديرٍ تَغسِلُ، فلمَّا رآها جَلَسَ مِنها مَجلِسَ الرَّجُلِ مِن امْرَأتِه، ثُمَّ حَرَّكَ ذَكَرَه، فإذا هو مِثلُ الهُدْبةِ، فقامَ نادِمًا فأتى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ فذَكَرَ ذلك له، فقالَ له النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",["صَلِّ أرْبَعَ رَكَعاتٍ",1],"، فأَنزَلَ اللهُ: {وَأَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ وزُلَفًا مِنَ اللَّيْلِ ",["إِنَّ الْحَسَنَاتِ يُذْهِبْنَ السَّيِّئَاتِ",2]," ذَلِكَ ذِكْرَى لِلذَّاكِرِينَ}»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"له شاهد في صحيح مسلم من حديث الأسود وعلقمة عن ابن مسعود، ومن حديث أبي أمامة الباهلي، بنحوه.","bab":"توبة › قوله تعالى إن الحسنات يذهبن السيئات","dorar":"ar39nBMc","merged":2,"otherRefs":["مجمع الزوائد 7/41 (صحيح)"]},{"id":"س-00590","fp":"9f87c121c7d2","stateId":53,"easy":"إذا صليت ← تذهب الصلاة ذنوبك كما يذهب الماء الوسخ","cause":"فإنَّ الصَّلَواتِ","result":"تُذهِبُ الذُّنوبَ كما يُذهِبُ الماءُ الدَّرَنَ","explicit":true,"ref":"تخريج مشكل الآثار 4962","srcLabel":"ابن ماجه","text":["سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: أرَأَيتَ لو كان بفِناءِ أحَدِكم نَهرٌ يَجري يَغتسِلُ منه كلَّ يومٍ خَمسَ مِرارٍ، ما كان مُبقِيًا مِن دَرَنِه؟ قال: لا شيءَ، قال: ",["فإنَّ الصَّلَواتِ ",1],["تُذهِبُ الذُّنوبَ كما يُذهِبُ الماءُ الدَّرَنَ",2],"."],"grade":"صحيح","narrator":"عثمان","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (4962)، والمروزي في ((تعظيم قدر الصلاة)) (84) واللفظ لهما، وابن ماجه (1397)، وأحمد (518)، وعبد بن حميد (56) جميعا باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"vtvyUYQG","merged":2,"otherRefs":["صحيح الجامع 1668 (صحيح)"]},{"id":"س-03324","fp":"428a1b66f28b","stateId":53,"easy":"إذا صليت أربع ركعات (صلاة التسبيح) ← يغفر الله لك ولو كانت ذنوبك مثل رمل عالج","cause":"صلِّ أربعَ رَكعاتٍ تقرأُ في كلِّ رَكعةٍ","result":"ولو كانَت ذنوبُكَ مثلَ رملِ عالجٍ غفرَها اللَّهُ لَكَ","explicit":true,"apply":{"k":"count","t":"أربع ركعات"},"ref":"صحيح الترمذي 482","srcLabel":"الترمذي","text":["قالَ رسولُ اللهِ صلَّى اللَّهُ عليْهِ وسلَّمَ للعبَّاسِ: يا عمِّ ألا أصلُكَ، ألا أحبوكَ، ألا أنفعُكَ، قالَ: بلى يا رسولَ اللهِ، قالَ: يا عمِّ، ",["صلِّ أربعَ رَكعاتٍ تقرأُ في كلِّ رَكعةٍ",1]," بفاتحةِ الكتابِ وسورةٍ، فإذا انقَضتِ القراءةُ، فقلِ: اللَّهُ أَكبرُ، والحمدُ للَّهِ، وسبحانَ اللهِ، خمسَ عشرةَ مرَّةً قبلَ أن ترْكعَ، ثمَّ ارْكع فقُلْها عشرًا، ثمَّ ارفع رأسَكَ فقُلْها عشرًا، ثمَّ اسجُد فقُلْها عشرًا، ثمَّ ارفع رأسَكَ فقُلْها عشرًا، ثمَّ اسجُد فقُلْها عشرًا، ثمَّ ارفع رأسَكَ فقُلْها عشرًا قبلَ أن تقومَ، فذلكَ خمسٌ وسبعونَ في كلِّ رَكعةٍ وَهيَ ثلاثُ مائةٍ في أربعِ رَكعاتٍ، ",["ولو كانَت ذنوبُكَ مثلَ رملِ عالجٍ غفرَها اللَّهُ لَكَ",2],"، قالَ: يا رسولَ اللهِ، ومن يَستطيعُ أن يقولَها في يومٍ، قالَ: إن لم تَستطِع أن تقولَها في يومٍ فقلْها في جمعةٍ، فإن لم تستطع أن تقولَها في جمعةٍ فقلْها في شَهرٍ، فلم يزل يقولُ لَهُ، حتَّى قالَ: فقلْها في سنَةٍ ."],"grade":"صحيح","narrator":"أبو رافع مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (482)، وابن ماجة (1386)، والروياني في ((مسنده)) (699) واللفظ لهم.","bab":"استغفار › أسباب المغفرة","dorar":"jkgDuKYM","merged":2,"otherRefs":["صحيح الترغيب 678 (صحيح)"]},{"id":"س-00560","fp":"92fdf86b45e8","stateId":53,"easy":"إذا حافظت على الصلوات الخمس ← تكفّر ما بينها","cause":"الصلواتُ الخمسُ","result":"كفارةٌ لمَّا بينَهُما ثُمَّ قال رسولُ اللهِ : أرأيْتَ لَوْ أنَّ رجلًا كان يعتملُ","explicit":true,"ref":"صحيح الترغيب 355","srcLabel":"الطبراني","text":[["الصلواتُ الخمسُ ",1],["كفارةٌ لمَّا بينَهُما ثُمَّ قال رسولُ اللهِ : أرأيْتَ لَوْ أنَّ رجلًا كان يعتملُ ",2],"، و كان بين منزلِه و بين مُعْتَمَلِه خمسَةُ أنهارٍ ، فإِذَا أتى مُعْتَمَلهُ عمل فيهِ ما شاءَ اللهُ ، فأصابَ الوسخُ أوْ العَرَقُ ، فَكلَّما مَرَّ بِنَهَرٍ اغتسلَ ما كان ذلكَ يُبْقِي من دَرَنِهِ ؟ فكذلكَ الصلاةُ ، كلمَّا عملَ خَطِيئَةً فدعَا و استغفرَ ، غُفِرَ لهُ ما كان قبلَها"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح لغيره","takhrij":"أخرجه البزار كما في ((مجمع الزوائد)) للهيثمي (1/303)، والطبراني (6/37) (5444) باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"JhYBVOPa"},{"id":"س-01009","fp":"7d1765f1bdee","stateId":53,"easy":"إذا صليت أربع ركعات بعد الزوال ← يُغفر لك ولو كنت أعظم الناس ذنباً","cause":"إذا زالَ النَّهارُ فقُم فصلِّ أربعَ رَكَعاتٍ","result":"فإنَّكَ لَو كنتَ أعظمَ أهْلِ الأرضِ ذنبًا غُفِرَ لَكَ بذلِكَ","explicit":true,"apply":{"k":"count","t":"أربع ركعات"},"ref":"صحيح أبي داود 1298","srcLabel":"أبو داود","text":["أنَّ عبدَ اللَّهِ بنَ عمرٍو قالَ : قالَ لي النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ ائتِني غدًا أحبوكَ وأثيبُكَ وأعطيك حتَّى ظنَنتُ أنَّهُ يعطيني عطيَّةً قالَ ",["إذا زالَ النَّهارُ فقُم فصلِّ أربعَ رَكَعاتٍ",1]," فذكرَ نحوَهُ قالَ ثمَّ ترفعُ رأسَكَ يعني منَ السَّجدةِ الثَّانيةِ فاستَوِ جالسًا ولا تقم حتَّى تسبِّحَ عشرًا وتحمدَ عشرًا وتُكَبِّرَ عشرًا وتُهَلِّلَ عشرًا ثمَّ تصنعَ ذلِكَ في الأربعِ الرَّكعات قالَ ",["فإنَّكَ لَو كنتَ أعظمَ أهْلِ الأرضِ ذنبًا غُفِرَ لَكَ بذلِكَ",2]," قلتُ فإن لم أستطِعْ أن أصلِّيَها تلكَ السَّاعةَ قالَ صلِّها منَ اللَّيلِ والنَّهارِ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"حسن صحيح","takhrij":"أخرجه أبو داود (1298) واللفظ له، والبيهقي في ((شعب الإيمان)) (611) مطولاً بنحوه","bab":"أدعية وأذكار › فضل الذكر","dorar":"RbAkIgvG"},{"id":"س-01452","fp":"ae84335ca60b","stateId":53,"easy":"إذا قمت فذكرت ربك وحمدته وصليت ركعتين بقلب حاضر ← تخرج من خطاياك كيوم ولدتك أمك","cause":"وإنْ قُمْتَ فَذَكَرْتَ رَبَّكَ، وحَمِدْتَه، ورَكَعتَهُ ركْعَتَيْنِ مُقْبِلًا عليهما بِقَلْبِكَ","result":"كُنْتَ مِنْ خَطاياكَ كَيَوْمِ وَلَدَتْكَ أُمُّكَ","explicit":true,"apply":{"k":"count","t":"ركعتين"},"ref":"المستدرك على الصحيحين 594","srcLabel":"أحمد","text":["أَتَيْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ في أَوَّلِ ما بُعِثَ وهو بِمكَّةَ، وهو حينَئذٍ مُسْتَخْفٍ، فقلتُ: ما أنتَ؟ قالَ: «أنا نَبيٌّ». قُلتُ: وما نَبيٌّ؟ قالَ: «رسولُ اللَّهِ». قلتُ: آللهُ أَرْسَلَكَ؟ قالَ: «نعم». قُلتُ: بما أَرْسَلَكَ؟ قالَ: «أنْ تَعْبُدَ اللَّهَ، وتَكْسِرَ الأَوْثانَ والأَدْيانَ، وتوصِلَ الأَرْحامَ». قُلْتُ: نِعْمَ ما أَرْسَلَكَ به. قُلْتُ: فَمَنْ يَتَّبِعُكَ على هذا؟ قالَ: «عَبْدٌ وحُرٌّ» -يعني أَبا بَكْرٍ وبِلالًا- فكان عَمرٌو يقولُ: لقد رَأَيْتُني وأَنا رُبْعُ –أَوْ: رابِعُ- الإسْلامِ، قالَ: فَأَسْلَمْتُ. قُلْتُ: أَتْبَعُكَ يا رسولَ اللهِ، قالَ: «لا، ولَكِنِ الْحَقْ بِقَوْمِكَ، فإذا أُخْبِرْتَ أَنِّي قدْ خَرَجْتُ فاتَّبِعْني». قالَ: فَلَحِقْتُ بِقَوْمي، وَجَعَلْتُ أَتَوَقَّع خَبَرَهُ وخُروجَهُ حتَّى أَقَبَلَتْ رُفْقَةٌ مِنْ يَثْرِبَ فَلَقيتُهُمْ، فَسَأَلْتُهُمْ عَنِ الخَبَرِ، فقالوا: قد خَرَجَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ مِنْ مَكَّةَ إلى المَدينَةِ، قلتُ: وقد أَتاها؟ قالوا: نَعَمْ، قالَ: فارْتَحَلْتُ حتَّى أَتَيْتُهُ. قُلتُ: أَتَعْرِفُني يا رسولَ اللَّهِ؟ قالَ: «نَعَمْ، أنتَ الرَّجُلُ الَّذي أَتاني بِمكَّةَ». فَجَعَلْتُ أَتَحَيَّنُ خَلْوَتَهُ، فلَمَّا خَلا قُلْتُ: يا رسولَ اللهِ، عَلِّمْني مِمَّا عَلَّمَكَ اللهُ وَأَجْهَلُ، قالَ: «فَسَلْ عَمَّ شِئْتَ»، قُلْتُ: أَيُّ اللَّيْلِ أَسْمَعُ؟ قالَ: «جَوْفُ اللَّيْلِ الآخِرِ فَصَلِّ ما شِئْتَ؛ فإنَّ الصَّلاةَ مَشْهودَةٌ، مَكْتوبةٌ حتَّى تُصَلِّيَ الصُّبْحَ، ثُمَّ أَقْصِرْ حتَّى تَطْلُعَ الشَّمْسُ فَتَرْتَفِعُ قِيدَ رُمْحٍ أَوْ رُمْحَيْنِ؛ فإنَّها تَطْلُعُ بينَ قَرْنَيْ شَيْطانٍ، وتُصَلِّي لها الكُفَّارُ، ثُمَّ صَلِّ ما شِئْتَ، فإنَّ الصَّلاةَ مَشْهودَةٌ مَكْتوبَةٌ حتَّى يَعْدِلَ الرُّمْحُ ظِلَّهُ، ثُمَّ أَقْصِرْ؛ فإنَّ جَهَنَّمَ تُسْجَرُ وتُفْتَحُ أَبْوابُها، فإذا زالَتِ الشَّمْسُ فَصَلِّ ما شِئْتَ، فإنَّ الصَّلاةَ مَشْهودَةٌ مَكْتوبَةٌ، ثُمَّ صَلِّ حتَّى تُصَلِّي العَصْرَ ثُمَّ أَقْصِرْ حتَّى تَغْربَ الشَّمْسُ؛ فإنَّها تَغْرُبُ بينَ قَرْنَيْ شَيْطانٍ، وتُصَلِّي لها الكُفَّارُ، وإذا تَوَضَّأْتَ فاغْسِلْ يَدَيْكَ؛ فإنَّكَ إذا غَسَلْتَ يَدَيْكَ خَرَجَتْ خَطاياكَ مِنْ أَظْفارِ أَنامِلِكَ، ثُمَّ إذا غَسَلْتَ وَجْهَكَ خَرَجَتْ خَطاياكَ مِنْ وَجْهِكَ، ثُمَّ إذا مَضْمَضْتَ واسْتَنْثَرْتَ خَرَجَتْ خَطاياكَ مِنْ مَناخِرِكَ، ثُمَّ إذا غَسَلْتَ يَدَيْكَ خَرَجَتْ خَطاياكَ مِنْ ذِراعَيْكَ، ثُمَّ إذا مَسَحْتَ بِرَأْسِكَ خَرَجَتْ خَطاياكَ مِنْ أَطْرافِ شَعْرِكَ، ثُمَّ إذا غَسَلْتَ رِجْلَيْكَ خَرَجَتْ خَطاياكَ مِنْ رِجْلَيْكَ، فإنْ ثَبَتَّ في مَجْلِسِكَ كان لكَ حَظُّكَ مِنْ وُضوئِكَ، ",["وإنْ قُمْتَ فَذَكَرْتَ رَبَّكَ، وحَمِدْتَه، ورَكَعتَهُ ركْعَتَيْنِ مُقْبِلًا عليهما بِقَلْبِكَ",1]," ",["كُنْتَ مِنْ خَطاياكَ كَيَوْمِ وَلَدَتْكَ أُمُّكَ",2],"»."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (17026)، وابن أبي شيبة في ((مسنده)) (755)، والطبراني في ((مسند الشاميين)) (1847) جميعا بطوله.","bab":"وضوء › فضل الوضوء","dorar":"C94n0qYy"},{"id":"س-03300","fp":"b9122b5f45ff","stateId":53,"easy":"إذا قمت من الليل وأيقظت زوجتك فصليتما ← يغفر الله لكما","cause":"ما مِن رجُلٍ يستيقِظُ منَ اللَّيلِ فيوقِظُ امرأتَهُ فإن غَلبَها النَّومُ نضحَ في وجهِها الماءِ ، فيَقومانِ في بيتِهِما فيذكُرانِ اللَّهَ عزَّ وجلَّ ساعةً منَ اللَّيلِ","result":"إلَّا غفرَ لَهُما","explicit":true,"apply":{"k":"time","t":"في الليل"},"ref":"الترغيب والترهيب 1/292","srcLabel":"الطبراني","text":[["ما مِن رجُلٍ يستيقِظُ منَ اللَّيلِ فيوقِظُ امرأتَهُ فإن غَلبَها النَّومُ نضحَ في وجهِها الماءِ ، فيَقومانِ في بيتِهِما فيذكُرانِ اللَّهَ عزَّ وجلَّ ساعةً منَ اللَّيلِ",1]," ",["إلَّا غفرَ لَهُما",2]],"grade":"صحيح","narrator":"أبو مالك الأشعري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني (3/295) (3448)","bab":"استغفار › أسباب المغفرة","dorar":"FpBDWDLD"},{"id":"س-03344","fp":"98ec58379824","stateId":53,"easy":"إذا صليت ركعتين ← تكفّران ما أمامهما من ذنوب","cause":"إنَّ كلَّ ركعتَيْنِ","result":"تُكفِّرانِ ما أمامَهما","explicit":true,"apply":{"k":"count","t":"ركعتين"},"ref":"صحيح الأدب المفرد 9","srcLabel":"الحسين","text":["شَهِدَ ابنَ عُمرَ رَضِيَ اللهُ عنهما ورجُلٌ يَمانيٌّ يطوفُ البَيتَ حمَلَ أُمَّهُ وراءَ ظَهْرِهِ يقولُ: إنِّي لها بَعيرُها المُذَلَّل، إنْ ذَعِرَتْ رِكابُها لم أَذْعَر، ثمَّ قال: يا بنَ عُمرَ، أَتُراني جَزَيْتُها؟ قال: لا، ولا بزَفْرَةٍ واحدةٍ، ثمَّ طاف ابنُ عُمرَ رَضِيَ اللهُ عنهما، فأتى المَقامَ، فصلَّى ركعتَيْنِ، ثمَّ قال: يا بنَ أبي موسى، ",["إنَّ كلَّ ركعتَيْنِ",1]," ",["تُكفِّرانِ ما أمامَهما",2],"."],"grade":"صحيح","narrator":"أبو بردة بن أبي موسى الأشعري","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الحسين بن حرب في ((البر والصلة)) (37) باختلاف يسير، والفاكهي في ((أخبار مكة)) (642)، وابن أبي الدنيا في ((مكارم الأخلاق)) (235) مختصرا باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"aS6UBd6I"},{"id":"س-03367","fp":"d675d56cab4a","stateId":53,"easy":"إذا قمت رمضان إيماناً واحتساباً ← تخرج من ذنوبك كيوم ولدتك أمك","cause":"من قامَ رمضانَ إيمانًا واحتسابًا","result":"خرج من ذنوبِه كيومِ ولدتْه أمُّه","explicit":true,"apply":{"k":"time","t":"في رمضان"},"ref":"الترغيب والترهيب 2/123","srcLabel":"النسائي","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ذكر رمضانَ يُفَضِّلُهُ على الشُّهورِ فقال ",["من قامَ رمضانَ إيمانًا واحتسابًا ",1],["خرج من ذنوبِه كيومِ ولدتْه أمُّه",2]],"grade":"صحيح","narrator":"عبدالرحمن بن عوف","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه النسائي (2208) واللفظ له، وابن ماجة (1328)، وأحمد (1660) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"Y4cF7DJm"},{"id":"س-03386","fp":"8db56681e4f1","stateId":53,"easy":"إذا حافظت على الصلوات الخمس ← تكفّر ذنوبك ما لم تكن كبيرة مهلكة","cause":"حافِظُوا على هذه الصلواتِ الخمسِ","result":"فإنَّهُنَّ كَفَّارَاتٌ لِهَذِهِ الجِرَاحاتِ ، ما لمْ تُصِبِ المَقْتَلَةَ","explicit":true,"ref":"صحيح الترغيب 633","srcLabel":"أبو داود","text":["قال سلمانُ : ",["حافِظُوا على هذه الصلواتِ الخمسِ ، ",1],["فإنَّهُنَّ كَفَّارَاتٌ لِهَذِهِ الجِرَاحاتِ ، ما لمْ تُصِبِ المَقْتَلَةَ",2]," ، فإذا صلَّى الناسُ العِشاءَ صَدَرُوا عن ثلاثِ منازلٍ ، مِنْهُمْ مَنْ عليهِ ولا لهُ ، ومِنْهُمْ مَنْ لهُ ولا عليهِ ، ومِنْهُمْ مَنْ لا لهُ ولا عليهِ : فَرجلٌ اغْتَنَمَ ظُلْمَةَ الليلِ وغفلةَ الناسِ فركبَ فرسَهُ في المعاصِي ، فذلكَ عليهِ ولا لهُ ، ومن لهُ ولا عليهِ فَرجلٌ أغْتَنَمَ ظُلْمَةَ الليلِ وغَفْلَةَ الناسِ فقامَ يصلِّي ، فذلكَ لهُ ولا عليهِ ، ومَنْ لا لهُ ولا عليهِ : فَرجلٌ صلَّى ثُمَّ نامَ ، فذلكَ لا لهُ ولا عليهِ ، إِيَّاكَ والحَقْحَقَةَ ، وعليكَ بِالقَصْدِ ، وداومْ"],"grade":"صحيح","narrator":"طارق بن شهاب","muhaddith":"صحيح لغيره","takhrij":"أخرجه عبد الرزاق (148)، وأبو داود في ((الزهد)) (256)، والطبراني في ((المعجم الكبير)) (6/ 217) (6051) بنحوه.","bab":"استغفار › أسباب المغفرة","dorar":"r0MO4bjA"},{"id":"س-03434","fp":"72557534558e","stateId":53,"easy":"إذا توضأت عند ارتفاع الشمس فأحسنت الوضوء ثم صليت ركعتين ← تُغفر خطاياك فتكون كيوم ولدتك أمك","cause":"مَن قامَ إذا استَقَلَّتِ الشَّمسُ فتَوضَّأ، فأحسَنَ الوُضوءَ، ثُمَّ قامَ فصَلَّى رَكعَتَينِ","result":"غُفِرَ له خَطاياه فكان كما ولَدَته أُمُّه","explicit":true,"apply":{"k":"count","t":"ركعتين · الوقت: بعد الوضوء"},"ref":"تخريج المسند لشعيب 121","srcLabel":"أحمد","text":["عن عُقبةَ بنِ عامِرٍ، أنَّه خَرَجَ مَعَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةِ تَبوكَ، فجَلَسَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يَومًا يُحَدِّثُ أصحابَه، فقال: ",["مَن قامَ إذا استَقَلَّتِ الشَّمسُ فتَوضَّأ، فأحسَنَ الوُضوءَ، ثُمَّ قامَ فصَلَّى رَكعَتَينِ، ",1],["غُفِرَ له خَطاياه فكان كما ولَدَته أُمُّه",2],". قال عُقبةُ بنُ عامِرٍ: فقُلتُ: الحَمدُ للَّهِ الذي رَزَقَني أن أسمَعَ هذا مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال لي عُمَرُ بنُ الخَطَّابِ، وكان تُجاهي جالِسًا: أتَعجَبُ مِن هذا؟ فقد قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم أعجَبَ مِن هذا قَبلَ أن تَأتيَ، فقُلتُ: وما ذاكَ بأبي أنتَ وأُمِّي؟ فقال عُمَرُ: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: مَن تَوضَّأ فأحسَنَ الوُضوءَ، ثُمَّ رَفَعَ نَظَرَه إلى السَّماءِ، فقال: أشهَدُ أنْ لا إلَهَ إلَّا اللهُ وحدَه لا شَريكَ له، وأشهَدُ أنَّ مُحَمَّدًا عَبدُه ورَسولُه، فُتِحَت له ثَمانيةُ أبوابِ الجَنَّةِ، يَدخُلُ مِن أيِّها شاءَ."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"صحيح لغيره","bab":"استغفار › أسباب المغفرة","dorar":"aJmGUGBX"},{"id":"س-03524","fp":"07d50666de32","stateId":53,"easy":"إذا قعدت في مصلاك بعد الصبح حتى تصلي الضحى لا تقول إلا خيراً ← تُغفر خطاياك ولو كانت أكثر من زبد البحر","cause":"من قَعَد في مُصَلَّاه حين ينصَرِفُ من الصُّبحِ حتَّى يُسَبِّحَ ركْعَتَيِ الضُّحى لا يقولُ إلَّا خيرًا","result":"غُفِرَ له خطاياه وإن كانت أكثَرَ مِن زَبَدِ البَحْرِ","explicit":true,"apply":{"k":"time","t":"الضحى"},"ref":"الأحكام الوسطى 1/416","srcLabel":"أبو داود","text":[["من قَعَد في مُصَلَّاه حين ينصَرِفُ من الصُّبحِ حتَّى يُسَبِّحَ ركْعَتَيِ الضُّحى لا يقولُ إلَّا خيرًا، ",1],["غُفِرَ له خطاياه وإن كانت أكثَرَ مِن زَبَدِ البَحْرِ",2]],"grade":"صحيح","narrator":"معاذ بن أنس","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (1287)، وأحمد (15623)، والطبراني في ((الكبير)) (20/ 196) (442) واللفظ لهم.","bab":"استغفار › مكفرات الذنوب","dorar":"GYYtgMmd"},{"id":"س-03694","fp":"40745fd5403d","stateId":53,"easy":"إذا صليت الصلاة ← تكون كفارة لما بينها وبين التي قبلها","cause":"الصَّلاةُ إلى الصَّلاةِ التي قَبلَها","result":"كَفَّارةٌ","explicit":true,"similar":["س-06535"],"ref":"تخريج المسند لشعيب 10576","srcLabel":"أحمد","text":[["الصَّلاةُ إلى الصَّلاةِ التي قَبلَها ",1],["كَفَّارةٌ",2],"، والجُمُعةُ إلى الجُمُعةِ التي قَبلَها كَفَّارةٌ، والشَّهرُ إلى الشَّهرِ الذي قَبلَهُ كَفَّارةٌ، إلَّا مِن ثلاثٍ -قال: فعَرَفْنا أنَّه أمْرٌ حدَثَ-: إلَّا مِنَ الشِّركِ باللهِ، ونَكثِ الصَّفقةِ، وتَركِ السُّنَّةِ. قال: قلنا: يا رسولَ اللهِ، هذا الشِّركُ باللهِ قد عرَفْناهُ، فما نَكثُ الصَّفقةِ، وتَركُ السُّنَّةِ؟ قال: أمَّا نَكثُ الصَّفقةِ؛ فأنْ تُعطيَ رَجُلًا بَيعَتَكَ، ثم تُقاتِلُهُ بسَيفِكَ، وأمَّا تَركُ السُّنَّةِ؛ فالخُروجُ مِن الجماعةِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح دون قوله: \"إلا من ثلاث\" إلخ","takhrij":"أخرجه أحمد (10576) واللفظ له، والحاكم (412)، والبيهقي في ((شعب الإيمان)) (3620)","bab":"اعتصام بالسنة › لزوم السنة","dorar":"ABD4mO4u"},{"id":"س-04049","fp":"ed22216561e1","stateId":53,"easy":"إذا أحسنت الوضوء ثم صليت ركعتين أو أربعاً تحسن فيها ← يُغفر لك","cause":"من توضأَ فأحسنَ وُضوءَه ، ثم قام فصلَّى ركعتَين - أو أربعًا ؛ شكَّ سهلٌ - ، يحسنُ فيها الذكرَ والخشوعَ ، ثم استغفر اللهَ","result":"غُفِر له","explicit":true,"apply":{"k":"count","t":"ركعتين · الوقت: بعد الوضوء"},"ref":"السلسلة الصحيحة 3398","srcLabel":"أحمد","text":[["من توضأَ فأحسنَ وُضوءَه ، ثم قام فصلَّى ركعتَين - أو أربعًا ؛ شكَّ سهلٌ - ، يحسنُ فيها الذكرَ والخشوعَ ، ثم استغفر اللهَ ؛ ",1],["غُفِر له",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"إسناده صحيح بنحوه","takhrij":"أخرجه أحمد (27546)، وابن أبي عاصم في ((الآحاد والمثاني)) (2040)، والطبراني في ((الدعاء)) (1848)","bab":"توبة › سقوط الذنوب بالاستغفار والتوبة","dorar":"r71KVq7z"},{"id":"س-06487","fp":"2b796089554e","stateId":53,"easy":"إذا حافظت على الصلوات الخمس والجمعة واجتنبت الكبائر ← تكون كفارة لما بينهن","cause":"الصَّلَاةُ الخَمْسُ، وَالْجُمْعَةُ إلى الجُمْعَةِ","result":"كَفَّارَةٌ لِما بيْنَهُنَّ، ما لَمْ تُغْشَ الكَبَائِرُ","explicit":true,"repOf":"س-06568","ref":"عارضة الأحوذي 2/146","text":["حديث  إنَّ الصلاةَ تكفِّرُ الذنوبَ إلا الكبائرُ [يعني حديث: ",["الصَّلَاةُ الخَمْسُ، وَالْجُمْعَةُ إلى الجُمْعَةِ",1],"، ",["كَفَّارَةٌ لِما بيْنَهُنَّ، ما لَمْ تُغْشَ الكَبَائِرُ",2],".]"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"صحيح","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"kJTgGYRL"},{"id":"س-06503","fp":"04e9277a9f0a","stateId":53,"easy":"إذا صليت الصلاة بعد الصلاة واجتنبت الكبائر ← تكون كفارة لما بينهما","cause":"إنَّ الصَّلاةَ إلى الصَّلاةِ","result":"كفَّارةٌ لِما بينهما ما اجتنِبَتِ الكبائرُ","explicit":true,"apply":{"k":"time","t":"دبر كل صلاة"},"ref":"فتح الباري لابن حجر 8/208","srcLabel":"فتح الباري لابن حجر","text":[["إنَّ الصَّلاةَ إلى الصَّلاةِ ",1],["كفَّارةٌ لِما بينهما ما اجتنِبَتِ الكبائرُ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"FfJSGpaW"},{"id":"س-06511","fp":"f65687955bfb","stateId":53,"easy":"إذا قمت في جوف الليل ← يكفّر كل خطيئة","cause":"وقيام العبد في جوف الليل","result":"يكفر كل خطيئة","explicit":true,"apply":{"k":"time","t":"في الليل"},"ref":"الأحكام الشرعية الكبرى 3/156","srcLabel":"النسائي","text":["أقبلنا مع رسول الله صلى الله عليه وسلم من غزوة تبوك قال فلما رأيته خالياً قلت يا رسول الله أخبرني بعمل يدخلني الجنة قال بخ لقد سألت عن عظيم وهو يسير على من يسر الله عليه تقيم الصلاة المكتوبة وتؤدي الزكاة المفروضة وتلقى الله لا تشرك به شيئاً أولا أدلك على رأس الأمر وعموده وذروة سنامه فأما رأس الأمر من أسلم يسلم وأما عموده فالصلاة وأما ذروة سنامه فالجهاد في سبيل الله أولا أدلك على أبواب الخير الصوم جنة والصدقة برهان ",["وقيام العبد في جوف الليل",1]," ",["يكفر كل خطيئة",2]," وتلا هذه الآية {تتجافى جنوبهم عن المضاجع يدعون ربهم خوفاً وطمعاً ومما رزقناهم ينفقون} أولا أدلك على أملك ذلك كله لله قال وأشار رسول الله صلى الله عليه وسلم بيده إلى لسانه قال قلت يا رسول الله وإنا لنؤاخذ بما نتكلم به قال ثكلتك أمك يا معاذ وهل يكب الناس على مناخرهم إلا حصائد ألسنتهم"],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي شيبة (30950)، وابن نصر في ((قيام الليل)) (صـ35) واللفظ لهما، والنسائي في ((الإغراب)) (92) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"hLyXOkA4"},{"id":"س-06533","fp":"65a11017d04c","stateId":53,"easy":"إذا صليت الخمس وحججت البيت وصمت رمضان ← كان حقاً على الله أن يغفر لك","cause":"مَن صَلَّى الصَّلَواتِ الخَمسَ، وحَجَّ البَيتَ، وصام رَمضانَ","result":"كان حَقًّا على اللهِ أنْ يَغفِرَ له","explicit":true,"apply":{"k":"time","t":"في رمضان"},"ref":"تخريج المسند لشعيب 22087","srcLabel":"الترمذي","text":[["مَن صَلَّى الصَّلَواتِ الخَمسَ، وحَجَّ البَيتَ، وصام رَمضانَ",1]," -ولا أدري أذَكَرَ الزَّكاةَ أم لا؟- ",["كان حَقًّا على اللهِ أنْ يَغفِرَ له",2]," إنْ هاجَرَ في سَبيلِه، أو مَكَثَ بأرضِه التي وُلِدَ بها، فقال مُعاذٌ: يا رسولَ اللهِ، أفأُخبِرُ النَّاسَ؟ قال: ذَرِ النَّاسَ يا مُعاذُ، في الجنَّةِ مِئةُ دَرَجةٍ، ما بيْنَ كلِّ دَرَجتَينِ مِئةُ سَنةٍ، والفِردَوسُ أعلى الجنَّةِ وأَوسطُها، ومنها تَفجَّرُ أنهارُ الجنَّةِ، فإذا سَأَلتُم اللهَ فاسأَلوه الفِردَوسَ."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2530) باختلاف يسير، وابن ماجه (4331) مختصراً، وأحمد (22087) واللفظ له","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"3EFOnLpI"},{"id":"س-06534","fp":"334492b649f4","stateId":53,"easy":"إذا صليت ← تحطّ كل صلاة ما بين يديها من خطيئة","cause":"إنَّ كُلَّ صَلاةٍ","result":"تَحُطُّ ما بيْنَ يَدَيها من خَطيئةٍ","explicit":true,"ref":"تخريج المسند لشعيب 23503","srcLabel":"أحمد","text":[["إنَّ كُلَّ صَلاةٍ ",1],["تَحُطُّ ما بيْنَ يَدَيها من خَطيئةٍ",2],"."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (23503) واللفظ له، والطبراني (4/127) (3881)، وتمام في ((الفوائد)) (1259)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"3faFZqRC"},{"id":"س-06535","fp":"ed339387b6c2","stateId":53,"easy":"إذا صليت المكتوبة ← تكون كفارة لما بينها وبين التي بعدها","cause":"الصَّلاةُ المكتوبةُ إلى الصَّلاةِ التي بَعدَها","result":"كفَّارةٌ لِما بَيْنَهما","explicit":true,"repOf":"س-03694","ref":"تخريج المسند لشعيب 7129","text":[["الصَّلاةُ المكتوبةُ إلى الصَّلاةِ التي بَعدَها ",1],["كفَّارةٌ لِما بَيْنَهما",2],"، قال: والـجُمُعةُ إلى الـجُمُعةِ، والشَّهرُ إلى الشَّهرِ -يَعْني رَمَضانَ إلى رَمَضانَ- كفَّارةٌ لِما بَيْنَهما، قال: ثم قال بعدَ ذلك: إلَّا مِن ثَلاثٍ -قال: فعَرَفتُ أنَّ ذلك لأَمْرٍ حَدَث-: إلَّا مِنَ الإشراكِ باللهِ، ونَكْثِ الصَّفْقةِ، وتَرْكِ السُّنَّةِ، قال: أمَّا نَكْثُ الصَّفْقةِ: أنْ تُبايِعَ رَجُلًا، ثم تُـخالِفَ إليه تُقاتِلُه بِسيفِك، وأما تَرْكُ السُّنَّةِ قال: قُلتُ: يا رسولَ اللهِ، أمَّا الإشراكُ باللهِ فقد عَرَفْناه، فما نَكْثُ الصَّفْقةِ؟ قال: فأنْ تُبايِعَ رَجُلًا ثم تُـخالِفَ إليه تُقاتِلُه بسَيفِك، وأمَّا تَرْكُ السُّنَّةِ فالـخُروجُ مِن الـجَماعةِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح دون قوله: إلا من ثلاث ... إلى آخر الحديث","takhrij":"أخرجه أحمد (7129) واللفظ له، والحاكم (412)، والبيهقي في ((شعب الإيمان)) (3620)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"dRf9RxIn"},{"id":"س-06599","fp":"ee8578fab7ec","stateId":53,"easy":"إذا أذنبت فأقم الصلاة ← فإن الحسنات يذهبن السيئات","cause":"أَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ","result":"إِنَّ الْحَسَنَاتِ يُذْهِبْنَ السَّيِّئَاتِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04050","ref":"سنن الترمذي 3115","text":["أَتَتْنِي امرأةٌ تَبْتَاعُ تَمْرًا ، فقلتُ : إنَّ في البيتِ تَمْرًا أَطْيَبَ منه ، فدَخَلَتْ مَعِيَ في البيتِ ، فأَهْوَيْتُ إليها ، فقَبَّلْتُها ، فأَتَيْتُ أبا بكرٍ ، فذَكَرْتُ ذلك له ؟ قال : اسْتُرْ على نَفْسِكَ وتُبْ ، ولا تُخْبِرْ أحدًا ، فلم أَصْبِرْ ، فأَتَيْتُ عمرَ ، فذَكَرْتُ ذلك له ؟ فقال اسْتُرْ على نَفْسِكَ وتُبْ ، ولا تُخْبِرْ أحدًا ، فلم أَصْبِرْ ، فأَتَيْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ، فذَكَرْتُ له ؟ فقال : أَخَلَفْتَ غازيًا في سبيلِ اللهِ في أهلِه بمِثْلِ هذا ، حتى تَمَنَّى أنه لم يَكُنْ أَسْلَمَ إلا تلك الساعةَ ، حتى ظَنَّ أنه من أهلِ النارِ . قال : وأَطْرَقَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم طويلًا حتى أُوحِيَ إليه :  وَ",["أَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ",1]," ",["إِنَّ الْحَسَنَاتِ يُذْهِبْنَ السَّيِّئَاتِ",2]," ذَلِكَ ذِكْرَى لِلذَّاكِرِينَ .  قال أَبُو الْيَسَرِ : فأَتَيْتُهُ ، فقرأها عَلَيَّ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ، فقال أصحابُه : يا رسولَ اللهِ ، أَلِهَذَا خاصَّةً أم للناسِ عامَّةً ؟ قال : بل للناسِ عامَّةً"],"grade":"صحيح","narrator":"أبو اليسر كعب بن عمرو","muhaddith":"حسن صحيح","takhrij":"أخرجه الترمذي (3115)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"Plnthd8L","merged":8,"otherRefs":["صحيح ابن حبان 1728 (صحيح)","صحيح مسلم 2763 (صحيح)","صحيح ابن ماجه 1155 (صحيح)","تخريج المسند لشعيب 4290 (صحيح)","ذخيرة الحفاظ 2/643 (صحيح)","تخريج المسند لشعيب 22112 (صحيح)"]},{"id":"س-06623","fp":"82e8cbc9c5d5","stateId":53,"easy":"إذا قمت تصلي ← تُجعل ذنوبك على رأسك وعاتقك فتتساقط كلما ركعت وسجدت","cause":"إذا قامَ العبدُ يصلِّي أتى بذُنوبِهِ ، فجَعلتُ علَى رأسِهِ وعاتقَهِ ، فَكُلَّما رَكَعَ أو سَجدَ","result":"تساقَطَت عنهُ","explicit":true,"ref":"نخب الافكار 7/222","srcLabel":"ابن حبان","text":["أنَّ عبدَ اللَّهِ بنَ عمرَ ، رأى فتًا وَهوَ يصلِّي قد أطالَ صلاتَهُ . فلمَّا انصرفَ منها قالَ: مَن يعرفُ هذا قالَ رجلٌ أَنا ، فقالَ عبدُ اللَّهِ: لو كُنتُ أعرفُهُ لأمرتُهُ أن يُطيلَ الرُّكوعَ والسُّجودَ ، فإنِّي سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ: ",["إذا قامَ العبدُ يصلِّي أتى بذُنوبِهِ ، فجَعلتُ علَى رأسِهِ وعاتقَهِ ، فَكُلَّما رَكَعَ أو سَجدَ ، ",1],["تساقَطَت عنهُ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح معاني الآثار)) (2732) واللفظ له، وابن حبان (1734)، والطبراني (13/316) (14108) باختلاف يسير","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"eaahZgcF"},{"id":"س-08171","fp":"b682e75cc6e6","stateId":53,"easy":"إذا وافق تأمين أهل الأرض تأمين أهل السماء ← يُغفر لهم","cause":"إذا وافقَ تأمينُ أهلِ الأرضِ تأمينَ أهل ِالسماءِ","result":"غُفِرَ لهم","explicit":true,"ref":"السلسلة الصحيحة 6/80","srcLabel":"البيهقي","text":["أنَّ أبا هريرةَ كان يُؤذِّنُ لمروانَ بنِ الحكمِ ، فاشترط أن لا يسبقَه ب { الضَّالِّينَ } حتى يعلمَ أنه دخل الصفَّ ، وكان إذا قال مروانُ { وَلَا الضَّالِّينَ } قال أبو هريرة : آمين ، يمُدُّ بها صوتَه ، وقال : ",["إذا وافقَ تأمينُ أهلِ الأرضِ تأمينَ أهل ِالسماءِ ",1],["غُفِرَ لهم",2]],"grade":"صحيح","narrator":"أبو رافع مولى رسول الله صلى الله عليه وسلم","muhaddith":"سنده صحيح","takhrij":"أخرجه البيهقي (2491) بلفظه.","bab":"ملائكة › أعمال الملائكة","dorar":"IrfgF9cQ"},{"id":"س-07766","fp":"76458f6dd856","stateId":53,"easy":"إذا أذنبت فأقم الصلاة ← فإن الحسنات يذهبن السيئات، وهي للناس عامة","cause":"وَأَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ...} إلى قولِه: {لِلذَّاكِرِينَ","result":"بل هي للناسِ عامةً","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04050","ref":"تخريج المسند لشعيب 2430","text":["أنَّ امرأةً مُغيبًا أتَتْ رجُلًا تشتري منه شيئًا، فقال: ادخُلي الدَّوْلَجَ حتى أُعطِيَكِ، فدخَلتْ، فقَبَّلَها وغمَزَها، فقالَتْ: وَيْحكَ؛ إنِّي مُغيبٌ، فترَكَها، وندِمَ على ما كان منه، فأتى عمرَ، فأخبَرَه بالذي صنَع، فقال: وَيْحَكَ، فلعلَّها مُغيبٌ، قال: فإنَّها مُغيبٌ، قال: فائتِ أبا بكرٍ، فاسأَلْه فأتى أبا بكرٍ، فأخبَرَه، فقال أبو بكرٍ: وَيْحَكَ؛ لعلَّها مُغيبٌ، قال: فإنَّها مُغيبٌ، قال: فائتِ النبيَّ صلَّى اللهُ عليه وسلَّمَ فأخبِرْه، فأتى النبيَّ صلَّى اللهُ عليه وسلَّمَ فأخبَرَه، فقال النبيُّ صلَّى اللهُ عليه وسلَّمَ: لعلَّها مُغيبٌ قال: فإنَّها مُغيبٌ، فسكَتَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، ونزَلَ القرآنُ: {",["وَأَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ...} إلى قولِه: {لِلذَّاكِرِينَ",1],"} [هود: 114] ، قال: فقال الرجُلُ: يا رسولَ اللهِ، أهي فيَّ خاصةً، أو في الناسِ عامةً؟ قال: فقال عمرُ: لا، ولا نُعْمةَ عينٍ لَكَ، ",["بل هي للناسِ عامةً",2],"، قال: فضحِكَ النبيُّ صلَّى اللهُ عليه وسلَّمَ وقال: صدَقَ عمرُ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (2430) واللفظ له، والطبراني (12/215) (12931)، وابن عدي في ((الكامل في الضعفاء)) (5/199)","bab":"قرآن › أسباب النزول","dorar":"oL6yb3Cc","merged":2,"otherRefs":["تخريج المسند لشعيب 2206 (صحيح)"]},{"id":"س-03699","fp":"4ba7da0d506a","stateId":53,"easy":"إذا قمت إلى الصلاة ← تتحاتّ عنك خطاياك كما يتحاتّ ورق الشجر","cause":"إنَّ العَبدَ المُسلِمَ إذا قامَ إلى الصلاةِ","result":"تَحاتَّتْ عنه خَطاياهُ كما تَحاتُّ وَرَقُ هذه الشَّجَرةِ","explicit":true,"repOf":"س-06634","ref":"تخريج المسند لشعيب 23716","text":["كنَّا مع سَلْمانَ تَحتَ شجَرةٍ، فأخَذَ غُصْنًا منها فنَفَضَه فتَساقَطَ ورَقُه، فقال: ألَا تَسْألوني عمَّا صَنَعتُ؟ فقُلْنا: أخْبِرْنا، فقال: كنَّا مع رسولِ اللهِ صلَّى اللهُ عليه وسَلَّمَ في ظِلِّ شجَرةٍ فأخَذَ غُصْنًا منها فنَفَضَه فتَساقَطَ ورَقُه، فقال: ألَا تَسْألوني عمَّا صَنَعتُ؟ فقُلْنا: أخْبِرْنا يا رسولَ اللهِ، فقال: ",["إنَّ العَبدَ المُسلِمَ إذا قامَ إلى الصلاةِ، ",1],["تَحاتَّتْ عنه خَطاياهُ كما تَحاتُّ وَرَقُ هذه الشَّجَرةِ",2],"."],"grade":"حسن","narrator":"سلمان الفارسي","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (23716) واللفظ له، والطيالسي (687)، ومحمد بن نصر المروزي في ((تعظيم قدر الصلاة)) (83)","bab":"اعتصام بالسنة › لزوم السنة","dorar":"ErfWDlBk"},{"id":"س-04749","fp":"bba047653425","stateId":53,"easy":"إذا صليت تريد وجه الله ← تتساقط عنك ذنوبك كما يتساقط ورق الشجر","cause":"لَيُصلِّي الصَّلاةَ، يُريدُ بها وَجهَ اللهِ","result":"فتَهافَتُ عنه ذُنوبُه، كما يَتَهافَتُ هذا الوَرَقُ عن هذه الشجَرةِ","explicit":true,"ref":"تخريج المسند لشعيب 21556","srcLabel":"أحمد","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ خرَجَ زمنَ الشتاءِ والوَرَقُ يَتَهافَتُ، فأخَذَ بغُصنَيْنِ من شَجرةٍ، قال: فجعَلَ ذلك الورَقُ يَتَهافَتُ، قال: فقال: يا أبا ذَرٍّ، قُلْتُ: لبَّيْكَ يا رسولَ اللهِ، قال: إنَّ العَبدَ المُسلِمَ ",["لَيُصلِّي الصَّلاةَ، يُريدُ بها وَجهَ اللهِ",1],"، ",["فتَهافَتُ عنه ذُنوبُه، كما يَتَهافَتُ هذا الوَرَقُ عن هذه الشجَرةِ",2],"."],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (21556)","bab":"رقائق وزهد › الإخلاص","dorar":"wBGN2JuL"},{"id":"س-06509","fp":"c01805327d05","stateId":53,"easy":"إذا صليت في آخر الوقت ← فهو عفو الله (وأوله رضوانه)","cause":"والوقتُ الآخِرُ","result":"عفوُ اللَّهِ","explicit":true,"ref":"هداية الرواة 1/297","srcLabel":"الترمذي","text":["الوقتُ الأوَّلُ منَ الصَّلاةِ رضوانُ اللَّهِ ",["والوقتُ الآخِرُ",1]," ",["عفوُ اللَّهِ",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه الترمذي (172) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (7/148)، والبيهقي (2131) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"bOC7wao8"},{"id":"س-06556","fp":"191bccab3b41","stateId":53,"easy":"إذا أقمت الصلاة وآتيت الزكاة ومت لا تشرك بالله ← كان حقاً على الله أن يغفر لك","cause":"مَن أقامَ الصَّلاةَ ، وآتى الزَّكاةَ ، وماتَ لا يشرِكُ باللَّهِ شيئًا","result":"كانَ حقًّا على اللَّهِ عزَّ وجلَّ أن يغفِرَ لَهُ هاجرًا وماتَ في مولدِهِ فقُلنا : يا رسولَ اللَّهِ ، ألا نخبرُ بِها النَّاسَ فيستبشِروا بِها","explicit":true,"ref":"صحيح النسائي 3132","srcLabel":"النسائي","text":[["مَن أقامَ الصَّلاةَ ، وآتى الزَّكاةَ ، وماتَ لا يشرِكُ باللَّهِ شيئًا ، ",1],["كانَ حقًّا على اللَّهِ عزَّ وجلَّ أن يغفِرَ لَهُ هاجرًا وماتَ في مولدِهِ فقُلنا : يا رسولَ اللَّهِ ، ألا نخبرُ بِها النَّاسَ فيستبشِروا بِها ",2],"؟ فقالَ : إنَّ للجنَّةِ مائةَ درجةٍ ، بينَ كلِّ درجتينِ كما بينَ السَّماءِ والأرضِ ، أعدَّها اللَّهُ للمجاهِدينَ في سبيلِهِ ، ولولا أن أشقَّ على المؤمنينَ ، ولا أجدُ ما أحملُهُم علَيهِ ، ولا تَطيبُ أنفسُهُم أن يتخلَّفوا بعدي ، ما قعدتُ خلفَ سريَّةٍ ، ولوَدِدْتُ أن أُقتَلُ ، ثمَّ أُحيا ، ثمَّ أُقتَلُ"],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"إسناده حسن","takhrij":"أخرجه النسائي (3132)، والطبراني في ((الشاميين)) (1200)، وابن عساكر في ((تاريخ دمشق)) (52/ 135) واللفظ لهم.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"RrtkuYT1"},{"id":"س-06588","fp":"1a3bf67378eb","stateId":53,"easy":"إذا حافظت على الصلوات الخمس ← تطهرك كنهر تغتسل فيه خمس مرات","cause":"الصلواتِ الخمسِ","result":"كمَثَلِ نَهرٍ جارٍ ببابِ أحَدِكم، يَغتسِلُ منه كلَّ يومٍ خَمسَ مرَّاتٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"similar":["س-00549"],"ref":"تذكرة الحفاظ 287","srcLabel":"مسلم","text":["مَثَلُ ",["الصلواتِ الخمسِ",1]," [يعني حديث:  مَثَلُ الصَّلواتِ الخَمسِ المكتوباتِ، ",["كمَثَلِ نَهرٍ جارٍ ببابِ أحَدِكم، يَغتسِلُ منه كلَّ يومٍ خَمسَ مرَّاتٍ",2],".]"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه مسلم (668) مطولاً","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"zhKTl64F","merged":5,"otherRefs":["معجم الشيوخ 1/393 (حسن)","تخريج المسند لشعيب 9692 (صحيح)","تخريج المسند لشعيب 14853 (صحيح)","التمهيد 24/228 (صحيح)"]},{"id":"س-06605","fp":"d612b06cbc80","stateId":53,"easy":"إذا صليت ركعتين (بعد الخصام) ← تكون كفارة لكل ملاحاة (مخاصمة)","cause":"رَكْعَتَانِ","result":"تَكْفيرُ كلِّ لِحاءٍ","explicit":true,"apply":{"k":"count","t":"ركعتين"},"ref":"السلسلة الصحيحة 1789","srcLabel":"ابن الأعرابي","text":[["تَكْفيرُ كلِّ لِحاءٍ",2]," ",["رَكْعَتَانِ",1]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن رجاله ثقات","takhrij":"أخرجه ابن الأعرابي في ((معجمه)) (1811)، وتمام في ((فوائده)) (939)، والديلمي في ((الفردوس)) (2387)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"Bl5SiGTw"},{"id":"س-07151","fp":"6ca5641c2fe9","stateId":53,"easy":"إذا أذنبت فتوضأ وصلِّ ← فإن الحسنات يذهبن السيئات","cause":"تَوضَّأْ، وصَلِّ","result":"فأنزَلَ اللهُ تعالَى: وَأَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04050","ref":"تخريج سير أعلام النبلاء 7/378","text":["جاء رجُلٌ، فقالَ: يا رسولَ اللهِ! رجُلٌ لَقِيَ امرأةً، فصنَعَ بها ما يَصنَعُ الرجُلُ بامرأتِه؛ إلا أنَّه لم يُجامِعْها.\nقال: ",["فأنزَلَ اللهُ تعالَى: {وَأَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ",2],"..} [هود: 114] الآيةَ. فقال له: ",["تَوضَّأْ، وصَلِّ",1],". قلتُ: يا رسولَ اللهِ! هذا له خاصَّةً، أو للناسِ عامَّةً؟ قال: للناسِ -أو للمُسلِمينَ- عامَّةً."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3113)، وأحمد (22112)، والدارقطني في ((سننه)) (483) باختلاف يسير.","bab":"علم › حسن السؤال ونصح العالم","dorar":"aQg6sKPv"},{"id":"س-07709","fp":"db4b9338491b","stateId":53,"easy":"إذا أذنبت فتوضأ وضوءاً حسناً ثم صلِّ ← فإن الحسنات يذهبن السيئات","cause":"تَوَضَّأْ وُضوءًا حَسَنًا ثُمَّ قُمْ فَصَلِّ","result":"أَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04050","ref":"المستدرك على الصحيحين 476","text":["أنَّه كان قاعِدًا عندَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فجاءَهُ رَجُلٌ، فقالَ: يا رسولَ اللهِ، ما تَقولُ في رَجُلٍ أَصابَ مِنِ امْرأةٍ لا تَحِلُّ له، فلَمْ يَدَعْ شَيْئًا يُصيبُهُ الرَّجُلُ مِنِ امْرأَتِهِ إلَّا وقد أَصابَهُ مِنها إلَّا أنَّه لمْ يُجامِعْها؟ فقالَ: «",["تَوَضَّأْ وُضوءًا حَسَنًا ثُمَّ قُمْ فَصَلِّ",1],"». قالَ: وأنزلَ اللهُ عزَّ وجلَّ: {",["أَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ",2],"} [هود: 114] الآيةَ، قالَ: فقالَ: هي لي خاصَّةً أَمْ لِلمُسلِمينَ عامَّةً؟ قالَ: «بلْ هي لِلْمُسْلِمينَ عامَّةً»."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه أحمد (22112)، والطبراني (20/ 136) (351)، وأبو نعيم في ((الحلية)) (3/ 165) بلفظ قريب.","bab":"قرآن › أسباب النزول","dorar":"yVEav39k"},{"id":"س-00549","fp":"410dd7081e90","stateId":53,"easy":"إذا حافظت على الصلوات الخمس ← تُطهّرك كما يطهّر النهر من اغتسل فيه خمساً","cause":"مَثلُ الصَّلاةِ","result":"كمَثلِ نَهَرٍ جارٍ ببابِ رجلٍ غَمرٍ عذبٍ يقتحمُ فيهِ كلَّ يومٍ خمسَ مرَّاتٍ فما ترونَ ذلِكَ يُبقي مِن درنِهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-06588","ref":"صحيح ابن خزيمة 1/ 413","text":["سَمِعْتُ سعدًا وَناسًا مِن أصحابِ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولونَ: كانَ رجلانِ أخَوانِ في عَهْدِ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ، وَكانَ أحدُهُما أفضلَ منَ الآخرِ، فتوُفِّيَ الَّذي هوَ أفضلُهُما، ثمَّ عُمِّرَ الآخرُ بعدَهُ أربَعينَ ليلةً ثمَّ توُفِّيَ، فذُكِرَ لرَسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فضيلةُ الأوَّلِ على الآخَرِ، فقالَ: ألم يَكُن يصلِّي؟ قالوا: بلَى يا رسولَ اللَّهِ، وَكانَ لا بأسَ بِهِ قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: فما يُدريكُم ماذا بلغَت بِهِ صلاتُهُ؟ إنَّما ",["مَثلُ الصَّلاةِ",1]," ",["كمَثلِ نَهَرٍ جارٍ ببابِ رجلٍ غَمرٍ عذبٍ يقتحمُ فيهِ كلَّ يومٍ خمسَ مرَّاتٍ فما ترونَ ذلِكَ يُبقي مِن درنِهِ",2]," لا تَدرونَ ماذا بلغَت بِهِ صلاتُهُ"],"grade":"صحيح","narrator":"سعد بن أبي وقاص وناس من أصحاب رسول الله","muhaddith":"أخرجه في صحيحه","bab":"آداب عامة › ضرب الأمثال","dorar":"b4WGGPe6","merged":2,"otherRefs":["صحيح الترغيب 371 (صحيح)"]},{"id":"س-06494","fp":"b86b13babfa4","stateId":53,"easy":"إذا أذنبت ثم صليت ← تغسل الصلاة ذنوبك","cause":"فإذا صلَّيتُم الصُّبحَ","result":"غَسَلَتْها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الترغيب 357","srcLabel":"الطبراني","text":["تحترِقونَ تحترِقونَ ، ",["فإذا صلَّيتُم الصُّبحَ",1]," ",["غَسَلَتْها",2]," ، ثمَّ تحترِقونَ تحترِقونَ ، فإذا صلَّيتُم الظُّهرَ غَسَلَتْها ، ثمَّ تحترِقونَ تحترِقونَ ، فإذا صلَّيتُم العصرَ غَسَلَتْها ، ثمَّ تحترِقونَ تحترِقونَ ، فإذا صلَّيتُم المَغربَ غَسَلَتْها ، ثمَّ تحترِقونَ تحترِقونَ ، فإذا صلَّيتُم العِشاءَ غَسَلَتْها ، ثمَّ تنامونَ فلا يُكْتَبُ عليكُم حتَّى تستَيقِظُوا"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"حسن صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (2224)، والخطيب في ((تاريخ بغداد)) (2091) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"Egi9O2TT"},{"id":"س-03539","fp":"9579ff7b8abf","stateId":54,"easy":"إذا اغتسلت يوم الجمعة وتطهرت وادّهنت وتطيبت ← يُغفر لك ما بين الجمعتين","cause":"مَن اغتَسَل يومَ الجمعةِ فتطهَّر ما استطاع مِن طُهرٍ ثمَّ ادَّهَن مِن دُهنِه أو طِيبِ بيتِه ثمَّ راح إلى الجمعةِ ولم يُفرِّقْ بينَ اثنينِ ثمَّ صلَّى ما بدا له فإذا خرَج الإمامُ أنصَت","result":"غُفِر له ما بينَه وبينَ الجمعةِ الأخرى","explicit":true,"star":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"similar":["س-03396","س-03398","س-03538","س-03513","س-03321","س-03399","س-03400","س-03405","س-03507","س-03566","س-03571","س-03537"],"ref":"تخريج صحيح ابن حبان 2776","srcLabel":"البخاري","text":[["مَن اغتَسَل يومَ الجمعةِ فتطهَّر ما استطاع مِن طُهرٍ ثمَّ ادَّهَن مِن دُهنِه أو طِيبِ بيتِه ثمَّ راح إلى الجمعةِ ولم يُفرِّقْ بينَ اثنينِ ثمَّ صلَّى ما بدا له فإذا خرَج الإمامُ أنصَت ",1],["غُفِر له ما بينَه وبينَ الجمعةِ الأخرى",2]],"grade":"صحيح","narrator":"سلمان","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه البخاري (868) والدرامي (1582)، والطيالسي (694) بلفظه.","bab":"استغفار › مكفرات الذنوب","dorar":"yJ4dmadZ"},{"id":"س-03550","fp":"faecf4c2ed59","stateId":54,"easy":"إذا تطهرت يوم الجمعة كما أُمرت ثم خرجت حتى تأتيها ← تكون كفارة لما قبلها","cause":"ما من رَجُلٍ يَتطهَّرُ يَومَ الجُمُعةِ كما أُمِرَ، ثمَّ يَخرُجُ من بَيتِه حتَّى يَأتِيَ الجُمُعةَ، فيَقعُدُ، فيُنصِتُ حتَّى يَقضِيَ صَلاتَه","result":"إلَّا كان كَفارةً لِمَا قَبْلَه منَ الجُمُعةِ","explicit":true,"star":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"ref":"المستدرك على الصحيحين 1043","srcLabel":"البخاري","text":["قالَ لي رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا سَلمانُ، ما يَومُ الجُمُعةِ؟ قُلتُ: اللهُ ورَسولُه أعلَمُ، قالَ: يا سَلمانُ، يَومُ الجُمُعةِ فيه جُمِع أبوكَ -أو أبوكُم-، وأنا أُحَدِّثُكَ عنْ يَومِ الجُمُعةِ: ",["ما من رَجُلٍ يَتطهَّرُ يَومَ الجُمُعةِ كما أُمِرَ، ثمَّ يَخرُجُ من بَيتِه حتَّى يَأتِيَ الجُمُعةَ، فيَقعُدُ، فيُنصِتُ حتَّى يَقضِيَ صَلاتَه",1]," ",["إلَّا كان كَفارةً لِمَا قَبْلَه منَ الجُمُعةِ",2],"."],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن خزيمة (1732) بلفظه، والبخاري (883) بنحوه.","bab":"استغفار › مكفرات الذنوب","dorar":"DOD36Gqm"},{"id":"س-06619","fp":"02d22ca9c917","stateId":54,"easy":"إذا توضأت فأحسنت ثم صليت مع الجماعة ← يغفر الله لك (من واقعة)","cause":"قد تَوضَّأتَ فأحسَنتَ الوُضوءَ؟ قال: بَلى يا رَسولَ اللهِ، قال: ثُمَّ شَهِدتَ الصَّلاةَ معنا","result":"فإنَّ اللهَ قد غَفَرَ لكَ حَدَّكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"apply":{"k":"time","t":"بعد الوضوء"},"ref":"صحيح مسلم 2765","srcLabel":"متفق عليه","text":["بينَما رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم في المَسجِدِ، ونَحنُ قُعودٌ معهُ، إذ جاءَ رَجُلٌ فقال: يا رَسولَ اللهِ، إنِّي أصَبتُ حَدًّا، فأقِمْه عليَّ، فسَكَتَ عنه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، ثُمَّ أعادَ فقال: يا رَسولَ اللهِ، إنِّي أصَبتُ حَدًّا، فأقِمْه عليَّ، فسَكَتَ عنه، وأُقيمَتِ الصَّلاةُ، فلَمَّا انصَرَفَ نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّم، قال أبو أُمامةَ: فاتَّبَعَ الرَّجُلُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم حينَ انصَرَفَ، واتَّبَعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم أنظُرُ ما يَرُدُّ على الرَّجُلِ، فلَحِقَ الرَّجُلُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: يا رَسولَ اللهِ، إنِّي أصَبتُ حَدًّا، فأقِمْه عليَّ، قال أبو أُمامةَ: فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أرَأيتَ حينَ خَرَجتَ مِن بَيتِكَ، أليسَ ",["قد تَوضَّأتَ فأحسَنتَ الوُضوءَ؟ قال: بَلى يا رَسولَ اللهِ، قال: ثُمَّ شَهِدتَ الصَّلاةَ معنا",1],"؟ فقال: نَعَم يا رَسولَ اللهِ، قال: فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["فإنَّ اللهَ قد غَفَرَ لكَ حَدَّكَ، ",2],"أو قال: ذَنبَكَ."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"hFknMbtE","merged":6,"otherRefs":["المستدرك على الصحيحين 7857 (صحيح)","سبل الهدى والرشاد 9/199 (حسن)","صحيح البخاري 6823 (صحيح)","صحيح مسلم 2764 (صحيح)","تخريج المسند لشعيب 22266 (صحيح)"]},{"id":"س-03396","fp":"3ae72dde40c6","stateId":54,"easy":"إذا أحسنت الوضوء يوم الجمعة وأتيتها فدنوت وأنصت ← يُغفر لك ما بين الجمعتين وثلاثة أيام زيادة","cause":"مَن تَوضَّأَ يومَ الجمعةِ ، فأحسَنَ الوُضوءَ ، ثُم أتَى الجمعةَ ، فدَنا ، و اسْتمَعَ ، و أنْصَتَ","result":"غُفِرَ له ما بَينهُ و بين الجمعةِ الأُخرَى ، و زِيادةُ ثلاثةِ أيامٍ ، و مَن مَسَّ الحَصَى فقدْ لَغَا","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","ref":"صحيح الجامع 6179","text":[["مَن تَوضَّأَ يومَ الجمعةِ ، فأحسَنَ الوُضوءَ ، ثُم أتَى الجمعةَ ، فدَنا ، و اسْتمَعَ ، و أنْصَتَ ، ",1],["غُفِرَ له ما بَينهُ و بين الجمعةِ الأُخرَى ، و زِيادةُ ثلاثةِ أيامٍ ، و مَن مَسَّ الحَصَى فقدْ لَغَا",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (857) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"ohe2ERMx","merged":2,"otherRefs":["صحيح ابن خزيمة 3/ 285 (صحيح)"]},{"id":"س-03292","fp":"155d2aab59e9","stateId":54,"easy":"إذا صليت الجمعة إلى الجمعة واجتنبت الكبائر ← تكون كفارة لما بينهما","cause":"الجمُعةُ إلى الجمُعةِ","result":"كفَّارةُ ما بينهما ما لم تُغْشَ الكبائرُ","explicit":true,"star":true,"similar":["س-03290","س-03695"],"ref":"صحيح الجامع 3110","srcLabel":"مسلم","text":[["الجمُعةُ إلى الجمُعةِ ",1],["كفَّارةُ ما بينهما ما لم تُغْشَ الكبائرُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (233) بزيادة فيه","bab":"استغفار › أسباب المغفرة","dorar":"IUWeF1mp"},{"id":"س-03398","fp":"e1834f600576","stateId":54,"easy":"إذا اغتسلت يوم الجمعة وصليت ما قُدّر لك ثم أنصت ← يُغفر لك ما بين الجمعتين وثلاثة أيام","cause":"مَنِ اغْتَسَلَ يومَ الجمعَةِ ، ثُمَّ أَتَى الجمعَةَ فصلَّى مَا قُدِّرَ له ، ثُمَّ أنصتَ حتَّى يفرَغَ الإمامُ مِنْ خُطْبَتِهِ ، ثُمَّ يصلِّى معَهُ","result":"غُفِرَ لَهُ مَا بينَه وبينَ الجمعَةِ الأخرى ، و فضلُ ثلاثَةِ أيَّامٍ","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","ref":"صحيح الجامع 6062","text":[["مَنِ اغْتَسَلَ يومَ الجمعَةِ ، ثُمَّ أَتَى الجمعَةَ فصلَّى مَا قُدِّرَ له ، ثُمَّ أنصتَ حتَّى يفرَغَ الإمامُ مِنْ خُطْبَتِهِ ، ثُمَّ يصلِّى معَهُ ، ",1],["غُفِرَ لَهُ مَا بينَه وبينَ الجمعَةِ الأخرى ، و فضلُ ثلاثَةِ أيَّامٍ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (857) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"MqLMxJYW"},{"id":"س-03538","fp":"7c7fb6c7ac58","stateId":54,"easy":"إذا اغتسلت يوم الجمعة وأحسنت ولبست صالح ثيابك وتطيبت ← يُغفر لك ما بين الجمعتين وثلاثة أيام","cause":"مَن اغتَسَل يومَ الجمعةِ فأحسَن غُسْلَه ولبِس مِن صالحِ ثيابِه ومسَّ مِن طِيبِ بيتِه أو دُهنِه","result":"غُفِر له ما بينَه وبينَ الجمعةِ الأخرى وزيادةُ ثلاثةِ أيَّامٍ مِن الَّتي بعدَها","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","ref":"تخريج صحيح ابن حبان 2780","text":[["مَن اغتَسَل يومَ الجمعةِ فأحسَن غُسْلَه ولبِس مِن صالحِ ثيابِه ومسَّ مِن طِيبِ بيتِه أو دُهنِه ",1],["غُفِر له ما بينَه وبينَ الجمعةِ الأخرى وزيادةُ ثلاثةِ أيَّامٍ مِن الَّتي بعدَها",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده قوي على شرط مسلم","takhrij":"أخرجه ابن حبان (2780) واللفظ له، ومسلم (857)، والترمذي (498) كلاهما بنحوه وزيادة في آخره.","bab":"استغفار › مكفرات الذنوب","dorar":"Z0XQyTcM"},{"id":"س-06594","fp":"7a5c6da604a1","stateId":54,"easy":"إذا تطهرت في بيتك ثم مشيت إلى المسجد لفريضة ← خطوة تحطّ خطيئة وأخرى ترفع درجة","cause":"مَنْ تَطَهَّرَ في بيْتِهِ ثُمَّ مشى إلى بيتٍ من بيوتِ اللهِ ، ليَقْضِيَ فريضَةً مِنْ فرائِضِ اللهِ","result":"كانتْ خطواتُهُ إحداهما تحطُّ خطيئَةً ، والأخرى ترفَعُ درجَةً","explicit":true,"star":true,"otherNeedIds":[41],"ref":"صحيح الجامع 6155","srcLabel":"مسلم","text":[["مَنْ تَطَهَّرَ في بيْتِهِ ثُمَّ مشى إلى بيتٍ من بيوتِ اللهِ ، ليَقْضِيَ فريضَةً مِنْ فرائِضِ اللهِ ، ",1],["كانتْ خطواتُهُ إحداهما تحطُّ خطيئَةً ، والأخرى ترفَعُ درجَةً",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن شاهين في ((الترغيب في فضائل الأعمال)) (88) واللفظ له، وأخرجه مسلم (666) باختلاف يسير","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"n5ehlVe5"},{"id":"س-01508","fp":"0721e3ba0485","stateId":54,"easy":"إذا أذّنت للصلاة ← يُغفر لك مدى صوتك ويشهد لك كل من سمعك","cause":"والمُؤذِّنُ","result":"يُغفَرُ له مَدَّ صوتِه ويُصدِّقُه مَن سمِعه مِن رَطْبٍ ويابسٍ وله مِثْلُ أجرِ مَن صلَّى معه","explicit":true,"similar":["س-01501"],"otherNeedIds":[40,53],"ref":"تخريج العواصم والقواصم 9/ 135","srcLabel":"النسائي","text":["وله مِثلُ أجرِ مَن صلَّى [يعني حديث: إنَّ اللهَ وملائكتَه يُصلُّونَ على الصَّفِّ المُقدَّمِ ",["والمُؤذِّنُ",1]," ",["يُغفَرُ له مَدَّ صوتِه ويُصدِّقُه مَن سمِعه مِن رَطْبٍ ويابسٍ وله مِثْلُ أجرِ مَن صلَّى معه",2],"]"],"grade":"صحيح","narrator":"[البراء بن عازب]","muhaddith":"حديث صحيح","takhrij":"أخرجه النسائي (646)، وأحمد (18506) مطولاً من حديث البراء بن عازب رضي الله عنه","bab":"أذان › فضل التأذين","dorar":"IAQt4qlU","merged":6,"otherRefs":["صحيح الترغيب 234 (صحيح)","صحيح الجامع 6644 (صحيح)","تخريج المسند لشاكر 14/40 (صحيح)","نتائج الأفكار 1/313 (حسن)","صحيح الترغيب 235 (صحيح)"]},{"id":"س-03513","fp":"aa7a4e305ec0","stateId":54,"easy":"إذا اغتسلت يوم الجمعة وتطيبت ولبست أحسن ثيابك ← تكون كفارة لما بين الجمعتين","cause":"مَنِ اغتَسَلَ يَوَم الجُمُعةِ، ومَسَّ من طِيبٍ إنْ كان عندَه، ولَبِسَ من أحسَنِ ثيابِه، ثم خَرَجَ حتى يأتيَ المَسجِدَ فيَركَعَ إنْ بَدا له، ولم يُؤْذِ أحَدًا، ثم أنصَتَ إذا خَرَجَ إمامُه حتى يُصلِّيَ","result":"كانت كفَّارةً لِمَا بيْنَها وبيْنَ الجُمُعةِ الأخرى","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","ref":"تخريج المسند لشعيب 23571","text":[["مَنِ اغتَسَلَ يَوَم الجُمُعةِ، ومَسَّ من طِيبٍ إنْ كان عندَه، ولَبِسَ من أحسَنِ ثيابِه، ثم خَرَجَ حتى يأتيَ المَسجِدَ فيَركَعَ إنْ بَدا له، ولم يُؤْذِ أحَدًا، ثم أنصَتَ إذا خَرَجَ إمامُه حتى يُصلِّيَ",1],"؛ ",["كانت كفَّارةً لِمَا بيْنَها وبيْنَ الجُمُعةِ الأخرى",2],".وقال في مَوضِعٍ آخَرَ: إنَّ عبدَ اللهِ بنَ كَعبِ بنِ مالكٍ السُّلَميَّ، حَدَّثَه أنَّ أبا أيُّوبَ صاحِبَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ حَدَّثَه، أنَّه سَمِعَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: مَنِ اغتَسَلَ يَومَ الجُمُعةِ.. وزادَ فيه: ثم خَرَجَ وعليه السَّكينةُ حتى يأتيَ المَسجِدَ."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (23571) واللفظ له، وابن خزيمة (1775)، والطبراني (4/160) (4006)","bab":"استغفار › مكفرات الذنوب","dorar":"n04NEtrz","merged":4,"otherRefs":["صحيح الترغيب 688 (صحيح)","صحيح ابن خزيمة 3/ 244 (صحيح)","تخريج المسند لشعيب 11768 (حسن)"]},{"id":"س-03519","fp":"422758d81a5b","stateId":54,"easy":"إذا حضرت الجمعة بوقار وإنصات ولم تتخطّ الرقاب ولم تؤذِ أحداً ← تكون كفارة لك إلى الجمعة التالية وثلاثة أيام","cause":"ورجلٌ حَضرَها بوقارٍ وإنصاتٍ وسُكونٍ، ولم يتخطَّ رقبةَ مسلِمٍ، ولم يؤذِ أحدًا","result":"فَهوَ كفَّارةٌ لَهُ إلى الجمعةِ الَّتي تَليها، وزيادةُ ثلاثةِ أيَّامٍ","explicit":true,"otherNeedIds":[44],"ref":"صحيح ابن خزيمة 3/ 283","srcLabel":"أبو داود","text":["يَحضُرُ الجمُعةَ ثلاثةٌ: رجلٌ يَحضرُها يَلغو، فَهوَ حظُّهُ منها، ورجلٌ حضرَها بدُعاءٍ، فَهوَ رجلٌ دعا اللَّهَ، فإن شاءَ اللَّهُ أعطاهُ، وإن شاءَ مَنعَهُ، ",["ورجلٌ حَضرَها بوقارٍ وإنصاتٍ وسُكونٍ، ولم يتخطَّ رقبةَ مسلِمٍ، ولم يؤذِ أحدًا",1],"، ",["فَهوَ كفَّارةٌ لَهُ إلى الجمعةِ الَّتي تَليها، وزيادةُ ثلاثةِ أيَّامٍ",2]," ؛ لأنَّ اللَّهَ يقولُ: {مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ عَشْرُ أَمْثَالِهَا} [الأنعامُ: 160]"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (1113)، وأحمد (7002)، والبيهقي (5897) باختلاف يسير","bab":"استغفار › مكفرات الذنوب","dorar":"I9wWla72","merged":4,"otherRefs":["صحيح الترغيب 723 (صحيح)","تخريج زاد المعاد 1/417 (حسن)","تخريج المسند لشاكر 10/174 (صحيح)"]},{"id":"س-01732","fp":"dbf267accf8c","stateId":54,"easy":"إذا أتيت بيت المقدس لا تريد إلا الصلاة فيه ← تخرج منه كيوم ولدتك أمك","cause":"مَن أتى هذا البيتَ - يُريدُ به بيتَ المقدِسِ - لا يُريدُ إلَّا الصَّلاةَ فيه","result":"أنْ يخرُجَ منه كيومَ ولَدَتْه أُمُّه","explicit":true,"similar":["س-03964"],"ref":"تخريج صحيح ابن حبان 1633","srcLabel":"النسائي","text":["أنَّ سُلَيمانَ بنَ داودَ سأَل اللهَ تبارَك وتعالى ثلاثًا فأعطاه اثنتَيْنِ وأرجو أنْ يكونَ قد أعطاه الثَّالثةَ سأَله مُلْكًا لا ينبغي لِأحَدٍ مِن بعدِه فأعطاه إيَّاه وسأَله حُكْمًا يُواطِئُ حُكْمَه فأعطاه إيَّاه وسأَله ",["مَن أتى هذا البيتَ - يُريدُ به بيتَ المقدِسِ - لا يُريدُ إلَّا الصَّلاةَ فيه",1]," ",["أنْ يخرُجَ منه كيومَ ولَدَتْه أُمُّه",2]," ) فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ( وأرجو أنْ يكونَ قد أعطاه الثَّالثَ )"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (693)، وابن ماجه (1408) باختلاف يسير، وأحمد (6644) مطولاً باختلاف يسير","bab":"أنبياء › عام","dorar":"IggiFtnt","merged":3,"otherRefs":["صحيح ابن خزيمة 1334 (صحيح)","المنار المنيف 74 (صحيح)"]},{"id":"س-03509","fp":"f27bdf091dee","stateId":54,"easy":"إذا مشيت إلى مسجد الجماعة ← خطوة تمحو سيئة وخطوة تكتب حسنة","cause":"مَن راحَ إلى مَسجِدِ الجَماعةِ","result":"فخُطْوةٌ تَمحو سيِّئةً، وخُطْوةٌ تكتُبُ له حسنةً","explicit":true,"otherNeedIds":[40],"ref":"تخريج المسند لشعيب 6599","srcLabel":"أحمد","text":[["مَن راحَ إلى مَسجِدِ الجَماعةِ",1],"؛ ",["فخُطْوةٌ تَمحو سيِّئةً، وخُطْوةٌ تكتُبُ له حسنةً",2],"، ذاهبًا وراجعًا."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (6599) واللفظ له، وابن حبان (2039)، والطبراني (14/78) (14683)","bab":"استغفار › مكفرات الذنوب","dorar":"SKYe9snb","merged":3,"otherRefs":["صحيح ابن حبان 2039 (صحيح)","صحيح النسائي 704 (صحيح)"]},{"id":"س-01530","fp":"6ee2d58c09ab","stateId":54,"easy":"إذا قلت عند سماع الأذان «أشهد أن لا إله إلا الله... رضيت بالله رباً...» ← يُغفر لك ذنبك","cause":"مَن قال حينَ يَسمَعُ المُؤَذِّنَ: أشهَدُ أنْ لا إلَهَ إلَّا اللهُ وحدَه لا شَريك له، وأنَّ مُحَمَّدًا عَبدُه ورَسولُه، رَضيتُ باللهِ رَبًّا، وبمُحَمَّدٍ رَسولًا، وبالإسلامِ دينًا","result":"غُفِرَ له ذَنبُه","explicit":true,"apply":{"k":"say","t":"«أشهَدُ أنْ لا إلَهَ إلَّا اللهُ وحدَه لا شَريك له، وأنَّ مُحَمَّدًا عَبدُه ورَسولُه، رَضيتُ باللهِ رَبًّا» · الوقت: عند الأذان"},"ref":"صحيح مسلم 386","srcLabel":"أبو داود","text":[["مَن قال حينَ يَسمَعُ المُؤَذِّنَ: أشهَدُ أنْ لا إلَهَ إلَّا اللهُ وحدَه لا شَريك له، وأنَّ مُحَمَّدًا عَبدُه ورَسولُه، رَضيتُ باللهِ رَبًّا، وبمُحَمَّدٍ رَسولًا، وبالإسلامِ دينًا، ",1],["غُفِرَ له ذَنبُه",2],". قال ابنُ رُمحٍ في رِوايَتِه: مَن قال حينَ يَسمَعُ المُؤَذِّنَ: وأنا أشهَدُ، ولَم يَذكُرْ قُتَيبةُ قَولَه: وأنا."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"[صحيح]","takhrij":"أخرجه أبو داود (525)، والترمذي (210)، وابن ماجه (721)، وأحمد (1565) واللفظ لهم.","bab":"أذان › ما يقول إذا سمع المؤذن","dorar":"GtnoLpye","merged":2,"otherRefs":["صحيح الجامع 6422 (صحيح)"]},{"id":"س-03321","fp":"9f3ff19fb9ea","stateId":54,"easy":"إذا اغتسلت يوم الجمعة وتطيبت ولبست أحسن ثيابك ولم تتخطّ الناس ← تكون كفارة لما بين الجمعتين","cause":"مَنِ اغتسلَ يومَ الجمعةِ ، ومسَّ مِنْ طيبِ امرأتِهِ إِنْ كان لها ، ولبِسَ مِنْ صالِحِ ثيابِهِ ، ثُمَّ لم يتخَطَّ رِقابَ الناسِ ، ولم يلْغُ عندَ الموعِظَةِ","result":"كانَتْ كفَّارَةً لما بينَها","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","ref":"صحيح الجامع 6067","text":[["مَنِ اغتسلَ يومَ الجمعةِ ، ومسَّ مِنْ طيبِ امرأتِهِ إِنْ كان لها ، ولبِسَ مِنْ صالِحِ ثيابِهِ ، ثُمَّ لم يتخَطَّ رِقابَ الناسِ ، ولم يلْغُ عندَ الموعِظَةِ",1]," ، ",["كانَتْ كفَّارَةً لما بينَها",2]," ، ومَنْ لَغَا ، وتَخَطَّى رِقَابَ الناسِ ، كانَتْ لَهُ ظُهْرًا"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (347) واللفظ له، وابن خزيمة (1810)، والطحاوي في ((شرح معاني الآثار)) (2166) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"Nq2jmg1M","merged":2,"otherRefs":["صحيح الترغيب 721 (صحيح)"]},{"id":"س-03399","fp":"578453d983cf","stateId":54,"easy":"إذا اغتسلت يوم الجمعة وتطهرت ولبست أحسن ثيابك ← يغفر الله لك ما بين الجمعتين","cause":"منِ اغتسل يومَ الجمعَةِ ، فأحسنَ الغُسْلَ ، وتطهَّرَ فأحسَنَ الطُّهورَ ، ولبِسَ مِنْ أحسَنِ ثيابِهِ ، ومَسَّ مَا كتَبَ اللهُ لَهُ مِنْ طيبِ أوْ دُهْنِ أهلِهِ ، ثُمَّ أتى المسجدَ ، فلم يَلْغُ . ولم يُفَرِّقْ بينَ اثنينِ","result":"غفرَ اللهُ له ما بينَه وبينَ الجمعةِ الأُخْرى","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","otherNeedIds":[40],"ref":"صحيح الجامع 6064","text":[["منِ اغتسل يومَ الجمعَةِ ، فأحسنَ الغُسْلَ ، وتطهَّرَ فأحسَنَ الطُّهورَ ، ولبِسَ مِنْ أحسَنِ ثيابِهِ ، ومَسَّ مَا كتَبَ اللهُ لَهُ مِنْ طيبِ أوْ دُهْنِ أهلِهِ ، ثُمَّ أتى المسجدَ ، فلم يَلْغُ . ولم يُفَرِّقْ بينَ اثنينِ",1]," ، ",["غفرَ اللهُ له ما بينَه وبينَ الجمعةِ الأُخْرى",2]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (1097)، وأحمد (21569) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"9gViapAI","merged":2,"otherRefs":["صحيح ابن خزيمة 3/ 282 (صحيح)"]},{"id":"س-01474","fp":"68ced0ece1b9","stateId":54,"easy":"إذا مشيت إلى الجماعات وجلست في المسجد بعد الصلاة وأسبغت الوضوء في المكاره ← تعيش بخير وتموت بخير وتخرج من خطيئتك كيوم ولدتك أمك","cause":"المشيُ على الأقدامِ إلى الجماعاتِ، والجلوسُ في المساجِدِ خلفَ الصَّلواتِ، وإبلاغُ الوضوءِ أماكنَهُ في المكارِهِ، من يفعَلْ ذلِك","result":"يعِشْ بخيرٍ، وَيَمُت بخيرٍ، ويكونُ من خطيئتِهِ كيومِ ولدتْهُ أمُّهُ","explicit":true,"apply":{"k":"time","t":"دبر كل صلاة"},"otherNeedIds":[7,51],"ref":"هداية الرواة 693","srcLabel":"الترمذي","text":["رأيتُ ربِّي تبارَكَ وتعالى في أحسنِ صورةٍ فقالَ: فيمَ يختصمُ الملأُ الأعلى يا محمَّدُ ؟ قلتُ: أنت أعلَم أي ربِّ - مرَّتينِ -، قال: لا فوضعَ كفه بينَ كتفيَّ فوجدتُ بردَها بينَ ثديَيَّ؛ فعلِمتُ ما في السَّماء والأرضِ – ثمَّ تَلا هذه الآيةَ -:  كَذَلِكَ نُرِي إِبْرَاهِيمَ مَلَكُوتَ السَّمَاوَاتِ وَالْأَرْضِ وَلِيَكُونَ مِنَ الْمُوقِنِينَ، ثمَّ قالَ: فيمَ يختَصِمُ الملأُ الأعلَى يا محمَّدُ ؟ قُلتُ: في الكفَّاراتِ، قالَ: وما هنَّ؟ قلتُ: ",["المشيُ على الأقدامِ إلى الجماعاتِ، والجلوسُ في المساجِدِ خلفَ الصَّلواتِ، وإبلاغُ الوضوءِ أماكنَهُ في المكارِهِ، من يفعَلْ ذلِك",1]," ",["يعِشْ بخيرٍ، وَيَمُت بخيرٍ، ويكونُ من خطيئتِهِ كيومِ ولدتْهُ أمُّهُ",2],"، ومِن الدَّرجاتِ إطعامُ الطَّعامِ، وبذلُ السَّلامِ، وأن يقومَ باللَّيل والنَّاسُ نيامٌ، قال: قلِ: اللَّهمَّ إنِّي أسألُكَ الطَّيِّباتِ وتركَ المنكَراتِ وحبَّ المساكينِ وأن تغفِرَ لي خطيئتي وترحمَني وتتوبَ عليَّ وإذا أردتَ فتنةً في قومٍ ؛ فتوفَّني غيرَ مفتونٍ"],"grade":"صحيح","narrator":"عبدالرحمن بن عائش الحضرمي","muhaddith":"إسناده صحيح","takhrij":"أخرجه الدارمي (2195)، والترمذي في ((العلل الكبير)) (660)، والمعافى بن عمران في ((الزهد)) (115) بنحوه.","bab":"وضوء › فضل الوضوء","dorar":"HWckou6V"},{"id":"س-01529","fp":"de62052612dd","stateId":54,"easy":"إذا رددت مع المؤذن ما يقول ← يُغفر لك وتدخل الجنة","cause":"من قال مثلَ ما يقولُ المؤذنُ","result":"غُفِرَ لهُ وأُدْخِلَ الجنةَ","explicit":true,"apply":{"k":"time","t":"عند الأذان"},"otherNeedIds":[55],"ref":"ذخيرة الحفاظ 4/2358","srcLabel":"ابن عدي","text":[["من قال مثلَ ما يقولُ المؤذنُ ",1],["غُفِرَ لهُ وأُدْخِلَ الجنةَ",2]],"grade":"صحيح","narrator":"المغيرة بن شعبة","muhaddith":"صحيح من غير هذا الوجه","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (3/ 108) بلفظه.","bab":"أذان › ما يقول إذا سمع المؤذن","dorar":"ZEvDyDlj"},{"id":"س-01721","fp":"399aae4373df","stateId":54,"easy":"إذا أتيت المسجد لا يدفعك إلا الصلاة فيه ← تخرج من خطيئتك كيوم ولدتك أمك","cause":"ألَّا يَأتيَه أحَدٌ لا يَنهَزُه إلَّا الصَّلاةُ فيه","result":"أن يُخرِجَه مِن خَطيئتِه كيَوْمَ وَلَدَتْه أُمُّه","explicit":true,"ref":"الأحكام الكبير 2/11","srcLabel":"النسائي","text":["حديث: أن الذي جدد بناءه إنما هو سليمان بن داود. [أنَّ سُلَيْمانَ بنَ داوُدَ صلَّى اللهُ عليه وسلَّمَ لمَّا بَنى بَيْتَ المَقدِسِ سألَ اللهَ عَزَّ وجَلَّ خِلالًا ثَلاثةً؛ سألَ اللهَ عَزَّ وجَلَّ حُكْمًا يُصادِفُ حُكْمَه فأُوتيه، وسَألَ اللهَ عَزَّ وجَلَّ مُلْكًا لا يَنْبَغي لأحَدٍ مِن بَعْدِه فأُوتيه، وسألَ اللهَ عَزَّ وجَلَّ حينَ فَرَغَ مِن بِناءِ المَسجِدِ ",["ألَّا يَأتيَه أحَدٌ لا يَنهَزُه إلَّا الصَّلاةُ فيه",1]," ",["أن يُخرِجَه مِن خَطيئتِه كيَوْمَ وَلَدَتْه أُمُّه",2],"]"],"grade":"صحيح","narrator":"[عبد الله بن عمرو]","muhaddith":"صحيح","takhrij":"أخرجه النسائي (693)، وابن ماجة (1408)، وابن خزيمة (1334) بنحوه تامًا.","bab":"أنبياء › عام","dorar":"OJ9ObYgs"},{"id":"س-03290","fp":"b9f82ab2a557","stateId":54,"easy":"إذا صليت الجمعة ← تكون كفارة لما بينها وبين الجمعة التي تليها","cause":"الجمعةُ","result":"كَفَّارَةٌ لمَّا بينَها و بين الجمعةِ التي تَلِيها","explicit":true,"repOf":"س-03292","ref":"صحيح الترغيب 685","text":[["الجمعةُ ",1],["كَفَّارَةٌ لمَّا بينَها و بين الجمعةِ التي تَلِيها ",2],"، و زِيادَةُ ثلاثَةِ أيامٍ ، و ذلكَ بِأنَّ اللهَ عزَّ و جلَّ قال : ( مَنْ جاء بِالحَسَنَةِ فَلهُ عَشْرُ أَمْثَالِها )"],"grade":"صحيح","narrator":"أبو مالك الأشعري","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (3/ 298) (\n3459 )","bab":"استغفار › أسباب المغفرة","dorar":"VF3UlY7f"},{"id":"س-03375","fp":"228d1af88bde","stateId":54,"easy":"إذا اغتسلت يوم الجمعة وأتيت المسجد لا تؤذي أحداً ← تُغفر ذنوبك أو تكون كفارة إلى الجمعة التالية","cause":"إنَّ المسلِمَ إذا اغتسلَ يومَ الجمعَةِ ثمَّ أقبل إلى المسجِدِ لا يؤذي أحدًا فإن لم يجِدْ الإمامُ خرج صلَّى ما بدا له وإن وجد الإمامَ قد خرجَ جلس فاستمَع وأنصتَ حتى يقضِيَ الإمامُ جمعتَهُ وكلامَهُ","result":"إن لم يُغفَرْ له في جمعتِهِ تلك ذنوبُه كلُّها أن يكون كفارَّةً للجمعةِ التي تليها","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"ref":"مجمع الزوائد 2/174","srcLabel":"أحمد","text":[["إنَّ المسلِمَ إذا اغتسلَ يومَ الجمعَةِ ثمَّ أقبل إلى المسجِدِ لا يؤذي أحدًا فإن لم يجِدْ الإمامُ خرج صلَّى ما بدا له وإن وجد الإمامَ قد خرجَ جلس فاستمَع وأنصتَ حتى يقضِيَ الإمامُ جمعتَهُ وكلامَهُ",1]," ",["إن لم يُغفَرْ له في جمعتِهِ تلك ذنوبُه كلُّها أن يكون كفارَّةً للجمعةِ التي تليها",2]],"grade":"صحيح","narrator":"نبيشة الخير الهذلي","muhaddith":"رجاله رجال الصحيح خلا شيخ أحمد وهو ثقة","takhrij":"أخرجه أحمد (20721) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"vWIHO2jt"},{"id":"س-03376","fp":"9ae9fd100a2e","stateId":54,"easy":"إذا شهدت يوم الجمعة مسلماً ← يغفر الله لك","cause":"إنَّ اللَّهَ تباركَ وتعالى ليسَ بتاركٍ أحدًا منَ المسلمينَ يومَ الجمعةِ","result":"إلَّا غفرَ له","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"ref":"مجمع الزوائد 2/167","srcLabel":"الطبراني","text":[["إنَّ اللَّهَ تباركَ وتعالى ليسَ بتاركٍ أحدًا منَ المسلمينَ يومَ الجمعةِ",1]," ",["إلَّا غفرَ له",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"رجاله رجال الصحيح خلا شيخ الطبراني","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (4817)، وأبو نعيم في ((تاريخ أصبهان)) (1/360) واللفظ لهما، وابن عدي في ((الكامل في الضعفاء)) (3/185) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"mXiVyBAw"},{"id":"س-03400","fp":"1ebc53742989","stateId":54,"easy":"إذا اغتسلت يوم الجمعة وتطيبت ← يُغفر لك من الجمعة إلى الجمعة وثلاثة أيام","cause":"إذا كان يومُ الجُمُعَةِ فاغتسل الرجلُ ، وغسل رأسَه ، ثم تَطَيَّبَ من أَطْيَبِ طِيبِهِ ، ولَبِسَ من صالِحِ ثيابِهِ ، ثم خرج إلى الصلاةِ ولم يُفَرِّقْ بين اثْنَيْنِ ، ثم استمع للإمامِ","result":"غُفِرَ له من الجُمُعَةِ إلى الجُمُعَةِ وزيادةُ ثلاثةِ أيامٍ","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","ref":"صحيح ابن خزيمة 1803","text":[["إذا كان يومُ الجُمُعَةِ فاغتسل الرجلُ ، وغسل رأسَه ، ثم تَطَيَّبَ من أَطْيَبِ طِيبِهِ ، ولَبِسَ من صالِحِ ثيابِهِ ، ثم خرج إلى الصلاةِ ولم يُفَرِّقْ بين اثْنَيْنِ ، ثم استمع للإمامِ",1]," ، ",["غُفِرَ له من الجُمُعَةِ إلى الجُمُعَةِ وزيادةُ ثلاثةِ أيامٍ",2]," ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن خزيمة (1803)، والبيهقي (6169)","bab":"استغفار › أسباب المغفرة","dorar":"K2vujdRW"},{"id":"س-03405","fp":"b7be2b3ca4fc","stateId":54,"easy":"إذا اغتسلت وبكّرت ودنوت وأنصت يوم الجمعة ← يُغفر لك ما بين الجمعتين وثلاثة أيام","cause":"مَنْ غسَّل واغتسل ، وبكَّر وابتكر ، ودنا وأنصت واستمع","result":"غُفر له ما بينَ الجُمُعةِ إلى الجُمُعةِ ، وزيادةُ ثلاثةِ أيامٍ","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","ref":"السنن الكبرى للبيهقي 3/227","text":["قال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ وذَكَر يومَ الجُمُعةِ : ",["مَنْ غسَّل واغتسل ، وبكَّر وابتكر ، ودنا وأنصت واستمع ",1],["غُفر له ما بينَ الجُمُعةِ إلى الجُمُعةِ ، وزيادةُ ثلاثةِ أيامٍ ، ",2],"ومَنْ مسَّ الحصا فقد لغا"],"grade":"صحيح","narrator":"أوس بن أبي أوس وقيل أوس بن أوس والد عمرو","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (345)، وابن أبي شيبة (4990)، وابن حبان (116) واللفظ لهم.","bab":"استغفار › أسباب المغفرة","dorar":"UVAN0tG2"},{"id":"س-03423","fp":"4b6666ae238c","stateId":54,"easy":"إذا تطهرت ومشيت إلى الجمعة وأنصت حتى يقضي الإمام صلاته ← تكون كفارة لما بينها وبين الجمعة التالية ما اجتنبت الكبائر","cause":"لا يتَطَهَّرُ رَجُلٌ مُسلِمٌ، ثُمَّ يَمْشي إلى المسجِدِ، ثُمَّ يُنصِتُ حتى يَقضيَ الإمامُ صلاتَه","result":"إلَّا كان كفَّارةً لِما بَينَها وبَينَ الجُمُعةِ التي بَعدَها ما اجتُنِبَتِ المَقْتَلةُ","explicit":true,"ref":"تخريج المسند لشعيب 23729","srcLabel":"النسائي","text":["أتَدْري ما يومُ الجُمُعةِ؟ قُلتُ: اللهُ ورسولُه أعْلَمُ، ثُمَّ قال: أتَدْري ما يومُ الجُمُعةِ؟ قُلتُ: نَعَمْ -قال: لا أدْري، زَعَمَ سَألَه الرابِعةَ أمْ لا- قال: قلتُ: هو اليومُ الذي جُمِعَ فيه أبوه أو أبوكُم، قال النبيُّ صلَّى اللهُ عليه وسَلَّمَ: ألَا أُحَدِّثُكَ عن يَومِ الجُمُعةِ؟ ",["لا يتَطَهَّرُ رَجُلٌ مُسلِمٌ، ثُمَّ يَمْشي إلى المسجِدِ، ثُمَّ يُنصِتُ حتى يَقضيَ الإمامُ صلاتَه",1]," ",["إلَّا كان كفَّارةً لِما بَينَها وبَينَ الجُمُعةِ التي بَعدَها ما اجتُنِبَتِ المَقْتَلةُ",2],"."],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (1725)، وأحمد (23729) واللفظ له","bab":"استغفار › أسباب المغفرة","dorar":"sdAYrqiw"},{"id":"س-03427","fp":"096fec82306c","stateId":54,"easy":"إذا أحسنت الطهور ثم أتيت الجمعة فأنصت ← تكون كفارة لك إلى الجمعة التالية ما اجتنبت الكبائر","cause":"لا يتطَهَّرُ الرَّجُلُ فيُحسِنُ طُهورَه، ثمَّ يأتي الجمُعةَ، فيُنصِت حتَّى يقضيَ الإمامُ صلاتَه","result":"إلَّا كانت كفَّارةً له ما بينه وبَينَ الجمُعةِ المُقبِلةِ ما اجتَنَب المَقتَلةَ","explicit":true,"similar":["س-06561"],"ref":"المصابيح في الأحاديث المتواترة 581","srcLabel":"المصابيح في الأحاديث المتواترة","text":["أتدري ما يومُ الجُمعةِ؟ لكنِّي أدري ما يومُ الجُمعةِ! ",["لا يتطَهَّرُ الرَّجُلُ فيُحسِنُ طُهورَه، ثمَّ يأتي الجمُعةَ، فيُنصِت حتَّى يقضيَ الإمامُ صلاتَه",1],"، ",["إلَّا كانت كفَّارةً له ما بينه وبَينَ الجمُعةِ المُقبِلةِ ما اجتَنَب المَقتَلةَ",2]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"استغفار › أسباب المغفرة","dorar":"tVOSIbhK"},{"id":"س-03507","fp":"f07d13e8893f","stateId":54,"easy":"إذا اغتسلت يوم الجمعة ولبست ثيابك وتطيبت ومشيت إليها ← يُغفر لك ما بين الجمعتين","cause":"مَن اغتسَلَ يومَ الجُمعةِ، ثُمَّ لَبِسَ ثيابَه، ومَسَّ طِيبًا إنْ كان عندَه، ثُمَّ مَشى إلى الجُمعةِ وعليه السَّكينةُ، ولم يَتخَطَّ أحَدًا، ولم يُؤذِه، ورَكَعَ ما قُضيَ له، ثُمَّ انتظَرَ حتى يَنصرِفَ الإمامُ","result":"غُفِرَ له ما بيْنَ الجُمعتَينِ","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","ref":"تخريج المسند لشعيب 21729","text":[["مَن اغتسَلَ يومَ الجُمعةِ، ثُمَّ لَبِسَ ثيابَه، ومَسَّ طِيبًا إنْ كان عندَه، ثُمَّ مَشى إلى الجُمعةِ وعليه السَّكينةُ، ولم يَتخَطَّ أحَدًا، ولم يُؤذِه، ورَكَعَ ما قُضيَ له، ثُمَّ انتظَرَ حتى يَنصرِفَ الإمامُ",1],"؛ ",["غُفِرَ له ما بيْنَ الجُمعتَينِ",2],"."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (21729) واللفظ له، والطبراني كما في ((الترغيب والترهيب)) للمنذري (1/278)","bab":"استغفار › مكفرات الذنوب","dorar":"lJHUxnY5"},{"id":"س-03566","fp":"9876e1d1e9d8","stateId":54,"easy":"إذا اغتسلت يوم الجمعة وأحسنت ولبست صالح ثيابك وتطيبت ← يكفّر الله عنك ما بين الجمعتين","cause":"منِ اغتسلَ يومَ الجمُعةِ فأحسنَ الغسلَ، ثمَّ لبسَ من صالِحِ ثيابِهِ، ثمَّ مَسَّ مِن دُهْنِ بَيتِهِ ما كتبَ اللَّهُ لَهُ، أو مِن طيبِهِ، ثمَّ لم يُفرِّق بينَ اثنينِ","result":"كفَّرَ اللَّهُ عنهُ ما بينَهُ وبينَ الجمُعةِ قبلَها","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","ref":"صحيح ابن خزيمة 3/ 245","text":[["منِ اغتسلَ يومَ الجمُعةِ فأحسنَ الغسلَ، ثمَّ لبسَ من صالِحِ ثيابِهِ، ثمَّ مَسَّ مِن دُهْنِ بَيتِهِ ما كتبَ اللَّهُ لَهُ، أو مِن طيبِهِ، ثمَّ لم يُفرِّق بينَ اثنينِ",1]," ",["كفَّرَ اللَّهُ عنهُ ما بينَهُ وبينَ الجمُعةِ قبلَها",2]," . قالَ سعيدٌ: فذَكَرتُها لعمارةَ بنِ عَمرِو بنِ حزمٍ قالَ: صَدقَ، وزيادةُ ثلاثةِ أيَّامٍ. قالَ لَنا بُندارٌ: أحفظُهُ من فيهِ، وعن أبيهِ."],"grade":"صحيح","narrator":"أبو ذر","muhaddith":"أخرجه في صحيحه [وقال عن قول بندار]: هذا عندي وهم, والصحيح: عن سعيد، عن أبيه","takhrij":"أخرجه أحمد (21569)، والحاكم (1074)، وإسماعيل الأصبهاني في ((الترغيب والترهيب)) (916) واللفظ لهم.","bab":"استغفار › مكفرات الذنوب","dorar":"5azyolVb"},{"id":"س-03571","fp":"f2abe3250ef6","stateId":54,"easy":"إذا اغتسلت يوم الجمعة وتطهرت وادّهنت ← يُغفر لك ما بين الجمعتين","cause":"يَغتَسِلُ رَجُلٌ يَومَ الجُمُعةِ، ويَتَطَهَّرُ ما استَطاعَ مِن طُهرٍ، ويَدَّهِنُ مِن دُهنِه، أو يَمَسُّ مِن طيبِ بَيتِه، ثُمَّ يَخرُجُ فلا يُفَرِّقُ بَينَ اثنَينِ، ثُمَّ يُصَلِّي ما كُتِبَ لهُ، ثُمَّ يُنصِتُ إذا تَكَلَّمَ الإمامُ","result":"غُفِرَ له ما بَينَه وبَينَ الجُمُعةِ الأُخرى","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","ref":"مجموع الشروح الفقهية. 121/31","text":["لا ",["يَغتَسِلُ رَجُلٌ يَومَ الجُمُعةِ، ويَتَطَهَّرُ ما استَطاعَ مِن طُهرٍ، ويَدَّهِنُ مِن دُهنِه، أو يَمَسُّ مِن طيبِ بَيتِه، ثُمَّ يَخرُجُ فلا يُفَرِّقُ بَينَ اثنَينِ، ثُمَّ يُصَلِّي ما كُتِبَ لهُ، ثُمَّ يُنصِتُ إذا تَكَلَّمَ الإمامُ",1],"، إلَّا ",["غُفِرَ له ما بَينَه وبَينَ الجُمُعةِ الأُخرى",2],"."],"grade":"صحيح","narrator":"سلمان","muhaddith":"صحيح","bab":"استغفار › مكفرات الذنوب","dorar":"YnoXV0gx"},{"id":"س-03695","fp":"2d9d2d8c300a","stateId":54,"easy":"إذا صليت الجمعة ← تكون كفارة لما بينها وبين الجمعة التي قبلها","cause":"والجُمُعةُ إلى الجُمُعةِ التي قَبلَها","result":"كَفَّارةٌ","explicit":true,"repOf":"س-03292","ref":"تخريج المسند لشعيب 10576","text":["الصَّلاةُ إلى الصَّلاةِ التي قَبلَها كَفَّارةٌ، ",["والجُمُعةُ إلى الجُمُعةِ التي قَبلَها",1]," ",["كَفَّارةٌ",2],"، والشَّهرُ إلى الشَّهرِ الذي قَبلَهُ كَفَّارةٌ، إلَّا مِن ثلاثٍ -قال: فعَرَفْنا أنَّه أمْرٌ حدَثَ-: إلَّا مِنَ الشِّركِ باللهِ، ونَكثِ الصَّفقةِ، وتَركِ السُّنَّةِ. قال: قلنا: يا رسولَ اللهِ، هذا الشِّركُ باللهِ قد عرَفْناهُ، فما نَكثُ الصَّفقةِ، وتَركُ السُّنَّةِ؟ قال: أمَّا نَكثُ الصَّفقةِ؛ فأنْ تُعطيَ رَجُلًا بَيعَتَكَ، ثم تُقاتِلُهُ بسَيفِكَ، وأمَّا تَركُ السُّنَّةِ؛ فالخُروجُ مِن الجماعةِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح دون قوله: \"إلا من ثلاث\" إلخ","takhrij":"أخرجه أحمد (10576) واللفظ له، والحاكم (412)، والبيهقي في ((شعب الإيمان)) (3620)","bab":"اعتصام بالسنة › لزوم السنة","dorar":"ABD4mO4u"},{"id":"س-03964","fp":"410bb4bc660f","stateId":54,"easy":"إذا أتيت بيت المقدس لا يدفعك إلا الصلاة فيه ← تخرج من خطيئتك كيوم ولدتك أمك","cause":"مَن أتَى بَيتَ المَقْدِسِ لا يَنْهَزُه إلَّا الصَّلاةُ فيهِ","result":"خَرَجَ مِن خَطِيئَتِه مِثْلَ يَوْمِ وَلَدَتْه أُمُّه","explicit":true,"repOf":"س-01732","ref":"تخريج المسند لشاكر 10/128","text":["دَخَلْتُ على عبْدِ اللهِ بنِ عمْرٍو وهوَ في حائِطٍ له بالطَّائفِ يُقالُ لهُ: الوَهْطُ، وهوَ مُخاصِرٌ فتًى مِن قُرَيشٍ يُزَنُّ بشُرْبِ الخَمْرِ، فقُلْتُ: بَلَغَني عنْكَ حَديثٌ: أنَّه مَن شَرِبَ شَرْبةَ خَمْرٍ لمْ يَقْبَلِ اللهُ له تَوْبةً أرْبَعينَ صَباحًا، وأنَّ الشَّقِيَّ مَن شَقِيَ في بَطْنِ أُمِّه ، وأنَّه ",["مَن أتَى بَيتَ المَقْدِسِ لا يَنْهَزُه إلَّا الصَّلاةُ فيهِ، ",1],["خَرَجَ مِن خَطِيئَتِه مِثْلَ يَوْمِ وَلَدَتْه أُمُّه،",2]," فلمَّا سَمِعَ الفَتَى ذِكْرَ الْخَمْرِ، اجْتَذَب يَدَهُ مِن يَدِه، ثمَّ انطَلَقَ، ثمَّ قال عَبدُ اللهِ بنُ عَمْرٍو: إنِّي لا أُحِلُّ لأحَدٍ أنْ يَقولَ علَيَّ ما لمْ أقُلْ؛ سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يَقولُ: مَن شربَ منَ الخمرِ شَربةً لم تُقبَلْ لَهُ صلاةٌ أربعينَ صباحًا، فإن تابَ تابَ اللَّهُ عليهِ ، فإن عادَ لم تُقبَلْ لَهُ صلاةٌ أربعينَ صباحًا، فإن تابَ تابَ اللَّهُ عليهِ ، فإن عادَ قالَ : فلا أدري في الثَّالثةِ أو في الرَّابعةِ - فإن عادَ كانَ حقًّا على اللَّهِ أن يُسقيَهُ من رَدغةِ الخبالِ يومَ القيامةِ قالَ وسَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ : إنَّ اللَّهَ عزَّ وجلَّ خلقَ خلقَهُ في ظلمةٍ، ثمَّ ألقَى عليهِم من نورِهِ يومئذٍ، فمَن أصابَهُ من نورِهِ يومئذٍ، اهتَدى، ومَن أخطأَهُ، ضلَّ فلذلِكَ أقولُ : جفَّ القلمُ على علمِ اللَّهِ عزَّ وجلَّ وسَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ : إنَّ سُلَيْمانَ بنَ داودَ عليهِ السَّلامُ سألَ اللَّهَ ثلاثًا، فأعطاهُ اثنتَينِ، ونحنُ نرجو أن تَكونَ لَهُ الثَّالثةُ : فسألَهُ حُكْمًا يصادِفُ حُكْمَهُ، فأعطاهُ اللَّهُ إيَّاهُ، وسألَهُ مُلكًا لا ينبَغي لأحَدٍ من بَعدِهِ، فأعطاهُ إيَّاهُ، وسألَهُ أيُّما رجلٍ خَرجَ من بيتِهِ لا يريدُ إلَّا الصَّلاةَ في هذا المسجدِ خرجَ من خَطيئتِهِ مثلَ يومِ ولدتهُ أمُّهُ، فَنحنُ نرجو أن يَكونَ اللَّهُ عزَّ وجلَّ قد أَعطاهُ إيَّاهُ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (693، 5664) مفرقاً مختصراً باختلاف يسير، وابن ماجه (1408، 3377) مفرقاً مختصراً باختلاف يسير","bab":"توبة › الحض على التوبة","dorar":"ktDNR7No"},{"id":"س-03966","fp":"1860859b2529","stateId":54,"easy":"إذا خرجت من بيتك لا تريد إلا الصلاة في المسجد الأقصى ← تخرج من خطيئتك كيوم ولدتك أمك","cause":"أيُّما رجلٍ خَرجَ من بيتِهِ لا يريدُ إلَّا الصَّلاةَ في هذا المسجدِ","result":"خرجَ من خَطيئتِهِ مثلَ يومِ ولدتهُ أمُّهُ","explicit":true,"apply":{"k":"time","t":"عند الخروج من البيت"},"ref":"تخريج المسند لشاكر 10/128","srcLabel":"النسائي","text":["دَخَلْتُ على عبْدِ اللهِ بنِ عمْرٍو وهوَ في حائِطٍ له بالطَّائفِ يُقالُ لهُ: الوَهْطُ، وهوَ مُخاصِرٌ فتًى مِن قُرَيشٍ يُزَنُّ بشُرْبِ الخَمْرِ، فقُلْتُ: بَلَغَني عنْكَ حَديثٌ: أنَّه مَن شَرِبَ شَرْبةَ خَمْرٍ لمْ يَقْبَلِ اللهُ له تَوْبةً أرْبَعينَ صَباحًا، وأنَّ الشَّقِيَّ مَن شَقِيَ في بَطْنِ أُمِّه ، وأنَّه مَن أتَى بَيتَ المَقْدِسِ لا يَنْهَزُه إلَّا الصَّلاةُ فيهِ، خَرَجَ مِن خَطِيئَتِه مِثْلَ يَوْمِ وَلَدَتْه أُمُّه، فلمَّا سَمِعَ الفَتَى ذِكْرَ الْخَمْرِ، اجْتَذَب يَدَهُ مِن يَدِه، ثمَّ انطَلَقَ، ثمَّ قال عَبدُ اللهِ بنُ عَمْرٍو: إنِّي لا أُحِلُّ لأحَدٍ أنْ يَقولَ علَيَّ ما لمْ أقُلْ؛ سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يَقولُ: مَن شربَ منَ الخمرِ شَربةً لم تُقبَلْ لَهُ صلاةٌ أربعينَ صباحًا، فإن تابَ تابَ اللَّهُ عليهِ ، فإن عادَ لم تُقبَلْ لَهُ صلاةٌ أربعينَ صباحًا، فإن تابَ تابَ اللَّهُ عليهِ ، فإن عادَ قالَ : فلا أدري في الثَّالثةِ أو في الرَّابعةِ - فإن عادَ كانَ حقًّا على اللَّهِ أن يُسقيَهُ من رَدغةِ الخبالِ يومَ القيامةِ قالَ وسَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ : إنَّ اللَّهَ عزَّ وجلَّ خلقَ خلقَهُ في ظلمةٍ، ثمَّ ألقَى عليهِم من نورِهِ يومئذٍ، فمَن أصابَهُ من نورِهِ يومئذٍ، اهتَدى، ومَن أخطأَهُ، ضلَّ فلذلِكَ أقولُ : جفَّ القلمُ على علمِ اللَّهِ عزَّ وجلَّ وسَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ : إنَّ سُلَيْمانَ بنَ داودَ عليهِ السَّلامُ سألَ اللَّهَ ثلاثًا، فأعطاهُ اثنتَينِ، ونحنُ نرجو أن تَكونَ لَهُ الثَّالثةُ : فسألَهُ حُكْمًا يصادِفُ حُكْمَهُ، فأعطاهُ اللَّهُ إيَّاهُ، وسألَهُ مُلكًا لا ينبَغي لأحَدٍ من بَعدِهِ، فأعطاهُ إيَّاهُ، وسألَهُ ",["أيُّما رجلٍ خَرجَ من بيتِهِ لا يريدُ إلَّا الصَّلاةَ في هذا المسجدِ ",1],["خرجَ من خَطيئتِهِ مثلَ يومِ ولدتهُ أمُّهُ",2],"، فَنحنُ نرجو أن يَكونَ اللَّهُ عزَّ وجلَّ قد أَعطاهُ إيَّاهُ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (693، 5664) مفرقاً مختصراً باختلاف يسير، وابن ماجه (1408، 3377) مفرقاً مختصراً باختلاف يسير","bab":"توبة › الحض على التوبة","dorar":"ktDNR7No"},{"id":"س-06561","fp":"a2c30efd0c28","stateId":54,"easy":"إذا أحسنت الطهور ثم أتيت الجمعة فلم تلغُ ولم تجهل ← تكون كفارة لما بين الجمعتين","cause":"إذا تَطهَّر الرَّجلُ فأَحسَنَ الطُّهورَ، ثُمَّ أَتى الجُمعةَ، فلم يَلْغُ، ولم يَجهَلْ حتَّى يَنصرِفَ الإمامُ","result":"كانت كَفَّارةً لِما بَينَها وبَينَ الجُمعةِ","explicit":true,"repOf":"س-03427","ref":"صحيح ابن خزيمة 1817","text":["عن نَبيِّ اللهِ صلَّى اللهُ عليهِ وسلَّم، قال: ",["إذا تَطهَّر الرَّجلُ فأَحسَنَ الطُّهورَ، ثُمَّ أَتى الجُمعةَ، فلم يَلْغُ، ولم يَجهَلْ حتَّى يَنصرِفَ الإمامُ",1],"، ",["كانت كَفَّارةً لِما بَينَها وبَينَ الجُمعةِ",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (11347)، وأبو نعيم الأصبهاني في ((مسانيد فراس)) (48) بلفظه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"BiGfXEMV"},{"id":"س-06562","fp":"4d2c0cc124a5","stateId":54,"easy":"إذا أسبغت الوضوء ثم صليت المكتوبة مع الإمام ← يُغفر لك ذنبك","cause":"مَن توضَّأَ فأسبغَ الوضوءَ ، ثمَّ مَشى إلى صلاةٍ مَكْتوبةٍ فصلَّاها معَ الإمامِ","result":"غُفِرَ لَهُ ذنبُهُ","explicit":true,"ref":"الترغيب والترهيب 1/200","srcLabel":"أحمد","text":[["مَن توضَّأَ فأسبغَ الوضوءَ ، ثمَّ مَشى إلى صلاةٍ مَكْتوبةٍ فصلَّاها معَ الإمامِ ، ",1],["غُفِرَ لَهُ ذنبُهُ",2]],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن خزيمة (1489) بلفظه، وأحمد (483)، والبزار (437) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"mKisZrOL"},{"id":"س-06607","fp":"7236c3ffb4cb","stateId":54,"easy":"إذا أحسنت الوضوء ثم خرجت إلى المسجد لا يخرجك إلا الصلاة ← رجلك اليسرى تمحو سيئة واليمنى تكتب حسنة","cause":"إذا تَوضَّأَ أحدُكُم فأحْسَنَ الوضوءَ ، ثمَّ خرجَ إلى المسجدِ لا ينزِعُهُ إلَّا الصَّلاةُ","result":"لَم تزَلْ رِجْلُهُ اليُسرَى تمحو عنهُ سَيئةً ، و تَكْتُبُ لهُ اليُمنَى حسنةً ، حتَّى يدخلَ المسجدَ ، ولَو يعلمُ النَّاسُ ما في العتْمَةِ والصُّبحِ لأتَوْهُما ولَو حَبْوًا","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"otherNeedIds":[40],"ref":"صحيح الجامع 441","srcLabel":"الحاكم","text":[["إذا تَوضَّأَ أحدُكُم فأحْسَنَ الوضوءَ ، ثمَّ خرجَ إلى المسجدِ لا ينزِعُهُ إلَّا الصَّلاةُ ، ",1],["لَم تزَلْ رِجْلُهُ اليُسرَى تمحو عنهُ سَيئةً ، و تَكْتُبُ لهُ اليُمنَى حسنةً ، حتَّى يدخلَ المسجدَ ، ولَو يعلمُ النَّاسُ ما في العتْمَةِ والصُّبحِ لأتَوْهُما ولَو حَبْوًا",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (12/355) (13328)، والحاكم (790)، والبيهقي في ((شعب الإيمان)) (2884) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"3HgftGgC"},{"id":"س-06627","fp":"4e44806f7cb3","stateId":54,"easy":"إذا صليت في المسجد (المساجد الفاضلة) ← يُغفر لك ذنبك","cause":"مَن صلَّى في المَسجِدِ -وقال حُجَينٌ: المساجِدِ الأربَعةِ","result":"غُفِرَ له ذَنْبُه","explicit":true,"apply":{"k":"time","t":"في السجود"},"ref":"تخريج المسند لشعيب 23595","srcLabel":"النسائي","text":["عن عاصِمِ بنِ سُفيانَ الثَّقَفيِّ، أنَّهم غَزَوْا غَزْوةَ السَّلاسِلِ، ففاتَهمُ الغَزْوُ فرابَطوا، ثم رَجَعوا إلى مُعاويةَ وعندَه أبو أيُّوبَ، وعُقْبةُ بنُ عامِرٍ، فقال عاصِمٌ: يا أبا أيُّوبَ، فاتَنا الغَزْوُ العامَ، وقد أُخْبِرْنا أنَّه ",["مَن صلَّى في المَسجِدِ -وقال حُجَينٌ: المساجِدِ الأربَعةِ- ",1],["غُفِرَ له ذَنْبُه",2],"، فقال: ابنَ أخي، أدُلُّك على أيسَرَ من ذلك؟ إنِّي سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: مَن تَوضَّأَ كما أُمِرَ، وصلَّى كما أُمِرَ، غُفِرَ له ما قَدَّمَ من عَمَلٍ، أكَذاكَ يا عُقْبةُ؟ قال: نَعَمْ."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"المرفوع منه صحيح لغيره","takhrij":"أخرجه النسائي (144)، وابن ماجه (1396)، وأحمد (23595) واللفظ له","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"W7Q9b4Py"},{"id":"س-07967","fp":"e1fcee0cb2e1","stateId":54,"easy":"إذا خرجت من بيتك غدوة أو عشية إلى المسجد ← خطوة كفارة وخطوة درجة","cause":"ما من عبدٍ يَخرُجُ من بيتِه إلى غُدوٍّ، أو رَواحٍ إلى المسجِدِ","result":"إلَّا كانتْ خُطاهُ خُطوةٌ كفَّارةٌ، وخُطوةٌ دَرجةٌ","explicit":true,"apply":{"k":"time","t":"عند الخروج من البيت"},"otherNeedIds":[41],"ref":"تخريج المسند لشعيب 17655","srcLabel":"أحمد","text":["رُحْتُ إلى المسجِدِ، فلقِيَني عُتْبةُ بنُ عبدٍ المازِنيُّ، فقال لي: أين تُريدُ؟ فقُلْتُ: إلى المسجِدِ، فقال: أبشِرْ؛ فإنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["ما من عبدٍ يَخرُجُ من بيتِه إلى غُدوٍّ، أو رَواحٍ إلى المسجِدِ،",1]," ",["إلَّا كانتْ خُطاهُ خُطوةٌ كفَّارةٌ، وخُطوةٌ دَرجةٌ",2],"."],"grade":"صحيح","narrator":"عتبة بن عبد السلمي","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (17655) واللفظ له، والطبراني (17/131) (321)","bab":"مساجد ومواضع الصلاة › فضل من غدا إلى المسجد أو راح","dorar":"7a6BP7En"},{"id":"س-01471","fp":"d6b9482dd97b","stateId":54,"easy":"إذا توضأت ثم أدركت الصلاة في جماعة ← يُغفر لك ما تقدّم من ذنبك","cause":"فإنْ أدرَكَ الصَّلاةَ في الجَماعةِ مع القَومِ","result":"غُفِرَ له ما تَقدَّمَ من ذَنْبِه","explicit":true,"ref":"تخريج مشكل الآثار 2322","srcLabel":"أبو داود","text":["عن سعيدِ بنِ المُسيِّبِ، قال: دَخَلْنا على رَجُلٍ من أصحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ منَ الأنصارِ وهو وَجِعٌ، فقال: مَن في البَيتِ؟ فقيلَ: أهلُكَ وولدُكَ وجُلساؤُكَ في المسجِدِ، قال: فأجْلِسوني، قال: فأسنَدَه ابنُه إلى صَدرِه، ثم قال: لأُحَدِّثَنَّكمُ اليومَ حديثًا ما حدَّثتُ به مُنذُ سَمِعتُه من رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ احتسابًا، وما أُحدِّثُكموهُ اليومَ إلَّا احتسابًا، سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: إنَّ العبدَ المُسلِمَ إذا توضَّأَ فأحسَنَ الوُضوءَ، ثم عَمَدَ إلى المسجِدِ؛ لم يَرفَعْ رِجْلَه اليُمنى إلَّا كُتِبَتْ له بها حَسَنةٌ، ولم يَضَعِ اليُسرى إلَّا حُطَّتْ عنه بها خَطيئةٌ، حتى يبلُغَ المسجِدَ، فلْيَتقرَّبْ أو لِيَتباعَدْ، ",["فإنْ أدرَكَ الصَّلاةَ في الجَماعةِ مع القَومِ",1]," ",["غُفِرَ له ما تَقدَّمَ من ذَنْبِه",2],"، وإنْ أدرَكَ منها بعضًا وسُبِقَ ببَعضٍ، فقَضى ما فاتَه، فأحسَنَ رُكوعَه وسُجودَه كان كذلك، وإنْ جاء والقومُ قُعودٌ كان كذلك."],"grade":"حسن","narrator":"رجل من الصحابة من الأنصار","muhaddith":"رجاله ثقات رجال الصحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (2322) بلفظه، وأبو داود (563)، والبيهقي (5075) بنحوه.","bab":"وضوء › فضل الوضوء","dorar":"cr6b1WZq"},{"id":"س-03331","fp":"650e2ca971d6","stateId":54,"easy":"إذا اغتسلت يوم الجمعة ← يسلّ الغسل الخطايا من أصول شعرك","cause":"الغُسلَ يومَ الجمعةِ","result":"ليَسلُّ الخطايا من أصولِ الشَّعرِ استلالًا","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"ref":"الترغيب والترهيب 1/341","srcLabel":"الطبراني","text":["إنَّ ",["الغُسلَ يومَ الجمعةِ",1]," ",["ليَسلُّ الخطايا من أصولِ الشَّعرِ استلالًا",2]],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"رواته ثقات","takhrij":"أخرجه ابن أبي حاتم في ((العلل)) (570)، والطبراني (8/ 256) (7996) واللفظ لهما.","bab":"استغفار › أسباب المغفرة","dorar":"hqanibdS"},{"id":"س-03537","fp":"6d5bb0048647","stateId":54,"easy":"إذا اغتسلت يوم الجمعة واستكت ولبست أحسن ثيابك وتطيبت ← تكون كفارة إلى الجمعة الأخرى","cause":"منِ اغتَسلَ يومَ الجمعةِ واستاكَ ولبسَ أحسنَ ثيابِهِ، وتطيَّبَ بطيبٍ -إِن وجدَهُ- ثُمَّ جاءَ ولَم يتَخطَّ النَّاسَ فَصلَّى ما شاءَ اللَّهُ أن يصلِّيَ، فإذا خرجَ الإمامُ سَكَتَ","result":"فذلِكَ كفَّارةٌ إلى الجُمعةِ الأخرى","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"repOf":"س-03539","ref":"نخب الافكار 2/487","text":[["منِ اغتَسلَ يومَ الجمعةِ واستاكَ ولبسَ أحسنَ ثيابِهِ، وتطيَّبَ بطيبٍ -إِن وجدَهُ- ثُمَّ جاءَ ولَم يتَخطَّ النَّاسَ فَصلَّى ما شاءَ اللَّهُ أن يصلِّيَ، فإذا خرجَ الإمامُ سَكَتَ ",1],["فذلِكَ كفَّارةٌ إلى الجُمعةِ الأخرى",2]],"grade":"حسن","narrator":"أبو هريرة وأبي سعيد","muhaddith":"إسناده صالح","takhrij":"أخرجه أبو داود (343)، وأحمد (11768)، وابن خزيمة (1762) جميعهم باختلاف يسير.","bab":"استغفار › مكفرات الذنوب","dorar":"FgVZGeLN"},{"id":"س-03556","fp":"1acdd08e2f18","stateId":54,"easy":"إذا اغتسلت يوم الجمعة ← تُكفّر ذنوبك وخطاياك، وبكل خطوة إليها أجر","cause":"مَن اغتَسَل يَومَ الجُمُعةِ","result":"كُفِّرت عنه ذُنوبُه وخَطاياه، وإذا أخَذ في المَشيِ إلى الجُمُعةِ كان له بكُلِّ خُطوةٍ عمَلُ عِشرين سنةً، فإذا فَرَغ من الجُمُعةِ أُجيزَ بعَملِ مِئَتي سَنةٍ","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"otherNeedIds":[40],"ref":"تراجم منتخبة من التهذيب 14/77","srcLabel":"أحمد","text":[["مَن اغتَسَل يَومَ الجُمُعةِ ",1],["كُفِّرت عنه ذُنوبُه وخَطاياه، وإذا أخَذ في المَشيِ إلى الجُمُعةِ كان له بكُلِّ خُطوةٍ عمَلُ عِشرين سنةً، فإذا فَرَغ من الجُمُعةِ أُجيزَ بعَملِ مِئَتي سَنةٍ",2],"."],"grade":"حسن","narrator":"عمران بن حصين وأبي بكر الصديق","muhaddith":"العجب من إسحاق من إمامته، كيف يحدث بمثل هذا؟! ثم يوثق الضحاك! فإن كانت العلة فيه من غيره، فكان عليه أن يبين ذلك، وأبو نصيرة الواسطي وثقه أحمد، وقال ابن معين: صالح","bab":"استغفار › مكفرات الذنوب","dorar":"jwor8jgS"},{"id":"س-06661","fp":"a0e8d4b3bee7","stateId":54,"easy":"إذا سددت فرجة في الصف ← يُغفر لك","cause":"من سدَّ فرجةً في الصَّفِّ","result":"غُفِرَ له","explicit":true,"ref":"مجمع الزوائد 2/94","srcLabel":"البزار","text":["أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ ",["من سدَّ فرجةً في الصَّفِّ ",1],["غُفِرَ له",2]],"grade":"حسن","narrator":"وهب بن عبدالله السوائي أبو جحيفة","muhaddith":"إسناده حسن","takhrij":"أخرجه البزار (4232) واللفظ له، وأبو نعيم في ((معرفة الصحابة)) (6719) بنحوه.","bab":"صلاة الجماعة والإمامة › إقامة الصفوف ووصلها وفضائلها","dorar":"pMA4pMf9"},{"id":"س-01386","fp":"4936dd121db6","stateId":54,"easy":"إذا مشيت إلى الجماعات وجلست في المساجد بعد الصلاة وأسبغت الوضوء ← تكفّر خطاياك","cause":"نَقْلُ الأقدامِ إلى الجَماعاتِ، وجُلوسٌ في المساجِدِ بَعدَ الصَّلاةِ، وإسباغُ الوُضوءِ عِندَ الكريهاتِ","result":"وما الكفَّاراتُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"دبر كل صلاة، في السجود"},"ref":"تخريج شرح السنة 4/37","srcLabel":"الترمذي","text":["احْتَبَسَ عَلَيْنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ذاتَ غَداةٍ عَنْ صلاةِ الصُّبحِ حتَّى كِدْنا نَتَراءَى قَرْنَ الشَّمسِ، فخرَجَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ سريعًا، فثوَّبَ بالصَّلاةِ، وصلَّى وتجوَّزَ في صلاتِهِ، فلمَّا سلَّمَ قال: كما أنتُمْ على مَصَافِّكُمْ، ثُمَّ أقبَلَ إلينا فقالَ: إنِّي سأُحدِّثُكُمْ ما حَبَسَني عنكُمُ الغَداةَ، إنِّي قُمتُ مِنَ اللَّيلِ، فصلَّيْتُ ما قُدِّرَ لي، فنعَسْتُ في صلاتي حتَّى اسْتَثْقَلْتُ، (ووَقَعَ في مُسنَدِ أحمدَ استيقَظْتُ وهو تحريفٌ)، فإذا أنا بربِّي عزَّ وجَلَّ في أحسَنِ صورةٍ، قالَ: يا مُحمَّدُ أتَدْري فِيمَ يختصِمُ الملأُ الأعلى؟ قُلتُ: لا أَدْري يا ربِّ، قالَ: يا مُحمَّدُ، فِيمَ يختصِمُ الملأُ الأعلى؟ قُلتُ: لا أَدْري رَبِّ، فرأيتُهُ وَضَعَ كَفَّهُ بَينَ كَتِفَيَّ حتَّى وجدتُ بَرْدَ أنامِلِهِ بَينَ صَدْري، فتجلَّى لي كُلُّ شيءٍ، وعرَفْتُ، فقالَ: يا مُحمَّدُ، فِيمَ يختصِمُ الملأُ الأعلى؟ قُلتُ: في الكفَّاراتِ، قال: ",["وما الكفَّاراتُ",2],"؟ قُلتُ: ",["نَقْلُ الأقدامِ إلى الجَماعاتِ، وجُلوسٌ في المساجِدِ بَعدَ الصَّلاةِ، وإسباغُ الوُضوءِ عِندَ الكريهاتِ",1],"، قالَ: وما الدَّرجاتُ؟ قُلتُ: إطعامُ الطَّعامِ، ولِينُ الكلامِ، والصَّلاةُ والنَّاسُ نِيَامٌ، قالَ: سَلْ، قُلتُ: اللَّهمَّ إنِّي أسألُكَ فِعْلَ الخيراتِ وتَرْكَ المُنكَراتِ، وحُبَّ المساكينِ، وأنْ تغفِرَ لي وترحمَني، وإذا أردتَ فتنةً في قَومٍ، فتوفَّني غَيرَ مفتونٍ، وأسألُكَ حُبَّكَ وحُبَّ مَن يُحِبُّكَ، وحُبَّ عمَلٍ يُقرِّبُني إلى حُبِّكَ، وقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّها حَقٌّ، فادْرُسُوها وتعلَّموها."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (3235)، وأحمد (22109) كلاهما بلفظه، والطبراني (20/ 109)، (216) باختلاف يسير.","bab":"وضوء › إسباغ الوضوء","dorar":"AkMFqQCK","merged":8,"otherRefs":["أحكام القرآن لابن العربي 4/72 (حسن)","السلسلة الصحيحة 3169 (صحيح)","تخريج شرح السنة 925 (صحيح)","أطراف الغرائب 1/163 (صحيح)","بيان تلبيس الجهمية 7/205 (صحيح)","صحيح الترغيب 453 (حسن)","صحيح الترغيب 408 (صحيح)"]},{"id":"س-01510","fp":"0fc8742d75f5","stateId":54,"easy":"إذا أذّنت ← فلك دعوة النبي ﷺ بالمغفرة","cause":"للمؤذِّنينَ","result":"وغفرَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح ابن خزيمة 3/ 59","srcLabel":"أبو داود","text":["المؤذِّنونَ أُمَناءُ، والأئمَّةُ ضُمَناءُ، اللَّهمَّ اغفِر ",["للمؤذِّنينَ",1]," وسدِّدِ الأئمَّةَ ثلاثَ مرَّاتٍ هذا لفظُ حديثِ عليِّ بنِ حُجرٍ، وقالَ الحُسَيْنُ بنُ الحسنِ: أرشدَ اللَّهُ الأئمَّةَ، ",["وغفرَ",2]," للمؤذِّنينَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (517)، وأحمد (7169)، وابن حبان (1672) باختلاف يسير.","bab":"أذان › فضل التأذين","dorar":"C8PWGMWH","merged":4,"otherRefs":["هداية الرواة 1/317 (حسن)","تخريج المسند لشعيب 9428 (صحيح)","صحيح الترغيب 237 (صحيح)"]},{"id":"س-01501","fp":"94bfb7485246","stateId":54,"easy":"إذا أذّنت ← يغفر الله لك مدى صوتك ويستغفر لك كل رطب ويابس","cause":"للمؤذِّنِ","result":"يغفرُ اللهُ للمؤذِّنِ مُنتهى أذانِه ويستغفرُ له كلُّ رطبٍ ويابسٍ سمِع صوتَهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-01508","otherNeedIds":[23],"ref":"تخريج المسند لشاكر 9/72","text":[["يغفرُ اللهُ للمؤذِّنِ مُنتهى أذانِه ويستغفرُ له كلُّ رطبٍ ويابسٍ سمِع صوتَهُ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه البزار كما في ((كشف الأستار)) للهيثمي (355)، والطبراني (12/398) (13469)، والبيهقي (2109)","bab":"أذان › فضل التأذين","dorar":"XEulI7W0","merged":2,"otherRefs":["صحيح الترغيب 233 (صحيح)"]}]}