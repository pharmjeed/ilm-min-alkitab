{"schema":1,"kind":"sunan-chunk","version":"sunan-cb5af5731a1c","needId":27,"stateIds":[276,277,278,279,280,281,282,283,284,285,286,287,288],"items":[{"id":"س-03772","fp":"5b912636891c","stateId":276,"easy":"إذا أشركت أو قتلت أو عققت أو شهدت زوراً ← فهي أكبر الكبائر","cause":"الإشراكُ باللهِ، وقَتلُ النَّفسِ، وعُقوقُ الوالِدَينِ، وقَولُ الزُّورِ، -أو قال: وشَهادةُ الزُّورِ","result":"أكبَرُ الكَبائِرِ","explicit":true,"star":true,"otherNeedIds":[13],"ref":"صحيح البخاري 6871","srcLabel":"مسلم","text":["عَنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم، قال: الكَبائِرُ. ح وحَدَّثَنا عَمرٌو وهو ابنُ مَرزوقٍ، حَدَّثَنا شُعبةُ، عَنِ ابنِ أبي بَكرٍ، عن أنَسِ بنِ مالِكٍ، عَنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم، قال: ",["أكبَرُ الكَبائِرِ",2],[": الإشراكُ باللهِ، وقَتلُ النَّفسِ، وعُقوقُ الوالِدَينِ، وقَولُ الزُّورِ، -أو قال: وشَهادةُ الزُّورِ-",1],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (88) باختلاف يسير","bab":"الكفر والشرك › ذم الشرك وما ورد فيه من العقوبة","dorar":"qzwINpEc","merged":17,"otherRefs":["صحيح الجامع 4601 (صحيح)","صحيح البخاري 6920 (صحيح)","صحيح البخاري 5976 (صحيح)","صحيح البخاري 6870 (صحيح)","سنن الترمذي 2301 (صحيح)","تفسير الطبري 4/1/60 (صحيح)","صحيح الترمذي 1901 (صحيح)","حلية الأولياء 7/238 (صحيح)","صحيح الأدب المفرد 12 (صحيح)","صحيح الجامع 4604 (صحيح)","صحيح الجامع 2628 (صحيح)","صحيح مسلم 87 (صحيح)","صحيح البخاري 5977 (صحيح)","الزواجر عن اقتراف الكبائر 2/193 (حسن)"]},{"id":"س-05269","fp":"c52c30de48ce","stateId":276,"easy":"إذا أشركت أو عققت أو حلفت يميناً غموساً ← فهي من أكبر الكبائر","cause":"الشِّرْكَ باللهِ، وعُقوقَ الوالِدَينِ، واليَمينَ الغَموسَ، وما حَلَفَ حالِفٌ باللهِ يَمينَ صَبْرٍ، فأَدخَلَ فيها مِثلَ جَناحِ بَعوضةٍ، إلَّا جَعَلَه اللهُ نُكْتةً في قَلْبِه إلى يَوْمِ القِيامةِ","result":"إنَّ مِن أكْبَرِ الكَبائِرِ","explicit":true,"star":true,"otherNeedIds":[13],"ref":"الأحاديث المختارة 9 / 15","srcLabel":"متفق عليه","text":["«",["إنَّ مِن أكْبَرِ الكَبائِرِ",2],[": الشِّرْكَ باللهِ، وعُقوقَ الوالِدَينِ، واليَمينَ الغَموسَ، وما حَلَفَ حالِفٌ باللهِ يَمينَ صَبْرٍ، فأَدخَلَ فيها مِثلَ جَناحِ بَعوضةٍ، إلَّا جَعَلَه اللهُ نُكْتةً في قَلْبِه إلى يَوْمِ القِيامةِ»",1],"."],"grade":"صحيح","narrator":"عبدالله بن أنيس الجهني","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"MZ4cTsmJ","merged":2,"otherRefs":["الأحاديث المختارة 9 / 17 (صحيح)"]},{"id":"ق-0114","fp":"c80cb334893a","stateId":276,"easy":"الكفر والإثم ← لا يحبه الله","cause":"الكفر والإثم","result":"لا يحبه الله","explicit":true,"similar":["ق-0965"],"ref":"سورة البقرة: 276","srcLabel":"القرآن الكريم","quran":{"s":2,"from":276,"to":276,"text":"يَمْحَقُ اللَّهُ الرِّبَا وَيُرْبِي الصَّدَقَاتِ وَاللَّهُ لَا يُحِبُّ كُلَّ كَفَّارٍ أَثِيمٍ (276)","hl":[[49,93,1]]}},{"id":"ق-0815","fp":"769fad314ce9","stateId":276,"easy":"الخيانة والكفر ← لا يحبه الله","cause":"الخيانة والكفر","result":"لا يحبه الله","explicit":true,"ref":"سورة الحج: 38","srcLabel":"القرآن الكريم","quran":{"s":22,"from":38,"to":38,"text":"إِنَّ اللَّهَ يُدَافِعُ عَنِ الَّذِينَ آمَنُوا إِنَّ اللَّهَ لَا يُحِبُّ كُلَّ خَوَّانٍ كَفُورٍ (38)","hl":[[47,95,1]]}},{"id":"ق-0965","fp":"c301e4f21a31","stateId":276,"easy":"الكفر ← لا يحبهم الله","cause":"الكفر","result":"لا يحبهم الله","explicit":true,"repOf":"ق-0114","ref":"سورة الروم: 45","quran":{"s":30,"from":45,"to":45,"text":"لِيَجْزِيَ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ مِنْ فَضْلِهِ إِنَّهُ لَا يُحِبُّ الْكَافِرِينَ (45)","hl":[[68,101,1]]}},{"id":"س-05050","fp":"462ca82d419d","stateId":276,"easy":"إذا آمنت ثم كفرت ← تكون من أبغض الخلق إلى الله","cause":"لمن آمنَ ثم كفرَ","result":"إنَّ أبغضَ الخلقِ إلى اللهِ عزَّ وجلَّ","explicit":true,"otherNeedIds":[22],"ref":"مجمع الزوائد 6/263","srcLabel":"الطبراني","text":[["إنَّ أبغضَ الخلقِ إلى اللهِ عزَّ وجلَّ",2]," ",["لمن آمنَ ثم كفرَ",1]],"grade":"حسن","narrator":"معاذ بن جبل","muhaddith":"فيه صدقة بن عبد الله السمين وبقية رجاله ثقات","takhrij":"أخرجه البزار (2656)، والطبراني في ((الشاميين)) (2539)، وتمام في ((فوائده)) (1598) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"5t57B438","merged":2,"otherRefs":["الجامع الصغير 54 (حسن)"]},{"id":"س-02621","fp":"2ccf96fd5656","stateId":276,"easy":"إذا أشركت ثم قطعت الرحم ← فهي أبغض الأعمال إلى الله","cause":"الإشراكُ باللهِ قال : قلتُ : يا رسولَ اللهِ ! ثم مَهْ ؟ قال : ثم قطيعةُ الرَّحِمِ","result":"أيُّ الأعمالِ أبغضُ إلى اللهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح الترغيب 2522","srcLabel":"أبو يعلى","text":["أتيتُ النَّبيَّ وهو في نفرٍ من أصحابِه ، فقلتُ : أنت الذي تزعمُ أنك رسولُ اللهِ ؟ قال : نعم قال : قلتُ : يا رسولَ اللهِ ! أيُّ الأعمالِ أَحَبُّ إلى اللهِ ؟ قال : الإيمانُ بالله قال : قلتُ : يا رسولَ اللهِ ! ثم مَهْ ؟ قال : ثم صِلَةُ الرَّحِمِ قال : قلتُ : يا رسولَ اللهِ ! ثم مَهْ ؟ قال : ثم الأمرُ بالمعروفِ ، والنهيُ عن المنكرِ قال : قلتُ : يا رسولَ اللهِ ! ",["أيُّ الأعمالِ أبغضُ إلى اللهِ",2]," ؟ قال : ",["الإشراكُ باللهِ قال : قلتُ : يا رسولَ اللهِ ! ثم مَهْ ؟ قال : ثم قطيعةُ الرَّحِمِ",1]," قال : قلتُ : يا رسولَ اللهِ ! ثم مَه ؟ قال : ثم الأمرُ بالمنكرِ ، والنهيُ عن المعروفِ"],"grade":"صحيح","narrator":"رجل من خثعم","muhaddith":"صحيح","takhrij":"أخرجه أبو يعلى (6839)","bab":"إيمان › الأمر بالإيمان بالله تعالى ورسوله وشرائع الدين","dorar":"MpspMCwp","merged":2,"otherRefs":["صحيح الجامع 166 (حسن)"]},{"id":"س-06827","fp":"d2bc1f2b97b6","stateId":277,"easy":"إذا عسّرت ← فقد كره الله العسر للأمة","cause":"العُسْرَ","result":"و كرِهَ لهم","explicit":true,"star":true,"ref":"السلسلة الصحيحة 1635","srcLabel":"البخاري","text":["إنَّ اللهَ رضيَ لهذه الأُمَّةِ اليُسْرَ ، ",["و كرِهَ لهم",2]," ",["العُسْرَ",1]," ، قالها ثلاثَ مراتٍ ، و إنَّ هذا أخذ بالعُسْرِ ، و ترك اليُسْرَ"],"grade":"صحيح","narrator":"محجن بن الأدرع","muhaddith":"إسناده صحيح رجاله ثقات","takhrij":"أخرجه الواحدي في ((الوسيط)) (85) واللفظ له وزيادة، وأحمد (18976) والبخاري في ((الأدب المفرد)) (341) بنحوه مطولا","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"u37fsU2W"},{"id":"ق-0130","fp":"3526008aed31","stateId":277,"easy":"التولي عن طاعة الله والرسول ← لا يحبه الله","cause":"التولي عن طاعة الله والرسول","result":"لا يحبه الله","explicit":true,"star":true,"ref":"سورة آل عمران: 32","srcLabel":"القرآن الكريم","quran":{"s":3,"from":32,"to":32,"text":"قُلْ أَطِيعُوا اللَّهَ وَالرَّسُولَ فَإِنْ تَوَلَّوْا فَإِنَّ اللَّهَ لَا يُحِبُّ الْكَافِرِينَ (32)","hl":[[0,95,1]]}},{"id":"ق-0333","fp":"c2233dedb3f4","stateId":277,"easy":"الاعتداء بتحريم ما أحل الله ← لا يحبه الله","cause":"الاعتداء بتحريم ما أحل الله","result":"لا يحبه الله","explicit":true,"ref":"سورة المائدة: 87","srcLabel":"القرآن الكريم","quran":{"s":5,"from":87,"to":87,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تُحَرِّمُوا طَيِّبَاتِ مَا أَحَلَّ اللَّهُ لَكُمْ وَلَا تَعْتَدُوا إِنَّ اللَّهَ لَا يُحِبُّ الْمُعْتَدِينَ (87)","hl":[[85,142,1]]}},{"id":"س-03882","fp":"677f00424d0b","stateId":277,"easy":"إذا ابتدعت عبادة ثم لم ترعها حق رعايتها ← يعيبك الله بتركها","cause":"فلم يرعَوها حقَّ رعايتِها","result":"فعابهم اللهُ بتركِها","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"إتحاف الخيرة المهرة 2/382","srcLabel":"إتحاف الخيرة المهرة","text":["عن أبي أُمامةَ الباهِلِيِّ ، رضي اللهُ عنه ، قال : أحدَثتُم قيامَ رمضانَ ولم يُكتَبْ عليكم ، إنما كُتِب عليكم الصيامُ ، فدوموا على القيامِ إذ فعَلتُموه ، فإنَّ ناسًا مِن بني إسرائيلَ ابتَدَعوا بدعةً ولم يكتُبْها اللهُ عليهِم ابتَغَوا بها رِضوانَ اللهِ ",["فلم يرعَوها حقَّ رعايتِها",1]," ",["فعابهم اللهُ بتركِها",2]," ، قال : ورهبانيةً ابتَدَعُوهَا ... إلى آخرِ الآيةِ"],"grade":"حسن","muhaddith":"رجاله ثقات","bab":"تراويح وتهجد وقيام ليل › فضل قيام الليل","dorar":"cinx3Da5"},{"id":"س-07213","fp":"ab7865814e10","stateId":278,"easy":"إذا تركك الناس اتقاء شرك ← تكون شر الناس منزلة عند الله","cause":"مَن تَرَكَه النَّاسُ اتِّقاءَ شَرِّه","result":"إنَّ شَرَّ النَّاسِ عِندَ اللهِ مَنزِلةً يَومَ القيامةِ","explicit":true,"star":true,"otherNeedIds":[44,13],"ref":"صحيح البخاري 6032","srcLabel":"مسلم","text":["أنَّ رَجُلًا استَأذَنَ على النَّبيِّ صلَّى اللهُ عليه وسلَّم، فلَمَّا رَآهُ قال: بئسَ أخو العَشيرةِ، وبِئسَ ابنُ العَشيرةِ! فلَمَّا جَلَسَ تَطَلَّقَ النَّبيُّ صلَّى اللهُ عليه وسلَّم في وجهِه وانبَسَطَ إليه، فلَمَّا انطَلَقَ الرَّجُلُ قالت له عائِشةُ: يا رَسولَ اللهِ، حينَ رَأيتَ الرَّجُلَ قُلتَ له كَذا وكَذا، ثُمَّ تَطَلَّقتَ في وجهِه وانبَسَطتَ إليه! فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: يا عائِشةُ، مَتى عَهِدتِني فحَّاشًا؟ ",["إنَّ شَرَّ النَّاسِ عِندَ اللهِ مَنزِلةً يَومَ القيامةِ",2]," ",["مَن تَرَكَه النَّاسُ اتِّقاءَ شَرِّه",1],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2591) باختلاف يسير","bab":"علم › حسن السؤال ونصح العالم","dorar":"zBi7RY9l","merged":9,"otherRefs":["حلية الأولياء 6/366 (صحيح)","تخريج المسند لشعيب 25254 (صحيح)","تخريج صحيح ابن حبان 4538 (صحيح)","تخريج المسند لشعيب 10427 (صحيح)","صحيح مسلم 2591 (صحيح)","الاستذكار 7/280 (صحيح)","صحيح الترمذي 1996 (صحيح)","صحيح الجامع 2916 (صحيح)"]},{"id":"ق-0068","fp":"2f8bbc9f2f23","stateId":278,"easy":"الاعتداء ← لا يحبه الله","cause":"الاعتداء","result":"لا يحبه الله","explicit":true,"star":true,"ref":"سورة البقرة: 190","srcLabel":"القرآن الكريم","quran":{"s":2,"from":190,"to":190,"text":"وَقَاتِلُوا فِي سَبِيلِ اللَّهِ الَّذِينَ يُقَاتِلُونَكُمْ وَلَا تَعْتَدُوا إِنَّ اللَّهَ لَا يُحِبُّ الْمُعْتَدِينَ (190)","hl":[[59,116,1]]}},{"id":"ق-0077","fp":"fb9fd5aad4f5","stateId":278,"easy":"الإفساد في الأرض ← لا يحبه الله","cause":"الإفساد في الأرض","result":"لا يحبه الله","explicit":true,"similar":["ق-0926"],"ref":"سورة البقرة: 205","srcLabel":"القرآن الكريم","quran":{"s":2,"from":205,"to":205,"text":"وَإِذَا تَوَلَّى سَعَى فِي الْأَرْضِ لِيُفْسِدَ فِيهَا وَيُهْلِكَ الْحَرْثَ وَالنَّسْلَ وَاللَّهُ لَا يُحِبُّ الْفَسَادَ (205)","hl":[[88,120,1]]}},{"id":"ق-0135","fp":"89ba01c19be9","stateId":278,"easy":"الظلم ← لا يحبه الله","cause":"الظلم","result":"لا يحبه الله","explicit":true,"similar":["ق-1160"],"ref":"سورة آل عمران: 57","srcLabel":"القرآن الكريم","quran":{"s":3,"from":57,"to":57,"text":"وَأَمَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَيُوَفِّيهِمْ أُجُورَهُمْ وَاللَّهُ لَا يُحِبُّ الظَّالِمِينَ (57)","hl":[[79,114,1]]}},{"id":"ق-0926","fp":"fecd5f2cdcc5","stateId":278,"easy":"الإفساد في الأرض ← لا يحبه الله","cause":"الإفساد في الأرض","result":"لا يحبه الله","explicit":true,"repOf":"ق-0077","ref":"سورة القصص: 77","quran":{"s":28,"from":77,"to":77,"text":"وَابْتَغِ فِيمَا آتَاكَ اللَّهُ الدَّارَ الْآخِرَةَ وَلَا تَنْسَ نَصِيبَكَ مِنَ الدُّنْيَا وَأَحْسِنْ كَمَا أَحْسَنَ اللَّهُ إِلَيْكَ وَلَا تَبْغِ الْفَسَادَ فِي الْأَرْضِ إِنَّ اللَّهَ لَا يُحِبُّ الْمُفْسِدِينَ (77)","hl":[[134,212,1]]}},{"id":"ق-1160","fp":"00007f37b61b","stateId":278,"easy":"الظلم ← لا يحبه الله","cause":"الظلم","result":"لا يحبه الله","explicit":true,"repOf":"ق-0135","ref":"سورة الشورى: 40","quran":{"s":42,"from":40,"to":40,"text":"وَجَزَاءُ سَيِّئَةٍ سَيِّئَةٌ مِثْلُهَا فَمَنْ عَفَا وَأَصْلَحَ فَأَجْرُهُ عَلَى اللَّهِ إِنَّهُ لَا يُحِبُّ الظَّالِمِينَ (40)","hl":[[89,122,1]]}},{"id":"س-01860","fp":"7b9c59477b8e","stateId":278,"easy":"إذا كنت لا يُرجى خيرك ولا يُؤمن شرك ← فأنت من شر الناس","cause":"وشرُّكم من لا يُرجَى خيرُهُ ولا يُؤمَنُ شرُّهُ","result":"ألا أخبرُكُم بخيرِكُم من شرِّكم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[13],"ref":"صحيح الترمذي 2263","srcLabel":"الترمذي","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وقفَ على أُناسٍ جُلوسٍ، فقالَ: ",["ألا أخبرُكُم بخيرِكُم من شرِّكم",2]," ؟ قالَ: فسَكَتوا، فقالَ ذلِكَ ثلاثَ مرَّاتٍ، فقالَ رجلٌ: بلَى يا رسولَ اللَّهِ، أخبِرنا بخيرِنا من شرِّنا، قالَ: خيرُكُم مَن يُرجَى خيرُهُ ويُؤمَنُ شرُّهُ، ",["وشرُّكم من لا يُرجَى خيرُهُ ولا يُؤمَنُ شرُّهُ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2263) واللفظ له، وأحمد (8812) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"M2qxrNNK"},{"id":"ق-0243","fp":"7635ca7b621c","stateId":278,"easy":"الخيانة والإثم ← لا يحبه الله","cause":"الخيانة والإثم","result":"لا يحبه الله","explicit":true,"star":true,"similar":["ق-0473"],"ref":"سورة النساء: 107","srcLabel":"القرآن الكريم","quran":{"s":4,"from":107,"to":107,"text":"وَلَا تُجَادِلْ عَنِ الَّذِينَ يَخْتَانُونَ أَنْفُسَهُمْ إِنَّ اللَّهَ لَا يُحِبُّ مَنْ كَانَ خَوَّانًا أَثِيمًا (107)","hl":[[57,112,1]]}},{"id":"ق-0473","fp":"9dac0c36006f","stateId":278,"easy":"الخيانة ← لا يحبه الله","cause":"الخيانة","result":"لا يحبه الله","explicit":true,"repOf":"ق-0243","ref":"سورة الأنفال: 58","quran":{"s":8,"from":58,"to":58,"text":"وَإِمَّا تَخَافَنَّ مِنْ قَوْمٍ خِيَانَةً فَانْبِذْ إِلَيْهِمْ عَلَى سَوَاءٍ إِنَّ اللَّهَ لَا يُحِبُّ الْخَائِنِينَ (58)","hl":[[77,116,1]]}},{"id":"س-01900","fp":"2cd3d15ebf1c","stateId":279,"easy":"إذا سُئلت بالله فلم تعطِ ← فأنت من شر الناس","cause":"الّذي يُسأَلُ باللهِ ثُم لا يُعطِي","result":"شرُّ الناسِ","explicit":true,"star":true,"similar":["س-04496"],"otherNeedIds":[13],"ref":"صحيح الجامع 3708","srcLabel":"البخاري","text":[["شرُّ الناسِ",2],[" الّذي يُسأَلُ باللهِ ثُم لا يُعطِي",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((التاريخ الكبير)) (1/363) باختلاف يسير، والبزار (5288) مطولاً","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"nqkEN8Cv"},{"id":"س-04496","fp":"71b31e9e30a9","stateId":279,"easy":"إذا سُئلت بالله فلم تعطِ ← فأنت من شر الناس","cause":"الذي يُسأَلُ باللهِ، ولا يُعطي به","result":"ألا أُخبِرُكُم بشَرِّ النَّاسِ","explicit":true,"repOf":"س-01900","otherNeedIds":[13],"ref":"تخريج المسند لشعيب 2928","text":["عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم: خَرَجَ عليهم وهُم جُلوسٌ، فقال: ألا أُحَدِّثُكُم بخَيرِ النَّاسِ مَنزِلةً، فذَكَرَه [يَعني حَديثَ: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم جاءَ -أو خَرَجَ عليهم- وهُم جُلوسٌ، فقال: ألا أُحَدِّثُكُم بخَيرِ النَّاسِ مَنزِلًا؟ قال: قُلنا: بَلى يا رَسولَ اللهِ. قال: رَجُلٌ مُمسِكٌ برَأسِ فرَسٍ في سَبيلِ اللهِ حَتَّى يَموتَ أو يُقتَلَ، ثُمَّ قال: ألا أُخبِرُكُم بالذي يَليه؟ قُلنا: بَلى يا رَسولَ اللهِ. قال: امرُؤٌ مُعتَزِلٌ في شِعبٍ يُقيمُ الصَّلاةَ، ويُؤتي الزَّكاةَ، ويَعتَزِلُ شُرورَ النَّاسِ، ثُمَّ قال: ",["ألا أُخبِرُكُم بشَرِّ النَّاسِ",2]," مَنزِلًا؟ قال: قُلنا: بَلى يا رَسولَ اللهِ. قال: ",["الذي يُسأَلُ باللهِ، ولا يُعطي به",1],"]."],"grade":"صحيح","narrator":"ابن عباس","muhaddith":"إسناده صحيح","bab":"جهاد › فضل الجهاد","dorar":"FW652v5E","merged":5,"otherRefs":["تخريج صحيح ابن حبان 605 (صحيح)","صحيح الترغيب 854 (صحيح)","السلسلة الصحيحة 255 (صحيح)","تخريج المسند لشعيب 9142 (صحيح)"]},{"id":"س-05429","fp":"303aed7c1ae6","stateId":279,"easy":"إذا ألححت في سؤال الناس ← يبغضك الله","cause":"السائلَ الملْحِفَ","result":"ويُبغِضُ","explicit":true,"ref":"صحيح الجامع 1711","srcLabel":"أحمد","text":["إنَّ اللهَ تعالى إذا أنعَم على عبدٍ نعمةً ، يحبُّ أن يرى أثرَ النِّعمةِ عليه ، ويكره البُؤسَ والتَّباؤسَ ، ",["ويُبغِضُ",2]," ",["السائلَ الملْحِفَ",1]," ، ويحبُّ الحييَّ العفيفَ المتعفِّفَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الإسماعيلي في ((معجم شيوخه)) (224) واللفظ له، وأحمد (8107)، والبيهقي في ((شعب الإيمان)) (6202) باختلاف يسير","bab":"رقائق وزهد › الحياء","dorar":"eZAqAcuc","merged":2,"otherRefs":["صحيح الجامع 1876 (صحيح)"]},{"id":"س-00238","fp":"37ab8f9990d8","stateId":280,"easy":"إذا ظللت تكذب وتتحرى الكذب ← تُكتب عند الله كذاباً","cause":"وما يَزالُ الرَّجُلُ يَكذِبُ ويَتَحَرَّى الكَذِبَ","result":"حتَّى يُكتَبَ عِندَ اللهِ كَذَّابًا","explicit":true,"star":true,"otherNeedIds":[13],"ref":"صحيح مسلم 2607","srcLabel":"متفق عليه","text":["علَيكُم بالصِّدقِ؛ فإنَّ الصِّدقَ يَهدي إلى البِرِّ، وإنَّ البِرَّ يَهدي إلى الجَنَّةِ، وما يَزالُ الرَّجُلُ يَصدُقُ ويَتَحَرَّى الصِّدقَ حتَّى يُكتَبَ عِندَ اللهِ صِدِّيقًا، وإيَّاكُم والكَذِبَ؛ فإنَّ الكَذِبَ يَهدي إلى الفُجورِ، وإنَّ الفُجورَ يَهدي إلى النَّارِ، ",["وما يَزالُ الرَّجُلُ يَكذِبُ ويَتَحَرَّى الكَذِبَ",1]," ",["حتَّى يُكتَبَ عِندَ اللهِ كَذَّابًا",2],". بهذا الإسنادِ، لَم يَذكُرْ في حَديثِ عيسى: ويَتَحَرَّى الصِّدقَ، ويَتَحَرَّى الكَذِبَ. وفي حَديثِ ابنِ مُسهرٍ: حتَّى يَكتُبَه اللهُ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6094)، ومسلم (2607).","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"tEl1hnq3","merged":2,"otherRefs":["تخريج المسند لشاكر 5/343 (صحيح)"]},{"id":"س-03678","fp":"2f87fd0f16a0","stateId":280,"easy":"إذا تعودت الكذب ← تُكتب عند الله كذاباً","cause":"وإنه ليكذب","result":"حتى يكتب عند الله كذابًا","explicit":true,"star":true,"similar":["س-00200"],"otherNeedIds":[13],"ref":"شفاء العليل 1/105","srcLabel":"مسلم","text":["[ عن عبد الله بن مسعود ] أنه كان يجيء كل يوم خميس يقوم قائما لا يجلس فيقول إنما هما اثنتان فأحسن الهدي هدي محمد وأصدق الحديث كتاب الله وشر الأمور محدثاتها وكل محدث ضلالة إن الشقي من شقي في بطن أمه وإن السعيد من وعظ بغيره ألا فلا يطولن عليكم الأمد ولا يلهينكم الأمل فإن كل ما هو آت قريب وإنما البعيد ما ليس آتيا وإن من شرار الناس بطال النهار جيفة الليل وإن قتل المؤمن كفر وإن سبًابه فسوق ولا يحل لمسلم أن يهجر أخاه فوق ثلاث ألا إن شر الروايا روايا الكذب وإنه لا يصلح من الكذب جد ولا هزل ولا أن يعد الرجل صبيه ثم لا ينجزه ألا وإن الكذب يهدي إلى الفجور وإن الفجور يهدي إلى النار وإن الصدق يهدي إلى البر وإن البر يهدي إلى الجنة وإن الصادق يقال له صدق وبر وإن الكاذب يقال له كذب وفجر وإني سمعت رسول اللهِ صلى الله عليه وسلم يقول إن العبد ليصدق فيكتب عند الله صديقا ",["وإنه ليكذب",1]," ",["حتى يكتب عند الله كذابًا",2]," ألا هل تدرون ما العضة هي النميمة التي تفسد بين الناس"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"متواتر","takhrij":"أخرجه ابن ماجه (46)، وعبدالرزاق (20076)، والطبراني (9/100) (8522) باختلاف يسير. وقوله: \"الشقي من شقي في بطن أمه وإن السعيد من وعظ بغيره\" أخرجه مسلم (2645)","bab":"اعتصام بالسنة › الأمر بالتمسك بها","dorar":"EmP7nGwk","merged":2,"otherRefs":["صحيح الأدب المفرد 298 (صحيح)"]},{"id":"س-06858","fp":"a8e65c5ae683","stateId":280,"easy":"إذا كنت بيّاعاً حلّافاً أو فقيراً مختالاً أو شيخاً زانياً أو إماماً جائراً ← يبغضك الله","cause":"البيَّاعُ الحلَّافُ ، والفقيرُ المُختالُ ، والشَّيخُ الزَّاني ، والإمامُ الجائرُ","result":"أربعةٌ يُبغِضُهم اللهُ عزَّ وجلَّ","explicit":true,"ref":"السلسلة الصحيحة 363","srcLabel":"مسلم","text":[["أربعةٌ يُبغِضُهم اللهُ عزَّ وجلَّ ",2],":",[" البيَّاعُ الحلَّافُ ، والفقيرُ المُختالُ ، والشَّيخُ الزَّاني ، والإمامُ الجائرُ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه النسائي (2576)، والبزار (8453)، وابن حبان (5558)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"eaLENdFG","merged":2,"otherRefs":["صحيح الجامع 880 (صحيح)"]},{"id":"س-07751","fp":"12636f8d876b","stateId":280,"easy":"إذا كذبت لترضي الناس ← يوشك الله أن يسخطهم عليك","cause":"لَئِن حَدَّثتُكَ اليومَ حَديثَ كَذِبٍ تَرضى به عَنِّي","result":"لَيوشِكَنَّ اللهُ أن يُسخِطَكَ عليَّ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح مسلم 2769","srcLabel":"البخاري","text":["ثُمَّ غَزا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم غَزوةَ تَبوكَ، وهو يُريدُ الرُّومَ ونَصارى العَرَبِ بالشَّامِ، قال ابنُ شِهابٍ: فأخبَرَني عبدُ الرَّحمَنِ بنُ عبدِ اللهِ بنِ كَعبِ بنِ مالِكٍ، أنَّ عَبدَ اللهِ بنَ كَعبٍ كان قائِدَ كَعبٍ، مِن بَنيه، حينَ عَميَ، قال: سَمِعتُ كَعبَ بنَ مالِكٍ يُحَدِّثُ حَديثَه حينَ تَخَلَّفَ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةِ تَبوكَ، قال كَعبُ بنُ مالِكٍ: لم أتَخَلَّفْ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةٍ غَزاها قَطُّ إلَّا في غَزوةِ تَبوكَ، غيرَ أنِّي قد تَخَلَّفتُ في غَزوةِ بَدرٍ ولم يُعاتِبْ أحَدًا تَخَلَّفَ عنه، إنَّما خَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم والمُسلِمونَ يُريدونَ عيرَ قُرَيشٍ، حتَّى جَمع اللهُ بينَهم وبينَ عَدوِّهِم على غيرِ ميعادٍ، ولقد شَهِدتُ مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم لَيلةَ العَقَبةِ، حينَ تَواثَقنا على الإسلامِ، وما أُحِبُّ أنَّ لي بها مَشهَدَ بَدرٍ، وإن كانَت بَدرٌ أذكَرَ في النَّاسِ منها، وكانَ مِن خَبَري حينَ تَخَلَّفتُ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةِ تَبوكَ أنِّي لم أكُنْ قَطُّ أقوى ولا أيسَرَ مِنِّي حينَ تَخَلَّفتُ عنه في تلك الغَزوةِ، واللهِ ما جَمَعتُ قَبلَها راحِلَتَينِ قَطُّ، حتَّى جَمَعتُهما في تلك الغَزوةِ، فغَزاها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم في حَرٍّ شَديدٍ واستَقبَلَ سَفَرًا بَعيدًا ومَفازًا، واستَقبَلَ عَدوًّا كَثيرًا، فجَلا للمُسلِمينَ أمرَهم ليَتَأهَّبوا أُهبةَ غَزوِهم، فأخبَرَهم بوجهِهمِ الذي يُريدُ، والمُسلِمونَ مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم كَثيرٌ، ولا يَجمَعُهم كِتابُ حافِظٍ، يُريدُ بذلك الدِّيوانَ، قال كَعبٌ: فقَلَّ رَجُلٌ يُريدُ أن يَتَغَيَّبَ، يَظُنُّ أنَّ ذلك سَيَخفى له، ما لم يَنزِلْ فيه وحيٌ مِنَ اللهِ عَزَّ وجَلَّ، وغَزا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم تلك الغَزوةَ حينَ طابَتِ الثِّمارُ والظِّلالُ، فأنا إليها أصعَرُ، فتَجَهَّزَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم والمُسلِمونَ معهُ، وطَفِقتُ أغدو لكَي أتَجَهَّزَ معهُم، فأرجِعُ ولم أقضِ شيئًا، وأقولُ في نَفسي: أنا قادِرٌ على ذلك إذا أرَدتُ، فلم يَزَلْ ذلك يَتَمادى بي حتَّى استَمَرَّ بالنَّاسِ الجِدُّ، فأصبَحَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم غاديًا والمُسلِمونَ معهُ، ولم أقضِ مِن جَهازي شيئًا، ثُمَّ غَدَوتُ فرَجَعتُ ولم أقضِ شيئًا، فلم يَزَلْ ذلك يَتَمادى بي حتَّى أسرَعوا وتَفارَطَ الغَزوُ، فهَمَمتُ أن أرتَحِلَ فأُدرِكَهم، فيا لَيتَني فعَلتُ، ثُمَّ لم يُقدَّرْ ذلك لي، فطَفِقتُ إذا خَرَجتُ في النَّاسِ بَعدَ خُروجِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم يَحزُنُني أنِّي لا أرى لي أُسوةً إلَّا رَجُلًا مَغموصًا عليه في النِّفاقِ، أو رَجُلًا مِمَّن عَذَرَ اللهُ مِنَ الضُّعَفاءِ، ولم يَذكُرْني رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم حتَّى بَلَغَ تَبوكَ، فقال وهو جالِسٌ في القَومِ بتَبوكَ: ما فعَلَ كَعبُ بنُ مالِكٍ؟ قال رَجُلٌ مِن بَني سَلِمةَ: يا رَسولَ اللهِ، حَبَسَه بُرداه والنَّظَرُ في عِطفَيه، فقال له مُعاذُ بنُ جَبَلٍ: بئسَ ما قُلتَ! واللهِ يا رَسولَ اللهِ، ما عَلِمنا عليه إلَّا خَيرًا، فسَكَتَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فبينَما هو على ذلك رَأى رَجُلًا مُبَيِّضًا يَزولُ به السَّرابُ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: كُنْ أبا خَيثَمةَ، فإذا هو أبو خَيثَمةَ الأنصاريُّ، وهو الذي تَصَدَّقَ بصاعِ التَّمرِ حينَ لَمَزَه المُنافِقونَ. فقال كَعبُ بنُ مالِكٍ: فلَمَّا بَلَغَني أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قد تَوجَّهَ قافِلًا مِن تَبوكَ حَضَرَني بَثِّي، فطَفِقتُ أتَذَكَّرُ الكَذِبَ وأقولُ: بمَ أخرُجُ مِن سَخَطِه غَدًا؟ وأستَعينُ على ذلك كُلَّ ذي رَأيٍ مِن أهلي، فلَمَّا قيلَ لي: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قد أظَلَّ قادِمًا زاحَ عَنِّي الباطِلُ، حتَّى عَرَفتُ أنِّي لَن أنجوَ منه بشيءٍ أبَدًا، فأجمَعتُ صِدقَه، وصَبَّحَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم قادِمًا، وكانَ إذا قدِمَ مِن سَفَرٍ بَدَأ بالمَسجِدِ فرَكَعَ فيه رَكعَتَينِ، ثُمَّ جَلَسَ للنَّاسِ، فلَمَّا فعَلَ ذلك جاءَه المُخَلَّفونَ، فطَفِقوا يَعتَذِرونَ إليه، ويَحلِفونَ له، وكانوا بضعةً وثَمانينَ رَجُلًا، فقَبِلَ منهم رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم عَلانيَتَهم، وبايَعَهم واستَغفَرَ لهم، ووكَلَ سَرائِرَهم إلى اللهِ، حتَّى جِئتُ، فلَمَّا سَلَّمتُ تَبَسَّمَ تَبَسُّمَ المُغضَبِ، ثُمَّ قال: تَعالَ، فجِئتُ أمشي حتَّى جَلَستُ بينَ يَدَيه، فقال لي: ما خَلَّفَكَ؟ ألَم تَكُنْ قدِ ابتَعتَ ظَهرَكَ؟ قال: قُلتُ: يا رَسولَ اللهِ، إنِّي، واللهِ لو جَلَستُ عِندَ غيرِكَ مِن أهلِ الدُّنيا لَرَأيتُ أنِّي سَأخرُجُ مِن سَخَطِه بعُذرٍ، ولقد أُعطيتُ جَدَلًا، ولَكِنِّي واللهِ لقد عَلِمتُ ",["لَئِن حَدَّثتُكَ اليومَ حَديثَ كَذِبٍ تَرضى به عَنِّي",1]," ",["لَيوشِكَنَّ اللهُ أن يُسخِطَكَ عليَّ",2],"، ولَئِن حَدَّثتُكَ حَديثَ صِدقٍ تَجِدُ عليَّ فيه، إنِّي لأرجو فيه عُقبى اللهِ، واللهِ ما كان لي عُذرٌ، واللهِ ما كُنتُ قَطُّ أقوى ولا أيسَرَ مِنِّي حينَ تَخَلَّفتُ عَنكَ، قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أمَّا هذا فقد صَدَقَ، فقُمْ حتَّى يَقضيَ اللهُ فيكَ، فقُمتُ، وثارَ رِجالٌ مِن بَني سَلِمةَ فاتَّبَعوني، فقالوا لي: واللهِ ما عَلِمناكَ أذنَبتَ ذَنبًا قَبلَ هذا، لقد عَجَزتَ في أن لا تَكونَ اعتَذَرتَ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم بما اعتَذَرَ به إليه المُخَلَّفونَ؛ فقد كان كافيَكَ ذَنبَكَ استِغفارُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم لَكَ. قال: فواللهِ ما زالوا يُؤَنِّبوني حتَّى أرَدتُ أن أرجِعَ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فأُكَذِّبَ نَفسي، قال ثُمَّ قُلتُ لهم: هل لَقيَ هذا مَعي مِن أحَدٍ؟ قالوا: نَعَم، لَقيَه معكَ رَجُلانِ، قالا مِثلَ ما قُلتَ، فقيلَ لهما مِثلَ ما قيلَ لَكَ، قال: قُلتُ: مَن هُما؟ قالوا: مُرارةُ بنُ الرَّبيعةِ العامِريُّ، وهِلالُ بنُ أُمَيَّةَ الواقِفيُّ، قال: فذَكَروا لي رَجُلَينِ صالِحَينِ قد شَهِدا بَدرًا، فيهما أُسوةٌ، قال: فمَضَيتُ حينَ ذَكَروهما لي. قال: ونَهى رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم المُسلِمينَ عن كَلامِنا -أيُّها الثَّلاثةُ- مِن بَينِ مَن تَخَلَّفَ عنه. قال: فاجتَنَبَنا النَّاسُ، وقال: تَغَيَّروا لَنا حتَّى تَنَكَّرَت لي في نَفسيَ الأرضُ، فما هي بالأرضِ التي أعرِفُ، فلَبِثنا على ذلك خَمسينَ لَيلةً، فأمَّا صاحِبايَ فاستَكانا وقَعَدا في بُيوتِهما يَبكيانِ، وأمَّا أنا فكُنتُ أشَبَّ القَومِ وأجلَدَهم، فكُنتُ أخرُجُ فأشهَدُ الصَّلاةَ وأطوفُ في الأسواقِ ولا يُكَلِّمُني أحَدٌ، وآتي رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم فأُسَلِّمُ عليه وهو في مَجلِسِه بَعدَ الصَّلاةِ، فأقولُ في نَفسي: هل حَرَّكَ شَفَتَيه برَدِّ السَّلامِ، أم لا؟ ثُمَّ أُصَلِّي قَريبًا منه وأُسارِقُه النَّظَرَ، فإذا أقبَلتُ على صَلاتي نَظَرَ إليَّ، وإذا التَفَتُّ نَحوه أعرَضَ عَنِّي، حتَّى إذا طالَ ذلك عليَّ مِن جَفوةِ المُسلِمينَ مَشيتُ حتَّى تَسَوَّرتُ جِدارَ حائِطِ أبي قَتادةَ، وهو ابنُ عَمِّي، وأحَبُّ النَّاسِ إليَّ، فسَلَّمتُ عليه، فواللهِ ما رَدَّ عليَّ السَّلامَ. فقُلتُ له: يا أبا قَتادةَ، أنشُدُكَ باللهِ هل تَعلَمَنَّ أنِّي أُحِبُّ اللهَ ورَسولَه؟ قال: فسَكَتَ، فعُدتُ فناشَدتُه، فسَكَتَ، فعُدتُ فناشَدتُه، فقال: اللهُ ورَسولُه أعلَمُ، ففاضَت عَينايَ وتَولَّيتُ حتَّى تَسَوَّرتُ الجِدارَ. فبينا أنا أمشي في سوقِ المَدينةِ إذا نَبَطيٌّ مِن نَبَطِ أهلِ الشَّامِ، مِمَّن قدِمَ بالطَّعامِ يَبيعُه بالمَدينةِ، يقولُ: مَن يَدُلُّ على كَعبِ بنِ مالِكٍ؟ قال: فطَفِقَ النَّاسُ يُشيرونَ له إليَّ، حتَّى جاءَني فدَفَعَ إليَّ كِتابًا مِن مَلِكِ غَسَّانَ، وكُنتُ كاتِبًا، فقَرَأتُه فإذا فيه: أمَّا بَعدُ؛ فإنَّه قد بَلَغَنا أنَّ صاحِبَكَ قد جَفاكَ، ولم يَجعَلْكَ اللهُ بدارِ هَوانٍ ولا مَضيَعةٍ، فالحَقْ بنا نُواسِكَ، قال: فقُلتُ حينَ قَرَأتُها: وهذه أيضًا مِنَ البَلاءِ، فتَيامَمتُ بها التَّنُّورَ فسَجَرتُها بها، حتَّى إذا مَضَت أربَعونَ مِنَ الخَمسينَ، واستَلبَثَ الوحيُ، إذا رَسولُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم يَأتيني، فقال: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَأمُرُكَ أن تَعتَزِلَ امرَأتَكَ، قال: فقُلتُ: أُطَلِّقُها أم ماذا أفعَلُ؟ قال: لا، بَلِ اعتَزِلها، فلا تَقرَبَنَّها، قال: فأرسَلَ إلى صاحِبَيَّ بمِثلِ ذلك، قال: فقُلتُ لامرَأتي: الحَقي بأهلِكِ فكوني عِندَهم حتَّى يَقضيَ اللهُ في هذا الأمرِ، قال: فجاءَتِ امرَأةُ هِلالِ بنِ أُمَيَّةَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فقالت له: يا رَسولَ اللهِ، إنَّ هِلالَ بنَ أُمَيَّةَ شيخٌ ضائِعٌ ليس له خادِمٌ، فهل تَكرَهُ أن أخدُمَه؟ قال: لا، ولَكِن لا يَقرَبَنَّكِ، فقالت: إنَّه واللهِ ما به حَرَكةٌ إلى شيءٍ، وواللهِ ما زالَ يَبكي مُنذُ كان مِن أمرِه ما كانَ إلى يَومِه هذا، قال: فقال لي بَعضُ أهلي: لَوِ استَأذَنتَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم في امرَأتِكَ؟ فقد أذِنَ لامرَأةِ هِلالِ بنِ أُمَيَّةَ أن تَخدُمَه، قال: فقُلتُ: لا أستَأذِنُ فيها رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، وما يُدريني ماذا يقولُ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم إذا استَأذَنتُه فيها، وأنا رَجُلٌ شابٌّ، قال: فلَبِثتُ بذلك عَشرَ لَيالٍ، فكَمُلَ لَنا خَمسونَ لَيلةً مِن حينَ نُهي عن كَلامِنا، قال: ثُمَّ صَلَّيتُ صَلاةَ الفَجرِ صَباحَ خَمسينَ لَيلةً على ظَهرِ بَيتٍ مِن بُيوتِنا، فبينا أنا جالِسٌ على الحالِ التي ذَكَرَ اللهُ عَزَّ وجَلَّ مِنَّا قد ضاقَت عليَّ نَفسي وضاقَت عليَّ الأرضُ بما رَحُبَت، سَمِعتُ صَوتَ صارِخٍ أوفى على سَلعٍ يقولُ بأعلى صَوتِه: يا كَعبَ بنَ مالِكٍ أبشِرْ، قال: فخَرَرتُ ساجِدًا وعَرَفتُ أنْ قد جاءَ فرَجٌ. قال: فآذَنَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم النَّاسَ بتَوبةِ اللهِ علينا، حينَ صَلَّى صَلاةَ الفَجرِ، فذَهَبَ النَّاسُ يُبَشِّرونَنا، فذَهَبَ قِبَلَ صاحِبَيَّ مُبَشِّرونَ، ورَكَضَ رَجُلٌ إليَّ فرَسًا، وسَعى ساعٍ مِن أسلَمَ قِبَلي، وأوفى الجَبَلَ، فكانَ الصَّوتُ أسرَعَ مِنَ الفَرَسِ، فلَمَّا جاءَني الذي سَمِعتُ صَوتَه يُبَشِّرُني فنَزَعتُ له ثَوبَيَّ فكَسَوتُهما إيَّاه ببِشارَتِه، واللهِ ما أملِكُ غَيرَهما يَومَئذٍ، واستَعَرتُ ثَوبَينِ فلَبِستُهما، فانطَلَقتُ أتَأمَّمُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَتَلَقَّاني النَّاسُ فوجًا فوجًا، يُهَنِّئوني بالتَّوبةِ ويقولونَ: لتَهنِئْكَ تَوبةُ اللهِ عليكَ! حتَّى دَخَلتُ المَسجِدَ، فإذا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم جالِسٌ في المَسجِدِ وحَوله النَّاسُ، فقامَ طَلحةُ بنُ عُبَيدِ اللهِ يُهَروِلُ حتَّى صافَحَني وهَنَّأني، واللهِ ما قامَ رَجُلٌ مِنَ المُهاجِرينَ غَيرُه. قال: فكانَ كَعبٌ لا يَنساها لطَلحةَ. قال كَعبٌ: فلَمَّا سَلَّمتُ على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم قال وهو يَبرُقُ وجهُه مِنَ السُّرورِ ويقولُ: أبشِرْ بخَيرِ يَومٍ مَرَّ عليكَ مُنذُ ولَدَتكَ أُمُّكَ، قال: فقُلتُ: أمِن عِندِكَ يا رَسولَ اللهِ أم مِن عِندِ اللهِ؟ فقال: لا، بَل مِن عِندِ اللهِ، وكانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم إذا سُرَّ استَنارَ وجهُه، كَأنَّ وجهَه قِطعةُ قَمَرٍ، قال: وكُنَّا نَعرِفُ ذلك، قال: فلَمَّا جَلَستُ بينَ يَدَيه قُلتُ: يا رَسولَ اللهِ، إنَّ مِن تَوبَتي أن أنخَلِعَ مِن مالي صَدَقةً إلى اللهِ وإلى رَسولِه صلَّى اللهُ عليه وسلَّم، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أمسِكْ بَعضَ مالِكَ فهو خَيرٌ لكَ، قال: فقُلتُ: فإنِّي أُمسِكُ سَهميَ الذي بخَيبَرَ، قال: وقُلتُ: يا رَسولَ اللهِ، إنَّ اللهَ إنَّما أنجاني بالصِّدقِ، وإنَّ مِن تَوبَتي أن لا أُحَدِّثَ إلَّا صِدقًا ما بَقيتُ، قال: فواللهِ ما عَلِمتُ أنَّ أحَدًا مِنَ المُسلِمينَ أبلاه اللهُ في صِدقِ الحَديثِ مُنذُ ذَكَرتُ ذلك لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّم إلى يَومي هذا أحسَنَ ممَّا أبلاني اللهُ به، واللهِ ما تَعَمَّدتُ كَذبةً مُنذُ قُلتُ ذلك لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّم إلى يَومي هذا، وإنِّي لأرجو أن يَحفَظَني اللهُ فيما بَقيَ. قال: فأنزَلَ اللهُ عَزَّ وجَلَّ: {لقد تابَ اللهُ على النَّبيِّ والمُهاجِرينَ والأنصارِ الذينَ اتَّبَعوه في ساعةِ العُسرةِ مِن بَعدِ ما كادَ يَزيغُ قُلوبُ فريقٍ منهم ثُمَّ تابَ عليهم إنَّه بهم رَؤوفٌ رَحيمٌ وعلى الثَّلاثةِ الذينَ خُلِّفوا حتَّى إذا ضاقَت عليهمِ الأرضُ بما رَحُبَت وضاقَت عليهم أنفُسُهم} حتَّى بَلَغَ: {يا أيُّها الذينَ آمَنوا اتَّقوا اللهَ وكونوا مع الصَّادِقينَ}. قال كَعبٌ: واللهِ ما أنعَمَ اللهُ عليَّ مِن نِعمةٍ قَطُّ بَعدَ إذ هَداني اللهُ للإسلامِ أعظَمَ في نَفسي مِن صِدقي رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم أن لا أكونَ كَذَبتُه فأهلِكَ كما هَلَكَ الذينَ كَذَبوا، إنَّ اللهَ قال للذينَ كَذَبوا حينَ أنزَلَ الوحيَ شَرَّ ما قال لأحَدٍ. وقال اللهُ: {سَيَحلِفونَ باللهِ لَكُم إذا انقَلَبتُم إليهم لتُعرِضوا عنهم فأعرِضوا عنهم إنَّهم رِجسٌ ومَأواهم جَهَنَّمُ جَزاءً بما كانوا يَكسِبونَ يَحلِفونَ لَكُم لتَرضَوا عنهم فإن تَرضَوا عنهم فإنَّ اللهَ لا يَرضى عَنِ القَومِ الفاسِقينَ}. قال كَعبٌ: كُنَّا خُلِّفنا أيُّها الثَّلاثةُ عن أمرِ أولَئِكَ الذينَ قَبِلَ منهم رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم حينَ حَلَفوا له، فبايَعَهم واستَغفَرَ لهم، وأرجَأ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم أمرَنا حتَّى قَضى اللهُ فيه، فبِذلك قال اللهُ عَزَّ وجَلَّ: وعلى الثَّلاثةِ الذينَ خُلِّفوا، وليسَ الذي ذَكَرَ اللهُ ممَّا خُلِّفنا تَخَلُّفَنا عَنِ الغَزوِ، وإنَّما هو تَخليفُه إيَّانا، وإرجاؤُه أمرَنا، عَمَّن حَلَفَ له واعتَذَرَ إليه فقَبِلَ منه. وفي روايةٍ: أنَّ عُبَيدَ اللهِ بنَ كَعبِ بنِ مالِكٍ، وكانَ قائِدَ كَعبٍ حينَ عَميَ، قال: سَمِعتُ كَعبَ بنَ مالِكٍ يُحَدِّثُ حَديثَه حينَ تَخَلَّفَ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةِ تَبوكَ، وساقَ الحَديثَ. وزادَ فيه، على يونُسَ: فكانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم قَلَّما يُريدُ غَزوةً إلَّا ورَّى بغَيرِها، حتَّى كانَت تلك الغَزوةُ."],"grade":"صحيح","narrator":"كعب بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4418)، وأحمد (15789) باختلاف يسير، والنسائي في ((الكبرى)) (11168) بنحوه.","bab":"قرآن › أسباب النزول","dorar":"MuC2vFZU"},{"id":"س-00200","fp":"31be04d5f3a5","stateId":280,"easy":"إذا تعودت الكذب ← تُكتب عند الله كذاباً","cause":"وإِنَّ العبدَ يكذِبُ","result":"حتى يُكْتَبَ عندَ اللهِ كذابًا","explicit":true,"repOf":"س-03678","otherNeedIds":[13],"ref":"الجامع الصغير 2591","text":["إِنَّما هما اثنتانِ الكلامُ والهديُ ، فأحسنُ الكلامِ كلامُ اللهِ ، وأحسنُ الهدْيِ هديُ محمدٍ ، ألَا وإيَّاكم ومحدَثاتِ الأمورِ ، فإِنَّ شرَّ الأمورِ مُحْدَثاتُها ، وكُلَّ محدَثَةٍ بدعةٌ ، وكُلَّ بِدْعَةٍ ضلالَةٌ ، ألَا لَا يَطولَنَّ عليكم الأمَدُ فتقسو قلوبُكُم ، ألَا إِنَّ كُلَّ ما هو آتٍ قريبٌ ، وإِنَّما البعيدُ ما ليس بآتٍ ، ألَا إِنَّما الشَّقِيُّ مَنْ شقِيَ في بطنِ أُمِّهِ ، والسعيدُ مَنْ وُعِظَ بِغَيْرِهِ ، ألَا إِنَّ قتالَ المؤمِنِ كفْرٌ ، وسبابَهُ فسوقٌ ، ولَا يَحِلُ لمسلِمٍ أنْ يهجُرَ أخاهُ فوقَ ثلاثٍ ، ألَا وإيَّاكم والكذبَ ، فإِنَّ الكذبَ لا يصلُحُ لَا بالجدِّ ، ولَا بالْهَزْلِ ، ولَا يعِدُ الرجلُ صَبِيَّهُ ولَا يفِي ، وإِنَّ الكذِبَ يهدِي إلى الفجورِ ، وإِنَّ الفجورَ يهدي إلى النارِ ، وإِنَّ الصدقَ يهدي إلى البرِ ، وإِنَّ البرَّ يهدي إلى الجنَّةِ ، وإِنَّه يقالُ للصادقِ : صدقَ وبَرَّ ، ويقالُ للكاذِبِ : كذَبَ وفجرَ ، ألَا ",["وإِنَّ العبدَ يكذِبُ",1]," ",["حتى يُكْتَبَ عندَ اللهِ كذابًا",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (46) واللفظ له، والطبراني (9/99) (8520) باختلاف يسير، والبيهقي في ((شعب الإيمان)) (4787) مختصراً باختلاف يسير","bab":"آداب الكلام › الصدق وما جاء فيه","dorar":"UhkJzNNf","merged":3,"otherRefs":["المستدرك على الصحيحين 445 (صحيح)","تخريج المسند لشعيب 4160 (صحيح)"]},{"id":"س-05714","fp":"4890dc8003fc","stateId":280,"easy":"إذا كنت تاجراً حلّافاً أو بخيلاً منّاناً أو فقيراً مختالاً ← يبغضك الله","cause":"التاجرُ الحلاَّفُ أو قال البياَّعُ الحلَّافُ والبخيلُ المنَّانُ والفقيرُ المُختالُ","result":"ثلاثةً يشنأُهم اللهُ","explicit":true,"similar":["س-00429"],"ref":"مسند علي 55","srcLabel":"الترمذي","text":["عن ابنِ الأحمسِ قال لقيتُ أبا ذرٍّ فقلتُ له بلغَني أنك تحدِّثُ عن رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ أنَّ ",["ثلاثةً يشنأُهم اللهُ",2]," قال نعم قد سمعتُه قال قلتُ فمن الذين يشنأُهم اللهُ قال ",["التاجرُ الحلاَّفُ أو قال البياَّعُ الحلَّافُ والبخيلُ المنَّانُ والفقيرُ المُختالُ",1]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (2568)، وأحمد (21530)، والبزار (3908) جميعهم بألفاظ مقاربة.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"L0858ZeH"},{"id":"س-00444","fp":"d2b973cd0b9c","stateId":280,"easy":"إذا كذبت ← يُعرض عنك النبي ﷺ حتى تتوب","cause":"كذبَ كَذْبَةً","result":"لمْ يَزَلْ مُعْرِضًا عنهُ حتى يُحْدِثَ توبةً","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[44],"ref":"صحيح الجامع 4675","srcLabel":"الترمذي","text":["كان إذا اطَّلَعَ على أَحَدٍ من أهلِ بَيتِه ",["كذبَ كَذْبَةً",1]," ، ",["لمْ يَزَلْ مُعْرِضًا عنهُ حتى يُحْدِثَ توبةً",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1973)، وأحمد (25183) بنحوه، والعقيلي في ((الضعفاء الكبير)) (1/9) واللفظ له","bab":"آداب عامة › الأخلاق المذمومة","dorar":"DAVxtzQP"},{"id":"س-04007","fp":"f43e8fb87b35","stateId":280,"easy":"إذا كذبت ← فهو أبغض الأخلاق إلى الصحابة","cause":"مِنَ الكَذِبِ","result":"ما كان خُلُقٌ أبغَضَ إلى أصحابِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ مِنَ الكَذِبِ، ولقدْ كان الرَّجُلُ يَكذِبُ عِندَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ الكِذبةَ، فما يَزالُ في نَفْسِه عليه حتى يَعلَمَ أنَّهُ قد أحدَثَ منها تَوبةً","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[44],"ref":"تخريج المسند لشعيب 25183","srcLabel":"أحمد","text":[["ما كان خُلُقٌ أبغَضَ إلى أصحابِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ مِنَ الكَذِبِ، ولقدْ كان الرَّجُلُ يَكذِبُ عِندَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ الكِذبةَ، فما يَزالُ في نَفْسِه عليه حتى يَعلَمَ أنَّهُ قد أحدَثَ منها تَوبةً",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (25183) واللفظ له، وعبدالرزاق (20195)، والبزار (211)","bab":"توبة › الحض على التوبة","dorar":"jcdKUXli","merged":5,"otherRefs":["أعلام الموقعين 1/117 (حسن)","الترغيب والترهيب 4/55 (صحيح)","المستدرك على الصحيحين 7240 (صحيح)","صحيح الجامع 4618 (صحيح)"]},{"id":"س-00429","fp":"9b824075aeaa","stateId":280,"easy":"إذا كنت تاجراً حلّافاً أو بخيلاً منّاناً ← يبغضك الله","cause":"التَّاجرُ الحلَّافُ، أوِ البائعُ الحلَّافُ -شكَّ الجُرَيريُّ- والبخيلُ المنَّانُ، والفقيرُ المُختالُ","result":"فمَنِ الذينَ يَشْنَؤُهم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-05714","ref":"تخريج مشكل الآثار 2783","text":["عن ابن الأَحْمَسِ أنَّه قال: بلَغَني أنَّ أبا ذَرٍّ رضِيَ اللهُ عنه يقولُ: ثلاثةٌ يُحبُّهمُ اللهُ عزَّ وجلَّ، وثلاثةٌ يَشْنَؤُهمُ اللهُ عزَّ وجلَّ، قال: فلقِيتُهُ، فقُلْتُ: يا أبا ذَرٍّ، ما حديثٌ بلَغَني عنكِ تُحُدِّثَ به عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أَحبَبْتُ أنْ أَسمَعَهُ منك؟ قال: ما هو؟ قُلْتُ: ثلاثةٌ يُحبُّهمُ اللهُ عزَّ وجلَّ، وثلاثةٌ يَشْنَؤُهمُ اللهُ عزَّ وجلَّ، قال أبو ذَرٍّ: قُلْتُهُ وسمِعْتُه. قال: قُلْتُ: مَنِ الذينَ يُحبُّهمُ اللهُ؟ قال: رجُلٌ لقِيَ فِئةً أو سَرِيَّةً فانكَشَفَ أصحابُهُ فلقِيَهم بنفْسِهِ ونَحرِهِ حتَّى قُتِلَ أو فتَحَ اللهُ عزَّ وجلَّ، ورجُلٌ كان مع قومٍ، فأطالوا السُّرى حتَّى أَعجَبهم أنْ يَمَسُّوا الأرضَ فنزَلوا، فتَنحَّى، فصلَّى حتَّى أيقَظَ أصحابَهُ للرحيلِ، ورجُلٌ كان له جارُ سُوءٍ، فصبَر على أذاهُ حتَّى يُفرِّقَ بيْنَهما موتٌ أو ظَعْنٌ. قال: قُلْتُ: هؤلاءِ الذينَ يُحبُّهمُ اللهُ ",["فمَنِ الذينَ يَشْنَؤُهم",2],"؟ قال: ",["التَّاجرُ الحلَّافُ، أوِ البائعُ الحلَّافُ -شكَّ الجُرَيريُّ- والبخيلُ المنَّانُ، والفقيرُ المُختالُ",1],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح المشكل)) (2783) بلفظه، والترمذي (2568)، وأحمد (21530)، والبزار (3908) جميعهم باختلاف يسير.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"16anvgz0","merged":2,"otherRefs":["تخريج المسند لشعيب 21340 (صحيح)"]},{"id":"س-00170","fp":"54334804774f","stateId":281,"easy":"إذا فحشت أو تفحشت ← فالله لا يحب ذلك","cause":"الفُحشَ ولا التفَحُّشَ","result":"إنَّ اللهَ لا يُحِبُّ","explicit":true,"star":true,"similar":["س-01553","س-08030"],"ref":"تخريج المسند لشعيب 25029","srcLabel":"متفق عليه","text":["بَيْنا أنا عندَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، إذِ استَأذَنَ رَجلٌ منَ اليَهودِ، فأَذِنَ له، فقال: السامُ عليكَ، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: وعليكَ، قالت: فهمَمْتُ أنْ أتكَلَّمَ، قالت: ثُم دخَلَ الثانيةَ، فقال مثلَ ذلك، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: وعليكَ، قالت: ثُم دخَلَ الثالثةَ، فقال: السامُ عليكَ، قالت: فقُلْتُ: بلِ السامُ عليكم، وغَضبُ اللهِ، إخوانَ القِرَدةِ والخَنازيرِ، أتُحَيُّونَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ بما لم يُحَيِّهِ به اللهُ؟ قالت: فنظَرَ إليَّ، فقال: مَهْ، ",["إنَّ اللهَ لا يُحِبُّ",2]," ",["الفُحشَ ولا التفَحُّشَ",1],"، قالوا قَولًا، فردَدْناهُ عليهم، فلم يَضُرَّنا شيءٌ، ولزِمَهم إلى يومِ القيامةِ، إنَّهم لا يَحسُدونا على شيءٍ كما يَحسُدونا على يومِ الجمُعةِ التي هَدانا اللهُ لها، وضَلُّوا عنها، وعلى القِبلةِ التي هَدانا اللهُ لها، وضَلُّوا عنها، وعلى قولِنا خلفَ الإمامِ: آمينَ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6395)، ومسلم (2165) مختصراً باختلاف يسير","bab":"آداب السلام › كيفية رد السلام","dorar":"AI39VwGr","merged":7,"otherRefs":["تخريج المسند لشعيب 9569 (صحيح)","المستدرك على الصحيحين 7575 (صحيح)","تفسير القرطبي 20/310 (صحيح)","السلسلة الصحيحة 2721 (صحيح)","صحيح مسلم 2165 (صحيح)","تخريج المسند لشاكر 11/71 (صحيح)"]},{"id":"س-00452","fp":"de67ae60b3ed","stateId":281,"easy":"إذا كنت فاحشاً بذيئاً ← يبغضك الله","cause":"الفاحِشَ البَذيءَ","result":"إنَّ اللهَ يُبغِضُ","explicit":true,"star":true,"similar":["س-00451"],"ref":"الأحاديث المختارة 1316","srcLabel":"البخاري","text":["«رَأيْتُ أُسامةَ بنَ زَيدٍ عنْدَ حُجْرةِ عائِشةَ يَدْعو، فجاءَ مَرْوانُ فأَسمَعَه كَلامًا، فقالَ أُسامةُ: أَمَا إنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["إنَّ اللهَ يُبغِضُ",2],[" الفاحِشَ البَذيءَ»",1],"."],"grade":"صحيح","narrator":"أسامة بن زيد","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"آداب عامة › الأخلاق المذمومة","dorar":"vN42fROP","merged":3,"otherRefs":["تخريج رياض الصالحين 626 (صحيح)","صحيح الجامع 5632 (صحيح)"]},{"id":"س-00451","fp":"b963f226f709","stateId":281,"easy":"إذا كنت فاحشاً متفحشاً ← يبغضك الله","cause":"الفاحِشَ والمُتَفَحِّشَ، وإنَّك فاحِشٌ مُتَفَحِّشٌ","result":"إنَّ اللهَ يُبغِضُ","explicit":true,"repOf":"س-00452","ref":"الأحاديث المختارة 1317","text":["«رَأيْتُ أُسامةَ بنَ زَيدٍ مُضْطَجِعًا على بابِ حُجْرةِ عائِشةَ رافِعًا عَقيرتَه يَتَغَنَّى، ورَأيْتُه يُصَلِّي عنْدَ قَبْرِ النَّبيِّ صلَّى اللهُ عليه وسلَّم، فمَرَّ به مَرْوانُ، فقالَ: أَتُصَلِّي عنْدَ قَبْرِه يا بنَ أخٍ؟ فقالَ له قَوْلًا قَبيحًا، ثُمَّ أَدبَرَ، فانْصَرَفَ أُسامةُ، فقالَ له: يا مَرْوانُ، إنَّك فاحِشٌ مُتَفَحِّشٌ، وإنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["إنَّ اللهَ يُبغِضُ",2],[" الفاحِشَ والمُتَفَحِّشَ، وإنَّك فاحِشٌ مُتَفَحِّشٌ»",1],"."],"grade":"صحيح","narrator":"أسامة بن زيد","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"آداب عامة › الأخلاق المذمومة","dorar":"04bxlmeu","merged":2,"otherRefs":["الأحاديث المختارة 1318 (صحيح)"]},{"id":"س-00425","fp":"c4cab4f5115c","stateId":281,"easy":"إذا كنت شديد الخصومة ← تكون أبغض الرجال إلى الله","cause":"إلى اللهِ عزَّ وجلَّ، الألَدُّ الخَصِمُ","result":"إنَّ أبغَضَ الرِّجالِ","explicit":true,"star":true,"otherNeedIds":[13],"ref":"تخريج المسند لشعيب 25704","srcLabel":"متفق عليه","text":[["إنَّ أبغَضَ الرِّجالِ",2],[" إلى اللهِ عزَّ وجلَّ، الألَدُّ الخَصِمُ",1],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (2457)، ومسلم (2668)","bab":"آداب عامة › الأخلاق المذمومة","dorar":"qV4EHkET"},{"id":"س-03838","fp":"11a20a12f1ab","stateId":281,"easy":"إذا كنت فاحشاً متفحشاً ← فالله لا يحبك","cause":"الفاحِشَ ولا المُتَفَحِّشَ","result":"إنَّ اللهَ لا يُحِبُّ","explicit":true,"ref":"المستدرك على الصحيحين 255","srcLabel":"أحمد","text":["عنْ عبدِ اللهِ بنِ بُرَيْدَة قالَ: ذُكِرَ لي أَنَّ أَبا سَبْرَةَ بْنَ سَلَمَةَ الهُذَلِيَّ سَمِعَ ابْنَ زيادٍ يَسْأَلُ عَنِ الحوْضِ؛ حَوْضِ مُحمَّدٍ صلَّى اللهُ عليه وسلَّمَ، فقالَ: ما أُراهُ حَقًّا بَعْدَما سَأَلَ أَبا بَرْزَةَ الأَسْلَمِيَّ والبَراءَ بْنَ عازِبٍ وعائذَ بنَ عَمْرٍو، فقالَ: ما أُصَدِّقُ هؤلاء. فقالَ أَبو سَبْرَةَ: أَلا أُحَدِّثُكَ بِحديثِ شِفاءٍ؟ بَعَثَني أَبوكَ بمالٍ إلى مُعاويةَ، فَلَقِيتُ عبدَ اللهِ بنَ عَمْرٍو، فحَدَّثني بِفيهِ، وكَتَبْتُهُ بِقَلَمي، ما سَمِعَهُ مِنْ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فَلَمْ أَزِدْ حَرْفًا ولَمْ أَنْقُصْ، حَدَّثَني أَنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قالَ: «",["إنَّ اللهَ لا يُحِبُّ",2]," ",["الفاحِشَ ولا المُتَفَحِّشَ",1],"، والَّذي نَفْسُ مُحَمَّدٍ بيدِهِ لا تَقومُ السَّاعَةُ حتَّى يَظْهَرَ الفُحْشُ والتَّفَحُّشُ، وقَطيعةُ الرَّحِمِ، وسُوءُ الْمُجاوَرَةِ، ويَخونُ الأَمينُ ويُؤْتَمنُ الخائنُ، ومَثَلُ المؤْمِنِ كَمَثَلِ النَّحْلةِ أَكَلَتْ طَيِّبًا، وَوَضَعَتْ طَيِّبًا، وَوَقَعَتْ طَيِّبًا، فَلَمْ تُفْسِدْ ولَمْ تَكْسِرْ، ومَثَلُ العَبْدِ المؤْمِنِ مِثْلُ القِطْعَةِ الجَيِّدَةِ مِنَ الذَّهَبِ نُفِخَ عليها، فَخَرَجَتْ طَيِّبةً، وَوُزِنَتْ فَلَمْ تَنْقُصْ». وقالَ صلَّى اللهُ عليه وسلَّمَ: «مَوْعِدُكُمْ حَوْضي عَرْضُهُ مِثْلُ طولِهِ، وهو أَبْعَدُ مِمَّا بَيْنَ أَيْلَةَ إلى مَكَّةَ، وذاكَ مَسيرَةُ شَهْرٍ، فيهِ أَمْثالُ الكَواكِبِ أَباريقُ، ماؤهُ أَشَدُّ بَياضًا مِنَ الفِضَّةِ، مَنْ وَرَدَهُ وشَرِبَ مِنْهُ لَمْ يَظْمَأْ بَعْدَهُ أَبَدًا». فقالَ ابنُ زيادٍ: ما حَدَّثني أَحَدٌ بِحَديثٍ مِثْلِ هذا، أَشْهَدُ أنَّ الحَوْضَ حَقٌّ واجِبٌ. وَأَخَذَ الصَّحيفَةَ الَّتي جاءَ بها أبو سَبْرَةَ. وفي حَديثِ أَبي أُسامَةَ عنْ عبدِ اللهِ بنِ بُرَيْدَةَ، عن أبي سَبْرَة."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح فقد اتفق الشيخان على الاحتجاج بجميع رواته غير أبي سبرة الهذلي وهو تابعي كبير مبين ذكره في المسانيد والتواريخ غير مطعون فيه وله شاهد من حديث قتادة، عن ابن بريدة","takhrij":"أخرجه أحمد (6514)، والبزار (2435) كلاهما بلفظ مقارب، وأبو الشيخ الأصبهاني في ((التوبيخ)) (142) مختصرا.","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"KLVJWFQl","merged":8,"otherRefs":["الجامع الصغير 1813 (صحيح)","المستدرك على الصحيحين 8791 (صحيح)","تخريج المسند لشعيب 6872 (صحيح)","الأحاديث المختارة 1313 (صحيح)","صحيح أبي داود 4792 (صحيح)","السلسلة الصحيحة 2/306 (صحيح)","صحيح الترغيب 2217 (صحيح)"]},{"id":"ق-0270","fp":"62658da4324a","stateId":281,"easy":"الجهر بالسوء من القول ← لا يحبه الله","cause":"الجهر بالسوء من القول","result":"لا يحبه الله","explicit":true,"ref":"سورة النساء: 148","srcLabel":"القرآن الكريم","quran":{"s":4,"from":148,"to":148,"text":"لَا يُحِبُّ اللَّهُ الْجَهْرَ بِالسُّوءِ مِنَ الْقَوْلِ إِلَّا مَنْ ظُلِمَ وَكَانَ اللَّهُ سَمِيعًا عَلِيمًا (148)","hl":[[0,55,1]]}},{"id":"س-05711","fp":"b80f5b0d9ba3","stateId":281,"easy":"إذا كنت ثرثاراً متفيهقاً متشدقاً ← تكون أبغض الناس إلى النبي ﷺ وأبعدهم منه","cause":"الثَّرْثَارُونَ المُتَفَيْهِقُونَ المُتَشَدِّقُونَ","result":"وإِنَّ أبغضَكُمْ إِلَيَّ وأَبْعَدَكُمْ مِنِّي في الآخرةِ","explicit":true,"similar":["س-00258"],"otherNeedIds":[52],"ref":"صحيح الترغيب 2663","srcLabel":"الترمذي","text":["إِنَّ أحبَّكُمْ إِلَيَّ أَقْرَبَكُمْ مِنِّي في الآخرةِ مَحاسِنُكُمْ أَخْلاقًا ، ",["وإِنَّ أبغضَكُمْ إِلَيَّ وأَبْعَدَكُمْ مِنِّي في الآخرةِ",2]," ",["الثَّرْثَارُونَ المُتَفَيْهِقُونَ المُتَشَدِّقُونَ",1]," قالوا يا رسولَ اللهِ قد عَلِمْنا الثَّرْثَارُونَ والمُتَشَدِّقُونَ فما المُتَفَيْهِقُونَ قال : المتكبرونَ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"حسن صحيح","takhrij":"أخرجه الترمذي (2018)، وابن المقريء في ((معجمه)) (419)، وأبو الفضل الزهري في ((حديثه)) (708) باختلاف يسير.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"W1kG4fm7","merged":4,"otherRefs":["صحيح ابن حبان 482 (صحيح)","صحيح الترغيب 2897 (صحيح)","الأحاديث المختارة 11 / 404 (صحيح)"]},{"id":"س-00258","fp":"98091528bf8b","stateId":281,"easy":"إذا كنت ثرثاراً متشدقاً ← تكون من شرار الناس","cause":"الثرْثارون المُتشدِّقون","result":"ألَا أُنبِئُكم بشِرارِكم","explicit":true,"repOf":"س-05711","otherNeedIds":[13],"ref":"تخريج المسند لشعيب 8822","text":[["ألَا أُنبِئُكم بشِرارِكم",2],"؟ فقال: همُ ",["الثرْثارون المُتشدِّقون",1],"، ألَا أُنبِئُكم بخيارِكم؟ أحاسِنُكم أخلاقًا."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (8822) واللفظ له، والبخاري في ((الأدب المفرد)) (1308)، والبزار (9442) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"rwuLWLQH"},{"id":"س-00473","fp":"4d217055112a","stateId":281,"easy":"إذا لعنت بعيرك ← لا يُسار معك عليه","cause":"فلعن بعيرَه","result":"لا تَسِرْ معنا على بَعيرٍ مَلعونٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأحاديث المختارة 2179","srcLabel":"البخاري","text":["«سار رَجُلٌ مع النَّبيِّ صلَّى اللهُ عليه وسلَّم على بعيرٍ، ",["فلعن بعيرَه",1],"، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: يا عَبْدَ اللهِ ",["لا تَسِرْ معنا على بَعيرٍ مَلعونٍ",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"آداب عامة › الرفق بالحيوان والطير ونحوهما","dorar":"1w8cp0Xl"},{"id":"س-01770","fp":"65ee7372c7ab","stateId":281,"easy":"إذا لعنت راحلتك ← لا تصحبكم","cause":"راحلةٌ عليها لعنةٌ","result":"لا تُصَاحِبْنا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-00447"],"ref":"صحيح الجامع 7178","srcLabel":"مسلم","text":["لا أَيْمُ اللهِ ، ",["لا تُصَاحِبْنا",2]," ",["راحلةٌ عليها لعنةٌ",1]],"grade":"صحيح","narrator":"أبو برزة الأسلمي نضلة بن عبيد","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2596) واللفظ له، وأحمد (19766)، وابن أبي عاصم في ((الآحاد والمثاني)) (2362) كلاهما باختلاف يسير.","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"e0RLjClR"},{"id":"س-04817","fp":"a81a9afb1727","stateId":281,"easy":"إذا لعنت دابتك ← تُمنع من صحبة الصالحين بها","cause":"شَأ، لَعَنَكَ اللهُ","result":"انزِلْ عنه، فلا تَصحَبنا بمَلعونٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح مسلم 3009","srcLabel":"مسلم","text":["سِرنا مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةِ بَطنِ بواطٍ، وهو يَطلُبُ المَجديَّ بنَ عَمرٍو الجُهَنيَّ، وكان النَّاضِحُ يَعتَقِبُه مِنَّا الخَمسةُ والسِّتَّةُ والسَّبعةُ، فدارَت عُقبةُ رَجُلٍ مِنَ الأنصارِ على ناضِحٍ له، فأناخَه فرَكِبَه، ثُمَّ بَعَثَه فتَلَدَّنَ عليه بَعضَ التَّلَدُّنِ، فقال له: ",["شَأ، لَعَنَكَ اللهُ",1],"، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: مَن هذا اللَّاعِنُ بَعيرَه؟ قال: أنا، يا رَسولَ اللهِ، قال: ",["انزِلْ عنه، فلا تَصحَبنا بمَلعونٍ",2],"، لا تَدعوا على أنفُسِكُم، ولا تَدعوا على أولادِكُم، ولا تَدعوا على أموالِكُم، لا توافِقوا مِنَ اللهِ ساعةً يُسألُ فيها عَطاءٌ فيَستَجيبُ لَكُم."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (3009).","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"1sojxw0Q"},{"id":"س-01028","fp":"aac485f97f94","stateId":281,"easy":"إذا مشيت بالنميمة وفرّقت بين الأحبة ← تكون من شرار عباد الله","cause":"المشَّاؤونَ بالنَّميمةِ المُفرِّقونَ بينَ الأحبَّةِ","result":"وشرارُ عبادِ اللهِ","explicit":true,"otherNeedIds":[13],"ref":"مجمع الزوائد 8/96","srcLabel":"أحمد","text":["خيارُ عبادِ اللهِ  الَّذين  إذا رُؤوا ذُكِر اللهُ ",["وشرارُ عبادِ اللهِ",2]," ",["المشَّاؤونَ بالنَّميمةِ المُفرِّقونَ بينَ الأحبَّةِ",1]," الباغونَ للبُرآءِ العنت"],"grade":"صحيح","narrator":"عبدالرحمن بن غنم","muhaddith":"فيه شهر بن حوشب وبقية رجاله رجال الصحيح","takhrij":"أخرجه أحمد (17998) بلفظه، وأبو نعيم الأصبهاني في ((معرفة الصحابة)) (4700) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"jzX084L3"},{"id":"س-01553","fp":"f68e9d1187e8","stateId":281,"easy":"إذا فحشت ← فالله لا يحب الفحش","cause":"الفُحشَ أو يُبغِضُ الفاحشَ والمتفحِّشَ قالَ : ولا تقومُ السَّاعةُ حتَّى يظهرَ الفُحشُ والتَّفاحشُ ، وقطيعةُ الرَّحمِ ، وسوءُ المُجاورةِ ، وحتَّى يُؤتَمنَ الخائنُ ويخوَّنَ الأمينُ وقالَ : ألا إنَّ موعدَكُم حَوضي ، عرضُهُ وطولُهُ واحدٌ","result":"إنَّ اللَّهَ لا يحبُّ","explicit":true,"repOf":"س-00170","ref":"تخريج المسند لشاكر 10/20","text":["كانَ عُبَيْدُ اللَّهِ بنُ زيادٍ يسألُ عنِ الحَوضِ ، حوضِ محمَّدٍ صلَّى اللَّهُ عليهِ وسلَّمَ ، وَكانَ يُكَذِّبُ بِهِ ، بعدَ ما سألَ أبا بَرزةَ والبراءَ بنَ عازبٍ وعائذَ بنَ عَمرٍو ورجلًا آخرَ ، وَكانَ يُكَذِّبُ بِهِ ، فقالَ أبو سَبرةَ : أَنا أحدِّثُكَ ِبحديثٍ فيهِ شفاءُ هذا ، إنَّ أباكَ بَعثَ معي بمالٍ إلى معاويةَ فلَقيتُ عبدَ اللَّهِ بنَ عَمرٍو فحدَّثَني مِمَّا سمعَ من رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ، وأملَى عليَّ ، فَكَتبتُ بيدي ، فلم أزِد حرفًا ، ولم أنقُص حرفًا ، حدَّثَني أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ : ",["إنَّ اللَّهَ لا يحبُّ",2],[" الفُحشَ أو يُبغِضُ الفاحشَ والمتفحِّشَ قالَ : ولا تقومُ السَّاعةُ حتَّى يظهرَ الفُحشُ والتَّفاحشُ ، وقطيعةُ الرَّحمِ ، وسوءُ المُجاورةِ ، وحتَّى يُؤتَمنَ الخائنُ ويخوَّنَ الأمينُ وقالَ : ألا إنَّ موعدَكُم حَوضي ، عرضُهُ وطولُهُ واحدٌ",1]," ، وَهوَ كما بينَ أيلةَ ومَكَّةَ ، وَهوَ مَسيرةُ شَهْرٍ ، فيهِ مثلُ النُّجومِ أباريقُ ، شرابُهُ أشدُّ بياضًا منَ الفضَّةِ ، مَن شربَ منهُ مشربًا ، لم يَظمأ بعدَهُ أبدًا فقالَ عُبَيْدُ اللَّهِ : ما سَمِعْتُ في الحوضِ حَديثًا أثبتَ من هذا فصدَّقَ بِهِ ، وأخذَ الصَّحيفةَ فحبَسَها عندَهُ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6514)، والحاكم (253)، والبزار (2435) واللفظ لهم.","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"itk5ylHi"},{"id":"س-04914","fp":"35bb514b583f","stateId":281,"easy":"إذا خاف الناس لسانك وشرك ← تكون من شر الناس منزلة يوم القيامة","cause":"مَنْزِلَةً يومَ القيامةِ مَن يُخَافُ لسانُه ، أو يُخَافُ شَرُّهُ","result":"شَرُّ الناسِ","explicit":true,"otherNeedIds":[13],"ref":"الجامع الصغير 4862","srcLabel":"الطبراني","text":[["شَرُّ الناسِ",2],[" مَنْزِلَةً يومَ القيامةِ مَن يُخَافُ لسانُه ، أو يُخَافُ شَرُّهُ",1],"."],"grade":"صحيح","narrator":"أنس","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي الدنيا في ((الصمت)) (219) واللفظ له، والطبراني في ((الأوسط)) (5307)، وابن عدي في ((الكامل)) (5/ 163) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ldiTEYLi"},{"id":"س-06930","fp":"5575ee6a845f","stateId":281,"easy":"إذا تشدقت بلسانك في الكلام ← يبغضك الله","cause":"البليغَ منَ الرِّجالِ ، الَّذي يتخلَّلُ بلسانِهِ ، كما تخلَّلَ الباقِرةُ بلِسانِها","result":"إنَّ اللَّهَ عزَّ وجلَّ يُبغِضُ","explicit":true,"ref":"تخريج المسند لشاكر 10/53","srcLabel":"أبو داود","text":[["إنَّ اللَّهَ عزَّ وجلَّ يُبغِضُ",2],[" البليغَ منَ الرِّجالِ ، الَّذي يتخلَّلُ بلسانِهِ ، كما تخلَّلَ الباقِرةُ بلِسانِها",1]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (5005)، والترمذي (2853) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"ZhhRzUCD"},{"id":"س-08030","fp":"1804d08bed9c","stateId":281,"easy":"إذا فحشت أو تفحشت ← فالله لا يحب الفاحش المتفحش","cause":"إِيَّاكُمْ والفُحْشَ والتَّفَحُّشَ","result":"فإنَّ اللهَ لا يحبُّ الفَاحِشَ والمتفحش","explicit":true,"repOf":"س-00170","otherNeedIds":[13],"ref":"صحيح الترغيب 2603","text":[["إِيَّاكُمْ والفُحْشَ والتَّفَحُّشَ ، ",1],["فإنَّ اللهَ لا يحبُّ الفَاحِشَ والمتفحش",2]," ، وإِيَّاكُمْ والظُّلْمَ ؛ فإنَّهُ هو الظُّلُماتُ يومَ القيامةِ ، وإِيَّاكُمْ والشُّحَّ ، فإنَّهُ دعا من كان قبلَكُمْ فَسَفَكُوا دِماءَهُمْ ، ودعا مَنْ كان قبلَكُمْ فَقَطَّعُوا أَرْحامَهُمْ ، ودعا مَنْ كان قبلَكُمْ فَاسْتَحَلُّوا حُرُماتِهمْ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (5177)، والحاكم (28)، والبزار (8486) باختلاف يسير.","bab":"مظالم › تحريم الظلم","dorar":"BuKUkq7Q"},{"id":"س-08419","fp":"fa7f5cbf33a6","stateId":281,"easy":"إذا لويت لسانك تشدقاً للناس ← فالله لا يحب ذلك","cause":"يَلوونَ ألسِنَتَهم للنَّاسِ لَيَّ البَقَرةِ بلِسانِها المَرعى","result":"إنَّ اللَّهَ لا يُحِبُّ هذا وضَرْبَه","explicit":true,"otherNeedIds":[70],"ref":"تنبيه الغافلين 354","srcLabel":"الطبراني","text":["عن واثِلةَ بنِ الأسقَعِ رَضِيَ اللهُ عنه قال: كُنتُ في أصحابِ الصُّفَّةِ، ولقد رَأيتُنا وما مِنَّا إنسانٌ عليه ثَوبٌ تَامٌّ، وأخَذَ العَرَقُ في جُلودِنا طُرُقًا مِنَ الغُبارِ والوَسَخِ، إذ خَرَجَ علينا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم فقال: بَشِّرْ فُقَراءَ المُهاجِرينَ. إذ أقبَل رَجُلٌ عليه شارةٌ حَسَنةٌ، فجَعَل النَّبيُّ صلَّى اللهُ عليه وسلَّم لا يَتَكَلَّمُ بكَلامٍ إلَّا كَلَّفَته نَفسُه يَأتي بكَلامٍ يَعلو على كَلامِ النَّبيِّ صلَّى اللهُ عليه وسلَّم، فلمَّا انصَرَف قال: «",["إنَّ اللَّهَ لا يُحِبُّ هذا وضَرْبَه",2],"، ",["يَلوونَ ألسِنَتَهم للنَّاسِ لَيَّ البَقَرةِ بلِسانِها المَرعى",1],"، كذلك يَلوي اللَّهُ ألسِنَتَهم ووُجوهَهم في النَّارِ»"],"grade":"صحيح","narrator":"واثلة بن الأسقع","muhaddith":"إسناده صحيح.","takhrij":"أخرجه الطبراني في ((الكبير)) (22/ 70) (170)، وابن وهب في ((الجامع)) (333) باختلاف يسير، والبيهقي في ((الشعب)) (9839) مختصرًا.","bab":"مناقب وفضائل › فضائل المهاجرين ومناقبهم","dorar":"4oer6QhB"},{"id":"س-00447","fp":"b50e34b1f949","stateId":281,"easy":"إذا لعنت دابتك ← لا تصحبكم (يُترك الملعون)","cause":"فلعَنَتْ بَعيرًا لها","result":"لا يَصْحَبْني شَيءٌ مَلعونٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-01770","ref":"تخريج المسند لشعيب 26210","text":["أنَّها كانَتْ مع النبيِّ صلَّى اللهُ عليه وسلَّمَ في سَفَرٍ، ",["فلعَنَتْ بَعيرًا لها",1],"؛ فأمَرَ به النبيُّ صلَّى اللهُ عليه وسلَّمَ أنْ يُرَدَّ، وقال: ",["لا يَصْحَبْني شَيءٌ مَلعونٌ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"مرفوعه صحيح لغيره","takhrij":"أخرجه أحمد (26210) واللفظ له، والحارث في ((المسند)) (873) بمعناه، والطبراني في ((المعجم الأوسط)) (8596) مختصراً","bab":"آداب عامة › الأخلاق المذمومة","dorar":"v91INnI8"},{"id":"س-02490","fp":"2ea713ff05b3","stateId":281,"easy":"إذا أكثرت القيل والقال وكثرة السؤال وإضاعة المال ← فهو مما كرهه الله لك","cause":"قيلَ وقال، وكثرةَ السؤالِ، وإضاعةَ المالِ","result":"وكَرِهَ لكم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"تخريج المسند لشعيب 8718","srcLabel":"مسلم","text":["إنَّ الله عزَّ وجَلَّ رَضِيَ لكم ثلاثًا، ",["وكَرِهَ لكم",2]," ثلاثًا: رَضِيَ لكم أنْ تَعبُدوه ولا تُشرِكوا به شيئًا، وأنْ تَنصَحوا لِمَن ولَّاه اللهُ أَمرَكم، وأنْ تَعتَصِموا بحَبْلِ اللهِ جميعًا، ولا تَفَرَّقوا، وكَرِهَ لكم: ",["قيلَ وقال، وكثرةَ السؤالِ، وإضاعةَ المالِ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (1715)، وأحمد (8718) واللفظ له","bab":"إمامة وخلافة › النصح لأئمة المسلمين وولاتهم","dorar":"dRjVB6Nf","merged":3,"otherRefs":["مجمع الزوائد 10/305 (صحيح)","تخريج المسند لشعيب 18147 (صحيح)"]},{"id":"س-02360","fp":"8ddaf3d46ef4","stateId":281,"easy":"إذا استحللت عرض مسلم ← فهو أربى الربا","cause":"عندَ اللَّهِ استحلالُ عِرضِ امرئٍ مسلِمٍ ، ثمَّ قرأ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ وَالَّذِينَ يُؤْذُونَ الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ بِغَيْرِ مَا اكْتَسَبُوا فَقَدِ احْتَمَلُوا بُهْتَانًا وَإِثْمًا مُبِينًا","result":"فإنَّ أربى الرِّبا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[13],"ref":"الزواجر عن اقتراف الكبائر 2/9","srcLabel":"الزواجر عن اقتراف الكبائر","text":["أتدرونَ أربى الرِّبا عندَ اللَّهِ ؟ قالوا اللَّهُ ورسولُهُ أعلَمُ. قالَ ",["فإنَّ أربى الرِّبا",2],[" عندَ اللَّهِ استحلالُ عِرضِ امرئٍ مسلِمٍ ، ثمَّ قرأ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ  وَالَّذِينَ يُؤْذُونَ الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ بِغَيْرِ مَا اكْتَسَبُوا فَقَدِ احْتَمَلُوا بُهْتَانًا وَإِثْمًا مُبِينًا",1]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"إسلام › حرمة المسلم","dorar":"I6xnSasA"},{"id":"س-01550","fp":"469b2382639a","stateId":282,"easy":"إذا تسمّيت «ملك الأملاك» ← فهو أخنع اسم عند الله يوم القيامة","cause":"رَجُلٌ تَسَمَّى بِـمَلِكِ الأَمْلاكِ","result":"أَخْنَعُ اسْمٍ عِنْدَ اللهِ يَوْمَ القِيامةِ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 7329","srcLabel":"متفق عليه","text":[["أَخْنَعُ اسْمٍ عِنْدَ اللهِ يَوْمَ القِيامةِ",2]," ",["رَجُلٌ تَسَمَّى بِـمَلِكِ الأَمْلاكِ",1],"، قال عبدُ اللهِ: قال أَبي: سألْتُ أبا عَمْرٍو الشَّيْبانِيَّ عن أَخْنَعِ اسْمٍ عِندَ اللهِ، فقال: أَوْضَعُ اسْمٍ عِندَ اللهِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6206)، ومسلم (2143)، وأبو داود (4961)، والترمذي (2837)، وأحمد (7329) واللفظ له","bab":"أسماء › الأسماء المنهي عنها والمكروهة","dorar":"Kx8pInMg","merged":5,"otherRefs":["المستدرك على الصحيحين 7932 (صحيح)","سبل السلام 4/153 (صحيح)","صحيح مسلم 2143 (صحيح)","صحيح البخاري 6206 (صحيح)"]},{"id":"س-04347","fp":"78843c729925","stateId":282,"easy":"إذا اختلت لغير الدين ← فهي الخيلاء التي يبغضها الله","cause":"فالخُيلاءُ لغيرِ الدِّينِ","result":"وأمَّا الخُيلاءُ الَّتي يُبغِضُ اللهُ","explicit":true,"star":true,"ref":"إكمال المعلم 6/599","srcLabel":"إكمال المعلم","text":["حديث الرُّخصةِ في الخُيَلاءِ على الكُفارِ أو في الحَربِ.[إنَّ مِن الغَيرةِ ما يُحِبُّ اللهُ ومنها ما يُبغِضُ اللهُ فأمَّا الغَيرةُ الَّتي يُحِبُّ اللهُ فالغَيرةُ في اللهِ وأمَّا الغَيرةُ الَّتي يُبغِضُ اللهُ فالغَيرةُ في غيرِ اللهِ وإنَّ مِن الخُيلاءِ ما يُحِبُّ اللهُ ومنها ما يُبغِضُ اللهُ فأمَّا الخُيلاءُ الَّتي يُحِبُّ اللهُ أنْ يتخيَّلَ العبدُ بنفسِه عندَ القتالِ وأنْ يتخيَّلَ عندَ الصَّدقةِ ",["وأمَّا الخُيلاءُ الَّتي يُبغِضُ اللهُ",2]," ",["فالخُيلاءُ لغيرِ الدِّينِ",1],"]"],"grade":"صحيح","narrator":"[عتيك الأنصاري]","muhaddith":"صحيح","bab":"جهاد › استحباب الخيلاء في الحرب","dorar":"hbPVovb7","merged":6,"otherRefs":["صحيح ابن حبان 4762 (صحيح)","الأحكام الوسطى 3/ 55 (صحيح)","تخريج المسند لشعيب 23750 (حسن)","تخريج مشكل الآثار 4576 (حسن)","تخريج المسند لشعيب 23748 (حسن)"]},{"id":"ق-0215","fp":"faf8f56299ca","stateId":282,"easy":"الاختيال والفخر ← لا يحبه الله","cause":"الاختيال والفخر","result":"لا يحبه الله","explicit":true,"star":true,"similar":["ق-0974","ق-1306"],"ref":"سورة النساء: 36","srcLabel":"القرآن الكريم","quran":{"s":4,"from":36,"to":36,"text":"وَاعْبُدُوا اللَّهَ وَلَا تُشْرِكُوا بِهِ شَيْئًا وَبِالْوَالِدَيْنِ إِحْسَانًا وَبِذِي الْقُرْبَى وَالْيَتَامَى وَالْمَسَاكِينِ وَالْجَارِ ذِي الْقُرْبَى وَالْجَارِ الْجُنُبِ وَالصَّاحِبِ بِالْجَنْبِ وَابْنِ السَّبِيلِ وَمَا مَلَكَتْ أَيْمَانُكُمْ إِنَّ اللَّهَ لَا يُحِبُّ مَنْ كَانَ مُخْتَالًا فَخُورًا (36)","hl":[[249,305,1]]}},{"id":"ق-0381","fp":"b54e29e4f46a","stateId":282,"easy":"الإسراف ← لا يحبه الله","cause":"الإسراف","result":"لا يحبه الله","explicit":true,"star":true,"similar":["ق-0398"],"ref":"سورة الأنعام: 141","srcLabel":"القرآن الكريم","quran":{"s":6,"from":141,"to":141,"text":"وَهُوَ الَّذِي أَنْشَأَ جَنَّاتٍ مَعْرُوشَاتٍ وَغَيْرَ مَعْرُوشَاتٍ وَالنَّخْلَ وَالزَّرْعَ مُخْتَلِفًا أُكُلُهُ وَالزَّيْتُونَ وَالرُّمَّانَ مُتَشَابِهًا وَغَيْرَ مُتَشَابِهٍ كُلُوا مِنْ ثَمَرِهِ إِذَا أَثْمَرَ وَآتُوا حَقَّهُ يَوْمَ حَصَادِهِ وَلَا تُسْرِفُوا إِنَّهُ لَا يُحِبُّ الْمُسْرِفِينَ (141)","hl":[[245,296,1]]}},{"id":"ق-0398","fp":"5b6900611c05","stateId":282,"easy":"الإسراف ← لا يحبه الله","cause":"الإسراف","result":"لا يحبه الله","explicit":true,"repOf":"ق-0381","ref":"سورة الأعراف: 31","quran":{"s":7,"from":31,"to":31,"text":"يَا بَنِي آدَمَ خُذُوا زِينَتَكُمْ عِنْدَ كُلِّ مَسْجِدٍ وَكُلُوا وَاشْرَبُوا وَلَا تُسْرِفُوا إِنَّهُ لَا يُحِبُّ الْمُسْرِفِينَ (31)","hl":[[78,129,1]]}},{"id":"ق-0663","fp":"2cd5c7f262cd","stateId":282,"easy":"الاستكبار ← لا يحبه الله","cause":"الاستكبار","result":"لا يحبه الله","explicit":true,"ref":"سورة النحل: 23","srcLabel":"القرآن الكريم","quran":{"s":16,"from":23,"to":23,"text":"لَا جَرَمَ أَنَّ اللَّهَ يَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِنُونَ إِنَّهُ لَا يُحِبُّ الْمُسْتَكْبِرِينَ (23)","hl":[[67,105,1]]}},{"id":"ق-0974","fp":"e1034c254dd0","stateId":282,"easy":"الاختيال والفخر ← لا يحبه الله","cause":"الاختيال والفخر","result":"لا يحبه الله","explicit":true,"repOf":"ق-0215","ref":"سورة لقمان: 18","quran":{"s":31,"from":18,"to":18,"text":"وَلَا تُصَعِّرْ خَدَّكَ لِلنَّاسِ وَلَا تَمْشِ فِي الْأَرْضِ مَرَحًا إِنَّ اللَّهَ لَا يُحِبُّ كُلَّ مُخْتَالٍ فَخُورٍ (18)","hl":[[69,118,1]]}},{"id":"ق-1306","fp":"94ad02a92880","stateId":282,"easy":"الاختيال والفخر ← لا يحبه الله","cause":"الاختيال والفخر","result":"لا يحبه الله","explicit":true,"repOf":"ق-0215","ref":"سورة الحديد: 23","quran":{"s":57,"from":23,"to":23,"text":"لِكَيْلَا تَأْسَوْا عَلَى مَا فَاتَكُمْ وَلَا تَفْرَحُوا بِمَا آتَاكُمْ وَاللَّهُ لَا يُحِبُّ كُلَّ مُخْتَالٍ فَخُورٍ (23)","hl":[[72,117,1]]}},{"id":"س-06003","fp":"fa684d56f645","stateId":282,"easy":"إذا افتخرت بآبائك الموتى ← تكون أهون على الله من الجُعل","cause":"يَفتخِرُونَ بآبائِهمْ الذين ماتُوا","result":"أوْ ليَكونُنَّ أهْونَ على اللهِ من الجُعْلِ","explicit":true,"otherNeedIds":[44],"ref":"صحيح الجامع 5482","srcLabel":"الترمذي","text":["لَيَنْتَهِيَنَّ أقوامٌ ",["يَفتخِرُونَ بآبائِهمْ الذين ماتُوا",1]," ، إنَّما هُمْ فحْمُ جهَنَّمَ ، ",["أوْ ليَكونُنَّ أهْونَ على اللهِ من الجُعْلِ",2]," الّذِي يُدَهْدِهُ الخَرَءَ  بِأنْفِهِ ، إنَّ اللهَ أذْهبَ عنْكُمْ عُبِّيَّةَ الجاهليَّةِ وفخْرَها بالآباءِ ، إنَّما هوَ مُؤمِنٌ تقِيٌّ ، أوْ فاجِرٌ شقِيٌّ ، الناسُ كلُّهُمْ بَنو آدَمَ ، وآدَمُ خُلِقَ من التُّرابِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3955)","bab":"رقائق وزهد › تقوى الله","dorar":"mCS9li60","merged":5,"otherRefs":["صحيح الجامع 4568 (صحيح)","إتحاف الخيرة المهرة 6/81 (حسن)","تخريج المسند لشعيب 8792 (حسن)","تخريج سنن أبي داود 5116 (صحيح)"]},{"id":"س-05974","fp":"eb92a48829f5","stateId":282,"easy":"إذا أسبلت إزارك ← فهو من المخيلة والله لا يحبها","cause":"وإسبالَ الإزارِ","result":"فإنَّها مِنَ المَخيلةِ، واللهُ لا يُحِبُّ المَخيلةَ","explicit":true,"similar":["س-05725","س-07118","س-00166"],"ref":"تخريج المسند لشعيب 23205","srcLabel":"أحمد","text":["عن رَجُلٍ: أنَّه أتى رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم  -أو قال: شَهِدتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم وأتاهُ رَجُلٌ- فقال: أنتَ رَسولُ اللهِ؟ أو قال: أنتَ مُحَمَّدٌ؟ فقال: «نَعَم»، قال: فِإلامَ تَدعو؟ قال: «أدعو إلى اللهِ وحدَه؛ مَن إذا كان بكَ ضُرٌّ فدَعَوتَه كَشَفَه عنكَ، ومَن إذا أصابَكَ عامُ سَنةٍ فدَعَوتَه أنبَتَ لَكَ، ومَن إذا كُنتَ في أرضٍ قَفرٍ فأضلَلتَ فدَعَوتَه رَدَّ عليكَ»، قال: فأسلَمَ الرَّجُلُ، ثُمَّ قال: أوصِني يا رَسولَ اللهِ؟ فقال له: «لا تَسُبَّنَّ شَيئًا» -أو قال أحَدًا: شَكَّ الحَكَمُ- قال: فما سَبَبتُ شَيئًا بَعيرًا ولا شاةً مُنذُ أوصاني رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، «ولا تَزهَدْ في المَعروفِ ولَو ببَسطِ وجهكَ إلى أخيكَ وأنتَ تُكَلِّمُه، وأفرِغْ مِن دَلوِكَ في إناءِ المُستَسقي، واتَّزِرْ إلى نِصفِ السَّاقِ، فإن أبَيتَ فإلى الكَعبَينِ، وإيَّاكَ ",["وإسبالَ الإزارِ",1],"؛ ",["فإنَّها مِنَ المَخيلةِ، واللهُ لا يُحِبُّ المَخيلةَ",2],"»."],"grade":"صحيح","narrator":"رجل من قوم أبي تميمة","muhaddith":"صحيح","bab":"رقائق وزهد › الوصايا النافعة","dorar":"xhoAxwGh","merged":4,"otherRefs":["تخريج مشكل الآثار 3370 (صحيح)","تخريج صحيح ابن حبان 521 (صحيح)","السلسلة الصحيحة 770 (صحيح)"]},{"id":"س-00162","fp":"a77064a4ad00","stateId":282,"easy":"إذا اختلت وتكبرت ← فالله لا يحب المخيلة","cause":"المَخِيلةِ","result":"وإنَّ اللهَ لا يُحِبُّ","explicit":true,"ref":"الأحكام الوسطى 4/ 262","srcLabel":"أبو داود","text":["رَأيْتُ رَجُلًا يَصدُرُ النَّاسُ عن رأيِه لا يقولُ شَيئًا إلَّا صَدَروا عنه، قُلْنا: مَن هذا؟ قالوا: رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، قُلْتُ: عليك السَّلامُ يا رَسولَ اللهِ، مَرَّتَينِ، قالَ: \"لا تَقُلْ: عليك السَّلامُ؛ فإنَّ عليك السَّلامُ تَحيَّةُ المَيِّتِ، قُل: السَّلامُ عليكم\"، قالَ: قُلْتُ: أنت رَسولُ اللهِ؟ قالَ: \"أنا رَسولُ اللهِ الَّذي إذا أَصابَك ضُرٌّ فدَعَوْتَه كَشَفَه عنك، وإذا أصَابَك عامُ سَنةٍ فدَعَوْتَه أَنبَتَها لك، وإذا كنْتَ بأرْضٍ قَفْرٍ وفَلاةٍ فضَلَّتْ راحِلتَك فدَعَوْتَه رَدَّها عليك\"، قالَ: قُلْتُ: اعْهَدْ إليَّ، قالَ: لا تَسُبَّنَّ أحَدًا\"؛ فما سَبَبْتُ بَعْدَه حُرًّا ولا عَبْدًا، ولا بَعيرًا ولا شاةً، قالَ: \"ولا تَحْقِرَنَّ شَيئًا مِن المَعْروفِ، وأن تُكلِّمَ أخاك وأنت مُنْبسِطٌ إليه وَجْهُك إنَّ ذلك مِن المَعْروفِ، وارْفَعْ إزارَك إلى نِصْفِ السَّاقِ، فإن أَبَيْتَ فإلى الكَعْبَينِ، وإيَّاك وإسْبالَ الإزارِ؛ فإنَّها مِن ",["المَخِيلةِ",1],"، ",["وإنَّ اللهَ لا يُحِبُّ",2]," المَخِيلةَ، وإن امْرِؤٌ شَتَمَك أو عَيَّرَك بما يَعلَمُ فيك فلا تُعَيِّرْه بما تَعلَمُ فيه؛ فإنَّما وَبالُ ذلك عليه\".\n وقالَ النَّسائيُّ: \"يكونُ أجْرُ ذلك لك، ووَبالُه عليه\"."],"grade":"صحيح","narrator":"جابر بن سليم","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (4084)، والبيهقي في ((الآداب)) (124) واللفظ لهما، والترمذي (2721) بنحوه","bab":"آداب السلام › كيفية السلام","dorar":"Bj2p7CrS","merged":3,"otherRefs":["تخريج المسند لشعيب 20636 (صحيح)","تخريج المسند لشعيب 20632 (صحيح)"]},{"id":"س-06206","fp":"44f756c33259","stateId":282,"easy":"إذا أسبلت ← فالله لا يحب المسبلين","cause":"لا تُسبِلْ","result":"فإنَّ اللَّهَ لا يُحبُّ المسبِلينَ","explicit":true,"ref":"مصباح الزجاجة 4/85","srcLabel":"ابن ماجه","text":["يا سُفيانُ بنَ سَهْلٍ، ",["لا تُسبِلْ",1]," ",["فإنَّ اللَّهَ لا يُحبُّ المسبِلينَ",2]],"grade":"صحيح","narrator":"المغيرة بن شعبة","muhaddith":"إسناده صحيح رجاله ثقات وله شاهد","takhrij":"أخرجه ابن ماجه (3574) واللفظ له، وأحمد (18151) باختلاف يسير","bab":"زينة اللباس › ما نهي عنه من اللباس","dorar":"hrwn1SxR","merged":3,"otherRefs":["نيل الأوطار 2/113 (حسن)","مجمع الزوائد 5/127 (حسن)"]},{"id":"س-05707","fp":"6ffc4d821894","stateId":282,"easy":"إذا كنت فخوراً مختالاً ← تكون ممن يبغضهم الله","cause":"الفَخورُ المُخْتالُ، وأنتم تَجِدونَ في كِتابِ اللهِ عَزَّ وجَلَّ: {إِنَّ اللَّهَ لا يُحِبُّ كُلَّ مُخْتَالٍ فَخُورٍ}، والبَخيلُ المَنَّانُ، والتَّاجِرُ والبَيَّاعُ الحَلَّافُ","result":"وثَلاثةٌ يُبغِضُهم اللهُ عَزَّ وجَلَّ","explicit":true,"ref":"الصحيح المسند 272","srcLabel":"الترمذي","text":["عن مُطَرِّفِ بنِ عَبْدِ اللهِ بنِ الشِّخِّيرِ قالَ: بَلَغَني عن أبي ذَرٍّ حَديثٌ، فكُنْتُ أُحِبُّ أن أَلْقاه، فلَقِيتُه، فقُلْتُ له: يا أبا ذَرٍّ، بَلَغَني عنك حَديثٌ، فكُنْتُ أُحِبُّ أن أَلْقاك فأَسأَلَك عنه، فقالَ: قد لَقيْتَ فاسْأَلْ، قالَ: قُلْتُ: بَلَغَني أنَّك تقولُ: سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ يقولُ: «ثَلاثةٌ يُحِبُّهم اللهُ عَزَّ وجَلَّ، ",["وثَلاثةٌ يُبغِضُهم اللهُ عَزَّ وجَلَّ",2],"»، قالَ: نَعمْ، فما إخالُني أَكذِبُ على خَليلي مُحمَّدٍ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ ثَلاثًا يَقولُها، قالَ: قُلْتُ: مَن الثَّلاثةُ الَّذين يُحِبُّهم اللهُ عَزَّ وجَلَّ، قالَ: «رَجُلٌ غَزا في سَبيلِ اللهِ فلَقِيَ العَدُوَّ مُجاهِدًا مُحْتَسِبًا، فقاتَلَ حتَّى قُتِلَ، وأنتم تَجِدونَ في كِتابِ اللهِ عَزَّ وجَلَّ: {إِنَّ اللَّهَ يُحِبُّ الَّذِينَ يُقَاتِلُونَ فِي سَبِيلِهِ صَفًّا}، ورَجُلٌ له جارٌ يُؤْذيه فيَصبِرُ على أذاه، ويَحْتَسِبُه حتَّى يَكْفيه اللهُ إيَّاه بمَوْتٍ أو حَياةٍ، ورَجُلٌ يكونُ معَ قَوْمٍ فيَسيرونَ حتَّى يَشُقَّ عليهم الكَرى -أو النُّعاسُ- فيَنزِلونَ في آخِرِ اللَّيْلِ، فيَقومُ إلى وَضوئِه وصَلاتِه»، قالَ: قُلْتُ: مَن الثَّلاثةُ الَّذين يُبغِضُهم اللهُ؟ قالَ: «",["الفَخورُ المُخْتالُ، وأنتم تَجِدونَ في كِتابِ اللهِ عَزَّ وجَلَّ: {إِنَّ اللَّهَ لا يُحِبُّ كُلَّ مُخْتَالٍ فَخُورٍ}، والبَخيلُ المَنَّانُ، والتَّاجِرُ والبَيَّاعُ الحَلَّافُ",1],"»، قالَ: قُلْتُ: يا أبا ذَرٍّ، ما المالُ؟ قالَ: فِرْقٌ لنا وذَوْدٌ -يَعْني بالفِرْقِ غَنَمًا يَسيرةً- قالَ: قُلْتُ: لسْتُ عن هذا أَسأَلُ، إنَّما أَسأَلُك عن صامِتِ المالِ، قالَ: ما أَصبَحَ لا أَمْسى، وما أَمْسى لا أَصبَحَ، قالَ: قُلْتُ: يا أبا ذَرٍّ، ما لك ولإخوَتِك قُرَيْشٍ، قالَ: واللهِ لا أَسأَلُهم دُنْيا، ولا أَسْتَفْتيهم عن دينِ اللهِ تَبارَكَ وتَعالى حتَّى أَلْقى اللهَ ورَسولَه، ثَلاثًا يَقولُها."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2568)، والنسائي (2570)، وأحمد (21355)، وابن خزيمة (2456) واللفظ لهم.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"3HEcsZeh","merged":2,"otherRefs":["المستدرك على الصحيحين 2481 (صحيح)"]},{"id":"س-01129","fp":"59843e0f6fd3","stateId":282,"easy":"إذا قيل لك «اتقِ الله» فقلت «عليك نفسك» ← فهو أبغض الكلام إلى الله","cause":"أن يقولَ الرَّجلُ للرَّجلِ : اتَّقِ اللَّهَ ، فيقولُ عليكَ نفسَكَ","result":"وإنَّ أبغضَ الكلامِ إلى اللَّهِ","explicit":true,"ref":"السلسلة الصحيحة 2939","srcLabel":"النسائي","text":["إنَّ أحبَّ الكلامِ إلى اللَّهِ أن يقولَ العبدُ : سبحانَكَ اللَّهمَّ وبحمدِكَ ، وتبارَكَ اسمُكَ ، وتعالى جدُّكَ ، ولا إلَهَ غيرُكَ ، ",["وإنَّ أبغضَ الكلامِ إلى اللَّهِ",2]," ",["أن يقولَ الرَّجلُ للرَّجلِ : اتَّقِ اللَّهَ ، فيقولُ عليكَ نفسَكَ",1]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح رجاله ثقات","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10685)، والبيهقي في ((شعب الإيمان)) (630)، وقوام السنة في ((الترغيب والترهيب)) (766)","bab":"أدعية وأذكار › فضل الذكر","dorar":"kYlnAznC"},{"id":"س-03124","fp":"d3a713ab9a25","stateId":282,"easy":"إذا اختلت كبراً ← فهي خيلاء يبغضها الله","cause":"والمَخيلةُ في الكبرِ","result":"يُبغِضُها اللَّهُ","explicit":true,"ref":"صحيح ابن خزيمة 4/ 190","srcLabel":"أحمد","text":["غَيرتانِ إحداهُما يحبُّها اللَّهُ، والأُخرَى يبغضُها اللَّهُ: الغيرةُ في الرِّيبةِ يُحبُّها اللَّهُ والغَيرةُ في غيرِ ريبةٍ يبغضُها اللَّهُ، والمَخيلةُ إذا تَصدَّقَ الرَّجلُ يُحبُّها اللَّهُ، ",["والمَخيلةُ في الكبرِ",1]," ",["يُبغِضُها اللَّهُ",2],". وقالَ: ثلاثةٌ تستجابُ دعوتُهُمُ، الوالدُ والمُسافرُ والمَظلومُ وقالَ: إنَّ اللَّهَ يدخلُ الجنَّةَ بالسَّهمِ الواحدِ ثلاثةً، صانعَهُ والممدَّ بِهِ، والرَّاميَ بِهِ في سَبيلِ اللَّهِ"],"grade":"صحيح","narrator":"عقبة بن عامر الجهني","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (17398)، والروياني في ((المسند)) (186)، والحاكم (1525) واللفظ لهم.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"CFBRAfYL"},{"id":"س-05725","fp":"2eb1ff95741e","stateId":282,"easy":"إذا أسبلت إزارك ← فهو من المخيلة والله لا يحبها","cause":"وإيَّاكَ و إسبالَ الإزارِ","result":"فإنَّ إسبالَهُ من المخيَلَةِ و إنَّ اللهَ لا يحبُّ المخيَلةَ ارفَع إزارَكَ إلى نصفِ السَّاقِ فإن أبيتَ فإلى الكَعبينِ وإن امرُؤٌ شتَمكَ بما يعلَمُ منكَ فلا تَشتُمهُ بما","explicit":true,"repOf":"س-05974","ref":"الفتوحات الربانية 5/322","text":["قلتُ : يا رسولَ اللَّهِ عَليكَ السَّلامُ, قال : لا تَقُلْ : عليكَ السَّلامُ ، فإنَّ عليكَ السَّلامُ تحيَّةُ المَوتَى قلتُ : أنتَ رسولُ اللَّهِ قالَ : أَنا رسولُ اللَّهِ الَّذي إذا أصابَكَ ضرٌّ فدَعوتَهُ كشفَ عنكَ و إذا أصابَكَ سيِّئةٌ دعوتَهُ فأسهَلَ لكَ فقلتُ : اعهَد إليَّ عهدًا , قالَ : لا تَسبَّنَّ أحدًا و لا تحقِرَنَّ من المعروفِ شيئًا وأن تُكلِّمَ أخاكَ وأنتَ مُنبسطٌ إليهِ ",["وإيَّاكَ و إسبالَ الإزارِ ",1],["فإنَّ إسبالَهُ من المخيَلَةِ و إنَّ اللهَ لا يحبُّ المخيَلةَ ارفَع إزارَكَ إلى نصفِ السَّاقِ فإن أبيتَ فإلى الكَعبينِ وإن امرُؤٌ شتَمكَ بما يعلَمُ منكَ فلا تَشتُمهُ بما",2]," تَعلَمُ منهُ فإنَّ وبالَ ذلكَ عليه"],"grade":"صحيح","narrator":"جابر بن سليم أبو جري الهجيمي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5209)، والترمذي (2722) باختلاف يسير، والنسائي في ((السنن الكبرى)) (10149) مختصراً","bab":"رقائق وزهد › الكبر والتواضع","dorar":"hhBfvWsX"},{"id":"س-07118","fp":"67d434761d91","stateId":282,"easy":"إذا أسبلت إزارك ← فهو من الخيلاء والله لا يحبها","cause":"وإيَّاكَ وتَسبيلَ الإزارِ","result":"فإنَّه مِنَ الخُيَلاءِ، والخُيَلاءَ لا يُحِبُّها اللهُ، وإنِ امرُؤٌ سَبَّكَ بما يَعلَمُ فيكَ","explicit":true,"repOf":"س-05974","ref":"تخريج المسند لشعيب 20634","text":["عن أبي جُرَيٍّ الهُجَيميِّ، أنَّه أتى رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم في أُناسٍ مِن أهلِ الباديةِ، فقالوا: إنَّا مِن أهلِ الباديةِ، فذَكَرَ الحَديثَ [ عن أبي جُرَيٍّ الهُجَيميِّ، قال: أتَيتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم: فقُلتُ: يا رَسولَ اللهِ، إنَّا قَومٌ مِن أهلِ الباديةِ، فعَلِّمْنا شَيئًا يَنفَعُنا اللهُ به، قال: «لا تَحقِرَنَّ مِنَ المَعروفِ شَيئًا، ولَو أن تُفرِغَ مِن دَلوِكَ في إناءِ المُستَسقي، ولَو أن تُكَلِّمَ أخاكَ ووَجهُكَ إليه مُنبَسِطٌ، ",["وإيَّاكَ وتَسبيلَ الإزارِ؛ ",1],["فإنَّه مِنَ الخُيَلاءِ، والخُيَلاءَ لا يُحِبُّها اللهُ، وإنِ امرُؤٌ سَبَّكَ بما يَعلَمُ فيكَ",2],"] إلَّا أنَّه قال: \"فلا تَشتُمْه بما تَعلَمُ فيه؛ فإنَّ أجرَ ذلك لَكَ، ووبالَه عليه \""],"grade":"صحيح","narrator":"أبو جرى الهجيمي","muhaddith":"إسناده صحيح","bab":"علم › تعليم الناس وفضل ذلك","dorar":"B4MQJZIJ"},{"id":"س-07985","fp":"eaca2eee7a99","stateId":282,"easy":"إذا تكبّرت وتجبّرت ونسيت الكبير المتعال ← فبئس العبد أنت","cause":"عبْدٌ تَخَيَّلَ واختالَ، ونسِيَ الكبيرَ المُتعالِ! بِئسَ العبدُ عَبْدٌ تَجبَّرَ واعتَدَى، ونَسِيَ الجبَّارَ الأعلى! بِئسَ العبدُ عبْدٌ سَهَا ولَهَا، ونَسِيَ المَقابرَ والبِلَى! بِئسُ العبدُ عبْدٌ عَتَا وطَغى، ونَسِيَ المُبتدأَ والمُنتهَى! بِئسَ العبدُ عبْدٌ يَختِلُ الدُّنيا بالدِّينِ! بِئسَ العبدُ عبْدٌ يَختِلُ الدِّينَ بالشُّبهاتِ! بِئسَ العبدُ عبْدٌ طَمَعٌ يَقودُه! بِئسَ العبدُ عبْدٌ هَوًى يُضِلُّه! بِئسَ العبدُ عبْدٌ رَغَبٌ يُضِلُّه","result":"بِئسَ العبدُ","explicit":true,"ref":"هداية الرواة 4/475","srcLabel":"الترمذي","text":[["بِئسَ العبدُ",2]," ",["عبْدٌ تَخَيَّلَ واختالَ، ونسِيَ الكبيرَ المُتعالِ! بِئسَ العبدُ عَبْدٌ تَجبَّرَ واعتَدَى، ونَسِيَ الجبَّارَ الأعلى! بِئسَ العبدُ عبْدٌ سَهَا ولَهَا، ونَسِيَ المَقابرَ والبِلَى! بِئسُ العبدُ عبْدٌ عَتَا وطَغى، ونَسِيَ المُبتدأَ والمُنتهَى! بِئسَ العبدُ عبْدٌ يَختِلُ الدُّنيا بالدِّينِ! بِئسَ العبدُ عبْدٌ يَختِلُ الدِّينَ بالشُّبهاتِ! بِئسَ العبدُ عبْدٌ طَمَعٌ يَقودُه! بِئسَ العبدُ عبْدٌ هَوًى يُضِلُّه! بِئسَ العبدُ عبْدٌ رَغَبٌ يُضِلُّه",1],"!"],"grade":"صحيح","narrator":"أسماء بنت عميس","muhaddith":"صححه الحاكم فوهم","takhrij":"أخرجه الترمذي (2448) واللفظ له مطولاً، والطبراني (24/156) (401)، والحاكم (7885) باختلاف يسير مطولاً","bab":"مظالم › تحريم الظلم","dorar":"VlEO356d"},{"id":"س-00166","fp":"d2398ef7375d","stateId":282,"easy":"إذا أسبلت إزارك ← فإن الله لا يحب كل مختال فخور","cause":"فسَألْتُه عنِ الإزارِ، فأقْنَعَ ظَهْرَه، وأخَذَ بمُعظَمِ ساقِه، فقال: هاهنا، فإنْ أبيْتَ فهاهُنَا فوقَ الكَعْبَينِ، فإنْ أبيتَ","result":"فإنَّ اللهَ لا يُحِبُّ كُلَّ مُختالٍ فَخورٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-05974","ref":"المستدرك على الصحيحين 7586","text":["لَقِيتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ في بعْضِ طُرُقِ المدينةِ، وعليه إزارٌ مِن قُطنٍ مُنتَشِرُ الحاشيةِ، قلْتُ: عليكَ السَّلامُ يا مُحمَّدُ -أو يا رسولَ اللهِ- فقالَ: عليكَ السَّلامُ تحيَّةُ المَيِّتِ، عليكَ السَّلامُ تحيَّةُ الميِّتِ، عليكَ السَّلامُ تحيَّةُ الميِّتِ، سَلامٌ عليكُمْ، سَلامٌ عليكُمْ، سلامٌ علَيْكُم، أي: هكذا فقُلْ، قالَ: ",["فسَألْتُه عنِ الإزارِ، فأقْنَعَ ظَهْرَه، وأخَذَ بمُعظَمِ ساقِه، فقال: هاهنا، فإنْ أبيْتَ فهاهُنَا فوقَ الكَعْبَينِ، فإنْ أبيتَ",1]," ",["فإنَّ اللهَ لا يُحِبُّ كُلَّ مُختالٍ فَخورٍ",2],"."],"grade":"صحيح","narrator":"جابر بن سليم الهجيمي","muhaddith":"صحيح الإسناد","bab":"آداب السلام › كيفية السلام","dorar":"lpOUaOen"},{"id":"س-00167","fp":"ad935e5eb66a","stateId":282,"easy":"إذا أسبلت إزارك فوق الكعبين ← فإن الله لا يحب كل مختال فخور","cause":"فإن أبَيتَ فهاهُنا فوقَ الكَعبَينِ، فإن أبَيتَ","result":"فإنَّ اللهَ عَزَّ وجَلَّ لا يُحِبُّ كُلَّ مُختالٍ فخورٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشعيب 15955","srcLabel":"أحمد","text":["«إنَّ عليكَ السَّلامَ تَحيَّةُ المَوتى، إنَّ عليكَ السَّلامَ تَحيَّةُ المَوتى، إنَّ عليكَ السَّلامَ تَحيَّةُ المَوتى، سَلامٌ عليكُم، سَلامٌ عليكُم» مَرَّتَينِ أو ثَلاثًا، هَكَذا قال. سَألتُ عنِ الإزارِ؟ فقُلتُ: أينَ أتَّزِرُ؟ فأقنَعَ ظَهرَه بعَظمِ ساقِه، وقال: «هاهُنا اتَّزِرْ، فإن أبَيتَ فهاهُنا أسفَلَ مِن ذلك، ",["فإن أبَيتَ فهاهُنا فوقَ الكَعبَينِ، فإن أبَيتَ",1]," ",["فإنَّ اللهَ عَزَّ وجَلَّ لا يُحِبُّ كُلَّ مُختالٍ فخورٍ",2],"» قال: وسَألتُه عنِ المَعروفِ؟ فقال: «لا تَحقِرَنَّ مِنَ المَعروفِ شَيئًا، ولَو أن تُعطيَ صِلةَ الحَبلِ، ولَو أن تُعطيَ شِسعَ النَّعلِ، ولَو أن تَنزِعَ مِن دَلوِكَ في إناءِ المُستَسقي، ولَو أن تُنَحِّيَ الشَّيءَ مِن طَريقِ النَّاسِ يُؤذيهم، ولَو أن تَلقى أخاكَ ووَجهُكَ إليه مُنطَلِقٌ، ولَو أن تَلقى أخاكَ فتُسَلِّمَ عليه، ولَو أن تُؤنِسَ الوَحشانَ في الأرضِ، وإن سَبَّكَ رَجُلٌ بشَيءٍ يَعلَمُه فيكَ، وأنتَ تَعلَمُ فيه نَحوَه، فلا تَسُبَّه؛ فيَكونَ أجرُه لَكَ، ووِزرُه عليه، وما سَرَّ أُذُنَكَ أن تَسمَعَه فاعمَلْ به، وما ساءَ أُذُنَكَ أن تَسمَعَه فاجتَنِبْه»."],"grade":"صحيح","narrator":"رجل من قوم أبي تميمة الهجيمي","muhaddith":"إسناده صحيح","bab":"آداب السلام › كيفية السلام","dorar":"Gyr63hi4"},{"id":"س-04806","fp":"24a41a7b724c","stateId":282,"easy":"إذا كنت فظاً مستكبراً ← فأنت من شر عباد الله","cause":"الفَظُّ المستكبرُ","result":"أَلا أُخبرُكم بشرِّ عبادِ الله","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[13],"ref":"صحيح الترغيب 2904","srcLabel":"أحمد","text":[["أَلا أُخبرُكم بشرِّ عبادِ الله ",2],"؟ ",["الفَظُّ المستكبرُ",1]," . ألا أخبركم بخيرِ عبادِ اللهِ ؟ الضعيفُ المستضْعَفُ ، ذو الطِّمرَينِ ، لايُؤبَه له ، لو أقسمَ على اللهِ لأَبَرَّه ."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (23457) في أوله قصة، باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"lLdXwiyY"},{"id":"س-00354","fp":"2191cd3b0d1b","stateId":283,"easy":"إذا لعنت والديك ← فهو من أكبر الكبائر","cause":"أن يَلعَنَ الرَّجُلُ والِدَيه","result":"إنَّ مِن أكبَرِ الكَبائِرِ","explicit":true,"star":true,"otherNeedIds":[13],"ref":"صحيح البخاري 5973","srcLabel":"مسلم","text":[["إنَّ مِن أكبَرِ الكَبائِرِ",2],[" أن يَلعَنَ الرَّجُلُ والِدَيه",1],". قيلَ: يا رَسولَ اللهِ، وكيفَ يَلعَنُ الرَّجُلُ والِدَيه؟! قال: يَسُبُّ الرَّجُلُ أبا الرَّجُلِ، فيَسُبُّ أباه، ويَسُبُّ أُمَّه."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (90) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"SmTiF7UM","merged":3,"otherRefs":["تخريج مشكل الآثار 899 (صحيح)","صحيح الأدب المفرد 21 (صحيح)"]},{"id":"س-00410","fp":"cb0a7615c9db","stateId":283,"easy":"إذا سببت والدي غيرك فسبّوا والديك ← فكأنك لعنت والديك","cause":"أن يلعَنَ الرَّجُلُ والدَيهِ فاستَغرَبَ القَومُ أن يلعَنَ رجلٌ عاقِلٌ مُؤمِنٌ وَالِدَيهِ و هُما سبَبُ حياتِهِ فقالوا: و كيفَ يلعَنُ الرَّجل والدَيهِ","result":"إنَّ مِن أكبرِ الكبائرِ","explicit":true,"star":true,"otherNeedIds":[13],"ref":"غاية المرام 280","srcLabel":"متفق عليه","text":[["إنَّ مِن أكبرِ الكبائرِ",2],[" أن يلعَنَ الرَّجُلُ والدَيهِ فاستَغرَبَ القَومُ أن يلعَنَ رجلٌ عاقِلٌ مُؤمِنٌ وَالِدَيهِ و هُما سبَبُ حياتِهِ فقالوا: و كيفَ يلعَنُ الرَّجل والدَيهِ ",1],"؟ قال: يَسبُّ أبا الرَّجُلِ فيسبُّ أباهُ و يسُبُّ أمَّهُ فيَسُبُّ أمَّهُ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5973)، ومسلم (90) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"A4sYXA1l"},{"id":"س-03148","fp":"1edb50877235","stateId":283,"easy":"إذا طلّقت ← فهو أبغض الحلال إلى الله","cause":"الطَّلاقِ","result":"ليْس شَيءٌ مِن الحلالِ أبغَضَ إلى اللهِ","explicit":true,"otherNeedIds":[13],"ref":"أسنى المطالب 7/59","srcLabel":"أسنى المطالب","text":[["ليْس شَيءٌ مِن الحلالِ أبغَضَ إلى اللهِ",2]," مِن ",["الطَّلاقِ",1],"."],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"إيمان › توحيد الأسماء والصفات","dorar":"oD7cbfnO","merged":2,"otherRefs":["الروضة الندية 2/59 (صحيح)"]},{"id":"س-06381","fp":"30f2e61c3268","stateId":283,"easy":"إذا عققت ← فالله لا يحب العقوق","cause":"العُقوقَ وَكَأنَّهُ كرِهَ الاسمَ قالوا : يا رَسولَ اللَّهِ إنَّما نَسألُكَ عن أحدِنا يولَدُ لَهُ","result":"إنَّ اللَّهَ لا يُحبُّ","explicit":true,"ref":"تخريج المسند لشاكر 11/4","srcLabel":"أبو داود","text":["سُئِلَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ عنِ العَقيقةِ ؟ فقالَ : ",["إنَّ اللَّهَ لا يُحبُّ",2],[" العُقوقَ وَكَأنَّهُ كرِهَ الاسمَ قالوا : يا رَسولَ اللَّهِ إنَّما نَسألُكَ عن أحدِنا يولَدُ لَهُ ",1],"؟ قالَ : مَن أحبَّ منكُم أن يَنسُكَ عن ولدِهِ فليفعَلْ ، عنِ الغُلامِ شاتانِ مُكافَأتانِ ، وعَنِ الجاريةِ شاةٌ قالَ : وسُئِلَ عنِ الفَرَعِ ؟ قالَ : والفَرَعُ حقٌّ ، وأن تترُكَهُ حتَّى يَكونَ شُغزبًّا أو شُغزوبًا ابنَ مخاضٍ أوِ ابنَ لبونٍ ، فتَحملَ عليهِ في سَبيلِ اللَّهِ ، أو تُعْطيَهُ أرملةً ، خيرٌ من أن تَذبحَهُ يَلصقُ لحمُهُ بوبَرِهِ ، وتُكْفئُ إناءَكَ ، وتولِهُ ناقتَكَ ، وقالَ : وسُئِلَ عنِ العتيرةِ ؟ فقالَ : العَتيرةُ حقٌّ قالَ : بَعضُ القومِ لعَمرو بنِ شُعَيْبٍ : ما العَتيرةُ ؟ قالَ : كانوا يذبَحونَ في رَجبٍ شاةً فيَطبُخونَ ويأكُلونَ ويَطعَمونَ"],"grade":"صحيح","narrator":"[جد عمرو بن شعيب]","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2842) باختلاف يسير، والنسائي (4212) مختصراً، وأحمد (6713) واللفظ له.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"Aa79nJQQ","merged":2,"otherRefs":["السلسلة الصحيحة 1655 (صحيح)"]},{"id":"س-01338","fp":"5a773b94de3b","stateId":283,"easy":"إذا أكثرت الزواج والطلاق للتذوق ← فالله لا يحب الذوّاقين والذوّاقات","cause":"الذَّوَّاقينَ ولا الذَّوَّاقاتِ","result":"إنَّ اللهَ لا يُحِبُّ","explicit":true,"ref":"الأحكام الوسطى 3/ 187","srcLabel":"الطبراني","text":["لا يُطلَّقُ النِّساءُ إلَّا مِن ريبةٍ؛ ",["إنَّ اللهَ لا يُحِبُّ",2]," ",["الذَّوَّاقينَ ولا الذَّوَّاقاتِ",1],"."],"grade":"صحيح","narrator":"أبو موسى","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه الطبراني في ((الأوسط)) (7848) بلفظه، والبزار (3064) ببعض لفظه.","bab":"نكاح › عشرة النساء","dorar":"hyhV8TVW"},{"id":"س-05198","fp":"add46a74b382","stateId":283,"easy":"إذا أوصيت بكل مالك وحرمت ورثتك ← فهو جور (من واقعة)","cause":"أعتَقَ ستةَ أَعبُدٍ عندَ موتِه، لم يكُنْ له مالٌ غيرُهم","result":"لو شَهدتُهُ قبلَ أن يُدفَنَ ، لم يُدفَن في مقابرِ المسلمينَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح أبي داود 3960","srcLabel":"أبو داود","text":["أن رجلا من الأنصار؛ بمعناه [أي: بمعنى حديثِ: أنَّ رجُلًا ",["أعتَقَ ستةَ أَعبُدٍ عندَ موتِه، لم يكُنْ له مالٌ غيرُهم",1],"، فبلَغَ ذلك النبيَّ صلَّى اللهُ عليه وسلَّمَ، فقال له قولًا شديدًا، ثم دعاهم فجزَّأَهم ثلاثةَ أجزاءٍ، فأقرَعَ بينَهم، فأعتَقَ اثنينِ، وأرَقَّ أربعةً]. وقال – يعني: النبيَّ صلَّى اللهُ عليه وسلَّمَ-:  ",["لو شَهدتُهُ قبلَ أن يُدفَنَ ، لم يُدفَن في مقابرِ المسلمينَ",2]],"grade":"صحيح","narrator":"عمرو بن أخطب أبو زيد الأنصاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3960) واللفظ له، وأحمد (22892) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"iIldNDZg","merged":2,"otherRefs":["سبل الهدى والرشاد 8/376 (صحيح)"]},{"id":"س-05045","fp":"c0c8b674809c","stateId":283,"easy":"إذا هجرت أخاك ثلاثاً ← يعرض الله عنكما حتى تتكلما","cause":"هجرُ المؤمنين ثلاثًا","result":"أعرض اللهُ عزَّ وجلَّ عنهما حتَّى يتكلَّما","explicit":true,"otherNeedIds":[44],"ref":"الترغيب والترهيب 3/389","srcLabel":"الطبراني","text":["لا تدابروا ولا تقاطعوا وكونوا عبادَ اللهِ إخوانًا ",["هجرُ المؤمنين ثلاثًا",1]," فإن تكلَّما وإلَّا ",["أعرض اللهُ عزَّ وجلَّ عنهما حتَّى يتكلَّما",2]],"grade":"حسن","narrator":"أبو أيوب الأنصاري","muhaddith":"رواته ثقات إلا عبدالله بن عبدالعزيز","takhrij":"أخرجه الطبراني (4/145) (3957)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"nDT5GNQa"},{"id":"س-08330","fp":"e46b2a2a1163","stateId":284,"easy":"إذا كنت راعياً عنيفاً بمن ترعى ← فأنت شر الرعاة","cause":"الحُطَمةُ","result":"إنَّ شَرَّ الرِّعاءِ","explicit":true,"star":true,"ref":"صحيح مسلم 1830","srcLabel":"متفق عليه","text":["أنَّ عائِذَ بنَ عَمرٍو -وكانَ مِن أصحابِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم- دَخَلَ على عُبَيدِ اللهِ بنِ زيادٍ، فقال: أي بُنَيَّ، إنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["إنَّ شَرَّ الرِّعاءِ",2]," ",["الحُطَمةُ",1],"، فإيَّاك أن تَكونَ منهم، فقال له: اجلِسْ؛ فإنَّما أنتَ مِن نُخالةِ أصحابِ مُحَمَّدٍ صلَّى اللهُ عليه وسلَّم، فقال: وهل كانَت لهم نُخالةٌ؟! إنَّما كانَتِ النُّخالةُ بَعدَهم، وفي غيرِهم."],"grade":"صحيح","narrator":"عائذ بن عمرو","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"niYxNVVF"},{"id":"س-07448","fp":"e0e6d4976ed4","stateId":284,"easy":"إذا كنت إماماً جائراً ← تكون أبغض الناس إلى الله وأبعدهم منه","cause":"إمامٌ جائِرٌ","result":"وأَبغَضَ النَّاسِ إلى اللهِ وأَبعَدَهم مِنه مَجلِسًا","explicit":true,"similar":["س-07270"],"ref":"الأحكام الوسطى 2/365","srcLabel":"الترمذي","text":["إنَّ أَحَبَّ النَّاسِ إلى اللهِ يَوْمَ القِيامةِ وأَدْناهم مِنه مَجلِسًا إمامٌ عادِلٌ، ",["وأَبغَضَ النَّاسِ إلى اللهِ وأَبعَدَهم مِنه مَجلِسًا",2]," ",["إمامٌ جائِرٌ",1],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه الترمذي (1329) واللفظ له، وأحمد (11174)، والبغوي في ((الجعديات)) (2035) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"Jup4rQ9h","merged":2,"otherRefs":["الزواجر عن اقتراف الكبائر 2/115 (حسن)"]},{"id":"س-03162","fp":"9d99c635dc78","stateId":284,"easy":"إذا كنت ملكاً كذاباً ← تكون من أبغض الناس إلى الله","cause":"الملكُ الكذَّابُ","result":"أبغضُ الناسِ إلى اللهِ ثلاثةٌ","explicit":true,"ref":"العواصم والقواصم 5/299","srcLabel":"العواصم والقواصم","text":["[حديثُ ",["أبغضُ الناسِ إلى اللهِ ثلاثةٌ",2],": أحدُهم ",["الملكُ الكذَّابُ",1],"]"],"grade":"صحيح","muhaddith":"صحيح","bab":"إيمان › توحيد الأسماء والصفات","dorar":"JsxTrZEo"},{"id":"س-07270","fp":"9202aba6c04a","stateId":284,"easy":"إذا كنت إماماً جائراً ← تكون أبغض الناس إلى الله وأشدهم عذاباً","cause":"إمامُ جائرٌ","result":"وإن أبغضَ الناسِ إلى اللهِ يومَ القيامةِ وأشدّهم عذابا","explicit":true,"repOf":"س-07448","otherNeedIds":[70,28],"ref":"شرح السنة 5/314","text":["إن أحبّ الناسِ إلى اللهِ يومَ القيامةِ ، وأقربهم منهُ مجلِسا إمامٌ عادلٌ ، ",["وإن أبغضَ الناسِ إلى اللهِ يومَ القيامةِ وأشدّهم عذابا",2]," ",["إمامُ جائرٌ",1]],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"حسن غريب","takhrij":"أخرجه الترمذي (1329) باختلاف يسير، وأحمد (11525)","bab":"فتن › أمراء الجور","dorar":"VfQezCZb","merged":2,"otherRefs":["صحيح الجامع 1001 (حسن)"]},{"id":"س-06968","fp":"e2fa3d204644","stateId":284,"easy":"إذا كنت ملكاً كذاباً أو فقيراً مستكبراً أو غنياً بخيلاً ← يبغضك الله","cause":"ملكٌ كذابٌ وعائلٌ مستكبرٌ وغنيٌّ بخيلٌ","result":"ثلاثةٌ يبغضُهم اللهُ","explicit":true,"ref":"مجمع الزوائد 5/251","srcLabel":"الطبراني","text":[["ثلاثةٌ يبغضُهم اللهُ",2]," ",["ملكٌ كذابٌ وعائلٌ مستكبرٌ وغنيٌّ بخيلٌ",1]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"فيه يحيى بن عبد الرحمن الأرحبي ، وبقية رجاله ثقات","takhrij":"أخرجه البزار (9776)، والطبراني في ((المعجم الأوسط)) (4441) واللفظ له","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"BDhvTMSw"},{"id":"س-05412","fp":"7610ff9a95e0","stateId":285,"easy":"إذا كرهت لقاء الله ← يكره الله لقاءك","cause":"ومَن أبغَضَ لِقاءَ اللهِ","result":"أبغَضَ اللهُ لِقاءَهُ","explicit":true,"star":true,"otherNeedIds":[64],"ref":"تخريج المسند لشاكر 16/231","srcLabel":"مسلم","text":["لا يُحِبُّ رَجُلٌ لِقاءَ اللهِ عزَّ وجلَّ إلَّا أحَبَّ اللهُ لِقاءَهُ، ولا أبغَضَ رَجُلٌ لِقاءَ اللهِ إلَّا أبغَضَ اللهُ لِقاءَهُ. فأتَيتُ عائِشةَ، فقُلتُ: لَئِن كان ما ذكَرَ أبو هُرَيرةَ عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ حَقًّا، لقد هلَكْنا. فقالت: إنَّما الهالِكُ مَن هلَكَ فيما قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، وما ذاك؟ قال: قال: سمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: لا يُحِبُّ رَجُلٌ لِقاءَ اللهِ إلَّا أحَبَّ اللهُ لِقاءَهُ، ولا أبغَضَ رَجُلٌ لِقاءَ اللهِ إلَّا أبغَضَ اللهُ لِقاءَهُ. قالت: وأنا أشهَدُ أنِّي سمِعتُه يَقولُ ذلك، فهل تَدري لِمَ ذلك؟ إذا حَشرَجَ الصَّدرُ، وطَمَحَ البَصَرُ، واقْشَعَرَّ الجِلدُ، وتشَنَّجَتِ الأصابِعُ، فعِندَ ذلك مَن أحَبَّ لِقاءَ اللهِ، أحَبَّ اللهُ لِقاءَهُ، ",["ومَن أبغَضَ لِقاءَ اللهِ، ",1],["أبغَضَ اللهُ لِقاءَهُ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (8556) بلفظه، ومسلم (2685)، والنسائي (1834) كلاهما بلفظ مقارب.","bab":"رقائق وزهد › الحب للقاء الله","dorar":"5ck8teVC"},{"id":"س-05975","fp":"cde0f700309d","stateId":285,"easy":"إذا كنت فظاً جموعاً صخّاباً عالماً بالدنيا جاهلاً بالآخرة ← يبغضك الله","cause":"كلَّ جَعْظَريٍّ جوَّاظٍ سخَّابٍ بالأسواقِ جِيفةٍ باللَّيلِ حِمارٍ بالنَّهارِ عالِمٍ بأمرِ الدُّنيا جاهلٍ بأمرِ الآخِرةِ","result":"إنَّ اللهَ يُبغِضُ","explicit":true,"star":true,"similar":["س-06866"],"ref":"تخريج صحيح ابن حبان 72","srcLabel":"مسلم","text":[["إنَّ اللهَ يُبغِضُ",2],[" كلَّ جَعْظَريٍّ جوَّاظٍ سخَّابٍ بالأسواقِ جِيفةٍ باللَّيلِ حِمارٍ بالنَّهارِ عالِمٍ بأمرِ الدُّنيا جاهلٍ بأمرِ الآخِرةِ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن حبان (72)، والبيهقي (20804) واللفظ لهما، وأبو الشيخ في ((أمثال الحديث)) (234) باختلاف يسير.","bab":"رقائق وزهد › تقديم عمل الآخرة على عمل الدنيا","dorar":"chgwBcbT"},{"id":"ق-0925","fp":"4cc5e79aeb96","stateId":285,"easy":"الفرح بطراً بالمال ← لا يحبه الله","cause":"الفرح بطراً بالمال","result":"لا يحبه الله","explicit":true,"ref":"سورة القصص: 76","srcLabel":"القرآن الكريم","quran":{"s":28,"from":76,"to":76,"text":"إِنَّ قَارُونَ كَانَ مِنْ قَوْمِ مُوسَى فَبَغَى عَلَيْهِمْ وَآتَيْنَاهُ مِنَ الْكُنُوزِ مَا إِنَّ مَفَاتِحَهُ لَتَنُوءُ بِالْعُصْبَةِ أُولِي الْقُوَّةِ إِذْ قَالَ لَهُ قَوْمُهُ لَا تَفْرَحْ إِنَّ اللَّهَ لَا يُحِبُّ الْفَرِحِينَ (76)","hl":[[177,228,1]]}},{"id":"س-07060","fp":"a9e2ce6149e1","stateId":285,"easy":"إذا أكثرت من الأسواق ← فهي شر البقاع","cause":"الأَسواقُ","result":"شرَّ البِقاعِ","explicit":true,"ref":"المستدرك على الصحيحين 2181","srcLabel":"البيهقي","text":["جاءَ رَجلٌ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقالَ: يا رسولَ اللهِ، أيُّ البِقاعِ خيرٌ؟ فقالَ: لا أَدْري. قالَ: فأيُّ البِقاعِ شرٌّ؟ فقالَ: لا أَدْري. فقالَ: سَلْ ربَّكَ. فقالَ جِبريلُ: ما نَسألُه عنْ شيءٍ، قالَ: فانتَفَضَ انتِفاضةً، كادَ أنْ يُصعَقَ منها مُحمَّدٌ صلَّى اللهُ عليه وسلَّمَ، فلمَّا صَعِدَ جِبريلُ قالَ اللهُ تَعالَى: سَألَكَ مُحمَّدٌ أيُّ البِقاعِ خيرٌ؟ فقلتَ: لا أَدْري، وسَألَكَ: أيُّ البقاعِ شرٌّ؟ فقلتَ: لا أَدْري، قالَ: فقالَ: نَعَمْ، قالَ: فحدِّثْهُ أنَّ خيرَ البِقاعِ المساجدُ، وأنَّ ",["شرَّ البِقاعِ",2]," ",["الأَسواقُ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"]صحيح[","takhrij":"أخرجه البيهقي (5049)، وابن عبد البر في ((جامع بيان العلم (1550) كلاهما بلفظه، والحارث بن أبي أسامة في ((بغية الباحث)) (124) باختلاف يسير.","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"54yhHQhp","merged":5,"otherRefs":["فتاوى نور على الدرب لابن باز 33/231 (صحيح)","الترغيب والترهيب 1/173 (صحيح)","العلو للذهبي 99 (حسن)","المهذب في اختصار السنن 2/995 (حسن)"]},{"id":"س-06866","fp":"c2e59d4c6e21","stateId":285,"easy":"إذا كنت عالماً بالدنيا جاهلاً بالآخرة ← يبغضك الله","cause":"كلَّ عالِمٍ بالدنْيا ، جاهِلٍ بالآخِرَةِ","result":"إنَّ اللهَ تعالى يُبغِضُ","explicit":true,"repOf":"س-05975","ref":"صحيح الجامع 1879","text":[["إنَّ اللهَ تعالى يُبغِضُ",2],[" كلَّ عالِمٍ بالدنْيا ، جاهِلٍ بالآخِرَةِ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (72)، والبيهقي (20841)، وأبو الشيخ في ((أمثال الحديث)) (234) باختلاف يسير تامًا.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"Y5KLf2Ih"},{"id":"س-03636","fp":"98f7d70bf3c6","stateId":285,"easy":"إذا جلست في المسجد وليس همّك إلا الدنيا ← فليس لله فيك حاجة","cause":"ولَيْسَ هِمَّتُهم إلَّا الدُّنْيا","result":"ليْسَ للهِ فيهم حاجةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"المستدرك على الصحيحين 8129","srcLabel":"الحاكم","text":["يَأتي على النَّاسِ زَمانٌ يَتحَلَّقُونَ في مَساجِدِهم، ",["ولَيْسَ هِمَّتُهم إلَّا الدُّنْيا",1],"، ",["ليْسَ للهِ فيهم حاجةٌ",2],"، فلا تُجالِسوهم."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح الإسناد","takhrij":"لم نقف عليه إلا عند الحاكم في ((المستدرك)) (7916)","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"Sig5NWza","merged":2,"otherRefs":["إصلاح المساجد 115 (حسن)"]},{"id":"س-06856","fp":"e6271ff7b3e9","stateId":286,"easy":"إذا اضطجعت على بطنك ← فهي ضجعة يبغضها الله","cause":"إنَّ هذِهِ ضِجعةٌ","result":"يبغضُها اللَّهُ","explicit":true,"star":true,"similar":["س-00216","س-06907","س-05196"],"ref":"رياض الصالحين 318","srcLabel":"البخاري","text":["بينما أَنا مضطجعٌ في المسجدِ إذا برجلٌ يحرِّكُني برجلِهِ فقالَ : ",["إنَّ هذِهِ ضِجعةٌ ",1],["يبغضُها اللَّهُ ",2],". قال : فنظرتُ فإذا رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ"],"grade":"صحيح","narrator":"طخفة بن قيس الغفاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (23615)، والبخاري في ((الأدب المفرد)) (1187)، والطبراني في ((المعجم الكبير)) (8/ 329) (8231) باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"g1d81BwG","merged":2,"otherRefs":["كشاف القناع 2/368 (صحيح)"]},{"id":"س-00216","fp":"24d4127c7354","stateId":286,"easy":"إذا اضطجعت على بطنك ← فهي ضجعة يبغضها الله","cause":"لا تَضطجِعْ هذه الضِّجْعةَ","result":"فإنَّها ضِجْعةٌ يُبغِضُها اللهُ عَزَّ وجَلَّ","explicit":true,"repOf":"س-06856","ref":"الأحاديث المختارة 8 / 136","text":["«ضِفْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فيمَن تَضَيَّفَه مِن المَساكينِ، فخَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ في اللَّيلِ يَتَعاهَدُ ضَيْفَه، فرآني مُنْبَطِحًا على بَطْني، فرَكَضَني برِجْلِه وقالَ: (",["لا تَضطجِعْ هذه الضِّجْعةَ؛ ",1],["فإنَّها ضِجْعةٌ يُبغِضُها اللهُ عَزَّ وجَلَّ)»",2],"."],"grade":"صحيح","narrator":"طهفة الغفاري","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"آداب المجلس › إكرام الضيف","dorar":"C1bGcpWZ"},{"id":"س-07958","fp":"c30bd3079bb5","stateId":286,"easy":"إذا بصقت قِبَل وجهك في الصلاة ← يعرض الله عنك","cause":"يَبصُقَنَّ قِبَلَ وَجهِه","result":"يُعرِضَ اللهُ عنه","explicit":true,"star":true,"otherNeedIds":[26],"ref":"صحيح مسلم 3008","srcLabel":"البيهقي","text":["ثُمَّ مَضَينا حتَّى أتَينا جابِرَ بنَ عبدِ اللهِ في مَسجِدِه، وهو يُصَلِّي في ثَوبٍ واحِدٍ مُشتَمِلًا به، فتَخَطَّيتُ القَومَ حتَّى جَلَستُ بينَه وبينَ القِبلةِ، فقُلتُ: يَرحَمُكَ اللهُ، أتُصَلِّي في ثَوبٍ واحِدٍ ورِداؤُكَ إلى جَنبِكَ؟! قال: فقال بيَدِه في صَدري هَكَذا -وفَرَّقَ بينَ أصابِعِه وقَوَّسَها-: أرَدتُ أن يَدخُلَ عليَّ الأحمَقُ مِثلُكَ، فيَراني كيفَ أصنَعُ، فيَصنَعُ مِثلَه! أتانا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم في مَسجِدِنا هذا، وفي يَدِه عُرجونُ ابنِ طابٍ، فرَأى في قِبلةِ المَسجِدِ نُخامةً فحَكَّها بالعُرجونِ، ثُمَّ أقبَلَ علينا فقال: أيُّكُم يُحِبُّ أن ",["يُعرِضَ اللهُ عنه",2],"؟ قال: فخَشَعنا، ثُمَّ قال: أيُّكُم يُحِبُّ أن يُعرِضَ اللهُ عنه؟ قال: فخَشَعنا، ثُمَّ قال: أيُّكُم يُحِبُّ أن يُعرِضَ اللهُ عنه؟ قُلنا: لا أيُّنا يا رَسولَ اللهِ، قال: فإنَّ أحَدَكُم إذا قامَ يُصَلِّي فإنَّ اللَّهَ تَبارَكَ وتَعالى قِبَلَ وَجهِه، فلا ",["يَبصُقَنَّ قِبَلَ وَجهِه",1]," ولا عن يَمينِه، وليَبصُقْ عن يَسارِه تَحتَ رِجلِه اليُسرى، فإن عَجِلَت به بادِرةٌ فليَقُلْ بثَوبِه هَكَذا، ثُمَّ طَوى ثَوبَه بَعضَه على بَعضٍ، فقال: أروني عَبيرًا، فقامَ فتًى مِنَ الحَيِّ يَشتَدُّ إلى أهلِه، فجاءَ بخَلوقٍ في راحَتِه، فأخَذَه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم فجَعَلَه على رَأسِ العُرجونِ، ثُمَّ لَطَخَ به على أثَرِ النُّخامةِ، فقال جابِرٌ: فمِن هُناكَ جَعَلتُمُ الخَلوقَ في مَساجِدِكُم."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه البيهقي (3332) بلفظه.","bab":"مساجد ومواضع الصلاة › البزاق في المسجد","dorar":"J2uksLJh","merged":20,"otherRefs":["صحيح ابن حبان 2270 (صحيح)","تخريج سير أعلام النبلاء 13/237 (صحيح)","صحيح ابن ماجه 624 (صحيح)","تخريج المسند لشعيب 5745 (صحيح)","تخريج المسند لشعيب 6306 (صحيح)","صحيح الجامع 1541 (صحيح)","صحيح البخاري 6111 (صحيح)","الأحكام الشرعية الصغرى 186 (صحيح)","تخريج صحيح ابن حبان 2267 (صحيح)","تخريج المسند لشعيب 13066 (صحيح)","تخريج المسند لشعيب 14099 (صحيح)","تخريج المسند لشعيب 7405 (صحيح)","صحيح البخاري 405 (صحيح)","صحيح مسلم 547 (صحيح)","تخريج المسند لشاكر 7/57 (صحيح)","صحيح الجامع 1537 (صحيح)","صحيح البخاري 417 (صحيح)","صحيح البخاري 1213 (صحيح)","الأحكام الكبير 2/64 (صحيح)"]},{"id":"س-01634","fp":"175364a27590","stateId":286,"easy":"إذا نمت منبطحاً على وجهك ← فهي ضجعة يكرهها الله","cause":"فرآني مُنْكَبًّا على وَجْهي","result":"إنَّها ضِجْعةٌ يَكرَهُها اللهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأحاديث المختارة 8 / 138","srcLabel":"متفق عليه","text":["«أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ كانَ إذا اجْتَمَعَ الضِّيفانُ قالَ: (لِيَنْقَلِبْ كلُّ رَجُلٍ بضَيْفِه) حتَّى إذا كانَ في لَيْلةٍ اجْتَمَعَ في المَسجِدِ ضِيفانٌ كَثيرٌ، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: (لِيَنْقَلِبْ كلُّ رَجُلٍ معَ جَليسِه) قالَ: فكنْتُ مِمَّن انْقَلَبَ معَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فلمَّا دَخَلَ قالَ: (يا عائِشةُ، هلْ مِن شيءٍ؟) قالَت: نَعمْ، حُوَيْسةٌ كُنْتُ أعْدَدْتُها لإفْطارِك، قالَ: (فائْتي بها) فأتَتْ بها في قُعَيْبةٍ لَهم، فأكَلَ مِنها النَّبيُّ صلَّى اللهُ عليه وسلَّمَ شَيئًا ثُمَّ قَدَّمَها إلينا ثُمَّ قالَ: (بِسْمِ اللهِ كُلوا) فأكَلْنا مِنها حتَّى واللهِ ما نَنظُرُ إليها، ثُمَّ قالَ: (عِنْدَك شَرابٌ) قالَتْ: لُبَيْنةٌ أعْدَدْتُها لإفْطارِك، قالَ: (هَلُمِّيها) فجاءَتْ بها فشَرِبَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ مِنها شَيئًا، ثُمَّ قالَ: (بِسْمِ اللهِ اشْرَبوا) فشَرِبْنا حتَّى واللهِ ما نَنظُرُ إليها، ثُمَّ خَرَجْنا إلى الصَّلاةِ، وكانَ يُوقِظُ أهْلَه إذا خَرَجَ، فقالَ: (الصَّلاةَ .. الصَّلاةَ) ",["فرآني مُنْكَبًّا على وَجْهي",1]," فقالَ: (مَن هذا؟) قُلْتُ: أنا عَبْدُ اللهِ، قالَ: (",["إنَّها ضِجْعةٌ يَكرَهُها اللهُ",2],")»."],"grade":"صحيح","narrator":"عبد الله بن طهفة","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"أطعمة › طعام الضيف","dorar":"BcoxXkRc","merged":3,"otherRefs":["الأحاديث المختارة 8 / 135 (صحيح)","صحيح الأدب المفرد 905 (صحيح)"]},{"id":"س-08297","fp":"089a183215dd","stateId":286,"easy":"إذا خرجتما للغائط كاشفين عورتيكما تتحدثان ← فإن الله يمقت ذلك","cause":"لا يَخرُجُ الرَّجُلانِ يَضرِبانِ الغائِطَ كاشِفَينِ عَورَتَهما يَتَحَدَّثانِ","result":"فإنَّ اللهَ يَمقُتُ على ذلك","explicit":true,"similar":["س-06768"],"ref":"الروضة الندية 1/26","srcLabel":"الروضة الندية","text":["نَحو [",["لا يَخرُجُ الرَّجُلانِ يَضرِبانِ الغائِطَ كاشِفَينِ عَورَتَهما يَتَحَدَّثانِ",1],"؛ ",["فإنَّ اللهَ يَمقُتُ على ذلك",2],"]"],"grade":"صحيح","narrator":"جابر","muhaddith":"[صحيح]","takhrij":"ذكره في ((الروضة الندية)) (1/26) معزوا لابن السكن","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"0k4zIO1Z","merged":4,"otherRefs":["تحفة المحتاج 1/164 (صحيح)","صحيح الترغيب 155 (صحيح)","مجمع الزوائد 1/212 (حسن)"]},{"id":"س-04345","fp":"0e176e143766","stateId":286,"easy":"إذا غرت في غير موضع ريبة ← فهي الغيرة التي يبغضها الله","cause":"فالغَيرةُ في غيرِ اللهِ","result":"وأمَّا الغَيرةُ الَّتي يُبغِضُ اللهُ","explicit":true,"similar":["س-04985","س-01325"],"ref":"إكمال المعلم 6/599","srcLabel":"إكمال المعلم","text":["حديث الرُّخصةِ في الخُيَلاءِ على الكُفارِ أو في الحَربِ.[إنَّ مِن الغَيرةِ ما يُحِبُّ اللهُ ومنها ما يُبغِضُ اللهُ فأمَّا الغَيرةُ الَّتي يُحِبُّ اللهُ فالغَيرةُ في اللهِ ",["وأمَّا الغَيرةُ الَّتي يُبغِضُ اللهُ",2]," ",["فالغَيرةُ في غيرِ اللهِ",1]," وإنَّ مِن الخُيلاءِ ما يُحِبُّ اللهُ ومنها ما يُبغِضُ اللهُ فأمَّا الخُيلاءُ الَّتي يُحِبُّ اللهُ أنْ يتخيَّلَ العبدُ بنفسِه عندَ القتالِ وأنْ يتخيَّلَ عندَ الصَّدقةِ وأمَّا الخُيلاءُ الَّتي يُبغِضُ اللهُ فالخُيلاءُ لغيرِ الدِّينِ]"],"grade":"صحيح","narrator":"[عتيك الأنصاري]","muhaddith":"صحيح","bab":"جهاد › استحباب الخيلاء في الحرب","dorar":"hbPVovb7","merged":3,"otherRefs":["صحيح ابن حبان 4762 (صحيح)","تخريج المسند لشعيب 23750 (حسن)"]},{"id":"س-06907","fp":"e71c142c4873","stateId":286,"easy":"إذا اضطجعت على بطنك ← فهي ضجعة لا يحبها الله","cause":"مضطجعًا على بطنِهِ","result":"إن هذه ضِجْعَةٌ لا يُحِبُّها اللهُ","explicit":true,"repOf":"س-06856","ref":"هداية الرواة 4644","text":["عن أبي هريرةَ - رضِيَ اللهُ عنه -، أنه قال : رأى رسولُ اللهِ - صلَّى اللهُ عليهِ وسلَّم - رجلًا ",["مضطجعًا على بطنِهِ",1],"، فقال : ",["إن هذه ضِجْعَةٌ لا يُحِبُّها اللهُ",2]," ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (2768) واللفظ له، وأحمد (8041) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"01oKItcB","merged":3,"otherRefs":["المستدرك على الصحيحين 7918 (صحيح)","مجمع الزوائد 8/104 (صحيح)"]},{"id":"س-06768","fp":"ba4b7dc0abdf","stateId":286,"easy":"إذا تغوّطتما فتحدثتما كاشفين عورتيكما ← فإن الله يمقت ذلك","cause":"إذا تغوَّط الرجلانِ، فيَتَوارَى كلُّ واحدٍ منهما عن صاحِبِه","result":"ولا يَتحدَّثْ على طوافِهما؛ فإنَّ اللهَ يمقُتُ على ذلك","explicit":true,"repOf":"س-08297","ref":"شرح ابن ماجه لمغلطاي 1/171","text":[["إذا تغوَّط الرجلانِ، فيَتَوارَى كلُّ واحدٍ منهما عن صاحِبِه، ",1],["ولا يَتحدَّثْ على طوافِهما؛ فإنَّ اللهَ يمقُتُ على ذلك",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه ابن السكن كما في ((الوهم والإيهام)) لابن القطان (5/260)","bab":"طهارة › إبعاد المتخلي واستتاره","dorar":"PNvPmpK5"},{"id":"س-06770","fp":"23344530e6d3","stateId":286,"easy":"إذا تغوطتما فلم يتوارَ أحدكما ولم تسكتا ← فإن الله يمقت ذلك","cause":"إذا تغوَّط الرَّجُلانِ فليتوارَ كُلُّ واحدٍ منهما عن صاحبِه","result":"ولا يتحَدَّثانِ على طَوفِهما؛ فإنَّ اللهَ يمقُتُ على ذلك","explicit":true,"ref":"المقرر على أبواب المحرر (1/ 55)","srcLabel":"الحاكم","text":[["إذا تغوَّط الرَّجُلانِ فليتوارَ كُلُّ واحدٍ منهما عن صاحبِه، ",1],["ولا يتحَدَّثانِ على طَوفِهما؛ فإنَّ اللهَ يمقُتُ على ذلك",2]],"grade":"صحيح","narrator":"جابر بن عبد الله","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (558) بنحوه.","bab":"طهارة › إبعاد المتخلي واستتاره","dorar":"ka8mksc6"},{"id":"س-05196","fp":"a40537fb7099","stateId":286,"easy":"إذا نمت على بطنك ← فهي نومة يبغضها الله","cause":"نائمًا في المسجدِ على بَطْني","result":"هذه نَوْمةٌ يكرَهُها اللهُ، أو يُبغِضُها اللهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-06856","ref":"صحيح ابن ماجه 3015","text":["أصابني رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["نائمًا في المسجدِ على بَطْني",1],"، فركَضني برِجْلِه، وقال: ما لكَ ولهذا النَّومِ؟! ",["هذه نَوْمةٌ يكرَهُها اللهُ، أو يُبغِضُها اللهُ",2],"."],"grade":"صحيح","narrator":"طهفة الغفاري","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (3723)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"HyKk42YN","merged":2,"otherRefs":["مجمع الزوائد 8/104 (صحيح)"]},{"id":"س-04985","fp":"9c532fb4b0ee","stateId":286,"easy":"إذا غرت في غير ريبة ← فهي غيرة يبغضها الله","cause":"فالغَيْرةُ في غَيْرِ ريبةٍ","result":"وأمَّا الَّتي يُبغِضُها اللهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-04345","ref":"الأحكام الوسطى 3/ 55","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ كانَ يَقولُ: \"مِن الغَيْرةِ ما يُحِبُّ اللهُ، ومِنها ما يُبغِضُ اللهُ؛ فأمَّا الَّتي يُحِبُّ اللهُ فالغَيْرةُ في ريبةٍ، ",["وأمَّا الَّتي يُبغِضُها اللهُ",2]," ",["فالغَيْرةُ في غَيْرِ ريبةٍ",1],"، وإنَّ مِن الخُيَلاءِ ما يُبغِضُ اللهُ عَزَّ وجَلَّ، ومِنها ما يُحِبُّ اللهُ؛ فأمَّا الَّتي يُحِبُّ اللهُ فاخْتِيالُ الرَّجُلِ عنْدَ القِتالِ، وأمَّا الَّتي يُبغِضُ اللهُ فاخْتِيالُه في البَغْيِ والفَخْرِ\"."],"grade":"صحيح","narrator":"جابر بن عتيك","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (2659)، والنسائي (2558)، وأحمد (23747) واللفظ لهم","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"blc8OLUy","merged":2,"otherRefs":["الجواب الكافي 52 (صحيح)"]},{"id":"س-01325","fp":"b0886a6b14e0","stateId":286,"easy":"إذا غرت في غير ريبة ← فهي غيرة يكرهها الله","cause":"فالغِيرةُ في غيرِ رِيبةٍ","result":"و أما ما يكره","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-04345","ref":"صحيح الجامع 5905","text":["من الغِيرةِ ما يُحبُّ اللهُ ، و منها ما يكره اللهُ ، فأما ما يحبُّ ، فالغِيرةُ في الرِّيبةِ ، ",["و أما ما يكره",2]," ",["فالغِيرةُ في غيرِ رِيبةٍ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (1996)، والديلمي في ((الفردوس)) (5996) واللفظ له","bab":"نكاح › عشرة النساء","dorar":"ngWNtFAs"},{"id":"س-04821","fp":"af31d0ff4aca","stateId":286,"easy":"إذا جلست في الصلاة جلسة مخالفة للسنة ← فهي خطوة يبغضها الله","cause":"فإذا أرادَ الرَّجلُ أن يقومَ مدَّ رجلَهُ اليُمنى ووضعَ يدَهُ عليه أو أثبتَ اليُسرَى ثمَّ قامَ","result":"وأمَّا الَّتي يبغَضُها اللَّهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الترغيب والترهيب 1/235","srcLabel":"الحاكم","text":["خُطوتانِ إحداهما أحبُّ الخُطا إلى اللَّهِ والأُخرى أبغضُ الخطا إلى اللَّهِ ، فأمَّا الَّتي يحبُّها اللَّهُ عزَّ وجلَّ فرجلٌ نظرَ إلى خَللٍ في الصَّفِّ فسدَّهُ ، ",["وأمَّا الَّتي يبغَضُها اللَّهُ",2]," ",["فإذا أرادَ الرَّجلُ أن يقومَ مدَّ رجلَهُ اليُمنى ووضعَ يدَهُ عليه أو أثبتَ اليُسرَى ثمَّ قامَ",1]],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الحاكم (1008)، والبيهقي (3712)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"jHfZbRTz"},{"id":"س-01546","fp":"1f1c12a81804","stateId":286,"easy":"إذا تسمّيت بحرب ومرة ← فهي شر الأسماء","cause":"حربٌ ومرّةُ","result":"وشَرُّ الأسماءِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"السلسلة الصحيحة 1040","srcLabel":"ابن وهب","text":["خيرُ الأسماءِ عبدُ اللهِ وعبدُ الرحمنِ ، وأصدقُ الأسماءِ حارثٌ ، ",["وشَرُّ الأسماءِ",2]," ",["حربٌ ومرّةُ",1]],"grade":"حسن","narrator":"عبدالوهاب بن بخت","muhaddith":"قوي بالطرق","takhrij":"أخرجه ابن وهب في ((الجامع)) (46) بلفظه .","bab":"أسماء › الأسماء المنهي عنها والمكروهة","dorar":"nTy4SPkE"},{"id":"س-03146","fp":"b71c256cfbfe","stateId":287,"easy":"إذا أبغضت الأنصار ← يبغضك الله","cause":"ومَن أبغَضَهم","result":"فأبغَضَه اللهُ","explicit":true,"star":true,"similar":["س-08344","س-01799","س-03761","س-08329"],"ref":"تخريج المسند لشعيب 18576","srcLabel":"متفق عليه","text":["أنَّه قال في الأنصارِ: لا يُحِبُّهم إلَّا مؤمنٌ، ولا  يُبغِضُهم إلَّا مُنافقٌ، مَن أحَبَّهم؛ فأحَبَّه اللهُ، ",["ومَن أبغَضَهم؛ ",1],["فأبغَضَه اللهُ",2],"، قال: قُلتُ له: أنت سَمِعتَ البَراءَ؟ قال: إيَّاي يُحدِّثُ."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (3783)، ومسلم (75)، والترمذي (3900)، والنسائي في ((السنن الكبرى)) (8334)، وابن ماجه (163)، وأحمد (18576) واللفظ له","bab":"إيمان › توحيد الأسماء والصفات","dorar":"YSJUPqV0","merged":2,"otherRefs":["تخريج المسند لشعيب 18500 (صحيح)"]},{"id":"س-08344","fp":"035c963f37e0","stateId":287,"easy":"إذا أبغضت الأنصار ← فقد أبغضت الله ورسوله","cause":"ومَن أبغَض الأنصارَ","result":"فقد أبغَض اللهَ ورسولَه لا يُحِبُّهم إلَّا مُؤمِنٌ ولا يُبغِضُهم إلَّا مُنافِقٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"repOf":"س-03146","ref":"صحيح ابن حبان 7272","text":["مَن أحَبَّ الأنصارَ فقد أحَبَّه اللهُ ورسولُه ",["ومَن أبغَض الأنصارَ ",1],["فقد أبغَض اللهَ ورسولَه لا يُحِبُّهم إلَّا مُؤمِنٌ ولا يُبغِضُهم إلَّا مُنافِقٌ",2]],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن عساكر في ((تاريخ دمشق)) (31/ 52)  بلفظه، وأخرجه البخاري (3783)، ومسلم (75) بلفظ مقارب","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"5oasDf0x"},{"id":"س-08378","fp":"223bff0a81b0","stateId":287,"easy":"إذا أبغضت عماراً ← أبغضك الله","cause":"مَن أبغضَ عَمَّارًا","result":"أبغَضَه اللهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"star":true,"similar":["س-08348"],"otherNeedIds":[44],"ref":"تخريج سير أعلام النبلاء 9/367","srcLabel":"النسائي","text":["كان بيني وبين عَمَّارٍ شَيءٌ، فانطلَقَ يَشكو إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فجعَلَ لا يَزيدُه إلَّا غِلَظًا، ورسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ساكتٌ. فبَكَى عمَّارٌ، وقال: يا رسولَ اللهِ! ألَا تَراه؟ فرفَعَ رسولُ اللهِ، فقال: ",["مَن أبغضَ عَمَّارًا، ",1],["أبغَضَه اللهُ، ",2],"ومَن عادى عَمَّارًا، عاداه اللهُ.\nقال: فخرجتُ، وليس شيءٌ أحَبَّ إليَّ من رِضى عَمَّارٍ، فلَقِيتُه، فرَضِيَ."],"grade":"صحيح","narrator":"خالد بن الوليد","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (16814)، والنسائي في ((السنن الكبرى)) (8211)، وفي ((فضائل الصحابة)) (164)، والحاكم (5674) واللفظ لهم جميعا.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"S2xdweFC","merged":4,"otherRefs":["تخريج المسند لشعيب 16821 (صحيح)","در السحابة 293 (صحيح)","تخريج سير أعلام النبلاء 9/367 (حسن)"]},{"id":"س-01799","fp":"8c1f437d4f96","stateId":287,"easy":"إذا أبغضت الأنصار ← تلقى الله وهو يبغضك","cause":"ولا يُبغِضُ الأنصارَ رجُلٌ","result":"إلَّا لَقِيَ اللهَ تبارَكَ وتعالى وهو يُبغِضُه","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"repOf":"س-03146","ref":"محجة القرب 251","text":["عنِ الحارثِ بنِ زيادٍ السَّاعديِّ الأنصاريِّ، أنَّه أتى النبيَّ صلَّى اللهُ عليه وسلَّمَ يومَ الخندقِ وهو يُبايِعُ الناسَ على الهجرةِ، فقال: يا رسولَ اللهِ، بايِعْ هذا، قال: ومَن هذا؟ قال: ابنُ عمِّي، حَوْطُ بنُ يَزيدَ -أو يَزيدُ بنُ حوْطٍ-، قال: فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: لا أُبايعُكم، إنَّ الناسَ يُهاجِرونَ إليكم ولا تُهاجِرونَ إليهم، والذي نَفْسي بيدِهِ لا يُحِبُّ رجُلٌ الأنصارَ حتَّى يَلْقى اللهَ تبارَكَ وتعالى إلَّا لَقِيَ اللهَ تبارَكَ وتعالى وهو يُحبُّه، ",["ولا يُبغِضُ الأنصارَ رجُلٌ",1]," حتَّى يَلْقى اللهَ تبارَكَ وتعالى ",["إلَّا لَقِيَ اللهَ تبارَكَ وتعالى وهو يُبغِضُه",2],"."],"grade":"صحيح","narrator":"الحارث بن زياد الساعدي","muhaddith":"صحيح","takhrij":"أخرجه أحمد (15540)، والطبراني (3/ 263) واللفظ لهما، والطحاوي في ((شرح مشكل الآثار)) (2637) باختلاف يسير.","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"kXtXuFbr","merged":3,"otherRefs":["السلسلة الصحيحة 1672 (حسن)","سبل الهدى والرشاد 3/184 (صحيح)"]},{"id":"س-08357","fp":"2404dcffae18","stateId":287,"easy":"إذا أبغضت علياً ← فقد أبغضت النبي ﷺ","cause":"ومَن أَبغَضَ علِيًّا","result":"فقد أَبغَضَني","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"الصحيح المسند 442","srcLabel":"الصحيح المسند","text":["قالَ رَجُلٌ لِسَلْمانَ: ما أَشَدَّ حُبَّك لعلِيٍّ! قالَ: سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ يقولُ: «مَن أَحَبَّ علِيًّا فقد أَحَبَّني، ",["ومَن أَبغَضَ علِيًّا",1]," ",["فقد أَبغَضَني",2],"»."],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"vRIW0qZ2","merged":3,"otherRefs":["السلسلة الصحيحة 1299 (صحيح)","الفتح الرباني 2/874 (صحيح)"]},{"id":"س-08348","fp":"af0e06c6de27","stateId":287,"easy":"إذا أبغضت عماراً ← أبغضك الله","cause":"ومَن يُبْغِضْهُ","result":"يُبْغِضْهُ اللهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"repOf":"س-08378","ref":"تخريج المسند لشعيب 16821","text":["كان بيْن عمَّارٍ وبيْن خالدِ بنِ الوليدِ كَلامٌ، فشَكاهُ عمَّارٌ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّه مَن يُعادِ عمَّارًا يُعادِهِ اللهُ عزَّ وجلَّ، ",["ومَن يُبْغِضْهُ",1]," ",["يُبْغِضْهُ اللهُ",2]," عزَّ وجلَّ، ومَن يَسُبَّهُ يَسُبَّهُ اللهُ عزَّ وجلَّ. فقال سلَمةُ: هذا أو نحْوَه."],"grade":"صحيح","narrator":"خالد بن الوليد","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (8269)، وأحمد (16821) واللفظ له","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"VTg9D7UE","merged":2,"otherRefs":["تخريج سير أعلام النبلاء 9/367 (حسن)"]},{"id":"س-08365","fp":"a77fc3f2c695","stateId":287,"easy":"إذا أبغضت الحسن والحسين ← فقد أبغضت النبي ﷺ","cause":"و من أبغضَهما","result":"فقد أبغضَني","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"similar":["س-08269","س-08339"],"ref":"السلسلة الصحيحة 2895","srcLabel":"النسائي","text":["من أحبَّهما فقد أحبَّني ، ",["و من أبغضَهما",1]," ",["فقد أبغضَني",2]," يعني الحسَنَ و الحُسَينَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (8168)، وابن ماجه (143)، وأحمد (7876) باختلاف يسير.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"o9DPTHbK","merged":2,"otherRefs":["تخريج سير أعلام النبلاء 3/284 (حسن)"]},{"id":"س-08399","fp":"617f78e984da","stateId":287,"easy":"إذا أبغضت علياً ← فالويل لك","cause":"لمَن أبغضَكَ","result":"والوَيلُ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"المستدرك على الصحيحين 4698","srcLabel":"أحمد","text":["«يا عَليُّ، أنتَ سيِّدٌ في الدُّنيا، سيِّدٌ في الآخِرةِ، حَبيبُكَ حَبيبي، وحَبيبي حَبيبُ اللهِ، وعَدوُّكَ عَدوِّي، وعَدوِّي عَدوُّ اللهِ، ",["والوَيلُ",2]," ",["لمَن أبغضَكَ",1]," بَعْدي»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أحمد في ((فضائل الصحابة)) (2/  642)، والطبراني في ((المعجم الأوسط)) (4751)، واللالكائي في((شرح أصول الاعتقاد))  باختلاف يسير","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"6RNGGVWA","merged":2,"otherRefs":["المستدرك على الصحيحين 4716 (صحيح)"]},{"id":"س-03761","fp":"2df8b4b0ff88","stateId":287,"easy":"إذا أبغضت الأنصار ← أبغضك الله","cause":"ومَن أَبغَضَ الأَنصارَ","result":"أَبغَضَه اللهُ عزَّ وجلَّ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"repOf":"س-03146","ref":"تخريج المسند لشعيب 16871","text":["أنَّ يَزيدَ بنَ جاريةَ الأنصاريَّ، أَخبَرَه أنَّه كان جالِسًا في نَفَرٍ مِنَ الأنصارِ، فخرَجَ علَيهِم معاويةُ، فسألَهم عن حَديثِهم، فقالوا: كنَّا في حديثٍ مِن حديثِ الأنصارِ، فقال معاويةُ: ألَا أَزيدُكم حديثًا سمِعتُه مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ قالوا: بلى يا أميرَ المؤْمِنينَ، قال: سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: مَن أَحَبَّ الأنصارَ، أَحَبَّه اللهُ عزَّ وجلَّ، ",["ومَن أَبغَضَ الأَنصارَ، ",1],["أَبغَضَه اللهُ عزَّ وجلَّ",2],"."],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (8332)، وأحمد (16871) واللفظ له","bab":"اعتصام بالسنة › نقل السنة وروايتها","dorar":"Gq2pjn9e"},{"id":"س-08248","fp":"9e19f40eeeeb","stateId":287,"easy":"إذا أغضبت الضعفاء الصالحين ← فقد أغضبت ربك","cause":"لئن كنتَ أغضبتَهم","result":"لقد أغضبتَ ربَّك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الزواجر عن اقتراف الكبائر 1/112","srcLabel":"الزواجر عن اقتراف الكبائر","text":["أنَّ أبا سفيانَ أتى على سلمانَ وصُهيبٍ وبلالٍ رضيَ اللَّهُ عنهُم في نفرٍ فقالوا: ما أَخذَت سيوفُ اللَّهِ من عدوِّ اللَّهِ مأخذَها؛ فقالَ أبو بَكرٍ رضي اللَّه عنه: أتقولونَ هذا لشَيخِ قُريشٍ وسيِّدِهم؟ فأتى النَّبيَّ صلَّى اللَّهُ عليْهِ وسلَّمَ فأخبرَهُ فقالَ: يا أبا بَكرٍ لعلَّكَ أغضبتَهم ",["لئن كنتَ أغضبتَهم",1]," ",["لقد أغضبتَ ربَّك",2],"، فأتاهم أبو بَكرٍ رضي اللَّهُ عنهُ وقالَ: يا إخوتاهُ أغضبتُكُم قالوا لا يغفرُ اللَّهُ لَكَ يا أخي"],"grade":"صحيح","muhaddith":"صحيح","bab":"مناقب وفضائل › أبو بكر الصديق","dorar":"BJi8jnfy"},{"id":"س-08269","fp":"19c75218b113","stateId":287,"easy":"إذا أبغضت الحسن والحسين ← أبغضك النبي ﷺ وأبغضك الله وأدخلك النار","cause":"ومَن أبغَضَهما","result":"أبغَضَني، ومَن أبغَضَني أبغَضَه اللهُ، ومَن أبغَضَه اللهُ أدخَلَه النَّارَ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"repOf":"س-08365","otherNeedIds":[70],"ref":"المستدرك على الصحيحين 4840","text":["«الحسَنُ والحُسَينُ ابْنايَ، مَن أحَبَّهما أحَبَّني، ومَن أحَبَّني أحَبَّه اللهُ، ومَن أحَبَّه اللهُ أدخَلَه الجنَّةَ، ",["ومَن أبغَضَهما",1]," ",["أبغَضَني، ومَن أبغَضَني أبغَضَه اللهُ، ومَن أبغَضَه اللهُ أدخَلَه النَّارَ",2],"»."],"grade":"صحيح","narrator":"سلمان","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه الطبراني (3/ 50) (2655)، وأبو نعيم في ((معرفة الصحابة)) (1797) بلفظه.","bab":"مناقب وفضائل › أهل البيت صلوات الله عليهم","dorar":"h4HspJIR"},{"id":"س-08329","fp":"bd9e6ec13b3f","stateId":287,"easy":"إذا أبغضت الأنصار ← أبغضك الله ورسوله","cause":"لا يُبغضنَّ الأنصارَ رجُلٌ يؤمنُ باللهِ ورسولِه","result":"إلا أَبغضه اللهُ ورسولُه","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"repOf":"س-03146","ref":"تخريج المسند لشاكر 4/293","text":[["لا يُبغضنَّ الأنصارَ رجُلٌ يؤمنُ باللهِ ورسولِه ",1],"أو ",["إلا أَبغضه اللهُ ورسولُه",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (3906)، وابن أبي شيبة (32372)، والنسائي في ((السنن الكبرى)) (8275) جميعهم باختلاف يسير.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"m1EeWjjY"},{"id":"س-08339","fp":"5867c13956df","stateId":287,"easy":"إذا أبغضت الحسن والحسين ← فقد أبغضت النبي ﷺ","cause":"ومَن بَغَضَهُما","result":"فقد أَبْغَضَنِي","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"repOf":"س-08365","ref":"الجامع الصغير 8299","text":["مَن أَحَبَّ الحَسَنَ و الحُسَيْنَ ، فقد أَحَبَّنِي ، ",["ومَن بَغَضَهُما",1]," ",["فقد أَبْغَضَنِي",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (143)، وأحمد (7863)، والنسائي في ((الكبرى)) (8112)، والحاكم في ((مستدركه)) (4777) واللفظ لهم جميعا.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"yXvUUa3c"},{"id":"س-08402","fp":"fbeaf24f590f","stateId":287,"easy":"إذا أبغضت الأنصار ← فببغض النبي ﷺ أبغضتهم","cause":"ومن أبغَضَ الأنصارَ","result":"فببُغضي أبغَضَهم","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"سبل الهدى والرشاد 3/185","srcLabel":"النسائي","text":["«من أحَبَّ الأنصارَ فبحُبِّي أحَبَّهم، ",["ومن أبغَضَ الأنصارَ",1]," ",["فببُغضي أبغَضَهم",2],"»"],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"صحيح.","takhrij":"أخرجه أحمد (16871)، والطيالسي (1049)، والنسائي في ((الكبرى)) (8274) جميعهم باختلاف يسير.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"G2Ynx0eW"},{"id":"س-08404","fp":"489ff961af04","stateId":287,"easy":"إذا أبغضت عمر ← فقد أبغضت النبي ﷺ","cause":"ومَن أبغَضَ عُمَرَ","result":"فقد أبغَضَني","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"سبل الهدى والرشاد 11/449","srcLabel":"أحمد","text":["«مَن أحَبَّ عُمَرَ فقد أحَبَّني، ",["ومَن أبغَضَ عُمَرَ",1]," ",["فقد أبغَضَني",2],"»"],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6726)، وابن عدي في ((الكامل في الضعفاء)) (1/ 309)، وابن عساكر في ((تاريخ دمشق)) (14/ 22) ثلاثتهم مطولا، وأبو أحمد الحاكم في ((الأسامي والكنى)) (3/ 448) جميعا بلفظه.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"H8uLSqrZ"},{"id":"س-08023","fp":"c85e709c8a18","stateId":288,"easy":"إذا كنت شيخاً زانياً أو فقيراً مختالاً أو غنياً ظلوماً ← يبغضك الله","cause":"الشَّيخُ الزَّاني، والفقيرُ المُخْتالُ، والغَنيُّ الظُّلومُ","result":"والثَّلاثةُ الَّذين يُبغِضُهُم اللهُ","explicit":true,"star":true,"otherNeedIds":[23],"ref":"المستدرك على الصحيحين 2568","srcLabel":"الترمذي","text":["ثلاثةٌ يُحِبُّهُم اللهُ، وثلاثةٌ يُبغِضُهُم اللهُ: أمَّا الَّذين يُحِبُّهُم اللهُ، فرَجلٌ أَتى قومًا، فسَأَلَهُم باللهِ، ولمْ يَسأَلْهم بقَرابةٍ بيْنَهم وبيْنَه، فتَخلَّفَ رَجلٌ بأَعْقابِهم، فأَعْطاهُ سِرًّا، لا يَعلَمُ بعطيَّتِه إلَّا اللهُ والَّذي أَعْطاهُ، وقومٌ ساروا لَيلَهُم حتَّى إذا كان النَّومُ أَحَبَّ إليهم ممَّا يَعدِلُ نَزَلوا، فَوَضَعوا رؤوسَهُم، فقامَ يَتمَلَّقُني ويَتْلو ورَجلٌ كان في سَريَّةٍ، فلَقِيَ العَدوَّ فهُزِموا، فأَقْبَلَ بصدْرِه، حتَّى يُقتَلَ أوْ يُفتَحَ له، ",["والثَّلاثةُ الَّذين يُبغِضُهُم اللهُ",2],": ",["الشَّيخُ الزَّاني، والفقيرُ المُخْتالُ، والغَنيُّ الظُّلومُ",1],"."],"grade":"صحيح","narrator":"أبو ذر","muhaddith":"[إسناده صحيح]","takhrij":"أخرجه الترمذي (2568)، والنسائي (2570)، وأحمد (21355)، وابن خزيمة (2456) واللفظ لهم.","bab":"مظالم › تحريم الظلم","dorar":"LHuTXdJR","merged":2,"otherRefs":["تخريج المسند لشعيب 21356 (صحيح)"]},{"id":"س-05701","fp":"c37869ae350b","stateId":288,"easy":"إذا كنت شيخاً زانياً أو بخيلاً متكبراً ← يبغضك الله","cause":"الشَّيخَ الزَّانيَ والبخيلَ المتكبِّرَ","result":"ويُبغِضُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج صحيح ابن حبان 3350","srcLabel":"الترمذي","text":["ثلاثةٌ يُحِبُّهم اللهُ وثلاثةٌ يُبغِضُهم اللهُ: يُحِبُّ رجلًا كان في قومٍ فأتاهم سائلٌ فسأَلهم بوجهِ اللهِ لا يسأَلُهم لقرابةٍ بينهم وبينه فبخِلوا فخلَّفهم بأعقابِهم حيثُ لا يراه إلَّا اللهُ ومَن أعطاه ورجلٌ كان في كتيبةٍ فانكشَفوا فكبَّر فقاتَل حتَّى يفتَحَ اللهُ عليه أو يُقتَلَ، ورجلٌ كان في قومٍ فأدلجوا فطالت دُلْجتُهم فنزَلوا والنَّومُ إليهم ممَّا يُعدَلُ به فناموا وقام يتلو آياتي ويتملَّقُني ",["ويُبغِضُ",2]," ",["الشَّيخَ الزَّانيَ والبخيلَ المتكبِّرَ",1]," ) وذكَر الثَّالثَ"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2568)، والنسائي (2570)، وأحمد (21355) باختلاف يسير","bab":"رقائق وزهد › الكبر والتواضع","dorar":"0d1uAXak"},{"id":"س-06947","fp":"09eae2af699f","stateId":288,"easy":"إذا أتيت ما حرم الله ← فإن الله يغار","cause":"أن يأتِيَ المؤمِنُ ما حَرَّمَ اللهُ عليهِ","result":"و غَيرَةُ اللهِ","explicit":true,"star":true,"ref":"صحيح الجامع 1901","srcLabel":"متفق عليه","text":["إنَّ اللهَ تعالى يَغارُ ، و إنَّ المؤمِنَ يَغارُ ، ",["و غَيرَةُ اللهِ",2]," ",["أن يأتِيَ المؤمِنُ ما حَرَّمَ اللهُ عليهِ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5223)، ومسلم (2761)، وأحمد (10735) باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"tHwtTAt1","merged":3,"otherRefs":["تخريج صحيح ابن حبان 293 (صحيح)","تخريج المسند لشعيب 10950 (صحيح)"]},{"id":"س-05406","fp":"e11b8800b8ff","stateId":288,"easy":"إذا أبغضك الناس (بسوء خلقك) ← تكون أبغضهم إلى الله","cause":"أبغَضُكم إلى النَّاسِ","result":"إنَّ أبغَضَكم إلى اللهِ","explicit":true,"otherNeedIds":[44],"ref":"المعجم الأوسط 6/136","srcLabel":"أحمد","text":["ألَا أُخبِرُكم بأحَبِّكم إلى اللهِ قُلْنا بلى يا رسولَ اللهِ وظنَنَّا أنَّه يُسمِّي رجُلًا فقال إنَّ أحَبَّكم إلى اللهِ أحَبُّكم إلى النَّاسِ ثمَّ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ألَا أُخبِرُكم بأبغَضِكم إلى اللهِ قُلْنا بلى يا رسولَ اللهِ فظنَنَّا أنَّه يُسمِّي رجُلًا فقال ",["إنَّ أبغَضَكم إلى اللهِ",2]," ",["أبغَضُكم إلى النَّاسِ",1]],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"لا يروى هذا الحديث عن أبي سعيد إلا بهذا الإسناد تفرد به بن المبارك ولم يروه عن بن المبارك إلا علي بن الحسن بن شقيق حدثنا بهذا الحديث قال محمد بن الحسن بن شقيق حدثت بهذا الحديث أحمد بن حنبل فاستحسنه","takhrij":"أخرجه ابن أبي الدنيا في ((الأولياء)) (34) بلفظه، وابن المرزبان في ((ذم الثقلاء)) (15) بلفظه دون شطره:(( ألا أخبركم بأحبكم إلى الله...)).","bab":"رقائق وزهد › الحب في الله","dorar":"2aqRaHL0"},{"id":"س-02016","fp":"826e1f0f5f9b","stateId":288,"easy":"إذا طال عمرك وساء عملك ← فأنت من شر الناس","cause":"مَن طالَ عُمُرُه وساءَ عَمَلُه","result":"فأيُّ النَّاسِ شَرٌّ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[57],"ref":"المستدرك على الصحيحين 1273","srcLabel":"مسلم","text":["أنَّ رَجُلًا قالَ: يا رَسولَ اللهِ، أيُّ النَّاسِ خَيرٌ؟ قالَ: مَن طالَ عُمُرُه وحَسُنَ عَمَلُه. قالَ: ",["فأيُّ النَّاسِ شَرٌّ",2],"؟ قالَ: ",["مَن طالَ عُمُرُه وساءَ عَمَلُه",1],"."],"grade":"صحيح","narrator":"أبو بكرة","muhaddith":"[صحيح على شرط مسلم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Lg2quckn","merged":3,"otherRefs":["صحيح الجامع 3297 (صحيح)","تخريج المسند لشعيب 20480 (حسن)"]},{"id":"س-04754","fp":"4a5337e4f4a6","stateId":288,"easy":"إذا قرأت القرآن ولم ترعوِ عن الفجور ← فأنت من شر الناس","cause":"رَجُلًا فاجِرًا يَقرَأُ كِتابَ اللهِ لا يَرْعوي إلى شيءٍ مِنه","result":"وإنَّ مِن شَرِّ النَّاسِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[13],"ref":"الأحكام الوسطى 4/ 338","srcLabel":"النسائي","text":["كانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ خَطَبَ النَّاسَ عامَ تَبوكَ وهو مُسنِدٌ ظَهْرَه إلى راحِلتِه، فقالَ: \"أَلَا أُخبِرُكم بخَيْرِ النَّاسِ، وشَرِّ النَّاسِ؟ إنَّ مِن خَيْرِ النَّاسِ رَجُلًا عَمِلَ في سَبيلِ اللهِ على ظَهْرِ فَرَسِه، أو على ظَهْرِ بَعيرِه، أو على قَدَمِه حتَّى يَأتيَه المَوْتُ، ",["وإنَّ مِن شَرِّ النَّاسِ",2]," ",["رَجُلًا فاجِرًا يَقرَأُ كِتابَ اللهِ لا يَرْعوي إلى شيءٍ مِنه",1],"\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه النسائي (3106)، وأحمد (113019)، والحاكم (2380) واللفظ لهم.","bab":"رقائق وزهد › الإخلاص","dorar":"TQxsZaU6"}]}