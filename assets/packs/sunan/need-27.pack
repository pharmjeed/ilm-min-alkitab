{"schema":1,"kind":"sunan-chunk","version":"sunan-50a61695a4db","needId":27,"stateIds":[238,239,240,241,242,243,244,245,246,247,248,249,250,251,252,253,254,255],"items":[{"id":"س-05103","fp":"0a075bb32ed6","stateId":238,"easy":"إذا ذبحت لغير الله ← لعنك الله","cause":"مَن ذبَح لغيْرِ اللهِ","result":"لعَن اللهُ","explicit":true,"star":true,"similar":["س-05078","س-08281"],"ref":"تخريج المسند لشعيب 1307","srcLabel":"مسلم","text":["عن أبي الطُّفَيلِ، قال: سُئِلَ عليٌّ: هل خصَّكم رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بشيءٍ؟ فقال: ما خصَّنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بشيءٍ لم يعُمَّ به النَّاسَ كافَّةً، إلَّا ما كان في قِرابِ سَيْفي هذا. قال: فأَخرَج صَحيفةً فيها مكتوبٌ: لعَن اللهُ ",["مَن ذبَح لغيْرِ اللهِ، ",1],["لعَن اللهُ ",2],"مَن سرَق مَنارَ الأرضِ، ولعَن اللهُ مَن لعَن والدَه، ولعَن اللهُ مَن آوَى مُحدِثًا."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (1978)، وأحمد (1307) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Ip8Twklz","merged":3,"otherRefs":["صحيح ابن حبان 4417 (صحيح)","تخريج المسند لشعيب 855 (صحيح)"]},{"id":"س-04969","fp":"cf4c2d1b862a","stateId":238,"easy":"إذا ساكنت المشركين أو جامعتهم ← فلست منا","cause":"فمَنْ ساكَنَهُم أوْ جامَعَهُم","result":"فليس مِنَّا","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 2663","srcLabel":"البخاري","text":["لا تُساكِنوا المشركينَ، ولا تُجامِعوهُم، ",["فمَنْ ساكَنَهُم أوْ جامَعَهُم؛ ",1],["فليس مِنَّا",2],"."],"grade":"صحيح","narrator":"سمرة","muhaddith":"صحيح على شرط البخاري،","takhrij":"أخرجه البيهقي (18465)، والطبراني  (7/ 217) (6905) بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"GpR3toto"},{"id":"س-05078","fp":"4d5ba7c1805a","stateId":238,"easy":"إذا أهللت لغير الله ← لعنك الله","cause":"مَن أهَلَّ لغيرِ اللهِ","result":"لعَن اللهُ","explicit":true,"repOf":"س-05103","ref":"تخريج صحيح ابن حبان 5896","text":["قُلْتُ لِعليِّ بنِ أبي طالبٍ: عندَكم شيءٌ سوى كتابِ اللهِ ؟ قال: لا إلَّا ما في قِرابِ هذا السَّيفِ، صحيفةٌ صغيرةٌ قال: فوجَدْنا فيها: ( لعَن اللهُ ",["مَن أهَلَّ لغيرِ اللهِ",1]," و",["لعَن اللهُ",2]," مَن تولَّى لغيرِ مواليه )"],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (5896) واللفظ له، والترمذي (2127) بلفظه أثناء حديث طويل، والبخاري (6755)، ومسلم (1370) بمعناه أثناء حديث طويل.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"KKS8sDbw"},{"id":"س-05274","fp":"c276e56d87f2","stateId":238,"easy":"إذا سحرت أو تطيرت أو تكهنت أو طلبت ذلك لك ← فلست منا","cause":"سَحَر ولا سُحِرَ له، ولا تَطَيَّرَ ولا تُطُيِّرَ له، ولا تَكَهَّنَ ولا تُكُهِّنَ له","result":"ليس مِنَّا مَن","explicit":true,"star":true,"ref":"الأحاديث المختارة 11 / 404","srcLabel":"متفق عليه","text":["«",["ليس مِنَّا مَن",2],[" سَحَر ولا سُحِرَ له، ولا تَطَيَّرَ ولا تُطُيِّرَ له، ولا تَكَهَّنَ ولا تُكُهِّنَ له»",1],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"FfaXZOs9"},{"id":"س-07192","fp":"4a0a310ea1a0","stateId":238,"easy":"إذا أقمت بين المشركين ← فالنبي ﷺ منك بريء","cause":"كلِّ مُسلِمٍ يُقِيمُ بيْنَ أظْهُرِ المُشرِكين","result":"أنا بَرِيءٌ مِن","explicit":true,"star":true,"similar":["س-02379","س-02381"],"ref":"حاشية الإلمام لابن عبد الهادي 346","srcLabel":"مسلم","text":["بعَثَ رَسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ سَرِيَّةً إلى خَثْعَمٍ، فاعتصَمَ ناسٌ مِنهم بالسُّجودِ، فأُسْرِعَ فيهم القتْلُ، فبلَغَ ذلك النَّبيَّ صَلَّى اللهُ عليه وسلَّمَ، فأمَرَ لهم بنِصْفِ العقْلِ، وقال: ",["أنا بَرِيءٌ مِن",2]," ",["كلِّ مُسلِمٍ يُقِيمُ بيْنَ أظْهُرِ المُشرِكين",1],". قالوا: يا رسولَ اللهِ، لِمَ؟ قال: لا تَرَاءيَا ناراهُما"],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"إسناده على شرط مسلم","takhrij":"أخرجه أبو داود (2645)، والترمذي (1604)، وابن الأعرابي في ((معجمه)) (858) واللفظ لهم.","bab":"علم › حسن السؤال ونصح العالم","dorar":"earngRri"},{"id":"ق-0027","fp":"7d263f60df06","stateId":238,"easy":"الكفر ← لعنة الله وقلّة الإيمان","cause":"الكفر","result":"لعنة الله وقلّة الإيمان","explicit":true,"star":true,"otherNeedIds":[19],"ref":"سورة البقرة: 88","srcLabel":"القرآن الكريم","quran":{"s":2,"from":88,"to":88,"text":"وَقَالُوا قُلُوبُنَا غُلْفٌ بَلْ لَعَنَهُمُ اللَّهُ بِكُفْرِهِمْ فَقَلِيلًا مَا يُؤْمِنُونَ (88)","hl":[[28,91,1]]}},{"id":"ق-0028","fp":"40265c9aa9ad","stateId":238,"easy":"جحود الحق بعد معرفته ← لعنة الله","cause":"جحود الحق بعد معرفته","result":"لعنة الله","explicit":true,"ref":"سورة البقرة: 89","srcLabel":"القرآن الكريم","quran":{"s":2,"from":89,"to":89,"text":"وَلَمَّا جَاءَهُمْ كِتَابٌ مِنْ عِنْدِ اللَّهِ مُصَدِّقٌ لِمَا مَعَهُمْ وَكَانُوا مِنْ قَبْلُ يَسْتَفْتِحُونَ عَلَى الَّذِينَ كَفَرُوا فَلَمَّا جَاءَهُمْ مَا عَرَفُوا كَفَرُوا بِهِ فَلَعْنَةُ اللَّهِ عَلَى الْكَافِرِينَ (89)","hl":[[135,219,1]]}},{"id":"ق-0029","fp":"5363d0c25851","stateId":238,"easy":"الكفر بما أنزل الله بغياً وحسداً ← غضب على غضب وعذاب مهين","cause":"الكفر بما أنزل الله بغياً وحسداً","result":"غضب على غضب وعذاب مهين","explicit":true,"otherNeedIds":[57],"ref":"سورة البقرة: 90","srcLabel":"القرآن الكريم","quran":{"s":2,"from":90,"to":90,"text":"بِئْسَمَا اشْتَرَوْا بِهِ أَنْفُسَهُمْ أَنْ يَكْفُرُوا بِمَا أَنْزَلَ اللَّهُ بَغْيًا أَنْ يُنَزِّلَ اللَّهُ مِنْ فَضْلِهِ عَلَى مَنْ يَشَاءُ مِنْ عِبَادِهِ فَبَاءُوا بِغَضَبٍ عَلَى غَضَبٍ وَلِلْكَافِرِينَ عَذَابٌ مُهِينٌ (90)","hl":[[0,221,1]]}},{"id":"ق-0031","fp":"5da7ed575993","stateId":238,"easy":"معاداة الله وملائكته ورسله ← عداوة الله له","cause":"معاداة الله وملائكته ورسله","result":"عداوة الله له","explicit":true,"ref":"سورة البقرة: 98","srcLabel":"القرآن الكريم","quran":{"s":2,"from":98,"to":98,"text":"مَنْ كَانَ عَدُوًّا لِلَّهِ وَمَلَائِكَتِهِ وَرُسُلِهِ وَجِبْرِيلَ وَمِيكَالَ فَإِنَّ اللَّهَ عَدُوٌّ لِلْكَافِرِينَ (98)","hl":[[0,116,1]]}},{"id":"ق-0056","fp":"8d9c0f227c03","stateId":238,"easy":"الموت على الكفر ← لعنة الله والملائكة والناس والخلود بلا تخفيف","cause":"الموت على الكفر","result":"لعنة الله والملائكة والناس والخلود بلا تخفيف","explicit":true,"otherNeedIds":[57],"ref":"سورة البقرة: 161–162","srcLabel":"القرآن الكريم","quran":{"s":2,"from":161,"to":162,"text":"إِنَّ الَّذِينَ كَفَرُوا وَمَاتُوا وَهُمْ كُفَّارٌ أُولَئِكَ عَلَيْهِمْ لَعْنَةُ اللَّهِ وَالْمَلَائِكَةِ وَالنَّاسِ أَجْمَعِينَ (161) خَالِدِينَ فِيهَا لَا يُخَفَّفُ عَنْهُمُ الْعَذَابُ وَلَا هُمْ يُنْظَرُونَ (162)","hl":[[0,209,1]]}},{"id":"ق-0128","fp":"f848254a2bd1","stateId":238,"easy":"اتخاذ الكافرين أولياء من دون المؤمنين ← ليس من الله في شيء","cause":"اتخاذ الكافرين أولياء من دون المؤمنين","result":"ليس من الله في شيء","explicit":true,"ref":"سورة آل عمران: 28","srcLabel":"القرآن الكريم","quran":{"s":3,"from":28,"to":28,"text":"لَا يَتَّخِذِ الْمُؤْمِنُونَ الْكَافِرِينَ أَوْلِيَاءَ مِنْ دُونِ الْمُؤْمِنِينَ وَمَنْ يَفْعَلْ ذَلِكَ فَلَيْسَ مِنَ اللَّهِ فِي شَيْءٍ إِلَّا أَنْ تَتَّقُوا مِنْهُمْ تُقَاةً وَيُحَذِّرُكُمُ اللَّهُ نَفْسَهُ وَإِلَى اللَّهِ الْمَصِيرُ (28)","hl":[[0,136,1]]}},{"id":"ق-0220","fp":"378429b7b912","stateId":238,"easy":"الكفر وتحريف الكلم ← لعنة الله وقلة الإيمان","cause":"الكفر وتحريف الكلم","result":"لعنة الله وقلة الإيمان","explicit":true,"otherNeedIds":[19],"ref":"سورة النساء: 46","srcLabel":"القرآن الكريم","quran":{"s":4,"from":46,"to":46,"text":"مِنَ الَّذِينَ هَادُوا يُحَرِّفُونَ الْكَلِمَ عَنْ مَوَاضِعِهِ وَيَقُولُونَ سَمِعْنَا وَعَصَيْنَا وَاسْمَعْ غَيْرَ مُسْمَعٍ وَرَاعِنَا لَيًّا بِأَلْسِنَتِهِمْ وَطَعْنًا فِي الدِّينِ وَلَوْ أَنَّهُمْ قَالُوا سَمِعْنَا وَأَطَعْنَا وَاسْمَعْ وَانْظُرْنَا لَكَانَ خَيْرًا لَهُمْ وَأَقْوَمَ وَلَكِنْ لَعَنَهُمُ اللَّهُ بِكُفْرِهِمْ فَلَا يُؤْمِنُونَ إِلَّا قَلِيلًا (46)","hl":[[286,360,1]]}},{"id":"ق-0222","fp":"48cb0ddc67ea","stateId":238,"easy":"الإيمان بالجبت والطاغوت وتفضيل الكافرين على المؤمنين ← لعنة الله ولا نصير","cause":"الإيمان بالجبت والطاغوت وتفضيل الكافرين على المؤمنين","result":"لعنة الله ولا نصير","explicit":true,"otherNeedIds":[39],"ref":"سورة النساء: 51–52","srcLabel":"القرآن الكريم","quran":{"s":4,"from":51,"to":52,"text":"أَلَمْ تَرَ إِلَى الَّذِينَ أُوتُوا نَصِيبًا مِنَ الْكِتَابِ يُؤْمِنُونَ بِالْجِبْتِ وَالطَّاغُوتِ وَيَقُولُونَ لِلَّذِينَ كَفَرُوا هَؤُلَاءِ أَهْدَى مِنَ الَّذِينَ آمَنُوا سَبِيلًا (51) أُولَئِكَ الَّذِينَ لَعَنَهُمُ اللَّهُ وَمَنْ يَلْعَنِ اللَّهُ فَلَنْ تَجِدَ لَهُ نَصِيرًا (52)","hl":[[0,277,1]]}},{"id":"ق-0318","fp":"08a4d55ed28d","stateId":238,"easy":"سوء القول في الله ← اللعنة","cause":"سوء القول في الله","result":"اللعنة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة المائدة: 64","srcLabel":"القرآن الكريم","quran":{"s":5,"from":64,"to":64,"text":"وَقَالَتِ الْيَهُودُ يَدُ اللَّهِ مَغْلُولَةٌ غُلَّتْ أَيْدِيهِمْ وَلُعِنُوا بِمَا قَالُوا بَلْ يَدَاهُ مَبْسُوطَتَانِ يُنْفِقُ كَيْفَ يَشَاءُ وَلَيَزِيدَنَّ كَثِيرًا مِنْهُمْ مَا أُنْزِلَ إِلَيْكَ مِنْ رَبِّكَ طُغْيَانًا وَكُفْرًا وَأَلْقَيْنَا بَيْنَهُمُ الْعَدَاوَةَ وَالْبَغْضَاءَ إِلَى يَوْمِ الْقِيَامَةِ كُلَّمَا أَوْقَدُوا نَارًا لِلْحَرْبِ أَطْفَأَهَا اللَّهُ وَيَسْعَوْنَ فِي الْأَرْضِ فَسَادًا وَاللَّهُ لَا يُحِبُّ الْمُفْسِدِينَ (64)","hl":[[0,90,1]]}},{"id":"ق-0329","fp":"934ae4d62d52","stateId":238,"easy":"تولّي الذين كفروا ← سخط الله والخلود في العذاب","cause":"تولّي الذين كفروا","result":"سخط الله والخلود في العذاب","explicit":true,"otherNeedIds":[57],"ref":"سورة المائدة: 80","srcLabel":"القرآن الكريم","quran":{"s":5,"from":80,"to":80,"text":"تَرَى كَثِيرًا مِنْهُمْ يَتَوَلَّوْنَ الَّذِينَ كَفَرُوا لَبِئْسَ مَا قَدَّمَتْ لَهُمْ أَنْفُسُهُمْ أَنْ سَخِطَ اللَّهُ عَلَيْهِمْ وَفِي الْعَذَابِ هُمْ خَالِدُونَ (80)","hl":[[0,163,1]]}},{"id":"ق-0428","fp":"2bc1c747015c","stateId":238,"easy":"اتخاذ العجل (الشرك والافتراء) ← غضب من الله وذلة في الحياة الدنيا","cause":"اتخاذ العجل (الشرك والافتراء)","result":"غضب من الله وذلة في الحياة الدنيا","explicit":true,"otherNeedIds":[39],"ref":"سورة الأعراف: 152","srcLabel":"القرآن الكريم","quran":{"s":7,"from":152,"to":152,"text":"إِنَّ الَّذِينَ اتَّخَذُوا الْعِجْلَ سَيَنَالُهُمْ غَضَبٌ مِنْ رَبِّهِمْ وَذِلَّةٌ فِي الْحَيَاةِ الدُّنْيَا وَكَذَلِكَ نَجْزِي الْمُفْتَرِينَ (152)","hl":[[0,142,1]]}},{"id":"ق-0580","fp":"36076664292d","stateId":238,"easy":"افتراء الكذب على الله والصد عن سبيله ← لعنة الله ومضاعفة العذاب والخسران","cause":"افتراء الكذب على الله والصد عن سبيله","result":"لعنة الله ومضاعفة العذاب والخسران","explicit":true,"otherNeedIds":[57,50],"ref":"سورة هود: 18–22","srcLabel":"القرآن الكريم","quran":{"s":11,"from":18,"to":22,"text":"وَمَنْ أَظْلَمُ مِمَّنِ افْتَرَى عَلَى اللَّهِ كَذِبًا أُولَئِكَ يُعْرَضُونَ عَلَى رَبِّهِمْ وَيَقُولُ الْأَشْهَادُ هَؤُلَاءِ الَّذِينَ كَذَبُوا عَلَى رَبِّهِمْ أَلَا لَعْنَةُ اللَّهِ عَلَى الظَّالِمِينَ (18) الَّذِينَ يَصُدُّونَ عَنْ سَبِيلِ اللَّهِ وَيَبْغُونَهَا عِوَجًا وَهُمْ بِالْآخِرَةِ هُمْ كَافِرُونَ (19) أُولَئِكَ لَمْ يَكُونُوا مُعْجِزِينَ فِي الْأَرْضِ وَمَا كَانَ لَهُمْ مِنْ دُونِ اللَّهِ مِنْ أَوْلِيَاءَ يُضَاعَفُ لَهُمُ الْعَذَابُ مَا كَانُوا يَسْتَطِيعُونَ السَّمْعَ وَمَا كَانُوا يُبْصِرُونَ (20) أُولَئِكَ الَّذِينَ خَسِرُوا أَنْفُسَهُمْ وَضَلَّ عَنْهُمْ مَا كَانُوا يَفْتَرُونَ (21) لَا جَرَمَ أَنَّهُمْ فِي الْآخِرَةِ هُمُ الْأَخْسَرُونَ (22)","hl":[[0,660,1]]}},{"id":"ق-0586","fp":"1ae4692abdfc","stateId":238,"easy":"جحود آيات الله وعصيان الرسل واتباع أمر كل جبار عنيد ← لعنة في الدنيا ويوم القيامة والبُعد","cause":"جحود آيات الله وعصيان الرسل واتباع أمر كل جبار عنيد","result":"لعنة في الدنيا ويوم القيامة والبُعد","explicit":true,"otherNeedIds":[49],"ref":"سورة هود: 59–60","srcLabel":"القرآن الكريم","quran":{"s":11,"from":59,"to":60,"text":"وَتِلْكَ عَادٌ جَحَدُوا بِآيَاتِ رَبِّهِمْ وَعَصَوْا رُسُلَهُ وَاتَّبَعُوا أَمْرَ كُلِّ جَبَّارٍ عَنِيدٍ (59) وَأُتْبِعُوا فِي هَذِهِ الدُّنْيَا لَعْنَةً وَيَوْمَ الْقِيَامَةِ أَلَا إِنَّ عَادًا كَفَرُوا رَبَّهُمْ أَلَا بُعْدًا لِعَادٍ قَوْمِ هُودٍ (60)","hl":[[0,248,1]]}},{"id":"ق-0683","fp":"0105495beffe","stateId":238,"easy":"شرح الصدر بالكفر بعد الإيمان واستحباب الدنيا على الآخرة ← غضب من الله وعذاب عظيم والطبع على القلب والسمع والبصر والخسران","cause":"شرح الصدر بالكفر بعد الإيمان واستحباب الدنيا على الآخرة","result":"غضب من الله وعذاب عظيم والطبع على القلب والسمع والبصر والخسران","explicit":true,"otherNeedIds":[57,19,50],"ref":"سورة النحل: 106–109","srcLabel":"القرآن الكريم","quran":{"s":16,"from":106,"to":109,"text":"مَنْ كَفَرَ بِاللَّهِ مِنْ بَعْدِ إِيمَانِهِ إِلَّا مَنْ أُكْرِهَ وَقَلْبُهُ مُطْمَئِنٌّ بِالْإِيمَانِ وَلَكِنْ مَنْ شَرَحَ بِالْكُفْرِ صَدْرًا فَعَلَيْهِمْ غَضَبٌ مِنَ اللَّهِ وَلَهُمْ عَذَابٌ عَظِيمٌ (106) ذَلِكَ بِأَنَّهُمُ اسْتَحَبُّوا الْحَيَاةَ الدُّنْيَا عَلَى الْآخِرَةِ وَأَنَّ اللَّهَ لَا يَهْدِي الْقَوْمَ الْكَافِرِينَ (107) أُولَئِكَ الَّذِينَ طَبَعَ اللَّهُ عَلَى قُلُوبِهِمْ وَسَمْعِهِمْ وَأَبْصَارِهِمْ وَأُولَئِكَ هُمُ الْغَافِلُونَ (108) لَا جَرَمَ أَنَّهُمْ فِي الْآخِرَةِ هُمُ الْخَاسِرُونَ (109)","hl":[[0,510,1]]}},{"id":"ق-1001","fp":"5c0aceb77fe9","stateId":238,"easy":"الكفر ← لعنة الله وسعير خالدين فيها بلا وليّ ولا نصير","cause":"الكفر","result":"لعنة الله وسعير خالدين فيها بلا وليّ ولا نصير","explicit":true,"otherNeedIds":[57],"ref":"سورة الأحزاب: 64–65","srcLabel":"القرآن الكريم","quran":{"s":33,"from":64,"to":65,"text":"إِنَّ اللَّهَ لَعَنَ الْكَافِرِينَ وَأَعَدَّ لَهُمْ سَعِيرًا (64) خَالِدِينَ فِيهَا أَبَدًا لَا يَجِدُونَ وَلِيًّا وَلَا نَصِيرًا (65)","hl":[[0,129,1]]}},{"id":"ق-1031","fp":"5de3a50b7608","stateId":238,"easy":"الكفر ← عليه كفره ولا يزيده إلا مقتاً وخساراً","cause":"الكفر","result":"عليه كفره ولا يزيده إلا مقتاً وخساراً","explicit":true,"otherNeedIds":[50],"ref":"سورة فاطر: 39","srcLabel":"القرآن الكريم","quran":{"s":35,"from":39,"to":39,"text":"هُوَ الَّذِي جَعَلَكُمْ خَلَائِفَ فِي الْأَرْضِ فَمَنْ كَفَرَ فَعَلَيْهِ كُفْرُهُ وَلَا يَزِيدُ الْكَافِرِينَ كُفْرُهُمْ عِنْدَ رَبِّهِمْ إِلَّا مَقْتًا وَلَا يَزِيدُ الْكَافِرِينَ كُفْرُهُمْ إِلَّا خَسَارًا (39)","hl":[[48,207,1]]}},{"id":"ق-1104","fp":"e911258e60d6","stateId":238,"easy":"الكفر عند الدعوة إلى الإيمان ← مقت الله الأكبر","cause":"الكفر عند الدعوة إلى الإيمان","result":"مقت الله الأكبر","explicit":true,"ref":"سورة غافر: 10","srcLabel":"القرآن الكريم","quran":{"s":40,"from":10,"to":10,"text":"إِنَّ الَّذِينَ كَفَرُوا يُنَادَوْنَ لَمَقْتُ اللَّهِ أَكْبَرُ مِنْ مَقْتِكُمْ أَنْفُسَكُمْ إِذْ تُدْعَوْنَ إِلَى الْإِيمَانِ فَتَكْفُرُونَ (10)","hl":[[0,139,1]]}},{"id":"ق-1147","fp":"b5b05380bf63","stateId":238,"easy":"المحاجّة في الله بعد الاستجابة له ← حجة داحضة وغضب وعذاب شديد","cause":"المحاجّة في الله بعد الاستجابة له","result":"حجة داحضة وغضب وعذاب شديد","explicit":true,"otherNeedIds":[57],"ref":"سورة الشورى: 16","srcLabel":"القرآن الكريم","quran":{"s":42,"from":16,"to":16,"text":"وَالَّذِينَ يُحَاجُّونَ فِي اللَّهِ مِنْ بَعْدِ مَا اسْتُجِيبَ لَهُ حُجَّتُهُمْ دَاحِضَةٌ عِنْدَ رَبِّهِمْ وَعَلَيْهِمْ غَضَبٌ وَلَهُمْ عَذَابٌ شَدِيدٌ (16)","hl":[[0,151,1]]}},{"id":"س-05021","fp":"0de60dfb0661","stateId":238,"easy":"إذا أقمت مع المشركين ← برئت منك الذمة","cause":"مَنْ أقامَ مع المشركينَ","result":"فقدْ بَرِئَتْ مِنهُ الذِّمَّةُ","explicit":true,"ref":"صحيح الجامع 6073","srcLabel":"الطبراني","text":[["مَنْ أقامَ مع المشركينَ ، ",1],["فقدْ بَرِئَتْ مِنهُ الذِّمَّةُ",2]],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي عاصم في ((الآحاد والمثاني)) (2526)، وابن المنذر في ((الأوسط)) (6338)، والطبراني (2/ 302) (2261) بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"zbiZuvZe","merged":2,"otherRefs":["صحيح الجامع 2818 (حسن)"]},{"id":"س-00999","fp":"68a6421f8fb0","stateId":238,"easy":"إذا أشركت أو تكبرت ← حُجبت عن الله","cause":"عن الشِّرْكِ والكَبْرِ","result":"فإنَّهما يَحجُبانِ عن اللهِ","explicit":true,"ref":"الأحكام الوسطى 4/ 317","srcLabel":"السنة","text":["\"أَلَا أُخبِرُكم بوَصَيَّةِ نوحٍ ابنَه؟\"، قالوا: بَلى، قالَ: \"أَوْصى نوحٌ ابنَه فقالَ لابنِه: يا بُنَيَّ، إنِّي أوصيك باثْنتَينِ، وأَنْهاك عن اثْنتَينِ، أوصيك بقَوْلِ: لا إلهَ إلَّا اللهُ؛ فإنَّها لو وُضِعَتْ في كَفَّةٍ، ووُضِعَتِ السَّمَواتُ والأرْضُ في كَفَّةٍ لرَجَحَتْ بِهنَّ، ولو كانَت حَلْقةً لفَصَمَتْهنَّ حتَّى تَخلُصَ إلى اللهِ، وبقَوْلِ: سُبْحانَ اللهِ وبحَمْدِه؛ فإنَّها عِبادةُ الخَلْقِ، وبها تُقسَمُ أرْزاقُهم، وأَنْهاك عن اثْنتَينِ: ",["عن الشِّرْكِ والكَبْرِ",1],"؛ ",["فإنَّهما يَحجُبانِ عن اللهِ",2],"\"، قالَ: قيلَ: يا رَسولَ اللهِ، أَمِن الكِبْرِ أن يَتَّخِذَ الرَّجُلُ الطَّعامَ الطَّيِّبَ فتَكونَ عليه الجَماعةُ، أو يَلبَسَ القَميصَ النَّظيفَ؟ قالَ: \"ليس ذلك، يَعْني بالكِبْرِ، إنَّما الكِبْرُ أن تُسَفِّهَ الحَقَّ وتَغمِطَ النَّاسَ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","bab":"أدعية وأذكار › فضل الذكر","dorar":"JOywweiw"},{"id":"س-01745","fp":"933612505a9c","stateId":238,"easy":"إذا لم ترضَ بالله ← فلست من الله","cause":"ومَن لم يَرضَ باللَّهِ","result":"فليسَ منَ اللَّهِ","explicit":true,"ref":"صحيح ابن ماجه 1721","srcLabel":"ابن ماجه","text":["سمِعَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ رجلًا يحلِفُ بأبيهِ فقال: لا تحلِفوا بآبائِكُم، مَن حلَفَ باللَّهِ فليصدُقْ، ومَن حُلِفَ لَه باللَّهِ فليرضَ، ",["ومَن لم يَرضَ باللَّهِ",1]," ",["فليسَ منَ اللَّهِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (2101) واللفظ له، وأحمد (4523) بنحوه","bab":"أيمان › الحلف بالله وصفاته وكلماته","dorar":"dQ10SDlC"},{"id":"س-02591","fp":"fd8728f9aaeb","stateId":238,"easy":"إذا دخلت على المشركين في كنائسهم يوم عيدهم ← فالسخط ينزل عليهم","cause":"لا تَعَلَّموا رَطانةَ الأعاجِمِ ولا تَدْخُلوا على المُشرِكين في كَنائِسِهم يومَ عِيدِهم","result":"فإنَّ السَّخَطَ يَنْزِلُ عليهم","explicit":true,"ref":"الفتاوى الكبرى 2/ 485","srcLabel":"البيهقي","text":["قال عُمَرُ بنُ الخَطَّابِ رَضِيَ اللهُ عنه: ",["لا تَعَلَّموا رَطانةَ الأعاجِمِ ولا تَدْخُلوا على المُشرِكين في كَنائِسِهم يومَ عِيدِهم، ",1],["فإنَّ السَّخَطَ يَنْزِلُ عليهم",2]],"grade":"صحيح","narrator":"عطاء بن دينار","muhaddith":"[إسناده صحيح]","takhrij":"أخرجه المعافى في ((الزهد)) ()، وعبد الرزاق (1609)، والبيهقي (18893) واللفظ لهم.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"9iSJdDAA"},{"id":"س-05044","fp":"6ef782c02278","stateId":238,"easy":"إذا زدت في كتاب الله أو كذبت بالقدر أو تسلطت على الأمة بالجبروت ← لعنك الله ورسوله","cause":"الزَّائدُ في كتابِ اللَّهِ عزَّ وجلَّ والمُكَذِّبُ بقدرِ اللَّهِ والمتسلِّطُ على أمَّتي بالجبَروتِ ليُذِلَّ مَن أعزَّ اللَّهُ ويُعزَّ من أذلَّ اللَّهُ والمستَحلُّ حُرمةَ اللَّهِ والمستَحلُّ مِن عِترتي ما حرَّمَ اللَّهُ والتَّارِكُ السُّنَّةَ","result":"ستَّةٌ لعنتُهُم ولعنَهُمُ اللَّهُ","explicit":true,"ref":"الترغيب والترهيب 1/65","srcLabel":"الترمذي","text":[["ستَّةٌ لعنتُهُم ولعنَهُمُ اللَّهُ",2]," وَكُلُّ نبيٍّ مُجابٌ ",["الزَّائدُ في كتابِ اللَّهِ عزَّ وجلَّ والمُكَذِّبُ بقدرِ اللَّهِ والمتسلِّطُ على أمَّتي بالجبَروتِ ليُذِلَّ مَن أعزَّ اللَّهُ ويُعزَّ من أذلَّ اللَّهُ والمستَحلُّ حُرمةَ اللَّهِ والمستَحلُّ مِن عِترتي ما حرَّمَ اللَّهُ والتَّارِكُ السُّنَّةَ",1]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (2154)، وابن أبي عاصم في ((السنة)) (337)، وابن حبان (5749) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"vkvdltRa"},{"id":"س-04886","fp":"e3497adebfcc","stateId":238,"easy":"إذا لم تؤمن بالقدر خيره وشره ← فالنبي ﷺ منك بريء","cause":"مَن لم يُؤْمِنْ بالقَدَرِ خيرِه وشَرِّه","result":"فأنا منه بريءٌ","explicit":true,"ref":"الجامع الصغير 8998","srcLabel":"أبو يعلى","text":[["مَن لم يُؤْمِنْ بالقَدَرِ خيرِه وشَرِّه ، ",1],["فأنا منه بريءٌ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه أبو يعلى في ((مسنده)) (6404)، وابن عدي في ((الكامل)) (2/ 145)، وابن بطة في ((الإبانة)) (1882)  الخطيب البغدادي في ((المؤتنف)) (535) واللفظ لهم جميعا.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"TFEYnPKs"},{"id":"س-08281","fp":"124ed023bf71","stateId":238,"easy":"إذا ذبحت لغير الله ← لعنك الله","cause":"وفي رِوايةٍ : مَلعونٌ مَن ذَبَحَ لِغيرِ اللهِ","result":"لَعنَ اللهُ","explicit":true,"repOf":"س-05103","ref":"أحكام الجنائز 260","text":[["لَعنَ اللهُ",2],[" وفي رِوايةٍ : مَلعونٌ مَن ذَبَحَ لِغيرِ اللهِ ",1],"."],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه مطولاً أحمد (1875) واللفظ له، وابن حبان (4417)، والطبراني (11/218) (11546) باختلاف يسير","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"5bixOXfm"},{"id":"س-02379","fp":"6495eb422c0c","stateId":238,"easy":"إذا أقمت بين المشركين ← برئ منك النبي ﷺ","cause":"كلِّ مسلمٍ مع مشركٍ","result":"إني بريءٌ من","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-07192","ref":"شرح مسند الشافعي 5/223","text":["لجأ قومٌ إلى خثعمٍ فلما غشيهم المسلمون استعصموا بالسجودِ فقتلوا بعضَهم فبلغ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ فقال: أعطوهم نصفَ العَقلِ لصلاتِهم ثم قال بعد ذلك: ألا ",["إني بريءٌ من",2]," ",["كلِّ مسلمٍ مع مشركٍ",1]," قالوا: لِمَ؟ قال: لا تراءى ناراهما"],"grade":"صحيح","narrator":"قيس بن أبي حازم","muhaddith":"صحيح","takhrij":"أخرجه الشافعي في ((مسنده)) (صـ202) واللفظ له، والنسائي (4780)، وسعيد بن منصور في ((سننه)) (2663) باختلاف يسير.","bab":"إسلام › حرمة المسلم","dorar":"Dt8kaAVb","merged":2,"otherRefs":["صحيح النسائي 4794 (صحيح)"]},{"id":"س-01220","fp":"76c9dcb51ad2","stateId":238,"easy":"إذا أشركت أو تكبرت ← يحتجب الله عنك وصالح خلقه","cause":"أنهاكَ عن الشِّركِ والكِبْرِ","result":"فيحتَجبُ اللهُ منهُما وصالِحُ خلقِه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"صحيح الترغيب 1543","srcLabel":"النسائي","text":["قال نوحٌ لابنِهِ : إنِّي مُوصِيكَ بوصيَّةٍ وقاصِرُها لكي لا تنساها ؛ أُوصِيك باثنتَيْنِ ، وأنهاك عن اثنتيْنِ : أمَّا اللَّتانِ أُوصِيكَ بهِما ؛ فيستبشِرُ اللهُ بِهِما وصالِحُ خَلقِه ، وهما يُكثرانِ الوُلوجَ على اللهِ : أُوصِيك ب ( لا إلهَ إلَّا اللهُ ) ؛ فإنَّ السَّمواتِ والأرضِ لَو كانَتا حلقةً قَصمَتْهُما ، ولَو كانَتا في كفَّةٍ وزنتْهُما . وأُوصِيك ب ( سُبحانَ اللهِ وبِحَمدِه ) ؛ فإنَّهُما صلاةُ الخَلقِ ، وبهما يُرْزَقُ الخلقُ ،  وَإِنْ مِنْ شَيْءٍ إِلَّا يُسَبِّحُ بِحَمْدِهِ وَلَكِنْ لَا تَفْقَهُونَ تَسْبِيحَهُمْ إِنَّهُ كَانَ حَلِيمًا غَفُورًا  . وأمَّا اللَّتانِ أنهاك عَنهُما ؛ ",["فيحتَجبُ اللهُ منهُما وصالِحُ خلقِه",2]," : ",["أنهاكَ عن الشِّركِ والكِبْرِ",1]," ."],"grade":"صحيح","narrator":"رجل من الأنصار","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10600)، واللفظ له.","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"cBhXOPuB"},{"id":"س-01714","fp":"3c0122768602","stateId":238,"easy":"إذا زدت في كتاب الله أو كذّبت بالقدر أو تسلّطت بالجبروت ← تكون ممن لعنهم الله","cause":"الزائدُ في كتابِ اللهِ عزَّ وجلَّ ، والمكذبُ بقدرِ اللهِ والمُتسلطُ على أمتي بالجبروتِ ليُذِلَّ من أعزَّهُ اللهُ ويُعزَّ من أذلَّهُ اللهُ ، والمُستحِلُّ حرمةُ اللهِ ، والمستحلُّ من عِترَتي ما حرَّمَ اللهُ ، والتاركُ لسُنَّتي","result":"ستةٌ لعنَهمُ اللهُ وكلُّ نبيٍّ مجابُ الدعوةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"الزواجر عن اقتراف الكبائر 1/99","srcLabel":"السنة","text":[["ستةٌ لعنَهمُ اللهُ وكلُّ نبيٍّ مجابُ الدعوةِ ",2],":",[" الزائدُ في كتابِ اللهِ عزَّ وجلَّ ، والمكذبُ بقدرِ اللهِ والمُتسلطُ على أمتي بالجبروتِ ليُذِلَّ من أعزَّهُ اللهُ ويُعزَّ من أذلَّهُ اللهُ ، والمُستحِلُّ حرمةُ اللهِ ، والمستحلُّ من عِترَتي ما حرَّمَ اللهُ ، والتاركُ لسُنَّتي",1]],"grade":"صحيح","muhaddith":"صحيح","bab":"أنبياء › خصائص وفضائل","dorar":"ZKn9sn3M"},{"id":"س-02381","fp":"7654b321f84c","stateId":238,"easy":"إذا أقمت مع المشركين ← برئ منك النبي ﷺ","cause":"كُلِّ مسلمٍ أقام مع المُشرِكين","result":"أنا بريءٌ مِن","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-07192","ref":"سبل الهدى والرشاد 6/247","text":["عن خالِدِ بنِ الوليدِ رَضِيَ اللهُ تعالى عنه أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم بعَثَه إلى أناسٍ من خَثعَمٍ، فاعتَصَموا بالسُّجودِ، فقَتَلَهم، فوداهم رسولُ اللهِ صلَّى اللهُ عليه وسلَّم نِصفَ الدِّيةِ، ثُمَّ قال: ",["أنا بريءٌ مِن",2]," ",["كُلِّ مسلمٍ أقام مع المُشرِكين",1],"، لا تراءى ناراهما"],"grade":"حسن","narrator":"خالد بن الوليد","muhaddith":"رجاله ثقات.","takhrij":"أخرجه الطبراني في ((الكبير)) (4/ 114) (3836)، والطحاوي في ((مشكل الآثار)) (3233)، وابن أبي عاصم في ((الديات)) (صـ50) باختلاف يسير.","bab":"إسلام › حرمة المسلم","dorar":"bZfy1u1c"},{"id":"س-06120","fp":"8c4e839d0ddd","stateId":239,"easy":"إذا قلت للمنافق «سيد» ← فقد أسخطت ربك","cause":"لا تقولوا للمُنافقِ : سيِّدٌ","result":"فإنَّهُ إن يكُ سيِّدَكم فقد أسخطتُمْ ربَّكم عزَّ و جلَّ","explicit":true,"star":true,"similar":["س-02796"],"ref":"صحيح الأدب المفرد 584","srcLabel":"البخاري","text":[["لا تقولوا للمُنافقِ : سيِّدٌ ؛ ",1],["فإنَّهُ إن يكُ سيِّدَكم فقد أسخطتُمْ ربَّكم عزَّ و جلَّ",2]],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4977)، وأحمد (22939)، والبخاري في ((الأدب المفرد)) (‌760) واللفظ لهم.","bab":"رقائق وزهد › من أرضى الناس بسخط الله","dorar":"PZSg8ihF"},{"id":"ق-1230","fp":"18f5d5cecaad","stateId":239,"easy":"النفاق والشرك وظن السوء بالله ← دائرة السوء وغضب الله ولعنته وجهنم","cause":"النفاق والشرك وظن السوء بالله","result":"دائرة السوء وغضب الله ولعنته وجهنم","explicit":true,"star":true,"otherNeedIds":[57,49],"ref":"سورة الفتح: 6","srcLabel":"القرآن الكريم","quran":{"s":48,"from":6,"to":6,"text":"وَيُعَذِّبَ الْمُنَافِقِينَ وَالْمُنَافِقَاتِ وَالْمُشْرِكِينَ وَالْمُشْرِكَاتِ الظَّانِّينَ بِاللَّهِ ظَنَّ السَّوْءِ عَلَيْهِمْ دَائِرَةُ السَّوْءِ وَغَضِبَ اللَّهُ عَلَيْهِمْ وَلَعَنَهُمْ وَأَعَدَّ لَهُمْ جَهَنَّمَ وَسَاءَتْ مَصِيرًا (6)","hl":[[0,236,1]]}},{"id":"س-02796","fp":"d8a6b1ca318d","stateId":239,"easy":"إذا قلت للمنافق «يا سيدنا» ← أسخطت ربك","cause":"يُقالَ للمُنافِقِ: يا سيدَنا","result":"فإنَّه إنْ يَكُ سيدًا، فقد أسخَطْتم ربَّكم عزَّ وجلَّ","explicit":true,"repOf":"س-06120","ref":"تخريج زاد المعاد 2/321","text":["فمنَ الأولِ مَنعُه أنْ ",["يُقالَ للمُنافِقِ: يا سيدَنا",1],"، وقال: ",["فإنَّه إنْ يَكُ سيدًا، فقد أسخَطْتم ربَّكم عزَّ وجلَّ",2],"."],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4977)، وأحمد (22939)، والنسائي في ((السنن الكبرى)) (10002) باختلاف يسير.","bab":"إيمان › النفاق","dorar":"K45YQlw4","merged":4,"otherRefs":["الجامع الصغير 773 (صحيح)","المستدرك على الصحيحين 8078 (صحيح)","كشف الخفاء 2/484 (صحيح)"]},{"id":"س-05312","fp":"0c60091449be","stateId":239,"easy":"إذا التمست رضا الناس بسخط الله ← يسخط الله عليك ويسخط عليك الناس","cause":"ومن التَمس رضا الناسِ بسخَطِ اللهِ","result":"سخِط اللهُ عليه ، وأسخَط عليه الناسَ","explicit":true,"otherNeedIds":[39],"ref":"صحيح الترغيب 2250","srcLabel":"الترمذي","text":["من التمس رِضا اللهِ بسخَطِ الناسِ ؛ رضِيَ اللهُ عنه ، وأرْضى عنه الناسَ ، ",["ومن التَمس رضا الناسِ بسخَطِ اللهِ ، ",1],["سخِط اللهُ عليه ، وأسخَط عليه الناسَ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (2414) بنحوه، وعبد بن حميد في ((المسند)) (1522)، وابن حبان (277) باختلاف يسير","bab":"رقائق وزهد › التوكل واليقين","dorar":"HBgmugCR"},{"id":"س-06767","fp":"b63cbd560fe1","stateId":239,"easy":"إذا خادعت الله ← يخادعك","cause":"مَن يُخادِعِ اللَّهَ","result":"يخادِعْهُ","explicit":true,"ref":"نخب الافكار 11/52","srcLabel":"الطحاوي","text":["جاءَ رجلٌ إلى ابنِ عبَّاسٍ فقالَ: إنَّ عمِّي طلَّقَ امرأتَهُ ثلاثًا فقالَ: إنَّ عمَّكَ عصَى اللَّهَ فأثَّمَّهُ اللَّهُ وأطاعَ الشَّيطانَ فلم يجعَل لَهُ مخرجًا . فقُلتُ: فكيفَ ترى في رجلٍ يحلُّها لَهُ ؟ فقالَ ",["مَن يُخادِعِ اللَّهَ ",1],["يخادِعْهُ",2]],"grade":"صحيح","narrator":"مالك بن الحارث","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((معاني الآثار)) (4476) واللفظ له، وعبد الرزاق (10779)، وسعيد بن منصور في ((سننه)) (1065) باختلاف يسير.","bab":"طلاق › إمضاء الطلاق الثلاث بلفظ واحد إذا نوى","dorar":"vf0XMcuI"},{"id":"س-06883","fp":"e6a7e70b4c9e","stateId":239,"easy":"إذا أسخطت الله في رضا الناس ← يسخط عليك الله ويسخط عليك من أرضيتهم","cause":"مَن أسخَط اللهَ في رِضا النَّاسِ","result":"سخِطَ اللهُ عليه وأسخَط عليه مَن أرضاه في سَخَطِه","explicit":true,"otherNeedIds":[39],"ref":"مجمع الزوائد 10/227","srcLabel":"الطبراني","text":[["مَن أسخَط اللهَ [ في رِضا النَّاسِ",1]," ",["سخِطَ اللهُ عليه ] وأسخَط عليه مَن أرضاه في سَخَطِه",2]," ومَن أرضى اللهَ في سَخَطِ النَّاسِ رضِيَ اللهُ عنه وأرضى عنه مَن أسخَطه في رِضاه حتَّى يُزَيِّنَه ويُزَيِّنَ قولَه وعملَه في عينِه"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"رجاله رجال الصحيح غير يحيى بن سليمان الحفري وقد وثقه الذهبي","takhrij":"أخرجه  الطبراني (11/268) (11696)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"3rZo1QHq"},{"id":"س-04892","fp":"ab9f46be9abe","stateId":239,"easy":"إذا قمت مقام رياء وسمعة ← فأنت في مقت الله حتى تجلس","cause":"منْ قامَ مقامَ رياءٍ وسمعةٍ","result":"فإنَّه في مقتِ اللهِ حتى يجلسَ","explicit":true,"ref":"الجامع الصغير 8886","srcLabel":"أبو نعيم","text":[["منْ قامَ مقامَ رياءٍ وسمعةٍ،  ",1],["فإنَّه في مقتِ اللهِ حتى يجلسَ",2]],"grade":"حسن","narrator":"عبدالله بن الأقرم الخزاعي","muhaddith":"حسن","takhrij":"أخرجه أبو نعيم في ((معرفة الصحابة)) (4450) بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"wy9vdA7u"},{"id":"س-02736","fp":"74f787fc0073","stateId":240,"easy":"إذا أحدثت حدثاً أو آويت محدثاً ← فعليك لعنة الله والملائكة والناس أجمعين","cause":"مَن أَحدَث حدَثًا، أو آوَى مُحدِثًا","result":"فعليه لعنةُ اللهِ والملائكةِ والنَّاسِ أَجمَعينَ، لا يُقبَلُ منه صَرْفٌ ولا عَدْلٌ","explicit":true,"star":true,"otherNeedIds":[45],"ref":"تخريج المسند لشعيب 959","srcLabel":"متفق عليه","text":["عن أبي حسَّانَ: أنَّ عليًّا كان يأْمُرُ بالأَمرِ فيُؤْتى، فيُقالُ: قد فعَلْنا كذا وكذا، فيقولُ: صدَق اللهُ ورسولُه، قال: فقال له الأَشتَرُ: إنَّ هذا الذي تقولُ قد تَفشَّغَ في النَّاسِ، أَفَشيءٌ عهِده إليكَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ قال عليٌّ: ما عهِد إليَّ رسولُ اللهُ صلَّى اللهُ عليه وسلَّمَ شيئًا خاصَّةً دونَ النَّاسِ، إلَّا شيءٌ سمِعْتُه منه فهو في صَحيفةٍ في قِرابِ سَيْفي، قال: فلم يَزالوا به حتى أَخرَج الصَّحيفةَ، قال: فإذا فيها: ",["مَن أَحدَث حدَثًا، أو آوَى مُحدِثًا ",1],["فعليه لعنةُ اللهِ والملائكةِ والنَّاسِ أَجمَعينَ، لا يُقبَلُ منه صَرْفٌ ولا عَدْلٌ",2],"، قال: وإذا فيها: إنَّ إبراهيمَ حرَّم مكَّةَ، وإنِّي أُحرِّمُ المدينةَ، حرامٌ ما بيْنَ حَرَّتَيْها وحِماها كلُّه، لا يُخْتَلى خَلاها، ولا يُنَفَّرُ صَيْدُها، ولا تُلتقَطُ لُقَطَتُها، إلَّا لمَن أشار بها، ولا تُقطَعُ منها شَجرةٌ إلَّا أنْ يَعلِفَ رجُلٌ بَعيرَه، ولا يُحمَلُ فيها السِّلاحُ لِقتالٍ، قال: وإذا فيها: المُؤمنونَ تَتَكافأُ دِماؤُهم، ويَسْعى بذِمَّتِهم أَدْناهم، وهم يَدٌ على مَن سِواهم، ألَا لا يُقتَلُ مُؤمنٌ بكافرٍ، ولا ذو عهْدٍ في عهْدِه."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح لغيره","takhrij":"أخرجه من طرق البخاري (3179)، ومسلم (1370)، وأبو داود (2034، 2035) مفرقاً، والنسائي في ((السنن الكبرى)) (8681)، وأحمد (959) واللفظ له","bab":"إيمان › الملائكة","dorar":"cewKVyJu","merged":8,"otherRefs":["صحيح ابن حبان 3716 (صحيح)","تخريج المسند لشعيب 13540 (صحيح)","الأحكام الوسطى 3/113 (صحيح)","تخريج المسند لشعيب 13499 (صحيح)","تخريج المسند لشعيب 1037 (صحيح)","الزواجر عن اقتراف الكبائر 1/99 (صحيح)","تخريج المسند لشعيب 1298 (صحيح)"]},{"id":"س-07008","fp":"d1ca8348e396","stateId":240,"easy":"إذا رغبت عن سنة النبي ﷺ ← فلست منه","cause":"فمَنْ رغِبَ عن سُنَّتي","result":"فليس منِّي","explicit":true,"star":true,"otherNeedIds":[49],"ref":"تخريج المسند لشعيب 6477","srcLabel":"متفق عليه","text":["قال: زوَّجَني أبي امرأةً مِن قُرَيشٍ، فلمَّا دخَلَتْ علَيَّ جعَلْتُ لا أنْحاشُ لها؛ ممَّا بي مِن القوَّةِ على العِبادةِ، مِن الصَّومِ والصَّلاةِ، فجاء عمرُو بنُ العاصِ إلى كَنَّتِه، حتى دخَلَ عليها، فقال لها: كيف وجَدْتِ بعْلَكِ؟ قالت: خيْرَ الرِّجالِ -أوْ كَخيْرِ البُعولةِ مِن رجُلٍ-؛ لم يُفتِّشْ لنا كَنَفًا، ولم يَعرِفْ لنا فِراشًا، فأقبَلَ علَيَّ، فعَذَمني وعضَّني بلِسانِه، فقال: أنْكحْتُكَ امرأةً من قُريشٍ ذاتَ حسَبٍ، فعضَلْتَها، وفعلْتَ، وفعلْتَ! ثُمَّ انطلَقَ إلى النبيِّ صلَّى اللهُ عليه وسلَّمَ فشَكاني، فأرسَلَ إليَّ النبيُّ صلَّى اللهُ عليه وسلَّمَ فأتَيْتُه، فقال لي: أتصومُ النَّهارَ؟ قُلْتُ: نعمْ، قال: وتقومُ اللَّيلَ؟ قُلْتُ: نعمْ، قال: لكِنِّي أصومُ وأُفطِرُ، وأُصلِّي وأنامُ، وأَمَسُّ النِّساءَ، ",["فمَنْ رغِبَ عن سُنَّتي ",1],["فليس منِّي",2],".\nقال: اقْرَأِ القرآنَ في كلِّ شهرٍ، قُلْتُ: إنِّي أجِدُني أقوَى مِن ذلك، قال: فاقرَأْه في كلِّ عشَرةِ أيَّامٍ، قُلْتُ: إنِّي أجِدُني أقوَى مِن ذلك، -قال أحدُهما؛ إمَّا حُصَينٌ وإمَّا مُغيرةُ قال: فاقرَأْه في كلِّ ثلاثٍ- قال: ثُمَّ قال: صُمْ في كلِّ شهرٍ ثلاثةَ أيَّامٍ، قُلْتُ: إنِّي أقوَى مِن ذلك، قال: فلم يزَلْ يرفَعُني حتى قال: صُمْ يومًا وأفطِرْ يومًا؛ فإنَّه أفضلُ الصِّيامِ، وهو صيامُ أخي داوُدَ صلَّى اللهُ عليه وسلَّمَ.\nقال حُصَينٌ في حديثِه: ثُمَّ قال صلَّى اللهُ عليه وسلَّمَ: فإنَّ لِكلِّ عابدٍ شِرَّةً، ولِكلِّ شِرَّةٍ فَترَةٌ، فإمَّا إلى سُنَّةٍ، وإمَّا إلى بدعةٍ، فمَن كانتْ فَترتُه إلى سُنَّةٍ، فقدِ اهْتَدَى، ومَن كانتْ فَترتُه إلى غيرِ ذلك فقد هلَك. قال مجاهدٌ: فكان عبدُ اللهِ بنُ عمرٍو حيثُ ضعُف وكبِر يصومُ الأيَّامَ كذلك، يصِلُ بعضَها إلى بعضٍ؛ لِيتقوَّى بذلك، ثُمَّ يُفطِرُ بعدَ تلك الأيَّامِ، قال: وكان يَقْرَأُ في كلِّ حِزْبِه كذلك، يَزيدُ أحيانًا، ويَنقُصُ أحيانًا، غيرَ أنَّه يُوَفِّي العَددَ؛ إمَّا في سَبعٍ، وإمَّا في ثلاثٍ، قال: ثُمَّ كان يقولُ بعدَ ذلك: لأَنْ أكونَ قبِلتُ رُخصةَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أحَبُّ إليَّ ممَّا عُدِلَ به -أو عدَل- لكنِّي فارَقْتُه على أمْرٍ أكرَهُ أنْ أُخالِفَه إلى غيرِه."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (5052)، ومسلم (1159)، والنسائي (2390)، وأحمد (6477) واللفظ له","bab":"علم › الحث على الأخذ بالسنة","dorar":"6BXZvhjv","merged":10,"otherRefs":["السلسلة الصحيحة 394 (حسن)","صحيح البخاري 5063 (صحيح)","منهاج السنة 4/29 (صحيح)","تخريج شرح السنة 2/371 (حسن)","مجمع الزوائد 3/196 (صحيح)","تخريج مشكل الآثار 1240 (صحيح)","صحيح الجامع 4946 (حسن)","تخريج المسند لشعيب 14045 (صحيح)","صحيح الجامع 1336 (صحيح)"]},{"id":"س-07612","fp":"7445bad6b226","stateId":240,"easy":"إذا اتخذت قبور الأنبياء مساجد ← عليك لعنة الله كاليهود والنصارى","cause":"اليَهودِ والنَّصارى؛ اتَّخَذوا قُبورَ أنبيائِهم مَساجِدَ، يُحَذِّرُ ما صَنَعوا","result":"لَعنةُ اللهِ على","explicit":true,"star":true,"ref":"صحيح البخاري 435","srcLabel":"مسلم","text":["أنَّ عائِشةَ وعَبدَ اللهِ بنَ عَبَّاسٍ قالا: لَمَّا نَزَلَ برَسولِ اللهِ صلَّى اللهُ عليه وسلَّم طَفِقَ يَطرَحُ خَميصةً له على وجههِ، فإذا اغتَمَّ بها كَشَفَها عن وجههِ، فقال وهو كَذلك: ",["لَعنةُ اللهِ على",2],[" اليَهودِ والنَّصارى؛ اتَّخَذوا قُبورَ أنبيائِهم مَساجِدَ، يُحَذِّرُ ما صَنَعوا",1],"."],"grade":"صحيح","narrator":"عبدالله بن عباس وعائشة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (531)، والنسائي (703)، وابن الجارود (175) واللفظ لهم","bab":"فضائل النبي وصفته ودلائل النبوة › مرض النبي وموته","dorar":"nd7kF4Vn","merged":12,"otherRefs":["تخريج المسند لشعيب 21775 (صحيح)","صحيح الجامع 5108 (صحيح)","تخريج المسند لشعيب 8788 (صحيح)","مجموع الفتاوى 24/335 (صحيح)","النصيحة 144 (صحيح)","تخريج المسند لشعيب 26178 (صحيح)","تخريج المسند لشعيب 25916 (صحيح)","تخريج المسند لشاكر 3/270 (صحيح)","صحيح البخاري 1330 (صحيح)","صحيح مسلم 529 (صحيح)","مجموع الفتاوى 27/34 (صحيح)"]},{"id":"س-03703","fp":"101c8993f5d6","stateId":240,"easy":"إذا عصيت النبي ﷺ ← فقد عصيت الله","cause":"ومَن عَصاني","result":"فقد عَصَى اللَّهَ","explicit":true,"star":true,"ref":"صحيح ابن خزيمة 3/ 104","srcLabel":"متفق عليه","text":["مَن أطاعَني فَقد أطاعَ اللَّهَ، ",["ومَن عَصاني",1]," ",["فقد عَصَى اللَّهَ",2],"، ومن أطاعَ الأميرَ فقد أطاعَني، ومَن عصا الأميرَ فقد عَصاني، إنَّما الإمامُ جنَّةٌ، فإذا صلَّى قاعدًا فصلُّوا قعودًا، وإذا قالَ: سمِعَ اللَّهُ لمن حمدَهُ، فقولوا: اللَّهمَّ ربَّنا لَكَ الحمدُ، فإذا وافقَ قَولُ أَهْلِ الأرضِ قولَ أَهْلِ السَّماءِ غُفِرَ لَهُ ما مضَى مِن ذنبِهِ، ويَهْلِكُ كِسرى ولا كِسرى بعدُ، ويَهْلِكُ قَيصرُ فلا قَيصرَ مِن بعدِهِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (7137)، ومسلم (1835)، والنسائي (4193) بلفظه مختصرًا.","bab":"اعتصام بالسنة › لزوم السنة","dorar":"KojlJ7bG","merged":3,"otherRefs":["صحيح النسائي 5525 (صحيح)","صحيح البخاري 2957 (صحيح)"]},{"id":"س-07606","fp":"4ae74dd03579","stateId":240,"easy":"إذا بنيت على القبر مسجداً وصورت فيه ← تكون من شرار الخلق عند الله","cause":"بنَوْا على قبرِه مسجدًا ثمَّ صوَّروا فيه تلك الصُّوَرَ","result":"شِرارُ الخَلْقِ عندَ اللهِ","explicit":true,"star":true,"otherNeedIds":[57,26],"ref":"تخريج صحيح ابن حبان 3181","srcLabel":"متفق عليه","text":["لمَّا كان مرَضُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم ذكَر بعضُ نسائِه كنيسةً رأياها بأرضِ الحبشةِ وكانت أمُّ سلَمةَ وأمُّ حبيبةَ قد أتَتا أرضَ الحبشةِ فذكَرْنَ كنيسةً رأَيْنَها بأرضِ الحبشةِ يُقالُ لها ماريةُ وذكَرْنَ مِن حُسنِها وتصاويرَ فيها فرفَع النَّبيُّ صلَّى اللهُ عليه وسلَّم رأسَه فقال: ( إنَّ أولئكِ إذا مات منهم الرَّجلُ الصَّالحُ ",["بنَوْا على قبرِه مسجدًا ثمَّ صوَّروا فيه تلك الصُّوَرَ",1]," وأولئكِ ",["شِرارُ الخَلْقِ عندَ اللهِ",2]," تعالى )"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (1341)، ومسلم (528)، والنسائي (704)، بلفظ مقارب.","bab":"فضائل النبي وصفته ودلائل النبوة › مرض النبي وموته","dorar":"fkdJACnI","merged":3,"otherRefs":["الرسائل الشخصية لابن عبد الوهاب 45 (صحيح)","صحيح ابن خزيمة 2/ 27 (صحيح)"]},{"id":"س-07613","fp":"c840f76eb188","stateId":240,"easy":"إذا اتخذت القبور مساجد ← تكون من شرار الناس","cause":"الَّذين يَتَّخِذونَ القُبورَ مَساجِدَ","result":"أنَّ شِرارَ النَّاسِ","explicit":true,"otherNeedIds":[57,12],"ref":"الأحاديث المختارة 1123","srcLabel":"البخاري","text":["«كانَ آخِرُ ما تَكلَّمَ به نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ أن أَخْرِجوا يَهودَ الحِجازِ مِن جَزيرةِ العَربِ، واعْلَموا ",["أنَّ شِرارَ النَّاسِ",2]," ",["الَّذين يَتَّخِذونَ القُبورَ مَساجِدَ",1],"»."],"grade":"صحيح","narrator":"أبو عبيدة بن الجراح","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"فضائل النبي وصفته ودلائل النبوة › مرض النبي وموته","dorar":"ofLaxHBS","merged":3,"otherRefs":["صحيح ابن خزيمة 2/ 27 (صحيح)","صحيح ابن حبان 6847 (صحيح)"]},{"id":"س-08286","fp":"6cedda35b68b","stateId":240,"easy":"إذا أحدثت حدثاً ← لعنك الله","cause":"من أحدثَ حدثًا","result":"لعنَ اللهُ","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 1/99","srcLabel":"متفق عليه","text":[["لعنَ اللهُ",2]," ",["من أحدثَ حدثًا",1]," [يعني حديث: خَطَبَنَا عَلِيُّ بنُ أَبِي طَالِبٍ، فَقالَ: مَن زَعَمَ أنَّ عِنْدَنَا شيئًا نَقْرَؤُهُ إلَّا كِتَابَ اللهِ وَهذِه الصَّحِيفَةَ، قالَ: وَصَحِيفَةٌ مُعَلَّقَةٌ في قِرَابِ سَيْفِهِ، فقَدْ كَذَبَ، فِيهَا أَسْنَانُ الإبِلِ، وَأَشْيَاءُ مِنَ الجِرَاحَاتِ، وَفِيهَا قالَ النبيُّ صَلَّى اللَّهُ تَعَالَى عليه وسلَّمَ: المَدِينَةُ حَرَمٌ ما بيْنَ عَيْرٍ إلى ثَوْرٍ ، فمَن أَحْدَثَ فِيهَا حَدَثًا، أَوْ آوَى مُحْدِثًا، فَعليه لَعْنَةُ اللهِ وَالْمَلَائِكَةِ وَالنَّاسِ أَجْمَعِينَ، لا يَقْبَلُ اللَّهُ منه يَومَ القِيَامَةِ صَرْفًا، وَلَا عَدْلًا، وَذِمَّةُ المُسْلِمِينَ وَاحِدَةٌ، يَسْعَى بهَا أَدْنَاهُمْ، وَمَنِ ادَّعَى إلى غيرِ أَبِيهِ، أَوِ انْتَمَى إلى غيرِ مَوَالِيهِ، فَعليه لَعْنَةُ اللهِ وَالْمَلَائِكَةِ وَالنَّاسِ أَجْمَعِينَ، لا يَقْبَلُ اللَّهُ منه يَومَ القِيَامَةِ صَرْفًا، وَلَا عَدْلًا. وَانْتَهَى حَديثُ أَبِي بَكْرٍ، وَزُهَيْرٍ عِنْدَ قَوْلِهِ يَسْعَى بهَا أَدْنَاهُمْ، وَلَمْ يَذْكُرَا ما بَعْدَهُ. وَليسَ في حَديثِهِمَا: مُعَلَّقَةٌ في قِرَابِ سَيْفِهِ.]"],"grade":"صحيح","narrator":"[علي بن أبي طالب]","muhaddith":"صحيح","takhrij":"أخرجه البخاري (3179)، ومسلم (1370)، وأبو داود (2034) جميعا بلفظ مقارب مطولا.","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"bBgSaJum","merged":2,"otherRefs":["تخريج المسند لشعيب 855 (صحيح)"]},{"id":"س-03673","fp":"f89d4fa102aa","stateId":240,"easy":"إذا عصيت الأمير ← فقد عصيت النبي ﷺ","cause":"ومَن يَعصِ الأميرَ","result":"فقد عَصاني","explicit":true,"similar":["س-03705"],"ref":"صحيح البخاري 2957","srcLabel":"متفق عليه","text":["مَن أطاعَني فقد أطاعَ اللهَ، ومَن عَصاني فقد عَصى اللهَ، ومَن يُطِعِ الأميرَ فقد أطاعَني، ",["ومَن يَعصِ الأميرَ",1]," ",["فقد عَصاني",2],"، وإنَّما الإمامُ جُنَّةٌ يُقاتَلُ مِن ورائِه ويُتَّقى به، فإن أمَرَ بتَقوى اللهِ وعَدَلَ فإنَّ له بذلك أجرًا، وإن قال بغَيرِه فإنَّ عليه منه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2957)، ومسلم (1835)","bab":"اعتصام بالسنة › الأمر بالتمسك بالكتاب والسنة","dorar":"50wib7r4"},{"id":"س-03705","fp":"641743cc2ebf","stateId":240,"easy":"إذا عصيت الأمير ← فقد عصيت النبي ﷺ","cause":"ومَن عصا الأميرَ","result":"فقد عَصاني","explicit":true,"repOf":"س-03673","ref":"صحيح ابن خزيمة 3/ 104","text":["مَن أطاعَني فَقد أطاعَ اللَّهَ، ومَن عَصاني فقد عَصَى اللَّهَ، ومن أطاعَ الأميرَ فقد أطاعَني، ",["ومَن عصا الأميرَ",1]," ",["فقد عَصاني",2],"، إنَّما الإمامُ جنَّةٌ، فإذا صلَّى قاعدًا فصلُّوا قعودًا، وإذا قالَ: سمِعَ اللَّهُ لمن حمدَهُ، فقولوا: اللَّهمَّ ربَّنا لَكَ الحمدُ، فإذا وافقَ قَولُ أَهْلِ الأرضِ قولَ أَهْلِ السَّماءِ غُفِرَ لَهُ ما مضَى مِن ذنبِهِ، ويَهْلِكُ كِسرى ولا كِسرى بعدُ، ويَهْلِكُ قَيصرُ فلا قَيصرَ مِن بعدِهِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (7137)، ومسلم (1835)، والنسائي (4193) بلفظه مختصرًا.","bab":"اعتصام بالسنة › لزوم السنة","dorar":"KojlJ7bG"},{"id":"س-07686","fp":"56b7d4fe2b34","stateId":240,"easy":"إذا مت على غير السنة ← فلست من النبي ﷺ","cause":"مَن ماتَ على غيْرِ هذا","result":"فليس مِنِّي","explicit":true,"ref":"الأحاديث المختارة 8 / 274","srcLabel":"متفق عليه","text":["«يا بُنَيَّ، إنَّك لن تَجِدَ طَعْمَ حَقيقةِ الإيمانِ حتَّى تَتَعلَّمَ أنَّ ما أصابَك لم يكنْ ليُخْطِئَك، وما أَخْطَأَك لم يكنْ ليُصيبَك، سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: (إنَّ أوَّلَ ما خَلَقَ اللهُ القَلَمُ، فقالَ له: اكْتُبْ، قالَ: رَبِّ وماذا أَكتُبُ؟ قالَ: اكْتُبْ مَقاديرَ كلِّ شيءٍ حتَّى تَقومَ السَّاعةُ) يا بُنَيَّ، سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: (",["مَن ماتَ على غيْرِ هذا ",1],["فليس مِنِّي)»",2],"."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"قدر › كل شيء بقدر","dorar":"KuxAfTTD"},{"id":"ق-0054","fp":"c8f90fe0553c","stateId":240,"easy":"كتمان ما أنزل الله من البينات والهدى ← لعنة الله واللاعنين","cause":"كتمان ما أنزل الله من البينات والهدى","result":"لعنة الله واللاعنين","explicit":true,"ref":"سورة البقرة: 159","srcLabel":"القرآن الكريم","quran":{"s":2,"from":159,"to":159,"text":"إِنَّ الَّذِينَ يَكْتُمُونَ مَا أَنْزَلْنَا مِنَ الْبَيِّنَاتِ وَالْهُدَى مِنْ بَعْدِ مَا بَيَّنَّاهُ لِلنَّاسِ فِي الْكِتَابِ أُولَئِكَ يَلْعَنُهُمُ اللَّهُ وَيَلْعَنُهُمُ اللَّاعِنُونَ (159)","hl":[[0,186,1]]}},{"id":"ق-0058","fp":"8d1d19278867","stateId":240,"easy":"كتمان الكتاب وبيعه بثمن قليل ← النار في البطون ولا يكلمهم الله ولا يزكيهم وعذاب أليم","cause":"كتمان الكتاب وبيعه بثمن قليل","result":"النار في البطون ولا يكلمهم الله ولا يزكيهم وعذاب أليم","explicit":true,"otherNeedIds":[57],"ref":"سورة البقرة: 174","srcLabel":"القرآن الكريم","quran":{"s":2,"from":174,"to":174,"text":"إِنَّ الَّذِينَ يَكْتُمُونَ مَا أَنْزَلَ اللَّهُ مِنَ الْكِتَابِ وَيَشْتَرُونَ بِهِ ثَمَنًا قَلِيلًا أُولَئِكَ مَا يَأْكُلُونَ فِي بُطُونِهِمْ إِلَّا النَّارَ وَلَا يُكَلِّمُهُمُ اللَّهُ يَوْمَ الْقِيَامَةِ وَلَا يُزَكِّيهِمْ وَلَهُمْ عَذَابٌ أَلِيمٌ (174)","hl":[[0,250,1]]}},{"id":"ق-0290","fp":"a8f3f51fe726","stateId":240,"easy":"نقض الميثاق ← اللعنة وقسوة القلب وتحريف الكلم ونسيان حظ من الذكر","cause":"نقض الميثاق","result":"اللعنة وقسوة القلب وتحريف الكلم ونسيان حظ من الذكر","explicit":true,"otherNeedIds":[19],"ref":"سورة المائدة: 13","srcLabel":"القرآن الكريم","quran":{"s":5,"from":13,"to":13,"text":"فَبِمَا نَقْضِهِمْ مِيثَاقَهُمْ لَعَنَّاهُمْ وَجَعَلْنَا قُلُوبَهُمْ قَاسِيَةً يُحَرِّفُونَ الْكَلِمَ عَنْ مَوَاضِعِهِ وَنَسُوا حَظًّا مِمَّا ذُكِّرُوا بِهِ وَلَا تَزَالُ تَطَّلِعُ عَلَى خَائِنَةٍ مِنْهُمْ إِلَّا قَلِيلًا مِنْهُمْ فَاعْفُ عَنْهُمْ وَاصْفَحْ إِنَّ اللَّهَ يُحِبُّ الْمُحْسِنِينَ (13)","hl":[[0,156,1]]}},{"id":"ق-0328","fp":"29b6bd40ac56","stateId":240,"easy":"العصيان والاعتداء وترك التناهي عن المنكر ← اللعن على ألسنة الأنبياء","cause":"العصيان والاعتداء وترك التناهي عن المنكر","result":"اللعن على ألسنة الأنبياء","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة المائدة: 78–79","srcLabel":"القرآن الكريم","quran":{"s":5,"from":78,"to":79,"text":"لُعِنَ الَّذِينَ كَفَرُوا مِنْ بَنِي إِسْرَائِيلَ عَلَى لِسَانِ دَاوُودَ وَعِيسَى ابْنِ مَرْيَمَ ذَلِكَ بِمَا عَصَوْا وَكَانُوا يَعْتَدُونَ (78) كَانُوا لَا يَتَنَاهَوْنَ عَنْ مُنْكَرٍ فَعَلُوهُ لَبِئْسَ مَا كَانُوا يَفْعَلُونَ (79)","hl":[[0,227,1]]}},{"id":"ق-0388","fp":"54146b3b8101","stateId":240,"easy":"تفريق الدين والتشيّع ← براءة النبي منهم","cause":"تفريق الدين والتشيّع","result":"براءة النبي منهم","explicit":true,"otherNeedIds":[39],"ref":"سورة الأنعام: 159","srcLabel":"القرآن الكريم","quran":{"s":6,"from":159,"to":159,"text":"إِنَّ الَّذِينَ فَرَّقُوا دِينَهُمْ وَكَانُوا شِيَعًا لَسْتَ مِنْهُمْ فِي شَيْءٍ إِنَّمَا أَمْرُهُمْ إِلَى اللَّهِ ثُمَّ يُنَبِّئُهُمْ بِمَا كَانُوا يَفْعَلُونَ (159)","hl":[[0,80,1]]}},{"id":"س-00824","fp":"3f3131de8d93","stateId":240,"easy":"إذا أفتيت بغير علم فهلك المستفتي ← فقد قتلته","cause":"فاسْتَفْتى، فأُفْتِيَ بالغُسْلِ، فاغْتَسَلَ فماتَ","result":"قَتَلوه قَتَلَهم اللهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-07048"],"otherNeedIds":[12],"ref":"الأحاديث المختارة 11 / 214","srcLabel":"متفق عليه","text":["«أنَّ رَجُلًا أصابَتْه جِراحةٌ على عَهْدِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فأصابَتْه جَنابةٌ، ",["فاسْتَفْتى، فأُفْتِيَ بالغُسْلِ، فاغْتَسَلَ فماتَ",1],"، فبَلَغَ ذلك النَّبيَّ صلَّى اللهُ عليه وسلَّمَ فقالَ: ",["قَتَلوه قَتَلَهم اللهُ",2],"، أَلَمْ يكنْ شِفاءَ العِيِّ السُّؤالُ.\n207 - قالَ عَطاءٌ: فبَلَغَني أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ سُئِلَ عن ذلك بَعْدُ، فقالَ: لو غَسَلَ جَسَدَه وتَرَكَ رَأسَه حيثُ أصابَه الجِراحُ لأَجْزَأَه»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"أدعية وأذكار › دعاء النبي على بعض الأشخاص والأشياء والأمور","dorar":"gOyC2sgF"},{"id":"س-04068","fp":"ced0b320bc5d","stateId":240,"easy":"إذا اقتدت أباك أعمى إلى منكر ← لعن الله القائد والمقود (أثر)","cause":"فأخَذَ بيَدِ أبيه فأخْرَجَه مِن المَسجِدِ","result":"لَعَنَ اللهُ القايِدَ والمَقودَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأحاديث المختارة 8 / 179","srcLabel":"متفق عليه","text":["«دَخَلْتُ مَسجِدَ المَدينةِ فإذا النَّاسُ يَقولونَ: نَعوذُ باللهِ مِن غَضَبِ اللهِ وغَضَبِ رَسولِه، قالَ: قُلْتُ: ماذا؟ قالوا: كانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يَخطُبُ على مِنبَرِه، فقامَ رَجُلٌ ",["فأخَذَ بيَدِ أبيه فأخْرَجَه مِن المَسجِدِ",1],"، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: (",["لَعَنَ اللهُ القايِدَ والمَقودَ",2],"، وَيْلٌ لِهذه الأمَّةِ مِن فُلانٍ ذي الأسْتاهِ»)."],"grade":"صحيح","narrator":"عاصم بن عدي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"جمعة › خطبة النبي صلى الله عليه وسلم","dorar":"99Vy2uEK"},{"id":"س-07428","fp":"cdd442ad6d1b","stateId":240,"easy":"إذا طعنت على أمرائك وشهدت عليهم بالضلالة ← فعليك لعنة الله والملائكة والناس","cause":"يَطعنونَ على أُمرائِهم ويَشهدون عليهِم بالضَّلالةِ","result":"أولئكَ عليهِم لعنةُ اللَّهِ والملائكةِ والنَّاسِ أجمعينَ","explicit":true,"ref":"الفتاوى الحديثية للوادعي 1/424","srcLabel":"ابن أبي عاصم","text":["عنْ عُقبةَ بْنِ وَسَّاجٍ قالَ صاحبٌ لي يُحدثُني عن شأنِ الخوارجِ وطَعنِهم على أُمَرائِهِم فحَجَجتُ فلَقيتُ عبدَ اللَّهِ بنَ عمرٍو فقلتُ له: أنتَ من أصحابِ رسولِ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ وقد جعل اللَّهُ عندَك علمًا، وأناسٌ بهذا العِراقِ ",["يَطعنونَ على أُمرائِهم ويَشهدون عليهِم بالضَّلالةِ",1]," فقال لي: ",["أولئكَ عليهِم لعنةُ اللَّهِ والملائكةِ والنَّاسِ أجمعينَ",2]," أُتِىَ رسولُ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ بقَلِيدٍ من ذهبٍ وفضةٍ فجعل يَقسِمُها بين أصحابِه فقام رجلٌ من أهلِ الباديةِ فقال: يا محمَّدُ واللَّه لئِن أمرك اللَّهُ أن تَعْدِلَ فما أراكَ أن تعدِلَ فقال: ويحَكَ من يعدِلُ عليه بعدي فلمَّا وَلَّى قال: ردُّوهُ رُوَيدًا فقال النبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ: إنَّ في أمَّتي أخًا لهذا يقرءونَ القرآنَ لا يُجاوِزُ تراقيَهم كمَا  خرجوا فاقتلوهُم ثلاثًا"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (934)، والبزار كما في ((كشف الأستار)) للهيثمي (1850) باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"3amZLdGk","merged":2,"otherRefs":["مجمع الزوائد 6/231 (صحيح)"]},{"id":"س-00609","fp":"6889a02ca376","stateId":240,"easy":"إذا عصيت محمداً ﷺ ← فقد عصيت الله","cause":"ومَن عَصى مُحَمَّدًا","result":"فقد عَصى اللهَ","explicit":true,"ref":"صحيح البخاري 7281","srcLabel":"الترمذي","text":["جاءَت مَلائِكةٌ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم وهو نائِمٌ، فقال بَعضُهم: إنَّه نائِمٌ، وقال بَعضُهم: إنَّ العَينَ نائِمةٌ، والقَلبَ يَقظانُ، فقالوا: إنَّ لصاحِبِكُم هذا مَثَلًا، فاضرِبوا له مَثَلًا، فقال بَعضُهم: إنَّه نائِمٌ، وقال بَعضُهم: إنَّ العَينَ نائِمةٌ، والقَلبَ يَقظانُ، فقالوا: مَثَلُه كَمَثَلِ رَجُلٍ بَنى دارًا، وجَعَلَ فيها مَأدُبةً وبَعَثَ داعيًا، فمَن أجابَ الدَّاعيَ دَخَلَ الدَّارَ وأكَلَ مِنَ المَأدُبةِ، ومَن لَم يُجِبِ الدَّاعيَ لَم يَدخُلِ الدَّارَ ولَم يَأكُلْ مِنَ المَأدُبةِ، فقالوا: أوِّلوها له يَفقَهْها، فقال بَعضُهم: إنَّه نائِمٌ، وقال بَعضُهم: إنَّ العَينَ نائِمةٌ، والقَلبَ يَقظانُ، فقالوا: فالدَّارُ الجَنَّةُ، والدَّاعي مُحَمَّدٌ صلَّى اللهُ عليه وسلَّم، فمَن أطاعَ مُحَمَّدًا صلَّى اللهُ عليه وسلَّم فقد أطاعَ اللهَ، ",["ومَن عَصى مُحَمَّدًا",1]," صلَّى اللهُ عليه وسلَّم ",["فقد عَصى اللهَ",2],"، ومُحَمَّدٌ صلَّى اللهُ عليه وسلَّم فَرقٌ بينَ النَّاسِ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[أورده في صحيحه] وقال : تابعه قتيبة عن ليث عن خالد عن سعيد بن أبي هلال عن جابر خرج علينا النبي صلى الله عيه وسلم ...","takhrij":"أخرجه أبو عوانة (10114)، والبيهقي في ((الآداب)) (858) كلاهما بلفظه، والترمذي (2860) بمعناه.","bab":"آداب عامة › ضرب الأمثال","dorar":"mmVpxzQK"},{"id":"س-03733","fp":"a14c23fb3fec","stateId":240,"easy":"إذا لم تعمل بسنة النبي ﷺ (رغبة عنها) ← فلست منه","cause":"فمَنْ لمْ يَعْمَلْ بِسُنَّتِي","result":"فَليسَ مِنِّي","explicit":true,"ref":"السلسلة الصحيحة 2383","srcLabel":"ابن ماجه","text":["النِّكَاحُ من سُنَّتِي ",["فمَنْ لمْ يَعْمَلْ بِسُنَّتِي",1]," ",["فَليسَ مِنِّي",2]," ، و تَزَوَّجُوا ؛ فإني مُكَاثِرٌ بِكُمُ الأُمَمَ ، و مَنْ كان ذَا طَوْلٍ فَلْيَنْكِحْ ، و مَنْ لمْ يَجِدْ فَعليهِ بِالصِّيامِ، فإنَّ الصَّوْمَ لهُ وِجَاءٌ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (1846) واللفظ له، والديلمي في ((الفردوس)) (6920) مختصراً.","bab":"اعتصام بالسنة › لزوم السنة","dorar":"wPZsfmaw"},{"id":"س-04873","fp":"2cd50ba74100","stateId":240,"easy":"إذا اتخذت القبور مساجد ← لُعنت","cause":"من اتخذ القبورَ مساجدَ","result":"لعن","explicit":true,"ref":"فتح الباري لابن حجر 3/266","srcLabel":"السنة","text":["عن رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ أنه ",["لعن",2]," ",["من اتخذ القبورَ مساجدَ",1],"."],"grade":"صحيح","muhaddith":"[صحيح]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"VxNhSzGi"},{"id":"س-07340","fp":"8a8e2bfdf559","stateId":240,"easy":"إذا كنت من أهل البدع والأهواء ← فالنبي ﷺ ليس منك في شيء","cause":"أهلُ البدعِ والأهواءِ من هذِهِ الأمةِ","result":"لَسْتَ مِنْهُمْ فِي شَيْءٍ","explicit":true,"ref":"مجمع الزوائد 7/25","srcLabel":"الطبراني","text":["عن النبيِّ صلَّى اللهُ عليه وسلَّم قال  إنَّ الَّذِينَ فَرَّقُوا دِينَهُمْ وَكَانُوا شِيَعًا ",["لَسْتَ مِنْهُمْ فِي شَيْءٍ",2]," قال هم ",["أهلُ البدعِ والأهواءِ من هذِهِ الأمةِ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"رجاله رجال الصحيح غير معلل بن نفيل وهو ثقة","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (664)، والطبري في ((التفسير)) (10/ 33) بلفظه.","bab":"فتن › كراهية الاختلاف","dorar":"egwiuN1G"},{"id":"س-07048","fp":"d766cf584f91","stateId":240,"easy":"إذا أفتيت بغير علم فهلك المستفتي ← فقد قتلته","cause":"فاغتَسَل فماتَ","result":"قَتَلوه قَتلهمُ اللهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-00824","otherNeedIds":[12],"ref":"الروضة الندية 1/60","text":["خَرَجنا في سَفرٍ فأصابَ رَجُلًا مِنَّا حَجَرٌ فشَجَّه في رَأسِه ثُمَّ احتَلمَ فسَأل أصحابَه هَل تَجِدونَ له رُخصةً في التَّيَمُّمِ؟ فقالوا: ما نَجِدُ لك رُخصةً وأنت تَقدِرُ على الماءِ، ",["فاغتَسَل فماتَ",1],"، فلمَّا قَدِمنا على رَسولِ اللهِ صَلَّى اللهُ وسَلَّمَ عليه أخبَرناه بذلك، فقال: \"",["قَتَلوه قَتلهمُ اللهُ",2],"، ألَا سَألوا إذ لم يَعلَموا؛ فإنَّما شِفاءُ العِيِّ السُّؤالُ، إنَّما كان يَكفيه أن يَتَيَمَّمَ ويَعصِبَ على جُرحِه ثُمَّ يَمسَحَ عليه ويَغسِلَ سائِرَ جَسَدِه\"."],"grade":"صحيح","narrator":"جابر","muhaddith":"[صحيح]","takhrij":"أخرجه أبو داود (336) واللفظ له، والبيهقي (1075)، والدارقطني (729)","bab":"علم › الحث على طلب العلم","dorar":"DTsWebH6","merged":3,"otherRefs":["الأحاديث المختارة 11 / 214 (صحيح)","تحفة المحتاج 1/225 (صحيح)"]},{"id":"س-01274","fp":"8d8555e9a4b6","stateId":240,"easy":"إذا كنت قادراً على الزواج فلم تتزوج (رغبة عن السنة) ← فلست من النبي ﷺ","cause":"مَن كان موسِرًا لِأنْ يَنكِحَ فلم يَنكِحْ","result":"فليس مِني","explicit":true,"ref":"كشف اللثام 5/247","srcLabel":"أبو داود","text":[["مَن كان موسِرًا لِأنْ يَنكِحَ فلم يَنكِحْ ",1],["فليس مِني",2]],"grade":"حسن","narrator":"أبو نجيح يسار المكي","muhaddith":"إسناده حسن","takhrij":"أخرجه أبو داود في ((المراسيل)) (202)، والدولابي في ((الكنى والأسماء)) (491)، والطبراني (22/366) (920) باختلاف يسير","bab":"نكاح › الحث على التزويج","dorar":"7ijPJFei"},{"id":"س-03655","fp":"616f60ca6802","stateId":240,"easy":"إذا ترهّبت (اعتزلت النساء تبتّلاً) ← فلست من النبي ﷺ","cause":"مَن ترهَّب أو تشبَّه","result":"فليس منِّي","explicit":true,"ref":"المعجم الأوسط 4/178","srcLabel":"الطبراني","text":["عن أبي كَريمةَ قال سمِعْتُ علِيَّ بنَ أبي طالبٍ وهو يخطُبُ على مِنْبَرِ الكوفةِ وهو يقولُ يا أيُّها النَّاسُ إنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ إيَّاكم ولباسَ الرُّهبانِ فإنَّه ",["مَن ترهَّب أو تشبَّه ",1],["فليس منِّي",2]],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"لا يروى هذا الحديث عن علي إلا بهذا الإسناد تفرد به محمد بن صالح بن مهران","takhrij":"لم نقف عليه إلا عند الطبراني في ((المعجم الأوسط)) (3909)","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"3Q5SX6ky"},{"id":"س-04842","fp":"317de2be740f","stateId":240,"easy":"إذا عملت بسنة غيرنا ← فلست منا","cause":"عَمِلَ بسنَّةِ غيرِنا","result":"ليس مِنَّا مَنْ","explicit":true,"ref":"صحيح الجامع 5439","srcLabel":"الطبراني","text":[["ليس مِنَّا مَنْ",2],[" عَمِلَ بسنَّةِ غيرِنا",1]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن","takhrij":"أخرجه الطبراني (11/152) (11335) مطولاً، والديلمي في ((الفردوس)) (5268)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"OByrvQHn"},{"id":"س-05951","fp":"6332c1e60066","stateId":240,"easy":"إذا خصيت نفسك ← فلست منا، ولكن صم","cause":"خَصِى أو اخْتَصَى، و لكنْ صُمْ، و وَفِرْ شعرَ جَسدِك","result":"ليسَ منَّا منْ","explicit":true,"ref":"الجامع الصغير 7664","srcLabel":"الطبراني","text":[["ليسَ منَّا منْ",2],[" خَصِى أو اخْتَصَى،  و لكنْ صُمْ،  و وَفِرْ شعرَ جَسدِك",1]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن","takhrij":"أخرجه الطبراني (11/144) (11304)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"gMdGArpO"},{"id":"س-00815","fp":"072922cc0810","stateId":240,"easy":"إذا اتخذت القبور مساجد ← يلعنك الله","cause":"قَومًا اتَّخذوا","result":"لعَنَ اللهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشعيب 25129","srcLabel":"متفق عليه","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ لعَنَ قَومًا اتَّخذوا قُبورَ أنبيائِهم مَساجِدَ. وقال محمدُ بنُ بَكرٍ: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ لعَنَ أقوامًا، وقال الخَفَّافُ: إنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قال: ",["لعَنَ اللهُ",2],[" قَومًا اتَّخذوا",1],".."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1330)، ومسلم (529)، والنسائي (2046)، وأحمد (25129) واللفظ له","bab":"أدعية وأذكار › دعاء النبي على بعض الأشخاص والأشياء والأمور","dorar":"ubjmIxPH"},{"id":"س-00263","fp":"c1909aa6468d","stateId":241,"easy":"إذا لم ترحم الناس ← لا يرحمك الله","cause":"مَن لم يَرحَمِ النَّاسَ","result":"لا يَرحَمْهُ اللهُ عزَّ وجلَّ","explicit":true,"star":true,"similar":["س-04777"],"ref":"تخريج المسند لشعيب 19194","srcLabel":"متفق عليه","text":["كان جَريرُ بنُ عَبدِ اللهِ في بَعْثٍ بِأرْمينيَّةَ، قال: فأصابَتْهم مَخمَصةٌ، أو مَجاعةٌ، قال: فكتَبَ جَريرٌ إلى مُعاويةَ: إنِّي سمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["مَن لم يَرحَمِ النَّاسَ، ",1],["لا يَرحَمْهُ اللهُ عزَّ وجلَّ",2],". قال: فأرسَلَ إليهِ، فأتاهُ، فقالَ: آنتَ سمِعْتَهُ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ قال: نَعَمْ. قال: فأقْفَلَهم، ومَتَّعَهم."],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"مرفوعه صحيح","takhrij":"أخرجه البخاري (7376)، ومسلم (2319)، والترمذي (1922) مختصراً، وأحمد (19194) واللفظ له","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"SNRspoVI","merged":3,"otherRefs":["تخريج المسند لشعيب 19261 (صحيح)","صحيح الأدب المفرد 285 (صحيح)"]},{"id":"س-08315","fp":"f9c01fdb1ce8","stateId":241,"easy":"إذا نقضت عهد مسلم (أخفرت ذمته) ← فعليك لعنة الله والملائكة والناس أجمعين","cause":"فمَن أخفَر مُسلِمًا","result":"فعليه لعنةُ اللهِ والملائكةِ والنَّاسِ أَجمَعينَ، لا يُقبَلُ منه يومَ القِيامةِ صَرْفٌ، ولا عَدْلٌ","explicit":true,"star":true,"otherNeedIds":[45],"ref":"تخريج المسند لشعيب 1298","srcLabel":"متفق عليه","text":["عنِ الحارثِ بنِ سُوَيدٍ، قال: قيل لعليٍّ: إنَّ رسولَكم كان يخُصُّكم بشيءٍ دونَ النَّاسِ عامَّةً، قال: ما خصَّنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بشيءٍ لم يخُصَّ به النَّاسَ، إلا بشيءٍ في قِرابِ سَيْفي هذا، فأَخرَج صَحيفةً فيها شيءٌ من أسنانِ الإبلِ، وفيها: إنَّ المدينةَ حَرَمٌ ممَّا بيْنَ  ثَوْرٍ إلى عائرٍ، مَن أحدَث فيها حدَثًا، أو آوَى مُحدِثًا، فإنَّ عليه لَعنةَ اللهِ والملائكةِ والنَّاسِ أَجمَعينَ، لا يُقبَلُ منه يومَ القِيامةِ صَرْفٌ، ولا عَدْلٌ، وذِمَّةُ المُسلِمينَ واحدةٌ؛ ",["فمَن أخفَر مُسلِمًا ",1],["فعليه لعنةُ اللهِ والملائكةِ والنَّاسِ أَجمَعينَ، لا يُقبَلُ منه يومَ القِيامةِ صَرْفٌ، ولا عَدْلٌ، ",2],"ومَن تولَّى مَوْلًى بغيْرِ إذْنِهم فعليه لعنةُ اللهِ والملائكةِ والنَّاسِ أَجمَعينَ، لا يُقبَلُ منه يومَ القِيامةِ صَرْفٌ، ولا عَدْلٌ."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (3179)، ومسلم (1370)، وأبو داود (2034)، والنسائي في ((السنن الكبرى)) (8681)، وأحمد (1298) واللفظ له","bab":"مناقب وفضائل › علي بن أبي طالب","dorar":"AL2alcqH","merged":3,"otherRefs":["صحيح ابن حبان 3716 (صحيح)","تخريج المسند لشعيب 1037 (صحيح)"]},{"id":"س-00470","fp":"9f4f9979c339","stateId":241,"easy":"إذا مثّلت بالحيوان ← لعنك الله","cause":"من يُمثِّلُ بالحيوانِ","result":"لَعَنَ اللهُ","explicit":true,"star":true,"similar":["س-05174","س-00469"],"ref":"تخريج المسند لشاكر 8/108","srcLabel":"متفق عليه","text":["[عن] سعيد بن جبير قال: خرجتُ معَ ابنِ عمرَ في طريقٍ من طُرُقِ المدينةِ فرَأَى فِتْيانًا قد نَصَبوا دجاجةً يَرمونها لهم كلَّ خاطئةٍ ، فقال : مَن فعل هذا ؟ وغضبَ فلمَّا رأوا ابنَ عمرَ تَفَرَّقُوا ثم قال ابنُ عمرَ عن النبيِّ صلَّى اللهُ عليهِ وسلَّمَ ",["لَعَنَ اللهُ",2]," ",["من يُمثِّلُ بالحيوانِ",1]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (5514)، ومسلم (1958) باختلاف يسير.","bab":"آداب عامة › الرفق بالحيوان والطير ونحوهما","dorar":"K0hnlZ34","merged":2,"otherRefs":["المستدرك على الصحيحين 7783 (صحيح)"]},{"id":"س-04777","fp":"5b020c4c8354","stateId":241,"easy":"إذا لم ترحم من في الأرض ← لا يرحمك من في السماء","cause":"مَنْ لا يَرْحَمْ مَنْ في الأرضِ","result":"لا يَرْحَمُهُ مَنْ في السَّماءِ","explicit":true,"repOf":"س-00263","ref":"صحيح الترغيب 2255","text":[["مَنْ لا يَرْحَمْ مَنْ في الأرضِ ؛ ",1],["لا يَرْحَمُهُ مَنْ في السَّماءِ",2]],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني (2/ 355) (2497) واللفظ له، والبخاري (6013)، ومسلم (2319) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"w4WQfPzF","merged":2,"otherRefs":["العلو للذهبي 19 (حسن)"]},{"id":"س-05174","fp":"01cad9395d77","stateId":241,"easy":"إذا مثّلت بالحيوان ← لعنك النبي ﷺ","cause":"مَن مَثَّل بالحيوانِ","result":"لعَنَ النَّبيُّ صلَّى اللهُ عليه وسلَّم","explicit":true,"repOf":"س-00470","ref":"صحيح البخاري 5515","text":["كُنتُ عِندَ ابنِ عُمَرَ، فمَرُّوا بفِتيةٍ -أو بنَفَرٍ- نَصَبوا دَجاجةً يَرمونَها، فلَمَّا رَأوا ابنَ عُمَرَ تَفَرَّقوا عَنها، وقال ابنُ عُمَرَ: مَن فعَلَ هذا؟! إنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم لَعَنَ مَن فعَلَ هذا. [وفي رِوايةٍ]: ",["لعَنَ النَّبيُّ صلَّى اللهُ عليه وسلَّم",2]," ",["مَن مَثَّل بالحيوانِ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1958) باختلاف يسير. \nوالرواية أخرجها البخاري معلقةً بصيغة الجزم بعد حديث (5515)، وأخرجها موصولة النسائي (4442)، وأحمد (5018) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"9nvKX0G4","merged":2,"otherRefs":["السلسلة الصحيحة 5/558 (صحيح)"]},{"id":"س-00469","fp":"5e3a6f109b7d","stateId":241,"easy":"إذا مثّلت بالحيوان ← لعنك الله","cause":"مَنْ مَثَّلَ الحيوانَ","result":"لعَنَ اللهُ","explicit":true,"repOf":"س-00470","ref":"صحيح الجامع 5113","text":[["لعَنَ اللهُ",2]," ",["مَنْ مَثَّلَ الحيوانَ",1]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه النسائي (4442) واللفظ له، وأخرجه البخاري معلقاً بصيغة الجزم بعد حديث (5515) باختلاف يسير","bab":"آداب عامة › الرفق بالحيوان والطير ونحوهما","dorar":"DE8rY3oD"},{"id":"س-02373","fp":"20e2e7dfe98b","stateId":241,"easy":"إذا تقاتل مسلمان بسيفيهما ← فالقاتل والمقتول في النار","cause":"إذا التقى المسلمانِ بسيفيهما فالقاتِلُ","result":"والمقتولُ في النَّارِ","explicit":true,"star":true,"otherNeedIds":[57],"ref":"حلية الأولياء 6/283","srcLabel":"متفق عليه","text":["لمَّا قدمَ علِيٌّ البصرةَ التحفتُ على سيفي لآتيَه فأنصرَه فلقيني أبو بَكرةَ فقال أينَ تريدُ قلتُ هذا الرَّجلُ قال ارجع فإنِّي سمعتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ ",["إذا التقى المسلمانِ بسيفيهما فالقاتِلُ ",1],["والمقتولُ في النَّارِ",2]],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"صحيح من حديث حماد وأيوبمتفق على صحته [أي:بين العلماء]","takhrij":"أخرجه ابن المقرئ في ((معجمه)) (633) بلفظه، والبخاري (6875)، ومسلم (2888) دون القصة في أوله، كلاهما بلفظه، وأبو داود (4268) بلفظ مقارب.","bab":"إسلام › حرمة المسلم","dorar":"CCEvZulA"},{"id":"س-02572","fp":"6ccdbd9a0062","stateId":241,"easy":"إذا رميتنا بالنبل ← فلست منا","cause":"مَن رمانا بالنبل","result":"فليس منَّا","explicit":true,"star":true,"similar":["س-05186"],"ref":"صحيح ابن حبان 5607","srcLabel":"البخاري","text":[["مَن رمانا بالنبل ",1],["فليس منَّا",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (8270)، والبخاري في ((الأدب المفرد)) (1279)، والعقيلي في ((الضعفاء الكبير)) (4/407) بلفظ: \"رمانا بالليل\"","bab":"إيمان › أعمال تنافي الإيمان","dorar":"Cgtlb6Qz"},{"id":"س-05086","fp":"fd6c6b9680e6","stateId":241,"easy":"إذا اتخذت ذا روح هدفاً ترمي إليه ← لعنك الله","cause":"مَنِ اتَّخَذَ شَيئًا فيه الرُّوحُ غَرَضًا","result":"لعَنَ اللهُ","explicit":true,"ref":"تخريج المسند لشعيب 6259","srcLabel":"متفق عليه","text":["خَرَجتُ مع ابنِ عُمَرَ من مَنزِلِه، فمَرَرْنا بِفِتْيانٍ من قُرَيشٍ قد نَصَبوا طَيْرًا وهم يَرْمونَه، وقد جَعَلوا لِصاحِبِ الطَّيْرِ كُلَّ خاطِئَةٍ من نَبْلِهم، فلمَّا رَأوُا ابنَ عُمَرَ تَفَرَّقوا، فقال: ابنُ عُمَرَ مَن فعَلَ هذا؟ ",["لعَنَ اللهُ",2]," مَن فعَلَ هذا إنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال: لعَنَ اللهُ ",["مَنِ اتَّخَذَ شَيئًا فيه الرُّوحُ غَرَضًا",1],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (5515)، ومسلم (1958)، والنسائي (4441، 4442)، وأحمد (6259) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ymUEl2KC"},{"id":"س-08183","fp":"9b0c13afd33d","stateId":241,"easy":"إذا أشرت إلى أخيك بحديدة ← تلعنك الملائكة حتى تدعها ولو كان أخاك الشقيق","cause":"مَن أشارَ إلى أخيه بحَديدةٍ","result":"فإنَّ المَلائِكةَ تَلعَنُه حتَّى يَدَعَه، وإن كانَ أخاه لأبيه وأُمِّه","explicit":true,"similar":["س-02761","س-08105"],"ref":"صحيح مسلم 2616","srcLabel":"متفق عليه","text":[["مَن أشارَ إلى أخيه بحَديدةٍ ",1],["فإنَّ المَلائِكةَ تَلعَنُه حتَّى يَدَعَه، وإن كانَ أخاه لأبيه وأُمِّه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"ملائكة › أعمال الملائكة","dorar":"eN2279y9"},{"id":"س-08291","fp":"530222179799","stateId":241,"easy":"إذا وسمت الوجه أو ضربته ← لعنك الله","cause":"لا يَسِمَنَّ أحدٌ الوجْهَ و لا يضرِبَنَّهُ","result":"لعن اللهُ مَن فعل هذا","explicit":true,"ref":"صحيح الأدب المفرد 131","srcLabel":"البخاري","text":[["لعن اللهُ مَن فعل هذا",2]," ، ",["لا يَسِمَنَّ أحدٌ الوجْهَ و لا يضرِبَنَّهُ",1]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (175)، وأحمد (14459)، وعبد الرزاق (17949) جميعا بلفظه وفي أوله زيادة.","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"jM79us3J"},{"id":"س-00462","fp":"b6e47d616237","stateId":241,"easy":"إذا وسمت البهيمة في وجهها ← لعنك النبي ﷺ","cause":"وُسِمَ في وجْهِهِ","result":"لعَنتُ من وسمَ البَهيمةَ في وجْهِها","explicit":true,"ref":"صحيح أبي داود 2564","srcLabel":"مسلم","text":["أنَّ النَّبيَّ صلَّى اللَّهُ عليْهِ وسلَّمَ مُرَّ عليْهِ بحمارٍ قد ",["وُسِمَ في وجْهِهِ",1]," فقالَ أما بلغَكم أنِّي قد ",["لعَنتُ من وسمَ البَهيمةَ في وجْهِها",2]," أو ضربَها في وجْهِها فنَهى عن ذلِكَ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2564) بلفظه، ومسلم (2117)،  والترمذي (5628)، وابن حبان (1710) جميعهم بمعناه.","bab":"آداب عامة › الرفق بالحيوان والطير ونحوهما","dorar":"V1oiNhA1"},{"id":"س-00814","fp":"fa20eb887af3","stateId":241,"easy":"إذا كويت الحمار أو وسمته في وجهه ← لعنك النبي ﷺ","cause":"بحمارٍ قد كُوِي على وجهِه أو وُسِم","result":"فلعَن النَّبيُّ صلَّى اللهُ عليه وسلَّم مَن فعَل ذلك","explicit":true,"ref":"تخريج صحيح ابن حبان 5620","srcLabel":"مسلم","text":["عن النَّبيِّ صلَّى اللهُ عليه وسلَّم أنَّه مُرَّ عليه ",["بحمارٍ قد كُوِي على وجهِه أو وُسِم",1]," ",["فلعَن النَّبيُّ صلَّى اللهُ عليه وسلَّم مَن فعَل ذلك",2]," ثمَّ قال: ( سُبحانَ اللهِ لا تضرِبوها على وجوهِها )"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (5620) واللفظ له، ومسلم (2117)، وأحمد (14164)، وعبد الرزاق (8450) بنحوه.","bab":"أدعية وأذكار › دعاء النبي على بعض الأشخاص والأشياء والأمور","dorar":"5a5Yzvnk"},{"id":"س-02761","fp":"402bd86c625c","stateId":241,"easy":"إذا أشرت إلى أخيك بحديدة ← تلعنك الملائكة","cause":"إذا أشار لِأَخيه بِـحَديدَةٍ","result":"الـمَلائِكَةُ تَلْعَنُ أَحَدَكم","explicit":true,"repOf":"س-08183","ref":"تخريج المسند لشعيب 7476","text":[["الـمَلائِكَةُ تَلْعَنُ أَحَدَكم",2]," ",["إذا أشار لِأَخيه بِـحَديدَةٍ",1],"، وإنْ كان أخاه لأَبِيه وأُمِّه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (2616)، والترمذي (2162)، والنسائي في ((السنن الكبرى)) كما في ((تحفة الأشراف)) للمزي (10/343)، وأحمد (7476) واللفظ له","bab":"إيمان › الملائكة","dorar":"hDPgqDh5"},{"id":"س-04928","fp":"d33cf12e4d73","stateId":241,"easy":"إذا سللت السيف علينا ← فلست منا","cause":"مَن سَلَّ علينا السَّيفَ","result":"فليس مِنَّا","explicit":true,"ref":"تخريج المسند لشعيب 16541","srcLabel":"مسلم","text":[["مَن سَلَّ علينا السَّيفَ، ",1],["فليس مِنَّا",2],"."],"grade":"صحيح","narrator":"سلمة بن الأكوع","muhaddith":"صحيح","takhrij":"أخرجه مسلم (99)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"71lIwVPE"},{"id":"س-06895","fp":"7d146f4f8b29","stateId":241,"easy":"إذا غصبت أرضاً ظلماً ← تلقى الله وهو عليك غضبان","cause":"مَنْ غَصَبَ رجلًا أَرْضًا ظُلْمًا","result":"لَقِيَ اللهَ وهوَ عليهِ غَضْبانُ","explicit":true,"ref":"السلسلة الصحيحة 3365","srcLabel":"مسلم","text":[["مَنْ غَصَبَ رجلًا أَرْضًا ظُلْمًا ؛ ",1],["لَقِيَ اللهَ وهوَ عليهِ غَضْبانُ",2]],"grade":"صحيح","narrator":"وائل بن حجر","muhaddith":"إسناده صحيح رجاله ثقات على شرط مسلم","takhrij":"أخرجه مسلم (139)، وأحمد (18863) كلاهما بنحوه وفي أوله قصة،  والطبراني (25)  (22/ 18) بلفظه","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"hKP6t0c5"},{"id":"س-07351","fp":"e6ca97c9113c","stateId":241,"easy":"إذا خرجت على الأمة بسيفك تضرب برها وفاجرها ← فلست من الأمة","cause":"ومَن خَرَجَ علَى أمتِي بسيفِهِ يضربُ برَّهَا وفاجِرَهَا لا يُحَاشِى مؤمنًا لإيمانِهِ ولا يَفِي لذِي عهدٍ بعهدِهِ","result":"فليسَ مِن أمتِي","explicit":true,"ref":"تخريج المسند لشاكر 15/201","srcLabel":"مسلم","text":["مَن فارَقَ الجمَاعَةَ وخرَجَ من الطاعَةِ فماتَ فميتُتُهُ جاهليةٌ ",["ومَن خَرَجَ علَى أمتِي بسيفِهِ يضربُ برَّهَا وفاجِرَهَا لا يُحَاشِى مؤمنًا لإيمانِهِ ولا يَفِي لذِي عهدٍ بعهدِهِ",1]," ",["فليسَ مِن أمتِي",2]," ومَن قُتِلَ تحتَ رايةٍ عِمِّيَّةٍ يغضَبُ للعَصَبيَّةِ أو يُقَاتِلُ للعصبِيَّةِ أو يدعو إلى العصبيَّةِ فقِتْلَةُ جاهليةٍ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (1848)، والنسائي (4114)، وابن ماجه (3948)، وأحمد (8061) واللفظ له","bab":"فتن › كراهية الاختلاف","dorar":"QB4TxSjk"},{"id":"س-08105","fp":"6228b36446d2","stateId":241,"easy":"إذا أشرت إلى أخيك بحديدة ← تلعنك الملائكة","cause":"من أشارَ علَى أخيهِ بحَديدةٍ","result":"لعنتْهُ الملائِكةُ","explicit":true,"repOf":"س-08183","ref":"صحيح الترمذي 2162","text":[["من أشارَ علَى أخيهِ بحَديدةٍ ، ",1],["لعنتْهُ الملائِكةُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2616) مطولاً، والترمذي (2162) واللفظ له","bab":"ملائكة › أعمال الملائكة","dorar":"Y2Iya79s"},{"id":"س-04766","fp":"99d82697e20a","stateId":241,"easy":"إذا لم ترحم ← لا تُرحم","cause":"من لا يرحمْ","result":"لا يُرْحَمُ","explicit":true,"ref":"النوافح العطرة 411","srcLabel":"البيهقي","text":[["من لا يرحمْ",1]," ",["لا يُرْحَمُ",2]," [يعني حديث: أخَذَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ بيَدِ عبدِ الرَّحمنِ بنِ عَوفٍ حتَّى أتى بِهِ النَّخْلَ، فإذا هُوَ بإبراهيمَ ابنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ في حِجْرِ أُمِّهِ، وهو يَجُودُ بنَفْسِهِ ، فذَرَفَتْ عَيْناهُ صلَّى اللهُ عليه وسلَّمَ، فبَكى، فقالَ لَهُ عبدُ الرَّحمنِ: يا رسولَ اللهِ، تَبْكي؟! ألَمْ تَنْهَ عَنِ البكاءِ؟! فقالَ: إنَّما نَهَيْتُ عَنْ صوتَيْنِ أحمقَيْنِ فاجرَيْنِ: صوتٍ عِندَ نَغْمةِ لَهوٍ ولَعِبٍ ومَزاميرِ شيطانٍ، وصوتٍ عِندَ مصيبةِ خَمْشِ وُجوهٍ، وشقِّ جُيوبٍ، ورنَّةِ الشَّيطانِ، وهذِهِ رحمةٌ، ومَن لا يَرْحَمْ لا يُرْحَمْ. يا إبراهيمُ، لَوْلا أنَّهُ قولٌ حقٌّ، ووعدٌ صادقٌ، وسبيلٌ مَأْتِيَّةٌ، وأنَّ آخِرَنا يَلْحَقُ بأوَّلِنا، لَحَزِنَّا عليكَ حزنًا هو أشدُّ مِن هَذا، وإنَّا بِكَ لَمَحْزونونَ، تَبْكي العَينُ، ويَوْجَلُ القلبُ، ولا نقولُ ما يُسخِطُ الرَّبَّ.]"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي شيبة (25876) واللفظ له، وعبد بن حميد (1004)، والبيهقي (7402) مطولا","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"M8oPeX4U","merged":14,"otherRefs":["صحيح ابن حبان 6975 (صحيح)","صحيح الترمذي 1911 (صحيح)","صحيح البخاري 5997 (صحيح)","تخريج المسند لشعيب 7121 (صحيح)","صحيح مسلم 2318 (صحيح)","تخريج صحيح ابن حبان 463 (صحيح)","تخريج المسند لشعيب 7649 (صحيح)","صحيح الجامع 6600 (صحيح)","السلسلة الصحيحة 1/790 (حسن)","صحيح البخاري 7376 (صحيح)","صحيح الأدب المفرد 71 (صحيح)","صحيح الترغيب 2466 (صحيح)","سنن الترمذي 2381 (صحيح)"]},{"id":"ق-0403","fp":"aa4ebe03a7d0","stateId":241,"easy":"الظلم والصد عن سبيل الله وابتغاؤها عوجاً ← لعنة الله","cause":"الظلم والصد عن سبيل الله وابتغاؤها عوجاً","result":"لعنة الله","explicit":true,"ref":"سورة الأعراف: 44–45","srcLabel":"القرآن الكريم","quran":{"s":7,"from":44,"to":45,"text":"وَنَادَى أَصْحَابُ الْجَنَّةِ أَصْحَابَ النَّارِ أَنْ قَدْ وَجَدْنَا مَا وَعَدَنَا رَبُّنَا حَقًّا فَهَلْ وَجَدْتُمْ مَا وَعَدَ رَبُّكُمْ حَقًّا قَالُوا نَعَمْ فَأَذَّنَ مُؤَذِّنٌ بَيْنَهُمْ أَنْ لَعْنَةُ اللَّهِ عَلَى الظَّالِمِينَ (44) الَّذِينَ يَصُدُّونَ عَنْ سَبِيلِ اللَّهِ وَيَبْغُونَهَا عِوَجًا وَهُمْ بِالْآخِرَةِ كَافِرُونَ (45)","hl":[[191,333,1]]}},{"id":"ق-0626","fp":"ff4b7ef1ee0d","stateId":241,"easy":"نقض عهد الله وقطع ما أمر بوصله والإفساد في الأرض ← اللعنة وسوء الدار","cause":"نقض عهد الله وقطع ما أمر بوصله والإفساد في الأرض","result":"اللعنة وسوء الدار","explicit":true,"otherNeedIds":[57],"ref":"سورة الرعد: 25","srcLabel":"القرآن الكريم","quran":{"s":13,"from":25,"to":25,"text":"وَالَّذِينَ يَنْقُضُونَ عَهْدَ اللَّهِ مِنْ بَعْدِ مِيثَاقِهِ وَيَقْطَعُونَ مَا أَمَرَ اللَّهُ بِهِ أَنْ يُوصَلَ وَيُفْسِدُونَ فِي الْأَرْضِ أُولَئِكَ لَهُمُ اللَّعْنَةُ وَلَهُمْ سُوءُ الدَّارِ (25)","hl":[[0,193,1]]}},{"id":"ق-1118","fp":"fd5a0a9eb65e","stateId":241,"easy":"الظلم ← لا تنفع المعذرة واللعنة وسوء الدار","cause":"الظلم","result":"لا تنفع المعذرة واللعنة وسوء الدار","explicit":true,"otherNeedIds":[57],"ref":"سورة غافر: 52","srcLabel":"القرآن الكريم","quran":{"s":40,"from":52,"to":52,"text":"يَوْمَ لَا يَنْفَعُ الظَّالِمِينَ مَعْذِرَتُهُمْ وَلَهُمُ اللَّعْنَةُ وَلَهُمْ سُوءُ الدَّارِ (52)","hl":[[0,93,1]]}},{"id":"س-07279","fp":"e0f606cf7fd2","stateId":241,"easy":"إذا حملت السياط تضرب بها الناس ظلماً ← تغدو في سخط الله وتروح في غضبه","cause":"معهم أسْياطٌ كأنَّها أذنابُ البَقرِ","result":"يَغدونَ في سَخَطِ اللهِ، ويَروحونَ في غَضَبِه","explicit":true,"ref":"تخريج المسند لشعيب 22150","srcLabel":"أحمد","text":["أنَّ أبا أُمامةَ ذَكَرَ أنَّ رسولَ اللهِ صَلَّى اللهُ عليه وسلَّمَ قال: يَكونُ في هذه الأُمَّةِ في آخِرِ الزَّمانِ رِجالٌ -أو قال: يَخرُجُ رِجالٌ مِن هذه الأُمَّةِ في آخِرِ الزَّمانِ- ",["معهم أسْياطٌ كأنَّها أذنابُ البَقرِ",1],"، ",["يَغدونَ في سَخَطِ اللهِ، ويَروحونَ في غَضَبِه",2],"."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (22150) واللفظ له، والطبراني (8/308) (8000)، والحاكم (8347)","bab":"فتن › ظهور الفتن","dorar":"0J1jL67x","merged":5,"otherRefs":["صحيح مسلم 2857 (صحيح)","المستدرك على الصحيحين 8563 (صحيح)","القول المسدد 1/40 (صحيح)","صحيح الجامع 8184 (صحيح)"]},{"id":"س-05173","fp":"80b522d9a3c3","stateId":241,"easy":"إذا اتخذت حيواناً غرضاً ترميه ← لعنك الله","cause":"نَصَبوا دَجاجةً يَرمونَها","result":"لَعَنَ مَن فعَلَ هذا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح البخاري 5515","srcLabel":"متفق عليه","text":["كُنتُ عِندَ ابنِ عُمَرَ، فمَرُّوا بفِتيةٍ -أو بنَفَرٍ- ",["نَصَبوا دَجاجةً يَرمونَها",1],"، فلَمَّا رَأوا ابنَ عُمَرَ تَفَرَّقوا عَنها، وقال ابنُ عُمَرَ: مَن فعَلَ هذا؟! إنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم ",["لَعَنَ مَن فعَلَ هذا",2],". [وفي رِوايةٍ]: لعَنَ النَّبيُّ صلَّى اللهُ عليه وسلَّم مَن مَثَّل بالحيوانِ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1958) باختلاف يسير. \nوالرواية أخرجها البخاري معلقةً بصيغة الجزم بعد حديث (5515)، وأخرجها موصولة النسائي (4442)، وأحمد (5018) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"9nvKX0G4","merged":2,"otherRefs":["صحيح مسلم 1958 (صحيح)"]},{"id":"س-03617","fp":"1c211c32f83b","stateId":241,"easy":"إذا وسمت الحيوان في وجهه ← لعنك الله","cause":"قد كُوِي في وجهِه تفورُ مَنْخِراه مِن دمٍ","result":"لعَن اللهُ مَن فعَل هذا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-00471"],"ref":"تخريج صحيح ابن حبان 5626","srcLabel":"مسلم","text":["مرَّ حمارٌ برسولِ اللهِ صلَّى اللهُ عليه وسلَّم ",["قد كُوِي في وجهِه تفورُ مَنْخِراه مِن دمٍ",1]," فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( ",["لعَن اللهُ مَن فعَل هذا",2]," ) ثمَّ نهى عن الكيِّ في الوجهِ والضَّربِ في الوجهِ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (5626) بلفظه، وأخرجه أبو داود (2564)، وأحمد (14459)، والبيهقي (13387) جميعًا بلفظ مقارب، وأصل الحديث أخرجه مسلم (2116 )","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"YO1XE8Dl","merged":3,"otherRefs":["صحيح ابن حبان 5627 (صحيح)","الزواجر عن اقتراف الكبائر 1/208 (صحيح)"]},{"id":"س-05186","fp":"05dd1fafe8d3","stateId":241,"easy":"إذا رميتنا بالليل ← فلست منا","cause":"من رمى باللَّيلِ","result":"فليس مِنَّا","explicit":true,"repOf":"س-02572","ref":"النوافح العطرة 381","text":[["من رمى باللَّيلِ ",1],["فليس مِنَّا",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه أحمد (8270)، والبخاري في ((الأدب المفرد)) (1279)، والعقيلي في ((الضعفاء الكبير)) (4/407) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"yVGPfn8E"},{"id":"س-02562","fp":"f767420453a5","stateId":241,"easy":"إذا أمّنت أحداً على دمه ثم قتلته ← فالنبي ﷺ بريء منك ولو كان كافراً","cause":"مَنْ أَمَّنَ رجُلًا عَلَى دَمِهِ فقَتَلَهُ","result":"فأنَا بَرِيٌء مِنَ القاتِلِ ، وإِنْ كانَ المقتولُ كافِرًا","explicit":true,"ref":"صحيح الجامع 6103","srcLabel":"الطبراني","text":[["مَنْ أَمَّنَ رجُلًا عَلَى دَمِهِ فقَتَلَهُ",1]," ",["فأنَا بَرِيٌء مِنَ القاتِلِ ، وإِنْ كانَ المقتولُ كافِرًا",2]],"grade":"صحيح","narrator":"عمرو بن الحمق","muhaddith":"صحيح","takhrij":"أخرجه البزار (2308)، والطبراني في ((المعجم الأوسط)) (4252) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (2/14).","bab":"إيمان › أعمال تنافي الإيمان","dorar":"GF9SdMId","merged":3,"otherRefs":["تخريج مشكل الآثار 203 (حسن)","صحيح ابن حبان 5982 (صحيح)"]},{"id":"س-00471","fp":"7c3105d7412f","stateId":241,"easy":"إذا وسمت الحيوان في وجهه ← لعنك الله","cause":"وُسِمَ في وجهِه","result":"لَعَنَ اللهُ الذي وسَمَه","explicit":true,"repOf":"س-03617","ref":"صحيح مسلم 2117","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم مَرَّ عليه حِمارٌ قد ",["وُسِمَ في وجهِه",1],"، فقال: ",["لَعَنَ اللهُ الذي وسَمَه",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه ابن حبان (5628) بلفظه، وأبو داود (2564)، والترمذي (1710) كلاهما بمعناه.","bab":"آداب عامة › الرفق بالحيوان والطير ونحوهما","dorar":"qF3IDZTK","merged":2,"otherRefs":["تخريج صحيح ابن حبان 5628 (صحيح)"]},{"id":"س-01197","fp":"35e94a3d462e","stateId":241,"easy":"إذا أعنت على خصومة باطل ← تبقى في سخط الله حتى تنزع","cause":"ومَن أعان على خصومةِ باطلٍ","result":"لم يزَلْ في سَخَطِ اللهِ حتَّى ينزِعَ","explicit":true,"similar":["س-01190"],"ref":"مجمع الزوائد 10/94","srcLabel":"أبو داود","text":["مَن قال سُبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ واللهُ أكبَرُ كُتِبَتْ له بكلِّ حرفٍ عَشْرُ حسناتٍ ",["ومَن أعان على خصومةِ باطلٍ ",1],["لم يزَلْ في سَخَطِ اللهِ حتَّى ينزِعَ ",2],"ومَن حالت شفاعتُه دونَ حدٍّ مِن حدودِ اللهِ فقد ضادَّ اللهَ في أمرِه ومَن بهَت مؤمنًا أو مؤمنةً حبَسه اللهُ في رَدْغةِ الخَبالِ يومَ القيامةِ حتَّى يخرُجَ ممَّا قال وليس بخارجٍ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"رجاله رجال الصحيح غير محمد بن منصور الطوسي وهو ثقة","takhrij":"أخرجه أبو داود (3597)، وأحمد (5544) باختلاف يسير، وابن ماجه (2320) مختصراً","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"A31kGr3M","merged":2,"otherRefs":["هداية الرواة 3/437 (حسن)"]},{"id":"س-01706","fp":"09c2144b0517","stateId":241,"easy":"إذا حملت السلاح على المسلمين ← فلست منا","cause":"مَن حمَلَ علينا السِّلاحَ","result":"فليس منَّا","explicit":true,"similar":["س-02576"],"ref":"تخريج المسند لشعيب 7033","srcLabel":"أبو داود","text":["مَن قتَلَ مؤمنًا مُتعمِّدًا فإنَّه يُدفَعُ إلى أَولياءِ القتيلِ، فإنْ شاؤوا قتَلوا، وإنْ شاؤوا أخَذوا الدِّيَةَ، وهي ثلاثونَ حِقَّةً وثلاثونَ جَذَعةً وأربعونَ خَلِفةً، فذلك عَقلُ العَمدِ، وما صالَحوا عليه مِن شيءٍ فهو لهم، وذلك شديدُ العَقلِ، وعَقلُ شِبهِ العَمدِ مُغلَّظةٌ مِثلُ عَقلِ العَمدِ، ولا يُقتَلُ صاحبُه؛ وذلك أنْ ينزَغَ الشَّيطانُ بينَ النَّاسِ، فتكونَ دِماءٌ في غيرِ ضَغينةٍ، ولا حَملِ سِلاحٍ؛ فإنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال: -يعني- ",["مَن حمَلَ علينا السِّلاحَ ",1],["فليس منَّا",2],"، ولا رصَدَ بطَريقٍ، فمَن قُتِلَ على غيرِ ذلك، فهو شِبهُ العَمدِ، وعَقلُه مُغلَّظةٌ، ولا يُقتَلُ صاحبُه، وهو بالشَّهرِ الحرامِ، ولِلحُرمةِ ولِلجارِ، ومَن قُتِلَ خطأً فديَتُه مِئةٌ مِن الإبلِ: ثلاثونَ ابنةُ مَخاضٍ، وثلاثونَ ابنةُ لَبونٍ، وثلاثونَ حِقَّةٌ، وعشْرةُ بَكارةٍ بني لَبونٍ ذُكورٍ. قال: وكان رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يُقيمُها على أهلِ القُرى أربعَ مِئةِ دينارٍ، أو عَدلَها مِن الوَرِقِ، وكان يُقيمُها على أثمانِ الإبلِ، فإذا غلَتْ، رفَعَ في قيمتِها، وإذا هانتْ، نَقَصَ مِن قيمتِها، على عَهدِ الزَّمانِ ما كان، فبلَغَتْ على عَهدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ ما بينَ أربعِ مِئةِ دينارٍ إلى ثمانِ مِئةِ دينارٍ، وعَدلُها مِن الوَرِقِ ثمانيةُ آلافِ درهمٍ، وقَضى أنَّ مَن كان عَقلُه على أهلِ البقرِ، في البقرِ مِئتَيْ بقرةٍ، وقَضى أنَّ مَن كان عَقلُه على أهلِ الشَّاءِ، فألْفَيْ شاةٍ، وقَضى في الأَنفِ إذا جُدِعَ كلُّه، بالعَقلِ كاملًا، وإذا جُدِعَتْ أَرنَبتُه، فنِصفُ العَقلِ، وقَضى في العَينِ نِصفَ العَقلِ، خمسينَ مِن الإبلِ، أو عَدلَها ذهبًا أو وَرِقًا، أو مِئةَ بقرةٍ، أو ألْفَ شاةٍ، والرِّجْلُ نِصفُ العَقلِ، واليدُ نِصفُ العَقلِ، والمَأمومةُ ثُلثُ العَقلِ، ثلاثٌ وثلاثونَ مِن الإبلِ، أو قيمَتُها مِن الذَّهبِ، أو الوَرِقِ، أو البقرِ، أو الشَّاءِ، والجائفةُ ثُلثُ العَقلِ، والمُنَقِّلةُ خَمسَ عشْرةَ مِن الإبلِ، والموضِحةُ خَمسٌ مِن الإبلِ، والأسنانُ خَمسٌ مِن الإبلِ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"حسن وبعضه صحيح","takhrij":"أخرجه أبو داود (4564)، والنسائي (4801)، وابن ماجه (2630)، وأحمد (7033) واللفظ له","bab":"أقضية وأحكام › قضايا حكم فيها النبي صلى الله عليه وسلم","dorar":"dlTxlp4L","merged":2,"otherRefs":["غاية المرام 101 (صحيح)"]},{"id":"س-04837","fp":"b8cc0c0176fa","stateId":241,"easy":"إذا قطعت السدر (الذي يستظل به الناس) ← لعنك الله","cause":"قاطعَ السِّدْرِ","result":"لعن اللهُ","explicit":true,"ref":"صحيح الجامع 5909","srcLabel":"السنة","text":["من اللهِ تعالى لا من رسولِه : ",["لعن اللهُ",2],[" قاطعَ السِّدْرِ",1]],"grade":"صحيح","narrator":"معاوية بن حيدة القشيري وعلي بن أبي طالب","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"UEiyYPYQ","merged":2,"otherRefs":["تخريج سنن أبي داود 5241 (حسن)"]},{"id":"س-07278","fp":"f38c0026756b","stateId":241,"easy":"إذا أخفت أهل المدينة ← فقد أخفت ما بين جنبي النبي ﷺ","cause":"مَن أخافَ أهلَ المدينةِ","result":"فقد أخافَ ما بَينَ جَنبَيَّ","explicit":true,"otherNeedIds":[26],"ref":"تخريج المسند لشعيب 14818","srcLabel":"أحمد","text":["أنَّ أميرًا مِن أُمَراءِ الفِتْنةِ قَدِمَ المدينةَ، وكان قد ذَهَبَ بَصَرُ جابِرٍ، فقيلَ لجابِرٍ: لو تنَحَّيتَ عنه، فخَرَجَ يَمشي بَينَ ابنَيه فنُكِّبَ، فقال: تَعِسَ مَن أخافَ رسولَ اللهِ صلَّى اللهُ عليه وسَلَّم، فقال ابناه -أو أحدُهُما-: يا أبَتِ، وكيف أخافَ رسولَ اللهِ صلَّى اللهُ عليه وسَلَّم، وقد ماتَ؟ قال: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسَلَّم يقولُ: ",["مَن أخافَ أهلَ المدينةِ",1],"، ",["فقد أخافَ ما بَينَ جَنبَيَّ",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أحمد (14818) واللفظ له، وابن أبي شيبة (33094)، والحارث في ((المسند)) (394) المرفوع منه مطولاً","bab":"فتن › ظهور الفتن","dorar":"edCH4Ug7","merged":2,"otherRefs":["السلسلة الصحيحة 7/1281 (حسن)"]},{"id":"س-08277","fp":"41561a408cef","stateId":241,"easy":"إذا فرّقت (بين الوالدة وولدها في البيع) ← فأنت ملعون","cause":"فرَّق","result":"ملعونٌ من","explicit":true,"ref":"الجامع الصغير 8189","srcLabel":"الحاكم","text":[["ملعونٌ من",2],[" فرَّق ",1],"[بين الوالدةِ وولدِها وبين الأخِ وأخيِه]"],"grade":"صحيح","narrator":"عمران بن حصين","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (2333)، والبيهقي (18368)، والدارقطني (3044) جميعًا بلفظه، وأخرجه الطبراني في ((الدعاء)) (2114) بلفظه مطولًا","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"E630Fn4G","merged":2,"otherRefs":["الجامع الصغير 8869 (صحيح)"]},{"id":"س-00372","fp":"3e7e08cd4e59","stateId":241,"easy":"إذا أضللت الأعمى عن الطريق ← لعنك الله","cause":"مَن كَمَهَ الأعمى عن السَّبيلِ","result":"ولعَن اللهُ","explicit":true,"ref":"صحيح ابن حبان 4417","srcLabel":"أحمد","text":["لعَن اللهُ مَن ذبَح لغيرِ اللهِ ولعَن اللهُ مَن غيَّر تُخومَ الأرضِ ولعَن اللهُ ",["مَن كَمَهَ الأعمى عن السَّبيلِ",1]," ",["ولعَن اللهُ",2]," مَن سبَّ والدَيهِ ولعَن اللهُ مَن تولَّى غيرَ مواليه ولعَن اللهُ من عمِل عمَلَ قومِ لوطٍ ) قالها ثلاثًا في عمَلِ قومِ لوطٍ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (2816)، والطبراني (11/218) (11546)، والحاكم (8052) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"uM3xrugw"},{"id":"س-01190","fp":"97c494938626","stateId":241,"easy":"إذا أعنت على خصومة بغير حق ← تبقى في سخط الله حتى تترك","cause":"ومن أعانَ على خصومةٍ بغيرِ حقٍّ","result":"فهو مُستظلٌّ في سخطِ اللهِ حتى يتركَ","explicit":true,"repOf":"س-01197","ref":"تخريج المسند لشاكر 7/255","text":["عن أيوب بن سلمان رجل من أهل صنعاء قال: كنَّا بمكةَ فجلسنا إلى عطاءٍ الخراسانيِّ إلى جنبِ جدارِ المسجدِ فلم نسألْه ولم يُحدِّثْنا قال ثم جلسنا إلى ابنِ عمرَ مثلَ مجلسِكم هذا فلمْ نسألْه ولم يُحدِّثْنا قال فقال ما بالُكم لا تتكلَّمونَ ولا تذكرونَ اللهَ قولوا اللهُ أكبرُ والحمدُ للهِ وسبحانَ اللهِ وبحمدِهِ بواحدةٍ عشرًا وبعشرٍ مائةً من زادَ زادهُ اللهُ ومن سكتَ غُفِرَ لهُ ألا أُخبرُكم بخمسٍ سمعتهنَّ من رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ؟ قالوا : بَلَى قال من حالتْ شفاعتُهُ دونَ حَدٍّ من حدودِ اللهِ فهو مُضَادُّ اللهِ في أمرِهِ ",["ومن أعانَ على خصومةٍ بغيرِ حقٍّ ",1],["فهو مُستظلٌّ في سخطِ اللهِ حتى يتركَ",2]," ومن قَفَا مؤمنًا أو مؤمنةً حبسهُ اللهُ في رَدْغَةِ الخَبَالِ عصارةِ أهلِ النارِ ومن ماتَ وعليهِ دَيْنٌ أُخِذَ لصاحبِه من حسناتِه لا دينارَ ثَمَّ ولا درهمَ وركعتا الفجرِ، حافظوا عليهما فإنَّهما من الفضائلِ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (5544)","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"2sGjBDac"},{"id":"س-01837","fp":"d94e6917a843","stateId":241,"easy":"إذا أخفت أهل المدينة ← فعليك لعنة الله وغضبه","cause":"من أخاف أهلَ المدينةِ","result":"فعليه لعنةُ اللهِ وغضبُه لا يَقبلُ اللهُ منه صرفًا ولا عدلًا","explicit":true,"ref":"السلسلة الصحيحة 5/383","srcLabel":"ابن أبي شيبة","text":[["من أخاف أهلَ المدينةِ",1]," . . . ",["فعليه لعنةُ اللهِ وغضبُه لا يَقبلُ اللهُ منه صرفًا ولا عدلًا",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي شيبة في ((المصنف)) (33094)، والحارث في ((المسند)) (394)، والدولابي في ((الكنى والأسماء)) (733) واللفظ له","bab":"إحسان › إبطال الأعمال","dorar":"SN1JSljL"},{"id":"س-02576","fp":"366b5f1263a0","stateId":241,"easy":"إذا حملت السلاح علينا ← فلست من النبي ﷺ","cause":"مَنْ حمَلَ السِّلاحَ علينا","result":"فليس منِّي","explicit":true,"repOf":"س-01706","ref":"تخريج المسند لشعيب 8359","text":[["مَنْ حمَلَ السِّلاحَ علينا ",1],["فليس منِّي",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (2575)، وأحمد (8359) واللفظ له","bab":"إيمان › أعمال تنافي الإيمان","dorar":"57d7eNzN"},{"id":"س-04408","fp":"a3460adc3443","stateId":241,"easy":"إذا دعوت إلى عصبية أو قاتلت عليها أو مت عليها ← فلست منا","cause":"دعا إلى عصبيةٍ، و ليسَ منَّا منْ قاتلَ على عصبيةٍ، و ليسَ منَّا منْ ماتَ على عصبيةٍ","result":"ليسَ منَّا منْ","explicit":true,"ref":"الجامع الصغير 7665","srcLabel":"أبو داود","text":[["ليسَ منَّا منْ",2],[" دعا إلى عصبيةٍ،  و ليسَ منَّا منْ قاتلَ على عصبيةٍ،  و ليسَ منَّا منْ ماتَ على عصبيةٍ",1]],"grade":"صحيح","narrator":"جبير بن مطعم","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5121)، والبيهقي في ((الآداب)) (170)، والبغوي في ((شرح السنة)) (3543) واللفظ لهم.","bab":"جهاد › النية في القتال والغزو","dorar":"QYxCMdpt"},{"id":"س-04582","fp":"2eee729dd086","stateId":241,"easy":"إذا قتلت في فتنة عمياء ← فعليك لعنة الله والملائكة والناس","cause":"مَن قُتِلَ في عِمِّيَّا أو رِمِّيَا تكونُ بَيْنَهم بحَجَرٍ أو بسَوْطٍ أو بعَصًا فعَقْلُه عَقْلُ خَطَأٍ، ومَن قُتِلَ عَمْدًا فقَوَدُ يَدَيه، ومَن حالَ بَيْنَه وبَيْنَه","result":"فعليه لَعْنةُ اللهِ والمَلائِكةِ والنَّاسِ أَجْمَعينَ، لا يُقبَلُ مِنه صَرْفٌ ولا عَدْلٌ","explicit":true,"otherNeedIds":[45],"ref":"الأحكام الوسطى 4/ 50","srcLabel":"السنة","text":["\"",["مَن قُتِلَ في عِمِّيَّا أو رِمِّيَا تكونُ بَيْنَهم بحَجَرٍ أو بسَوْطٍ أو بعَصًا فعَقْلُه عَقْلُ خَطَأٍ، ومَن قُتِلَ عَمْدًا فقَوَدُ يَدَيه، ومَن حالَ بَيْنَه وبَيْنَه ",1],["فعليه لَعْنةُ اللهِ والمَلائِكةِ والنَّاسِ أَجْمَعينَ، لا يُقبَلُ مِنه صَرْفٌ ولا عَدْلٌ\"",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","bab":"حدود › الحث على إقامة الحدود","dorar":"XxadeSmz"},{"id":"س-04940","fp":"3fc57a4ee81b","stateId":241,"easy":"إذا قتلت في الحرم أو قتلت غير قاتلك أو قتلت بثأر الجاهلية ← فأنت أعتى الناس على الله","cause":"مَن قتَلَ في حَرمِ اللهِ، أو قتَلَ غيرَ قاتلِه، أو قتَلَ بذُحولِ الجاهليةِ","result":"إنَّ أَعتى النَّاسِ على اللهِ عزَّ وجلَّ","explicit":true,"ref":"تخريج المسند لشعيب 6757","srcLabel":"أحمد","text":[["إنَّ أَعتى النَّاسِ على اللهِ عزَّ وجلَّ",2]," ",["مَن قتَلَ في حَرمِ اللهِ، أو قتَلَ غيرَ قاتلِه، أو قتَلَ بذُحولِ الجاهليةِ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه أحمد (6757) واللفظ له، والحارث في ((المسند)) (697)، وابن عدي في ((الكامل في الضعفاء)) (2/410)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"dyrRkoXP"},{"id":"س-05143","fp":"532acc5f63b7","stateId":241,"easy":"إذا أعنت باطلاً لتدحض به حقاً ← برئت منك ذمة الله ورسوله","cause":"مَن أعانَ باطلًا لِيَدْحَضَ بباطِلِه حَقًّا","result":"فقَدْ بَرِئتْ منه ذِمَّةُ اللهِ وذِمَّةُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ","explicit":true,"ref":"المستدرك على الصحيحين 7248","srcLabel":"الطبراني","text":["عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهُما، قالَ: ",["مَن أعانَ باطلًا لِيَدْحَضَ بباطِلِه حَقًّا، ",1],["فقَدْ بَرِئتْ منه ذِمَّةُ اللهِ وذِمَّةُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ",2],"."],"grade":"صحيح","narrator":"عكرمة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني (11/ 215)، (11359)، والمخلدي في ((المخلديات)) (539)، وزاهر الشحامي في ((حديث السراج)) (2610) جميعهم مرفوعا.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"55y50fz1"},{"id":"س-06922","fp":"b3ffba87e206","stateId":241,"easy":"إذا استعبدت حراً ← لا يكلمك الله ولا ينظر إليك ولك عذاب أليم","cause":"من اعتَبَدَ محرَّرًا","result":"أنَّ اللهَ لا يُكلِّمُهُ ولا ينظرُ إليهِ ولهُ عذابٌ أليمٌ","explicit":true,"otherNeedIds":[57],"ref":"عارضة الأحوذي 1/384","srcLabel":"السنة","text":[["أنَّ اللهَ لا يُكلِّمُهُ ولا ينظرُ إليهِ ولهُ عذابٌ أليمٌ",2]," [ ",["من اعتَبَدَ محرَّرًا",1]," ]"],"grade":"صحيح","muhaddith":"صحيح","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"dRJnXH3D"},{"id":"س-07526","fp":"3bef24a3f8ab","stateId":241,"easy":"إذا اقتطعت أرضاً ظالماً ← تلقى الله وهو عليك غضبان","cause":"مَنِ اقتَطَعَ أرضًا ظالِمًا","result":"لَقيَ اللهَ وهو عليه غَضبانُ","explicit":true,"ref":"صحيح مسلم 139","srcLabel":"أبو داود","text":["كُنتُ عِندَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فأتاه رَجُلانِ يَختَصِمانِ في أرضٍ، فقال أحَدُهما: إنَّ هذا انتَزى على أرضي يا رَسولَ اللهِ، في الجاهِليَّةِ، وهو امرُؤُ القَيسِ بنُ عابِسٍ الكِنديُّ، وخَصمُه رَبيعةُ بنُ عِبدانَ، قال: بَيِّنَتُك، قال: ليس لي بَيِّنةٌ، قال: يَمينُه، قال: إذَن يَذهَبُ بها، قال: ليس لك إلَّا ذاك، قال: فلَمَّا قامَ ليَحلِفَ، قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["مَنِ اقتَطَعَ أرضًا ظالِمًا ",1],["لَقيَ اللهَ وهو عليه غَضبانُ",2],". قال إسحاقُ في رِوايَتِه: رَبيعةُ بنُ عَيدانَ."],"grade":"صحيح","narrator":"وائل بن حجر","muhaddith":"[صحيح]","takhrij":"أخرجه أبو داود (3245)، والترمذي (1340)، النسائي في ((الكبرى)) (5946) جميعا باختلاف يسر","bab":"فضائل النبي وصفته ودلائل النبوة › اختصام المؤمنين إليه صلى الله عليه وسلم وحكمه عليهم","dorar":"b3aQ2sW4"},{"id":"س-07998","fp":"2302d31f7efe","stateId":241,"easy":"إذا أعنت ظالماً بباطل ليدحض حقاً ← برئت من ذمة الله ورسوله","cause":"من أعان ظالمًا بباطلٍ ليدحضَ به حقًّا","result":"برِئ من ذمَّةِ اللهِ وذمَّةِ رسولِ اللهِ","explicit":true,"ref":"الترغيب والترهيب 3/68","srcLabel":"ابن حبان","text":[["من أعان ظالمًا بباطلٍ ليدحضَ به حقًّا",1]," ",["برِئ من ذمَّةِ اللهِ وذمَّةِ رسولِ اللهِ",2]," صلَّى اللهُ عليه وسلَّم ومن أكل درهمًا من ربًا فهو مثلُ ثلاثةِ وثلاثين زنْيةً ومن نبت لحمُه من سُحتٍ فالنَّارُ أولَى به"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن حبان في ((المجروحين)) (1/365)، والطبراني في ((المعجم الأوسط)) (2944)، وأبو نعيم في ((حلية الأولياء)) (5/248) باختلاف يسير.","bab":"مظالم › تحريم الظلم","dorar":"4Iez9hLH"},{"id":"س-08052","fp":"a40b8c4ba060","stateId":241,"easy":"إذا حضرت موقفاً يُقتل فيه أحد ظلماً ولم تدفع عنه ← تنزل عليك اللعنة","cause":"لا يَقِفَنَّ أحَدُكُم موقِفًا يُقتَلُ فيه رَجُلٌ ظُلمًا","result":"فإنَّ اللَّعنةَ تَنزِلُ على مَن حَضَرَه حينَ لم يَدفَعوا عنه","explicit":true,"similar":["س-08053"],"ref":"تنبيه الغافلين 118","srcLabel":"أحمد","text":["«",["لا يَقِفَنَّ أحَدُكُم موقِفًا يُقتَلُ فيه رَجُلٌ ظُلمًا",1],"؛ ",["فإنَّ اللَّعنةَ تَنزِلُ على مَن حَضَرَه حينَ لم يَدفَعوا عنه",2],"، ولا يَقِفَنَّ أحَدُكُم مَوقِفًا يُضرَبُ فيه رَجُلٌ ظُلمًا؛ فإنَّ اللَّعنةَ تَنزِلُ على مَن حَضَرَه حينَ لم يَدفَعوا عنه»"],"grade":"حسن","narrator":"ابن عبَّاسٍ","muhaddith":"إسناده حسن.","takhrij":"أخرجه الطبراني في ((الكبير)) (11/ 260) (11675)، والعقيلي في ((الضعفاء)) (63)، وأحمد بن منيع كما في ((المطالب العالية)) (2135) واللفظ لهم.","bab":"مظالم › تحريم الظلم","dorar":"TjN4UiUN","merged":2,"otherRefs":["إتحاف الخيرة المهرة 4/ 271 (حسن)"]},{"id":"س-08053","fp":"bfc861261a20","stateId":241,"easy":"إذا حضرت موقفاً يُضرب فيه أحد ظلماً ولم تدفع عنه ← تنزل عليك اللعنة","cause":"لا يَقِفَنَّ أحَدُكُم مَوقِفًا يُضرَبُ فيه رَجُلٌ ظُلمًا","result":"فإنَّ اللَّعنةَ تَنزِلُ على مَن حَضَرَه حينَ لم يَدفَعوا عنه","explicit":true,"repOf":"س-08052","ref":"تنبيه الغافلين 118","text":["«لا يَقِفَنَّ أحَدُكُم موقِفًا يُقتَلُ فيه رَجُلٌ ظُلمًا؛ فإنَّ اللَّعنةَ تَنزِلُ على مَن حَضَرَه حينَ لم يَدفَعوا عنه، و",["لا يَقِفَنَّ أحَدُكُم مَوقِفًا يُضرَبُ فيه رَجُلٌ ظُلمًا",1],"؛ ",["فإنَّ اللَّعنةَ تَنزِلُ على مَن حَضَرَه حينَ لم يَدفَعوا عنه",2],"»"],"grade":"حسن","narrator":"ابن عبَّاسٍ","muhaddith":"إسناده حسن.","takhrij":"أخرجه الطبراني في ((الكبير)) (11/ 260) (11675)، والعقيلي في ((الضعفاء)) (63)، وأحمد بن منيع كما في ((المطالب العالية)) (2135) واللفظ لهم.","bab":"مظالم › تحريم الظلم","dorar":"TjN4UiUN","merged":2,"otherRefs":["إتحاف الخيرة المهرة 4/ 271 (حسن)"]},{"id":"س-00221","fp":"130e1fa483a9","stateId":241,"easy":"إذا ركب ثلاثة على بعير (إرهاقاً له) ← فالثالث ملعون","cause":"ثلاثةً على بعيرٍ","result":"الثالثُ ملعونٌ","explicit":true,"ref":"مجمع الزوائد 1/118","srcLabel":"الطبراني","text":["رأى رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["ثلاثةً على بعيرٍ",1]," فقال : ",["الثالثُ ملعونٌ",2]],"grade":"حسن","narrator":"المهاجر بن قنفذ","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (20/ 330) (782)، وابن قانع في ((معجم الصحابة)) (3/ 60) واللفظ لهما.","bab":"آداب المجلس › الركوب على الدابة","dorar":"vo9iaNDH"},{"id":"س-00358","fp":"5893f68c2a32","stateId":241,"easy":"إذا أضررت بمؤمن أو مكرت به ← فأنت ملعون","cause":"ضارَبَ مُؤمِنًا أو مَكَرَ به","result":"مَلعونٌ مَن","explicit":true,"ref":"هداية الرواة 4/451","srcLabel":"الترمذي","text":[["مَلعونٌ مَن",2],[" ضارَبَ مُؤمِنًا أو مَكَرَ به",1],"."],"grade":"حسن","narrator":"أبو بكر الصديق","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه الترمذي (1941) واللفظ له، والبزار (43)، وأبو يعلى (96) مطولاً باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"4dTgEYmU"},{"id":"س-00363","fp":"f8cfdeb6350f","stateId":241,"easy":"إذا آذيت مسلماً ← فقد آذيت النبي ﷺ ومن آذاه فقد آذى الله","cause":"مَنْ آذى مسلمًا","result":"فقدْ آذانِي، و مَنْ آذاني فقدْ آذى اللهَ","explicit":true,"ref":"الجامع الصغير 8250","srcLabel":"الطبراني","text":[["مَنْ آذى مسلمًا ",1],["فقدْ آذانِي،  و مَنْ آذاني فقدْ آذى اللهَ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((المعجم الصغير)) (468)، وفي ((المعجم الأوسط)) (3607)، والبيهقي في ((شعب الإيمان)) (2741) مطولا.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"VbUNpOx0"},{"id":"س-00461","fp":"82b459137ed3","stateId":241,"easy":"إذا ركب ثلاثة على بغل ← لُعن الثالث","cause":"ثلاثةً على بغلٍ","result":"لعنَ الثَّالثَ","explicit":true,"ref":"الآداب الشرعية 1/456","srcLabel":"أبو داود","text":["رأى عليٌّ ",["ثلاثةً على بغلٍ",1]," فقالَ : لينزل أحدُكم فإنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّمَ ",["لعنَ الثَّالثَ",2]],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"إسناده جيد","takhrij":"أخرجه أبو داود في ((مراسيله)) (299)","bab":"آداب عامة › الرفق بالحيوان والطير ونحوهما","dorar":"2ssq9VuH"},{"id":"س-03637","fp":"2ee7b05c1f1b","stateId":241,"easy":"إذا تعاطيتم سيفاً مسلولاً ← لعنكم الله","cause":"يَتَعاطَون سَيفًا مَسلولًا","result":"لَعَن اللهُ مَن فَعَل هذا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 7996","srcLabel":"أحمد","text":["مرَّ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ على قَومٍ ",["يَتَعاطَون سَيفًا مَسلولًا",1],"، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["لَعَن اللهُ مَن فَعَل هذا",2],"، أوَلَيسَ قد نَهَيتُ عنْ هذَا؟! إذا سَلَّ أحَدُكُم سَيفًا يَنظُرُ إليه فأرادَ أن يُناوِلَه أخاه، فليُغمِدْه، ثمَّ يُناوِلْه إيَّاه."],"grade":"صحيح","narrator":"أبو بكرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (20429)، وابن عدي في ((الكامل في الضعفاء)) (8/ 24)، وعبد الغني المقدسي في ((تحريم القتل وتعظيمه)) (35) جميعا بلفظه  .","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"VT80LzZU"},{"id":"س-04785","fp":"c1617f0400a2","stateId":241,"easy":"إذا آذيت المسلمين في طريقهم ← وجبت عليك لعنتهم","cause":"مَن آذى المُسلمينَ في طَريقِهم","result":"وجَبَت عليه لَعنتُهم","explicit":true,"ref":"تنبيه الغافلين 324","srcLabel":"الطبراني","text":["\"",["مَن آذى المُسلمينَ في طَريقِهم ",1],["وجَبَت عليه لَعنتُهم\"",2]],"grade":"حسن","narrator":"حذيفة بن أسيد","muhaddith":"إسناده حسن.","takhrij":"أخرجه الطبراني في ((الكبير)) (3/ 179) (3050)، وابن النجار في ((ذيل تاريخ بغداد)) (20/ 123)، والنسفي في ((أخبار سمرقند)) (صـ224) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"ShLpo2kW"},{"id":"س-04899","fp":"6ae665e491e0","stateId":241,"easy":"إذا آذيت أهل المدينة ← آذاك الله وعليك لعنته ولا يُقبل منك","cause":"منْ آذى أهلَ المدينةِ، آذاهُ اللهُ، و عليهِ لعنةُ اللهِ، و الملائكةِ و الناسِ أجمعينَ","result":"لا يُقبلُ منهُ صرفٌ، و لا عدلٌ","explicit":true,"otherNeedIds":[45],"ref":"الجامع الصغير 8249","srcLabel":"الطبراني","text":[["منْ آذى أهلَ المدينةِ،  آذاهُ اللهُ،  و عليهِ لعنةُ اللهِ،  و الملائكةِ و الناسِ أجمعينَ،  ",1],["لا يُقبلُ منهُ صرفٌ،  و لا عدلٌ",2]],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن","takhrij":"لم نقف عليه إلا عند الطبراني  (13/ 655) (14582) بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"FUzI81YX"},{"id":"س-05049","fp":"d19f1355eac2","stateId":241,"easy":"إذا آذيت ذمياً ← فالنبي ﷺ خصمك","cause":"مَنْ آذَى ذِمِّيًا","result":"فأناْ خَصمُهُ","explicit":true,"otherNeedIds":[57],"ref":"مختصر المقاصد 960","srcLabel":"السنة","text":[["مَنْ آذَى ذِمِّيًا ",1],["فأناْ خَصمُهُ",2]],"grade":"حسن","muhaddith":"حسن","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"hodNsWaE"},{"id":"س-05260","fp":"d9fb4fc008d7","stateId":241,"easy":"إذا ظلمت أهل المدينة وأخفتهم ← أخافك الله وعليك لعنته","cause":"من ظلَمَ أهلَ المدينةِ وأخافهم","result":"فأخِفْه، وعليه لَعنةُ اللهِ","explicit":true,"ref":"علل ابن أبي حاتم 2605","srcLabel":"الطبراني","text":["حَديثٌ رواه معاويةُ بنُ عَبدِ اللهِ الزُّبَيريُّ، عن عائِشةَ بنتِ الزُّبَيرِ بنِ هِشامِ بنِ عُرْوةَ، عن هِشامِ بنِ عُرْوةَ، عن موسى بنِ عُقبةَ، عن عَطاءِ بنِ يَسارٍ، عَنِ السَّائبِ بنِ خَلَّادٍ، عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم أنَّه قال: اللهُمَّ ",["من ظلَمَ أهلَ المدينةِ وأخافهم؛ ",1],["فأخِفْه، وعليه لَعنةُ اللهِ",2],"...، وذَكَر الحَديثَ؟\nقال أبو زُرْعةَ: وروى هذا الحَديثَ اللَّيثُ بنُ سَعدٍ، عن هِشامِ بنِ عُرْوةَ، عن موسى بنِ عُقبةَ، عن عَطاءِ بنِ يَسارٍ، عن عُبادةَ بنِ الصَّامِتِ، عَنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم."],"grade":"حسن","narrator":"السائب بن خلاد","muhaddith":"قال: حديثُ عائِشةَ بنتِ الزُّبَيرِ أصَحُّ؛ لأنَّ النَّاسَ قد رَوَوه عَنِ السَّائبِ بنِ خَلَّادٍ.\n[قال ابنُ أبي حاتِمٍ] قُلتُ لأبي زُرْعةَ: ما حالُ معاويةَ بنِ عَبدِ اللهِ هذا؟\nقال: لا بأسَ به، كتَبْنا عنه بالبَصْرةِ، أخرَجَ إلينا جُزُؤ عن عائِشةَ، فانتخَبْتُ منه أحاديثَ [غرائِبَ]، وتركْتُ المشاهيرَ.\nقُلتُ [ابنُ أبي حاتِمٍ]: ما حالُ عائشةَ؛ هل روى عنها أحَدٌ سوى معاويةُ؟\nقال: نعم؛ حَدَّثَنا عنها المدنيُّونَ.","takhrij":"أخرجه الطبراني (7/ 144) (6636) واللفظ له.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"qUfPOTzp"},{"id":"س-08027","fp":"6cc8d46e4aec","stateId":241,"easy":"إذا صليت وعندك لأحد مظلمة ← تلحقك اللعنة ما دمت قائماً تصلي","cause":"أنْ لا يَدْخُلوا بَيْتًا من بُيُوتِي ولأَحَدٍ عندَهُمْ مَظْلِمَةٌ","result":"فإني أَلْعَنَهُ ما دَامَ قائِمًا بين يَدَيَّ يصلَّى","explicit":true,"ref":"جامع العلوم والحكم 2/333","srcLabel":"أبو نعيم","text":["إِنَّ اللهَ تَعالَى أوْحَى إِلَيَّ: يا أَخَا المرسلينَ ، ويا أَخَا المُنْذِرِينَ أنْذِرْ قَوْمَكَ ",["أنْ لا يَدْخُلوا بَيْتًا من بُيُوتِي ولأَحَدٍ عندَهُمْ مَظْلِمَةٌ",1],"، ",["فإني أَلْعَنَهُ ما دَامَ قائِمًا بين يَدَيَّ يصلَّى",2]," حتى يَرُدَّ تِلْكَ الظَّلامَةَ إلى أهلِهِا، فَأَكُونُ سَمْعَهُ الذي يسمعُ بِه، وأَكُونُ بَصَرَهُ الذي يُبْصِرُ بِه، ويكونُ من أوْلِيائِي وأَصْفيائِي, ويكونُ جَارِي مع النَّبيينَ والصِّدِّيقِينَ والشُّهَدَاءِ في الجنةِ ."],"grade":"حسن","narrator":"حذيفة بن اليمان","muhaddith":"إسناده جيد وهو غريب جدا","takhrij":"أخرجه أبو نعيم في ((حلية الأولياء)) ((6/ 116)) واللفظ له، وابن عساكر في ((تاريخ دمشق)) ((65/ 44)) بنحوه.","bab":"مظالم › تحريم الظلم","dorar":"ZaiwmmZL"},{"id":"س-08198","fp":"77c0931f5d79","stateId":241,"easy":"إذا شهرت السلاح على أخيك ← تظل الملائكة تلعنك حتى تغمده","cause":"إذا شَهَرَ المسلِمُ على أخِيهِ سِلاحًا","result":"فلَا تَزالُ مَلائكةُ اللهِ تَلْعَنُهُ حتى يُشْيمَهُ عنْهُ","explicit":true,"ref":"صحيح الجامع 635","srcLabel":"البزار","text":[["إذا شَهَرَ المسلِمُ على أخِيهِ سِلاحًا",1]," ، ",["فلَا تَزالُ مَلائكةُ اللهِ تَلْعَنُهُ حتى يُشْيمَهُ عنْهُ",2]],"grade":"حسن","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"حسن","takhrij":"أخرجه البزار (3641) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (3/423) باختلاف يسير","bab":"ملائكة › أعمال الملائكة","dorar":"gcVvx8sN"},{"id":"س-03861","fp":"b1f0dc15dff1","stateId":242,"easy":"إذا انتهبت ← فلست منا","cause":"ومنِ انتَهَب","result":"فليس مِنا","explicit":true,"star":true,"similar":["س-07984"],"ref":"إتحاف الخيرة المهرة 4/ 102","srcLabel":"مسلم","text":["أخَذ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم على النساءِ حين بايعَهُنَّ أن لا ينُحنَ ، فقُلنَ : يا رسولَ اللهِ ، إنَّ نساءً أسعَدنَنا في الجاهليةِ ، أفنُسعِدُهُنَّ في الإسلامِ ؟ فقال النبيُّ صلَّى اللهُ عليه وسلَّم : لا إسعادِ في الإسلامِ ، ولا شِغارَ في الإسلامِ ، ولا عقرَ في الإسلامِ ، ولا جلبَ في الإسلامِ ، ولا جنبَ ، ",["ومنِ انتَهَب ",1],["فليس مِنا",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه النسائي (1852)، وأحمد (13055) واللفظ له","bab":"بيعة › مبايعة النساء","dorar":"HyV3t9TW","merged":6,"otherRefs":["سنن الترمذي 1601 (صحيح)","صحيح الجامع 7486 (صحيح)","الأحاديث المختارة 2126 (صحيح)","تخريج المسند لشعيب 15254 (صحيح)","تخريج المسند لشعيب 15070 (صحيح)"]},{"id":"س-00826","fp":"2f3addaa116c","stateId":242,"easy":"إذا تحايلت على ما حرّم الله فبعته وأكلت ثمنه ← قاتلك الله كما قاتل اليهود","cause":"لمَّا حَرَّمَ شُحومَها جَمَلوهُ ثُمَّ باعوهُ وأكَلوا ثَمَنَه","result":"قاتَلَ اللهُ اليَهودَ","explicit":true,"star":true,"similar":["س-07593"],"ref":"مجموع الشروح الفقهية. 10/9","srcLabel":"متفق عليه","text":["إنَّ اللهَ حَرَّمَ بَيعَ الخَمرِ والمَيتةِ والخِنزيرِ والأصنامِ. فقيلَ: يا رَسولَ اللهِ، أرَأيتَ شُحومَ المَيتةِ؛ فإنَّه يُطلى بها السُّفُنُ ويُدهَنُ بها الجُلودُ ويَستَصبِحُ بها النَّاسُ؟ فقال: لا، هو حَرامٌ. ثُمَّ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم عِندَ تلك: ",["قاتَلَ اللهُ اليَهودَ",2],"، إنَّ اللهَ ",["لمَّا حَرَّمَ شُحومَها جَمَلوهُ ثُمَّ باعوهُ وأكَلوا ثَمَنَه",1],"."],"grade":"صحيح","narrator":"جابر","muhaddith":"صحيح","takhrij":"أخرجه البخاري (2236)، ومسلم (1581)، وأبو داود (3486) واللفظ لهم.","bab":"أدعية وأذكار › دعاء النبي على بعض الأشخاص والأشياء والأمور","dorar":"LJTHHHac","merged":3,"otherRefs":["الأحاديث المختارة 9 / 510 (صحيح)","الأوسط لابن المنذر 2/413 (صحيح)"]},{"id":"س-05107","fp":"d9895344232a","stateId":242,"easy":"إذا أكلت الربا أو أوكلته أو كتبته أو شهدت عليه ← فأنت ملعون على لسان محمد ﷺ","cause":"آكِلُ الرِّبا ومُوكِلُه وكاتِبُه وشاهِداه إذا علِموا به، والواشِمةُ والمُستَوشِمةُ للحُسنِ، ولاوي الصَّدقةِ، والمُرتدُّ أَعرابيًّا بعدَ هِجرتِه","result":"مَلعونونَ على لِسانِ محمَّدٍ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 3881","srcLabel":"متفق عليه","text":[["آكِلُ الرِّبا ومُوكِلُه وكاتِبُه وشاهِداه إذا علِموا به، والواشِمةُ والمُستَوشِمةُ للحُسنِ، ولاوي الصَّدقةِ، والمُرتدُّ أَعرابيًّا بعدَ هِجرتِه",1],": ",["مَلعونونَ على لِسانِ محمَّدٍ",2]," صلَّى اللهُ عليه وسلَّمَ يومَ القيامةِ، قال: فذكَرْتُ ذلك لإبراهيمَ، فقال: حدَّثَني عَلقَمةُ، قال: قال عبدُ اللهِ: آكِلُ الرِّبا، ومُوكِلُه سَواءٌ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الترمذي (1206)، وابن ماجه (2277) مختصرا باختلاف يسير، ولعن الواشمة أخرجه البخاري (5939)، ومسلم (2125) مطولاً","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"lGKKa2C1","merged":3,"otherRefs":["تخريج المسند لشعيب 671 (حسن)","تخريج المسند لشعيب 635 (حسن)"]},{"id":"س-04593","fp":"eae5544fc17c","stateId":242,"easy":"إذا سرقت ولو البيضة أو الحبل ← لعنك الله وقُطعت يدك","cause":"السَّارِقَ، يَسرِقُ البَيضةَ فتُقطَعُ يَدُه، ويَسرِقُ الحَبلَ فتُقطَعُ يَدُه","result":"لَعَنَ اللهُ","explicit":true,"star":true,"ref":"صحيح مسلم 1687","srcLabel":"البخاري","text":[["لَعَنَ اللهُ",2],[" السَّارِقَ، يَسرِقُ البَيضةَ فتُقطَعُ يَدُه، ويَسرِقُ الحَبلَ فتُقطَعُ يَدُه",1],". [وفي روايةٍ]: مِثلَه، غيرَ أنَّه يقولُ: إن سَرَقَ حَبلًا، وإن سَرَقَ بَيضةً."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6783)","bab":"حدود › حد السرقة ونصابها","dorar":"yTfesNji","merged":2,"otherRefs":["المستدرك على الصحيحين 8352 (صحيح)"]},{"id":"س-05104","fp":"1cb880662e5e","stateId":242,"easy":"إذا سرقت حدود الأرض (منارها) ← لعنك الله","cause":"مَن سرَق مَنارَ الأرضِ","result":"ولعَن اللهُ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 1307","srcLabel":"مسلم","text":["عن أبي الطُّفَيلِ، قال: سُئِلَ عليٌّ: هل خصَّكم رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بشيءٍ؟ فقال: ما خصَّنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بشيءٍ لم يعُمَّ به النَّاسَ كافَّةً، إلَّا ما كان في قِرابِ سَيْفي هذا. قال: فأَخرَج صَحيفةً فيها مكتوبٌ: لعَن اللهُ مَن ذبَح لغيْرِ اللهِ، لعَن اللهُ ",["مَن سرَق مَنارَ الأرضِ، ",1],["ولعَن اللهُ ",2],"مَن لعَن والدَه، ولعَن اللهُ مَن آوَى مُحدِثًا."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (1978)، وأحمد (1307) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Ip8Twklz","merged":3,"otherRefs":["صحيح ابن حبان 4417 (صحيح)","تخريج المسند لشعيب 855 (صحيح)"]},{"id":"س-05183","fp":"41283e728b57","stateId":242,"easy":"إذا خنت من ائتمنك ← فالنبي ﷺ خصمك","cause":"من خان من ائتَمَنه","result":"فأنا خَصْمُه","explicit":true,"otherNeedIds":[57],"ref":"الترغيب والترهيب 3/42","srcLabel":"البخاري","text":[["من خان من ائتَمَنه ",1],["فأنا خَصْمُه",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"لم نجده بتمام لفظه فيما لدينا من كتب مسندة. وأخرجه البخاري (2227) بمعناه","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"m96wxAU0"},{"id":"س-00362","fp":"ad60c967db2a","stateId":242,"easy":"إذا غششت ← فلست منا","cause":"من غَشَّ","result":"فليس مِنَّا","explicit":true,"similar":["س-05209","س-02594"],"ref":"الجامع الصغير 8860","srcLabel":"مسلم","text":[["من غَشَّ ",1],["فليس مِنَّا ",2],"[يعني حديث: أنَّ رسولَ اللَّهِ -صلَّى اللَّهُ علَيهِ وسلَّمَ- مرَّ علَى صُبرةٍ مِن طعامٍ فأدخلَ يدَهُ فيها، فَنالَت أصابعُهُ بللًا. فقالَ : يا صاحبَ الطَّعامِ ما هذَا ؟ قالَ : أصابَتهُ السَّماءُ ، يا رسولَ اللَّهِ. قالَ أفَلا جعلتَهُ فَوقَ الطَّعامِ حتَّى يراهُ النَّاسُ ثمَّ قالَ مَن غشَّ فلَيسَ منَّا]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3452) واللفظ له مطولاً، وأخرجه مسلم (102) مطولاً باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"jA8mn9qv","merged":2,"otherRefs":["صحيح الجامع 5440 (صحيح)"]},{"id":"س-04972","fp":"3db13e840a47","stateId":242,"easy":"إذا لم تترك المخابرة (المزارعة المحرمة) ← فأذن بحرب من الله ورسوله","cause":"مَنْ لمْ يذَرِ المُخابرَةَ","result":"فلْيُؤذَنْ بحربٍ مِنَ اللهِ ورسولِهِ","explicit":true,"ref":"المستدرك على الصحيحين 3170","srcLabel":"مسلم","text":["لمَّا نَزَلَتْ: {الَّذِينَ يَأْكُلُونَ الرِّبَا لَا يَقُومُونَ إِلَّا كَمَا يَقُومُ الَّذِي يَتَخَبَّطُهُ الشَّيْطَانُ مِنَ الْمَسِّ} [البقرة: 275]، قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «",["مَنْ لمْ يذَرِ المُخابرَةَ ",1],["فلْيُؤذَنْ بحربٍ مِنَ اللهِ ورسولِهِ»",2],"."],"grade":"صحيح","narrator":"جابر","muhaddith":"صحيح على شرط مسلم","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"UN99zEpV"},{"id":"س-05209","fp":"955c5bbe7659","stateId":242,"easy":"إذا غششتنا ← فلست منا","cause":"من غشَّنا","result":"فليسَ منَّا","explicit":true,"repOf":"س-00362","otherNeedIds":[57],"ref":"صحيح الجامع 6407","text":[["من غشَّنا ",1],["فليسَ منَّا ",2],"[يعني حديث: عن أبي الحمراءِ قال : رأيت رسولَ اللهِ صلَّى اللهُ عليهِ وسلمَ مرَّ بجَنَباتِ رجلٍ عندَه طعامٌ في وعاءٍ، فأدخل يدَه فيه، فقال : لعلك غششتَه، مَن غشَّنا فليس منا]"],"grade":"صحيح","narrator":"أبو الحمراء هلال بن الحارث","muhaddith":"صحيح","takhrij":"أخرجه الترمذي في ((العلل الكبير)) (348) واللفظ له، وابن ماجه (2225)، والطبراني (22/199) (524) مطولاً","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"3q5ikOV8","merged":10,"otherRefs":["تخريج مشكل الآثار 1331 (صحيح)","مجمع الزوائد 4-82 (صحيح)","صحيح الجامع 6408 (صحيح)","المستدرك على الصحيحين 2188 (صحيح)","غاية المرام 341 (حسن)","غاية المرام 101 (صحيح)","تخريج المسند لشعيب 15833 (صحيح)","الأوسط لابن المنذر 10/237 (صحيح)","صحيح الترغيب 1766 (حسن)"]},{"id":"س-05258","fp":"c0376fe5878d","stateId":242,"easy":"إذا رشوت أو ارتشيت ← لعنك النبي ﷺ","cause":"الرَّاشِيَ والمُرْتشِيَ","result":"لَعَنَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ","explicit":true,"ref":"الأحكام الوسطى 3/ 340","srcLabel":"السنة","text":["[",["لَعَنَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ",2]," ",["الرَّاشِيَ والمُرْتشِيَ",1],"]، زادَ أبو بَكْرٍ البَزَّارُ: \"والرَّائِشَ الَّذي يَمْشي بَيْنَ الرَّاشي والمُرْتشي."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"hFrh6px9","merged":9,"otherRefs":["فتح الباري لابن حجر 5/261 (صحيح)","مجموع فتاوى ابن باز 232/23 (صحيح)","تخريج المسند لشعيب 22399 (صحيح)","صحيح أبي داود 3580 (صحيح)","إرواء الغليل 2620 (صحيح)","غاية المرام 457 (حسن)","صحيح الجامع 5114 (صحيح)","تخريج المسند لشاكر 11/47 (صحيح)"]},{"id":"س-06156","fp":"d5880e9a1354","stateId":242,"easy":"إذا أكلت الربا أو أوكلته أو شهدته أو كتبته، أو وشمت ← لعنك النبي ﷺ","cause":"آكِلَ الربا، ومُوكِلَه، وشاهدَه وكاتبَه، والوَاشِمَةَ والمُوتَشِمَةَ","result":"لَعَنَ رسولُ اللهِ صلى الله عليه وسلم","explicit":true,"ref":"صحيح النسائي 5119","srcLabel":"النسائي","text":[["لَعَنَ رسولُ اللهِ صلى الله عليه وسلم",2],[" آكِلَ الربا، ومُوكِلَه، وشاهدَه وكاتبَه، والوَاشِمَةَ والمُوتَشِمَةَ ",1],"، قال : إلا مِن داءٍ ؟ فقال : نعم ، والحالُّ المُحَلَّلُ له ، ومانعُ الصدقةِ ، وكان ينهى عن النَّوْحِ ، ولم يَقُلْ لَعَنَ."],"grade":"صحيح","narrator":"الحارث الأعور","muhaddith":"صحيح","takhrij":"أخرجه النسائي (5104)","bab":"زكاة › عقوبة مانع الزكاة","dorar":"YUWi8Ge7","merged":11,"otherRefs":["فتاوى نور على الدرب لابن عثيمين 9/85 (صحيح)","الفتاوى الكبرى 3/96 (صحيح)","تخريج المسند لشعيب 980 (حسن)","صحيح الترغيب 758 (حسن)","تخريج المسند لشعيب 1364 (حسن)","تخريج المسند لشعيب 844 (حسن)","تخريج المسند لشعيب 3809 (صحيح)","المصابيح في الأحاديث المتواترة 613 (صحيح)","تخريج المسند لشاكر 5/274 (صحيح)","صحيح مسلم 1597 (صحيح)"]},{"id":"ق-0116","fp":"4ffc74c5d665","stateId":242,"easy":"الإصرار على الربا ← حرب من الله ورسوله","cause":"الإصرار على الربا","result":"حرب من الله ورسوله","explicit":true,"ref":"سورة البقرة: 278–279","srcLabel":"القرآن الكريم","quran":{"s":2,"from":278,"to":279,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَذَرُوا مَا بَقِيَ مِنَ الرِّبَا إِنْ كُنْتُمْ مُؤْمِنِينَ (278) فَإِنْ لَمْ تَفْعَلُوا فَأْذَنُوا بِحَرْبٍ مِنَ اللَّهِ وَرَسُولِهِ وَإِنْ تُبْتُمْ فَلَكُمْ رُءُوسُ أَمْوَالِكُمْ لَا تَظْلِمُونَ وَلَا تُظْلَمُونَ (279)","hl":[[0,181,1]]}},{"id":"ق-0138","fp":"2df1075da99e","stateId":242,"easy":"شراء ثمن قليل بعهد الله والأيمان ← لا نصيب في الآخرة ولا يكلمهم الله ولا ينظر إليهم ولا يزكيهم وعذاب أليم","cause":"شراء ثمن قليل بعهد الله والأيمان","result":"لا نصيب في الآخرة ولا يكلمهم الله ولا ينظر إليهم ولا يزكيهم وعذاب أليم","explicit":true,"otherNeedIds":[57],"ref":"سورة آل عمران: 77","srcLabel":"القرآن الكريم","quran":{"s":3,"from":77,"to":77,"text":"إِنَّ الَّذِينَ يَشْتَرُونَ بِعَهْدِ اللَّهِ وَأَيْمَانِهِمْ ثَمَنًا قَلِيلًا أُولَئِكَ لَا خَلَاقَ لَهُمْ فِي الْآخِرَةِ وَلَا يُكَلِّمُهُمُ اللَّهُ وَلَا يَنْظُرُ إِلَيْهِمْ يَوْمَ الْقِيَامَةِ وَلَا يُزَكِّيهِمْ وَلَهُمْ عَذَابٌ أَلِيمٌ (77)","hl":[[0,239,1]]}},{"id":"س-07593","fp":"ead32a79dea1","stateId":242,"easy":"إذا تحايلت على المحرّم فبعته وأكلت ثمنه ← لعنك الله كما لعن اليهود","cause":"اليَهودَ انطلَقوا إلى ما حُرِّمَ عليهِم من شَحمِ البقرِ والغنَمِ ، فأذابوهُ ، فباعوا بِهِ ما يأكُلونَ ، وإنَّ الخمرَ حرامٌ وثمنُها حرامٌ ، وإنَّ الخمرَ حرامٌ وثمنُها حرامٌ ، وإنَّ الخمرَ حرامٌ وثمنُها حرامٌ","result":"لعنَ اللَّهُ","explicit":true,"repOf":"س-00826","ref":"عمدة التفسير 1/725","text":["أنَّ الدَّاريَّ كانَ يُهْدي لرسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ كلَّ عامٍ راويةً من خمرٍ ، فلمَّا كانَ عامُ حُرِّمَت جاءَ براويةٍ ، فلمَّا نظر إليه ضحِكَ ، فقال أشعَرتَ أنَّها قد حُرِّمَت بعدَكَ ؟ فقالَ : يا رسولَ اللَّهِ ، ألَّا أبيعُها وأنتفعُ بثمنِها ؟ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ",["لعنَ اللَّهُ",2],[" اليَهودَ انطلَقوا إلى ما حُرِّمَ عليهِم من شَحمِ البقرِ والغنَمِ ، فأذابوهُ ، فباعوا بِهِ ما يأكُلونَ ، وإنَّ الخمرَ حرامٌ وثمنُها حرامٌ ، وإنَّ الخمرَ حرامٌ وثمنُها حرامٌ ، وإنَّ الخمرَ حرامٌ وثمنُها حرامٌ",1]],"grade":"صحيح","narrator":"عبدالرحمن بن غنم","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17995) بلفظه.","bab":"فضائل النبي وصفته ودلائل النبوة › ضحك النبي صلى الله عليه وسلم وتبسمه","dorar":"70ChaifX","merged":5,"otherRefs":["الأحاديث المختارة 1353 (صحيح)","تخريج سنن أبي داود 3488 (صحيح)","عمدة التفسير 1/725 (صحيح)","المستدرك على الصحيحين 7619 (صحيح)"]},{"id":"س-04773","fp":"8c0c582d2a28","stateId":242,"easy":"إذا جلبت على الخيل يوم السباق (غشاً) ← فلست منا","cause":"مَنْ جَلَبَ على الخَيْلِ يومَ الرِّهانِ","result":"فَليسَ مِنَّا","explicit":true,"ref":"السلسلة الصحيحة 2331","srcLabel":"الطبراني","text":[["مَنْ جَلَبَ على الخَيْلِ يومَ الرِّهانِ ؛ ",1],["فَليسَ مِنَّا",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو يعلى (2413)، والضياء في ((الأحاديث المختارة)) (273) مطولاً، والطبراني (11/223) (11558) واللفظ له","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"QMS9fy0c","merged":2,"otherRefs":["نيل الأوطار 8/244 (صحيح)"]},{"id":"س-00367","fp":"87955c9f147f","stateId":242,"easy":"إذا احتكرت ← فأنت ملعون","cause":"المحتَكِرُ","result":"مَلْعونٌ","explicit":true,"otherNeedIds":[3],"ref":"الجامع الصغير 9157","srcLabel":"ابن ماجه","text":[["المحتَكِرُ",1]," ",["مَلْعونٌ",2],"."],"grade":"صحيح","narrator":"عمر بن الخطاب.","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (2164) بلفظه، وابن ماجه (2153)، والدارمي (2586) باختلاف يسير.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"NLmOxLl7"},{"id":"س-02599","fp":"52c10e88a1f9","stateId":242,"easy":"إذا احتكرت طعاماً أربعين ليلة ← برئت من الله وبرئ الله منك","cause":"من احتكر طعامًا أربعين ليلةً","result":"فقد بَرِئ من اللهِ تعالَى وبرِئ اللهُ تعالَى منه","explicit":true,"ref":"تخريج المسند لشاكر 7/49","srcLabel":"أحمد","text":[["من احتكر طعامًا أربعين ليلةً ",1],["فقد بَرِئ من اللهِ تعالَى وبرِئ اللهُ تعالَى منه",2]," وأيُّما أهلُ عَرصةٍ أصبح فيهم امرؤٌ جائعٌ فقد برئت منهم ذمةُ اللهِ تعالى"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (4880) واللفظ له، وأبو يعلى (5746)، والحاكم (2165)","bab":"إيمان › أعمال تنافي الإيمان","dorar":"p6LCFLub"},{"id":"س-03596","fp":"a4dab582025d","stateId":242,"easy":"إذا انتهبت أو سلبت أو أشرت بالسلب ← فلست منا","cause":"انتَهَبَ، أوْ سَلَبَ، أوْ أَشارَ بالسَّلَبِ","result":"ليس مِنَّا مَنِ","explicit":true,"ref":"المستدرك على الصحيحين 2642","srcLabel":"الطبراني","text":[["ليس مِنَّا مَنِ",2],[" انتَهَبَ، أوْ سَلَبَ، أوْ أَشارَ بالسَّلَبِ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (12612)، وابن الأعرابي في ((معجمه)) (2364)، وأبو الفضل الزهري ((حديثه)) واللفظ لهم","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"jH307vcm"},{"id":"س-04883","fp":"bf76dc4b123f","stateId":242,"easy":"إذا احتكرت لتغلي الأسعار على المسلمين ← فأنت خاطئ وقد برئت منك ذمة الله ورسوله","cause":"مَنِ احتَكَرَ حُكْرةً ، ويريدُ أن يُغْليَ بِها علَى المسلِمينَ","result":"فهو خاطئٌ ، وقد برِئَت منهُ ذمَّةُ اللَّهِ ورسولِهِ","explicit":true,"ref":"الجامع الصغير 8312","srcLabel":"أحمد","text":[["مَنِ احتَكَرَ حُكْرةً ، ويريدُ أن يُغْليَ بِها علَى المسلِمينَ ، ",1],["فهو خاطئٌ ، وقد برِئَت منهُ ذمَّةُ اللَّهِ ورسولِهِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (8602)، والبيهقي (11260)، وابن عدي في ((الكامل)) (8/ 317) جميعهم باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"AGlDicMU"},{"id":"س-05046","fp":"3f665e168b46","stateId":242,"easy":"إذا خنت شريكك فيما ائتمنك ← فالنبي ﷺ منك بريء","cause":"من خان شَريكًا له فيما ائتَمَنه عليه واسترعاه له","result":"فأنا بريءٌ منه","explicit":true,"ref":"الترغيب والترهيب 3/43","srcLabel":"السنة","text":[["من خان شَريكًا له فيما ائتَمَنه عليه واسترعاه له، ",1],["فأنا بريءٌ منه",2]],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"لم نقف عليه مسنداً.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"XuQiTAA3"},{"id":"س-07984","fp":"bcadc6cff700","stateId":242,"easy":"إذا انتهبت شيئاً ← فلست منا فرُدّه","cause":"مَنِ انتَهَبَ من هذا الغَنَمِ شيئًا فلْيَرُدَّه؛ فإنِّي سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: مَنِ انتَهَبَ","result":"فليس مِنَّا","explicit":true,"repOf":"س-03861","ref":"تخريج مشكل الآثار 1311","text":["عن أبي لَبيدٍ، قال: شَهِدتُ كابُلَ مع عبدِ الرحمنِ بنِ سَمُرَةَ، فأصابَ الناسُ غَنَمًا فانتَهَبوها، فقال عبدُ الرحمنِ: ",["مَنِ انتَهَبَ من هذا الغَنَمِ شيئًا فلْيَرُدَّه؛ فإنِّي سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: مَنِ انتَهَبَ ",1],["فليس مِنَّا",2],"."],"grade":"صحيح","narrator":"عبدالرحمن بن سمرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (1311) واللفظ له، وأحمد (20631)، وأبو نعيم في ((معرفة الصحابة)) (4586) باختلاف يسير.","bab":"مظالم › التوبة ورد المظالم والحقوق","dorar":"vcry6fWx"},{"id":"س-08095","fp":"ab90d3bdba4c","stateId":242,"easy":"إذا غللت في سبيل الله ← يمتنع النبي ﷺ من الصلاة عليك","cause":"غَلَّ في سبيلِ اللَّهِ","result":"صلُّوا على صاحبِكُمْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[49],"ref":"تخريج شرح السنة 2729","srcLabel":"أبو داود","text":["تُوُفِّيَ رجُلٌ يَومَ خَيبرَ، فذكَروهُ لرسولِ اللَّهِ صلَّى اللهُ عليه وسلَّمَ، فزعَمَ زَيدٌ أنَّ رسولَ اللَّهِ صلَّى اللهُ عليه وسلَّمَ قالَ: ",["صلُّوا على صاحبِكُمْ",2],"؛ فتغيَّرَتْ وجوهُ النَّاسِ لذلِكَ، فزعَمَ زَيدٌ أنَّ رسولَ اللَّهِ صلَّى اللهُ عليه وسلَّمَ قالَ: إنَّ صاحِبَكُمْ قدْ ",["غَلَّ في سبيلِ اللَّهِ",1],"، قالَ: ففتَحْنا متاعَهُ، فوجَدْنا خَرَزاتٍ مِن خَرَزِ اليهودِ ما تُساوي درهمَيْنِ."],"grade":"صحيح","narrator":"زيد بن خالد الجهني","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2710)، والنسائي (1959)، وابن ماجه (2848) باختلاف يسير","bab":"مغازي › غزوة خيبر","dorar":"IUpkmLvY","merged":6,"otherRefs":["حلية الأولياء 8/288 (صحيح)","الأباطيل والمناكير 2/249 (صحيح)","المستدرك على الصحيحين 2618 (صحيح)","معجم الشيوخ 2/996 (حسن)","مجموع الشروح الفقهية. 69/8 (صحيح)"]},{"id":"س-00477","fp":"21d2eae05128","stateId":242,"easy":"إذا تحايلت على المحرّم (كبيع الشحم المحرم وأكل ثمنه) ← فالويل لك","cause":"حرَّم عليهِمُ الشحمَ فيكوِّرونَه ويَبيعونَه ، ثم يأكُلونَ ثمنَه","result":"الويلُ لبني إسرائيلَ","explicit":true,"ref":"إتحاف الخيرة المهرة 3/335","srcLabel":"الطبراني","text":["كنتُ قاعدًا مع ابنِ عُمرَ فجاء رجلٌ ، فقال : إني أشتَري هذه الحيطانَ فيها الأعنابُ ، فلا أستطيعُ أن أبيعَها كلَّها عنبًا حتى نَعصِرَها ، قال : فعن ثمنِ الخمرِ تسألُني ؟ سأحدِّثُكَ حديثًا سمِعتُه مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم : كنا جُلوسًا مع نبيِّ اللهِ صلَّى اللهُ عليه وسلَّم ، إذ رفَع رأسَه إلى السماءِ ، ثم أكبَّ ونكَث في الأرضِ ، وقال : ",["الويلُ لبني إسرائيلَ",2]," فقال عُمرُ : يا رسولَ اللهِ ، لقد أفزَعْنا قولَكَ في بني إسرائيلَ قال : ليس عليكم مِن ذلكَ بأسٌ إنه ",["حرَّم عليهِمُ الشحمَ فيكوِّرونَه ويَبيعونَه ، ثم يأكُلونَ ثمنَه",1]," ، وكذلك ثمنُ الخمرِ عليكم حرامٌ قال : وجاء رجلٌ إلى ابنِ عُمرَ ، فسأَله عنِ العزلِ ، فضرَب بيدِه إلى ما يَليه ، فوثَب الرجلُ فحصَبه ، وقال : أُفّ ، فقال عبدُ العزيزِ : فذكَرتُ ذلك لأنسٍ ، قال : ما كُنا نَرى به بأسًا"],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"إسناده رجاله ثقات","takhrij":"أخرجه مسدد كما في ((إتحاف الخيرة المهرة)) للبوصيري (3/335) واللفظ له، وأخرجه الطبراني (13/284) (14055) باختلاف يسير","bab":"آداب عامة › المباحات من الأفعال والأقوال","dorar":"xgEdmbm2"},{"id":"س-02594","fp":"9fdb9b62a775","stateId":242,"easy":"إذا غششت المسلمين ← فلست منهم","cause":"من غشَّ المسلِمينَ","result":"فليسَ منْهم","explicit":true,"repOf":"س-00362","ref":"الزواجر عن اقتراف الكبائر 1/237","text":["مرَّ رسولُ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّمَ برجلٍ يبيعُ طعامًا فقالَ: يا صاحبَ الطَّعام أسفَلُ هذا مثلُ أعلاهُ؟ قالَ: نعَم يا رسولَ اللَّهِ فقالَ صلَّى اللَّهُ عليْهِ وسلَّمَ: ",["من غشَّ المسلِمينَ ",1],["فليسَ منْهم",2]],"grade":"حسن","narrator":"[قيس بن أبي غرزة]","muhaddith":"رواته ثقات","takhrij":"أخرجه أبو يعلى (933)، والطبراني (18/359) (921) باختلاف يسير.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"AXT4zYia"},{"id":"س-02600","fp":"8de65978b48a","stateId":243,"easy":"إذا أصبح في حيّكم جائع ← برئت منكم ذمة الله","cause":"وأيُّما أهلُ عَرصةٍ أصبح فيهم امرؤٌ جائعٌ","result":"فقد برئت منهم ذمةُ اللهِ تعالى","explicit":true,"star":true,"ref":"تخريج المسند لشاكر 7/49","srcLabel":"أحمد","text":["من احتكر طعامًا أربعين ليلةً فقد بَرِئ من اللهِ تعالَى وبرِئ اللهُ تعالَى منه ",["وأيُّما أهلُ عَرصةٍ أصبح فيهم امرؤٌ جائعٌ",1]," ",["فقد برئت منهم ذمةُ اللهِ تعالى",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (4880) واللفظ له، وأبو يعلى (5746)، والحاكم (2165)","bab":"إيمان › أعمال تنافي الإيمان","dorar":"p6LCFLub"},{"id":"س-05255","fp":"c38c926969fa","stateId":243,"easy":"إذا وجدت سعة ولم تضحِّ ← فلا تحضر مصلانا","cause":"مَنْ وَجَدَ سَعةً لأنْ يُضحِّيَ فلمْ يُضحِّ","result":"فلا يَحضُرْ مُصلَّانا","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 3513","srcLabel":"ابن ماجه","text":["«",["مَنْ وَجَدَ سَعةً لأنْ يُضحِّيَ فلمْ يُضحِّ",1]," ",["فلا يَحضُرْ مُصلَّانا",2],"»."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي (19044) واللفظ له، وابن ماجه (3123)، وأحمد (8273) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"0MDSHQKY"},{"id":"س-08298","fp":"33bbb2e16007","stateId":243,"easy":"إذا سُئلت بوجه الله فمنعت السائل ← فأنت ملعون","cause":"سُئِل بوَجهِ اللهِ ثُمَّ مَنَعَ سائِلَه ما لم يُسأَلْ هُجرًا","result":"مَلعونٌ مَن","explicit":true,"ref":"تنبيه الغافلين 337","srcLabel":"الطبراني","text":["«",["مَلعونٌ مَن",2],[" سُئِل بوَجهِ اللهِ ثُمَّ مَنَعَ سائِلَه ما لم يُسأَلْ هُجرًا»",1]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"رجاله رجال الصحيح إلا يحيي بن عثمان بن صالح والأكثر على توثيقه","takhrij":"أخرجه الطبراني في ((الدعاء)) (2112)، وإسماعيل التيمي في ((الحجة في بيان المحجة)) (2/ 474) واللفظ لهما، والروياني في ((المسند)) (495) مطولا.","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"0WsYoSW6"},{"id":"س-06845","fp":"2d2bb7d59488","stateId":243,"easy":"إذا منعت فضل الماء ابن السبيل أو بايعت إمامك للدنيا ← لا يكلمك الله ولا ينظر إليك","cause":"ولا يَنظُرُ إليهم ولا يُزَكِّيهم ولَهم عَذابٌ أليمٌ: رَجُلٌ على فَضلِ ماءٍ بطَريقٍ، يَمنَعُ منه ابنَ السَّبيلِ، ورَجُلٌ بايَعَ رَجُلًا لا يُبايِعُه إلَّا للدُّنيا، فإن أعطاه ما يُريدُ وفَى له، وإلَّا لم يَفِ له، ورَجُلٌ ساومَ رَجُلًا بسِلعةٍ بَعدَ العَصرِ، فحَلَفَ باللهِ لقد أعطى بها كَذا وكَذا، فأخَذَها","result":"ثَلاثةٌ لا يُكَلِّمُهمُ اللهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح البخاري 2672","srcLabel":"متفق عليه","text":[["ثَلاثةٌ لا يُكَلِّمُهمُ اللهُ",2],"،",[" ولا يَنظُرُ إليهم ولا يُزَكِّيهم ولَهم عَذابٌ أليمٌ: رَجُلٌ على فَضلِ ماءٍ بطَريقٍ، يَمنَعُ منه ابنَ السَّبيلِ، ورَجُلٌ بايَعَ رَجُلًا لا يُبايِعُه إلَّا للدُّنيا، فإن أعطاه ما يُريدُ وفَى له، وإلَّا لم يَفِ له، ورَجُلٌ ساومَ رَجُلًا بسِلعةٍ بَعدَ العَصرِ، فحَلَفَ باللهِ لقد أعطى بها كَذا وكَذا، فأخَذَها.",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2672)، ومسلم (108)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"yTR4G4Fw","merged":2,"otherRefs":["صحيح النسائي 4474 (صحيح)"]},{"id":"س-06886","fp":"73fa6779b51b","stateId":243,"easy":"إذا منعت فضل الماء أو حلفت كاذباً على سلعتك ← لا يكلمك الله يوم القيامة","cause":"ولا يَنظُرُ إليهم، ولا يُزَكِّيهم ولَهم عَذابٌ أليمٌ: رَجُلٌ على فضلِ ماءٍ بالفَلاةِ يَمنَعُه مِنَ ابنِ السَّبيلِ، ورَجُلٌ بايَعَ رَجُلًا بسِلعةٍ بَعدَ العَصرِ فحَلَفَ له باللهِ لأخَذَها بكَذا وكَذا فصَدَّقَه وهو على غيرِ ذلك، ورَجُلٌ بايَعَ إمامًا لا يُبايِعُه إلَّا لدُنيا، فإن أعطاه مِنها وفى، وإن لَم يُعطِه مِنها لَم يَفِ","result":"ثَلاثٌ لا يُكَلِّمُهمُ اللهُ يَومَ القيامةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح مسلم 108","srcLabel":"متفق عليه","text":[["ثَلاثٌ لا يُكَلِّمُهمُ اللهُ يَومَ القيامةِ",2],"،",[" ولا يَنظُرُ إليهم، ولا يُزَكِّيهم ولَهم عَذابٌ أليمٌ: رَجُلٌ على فضلِ ماءٍ بالفَلاةِ يَمنَعُه مِنَ ابنِ السَّبيلِ، ورَجُلٌ بايَعَ رَجُلًا بسِلعةٍ بَعدَ العَصرِ فحَلَفَ له باللهِ لأخَذَها بكَذا وكَذا فصَدَّقَه وهو على غيرِ ذلك، ورَجُلٌ بايَعَ إمامًا لا يُبايِعُه إلَّا لدُنيا، فإن أعطاه مِنها وفى، وإن لَم يُعطِه مِنها لَم يَفِ.",1]," وفي روايةٍ: ورَجُلٌ ساومَ رَجُلًا بسِلعةٍ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7212)، ومسلم (108).","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"NWuFoJ0P"},{"id":"س-02148","fp":"4e7074eb8d63","stateId":243,"easy":"إذا كان لك مال فلم تضحِّ ← فلا تقرب مصلى المسلمين","cause":"مَن كانَ له مالٌ فلمْ يُضَحِّ","result":"فلا يَقْرَبَنَّ مُصلَّانا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"المستدرك على الصحيحين 7773","srcLabel":"أحمد","text":[["مَن كانَ له مالٌ فلمْ يُضَحِّ",1],"، ",["فلا يَقْرَبَنَّ مُصلَّانا",2],". وقالَ مَرَّةً: مَن وَجَدَ سَعةً فلمْ يَذْبَحْ، فلا يَقْرَبَنَّ مُصلَّانا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (8273)، وابن عدي في ((الكامل)) (6/ 242)، والبيهقي في ((الشعب)) (6952) واللفظ لهم.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"LNMVKPnn","merged":2,"otherRefs":["الجامع الصغير 8954 (صحيح)"]},{"id":"س-05115","fp":"610d5f6b4f14","stateId":244,"easy":"إذا ادعيت ما ليس لك ← فلست منا وتبوأ مقعدك من النار","cause":"ومَنِ ادَّعى ما ليس له","result":"فليس منَّا، ولْيَتبَوَّأْ مَقعَدَه منَ النارِ","explicit":true,"star":true,"otherNeedIds":[57],"ref":"تخريج المسند لشعيب 21465","srcLabel":"متفق عليه","text":["ليس من رَجُلٍ ادَّعى لغَيرِ أبيهِ، وهو يَعلَمُه إلَّا كفَرَ، ",["ومَنِ ادَّعى ما ليس له، ",1],["فليس منَّا، ولْيَتبَوَّأْ مَقعَدَه منَ النارِ، ",2],"ومَن دَعا رَجُلًا بالكُفرِ، أو قال: عَدوُّ اللهِ، وليس كذاك، إلَّا حارَ عليه."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (3508)، ومسلم (61) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"K4lGZxC2","merged":2,"otherRefs":["صحيح الأدب المفرد 336 (صحيح)"]},{"id":"س-06938","fp":"0ba92eb16407","stateId":244,"easy":"إذا حلفت يمين صبر لتقتطع مال مسلم ← تلقى الله وهو عليك غضبان","cause":"مَن حَلَفَ يَمينَ صَبرٍ ليَقتَطِعَ بها مالَ امرِئٍ مُسلِمٍ","result":"لَقيَ اللهَ وهو عليه غَضبانُ، فأنزَلَ اللهُ تَصديقَ ذلك","explicit":true,"star":true,"similar":["س-07525"],"ref":"صحيح البخاري 4549","srcLabel":"متفق عليه","text":[["مَن حَلَفَ يَمينَ صَبرٍ ليَقتَطِعَ بها مالَ امرِئٍ مُسلِمٍ، ",1],["لَقيَ اللهَ وهو عليه غَضبانُ، فأنزَلَ اللهُ تَصديقَ ذلك: ",2],"{إِنَّ الَّذِينَ يَشْتَرُونَ بِعَهْدِ اللَّهِ وَأَيْمَانِهِمْ ثَمَنًا قَلِيلًا أُولَئِكَ لَا خَلَاقَ لَهُمْ في الآخِرةِ} إلى آخِرِ الآيةِ، قال: فدَخَلَ الأشعَثُ بنُ قَيسٍ، وقال: ما يُحَدِّثُكُم أبو عبدِ الرَّحمَنِ؟ قُلنا: كَذا وكَذا، قال: فيَّ أُنزِلَت كانَت لي بئرٌ في أرضِ ابنِ عَمٍّ لي، قال النَّبيُّ صلَّى اللهُ عليه وسلَّم: بَيِّنَتُك أو يَمينُه، فقُلتُ: إذًا يَحلِفَ يا رَسولَ اللهِ، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: مَن حَلَفَ على يَمينِ صَبرٍ يَقتَطِعُ بها مالَ امرِئٍ مُسلِمٍ، وهو فيها فاجِرٌ، لَقيَ اللهَ وهو عليه غَضبانٌ."],"grade":"صحيح","narrator":"عبدالله بن مسعود والأشعث بن قيس","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4549)، ومسلم (138)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"TlsbdoVg","merged":2,"otherRefs":["صحيح مسلم 138 (صحيح)"]},{"id":"س-04294","fp":"6f746e5f6065","stateId":244,"easy":"إذا حلفت كاذباً على سلعتك ← لا يكلمك الله يوم القيامة ولا ينظر إليك","cause":"وَلَا يَنْظُرُ إِلَيْهِمْ: رَجُلٌ حَلَفَ علَى سِلْعَةٍ لقَدْ أَعْطَى بهَا أَكْثَرَ ممَّا أَعْطَى، وَهو كَاذِبٌ، وَرَجُلٌ حَلَفَ علَى يَمِينٍ كَاذِبَةٍ بَعْدَ العَصْرِ؛ لِيَقْتَطِعَ بهَا مَالَ رَجُلٍ مُسْلِمٍ، وَرَجُلٌ مَنَعَ فَضْلَ مَاءٍ، فيَقولُ اللَّهُ: اليومَ أَمْنَعُكَ فَضْلِي كما مَنَعْتَ فَضْلَ ما لَمْ تَعْمَلْ يَدَاكَ. حديثُ تغليظِ إثْمِ الحالِفِ كاذبًا عند مِنْبَر رسولِ اللهِ صلَّى الله","result":"ثَلَاثَةٌ لا يُكَلِّمُهُمُ اللَّهُ يَومَ القِيَامَةِ","explicit":true,"star":true,"ref":"الكبائر للذهبي 231","srcLabel":"البخاري","text":["حديثُ تغليظِ إثْمِ الحالِفِ كاذبًا بعد العَصْرِ [يعني حديث: ",["ثَلَاثَةٌ لا يُكَلِّمُهُمُ اللَّهُ يَومَ القِيَامَةِ",2],"،",[" وَلَا يَنْظُرُ إِلَيْهِمْ: رَجُلٌ حَلَفَ علَى سِلْعَةٍ لقَدْ أَعْطَى بهَا أَكْثَرَ ممَّا أَعْطَى، وَهو كَاذِبٌ، وَرَجُلٌ حَلَفَ علَى يَمِينٍ كَاذِبَةٍ بَعْدَ العَصْرِ؛ لِيَقْتَطِعَ بهَا مَالَ رَجُلٍ مُسْلِمٍ، وَرَجُلٌ مَنَعَ فَضْلَ مَاءٍ، فيَقولُ اللَّهُ: اليومَ أَمْنَعُكَ فَضْلِي كما مَنَعْتَ فَضْلَ ما لَمْ تَعْمَلْ يَدَاكَ.]                                   حديثُ تغليظِ إثْمِ الحالِفِ كاذبًا عند مِنْبَر رسولِ اللهِ صلَّى الله",1]," عليه وسلَّم. [يعني حديث: لا يحلِفُ عندَ هذا المنبرِ عبدٌ ولا أمةٌ على يمينٍ آثمةٍ ولو على سواكٍ رطبٍ إلَّا وجبت لَهُ النَّارُ]"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7446)، وأبو داود (3474)، وأحمد (10226) واللفظ لهم تامًا.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"GBTEmKxm"},{"id":"س-06912","fp":"57851c71c5fc","stateId":244,"easy":"إذا حلفت كاذباً بعد العصر لتقتطع مال مسلم ← لا يكلمك الله ولا ينظر إليك يوم القيامة","cause":"رجلٌ حلف على مالِ امرئٍ مسلمٍ بعدَ صلاةِ العصرِ ليقتطعهُ –وفي رواية : - رجل حلفَ على يمينٍ بعدَ صلاةِ العصرِ أنه أُعطِيَ بسلعتهِ أكثرَ مما أُعطى وهو كاذبٌ","result":"ثلاثةٌ لا يكلمهُم اللهُ يومَ القيامةِ ولا يزكّيهِم ولا ينظرُ إليهِم","explicit":true,"star":true,"ref":"السنن الصغير للبيهقي 4/165","srcLabel":"متفق عليه","text":[["ثلاثةٌ لا يكلمهُم اللهُ يومَ القيامةِ ولا يزكّيهِم ولا ينظرُ إليهِم ",2],":",[" رجلٌ حلف على مالِ امرئٍ مسلمٍ بعدَ صلاةِ العصرِ ليقتطعهُ –وفي رواية : - رجل حلفَ على يمينٍ بعدَ صلاةِ العصرِ أنه أُعطِيَ بسلعتهِ أكثرَ مما أُعطى وهو كاذبٌ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"ثابت","takhrij":"أخرجه البخاري (7212)، ومسلم (108) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"jysG7049"},{"id":"س-07767","fp":"237126514188","stateId":244,"easy":"إذا حلفت يميناً كاذبة لتقتطع مال أخيك ← تلقى الله وهو عليك غضبان","cause":"من حلَفَ على يَمينٍ كاذبةٍ؛ لِيقتَطِعَ بها مالَ أخيهِ","result":"لقِيَ اللهَ، وهو عليه غَضبانُ","explicit":true,"star":true,"similar":["س-04998"],"ref":"تخريج المسند لشعيب 17721","srcLabel":"النسائي","text":["فذكَرَ الحَديثَ [أيْ ذكَرَ حَديثَ: خاصَمَ رَجلٌ من كِندةَ يُقالُ له: امرُؤُ القَيسِ بنُ عابسٍ رَجلًا من حَضْرَمَوتَ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في أرضٍ، فقَضى على الحَضْرَميِّ بالبَيِّنةِ، فلم تكنْ له بَيِّنةٌ، فقَضى على امرِئِ القَيسِ باليَمينِ، فقال الحَضْرَميُّ: إنْ أمكَنْتَه منَ اليَمينِ يا رسولَ اللهِ، ذهَبَتْ واللهِ -أو ورَبِّ الكَعبةِ- أَرْضي، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["من حلَفَ على يَمينٍ كاذبةٍ؛ لِيقتَطِعَ بها مالَ أخيهِ ",1],["لقِيَ اللهَ، وهو عليه غَضبانُ",2],"، قال رَجاءٌ: وتَلا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: {إِنَّ الَّذِينَ يَشْتَرُونَ بِعَهْدِ اللَّهِ وَأَيْمَانِهِمْ ثَمَنًا قَلِيلًا} [آل عمران: 77]، فقال امرُؤُ القَيسِ: ماذا لمَن ترَكَها يا رسولَ اللهِ؟ قال: الجَنَّةُ، قال: فاشهَدْ أنِّي قد ترَكْتُها له كلَّها]، قال جَريرٌ: وأخبَرَني أيُّوبُ -وكُنَّا جميعًا حينَ سمِعْنا الحَديثَ من عَديٍّ- قال: قال عَديٌّ في حَديثِ العُرسِ بنِ عُمَيرةَ: فنزَلَتْ هذه الآيةُ: {إِنَّ الَّذِينَ يَشْتَرُونَ بِعَهْدِ اللَّهِ وَأَيْمَانِهِمْ ثَمَنًا قَلِيلًا} [آل عمران: 77] إلى آخِرِها، ولم أحفَظْه أنا يومَئذٍ من عَديٍّ."],"grade":"صحيح","narrator":"عدي بن عميرة الكندي","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (5995)، وأحمد (17721) واللفظ له","bab":"قرآن › أسباب النزول","dorar":"VFPELZCc","merged":15,"otherRefs":["المستدرك على الصحيحين 8011 (صحيح)","تخريج المسند لشاكر 6/183 (صحيح)","صحيح ابن حبان 5084 (صحيح)","تخريج المسند لشعيب 20295 (صحيح)","صحيح البخاري 6659 (صحيح)","صحيح مسلم 138 (صحيح)","صحيح البخاري 2676 (صحيح)","صحيح البخاري 2356 (صحيح)","صحيح البخاري 4549 (صحيح)","تخريج سنن الدارقطني 4342 (صحيح)","صحيح البخاري 2666 (صحيح)","تخريج مشكل الآثار 4477 (صحيح)","صحيح البخاري 2515 (صحيح)","صحيح البخاري 7183 (صحيح)"]},{"id":"ق-0853","fp":"19648798284b","stateId":244,"easy":"رمي المحصنات الغافلات المؤمنات ← اللعن في الدنيا والآخرة وعذاب عظيم وشهادة الجوارح","cause":"رمي المحصنات الغافلات المؤمنات","result":"اللعن في الدنيا والآخرة وعذاب عظيم وشهادة الجوارح","explicit":true,"otherNeedIds":[57],"ref":"سورة النور: 23–24","srcLabel":"القرآن الكريم","quran":{"s":24,"from":23,"to":24,"text":"إِنَّ الَّذِينَ يَرْمُونَ الْمُحْصَنَاتِ الْغَافِلَاتِ الْمُؤْمِنَاتِ لُعِنُوا فِي الدُّنْيَا وَالْآخِرَةِ وَلَهُمْ عَذَابٌ عَظِيمٌ (23) يَوْمَ تَشْهَدُ عَلَيْهِمْ أَلْسِنَتُهُمْ وَأَيْدِيهِمْ وَأَرْجُلُهُمْ بِمَا كَانُوا يَعْمَلُونَ (24)","hl":[[0,233,1]]}},{"id":"ق-1326","fp":"8e6126bc27c1","stateId":244,"easy":"القول بلا فعل ← مقت كبير عند الله","cause":"القول بلا فعل","result":"مقت كبير عند الله","explicit":true,"ref":"سورة الصف: 2–3","srcLabel":"القرآن الكريم","quran":{"s":61,"from":2,"to":3,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لِمَ تَقُولُونَ مَا لَا تَفْعَلُونَ (2) كَبُرَ مَقْتًا عِنْدَ اللَّهِ أَنْ تَقُولُوا مَا لَا تَفْعَلُونَ (3)","hl":[[31,66,1]]}},{"id":"س-06123","fp":"bd0b89d95d01","stateId":244,"easy":"إذا تكلمت بكلمة من سخط الله ← يكتب الله عليك بها سخطه إلى يوم تلقاه","cause":"ليتَكَلَّمُ بالكلِمةِ من سَخَطِ اللَّهِ ما يَظنُّ أن تبلُغَ ما بلغت","result":"يَكْتبُ اللَّهُ عزَّ وجلَّ عليهِ بِها سَخطَهُ إلى يومِ يلقاهُ","explicit":true,"similar":["س-00205","س-06119"],"otherNeedIds":[57],"ref":"صحيح ابن ماجه 3220","srcLabel":"الترمذي","text":["مرَّ بهِ رجلٌ لَه شرَفٌ فقالَ لَه علقَمةُ إنَّ لَكَ رحِمًا وإنَّ لَكَ حقًّا وإنِّي رأيتُكَ تدخُلُ علَى هؤلاءِ الأمراءِ وتتَكَلَّمُ عندَهُم بما شاءَ اللَّهُ أن تتَكَلَّمَ بهِ وإنِّي سمِعتُ بلالَ بنَ الحارثِ المزَنيَّ صاحبَ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ إنَّ أحدَكُم ليتَكَلَّمُ بالكلِمةِ من رضوانِ اللَّهِ ما يظنُّ أن تبلُغَ ما بلغت فيَكْتبُ اللَّهُ عزَّ وجلَّ لَه بِها رِضوانَهُ إلى يومِ القيامةِ وإنَّ أحدَكُم ",["ليتَكَلَّمُ بالكلِمةِ من سَخَطِ اللَّهِ ما يَظنُّ أن تبلُغَ ما بلغت",1]," ف",["يَكْتبُ اللَّهُ عزَّ وجلَّ عليهِ بِها سَخطَهُ إلى يومِ يلقاهُ",2]," قالَ عَلقَمَةُ فانظُرْ ويحَكَ ماذا تَقولُ وماذا تَكَلَّمُ بهِ فرُبَّ كلامٍ قد منعَني أن أتَكَلَّمَ بهِ ما سمِعتُ من بلالِ بنِ الحارثِ"],"grade":"صحيح","narrator":"بلال بن الحارث المزني.","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2319)، وابن ماجة (3969)، والحاكم (136) واللفظ لهم.","bab":"رقائق وزهد › من أرضى الناس بسخط الله","dorar":"LoykDRa9","merged":4,"otherRefs":["صحيح البخاري 6477 (صحيح)","صحيح مسلم 2988 (صحيح)","تخريج المسند لشعيب 15852 (صحيح)"]},{"id":"س-06149","fp":"29d0996924b2","stateId":244,"easy":"إذا اقتطعت مال أخيك بيمين ← تلقى الله وهو عليك غضبان","cause":"ومن اقتطعَ مالَ أخيهِ المسلمِ بيَمينٍ","result":"لقيَ اللَّهَ وَهوَ علَيهِ غضبانُ","explicit":true,"ref":"صحيح الترمذي 3012","srcLabel":"الترمذي","text":["ما مِن رجُلٍ لَا يؤدِّي زَكاةَ مالِهِ إلَّا جعلَ اللَّهُ يومَ القيامةِ في عُنقِهِ شجاعًا ، ثمَّ قرأَ علَينا مصداقَهُ من كتابِ اللَّهِ : (وَلَا يَحْسَبَنَّ الَّذِينَ يَبْخَلُونَ بِمَا آتَاهُمُ اللَّهُ مِنْ فَضْلِهِ) الآيةَ ، وقالَ مرَّةً : قرأَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ مِصداقَهُ : ( سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ) ",["ومن اقتطعَ مالَ أخيهِ المسلمِ بيَمينٍ ",1],["لقيَ اللَّهَ وَهوَ علَيهِ غضبانُ",2]," ، ثمَّ قَرأَ رسولُ اللَّهِ مِصداقَهُ من كتابِ اللَّهِ : (إِنَّ الَّذِينَ يَشْتَرُونَ بعَهْدِ اللَّهِ)"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3012) واللفظ له، والنسائي (2441)، وأحمد (3577) بنحوه، وابن ماجه (1784) مختصراً","bab":"زكاة › عقوبة مانع الزكاة","dorar":"cew4VdCg","merged":4,"otherRefs":["تخريج المسند لشعيب 3946 (صحيح)","تخريج مشكل الآثار 449 (حسن)","صحيح البخاري 7445 (صحيح)"]},{"id":"س-00414","fp":"df829ed8ffcd","stateId":244,"easy":"إذا حلفت بالأمانة ← فلست منا","cause":"حَلَفَ بِالْأَمَانَةِ","result":"لَيْسَ مِنَّا مَنْ","explicit":true,"ref":"مجمع الزوائد 4/335","srcLabel":"أبو داود","text":[["لَيْسَ مِنَّا مَنْ",2],[" حَلَفَ بِالْأَمَانَةِ",1]," وَمَنْ خَبَّبَ عَلَى امرئٍ زوجتَهُ أو مملوكَهُ فليس مِنَّا"],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"رجاله رجال الصحيح خلا الوليد بن ثعلبة وهو ثقة","takhrij":"أخرجه أبو داود (3253) مختصراً، وأحمد (22980) واللفظ له.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"0kVQXmlj","merged":3,"otherRefs":["تخريج مشكل الآثار 1342 (صحيح)","تخريج سنن أبي داود 3253 (صحيح)"]},{"id":"س-00390","fp":"6e135ee3893b","stateId":244,"easy":"إذا لعنت ما ليس أهلاً للعن ← رجعت اللعنة عليك","cause":"مَن لَعَنَ شيئًا ليس له بأهْلٍ","result":"رَجَعَتِ اللَّعنةُ عليه","explicit":true,"ref":"تخريج سنن أبي داود 4908","srcLabel":"الترمذي","text":["أنَّ رَجُلًا لعَنَ الرِّيحَ [وفي لفظ]: إنَّ رَجُلًا نازَعَتْه الرِّيحُ رِداءَه على عَهدِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فلَعَنَها- فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: (لا تَلْعَنْها؛ فإنَّها مَأمورةٌ، وإنَّه ",["مَن لَعَنَ شيئًا ليس له بأهْلٍ ",1],["رَجَعَتِ اللَّعنةُ عليه",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1978)، والطبراني (12/160) (12757)، والبيهقي في ((شعب الإيمان)) (5235) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"x44Ij5ug","merged":2,"otherRefs":["صحيح ابن حبان 5745 (صحيح)"]},{"id":"س-05084","fp":"9539199e09e9","stateId":244,"easy":"إذا خاصمت في باطل وأنت تعلم ← تبقى في سخط الله حتى تنزع","cause":"ومَن خاصَمَ في باطِلٍ وهو يَعْلَمُه","result":"لم يَزَلْ في سَخَطِ اللهِ حتى يَنزِعَ","explicit":true,"ref":"تخريج المسند لشعيب 5385","srcLabel":"أبو داود","text":["خرَجْنا حُجَّاجًا عَشَرةً مِن أهلِ الشَّامِ، حتى أَتَيْنا مكَّةَ، فذَكَر الحديثَ، قال: فأَتَيْناهُ، فخَرَج إلينا -يعني: ابنَ عُمرَ، فقال: سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقول: مَن حالَتْ شَفاعَتُه دُونَ حدٍّ مِن حُدودِ اللهِ عزَّ وجلَّ، فقد ضادَّ اللهَ أَمْرَه، ومَن مات وعليه دَيْنٌ، فليس بالدِّينارِ ولا بالدِّرهمِ، ولكنَّها الحسَناتُ والسَّيِّئاتُ، ",["ومَن خاصَمَ في باطِلٍ وهو يَعْلَمُه، ",1],["لم يَزَلْ في سَخَطِ اللهِ حتى يَنزِعَ، ",2],"ومَن قال في مؤْمِنٍ ما ليس فيه، أَسْكَنَه اللهُ رَدْغةَ الخَبَالِ حتى يَخرُجَ ممَّا قالَ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3597)، وأحمد (5385) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"jwOzDMmj","merged":2,"otherRefs":["السلسلة الصحيحة 437 (صحيح)"]},{"id":"س-07287","fp":"69a212e62416","stateId":244,"easy":"إذا ذهبت إلى ذي سلطان تتملقه بالحلف ← ترجع بلا حاجتك وقد أسخطت الله","cause":"فيُقسِمُ له باللهِ إنَّكَ لَذَيْتَ وذَيْتَ","result":"فيَرجِعُ ما خَلَّى مِن حاجتِه بشَيءٍ، وقدْ أسخَطَ اللهَ عليه","explicit":true,"ref":"المستدرك على الصحيحين 8567","srcLabel":"السنة","text":["عن عبدِ اللهِ بنِ مَسعودٍ رَضيَ اللهُ عنه، أنَّه ذكَرَ الفتنةَ، فقال: إنَّ الرَّجلَ لَيَخرُجُ مِن بَيتِه ومعه دِينُه، فيَرجِعُ وما معه شَيءٌ منه، يَأتي الرَّجلُ لا يَملِكُ له ولا لِنفْسِه ضَرًّا ولا نفْعًا، ",["فيُقسِمُ له باللهِ إنَّكَ لَذَيْتَ وذَيْتَ",1],"، ",["فيَرجِعُ ما خَلَّى مِن حاجتِه بشَيءٍ، وقدْ أسخَطَ اللهَ عليه",2],"."],"grade":"صحيح","narrator":"طارق بن شهاب","muhaddith":"صحيح على شرط الشيخين، ولم يخرجاه","bab":"فتن › ظهور الفتن","dorar":"juVF8mjW","merged":2,"otherRefs":["عمدة التفسير 1/523 (حسن)"]},{"id":"س-00205","fp":"178ce8e1eac2","stateId":244,"easy":"إذا تكلمت بكلمة من سخط الله ولو لم تلقِ لها بالاً ← يسخط الله عليك بها إلى يوم تلقاه","cause":"وإنَّ العَبْدَ ليَتَكَلَّمُ بِالكَلِمةِ مِنْ سَخَطِ اللهِ، ما يَظُنُّ أنْ تَبْلُغَ ما بَلَغَتْ","result":"فيَسْخَطُ اللهُ بها إلى يَوْمِ يَلْقاهُ","explicit":true,"repOf":"س-06123","ref":"المستدرك على الصحيحين 137","text":["عنْ عَلْقَمةَ بنِ وَقَّاصٍ قالَ: كان رَجُلٌ بَطَّالٌ يدْخُلُ على الأُمَراءِ فَيُضْحِكُهُمْ، فقالَ لهُ جدِّي: وَيْحَكَ يا فُلانُ، لِمَ تدْخُلُ على هؤلاء وتُضْحِكُهُمْ؟ فإني سَمِعْتُ بلالَ بنَ الحارثِ المُزَنِيَّ صاحِبَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يُحدِّثُ أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قالَ: «إنَّ العَبْدَ ليَتَكَلَّمُ بالكَلِمَةِ مِنْ رِضْوانِ اللهِ، ما يَظُنُّ أَنْ تَبْلُغَ ما بَلَغَتْ، فيَرْضَى اللهُ بها عنه إلى يوْمِ يَلْقاهُ، ",["وإنَّ العَبْدَ ليَتَكَلَّمُ بِالكَلِمةِ مِنْ سَخَطِ اللهِ، ما يَظُنُّ أنْ تَبْلُغَ ما بَلَغَتْ",1],"، ",["فيَسْخَطُ اللهُ بها إلى يَوْمِ يَلْقاهُ",2],"»."],"grade":"صحيح","narrator":"بلال بن الحارث المزني","muhaddith":"صحيح","bab":"آداب الكلام › المزاح والمداعبة","dorar":"UlpYjYwQ"},{"id":"س-03022","fp":"9a0b19e9bc39","stateId":244,"easy":"إذا اقتطعت حقاً بيمينك ظلماً ← لا ينظر الله إليك يوم القيامة ولا يزكيك","cause":"إنْ هو اقتطَعَها بيَمينِه ظُلمًا","result":"كان ممَّن لا يَنظُرُ اللهُ عزَّ وجلَّ إليه يومَ القيامةِ، ولا يُزكِّيه، وله عَذابٌ أليمٌ","explicit":true,"otherNeedIds":[57],"ref":"تخريج المسند لشعيب 19514","srcLabel":"أحمد","text":["اختصَمَ رَجُلانِ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ في أرضٍ، أحَدُهما مِن أهلِ حَضرَمَوتَ، قال: فجَعَلَ يَمينَ أحَدِهما [لِلآخَرِ]، قال: فضَجَّ الآخَرُ، وقال: إنَّه إذَنْ يَذهَبُ بأرضي، فقال: ",["إنْ هو اقتطَعَها بيَمينِه ظُلمًا، ",1],["كان ممَّن لا يَنظُرُ اللهُ عزَّ وجلَّ إليه يومَ القيامةِ، ولا يُزكِّيه، وله عَذابٌ أليمٌ",2],"، قال: ووَرِعَ الآخَرُ فرَدَّها."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (19514) واللفظ له، وعبد بن حميد (538)، وأبو يعلى (7274)","bab":"إيمان › الوعيد","dorar":"IqI2js8S"},{"id":"س-04580","fp":"c2bd3f81cc3e","stateId":244,"easy":"إذا خاصمت مسلماً غضباً بلا علم ← فقد عاندت الله وعليك لعنته","cause":"وأَيُّما رجلٍ شَدَّ غضبًا على مسلمٍ في خصومةٍ لا عِلْمَ له بها","result":"فقد عاند اللهَ حَقَّهُ ، وحَرَصَ ، على سَخَطِهِ ، وعليه لعنةُ اللهِ المتتابِعَةُ إلى يومِ القيامةِ","explicit":true,"ref":"الجامع الصغير 2951","srcLabel":"الطبراني","text":["أَيُّما رجلٍ حالت شفاعتُه دونَ حَدٍّ من حدودِ اللهِ تعالى ، لم يَزَلْ في سَخَطِ اللهِ تعالى حتى يَنْزِعَ ، ",["وأَيُّما رجلٍ شَدَّ غضبًا على مسلمٍ في خصومةٍ لا عِلْمَ له بها ، ",1],["فقد عاند اللهَ حَقَّهُ ، وحَرَصَ ، على سَخَطِهِ ، وعليه لعنةُ اللهِ المتتابِعَةُ إلى يومِ القيامةِ ، ",2],"وأَيُّما رجلٍ أشاع على رجلٍ مسلمٍ بكَلِمَةٍ وهو منها بريءٌ يُشِينُه بها في الدنيا ؛ كان حَقًّا على اللهِ أن يُدْنِيَه يومَ القيامةِ في النارِ ، حتى يَأْتِيَ بإنفاذِ ما قال"],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه الطبراني كما في ((الجامع الصغير)) للسيوطي (1/260)","bab":"حدود › الحث على إقامة الحدود","dorar":"sPYe1Im7"},{"id":"س-04998","fp":"c6476f751042","stateId":244,"easy":"إذا حلفت يميناً كاذبة لتقتطع حق مسلم ← تلقى الله وهو عليك غضبان","cause":"ما من رجلٍ يحلِفُ على يمينٍ كاذبةٍ ليقطَعَ بها حقَّ امرئٍ مُسلمٍ","result":"إلَّا لقِيَ اللهَ عزَّ وجلَّ وهو عليه غضبانُ","explicit":true,"repOf":"س-07767","ref":"المصابيح في الأحاديث المتواترة 615","text":[["ما من رجلٍ يحلِفُ على يمينٍ كاذبةٍ ليقطَعَ بها حقَّ امرئٍ مُسلمٍ",1]," ",["إلَّا لقِيَ اللهَ عزَّ وجلَّ وهو عليه غضبانُ",2]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"k8j9NPTM"},{"id":"س-05154","fp":"8f39d2d47487","stateId":244,"easy":"إذا حلفت بالأمانة أو أفسدت زوجة امرئ أو مملوكه ← فلست منا","cause":"حَلَف بالأمانةِ، وليْس مِنَّا مَن خَبَّب زَوجةَ امرِئٍ ولا مَملوكَه","result":"ليْس مِنَّا من","explicit":true,"ref":"المستدرك على الصحيحين 8026","srcLabel":"السنة","text":[["ليْس مِنَّا من",2],[" حَلَف بالأمانةِ، وليْس مِنَّا مَن خَبَّب زَوجةَ امرِئٍ ولا مَملوكَه",1],"."],"grade":"صحيح","narrator":"بريدة","muhaddith":"صحيح الإسناد","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"mYlTpxi4"},{"id":"س-06119","fp":"b7c8ee962986","stateId":244,"easy":"إذا تكلمت بكلمة من الشر ← يكتب الله عليك بها سخطه إلى يوم تلقاه","cause":"وإنَّ الرَّجُلَ لَيَتكلَّمُ بالكَلِمةِ مِن الشَّرِّ ما يَعلَمُ مَبلَغَها","result":"يَكتُبُ اللهُ عليه بِها سَخَطَه إلى يَوْمِ يَلْقاه","explicit":true,"repOf":"س-06123","ref":"الصحيح المسند 183","text":["أنَّ بِلالَ بنَ الحارِثِ المُزَنيَّ قالَ له: إنِّي رَأيْتُك تَدخُلُ على هؤلاء الأُمَراءِ وتَغْشاهم، فانْظُرْ ماذا تُحاضِرُهم به؛ فإنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ يقولُ: «إنَّ الرَّجُلَ لَيَتكلَّمُ بالكَلِمةِ مِن الخَيْرِ ما يَعلَمُ مَبلَغَها، يَكتُبُ اللهُ له رِضوانَه إلى يَوْمِ يَلْقاه، ",["وإنَّ الرَّجُلَ لَيَتكلَّمُ بالكَلِمةِ مِن الشَّرِّ ما يَعلَمُ مَبلَغَها",1],"، ",["يَكتُبُ اللهُ عليه بِها سَخَطَه إلى يَوْمِ يَلْقاه",2],"»، وكانَ عَلْقمةُ يقولُ: رُبَّ حَديثٍ قد حالَ بَيْني وبَيْنَه ما سَمِعْتُ مِن بِلالٍ."],"grade":"صحيح","narrator":"بلال بن الحارث","muhaddith":"صحيح على شرط الشَّيْخين","bab":"رقائق وزهد › من أرضى الناس بسخط الله","dorar":"0boLB4EF"},{"id":"س-07525","fp":"d5152f85b4dd","stateId":244,"easy":"إذا حلفت يمين صبر لتقتطع مال مسلم ← تلقى الله وقد اجتمع عليك غضبه","cause":"مَن حَلَف على يَمينِ صَبرٍ ليَقتَطِعَ بها مالَ امرِئٍ مُسلِمٍ","result":"لَقِيَ اللهَ تَعالَى يَومَ القِيامةِ وهو مُجتَمِعٌ عليه غَضَبًا، عَفا اللهُ عنه أو عاقَبَه","explicit":true,"repOf":"س-06938","ref":"المستدرك على الصحيحين 8016","text":["أنَّه خاصَمَ رَجُلًا إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ في أرضٍ، فجَعَل اليَمينَ على أحَدِهِما، فقالَ: يا رَسولَ اللهِ، إنْ حَلَف دَفَعتُ إليه أرضي، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: اترُكْهُ؛ فإنَّه ",["مَن حَلَف على يَمينِ صَبرٍ ليَقتَطِعَ بها مالَ امرِئٍ مُسلِمٍ، ",1],["لَقِيَ اللهَ تَعالَى يَومَ القِيامةِ وهو مُجتَمِعٌ عليه غَضَبًا، عَفا اللهُ عنه أو عاقَبَه",2],"."],"grade":"صحيح","narrator":"الأشعث بن قيس","muhaddith":"صحيح الإسناد","bab":"فضائل النبي وصفته ودلائل النبوة › اختصام المؤمنين إليه صلى الله عليه وسلم وحكمه عليهم","dorar":"enVOGHoW"},{"id":"س-01704","fp":"eff4cbeef1ba","stateId":244,"easy":"إذا حلفت ظلماً لتأكل مال غيرك ← تلقى الله وهو عنك معرض","cause":"إنْ حَلَف على مالِك ظُلمًا لِيَأكُلَه","result":"لَقِيَ اللهَ عَزَّ وجَلَّ وهو عنه مُعْرِضٌ","explicit":true,"ref":"تخريج مشكل الآثار 3225","srcLabel":"السنة","text":["مِثلَه [أي: حَديثَ: جاء رجلٌ مِن حَضرَمَوت ورجلٌ مِن كِنْدةَ إلى رَسولِ الله صلَّى اللهُ عليه وسلَّم، فقال الحَضرميُّ: يا رسولَ الله، إنَّ هذا غلَبَني على أرضٍ كانت لي، فقال الكِندي: هي أرضي في يدي أزرَعُها، ليس له فيها حَقٌّ. فقال رسولُ الله صلَّى اللهُ عليه وسلَّم للحَضرميِّ: ألك بَيِّنةٌ؟ قال: لا. فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: فأَحْلِفْه. فقال: إنَّه ليس له يمينٌ! فقال النبيُّ صلَّى اللهُ عليه وسلَّم: ليس لك منه إلَّا ذلك، فانطَلَق ليُحْلِفَه، فقال رَسولُ الله صلَّى اللهُ عليه وسلَّم: أمَا إنِّه ",["إنْ حَلَف على مالِك ظُلمًا لِيَأكُلَه",1]," ",["لَقِيَ اللهَ عَزَّ وجَلَّ وهو عنه مُعْرِضٌ",2],"]، غيرَ أنَّه قال: فقال الحَضْرَميُّ: يا رسولَ اللهِ، إنَّ هذا غلَبَني على أرضٍ كانت لأبي."],"grade":"حسن","narrator":"وائل بن حجر","muhaddith":"إسناده حسن","bab":"أقضية وأحكام › الخصمان ليس لأحدهما بينة","dorar":"QsDm1Kfr"},{"id":"س-01836","fp":"d10086351dcf","stateId":244,"easy":"إذا حلفت عند منبر النبي ﷺ يميناً كاذبة لتأخذ مال مسلم ← فعليك لعنة الله والملائكة والناس أجمعين","cause":"من حلف عند منبري هذا بيمينٍ كاذبةٍ يَسْتَحِلُّ بها مالَ امرِئٍ مسلمٍ","result":"فعليه لعنةُ اللهِ والملائكةِ والناسِ أجمعين لا يقبلُ اللهُ منه صَرْفًا ولا عَدْلًا","explicit":true,"otherNeedIds":[45],"ref":"نيل الأوطار 9/225","srcLabel":"النسائي","text":[["من حلف عند منبري هذا بيمينٍ كاذبةٍ يَسْتَحِلُّ بها مالَ امرِئٍ مسلمٍ ",1],["فعليه لعنةُ اللهِ والملائكةِ والناسِ أجمعين لا يقبلُ اللهُ منه صَرْفًا ولا عَدْلًا",2]],"grade":"حسن","narrator":"أبو أمامة إياس بن ثعلبة الحارثي","muhaddith":"رجاله ثقات","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (5974)، والدولابي في ((الكنى والأسماء)) (88) باختلاف يسير، والطبراني (1/273) (798) مطولاً باختلاف يسير","bab":"إحسان › إبطال الأعمال","dorar":"ggkywkOn"},{"id":"س-02712","fp":"e59c901743b2","stateId":244,"easy":"إذا كنت حسوداً أو نماماً أو كاهناً ← فلست من النبي ﷺ","cause":"ذُو حسدٍ، و لا نميمةٍ، و لا كهانةٍ","result":"ليسَ منِّي","explicit":true,"ref":"الجامع الصغير 7681","srcLabel":"الطبراني","text":[["ليسَ منِّي",2]," ",["ذُو حسدٍ،  و لا نميمةٍ،  و لا كهانةٍ",1],"،  و لا أنا منهُ"],"grade":"حسن","narrator":"عبدالله بن بسر","muhaddith":"حسن","takhrij":"أخرجه الطبراني كما في ((جامع المسانيد)) (6101)، وابن عساكر في ((تاريخ دمشق)) (21/ 334) واللفظ لهما.","bab":"إيمان › السحر والنشرة والكهانة","dorar":"o5wVVRB5"},{"id":"س-02584","fp":"46b7d0c5a6a5","stateId":244,"easy":"إذا لعنت من لا يستحق ← ترجع اللعنة إليك","cause":"فلم أجد فيه مسلكًا، ولم أجد عليه سبيلًا","result":"ارجعي من حيث جئتِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[12],"ref":"فتح الغفار 2088/4","srcLabel":"أحمد","text":["إن اللعنة إذا وجهت إلى من وجهت إليه فإن أصابت إليه سبيلًا أو وجدت فيه مسلكًا وإلا قالت: يا رب! وجهت إلى فلان ",["فلم أجد فيه مسلكًا، ولم أجد عليه سبيلًا",1]," فيقال لها: ",["ارجعي من حيث جئتِ",2]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"إسناده جيد","takhrij":"أخرجه أحمد (3876) مطولاً واللفظ له، وأخرجه الطحاوي في ((شرح مشكل الآثار)) (3706) باختلاف يسير، والبيهقي في ((شعب الإيمان)) (5163) مختصراً باختلاف يسير","bab":"إيمان › أعمال تنافي الإيمان","dorar":"J4C6ti3T"},{"id":"س-03736","fp":"01e8e81daa16","stateId":245,"easy":"إذا وشمت أو نمصت أو فلّجت أسنانك للحسن ← لعنك الله","cause":"الواشِماتِ والمُستَوشِماتِ، والنَّامِصاتِ والمُتَنَمِّصاتِ، والمُتَفَلِّجاتِ للحُسنِ المُغَيِّراتِ خَلقَ اللهِ","result":"لَعَنَ اللهُ","explicit":true,"star":true,"ref":"صحيح مسلم 2125","srcLabel":"البخاري","text":[["لَعَنَ اللهُ",2],[" الواشِماتِ والمُستَوشِماتِ، والنَّامِصاتِ والمُتَنَمِّصاتِ، والمُتَفَلِّجاتِ للحُسنِ المُغَيِّراتِ خَلقَ اللهِ",1],"، قال: فبَلَغَ ذلك امرَأةً مِن بَني أسَدٍ يُقالُ لَها: أُمُّ يَعقوبَ، وكانَت تَقرَأُ القُرآنَ، فأتَتْه فقالت: ما حَديثٌ بَلَغَني عَنكَ أنَّكَ لَعَنتَ الواشِماتِ والمُستَوشِماتِ، والمُتَنَمِّصاتِ والمُتَفَلِّجاتِ للحُسنِ المُغَيِّراتِ خَلقَ اللهِ؟ فقال عبدُ اللهِ: وما لي لا ألعَنُ مَن لَعَنَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم؟ وهو في كِتابِ اللهِ، فقالتِ المَرأةُ: لقد قَرَأتُ ما بينَ لَوحَيِ المُصحَفِ فما وجَدتُه، فقال: لَئِن كُنتِ قَرَأتيه لقد وجَدتيه، قال اللهُ عَزَّ وجَلَّ: {وما آتاكُمُ الرَّسولُ فخُذوه وما نَهاكُم عنه فانتَهُوا} فقالتِ المَرأةُ: فإنِّي أرى شيئًا مِن هذا على امرَأتِكَ الآنَ، قال: اذهَبي فانظُري، قال: فدَخَلَت على امرَأةِ عبدِ اللهِ فلَم تَرَ شيئًا، فجاءَت إليه فقالت: ما رَأيتُ شيئًا، فقال: أما لو كان ذلك لَم نُجامِعْها. غيرَ أنَّ في حَديثِ سُفيانَ: الواشِماتِ والمُستَوشِماتِ. وفي حَديثِ مُفَضَّلٍ: الواشِماتِ والمَوشوماتِ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4886) باختلاف يسير","bab":"اعتصام بالسنة › لزوم السنة","dorar":"O5hasLAH","merged":7,"otherRefs":["صحيح ابن ماجه 1631 (صحيح)","تخريج المسند لشعيب 4230 (صحيح)","صحيح البخاري 4886 (صحيح)","السلسلة الصحيحة 2792 (صحيح)","آداب الزفاف 132 (حسن)","تخريج المسند لشعيب 3956 (صحيح)"]},{"id":"س-08285","fp":"09ce6d9c1034","stateId":245,"easy":"إذا تخنّث الرجل أو ترجّلت المرأة ← لعنهم النبي ﷺ","cause":"المُخَنَّثِينَ مِنَ الرِّجالِ، والمُتَرَجِّلاتِ مِنَ النِّساءِ","result":"لَعَنَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 9/236","srcLabel":"البخاري","text":[["لَعَنَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ",2],[" المُخَنَّثِينَ مِنَ الرِّجالِ، والمُتَرَجِّلاتِ مِنَ النِّساءِ",1],"، وقال: أَخرِجُوهُنَّ مِن بُيوتِكُم، فأَخرَجَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فُلانًا، وأَخرَجَ عُمرُ فُلانًا."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه البخاري (5886) باختلاف يسير","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"FDqqwKew","merged":8,"otherRefs":["فتاوى نور على الدرب لابن عثيمين 11/188 (صحيح)","مجموع الفتاوى 22/156 (صحيح)","تخريج المسند لشاكر 14/243 (صحيح)","تخريج المسند لشاكر 4/79 (صحيح)","صحيح الترمذي 2784 (صحيح)","المجموع للنووي 6/39 (صحيح)","تخريج المسند لشعيب 3059 (صحيح)"]},{"id":"س-08293","fp":"722a1e6e35e0","stateId":245,"easy":"إذا وصلتِ شعرك ← لُعنتِ","cause":"الواصِلاتُ. وفي روايةٍ: لُعِنَ الموصِلاتُ","result":"لُعِنَ","explicit":true,"star":true,"similar":["س-07167","س-08292"],"ref":"صحيح مسلم 2123","srcLabel":"متفق عليه","text":["أنَّ امرَأةً مِنَ الأنصارِ زَوَّجَتِ ابنةً لَها، فاشتَكَت فتَساقَطَ شَعرُها، فأتَتِ النَّبيَّ صلَّى اللهُ عليه وسلَّم فقالت: إنَّ زَوجَها يُريدُها، أفَأصِلُ شَعَرَها؟ فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["لُعِنَ",2]," ",["الواصِلاتُ. وفي روايةٍ: لُعِنَ الموصِلاتُ",1],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5205) بمعناه، مسلم (2123).","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"O3EU18mI","merged":10,"otherRefs":["التمهيد 17/404 (صحيح)","صحيح البخاري 5942 (صحيح)","الصحيح المسند 1/654 (صحيح)","تخريج المسند لشعيب 4284 (صحيح)","تخريج المسند لشعيب 26979 (صحيح)","صحيح الجامع 2401 (صحيح)","صحيح البخاري 5934 (صحيح)","صحيح النسائي 5265 (صحيح)","صحيح البخاري 5205 (صحيح)"]},{"id":"س-06878","fp":"7d2d9b9eb2a2","stateId":245,"easy":"إذا جررت ثوبك مخيلة ← لا ينظر الله إليك يوم القيامة","cause":"مَن جَرَّ ثَوبَه مَخيلةً","result":"لَم يَنظُرِ اللهُ إلَيه يَومَ القيامةِ","explicit":true,"star":true,"similar":["س-05238"],"ref":"صحيح البخاري 5791","srcLabel":"مسلم","text":[["مَن جَرَّ ثَوبَه مَخيلةً",1]," ",["لَم يَنظُرِ اللهُ إلَيه يَومَ القيامةِ",2],"، فقُلتُ لمُحارِبٍ: أذَكَرَ إزارَه؟ قال: ما خَصَّ إزارًا ولا قَميصًا، تابَعَه جَبَلةُ بنُ سُحَيمٍ، وزَيدُ بنُ أسلَمَ، وزَيدُ بنُ عبدِ اللهِ، عَنِ ابنِ عُمَرَ، عَنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم، وقال اللَّيثُ، عن نافِعٍ، عَنِ ابنِ عُمَرَ: مِثلَه. وتابَعَه موسى بنُ عُقبةَ، وعُمَرُ بنُ مُحَمَّدٍ، وقُدامةُ بنُ موسى، عن سالِمٍ، عَنِ ابنِ عُمَرَ، عَنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم: مَن جَرَّ ثَوبَه."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2085) المرفوع منه باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"SsUlxRvA","merged":20,"otherRefs":["تخريج المسند لشعيب 4884 (صحيح)","تخريج المسند لشعيب 11352 (صحيح)","تخريج المسند لشعيب 11010 (صحيح)","تخريج صحيح ابن حبان 5450 (صحيح)","تخريج صحيح ابن حبان 5444 (صحيح)","تخريج المسند لشعيب 5535 (صحيح)","شرح البخاري لابن عثيمين 5/457 (صحيح)","صحيح الجامع 3440 (صحيح)","الصحيح المسند 1/347 (صحيح)","تخريج المسند لشاكر 9/122 (صحيح)","تخريج المسند لشاكر 7/140 (صحيح)","صحيح مسلم 2085 (صحيح)","صحيح النسائي 5343 (صحيح)","تخريج المسند لشاكر 9/14 (صحيح)","صحيح البخاري 3665 (صحيح)","صحيح الجامع 2770 (صحيح)","صحيح النسائي 5351 (صحيح)","صحيح مسلم 2087 (صحيح)"]},{"id":"س-06934","fp":"ab4025dcebbc","stateId":245,"easy":"إذا جررت إزارك خيلاء ← لا ينظر الله إليك يوم القيامة","cause":"الذي يَجُرُّ إزارَه مِنَ الخُيَلاءِ","result":"لا يَنظُرُ اللهُ إليه يَومَ القيامةِ","explicit":true,"star":true,"ref":"صحيح مسلم 2085","srcLabel":"البخاري","text":["[عن] محمَّدِ بنِ عَبَّادِ بنِ جَعفَرٍ، يقولُ: أمرتُ مُسلِمَ بنَ يَسارٍ مَولى نافعِ بنِ عَبدِ الحارِثِ أن يسألَ ابنَ عُمَرَ. قال: وأنا جالِسٌ بينهما: أسَمِعتَ مِنَ النَّبيِّ صلَّى اللهُ عليه وسلَّم في ",["الذي يَجُرُّ إزارَه مِنَ الخُيَلاءِ",1]," شيئًا؟ قال: سَمِعتُه يقولُ: ",["لا يَنظُرُ اللهُ إليه يَومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر.","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (5460)، وابن عساكر في ((معجمه)) (1024) واللفظ لهما، والبخاري (5784) بنحوه.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"75EaSDbG","merged":4,"otherRefs":["تخريج المسند لشعيب 10023 (صحيح)","أحكام القرآن لابن العربي 3/530 (صحيح)","تخريج المسند لشاكر 7/144 (صحيح)"]},{"id":"س-03084","fp":"ee129e1d880f","stateId":245,"easy":"إذا تشبهت بقوم ← فأنت منهم","cause":"و من تشبَّه بقومٍ","result":"فهو منهم","explicit":true,"ref":"صحيح الجامع 2831","srcLabel":"البخاري","text":["بُعِثتُ بين يدي الساعةِ بالسَّيفِ ، حتى يُعبَدَ اللهُ تعالى وحده لا شريكَ له ، و جُعِلَ رِزْقي تحت ظِلِّ رُمْحي ، وجُعِلَ الذُّلُّ و الصَّغارُ على من خالفَ أمري ، ",["و من تشبَّه بقومٍ",1]," ",["فهو منهم",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه البخاري معلقاً بصيغة التضعيف قبل حديث (2914) مختصراً، وأخرجه موصولاً أحمد (5667) واللفظ له.","bab":"إيمان › الوعيد","dorar":"9Keg9BA6","merged":3,"otherRefs":["مجموع الفتاوى 25/331 (حسن)","صحيح الترغيب 2089 (حسن)"]},{"id":"س-00819","fp":"1dc3de49ea8d","stateId":245,"easy":"إذا لبس الرجل لبس المرأة أو العكس ← لُعن","cause":"الرَّجُلَ يَلبَسُ لِبْسةَ المرأةِ، والمرأةَ تَلبَسُ لِبْسةَ الرَّجُلِ","result":"لَعَنَ","explicit":true,"ref":"تخريج المسند لشعيب 8309","srcLabel":"مسلم","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ ",["لَعَنَ",2]," ",["الرَّجُلَ يَلبَسُ لِبْسةَ المرأةِ، والمرأةَ تَلبَسُ لِبْسةَ الرَّجُلِ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أبو داود (4098)، والنسائي في ((السنن الكبرى)) (9253) باختلاف يسير، وابن ماجه (1903) بنحوه، وأحمد (8309) واللفظ له","bab":"أدعية وأذكار › دعاء النبي على بعض الأشخاص والأشياء والأمور","dorar":"8IjbljEM","merged":3,"otherRefs":["التعليقات الرضية 119/3 (صحيح)","المستدرك على الصحيحين 7620 (صحيح)"]},{"id":"س-01548","fp":"60858cbbd421","stateId":245,"easy":"إذا تسمّيت «ملك الأملاك» ← يشتد غضب الله عليك","cause":"رَجُلٍ تسَمَّى بمَلِكِ الأملاكِ","result":"واشتَدَّ غَضَبُ اللهِ على","explicit":true,"ref":"تخريج المسند لشعيب 10384","srcLabel":"متفق عليه","text":["اشتَدَّ غَضَبُ اللهِ عزَّ وجلَّ على رَجُلٍ قتَلَهُ نَبيُّهُ -وقال رَوْحٌ: قتَلَهُ رسولُ اللهِ- ",["واشتَدَّ غَضَبُ اللهِ على",2]," ",["رَجُلٍ تسَمَّى بمَلِكِ الأملاكِ",1],"؛ لا مَلِكَ إلَّا اللهُ عزَّ وجلَّ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (4073)، ومسلم (1793) أوله في أثناء حديث، وأحمد (10384) واللفظ له","bab":"أسماء › الأسماء المنهي عنها والمكروهة","dorar":"Zb3NJg9u"},{"id":"س-01551","fp":"c384cdc3e30f","stateId":245,"easy":"إذا تسميت «ملك الأملاك» ← تكون أغيظ رجل على الله يوم القيامة","cause":"رَجُلٌ كانَ يُسَمَّى مَلِكَ الأملاكِ","result":"أغيَظُ رَجُلٍ على اللهِ يَومَ القيامةِ، وأخبَثُه وأغيَظُه عليه","explicit":true,"ref":"صحيح مسلم 2143","srcLabel":"البخاري","text":[["أغيَظُ رَجُلٍ على اللهِ يَومَ القيامةِ، وأخبَثُه وأغيَظُه عليه",2],"، ",["رَجُلٌ كانَ يُسَمَّى مَلِكَ الأملاكِ",1],"، لا مَلِكَ إلَّا اللهُ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6206) بنحوه","bab":"أسماء › الأسماء المنهي عنها والمكروهة","dorar":"6sQGN04s"},{"id":"س-06913","fp":"cdd5d5bddc73","stateId":245,"easy":"إذا أسبلت ← لا ينظر الله إليك","cause":"المُسبِلِ","result":"إنَّ اللهَ لا ينظرُ إلى","explicit":true,"similar":["س-03583"],"ref":"السلسلة الصحيحة 4/214","srcLabel":"متفق عليه","text":[["إنَّ اللهَ لا ينظرُ إلى",2],[" المُسبِلِ",1]," يومَ القيامةِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (8229)، والبيهقي في ((شعب الإيمان)) (5714). وأخرجه البخاري (5788)، ومسلم (2087) بمعناه","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"NAHxgUYe"},{"id":"س-06945","fp":"b1fec61a8c62","stateId":245,"easy":"إذا تعظّمت في نفسك أو اختلت في مشيتك ← تلقى الله وهو عليك غضبان","cause":"مَنْ تَعَظَّمَ في نفسِهِ أوْ اخْتَالَ في مِشيتِهِ","result":"لَقِيَ اللهَ عزَّ وجلَّ و هو عليهِ غَضْبانُ","explicit":true,"similar":["س-02979"],"ref":"السلسلة الصحيحة 543","srcLabel":"البخاري","text":[["مَنْ تَعَظَّمَ في نفسِهِ أوْ اخْتَالَ في مِشيتِهِ ، ",1],["لَقِيَ اللهَ عزَّ وجلَّ و هو عليهِ غَضْبانُ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح على شرط البخاري","takhrij":"أخرجه أحمد (5995)، والبخاري في ((الأدب المفرد)) (549)، والطبراني (13/64) (13692)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"NJjJk4nw"},{"id":"س-06839","fp":"a0c424a64422","stateId":245,"easy":"إذا أسبلت إزارك أو مننت أو نفّقت سلعتك بالحلف الكاذب ← لا يكلمك الله ولا ينظر إليك ولا يزكيك","cause":"المُسبلُ إزارَه والمنَّانُ والمُنفِّقُ سلعتَه بالحلفِ الكاذبِ","result":"ثلاثةٌ لا يُكلِّمُهم اللهُ يومَ القيامةِ ولا ينظرُ إليهم ولا يُزكيهم ولهم عذابٌ أليمٌ","explicit":true,"similar":["س-06825","س-06862","س-06871"],"otherNeedIds":[57],"ref":"مسند علي 56","srcLabel":"مسلم","text":[["ثلاثةٌ لا يُكلِّمُهم اللهُ يومَ القيامةِ ولا ينظرُ إليهم ولا يُزكيهم ولهم عذابٌ أليمٌ",2]," قال فقالها رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ثلاثَ مراتٍ قال فقال أبو ذرٍّ خابوا وخسروا خابوا وخسِروا خابوا وخسِروا من هم يا رسولَ اللهِ قال ",["المُسبلُ إزارَه والمنَّانُ والمُنفِّقُ سلعتَه بالحلفِ الكاذبِ",1]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (106) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"93nueeKf","merged":2,"otherRefs":["غاية المرام 170 (صحيح)"]},{"id":"س-07167","fp":"98dcdf4cf9e6","stateId":245,"easy":"إذا وصلت شعرك أو طلبت وصله ← لعنك الله","cause":"الواصِلةَ والمَوصولةَ","result":"لَعَنَ اللهُ","explicit":true,"repOf":"س-08293","ref":"صحيح البخاري 5941","text":["سَألَتِ امرَأةٌ النَّبيَّ صلَّى اللهُ عليه وسلَّم فقالت: يا رَسولَ اللهِ، إنَّ ابنَتي أصابَتها الحَصبةُ، فامَّرَقَ شَعَرُها، وإنِّي زَوَّجتُها؛ أفَأصِلُ فيه؟ فقال: ",["لَعَنَ اللهُ",2],[" الواصِلةَ والمَوصولةَ",1],"."],"grade":"صحيح","narrator":"أسماء بنت أبي بكر","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2122) باختلاف يسير","bab":"علم › حسن السؤال ونصح العالم","dorar":"5ZKqk5uw"},{"id":"س-07462","fp":"c093197dd5a9","stateId":245,"easy":"إذا كانت المرأة كاسية عارية ← فهي ملعونة","cause":"سيكونُ في آخرِ أمتي نساءٌ كاسياتٌ عارياتٌ ، على رؤوسِهن كأسنمةِ البُخْتِ ، العنُوهن","result":"فإنهن ملعوناتٌ","explicit":true,"similar":["س-00655"],"ref":"جلباب المرأة 125","srcLabel":"مسلم","text":[["سيكونُ في آخرِ أمتي نساءٌ كاسياتٌ عارياتٌ ، على رؤوسِهن كأسنمةِ البُخْتِ ، العنُوهن ",1],["فإنهن ملعوناتٌ ",2],". زادَ في حديثٍ آخرٍ : لا يدخلْنَ الجنةَ ولا يجدْنَ ريحَها ، وإن ريحَها لتوجدُ من مسيرةِ كذا وكذا ."],"grade":"صحيح","narrator":"[عبدالله بن عمرو]","muhaddith":"إسناده صحيح، والحديث الآخر أخرجه مسلم","takhrij":"أخرجه أحمد (7083)، وابن حبان (5753) مطولاً باختلاف يسير، والطبراني في ((المعجم الأوسط)) (9331) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"E2zWcBNb"},{"id":"ق-1068","fp":"e96addb2b1e8","stateId":245,"easy":"الاستكبار عن أمر الله ← الرجم واللعنة إلى يوم الدين","cause":"الاستكبار عن أمر الله","result":"الرجم واللعنة إلى يوم الدين","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[39],"ref":"سورة ص: 74–78","srcLabel":"القرآن الكريم","quran":{"s":38,"from":74,"to":78,"text":"إِلَّا إِبْلِيسَ اسْتَكْبَرَ وَكَانَ مِنَ الْكَافِرِينَ (74) قَالَ يَا إِبْلِيسُ مَا مَنَعَكَ أَنْ تَسْجُدَ لِمَا خَلَقْتُ بِيَدَيَّ أَسْتَكْبَرْتَ أَمْ كُنْتَ مِنَ الْعَالِينَ (75) قَالَ أَنَا خَيْرٌ مِنْهُ خَلَقْتَنِي مِنْ نَارٍ وَخَلَقْتَهُ مِنْ طِينٍ (76) قَالَ فَاخْرُجْ مِنْهَا فَإِنَّكَ رَجِيمٌ (77) وَإِنَّ عَلَيْكَ لَعْنَتِي إِلَى يَوْمِ الدِّينِ (78)","hl":[[0,355,1]]}},{"id":"س-02979","fp":"1ee35a97241f","stateId":245,"easy":"إذا تعاظمت في نفسك واختلت في مشيتك ← تلقى الله وهو عليك غضبان","cause":"ما مِنْ رَجُلٍ يَتَعاظَمُ في نَفْسِهِ ويَخْتالُ في مِشْيَتِهِ","result":"إلَّا لَقِيَ اللهَ وهو علَيْه غَضْبانُ","explicit":true,"repOf":"س-06945","ref":"المستدرك على الصحيحين 202","text":["عنْ عِكرمةَ بنِ خالدِ بنِ سعيدِ بنِ العاصي المَخْزوميِّ، أنَّه لَقِيَ عبْدَ اللهِ بنَ عُمرَ بنِ الخطَّابِ، فقالَ لهُ: يا أَبا عبدِ الرَّحْمنِ، إنَّا بَنو المُغيرةِ قَوْمٌ فينا نَخْوَةٌ، فهل سَمِعْتَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ في ذلك شيئًا؟ فقالَ عبدُ اللهِ بنُ عُمرَ: سَمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ: «",["ما مِنْ رَجُلٍ يَتَعاظَمُ في نَفْسِهِ ويَخْتالُ في مِشْيَتِهِ",1]," ",["إلَّا لَقِيَ اللهَ وهو علَيْه غَضْبانُ»",2],"."],"grade":"صحيح","narrator":"عبدُ اللهِ بنُ عُمرَ","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (7817)، والخرائطي ((مساوئ الأخلاق)) (573) واللفظ لهما، وأحمد (5995) مختصرا","bab":"إيمان › الوعيد","dorar":"BA5dIfq6","merged":4,"otherRefs":["الجامع الصغير 8022 (صحيح)","الكبائر للذهبي 196 (صحيح)","مدح التواضع وذم الكبر 14 (حسن)"]},{"id":"س-05238","fp":"2b8dbd685d20","stateId":245,"easy":"إذا جررت ثوبك خيلاء ← لا ينظر الله إليك","cause":"عليهِ حُلَّةٌ صنعانيةٌ يجرُّها سَبْلًا","result":"لا ينظرُ اللهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-06878","ref":"السلسلة الصحيحة 6/411","text":["[ حديثُ ] الشَّابِّ الذي كان ",["عليهِ حُلَّةٌ صنعانيةٌ يجرُّها سَبْلًا",1]," فقال لهُ ابنُ عمرَ رضي اللهُ عنهُ يا فتى هَلُمَّ قال ما حاجتُكَ يا أبا عبدِالرحمنِ قال ويحكَ أتحبُّ أن ينظرَ اللهُ إليكَ يومَ القيامةِ قال سبحانَ اللهِ وما يمنعُني أن لا أُحِبَّ ذلكَ قال سمعتُ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يقولُ ",["لا ينظرُ اللهُ",2]," . . . فلم يُرَ ذلكَ الشَّابُّ إلا مُشمِّرًا حتى ماتَ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (5712) واللفظ له، والبخاري (5783)، ومسلم (2085) مختصرًا على المرفوع فقط.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"fIKL74Wz"},{"id":"س-04898","fp":"de042270b675","stateId":245,"easy":"إذا تشبهت المرأة بالرجال أو الرجل بالنساء ← فليس منا","cause":"تشبَّهَ بالرجالِ منَ النساءِ، و لا منْ تشبَّهَ بالنساءِ منَ الرجالِ","result":"ليسَ منَّا منْ","explicit":true,"ref":"الجامع الصغير 7659","srcLabel":"أحمد","text":[["ليسَ منَّا منْ",2],[" تشبَّهَ بالرجالِ منَ النساءِ،  و لا منْ تشبَّهَ بالنساءِ منَ الرجالِ",1]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه أحمد (6875)، والطبراني (13/467) (14332)، وأبو نعيم في ((حلية الأولياء)) (3/321)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"yX9HVsXC","merged":3,"otherRefs":["جلباب المرأة 142 (صحيح)","صحيح ابن ماجه 1557 (صحيح)"]},{"id":"س-00655","fp":"4d4f675fb96f","stateId":245,"easy":"إذا كانت المرأة كاسية عارية ← فهي ملعونة","cause":"نساؤُهم كاسياتٌ عارياتٌ، على رؤوسِهم كأسنِمةِ البُختِ","result":"فالعنوهنَّ فإنَّهن ملعوناتٌ","explicit":true,"repOf":"س-07462","ref":"سبل الهدى والرشاد 10/135","text":["«سيكونُ في آخِرِ أمَّتي رجالٌ يركبون على سُروجٍ كأشباهِ الرِّحالِ ينزلون على أبوابِ المساجِدِ، ",["نساؤُهم كاسياتٌ عارياتٌ، على رؤوسِهم كأسنِمةِ البُختِ",1],"، ",["فالعنوهنَّ فإنَّهن ملعوناتٌ",2],"، لو كانت وراءكم أُمَّةٌ من الأمَمِ لخدَم نساؤكم نساءَهم كما خدَمَتكم نساءُ الأمَمِ من قَبلِكم»، ولفظُ الطَّبرانيِّ: «سيكونُ في أمَّتي رجالٌ يركَبُ نساؤُهم على سُروجٍ كأشباهِ الرِّجالِ»"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[رجاله] رجال الصحيح.","takhrij":"أخرجه أحمد (7083)، وابن حبان (5753)، والطبراني (13/ 63)، (156) جميعهم بلفظه.","bab":"آداب عامة › ضرب الأمثال","dorar":"j6kwImwD","merged":2,"otherRefs":["المستدرك على الصحيحين 8565 (صحيح)"]},{"id":"س-04876","fp":"e3e0eef86c13","stateId":245,"easy":"إذا لبست ثوب شهرة ← يعرض الله عنك حتى تضعه","cause":"مَن لَبِس ثوبَ شُهرةٍ","result":"أعرض اللهُ عنه حتى يضَعَه متى وضَعَه","explicit":true,"ref":"الجامع الصغير 8984","srcLabel":"ابن ماجه","text":[["مَن لَبِس ثوبَ شُهرةٍ ",1],["أعرض اللهُ عنه حتى يضَعَه متى وضَعَه",2],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (3608) واللفظ له، والعقيلي في ((الضعفاء الكبير)) (4/328)، وأبو الشيخ في ((التوبيخ والتنبيه)) (169)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"8AivkSh4","merged":2,"otherRefs":["تخريج الإحياء للعراقي 4/286 (حسن)"]},{"id":"س-08280","fp":"5b55c12752ee","stateId":245,"easy":"إذا تشبهت المرأة بالرجال ← لعنها النبي ﷺ","cause":"الرَّجُلةَ من النساءِ","result":"لعن رسولُ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ","explicit":true,"ref":"صحيح أبي داود 4099","srcLabel":"أبو داود","text":["قيل لعائشةَ : إنَّ امرأةً تلبسُ النعلَ ، فقالت : ",["لعن رسولُ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ",2],[" الرَّجُلةَ من النساءِ",1]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4099)، والبيهقي في ((معرفة السنن والآثار)) (20866) واللفظ لهما، والحميدي (274) بنحوه.","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"qnvpzyzr","merged":2,"otherRefs":["صحيح الجامع 5096 (صحيح)"]},{"id":"س-08292","fp":"b532b29c57c5","stateId":245,"easy":"إذا وصلتِ شعرك أو طلبتِه ← لعنك النبي ﷺ","cause":"أفَأصِلُ رَأسَها","result":"فسَبَّ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم الواصِلةَ والمُستَوصِلةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-08293","ref":"صحيح البخاري 5935","text":["أنَّ امرَأةً جاءَت إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقالت: إنِّي أنكَحتُ ابنَتي، ثُمَّ أصابَها شَكوى، فتَمَرَّقَ رَأسُها، وزَوجُها يَستَحِثُّني بها، ",["أفَأصِلُ رَأسَها",1],"؟ ",["فسَبَّ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم الواصِلةَ والمُستَوصِلةَ",2]],"grade":"صحيح","narrator":"أسماء بنت أبي بكر","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2122) باختلاف يسير","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"SSIWeZiL"},{"id":"س-00813","fp":"05db00a72ffe","stateId":245,"easy":"إذا نمصت أو طلبت النمص ← لُعنت","cause":"النامصةَ والمتنمصةَ","result":"لعن","explicit":true,"ref":"مجموع فتاوى ابن باز 51/10","srcLabel":"السنة","text":["عن النبيِّ صلَّى اللهُ عليهِ وسلَّمَ : أنه ",["لعن",2]," ",["النامصةَ والمتنمصةَ",1]],"grade":"صحيح","muhaddith":"[ثابت]","bab":"أدعية وأذكار › دعاء النبي على بعض الأشخاص والأشياء والأمور","dorar":"Q2aG8HAH"},{"id":"س-03097","fp":"7fd8164d552e","stateId":245,"easy":"إذا أسبلت إزارك في صلاتك خيلاء ← فلست من الله في شيء","cause":"مَن أسبَلَ إزارَه في صَلاتِه خُيَلاءَ","result":"فليس مِن اللهِ في حِلٍّ ولا حَرامٍ","explicit":true,"ref":"مجموع الشروح الفقهية. 153/30","srcLabel":"أبو داود","text":[["مَن أسبَلَ إزارَه في صَلاتِه خُيَلاءَ ",1],["فليس مِن اللهِ في حِلٍّ ولا حَرامٍ",2],"."],"grade":"صحيح","narrator":"ابن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (637) بلفظه، والطبراني (9/ 274) (9368)، والبيهقي (3350) كلاهما بلفظ مقارب، والنسائي في ((السنن الكبرى)) (9600) بنحوه دون ذكر الصلاة.","bab":"إيمان › الوعيد","dorar":"Tfz45NMi"},{"id":"س-03583","fp":"d0c482352e9d","stateId":245,"easy":"إذا أسبلت إزارك ← لا ينظر الله إليك","cause":"لا تُسبِلْ إزارَك","result":"فإنَّ اللهَ لا ينظُرُ إلى المُسبِلينَ","explicit":true,"repOf":"س-06913","ref":"صحيح ابن حبان 5442","text":["رأَيْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم أخَذ بحُجْزةِ سُفيانَ بنِ أبي سُهيلٍ فقال: ( يا سُفيانُ ",["لا تُسبِلْ إزارَك ",1],["فإنَّ اللهَ لا ينظُرُ إلى المُسبِلينَ )",2]],"grade":"صحيح","narrator":"المغيرة بن شعبة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن ماجه (3574) مختصراً باختلاف يسير، وأحمد (18151) باختلاف يسير","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"90M15EFa"},{"id":"س-06873","fp":"c8d4a833fa6d","stateId":245,"easy":"إذا سحبت ثيابك (خيلاء) ← لا ينظر الله إليك يوم القيامة","cause":"من سحب ثيابَه","result":"لم ينظرِ اللهُ إليه يومَ القيامةِ","explicit":true,"ref":"السلسلة الصحيحة 4/167","srcLabel":"الطبراني","text":[["من سحب ثيابَه",1]," ",["لم ينظرِ اللهُ إليه يومَ القيامةِ",2]," فقال أبو ريحانةَ لقد أمرَضَنا ما حدَّثْتنا إني أحبُّ الجمالَ حتى أجعلَه في نعلِي وعَلاقةِ سَوطي أفمنَ الكِبرَ ذلك؟ فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ إنَّ اللهَ جميلٌ يحبُّ الجَمالَ ويحبُّ أن يرى أثرَ نعمتِه على عبدِه لكنِ الكبرُ مَن سفَّه الحقَّ وغمصَ الناسَ أعمالَهم"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (4668)، والدارقطني في ((الأفراد)) كما في ((أطراف الغرائب والأفراد)) لابن طاهر المقدسي (3/489)، وابن عساكر في ((تاريخ دمشق)) (43/84) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"ojap9QqD"},{"id":"س-04796","fp":"f27b3bf293eb","stateId":245,"easy":"إذا تشبهت بغير المسلمين ← فلست منا","cause":"تشبَّهَ بغيرنا ، لاَ تشبَّهوا باليَهودِ ولاَ بالنَّصارى ، فإنَّ تسليمَ اليَهودِ الإشارةُ بالأصابعِ ، وتسليمَ النَّصارى الإشارةُ بالأَكُفِّ","result":"ليسَ منَّا من","explicit":true,"ref":"صحيح الترمذي 2695","srcLabel":"الترمذي","text":[["ليسَ منَّا من",2],[" تشبَّهَ بغيرنا ، لاَ تشبَّهوا باليَهودِ ولاَ بالنَّصارى ، فإنَّ تسليمَ اليَهودِ الإشارةُ بالأصابعِ ، وتسليمَ النَّصارى الإشارةُ بالأَكُفِّ",1]],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن","takhrij":"أخرجه الترمذي (2695) واللفظ له، والطبراني في ((المعجم الأوسط)) (7380)، والقضاعي في ((المسند)) (1191)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"1O4PosSi","merged":3,"otherRefs":["صحيح الترغيب 2723 (حسن)","مجموع الفتاوى 25/331 (حسن)"]},{"id":"س-02940","fp":"faa7eeaf716d","stateId":245,"easy":"إذا لبست ثوباً للمباهاة ← لا ينظر الله إليك حتى تنزعه","cause":"ما من أحدٍ يلبَسُ ثوبًا ليُباهِيَ بهِ ، فيَنظرُ الناسُ إليه","result":"إلَّا لمْ يَنظرِ اللهُ إليه ، حتى ينزِعَهُ ، متَى ما نزعَهُ","explicit":true,"ref":"الجامع الصغير 7974","srcLabel":"السنة","text":[["ما من أحدٍ يلبَسُ ثوبًا ليُباهِيَ بهِ ، فيَنظرُ الناسُ إليه ،",1]," ",["إلَّا لمْ يَنظرِ اللهُ إليه ، حتى ينزِعَهُ ، متَى ما نزعَهُ",2]],"grade":"حسن","narrator":"أم سلمة أم المؤمنين","muhaddith":"حسن","bab":"إيمان › الوعيد","dorar":"87QtPgD5"},{"id":"س-04797","fp":"b0c48d2c6f33","stateId":245,"easy":"إذا تزيّيت بزيّهم أو تشبهت بهم ← فلست من النبي ﷺ","cause":"مَن تزيَّا بِهم أو تشبَّه","result":"فليسَ مِنِّي","explicit":true,"ref":"فتح الباري لابن حجر 10/284","srcLabel":"الطبراني","text":["إيَّاكُم ولَبوسِ الرُّهبانِ ، فإنَّه ",["مَن تزيَّا بِهم أو تشبَّه ",1],["فليسَ مِنِّي",2]],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه الطبراني في ((الأوسط)) (3909) واللفظ له.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"eFeHALve"},{"id":"س-05187","fp":"f90ae6612aef","stateId":245,"easy":"إذا أسبلت إزارك في الصلاة ← فلست من الله في شيء","cause":"المسبلُ إزارَه في الصلاةِ","result":"ليس من اللهِ في حلٍّ ولا حرامٍ","explicit":true,"ref":"مجمع الزوائد 5/127","srcLabel":"النسائي","text":["عن ابنِ مسعودٍ أنه رأَى أعرابيًّا يُصلِّي قد أسبل إزارَه فقال ",["المسبلُ إزارَه في الصلاةِ",1]," ",["ليس من اللهِ في حلٍّ ولا حرامٍ",2]],"grade":"حسن","narrator":"[عبدالرحمن بن مل النهدي أبو عثمان]","muhaddith":"رجاله ثقات","takhrij":"أخرجه أبو داوود (637) بلفظه، والنسائي في ((الكبرى)) (9600) ، وأبو داوود الطيالسي (349)كلاهما بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"SWm7qQha"},{"id":"س-06825","fp":"80da24ff148f","stateId":245,"easy":"إذا أسبلت أو مننت أو نفّقت سلعتك بالحلف الكاذب ← لا يكلمك الله ولا ينظر إليك ولا يزكيك","cause":"ولا ينظرُ إليهِم يَومَ القيامةِ ، ولا يُزَكِّيهم ، ولَهُم عذابٌ أليمٌ قلتُ : مَن هُم يا رسولَ اللَّهِ قد خابوا وخسِروا ؟ فأعادَها ثلاثًا","result":"ثلاثةٌ لا يُكَلِّمُهُمُ اللَّهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-06839","ref":"صحيح أبي داود 4087","text":[["ثلاثةٌ لا يُكَلِّمُهُمُ اللَّهُ ",2],"،",[" ولا ينظرُ إليهِم يَومَ القيامةِ ، ولا يُزَكِّيهم ، ولَهُم عذابٌ أليمٌ قلتُ : مَن هُم يا رسولَ اللَّهِ قد خابوا وخسِروا ؟ فأعادَها ثلاثًا ",1],"، قلتُ : مَن هُم خابوا وخسِروا ؟ فقالَ : المُسبِلُ ، والمنَّانُ ، والمُنفِّقُ سِلعتَهُ بالحَلفِ الكاذبِ - أوِ الفاجرِ"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مسلم (106)، وأبو داود (4087) واللفظ له، والترمذي (1211)، والنسائي (5333)، وابن ماجه (2208)، وأحمد (21356)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"pQG03Q8A"},{"id":"س-06862","fp":"83233556d2b5","stateId":245,"easy":"إذا أسبلت أو مننت أو نفّقت سلعتك بالحلف الكاذب ← لا ينظر الله إليك يوم القيامة","cause":"ولا يُزكِّيهم ، ولهم عذابٌ أليمٌ . قال : فقرأها رسولُ اللهِ ثلاثَ مراتٍ","result":"ثلاثةٌ لا ينظرُ اللهُ إليهم يومَ القيامةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-06839","ref":"صحيح الترغيب 1787","text":[["ثلاثةٌ لا ينظرُ اللهُ إليهم يومَ القيامةِ ",2],"،",[" ولا يُزكِّيهم ، ولهم عذابٌ أليمٌ . قال : فقرأها رسولُ اللهِ ثلاثَ مراتٍ ",1],"، فقلتُ : خابوا وخسِروا ، ومن هم يا رسولَ اللهِ ؟ قال : الْمُسبِلُ إزارَه ، والمنَّانُ عطاءَه ، والْمُنَفِّقُ سِلعتَه بالحلِفِ الكاذبِ"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مسلم (106) باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"FNrLzfVq"},{"id":"س-06871","fp":"d96bc2791f9d","stateId":245,"easy":"إذا مننت بعطائك أو أسبلت أو نفّقت سلعتك بالحلف الكاذب ← لا ينظر الله إليك","cause":"ولا يزكيهم، ولهم عذابٌ أليمٌ، الذي لا يعطي شيئًا إلا منه، والمسبلُ إزارَه، والمَنفِّقُ سلعتَه بالكذبِ","result":"ثلاثةٌ لا ينظر اللهُ إليهم يومَ القيامةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-06839","ref":"صحيح النسائي 4471","text":[["ثلاثةٌ لا ينظر اللهُ إليهم يومَ القيامةِ",2],"،",[" ولا يزكيهم، ولهم عذابٌ أليمٌ، الذي لا يعطي شيئًا إلا منه، والمسبلُ إزارَه، والمَنفِّقُ سلعتَه بالكذبِ",1]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مسلم (106)، وأبو داود (4087)، والترمذي (1211)، والنسائي (4459) واللفظ له، وابن ماجه (2208)، وأحمد (21356)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"ZoGUDDgh"},{"id":"س-07216","fp":"9c1a5e9d6d58","stateId":246,"easy":"إذا تزوجت مطلقة لتحلّها لزوجها (أو طلبت ذلك) ← لعنك الله","cause":"المُحلِّلَ والمُحلَّلَ له","result":"لعنَ اللهُ","explicit":true,"star":true,"ref":"رفع الملام 90","srcLabel":"السنة","text":["عبدُ اللهِ بنُ عمرَ رضيَ اللهُ عنهُما فإنَّه سُئِلَ عمَّن تزوَّجَها ليُحلَّها ، ولم تعلمْ بذلك المرأةُ ولا زوجُها ، فقال : هذا سِفاحٌ وليس بنكاحٍ ، ",["لعنَ اللهُ",2]," ",["المُحلِّلَ والمُحلَّلَ له",1]],"grade":"صحيح","muhaddith":"محفوظ عنه من غير وجه","bab":"علم › حسن السؤال ونصح العالم","dorar":"cIXdlknl","merged":7,"otherRefs":["الروضة الندية 2/17 (صحيح)","الفتاوى الكبرى 3/96 (صحيح)","فتح البيان 2/ 26 (صحيح)","المستدرك على الصحيحين 2844 (صحيح)","عمدة التفسير 1/283 (صحيح)"]},{"id":"س-05697","fp":"eeca749bff8f","stateId":246,"easy":"إذا كنت شيخاً زانياً أو ملكاً كذاباً أو فقيراً مختالاً ← لا يكلمك الله ولا ينظر إليك ولا يزكيك","cause":"شيخٌ زانٍ ، وملكٌ كذابٌ ، وفقيرٌ مختالٌ","result":"ثلاثةٌ لا يكلِّمهُم اللهُ ولا ينظرُ إليهم يومَ القيامةِ ولا يزكِّيهِم ولهم عذابٌ أليمٌ","explicit":true,"star":true,"similar":["س-06944"],"otherNeedIds":[57],"ref":"منهاج السنة 7/209","srcLabel":"السنة","text":[["ثلاثةٌ لا يكلِّمهُم اللهُ ولا ينظرُ إليهم يومَ القيامةِ ولا يزكِّيهِم ولهم عذابٌ أليمٌ ",2],":",[" شيخٌ زانٍ ، وملكٌ كذابٌ ، وفقيرٌ مختالٌ .",1]," وفي لفظٍ : عائلٌ مزهوٌّ وفي لفظٍ : وعائلٌ مستكبرٌ"],"grade":"صحيح","muhaddith":"صحيح","bab":"رقائق وزهد › الكبر والتواضع","dorar":"mMYQlYNH","merged":5,"otherRefs":["تخريج المسند لشعيب 9594 (صحيح)","صحيح النسائي 2574 (صحيح)","تخريج مشكل الآثار 3490 (حسن)","علل الدارقطني 2171 (صحيح)"]},{"id":"س-03605","fp":"a465f03a6aa5","stateId":246,"easy":"إذا أتيت النساء في أدبارهن ← فأنت ملعون","cause":"من يأتي النِّساءَ في محاشِّهِنَّ","result":"ملعونٌ مَلعونٌ","explicit":true,"star":true,"ref":"صحيح الجامع 6980","srcLabel":"السنة","text":["نَهَى عن مَحاشِّ النساءِ [حديث جابر: أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم نهى عن محاشِّ النِّساءِ]                                  [وحديث عقبة: ",["ملعونٌ مَلعونٌ",2]," ",["من يأتي النِّساءَ في محاشِّهِنَّ",1],"]"],"grade":"صحيح","narrator":"جابر بن عبدالله وعقبة بن عامر","muhaddith":"صحيح","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"gFJGcS1r","merged":3,"otherRefs":["نيل المرام 155 (صحيح)","عمدة التفسير 1/271 (صحيح)"]},{"id":"س-06914","fp":"15844d9cdf63","stateId":246,"easy":"إذا أتيت امرأتك في دبرها ← لا ينظر الله إليك","cause":"إنَّ الَّذي يأتي امرأتَهُ في دبُرِها","result":"لا ينظرُ اللَّهُ إليهِ","explicit":true,"star":true,"ref":"عمدة التفسير 1/271","srcLabel":"أبو داود","text":[["إنَّ الَّذي يأتي امرأتَهُ في دبُرِها",1]," ",["لا ينظرُ اللَّهُ إليهِ",2]," . وفي لفظٍ لهُ : مَلعونٌ من أتى امرأةً في دُبرِها"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أسانيده صحاح","takhrij":"أخرجه أحمد (7684) واللفظ له، وابن ماجه (1923) باختلاف يسير. واللفظ أخرجه أبو داود (2162) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"jFW52CYB","merged":3,"otherRefs":["تخريج مشكل الآثار 6133 (صحيح)","صحيح الترغيب 2424 (صحيح)"]},{"id":"س-05118","fp":"be1d701da94e","stateId":246,"easy":"إذا وطئت أمة حاملاً من غيرك ← تستحق لعنة تدخل معك قبرك","cause":"لعلَّ صاحِبَ هذه أنْ يُلِمَّ بها","result":"لقد هَمَمتُ أنْ ألعَنَه لَعنةً تدخُلُ معه قبرَه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-00817"],"ref":"تخريج مشكل الآثار 1423","srcLabel":"مسلم","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ رَأى امرأَةً عندَ خِباءٍ أو عندَ فُسطاطٍ مُجِخًّا، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["لعلَّ صاحِبَ هذه أنْ يُلِمَّ بها",1],"، ",["لقد هَمَمتُ أنْ ألعَنَه لَعنةً تدخُلُ معه قبرَه",2],"، كيف يُورِّثُه وهو لا يَحِلُّ له؟ وكيف يَسترِقُّه وهو لا يَحِلُّ له؟."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أبو داود (2156)، وأحمد (21703)، والدارمي (2521) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"DSPklRIJ"},{"id":"س-06901","fp":"3502da520fb6","stateId":246,"easy":"إذا كنت شيخاً زانياً أو عجوزاً زانية ← لا ينظر الله إليك يوم القيامة","cause":"الشَّيخِ الزَّاني ، ولا العجوزُ الزَّانيةُ","result":"لا ينظرُ اللهُ يومَ القيامةِ إلى","explicit":true,"ref":"صحيح الترغيب 2396","srcLabel":"مسلم","text":[["لا ينظرُ اللهُ يومَ القيامةِ إلى",2],[" الشَّيخِ الزَّاني ، ولا العجوزُ الزَّانيةُ",1]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((الأوسط)) (8401) واللفظ له، ومسلم (107)، والنسائي (2575) بنحوه مطولًا.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"O2vdjLT1"},{"id":"س-00371","fp":"31867af0b9e1","stateId":246,"easy":"إذا عملت عمل قوم لوط ← لعنك الله","cause":"من عمِل عمَلَ قومِ لوطٍ","result":"ولعَن اللهُ","explicit":true,"ref":"صحيح ابن حبان 4417","srcLabel":"أحمد","text":["لعَن اللهُ مَن ذبَح لغيرِ اللهِ ",["ولعَن اللهُ",2]," مَن غيَّر تُخومَ الأرضِ ولعَن اللهُ مَن كَمَهَ الأعمى عن السَّبيلِ ولعَن اللهُ مَن سبَّ والدَيهِ ولعَن اللهُ مَن تولَّى غيرَ مواليه ولعَن اللهُ ",["من عمِل عمَلَ قومِ لوطٍ",1]," ) قالها ثلاثًا في عمَلِ قومِ لوطٍ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (2816)، والطبراني (11/218) (11546)، والحاكم (8052) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"uM3xrugw"},{"id":"س-01322","fp":"77146592f356","stateId":246,"easy":"إذا أتيت النساء في أدبارهن ← لعنك الله","cause":"الذين يأتون النِّساءَ في محاشِّهنَّ","result":"لعن اللهُ","explicit":true,"ref":"صحيح الترغيب 2429","srcLabel":"الطبراني","text":[["لعن اللهُ",2],[" الذين يأتون النِّساءَ في محاشِّهنَّ",1]],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"حسن صحيح","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (3/ 84)، وابن أبي حاتم في ((العلل)) (1229)، والطبراني في ((المعجم الأوسط)) (1931) واللفظ لهم.","bab":"نكاح › عشرة النساء","dorar":"YxZaFrRG"},{"id":"س-05151","fp":"7763a0df3410","stateId":246,"easy":"إذا وقعت على بهيمة ← لعنك الله","cause":"مَن وقَعَ على بَهيمةٍ","result":"لَعَن اللهُ","explicit":true,"ref":"المستدرك على الصحيحين 8265","srcLabel":"النسائي","text":["عن النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، وزاد فيه: ",["لَعَن اللهُ",2]," ",["مَن وقَعَ على بَهيمةٍ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد ولم يخرجاه","takhrij":"أخرجه أحمد (2913)، والنسائي ((السنن الكبرى)) (7299)، والطبراني (11546) (11/  218)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ZP8iy0oa"},{"id":"س-05222","fp":"671604df9ee6","stateId":246,"easy":"إذا وطئت أمة حبلى (من غيرك) ← فلست منا","cause":"وَطِئَ حُبْلَى","result":"ليس منَّا من","explicit":true,"ref":"تخريج المسند لشاكر 4/90","srcLabel":"أحمد","text":[["ليس منَّا من",2],[" وَطِئَ حُبْلَى",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (2318)، وابن أبي شيبة (17748)، وأبو يعلى (2522)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"RWoSlvW2"},{"id":"س-06944","fp":"09e9da9b8d54","stateId":246,"easy":"إذا كنت شيخاً زانياً أو فقيراً متكبراً ← لا ينظر الله إليك","cause":"الأُشَيْمِطِ الزَّانِي ، ولا العائلِ المَزْهُوِّ","result":"لا ينظرُ اللهُ إلى","explicit":true,"repOf":"س-05697","ref":"صحيح الترغيب 2399","text":[["لا ينظرُ اللهُ إلى",2],[" الأُشَيْمِطِ الزَّانِي ، ولا العائلِ المَزْهُوِّ",1]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه مطولاً الروياني في ((المسند)) (1408)، والطبراني (12/306) (13195) واللفظ له، والخطيب في ((الموضح)) (2/507)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"sTrRLb91"},{"id":"س-00817","fp":"4199666709de","stateId":246,"easy":"إذا وطئت أمة حاملاً من غيرك ← تستحق لعنة تدخل معك قبرك","cause":"امرأةً مُجِحَّةً، فقالَ: لعلَّ صاحِبَها أَلَمَّ بها","result":"لقد هَمَمْتُ أنْ أَلعَنَه لَعنةً تَدخُلُ معه في قبرِه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-05118","ref":"المستدرك على الصحيحين 2828","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ كان في غَزْوةٍ، فرَأى ",["امرأةً مُجِحَّةً، فقالَ: لعلَّ صاحِبَها أَلَمَّ بها",1],"، قالوا: نَعَمْ، قالَ: ",["لقد هَمَمْتُ أنْ أَلعَنَه لَعنةً تَدخُلُ معه في قبرِه",2],"، كيف يُورِّثُه وهو لا يَحِلُّ له؟ وكيف يَستَخدِمُه وهو لا يَحِلُّ له؟"],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (2156)، وأحمد (21703)، والدارمي (2521) باختلاف يسير.","bab":"أدعية وأذكار › دعاء النبي على بعض الأشخاص والأشياء والأمور","dorar":"8KXV9pOU"},{"id":"س-04897","fp":"160f2e7dd065","stateId":246,"easy":"إذا أدخلت المرأة على قوم ولداً ليس منهم ← اشتد غضب الله عليها","cause":"امرأةٍ أدخلتْ على قومٍ ولدًا ليس منهمْ، يَطَّلعُ على عوراتِهم، ويشركُهم في أموالِهم","result":"اشتدَ غضبُ اللهِ على","explicit":true,"ref":"الجامع الصغير 1038","srcLabel":"الطبراني","text":[["اشتدَ غضبُ اللهِ على",2]," ",["امرأةٍ أدخلتْ على قومٍ ولدًا ليس منهمْ،  يَطَّلعُ على عوراتِهم،  ويشركُهم في أموالِهم",1]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن","takhrij":"أخرجه البزار كما في ((كشف الأستار)) لابن حجر (1386) واللفظ له، والخرائطي في ((مساوئ الأخلاق)) (460)، والطبراني في ((المعجم الأوسط)) (4694) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"WjjLpauN"},{"id":"س-06833","fp":"a7c968d1bbfe","stateId":246,"easy":"إذا كنت شيخاً زانياً أو اتخذت الأيمان بضاعة أو فقيراً مختالاً ← لا ينظر الله إليك غداً","cause":"شيْخٌ زانٍ ، و رجُلٌ اتَّخَذَ الأيْمانَ بِضاعَةً يَحلِفُ في كُلِّ حقٍّ و باطِلٍ ، و فقيرٌ مُختالٌ يَزْهُو","result":"ثلاثةٌ لا يَنظُرُ اللهُ إليهِمْ غدًا","explicit":true,"ref":"صحيح الجامع 3070","srcLabel":"الطبراني","text":[["ثلاثةٌ لا يَنظُرُ اللهُ إليهِمْ غدًا ",2],":",[" شيْخٌ زانٍ ، و رجُلٌ اتَّخَذَ الأيْمانَ بِضاعَةً يَحلِفُ في كُلِّ حقٍّ و باطِلٍ ، و فقيرٌ مُختالٌ يَزْهُو",1]],"grade":"حسن","narrator":"عصمة بن مالك الخطمي","muhaddith":"حسن","takhrij":"أخرجه الطبراني (17/184) (492)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"K2rPldYZ"},{"id":"س-08294","fp":"759a5458028f","stateId":246,"easy":"إذا وصفت المرأة امرأة أخرى لزوجها حتى كأنه يراها ← لعنها الله","cause":"المرأةَ تصفُ المرأةَ لزوجِها حتى كأنه ينظرُ إليها","result":"لعن اللهُ","explicit":true,"ref":"القبس 2/782","srcLabel":"السنة","text":[["لعن اللهُ",2],[" المرأةَ تصفُ المرأةَ لزوجِها حتى كأنه ينظرُ إليها",1]],"grade":"حسن","muhaddith":"لا بأس به","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"1qvzThF6"},{"id":"س-06948","fp":"236fb3ba0b64","stateId":246,"easy":"إذا كنت شيخاً زانياً أو فقيراً مستكبراً ← لا ينظر الله إليك يوم القيامة","cause":"و لا يُزكِّيهِمْ ؛ و لَهُمْ عذابٌ أليمٌ : أُشَيْمِطٌ زانٍ . و عائِلٌ مُستكْبِرٌ ، ورجلٌ جعلَ اللهَ بِضاعتَهُ لا يَشترِي إلَّا بِيمينِه ، و لا يَبيعُ إلَّا بِيمينِهِ","result":"ثلاثةٌ لا يَنظرُ اللهُ إليهِمْ يومَ القِيامةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[57],"ref":"صحيح الجامع 3072","srcLabel":"الطبراني","text":[["ثلاثةٌ لا يَنظرُ اللهُ إليهِمْ يومَ القِيامةِ ",2],"؛",[" و لا يُزكِّيهِمْ ؛ و لَهُمْ عذابٌ أليمٌ : أُشَيْمِطٌ زانٍ . و عائِلٌ مُستكْبِرٌ ، ورجلٌ جعلَ اللهَ بِضاعتَهُ لا يَشترِي إلَّا بِيمينِه ، و لا يَبيعُ إلَّا بِيمينِهِ",1]],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الصغير)) (821)، والبيهقي في ((شعب الإيمان)) (4852)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"O6V2Ctdw","merged":2,"otherRefs":["فتاوى نور على الدرب لابن باز 19/97 (صحيح)"]},{"id":"س-06937","fp":"2c961984eb47","stateId":246,"easy":"إذا خلفت مجاهداً في أهله بسوء ← يغار الله عليه منك","cause":"رجلٍ مُجَاهِدٍ في سبيلِ اللهِ يخالَفُ إلى أهْلِهِ","result":"على أيِّ شَيْءٍ يَغارُ اللهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"مجمع الزوائد 4/331","srcLabel":"أحمد","text":["حضر رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ سَعْدَ بْنَ عبادةَ فقال يا رسولَ اللهِ إنْ وَجدتُّ علَى بطنِ امرأَتِي رجلًا أضْرِبُهُ بسَيْفِي قال أَيُّ بَيِّنَةٍ أَبْيَنُ مِنَ السيفِ قال ثمَّ رجعَ عن قولِهِ فقال كتابُ اللهِ والشهداءُ قال سعدٌ يا رسولَ اللهِ أيُّ بَيِّنَةٍ أَبْيَنُ منَ السيفِ قال كتابُ اللهِ والشهداءُ أيَا مَعْشَرَ الأنصارِ هَذَا سَيِّدُكُمْ اسَتَفَزَّتْهُ الغَيْرَةُ حَتَّى خَالَفَ كتابَ اللهِ قال فقالَ رجلٌ يا رسولَ اللهِ إنَّ سَعْدًا غَيُورٌ ومَا طَلَّقَ امْرَأَةً قَطُّ قَدَرَ أحَدُ مِنَّا أَنْ يَتَزَوَّجَهَا لِغَيْرَتِهِ قَالَ فَقَالَ رَسُولُ اللهِ صلَّى اللهُ عليه وسلَّمَ سعدٌ غَيُورٌ وأنَا أَغْيَرُ مِنْهُ واللهُ أَغْيَرُ مِنِّي قَالَ رجلٌ ",["على أيِّ شَيْءٍ يَغارُ اللهُ",2]," قال على ",["رجلٍ مُجَاهِدٍ في سبيلِ اللهِ يخالَفُ إلى أهْلِهِ",1]],"grade":"حسن","narrator":"عمرو بن سعيد بن سعد بن عبادة","muhaddith":"رجاله ثقات","takhrij":"أخرجه أحمد (39/ 448) واللفظ له .","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"YyZjXf0b"},{"id":"س-04780","fp":"6ed69eab7837","stateId":247,"easy":"إذا عصرت الخمر أو شربتها أو سقيتها أو حملتها أو بعتها ← لُعنت","cause":"في الخَمْرةِ عَشَرةً: عاصِرَها، والمعصورةَ له، وشارِبَها، وساقِيَها، والمُسقى له، وحامِلَها، والمحمولةَ له، والمُشتَرِيَ، والمُشتَرى لها، وآكِلَ ثَمَنِها","result":"لعَنَ","explicit":true,"star":true,"ref":"الأحاديث المختارة 2189","srcLabel":"البخاري","text":["«أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم ",["لعَنَ",2]," ",["في الخَمْرةِ عَشَرةً: عاصِرَها، والمعصورةَ له، وشارِبَها، وساقِيَها، والمُسقى له، وحامِلَها، والمحمولةَ له، والمُشتَرِيَ، والمُشتَرى لها، وآكِلَ ثَمَنِها",1],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"2flNh8Q1","merged":11,"otherRefs":["رفع الملام 64 (صحيح)","مجموع فتاوى ابن باز 433/4 (صحيح)","تخريج مشكل الآثار 3343 (صحيح)","تخريج زاد المعاد 5/49 (صحيح)","صحيح الجامع 72 (صحيح)","إتقان ما يحسن 2/439 (صحيح)","حديث المساء 214 (صحيح)","هداية الرواة 2707 (صحيح)","تخريج شرح السنة 8/31-32 (صحيح)","تنقيح التحقيق 4/88 (حسن)"]},{"id":"س-02966","fp":"8e89fe3ec49d","stateId":247,"easy":"إذا شربت الخمر ← لا يرضى الله عنك أربعين ليلة","cause":"مَن شَرِبَ الخمْرَ","result":"لم يَرْضَ اللهُ عنه أربعينَ ليلةً، فإنْ ماتَ، ماتَ كافِرًا، وإنِ تابَ، تابَ اللهُ عليْهِ، وإنْ عادَ، كانَ حقًّا على اللهِ أن يَسقِيَهُ من طِينَةِ الخَبالِ","explicit":true,"otherNeedIds":[45],"ref":"تخريج المسند لشعيب 27603","srcLabel":"أحمد","text":[["مَن شَرِبَ الخمْرَ، ",1],["لم يَرْضَ اللهُ عنه أربعينَ ليلةً، فإنْ ماتَ، ماتَ كافِرًا، وإنِ تابَ، تابَ اللهُ عليْهِ، وإنْ عادَ، كانَ حقًّا على اللهِ أن يَسقِيَهُ من طِينَةِ الخَبالِ",2],". قالَتْ: قُلتُ: يا رسولَ اللهِ، وما طينَةُ الخَبالِ؟ قالَ: صديدُ أهْلِ النَّارِ."],"grade":"صحيح","narrator":"أسماء بنت يزيد أم سلمة الأنصارية","muhaddith":"صحيح لغيره دون قوله: \"فإن مات مات كافرا\"","takhrij":"أخرجه أحمد (27603) واللفظ له، والطبراني (24/168) (428)","bab":"إيمان › الوعيد","dorar":"WTXUbgZ9","merged":2,"otherRefs":["تخريج المسند لشعيب 4917 (حسن)"]},{"id":"س-05090","fp":"fa5afcfa9de4","stateId":248,"easy":"إذا سمعت النداء ثم لم تأتِ الصلاة ← استحققت أن يُحرّق عليك بيتك","cause":"يَسمَعون النِّداءَ، ثم لا يَأتون الصَّلاةَ","result":"فأُحرِّقَ على قَومٍ في بُيوتِهم","explicit":true,"star":true,"otherNeedIds":[49,12],"ref":"تخريج المسند لشعيب 10962","srcLabel":"متفق عليه","text":["لقد همَمتُ أنْ آمُرَ بالصَّلاةِ فتُقامَ، ثم أخرُجَ بفِتْياني، معهم حُزَمُ الحَطَبِ، ",["فأُحرِّقَ على قَومٍ في بُيوتِهم",2]," ",["يَسمَعون النِّداءَ، ثم لا يَأتون الصَّلاةَ",1],". فسُئِلَ يَزيدُ: أفي الجُمُعةِ هذا أم في غَيرِها؟ قال: ما سمِعتُ أبا هُرَيرةَ يَذكُرُ جُمُعةً، ولا غَيرَها، إلَّا هكذا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أبو داود (549) باختلاف يسير، وأخرجه البخاري (644)، ومسلم (651) بلفظ مقارب","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"GIukh0K1","merged":4,"otherRefs":["تخريج المسند لشعيب 4297 (صحيح)","شرح ابن ماجه لمغلطاي 3/253 (صحيح)","صحيح ابن خزيمة 3/ 312 (صحيح)"]},{"id":"س-06677","fp":"548e921351eb","stateId":248,"easy":"إذا قطعت صفاً ← يقطعك الله","cause":"ومَن قطَعَ صفًّا","result":"قطَعَه اللهُ","explicit":true,"star":true,"ref":"تخريج سنن أبي داود 666","srcLabel":"أبو داود","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال: أَقيموا الصُّفوفَ، وحاذُوا بينَ المَناكِبِ، وسُدُّوا الخَلَلَ، ولِينوا بأَيدي إخوانِكم -لم يقُلْ عيسى: بأَيدي إخوانِكم-، ولا تَذَروا فُرُجاتٍ للشيطانِ، ومَن وصَلَ صفًّا وصَلَه اللهُ، ",["ومَن قطَعَ صفًّا",1]," ",["قطَعَه اللهُ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (666)، وأحمد (5724)، والطبراني (13/ 319) (14113) بلفظه.","bab":"صلاة الجماعة والإمامة › إقامة الصفوف ووصلها وفضائلها","dorar":"i7rw8Xc6","merged":3,"otherRefs":["إصلاح المساجد 85 (صحيح)","صحيح الجامع 1187 (صحيح)"]},{"id":"س-05189","fp":"ef3c954f8d29","stateId":248,"easy":"إذا تركت الصلاة ← تلقى الله وهو عليك غضبان","cause":"مَن ترك الصلاةَ","result":"لقِيَ اللهَ وهو عليه غضبانُ","explicit":true,"star":true,"similar":["س-05201"],"ref":"مجمع الزوائد 1/300","srcLabel":"الطبراني","text":["لما قام بَصَرِي قيل نُداوِكَ وتدعُ الصلاةَ أيامًا قال لا إن رسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال ",["مَن ترك الصلاةَ ",1],["لقِيَ اللهَ وهو عليه غضبانُ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"فيه سهل بن محمود لم يتكلم فيه أحد وبقية رجاله رجال الصحيح","takhrij":"أخرجه ابن سعد في ((الطبقات الكبرى)) (26)، والطبراني (11/294) (11782)، والبيهقي (3835) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Pjdz6FSH"},{"id":"س-06475","fp":"0932d88f8a3d","stateId":248,"easy":"إذا تركت الصلاة متعمداً ← برئت منك الذمة","cause":"فمن تركَها متعمِّدًا","result":"فقدْ برِئَتْ منه الذِّمَّةُ ، ولا تشربِ الخمرَ ، فإِنَّها مفتاحُ كلِّ شَرٍّ","explicit":true,"similar":["س-06431","س-06441"],"ref":"صحيح الجامع 7339","srcLabel":"ابن ماجه","text":["لا تشركْ باللهِ شيئًا ، وإِنَّ قُطِّعْتَ ، وحُرِّقْتَ ، ولا تترُكْ صلاةً مكتوبَةً متعمدًا ، ",["فمن تركَها متعمِّدًا ",1],["فقدْ برِئَتْ منه الذِّمَّةُ ، ولا تشربِ الخمرَ ، فإِنَّها مفتاحُ كلِّ شَرٍّ",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (4034) واللفظ له، والبزار (4148)، والبيهقي في ((شعب الإيمان)) (5200) باختلاف يسير","bab":"صلاة › فرض الصلاة","dorar":"pQfEp7PG"},{"id":"س-06894","fp":"e9469b2f6a49","stateId":248,"easy":"إذا التفتّ في صلاتك ← يعرض الله عنك","cause":"فإذا التفتَ","result":"أعرضَ اللَّهُ عنهُ","explicit":true,"otherNeedIds":[45],"ref":"مختصر الصواعق المرسلة 419","srcLabel":"البزار","text":["إذا قامَ العبدُ يصلِّي أقبلَ اللَّهُ عليهِ بوجهِهِ ، ",["فإذا التفتَ",1]," ",["أعرضَ اللَّهُ عنهُ",2]," وقالَ : يا بن آدمَ أَنا خيرٌ مِمَّن تلتفتُ إليهِ ، فإذا أقبلَ على صلاتِهِ أقبلَ اللَّهُ عليهِ ، فإذا التفتَ أعرضَ اللَّهُ عنهُ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه البزار كما في ((الترغيب والترهيب)) (1/209) باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"yTVNt2mr"},{"id":"س-01536","fp":"cda89caa5324","stateId":248,"easy":"إذا تخلفت عن صلاة الجماعة بلا عذر ← هَمّ النبي ﷺ بتحريق البيوت على أمثالك","cause":"أقوامًا لا يَشهَدونَ الصَّلاةَ","result":"فأُحَرِّقَ عليهم","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[49],"ref":"تخريج مشكل الآثار 5879","srcLabel":"الطحاوي","text":["أنَّ ابنَ أُمِّ مَكتومٍ قال لرسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّ بَيْني وبيْنَ المسجِدِ أشياءَ، ورُبَّما وجَدْتُ قائدًا، ورُبَّما لم أجِدْ، قال: ألستَ تَسمَعُ النِّداءَ؟ قُلْتُ: بَلى، قال: فإذا سمِعْتَ النِّداءَ فامْشِ إليها، ثُم سأَلَه رَجلٌ آخَرُ عن مِثلِ ذلك؟ فقال: فإذا سمِعْتَ النِّداءَ فآذِنْ، ولم يُرخِّصْ له، ثُم قال: لقد همَمْتُ آنْ آمُرَ رَجلًا يُصلِّي بالنَّاسِ، ثُم آتيَ ",["أقوامًا لا يَشهَدونَ الصَّلاةَ",1],"، ",["فأُحَرِّقَ عليهم",2],"."],"grade":"صحيح","narrator":"عبدالله بن شداد بن الهاد","muhaddith":"صحيح","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (5879) واللفظ له.","bab":"أذان › من سمع النداء لزمته الإجابة","dorar":"XOh8CJhg","merged":2,"otherRefs":["تخريج مشكل الآثار 5865 (صحيح)"]},{"id":"س-05201","fp":"ba246f7b9789","stateId":248,"easy":"إذا تركت الصلاة وأنت مستطيع ← تلقى الله وهو عليك غضبان","cause":"من ترك صلاةً وهو يستطيعُ أن يُصلِّيَ","result":"لَقي اللهُ وهو عليه غضبانُ","explicit":true,"repOf":"س-05189","ref":"المهذب في اختصار السنن 2/747","text":["أنَّ ابنَ عبَّاسٍ لمَّا سقط في عينَيْه الماءُ أراد أن يُخرِجَه من عينَيْه فقيل : إنَّك تستلقي سبعةَ أيَّامٍ لا تُصلِّي إلَّا مُستلقِيًا فكرِه ذلك . وقال : إنَّه بلَغني أنَّه ",["من ترك صلاةً وهو يستطيعُ أن يُصلِّيَ ",1],["لَقي اللهُ وهو عليه غضبانُ ",2],"."],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن سعد في ((الطبقات الكبرى)) (26)، والطبراني (11/294) (11782)، والبيهقي (3835) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"o7wsepYR"},{"id":"س-06431","fp":"e521378394a2","stateId":248,"easy":"إذا تركت الصلاة متعمداً ← برئت منك ذمة رسول الله ﷺ","cause":"و لا تَتْرُكَنَّ صَّلاةَ مُتَعَمِّدًا ، فمَنْ فعلَ ذلكَ","result":"فقد بَرِئَتْ مِنْهُ ذِمَّةُ رَسُولِه","explicit":true,"repOf":"س-06475","ref":"صحيح الترغيب 571","text":["لا تُشْرِكْ باللهِ شيئًا ، و إنْ قُطِّعْتَ و حُرِّقْتَ ، و لا تَعْصِ و الدَيْكَ ، وإنْ أمرَاكَ أنْ تُخَلِّيَ من أهلِكَ ودُنياكَ فتخلَ ، ولا تشربنَ خمرًا ، فإِنَّها مِفْتَاحُ كلِّ شَرٍّ ، ",["و لا تَتْرُكَنَّ صَّلاةَ مُتَعَمِّدًا ، فمَنْ فعلَ ذلكَ",1]," ",["فقد بَرِئَتْ مِنْهُ ذِمَّةُ رَسُولِه",2]," الحديث"],"grade":"حسن","narrator":"أميمة مولاة النبي وقيل هي أم أيمن","muhaddith":"حسن لغيره","bab":"صلاة › تارك الصلاة","dorar":"ZhFLBH14"},{"id":"س-06441","fp":"17beefc36aaa","stateId":248,"easy":"إذا تركت الصلاة متعمداً ← برئت منك ذمة الله","cause":"فإنَّ مَن ترَكَ الصَّلاةَ مُتعمِّدًا","result":"فقد برئَت منهُ ذمَّةُ اللَّهِ","explicit":true,"repOf":"س-06475","ref":"الترغيب والترهيب 1/262","text":["أتى رسولَ اللَّهِ - صلَّى اللَّهُ عليهِ وسلَّمَ - رجلٌ فقالَ : يا رسولَ اللَّهِ علِّمني عَملًا إذا أَنا عَمِلْتُهُ دخلتُ الجنَّةَ ، قالَ : لا تُشرِكْ باللَّهِ شيئًا وإن عُذِّبتَ وحرِّقتَ ، وأطِعْ والدَيكَ وإن أخرجاكَ من مالِكِ ومن كلِّ شيءٍ هوَ لَك ، لا تَترُكْ الصَّلاةَ متعمِّدًا ",["فإنَّ مَن ترَكَ الصَّلاةَ مُتعمِّدًا",1]," ",["فقد برئَت منهُ ذمَّةُ اللَّهِ",2]],"grade":"حسن","narrator":"معاذ بن جبل","muhaddith":"لا بأس بإسناده في المتابعات","takhrij":"أخرجه الطبراني (20/82) (156)","bab":"صلاة › تارك الصلاة","dorar":"C3ngSeeZ"},{"id":"س-03088","fp":"d7158ae33aad","stateId":248,"easy":"إذا تخلفت عن صلاة العشاء في الجماعة ← استحققت التهديد بالتحريق","cause":"لا يَشهَدون العِشاءَ الآخِرَةَ في الجَميعِ","result":"أو لَأَحرِقَنَّ حوْلَ بُيوتِهم بِحُزَمِ الحَطَبِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-02973"],"otherNeedIds":[49],"ref":"تخريج المسند لشعيب 7916","srcLabel":"متفق عليه","text":["لَيَنتَهِيَنَّ رِجالٌ ممَّن حوْلَ المَسجِدِ ",["لا يَشهَدون العِشاءَ الآخِرَةَ في الجَميعِ",1],"، ",["أو لَأَحرِقَنَّ حوْلَ بُيوتِهم بِحُزَمِ الحَطَبِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (657)، ومسلم (651)، والنسائي (848)، وابن ماجه (791) بمعناه مطولاً، وأبو داود (548)، والترمذي (217) بمعناه، وأحمد (7916) واللفظ له","bab":"إيمان › الوعيد","dorar":"O5DCbNPv"},{"id":"س-01540","fp":"adcf7f5a9392","stateId":248,"easy":"إذا سمعت النداء فلم تجب ← هَمّ النبي ﷺ أن يضرمها عليك ناراً","cause":"قومٍ سمعوا النِّداءَ فلم يجيبوا","result":"فأُضرِمَها عليهم نارًا","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[49],"ref":"مجمع الزوائد 2/46","srcLabel":"الطبراني","text":["لو أنَّ رجلًا دعا النَّاسَ إلى عرقٍ أو مرماتينِ لأجابوهُ وَهم يُدعونَ إلى هذِه الصَّلاةِ في جماعةٍ فلا يأتونَها لقد هممتُ أن آمرَ رجلًا أن يصلِّيَ بالنَّاسِ في جماعةٍ ثمَّ أنصرفَ إلى ",["قومٍ سمعوا النِّداءَ فلم يجيبوا",1]," ",["فأُضرِمَها عليهم نارًا",2]," إنَّهُ لا يتخلَّفُ عنها إلَّا منافقٌ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"رجاله موثقون","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (2763)","bab":"أذان › من سمع النداء لزمته الإجابة","dorar":"mCkHPu9j"},{"id":"س-02973","fp":"6add236b5837","stateId":248,"easy":"إذا تخلفت عن الصلاة ← استحققت التهديد بالتحريق","cause":"رَجلٍ تَخلَّفَ عنِ الصَّلاةِ","result":"إلَّا أحرَقْتُ عليه بيتَه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03088","otherNeedIds":[49],"ref":"تخريج مشكل الآثار 5878","text":["خرَجَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ منَ المسجِدِ، فرَأى في النَّاسِ رِقَّةً، فقال: إنِّي لأَهُمُّ أنْ أجعَلَ للناسِ إمامًا، ثُم أخرُجُ، فلا أَقدِرُ على ",["رَجلٍ تَخلَّفَ عنِ الصَّلاةِ",1]," ",["إلَّا أحرَقْتُ عليه بيتَه",2],"، فقُلْتُ: يا رسولَ اللهِ، إنِّي بَيْني وبيْنَ المسجِدِ نَخلًا، وشَجرًا، وليس كلُّ وقتٍ أَقدِرُ على قائدٍ، أفأُصلِّي في بَيْتي؟ فقال: تَسمَعُ الإقامةَ؟ قُلْتُ: نَعَمْ، قال: فائْتِها."],"grade":"صحيح","narrator":"عبدالله بن أم مكتوم","muhaddith":"صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (5878) بلفظه، وأبو داود (552) مختصرا والنسائي (851) بمعناه","bab":"إيمان › الوعيد","dorar":"hqWhWT98","merged":2,"otherRefs":["صحيح البخاري 657 (صحيح)"]},{"id":"س-03878","fp":"d27596c45357","stateId":248,"easy":"إذا لم توتر ← فليس منا","cause":"فمَنْ لمْ يُوتِرْ","result":"فليسَ مِنَّا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"عمدة القاري 7/16","srcLabel":"السنة","text":["الوَتْرُ حقٌّ ",["فمَنْ لمْ يُوتِرْ",1]," ",["فليسَ مِنَّا",2],"، الوَتْرُ حقٌّ فمَنْ لمْ يُوتِرْ فليسَ مِنَّا، الوَتْرُ حقٌّ فمَنْ لمْ يُوتِرْ فليسَ مِنَّا."],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"صحيح","bab":"تراويح وتهجد وقيام ليل › فضل قيام الليل","dorar":"khMEqExD","merged":2,"otherRefs":["شرح فتح القدير 1/438 (حسن)"]},{"id":"س-02921","fp":"a895cc751be4","stateId":248,"easy":"إذا تركت الجماعة ← استحققت التهديد بالتحريق","cause":"تَرْكِ الجماعةِ","result":"أو لَأُحرِّقَنَّ بيوتَهم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[49],"ref":"صحيح الترغيب 433","srcLabel":"ابن ماجه","text":["لَينتهِينَّ رجالٌ عن ",["تَرْكِ الجماعةِ",1]," ، ",["أو لَأُحرِّقَنَّ بيوتَهم",2]],"grade":"صحيح","narrator":"أسامة بن زيد","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (795) واللفظ له، وأحمد (21792)","bab":"إيمان › الوعيد","dorar":"926UQHuH"},{"id":"س-08316","fp":"8f0ec3617664","stateId":249,"easy":"إذا توليت مولى بغير إذن مواليه ← فعليك لعنة الله والملائكة والناس","cause":"ومَن تولَّى مَوْلًى بغيْرِ إذْنِهم","result":"فعليه لعنةُ اللهِ والملائكةِ والنَّاسِ أَجمَعينَ، لا يُقبَلُ منه يومَ القِيامةِ صَرْفٌ، ولا عَدْلٌ","explicit":true,"star":true,"otherNeedIds":[45],"ref":"تخريج المسند لشعيب 1298","srcLabel":"متفق عليه","text":["عنِ الحارثِ بنِ سُوَيدٍ، قال: قيل لعليٍّ: إنَّ رسولَكم كان يخُصُّكم بشيءٍ دونَ النَّاسِ عامَّةً، قال: ما خصَّنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بشيءٍ لم يخُصَّ به النَّاسَ، إلا بشيءٍ في قِرابِ سَيْفي هذا، فأَخرَج صَحيفةً فيها شيءٌ من أسنانِ الإبلِ، وفيها: إنَّ المدينةَ حَرَمٌ ممَّا بيْنَ  ثَوْرٍ إلى عائرٍ، مَن أحدَث فيها حدَثًا، أو آوَى مُحدِثًا، فإنَّ عليه لَعنةَ اللهِ والملائكةِ والنَّاسِ أَجمَعينَ، لا يُقبَلُ منه يومَ القِيامةِ صَرْفٌ، ولا عَدْلٌ، وذِمَّةُ المُسلِمينَ واحدةٌ؛ فمَن أخفَر مُسلِمًا فعليه لعنةُ اللهِ والملائكةِ والنَّاسِ أَجمَعينَ، لا يُقبَلُ منه يومَ القِيامةِ صَرْفٌ، ولا عَدْلٌ، ",["ومَن تولَّى مَوْلًى بغيْرِ إذْنِهم ",1],["فعليه لعنةُ اللهِ والملائكةِ والنَّاسِ أَجمَعينَ، لا يُقبَلُ منه يومَ القِيامةِ صَرْفٌ، ولا عَدْلٌ",2],"."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (3179)، ومسلم (1370)، وأبو داود (2034)، والنسائي في ((السنن الكبرى)) (8681)، وأحمد (1298) واللفظ له","bab":"مناقب وفضائل › علي بن أبي طالب","dorar":"AL2alcqH","merged":3,"otherRefs":["تخريج المسند لشعيب 1037 (صحيح)","المستدرك على الصحيحين 8017 (صحيح)"]},{"id":"س-00155","fp":"0f2bd03dd50c","stateId":249,"easy":"إذا لم تقبّل أولادك ← فقد نزع الله الرحمة من قلبك","cause":"فما نُقَبِّلُهم","result":"نَزَعَ اللهُ مِن قَلبِكَ الرَّحمةَ","explicit":true,"star":true,"ref":"صحيح البخاري 5998","srcLabel":"متفق عليه","text":["جاءَ أعرابيٌّ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم فقال: تُقَبِّلونَ الصِّبيانَ؟ ",["فما نُقَبِّلُهم",1],"، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: أوأملِكُ لكَ أن ",["نَزَعَ اللهُ مِن قَلبِكَ الرَّحمةَ",2],"!"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (90) باختلاف يسير، ومسلم \n(2317)، وابن ماجه (3665) كلاهما بنحوه.","bab":"آداب السلام › تقبيل الرجل لولده","dorar":"KSEgeOhy","merged":2,"otherRefs":["صحيح الأدب المفرد 67 (صحيح)"]},{"id":"س-05112","fp":"2252f156e5d0","stateId":249,"easy":"إذا باتت المرأة هاجرة فراش زوجها ← تلعنها الملائكة حتى ترجع","cause":"إذا باتَتِ المرْأَةُ هاجِرَةً فِراشَ زَوْجِها","result":"باتَتْ تَلْعَنُها الـمَلائِكةُ -قال ابنُ جَعْفَرٍ- حتى تَرْجِعَ","explicit":true,"star":true,"similar":["س-08114"],"ref":"تخريج المسند لشعيب 7471","srcLabel":"متفق عليه","text":[["إذا باتَتِ المرْأَةُ هاجِرَةً فِراشَ زَوْجِها؛ ",1],["باتَتْ تَلْعَنُها الـمَلائِكةُ -قال ابنُ جَعْفَرٍ- حتى تَرْجِعَ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناداه صحيحان على شرط الشيخين","takhrij":"أخرجه البخاري (5194)، ومسلم (1436)، والنسائي في ((السنن الكبرى)) (8970)، وأحمد (7471) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"oEb3Mz3u","merged":2,"otherRefs":["تخريج المسند لشعيب 8579 (صحيح)"]},{"id":"س-08114","fp":"491bb68ae54f","stateId":249,"easy":"إذا باتت المرأة هاجرة فراش زوجها ← تلعنها الملائكة حتى تصبح","cause":"إذا باتَتِ المَرأةُ هاجِرةً فِراشَ زَوجِها","result":"لَعَنَتها المَلائِكةُ حتَّى تُصبِحَ","explicit":true,"repOf":"س-05112","ref":"صحيح مسلم 1436","text":[["إذا باتَتِ المَرأةُ هاجِرةً فِراشَ زَوجِها ",1],["لَعَنَتها المَلائِكةُ حتَّى تُصبِحَ",2],". [وفي روايةٍ]: بهذا الإسنادِ، وقال: حتَّى تَرجِعَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5194)، ومسلم (1436).","bab":"ملائكة › أعمال الملائكة","dorar":"1yZi9ZVt","merged":2,"otherRefs":["تخريج المسند لشعيب 10731 (صحيح)"]},{"id":"س-05105","fp":"3b7930712624","stateId":249,"easy":"إذا لعنت والدك ← لعنك الله","cause":"مَن لعَن والدَه","result":"ولعَن اللهُ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 1307","srcLabel":"مسلم","text":["عن أبي الطُّفَيلِ، قال: سُئِلَ عليٌّ: هل خصَّكم رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بشيءٍ؟ فقال: ما خصَّنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بشيءٍ لم يعُمَّ به النَّاسَ كافَّةً، إلَّا ما كان في قِرابِ سَيْفي هذا. قال: فأَخرَج صَحيفةً فيها مكتوبٌ: لعَن اللهُ مَن ذبَح لغيْرِ اللهِ، لعَن اللهُ مَن سرَق مَنارَ الأرضِ، ولعَن اللهُ ",["مَن لعَن والدَه، ",1],["ولعَن اللهُ ",2],"مَن آوَى مُحدِثًا."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (1978)، وأحمد (1307) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Ip8Twklz","merged":3,"otherRefs":["تخريج المسند لشعيب 855 (صحيح)","الكبائر للذهبي 141 (حسن)"]},{"id":"س-01299","fp":"f7da1607c59e","stateId":249,"easy":"إذا دعاك زوجك فأبيتِ فبات ساخطاً ← تلعنك الملائكة حتى تصبحي","cause":"أيُّما رجلٍ دعا امرأتَه فلم تُجِبْه فبات ساخطًا عليها حتَّى يُصبِحَ","result":"لعَنتْها الملائكةُ حتَّى تُصبِحَ","explicit":true,"star":true,"similar":["س-02756","س-05199"],"ref":"تخريج صحيح ابن حبان 4172","srcLabel":"متفق عليه","text":[["أيُّما رجلٍ دعا امرأتَه فلم تُجِبْه فبات ساخطًا عليها حتَّى يُصبِحَ ",1],["لعَنتْها الملائكةُ حتَّى تُصبِحَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (4172) واللفظ له، والبخاري (5194)، ومسلم (1436) كلاهما باختلاف يسير.","bab":"نكاح › حسن العشرة بين الأزواج","dorar":"L8HguGEB"},{"id":"س-01339","fp":"ad89f68bd0a5","stateId":249,"easy":"إذا دعاك زوجك إلى فراشه فأبيتِ ← يسخط عليكِ الذي في السماء حتى يرضى عنكِ","cause":"يدعو امرأتَهُ إلى فِراشِهِ، فتَأْبى عليه","result":"إلَّا كان الذي في السَّماءِ ساخطًا عليها حتَّى يَرْضى عنها","explicit":true,"ref":"صحيح الجامع 7080","srcLabel":"متفق عليه","text":["والذي نَفْسي بيدِهِ، ما مِن رجُلٍ ",["يدعو امرأتَهُ إلى فِراشِهِ، فتَأْبى عليه",1],"، ",["إلَّا كان الذي في السَّماءِ ساخطًا عليها حتَّى يَرْضى عنها",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (3237) بنحوه، ومسلم (1436) واللفظ له","bab":"نكاح › عشرة النساء","dorar":"2mN4vL8y"},{"id":"س-02728","fp":"5ff1a2879c02","stateId":249,"easy":"إذا واليت قوماً بغير إذن مواليك ← فعليك لعنة الله والملائكة والناس","cause":"مَن والى قومًا بغيرِ إذنِ مواليه","result":"فعليه لعنةُ اللهِ وملائكتِه والنَّاسِ أجمعينَ لا يقبَلُ اللهُ منه يومَ القيامةِ صَرْفًا ولا عَدْلًا، ذِمَّةُ المسلِمينَ واحدةٌ يسعى بها أدناهم","explicit":true,"otherNeedIds":[45],"ref":"صحيح ابن حبان 3716","srcLabel":"متفق عليه","text":["ما عندَنا كتابٌ نقرَؤُه إلَّا كتابَ اللهِ وصحيفةً في قِرابِ سيفي فقرَأها علينا فإذا فيها شيءٌ مِن أسنانِ الإبلِ والجِراحاتِ وإذا فيها: ( ",["مَن والى قومًا بغيرِ إذنِ مواليه ",1],["فعليه لعنةُ اللهِ وملائكتِه والنَّاسِ أجمعينَ لا يقبَلُ اللهُ منه يومَ القيامةِ صَرْفًا ولا عَدْلًا، ذِمَّةُ المسلِمينَ واحدةٌ يسعى بها أدناهم ",2],"فمَن أخفَر مسلمًا فعليه لعنةُ اللهِ والملائكةِ والنَّاسِ أجمعينَ ولا يُقبَلُ منه يومَ القيامةِ صَرْفٌ ولا عَدْلٌ والمدينةُ حرامٌ ما بينَ لابَتَيْها فمَن أحدَث فيها حدَثًا أو آوى مُحدِثًا فعليه لعنةُ اللهِ والملائكةِ والنَّاسِ أجمعينَ لا يُقبَلُ منه يومَ القيامةِ صَرْفٌ ولا عَدْلٌ )"],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (7300)، ومسلم (1370)، وأبو داود (2034) باختلاف يسير.","bab":"إيمان › الملائكة","dorar":"xSsF21CX"},{"id":"س-02756","fp":"6c58e88be6be","stateId":249,"easy":"إذا دعاك زوجك فأبيتِ ← تلعنك الملائكة حتى تصبحي","cause":"إذا دعا أحدُكم امرأتَه إلى فراشِه فأبتْ أنْ تجيءَ","result":"لعَنتْها الملائكةُ حتَّى تُصبِحَ","explicit":true,"repOf":"س-01299","ref":"تخريج صحيح ابن حبان 4173","text":[["إذا دعا أحدُكم امرأتَه إلى فراشِه فأبتْ أنْ تجيءَ ",1],["لعَنتْها الملائكةُ حتَّى تُصبِحَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه ابن حبان (4173) واللفظ له، والبخاري (5194)، ومسلم (1436) كلاهما باختلاف يسير.","bab":"إيمان › الملائكة","dorar":"Lt639l2k"},{"id":"س-04996","fp":"890b4b8aab09","stateId":249,"easy":"إذا ادعيت لغير والديك أو توليت غير مواليك ← فعليك لعنة الله والملائكة إلى يوم القيامة","cause":"أيُّما رَجُلٍ ادَّعى إلى غَيْرِ والِديه أو تَوَلَّى غَيْرَ مَواليه الَّذين أَعْتَقوه","result":"فإنَّ عليه لَعْنةَ اللهِ والمَلائِكةِ إلى يَوْمِ القِيامةِ، لا يُقبَلُ مِنه صَرْفٌ ولا عَدْلٌ","explicit":true,"otherNeedIds":[45],"ref":"الأحاديث المختارة 11 / 29","srcLabel":"متفق عليه","text":["قالَ ابنُ عبَّاسٍ: «",["أيُّما رَجُلٍ ادَّعى إلى غَيْرِ والِديه أو تَوَلَّى غَيْرَ مَواليه الَّذين أَعْتَقوه ",1],["فإنَّ عليه لَعْنةَ اللهِ والمَلائِكةِ إلى يَوْمِ القِيامةِ، لا يُقبَلُ مِنه صَرْفٌ ولا عَدْلٌ»",2],"."],"grade":"صحيح","narrator":"شهر بن حوشب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"JZHJewMd"},{"id":"س-05199","fp":"da170218a9b6","stateId":249,"easy":"إذا دعاك زوجك فأبيتِ فبات غضبان ← تلعنك الملائكة حتى تصبحي","cause":"إذا دعا الرَّجلُ امرأتَهُ إلى فراشِهِ فأبَت ، فلم تأتِهِ فباتَ غضبانَ علَيها","result":"لعنَتها الملائِكَةُ حتَّى تُصْبِحَ","explicit":true,"repOf":"س-01299","ref":"صحيح أبي داود 2141","text":[["إذا دعا الرَّجلُ امرأتَهُ إلى فراشِهِ فأبَت ، فلم تأتِهِ فباتَ غضبانَ علَيها ، ",1],["لعنَتها الملائِكَةُ حتَّى تُصْبِحَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (3237)، ومسلم (1436)، وأبو داود (2141) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"jW5iZfVB"},{"id":"س-08287","fp":"3f76ff70d338","stateId":249,"easy":"إذا ادعيت لغير أبيك أو انتميت لغير مواليك ← فعليك لعنة الله والملائكة والناس أجمعين","cause":"وَمَنِ ادَّعَى إلى غيرِ أَبِيهِ، أَوِ انْتَمَى إلى غيرِ مَوَالِيهِ","result":"فَعليه لَعْنَةُ اللهِ وَالْمَلَائِكَةِ وَالنَّاسِ أَجْمَعِينَ، لا يَقْبَلُ اللَّهُ منه يَومَ القِيَامَةِ صَرْفًا، وَلَا عَدْلًا","explicit":true,"otherNeedIds":[45],"ref":"الزواجر عن اقتراف الكبائر 1/99","srcLabel":"متفق عليه","text":["لعنَ اللهُ من أحدثَ حدثًا [يعني حديث: خَطَبَنَا عَلِيُّ بنُ أَبِي طَالِبٍ، فَقالَ: مَن زَعَمَ أنَّ عِنْدَنَا شيئًا نَقْرَؤُهُ إلَّا كِتَابَ اللهِ وَهذِه الصَّحِيفَةَ، قالَ: وَصَحِيفَةٌ مُعَلَّقَةٌ في قِرَابِ سَيْفِهِ، فقَدْ كَذَبَ، فِيهَا أَسْنَانُ الإبِلِ، وَأَشْيَاءُ مِنَ الجِرَاحَاتِ، وَفِيهَا قالَ النبيُّ صَلَّى اللَّهُ تَعَالَى عليه وسلَّمَ: المَدِينَةُ حَرَمٌ ما بيْنَ عَيْرٍ إلى ثَوْرٍ ، فمَن أَحْدَثَ فِيهَا حَدَثًا، أَوْ آوَى مُحْدِثًا، فَعليه لَعْنَةُ اللهِ وَالْمَلَائِكَةِ وَالنَّاسِ أَجْمَعِينَ، لا يَقْبَلُ اللَّهُ منه يَومَ القِيَامَةِ صَرْفًا، وَلَا عَدْلًا، وَذِمَّةُ المُسْلِمِينَ وَاحِدَةٌ، يَسْعَى بهَا أَدْنَاهُمْ، ",["وَمَنِ ادَّعَى إلى غيرِ أَبِيهِ، أَوِ انْتَمَى إلى غيرِ مَوَالِيهِ، ",1],["فَعليه لَعْنَةُ اللهِ وَالْمَلَائِكَةِ وَالنَّاسِ أَجْمَعِينَ، لا يَقْبَلُ اللَّهُ منه يَومَ القِيَامَةِ صَرْفًا، وَلَا عَدْلًا",2],". وَانْتَهَى حَديثُ أَبِي بَكْرٍ، وَزُهَيْرٍ عِنْدَ قَوْلِهِ يَسْعَى بهَا أَدْنَاهُمْ، وَلَمْ يَذْكُرَا ما بَعْدَهُ. وَليسَ في حَديثِهِمَا: مُعَلَّقَةٌ في قِرَابِ سَيْفِهِ.]"],"grade":"صحيح","narrator":"[علي بن أبي طالب]","muhaddith":"صحيح","takhrij":"أخرجه البخاري (3179)، ومسلم (1370)، وأبو داود (2034) جميعا بلفظ مقارب مطولا.","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"bBgSaJum"},{"id":"س-08295","fp":"835fffb89269","stateId":249,"easy":"إذا انتميت لغير مواليك ← فأنت ملعون","cause":"مَن انتَمى إلى غَيرِ مَواليه","result":"ملعونٌ ملعونٌ","explicit":true,"ref":"الأحاديث المختارة 2203","srcLabel":"البخاري","text":["«",["ملعونٌ ملعونٌ",2]," مَن ادَّعى إلى غَيرِ أبيه، ملعونٌ ملعونٌ ",["مَن انتَمى إلى غَيرِ مَواليه",1],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"21Y1NSeb"},{"id":"س-08296","fp":"7ad0f6a9eb40","stateId":249,"easy":"إذا ادعيت لغير أبيك ← فأنت ملعون","cause":"مَن ادَّعى إلى غَيرِ أبيه","result":"ملعونٌ ملعونٌ","explicit":true,"ref":"الأحاديث المختارة 2203","srcLabel":"البخاري","text":["«ملعونٌ ملعونٌ ",["مَن ادَّعى إلى غَيرِ أبيه",1],"، ",["ملعونٌ ملعونٌ",2]," مَن انتَمى إلى غَيرِ مَواليه»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"21Y1NSeb"},{"id":"ق-1219","fp":"b415ed4f9e0d","stateId":249,"easy":"الإفساد في الأرض وقطع الأرحام ← لعنة الله والصمم وعمى الأبصار","cause":"الإفساد في الأرض وقطع الأرحام","result":"لعنة الله والصمم وعمى الأبصار","explicit":true,"otherNeedIds":[19],"ref":"سورة محمد: 22–23","srcLabel":"القرآن الكريم","quran":{"s":47,"from":22,"to":23,"text":"فَهَلْ عَسَيْتُمْ إِنْ تَوَلَّيْتُمْ أَنْ تُفْسِدُوا فِي الْأَرْضِ وَتُقَطِّعُوا أَرْحَامَكُمْ (22) أُولَئِكَ الَّذِينَ لَعَنَهُمُ اللَّهُ فَأَصَمَّهُمْ وَأَعْمَى أَبْصَارَهُمْ (23)","hl":[[0,176,1]]}},{"id":"س-05251","fp":"ce3bc1331c37","stateId":249,"easy":"إذا أسخطت والدك ← أسخطت ربك","cause":"في سَخَطِ الوالِدِ","result":"وسَخَطُ الرَّبِّ","explicit":true,"ref":"تخريج شرح السنة 1/13","srcLabel":"الترمذي","text":["رِضَا الرَّبِّ في رِضَا الوالِدِ، ",["وسَخَطُ الرَّبِّ",2]," ",["في سَخَطِ الوالِدِ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي بعد حديث (1899)، والخطيب في ((الجامع)) (1698)، وأخرجه الطبراني (13/494) (14367) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"8f3GCGqQ","merged":4,"otherRefs":["تخريج شرح السنة 3424 (صحيح)","بلوغ المرام 434 (صحيح)","صحيح الجامع 3507 (صحيح)"]},{"id":"س-05191","fp":"48cb426933dd","stateId":249,"easy":"إذا طلب منك زوجك حاجته فأبيتِ فبات غضبان ← تلعنك الملائكة حتى تصبحي","cause":"ما مِنِ امرأةٍ يطلُبُ زوجُها منها حاجةً فتَأْبَى فيَبِيتُ وهو علَيْهَا غَضْبَانُ","result":"إلَّا بَاتَتْ تَلْعَنُهَا الملائِكَةُ حتى يُصِبَحَ","explicit":true,"ref":"مجمع الزوائد 4/299","srcLabel":"متفق عليه","text":[["ما مِنِ امرأةٍ يطلُبُ زوجُها منها حاجةً فتَأْبَى فيَبِيتُ وهو علَيْهَا غَضْبَانُ",1]," ",["إلَّا بَاتَتْ تَلْعَنُهَا الملائِكَةُ حتى يُصِبَحَ",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني في ((الأوسط)) (8072) واللفظ له، والبخاري (3237)، ومسلم (1436) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"A00Ojb7r"},{"id":"س-04974","fp":"8a09f3cd63b1","stateId":249,"easy":"إذا آذيت جارك ← لعنك الله قبل الناس","cause":"يَشكُو جارَهُ","result":"فقدْ لَعَنَكَ اللهُ قبْلَ النَّاسِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[39],"ref":"المستدرك على الصحيحين 7509","srcLabel":"مسلم","text":["جاءَ رجلٌ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ ",["يَشكُو جارَهُ",1],"، فقالَ له النَّبِيُّ صلَّى اللهُ عليه وسلَّمَ: اطْرَحْ مَتاعَكَ في الطَّريقِ، قالَ: فجَعَلَ النَّاسُ يَمرُّونَ به، فيَلْعَنونَه، فجاءَ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقالَ: يا رسولَ اللهِ، ما لَقيتُ مِن النَّاسِ؟ قالَ: وما لَقِيتَهُ منهُم؟ قالَ: يَلْعَنوني، قالَ: ",["فقدْ لَعَنَكَ اللهُ قبْلَ النَّاسِ",2],"، قالَ: يا رسولَ اللهِ، فإنِّي لا أعودُ، قالَ: فجاءَ الَّذي شَكَا إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقال لهُ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: قدْ أَمِنْتَ، أو قدْ كُفِيتَ."],"grade":"صحيح","narrator":"أبو جحيفة","muhaddith":"[صحيح على شرط مسلم]","takhrij":"أخرجه البزار (4235)، والطبراني في ((مكارم الأخلاق)) (236) واللفظ لهما.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"dqhuk1z8","merged":2,"otherRefs":["الترغيب والترهيب 3/321 (صحيح)"]},{"id":"س-00374","fp":"7c44668ff727","stateId":249,"easy":"إذا تولّيت غير مواليك ← لعنك الله","cause":"مَن تولَّى غيرَ مواليه","result":"ولعَن اللهُ","explicit":true,"ref":"صحيح ابن حبان 4417","srcLabel":"أحمد","text":["لعَن اللهُ مَن ذبَح لغيرِ اللهِ ولعَن اللهُ مَن غيَّر تُخومَ الأرضِ ولعَن اللهُ مَن كَمَهَ الأعمى عن السَّبيلِ ولعَن اللهُ مَن سبَّ والدَيهِ ولعَن اللهُ ",["مَن تولَّى غيرَ مواليه",1]," ",["ولعَن اللهُ",2]," من عمِل عمَلَ قومِ لوطٍ ) قالها ثلاثًا في عمَلِ قومِ لوطٍ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (2816)، والطبراني (11/218) (11546)، والحاكم (8052) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"uM3xrugw","merged":2,"otherRefs":["تخريج صحيح ابن حبان 5896 (صحيح)"]},{"id":"س-00373","fp":"9870e3aee744","stateId":249,"easy":"إذا سببت والديك ← لعنك الله","cause":"مَن سبَّ والدَيهِ","result":"ولعَن اللهُ","explicit":true,"ref":"صحيح ابن حبان 4417","srcLabel":"أحمد","text":["لعَن اللهُ مَن ذبَح لغيرِ اللهِ ولعَن اللهُ مَن غيَّر تُخومَ الأرضِ ولعَن اللهُ مَن كَمَهَ الأعمى عن السَّبيلِ ولعَن اللهُ ",["مَن سبَّ والدَيهِ",1]," ",["ولعَن اللهُ",2]," مَن تولَّى غيرَ مواليه ولعَن اللهُ من عمِل عمَلَ قومِ لوطٍ ) قالها ثلاثًا في عمَلِ قومِ لوطٍ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (2816)، والطبراني (11/218) (11546)، والحاكم (8052) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"uM3xrugw"},{"id":"س-00415","fp":"f6508dac098a","stateId":249,"easy":"إذا أفسدت على أحد زوجته أو مملوكه ← فلست منا","cause":"وَمَنْ خَبَّبَ عَلَى امرئٍ زوجتَهُ أو مملوكَهُ","result":"فليس مِنَّا","explicit":true,"otherNeedIds":[39],"ref":"مجمع الزوائد 4/335","srcLabel":"أبو داود","text":["لَيْسَ مِنَّا مَنْ حَلَفَ بِالْأَمَانَةِ ",["وَمَنْ خَبَّبَ عَلَى امرئٍ زوجتَهُ أو مملوكَهُ",1]," ",["فليس مِنَّا",2]],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"رجاله رجال الصحيح خلا الوليد بن ثعلبة وهو ثقة","takhrij":"أخرجه أبو داود (3253) مختصراً، وأحمد (22980) واللفظ له.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"0kVQXmlj"},{"id":"س-00431","fp":"0ca39932a368","stateId":249,"easy":"إذا أفسدت امرأة مسلم عليه ← فلست منا","cause":"ومَن خبَّبَ امرأةَ امرئٍ مُسلِمٍ","result":"فليس مِنَّا","explicit":true,"ref":"تخريج مشكل الآثار 1342","srcLabel":"أحمد","text":["مَن حلَفَ بالأمانَةِ فليس مِنَّا، ",["ومَن خبَّبَ امرأةَ امرئٍ مُسلِمٍ ",1],["فليس مِنَّا",2],"."],"grade":"صحيح","narrator":"بريدة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (22980)، وابن حبان (4363) واللفظ لهما،","bab":"آداب عامة › الأخلاق المذمومة","dorar":"FveaxYb5"},{"id":"س-01321","fp":"c1edfd30f523","stateId":249,"easy":"إذا لم تشكري زوجك وأنتِ لا تستغنين عنه ← لا ينظر الله إليكِ","cause":"امرأةٍ لا تَشكُرُ لزَوْجِها ولا تَستغنِي عنْه","result":"لا يَنظُرُ اللهُ إلى","explicit":true,"ref":"المستدرك على الصحيحين 7/ 317","srcLabel":"ابن أبي الدنيا","text":["عنْ عبدِ اللهِ بنِ عمْرٍو، قال: ",["لا يَنظُرُ اللهُ إلى",2],[" امرأةٍ لا تَشكُرُ لزَوْجِها ولا تَستغنِي عنْه",1],"."],"grade":"صحيح","narrator":"سَعيدِ بنِ المُسيَّبِ،","muhaddith":"محفوظ","takhrij":"أخرجه ابن أبي الدنيا في ((النفقة على العيال)) (533)، والبزار (2349) بلفظه.","bab":"نكاح › حق الزوج على المرأة","dorar":"LCkLbWrO"},{"id":"س-03064","fp":"1232e36216e2","stateId":249,"easy":"إذا تبرأت من والديك أو ولدك أو كفرت نعمة من أحسن إليك ← لا يكلمك الله يوم القيامة","cause":"متبرِّئٌ مِن والدَيهِ راغبٌ عنهُما ومتبرِّئٌ مِن ولدِهِ ورجلٌ أنعمَ عليهِ قومٌ فَكَفرَ نعمتَهُم وتبرَّأ منهُم","result":"إنَّ للَّهِ عبادًا لا يُكلِّمُهم اللَّهُ يومَ القيامةِ ولا يزَكِّيهم ولا ينظُرُ إليهم ولَهُم عذابٌ أليمٌ","explicit":true,"otherNeedIds":[57],"ref":"الزواجر عن اقتراف الكبائر 1/260","srcLabel":"السنة","text":[["إنَّ للَّهِ عبادًا لا يُكلِّمُهم اللَّهُ يومَ القيامةِ ولا يزَكِّيهم ولا ينظُرُ إليهم ولَهُم عذابٌ أليمٌ",2]," ، قيلَ ومَن أولئكَ يا رسولَ اللَّهِ ؟ قالَ ",["متبرِّئٌ مِن والدَيهِ راغبٌ عنهُما ومتبرِّئٌ مِن ولدِهِ ورجلٌ أنعمَ عليهِ قومٌ فَكَفرَ نعمتَهُم وتبرَّأ منهُم",1]],"grade":"صحيح","muhaddith":"صحيح","bab":"إيمان › الوعيد","dorar":"Bafo2sGQ"},{"id":"س-03095","fp":"cac65f382380","stateId":249,"easy":"إذا أفسدت امرأة على زوجها أو عبداً على سيده ← فلست منا","cause":"خَبَّبَ امْرَأةً على زَوْجِها، أو عَبْدًا على سَيِّدِه","result":"ليس مِنَّا مَن","explicit":true,"similar":["س-04833"],"ref":"الأحكام الوسطى 3/ 188","srcLabel":"أبو داود","text":[["ليس مِنَّا مَن",2],[" خَبَّبَ امْرَأةً على زَوْجِها، أو عَبْدًا على سَيِّدِه",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (2175)، والحاكم (2795)، والبزار (7827) بلفظه.","bab":"إيمان › الوعيد","dorar":"jDKT05Zm"},{"id":"س-04211","fp":"1c0c522d4489","stateId":249,"easy":"إذا عققت والديك أو كنت ديوثاً أو تشبهت المرأة بالرجال ← لا ينظر الله إليك يوم القيامة","cause":"العاقُّ لوالِدَيه، والدَّيُّوثُ، والمَرْأةُ المُتَرجِّلةُ تَشَبَّهُ بالرِّجالِ، وثَلاثةٌ لا يَدخُلونَ الجَنَّةَ: العَقوقُ لوالِدَيه، والمَنَّانُ عَطاءَه، ومُدمِنُ الخَمْرِ","result":"ثَلاثةٌ لا يَنظُرُ اللهُ إليهم يَوْمَ القِيامةِ","explicit":true,"ref":"الأحكام الوسطى 4/ 255","srcLabel":"السنة","text":["\"",["ثَلاثةٌ لا يَنظُرُ اللهُ إليهم يَوْمَ القِيامةِ",2],":",[" العاقُّ لوالِدَيه، والدَّيُّوثُ، والمَرْأةُ المُتَرجِّلةُ تَشَبَّهُ بالرِّجالِ، وثَلاثةٌ لا يَدخُلونَ الجَنَّةَ: العَقوقُ لوالِدَيه، والمَنَّانُ عَطاءَه، ومُدمِنُ الخَمْرِ\".",1]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"zTSrUP74"},{"id":"س-04250","fp":"127c167fe945","stateId":249,"easy":"إذا عققت والديك أو أدمنت الخمر أو مننت بما أعطيت ← لا ينظر الله إليك يوم القيامة","cause":"عَاقٌّ والِدَيْهِ، ومُدْمِنُ خَمْرٍ، ومَنَّانٌ بما أَعْطَى","result":"ثَلاثةٌ لا يَنظُرُ اللهُ إلَيْهم يومَ القِيامةِ","explicit":true,"ref":"المستدرك على الصحيحين 7440","srcLabel":"ابن حبان","text":[["ثَلاثةٌ لا يَنظُرُ اللهُ إلَيْهم يومَ القِيامةِ",2],":",[" عَاقٌّ والِدَيْهِ، ومُدْمِنُ خَمْرٍ، ومَنَّانٌ بما أَعْطَى.",1]],"grade":"صحيح","narrator":"[عبدالله بن عمر]","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن حبان (7340)، وأبو نعيم في ((معرفة الصحابة)) (4326) واللفظ لهما، والبيهقي في ((الشعب)) (7417) بلفظه مطولًا.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"tfvF67yq"},{"id":"س-04833","fp":"398c5febe53f","stateId":249,"easy":"إذا أفسدت خادماً على أهله أو امرأة على زوجها ← فلست منا","cause":"مَنْ خَبَّبَ خَادِمًا على أهلِهِا","result":"فَليسَ مِنَّا و مَنْ أَفْسَدَ امرأةً على زَوْجِها فَليسَ مِنَّا","explicit":true,"repOf":"س-03095","ref":"السلسلة الصحيحة 324","text":[["مَنْ خَبَّبَ خَادِمًا على أهلِهِا ",1],["فَليسَ مِنَّا و مَنْ أَفْسَدَ امرأةً على زَوْجِها فَليسَ مِنَّا",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (5170) بنحوه، والنسائي في ((السنن الكبرى)) (9214)، وأحمد (9157) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"cBGD7oGG"},{"id":"س-05249","fp":"2b564902d798","stateId":249,"easy":"إذا جحدت ولدك وأنت تنظر إليه ← يحتجب الله عنك ويفضحك على رؤوس الخلائق","cause":"وأيُّما رجُلٍ جحَد ولَدَهُ وهو ينظُرُ إليه","result":"احتجَب اللهُ منه، وفضَحه على رؤوسِ الخلائقِ في الأوَّلِينَ والآخِرينَ","explicit":true,"otherNeedIds":[39],"ref":"تخريج شرح السنة 2374","srcLabel":"أبو داود","text":["أنَّه سَمِع النبيَّ صلَّى اللهُ عليه وسلَّمَ يقولُ لمَّا نزَلتْ آيةُ المُلاعَنةِ، قال النبيُّ صلَّى اللهُ عليه وسلَّمَ: أيُّما امرأةٍ أدخَلتْ على قومٍ مَن ليس منهم، فليست مِن اللهِ في شيءٍ، ولن يُدخِلَها اللهُ جنَّتَهُ، ",["وأيُّما رجُلٍ جحَد ولَدَهُ وهو ينظُرُ إليه، ",1],["احتجَب اللهُ منه، وفضَحه على رؤوسِ الخلائقِ في الأوَّلِينَ والآخِرينَ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2263) بلفظه، وابن ماجه (2743)، والدارمي (2284) كلاهما بلفظ مقارب.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"uHqnMrBC"},{"id":"س-08103","fp":"62b7525dcd0e","stateId":249,"easy":"إذا خرجت المرأة من بيتها وزوجها كاره ← يلعنها كل ملك في السماء وكل ما مرت عليه","cause":"إذا خرجت من بيتِها وزوجُها كارِهٌ","result":"لعنَها كلُّ ملَكٍ في السَّماءِ وَكلُّ شيءٍ مرَّت عليْهِ غيرَ الجنِّ والإنسِ حتَّى ترجِعَ","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 2/42","srcLabel":"الطبراني","text":["إنَّ المرأةَ ",["إذا خرجت من بيتِها وزوجُها كارِهٌ",1]," ",["لعنَها كلُّ ملَكٍ في السَّماءِ وَكلُّ شيءٍ مرَّت عليْهِ غيرَ الجنِّ والإنسِ حتَّى ترجِعَ",2]],"grade":"صحيح","narrator":"[عبدالله بن عمر]","muhaddith":"إسناده صحيح إلا أن فيه واحدا مختلفا فيه","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (513) بلفظه.","bab":"ملائكة › أعمال الملائكة","dorar":"RH9kjkzB"},{"id":"س-03845","fp":"0d03eae49ccd","stateId":249,"easy":"إذا عصيت والدك ← فهي معصية لله","cause":"معصيةُ الوالِدِ","result":"ومعصيةُ اللهِ","explicit":true,"otherNeedIds":[39],"ref":"صحيح الترغيب 2502","srcLabel":"الطبراني","text":["طاعةُ اللهِ طاعةُ الوالِدِ ، ",["ومعصيةُ اللهِ",2]," ",["معصيةُ الوالِدِ",1]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن لغيره","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (2255)","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"9xSWwQlH"},{"id":"س-04895","fp":"ec931b83478f","stateId":249,"easy":"إذا سببت أباك أو أمك أو ذبحت لغير الله أو غيرت حدود الأرض ← فأنت ملعون","cause":"سبَّ أباهُ، ملعونٌ منْ سبَّ أمَّهُ، ملعونٌ من ذبَحَ لغيرِ اللهِ، ملعونٌ منْ غيرَ تخومَ الأرضِ، ملعونٌ منْ كمَّهَ أعمَى عنْ طريقٍ، ملعونٌ منْ وقعَ على بهيمةٍ، ملعونٌ منْ عملَ بعملِ قومِ لوطٍ","result":"ملعونٌ منْ","explicit":true,"ref":"الجامع الصغير 8188","srcLabel":"أحمد","text":[["ملعونٌ منْ",2],[" سبَّ أباهُ،  ملعونٌ منْ سبَّ أمَّهُ،  ملعونٌ من ذبَحَ لغيرِ اللهِ،  ملعونٌ منْ غيرَ تخومَ الأرضِ،  ملعونٌ منْ كمَّهَ أعمَى عنْ طريقٍ،  ملعونٌ منْ وقعَ على بهيمةٍ،  ملعونٌ منْ عملَ بعملِ قومِ لوطٍ",1]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن","takhrij":"أخرجه أحمد (1875) واللفظ له، وابن حبان (4417)، والطبراني (11/218) (11546)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"LBKYsRSD"},{"id":"س-03818","fp":"4c741e62ee43","stateId":249,"easy":"إذا آذيت جارك فلعنه الناس ← فلعنة الله فوق لعنتهم","cause":"جَارَهُ","result":"إنَّ لعنةَ اللهِ فوقَ لَعنتِهِم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الأدب المفرد 93","srcLabel":"البخاري","text":["شَكَا رَجُلٌ إِلَى النَّبِيِّ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ ",["جَارَهُ",1],"، فقال: احْمِل مَتاعَك فضَعْه على الطَّريقِ، فَمَن مَرَّ بِه يَلعَنُه، فَجعَل كُلُّ مَن مَرَّ بِه يَلعَنُه، فَجاءَ إلى النَّبيِّ صلَّى اللهُ عليهِ وسلَّمَ، فَقال: ما لَقيتُ مِنَ النَّاسِ؟! فَقال: ",["إنَّ لعنةَ اللهِ فوقَ لَعنتِهِم",2],"، ثُمَّ قال للَّذي شَكا: كُفيتَ أو نَحوَه."],"grade":"صحيح","narrator":"وهب بن عبدالله السوائي أبو جحيفة","muhaddith":"حسن صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (125) واللفظ له،  والحاكم (7303)، والبيهقي في ((شعب الإيمان)) (9101) بنحوه.","bab":"بر وصلة › حق الجار والوصاة به","dorar":"Dqb5ZVSF"},{"id":"س-06574","fp":"2513611b2d29","stateId":250,"easy":"إذا دخلت على الظلمة فأعنتهم وصدقتهم بكذبهم ← فلست من النبي ﷺ ولن ترد عليه الحوض","cause":"مَن دخَل عليهم فأعانهم على ظُلمِهم وصدَّقهم بكذِبِهم","result":"فليس منِّي ولَسْتُ منه ولنْ يرِدَ علَيَّ الحوضَ","explicit":true,"star":true,"similar":["س-08005"],"otherNeedIds":[50,57],"ref":"تخريج صحيح ابن حبان 1723","srcLabel":"مسلم","text":["يا كعبُ بنَ عُجْرةَ أُعيذُكَ باللهِ مِن إمارةِ السُّفهاءِ إنَّها ستكونُ أُمَراءُ ",["مَن دخَل عليهم فأعانهم على ظُلمِهم وصدَّقهم بكذِبِهم",1]," ",["فليس منِّي ولَسْتُ منه ولنْ يرِدَ علَيَّ الحوضَ",2]," ومَن لَمْ يدخُلْ عليهم ولَمْ يُعِنْهم على ظُلْمِهم ولَمْ يُصدِّقْهم بكذِبهم فهو منِّي وأنا منه وسيرِدُ علَيَّ الحوضَ يا كعبُ بنَ عُجْرةَ الصَّلاةُ قُربانٌ والصَّومُ جُنَّةٌ والصَّدقةُ تُطفِئُ الخَطِيَّةَ كما يُطفِئُ الماءُ النَّارَ والنَّاسُ غاديانِ فمُبتاعٌ نفسَه فمُعتِقٌ رقَبتَه وموبقُها يا كعبُ بنَ عُجْرةَ إنَّه لا يدخُلُ الجنَّةَ لحمٌ نبَت مِن سُحْتٍ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (1345) بلفظ مقارب، والحاكم (6030) والبيهقي في ((الآداب)) (300) بنحوه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"HUY1AvMX","merged":9,"otherRefs":["الأحكام الشرعية الصغرى 495 (صحيح)","المستدرك على الصحيحين 7358 (صحيح)","صحيح النسائي 4218 (صحيح)","تخريج صحيح ابن حبان 285 (صحيح)","تخريج المسند لشعيب 27218 (صحيح)","تخريج كتاب السنة 758 (صحيح)","مجمع الزوائد 5/250 (صحيح)","صحيح ابن حبان 284 (صحيح)"]},{"id":"س-07992","fp":"321c9be998c7","stateId":250,"easy":"إذا توليت قوماً بغير إذنهم ← فعليك لعنة الله","cause":"ومَن تولَّى قومًا بغيرِ إذنِهم","result":"فعليه لَعنةُ اللهِ","explicit":true,"star":true,"ref":"تخريج المسند لشاكر 3/117","srcLabel":"متفق عليه","text":["قال لنا مَرْوانُ: انطلِقوا فأَصلِحوا بيْن هذينِ؛ سعيدِ بنِ زيدٍ وأَرْوى بنتِ أُوَيسٍ. فأتَينا سعيدَ بنَ زيدٍ، فقال: أتَرَون أنِّي قدِ استَنقصْتُ مِن حقِّها شيئًا؟ أشهَدُ لسَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: مَن أخَذ شِبرًا مِن الأرضِ بغيرِ حقِّه، طُوِّقَه مِن سبعِ أرَضينَ، ",["ومَن تولَّى قومًا بغيرِ إذنِهم، ",1],["فعليه لَعنةُ اللهِ، ",2],"ومَنِ اقتطع مالَ أخيهِ بيَمينِه، فلا بارَكَ اللهُ له فيه."],"grade":"صحيح","narrator":"عبدالرحمن بن عوف","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو يعلى (955) واللفظ له، والحاكم (7807) باختلاف يسير، والبخاري (3198)، ومسلم (1610) بالفقرة الأولى فقط.","bab":"مظالم › تحريم الظلم","dorar":"XXyZA1jm"},{"id":"س-06165","fp":"24aed09399e0","stateId":250,"easy":"إذا وليت قوماً ولم تقم فيهم كتاب الله ← فعليك لعنة الله","cause":"فمَن لم يُقِمْ فيهم كتابَ اللهِ","result":"فعليه بَهلةُ اللهِ","explicit":true,"star":true,"ref":"مجمع الزوائد 5/204","srcLabel":"البخاري","text":["بعَثَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ عَمرَو بنَ العاصِ على جيشِ ذاتِ السلاسلِ، فبعَثَ معه في ذلك الجَيشِ  أبا بَكْرٍ وعُمَرَ وسَراةَ أصحابِه، فانطَلَقوا حتى نزَلوا جبلَ طَيِّئٍ، فقال عَمرٌو: انظُروا إلى رجُلٍ دليلٍ بالطَّريقِ. فقالوا: ما نعلَمُه إلَّا رافعَ بنَ عَمرٍو؛ فإنَّه كان رَبيلًا، فسأَلتُ طارقًا: ما الرَّبيلُ؟ قال: اللِّصُ الذي يَغْزو القومَ وحْدَه فيسرِقُ. قال رافعٌ: فلمَّا قضَيْنا غَزاتَنا، وانتهَيتُ إلى المكانِ الذي كنَّا خرَجْنا منه توسَّمتُ أبا بَكْرٍ فأتَيتُه، فقلتُ: يا صاحبَ [الخلال] ، إنِّي توسَّمتُكَ مِن بينِ أصحابِكَ، فائْتِني بشيءٍ إذا حفِظتُه كنتُ منكم ومِثلَكم. فقال: أتحفَظُ أصابِعَكَ الخمْسَ؟ قلتُ: نعَمْ. قال: أشهدُ أنْ لا إلهَ إلَّا اللهُ وحدَه لا شريكَ له، وأنَّ مُحمَّدًا عبدُه ورسولُه، وتقيمُ الصَّلاةَ، وتُؤتي الزكاةَ إنْ كان لكَ مالٌ، وتحُجُّ البَيتَ، وتصومُ رمضانَ. حفِظتَ؟ فقلتُ: نعَمْ. قال: وأُخرى: لا تأمَّرنَّ على اثنينِ. قلتُ: وهل تكونُ الإمْرةُ إلَّا فيكم أهلَ بدرٍ؟ قال: يوشِكُ أنْ تفشوَ حتى تبلُغَكَ ومَن هو دونَكَ، إنَّ اللهَ عزَّ وجلَّ لمَّا بعَثَ نبيَّه صلَّى اللهُ عليه وسلَّمَ دخَلَ النَّاسُ في الإسلامِ، فمنهم مَن دخَلَ فهداه اللهُ، ومنهم مَن أكرَهَه السَّيفُ، فهم عُوَّادُ اللهِ عزَّ وجلَّ وجيرانُ اللهِ في خِفارةِ اللهِ، إنَّ الرجُلَ إذا كانَ أميرًا فتظالَمَ النَّاسُ بينَهم، فلم يأخُذْ لبعضِهم مِن بعضٍ انتقَمَ اللهُ منه، إنَّ الرجُلَ منكم لتؤخَذُ شاةُ جارِه، فيظَلُّ ناتِئَ عَضَلتِه غَضبًا لجارِه، واللهُ مِن وراءِ جارِه. قال رافعٌ: فمكَثتُ سنةً، ثمَّ إنَّ أبا بَكْرٍ استُخلِفَ، فركَنتُ إليه، قلتُ: أنا رافعٌ، كنتُ نَقيبَكَ بمكانِ كذا وكذا. قال: عرَفتُ. قال: كنتَ نهَيتَني عن الإمارةِ، ثمَّ ركبِتَ أعظَمَ مِن ذلكَ، أُمَّةَ مُحمَّدٍ صلَّى اللهُ عليه وسلَّمَ؟! قال: نعَمْ، ",["فمَن لم يُقِمْ فيهم كتابَ اللهِ",1],"، ",["فعليه بَهلةُ اللهِ",2],". يَعْني: لعنةَ اللهِ."],"grade":"حسن","narrator":"رافع بن عمرو الطائي","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني (5/ 21) (4467) واللفظ له، والبخاري في ((التاريخ الكبير)) (6/ 24)، والنسائي في ((فضائل الصحابة)) (16) مختصرا.","bab":"زكاة › فرض الزكاة","dorar":"S9eBzz3d"},{"id":"س-05082","fp":"7f2a31a864d1","stateId":250,"easy":"إذا حالت شفاعتك دون حد من حدود الله ← فقد ضاددت الله في أمره","cause":"مَن حالَتْ شَفاعَتُه دُونَ حدٍّ مِن حُدودِ اللهِ عزَّ وجلَّ","result":"فقد ضادَّ اللهَ أَمْرَه","explicit":true,"star":true,"similar":["س-01189"],"ref":"تخريج المسند لشعيب 5385","srcLabel":"أبو داود","text":["خرَجْنا حُجَّاجًا عَشَرةً مِن أهلِ الشَّامِ، حتى أَتَيْنا مكَّةَ، فذَكَر الحديثَ، قال: فأَتَيْناهُ، فخَرَج إلينا -يعني: ابنَ عُمرَ، فقال: سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقول: ",["مَن حالَتْ شَفاعَتُه دُونَ حدٍّ مِن حُدودِ اللهِ عزَّ وجلَّ",1],"، ",["فقد ضادَّ اللهَ أَمْرَه",2],"، ومَن مات وعليه دَيْنٌ، فليس بالدِّينارِ ولا بالدِّرهمِ، ولكنَّها الحسَناتُ والسَّيِّئاتُ، ومَن خاصَمَ في باطِلٍ وهو يَعْلَمُه، لم يَزَلْ في سَخَطِ اللهِ حتى يَنزِعَ، ومَن قال في مؤْمِنٍ ما ليس فيه، أَسْكَنَه اللهُ رَدْغةَ الخَبَالِ حتى يَخرُجَ ممَّا قالَ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3597)، وأحمد (5385) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"jwOzDMmj","merged":3,"otherRefs":["مجمع الزوائد 10/94 (صحيح)","السلسلة الصحيحة 437 (صحيح)"]},{"id":"س-04676","fp":"e0ed3e3a4c42","stateId":250,"easy":"إذا شفعت في حد بعد بلوغه الإمام ← لعن الله الشافع والمشفّع","cause":"إذا بَلَغَ الإمامَ","result":"فلَعَنَ اللهُ الشَّافِعَ والمُشفَّعَ","explicit":true,"ref":"الأحكام الوسطى 4/ 95","srcLabel":"مالك","text":["أنَّ الزُّبَيْرَ [شَفَعَ في سارِقٍ، فقيلَ حتَّى نُبَلِّغَه الإمامَ، فقالَ: \"",["إذا بَلَغَ الإمامَ",1]," ",["فلَعَنَ اللهُ الشَّافِعَ والمُشفَّعَ",2],"\"، كما قالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ]."],"grade":"صحيح","narrator":"الزبير","muhaddith":"[صحيح]","takhrij":"أخرجه مالك في ((الموطأ)) (3087) بنحوه","bab":"ديات وقصاص › الشفاعة في القصاص","dorar":"MwkeM8VT","merged":2,"otherRefs":["نيل الأوطار 7/311 (حسن)"]},{"id":"س-06582","fp":"7e73d12f5a3e","stateId":250,"easy":"إذا صدقت الظلمة بكذبهم وأعنتهم على ظلمهم ← لست من النبي ﷺ ولا ترد حوضه","cause":"فمَن صَدَّقهم بكَذِبِهم وأعانَهم على ظُلمِهم","result":"فأولئكَ ليْسوا منِّي، ولسْتُ منهم، ولا يَرِدُون علَيَّ حَوْضي","explicit":true,"similar":["س-07434","س-07997"],"otherNeedIds":[57],"ref":"المستدرك على الصحيحين 8522","srcLabel":"السنة","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قال لكَعبِ بنِ عُجْرةَ: أعاذَكَ اللهُ يا كعْبُ مِن إمارةِ السُّفهاءِ، قال: وما إمارةُ السُّفهاءِ يا رَسولَ اللهِ؟ قال: أُمراءُ يكونونَ بعْدي، لا يَهْدُون بهَدْيي، ولا يَسْتنُّون بسُنَّتي، ",["فمَن صَدَّقهم بكَذِبِهم وأعانَهم على ظُلمِهم، ",1],["فأولئكَ ليْسوا منِّي، ولسْتُ منهم، ولا يَرِدُون علَيَّ حَوْضي، ",2],"ومَن لم يُصدِّقْهم بكَذِبِهم ولم يُعِنْهم على ظُلمِهم، فأولئكَ منِّي وأنا منْهم، وسيَرِدُون علَيَّ حَوْضي. يا كَعْبُ بنَ عُجْرةَ، الصَّومُ جُنَّةٌ، والصَّدقةُ تُطفِئُ الخطيئةَ، والصَّلاةُ قُربانٌ، أو قال: بُرهانٌ. يا كَعْبُ بنَ عُجْرةَ، لا يَدخُلُ الجنَّةَ لحْمٌ نبَتَ مِن سُحتٍ أبدًا، النَّارُ أَولى به. يا كَعْبُ بنَ عُجْرةَ، النَّاسُ غاديانِ؛ فمُبتاعٌ نفْسَه فمُعتِقُها، أو قال: فمُوبِقُها."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح الإسناد، ولم يخرجاه","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"0TB3rhhe","merged":2,"otherRefs":["تخريج المسند لشعيب 15284 (صحيح)"]},{"id":"س-06601","fp":"f54140c6fe92","stateId":250,"easy":"إذا غشيت أبواب الظلمة فصدقتهم وأعنتهم ← فلست من النبي ﷺ ولا ترد عليه الحوض","cause":"فمَن غَشى أبوابَهم فصدَّقهم في كذبِهم وأعانَهم على ظلمِهم","result":"فليس مِني ولستُ منه ، ولا يَرِدُ عليَّ الحوضَ","explicit":true,"otherNeedIds":[57,50],"ref":"تخريج سنن الترمذي 2/513","srcLabel":"الترمذي","text":["عن كعبِ بنِ عُجرةَ قال : قال لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : أعيذُكَ باللهِ يا كعبُ بنَ عُجرةَ مِن أمراءٍ يكونونَ مِن بعدي ، ",["فمَن غَشى أبوابَهم فصدَّقهم في كذبِهم وأعانَهم على ظلمِهم ",1],["فليس مِني ولستُ منه ، ولا يَرِدُ عليَّ الحوضَ ، ",2],"ومَن غَشى أبوابَهم أو لم يَغشَ فلم يصدِّقْهم في كذبِهم ولم يُعِنْهم على ظلمِهم فهو مِني وأنا منه ، وسيرِدُ عليَّ الحوضَ . يا كعبُ بنَ عُجرةَ ! الصلاةُ برهانٌ ، والصومُ جُنَّةٌ حصينةٌ ، والصدقةُ تُطفِئُ الخطيئةَ كما يُطفِئُ الماءُ النارَ . يا كعبُ بنَ عُجرةَ ! إنه لا يَربو لحمٌ نبَت مِن سُحتٍ إلا كانَتِ النارُ أَولى به ."],"grade":"صحيح","narrator":"كعب بن عجرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (614) بلفظه، والنسائي (4207)، والطبراني (19/ 105) (212) بنحوه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"AS7E5T0c","merged":2,"otherRefs":["مجمع الزوائد 5/250 (صحيح)"]},{"id":"س-08004","fp":"397cf6c961a0","stateId":250,"easy":"إذا جرت وأنت قاضٍ ← يتبرأ الله منك ويلزمك الشيطان","cause":"فإذا جَارَ","result":"تَبَرَّأَ منهُ، وألْزَمَهُ الشيطانُ","explicit":true,"similar":["س-01673"],"otherNeedIds":[32,50],"ref":"الجامع الصغير 1798","srcLabel":"الترمذي","text":["إنَّ اللهَ تعالى معَ القاضِي ما لمْ يَجُرْ،  ",["فإذا جَارَ",1]," ",["تَبَرَّأَ منهُ،  وألْزَمَهُ الشيطانُ",2]],"grade":"صحيح","narrator":"عبدالله بن أبي أوفى","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1330)، وابن ماجه (2312) باختلاف يسير","bab":"مظالم › تحريم الظلم","dorar":"M1BDeNQE","merged":2,"otherRefs":["فيض القدير 5/ 492 (حسن)"]},{"id":"س-08005","fp":"954e772123c1","stateId":250,"easy":"إذا أعنت الظلمة وصدقتهم بكذبهم ← فلست من النبي ﷺ","cause":"فمَن أعانَهم على ظُلمِهم وصَدَّقَهم بكَذِبِهم","result":"فليس مِنِّي ولا أنا منه","explicit":true,"repOf":"س-06574","otherNeedIds":[57],"ref":"تخريج المسند لشعيب 11873","text":["سيكونُ أُمراءُ يَغْشاهم غَواشٍ أو حَواشٍ من النَّاسِ، يَظلِمون ويَكذِبون، ",["فمَن أعانَهم على ظُلمِهم وصَدَّقَهم بكَذِبِهم، ",1],["فليس مِنِّي ولا أنا منه، ",2],"ومَن لم يُصدِّقْهم بكَذِبِهم، ولم يُعِنْهم على ظُلْمِهم، فأنا منه وهو مِنِّي."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (11873) واللفظ له، والطيالسي (2337)، وأبو يعلى (1286) باختلاف يسير.","bab":"مظالم › تحريم الظلم","dorar":"SdYvQuuz","merged":2,"otherRefs":["صحيح ابن حبان 286 (صحيح)"]},{"id":"س-00823","fp":"3e0f4babcd34","stateId":250,"easy":"إذا ولّيت على المسلمين أحداً محاباة ← فعليك لعنة الله ولا يُقبل منك","cause":"مَن وَلِيَ مِن أمْرِ المُسلِمينَ شيئًا، فأمَّرَ عليهِم أحدًا مُحاباةً","result":"فعليهِ لَعنةُ اللهِ، لا يَقبَلُ اللهُ منهُ صَرْفًا، ولا عَدْلًا حتَّى يُدْخِلَه جهَنَّمَ","explicit":true,"otherNeedIds":[45],"ref":"المستدرك على الصحيحين 7219","srcLabel":"أحمد","text":["عنْ يَزيدَ بنِ أبي سُفْيانَ، قالَ: قال لي أبو بَكْرٍ الصِّدِّيقُ رَضيَ اللهُ عنه حينَ بَعَثَني إلى الشَّامِ: يا يَزيدُ، إنَّ لكَ قَرابةً عَسَيْتَ أنْ تُؤْثِرَهم بالإمارةِ، ذلكَ أكثَرُ ما أخافُ عليكَ؛ فقدْ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["مَن وَلِيَ مِن أمْرِ المُسلِمينَ شيئًا، فأمَّرَ عليهِم أحدًا مُحاباةً؛ ",1],["فعليهِ لَعنةُ اللهِ، لا يَقبَلُ اللهُ منهُ صَرْفًا، ولا عَدْلًا حتَّى يُدْخِلَه جهَنَّمَ",2],"."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (21) بزيادة في آخره، والبزار (101)، والطبراني ((مسند الشاميين)) (3572) مختصرا بنحوه.","bab":"أدعية وأذكار › دعاء النبي على بعض الأشخاص والأشياء والأمور","dorar":"SXhy7Zpn"},{"id":"س-01189","fp":"3f9fbd9ac6b4","stateId":250,"easy":"إذا حالت شفاعتك دون حد من حدود الله ← فقد ضاددت الله في أمره","cause":"من حالتْ شفاعتُهُ دونَ حَدٍّ من حدودِ اللهِ","result":"فهو مُضَادُّ اللهِ في أمرِهِ","explicit":true,"repOf":"س-05082","ref":"تخريج المسند لشاكر 7/255","text":["عن أيوب بن سلمان رجل من أهل صنعاء قال: كنَّا بمكةَ فجلسنا إلى عطاءٍ الخراسانيِّ إلى جنبِ جدارِ المسجدِ فلم نسألْه ولم يُحدِّثْنا قال ثم جلسنا إلى ابنِ عمرَ مثلَ مجلسِكم هذا فلمْ نسألْه ولم يُحدِّثْنا قال فقال ما بالُكم لا تتكلَّمونَ ولا تذكرونَ اللهَ قولوا اللهُ أكبرُ والحمدُ للهِ وسبحانَ اللهِ وبحمدِهِ بواحدةٍ عشرًا وبعشرٍ مائةً من زادَ زادهُ اللهُ ومن سكتَ غُفِرَ لهُ ألا أُخبرُكم بخمسٍ سمعتهنَّ من رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ؟ قالوا : بَلَى قال ",["من حالتْ شفاعتُهُ دونَ حَدٍّ من حدودِ اللهِ",1]," ",["فهو مُضَادُّ اللهِ في أمرِهِ",2]," ومن أعانَ على خصومةٍ بغيرِ حقٍّ فهو مُستظلٌّ في سخطِ اللهِ حتى يتركَ ومن قَفَا مؤمنًا أو مؤمنةً حبسهُ اللهُ في رَدْغَةِ الخَبَالِ عصارةِ أهلِ النارِ ومن ماتَ وعليهِ دَيْنٌ أُخِذَ لصاحبِه من حسناتِه لا دينارَ ثَمَّ ولا درهمَ وركعتا الفجرِ، حافظوا عليهما فإنَّهما من الفضائلِ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (5544)","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"2sGjBDac"},{"id":"س-01673","fp":"d9fbde798120","stateId":250,"easy":"إذا جرت وأنت قاضٍ ← يتبرأ الله منك","cause":"فإذا جارَ","result":"تبَرَّأَ اللهُ عزَّ وجلَّ منْه","explicit":true,"repOf":"س-08004","otherNeedIds":[32],"ref":"المستدرك على الصحيحين 7221","text":["إنَّ اللهَ مع القاضي ما لم يَجُرْ، ",["فإذا جارَ",1]," ",["تبَرَّأَ اللهُ عزَّ وجلَّ منْه",2],"."],"grade":"صحيح","narrator":"عبدالله بن أبي أوفى","muhaddith":"إسناده صحيح","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"Q0QNIuwZ"},{"id":"س-01707","fp":"ea8efaac7d57","stateId":250,"easy":"إذا حلت دون إقامة القصاص ← فعليك لعنة الله وغضبه ولا يُقبل منك","cause":"ومَن حال دونَه","result":"فعليه لعنةُ اللهِ وغضَبُه، لا يُقبَلُ منه صَرفٌ، ولا عَدلٌ","explicit":true,"similar":["س-04951"],"otherNeedIds":[45],"ref":"تخريج سنن أبي داود 4539","srcLabel":"البيهقي","text":["مَن قُتِل في عِمِّيَّا، في رِمِّيَّا، يكونُ بينَهم بحِجارةٍ، أو بالسِّياطِ، أو ضُرِب بعصًا فهو خطَأٌ، وعَقْلُه عَقْلُ الخطَأِ، ومَن قُتِل عَمدًا فهو قَوَدٌ -قال ابنُ عُبَيدٍ: قَوَدُ يَدٍ، ثم اتَّفَقا- ",["ومَن حال دونَه، ",1],["فعليه لعنةُ اللهِ وغضَبُه، لا يُقبَلُ منه صَرفٌ، ولا عَدلٌ",2],"."],"grade":"صحيح","narrator":"طاووس بن كيسان اليماني","muhaddith":"صحيح","takhrij":"أخرجه الشافعي في ((المسند)) (330)، والدارقطني (3/93)، والبيهقي (16423) باختلاف يسير","bab":"أقضية وأحكام › قضايا حكم فيها النبي صلى الله عليه وسلم","dorar":"N8EKL35P"},{"id":"س-04579","fp":"729fb584af50","stateId":250,"easy":"إذا حالت شفاعتك دون حد من حدود الله ← تبقى في سخط الله حتى تنزع","cause":"أَيُّما رجلٍ حالت شفاعتُه دونَ حَدٍّ من حدودِ اللهِ تعالى","result":"لم يَزَلْ في سَخَطِ اللهِ تعالى حتى يَنْزِعَ","explicit":true,"ref":"الجامع الصغير 2951","srcLabel":"الطبراني","text":[["أَيُّما رجلٍ حالت شفاعتُه دونَ حَدٍّ من حدودِ اللهِ تعالى ، ",1],["لم يَزَلْ في سَخَطِ اللهِ تعالى حتى يَنْزِعَ ، ",2],"وأَيُّما رجلٍ شَدَّ غضبًا على مسلمٍ في خصومةٍ لا عِلْمَ له بها ، فقد عاند اللهَ حَقَّهُ ، وحَرَصَ ، على سَخَطِهِ ، وعليه لعنةُ اللهِ المتتابِعَةُ إلى يومِ القيامةِ ، وأَيُّما رجلٍ أشاع على رجلٍ مسلمٍ بكَلِمَةٍ وهو منها بريءٌ يُشِينُه بها في الدنيا ؛ كان حَقًّا على اللهِ أن يُدْنِيَه يومَ القيامةِ في النارِ ، حتى يَأْتِيَ بإنفاذِ ما قال"],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه الطبراني كما في ((الجامع الصغير)) للسيوطي (1/260)","bab":"حدود › الحث على إقامة الحدود","dorar":"sPYe1Im7"},{"id":"س-04951","fp":"04da61cbffca","stateId":250,"easy":"إذا حلت دون القصاص ← فعليك لعنة الله والملائكة والناس","cause":"مَن حالَ دونَه","result":"فعليه لَعنةُ اللهِ والملائكةِ والنَّاسِ أجمعينَ","explicit":true,"repOf":"س-01707","ref":"تخريج سنن الدارقطني 3132","text":["مَن قُتِلَ في عِمِّيَّا أو رِمِّيَّا فهو خَطأٌ، وديَتُه ديَةُ خَطأٍ، ومَن قتَلَ عَمدًا فهو قَودُ يَدِه، ",["مَن حالَ دونَه",1]," ",["فعليه لَعنةُ اللهِ والملائكةِ والنَّاسِ أجمعينَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4591)، والنسائي (4789)، وابن ماجه (2635) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"euoGkcZz"},{"id":"س-07434","fp":"20b1c059eb86","stateId":250,"easy":"إذا صدقت الظلمة بكذبهم ومالأتهم على ظلمهم ← فلست من النبي ﷺ","cause":"فمَن صَدَّقَهم بكَذِبِهم، ومالَأَهم على ظُلمِه","result":"فليس منِّي، ولا أنا منه","explicit":true,"repOf":"س-06582","otherNeedIds":[57],"ref":"تخريج المسند لشعيب 18353","text":["خَرَجَ علينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، ونحن في المسجدِ بعدَ صَلاةِ العِشاءِ، رَفَعَ بَصرَه إلى السَّماءِ، ثُمَّ خَفَضَ، حتى ظَنَنَّا أنَّه قد حَدَثَ في السَّماءِ شيءٌ، فقال: ألَا إنَّه سيَكونُ بعدي أُمَراءُ يَكذِبونَ ويَظلِمونَ، ",["فمَن صَدَّقَهم بكَذِبِهم، ومالَأَهم على ظُلمِه؛ ",1],["فليس منِّي، ولا أنا منه، ",2],"ومَن لم يُصدِّقْهم بكَذِبِهم، ولم يُمالِئْهم على ظُلمِهم؛ فهو منِّي، وأنا منه، ألَا وإنَّ دَمَ المُسلمِ كفَّارتُه، ألَا وإنَّ سُبحانَ اللهِ، والحَمدُ للهِ، ولا إلهَ إلَّا اللهُ، واللهُ أكبرُ هنَّ الباقياتُ الصَّالحاتُ."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (18353)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"xakRCxUz"},{"id":"س-07997","fp":"aa96dd434c20","stateId":250,"easy":"إذا صدقت الظلمة بكذبهم وأعنتهم ← لست من النبي ﷺ ولا ترد عليه الحوض","cause":"فصدَّقَهم في كذبِهم ، وأعانهم على ظلمِهم","result":"فليس مني ، ولا أنا منه ، ولا هو واردٌ علي الحوضِ يومَ القيامةِ","explicit":true,"repOf":"س-06582","otherNeedIds":[57],"ref":"الفتح الرباني 9/4671","text":["غشي إيوانَهم ",["فصدَّقَهم في كذبِهم ، وأعانهم على ظلمِهم",1]," ، ",["فليس مني ، ولا أنا منه ، ولا هو واردٌ علي الحوضِ يومَ القيامةِ",2]," ، ومن غشيها أو لم يغشها فلم يصدِّقْهم في كذبِهم ، ولم يعنْهم على ظلمِهم ، فهو مني ، وأنا منه ، وهو واردٌ علي الحوضِ يومَ القيامةِ"],"grade":"صحيح","muhaddith":"صحيح","bab":"مظالم › تحريم الظلم","dorar":"M8iyLUms"},{"id":"س-03026","fp":"444dc5a3fe9c","stateId":250,"easy":"إذا جُرت في الحكم أو ظلمت في القسم أو قطعت الرحم ← فليس منك النبي ﷺ ولست منه","cause":"ما عدَلَ في الحُكمِ، وقسَطَ في القِسطِ، ورَحِمَ ذا الرَّحِمِ، فمَن فعَلَ غيرَ ذلك","result":"فليس منِّي ولستُ منه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج سنن أبي داود 4/592","srcLabel":"البخاري","text":["قيل: يا رسولَ اللهِ، ما للخليفةِ مِن بعدِك؟ قال: \"مِثلُ الذي لي، ",["ما عدَلَ في الحُكمِ، وقسَطَ في القِسطِ، ورَحِمَ ذا الرَّحِمِ، فمَن فعَلَ غيرَ ذلك",1]," ",["فليس منِّي ولستُ منه",2],"\"."],"grade":"صحيح","narrator":"سعد بن تميم السكوني","muhaddith":"سنده صحيح","takhrij":"أخرجه الفسوي في ((المعرفة والتاريخ)) (1/ 279) باختلاف يسير، وأبو نعيم في ((معرفة الصحابة)) (3211) مطولًا،  والبخاري في ((التاريخ الكبير)) (4/ 46) مختصرًا.","bab":"إيمان › الوعيد","dorar":"8rZxBr1y"},{"id":"س-03153","fp":"3b53ada27050","stateId":250,"easy":"إذا وليت أعداء الأمة أمرها ← أسخطت الله إلى يوم تلقاه","cause":"فعمَدُوا إلى عدوِّهم فاستعملُوهم وسلَّطُوهم","result":"فأسخطوا اللهَ عليهم إلى يومِ يَلْقَوْنَه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تفسير القرآن العظيم 1/328","srcLabel":"أحمد","text":["ضرب لنا رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم أمثالًا واحدًا وثلاثةً وخمسةً وسبعةً وتسعةً وأحدَ عشرَ فضرب لنا رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم منها مثلًا وترك سائِرَها قال إنَّ قومًا كانوا أهلَ ضعفٍ ومسكنةٍ قاتلَهُم أهلُ تجبُّرٍ وعداءٍ فأظهر اللهُ أهلَ الضعفِ عليهم ",["فعمَدُوا إلى عدوِّهم فاستعملُوهم وسلَّطُوهم",1]," ",["فأسخطوا اللهَ عليهم إلى يومِ يَلْقَوْنَه",2]],"grade":"حسن","narrator":"حذيفة بن اليمان","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (23462) بلفظه، وابن أبي شيبة (38359) باختلاف يسير.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"xFmeMG1f"},{"id":"ق-0771","fp":"6236a90449c6","stateId":251,"easy":"الطغيان في رزق الله ← حلول غضب الله والهويّ","cause":"الطغيان في رزق الله","result":"حلول غضب الله والهويّ","explicit":true,"star":true,"otherNeedIds":[49],"ref":"سورة طه: 81","srcLabel":"القرآن الكريم","quran":{"s":20,"from":81,"to":81,"text":"كُلُوا مِنْ طَيِّبَاتِ مَا رَزَقْنَاكُمْ وَلَا تَطْغَوْا فِيهِ فَيَحِلَّ عَلَيْكُمْ غَضَبِي وَمَنْ يَحْلِلْ عَلَيْهِ غَضَبِي فَقَدْ هَوَى (81)","hl":[[41,137,1]]}},{"id":"س-02568","fp":"ef1d12f2e03d","stateId":251,"easy":"إذا أصبحت وهمّك غير الله ← فلست من الله","cause":"من أصبحَ وَهَمُّهُ غيرُ اللَّهِ","result":"فليسَ منَ اللَّهِ","explicit":true,"star":true,"ref":"الجامع الصغير 8434","srcLabel":"الحاكم","text":[["من أصبحَ وَهَمُّهُ غيرُ اللَّهِ ",1],["فليسَ منَ اللَّهِ ",2],"ومَن أصبحَ لا يَهتمُّ بالمسلمينَ فليسَ مِنهُم"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (7902)، وابن بشران في ((أماليه)) (545) واللفظ لهما.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"lc5fl8Mm"},{"id":"س-02569","fp":"6117155a7b3d","stateId":251,"easy":"إذا أصبحت لا تهتم بأمر المسلمين ← فلست منهم","cause":"ومَن أصبحَ لا يَهتمُّ بالمسلمينَ","result":"فليسَ مِنهُم","explicit":true,"ref":"الجامع الصغير 8434","srcLabel":"الحاكم","text":["من أصبحَ وَهَمُّهُ غيرُ اللَّهِ فليسَ منَ اللَّهِ ",["ومَن أصبحَ لا يَهتمُّ بالمسلمينَ ",1],["فليسَ مِنهُم",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (7902)، وابن بشران في ((أماليه)) (545) واللفظ لهما.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"lc5fl8Mm"},{"id":"س-06961","fp":"0595e8b9ad31","stateId":251,"easy":"إذا أعرضت عن مجلس الذكر ← يعرض الله عنك","cause":"وأمَّا الآخَرُ فأعرَضَ","result":"فأعرَضَ اللهُ عنه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[26],"ref":"صحيح مسلم 2176","srcLabel":"السنة","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم بينَما هو جالِسٌ في المَسجِدِ والنَّاسُ معهُ، إذ أقبَلَ نَفَرٌ ثَلاثةٌ، فأقبَلَ اثنانِ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، وذَهَبَ واحِدٌ، قال: فوقَفا على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فأمَّا أحَدُهما فرَأى فُرجةً في الحَلقةِ فجَلَسَ فيها، وأمَّا الآخَرُ فجَلَسَ خَلفَهُم، وأمَّا الثَّالِثُ فأدبَرَ ذاهِبًا، فلَمَّا فرَغَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم قال: ألا أُخبِرُكُم عَنِ النَّفَرِ الثَّلاثةِ؟ أمَّا أحَدُهم فأوى إلى اللهِ، فآواه اللهُ، وأمَّا الآخَرُ فاستَحيا، فاستَحيا اللهُ منه، ",["وأمَّا الآخَرُ فأعرَضَ",1],"، ",["فأعرَضَ اللهُ عنه",2],"."],"grade":"صحيح","narrator":"أبو واقد الليثي","muhaddith":"[صحيح]","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"KoGQui4z","merged":4,"otherRefs":["المستدرك على الصحيحين 7862 (صحيح)","تفسير القرآن العظيم 8/73 (صحيح)","مجمع الزوائد 8/306 (حسن)"]},{"id":"س-06844","fp":"b0266cc412b2","stateId":251,"easy":"إذا آثرت دنياك على دينك ← يقول الله: كذبتم","cause":"يُؤْثِرُوا سَفْعَةَ دنياهم على دينِهِم","result":"قال اللهُ كَذَبْتُمْ","explicit":true,"ref":"مجمع الزوائد 7/280","srcLabel":"ابن أبي الدنيا","text":["لا إلهَ إلَّا اللهُ تمنَعُ [ العبدَ ] مِنْ سخَطِ اللهِ مَا لَمْ ",["يُؤْثِرُوا سَفْعَةَ دنياهم على دينِهِم",1]," فإِذَا فعَلُوا ذَلِكَ ثم قالوا لَا إِلَهَ إلَّا اللهُ ",["قال اللهُ كَذَبْتُمْ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن أبي الدنيا في ((العقوبات)) (6)، والبزار كما في ((مجمع الزوائد)) (7/280) واللفظ له، وأبو يعلى (4034)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"jDMn61nP"},{"id":"س-06890","fp":"93fe3da24ca6","stateId":251,"easy":"إذا طلبت الدنيا حلالاً تكاثراً وتفاخراً ← تلقى الله وهو عليك غضبان","cause":"ومن طلبَ الدُّنيا حلالًا مُكاثِرًا","result":"لقيَ اللَّهَ وَهوَ عليْهِ غضبانُ","explicit":true,"ref":"الآداب الشرعية 3/260","srcLabel":"الطبراني","text":["من طلبَ الدُّنيا حلالًا ، استعفافًا عن المسألةِ ، وسعيًا على أَهلِهِ وتعطُّفًا على جارِهِ جاءَ يومَ القيامةِ ووجْهُهُ كالقمرِ ليلةَ البدرِ ",["ومن طلبَ الدُّنيا حلالًا مُكاثِرًا ",1],["لقيَ اللَّهَ وَهوَ عليْهِ غضبانُ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه عبد بن حميد في ((المسند)) (1431)، وابن أبي الدنيا في ((النفقة على العيال)) (32)، والطبراني في ((مسند الشاميين)) (3465) باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"akZUgD4A"},{"id":"س-02579","fp":"73507687cfb7","stateId":252,"easy":"إذا بتّ على سطح ليس حوله ما يمنع سقوطك ← فقد برئت منك الذمة","cause":"مَن بات فوقَ إجَّارٍ أو فوقَ بيتٍ ليس حولَه شيءٌ يرُدُّ رِجلَه","result":"فقد برِئت منه الذِّمَّةُ","explicit":true,"star":true,"similar":["س-05213"],"otherNeedIds":[49],"ref":"مجمع الزوائد 8/102","srcLabel":"البخاري","text":[["مَن بات فوقَ إجَّارٍ أو فوقَ بيتٍ ليس حولَه شيءٌ يرُدُّ رِجلَه",1]," ",["فقد برِئت منه الذِّمَّةُ",2]," ومَن ركِب البحرَ بعدَما يرتَجُّ فقد برِئت منه الذِّمَّةُ"],"grade":"صحيح","narrator":"رجل","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (20749)، وأبو نعيم في ((معرفة الصحابة)) (7215) بلفظه، والبخاري في ((الأدب المفرد)) (1194) باختلاف يسير.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"uhTDYoGy"},{"id":"س-02580","fp":"50eeb0e20b7f","stateId":252,"easy":"إذا ركبت البحر وهو هائج ← فقد برئت منك الذمة","cause":"ومَن ركِب البحرَ بعدَما يرتَجُّ","result":"فقد برِئت منه الذِّمَّةُ","explicit":true,"star":true,"similar":["س-03611"],"otherNeedIds":[49],"ref":"مجمع الزوائد 8/102","srcLabel":"البخاري","text":["مَن بات فوقَ إجَّارٍ أو فوقَ بيتٍ ليس حولَه شيءٌ يرُدُّ رِجلَه فقد برِئت منه الذِّمَّةُ ",["ومَن ركِب البحرَ بعدَما يرتَجُّ",1]," ",["فقد برِئت منه الذِّمَّةُ",2]],"grade":"صحيح","narrator":"رجل","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (20749)، وأبو نعيم في ((معرفة الصحابة)) (7215) بلفظه، والبخاري في ((الأدب المفرد)) (1194) باختلاف يسير.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"uhTDYoGy"},{"id":"س-05213","fp":"1e36a9bfaa8b","stateId":252,"easy":"إذا بتّ على سطح ليس عليه حاجز ← برئت منك الذمة","cause":"مَنْ باتَ علَى ظهرِ بيتٍ ليسَ علَيْهِ حجابٌ","result":"فقَدْ برئَتْ مِنْهُ الذِّمَّةُ","explicit":true,"repOf":"س-02579","otherNeedIds":[49],"ref":"صحيح الجامع 6113","text":[["مَنْ باتَ علَى ظهرِ بيتٍ ليسَ علَيْهِ حجابٌ",1]," ، ",["فقَدْ برئَتْ مِنْهُ الذِّمَّةُ",2]],"grade":"صحيح","narrator":"علي بن شيبان","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5041)، والبخاري في ((الأدب المفرد)) (1192) واللفظ له، وأبو نعيم في ((معرفة الصحابة)) (4953).","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"xIK9aqGp"},{"id":"س-05881","fp":"072717d9edd6","stateId":252,"easy":"إذا وجدت الحية ذات الخطين أو الأبتر فلم تقتلها ← فلست منا","cause":"فمَن وجَد ذا الطُّفْيَتَيْنِ والأبترَ فلم يقتُلْهما","result":"فليس منَّا","explicit":true,"star":true,"ref":"تخريج صحيح ابن حبان 5638","srcLabel":"متفق عليه","text":["( اقتُلوا الحيَّاتِ واقتُلوا ذات الطُّفْيَتَيْنِ والأبترَ فإنَّهما يلتمِسانِ البصرَ ويُسقِطانِ الحَبَلَ ) [ثم أورَده مِن طريقٍ آخَرَ] عن النَّبيِّ صلَّى اللهُ عليه وسلَّم بذلك وقال: ",["فمَن وجَد ذا الطُّفْيَتَيْنِ والأبترَ فلم يقتُلْهما ",1],["فليس منَّا",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح على شرط مسلم [والطريق الثاني] إسناده صحيح","takhrij":"أخرجه البخاري (3297)، ومسلم (2233). واللفظ الآخر: أخرجه أخرجه الطحاوي في ((شرح مشكل الآثار)) (2927)، والطبراني (12/296) (13161)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"50Tx6HK0"},{"id":"س-05908","fp":"7816b4a8f9a6","stateId":252,"easy":"إذا تركت الحيات خوفاً منها ← فلست منا","cause":"فمَن تَرَكَهنَّ خيفَتَهنَّ","result":"فليس مِنَّا","explicit":true,"star":true,"similar":["س-05206","س-03642","س-03718"],"ref":"تخريج مشكل الآثار 1339","srcLabel":"مسلم","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ للحيَّاتِ: ما سالَمْناهنَّ منذُ حارَبْناهنَّ، ",["فمَن تَرَكَهنَّ خيفَتَهنَّ ",1],["فليس مِنَّا",2],"."],"grade":"صحيح","narrator":"عبدالله [بن مسعود]","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (1338) بلفظه، والدينوري في ((المجالسة وجواهر العلم)) (1762)، وأبو بكر الشافعي في ((الفوائد)) (318) باختلاف يسير.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"zvRKrnIL"},{"id":"س-00318","fp":"2b0ff94a675a","stateId":252,"easy":"إذا لم ترحم صغيرنا ولم توقّر كبيرنا ← فلست منا","cause":"لم يرحَمْ صغيرَنا ولم يوقِّرْ كبيرَنا","result":"ليسَ منَّا من","explicit":true,"star":true,"ref":"صحيح الترمذي 1919","srcLabel":"الترمذي","text":["جاءَ شيخٌ يريدُ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ فأبطا القومُ أن يوسِّعوا لَه فقالَ ",["ليسَ منَّا من",2],[" لم يرحَمْ صغيرَنا ولم يوقِّرْ كبيرَنا",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1919) واللفظ له، وأبو يعلى (4241) باختلاف يسير، والحارث في ((المسند)) (798)، والعقيلي في ((الضعفاء الكبير)) (2/84) مختصرا.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"IAxJ8IMd","merged":9,"otherRefs":["الكبائر لابن عبدالوهاب 53 (حسن)","تخريج رياض الصالحين 1/ 141 (حسن)","المستدرك على الصحيحين 210 (صحيح)","تخريج المسند لشعيب 2329 (صحيح)","الجامع الصغير 7674 (حسن)","صحيح الأدب المفرد 272 (صحيح)","الترغيب والترهيب 1/90 (صحيح)","الضعفاء الكبير 2/84 (حسن)"]},{"id":"س-05206","fp":"468df83577e1","stateId":252,"easy":"إذا تركت قتل الحيات خوفاً ← فلست منا","cause":"ومَن تَرَك قَتْلَ شيءٍ مِنهُنَّ خِيفَةً","result":"فلَيس منَّا","explicit":true,"repOf":"س-05908","ref":"صحيح الترغيب 2983","text":["ما سالَمْناهُنَّ منذُ حارَبْناهُنَّ - يَعني الحيَّاتِ -، ",["ومَن تَرَك قَتْلَ شيءٍ مِنهُنَّ خِيفَةً ",1],["فلَيس منَّا",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه أبو داود (5248)، وأحمد (10741) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"TcD8huir","merged":5,"otherRefs":["تخريج سنن أبي داود 5248 (صحيح)","تخريج المسند لشعيب 9588 (حسن)","هداية الرواة 4/132 (حسن)","هداية الرواة 4067 (حسن)"]},{"id":"س-08275","fp":"c0fcb4ab0a8b","stateId":252,"easy":"إذا قعدت وسط الحلقة ← فأنت ملعون على لسان محمد ﷺ","cause":"مَنْ قَعَدَ وسَطَ الحلَقَةِ","result":"مَلْعونٌ على لِسانِ مُحمدٍ","explicit":true,"ref":"سنن الترمذي 2753","srcLabel":"أبو داود","text":[["مَلْعونٌ على لِسانِ مُحمدٍ",2],"، أوْ لَعَنَ اللهُ على لِسانِ مُحمدٍ ",["مَنْ قَعَدَ وسَطَ الحلَقَةِ",1]],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"حسن صحيح","takhrij":"أخرجه أحمد (23376)، والبيهقي (5975)، والطيالسي في ((المسند)) (436)  جميعًا بلفظ مقارب، وفي أوله قصة، وأخرجه أبو داود (4826) بنحوه مختصرًا","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"kIB8qv52","merged":4,"otherRefs":["الأحكام الشرعية الصغرى 831 (صحيح)","الأحكام الوسطى 4/ 223 (صحيح)","تنبيه الغافلين 259 (حسن)"]},{"id":"س-08276","fp":"19464f2d7165","stateId":252,"easy":"إذا أكثرت المرأة من زيارة القبور ← لعنها الله","cause":"زواراتِ القبورِ","result":"لعنَ اللهُ","explicit":true,"similar":["س-03085"],"ref":"الجامع الصغير 7259","srcLabel":"السنة","text":[["لعنَ اللهُ",2],[" زواراتِ القبورِ ",1],"[حديث حسان بن ثابت: لَعَن رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ زَوَّاراتِ القُبورِ.]                           [وحديث أبي هريرة: لعنَ اللهُ زواراتِ القبورِ]"],"grade":"صحيح","narrator":"حسان بن ثابت وأبو هريرة","muhaddith":"صحيح","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"7mjouycf","merged":4,"otherRefs":["فتاوى نور على الدرب لابن باز 14/458 (صحيح)","الفتاوى الكبرى 4/356 (صحيح)","الجامع الصغير 7258 (صحيح)"]},{"id":"س-05018","fp":"8b611b047fe4","stateId":252,"easy":"إذا بتّ على سطح بلا حاجز فوقعت فمت ← برئت منك الذمة","cause":"من بات على إنجارٍ فوقع منه فمات","result":"بَرِئَتْ منه الذِّمَّةُ","explicit":true,"similar":["س-04798"],"otherNeedIds":[49],"ref":"صحيح الأدب المفرد 909","srcLabel":"البخاري","text":[["من بات على إنجارٍ فوقع منه فمات",1]," ",["بَرِئَتْ منه الذِّمَّةُ",2]," ، و من ركب البحرَ حين يرتَجُّ يعني يغْتَلِمُ فهلك بَرِئَتْ منه الذِّمَّةُ"],"grade":"حسن","narrator":"رجل من الصحابة","muhaddith":"حسن","takhrij":"أخرجه أبو داود (5041) بلفظه، والبخاري في ((الأدب المفرد)) (1192)، والبيهقي في ((الآداب)) (674) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"vUfHpdzE"},{"id":"س-05019","fp":"12da38b8c7d0","stateId":252,"easy":"إذا ركبت البحر حين يهيج فهلكت ← برئت منك الذمة","cause":"و من ركب البحرَ حين يرتَجُّ يعني يغْتَلِمُ فهلك","result":"بَرِئَتْ منه الذِّمَّةُ","explicit":true,"otherNeedIds":[49],"ref":"صحيح الأدب المفرد 909","srcLabel":"البخاري","text":["من بات على إنجارٍ فوقع منه فمات بَرِئَتْ منه الذِّمَّةُ ، ",["و من ركب البحرَ حين يرتَجُّ يعني يغْتَلِمُ فهلك",1]," ",["بَرِئَتْ منه الذِّمَّةُ",2]],"grade":"حسن","narrator":"رجل من الصحابة","muhaddith":"حسن","takhrij":"أخرجه أبو داود (5041) بلفظه، والبخاري في ((الأدب المفرد)) (1192)، والبيهقي في ((الآداب)) (674) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"vUfHpdzE"},{"id":"س-05257","fp":"09d4e5bf5692","stateId":252,"easy":"إذا نبشت القبور ← لعنك النبي ﷺ","cause":"المُخْتَفيَ والمُخْتَفيةَ","result":"لَعَنَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ","explicit":true,"ref":"الأحكام الوسطى 2/149","srcLabel":"البيهقي","text":["[",["لَعَنَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ",2]," ",["المُخْتَفيَ والمُخْتَفيةَ",1],"، يَعْني نُبَّاشَ القُبورِ]."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه عبد الرزاق (18888)، والبيهقي (17326)، والعقيلي في ((الضعفاء الكبير)) (4/  408) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"nEmCyFIF","merged":3,"otherRefs":["السلسلة الصحيحة 2148 (صحيح)","صحيح الجامع 5102 (صحيح)"]},{"id":"س-00329","fp":"8a274bfd1f8c","stateId":252,"easy":"إذا لم تُجلّ كبيرنا وترحم صغيرنا وتعرف لعالمنا حقه ← فلست من الأمة","cause":"مَن لم يُجِلَّ كَبيرَنا، ويَرحَمْ صَغيرَنا، ويَعرِفْ لعالِمِنا","result":"ليس مِن أُمَّتي","explicit":true,"ref":"تخريج المسند لشعيب 22755","srcLabel":"أحمد","text":[["ليس مِن أُمَّتي",2]," ",["مَن لم يُجِلَّ كَبيرَنا، ويَرحَمْ صَغيرَنا، ويَعرِفْ لعالِمِنا",1],"، قال عبدُ اللهِ: وسَمِعتُه أنا مِن هارونَ."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح لغيره دون قوله: \"ويعرف لعالمنا\"","takhrij":"أخرجه أحمد (22755) واللفظ له، والطحاوي في ((شرح مشكل الآثار)) (1328)، والشاشي في ((المسند)) (1273)","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"zIOXcjCo","merged":2,"otherRefs":["صحيح الترغيب 101 (حسن)"]},{"id":"س-00816","fp":"c86254ddfee6","stateId":252,"easy":"إذا صوّرت ← لُعنت","cause":"المُصوِّرينَ","result":"لعَنَ","explicit":true,"similar":["س-08283"],"ref":"فتاوى نور على الدرب لابن عثيمين 1/487","srcLabel":"السنة","text":["عنه صلَّى اللهُ عليه وسلَّمَ أنَّه ",["لعَنَ",2]," ",["المُصوِّرينَ",1],"."],"grade":"صحيح","muhaddith":"[ثابت]","bab":"أدعية وأذكار › دعاء النبي على بعض الأشخاص والأشياء والأمور","dorar":"CeVUdm8h","merged":2,"otherRefs":["روضة الطالبين 7/336 (صحيح)"]},{"id":"س-05373","fp":"32b5d825e4bc","stateId":252,"easy":"إذا تركت قتل الحيات خشية ثأرها ← فلست منا","cause":"مَنْ ترَكَهُنَّ خَشيةً، أو مخافةَ ثائِرٍ","result":"فليسَ مِنَّا","explicit":true,"otherNeedIds":[49],"ref":"تخريج شرح السنة 3265","srcLabel":"أحمد","text":["أنَّهُ كانَ يأمُرُ بقتلِ الحيَّاتِ، وقالَ: ",["مَنْ ترَكَهُنَّ خَشيةً، أو مخافةَ ثائِرٍ، ",1],["فليسَ مِنَّا",2],"، قالَ: فقالَ ابنُ عبَّاسٍ: إنَّ الجانَّ مَسْخُ الجِنِّ، كَما مُسِخَتِ القِرَدةُ في بَنِي إسرائيلَ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (3254)، وعبدالرزاق (19617)، والطبراني (11/314) (11846) باختلاف يسير","bab":"رقائق وزهد › التوكل واليقين","dorar":"sopRKeZ6","merged":2,"otherRefs":["تخريج مشكل الآثار 2929 (صحيح)"]},{"id":"س-06771","fp":"c6a40e39ce6f","stateId":252,"easy":"إذا قضيت حاجتك في الموارد أو الطريق أو الظل ← جلبت اللعن على نفسك","cause":"البَرازَ في الموارِدِ، وقارِعَةِ الطَّريقِ، والظِّلِّ لِلْخِراءَةِ","result":"اتَّقوا المَلاعِنَ الثَّلاثَةَ","explicit":true,"similar":["س-00364"],"ref":"المستدرك على الصحيحين 604","srcLabel":"ابن ماجه","text":["«",["اتَّقوا المَلاعِنَ الثَّلاثَةَ",2],": ",["البَرازَ في الموارِدِ، وقارِعَةِ الطَّريقِ، والظِّلِّ لِلْخِراءَةِ",1],"»."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داوود (26)، وابن ماجه (328)، والطبراني (20/ 123) (247) جميعهم باختلاف يسير.","bab":"طهارة › إبعاد المتخلي واستتاره","dorar":"CX8Be16b","merged":2,"otherRefs":["شرح ابن ماجه لمغلطاي 1/149 (حسن)"]},{"id":"س-07504","fp":"93075ad6ada7","stateId":252,"easy":"إذا عقدت لحيتك أو تقلدت وتراً أو استنجيت بروث أو عظم ← فالنبي ﷺ منك بريء","cause":"مَن عقَدَ لِحيَتَه، أو تَقلَّدَ وَترًا، أوِ استَنْجى برَجيعِ دابَّةٍ، أو عَظمٍ","result":"فإنَّ مُحمَّدًا منه بَريءٌ","explicit":true,"ref":"تخريج سنن أبي داود 36","srcLabel":"النسائي","text":["أنَّ مَسلَمةَ بنَ مَخلَدٍ استَعمَلَ رُوَيفِعَ بنَ ثابتٍ على أسفلِ الأرضِ، قال شَيْبانُ: فسِرْنا معه مِن كُومِ شَريكٍ إلى عَلْقَماءَ، أو مِن عَلْقَماءَ إلى كُومِ شَريكٍ -يُريدُ عَلْقامَ- فقال رُوَيفِعٌ: إنْ كان أحَدُنا في زَمنِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ لَيأخُذُ نِضوَ أخيهِ على أنَّ له النصفَ ممَّا يَغنَمُ ولنا النصفَ، فإنْ كان أحَدُنا لَيَطيرُ له النَّصْلُ والرِّيشُ، وللآخَرِ القَدَحُ، ثم قال: قال لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: \"يا رُوَيفِعُ، لعلَّ الحياةَ ستَطولُ بكَ بَعْدي، فأخبِرِ الناسَ أنَّه ",["مَن عقَدَ لِحيَتَه، أو تَقلَّدَ وَترًا، أوِ استَنْجى برَجيعِ دابَّةٍ، أو عَظمٍ",1],"، ",["فإنَّ مُحمَّدًا منه بَريءٌ",2],"\"."],"grade":"صحيح","narrator":"رويفع بن ثابت الأنصاري","muhaddith":"صحيح","takhrij":"أخرجه النسائي (5067) دون القصة في أوله، وأحمد (16995) باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"uYDqUjeU","merged":2,"otherRefs":["الآداب الشرعية 3/140 (صحيح)"]},{"id":"س-00364","fp":"d4aa99f7d9c9","stateId":252,"easy":"إذا قضيت حاجتك في الظل أو الطريق أو موارد الماء ← جلبت على نفسك اللعن","cause":"أنْ يقعدَ أحدُكم في ظلٍّ يُستظلُ فيهِ، أو في طريقٍ، أو في نَقْعِ ماءٍ","result":"اتقوا الملاعنَ الثلاثَ","explicit":true,"repOf":"س-06771","ref":"الجامع الصغير 140","text":[["اتقوا الملاعنَ الثلاثَ",2]," : ",["أنْ يقعدَ أحدُكم في ظلٍّ يُستظلُ فيهِ،  أو في طريقٍ،  أو في نَقْعِ ماءٍ",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه أحمد (2715)، والخطابي في ((غريب الحديث)) (1/108) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"brCt03P3"},{"id":"س-00476","fp":"db688461cfea","stateId":252,"easy":"إذا لعبت بالشطرنج ← فأنت ملعون","cause":"من لعبَ بالشَّطرنجِ","result":"فَهوَ ملعونٌ","explicit":true,"ref":"كشف الخفاء 2/568","srcLabel":"ابن حجر","text":["اللَّعِبُ بالشَّطَرَنْجِ [يعني حديث: ",["من لعبَ بالشَّطرنجِ ",1],["فَهوَ ملعونٌ",2],"]"],"grade":"صحيح","narrator":"[أنس بن مالك]","muhaddith":"ليس فيه حديث صحيح","takhrij":"أخرجه ابن حجر في ((الغرائب الملتقطة)) (2505) بلفظه تاما.","bab":"آداب عامة › المباحات من الأفعال والأقوال","dorar":"UOTQtbg6"},{"id":"س-00485","fp":"471748eaff31","stateId":252,"easy":"إذا لم تأخذ من شاربك ← فلست منا","cause":"من لم يأخذ من شاربِهِ","result":"فليس مِنَّا","explicit":true,"ref":"تهذيب التهذيب 2/192","srcLabel":"السنة","text":["حديث  في أخذِ الشَّاربِ [يعني حديث: ",["من لم يأخذ من شاربِهِ ",1],["فليس مِنَّا",2],"]"],"grade":"صحيح","narrator":"[زيد بن أرقم]","muhaddith":"صحيح","bab":"آداب عامة › المباحات من الأفعال والأقوال","dorar":"BH3YiwjH"},{"id":"س-03085","fp":"88ef8123a95e","stateId":252,"easy":"إذا أكثرت المرأة من زيارة القبور ← لُعنت","cause":"زائراتِ القبورِ من النساءِ","result":"لعن","explicit":true,"repOf":"س-08276","ref":"مجموع فتاوى ابن باز 344/4","text":["[أن النبيَّ صلَّى اللهُ عليهِ وسلَّمَ ",["لعن",2]," ",["زائراتِ القبورِ من النساءِ",1],"]"],"grade":"صحيح","muhaddith":"[ثابت]","bab":"إيمان › الوعيد","dorar":"zHZHLb5O"},{"id":"س-03642","fp":"8772de6b30ab","stateId":252,"easy":"إذا تركت قتل الحيات خوفاً من ثأرها ← فلست منا","cause":"من خافَ ثأرَهنَّ","result":"فليسَ منَّا","explicit":true,"repOf":"س-05908","ref":"صحيح النسائي 3193","text":["أنَّهُ أمرَ بقتلِ الحيَّاتِ ، وقالَ : ",["من خافَ ثأرَهنَّ ",1],["فليسَ منَّا",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه النسائي (3193) واللفظ له، وأبو داود (5249)، والطبراني في ((المعجم الكبير)) (9/ 351) (9747) بنحوه.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"3sAYxkBC"},{"id":"س-03718","fp":"3c2d415324ef","stateId":252,"easy":"إذا تركت الحيات خوفاً من طلبها ← فلست منا","cause":"مَن ترَكَ الحَيَّاتِ مَخافةَ طَلَبِهِنَّ","result":"فليس مِنَّا","explicit":true,"repOf":"س-05908","ref":"تخريج المسند لشعيب 2037","text":[["مَن ترَكَ الحَيَّاتِ مَخافةَ طَلَبِهِنَّ، ",1],["فليس مِنَّا",2],"، ما سالَمْناهُنَّ مُنذُ حارَبْناهُنَّ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (5250)، وأحمد (2037)","bab":"اعتصام بالسنة › لزوم السنة","dorar":"YSjFEBt4"},{"id":"س-04798","fp":"4b02e3921b54","stateId":252,"easy":"إذا بتّ على سطح بلا حاجز فسقطت فمت ← برئت منك الذمة","cause":"من بات فوقَ بيتٍ ليس له إِجَّارٌ فوقع فمات","result":"فبَرِئَتْ منه الذِّمَّةُ","explicit":true,"repOf":"س-05018","otherNeedIds":[49],"ref":"السلسلة الصحيحة 828","text":[["من بات فوقَ بيتٍ ليس له إِجَّارٌ فوقع فمات",1]," ",["فبَرِئَتْ منه الذِّمَّةُ",2]," ، و من ركب البحرَ عند ارْتجاجِه فمات ، فقد بَرِئَتْ منه الذِّمَّةُ"],"grade":"صحيح","narrator":"بعض أصحاب النبي صلى الله عليه وسلم","muhaddith":"صحيح متصل الإسناد","takhrij":"أخرجه أحمد (20748) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"2N8ijbsB"},{"id":"س-04799","fp":"79e408ce80b6","stateId":252,"easy":"إذا ركبت البحر هائجاً فمت ← برئت منك الذمة","cause":"و من ركب البحرَ عند ارْتجاجِه فمات","result":"فقد بَرِئَتْ منه الذِّمَّةُ","explicit":true,"otherNeedIds":[49],"ref":"السلسلة الصحيحة 828","srcLabel":"أحمد","text":["من بات فوقَ بيتٍ ليس له إِجَّارٌ فوقع فمات فبَرِئَتْ منه الذِّمَّةُ ، ",["و من ركب البحرَ عند ارْتجاجِه فمات",1]," ، ",["فقد بَرِئَتْ منه الذِّمَّةُ",2]],"grade":"صحيح","narrator":"بعض أصحاب النبي صلى الله عليه وسلم","muhaddith":"صحيح متصل الإسناد","takhrij":"أخرجه أحمد (20748) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"2N8ijbsB"},{"id":"س-04901","fp":"3f7fb2dc8357","stateId":252,"easy":"إذا كشفت عورتك ← لا ينظر الله إليك","cause":"كاشِفِ عورةٍ","result":"لا ينظُرُ اللَّه إلى","explicit":true,"ref":"الجامع الصغير 5754","srcLabel":"الحاكم","text":["غطُّوا حُرمةُ عورتِه، فإنَّ حُرمة عورةِ الصَّغيرِ كحُرمةِ عورةِ الكبيرِ، و",["لا ينظُرُ اللَّه إلى",2]," ",["كاشِفِ عورةٍ",1]],"grade":"صحيح","narrator":"محمد بن عياض الزهري","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (5119) واللفظ له.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"FX9uNhEE"},{"id":"س-07003","fp":"a0fe4a5b4948","stateId":252,"easy":"إذا خفت ثأر الحيات فتركتها ← فلست من النبي ﷺ","cause":"فمَن خافَ ثَأرَهُنَّ","result":"فليس مِنِّي","explicit":true,"ref":"تخريج سنن أبي داود 5249","srcLabel":"أبو داود","text":["اقْتُلوا الحيَّاتِ كُلَّهُنَّ، ",["فمَن خافَ ثَأرَهُنَّ ",1],["فليس مِنِّي",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5249) واللفظ له، و النسائي (3193)، والطبراني في ((المعجم الكبير)) (9/ 351) (9747) بنحوه.","bab":"علم › الحث على الأخذ بالسنة","dorar":"1lA3BStp"},{"id":"س-07696","fp":"d958da7b1604","stateId":252,"easy":"إذا لم تتغنَّ بالقرآن ← فلست منا","cause":"لم يَتغَنَّ بالقُرآنِ","result":"ليس منَّا مَن","explicit":true,"ref":"صحيح أبي داود 1471","srcLabel":"أبو داود","text":["قَالَ عُبَيْدُ اللَّهِ بْنُ أَبِي يَزِيدَ: ‌مرَّ بنا أبو لُبابةَ، فاتَّبَعْناهُ حتى دخَل بيتَه، فدخَلْنا عليه، فإذا رجُلٌ رَثُّ البيتِ رَثُّ الهيئةِ، فسَمِعتُه يقولُ: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["ليس منَّا مَن",2],[" لم يَتغَنَّ بالقُرآنِ",1],"، قال: فقلتُ لابنِ أبي مُلَيْكةَ: يا أبا محمَّدٍ، أرأيتَ إذا لم يكُنْ حسَنَ الصوتِ؟ قال: يُحسِّنُه ما استطاع."],"grade":"صحيح","narrator":"أبو لبابة","muhaddith":"حسن صحيح","takhrij":"أخرجه أبو داود (1471)، وابن أبي عاصم في ((الآحاد والمثاني)) (1903)، والطحاوي في ((شرح مشكل الآثار)) (1308) واللفظ لهم جميعا وفيه قصة.","bab":"قرآن › آداب الناس كلهم مع القرآن","dorar":"Trrb63MO"},{"id":"س-08283","fp":"ba55b0c9f754","stateId":252,"easy":"إذا صوّرت ← لعنك النبي ﷺ","cause":"المصوِّرَ","result":"لعنَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ","explicit":true,"repOf":"س-00816","ref":"نخب الافكار 13/472","text":[["لعنَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ",2],[" المصوِّرَ",1]],"grade":"صحيح","narrator":"أبو جحيفة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطيالسي (1141)، والطحاوي في ((شرح معاني الآثار)) (6938)، والبيهقي (14685) واللفظ لهم.","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"vPWrnZcK"},{"id":"س-03611","fp":"7d7b0fae6e15","stateId":252,"easy":"إذا ركبت البحر وهو هائج ← برئت منك الذمة","cause":"مَن رَكِب البحرَ إذا ارتجَّ","result":"فقد بَرِئَت منه الذمةُ","explicit":true,"repOf":"س-02580","otherNeedIds":[49],"ref":"عمدة القاري 14/250","text":[["مَن رَكِب البحرَ إذا ارتجَّ",1]," ",["فقد بَرِئَت منه الذمةُ",2]," وفي روايةٍ فلا يلُومَنَّ إلا نفسَه"],"grade":"حسن","narrator":"زهير بن عبدالله","muhaddith":"زهير مختلف في صحبته [وروي] عن زهير عن رجل من الصحابة وإسناده حسن","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (4/ 178)، وأبو نعيم في ((معرفة الصحابة)) (3/ 1228)، وسعيد بن منصور في ((سننه)) (2391)، مطولًا بنحوه.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"TiqyIgkh"},{"id":"س-03742","fp":"44057bc02f8a","stateId":252,"easy":"إذا لم تحلق عانتك وتقلم أظفارك وتجز شاربك ← فلست منا","cause":"مَن لم يَحلِقْ عانَتَه ويُقَلِّمْ أظفارَه ويَجُزَّ شارِبَه","result":"فليس مِنَّا","explicit":true,"ref":"فيض القدير 6/ 223","srcLabel":"السنة","text":[["مَن لم يَحلِقْ عانَتَه ويُقَلِّمْ أظفارَه ويَجُزَّ شارِبَه ",1],["فليس مِنَّا",2]],"grade":"حسن","narrator":"رجل","muhaddith":"رمز السيوطي لحسنه وليس كما ظن","bab":"اعتصام بالسنة › لزوم السنة","dorar":"wHFrnfFd"},{"id":"س-03789","fp":"0b27bf722f0c","stateId":252,"easy":"إذا لم تكرم جليسك ← فلست من أحمد ولا من إبراهيم","cause":"من لم يُكرِمْ جليسَه","result":"فليس من أحمدَ ولا من إبراهيمَ","explicit":true,"ref":"الترغيب والترهيب 3/329","srcLabel":"الطبراني","text":["أنَّه دخل على عبدِ اللهِ بنِ الحارثِ بنِ جَزْءٍ الزَّبيديِّ رضِي اللهُ عنه فرمَى إليه بوسادةٍ كانت تحته وقال ",["من لم يُكرِمْ جليسَه",1]," ",["فليس من أحمدَ ولا من إبراهيمَ",2]," عليهما السَّلامُ"],"grade":"حسن","narrator":"إبراهيم بن نشيط الوعلاني","muhaddith":"رواته ثقات","takhrij":"أخرجه ابن ابي حاتم في ((العلل))، والطبراني كما في ((جامع المسانيد)) لابن كثير(6216)","bab":"بر وصلة › إكرام الزائر","dorar":"uCcB7gBy"},{"id":"س-04878","fp":"3ab19b0329fd","stateId":252,"easy":"إذا رأيت حية فلم تقتلها خوفاً من طلبها ← فلست منا","cause":"مَن رَأَى حَيَّةً ، فلَمْ يَقْتُلْها ، مَخافَةَ طَلَبِها","result":"فلَيسَ مِنَّا","explicit":true,"ref":"الجامع الصغير 8666","srcLabel":"الطبراني","text":[["مَن رَأَى حَيَّةً ، فلَمْ يَقْتُلْها ، مَخافَةَ طَلَبِها ، ",1],["فلَيسَ مِنَّا",2]],"grade":"حسن","narrator":"أبو ليلى الأنصاري والد عبدالرحمن","muhaddith":"حسن","takhrij":"أخرجه الطبراني (6425)، (7/ 78) بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"a8nJlT3Z"},{"id":"س-05207","fp":"34c5d9feb0e1","stateId":252,"easy":"إذا صوّرت ما لا تخلق ← قاتلك الله","cause":"يُصَوِّرونَ ما لَا يَخْلُقُونَ","result":"قاتَلَ اللهُ أَقوامًا","explicit":true,"ref":"المطالب العالية 4/371","srcLabel":"الطبراني","text":["دخلتُ مع رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ الكعبةَ ، فَرأَى فيها تَصاوِيرَ فقال لي : ابتَغِ لي ماءً ، فَأَتيتُه صلَّى اللهُ عليهِ وسلَّمَ بماءٍ في دَلوٍ ، فَجعلَ يَبُلُّ بِه الثوبَ ثمَّ يَضرِبُ بِه الصُّوَرَ ويقولُ : ",["قاتَلَ اللهُ أَقوامًا",2]," ",["يُصَوِّرونَ ما لَا يَخْلُقُونَ",1]],"grade":"حسن","narrator":"أسامة بن زيد","muhaddith":"إسناده حسن","takhrij":"أخرجه إسحاق بن راهويه كما في ((المطالب العالية)) (4225) بلفظه، والضياء في ((المختارة)) (1336)، والطبراني (1/ 166) (407) بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"TL0fTE8U"},{"id":"س-08173","fp":"0d5574f7d5f8","stateId":252,"easy":"إذا تغوطت على طريق من طرق المسلمين ← فعليك لعنة الله والملائكة والناس","cause":"مَن غَسَلَ سَخيمَتَه على طَريقٍ مِن طُرُقِ المُسلِمينَ","result":"فعليه لَعنةُ اللهِ والمَلائِكةِ والناسِ أجمَعينَ","explicit":true,"ref":"الترغيب والترهيب 1/110","srcLabel":"الطبراني","text":[["مَن غَسَلَ سَخيمَتَه على طَريقٍ مِن طُرُقِ المُسلِمينَ ",1],["فعليه لَعنةُ اللهِ والمَلائِكةِ والناسِ أجمَعينَ",2],"."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"رواته ثقات إلا محمد بن عمرو","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (4/110)، والطبراني في ((المعجم الأوسط)) (5426)، وابن عدي في ((الكامل في الضعفاء)) (6/225) باختلاف يسير","bab":"ملائكة › أعمال الملائكة","dorar":"UCo25Jst"},{"id":"س-03589","fp":"ef89762b7f31","stateId":252,"easy":"إذا تركت قتل الحيات المؤذية خوفاً ← فليس منا","cause":"فمَن لم يَقتُلْهما","result":"فليس منَّا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-03590"],"ref":"تخريج المسند لشعيب 24535","srcLabel":"متفق عليه","text":["نَهانا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ عن قَتلِ الجِنانِ التي تكونُ في البُيوتِ، غيرَ ذي الطُّفيتَيْنِ، والبَتْراءِ، فإنَّهما تَطمِسانِ الأبصارَ، وتَقتُلانِ أوْلادِ الحَبالى في بُطونِهم، ",["فمَن لم يَقتُلْهما، ",1],["فليس منَّا",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه أبو يعلى (4358) باختلاف يسير، وأخرجه البخاري (3308، 3309) مفرقاً مختصراً، ومسلم (2232) مختصرا بنحوه","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"mBIXcMS1","merged":2,"otherRefs":["مجمع الزوائد 4-49 (صحيح)"]},{"id":"س-03590","fp":"48053017bdca","stateId":252,"easy":"إذا تركت قتل الحيات ← فليس مني","cause":"ومَن تَرَكَهما","result":"فليس مِنِّي","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03589","ref":"تخريج المسند لشعيب 24219","text":["نَهى رسولُ اللهِ صلَّى اللهُ عليه وسلَّم عن قَتْلِ الحَيَّاتِ، قال مُحمَّدُ بنُ عُبَيدٍ: التي تكونُ في البُيوتِ، وأمَرَنا بقَتْلِ الأبْتَرِ وذي الطُّفْيَتَينِ، قال: إنَّهما يَلتَمِسانِ البَصَرَ، ويُسقِطانِ ما في بُطونِ النِّساءِ، ",["ومَن تَرَكَهما ",1],["فليس مِنِّي",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه أبو يعلى (4358) باختلاف يسير، وأخرجه البخاري (3308، 3309) مفرقاً مختصراً، ومسلم (2232) مختصرا بنحوه","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"ZRytcJJf","merged":2,"otherRefs":["تخريج المسند لشعيب 25241 (صحيح)"]},{"id":"س-06859","fp":"b56c52478384","stateId":253,"easy":"إذا عاديت ولياً لله ← آذنك الله بالحرب","cause":"مَنْ عادَى لي ولِيًّا","result":"فقد آذَنْتُهُ بِالحَرْبِ","explicit":true,"star":true,"similar":["س-00008"],"ref":"السلسلة الصحيحة 1640","srcLabel":"البخاري","text":["إنَّ اللهَ تعالى قال : ",["مَنْ عادَى لي ولِيًّا ",1],["فقد آذَنْتُهُ بِالحَرْبِ",2]," ، و ما تَقَرَّبَ إِلَيَّ عَبدي بِشيءٍ أحبَّ إِلَيَّ مِمَّا افْتَرَضْتُهُ عليهِ ، و ما زالَ عَبدي يَتَقَرَّبُ إِلَيَّ بِالنَّوَافِلِ حتى أُحِبَّهُ ، فإذا أَحْبَبْتُهُ كُنْتُ سَمْعَهُ الذي يسمعُ بهِ ، و بَصَرَهُ الذي يُبْصِرُ بهِ ، و يَدَهُ التي يَبْطِشُ بِها ، و رِجْلَهُ التي يَمْشِي بِها ، و إنْ سألَنِي لأُعْطِيَنَّهُ ، و لَئِنِ اسْتَعَاذَنِي لأُعِيذَنَّهُ ، و ما تَرَدَّدْتُ عن شيءٍ أنا فَاعِلُهُ تَرَدُّدِي عن قَبْضِ نَفْسِ المُؤْمِنِ ، يَكْرَهُ المَوْتَ و أنا أَكْرَهُ مَساءَتَهُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرجه البخاري (6137)، والبيهقي (21021)، وابن حبان (4757) جميعا بلفظه.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"JKzpuCtt"},{"id":"س-08089","fp":"657dcb85a8ef","stateId":253,"easy":"إذا آذيت النبي ﷺ ← اشتد غضب الله عليك","cause":"دَمَّوا وَجْهَ رَسولِ اللهِ","result":"اشْتَدَّ غَضَبُ اللهِ على قَوْمٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"star":true,"otherNeedIds":[49],"ref":"الأحاديث المختارة 11 / 164","srcLabel":"متفق عليه","text":["«ما نُصِرَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ في مَوطِنٍ نَصْرَه في أُحُدٍ، فأُنكِرَ ذلك عليه، فقالَ ابنُ عبَّاسٍ: بَيْني وبَيْنَ مَن يُنكِرُ كِتابَ اللهِ، إنَّ اللهَ يقولُ: {وَلَقَدْ صَدَقَكُمُ اللَّهُ وَعْدَهُ إِذْ تَحُسُّونَهُمْ بِإِذْنِهِ}، فقالَ ابنُ عبَّاسٍ: والحَسُّ: القَتْلُ، {حَتَّى إِذَا فَشِلْتُمْ}، إلى قَوْلِه: {وَلَقَدْ عَفَا عَنْكُمْ وَاللَّهُ ذُو فَضْلٍ عَلَى الْمُؤْمِنِينَ}، وإنَّما عَنى بِهذا الرُّماةَ، وذلك أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ أقامَهم في مَرصَدٍ، ثُمَّ قالَ: احْمُوا ظُهورَنا، فإن رَأَيْتُمونا نُقتَلُ فلا تَنْصُرونا، وإن رَأَيْتُمونا قد غَنِمْنا فلا تَشْرَكونا، فلمَّا غَنَّمَ اللهُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ وأباحَه عَسكَرَ المُشْرِكينَ انْفَكَّتِ الرُّماةُ جَميعًا، فدَخَلوا العَسكَرَ يَنْتَهبونَ، وقدِ الْتَفَّتْ صُفوفُ أصْحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فهُمْ هكذا، وشَبَّكَ بَيْنَ أصابِعِه اليُمْنى واليُسْرى، فلمَّا أَخْلَتِ الرُّماةُ تلك الخَلَّةَ الَّتي كانوا فيها دَخَلَتِ الخَيْلُ مِن ذلك المَوضِعِ على أصْحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فضَرَبَ بعضُهم بعضًا، وقُتِلَ مِن المُسلِمينَ ناسٌ كَثيرٌ، وقدْ كانَ لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وأصْحابِه مِن أوَّلِ النَّهارِ حتَّى قُتِلَ مِن أصْحابِ لِواءِ المُشْرِكينَ سَبْعةٌ أو تِسْعةٌ، وجالَ المُسلِمونَ جَوْلةً نَحْوَ الجَبَلِ ولم يَبلُغوا حيثُ يقولُ النَّاسُ الغارَ، إنَّما كانوا تحتَ المِهْراسِ، وصاحَ الشَّيْطانُ: قُتِلَ مُحمَّدٌ، فلم نَشُكَّ فيه أنَّه حَقٌّ، وإنَّا كذلك لا نَشُكُّ أنَّه حَقٌّ قد قُتِلَ حتَّى طَلَعَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بَيْنَ الشِّعْبَينِ فعَرَفْتُه بتَكَفُّئِه إذا مَشى، قالَ: ففَرِحْنا حتَّى كأنَّه لم يُصِبْنا ما أصابَنا، قالَ: فَرَقا نَحْوَنا وهو يقولُ: ",["اشْتَدَّ غَضَبُ اللهِ على قَوْمٍ",2]," ",["دَمَّوا وَجْهَ رَسولِ اللهِ",1]," صلَّى اللهُ عليه وسلَّمَ! قالَ: ويقولُ مَرَّةً أخرى: اللَّهُمَّ إنَّه ليس لهم أن يَعْلونا حتَّى يَنْتَهوا إلينا، فمَكَثَ ساعةً وإذا أبو سُفْيانَ يَصيحُ مِن أَسفَلِ الجَبَلِ: اعْلُ هُبَلُ -يَعْني آلِهتَه- أين ابنُ أبي كَبْشةَ، أين ابنُ أبي قُحافةَ، أين ابنُ الخَطَّابِ؟ قالَ: فقالَ عُمَرُ: يا رَسولَ اللهِ، أَلَا أُجيبُه؟ قالَ: بَلى، قالَ: فلمَّا قالَ: اعْلُ هُبَلُ، قالَ عُمَرُ بنُ الخَطَّابِ: اللهُ أَعْلى وأَجَلُّ، قالَ: فقالَ أبو سُفْيانَ: يا بنَ الخَطَّابِ، إنَّك قد أَنْعَمْتَ، فعادَ لمِثلِها فقالَ: أين ابنُ أبي كَبْشةَ، أين ابنُ أبي قُحافةَ، أين ابنُ الخَطَّابِ؟ فقالَ عُمَرُ: هذا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، هذا أبو بَكْرٍ، هذا أنا عُمَرُ، فقالَ أبو سُفْيانَ: يَوْمٌ بيَوْمِ بَدْرٍ، إنَّ الأيَّامَ دُوَلٌ، وإنَّ الحَرْبَ سِجالٌ، قالَ: فقالَ عُمَرُ: لا سَواءً، قَتْلانا في الجنَّةِ وقَتْلاكم في النَّارِ، فقالَ: إنَّكم لَتَزْعُمونَ ذلك، لقد خِبْنا إذًا وخَسِرْنا. ثُمَّ قالَ أبو سُفْيانَ: أَمَا إنَّكم ستَجدونَ في قَتْلاكم مُثْلةً ولم يكن ذلك عن رَأيِ كُبَرائِنا، ثُمَّ أدْرَكَتْه حَمِيَّةُ الجاهِليَّةِ، فقالَ: أَمَا إنَّه إن كانَ ذاك لم نَكْرَهْه».\nوفي رِوايةِ الإمامِ أحْمَدَ عن ابنِ عبَّاسٍ، أنَّه قالَ: ما نَصَرَ اللهُ -تَبارَكَ وتَعالى- في مَوطِنٍ كما نَصَرَ يَوْمَ أُحُدٍ، قالَ: فأَنْكَرْنا ذلك، فقالَ ابنُ عبَّاسٍ: بَيْني وبَيْنَ مَن أَنكَرَ ذلك كِتابُ اللهِ -تَبارَكَ وتَعالى- يقولُ في يَوْمِ أُحُدٍ: {وَلَقَدْ صَدَقَكُمُ اللَّهُ وَعْدَهُ}، وعِنْدَه: أقامَهم في مَوضِعٍ، وعِنْدَه: فلمَّا غَنِمَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ وأباحوا عَسكَرَ المُشْرِكينَ أَكَبَّ الرُّماةُ جَميعًا فدَخَلوا في العَسكَرِ يَنْهَبونَ، وعِنْدَه: فهُمْ كَذا وشَبَّكَ بَيْنَ أصابِعِ يَدَيه والْتَبَسوا، فلمَّا أَخَلَّ الرُّماةُ، وعِنْدَه: وأصْحابه أوَّلَ النَّهارِ، وعِنْدَه: فلم يَشُكَّ في أنَّه حَقٌّ، فما زِلْنا كذلك ما نَشُكُّ أنَّه قد قُتِلَ حتَّى طَلَعَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بَيْنَ السَّعْدَينِ نَعرِفُه، وعِنْدَه: يَعْلونا حتَّى انْتَهى إلينا، وعِنْدَه: اعْلُ هُبَلُ مَرَّتَينِ، وعِنْدَه: أَلَا أُجيبُه، وعِنْدَه: قالَ عُمَرُ: اللهُ أَعْلى وأَجَلُّ، وعِنْدَه: أَنْعَمَتْ عَينُها، فقالَ: أين ابنُ أبي كَبْشةَ، وعِنْدَه: سوف تَجِدونَ في قَتْلاهم مُثْلى، ولم يكُ ذاك عن رَأيِ سَراتِنا، قالَ: ثُمَّ، وعِنْدَه: أَمَا إنَّه قد كانَ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"مغازي › غزوة أحد","dorar":"pnuME2Ow","merged":7,"otherRefs":["مجمع الزوائد 6/120 (حسن)","صحيح مسلم 1793 (صحيح)","صحيح البخاري 4074 (صحيح)","صحيح البخاري 4076 (صحيح)","نخب الافكار 7/380 (صحيح)","تخريج المسند لشعيب 13138 (صحيح)"]},{"id":"س-08400","fp":"7a0622aaccdb","stateId":253,"easy":"إذا آذيت علياً ← فقد آذيت النبي ﷺ","cause":"مَن آذى علِيًّا","result":"فقدْ آذاني","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"star":true,"similar":["س-08363"],"ref":"الأحاديث المختارة 1071","srcLabel":"البخاري","text":["«كُنْتُ جالِسًا في المَسجِدِ معَ رَجُلَينِ، فتَذاكَرْنا علِيًّا، فتَناوَلْنا مِنه، فأَقبَلَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ مُغْضَبًا يُعرَفُ في وَجْهِه الغَضَبُ، فقُلْتُ: أَعوذُ باللهِ مِن غَضَبِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: ما لكم ولي، ",["مَن آذى علِيًّا",1]," ",["فقدْ آذاني",2],"، يَقولُها ثَلاثَ مِرارٍ، قالَ: مِن بَعْدُ، فيقالُ: إنَّ علِيًّا يُعَرِّضُ بك، يَقولُ: اتَّقوا فِتْنةَ الأُخْنَسِ، فأقولُ: هلْ سمَّاني؟ فيَقولونَ: لا، فأقولُ: إنَّ خُنَّسَ النَّاسِ لَكَثيرٌ، مَعاذَ اللهِ أن أُؤْذِيَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ بَعْدَما سَمِعْتُ مِنه»."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"V2lPl127","merged":3,"otherRefs":["صحيح ابن حبان 6923 (صحيح)","الأحاديث المختارة 1070 (صحيح)"]},{"id":"ق-0997","fp":"32e7d96716ad","stateId":253,"easy":"إيذاء الله ورسوله ← اللعنة في الدنيا والآخرة وعذاب مهين","cause":"إيذاء الله ورسوله","result":"اللعنة في الدنيا والآخرة وعذاب مهين","explicit":true,"star":true,"otherNeedIds":[57],"ref":"سورة الأحزاب: 57","srcLabel":"القرآن الكريم","quran":{"s":33,"from":57,"to":57,"text":"إِنَّ الَّذِينَ يُؤْذُونَ اللَّهَ وَرَسُولَهُ لَعَنَهُمُ اللَّهُ فِي الدُّنْيَا وَالْآخِرَةِ وَأَعَدَّ لَهُمْ عَذَابًا مُهِينًا (57)","hl":[[0,127,1]]}},{"id":"س-07142","fp":"77f46fc0eb14","stateId":253,"easy":"إذا هجرتِ زوجك (النبي ﷺ) يوماً ← لا تأمني غضب الله لغضبه","cause":"وتهجُرُه إحدانا اليومَ إلى اللَّيلِ","result":"أفتأمَنُ إحداكنَّ أنْ يغضَبَ اللهُ عليها لغضبِ رسولِه صلَّى اللهُ عليه وسلَّم فإذا هي قد هلَكتْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج صحيح ابن حبان 4268","srcLabel":"متفق عليه","text":["عن ابن عباس قال: لم أزَلْ حريصًا أنْ أسأَلَ عمرَ بنَ الخطَّابِ عن المرأتينِ اللَّتينِ مِن أزواجِ النَّبيِّ صلَّى اللهُ عليه وسلَّم قال اللهُ: {إِنْ تَتُوبَا إِلَى اللَّهِ فَقَدْ صَغَتْ قُلُوبُكُمَا} [التحريم: 4] حتَّى حجَّ عمرُ فحجَجْتُ معه فلمَّا كان في بعضِ الطَّريقِ عدَل ليتوضَّأَ وعدَلْتُ معه بالإداوةِ فتبرَّز ثمَّ أتاني فسكَبْتُ على يديه فتوضَّأ فقُلْتُ: يا أميرَ المؤمنينَ مَن المرأتانِ مِن أزواجِ النَّبيِّ صلَّى اللهُ عليه وسلَّم اللَّتانِ قال اللهُ: {إِنْ تَتُوبَا إِلَى اللَّهِ فَقَدْ صَغَتْ قُلُوبُكُمَا} [التحريم: 4] ؟ فقال عمرُ: واعجبًا لك يا ابنَ عبَّاسٍ ثمَّ قال: هي عائشةُ وحفصةُ ثمَّ أنشَأ يسوقُ الحديثَ \nفقال: كنَّا معشرَ قريشٍ قومًا نغلِبُ النِّساءَ فلمَّا قدِمْنا المدينةَ وجَدْناهم قومًا تغلِبُهم نساؤُهم فطفِق نساؤُنا يتعلَّمْنَ مِن نسائِهم وكان منزلي في بني أميَّةَ بنِ زيدٍ في العوالي قال: فتغضَّبْتُ يومًا على امرأتي فإذا هي تُراجِعُني فأنكَرْتُ أنْ تُراجِعَني فقالت: ما تُنكِرُ أنْ أُراجِعَك فواللهِ إنَّ أزواجَ النَّبيِّ صلَّى اللهُ عليه وسلَّم لتُراجِعْنَه، وتهجُرُه إحداهنَّ اليومَ إلى اللَّيلِ قال: فانطلَقْتُ فدخَلْتُ على حفصةَ فقُلْتُ: أتُراجِعينَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ؟ قالت: نَعم ",["وتهجُرُه إحدانا اليومَ إلى اللَّيلِ",1]," قال: قد قُلْتُ: قد خاب مَن فعَل ذلك منكنَّ وخسِر، ",["أفتأمَنُ إحداكنَّ أنْ يغضَبَ اللهُ عليها لغضبِ رسولِه صلَّى اللهُ عليه وسلَّم فإذا هي قد هلَكتْ",2]," لا تُراجِعي رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ولا تسأَليه شيئًا وسَليني ما بدا لكِ، ولا يغُرَّنَّكِ أنْ كانت جارتُك هي أوسمَ وأحبَّ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم منكِ ـ يُريدُ عائشةَ \nقال: وكان لي جارٌ مِن الأنصارِ وكنَّا نتناوَبُ النُّزولَ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فينزِلُ يومًا وأنزِلُ يومًا فيأتيني بخبرِ الوحيِ وغيرِه وأنزِلُ فآتيه بمثلِ ذلك، وكنَّا نتحدَّثُ أنَّ غسَّانَ تنعَلُ الخيلَ لتغزوَنا قال: فنزَل صاحبي يومًا، ثمَّ أتاني فضرَب على بابي ثمَّ ناداني فخرَجْتُ إليه فقال: حدَث أمرٌ عظيمٌ فقُلْتُ: ماذا أجاءتْ غسَّانُ ؟ قال: بل أعظمُ مِن ذلك وأطولُ، طلَّق رسولُ اللهِ نساءَه فقُلْتُ: خابت حفصةُ وخسِرت قد كُنْتُ أظُنَّ هذا كائنًا \nفلمَّا صلَّيْتُ الصُّبحَ شدَدْتُ علَيَّ ثيابي ثمَّ نزَلْتُ فدخَلْتُ على حفصةَ فإذا هي تبكي فقُلْتُ: أَطلَّقكنَّ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ؟ فقالت: لا أدري هو ذا هو مُعتزِلٌ في هذه المَشرُبةِ قال: فأتَيْتُ غلامًا له أسودَ فقُلْتُ: استأذِنْ لعُمرَ فدخَل الغلامُ ثمَّ خرَج إليَّ وقال: قد ذكَرْتُكَ له فلم يقُلْ شيئًا فانطلَقْتُ حتَّى أتَيْتُ المسجدَ فإذا قومٌ حولَ المنبرِ جلوسٌ يبكي بعضُهم إلى بعضٍ قال: فجلَسْتُ قليلًا ثمَّ غلَبني ما أجِدُ فأتَيْتُ الغلامَ فقُلْتُ: استأذِنْ لعمرَ فدخَل ثمَّ خرَج إليَّ فقال: قد ذكَرْتُكَ له فصمَت فرجَعْتُ فجلَسْتُ إلى المنبرِ ثمَّ غلَبني ما أجِدُ فأتَيْتُ الغلامَ فقُلْتُ: استأذِنْ لعمرَ فدخَل ثمَّ خرَج إليَّ فقال: قد ذكَرْتُك له فسكَت فولَّيْتُ مدبِرًا فإذا الغلامُ يدعوني ويقولُ: ادخُلْ فقد أذِن لكَ \nفدخَلْتُ فسلَّمْتُ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فإذا هو متَّكئٌ على رملِ حصيرٍ قد أثَّر بجَنبِه فقُلْتُ: أطلَّقْتَ يا رسولَ اللهِ نساءَك ؟ قال: فرفَع رأسَه إليَّ وقال: ( لا ) فقُلْتُ: اللهُ أكبرُ لو رأيتَنا يا رسولَ اللهِ وكنَّا معشرَ قريشٍ قومًا نغلِبُ النِّساءَ فلمَّا قدِمْنا المدينةَ وجَدْنا قومًا تغلِبُهم نساؤُهم فطفِق نساؤُنا يتعلَّمْنَ مِن نسائِهم فتغضَّبْتُ على امرأتي يومًا فإذا هي تُراجِعُني فأنكَرْتُ ذلك عليها فقالت: أتُنكِرُ أنْ أُراجِعَكَ ؟ فواللهِ إنَّ أزواجَ النَّبيِّ صلَّى اللهُ عليه وسلَّم لَيُراجِعْنُه، وتهجُرُه إحداهنَّ اليومَ إلى اللَّيلِ قال: فقُلْتُ: قد خاب مَن فعَل ذلك منهنَّ وخسِرت أتأمَنُ إحداهنَّ أنْ يغضَبَ اللهُ عليها لغضبِ رسولِه صلَّى اللهُ عليه وسلَّم فإذا هي قد هلَكتْ ؟ ! قال: فتبسَّم رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فقُلْتُ: يا رسولَ اللهِ فدخَلْتُ على حفصةَ فقُلْتُ لها: لا تُراجِعي رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ولا تسأَليه شيئًا وسَليني ما بدا لكِ ولا يغُرَّنَّكِ أنْ كانت جارتُك هي أوسمَ وأحبَّ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم منكِ قال: فتبسَّم رسولُ اللهِ صلَّى اللهُ عليه وسلَّم أخرى فقُلْتُ: أستأنِسُ يا رسولَ اللهِ ؟ قال: ( نَعم ) فجلَسْتُ فرفَعْتُ رأسي في البيتِ فواللهِ ما رأَيْتُ فيه شيئًا يرُدُّ البصرَ إلَّا أُهُبًا ثلاثةً فقُلْتُ: يا رسولَ اللهِ ادعُ اللهَ أنْ يوسِّعَ على أمَّتِك فقد وسَّع اللهُ على فارسَ والرُّومِ وهم لا يعبُدونَه قال: فاستوى جالسًا وقال: ( أفي شكٍّ أنتَ يا ابنَ الخطَّابِ أولئكَ قومٌ عُجِّلتْ لهم طيِّباتُهم في الحياةِ الدُّنيا ) فقُلْتُ: استغفِرْ لي يا رسولَ اللهِ، وكان أقسَم لا يدخُلُ عليهنَّ شهرًا مِن شدَّةِ مَوْجِدتِه عليهنَّ حتَّى عاتَبه اللهُ \nقال الزُّهريُّ: فأخبَرني عروةُ عن عائشةَ قالت: فلمَّا مضى تسعٌ وعشرونَ دخَل عليَّ رسولُ صلَّى اللهُ عليه وسلَّم بدَأ بي فقُلْتُ: يا رسولَ اللهِ إنَّكَ أقسَمْتَ ألَّا تدخُلَ علينا شهرًا وإنَّك دخَلْتَ تسعًا وعشرينَ أعُدُّهنَّ فقال صلَّى اللهُ عليه وسلَّم: ( إنَّ الشَّهرَ تسعٌ وعشرونَ ) ثمَّ قال: ( يا عائشةُ إنِّي ذاكرٌ لكِ أمرًا فلا أُريدُ أنْ تعجَلي فيه حتَّى تستأمِري أبويكِ ) قالت: ثمَّ قرَأ عليَّ الآيةَ: {يَا أَيُّهَا النَّبِيُّ قُلْ لِأَزْوَاجِكَ إِنْ كُنْتُنَّ تُرِدْنَ الْحَيَاةَ الدُّنْيَا وَزِينَتَهَا فَتَعَالَيْنَ أُمَتِّعْكُنَّ وَأُسَرِّحْكُنَّ سَرَاحًا جَمِيلًا * وَإِنْ كُنْتُنَّ تُرِدْنَ اللَّهَ وَرَسُولَهُ وَالدَّارَ الْآخِرَةَ فَإِنَّ اللَّهَ أَعَدَّ لِلْمُحْسِنَاتِ مِنْكُنَّ أَجْرًا عَظِيمًا} [الأحزاب: 28، 29] قالت عائشةُ: قد علِم واللهِ أنَّ أبويَّ لم يكونا يأمُراني بفِراقِه فقُلْتُ: أفي هذا أستأمِرُ أبويَّ فإنِّي أُريدُ اللهَ ورسولَه والدَّارَ الآخرةَ"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5843)، ومسلم (1479) باختلاف يسير","bab":"علم › حسن السؤال ونصح العالم","dorar":"rmtuqsiF","merged":2,"otherRefs":["صحيح الترمذي 3318 (صحيح)"]},{"id":"س-01273","fp":"c62f8694f35d","stateId":253,"easy":"إذا أغضبت أولياء الله ← يغضب الله لغضبهم","cause":"تَنْصُرونَني عليه، فيَغضَبُ","result":"فيَأْتي رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فيَغضَبُ لغَضَبِه، فيَغضَبُ اللهُ لغَضَبِهِما فيَهلِكُ رَبيعةُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 2756","srcLabel":"مسلم","text":["كنتُ أَخدُمُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فقالَ لي النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: يا رَبيعةُ، ألا تَتزوَّجُ؟ قالَ: فقلتُ: لا واللهِ يا رسولَ اللهِ، ما أُريدُ أنْ أَتزَوَّجَ، ما عندي ما يُقيمُ المرأةَ، وما أُحِبُّ أنْ يَشْغلَني عنكَ شيءٌ، قالَ: فأَعْرَضَ عَنِّي، ثُمَّ قالَ لي بعدَ ذلك: يا ربيعةُ، ألا تتزوَّجُ؟ قالَ: فقلتُ: لا واللهِ يا رسولَ اللهِ، ما أُريدُ أنْ أَتزوَّجَ، وما عندي ما يُقيمُ المرأةَ، وما أُحِبُّ أنْ يَشغَلَني عنكَ شيءٌ، فأَعرَضَ عَنِّي، قالَ: ثُمَّ راجَعْتُ نَفسي فقلتُ: واللهِ يا رسولَ اللهِ، أنتَ أَعلمُ بما يُصلِحُني في الدُّنيا والآخرةِ، قالَ: وأنا أَقولُ في نَفسي: لئن قالَ لي الثَّالثةَ لأَقولَنَّ: نَعَمْ، قالَ: فقالَ لي الثَّالثَةَ: يا رَبيعةُ، ألا تتزوَّجُ؟ قالَ: فقلتُ: بلى يا رسولَ اللهِ، مُرْني بما شئتَ أوْ بما أَحْببتَ، قالَ: انطَلِقْ إلى آلِ فُلانٍ، إلى حَيٍّ مِن الأنصارِ، فيهم تَراخي عنْ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقُلْ لهُم: إنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يُقرِئُكُم السَّلامَ، ويَأمُرُكم أنْ تُزوِّجوا رَبيعةَ فُلانةَ -امرأةً منهم- قالَ: فأَتيتُهُم فقلتُ لهم ذلك، قالوا: مَرحبًا برسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، وبرسولِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، واللهِ لا يَرجِعُ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ إلَّا بحاجَتِه. قالَ: فأَكْرَموني وزَوَّجوني وأَلْطَفوني، ولمْ يَسْأَلوني البَيِّنةَ، فرَجَعتُ حَزينًا، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ما بالُكَ؟ فقلتُ: يا رسولَ اللهِ، أَتيتُ قومًا كِرامًا، فزَوَّجوني وأَكْرَموني وأَلْطَفوني ولمْ يَسأَلوني البَيِّنةَ، فمِن أين لي الصَّداقُ؟ فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ لبُرَيدَةَ الأَسْلَمِيِّ: يا بُرَيدَةُ، اجمَعوا له وَزْنَ نواةٍ مِن ذَهَبٍ. قالَ: فجَمَعوا له وَزْنَ نواةٍ مِن ذَهَبٍ، قالَ: فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: اذهبْ بهذا إليهم، وقُل هذا صَداقُها، فذَهَبتُ به إليهم، فقلتُ: هذا صَداقُها، قالَ: فقالوا: كَثيرٌ طَيِّبٌ، فقَبِلوا ورَضوا به، قالَ: فقلتُ: مِن أين أُولمُ؟ قالَ: فقالَ: يا بُرَيدَةُ، اجْمَعوا له في شاةٍ، قالَ: فجَمَعوا له في كَبشٍ فطيمٍ سَمينٍ، قالَ: وقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: اذهبْ إلى عائشةَ، فقُلِ: انظُري إلى المِكْتَلِ الَّذي فيه الطَّعامُ فابعَثي به، قالَ: فأَتيتُ عائشةَ رَضيَ اللهُ عنها فقلتُ لها ذاك، فقالتْ: ها هو ذاك المِكْتَلُ فيه سبعةُ آصُعٍ مِن شَعيرٍ، واللهِ إنْ أَصْبَحَ لنا طعامٌ غيرُهُ، قالَ: فأَخذْتُه فجئتُ به إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقالَ: اذْهَبْ بها إليهم، فقُلْ: ليُصْلَحْ هذا عندَكُم خُبزًا، قالَ: فذَهَبْتُ به وبالكَبْشِ، قالَ: فقَبِلوا الطَّعامَ، وقالوا: اكفُونا أنتم الكَبْشَ، قالَ: وجاءَ ناسٌ مِن أَسْلَمَ فذَبَحوا، وسَلَخوا وطَبَخوا، قالَ: فأَصْبَحَ عندنا خُبزٌ ولَحمٌ، فأَولَمْتُ، ودَعوتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ. \n قالَ: وأَعْطاني رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ أَرضًا، وأَعْطى أبا بَكرٍ أَرضًا، فاختَلَفْنا في عِذْقِ نَخلةٍ، قالَ: وجاءتِ الدُّنيا، فقالَ أبو بكرٍ: هذه في حَدِّي، وقلتُ: لا، بل هي في حَدِّي. قالَ: فقالَ لي أبو بكرٍ كلمةً كَرِهتُها، ونَدِمَ عليها، قالَ: فقال لي: يا رَبيعةُ، قُلْ لي مِثلَ ما قُلتُ لكَ، حتَّى تكونَ قِصاصًا، قالَ: فقلتُ: لا واللهِ، ما أنا بقائلٍ لكَ إلَّا خيرًا، قالَ: واللهِ لتَقولَنَّ لي كما قلتُ لكَ، حتَّى تكونَ قِصاصًا، وإلَّا استَعْدَيتُ برسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، قالَ: فقلتُ: لا واللهِ ما أنا بقائلٍ لكَ إلَّا خيرًا، قالَ: فرَفَضَ أبو بكرٍ الأرضَ، وأَتى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ فجَعَلْتُ أَتلوهُ، فقالَ أُناسٌ مِن أَسْلَمَ: يَرحَمُ اللهُ أبا بكرٍ هو الَّذي قالَ ما قالَ، ويَسْتَعْدي عليكَ. قالَ: فقلتُ: أَتدْرونَ مَنْ هذا؟ هذا أبو بكرٍ، هذا ثاني اثنينِ، هذا ذو شَيبَةِ المسلمينَ، إيَّاكُم لا يلتَفِتْ فيَراكُم ",["تَنْصُرونَني عليه، فيَغضَبُ",1],"، ",["فيَأْتي رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فيَغضَبُ لغَضَبِه، فيَغضَبُ اللهُ لغَضَبِهِما فيَهلِكُ رَبيعةُ",2],"، قالَ: فرَجَعوا عَنِّي، وانطَلَقْتُ أَتلوهُ حتَّى أَتى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فقَصَّ عليه الَّذي كان، قالَ: فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا رَبيعةُ، ما لَكَ والصِّدِّيقَ؟ قالَ: فقلتُ مِثلَ ما قالَ كان كذا وكذا، فقالَ لي: قُلْ مِثلَ ما قالَ لكَ، فأَبيتُ أنْ أَقولَ له، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: أَجَلْ، فلا تَقُلْ له مِثلَ ما قالَ لكَ، ولكن قُلْ: يَغفِرُ اللهُ لكَ يا أبا بَكرٍ، قالَ: فوَلَّى الصِّدِّيقُ رَضيَ اللهُ عنه وهو يَبْكي."],"grade":"صحيح","narrator":"ربيعة بن كعب الأسلمي","muhaddith":"صحيح على شرط مسلم،","takhrij":"أخرجه أحمد (16577)، والطبراني (5/ 59) (4578)، وأبو داود الطيالسي في ((المسند)) (1269) بنحوه.","bab":"نكاح › الحث على التزويج","dorar":"Eg7BDsDh"},{"id":"س-00008","fp":"30d550b998f7","stateId":253,"easy":"إذا آذيت ولياً لله ← فقد آذنت الله بالحرب","cause":"من آذى وليًّا","result":"فقدِ استحلَّ محاربتي","explicit":true,"repOf":"س-06859","ref":"مجمع الزوائد 2/250","text":[["من آذى وليًّا",1]," ",["فقدِ استحلَّ محاربتي",2]," وما تقرَّبَ إليَّ عبدي بمثلِ الفرائضِ وما يزالُ العبدُ يتقرَّبُ إليَّ بالنَّوافلِ حتَّى أحبَّهُ إنَّ سألني أعطيتُهُ وإن دعاني أجبتُهُ وما تردَّدتُ عن شيءٍ أنا فاعلُهُ تردُّدي عن وفاتِهِ لأنَّهُ يكرَهُ الموتَ وأكرَهُ مساءتَهُ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"فيه عبد الواحد بن قيس وبقية رجاله رجال الصحيح","takhrij":"أخرجه أحمد (26193)، وابن أبي الدنيا في ((الأولياء)) (45)، والبزار (99) باختلاف يسير","bab":"آداب الدعاء › استجابة الدعاء","dorar":"63PS0rcn"},{"id":"س-01002","fp":"d248c1c6b329","stateId":253,"easy":"إذا عاديت ولياً لله ← فقد بارزت الله بالمحاربة","cause":"مَن عادى لي وَلِيًّا","result":"فقد بارَزَني بالمحارَبةِ","explicit":true,"ref":"الفتاوى الكبرى 1/206","srcLabel":"السنة","text":["عن النَّبيِّ صلَّى اللهُ عليه وسلَّم أنَّه قال: يقولُ اللهُ تعالى: ",["مَن عادى لي وَلِيًّا ",1],["فقد بارَزَني بالمحارَبةِ",2],"، وما تقَرَّب إليَّ عَبْدي بمِثْلِ أداءِ ما افتَرَضْتُ عليه، ولا يزالُ عَبْدي يتقَرَّبُ إليَّ بالنَّوافِلِ حتَّى أُحِبَّه، فإذا أحبَبْتُه كُنتُ سَمْعَه الذي يَسمَعُ به، وبَصَرَه الذي يُبصِرُ به، ويدَه التي يَبطِشُ بها، ورِجْلَه التي يمشي بها. فبي يَسْمَعُ، وبي يُبصِرُ، وبي يَبطِشُ، وبي يَمْشي، ولَئِنْ سَأَلني لأُعطِيَنَّه، ولئِنْ استعاذَني لأُعيذَنَّه، وما ترَدَّدْتُ في شَيءٍ أنا فاعِلُه ترَدُّدي في قَبْضِ نَفْسِ عَبْديَ المؤمِنِ؛ يَكرَهُ الموتَ وأكرَهُ مَساءَتَه، ولا بُدَّ له منه»"],"grade":"صحيح","muhaddith":"صحيح","bab":"أدعية وأذكار › فضل الذكر","dorar":"wJbFCjFe"},{"id":"س-04719","fp":"f350a6e83d16","stateId":253,"easy":"إذا عاديت أولياء الله ← فقد بارزت الله بالمحاربة","cause":"ومن عادَى أولياءَ اللهِ","result":"فقد بارز اللهَ بالمحاربةِ","explicit":true,"ref":"الترغيب والترهيب 4/148","srcLabel":"الطبراني","text":["أنَّ عمرَ رضِي اللهُ عنه خرج إلى المسجدِ فوجد معاذًا عند قبرِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم يبكي ، فقال : ما يُبكيك ؟ قال : حديثٌ سمِعتُه من رسولِ اللهِ صلَّى اللهُ عليه وسلَّم قال : اليسيرُ من الرِّياءِ شِركٌ ، ",["ومن عادَى أولياءَ اللهِ ",1],["فقد بارز اللهَ بالمحاربةِ",2]," إنَّ اللهَ يحِبُّ الأبرارَ الأتقياءَ الأخفياءَ الَّذين إن غابوا لم يُفتَقدوا ، وإن حضروا لم يُعرَفوا . قلوبُهم مصابيحُ الدُّجَى يخرُجون من كلِّ غبراءَ مُظلِمةٍ"],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (1798)، والطبراني  (20/ 153)، (321)، وتمام (28) جميعهم بألفاظ مقاربة.","bab":"رقائق وزهد › الإخلاص","dorar":"FsV0StGj"},{"id":"س-01391","fp":"8bd903bfcb56","stateId":253,"easy":"إذا أغضبت النبي ﷺ ← لا تأمن أن يغضب الله لغضبه","cause":"أتُغَاضِبُ إحْدَاكُنَّ النبيَّ صَلَّى اللهُ عليه وسلَّمَ اليومَ حتَّى اللَّيْلِ","result":"أفَتَأْمَنِينَ أنْ يَغْضَبَ اللَّهُ لِغَضَبِ رَسولِهِ صَلَّى اللهُ عليه وسلَّمَ فَتَهْلِكِي","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"أطراف الغرائب 1/56","srcLabel":"السنة","text":["حديث: قُلتُ لعُمَرَ: ألَا تُخبِرُني عن المُتظاهِرَينِ [يعني حديث: عَنْ عبدِ اللَّهِ بنِ عَبَّاسٍ رَضِيَ اللَّهُ عنْهمَا، قالَ: لَمْ أزَلْ حَرِيصًا علَى أنْ أسْأَلَ عُمَرَ بنَ الخَطَّابِ، عَنِ المَرْأَتَيْنِ مِن أزْوَاجِ النبيِّ صَلَّى اللهُ عليه وسلَّمَ، اللَّتَيْنِ قالَ اللَّهُ تَعَالَى: {إنْ تَتُوبَا إلى اللَّهِ فقَدْ صَغَتْ قُلُوبُكُمَا} [التحريم: 4] حتَّى حَجَّ وحَجَجْتُ معهُ، وعَدَلَ وعَدَلْتُ معهُ بإدَاوَةٍ فَتَبَرَّزَ، ثُمَّ جَاءَ فَسَكَبْتُ علَى يَدَيْهِ منها فَتَوَضَّأَ، فَقُلتُ له: يا أمِيرَ المُؤْمِنِينَ مَنِ المَرْأَتَانِ مِن أزْوَاجِ النبيِّ صَلَّى اللهُ عليه وسلَّمَ، اللَّتَانِ قالَ اللَّهُ تَعَالَى: {إنْ تَتُوبَا إلى اللَّهِ فقَدْ صَغَتْ قُلُوبُكُمَا} [التحريم: 4]؟ قالَ: واعَجَبًا لكَ يا ابْنَ عَبَّاسٍ، هُما عَائِشَةُ وحَفْصَةُ، ثُمَّ اسْتَقْبَلَ عُمَرُ الحَدِيثَ يَسُوقُهُ قالَ: كُنْتُ أنَا وجَارٌ لي مِنَ الأنْصَارِ في بَنِي أُمَيَّةَ بنِ زَيْدٍ، وهُمْ مِن عَوَالِي المَدِينَةِ، وكُنَّا نَتَنَاوَبُ النُّزُولَ علَى النبيِّ صَلَّى اللهُ عليه وسلَّمَ، فَيَنْزِلُ يَوْمًا وأَنْزِلُ يَوْمًا، فَإِذَا نَزَلْتُ جِئْتُهُ بما حَدَثَ مِن خَبَرِ ذلكَ اليَومِ مِنَ الوَحْيِ أوْ غيرِهِ، وإذَا نَزَلَ فَعَلَ مِثْلَ ذلكَ، وكُنَّا مَعْشَرَ قُرَيْشٍ نَغْلِبُ النِّسَاءَ، فَلَمَّا قَدِمْنَا علَى الأنْصَارِ إذَا قَوْمٌ تَغْلِبُهُمْ نِسَاؤُهُمْ، فَطَفِقَ نِسَاؤُنَا يَأْخُذْنَ مِن أدَبِ نِسَاءِ الأنْصَارِ، فَصَخِبْتُ علَى امْرَأَتي فَرَاجَعَتْنِي، فأنْكَرْتُ أنْ تُرَاجِعَنِي، قالَتْ: ولِمَ تُنْكِرُ أنْ أُرَاجِعَكَ؟ فَوَاللَّهِ إنَّ أزْوَاجَ النبيِّ صَلَّى اللهُ عليه وسلَّمَ لَيُرَاجِعْنَهُ، وإنَّ إحْدَاهُنَّ لَتَهْجُرُهُ اليومَ حتَّى اللَّيْلِ، فأفْزَعَنِي ذلكَ وقُلتُ لَهَا: قدْ خَابَ مَن فَعَلَ ذَلِكِ منهنَّ، ثُمَّ جَمَعْتُ عَلَيَّ ثِيَابِي، فَنَزَلْتُ فَدَخَلْتُ علَى حَفْصَةَ فَقُلتُ لَهَا: أيْ حَفْصَةُ، ",["أتُغَاضِبُ إحْدَاكُنَّ النبيَّ صَلَّى اللهُ عليه وسلَّمَ اليومَ حتَّى اللَّيْلِ",1],"؟ قالَتْ: نَعَمْ، فَقُلتُ: قدْ خِبْتِ وخَسِرْتِ، ",["أفَتَأْمَنِينَ أنْ يَغْضَبَ اللَّهُ لِغَضَبِ رَسولِهِ صَلَّى اللهُ عليه وسلَّمَ فَتَهْلِكِي",2],"؟ لا تَسْتَكْثِرِي النبيَّ صَلَّى اللهُ عليه وسلَّمَ ولَا تُرَاجِعِيهِ في شيءٍ ولَا تَهْجُرِيهِ، وسَلِينِي ما بَدَا لَكِ، ولَا يَغُرَّنَّكِ أنْ كَانَتْ جَارَتُكِ أوْضَأَ مِنْكِ وأَحَبَّ إلى النبيِّ صَلَّى اللهُ عليه وسلَّمَ - يُرِيدُ عَائِشَةَ - قالَ عُمَرُ: وكُنَّا قدْ تَحَدَّثْنَا أنَّ غَسَّانَ تُنْعِلُ الخَيْلَ لِغَزْوِنَا، فَنَزَلَ صَاحِبِي الأنْصَارِيُّ يَومَ نَوْبَتِهِ، فَرَجَعَ إلَيْنَا عِشَاءً فَضَرَبَ بَابِي ضَرْبًا شَدِيدًا، وقالَ: أثَمَّ هُوَ؟ فَفَزِعْتُ فَخَرَجْتُ إلَيْهِ، فَقالَ: قدْ حَدَثَ اليومَ أمْرٌ عَظِيمٌ، قُلتُ: ما هُوَ، أجَاءَ غَسَّانُ؟ قالَ: لَا، بَلْ أعْظَمُ مِن ذلكَ وأَهْوَلُ، طَلَّقَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ نِسَاءَهُ، - وقالَ عُبَيْدُ بنُ حُنَيْنٍ: سَمِعَ ابْنَ عَبَّاسٍ عن عُمَرَ - فَقالَ: اعْتَزَلَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ أزْوَاجَهُ فَقُلتُ: خَابَتْ حَفْصَةُ وخَسِرَتْ، قدْ كُنْتُ أظُنُّ هذا يُوشِكُ أنْ يَكونَ، فَجَمَعْتُ عَلَيَّ ثِيَابِي، فَصَلَّيْتُ صَلَاةَ الفَجْرِ مع النبيِّ صَلَّى اللهُ عليه وسلَّمَ، فَدَخَلَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ مَشْرُبَةً له فَاعْتَزَلَ فِيهَا، ودَخَلْتُ علَى حَفْصَةَ فَإِذَا هي تَبْكِي، فَقُلتُ: ما يُبْكِيكِ ألَمْ أكُنْ حَذَّرْتُكِ هذا، أطَلَّقَكُنَّ النبيُّ صَلَّى اللهُ عليه وسلَّمَ؟ قالَتْ: لا أدْرِي، هَا هو ذَا مُعْتَزِلٌ في المَشْرُبَةِ، فَخَرَجْتُ فَجِئْتُ إلى المِنْبَرِ، فَإِذَا حَوْلَهُ رَهْطٌ يَبْكِي بَعْضُهُمْ، فَجَلَسْتُ معهُمْ قَلِيلًا، ثُمَّ غَلَبَنِي ما أجِدُ، فَجِئْتُ المَشْرُبَةَ الَّتي فِيهَا النبيُّ صَلَّى اللهُ عليه وسلَّمَ، فَقُلتُ لِغُلَامٍ له أسْوَدَ: اسْتَأْذِنْ لِعُمَرَ، فَدَخَلَ الغُلَامُ فَكَلَّمَ النبيَّ صَلَّى اللهُ عليه وسلَّمَ ثُمَّ رَجَعَ، فَقالَ: كَلَّمْتُ النبيَّ صَلَّى اللهُ عليه وسلَّمَ وذَكَرْتُكَ له فَصَمَتَ، فَانْصَرَفْتُ حتَّى جَلَسْتُ مع الرَّهْطِ الَّذِينَ عِنْدَ المِنْبَرِ، ثُمَّ غَلَبَنِي ما أجِدُ فَجِئْتُ فَقُلتُ لِلْغُلَامِ: اسْتَأْذِنْ لِعُمَرَ، فَدَخَلَ ثُمَّ رَجَعَ، فَقالَ: قدْ ذَكَرْتُكَ له فَصَمَتَ، فَرَجَعْتُ فَجَلَسْتُ مع الرَّهْطِ الَّذِينَ عِنْدَ المِنْبَرِ، ثُمَّ غَلَبَنِي ما أجِدُ، فَجِئْتُ الغُلَامَ فَقُلتُ: اسْتَأْذِنْ لِعُمَرَ، فَدَخَلَ ثُمَّ رَجَعَ إلَيَّ فَقالَ: قدْ ذَكَرْتُكَ له فَصَمَتَ، فَلَمَّا ولَّيْتُ مُنْصَرِفًا، قالَ: إذَا الغُلَامُ يَدْعُونِي، فَقالَ: قدْ أذِنَ لكَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ، فَدَخَلْتُ علَى رَسولِ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ فَإِذَا هو مُضْطَجِعٌ علَى رِمَالِ حَصِيرٍ، ليسَ بيْنَهُ وبيْنَهُ فِرَاشٌ، قدْ أثَّرَ الرِّمَالُ بجَنْبِهِ، مُتَّكِئًا علَى وِسَادَةٍ مِن أدَمٍ حَشْوُهَا لِيفٌ ، فَسَلَّمْتُ عليه، ثُمَّ قُلتُ وأَنَا قَائِمٌ: يا رَسولَ اللَّهِ، أطَلَّقْتَ نِسَاءَكَ؟ فَرَفَعَ إلَيَّ بَصَرَهُ فَقالَ: لا فَقُلتُ: اللَّهُ أكْبَرُ، ثُمَّ قُلتُ وأَنَا قَائِمٌ أسْتَأْنِسُ: يا رَسولَ اللَّهِ، لو رَأَيْتَنِي وكُنَّا مَعْشَرَ قُرَيْشٍ نَغْلِبُ النِّسَاءَ، فَلَمَّا قَدِمْنَا المَدِينَةَ إذَا قَوْمٌ تَغْلِبُهُمْ نِسَاؤُهُمْ، فَتَبَسَّمَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ، ثُمَّ قُلتُ: يا رَسولَ اللَّهِ لو رَأَيْتَنِي ودَخَلْتُ علَى حَفْصَةَ فَقُلتُ لَهَا: لا يَغُرَّنَّكِ أنْ كَانَتْ جَارَتُكِ أوْضَأَ مِنْكِ، وأَحَبَّ إلى النبيِّ صَلَّى اللهُ عليه وسلَّمَ - يُرِيدُ عَائِشَةَ - فَتَبَسَّمَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ تَبَسُّمَةً أُخْرَى، فَجَلَسْتُ حِينَ رَأَيْتُهُ تَبَسَّمَ، فَرَفَعْتُ بَصَرِي في بَيْتِهِ، فَوَاللَّهِ ما رَأَيْتُ في بَيْتِهِ شيئًا يَرُدُّ البَصَرَ، غيرَ أهَبَةٍ ثَلَاثَةٍ، فَقُلتُ: يا رَسولَ اللَّهِ ادْعُ اللَّهَ فَلْيُوَسِّعْ علَى أُمَّتِكَ، فإنَّ فَارِسَ والرُّومَ قدْ وُسِّعَ عليهم وأُعْطُوا الدُّنْيَا، وهُمْ لا يَعْبُدُونَ اللَّهَ، فَجَلَسَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ وكانَ مُتَّكِئًا ، فَقالَ: أوفي هذا أنْتَ يا ابْنَ الخَطَّابِ، إنَّ أُولَئِكَ قَوْمٌ عُجِّلُوا طَيِّبَاتِهِمْ في الحَيَاةِ الدُّنْيَا فَقُلتُ: يا رَسولَ اللَّهِ اسْتَغْفِرْ لِي، فَاعْتَزَلَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ نِسَاءَهُ مِن أجْلِ ذلكَ الحَديثِ حِينَ أفْشَتْهُ حَفْصَةُ إلى عَائِشَةَ تِسْعًا وعِشْرِينَ لَيْلَةً، وكانَ قالَ: ما أنَا بدَاخِلٍ عليهنَّ شَهْرًا مِن شِدَّةِ مَوْجِدَتِهِ عليهنَّ حِينَ عَاتَبَهُ اللَّهُ، فَلَمَّا مَضَتْ تِسْعٌ وعِشْرُونَ لَيْلَةً دَخَلَ علَى عَائِشَةَ فَبَدَأَ بهَا، فَقالَتْ له عَائِشَةُ: يا رَسولَ اللَّهِ، إنَّكَ كُنْتَ قدْ أقْسَمْتَ أنْ لا تَدْخُلَ عَلَيْنَا شَهْرًا، وإنَّما أصْبَحْتَ مِن تِسْعٍ وعِشْرِينَ لَيْلَةً أعُدُّهَا عَدًّا، فَقالَ: الشَّهْرُ تِسْعٌ وعِشْرُونَ لَيْلَةً فَكانَ ذلكَ الشَّهْرُ تِسْعًا وعِشْرِينَ لَيْلَةً، قالَتْ عَائِشَةُ: ثُمَّ أنْزَلَ اللَّهُ تَعَالَى آيَةَ التَّخَيُّرِ، فَبَدَأَ بي أوَّلَ امْرَأَةٍ مِن نِسَائِهِ فَاخْتَرْتُهُ، ثُمَّ خَيَّرَ نِسَاءَهُ كُلَّهُنَّ فَقُلْنَ مِثْلَ ما قالَتْ عَائِشَةُ.]"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"صحيح من حديث الزهري عن عبد الله عنه، وغريب من حديث أسيد بن أبي الأسود عن الزهري تفرد به عنه أخوه صالح","bab":"وضوء › المساعدة في الوضوء","dorar":"hRZAFsAG"},{"id":"س-03179","fp":"0e4a6e81caee","stateId":253,"easy":"إذا آذيت العباس ← فقد آذيت النبي ﷺ","cause":"من آذى عَمِّي","result":"فقد آذاني","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"similar":["س-08384"],"ref":"سنن الترمذي 3758","srcLabel":"النسائي","text":["أن العباسَ بنَ عبدِ المُطَّلِبِ، دخل على رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّم مُغْضَبًا وأنَا عنده، فقال : ما أَغْضَبَكَ ؟ قال : يا رسولَ اللهِ ! ما لنا ولِقريشٍ ! إذا تَلَاقَوْا بينهم، تَلَاقَوْا بوجوهٍ مُبَشِّرَةٍ، وإذا لَقُونَا، لَقُونَا بغيرِ ذلك، قال : فغَضِبَ رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم حتى احْمَرَّ وجهُه، ثم قال : والذي نفسي بيدِهِ، لا يَدْخُلُ قلبَ رجلٍ الإيمانُ حتى يُحِبَّكم للهِ ولرسولِهِ، ثم قال : يا أَيُّها الناسُ ! ",["من آذى عَمِّي",1]," ",["فقد آذاني",2],"، فإنما عَمُّ الرجلِ صِنْوُ أبيهِ"],"grade":"صحيح","narrator":"عبدالمطلب بن ربيعة بن الحارث","muhaddith":"حسن صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (8120)، والطبراني (20/ 284) (672) كلاهما بلفظه، وأحمد (17516) بنحوه .","bab":"إيمان › حب الرسول","dorar":"WWwB6Kfe"},{"id":"س-03183","fp":"9c99e2701109","stateId":253,"easy":"إذا أبغضت العرب ← فقد أبغضت النبي ﷺ","cause":"ومن أبغضَ العربَ","result":"فقد أبغضني","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"حلية الأولياء 2/378","srcLabel":"البزار","text":["حبُّ العربِ إيمانٌ ، وبغضُّ العربِ كفرٌ ، فمن أحبَّ العربَ فقد أحبَّني ، ",["ومن أبغضَ العربَ",1]," ",["فقد أبغضني",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"غريب من حديث ثابت عن أنس تفرد به الهيثم بن جماز","takhrij":"أخرجه البزار (6997) بنحوه، والعقيلي في ((الضعفاء الكبير)) (4/355) باختلاف يسير، وأبو نعيم في ((حلية الأولياء)) (2/333) واللفظ له","bab":"إيمان › حب الرسول","dorar":"EboA4xY3"},{"id":"س-08340","fp":"915c2dd95dab","stateId":253,"easy":"إذا سببت علياً ← فقد سببت النبي ﷺ","cause":"مَن سبَّ عليًّا","result":"فقد سبَّني ، و مَن سبَّني فقد سبَّ اللهَ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"الجامع الصغير 8717","srcLabel":"السنة","text":[["مَن سبَّ عليًّا",1]," ",["فقد سبَّني ، و مَن سبَّني فقد سبَّ اللهَ",2]],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"صحيح","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"EnMLC4Kn"},{"id":"س-08341","fp":"76ca9c294da9","stateId":253,"easy":"إذا آذيت أصحاب النبي ﷺ ← فقد آذيته وآذيت الله، ويوشك أن يأخذك","cause":"ومَنْ آذاهم","result":"فَقَدْ آذانِي ، ومَنْ آذانِي فقَدْ آذى اللهَ ، ومَنْ آذى اللهَ يوشِكُ أنْ يأخذَهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"الجامع الصغير 1436","srcLabel":"الترمذي","text":["اللهَ اللهَ في أصحابِي ، لَا تَتَّخِذُونَهم غرضًا بعدي ، فمَنْ أحبَّهم فبِحُبِّي أحبَّهم ، ومَنْ أبغَضَهُم فبِبُغْضِي أبغَضَهم ، ",["ومَنْ آذاهم",1]," ",["فَقَدْ آذانِي ، ومَنْ آذانِي فقَدْ آذى اللهَ ، ومَنْ آذى اللهَ يوشِكُ أنْ يأخذَهُ",2]," ."],"grade":"صحيح","narrator":"عبدالله بن مغفل","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3862)، وأحمد (16803)، وابن أبي عاصم في ((السنة)) (992) باختلاف يسير.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"1eYOw3IV"},{"id":"س-08363","fp":"e881ed20556e","stateId":253,"easy":"إذا آذيت علياً ← فقد آذيت النبي ﷺ وآذيت الله","cause":"من آذاك","result":"فقد آذاني، ومن آذاني فقد آذى اللهَ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"repOf":"س-08400","ref":"السلسلة الصحيحة 2295","text":["من آذَى عليًّا فقد آذَانِي. [وحديث جابِرِ بنِ عَبدِ اللهِ: قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم لعليٍّ: ",["من آذاك",1]," ",["فقد آذاني، ومن آذاني فقد آذى اللهَ",2],"]"],"grade":"صحيح","narrator":"عمرو بن شاس وسعد بن أبي وقاص وجابر بن","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرجه ابن سعد (6/ 160)، وابن أبي شيبة (32108) بلفظه، وأحمد (15960) مطولا.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"XybLayXB"},{"id":"س-08421","fp":"f661cf52d0b7","stateId":253,"easy":"إذا سببت أصحاب النبي ﷺ ← لعنك الله","cause":"مَن سبَّ أصحابي","result":"لعَن اللهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"مجمع الزوائد 10/24","srcLabel":"الطبراني","text":["لا تسبُّوا أصحابي ",["لعَن اللهُ",2]," ",["مَن سبَّ أصحابي",1]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"رجاله رجال الصحيح غير علي بن سهل وهو ثقة","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (4771) بلفظه.","bab":"مناقب وفضائل › فضائل جمع من الصحابة والتابعين","dorar":"DaUf7a3d"},{"id":"س-08384","fp":"4fc3cee44d78","stateId":253,"easy":"إذا آذيت العباس ← فقد آذيت النبي ﷺ","cause":"مَنْ آذَى العبَّاسَ","result":"فقدْ آذانِي","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"repOf":"س-03179","ref":"صحيح الجامع 5922","text":[["مَنْ آذَى العبَّاسَ",1]," ",["فقدْ آذانِي",2]," ، إنَّما عَمُّ الرجلِ صِنْوُ أبيهِ"],"grade":"حسن","narrator":"عبدالله بن عباس وأبو مجلز وعبدالمطلب","muhaddith":"حسن","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"9y3La3KS"},{"id":"س-04109","fp":"c81f70607784","stateId":254,"easy":"إذا ضربت الخدود وشققت الجيوب أو دعوت بدعوى الجاهلية ← فلست منا","cause":"ضربَ الخدودَ وشقَّ الجيوبَ أو دَعَا بدعوى الجاهليةِ","result":"ليسَ منَّا من","explicit":true,"star":true,"ref":"تخريج المسند لشاكر 6/197","srcLabel":"البخاري","text":["عن عبدِاللهِ أنهُ قال : ",["ليسَ منَّا من",2],[" ضربَ الخدودَ وشقَّ الجيوبَ أو دَعَا بدعوى الجاهليةِ",1]," قال سليمانُ : وأحسبُهُ قد رفعهُ إلى النبيِّ صلَّى اللهُ عليهِ وسلَّمَ"],"grade":"صحيح","narrator":"مسروق بن الأجدع","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (1297)، والنسائي (1860) بلفظه.","bab":"جنائز وموت › البكاء على الميت","dorar":"29UwPFxG","merged":5,"otherRefs":["غاية المرام 314 (صحيح)","صحيح مسلم 103 (صحيح)","صحيح الترمذي 999 (صحيح)","صحيح النسائي 1859 (صحيح)"]},{"id":"س-08279","fp":"4f3b832d39eb","stateId":254,"easy":"إذا صرخت أو حلقت أو شققت ثيابك عند المصيبة ← فلست منا","cause":"سَلَقَ، ومَنْ حَلَقَ، ومَنْ خَرَقَ","result":"ليس مِنَّا مَنْ","explicit":true,"star":true,"ref":"تخريج سنن أبي داود 3130","srcLabel":"مسلم","text":["عن يزيد بن أوس قال: دخلتُ على أبي موسَى وَهوَ ثَقيلٌ، فذَهَبتِ امرأتُهُ لتبكيَ أو تَهُمَّ بِهِ فقالَ لَها أبو موسى: أَمَا سمِعْتِ ما قال رسولُ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ؟ قالَتْ: بلى، قال: فسكَتَتْ، فلمَّا مات أبو موسى قال يَزيدُ: لَقِيتُ المرأةَ فقلتُ لها: ما قَولُ أبي موسى لكِ: أَمَا سمِعْتِ قَولَ رسولِ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ، ثُمَّ سكَتَ؟ قالَتْ: قال رسولُ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ: ",["ليس مِنَّا مَنْ",2],[" سَلَقَ، ومَنْ حَلَقَ، ومَنْ خَرَقَ ",1],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3130) بلفظه، ومسلم (104)، وأحمد (1865)، والنسائي (19535) جميعهم بختلاف يسير.","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"luortLjU","merged":14,"otherRefs":["صحيح النسائي 1862 (صحيح)","صحيح الجامع 1460 (صحيح)","صحيح مسلم 104 (صحيح)","صحيح ابن حبان 3151 (صحيح)","صحيح ابن حبان 3154 (صحيح)","تخريج المسند لشعيب 19616 (صحيح)","تخريج مشكل الآثار 1333 (صحيح)","تخريج المسند لشعيب 19617 (صحيح)","تخريج مشكل الآثار 1332 (صحيح)","تخريج صحيح ابن حبان 3152 (صحيح)","حلية الأولياء 2/246 (صحيح)","صحيح ابن حبان 3150 (صحيح)","تخريج المسند لشعيب 19626 (صحيح)"]},{"id":"س-03120","fp":"3ed122be7fdb","stateId":254,"easy":"إذا جزعت ← فلك الجزع (ولا أجر)","cause":"ومَن جَزِعَ","result":"فله الجَزَعُ","explicit":true,"ref":"تخريج زاد المعاد 4/177","srcLabel":"أحمد","text":["إنَّ اللهَ عزَّ وجلَّ إذا أحبَّ قَومًا ابْتلاهُم، فمَن صَبَرَ فله الصَّبْرُ، ",["ومَن جَزِعَ",1]," ",["فله الجَزَعُ",2],"."],"grade":"صحيح","narrator":"محمود بن لبيد","muhaddith":"صحيح","takhrij":"أخرجه أحمد (23633)، والبيهقي في ((شعب الإيمان)) (9327)، وأبو العباس الأصم في ((جزئه)) (342) بلفظه.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"JkfltjQn","merged":2,"otherRefs":["صحيح الترغيب 3406 (صحيح)"]},{"id":"س-04961","fp":"f0b42da4f3f2","stateId":254,"easy":"إذا نحت أو استمعت للنياحة ← لُعنت","cause":"النَّائحةَ والمُسْتمِعةَ","result":"لعَنَ","explicit":true,"ref":"فتاوى نور على الدرب لابن عثيمين 6/251","srcLabel":"السنة","text":["عن النَّبيِّ صلَّى اللهُ عليه وسلَّمَ: أنَّه ",["لعَنَ",2]," ",["النَّائحةَ والمُسْتمِعةَ",1],"."],"grade":"صحيح","muhaddith":"[ثابت]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"zMn0ljtQ","merged":2,"otherRefs":["الجامع الصغير 7253 (صحيح)"]},{"id":"س-05184","fp":"558a09143c0b","stateId":254,"easy":"إذا خمشت وجهك أو شققت جيبك أو دعوت بالويل ← لُعنت","cause":"الخامِشةَ وجهَها ، والشَّاقَّةَ جيبَها ، والدَّاعيةَ بالويلِ والثُّبورِ","result":"لعَن","explicit":true,"ref":"الترغيب والترهيب 4/271","srcLabel":"ابن ماجه","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ",["لعَن",2]," ",["الخامِشةَ وجهَها ، والشَّاقَّةَ جيبَها ، والدَّاعيةَ بالويلِ والثُّبورِ",1]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن ماجه (1585) واللفظ له، وابن حبان (3156) باختلاف يسير، والطبراني (8/153) (7591) مختصراً باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"I9wSPi6f","merged":2,"otherRefs":["عمدة القاري 8/122 (صحيح)"]},{"id":"س-02753","fp":"de726513778e","stateId":254,"easy":"إذا نُدبت بما ليس فيك بعد موتك ← تلعنك الملائكة (توبيخاً)","cause":"ميتٍ يَندُبُ بما ليس فيه","result":"إلا الملائكةُ تَلعَنُه","explicit":true,"ref":"إتحاف الخيرة المهرة 2/505","srcLabel":"أحمد","text":["لما أصيبُ عُمرُ ، دخَلَتْ إليه حفصةُ فقالتْ : يا صاحبَ رسولِ اللهِ ، ويا صِهرَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم ، ويا أميرَ المؤمِنينَ ، فقال عُمرُ لابنِ عُمرُ : أجلِسْني يا عبدَ اللهِ ، أجلِسْني ، فلا صبرَ لي على ما أسمَعُ ، فأسنَدَه إلى صدرِه ، فقال لها : إني أحرجُ عليكِ بما لي عليكِ منَ الحقِّ أن تَندُبيني بعدَ مجلِسِكِ هذا ، فأما عينيكِ فلن أتملَّكَهما ، إنه ليس مِن ",["ميتٍ يَندُبُ بما ليس فيه",1]," ، ",["إلا الملائكةُ تَلعَنُه",2]],"grade":"صحيح","narrator":"المقدام بن معدي كرب","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن سعد في ((الطبقات الكبرى)) (4144) باختلاف يسير، وأحمد بن منيع، والحارث بن أبي أسامة كلاهما كما في ((إتحاف الخيرة المهرة)) (1988) واللفظ لهما","bab":"إيمان › الملائكة","dorar":"6PJZ1LXQ"},{"id":"س-05682","fp":"232ff5cacf19","stateId":254,"easy":"إذا سخطت على البلاء ← فلك السخط","cause":"ومن سخِط","result":"فله السُّخطُ","explicit":true,"otherNeedIds":[9],"ref":"الترغيب والترهيب 4/223","srcLabel":"الترمذي","text":["إنَّ عِظَمَ الجزاءِ مع عِظَمِ البلاءِ ، وإنَّ اللهَ تعالَى إذا أحبَّ قومًا ابتلاهم ، فمن رضِي فله الرِّضا ",["ومن سخِط ",1],["فله السُّخطُ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي بعد حديث (2396)، وابن ماجه (4031)","bab":"رقائق وزهد › الصبر على البلاء","dorar":"6JAtSMug"},{"id":"س-07364","fp":"ce2c7ad1125d","stateId":254,"easy":"إذا صرخت عند المصيبة ← فليس منا","cause":"صاح","result":"ليس هذا منَّا ليس - لصارخٍ - حظٌّ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح ابن حبان 3160","srcLabel":"الحاكم","text":["لمَّا توفِّي ابنُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم ",["صاح",1]," أسامةُ بنُ زيدٍ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( ",["ليس هذا منَّا ليس - لصارخٍ - حظٌّ",2],"، القلبُ يحزَنُ والعينُ تدمَعُ ولا نقولُ ما يُغضِبُ الرَّبَّ )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الحاكم (1428)، وأبو نعيم الأصبهاني في ((حلية الأولياء)) (6/ 256) كلاهما بلفظه.","bab":"فضائل النبي وصفته ودلائل النبوة › أحوال النبي","dorar":"jJW7141D","merged":2,"otherRefs":["أحكام الجنائز 39 (حسن)"]},{"id":"س-07121","fp":"c638aa4dd940","stateId":255,"easy":"إذا قطعت شجر الحرم ← فعليك لعنة الله والملائكة والناس","cause":"لا يُختَلى خَلاها، فمَن فعَلَ ذلك","result":"فعليه لَعنةُ اللهِ والمَلائِكةِ والنَّاسِ أجمَعينَ","explicit":true,"star":true,"ref":"صحيح مسلم 1366","srcLabel":"البخاري","text":["سَألتُ أنَسًا: أحَرَّمَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم المَدينةَ؟ قال: نَعَم، هي حَرامٌ، ",["لا يُختَلى خَلاها، فمَن فعَلَ ذلك",1]," ",["فعليه لَعنةُ اللهِ والمَلائِكةِ والنَّاسِ أجمَعينَ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (13063)، وابن أبي شيبة (38981)، وأبو يعلى (4027) جميعا بلفظه مطولا، والبخاري (1867) بمعناه .","bab":"علم › حسن السؤال ونصح العالم","dorar":"z7SwsdMA"},{"id":"س-04351","fp":"41705f6bf642","stateId":255,"easy":"إذا تعلمت الرمي ثم تركته ← فلست منا","cause":"من تعلَّم الرَّميَ، ثمَّ ترَكَهُ","result":"فليسَ منَّا","explicit":true,"star":true,"ref":"فقه السيرة 210","srcLabel":"مسلم","text":["قلتُ لعُقبةَ بنِ عامرٍ: تختَلِفُ بينَ هذينِ الغرَضَينِ تتردَّدُ بينَهما، وأنتَ شيخٌ كبيرٌ، يشقُّ عليْكَ ؟ قالَ عُقبةُ: لولا كلامٌ سمعتُهُ من رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ لم أعانِهِ، قالَ: وما ذاكَ ؟ قالَ سمعتُهُ يقول:",["من تعلَّم الرَّميَ، ثمَّ ترَكَهُ، ",1],["فليسَ منَّا",2]],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح أخرجه مسلم وروى الجملة الأخيرة منه أصحاب السنن","takhrij":"أخرجه مسلم (1919)، وأبو عوانة في ((المستخرج)) (7938)، والروياني في ((مسنده)) (195) باختلاف يسير.","bab":"جهاد › الترغيب في الجهاد","dorar":"R5ylEW10","merged":2,"otherRefs":["صحيح مسلم 1919 (صحيح)"]},{"id":"س-04929","fp":"6eb094c22883","stateId":255,"easy":"إذا أبق العبد ← برئت منه الذمة","cause":"أيُّما عَبدٍ أبَقَ","result":"فقد بَرِئَتْ منه الذِّمَّةُ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 19155","srcLabel":"مسلم","text":[["أيُّما عَبدٍ أبَقَ",1],"، ",["فقد بَرِئَتْ منه الذِّمَّةُ",2],"."],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه مسلم (69)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Yv6tnh79","merged":2,"otherRefs":["تخريج المسند لشعيب 19211 (صحيح)"]},{"id":"س-06903","fp":"5a0be2f2c65c","stateId":255,"easy":"إذا لم تسأل الله ← يغضب عليك","cause":"مَن لم يَسْأَلِ اللهَ","result":"يَغْضَبْ عليه","explicit":true,"star":true,"ref":"شرح الطحاوية 459","srcLabel":"الترمذي","text":[["مَن لم يَسْأَلِ اللهَ ( ",1],["يَغْضَبْ عليه )",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3373) واللفظ له، وابن ماجه (3827)، وأحمد (9719))","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"FxaqY8BX","merged":6,"otherRefs":["الجامع الصغير 6051 (حسن)","المستدرك على الصحيحين 1830 (صحيح)","إرشاد الساري 9/173 (حسن)","تفسير القرآن العظيم 7/142 (حسن)","صحيح الأدب المفرد 512 (حسن)"]},{"id":"ق-0183","fp":"045b55a805c2","stateId":255,"easy":"ما يُسخط الله ← سخط الله وجهنم","cause":"ما يُسخط الله","result":"سخط الله وجهنم","explicit":true,"otherNeedIds":[57],"ref":"سورة آل عمران: 162","srcLabel":"القرآن الكريم","quran":{"s":3,"from":162,"to":162,"text":"أَفَمَنِ اتَّبَعَ رِضْوَانَ اللَّهِ كَمَنْ بَاءَ بِسَخَطٍ مِنَ اللَّهِ وَمَأْوَاهُ جَهَنَّمُ وَبِئْسَ الْمَصِيرُ (162)","hl":[[36,92,1]]}},{"id":"ق-0454","fp":"5a3312f50331","stateId":255,"easy":"التولي يوم الزحف ← غضب من الله ومأواه جهنم","cause":"التولي يوم الزحف","result":"غضب من الله ومأواه جهنم","explicit":true,"otherNeedIds":[57],"ref":"سورة الأنفال: 16","srcLabel":"القرآن الكريم","quran":{"s":8,"from":16,"to":16,"text":"وَمَنْ يُوَلِّهِمْ يَوْمَئِذٍ دُبُرَهُ إِلَّا مُتَحَرِّفًا لِقِتَالٍ أَوْ مُتَحَيِّزًا إِلَى فِئَةٍ فَقَدْ بَاءَ بِغَضَبٍ مِنَ اللَّهِ وَمَأْوَاهُ جَهَنَّمُ وَبِئْسَ الْمَصِيرُ (16)","hl":[[0,176,1]]}},{"id":"ق-0523","fp":"426520890dad","stateId":255,"easy":"الفسق ← لا يرضى الله عنهم","cause":"الفسق","result":"لا يرضى الله عنهم","explicit":true,"ref":"سورة التوبة: 96","srcLabel":"القرآن الكريم","quran":{"s":9,"from":96,"to":96,"text":"يَحْلِفُونَ لَكُمْ لِتَرْضَوْا عَنْهُمْ فَإِنْ تَرْضَوْا عَنْهُمْ فَإِنَّ اللَّهَ لَا يَرْضَى عَنِ الْقَوْمِ الْفَاسِقِينَ (96)","hl":[[66,122,1]]}},{"id":"س-04944","fp":"a5a6ece7e80d","stateId":255,"easy":"إذا لم تؤدِّ ما وجب عليك (في الولاء والعهد) ← فعليك لعنة الله والملائكة والناس","cause":"فمَن لم يَفعَلْ ذلك منهم","result":"فعليه لَعنةُ اللهِ والملائكةِ والنَّاسِ أجمعينَ، لا يُقبَلُ منه صَرفٌ ولا عَدلٌ","explicit":true,"otherNeedIds":[45],"ref":"تخريج المسند لشعيب 19541","srcLabel":"أحمد","text":["قام رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ على بابِ بَيتٍ فيه نَفَرٌ مِن قُرَيشٍ، فقال: وأخَذَ بعِضادتَيِ البابِ، ثُمَّ قال: هل في البَيتِ إلَّا قُرَشيٌّ؟ قال: فقيلَ: يا رسولَ اللهِ، غيرُ فُلانٍ، ابنِ أُختِنا، فقال: ابنُ أُختِ القَومِ منهم، قال: ثُمَّ قال: إنَّ هذا الأمْرَ في قُرَيشٍ ما داموا إذا استُرحِموا رَحِموا، وإذا حَكَموا عَدَلوا، وإذا قَسَموا أقسَطوا، ",["فمَن لم يَفعَلْ ذلك منهم",1],"، ",["فعليه لَعنةُ اللهِ والملائكةِ والنَّاسِ أجمعينَ، لا يُقبَلُ منه صَرفٌ ولا عَدلٌ",2],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح لغيره دون قوله: فمن لم يفعل ذلك منهم ... إلى آخر الحديث","takhrij":"أخرجه أحمد (19541) واللفظ له، والبزار (3069)، والروياني في ((المسند)) (559)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"XUcRFkVM","merged":4,"otherRefs":["الترغيب والترهيب 3/211 (حسن)","معالم السنن 4/278 (صحيح)","تخريج المسند لشعيب 19782 (صحيح)"]},{"id":"س-02369","fp":"cfb3815c8762","stateId":255,"easy":"إذا جاءك من يقتلك في الفتنة فكفّ يدك ← تكون المقتول في الجنة والقاتل في النار","cause":"إذا مشى الرجلُ من أمتي إلى الرجلِ ليقتلَه فليقلْ هكذا","result":"فالمقتولُ في الجنةِ والقاتلُ في النارِ","explicit":true,"otherNeedIds":[57],"ref":"تخريج المسند لشاكر 8/65","srcLabel":"أبو داود","text":["كنت أمشى معَ عبدِ اللهِ بنِ عمرَ فإذا نحن برأسٍ منصوبٍ على خشبةٍ قال فقال شقي قاتلُ هذا قال قلت أنت تقولُ هذا يا أبا عبدِ الرحمنِ قال فشدَّ يدَه من يدي وقال أبو عبدِ الرحمنِ سمعتُ رسولَ اللهِ صلَّى اللهُ عليهِ وسلمَ  يقولُ ",["إذا مشى الرجلُ من أمتي إلى الرجلِ ليقتلَه فليقلْ هكذا ",1],["فالمقتولُ في الجنةِ والقاتلُ في النارِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4260) واللفظ له، وأبو يعلى (5732)، وأبو نعيم في ((حلية الأولياء)) (8/ 250) بنحوه.","bab":"إسلام › حرمة المسلم","dorar":"9usD9tLh"},{"id":"س-00822","fp":"8205c0692c27","stateId":255,"easy":"إذا لم يطهّرك ماء البحر ← فلا طهّرك الله","cause":"مَن لم يُطَهِّرْه ماءُ البحرِ","result":"فلا طَهَّرَه اللهُ","explicit":true,"ref":"أسنى المطالب 1/23","srcLabel":"السنة","text":[["مَن لم يُطَهِّرْه ماءُ البحرِ",1]," ",["فلا طَهَّرَه اللهُ",2],"."],"grade":"حسن","muhaddith":"إسناده حسن","bab":"أدعية وأذكار › دعاء النبي على بعض الأشخاص والأشياء والأمور","dorar":"QUxdVNyt"},{"id":"س-02608","fp":"59a126a934d4","stateId":255,"easy":"إذا عقدت الجزية في عنقك (رضيت بالذل) ← برئت مما عليه النبي ﷺ","cause":"مَن عَقدَ الجِزيةَ في عُنُقِه","result":"فقد بَرِئَ مِمَّا عليه رَسولُ اللَّهِ صلَّى اللهُ عليه وسلَّم","explicit":true,"ref":"الفروع لابن مفلح 10/ 302","srcLabel":"أبو داود","text":["\"",["مَن عَقدَ الجِزيةَ في عُنُقِه",1]," ",["فقد بَرِئَ مِمَّا عليه رَسولُ اللَّهِ صلَّى اللهُ عليه وسلَّم",2],"\""],"grade":"حسن","narrator":"معاذ","muhaddith":"إسناد جيد","takhrij":"أخرجه أبو داود (3081)، والطبراني (20/ 100) (196)، والبيهقي (18438) جميعهم بلفظه.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"IrhRjigs"},{"id":"س-05061","fp":"fa8043159e3f","stateId":255,"easy":"إذا مت وأنت ترى السيف على الأمة ← تلقى الله آيساً من رحمته","cause":"مَن مات وهو يرى السَّيفَ على أُمَّتي","result":"لَقِيَ اللهَ مكتوبًا في كفِّهِ: آيِسٌ مِن رحمةِ اللهِ","explicit":true,"otherNeedIds":[57],"ref":"الضعفاء الكبير 2/102","srcLabel":"العقيلي","text":[["مَن مات وهو يرى السَّيفَ على أُمَّتي؛ ",1],["لَقِيَ اللهَ مكتوبًا في كفِّهِ: آيِسٌ مِن رحمةِ اللهِ",2],"."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"روي بغير هذا الإسناد بإسناد صالح","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (2/102) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (3/388)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"iFfejqKZ"},{"id":"س-01761","fp":"58d47ae48360","stateId":255,"easy":"إذا رأيت المنكر فجالست أهله وواكلتهم ← يضرب الله قلبك بقلوبهم ويلعنك","cause":"فنَهَتْهُم علماؤُهم، فلم يَنْتَهُوا فجالَسُوهم في مَجَالِسِهِم وواكَلُوهم وشارَبُوهم","result":"فضرب اللهُ قلوبَ بعضِهم على بعضٍ ولعنهم عَلَى لِسَانِ دَاوُدَ وَعِيسَى ابْنِ مَرْيَمَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[19],"ref":"سنن الترمذي 3047","srcLabel":"أبو داود","text":["لما وقعت بنو إسرائيلَ في المعاصي ",["فنَهَتْهُم علماؤُهم، فلم يَنْتَهُوا فجالَسُوهم في مَجَالِسِهِم وواكَلُوهم وشارَبُوهم",1],"، ",["فضرب اللهُ قلوبَ بعضِهم على بعضٍ ولعنهم { عَلَى لِسَانِ دَاوُدَ وَعِيسَى ابْنِ مَرْيَمَ",2]," ذَلِكَ بِمَا عَصَوْا وَكَانُوا يَعْتَدُونَ } . قال : فجلس رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّم، وكان مُتَّكِئًا، فقال : لا، والذي نفسي بيدِهِ، حتى تَأْطُرُوهم [ على الحَقِّ ] أَطْرًا"],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"حسن غريب","takhrij":"أخرجه أبو داود (4336)، وابن ماجه (4006) بنحوه، وأحمد (3713) باختلاف يسير","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"MmexMIcs"}]}