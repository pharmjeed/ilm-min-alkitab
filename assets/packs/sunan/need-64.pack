{"schema":1,"kind":"sunan-chunk","version":"sunan-2420572879fb","needId":64,"stateIds":[652,653,654,655,656,657,658],"items":[{"id":"ق-0208","fp":"ee36a6ac3ce2","stateId":652,"easy":"تسويف التوبة حتى حضور الموت ← لا تُقبل التوبة","cause":"تسويف التوبة حتى حضور الموت","result":"لا تُقبل التوبة","explicit":true,"star":true,"ref":"سورة النساء: 18","srcLabel":"القرآن الكريم","quran":{"s":4,"from":18,"to":18,"text":"وَلَيْسَتِ التَّوْبَةُ لِلَّذِينَ يَعْمَلُونَ السَّيِّئَاتِ حَتَّى إِذَا حَضَرَ أَحَدَهُمُ الْمَوْتُ قَالَ إِنِّي تُبْتُ الْآنَ وَلَا الَّذِينَ يَمُوتُونَ وَهُمْ كُفَّارٌ أُولَئِكَ أَعْتَدْنَا لَهُمْ عَذَابًا أَلِيمًا (18)","hl":[[0,127,1]]}},{"id":"س-07677","fp":"ce8c34b1e090","stateId":652,"easy":"إذا تحولت قبل موتك فعملت عمل أهل النار ← تموت فتدخل النار","cause":"فإذا كان قبْلَ مَوتِه تَحَوَّلَ فعمِلَ عمَلَ أهلِ النارِ","result":"فمات، فدخَلَ النارَ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 13695","srcLabel":"مسلم","text":["إنَّ الرَّجُلَ لَيَعمَلُ البُرْهةَ مِن عُمُرِه بالعمل الذي لو مات عليه دخَلَ الجَنَّةَ، ",["فإذا كان قبْلَ مَوتِه تَحَوَّلَ فعمِلَ عمَلَ أهلِ النارِ",1],"، ",["فمات، فدخَلَ النارَ",2],". وإنَّ الرَّجُلَ لَيَعمَلُ البُرْهةَ مِن عُمُرِه بالعملِ الذي لو مات عليه دخَلَ النارَ، فإذا كان قبْلَ مَوتِه تَحَوَّلَ فعمِلَ بعمَلِ أهلِ الجَنَّةِ، فمات، فدخَلَ الجَنَّةَ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (13695)، وأبو يعلى (3829)، والطبراني في ((المعجم الأوسط)) (6428)","bab":"قدر › العمل بالخواتيم","dorar":"HbnkgKES"},{"id":"س-08450","fp":"439716daa9fb","stateId":652,"easy":"إذا رفضت السجود كبراً ← تموت كافراً (من واقعة)","cause":"كَفًّا مِن حَصًى -أو تُرابٍ- فرَفَعَه إلى وجهِه، وقال: يَكفيني هذا","result":"رَأيتُه بَعدُ قُتِلَ كافِرًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-07759"],"otherNeedIds":[22],"ref":"صحيح البخاري 1070","srcLabel":"مسلم","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم قَرَأ سورةَ النَّجمِ، فسَجَدَ بها، فما بَقيَ أحَدٌ مِنَ القَومِ إلَّا سَجَدَ، فأخَذَ رَجُلٌ مِنَ القَومِ ",["كَفًّا مِن حَصًى -أو تُرابٍ- فرَفَعَه إلى وجهِه، وقال: يَكفيني هذا",1],"، قال عبدُ اللهِ: فلقد ",["رَأيتُه بَعدُ قُتِلَ كافِرًا",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (576) باختلاف يسير","bab":"نفاق › علامة المنافق وصفاته","dorar":"hqP6AIDQ","merged":9,"otherRefs":["صحيح البخاري 3853 (صحيح)","صحيح البخاري 1067 (صحيح)","ناسخ الحديث ومنسوخه 278 (صحيح)","تخريج المسند لشاكر 5/307 (صحيح)","تخريج المسند لشاكر 6/188 (صحيح)","تخريج صحيح ابن حبان 2764 (صحيح)","تخريج المسند لشعيب 4235 (صحيح)","صحيح مسلم 576 (صحيح)"]},{"id":"س-04973","fp":"21a8944a602b","stateId":652,"easy":"إذا نحرت نفسك ← لا يصلي عليك أهل الفضل","cause":"نَحَر نَفْسَه بمِشقَصٍ","result":"فلم يُصَلِّ عليه النَّبيُّ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[56,28],"ref":"المستدرك على الصحيحين 1365","srcLabel":"مسلم","text":["ماتَ رَجُلٌ على عَهدِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فأتاه رَجُلٌ، فقالَ: ماتَ فُلانٌ، فقالَ له النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: لم يَمُت، ثمَّ أتاه الثَّانِيةَ فقالَ: ماتَ فُلانٌ، فقالَ رسول اللهِ صلَّى اللهُ عليه وسلَّمَ: لم يَمُت، ثمَّ أتاه الثَّالِثةَ فقالَ: ماتَ فُلانٌ، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: كيف ماتَ؟ قالَ: ",["نَحَر نَفْسَه بمِشقَصٍ",1]," كان معه، ",["فلم يُصَلِّ عليه النَّبيُّ",2]," صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"جابر بن سمرة","muhaddith":"صحيح على شرط مسلم","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"MFi9SwHL","merged":5,"otherRefs":["صحيح النسائي 1963 (صحيح)","تخريج المسند لشعيب 20858 (حسن)","تخريج صحيح ابن حبان 3095 (صحيح)","تخريج المسند لشعيب 20883 (حسن)"]},{"id":"ق-0569","fp":"b4387d608031","stateId":652,"easy":"تأخير الإيمان إلى معاينة الهلاك ← لا يُقبل","cause":"تأخير الإيمان إلى معاينة الهلاك","result":"لا يُقبل","explicit":true,"otherNeedIds":[52],"ref":"سورة يونس: 90–91","srcLabel":"القرآن الكريم","quran":{"s":10,"from":90,"to":91,"text":"وَجَاوَزْنَا بِبَنِي إِسْرَائِيلَ الْبَحْرَ فَأَتْبَعَهُمْ فِرْعَوْنُ وَجُنُودُهُ بَغْيًا وَعَدْوًا حَتَّى إِذَا أَدْرَكَهُ الْغَرَقُ قَالَ آمَنْتُ أَنَّهُ لَا إِلَهَ إِلَّا الَّذِي آمَنَتْ بِهِ بَنُو إِسْرَائِيلَ وَأَنَا مِنَ الْمُسْلِمِينَ (90) آلْآنَ وَقَدْ عَصَيْتَ قَبْلُ وَكُنْتَ مِنَ الْمُفْسِدِينَ (91)","hl":[[100,305,1]]}},{"id":"ق-0841","fp":"5f9257e4f104","stateId":652,"easy":"التفريط في العمل حتى مجيء الموت ← طلب الرجعة فلا يجاب","cause":"التفريط في العمل حتى مجيء الموت","result":"طلب الرجعة فلا يجاب","explicit":true,"similar":["ق-1340"],"otherNeedIds":[57],"ref":"سورة المؤمنون: 99–100","srcLabel":"القرآن الكريم","quran":{"s":23,"from":99,"to":100,"text":"حَتَّى إِذَا جَاءَ أَحَدَهُمُ الْمَوْتُ قَالَ رَبِّ ارْجِعُونِ (99) لَعَلِّي أَعْمَلُ صَالِحًا فِيمَا تَرَكْتُ كَلَّا إِنَّهَا كَلِمَةٌ هُوَ قَائِلُهَا وَمِنْ وَرَائِهِمْ بَرْزَخٌ إِلَى يَوْمِ يُبْعَثُونَ (100)","hl":[[0,204,1]]}},{"id":"ق-1018","fp":"40d86d01ad5d","stateId":652,"easy":"الشك والكفر حتى فوات الأوان ← لا يُقبل الإيمان ويحال بينهم وبين ما يشتهون","cause":"الشك والكفر حتى فوات الأوان","result":"لا يُقبل الإيمان ويحال بينهم وبين ما يشتهون","explicit":true,"otherNeedIds":[57],"ref":"سورة سبأ: 51–54","srcLabel":"القرآن الكريم","quran":{"s":34,"from":51,"to":54,"text":"وَلَوْ تَرَى إِذْ فَزِعُوا فَلَا فَوْتَ وَأُخِذُوا مِنْ مَكَانٍ قَرِيبٍ (51) وَقَالُوا آمَنَّا بِهِ وَأَنَّى لَهُمُ التَّنَاوُشُ مِنْ مَكَانٍ بَعِيدٍ (52) وَقَدْ كَفَرُوا بِهِ مِنْ قَبْلُ وَيَقْذِفُونَ بِالْغَيْبِ مِنْ مَكَانٍ بَعِيدٍ (53) وَحِيلَ بَيْنَهُمْ وَبَيْنَ مَا يَشْتَهُونَ كَمَا فُعِلَ بِأَشْيَاعِهِمْ مِنْ قَبْلُ إِنَّهُمْ كَانُوا فِي شَكٍّ مُرِيبٍ (54)","hl":[[0,360,1]]}},{"id":"ق-1126","fp":"804f9d7dc3d6","stateId":652,"easy":"الإيمان عند رؤية البأس ← لا ينفع (سنة الله) وخسر الكافرون","cause":"الإيمان عند رؤية البأس","result":"لا ينفع (سنة الله) وخسر الكافرون","explicit":true,"otherNeedIds":[57],"ref":"سورة غافر: 84–85","srcLabel":"القرآن الكريم","quran":{"s":40,"from":84,"to":85,"text":"فَلَمَّا رَأَوْا بَأْسَنَا قَالُوا آمَنَّا بِاللَّهِ وَحْدَهُ وَكَفَرْنَا بِمَا كُنَّا بِهِ مُشْرِكِينَ (84) فَلَمْ يَكُ يَنْفَعُهُمْ إِيمَانُهُمْ لَمَّا رَأَوْا بَأْسَنَا سُنَّتَ اللَّهِ الَّتِي قَدْ خَلَتْ فِي عِبَادِهِ وَخَسِرَ هُنَالِكَ الْكَافِرُونَ (85)","hl":[[0,254,1]]}},{"id":"ق-1340","fp":"af318faae782","stateId":652,"easy":"تأخير الإنفاق والعمل حتى مجيء الموت ← طلب التأخير فلا يجاب","cause":"تأخير الإنفاق والعمل حتى مجيء الموت","result":"طلب التأخير فلا يجاب","explicit":true,"repOf":"ق-0841","otherNeedIds":[57],"ref":"سورة المنافقون: 10–11","quran":{"s":63,"from":10,"to":11,"text":"وَأَنْفِقُوا مِنْ مَا رَزَقْنَاكُمْ مِنْ قَبْلِ أَنْ يَأْتِيَ أَحَدَكُمُ الْمَوْتُ فَيَقُولَ رَبِّ لَوْلَا أَخَّرْتَنِي إِلَى أَجَلٍ قَرِيبٍ فَأَصَّدَّقَ وَأَكُنْ مِنَ الصَّالِحِينَ (10) وَلَنْ يُؤَخِّرَ اللَّهُ نَفْسًا إِذَا جَاءَ أَجَلُهَا وَاللَّهُ خَبِيرٌ بِمَا تَعْمَلُونَ (11)","hl":[[0,241,1]]}},{"id":"س-07759","fp":"aac48c20282c","stateId":652,"easy":"إذا رفضت السجود لله كبراً ← تموت كافراً (من واقعة)","cause":"كَفًّا مِن تُرابٍ فسَجَدَ عليه","result":"رَأيتُه بَعدَ ذلك قُتِلَ كافِرًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-08450","otherNeedIds":[22],"ref":"صحيح البخاري 4863","text":["عَن عبدِ اللهِ رَضيَ اللهُ عنه، قال: أوَّلُ سورةٍ أُنزِلَت فيها سَجدةٌ والنَّجمِ، قال: فسَجَدَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم وسَجَدَ مَن خَلفَه إلَّا رَجُلًا رَأيتُه أخَذَ ",["كَفًّا مِن تُرابٍ فسَجَدَ عليه",1],"، ف",["رَأيتُه بَعدَ ذلك قُتِلَ كافِرًا",2],"، وهو أُمَيَّةُ بنُ خَلَفٍ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (576) باختلاف يسير","bab":"قرآن › أسباب النزول","dorar":"V4eAq9jp"},{"id":"س-03912","fp":"4f3b4e5818fa","stateId":652,"easy":"إذا حِفت (جُرت) في وصيتك ← يُختم لك بشر عملك فتدخل النار","cause":"فإذا أَوصى حافَ في وَصيَّتِه","result":"فيُختَمُ له بِشَرِّ عَملِهِ، فيَدخُلُ النَّارَ","explicit":true,"otherNeedIds":[69],"ref":"تخريج المسند لشاكر 14/163","srcLabel":"أبو داود","text":["إنَّ الرَّجُلَ لَيَعمَلُ بعَمَلِ أهْلِ الخَيرِ سَبعينَ سَنةً، ",["فإذا أَوصى حافَ في وَصيَّتِه",1],"، ",["فيُختَمُ له بِشَرِّ عَملِهِ، فيَدخُلُ النَّارَ",2],"، وإنَّ الرَّجُلَ لَيَعمَلُ بعَملِ أهلِ الشَّرِّ سَبعينَ سَنةً، فيَعدِلُ في وَصيَّتِه، فيُخْتَمُ له بخيرِ عَملِه، فيَدخُلُ الجنَّةَ. قال: ثمَّ يقولُ أبو هُريرةَ: واقْرَؤوا إنْ شِئتُم: {تِلْكَ حُدُودُ اللَّهِ} إلى قَولِه: {وَلَهُ عَذَابٌ مُهِينٌ} [النساء: 13 - 14]."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2867)، والترمذي (2117) بنحوه، وابن ماجه (2704) باختلاف يسير","bab":"تفسير آيات › سورة النساء","dorar":"alTrvM0H"},{"id":"س-05116","fp":"e500ea991390","stateId":652,"easy":"إذا مت شارباً للخمر في الأربعين (يوماً من شربها) ← مت كافراً (على رواية)","cause":"مات شاربُ الخمرِ في الأربعين","result":"مات كافِرًا","explicit":true,"otherNeedIds":[22],"ref":"تخريج العواصم والقواصم 8/ 131","srcLabel":"النسائي","text":["عن عبدِ اللهِ بنِ عُمَرَ بنِ الخطابِ: وإنْ ",["مات شاربُ الخمرِ في الأربعين",1],"، ",["مات كافِرًا",2],"."],"grade":"صحيح","muhaddith":"وإسناده صحيح","takhrij":"أخرجه النسائي (5668) مطولاً","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"o26MkqsT"},{"id":"س-04653","fp":"3462c0f5f4aa","stateId":653,"easy":"إذا كنت منافقاً فقلت في القبر «لا أدري» ← تلتئم عليك الأرض حتى تختلف أضلاعك","cause":"فإن كان مُنافقًا قال: لا أَدري","result":"للأرضِ: الْتَئِمي عليه، فتَلتئِمُ عليه حتَّى تختَلِفَ أضلاعُه، فلا يَزالُ مُعذَّبًا حتَّى يبعَثَه اللهُ تَعالى مِن مَضجَعِه ذلك","explicit":true,"star":true,"ref":"تخريج شرح الطحاوية 577","srcLabel":"مسلم","text":["(إذا قُبِرَ الميتُ -أو الإنسانُ- أتاه ملَكانِ أسوَدانِ أزرَقانِ، يُقالُ لأحَدِهما: المنكَرُ، وللآخَرِ: النَّكيرُ، فيَقولانِ له: ما كُنتَ تَقولُ في هذا الرَّجلِ محمَّدٍ صلَّى اللهُ عليه وسلَّمَ؟ فهو قائلٌ ما كان يَقولُ، فإنْ كان مؤمِنًا قال: هو عَبدُ اللهِ ورسولُه، أشهَدُ أنْ لا إلهَ إلَّا اللهُ، وأشهَدُ أنَّ محمَّدًا عبدُه ورسولُه.\nفيَقولانِ له: إنْ كُنَّا لَنَعلَمُ أنَّك لتَقولُ ذلك. ثمَّ يُفسَحُ له في قبرِه سَبْعون ذِراعًا في سَبْعين ذِراعًا، ويُنوَّرُ له فيه، فيُقالُ له: نَمْ، فيَنامُ كنَوْمِ العَروسِ الذي لا يُوقِظُه إلَّا أحَبُّ أهلِه إليه، حتَّى يبعَثَه اللهُ مِن مَضجَعِه ذلك. ",["فإن كان مُنافقًا قال: لا أَدري",1],"، كنتُ أسمَعُ النَّاسَ يَقولون شيئًا، فكنتُ أقولُه، فيَقولانِ له: إنْ كُنَّا لنَعلَمُ أنَّك تَقولُ ذلك. ثمَّ يُقالُ ",["للأرضِ: الْتَئِمي عليه، فتَلتئِمُ عليه حتَّى تختَلِفَ أضلاعُه، فلا يَزالُ مُعذَّبًا حتَّى يبعَثَه اللهُ تَعالى مِن مَضجَعِه ذلك",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"قال الترمذي: حسن غريب، وهو كما قال، بل أعلى؛ فإن رجال إسناده على شرط مسلم","takhrij":"أخرجه الترمذي (1071) واللفظ له، والبزار (8462)، وابن حبان (3117)","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"xlwzkXDX","merged":3,"otherRefs":["الترغيب والترهيب 4/283 (صحيح)","إتحاف الخيرة المهرة 2/491 (صحيح)"]},{"id":"س-04623","fp":"5c4a57a7f719","stateId":653,"easy":"إذا مت كافراً ← تنزل إليك ملائكة غلاظ شداد سود الوجوه","cause":"وإنَّ العبدَ الكافرَ","result":"نَزَل إليه من السماءِ ملائكةٌ غِلَاظٌ شِدَادٌ ، سُودُ الوجوهِ ، معَهُمُ المُسُوحُ من النارِ ، فيَجْلِسُونَ منه مَدَّ البَصَرِ ، ثم يَجِيءُ مَلَكُ الموتِ حتى يَجْلِسَ عند رأسِهِ ، فيقولُ : أَيَّتُهَا النَّفْسُ الخبيثةُ اخْرُجِي إلى سَخَطٍ من اللهِ وغَضَبٍ","explicit":true,"star":true,"ref":"أحكام الجنائز 198","srcLabel":"أبو داود","text":["خَرَجْنا مع النبيِّ صلَّى اللهُ عليه وسلَّم في جَنازةِ رجلٍ من الأنصارِ ، فانْتَهَيْنا إلى القبرِ ولَمَّا يُلْحَدْ ، فجلس رسولُ اللهِ صلَّى اللهُ عليه وسلم مُسْتَقْبِلَ القِبْلَةِ ، وجَلَسْنَا حَوْلَهُ ، وكأنَّ على رُؤُوسِنَا الطَّيْرَ ، وفي يَدِهِ عودٌ يَنْكُتُ في الأرضِ ، فجعل يَنْظُرُ إلى السماءِ ، ويَنْظُرُ إلى الأرضِ ، وجعل يرفعُ بَصَرَهُ ويَخْفِضُهُ ، ثلاثًا ، فقال : اسْتَعِيذُوا باللهِ من عذابِ القَبْرِ ، مَرَّتَيْنِ ، أو ثلاثًا ، ثم قال : اللهم إني أعوذُ بك من عذابِ القبرِ ثلاثًا ، ثم قال: إنَّ العبدَ المؤمنَ إذا كان في انقِطاعٍ من الدنيا ، وإقبالٍ من الآخرةِ ، نَزَلَ إليه ملائكةٌ من السماءِ ، بِيضُ الوُجُوهِ ، كأنَّ وجوهَهُمُ الشمسُ ، معهم كَفَنٌ من أكفانِ الجنةِ ، وحَنُوطٌ من حَنُوطِ الجنةِ ، حتى يَجْلِسُوا منه مَدَّ البَصَرِ ، ثم يَجِىءُ مَلَكُ الموتِ عليه السلامُ حتى يَجْلِسَ عندَ رأسِهِ فيقولُ : أَيَّتُها النَّفْسُ الطيبةُ وفي رواية : المطمئنةُ ، اخْرُجِي إلى مغفرةٍ من اللهِ ورِضْوانٍ ، قال : فتَخْرُجُ تَسِيلُ كما تَسِيلُ القَطْرَةُ من فِي السِّقَاءِ ، فيأخُذُها ، وفي روايةٍ : حتى إذا خَرَجَتْ رُوحُه صلَّى عليه كُلُّ مَلَكٍ بينَ السماءِ والأرضِ ، وكُلُّ مَلَكٍ في السماءِ ، وفُتِحَتْ له أبوابُ السماءِ ، ليس من أهلِ بابٍ إلا وهم يَدْعُونَ اللهَ أن يُعْرَجَ برُوحِهِ من قِبَلِهِمْ ، فإذا أخذها لم يَدَعُوها في يَدِهِ طَرْفَةَ عَيْنٍ حتى يأخذوها فيَجْعَلُوها في ذلك الكَفَنِ ، وفي ذلك الحَنُوطِ ، فذلك قولُه تعالى :  تَوَفَّتْهُ رُسُلُنَا وَهُمْ لَا يُفَرِّطُونَ  ، ويخرجُ منها كأَطْيَبِ نَفْحَةِ مِسْكٍ وُجِدَتْ على وجهِ الأرضِ ، قال : فيَصْعَدُونَ بها فلا يَمُرُّونَ – يعني – بها على مَلَأٍ من الملائكةِ إلا قالوا : ما هذا الرُّوحُ الطَّيِّبُ ؟ فيقولونَ : فلانُ ابنُ فلانٍ – بأَحْسَنِ أسمائِهِ التي كانوا يُسَمُّونَهُ بها في الدنيا ، حتى يَنْتَهُوا بها إلى السماءِ الدنيا ، فيَسْتَفْتِحُونَ له ، فيُفْتَحُ لهم ، فيُشَيِّعُهُ من كلِّ سماءٍ مُقَرَّبُوها ، إلى السماءِ التي تَلِيها ، حتى يُنْتَهَي به إلى السماءِ السابعةِ ، فيقولُ اللهُ عَزَّ وجَلَّ : اكْتُبُوا كتابَ عَبْدِي في عِلِّيِّينَ  وَمَا أَدْرَاكَ مَا عِلِّيُّونَ . كِتَابٌ مَرْقُومٌ يَشْهَدُهُ الْمُقَرَّبُونَ  فيُكْتَبُ كتابُه في عِلِّيِّينَ ، ثم يُقَالُ : أَعِيدُوهُ إلى الأرضِ ، فإني وَعَدْتُهُم أني منها خَلَقْتُهُم ، وفيها أُعِيدُهُم ومنها أُخْرِجُهُم تارةً أُخْرَى ، قال : فيُرَدُّ إلى الأرضِ ، و تُعَادُ رُوحُهُ في جَسَدِهِ ، قال : فإنه يَسْمَعُ خَفْقَ نِعالِ أصحابِه إذا وَلَّوْا عنه مُدْبِرِينَ ، فيَأْتِيهِ مَلَكانِ شَدِيدَا الانتهارِ فيَنْتَهِرَانِهِ ، ويُجْلِسَانِهِ فيَقُولانِ له : مَن ربُّكَ ؟ فيقولُ : رَبِّيَ اللهُ ، فيقولانِ له : ما دِينُكَ ؟ فيقولُ : دِينِيَ الإسلامُ ، فيقولانِ له : ما هذا الرجلُ الذي بُعِثَ فيكم ؟ فيقولُ : هو رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ، فيقولانِ له : وما [علمُكَ] ؟ فيقولُ : قرأتُ كتابَ اللهِ ، فآمَنْتُ به ، وصَدَّقْتُ ، فيَنْتَهِرُهُ فيقولُ : مَن رَبُّكَ ؟ ما دِينُكَ ؟ مَن نبيُّكَ ؟ وهي آخِرُ فتنةٍ تُعْرَضُ على المؤمنِ ، فذلك حينَ يقولُ اللهُ عَزَّ وجَلَّ :  {يُثَبِّتُ اللَّهُ الَّذِينَ آمَنُوا بِالْقَوْلِ الثَّابِتِ فِي الْحَيَاةِ الدُّنْيَا} ، فيقولُ : رَبِّيَ اللهُ ، ودِينِيَ الإسلامُ ، ونَبِيِّي مُحَمَّدٌ صلَّى اللهُ عليه وسلَّم ، فيُنَادِي مُنَادٍ في السماءِ : أن صَدَقَ عَبْدِي ، فأَفْرِشُوهُ من الجنةِ ، وأَلْبِسُوهُ من الجنةِ ، وافْتَحُوا له بابًا إلى الجنةِ ، قال : فيَأْتِيهِ من رَوحِها وطِيبِها ، ويُفْسَحُ له في قبرِه مَدَّ بَصَرِهِ ، قال : ويَأْتِيهِ- وفي روايةٍ : يُمَثَّلُ له- رجلٌ حَسَنُ الوجهِ ، حَسَنُ الثيابِ ، طَيِّبُ الرِّيحِ ، فيقولُ : أَبْشِرْ بالذي يَسُرُّكَ ، أَبْشِرِ برِضْوانٍ من اللهِ ، وجَنَّاتٍ فيها نعيمٌ مُقِيمٌ ، هذا يومُكَ الذي كنتَ تُوعَدُ ، فيقولُ له : وأنت فبَشَّرَكَ اللهُ بخيرٍ مَن أنت ؟ فوَجْهُكَ الوجهُ يَجِئُ بالخيرِ ، فيقولُ : أنا عَمَلُكَ الصالِحُ فواللهِ ما عَلِمْتُكَ إلا كنتَ سريعًا في طاعةِ اللهِ ، بطيئًا في معصيةِ اللهِ ، فجزاك اللهُ خيرًا ، ثم يُفْتَحُ له بابٌ من الجنةِ ، وبابٌ من النارِ ، فيُقالُ : هذا مَنْزِلُكَ لو عَصَيْتَ اللهَ ، أَبْدَلَكَ اللهُ به هذا ، فإذا رأى ما في الجنةِ قال : رَبِّ عَجِّلْ قيامَ الساعةِ ، كَيْما أَرْجِعَ إلى أهلي ومالي ، فيُقالُ له : اسْكُنْ ، قال : ",["وإنَّ العبدَ الكافرَ",1],"- وفي روايةٍ : الفاجرَ- إذا كان في انقطاعٍ من الدنيا ، وإقبالٍ من الآخرةِ ، ",["نَزَل إليه من السماءِ ملائكةٌ غِلَاظٌ شِدَادٌ ، سُودُ الوجوهِ ، معَهُمُ المُسُوحُ من النارِ ، فيَجْلِسُونَ منه مَدَّ البَصَرِ ، ثم يَجِيءُ مَلَكُ الموتِ حتى يَجْلِسَ عند رأسِهِ ، فيقولُ : أَيَّتُهَا النَّفْسُ الخبيثةُ اخْرُجِي إلى سَخَطٍ من اللهِ وغَضَبٍ",2]," ، قال : فتفَرَّقُ في جَسَدِهِ فيَنْتَزِعُها كما يُنْتَزَعُ السَّفُّودُ الكثيرُ الشُّعبِ من الصُّوفِ المَبْلُولِ ، فتَقْطَعُ معها العُرُوقَ والعَصَبَ ، فيَلْعَنُهُ كلُّ مَلَكٍ بينَ السماءِ والأرضِ ، وكلُّ مَلَكِ في السماءِ ، وتُغْلَقُ أبوابُ السماءِ ، ليس من أهلِ بابٍ إلا وهم يَدْعُونَ اللهَ أَلَّا تَعْرُجَ رُوحُهُ من قِبَلِهِمْ ، فيَأْخُذُها ، فإذا أخذها ، لم يَدَعُوها في يَدِهِ طَرْفَةَ عينٍ حتى يَجْعَلُوها في تِلْكِ المُسُوحِ ، ويخرجُ منها كأَنْتَنِ رِيحِ جِيفَةٍ وُجِدَتْ على وجهِ الأرضِ ، فيَصْعَدُونَ بها ، فلا يَمُرُّونَ بها على مَلَأٍ من الملائكةِ إلا قالوا : ما هذا الرُّوحُ الخَبِيثُ ؟ فيقولونَ : فلانُ ابنُ فلانٍ – بأَقْبَحِ أسمائِهِ التي كان يُسَمَّى بها في الدنيا ، حتى يُنْتَهَي به إلى السماءِ الدنيا ، فيُسْتَفْتَحُ له ، فلا يُفْتَحُ له ، ثم قرأ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم  {لَا تُفَتَّحُ لَهُمْ أَبْوَابُ السَّمَاءِ وَلَا يَدْخُلُونَ الْجَنَّةَ حَتَّى يَلِجَ الْجَمَلُ فِي سَمِّ الْخِيَاطِ}  فيقولُ اللهُ عَزَّ وجَلَّ : اكْتُبُوا كتابَه في سِجِّينَ في الأرضِ السُّفْلَى ، ثم يُقالُ : أَعِيدُوا عَبْدِي إلى الأرضِ فإني وَعَدْتُهُمْ أني منها خَلَقْتُهُمْ ، وفيها أُعِيدُهُمْ ، ومنها أُخْرِجُهُمْ تارةً أُخْرَى ، فتُطْرَحُ رُوحُهُ من السماءِ طَرْحًا حتى تَقَعَ في جَسَدِهِ ثم قرأ :  {وَمَنْ يُشْرِكْ بِاللَّهِ فَكَأَنَّمَا خَرَّ مِنَ السَّمَاءِ فَتَخْطَفُهُ الطَّيْرُ أَوْ تَهْوِي بِهِ الرِّيحُ فِي مَكَانٍ سَحِيقٍ}  فتُعادُ رُوحُهُ في جَسَدِهِ ، قال : فإنه لَيَسْمَعُ خَفْقَ نِعالِ أصحابِهِ إذا وَلَّوْا عنه . ويَأْتِيهِ مَلَكانِ شَدِيدَا الانتهارِ ، فَيَنْتَهِرَانِهِ ، ويُجْلِسَانِهِ ، فيَقُولانِ له : مَن ربُّكَ ؟ فيقولُ : هاه هاه لا أَدْرِي ، فيقولانِ له : مادِينُكَ ؟ فيقولُ : ها هاه لا أَدْرِي ، فيقولانِ : فما تَقُولُ في هذا الرجلِ الذي بُعِثَ فيكم ؟ فلا يَهْتَدِي لاسْمِهِ ، فيُقالُ : مُحَمَّدٌ ! فيقولُ : هاه هاه لا أَدْرِي سَمِعْتُ الناسَ يقولونَ ذاك ! قال : فيُقالُ : لا دَرَيْتَ ، ولا تَلَوْتَ ، فيُنادِي مُنَادٍ من السماءِ أن : كَذَبَ ، فأَفْرِشُوا له من النارِ ، وافْتَحُوا له بابًا إلى النارِ ، فيَأْتِيهِ من حَرِّها وسَمُومِها ، ويُضَيَّقُ عليه قَبْرُهُ حتى تَخْتَلِفَ فيه أضلاعُه ، ويَأْتِيهِ وفي روايةٍ : ويُمَثَّلُ له رجلٌ قبيحُ الوجهِ ، قبيحُ الثيابِ ، مُنْتِنُ الرِّيحِ ، فيقولُ : أَبْشِرْ بالذي يَسُوؤُكَ ، هذا يومُكَ الذي كنتَ تُوعَدُ ، فيقولُ : وأنت فَبَشَّرَكَ اللهُ بالشرِّ مَن أنت ؟ فوجهُك الوجهُ يَجِيءُ بالشرِّ ! فيقولُ : أنا عملُكَ الخبيثُ ، فواللهِ ما عَلِمْتُ إلا كنتُ بطيئًا عن طاعةِ اللهِ ، سريعًا إلى معصيةِ اللهِ ، فجزاك الله شرًّا ، ثم يُقَيَّضُ له أَعْمَى أَصَمُّ أَبْكَمُ في يَدِهِ مِرْزَبَّةٌ ! لو ضُرِبَ بها جبلٌ كان ترابًا ، فيَضْرِبُهُ ضَرْبَةً حتى يَصِيرَ بها ترابًا ، ثم يُعِيدُهُ اللهُ كما كان ، فيَضْرِبُهُ ضَرْبَةً أُخْرَى ، فيَصِيحُ صَيْحَةً يَسْمَعُهُ كلُّ شيءٍ إلا الثَّقَلَيْنِ ، ثم يُفْتَحُ له بابٌ من النارِ ، ويُمَهَّدُ من فُرُشِ النارِ ، فيقولُ : رَبِّ لا تُقِمِ الساعةَ ."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"القسم الأول منه إلى قوله: وكأن على رؤوسنا الطير صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (4753)، وأحمد (18558) باختلاف يسير، والنسائي (2001)، وابن ماجه (1549) مختصراً","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"pUmebMAe","merged":7,"otherRefs":["المستدرك على الصحيحين 108 (صحيح)","التذكرة للقرطبي 119 (صحيح)","الروح 1/269 (صحيح)","مسند عمر 2/498 (صحيح)","مسند عمر 2/508 (صحيح)","مسند عمر 2/491 (صحيح)"]},{"id":"س-04624","fp":"81224f8f90b7","stateId":653,"easy":"إذا قلت في القبر «لا أدري، سمعت الناس يقولون» ← يُفرش لك من النار ويُضيّق عليك قبرك","cause":"لا أَدْرِي سَمِعْتُ الناسَ يقولونَ ذاك","result":"فيُنادِي مُنَادٍ من السماءِ أن : كَذَبَ ، فأَفْرِشُوا له من النارِ ، وافْتَحُوا له بابًا إلى النارِ ، فيَأْتِيهِ من حَرِّها وسَمُومِها ، ويُضَيَّقُ عليه قَبْرُهُ حتى تَخْتَلِفَ فيه أضلاعُه","explicit":true,"star":true,"ref":"أحكام الجنائز 198","srcLabel":"أبو داود","text":["خَرَجْنا مع النبيِّ صلَّى اللهُ عليه وسلَّم في جَنازةِ رجلٍ من الأنصارِ ، فانْتَهَيْنا إلى القبرِ ولَمَّا يُلْحَدْ ، فجلس رسولُ اللهِ صلَّى اللهُ عليه وسلم مُسْتَقْبِلَ القِبْلَةِ ، وجَلَسْنَا حَوْلَهُ ، وكأنَّ على رُؤُوسِنَا الطَّيْرَ ، وفي يَدِهِ عودٌ يَنْكُتُ في الأرضِ ، فجعل يَنْظُرُ إلى السماءِ ، ويَنْظُرُ إلى الأرضِ ، وجعل يرفعُ بَصَرَهُ ويَخْفِضُهُ ، ثلاثًا ، فقال : اسْتَعِيذُوا باللهِ من عذابِ القَبْرِ ، مَرَّتَيْنِ ، أو ثلاثًا ، ثم قال : اللهم إني أعوذُ بك من عذابِ القبرِ ثلاثًا ، ثم قال: إنَّ العبدَ المؤمنَ إذا كان في انقِطاعٍ من الدنيا ، وإقبالٍ من الآخرةِ ، نَزَلَ إليه ملائكةٌ من السماءِ ، بِيضُ الوُجُوهِ ، كأنَّ وجوهَهُمُ الشمسُ ، معهم كَفَنٌ من أكفانِ الجنةِ ، وحَنُوطٌ من حَنُوطِ الجنةِ ، حتى يَجْلِسُوا منه مَدَّ البَصَرِ ، ثم يَجِىءُ مَلَكُ الموتِ عليه السلامُ حتى يَجْلِسَ عندَ رأسِهِ فيقولُ : أَيَّتُها النَّفْسُ الطيبةُ وفي رواية : المطمئنةُ ، اخْرُجِي إلى مغفرةٍ من اللهِ ورِضْوانٍ ، قال : فتَخْرُجُ تَسِيلُ كما تَسِيلُ القَطْرَةُ من فِي السِّقَاءِ ، فيأخُذُها ، وفي روايةٍ : حتى إذا خَرَجَتْ رُوحُه صلَّى عليه كُلُّ مَلَكٍ بينَ السماءِ والأرضِ ، وكُلُّ مَلَكٍ في السماءِ ، وفُتِحَتْ له أبوابُ السماءِ ، ليس من أهلِ بابٍ إلا وهم يَدْعُونَ اللهَ أن يُعْرَجَ برُوحِهِ من قِبَلِهِمْ ، فإذا أخذها لم يَدَعُوها في يَدِهِ طَرْفَةَ عَيْنٍ حتى يأخذوها فيَجْعَلُوها في ذلك الكَفَنِ ، وفي ذلك الحَنُوطِ ، فذلك قولُه تعالى :  تَوَفَّتْهُ رُسُلُنَا وَهُمْ لَا يُفَرِّطُونَ  ، ويخرجُ منها كأَطْيَبِ نَفْحَةِ مِسْكٍ وُجِدَتْ على وجهِ الأرضِ ، قال : فيَصْعَدُونَ بها فلا يَمُرُّونَ – يعني – بها على مَلَأٍ من الملائكةِ إلا قالوا : ما هذا الرُّوحُ الطَّيِّبُ ؟ فيقولونَ : فلانُ ابنُ فلانٍ – بأَحْسَنِ أسمائِهِ التي كانوا يُسَمُّونَهُ بها في الدنيا ، حتى يَنْتَهُوا بها إلى السماءِ الدنيا ، فيَسْتَفْتِحُونَ له ، فيُفْتَحُ لهم ، فيُشَيِّعُهُ من كلِّ سماءٍ مُقَرَّبُوها ، إلى السماءِ التي تَلِيها ، حتى يُنْتَهَي به إلى السماءِ السابعةِ ، فيقولُ اللهُ عَزَّ وجَلَّ : اكْتُبُوا كتابَ عَبْدِي في عِلِّيِّينَ  وَمَا أَدْرَاكَ مَا عِلِّيُّونَ . كِتَابٌ مَرْقُومٌ يَشْهَدُهُ الْمُقَرَّبُونَ  فيُكْتَبُ كتابُه في عِلِّيِّينَ ، ثم يُقَالُ : أَعِيدُوهُ إلى الأرضِ ، فإني وَعَدْتُهُم أني منها خَلَقْتُهُم ، وفيها أُعِيدُهُم ومنها أُخْرِجُهُم تارةً أُخْرَى ، قال : فيُرَدُّ إلى الأرضِ ، و تُعَادُ رُوحُهُ في جَسَدِهِ ، قال : فإنه يَسْمَعُ خَفْقَ نِعالِ أصحابِه إذا وَلَّوْا عنه مُدْبِرِينَ ، فيَأْتِيهِ مَلَكانِ شَدِيدَا الانتهارِ فيَنْتَهِرَانِهِ ، ويُجْلِسَانِهِ فيَقُولانِ له : مَن ربُّكَ ؟ فيقولُ : رَبِّيَ اللهُ ، فيقولانِ له : ما دِينُكَ ؟ فيقولُ : دِينِيَ الإسلامُ ، فيقولانِ له : ما هذا الرجلُ الذي بُعِثَ فيكم ؟ فيقولُ : هو رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ، فيقولانِ له : وما [علمُكَ] ؟ فيقولُ : قرأتُ كتابَ اللهِ ، فآمَنْتُ به ، وصَدَّقْتُ ، فيَنْتَهِرُهُ فيقولُ : مَن رَبُّكَ ؟ ما دِينُكَ ؟ مَن نبيُّكَ ؟ وهي آخِرُ فتنةٍ تُعْرَضُ على المؤمنِ ، فذلك حينَ يقولُ اللهُ عَزَّ وجَلَّ :  {يُثَبِّتُ اللَّهُ الَّذِينَ آمَنُوا بِالْقَوْلِ الثَّابِتِ فِي الْحَيَاةِ الدُّنْيَا} ، فيقولُ : رَبِّيَ اللهُ ، ودِينِيَ الإسلامُ ، ونَبِيِّي مُحَمَّدٌ صلَّى اللهُ عليه وسلَّم ، فيُنَادِي مُنَادٍ في السماءِ : أن صَدَقَ عَبْدِي ، فأَفْرِشُوهُ من الجنةِ ، وأَلْبِسُوهُ من الجنةِ ، وافْتَحُوا له بابًا إلى الجنةِ ، قال : فيَأْتِيهِ من رَوحِها وطِيبِها ، ويُفْسَحُ له في قبرِه مَدَّ بَصَرِهِ ، قال : ويَأْتِيهِ- وفي روايةٍ : يُمَثَّلُ له- رجلٌ حَسَنُ الوجهِ ، حَسَنُ الثيابِ ، طَيِّبُ الرِّيحِ ، فيقولُ : أَبْشِرْ بالذي يَسُرُّكَ ، أَبْشِرِ برِضْوانٍ من اللهِ ، وجَنَّاتٍ فيها نعيمٌ مُقِيمٌ ، هذا يومُكَ الذي كنتَ تُوعَدُ ، فيقولُ له : وأنت فبَشَّرَكَ اللهُ بخيرٍ مَن أنت ؟ فوَجْهُكَ الوجهُ يَجِئُ بالخيرِ ، فيقولُ : أنا عَمَلُكَ الصالِحُ فواللهِ ما عَلِمْتُكَ إلا كنتَ سريعًا في طاعةِ اللهِ ، بطيئًا في معصيةِ اللهِ ، فجزاك اللهُ خيرًا ، ثم يُفْتَحُ له بابٌ من الجنةِ ، وبابٌ من النارِ ، فيُقالُ : هذا مَنْزِلُكَ لو عَصَيْتَ اللهَ ، أَبْدَلَكَ اللهُ به هذا ، فإذا رأى ما في الجنةِ قال : رَبِّ عَجِّلْ قيامَ الساعةِ ، كَيْما أَرْجِعَ إلى أهلي ومالي ، فيُقالُ له : اسْكُنْ ، قال : وإنَّ العبدَ الكافرَ- وفي روايةٍ : الفاجرَ- إذا كان في انقطاعٍ من الدنيا ، وإقبالٍ من الآخرةِ ، نَزَل إليه من السماءِ ملائكةٌ غِلَاظٌ شِدَادٌ ، سُودُ الوجوهِ ، معَهُمُ المُسُوحُ من النارِ ، فيَجْلِسُونَ منه مَدَّ البَصَرِ ، ثم يَجِيءُ مَلَكُ الموتِ حتى يَجْلِسَ عند رأسِهِ ، فيقولُ : أَيَّتُهَا النَّفْسُ الخبيثةُ اخْرُجِي إلى سَخَطٍ من اللهِ وغَضَبٍ ، قال : فتفَرَّقُ في جَسَدِهِ فيَنْتَزِعُها كما يُنْتَزَعُ السَّفُّودُ الكثيرُ الشُّعبِ من الصُّوفِ المَبْلُولِ ، فتَقْطَعُ معها العُرُوقَ والعَصَبَ ، فيَلْعَنُهُ كلُّ مَلَكٍ بينَ السماءِ والأرضِ ، وكلُّ مَلَكِ في السماءِ ، وتُغْلَقُ أبوابُ السماءِ ، ليس من أهلِ بابٍ إلا وهم يَدْعُونَ اللهَ أَلَّا تَعْرُجَ رُوحُهُ من قِبَلِهِمْ ، فيَأْخُذُها ، فإذا أخذها ، لم يَدَعُوها في يَدِهِ طَرْفَةَ عينٍ حتى يَجْعَلُوها في تِلْكِ المُسُوحِ ، ويخرجُ منها كأَنْتَنِ رِيحِ جِيفَةٍ وُجِدَتْ على وجهِ الأرضِ ، فيَصْعَدُونَ بها ، فلا يَمُرُّونَ بها على مَلَأٍ من الملائكةِ إلا قالوا : ما هذا الرُّوحُ الخَبِيثُ ؟ فيقولونَ : فلانُ ابنُ فلانٍ – بأَقْبَحِ أسمائِهِ التي كان يُسَمَّى بها في الدنيا ، حتى يُنْتَهَي به إلى السماءِ الدنيا ، فيُسْتَفْتَحُ له ، فلا يُفْتَحُ له ، ثم قرأ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم  {لَا تُفَتَّحُ لَهُمْ أَبْوَابُ السَّمَاءِ وَلَا يَدْخُلُونَ الْجَنَّةَ حَتَّى يَلِجَ الْجَمَلُ فِي سَمِّ الْخِيَاطِ}  فيقولُ اللهُ عَزَّ وجَلَّ : اكْتُبُوا كتابَه في سِجِّينَ في الأرضِ السُّفْلَى ، ثم يُقالُ : أَعِيدُوا عَبْدِي إلى الأرضِ فإني وَعَدْتُهُمْ أني منها خَلَقْتُهُمْ ، وفيها أُعِيدُهُمْ ، ومنها أُخْرِجُهُمْ تارةً أُخْرَى ، فتُطْرَحُ رُوحُهُ من السماءِ طَرْحًا حتى تَقَعَ في جَسَدِهِ ثم قرأ :  {وَمَنْ يُشْرِكْ بِاللَّهِ فَكَأَنَّمَا خَرَّ مِنَ السَّمَاءِ فَتَخْطَفُهُ الطَّيْرُ أَوْ تَهْوِي بِهِ الرِّيحُ فِي مَكَانٍ سَحِيقٍ}  فتُعادُ رُوحُهُ في جَسَدِهِ ، قال : فإنه لَيَسْمَعُ خَفْقَ نِعالِ أصحابِهِ إذا وَلَّوْا عنه . ويَأْتِيهِ مَلَكانِ شَدِيدَا الانتهارِ ، فَيَنْتَهِرَانِهِ ، ويُجْلِسَانِهِ ، فيَقُولانِ له : مَن ربُّكَ ؟ فيقولُ : هاه هاه لا أَدْرِي ، فيقولانِ له : مادِينُكَ ؟ فيقولُ : ها هاه لا أَدْرِي ، فيقولانِ : فما تَقُولُ في هذا الرجلِ الذي بُعِثَ فيكم ؟ فلا يَهْتَدِي لاسْمِهِ ، فيُقالُ : مُحَمَّدٌ ! فيقولُ : هاه هاه ",["لا أَدْرِي سَمِعْتُ الناسَ يقولونَ ذاك",1]," ! قال : فيُقالُ : لا دَرَيْتَ ، ولا تَلَوْتَ ، ",["فيُنادِي مُنَادٍ من السماءِ أن : كَذَبَ ، فأَفْرِشُوا له من النارِ ، وافْتَحُوا له بابًا إلى النارِ ، فيَأْتِيهِ من حَرِّها وسَمُومِها ، ويُضَيَّقُ عليه قَبْرُهُ حتى تَخْتَلِفَ فيه أضلاعُه",2]," ، ويَأْتِيهِ وفي روايةٍ : ويُمَثَّلُ له رجلٌ قبيحُ الوجهِ ، قبيحُ الثيابِ ، مُنْتِنُ الرِّيحِ ، فيقولُ : أَبْشِرْ بالذي يَسُوؤُكَ ، هذا يومُكَ الذي كنتَ تُوعَدُ ، فيقولُ : وأنت فَبَشَّرَكَ اللهُ بالشرِّ مَن أنت ؟ فوجهُك الوجهُ يَجِيءُ بالشرِّ ! فيقولُ : أنا عملُكَ الخبيثُ ، فواللهِ ما عَلِمْتُ إلا كنتُ بطيئًا عن طاعةِ اللهِ ، سريعًا إلى معصيةِ اللهِ ، فجزاك الله شرًّا ، ثم يُقَيَّضُ له أَعْمَى أَصَمُّ أَبْكَمُ في يَدِهِ مِرْزَبَّةٌ ! لو ضُرِبَ بها جبلٌ كان ترابًا ، فيَضْرِبُهُ ضَرْبَةً حتى يَصِيرَ بها ترابًا ، ثم يُعِيدُهُ اللهُ كما كان ، فيَضْرِبُهُ ضَرْبَةً أُخْرَى ، فيَصِيحُ صَيْحَةً يَسْمَعُهُ كلُّ شيءٍ إلا الثَّقَلَيْنِ ، ثم يُفْتَحُ له بابٌ من النارِ ، ويُمَهَّدُ من فُرُشِ النارِ ، فيقولُ : رَبِّ لا تُقِمِ الساعةَ ."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"القسم الأول منه إلى قوله: وكأن على رؤوسنا الطير صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (4753)، وأحمد (18558) باختلاف يسير، والنسائي (2001)، وابن ماجه (1549) مختصراً","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"pUmebMAe","merged":8,"otherRefs":["المستدرك على الصحيحين 108 (صحيح)","التذكرة للقرطبي 119 (صحيح)","تخريج سنن أبي داود 4753 (صحيح)","الروح 1/269 (صحيح)","مسند عمر 2/498 (صحيح)","مسند عمر 2/508 (صحيح)","مسند عمر 2/491 (صحيح)"]},{"id":"ق-0364","fp":"96641e5f6c49","stateId":653,"easy":"الافتراء على الله والاستكبار عن آياته ← عذاب الهُون عند الموت","cause":"الافتراء على الله والاستكبار عن آياته","result":"عذاب الهُون عند الموت","explicit":true,"star":true,"otherNeedIds":[69],"ref":"سورة الأنعام: 93","srcLabel":"القرآن الكريم","quran":{"s":6,"from":93,"to":93,"text":"وَمَنْ أَظْلَمُ مِمَّنِ افْتَرَى عَلَى اللَّهِ كَذِبًا أَوْ قَالَ أُوحِيَ إِلَيَّ وَلَمْ يُوحَ إِلَيْهِ شَيْءٌ وَمَنْ قَالَ سَأُنْزِلُ مِثْلَ مَا أَنْزَلَ اللَّهُ وَلَوْ تَرَى إِذِ الظَّالِمُونَ فِي غَمَرَاتِ الْمَوْتِ وَالْمَلَائِكَةُ بَاسِطُو أَيْدِيهِمْ أَخْرِجُوا أَنْفُسَكُمُ الْيَوْمَ تُجْزَوْنَ عَذَابَ الْهُونِ بِمَا كُنْتُمْ تَقُولُونَ عَلَى اللَّهِ غَيْرَ الْحَقِّ وَكُنْتُمْ عَنْ آيَاتِهِ تَسْتَكْبِرُونَ (93)","hl":[[163,415,1]]}},{"id":"ق-0469","fp":"78e91cafed6a","stateId":653,"easy":"الكفر ← ضرب الملائكة الوجوه والأدبار عند الوفاة وعذاب الحريق","cause":"الكفر","result":"ضرب الملائكة الوجوه والأدبار عند الوفاة وعذاب الحريق","explicit":true,"star":true,"otherNeedIds":[69],"ref":"سورة الأنفال: 50–51","srcLabel":"القرآن الكريم","quran":{"s":8,"from":50,"to":51,"text":"وَلَوْ تَرَى إِذْ يَتَوَفَّى الَّذِينَ كَفَرُوا الْمَلَائِكَةُ يَضْرِبُونَ وُجُوهَهُمْ وَأَدْبَارَهُمْ وَذُوقُوا عَذَابَ الْحَرِيقِ (50) ذَلِكَ بِمَا قَدَّمَتْ أَيْدِيكُمْ وَأَنَّ اللَّهَ لَيْسَ بِظَلَّامٍ لِلْعَبِيدِ (51)","hl":[[0,217,1]]}},{"id":"ق-1115","fp":"8e644629fb40","stateId":653,"easy":"الكفر والطغيان (آل فرعون) ← سوء العذاب: النار غدواً وعشياً وأشد العذاب يوم القيامة","cause":"الكفر والطغيان (آل فرعون)","result":"سوء العذاب: النار غدواً وعشياً وأشد العذاب يوم القيامة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[69],"ref":"سورة غافر: 45–46","srcLabel":"القرآن الكريم","quran":{"s":40,"from":45,"to":46,"text":"فَوَقَاهُ اللَّهُ سَيِّئَاتِ مَا مَكَرُوا وَحَاقَ بِآلِ فِرْعَوْنَ سُوءُ الْعَذَابِ (45) النَّارُ يُعْرَضُونَ عَلَيْهَا غُدُوًّا وَعَشِيًّا وَيَوْمَ تَقُومُ السَّاعَةُ أَدْخِلُوا آلَ فِرْعَوْنَ أَشَدَّ الْعَذَابِ (46)","hl":[[42,212,1]]}},{"id":"ق-1294","fp":"234f8294d25d","stateId":653,"easy":"التكذيب والضلال ← نُزل من حميم وتصلية جحيم عند الموت","cause":"التكذيب والضلال","result":"نُزل من حميم وتصلية جحيم عند الموت","explicit":true,"otherNeedIds":[69],"ref":"سورة الواقعة: 92–94","srcLabel":"القرآن الكريم","quran":{"s":56,"from":92,"to":94,"text":"وَأَمَّا إِنْ كَانَ مِنَ الْمُكَذِّبِينَ الضَّالِّينَ (92) فَنُزُلٌ مِنْ حَمِيمٍ (93) وَتَصْلِيَةُ جَحِيمٍ (94)","hl":[[0,106,1]]}},{"id":"س-02767","fp":"ba7aaf46f1e6","stateId":653,"easy":"إذا مت كافراً ← تأتيك ملائكة العذاب فتقول: اخرجي ساخطة مسخوطاً عليك","cause":"وأمَّا الكافِرُ","result":"فإنَّ مَلائكةَ العَذابِ تَأتيه، فتقول: اخرُجي ساخِطةً مَسخوطًا عَلَيكِ إلى عَذابِ اللهِ، وسَخَطِه، فتَخرُج كأنتَنِ ريحِ جِيفةٍ","explicit":true,"ref":"المستدرك على الصحيحين 1322","srcLabel":"النسائي","text":["إنَّ المُؤمِنَ إذا حَضَره المَوتُ حَضَره مَلائكةُ الرَّحمِة ثمَّ ذَكَر الحَديثَ بنَحوِه [أي: بنحوِ حَديثِ: إنَّ المُؤمِنَ إذا احتُضِرَ أتَتْه مَلائكةُ الرَّحمةِ بحَريرةٍ بَيضاءَ، فَيقولون: اخرُجي راضِيةً مَرضِيَّةً عنكِ إلى رَوحِ اللهِ، ورَيحانٍ، ورَبٍّ غَيرِ غَضبانٍ، فتَخرُجُ كأطيَبِ رِيحِ مِسكٍ، حتَّى إنَّهم ليُناوِلُه بَعضُهم بَعضًا يَشَمُّونه، حتَّى يأتوا به بابَ السَّماءِ فيَقولون: ما أطيَبَ هذه الرِّيحَ! الَّتي جاءَتكُم منَ الأرضِ! فكُلَّما أتَوا سَماءً قالوا ذلكَ، حتَّى يأتوا به أرواحَ المُؤمِنين. قالَ: فلَهُمْ أفرَحُ به من أحَدِكُم بغائبِه إذا قَدِمَ عليه. قالَ: فيَسألونه ما فَعَل فُلانٌ؟ قالَ: فيَقولون: دَعوه حتَّى يَستَريحَ؛ فإنَّه كان في غَمِّ الدُّنيا، فإذا قالَ لهم: أمَا أتاكُم؟ فإنَّه قد ماتَ. قالَ: فيَقولون: ذُهِبَ به إلى أُمِّه الهاوِيةِ. قالَ: ",["وأمَّا الكافِرُ",1],"، ",["فإنَّ مَلائكةَ العَذابِ تَأتيه، فتقول: اخرُجي ساخِطةً مَسخوطًا عَلَيكِ إلى عَذابِ اللهِ، وسَخَطِه، فتَخرُج كأنتَنِ ريحِ جِيفةٍ",2],"، فيَنطَلِقون به إلى بابِ الأرضِ، فيقولون: ما أنتَنَ هذه الرِّيحَ! كُلَّما أتَوا على أرضٍ قالوا ذلكَ، حتَّى يأتوا به أرواحَ الكُفَّارِ]."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح [وله شاهد]","takhrij":"أخرجه النسائي (1833)، وابن حبان (3014)، والبزار (9542) بنحوه.","bab":"إيمان › الملائكة","dorar":"qkIidGRa","merged":5,"otherRefs":["إتحاف الخيرة المهرة 2/439 (صحيح)","تخريج صحيح ابن حبان 3013 (صحيح)","هداية الرواة 1572 (صحيح)","الترغيب والترهيب 4/283 (صحيح)"]},{"id":"س-07669","fp":"3d34727dcc19","stateId":653,"easy":"إذا كنت كافراً ← يكون موت الفجأة أخذة أسف لك","cause":"للكافرِ","result":"وأَخْذُهُ أَسَفٌ","explicit":true,"ref":"كشف الخفاء 2/383","srcLabel":"أحمد","text":["موتُ الفَجْأَةِ راحةٌ للمؤمنِ , ",["وأَخْذُهُ أَسَفٌ",2]," ",["للكافرِ",1]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (25042)، والبيهقي (6811) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (3129) بنحوه","bab":"قدر › العمل بالخواتيم","dorar":"xvSw2QPJ","merged":3,"otherRefs":["مختصر المقاصد 1109 (صحيح)","الجامع الصغير 9101 (حسن)"]},{"id":"س-04631","fp":"9ed899f6cdcf","stateId":653,"easy":"إذا مت كافراً أو منافقاً ← تُقمع في قبرك بمطراق يسمعها الخلق","cause":"وَإِنْ كَانَ كَافِرًا أَوْ منافِقًا","result":"ثُمَّ يَقْمَعُهُ مَقْمَعَةً بالمطْرَاقِ يَسْمَعُهَا خلَقُ اللهِ كلُّهم غيرُ الثقلَيْنِ","explicit":true,"ref":"مجمع الزوائد 3/50","srcLabel":"أحمد","text":["شهدتُّ معَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ جنازَةً فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يا أيُّها الناسُ إنَّ هذِهِ الأمَّةُ تُبْتَلَى في قبورِها فإِذَا الإنسانُ ُدُفِنَ فَتَفَرَّقَ عنه أصحابُهُ جاءَهُ ملَكٌ في يدِهِ مِطْرَاقٌ فَأَقْعَدَهُ قال ما تقولُ في هذا الرجلِ فإن كان مؤمِنًا قال أَشْهَدُ أن لَّا إِلَهَ إِلَّا اللهُ وأنَّ محمدًا عبدُهُ ورسولُهُ فيقولُ لَهُ صدَقْتَ ثمَّ يُفْتَحُ لَهُ بابٌ إِلى النارِ فيقولُ هذا كان مَنْزِلُكَ لَوْ كَفَرْتَ بربِّكَ فَأَمَّا إِذْ آمَنْتَ بِرَبِّكَ فَهَذَا مَنْزِلُكَ فَيُفْتَحُ لَهُ بابٌ إلى الجنَّةِ فيريدُ أنْ يَنْهَضَ إِلَيْهِ فيَقُولُ لَهُ اسكن ويُفْسَحُ لَهُ فِي قَبْرِهِ ",["وَإِنْ كَانَ كَافِرًا أَوْ منافِقًا",1]," يقولُ لَهُ مَا تقولُ في هذا الرجلِ فيقولُ لَا أَدْرِي سَمِعْتُ الناسَ يقولونَ شيئًا فيقولُ لَا دَرَيْتَ ولا تَلَيْتَ ولَا اهْتَدَيْتَ ثمَّ يُفْتَحُ لَهُ بابٌ إلى الجنةِ فيقولُ هذا مَنْزِلُكَ لو آمَنْتَ بِرَبِّكَ فَأَمَّا إِذْ كَفَرْتَ بربِّكَ فَإِنَّ اللهَ عزَّ وجلَّ أبْدَلَكَ هَذَا وَيُفْتَحُ لَهُ بابٌ إلى النارِ ",["ثُمَّ يَقْمَعُهُ مَقْمَعَةً بالمطْرَاقِ يَسْمَعُهَا خلَقُ اللهِ كلُّهم غيرُ الثقلَيْنِ",2]," فقال بعضُ القومِ يَا رسولَ اللهِ ما أحدٌ يقومُ عليه ملَكٌ في يدِهِ مِطْرَاقٌ إلا هِيلَ عِنْدَ ذلِكَ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ  يُثَبِّتُ اللهُ الَّذِينَ آمَنُوا بِالْقَوْلِ الثَّابِتِ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (11000) واللفظ له، والبزار كما في ((كشف الأستار)) للهيثمي (872)، والبيهقي في ((إثبات عذاب القبر)) (32) باختلاف يسير","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"y0Q9R9u6","merged":2,"otherRefs":["أعلام الموقعين 1/164 (صحيح)"]},{"id":"س-04629","fp":"2957b57380da","stateId":653,"easy":"إذا كنت منافقاً أو مرتاباً ← تقول في قبرك: لا أدري","cause":"وأمَّا المُنافِقُ أوِ المُرتابُ","result":"فيَقولُ: لا أدري، سَمِعتُ النَّاسَ يقولونَ: شيئًا","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح مسلم 905","srcLabel":"متفق عليه","text":["خَسَفَتِ الشَّمسُ على عَهدِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فدَخَلتُ على عائِشةَ وهي تُصَلِّي، فقُلتُ: ما شَأنُ النَّاسِ يُصَلُّونَ؟ فأشارَت برَأسِها إلى السَّماءِ، فقُلتُ: آيةٌ، قالت: نَعَم، فأطالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم القيامَ جِدًّا، حتَّى تَجَلَّاني الغَشيُ، فأخَذتُ قِربةً مِن ماءٍ إلى جَنبي، فجَعَلتُ أصُبُّ على رَأسي، أو على وجهي مِنَ الماءِ، قالت: فانصَرَفَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، وقد تَجَلَّتِ الشَّمسُ، فخَطَبَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم النَّاسَ، فحَمِدَ اللَّهَ، وأثنى عليه، ثُمَّ قال: أمَّا بَعدُ، ما مِن شيءٍ لَم أكُنْ رَأيتُه إلَّا قد رَأيتُه في مَقامي هذا، حتَّى الجَنَّةَ والنَّارَ، وإنَّه قد أوحيَ إليَّ أنَّكُم تُفتَنونَ في القُبورِ قَريبًا أو مِثلَ فِتنةِ المَسيحِ الدَّجَّالِ، لا أدري أيَّ ذلك قالت أسماءُ، فيُؤتى أحَدُكُم، فيُقالُ: ما عِلمُكَ بهذا الرَّجُلِ؟ فأمَّا المُؤمِنُ، أوِ الموقِنُ، لا أدري أيَّ ذلك قالت أسماءُ، فيَقولُ: هو مُحَمَّدٌ، هو رَسولُ اللهِ، جاءَنا بالبَيِّناتِ والْهُدى، فأجَبْنا وأطَعْنا، ثَلاثَ مِرارٍ، فيُقالُ له: نَمْ، قد كُنَّا نَعلَمُ إنَّكَ لَتُؤمِنُ به، فنَمْ صالِحًا، ",["وأمَّا المُنافِقُ أوِ المُرتابُ",1],"، لا أدري أيَّ ذلك قالت أسماءُ، ",["فيَقولُ: لا أدري، سَمِعتُ النَّاسَ يقولونَ: شيئًا،",2]," فقُلتُ. [وفي روايةٍ]: أتَيتُ عائِشةَ، فإذا النَّاسُ قيامٌ، وإذا هي تُصَلِّي، فقُلتُ: ما شَأنُ النَّاسِ؟ واقتَصَّ الحَديثَ بنَحوِ حَديثِ ابنِ نُمَيرٍ عن هِشامٍ."],"grade":"صحيح","narrator":"أسماء بنت أبي بكر","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (86)، ومسلم (905).","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"F4GuYMKv","merged":3,"otherRefs":["صحيح البخاري 1053 (صحيح)","صحيح البخاري 86 (صحيح)"]},{"id":"س-04139","fp":"f50ea4aca575","stateId":653,"easy":"إذا مت كافراً ← يضيق عليك قبرك","cause":"الكافرِ","result":"ويضيقُ على الكافرِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"similar":["س-04129","س-03000"],"ref":"الروح 1/396","srcLabel":"متفق عليه","text":["حديثُ أنسٍ أنَّ العبدَ إذا وُضِعَ في قبرِه ، وتولَّى عنه أصحابُه أنه لَيسمعُ قَرْعَ نعالِهم وفيه أنه يرى مقعدَه من الجنةِ والنارِ وأنه يُفسحُ للمؤمنِ في قبرِه سبعينَ ذراعًا ",["ويضيقُ على الكافرِ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"متواتر","takhrij":"أخرجه مسلم (2870) واللفظ له، والبخاري (1338) بنحوه، وأبو داود (3231) ببعضه","bab":"جنائز وموت › روح المؤمن بعد الموت","dorar":"9TAnpIvi"},{"id":"س-04643","fp":"6fa849178218","stateId":653,"easy":"إذا كنت منافقاً أو كافراً ← يُقال لك: لا دريت ولا تليت، وتُضرب بمطارق","cause":"وأَمَّا المُنَافِقُ والكَافِرُ","result":"لا دَرَيْتَ ولَا تَلَيْتَ، ويُضْرَبُ بمَطَارِقَ مِن حَدِيدٍ ضَرْبَةً، فَيَصِيحُ صَيْحَةً يَسْمَعُهَا مَن يَلِيهِ غيرَ الثَّقَلَيْنِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"فتاوى نور على الدرب لابن باز 4/318","srcLabel":"متفق عليه","text":["امتحانُ الميِّتِ في قبرِه [ يعني حديث: أنَّ رَسولَ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ قالَ: إنَّ العَبْدَ إذَا وُضِعَ في قَبْرِهِ وتَوَلَّى عنْه أصْحَابُهُ، وإنَّه لَيَسْمَعُ قَرْعَ نِعَالِهِمْ، أتَاهُ مَلَكَانِ فيُقْعِدَانِهِ، فَيَقُولَانِ: ما كُنْتَ تَقُولُ في هذا الرَّجُلِ لِمُحَمَّدٍ صَلَّى اللهُ عليه وسلَّمَ، فأمَّا المُؤْمِنُ، فيَقولُ: أشْهَدُ أنَّه عبدُ اللَّهِ ورَسولُهُ، فيُقَالُ له: انْظُرْ إلى مَقْعَدِكَ مِنَ النَّارِ قدْ أبْدَلَكَ اللَّهُ به مَقْعَدًا مِنَ الجَنَّةِ، فَيَرَاهُما جَمِيعًا - قالَ قَتَادَةُ: وذُكِرَ لَنَا: أنَّه يُفْسَحُ له في قَبْرِهِ، ثُمَّ رَجَعَ إلى حَديثِ أنَسٍ - قالَ: ",["وأَمَّا المُنَافِقُ والكَافِرُ",1]," فيُقَالُ له: ما كُنْتَ تَقُولُ في هذا الرَّجُلِ؟ فيَقولُ: لا أدْرِي كُنْتُ أقُولُ ما يقولُ النَّاسُ، فيُقَالُ: ",["لا دَرَيْتَ ولَا تَلَيْتَ، ويُضْرَبُ بمَطَارِقَ مِن حَدِيدٍ ضَرْبَةً، فَيَصِيحُ صَيْحَةً يَسْمَعُهَا مَن يَلِيهِ غيرَ الثَّقَلَيْنِ",2]," .]"],"grade":"صحيح","narrator":"[أنس بن مالك]","muhaddith":"ثابت","takhrij":"أخرجه البخاري (1338) بلفظه، ومسلم (2870) بلفظ مقارب، وأبو داود (3231) مختصرا.","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"hWzlfkTD"},{"id":"س-04655","fp":"7a490137f8ce","stateId":653,"easy":"إذا كنت كافراً ← تُضرب في قبرك بمطراق فتصيح صيحة يسمعها الخلق","cause":"وإنَّ الكافِرَ إذا وُضِعَ في قَبرِه","result":"فيَضرِبُه بمِطْراقٍ من حَديدٍ بيْنَ أُذُنَيهِ، فيَصيحُ صَيحةً يسمَعُها الخَلْقُ غيرَ الثَّقَلينِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"similar":["س-04133"],"ref":"تخريج سنن أبي داود 4751","srcLabel":"البخاري","text":["إنَّ نبيَّ اللهِ صلَّى اللهُ عليه وسلَّمَ دخَلَ نَخلًا لبني النَّجَّارِ، فسَمِعَ صَوتًا ففَزِعَ، فقال: مَن أصحابُ هذه القُبورِ؟ قالوا: يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، ناسٌ ماتوا في الجاهليَّةِ، فقال: تعوَّذوا باللهِ من عذابِ النَّارِ، ومن فِتنةِ الدَّجَّالِ، قالوا: ومِمَّ ذاك يا رسولَ اللهِ؟ قال: إنَّ المُؤمِنَ إذا وُضِعَ في قبرِه أتاه مَلَكٌ، فيقولُ له: ما كُنتَ تَعبُدُ؟ فإنِ اللهُ هَداهُ، قال: كُنتُ أعبُدُ اللهَ، فيُقالُ له: ما كُنتَ تقولُ في هذا الرَّجُلِ؟ فيقولُ: هو عبدُ اللهِ ورسولُه، فما يُسأَلُ عن شَيءٍ غيرِها، فيُنطلَقُ به إلى بيتٍ كان له في النَّارِ، فيُقالُ له: هذا بيتُك كان في النَّارِ، ولكنَّ اللهَ عَصَمَك ورَحِمَك، فأبْدَلَك به بيتًا في الجَنَّةِ، فيقولُ: دَعُوني حتى أذهَبَ فأُبشِّرَ أهلي، فيُقالُ له: اسكُنْ.\n",["وإنَّ الكافِرَ إذا وُضِعَ في قَبرِه",1]," أتاه مَلَكٌ فيَنتهِرُه، فيقولُ له: ما كُنتَ تعبُدُ؟ فيقولُ: لا أدْري، فيُقالُ له: لا دَرَيتَ ولا تَلَيتَ، فيُقالُ له: فما كُنتَ تقولُ في هذا الرَّجُلِ؟ فيقولُ: كُنتُ أقولُ ما يقولُ النَّاسُ، ",["فيَضرِبُه بمِطْراقٍ من حَديدٍ بيْنَ أُذُنَيهِ، فيَصيحُ صَيحةً يسمَعُها الخَلْقُ غيرَ الثَّقَلينِ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4751)، وأحمد (13447) واللفظ لهما، والبخاري (1338) بنحوه.","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"phq1Lx7s"},{"id":"س-08102","fp":"1fd5539febe8","stateId":653,"easy":"إذا خرجت روحك كافراً ← يقول أهل السماء: روح خبيثة","cause":"وإنَّ الكافِرَ إذا خَرَجَت روحُه","result":"ويقولُ أهلُ السَّماءِ: رُوحٌ خَبيثةٌ جاءَت مِن قِبَلِ الأرضِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح مسلم 2872","srcLabel":"متفق عليه","text":["إذا خَرَجَت روحُ المُؤمِنِ تَلَقَّاها مَلَكانِ يُصعِدانِها. قال حَمَّادٌ: فذَكَرَ مِن طيبِ ريحِها وذَكَرَ المِسكَ. قال: ويقولُ أهلُ السَّماءِ: رُوحٌ طَيِّبةٌ جاءَت مِن قِبَلِ الأرضِ، صَلَّى اللهُ عليكِ وعلى جَسَدٍ كُنتِ تَعمُرينَه، فيُنطَلَقُ به إلى رَبِّه عزَّ وجلَّ، ثُمَّ يقولُ: انطَلِقوا به إلى آخِرِ الأجَلِ. قال: ",["وإنَّ الكافِرَ إذا خَرَجَت روحُه",1],"، قال حَمَّادٌ: وذَكَرَ مِن نَتْنِها، وذَكَرَ لَعنًا، ",["ويقولُ أهلُ السَّماءِ: رُوحٌ خَبيثةٌ جاءَت مِن قِبَلِ الأرضِ",2],". قال: فيُقالُ: انطَلِقوا به إلى آخِرِ الأجَلِ. قال أبو هُرَيرةَ: فرَدَّ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم رَيطةً كانَت عليه على أنفِه هَكَذا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"ملائكة › أعمال الملائكة","dorar":"Hl3kxQUN"},{"id":"س-04650","fp":"0a2bb1476a04","stateId":653,"easy":"إذا كنت منافقاً ← يُريك الله مقعدك من الجنة وقد أُبدلت مقعدك من النار","cause":"وأمَّا المُنافِقُ","result":"هذا مَقعَدُكَ الذي كان لكَ مِن الجَنَّةِ، قد أُبدِلْتَ مكانَه مَقعَدَكَ مِن النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج المسند لشعيب 14722","srcLabel":"مسلم","text":["عن أبي الزُّبَيرِ، أنَّه سَألَ جابِرَ بنَ عَبدِ اللهِ، عن فتَّاني القَبرِ، فقال: سَمِعتُ النَّبيَّ صلَّى اللهُ عليه وسَلَّم يقولُ: إنَّ هذه الأُمَّةَ تُبتَلى في قُبورِها، فإذا أُدخِلَ المُؤمِنُ قَبرَه، وتَولَّى عنه أصحابُه، جاء مَلَكٌ شَديدُ الانْتِهارِ، فيقولُ له: ما كنتَ تقولُ في هذا الرَّجُلِ؟ فيقولُ المؤمنُ: أقولُ إنَّه رسولُ اللهِ وعَبْدُه، فيقولُ له المَلَكُ: انْظُرْ إلى مَقْعَدِكَ الذي كان لكَ في النَّارِ، قد أَنجاكَ اللهُ منه، وأَبدَلَكَ بمَقعَدِكَ الذي تَرى مِن النَّارِ، مَقعَدَكَ الذي تَرى مِن الجَنَّةِ، فيَراهُما كِلاهُما، فيقولُ المُؤمِنُ: دَعُوني أُبَشِّرْ أهْلي، فيُقالُ له: اسْكُنْ، ",["وأمَّا المُنافِقُ",1]," فيَقعُدُ إذا تولَّى عنه أهْلُه، فيُقالُ له: ما كنتَ تقولُ في هذا الرَّجُلِ؟ فيقولُ: لا أَدْري، أقولُ ما يقولُ النَّاسُ، فيُقالُ له: لا دَرَيْتَ، ",["هذا مَقعَدُكَ الذي كان لكَ مِن الجَنَّةِ، قد أُبدِلْتَ مكانَه مَقعَدَكَ مِن النَّارِ",2],"، قال جابِرٌ: فسَمِعتُ النَّبيَّ صلَّى اللهُ عليه وسَلَّم يقولُ: يُبعَثُ كلُّ عَبدٍ في القَبرِ على ما ماتَ، المُؤمِنُ على إيمانِه، والمُنافِقُ على نِفاقِه."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أحمد (14722) واللفظ له، وابن أبي عاصم في ((السنة)) (866)، وأبو يعلى (2316) بنحوه. وأخرجه مسلم (2878) مختصراً بلفظ: ((يبعث كل عبد على ما مات عليه))","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"MQSkCLw2"},{"id":"س-04126","fp":"9f829e8e1f1c","stateId":653,"easy":"إذا مت كافراً ← تكون نسمتك في سجين","cause":"ونسمةُ الكافرِ","result":"في سِجِّينٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"شرح الصدور 307","srcLabel":"البخاري","text":["لما حضرت كعبًا الوفاةُ ، أتته أمُّ بشرٍ بنتِ البراءِ فقالَتْ : يا أبا عبدِ الرحمنِ ، إن لقيتَ فلانًا فأقرِئْهُ مني السلامَ ، فقال لها : يغفرُ اللهُ لكِ يا أمَّ بشرٍ ، نحنُ أشغلُ من ذلك ، فقالَتْ : أما سمعتَ رسولَ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ يقول : إنَّ نسمةَ المؤمنِ تسرحُ في الجنةِ حيثُ شاءت ، ",["ونسمةُ الكافرِ",1]," ",["في سِجِّينٍ",2]," ، قال : قلتُ : بلى هو ذاك"],"grade":"حسن","narrator":"كعب بن مالك وأم بشر بنت البراء","muhaddith":"إسناده حسن","takhrij":"أخرجه عبد بن حميد (1569)، والبيهقي في ((البعث والنشور)) (205) كلاهما بلفظه، والبخاري في ((التاريخ الكبير)) معلقا (5/ 306) بنحوه.","bab":"جنائز وموت › روح الكافر بعد الموت","dorar":"qiqu6RLU"},{"id":"س-04132","fp":"3232624e1273","stateId":653,"easy":"إذا كنت سيئاً ← تقول على سريرك: يا ويلي أين تذهبون بي","cause":"وإذا وُضِعَ الرَّجُلُ السُّوءُ على سَريرِه","result":"قال: يا وَيْلَه أين تَذهَبون بي","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج المسند لشعيب 7914","srcLabel":"النسائي","text":["أنَّ أبا هُريرةَ، قال: حين حضَرَه المَوتُ: لا تَضرِبوا عليَّ فُسْطاطًا، ولا تَتْبَعوني بِمِجمَرٍ، وأَسرِعوا بي؛ فإنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: إذا وُضِعَ الرَّجُلُ الصَّالحُ على سَريرِه قال: قَدِّموني قَدِّموني، ",["وإذا وُضِعَ الرَّجُلُ السُّوءُ على سَريرِه",1]," ",["قال: يا وَيْلَه أين تَذهَبون بي",2],"؟"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي (1908) بنحوه، وأحمد (7914) واللفظ له","bab":"جنائز وموت › روح الكافر بعد الموت","dorar":"AawKsEuF","merged":3,"otherRefs":["تخريج المسند لشعيب 10493 (صحيح)","صحيح البخاري 1380 (صحيح)"]},{"id":"س-04129","fp":"a9c093640f9d","stateId":653,"easy":"إذا مت كافراً ← يُسلّط عليك في قبرك تسعة وتسعون تنيناً","cause":"عذابُ الكافرِ في قبرِه","result":"إنَّه يُسلَّطُ عليه تسعةٌ وتسعونَ تِنِّينًا أتدرون ما التِّنِّينُ سبعونَ حيَّةً لكلِّ حيَّةٍ سبعُ رؤوسٍ يلسَعونَه ويخدِشونَه إلى يومِ القيامةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-04139","otherNeedIds":[22],"ref":"صحيح ابن حبان 3122","text":["إنَّ المؤمنَ في قبرِه لفي روضةٍ خضراءَ ويُرحَبُ له قبرُه سبعونَ ذراعًا ويُنوَّرُ له كالقمرِ ليلةَ البدرِ أتدرون فيما أنزِلَت هذه الآيةُ: {فَإِنَّ لَهُ مَعِيشَةً ضَنْكًا وَنَحْشُرُهُ يَوْمَ الْقِيَامَةِ أَعْمَى} [طه: 124] أتدرون ما المعيشةُ الضَّنكةُ ؟ ) قالوا: اللهُ ورسولُه أعلَمُ قال: ( ",["عذابُ الكافرِ في قبرِه",1]," والَّذي نفسي بيدِه ",["إنَّه يُسلَّطُ عليه تسعةٌ وتسعونَ تِنِّينًا أتدرون ما التِّنِّينُ سبعونَ حيَّةً لكلِّ حيَّةٍ سبعُ رؤوسٍ يلسَعونَه ويخدِشونَه إلى يومِ القيامةِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو يعلى (6644)، والبيهقي في ((إثبات عذاب القبر)) (68) باختلاف يسير","bab":"جنائز وموت › روح الكافر بعد الموت","dorar":"lySASLC5","merged":2,"otherRefs":["صحيح ابن حبان 3121 (صحيح)"]},{"id":"س-04127","fp":"27bfe4ff078f","stateId":653,"easy":"إذا لم تؤمن بعذاب القبر ← تُعذّب فيه","cause":"فَمن لَم يُؤمِن بهِ","result":"عُذِّبَ فيهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الجامع الصغير 5394","srcLabel":"أحمد","text":["عَذابُ القبرِ حقٌّ ، ",["فَمن لَم يُؤمِن بهِ",1]," ",["عُذِّبَ فيهِ",2],"."],"grade":"صحيح","narrator":"زيد بن أرقم","muhaddith":"صحيح","takhrij":"أخرجه أحمد بن منيع كما في ((المطالب العالية)) (4536) واللفظ له.","bab":"جنائز وموت › روح الكافر بعد الموت","dorar":"QHM3V1XB"},{"id":"س-04133","fp":"b56b38ef3fbd","stateId":653,"easy":"إذا مت كافراً ← تُضرب بمطارق من حديد في قبرك","cause":"يعني الكافرَ","result":"يضربُ بمطارقٍ من حديدٍ في قبرِه فيصيحُ صيحةً","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-04655","ref":"فتح الباري لابن حجر 3/283","text":["أن البهائمَ تسمعُه . [ ",["يعني الكافرَ",1]," عندما ",["يضربُ بمطارقٍ من حديدٍ في قبرِه فيصيحُ صيحةً",2]," ]"],"grade":"صحيح","muhaddith":"ثابت","bab":"جنائز وموت › روح الكافر بعد الموت","dorar":"XdzCkkNw"},{"id":"س-04143","fp":"5bb31c70c880","stateId":653,"easy":"إذا كنت فاجراً أو كافراً ← يأتيك الملك في قبرك ليس بينك وبينه ما يرده","cause":"وإن كان فاجرًا، أو كافرًا","result":"جاءَ الملَكُ ليس بينَه وبينه شيءٌ يرُدُّه","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج الإحياء للعراقي 3/271","srcLabel":"أحمد","text":["إذا دخَلَ الإنسانُ قبرَهُ، فإنْ كان مؤمِنًا احْتَفَّ به عملُهُ: الصَّلاةُ والصِّيامُ [قال: فيَأتيهِ الملَكُ من نحوِ الصَّلاةِ، فترُدُّه، ومن نحوِ الصِّيامِ، فيرُدُّه. قال: فيُناديهِ: اجلِسْ. قال: فيَجلِسُ، فيقولُ له: ماذا تقولُ في هذا الرَّجُلِ؟ يعنِي النَّبيَّ صلَّى اللهُ عليهِ وسلَّمَ، قال: مَن؟ قال: محمَّدٌ. قال: أنا أشهَدُ أنَّه رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ قال: يقولُ: وما يُدريكَ؟ أدرَكْتَه؟ قال: أشهَدُ أنَّه رسولُ اللهِ. قال: يقولُ: على ذلك عِشْتَ، وعليه مِتَّ، وعليه تُبعَثُ. قال: ",["وإن كان فاجرًا، أو كافرًا",1]," قال: ",["جاءَ الملَكُ ليس بينَه وبينه شيءٌ يرُدُّه",2],". قال: فأجلَسَه. قال: يقولُ: اجلِسْ، ماذا تقولُ في هذا الرَّجُلِ؟ قال: أيُّ رجُلٍ؟ قال: محمَّدٌ. قال: يقولُ: واللهِ ما أدري، سمعتُ النَّاسَ يقولونَ شيئًا، فقلتُه. قال: فيقولُ له المَلَكُ: على ذلك عِشْتَ، وعليه مِتَّ، وعليه تُبعَثُ. قال: وتُسلَّطُ عليه دابَّةٌ في قَبرِه، معها سَوطٌ، ثَمَرَتُه جَمْرةٌ مِثلُ غَرْبِ البَعيرِ، تَضربِهُ ما شاء اللهُ، صمَّاءُ لا تسمَعُ صوتَهُ فترحَمَه.]"],"grade":"صحيح","narrator":"أسماء بنت أبي بكر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (27021)، والطبراني (24/105) (281) باختلاف يسير.","bab":"جنائز وموت › روح المؤمن بعد الموت","dorar":"B34FpIBe"},{"id":"س-04144","fp":"e1434924f148","stateId":653,"easy":"إذا قلت في قبرك «لا أدري، سمعت الناس يقولون» ← تُسلّط عليك دابة معها سوط","cause":"واللهِ ما أدري، سمعتُ النَّاسَ يقولونَ شيئًا، فقلتُه","result":"وتُسلَّطُ عليه دابَّةٌ في قَبرِه، معها سَوطٌ، ثَمَرَتُه جَمْرةٌ مِثلُ غَرْبِ البَعيرِ، تَضربِهُ ما شاء اللهُ، صمَّاءُ لا تسمَعُ صوتَهُ فترحَمَه","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج الإحياء للعراقي 3/271","srcLabel":"أحمد","text":["إذا دخَلَ الإنسانُ قبرَهُ، فإنْ كان مؤمِنًا احْتَفَّ به عملُهُ: الصَّلاةُ والصِّيامُ [قال: فيَأتيهِ الملَكُ من نحوِ الصَّلاةِ، فترُدُّه، ومن نحوِ الصِّيامِ، فيرُدُّه. قال: فيُناديهِ: اجلِسْ. قال: فيَجلِسُ، فيقولُ له: ماذا تقولُ في هذا الرَّجُلِ؟ يعنِي النَّبيَّ صلَّى اللهُ عليهِ وسلَّمَ، قال: مَن؟ قال: محمَّدٌ. قال: أنا أشهَدُ أنَّه رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ قال: يقولُ: وما يُدريكَ؟ أدرَكْتَه؟ قال: أشهَدُ أنَّه رسولُ اللهِ. قال: يقولُ: على ذلك عِشْتَ، وعليه مِتَّ، وعليه تُبعَثُ. قال: وإن كان فاجرًا، أو كافرًا قال: جاءَ الملَكُ ليس بينَه وبينه شيءٌ يرُدُّه. قال: فأجلَسَه. قال: يقولُ: اجلِسْ، ماذا تقولُ في هذا الرَّجُلِ؟ قال: أيُّ رجُلٍ؟ قال: محمَّدٌ. قال: يقولُ: ",["واللهِ ما أدري، سمعتُ النَّاسَ يقولونَ شيئًا، فقلتُه",1],". قال: فيقولُ له المَلَكُ: على ذلك عِشْتَ، وعليه مِتَّ، وعليه تُبعَثُ. قال: ",["وتُسلَّطُ عليه دابَّةٌ في قَبرِه، معها سَوطٌ، ثَمَرَتُه جَمْرةٌ مِثلُ غَرْبِ البَعيرِ، تَضربِهُ ما شاء اللهُ، صمَّاءُ لا تسمَعُ صوتَهُ فترحَمَه",2],".]"],"grade":"صحيح","narrator":"أسماء بنت أبي بكر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (27021)، والطبراني (24/105) (281) باختلاف يسير.","bab":"جنائز وموت › روح المؤمن بعد الموت","dorar":"B34FpIBe"},{"id":"س-04659","fp":"14f233e07a97","stateId":653,"easy":"إذا كنت سيئاً ← تُجلس في قبرك فزعاً مشعوفاً","cause":"وإذا كانَ الرَّجُلُ السُّوءُ أُجلِسَ في قَبْرِه فَزِعًا مَشْعوفًا","result":"فتُفرَجُ له فُرْجةٌ قِبَلَ الجَنَّةِ، فيَنظُرُ إلى زَهْرتِها وما فيها، فيُقالُ له: انْظُرْ إلى ما صَرَفَ اللهُ عَزَّ وجَلَّ عنك، ثُمَّ يُفرَجُ له فُرْجةٌ قِبَلَ النَّارِ، فيَنظُرُ إليها يَحطِمُ بعضُها بَعضًا، ويُقالُ له: هذا مَقعَدُك مِنها، كُنْتَ على الشَّكِّ، وعليه مِتَّ، وعليه تُبعَثُ إن شاءَ اللهُ، ثُمَّ يُعذَّبُ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"الصحيح المسند 2/342","srcLabel":"أحمد","text":["عن عائِشةَ قالَتْ: جاءَتْ يَهوديَّةٌ فاسْتَطْعَمَتْ على بابي، فقالَتْ: أَطعِموني، أَعاذَكم اللهُ مِن فِتْنةِ الدَّجَّالِ ومِن فِتْنةِ عَذابِ القَبْرِ، قالَتْ: فلم أَزَلْ أَحبِسُها حتَّى جاءَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، فقُلْتُ: يا رَسولَ اللهِ، ما تَقولُ هذه اليَهوديَّةُ؟ قالَ: «وما تَقولُ؟»، قُلْتُ: تَقولُ: أعاذَكم اللهُ مِن فِتْنةِ الدَّجَّالِ ومِن فِتْنةِ عَذابِ القَبْرِ، قالَتْ عائِشةُ: فقامَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ فرَفَعَ يَدَيه مَدًّا يَسْتعيذُ باللهِ مِن فِتْنةِ الدَّجَّالِ ومِن فِتْنةِ عَذابِ القَبْرِ، ثُمَّ قالَ: «أمَّا فِتْنةُ الدَّجَّالِ فإنَّه لم يكنْ نَبيٌّ إلَّا قد حَذَّرَ أُمَّتَه، وسأُحَذِّرُكموه تَحْذيرًا لم يُحَذِّرْه نَبيٌّ أُمَّتَه، إنَّه أَعوَرُ، واللهُ عَزَّ وجَلَّ ليس بأَعوَرَ، مَكْتوبٌ بَيْنَ عَيْنَيه: كافِرٌ، يَقرَؤُه كلُّ مُؤمِنٍ، فأمَّا فِتْنةُ القَبْرِ فبي تُفْتَنونَ، وعنِّي تُسأَلونَ، فإذا كانَ الرَّجُلُ الصَّالِحُ أُجلِسَ في قَبْرِه غَيْرَ فَزِعٍ ولا مَشْعوفٍ، ثُمَّ يُقالُ له: فيمَ كُنْتَ؟ فيَقولُ: في الإسْلامِ، فيُقالُ: ما هذا الرَّجُلُ الَّذي كانَ فيكم؟ فيَقولُ: مُحمَّدٌ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، جاءَنا بالبَيِّناتِ مِن عنْدِ اللهِ عَزَّ وجَلَّ، فصَدَّقْناه، فيُفرَجُ له فُرْجةٌ قِبَلَ النَّارِ، فيَنظُرُ إليها يَحطِمُ بعضُها بعضًا، فيُقالُ له: انْظُرْ إلى ما وَقاك اللهُ عَزَّ وجَلَّ، ثُمَّ يُفرَجُ له فُرْجةٌ إلى الجَنَّةِ، فيَنظُرُ إلى زَهْرتِها وما فيها، فيُقالُ له: هذا مَقعَدُك مِنها، ويُقالُ: على اليَقينِ كُنْتَ، وعليه مِتَّ، وعليه تُبعَثُ إن شاءَ اللهُ. ",["وإذا كانَ الرَّجُلُ السُّوءُ أُجلِسَ في قَبْرِه فَزِعًا مَشْعوفًا",1],"، فيُقالُ له: فيمَ كُنْتَ؟ فيَقولُ: لا أَدْري، فيُقالُ: ما هذا الرَّجُلُ الَّذي كانَ فيكم؟ فيَقولُ: سَمِعْتُ النَّاسَ يَقولونَ قَوْلًا فقُلْتُ كما قالوا، ",["فتُفرَجُ له فُرْجةٌ قِبَلَ الجَنَّةِ، فيَنظُرُ إلى زَهْرتِها وما فيها، فيُقالُ له: انْظُرْ إلى ما صَرَفَ اللهُ عَزَّ وجَلَّ عنك، ثُمَّ يُفرَجُ له فُرْجةٌ قِبَلَ النَّارِ، فيَنظُرُ إليها يَحطِمُ بعضُها بَعضًا، ويُقالُ له: هذا مَقعَدُك مِنها، كُنْتَ على الشَّكِّ، وعليه مِتَّ، وعليه تُبعَثُ إن شاءَ اللهُ، ثُمَّ يُعذَّبُ",2],"».\nقالَ مُحمَّدُ بنُ عَمْرٍو: فحَدَّثَني سَعيدُ بنُ يَسارٍ عن أبي هُرَيْرةَ، عن النَّبيِّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ قالَ: «إنَّ المَيِّتَ تَحضُرُه المَلائِكةُ، فإذا كانَ الرَّجُلُ الصَّالِحُ قالوا: اخْرُجي أيَّتُها النَّفْسُ الطَّيِّبةُ كانَتْ في الجَسَدِ الطَّيِّبِ، واخْرُجي حَميدةً، وأَبْشِري برَوْحٍ ورَيْحانٍ، ورَبٍّ غَيْرِ غَضْبانَ، فلا يَزالُ يُقالُ لها ذلك حتَّى تَخرُجَ، ثُمَّ يُعرَجُ بِها إلى السَّماءِ، فيُسْتَفتَحُ له، فيُقالُ: مَن هذا؟ فيُقالُ: فُلانٌ، فيُقالُ: مَرْحبًا بالنَّفْسِ الطَّيِّبةِ كانَت في الجَسَدِ الطَّيِّبِ، ادْخُلي حَميدةً، وأَبشِري، ويُقالُ: برَوْحٍ ورَيْحانٍ، ورَبٍّ غَيْرِ غَضْبانَ، فلا يَزالُ يُقالُ لها ذلك حتَّى يُنْتَهى بها إلى السَّماءِ الَّتي فيها اللهُ عَزَّ وجَلَّ، فإذا كانَ الرَّجُلُ السُّوءُ قالوا: اخْرُجي أيَّتُها النَّفْسُ الخَبيثةُ كانَت في الجَسَدِ الخَبيثِ، اخْرُجي مِنه ذَميمةً، وأَبشِري بحَميمٍ وغَسَّاقٍ، وآخَرَ مِن شَكْلِه أزْواجٍ، فما يَزالُ يُقالُ لها ذلك حتَّى تَخرُجَ، ثُمَّ يُعرَجُ بها إلى السَّماءِ، فيُسْتَفتَحُ لها، فيُقالُ: مَن هذا؟ فيُقالُ: فُلانٌ، فيُقالُ: لا مَرْحبًا بالنَّفْسِ الخَبيثةِ كانَت في الجَسَدِ الخَبيثِ، ارْجِعي ذَميمةً؛ فإنَّه لا يُفتَحُ لكِ أبْوابُ السَّماءِ، فتُرسَلُ مِن السَّماءِ، ثُمَّ تَصيرُ إلى القَبْرِ، فيَجلِسُ الرَّجُلُ الصَّالِحُ، فيُقالُ له ويَرُدُّ»."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح، وحديث عائشة وكذا حديث أبي هُرَيْرةَ بعضهما في \"الصحيح\"من وجهين آخرين","takhrij":"أخرجه أحمد (25090) واللفظ له، وابن ماجة (4268)، وابن حبان (3113) بنحوه.","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"XKG6SNPU"},{"id":"س-04661","fp":"7eb3f30b98d3","stateId":653,"easy":"إذا كنت سيئاً ← يُقال لروحك: اخرجي أيتها النفس الخبيثة","cause":"فإذا كانَ الرَّجُلُ السُّوءُ قالوا","result":"اخْرُجي أيَّتُها النَّفْسُ الخَبيثةُ كانَت في الجَسَدِ الخَبيثِ، اخْرُجي مِنه ذَميمةً، وأَبشِري بحَميمٍ وغَسَّاقٍ، وآخَرَ مِن شَكْلِه أزْواجٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"الصحيح المسند 2/342","srcLabel":"أحمد","text":["عن عائِشةَ قالَتْ: جاءَتْ يَهوديَّةٌ فاسْتَطْعَمَتْ على بابي، فقالَتْ: أَطعِموني، أَعاذَكم اللهُ مِن فِتْنةِ الدَّجَّالِ ومِن فِتْنةِ عَذابِ القَبْرِ، قالَتْ: فلم أَزَلْ أَحبِسُها حتَّى جاءَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، فقُلْتُ: يا رَسولَ اللهِ، ما تَقولُ هذه اليَهوديَّةُ؟ قالَ: «وما تَقولُ؟»، قُلْتُ: تَقولُ: أعاذَكم اللهُ مِن فِتْنةِ الدَّجَّالِ ومِن فِتْنةِ عَذابِ القَبْرِ، قالَتْ عائِشةُ: فقامَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ فرَفَعَ يَدَيه مَدًّا يَسْتعيذُ باللهِ مِن فِتْنةِ الدَّجَّالِ ومِن فِتْنةِ عَذابِ القَبْرِ، ثُمَّ قالَ: «أمَّا فِتْنةُ الدَّجَّالِ فإنَّه لم يكنْ نَبيٌّ إلَّا قد حَذَّرَ أُمَّتَه، وسأُحَذِّرُكموه تَحْذيرًا لم يُحَذِّرْه نَبيٌّ أُمَّتَه، إنَّه أَعوَرُ، واللهُ عَزَّ وجَلَّ ليس بأَعوَرَ، مَكْتوبٌ بَيْنَ عَيْنَيه: كافِرٌ، يَقرَؤُه كلُّ مُؤمِنٍ، فأمَّا فِتْنةُ القَبْرِ فبي تُفْتَنونَ، وعنِّي تُسأَلونَ، فإذا كانَ الرَّجُلُ الصَّالِحُ أُجلِسَ في قَبْرِه غَيْرَ فَزِعٍ ولا مَشْعوفٍ، ثُمَّ يُقالُ له: فيمَ كُنْتَ؟ فيَقولُ: في الإسْلامِ، فيُقالُ: ما هذا الرَّجُلُ الَّذي كانَ فيكم؟ فيَقولُ: مُحمَّدٌ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، جاءَنا بالبَيِّناتِ مِن عنْدِ اللهِ عَزَّ وجَلَّ، فصَدَّقْناه، فيُفرَجُ له فُرْجةٌ قِبَلَ النَّارِ، فيَنظُرُ إليها يَحطِمُ بعضُها بعضًا، فيُقالُ له: انْظُرْ إلى ما وَقاك اللهُ عَزَّ وجَلَّ، ثُمَّ يُفرَجُ له فُرْجةٌ إلى الجَنَّةِ، فيَنظُرُ إلى زَهْرتِها وما فيها، فيُقالُ له: هذا مَقعَدُك مِنها، ويُقالُ: على اليَقينِ كُنْتَ، وعليه مِتَّ، وعليه تُبعَثُ إن شاءَ اللهُ. وإذا كانَ الرَّجُلُ السُّوءُ أُجلِسَ في قَبْرِه فَزِعًا مَشْعوفًا، فيُقالُ له: فيمَ كُنْتَ؟ فيَقولُ: لا أَدْري، فيُقالُ: ما هذا الرَّجُلُ الَّذي كانَ فيكم؟ فيَقولُ: سَمِعْتُ النَّاسَ يَقولونَ قَوْلًا فقُلْتُ كما قالوا، فتُفرَجُ له فُرْجةٌ قِبَلَ الجَنَّةِ، فيَنظُرُ إلى زَهْرتِها وما فيها، فيُقالُ له: انْظُرْ إلى ما صَرَفَ اللهُ عَزَّ وجَلَّ عنك، ثُمَّ يُفرَجُ له فُرْجةٌ قِبَلَ النَّارِ، فيَنظُرُ إليها يَحطِمُ بعضُها بَعضًا، ويُقالُ له: هذا مَقعَدُك مِنها، كُنْتَ على الشَّكِّ، وعليه مِتَّ، وعليه تُبعَثُ إن شاءَ اللهُ، ثُمَّ يُعذَّبُ».\nقالَ مُحمَّدُ بنُ عَمْرٍو: فحَدَّثَني سَعيدُ بنُ يَسارٍ عن أبي هُرَيْرةَ، عن النَّبيِّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ قالَ: «إنَّ المَيِّتَ تَحضُرُه المَلائِكةُ، فإذا كانَ الرَّجُلُ الصَّالِحُ قالوا: اخْرُجي أيَّتُها النَّفْسُ الطَّيِّبةُ كانَتْ في الجَسَدِ الطَّيِّبِ، واخْرُجي حَميدةً، وأَبْشِري برَوْحٍ ورَيْحانٍ، ورَبٍّ غَيْرِ غَضْبانَ، فلا يَزالُ يُقالُ لها ذلك حتَّى تَخرُجَ، ثُمَّ يُعرَجُ بِها إلى السَّماءِ، فيُسْتَفتَحُ له، فيُقالُ: مَن هذا؟ فيُقالُ: فُلانٌ، فيُقالُ: مَرْحبًا بالنَّفْسِ الطَّيِّبةِ كانَت في الجَسَدِ الطَّيِّبِ، ادْخُلي حَميدةً، وأَبشِري، ويُقالُ: برَوْحٍ ورَيْحانٍ، ورَبٍّ غَيْرِ غَضْبانَ، فلا يَزالُ يُقالُ لها ذلك حتَّى يُنْتَهى بها إلى السَّماءِ الَّتي فيها اللهُ عَزَّ وجَلَّ، ",["فإذا كانَ الرَّجُلُ السُّوءُ قالوا",1],": ",["اخْرُجي أيَّتُها النَّفْسُ الخَبيثةُ كانَت في الجَسَدِ الخَبيثِ، اخْرُجي مِنه ذَميمةً، وأَبشِري بحَميمٍ وغَسَّاقٍ، وآخَرَ مِن شَكْلِه أزْواجٍ",2],"، فما يَزالُ يُقالُ لها ذلك حتَّى تَخرُجَ، ثُمَّ يُعرَجُ بها إلى السَّماءِ، فيُسْتَفتَحُ لها، فيُقالُ: مَن هذا؟ فيُقالُ: فُلانٌ، فيُقالُ: لا مَرْحبًا بالنَّفْسِ الخَبيثةِ كانَت في الجَسَدِ الخَبيثِ، ارْجِعي ذَميمةً؛ فإنَّه لا يُفتَحُ لكِ أبْوابُ السَّماءِ، فتُرسَلُ مِن السَّماءِ، ثُمَّ تَصيرُ إلى القَبْرِ، فيَجلِسُ الرَّجُلُ الصَّالِحُ، فيُقالُ له ويَرُدُّ»."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح، وحديث عائشة وكذا حديث أبي هُرَيْرةَ بعضهما في \"الصحيح\"من وجهين آخرين","takhrij":"أخرجه أحمد (25090) واللفظ له، وابن ماجة (4268)، وابن حبان (3113) بنحوه.","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"XKG6SNPU"},{"id":"س-05418","fp":"97b861381dad","stateId":653,"easy":"إذا قلت في قبرك «لا أدري» ← يُفتح لك باب إلى جهنم","cause":"قال لا أدري","result":"ويُفتَحُ له بابٌ في قبرِهِ بابٌ من أبوابِ جهنمَ ثم يُضربُ ضربةً يَسمعُها خلقُ اللهِ إلا الثّقَلَينِ ثم يُقالُ نَمْ كما ينامُ المنهوشُ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"مسند عمر 2/502","srcLabel":"أحمد","text":["إنَّ المؤمنَ حين ينزلُ به الموتُ ويعاينُ ما يعاينُ ودَّ أنها قد خرجتْ واللهُ يحبُّ لقاءَه وإنَّ المؤمنَ يُصعَد برُوحهِ إلى السماءِ فتأتيه أرواحُ الْمُؤْمِنينَ فيَستخبرونه عن معارفِهم من أهلِ الأرضِ فإذا قال تركتُ فلانًا في الدُّنيا أعجبَهم ذلك وإذا قال إنَّ فلانًا قد فارق الدُّنيا قالوا ما جيءِ بروحِ ذاك إلينا وقد ذُهِبَ بروحِه إلى أرواحِ أهلِ النارِ وإنَّ المؤمنَ يُجلَسُ في قبرِهِ ويُسألُ مَن ربُّك فيقولُ ربيَ اللهُ ويُقالُ مَنْ نبيُّكَ فيقولُ نبيّ محمدٌ صلَّى اللهُ عليه وسلَّمَ فيُقالُ ما دينُك فيقولُ دينيَ الإسلامُ فيُفتحُ له بابٌ في قبرِهِ فيقالُ انظُرْ إلى مجلسِك نمْ قريرَ العينِ فيبعثُه اللهُ يومَ القيامةِ كأنما كانت رَقدَةً وإذا كان عدوَّ اللهِ ونزل به الموتُ ويُعاينُ ما يعاينُ ودَّ أنها لا تخرجُ أبدًا واللهُ يبغَضُ لقاءَه وإذا أُجلِسَ في قبرِهِ يُقالُ من ربُّك ",["قال لا أدري",1]," قال لا دَرَيتَ ",["ويُفتَحُ له بابٌ في قبرِهِ بابٌ من أبوابِ جهنمَ ثم يُضربُ ضربةً يَسمعُها خلقُ اللهِ إلا الثّقَلَينِ ثم يُقالُ نَمْ كما ينامُ المنهوشُ",2]," قال قلتُ يا أبا هريرةَ وما المنهوشُ قال نهشَتْهُ الدوابُّ والحيّاتُ ثم يَضيقُ عليه قبرُهُ حتى رأيتُ أبا هريرةَ نصبَ يدَه ثم كفَأها ثم شبَّك حتى تختلفَ أضلاعُهُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه عبدالله بن أحمد في ((السنة)) (1447)، والبزار (9760)، وابن المقرئ في ((المعجم)) (11) باختلاف يسير","bab":"رقائق وزهد › الحب للقاء الله","dorar":"nERNGki9"},{"id":"س-07461","fp":"57f60ebfc840","stateId":653,"easy":"إذا كنت خبيثاً ← يُقال لروحك: اخرجي ساخطة مسخوطاً عليك","cause":"النَّفسُ الخبيثَةُ كانت في الجسدِ الخبيثِ","result":"اخرجي ساخطةً مسخوطًا عليْكِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"مجموع الفتاوى 9/290","srcLabel":"مجموع الفتاوى","text":["إنَّ الإنسانَ إذا قُبضَت روحُهُ فتقولُ الملائِكةُ اخرُجي أيَّتُها النَّفسُ الطَّيِّبةُ كانت في الجسدِ الطَّيِّبِ اخرُجي راضيةً مرضيًّا عنْكِ. ويقالُ اخرُجي أيَّتُها ",["النَّفسُ الخبيثَةُ كانت في الجسدِ الخبيثِ",1]," ",["اخرجي ساخطةً مسخوطًا عليْكِ",2]],"grade":"صحيح","muhaddith":"ثبت بأسانيد صحيحة","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"tcFWalTe"},{"id":"س-08099","fp":"7dfc971edb11","stateId":653,"easy":"إذا وُضعت في قبرك كافراً ← تقول: لا أدري، فتُعذّب","cause":"إذا وضع كافرٌ في قبرِه","result":"أتاه منكرٌ ونكيرٌ فيجلسانه فيقولان له من ربُّك ؟ فيقول لا أدري ، فيقولان له لا دريت فيضربانه ضربةً فيصيرُ رمادًا","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"الروح 1/272","srcLabel":"أبو داود","text":["عن البراءِ بنِ عازبٍ قال كنا في جنازةِ رجلٍ من الأنصارِ ومعنا رسولُ اللهِ صلى اللهُ عليهِ وسلَّمَ فقال أن المؤمنَ إذا احتضر أتاه ملكُ الموتِ في أحسنِ صورةٍ وأطيبِه ريحًا فجلس عنده لقبضِ روحِه وأتاه ملكان بحَنوطٍ من الجنةِ وكانا منه على بعد فاستخرج ملَكُ الموتِ روحَه من جسدِه رشحًا فإذا صارت إلى ملكِ الموتِ ابتدرها الملكانِ فأخذاها منه فحنطاها بحنوطٍ من الجنةِ وكفناها بكفنٍ من الجنةِ ثم عرجا به إلى الجنةِ فتفتحُ له أبوابُ السماءِ وتستبشرُ الملائكةُ بها ويقولان لمن هذه الروحُ الطيبةُ التي فتحت لها أبوابُ السماءِ ؟ ويسمى بأحسنِ الأسماءِ التي كان يسمى بها في الدنيا ، فيقالُ هذه روحُ فلانٍ فإذا صعد بها إلى السماءِ شيّعها مقربو كلِّ سماءٍ حتى توضعَ بين يدي اللهِ عند العرشِ فيخرجُ عملُها من عليين فيقولُ اللهُ عز وجل للمقربين اشهدوا أني قد غفرتُ لصاحبِ هذا العملِ ويختمُ كتابَه فيردّ في عليين فيقولُ اللهُ عز وجل ردوا روحَ عبدي إلى الأرضِ فإني وعدتهم أن أردهم فيها ثم قرأ رسولُ اللهِ صلى الله عليه وآله وسلم : { مِنْهَا خَلَقْنَاكُمْ وَفِيهَا نُعِيدُكُمْ وَمِنْهَا نُخْرِجُكُمْ تَارَةً أُخْرَى } فإذا وضع المؤمنُ في قبرِه فتح له بابٌ عند رجليه إلى الجنةِ فيقال له انظرْ إلى ما أعدّ اللهُ لك من الثوابِ ويفتحُ له بابٌ عند رأسِه إلى النارِ فيقالُ له انظرْ ما صرف اللهُ عنك من العذابِ ثم يقالُ له نمْ قريرَ العينِ فليس شيءٌ أحبَّ إليه من قيامِ الساعةِ وقال رسولُ اللهِ صلى الله عليه وآله وسلم إذا وضع المؤمنُ في لحدِه تقولُ له الأرضُ إن كنت لحبيبَا إليّ وأنت على ظهرِي فكيف إذا صرت اليوم في بطني سأريك ما أصنع بك فيفسحُ له في قبرِه مد بصرِه ، وقال رسولُ اللهِ صلى الله عليه وآله وسلم ",["إذا وضع كافرٌ في قبرِه",1]," ",["أتاه منكرٌ ونكيرٌ فيجلسانه فيقولان له من ربُّك ؟ فيقول لا أدري ، فيقولان له لا دريت فيضربانه ضربةً فيصيرُ رمادًا",2]," ثم يعادُ فيجلسُ ، فيقالُ ما قولك في هذا الرجلِ ؟ فيقولُ أي رجلٍ ؟ فيقولان محمدٌ صلى الله عليه وآله سلم فيقولُ قال الناسُ أنه رسولُ اللهِ صلى الله عليه وآله وسلم فيضربانه ضربةً فيصيرُ رمادًا"],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"ثابت مشهور مستفيض صححه جماعة من الحفاظ ولا نعلم أحدا من أئمة الحديث طعن فيه بل رووه في كتبهم وتلقوه بالقبول","takhrij":"أخرجه أبو داود (4753) بنحوه، والنسائي (2001)، وابن ماجه (1549)، مختصرا.","bab":"ملائكة › أعمال الملائكة","dorar":"S6wyj1fv"},{"id":"س-08245","fp":"0926b3e2f911","stateId":653,"easy":"إذا مت كافراً ← تكون أشد انتفاخاً وأنتن ريحاً (رؤيا)","cause":"موتى الكُفَّارِ","result":"بموتى أشدِّ شيءٍ انتفاخًا وأنتَنِه ريحًا","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"سبل الهدى والرشاد 7/265","srcLabel":"الحاكم","text":["خرج علينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بعدَ صلاةِ الصُّبحِ، فقال: «إني رأيتُ رؤيا هي حَقٌّ تَعقِلونها، أتاني جبريلُ عليه السَّلامُ، فأخذ بيدي، فاستتبَعَني حتى أتى بي جبَلًا طويلًا وَعرًا، فقال لي: ارْقَ، فقُلتُ: لا أستطيعُ، فقال: سأسَهِّلُه لك، فجعلتُ كلَّما رَقَت قدمي وضعتُها على دَرَجةٍ، حتى استوينا على سواءِ الجَبَلِ، فانطلَقنا فإذا نحن برجالٍ ونِساءٍ مُشَقَّقةٍ أشداقُهم، فقُلتُ: من هؤلاء؟ قال: هؤلاء الذين يقولون ما لا يعلمون، ثمَّ انطلقنا فإذا نحن برجالٍ ونِساءٍ ممدودةٍ أعينُهم وآذانُهم، قُلتُ: ما هؤلاء؟ قال: الذين يُرون أعيُنَهم ما لا يرون، ويُسمِعون آذانَهم ما لا يسمعون، ثمَّ انطلَقنا فإذا نحن بنساءٍ مُعَلَّقاتٍ بعراقيبِهنَّ، مصوَّبةٍ رؤوسُهنَّ، تنهَشُ أثداءَهن الحيَّاتُ، فقُلتُ: ما هؤلاء؟ قال: الذين يمنَعْنَ أولادَهم من ألبانِهنَّ، ثمَّ انطلَقنا فإذا نحن برجالٍ ونساءٍ مُعَلَّقاتٍ بعراقيبِهنَّ، مُصَوَّباتٍ رُؤوسُهنَّ، يَلحَسنَ من ماءٍ قَليلٍ وحمأةٍ، قُلتُ: ما هؤلاء؟ قال: الذين يصومون ويُفطِرون قَبلَ تحِلَّةِ صَومِهم، ثمَّ انطلقنا فإذا نحن برجالٍ ونساءٍ أقبَحِ شيءٍ مَنظَرًا وأقبَحِه لَبوسًا، وأنتَنِه ريحًا، كأنما ريحُهم المراحيضُ، قُلتُ: ما هؤلاء؟ قال: هؤلاء الزَّانون والزُّناة، ثمَّ انطلقنا فإذا نحن ",["بموتى أشدِّ شيءٍ انتفاخًا وأنتَنِه ريحًا",2],"، قُلتُ: ما هؤلاء؟ قال: هؤلاء ",["موتى الكُفَّارِ",1],"، ثمَّ انطلقنا فإذا نحن نرى دُخانًا، ونسمَعُ عِواءً، قُلتُ: ما هذا؟ قال: هذه جهنَّمُ فدعها، ثمَّ انطلقنا فإذا نحن برجالٍ نيامٍ تحتَ ظِلالِ الشَّجَرةِ، قُلتُ: ما هؤلاء؟ قال: هؤلاء موتى المسلمين، ثمَّ انطلَقنا فإذا نحن بجَوارٍ وغِلمانٍ أحسَنِ شَيءٍ وَجهًا، وأحسَنِه لَبوسًا، وأطيَبِه ريحًا، كأنَّ وُجوهَهم القراطيسُ، قُلتُ ما هؤلاء؟ قال: هؤلاء الصِّدِّيقون والشُّهَداءُ والصَّالحون، ثمَّ انطلقنا فإذا نحن بثلاثةِ نَفَرٍ يَشرَبون خمرًا، ويلعبون، فقُلتُ: ما هؤلاء؟ فقال: ذاك زيدُ بنُ حارِثةَ، وجعفَرٌ، وابنُ رَواحةَ، فمِلتُ قِبَلَهم، فقالوا: قُدنا لك، قُدنا لك، ثمَّ رفعتُ رأسي، فإذا ثلاثةُ نَفَرٍ تحتَ العَرشِ، قُلتُ: ما هؤلاء؟ قال: ذاك أبوك إبراهيمُ وموسى وعيسى، عليهم السَّلامُ، وهم ينتَظِرونك، صلواتُ اللهِ وسلامُه عليهم أجمعين»"],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"[رجاله] رجال الصحيح","takhrij":"أخرجه الطبراني في ((الشاميين)) (1966) باختلاف يسير، وابن خزيمة (1986)، والحاكم (2837) بنحوه.","bab":"ملائكة › فضل جبريل","dorar":"jPNaFG9n"},{"id":"س-02428","fp":"84f4a3fa021d","stateId":653,"easy":"إذا كنت كافراً ← تخرج نفسك من شدقك كما تخرج نفس الحمار","cause":"و نفسُ الكافرِ","result":"تَخرُجُ من شِدْقِه ، كما تخرُجُ نفسُ الحِمارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح الجامع 5149","srcLabel":"الطبراني","text":["لقِّنوا موتَاكم لا إِلهَ إلا اللهُ ، فإنَّ نفسَ المُؤمِنِ تَخرُجُ رشْحًا ، ",["و نفسُ الكافرِ",1]," ",["تَخرُجُ من شِدْقِه ، كما تخرُجُ نفسُ الحِمارِ",2]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"حسن","takhrij":"أخرجه الطبراني (10/233) (10417)، وأبو نعيم في ((حلية الأولياء)) (5/59)، والشجري في ((الأمالي)) (2926)","bab":"إسلام › فضل الشهادتين","dorar":"tr0KpdeT"},{"id":"س-03000","fp":"7480bc8d43af","stateId":653,"easy":"إذا مت كافراً ← تُرسل عليك حيتان في قبرك","cause":"على الْكَافِرِ","result":"حَيَّتَانِ واحدةٌ مِنْ قِبَلِ رَأْسِهِ والأخرى مِنْ قِبَلِ رِجْلَيْهِ يَقْرُصانِهِ قَرْصًا","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-04139","ref":"مجمع الزوائد 3/58","text":["يُرْسَلُ ",["على الْكَافِرِ",1]," ",["حَيَّتَانِ واحدةٌ مِنْ قِبَلِ رَأْسِهِ والأخرى مِنْ قِبَلِ رِجْلَيْهِ يَقْرُصانِهِ قَرْصًا",2]," كُلَّمَا فرغَتَا عَادَتَا إلى يومِ القيامَةِ"],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (25189) والخطيب في ((تاريخ بغداد)) (2/384) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"j7swiywk"},{"id":"س-04114","fp":"240c4b7dddfc","stateId":654,"easy":"إذا متّ على خطيئتك وذنبك ← تُعذّب بها","cause":"بخَطيئَتِه وذَنبِه","result":"إنَّه لَيُعَذَّبُ","explicit":true,"star":true,"ref":"صحيح البخاري 3978","srcLabel":"متفق عليه","text":["ذُكِرَ عِندَ عائِشةَ رَضيَ اللهُ عنها أنَّ ابنَ عُمَرَ رَفَعَ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم: إنَّ المَيِّتَ يُعَذَّبُ في قَبرِه ببُكاءِ أهلِه، فقالت: وَهَلَ؛ إنَّما قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["إنَّه لَيُعَذَّبُ",2]," ",["بخَطيئَتِه وذَنبِه",1],"، وإنَّ أهلَه لَيَبكونَ عليه الآنَ، قالت: وذاك مِثلُ قَولِه: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قامَ على القَليبِ وفيه قَتلى بَدرٍ مِنَ المُشرِكينَ، فقال لهم ما قال: إنَّهم لَيَسمَعونَ ما أقولُ، إنَّما قال: إنَّهمُ الآنَ لَيَعلَمونَ أنَّ ما كُنتُ أقولُ لهم حَقٌّ، ثُمَّ قَرَأَت {إنَّك لا تُسمِعُ المَوتى} [النمل: 80]، {وما أنتَ بِمُسمِعٍ مَن في القُبورِ} [فاطر: 22]، يقولُ: حينَ تَبَوَّؤوا مَقاعِدَهم مِنَ النَّارِ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3978، 3979)، ومسلم (932)","bab":"جنائز وموت › البكاء على الميت","dorar":"xOtCIt2y"},{"id":"س-04606","fp":"6f20713bb118","stateId":654,"easy":"إذا مشيت بالنميمة ← تُعذّب في قبرك","cause":"يَمْشِي بالنَّمِيمَةِ","result":"يعذبَانِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-04667"],"ref":"عمدة القاري 8/268","srcLabel":"متفق عليه","text":["مرَّ النَّبيُّ صلَّى اللهُ عليهِ وسلَّمَ بحائطٍ مِن حيطانِ المدينةِ أو مكةَ فسمعَ صوتَ إنسانَينِ ",["يعذبَانِ",2]," في قبورِهِمَا [فَقالَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ: يُعَذَّبَانِ، وما يُعَذَّبَانِ في كَبِيرٍ ثُمَّ قالَ: بَلَى، كانَ أحَدُهُما لا يَسْتَتِرُ مِن بَوْلِهِ ، وكانَ الآخَرُ ",["يَمْشِي بالنَّمِيمَةِ",1],". ثُمَّ دَعَا بجَرِيدَةٍ، فَكَسَرَهَا كِسْرَتَيْنِ، فَوَضَعَ علَى كُلِّ قَبْرٍ منهما كِسْرَةً، فقِيلَ له: يا رَسولَ اللَّهِ، لِمَ فَعَلْتَ هذا؟ قالَ: لَعَلَّهُ أنْ يُخَفَّفَ عنْهما ما لَمْ تَيْبَسَا أوْ: إلى أنْ يَيْبَسَا.]"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه البخاري (216) واللفظ له، ومسلم (292)","bab":"دفن ومقابر › أحوال الميت في القبر","dorar":"mM2UuG3j","merged":6,"otherRefs":["صحيح البخاري 218 (صحيح)","صحيح أبي داود 20 (صحيح)","صحيح البخاري 1378 (صحيح)","صحيح البخاري 6055 (صحيح)","صحيح مسلم 292 (صحيح)"]},{"id":"س-04674","fp":"4d416dc43930","stateId":654,"easy":"إذا عصيت النهي ← تُعذّب في قبرك","cause":"فنَهاهُم","result":"فعُذِّب في قَبرِه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"الإلزامات والتتبع 93","srcLabel":"متفق عليه","text":["خَرَج عَلينا رَسولُ اللهِ صلَّى اللهُ عليهِ وآلِه وسلَّم وَفي يَدِه كَهيئةِ الدَّرقةِ. قال: فَوَضَعها ثُمَّ جَلس فَبالَ إليهِ النَّبيُّ صلَّى اللهُ عليهِ وآلِه وسلَّم، فَقال بعضُ القومِ: انظُروا إليهِ يَبولُ كَما تَبولُ المَرأةُ. قال: فسَمِعَه النَّبيُّ صلَّى اللهُ عليهِ وآلِه وسلَّم فَقال: وَيحَك! أَما عَلِمتَ ما أَصاب صاحبَ بَني إسرائيلَ؟ كانوا إذا أَصابهُم شيءٌ مِنَ البَول قَرَضوه بالمَقاريضِ، ",["فنَهاهُم",1]," ",["فعُذِّب في قَبرِه",2],"."],"grade":"صحيح","narrator":"عبدالرحمن بن حسنة","muhaddith":"[ يلزمهما إخراجه ] البخاري ومسلم","takhrij":"أخرجه النسائي (30)، وابن ماجة (346) واللفظ لهما، وأبو داود (22) بنحوه.","bab":"دفن ومقابر › عذاب القبر ونعيمه","dorar":"SkEKmQTm","merged":5,"otherRefs":["عمدة القاري 8/211 (صحيح)","المستدرك على الصحيحين 671 (صحيح)","الصحيح المسند 892 (صحيح)","تخريج مشكل الآثار 5206 (صحيح)"]},{"id":"س-04625","fp":"26b9bbe16156","stateId":654,"easy":"إذا كنت بطيئاً عن طاعة الله سريعاً إلى معصيته ← يُقيّض لك في قبرك أعمى أصم أبكم يضربك","cause":"كنتُ بطيئًا عن طاعةِ اللهِ ، سريعًا إلى معصيةِ اللهِ","result":"ثم يُقَيَّضُ له أَعْمَى أَصَمُّ أَبْكَمُ في يَدِهِ مِرْزَبَّةٌ ! لو ضُرِبَ بها جبلٌ كان ترابًا ، فيَضْرِبُهُ ضَرْبَةً حتى يَصِيرَ بها ترابًا ، ثم يُعِيدُهُ اللهُ كما كان ، فيَضْرِبُهُ ضَرْبَةً أُخْرَى ، فيَصِيحُ صَيْحَةً يَسْمَعُهُ كلُّ شيءٍ إلا الثَّقَلَيْنِ","explicit":true,"star":true,"ref":"أحكام الجنائز 198","srcLabel":"أبو داود","text":["خَرَجْنا مع النبيِّ صلَّى اللهُ عليه وسلَّم في جَنازةِ رجلٍ من الأنصارِ ، فانْتَهَيْنا إلى القبرِ ولَمَّا يُلْحَدْ ، فجلس رسولُ اللهِ صلَّى اللهُ عليه وسلم مُسْتَقْبِلَ القِبْلَةِ ، وجَلَسْنَا حَوْلَهُ ، وكأنَّ على رُؤُوسِنَا الطَّيْرَ ، وفي يَدِهِ عودٌ يَنْكُتُ في الأرضِ ، فجعل يَنْظُرُ إلى السماءِ ، ويَنْظُرُ إلى الأرضِ ، وجعل يرفعُ بَصَرَهُ ويَخْفِضُهُ ، ثلاثًا ، فقال : اسْتَعِيذُوا باللهِ من عذابِ القَبْرِ ، مَرَّتَيْنِ ، أو ثلاثًا ، ثم قال : اللهم إني أعوذُ بك من عذابِ القبرِ ثلاثًا ، ثم قال: إنَّ العبدَ المؤمنَ إذا كان في انقِطاعٍ من الدنيا ، وإقبالٍ من الآخرةِ ، نَزَلَ إليه ملائكةٌ من السماءِ ، بِيضُ الوُجُوهِ ، كأنَّ وجوهَهُمُ الشمسُ ، معهم كَفَنٌ من أكفانِ الجنةِ ، وحَنُوطٌ من حَنُوطِ الجنةِ ، حتى يَجْلِسُوا منه مَدَّ البَصَرِ ، ثم يَجِىءُ مَلَكُ الموتِ عليه السلامُ حتى يَجْلِسَ عندَ رأسِهِ فيقولُ : أَيَّتُها النَّفْسُ الطيبةُ وفي رواية : المطمئنةُ ، اخْرُجِي إلى مغفرةٍ من اللهِ ورِضْوانٍ ، قال : فتَخْرُجُ تَسِيلُ كما تَسِيلُ القَطْرَةُ من فِي السِّقَاءِ ، فيأخُذُها ، وفي روايةٍ : حتى إذا خَرَجَتْ رُوحُه صلَّى عليه كُلُّ مَلَكٍ بينَ السماءِ والأرضِ ، وكُلُّ مَلَكٍ في السماءِ ، وفُتِحَتْ له أبوابُ السماءِ ، ليس من أهلِ بابٍ إلا وهم يَدْعُونَ اللهَ أن يُعْرَجَ برُوحِهِ من قِبَلِهِمْ ، فإذا أخذها لم يَدَعُوها في يَدِهِ طَرْفَةَ عَيْنٍ حتى يأخذوها فيَجْعَلُوها في ذلك الكَفَنِ ، وفي ذلك الحَنُوطِ ، فذلك قولُه تعالى :  تَوَفَّتْهُ رُسُلُنَا وَهُمْ لَا يُفَرِّطُونَ  ، ويخرجُ منها كأَطْيَبِ نَفْحَةِ مِسْكٍ وُجِدَتْ على وجهِ الأرضِ ، قال : فيَصْعَدُونَ بها فلا يَمُرُّونَ – يعني – بها على مَلَأٍ من الملائكةِ إلا قالوا : ما هذا الرُّوحُ الطَّيِّبُ ؟ فيقولونَ : فلانُ ابنُ فلانٍ – بأَحْسَنِ أسمائِهِ التي كانوا يُسَمُّونَهُ بها في الدنيا ، حتى يَنْتَهُوا بها إلى السماءِ الدنيا ، فيَسْتَفْتِحُونَ له ، فيُفْتَحُ لهم ، فيُشَيِّعُهُ من كلِّ سماءٍ مُقَرَّبُوها ، إلى السماءِ التي تَلِيها ، حتى يُنْتَهَي به إلى السماءِ السابعةِ ، فيقولُ اللهُ عَزَّ وجَلَّ : اكْتُبُوا كتابَ عَبْدِي في عِلِّيِّينَ  وَمَا أَدْرَاكَ مَا عِلِّيُّونَ . كِتَابٌ مَرْقُومٌ يَشْهَدُهُ الْمُقَرَّبُونَ  فيُكْتَبُ كتابُه في عِلِّيِّينَ ، ثم يُقَالُ : أَعِيدُوهُ إلى الأرضِ ، فإني وَعَدْتُهُم أني منها خَلَقْتُهُم ، وفيها أُعِيدُهُم ومنها أُخْرِجُهُم تارةً أُخْرَى ، قال : فيُرَدُّ إلى الأرضِ ، و تُعَادُ رُوحُهُ في جَسَدِهِ ، قال : فإنه يَسْمَعُ خَفْقَ نِعالِ أصحابِه إذا وَلَّوْا عنه مُدْبِرِينَ ، فيَأْتِيهِ مَلَكانِ شَدِيدَا الانتهارِ فيَنْتَهِرَانِهِ ، ويُجْلِسَانِهِ فيَقُولانِ له : مَن ربُّكَ ؟ فيقولُ : رَبِّيَ اللهُ ، فيقولانِ له : ما دِينُكَ ؟ فيقولُ : دِينِيَ الإسلامُ ، فيقولانِ له : ما هذا الرجلُ الذي بُعِثَ فيكم ؟ فيقولُ : هو رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ، فيقولانِ له : وما [علمُكَ] ؟ فيقولُ : قرأتُ كتابَ اللهِ ، فآمَنْتُ به ، وصَدَّقْتُ ، فيَنْتَهِرُهُ فيقولُ : مَن رَبُّكَ ؟ ما دِينُكَ ؟ مَن نبيُّكَ ؟ وهي آخِرُ فتنةٍ تُعْرَضُ على المؤمنِ ، فذلك حينَ يقولُ اللهُ عَزَّ وجَلَّ :  {يُثَبِّتُ اللَّهُ الَّذِينَ آمَنُوا بِالْقَوْلِ الثَّابِتِ فِي الْحَيَاةِ الدُّنْيَا} ، فيقولُ : رَبِّيَ اللهُ ، ودِينِيَ الإسلامُ ، ونَبِيِّي مُحَمَّدٌ صلَّى اللهُ عليه وسلَّم ، فيُنَادِي مُنَادٍ في السماءِ : أن صَدَقَ عَبْدِي ، فأَفْرِشُوهُ من الجنةِ ، وأَلْبِسُوهُ من الجنةِ ، وافْتَحُوا له بابًا إلى الجنةِ ، قال : فيَأْتِيهِ من رَوحِها وطِيبِها ، ويُفْسَحُ له في قبرِه مَدَّ بَصَرِهِ ، قال : ويَأْتِيهِ- وفي روايةٍ : يُمَثَّلُ له- رجلٌ حَسَنُ الوجهِ ، حَسَنُ الثيابِ ، طَيِّبُ الرِّيحِ ، فيقولُ : أَبْشِرْ بالذي يَسُرُّكَ ، أَبْشِرِ برِضْوانٍ من اللهِ ، وجَنَّاتٍ فيها نعيمٌ مُقِيمٌ ، هذا يومُكَ الذي كنتَ تُوعَدُ ، فيقولُ له : وأنت فبَشَّرَكَ اللهُ بخيرٍ مَن أنت ؟ فوَجْهُكَ الوجهُ يَجِئُ بالخيرِ ، فيقولُ : أنا عَمَلُكَ الصالِحُ فواللهِ ما عَلِمْتُكَ إلا كنتَ سريعًا في طاعةِ اللهِ ، بطيئًا في معصيةِ اللهِ ، فجزاك اللهُ خيرًا ، ثم يُفْتَحُ له بابٌ من الجنةِ ، وبابٌ من النارِ ، فيُقالُ : هذا مَنْزِلُكَ لو عَصَيْتَ اللهَ ، أَبْدَلَكَ اللهُ به هذا ، فإذا رأى ما في الجنةِ قال : رَبِّ عَجِّلْ قيامَ الساعةِ ، كَيْما أَرْجِعَ إلى أهلي ومالي ، فيُقالُ له : اسْكُنْ ، قال : وإنَّ العبدَ الكافرَ- وفي روايةٍ : الفاجرَ- إذا كان في انقطاعٍ من الدنيا ، وإقبالٍ من الآخرةِ ، نَزَل إليه من السماءِ ملائكةٌ غِلَاظٌ شِدَادٌ ، سُودُ الوجوهِ ، معَهُمُ المُسُوحُ من النارِ ، فيَجْلِسُونَ منه مَدَّ البَصَرِ ، ثم يَجِيءُ مَلَكُ الموتِ حتى يَجْلِسَ عند رأسِهِ ، فيقولُ : أَيَّتُهَا النَّفْسُ الخبيثةُ اخْرُجِي إلى سَخَطٍ من اللهِ وغَضَبٍ ، قال : فتفَرَّقُ في جَسَدِهِ فيَنْتَزِعُها كما يُنْتَزَعُ السَّفُّودُ الكثيرُ الشُّعبِ من الصُّوفِ المَبْلُولِ ، فتَقْطَعُ معها العُرُوقَ والعَصَبَ ، فيَلْعَنُهُ كلُّ مَلَكٍ بينَ السماءِ والأرضِ ، وكلُّ مَلَكِ في السماءِ ، وتُغْلَقُ أبوابُ السماءِ ، ليس من أهلِ بابٍ إلا وهم يَدْعُونَ اللهَ أَلَّا تَعْرُجَ رُوحُهُ من قِبَلِهِمْ ، فيَأْخُذُها ، فإذا أخذها ، لم يَدَعُوها في يَدِهِ طَرْفَةَ عينٍ حتى يَجْعَلُوها في تِلْكِ المُسُوحِ ، ويخرجُ منها كأَنْتَنِ رِيحِ جِيفَةٍ وُجِدَتْ على وجهِ الأرضِ ، فيَصْعَدُونَ بها ، فلا يَمُرُّونَ بها على مَلَأٍ من الملائكةِ إلا قالوا : ما هذا الرُّوحُ الخَبِيثُ ؟ فيقولونَ : فلانُ ابنُ فلانٍ – بأَقْبَحِ أسمائِهِ التي كان يُسَمَّى بها في الدنيا ، حتى يُنْتَهَي به إلى السماءِ الدنيا ، فيُسْتَفْتَحُ له ، فلا يُفْتَحُ له ، ثم قرأ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم  {لَا تُفَتَّحُ لَهُمْ أَبْوَابُ السَّمَاءِ وَلَا يَدْخُلُونَ الْجَنَّةَ حَتَّى يَلِجَ الْجَمَلُ فِي سَمِّ الْخِيَاطِ}  فيقولُ اللهُ عَزَّ وجَلَّ : اكْتُبُوا كتابَه في سِجِّينَ في الأرضِ السُّفْلَى ، ثم يُقالُ : أَعِيدُوا عَبْدِي إلى الأرضِ فإني وَعَدْتُهُمْ أني منها خَلَقْتُهُمْ ، وفيها أُعِيدُهُمْ ، ومنها أُخْرِجُهُمْ تارةً أُخْرَى ، فتُطْرَحُ رُوحُهُ من السماءِ طَرْحًا حتى تَقَعَ في جَسَدِهِ ثم قرأ :  {وَمَنْ يُشْرِكْ بِاللَّهِ فَكَأَنَّمَا خَرَّ مِنَ السَّمَاءِ فَتَخْطَفُهُ الطَّيْرُ أَوْ تَهْوِي بِهِ الرِّيحُ فِي مَكَانٍ سَحِيقٍ}  فتُعادُ رُوحُهُ في جَسَدِهِ ، قال : فإنه لَيَسْمَعُ خَفْقَ نِعالِ أصحابِهِ إذا وَلَّوْا عنه . ويَأْتِيهِ مَلَكانِ شَدِيدَا الانتهارِ ، فَيَنْتَهِرَانِهِ ، ويُجْلِسَانِهِ ، فيَقُولانِ له : مَن ربُّكَ ؟ فيقولُ : هاه هاه لا أَدْرِي ، فيقولانِ له : مادِينُكَ ؟ فيقولُ : ها هاه لا أَدْرِي ، فيقولانِ : فما تَقُولُ في هذا الرجلِ الذي بُعِثَ فيكم ؟ فلا يَهْتَدِي لاسْمِهِ ، فيُقالُ : مُحَمَّدٌ ! فيقولُ : هاه هاه لا أَدْرِي سَمِعْتُ الناسَ يقولونَ ذاك ! قال : فيُقالُ : لا دَرَيْتَ ، ولا تَلَوْتَ ، فيُنادِي مُنَادٍ من السماءِ أن : كَذَبَ ، فأَفْرِشُوا له من النارِ ، وافْتَحُوا له بابًا إلى النارِ ، فيَأْتِيهِ من حَرِّها وسَمُومِها ، ويُضَيَّقُ عليه قَبْرُهُ حتى تَخْتَلِفَ فيه أضلاعُه ، ويَأْتِيهِ وفي روايةٍ : ويُمَثَّلُ له رجلٌ قبيحُ الوجهِ ، قبيحُ الثيابِ ، مُنْتِنُ الرِّيحِ ، فيقولُ : أَبْشِرْ بالذي يَسُوؤُكَ ، هذا يومُكَ الذي كنتَ تُوعَدُ ، فيقولُ : وأنت فَبَشَّرَكَ اللهُ بالشرِّ مَن أنت ؟ فوجهُك الوجهُ يَجِيءُ بالشرِّ ! فيقولُ : أنا عملُكَ الخبيثُ ، فواللهِ ما عَلِمْتُ إلا ",["كنتُ بطيئًا عن طاعةِ اللهِ ، سريعًا إلى معصيةِ اللهِ",1]," ، فجزاك الله شرًّا ، ",["ثم يُقَيَّضُ له أَعْمَى أَصَمُّ أَبْكَمُ في يَدِهِ مِرْزَبَّةٌ ! لو ضُرِبَ بها جبلٌ كان ترابًا ، فيَضْرِبُهُ ضَرْبَةً حتى يَصِيرَ بها ترابًا ، ثم يُعِيدُهُ اللهُ كما كان ، فيَضْرِبُهُ ضَرْبَةً أُخْرَى ، فيَصِيحُ صَيْحَةً يَسْمَعُهُ كلُّ شيءٍ إلا الثَّقَلَيْنِ",2]," ، ثم يُفْتَحُ له بابٌ من النارِ ، ويُمَهَّدُ من فُرُشِ النارِ ، فيقولُ : رَبِّ لا تُقِمِ الساعةَ ."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"القسم الأول منه إلى قوله: وكأن على رؤوسنا الطير صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (4753)، وأحمد (18558) باختلاف يسير، والنسائي (2001)، وابن ماجه (1549) مختصراً","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"pUmebMAe","merged":5,"otherRefs":["المستدرك على الصحيحين 108 (صحيح)","التذكرة للقرطبي 119 (صحيح)","الروح 1/269 (صحيح)","مسند عمر 2/491 (صحيح)"]},{"id":"س-04559","fp":"bcdcdfb9fe55","stateId":654,"easy":"إذا منعت المرأة أولادها لبنها ← تنهش ثديها الحيات","cause":"يمنعَنَ أولادَهنَّ ألبانَهنَّ","result":"بنساءٍ تنهشُ ثديَهُنَّ الحيَّاتُ","explicit":true,"star":true,"similar":["س-08242"],"otherNeedIds":[70],"ref":"صحيح الترغيب 2393","srcLabel":"النسائي","text":["بَينا أنا نائمٌ أتاني رجلانِ ، فأخذا بِضَبْعَيَّ فأتَيا بي جبلًا وعْرًا ، فقالا : اصعدْ . فقلتُ : إنِّي لا أُطيقُهُ . فقال : إنَّا سَنُسَهِّلُهُ لكَ . فصعدتُ ، حتَّى إذا كنتُ في سَواءِ الجبلِ إذا بأصواتٍ شديدةٍ . قلتُ : ما هذهِ الأصواتُ ؟ قالوا : هذا عُوَاءُ أهلِ النَّارِ ثمَّ انْطُلِقَ بي فإذا أنا بقَومٍ مُعلَقِينَ بعراقيبِهِم ، مُشَقَّقَةٌ أشداقُهُم ، تسيلُ أشداقُهُم دمًا . قال : قلتُ : مَن هؤلاءِ ؟ قال : الَّذينَ يُفطِرونَ قبلَ تَحلَّةِ صَومِهِم . فقال : خابتِ اليهودُ والنَّصارَى فقال سُلَيمُ : ما أدري أسمِعَهُ أبو أُمامَةَ مِن رسولِ اللهِ أم شيءٌ مِن رأْيِهِ ثمَّ انطلقَ بي ، فإذا أنا بقَومٍ أشدَّ شيءٍ انتفاخًا ، وأنتَنَهُ ريحًا ، وأسوأهُ مَنظرًا . فقلتُ : مَن هؤلاءِ ؟ فقال : هؤلاءِ قتلَى الكفَّارِ . ثمَّ انطلقَ بي فإذا أنا بقَومٍ أشدَّ شيءٍ انتفاخًا ، وأنتَنَهُ ريحًا ، كأنَّ ريحَهُم المَراحيضُ . قلتُ : مَن هؤلاءِ ؟ قال : هؤلاءِ الزَّانونَ والزَّواني . ثمَّ انطلقَ بي فإذا أنا ",["بنساءٍ تنهشُ ثديَهُنَّ الحيَّاتُ",2]," . قلتُ : ما بالُ هؤلاءِ ؟ قيلَ : هؤلاءِ ",["يمنعَنَ أولادَهنَّ ألبانَهنَّ",1]," . ثمَّ انطلقَ بي فإذا أنا بغِلمانٍ يلعبونَ بينَ نهرَينِ . قلتُ : مَن هؤلاءِ ؟ قيلَ : هؤلاءِ ذراريُّ المؤمنينَ . ثمَّ شرفَ بي شرفًا ، فإذا أنا بثلاثةٍ يشربونَ مِن خمرٍ لهُم . قلتُ : مَن هؤلاءِ ؟ قال : هؤلاءِ جعفرٌ ، وزيدٌ ، وابنُ رَواحةَ . ثمَّ شرفَ بي شرفًا آخرَ ، فإذا أنا بنفرٍ ثلاثةٍ . قلتُ : مَن هؤلاءِ ؟ قال : هذا إبراهيمُ ، وموسَى ، وعيسَى ، وهُم ينتظرونَكَ"],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبري)) (3286) مختصراً، وابن خزيمة (1986)، وابن حبان (7491) باختلاف يسير.","bab":"جهنم › صفة عذاب أهل النار","dorar":"JTrPX6Y6","merged":2,"otherRefs":["الإلمام بأحاديث الأحكام 2/705 (صحيح)"]},{"id":"س-04608","fp":"540838331a47","stateId":654,"easy":"إذا اغتبت أو لم تستنزه من البول ← تُعذّب في قبرك","cause":"في الغِيبةِ والبَوْلِ","result":"إنَّهما لَيُعَذَّبانِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-07464"],"ref":"تخريج مشكل الآثار 5191","srcLabel":"ابن ماجه","text":["كنتُ أَمْشي مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، أنا ورَجُلٌ آخَرُ، إذ مَرَّ بقَبرَيْنِ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّ صاحِبَيْ هذَيْنِ القَبرَيْنِ لَيُعَذَّبانِ، ومَن يَأْتيني بِجَريدةٍ مِن هذا النَّخلِ؟ فاستَبَقتُ أنا والرَّجُلُ فسبَقتُهُ، فكسَرتُ منها جَريدةً، فأتَيتُ بها النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فشَقَّها مِن أَعْلاها بنِصفَيْنِ، فوضَعَ على كُلِّ واحِدٍ مِنَ القَبرَيْنِ نِصفَها، وقال: إنَّهُ يُهَوِّنُ عليهما ما دامَ فيهما مِن رُطوبَتِهما شيءٌ، ",["إنَّهما لَيُعَذَّبانِ",2]," ",["في الغِيبةِ والبَوْلِ",1],"."],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (5191) بلفظه، وابن ماجه (349)، وأحمد (20411)، الطبراني في ((المعجم الأوسط)) (3747) جميعا مطولا.","bab":"دفن ومقابر › أحوال الميت في القبر","dorar":"MTNjeTK8","merged":8,"otherRefs":["الزواجر عن اقتراف الكبائر 2/11 (صحيح)","فتح الباري لابن حجر 10/485 (صحيح)","تخريج المسند لشعيب 20411 (حسن)","تخريج الإحياء للعراقي 3/176 (حسن)","صحيح الترغيب 160 (حسن)","فوائد الحنائي الحنائيات 1/664 (صحيح)","صحيح ابن حبان 3129 (صحيح)"]},{"id":"س-04667","fp":"e93305e2ba0b","stateId":654,"easy":"إذا مشيت بالنميمة ← تُعذّب في قبرك","cause":"والنَّميمةَ","result":"مِن عذابِ القبرِ","explicit":true,"repOf":"س-04606","ref":"صحيح ابن حبان 5735","text":["ألا إنَّ الكذِبَ يُسوِّدُ الوجهَ، ",["والنَّميمةَ",1]," ",["مِن عذابِ القبرِ",2]],"grade":"صحيح","narrator":"أبو برزة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو يعلى (7440)، والبيهقي في ((شعب الإيمان)) (4473))، وابن بشران في ((الأمالي)) (1185) جميعا باختلاف يسير.،","bab":"دفن ومقابر › عذاب القبر ونعيمه","dorar":"blWI6fvy"},{"id":"س-07464","fp":"9a3c40494c51","stateId":654,"easy":"إذا لم تستنزه من البول ← تُعذّب في قبرك","cause":"لا يستنزِهُ مِن البولِ","result":"يُعذَّبانِ في قبورِهما عذابًا شديدًا في ذَنْبٍ هيِّنٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04608","otherNeedIds":[13],"ref":"تخريج صحيح ابن حبان 824","text":["كنَّا نمشي مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فمرَرْنا على قبرَيْنِ فقام فقُمْنا معه فجعَل لونُه يتغيَّرُ حتَّى رعَد كُمُّ قميصِه فقُلْنا : ما لكَ يا نَبيَّ اللهِ ؟ قال : ( ما تسمَعونَ ما أسمَعُ ) ؟ قُلْنا : وما ذاكَ يا نَبيَّ اللهِ ؟ قال : ( هذانِ رجُلانِ ",["يُعذَّبانِ في قبورِهما عذابًا شديدًا في ذَنْبٍ هيِّنٍ",2]," ) قُلْنا : مِمَّ ذلكَ يا نَبيَّ اللهِ ؟ قال : ( كان أحَدُهما ",["لا يستنزِهُ مِن البولِ",1]," وكان الآخَرُ يُؤذِي النَّاسَ بلسانِه ويمشي بَيْنَهم بالنَّميمةِ ) فدعا بجَريدتَيْنِ مِن جرائدِ النَّخلِ فجعَل في كلِّ قبرٍ واحدةً قُلْنا : وهل ينفَعُهما ذلكَ يا رسولَ اللهِ ؟ قال : ( نَعم يُخفَّفُ عنهما ما داما رَطْبَيْنِ )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (824) واللفظ له، وأحمد (9686)، وابن أبي شيبة (12168) كلاهما مختصرا.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"AGx64raU","merged":9,"otherRefs":["صحيح البخاري 218 (صحيح)","عمدة القاري 8/268 (صحيح)","صحيح أبي داود 20 (صحيح)","صحيح البخاري 1378 (صحيح)","صحيح البخاري 6055 (صحيح)","الأحاديث المختارة 2218 (صحيح)","التنوير شرح الجامع الصغير 1/330 (صحيح)","صحيح مسلم 292 (صحيح)"]},{"id":"س-04627","fp":"d3e4d922e89f","stateId":654,"easy":"إذا لم تستنزه من البول ← فإنه أول ما تُحاسب به في القبر","cause":"اتَّقوا البولَ","result":"فإنَّهُ أوَّلُ ما يُحاسَبُ بِهِ العبدُ في القبرِ","explicit":true,"ref":"الترغيب والترهيب 1/116","srcLabel":"الطبراني","text":[["اتَّقوا البولَ ، ",1],["فإنَّهُ أوَّلُ ما يُحاسَبُ بِهِ العبدُ في القبرِ",2]],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه ابن أبي عاصم في ((الأوائل)) (93)، والطبراني (8/157) (7605)، والديلمي في ((الفردوس)) (301)","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"Fi32viRl"},{"id":"س-04664","fp":"e23e01167d43","stateId":654,"easy":"إذا اغتبت الناس ← تُعذّب في قبرك","cause":"إنَّ هذا كان يأكلُ لحومَ الناسِ","result":"لعله أن يُخفَّفَ عنه ما دامت هذه رطبةٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح الترغيب 2842","srcLabel":"أحمد","text":[["إنَّ هذا كان يأكلُ لحومَ الناسِ",1]," . . ثم دعا بجريدةٍ رطبةٍ فوضعها على قبرِه وقال : ",["لعله أن يُخفَّفَ عنه ما دامت هذه رطبةٌ",2]," ."],"grade":"صحيح","narrator":"يعلى بن مرة الثقفي","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (2413)، وإسماعيل الأصبهاني في ((الترغيب والترهيب)) (592) واللفظ لهما، وأحمد (17560)، وابن أبي شيبة (12044)، وابن أبي عاصم في ((الآحاد والمثاني)) (1603) باختلاف يسير.","bab":"دفن ومقابر › عذاب القبر ونعيمه","dorar":"zr9FljnH"},{"id":"س-04960","fp":"eb60d4793044","stateId":654,"easy":"إذا غللت ولو نمرة ← تُدرّع مثلها من نار","cause":"فَغلَّ نَمِرةً","result":"فدُرِّعَ علَى مثلِها منَ النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح ابن خزيمة 4/ 90","srcLabel":"النسائي","text":["كانَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ إذا صلَّى العصرَ ذَهَبَ إلى بَني عبدِ الأشهَلِ، فتحدَّثَ عندَهُم حتَّى يتحدَّثَ للمَغربِ قالَ أبو رافعٍ: فبينَما النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ مُسرعًا إلى المغرِبِ مررنا بالبقيعِ، فقالَ: أفٍّ لَكَ أفٍّ لَكَ، فَكَبرَ ذلِكَ في ذَرعي، فاستأخَرتُ وظننتُ أنَّهُ يريدُني، فقالَ: ما لَكَ؟ امشِ . فقُلتُ: أحدَثتَ حدثًا قالَ: وما لَكَ؟ قلتُ: أفَّفتَ لي قالَ: لا ولَكِنَّ هذا فلانٌ بعثتُهُ ساعيًا علَى بَني فلانٍ ",["فَغلَّ نَمِرةً",1],"، ",["فدُرِّعَ علَى مثلِها منَ النَّارِ",2]," . قالَ أبو بَكْرٍ: الغلولُ الَّذي يأخذُ منَ الغَنيمةِ على مَعنى السَّرقةِ"],"grade":"صحيح","narrator":"أبو رافع","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه النسائي (862)، وأحمد (27192)، والطبراني(1/ 323)، (962) جميعهم بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"r81ISmPO"},{"id":"س-04663","fp":"dc77fd12719d","stateId":654,"easy":"إذا صليت بغير طهور ومررت بمظلوم فلم تنصره ← يمتلئ قبرك عليك ناراً","cause":"إِنَّكَ صَلَّيْتَ صَلاةً بغيرِ طُهورٍ ، و مَرَرْتَ على مَظْلومٍ فلمْ تَنْصُرْهُ","result":"فَامْتَلأَ قَبْرُهُ عليهِ نارًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"السلسلة الصحيحة 2774","srcLabel":"الطحاوي","text":["أُمِرَ بعبدٍ من عِبادِ اللهِ أنْ يُضْرَبَ في قبرِهِ مِائةَ جَلْدَةٍ ، فلمْ يَزَلْ يَسْأَلُ و يَدْعُو حتى صارَتْ جَلْدَةً واحدةً ، ",["فَامْتَلأَ قَبْرُهُ عليهِ نارًا",2]," ، فلمَّا ارْتَفَعَ عنهُ و أفاقَ قال : على ما جَلَدْتُمُونِي ؟ قالوا :",["إِنَّكَ صَلَّيْتَ صَلاةً بغيرِ طُهورٍ ، و مَرَرْتَ على مَظْلومٍ فلمْ تَنْصُرْهُ",1]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"إسناده جيد","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (3185)، وابن عدي في ((الكامل في الضعفاء)) (7/252)، وأبو الشيخ في ((التوبيخ)) كما في ((الترغيب والترهيب)) للمنذري (3/132) باختلاف يسير","bab":"دفن ومقابر › عذاب القبر ونعيمه","dorar":"pzAbzjWj"},{"id":"س-04241","fp":"e11aa3adfb25","stateId":654,"easy":"إذا كذبت كذبة تُحمل عنك في الآفاق ← تُعذّب بها إلى يوم القيامة","cause":"رَجُلٌ كَذَّابٌ، يَكذِبُ الكِذْبةَ فتُحمَلُ عنه في الآفاقِ","result":"فهو يُصنَعُ به ما رَأَيتَ إلى يومِ القيامةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج المسند لشعيب 20165","srcLabel":"النسائي","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ إذا صَلَّى صَلاةَ الغَداةِ، أقبَلَ علينا بوَجهِه، فقال: هل رأى أحَدٌ منكم اللَّيلةَ رُؤيا؟ فإنْ كان أحَدٌ رَأى تلك اللَّيلةَ رُؤيا قَصَّها عليه، فيَقولُ فيها ما شاء اللهُ أنْ يقولَ: فسَأَلَنا يومًا، فقال: هل رأى أحَدٌ منكم اللَّيلةَ رُؤيا؟ قال: فقُلْنا: لا، قال: لكنْ أنا رَأَيتُ اللَّيلةَ رَجُلَينِ أتَياني، فأخَذا بيَدَيَّ، فأخرَجاني إلى أرضٍ فَضاءٍ -أو أرضٍ مُستَويةٍ- فمَرَّا بي على رَجُلٍ، ورَجُلٌ قائمٌ على رأسِه، بيَدِه كَلُّوبٌ مِن حَديدٍ، فيُدخِلُه في شِدْقِه، فيَشُقُّه، حتى يَبلُغَ قَفاه، ثُمَّ يُخرِجُه فيُدخِلُه في شِدْقِه الآخَرِ، ويَلتئِمُ هذا الشِّدقُ، فهو يَفعَلُ ذلك به، قُلتُ: ما هذا؟ قالا: انطلِقْ، فانطلَقتُ معهما، فإذا رَجُلٌ مُستَلقٍ على قَفاه، ورَجُلٌ قائمٌ بيَدِه فِهرٌ -أو صَخرةٌ-، فيَشدَخُ بها رأسَه، فيَتدَهدَى الحَجَرُ، فإذا ذَهَبَ ليَأخُذَه عاد رأسُه كما كان، فيَصنَعُ مِثلَ ذلك، فقُلتُ: ما هذا؟ قالا: انطلِقْ، فانطلَقتُ معهما، فإذا بَيتٌ مَبنيٌّ على بِناءِ التَّنُّورِ، أعلاه ضَيِّقٌ، وأسفلُه واسعٌ، يُوقَدُ تحته نارٌ، فإذا فيه رِجالٌ ونِساءٌ عُراةٌ، فإذا أُوقِدَتِ ارتفَعوا حتى يَكادوا أنْ يَخرُجوا، فإذا خَمَدَتْ رَجَعوا فيها، فقُلتُ: ما هذا؟ قالا لي: انطلِقْ، فانطلَقتُ، فإذا نَهرٌ مِن دَمٍ فيه رَجُلٌ، وعلى شَطِّ النَّهرِ رَجُلٌ بيْنَ يدَيه حِجارةٌ، فيُقبِلُ الرَّجُلُ الذي في النَّهرِ، فإذا دَنا ليَخرُجَ، رَمى في فيه حَجَرًا، فرَجَعَ إلى مَكانِه، فهو يَفعَلُ به ذلك، فقُلتُ: ما هذا؟ فقالا: انطلِقْ، فإذا رَوضةٌ خَضراءُ، فإذا فيها شَجرةٌ عَظيمةٌ، وإذا شَيخٌ في أصلِها حَوله حَولَه صِبْيانٌ، وإذا رَجُلٌ قَريبٌ منه بيْنَ يدَيْه نارٌ، فهو يَحشُشُها ويُوقِدُها، فصَعَدا بي في الشَّجرةِ، فأدخَلاني دارًا لم أرَ دارًا قَطُّ أحسنَ منها، فإذا فيها رِجالٌ شُيوخٌ وشَبابٌ، وفيها نِساءٌ وصِبْيانٌ، فأخرَجاني منها، فصَعَدا بي في الشَّجرةِ، فأدخَلاني دارًا هي أحسنُ وأفضلُ، فيها شُيوخٌ وشَبابٌ، فقُلتُ لهما: إنَّكما قد طَوَّفتُماني منذ اللَّيلةِ، فأخبِراني عمَّا رَأَيتُ، فقالا: نَعَمْ، أمَّا الرَّجُلُ الأوَّلُ الذي رَأَيتَ؛ فإنَّه ",["رَجُلٌ كَذَّابٌ، يَكذِبُ الكِذْبةَ فتُحمَلُ عنه في الآفاقِ",1],"، ",["فهو يُصنَعُ به ما رَأَيتَ إلى يومِ القيامةِ",2],"، ثُمَّ يَصنَعُ اللهُ به ما شاء، وأمَّا الرَّجُلُ الذي رَأَيتَ مُستَلقيًا؛ فرَجُلٌ آتاه اللهُ القُرآنَ، فنام عنه باللَّيلِ، ولم يَعمَلْ بما فيه بالنَّهارِ، فهو يُفعَلُ به ما رَأَيتَ إلى يومِ القيامةِ، وأمَّا الذي رَأَيتَ في التَّنُّورِ؛ فهم الزُّناةُ، وأمَّا الذي رَأَيتَ في النَّهرِ؛ فذاك آكِلُ الرِّبا، وأمَّا الشَّيخُ الذي رَأَيتَ في أصلِ الشَّجرةِ؛ فذاك إبراهيمُ، وأمَّا الصِّبْيانُ الذي رَأَيتَ؛ فأولادُ النَّاسِ، وأمَّا الرَّجُلُ الذي رَأَيتَ يُوقِدُ النَّارَ ويَحشُشُها؛ فذاك مالكٌ خازنُ النَّارِ، وتلك النَّارُ، وأمَّا الدَّارُ التي دَخَلتَ أوَّلًا فدارُ عامَّةِ المؤمنينَ، وأمَّا الدَّارُ الأُخرى فدارُ الشَّهداءِ، وأنا جِبريلُ، وهذا ميكائيلُ، ثُمَّ قالا لي: ارفَعْ رأسَكَ، فرَفَعتُ رأسي، فإذا كهَيئةِ السَّحابِ، فقالا لي: وتلك دارُكَ، فقُلتُ لهما: دَعاني أدخُلُ أدخُلْ داري. فقالا: إنَّه قد بَقيَ لك عملٌ لم تَستَكمِلْه، فلو استَكمَلتَه دَخَلتَ دارَكَ."],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (7658)، وأحمد (20165) واللفظ له","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"rcwKaNDn"},{"id":"س-04242","fp":"92b983d00809","stateId":654,"easy":"إذا نمت عن القرآن ليلاً ولم تعمل به نهاراً ← تُعذّب إلى يوم القيامة","cause":"فرَجُلٌ آتاه اللهُ القُرآنَ، فنام عنه باللَّيلِ، ولم يَعمَلْ بما فيه بالنَّهارِ","result":"فهو يُفعَلُ به ما رَأَيتَ إلى يومِ القيامةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج المسند لشعيب 20165","srcLabel":"النسائي","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ إذا صَلَّى صَلاةَ الغَداةِ، أقبَلَ علينا بوَجهِه، فقال: هل رأى أحَدٌ منكم اللَّيلةَ رُؤيا؟ فإنْ كان أحَدٌ رَأى تلك اللَّيلةَ رُؤيا قَصَّها عليه، فيَقولُ فيها ما شاء اللهُ أنْ يقولَ: فسَأَلَنا يومًا، فقال: هل رأى أحَدٌ منكم اللَّيلةَ رُؤيا؟ قال: فقُلْنا: لا، قال: لكنْ أنا رَأَيتُ اللَّيلةَ رَجُلَينِ أتَياني، فأخَذا بيَدَيَّ، فأخرَجاني إلى أرضٍ فَضاءٍ -أو أرضٍ مُستَويةٍ- فمَرَّا بي على رَجُلٍ، ورَجُلٌ قائمٌ على رأسِه، بيَدِه كَلُّوبٌ مِن حَديدٍ، فيُدخِلُه في شِدْقِه، فيَشُقُّه، حتى يَبلُغَ قَفاه، ثُمَّ يُخرِجُه فيُدخِلُه في شِدْقِه الآخَرِ، ويَلتئِمُ هذا الشِّدقُ، فهو يَفعَلُ ذلك به، قُلتُ: ما هذا؟ قالا: انطلِقْ، فانطلَقتُ معهما، فإذا رَجُلٌ مُستَلقٍ على قَفاه، ورَجُلٌ قائمٌ بيَدِه فِهرٌ -أو صَخرةٌ-، فيَشدَخُ بها رأسَه، فيَتدَهدَى الحَجَرُ، فإذا ذَهَبَ ليَأخُذَه عاد رأسُه كما كان، فيَصنَعُ مِثلَ ذلك، فقُلتُ: ما هذا؟ قالا: انطلِقْ، فانطلَقتُ معهما، فإذا بَيتٌ مَبنيٌّ على بِناءِ التَّنُّورِ، أعلاه ضَيِّقٌ، وأسفلُه واسعٌ، يُوقَدُ تحته نارٌ، فإذا فيه رِجالٌ ونِساءٌ عُراةٌ، فإذا أُوقِدَتِ ارتفَعوا حتى يَكادوا أنْ يَخرُجوا، فإذا خَمَدَتْ رَجَعوا فيها، فقُلتُ: ما هذا؟ قالا لي: انطلِقْ، فانطلَقتُ، فإذا نَهرٌ مِن دَمٍ فيه رَجُلٌ، وعلى شَطِّ النَّهرِ رَجُلٌ بيْنَ يدَيه حِجارةٌ، فيُقبِلُ الرَّجُلُ الذي في النَّهرِ، فإذا دَنا ليَخرُجَ، رَمى في فيه حَجَرًا، فرَجَعَ إلى مَكانِه، فهو يَفعَلُ به ذلك، فقُلتُ: ما هذا؟ فقالا: انطلِقْ، فإذا رَوضةٌ خَضراءُ، فإذا فيها شَجرةٌ عَظيمةٌ، وإذا شَيخٌ في أصلِها حَوله حَولَه صِبْيانٌ، وإذا رَجُلٌ قَريبٌ منه بيْنَ يدَيْه نارٌ، فهو يَحشُشُها ويُوقِدُها، فصَعَدا بي في الشَّجرةِ، فأدخَلاني دارًا لم أرَ دارًا قَطُّ أحسنَ منها، فإذا فيها رِجالٌ شُيوخٌ وشَبابٌ، وفيها نِساءٌ وصِبْيانٌ، فأخرَجاني منها، فصَعَدا بي في الشَّجرةِ، فأدخَلاني دارًا هي أحسنُ وأفضلُ، فيها شُيوخٌ وشَبابٌ، فقُلتُ لهما: إنَّكما قد طَوَّفتُماني منذ اللَّيلةِ، فأخبِراني عمَّا رَأَيتُ، فقالا: نَعَمْ، أمَّا الرَّجُلُ الأوَّلُ الذي رَأَيتَ؛ فإنَّه رَجُلٌ كَذَّابٌ، يَكذِبُ الكِذْبةَ فتُحمَلُ عنه في الآفاقِ، فهو يُصنَعُ به ما رَأَيتَ إلى يومِ القيامةِ، ثُمَّ يَصنَعُ اللهُ به ما شاء، وأمَّا الرَّجُلُ الذي رَأَيتَ مُستَلقيًا؛ ",["فرَجُلٌ آتاه اللهُ القُرآنَ، فنام عنه باللَّيلِ، ولم يَعمَلْ بما فيه بالنَّهارِ",1],"، ",["فهو يُفعَلُ به ما رَأَيتَ إلى يومِ القيامةِ",2],"، وأمَّا الذي رَأَيتَ في التَّنُّورِ؛ فهم الزُّناةُ، وأمَّا الذي رَأَيتَ في النَّهرِ؛ فذاك آكِلُ الرِّبا، وأمَّا الشَّيخُ الذي رَأَيتَ في أصلِ الشَّجرةِ؛ فذاك إبراهيمُ، وأمَّا الصِّبْيانُ الذي رَأَيتَ؛ فأولادُ النَّاسِ، وأمَّا الرَّجُلُ الذي رَأَيتَ يُوقِدُ النَّارَ ويَحشُشُها؛ فذاك مالكٌ خازنُ النَّارِ، وتلك النَّارُ، وأمَّا الدَّارُ التي دَخَلتَ أوَّلًا فدارُ عامَّةِ المؤمنينَ، وأمَّا الدَّارُ الأُخرى فدارُ الشَّهداءِ، وأنا جِبريلُ، وهذا ميكائيلُ، ثُمَّ قالا لي: ارفَعْ رأسَكَ، فرَفَعتُ رأسي، فإذا كهَيئةِ السَّحابِ، فقالا لي: وتلك دارُكَ، فقُلتُ لهما: دَعاني أدخُلُ أدخُلْ داري. فقالا: إنَّه قد بَقيَ لك عملٌ لم تَستَكمِلْه، فلو استَكمَلتَه دَخَلتَ دارَكَ."],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (7658)، وأحمد (20165) واللفظ له","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"rcwKaNDn"},{"id":"س-04243","fp":"bd57238b53ed","stateId":654,"easy":"إذا زنيت ← تُعذّب في التنور","cause":"فهم الزُّناةُ","result":"وأمَّا الذي رَأَيتَ في التَّنُّورِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج المسند لشعيب 20165","srcLabel":"النسائي","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ إذا صَلَّى صَلاةَ الغَداةِ، أقبَلَ علينا بوَجهِه، فقال: هل رأى أحَدٌ منكم اللَّيلةَ رُؤيا؟ فإنْ كان أحَدٌ رَأى تلك اللَّيلةَ رُؤيا قَصَّها عليه، فيَقولُ فيها ما شاء اللهُ أنْ يقولَ: فسَأَلَنا يومًا، فقال: هل رأى أحَدٌ منكم اللَّيلةَ رُؤيا؟ قال: فقُلْنا: لا، قال: لكنْ أنا رَأَيتُ اللَّيلةَ رَجُلَينِ أتَياني، فأخَذا بيَدَيَّ، فأخرَجاني إلى أرضٍ فَضاءٍ -أو أرضٍ مُستَويةٍ- فمَرَّا بي على رَجُلٍ، ورَجُلٌ قائمٌ على رأسِه، بيَدِه كَلُّوبٌ مِن حَديدٍ، فيُدخِلُه في شِدْقِه، فيَشُقُّه، حتى يَبلُغَ قَفاه، ثُمَّ يُخرِجُه فيُدخِلُه في شِدْقِه الآخَرِ، ويَلتئِمُ هذا الشِّدقُ، فهو يَفعَلُ ذلك به، قُلتُ: ما هذا؟ قالا: انطلِقْ، فانطلَقتُ معهما، فإذا رَجُلٌ مُستَلقٍ على قَفاه، ورَجُلٌ قائمٌ بيَدِه فِهرٌ -أو صَخرةٌ-، فيَشدَخُ بها رأسَه، فيَتدَهدَى الحَجَرُ، فإذا ذَهَبَ ليَأخُذَه عاد رأسُه كما كان، فيَصنَعُ مِثلَ ذلك، فقُلتُ: ما هذا؟ قالا: انطلِقْ، فانطلَقتُ معهما، فإذا بَيتٌ مَبنيٌّ على بِناءِ التَّنُّورِ، أعلاه ضَيِّقٌ، وأسفلُه واسعٌ، يُوقَدُ تحته نارٌ، فإذا فيه رِجالٌ ونِساءٌ عُراةٌ، فإذا أُوقِدَتِ ارتفَعوا حتى يَكادوا أنْ يَخرُجوا، فإذا خَمَدَتْ رَجَعوا فيها، فقُلتُ: ما هذا؟ قالا لي: انطلِقْ، فانطلَقتُ، فإذا نَهرٌ مِن دَمٍ فيه رَجُلٌ، وعلى شَطِّ النَّهرِ رَجُلٌ بيْنَ يدَيه حِجارةٌ، فيُقبِلُ الرَّجُلُ الذي في النَّهرِ، فإذا دَنا ليَخرُجَ، رَمى في فيه حَجَرًا، فرَجَعَ إلى مَكانِه، فهو يَفعَلُ به ذلك، فقُلتُ: ما هذا؟ فقالا: انطلِقْ، فإذا رَوضةٌ خَضراءُ، فإذا فيها شَجرةٌ عَظيمةٌ، وإذا شَيخٌ في أصلِها حَوله حَولَه صِبْيانٌ، وإذا رَجُلٌ قَريبٌ منه بيْنَ يدَيْه نارٌ، فهو يَحشُشُها ويُوقِدُها، فصَعَدا بي في الشَّجرةِ، فأدخَلاني دارًا لم أرَ دارًا قَطُّ أحسنَ منها، فإذا فيها رِجالٌ شُيوخٌ وشَبابٌ، وفيها نِساءٌ وصِبْيانٌ، فأخرَجاني منها، فصَعَدا بي في الشَّجرةِ، فأدخَلاني دارًا هي أحسنُ وأفضلُ، فيها شُيوخٌ وشَبابٌ، فقُلتُ لهما: إنَّكما قد طَوَّفتُماني منذ اللَّيلةِ، فأخبِراني عمَّا رَأَيتُ، فقالا: نَعَمْ، أمَّا الرَّجُلُ الأوَّلُ الذي رَأَيتَ؛ فإنَّه رَجُلٌ كَذَّابٌ، يَكذِبُ الكِذْبةَ فتُحمَلُ عنه في الآفاقِ، فهو يُصنَعُ به ما رَأَيتَ إلى يومِ القيامةِ، ثُمَّ يَصنَعُ اللهُ به ما شاء، وأمَّا الرَّجُلُ الذي رَأَيتَ مُستَلقيًا؛ فرَجُلٌ آتاه اللهُ القُرآنَ، فنام عنه باللَّيلِ، ولم يَعمَلْ بما فيه بالنَّهارِ، فهو يُفعَلُ به ما رَأَيتَ إلى يومِ القيامةِ، ",["وأمَّا الذي رَأَيتَ في التَّنُّورِ",2],"؛ ",["فهم الزُّناةُ",1],"، وأمَّا الذي رَأَيتَ في النَّهرِ؛ فذاك آكِلُ الرِّبا، وأمَّا الشَّيخُ الذي رَأَيتَ في أصلِ الشَّجرةِ؛ فذاك إبراهيمُ، وأمَّا الصِّبْيانُ الذي رَأَيتَ؛ فأولادُ النَّاسِ، وأمَّا الرَّجُلُ الذي رَأَيتَ يُوقِدُ النَّارَ ويَحشُشُها؛ فذاك مالكٌ خازنُ النَّارِ، وتلك النَّارُ، وأمَّا الدَّارُ التي دَخَلتَ أوَّلًا فدارُ عامَّةِ المؤمنينَ، وأمَّا الدَّارُ الأُخرى فدارُ الشَّهداءِ، وأنا جِبريلُ، وهذا ميكائيلُ، ثُمَّ قالا لي: ارفَعْ رأسَكَ، فرَفَعتُ رأسي، فإذا كهَيئةِ السَّحابِ، فقالا لي: وتلك دارُكَ، فقُلتُ لهما: دَعاني أدخُلُ أدخُلْ داري. فقالا: إنَّه قد بَقيَ لك عملٌ لم تَستَكمِلْه، فلو استَكمَلتَه دَخَلتَ دارَكَ."],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (7658)، وأحمد (20165) واللفظ له","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"rcwKaNDn"},{"id":"س-04244","fp":"39398bc0434e","stateId":654,"easy":"إذا أكلت الربا ← تُعذّب في نهر الدم","cause":"فذاك آكِلُ الرِّبا","result":"وأمَّا الذي رَأَيتَ في النَّهرِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج المسند لشعيب 20165","srcLabel":"النسائي","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ إذا صَلَّى صَلاةَ الغَداةِ، أقبَلَ علينا بوَجهِه، فقال: هل رأى أحَدٌ منكم اللَّيلةَ رُؤيا؟ فإنْ كان أحَدٌ رَأى تلك اللَّيلةَ رُؤيا قَصَّها عليه، فيَقولُ فيها ما شاء اللهُ أنْ يقولَ: فسَأَلَنا يومًا، فقال: هل رأى أحَدٌ منكم اللَّيلةَ رُؤيا؟ قال: فقُلْنا: لا، قال: لكنْ أنا رَأَيتُ اللَّيلةَ رَجُلَينِ أتَياني، فأخَذا بيَدَيَّ، فأخرَجاني إلى أرضٍ فَضاءٍ -أو أرضٍ مُستَويةٍ- فمَرَّا بي على رَجُلٍ، ورَجُلٌ قائمٌ على رأسِه، بيَدِه كَلُّوبٌ مِن حَديدٍ، فيُدخِلُه في شِدْقِه، فيَشُقُّه، حتى يَبلُغَ قَفاه، ثُمَّ يُخرِجُه فيُدخِلُه في شِدْقِه الآخَرِ، ويَلتئِمُ هذا الشِّدقُ، فهو يَفعَلُ ذلك به، قُلتُ: ما هذا؟ قالا: انطلِقْ، فانطلَقتُ معهما، فإذا رَجُلٌ مُستَلقٍ على قَفاه، ورَجُلٌ قائمٌ بيَدِه فِهرٌ -أو صَخرةٌ-، فيَشدَخُ بها رأسَه، فيَتدَهدَى الحَجَرُ، فإذا ذَهَبَ ليَأخُذَه عاد رأسُه كما كان، فيَصنَعُ مِثلَ ذلك، فقُلتُ: ما هذا؟ قالا: انطلِقْ، فانطلَقتُ معهما، فإذا بَيتٌ مَبنيٌّ على بِناءِ التَّنُّورِ، أعلاه ضَيِّقٌ، وأسفلُه واسعٌ، يُوقَدُ تحته نارٌ، فإذا فيه رِجالٌ ونِساءٌ عُراةٌ، فإذا أُوقِدَتِ ارتفَعوا حتى يَكادوا أنْ يَخرُجوا، فإذا خَمَدَتْ رَجَعوا فيها، فقُلتُ: ما هذا؟ قالا لي: انطلِقْ، فانطلَقتُ، فإذا نَهرٌ مِن دَمٍ فيه رَجُلٌ، وعلى شَطِّ النَّهرِ رَجُلٌ بيْنَ يدَيه حِجارةٌ، فيُقبِلُ الرَّجُلُ الذي في النَّهرِ، فإذا دَنا ليَخرُجَ، رَمى في فيه حَجَرًا، فرَجَعَ إلى مَكانِه، فهو يَفعَلُ به ذلك، فقُلتُ: ما هذا؟ فقالا: انطلِقْ، فإذا رَوضةٌ خَضراءُ، فإذا فيها شَجرةٌ عَظيمةٌ، وإذا شَيخٌ في أصلِها حَوله حَولَه صِبْيانٌ، وإذا رَجُلٌ قَريبٌ منه بيْنَ يدَيْه نارٌ، فهو يَحشُشُها ويُوقِدُها، فصَعَدا بي في الشَّجرةِ، فأدخَلاني دارًا لم أرَ دارًا قَطُّ أحسنَ منها، فإذا فيها رِجالٌ شُيوخٌ وشَبابٌ، وفيها نِساءٌ وصِبْيانٌ، فأخرَجاني منها، فصَعَدا بي في الشَّجرةِ، فأدخَلاني دارًا هي أحسنُ وأفضلُ، فيها شُيوخٌ وشَبابٌ، فقُلتُ لهما: إنَّكما قد طَوَّفتُماني منذ اللَّيلةِ، فأخبِراني عمَّا رَأَيتُ، فقالا: نَعَمْ، أمَّا الرَّجُلُ الأوَّلُ الذي رَأَيتَ؛ فإنَّه رَجُلٌ كَذَّابٌ، يَكذِبُ الكِذْبةَ فتُحمَلُ عنه في الآفاقِ، فهو يُصنَعُ به ما رَأَيتَ إلى يومِ القيامةِ، ثُمَّ يَصنَعُ اللهُ به ما شاء، وأمَّا الرَّجُلُ الذي رَأَيتَ مُستَلقيًا؛ فرَجُلٌ آتاه اللهُ القُرآنَ، فنام عنه باللَّيلِ، ولم يَعمَلْ بما فيه بالنَّهارِ، فهو يُفعَلُ به ما رَأَيتَ إلى يومِ القيامةِ، وأمَّا الذي رَأَيتَ في التَّنُّورِ؛ فهم الزُّناةُ، ",["وأمَّا الذي رَأَيتَ في النَّهرِ",2],"؛ ",["فذاك آكِلُ الرِّبا",1],"، وأمَّا الشَّيخُ الذي رَأَيتَ في أصلِ الشَّجرةِ؛ فذاك إبراهيمُ، وأمَّا الصِّبْيانُ الذي رَأَيتَ؛ فأولادُ النَّاسِ، وأمَّا الرَّجُلُ الذي رَأَيتَ يُوقِدُ النَّارَ ويَحشُشُها؛ فذاك مالكٌ خازنُ النَّارِ، وتلك النَّارُ، وأمَّا الدَّارُ التي دَخَلتَ أوَّلًا فدارُ عامَّةِ المؤمنينَ، وأمَّا الدَّارُ الأُخرى فدارُ الشَّهداءِ، وأنا جِبريلُ، وهذا ميكائيلُ، ثُمَّ قالا لي: ارفَعْ رأسَكَ، فرَفَعتُ رأسي، فإذا كهَيئةِ السَّحابِ، فقالا لي: وتلك دارُكَ، فقُلتُ لهما: دَعاني أدخُلُ أدخُلْ داري. فقالا: إنَّه قد بَقيَ لك عملٌ لم تَستَكمِلْه، فلو استَكمَلتَه دَخَلتَ دارَكَ."],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (7658)، وأحمد (20165) واللفظ له","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"rcwKaNDn"},{"id":"س-04557","fp":"a341e0b19b4c","stateId":654,"easy":"إذا أفطرت قبل تحلة صومك ← تُعلّق بعراقيبك مشققة أشداقك","cause":"الَّذينَ يُفطِرونَ قبلَ تَحلَّةِ صَومِهِم","result":"مُعلَقِينَ بعراقيبِهِم ، مُشَقَّقَةٌ أشداقُهُم ، تسيلُ أشداقُهُم دمًا","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"similar":["س-08243"],"ref":"صحيح الترغيب 2393","srcLabel":"النسائي","text":["بَينا أنا نائمٌ أتاني رجلانِ ، فأخذا بِضَبْعَيَّ فأتَيا بي جبلًا وعْرًا ، فقالا : اصعدْ . فقلتُ : إنِّي لا أُطيقُهُ . فقال : إنَّا سَنُسَهِّلُهُ لكَ . فصعدتُ ، حتَّى إذا كنتُ في سَواءِ الجبلِ إذا بأصواتٍ شديدةٍ . قلتُ : ما هذهِ الأصواتُ ؟ قالوا : هذا عُوَاءُ أهلِ النَّارِ ثمَّ انْطُلِقَ بي فإذا أنا بقَومٍ ",["مُعلَقِينَ بعراقيبِهِم ، مُشَقَّقَةٌ أشداقُهُم ، تسيلُ أشداقُهُم دمًا",2]," . قال : قلتُ : مَن هؤلاءِ ؟ قال : ",["الَّذينَ يُفطِرونَ قبلَ تَحلَّةِ صَومِهِم",1]," . فقال : خابتِ اليهودُ والنَّصارَى فقال سُلَيمُ : ما أدري أسمِعَهُ أبو أُمامَةَ مِن رسولِ اللهِ أم شيءٌ مِن رأْيِهِ ثمَّ انطلقَ بي ، فإذا أنا بقَومٍ أشدَّ شيءٍ انتفاخًا ، وأنتَنَهُ ريحًا ، وأسوأهُ مَنظرًا . فقلتُ : مَن هؤلاءِ ؟ فقال : هؤلاءِ قتلَى الكفَّارِ . ثمَّ انطلقَ بي فإذا أنا بقَومٍ أشدَّ شيءٍ انتفاخًا ، وأنتَنَهُ ريحًا ، كأنَّ ريحَهُم المَراحيضُ . قلتُ : مَن هؤلاءِ ؟ قال : هؤلاءِ الزَّانونَ والزَّواني . ثمَّ انطلقَ بي فإذا أنا بنساءٍ تنهشُ ثديَهُنَّ الحيَّاتُ . قلتُ : ما بالُ هؤلاءِ ؟ قيلَ : هؤلاءِ يمنعَنَ أولادَهنَّ ألبانَهنَّ . ثمَّ انطلقَ بي فإذا أنا بغِلمانٍ يلعبونَ بينَ نهرَينِ . قلتُ : مَن هؤلاءِ ؟ قيلَ : هؤلاءِ ذراريُّ المؤمنينَ . ثمَّ شرفَ بي شرفًا ، فإذا أنا بثلاثةٍ يشربونَ مِن خمرٍ لهُم . قلتُ : مَن هؤلاءِ ؟ قال : هؤلاءِ جعفرٌ ، وزيدٌ ، وابنُ رَواحةَ . ثمَّ شرفَ بي شرفًا آخرَ ، فإذا أنا بنفرٍ ثلاثةٍ . قلتُ : مَن هؤلاءِ ؟ قال : هذا إبراهيمُ ، وموسَى ، وعيسَى ، وهُم ينتظرونَكَ"],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبري)) (3286) مختصراً، وابن خزيمة (1986)، وابن حبان (7491) باختلاف يسير.","bab":"جهنم › صفة عذاب أهل النار","dorar":"JTrPX6Y6"},{"id":"س-04558","fp":"aaae00553c3b","stateId":654,"easy":"إذا زنيت ← تُعذّب منتفخاً منتن الريح","cause":"الزَّانونَ والزَّواني","result":"أشدَّ شيءٍ انتفاخًا ، وأنتَنَهُ ريحًا ، كأنَّ ريحَهُم المَراحيضُ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح الترغيب 2393","srcLabel":"النسائي","text":["بَينا أنا نائمٌ أتاني رجلانِ ، فأخذا بِضَبْعَيَّ فأتَيا بي جبلًا وعْرًا ، فقالا : اصعدْ . فقلتُ : إنِّي لا أُطيقُهُ . فقال : إنَّا سَنُسَهِّلُهُ لكَ . فصعدتُ ، حتَّى إذا كنتُ في سَواءِ الجبلِ إذا بأصواتٍ شديدةٍ . قلتُ : ما هذهِ الأصواتُ ؟ قالوا : هذا عُوَاءُ أهلِ النَّارِ ثمَّ انْطُلِقَ بي فإذا أنا بقَومٍ مُعلَقِينَ بعراقيبِهِم ، مُشَقَّقَةٌ أشداقُهُم ، تسيلُ أشداقُهُم دمًا . قال : قلتُ : مَن هؤلاءِ ؟ قال : الَّذينَ يُفطِرونَ قبلَ تَحلَّةِ صَومِهِم . فقال : خابتِ اليهودُ والنَّصارَى فقال سُلَيمُ : ما أدري أسمِعَهُ أبو أُمامَةَ مِن رسولِ اللهِ أم شيءٌ مِن رأْيِهِ ثمَّ انطلقَ بي ، فإذا أنا بقَومٍ أشدَّ شيءٍ انتفاخًا ، وأنتَنَهُ ريحًا ، وأسوأهُ مَنظرًا . فقلتُ : مَن هؤلاءِ ؟ فقال : هؤلاءِ قتلَى الكفَّارِ . ثمَّ انطلقَ بي فإذا أنا بقَومٍ ",["أشدَّ شيءٍ انتفاخًا ، وأنتَنَهُ ريحًا ، كأنَّ ريحَهُم المَراحيضُ",2]," . قلتُ : مَن هؤلاءِ ؟ قال : هؤلاءِ ",["الزَّانونَ والزَّواني",1]," . ثمَّ انطلقَ بي فإذا أنا بنساءٍ تنهشُ ثديَهُنَّ الحيَّاتُ . قلتُ : ما بالُ هؤلاءِ ؟ قيلَ : هؤلاءِ يمنعَنَ أولادَهنَّ ألبانَهنَّ . ثمَّ انطلقَ بي فإذا أنا بغِلمانٍ يلعبونَ بينَ نهرَينِ . قلتُ : مَن هؤلاءِ ؟ قيلَ : هؤلاءِ ذراريُّ المؤمنينَ . ثمَّ شرفَ بي شرفًا ، فإذا أنا بثلاثةٍ يشربونَ مِن خمرٍ لهُم . قلتُ : مَن هؤلاءِ ؟ قال : هؤلاءِ جعفرٌ ، وزيدٌ ، وابنُ رَواحةَ . ثمَّ شرفَ بي شرفًا آخرَ ، فإذا أنا بنفرٍ ثلاثةٍ . قلتُ : مَن هؤلاءِ ؟ قال : هذا إبراهيمُ ، وموسَى ، وعيسَى ، وهُم ينتظرونَكَ"],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبري)) (3286) مختصراً، وابن خزيمة (1986)، وابن حبان (7491) باختلاف يسير.","bab":"جهنم › صفة عذاب أهل النار","dorar":"JTrPX6Y6"},{"id":"س-06769","fp":"d7baaee4582e","stateId":654,"easy":"إذا بلت فلم ترتد لبولك (لم تتحرز) ← تُعذّب","cause":"إنَّ بَني إسرائيلَ كانوا إذا أصابَهم البَولُ قَرَضوه بالمِقراضَينِ","result":"فإذا بال أحَدُكم فليَرتَدْ لبَولِه","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[13],"ref":"تخريج المسند لشعيب 19568","srcLabel":"أبو داود","text":["مال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ إلى دَمْثٍ إلى جَنبِ حائطٍ، فبال. قال شُعبةُ: فقُلتُ لأبي التَّيَّاحِ: جالسًا؟ قال: لا أدري، قال: فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["إنَّ بَني إسرائيلَ كانوا إذا أصابَهم البَولُ قَرَضوه بالمِقراضَينِ",1],"، ",["فإذا بال أحَدُكم فليَرتَدْ لبَولِه",2],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح لغيره دون قوله: \"فإذا بال أحدكم ... \"","takhrij":"أخرجه أبو داود (3)، وأحمد (19568) واللفظ له","bab":"طهارة › إبعاد المتخلي واستتاره","dorar":"0rfUFZ4t"},{"id":"س-08240","fp":"fb421dde390e","stateId":654,"easy":"إذا قلت ما لا تعلم ← تُشقق أشداقك (رؤيا)","cause":"الذين يقولون ما لا يعلمون","result":"برجالٍ ونِساءٍ مُشَقَّقةٍ أشداقُهم","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"سبل الهدى والرشاد 7/265","srcLabel":"الحاكم","text":["خرج علينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بعدَ صلاةِ الصُّبحِ، فقال: «إني رأيتُ رؤيا هي حَقٌّ تَعقِلونها، أتاني جبريلُ عليه السَّلامُ، فأخذ بيدي، فاستتبَعَني حتى أتى بي جبَلًا طويلًا وَعرًا، فقال لي: ارْقَ، فقُلتُ: لا أستطيعُ، فقال: سأسَهِّلُه لك، فجعلتُ كلَّما رَقَت قدمي وضعتُها على دَرَجةٍ، حتى استوينا على سواءِ الجَبَلِ، فانطلَقنا فإذا نحن ",["برجالٍ ونِساءٍ مُشَقَّقةٍ أشداقُهم",2],"، فقُلتُ: من هؤلاء؟ قال: هؤلاء ",["الذين يقولون ما لا يعلمون",1],"، ثمَّ انطلقنا فإذا نحن برجالٍ ونِساءٍ ممدودةٍ أعينُهم وآذانُهم، قُلتُ: ما هؤلاء؟ قال: الذين يُرون أعيُنَهم ما لا يرون، ويُسمِعون آذانَهم ما لا يسمعون، ثمَّ انطلَقنا فإذا نحن بنساءٍ مُعَلَّقاتٍ بعراقيبِهنَّ، مصوَّبةٍ رؤوسُهنَّ، تنهَشُ أثداءَهن الحيَّاتُ، فقُلتُ: ما هؤلاء؟ قال: الذين يمنَعْنَ أولادَهم من ألبانِهنَّ، ثمَّ انطلَقنا فإذا نحن برجالٍ ونساءٍ مُعَلَّقاتٍ بعراقيبِهنَّ، مُصَوَّباتٍ رُؤوسُهنَّ، يَلحَسنَ من ماءٍ قَليلٍ وحمأةٍ، قُلتُ: ما هؤلاء؟ قال: الذين يصومون ويُفطِرون قَبلَ تحِلَّةِ صَومِهم، ثمَّ انطلقنا فإذا نحن برجالٍ ونساءٍ أقبَحِ شيءٍ مَنظَرًا وأقبَحِه لَبوسًا، وأنتَنِه ريحًا، كأنما ريحُهم المراحيضُ، قُلتُ: ما هؤلاء؟ قال: هؤلاء الزَّانون والزُّناة، ثمَّ انطلقنا فإذا نحن بموتى أشدِّ شيءٍ انتفاخًا وأنتَنِه ريحًا، قُلتُ: ما هؤلاء؟ قال: هؤلاء موتى الكُفَّارِ، ثمَّ انطلقنا فإذا نحن نرى دُخانًا، ونسمَعُ عِواءً، قُلتُ: ما هذا؟ قال: هذه جهنَّمُ فدعها، ثمَّ انطلقنا فإذا نحن برجالٍ نيامٍ تحتَ ظِلالِ الشَّجَرةِ، قُلتُ: ما هؤلاء؟ قال: هؤلاء موتى المسلمين، ثمَّ انطلَقنا فإذا نحن بجَوارٍ وغِلمانٍ أحسَنِ شَيءٍ وَجهًا، وأحسَنِه لَبوسًا، وأطيَبِه ريحًا، كأنَّ وُجوهَهم القراطيسُ، قُلتُ ما هؤلاء؟ قال: هؤلاء الصِّدِّيقون والشُّهَداءُ والصَّالحون، ثمَّ انطلقنا فإذا نحن بثلاثةِ نَفَرٍ يَشرَبون خمرًا، ويلعبون، فقُلتُ: ما هؤلاء؟ فقال: ذاك زيدُ بنُ حارِثةَ، وجعفَرٌ، وابنُ رَواحةَ، فمِلتُ قِبَلَهم، فقالوا: قُدنا لك، قُدنا لك، ثمَّ رفعتُ رأسي، فإذا ثلاثةُ نَفَرٍ تحتَ العَرشِ، قُلتُ: ما هؤلاء؟ قال: ذاك أبوك إبراهيمُ وموسى وعيسى، عليهم السَّلامُ، وهم ينتَظِرونك، صلواتُ اللهِ وسلامُه عليهم أجمعين»"],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"[رجاله] رجال الصحيح","takhrij":"أخرجه الطبراني في ((الشاميين)) (1966) باختلاف يسير، وابن خزيمة (1986)، والحاكم (2837) بنحوه.","bab":"ملائكة › فضل جبريل","dorar":"jPNaFG9n"},{"id":"س-08241","fp":"a78a0e4a5b26","stateId":654,"easy":"إذا ادّعيت رؤية ما لم ترَ وسماع ما لم تسمع ← تُمدّ عيناك وأذناك (رؤيا)","cause":"الذين يُرون أعيُنَهم ما لا يرون، ويُسمِعون آذانَهم ما لا يسمعون","result":"برجالٍ ونِساءٍ ممدودةٍ أعينُهم وآذانُهم","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"سبل الهدى والرشاد 7/265","srcLabel":"الحاكم","text":["خرج علينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بعدَ صلاةِ الصُّبحِ، فقال: «إني رأيتُ رؤيا هي حَقٌّ تَعقِلونها، أتاني جبريلُ عليه السَّلامُ، فأخذ بيدي، فاستتبَعَني حتى أتى بي جبَلًا طويلًا وَعرًا، فقال لي: ارْقَ، فقُلتُ: لا أستطيعُ، فقال: سأسَهِّلُه لك، فجعلتُ كلَّما رَقَت قدمي وضعتُها على دَرَجةٍ، حتى استوينا على سواءِ الجَبَلِ، فانطلَقنا فإذا نحن برجالٍ ونِساءٍ مُشَقَّقةٍ أشداقُهم، فقُلتُ: من هؤلاء؟ قال: هؤلاء الذين يقولون ما لا يعلمون، ثمَّ انطلقنا فإذا نحن ",["برجالٍ ونِساءٍ ممدودةٍ أعينُهم وآذانُهم",2],"، قُلتُ: ما هؤلاء؟ قال: ",["الذين يُرون أعيُنَهم ما لا يرون، ويُسمِعون آذانَهم ما لا يسمعون",1],"، ثمَّ انطلَقنا فإذا نحن بنساءٍ مُعَلَّقاتٍ بعراقيبِهنَّ، مصوَّبةٍ رؤوسُهنَّ، تنهَشُ أثداءَهن الحيَّاتُ، فقُلتُ: ما هؤلاء؟ قال: الذين يمنَعْنَ أولادَهم من ألبانِهنَّ، ثمَّ انطلَقنا فإذا نحن برجالٍ ونساءٍ مُعَلَّقاتٍ بعراقيبِهنَّ، مُصَوَّباتٍ رُؤوسُهنَّ، يَلحَسنَ من ماءٍ قَليلٍ وحمأةٍ، قُلتُ: ما هؤلاء؟ قال: الذين يصومون ويُفطِرون قَبلَ تحِلَّةِ صَومِهم، ثمَّ انطلقنا فإذا نحن برجالٍ ونساءٍ أقبَحِ شيءٍ مَنظَرًا وأقبَحِه لَبوسًا، وأنتَنِه ريحًا، كأنما ريحُهم المراحيضُ، قُلتُ: ما هؤلاء؟ قال: هؤلاء الزَّانون والزُّناة، ثمَّ انطلقنا فإذا نحن بموتى أشدِّ شيءٍ انتفاخًا وأنتَنِه ريحًا، قُلتُ: ما هؤلاء؟ قال: هؤلاء موتى الكُفَّارِ، ثمَّ انطلقنا فإذا نحن نرى دُخانًا، ونسمَعُ عِواءً، قُلتُ: ما هذا؟ قال: هذه جهنَّمُ فدعها، ثمَّ انطلقنا فإذا نحن برجالٍ نيامٍ تحتَ ظِلالِ الشَّجَرةِ، قُلتُ: ما هؤلاء؟ قال: هؤلاء موتى المسلمين، ثمَّ انطلَقنا فإذا نحن بجَوارٍ وغِلمانٍ أحسَنِ شَيءٍ وَجهًا، وأحسَنِه لَبوسًا، وأطيَبِه ريحًا، كأنَّ وُجوهَهم القراطيسُ، قُلتُ ما هؤلاء؟ قال: هؤلاء الصِّدِّيقون والشُّهَداءُ والصَّالحون، ثمَّ انطلقنا فإذا نحن بثلاثةِ نَفَرٍ يَشرَبون خمرًا، ويلعبون، فقُلتُ: ما هؤلاء؟ فقال: ذاك زيدُ بنُ حارِثةَ، وجعفَرٌ، وابنُ رَواحةَ، فمِلتُ قِبَلَهم، فقالوا: قُدنا لك، قُدنا لك، ثمَّ رفعتُ رأسي، فإذا ثلاثةُ نَفَرٍ تحتَ العَرشِ، قُلتُ: ما هؤلاء؟ قال: ذاك أبوك إبراهيمُ وموسى وعيسى، عليهم السَّلامُ، وهم ينتَظِرونك، صلواتُ اللهِ وسلامُه عليهم أجمعين»"],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"[رجاله] رجال الصحيح","takhrij":"أخرجه الطبراني في ((الشاميين)) (1966) باختلاف يسير، وابن خزيمة (1986)، والحاكم (2837) بنحوه.","bab":"ملائكة › فضل جبريل","dorar":"jPNaFG9n"},{"id":"س-08242","fp":"29e26a541bea","stateId":654,"easy":"إذا منعت المرأة أولادها لبنها ← تُعلّق بعراقيبها وتنهش ثدييها الحيات (رؤيا)","cause":"الذين يمنَعْنَ أولادَهم من ألبانِهنَّ","result":"بنساءٍ مُعَلَّقاتٍ بعراقيبِهنَّ، مصوَّبةٍ رؤوسُهنَّ، تنهَشُ أثداءَهن الحيَّاتُ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-04559","otherNeedIds":[37],"ref":"سبل الهدى والرشاد 7/265","text":["خرج علينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بعدَ صلاةِ الصُّبحِ، فقال: «إني رأيتُ رؤيا هي حَقٌّ تَعقِلونها، أتاني جبريلُ عليه السَّلامُ، فأخذ بيدي، فاستتبَعَني حتى أتى بي جبَلًا طويلًا وَعرًا، فقال لي: ارْقَ، فقُلتُ: لا أستطيعُ، فقال: سأسَهِّلُه لك، فجعلتُ كلَّما رَقَت قدمي وضعتُها على دَرَجةٍ، حتى استوينا على سواءِ الجَبَلِ، فانطلَقنا فإذا نحن برجالٍ ونِساءٍ مُشَقَّقةٍ أشداقُهم، فقُلتُ: من هؤلاء؟ قال: هؤلاء الذين يقولون ما لا يعلمون، ثمَّ انطلقنا فإذا نحن برجالٍ ونِساءٍ ممدودةٍ أعينُهم وآذانُهم، قُلتُ: ما هؤلاء؟ قال: الذين يُرون أعيُنَهم ما لا يرون، ويُسمِعون آذانَهم ما لا يسمعون، ثمَّ انطلَقنا فإذا نحن ",["بنساءٍ مُعَلَّقاتٍ بعراقيبِهنَّ، مصوَّبةٍ رؤوسُهنَّ، تنهَشُ أثداءَهن الحيَّاتُ",2],"، فقُلتُ: ما هؤلاء؟ قال: ",["الذين يمنَعْنَ أولادَهم من ألبانِهنَّ",1],"، ثمَّ انطلَقنا فإذا نحن برجالٍ ونساءٍ مُعَلَّقاتٍ بعراقيبِهنَّ، مُصَوَّباتٍ رُؤوسُهنَّ، يَلحَسنَ من ماءٍ قَليلٍ وحمأةٍ، قُلتُ: ما هؤلاء؟ قال: الذين يصومون ويُفطِرون قَبلَ تحِلَّةِ صَومِهم، ثمَّ انطلقنا فإذا نحن برجالٍ ونساءٍ أقبَحِ شيءٍ مَنظَرًا وأقبَحِه لَبوسًا، وأنتَنِه ريحًا، كأنما ريحُهم المراحيضُ، قُلتُ: ما هؤلاء؟ قال: هؤلاء الزَّانون والزُّناة، ثمَّ انطلقنا فإذا نحن بموتى أشدِّ شيءٍ انتفاخًا وأنتَنِه ريحًا، قُلتُ: ما هؤلاء؟ قال: هؤلاء موتى الكُفَّارِ، ثمَّ انطلقنا فإذا نحن نرى دُخانًا، ونسمَعُ عِواءً، قُلتُ: ما هذا؟ قال: هذه جهنَّمُ فدعها، ثمَّ انطلقنا فإذا نحن برجالٍ نيامٍ تحتَ ظِلالِ الشَّجَرةِ، قُلتُ: ما هؤلاء؟ قال: هؤلاء موتى المسلمين، ثمَّ انطلَقنا فإذا نحن بجَوارٍ وغِلمانٍ أحسَنِ شَيءٍ وَجهًا، وأحسَنِه لَبوسًا، وأطيَبِه ريحًا، كأنَّ وُجوهَهم القراطيسُ، قُلتُ ما هؤلاء؟ قال: هؤلاء الصِّدِّيقون والشُّهَداءُ والصَّالحون، ثمَّ انطلقنا فإذا نحن بثلاثةِ نَفَرٍ يَشرَبون خمرًا، ويلعبون، فقُلتُ: ما هؤلاء؟ فقال: ذاك زيدُ بنُ حارِثةَ، وجعفَرٌ، وابنُ رَواحةَ، فمِلتُ قِبَلَهم، فقالوا: قُدنا لك، قُدنا لك، ثمَّ رفعتُ رأسي، فإذا ثلاثةُ نَفَرٍ تحتَ العَرشِ، قُلتُ: ما هؤلاء؟ قال: ذاك أبوك إبراهيمُ وموسى وعيسى، عليهم السَّلامُ، وهم ينتَظِرونك، صلواتُ اللهِ وسلامُه عليهم أجمعين»"],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"[رجاله] رجال الصحيح","takhrij":"أخرجه الطبراني في ((الشاميين)) (1966) باختلاف يسير، وابن خزيمة (1986)، والحاكم (2837) بنحوه.","bab":"ملائكة › فضل جبريل","dorar":"jPNaFG9n"},{"id":"س-08243","fp":"ce5dfa0f07d5","stateId":654,"easy":"إذا أفطرت قبل تحلة صومك ← تُعلّق بعراقيبك (رؤيا)","cause":"الذين يصومون ويُفطِرون قَبلَ تحِلَّةِ صَومِهم","result":"مُعَلَّقاتٍ بعراقيبِهنَّ، مُصَوَّباتٍ رُؤوسُهنَّ، يَلحَسنَ من ماءٍ قَليلٍ وحمأةٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-04557","ref":"سبل الهدى والرشاد 7/265","text":["خرج علينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بعدَ صلاةِ الصُّبحِ، فقال: «إني رأيتُ رؤيا هي حَقٌّ تَعقِلونها، أتاني جبريلُ عليه السَّلامُ، فأخذ بيدي، فاستتبَعَني حتى أتى بي جبَلًا طويلًا وَعرًا، فقال لي: ارْقَ، فقُلتُ: لا أستطيعُ، فقال: سأسَهِّلُه لك، فجعلتُ كلَّما رَقَت قدمي وضعتُها على دَرَجةٍ، حتى استوينا على سواءِ الجَبَلِ، فانطلَقنا فإذا نحن برجالٍ ونِساءٍ مُشَقَّقةٍ أشداقُهم، فقُلتُ: من هؤلاء؟ قال: هؤلاء الذين يقولون ما لا يعلمون، ثمَّ انطلقنا فإذا نحن برجالٍ ونِساءٍ ممدودةٍ أعينُهم وآذانُهم، قُلتُ: ما هؤلاء؟ قال: الذين يُرون أعيُنَهم ما لا يرون، ويُسمِعون آذانَهم ما لا يسمعون، ثمَّ انطلَقنا فإذا نحن بنساءٍ مُعَلَّقاتٍ بعراقيبِهنَّ، مصوَّبةٍ رؤوسُهنَّ، تنهَشُ أثداءَهن الحيَّاتُ، فقُلتُ: ما هؤلاء؟ قال: الذين يمنَعْنَ أولادَهم من ألبانِهنَّ، ثمَّ انطلَقنا فإذا نحن برجالٍ ونساءٍ ",["مُعَلَّقاتٍ بعراقيبِهنَّ، مُصَوَّباتٍ رُؤوسُهنَّ، يَلحَسنَ من ماءٍ قَليلٍ وحمأةٍ",2],"، قُلتُ: ما هؤلاء؟ قال: ",["الذين يصومون ويُفطِرون قَبلَ تحِلَّةِ صَومِهم",1],"، ثمَّ انطلقنا فإذا نحن برجالٍ ونساءٍ أقبَحِ شيءٍ مَنظَرًا وأقبَحِه لَبوسًا، وأنتَنِه ريحًا، كأنما ريحُهم المراحيضُ، قُلتُ: ما هؤلاء؟ قال: هؤلاء الزَّانون والزُّناة، ثمَّ انطلقنا فإذا نحن بموتى أشدِّ شيءٍ انتفاخًا وأنتَنِه ريحًا، قُلتُ: ما هؤلاء؟ قال: هؤلاء موتى الكُفَّارِ، ثمَّ انطلقنا فإذا نحن نرى دُخانًا، ونسمَعُ عِواءً، قُلتُ: ما هذا؟ قال: هذه جهنَّمُ فدعها، ثمَّ انطلقنا فإذا نحن برجالٍ نيامٍ تحتَ ظِلالِ الشَّجَرةِ، قُلتُ: ما هؤلاء؟ قال: هؤلاء موتى المسلمين، ثمَّ انطلَقنا فإذا نحن بجَوارٍ وغِلمانٍ أحسَنِ شَيءٍ وَجهًا، وأحسَنِه لَبوسًا، وأطيَبِه ريحًا، كأنَّ وُجوهَهم القراطيسُ، قُلتُ ما هؤلاء؟ قال: هؤلاء الصِّدِّيقون والشُّهَداءُ والصَّالحون، ثمَّ انطلقنا فإذا نحن بثلاثةِ نَفَرٍ يَشرَبون خمرًا، ويلعبون، فقُلتُ: ما هؤلاء؟ فقال: ذاك زيدُ بنُ حارِثةَ، وجعفَرٌ، وابنُ رَواحةَ، فمِلتُ قِبَلَهم، فقالوا: قُدنا لك، قُدنا لك، ثمَّ رفعتُ رأسي، فإذا ثلاثةُ نَفَرٍ تحتَ العَرشِ، قُلتُ: ما هؤلاء؟ قال: ذاك أبوك إبراهيمُ وموسى وعيسى، عليهم السَّلامُ، وهم ينتَظِرونك، صلواتُ اللهِ وسلامُه عليهم أجمعين»"],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"[رجاله] رجال الصحيح","takhrij":"أخرجه الطبراني في ((الشاميين)) (1966) باختلاف يسير، وابن خزيمة (1986)، والحاكم (2837) بنحوه.","bab":"ملائكة › فضل جبريل","dorar":"jPNaFG9n"},{"id":"س-08244","fp":"704d2e06729b","stateId":654,"easy":"إذا زنيت ← تُرى أقبح منظراً وأنتن ريحاً (رؤيا)","cause":"الزَّانون والزُّناة","result":"برجالٍ ونساءٍ أقبَحِ شيءٍ مَنظَرًا وأقبَحِه لَبوسًا، وأنتَنِه ريحًا، كأنما ريحُهم المراحيضُ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"سبل الهدى والرشاد 7/265","srcLabel":"الحاكم","text":["خرج علينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بعدَ صلاةِ الصُّبحِ، فقال: «إني رأيتُ رؤيا هي حَقٌّ تَعقِلونها، أتاني جبريلُ عليه السَّلامُ، فأخذ بيدي، فاستتبَعَني حتى أتى بي جبَلًا طويلًا وَعرًا، فقال لي: ارْقَ، فقُلتُ: لا أستطيعُ، فقال: سأسَهِّلُه لك، فجعلتُ كلَّما رَقَت قدمي وضعتُها على دَرَجةٍ، حتى استوينا على سواءِ الجَبَلِ، فانطلَقنا فإذا نحن برجالٍ ونِساءٍ مُشَقَّقةٍ أشداقُهم، فقُلتُ: من هؤلاء؟ قال: هؤلاء الذين يقولون ما لا يعلمون، ثمَّ انطلقنا فإذا نحن برجالٍ ونِساءٍ ممدودةٍ أعينُهم وآذانُهم، قُلتُ: ما هؤلاء؟ قال: الذين يُرون أعيُنَهم ما لا يرون، ويُسمِعون آذانَهم ما لا يسمعون، ثمَّ انطلَقنا فإذا نحن بنساءٍ مُعَلَّقاتٍ بعراقيبِهنَّ، مصوَّبةٍ رؤوسُهنَّ، تنهَشُ أثداءَهن الحيَّاتُ، فقُلتُ: ما هؤلاء؟ قال: الذين يمنَعْنَ أولادَهم من ألبانِهنَّ، ثمَّ انطلَقنا فإذا نحن برجالٍ ونساءٍ مُعَلَّقاتٍ بعراقيبِهنَّ، مُصَوَّباتٍ رُؤوسُهنَّ، يَلحَسنَ من ماءٍ قَليلٍ وحمأةٍ، قُلتُ: ما هؤلاء؟ قال: الذين يصومون ويُفطِرون قَبلَ تحِلَّةِ صَومِهم، ثمَّ انطلقنا فإذا نحن ",["برجالٍ ونساءٍ أقبَحِ شيءٍ مَنظَرًا وأقبَحِه لَبوسًا، وأنتَنِه ريحًا، كأنما ريحُهم المراحيضُ",2],"، قُلتُ: ما هؤلاء؟ قال: هؤلاء ",["الزَّانون والزُّناة",1],"، ثمَّ انطلقنا فإذا نحن بموتى أشدِّ شيءٍ انتفاخًا وأنتَنِه ريحًا، قُلتُ: ما هؤلاء؟ قال: هؤلاء موتى الكُفَّارِ، ثمَّ انطلقنا فإذا نحن نرى دُخانًا، ونسمَعُ عِواءً، قُلتُ: ما هذا؟ قال: هذه جهنَّمُ فدعها، ثمَّ انطلقنا فإذا نحن برجالٍ نيامٍ تحتَ ظِلالِ الشَّجَرةِ، قُلتُ: ما هؤلاء؟ قال: هؤلاء موتى المسلمين، ثمَّ انطلَقنا فإذا نحن بجَوارٍ وغِلمانٍ أحسَنِ شَيءٍ وَجهًا، وأحسَنِه لَبوسًا، وأطيَبِه ريحًا، كأنَّ وُجوهَهم القراطيسُ، قُلتُ ما هؤلاء؟ قال: هؤلاء الصِّدِّيقون والشُّهَداءُ والصَّالحون، ثمَّ انطلقنا فإذا نحن بثلاثةِ نَفَرٍ يَشرَبون خمرًا، ويلعبون، فقُلتُ: ما هؤلاء؟ فقال: ذاك زيدُ بنُ حارِثةَ، وجعفَرٌ، وابنُ رَواحةَ، فمِلتُ قِبَلَهم، فقالوا: قُدنا لك، قُدنا لك، ثمَّ رفعتُ رأسي، فإذا ثلاثةُ نَفَرٍ تحتَ العَرشِ، قُلتُ: ما هؤلاء؟ قال: ذاك أبوك إبراهيمُ وموسى وعيسى، عليهم السَّلامُ، وهم ينتَظِرونك، صلواتُ اللهِ وسلامُه عليهم أجمعين»"],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"[رجاله] رجال الصحيح","takhrij":"أخرجه الطبراني في ((الشاميين)) (1966) باختلاف يسير، وابن خزيمة (1986)، والحاكم (2837) بنحوه.","bab":"ملائكة › فضل جبريل","dorar":"jPNaFG9n"},{"id":"س-03055","fp":"4a0e5a826d86","stateId":655,"easy":"إذا نحت ولم تتوبي قبل الموت ← تُبعثين يوم القيامة عليك سرابيل من قطران","cause":"النائحةَ إذا لم تَتُبْ قبلَ أنْ تموتَ","result":"فإِنَّها تُبْعَثُ يومَ القيامَةِ عليْها سرابيلُ مِنْ قطِرانٍ ، ثُمَّ يُغْلَى عليها بدروعٍ مِنْ لهبِ النارِ","explicit":true,"ref":"صحيح الجامع 6809","srcLabel":"صحيح الجامع","text":["النياحةُ على الميتِ مِنْ أمرِ الجاهليةِ ، وإِنَّ ",["النائحةَ إذا لم تَتُبْ قبلَ أنْ تموتَ",1]," ، ",["فإِنَّها تُبْعَثُ يومَ القيامَةِ عليْها سرابيلُ مِنْ قطِرانٍ ، ثُمَّ يُغْلَى عليها بدروعٍ مِنْ لهبِ النارِ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس وأبو مالك الأشعري","muhaddith":"صحيح","bab":"إيمان › الوعيد","dorar":"8YThLFSB","merged":5,"otherRefs":["صحيح ابن ماجه 1295 (صحيح)","صحيح الجامع 6792 (صحيح)","الفتاوى الكبرى 3/67 (صحيح)","مجمع الزوائد 16/3 (حسن)"]},{"id":"س-05113","fp":"90975d77c90d","stateId":655,"easy":"إذا نِيح عليك ← تُعذّب بما نيح عليك","cause":"مَن نِيحَ عليه","result":"يُعذَّبُ بما نِيحَ عليه","explicit":true,"star":true,"similar":["س-04605"],"ref":"تخريج المسند لشعيب 18202","srcLabel":"متفق عليه","text":["عن سعيدِ بنِ عُبَيدٍ، قال: سَمِعتُ عليَّ بنَ رَبيعةَ قال: شَهِدتُ المُغيرةَ بنَ شُعبَةَ خَرَجَ يومًا، فرَقيَ على المِنبرِ، فحَمِدَ اللهَ وأثْنى عليه، ثُمَّ قال: ما بالُ هذا النَّوحِ في الإسلامِ؟ وكان مات رَجُلٌ مِن الأنصارِ، فنِيحَ عليه، قال: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: إنَّ كَذِبًا عليَّ ليس ككَذِبٍ على أحَدٍ، فمَن كَذَبَ عليَّ مُتعمِّدًا؛ فليَتبوَّأْ مَقعدَه مِن النَّارِ، سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: إنَّه ",["مَن نِيحَ عليه؛ ",1],["يُعذَّبُ بما نِيحَ عليه",2],"."],"grade":"صحيح","narrator":"المغيرة بن شعبة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (1291)، ومسلم في ((مقدمة الصحيح)) (4)، وأحمد (18202) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"l0TUWaOz","merged":5,"otherRefs":["نخب الافكار 13/517 (صحيح)","تخريج المسند لشعيب 18237 (صحيح)","الفتاوى الكبرى 3/65 (صحيح)","صحيح مسلم 927 (صحيح)"]},{"id":"س-04112","fp":"4d2763a0373c","stateId":655,"easy":"إذا بكى أهلك عليك (نياحةً) ← تُعذّب في قبرك","cause":"ببُكاءِ أهلِه عليه","result":"إنَّ المَيِّتَ يُعَذَّبُ","explicit":true,"star":true,"similar":["س-01800"],"ref":"صحيح البخاري 1286","srcLabel":"مسلم","text":["توفِّيَتِ ابنةٌ لعُثمانَ رَضيَ اللهُ عنه بمَكَّةَ، وجِئنا لنَشهَدَها وحَضَرَها ابنُ عُمَرَ وابنُ عَبَّاسٍ رَضيَ اللهُ عنهم، وإنِّي لَجالِسٌ بينَهما -أو قال: جَلَستُ إلى أحَدِهما، ثُمَّ جاءَ الآخَرُ فجَلَسَ إلى جَنبي- فقال عبدُ اللهِ بنُ عُمَرَ رَضيَ اللهُ عنهما لعَمرِو بنِ عُثمانَ: ألا تَنهى عَنِ البُكاءِ؛ فإنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: إنَّ المَيِّتَ لَيُعَذَّبُ ",["ببُكاءِ أهلِه عليه",1],". فقال ابنُ عَبَّاسٍ رَضيَ اللهُ عنهما: قد كان عُمَرُ رَضيَ اللهُ عنه يقولُ بَعضَ ذلك، ثُمَّ حَدَّثَ، قال: صَدَرتُ مع عُمَرَ رَضيَ اللهُ عنه مِن مَكَّةَ، حتَّى إذا كُنَّا بالبَيداءِ إذا هو برَكبٍ تَحتَ ظِلِّ سَمُرةٍ، فقال: اذهَبْ، فانظُرْ مَن هؤلاء الرَّكبُ؟ قال: فنَظَرتُ فإذا صُهَيبٌ، فأخبَرتُه فقال: ادعُه لي، فرَجَعتُ إلى صُهَيبٍ فقُلتُ: ارتَحِلْ فالحَقْ أميرَ المُؤمِنينَ، فلَمَّا أُصيبَ عُمَرُ دَخَلَ صُهَيبٌ يَبكي يقولُ: وا أخاه! وا صاحِباه! فقال عُمَرُ رَضيَ اللهُ عنه: يا صُهَيبُ، أتَبكي علَيَّ وقد قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["إنَّ المَيِّتَ يُعَذَّبُ",2]," ببَعضِ بُكاءِ أهلِه عليه؟! قال ابنُ عَبَّاسٍ رَضيَ اللهُ عنهما: فلَمَّا ماتَ عُمَرُ رَضيَ اللهُ عنه ذَكَرتُ ذلك لعائِشةَ رَضيَ اللهُ عنها، فقالت: رَحِمَ اللهُ عُمَرَ، واللهِ ما حَدَّثَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: إنَّ اللهَ لَيُعَذِّبُ المُؤمِنَ ببُكاءِ أهلِه عليه، ولَكِنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: إنَّ اللهَ لَيَزيدُ الكافِرَ عَذابًا ببُكاءِ أهلِه عليه، وقالت: حَسبُكُمُ القُرآنُ: {ولا تَزِرُ وازِرةٌ وِزرَ أُخرى} [الأنعام: 164]، قال ابنُ عَبَّاسٍ رَضيَ اللهُ عنهما عِندَ ذلك: واللهُ هو أضحَكَ وأبكى. قال ابنُ أبي مُلَيكةَ: واللهِ ما قال ابنُ عُمَرَ رَضيَ اللهُ عنهما شيئًا."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (928) باختلاف يسير","bab":"جنائز وموت › البكاء على الميت","dorar":"P8Xv6Nr7","merged":23,"otherRefs":["تخريج المسند لشعيب 26409 (صحيح)","تخريج صحيح ابن حبان 3136 (صحيح)","تخريج المسند لشاكر 1/137 (صحيح)","صحيح النسائي 1857 (صحيح)","صحيح مسلم 927 (صحيح)","صحيح ابن حبان 3134 (صحيح)","فتاوى النووي 82 (صحيح)","الفتاوى الكبرى 3/65 (صحيح)","صحيح مسلم 928 (صحيح)","صحيح أبي داود 3129 (صحيح)","تخريج المسند لشاكر 1/150 (صحيح)","تخريج المسند لشاكر 1/148 (صحيح)","المستدرك على الصحيحين 3801 (صحيح)","علل الدارقطني 109 (حسن)","التمهيد 17/277 (صحيح)","تخريج المسند لشعيب 19918 (صحيح)","صحيح الترمذي 1004 (صحيح)","صحيح مسلم 931 (صحيح)","صحيح الجامع 2647 (صحيح)","صحيح البخاري 1304 (صحيح)"]},{"id":"س-04605","fp":"a333f0f881a7","stateId":655,"easy":"إذا نِيح عليك ← تُعذّب في قبرك بما نيح عليك","cause":"بما نيحَ عليه","result":"المَيِّتُ يُعَذَّبُ في قَبرِه","explicit":true,"repOf":"س-05113","ref":"صحيح البخاري 1292","text":[["المَيِّتُ يُعَذَّبُ في قَبرِه",2]," ",["بما نيحَ عليه",1],". [وفي روايةٍ]: المَيِّتُ يُعَذَّبُ ببُكاءِ الحَيِّ عليه."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1292)، ومسلم (927)","bab":"دفن ومقابر › أحوال الميت في القبر","dorar":"uXbW2Po8","merged":2,"otherRefs":["التمهيد 17/276 (صحيح)"]},{"id":"س-04113","fp":"e90807ba787d","stateId":655,"easy":"إذا بكى أهل الكافر عليه ← يزيده الله عذاباً","cause":"ببُكاءِ أهلِه عليه","result":"إنَّ اللهَ لَيَزيدُ الكافِرَ عَذابًا","explicit":true,"ref":"صحيح البخاري 1286","srcLabel":"مسلم","text":["توفِّيَتِ ابنةٌ لعُثمانَ رَضيَ اللهُ عنه بمَكَّةَ، وجِئنا لنَشهَدَها وحَضَرَها ابنُ عُمَرَ وابنُ عَبَّاسٍ رَضيَ اللهُ عنهم، وإنِّي لَجالِسٌ بينَهما -أو قال: جَلَستُ إلى أحَدِهما، ثُمَّ جاءَ الآخَرُ فجَلَسَ إلى جَنبي- فقال عبدُ اللهِ بنُ عُمَرَ رَضيَ اللهُ عنهما لعَمرِو بنِ عُثمانَ: ألا تَنهى عَنِ البُكاءِ؛ فإنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: إنَّ المَيِّتَ لَيُعَذَّبُ ببُكاءِ أهلِه عليه. فقال ابنُ عَبَّاسٍ رَضيَ اللهُ عنهما: قد كان عُمَرُ رَضيَ اللهُ عنه يقولُ بَعضَ ذلك، ثُمَّ حَدَّثَ، قال: صَدَرتُ مع عُمَرَ رَضيَ اللهُ عنه مِن مَكَّةَ، حتَّى إذا كُنَّا بالبَيداءِ إذا هو برَكبٍ تَحتَ ظِلِّ سَمُرةٍ، فقال: اذهَبْ، فانظُرْ مَن هؤلاء الرَّكبُ؟ قال: فنَظَرتُ فإذا صُهَيبٌ، فأخبَرتُه فقال: ادعُه لي، فرَجَعتُ إلى صُهَيبٍ فقُلتُ: ارتَحِلْ فالحَقْ أميرَ المُؤمِنينَ، فلَمَّا أُصيبَ عُمَرُ دَخَلَ صُهَيبٌ يَبكي يقولُ: وا أخاه! وا صاحِباه! فقال عُمَرُ رَضيَ اللهُ عنه: يا صُهَيبُ، أتَبكي علَيَّ وقد قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: إنَّ المَيِّتَ يُعَذَّبُ ببَعضِ بُكاءِ أهلِه عليه؟! قال ابنُ عَبَّاسٍ رَضيَ اللهُ عنهما: فلَمَّا ماتَ عُمَرُ رَضيَ اللهُ عنه ذَكَرتُ ذلك لعائِشةَ رَضيَ اللهُ عنها، فقالت: رَحِمَ اللهُ عُمَرَ، واللهِ ما حَدَّثَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: إنَّ اللهَ لَيُعَذِّبُ المُؤمِنَ ببُكاءِ أهلِه عليه، ولَكِنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: ",["إنَّ اللهَ لَيَزيدُ الكافِرَ عَذابًا",2]," ",["ببُكاءِ أهلِه عليه",1],"، وقالت: حَسبُكُمُ القُرآنُ: {ولا تَزِرُ وازِرةٌ وِزرَ أُخرى} [الأنعام: 164]، قال ابنُ عَبَّاسٍ رَضيَ اللهُ عنهما عِندَ ذلك: واللهُ هو أضحَكَ وأبكى. قال ابنُ أبي مُلَيكةَ: واللهِ ما قال ابنُ عُمَرَ رَضيَ اللهُ عنهما شيئًا."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (928) باختلاف يسير","bab":"جنائز وموت › البكاء على الميت","dorar":"P8Xv6Nr7","merged":3,"otherRefs":["صحيح النسائي 1857 (صحيح)","التمهيد 17/277 (صحيح)"]},{"id":"س-04614","fp":"925baf9b16e9","stateId":655,"easy":"إذا عُوّل (نِيح) عليك ← تُعذّب","cause":"المعوَّلُ عليهِ","result":"يُعذَّب","explicit":true,"ref":"تخريج المسند لشاكر 1/139","srcLabel":"مسلم","text":["أنَّ عمرَ بنَ الخطَّابِ رضيَ اللَّهُ عنهُ لمَّا عوَّلت عليهِ حفصةُ فقالَ : يا حَفصةُ أما سمعتِ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ : ",["المعوَّلُ عليهِ",1]," ",["يُعذَّب",2]," قالَ : وعوَّلَ صُهَيْبٌ ، فقالَ عمرُ رضيَ اللَّهُ عنهُ : يا صُهَيْبُ أما علِمتَ أنَّ المعوَّلَ عليهِ يعذَّبُ"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (927)، والبيهقي (7249) واللفظ لهما، وابن حبان (3132) دون ذكر صهيب.","bab":"دفن ومقابر › أحوال الميت في القبر","dorar":"nwSrErYw","merged":2,"otherRefs":["تخريج صحيح ابن حبان 3132 (صحيح)"]},{"id":"س-08158","fp":"8dbd9bed608d","stateId":655,"easy":"إذا ناح عليك أهلك «واجبلاه واسنداه» ← يُوكّل بك ملكان يلهزانك: أهكذا كنت؟","cause":"فَيقومُ باكيهِم فيقولُ : واجبَلاهُ واسَنَداهُ","result":"إلَّا وُكِّلَ بِهِ ملَكانِ يَلهزانِهِ : أَهَكذَا كُنتَ","explicit":true,"similar":["س-08127"],"ref":"تحفة المحتاج 1/619","srcLabel":"الترمذي","text":["ما مِن ميِّتٍ يموتُ ",["فَيقومُ باكيهِم فيقولُ : واجبَلاهُ واسَنَداهُ",1]," أو نحوَ ذلِكَ ، ",["إلَّا وُكِّلَ بِهِ ملَكانِ يَلهزانِهِ : أَهَكذَا كُنتَ",2]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح أو حسن [كما اشترط على نفسه في المقدمة]","takhrij":"أخرجه الترمذي (1003) باختلاف يسير، وابن ماجه (1594)، وأحمد (19716) بنحوه","bab":"ملائكة › أعمال الملائكة","dorar":"EZeLshU5"},{"id":"س-00432","fp":"83153cdd147b","stateId":655,"easy":"إذا ندبت الميت «وا خياه» ← يُقال له: أأنت كذلك؟","cause":"فجعَلَتْ أُختُه عَمْرةُ تَبْكي: وا خَيَّاهُ، وا كذا وا كذا، تعُدُّ عليه","result":"ما قلْتِ شَيئًا إلَّا قيلَ لي: أنتَ كذلك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 4407","srcLabel":"الحاكم","text":["عنِ النُّعْمانِ بنِ بَشيرٍ رَضيَ الله عنهُما قالَ: \"أُغْميَ على عَبدِ اللهِ بنِ رَواحةَ رَضيَ اللهُ عنه، ",["فجعَلَتْ أُختُه عَمْرةُ تَبْكي: وا خَيَّاهُ، وا كذا وا كذا، تعُدُّ عليه",1],"، فقالَ: حينَ أفاقَ: ",["ما قلْتِ شَيئًا إلَّا قيلَ لي: أنتَ كذلك",2],"."],"grade":"صحيح","narrator":"الشعبي","muhaddith":"صحيح الإسناد","bab":"آداب عامة › الأخلاق المذمومة","dorar":"cMJz2NwR"},{"id":"س-08127","fp":"5dd4bc3d2450","stateId":655,"easy":"إذا ناح عليك أهلك «واجبلاه واسيداه» ← يُوكّل بك ملكان يلهزانك: أهكذا كنت؟","cause":"ما مِن مَيِّتٍ يموتُ ، فيقومُ باكِيهِم فيقولُ : واجَبَلَاهُ ! واسَيِّدَاهُ ! ونحوَ ذلك","result":"إلَّا وَكَّل اللهُ به مَلَكَيْنِ يَلْهَزَانِهِ ويقولانِ : أهكذا كنتَ","explicit":true,"repOf":"س-08158","ref":"هداية الرواة 1687","text":[["ما مِن مَيِّتٍ يموتُ ، فيقومُ باكِيهِم فيقولُ : واجَبَلَاهُ ! واسَيِّدَاهُ ! ونحوَ ذلك",1]," ؛ ",["إلَّا وَكَّل اللهُ به مَلَكَيْنِ يَلْهَزَانِهِ ويقولانِ : أهكذا كنتَ",2]," ؟ !"],"grade":"حسن","narrator":"أبو موسى الأشعري","muhaddith":"إسناده حسن","takhrij":"أخرجه الترمذي (1003) باختلاف يسير، وابن ماجه (1594)، وأحمد (19716) بنحوه","bab":"ملائكة › أعمال الملائكة","dorar":"iLRUeSp2"},{"id":"س-01800","fp":"d577106f946d","stateId":655,"easy":"إذا ناح أهلك عليك ← تُعذّب بنياحتهم","cause":"إن أحدَكم ليَبكيَ فيستعبرَ إليه صويحبَهُ","result":"لا تُعذبوا موتَاكم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04112","ref":"فتح الباري لابن حجر 3/185","text":["قلْتُ : يا رسولَ اللهِ قد ولدْتُهُ فقاتلَ معَك يومَ الربذَةِ ثم أصابَتْهُ الحمَّى فماتَ ونزلَ علي البكاءِ ، فقال رسولُ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ : أيُغلَبُ أحدُكم أن يُصاحبَ صويحبَهُ في الدُّنيا معروفًا ، وإذا ماتَ استرجعَ ، فوالذي نفسُ محمدٍ بيدِهِ ",["إن أحدَكم ليَبكيَ فيستعبرَ إليه صويحبَهُ",1]," ، فيا عبادَ اللهِ ",["لا تُعذبوا موتَاكم",2]],"grade":"حسن","narrator":"قيلة بنت مخرمة","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني (1) (25/ 8)، والمزي في ((تهذيب الكمال)) (35/ 275) كلاهما بلفظه في أثناء حديث .","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"I17ximiV"},{"id":"س-04115","fp":"409e43d7148d","stateId":655,"easy":"إذا ندبت ميتك «واعضداه واناصراه» ← يُقرّع الميت بذلك","cause":"فإذا قالتْ: واعضُداهُ وامانعاهُ واناصِراهُ واكاسياهُ","result":"حبَّذا الميِّتُ، فقيلَ: أناصِرُها أنتَ؟ أكاسِيها أنتَ؟ أعاضِدُها أنتَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"المستدرك على الصحيحين 3801","srcLabel":"ابن ماجه","text":["«إنَّ الميِّتَ ليُعذَّبُ ببكاءِ الحيِّ، ",["فإذا قالتْ: واعضُداهُ وامانعاهُ واناصِراهُ واكاسياهُ",1],"، ",["حبَّذا الميِّتُ، فقيلَ: أناصِرُها أنتَ؟ أكاسِيها أنتَ؟ أعاضِدُها أنتَ",2],"؟». قالَ: فقلتُ: سُبحانَ اللهِ! قالَ اللهُ عزَّ وجلَّ: {وَلَا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَى} [الأنعام: 164] فقالَ: ويْحَكَ! أُحدِّثُكَ عنْ أبي موسى، عنِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وتقولُ هذا؟ فأيُّنا كذَبَ؟ فواللهِ ما كذَبتُ على أَبي موسى، وما كذَبَ أبو موسى على رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن ماجه (1594)، والروياني في ((المسند)) (521)، وابن عبد البر في ((الاستذكار)) (3/ 72) واللفظ لهم.","bab":"جنائز وموت › البكاء على الميت","dorar":"Zcg0rxo6"},{"id":"س-04613","fp":"b29722bcd6c5","stateId":655,"easy":"إذا ندبك الأحياء «واعضداه واكاسياه» ← تُعنّف بذلك","cause":"بِبكاءِ الحيِّ ، إذا قالوا : واعضُدَاهُ ! واكاسِيَاه ! واناصِراه ! واجَبَلاه","result":"يُتَعتَعُ ، و يُقالُ ، أنتَ كذلكَ ؟ ! أنتَ كذلكَ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح الجامع 6740","srcLabel":"ابن ماجه","text":["الميِّتُ يُعَذَّبُ ",["بِبكاءِ الحيِّ ، إذا قالوا : واعضُدَاهُ ! واكاسِيَاه ! واناصِراه ! واجَبَلاه",1]," ! و نحوَ هذا ",["يُتَعتَعُ ، و يُقالُ ، أنتَ كذلكَ ؟ ! أنتَ كذلكَ",2]," ؟ !"],"grade":"حسن","narrator":"أبو موسى الأشعري","muhaddith":"حسن","takhrij":"أخرجه ابن ماجه (1594)، والروياني في ((المسند)) (521)، والحاكم (3755)، وابن عبد البر في ((الاستذكار)) (3/ 72) واللفظ لهم.","bab":"دفن ومقابر › أحوال الميت في القبر","dorar":"3vLsytSt"},{"id":"س-06644","fp":"04aaedb11034","stateId":656,"easy":"إذا فارقت الجماعة ← تموت ميتة جاهلية","cause":"مَن فارَقَ الجَماعةَ","result":"ماتَ مِيتةً جاهِليَّةً","explicit":true,"star":true,"similar":["س-05212","س-02933","س-02996","س-05033","س-07671"],"ref":"الأحاديث المختارة 8 / 193","srcLabel":"متفق عليه","text":["«إنَّها ستَكونُ أُمَراءُ مِن بَعْدي يُصَلُّونَ الصَّلاةَ لوَقْتِها ويُؤَخِّرونَها عن وَقْتِها، فصَلُّوا معَهم؛ فإن صَلَّوها لوَقْتِها وصَلَّيْتُموها معَهم فلكم ولهم، وإن أخَّروها عن وَقْتِها فصَلُّوها معَهم، فلكم وعليهم، ",["مَن فارَقَ الجَماعةَ ",1],["ماتَ مِيتةً جاهِليَّةً، ",2],"ومَن نَكَثَ العَهْدَ فماتَ ناكِثًا للعَهْدِ جاءَ يَوْمَ القِيامةِ لا حُجَّةَ له).\nلَفْظُ عَبْدِ الرَّزَّاقِ.\nولَفْظُ حَديثِ حَجَّاجٍ: أخْبَرَني عاصِمُ بنُ عُبَيْدِ اللهِ: أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قالَ: إنَّها ستَكونُ أُمَراءُ مِن بَعْدي يُصَلُّونَ الصَّلاةَ لغَيْرِ وَقْتِها، ويُؤَخِّرونَها عن وَقْتِها، فصَلُّوها معَهم؛ فإن صَلَّوْها لوَقْتِها وصَلَّيْتُموها معَهم فلكم ولهم، وإن صَلَّوها لغَيْرِ وَقْتِها وصَلَّيْتُموها معَهم فلكم وعليهم، مَن فارَقَ الجَماعةَ ماتَ مِيتةً جاهِليَّةً، ومَن نَكَثَ العَهْدَ فماتَ ناكِثًا للعَهْدِ جاءَ يَوْمَ القِيامةِ لا حُجَّةَ له»."],"grade":"صحيح","narrator":"عامر بن ربيعة","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"H5hyB60Z","merged":4,"otherRefs":["تخريج كتاب السنة 90 (صحيح)","تخريج كتاب السنة 901 (صحيح)","تخريج كتاب السنة 91 (حسن)"]},{"id":"س-07352","fp":"d14fb2e943d0","stateId":656,"easy":"إذا قُتلت تحت راية عمية تغضب أو تقاتل للعصبية ← فقتلتك جاهلية","cause":"ومَن قُتِلَ تحتَ رايةٍ عِمِّيَّةٍ يغضَبُ للعَصَبيَّةِ أو يُقَاتِلُ للعصبِيَّةِ أو يدعو إلى العصبيَّةِ","result":"فقِتْلَةُ جاهليةٍ","explicit":true,"star":true,"similar":["س-07349","س-02922"],"ref":"تخريج المسند لشاكر 15/201","srcLabel":"مسلم","text":["مَن فارَقَ الجمَاعَةَ وخرَجَ من الطاعَةِ فماتَ فميتُتُهُ جاهليةٌ ومَن خَرَجَ علَى أمتِي بسيفِهِ يضربُ برَّهَا وفاجِرَهَا لا يُحَاشِى مؤمنًا لإيمانِهِ ولا يَفِي لذِي عهدٍ بعهدِهِ فليسَ مِن أمتِي ",["ومَن قُتِلَ تحتَ رايةٍ عِمِّيَّةٍ يغضَبُ للعَصَبيَّةِ أو يُقَاتِلُ للعصبِيَّةِ أو يدعو إلى العصبيَّةِ",1]," ",["فقِتْلَةُ جاهليةٍ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (1848)، والنسائي (4114)، وابن ماجه (3948)، وأحمد (8061) واللفظ له","bab":"فتن › كراهية الاختلاف","dorar":"QB4TxSjk","merged":4,"otherRefs":["صحيح مسلم 1850 (صحيح)","السنن الصغير للبيهقي 4/185 (صحيح)","صحيح ابن ماجه 3205 (صحيح)"]},{"id":"س-05212","fp":"7ebe4eac3150","stateId":656,"easy":"إذا فارقت الجماعة شبراً فمت ← تموت ميتة جاهلية","cause":"مَن رَأَى من أمِيرِهِ شيئًا يَكْرَهُهُ فلْيَصْبِرْ عليه","result":"فإِنَّهُ ليس أحدٌ يُفارِقُ الجَماعةَ شِبْرًا فيَموتُ ، إِلَّا ماتَ مِيتةً جَاهِلِيَّةً","explicit":true,"repOf":"س-06644","ref":"صحيح الجامع 6249","text":[["مَن رَأَى من أمِيرِهِ شيئًا يَكْرَهُهُ فلْيَصْبِرْ عليه ، ",1],["فإِنَّهُ ليس أحدٌ يُفارِقُ الجَماعةَ شِبْرًا فيَموتُ ، إِلَّا ماتَ مِيتةً جَاهِلِيَّةً",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه البخاري (7143) واللفظ له، ومسلم (1849)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"oXbiEU96"},{"id":"س-07679","fp":"550ae749407e","stateId":656,"easy":"إذا خرجت من السلطان شبراً فمت ← تموت ميتة جاهلية","cause":"أيما رجل كره من أميره أمرا فليصبر","result":"فإنه ليس أحد من الناس يخرج من السلطان شبرا، فمات، إلا مات ميتة جاهلية","explicit":true,"ref":"تخريج المسند لشعيب 2826","srcLabel":"متفق عليه","text":["مَن رأَى مِن أَميرِه شَيئًا يَكرَهُهُ... فذكَرَ نَحوَه.\n[أي نحو حديث: \" ",["أيما رجل كره من أميره أمرا فليصبر، ",1],["فإنه ليس أحد من الناس يخرج من السلطان شبرا، فمات، إلا مات ميتة جاهلية ",2],"]"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (7053)، ومسلم (1849)، وأحمد (2826) واللفظ له","bab":"قدر › العمل بالخواتيم","dorar":"Ta8LDgHy"},{"id":"س-02933","fp":"db597f855a3c","stateId":656,"easy":"إذا نزعت يدك من طاعة ومت مفارقاً للجماعة ← تموت ميتة جاهلية ولا حجة لك","cause":"مَن نزعَ يدًا مِن طاعةٍ لم تكُنْ لَهُ حُجَّةٌ يومَ القيامةِ ومَن ماتَ مفارقًا للجَماعةِ","result":"فإنَّهُ يَموتُ موتَ الجاهليَّةِ","explicit":true,"repOf":"س-06644","ref":"تخريج المسند لشاكر 8/71","text":["أنَّ عبدَ اللَّهِ بنَ عمرَ أتى ابنَ مُطيعٍ ليالي الحرَّةِ فقالَ : ضَعوا لأبي عبدِ الرَّحمنِ وِسادةً فقالَ إنِّي لم آتِ لأجلِسَ إنَّما جئتُ لأُخْبِرَكَ كلِمَتينِ سَمِعْتُهما مِن رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ ",["مَن نزعَ يدًا مِن طاعةٍ لم تكُنْ لَهُ حُجَّةٌ يومَ القيامةِ ومَن ماتَ مفارقًا للجَماعةِ ",1],["فإنَّهُ يَموتُ موتَ الجاهليَّةِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (1851)، وابن حبان (4578)، وابن أبي عاصم في ((السنة)) (1075) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"aoAvWnuN","merged":2,"otherRefs":["تخريج كتاب السنة 1075 (حسن)"]},{"id":"س-07350","fp":"853bd4b25f10","stateId":656,"easy":"إذا فارقت الجماعة وخرجت من الطاعة فمت ← فميتتك جاهلية","cause":"مَن فارَقَ الجمَاعَةَ وخرَجَ من الطاعَةِ فماتَ","result":"فميتُتُهُ جاهليةٌ","explicit":true,"ref":"تخريج المسند لشاكر 15/201","srcLabel":"مسلم","text":[["مَن فارَقَ الجمَاعَةَ وخرَجَ من الطاعَةِ فماتَ",1]," ",["فميتُتُهُ جاهليةٌ",2]," ومَن خَرَجَ علَى أمتِي بسيفِهِ يضربُ برَّهَا وفاجِرَهَا لا يُحَاشِى مؤمنًا لإيمانِهِ ولا يَفِي لذِي عهدٍ بعهدِهِ فليسَ مِن أمتِي ومَن قُتِلَ تحتَ رايةٍ عِمِّيَّةٍ يغضَبُ للعَصَبيَّةِ أو يُقَاتِلُ للعصبِيَّةِ أو يدعو إلى العصبيَّةِ فقِتْلَةُ جاهليةٍ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (1848)، والنسائي (4114)، وابن ماجه (3948)، وأحمد (8061) واللفظ له","bab":"فتن › كراهية الاختلاف","dorar":"QB4TxSjk","merged":2,"otherRefs":["شرح بلوغ المرام لابن عثيمين 4/475 (صحيح)"]},{"id":"س-02996","fp":"9b6d93944667","stateId":656,"easy":"إذا نزعت يدك من طاعة أو فارقت الجماعة ← تموت ميتة جاهلية","cause":"مَنْ نَزَعَ يدًا مِنْ طاعةٍ أوْ فارقَ الجماعةَ","result":"مات مِيتةَ الجاهليةِ","explicit":true,"repOf":"س-06644","ref":"تخريج المسند لشاكر 9/23","text":["أنَّ عبدَ اللهِ بنَ عُمرَ أتى ابنَ مُطيعٍ فقال : اطرحُوا لأبي عبدِ الرحمنِ وسادةً فقال : ما جئتُ لأجلسَ عندَك ولكن جئتُ أخبرُك ما سمعتُ من رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ سمعتُه يقولُ : ",["مَنْ نَزَعَ يدًا مِنْ طاعةٍ أوْ فارقَ الجماعةَ ",1],["مات مِيتةَ الجاهليةِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (1851)، وابن حبان (4578)، وابن أبي عاصم في ((السنة)) (1075) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"03fqrPIp"},{"id":"س-07349","fp":"5f9235054021","stateId":656,"easy":"إذا قاتلت تحت راية عمية تغضب للعصبية ← فقتلتك جاهلية","cause":"مَن قاتَلَ تحتَ رايةٍ عُمِّيَّةٍ","result":"يُقاتلُ عصبيَّةً ، ويغضَبُ لعصبيَّةٍ ، فَقِتْلَةٌ جاهليَّةٌ","explicit":true,"repOf":"س-07352","ref":"صحيح النسائي 4126","text":[["مَن قاتَلَ تحتَ رايةٍ عُمِّيَّةٍ ، ",1],["يُقاتلُ عصبيَّةً ، ويغضَبُ لعصبيَّةٍ ، فَقِتْلَةٌ جاهليَّةٌ",2]],"grade":"صحيح","narrator":"جندب بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1850) باختلاف يسير، وابن حبان (4579) مختصرا، والروياني (959) واللفظ له.","bab":"فتن › كراهية الاختلاف","dorar":"sl4bXeA2"},{"id":"س-07342","fp":"2056ce3e5c7f","stateId":656,"easy":"إذا مت بغير إمام ← تموت ميتة جاهلية","cause":"مَن مات بغَيْرِ إمامٍ","result":"مات مِيتةً جاهِليَّةً","explicit":true,"ref":"تخريج المسند لشعيب 16876","srcLabel":"أحمد","text":[["مَن مات بغَيْرِ إمامٍ، ",1],["مات مِيتةً جاهِليَّةً",2],"."],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (16876) واللفظ له، وأبو يعلى (7375)، وابن حبان (4573)","bab":"فتن › كراهية الاختلاف","dorar":"Z1MALQqL","merged":2,"otherRefs":["تخريج صحيح ابن حبان 4573 (صحيح)"]},{"id":"س-07673","fp":"1674db34f9f4","stateId":656,"easy":"إذا مت وليست عليك طاعة ← تموت ميتة جاهلية","cause":"مَن مات وليست عليه طاعةٌ","result":"مات مِيتةً جاهليَّةً","explicit":true,"similar":["س-03858"],"ref":"تخريج المسند لشعيب 15696","srcLabel":"أحمد","text":[["مَن مات وليست عليه طاعةٌ، ",1],["مات مِيتةً جاهليَّةً",2],"، فإنْ خلَعَها مِن بَعدِ عَقْدِها في عُنُقِه، لَقيَ اللهَ تبارَك وتعالَى وليستْ له حُجَّةٌ.\n ألَا لا يَخْلُوَنَّ رجُلٌ بامرأةٍ لا تَحِلُّ له؛ فإنَّ ثالثَهما الشَّيطانُ، إلَّا مَحْرَمٌ؛ فإنَّ الشَّيطانَ مع الواحدِ، وهو مِنَ الاثنَينِ أَبْعَدُ.\n مَن ساءَتْهُ سَيِّئتُه، وسَرَّتْهُ حسَنتُه فهو مؤْمِنٌ. قال حُسَينٌ: بعْدَ عَقْدِه إيَّاها في عُنُقِه."],"grade":"صحيح","narrator":"عامر بن ربيعة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (15696) واللفظ له، والروياني في ((المسند)) (1341)، والضياء في ((الأحاديث المختارة)) (230)","bab":"قدر › العمل بالخواتيم","dorar":"dR5FfB9U","merged":2,"otherRefs":["الأحاديث المختارة 8 / 198 (صحيح)"]},{"id":"س-07676","fp":"dd1e0b7c310c","stateId":656,"easy":"إذا مت وليس عليك إمام جماعة ← فموتتك جاهلية","cause":"من مات وليسَ عليه إمامُ جماعةٍ","result":"فإنَّ مَوْتَتَه موتَةٌ جاهليَّةٌ","explicit":true,"ref":"الكبائر للذهبي 473","srcLabel":"الحاكم","text":[["من مات وليسَ عليه إمامُ جماعةٍ؛ ",1],["فإنَّ مَوْتَتَه موتَةٌ جاهليَّةٌ ",2],"[وخَطَبَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: «يا أَيُّها النَّاسُ، إنِّي فَرَطٌ لَكُمْ على الحَوْضِ، وإنَّ سَعَتَهُ ما بينَ الكوفَةِ إلى الحَجَرِ الأَسْوَدِ، وآنيَتُهُ كعَدَدِ النُّجومِ، وَإنِّي رَأيْتُ أُناسًا مِنْ أُمَّتي لَمَّا دَنَوْا مِنِّي خَرَجَ عَليهِمْ رَجُلٌ، فَمالَ بِهِمْ عَنِّي، ثُمَّ أَقْبَلَتْ زُمْرَةٌ أُخْرى فَفَعَلَ بِهِمْ كذلك، فَلَمْ يَفْلِتْ مِنْهُمْ إلَّا كَمَثَلِ النَّعَمِ». فقالَ أَبو بَكْرٍ: لَعَلِّي مِنْهُم يا نَبيَّ اللَّهِ. قالَ: «لا، ولَكِنَّهُمْ قَوْمٌ يَخْرُجونَ بَعْدَكُمْ يُضَيِّعونَ ويَمْشونَ القَهْقَرى».]"],"grade":"صحيح","narrator":"[عبدالله بن عمر]","muhaddith":"إسناده صحيح","takhrij":"أخرجه الحاكم (259)، والطبراني في ((الكبير)) (12/ 440) (13604) بلفظه تامًا، وابن أبي عاصم في ((السنة)) (1075) بنحوه.","bab":"قدر › العمل بالخواتيم","dorar":"p5X5Pwtc","merged":2,"otherRefs":["المستدرك على الصحيحين 408 (صحيح)"]},{"id":"س-02922","fp":"ba644fc8e90c","stateId":656,"easy":"إذا قُتلت تحت راية عمية تنصر العصبية ← فقتلتك جاهلية","cause":"مَنْ قُتِلَ تحتَ رايةٍ عَمِّيَّةٍ","result":"يَنصرُ العصبيةَ ، ويغضبُ للعصبيةِ ، فقِتْلتُهُ جاهليةٌ","explicit":true,"repOf":"س-07352","ref":"صحيح الجامع 6442","text":[["مَنْ قُتِلَ تحتَ رايةٍ عَمِّيَّةٍ ، ",1],["يَنصرُ العصبيةَ ، ويغضبُ للعصبيةِ ، فقِتْلتُهُ جاهليةٌ",2]],"grade":"صحيح","narrator":"جندب بن عبدالله وأبو هريرة","muhaddith":"صحيح","bab":"إيمان › الوعيد","dorar":"KvOUCyyo"},{"id":"س-03858","fp":"a36d0818bba4","stateId":656,"easy":"إذا مت وليس في عنقك بيعة ← تموت ميتة جاهلية","cause":"ومَن ماتَ وليسَ في عُنُقِه بَيعةٌ","result":"ماتَ مِيتةً جاهِليَّةً","explicit":true,"repOf":"س-07673","ref":"صحيح مسلم 1851","text":["جاءَ عبدُ اللهِ بنُ عُمَرَ إلى عبدِ اللهِ بنِ مُطيعٍ حينَ كان مِن أمرِ الحَرَّةِ ما كانَ، زَمَنَ يَزيدَ بنِ مُعاويةَ، فقال: اطرَحوا لأبي عبدِ الرَّحمَنِ وِسادةً، فقال: إنِّي لم آتِكَ لأجلِسَ، أتَيتُكَ لأُحَدِّثَكَ حَديثًا سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُه: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: مَن خَلَعَ يَدًا مِن طاعةٍ لَقيَ اللهَ يَومَ القيامةِ لا حُجَّةَ له، ",["ومَن ماتَ وليسَ في عُنُقِه بَيعةٌ ",1],["ماتَ مِيتةً جاهِليَّةً",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (5386)، وابن حبان (4578) بنحوه.","bab":"بيعة › مبايعة الإمام","dorar":"Hr2AYVCB"},{"id":"س-05033","fp":"02c9fcd9ed3e","stateId":656,"easy":"إذا مت وأنت مفارق للجماعة ← تموت ميتة جاهلية","cause":"ومن مات وهوَ مُفارقٌ للجماعةِ","result":"فإنه يموتُ مِيتةً جاهليةً","explicit":true,"repOf":"س-06644","ref":"تخريج المسند لشاكر 9/165","text":["دخلتُ معَ ابنِ عمرَ على عبدِ اللهِ بنِ مُطيعٍ فقال : مرحبًا بأبي عبدِ الرحمنِ ضَعُوا له وِسادةً فقال ابنُ عمرَ : إنَّما جئتُ لأحَدِّثَك حديثًا سمعتُهُ من رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ سمعتُ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يقولُ : من نَزَعَ يدًا من طاعةٍ فإنه يَأْتِي يومَ القيامةِ لا حُجَّةَ له ",["ومن مات وهوَ مُفارقٌ للجماعةِ ",1],["فإنه يموتُ مِيتةً جاهليةً",2]],"grade":"صحيح","narrator":"أسلم الحبشي","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (5551) واللفظ له، وأبو عوانه في ((مسنده)) (7155)، وأبو نعيم في ((حلية الأولياء)) (9/58)، من حديث عبدالله بن عمر","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"SPdP6qJj"},{"id":"س-07671","fp":"3add2b7fae6f","stateId":656,"easy":"إذا مت مفارقاً للجماعة ← فقد مت ميتة جاهلية","cause":"ومَن ماتَ مُفارِقًا لِلْجَماعَةِ","result":"فقد ماتَ ميتَةً جاهِليَّةً","explicit":true,"repOf":"س-06644","ref":"تخريج المسند لشعيب 6048","text":["مَن نَزَعَ يَدًا من طاعَةٍ، فلا حُجَّةَ له يَومَ القيامَةِ، ",["ومَن ماتَ مُفارِقًا لِلْجَماعَةِ، ",1],["فقد ماتَ ميتَةً جاهِليَّةً",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (6048) واللفظ له، والطيالسي (2025)، وابن حبان (4578)","bab":"قدر › العمل بالخواتيم","dorar":"gR7OLPdN"},{"id":"س-02563","fp":"dc388f486721","stateId":657,"easy":"إذا استطعت الحج فلم تحج بلا عذر ← فمت إن شئت يهودياً أو نصرانياً","cause":"من لم تحبِسْه حاجةٌ ظاهرةٌ أو مرضٌ حابسٌ أو سلطانٌ جائرٌ ولم يحُجَّ","result":"فلْيمُتْ إن شاء يهوديًّا وإن شاء نصرانيًّا","explicit":true,"star":true,"similar":["س-04856"],"ref":"الترغيب والترهيب 2/202","srcLabel":"الدارمي","text":[["من لم تحبِسْه حاجةٌ ظاهرةٌ أو مرضٌ حابسٌ أو سلطانٌ جائرٌ ولم يحُجَّ",1]," ",["فلْيمُتْ إن شاء يهوديًّا وإن شاء نصرانيًّا",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الدارمي (1785)، وأبو يعلى في ((المعجم)) (231)، وابن عدي في ((الكامل في الضعفاء)) (5/72) باختلاف يسير.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"bhDkfVHm","merged":3,"otherRefs":["نيل الأوطار 5/8 (حسن)","السنن الكبرى للبيهقي 4/334 (حسن)"]},{"id":"س-04856","fp":"7d4f9157be6d","stateId":657,"easy":"إذا أطقت الحج فلم تحج ← فسواء عليك مت يهودياً أو نصرانياً","cause":"مَن أطاقَ الحجَّ، فلم يحُجَّ","result":"فسواءٌ عليه مات يهوديًّا أو نصرانيًّا","explicit":true,"repOf":"س-02563","ref":"معارج القبول 639/2","text":["أنَّه سمِع عُمرَ بنَ الخطَّابِ رضِيَ اللهُ عنه يقولُ: ",["مَن أطاقَ الحجَّ، فلم يحُجَّ",1]," ",["فسواءٌ عليه مات يهوديًّا أو نصرانيًّا",2],"."],"grade":"صحيح","narrator":"عبدالرحمن بن غنم","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو نعيم الأصبهاني في ((حلية الأولياء)) (9/ 252) بلفظه، والعدني في ((الإيمان)) (38)، والفاكهي في ((أخبار مكة)) (1/ 382) كلاهما بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ieWY9d5J"},{"id":"س-05282","fp":"effc74019b67","stateId":657,"easy":"إذا ملكت زاداً وراحلة إلى بيت الله ولم تحج ← فلا عليك أن تموت يهودياً أو نصرانياً","cause":"مَن مَلَكَ زادًا وراحِلةً تُبَلِّغُه إلى بَيتِ اللهِ ولَم يَحُجَّ","result":"فلا عليه أن يَموتَ يَهوديًّا أو نَصرانيًّا","explicit":true,"ref":"الفوائد المجموعة 102","srcLabel":"ابن أبي عمر","text":["[قال عُمَرُ: ",["مَن مَلَكَ زادًا وراحِلةً تُبَلِّغُه إلى بَيتِ اللهِ ولَم يَحُجَّ ",1],["فلا عليه أن يَموتَ يَهوديًّا أو نَصرانيًّا",2],"]"],"grade":"صحيح","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي عمر في ((الإيمان)) (38)، والفاكهي في ((أخبار مكة)) (1/ 382)، وأبو نعيم في ((الحلية)) (9/ 252) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"pISM0X6a"},{"id":"س-02775","fp":"ae0f5c6638d7","stateId":657,"easy":"إذا لم تتم الركوع والسجود ← تموت على غير ملة محمد ﷺ (أثر بلال)","cause":"لا يتمُّ الرُّكوعَ ولا السُّجودَ","result":"لو ماتَ هذا ماتَ على غيرِ ملَّةِ محمَّدٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-02776"],"otherNeedIds":[52],"ref":"الزواجر عن اقتراف الكبائر 1/140","srcLabel":"الزواجر عن اقتراف الكبائر","text":["عن بلالٍ رضيَ اللَّهُ عنهُ : أنَّهُ رأى رجلًا ",["لا يتمُّ الرُّكوعَ ولا السُّجودَ",1]," فقالَ ",["لو ماتَ هذا ماتَ على غيرِ ملَّةِ محمَّدٍ",2]," صلَّى اللَّهُ عليهِ وسلَّمَ"],"grade":"صحيح","muhaddith":"صحيح","bab":"إيمان › الملة ملة محمد صلى الله عليه وسلم","dorar":"WUGS26KQ","merged":2,"otherRefs":["صلاة التراويح 118 (حسن)"]},{"id":"س-02776","fp":"44acc99fd8de","stateId":657,"easy":"إذا لم تتم ركوعك وسجودك ← تموت على غير سنة محمد ﷺ (أثر حذيفة)","cause":"لا يُتِمُّ رُكوعَه ولا سُجودَه","result":"ما صَلَّيتَ؟ قال: وأحسِبُه قال: ولو مُتَّ مُتَّ على غيرِ سُنَّةِ مُحَمَّدٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-02775","otherNeedIds":[52],"ref":"صحيح البخاري 808","text":["عَن حُذَيفةَ، رَأى رَجُلًا ",["لا يُتِمُّ رُكوعَه ولا سُجودَه",1]," فلَمَّا قَضى صَلاتَه قال له حُذَيفةُ: ",["ما صَلَّيتَ؟ قال: وأحسِبُه قال: ولو مُتَّ مُتَّ على غيرِ سُنَّةِ مُحَمَّدٍ",2]," صلَّى اللهُ عليه وسلَّم."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"[صحيح]","takhrij":"أخرجه النسائي (1312) بنحوه، وأحمد (23360)، والبزار (2817) كلاهما باختلاف يسير.","bab":"إيمان › الملة ملة محمد صلى الله عليه وسلم","dorar":"gyTCLvfG"},{"id":"س-06963","fp":"420e1ff90fb5","stateId":658,"easy":"إذا كرهت لقاء الله ← كره الله لقاءك","cause":"ومَن كَرِهَ لقاءَ اللهِ","result":"كَرِهَ اللهُ لقاءَه","explicit":true,"star":true,"similar":["س-05409","س-05417"],"ref":"صحيح مسلم 2685","srcLabel":"مسلم","text":["مَن أحَبَّ لقاءَ اللهِ أحَبَّ اللهُ لقاءَه، ",["ومَن كَرِهَ لقاءَ اللهِ",1]," ",["كَرِهَ اللهُ لقاءَه",2],". قال: فأتَيتُ عائِشةَ، فقُلتُ: يا أُمَّ المُؤمِنينَ، سَمِعتُ أبا هُرَيرةَ يَذكُرُ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم حَديثًا إن كان كَذلك فقد هَلَكنا، فقالت: إنَّ الهالِكَ مَن هَلَكَ بقَولِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم! وما ذاكَ؟ قال: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: مَن أحَبَّ لقاءَ اللهِ أحَبَّ اللهُ لقاءَه، ومَن كَرِهَ لقاءَ اللهِ كَرِهَ اللهُ لقاءَه، وليسَ مِنَّا أحَدٌ إلَّا وهو يَكرَهُ المَوتَ، فقالت: قد قالهُ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، وليسَ بالذي تَذهَبُ إليه، ولَكِن إذا شَخَصَ البَصَرُ، وحَشرَجَ الصَّدرُ، واقشَعَرَّ الجِلدُ، وتَشَنَّجَتِ الأصابِعُ، فعِندَ ذلك مَن أحَبَّ لقاءَ اللهِ أحَبَّ اللهُ لقاءَه، ومَن كَرِهَ لقاءَ اللهِ كَرِهَ اللهُ لقاءَه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2685)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"UyBTScsV","merged":8,"otherRefs":["تخريج المسند لشعيب 25831 (صحيح)","أطراف الغرائب 2/342 (صحيح)","تخريج المسند لشعيب 18283 (حسن)","صحيح النسائي 1837 (صحيح)","صحيح البخاري 6507 (صحيح)","تفسير القرآن العظيم 7/167 (صحيح)","صحيح مسلم 2684 (صحيح)"]},{"id":"س-05409","fp":"bf617e5c04e5","stateId":658,"easy":"إذا كرهت لقاء الله ← كره الله لقاءك","cause":"إذا كَرِهَ العَبدُ لِقائي","result":"كرِهتُ لقاءَه","explicit":true,"repOf":"س-06963","otherNeedIds":[27],"ref":"تخريج المسند لشعيب 9822","text":["قال اللهُ عزَّ وجلَّ: إذا أحَبَّ العَبدُ لقائي أحبَبتُ لقاءَه، و",["إذا كَرِهَ العَبدُ لِقائي",1]," ",["كرِهتُ لقاءَه",2],"، قال: فقيلَ لأبي هُرَيرةَ: ما منَّا مِن أحدٍ إلَّا وهو يَكرَهُ المَوتَ، ويَفظَعُ به، قال أبو هُرَيرةَ: إنَّه إذا كان ذلك كشَفَ له."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2685)، والنسائي (1834) مطولاً، وأحمد (9822) واللفظ له","bab":"رقائق وزهد › الحب للقاء الله","dorar":"iFBbNpAF","merged":2,"otherRefs":["صحيح النسائي 1834 (صحيح)"]},{"id":"س-04635","fp":"51ff87d278a0","stateId":658,"easy":"إذا كنت عدواً لله ← لا تحب أن تخرج روحك والله يبغض لقاءك","cause":"فإِذَا كان عَدُوا للهِ","result":"فإنَّهُ لا يحبُّ أنْ تُخْرَجَ رُوحُهُ أبدًا ، و اللهُ يُبْغِضُ لِقَاءَهُ ، فإِذَا جلسَ في قبرِهِ أوْ أُجْلِسَ ، فيقالُ لهُ : مَنْ رَبُّكَ ؟ فيقولُ : لا أَدْرِي ‍ فيقالُ : لا دَرَيْتَ فَيُفْتَحُ لهُ بابٌ من جهنمَ ، ثُمَّ يُضْرَبُ ضَرْبَةً تسْمَعُ كلُّ دَابَّةٍ إلَّا الثَّقَلَيْنِ ، ثُمَّ يقالُ لهُ : نَمْ كما يَنامُ المَنْهوشُ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"السلسلة الصحيحة 2628","srcLabel":"البزار","text":[["فإِذَا كان عَدُوا للهِ",1]," نزلَ بهِ المَوْتُ و عَايَنَ ما عَايَنَ ، ",["فإنَّهُ لا يحبُّ أنْ تُخْرَجَ رُوحُهُ أبدًا ، و اللهُ يُبْغِضُ لِقَاءَهُ ، فإِذَا جلسَ في قبرِهِ أوْ أُجْلِسَ ، فيقالُ لهُ : مَنْ رَبُّكَ ؟ فيقولُ : لا أَدْرِي ‍ فيقالُ : لا دَرَيْتَ فَيُفْتَحُ لهُ بابٌ من جهنمَ ، ثُمَّ يُضْرَبُ ضَرْبَةً تسْمَعُ كلُّ دَابَّةٍ إلَّا الثَّقَلَيْنِ ، ثُمَّ يقالُ لهُ : نَمْ كما يَنامُ المَنْهوشُ",2]," فقُلْتُ لأَبي هريرةَ : ما المَنْهوشُ ؟ قال : الذي يَنْهِشُهُ الدَّوَابُّ و الحَيَّاتُ ثُمَّ يُضَيَّقُ عليهِ قَبْرُهُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البزار (9760) واللفظ له، والطبري في ((تهذيب الآثار - مسند عمر)) (2/502)","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"aDJeKO3Q"},{"id":"س-05417","fp":"2aef6d460372","stateId":658,"easy":"إذا كرهت لقاء الله ← يبغض الله لقاءك","cause":"ودَّ أنها لا تخرجُ أبدًا","result":"واللهُ يبغَضُ لقاءَه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-06963","otherNeedIds":[27],"ref":"مسند عمر 2/502","text":["إنَّ المؤمنَ حين ينزلُ به الموتُ ويعاينُ ما يعاينُ ودَّ أنها قد خرجتْ واللهُ يحبُّ لقاءَه وإنَّ المؤمنَ يُصعَد برُوحهِ إلى السماءِ فتأتيه أرواحُ الْمُؤْمِنينَ فيَستخبرونه عن معارفِهم من أهلِ الأرضِ فإذا قال تركتُ فلانًا في الدُّنيا أعجبَهم ذلك وإذا قال إنَّ فلانًا قد فارق الدُّنيا قالوا ما جيءِ بروحِ ذاك إلينا وقد ذُهِبَ بروحِه إلى أرواحِ أهلِ النارِ وإنَّ المؤمنَ يُجلَسُ في قبرِهِ ويُسألُ مَن ربُّك فيقولُ ربيَ اللهُ ويُقالُ مَنْ نبيُّكَ فيقولُ نبيّ محمدٌ صلَّى اللهُ عليه وسلَّمَ فيُقالُ ما دينُك فيقولُ دينيَ الإسلامُ فيُفتحُ له بابٌ في قبرِهِ فيقالُ انظُرْ إلى مجلسِك نمْ قريرَ العينِ فيبعثُه اللهُ يومَ القيامةِ كأنما كانت رَقدَةً وإذا كان عدوَّ اللهِ ونزل به الموتُ ويُعاينُ ما يعاينُ ",["ودَّ أنها لا تخرجُ أبدًا",1]," ",["واللهُ يبغَضُ لقاءَه",2]," وإذا أُجلِسَ في قبرِهِ يُقالُ من ربُّك قال لا أدري قال لا دَرَيتَ ويُفتَحُ له بابٌ في قبرِهِ بابٌ من أبوابِ جهنمَ ثم يُضربُ ضربةً يَسمعُها خلقُ اللهِ إلا الثّقَلَينِ ثم يُقالُ نَمْ كما ينامُ المنهوشُ قال قلتُ يا أبا هريرةَ وما المنهوشُ قال نهشَتْهُ الدوابُّ والحيّاتُ ثم يَضيقُ عليه قبرُهُ حتى رأيتُ أبا هريرةَ نصبَ يدَه ثم كفَأها ثم شبَّك حتى تختلفَ أضلاعُهُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه عبدالله بن أحمد في ((السنة)) (1447)، والبزار (9760)، وابن المقرئ في ((المعجم)) (11) باختلاف يسير","bab":"رقائق وزهد › الحب للقاء الله","dorar":"nERNGki9"}]}