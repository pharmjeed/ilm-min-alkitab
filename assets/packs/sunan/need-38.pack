{"schema":1,"kind":"sunan-chunk","version":"sunan-2420572879fb","needId":38,"stateIds":[385,386,387,388],"items":[{"id":"ق-0747","fp":"cdb90780f51d","stateId":385,"easy":"اعتزال الشرك وأهله ودعاء الله ← هبة الذرية الصالحة والرحمة ولسان الصدق","cause":"اعتزال الشرك وأهله ودعاء الله","result":"هبة الذرية الصالحة والرحمة ولسان الصدق","explicit":true,"otherNeedIds":[41,24],"ref":"سورة مريم: 48–50","srcLabel":"القرآن الكريم","quran":{"s":19,"from":48,"to":50,"text":"وَأَعْتَزِلُكُمْ وَمَا تَدْعُونَ مِنْ دُونِ اللَّهِ وَأَدْعُو رَبِّي عَسَى أَلَّا أَكُونَ بِدُعَاءِ رَبِّي شَقِيًّا (48) فَلَمَّا اعْتَزَلَهُمْ وَمَا يَعْبُدُونَ مِنْ دُونِ اللَّهِ وَهَبْنَا لَهُ إِسْحَاقَ وَيَعْقُوبَ وَكُلًّا جَعَلْنَا نَبِيًّا (49) وَوَهَبْنَا لَهُمْ مِنْ رَحْمَتِنَا وَجَعَلْنَا لَهُمْ لِسَانَ صِدْقٍ عَلِيًّا (50)","hl":[[0,329,1]]}},{"id":"ق-0791","fp":"ca9dae614b5f","stateId":385,"easy":"الصلاح وعبادة الله ← النجاة وهبة الذرية الصالحة والإمامة في الدين","cause":"الصلاح وعبادة الله","result":"النجاة وهبة الذرية الصالحة والإمامة في الدين","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[43],"ref":"سورة الأنبياء: 71–73","srcLabel":"القرآن الكريم","quran":{"s":21,"from":71,"to":73,"text":"وَنَجَّيْنَاهُ وَلُوطًا إِلَى الْأَرْضِ الَّتِي بَارَكْنَا فِيهَا لِلْعَالَمِينَ (71) وَوَهَبْنَا لَهُ إِسْحَاقَ وَيَعْقُوبَ نَافِلَةً وَكُلًّا جَعَلْنَا صَالِحِينَ (72) وَجَعَلْنَاهُمْ أَئِمَّةً يَهْدُونَ بِأَمْرِنَا وَأَوْحَيْنَا إِلَيْهِمْ فِعْلَ الْخَيْرَاتِ وَإِقَامَ الصَّلَاةِ وَإِيتَاءَ الزَّكَاةِ وَكَانُوا لَنَا عَابِدِينَ (73)","hl":[[0,332,1]]}},{"id":"ق-0943","fp":"aafabae576e5","stateId":385,"easy":"الهجرة إلى الله ← هبة الذرية الصالحة وأجر الدنيا والصلاح في الآخرة","cause":"الهجرة إلى الله","result":"هبة الذرية الصالحة وأجر الدنيا والصلاح في الآخرة","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[45,7],"ref":"سورة العنكبوت: 26–27","srcLabel":"القرآن الكريم","quran":{"s":29,"from":26,"to":27,"text":"فَآمَنَ لَهُ لُوطٌ وَقَالَ إِنِّي مُهَاجِرٌ إِلَى رَبِّي إِنَّهُ هُوَ الْعَزِيزُ الْحَكِيمُ (26) وَوَهَبْنَا لَهُ إِسْحَاقَ وَيَعْقُوبَ وَجَعَلْنَا فِي ذُرِّيَّتِهِ النُّبُوَّةَ وَالْكِتَابَ وَآتَيْنَاهُ أَجْرَهُ فِي الدُّنْيَا وَإِنَّهُ فِي الْآخِرَةِ لَمِنَ الصَّالِحِينَ (27)","hl":[[19,273,1]]}},{"id":"س-05770","fp":"91ceb2770c3d","stateId":385,"easy":"إذا مت ولا ولد لك ← ينقطع اسمك","cause":"مَاتَ وليسَ لَهُ ولَدٌ","result":"انقَطَعَ اسْمُهُ","explicit":true,"ref":"مجمع الزوائد 4/261","srcLabel":"الطبراني","text":["لا يدعُ أحدُكُم طلبَ الولَدِ فَإِنَّ الرَّجُلَ إِذَا ",["مَاتَ وليسَ لَهُ ولَدٌ",1]," ",["انقَطَعَ اسْمُهُ",2]],"grade":"حسن","narrator":"حفصة أم المؤمنين","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني (23/210) (369)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"xml2deXN"},{"id":"س-04314","fp":"b8a1bd7e978d","stateId":386,"easy":"إذا كنت مؤمناً ← تُرفع لك ذريتك لتقرّ عينك","cause":"المُؤمِنُ","result":"تُرفَعُ له ذُرِّيَّتُهُ لِيُقِرَّ اللهُ عزَّ وجلَّ عَيْنَهُ، وإنْ كانوا دونَهُ في العمَلِ","explicit":true,"otherNeedIds":[68],"ref":"تخريج مشكل الآثار 3/ 105","srcLabel":"الحاكم","text":["سأَلْتُ سعيدَ بنَ جُبَيْرٍ عن هذه الآيةِ: (وَالَّذِينَ آمَنُوا وَأَتْبَعْنَاهُمْ ذُرِّيَّاتِهِمْ بِإِيمَانٍ)، قال: قال ابنُ عبَّاسٍ: ",["المُؤمِنُ",1]," ",["تُرفَعُ له ذُرِّيَّتُهُ لِيُقِرَّ اللهُ عزَّ وجلَّ عَيْنَهُ، وإنْ كانوا دونَهُ في العمَلِ",2],"."],"grade":"صحيح","narrator":"سعيد بن جبير","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (3/ 105)، وسعيد بن منصور (2065) واللفظ لهما، والحاكم (3744) بنحوه.","bab":"جنة › درجات الجنة","dorar":"VHrUVFCH"},{"id":"ق-0131","fp":"5e692fa25c0c","stateId":386,"easy":"نذر الذرية لله والدعاء لها بالإعاذة من الشيطان ← القبول الحسن والإنبات الحسن والرزق","cause":"نذر الذرية لله والدعاء لها بالإعاذة من الشيطان","result":"القبول الحسن والإنبات الحسن والرزق","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[51],"ref":"سورة آل عمران: 35–37","srcLabel":"القرآن الكريم","quran":{"s":3,"from":35,"to":37,"text":"إِذْ قَالَتِ امْرَأَتُ عِمْرَانَ رَبِّ إِنِّي نَذَرْتُ لَكَ مَا فِي بَطْنِي مُحَرَّرًا فَتَقَبَّلْ مِنِّي إِنَّكَ أَنْتَ السَّمِيعُ الْعَلِيمُ (35) فَلَمَّا وَضَعَتْهَا قَالَتْ رَبِّ إِنِّي وَضَعْتُهَا أُنْثَى وَاللَّهُ أَعْلَمُ بِمَا وَضَعَتْ وَلَيْسَ الذَّكَرُ كَالْأُنْثَى وَإِنِّي سَمَّيْتُهَا مَرْيَمَ وَإِنِّي أُعِيذُهَا بِكَ وَذُرِّيَّتَهَا مِنَ الشَّيْطَانِ الرَّجِيمِ (36) فَتَقَبَّلَهَا رَبُّهَا بِقَبُولٍ حَسَنٍ وَأَنْبَتَهَا نَبَاتًا حَسَنًا وَكَفَّلَهَا زَكَرِيَّا كُلَّمَا دَخَلَ عَلَيْهَا زَكَرِيَّا الْمِحْرَابَ وَجَدَ عِنْدَهَا رِزْقًا قَالَ يَا مَرْيَمُ أَنَّى لَكِ هَذَا قَالَتْ هُوَ مِنْ عِنْدِ اللَّهِ إِنَّ اللَّهَ يَرْزُقُ مَنْ يَشَاءُ بِغَيْرِ حِسَابٍ (37)","hl":[[0,675,1]]}},{"id":"ق-0203","fp":"fd52c673e96e","stateId":386,"easy":"تقوى الله والقول السديد في أيتام الناس ← حفظ ذرية العبد من بعده","cause":"تقوى الله والقول السديد في أيتام الناس","result":"حفظ ذرية العبد من بعده","explicit":true,"star":true,"ref":"سورة النساء: 9","srcLabel":"القرآن الكريم","quran":{"s":4,"from":9,"to":9,"text":"وَلْيَخْشَ الَّذِينَ لَوْ تَرَكُوا مِنْ خَلْفِهِمْ ذُرِّيَّةً ضِعَافًا خَافُوا عَلَيْهِمْ فَلْيَتَّقُوا اللَّهَ وَلْيَقُولُوا قَوْلًا سَدِيدًا (9)","hl":[[0,142,1]]}},{"id":"ق-0362","fp":"535a76ef9908","stateId":386,"easy":"الإحسان ← الهداية والذرية الصالحة (وكذلك نجزي المحسنين)","cause":"الإحسان","result":"الهداية والذرية الصالحة (وكذلك نجزي المحسنين)","explicit":true,"star":true,"otherNeedIds":[15],"ref":"سورة الأنعام: 84","srcLabel":"القرآن الكريم","quran":{"s":6,"from":84,"to":84,"text":"وَوَهَبْنَا لَهُ إِسْحَاقَ وَيَعْقُوبَ كُلًّا هَدَيْنَا وَنُوحًا هَدَيْنَا مِنْ قَبْلُ وَمِنْ ذُرِّيَّتِهِ دَاوُودَ وَسُلَيْمَانَ وَأَيُّوبَ وَيُوسُفَ وَمُوسَى وَهَارُونَ وَكَذَلِكَ نَجْزِي الْمُحْسِنِينَ (84)","hl":[[0,204,1]]}},{"id":"ق-0736","fp":"9bf936440228","stateId":386,"easy":"صلاح الأب ← حفظ الله ذريته ومالهم","cause":"صلاح الأب","result":"حفظ الله ذريته ومالهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"سورة الكهف: 82","srcLabel":"القرآن الكريم","quran":{"s":18,"from":82,"to":82,"text":"وَأَمَّا الْجِدَارُ فَكَانَ لِغُلَامَيْنِ يَتِيمَيْنِ فِي الْمَدِينَةِ وَكَانَ تَحْتَهُ كَنْزٌ لَهُمَا وَكَانَ أَبُوهُمَا صَالِحًا فَأَرَادَ رَبُّكَ أَنْ يَبْلُغَا أَشُدَّهُمَا وَيَسْتَخْرِجَا كَنْزَهُمَا رَحْمَةً مِنْ رَبِّكَ وَمَا فَعَلْتُهُ عَنْ أَمْرِي ذَلِكَ تَأْوِيلُ مَا لَمْ تَسْطِعْ عَلَيْهِ صَبْرًا (82)","hl":[[103,226,1]]}},{"id":"ق-1269","fp":"52b05b4a14da","stateId":386,"easy":"الإيمان واتباع الذرية بإيمان ← إلحاق الذرية بهم في الجنة بلا نقص","cause":"الإيمان واتباع الذرية بإيمان","result":"إلحاق الذرية بهم في الجنة بلا نقص","explicit":true,"otherNeedIds":[67],"ref":"سورة الطور: 21","srcLabel":"القرآن الكريم","quran":{"s":52,"from":21,"to":21,"text":"وَالَّذِينَ آمَنُوا وَاتَّبَعَتْهُمْ ذُرِّيَّتُهُمْ بِإِيمَانٍ أَلْحَقْنَا بِهِمْ ذُرِّيَّتَهُمْ وَمَا أَلَتْنَاهُمْ مِنْ عَمَلِهِمْ مِنْ شَيْءٍ كُلُّ امْرِئٍ بِمَا كَسَبَ رَهِينٌ (21)","hl":[[0,179,1]]}},{"id":"س-03213","fp":"d29676f7f74c","stateId":386,"easy":"إذا آمنت واتبعتك ذريتك بإيمان ← يرفعهم الله إلى درجتك ولو كانوا دونك","cause":"وَالَّذِينَ آمَنُوا وَ اتَّبَعَتْهُمْ ذُرِّيَّتَهُمْ بِإِيمَانٍ","result":"إنَّ اللهَ لَيرفعُ ذِرِّيَّةَ المؤمنِ إليه في درجتِه ، و إن كانوا دونه في العملِ ، لتَقَرَّ بهم عينُه","explicit":true,"otherNeedIds":[47],"ref":"السلسلة الصحيحة 2490","srcLabel":"الحاكم","text":[["إنَّ اللهَ لَيرفعُ ذِرِّيَّةَ المؤمنِ إليه في درجتِه ، و إن كانوا دونه في العملِ ، لتَقَرَّ بهم عينُه",2]," ، ثم قرأ : ( ",["وَالَّذِينَ آمَنُوا وَ اتَّبَعَتْهُمْ ذُرِّيَّتَهُمْ بِإِيمَانٍ",1]," ) الآية ، ثم قال : و ما نقَصْنا الآباءَ بما أعطينا البنينَ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه البزار كما في ((كشف الأستار)) للهيثمي (2260)، والحاكم (3744)، والبيهقي (21826)","bab":"إيمان › فضل الإيمان","dorar":"TUPICpdt"},{"id":"س-03803","fp":"37c7d0cd9d1d","stateId":387,"easy":"إذا وُلد لك ولد ← فهو ثمرة القلب، وقد يبخّلك ويجبّنك","cause":"وُلِدَ لي غلامٌ","result":"إنَّهم لَمَبْخلةٌ مَجْبَنةٌ مَحْزَنةٌ، وإنَّهم لَثَمرةُ القُلوبِ وقُرَّةُ العَيْنِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[10],"ref":"المستدرك على الصحيحين 7805","srcLabel":"الحاكم","text":[["وُلِدَ لي غلامٌ",1],"، فبُشِّرْتُ بهِ وأنا عندَ النَّبِيِّ صلَّى اللهُ عليه وسلَّمَ، فقُلْتُ: وَدِدْتُ لكم مَكانَه قِطْعةً مِن خُبْزٍ ولحْمٍ، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنْ قُلْتَ ذاكَ، ",["إنَّهم لَمَبْخلةٌ مَجْبَنةٌ مَحْزَنةٌ، وإنَّهم لَثَمرةُ القُلوبِ وقُرَّةُ العَيْنِ",2],"."],"grade":"صحيح","narrator":"الأشعث بن قيس","muhaddith":"صحيح على شرط الشيخين","bab":"بر وصلة › حب الولد","dorar":"CyMgTeof","merged":7,"otherRefs":["تخريج شرح السنة 13/36 (حسن)","صحيح الجامع 7160 (صحيح)","التنوير شرح الجامع الصغير 3/549 (صحيح)","المستدرك على الصحيحين 4835 (صحيح)","مصباح الزجاجة 4/99 (صحيح)","فيض القدير 2/ 403 (صحيح)"]},{"id":"س-03800","fp":"f0f47cb7a243","stateId":387,"easy":"إذا رُزقت الولد ← يبخّلك ويجبّنك، وهو من ريحان الله","cause":"أحَدَ ابنَيِ ابنَتِه","result":"إنَّكم لَتُبَخِّلونَ وتُجَهِّلونَ وتُجَبِّنونَ، وإنَّكم وإنَّكم لَمِن رَيحانِ اللهِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[10],"ref":"معجم الشيوخ 1/414","srcLabel":"أحمد","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ خَرَجَ وهو مُحتَضِنٌ ",["أحَدَ ابنَيِ ابنَتِه",1]," وهو يَقولُ: ",["إنَّكم لَتُبَخِّلونَ وتُجَهِّلونَ وتُجَبِّنونَ، وإنَّكم وإنَّكم لَمِن رَيحانِ اللهِ",2]," عزَّ وجلَّ."],"grade":"صحيح","narrator":"خولة بنت حكيم","muhaddith":"محفوظ من حديث سفيان","takhrij":"أخرجه ابن راهويه في ((مسنده)) (2150) باختلاف يسير، وأحمد (27314)، وفي ((فضائل الصحابة)) (1363)، والحسين بن حرب في ((البر والصلة)) (167) جميعهم بنحوه .","bab":"بر وصلة › حب الولد","dorar":"OXDAwUbs"},{"id":"س-03801","fp":"702313e47748","stateId":387,"easy":"إذا رُزقت الولد ← ففيه قرة عين وأجر إذا قُبض","cause":"هل لك مِن وَلدٍ","result":"فإنَّ فيهم قُرَّةَ عَينٍ، وأجرًا إذا قُبِضوا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[9],"ref":"تخريج المسند لشعيب 21840","srcLabel":"أحمد","text":["قَدِمتُ على رسولِ اللهِ صَلَّى اللهُ عليه وسلَّمَ في وَفدِ كِندةَ، فقال لي: ",["هل لك مِن وَلدٍ",1],"؟ قُلتُ: غُلامٌ وُلِدَ لي في مَخرَجي إليك مِن ابنةِ جَمْدٍ، ولوَدِدتُ أنَّ مَكانَه شِبَعُ القَومِ، قال: لا تَقولَنَّ ذلك؛ ",["فإنَّ فيهم قُرَّةَ عَينٍ، وأجرًا إذا قُبِضوا",2],"، ثُمَّ لئنْ قُلتَ ذاك، إنَّهم لَمَجبَنةٌ مَحزَنةٌ، إنَّهم لمَجبَنةٌ مَحزَنةٌ."],"grade":"صحيح","narrator":"الأشعث بن قيس","muhaddith":"صحيح","takhrij":"أخرجه أحمد (21840) واللفظ له، والطبراني (1/236) (650)، والحاكم (7596) باختلاف يسير","bab":"بر وصلة › حب الولد","dorar":"EUmEfBdL"},{"id":"س-03802","fp":"4928393caac1","stateId":387,"easy":"إذا رُزقت الولد ← فإنهم مجبنة محزنة","cause":"هل لك مِن وَلدٍ","result":"إنَّهم لَمَجبَنةٌ مَحزَنةٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[10],"ref":"تخريج المسند لشعيب 21840","srcLabel":"أحمد","text":["قَدِمتُ على رسولِ اللهِ صَلَّى اللهُ عليه وسلَّمَ في وَفدِ كِندةَ، فقال لي: ",["هل لك مِن وَلدٍ",1],"؟ قُلتُ: غُلامٌ وُلِدَ لي في مَخرَجي إليك مِن ابنةِ جَمْدٍ، ولوَدِدتُ أنَّ مَكانَه شِبَعُ القَومِ، قال: لا تَقولَنَّ ذلك؛ فإنَّ فيهم قُرَّةَ عَينٍ، وأجرًا إذا قُبِضوا، ثُمَّ لئنْ قُلتَ ذاك، ",["إنَّهم لَمَجبَنةٌ مَحزَنةٌ",2],"، إنَّهم لمَجبَنةٌ مَحزَنةٌ."],"grade":"صحيح","narrator":"الأشعث بن قيس","muhaddith":"صحيح","takhrij":"أخرجه أحمد (21840) واللفظ له، والطبراني (1/236) (650)، والحاكم (7596) باختلاف يسير","bab":"بر وصلة › حب الولد","dorar":"EUmEfBdL"},{"id":"س-07070","fp":"dbd86709e2d9","stateId":388,"easy":"إذا عدلت بين أولادك في العطية ← يعدلون معك في البر","cause":"اعدِلوا بيْنَ أولادِكم في النُّحْلِ","result":"كما تُحِبُّون أنْ يعدِلوا بينَكم في البِرِّ واللُّطْفِ","explicit":true,"star":true,"ref":"تخريج صحيح ابن حبان 5104","srcLabel":"متفق عليه","text":["طلَبتْ عَمرةُ بنتُ رواحةَ إلى بَشيرِ بنِ سعدٍ أنْ ينحَلَني نُحْلًا مِن مالِه وإنَّه أبى عليها ثمَّ بدا له بعدَ حَوْلٍ أو حولَيْنِ أنْ يُنحِلَنيه فقال لها: الَّذي سأَلْتِ لابني كُنْتُ منَعْتُكِ وقد بدا لي أنْ أنحَلَه إيَّاه قالت: لا واللهِ لا أرضى حتَّى تأخُذَ بيدِه فتنطلِقَ به إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فتُشهِدَه قال: فأخَذ بيدي فانطلَق بي إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقصَّ عليه القِصَّةَ فقال له النَّبيُّ صلَّى اللهُ عليه وسلَّم: ( هل لك معه ولدٌ غيرُه ؟ ) قال: نَعم قال: ( فهل آتَيْتَ كلَّ واحدٍ منهم مِثْلَ الَّذي آتَيْتَ هذا ؟ ) قال: لا قال: ( فإنِّي لا أشهَدُ على هذا، هذا جَوْرٌ، أشهِدْ على هذا غيري ",["اعدِلوا بيْنَ أولادِكم في النُّحْلِ",1]," ",["كما تُحِبُّون أنْ يعدِلوا بينَكم في البِرِّ واللُّطْفِ",2]],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"إسناده صحيح على شرطهما","takhrij":"أخرجه ابن حبان (5104)، والطبراني في ((المعجم الكبير)) (21/ 71) (69) واللفظ لهما، والبخاري (2650)، ومسلم (15/ 1623) بنحوه.","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"q3JUDlOq","merged":2,"otherRefs":["الجامع الصغير 112 (صحيح)"]},{"id":"س-05872","fp":"087c4b30a191","stateId":388,"easy":"إذا سويت بين أولادك ← يكونون إليك في البر سواء","cause":"أوَ كُلَّ ولدِكَ نحلتَهُ مثلَ هذا","result":"أن يَكونوا إليكَ في البرِّ كلُّهم سواءً","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-02123"],"ref":"نخب الافكار 14/347","srcLabel":"متفق عليه","text":["انطلقَ بي أبي إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ ونحلَني نُحلي ليُشْهِدَهُ على ذلِكَ، فقالَ: ",["أوَ كُلَّ ولدِكَ نحلتَهُ مثلَ هذا",1]," فقالَ: لا . قالَ: أيَسرُّكَ ",["أن يَكونوا إليكَ في البرِّ كلُّهم سواءً",2]," قالَ: بلَى قالَ: فأشهِد علَى هذا غَيري"],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن الجارود في ((المنتقى)) (992) باختلاف يسير، وأخرجه البخاري (2587)، ومسلم (1623) بنحوه","bab":"رقائق وزهد › الوصايا النافعة","dorar":"NseFhEj0"},{"id":"س-02123","fp":"7f934c1dab21","stateId":388,"easy":"إذا سويت بين أولادك في العطية ← يكونون إليك في البر سواء","cause":"أكُلَّ وَلدِكَ نَحَلتَ مِثلَ الذي نَحَلتَ النُّعمانَ","result":"أنْ يكونوا إليك في البِرِّ سَواءً","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-05872","ref":"تخريج المسند لشعيب 18366","text":["حَمَلَني أبي بَشيرُ بنُ سعدٍ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقال: يا رسولَ اللهِ، اشهِدْ أنِّي قد نَحَلتُ النُّعمانَ كذا وكذا، شيئًا سَمَّاه، قال: فقال: ",["أكُلَّ وَلدِكَ نَحَلتَ مِثلَ الذي نَحَلتَ النُّعمانَ",1],"؟ قال: لا، قال: فأشهِدْ غيري، قال: ثُمَّ قال: أليس يَسُرُّكَ ",["أنْ يكونوا إليك في البِرِّ سَواءً",2],"؟ قال: بلى، قال: فلا إذَنْ."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (1623)، والنسائي (3680)، وابن ماجه (2375)، وأحمد (18366) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"yPFLrbTd","merged":2,"otherRefs":["تخريج مشكل الآثار 5075 (صحيح)"]},{"id":"س-07803","fp":"da8be808c21c","stateId":388,"easy":"إذا علّمت ولدك القرآن ← يُكسى والداه يوم القيامة حُلّتين لا تقوم لهما الدنيا","cause":"بتعليمِ وَلَدِكُما القرآنَ","result":"ويُكْسى والِداهُ حُلَّتَيْنِ لا تقومُ لهما الدُّنيا وما فيها","explicit":true,"otherNeedIds":[67,65],"ref":"السلسلة الصحيحة 2829","srcLabel":"الطبراني","text":["يَجيءُ القرآنُ يومَ القيامةِ كالرَّجُلِ الشَّاحِبِ، يقولُ لصاحبِهِ: هل تَعرِفُني؟ أنا الذي كنتُ أُسهِرُ لَيْلَكَ، وأُظْمِئُ هَواجِرَكَ، وإنَّ كلَّ تاجرٍ مِن وراءِ تِجارتِهِ، وأنا لكَ اليومَ مِن وراءِ كلِّ تاجرٍ؛ فيُعطَى المُلْكَ بيمينِهِ، والخُلْدَ بشِمالِهِ، ويوضَعُ على رأسِهِ تاجُ الوقارِ، ",["ويُكْسى والِداهُ حُلَّتَيْنِ لا تقومُ لهما الدُّنيا وما فيها",2],"؛ فيقولانِ: يا ربِّ، أنَّى لنا هذا؟! فيُقالُ: ",["بتعليمِ وَلَدِكُما القرآنَ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن أو صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (5764) مطولاً","bab":"قرآن › فضل قراءة القرآن","dorar":"aHE9inD4","merged":2,"otherRefs":["هداية الرواة 2/374 (حسن)"]},{"id":"س-00323","fp":"2a3fb3123a81","stateId":388,"easy":"إذا أدّبت ولدك أدباً حسناً ← فهو أفضل ما تعطيه","cause":"أدبٍ حسنٍ","result":"ما نحَل والدٌ والِدًا من نُحلٍ أفضلَ","explicit":true,"ref":"الترغيب والترهيب 3/115","srcLabel":"الترمذي","text":[["ما نحَل والدٌ والِدًا من نُحلٍ أفضلَ",2]," من ",["أدبٍ حسنٍ",1]],"grade":"صحيح","narrator":"عمرو بن سعيد بن العاص","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (1952)، وأحمد (15403) باختلاف يسير.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"L0sDtZQm"},{"id":"س-07805","fp":"371af6088881","stateId":388,"easy":"إذا قرأت القرآن وتعلمته وعملت به ← يُلبس والداك تاجاً من نور يوم القيامة","cause":"من قرأ القرآنَ وتعلَّم وعمِل به","result":"أُلْبِس والداه يومَ القيامةِ تاجًا من نورٍ ضوءُه مثلُ الشَّمسِ ويُكسَى والداه حُلَّتَيْن لا يقومُ لهما الدُّنيا","explicit":true,"otherNeedIds":[65],"ref":"الترغيب والترهيب 2/303","srcLabel":"الحاكم","text":[["من قرأ القرآنَ وتعلَّم وعمِل به",1]," ",["أُلْبِس والداه يومَ القيامةِ تاجًا من نورٍ ضوءُه مثلُ الشَّمسِ ويُكسَى والداه حُلَّتَيْن لا يقومُ لهما الدُّنيا",2]," فيقولان بمَ كُسينا هذا فيُقالُ بأخذِ ولدِكما القرآنَ"],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الحاكم (2086)","bab":"قرآن › فضل قراءة القرآن","dorar":"SGvzobAi"}]}