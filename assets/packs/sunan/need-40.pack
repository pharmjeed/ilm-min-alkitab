{"schema":1,"kind":"sunan-chunk","version":"sunan-d4559cab67b4","needId":40,"stateIds":[391,392],"items":[{"id":"س-03834","fp":"e6d4b2003586","stateId":391,"easy":"إذا قطعت رحمك ← يقطعك الله","cause":"مَن قطَعَكِ","result":"وأقطَعَ مَن قطَعَكِ","explicit":true,"star":true,"otherNeedIds":[28],"ref":"تخريج المسند لشعيب 9871","srcLabel":"البخاري","text":["إنَّ الرَّحِمَ شِجنَةٌ مِن الرَّحمنِ، تَقولُ: يا رَبِّ إنِّي قُطِعتُ، يا رَبِّ إنِّي ظُلِمتُ، يا رَبِّ إنِّي أُسيءَ إليَّ، يا رَبِّ، يا رَبِّ، فيُجيبُها رَبُّها عزَّ وجلَّ، فيَقولُ: أمَا تَرضَيْنَ أنْ أصِلَ مَن وصَلَكِ، ",["وأقطَعَ مَن قطَعَكِ",2],"؟ حدَّثَناه أبو الوَليدِ، قال: حدَّثَنا شُعبةُ، عن محمدِ بنِ عَبدِ الجَبَّارِ، قال: سمِعتُ محمدَ بنَ كَعبٍ يَقولُ: سمِعتُ أبا هُرَيرةَ يَقولُ: سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: إنَّ الرَّحِمَ.. فذكَرَ الحَديثَ. وقال عَفَّانُ في حَديثِه: محمدُ بنُ عبدِ الجَبَّارِ مِن الأنصارِ، قال: سمِعتُ محمدَ بنَ كَعبٍ القُرَظيَّ قال: سمِعتُ أبا هُرَيرةَ يَقولُ: سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ.."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5988) بمعناه، وأحمد (9871) واللفظ له","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"Lsmkixfj","merged":10,"otherRefs":["الأربعون الصغرى 73 (صحيح)","صحيح البخاري 4830 (صحيح)","تخريج صحيح ابن حبان 444 (صحيح)","تخريج المسند لشعيب 2953 (صحيح)","المستدرك على الصحيحين 7494 (صحيح)","المستدرك على الصحيحين 3046 (صحيح)","تخريج صحيح ابن حبان 442 (صحيح)","صحيح الأدب المفرد 46 (حسن)","السلسلة الصحيحة 1602 (حسن)"]},{"id":"س-05093","fp":"f372c2bfad4a","stateId":391,"easy":"إذا تهاجرتما فوق ثلاث ← فأنتما ناكبان عن الحق","cause":"تَصارَما فَوقَ ثَلاثٍ","result":"فإنَّهما ناكِبانِ عن الحَقِّ ما داما على صُرامِهما","explicit":true,"star":true,"otherNeedIds":[21],"ref":"تخريج المسند لشعيب 16257","srcLabel":"مسلم","text":["لا يَحِلُّ لِمُسلِمٍ أنْ يَهجُرَ مُسلِمًا فَوقَ ثَلاثِ ليالٍ، فإنْ كان ",["تَصارَما فَوقَ ثَلاثٍ",1],"؛ ",["فإنَّهما ناكِبانِ عن الحَقِّ ما داما على صُرامِهما",2],"، وأوَّلُهما فَيئًا فسَبْقُهُ بالفَيءِ كفَّارَتُهُ، فإنْ سلَّمَ عليه فلم يَرُدَّ عليهِ، ورَدَّ عليه سَلامَهُ؛ رَدَّتْ عليه المَلائكةُ، ورَدَّ على الآخَرِ الشَّيطانُ، فإنْ ماتا على صُرامِهما لم يَجتَمِعا في الجنَّةِ أبَدًا."],"grade":"صحيح","narrator":"هشام بن عامر","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (16257) واللفظ له، والطيالسي (1319)، وأبو يعلى (1557)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"lxjagY10","merged":3,"otherRefs":["صحيح الأدب المفرد 311 (صحيح)","تخريج صحيح ابن حبان 5664 (صحيح)"]},{"id":"س-08073","fp":"22b28f00cea0","stateId":391,"easy":"إذا افترق متحابان في الله ← فبذنب أحدثه أحدهما","cause":"ذَنْب يُحْدِثُهُ أحدُهُما","result":"ما تَوَادَّ اثنانِ في اللهِ عزَّ وجلَّ ، أوْ في الإسلامِ ، فَيُفَرَّقُ بينَهُما","explicit":true,"star":true,"similar":["س-08006"],"ref":"السلسلة الصحيحة 637","srcLabel":"البخاري","text":[["ما تَوَادَّ اثنانِ في اللهِ عزَّ وجلَّ ، أوْ في الإسلامِ ، فَيُفَرَّقُ بينَهُما",2]," إلَّا ",["ذَنْب يُحْدِثُهُ أحدُهُما",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (401)","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"4w7QfcjF"},{"id":"س-03115","fp":"da91ecfa6426","stateId":391,"easy":"إذا قطعت رحمك ← يقطعك الله","cause":"ومَن يَقطَعْها","result":"أقطَعْه","explicit":true,"similar":["س-03920"],"otherNeedIds":[28],"ref":"تخريج المسند لشعيب 1659","srcLabel":"أبو داود","text":["عن إبراهيمَ بنِ عَبدِ اللهِ بنِ قارِظٍ، أنَّ أباهُ حدَّثَهُ أنَّهُ دخَلَ على عَبدِ الرَّحمنِ بنِ عَوفٍ وهو مَريضٌ، فقال له عَبدُ الرَّحمنِ: وصَلَتْكَ رَحِمٌ؛ إنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قال: قال اللهُ عَزَّ وجَلَّ: أنا الرَّحمنُ، خلَقتُ الرَّحِمَ، وشقَقتُ لها مِنَ اسْمي، فمَن يَصِلْها أصِلْهُ، ",["ومَن يَقطَعْها",1]," ",["أقطَعْه",2],"، فأبُتَّهُ -أو قال: مَن يَبُتَّها أبُتَّهُ."],"grade":"صحيح","narrator":"عبدالرحمن بن عوف","muhaddith":"صحيح لغيره","takhrij":"أخرجه من طرق أبو داود (1694)، والترمذي (1907)، وأحمد (1659) واللفظ له","bab":"إيمان › توحيد الأسماء والصفات","dorar":"fpqNXsUY","merged":17,"otherRefs":["صحيح البخاري 5988 (صحيح)","صحيح الأدب المفرد 39 (صحيح)","الجامع الصغير 1759 (صحيح)","تخريج المسند لشعيب 6494 (صحيح)","المستدرك على الصحيحين 7473 (صحيح)","المستدرك على الصحيحين 7478 (صحيح)","صحيح الأدب المفرد 38 (صحيح)","تخريج شرح السنة 3432 (صحيح)","المستدرك على الصحيحين 7479 (صحيح)","الأحاديث المختارة 2588 (صحيح)","صحيح الجامع 3548 (صحيح)","الأحاديث المختارة 894 (صحيح)","صحيح الترمذي 1924 (صحيح)","صحيح الجامع 3549 (صحيح)","تخريج كتاب السنة 536 (صحيح)","صحيح الأدب المفرد 40 (صحيح)"]},{"id":"س-03600","fp":"d113b1c8a318","stateId":391,"easy":"إذا جمعت بين المرأة وعمتها أو خالتها ← قطعتم أرحامكم","cause":"أن تَتَزوَّجَ المَرْأةُ على العَمَّةِ أو على الخالةِ","result":"قَطَعْتُم أرْحامَكم","explicit":true,"ref":"الأحكام الوسطى 3/ 129","srcLabel":"الأحكام الوسطى","text":["نَهى رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ",["أن تَتَزوَّجَ المَرْأةُ على العَمَّةِ أو على الخالةِ",1],"، وقالَ: \"إنَّكم إذا فَعَلْتُم ذلك ",["قَطَعْتُم أرْحامَكم",2],"\"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"ObYkkNou","merged":2,"otherRefs":["شرح البخاري لابن الملقن 24/330 (صحيح)"]},{"id":"س-08006","fp":"fee02b6dd9c6","stateId":391,"easy":"إذا افترق متحابان ← فبذنب أحدثه أحدهما","cause":"بذَنْبٍ يُحْدِثُه أحَدُهُما","result":"ما تَوادَّ اثنانِ ففُرِّقَ بيْنهُما، إلَّا","explicit":true,"repOf":"س-08073","otherNeedIds":[13],"ref":"تخريج المسند لشعيب 5357","text":["المُسلِمُ أخو المُسلِمِ، لا يَظْلِمُه، ولا يَخْذُلُه.\nويقولُ: والَّذي نفْسُ محمَّدٍ بيَدِه، ",["ما تَوادَّ اثنانِ ففُرِّقَ بيْنهُما، إلَّا",2]," ",["بذَنْبٍ يُحْدِثُه أحَدُهُما",1],".\nوكان يقولُ: للمَرءِ المُسلِمِ على أَخيهِ مِنَ المعروفِ سِتٌّ: يُشَمِّتُه إذا عَطَس، ويَعُودُه إذا مَرِض، ويَنصَحُه إذا غابَ، ويَشْهَدُه ويُسَلِّمُ علَيهِ إذا لَقِيَه، ويُجيبُه إذا دَعاهُ، ويَتْبَعُه إذا مات.\nونَهَى عن هِجرةِ المُسلِمِ أَخاهُ فَوْقَ ثلاثٍ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (5357) واللفظ له، وأبو الشيخ في ((التوبيخ والتنبيه)) (32) باختلاف يسير، والخرائطي في ((مكارم الأخلاق)) (759) مختصراً.","bab":"مظالم › تحريم الظلم","dorar":"Z1I8IWmj","merged":2,"otherRefs":["تخريج المسند لشعيب 20689 (صحيح)"]},{"id":"س-03920","fp":"1afc8d1cab39","stateId":391,"easy":"إذا قطعت رحمك ← يقطعك الله","cause":"ومَنْ أشارتْ إليه بقَطْعٍ","result":"قَطَعَهُ اللهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03115","otherNeedIds":[28],"ref":"المستدرك على الصحيحين 3221","text":["عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهُما: {وَاتَّقُوا اللَّهَ الَّذِي تَسَاءَلُونَ بِهِ وَالْأَرْحَامَ} [النساء: 1] قالَ: إنَّ الرَّحِمَ لتُقطَعُ، وإنَّ النِّعمةَ لتُكفَرُ، وإنَّ اللهَ إذا قارَبَ بيْنَ القُلوبِ لمْ يُزَحْزحْها شيءٌ أبدًا. ثُمَّ قَرَأَ: {لَوْ أَنْفَقْتَ مَا فِي الْأَرْضِ جَمِيعًا مَا أَلَّفْتَ بَيْنَ قُلُوبِهِمْ} [الأنفال: 63]. قالَ: وقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «الرَّحِمُ شُعبةٌ مِنَ الرَّحمنِ، وإنَّها تَجيءُ يومَ القيامةِ تَكلَّمُ بلسانٍ طَليقٍ ذَليقٍ، فمَنْ أشارتْ إليه بوَصْلٍ وَصلَهُ اللهُ، ",["ومَنْ أشارتْ إليه بقَطْعٍ",1]," ",["قَطَعَهُ اللهُ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (2953)، والبخاري في ((الأدب المفرد)) (73)، والبيهقي في ((شعب الإيمان)) (7570) بنحوه","bab":"تفسير آيات › سورة النساء","dorar":"z41aGlyP"},{"id":"س-01935","fp":"c7c5850a4923","stateId":391,"easy":"إذا قطعت رحمك ← تدعو عليك: يا رب اقطعه","cause":"منْ قطعنِي","result":"فاقطعْهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"الجامع الصغير 7323","srcLabel":"الطبراني","text":["للرحمِ لسانٌ عندَ الميزانِ،  تقولُ : يا ربِّ ",["منْ قطعنِي",1]," ",["فاقطعْهُ",2],"،  و منْ وصلنِّي فصلْهُ"],"grade":"حسن","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"حسن","takhrij":"أخرجه الطبراني كما في ((جامع المسانيد والسنن)) (927) واللفظ له، والروياني في ((مسنده)) (33)، وابن شاهين في ((الترغيب في فضائل الأعمال)) (568) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"LCEY1ivg"},{"id":"س-05888","fp":"a2d279bd1a78","stateId":392,"easy":"إذا حاولت تقويم المرأة بالكلية ← تكسرها","cause":"إنْ تُقِمْها","result":"تَكسِرْها","explicit":true,"otherNeedIds":[60],"ref":"تخريج المسند لشعيب 10856","srcLabel":"متفق عليه","text":["لا تستَقيمُ لكَ المرأةُ على خَليقةٍ واحِدةٍ، وإنَّما هي كالضِّلعِ، ",["إنْ تُقِمْها",1]," ",["تَكسِرْها",2],"، وإنْ تَترُكْها تستَمتِعْ بها وفيها عِوَجٌ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (5184) دون لفظ: \"لا تستَقيمُ لكَ المرأةُ على خَليقةٍ واحِدةٍ\"، ومسلم (1468) بلفظ: \" لن تستقيم لك على طريقة\"","bab":"رقائق وزهد › الوصايا النافعة","dorar":"pr6A68nJ","merged":2,"otherRefs":["تخريج المسند لشعيب 21339 (حسن)"]},{"id":"س-02902","fp":"2fe0e42a9a7f","stateId":392,"easy":"إذا آذت المرأة زوجها ← تقول زوجته من الحور العين: لا تؤذيه قاتلك الله","cause":"تُؤْذِي امرأةٌ زَوْجَها في الدنيا","result":"إلَّا قالتْ زَوْجَتُهُ مِنَ الحُورِ العِينِ : لا تُؤْذِيهِ قاتَلَكِ اللهِ","explicit":true,"otherNeedIds":[28],"ref":"سير أعلام النبلاء 4/47","srcLabel":"الترمذي","text":["لا ",["تُؤْذِي امرأةٌ زَوْجَها في الدنيا",1]," ، ",["إلَّا قالتْ زَوْجَتُهُ مِنَ الحُورِ العِينِ : لا تُؤْذِيهِ قاتَلَكِ اللهِ",2]," ، فإنَّما هو عندَكَ دَخِيلٌ ، يُوشِكُ أنْ يُفَارِقَكِ إِلَيْنا"],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"إسناده صحيح متصل","takhrij":"أخرجه الترمذي (1174)، وأحمد (22101) واللفظ لهما، وابن ماجه (2014) باختلاف يسير","bab":"إيمان › الوعد","dorar":"pWXDQqms"},{"id":"س-01327","fp":"edd44ad74215","stateId":392,"easy":"إذا أردت إقامة زوجتك على الاستقامة التامة ← كسرتها","cause":"إن ذَهَبتَ تُقيمُه","result":"كَسَرتَه","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"صحيح مسلم 1468","srcLabel":"متفق عليه","text":["مَن كان يُؤمِنُ باللهِ واليَومِ الآخِرِ، فإذا شَهِدَ أمرًا فليَتَكَلَّمْ بخَيرٍ أو ليَسكُتْ، واستَوصوا بالنِّساءِ؛ فإنَّ المَرأةَ خُلِقَت مِن ضِلَعٍ، وإنَّ أعوجَ شيءٍ في الضِّلَعِ أعلاه، ",["إن ذَهَبتَ تُقيمُه",1]," ",["كَسَرتَه",2],"، وإن تَرَكتَه لم يَزَلْ أعوجَ، استَوصوا بالنِّساءِ خَيرًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3331)، ومسلم (1468).","bab":"نكاح › عشرة النساء","dorar":"LoorVBOc","merged":13,"otherRefs":["صحيح ابن حبان 4180 (صحيح)","مجمع الزوائد 4/306 (صحيح)","صحيح البخاري 5184 (صحيح)","المستدرك على الصحيحين 7/ 316 (صحيح)","صحيح مسلم 1468 (صحيح)","الجامع الصغير 2106 (صحيح)","تخريج صحيح ابن حبان 4179 (صحيح)","المستدرك على الصحيحين 7539 (صحيح)","صحيح الأدب المفرد 574 (حسن)","صحيح الجامع 1943 (صحيح)","صحيح الجامع 1942 (حسن)"]},{"id":"س-07162","fp":"dad4c0ca197b","stateId":392,"easy":"إذا لم تستأذن على أهلك ← ترى ما تكره","cause":"إن لَم تستَأذِنْ علَيها","result":"رأيتَ ما تَكْرَهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"فتح الباري لابن حجر 11/27","srcLabel":"البخاري","text":["سألَ رجلٌ حُذَيْفةَ : أستأذِنُ علَى أمِّي ؟ قالَ : ",["إن لَم تستَأذِنْ علَيها",1]," ",["رأيتَ ما تَكْرَهُ",2]],"grade":"صحيح","narrator":"مسلم بن نذير","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (1060)","bab":"علم › حسن السؤال ونصح العالم","dorar":"Xl2drLyl"},{"id":"س-05904","fp":"df442b188138","stateId":392,"easy":"إذا كلفت الأمة الكسب بلا صنعة ← قد تكسب بفرجها","cause":"لا تُكلِّفوا الأَمَةَ غيْرَ ذاتِ الصَّنْعةِ الكَسْبَ","result":"كسَبَتْ بفَرْجِها","explicit":true,"ref":"تخريج مشكل الآثار 2/ 86","srcLabel":"مالك","text":["حدَّثنا مالِكٌ عن عمِّهِ أبي سُهَيلِ بنِ مالِكٍ، عن أبيه: أنَّه سمِع عُثمانَ يخطُبُ وهو يقولُ: ",["لا تُكلِّفوا الأَمَةَ غيْرَ ذاتِ الصَّنْعةِ الكَسْبَ",1],"؛ فإنَّكم متى كلَّفْتُموها ذلك ",["كسَبَتْ بفَرْجِها",2],"، ولا تُكَلِّفوا الصَّغيرَ الكَسْبَ؛ فإنَّه إنْ لمْ يَجِدْ يَسرِقْ، وعِفُّوا إذْ أعَفَّكمُ اللهُ عزَّ وجلَّ، وعليكم منَ المطاعِمِ بما طاب."],"grade":"صحيح","narrator":"أبو سهيل بن مالك عن أبيه","muhaddith":"إسناده صحيح على شرطهما","takhrij":"أخرجه مالك (3595)، والطحاوي في ((مشكل الآثار)) (622)، والبهقي في ((الشعب)) (8228) واللفظ لهم.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"Ad4bkiSS"},{"id":"س-05905","fp":"b1f00ddb67b6","stateId":392,"easy":"إذا كلفت الصغير الكسب ← قد يسرق إن لم يجد","cause":"تُكَلِّفوا الصَّغيرَ الكَسْبَ","result":"فإنَّه إنْ لمْ يَجِدْ يَسرِقْ","explicit":true,"ref":"تخريج مشكل الآثار 2/ 86","srcLabel":"مالك","text":["حدَّثنا مالِكٌ عن عمِّهِ أبي سُهَيلِ بنِ مالِكٍ، عن أبيه: أنَّه سمِع عُثمانَ يخطُبُ وهو يقولُ: لا تُكلِّفوا الأَمَةَ غيْرَ ذاتِ الصَّنْعةِ الكَسْبَ؛ فإنَّكم متى كلَّفْتُموها ذلك كسَبَتْ بفَرْجِها، ولا ",["تُكَلِّفوا الصَّغيرَ الكَسْبَ",1],"؛ ",["فإنَّه إنْ لمْ يَجِدْ يَسرِقْ",2],"، وعِفُّوا إذْ أعَفَّكمُ اللهُ عزَّ وجلَّ، وعليكم منَ المطاعِمِ بما طاب."],"grade":"صحيح","narrator":"أبو سهيل بن مالك عن أبيه","muhaddith":"إسناده صحيح على شرطهما","takhrij":"أخرجه مالك (3595)، والطحاوي في ((مشكل الآثار)) (622)، والبهقي في ((الشعب)) (8228) واللفظ لهم.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"Ad4bkiSS"}]}