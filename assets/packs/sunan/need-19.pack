{"schema":1,"kind":"sunan-chunk","version":"sunan-3f5fd6b9930a","needId":19,"stateIds":[178,179,180,181,182,183,184,185],"items":[{"id":"س-01865","fp":"8cdfcefe1481","stateId":178,"easy":"إذا رحمت اليتيم ومسحت رأسه وأطعمته ← يلين قلبك وتدرك حاجتك","cause":"ارحَمِ اليتيمَ ، و امسَح رأسَه ، وأطْعِمْه من طَعامِك","result":"يَلِنْ قلبُك ، وتُدْرِكْ حاجتَكَ","explicit":true,"similar":["س-01619","س-03780"],"otherNeedIds":[54],"ref":"صحيح الجامع 80","srcLabel":"الطبراني","text":["أتحبُّ أن يلينَ قلبُك ، و تُدْرِكَ حاجتَكَ ؟ ",["ارحَمِ اليتيمَ ، و امسَح رأسَه ، وأطْعِمْه من طَعامِك",1]," ، ",["يَلِنْ قلبُك ، وتُدْرِكْ حاجتَكَ",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه الطبراني كما في ((الترغيب والترهيب)) (3/237)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"cTzTo3dT","merged":4,"otherRefs":["السلسلة الصحيحة 854 (حسن)","صحيح الترغيب 2544 (حسن)","صحيح الجامع 1410 (حسن)"]},{"id":"س-01619","fp":"6d67214e3105","stateId":178,"easy":"إذا قرّبت اليتيم ولاطفته ومسحت رأسه وأطعمته ← يلين قلبك وتُقضى حاجتك","cause":"أَدْنِ اليَتيمَ مِنكَ، وأَلطِفْهُ، وَامسحْ بِرأسِهِ، وَأطعِمْه مِن طَعامِك","result":"فإنَّ ذلكَ يُليِّنُ قلبَكَ، ويُدرِكُ حاجَتَك","explicit":true,"repOf":"س-01865","otherNeedIds":[54],"ref":"صحيح الجامع 250","text":[["أَدْنِ اليَتيمَ مِنكَ، وأَلطِفْهُ، وَامسحْ بِرأسِهِ، وَأطعِمْه مِن طَعامِك؛ ",1],["فإنَّ ذلكَ يُليِّنُ قلبَكَ، ويُدرِكُ حاجَتَك",2],"."],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"حسن","takhrij":"أخرجه الخرائطي في ((مكارم الأخلاق)) (661)، وأبو نعيم في ((حلية الأولياء)) (1/214) باختلاف يسير.","bab":"أطعمة › إطعام الطعام","dorar":"zxkyAT20"},{"id":"س-03780","fp":"b6b5adec3837","stateId":178,"easy":"إذا قرّبت اليتيم ومسحت رأسه وأطعمته ← يلين قلبك وتقدر على حاجتك","cause":"أدنِ اليتيمَ وامسحْ برأسِه وأطعِمْه من طعامِك فإني سمعتُ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يقول وأتاه رجلٌ يشكو إليه قسوةَ القلبِ فقال أَدنِ اليتيمَ وامسحْ برأسِه وأطعِمْه طعامَك","result":"يلِنْ قلبُك وتقدرْ على حاجتِك","explicit":true,"repOf":"س-01865","otherNeedIds":[54],"ref":"السلسلة الصحيحة 2/509","text":["أنَّ أبا الدَّرداءِ كتب إلى سلمانَ يا أخي ",["أدنِ اليتيمَ وامسحْ برأسِه وأطعِمْه من طعامِك فإني سمعتُ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يقول وأتاه رجلٌ يشكو إليه قسوةَ القلبِ فقال أَدنِ اليتيمَ وامسحْ برأسِه وأطعِمْه طعامَك ",1],["يلِنْ قلبُك وتقدرْ على حاجتِك",2]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"إسناد رجاله ثقات غير أبي الحارث محمد بن مصعب ومحمد بن واسع قال ابن المديني: ما أعلمه سمع من أحد من الصحابة","takhrij":"أخرجه الخرائطي في ((مكارم الأخلاق)) (661)، والبيهقي (7176) بنحوه، وعبد الرزاق (20029) بنحوه مطولًا.","bab":"بر وصلة › إعالة اليتيم والضعيف وفضلها","dorar":"kO4vmM7y"},{"id":"س-07174","fp":"d9cc3b070eef","stateId":178,"easy":"إذا قسا قلبك فامسح رأس اليتيم وأطعم المسكين ← يلين قلبك","cause":"امسَحْ رأسَ اليَتيمِ، وأطعمِ المِسكينَ","result":"قَسوةَ قَلْبِه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"فتح الغفار 2133/4","srcLabel":"أحمد","text":["أنَّ رَجُلًا شكا إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم ",["قَسوةَ قَلْبِه",2],"، فقال: ",["امسَحْ رأسَ اليَتيمِ، وأطعمِ المِسكينَ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (9018)، وعبد بن حميد (1424)، والبيهقي (7175) باختلاف يسير","bab":"علم › حسن السؤال ونصح العالم","dorar":"Rv74egrT","merged":3,"otherRefs":["فتح الباري لابن حجر 11/155 (حسن)","فيض القدير 1/109 (صحيح)"]},{"id":"س-07936","fp":"7eca94cb9f27","stateId":179,"easy":"إذا عدت المريض واتبعت الجنائز ← تذكّرك الآخرة","cause":"عودُوا المريضَ ، و اتَّبعُوا الجنائزَ","result":"تُذكِّرُكُمُ الآخِرةَ","explicit":true,"star":true,"ref":"صحيح الأدب المفرد 403","srcLabel":"البخاري","text":[["عودُوا المريضَ ، و اتَّبعُوا الجنائزَ",1]," ؛ ",["تُذكِّرُكُمُ الآخِرةَ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (518) واللفظ له، وأخرجه أحمد (11445)، وابن حبان (2955) باختلاف يسير","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"YgxcjUgO","merged":4,"otherRefs":["تخريج المسند لشعيب 11180 (صحيح)","تخريج المسند لشعيب 11270 (صحيح)","مجمع الزوائد 3/32 (حسن)"]},{"id":"س-03597","fp":"74dfc8013a14","stateId":179,"easy":"إذا زرت القبور ← ففيها عبرة","cause":"فزُوروها","result":"فإنَّ فيها عِبرةً","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 1404","srcLabel":"مسلم","text":["نَهَيتُكُم عنْ زِيارةِ القُبورِ، ",["فزُوروها",1],"؛ ",["فإنَّ فيها عِبرةً",2],"، ونَهَيتُكُم عنِ النَّبيذِ، ألَا فانبِذوا، ولا أُحِلُّ مُسكِرًا، ونَهَيتُكُم عنْ لُحومِ الأضاحي، فكُلوا وادَّخِروا."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه البيهقي (7276) بلفظه، ومالك (1767) مطولا ، وأحمد (11329) كلاهما بلفظ مقارب.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"iqXK3SoO","merged":3,"otherRefs":["أحكام الجنائز 228 (صحيح)","تسديد القوس 2/420 (صحيح)"]},{"id":"س-07636","fp":"627bdc4119a4","stateId":179,"easy":"إذا زرت القبور ← تذكّرك بالموت","cause":"فزوروا القبورَ","result":"فإنَّها تذَكِّرُ بالموتِ","explicit":true,"star":true,"similar":["س-05420"],"ref":"صحيح أبي داود 3234","srcLabel":"مسلم","text":["أتى رسولُ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّمَ قبرَ أمِّهِ فبَكى وأبْكى من حولَهُ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّمَ استأذنتُ ربِّي تعالى على أن أستغفرَ لَها فلم يؤذَن لي فاستأذنتُ أن أزورَ قبرَها فأذنَ لي ",["فزوروا القبورَ",1]," ",["فإنَّها تذَكِّرُ بالموتِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (976)، وأبو داود (3234) واللفظ له، والنسائي (2034)، وابن ماجه (1572)","bab":"فضائل النبي وصفته ودلائل النبوة › والدي النبي صلى الله عليه وسلم","dorar":"SnhFubXL","merged":3,"otherRefs":["التمهيد 20/239 (صحيح)","معارج القبول 517/2 (صحيح)"]},{"id":"س-05558","fp":"f8a543929f7d","stateId":179,"easy":"إذا زرت القبور ← تزهّدك في الدنيا وترغّبك في الآخرة","cause":"فزُوروها","result":"فإنَّها تُزهِّدُ في الدُّنيا وتُرغِّبُ في الآخرةِ","explicit":true,"ref":"صحيح ابن حبان 981","srcLabel":"الحاكم","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم خرَج يومًا فخرَجْنا معه حتَّى انتهَيْنا إلى المقابِرِ فأمَرَنا فجلَسْنا ثمَّ تخطَّى القبورَ حتَّى انتهى إلى قبرٍ منها فجلَس إليه فناجاه طويلًا ثمَّ رجَع رسولُ اللهِ صلَّى اللهُ عليه وسلَّم باكيًا فبكَيْنا لبكاءِ رسولِ اللهِ ثمَّ أقبَل علينا فتلقَّاه عُمَرُ - رضوانُ اللهِ عليه - وقال : ما الَّذي أبكاكَ يا رسولَ اللهِ فقد أبكَيْتَنا وأفزَعْتَنا ؟ فأخَذ بيدِ عُمَرَ ثمَّ أقبَل علينا فقال : ( أفزَعكم بكائي ) ؟ قُلْنا : نَعم فقال : ( إنَّ القبرَ الَّذي رأَيْتُموني أُناجي قبرُ آمِنَةَ بنتِ وَهْبٍ وإنِّي سأَلْتُ ربِّي الاستغفارَ لها فلَمْ يأذَنْ لي فنزَل علَيَّ : {مَا كَانَ لِلنَّبِيِّ وَالَّذِينَ آمَنُوا أَنْ يَسْتَغْفِرُوا لِلْمُشْرِكِينَ} [التوبة: 113] فأخَذني ما يأخُذُ الولَدَ للوالدِ مِن الرِّقَّةِ فذلكَ الَّذي أبكاني ألَا وإنِّي كُنْتُ نهَيْتُكم عن زيارةِ القبورِ ",["فزُوروها",1]," ",["فإنَّها تُزهِّدُ في الدُّنيا وتُرغِّبُ في الآخرةِ",2]," )"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (2487)، والحاكم (3292)، وأبو نعيم في ((تاريخ أصبهان)) (1/442) باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"2beGAvg4","merged":3,"otherRefs":["الترغيب والترهيب 4/273 (صحيح)","مجموع فتاوى ابن باز 398/1 (صحيح)"]},{"id":"س-03640","fp":"46e52cab3843","stateId":179,"easy":"إذا زرت القبور ← ترقّ قلبك وتدمع عينك وتذكّرك الآخرة","cause":"ألا فزورُوها","result":"فإِنَّها تُرِقُّ القلْبَ ، و تُدْمِعُ العينَ ، وتُذَكِّرُ الآخرةَ","explicit":true,"ref":"صحيح الجامع 4584","srcLabel":"أحمد","text":["كنتُ نهيتُكم عن زيارَةِ القبورِ ",["ألا فزورُوها",1]," ، ",["فإِنَّها تُرِقُّ القلْبَ ، و تُدْمِعُ العينَ ، وتُذَكِّرُ الآخرةَ",2]," ، ولا تقولوا هُجْرًا"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه أحمد (13487)، وأبو يعلى (3707) مطولاً، والحاكم (1393) واللفظ له","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"OtTyO1IY"},{"id":"س-05420","fp":"7c6cb0bc003d","stateId":179,"easy":"إذا زرت القبور ← تذكر بها الآخرة","cause":"زُرِ القبورَ","result":"تذكُرْ بها الآخرةَ","explicit":true,"repOf":"س-07636","ref":"الترغيب والترهيب 4/258","text":[["زُرِ القبورَ",1]," ",["تذكُرْ بها الآخرةَ",2]," ، واغسِلِ الموتَى فإنَّ معالجةَ جسدٍ خاوٍ موعظةٌ بليغةٌ ، وصَلِّ على الجنائزِ لعلَّ ذلك أن يُحزِنَك ، فإنَّ الحزينَ في ظلِّ اللهِ يتعرَّضُ كلَّ خيرٍ"],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"رواته ثقات","takhrij":"أخرجه ابن شاهين في ((الترغيب في فضائل الأعمال)) (470)، والحاكم (1395)، والبيهقي في ((شعب الإيمان)) (9291) واللفظ له","bab":"رقائق وزهد › الحزن والبكاء","dorar":"0jjgBRRb"},{"id":"س-05421","fp":"7f5e5cd328d4","stateId":179,"easy":"إذا غسّلت الموتى ← فهي موعظة بليغة لقلبك","cause":"واغسِلِ الموتَى","result":"فإنَّ معالجةَ جسدٍ خاوٍ موعظةٌ بليغةٌ","explicit":true,"ref":"الترغيب والترهيب 4/258","srcLabel":"الحاكم","text":["زُرِ القبورَ تذكُرْ بها الآخرةَ ، ",["واغسِلِ الموتَى",1]," ",["فإنَّ معالجةَ جسدٍ خاوٍ موعظةٌ بليغةٌ",2]," ، وصَلِّ على الجنائزِ لعلَّ ذلك أن يُحزِنَك ، فإنَّ الحزينَ في ظلِّ اللهِ يتعرَّضُ كلَّ خيرٍ"],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"رواته ثقات","takhrij":"أخرجه ابن شاهين في ((الترغيب في فضائل الأعمال)) (470)، والحاكم (1395)، والبيهقي في ((شعب الإيمان)) (9291) واللفظ له","bab":"رقائق وزهد › الحزن والبكاء","dorar":"0jjgBRRb"},{"id":"س-05869","fp":"438e2e1e389a","stateId":179,"easy":"إذا دخلت الحمّام ← يذهب الوسخ ويذكّرك النار","cause":"الحمَّامُ","result":"يُذهِبُ الوسخَ ويُذَكِّرُ النارَ","explicit":true,"ref":"إتحاف الخيرة المهرة 1/299","srcLabel":"البيهقي","text":["عن أبي هريرةَ قال: نِعمَ البيتُ ",["الحمَّامُ",1]," ، ",["يُذهِبُ الوسخَ ويُذَكِّرُ النارَ",2]],"grade":"حسن","narrator":"أبو زرعة بن عمرو بن جرير","muhaddith":"إسناده رجاله ثقات","takhrij":"أخرجه مسدد كما في ((إتحاف الخيرة المهرة)) للبوصيري (1/299) واللفظ له، وابن أبي شيبة (1176)، والبيهقي في ((شعب الإيمان)) (7390)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"vJvFaXTI"},{"id":"س-04023","fp":"b719695a0e06","stateId":180,"easy":"إذا أذنبت ثم تبت ونزعت واستغفرت ← يُصقل قلبك","cause":"فإنْ تابَ ونَزَعَ واستغفرَ","result":"سُقِلَ منها قلبُهُ","explicit":true,"similar":["س-04047"],"ref":"المستدرك على الصحيحين 3956","srcLabel":"مسلم","text":["«إنَّ المؤمنَ إذا أَذنبَ ذنبًا كانتْ نُكْتةٌ سوداءُ في قلبِهِ، ",["فإنْ تابَ ونَزَعَ واستغفرَ",1]," ",["سُقِلَ منها قلبُهُ",2],"، وإنْ زادَ زادتْ حتَّى يَعْلَقَ بها قلبُهُ، فذلك الرَّانُ الَّذي ذَكَرَ اللهُ في كتابِهِ: {كَلَّا بَلْ رَانَ عَلَى قُلُوبِهِمْ مَا كَانُوا يَكْسِبُونَ} [المطففين: 14]»."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حديث عال صحيح على شرط مسلم","takhrij":"أخرجه ابن ماجه (4244)، وأحمد (7952)باختلاف يسير، والترمذي (3334) بنحوه","bab":"توبة › الحض على التوبة","dorar":"pb9RPEYz"},{"id":"س-04047","fp":"3f3dfff171d2","stateId":180,"easy":"إذا أقلعت واستغفرت وتبت ← يُصقل قلبك","cause":"فإن هو نزَع واستغفَر وتاب","result":"صُقِل قلبُه","explicit":true,"repOf":"س-04023","ref":"التنوير شرح الجامع الصغير 3/509","text":["إنَّ العَبْدَ إذا أخطأَ خطيئةً نُكِتتْ في قلبِه نُكْتةٌ سَوْداءُ، ",["فإن هو نزَع واستغفَر وتاب",1]," ",["صُقِل قلبُه",2],"، وإن عادَ زِيدَ فيها حتَّى تعلُوَ على قلبِه؛ وهو الرَّانُ [الَّذي] ذكَر اللهُ تعالى: {كَلَّا بَلْ رَانَ عَلَى قُلُوبِهِمْ مَا كَانُوا يَكْسِبُونَ} [المطففين: 14]."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أسانيده صحيحة","takhrij":"أخرجه الترمذي (3334)، والطبري في ((تفسيره)) (24/ 200)، والخرائطي في ((اعتلال القلوب)) (55) واللفظ لهم.","bab":"توبة › سقوط الذنوب بالاستغفار والتوبة","dorar":"Ie0XLKlA","merged":2,"otherRefs":["تفسير آيات أشكلت 1/383 (صحيح)"]},{"id":"س-00786","fp":"1faf218abf6e","stateId":180,"easy":"إذا غشي قلبك ما يغشاه فاستغفر الله مائة مرة ← يُجلى قلبك","cause":"أستَغفِرَ اللهَ مِائةَ مَرَّةٍ","result":"إنَّه لَيُغانُ على قَلبي","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"apply":{"k":"count","t":"مائة مرة"},"similar":["س-04024"],"otherNeedIds":[12],"ref":"تخريج المسند لشعيب 17849","srcLabel":"أحمد","text":["«",["إنَّه لَيُغانُ على قَلبي",2]," حَتَّى ",["أستَغفِرَ اللهَ مِائةَ مَرَّةٍ",1],"»."],"grade":"صحيح","narrator":"الأغر","muhaddith":"إسناده صحيح","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"eBzvOkFR","merged":2,"otherRefs":["العواصم من القواصم 30 (صحيح)"]},{"id":"س-04024","fp":"8eee23d3c5eb","stateId":180,"easy":"إذا غشي قلبك غفلة فاستغفر الله مائة مرة في اليوم ← يصفو قلبك","cause":"لَأستَغفِرُ اللهَ","result":"إنَّه لَيُغانُ على قَلبي","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"apply":{"k":"count","t":"مائة مرة"},"repOf":"س-00786","otherNeedIds":[11],"ref":"تخريج المسند لشعيب 18291","text":["«",["إنَّه لَيُغانُ على قَلبي",2],"، وإنِّي ",["لَأستَغفِرُ اللهَ",1]," كُلَّ يَومٍ مِائةَ مَرَّةٍ»"],"grade":"صحيح","narrator":"الأغر المزني","muhaddith":"إسناده صحيح","bab":"توبة › الحض على التوبة","dorar":"7TDin1aB"},{"id":"س-00494","fp":"cc7135bd3475","stateId":181,"easy":"إذا صلح قلبك ← صلح جسدك كله","cause":"إذا صَلَحَت","result":"صَلَحَ الجَسَدُ كُلُّه","explicit":true,"star":true,"ref":"صحيح مسلم 1599","srcLabel":"متفق عليه","text":["سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ -وأهوى النُّعمانُ بإصبَعَيه إلى أُذُنَيه-: إنَّ الحَلالَ بَيِّنٌ، وإنَّ الحَرامَ بَيِّنٌ، وبينَهما مُشتَبِهاتٌ لا يَعلَمُهنَّ كَثيرٌ مِنَ النَّاسِ، فمَنِ اتَّقى الشُّبُهاتِ استَبرَأ لدينِه وعِرضِه، ومَن وقَعَ في الشُّبُهاتِ وقَعَ في الحَرامِ، كالرَّاعي يَرعى حَولَ الحِمى، يوشِكُ أن يَرتَعَ فيه، ألا وإنَّ لكُلِّ مَلِكٍ حِمًى، ألا وإنَّ حِمى اللهِ مَحارِمُه، ألا وإنَّ في الجَسَدِ مُضغةً ",["إذا صَلَحَت",1]," ",["صَلَحَ الجَسَدُ كُلُّه",2],"، وإذا فسَدَت فسَدَ الجَسَدُ كُلُّه، ألا وهي القَلبُ."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (52)، ومسلم (1599).","bab":"آداب عامة › ضرب الأمثال","dorar":"3ItFLlck","merged":3,"otherRefs":["حلية الأولياء 8/144 (صحيح)","الفتاوى الكبرى 1/95 (صحيح)"]},{"id":"س-07057","fp":"8101903bde1f","stateId":181,"easy":"إذا دخل العلم قلبك فرسخ فيه ← ينفعك","cause":"إذا دخلَ في قَلبٍ فرسخَ فيهِ","result":"نفعَ","explicit":true,"star":true,"ref":"صحيح ابن خزيمة 1/582","srcLabel":"متفق عليه","text":["جاءَ نَهيكُ بنُ سنانٍ إلى عبدِ اللَّهِ فقالَ: كيفَ تجدُ هذا الحرفَ {مِنْ مَاءٍ غَيْرِ آسِنٍ} أو يَاسِنٍ؟ فقالَ: أَكُلَّ القرآنِ أحصيتَ إلَّا هذا؟ قالَ: إنِّي لأقرأُ المفصَّلَ في رَكْعةٍ، فقالَ عبدُ اللَّهِ: هذًّا كَهَذِّ الشِّعرِ إنَّ أقوامًا يقرءونَ القرآنَ بألسِنتِهِم لا يعدو تراقيَهُم، ولَكِنَّهُ ",["إذا دخلَ في قَلبٍ فرسخَ فيهِ",1]," ",["نفعَ",2],"، وإنَّ أخيرَ الصَّلاةِ الرُّكوعُ والسُّجودُ، وإنِّي أعلمُ النَّظائرَ الَّتي كانَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقرأُ بِهِنَّ سورتينِ في رَكْعةٍ، ثمَّ أخذَ بيدِ علقمةَ فدخلَ ثمَّ خرجَ فعدَّهنَّ علَينا قالَ الأعمشُ: وَهيَ عشرونَ سورةً على تأليفِ عبدِ اللَّهِ أوَّلُهُنَّ الرَّحمنُ وآخرتُهُنَّ الدُّخانُ: الرَّحمنُ، والنَّجمُ، والذَّارياتُ، والطُّورُ هذِهِ النَّظائرُ، واقتَربتِ والحاقَّةُ، والواقِعةُ، ون والنَّازعاتُ وسَأَلَ سَائِلٌ، والمدَّثِّرُ، والمزَّمِّلُ، وويلٌ للمطفِّفينَ، وعَبَسَ ولا أُقْسِمُ، وَهَلْ أَتَى، والمرسلاتُ، وعمَّ يَتَسَاءَلونَ، وإذا الشَّمْسُ كُوِّرَتْ، والدُّخَانُ وفي روايةٍ إلى قولِهِ: فَدخلَ عَلقمةُ، فَسألَهُ، ثمَّ خَرجَ إلَينا، فقالَ: عِشرونَ سورَةً مِن أوَّلِ المفصَّلِ في تأليفِ عبدِ اللَّهِ لم يَزيدوا علَى هذا"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (722)، وأحمد (3607) بنحوه، والبخاري (742) مختصرا","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"f0brTVoX","merged":2,"otherRefs":["مجمع الزوائد 2/132 (صحيح)"]},{"id":"س-07285","fp":"9499f3a77430","stateId":181,"easy":"إذا أنكر قلبك الفتنة ← تُنكت فيه نكتة بيضاء","cause":"فأيُّ قلْبٍ أنْكَرَها","result":"نُكِتَت في قلْبِه نُكتةٌ بَيضاءُ","explicit":true,"ref":"المستدرك على الصحيحين 8667","srcLabel":"مسلم","text":["عن حُذَيفةَ رَضيَ اللهُ عنه، قال: تُعرَضُ فُتنةٌ على القلوبِ، ",["فأيُّ قلْبٍ أنْكَرَها",1]," ",["نُكِتَت في قلْبِه نُكتةٌ بَيضاءُ",2],"، وأيُّ قلْبٍ لم يُنكِرْها نُكِتَت في قلْبِه نُكتةٌ سَوداءُ، ثمَّ تُعرَضُ فِتنةٌ أُخرى على القلوبِ، فإنْ أنْكَرَها القلبُ الَّذي أنْكَرها في المرَّةِ الأُولى نُكِتَت نُكتةٌ بَيضاءُ، وإنْ لم يُنكِرْها نُكِتَت نُكتةٌ سَوداءُ، ثمَّ تُعرَضُ فِتنةٌ أُخرى على القلوبِ، فإنْ أنْكَرَها الَّذي أنْكَرَها في المرَّتينِ الأُولَيَينِ اشتَدَّ وابيَضَّ وَصْفًا، ولم تَضُرَّه فِتنةٌ أبدًا، وإنْ لم يُنكِرْها في المرَّتينِ الأُولَيَينِ اسوَدَّ وارتَدَّ ونَكَسَ، فلا يَعرِفُ حقًّا ولا يُنكِرُ مُنكَرًا."],"grade":"صحيح","narrator":"نبيط بن شريط","muhaddith":"صحيح على شرط الشيخين، ولم يخرجاه","takhrij":"أخرجه مسلم (144)، وأحمد (23280)، ونعيم بن حماد في ((الفتن)) (109) جميعهم بنحوه.","bab":"فتن › ظهور الفتن","dorar":"RjWDq4NC"},{"id":"س-05637","fp":"c9902cebaf8d","stateId":181,"easy":"إذا أخلصت العمل لله ونصحت الأئمة ولزمت الجماعة ← لا يدخل قلبك غلّ","cause":"إخلاصُ العَمَلِ للهِ، والنُّصحُ لِأئِمَّةِ المُسلِمينَ، واللُّزومُ لِجَماعَتِهم","result":"ثَلاثٌ لا يَغِلُّ عليهِنَّ قَلبُ امرِئٍ مُسلِمٍ","explicit":true,"similar":["س-04742"],"ref":"الترغيب والترهيب 4/162","srcLabel":"أبو داود","text":["رَحِمَ اللهُ مَن سَمِعَ مَقالَتي حتى يُبَلِّغَها غَيرَه: ",["ثَلاثٌ لا يَغِلُّ عليهِنَّ قَلبُ امرِئٍ مُسلِمٍ",2],": ",["إخلاصُ العَمَلِ للهِ، والنُّصحُ لِأئِمَّةِ المُسلِمينَ، واللُّزومُ لِجَماعَتِهم",1],"، فإنَّ دُعاءَهم يُحيطُ مِن وَرائِهم، إنَّه مَن تَكُنِ الدُّنيا نِيَّتَه يَجعَلِ اللهُ فَقرَه بَينَ عَينَيْه، ويُشَتِّتُ عليه ضَيعَتَه، ولا يأتيه منها إلَّا ما كُتِبَ له، ومَن تَكُنِ الآخِرةُ نِيَّتَه يَجعَلِ اللهُ غِناهُ في قَلبِه ويَكفيه ضَيعَتَه، وتأتيه الدُّنيا وهي راغِمةٌ."],"grade":"صحيح","narrator":"زيد بن ثابت","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (3660) باختلاف يسير دون قوله: \"ثلاث لا يغل ...\"، وابن ماجه (230، 4105) مفرقاً باختلاف يسير، وأحمد (21590) باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"jihas9WH","merged":4,"otherRefs":["صحيح الترغيب 4 (صحيح)","الأباطيل والمناكير 1/236 (حسن)","تخريج المسند لشعيب 13350 (صحيح)"]},{"id":"س-04742","fp":"fba182ccf5d2","stateId":181,"easy":"إذا أخلصت العمل وأطعت ولاة الأمر ولزمت الجماعة ← لا يدخل قلبك غلّ","cause":"إخلاصُ العَمَلِ، وطاعةُ ذوي الأمرِ، ولُزومُ الجَماعةِ","result":"ثَلاثٌ لا يَغِلُّ عليهِنَّ قَلبُ المُؤمِنِ","explicit":true,"repOf":"س-05637","ref":"تخريج المسند لشعيب 16754","text":["سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسَلَّمَ وهو يَخطُبُ النَّاسَ بِالخَيْفِ: نَضَّرَ اللهُ عَبدًا سَمِعَ مَقالَتي، فَوَعاها، ثم أدَّاها إلى مَن لم يَسمَعْها، فرُبَّ حامِلِ فِقهٍ لا فِقهَ له، ورُبَّ حامِلِ فِقهٍ إلى مَن هو أفقَهُ منه. ",["ثَلاثٌ لا يَغِلُّ عليهِنَّ قَلبُ المُؤمِنِ",2],": ",["إخلاصُ العَمَلِ، وطاعةُ ذوي الأمرِ، ولُزومُ الجَماعةِ",1],"؛ فإنَّ دَعوَتَهم تَكونُ مِن ورائِهِ. وعنِ ابنِ إسحاقَ قال: حَدَّثَني عَمْرُو بنُ أبي عَمْرٍو، مَولى المُطَّلِبِ، عن عَبدِ الرَّحمنِ بنِ الحُوَيرِثِ، عن محمدِ بنِ جُبَيرِ بنِ مُطعِمٍ، عن أبيهِ، مِثلَ حَديثِ ابنِ شِهابٍ، لم يَزِدْ، ولم يَنقُصْ."],"grade":"صحيح","narrator":"جبير بن مطعم","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (231)، وأحمد (16754) واللفظ له","bab":"رقائق وزهد › الإخلاص","dorar":"RM7YQLlk","merged":2,"otherRefs":["جامع العلوم والحكم 1/217 (حسن)"]},{"id":"س-02672","fp":"5e3a3ca1dc72","stateId":181,"easy":"إذا قمت ليلتي العيدين محتسباً ← لا يموت قلبك يوم تموت القلوب","cause":"مَن قامَ ليلَتَي العيدَينِ مُحتَسِبًا","result":"لم يَمُتْ قَلبُه يَومَ تَموتُ القُلوبُ","explicit":true,"ref":"الفروع لابن مفلح 2/ 408","srcLabel":"ابن ماجه","text":["\"",["مَن قامَ ليلَتَي العيدَينِ مُحتَسِبًا ",1],["لم يَمُتْ قَلبُه يَومَ تَموتُ القُلوبُ\"",2],"."],"grade":"حسن","narrator":"أبو أمامة","muhaddith":"حسن","takhrij":"أخرجه ابن ماجه (1782) بلفظه.","bab":"إيمان › الاحتساب والنية","dorar":"uc9baLP0"},{"id":"س-03809","fp":"0c7f9e18074d","stateId":181,"easy":"إذا استقام لسانك ← يستقيم قلبك","cause":"حتى يَسْتَقِيمَ لسانُهُ","result":"ولا يَسْتَقِيمُ قلبُهُ","explicit":true,"ref":"صحيح الترغيب 2865","srcLabel":"أحمد","text":["لا يَسْتَقِيمُ إِيمانُ عبدٍ حتى يَسْتَقِيمَ قلبُهُ ، ",["ولا يَسْتَقِيمُ قلبُهُ",2]," ",["حتى يَسْتَقِيمَ لسانُهُ",1]," ، ولا يدخلُ الجنةَ رجلٌ لا يَأْمَنُ جارُهُ بَوَائِقَهُ ."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"أخرجه أحمد (13048)، وابن أبي الدنيا في ((الصمت)) (9) واللفظ لهما، والقضاعي في ((مسند الشهاب)) (887) بلفظه مختصرًا.","bab":"بر وصلة › حق الجار والوصاة به","dorar":"PcpzO09G"},{"id":"س-05586","fp":"eb3357d1a32d","stateId":181,"easy":"إذا لازمت الحزن (الخشية) ← فهو مفتاح القلب","cause":"عليكم بالحزنِ","result":"فإنَّه مِفتاحُ القلبِ","explicit":true,"ref":"مجمع الزوائد 10/313","srcLabel":"الطبراني","text":[["عليكم بالحزنِ ",1],["فإنَّه مِفتاحُ القلبِ",2]," قالوا يا رسولَ اللهِ وكيف الحزنُ قال أجيعوا أنفسَكم بالجوعِ وأظمِئوها"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني (11/268) (11694)، وابن بشران في ((الأمالي)) (1207)، والديلمي في ((الفردوس)) (4028) باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"mRqCnYb0"},{"id":"س-02276","fp":"146086f3885b","stateId":181,"easy":"إذا سلم قلبك وصحّ ← سلم سائر جسدك وصحّ","cause":"إذا سَلِمَتْ وصَحَّتْ","result":"سَلِمَ سائرُ الجَسدِ وصَحَّ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"تخريج المسند لشعيب 18412","srcLabel":"أحمد","text":["إنَّ في الإنسانِ مُضغةً، ",["إذا سَلِمَتْ وصَحَّتْ",1],"؛ ",["سَلِمَ سائرُ الجَسدِ وصَحَّ",2],"، وإذا سَقِمَتْ؛ سَقِمَ سائرُ الجَسدِ وفَسَدَ، ألَا وهي القَلبُ."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"صحيح","takhrij":"أخرجه أحمد (18412) واللفظ له، وعبد الرزاق (20376)، والطبراني (21/67) (63)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"vJpWupDm"},{"id":"س-03777","fp":"bd5cf08ea0b2","stateId":182,"easy":"إذا قلت «اللهم إني أعوذ بك أن أشرك وأنا أعلم...» ← تبرأ من قليل الشرك وكثيره","cause":"قُلْ: اللَّهُمَّ إنِّي أعوذُ بك أن أُشرِكَ وأنا أعلَمُ، وأستَغفِرُك لِما لا أعلَمُ","result":"ألا أُخبِرُك بشَيءٍ إذا قُلْتَه بَرِئْتَ مِن قَليلِه وكثيرِه وصغيرِه","explicit":true,"star":true,"apply":{"k":"say","t":"«اللَّهُمَّ إنِّي أعوذُ بك أن أُشرِكَ وأنا أعلَمُ، وأستَغفِرُك لِما لا أعلَم»"},"ref":"الأحاديث المختارة 62","srcLabel":"متفق عليه","text":["«الشِّرْكُ أخفى في أمَّتي من دَبيبِ النَّمْلِ على الصَّفا، قال: فقال أبو بَكرٍ: يا رَسولَ اللهِ وكيف النَّجاءُ والمَخْرَجُ مِن ذلك؟ قال: ",["ألا أُخبِرُك بشَيءٍ إذا قُلْتَه بَرِئْتَ مِن قَليلِه وكثيرِه وصغيرِه",2],". قال: بلى يا رَسولَ اللهِ. قال: ",["قُلْ: اللَّهُمَّ إنِّي أعوذُ بك أن أُشرِكَ وأنا أعلَمُ، وأستَغفِرُك لِما لا أعلَمُ».",1]],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"الكفر والشرك › ذم الشرك وما ورد فيه من العقوبة","dorar":"qPz0sfRh","merged":2,"otherRefs":["صحيح الأدب المفرد 551 (صحيح)"]},{"id":"س-07124","fp":"93322b0d3eee","stateId":182,"easy":"إذا قلت «اللهم إنا نعوذ بك أن نشرك بك شيئاً نعلمه ونستغفرك لما لا نعلمه» ← تتقي الشرك الخفي","cause":"قولوا اللهمَّ إنا نعوذُ بك مِن أن نُشْرِكَ شيئًا نعلَمُه ونستغفِرُك لِما لا نعلَمُه","result":"اتَّقوا هذا الشِّركَ فإنَّه أخفى مِن دَبيبِ النَّملِ","explicit":true,"star":true,"apply":{"k":"say","t":"«اللهم إنا نعوذ بك أن نشرك بك شيئاً نعلمه ونستغفرك لما لا نعلمه»"},"ref":"مجمع الزوائد 10/226","srcLabel":"البخاري","text":["خطَبَنا أبو موسى الأشعريُّ فقال يا أيُّها النَّاسُ ",["اتَّقوا هذا الشِّركَ فإنَّه أخفى مِن دَبيبِ النَّملِ",2]," فقام إليه عبدُ اللهِ بنُ حَزْنٍ وقَيسُ بنُ المُضارِبِ فقالا واللهِ لتَخْرُجَنِّ ممَّا قلتَ أو لنأتيَنَّ عمرَ مأذونًا لنا أو غيرَ مأذونٍ فقال بل أخرُجُ ممَّا قلتُ خطَبَنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ذاتَ يومٍ فقال يا أيُّها النَّاسُ اتَّقوا هذا الشِّركَ فإنَّه أخفى مِن دَبيبِ النَّملِ فقال له مَن شاء اللهُ أن يقولَ وكيف نتَّقيه وهو أخفى مِن دَبيبِ النَّملِ يا رسولَ اللهِ قال ",["قولوا اللهمَّ إنا نعوذُ بك مِن أن نُشْرِكَ شيئًا نعلَمُه ونستغفِرُك لِما لا نعلَمُه",1]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"رجاله رجال الصحيح غير أبي علي ووثقه ابن حبان","takhrij":"أخرجه أحمد (19622)، والبخاري في ((التاريخ الكبير)) (509)، والطبراني في ((المعجم الأوسط)) (3479) باختلاف يسير.","bab":"علم › حسن السؤال ونصح العالم","dorar":"JNYNLB4A"},{"id":"س-07193","fp":"977d9f4c231d","stateId":182,"easy":"إذا قرأت «قل يا أيها الكافرون» ← فهي براءة من الشرك","cause":"اقْرأْ قُلْ يَا أَيُّهَا الْكَافِرُونَ","result":"فإنَّها براءةٌ مِنَ الشِّركِ","explicit":true,"apply":{"k":"say","t":"«قل يا أيها الكافرون»"},"similar":["س-07643","س-00791"],"ref":"المستدرك على الصحيحين 2105","srcLabel":"أحمد","text":["وكان النَّبيُّ صلَّى اللهُ عليه وسلَّمَ دَفَعَ إليه ابنةَ أُمِّ سَلَمَةَ، وقالَ: إنَّما أنتَ ظِئري، قالَ: فقَدِمتُ عليه، فقالَ: ما فَعَلَتِ الجُوَيْريَةُ -أوِ: الجاريةُ-؟ قلتُ: عندَ أُمِّها، قالَ: فمَجِيءُ ما جِئتَ؟ قالَ: جئتُ أنْ تُعلِّمَني شيئًا أقولُهُ عندَ منامي، قالَ: ",["اقْرأْ {قُلْ يَا أَيُّهَا الْكَافِرُونَ",1],"}؛ ",["فإنَّها براءةٌ مِنَ الشِّركِ",2],"."],"grade":"صحيح","narrator":"نوفل الأشجعي","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (23807) واللفظ له, والدارمي في ((صحيحه)) (3470) بلفظ فريب، وأبو داوود (5055) بنحوه .","bab":"علم › حسن السؤال ونصح العالم","dorar":"0qETEk26","merged":5,"otherRefs":["صحيح الترمذي 3403 (صحيح)","تخريج المسند لشعيب 00/ 50 (حسن)","تغليق التعليق 4/408 (صحيح)","تخريج صحيح ابن حبان 790 (صحيح)"]},{"id":"س-07643","fp":"b5edae07f8f6","stateId":182,"easy":"إذا قرأت «قل يا أيها الكافرون» ← تبرأ من الشرك","cause":"يَقرَأُ: قُلْ يَا أَيُّهَا الْكَافِرُونَ","result":"بَرِئَ مِن الشِّرْكِ","explicit":true,"apply":{"k":"say","t":"«قل يا أيها الكافرون»"},"repOf":"س-07193","ref":"الصحيح المسند 1507","text":["جاءَ رَجُلٌ زَمَنَ زِيادٍ إلى الكوفةِ فسَمِعْتُه يُحدِّثُ: أنَّه كانَ معَ رَسولِ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ في مَسيرٍ له قالَ: ورُكْبتي تُصيبُ أو تَمَسُّ رُكْبتَه، فسَمِعَ رَجُلًا ",["يَقرَأُ: {قُلْ يَا أَيُّهَا الْكَافِرُونَ",1],"}، قالَ: «",["بَرِئَ مِن الشِّرْكِ",2],"»، وسَمِعَ رَجُلًا يَقرَأُ {قُلْ هُوَ اللَّهُ أَحَدٌ}، قالَ: «غُفِرَ له»."],"grade":"صحيح","narrator":"رجل","muhaddith":"صحيح، ورجاله رجال الصحيح","bab":"فضائل سور وآيات › سورة الإخلاص","dorar":"NLutCf5D","merged":3,"otherRefs":["تخريج المسند لشعيب 23194 (صحيح)","إتحاف الخيرة المهرة 6/305 (صحيح)"]},{"id":"س-00519","fp":"bbb00e8b7732","stateId":182,"easy":"إذا قلت «اللهم إني أعوذ بك أن أشرك بك وأنا أعلم وأستغفرك لما لا أعلم» ← يذهب عنك صغار الشرك وكباره","cause":"تقولُ : اللهمَّ إني أعوذُ بك أنْ أُشرِكَ بك و أنا أعلمُ ، و أستغفرُك لما لا أعلمُ","result":"أذْهَبَ عنك صَغارُ الشركِ و كبارُه","explicit":true,"apply":{"k":"say","t":"«اللهم إني أعوذ بك أن أشرك بك وأنا أعلم وأستغفرك لما لا أعلم»"},"ref":"صحيح الجامع 3731","srcLabel":"ابن حبان","text":["الشركُ فيكم أخفى من دبيبِ النملِ ، و سأدلُك على شيءٍ إذا فعلتَه ",["أذْهَبَ عنك صَغارُ الشركِ و كبارُه",2]," ، ",["تقولُ : اللهمَّ إني أعوذُ بك أنْ أُشرِكَ بك و أنا أعلمُ ، و أستغفرُك لما لا أعلمُ",1]," . . ."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"صحيح","takhrij":"أخرجه أبو يعلى (60 )، وابن حبان في ((المجروحين)) (3/ 130)، وابن السني في ((عمل اليوم والليلة)) (286 )","bab":"آداب عامة › ضرب الأمثال","dorar":"sF0VyBKc"},{"id":"س-04708","fp":"6aa2a237be8c","stateId":182,"easy":"إذا أسلمت ولو كنت كارهاً ← يرزقك الله حسن النية والإخلاص","cause":"أسلِم وإن كنتَ كارِهًا","result":"فإنَّ اللَّهَ سيرزقُكَ حُسنَ النِّيَّةِ والإخلاصَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"عمدة التفسير 1/314","srcLabel":"عمدة التفسير","text":[["أسلِم وإن كنتَ كارِهًا",1]," ",["فإنَّ اللَّهَ سيرزقُكَ حُسنَ النِّيَّةِ والإخلاصَ",2]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"رقائق وزهد › الإخلاص","dorar":"mdUKY86E"},{"id":"س-00791","fp":"542cae953a21","stateId":182,"easy":"إذا أويت إلى فراشك فاقرأ «قل يا أيها الكافرون» ← فهي براءة من الشرك","cause":"إذا أَوَيْتَ إلى مَضجعِكَ فاقْرَأْ: {قُلْ يَا أَيُّهَا الْكَافِرُونَ} إلى خاتِمتِها؛ فإنَّها بَراءةٌ مِنَ الشِّركِ","result":"مُرْني بشيءٍ أقولُهُ، فقالَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«قل يا أيها الكافرون» · الوقت: عند النوم"},"repOf":"س-07193","ref":"المستدرك على الصحيحين 4030","text":["أنَّه قالَ للنَّبيِّ صلَّى اللهُ عليه وسلَّمَ: ",["مُرْني بشيءٍ أقولُهُ، فقالَ",2],": «",["إذا أَوَيْتَ إلى مَضجعِكَ فاقْرَأْ: {قُلْ يَا أَيُّهَا الْكَافِرُونَ} إلى خاتِمتِها؛ فإنَّها بَراءةٌ مِنَ الشِّركِ».",1]],"grade":"صحيح","narrator":"نوفل الأشجعي","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الدارمي في ((صحيحه)) (3470)، والنسائي في ((الكبرى)) (10569) كلاهما باختلاف يسير، وأبو داوود (5055) بلفظ قريب.","bab":"أدعية وأذكار › الذكر عند النوم","dorar":"r3Lbr8mz"},{"id":"س-06513","fp":"45c93370200a","stateId":182,"easy":"إذا أقمت الصلاة وحدك في خلوتك ← فما أتقاك","cause":"راعِي غَنَمٍ ، عَلَى رأسِ جَبَلٍ ، يُقيمُ فيها الصلاةَ","result":"ما أتْقَاهُ ! ما أتْقَاهُ ! ما أَتْقَاهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[47],"ref":"الجامع الصغير 7755","srcLabel":"الطبراني","text":[["ما أتْقَاهُ ! ما أتْقَاهُ ! ما أَتْقَاهُ",2]," ! ",["راعِي غَنَمٍ ، عَلَى رأسِ جَبَلٍ ، يُقيمُ فيها الصلاةَ",1]],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"حسن","takhrij":"أخرجه الطبراني (8/ 168) (7707) واللفظ له.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"kl6u7Kmr"},{"id":"س-02030","fp":"2eec98ed7fb9","stateId":183,"easy":"إذا قرأت عشر آيات في ليلة ← لا تُكتب من الغافلين","cause":"مَن قَرَأَ عَشْرَ آياتٍ في لَيْلةٍ","result":"لم يُكتَبْ مِن الغافِلينَ","explicit":true,"star":true,"otherNeedIds":[45],"ref":"الأحاديث المختارة 8 / 278","srcLabel":"متفق عليه","text":["(«",["مَن قَرَأَ عَشْرَ آياتٍ في لَيْلةٍ ",1],["لم يُكتَبْ مِن الغافِلينَ) ",2],"ومَن قَرَأَ مِئةَ آيةٍ كُتِبَ له قُنوتُ لَيْلةٍ، ومَن قَرَأَ مِئَتي آيةٍ كُتِبَ مِن القانِتينَ، ومَن قَرَأَ أرْبَعَمِئةٍ كُتِبَ مِن المُخْبِتينَ، ومَن قَرَأَ ألْفَ آيةٍ أصْبَحَ وله قِنْطارٌ ألْفٌ ومِئَتا أوقِيَّةٍ، الأوقِيَّةُ خَيْرٌ مِمَّا بَيْنَ السَّماءِ والأرْضِ، ومَن قَرَأَ ألْفَي آيةٍ كانَ مِن المُوجِبينَ»."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"q8mF6vVQ","merged":2,"otherRefs":["صحيح الترغيب 1587 (صحيح)"]},{"id":"س-00719","fp":"ff4ebb5a435a","stateId":183,"easy":"إذا حافظت على الصلوات المكتوبة ← لا تُكتب من الغافلين","cause":"مَن حافظَ على هؤلاءِ الصَّلواتِ المَكْتوباتِ","result":"لم يُكْتب منَ الغافلينَ","explicit":true,"star":true,"otherNeedIds":[45],"ref":"صحيح ابن خزيمة 2/ 317","srcLabel":"الحاكم","text":[["مَن حافظَ على هؤلاءِ الصَّلواتِ المَكْتوباتِ ",1],["لم يُكْتب منَ الغافلينَ، ",2],"ومن قرأَ في ليلةٍ مائةَ آيَّةٍ لم يُكْتَب منَ الغافلينَ، أو كُتِبَ منَ القانتينَ وقالَ رسولُ اللَّه صلَّى اللَّه عليه وسلَّمَ: أفضَلُ الكلامِ أربعةٌ: سُبحانَ اللَّهِ، والحَمدُ للَّهِ، ولا إلَهَ إلَّا اللَّهُ واللَّهُ أَكْبرُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الحاكم (1160)، والبيهقي في ((الشعب)) (2002) واللفظ لهما، وابن السني في ((عمل اليوم والليلة)) (702) مختصرًا بنحوه.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"ZJlr9flR"},{"id":"س-00720","fp":"a74b7c4afec7","stateId":183,"easy":"إذا قرأت في ليلة مئة آية ← لا تُكتب من الغافلين وتُكتب من القانتين","cause":"ومن قرأَ في ليلةٍ مائةَ آيَّةٍ","result":"لم يُكْتَب منَ الغافلينَ، أو كُتِبَ منَ القانتينَ وقالَ رسولُ اللَّه صلَّى اللَّه عليه وسلَّمَ: أفضَلُ الكلامِ أربعةٌ: سُبحانَ اللَّهِ، والحَمدُ للَّهِ، ولا إلَهَ إلَّا اللَّهُ واللَّهُ أَكْبرُ","explicit":true,"similar":["س-02254"],"otherNeedIds":[45],"ref":"صحيح ابن خزيمة 2/ 317","srcLabel":"الحاكم","text":["مَن حافظَ على هؤلاءِ الصَّلواتِ المَكْتوباتِ لم يُكْتب منَ الغافلينَ، ",["ومن قرأَ في ليلةٍ مائةَ آيَّةٍ ",1],["لم يُكْتَب منَ الغافلينَ، أو كُتِبَ منَ القانتينَ وقالَ رسولُ اللَّه صلَّى اللَّه عليه وسلَّمَ: أفضَلُ الكلامِ أربعةٌ: سُبحانَ اللَّهِ، والحَمدُ للَّهِ، ولا إلَهَ إلَّا اللَّهُ واللَّهُ أَكْبرُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الحاكم (1160)، والبيهقي في ((الشعب)) (2002) واللفظ لهما، وابن السني في ((عمل اليوم والليلة)) (702) مختصرًا بنحوه.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"ZJlr9flR"},{"id":"س-07808","fp":"4ed775691e08","stateId":183,"easy":"إذا قمت بعشر آيات ← لا تُكتب من الغافلين، وبمئة تُكتب من القانتين","cause":"مَنْ قامَ بِعَشْرِ آياتٍ","result":"لمْ يُكْتَبْ مِنَ الغَافِلِينَ ، و مَنْ قامَ بِمِائَةِ آيَةٍ كُتِبَ مِنَ القَانِتِينَ ، و مَنْ قامَ بِأَلْفِ آيَةٍ كُتِبَ مِنَ المُقَنْطِرِينَ","explicit":true,"otherNeedIds":[45],"ref":"صحيح الترغيب 639","srcLabel":"أبو داود","text":[["مَنْ قامَ بِعَشْرِ آياتٍ ",1],["لمْ يُكْتَبْ مِنَ الغَافِلِينَ ، و مَنْ قامَ بِمِائَةِ آيَةٍ كُتِبَ مِنَ القَانِتِينَ ، و مَنْ قامَ بِأَلْفِ آيَةٍ كُتِبَ مِنَ المُقَنْطِرِينَ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"حسن صحيح","takhrij":"أخرجه أبو داود (1398)، وابن خزيمة (1144)، وابن حبان (2572)","bab":"قرآن › فضل قراءة القرآن","dorar":"lNqlnkCY"},{"id":"س-02254","fp":"1f83ccdec664","stateId":183,"easy":"إذا قرأت خمسين آية في ليلة ← لا تُكتب من الغافلين","cause":"مَن قرَأَ في لَيلَةٍ خَمسينَ آيَةً","result":"لم يُكتَبْ من الغافِلينَ","explicit":true,"repOf":"س-00720","otherNeedIds":[45],"ref":"مجمع الزوائد 2/271","text":[["مَن قرَأَ في لَيلَةٍ خَمسينَ آيَةً، ",1],["لم يُكتَبْ من الغافِلينَ، ",2],"ومَن قرَأَ مِئَةَ آيَةٍ، كُتِبَ من القانِتينَ، ومَن قرَأَ ثَلاثَ مِئَةِ آيةٍ كُتِبَ له قِنطارٌ، ومَن قرَأَ بسَبعِ مِئَةٍ أفلَحَ."],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"رجاله ثقات","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"ZyHKYTlq"},{"id":"س-01008","fp":"02e359ed9a2a","stateId":183,"easy":"إذا ذُكر الله في بيتك ← كان حياً، والبيت الذي لا يُذكر فيه كالميت","cause":"مَثَلُ البَيتِ الذي يُذكَرُ اللهُ فيه، والبَيتِ الذي لا يُذكَرُ اللهُ فيه","result":"مَثَلُ الحَيِّ والمَيِّتِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"صحيح مسلم 779","srcLabel":"متفق عليه","text":[["مَثَلُ البَيتِ الذي يُذكَرُ اللهُ فيه، والبَيتِ الذي لا يُذكَرُ اللهُ فيه",1],": ",["مَثَلُ الحَيِّ والمَيِّتِ",2],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6407)، ومسلم (779).","bab":"أدعية وأذكار › فضل الذكر","dorar":"w9rb0cJG","merged":2,"otherRefs":["صحيح البخاري 6407 (صحيح)"]},{"id":"س-00947","fp":"4dd5277a5259","stateId":183,"easy":"إذا ذكرت الله ولم تنسه ← فأنت أتقى عباده","cause":"الَّذي يذكُرُ ولا يَنسى","result":"أيُّ عبادِك أتقى","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح ابن حبان 6217","srcLabel":"متفق عليه","text":["سأَل موسى ربَّه عن ستِّ خِصالٍ كان يظُنُّ أنَّها له خالصةٌ والسَّابعةُ لم يكُنْ موسى يُحِبُّها قال : يا ربِّ ",["أيُّ عبادِك أتقى",2]," ؟ قال ",["الَّذي يذكُرُ ولا يَنسى",1]," قال : فأيُّ عبادِك أهدى ؟ قال : الَّذي يتَّبِعُ الهُدى قال : فأيُّ عبادِك أحكَمُ ؟ قال : الَّذي يحكُمُ للنَّاسِ كما يحكُمُ لنفسِه قال : فأيُّ عبادِك أعلَمُ ؟ قال : عالمٌ لا يشبَعُ مِن العِلمِ يجمَعُ عِلمَ النَّاسِ إلى عِلمِه قال فأيُّ عبادِك أعَزُّ ؟ قال : الَّذي إذا قدَر غفَر قال : فأيُّ عبادِك أغنى ؟ قال : الَّذي يَرضى بما يُؤتَى قال : فأيُّ عبادِك أفقَرُ ؟ قال : صاحبٌ منقوصٌ ) قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ( ليس الغِنى عن ظَهْرٍ إنَّما الغِنى غِنى النَّفسِ وإذا أراد اللهُ بعبدٍ خيرًا جعَل غناه في نفسِه وتُقاهُ في قلبِه وإذا أراد اللهُ بعبدٍ شرًّا جعَل فقرَه بيْنَ عينَيْهِ )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن عساكر في ((تاريخ دمشق)) (61/ 134) بلفظه، والبخاري (6446)، ومسلم (1051) كلاهما مختصرا ببعض لفظه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"BWzqJ8PQ"},{"id":"ق-1003","fp":"ca95ac5899cf","stateId":184,"easy":"التقوى والقول السديد ← صلاح الأعمال ومغفرة الذنوب","cause":"التقوى والقول السديد","result":"صلاح الأعمال ومغفرة الذنوب","explicit":true,"star":true,"otherNeedIds":[11],"ref":"سورة الأحزاب: 70–71","srcLabel":"القرآن الكريم","quran":{"s":33,"from":70,"to":71,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَقُولُوا قَوْلًا سَدِيدًا (70) يُصْلِحْ لَكُمْ أَعْمَالَكُمْ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ وَمَنْ يُطِعِ اللَّهَ وَرَسُولَهُ فَقَدْ فَازَ فَوْزًا عَظِيمًا (71)","hl":[[0,139,1]]}},{"id":"س-07752","fp":"27e75ef35ef3","stateId":184,"easy":"إذا صدقت الحديث ← ترجو عقبى الله (من قصة كعب)","cause":"ولَئِن حَدَّثتُكَ حَديثَ صِدقٍ","result":"إنِّي لأرجو فيه عُقبى اللهِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[47],"ref":"صحيح مسلم 2769","srcLabel":"البخاري","text":["ثُمَّ غَزا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم غَزوةَ تَبوكَ، وهو يُريدُ الرُّومَ ونَصارى العَرَبِ بالشَّامِ، قال ابنُ شِهابٍ: فأخبَرَني عبدُ الرَّحمَنِ بنُ عبدِ اللهِ بنِ كَعبِ بنِ مالِكٍ، أنَّ عَبدَ اللهِ بنَ كَعبٍ كان قائِدَ كَعبٍ، مِن بَنيه، حينَ عَميَ، قال: سَمِعتُ كَعبَ بنَ مالِكٍ يُحَدِّثُ حَديثَه حينَ تَخَلَّفَ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةِ تَبوكَ، قال كَعبُ بنُ مالِكٍ: لم أتَخَلَّفْ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةٍ غَزاها قَطُّ إلَّا في غَزوةِ تَبوكَ، غيرَ أنِّي قد تَخَلَّفتُ في غَزوةِ بَدرٍ ولم يُعاتِبْ أحَدًا تَخَلَّفَ عنه، إنَّما خَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم والمُسلِمونَ يُريدونَ عيرَ قُرَيشٍ، حتَّى جَمع اللهُ بينَهم وبينَ عَدوِّهِم على غيرِ ميعادٍ، ولقد شَهِدتُ مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم لَيلةَ العَقَبةِ، حينَ تَواثَقنا على الإسلامِ، وما أُحِبُّ أنَّ لي بها مَشهَدَ بَدرٍ، وإن كانَت بَدرٌ أذكَرَ في النَّاسِ منها، وكانَ مِن خَبَري حينَ تَخَلَّفتُ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةِ تَبوكَ أنِّي لم أكُنْ قَطُّ أقوى ولا أيسَرَ مِنِّي حينَ تَخَلَّفتُ عنه في تلك الغَزوةِ، واللهِ ما جَمَعتُ قَبلَها راحِلَتَينِ قَطُّ، حتَّى جَمَعتُهما في تلك الغَزوةِ، فغَزاها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم في حَرٍّ شَديدٍ واستَقبَلَ سَفَرًا بَعيدًا ومَفازًا، واستَقبَلَ عَدوًّا كَثيرًا، فجَلا للمُسلِمينَ أمرَهم ليَتَأهَّبوا أُهبةَ غَزوِهم، فأخبَرَهم بوجهِهمِ الذي يُريدُ، والمُسلِمونَ مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم كَثيرٌ، ولا يَجمَعُهم كِتابُ حافِظٍ، يُريدُ بذلك الدِّيوانَ، قال كَعبٌ: فقَلَّ رَجُلٌ يُريدُ أن يَتَغَيَّبَ، يَظُنُّ أنَّ ذلك سَيَخفى له، ما لم يَنزِلْ فيه وحيٌ مِنَ اللهِ عَزَّ وجَلَّ، وغَزا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم تلك الغَزوةَ حينَ طابَتِ الثِّمارُ والظِّلالُ، فأنا إليها أصعَرُ، فتَجَهَّزَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم والمُسلِمونَ معهُ، وطَفِقتُ أغدو لكَي أتَجَهَّزَ معهُم، فأرجِعُ ولم أقضِ شيئًا، وأقولُ في نَفسي: أنا قادِرٌ على ذلك إذا أرَدتُ، فلم يَزَلْ ذلك يَتَمادى بي حتَّى استَمَرَّ بالنَّاسِ الجِدُّ، فأصبَحَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم غاديًا والمُسلِمونَ معهُ، ولم أقضِ مِن جَهازي شيئًا، ثُمَّ غَدَوتُ فرَجَعتُ ولم أقضِ شيئًا، فلم يَزَلْ ذلك يَتَمادى بي حتَّى أسرَعوا وتَفارَطَ الغَزوُ، فهَمَمتُ أن أرتَحِلَ فأُدرِكَهم، فيا لَيتَني فعَلتُ، ثُمَّ لم يُقدَّرْ ذلك لي، فطَفِقتُ إذا خَرَجتُ في النَّاسِ بَعدَ خُروجِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم يَحزُنُني أنِّي لا أرى لي أُسوةً إلَّا رَجُلًا مَغموصًا عليه في النِّفاقِ، أو رَجُلًا مِمَّن عَذَرَ اللهُ مِنَ الضُّعَفاءِ، ولم يَذكُرْني رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم حتَّى بَلَغَ تَبوكَ، فقال وهو جالِسٌ في القَومِ بتَبوكَ: ما فعَلَ كَعبُ بنُ مالِكٍ؟ قال رَجُلٌ مِن بَني سَلِمةَ: يا رَسولَ اللهِ، حَبَسَه بُرداه والنَّظَرُ في عِطفَيه، فقال له مُعاذُ بنُ جَبَلٍ: بئسَ ما قُلتَ! واللهِ يا رَسولَ اللهِ، ما عَلِمنا عليه إلَّا خَيرًا، فسَكَتَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فبينَما هو على ذلك رَأى رَجُلًا مُبَيِّضًا يَزولُ به السَّرابُ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: كُنْ أبا خَيثَمةَ، فإذا هو أبو خَيثَمةَ الأنصاريُّ، وهو الذي تَصَدَّقَ بصاعِ التَّمرِ حينَ لَمَزَه المُنافِقونَ. فقال كَعبُ بنُ مالِكٍ: فلَمَّا بَلَغَني أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قد تَوجَّهَ قافِلًا مِن تَبوكَ حَضَرَني بَثِّي، فطَفِقتُ أتَذَكَّرُ الكَذِبَ وأقولُ: بمَ أخرُجُ مِن سَخَطِه غَدًا؟ وأستَعينُ على ذلك كُلَّ ذي رَأيٍ مِن أهلي، فلَمَّا قيلَ لي: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قد أظَلَّ قادِمًا زاحَ عَنِّي الباطِلُ، حتَّى عَرَفتُ أنِّي لَن أنجوَ منه بشيءٍ أبَدًا، فأجمَعتُ صِدقَه، وصَبَّحَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم قادِمًا، وكانَ إذا قدِمَ مِن سَفَرٍ بَدَأ بالمَسجِدِ فرَكَعَ فيه رَكعَتَينِ، ثُمَّ جَلَسَ للنَّاسِ، فلَمَّا فعَلَ ذلك جاءَه المُخَلَّفونَ، فطَفِقوا يَعتَذِرونَ إليه، ويَحلِفونَ له، وكانوا بضعةً وثَمانينَ رَجُلًا، فقَبِلَ منهم رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم عَلانيَتَهم، وبايَعَهم واستَغفَرَ لهم، ووكَلَ سَرائِرَهم إلى اللهِ، حتَّى جِئتُ، فلَمَّا سَلَّمتُ تَبَسَّمَ تَبَسُّمَ المُغضَبِ، ثُمَّ قال: تَعالَ، فجِئتُ أمشي حتَّى جَلَستُ بينَ يَدَيه، فقال لي: ما خَلَّفَكَ؟ ألَم تَكُنْ قدِ ابتَعتَ ظَهرَكَ؟ قال: قُلتُ: يا رَسولَ اللهِ، إنِّي، واللهِ لو جَلَستُ عِندَ غيرِكَ مِن أهلِ الدُّنيا لَرَأيتُ أنِّي سَأخرُجُ مِن سَخَطِه بعُذرٍ، ولقد أُعطيتُ جَدَلًا، ولَكِنِّي واللهِ لقد عَلِمتُ لَئِن حَدَّثتُكَ اليومَ حَديثَ كَذِبٍ تَرضى به عَنِّي لَيوشِكَنَّ اللهُ أن يُسخِطَكَ عليَّ، ",["ولَئِن حَدَّثتُكَ حَديثَ صِدقٍ",1]," تَجِدُ عليَّ فيه، ",["إنِّي لأرجو فيه عُقبى اللهِ",2],"، واللهِ ما كان لي عُذرٌ، واللهِ ما كُنتُ قَطُّ أقوى ولا أيسَرَ مِنِّي حينَ تَخَلَّفتُ عَنكَ، قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أمَّا هذا فقد صَدَقَ، فقُمْ حتَّى يَقضيَ اللهُ فيكَ، فقُمتُ، وثارَ رِجالٌ مِن بَني سَلِمةَ فاتَّبَعوني، فقالوا لي: واللهِ ما عَلِمناكَ أذنَبتَ ذَنبًا قَبلَ هذا، لقد عَجَزتَ في أن لا تَكونَ اعتَذَرتَ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم بما اعتَذَرَ به إليه المُخَلَّفونَ؛ فقد كان كافيَكَ ذَنبَكَ استِغفارُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم لَكَ. قال: فواللهِ ما زالوا يُؤَنِّبوني حتَّى أرَدتُ أن أرجِعَ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فأُكَذِّبَ نَفسي، قال ثُمَّ قُلتُ لهم: هل لَقيَ هذا مَعي مِن أحَدٍ؟ قالوا: نَعَم، لَقيَه معكَ رَجُلانِ، قالا مِثلَ ما قُلتَ، فقيلَ لهما مِثلَ ما قيلَ لَكَ، قال: قُلتُ: مَن هُما؟ قالوا: مُرارةُ بنُ الرَّبيعةِ العامِريُّ، وهِلالُ بنُ أُمَيَّةَ الواقِفيُّ، قال: فذَكَروا لي رَجُلَينِ صالِحَينِ قد شَهِدا بَدرًا، فيهما أُسوةٌ، قال: فمَضَيتُ حينَ ذَكَروهما لي. قال: ونَهى رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم المُسلِمينَ عن كَلامِنا -أيُّها الثَّلاثةُ- مِن بَينِ مَن تَخَلَّفَ عنه. قال: فاجتَنَبَنا النَّاسُ، وقال: تَغَيَّروا لَنا حتَّى تَنَكَّرَت لي في نَفسيَ الأرضُ، فما هي بالأرضِ التي أعرِفُ، فلَبِثنا على ذلك خَمسينَ لَيلةً، فأمَّا صاحِبايَ فاستَكانا وقَعَدا في بُيوتِهما يَبكيانِ، وأمَّا أنا فكُنتُ أشَبَّ القَومِ وأجلَدَهم، فكُنتُ أخرُجُ فأشهَدُ الصَّلاةَ وأطوفُ في الأسواقِ ولا يُكَلِّمُني أحَدٌ، وآتي رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم فأُسَلِّمُ عليه وهو في مَجلِسِه بَعدَ الصَّلاةِ، فأقولُ في نَفسي: هل حَرَّكَ شَفَتَيه برَدِّ السَّلامِ، أم لا؟ ثُمَّ أُصَلِّي قَريبًا منه وأُسارِقُه النَّظَرَ، فإذا أقبَلتُ على صَلاتي نَظَرَ إليَّ، وإذا التَفَتُّ نَحوه أعرَضَ عَنِّي، حتَّى إذا طالَ ذلك عليَّ مِن جَفوةِ المُسلِمينَ مَشيتُ حتَّى تَسَوَّرتُ جِدارَ حائِطِ أبي قَتادةَ، وهو ابنُ عَمِّي، وأحَبُّ النَّاسِ إليَّ، فسَلَّمتُ عليه، فواللهِ ما رَدَّ عليَّ السَّلامَ. فقُلتُ له: يا أبا قَتادةَ، أنشُدُكَ باللهِ هل تَعلَمَنَّ أنِّي أُحِبُّ اللهَ ورَسولَه؟ قال: فسَكَتَ، فعُدتُ فناشَدتُه، فسَكَتَ، فعُدتُ فناشَدتُه، فقال: اللهُ ورَسولُه أعلَمُ، ففاضَت عَينايَ وتَولَّيتُ حتَّى تَسَوَّرتُ الجِدارَ. فبينا أنا أمشي في سوقِ المَدينةِ إذا نَبَطيٌّ مِن نَبَطِ أهلِ الشَّامِ، مِمَّن قدِمَ بالطَّعامِ يَبيعُه بالمَدينةِ، يقولُ: مَن يَدُلُّ على كَعبِ بنِ مالِكٍ؟ قال: فطَفِقَ النَّاسُ يُشيرونَ له إليَّ، حتَّى جاءَني فدَفَعَ إليَّ كِتابًا مِن مَلِكِ غَسَّانَ، وكُنتُ كاتِبًا، فقَرَأتُه فإذا فيه: أمَّا بَعدُ؛ فإنَّه قد بَلَغَنا أنَّ صاحِبَكَ قد جَفاكَ، ولم يَجعَلْكَ اللهُ بدارِ هَوانٍ ولا مَضيَعةٍ، فالحَقْ بنا نُواسِكَ، قال: فقُلتُ حينَ قَرَأتُها: وهذه أيضًا مِنَ البَلاءِ، فتَيامَمتُ بها التَّنُّورَ فسَجَرتُها بها، حتَّى إذا مَضَت أربَعونَ مِنَ الخَمسينَ، واستَلبَثَ الوحيُ، إذا رَسولُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم يَأتيني، فقال: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَأمُرُكَ أن تَعتَزِلَ امرَأتَكَ، قال: فقُلتُ: أُطَلِّقُها أم ماذا أفعَلُ؟ قال: لا، بَلِ اعتَزِلها، فلا تَقرَبَنَّها، قال: فأرسَلَ إلى صاحِبَيَّ بمِثلِ ذلك، قال: فقُلتُ لامرَأتي: الحَقي بأهلِكِ فكوني عِندَهم حتَّى يَقضيَ اللهُ في هذا الأمرِ، قال: فجاءَتِ امرَأةُ هِلالِ بنِ أُمَيَّةَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فقالت له: يا رَسولَ اللهِ، إنَّ هِلالَ بنَ أُمَيَّةَ شيخٌ ضائِعٌ ليس له خادِمٌ، فهل تَكرَهُ أن أخدُمَه؟ قال: لا، ولَكِن لا يَقرَبَنَّكِ، فقالت: إنَّه واللهِ ما به حَرَكةٌ إلى شيءٍ، وواللهِ ما زالَ يَبكي مُنذُ كان مِن أمرِه ما كانَ إلى يَومِه هذا، قال: فقال لي بَعضُ أهلي: لَوِ استَأذَنتَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم في امرَأتِكَ؟ فقد أذِنَ لامرَأةِ هِلالِ بنِ أُمَيَّةَ أن تَخدُمَه، قال: فقُلتُ: لا أستَأذِنُ فيها رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، وما يُدريني ماذا يقولُ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم إذا استَأذَنتُه فيها، وأنا رَجُلٌ شابٌّ، قال: فلَبِثتُ بذلك عَشرَ لَيالٍ، فكَمُلَ لَنا خَمسونَ لَيلةً مِن حينَ نُهي عن كَلامِنا، قال: ثُمَّ صَلَّيتُ صَلاةَ الفَجرِ صَباحَ خَمسينَ لَيلةً على ظَهرِ بَيتٍ مِن بُيوتِنا، فبينا أنا جالِسٌ على الحالِ التي ذَكَرَ اللهُ عَزَّ وجَلَّ مِنَّا قد ضاقَت عليَّ نَفسي وضاقَت عليَّ الأرضُ بما رَحُبَت، سَمِعتُ صَوتَ صارِخٍ أوفى على سَلعٍ يقولُ بأعلى صَوتِه: يا كَعبَ بنَ مالِكٍ أبشِرْ، قال: فخَرَرتُ ساجِدًا وعَرَفتُ أنْ قد جاءَ فرَجٌ. قال: فآذَنَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم النَّاسَ بتَوبةِ اللهِ علينا، حينَ صَلَّى صَلاةَ الفَجرِ، فذَهَبَ النَّاسُ يُبَشِّرونَنا، فذَهَبَ قِبَلَ صاحِبَيَّ مُبَشِّرونَ، ورَكَضَ رَجُلٌ إليَّ فرَسًا، وسَعى ساعٍ مِن أسلَمَ قِبَلي، وأوفى الجَبَلَ، فكانَ الصَّوتُ أسرَعَ مِنَ الفَرَسِ، فلَمَّا جاءَني الذي سَمِعتُ صَوتَه يُبَشِّرُني فنَزَعتُ له ثَوبَيَّ فكَسَوتُهما إيَّاه ببِشارَتِه، واللهِ ما أملِكُ غَيرَهما يَومَئذٍ، واستَعَرتُ ثَوبَينِ فلَبِستُهما، فانطَلَقتُ أتَأمَّمُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَتَلَقَّاني النَّاسُ فوجًا فوجًا، يُهَنِّئوني بالتَّوبةِ ويقولونَ: لتَهنِئْكَ تَوبةُ اللهِ عليكَ! حتَّى دَخَلتُ المَسجِدَ، فإذا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم جالِسٌ في المَسجِدِ وحَوله النَّاسُ، فقامَ طَلحةُ بنُ عُبَيدِ اللهِ يُهَروِلُ حتَّى صافَحَني وهَنَّأني، واللهِ ما قامَ رَجُلٌ مِنَ المُهاجِرينَ غَيرُه. قال: فكانَ كَعبٌ لا يَنساها لطَلحةَ. قال كَعبٌ: فلَمَّا سَلَّمتُ على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم قال وهو يَبرُقُ وجهُه مِنَ السُّرورِ ويقولُ: أبشِرْ بخَيرِ يَومٍ مَرَّ عليكَ مُنذُ ولَدَتكَ أُمُّكَ، قال: فقُلتُ: أمِن عِندِكَ يا رَسولَ اللهِ أم مِن عِندِ اللهِ؟ فقال: لا، بَل مِن عِندِ اللهِ، وكانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم إذا سُرَّ استَنارَ وجهُه، كَأنَّ وجهَه قِطعةُ قَمَرٍ، قال: وكُنَّا نَعرِفُ ذلك، قال: فلَمَّا جَلَستُ بينَ يَدَيه قُلتُ: يا رَسولَ اللهِ، إنَّ مِن تَوبَتي أن أنخَلِعَ مِن مالي صَدَقةً إلى اللهِ وإلى رَسولِه صلَّى اللهُ عليه وسلَّم، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أمسِكْ بَعضَ مالِكَ فهو خَيرٌ لكَ، قال: فقُلتُ: فإنِّي أُمسِكُ سَهميَ الذي بخَيبَرَ، قال: وقُلتُ: يا رَسولَ اللهِ، إنَّ اللهَ إنَّما أنجاني بالصِّدقِ، وإنَّ مِن تَوبَتي أن لا أُحَدِّثَ إلَّا صِدقًا ما بَقيتُ، قال: فواللهِ ما عَلِمتُ أنَّ أحَدًا مِنَ المُسلِمينَ أبلاه اللهُ في صِدقِ الحَديثِ مُنذُ ذَكَرتُ ذلك لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّم إلى يَومي هذا أحسَنَ ممَّا أبلاني اللهُ به، واللهِ ما تَعَمَّدتُ كَذبةً مُنذُ قُلتُ ذلك لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّم إلى يَومي هذا، وإنِّي لأرجو أن يَحفَظَني اللهُ فيما بَقيَ. قال: فأنزَلَ اللهُ عَزَّ وجَلَّ: {لقد تابَ اللهُ على النَّبيِّ والمُهاجِرينَ والأنصارِ الذينَ اتَّبَعوه في ساعةِ العُسرةِ مِن بَعدِ ما كادَ يَزيغُ قُلوبُ فريقٍ منهم ثُمَّ تابَ عليهم إنَّه بهم رَؤوفٌ رَحيمٌ وعلى الثَّلاثةِ الذينَ خُلِّفوا حتَّى إذا ضاقَت عليهمِ الأرضُ بما رَحُبَت وضاقَت عليهم أنفُسُهم} حتَّى بَلَغَ: {يا أيُّها الذينَ آمَنوا اتَّقوا اللهَ وكونوا مع الصَّادِقينَ}. قال كَعبٌ: واللهِ ما أنعَمَ اللهُ عليَّ مِن نِعمةٍ قَطُّ بَعدَ إذ هَداني اللهُ للإسلامِ أعظَمَ في نَفسي مِن صِدقي رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم أن لا أكونَ كَذَبتُه فأهلِكَ كما هَلَكَ الذينَ كَذَبوا، إنَّ اللهَ قال للذينَ كَذَبوا حينَ أنزَلَ الوحيَ شَرَّ ما قال لأحَدٍ. وقال اللهُ: {سَيَحلِفونَ باللهِ لَكُم إذا انقَلَبتُم إليهم لتُعرِضوا عنهم فأعرِضوا عنهم إنَّهم رِجسٌ ومَأواهم جَهَنَّمُ جَزاءً بما كانوا يَكسِبونَ يَحلِفونَ لَكُم لتَرضَوا عنهم فإن تَرضَوا عنهم فإنَّ اللهَ لا يَرضى عَنِ القَومِ الفاسِقينَ}. قال كَعبٌ: كُنَّا خُلِّفنا أيُّها الثَّلاثةُ عن أمرِ أولَئِكَ الذينَ قَبِلَ منهم رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم حينَ حَلَفوا له، فبايَعَهم واستَغفَرَ لهم، وأرجَأ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم أمرَنا حتَّى قَضى اللهُ فيه، فبِذلك قال اللهُ عَزَّ وجَلَّ: وعلى الثَّلاثةِ الذينَ خُلِّفوا، وليسَ الذي ذَكَرَ اللهُ ممَّا خُلِّفنا تَخَلُّفَنا عَنِ الغَزوِ، وإنَّما هو تَخليفُه إيَّانا، وإرجاؤُه أمرَنا، عَمَّن حَلَفَ له واعتَذَرَ إليه فقَبِلَ منه. وفي روايةٍ: أنَّ عُبَيدَ اللهِ بنَ كَعبِ بنِ مالِكٍ، وكانَ قائِدَ كَعبٍ حينَ عَميَ، قال: سَمِعتُ كَعبَ بنَ مالِكٍ يُحَدِّثُ حَديثَه حينَ تَخَلَّفَ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةِ تَبوكَ، وساقَ الحَديثَ. وزادَ فيه، على يونُسَ: فكانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم قَلَّما يُريدُ غَزوةً إلَّا ورَّى بغَيرِها، حتَّى كانَت تلك الغَزوةُ."],"grade":"صحيح","narrator":"كعب بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4418)، وأحمد (15789) باختلاف يسير، والنسائي في ((الكبرى)) (11168) بنحوه.","bab":"قرآن › أسباب النزول","dorar":"MuC2vFZU"},{"id":"س-05555","fp":"7669aec2634e","stateId":184,"easy":"إذا زهدت وأيقنت ← صلحت كما صلح أول هذه الأمة","cause":"بالزهدِ و اليقينِ","result":"صلاحُ أولَ هذه الأمةِ","explicit":true,"star":true,"ref":"الجامع الصغير 5095","srcLabel":"أحمد","text":[["صلاحُ أولَ هذه الأمةِ",2]," ",["بالزهدِ و اليقينِ",1],"، و يهلكُ آخرُها بالبخلِ و الأملِ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه أحمد في ((الزهد)) (52)، وابن بشران في ((الأمالي)) (534)، والبيهقي في ((شعب الإيمان)) (10351) واللفظ لهم.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"NNffQGWt","merged":2,"otherRefs":["هداية الرواة 5210 (حسن)"]},{"id":"س-00253","fp":"a72cb0924405","stateId":184,"easy":"إذا تركت ما لا يعنيك ← فهو من حسن إسلامك","cause":"تركَه ما لا يَعنيه","result":"مِن حُسنِ إسلامِ المرءِ","explicit":true,"star":true,"otherNeedIds":[47],"ref":"صحيح ابن حبان 229","srcLabel":"الترمذي","text":["إنَّ ",["مِن حُسنِ إسلامِ المرءِ",2]," ",["تركَه ما لا يَعنيه",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الترمذي (2317)، وابن ماجه (3976)، والطبراني في ((المعجم الأوسط) (359) واللفظ لهم.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"FnjBc9Im"},{"id":"س-01688","fp":"39d4b5a67eba","stateId":184,"easy":"إذا حسبت كلامك من عملك ← قلّ كلامك إلا فيما يعنيك","cause":"ومن حسَبَ كلامَهُ من عمَلِهِ","result":"قلَّ كلامُهُ إلا فيما يعنيهِ","explicit":true,"star":true,"ref":"النوافح العطرة 227","srcLabel":"أحمد","text":["قُلِ الحقَّ وإن كان مُرًّا [يعني حديث: دخَلتُ علَى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وهو في المسجِدِ جالِسٌ، فاغتَنَمتُ خلوتَهُ، وحدَهُ، فجلَستُ إليهِ، فقالَ : أبا ذَرٍّ ! إن لِلمَسجِد تَحيَّةً، وإنَّ تحيَّتَهُ ركعتان فقُم فاركَعهما، قالَ : فقُمت فركَعتُها ثم عُدتُ فجلَستُ إليهِ، فقُلتُ : يا رسولَ اللهِ ! إنَّكَ أمَرتَني بالصَّلاةِ فما الصَّلاةُ ؟ قال : خيرٌ موضوعٌ استكثِرْ أو استَقِلَّ. قلتُ : يا رسولَ اللهِ ! فأيُّ الأعمالِ أفضَلُ ؟ قال : إيمانٌ باللَّهِ عزَّ وجلَّ، وجهادٌ في سبيلِهِ، قال : قلتُ : يا رسولَ اللهِ ! فأيُّ المؤمنينَ أكمَلُهم إيمانًا ؟ قالَ : أحسَنُهُم خُلُقًا. قالَ : قلتُ : يا رسولَ اللَّهِ ! فأيُّ المؤمنينَ أسلَمُ ؟ قالَ : مَن سلِمَ النَّاسُ من لسانِهِ ويدِهِ. قال : قلتُ : يا رسولَ اللَّهِ ! فأيُّ الهجرةِ أفضَلُ ؟ قال : مَن هجرَ السَّيِّئاتِ. قالَ : قُلتُ : يا رسولَ اللهِ ! فأيُّ الصَّلاةِ أفضَلُ ؟ قال : طولُ القنوتِ . قال : قلتُ : يا رسولَ اللهِ ! فما الصِّيامُ ؟ قالَ : فرضٌ مَجزيٌّ ، وعندَ اللهِ أضعافٌ كثيرةٌ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ الجهادِ أفضَلُ ؟ قالَ : مَن عُقِرَ جوادُهُ وأهريقَ دمُهُ. قال : قُلتُ : يا رسولَ اللهِ ! فأيُّ الرِّقابِ أفضَلُ ؟ قالَ : أغلاها ثَمنًا وأنفَسُها عندَ ربِّها. قالَ : قلتُ : يا رسولَ اللهِ ! فأيُّ الصَّدقةِ أفضَلُ ؟ قال : جُهدٌ مِن مُقِلٍّ يُسَرُّ إلى فقيرٍ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ آيةٍ مِمَّا أنزلَ اللهُ عزَّ وجلَّ عليكَ أعظَمُ ؟ قال : آيةُ الكُرسيِّ. ثُمَّ قالَ : يا أبا ذَرٍّ ! ما السَّماواتُ السَّبعُ معَ الكُرسيِّ إلا كَحلقَةٍ مُلقاةٍ بأرضِ فلاةٍ، وفَضلُ العَرشِ على الكُرسيِّ كفَضلِ الفَلاةِ علَى الحَلقَةِ. قلتُ : يا رسولَ اللهِ ! كم الأنبياءُ ؟ قال : مائةُ ألفٍ وأربعةٌ وعِشرونَ ألفًا. قلتُ : يا رسولَ اللهِ ! كم الرُّسلِ ؟ قالَ : ثلاثُمائةٍ وثلاثَةُ عشرَ جَمًّا غفيرًا. قلتُ : كثيرٌ طيِّبٌ، قلتُ : يا رسولَ اللهِ ! مَن كان أوَّلُهمْ ؟ قال : آدَمُ. قلتُ : يا رسولَ اللهِ ! أنَبيٌّ مُرسَلٌ ؟ قال : نعَم، خلقَهُ اللهُ بيدِهِ، ونفخَ فيهِ مِن روحِهِ، ثُمَّ سوَّاهُ قِبَلًا. وقال أحمدُ بنُ أنَسٍ ثُمَّ كلَّمهُ قِبَلًا. ثُمَّ قالَ : يا أبا ذَرٍّ ! أربعةٌ سُريانيُّونَ؛ آدَمُ، وشيثُ، وخَنوخُ - وهو إدريسُ، وهم أوَّلُ مَن خطَّ بالقلَمِ - ونوحٌ. وأربعةٌ من العَربِ؛ هودٌ، وصالِحٌ، وشُعَيبٌ، ونبيُّكَ يا أبا ذَرٍّ. قال : قلتُ : يا رسولَ اللهِ ! كَم كتابٌ أنزلَهُ اللَّهُ تعالى ؟ قال : مائةُ كتابٍ وأربعةُ كتُبٍ، أنزلَ علَى شيثَ خَمسونَ صحيفَةً، وأنزلَ علَى خَنوخَ ثلاثونَ صَحيفةً، وأنزلَ على إبراهيمَ عشرَ صحائفَ، وأنزلَ على موسَى قبلَ التَّوراةِ عَشرَ صحائفَ، وأنزلَ التَّوراةَ والإنجيلَ والزَّبورَ والفُرقانَ. قال : قلتُ : يا رسولَ اللهِ ! فَما كانَت صُحفُ إبراهيمَ ؟ قالَ : كانَت أمثالًا كلُّها : أيُّها الملِكُ المسلَّطُ المبتَلَى المغرورُ، فإنِّي لم أبعثْكَ لتجمَعَ الدُّنيا بعضَها إلى بعضٍ، ولكن بعثتُكَ لترُدَّ عنِّي دعوةَ المظلومِ، فإنِّي لا أردُّها ولَو كانَت مِن كافِرٍ. وكانَت فيها أمثالٌ : علَى العاقِلِ ما لَم يكُن مغلوبًا علَى عقلِهِ أن تكونَ له ساعاتٌ؛ ساعَةٌ يُناجي فيها ربَّهُ عزَّ وجلَّ، وساعةٌ يحاسِبُ فيها نفسَهُ، وساعَةٌ يفكِّرُ فيها في صُنعِ اللَّهِ عزَّ وجلَّ، وساعةٌ يخلو فيها بحاجتِهِ من المطعَمِ والمشرَبِ، وعلى العاقلِ أن لا يكون ظاعِنًا إلَّا لثلاثٍ؛ تزوُّدٍ لمعادٍ، أو مرمَّةٍ لمعاشٍ، أو لذَّةٍ في غيرِ محرَّمٍ، وعلى العاقِلِ أن يكونَ بصيرًا بزمانِهِ، مقبِلًا على شأنِهِ، حافِظًا للسانِهِ، ",["ومن حسَبَ كلامَهُ من عمَلِهِ",1]," ",["قلَّ كلامُهُ إلا فيما يعنيهِ",2],". قلتُ : يا رسولَ اللَّهِ ! فما كان صحُفُ موسَى عليهِ السَّلامُ ؟ قال : كانَت عبرًا كلَّها، عجبتُ لمن أيقنَ بالموتِ ثُمَّ هو يفرَحُ، عجبتُ لمن أيقنَ بالنَّارِ وهو يضحَكُ، عجبتُ لمن أيقنَ للقدرِ ثم هو ينصَبُ، عجبتُ لمن رأى الدُّنيا وتقلُّبَها ثُمَّ اطمأنَّ إليها، عجِبتُ لمن أيقنَ بالحسابِ غدًا ثُمَّ لا يعمَلُ. قلتُ : يا رسولَ اللهِ ! أوصِني. قال : أوصيكَ بتقوى اللهِ فإنَّهُ رأسُ الأمرِ كلِّهِ، قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بتلاوَةِ القرآنِ فإنَّهُ نور لكَ في الأرضِ وذكرٌ لكَ في السَّماءِ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : إيَّاكَ وكثرةَ الضَّحِكِ فإنَّهُ يُميتُ القَلبَ، ويَذهَبُ بنورِ الوَجهِ، قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : عليكَ بالصَّمتِ إلَّا مِن خيرٍ، فإنَّهُ مطردَةٌ للشَّيطانِ عنكَ، وعونٌ لكَ علَى أمر دينِكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بالجهادِ فإنَّهُ رهبانيَّةُ أمَّتي. قلتُ : يا رسولَ اللهِ ! زِدني. قال : حبُّ المساكينِ وجالِسهُم. قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : انظُر إلى مَن تحتَكَ ولا تنظُر إلى مَن فوقكَ فإنَّهُ أجدَرُ أن لا تَزدَري نِعمةَ اللهِ عندكَ. قلتُ : زِدني يا رسولَ اللهِ ! قال : صِلْ قرابَتَكَ وإن قَطعوكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : لا تَخَف في اللَّهِ تعالى لَومَةَ لائمٍ. قلتُ : يا رسولَ اللهِ ! زِدني. قالَ : قُل الحقَّ وإن كان مُرًّا. قلتُ : يا رسولَ اللهِ ! زِدني. قال : يردُّكَ عن النَّاسِ ما تعرفُ من نفسِكَ، ولا تجِد عليهِم فيما تأتي، وكفَى به عيبًا أن تعرِفَ من النَّاسِ ما تجهَلُ من نفسِكَ، أو تجِدُ عليهِم فيما تأتي. ثُمَّ ضربَ بيدِهِ علَى صدري، فقالَ : يا أبا ذَرٍّ ! لا عقلَ كالتَّدبيرِ، ولا ورعَ كالكَفِّ، ولا حسَبَ كحُسنِ الخُلُقِ، قلتُ : يارسولَ اللهِ ! هل لي في الدُّنيا شَيءٌ مِمَّا أنزلَ اللهُ عليكَ مِمَّا كان في صحُفِ إبراهيمَ وموسَى ؟ قال : يا أبا ذَرٍّ ! اقرَأ : ? قَد أفلَحَ مَن تزَكَّى? إلى آخرِ السُّورَةِ]"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مطولاً أحمد (21415)، والبزار (3966) باختلاف يسير، وابن حبان (361) واللفظ له","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"wZID7EAR"},{"id":"س-05910","fp":"56c29b9be214","stateId":184,"easy":"إذا تركت ما لا بأس به حذراً مما به بأس ← تكون من المتقين","cause":"يدَعَ ما لا بأسَ بهِ؛ حَذَرًا لِما بهِ بأسٌ","result":"لا يكونُ مِن المُتَّقينَ حتَّى","explicit":true,"ref":"المستدرك على الصحيحين 8112","srcLabel":"الترمذي","text":["إنَّ الرَّجلَ ",["لا يكونُ مِن المُتَّقينَ حتَّى",2]," ",["يدَعَ ما لا بأسَ بهِ؛ حَذَرًا لِما بهِ بأسٌ",1],"."],"grade":"صحيح","narrator":"عطية بن سعد","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (2451)، وابن ماجه (4215)، والقضاعي في ((مسند الشهاب)) (910) جميعهم بلفظ مقارب.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"U59lr5np"},{"id":"س-07021","fp":"5b0de9400421","stateId":184,"easy":"إذا تورعت ← فالورع خير دينك","cause":"الوَرَعُ","result":"وخَيْرُ دينِكُمُ","explicit":true,"otherNeedIds":[47],"ref":"المستدرك على الصحيحين 319","srcLabel":"البيهقي","text":["نحو: [«فَضْلُ العِلْمِ أَحَبُّ إليَّ مِنْ فَضْلِ العِبادَةِ، ",["وخَيْرُ دينِكُمُ",2]," ",["الوَرَعُ",1],"»."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أبو بكر الإسماعيلي في ((معجم أسامي شيوخه)) (1/ 355)، والبيهقي في ((الآداب)) (830) بلفظه.","bab":"علم › الحث على طلب العلم","dorar":"RQpiPWzk"},{"id":"س-06521","fp":"3c683fead610","stateId":184,"easy":"إذا صليت صلاة صادقة ← تنهاك عن الفحشاء والمنكر","cause":"إنَّ فلانًا يُصلِّي اللَّيلَ كلَّه","result":"سينهاه ما تقولُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح ابن حبان 2560","srcLabel":"أحمد","text":["قيل يا رسولَ اللهِ ",["إنَّ فلانًا يُصلِّي اللَّيلَ كلَّه",1]," فإذا أصبَح سرَق قال: ( ",["سينهاه ما تقولُ",2]," )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (9778)، والطحاوي في ((مشكل الآثار)) (2056)، وإبراهيم العبسي في ((نسخة وكيع عن الأعمش)) (31) واللفظ لهم.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"l304wZuJ","merged":2,"otherRefs":["مجمع الزوائد 2/261 (حسن)"]},{"id":"س-01430","fp":"b5cd054faa2c","stateId":184,"easy":"إذا كانت فيك خصلة صالحة ← يصلح الله بها عملك كله","cause":"إِنَّ الخصْلَةَ الصالِحَةَ تَكونُ في الرَّجُلِ","result":"فيُصْلِحُ اللهُ لَهُ بها عملَهُ كُلَّهُ","explicit":true,"ref":"الجامع الصغير 1958","srcLabel":"الطبراني","text":[["إِنَّ الخصْلَةَ الصالِحَةَ تَكونُ في الرَّجُلِ",1]," ، ",["فيُصْلِحُ اللهُ لَهُ بها عملَهُ كُلَّهُ",2]," ، وطُهورُ الرَّجُلِ لِصلاتِهِ يُكَفِّرُ اللهُ بِهِ ذنوبَهُ ، وتَبْقَى صلاتُهُ لَهُ نافلَةً"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"أخرجه البزار كما في ((كشف الأستار)) للهيثمي (253)، وأبو يعلى (3297)، والطبراني في ((المعجم الأوسط)) (2006) باختلاف يسير","bab":"وضوء › فضل الوضوء","dorar":"qnNtplqD"},{"id":"س-04736","fp":"05f42245d762","stateId":184,"easy":"إذا أصلحت سريرتك ← يصلح الله علانيتك","cause":"و منْ أصلحَ سريرتَهُ","result":"أصلحَ اللهُ علانيتَهُ","explicit":true,"ref":"الجامع الصغير 8320","srcLabel":"الحاكم","text":["منْ أحسنَ فيما بينهُ و بينَ اللهِ،  كفاهُ اللهُ ما بينهُ و بينَ الناسِ،  ",["و منْ أصلحَ سريرتَهُ",1]," ",["أصلحَ اللهُ علانيتَهُ",2]],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن","takhrij":"لم نقف عليه إلا عند الحاكم في ((التاريخ)) كما في ((الجامع الصغير)) (‌‌12135).","bab":"رقائق وزهد › الإخلاص","dorar":"6NwxqCb1"},{"id":"س-05065","fp":"f080769a5750","stateId":184,"easy":"إذا عملت عملاً ولو في خفاء ← يكسوك الله رداءه بين الناس: خيراً أو شراً","cause":"لو أنَّ رجلًا دخَل بيتًا في جوفِ بيتٍ فأدْمَن هناك عملًا أوْشَك الناسُ أنْ يتحدَّثوا به وما من عاملٍ عَمِلَ عملًا","result":"إلا كساه اللهُ رِداءَ عملِه إنْ كان خيرًا فخيرٌ وإنْ كان شرًا فشرٌّ","explicit":true,"ref":"إتحاف الخيرة المهرة 7/385","srcLabel":"إتحاف الخيرة المهرة","text":["عن عُثمانُ بنُ عفانَ  رضي اللهُ عنه  قال:  ",["لو أنَّ رجلًا دخَل بيتًا في جوفِ بيتٍ فأدْمَن هناك عملًا أوْشَك الناسُ أنْ يتحدَّثوا به  وما من عاملٍ عَمِلَ عملًا ",1],["إلا كساه اللهُ رِداءَ عملِه  إنْ كان خيرًا فخيرٌ  وإنْ كان شرًا فشرٌّ",2]],"grade":"حسن","narrator":"[معبدالجهني]","muhaddith":"رواته ثقات","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"iKj7J4u3"},{"id":"س-05948","fp":"34747bca70f2","stateId":184,"easy":"إذا ذكرت الموت في صلاتك ← تحسن صلاتك","cause":"اذكر الموتَ في صلاتِك","result":"فإنَّ الرجلَ إذا ذكر الموتَ في صلاتِه لحريٌّ أن يُحسنَ صلاتَه","explicit":true,"ref":"صحيح الجامع 849","srcLabel":"البيهقي","text":[["اذكر الموتَ في صلاتِك ، ",1],["فإنَّ الرجلَ إذا ذكر الموتَ في صلاتِه لحريٌّ أن يُحسنَ صلاتَه",2]," ، و صلِّ صلاةَ رجلٍ لا يظنُّ أنَّه يُصلِّي صلاةً غيرَها ، و إيَّاك و كلُّ أمرٍ يُعتذَرُ منه"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"أخرجه البيهقي في ((الزهد الكبير)) (527)، والديلمي في ((الفردوس)) (1755)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"ZSb4qWo5"},{"id":"س-05969","fp":"aa471f55b114","stateId":184,"easy":"إذا أسررت سريرة ← يلبسك الله رداءها: خيراً أو شراً","cause":"ما أسَرَّ عَبدٌ سَريرةً","result":"إلَّا ألبَسَه اللهُ رِداءَها إن خَيرًا فخَيرٌ، وإن شَرًّا فشَرٌّ","explicit":true,"ref":"فيض القدير 5/ 420","srcLabel":"فيض القدير","text":[["ما أسَرَّ عَبدٌ سَريرةً",1]," ",["إلَّا ألبَسَه اللهُ رِداءَها إن خَيرًا فخَيرٌ، وإن شَرًّا فشَرٌّ",2]],"grade":"حسن","narrator":"جندب بن سفيان البجلي","muhaddith":"رمز السيوطي لحسنه وليس ذا منه بصواب","bab":"رقائق وزهد › الوصايا النافعة","dorar":"xAln2IxG"},{"id":"س-07737","fp":"0ee9978cbf3a","stateId":184,"easy":"إذا صليت فاخشع وغضّ بصرك ← تكون من الخاشعين","cause":"رفعَ بصَرَهُ إلى السَّماءِ","result":"فنزلَت الَّذِينَ هُمْ فِي صَلَاتِهِمْ خَاشِعُونَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تحفة المحتاج 1/367","srcLabel":"الحاكم","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ كانَ إذا صلَّى ",["رفعَ بصَرَهُ إلى السَّماءِ",1]," ",["فنزلَت  الَّذِينَ هُمْ فِي صَلَاتِهِمْ خَاشِعُونَ",2],"  فطأطأَ رأسَهُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح أو حسن [كما اشترط على نفسه في المقدمة]","takhrij":"أخرجه الحاكم (3483)، والواحدي في ((أسباب النزول)) (312) دون قوله:(( فطأطأ رأسه))، والبيهقي (3585) جميعا بلفظه.","bab":"قرآن › أسباب النزول","dorar":"MXeiBeC8"},{"id":"س-06834","fp":"a417afacf798","stateId":184,"easy":"إذا أصلحت قلبك وعملك ← فالله ينظر إليهما لا إلى صورتك ومالك","cause":"قلوبِكم وأعمالِكم","result":"ولكنْ إِنَّما ينظرُ إلى","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الجامع 1862","srcLabel":"مسلم","text":["إِنَّ اللهَ تعالى لَا ينظرُ إلى صُوَرِكُمْ وَأمْوالِكُمْ ، ",["ولكنْ إِنَّما ينظرُ إلى",2]," ",["قلوبِكم وأعمالِكم",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2564)، وابن ماجة (4143)، وأحمد (7827) واللفظ لهم.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"uvliIjuZ","merged":3,"otherRefs":["الأسماء والصفات للبيهقي 2/234 (صحيح)","صحيح الترغيب 15 (صحيح)"]},{"id":"س-00651","fp":"a116c3d6acdc","stateId":184,"easy":"إذا صلح قلبك ← صلحت جوارحك","cause":"وإذا صَلَحَ المَلِكُ","result":"صَلَحَ جُنودُه","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"الفوائد المجموعة 468","srcLabel":"البيهقي","text":["نحو [عن أبي هُرَيرةَ مِن قَولِه: اليَدانِ جَناحانِ، الرِّجلانِ بَريدانِ، والأُذُنانِ قُمعٌ، والعَينانِ دَليلٌ، واللِّسانُ تُرجُمانٌ، والطِّحالُ ضَحكٌ، والرِّئةُ نَفسٌ، والكُليَتانِ مَكرٌ، والكَبدُ رَحمةٌ، والقَلبُ مَلكٌ، فإذا فسَدَ المَلكُ فسَدَ جُنودُه، ",["وإذا صَلَحَ المَلِكُ",1]," ",["صَلَحَ جُنودُه",2],"]"],"grade":"حسن","narrator":"أبو صالح السمان.","muhaddith":"إسناده قوي","takhrij":"أخرجه معمر في ((الجامع)) (20375)، وأبو نعيم الأصبهاني في ((الطب النبوي)) (94)، والبيهقي في ((شعب الإيمان)) (108) جميعهم بلفظه تاما.","bab":"آداب عامة › ضرب الأمثال","dorar":"U6EatbI4"},{"id":"س-04946","fp":"eb2739df3a5f","stateId":184,"easy":"إذا استقام لسانك ← استقامت جوارحك","cause":"فإنِ استقمْتَ","result":"استَقَمْنا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج رياض الصالحين 1521","srcLabel":"الترمذي","text":["\"إذا أصبَحَ ابنُ آدَمَ، فإنَّ الأعضاءَ كُلَّها تُكفِّرُ اللِّسانَ، تقولُ: اتَّقِ اللهَ فينا؛ فإنَّما نحنُ بك: ",["فإنِ استقمْتَ",1]," ",["استَقَمْنا",2],"، وإنِ اعوجَجْتَ اعوجَجْنا\"."],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"حسن","takhrij":"أخرجه الترمذي (2407) واللفظ له، وأحمد (11908)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"cV2LekpG"},{"id":"س-05641","fp":"4ee8328ab0ed","stateId":184,"easy":"إذا ملكت لسانك ← ملكت أمرك كله","cause":"هذا ، وأشار بيدِه إلى لسانِه","result":"بما هو أملَكُ بك من هذا كلِّه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"الترغيب والترهيب 4/24","srcLabel":"الطبراني","text":["قال : يا رسولَ اللهِ أوصِني . قال : اعبُدِ اللهَ كأنَّك تراه ، واعدُدْ نفسَك في الموتَى ، وإن شئتَ أنبأتُك ",["بما هو أملَكُ بك من هذا كلِّه",2]," ؟ قال : ",["هذا ، وأشار بيدِه إلى لسانِه",1]],"grade":"حسن","narrator":"معاذ بن جبل","muhaddith":"إسناده جيد","takhrij":"أخرجه ابن أبي الدنيا في ((الصمت)) (22) باختلاف يسير، والطبراني (20/175) (374)، والبيهقي في ((شعب الإيمان)) (548) مطولاً باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"yDMOpL1o"},{"id":"س-05742","fp":"fb48473a9fe3","stateId":185,"easy":"إذا رضيت بالمجلس الأدنى ← فهو من التواضع","cause":"الرِّضا بالدُّونِ مِن شَرَفِ المَجالِسِ","result":"إنَّ مِن التَّواضُعِ","explicit":true,"star":true,"ref":"الأحاديث المختارة 841","srcLabel":"البخاري","text":["«",["إنَّ مِن التَّواضُعِ",2]," ",["الرِّضا بالدُّونِ مِن شَرَفِ المَجالِسِ",1],"»."],"grade":"صحيح","narrator":"طلحة بن عبيد الله","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"رقائق وزهد › الكبر والتواضع","dorar":"XdRJkf9H","merged":3,"otherRefs":["الأمالي المطلقة 95 (حسن)","تخريج الإحياء للعراقي 2/20 (حسن)"]},{"id":"ق-0087","fp":"5032a016fd7c","stateId":185,"easy":"ترك عضل النساء والاتعاظ بأمر الله ← زكاة وطهارة","cause":"ترك عضل النساء والاتعاظ بأمر الله","result":"زكاة وطهارة","explicit":true,"star":true,"ref":"سورة البقرة: 232","srcLabel":"القرآن الكريم","quran":{"s":2,"from":232,"to":232,"text":"وَإِذَا طَلَّقْتُمُ النِّسَاءَ فَبَلَغْنَ أَجَلَهُنَّ فَلَا تَعْضُلُوهُنَّ أَنْ يَنْكِحْنَ أَزْوَاجَهُنَّ إِذَا تَرَاضَوْا بَيْنَهُمْ بِالْمَعْرُوفِ ذَلِكَ يُوعَظُ بِهِ مَنْ كَانَ مِنْكُمْ يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الْآخِرِ ذَلِكُمْ أَزْكَى لَكُمْ وَأَطْهَرُ وَاللَّهُ يَعْلَمُ وَأَنْتُمْ لَا تَعْلَمُونَ (232)","hl":[[229,263,1]]}},{"id":"ق-0855","fp":"67433869cf92","stateId":185,"easy":"الاستئذان والسلام والرجوع إذا قيل ارجعوا ← خير وأزكى","cause":"الاستئذان والسلام والرجوع إذا قيل ارجعوا","result":"خير وأزكى","explicit":true,"star":true,"otherNeedIds":[55],"ref":"سورة النور: 27–28","srcLabel":"القرآن الكريم","quran":{"s":24,"from":27,"to":28,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَدْخُلُوا بُيُوتًا غَيْرَ بُيُوتِكُمْ حَتَّى تَسْتَأْنِسُوا وَتُسَلِّمُوا عَلَى أَهْلِهَا ذَلِكُمْ خَيْرٌ لَكُمْ لَعَلَّكُمْ تَذَكَّرُونَ (27) فَإِنْ لَمْ تَجِدُوا فِيهَا أَحَدًا فَلَا تَدْخُلُوهَا حَتَّى يُؤْذَنَ لَكُمْ وَإِنْ قِيلَ لَكُمُ ارْجِعُوا فَارْجِعُوا هُوَ أَزْكَى لَكُمْ وَاللَّهُ بِمَا تَعْمَلُونَ عَلِيمٌ (28)","hl":[[74,318,1]]}},{"id":"ق-0856","fp":"0025de2fedd7","stateId":185,"easy":"غض البصر وحفظ الفرج ← أزكى للعبد","cause":"غض البصر وحفظ الفرج","result":"أزكى للعبد","explicit":true,"otherNeedIds":[20],"ref":"سورة النور: 30","srcLabel":"القرآن الكريم","quran":{"s":24,"from":30,"to":30,"text":"قُلْ لِلْمُؤْمِنِينَ يَغُضُّوا مِنْ أَبْصَارِهِمْ وَيَحْفَظُوا فُرُوجَهُمْ ذَلِكَ أَزْكَى لَهُمْ إِنَّ اللَّهَ خَبِيرٌ بِمَا يَصْنَعُونَ (30)","hl":[[0,96,1]]}},{"id":"س-02486","fp":"d21eabc8d450","stateId":185,"easy":"إذا رفعت ثوبك (عن الإسبال) ← فهو أبقى لثوبك وأتقى لربك","cause":"ارفَعْ ثَوبَكَ","result":"فإنَّه أبقى لثَوبِكَ، وأتقى لرَبِّكَ","explicit":true,"otherNeedIds":[55,17],"ref":"صحيح البخاري 3700","srcLabel":"النسائي","text":["رَأيتُ عُمَرَ بنَ الخَطَّابِ رَضيَ اللهُ عنه قَبلَ أن يُصابَ بأيَّامٍ بالمَدينةِ وقَفَ على حُذَيفةَ بنِ اليَمانِ وعُثمانَ بنِ حُنَيفٍ، قال: كيفَ فعَلتُما؟ أتَخافانِ أن تَكونا قد حَمَّلتُما الأرضَ ما لا تُطيقُ؟ قالا: حَمَّلناها أمرًا هي له مُطيقةٌ، ما فيها كَبيرُ فضلٍ، قال: انظُرا أن تَكونا حَمَّلتُما الأرضَ ما لا تُطيقُ، قال: قالا: لا، فقال عُمَرُ: لَئِن سَلَّمَني اللهُ لَأدَعَنَّ أرامِلَ أهلِ العِراقِ لا يَحتَجنَ إلى رَجُلٍ بَعدي أبَدًا، قال: فما أتَت عليه إلَّا رابِعةٌ حتَّى أُصيبَ، قال: إنِّي لَقائِمٌ ما بَيني وبينَه إلَّا عبدُ اللهِ بنُ عَبَّاسٍ غَداةَ أُصيبَ، وكان إذا مَرَّ بينَ الصَّفَّينِ قال: استَووا، حتَّى إذا لَم يَرَ فيهنَّ خَلَلًا تَقدَّمَ فكَبَّرَ، ورُبَّما قَرَأ سورةَ يوسُفَ، أوِ النَّحلَ، أو نَحوَ ذلك في الرَّكعةِ الأولى حتَّى يَجتَمِعَ النَّاسُ، فما هو إلَّا أن كَبَّرَ، فسَمِعتُه يقولُ: قَتَلَني -أو أكَلَني- الكَلبُ، حينَ طَعَنَه، فطارَ العِلجُ بسِكِّينٍ ذاتِ طَرَفَينِ، لا يَمُرُّ على أحَدٍ يَمينًا ولا شِمالًا إلَّا طَعَنَه، حتَّى طَعَنَ ثَلاثةَ عَشَرَ رَجُلًا، ماتَ منهم سَبعةٌ، فلَمَّا رَأى ذلك رَجُلٌ مِنَ المُسلِمينَ طَرَحَ عليه بُرنُسًا، فلَمَّا ظَنَّ العِلجُ أنَّه مَأخوذٌ نَحَرَ نَفسَه، وتَناولَ عُمَرُ يَدَ عبدِ الرَّحمَنِ بنِ عَوفٍ فقدَّمَه، فمَن يَلي عُمَرَ فقد رَأى الذي أرى، وأمَّا نَواحي المَسجِدِ فإنَّهم لا يَدرونَ، غيرَ أنَّهم قد فقدوا صَوتَ عُمَرَ، وهم يقولونَ: سُبحانَ اللهِ! سُبحانَ اللهِ! فصَلَّى بهِم عبدُ الرَّحمَنِ صَلاةً خَفيفةً، فلَمَّا انصَرَفوا قال: يا ابنَ عَبَّاسٍ، انظُرْ مَن قَتَلَني، فجالَ ساعةً ثُمَّ جاءَ فقال: غُلامُ المُغيرةِ، قال: الصَّنَعُ؟ قال: نَعَم، قال: قاتَلَه اللهُ! لقد أمَرتُ به مَعروفًا، الحَمدُ للَّهِ الذي لَم يَجعَلْ مَيتَتي بيَدِ رَجُلٍ يَدَّعي الإسلامَ، قد كُنتَ أنتَ وأبوكَ تُحِبَّانِ أن تَكثُرَ العُلوجُ بالمَدينةِ -وكان العَبَّاسُ أكثَرَهم رَقيقًا- فقال: إن شِئتَ فعَلتُ -أي: إن شِئتَ قَتَلنا- قال: كَذَبتَ، بَعدَما تَكَلَّموا بلِسانِكُم، وصَلَّوا قِبلَتَكُم، وحَجُّوا حَجَّكُم! فاحتُمِلَ إلى بَيتِه، فانطَلَقنا معهُ وكَأنَّ النَّاسَ لَم تُصِبْهم مُصيبةٌ قَبلَ يَومَئذٍ، فقائِلٌ يقولُ: لا بَأسَ، وقائِلٌ يقولُ: أخافُ عليه، فأُتيَ بنَبيذٍ فشَرِبَه، فخَرَجَ مِن جَوفِه، ثُمَّ أُتيَ بلَبَنٍ فشَرِبَه فخَرَجَ مِن جُرحِه، فعَلِموا أنَّه مَيِّتٌ، فدَخَلنا عليه، وجاءَ النَّاسُ، فجَعَلوا يُثنونَ عليه، وجاءَ رَجُلٌ شابٌّ، فقال: أبشِرْ يا أميرَ المُؤمِنينَ ببُشرى اللهِ لَكَ؛ مِن صُحبةِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، وقدَمٍ في الإسلامِ ما قد عَلِمتَ، ثُمَّ وَلِيتَ فعَدَلتَ، ثُمَّ شَهادةٌ، قال: ودِدتُ أنَّ ذلك كَفافٌ لا عليَّ ولا لي، فلَمَّا أدبَرَ إذا إزارُه يَمَسُّ الأرضَ، قال: رُدُّوا عليَّ الغُلامَ، قال: يا ابنَ أخي، ",["ارفَعْ ثَوبَكَ",1],"؛ ",["فإنَّه أبقى لثَوبِكَ، وأتقى لرَبِّكَ",2],". يا عَبدَ اللهِ بنَ عُمَرَ، انظُرْ ما عليَّ مِنَ الدَّينِ، فحَسَبوه فوجَدوه سِتَّةً وثَمانينَ ألفًا أو نَحوَه، قال: إنْ وفى له مالُ آلِ عُمَرَ فأدِّه مِن أموالِهم، وإلَّا فسَلْ في بَني عَديِّ بنِ كَعبٍ، فإن لَم تَفِ أموالُهم فسَلْ في قُرَيشٍ، ولا تَعدُهم إلى غيرِهم، فأدِّ عَنِّي هذا المالَ. انطَلِقْ إلى عائِشةَ أُمِّ المُؤمِنينَ، فقُلْ: يَقرَأُ عليكِ عُمَرُ السَّلامَ، ولا تَقُلْ: أميرُ المُؤمِنينَ؛ فإنِّي لَستُ اليومَ للمُؤمِنينَ أميرًا، وقُل: يَستَأذِنُ عُمَرُ بنُ الخَطَّابِ أن يُدفَنَ مع صاحِبَيه، فسَلَّمَ واستَأذَنَ، ثُمَّ دَخَلَ عليها، فوجَدَها قاعِدةً تَبكي، فقال: يَقرَأُ عليكِ عُمَرُ بنُ الخَطَّابِ السَّلامَ، ويَستَأذِنُ أن يُدفَنَ مع صاحِبَيه، فقالت: كُنتُ أُريدُه لنَفسي، ولَأوثِرَنَّ به اليومَ على نَفسي، فلَمَّا أقبَلَ قيلَ: هذا عبدُ اللهِ بنُ عُمَرَ قد جاءَ، قال: ارفَعوني، فأسنَدَه رَجُلٌ إليه، فقال: ما لَدَيكَ؟ قال: الذي تُحِبُّ يا أميرَ المُؤمِنينَ؛ أذِنَت، قال: الحَمدُ للَّهِ، ما كان مِن شَيءٍ أهَمُّ إليَّ مِن ذلك، فإذا أنا قَضَيتُ فاحمِلوني، ثُمَّ سَلِّمْ، فقُل: يَستَأذِنُ عُمَرُ بنُ الخَطَّابِ، فإن أذِنَت لي فأدخِلوني، وإن رَدَّتني رُدُّوني إلى مَقابِرِ المُسلِمينَ، وجاءَت أُمُّ المُؤمِنينَ حَفصةُ والنِّساءُ تَسيرُ معها، فلَمَّا رَأيناها قُمنا، فولَجَت عليه، فبَكَت عِندَه ساعةً. واستَأذَنَ الرِّجالُ، فولَجَت داخِلًا لهم، فسَمِعنا بُكاءَها مِنَ الدَّاخِلِ، فقالوا: أوصِ يا أميرَ المُؤمِنينَ، استَخلِفْ، قال: ما أجِدُ أحَدًا أحَقَّ بهذا الأمرِ مِن هؤلاء النَّفَرِ -أوِ الرَّهطِ- الذينَ توفِّيَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم وهو عنهم راضٍ، فسَمَّى عَليًّا، وعُثمانَ، والزُّبَيرَ، وطَلحةَ، وسَعدًا، وعَبدَ الرَّحمَنِ، وقال: يَشهَدُكُم عبدُ اللهِ بنُ عُمَرَ، وليسَ له مِنَ الأمرِ شَيءٌ -كَهَيئةِ التَّعزيةِ له- فإن أصابَتِ الإمرةُ سَعدًا فهو ذاكَ، وإلَّا فليَستَعِنْ به أيُّكُم ما أُمِّرَ؛ فإنِّي لَم أعزِلْه عن عَجزٍ ولا خيانةٍ، وقال: أوصي الخَليفةَ مِن بَعدي بالمُهاجِرينَ الأوَّلينَ؛ أن يَعرِفَ لهم حَقَّهم، ويَحفَظَ لهم حُرمَتَهم، وأوصيه بالأنصارِ خَيرًا الذينَ تَبَوَّؤوا الدَّارَ والإيمانَ مِن قَبلِهم؛ أن يُقبَلَ مِن مُحسِنِهم، وأن يُعفى عن مُسيئِهم، وأوصيه بأهلِ الأمصارِ خَيرًا؛ فإنَّهم رِدءُ الإسلامِ، وجُباةُ المالِ، وغَيظُ العَدوِّ، وألَّا يُؤخَذَ منهم إلَّا فضلُهم عن رِضاهم، وأوصيه بالأعرابِ خَيرًا؛ فإنَّهم أصلُ العَرَبِ، ومادَّةُ الإسلامِ؛ أن يُؤخَذَ مِن حَواشي أموالِهم، ويُرَدَّ على فُقَرائِهم، وأوصيه بذِمَّةِ اللهِ، وذِمَّةِ رَسولِه صلَّى اللهُ عليه وسلَّم أن يوفى لهم بعَهدِهم، وأن يُقاتَلَ مِن ورائِهم، ولا يُكَلَّفوا إلَّا طاقَتَهم. فلَمَّا قُبِضَ خَرَجنا به، فانطَلَقنا نَمشي، فسَلَّمَ عبدُ اللهِ بنُ عُمَرَ، قال: يَستَأذِنُ عُمَرُ بنُ الخَطَّابِ، قالت: أدخِلوه، فأُدخِلَ، فوُضِعَ هُنالِكَ مع صاحِبَيه، فلَمَّا فُرِغَ مِن دَفنِه اجتَمع هؤلاء الرَّهطُ، فقال عبدُ الرَّحمَنِ: اجعَلوا أمرَكُم إلى ثَلاثةٍ مِنكُم، فقال الزُّبَيرُ: قد جَعَلتُ أمري إلى عَليٍّ، فقال طَلحةُ: قد جَعَلتُ أمري إلى عُثمانَ، وقال سَعدٌ: قد جَعَلتُ أمري إلى عبدِ الرَّحمَنِ بنِ عَوفٍ، فقال عبدُ الرَّحمَنِ: أيُّكُما تَبَرَّأ مِن هذا الأمرِ، فنَجعَلُه إليه، واللهُ عليه والإسلامُ، لَيَنظُرَنَّ أفضَلَهم في نَفسِه؟ فأُسكِتَ الشَّيخانِ، فقال عبدُ الرَّحمَنِ: أفَتَجعَلونَه إليَّ؟ واللهُ عليَّ ألَّا آلُ عن أفضَلِكُم؟ قالا: نَعَم، فأخَذَ بيَدِ أحَدِهما فقال: لكَ قَرابةٌ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم والقَدَمُ في الإسلامِ ما قد عَلِمتَ، فاللهُ عليك لَئِن أمَّرتُكَ لَتَعدِلَنَّ، ولَئِن أمَّرتُ عُثمانَ لَتَسمعنَّ ولَتُطيعَنَّ، ثُمَّ خَلا بالآخَرِ فقال له مِثلَ ذلك، فلَمَّا أخَذَ الميثاقَ قال: ارفَعْ يَدَكَ يا عُثمانُ، فبايَعَه، فبايَعَ له عَليٌّ، وولَجَ أهلُ الدَّارِ فبايَعوه."],"grade":"صحيح","narrator":"عمرو بن ميمون","muhaddith":"[صحيح]","takhrij":"أخرجه ابن حبان (6917)، باختلاف يسير، وابن أبي شيبة (37059)، بلفظ مقارب، والنسائي في ((السنن الكبرى)) (11517)، مختصرا.","bab":"إمامة وخلافة › الاستخلاف","dorar":"v05gmXrj","merged":2,"otherRefs":["تخريج شرح السنة 3079 (حسن)"]},{"id":"س-05336","fp":"b684a162dc0c","stateId":185,"easy":"إذا ظننت ← فلا تحقق الظن (فهو المخرج منه)","cause":"أن لا يحَقِّقَ","result":"ومَخرَجُه عن الظَّنِّ","explicit":true,"ref":"المصابيح في الأحاديث المتواترة 611","srcLabel":"المصابيح في الأحاديث المتواترة","text":["وفي الإنسانِ ثلاثةٌ: الطِّيَرةُ والظَّنُّ والحسَدُ؛ فمَخرَجُه مِنَ الطِّيَرةِ أن لا يرجِعَ، ",["ومَخرَجُه عن الظَّنِّ",2]," ",["أن لا يحَقِّقَ",1],"، ومَخرَجُه عن الحسَدِ أن لا يبغيَ"],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"رقائق وزهد › التوكل واليقين","dorar":"m7AGaTJ7"},{"id":"س-05337","fp":"f622b16d297a","stateId":185,"easy":"إذا حسدت ← فلا تبغِ (فهو المخرج منه)","cause":"أن لا يبغيَ","result":"ومَخرَجُه عن الحسَدِ","explicit":true,"ref":"المصابيح في الأحاديث المتواترة 611","srcLabel":"المصابيح في الأحاديث المتواترة","text":["وفي الإنسانِ ثلاثةٌ: الطِّيَرةُ والظَّنُّ والحسَدُ؛ فمَخرَجُه مِنَ الطِّيَرةِ أن لا يرجِعَ، ومَخرَجُه عن الظَّنِّ أن لا يحَقِّقَ، ",["ومَخرَجُه عن الحسَدِ",2]," ",["أن لا يبغيَ",1]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"رقائق وزهد › التوكل واليقين","dorar":"m7AGaTJ7"},{"id":"س-05723","fp":"990285959150","stateId":185,"easy":"إذا ركبت الحمار وحلبت الشاة ولبست البسيط ← فليس فيك شيء من الكبر","cause":"رَكِبْتُ الحِمارَ، واعتَقَلْتُ الشَّاةَ، ولَبِسْتُ الشَّمْلةَ","result":"مَن فعَلَ هذا فليْسَ فيهِ شَيءٌ مِن الكِبْرِ","explicit":true,"ref":"المستدرك على الصحيحين 7577","srcLabel":"الحاكم","text":["قالَ: يقولونُ: فيَّ التِّيهُ، وقد ",["رَكِبْتُ الحِمارَ، واعتَقَلْتُ الشَّاةَ، ولَبِسْتُ الشَّمْلةَ",1],"، وقدْ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["مَن فعَلَ هذا فليْسَ فيهِ شَيءٌ مِن الكِبْرِ",2],"."],"grade":"صحيح","narrator":"جبير بن مطعم","muhaddith":"صحيح الإسناد","bab":"رقائق وزهد › الكبر والتواضع","dorar":"wf1vjZ0h"},{"id":"س-07549","fp":"c153dac954f9","stateId":185,"easy":"إذا صليت على النبي ﷺ ← تكون الصلاة عليه زكاة لك","cause":"صلُّوا علَيَّ","result":"فإنَّ الصَّلاةَ علَيَّ زكاةٌ لكم، وسَلوا اللهَ تعالى لي الوسيلةَ","explicit":true,"otherNeedIds":[45],"ref":"المصابيح في الأحاديث المتواترة 610","srcLabel":"المصابيح في الأحاديث المتواترة","text":[["صلُّوا علَيَّ؛ ",1],["فإنَّ الصَّلاةَ علَيَّ زكاةٌ لكم، وسَلوا اللهَ تعالى لي الوسيلةَ",2],"، قالوا: وما الوسيلةُ؟ قال: هي أعلى درجةٍ في الجنَّةِ، لا ينالُها إلَّا رجلٌ واحِدٌ، وأنا أرجو أن أكونَ أنا هو"],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"فضائل النبي وصفته ودلائل النبوة › خصائصه صلى الله عليه وسلم","dorar":"JhspF2ig"},{"id":"س-06396","fp":"03981e9081c0","stateId":185,"easy":"إذا أديت الزكاة وأكرمت الضيف وأعطيت في النوائب ← تُوقى شحّ نفسك","cause":"مَن أدَّى الزَّكاةَ، وقَرى الضَّيفَ، وأعطى في النَّائِبةِ","result":"ثَلاثٌ مَن كُنَّ فيه وُقِيَ شُحَّ نَفسِه","explicit":true,"otherNeedIds":[53],"ref":"فيض القدير 3/ 289","srcLabel":"فيض القدير","text":[["ثَلاثٌ مَن كُنَّ فيه وُقِيَ شُحَّ نَفسِه",2],": ",["مَن أدَّى الزَّكاةَ، وقَرى الضَّيفَ، وأعطى في النَّائِبةِ",1]],"grade":"حسن","narrator":"خالد بن زيد بن حارثة","muhaddith":"إسناده حسن","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"1b0SyB3z"},{"id":"س-05309","fp":"8c8c26e2d318","stateId":185,"easy":"إذا ظننت سوءاً فلا تحقّق ← تسلم من إثم الظن","cause":"فلا تُحقِّقوا","result":"إذا ظننتم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"السلسلة الصحيحة 3942","srcLabel":"ابن ماجه","text":[["إذا ظننتم",2]," ",["فلا تُحقِّقوا",1]," . وإذا حسدتم فلا تَبغُوا . وإذا تطيَّرتم فامضوا ؛ وعلى اللهِ توكَّلوا . وإذا وزنتم فأرجِحوا"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"ثابت","takhrij":"أخرجه ابن ماجه (2222) آخره","bab":"رقائق وزهد › التوكل واليقين","dorar":"t1Swasho"},{"id":"س-05310","fp":"77f55629dfe6","stateId":185,"easy":"إذا حسدت فلا تبغِ ← تسلم من شر الحسد","cause":"فلا تَبغُوا","result":"وإذا حسدتم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"السلسلة الصحيحة 3942","srcLabel":"ابن ماجه","text":["إذا ظننتم فلا تُحقِّقوا . ",["وإذا حسدتم",2]," ",["فلا تَبغُوا",1]," . وإذا تطيَّرتم فامضوا ؛ وعلى اللهِ توكَّلوا . وإذا وزنتم فأرجِحوا"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"ثابت","takhrij":"أخرجه ابن ماجه (2222) آخره","bab":"رقائق وزهد › التوكل واليقين","dorar":"t1Swasho"},{"id":"س-07238","fp":"6505fee4873c","stateId":185,"easy":"إذا سفهت الحق واحتقرت الناس ← فهو الكبر","cause":"سفِه الحقَّ وغمِص النَّاسَ","result":"إنَّما الكِبْرُ","explicit":true,"star":true,"ref":"تخريج صحيح ابن حبان 4229","srcLabel":"مسلم","text":["جاء رجُلٌ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم فقال: يا رسولَ اللهِ إنِّي حُبِّب إليَّ الجمالُ فما أُحِبُّ أنْ يفوقَني أحَدٌ فيه بشِراكٍ أفمِن الكِبْرِ هو ؟ قال: ( لا، ",["إنَّما الكِبْرُ",2]," مَن ",["سفِه الحقَّ وغمِص النَّاسَ",1]," )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن حبان (4437) بلفظه، وأبو داوود (4092)، والحاكم في ((مستدركه)) (7366) كلاهما باختلاف يسير.","bab":"علم › سؤال العالم عما لا يعلم","dorar":"MnPoMxiP"}]}