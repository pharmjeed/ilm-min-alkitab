{"schema":1,"kind":"sunan-chunk","version":"sunan-c56d7b8d0f22","needId":36,"stateIds":[380,381],"items":[{"id":"س-02142","fp":"553449037498","stateId":380,"easy":"إذا بررت والديك ← طوبى لك وزاد الله في عمرك","cause":"مَن بَرَّ والِدَيْهِ طُوبَى له","result":"زادَ اللهُ في عُمُرِه","explicit":true,"star":true,"similar":["س-00080"],"ref":"المستدرك على الصحيحين 7463","srcLabel":"البخاري","text":[["مَن بَرَّ والِدَيْهِ طُوبَى له، ",1],["زادَ اللهُ في عُمُرِه",2],"."],"grade":"صحيح","narrator":"معاذ [بن أنس]","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (22)، والطبراني (20/ 198) (447)، والبيهقي في ((الشعب)) (7470) واللفظ لهم.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"ekQxm1PE"},{"id":"س-00080","fp":"531c331a989a","stateId":380,"easy":"إذا بررت والديك ← يزيد الله في عمرك","cause":"بِرُّ الوالدينِ","result":"يَزيدُ في العُمُرِ","explicit":true,"repOf":"س-02142","ref":"مختصر المقاصد 456","text":["الدعاءُ يَرُدُّ البلاءَ [يعني حديث: ",["بِرُّ الوالدينِ ",1],["يَزيدُ في العُمُرِ",2],"، والكَذِبُ يُنقِصُ مِنَ الرِّزقِ، والدعاءُ يَرُدُّ البلاءَ، ولِلَّهِ في خَلقِه قضاءان، فقضاءٌ نافِذٌ، وقضاءٌ يُنْتَظَرُ، ولِلْأنبياءِ على العلماءِ فضلُ دَرَجَتينِ، وللعلماءِ على الشهداءِ فضلُ دَرَجَةٍ]"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"صحيح","takhrij":"أخرجه أبو الشيخ الأصبهاني في ((الفوائد)) (27 )، والشجري كما في ((ترتيب الأمالي)) (1981 )","bab":"آداب الدعاء › استجابة الدعاء","dorar":"4P94Rq6J","merged":4,"otherRefs":["الجامع الصغير 9950 (صحيح)","المستدرك على الصحيحين 1838 (صحيح)","صحيح ابن حبان 872 (صحيح)"]},{"id":"س-02068","fp":"b2b165c795cc","stateId":380,"easy":"إذا وصلت رحمك ← يزيد في عمرك","cause":"صِلَةِ الرَّحِمِ","result":"تَزيدُ في العُمُرِ","explicit":true,"star":true,"similar":["س-05784"],"ref":"الفتح الرباني 1/400","srcLabel":"أحمد","text":["حديث  ",["صِلَةِ الرَّحِمِ",1]," ، وأنَّها ",["تَزيدُ في العُمُرِ",2]," [يعني حديث: مَن سَرَّهُ أنْ يُبْسَطَ له في رِزْقِهِ، أوْ يُنْسَأَ له في أثَرِهِ، فَلْيَصِلْ رَحِمَهُ .]"],"grade":"صحيح","narrator":"[أنس بن مالك]","muhaddith":"صحيح","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"8TSVtD7S","merged":4,"otherRefs":["شرح الطحاوية 143 (صحيح)","المصابيح في الأحاديث المتواترة 610 (صحيح)","صحيح الجامع 3760 (صحيح)"]},{"id":"س-05810","fp":"686d8c8d40a9","stateId":380,"easy":"إذا بررت والديك ووصلت رحمك ← يُمد لك في عمرك ويُزاد في رزقك","cause":"فلْيَبَرَّ والِدَيهِ، ولْيَصِلْ رحِمَه","result":"مَن سَرَّهُ أنْ يُمَدَّ له في عُمُرِه، ويُزادَ في رِزقِه","explicit":true,"star":true,"otherNeedIds":[1,32],"ref":"تخريج المسند لشعيب 13811","srcLabel":"أحمد","text":[["مَن سَرَّهُ أنْ يُمَدَّ له في عُمُرِه، ويُزادَ في رِزقِه، ",2],["فلْيَبَرَّ والِدَيهِ، ولْيَصِلْ رحِمَه",1],". قال: وقال السالَحِينيُّ: يُبارَكَ له في رِزقِه، وقال: والِدَيهِ أيضًا. وقال يونسُ: والِدَيهِ، وقال: يُزادَ له في رِزقِه."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه أحمد (13811)، والعقيلي في ((الضعفاء الكبير)) (4/189)، وأبو نعيم في ((حلية الأولياء)) (3/107) باختلاف يسير.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"wqUCM2kR","merged":3,"otherRefs":["معجم الشيوخ 1/111 (صحيح)","الأحاديث المختارة 538 (صحيح)"]},{"id":"س-02281","fp":"94392fc53308","stateId":380,"easy":"إذا وصلت رحمك وحسن خلقك وأحسنت جوارك ← تعمر الديار وتزيد الأعمار","cause":"وصِلةُ الرحِمِ وحُسنُ الخُلُقِ، وحُسنُ الجِوارِ","result":"يَعمُرانِ الديارَ ويَزيدانِ في الأعمارِ","explicit":true,"similar":["س-03850"],"otherNeedIds":[1],"ref":"تخريج شرح السنة 13/ 74","srcLabel":"أحمد","text":["عن عائشةَ أنَّ النَّبِيَّ صلَّى اللهُ عليه وسلَّمَ قال لها: إنَّه مَن أُعطيَ حظَّه منَ الرفْقِ، فقد أُعطِيَ حظَّه من خَيرِ الدُّنيا والآخِرةِ، ",["وصِلةُ الرحِمِ وحُسنُ الخُلُقِ، وحُسنُ الجِوارِ",1]," ",["يَعمُرانِ الديارَ ويَزيدانِ في الأعمارِ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (25259) واللفظ له، وأبو يعلى (4530)، والبيهقي في ((معرفة السنن والآثار)) (20826) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"5RQPo3mB"},{"id":"س-05784","fp":"1eb9c8943652","stateId":380,"easy":"إذا وصلت رحمك ← تزيد في عمرك","cause":"وصلةُ الرحِمِ","result":"زيادةٌ في العمُرِ","explicit":true,"repOf":"س-02068","ref":"الجامع الصغير 5024","text":["صنائعُ المعروفِ تَقي مصارعَ السوءِ والصدقةُ خُفيا تُطفِئُ غضبَ الربِّ، ",["وصلةُ الرحِمِ",1]," ",["زيادةٌ في العمُرِ",2],"، وكلُّ معروفٍ صدَقَةٌ، وأهلُ المعروفِ في الدنيا هم أهلُ المعروفِ في الآخرةِ، وأهلُ المُنكَرِ في الدنيا هم أهلُ المُنكَرِ في الآخِرَةِ، وأولُ مَن يدخُلُ الجنةَ أهلُ المعروفِ"],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6086)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"FXfMwMQ4"},{"id":"س-08064","fp":"6559875435b8","stateId":380,"easy":"إذا بررت ووصلت ← يطيل الله عمرك ويعمر ديارك ويكثر مالك","cause":"إنَّ البِرَّ والصِّلةَ","result":"ليُطيلانِ الأعمارَ، ويَعمُرانِ الدِّيارَ، ويُكثِّرانِ الأموالَ","explicit":true,"otherNeedIds":[1],"ref":"المصابيح في الأحاديث المتواترة 589","srcLabel":"المصابيح في الأحاديث المتواترة","text":[["إنَّ البِرَّ والصِّلةَ",1]," ",["ليُطيلانِ الأعمارَ، ويَعمُرانِ الدِّيارَ، ويُكثِّرانِ الأموالَ",2]," ولو كان القومُ فُجَّارًا"],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"Mdel2okp"},{"id":"س-02211","fp":"395f72544bbf","stateId":380,"easy":"إذا بررت ← فالبر زيادة في العمر","cause":"والبِرُّ","result":"زيادةٌ في العمرِ","explicit":true,"ref":"مجمع الزوائد 8/140","srcLabel":"أبو داود","text":[["والبِرُّ",1]," ",["زيادةٌ في العمرِ",2]," والصَّدقةُ تمنَعُ ميتةَ السُّوءِ"],"grade":"حسن","narrator":"رافع بن مكيث الجهني","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني (5/ 17) (4451)، وأحمد (16079) واللفظ لهما وفي أوله زيادة، أبو داود (5162) بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"SzECOblE"},{"id":"س-03850","fp":"f1795be11e25","stateId":380,"easy":"إذا وصلت رحمك وحسن خلقك وجوارك ← تعمر الديار وتزيد في الأعمار","cause":"صِلةُ الرَّحِمِ وحُسنُ الخُلُقِ وحُسنُ الجِوارِ","result":"يَعمُرنَ الدِّيارَ ويَزِدنَ في الأعمارِ","explicit":true,"repOf":"س-02281","otherNeedIds":[1],"ref":"فيض القدير 4/ 196","text":[["صِلةُ الرَّحِمِ وحُسنُ الخُلُقِ وحُسنُ الجِوارِ",1]," ",["يَعمُرنَ الدِّيارَ ويَزِدنَ في الأعمارِ",2]],"grade":"حسن","narrator":"عائشة","muhaddith":"حسن","takhrij":"أخرجه البيهقي في ((الشعب)) (7599) واللفظ له، وابن أبي الدنيا في ((مكارم الأخلاق)) (326)، وأبو طاهر السلفي في ((معجم السفر)) (22) باختلاف يسير.","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"D42jT6j3"},{"id":"س-06005","fp":"67a7917f8db8","stateId":380,"easy":"إذا اتقيت ربك ووصلت رحمك ← يُنسأ لك في أجلك","cause":"من اتّقى ربَّه ووصل رحمَه","result":"نُسئ في أجلِه","explicit":true,"otherNeedIds":[1,41],"ref":"صحيح الأدب المفرد 43","srcLabel":"البخاري (الأدب المفرد)","text":["عن ابنِ عمرَ قال ",["من اتّقى ربَّه ووصل رحمَه ",1],["نُسئ في أجلِه",2]," وفي لفظٍ أنسئ له في عمرِه وثرا مالُه وأحبّه أهلُه"],"grade":"حسن","muhaddith":"حسن","bab":"رقائق وزهد › تقوى الله","dorar":"6AMKeVOa"},{"id":"س-01479","fp":"a90070df2430","stateId":380,"easy":"إذا أسبغت الوضوء ← يزيد في عمرك","cause":"أسبِغِ الوضوءَ","result":"يَزِدْ في عُمُرِكَ","explicit":true,"star":true,"ref":"الضعفاء الكبير 1/148","srcLabel":"البزار","text":["يا أَنَسُ،",[" أسبِغِ الوضوءَ ",1],["يَزِدْ في عُمُرِكَ",2],"، وصَلِّ مِن اللَّيلِ والنَّهارِ ما استطَعْتَ يُحِبَّكَ الحَفَظَةُ، وصَلِّ صلاةَ الضُّحى؛ فإنَّها صلاةُ الأوَّابينَ، فإنِ استطَعْتَ ألَّا تنامَ إلَّا على طهارةٍ، فإنَّكَ إن مِتَّ مِتَّ شهيدًا، وسلِّمْ على أهلِ بيتِكَ يكثُرْ خيرُ بيتِكَ، ووقِّرِ الكبيرَ، وارحَمِ الصَّغيرَ، تُرافِقْني في الجنَّةِ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"ليس لهذا المتن عن أنس إسناد صحيح","takhrij":"أخرجه البزار (7396)، وأبو يعلى (4183)، والعقيلي في ((الضعفاء الكبير)) (1/148) واللفظ له","bab":"وضوء › فضل الوضوء","dorar":"CfQ83tTb"},{"id":"س-07821","fp":"fd10a6254461","stateId":380,"easy":"إذا قرأت القرآن ← لا تُرد إلى أرذل العمر","cause":"من قرأ القرآنَ","result":"لم يُردَّ إلى أرذلِ العمرِ وذلك قولُه تعالَى","explicit":true,"ref":"الترغيب والترهيب 2/303","srcLabel":"الحاكم","text":["عن ابنِ عبَّاسٍ رضِي اللهُ عنهما قال ",["من قرأ القرآنَ ",1],["لم يُردَّ إلى أرذلِ العمرِ وذلك قولُه تعالَى ",2],"{ ثُمَّ رَدَدْنَاهُ أَسْفَلَ سَافِلِينَ إِلَّا الَّذِينَ آمَنُوا  } قال الَّذين قرؤُوا القرآنَ"],"grade":"صحيح","narrator":"[عكرمة مولى ابن عباس]","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الحاكم (3952)، والبيهقي في ((الشعب)) (2450) واللفظ لهما، والخطيب في ((الجامع لأخلاق الراوي)) (1924) بنحوه.","bab":"قرآن › فضل قراءة القرآن","dorar":"hDK1Mo1W"},{"id":"س-03286","fp":"f0abda967e7f","stateId":381,"easy":"إذا عُمّرت في الإسلام أربعين سنة ← يصرف الله عنك الجنون والجذام والبرص","cause":"ما من معمَّرٍ يعمَّرُ في الإسلامِ أربعينَ سنةً","result":"إلَّا صرفَ اللَّهُ عنهُ الجنونَ والجُذامَ والبرصَ ، فإذا بلغَ الخمسينَ ليَّنَ اللَّهُ حسابه ، فإذا بلغَ الستِّينَ رزقَه اللَّهُ الإنابةَ ، فإذا بلغَ السبعينَ أحبَّهُ اللَّهُ وأحبَّهُ أَهلُ السَّماءِ ، فإذا بلغَ الثَّمانينَ قبِلَ اللَّهُ حسناتِه وتجاوزَ عن سيِّئاتِه ، فإذا بلغَ التِسعينَ غفرَ اللَّهُ لَه ما تقدَّمَ من ذنبِهِ وما تأخَّرَ","explicit":true,"similar":["س-04162"],"otherNeedIds":[11],"ref":"الخصال المكفرة 1/89","srcLabel":"النسائي","text":[["ما من معمَّرٍ يعمَّرُ في الإسلامِ أربعينَ سنةً",1]," ",["إلَّا صرفَ اللَّهُ عنهُ الجنونَ والجُذامَ والبرصَ ، فإذا بلغَ الخمسينَ ليَّنَ اللَّهُ حسابه ، فإذا بلغَ الستِّينَ رزقَه اللَّهُ الإنابةَ ، فإذا بلغَ السبعينَ أحبَّهُ اللَّهُ وأحبَّهُ أَهلُ السَّماءِ ، فإذا بلغَ الثَّمانينَ قبِلَ اللَّهُ حسناتِه وتجاوزَ عن سيِّئاتِه ، فإذا بلغَ التِسعينَ غفرَ اللَّهُ لَه ما تقدَّمَ من ذنبِهِ وما تأخَّرَ",2]," ، وسُمِّيَ : أسيرَ اللَّهِ في الأرض ، وشُفِّعَ في أَهلِ بيتِه"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"رجاله ثقات ، وبكر بن سهل وإن كان النسائي تكلم فيه فقد توبع عليه","takhrij":"أخرجه أحمد (13279)، وأبو يعلى (4246) واللفظ لهما، والبزار عقب (6341) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"sQFvE3eo"},{"id":"س-04162","fp":"d8c3a65dead9","stateId":381,"easy":"إذا عُمّرت في الإسلام أربعين سنة ← يصرف الله عنك أنواعاً من البلاء","cause":"مَن عمَّره اللهُ تبارَك وتعالى أربعين سنةً في الإسلامِ","result":"صرَف اللهُ عنه أنواعًا مِنَ البلايا الجُذامَ والبَرَصَ وحَنَقَ الشَّيطانِ","explicit":true,"repOf":"س-03286","otherNeedIds":[11],"ref":"مجمع الزوائد 10/208","text":[["مَن عمَّره اللهُ تبارَك وتعالى أربعين سنةً في الإسلامِ",1]," ",["صرَف اللهُ عنه أنواعًا مِنَ البلايا الجُذامَ والبَرَصَ وحَنَقَ الشَّيطانِ",2]," ومَن عمَّره اللهُ خمسين سنةً في الإسلامِ ليَّن اللهُ عليه الحسابَ وفي روايةٍ هوَّن اللهُ عليه الحسابَ يومَ القيامةِ ومَن عمَّره اللهُ ستِّين سنةً في الإسلامِ رزَقه اللهُ الإنابةَ إليه بما يُحِبُّ اللهُ ومَن عمَّره اللهُ سبعين سنةً في الإسلامِ أحَبَّه أهلُ السَّماءِ وأهلُ الأرضِ ومَن عمَّره اللهُ ثمانين سنةً في الإسلامِ محا اللهُ سيِّئاتِه وكتَب حسناتِه قال أنسٌ في حديثِه كتَب اللهُ حسناتِه ولم يكتُبْ سيِّئاتِه ومَن عمَّره اللهُ تسعين سنةً في الإسلامِ غفَر اللهُ له ذنوبَه وكان أسيرَ اللهِ في أرضهِ وشفيعًا لأهلِ بيتِه يومَ القيامةِ قال أنسُ بنُ عياضٍ وشُفِّعَ في أهلِ بيتِه يومَ القيامةِ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"[روي] بإسنادين ورجال أحدهما ثقات","takhrij":"أخرجه البزار (6183) واللفظ له، وأبو يعلى (3678) مطولاً بنحوه","bab":"جنائز وموت › لقاء الله والمبادرة بالعمل الصالح","dorar":"3WdFby2q"},{"id":"س-06946","fp":"5c13ec9b7e90","stateId":381,"easy":"إذا بلغت أربعين سنة ← يعافيك الله من أنواع البلاء","cause":"إذا بَلَغَ العبدُ أربعينَ سَنَةً","result":"عافاهُ اللهُ تعالى من أنواعِ البلاءِ : مِنَ الجُنُونِ ، والجُذَامِ ، والبَرَصِ ، فإِذَا بَلَغَ خمسينَ رَزَقَهُ اللهُ الإِنابَةَ إليهِ ، فإذا بَلَغَ السِتِّينَ حَبَّبَهُ اللهُ إلى أهلِ سمائِهِ وأهلِ أرضِهِ ، فإذا بَلَغَ السبعينَ سَنَةً اسْتَحْيَ اللهُ مِنْهُ أنْ يُعَذِّبَهُ ، فإذا بَلَغَ تسعينَ كان أَسِيرَ اللهِ في أرضِهِ ، ولمْ يَخُطَّ عليهِ القَلَمُ بِحَرْفٍ","explicit":true,"otherNeedIds":[65],"ref":"الفتح الرباني 11/5364","srcLabel":"أحمد","text":[["إذا بَلَغَ العبدُ أربعينَ سَنَةً",1]," ",["عافاهُ اللهُ تعالى من أنواعِ البلاءِ : مِنَ الجُنُونِ ، والجُذَامِ ، والبَرَصِ ، فإِذَا بَلَغَ خمسينَ رَزَقَهُ اللهُ الإِنابَةَ إليهِ ، فإذا بَلَغَ السِتِّينَ حَبَّبَهُ اللهُ إلى أهلِ سمائِهِ وأهلِ أرضِهِ ، فإذا بَلَغَ السبعينَ سَنَةً اسْتَحْيَ اللهُ مِنْهُ أنْ يُعَذِّبَهُ ، فإذا بَلَغَ تسعينَ كان أَسِيرَ اللهِ في أرضِهِ ، ولمْ يَخُطَّ عليهِ القَلَمُ بِحَرْفٍ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن لغيره","takhrij":"لم نجده مسنداً، لكن ذكره الشوكاني في ((الفتح الرباني)) (11/5364)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"7cwtOseK"},{"id":"س-07865","fp":"c532be946f18","stateId":381,"easy":"إذا بلغت الأربعين ← يخفف الله عنك حسابك","cause":"إذا بلغَ العبدُ الأربعينَ","result":"خفَّفَ اللهُ تعالى عنه حسابَه , فإذا بلغَ الخمسينَ ليَّنَ اللَّهُ عليهِ الحسابَ , فإذا بلغَ الستِّينَ رزقَه اللَّهُ الإنابةَ إليه , فإذا بلغَ سبعينَ أحبَّهُ أَهلُ السَّماءِ , فإذا بلغَ الثَّمانينَ أُثبتَتْ حسناتُهُ , ومُحيَتْ سيِّئاتُهُ , فإذا بلغَ تسعينَ غفرَ اللَّهُ ما تقدَّمَ من ذنبِه وما تأخَّرَ , وشفَّعهُ في أهلِ بيتِهِ , وكُتبَ في أهلِ السَّماءِ أسيرَ اللَّهِ في أرضِه","explicit":true,"otherNeedIds":[12],"ref":"الشفاعة للوادعي 220","srcLabel":"بمجموع طرقه صالح للحجية","text":[["إذا بلغَ العبدُ الأربعينَ",1]," ",["خفَّفَ اللهُ تعالى عنه حسابَه , فإذا بلغَ الخمسينَ ليَّنَ اللَّهُ عليهِ الحسابَ , فإذا بلغَ الستِّينَ رزقَه اللَّهُ الإنابةَ إليه , فإذا بلغَ سبعينَ أحبَّهُ أَهلُ السَّماءِ , فإذا بلغَ الثَّمانينَ أُثبتَتْ حسناتُهُ , ومُحيَتْ سيِّئاتُهُ , فإذا بلغَ تسعينَ غفرَ اللَّهُ ما تقدَّمَ من ذنبِه وما تأخَّرَ , وشفَّعهُ في أهلِ بيتِهِ , وكُتبَ في أهلِ السَّماءِ أسيرَ اللَّهِ في أرضِه",2]," ."],"grade":"حسن","narrator":"عثمان بن عفان","muhaddith":"بمجموع طرقه صالح للحجية","takhrij":"أخرجه أبو يعلى كما في ((مجمع الزوائد)) للهيثمي (10/208)، والخطيب في ((المتفق والمفترق)) (1289)، وابن الجوزي في ((الموضوعات)) (1/180) باختلاف يسير","bab":"قيامة › الحساب والقصاص","dorar":"NjXKsFbC"},{"id":"س-08191","fp":"04b436ee142d","stateId":381,"easy":"إذا بلغت أربعين سنة ← يصرف الله عنك الجنون والجذام والبرص","cause":"إذا بَلَغَ المَرْءُ المسلمُ أربعينَ سَنَةً","result":"صَرَفَ اللهُ عنهُ ثلاثَةَ أنواعٍ مِنَ البلاءِ : الجُنُونَ ، والجُذَامَ ، والبَرَصَ ؛ فإذا بَلَغَ خمسينَ خَفَّفَ اللهُ عنهُ ذُنُوبَهُ ، فإذا بَلَغَ سِتِّينَ رَزَقَهُ اللهُ الإِنابَةَ إليهِ ، فإذا بَلَغَ سبعينَ أحبَّتْهُ مَلائِكَةُ السَّماءِ ، فإذا بَلَغَ ثَمانِينَ سَنَةً أُثْبِتَتْ حَسَناتُهُ ، ومُحِيَتْ سَيِّئَاتُهُ ، فإذا بَلَغَ تسعينَ غفرَ اللهُ لهُ ما تَقَدَّمَ من ذنبِهِ وما تَأَخَّرَ","explicit":true,"otherNeedIds":[11],"ref":"الفتح الرباني 11/5362","srcLabel":"الحاكم","text":[["إذا بَلَغَ المَرْءُ المسلمُ أربعينَ سَنَةً",1]," ",["صَرَفَ اللهُ عنهُ ثلاثَةَ أنواعٍ مِنَ البلاءِ : الجُنُونَ ، والجُذَامَ ، والبَرَصَ ؛ فإذا بَلَغَ خمسينَ خَفَّفَ اللهُ عنهُ ذُنُوبَهُ ، فإذا بَلَغَ سِتِّينَ رَزَقَهُ اللهُ الإِنابَةَ إليهِ ، فإذا بَلَغَ سبعينَ أحبَّتْهُ مَلائِكَةُ السَّماءِ ، فإذا بَلَغَ ثَمانِينَ سَنَةً أُثْبِتَتْ حَسَناتُهُ ، ومُحِيَتْ سَيِّئَاتُهُ ، فإذا بَلَغَ تسعينَ غفرَ اللهُ لهُ ما تَقَدَّمَ من ذنبِهِ وما تَأَخَّرَ",2]," ، وسمَّي أَسِيرَ اللهِ في الأرضِ ، وشفعَ لأهلِ بَيتِه"],"grade":"حسن","narrator":"عبدالله بن أبي بكر","muhaddith":"حسن لغيره","takhrij":"أخرجه ابن قانع في ((معجمه)) (2/99)، والحاكم (6023) باختلاف يسير.","bab":"ملائكة › أعمال الملائكة","dorar":"Co2cGaIU"},{"id":"س-02314","fp":"439069d25244","stateId":381,"easy":"إذا طال عمرك في الطاعة (صلاة وصيام) ← قد تسبق الشهيد إلى الجنة","cause":"صلَّى ألْفًا وثَمانمِئةِ صَلاةٍ وصامَ رَمَضانَ","result":"أنَّ الَّذي ماتَ على فِراشِه دَخَلَ الجنَّةَ قَبْلَ الآخَرِ بحينٍ","explicit":true,"star":true,"similar":["س-08431"],"otherNeedIds":[47],"ref":"الأحاديث المختارة 827","srcLabel":"البخاري","text":["«نَزَلَ رَجُلانِ مِن أهْلِ اليَمَنِ على طَلْحةَ بنِ عُبَيْدِ اللهِ، فقُتِلَ أحَدُهما معَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ ثُمَّ مَكَثَ الآخَرُ بَعْدَه سَنَةً، ثُمَّ ماتَ على فِراشِه، فأُرِيَ طَلْحةَ بنَ عُبَيْدِ اللهِ ",["أنَّ الَّذي ماتَ على فِراشِه دَخَلَ الجنَّةَ قَبْلَ الآخَرِ بحينٍ",2],"، فذُكِرَ ذلك لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: كم مَكَثَ بَعْدَه؟ قالَ: حَوْلًا، قالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["صلَّى ألْفًا وثَمانمِئةِ صَلاةٍ وصامَ رَمَضانَ",1],"»."],"grade":"صحيح","narrator":"أبو سلمة بن عبدالرحمن بن عوف","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"nvMQJ2Oc"},{"id":"س-08431","fp":"5d2771cc360a","stateId":381,"easy":"إذا طال عمرك في الطاعة ← تسبق الشهيد بصلاتك وعملك بعده","cause":"صَلاتُه بعْدَ صَلاتِه؟ وأين عَمَلُه بعْدَ عَمَلِه","result":"فلَمَا بَينَهما كما بيْنَ السَّماءِ والأرضِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-02314","otherNeedIds":[47],"ref":"تخريج سير أعلام النبلاء 3/ 505","text":["عن عَبدِ اللهِ بنِ رَبيعةَ السُّلَميِّ -وكان مِن أصحابِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ- عن عُبَيدِ بنِ خالِدٍ السُّلَميِّ أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ آخَى بيْنَ رَجُلَيْنِ، فقُتِلَ أحَدُهما، وماتَ الآخَرُ بَعدَه، فصَلَّيْنا عليه، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ما قُلتُم؟ قالوا: دَعَوْنا له: اللَّهمَّ اغْفِرْ له، اللَّهمَّ ارحَمْه، اللَّهمَّ ألحِقْه بصاحِبِه. فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: فأين ",["صَلاتُه بعْدَ صَلاتِه؟ وأين عَمَلُه بعْدَ عَمَلِه",1],"؟ ",["فلَمَا بَينَهما كما بيْنَ السَّماءِ والأرضِ",2],"."],"grade":"صحيح","narrator":"عبيد بن خالد السلمي","muhaddith":"إسناده صحيح.","takhrij":"أخرجه النسائي (1985) واللفظ له، وأخرجه أبو داود (2524)، وأحمد (16074) باختلاف يسير","bab":"مناقب وفضائل › فضائل جمع من الصحابة والتابعين","dorar":"0HW4AKt1","merged":4,"otherRefs":["تخريج المسند لشعيب 16074 (صحيح)","تخريج مشكل الآثار 2311 (صحيح)","صحيح أبي داود 2524 (صحيح)"]}]}