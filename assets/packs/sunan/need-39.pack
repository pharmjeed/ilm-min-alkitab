{"schema":1,"kind":"sunan-chunk","version":"sunan-d4559cab67b4","needId":39,"stateIds":[389,390],"items":[{"id":"س-08368","fp":"0e66ac3d217a","stateId":389,"easy":"إذا وصلت أهل ودّ أبيك بعد موته ← فهو من أبرّ البر","cause":"صِلةَ الرَّجُلِ أهلَ وُدِّ أبيه بَعدَ أن يولِّيَ","result":"إنَّ مِن أبَرِّ البِرِّ","explicit":true,"star":true,"otherNeedIds":[47],"ref":"صحيح مسلم 2552","srcLabel":"متفق عليه","text":["أنَّه كان إذا خَرَجَ إلى مَكَّةَ كان له حِمارٌ يَتَرَوَّحُ عليه إذا مَلَّ رُكوبَ الرَّاحِلةِ، وعِمامةٌ يَشُدُّ بها رَأسَه، فبينا هو يَومًا على ذلك الحِمارِ إذ مَرَّ به أعرابيٌّ، فقال: ألَستَ ابنَ فُلانِ بنِ فُلانٍ؟ قال: بَلى، فأعطاه الحِمارَ، وقال: اركَبْ هذا، والعِمامةَ، قال: اشدُدْ بها رَأسَكَ، فقال له بَعضُ أصحابِه: غَفَرَ اللهُ لكَ! أعطَيتَ هذا الأعرابيَّ حِمارًا كُنتَ تَرَوَّحُ عليه، وعِمامةً كُنتَ تَشُدُّ بها رَأسَكَ، فقال: إنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["إنَّ مِن أبَرِّ البِرِّ",2]," ",["صِلةَ الرَّجُلِ أهلَ وُدِّ أبيه بَعدَ أن يولِّيَ",1],"، وإنَّ أباه كان صَديقًا لعُمَرَ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"wksmE3Kw","merged":3,"otherRefs":["صحيح مسلم 2552 (صحيح)","تخريج المسند لشعيب 5896 (صحيح)"]},{"id":"س-03840","fp":"70597083aab7","stateId":389,"easy":"إذا أحببت أن تصل أباك في قبره ← فصِل إخوانه بعده","cause":"فلْيصِلْ إخوانَ أبيه بعدَه","result":"مَن أحَبَّ أنْ يصِلَ أباه في قبرِه","explicit":true,"star":true,"ref":"تخريج صحيح ابن حبان 432","srcLabel":"البخاري","text":["قدِمْتُ المدينةَ فأتاني عبدُ اللهِ بنُ عُمرَ فقال: أتدري لمَ أتَيْتُك ؟ قال: قُلْتُ: لا قال: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( ",["مَن أحَبَّ أنْ يصِلَ أباه في قبرِه ",2],["فلْيصِلْ إخوانَ أبيه بعدَه",1]," ) وإنَّه كان بينَ أبي عُمَرَ وبينَ أبيكَ إِخاءٌ ووُدٌّ فأحبَبْتُ أنْ أصِلَ ذاك"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه أبو يعلى (5669)، وابن عساكر في ((تاريخ دمشق)) (26/44)","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"JbwurZxd"},{"id":"س-06809","fp":"39e212af38f3","stateId":389,"easy":"إذا وجدت والدك مملوكاً فاشتريته فأعتقته ← فذلك جزاؤه","cause":"يَـجِدَه مَـمْلوكًا، فيَشتَريَه فيُعْتِقَه","result":"لا يَـجْزي وَلدٌ والِدَه إلَّا","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 7143","srcLabel":"مسلم","text":[["لا يَـجْزي وَلدٌ والِدَه إلَّا",2]," أنْ ",["يَـجِدَه مَـمْلوكًا، فيَشتَريَه فيُعْتِقَه",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (1510) باختلاف يسير","bab":"عتق وولاء › فضل العتق","dorar":"Kr2hH9mc","merged":2,"otherRefs":["تخريج مشكل الآثار 1356 (صحيح)"]},{"id":"س-06111","fp":"69985b256eb8","stateId":389,"easy":"إذا بررت آباءك ← يبرك أبناؤك","cause":"بِرُّوا آباءَكُم","result":"تبرَّكُمْ أبناؤُكُمْ","explicit":true,"ref":"الجامع الصغير 5424","srcLabel":"الحاكم","text":["عِفُّوا عنِ نساءِ الناسِ تعِفَّ نساؤُكم ، و",["بِرُّوا آباءَكُم",1]," ",["تبرَّكُمْ أبناؤُكُمْ",2]," ، ومَنْ أتاهُ أخوهُ مُتَنَصِّلًا فلْيَقْبَلْ ذلِكَ منْهُ ، مُحِقًّا كانَ أوْ مُبْطِلًا ، فإِنْ لم يَفْعَلْ لَمْ يَرِدْ عَلَيَّ الحوْضَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الحاكم في ((مستدركه)) (7258)، والشجري في ((أماليه)) (1982) واللفظ لهما.","bab":"رقائق وزهد › مكارم الأخلاق والعفو عمن ظلم","dorar":"B4Sv4Ht8","merged":2,"otherRefs":["الجامع الصغير 3124 (صحيح)"]},{"id":"س-02039","fp":"68d604fe62f3","stateId":389,"easy":"إذا وصلت صديق أبيك ← فهو من تمام برّه","cause":"أن يَصِلَ الرجلُ صدِيقَ أبيهِ","result":"مِن تمامِ بِرِّ الأبِ","explicit":true,"similar":["س-02175"],"ref":"عارضة الأحوذي 4/307","srcLabel":"عارضة الأحوذي","text":[["مِن تمامِ بِرِّ الأبِ",2]," ",["أن يَصِلَ الرجلُ صدِيقَ أبيهِ",1]],"grade":"صحيح","muhaddith":"صحيح","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"ooYutrGJ"},{"id":"س-02175","fp":"482c26ece2e3","stateId":389,"easy":"إذا وصلت صديق أبيك ← فهو من البر","cause":"أن تَصِلَ صديقَ أبيك","result":"من البِرِّ","explicit":true,"repOf":"س-02039","ref":"صحيح الجامع 5901","text":[["من البِرِّ",2]," ",["أن تَصِلَ صديقَ أبيك",1]],"grade":"صحيح","narrator":"عبدالله بن عمر وأنس بن مالك","muhaddith":"صحيح","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"DGj5U6G6"},{"id":"س-05522","fp":"b74329537f37","stateId":389,"easy":"إذا خرجت تسعى على والديك الكبيرين ← فأنت في سبيل الله","cause":"خَرَجَ يَسعى على أبَوينِ شَيخَينِ كَبيرَينِ","result":"فهو في سَبيلِ اللهِ","explicit":true,"otherNeedIds":[49],"ref":"حسن الأسوة بما ثبت في النسوة 564","srcLabel":"الطبراني","text":["مَرَّ على النَّبيِّ صلَّى اللهُ عليه وسلَّم رَجُلٌ فرَأى أصحابُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم مِن جَلَدِه ونَشاطِه، فقالوا: يا رَسولَ اللهِ، لو كان هذا في سَبيلِ اللهِ! فقال رسولُ اللهِ: إن كان خَرَجَ يَسعى على ولدِه صِغارًا فهو في سَبيل اللهِ، وإن كان ",["خَرَجَ يَسعى على أبَوينِ شَيخَينِ كَبيرَينِ",1]," ",["فهو في سَبيلِ اللهِ",2],"، وإن كان خَرَجَ يَسعى على نَفسِه يُعِفُّها فهو في سَبيلِ اللهِ، وإن كان خَرَجَ يَسعى رياءً ومُفاخَرةً فهو في سَبيلِ الشَّيطانِ"],"grade":"صحيح","narrator":"كعب بن عجرة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((الأوسط)) (6835)، وبحشل في ((تاريخ واسط)) (صـ162) واللفظ لهما.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"yhlIFCs7"},{"id":"س-08305","fp":"181c59ede684","stateId":389,"easy":"إذا كنت باراً بأمك ← تدخل الجنة (من قصة حارثة)","cause":"كانَ أبرَّ النَّاسِ بأمِّه","result":"دخلتُ الجنَّةَ فسمِعتُ قراءةً","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[67],"ref":"الإصابة في تمييز الصحابة 1/298","srcLabel":"النسائي","text":[["دخلتُ الجنَّةَ فسمِعتُ قراءةً",2]," فقلتُ : مَن هذا ؟ فقيل : حارثةُ بنُ النُّعمانِ ، فقال رسولُ اللهِ صلَّى اللهُ عليهِ وآلِه وسلَّمَ : كذلِكمُ البرُّ ، ",["كانَ أبرَّ النَّاسِ بأمِّه",1]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (24080)، والنسائي في ((السنن الكبرى)) (8233) باختلاف يسير","bab":"مناقب وفضائل › بعض من شهد النبي بأنهم من أهل الجنة","dorar":"UggjNVUJ","merged":2,"otherRefs":["السلسلة الصحيحة 913 (صحيح)"]},{"id":"س-01357","fp":"38a542b1c53d","stateId":389,"easy":"إذا بررت والدتك ← فهي أوسط أبواب الجنة","cause":"الوالدةَ","result":"أَوسطُ أبْوابِ الجنَّةِ","explicit":true,"otherNeedIds":[67],"ref":"تخريج المسند لشعيب 21726","srcLabel":"الترمذي","text":["أتى رَجُلٌ أبا الدَّرْداءِ، فقال: إنَّ امرأتي بنتُ عَمِّي وأنا أُحِبُّها، وإنَّ والدتي تَأمُرُني أنْ أُطلِّقَها، فقال: لا آمُرُكَ أنْ تُطلِّقَها، ولا آمُرُكَ أنْ تَعصيَ والدتَكَ، ولكنْ أُحدِّثُكَ حديثًا سَمِعتُه مِن رسولِ اللهِ صَلَّى اللهُ عليه وسلَّمَ، سَمِعتُ رسولَ اللهِ صَلَّى اللهُ عليه وسلَّمَ يقولُ: إنَّ ",["الوالدةَ",1]," ",["أَوسطُ أبْوابِ الجنَّةِ",2],"، فإنْ شِئتَ فأَمسِكْ، وإنْ شِئتَ فدَعْ."],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"حسن","takhrij":"أخرجه الترمذي (1900)، وابن ماجه (3663)، وأحمد (21726) واللفظ له","bab":"نكاح › عشرة النساء","dorar":"CabBd3GP"},{"id":"س-02269","fp":"b202ef234a4b","stateId":389,"easy":"إذا صليت على والديك بعد موتهما واستغفرت لهما وأنفذت عهدهما ← فذلك من برهما","cause":"الصَّلاةُ عليهما، والاستغفارُ لهما، وإنفاذُ عهودِهما مِن بعدِهما، وإكرامُ صديقِهما وصِلةُ رحمِهما الَّتي لا رحِمَ لك إلَّا مِن قِبَلِهما","result":"هل بقي لي بعدَ موتِهما مِن بِرِّهما شيءٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح ابن حبان 418","srcLabel":"أبو داود","text":["أتى رسولَ اللهِ صلَّى اللهُ عليه وسلَّم رجلٌ مِن بني سلِمةَ وأنا عندَه فقال: يا رسولَ اللهِ إنَّ أبويَّ قد هلَكا ف",["هل بقي لي بعدَ موتِهما مِن بِرِّهما شيءٌ",2]," ؟ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( نَعم، ",["الصَّلاةُ عليهما، والاستغفارُ لهما، وإنفاذُ عهودِهما مِن بعدِهما، وإكرامُ صديقِهما وصِلةُ رحمِهما الَّتي لا رحِمَ لك إلَّا مِن قِبَلِهما",1]," ) قال الرَّجلُ: ما أكثَرَ هذا يا رسولَ اللهِ وأطيَبَه! قال: ( فاعمَلْ به )"],"grade":"صحيح","narrator":"أبو أسيد","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (5142)، وابن ماجه (3664)، وأحمد (16059) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"hr1ajIv7","merged":5,"otherRefs":["الأحكام الوسطى 4/ 255 (صحيح)","المستدرك على الصحيحين 7466 (صحيح)","الفتوحات الربانية 4/106 (حسن)","عارضة الأحوذي 4/307 (حسن)"]},{"id":"س-03841","fp":"3b341e9fb9e7","stateId":390,"easy":"إذا قطعتك رحمك فوصلتها ← فأنت الواصل حقاً","cause":"مَن إذا قطَعَتْه رَحمُه وصَلَها","result":"ولكنَّ الواصلَ","explicit":true,"star":true,"otherNeedIds":[47],"ref":"تخريج المسند لشعيب 6817","srcLabel":"البخاري","text":["إنَّ الرَّحمَ مُعلَّقةٌ بالعرشِ، وليس الواصلُ بالمُكافئِ، ",["ولكنَّ الواصلَ",2]," ",["مَن إذا قطَعَتْه رَحمُه وصَلَها",1],"، قال يزيدُ: المواصلَ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه البخاري (5991)، وأبو داود (1697) مختصراً، وأحمد (6817) واللفظ له","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"PsSdLICb","merged":2,"otherRefs":["مختصر العلو 30 (صحيح)"]},{"id":"س-00309","fp":"d58c4330abc0","stateId":390,"easy":"إذا عرفت أنسابك ← تصل أرحامك","cause":"اعرِفوا أنسابَكم","result":"تصِلُوا أرحامَكم","explicit":true,"ref":"المطالب العالية 3/108","srcLabel":"البخاري","text":["كنتُ عندَ ابنِ عبَّاسٍ رضيَ اللهُ عنهُما فأتاهُ رجلٌ فسألَه : مَن أنتَ ؟ فمتَّ لهُ برَحِمٍ بَعيدةٍ ، فألانَ لهُ القَولَ ، وقال : قالَ رَسولُ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ : ",["اعرِفوا أنسابَكم",1]," ",["تصِلُوا أرحامَكم",2]," ، فإنَّهُ لا قُرْبَ للرَّحِمِ إذا قُطِعَتْ وإن كانَت قريبةً ، ولا بُعْدَ لها إذا وُصِلَتْ وإن كانَت بَعيدةً"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الطيالسي (2880) بلفظه، والبخاري في ((الأدب المفرد)) (73)، والحاكم (7283) كلاهما باختلاف يسير.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"XCyzFCwj"},{"id":"س-03114","fp":"75e96e21f98b","stateId":390,"easy":"إذا وصلت رحمك ← يصلك الله","cause":"فمَن يَصِلْها","result":"أصِلْهُ","explicit":true,"similar":["س-03919"],"otherNeedIds":[25,26,41],"ref":"تخريج المسند لشعيب 1659","srcLabel":"أبو داود","text":["عن إبراهيمَ بنِ عَبدِ اللهِ بنِ قارِظٍ، أنَّ أباهُ حدَّثَهُ أنَّهُ دخَلَ على عَبدِ الرَّحمنِ بنِ عَوفٍ وهو مَريضٌ، فقال له عَبدُ الرَّحمنِ: وصَلَتْكَ رَحِمٌ؛ إنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قال: قال اللهُ عَزَّ وجَلَّ: أنا الرَّحمنُ، خلَقتُ الرَّحِمَ، وشقَقتُ لها مِنَ اسْمي، ",["فمَن يَصِلْها",1]," ",["أصِلْهُ",2],"، ومَن يَقطَعْها أقطَعْه، فأبُتَّهُ -أو قال: مَن يَبُتَّها أبُتَّهُ."],"grade":"صحيح","narrator":"عبدالرحمن بن عوف","muhaddith":"صحيح لغيره","takhrij":"أخرجه من طرق أبو داود (1694)، والترمذي (1907)، وأحمد (1659) واللفظ له","bab":"إيمان › توحيد الأسماء والصفات","dorar":"fpqNXsUY","merged":15,"otherRefs":["الجامع الصغير 7323 (حسن)","صحيح البخاري 5988 (صحيح)","صحيح الأدب المفرد 39 (صحيح)","الجامع الصغير 1759 (صحيح)","المستدرك على الصحيحين 7473 (صحيح)","المستدرك على الصحيحين 7478 (صحيح)","صحيح الأدب المفرد 38 (صحيح)","تخريج شرح السنة 3432 (صحيح)","الأحاديث المختارة 2588 (صحيح)","صحيح الترغيب 2531 (حسن)","صحيح الجامع 3548 (صحيح)","الأحاديث المختارة 894 (صحيح)","صحيح الجامع 3549 (صحيح)","تخريج كتاب السنة 536 (صحيح)"]},{"id":"س-03919","fp":"ca79309ea2a3","stateId":390,"easy":"إذا وصلت رحمك ← يصلك الله","cause":"فمَنْ أشارتْ إليه بوَصْلٍ","result":"وَصلَهُ اللهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03114","otherNeedIds":[24],"ref":"المستدرك على الصحيحين 3221","text":["عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهُما: {وَاتَّقُوا اللَّهَ الَّذِي تَسَاءَلُونَ بِهِ وَالْأَرْحَامَ} [النساء: 1] قالَ: إنَّ الرَّحِمَ لتُقطَعُ، وإنَّ النِّعمةَ لتُكفَرُ، وإنَّ اللهَ إذا قارَبَ بيْنَ القُلوبِ لمْ يُزَحْزحْها شيءٌ أبدًا. ثُمَّ قَرَأَ: {لَوْ أَنْفَقْتَ مَا فِي الْأَرْضِ جَمِيعًا مَا أَلَّفْتَ بَيْنَ قُلُوبِهِمْ} [الأنفال: 63]. قالَ: وقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «الرَّحِمُ شُعبةٌ مِنَ الرَّحمنِ، وإنَّها تَجيءُ يومَ القيامةِ تَكلَّمُ بلسانٍ طَليقٍ ذَليقٍ، ",["فمَنْ أشارتْ إليه بوَصْلٍ",1]," ",["وَصلَهُ اللهُ",2],"، ومَنْ أشارتْ إليه بقَطْعٍ قَطَعَهُ اللهُ»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (2953)، والبخاري في ((الأدب المفرد)) (73)، والبيهقي في ((شعب الإيمان)) (7570) بنحوه","bab":"تفسير آيات › سورة النساء","dorar":"z41aGlyP"},{"id":"س-07161","fp":"52d71b1658ce","stateId":390,"easy":"إذا وصلت الرحم وقريت الضيف ووفيت بالذمة ← يكون ذلك في عقبك فلن يذلوا ولن يفتقروا","cause":"كانَ يصلُ الرَّحمَ ويَقري الضَّيفَ ويفي بالذِّمَّةِ","result":"يكونُ ذلكَ في عقبِكَ فلن يُذلُّوا أبدًا ولن يفتقِروا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[1],"ref":"الأجوبة المرضية 2/733","srcLabel":"الحاكم","text":["سلمانُ بنُ عامرٍ الضَّبِّيُّ رضي اللَّه عنه قالَ أتيتُ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ فقلتُ يا رسولَ اللَّهِ إنَّ أبي ",["كانَ يصلُ الرَّحمَ ويَقري الضَّيفَ ويفي بالذِّمَّةِ",1]," قالَ ولم يدركِ الإسلامَ قالَ: لا، فلمَّا ولَّيتُ. قالَ: عليَّ بالشَّيخ قالَ: ",["يكونُ ذلكَ في عقبِكَ فلن يُذلُّوا أبدًا ولن يفتقِروا",2]],"grade":"حسن","narrator":"سلمان بن عامر الضبي","muhaddith":"إسناده رجاله ثقات","takhrij":"أخرجه ابن أبي عاصم في ((الآحاد والمثاني)) (1135) والطبراني (6/ 276) (6213) والحاكم (6560) باختلاف يسير.","bab":"علم › حسن السؤال ونصح العالم","dorar":"1SxY5XwP"}]}