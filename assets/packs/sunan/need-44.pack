{"schema":1,"kind":"sunan-chunk","version":"sunan-d4559cab67b4","needId":44,"stateIds":[406,407,408,409,410,411,412,413,414],"items":[{"id":"س-05594","fp":"0c245ce60c2c","stateId":406,"easy":"إذا ارتفع شيء من الدنيا ← يضعه الله","cause":"ألَّا يرتفعَ شيءٌ مِن هذه القذِرةِ","result":"إلَّا وضَعها اللهُ","explicit":true,"star":true,"ref":"تخريج صحيح ابن حبان 703","srcLabel":"متفق عليه","text":["كانت ناقةُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم العَضْباءُ لا تُسبَقُ كلَّما سابَقوها سبَقَتْ فجاء أعرابيٌّ على قَعودٍ فسابَقها فسبَقها فاشتَدَّ ذلك على أصحابِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم حتَّى رأى ذلك في وجوهِهم فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ( حقٌّ على اللهِ ",["ألَّا يرتفعَ شيءٌ مِن هذه القذِرةِ",1]," ",["إلَّا وضَعها اللهُ",2]," )"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (6501) بلفظ مقارب","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"3kEEsz15","merged":10,"otherRefs":["صحيح النسائي 3590 (صحيح)","صحيح البخاري 6501 (صحيح)","تخريج مشكل الآثار 1902 (صحيح)","تخريج مشكل الآثار 1903 (صحيح)","صحيح البخاري 2872 (صحيح)","صحيح النسائي 3594 (صحيح)","تخريج شرح السنة 2652 (صحيح)","صحيح الجامع 2057 (صحيح)","تخريج المسند لشعيب 13659 (صحيح)"]},{"id":"ق-0263","fp":"a2df5e3a5f63","stateId":406,"easy":"ابتغاء العزة عند الكافرين ← لا ينالها فالعزة لله جميعاً","cause":"ابتغاء العزة عند الكافرين","result":"لا ينالها فالعزة لله جميعاً","explicit":true,"star":true,"ref":"سورة النساء: 139","srcLabel":"القرآن الكريم","quran":{"s":4,"from":139,"to":139,"text":"الَّذِينَ يَتَّخِذُونَ الْكَافِرِينَ أَوْلِيَاءَ مِنْ دُونِ الْمُؤْمِنِينَ أَيَبْتَغُونَ عِنْدَهُمُ الْعِزَّةَ فَإِنَّ الْعِزَّةَ لِلَّهِ جَمِيعًا (139)","hl":[[0,146,1]]}},{"id":"ق-0373","fp":"6a7457331b3e","stateId":406,"easy":"المكر (أكابر المجرمين) ← يمكرون بأنفسهم وصغار عند الله وعذاب شديد","cause":"المكر (أكابر المجرمين)","result":"يمكرون بأنفسهم وصغار عند الله وعذاب شديد","explicit":true,"star":true,"otherNeedIds":[69],"ref":"سورة الأنعام: 123–124","srcLabel":"القرآن الكريم","quran":{"s":6,"from":123,"to":124,"text":"وَكَذَلِكَ جَعَلْنَا فِي كُلِّ قَرْيَةٍ أَكَابِرَ مُجْرِمِيهَا لِيَمْكُرُوا فِيهَا وَمَا يَمْكُرُونَ إِلَّا بِأَنْفُسِهِمْ وَمَا يَشْعُرُونَ (123) وَإِذَا جَاءَتْهُمْ آيَةٌ قَالُوا لَنْ نُؤْمِنَ حَتَّى نُؤْتَى مِثْلَ مَا أُوتِيَ رُسُلُ اللَّهِ اللَّهُ أَعْلَمُ حَيْثُ يَجْعَلُ رِسَالَتَهُ سَيُصِيبُ الَّذِينَ أَجْرَمُوا صَغَارٌ عِنْدَ اللَّهِ وَعَذَابٌ شَدِيدٌ بِمَا كَانُوا يَمْكُرُونَ (124)","hl":[[0,100,1]]}},{"id":"ق-0394","fp":"172ee065800b","stateId":406,"easy":"الكِبْر ← الصَّغار والطرد","cause":"الكِبْر","result":"الصَّغار والطرد","explicit":true,"otherNeedIds":[28],"ref":"سورة الأعراف: 13","srcLabel":"القرآن الكريم","quran":{"s":7,"from":13,"to":13,"text":"قَالَ فَاهْبِطْ مِنْهَا فَمَا يَكُونُ لَكَ أَنْ تَتَكَبَّرَ فِيهَا فَاخْرُجْ إِنَّكَ مِنَ الصَّاغِرِينَ (13)","hl":[[6,103,1]]}},{"id":"ق-0492","fp":"fe8147d66601","stateId":406,"easy":"الإعجاب بالكثرة ← لا تغني شيئاً وضيق الأرض والهزيمة","cause":"الإعجاب بالكثرة","result":"لا تغني شيئاً وضيق الأرض والهزيمة","explicit":true,"ref":"سورة التوبة: 25","srcLabel":"القرآن الكريم","quran":{"s":9,"from":25,"to":25,"text":"لَقَدْ نَصَرَكُمُ اللَّهُ فِي مَوَاطِنَ كَثِيرَةٍ وَيَوْمَ حُنَيْنٍ إِذْ أَعْجَبَتْكُمْ كَثْرَتُكُمْ فَلَمْ تُغْنِ عَنْكُمْ شَيْئًا وَضَاقَتْ عَلَيْكُمُ الْأَرْضُ بِمَا رَحُبَتْ ثُمَّ وَلَّيْتُمْ مُدْبِرِينَ (25)","hl":[[50,207,1]]}},{"id":"ق-0755","fp":"24978f10121e","stateId":406,"easy":"طلب العزّ بغير الله ← يكونون عليهم ضداً","cause":"طلب العزّ بغير الله","result":"يكونون عليهم ضداً","explicit":true,"ref":"سورة مريم: 81–82","srcLabel":"القرآن الكريم","quran":{"s":19,"from":81,"to":82,"text":"وَاتَّخَذُوا مِنْ دُونِ اللَّهِ آلِهَةً لِيَكُونُوا لَهُمْ عِزًّا (81) كَلَّا سَيَكْفُرُونَ بِعِبَادَتِهِمْ وَيَكُونُونَ عَلَيْهِمْ ضِدًّا (82)","hl":[[0,138,1]]}},{"id":"ق-0802","fp":"bf53fb153276","stateId":406,"easy":"الجدال في الله بغير علم والتكبر للإضلال عن سبيله ← خزي في الدنيا وعذاب الحريق يوم القيامة","cause":"الجدال في الله بغير علم والتكبر للإضلال عن سبيله","result":"خزي في الدنيا وعذاب الحريق يوم القيامة","explicit":true,"otherNeedIds":[69],"ref":"سورة الحج: 8–10","srcLabel":"القرآن الكريم","quran":{"s":22,"from":8,"to":10,"text":"وَمِنَ النَّاسِ مَنْ يُجَادِلُ فِي اللَّهِ بِغَيْرِ عِلْمٍ وَلَا هُدًى وَلَا كِتَابٍ مُنِيرٍ (8) ثَانِيَ عِطْفِهِ لِيُضِلَّ عَنْ سَبِيلِ اللَّهِ لَهُ فِي الدُّنْيَا خِزْيٌ وَنُذِيقُهُ يَوْمَ الْقِيَامَةِ عَذَابَ الْحَرِيقِ (9) ذَلِكَ بِمَا قَدَّمَتْ يَدَاكَ وَأَنَّ اللَّهَ لَيْسَ بِظَلَّامٍ لِلْعَبِيدِ (10)","hl":[[0,303,1]]}},{"id":"ق-0805","fp":"b5e78472b6a8","stateId":406,"easy":"ترك السجود والخضوع لله ← حقّ العذاب والهوان بلا مكرم","cause":"ترك السجود والخضوع لله","result":"حقّ العذاب والهوان بلا مكرم","explicit":true,"otherNeedIds":[69],"ref":"سورة الحج: 18","srcLabel":"القرآن الكريم","quran":{"s":22,"from":18,"to":18,"text":"أَلَمْ تَرَ أَنَّ اللَّهَ يَسْجُدُ لَهُ مَنْ فِي السَّمَاوَاتِ وَمَنْ فِي الْأَرْضِ وَالشَّمْسُ وَالْقَمَرُ وَالنُّجُومُ وَالْجِبَالُ وَالشَّجَرُ وَالدَّوَابُّ وَكَثِيرٌ مِنَ النَّاسِ وَكَثِيرٌ حَقَّ عَلَيْهِ الْعَذَابُ وَمَنْ يُهِنِ اللَّهُ فَمَا لَهُ مِنْ مُكْرِمٍ إِنَّ اللَّهَ يَفْعَلُ مَا يَشَاءُ (18)","hl":[[184,266,1]]}},{"id":"ق-1119","fp":"aa5ffcac85da","stateId":406,"easy":"الكِبر في الصدر والجدال في آيات الله ← لا يبلغ مراده","cause":"الكِبر في الصدر والجدال في آيات الله","result":"لا يبلغ مراده","explicit":true,"ref":"سورة غافر: 56","srcLabel":"القرآن الكريم","quran":{"s":40,"from":56,"to":56,"text":"إِنَّ الَّذِينَ يُجَادِلُونَ فِي آيَاتِ اللَّهِ بِغَيْرِ سُلْطَانٍ أَتَاهُمْ إِنْ فِي صُدُورِهِمْ إِلَّا كِبْرٌ مَا هُمْ بِبَالِغِيهِ فَاسْتَعِذْ بِاللَّهِ إِنَّهُ هُوَ السَّمِيعُ الْبَصِيرُ (56)","hl":[[0,133,1]]}},{"id":"ق-1186","fp":"fd8d250ec065","stateId":406,"easy":"اتباع أهواء الذين لا يعلمون ← لا يغنون من الله شيئاً","cause":"اتباع أهواء الذين لا يعلمون","result":"لا يغنون من الله شيئاً","explicit":true,"ref":"سورة الجاثية: 18–19","srcLabel":"القرآن الكريم","quran":{"s":45,"from":18,"to":19,"text":"ثُمَّ جَعَلْنَاكَ عَلَى شَرِيعَةٍ مِنَ الْأَمْرِ فَاتَّبِعْهَا وَلَا تَتَّبِعْ أَهْوَاءَ الَّذِينَ لَا يَعْلَمُونَ (18) إِنَّهُمْ لَنْ يُغْنُوا عَنْكَ مِنَ اللَّهِ شَيْئًا وَإِنَّ الظَّالِمِينَ بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ وَاللَّهُ وَلِيُّ الْمُتَّقِينَ (19)","hl":[[63,171,1]]}},{"id":"س-00399","fp":"43450bae03f1","stateId":406,"easy":"إذا تجبّرت ← يقصمك الله","cause":"ومَن تَجَبَّرَ","result":"قَصَمَه اللهُ","explicit":true,"ref":"الأحكام الوسطى 4/ 145","srcLabel":"البزار","text":["تَمشَّى رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ معَنا وهو صائِمٌ، فجَهَدَه الصَّوْمُ، فحَلَبْنا له ناقةً لنا في قَعْبٍ، وصَبَّيْنا عليه عَسَلًا نُكرِمُ به رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ عنْدَ فِطْرِه، فلمَّا غابَتِ الشَّمْسُ ناوَلْناه القَعْبَ، فلمَّا ذاقَه قالَ بيَدِه كأنَّه يقولُ: \"ما هذا؟\"، قُلْنا: لَبَنًا وعَسَلًا أَرَدْنا نُكرِمُك به، قالَ: \"أَكرَمَك اللهُ بما أَكرَمْتَني\"، أو دَعْوةً هذا مَعْناها، ثُمَّ قالَ: \"مَن اقْتَصَدَ أَغْناه اللهُ، ومَن بَذَّرَ أَفقَرَه اللهُ، ومَن تَواضَعَ رَفَعَه اللهُ، ",["ومَن تَجَبَّرَ",1]," ",["قَصَمَه اللهُ",2],"\"."],"grade":"صحيح","narrator":"طلحة بن عبيد الله","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه البزار (946)، وقوام السنة في ((الترغيب والترهيب)) (638) واللفظ لهما","bab":"آداب عامة › الأخلاق المذمومة","dorar":"oVUBfjRz"},{"id":"س-05700","fp":"2e9553476558","stateId":406,"easy":"إذا تكبرت على الله درجة ← يضعك الله درجة حتى أسفل السافلين","cause":"ومَن يتكبَّرْ على اللهِ درجةً","result":"يضَعْه اللهُ درجةً حتَّى يجعَلَه في أسفلِ السَّافلينَ","explicit":true,"ref":"صحيح ابن حبان 5678","srcLabel":"ابن ماجه","text":["مَن تواضَع للهِ درجةً يرفَعْه اللهُ درجةً حتَّى يجعَلَه في أعلى عِلِّيِّينَ ",["ومَن يتكبَّرْ على اللهِ درجةً ",1],["يضَعْه اللهُ درجةً حتَّى يجعَلَه في أسفلِ السَّافلينَ",2]," ولو أنَّ أحدَكم يعمَلُ في صخرةٍ صمَّاءَ ليس عليه بابٌ ولا كُوَّةٌ لَخرَج ما غيَّبه للناسِ كائنًا ما كان"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن ماجه (4176)، وأحمد (11724)، وأبو يعلى في ((المسند)) (1109) بلفظه.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"snrUPhwM"},{"id":"س-05722","fp":"f4b16a70875a","stateId":406,"easy":"إذا طلبت العزة بغير الإسلام ← يذلك الله","cause":"تَطلُبوا العِزَّ بغيرِه","result":"يُذِلَّكم اللهُ","explicit":true,"otherNeedIds":[43],"ref":"تخريج منهاج القاصدين 239","srcLabel":"البيهقي","text":["عن عمَرَ بنِ الخطَّابِ رضِيَ اللهُ عنه، أنَّه لَمَّا قدِمَ الشامَ عرَضَتْ له مَخاضةٌ، فنزَلَ عن بَعيرِه، ونزَعَ خُفَّيْه وأمسَكَهما، وخاض الماءَ، ومعه بعيرُه، فقال له أبو عُبيدةَ: لقد صنَعْتَ اليومَ صُنعًا عظيمًا عندَ أهلِ الأرضِ، فصكَّ في صدْرِه، وقال: أَوْهُ، لو غيرُك يقولُ هذا يا أبا عُبيدةَ! إنَّكم كنتُم أذلَّ وأحقَرَ الناسِ، فأعَزَّكم اللهُ برسولِه، فمهما ",["تَطلُبوا العِزَّ بغيرِه",1]," ",["يُذِلَّكم اللهُ",2],"."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي الدنيا في ((الزهد)) (117)، وأبو نعيم في ((حلية الأولياء)) (1/47)، والبيهقي في ((شعب الإيمان)) (8196)","bab":"رقائق وزهد › الكبر والتواضع","dorar":"DABuNB7O"},{"id":"س-05691","fp":"d9d4fd16fd84","stateId":406,"easy":"إذا قصصت على الناس فترفعت عليهم ← يضعك الله تحت أقدامهم يوم القيامة","cause":"تَقصَّ فترتفعَ عليهِم في نفسِكَ","result":"فيَضعَكَ اللَّهُ تحتَ أقدامِهِم يومَ القيامةِ بِقَدرِ ذلِكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[69],"ref":"تخريج المسند لشاكر 1/71","srcLabel":"أحمد","text":["عنِ الحَرِثِ بنِ مُعاويةَ الكنديِّ ، أنَّهُ رَكِبَ إلى عمرَ بنِ الخطَّابِ رضيَ اللَّهُ عنهُ يسألُهُ عن ثلاثِ خلالٍ ، قالَ : فقدمَ المدينةَ فسألَهُ عمرُ رضيَ اللَّهُ عنهُ ما أقدمَكَ ؟ قالَ : لِأسألَكَ عن ثلاثِ خلالٍ ، قالَ : وما هنَّ ؟ قالَ : ربَّما كنتُ أَنا والمرأةُ في بناءٍ ضيِّقٍ ، فتَحضرُ الصَّلاةُ ، فإن صلَّيتُ أَنا وَهيَ ، كانت بحذائي ، وإن صلَّت خَلفي ، خرَجت منَ البناءِ ، فقالَ عمرُ : تَسترُ بينَكَ وبينَها بثَوبٍ ، ثمَّ تصلِّي بحذائِكَ إن شئتَ ، وعنِ الرَّكعتينِ بعدَ العَصرِ ، فقالَ : نَهاني عنهما رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّم ، قالَ : وعنِ القصَصِ ، فإنَّهم أَرادوني على القَصَصِ ، فقالَ : ما شئتَ ، كأنَّهُ كرِهَ أن يمنعَهُ ، قالَ : إنَّما أردتُ أن أنتَهيَ إلى قولِكَ ، قالَ : أخشَى عليكَ أن ",["تَقصَّ فترتفعَ عليهِم في نفسِكَ",1]," ، ثمَّ تَقصَّ فترتفعَ ، حتَّى يُخيَّلَ إليكَ أنَّكَ فوقَهُم بمنزلةِ الثُّريَّا ، ",["فيَضعَكَ اللَّهُ تحتَ أقدامِهِم يومَ القيامةِ بِقَدرِ ذلِكَ",2]],"grade":"صحيح","narrator":"عبدالرحمن بن جبير","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (111)، وابن عساكر في ((تاريخ دمشق)) (11/ 480)، والضياء في ((المختارة)) (1/ 204) جميعا بلفظه .","bab":"رقائق وزهد › الكبر والتواضع","dorar":"CwtJ8UAC"},{"id":"س-05735","fp":"64f38eaa9478","stateId":406,"easy":"إذا تكبرت ← يضعك الله (أثر عمر)","cause":"رفع رأسَه","result":"انتكِسْ نَكسكَ اللهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-05747"],"ref":"بيان تلبيس الجهمية 6/68","srcLabel":"بيان تلبيس الجهمية","text":["عن عمرَ قال ما من أحدٍ إلَّا وفي رأسِه حكمةٌ فإنْ ",["رفع رأسَه",1]," قيل له ",["انتكِسْ نَكسكَ اللهُ",2]," وإنْ طأطأ رأسَه قيل له انتعِش نعشَكَ اللهُ"],"grade":"صحيح","muhaddith":"محفوظ","bab":"رقائق وزهد › الكبر والتواضع","dorar":"T3DVREbJ"},{"id":"س-05747","fp":"e22743dcf296","stateId":406,"easy":"إذا تكبرت ← يضعك الله","cause":"ومَن تكَبَّر","result":"وَضَعه اللهُ","explicit":true,"repOf":"س-05735","ref":"فيض القدير 6/ 109","text":["من تواضَع للهِ رفَعَه اللهُ، ",["ومَن تكَبَّر ",1],["وَضَعه اللهُ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((الأوسط)) (7711)، والبيهقي في ((الشعب)) (7794)، وأبو نعيم في ((الحلية)) (8/ 46) بنحوه.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"fmSEO0fC"},{"id":"س-06988","fp":"779ff7b8c7ac","stateId":406,"easy":"إذا ارتفعت (تكبراً) ← يقمعك الله","cause":"وإنِ ارتَفعَ","result":"قَمَعه اللَّهُ","explicit":true,"ref":"مدح التواضع وذم الكبر 9","srcLabel":"مدح التواضع وذم الكبر","text":["\"ما مِن آدَميٍّ إلَّا في رَأسِه حِكمةٌ مُوَكَّلٌ بها مَلَكٌ، فإن تَواضَع رَحِمَه اللهُ ",["وإنِ ارتَفعَ",1]," ",["قَمَعه اللَّهُ",2],"، قال: والكِبرياءُ رِداءُ اللهِ، فمَن نازَعَ اللَّهَ قَمَعَه."],"grade":"حسن","narrator":"أنس","muhaddith":"حسن، غريب، تفرد به علي بن الحسن عن خليد بن دعلج.\nوقد روي عن أنس من وجه آخر","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"zQpOrXLy"},{"id":"س-00457","fp":"7e36f0918e25","stateId":406,"easy":"إذا أسبلت إزارك ووفّرت شعرك (خيلاء) ← نقص ذلك من فضلك (من واقعة)","cause":"تُسبِلُ إزارَكَ، وتوفِّرُ شَعرَكَ","result":"لَولا أنَّ فيكَ اثنَتَينِ كُنتَ أنتَ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"تخريج المسند لشعيب 18899","srcLabel":"أحمد","text":["«",["لَولا أنَّ فيكَ اثنَتَينِ كُنتَ أنتَ",2],"» قال: إنَّ واحِدةً تَكفيني قال: «",["تُسبِلُ إزارَكَ، وتوفِّرُ شَعرَكَ",1],"» قال: لا جَرَمَ واللهِ لا أفعَلُ"],"grade":"حسن","narrator":"خريم رجل من بني أسد","muhaddith":"حسن بطرقه","bab":"آداب عامة › الأخلاق المذمومة","dorar":"AGnV2GN2"},{"id":"س-05009","fp":"7dea1908bd9a","stateId":406,"easy":"إذا تكبرت درجة ← يضعك الله درجة حتى يجعلك في أسفل سافلين","cause":"ومَن تكبَّرَ درَجةً","result":"وضعَهَ اللَّهُ درجةً حتَّى يجعَلهُ في أسفلِ سافلينَ","explicit":true,"ref":"الأمالي المطلقة 89","srcLabel":"ابن حبان","text":["مَن تواضعَ للَّهِ درجةً رفعَهُ اللَّهِ درجةً ",["ومَن تكبَّرَ درَجةً ",1],["وضعَهَ اللَّهُ درجةً حتَّى يجعَلهُ في أسفلِ سافلينَ",2]],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"حسن","takhrij":"أخرجه أبو يعلى (1109)، وابن شاهين في ((الترغيب)) (236) واللفظ لهما، وابن حبان (5678) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"cyaB5u1J"},{"id":"س-05745","fp":"70aab130ffd5","stateId":406,"easy":"إذا أردت أن ترفع نفسك (تكبراً) ← يضعك الله","cause":"أرادَ أن يَرفَعَ نَفْسَه","result":"وَضَعَه اللهُ","explicit":true,"star":true,"ref":"الأحاديث المختارة 11 / 411","srcLabel":"متفق عليه","text":["«ما مِن بَني آدَمَ أحَدٌ إلَّا وفي رَأسِه سِلْسِلتانِ إحْداهما في السَّماءِ السَّابِعةِ والأخرى في الأرْضِ السَّابِعةِ، فإذا تَواضَعَ العَبْدُ رَفَعَه اللهُ بالسِّلسلةِ الَّتي في السَّماءِ، وإذا ",["أرادَ أن يَرفَعَ نَفْسَه",1]," ",["وَضَعَه اللهُ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الكبر والتواضع","dorar":"biQho67W"},{"id":"س-07288","fp":"d969165e83e3","stateId":407,"easy":"إذا خلعت المرأة ثيابها في غير بيت زوجها ← تهتك ما بينها وبين الله","cause":"إنَّ المرأةَ إذا خَلَعَت ثِيابَها في غيرِ بَيتِ زَوجِها هَتَكَت ما بيْنها وبيْن اللهِ عزَّ وجلَّ مِن حِجابٍ، وإنْ تَطيَّبَت لغيرِ زَوجِها","result":"كان عليها نارًا وشَنارًا، فإذا استَحلُّوا الزِّنا وشَرِبوا الخمورَ بعْدَ هذا، وضَرَبوا المعازفَ؛ غار اللهُ في سَمائِه","explicit":true,"star":true,"similar":["س-01762"],"otherNeedIds":[69],"ref":"المستدرك على الصحيحين 8800","srcLabel":"مسلم","text":["دخَلتُ على عائشةَ رَضيَ اللهُ عنها ورجُلٌ معها، فقال الرَّجلُ: يا أُمَّ المُؤمنينَ حَدِّثينا حَديثًا عن الزَّلزلةِ، فأعرَضَتْ عنه بوَجهِها، قال أنسٌ: فقُلتُ لها: حَدِّثينا يا أُمَّ المُؤمنينَ عن الزَّلزلةِ، فقالت: يا أنسُ، إنْ حَدَّثْتُك عنها عِشتَ حَزينًا، وبُعِثتَ حِين تُبعَثُ وذلك الحزنُ في قَلبِكَ، فقُلتُ: يا أُمَّاه، حَدِّثينا، فقالت: ",["إنَّ المرأةَ إذا خَلَعَت ثِيابَها في غيرِ بَيتِ زَوجِها هَتَكَت ما بيْنها وبيْن اللهِ عزَّ وجلَّ مِن حِجابٍ، وإنْ تَطيَّبَت لغيرِ زَوجِها ",1],["كان عليها نارًا وشَنارًا، فإذا استَحلُّوا الزِّنا وشَرِبوا الخمورَ بعْدَ هذا، وضَرَبوا المعازفَ؛ غار اللهُ في سَمائِه",2],"، فقال للأرضِ: تَزَلْزلي بهم، فإنْ تابُوا ونَزَعوا، وإلَّا هَدَمَها عليهم، فقال أنسٌ: عُقوبةً لهم؟ قالت: رَحمةً وبَركةً ومَوعظةً للمؤمنينَ، ونَكالًا وسُخطةً وعذابًا للكافرينَ. قال أنسٌ: فما سَمِعتُ بعْدَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ حَديثًا أنا أشَدُّ به فرَحًا منِّي بهذا الحديثِ، بل أَعِيشُ فَرِحًا، وأُبْعَثُ حِين أُبْعَثُ وذلك الفرحُ في قَلْبي، أو قال: في نفْسي."],"grade":"صحيح","narrator":"عائشة بنت الصديق","muhaddith":"صحيح على شرط مسلم، ولم يخرجاه","takhrij":"أخرجه نعيم بن حماد في ((الفتن)) (1729) باختلاف يسير، وأبو داود (4010)، والترمذي (2803) مقتصرا على جملة منه","bab":"فتن › ظهور الفتن","dorar":"aLEGPdvf"},{"id":"س-05766","fp":"f9e4aab6c103","stateId":407,"easy":"إذا ابتغيت الريبة في الناس ← أفسدتهم","cause":"إذا ابْتَغَى الرِّيبَةَ في النَّاسِ","result":"أفْسَدَهُمْ","explicit":true,"star":true,"ref":"صحيح الجامع 1585","srcLabel":"أبو داود","text":["إنَّ الأَمِيرَ ",["إذا ابْتَغَى الرِّيبَةَ في النَّاسِ",1]," ",["أفْسَدَهُمْ",2]],"grade":"صحيح","narrator":"جبير بن نفير وكثير بن مرة والمقدام بن معد يكرب وأبو أمامة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4889)، وأحمد (23815)، وابن أبي عاصم في ((الآحاد والمثاني)) (2449) واللفظ لهم.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"rH05jUVT","merged":3,"otherRefs":["صحيح الأدب المفرد 186 (صحيح)","فيض القدير 1153 (حسن)"]},{"id":"س-00400","fp":"f6f8fcde5fb8","stateId":407,"easy":"إذا تتبعت عورات الناس ← أفسدتهم أو كدت","cause":"إنِ اتَّبعتَ عَوراتِ النَّاسِ","result":"أفسدتَهُم ، أو كِدتَ تُفْسِدَهم","explicit":true,"star":true,"ref":"الصحيح المسند 1116","srcLabel":"أبو داود","text":["إنَّكَ ",["إنِ اتَّبعتَ عَوراتِ النَّاسِ",1]," ",["أفسدتَهُم ، أو كِدتَ تُفْسِدَهم",2]," فقالَ أبو الدَّرداءِ : كلِمةٌ سمعَها معاويةُ مِن رسولِ اللَّهِ- صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ - نفعَهُ اللَّهُ بِها ."],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4888)، والخرائطي في ((مكارم الأخلاق)) (426)، وابن حبان (3688)، والطبراني (19/ 379) (890) واللفظ لهم.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"AK64kltO"},{"id":"س-02362","fp":"c643f6e2184e","stateId":407,"easy":"إذا طلبت عورة المسلم ← يطلب الله عورتك","cause":"مَنْ يَطْلُبْ عَوْرَةَ المسلمِ","result":"يَطْلُبِ اللهُ عَوْرَتَهُ","explicit":true,"ref":"صحيح الموارد 1248","srcLabel":"الترمذي","text":["يا معشرَ مَنْ أسلمَ بِلسانِهِ ، ولمْ يَدْخُلِ الإِيمانُ قلبَهُ ! لا تُؤْذُوا المسلمينَ ، ولا تُعَيِّرُوهُمْ ، ولا تَطْلُبُوا عَثَرَاتِهمْ ؛ فإنَّهُ ",["مَنْ يَطْلُبْ عَوْرَةَ المسلمِ ؛ ",1],["يَطْلُبِ اللهُ عَوْرَتَهُ ، ",2],"ومَنْ يَطْلُبِ اللهُ عَوْرَتَهُ ؛ يَفْضَحْهُ ولَوْ في جَوْفِ بَيتِه . ونظرَ ابْنُ عمرَ يومًا إلى البيتِ ؛ فقال : ما أَعْظَمَكَ وأَعْظَمَ حُرْمَتَكَ ! ولَلْمُؤْمِنُ أَعْظَمُ عندَ اللهِ حُرْمَةً مِنْكَ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"حسن صحيح","takhrij":"أخرجه الترمذي (2032)، وابن حبان كما في ((موارد الظمآن)) للهيثمي (1494) واللفظ له، والبغوي في ((شرح السنة)) (3526)","bab":"إسلام › حرمة المسلم","dorar":"1vGBUTpK"},{"id":"س-02363","fp":"25aec045a8db","stateId":407,"easy":"إذا طلب الله عورتك ← يفضحك ولو في جوف بيتك","cause":"ومَنْ يَطْلُبِ اللهُ عَوْرَتَهُ","result":"يَفْضَحْهُ ولَوْ في جَوْفِ بَيتِه","explicit":true,"ref":"صحيح الموارد 1248","srcLabel":"الترمذي","text":["يا معشرَ مَنْ أسلمَ بِلسانِهِ ، ولمْ يَدْخُلِ الإِيمانُ قلبَهُ ! لا تُؤْذُوا المسلمينَ ، ولا تُعَيِّرُوهُمْ ، ولا تَطْلُبُوا عَثَرَاتِهمْ ؛ فإنَّهُ مَنْ يَطْلُبْ عَوْرَةَ المسلمِ ؛ يَطْلُبِ اللهُ عَوْرَتَهُ ، ",["ومَنْ يَطْلُبِ اللهُ عَوْرَتَهُ ؛ ",1],["يَفْضَحْهُ ولَوْ في جَوْفِ بَيتِه ",2],". ونظرَ ابْنُ عمرَ يومًا إلى البيتِ ؛ فقال : ما أَعْظَمَكَ وأَعْظَمَ حُرْمَتَكَ ! ولَلْمُؤْمِنُ أَعْظَمُ عندَ اللهِ حُرْمَةً مِنْكَ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"حسن صحيح","takhrij":"أخرجه الترمذي (2032)، وابن حبان كما في ((موارد الظمآن)) للهيثمي (1494) واللفظ له، والبغوي في ((شرح السنة)) (3526)","bab":"إسلام › حرمة المسلم","dorar":"1vGBUTpK"},{"id":"س-02372","fp":"be2b43f352e3","stateId":407,"easy":"إذا تتبعت عورة أخيك ← يتتبع الله عورتك","cause":"من تتبَّع عورةَ أخيه المسلمِ","result":"تتبَّع اللهُ عورتَه","explicit":true,"similar":["س-04945"],"ref":"الترغيب والترهيب 3/241","srcLabel":"الترمذي","text":["صعِد رسولُ اللهِ صلَّى اللهُ عليه وسلَّم المنبرَ فنادَى بصوتٍ رفيعٍ فقال يا معشرَ من أسلم بلسانِه ولم يدخُلِ الإيمانَ قلبَه لا تُؤذوا المسلمين ولا تتَّبِعوا عوراتِهم فإنَّه ",["من تتبَّع عورةَ أخيه المسلمِ ",1],["تتبَّع اللهُ عورتَه ",2],"ومن تتبَّع اللهُ عورتَه يفضَحْه ولو في جوفِ رحلِه ونظر ابنُ عمرَ إلى الكعبةِ فقال ما أعظَمَك وما أعظمَ حُرمتِك والمؤمنُ أعظمُ حُرمةً عند اللهِ منك"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (2032)، وابن حبان (5763)، وأبو الشيخ في ((التوبيخ والتنبيه)) (93) باختلاف يسير.","bab":"إسلام › حرمة المسلم","dorar":"tDf32LYz"},{"id":"س-04877","fp":"525748fa5843","stateId":407,"easy":"إذا عملت ذنباً بالليل فستره الله ثم كشفته ← تكشف ستر الله عليك","cause":"الَّذي يَعملُ العملَ باللَّيلِ فيسترُهُ ربُّهُ ثمَّ يصبِحُ فيقولُ : يا فُلانُ : إنِّي عمِلتُ البارحةَ كذا وَكَذا","result":"فيَكْشِفُ سترَ اللَّهِ عزَّ وجلَّ","explicit":true,"ref":"الجامع الصغير 6261","srcLabel":"الطبراني","text":["كلُّ أمَّتي معافًى إلَّا المجاهرينَ ، ",["الَّذي يَعملُ العملَ باللَّيلِ فيسترُهُ ربُّهُ ثمَّ يصبِحُ فيقولُ : يا فُلانُ : إنِّي عمِلتُ البارحةَ كذا وَكَذا",1]," ",["فيَكْشِفُ سترَ اللَّهِ عزَّ وجلَّ",2]],"grade":"صحيح","narrator":"أبو قتادة","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (4498)، وأبو نعيم في ((تاريخ أصبهان)) (2/25) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"eNiFHHtv"},{"id":"س-04911","fp":"8722db2ff0ab","stateId":407,"easy":"إذا خذلت مسلماً يُنتهك عرضه ← يخذلك الله في موطن تحب فيه نصرته","cause":"ما من امرئٍ يخذلُ امرأً مسلمًا في موطنٍ يُنتَقَصُ فيهِ مِنْ عرضِهِ، ويُنتهكُ فيهِ مِنْ حُرمَتِهِ","result":"إلَّا خَذَلَهُ اللهُ تعالى في موطنٍ يُحبُّ فيهِ نُصرتَهُ","explicit":true,"ref":"الجامع الصغير 7983","srcLabel":"أبو داود","text":[["ما من امرئٍ يخذلُ امرأً مسلمًا في موطنٍ يُنتَقَصُ فيهِ مِنْ عرضِهِ،  ويُنتهكُ فيهِ مِنْ حُرمَتِهِ،",1],"  ",["إلَّا خَذَلَهُ اللهُ تعالى في موطنٍ يُحبُّ فيهِ نُصرتَهُ",2],"،  ومَا منْ أحدٍ ينصرُ مسلمًا في موطنٍ يُنتَقَصُ فيهِ منْ عرضِهِ،  ويُنتَهكُ فيهِ منْ حُرمَتِهِ،  إِلاَّ نَصَرَهُ الله فِي مَوْطِنٍ يُحِبُّ فِيهِ نصرته"],"grade":"صحيح","narrator":"جابر بن عبدالله وأبو طلحة بن سهل","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4884)، وأحمد (16368)، وابن المبارك في ((الزهد)) (696) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"4TsI8DKj"},{"id":"س-04945","fp":"ef294b9c7838","stateId":407,"easy":"إذا تتبعت عورة أخيك ← يتتبع الله عورتك حتى يفضحك في بيتك","cause":"مَن يَتَّبِعْ عَورةَ أخيه","result":"يَتَّبِعِ اللهُ عَورتَه حتى يَفضَحَه في بَيتِه","explicit":true,"repOf":"س-02372","ref":"تخريج المسند لشعيب 19801","text":["نادى رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ حتى أسمَعَ العَواتقَ، فقال: يا مَعشَرَ مَن آمَنَ بلِسانِه، ولم يَدخُلِ الإيمانُ قَلبَه، لا تَغتابوا المُسلِمينَ، ولا تَتَّبِعوا عَوْراتِهم؛ فإنَّه ",["مَن يَتَّبِعْ عَورةَ أخيه",1]," ",["يَتَّبِعِ اللهُ عَورتَه حتى يَفضَحَه في بَيتِه",2],"."],"grade":"صحيح","narrator":"أبو برزة الأسلمي نضلة بن عبيد","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (4880)، وأحمد (19801) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"lcGCxMQE"},{"id":"س-07869","fp":"1c9c27000bc4","stateId":407,"easy":"إذا انتفيت من ولدك لتفضحه ← يفضحك الله يوم القيامة على رؤوس الأشهاد","cause":"من انتفَى من ولدِه ليفضحَه في الدنيا","result":"فضحه اللهُ تباركَ وتعالَى يومَ القيامةِ على رؤوسِ الأشهادِ قَصاصٌ بقصاصٍ","explicit":true,"otherNeedIds":[69],"ref":"مجمع الزوائد 5/18","srcLabel":"أحمد","text":[["من انتفَى من ولدِه ليفضحَه في الدنيا ",1],["فضحه اللهُ تباركَ وتعالَى يومَ القيامةِ على رؤوسِ الأشهادِ قَصاصٌ بقصاصٍ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"رجاله رجال الصحيح خلا عبد الله بن أحمد وهو ثقة إمام","takhrij":"أخرجه أحمد (4795)، والطبراني (12/400) (13478) واللفظ له، وأبو نعيم في ((حلية الأولياء)) (9/224).","bab":"قيامة › الحساب والقصاص","dorar":"cKuJdbC1"},{"id":"س-00567","fp":"dbfad151c7e3","stateId":407,"easy":"إذا عملت ولو في صخرة صماء ← يُخرج الله عملك للناس كائناً ما كان","cause":"لو أنَّ أحدَكم يعمَلُ في صخرةٍ صمَّاءَ ليس لها بابٌ ولا كَوَّةٌ","result":"يخرُجُ عملُه للنَّاسِ كائنًا ما كان","explicit":true,"otherNeedIds":[41],"ref":"مجمع الزوائد 10/228","srcLabel":"أحمد","text":[["لو أنَّ أحدَكم يعمَلُ في صخرةٍ صمَّاءَ ليس لها بابٌ ولا كَوَّةٌ",1]," ",["يخرُجُ عملُه للنَّاسِ كائنًا ما كان",2]],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (11230/ 1)  واللفظ له، وابن حبان (4601) باختلاف يسير وزياد في أوله، والحاكم (7877) بنحوه.","bab":"آداب عامة › ضرب الأمثال","dorar":"WfttGuSe"},{"id":"س-00616","fp":"ac315f6b28d2","stateId":407,"easy":"إذا عملت في خفاء ← يُخرج الله عملك للناس","cause":"لوْ أنَّ أحدَكُمْ عَمِلَ في صخرةٍ صماءَ لا بابَ لها ولا كوَّةَ","result":"لأخرجَ اللهُ عملَهُ كائنًا ما كانَ","explicit":true,"otherNeedIds":[41],"ref":"إتقان ما يحسن 2/557","srcLabel":"إتقان ما يحسن","text":[["لوْ أنَّ أحدَكُمْ عَمِلَ في صخرةٍ صماءَ لا بابَ لها ولا كوَّةَ",1]," ",["لأخرجَ اللهُ عملَهُ كائنًا ما كانَ",2]],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"إسناده حسن","bab":"آداب عامة › ضرب الأمثال","dorar":"uYDMTnND"},{"id":"س-01762","fp":"dbb2208ab242","stateId":407,"easy":"إذا وضعت المرأة ثيابها في غير بيتها ← هتكت الستر بينها وبين الرحمن","cause":"ما منَ امرَأةٍ تضعُ ثيابَها في غيرِ بيتِ أحَدٍ من أمَّهاتِها","result":"إلَّا وَهيَ هاتِكَةٌ كلَّ سترٍ بينَها وبينَ الرَّحمنِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-07288","ref":"آداب الزفاف 68","text":["خرَجتُ منَ الحمَّامِ فلقِيَني رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ فقالَ مِن أينَ يا أمَّ الدَّرداءِ ؟ قالَت : منَ الحمَّامِ فقالَ والَّذي نَفسي بيدِهِ ",["ما منَ امرَأةٍ تضعُ ثيابَها في غيرِ بيتِ أحَدٍ من أمَّهاتِها",1]," ",["إلَّا وَهيَ هاتِكَةٌ كلَّ سترٍ بينَها وبينَ الرَّحمنِ",2]],"grade":"صحيح","narrator":"خيرة بنت أبي حدرد أم الدرداء الكبرى","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (27038)، والطبراني (4/ 253) (646)، و الطبري في ((المنتخب)) (116) جميعهم باختلاف يسير .","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"63XB5LD3"},{"id":"س-04931","fp":"d45e35a5288d","stateId":407,"easy":"إذا طلبت عورة أخيك ← يطلب الله عورتك حتى يفضحك في بيتك","cause":"مَن طلَبَ عَورةَ أخيه المُسلِمِ","result":"طلَبَ اللهُ عَورتَه حتى يَفضَحَه في بَيتِه","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 22402","srcLabel":"أحمد","text":["لا تُؤذوا عِبادَ اللهِ، ولا تُعيِّروهم، ولا تَطلُبوا عَوْراتِهم؛ فإنَّه ",["مَن طلَبَ عَورةَ أخيه المُسلِمِ، ",1],["طلَبَ اللهُ عَورتَه حتى يَفضَحَه في بَيتِه",2],"."],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (22402)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"HRkIKnYD","merged":2,"otherRefs":["صحيح ابن ماجه 2079 (صحيح)"]},{"id":"س-04933","fp":"b9f8b8a388fd","stateId":407,"easy":"إذا وضعت المرأة ثيابها في غير بيتها ← هتكت ستراً بينها وبين الله","cause":"ما مِنِ امرأةٍ وضَعَتْ ثيابَها في غَيرِ بَيتِها","result":"هتَكَتْ سِترًا بَينَها وبَينَ اللهِ","explicit":true,"otherNeedIds":[13,28],"ref":"تخريج المسند لشعيب 25408","srcLabel":"أبو داود","text":["عن أبي المَليحِ عن عائِشةَ قالت: سمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ.. فذكَرَ معناهُ [أيْ معنى حَديثِ: دخَلَ نِسوةٌ مِن أهلِ الشَّامِ على عائِشةَ، فقالت: أنْتُنَّ اللَّاتي تَدخُلْنَ الحَمَّاماتِ؟ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["ما مِنِ امرأةٍ وضَعَتْ ثيابَها في غَيرِ بَيتِها",1],"، إلَّا ",["هتَكَتْ سِترًا بَينَها وبَينَ اللهِ",2]," عزَّ وجلَّ. قال حَجَّاجٌ: إلَّا هتَكَتْ سِترَها.]"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4010)، والترمذي (2803)، وابن ماجه (3750)، وأحمد (25408) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"2Pz8mxXh","merged":8,"otherRefs":["تخريج المسند لشعيب 25627 (صحيح)","تخريج المسند لشعيب 26304 (صحيح)","الزواجر عن اقتراف الكبائر 1/129 (صحيح)","الأحكام الوسطى 1/ 244 (صحيح)","تخريج شرح السنة 3210 (صحيح)","صحيح الجامع 2708 (صحيح)","الرد المفحم 73 (صحيح)"]},{"id":"س-04059","fp":"7607bd7174ae","stateId":407,"easy":"إذا تتبعت عورة أخيك ← يهتك الله سترك ويفضحك ولو في بيتك","cause":"مَن تتَبَّع عَورةَ أخيه المسلِمِ","result":"هَتَك اللهُ سِتْرَه، ومَن يَتَّبِعْ عَوْرَتَه يَفضَحْه ولو في جَوفِ بَيْتِه","explicit":true,"ref":"مجمع الزوائد 8/97","srcLabel":"الطبراني","text":["خَطَب رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم خُطبةً حتى أسمَعَ العواتِقَ في خُدورِهنَّ، فقال: يا مَعْشَرَ مَن آمَنَ بلِسانِه ولم يَدخُلِ الإيمانُ قَلْبَه، لا تُؤذُوا المؤمِنينَ، ولا تَتَّبِعوا عَوْراتِهم؛ فإنَّه ",["مَن تتَبَّع عَورةَ أخيه المسلِمِ ",1],["هَتَك اللهُ سِتْرَه، ومَن يَتَّبِعْ عَوْرَتَه يَفضَحْه ولو في جَوفِ بَيْتِه",2],"."],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني في ((الأوسط)) (3778) باختلاف يسير، والعقيلي في ((الضعفاء الكبير)) (362)، وأبو الشيخ في ((التوبيخ والتنبيه)) (94) بنحوه.","bab":"جمعة › خطبة النبي صلى الله عليه وسلم","dorar":"qN5EHBWi"},{"id":"س-01664","fp":"48cce8ea42ca","stateId":408,"easy":"إذا تزينت بما ليس فيك ← يشينك الله","cause":"ومن تزيَّنَ بما ليس في نفسِه","result":"شانَه اللهُ عزَّ وجلَّ","explicit":true,"ref":"منهاج السنة 6/71","srcLabel":"البيهقي","text":["كتب عمرُ بنُ الخطابِ رضي اللهُ عنه إلى أبي موسى الأشعريِّ : أما بعدُ فإنَّ القضاءَ فريضةٌ محكمةٌ ، وسُنَّةٌ مُتَّبعةٌ ، فافْهم إذا أُدلَى إليك ، فإنه لا ينفع تكلُّمٌ بحقٍّ لا نفاذَ له ، آسِ بين الناسِ في مجلسِك ووجهِك وقضائِك ، حتى لا يطمع شريفٌ في حَيْفِك ، ولا ييأسُ ضعيفٌ من عدلِك . البيِّنةُ على من ادَّعى ، واليمينُ على من أنكر ، والصلحُ جائزٌ بين المسلمين ، إلا صلحًا أحلَّ حرامًا ، أو حرَّم حلالًا . ومن ادَّعى حقًّا غائبًا فامدُدْ له أمدًا ينتهي إليه ، فإن جاء ببينةٍ فأَعطِه حقَّه ، وإن أعجزَه ذلك استحللتَ عليه القضيةَ ، فإنَّ ذلك هو أبلغُ في العُذرِ ، وأجلى للعَمى ، ولا يمنعك قضاءٌ قضيتَه اليومَ فراجعتَ فيه رأيَك فهُديت فيه لرُشدِك أن تراجعَ الحقَّ ، فإنَّ الحقَّ قديمٌ ، وليس يُبطلُه شيءٌ ، ومراجعةُ الحقِّ خيرٌ من التَّمادي في الباطل . والمسلمون عدولٌ بعضُهم على بعضٍ ، إلا مُجرَّبًا عليه شهادةَ زورٍ ، أو مجلودًا في حدٍّ ، أو ظنينًا في ولاءٍ أو نسبٍ ؛ فإنَّ اللهَ تولَّى من العبادِ السرائرَ ، وستر عليهم الحدودَ إلا بالبينات والأيمانِ . ثم الفهمَ الفهمَ فيما أُدليَ إليك وفيما ورد عليك ، مما ليس في قرآنٍ ولا سُنَّةٍ ، ثم قايِسِ الأمورَ عند ذلك ، ثم اعرف الأمثالَ ، ثم اعمد فيما ترى إلى أحبِّها إلى اللهِ وأشبهِها بالحقِّ . وإياك والغضبَ والقلقَ والضجرَ والتأذِّي بالخصومِ ؛ فإنَّ القضاءَ في مواطنِ الحقِّ مما يوجب اللهُ به الأجرَ ، ويحسنُ به الذَّخرُ ، فمن خلصَتْ نيَّتَه في الحقِّ ، ولو على نفسه ، كفاه اللهُ ما بينه وبين الناسِ ، ",["ومن تزيَّنَ بما ليس في نفسِه",1]," ",["شانَه اللهُ عزَّ وجلَّ",2]," ؛ فإنَّ اللهَ عزَّ وجلَّ لا يقبلُ من العبدِ إلا ما كان له خالصًا ، فما ظنُّك بثوابٍ عند اللهِ في عاجلِ رزقِه وخزائنِ رحمتِه"],"grade":"صحيح","narrator":"جعفر بن برقان","muhaddith":"إسناده ثابت","takhrij":"أخرجه البيهقي (20567)، والدارقطني (4471) باختلاف يسير.","bab":"أقضية وأحكام › الاجتهاد في الحكم","dorar":"eQyJvIYr"},{"id":"س-05740","fp":"518f9bbe4053","stateId":408,"easy":"إذا لبست ثوب شهرة ← يلبسك الله يوم القيامة ثوباً مثله (ذلاً)","cause":"مَن لَبِسَ ثَوْبَ شُهْرةٍ","result":"أَلبَسَه اللهُ عَزَّ وجَلَّ يَوْم القِيامةِ ثَوْبًا مِثلَه","explicit":true,"otherNeedIds":[69],"ref":"الأحكام الوسطى 4/ 180","srcLabel":"الأحكام الوسطى","text":["[\"",["مَن لَبِسَ ثَوْبَ شُهْرةٍ ",1],["أَلبَسَه اللهُ عَزَّ وجَلَّ يَوْم القِيامةِ ثَوْبًا مِثلَه\"",2],"]. وفي طَريقٍ أخرى \"ثُمَّ تَلَهَّبُ فيه النَّارُ\"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","bab":"رقائق وزهد › الكبر والتواضع","dorar":"J3SJv5Du"},{"id":"س-03072","fp":"dac6cd13f377","stateId":408,"easy":"إذا راءيت ← يرائي الله بك","cause":"ومَنْ راءَى","result":"راءَى اللهُ بهِ","explicit":true,"star":true,"otherNeedIds":[69,52],"ref":"صحيح الجامع 6304","srcLabel":"متفق عليه","text":["مَنْ سمَّعَ ، سمَّعَ اللهُ بهِ ، ",["ومَنْ راءَى ، ",1],["راءَى اللهُ بهِ ، ",2],"ومَنْ شاقَّ ، شقَّ اللهُ عليه يومَ القيامةِ"],"grade":"صحيح","narrator":"جندب بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6499)، ومسلم (2987) دون قوله:\" ومن شاق...\"، والطبراني (1682) (2/ 166) دون قوله:\" ومن راءى...\".","bab":"إيمان › الوعيد","dorar":"UkeZb2fv","merged":4,"otherRefs":["تخريج صحيح ابن حبان 406 (صحيح)","صحيح الترغيب 27 (صحيح)","مختصر المقاصد 1039 (صحيح)"]},{"id":"س-05508","fp":"40b23ae8b89d","stateId":408,"easy":"إذا سمّعت ← يسمّع الله بك يوم القيامة","cause":"مَن سَمَّعَ","result":"سَمَّعَ اللهُ به يَومَ القيامةِ","explicit":true,"otherNeedIds":[69,52],"ref":"صحيح البخاري 7152","srcLabel":"البيهقي","text":["شَهِدتُ صَفوانَ وجُندَبًا وأصحابَه وهو يوصيهم، فقالوا: هل سَمِعتَ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم شيئًا؟ قال: سَمِعتُه يقولُ: ",["مَن سَمَّعَ",1]," ",["سَمَّعَ اللهُ به يَومَ القيامةِ",2],"، قال: ومَن يُشاقِقْ يَشقُقِ اللهُ عليه يَومَ القيامةِ، فقالوا: أوصِنا، فقال: إنَّ أوَّلَ ما يُنتِنُ مِنَ الإنسانِ بَطنُه، فمَنِ استَطاعَ أن لا يَأكُلَ إلَّا طَيِّبًا فليَفعَلْ، ومَنِ استَطاعَ أن لا يُحالَ بينَه وبينَ الجَنَّةِ بمِلءِ كَفِّه مِن دَمٍ أهراقَه فليَفعَلْ."],"grade":"صحيح","narrator":"جندب بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (5369)، وابن الحداد في ((جامع الصحيحين)) (2227)، والبغوي في ((معجم الصحابة)) (362) واللفظ لهم.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"kVcAd8Nq","merged":7,"otherRefs":["صحيح الجامع 6304 (صحيح)","تخريج صحيح ابن حبان 406 (صحيح)","صحيح الترغيب 27 (صحيح)","مختصر المقاصد 1039 (صحيح)","هداية الرواة 3/289 (حسن)","بلوغ المرام 312 (صحيح)"]},{"id":"س-03016","fp":"34bfa1cb4930","stateId":408,"easy":"إذا سمّعت الناس بعملك ← يسمّع الله بك ويحقرك","cause":"مَن سمَّعَ النَّاسَ بعملِه","result":"سمَّعَ اللهُ به سامِعَ خلْقِه يومَ القيامةِ، فحقَّرَه وصغَّرَه","explicit":true,"otherNeedIds":[69],"ref":"تخريج المسند لشعيب 6986","srcLabel":"أحمد","text":["عن عَمرِو بنِ مُرَّةَ قال: كنَّا جُلوسًا عندَ أبي عُبَيدةَ، فذكَروا الرِّياءَ، فقال رَجُلٌ يُكنَى بأبي يَزيدَ: سمِعْتُ عبدَ اللهِ بنَ عَمرٍو يقولُ: قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["مَن سمَّعَ النَّاسَ بعملِه؛ ",1],["سمَّعَ اللهُ به سامِعَ خلْقِه يومَ القيامةِ، فحقَّرَه وصغَّرَه",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (6986) واللفظ له، وابن أبي شيبة (36448، والطبراني (13/556) (14449)","bab":"إيمان › الوعيد","dorar":"Cr4GEG3F","merged":5,"otherRefs":["السلسلة الصحيحة 2566 (صحيح)","هداية الرواة 5249 (صحيح)","تخريج المسند لشاكر 12/39 (صحيح)","تخريج المسند لشعيب 6839 (صحيح)"]},{"id":"س-02927","fp":"5ede825c66b9","stateId":408,"easy":"إذا لبست ثوب شهرة في الدنيا ← يلبسك الله ثوب مذلة يوم القيامة","cause":"من لبس ثوبَ شهرةٍ في الدنيا","result":"ألبَسَهُ اللهُ ثوبَ مَذَلَّةٍ يومَ القيامةِ","explicit":true,"otherNeedIds":[69],"ref":"تخريج المسند لشاكر 8/43","srcLabel":"أبو داود","text":[["من لبس ثوبَ شهرةٍ في الدنيا ",1],["ألبَسَهُ اللهُ ثوبَ مَذَلَّةٍ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4029)، والنسائي في ((السنن الكبرى)) (9560)، وابن ماجه (3607)، وأحمد (5664) واللفظ له","bab":"إيمان › الوعيد","dorar":"bCxigF1f","merged":3,"otherRefs":["صحيح الترغيب 2089 (حسن)"]},{"id":"س-05483","fp":"9d78686573b6","stateId":408,"easy":"إذا قمت مقام رياء وسمعة ← يرائي الله بك يوم القيامة","cause":"مَن قام مَقامَ رِياءٍ وسُمعةٍ","result":"راءَى اللهُ به يومَ القيامةِ وسَمَّعَ","explicit":true,"similar":["س-05515"],"otherNeedIds":[69],"ref":"تخريج المسند لشعيب 22000","srcLabel":"الطبراني","text":["أنَّه سَمِعَ رسولَ اللهِ صَلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن قام مَقامَ رِياءٍ وسُمعةٍ، ",1],["راءَى اللهُ به يومَ القيامةِ وسَمَّعَ",2],"."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن أبي عاصم في ((الزهد)) (212)، والبزار (2657)، والطبراني (20/119) (237)، وفي ((مسند الشاميين)) (1031).","bab":"رقائق وزهد › الرياء والسمعة","dorar":"1rqq2uqQ","merged":2,"otherRefs":["إتحاف الخيرة المهرة 7/451 (حسن)"]},{"id":"س-05481","fp":"5dc7e9ece455","stateId":408,"easy":"إذا قمت مقام سمعة ورياء ← يسمّع الله بك على رؤوس الخلائق","cause":"ما من عبدٍ يقومُ في الدنيا مقامَ سُمعةٍ ورياءٍ","result":"إلا سمَّع اللهُ به على رؤوسِ الخلائقِ يومَ القيامةِ","explicit":true,"otherNeedIds":[69],"ref":"صحيح الترغيب 28","srcLabel":"الطبراني","text":[["ما من عبدٍ يقومُ في الدنيا مقامَ سُمعةٍ ورياءٍ ؛",1]," ",["إلا سمَّع اللهُ به على رؤوسِ الخلائقِ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن أبي عاصم في ((الزهد)) (212) باختلاف يسير، والبزار (2657)، والطبراني (20/119) (237) واللفظ لهما.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"qO3fxCiu"},{"id":"س-05496","fp":"3fdd041dfbe1","stateId":408,"easy":"إذا أقمت مسلماً مقام سمعة ← يقيمك الله يوم القيامة مقام سمعة ورياء","cause":"ومَن أقامَ بمُسلِمٍ مُقامَ سُمْعةٍ","result":"أقامَهُ اللهُ يومَ القِيامةِ مُقامَ سُمعةٍ ورِياءٍ","explicit":true,"otherNeedIds":[69],"ref":"المستدرك على الصحيحين 7362","srcLabel":"الحاكم","text":["مَن أكَلَ بمُسْلِمٍ أكلَةً، أطعَمَهُ اللهُ بها أكْلَةً مِن نارِ جهَنَّمَ يومَ القيامةِ، ",["ومَن أقامَ بمُسلِمٍ مُقامَ سُمْعةٍ، ",1],["أقامَهُ اللهُ يومَ القِيامةِ مُقامَ سُمعةٍ ورِياءٍ، ",2],"ومَنِ اكتسى بمُسلِمٍ ثَوبًا كَساهُ اللهُ ثوبًا مِن نارٍ يومَ القِيامةِ."],"grade":"صحيح","narrator":"المستورد بن شداد","muhaddith":"صحيح الإسناد","bab":"رقائق وزهد › الرياء والسمعة","dorar":"9Kg2tmyU"},{"id":"س-05515","fp":"3085b3c257bd","stateId":408,"easy":"إذا قمت بأخيك مقام رياء وسمعة ← يقيمك الله يوم القيامة ويسمّع بك","cause":"مَن قام بأخيه مقامَ رياءٍ وسُمعةٍ","result":"أقامَه اللهُ عزَّ وجلَّ يومَ القيامةِ وسمَّع به","explicit":true,"repOf":"س-05483","otherNeedIds":[69],"ref":"مجمع الزوائد 8/99","text":[["مَن قام بأخيه مقامَ رياءٍ وسُمعةٍ ",1],["أقامَه اللهُ عزَّ وجلَّ يومَ القيامةِ وسمَّع به",2]],"grade":"صحيح","narrator":"أبو هند الداري","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (22322)، والدارمي (2748)، والحارث في ((المسند)) (1096) باختلاف يسير.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"mwv7UtYc"},{"id":"س-06984","fp":"5e672ea0a0b3","stateId":409,"easy":"إذا أهنت قريشاً ← يهينك الله","cause":"مَن أهانَ قُرَيشًا","result":"أهانَه اللهُ","explicit":true,"star":true,"similar":["س-00246"],"ref":"الأحاديث المختارة 379","srcLabel":"البخاري","text":["«أي بُنيَّ، إن وَلِيْتَ مِن أمْرِ النَّاسِ شَيئًا فأَكْرِمْ قُرَيشًا؛ فإنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: ",["مَن أهانَ قُرَيشًا ",1],["أهانَه اللهُ»",2],"."],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"GG4jsTdm","merged":4,"otherRefs":["الجامع الصغير 8524 (صحيح)","الأحاديث المختارة 1045 (صحيح)","الأحاديث المختارة 1029 (صحيح)"]},{"id":"س-00246","fp":"b031fe9c398c","stateId":409,"easy":"إذا أهنت (من أكرمه الله) ← يهينك الله","cause":"ومَن أهانَه","result":"أهانه اللهُ","explicit":true,"repOf":"س-06984","ref":"الجامع الصغير 4799","text":["السلطانُ ظِلُّ الله في الأرض، فمَن أكرَمَه أكرمَه اللهُ، ",["ومَن أهانَه ",1],["أهانه اللهُ",2],"."],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (1024 )، والبيهقي في ((شعب الإيمان)) (6988 )","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"6Ydpj3KX"},{"id":"س-03062","fp":"b3f56c56fe6c","stateId":409,"easy":"إذا مشيت إلى سلطان الله لتذله ← يذلك الله قبل يوم القيامة","cause":"ما من قومٍ مشَوا إلى سلطانِ اللهِ ليذلُّوه","result":"إلا أذلَّهم اللهُ قبلَ يومِ القيامةِ","explicit":true,"ref":"مجمع الزوائد 5/219","srcLabel":"البزار","text":[["ما من قومٍ مشَوا إلى سلطانِ اللهِ ليذلُّوه",1]," ",["إلا أذلَّهم اللهُ قبلَ يومِ القيامةِ",2]],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"رجاله رجال الصحيح خلا كثير بن أبي كثير التيمي وهو ثقة","takhrij":"أخرجه البزار (2848) بلفظه، والمحاملي في ((الأمالي)) (327) باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"KiXr75LM"},{"id":"س-05200","fp":"91ed05c10f96","stateId":409,"easy":"إذا أهنت سلطان الله في الأرض ← يهينك الله","cause":"مَن أَهانَ سلطانَ اللَّهِ في الأرضِ","result":"أَهانَهُ اللَّهُ","explicit":true,"ref":"صحيح الترمذي 2224","srcLabel":"الترمذي","text":[["مَن أَهانَ سلطانَ اللَّهِ في الأرضِ ",1],["أَهانَهُ اللَّهُ",2]],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2224) واللفظ له، وأحمد (20433) مطولاً","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"CVSYbkhg"},{"id":"س-02942","fp":"6add2b103dd0","stateId":409,"easy":"إذا سعيت بمؤمن (وشيت به) ← يقيمك الله مقام ذل وخزي يوم القيامة","cause":"ومَنْ سَعَى بمؤمنٍ","result":"أقامَهُ اللهُ مقامَ ذلٍّ وخزيٍ يومَ القيامَةِ","explicit":true,"otherNeedIds":[70],"ref":"الجامع الصغير 8695","srcLabel":"البيهقي","text":["مَنْ رَوَّعَ مؤمنًا، لمْ يَؤمِّنِ اللهُ رَوْعَتَهُ يومَ القيامةِ، ",["ومَنْ سَعَى بمؤمنٍ، ",1],["أقامَهُ اللهُ مقامَ ذلٍّ وخزيٍ يومَ القيامَةِ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (11117) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (6/ 322)، وأبو طاهر المخلص في ((المخلصيات)) (2434)، بنحوه.","bab":"إيمان › الوعيد","dorar":"aZur3Nkt"},{"id":"س-02948","fp":"5ddb87700e96","stateId":409,"easy":"إذا أُذل عندك مؤمن ولم تنصره وأنت قادر ← يذلك الله على رؤوس الأشهاد","cause":"من أُذِلَّ عندَه مؤمنٌ فلمْ ينصرْهُ، و هو يقدرُ على أن ينصرَهُ","result":"أذلَّه اللهُ على رؤوسِ الأشهادِ يومَ القيامةِ","explicit":true,"otherNeedIds":[70],"ref":"الجامع الصغير 8356","srcLabel":"أحمد","text":[["من أُذِلَّ عندَه مؤمنٌ فلمْ ينصرْهُ،  و هو يقدرُ على أن ينصرَهُ",1],"،  ",["أذلَّه اللهُ على رؤوسِ الأشهادِ يومَ القيامةِ",2]],"grade":"حسن","narrator":"سهل بن حنيف","muhaddith":"حسن","takhrij":"أخرجه أحمد (15985)، والطبراني (6/73) (5554)، وابن السني في ((عمل اليوم والليلة)) (428) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"B5yZqVnN"},{"id":"س-03778","fp":"88e45f72f922","stateId":409,"easy":"إذا اغتيب أخوك عندك فلم تنصره وأنت تستطيع ← يذلك الله في الدنيا والآخرة","cause":"مَنِ اغْتِيبَ عندَهُ أخوهُ المسلمُ، فلمْ يَنْصُرْهُ و هوَ يستطيعُ نصرَهُ","result":"أذلَّهُ اللهُ تعالَى في الدُّنيَا و الآخرةِ","explicit":true,"otherNeedIds":[69],"ref":"الجامع الصغير 8470","srcLabel":"معمر","text":[["مَنِ اغْتِيبَ عندَهُ أخوهُ المسلمُ،  فلمْ يَنْصُرْهُ و هوَ يستطيعُ نصرَهُ",1],"،  ",["أذلَّهُ اللهُ تعالَى في الدُّنيَا و الآخرةِ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"أخرجه معمر في (()) (20258)، والحارث بن أبي أسامة كما في ((بغية الباحث)) (763)، وابن عدي في ((الكامل في الضعفاء)) (2/ 64) بزيادة في آخره.","bab":"الولاء والبراء › موالاة المسلمين","dorar":"y6LwYK0M"},{"id":"س-03083","fp":"756a8ba72f36","stateId":409,"easy":"إذا خالفت أمر النبي ﷺ ← يُجعل عليك الذل والصغار","cause":"على من خالفَ أمري","result":"وجُعِلَ الذُّلُّ و الصَّغارُ","explicit":true,"star":true,"ref":"صحيح الجامع 2831","srcLabel":"البخاري","text":["بُعِثتُ بين يدي الساعةِ بالسَّيفِ ، حتى يُعبَدَ اللهُ تعالى وحده لا شريكَ له ، و جُعِلَ رِزْقي تحت ظِلِّ رُمْحي ، ",["وجُعِلَ الذُّلُّ و الصَّغارُ",2]," ",["على من خالفَ أمري",1]," ، و من تشبَّه بقومٍ فهو منهم"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه البخاري معلقاً بصيغة التضعيف قبل حديث (2914) مختصراً، وأخرجه موصولاً أحمد (5667) واللفظ له.","bab":"إيمان › الوعيد","dorar":"9Keg9BA6"},{"id":"ق-1463","fp":"72616c183e4e","stateId":409,"easy":"بغض النبي ﷺ ← البتر وانقطاع الخير","cause":"بغض النبي ﷺ","result":"البتر وانقطاع الخير","explicit":true,"otherNeedIds":[57],"ref":"سورة الكوثر: 3","srcLabel":"القرآن الكريم","quran":{"s":108,"from":3,"to":3,"text":"إِنَّ شَانِئَكَ هُوَ الْأَبْتَرُ (3)","hl":[[0,32,1]]}},{"id":"س-00188","fp":"264a67b1e574","stateId":410,"easy":"إذا أثنيت على رجل (بمبالغة) ← قطعت عنق صاحبك","cause":"أَثْنَى رَجُلٌ علَى رَجُلٍ","result":"ويْلَكَ! قَطَعْتَ عُنُقَ صَاحِبِكَ","explicit":true,"star":true,"otherNeedIds":[13],"ref":"الباعث على الخلاص 20","srcLabel":"متفق عليه","text":["قطعتَ عنقَ صاحبِكَ [يعني حديث: ",["أَثْنَى رَجُلٌ علَى رَجُلٍ",1]," عِنْدَ النَّبيِّ صَلَّى اللهُ عليه وسلَّمَ، فَقالَ: ",["ويْلَكَ! قَطَعْتَ عُنُقَ صَاحِبِكَ",2],"، قَطَعْتَ عُنُقَ صَاحِبِكَ، مِرَارًا، ثُمَّ قالَ: مَن كانَ مِنكُم مَادِحًا أخَاهُ لا مَحَالَةَ، فَلْيَقُلْ: أحْسِبُ فُلَانًا، واللَّهُ حَسِيبُهُ، ولَا أُزَكِّي علَى اللَّهِ أحَدًا، أحْسِبُهُ كَذَا وكَذَا، إنْ كانَ يَعْلَمُ ذلكَ منه.]"],"grade":"صحيح","narrator":"[ أبو بكرة نفيع بن الحارث]","muhaddith":"صحيح","takhrij":"أخرجه البخاري (2662)، ومسلم (3000)، وأبو داود (4805) واللفظ لهم.","bab":"آداب الكلام › الثناء الحسن","dorar":"Bpn6Vuw4"},{"id":"س-00380","fp":"48426e7a1782","stateId":410,"easy":"إذا مدحت أحداً في وجهه ← قطعت عنقه","cause":"مادِحًا","result":"وَيلَكَ قَطَعتَ عُنُقَهُ","explicit":true,"star":true,"otherNeedIds":[13],"ref":"تخريج المسند لشعيب 20484","srcLabel":"متفق عليه","text":[["وَيلَكَ قَطَعتَ عُنُقَهُ",2],"، إنْ كنتَ ",["مادِحًا",1]," لا مَحالةَ، فَقُلْ: أحْسَبُهُ كذا وكذا، وَاللهُ حَسيبُهُ، وَلا أُزَكِّي على اللهِ أحَدًا."],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6061)، ومسلم (3000)، وأبو داود (4805)، والنسائي في ((السنن الكبرى)) (10068)، وابن ماجه (3744)، وأحمد (20484) واللفظ له","bab":"آداب عامة › الأخلاق المذمومة","dorar":"CwYS4FC1"},{"id":"س-00185","fp":"6bf48c5e526e","stateId":410,"easy":"إذا أثنيت على رجل في وجهه ← فقد عقرته","cause":"فَأَثْنَى رجلٌ على رجلٍ في وجهِهِ","result":"عَقَرْتَ الرجلَ","explicit":true,"otherNeedIds":[13],"ref":"صحيح الأدب المفرد 255","srcLabel":"البخاري","text":["كُنَّا جُلوسًا عندَ عمرَ ",["فَأَثْنَى رجلٌ على رجلٍ في وجهِهِ",1]," فقال ",["عَقَرْتَ الرجلَ",2]," عَقَرَكَ اللَّهُ"],"grade":"حسن","narrator":"[يزيد بن شريك التيمي]","muhaddith":"حسن الإسناد","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (335) واللفظ له، وأخرجه ابن أبي شيبة (26795) باختلاف يسير","bab":"آداب الكلام › الثناء الحسن","dorar":"ytxccbbK"},{"id":"س-00356","fp":"04a9a61c6a2c","stateId":410,"easy":"إذا مدحت صاحبك في وجهه ← تقطع ظهره","cause":"يأتي أحدُكم صاحبَهُ فيمدحَهُ","result":"فيقطعَ ظَهرَهُ","explicit":true,"otherNeedIds":[13],"ref":"صحيح الأدب المفرد 599","srcLabel":"البخاري (الأدب المفرد)","text":["عن عبدِ اللَّهِ بن مسعود قالَ إذا طلبَ أحدُكمُ الحاجةَ فليطلبْها طلبًا يسيرًا فإنَّما لَهُ ما قدِّرَ لَهُ ولا ",["يأتي أحدُكم صاحبَهُ فيمدحَهُ",1]," ",["فيقطعَ ظَهرَهُ",2]],"grade":"صحيح","muhaddith":"صحيح الإسناد","bab":"آداب عامة › الأخلاق المذمومة","dorar":"pex80vjW"},{"id":"س-00518","fp":"39037ba2bb1e","stateId":410,"easy":"إذا زكّيت أحداً في وجهه ← فكأنك ذبحته","cause":"أنْ تُزَكِّيَهُ في وجهِهِ","result":"ذبْحُ الرجُلِ","explicit":true,"otherNeedIds":[13],"ref":"صحيح الجامع 3427","srcLabel":"ابن أبي الدنيا","text":[["ذبْحُ الرجُلِ",2]," ",["أنْ تُزَكِّيَهُ في وجهِهِ",1]],"grade":"صحيح","narrator":"إبراهيم التيمي","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي الدنيا في ((الصمت)) (596)","bab":"آداب عامة › ضرب الأمثال","dorar":"iKGGgAvZ"},{"id":"س-08145","fp":"c49bdd15ff7c","stateId":410,"easy":"إذا أثنيت على أخيك في وجهه ← تهلكه","cause":"فأثَنْيتُ عليه خَيرًا","result":"لا تُسمِعْه؛ فتُهلِكَه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[13],"ref":"مجمع الزوائد 3/311","srcLabel":"أحمد","text":["كان بُرَيدَةُ على بابِ المَسجِدِ، فمرَّ مِحجَنٌ عليه وسُكبَةُ يُصلِّي، فقال بُرَيدَةُ -وكان فيه مِزاحٌ- لمِحجَنٍ: ألَا تُصَلِّي كما يُصلِّي هذا؟ فقال مِحجَنٌ: إنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم أخَذَ بيَدي، فأشرَفَ على المدينَةِ، فقال: وَيل أُمِّها قَريَةً يَدَعُها أهلُها خَيرَ ما تكونُ، فيأتيها الدَّجَّالُ، فيَجِد على كُلِّ بابٍ من أبوابِها مَلَكًا مُصلِتًا بجَناحِه، فلا يَدخُلُها، قال: ثم [نَزَلَ وهو] آخِذٌ بيَدي، فدخَلَ المَسجِدَ، فإذا رَجُلٌ يُصَلِّي، فقال لي: مَن هذا؟ [فأتَيتُ عليه] ",["فأثَنْيتُ عليه خَيرًا",1],"، فقال: اسكُتْ ",["لا تُسمِعْه؛ فتُهلِكَه",2],"، قال: ثم أتى حُجرَةَ امرَأةٍ من نِسائِه، فنفَضَ يَدَه من يَدي، قال: إنَّ خَيرَ دِينِكم أيسَرُه، إنَّ خَيرَ دِينكِم أيسَرُه."],"grade":"صحيح","narrator":"محجن بن الأدرع","muhaddith":"رجاله رجال الصحيح خلا رجاء وقد وثقه ابن حبان","takhrij":"أخرجه أحمد (18976) واللفظ له.","bab":"ملائكة › أعمال الملائكة","dorar":"P1UJ4zMD","merged":8,"otherRefs":["إتحاف الخيرة المهرة 1/111 (صحيح)","إتحاف الخيرة المهرة 1/112 (صحيح)","تخريج المسند لشعيب 20349 (حسن)","تخريج المسند لشعيب 20468 (صحيح)","البحر الزخار 9/95 (حسن)","صحيح مسلم 3000 (صحيح)","صحيح الأدب المفرد 254 (صحيح)"]},{"id":"س-06663","fp":"667b69c623d2","stateId":411,"easy":"إذا لم تسووا صفوفكم ← يخالف الله بين وجوهكم","cause":"لَتُسَوُّنَّ صُفوفَكُم","result":"أو لَيُخالِفَنَّ اللهُ بينَ وُجوهِكُم","explicit":true,"star":true,"otherNeedIds":[21,19,41],"ref":"صحيح مسلم 436","srcLabel":"متفق عليه","text":["كانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يُسَوِّي صُفوفَنا حتَّى كَأنَّما يُسَوِّي بها القِداحَ حتَّى رَأى أنَّا قد عَقَلنا عنه، ثُمَّ خَرَجَ يَومًا فقامَ، حتَّى كادَ يُكَبِّرُ، فرَأى رَجُلًا باديًا صَدرُه مِنَ الصَّفِّ، فقال: عِبادَ اللهِ ",["لَتُسَوُّنَّ صُفوفَكُم",1]," ",["أو لَيُخالِفَنَّ اللهُ بينَ وُجوهِكُم",2],"."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (717) مختصراً، ومسلم (436).","bab":"صلاة الجماعة والإمامة › إقامة الصفوف ووصلها وفضائلها","dorar":"nI4Dcgez","merged":11,"otherRefs":["تغليق التعليق 2/302 (صحيح)","صحيح الجامع 3648 (صحيح)","صحيح الترمذي 227 (صحيح)","السلسلة الصحيحة 32 (صحيح)","تخريج سنن الدارقطني 1093 (صحيح)","صحيح ابن خزيمة 1/ 275 (صحيح)","صحيح أبي داود 663 (صحيح)","صحيح ابن ماجه 820 (صحيح)","صحيح الجامع 5070 (صحيح)","النكت على المحرر 1/114 (صحيح)"]},{"id":"س-06683","fp":"f2d79f1d4c2f","stateId":411,"easy":"إذا اختلفتم في الصف ← تختلف قلوبكم","cause":"تَختلِفوا","result":"فتَختلِفَ قُلوبُكم","explicit":true,"star":true,"ref":"تخريج سنن الدارقطني 1085","srcLabel":"مسلم","text":["يَؤُمُّ القَومَ أقدَمُهم هِجرةً، فإنْ كانوا في الهِجرةِ سَواءً فأفقَهُهم في الدِّينِ، فإنْ كانوا في الدِّينِ سَواءً فأقرَؤُهم للقُرآنِ، ولا يُؤَمُّ الرَّجلُ في سُلْطانِه، ولا يُقعَدُ على تَكرِمتِه إلَّا بإذنِه، وكان يُسوِّي مَناكِبَنا في الصَّلاةِ، ويقولُ: لا ",["تَختلِفوا",1]," ",["فتَختلِفَ قُلوبُكم",2],"، لِيَلِني منكم أُولو الأحلامِ والنُّهى، ثم الذين يَلونَهم."],"grade":"صحيح","narrator":"أبو مسعود عقبة بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه الدارقطني (1085) بلفظه، ومسلم (673)، وأبو داود (582) كلاهما باختلاف يسير، والترمذي (2772) مختصرا.","bab":"صلاة الجماعة والإمامة › الإمام","dorar":"ZJ610Qpp","merged":3,"otherRefs":["عون المعبود 3/202 (صحيح)","شرح البخاري لابن الملقن 14/17 (صحيح)"]},{"id":"ق-0292","fp":"083a509eff00","stateId":411,"easy":"نسيان حظ مما ذُكّروا به ونقض الميثاق ← إغراء العداوة والبغضاء بينهم إلى يوم القيامة","cause":"نسيان حظ مما ذُكّروا به ونقض الميثاق","result":"إغراء العداوة والبغضاء بينهم إلى يوم القيامة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة المائدة: 14","srcLabel":"القرآن الكريم","quran":{"s":5,"from":14,"to":14,"text":"وَمِنَ الَّذِينَ قَالُوا إِنَّا نَصَارَى أَخَذْنَا مِيثَاقَهُمْ فَنَسُوا حَظًّا مِمَّا ذُكِّرُوا بِهِ فَأَغْرَيْنَا بَيْنَهُمُ الْعَدَاوَةَ وَالْبَغْضَاءَ إِلَى يَوْمِ الْقِيَامَةِ وَسَوْفَ يُنَبِّئُهُمُ اللَّهُ بِمَا كَانُوا يَصْنَعُونَ (14)","hl":[[64,180,1]]}},{"id":"ق-0335","fp":"c8f6b42af256","stateId":411,"easy":"الخمر والميسر ← العداوة والبغضاء والصد عن ذكر الله وعن الصلاة","cause":"الخمر والميسر","result":"العداوة والبغضاء والصد عن ذكر الله وعن الصلاة","explicit":true,"otherNeedIds":[21],"ref":"سورة المائدة: 91","srcLabel":"القرآن الكريم","quran":{"s":5,"from":91,"to":91,"text":"إِنَّمَا يُرِيدُ الشَّيْطَانُ أَنْ يُوقِعَ بَيْنَكُمُ الْعَدَاوَةَ وَالْبَغْضَاءَ فِي الْخَمْرِ وَالْمَيْسِرِ وَيَصُدَّكُمْ عَنْ ذِكْرِ اللَّهِ وَعَنِ الصَّلَاةِ فَهَلْ أَنْتُمْ مُنْتَهُونَ (91)","hl":[[0,161,1]]}},{"id":"ق-1146","fp":"5a73923abf86","stateId":411,"easy":"البغي ← التفرق بعد العلم","cause":"البغي","result":"التفرق بعد العلم","explicit":true,"ref":"سورة الشورى: 14","srcLabel":"القرآن الكريم","quran":{"s":42,"from":14,"to":14,"text":"وَمَا تَفَرَّقُوا إِلَّا مِنْ بَعْدِ مَا جَاءَهُمُ الْعِلْمُ بَغْيًا بَيْنَهُمْ وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِنْ رَبِّكَ إِلَى أَجَلٍ مُسَمًّى لَقُضِيَ بَيْنَهُمْ وَإِنَّ الَّذِينَ أُورِثُوا الْكِتَابَ مِنْ بَعْدِهِمْ لَفِي شَكٍّ مِنْهُ مُرِيبٍ (14)","hl":[[0,79,1]]}},{"id":"س-04882","fp":"e242f156cf6d","stateId":411,"easy":"إذا أفسدت ذات البين ← فهي الحالقة (تحلق الدين)","cause":"إياكم وسوءَ ذاتِ البينِ","result":"فإِنَّها الحالِقَةُ","explicit":true,"otherNeedIds":[57],"ref":"الجامع الصغير 2897","srcLabel":"الترمذي","text":[["إياكم وسوءَ ذاتِ البينِ ؛ ",1],["فإِنَّها الحالِقَةُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2508)، والبزار (8482)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"uQeQNGGK"},{"id":"س-05858","fp":"5ef43bd58c1a","stateId":411,"easy":"إذا ماريت حليماً أو سفيهاً ← فالحليم يبغضك والسفيه يؤذيك","cause":"تُمارِ حليمًا ولا سفيهًا","result":"فإنَّ الحليمَ يُقليك ، وإنَّ السَّفيهَ يُؤذيك","explicit":true,"ref":"الترغيب والترهيب 4/26","srcLabel":"أبو داود","text":["عن ابنِ عبَّاسٍ  رضِي اللهُ عنهما قال : سمِعتُه يقولُ : خمسٌ لهنَّ أحسنُ من الدُّهْمِ المُوقَفةِ : لا تَكلَّمْ فيما لا يعنيك ، فإنَّه فضلٌ ولا آمَنُ عليك الوِزرَ ، ولا تَكلَّمْ فيما لا يعنيك حتَّى تجِدَ له مَوضعًا ، فإنَّه رُبَّ مُتكلِّمٍ في أمرٍ يعنيه قد وضعه في غيرِ موضعِه فعُيِّب ، ولا ",["تُمارِ حليمًا ولا سفيهًا",1]," ، ",["فإنَّ الحليمَ يُقليك ، وإنَّ السَّفيهَ يُؤذيك",2]," ، واذكُرْ أخاك إذا تغيَّب عنك بما تحِبُّ أن يذكُرَك به ، وأعْفِه ممَّا تُحِبُّ أن يُعفيَك منه ، واعمَلْ عملَ رجلٍ يرَى أنَّه مجازًى بالإحسانِ مأخوذٌ بالإجرامِ"],"grade":"صحيح","narrator":"مجاهد بن جبر المكي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن أبي الدنيا في ((الصمت)) (114) واللفظ له، وأبو داود في ((الزهد)) (334) والبيهقي في ((شعب الإيمان)) (4663) بنحوه","bab":"رقائق وزهد › الوصايا النافعة","dorar":"gaRpFUyh"},{"id":"س-07354","fp":"92c4e3a2ca35","stateId":411,"easy":"إذا تركت المراء ← تسلم (فنفعه قليل ويهيج العداوة)","cause":"ذروا المراءَ","result":"فإنَّ نفعَه قليلٌ ويُهيِّجُ العداءَ بينَ الإخوانِ","explicit":true,"ref":"النوافح العطرة 148","srcLabel":"النوافح العطرة","text":["ذَروا المِراءَ [يعني حديث: خرج علينا رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ونحن نتمارى في شيءٍ منَ الدِّينِ فغضب غضبًا شديدًا لم يغضبْ مثلَه ثم انتهرَنا فقال يا أمةَ محمدٍ لا تُهيِّجوا على أنفسِكم وهجَ النارِ ثم قال بهذا أمرتُكم أو ليس عن هذا نهيتُكم أليس قد كان هلك من كان قبلكم بهذا ثم قال ذروا المراءَ لقلةِ خيرِه ",["ذروا المراءَ",1]," ",["فإنَّ نفعَه قليلٌ ويُهيِّجُ العداءَ بينَ الإخوانِ",2]," ذروا المراءَ فإنَّ المراءَ لا تؤمنُ فتنتُه ذروا المراءَ فإنَّ المراءَ يورثُ الشكَّ ويحبطُ العملَ ذروا المراءَ فإنَّ المؤمنَ لا يُماري ذروا المِراءِ فإنَّ المُماريَ قد تمت خسارتُه ذروا المراءَ فكفاك إثمًا أن لا تزال مُماريًا ذروا المراءَ فإنَّ المُماريَ لا أشفعُ له يومَ القيامةِ ذروا المراءَ فأنا زعيمٌ بثلاثةِ أبياتٍ في الجنةِ في وسَطِها ورياضِها وأعلاها لمن يتركُ المراءَ وهو صادقٌ ذروا المراءَ فإنَّ أولَ ما نهاني عنه ربي عَزَّ وَجَلَّ بعد عبادةِ الأوثانِ وشربِ الخمرِ المراءُ ذروا المراءَ فإنَّ الشيطانَ قد أَيِسَ أن يُعبدَ ولكنه رضيَ منكم بالتَّحريشِ وهو المراءُ في الدِّينِ ذروا المراءَ فإنَّ بني إسرائيلَ افترقوا على إحدى وسبعين فرقةً والنصارى على اثنتين وسبيعن فرقةً وإنَّ أمتي ستفترقُ على ثلاثةٍ وسبعين فرقةً كلِّهم على الضلالةِ إلا السوادَ الأعظمَ قالوا يا رسولَ اللهِ وما السوادُ الأعظمُ قال ما أنا عليه وأصحابي مَنْ لم يمارِ في دينِ اللهِ ولم يكفِّرْ أحدًا من أهلِ التوحيدِ بذنبٍ ثم قال إنَّ الإسلامَ بدأ غريبًا وسيعودُ كما بدأ فطُوبى للغرباءِ قالوا يا رسولَ اللهِ ومَنِ الغرباءُ قال الذين يَصلُحون إذا فسد الناسُ ولا يمارون في دينِ اللهِ ولا يكفِّرون أحدًا مِنْ أهلِ التوحيدِ بذنبٍ]"],"grade":"صحيح","narrator":"[أبو الدرداء وأبو أمامة الباهلي وأنس بن مالك وواثلة بن الأسقع]","muhaddith":"صحيح","bab":"فتن › كراهية الاختلاف","dorar":"TMkPFVlz"},{"id":"س-05780","fp":"fc32241fe2b2","stateId":411,"easy":"إذا شاررت الناس ← تظهر عيوبك وتدفن محاسنك","cause":"إياكَ ومُشارَّةَ الناسِ","result":"فإنها تُظهرُ العرَّةَ وتدفنُ الغرَّةَ","explicit":true,"ref":"شرح كتاب الشهاب 196","srcLabel":"البيهقي","text":[["إياكَ ومُشارَّةَ الناسِ ",1],["فإنها تُظهرُ العرَّةَ وتدفنُ الغرَّةَ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن لغيره","takhrij":"أخرجه تمام في ((الفوائد)) (39)، والقضاعي في ((مسند الشهاب)) (956)، والبيهقي في ((شعب الإيمان)) (8220) باختلاف يسير","bab":"رقائق وزهد › الوصايا النافعة","dorar":"b25bANdx"},{"id":"س-05138","fp":"bd98c7a48b40","stateId":412,"easy":"إذا التمست رضا الناس بسخط الله ← يكلك الله إلى الناس","cause":"ومَن التمَس رضا الناسِ بسخَطِ اللهِ","result":"وكَله اللهُ إلى الناسِ","explicit":true,"ref":"تخريج زاد المعاد 3/14","srcLabel":"الترمذي","text":["أنَّها كتَبتْ إلى معاويةَ: سلامٌ عليك، أمَّا بعدُ، فإنِّي سَمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: مَن التمَس رضا اللهِ بسخَطِ الناسِ، كفاه اللهُ مَؤُونةَ الناسِ، ",["ومَن التمَس رضا الناسِ بسخَطِ اللهِ، ",1],["وكَله اللهُ إلى الناسِ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (2414) واللفظ له، وابن حبان (276)، وإسحاق بن راهويه في ((المسند)) (1175) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"XEUnQjM4"},{"id":"س-08218","fp":"785f104d615e","stateId":412,"easy":"إذا طلبت القضاء واستعنت عليه ← تُوكل إليه","cause":"من طَلَب القَضاءَ واستعان عليه","result":"وُكِلَ إليه","explicit":true,"star":true,"ref":"الأحاديث المختارة 1580","srcLabel":"البخاري","text":["«",["من طَلَب القَضاءَ واستعان عليه",1]," ",["وُكِلَ إليه",2],"، ومن لم يَطْلَبْه ولم يَستَعِنْ عليه أنزَلَ اللهُ إليه مَلَكًا يُسَدِّدُه»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"ملائكة › أعمال الملائكة","dorar":"sGOBTOrL"},{"id":"س-01819","fp":"c3d00464791c","stateId":412,"easy":"إذا سألت الناس ← فهي من آخر كسب الرجل وأذلّه","cause":"مَسْأَلَةَ الناسِ","result":"فإنَّها من آخِرِ كَسْبِ الرجلِ","explicit":true,"star":true,"ref":"صحيح الأدب المفرد 277","srcLabel":"البخاري","text":["أنَّ أباهُ أوْصَى عندَ موتِهِ بَنِيهِ فقال اتَّقُوا اللهَ وسَوِّدُوا أكبرُكُمْ فإنَّ القومَ إذا سَوَّدُوا أَكْبَرَهُمْ خَلَفُوا أباهُمْ وإذا سَوَّدُوا أَصْغَرَهُمْ أَزْرَى بِهمْ ذلكَ في أَكْفَائِهِمْ وعليكُمْ بِالمالِ واصْطِناعِهِ فإنَّهُ مَنْبَهَةٌ لِلْكَرِيمِ ويُسْتَغْنَى بهِ عَنِ اللَّئِيمِ وإِيَّاكُمْ و",["مَسْأَلَةَ الناسِ",1]," ",["فإنَّها من آخِرِ كَسْبِ الرجلِ",2]," وإذا مُتُّ فلا تَنُوحُوا فإنَّهُ لمْ يُنَحْ على رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ وإذا مُتُّ فَادْفِنُونِي بِأَرْضٍ لا يَشْعُرُ بِدَفْنِي بَكْرُ بْنُ وائِلٍ فإني كُنْتُ أُغَافِلُهُمْ في الجاهليةِ"],"grade":"حسن","narrator":"قيس بن عاصم","muhaddith":"حسن الإسناد","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (361) بلفظه، والطبراني (18/ 339) (869)، وعبد الرزاق (21091) كلاهما بنحوه، وأحمد (20612) مختصرا.","bab":"إجارة › كسب الرجل وعمله بيده","dorar":"wYRW5r8g"},{"id":"س-05322","fp":"ffc50b6ddf3d","stateId":412,"easy":"إذا تعلقت شيئاً (تميمة) ← تُوكل إليه","cause":"منْ تَعلَّقَ شيئًا","result":"وُكِلَ إليهِ","explicit":true,"star":true,"ref":"الجامع الصغير 8580","srcLabel":"الترمذي","text":[["منْ تَعلَّقَ شيئًا ",1],["وُكِلَ إليهِ",2]],"grade":"صحيح","narrator":"عبدالله بن حكيم","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2072)، وأحمد (18781)، والحاكم (7503) واللفظ لهم.","bab":"رقائق وزهد › التوكل واليقين","dorar":"uZ00T0oD","merged":3,"otherRefs":["صحيح الترغيب 3456 (حسن)","غاية المرام 297 (حسن)"]},{"id":"س-06121","fp":"cddd036710e1","stateId":412,"easy":"إذا طلبت محامد الناس بمعاصي الله ← يعود حامدك ذاماً لك","cause":"من طلب محامِدَ النَّاسِ بمعاصي اللهِ","result":"عاد حامِدُه له ذامًّا","explicit":true,"ref":"الترغيب والترهيب 3/209","srcLabel":"الترمذي","text":[["من طلب محامِدَ النَّاسِ بمعاصي اللهِ ",1],["عاد حامِدُه له ذامًّا",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (2414) بمعناه مطولاً، والعقيلي في ((الضعفاء الكبير)) (3/343) باختلاف يسير، وابن عساكر في ((تاريخ دمشق)) (71/149) واللفظ له","bab":"رقائق وزهد › من أرضى الناس بسخط الله","dorar":"OrGRnzZU","merged":2,"otherRefs":["إتحاف الخيرة المهرة 7/380 (حسن)"]},{"id":"س-08140","fp":"51176a31eb95","stateId":412,"easy":"إذا طلبت القضاء وسعيت إليه بالشفعاء ← تُوكل إلى نفسك","cause":"من ابتغَى القضاءَ وسأل فيه شفعاءَ","result":"وُكِل إلى نفسِه","explicit":true,"ref":"الترغيب والترهيب 3/183","srcLabel":"أبو داود","text":[["من ابتغَى القضاءَ وسأل فيه شفعاءَ ",1],["وُكِل إلى نفسِه",2]," ومن أُكِره عليه أنزل اللهُ عليه ملَكًا يُسدِّدُه"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (3578)، والترمذي (1324) واللفظ له، وابن ماجه (2309)، وأحمد (13302).","bab":"ملائكة › أعمال الملائكة","dorar":"YmTEqcr4","merged":2,"otherRefs":["الأحاديث المختارة 1581 (صحيح)"]},{"id":"س-06924","fp":"da90be3d1c41","stateId":412,"easy":"إذا أسخطت الله برضا الناس ← يكلك الله إلى الناس","cause":"و من أسخط اللهَ بِرضى الناسِ","result":"وكلَه اللهُ إلى الناسِ","explicit":true,"ref":"السلسلة الصحيحة 2311","srcLabel":"الترمذي","text":["من أرْضى اللهَ بسخَطِ الناسِ ، كفاه اللهُ الناسَ ، ",["و من أسخط اللهَ بِرضى الناسِ",1]," ، ",["وكلَه اللهُ إلى الناسِ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2414) بنحوه، وعبد بن حميد في ((المسند)) (1522)، وابن حبان (277) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"jYc1CQfF"},{"id":"س-06950","fp":"f55466bd71fe","stateId":412,"easy":"إذا أرضيت الناس بسخط الله ← يكلك الله إليهم","cause":"مَنْ أرْضَى الناسَ بسخَطِ اللهِ","result":"وكَلَهُ اللهُ إلى الناسِ","explicit":true,"ref":"صحيح الجامع 6010","srcLabel":"الترمذي","text":[["مَنْ أرْضَى الناسَ بسخَطِ اللهِ",1]," ",["وكَلَهُ اللهُ إلى الناسِ",2]," ، و مَنْ أسخَطَ الناسَ برضا اللهِ كفاهُ اللهُ مُؤْنَةَ الناسِ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2414) بنحوه، وعبد بن حميد في ((المسند)) (1522)، وابن حبان (277) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"HO2G0FrH"},{"id":"س-06953","fp":"d34445f7d781","stateId":412,"easy":"إذا أرضيت الناس بسخط الله ← يعود حامدك من الناس ذاماً لك","cause":"ومن أرْضَى الناسَ بسَخَطِ اللهِ","result":"عادَ حامِدُهُ مِنَ الناسِ ( لَهُ ) ذَامًّا","explicit":true,"ref":"شرح الطحاوية 268","srcLabel":"الترمذي","text":["من أرْضَى اللهَ بِسَخَطِ الناسِ ، رَضِيَ اللهُ عنه  وأَرْضَى عنه الناسَ ، ",["ومن أرْضَى الناسَ بسَخَطِ اللهِ ، ",1],["عادَ حامِدُهُ مِنَ الناسِ ( لَهُ ) ذَامًّا",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2414) بنحوه، وعبد بن حميد في ((المسند)) (1522)، وابن حبان (277) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"NIKhkxFv"},{"id":"س-06403","fp":"55e2debe3da4","stateId":412,"easy":"إذا تصدقت بمالك كله ثم تكففت الناس ← فقد أسأت","cause":"يأتي أحدُكُم بمالِهِ كلِّهُ فيتصدَّقُ بِهِ","result":"ويتَكَفَّفُ النَّاسَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح ابن خزيمة 4/ 165","srcLabel":"أبو داود","text":["جاءَ رجلٌ إلى رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ببَيضةٍ من ذَهَبٍ أصابَها مِن بعضِ المعادنِ، وقالَ الدَّورقيُّ: مثلَ البيضةِ من ذَهَبٍ قد أصابَها من بعضِ المعادنِ - وقالا: فقالَ: يا رسولَ اللَّهِ، خذ هذِهِ منِّي صدقةً، فواللَّهِ ما أصبَحتُ أملِكُ غيرَها فأعرضَ عنهُ، ثمَّ أتاهُ من شقِّهِ الأيمنِ فقالَ مثلَ ذلِكَ، فأعرضَ عنهُ ثمَّ أتاهُ من شقِّهِ الأيسرِ، فقالَ لَهُ مثلَ ذلِكَ فأعرضَ عنهُ، ثمَّ قالَ لَهُ الرَّابعةَ، فقالَ: هاتِها مُغضبًا فحذفَهُ بِها حَذفةً لَو أصابَهُ لشجَّهُ أو عقرَهُ، ثمَّ قالَ ",["يأتي أحدُكُم بمالِهِ كلِّهُ فيتصدَّقُ بِهِ",1]," ",["ويتَكَفَّفُ النَّاسَ",2]," إنَّما الصَّدقةُ عن ظَهْرِ غنًى [وفي روايةٍ] زادَ خُذ عنَّا مالَكَ لا حاجةَ لَنا فيهِ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (1673) بلفظ مقارب، وأحمد (14531) ببعضه، والدارمي (1700)","bab":"صدقة › كراهة التصدق بكل المال","dorar":"9n4e5U6R","merged":3,"otherRefs":["صحيح ابن حبان 3372 (صحيح)","إرشاد الساري 4/233 (صحيح)"]},{"id":"س-06299","fp":"fbac2fa085ee","stateId":412,"easy":"إذا سألت الناس ← فيدك السفلى","cause":"يدُ السَّائلِ","result":"السُّفلَى إلى يومِ القيامةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح ابن خزيمة 4/ 161","srcLabel":"الحاكم","text":["الأيدي ثَّلاثةُ، يدُ اللَّهِ العُليا، ويدُ المعطي الَّتي تليَها و",["يدُ السَّائلِ",1]," ",["السُّفلَى إلى يومِ القيامةِ",2],"، فاستعِفَّ عنِ السُّؤالِ ما استطعتَ. [وفي روايةٍ]: فاستعِفُّوا عنِ السُّؤالِ ما استطعتُمْ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن أبي شيبة في ((مسنده)) (419)، وابن خزيمة في ((التوحيد))  (1/ 156)، والحاكم (1485) بلفظه","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"qsHSwKtQ","merged":3,"otherRefs":["شرح معاني الآثار 2/21 (صحيح)","صحيح الترغيب 821 (صحيح)"]},{"id":"س-01777","fp":"0c680a62ad39","stateId":412,"easy":"إذا سألت وعندك ما يغنيك ← فلو علمت ما في المسألة ما سألت","cause":"المَسألةِ","result":"لو تَعلَمونَ ما أعلَمُ في المَسألةِ، ما سألَ رَجُلٌ رَجُلًا وهو يَجِدُ لَيلةً تُبيتُهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"similar":["س-00395"],"otherNeedIds":[3],"ref":"تخريج المسند لشعيب 20644","srcLabel":"النسائي","text":["سَمِعتُ عائِذَ بنَ عَمْرٍو المُزَنيَّ قالَ: بَينا نحن مع نَبِيِّنا صلَّى اللهُ عليهِ وسَلَّمَ، فذكَرَ حَديثَ ",["المَسألةِ",1]," [أي حَديثَ: بَينَما نحن مع نَبِيِّنا صلَّى اللهُ عليهِ وسَلَّمَ، إذا أعرابيٌّ قد ألَحَّ عليهِ في المَسألةِ، يَقولُ: يا رَسولَ اللهِ، أطعِمْني يا رَسولَ اللهِ، أعطِني، قالَ: فقامَ رَسولُ اللهِ صلَّى اللهُ عليهِ وسَلَّمَ، فدخَلَ المَنزِلَ، وأخَذَ بِعِضادَتَيِ الحُجْرَةِ، وأقبَلَ علينا بِوَجْهِهِ، وقالَ: والذي نَفْسُ محمدٍ بِيَدِهِ، ",["لو تَعلَمونَ ما أعلَمُ في المَسألةِ، ما سألَ رَجُلٌ رَجُلًا وهو يَجِدُ لَيلةً تُبيتُهُ",2],"، فأمَرَ له بِطَعامٍ]."],"grade":"صحيح","narrator":"عائذ بن عمرو","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي (2586)، وأحمد (20644) واللفظ له","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"SXFyCM52","merged":2,"otherRefs":["مسند عمر 1/32 (صحيح)"]},{"id":"س-00395","fp":"950fb6f7e142","stateId":412,"easy":"إذا سألت الناس ← فلو علمت ما في المسألة ما سألت أحداً","cause":"المَسْألةِ","result":"لو تَعلَمونَ ما في المَسْألةِ ما مَشى أحَدٌ إلى أحَدٍ يَسأَلُه شَيئًا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-01777","otherNeedIds":[3],"ref":"الأحكام الوسطى 2/199","text":["أنَّ رَجُلًا أتى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فسَألَه فأَعْطاه، فلمَّا وَضَعَ رِجْلَه في أُسْكُفَّةِ البابِ قالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: \"",["لو تَعلَمونَ ما في المَسْألةِ ما مَشى أحَدٌ إلى أحَدٍ يَسأَلُه شَيئًا",2],"."],"grade":"صحيح","narrator":"عائذ بن عمرو","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه النسائي (2586)، واللفظ له، وأحمد (20646)، والروياني (776) في ((مسنده)) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"aRWiMqzd"},{"id":"س-07768","fp":"8c16ccf63fe1","stateId":413,"easy":"إذا غللت ← فهو عار عليك يوم القيامة","cause":"وإيَّاكم والغُلولَ","result":"فإنَّه عارٌ على أهْلِه يَوْمَ القِيامةِ","explicit":true,"star":true,"otherNeedIds":[70],"ref":"الأحاديث المختارة 8 / 296","srcLabel":"متفق عليه","text":["«خَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ إلى بَدْرٍ فلَقيَ بها العَدُوَّ، فلمَّا هَزَمَهم اللهُ اتَّبَعَتْهم طائِفةٌ مِن المُسلِمينَ يَقتُلونَهم، وأَحْدَقَتْ طائِفةٌ برَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ واسْتَوْلَتْ طائِفةٌ على النَّهْبِ والعَسْكَرِ، فلمَّا رَجَعَ الَّذين طَلَبوا العَدُوَّ قالوا: لنا النَّفَلُ نحن طَلَبْنا العَدُوَّ وبنا نَفاهم اللهُ وهَزَمَهم اللهُ، وقالَ الَّذين أَحْدَقوا برَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ: ما أنتم بأَحَقَّ بِه مِنَّا بلْ هو لنا؛ نحن أَحْدَقْنا برَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أن يَنالَه مِن العَدُوِّ غِرَّةٌ، وقالَ الَّذين اسْتَوْلَوا على العَسكَرِ والنَّهْبِ: ما أنتم بأَحَقَّ به مِنَّا بلْ هو لنا؛ نحن اسْتَوْلَيْنا عليه وأَحْرَزْناه، فأَنزَلَ اللهُ على رَسولِه: {يَسْأَلُونَكَ عَنِ الْأَنْفَالِ قُلِ الْأَنْفَالُ لِلَّهِ وَالرَّسُولِ فَاتَّقُوا اللَّهَ وَأَصْلِحُوا ذَاتَ بَيْنِكُمْ}، الآيةُ، وقَسَمَها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ عن فُواقٍ.\nوكانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يُنَفِّلُهم بادينَ الرُّبُعَ، وإذا قَفَلوا الثُّلُثَ.\nوأخَذَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ وَبَرةً مِن ظَهْرِ بَعيرِه فقالَ: ما يَحِلُّ لي مِن الفَيءِ قَدْرُ هذه الوَبَرةِ إلَّا الخُمُسُ) والخُمُسُ مَرْدودٌ عليكم، فأدُّوا الخَيْطَ والمِخْيَطَ، ",["وإيَّاكم والغُلولَ",1],"؛ ",["فإنَّه عارٌ على أهْلِه يَوْمَ القِيامةِ",2],"، وعليكم بالجِهادِ؛ فإنَّه بابٌ مِن أبْوابِ الجنَّةِ، يُذهِبُ اللهُ به الغَمَّ والهَمَّ).\nوكانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يَكرَهُ النَّفَلَ ويقولُ: (يَرُدُّ قَوِيُّ القَوْمِ على ضَعيفِهم)»."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"قرآن › أسباب النزول","dorar":"1E8yTKKC"},{"id":"س-07067","fp":"62aad7cc8e73","stateId":413,"easy":"إذا تعرضت من البلاء لما لا تطيق ← تذل نفسك","cause":"يتعرَّضُ منَ البلاءِ لما لا يُطيقُ","result":"يُذِلَّ نفسَه","explicit":true,"star":true,"ref":"إتحاف الخيرة المهرة 8/88","srcLabel":"إتحاف الخيرة المهرة","text":["لما هَزَم يزيدُ بنُ المُهَلَّبِ أهلَ البصرةِ  قال المعلى: خشيتُ أن أجلسَ في حلقةِ الحسنِ بنِ أبي الحسنِ  فأوجَد فيها فأُعرَفَ  فأتيتُ الحسنَ في منزِلِه  فدخلتُ عليه  فقلتُ له: يا أبا سعيدٍ  كيف بهذه الآيةِ مِن كتابِ اللهِ , عزَّ وجلَّ , ؟ قال: أيةُ آيةٍ مِن كتابِ اللهِ ؟ قلتُ: قولُ اللهِ , عزَّ وجلَّ: لبِئسَ ما كانوا يَفعَلونَ قال: يا عبدَ اللهِ  إنَّ القومَ عرَضوا السيفَ فحال السيفُ دونَ الكلامِ قلتُ: يا أبا سعيدٍ  فهل تعرفُ لمثلِكم فضلًا ؟ قال: لا قال المعلى: ثم حدَّث بحديثينِ  قال: حدَّثنا أبو سعيدٍ الخدريُّ  رضي اللهُ عنه , عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم: ألا لا يمنعَنَّ أحدَكم رهبةُ الناسِ أن يقولَ بالحقِّ إذا رآه  أن يذكرَ تعظيمَ اللهِ فإنه لا يقربُ مِن أجلٍ  ولا يبعدُ مِن رزقٍ ثم قال: حدَّث الحسنُ بحديثٍ آخرَ  قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ليس لمؤمنٍ أن ",["يُذِلَّ نفسَه",2]," قيل: وما إذلالُه نفسَه ؟ قال: ",["يتعرَّضُ منَ البلاءِ لما لا يُطيقُ",1]," قيل: يا أبا سعيدٍ  فيزيدُ الضبيُّ وكلامُه في الصلاةِ  فقال: أما إنه لم يَخرُجْ منَ السجنِ حتى ندِم  قال المعلى: فقمتُ مِن مجلسِ الحسنِ فأتيتُ يزيدَ  فقلتُ: يا أبا مودودَ  بينما أنا والحسنُ نتذاكرُ إذ نصَب أمرَكَ نصبًا  فقال: مَهْ  يا أبا الحسنِ  قال: قلتُ: قد فعَلتَ  قال: فما قال الحسنُ ؟ قال: أما إنه لم يَخرُجْ منَ السجنِ حتى ندِم على مقالتِه  قال يزيدُ: ما ندِمتُ على مقالتي  وايمُ اللهِ لقد قمتُ مقامًا أخطرُ فيه بنفسي  قال يزيدُ: فأتيتُ الحسنَ  فقلتُ: يا أبا سعيدٍ  غُلِبْنا على كلِّ شيءٍ  نُغلَبُ على صلاتِنا فقال: يا عبدَ اللهِ  إنكَ لم تَصنَعْ شيئًا  إنكَ تعرضُ بنفسِك لهم  ثم أتيتُه  فقال لي مثلَ مقالتِه  قال: فقمتُ يومَ الجمعةِ في المسجدِ  والحكمُ بنُ أيوبَ يخطبُ  فقلتُ: رحِمَكَ اللهُ  الصلاةَ  قال: فلما قلتُ ذلك احتَوَشَتْني الرجالُ يتعاوَروني  فأخَذوا بلِحيَتي وتلبيبَتي وجعَلوا يجَئونَ بطني بنعالِ سيوفِهم  ومَضَوا بي نحوَ المقصورةِ  قال: فدخَلتُ فقمتُ بين يدَيِ الحكمِ وهو ساكتٌ  فقال: أمجنونٌ أنتَ ؟ أوما كنا في صلاةٍ ؟ فقلتُ: أصلَح اللهُ الأميرَ  هل مِن كلامٍ أفضلَ مِن كلامِ اللهِ ؟ قال: لا قلتُ: أصلَح اللهُ الأميرَ  أرأيتَ لو أنَّ رجلًا نشَر مصحفًا يقرؤه غدوةً إلى الليلِ  أكان ذلك قاضيًا عنه صلاتَه ؟ قال: واللهِ إني لأحسبُكَ مجنونًا قال: وأنسُ بنُ مالكٍ جالسٌ تحتَ منبرِه ساكتٌ  فقلتُ: يا أنسُ  يا أبا حمزةُ  أنشدُكَ اللهَ  لقد خدَمتَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم  وصحِبتَه: أبمعروفٍ قلتُ أم بمنكرٍ ؟ أبحقٍّ قلتُ أم بباطلٍ ؟ قال: فلا واللهِ ما أجابني بكلمةٍ  قال له الحكمُ بنُ أيوبَ: يا أنسُ  قال: لبَّيكَ أصلَحكَ اللهُ قال: أكان وقتُ الصلاةِ قد ذهَب ؟ قال: كان بقي منَ الشمسِ بقيةٌ فقال: احبِسوه قال يزيدُ: فأُقسِمُ لكَ يا أبا الحسنِ  يعني: للمعلى  لمَا لَقيتُ مِن أصحابي كان  أشدَّ عليَّ مما لَقيتُ منَ الحكمِ قال بعضُهم: مُراءٍ  وقال بعضُهم: مجنونٌ  قال: وكتَب الحكمُ إلى الحَجَّاجِ أنَّ رجلًا مِن بني ضبةَ قام إليَّ يومَ الجمُعةِ  قال: الصلاةَ  وأنا أخطُبُ الناسَ  وقد شهِد الشهودُ العدولُ عندي أنه مجنونٌ  فكتَب إليه الحَجَّاجُ: إن كان شهِد الشهودُ العدولُ أنه مجنونٌ فخَلِّ سبيلَه  وإلا فاقطَعْ يدَيه ورجلَيه واسمِلْ عينَيه واصلبْه  قال: فشهِدوا عندَ الحكمِ أني مجنونٌ فخلَّى عني قال المعلى عن يزيدَ الضبي: مات أخٌ لنا فتبِعنا جنازتَه فصلَّينا عليه  فلما دُفِن تنحيتُ في عصابةٍ فذكَرْنا اللهَ وذكَرْنا معادَنا  فإنا كذلك إذ رأَينا نواصيَ الخيلِ والحرابَ  فلما رآه أصحابي تفرَّقوا وترَكوني وَحدي  فجاء الحكمُ حتى وقَف عليَّ  فقال: ما كنتُم تَصنَعونَ ؟ قلتُ: أصلَح اللهُ الأميرَ  مات صاحبٌ لنا فصلَّينا عليه ودفَنَّاه  وقعَدْنا نذكرُ ربَّنا ونذكرُ معادَنا ونذكرُ ما صار إليه  قال: ما منَعكَ أن تفِرَّ كما فرُّوا ؟ قلتُ: أصلَح اللهُ الأميرَ  أنا أبرأُ مِن ذلك ساحةً أو منَ الأميرِ أفِرُّ ؟ قال: فسكَت الحكمُ  فقال عبدُ الملكِ بنُ المهلبِ  وكان على شرطتِه: أتدري مَن هذا ؟ قال: مَن هذا ؟ قال: هذا المتكلمُ بالجُمُعةِ  قال: فغضِب الحكمُ  وقال له: أما إنكَ لجريءٌ خُذاه  قال: فأُخِذتُ فضرَبني أربعَ مئةِ سوطٍ  فما درَيتُ حين ترَكني مِن شدةِ ما ضرَبني  قال: وبعَثني إلى واسطَ فكنتُ في ديماسِ الحَجَّاجِ حتى مات الحَجَّاجُ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"سنده صحيح","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"2AEGpAAY","merged":3,"otherRefs":["عمدة التفسير 1/716 (صحيح)","صحيح الترمذي 2254 (صحيح)"]},{"id":"س-07415","fp":"31cf4353727d","stateId":413,"easy":"إذا التمست ذل الإسلام ← ثغرت ثغرة فيه لا تُقبل منك توبة حتى تسدها","cause":"مَن التَمَس ذُلَّه","result":"ثَغَر ثُغْرةً في الإِسلامِ، ولَمْ يُقبَلْ مِنه تَوبةٌ حتَّى يُعيدَها كَما كانتْ","explicit":true,"otherNeedIds":[13],"ref":"تخريج كتاب السنة 1079","srcLabel":"أحمد","text":["لَمَّا خَرجَ أبو ذرٍّ إلى الرَّبَذَةِ لَقِيه رَكْبٌ مِن أَهلِ العِراقِ، فَقالوا: يا أبا ذرٍّ، قدْ بَلَغَنا الَّذي صُنِع بكَ، فاعقِدْ لِواءً يَأتيكَ رِجالٌ ما شِئتَ، قال: مهلًا مهلًا يا أهلَ الإسلامِ؛ فإنِّي سَمِعتُ رَسولَ اللهِ يَقولُ: سيَكونُ بَعدي سُلطانٌ فأَعِزُّوه، ",["مَن التَمَس ذُلَّه",1]," ",["ثَغَر ثُغْرةً في الإِسلامِ، ولَمْ يُقبَلْ مِنه تَوبةٌ حتَّى يُعيدَها كَما كانتْ",2],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (1020) بلفظه، وأحمد (21460)، والبيهقي في ((شعب الإيمان)) (6989) كلاهما بنحوه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"eAJbplQ5"},{"id":"س-05958","fp":"bc12178d82f7","stateId":413,"easy":"إذا طلبت الولاية ← تكون عند النبي ﷺ من أخون الناس","cause":"مَن طَلَبهُ","result":"إنَّ أخوَنَكم عِندي","explicit":true,"ref":"تخريج مشكل الآثار 58","srcLabel":"النسائي","text":["قدِم على النَّبيِّ عليه السَّلامُ رجُلانِ مِنَ الأشعريِّينَ، فخطَبا، ثمَّ تعرَّضا للعملِ، فقال: ",["إنَّ أخوَنَكم عِندي",2]," ",["مَن طَلَبهُ",1],"، فعليكما بتَقْوى اللهِ تعالى."],"grade":"حسن","narrator":"أبو موسى","muhaddith":"[فيه] أبو بكرة، هو بكار بن قتيبة، وإسماعيل بن أبي خالد _وهو الأحمسي مولاهم البجلي_ قال المزي: له ثلاثة أخوة سعيد وأشعث ونعمان، وقد روى إسماعيل عنهم كلهم، فالله أعلم أيهم هذا، وباقي رجاله ثقات، [وروي] من طريقين بهذا الإسناد","takhrij":"أخرجه الطحاوي في ((شرح المشكل)) (58) بلفظه، والبزار (3161)، والنسائي في ((السنن الكبرى)) (5898) كلاهما باختلاف يسير.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"EbH8jVEH","merged":2,"otherRefs":["الجامع الصغير 130 (حسن)"]},{"id":"س-00361","fp":"979a341f46c5","stateId":413,"easy":"إذا أسرعت في المشي ← يذهب بهاؤك","cause":"السُّرعةُ في المشْيِ","result":"تُذهِبُ بهاءَ المؤمنِ","explicit":true,"ref":"الجامع الصغير 4791","srcLabel":"ابن عدي","text":[["السُّرعةُ في المشْيِ ",1],["تُذهِبُ بهاءَ المؤمنِ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه ابن عدي في ((الكامل في ضعفاء الرجال)) (6/ 138)، وأبو نعيم في ((حلية الأولياء وطبقات الأصفياء)) (10/ 290)، والخطيب في ((تاريخ بغداد)) (1/ 435)","bab":"آداب عامة › الأخلاق المذمومة","dorar":"nNsqIQqI"},{"id":"س-01817","fp":"d24557c732a2","stateId":413,"easy":"إذا سوّدتم أصغركم ← أزرى بكم ذلك عند أكفائكم","cause":"إذا سَوَّدُوا أَصْغَرَهُمْ","result":"أَزْرَى بِهمْ ذلكَ في أَكْفَائِهِمْ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"صحيح الأدب المفرد 277","srcLabel":"البخاري","text":["أنَّ أباهُ أوْصَى عندَ موتِهِ بَنِيهِ فقال اتَّقُوا اللهَ وسَوِّدُوا أكبرُكُمْ فإنَّ القومَ إذا سَوَّدُوا أَكْبَرَهُمْ خَلَفُوا أباهُمْ و",["إذا سَوَّدُوا أَصْغَرَهُمْ",1]," ",["أَزْرَى بِهمْ ذلكَ في أَكْفَائِهِمْ",2]," وعليكُمْ بِالمالِ واصْطِناعِهِ فإنَّهُ مَنْبَهَةٌ لِلْكَرِيمِ ويُسْتَغْنَى بهِ عَنِ اللَّئِيمِ وإِيَّاكُمْ ومَسْأَلَةَ الناسِ فإنَّها من آخِرِ كَسْبِ الرجلِ وإذا مُتُّ فلا تَنُوحُوا فإنَّهُ لمْ يُنَحْ على رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ وإذا مُتُّ فَادْفِنُونِي بِأَرْضٍ لا يَشْعُرُ بِدَفْنِي بَكْرُ بْنُ وائِلٍ فإني كُنْتُ أُغَافِلُهُمْ في الجاهليةِ"],"grade":"حسن","narrator":"قيس بن عاصم","muhaddith":"حسن الإسناد","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (361) بلفظه، والطبراني (18/ 339) (869)، وعبد الرزاق (21091) كلاهما بنحوه، وأحمد (20612) مختصرا.","bab":"إجارة › كسب الرجل وعمله بيده","dorar":"wYRW5r8g","merged":2,"otherRefs":["إتحاف الخيرة المهرة 2/418 (حسن)"]},{"id":"س-04666","fp":"aad735de436f","stateId":414,"easy":"إذا كذبت ← يسوّد الكذب وجهك","cause":"الكذِبَ","result":"يُسوِّدُ الوجهَ","explicit":true,"ref":"صحيح ابن حبان 5735","srcLabel":"البيهقي","text":["ألا إنَّ ",["الكذِبَ",1]," ",["يُسوِّدُ الوجهَ",2],"، والنَّميمةَ مِن عذابِ القبرِ"],"grade":"صحيح","narrator":"أبو برزة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو يعلى (7440)، والبيهقي في ((شعب الإيمان)) (4473))، وابن بشران في ((الأمالي)) (1185) جميعا باختلاف يسير.،","bab":"دفن ومقابر › عذاب القبر ونعيمه","dorar":"blWI6fvy"},{"id":"س-04136","fp":"cacb9a833646","stateId":414,"easy":"إذا كنت فاجراً ← يستريح منك العباد والبلاد والشجر والدواب","cause":"العبدُ الفاجرُ","result":"يَستريحُ منه العِبادُ والبِلادُ والشَّجرُ والدَّوابُّ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 22576","srcLabel":"متفق عليه","text":["كنَّا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ جُلوسًا في مَجلسٍ، إذ مَرَّتْ جِنازةٌ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: مُستريحٌ ومُستراحٌ منه، قال: فقُلْنا: يا رسولَ اللهِ، ما المُستريحُ؟ قال: العبدُ المؤمنُ يَستريحُ مِن نَصَبِ الدُّنْيا وأذاها إلى رَحمةِ اللهِ، قُلْنا: فما المُستراحُ منه؟ قال: ",["العبدُ الفاجرُ",1]," ",["يَستريحُ منه العِبادُ والبِلادُ والشَّجرُ والدَّوابُّ",2],". قال عبدُ الرَّحمنِ: وقَرَأتُه على مالكٍ، يَعني هذا الحديثَ."],"grade":"صحيح","narrator":"أبو قتادة الحارث بن ربعي","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6512)، ومسلم (950)، والنسائي (1930)، وأحمد (22576) واللفظ له","bab":"جنائز وموت › روح المؤمن بعد الموت","dorar":"Hm4sGnM1","merged":3,"otherRefs":["تخريج صحيح ابن حبان 3007 (صحيح)","صحيح مسلم 950 (صحيح)"]},{"id":"ق-0179","fp":"52d58703f3b0","stateId":414,"easy":"الفظاظة وغلظ القلب ← انفضاض الناس من حولك","cause":"الفظاظة وغلظ القلب","result":"انفضاض الناس من حولك","explicit":true,"ref":"سورة آل عمران: 159","srcLabel":"القرآن الكريم","quran":{"s":3,"from":159,"to":159,"text":"فَبِمَا رَحْمَةٍ مِنَ اللَّهِ لِنْتَ لَهُمْ وَلَوْ كُنْتَ فَظًّا غَلِيظَ الْقَلْبِ لَانْفَضُّوا مِنْ حَوْلِكَ فَاعْفُ عَنْهُمْ وَاسْتَغْفِرْ لَهُمْ وَشَاوِرْهُمْ فِي الْأَمْرِ فَإِذَا عَزَمْتَ فَتَوَكَّلْ عَلَى اللَّهِ إِنَّ اللَّهَ يُحِبُّ الْمُتَوَكِّلِينَ (159)","hl":[[44,109,1]]}},{"id":"س-06104","fp":"3931ae8f6856","stateId":414,"easy":"إذا أبغضك الله ← يبغضك جبريل وأهل السماء ويوضع لك البغض في الأرض","cause":"وإذا أبغَضَ عَبدًا","result":"دَعا جِبريلَ فيَقولُ: إنِّي أُبغِضُ فُلانًا فأبغِضْه","explicit":true,"star":true,"otherNeedIds":[27],"ref":"صحيح مسلم 2637","srcLabel":"البخاري","text":["كُنَّا بعَرَفةَ فمَرَّ عُمَرُ بنُ عبدِ العَزيزِ وهو على المَوسِمِ، فقامَ النَّاسُ يَنظُرونَ إليه، فقُلتُ لأبي: يا أبَتِ إنِّي أرى اللهَ يُحِبُّ عُمَرَ بنَ عبدِ العَزيزِ، قال: وما ذاكَ؟ قُلتُ: لما له مِنَ الحُبِّ في قُلوبِ النَّاسِ، فقال: بأبيكَ أنتَ سَمِعتُ أبا هُرَيرةَ يُحَدِّثُ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم...، ثُمَّ ذَكَرَ بمِثلِ حَديثِ جَريرٍ، عن سُهَيلٍ. [أي بمثلِ حديثِ: إنَّ اللهَ إذا أحَبَّ عَبدًا دَعا جِبريلَ فقال: إنِّي أُحِبُّ فُلانًا فأحِبَّه، قال: فيُحِبُّه جِبريلُ، ثُمَّ يُنادي في السَّماءِ فيَقولُ: إنَّ اللهَ يُحِبُّ فُلانًا فأحِبُّوه، فيُحِبُّه أهلُ السَّماءِ، قال: ثُمَّ يوضَعُ له القَبولُ في الأرضِ، ",["وإذا أبغَضَ عَبدًا",1]," ",["دَعا جِبريلَ فيَقولُ: إنِّي أُبغِضُ فُلانًا فأبغِضْه،",2]," قال: فيُبغِضُه جِبريلُ، ثُمَّ يُنادي في أهلِ السَّماءِ: إنَّ اللهَ يُبغِضُ فُلانًا فأبغِضوه، قال: فيُبغِضونَه، ثُمَّ توضَعُ له البَغضاءُ في الأرضِ]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7485) دون القصة في أوله","bab":"رقائق وزهد › محبة الله عز وجل","dorar":"aUQ450Hs","merged":4,"otherRefs":["تخريج المسند لشعيب 22270 (صحيح)","حلية الأولياء 3/91 (صحيح)","عارضة الأحوذي 6/243 (صحيح)"]},{"id":"س-00187","fp":"7d411a4d1740","stateId":414,"easy":"إذا ساء ذكرك في السماء ← يوضع لك ذلك في الأرض","cause":"و إنْ كان صِيتُهُ في السماءِ سيِّئًا","result":"وُضِعَ في الأرْضِ","explicit":true,"ref":"صحيح الجامع 5732","srcLabel":"الطبراني","text":["ما من عبدٍ إِلَّا ولهُ صِيتٌ في السماءِ ، فإنْ كان صِيتُهُ في السماءِ حَسَنًا ، وُضِعَ في الأرْضِ ، ",["و إنْ كان صِيتُهُ في السماءِ سيِّئًا",1]," ، ",["وُضِعَ في الأرْضِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البزار (9202)، والطبراني في ((المعجم الأوسط)) (5248)، وابن عدي في ((الكامل في الضعفاء)) (2/163) باختلاف يسير.","bab":"آداب الكلام › الثناء الحسن","dorar":"cDEQM80a","merged":2,"otherRefs":["معجم الشيوخ 2/752 (حسن)"]},{"id":"س-06012","fp":"059f6d2670f6","stateId":414,"easy":"إذا كنت فاجراً شقياً ← فأنت هيّن على الله","cause":"وفاجرٌ شقيٌّ","result":"هيِّنٌ على اللَّهِ","explicit":true,"ref":"صحيح الترمذي 3270","srcLabel":"الترمذي","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ خطبَ النَّاسَ يومَ فتحِ مَكَّةَ، فقالَ: يا أيُّها النَّاسُ، إنَّ اللَّهَ قد أذهبَ عنكم عُبِّيَّةَ الجاهليَّةِ وتعاظمَها بآبائِها فالنَّاسُ رجلانِ: برٌّ تقيٌّ كريمٌ على اللَّهِ، ",["وفاجرٌ شقيٌّ",1]," ",["هيِّنٌ على اللَّهِ",2],"، والنَّاسُ بنو آدمَ، وخلقَ اللَّهُ آدمَ من الترابِ، قالَ اللَّهُ:  يَا أَيُّهَا النَّاسُ إِنَّا خَلَقْنَاكُمْ مِنْ ذَكَرٍ وَأُنْثَى وَجَعَلْنَاكُمْ شُعُوبًا وَقَبَائِلَ لِتَعَارَفُوا إِنَّ أَكْرَمَكُمْ عِنْدَ اللَّهِ أَتْقَاكُمْ إِنَّ اللَّهَ عَلِيمٌ خَبِيرٌ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3270) واللفظ له، وعبد بن حميد (793)، وابن حبان (3828)","bab":"رقائق وزهد › تقوى الله","dorar":"QoPSzKpx"},{"id":"س-05438","fp":"b37657f2aba2","stateId":414,"easy":"إذا فحشت في شيء ← شانه الفحش","cause":"ما كان الفُحْشُ في شيءٍ","result":"قَطُّ إلَّا شانه","explicit":true,"star":true,"ref":"الأحاديث المختارة 1777","srcLabel":"البخاري","text":["«",["ما كان الفُحْشُ في شيءٍ",1]," ",["قَطُّ إلَّا شانه",2],"، ولا كان الحياءُ في شَيءٍ قَطُّ إلَّا زانه»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"رقائق وزهد › الحياء","dorar":"lcy08ruD","merged":2,"otherRefs":["صحيح الأدب المفرد 469 (صحيح)"]},{"id":"س-07111","fp":"7589c8460eaa","stateId":414,"easy":"إذا رأى الناس منك شراً ← ظنوا بك شراً وأبغضوك","cause":"ومن رأَينا منه شَرًّا","result":"ظَنَنَّا به شَرًّا وأبغَضْناه عليه","explicit":true,"ref":"الأحاديث المختارة 116","srcLabel":"متفق عليه","text":["«شَهِدْتُ عُمَرَ بنَ الخَطَّابِ وهو يخطُبُ النَّاسَ، قال: فقال: يا أيُّها النَّاسُ إنَّه قد أتى عليَّ زمانٌ وأنا أرى من قرأ القُرآنَ يُريدُ اللهَ وما عِندَه، فيُخَيَّلُ إليَّ أنَّ قَومًا قَرؤوه يُريدونَ به النَّاسَ، ويُريدونَ به الدُّنيا، ألَا فأَريدوا اللهَ بأعمالِكم، ألَا إنَّا إنَّما كُنَّا نَعرِفُكم أن يُنَزَّلَ، وأنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم بَيْنَ أظهُرِنا وإذ: {نَبَّأَنَا اللَّهُ مِنْ أَخْبَارِكُمْ} فقد انقَطَع الوَحْيُ وذهب نبيُّ اللهِ صلَّى اللهُ عليه وسلَّم فإنَّما نَعرِفُكم بما نقولُ لكم، ألَا مَن رأينا منه خيرًا ظَنَنَّا به خيرًا وأحبَبْناه عليه، ",["ومن رأَينا منه شَرًّا",1]," ",["ظَنَنَّا به شَرًّا وأبغَضْناه عليه",2],"، سرائِرُكم بَيْنَكم وبَيْنَ رَبِّكم، ألَا إنِّي إنَّما أَبعَثُ عُمَّالي ليُعَلِّموكم دينَكم، وليُعَلِّمُوكم سُنَّتَكم، ولا أبعَثُهم ليَضرِبوا ظُهورَكم ولا ليأخُذوا أموالَكم، ألَا فمَن رابه شيءٌ من ذلك فليرفَعْه إليَّ؛ فوالذي نَفْسُ عُمَرَ بيَدِه لأُقِصَّنَّكم منه. قال: فقام عَمرُو بنُ العاصِ، فقال: يا أميرَ المؤمِنينَ، أرأيتَ إنْ بعَثْتَ عامِلًا مِن عُمَّالِك، فأدَّب رجلًا من أهلِ رَعِيَّتِه فضَرَبه، أكُنْتَ تُقِصُّه منه؟ قال: فقال: نَعَم، والذي نَفْسُ عُمَرَ بيَدِه لأقُصَّنَّ منه، ألَا أَقُصُّ، وقد رأيتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقُصُّ مِن نَفْسِه، ألَا لا تَضْرِبوا المُسلِمينَ فتُذِلُّوهم، ولا تمنَعوهم حُقوَقهم فتُكَفِّروهم، ولا تَجَمِّرُوهم فتَفْتِنوهم، ولا تُنزِلوهم الغِياضَ فتُضَيِّعوهم»."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"علم › تعليم الناس وفضل ذلك","dorar":"xh74WHmz","merged":2,"otherRefs":["تخريج المسند لشاكر 1/146 (حسن)"]},{"id":"ق-1366","fp":"51e1be82fc54","stateId":414,"easy":"كثرة الحلف والهمز والنميمة ومنع الخير والاعتداء والتكذيب بالآيات ← الوسم على الخرطوم (الإذلال)","cause":"كثرة الحلف والهمز والنميمة ومنع الخير والاعتداء والتكذيب بالآيات","result":"الوسم على الخرطوم (الإذلال)","explicit":true,"otherNeedIds":[70],"ref":"سورة القلم: 10–16","srcLabel":"القرآن الكريم","quran":{"s":68,"from":10,"to":16,"text":"وَلَا تُطِعْ كُلَّ حَلَّافٍ مَهِينٍ (10) هَمَّازٍ مَشَّاءٍ بِنَمِيمٍ (11) مَنَّاعٍ لِلْخَيْرِ مُعْتَدٍ أَثِيمٍ (12) عُتُلٍّ بَعْدَ ذَلِكَ زَنِيمٍ (13) أَنْ كَانَ ذَا مَالٍ وَبَنِينَ (14) إِذَا تُتْلَى عَلَيْهِ آيَاتُنَا قَالَ أَسَاطِيرُ الْأَوَّلِينَ (15) سَنَسِمُهُ عَلَى الْخُرْطُومِ (16)","hl":[[0,285,1]]}},{"id":"س-06630","fp":"34adc0bccb55","stateId":414,"easy":"إذا تخلفت عن العشاء والصبح ← يُساء بك الظن (أثر ابن عمر)","cause":"فَقَدْنا الإنسانَ في صَلاةِ العِشاءِ الآخِرةِ والصُّبحِ","result":"أسَأْنا به الظَّنَّ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 859","srcLabel":"ابن حبان","text":["أنَّ عَبدَ اللهِ بنَ عُمَرَ، كان يَقولُ: كُنَّا إذا ",["فَقَدْنا الإنسانَ في صَلاةِ العِشاءِ الآخِرةِ والصُّبحِ",1]," ",["أسَأْنا به الظَّنَّ",2],"."],"grade":"صحيح","narrator":"نافع","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه ابن حبان (5946)، والبيهقي (5017)، وابن أبي شيبة (3353) واللفظ لهم.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"ojdbhXEH","merged":2,"otherRefs":["الترغيب والترهيب 1/205 (صحيح)"]}]}