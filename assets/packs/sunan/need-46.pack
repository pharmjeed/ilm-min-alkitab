{"schema":1,"kind":"sunan-chunk","version":"sunan-cb5af5731a1c","needId":46,"stateIds":[467,468,469,470,471,472,473,474],"items":[{"id":"س-04542","fp":"93036d12e201","stateId":467,"easy":"إذا آمنت بلا شك وجاهدت بلا غلول وحججت حجة مبرورة ← فهي أفضل الأعمال","cause":"إيمانٌ لا شَكَّ فيه، وجِهادٌ لا غُلولَ فيه، وحَجَّةٌ مَبْرورةٌ","result":"أيُّ الأعْمالِ أفْضَلُ","explicit":true,"star":true,"otherNeedIds":[47],"ref":"الأحاديث المختارة 9 / 235","srcLabel":"متفق عليه","text":["«أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ سُئِلَ: ",["أيُّ الأعْمالِ أفْضَلُ",2],"؟ قالَ: ",["إيمانٌ لا شَكَّ فيه، وجِهادٌ لا غُلولَ فيه، وحَجَّةٌ مَبْرورةٌ",1],"، قيلَ: فأيُّ الصَّلاةِ أَفْضَلُ؟ قالَ: طولُ القِيامِ، قيلَ: فأيُّ الصَّدَقةِ أَفْضَلُ؟ قالَ: جُهْدُ المُقِلِّ، قيلَ: فأيُّ الهِجْرةِ أَفْضَلُ؟ قالَ: مَن هَجَرَ ما حَرَّمَ اللهُ عليه، قيلَ: فأيُّ الجِهادِ أَفْضَلُ؟ قالَ: مَن جاهَدَ المُشْرِكينَ بمالِه ونَفْسِه، قيلَ: فأيُّ القَتْلِ أَشْرَفُ؟ قالَ: مَن أُهريقَ دَمُه وعُقِرَ جَوادُه»."],"grade":"صحيح","narrator":"عبدالله بن حبشي الخثعمي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"جهاد › فضل الشهيد","dorar":"sLHD6VNX","merged":3,"otherRefs":["تخريج المسند لشعيب 7511 (صحيح)","تخريج المسند لشعيب 8580 (صحيح)"]},{"id":"س-02260","fp":"d62497447ca2","stateId":467,"easy":"إذا آمنت بالله ورسوله ← فهو أفضل الأعمال","cause":"إيمانٌ باللَّهِ ورسولِهِ","result":"أيُّ الأعمالِ أفضلُ، وأيُّ الأعمالِ خيرٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"similar":["س-04463","س-07027"],"otherNeedIds":[23],"ref":"صحيح الترمذي 1658","srcLabel":"متفق عليه","text":["سُئِلَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ ",["أيُّ الأعمالِ أفضلُ، وأيُّ الأعمالِ خيرٌ",2],"؟ قالَ: ",["إيمانٌ باللَّهِ ورسولِهِ",1],"، قيلَ: ثمَّ أيُّ شيءٍ؟ قالَ: الجِهادُ سَنامُ العمل، قيلَ: ثمَّ أيُّ شيءٍ يا رسولَ اللَّهِ؟ قالَ: ثمَّ حَجٌّ مبرورٌ ر"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه البخاري (1519)، ومسلم (83)، والترمذي (1658) واللفظ له، والنسائي (3130)، وأحمد (7580)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"BtmY7vyg","merged":4,"otherRefs":["مساجلة علمية 10 (حسن)","تخريج المسند لشاكر 14/249 (صحيح)","صحيح النسائي 5000 (صحيح)"]},{"id":"س-04463","fp":"ddc3c3fb13a7","stateId":467,"easy":"إذا آمنت ← فهو أفضل الإسلام","cause":"الإيمانُ","result":"فأيُّ الإسلامِ أفضَلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-02260","ref":"تخريج شرح الطحاوية 494","text":["قال رجلٌ: يا رسولَ اللهِ، ما الإسلامُ؟ قال: (أن يُسلِمَ قَلبُكَ للهِ عزَّ وجلَّ، وأن يَسلَمَ المسلِمون مِن لِسانِك ويَدِك)، قال: ",["فأيُّ الإسلامِ أفضَلُ",2],"؟ قال: (",["الإيمانُ",1],")، قال: وما الإيمانُ؟ قال: (تُؤمِنُ باللهِ وملائكتِه وكُتبِه ورُسلِه والبعثِ بعدَ الموتِ)، قال: فأيُّ الإيمانِ أفضَلُ؟ قال: (الهجرةُ)، قال: فما الهِجْرةُ؟ قال: (تهجُرُ السُّوءَ)، قال: فأيُّ الهجرةِ أفضَلُ؟ قال: (الجهادُ)، قال: وما الجهادُ؟ قال: (أن تُقاتِلَ الكُفَّارَ إذا لَقِيتَهم)، قال: فأيُّ الجهادِ أفضلُ؟ قال: (مَن عقَرَ جَوادَه، وأُهْرِيقَ دَمُه)، قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: (ثُمَّ عَمَلانِ هما أفضَلُ الأعمالِ إِلَّا مَن عَمِلَ بمِثْلِهما: حِجَّةٌ مَبرورةٌ، أو عُمْرةٌ."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"إسناده صحيح إن كان أبو قلابة سمعه من عمرو بن عبسة","takhrij":"أخرجه من طرق ابن ماجه (2794) مختصراً، وأحمد (17027) واللفظ له","bab":"جهاد › فضل الجهاد","dorar":"00HDd8XT"},{"id":"س-07056","fp":"2f23f26519dc","stateId":467,"easy":"إذا أسلمت ← فهو أفضل الأعمال","cause":"فقال صلَّى اللهُ عليه وسلَّم : الإسلامُ","result":"أيُّ الأعمالِ أفضلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"تخريج الإحياء للعراقي 1/161","srcLabel":"أحمد","text":["سُئل فقيل : ",["أيُّ الأعمالِ أفضلُ",2]," ؟ ",["فقال صلَّى اللهُ عليه وسلَّم : الإسلامُ",1]," فقال : أيُّ الإسلامِ أفضلُ فقال صلَّى اللهُ عليه وسلَّم : الإيمانُ ."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (17027) بطوله .","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"f11K6Npe"},{"id":"س-07027","fp":"3d37c6d21800","stateId":467,"easy":"إذا علمت بالله ← فهو أفضل الأعمال","cause":"العلمُ باللهِ عزَّ وجلَّ","result":"أيُّ الأعمالِ أفضلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-02260","otherNeedIds":[18],"ref":"جامع بيان العلم 1/203","text":["جاء رجلٌ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلم فقال : يا رسولَ اللهِ أيُّ الأعمالِ أفضلُ ؟ قال :  ",["العلمُ باللهِ عزَّ وجلَّ",1],"  قال : يا رسولَ اللهِ ",["أيُّ الأعمالِ أفضلُ",2]," ؟ قال :  العلمُ باللهِ  . قال : يا رسولَ اللهِ أسألُكَ عن العملِ وتخبِرني عن العلمِ ! فقال رسولُ اللهِ صلَّى اللهُ عليه وسلم :  إنَّ قليلَ العملِ ينفعُ مع العلمِ ، وإنَّ كثيرَ العملِ لا ينفعُ مع الجهلِ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"روى مثل هذا عن عبد الله بن مسعود أيضاً بإسناد صالح","takhrij":"أخرجه ابن منده في ((مجالس من أماليه)) (418)، والديلمي في الفردوس كما في ((جامع الأحاديث)) للسيوطي(4050).","bab":"علم › الحث على طلب العلم","dorar":"b5YRQyKO"},{"id":"س-06577","fp":"ab1b2c2af5f8","stateId":467,"easy":"إذا صليت ثم جاهدت في سبيل الله ← فهو أفضل العمل","cause":"بعدَ الصَّلاةِ الِجهادُ في سَبيلِ اللهِ تَعالى، وما أقعَدَ ابنَ عُمَرَ عن الغَزْوِ إلَّا وصايا لعُمَرَ، وصِبيانٌ صِغارٌ، وضَيْعَةٌ كَثيرَةٌ، وقد أغارَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم على بَني المُصطَلِقِ وهم غارُّون، يَسْقون على نَعَمِهم","result":"إنَّ أفضَلَ العَمَلِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشعيب 4873","srcLabel":"متفق عليه","text":["[عن] ابن عون قال: كَتَبتُ إلى نافِعٍ أسأَلُه: ما أقعَدَ ابنَ عُمَرَ عن الغَزْوِ؟ وعن القَومِ إذا غَزَوْا، بما يَدْعون العَدُوَّ قَبلَ أنْ يُقاتِلوهم؟ وهل يَحمِلُ الرَّجُلُ إذا كان في الكَتيبَةِ بغَيرِ إِذْنِ إمامِه؟ فكَتَبَ إليَّ: إنَّ ابنَ عُمَرَ قد كان يَغْزو وَلَدُه، ويَحمِلُ على الظَّهرِ، وكان يقولُ: ",["إنَّ أفضَلَ العَمَلِ",2],[" بعدَ الصَّلاةِ الِجهادُ في سَبيلِ اللهِ تَعالى، وما أقعَدَ ابنَ عُمَرَ عن الغَزْوِ إلَّا وصايا لعُمَرَ، وصِبيانٌ صِغارٌ، وضَيْعَةٌ كَثيرَةٌ، وقد أغارَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم على بَني المُصطَلِقِ وهم غارُّون، يَسْقون على نَعَمِهم،",1]," فقَتَلَ مُقاتِلَتَهم، وسَبى سباياهم، وأصابَ جُوَيريَةَ بِنتَ الحارِثِ، قال: فحدَّثَني بهذا الحَديثِ ابنُ عُمَرَ، وكان في ذلك الجَيشِ، وإنَّما كانوا يَدْعون في أوَّلِ الإسلامِ، وأمَّا الرَّجُلُ فلا يَحمِلُ على الكَتيبَةِ إلَّا بإِذْنِ إمامِه."],"grade":"صحيح","narrator":"[عبدالله بن عمر]","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (2541)، ومسلم (1730)، وأبو داود (2633)، والنسائي في ((السنن الكبرى)) (8585)، وأحمد (4873) واللفظ له","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"ULFwaVK4"},{"id":"س-06576","fp":"df66a1ab8fd0","stateId":467,"easy":"إذا صليت لوقتها وبررت والديك وجاهدت ← فهي أفضل العمل","cause":"الصَّلاةُ لوَقتِها، وبِرُّ الوالِدَينِ، والجِهادُ","result":"أفضَلُ العَمَلِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشعيب 23120","srcLabel":"مسلم","text":["عن رَجُلٍ مِن أصْحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ قال: سُئِلَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: أيُّ العَمَلِ أفضَلُ؟ -قال شُعْبةُ: أو قال:- ",["أفضَلُ العَمَلِ",2]," ",["الصَّلاةُ لوَقتِها، وبِرُّ الوالِدَينِ، والجِهادُ",1],"."],"grade":"صحيح","narrator":"رجال من الصحابة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (23120) واللفظ له، والطبراني (10/26) (9814)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"S9hiIidG"},{"id":"س-04466","fp":"ef772786ff56","stateId":467,"easy":"إذا حججت حجة مبرورة أو اعتمرت ← فهما من أفضل الأعمال","cause":"حِجَّةٌ مَبرورةٌ، أو عُمْرةٌ","result":"ثُمَّ عَمَلانِ هما أفضَلُ الأعمالِ إِلَّا مَن عَمِلَ بمِثْلِهما","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"تخريج شرح الطحاوية 494","srcLabel":"ابن ماجه","text":["قال رجلٌ: يا رسولَ اللهِ، ما الإسلامُ؟ قال: (أن يُسلِمَ قَلبُكَ للهِ عزَّ وجلَّ، وأن يَسلَمَ المسلِمون مِن لِسانِك ويَدِك)، قال: فأيُّ الإسلامِ أفضَلُ؟ قال: (الإيمانُ)، قال: وما الإيمانُ؟ قال: (تُؤمِنُ باللهِ وملائكتِه وكُتبِه ورُسلِه والبعثِ بعدَ الموتِ)، قال: فأيُّ الإيمانِ أفضَلُ؟ قال: (الهجرةُ)، قال: فما الهِجْرةُ؟ قال: (تهجُرُ السُّوءَ)، قال: فأيُّ الهجرةِ أفضَلُ؟ قال: (الجهادُ)، قال: وما الجهادُ؟ قال: (أن تُقاتِلَ الكُفَّارَ إذا لَقِيتَهم)، قال: فأيُّ الجهادِ أفضلُ؟ قال: (مَن عقَرَ جَوادَه، وأُهْرِيقَ دَمُه)، قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: (",["ثُمَّ عَمَلانِ هما أفضَلُ الأعمالِ إِلَّا مَن عَمِلَ بمِثْلِهما",2],": ",["حِجَّةٌ مَبرورةٌ، أو عُمْرةٌ",1],"."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"إسناده صحيح إن كان أبو قلابة سمعه من عمرو بن عبسة","takhrij":"أخرجه من طرق ابن ماجه (2794) مختصراً، وأحمد (17027) واللفظ له","bab":"جهاد › فضل الجهاد","dorar":"00HDd8XT"},{"id":"س-02259","fp":"f7600d06d4c8","stateId":467,"easy":"إذا آمنت بالله وجاهدت في سبيله ← فهو خير العمل","cause":"إيمانٌ باللَّهِ وجِهادٌ في سبيلِ اللَّهِ عزَّ وجلَّ","result":"أيُّ العملِ خيرٌ قالَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"similar":["س-01677"],"ref":"صحيح النسائي 3129","srcLabel":"البخاري","text":["أنَّهُ سألَ نبىَّ اللَّهِ صلى الله عليه وسلم ",["أيُّ العملِ خيرٌ قالَ",2],": ",["إيمانٌ باللَّهِ وجِهادٌ في سبيلِ اللَّهِ عزَّ وجلَّ.",1]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه النسائي (3129) بلفظه، والبخاري (2518)، وأحمد (21500) كلاهما بزيادة في لفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"NuQm9DBh"},{"id":"س-01677","fp":"1eca16e39dbb","stateId":467,"easy":"إذا آمنت بالله وجاهدت في سبيله ← فهو أفضل الأعمال","cause":"إيمانٌ باللَّهِ عزَّ وجلَّ، وجهادٌ في سبيلِهِ","result":"فأيُّ الأعمالِ أفضَلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-02259","ref":"النوافح العطرة 227","text":["قُلِ الحقَّ وإن كان مُرًّا [يعني حديث: دخَلتُ علَى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وهو في المسجِدِ جالِسٌ، فاغتَنَمتُ خلوتَهُ، وحدَهُ، فجلَستُ إليهِ، فقالَ : أبا ذَرٍّ ! إن لِلمَسجِد تَحيَّةً، وإنَّ تحيَّتَهُ ركعتان فقُم فاركَعهما، قالَ : فقُمت فركَعتُها ثم عُدتُ فجلَستُ إليهِ، فقُلتُ : يا رسولَ اللهِ ! إنَّكَ أمَرتَني بالصَّلاةِ فما الصَّلاةُ ؟ قال : خيرٌ موضوعٌ استكثِرْ أو استَقِلَّ. قلتُ : يا رسولَ اللهِ ! ",["فأيُّ الأعمالِ أفضَلُ",2]," ؟ قال : ",["إيمانٌ باللَّهِ عزَّ وجلَّ، وجهادٌ في سبيلِهِ",1],"، قال : قلتُ : يا رسولَ اللهِ ! فأيُّ المؤمنينَ أكمَلُهم إيمانًا ؟ قالَ : أحسَنُهُم خُلُقًا. قالَ : قلتُ : يا رسولَ اللَّهِ ! فأيُّ المؤمنينَ أسلَمُ ؟ قالَ : مَن سلِمَ النَّاسُ من لسانِهِ ويدِهِ. قال : قلتُ : يا رسولَ اللَّهِ ! فأيُّ الهجرةِ أفضَلُ ؟ قال : مَن هجرَ السَّيِّئاتِ. قالَ : قُلتُ : يا رسولَ اللهِ ! فأيُّ الصَّلاةِ أفضَلُ ؟ قال : طولُ القنوتِ . قال : قلتُ : يا رسولَ اللهِ ! فما الصِّيامُ ؟ قالَ : فرضٌ مَجزيٌّ ، وعندَ اللهِ أضعافٌ كثيرةٌ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ الجهادِ أفضَلُ ؟ قالَ : مَن عُقِرَ جوادُهُ وأهريقَ دمُهُ. قال : قُلتُ : يا رسولَ اللهِ ! فأيُّ الرِّقابِ أفضَلُ ؟ قالَ : أغلاها ثَمنًا وأنفَسُها عندَ ربِّها. قالَ : قلتُ : يا رسولَ اللهِ ! فأيُّ الصَّدقةِ أفضَلُ ؟ قال : جُهدٌ مِن مُقِلٍّ يُسَرُّ إلى فقيرٍ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ آيةٍ مِمَّا أنزلَ اللهُ عزَّ وجلَّ عليكَ أعظَمُ ؟ قال : آيةُ الكُرسيِّ. ثُمَّ قالَ : يا أبا ذَرٍّ ! ما السَّماواتُ السَّبعُ معَ الكُرسيِّ إلا كَحلقَةٍ مُلقاةٍ بأرضِ فلاةٍ، وفَضلُ العَرشِ على الكُرسيِّ كفَضلِ الفَلاةِ علَى الحَلقَةِ. قلتُ : يا رسولَ اللهِ ! كم الأنبياءُ ؟ قال : مائةُ ألفٍ وأربعةٌ وعِشرونَ ألفًا. قلتُ : يا رسولَ اللهِ ! كم الرُّسلِ ؟ قالَ : ثلاثُمائةٍ وثلاثَةُ عشرَ جَمًّا غفيرًا. قلتُ : كثيرٌ طيِّبٌ، قلتُ : يا رسولَ اللهِ ! مَن كان أوَّلُهمْ ؟ قال : آدَمُ. قلتُ : يا رسولَ اللهِ ! أنَبيٌّ مُرسَلٌ ؟ قال : نعَم، خلقَهُ اللهُ بيدِهِ، ونفخَ فيهِ مِن روحِهِ، ثُمَّ سوَّاهُ قِبَلًا. وقال أحمدُ بنُ أنَسٍ ثُمَّ كلَّمهُ قِبَلًا. ثُمَّ قالَ : يا أبا ذَرٍّ ! أربعةٌ سُريانيُّونَ؛ آدَمُ، وشيثُ، وخَنوخُ - وهو إدريسُ، وهم أوَّلُ مَن خطَّ بالقلَمِ - ونوحٌ. وأربعةٌ من العَربِ؛ هودٌ، وصالِحٌ، وشُعَيبٌ، ونبيُّكَ يا أبا ذَرٍّ. قال : قلتُ : يا رسولَ اللهِ ! كَم كتابٌ أنزلَهُ اللَّهُ تعالى ؟ قال : مائةُ كتابٍ وأربعةُ كتُبٍ، أنزلَ علَى شيثَ خَمسونَ صحيفَةً، وأنزلَ علَى خَنوخَ ثلاثونَ صَحيفةً، وأنزلَ على إبراهيمَ عشرَ صحائفَ، وأنزلَ على موسَى قبلَ التَّوراةِ عَشرَ صحائفَ، وأنزلَ التَّوراةَ والإنجيلَ والزَّبورَ والفُرقانَ. قال : قلتُ : يا رسولَ اللهِ ! فَما كانَت صُحفُ إبراهيمَ ؟ قالَ : كانَت أمثالًا كلُّها : أيُّها الملِكُ المسلَّطُ المبتَلَى المغرورُ، فإنِّي لم أبعثْكَ لتجمَعَ الدُّنيا بعضَها إلى بعضٍ، ولكن بعثتُكَ لترُدَّ عنِّي دعوةَ المظلومِ، فإنِّي لا أردُّها ولَو كانَت مِن كافِرٍ. وكانَت فيها أمثالٌ : علَى العاقِلِ ما لَم يكُن مغلوبًا علَى عقلِهِ أن تكونَ له ساعاتٌ؛ ساعَةٌ يُناجي فيها ربَّهُ عزَّ وجلَّ، وساعةٌ يحاسِبُ فيها نفسَهُ، وساعَةٌ يفكِّرُ فيها في صُنعِ اللَّهِ عزَّ وجلَّ، وساعةٌ يخلو فيها بحاجتِهِ من المطعَمِ والمشرَبِ، وعلى العاقلِ أن لا يكون ظاعِنًا إلَّا لثلاثٍ؛ تزوُّدٍ لمعادٍ، أو مرمَّةٍ لمعاشٍ، أو لذَّةٍ في غيرِ محرَّمٍ، وعلى العاقِلِ أن يكونَ بصيرًا بزمانِهِ، مقبِلًا على شأنِهِ، حافِظًا للسانِهِ، ومن حسَبَ كلامَهُ من عمَلِهِ قلَّ كلامُهُ إلا فيما يعنيهِ. قلتُ : يا رسولَ اللَّهِ ! فما كان صحُفُ موسَى عليهِ السَّلامُ ؟ قال : كانَت عبرًا كلَّها، عجبتُ لمن أيقنَ بالموتِ ثُمَّ هو يفرَحُ، عجبتُ لمن أيقنَ بالنَّارِ وهو يضحَكُ، عجبتُ لمن أيقنَ للقدرِ ثم هو ينصَبُ، عجبتُ لمن رأى الدُّنيا وتقلُّبَها ثُمَّ اطمأنَّ إليها، عجِبتُ لمن أيقنَ بالحسابِ غدًا ثُمَّ لا يعمَلُ. قلتُ : يا رسولَ اللهِ ! أوصِني. قال : أوصيكَ بتقوى اللهِ فإنَّهُ رأسُ الأمرِ كلِّهِ، قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بتلاوَةِ القرآنِ فإنَّهُ نور لكَ في الأرضِ وذكرٌ لكَ في السَّماءِ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : إيَّاكَ وكثرةَ الضَّحِكِ فإنَّهُ يُميتُ القَلبَ، ويَذهَبُ بنورِ الوَجهِ، قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : عليكَ بالصَّمتِ إلَّا مِن خيرٍ، فإنَّهُ مطردَةٌ للشَّيطانِ عنكَ، وعونٌ لكَ علَى أمر دينِكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بالجهادِ فإنَّهُ رهبانيَّةُ أمَّتي. قلتُ : يا رسولَ اللهِ ! زِدني. قال : حبُّ المساكينِ وجالِسهُم. قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : انظُر إلى مَن تحتَكَ ولا تنظُر إلى مَن فوقكَ فإنَّهُ أجدَرُ أن لا تَزدَري نِعمةَ اللهِ عندكَ. قلتُ : زِدني يا رسولَ اللهِ ! قال : صِلْ قرابَتَكَ وإن قَطعوكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : لا تَخَف في اللَّهِ تعالى لَومَةَ لائمٍ. قلتُ : يا رسولَ اللهِ ! زِدني. قالَ : قُل الحقَّ وإن كان مُرًّا. قلتُ : يا رسولَ اللهِ ! زِدني. قال : يردُّكَ عن النَّاسِ ما تعرفُ من نفسِكَ، ولا تجِد عليهِم فيما تأتي، وكفَى به عيبًا أن تعرِفَ من النَّاسِ ما تجهَلُ من نفسِكَ، أو تجِدُ عليهِم فيما تأتي. ثُمَّ ضربَ بيدِهِ علَى صدري، فقالَ : يا أبا ذَرٍّ ! لا عقلَ كالتَّدبيرِ، ولا ورعَ كالكَفِّ، ولا حسَبَ كحُسنِ الخُلُقِ، قلتُ : يارسولَ اللهِ ! هل لي في الدُّنيا شَيءٌ مِمَّا أنزلَ اللهُ عليكَ مِمَّا كان في صحُفِ إبراهيمَ وموسَى ؟ قال : يا أبا ذَرٍّ ! اقرَأ : ? قَد أفلَحَ مَن تزَكَّى? إلى آخرِ السُّورَةِ]"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مطولاً أحمد (21415)، والبزار (3966) باختلاف يسير، وابن حبان (361) واللفظ له","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"wZID7EAR","merged":14,"otherRefs":["تخريج المسند لشعيب 27096 (صحيح)","تخريج المسند لشعيب 23783 (صحيح)","إتحاف الخيرة المهرة 1/63 (حسن)","جامع المسانيد والسنن 5701 (صحيح)","تخريج المسند لشعيب 10878 (حسن)","تخريج المسند لشعيب 21500 (صحيح)","صحيح البخاري 2518 (صحيح)","صحيح الجامع 1124 (صحيح)","صحيح الأدب المفرد 162 (صحيح)","صحيح مسلم 83 (صحيح)","صحيح مسلم 84 (صحيح)","صحيح النسائي 2623 (صحيح)","صحيح البخاري 26 (صحيح)"]},{"id":"س-03218","fp":"b2f14260b010","stateId":467,"easy":"إذا آمنت بالله ثم جاهدت ثم حججت حجة مبرورة ← فهي أفضل الأعمال","cause":"إيمانٌ باللهِ وحدَه، ثُمَّ الجِهادُ، ثُمَّ حَجَّةٌ بَرَّةٌ تَفضُلُ سائِرَ الأعمالِ كما بَينَ مَطلَعِ الشَّمسِ إلى مَغرِبِها","result":"أيُّ الأعمالِ أفضَلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"مشارع الأشواق 65","srcLabel":"أحمد","text":["عَنِ النَّبيِّ (أنَّه: سُئِلَ ",["أيُّ الأعمالِ أفضَلُ",2],"؟ قال: ",["إيمانٌ باللهِ وحدَه، ثُمَّ الجِهادُ، ثُمَّ حَجَّةٌ بَرَّةٌ تَفضُلُ سائِرَ الأعمالِ كما بَينَ مَطلَعِ الشَّمسِ إلى مَغرِبِها)",1]],"grade":"صحيح","narrator":"ماعز","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (19010)، وابن الجوزي في ((جامع المسانيد)) (6133)، وابن الأثير في ((أسد الغابة)) (5/ 7) واللفظ لهم.","bab":"إيمان › فضل الإيمان","dorar":"yWzRbz0B","merged":2,"otherRefs":["الإصابة في تمييز الصحابة 3/337 (حسن)"]},{"id":"س-01142","fp":"a1c522e7e5af","stateId":467,"easy":"إذا لزمت الإيمان ليلاً ونهاراً ولسانك رطب بذكر الله ← فهو أفضل العمل","cause":"إيمانٌ ملزومٌ باللَّيلِ والنَّهارِ وأن لا يزالَ لسانُ أحدِكم رطبًا من ذكرِ اللهِ","result":"وأفضلُ من ذلك","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"الترغيب والترهيب 2/326","srcLabel":"أحمد","text":["قيل لأبي الدَّرداءِ رضِي اللهُ عنه إنَّ رجلًا أعتق مائةَ نسمةٍ قال إنَّ مائةَ نسمةٍ من مالِ رجلٍ لكثيرٌ ",["وأفضلُ من ذلك",2]," ",["إيمانٌ ملزومٌ باللَّيلِ والنَّهارِ وأن لا يزالَ لسانُ أحدِكم رطبًا من ذكرِ اللهِ",1]],"grade":"حسن","narrator":"سالم بن أبي الجعد","muhaddith":"إسناده حسن","takhrij":"أخرجه الضبي في ((الدعاء)) (91) واللفظ له، وأحمد في ((الزهد)) (735)، وابن أبي شيبة (36205)، والبيهقي في ((شعب الإيمان)) (618) وقالوا:\"محرر\" بدلًا من:\"نسمة\".","bab":"أدعية وأذكار › فضل الذكر","dorar":"GQ8zkr4U"},{"id":"س-07232","fp":"a19f571c70d5","stateId":467,"easy":"إذا صليت الصلاة في أول وقتها ← فهو أفضل الأعمال","cause":"الصَّلاةُ لأوَّلِ وقتِها","result":"أفضَلِ الأعمالِ","explicit":true,"otherNeedIds":[23],"ref":"تخريج المسند لشعيب 27476","srcLabel":"أحمد","text":["عن أُمِّ فروةَ، أنَّها سَمِعَت رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، وسَألَه رَجُلٌ عن ",["أفضَلِ الأعمالِ",2],"؟ فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: «",["الصَّلاةُ لأوَّلِ وقتِها",1],"»."],"grade":"صحيح","narrator":"أم فروة","muhaddith":"صحيح لغيره","bab":"علم › حسن السؤال ونصح العالم","dorar":"ZHOETdcV","merged":4,"otherRefs":["الفتح الرباني 2/639 (صحيح)","المصابيح في الأحاديث المتواترة 595 (صحيح)","تخريج المسند لشعيب 27105 (صحيح)"]},{"id":"س-06468","fp":"81f4ead61d95","stateId":468,"easy":"إذا صليت في جوف الليل وصمت المحرم ← فهما أفضل الصلاة والصيام بعد الفريضة","cause":"بعدَ المَكْتوبةِ الصَّلاةُ في جَوفِ اللَّيلِ، وأفضَلُ الصِّيامِ بعدَ شَهْرِ رمضانَ شَهْرُ اللَّهِ المحرَّمُ","result":"أفضَلُ الصَّلاةِ","explicit":true,"star":true,"apply":{"k":"time","t":"في الليل"},"similar":["س-06459"],"ref":"صحيح ابن خزيمة 2/ 312","srcLabel":"مسلم","text":["عن أبي هُرَيْرةَ، يرفعُهُ إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ، [وفي روايةٍ يرفعُهُ] قالَ: سُئلَ أيُّ صلاةٍ أفضلُ بعدَ المَكْتوبةِ؟ وأيُّ الصِّيامِ أفضلُ بعدَ شَهْرِ رمضانَ؟ فقالَ: ",["أفضَلُ الصَّلاةِ",2],[" بعدَ المَكْتوبةِ الصَّلاةُ في جَوفِ اللَّيلِ، وأفضَلُ الصِّيامِ بعدَ شَهْرِ رمضانَ شَهْرُ اللَّهِ المحرَّمُ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (1163)، وأحمد (8026)، والنسائي في ((الكبرى)) (2918) باختلاف يسير.","bab":"صلاة › فرض الصلاة","dorar":"47JCDmmk","merged":2,"otherRefs":["صحيح النسائي 1613 (صحيح)"]},{"id":"س-01681","fp":"1b4092d336d0","stateId":468,"easy":"إذا أطلت القنوت (القيام) ← فهي أفضل الصلاة","cause":"طولُ القنوتِ","result":"فأيُّ الصَّلاةِ أفضَلُ","explicit":true,"similar":["س-04543"],"ref":"النوافح العطرة 227","srcLabel":"أحمد","text":["قُلِ الحقَّ وإن كان مُرًّا [يعني حديث: دخَلتُ علَى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وهو في المسجِدِ جالِسٌ، فاغتَنَمتُ خلوتَهُ، وحدَهُ، فجلَستُ إليهِ، فقالَ : أبا ذَرٍّ ! إن لِلمَسجِد تَحيَّةً، وإنَّ تحيَّتَهُ ركعتان فقُم فاركَعهما، قالَ : فقُمت فركَعتُها ثم عُدتُ فجلَستُ إليهِ، فقُلتُ : يا رسولَ اللهِ ! إنَّكَ أمَرتَني بالصَّلاةِ فما الصَّلاةُ ؟ قال : خيرٌ موضوعٌ استكثِرْ أو استَقِلَّ. قلتُ : يا رسولَ اللهِ ! فأيُّ الأعمالِ أفضَلُ ؟ قال : إيمانٌ باللَّهِ عزَّ وجلَّ، وجهادٌ في سبيلِهِ، قال : قلتُ : يا رسولَ اللهِ ! فأيُّ المؤمنينَ أكمَلُهم إيمانًا ؟ قالَ : أحسَنُهُم خُلُقًا. قالَ : قلتُ : يا رسولَ اللَّهِ ! فأيُّ المؤمنينَ أسلَمُ ؟ قالَ : مَن سلِمَ النَّاسُ من لسانِهِ ويدِهِ. قال : قلتُ : يا رسولَ اللَّهِ ! فأيُّ الهجرةِ أفضَلُ ؟ قال : مَن هجرَ السَّيِّئاتِ. قالَ : قُلتُ : يا رسولَ اللهِ ! ",["فأيُّ الصَّلاةِ أفضَلُ",2]," ؟ قال : ",["طولُ القنوتِ",1]," . قال : قلتُ : يا رسولَ اللهِ ! فما الصِّيامُ ؟ قالَ : فرضٌ مَجزيٌّ ، وعندَ اللهِ أضعافٌ كثيرةٌ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ الجهادِ أفضَلُ ؟ قالَ : مَن عُقِرَ جوادُهُ وأهريقَ دمُهُ. قال : قُلتُ : يا رسولَ اللهِ ! فأيُّ الرِّقابِ أفضَلُ ؟ قالَ : أغلاها ثَمنًا وأنفَسُها عندَ ربِّها. قالَ : قلتُ : يا رسولَ اللهِ ! فأيُّ الصَّدقةِ أفضَلُ ؟ قال : جُهدٌ مِن مُقِلٍّ يُسَرُّ إلى فقيرٍ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ آيةٍ مِمَّا أنزلَ اللهُ عزَّ وجلَّ عليكَ أعظَمُ ؟ قال : آيةُ الكُرسيِّ. ثُمَّ قالَ : يا أبا ذَرٍّ ! ما السَّماواتُ السَّبعُ معَ الكُرسيِّ إلا كَحلقَةٍ مُلقاةٍ بأرضِ فلاةٍ، وفَضلُ العَرشِ على الكُرسيِّ كفَضلِ الفَلاةِ علَى الحَلقَةِ. قلتُ : يا رسولَ اللهِ ! كم الأنبياءُ ؟ قال : مائةُ ألفٍ وأربعةٌ وعِشرونَ ألفًا. قلتُ : يا رسولَ اللهِ ! كم الرُّسلِ ؟ قالَ : ثلاثُمائةٍ وثلاثَةُ عشرَ جَمًّا غفيرًا. قلتُ : كثيرٌ طيِّبٌ، قلتُ : يا رسولَ اللهِ ! مَن كان أوَّلُهمْ ؟ قال : آدَمُ. قلتُ : يا رسولَ اللهِ ! أنَبيٌّ مُرسَلٌ ؟ قال : نعَم، خلقَهُ اللهُ بيدِهِ، ونفخَ فيهِ مِن روحِهِ، ثُمَّ سوَّاهُ قِبَلًا. وقال أحمدُ بنُ أنَسٍ ثُمَّ كلَّمهُ قِبَلًا. ثُمَّ قالَ : يا أبا ذَرٍّ ! أربعةٌ سُريانيُّونَ؛ آدَمُ، وشيثُ، وخَنوخُ - وهو إدريسُ، وهم أوَّلُ مَن خطَّ بالقلَمِ - ونوحٌ. وأربعةٌ من العَربِ؛ هودٌ، وصالِحٌ، وشُعَيبٌ، ونبيُّكَ يا أبا ذَرٍّ. قال : قلتُ : يا رسولَ اللهِ ! كَم كتابٌ أنزلَهُ اللَّهُ تعالى ؟ قال : مائةُ كتابٍ وأربعةُ كتُبٍ، أنزلَ علَى شيثَ خَمسونَ صحيفَةً، وأنزلَ علَى خَنوخَ ثلاثونَ صَحيفةً، وأنزلَ على إبراهيمَ عشرَ صحائفَ، وأنزلَ على موسَى قبلَ التَّوراةِ عَشرَ صحائفَ، وأنزلَ التَّوراةَ والإنجيلَ والزَّبورَ والفُرقانَ. قال : قلتُ : يا رسولَ اللهِ ! فَما كانَت صُحفُ إبراهيمَ ؟ قالَ : كانَت أمثالًا كلُّها : أيُّها الملِكُ المسلَّطُ المبتَلَى المغرورُ، فإنِّي لم أبعثْكَ لتجمَعَ الدُّنيا بعضَها إلى بعضٍ، ولكن بعثتُكَ لترُدَّ عنِّي دعوةَ المظلومِ، فإنِّي لا أردُّها ولَو كانَت مِن كافِرٍ. وكانَت فيها أمثالٌ : علَى العاقِلِ ما لَم يكُن مغلوبًا علَى عقلِهِ أن تكونَ له ساعاتٌ؛ ساعَةٌ يُناجي فيها ربَّهُ عزَّ وجلَّ، وساعةٌ يحاسِبُ فيها نفسَهُ، وساعَةٌ يفكِّرُ فيها في صُنعِ اللَّهِ عزَّ وجلَّ، وساعةٌ يخلو فيها بحاجتِهِ من المطعَمِ والمشرَبِ، وعلى العاقلِ أن لا يكون ظاعِنًا إلَّا لثلاثٍ؛ تزوُّدٍ لمعادٍ، أو مرمَّةٍ لمعاشٍ، أو لذَّةٍ في غيرِ محرَّمٍ، وعلى العاقِلِ أن يكونَ بصيرًا بزمانِهِ، مقبِلًا على شأنِهِ، حافِظًا للسانِهِ، ومن حسَبَ كلامَهُ من عمَلِهِ قلَّ كلامُهُ إلا فيما يعنيهِ. قلتُ : يا رسولَ اللَّهِ ! فما كان صحُفُ موسَى عليهِ السَّلامُ ؟ قال : كانَت عبرًا كلَّها، عجبتُ لمن أيقنَ بالموتِ ثُمَّ هو يفرَحُ، عجبتُ لمن أيقنَ بالنَّارِ وهو يضحَكُ، عجبتُ لمن أيقنَ للقدرِ ثم هو ينصَبُ، عجبتُ لمن رأى الدُّنيا وتقلُّبَها ثُمَّ اطمأنَّ إليها، عجِبتُ لمن أيقنَ بالحسابِ غدًا ثُمَّ لا يعمَلُ. قلتُ : يا رسولَ اللهِ ! أوصِني. قال : أوصيكَ بتقوى اللهِ فإنَّهُ رأسُ الأمرِ كلِّهِ، قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بتلاوَةِ القرآنِ فإنَّهُ نور لكَ في الأرضِ وذكرٌ لكَ في السَّماءِ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : إيَّاكَ وكثرةَ الضَّحِكِ فإنَّهُ يُميتُ القَلبَ، ويَذهَبُ بنورِ الوَجهِ، قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : عليكَ بالصَّمتِ إلَّا مِن خيرٍ، فإنَّهُ مطردَةٌ للشَّيطانِ عنكَ، وعونٌ لكَ علَى أمر دينِكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بالجهادِ فإنَّهُ رهبانيَّةُ أمَّتي. قلتُ : يا رسولَ اللهِ ! زِدني. قال : حبُّ المساكينِ وجالِسهُم. قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : انظُر إلى مَن تحتَكَ ولا تنظُر إلى مَن فوقكَ فإنَّهُ أجدَرُ أن لا تَزدَري نِعمةَ اللهِ عندكَ. قلتُ : زِدني يا رسولَ اللهِ ! قال : صِلْ قرابَتَكَ وإن قَطعوكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : لا تَخَف في اللَّهِ تعالى لَومَةَ لائمٍ. قلتُ : يا رسولَ اللهِ ! زِدني. قالَ : قُل الحقَّ وإن كان مُرًّا. قلتُ : يا رسولَ اللهِ ! زِدني. قال : يردُّكَ عن النَّاسِ ما تعرفُ من نفسِكَ، ولا تجِد عليهِم فيما تأتي، وكفَى به عيبًا أن تعرِفَ من النَّاسِ ما تجهَلُ من نفسِكَ، أو تجِدُ عليهِم فيما تأتي. ثُمَّ ضربَ بيدِهِ علَى صدري، فقالَ : يا أبا ذَرٍّ ! لا عقلَ كالتَّدبيرِ، ولا ورعَ كالكَفِّ، ولا حسَبَ كحُسنِ الخُلُقِ، قلتُ : يارسولَ اللهِ ! هل لي في الدُّنيا شَيءٌ مِمَّا أنزلَ اللهُ عليكَ مِمَّا كان في صحُفِ إبراهيمَ وموسَى ؟ قال : يا أبا ذَرٍّ ! اقرَأ : ? قَد أفلَحَ مَن تزَكَّى? إلى آخرِ السُّورَةِ]"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مطولاً أحمد (21415)، والبزار (3966) باختلاف يسير، وابن حبان (361) واللفظ له","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"wZID7EAR","merged":4,"otherRefs":["الحديث لابن عبدالوهاب 1/555 (صحيح)","تخريج المسند لشعيب 19435 (صحيح)","تخريج صحيح ابن حبان 1758 (صحيح)"]},{"id":"س-04543","fp":"ef603d87c359","stateId":468,"easy":"إذا أطلت القيام في الصلاة ← فهي أفضل الصلاة","cause":"طولُ القِيامِ","result":"فأيُّ الصَّلاةِ أَفْضَلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-01681","ref":"الأحاديث المختارة 9 / 235","text":["«أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ سُئِلَ: أيُّ الأعْمالِ أفْضَلُ؟ قالَ: إيمانٌ لا شَكَّ فيه، وجِهادٌ لا غُلولَ فيه، وحَجَّةٌ مَبْرورةٌ، قيلَ: ",["فأيُّ الصَّلاةِ أَفْضَلُ",2],"؟ قالَ: ",["طولُ القِيامِ",1],"، قيلَ: فأيُّ الصَّدَقةِ أَفْضَلُ؟ قالَ: جُهْدُ المُقِلِّ، قيلَ: فأيُّ الهِجْرةِ أَفْضَلُ؟ قالَ: مَن هَجَرَ ما حَرَّمَ اللهُ عليه، قيلَ: فأيُّ الجِهادِ أَفْضَلُ؟ قالَ: مَن جاهَدَ المُشْرِكينَ بمالِه ونَفْسِه، قيلَ: فأيُّ القَتْلِ أَشْرَفُ؟ قالَ: مَن أُهريقَ دَمُه وعُقِرَ جَوادُه»."],"grade":"صحيح","narrator":"عبدالله بن حبشي الخثعمي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"جهاد › فضل الشهيد","dorar":"sLHD6VNX"},{"id":"س-06459","fp":"fa7457c8c876","stateId":468,"easy":"إذا صليت في جوف الليل ← فهي أفضل الصلاة بعد المكتوبة","cause":"الصَّلاةُ مِن جوفِ اللَّيلِ","result":"أيُّ الصَّلاةِ أفضلُ بعدَ المَكْتوبةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"في الليل"},"repOf":"س-06468","otherNeedIds":[47],"ref":"المحلى 2/229","text":["جاء رجلٌ إلى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ ، فقالَ : يا رسولَ اللَّهِ ، ",["أيُّ الصَّلاةِ أفضلُ بعدَ المَكْتوبةِ",2]," ؟ قالَ : ",["الصَّلاةُ مِن جوفِ اللَّيلِ",1]," قالَ : أيُّ الصِّيامِ أفضلُ بعدَ ؟ قالَ : شَهْرُ اللَّهِ الَّذي يدعونَهُ المُحرَّمَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"احتج به ، وقال في المقدمة: (لم نحتج إلا بخبر صحيح من رواية الثقات مسند)","takhrij":"أخرجه مسلم (1163)، وأحمد (8013)، والنسائي في ((السنن الكبرى)) (2906) مطولاً، وابن ماجه (1742) مختصراً، وابن حزم في ((المحلى)) (2/229) واللفظ له.","bab":"صلاة › فرض الصلاة","dorar":"myifR12A","merged":2,"otherRefs":["تخريج مشكل الآثار 1255 (صحيح)"]},{"id":"س-07058","fp":"87533b371dd1","stateId":468,"easy":"إذا أطلت الركوع والسجود ← فهو خير الصلاة","cause":"الرُّكوعُ والسُّجودُ","result":"أخيرَ الصَّلاةِ","explicit":true,"star":true,"apply":{"k":"time","t":"في السجود"},"ref":"صحيح ابن خزيمة 1/582","srcLabel":"متفق عليه","text":["جاءَ نَهيكُ بنُ سنانٍ إلى عبدِ اللَّهِ فقالَ: كيفَ تجدُ هذا الحرفَ {مِنْ مَاءٍ غَيْرِ آسِنٍ} أو يَاسِنٍ؟ فقالَ: أَكُلَّ القرآنِ أحصيتَ إلَّا هذا؟ قالَ: إنِّي لأقرأُ المفصَّلَ في رَكْعةٍ، فقالَ عبدُ اللَّهِ: هذًّا كَهَذِّ الشِّعرِ إنَّ أقوامًا يقرءونَ القرآنَ بألسِنتِهِم لا يعدو تراقيَهُم، ولَكِنَّهُ إذا دخلَ في قَلبٍ فرسخَ فيهِ نفعَ، وإنَّ ",["أخيرَ الصَّلاةِ",2]," ",["الرُّكوعُ والسُّجودُ",1],"، وإنِّي أعلمُ النَّظائرَ الَّتي كانَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقرأُ بِهِنَّ سورتينِ في رَكْعةٍ، ثمَّ أخذَ بيدِ علقمةَ فدخلَ ثمَّ خرجَ فعدَّهنَّ علَينا قالَ الأعمشُ: وَهيَ عشرونَ سورةً على تأليفِ عبدِ اللَّهِ أوَّلُهُنَّ الرَّحمنُ وآخرتُهُنَّ الدُّخانُ: الرَّحمنُ، والنَّجمُ، والذَّارياتُ، والطُّورُ هذِهِ النَّظائرُ، واقتَربتِ والحاقَّةُ، والواقِعةُ، ون والنَّازعاتُ وسَأَلَ سَائِلٌ، والمدَّثِّرُ، والمزَّمِّلُ، وويلٌ للمطفِّفينَ، وعَبَسَ ولا أُقْسِمُ، وَهَلْ أَتَى، والمرسلاتُ، وعمَّ يَتَسَاءَلونَ، وإذا الشَّمْسُ كُوِّرَتْ، والدُّخَانُ وفي روايةٍ إلى قولِهِ: فَدخلَ عَلقمةُ، فَسألَهُ، ثمَّ خَرجَ إلَينا، فقالَ: عِشرونَ سورَةً مِن أوَّلِ المفصَّلِ في تأليفِ عبدِ اللَّهِ لم يَزيدوا علَى هذا"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (722)، وأحمد (3607) بنحوه، والبخاري (742) مختصرا","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"f0brTVoX"},{"id":"س-02046","fp":"1d13d6e2b348","stateId":468,"easy":"إذا صليت ← فالصلاة خير أعمالك","cause":"الصَّلاةَ","result":"خيرَ أعمالِكُم","explicit":true,"similar":["س-06500","س-06560"],"ref":"صحيح الترغيب 379","srcLabel":"ابن ماجه","text":["استَقيموا و لَن تُحْصُوا ، و اعلَموا أنَّ ",["خيرَ أعمالِكُم",2]," ",["الصَّلاةَ",1]," ، و لَن يحافِظَ علَى الوُضوءِ إلَّا مُؤمِنٌ"],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (277)، وأحمد (22378)، والدارمي (681)، وابن المبارك في ((الزهد والرقائق)) (1040) واللفظ لهم.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"WryGcU0k","merged":3,"otherRefs":["إرواء الغليل 412 (صحيح)","كفاية المستقنع لأدلة المقنع 248 (صحيح)"]},{"id":"س-06500","fp":"e5d5bab2d6e0","stateId":468,"easy":"إذا صليت ← فالصلاة من أفضل الأعمال","cause":"الصلاةُ","result":"أفضلِ الأعمالِ","explicit":true,"repOf":"س-02046","ref":"تخريج المسند لشاكر 10/105","text":["إن رجلا جاءَ إلى النبي صلى الله عليه وسلم فسأَلهُ عن ",["أفضلِ الأعمالِ",2]," فقال رسولُ اللهِ صلى الله عليه وسلم : ",["الصلاةُ",1]," ثم قال مَهْ قال الصلاةُ ثم قال مَهْ قال الصلاةُ ثلاث مرات قال فلما غلبَ عليه قال رسولُ اللهِ صلى الله عليه وسلم الجِهَادُ في سبيلِ الله قال الرجل فإن لِي والدينِ قال رسولُ اللهِ صلى الله عليه وسلم آمركَ بالوالدينِ خيرا قال والذي بعثكَ بالحق نبيا لأُجاهدَنّ ولأتركنهُما قال رسولُ اللهِ صلى الله عليه وسلم أنت أعْلَم"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (2/ 172)، وابن حبان (5/ 8) باختلاف يسير عنده. والمروزي في ((تعظيم قدر الصلاة)) (1/ 205) ببعضه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"KFaqGrxE"},{"id":"س-06560","fp":"58610a7200b2","stateId":468,"easy":"إذا صليت ← فالصلاة أفضل أعمالك","cause":"الصَّلاةُ","result":"أنَّ أفضلَ أعمالِكمُ","explicit":true,"repOf":"س-02046","ref":"صحيح الترغيب 380","text":["و اعلَموا ",["أنَّ أفضلَ أعمالِكمُ",2]," ",["الصَّلاةُ",1]],"grade":"صحيح","narrator":"سلمة بن الأكوع","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني (7/ 25) (6270)، والعقيلي (4/ 167) واللفظ لهما وفي أوله زيادة.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"LCvWcKC1"},{"id":"س-00737","fp":"0660ad33833c","stateId":468,"easy":"إذا حافظت على الفرائض (للمرأة) ← فهي أفضل الجهاد","cause":"وحافظي على الفرائضِ","result":"فإنها أفضلُ الجهادِ","explicit":true,"similar":["س-06624"],"ref":"المتجر الرابح 203","srcLabel":"الطبراني","text":["عن أمِّ أنسٍ رضي الله عنهما أنها قالت: يا رسولَ اللهِ أوصني قال: اهجري المعاصيَ فإنها أفضلُ الهجرةِ ",["وحافظي على الفرائضِ",1]," ",["فإنها أفضلُ الجهادِ",2]," وأكثري من ذكرِ اللهِ فإنك لا تأتين اللهَ بشيءٍ أحبَّ إليه من كثرةِ ذكرِه."],"grade":"حسن","narrator":"أم سليم بنت ملحان أم أنس بن مالك","muhaddith":"إسناده جيد","takhrij":"أخرجه ابن أبي الدنيا في ((الورع)) (48)، والطبراني (25/129) (313)، وابن شاهين في ((الترغيب في فضائل الأعمال)) (164) باختلاف يسير","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"Up6VLEuB"},{"id":"س-07228","fp":"d09a01da2867","stateId":468,"easy":"إذا أطلت القنوت (القيام) ← فهو أفضل الصلاة","cause":"طولُ القُنوتِ","result":"أفْضَلِ الصَّلاةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"الأحاديث المختارة 2438","srcLabel":"متفق عليه","text":["«سُئِلَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ عن ",["أفْضَلِ الصَّلاةِ",2],"، قالَ: ",["طولُ القُنوتِ",1],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"علم › حسن السؤال ونصح العالم","dorar":"h2Weykp8"},{"id":"س-06624","fp":"ef76798da72e","stateId":468,"easy":"إذا حافظت على الصلاة ← فهي أفضل الأعمال","cause":"الصَّلاةُ ) قال : ثمَّ مَهْ ؟ قال : ( ثمَّ الصَّلاةُ ) قال : ثمَّ مَهْ ؟ قال : ( ثمَّ الصَّلاةُ","result":"عن أفضلِ الأعمالِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-00737","ref":"صحيح ابن حبان 1722","text":["أنَّ رجُلًا جاء إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فسأَله ",["عن أفضلِ الأعمالِ",2]," قال : فقال صلَّى اللهُ عليه وسلَّم : ( ",["الصَّلاةُ ) قال : ثمَّ مَهْ ؟ قال : ( ثمَّ الصَّلاةُ ) قال : ثمَّ مَهْ ؟ قال : ( ثمَّ الصَّلاةُ",1]," ) ثلاثَ مرَّاتٍ قال : ثمَّ مَهْ ؟ قال : ( ثمَّ الجهادُ في سبيلِ اللهِ ) قال : فإنَّ لي والدَيْنِ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ( آمُرُكَ بوالدَيْكَ خيرًا ) فقال : والَّذي بعَثكَ نَبيًّا لَأُجاهِدَنَّ ولَأترُكَنَّهما ) قال : فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ( فأنتَ أعلَمُ )"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (6602)، وأبو يعلى كما في ((إتحاف الخيرة المهرة)) للبوصيري (1/412) باختلاف يسير، ومحمد بن نصر المروزي في ((تعظيم قدر الصلاة)) (173) مختصراً","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"YFI20GIO"},{"id":"س-07206","fp":"41cd684912b9","stateId":468,"easy":"إذا قمت نصف الليل أو جوفه ← فهو أفضل القيام","cause":"نِصفُ اللَّيلِ أو جَوفُ اللَّيلِ","result":"أيُّ قِيامِ اللَّيلِ أفضَلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"تحفة المحتاج 1/424","srcLabel":"تحفة المحتاج","text":["سأَلتُ أبا ذَرٍّ رضي اللهُ عنه ",["أيُّ قِيامِ اللَّيلِ أفضَلُ",2]," قال سأَلتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم كما سأَلتَني فقال ",["نِصفُ اللَّيلِ أو جَوفُ اللَّيلِ",1]," وقليلٌ فاعِلُه"],"grade":"صحيح","narrator":"أبو مسلم الجذمي","muhaddith":"صحيح أو حسن [كما اشترط على نفسه في المقدمة]","bab":"علم › حسن السؤال ونصح العالم","dorar":"YnunfkTK"},{"id":"س-08424","fp":"4ff73840ec1c","stateId":469,"easy":"إذا أعطيت ← فاليد العليا خير من اليد السفلى","cause":"اليدُ العليا","result":"خيرٌ مِن اليدِ السُّفلى","explicit":true,"star":true,"ref":"صحيح ابن حبان 3220","srcLabel":"البخاري","text":["سأَلْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم فأعطاني ثمَّ سأَلْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم فأعطاني ثمَّ سأَلْتُه فأعطاني ثمَّ سأَلْتُ فأعطاني ثمَّ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ( يا حكيمُ بنَ حِزامٍ إنَّ هذا المالَ حُلْوةٌ خضِرةٌ فمَن أخَذه بسخاوة نفسٍ بورِك له فيه ومَن أخَذه بإشرافِ نفسٍ لم يُبارَكْ له فيه وكان كالَّذي يأكُلُ ولا يشبَعُ و",["اليدُ العليا",1]," ",["خيرٌ مِن اليدِ السُّفلى",2]," ) قال حكيمٌ: فقُلْتُ: يا رسولَ اللهِ والَّذي بعَثك بالحقِّ لا أرزَأُ أحدًا بعدَك شيئًا حتَّى أُفارقَ الدُّنيا قال عروةُ وسعيدٌ: فكان أبو بكرٍ يدعو حكيمًا فيُعطيه العطاءَ فيأبى ثمَّ كان عمرُ بنُ الخطَّابِ يُعطيه فيأبى فيقولُ عمرُ: إنِّي أُشهِدُكم يا معشرَ المسلِمينَ على حكيمِ بنِ حزامٍ أنِّي أعرِضُ عليه حقَّه الَّذي قُسِم له مِن هذا الفَيءِ فيأبى يأخُذُه قال: فلم يرزَأْ حكيمٌ أحدًا مِن النَّاسِ بعدَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم حتَّى توفِّي \nقال عروةُ وسعيدٌ: فكان أبو بكرٍ يدعو حكيمًا فيُعطيه العطاءَ فيأبى ثمَّ كان عمرُ بنُ الخطَّابِ يُعطيه فيأبى فيقولُ عمرُ: إنِّي أُشهِدُكم يا معشرَ المسلِمينَ على حكيمِ بنِ حِزامٍ أنِّي أعرِضُ عليه حقَّه الَّذي قُسِم له مِن هذا الفَيءِ فيأبى يأخُذُه قال: فلم يرزَأْ حكيمٌ أحدًا مِن النَّاسِ بعدَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم حتَّى توفِّي"],"grade":"صحيح","narrator":"حكيم بن حزام","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (1472) بلفظ مقارب، والترمذي (2463)، والنسائي (2603)","bab":"مناقب وفضائل › فضائل جمع من الصحابة والتابعين","dorar":"I6zFyIEk","merged":15,"otherRefs":["مسند عمر 1/37 (صحيح)","تخريج المسند لشعيب 7317 (صحيح)","صحيح البخاري 1429 (صحيح)","تخريج المسند لشعيب 6039 (صحيح)","صحيح الجامع 7834 (صحيح)","السلسلة الصحيحة 2473 (حسن)","صحيح مسلم 1033 (صحيح)","تخريج المسند لشعيب 4474 (صحيح)","التمهيد 15/250 (صحيح)","تخريج المسند لشاكر 9/157 (صحيح)","تخريج المسند لشعيب 15578 (صحيح)","تخريج المسند لشاكر 8/83 (صحيح)","مجموع الشروح الفقهية. 351/32 (حسن)","صحيح ابن حبان 4513 (صحيح)"]},{"id":"س-07368","fp":"777a9f0be1fd","stateId":469,"easy":"إذا تصدقت عن ظهر غنى ← فهي خير الصدقة","cause":"ما كان عنْ ظَهرِ غِنًى","result":"خَيرُ الصَّدَقةِ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 1527","srcLabel":"مسلم","text":["كُنَّا عِندَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ إذ جاءه رَجُلٌ بمِثلِ بَيضةٍ من ذَهَبٍ، فقالَ: يا رَسولَ اللهِ، أصَبتُ هذه من مَعدِنٍ فخُذْها فهي صَدَقةٌ ما أملِكُ غَيرَها، فأعرَضَ عنه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، ثمَّ أتاه من قِبَل رُكنِه الأيمَنِ، فقالَ مِثلَ ذلكَ، فأعرَضَ عنه، ثمَّ أتاه من قِبَلِ رُكنِه الأيسَرِ فأعرَضَ عنه، ثمَّ أتاه من خَلفِه، فأخَذَها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فخَذَفَه بها، فلو أصابَتْه لَأوجَعَتْه ولَعَقَرَتْه، فقالَ رسول اللهِ صلَّى اللهُ عليه وسلَّمَ: يَأتي أحَدُكُم بما يَملِكُ فيَقولُ: هذه صَدَقةٌ، ثمَّ يَقعُدُ يَستَكِفُّ النَّاسَ، ",["خَيرُ الصَّدَقةِ",2]," ",["ما كان عنْ ظَهرِ غِنًى",1],"."],"grade":"صحيح","narrator":"جابر بن عبدالله الأنصاري","muhaddith":"صحيح على شرط مسلم","bab":"فضائل النبي وصفته ودلائل النبوة › أحوال النبي","dorar":"T9V8vEGc","merged":10,"otherRefs":["صحيح الترغيب 881 (صحيح)","صحيح الجامع 3281 (صحيح)","المحلى 8/14 (صحيح)","تخريج المسند لشعيب 9613 (صحيح)","تخريج المسند لشعيب 15578 (صحيح)","تخريج المسند لشعيب 7348 (صحيح)","حلية الأولياء 2/207 (صحيح)","البدر المنير 7/415 (حسن)","تخريج شرح السنة 6/179 (صحيح)"]},{"id":"س-06303","fp":"bc3e352e3a43","stateId":469,"easy":"إذا تصدقت على قريبك المعادي لك ← فهي أفضل الصدقة","cause":"علَى ذي الرَّحمِ الكاشحِ","result":"أفضلُ الصَّدقةِ","explicit":true,"otherNeedIds":[47,37],"ref":"صحيح ابن خزيمة 4/ 132","srcLabel":"ابن خزيمة","text":["عن أمِّ كُلثومِ بنتِ عقبةَ قالَ سُفيانُ: وَكانَت قَد صلَّت معَ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ القبلتينِ قالَت قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: ",["أفضلُ الصَّدقةِ",2],[" علَى ذي الرَّحمِ الكاشحِ",1]],"grade":"صحيح","narrator":"أم كلثوم بنت عقبة","muhaddith":"أخرجه في صحيحه","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"4FXBbi3N","merged":2,"otherRefs":["تخريج المسند لشعيب 15320 (صحيح)"]},{"id":"س-00630","fp":"c3fc92bf9c2e","stateId":469,"easy":"إذا منحت ناقة أو شاة يُنتفع بلبنها ← فهي خير الصدقة تغدو بأجر وتروح بأجر","cause":"المَنيحةُ تغدو بأجرٍ ، وتروحُ بأجرٍ ، ومَنيحةُ النَّاقةِ كعتاقةِ الأحمرِ ، ومَنيحةُ الشَّاةِ كعتاقةِ الأسودِ","result":"خيرُ الصَّدقةِ","explicit":true,"ref":"تخريج المسند لشاكر 16/286","srcLabel":"أحمد","text":[["خيرُ الصَّدقةِ",2],[" المَنيحةُ تغدو بأجرٍ ، وتروحُ بأجرٍ ، ومَنيحةُ النَّاقةِ كعتاقةِ الأحمرِ ، ومَنيحةُ الشَّاةِ كعتاقةِ الأسودِ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"لم أقف عليه إلا عند الإمام أحمد في المسند","bab":"آداب عامة › ضرب الأمثال","dorar":"ruNTh0U3"},{"id":"س-02204","fp":"ca921ef3fcb6","stateId":469,"easy":"إذا أشبعت كبداً جائعة ← فهو أفضل الصدقة","cause":"أن تُشبِعَ كبِدًا جائعًا","result":"أفضلُ الصَّدقةِ","explicit":true,"ref":"الترغيب والترهيب 2/92","srcLabel":"البيهقي","text":[["أفضلُ الصَّدقةِ",2],[" أن تُشبِعَ كبِدًا جائعًا",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (3367)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"K4uuZwbB"},{"id":"س-06285","fp":"8b7c7c0e6b31","stateId":469,"easy":"إذا تصدقت وأنت مقلّ ← فهي خير الصدقة","cause":"خيرُ الصَّدقةِ","result":"صدقةَ المقِلِّ","explicit":true,"ref":"الفوائد العلمية من الدروس البازية 6/283","srcLabel":"الفوائد العلمية من الدروس البازية","text":[["خيرُ الصَّدقةِ ",1],["صدقةَ المقِلِّ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"QPAQZzkT"},{"id":"س-06286","fp":"e7e96a9af700","stateId":469,"easy":"إذا تصدقت في حياتك وصحتك بدرهم ← فهو خير لك من مئة درهم عند موتك","cause":"لَأنْ يتصدَّقَ المرءُ في حياتِه وصحَّتِه بدرهمٍ","result":"خيرٌ له مِن أنْ يتصدَّقَ بمئةِ درهمٍ عندَ موتِه","explicit":true,"ref":"صحيح ابن حبان 3334","srcLabel":"أبو داود","text":[["لَأنْ يتصدَّقَ المرءُ في حياتِه وصحَّتِه بدرهمٍ ",1],["خيرٌ له مِن أنْ يتصدَّقَ بمئةِ درهمٍ عندَ موتِه",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (2866)، والديلمي في ((الفردوس)) (7847) باختلاف يسير","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"5BSLDFxt"},{"id":"س-06302","fp":"1d2f6d98442a","stateId":469,"easy":"إذا تصدقت بأحب مالك إليك ← فهو مال رابح","cause":"وإنِّي أتقرَّبُ بِها إلى اللَّهِ","result":"بَيرُحاءُ خيرٌ رايحٌ أو خيرُ رابحٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[1],"ref":"صحيح ابن خزيمة 4/ 174","srcLabel":"ابن خزيمة","text":["لمَّا نزلت {لَنْ تَنَالُوا الْبِرَّ حَتَّى تُنْفِقُوا مِمَّا تُحِبُّونَ} [آل عمران: 92] أتَى أبو طلحةَ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ وَهوَ على المنبَرِ، فقالَ: يا رَسولَ اللَّهِ ليسَ لي أرضٌ أحبُّ إليَّ مِن أرضي بَيرُحاءِ، فقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ: ",["بَيرُحاءُ خيرٌ رايحٌ أو خيرُ رابحٌ",2]," - يشُكٌّ الشَّيخُ - فقالَ أبو طَلحةَ: ",["وإنِّي أتقرَّبُ بِها إلى اللَّهِ",1],"، فقالَ: اجعَلها في قَرابتِكَ، فقسمَها بينَهُم حدائقَ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أخرجه في صحيحه","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"AA9vGniY"},{"id":"س-06277","fp":"1f85eff405ca","stateId":469,"easy":"إذا تصدقت وأنت صحيح شحيح تخشى الفقر ← فهي أفضل الصدقة","cause":"أن تصدَّقَ و أنتَ صحيحٌ شحيحٌ، تخشَى الفقرَ و تأملَ الغِنَى","result":"أَيُّ الصَّدَقَةِ أفْضَلُ أَجْرًا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح الأدب المفرد 598","srcLabel":"متفق عليه","text":["جَاءَ رَجُلٌ إلى رسول اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، فَقالَ: يا رَسولَ اللهِ، ",["أَيُّ الصَّدَقَةِ أفْضَلُ أَجْرًا",2],"؟ فَقالَ: أمَّا و أبيكَ لتُنبَّأَنَّهُ : ",["أن تصدَّقَ و أنتَ صحيحٌ شحيحٌ، تخشَى الفقرَ و تأملَ الغِنَى",1],"، ولا تُمْهِلْ، حتَّى إذا بلغَتِ الحُلقومُ قلتَ : لفُلانٍ كَذا، و لِفلانٍ كَذا و قِد كانَ لفُلانٍ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح دون لفظ: \"وأبيك\"","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (778) واللفظ له، وأخرجه في ((الصحيح)) (1419)، ومسلم (1032) باختلاف يسير","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"DNfcV96Z","merged":3,"otherRefs":["صحيح النسائي 2541 (صحيح)","تخريج المسند لشعيب 7159 (صحيح)"]},{"id":"س-01685","fp":"c5b8eac15260","stateId":469,"easy":"إذا تصدقت بجهد من مقل سراً على فقير ← فهي أفضل الصدقة","cause":"جُهدٌ مِن مُقِلٍّ يُسَرُّ إلى فقيرٍ","result":"فأيُّ الصَّدقةِ أفضَلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"النوافح العطرة 227","srcLabel":"أحمد","text":["قُلِ الحقَّ وإن كان مُرًّا [يعني حديث: دخَلتُ علَى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وهو في المسجِدِ جالِسٌ، فاغتَنَمتُ خلوتَهُ، وحدَهُ، فجلَستُ إليهِ، فقالَ : أبا ذَرٍّ ! إن لِلمَسجِد تَحيَّةً، وإنَّ تحيَّتَهُ ركعتان فقُم فاركَعهما، قالَ : فقُمت فركَعتُها ثم عُدتُ فجلَستُ إليهِ، فقُلتُ : يا رسولَ اللهِ ! إنَّكَ أمَرتَني بالصَّلاةِ فما الصَّلاةُ ؟ قال : خيرٌ موضوعٌ استكثِرْ أو استَقِلَّ. قلتُ : يا رسولَ اللهِ ! فأيُّ الأعمالِ أفضَلُ ؟ قال : إيمانٌ باللَّهِ عزَّ وجلَّ، وجهادٌ في سبيلِهِ، قال : قلتُ : يا رسولَ اللهِ ! فأيُّ المؤمنينَ أكمَلُهم إيمانًا ؟ قالَ : أحسَنُهُم خُلُقًا. قالَ : قلتُ : يا رسولَ اللَّهِ ! فأيُّ المؤمنينَ أسلَمُ ؟ قالَ : مَن سلِمَ النَّاسُ من لسانِهِ ويدِهِ. قال : قلتُ : يا رسولَ اللَّهِ ! فأيُّ الهجرةِ أفضَلُ ؟ قال : مَن هجرَ السَّيِّئاتِ. قالَ : قُلتُ : يا رسولَ اللهِ ! فأيُّ الصَّلاةِ أفضَلُ ؟ قال : طولُ القنوتِ . قال : قلتُ : يا رسولَ اللهِ ! فما الصِّيامُ ؟ قالَ : فرضٌ مَجزيٌّ ، وعندَ اللهِ أضعافٌ كثيرةٌ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ الجهادِ أفضَلُ ؟ قالَ : مَن عُقِرَ جوادُهُ وأهريقَ دمُهُ. قال : قُلتُ : يا رسولَ اللهِ ! فأيُّ الرِّقابِ أفضَلُ ؟ قالَ : أغلاها ثَمنًا وأنفَسُها عندَ ربِّها. قالَ : قلتُ : يا رسولَ اللهِ ! ",["فأيُّ الصَّدقةِ أفضَلُ",2]," ؟ قال : ",["جُهدٌ مِن مُقِلٍّ يُسَرُّ إلى فقيرٍ",1],". قال : قلتُ : يا رسولَ اللهِ ! فأيُّ آيةٍ مِمَّا أنزلَ اللهُ عزَّ وجلَّ عليكَ أعظَمُ ؟ قال : آيةُ الكُرسيِّ. ثُمَّ قالَ : يا أبا ذَرٍّ ! ما السَّماواتُ السَّبعُ معَ الكُرسيِّ إلا كَحلقَةٍ مُلقاةٍ بأرضِ فلاةٍ، وفَضلُ العَرشِ على الكُرسيِّ كفَضلِ الفَلاةِ علَى الحَلقَةِ. قلتُ : يا رسولَ اللهِ ! كم الأنبياءُ ؟ قال : مائةُ ألفٍ وأربعةٌ وعِشرونَ ألفًا. قلتُ : يا رسولَ اللهِ ! كم الرُّسلِ ؟ قالَ : ثلاثُمائةٍ وثلاثَةُ عشرَ جَمًّا غفيرًا. قلتُ : كثيرٌ طيِّبٌ، قلتُ : يا رسولَ اللهِ ! مَن كان أوَّلُهمْ ؟ قال : آدَمُ. قلتُ : يا رسولَ اللهِ ! أنَبيٌّ مُرسَلٌ ؟ قال : نعَم، خلقَهُ اللهُ بيدِهِ، ونفخَ فيهِ مِن روحِهِ، ثُمَّ سوَّاهُ قِبَلًا. وقال أحمدُ بنُ أنَسٍ ثُمَّ كلَّمهُ قِبَلًا. ثُمَّ قالَ : يا أبا ذَرٍّ ! أربعةٌ سُريانيُّونَ؛ آدَمُ، وشيثُ، وخَنوخُ - وهو إدريسُ، وهم أوَّلُ مَن خطَّ بالقلَمِ - ونوحٌ. وأربعةٌ من العَربِ؛ هودٌ، وصالِحٌ، وشُعَيبٌ، ونبيُّكَ يا أبا ذَرٍّ. قال : قلتُ : يا رسولَ اللهِ ! كَم كتابٌ أنزلَهُ اللَّهُ تعالى ؟ قال : مائةُ كتابٍ وأربعةُ كتُبٍ، أنزلَ علَى شيثَ خَمسونَ صحيفَةً، وأنزلَ علَى خَنوخَ ثلاثونَ صَحيفةً، وأنزلَ على إبراهيمَ عشرَ صحائفَ، وأنزلَ على موسَى قبلَ التَّوراةِ عَشرَ صحائفَ، وأنزلَ التَّوراةَ والإنجيلَ والزَّبورَ والفُرقانَ. قال : قلتُ : يا رسولَ اللهِ ! فَما كانَت صُحفُ إبراهيمَ ؟ قالَ : كانَت أمثالًا كلُّها : أيُّها الملِكُ المسلَّطُ المبتَلَى المغرورُ، فإنِّي لم أبعثْكَ لتجمَعَ الدُّنيا بعضَها إلى بعضٍ، ولكن بعثتُكَ لترُدَّ عنِّي دعوةَ المظلومِ، فإنِّي لا أردُّها ولَو كانَت مِن كافِرٍ. وكانَت فيها أمثالٌ : علَى العاقِلِ ما لَم يكُن مغلوبًا علَى عقلِهِ أن تكونَ له ساعاتٌ؛ ساعَةٌ يُناجي فيها ربَّهُ عزَّ وجلَّ، وساعةٌ يحاسِبُ فيها نفسَهُ، وساعَةٌ يفكِّرُ فيها في صُنعِ اللَّهِ عزَّ وجلَّ، وساعةٌ يخلو فيها بحاجتِهِ من المطعَمِ والمشرَبِ، وعلى العاقلِ أن لا يكون ظاعِنًا إلَّا لثلاثٍ؛ تزوُّدٍ لمعادٍ، أو مرمَّةٍ لمعاشٍ، أو لذَّةٍ في غيرِ محرَّمٍ، وعلى العاقِلِ أن يكونَ بصيرًا بزمانِهِ، مقبِلًا على شأنِهِ، حافِظًا للسانِهِ، ومن حسَبَ كلامَهُ من عمَلِهِ قلَّ كلامُهُ إلا فيما يعنيهِ. قلتُ : يا رسولَ اللَّهِ ! فما كان صحُفُ موسَى عليهِ السَّلامُ ؟ قال : كانَت عبرًا كلَّها، عجبتُ لمن أيقنَ بالموتِ ثُمَّ هو يفرَحُ، عجبتُ لمن أيقنَ بالنَّارِ وهو يضحَكُ، عجبتُ لمن أيقنَ للقدرِ ثم هو ينصَبُ، عجبتُ لمن رأى الدُّنيا وتقلُّبَها ثُمَّ اطمأنَّ إليها، عجِبتُ لمن أيقنَ بالحسابِ غدًا ثُمَّ لا يعمَلُ. قلتُ : يا رسولَ اللهِ ! أوصِني. قال : أوصيكَ بتقوى اللهِ فإنَّهُ رأسُ الأمرِ كلِّهِ، قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بتلاوَةِ القرآنِ فإنَّهُ نور لكَ في الأرضِ وذكرٌ لكَ في السَّماءِ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : إيَّاكَ وكثرةَ الضَّحِكِ فإنَّهُ يُميتُ القَلبَ، ويَذهَبُ بنورِ الوَجهِ، قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : عليكَ بالصَّمتِ إلَّا مِن خيرٍ، فإنَّهُ مطردَةٌ للشَّيطانِ عنكَ، وعونٌ لكَ علَى أمر دينِكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بالجهادِ فإنَّهُ رهبانيَّةُ أمَّتي. قلتُ : يا رسولَ اللهِ ! زِدني. قال : حبُّ المساكينِ وجالِسهُم. قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : انظُر إلى مَن تحتَكَ ولا تنظُر إلى مَن فوقكَ فإنَّهُ أجدَرُ أن لا تَزدَري نِعمةَ اللهِ عندكَ. قلتُ : زِدني يا رسولَ اللهِ ! قال : صِلْ قرابَتَكَ وإن قَطعوكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : لا تَخَف في اللَّهِ تعالى لَومَةَ لائمٍ. قلتُ : يا رسولَ اللهِ ! زِدني. قالَ : قُل الحقَّ وإن كان مُرًّا. قلتُ : يا رسولَ اللهِ ! زِدني. قال : يردُّكَ عن النَّاسِ ما تعرفُ من نفسِكَ، ولا تجِد عليهِم فيما تأتي، وكفَى به عيبًا أن تعرِفَ من النَّاسِ ما تجهَلُ من نفسِكَ، أو تجِدُ عليهِم فيما تأتي. ثُمَّ ضربَ بيدِهِ علَى صدري، فقالَ : يا أبا ذَرٍّ ! لا عقلَ كالتَّدبيرِ، ولا ورعَ كالكَفِّ، ولا حسَبَ كحُسنِ الخُلُقِ، قلتُ : يارسولَ اللهِ ! هل لي في الدُّنيا شَيءٌ مِمَّا أنزلَ اللهُ عليكَ مِمَّا كان في صحُفِ إبراهيمَ وموسَى ؟ قال : يا أبا ذَرٍّ ! اقرَأ : ? قَد أفلَحَ مَن تزَكَّى? إلى آخرِ السُّورَةِ]"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مطولاً أحمد (21415)، والبزار (3966) باختلاف يسير، وابن حبان (361) واللفظ له","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"wZID7EAR","merged":3,"otherRefs":["الحديث لابن عبدالوهاب 1/555 (صحيح)","الأحاديث المختارة 9 / 235 (صحيح)"]},{"id":"س-01684","fp":"25884d32defa","stateId":469,"easy":"إذا أعتقت أغلى الرقاب وأنفسها ← فهو أفضل العتق","cause":"أغلاها ثَمنًا وأنفَسُها عندَ ربِّها","result":"فأيُّ الرِّقابِ أفضَلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"النوافح العطرة 227","srcLabel":"أحمد","text":["قُلِ الحقَّ وإن كان مُرًّا [يعني حديث: دخَلتُ علَى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وهو في المسجِدِ جالِسٌ، فاغتَنَمتُ خلوتَهُ، وحدَهُ، فجلَستُ إليهِ، فقالَ : أبا ذَرٍّ ! إن لِلمَسجِد تَحيَّةً، وإنَّ تحيَّتَهُ ركعتان فقُم فاركَعهما، قالَ : فقُمت فركَعتُها ثم عُدتُ فجلَستُ إليهِ، فقُلتُ : يا رسولَ اللهِ ! إنَّكَ أمَرتَني بالصَّلاةِ فما الصَّلاةُ ؟ قال : خيرٌ موضوعٌ استكثِرْ أو استَقِلَّ. قلتُ : يا رسولَ اللهِ ! فأيُّ الأعمالِ أفضَلُ ؟ قال : إيمانٌ باللَّهِ عزَّ وجلَّ، وجهادٌ في سبيلِهِ، قال : قلتُ : يا رسولَ اللهِ ! فأيُّ المؤمنينَ أكمَلُهم إيمانًا ؟ قالَ : أحسَنُهُم خُلُقًا. قالَ : قلتُ : يا رسولَ اللَّهِ ! فأيُّ المؤمنينَ أسلَمُ ؟ قالَ : مَن سلِمَ النَّاسُ من لسانِهِ ويدِهِ. قال : قلتُ : يا رسولَ اللَّهِ ! فأيُّ الهجرةِ أفضَلُ ؟ قال : مَن هجرَ السَّيِّئاتِ. قالَ : قُلتُ : يا رسولَ اللهِ ! فأيُّ الصَّلاةِ أفضَلُ ؟ قال : طولُ القنوتِ . قال : قلتُ : يا رسولَ اللهِ ! فما الصِّيامُ ؟ قالَ : فرضٌ مَجزيٌّ ، وعندَ اللهِ أضعافٌ كثيرةٌ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ الجهادِ أفضَلُ ؟ قالَ : مَن عُقِرَ جوادُهُ وأهريقَ دمُهُ. قال : قُلتُ : يا رسولَ اللهِ ! ",["فأيُّ الرِّقابِ أفضَلُ",2]," ؟ قالَ : ",["أغلاها ثَمنًا وأنفَسُها عندَ ربِّها",1],". قالَ : قلتُ : يا رسولَ اللهِ ! فأيُّ الصَّدقةِ أفضَلُ ؟ قال : جُهدٌ مِن مُقِلٍّ يُسَرُّ إلى فقيرٍ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ آيةٍ مِمَّا أنزلَ اللهُ عزَّ وجلَّ عليكَ أعظَمُ ؟ قال : آيةُ الكُرسيِّ. ثُمَّ قالَ : يا أبا ذَرٍّ ! ما السَّماواتُ السَّبعُ معَ الكُرسيِّ إلا كَحلقَةٍ مُلقاةٍ بأرضِ فلاةٍ، وفَضلُ العَرشِ على الكُرسيِّ كفَضلِ الفَلاةِ علَى الحَلقَةِ. قلتُ : يا رسولَ اللهِ ! كم الأنبياءُ ؟ قال : مائةُ ألفٍ وأربعةٌ وعِشرونَ ألفًا. قلتُ : يا رسولَ اللهِ ! كم الرُّسلِ ؟ قالَ : ثلاثُمائةٍ وثلاثَةُ عشرَ جَمًّا غفيرًا. قلتُ : كثيرٌ طيِّبٌ، قلتُ : يا رسولَ اللهِ ! مَن كان أوَّلُهمْ ؟ قال : آدَمُ. قلتُ : يا رسولَ اللهِ ! أنَبيٌّ مُرسَلٌ ؟ قال : نعَم، خلقَهُ اللهُ بيدِهِ، ونفخَ فيهِ مِن روحِهِ، ثُمَّ سوَّاهُ قِبَلًا. وقال أحمدُ بنُ أنَسٍ ثُمَّ كلَّمهُ قِبَلًا. ثُمَّ قالَ : يا أبا ذَرٍّ ! أربعةٌ سُريانيُّونَ؛ آدَمُ، وشيثُ، وخَنوخُ - وهو إدريسُ، وهم أوَّلُ مَن خطَّ بالقلَمِ - ونوحٌ. وأربعةٌ من العَربِ؛ هودٌ، وصالِحٌ، وشُعَيبٌ، ونبيُّكَ يا أبا ذَرٍّ. قال : قلتُ : يا رسولَ اللهِ ! كَم كتابٌ أنزلَهُ اللَّهُ تعالى ؟ قال : مائةُ كتابٍ وأربعةُ كتُبٍ، أنزلَ علَى شيثَ خَمسونَ صحيفَةً، وأنزلَ علَى خَنوخَ ثلاثونَ صَحيفةً، وأنزلَ على إبراهيمَ عشرَ صحائفَ، وأنزلَ على موسَى قبلَ التَّوراةِ عَشرَ صحائفَ، وأنزلَ التَّوراةَ والإنجيلَ والزَّبورَ والفُرقانَ. قال : قلتُ : يا رسولَ اللهِ ! فَما كانَت صُحفُ إبراهيمَ ؟ قالَ : كانَت أمثالًا كلُّها : أيُّها الملِكُ المسلَّطُ المبتَلَى المغرورُ، فإنِّي لم أبعثْكَ لتجمَعَ الدُّنيا بعضَها إلى بعضٍ، ولكن بعثتُكَ لترُدَّ عنِّي دعوةَ المظلومِ، فإنِّي لا أردُّها ولَو كانَت مِن كافِرٍ. وكانَت فيها أمثالٌ : علَى العاقِلِ ما لَم يكُن مغلوبًا علَى عقلِهِ أن تكونَ له ساعاتٌ؛ ساعَةٌ يُناجي فيها ربَّهُ عزَّ وجلَّ، وساعةٌ يحاسِبُ فيها نفسَهُ، وساعَةٌ يفكِّرُ فيها في صُنعِ اللَّهِ عزَّ وجلَّ، وساعةٌ يخلو فيها بحاجتِهِ من المطعَمِ والمشرَبِ، وعلى العاقلِ أن لا يكون ظاعِنًا إلَّا لثلاثٍ؛ تزوُّدٍ لمعادٍ، أو مرمَّةٍ لمعاشٍ، أو لذَّةٍ في غيرِ محرَّمٍ، وعلى العاقِلِ أن يكونَ بصيرًا بزمانِهِ، مقبِلًا على شأنِهِ، حافِظًا للسانِهِ، ومن حسَبَ كلامَهُ من عمَلِهِ قلَّ كلامُهُ إلا فيما يعنيهِ. قلتُ : يا رسولَ اللَّهِ ! فما كان صحُفُ موسَى عليهِ السَّلامُ ؟ قال : كانَت عبرًا كلَّها، عجبتُ لمن أيقنَ بالموتِ ثُمَّ هو يفرَحُ، عجبتُ لمن أيقنَ بالنَّارِ وهو يضحَكُ، عجبتُ لمن أيقنَ للقدرِ ثم هو ينصَبُ، عجبتُ لمن رأى الدُّنيا وتقلُّبَها ثُمَّ اطمأنَّ إليها، عجِبتُ لمن أيقنَ بالحسابِ غدًا ثُمَّ لا يعمَلُ. قلتُ : يا رسولَ اللهِ ! أوصِني. قال : أوصيكَ بتقوى اللهِ فإنَّهُ رأسُ الأمرِ كلِّهِ، قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بتلاوَةِ القرآنِ فإنَّهُ نور لكَ في الأرضِ وذكرٌ لكَ في السَّماءِ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : إيَّاكَ وكثرةَ الضَّحِكِ فإنَّهُ يُميتُ القَلبَ، ويَذهَبُ بنورِ الوَجهِ، قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : عليكَ بالصَّمتِ إلَّا مِن خيرٍ، فإنَّهُ مطردَةٌ للشَّيطانِ عنكَ، وعونٌ لكَ علَى أمر دينِكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بالجهادِ فإنَّهُ رهبانيَّةُ أمَّتي. قلتُ : يا رسولَ اللهِ ! زِدني. قال : حبُّ المساكينِ وجالِسهُم. قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : انظُر إلى مَن تحتَكَ ولا تنظُر إلى مَن فوقكَ فإنَّهُ أجدَرُ أن لا تَزدَري نِعمةَ اللهِ عندكَ. قلتُ : زِدني يا رسولَ اللهِ ! قال : صِلْ قرابَتَكَ وإن قَطعوكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : لا تَخَف في اللَّهِ تعالى لَومَةَ لائمٍ. قلتُ : يا رسولَ اللهِ ! زِدني. قالَ : قُل الحقَّ وإن كان مُرًّا. قلتُ : يا رسولَ اللهِ ! زِدني. قال : يردُّكَ عن النَّاسِ ما تعرفُ من نفسِكَ، ولا تجِد عليهِم فيما تأتي، وكفَى به عيبًا أن تعرِفَ من النَّاسِ ما تجهَلُ من نفسِكَ، أو تجِدُ عليهِم فيما تأتي. ثُمَّ ضربَ بيدِهِ علَى صدري، فقالَ : يا أبا ذَرٍّ ! لا عقلَ كالتَّدبيرِ، ولا ورعَ كالكَفِّ، ولا حسَبَ كحُسنِ الخُلُقِ، قلتُ : يارسولَ اللهِ ! هل لي في الدُّنيا شَيءٌ مِمَّا أنزلَ اللهُ عليكَ مِمَّا كان في صحُفِ إبراهيمَ وموسَى ؟ قال : يا أبا ذَرٍّ ! اقرَأ : ? قَد أفلَحَ مَن تزَكَّى? إلى آخرِ السُّورَةِ]"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مطولاً أحمد (21415)، والبزار (3966) باختلاف يسير، وابن حبان (361) واللفظ له","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"wZID7EAR","merged":2,"otherRefs":["تخريج المسند لشعيب 21500 (صحيح)"]},{"id":"س-01949","fp":"4dae3921d417","stateId":469,"easy":"إذا سقيت الماء ← فهو أفضل الصدقة","cause":"سَقْيُ الماءِ","result":"أيُّ الصَّدقةِ أفضلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح ابن حبان 3348","srcLabel":"أبو داود","text":["قُلْتُ: يا رسولَ اللهِ ",["أيُّ الصَّدقةِ أفضلُ ",2],"؟ قال صلَّى اللهُ عليه وسلَّم: ( ",["سَقْيُ الماءِ )",1]],"grade":"صحيح","narrator":"سعد بن عبادة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (1681) باختلاف يسير، والنسائي (3665)، وابن ماجه (3684)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Ju4hndtL"},{"id":"س-06247","fp":"dd4adc398c48","stateId":469,"easy":"إذا تصدقت بجهد المقل وبدأت بمن تعول ← فهي أفضل الصدقة","cause":"جُهْدُ المقلِّ ، وابدَأْ بمَنْ تعولُ","result":"أيُّ الصَّدَقةِ أفضلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"بلوغ المرام 179","srcLabel":"أبو داود","text":["يا رسولَ اللَّهِ ! ",["أيُّ الصَّدَقةِ أفضلُ ",2],"؟ قالَ: ",["جُهْدُ المقلِّ ، وابدَأْ بمَنْ تعولُ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1677)، وأحمد (8702)","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"T4yzOKW6"},{"id":"س-06386","fp":"81f08deefd60","stateId":469,"easy":"إذا منحت أخاك منيحة (درهماً أو ظهر دابة أو لبن شاة) ← فهي أفضل الصدقة","cause":"المَنيحةُ؛ أنْ يَمنَحَ أحدُكم أخاه الدِّرهمَ، أو ظَهرَ الدَّابَّةِ، أو لَبَنَ الشَّاةِ، أو لَبَنَ البَقرةِ","result":"أيُّ الصَّدقةِ أفضلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"تخريج المسند لشعيب 4415","srcLabel":"أحمد","text":["أتَدرونَ ",["أيُّ الصَّدقةِ أفضلُ",2],"؟ قالوا: اللهُ ورسولُه أعلمُ، قال: ",["المَنيحةُ؛ أنْ يَمنَحَ أحدُكم أخاه الدِّرهمَ، أو ظَهرَ الدَّابَّةِ، أو لَبَنَ الشَّاةِ، أو لَبَنَ البَقرةِ",1],"."],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (4415) واللفظ له، والبزار (1540) مختصراً، وأبو يعلى (5121) باختلاف يسير","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"iVixj5ai"},{"id":"س-04467","fp":"3f8e6dc8a1af","stateId":469,"easy":"إذا خدمت مجاهداً أو أظللته أو أعرته فحلاً ← فهي أفضل الصدقة","cause":"خِدمةُ عبدٍ في سبيلِ اللهِ، أوْ ظِلُّ فُسطاطٍ أوْ طَروقَةُ فَحْلٍ في سبيلِ اللهِ","result":"أَيُّ الصَّدقةِ أَفضلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"المستدرك على الصحيحين 2487","srcLabel":"الترمذي","text":["أنَّه سَأَلَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["أَيُّ الصَّدقةِ أَفضلُ",2],"؟ قالَ: ",["خِدمةُ عبدٍ في سبيلِ اللهِ، أوْ ظِلُّ فُسطاطٍ أوْ طَروقَةُ فَحْلٍ في سبيلِ اللهِ.",1]],"grade":"صحيح","narrator":"عدي بن حاتم الطائي","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (1626)، والمحاملي في ((الأمالي)) (498)، والطبراني في ((الأوسط)) (3296) جميعهم بلفظه.","bab":"جهاد › فضل الجهاد","dorar":"xAjpklib"},{"id":"س-03835","fp":"8ed0036dac41","stateId":469,"easy":"إذا أنفقت على ابنتك المردودة إليك ← فهي من أعظم الصدقة","cause":"ابنتُكَ مَرْدودةٌ عليكَ، ليسَ لها كاسِبٌ غيْرُكَ","result":"ألَا أدُلُّكَ على الصَّدقةِ -أو مِن أعظَمِ الصَّدقةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[37],"ref":"المستدرك على الصحيحين 7549","srcLabel":"مسلم","text":[["ألَا أدُلُّكَ على الصَّدقةِ -أو مِن أعظَمِ الصَّدقةِ",2],"- ",["ابنتُكَ مَرْدودةٌ عليكَ، ليسَ لها كاسِبٌ غيْرُكَ",1],"."],"grade":"صحيح","narrator":"سراقة بن مالك","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه ابن ماجه (3667)، واحمد (17586) بلفظه.","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"Tj6rVgbY","merged":2,"otherRefs":["تخريج المسند لشعيب 17586 (حسن)"]},{"id":"س-07116","fp":"dcf6d22cb1a8","stateId":469,"easy":"إذا تعلمت علماً ثم علّمته أخاك ← فهو أفضل الصدقة","cause":"أن يَتَعَلَّمَ المَرءُ المُسلِمُ عِلمًا ثُمَّ يُعَلِّمَه أخاه المُسلِمَ","result":"أفضَلُ الصَّدَقةِ","explicit":true,"ref":"فيض القدير 2/ 38","srcLabel":"ابن ماجة","text":[["أفضَلُ الصَّدَقةِ",2],[" أن يَتَعَلَّمَ المَرءُ المُسلِمُ عِلمًا ثُمَّ يُعَلِّمَه أخاه المُسلِمَ",1]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"رمز المصنف لصحته غير حسن","takhrij":"أخرجه ابن ماجة (243) واللفظ له.","bab":"علم › تعليم الناس وفضل ذلك","dorar":"NZGyMueI"},{"id":"س-02320","fp":"033fb76e982f","stateId":469,"easy":"إذا تصدقت بجهد المقل ← فهي أفضل الصدقة","cause":"جُهدُ المُقِلِّ","result":"أفضَلَ الصَّدَقةِ","explicit":true,"ref":"فتاوى صديق خان 738","srcLabel":"أبو داود","text":["إنَّ ",["أفضَلَ الصَّدَقةِ",2]," ",["جُهدُ المُقِلِّ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"ثابت.","takhrij":"أخرجه أبو داود (1677)، وأحمد (8702)، وابن حبان (3346) بنحوه تامًا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"h870rBau"},{"id":"س-01873","fp":"b5cc4af81267","stateId":469,"easy":"إذا تصدقت ← فالصدقة أفضل الأعمال (أثر عمر)","cause":"الصدقةُ","result":"أنا أفضلُكم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-07135"],"ref":"صحيح الترغيب 878","srcLabel":"الحاكم","text":["عن عمرَ رضي الله عنه قال : ذكر لي : أن الأعمالَ تَبَاهي ، فتقولُ ",["الصدقةُ",1]," : ",["أنا أفضلُكم",2]],"grade":"صحيح","narrator":"[سعيد بن المسيب]","muhaddith":"صحيح","takhrij":"أخرجه ابن خزيمة (2433),والحاكم في ((مستدركه)) (1518)، والبيهقي في ((الشعب)) (3058) واللفظ لهم.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"z4y5ZNd6"},{"id":"س-02233","fp":"dd6d76776191","stateId":469,"easy":"إذا سقيت الماء ← فهو أفضل الصدقة","cause":"سَقْيُ الماءِ","result":"أفضلُ الصدَقةِ","explicit":true,"otherNeedIds":[50],"ref":"صحيح الجامع 1113","srcLabel":"صحيح الجامع","text":[["أفضلُ الصدَقةِ",2]," ",["سَقْيُ الماءِ",1]],"grade":"حسن","narrator":"سعد بن عبادة وابن عباس","muhaddith":"حسن","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"HOwARGEc"},{"id":"س-06295","fp":"7914c5996adb","stateId":469,"easy":"إذا تصدقت بالماء عن ميتك ← فهو أفضل الصدقة","cause":"قال: الماءُ","result":"فأيُّ الصَّدَقةِ أفضَلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[50],"ref":"تخريج سنن أبي داود 1681","srcLabel":"النسائي","text":["يا رسولَ اللهِ، إنَّ أُمَّ سعدٍ ماتَتْ، ",["فأيُّ الصَّدَقةِ أفضَلُ",2],"؟ ",["قال: الماءُ",1]," قال: فحَفَرَ بِئرًا، وقال: هذه لأمِّ سَعدٍ."],"grade":"صحيح","narrator":"سعد بن عبادة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (3666)، وابن ماجه (3684)، وأحمد (23845) باختلاف يسير","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"Wr4AOzD7","merged":3,"otherRefs":["تخريج سنن أبي داود 1680 (صحيح)","الأوسط لابن المنذر 8/192 (صحيح)"]},{"id":"س-07135","fp":"1d0b3311a722","stateId":469,"easy":"إذا تصدقت في رمضان ← فهي أفضل الصدقة","cause":"صدقةٌ في رمضانَ","result":"فأيُّ الصَّدقةِ أفضلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"في رمضان"},"repOf":"س-01873","ref":"الترغيب والترهيب 2/131","text":["سُئل النَّبيُّ صلَّى اللهُ عليه وسلَّم أيُّ الصَّومِ أفضلُ بعد رمضانَ قال شعبانُ لتعظيمِ رمضانَ قال ",["فأيُّ الصَّدقةِ أفضلُ",2]," قال ",["صدقةٌ في رمضانَ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (663) واللفظ له، والبزار (6890)، والبيهقي (8780)","bab":"علم › حسن السؤال ونصح العالم","dorar":"ueFlqYZ0"},{"id":"س-07009","fp":"778de87c9a0f","stateId":470,"easy":"إذا صمت يوماً وأفطرت يوماً (صيام داود) ← فهو أفضل الصيام","cause":"وهو صيامُ أخي داوُدَ صلَّى اللهُ عليه وسلَّمَ","result":"أفضلُ الصِّيامِ","explicit":true,"star":true,"otherNeedIds":[23],"ref":"تخريج المسند لشعيب 6477","srcLabel":"متفق عليه","text":["قال: زوَّجَني أبي امرأةً مِن قُرَيشٍ، فلمَّا دخَلَتْ علَيَّ جعَلْتُ لا أنْحاشُ لها؛ ممَّا بي مِن القوَّةِ على العِبادةِ، مِن الصَّومِ والصَّلاةِ، فجاء عمرُو بنُ العاصِ إلى كَنَّتِه، حتى دخَلَ عليها، فقال لها: كيف وجَدْتِ بعْلَكِ؟ قالت: خيْرَ الرِّجالِ -أوْ كَخيْرِ البُعولةِ مِن رجُلٍ-؛ لم يُفتِّشْ لنا كَنَفًا، ولم يَعرِفْ لنا فِراشًا، فأقبَلَ علَيَّ، فعَذَمني وعضَّني بلِسانِه، فقال: أنْكحْتُكَ امرأةً من قُريشٍ ذاتَ حسَبٍ، فعضَلْتَها، وفعلْتَ، وفعلْتَ! ثُمَّ انطلَقَ إلى النبيِّ صلَّى اللهُ عليه وسلَّمَ فشَكاني، فأرسَلَ إليَّ النبيُّ صلَّى اللهُ عليه وسلَّمَ فأتَيْتُه، فقال لي: أتصومُ النَّهارَ؟ قُلْتُ: نعمْ، قال: وتقومُ اللَّيلَ؟ قُلْتُ: نعمْ، قال: لكِنِّي أصومُ وأُفطِرُ، وأُصلِّي وأنامُ، وأَمَسُّ النِّساءَ، فمَنْ رغِبَ عن سُنَّتي فليس منِّي.\nقال: اقْرَأِ القرآنَ في كلِّ شهرٍ، قُلْتُ: إنِّي أجِدُني أقوَى مِن ذلك، قال: فاقرَأْه في كلِّ عشَرةِ أيَّامٍ، قُلْتُ: إنِّي أجِدُني أقوَى مِن ذلك، -قال أحدُهما؛ إمَّا حُصَينٌ وإمَّا مُغيرةُ قال: فاقرَأْه في كلِّ ثلاثٍ- قال: ثُمَّ قال: صُمْ في كلِّ شهرٍ ثلاثةَ أيَّامٍ، قُلْتُ: إنِّي أقوَى مِن ذلك، قال: فلم يزَلْ يرفَعُني حتى قال: صُمْ يومًا وأفطِرْ يومًا؛ فإنَّه ",["أفضلُ الصِّيامِ",2],["، وهو صيامُ أخي داوُدَ صلَّى اللهُ عليه وسلَّمَ",1],".\nقال حُصَينٌ في حديثِه: ثُمَّ قال صلَّى اللهُ عليه وسلَّمَ: فإنَّ لِكلِّ عابدٍ شِرَّةً، ولِكلِّ شِرَّةٍ فَترَةٌ، فإمَّا إلى سُنَّةٍ، وإمَّا إلى بدعةٍ، فمَن كانتْ فَترتُه إلى سُنَّةٍ، فقدِ اهْتَدَى، ومَن كانتْ فَترتُه إلى غيرِ ذلك فقد هلَك. قال مجاهدٌ: فكان عبدُ اللهِ بنُ عمرٍو حيثُ ضعُف وكبِر يصومُ الأيَّامَ كذلك، يصِلُ بعضَها إلى بعضٍ؛ لِيتقوَّى بذلك، ثُمَّ يُفطِرُ بعدَ تلك الأيَّامِ، قال: وكان يَقْرَأُ في كلِّ حِزْبِه كذلك، يَزيدُ أحيانًا، ويَنقُصُ أحيانًا، غيرَ أنَّه يُوَفِّي العَددَ؛ إمَّا في سَبعٍ، وإمَّا في ثلاثٍ، قال: ثُمَّ كان يقولُ بعدَ ذلك: لأَنْ أكونَ قبِلتُ رُخصةَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أحَبُّ إليَّ ممَّا عُدِلَ به -أو عدَل- لكنِّي فارَقْتُه على أمْرٍ أكرَهُ أنْ أُخالِفَه إلى غيرِه."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (5052)، ومسلم (1159)، والنسائي (2390)، وأحمد (6477) واللفظ له","bab":"علم › الحث على الأخذ بالسنة","dorar":"6BXZvhjv","merged":3,"otherRefs":["صحيح ابن خزيمة 3/ 512 (صحيح)","تخريج المسند لشاكر 11/73 (صحيح)"]},{"id":"س-06460","fp":"a86783a84e91","stateId":470,"easy":"إذا صمت شهر الله المحرم ← فهو أفضل الصيام بعد رمضان","cause":"شَهْرُ اللَّهِ الَّذي يدعونَهُ المُحرَّمَ","result":"أيُّ الصِّيامِ أفضلُ بعدَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[47],"ref":"المحلى 2/229","srcLabel":"مسلم","text":["جاء رجلٌ إلى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ ، فقالَ : يا رسولَ اللَّهِ ، أيُّ الصَّلاةِ أفضلُ بعدَ المَكْتوبةِ ؟ قالَ : الصَّلاةُ مِن جوفِ اللَّيلِ قالَ : ",["أيُّ الصِّيامِ أفضلُ بعدَ",2]," ؟ قالَ : ",["شَهْرُ اللَّهِ الَّذي يدعونَهُ المُحرَّمَ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"احتج به ، وقال في المقدمة: (لم نحتج إلا بخبر صحيح من رواية الثقات مسند)","takhrij":"أخرجه مسلم (1163)، وأحمد (8013)، والنسائي في ((السنن الكبرى)) (2906) مطولاً، وابن ماجه (1742) مختصراً، وابن حزم في ((المحلى)) (2/229) واللفظ له.","bab":"صلاة › فرض الصلاة","dorar":"myifR12A","merged":2,"otherRefs":["تخريج مشكل الآثار 1255 (صحيح)"]},{"id":"س-01355","fp":"87ff6de2653a","stateId":470,"easy":"إذا صمت يوماً وأفطرت يوماً ← فهو أفضل الصيام","cause":"صيامَ داودَ، صومُ يومٍ وَفِطْرُ يومٍ","result":"أفضلَ الصِّيامِ","explicit":true,"star":true,"similar":["س-06749"],"ref":"صحيح النسائي 2388","srcLabel":"البخاري","text":["قالَ لي عبداللَّه بنُ عمرٍو : أنكَحَني أبي امرأةً ذاتَ حسَبٍ ، فَكانَ يأتيها ، فيسألُها عن بَعلِها ؟ فقالَت : نِعمَ الرَّجلُ مِن الرَّجلِ ، لم يطأ لَنا فراشًا ولم يفتِّش لَنا كنفًا منذُ أتيناهُ ! فذَكَرَ ذلِكَ للنَّبيِّ صلَّى اللَّهُ علَيهِ وسلَّمَ فقالَ: ائتني بِهِ فأتيتُهُ معَهُ، فقالَ: كيفَ تصومُ؟ قلتُ: كلَّ يومٍ، قالَ: صُم مِن كلِّ جمعةٍ ثلاثةَ أيَّامٍ قُلتُ: إنِّي أطيقُ أفضلَ من ذلِكَ، قالَ: صم يومينِ . وأفطر يومًا قال : [ قلتُ ]: إنِّي أطيقُ أفضلَ من ذلِكَ، قالَ: صُم ",["أفضلَ الصِّيامِ",2]," ",["صيامَ داودَ، صومُ يومٍ وَفِطْرُ يومٍ",1]],"grade":"صحيح","narrator":"عبدالله بن عمرو بن العاص","muhaddith":"صحيح","takhrij":"أخرجه النسائي (2389)، واللفظ له، والبخاري (5042)، وأحمد (6477)، باختلاف يسير.","bab":"نكاح › عشرة النساء","dorar":"ew3M0o60"},{"id":"س-06749","fp":"2371a33cc269","stateId":470,"easy":"إذا صمت يوماً وأفطرت يوماً ← فهو صيام داود وأعدل الصيام","cause":"صُمْ يومًا وأفطِرْ يومًا","result":"وذلك صيامُ داودَ وهو أعدَلُ الصِّيامِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-01355","ref":"تخريج صحيح ابن حبان 352","text":["( أُخبِر رسولُ اللهِ صلَّى اللهُ عليه وسلَّم أنَّه قال - يعني نفسَه - لأقومَنَّ اللَّيلَ ولأصومَنَّ النَّهارَ ما عِشْتُ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( أنتَ الَّذي تقولُ ذلك ) ؟ فقُلْتُ له: قد قُلْتُه يا رسولَ اللهِ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( فإنَّك لا تستطيعُ ذلك صُمْ وأفطِرْ ونَمْ وقُمْ وصُمْ مِن الشَّهرِ ثلاثةَ أيَّامٍ فإنَّ الحسنةَ بعَشْرِ أمثالِها وذلك مِثْلُ صيامِ الدَّهرِ ) قال: قُلْتُ: إنِّي أُطيقُ أفضَلَ مِن ذلك قال: ( صُمْ يومًا وأفطِرْ يومينِ ) قال: قُلْتُ: إنِّي أُطيقُ أفضَلَ مِن ذلك قال: ( ",["صُمْ يومًا وأفطِرْ يومًا",1]," ",["وذلك صيامُ داودَ وهو أعدَلُ الصِّيامِ",2]," ) قال: فقُلْتُ: فإنِّي أُطيقُ أفضَلَ مِن ذلك قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( لا أفضَلَ مِن ذلك ) قال عبدُ اللهِ: ولأنْ أكونَ قبِلْتُ الثَّلاثةَ الأيَّامَ الَّتي قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم كان أحَبَّ إليَّ مِن أهلي ومالي )"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (3418)، ومسلم (1159) باختلاف يسير","bab":"صيام › فضل الصيام","dorar":"WPfWzuVB"},{"id":"س-01075","fp":"f922e1252fe0","stateId":471,"easy":"إذا قلت «لا إله إلا الله» و«الحمد لله» ← فهما أفضل الذكر وأفضل الدعاء","cause":"لا إلَهَ إلَّا اللهُ، وأَفضلُ الدُّعاءِ: الحمدُ للهِ","result":"أَفضلُ الذِّكرِ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله» ثم «الحمد لله»"},"similar":["س-00714"],"ref":"المستدرك على الصحيحين 1876","srcLabel":"الحاكم","text":[["أَفضلُ الذِّكرِ",2],[": لا إلَهَ إلَّا اللهُ، وأَفضلُ الدُّعاءِ: الحمدُ للهِ",1],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح الإسناد","bab":"أدعية وأذكار › فضل الذكر","dorar":"GocXepcb"},{"id":"س-05635","fp":"04be6db401e1","stateId":471,"easy":"إذا ذكرت الله خفية ورضيت بالكفاف ← فهو خير الذكر وخير الرزق","cause":"الخفيُّ ، وخيرُ الرِّزقِ أو العيشِ ما يكفي","result":"خيرُ الذِّكرِ","explicit":true,"ref":"الترغيب والترهيب 4/151","srcLabel":"أحمد","text":[["خيرُ الذِّكرِ",2],[" الخفيُّ ، وخيرُ الرِّزقِ أو العيشِ ما يكفي ",1],". الشَّكُّ من ابنِ وهبٍ"],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أحمد (1477)، وعبد بن حميد (137)، وأبو يعلى الموصلي (731) جميعهم باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"gt1hlETX"},{"id":"س-00714","fp":"f09e9211b3c0","stateId":471,"easy":"إذا قلت «لا إله إلا الله» ← فلا ذكر أفضل منها، ولا دعاء أفضل من الاستغفار","cause":"ما منَ الذِّكرِ أفضلُ منْ لا إلهَ","result":"إلا اللهُ، و لا منَ الدعاءِ أفضلُ منَ الاستغفارِ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-01075","ref":"الجامع الصغير 7963","text":[["ما منَ الذِّكرِ أفضلُ منْ لا إلهَ",1]," ",["إلا اللهُ،  و لا منَ الدعاءِ أفضلُ منَ الاستغفارِ",2]],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((الكبير)) (13/ 52) (129) واللفظ له.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"Mt2wnlWm"},{"id":"س-01103","fp":"4820ab5f7baf","stateId":471,"easy":"إذا قلت عشية عرفة «لا إله إلا الله وحده لا شريك له...» ← فهو أفضل الدعاء","cause":"قُلْتُ أنا و النَّبيونَ عشيةَ عرفةَ : لا إلهَ إِلَّا اللهُ وحْدَهُ لا شريكَ لهُ ، لهُ الملكُ و لهُ الحمدُ ، و هو على كلِّ شيءٍ قديرٌ","result":"أفضلُ ما","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"apply":{"k":"say","t":"«لا إلهَ إِلَّا اللهُ وحْدَهُ لا شريكَ لهُ ، لهُ الملكُ و لهُ الحمدُ ، و هو على كلِّ شيءٍ قدير» · الوقت: يوم عرفة"},"ref":"السلسلة الصحيحة 1503","srcLabel":"الطبراني","text":[["أفضلُ ما",2],[" قُلْتُ أنا و النَّبيونَ عشيةَ عرفةَ : لا إلهَ إِلَّا اللهُ وحْدَهُ لا شريكَ لهُ ، لهُ الملكُ و لهُ الحمدُ ، و هو على كلِّ شيءٍ قديرٌ",1]],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرجه الطبراني في ((الدعاء)) (874) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"v93qUGeh"},{"id":"س-01023","fp":"c4a274928526","stateId":471,"easy":"إذا قلت «سبحان الله وبحمده» ← فهو أفضل الكلام","cause":"ما اصطَفى اللهُ لمَلائِكَتِه أو لعِبادِه: سُبحانَ اللهِ وبحَمدِه","result":"أيُّ الكَلامِ أفضَلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«سبحان الله وبحمده»"},"ref":"صحيح مسلم 2731","srcLabel":"متفق عليه","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم سُئِلَ: ",["أيُّ الكَلامِ أفضَلُ",2],"؟ قال: ",["ما اصطَفى اللهُ لمَلائِكَتِه أو لعِبادِه: سُبحانَ اللهِ وبحَمدِه.",1]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"أدعية وأذكار › فضل الذكر","dorar":"BKm3dodO","merged":2,"otherRefs":["السلسلة الصحيحة 1498 (صحيح)"]},{"id":"س-01097","fp":"729750a09d78","stateId":471,"easy":"إذا ذكرت الله ← فهو خير أعمالك وأرفعها في درجاتك","cause":"قالوا: وما ذاكَ يا رسولَ اللهِ؟ قالَ: ذِكرُ اللهِ عزَّ وجلَّ. وقالَ مُعاذُ بنُ جَبلٍ: ما عَمِلَ آدميٌّ مِن عَمَلٍ أَنْجى له مِن عذابِ اللهِ مِن ذِكرِ اللهِ عزَّ وجلَّ","result":"ألا أُنبِّئُكُم بخيرِ أَعمالِكُم، وأَزْكاها عندَ مَليكِكُم وأَرفعِها في دَرجاتِكُم، وخيرٍ لكم مِن إعطاءِ الذَّهبِ والوَرِقِ، وأنْ تَلقَوْا عَدُوَّكُم فتَضرِبوا أَعناقَهم ويَضرِبوا أَعناقَكُم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[47,49],"ref":"المستدرك على الصحيحين 1849","srcLabel":"الترمذي","text":[["ألا أُنبِّئُكُم بخيرِ أَعمالِكُم، وأَزْكاها عندَ مَليكِكُم وأَرفعِها في دَرجاتِكُم، وخيرٍ لكم مِن إعطاءِ الذَّهبِ والوَرِقِ، وأنْ تَلقَوْا عَدُوَّكُم فتَضرِبوا أَعناقَهم ويَضرِبوا أَعناقَكُم",2],"؟",[" قالوا: وما ذاكَ يا رسولَ اللهِ؟ قالَ: ذِكرُ اللهِ عزَّ وجلَّ. وقالَ مُعاذُ بنُ جَبلٍ: ما عَمِلَ آدميٌّ مِن عَمَلٍ أَنْجى له مِن عذابِ اللهِ مِن ذِكرِ اللهِ عزَّ وجلَّ.",1]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (3377)، وأحمد (27525)، وأبو نعيم في ((الحلية)) (2/ 11) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"EczJSj1k","merged":4,"otherRefs":["الكلم الطيب 1 (صحيح)","مجمع الزوائد 10/76 (صحيح)","مجمع الزوائد 10/76 (حسن)"]},{"id":"س-01111","fp":"c1fc9232b8d5","stateId":471,"easy":"إذا فارقت الدنيا ولسانك رطب بذكر الله ← فهو خير العمل","cause":"أن تُفارِقَ الدنيا ولِسانُكَ رَطْبٌ من ذِكْرِ اللهِ","result":"أيُّ العملِ خيرٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[62,23],"ref":"السلسلة الصحيحة 4/452","srcLabel":"الترمذي","text":["جاءَ أعرابيَّانِ إلى رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ فقال أحدُهما : يا رسولَ اللهِ ! أيُّ الناسِ خيرٌ ؟ قال : طُوبَى لمن طالَ عُمُرُه ، وحَسُنَ عملُه . وقال الآخرُ : ",["أيُّ العملِ خيرٌ ؟",2]," قال : ",["أن تُفارِقَ الدنيا ولِسانُكَ رَطْبٌ من ذِكْرِ اللهِ",1]],"grade":"صحيح","narrator":"عبدالله بن بسر","muhaddith":"إسناده صحيح، رجاله ثقات","takhrij":"أخرجه الترمذي (2329) مختصراً، وأحمد (17698 ) باختلاف يسير، وأبو نعيم في ((حلية الأولياء)) (6/111) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"KNmk5ctb","merged":4,"otherRefs":["السلسلة الصحيحة 1836 (صحيح)","الترغيب والترهيب 2/326 (صحيح)","تخريج شرح السنة 1245 (صحيح)"]},{"id":"س-00668","fp":"7a6d474d2eaa","stateId":471,"easy":"إذا سألت ربك العفو والعافية في الدنيا والآخرة ← فهو أفضل الدعاء وقد أفلحت","cause":"أنْ تسألَ ربَّكَ العفوَ والعافيةَ ، في الدنيا والآخرةِ ، فإِنَّكَ إذا أُعْطِيتَهما في الدنيا ثُمَّ أُعْطِيتَهما في الآخرةِ فقدْ أَفْلَحْتَ","result":"أفضلُ الدعاءِ","explicit":true,"star":true,"otherNeedIds":[35],"ref":"الجامع الصغير 1246","srcLabel":"الجامع الصغير","text":[["أفضلُ الدعاءِ",2],[" أنْ تسألَ ربَّكَ العفوَ والعافيةَ ، في الدنيا والآخرةِ ، فإِنَّكَ إذا أُعْطِيتَهما في الدنيا ثُمَّ أُعْطِيتَهما في الآخرةِ فقدْ أَفْلَحْتَ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"3zO1ZlXU","merged":2,"otherRefs":["الأربعون العشارية 211 (حسن)"]},{"id":"س-02021","fp":"9e7ae2163450","stateId":471,"easy":"إذا دعوت لنفسك ← فهو من أفضل الدعاء","cause":"دُعاءُ المَرْءِ لنفْسِه","result":"أيُّ الدُّعاءِ أَفضَلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"الأحكام الوسطى 4/ 320","srcLabel":"البخاري","text":["قُلْتُ: يا رَسولَ اللهِ، ",["أيُّ الدُّعاءِ أَفضَلُ",2],"؟ قالَ: \"",["دُعاءُ المَرْءِ لنفْسِه",1],"\".\n وفي طَريقٍ أخرى: أيُّ العِبادةِ أَفضَلُ؟ قالَ: \"دُعاءُ المَرْءِ لنفْسِه\"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (715)، والحاكم (1992)، والطبراني في ((الدعوات الكبير)) (654) واللفظ لهم","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"jhSB2tJI","merged":2,"otherRefs":["الجامع الصغير 1245 (صحيح)"]},{"id":"س-04545","fp":"b0a41fd31556","stateId":472,"easy":"إذا جاهدت المشركين بمالك ونفسك ← فهو أفضل الجهاد","cause":"مَن جاهَدَ المُشْرِكينَ بمالِه ونَفْسِه","result":"فأيُّ الجِهادِ أَفْضَلُ","explicit":true,"similar":["س-01624"],"ref":"الأحاديث المختارة 9 / 235","srcLabel":"متفق عليه","text":["«أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ سُئِلَ: أيُّ الأعْمالِ أفْضَلُ؟ قالَ: إيمانٌ لا شَكَّ فيه، وجِهادٌ لا غُلولَ فيه، وحَجَّةٌ مَبْرورةٌ، قيلَ: فأيُّ الصَّلاةِ أَفْضَلُ؟ قالَ: طولُ القِيامِ، قيلَ: فأيُّ الصَّدَقةِ أَفْضَلُ؟ قالَ: جُهْدُ المُقِلِّ، قيلَ: فأيُّ الهِجْرةِ أَفْضَلُ؟ قالَ: مَن هَجَرَ ما حَرَّمَ اللهُ عليه، قيلَ: ",["فأيُّ الجِهادِ أَفْضَلُ",2],"؟ قالَ: ",["مَن جاهَدَ المُشْرِكينَ بمالِه ونَفْسِه",1],"، قيلَ: فأيُّ القَتْلِ أَشْرَفُ؟ قالَ: مَن أُهريقَ دَمُه وعُقِرَ جَوادُه»."],"grade":"صحيح","narrator":"عبدالله بن حبشي الخثعمي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"جهاد › فضل الشهيد","dorar":"sLHD6VNX"},{"id":"س-01624","fp":"01225af875c3","stateId":472,"easy":"إذا جاهدت بمالك ونفسك ← فهو أفضل الجهاد","cause":"الذين جاهَدوا بأموالِهم وأنفُسِهم في سَبيلِ اللهِ","result":"فأيُّ الجِهادِ أفضَلُ","explicit":true,"repOf":"س-04545","ref":"الحديث لابن عبدالوهاب 1/555","text":["أنَّ رَجُلًا قال للنَّبِيِّ صلَّى اللهُ عليه وسلَّم: ما الإسلامُ؟ قال: إطعامُ الطَّعامِ، ولِينُ الكلامِ، قال: فما الإيمانُ؟ قال: السَّماحةُ والصَّبرُ، قال: فأيُّ الإسلامِ أفضَلُ؟ قال: من سَلِمَ المسلِمونَ مِن لِسانِه ويَدِه، قالوا: يا رَسولَ اللهِ، أيُّ المؤمِنينَ أكمَلُ إيمانًا؟ قال: أحسَنُهم خُلُقًا، قال: يا رَسولَ اللهِ، أيُّ القَتلِ أشرَفُ؟ قال: مَن أُريقَ دَمُه، وعُقرَ جَوادُه، قال: ",["فأيُّ الجِهادِ أفضَلُ",2],"؟ قال: ",["الذين جاهَدوا بأموالِهم وأنفُسِهم في سَبيلِ اللهِ",1],"، قال: فأيُّ الصَّدَقةِ أفضَلُ؟ قال: جُهْدُ المقِلِّ، قال: فأيُّ الصَّلاةِ أفضَلُ؟ قال: طولُ القُنوتِ، قال: فأيُّ الهِجرةِ أفضَلُ؟ قال: مَن يَهجُرُ السُّوءَ"],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"هذا محفوظ عن عبيد بن عمير تارة يرسله وتارة يسنده","takhrij":"أخرجه أحمد (17027) ، وابن بشران في ((أماليه)) (566) بنحوه ، والطبراني في ((مكارم الأخلاق)) (ص370) ، والبيهقي في ((شعب الإيمان)) (8015) مختصرا .","bab":"أطعمة › إطعام الطعام","dorar":"HTivmgQK"},{"id":"س-01970","fp":"5831e542a14d","stateId":472,"easy":"إذا عُقر جوادك وأُريق دمك في سبيل الله ← فهو أفضل الجهاد","cause":"مَنْ عُقِرَ جَوادُه، وأُرِيقَ دَمُه","result":"أفْضَلُ الجِهادِ","explicit":true,"similar":["س-04399","س-03832"],"ref":"تخريج المسند لشعيب 14727","srcLabel":"أحمد","text":["عن أبي الزُّبَيرِ، أنَّه قال: سَألتُ جابِرًا، أقال النَّبيُّ صلَّى اللهُ عليه وسَلَّم: ",["أفْضَلُ الجِهادِ",2],[" مَنْ عُقِرَ جَوادُه، وأُرِيقَ دَمُه",1],"؟ فقال جابِرٌ: نَعَمْ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أحمد (14727) واللفظ له، والدارمي (2392)، وابن أبي شيبة (19669)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"8d48RDM6"},{"id":"س-04399","fp":"1875e1afaeeb","stateId":472,"easy":"إذا جاهدت فأُريق دمك وعُقر جوادك ← فهو أفضل الجهاد","cause":"من أُهريقَ دمُهُ وعُقِرَ جوادُهُ ولم يخُصَّ برًّا ولا بحرًا","result":"أيُّ الجهادِ أفضلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-01970","ref":"التمهيد 1/236","text":["عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم أنَّه سُئِلَ ",["أيُّ الجهادِ أفضلُ ",2],"؟ فقال : ",["من أُهريقَ دمُهُ وعُقِرَ جوادُهُ ولم يخُصَّ برًّا ولا بحرًا ،",1]," رواهُ أبو ذرٍّ وغيرُهُ"],"grade":"صحيح","muhaddith":"ثابت","bab":"جهاد › الشجاعة في الحرب والجبن","dorar":"Ie8BYPxE"},{"id":"س-04465","fp":"d2de6fe66087","stateId":472,"easy":"إذا جاهدت ← فهو أفضل الهجرة","cause":"الجهادُ)، قال: وما الجهادُ؟ قال: (أن تُقاتِلَ الكُفَّارَ إذا لَقِيتَهم","result":"فأيُّ الهجرةِ أفضَلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"تخريج شرح الطحاوية 494","srcLabel":"ابن ماجه","text":["قال رجلٌ: يا رسولَ اللهِ، ما الإسلامُ؟ قال: (أن يُسلِمَ قَلبُكَ للهِ عزَّ وجلَّ، وأن يَسلَمَ المسلِمون مِن لِسانِك ويَدِك)، قال: فأيُّ الإسلامِ أفضَلُ؟ قال: (الإيمانُ)، قال: وما الإيمانُ؟ قال: (تُؤمِنُ باللهِ وملائكتِه وكُتبِه ورُسلِه والبعثِ بعدَ الموتِ)، قال: فأيُّ الإيمانِ أفضَلُ؟ قال: (الهجرةُ)، قال: فما الهِجْرةُ؟ قال: (تهجُرُ السُّوءَ)، قال: ",["فأيُّ الهجرةِ أفضَلُ",2],"؟ قال: (",["الجهادُ)، قال: وما الجهادُ؟ قال: (أن تُقاتِلَ الكُفَّارَ إذا لَقِيتَهم",1],")، قال: فأيُّ الجهادِ أفضلُ؟ قال: (مَن عقَرَ جَوادَه، وأُهْرِيقَ دَمُه)، قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: (ثُمَّ عَمَلانِ هما أفضَلُ الأعمالِ إِلَّا مَن عَمِلَ بمِثْلِهما: حِجَّةٌ مَبرورةٌ، أو عُمْرةٌ."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"إسناده صحيح إن كان أبو قلابة سمعه من عمرو بن عبسة","takhrij":"أخرجه من طرق ابن ماجه (2794) مختصراً، وأحمد (17027) واللفظ له","bab":"جهاد › فضل الجهاد","dorar":"00HDd8XT"},{"id":"س-03832","fp":"de2ae2923688","stateId":472,"easy":"إذا جاهدت فأُريق دمك وعُقر جوادك ← فهو أفضل الجهاد","cause":"يُهَراقَ دمُكَ، ويُعقَرَ جوادُكَ","result":"فأيُّ الجِهادِ أفضلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-01970","ref":"فوائد الحنائي الحنائيات 2/1197","text":["إيَّاكُم والظُّلمَ فإنَّ الظُّلمَ ظلُماتٌ يومَ القيامةِ، والشُّحَّ، فإنَّما أَهْلَكَ مَن كانَ قبلَكُم الشَّحُ أمرَهُم بالكذِبِ فكذَبوا وأمرَهُم بالظُّلمِ فظَلموا وأمرَهُم بالقطيعةِ فقَطَعوا قال فقامَ رجُلٌ فقالَ يا رسولَ اللَّهِ أيُّ الإسلام أفضلُ قال أن يَسلَمَ المسلمونَ مِن لسانِكَ ويدِكَ قال ",["فأيُّ الجِهادِ أفضلُ",2]," ؟، قالَ ",["يُهَراقَ دمُكَ، ويُعقَرَ جوادُكَ",1]," قالَ: فأيُّ الهجرةِ أفضلُ ؟ قالَ: تَهْجرَ ما كرِهَ ربُّكَ، وَهُما هِجرتانِ: هجرةُ البادي، وَهِجرةُ الحاضِرِ، فأمَّا هجرةُ البادي فإذا دُعِيَ أجابَ، وإذا أُمِرَ أطاعَ، وأمَّا هجرةُ الحاضرِ فأشدُّهما بليَّةً، وأعظمُهُما أَجرًا"],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"مشهور وهو حسن من حديث أبي حفص عمر بن عبد الرحمن","takhrij":"أخرجه أبو داود (1698) مختصراً، وأحمد (6487) باختلاف يسير","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"Cq4uiT98"},{"id":"س-02484","fp":"f7bbb19064e2","stateId":472,"easy":"إذا قلت كلمة حق عند إمام جائر ← فهو أفضل الجهاد","cause":"إلى اللهِ كَلِمةُ حَقٍّ تُقالُ لإمامٍ جائرٍ","result":"أفضَلُ الجِهادِ","explicit":true,"otherNeedIds":[23],"ref":"فيض القدير 1/171","srcLabel":"فيض القدير","text":[["أفضَلُ الجِهادِ",2],[" إلى اللهِ كَلِمةُ حَقٍّ تُقالُ لإمامٍ جائرٍ",1],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده صحيح.","bab":"إمامة وخلافة › الإنكار على الأمراء فيما خالفوا الشرع فيه","dorar":"GSnA6RcR","merged":2,"otherRefs":["صحيح الجامع 168 (حسن)"]},{"id":"س-04544","fp":"19e43daa5093","stateId":472,"easy":"إذا هجرت ما حرّم الله ← فهي أفضل الهجرة","cause":"مَن هَجَرَ ما حَرَّمَ اللهُ عليه","result":"فأيُّ الهِجْرةِ أَفْضَلُ","explicit":true,"star":true,"similar":["س-01625","س-01628","س-01680","س-04464"],"ref":"الأحاديث المختارة 9 / 235","srcLabel":"متفق عليه","text":["«أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ سُئِلَ: أيُّ الأعْمالِ أفْضَلُ؟ قالَ: إيمانٌ لا شَكَّ فيه، وجِهادٌ لا غُلولَ فيه، وحَجَّةٌ مَبْرورةٌ، قيلَ: فأيُّ الصَّلاةِ أَفْضَلُ؟ قالَ: طولُ القِيامِ، قيلَ: فأيُّ الصَّدَقةِ أَفْضَلُ؟ قالَ: جُهْدُ المُقِلِّ، قيلَ: ",["فأيُّ الهِجْرةِ أَفْضَلُ",2],"؟ قالَ: ",["مَن هَجَرَ ما حَرَّمَ اللهُ عليه",1],"، قيلَ: فأيُّ الجِهادِ أَفْضَلُ؟ قالَ: مَن جاهَدَ المُشْرِكينَ بمالِه ونَفْسِه، قيلَ: فأيُّ القَتْلِ أَشْرَفُ؟ قالَ: مَن أُهريقَ دَمُه وعُقِرَ جَوادُه»."],"grade":"صحيح","narrator":"عبدالله بن حبشي الخثعمي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"جهاد › فضل الشهيد","dorar":"sLHD6VNX"},{"id":"س-00308","fp":"3d25cad252b0","stateId":472,"easy":"إذا جاهدت نفسك وهواك ← فهو أفضل الجهاد","cause":"أن يُجاهدَ الرَّجلُ نَفسَه وهواهُ","result":"أفضلُ الجهادِ","explicit":true,"ref":"صحيح الجامع 1099","srcLabel":"أبو نعيم","text":[["أفضلُ الجهادِ",2],[" أن يُجاهدَ الرَّجلُ نَفسَه وهواهُ",1]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه أبو نعيم في ((حلية الأولياء)) (2/249) باختلاف يسير.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"tDL2DoQ1"},{"id":"س-01625","fp":"48967e245ca8","stateId":472,"easy":"إذا هجرت السوء ← فهي أفضل الهجرة","cause":"مَن يَهجُرُ السُّوءَ","result":"فأيُّ الهِجرةِ أفضَلُ","explicit":true,"repOf":"س-04544","ref":"الحديث لابن عبدالوهاب 1/555","text":["أنَّ رَجُلًا قال للنَّبِيِّ صلَّى اللهُ عليه وسلَّم: ما الإسلامُ؟ قال: إطعامُ الطَّعامِ، ولِينُ الكلامِ، قال: فما الإيمانُ؟ قال: السَّماحةُ والصَّبرُ، قال: فأيُّ الإسلامِ أفضَلُ؟ قال: من سَلِمَ المسلِمونَ مِن لِسانِه ويَدِه، قالوا: يا رَسولَ اللهِ، أيُّ المؤمِنينَ أكمَلُ إيمانًا؟ قال: أحسَنُهم خُلُقًا، قال: يا رَسولَ اللهِ، أيُّ القَتلِ أشرَفُ؟ قال: مَن أُريقَ دَمُه، وعُقرَ جَوادُه، قال: فأيُّ الجِهادِ أفضَلُ؟ قال: الذين جاهَدوا بأموالِهم وأنفُسِهم في سَبيلِ اللهِ، قال: فأيُّ الصَّدَقةِ أفضَلُ؟ قال: جُهْدُ المقِلِّ، قال: فأيُّ الصَّلاةِ أفضَلُ؟ قال: طولُ القُنوتِ، قال: ",["فأيُّ الهِجرةِ أفضَلُ",2],"؟ قال: ",["مَن يَهجُرُ السُّوءَ",1]],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"هذا محفوظ عن عبيد بن عمير تارة يرسله وتارة يسنده","takhrij":"أخرجه أحمد (17027) ، وابن بشران في ((أماليه)) (566) بنحوه ، والطبراني في ((مكارم الأخلاق)) (ص370) ، والبيهقي في ((شعب الإيمان)) (8015) مختصرا .","bab":"أطعمة › إطعام الطعام","dorar":"HTivmgQK"},{"id":"س-01628","fp":"d1cb8e729871","stateId":472,"easy":"إذا هجرت ما كره ربك ← فهي أفضل الهجرة","cause":"أنْ تَهجُرَ ما كَرِهَ ربُّكَ","result":"أيُّ الهِجرةِ أفضلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-04544","ref":"تخريج المسند لشعيب 19435","text":["عن عمرِو بنِ عَبَسةَ قال: أتَيتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فقُلتُ: يا رسولَ اللهِ، مَن معك على هذا الأمْرِ؟ قال: حُرٌّ وعبدٌ، قُلتُ: ما الإسلامُ؟ قال: طِيبُ الكَلامِ، وإطعامُ الطَّعامِ، قُلتُ: ما الإيمانُ؟ قال: الصَّبرُ والسَّماحةُ، قال: قُلتُ: أيُّ الإسلامِ أفضلُ؟ قال: مَن سَلِمَ المُسلِمونَ مِن لِسانِه ويدِه، قال: قُلتُ: أيُّ الإيمانِ أفضلُ؟ قال: خُلقٌ حَسنٌ، قال: قُلتُ: أيُّ الصَّلاةِ أفضلُ؟ قال: طولُ القُنوتِ، قال: قُلتُ: ",["أيُّ الهِجرةِ أفضلُ",2],"؟ قال: ",["أنْ تَهجُرَ ما كَرِهَ ربُّكَ",1]," عزَّ وجلَّ، قال: قُلتُ: فأيُّ الجِهادِ أفضلُ؟ قال: مَن عُقِرَ جَوادُه وأُهريقَ دَمُه، قال: قُلتُ: أيُّ السَّاعاتِ أفضلُ؟ قال: جَوفُ اللَّيلِ الآخِرُ، ثُمَّ الصَّلاةُ مَكتوبةٌ مَشهودةٌ حتى يَطلُعَ الفَجرُ، فإذا طَلَعَ الفَجرُ، فلا صَلاةَ إلَّا الرَّكعتَينِ حتى تُصلِّيَ الفَجرَ، فإذا صَلَّيتَ صَلاةَ الصُّبحِ، فأمسِكْ عن الصَّلاةِ حتى تَطلُعَ الشَّمسُ، فإذا طَلَعَتِ الشَّمسُ -فإنَّها تَطلُعُ في قَرنَيْ شَيطانٍ، وإنَّ الكفَّارَ يُصلُّونَ لها-، فأمسِكْ عن الصَّلاةِ حتى تَرتفِعَ، فإذا ارتفَعَتْ، فالصَّلاةُ مَكتوبةٌ مَشهودةٌ حتى يَقومَ الظِّلُّ قيامَ الرُّمحِ، فإذا كان كذلك، فأمسِكْ عن الصَّلاةِ حتى تَميلَ، فإذا مالتْ، فالصَّلاةُ مَكتوبةٌ مَشهودةٌ حتى تَغرُبَ الشَّمسُ، فإذا كان عندَ غُروبِها، فأمسِكْ عن الصَّلاةِ؛ فإنَّها تَغرُبُ أو تَغيبُ في قَرنَيْ شَيطانٍ، وإنَّ الكفَّارَ يُصلُّونَ لها."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"قوله: أي الساعات أفضل؟ قال: \"جوف الليل الآخر\" صحيح، وقوله في أفضل الإيمان وأفضل الصلاة وأفضل الهجرة وأفضل الجهاد، صحيح لغيره","takhrij":"أخرجه ابن ماجه (2794) مختصراً، وأحمد (19435) واللفظ له","bab":"أطعمة › إطعام الطعام","dorar":"DBB8Imql","merged":5,"otherRefs":["تخريج المسند لشعيب 6792 (صحيح)","فوائد الحنائي الحنائيات 2/1197 (حسن)","المستدرك على الصحيحين 26 (صحيح)","تخريج المسند لشاكر 11/71 (صحيح)"]},{"id":"س-01680","fp":"d64aea6d9335","stateId":472,"easy":"إذا هجرت السيئات ← فهي أفضل الهجرة","cause":"مَن هجرَ السَّيِّئاتِ","result":"فأيُّ الهجرةِ أفضَلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-04544","ref":"النوافح العطرة 227","text":["قُلِ الحقَّ وإن كان مُرًّا [يعني حديث: دخَلتُ علَى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وهو في المسجِدِ جالِسٌ، فاغتَنَمتُ خلوتَهُ، وحدَهُ، فجلَستُ إليهِ، فقالَ : أبا ذَرٍّ ! إن لِلمَسجِد تَحيَّةً، وإنَّ تحيَّتَهُ ركعتان فقُم فاركَعهما، قالَ : فقُمت فركَعتُها ثم عُدتُ فجلَستُ إليهِ، فقُلتُ : يا رسولَ اللهِ ! إنَّكَ أمَرتَني بالصَّلاةِ فما الصَّلاةُ ؟ قال : خيرٌ موضوعٌ استكثِرْ أو استَقِلَّ. قلتُ : يا رسولَ اللهِ ! فأيُّ الأعمالِ أفضَلُ ؟ قال : إيمانٌ باللَّهِ عزَّ وجلَّ، وجهادٌ في سبيلِهِ، قال : قلتُ : يا رسولَ اللهِ ! فأيُّ المؤمنينَ أكمَلُهم إيمانًا ؟ قالَ : أحسَنُهُم خُلُقًا. قالَ : قلتُ : يا رسولَ اللَّهِ ! فأيُّ المؤمنينَ أسلَمُ ؟ قالَ : مَن سلِمَ النَّاسُ من لسانِهِ ويدِهِ. قال : قلتُ : يا رسولَ اللَّهِ ! ",["فأيُّ الهجرةِ أفضَلُ",2]," ؟ قال : ",["مَن هجرَ السَّيِّئاتِ",1],". قالَ : قُلتُ : يا رسولَ اللهِ ! فأيُّ الصَّلاةِ أفضَلُ ؟ قال : طولُ القنوتِ . قال : قلتُ : يا رسولَ اللهِ ! فما الصِّيامُ ؟ قالَ : فرضٌ مَجزيٌّ ، وعندَ اللهِ أضعافٌ كثيرةٌ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ الجهادِ أفضَلُ ؟ قالَ : مَن عُقِرَ جوادُهُ وأهريقَ دمُهُ. قال : قُلتُ : يا رسولَ اللهِ ! فأيُّ الرِّقابِ أفضَلُ ؟ قالَ : أغلاها ثَمنًا وأنفَسُها عندَ ربِّها. قالَ : قلتُ : يا رسولَ اللهِ ! فأيُّ الصَّدقةِ أفضَلُ ؟ قال : جُهدٌ مِن مُقِلٍّ يُسَرُّ إلى فقيرٍ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ آيةٍ مِمَّا أنزلَ اللهُ عزَّ وجلَّ عليكَ أعظَمُ ؟ قال : آيةُ الكُرسيِّ. ثُمَّ قالَ : يا أبا ذَرٍّ ! ما السَّماواتُ السَّبعُ معَ الكُرسيِّ إلا كَحلقَةٍ مُلقاةٍ بأرضِ فلاةٍ، وفَضلُ العَرشِ على الكُرسيِّ كفَضلِ الفَلاةِ علَى الحَلقَةِ. قلتُ : يا رسولَ اللهِ ! كم الأنبياءُ ؟ قال : مائةُ ألفٍ وأربعةٌ وعِشرونَ ألفًا. قلتُ : يا رسولَ اللهِ ! كم الرُّسلِ ؟ قالَ : ثلاثُمائةٍ وثلاثَةُ عشرَ جَمًّا غفيرًا. قلتُ : كثيرٌ طيِّبٌ، قلتُ : يا رسولَ اللهِ ! مَن كان أوَّلُهمْ ؟ قال : آدَمُ. قلتُ : يا رسولَ اللهِ ! أنَبيٌّ مُرسَلٌ ؟ قال : نعَم، خلقَهُ اللهُ بيدِهِ، ونفخَ فيهِ مِن روحِهِ، ثُمَّ سوَّاهُ قِبَلًا. وقال أحمدُ بنُ أنَسٍ ثُمَّ كلَّمهُ قِبَلًا. ثُمَّ قالَ : يا أبا ذَرٍّ ! أربعةٌ سُريانيُّونَ؛ آدَمُ، وشيثُ، وخَنوخُ - وهو إدريسُ، وهم أوَّلُ مَن خطَّ بالقلَمِ - ونوحٌ. وأربعةٌ من العَربِ؛ هودٌ، وصالِحٌ، وشُعَيبٌ، ونبيُّكَ يا أبا ذَرٍّ. قال : قلتُ : يا رسولَ اللهِ ! كَم كتابٌ أنزلَهُ اللَّهُ تعالى ؟ قال : مائةُ كتابٍ وأربعةُ كتُبٍ، أنزلَ علَى شيثَ خَمسونَ صحيفَةً، وأنزلَ علَى خَنوخَ ثلاثونَ صَحيفةً، وأنزلَ على إبراهيمَ عشرَ صحائفَ، وأنزلَ على موسَى قبلَ التَّوراةِ عَشرَ صحائفَ، وأنزلَ التَّوراةَ والإنجيلَ والزَّبورَ والفُرقانَ. قال : قلتُ : يا رسولَ اللهِ ! فَما كانَت صُحفُ إبراهيمَ ؟ قالَ : كانَت أمثالًا كلُّها : أيُّها الملِكُ المسلَّطُ المبتَلَى المغرورُ، فإنِّي لم أبعثْكَ لتجمَعَ الدُّنيا بعضَها إلى بعضٍ، ولكن بعثتُكَ لترُدَّ عنِّي دعوةَ المظلومِ، فإنِّي لا أردُّها ولَو كانَت مِن كافِرٍ. وكانَت فيها أمثالٌ : علَى العاقِلِ ما لَم يكُن مغلوبًا علَى عقلِهِ أن تكونَ له ساعاتٌ؛ ساعَةٌ يُناجي فيها ربَّهُ عزَّ وجلَّ، وساعةٌ يحاسِبُ فيها نفسَهُ، وساعَةٌ يفكِّرُ فيها في صُنعِ اللَّهِ عزَّ وجلَّ، وساعةٌ يخلو فيها بحاجتِهِ من المطعَمِ والمشرَبِ، وعلى العاقلِ أن لا يكون ظاعِنًا إلَّا لثلاثٍ؛ تزوُّدٍ لمعادٍ، أو مرمَّةٍ لمعاشٍ، أو لذَّةٍ في غيرِ محرَّمٍ، وعلى العاقِلِ أن يكونَ بصيرًا بزمانِهِ، مقبِلًا على شأنِهِ، حافِظًا للسانِهِ، ومن حسَبَ كلامَهُ من عمَلِهِ قلَّ كلامُهُ إلا فيما يعنيهِ. قلتُ : يا رسولَ اللَّهِ ! فما كان صحُفُ موسَى عليهِ السَّلامُ ؟ قال : كانَت عبرًا كلَّها، عجبتُ لمن أيقنَ بالموتِ ثُمَّ هو يفرَحُ، عجبتُ لمن أيقنَ بالنَّارِ وهو يضحَكُ، عجبتُ لمن أيقنَ للقدرِ ثم هو ينصَبُ، عجبتُ لمن رأى الدُّنيا وتقلُّبَها ثُمَّ اطمأنَّ إليها، عجِبتُ لمن أيقنَ بالحسابِ غدًا ثُمَّ لا يعمَلُ. قلتُ : يا رسولَ اللهِ ! أوصِني. قال : أوصيكَ بتقوى اللهِ فإنَّهُ رأسُ الأمرِ كلِّهِ، قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بتلاوَةِ القرآنِ فإنَّهُ نور لكَ في الأرضِ وذكرٌ لكَ في السَّماءِ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : إيَّاكَ وكثرةَ الضَّحِكِ فإنَّهُ يُميتُ القَلبَ، ويَذهَبُ بنورِ الوَجهِ، قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : عليكَ بالصَّمتِ إلَّا مِن خيرٍ، فإنَّهُ مطردَةٌ للشَّيطانِ عنكَ، وعونٌ لكَ علَى أمر دينِكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بالجهادِ فإنَّهُ رهبانيَّةُ أمَّتي. قلتُ : يا رسولَ اللهِ ! زِدني. قال : حبُّ المساكينِ وجالِسهُم. قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : انظُر إلى مَن تحتَكَ ولا تنظُر إلى مَن فوقكَ فإنَّهُ أجدَرُ أن لا تَزدَري نِعمةَ اللهِ عندكَ. قلتُ : زِدني يا رسولَ اللهِ ! قال : صِلْ قرابَتَكَ وإن قَطعوكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : لا تَخَف في اللَّهِ تعالى لَومَةَ لائمٍ. قلتُ : يا رسولَ اللهِ ! زِدني. قالَ : قُل الحقَّ وإن كان مُرًّا. قلتُ : يا رسولَ اللهِ ! زِدني. قال : يردُّكَ عن النَّاسِ ما تعرفُ من نفسِكَ، ولا تجِد عليهِم فيما تأتي، وكفَى به عيبًا أن تعرِفَ من النَّاسِ ما تجهَلُ من نفسِكَ، أو تجِدُ عليهِم فيما تأتي. ثُمَّ ضربَ بيدِهِ علَى صدري، فقالَ : يا أبا ذَرٍّ ! لا عقلَ كالتَّدبيرِ، ولا ورعَ كالكَفِّ، ولا حسَبَ كحُسنِ الخُلُقِ، قلتُ : يارسولَ اللهِ ! هل لي في الدُّنيا شَيءٌ مِمَّا أنزلَ اللهُ عليكَ مِمَّا كان في صحُفِ إبراهيمَ وموسَى ؟ قال : يا أبا ذَرٍّ ! اقرَأ : ? قَد أفلَحَ مَن تزَكَّى? إلى آخرِ السُّورَةِ]"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مطولاً أحمد (21415)، والبزار (3966) باختلاف يسير، وابن حبان (361) واللفظ له","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"wZID7EAR"},{"id":"س-04464","fp":"76b90c3ef115","stateId":472,"easy":"إذا هجرت السوء ← فهي أفضل الهجرة","cause":"الهجرةُ)، قال: فما الهِجْرةُ؟ قال: (تهجُرُ السُّوءَ","result":"فأيُّ الإيمانِ أفضَلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-04544","ref":"تخريج شرح الطحاوية 494","text":["قال رجلٌ: يا رسولَ اللهِ، ما الإسلامُ؟ قال: (أن يُسلِمَ قَلبُكَ للهِ عزَّ وجلَّ، وأن يَسلَمَ المسلِمون مِن لِسانِك ويَدِك)، قال: فأيُّ الإسلامِ أفضَلُ؟ قال: (الإيمانُ)، قال: وما الإيمانُ؟ قال: (تُؤمِنُ باللهِ وملائكتِه وكُتبِه ورُسلِه والبعثِ بعدَ الموتِ)، قال: ",["فأيُّ الإيمانِ أفضَلُ",2],"؟ قال: (",["الهجرةُ)، قال: فما الهِجْرةُ؟ قال: (تهجُرُ السُّوءَ",1],")، قال: فأيُّ الهجرةِ أفضَلُ؟ قال: (الجهادُ)، قال: وما الجهادُ؟ قال: (أن تُقاتِلَ الكُفَّارَ إذا لَقِيتَهم)، قال: فأيُّ الجهادِ أفضلُ؟ قال: (مَن عقَرَ جَوادَه، وأُهْرِيقَ دَمُه)، قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: (ثُمَّ عَمَلانِ هما أفضَلُ الأعمالِ إِلَّا مَن عَمِلَ بمِثْلِهما: حِجَّةٌ مَبرورةٌ، أو عُمْرةٌ."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"إسناده صحيح إن كان أبو قلابة سمعه من عمرو بن عبسة","takhrij":"أخرجه من طرق ابن ماجه (2794) مختصراً، وأحمد (17027) واللفظ له","bab":"جهاد › فضل الجهاد","dorar":"00HDd8XT"},{"id":"س-04546","fp":"2b1483bf5a87","stateId":472,"easy":"إذا أُريق دمك وعُقر جوادك ← فهو أشرف القتل","cause":"مَن أُهريقَ دَمُه وعُقِرَ جَوادُه","result":"فأيُّ القَتْلِ أَشْرَفُ","explicit":true,"star":true,"similar":["س-01683"],"ref":"الأحاديث المختارة 9 / 235","srcLabel":"متفق عليه","text":["«أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ سُئِلَ: أيُّ الأعْمالِ أفْضَلُ؟ قالَ: إيمانٌ لا شَكَّ فيه، وجِهادٌ لا غُلولَ فيه، وحَجَّةٌ مَبْرورةٌ، قيلَ: فأيُّ الصَّلاةِ أَفْضَلُ؟ قالَ: طولُ القِيامِ، قيلَ: فأيُّ الصَّدَقةِ أَفْضَلُ؟ قالَ: جُهْدُ المُقِلِّ، قيلَ: فأيُّ الهِجْرةِ أَفْضَلُ؟ قالَ: مَن هَجَرَ ما حَرَّمَ اللهُ عليه، قيلَ: فأيُّ الجِهادِ أَفْضَلُ؟ قالَ: مَن جاهَدَ المُشْرِكينَ بمالِه ونَفْسِه، قيلَ: ",["فأيُّ القَتْلِ أَشْرَفُ",2],"؟ قالَ: ",["مَن أُهريقَ دَمُه وعُقِرَ جَوادُه",1],"»."],"grade":"صحيح","narrator":"عبدالله بن حبشي الخثعمي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"جهاد › فضل الشهيد","dorar":"sLHD6VNX"},{"id":"س-04525","fp":"33a663342d30","stateId":472,"easy":"إذا خرجت بنفسك ومالك فلم ترجع ← فهو أزكى العمل","cause":"رجلٌ خرجَ بنفسِه ومالِه فكان مُهْجَتُهُ فيهِ","result":"ما من عملٍ أزْكَى عندَ اللهِ . . . إلا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"إرواء الغليل 3/399","srcLabel":"مسلم","text":[["ما من عملٍ أزْكَى عندَ اللهِ . . . إلا",2]," ",["رجلٌ خرجَ بنفسِه ومالِه فكان مُهْجَتُهُ فيهِ",1]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده حسن وهو على شرط مسلم","takhrij":"أخرجه أحمد (6505)، والطيالسي (2397)، والطبراني (13/ 418)، (14259) جميعهم بلفظه تاما.","bab":"جهاد › فضل الشهيد","dorar":"xfOFePz6"},{"id":"س-02480","fp":"29788f953673","stateId":472,"easy":"إذا قلت كلمة حق عند سلطان جائر ← فهو أفضل الجهاد","cause":"كلِمةُ حقٍّ عندَ ذي سُلطانٍ جائرٍ","result":"أيُّ الجِهادِ أفضَلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[45],"ref":"صحيح ابن ماجه 3257","srcLabel":"ابن ماجه","text":["عَرضَ لرسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ رجلٌ عندَ الجَمرةِ الأولى فقالَ يا رسولَ اللَّهِ ",["أيُّ الجِهادِ أفضَلُ",2]," فسَكَتَ عنهُ فلمَّا رأى الجَمرةَ الثَّانيةَ سألَهُ فسَكَتَ عنهُ فلمَّا رمَى جمرةَ العقَبةِ وضعَ رجلَهُ في الغَرزِ ليَركبَ قالَ أينَ السَّائلُ قالَ أنا يا رسولَ اللَّهِ قالَ ",["كلِمةُ حقٍّ عندَ ذي سُلطانٍ جائرٍ",1]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"حسن صحيح","takhrij":"أخرجه ابن ماجه (4012) واللفظ له، وأحمد (22158).","bab":"إمامة وخلافة › الإنكار على الأمراء فيما خالفوا الشرع فيه","dorar":"VKjnvga5","merged":7,"otherRefs":["السلسلة الصحيحة 491 (حسن)","صحيح أبي داود 4344 (صحيح)","فيض القدير 2/ 30 (صحيح)","تخريج شرح السنة 2473 (صحيح)","تخريج المسند لشعيب 22207 (حسن)","الأحاديث المختارة 8 / 110 (صحيح)"]},{"id":"س-01683","fp":"e116b78fafc3","stateId":472,"easy":"إذا عُقر جوادك وأُريق دمك في سبيل الله ← فهو أفضل الجهاد","cause":"مَن عُقِرَ جوادُهُ وأهريقَ دمُهُ","result":"فأيُّ الجهادِ أفضَلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-04546","ref":"النوافح العطرة 227","text":["قُلِ الحقَّ وإن كان مُرًّا [يعني حديث: دخَلتُ علَى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وهو في المسجِدِ جالِسٌ، فاغتَنَمتُ خلوتَهُ، وحدَهُ، فجلَستُ إليهِ، فقالَ : أبا ذَرٍّ ! إن لِلمَسجِد تَحيَّةً، وإنَّ تحيَّتَهُ ركعتان فقُم فاركَعهما، قالَ : فقُمت فركَعتُها ثم عُدتُ فجلَستُ إليهِ، فقُلتُ : يا رسولَ اللهِ ! إنَّكَ أمَرتَني بالصَّلاةِ فما الصَّلاةُ ؟ قال : خيرٌ موضوعٌ استكثِرْ أو استَقِلَّ. قلتُ : يا رسولَ اللهِ ! فأيُّ الأعمالِ أفضَلُ ؟ قال : إيمانٌ باللَّهِ عزَّ وجلَّ، وجهادٌ في سبيلِهِ، قال : قلتُ : يا رسولَ اللهِ ! فأيُّ المؤمنينَ أكمَلُهم إيمانًا ؟ قالَ : أحسَنُهُم خُلُقًا. قالَ : قلتُ : يا رسولَ اللَّهِ ! فأيُّ المؤمنينَ أسلَمُ ؟ قالَ : مَن سلِمَ النَّاسُ من لسانِهِ ويدِهِ. قال : قلتُ : يا رسولَ اللَّهِ ! فأيُّ الهجرةِ أفضَلُ ؟ قال : مَن هجرَ السَّيِّئاتِ. قالَ : قُلتُ : يا رسولَ اللهِ ! فأيُّ الصَّلاةِ أفضَلُ ؟ قال : طولُ القنوتِ . قال : قلتُ : يا رسولَ اللهِ ! فما الصِّيامُ ؟ قالَ : فرضٌ مَجزيٌّ ، وعندَ اللهِ أضعافٌ كثيرةٌ. قال : قلتُ : يا رسولَ اللهِ ! ",["فأيُّ الجهادِ أفضَلُ",2]," ؟ قالَ : ",["مَن عُقِرَ جوادُهُ وأهريقَ دمُهُ",1],". قال : قُلتُ : يا رسولَ اللهِ ! فأيُّ الرِّقابِ أفضَلُ ؟ قالَ : أغلاها ثَمنًا وأنفَسُها عندَ ربِّها. قالَ : قلتُ : يا رسولَ اللهِ ! فأيُّ الصَّدقةِ أفضَلُ ؟ قال : جُهدٌ مِن مُقِلٍّ يُسَرُّ إلى فقيرٍ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ آيةٍ مِمَّا أنزلَ اللهُ عزَّ وجلَّ عليكَ أعظَمُ ؟ قال : آيةُ الكُرسيِّ. ثُمَّ قالَ : يا أبا ذَرٍّ ! ما السَّماواتُ السَّبعُ معَ الكُرسيِّ إلا كَحلقَةٍ مُلقاةٍ بأرضِ فلاةٍ، وفَضلُ العَرشِ على الكُرسيِّ كفَضلِ الفَلاةِ علَى الحَلقَةِ. قلتُ : يا رسولَ اللهِ ! كم الأنبياءُ ؟ قال : مائةُ ألفٍ وأربعةٌ وعِشرونَ ألفًا. قلتُ : يا رسولَ اللهِ ! كم الرُّسلِ ؟ قالَ : ثلاثُمائةٍ وثلاثَةُ عشرَ جَمًّا غفيرًا. قلتُ : كثيرٌ طيِّبٌ، قلتُ : يا رسولَ اللهِ ! مَن كان أوَّلُهمْ ؟ قال : آدَمُ. قلتُ : يا رسولَ اللهِ ! أنَبيٌّ مُرسَلٌ ؟ قال : نعَم، خلقَهُ اللهُ بيدِهِ، ونفخَ فيهِ مِن روحِهِ، ثُمَّ سوَّاهُ قِبَلًا. وقال أحمدُ بنُ أنَسٍ ثُمَّ كلَّمهُ قِبَلًا. ثُمَّ قالَ : يا أبا ذَرٍّ ! أربعةٌ سُريانيُّونَ؛ آدَمُ، وشيثُ، وخَنوخُ - وهو إدريسُ، وهم أوَّلُ مَن خطَّ بالقلَمِ - ونوحٌ. وأربعةٌ من العَربِ؛ هودٌ، وصالِحٌ، وشُعَيبٌ، ونبيُّكَ يا أبا ذَرٍّ. قال : قلتُ : يا رسولَ اللهِ ! كَم كتابٌ أنزلَهُ اللَّهُ تعالى ؟ قال : مائةُ كتابٍ وأربعةُ كتُبٍ، أنزلَ علَى شيثَ خَمسونَ صحيفَةً، وأنزلَ علَى خَنوخَ ثلاثونَ صَحيفةً، وأنزلَ على إبراهيمَ عشرَ صحائفَ، وأنزلَ على موسَى قبلَ التَّوراةِ عَشرَ صحائفَ، وأنزلَ التَّوراةَ والإنجيلَ والزَّبورَ والفُرقانَ. قال : قلتُ : يا رسولَ اللهِ ! فَما كانَت صُحفُ إبراهيمَ ؟ قالَ : كانَت أمثالًا كلُّها : أيُّها الملِكُ المسلَّطُ المبتَلَى المغرورُ، فإنِّي لم أبعثْكَ لتجمَعَ الدُّنيا بعضَها إلى بعضٍ، ولكن بعثتُكَ لترُدَّ عنِّي دعوةَ المظلومِ، فإنِّي لا أردُّها ولَو كانَت مِن كافِرٍ. وكانَت فيها أمثالٌ : علَى العاقِلِ ما لَم يكُن مغلوبًا علَى عقلِهِ أن تكونَ له ساعاتٌ؛ ساعَةٌ يُناجي فيها ربَّهُ عزَّ وجلَّ، وساعةٌ يحاسِبُ فيها نفسَهُ، وساعَةٌ يفكِّرُ فيها في صُنعِ اللَّهِ عزَّ وجلَّ، وساعةٌ يخلو فيها بحاجتِهِ من المطعَمِ والمشرَبِ، وعلى العاقلِ أن لا يكون ظاعِنًا إلَّا لثلاثٍ؛ تزوُّدٍ لمعادٍ، أو مرمَّةٍ لمعاشٍ، أو لذَّةٍ في غيرِ محرَّمٍ، وعلى العاقِلِ أن يكونَ بصيرًا بزمانِهِ، مقبِلًا على شأنِهِ، حافِظًا للسانِهِ، ومن حسَبَ كلامَهُ من عمَلِهِ قلَّ كلامُهُ إلا فيما يعنيهِ. قلتُ : يا رسولَ اللَّهِ ! فما كان صحُفُ موسَى عليهِ السَّلامُ ؟ قال : كانَت عبرًا كلَّها، عجبتُ لمن أيقنَ بالموتِ ثُمَّ هو يفرَحُ، عجبتُ لمن أيقنَ بالنَّارِ وهو يضحَكُ، عجبتُ لمن أيقنَ للقدرِ ثم هو ينصَبُ، عجبتُ لمن رأى الدُّنيا وتقلُّبَها ثُمَّ اطمأنَّ إليها، عجِبتُ لمن أيقنَ بالحسابِ غدًا ثُمَّ لا يعمَلُ. قلتُ : يا رسولَ اللهِ ! أوصِني. قال : أوصيكَ بتقوى اللهِ فإنَّهُ رأسُ الأمرِ كلِّهِ، قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بتلاوَةِ القرآنِ فإنَّهُ نور لكَ في الأرضِ وذكرٌ لكَ في السَّماءِ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : إيَّاكَ وكثرةَ الضَّحِكِ فإنَّهُ يُميتُ القَلبَ، ويَذهَبُ بنورِ الوَجهِ، قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : عليكَ بالصَّمتِ إلَّا مِن خيرٍ، فإنَّهُ مطردَةٌ للشَّيطانِ عنكَ، وعونٌ لكَ علَى أمر دينِكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بالجهادِ فإنَّهُ رهبانيَّةُ أمَّتي. قلتُ : يا رسولَ اللهِ ! زِدني. قال : حبُّ المساكينِ وجالِسهُم. قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : انظُر إلى مَن تحتَكَ ولا تنظُر إلى مَن فوقكَ فإنَّهُ أجدَرُ أن لا تَزدَري نِعمةَ اللهِ عندكَ. قلتُ : زِدني يا رسولَ اللهِ ! قال : صِلْ قرابَتَكَ وإن قَطعوكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : لا تَخَف في اللَّهِ تعالى لَومَةَ لائمٍ. قلتُ : يا رسولَ اللهِ ! زِدني. قالَ : قُل الحقَّ وإن كان مُرًّا. قلتُ : يا رسولَ اللهِ ! زِدني. قال : يردُّكَ عن النَّاسِ ما تعرفُ من نفسِكَ، ولا تجِد عليهِم فيما تأتي، وكفَى به عيبًا أن تعرِفَ من النَّاسِ ما تجهَلُ من نفسِكَ، أو تجِدُ عليهِم فيما تأتي. ثُمَّ ضربَ بيدِهِ علَى صدري، فقالَ : يا أبا ذَرٍّ ! لا عقلَ كالتَّدبيرِ، ولا ورعَ كالكَفِّ، ولا حسَبَ كحُسنِ الخُلُقِ، قلتُ : يارسولَ اللهِ ! هل لي في الدُّنيا شَيءٌ مِمَّا أنزلَ اللهُ عليكَ مِمَّا كان في صحُفِ إبراهيمَ وموسَى ؟ قال : يا أبا ذَرٍّ ! اقرَأ : ? قَد أفلَحَ مَن تزَكَّى? إلى آخرِ السُّورَةِ]"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مطولاً أحمد (21415)، والبزار (3966) باختلاف يسير، وابن حبان (361) واللفظ له","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"wZID7EAR","merged":4,"otherRefs":["تخريج المسند لشعيب 6792 (صحيح)","تخريج المسند لشعيب 19435 (صحيح)","تخريج شرح الطحاوية 494 (صحيح)"]},{"id":"س-04343","fp":"099fd50fefb2","stateId":472,"easy":"إذا جاهدت نفسك في ذات الله ← فهو أفضل الجهاد","cause":"من جاهد نفسَه في ذاتِ اللهِ","result":"و أفضلُ الجهادِ","explicit":true,"ref":"صحيح الجامع 1129","srcLabel":"الطبراني","text":["أفضلُ المؤمنينَ إسلامًا من سَلِمَ المسلمونَ من لسانِه و يدِه ، وأفضلُ المؤمنينَ إيمانًا أحسنُهم خُلقًا ؛ وأفضلُ المهاجرين من هجر ما نهى اللهُ تعالى عنه ، ",["و أفضلُ الجهادِ",2]," ",["من جاهد نفسَه في ذاتِ اللهِ",1]," عزَّ و جلَّ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه محمد بن نصر المروزي في ((تعظيم قدر الصلاة)) (639)، والطبراني (13/596) (14512) باختلاف يسير.","bab":"جهاد › أي الجهاد أفضل","dorar":"R6IaIkMh"},{"id":"س-01152","fp":"ec637c726897","stateId":472,"easy":"إذا هجرت المعاصي ← فهي أفضل الهجرة","cause":"اهجُري المعاصيَ","result":"فإنَّها أفضَلُ الهِجْرةِ","explicit":true,"ref":"مجمع الزوائد 10/78","srcLabel":"الطبراني","text":["أتَيتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم فقُلْتُ جعَلك اللهُ في الرَّفيقِ الأعلى مِنَ الجَنَّةِ وأنا معك وقُلْتُ يا رسولَ اللهِ عَلِّمْني عمَلًا صالحًا أعمَلُه فقال أقيمي الصَّلاةَ فإنَّها أعظَمُ الجهادِ و",["اهجُري المعاصيَ",1]," ",["فإنَّها أفضَلُ الهِجْرةِ",2]," واذكُري اللهَ كثيرًا فإنَّه أحَبُّ الأعمالِ إلى اللهِ أن تَلْقَينَه به"],"grade":"حسن","narrator":"أم سليم بنت ملحان أم أنس بن مالك","muhaddith":"[فيه] محمد بن إسماعيل الأنصاري عن يونس بن عمران بن أبي أنس وكلاهما ذكره ابن أبي حاتم ولم يذكر فيه جرحا وبقية رجاله ثقات","takhrij":"أخرجه  الطبراني (25/149) (359) باختلاف يسير، والبغوي في ((معجم الصحابة)) (45) بنحوه","bab":"أدعية وأذكار › فضل الذكر","dorar":"GRFNiP5n","merged":2,"otherRefs":["المتجر الرابح 203 (حسن)"]},{"id":"س-04692","fp":"531903f3c9bf","stateId":473,"easy":"إذا أدخلت السرور على مؤمن فقضيت دينه أو حاجته أو نفّست كربته ← فهو من أفضل العمل","cause":"إدخالُ السرورِ على المؤمنِ ، تَقْضِي عنه دينًا ، تَقْضي له حاجةً ، تُنَفِّسُ له كربةً","result":"مِنْ أفضلِ العملِ","explicit":true,"apply":{"k":"time","t":"عند الكرب والهم"},"similar":["س-01607"],"ref":"صحيح الجامع 5897","srcLabel":"البيهقي","text":[["مِنْ أفضلِ العملِ",2],[" إدخالُ السرورِ على المؤمنِ ، تَقْضِي عنه دينًا ، تَقْضي له حاجةً ، تُنَفِّسُ له كربةً",1]],"grade":"صحيح","narrator":"محمد بن المنكدر","muhaddith":"صحيح","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (7679)","bab":"رقائق وزهد › أي الأعمال أفضل","dorar":"pfwhuqyk","merged":3,"otherRefs":["صحيح الترغيب 2090 (حسن)","صحيح الجامع 1096 (صحيح)"]},{"id":"س-01607","fp":"236f8a7315d1","stateId":473,"easy":"إذا أدخلت السرور على مؤمن (أشبعت جوعته أو كسوته أو قضيت حاجته) ← فهو أفضل الأعمال","cause":"إدخالُكَ السُّرورَ علَى مؤمنٍ","result":"أشبعتَ جَوْعَتَهُ ، أو كسَوتَ عورَتَه ، أو قضَيتَ لهُ حاجةً","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-04692","ref":"صحيح الترغيب 954","text":[["إدخالُكَ السُّرورَ علَى مؤمنٍ",1]," ؛ ",["أشبعتَ جَوْعَتَهُ ، أو كسَوتَ عورَتَه ، أو قضَيتَ لهُ حاجةً",2]],"grade":"حسن","narrator":"عمر بن الخطاب","muhaddith":"حسن لغيره","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (5081) واللفظ له.","bab":"أطعمة › إطعام الطعام","dorar":"Tbj9oVLk"},{"id":"س-08009","fp":"4f674a4e7576","stateId":473,"easy":"إذا سلم المسلمون من لسانك ويدك ← فهو أفضل الإسلام","cause":"أنْ يَسْلَمَ المسْلِمونَ مِنْ لِسانِكَ ويَدِكَ","result":"أيُّ الإسْلامِ أفْضَلُ","explicit":true,"similar":["س-01627"],"otherNeedIds":[47],"ref":"المستدرك على الصحيحين 26","srcLabel":"أحمد","text":["قالَ: خَطَبَنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: «إيَّاكُمْ والظُّلْمَ؛ فَإنَّ الظُّلْمَ ظُلُماتٌ يومَ القيامَةِ، وَإيَّاكُمْ والفُحْشَ والتَّفَحُّشَ، وإيَّاكُمْ والشُّحَّ؛ فإنَّما هَلَكَ مَنْ كان قَبْلَكُمْ بِالشُّحِّ، أَمَرَهُمْ بالقَطيعَةِ فقَطَعوا، والبُخْلَ فَبَخِلوا، وبالفُجورِ فَفَجَروا». فقامَ رَجُلٌ فقالَ: يا رسولَ اللهِ، ",["أيُّ الإسْلامِ أفْضَلُ",2],"؟ قالَ: «",["أنْ يَسْلَمَ المسْلِمونَ مِنْ لِسانِكَ ويَدِكَ",1],"». فقالَ ذلك الرَّجلُ أو غَيرُهُ: يا رسولَ اللهِ، أيُّ الهِجْرةِ أَفْضَلُ؟ قالَ: «أنْ تَهْجُرَ ما كَرِهَ رَبُّكَ». قالَ: «والهِجْرَةُ هِجْرَتانِ: هِجْرَةُ الحاضِرِ، وهِجْرَةُ البادي؛ فَهِجْرَةُ البادي: أنْ يُجيبَ إذا دُعِيَ، ويُطيعَ إذا أُمِرَ، وهِجْرَةُ الحاضِرِ أَعْظَمُهُما بَلِيَّةً وأَفْضَلُهُما أَجْرًا»."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[صحيح سليم من رواية المجروحين]","takhrij":"أخرجه ابن حبان (5176) بلفظه، وأحمد (6837)، الدارمي (2558) كلاهما ببعض لفظه.","bab":"مظالم › تحريم الظلم","dorar":"2XPZM3DI","merged":5,"otherRefs":["فوائد الحنائي الحنائيات 2/1197 (حسن)","صحيح الجامع 1129 (صحيح)","تخريج شرح الطحاوية 494 (صحيح)","تخريج المسند لشاكر 11/71 (صحيح)"]},{"id":"س-01626","fp":"b41da7fd38b3","stateId":473,"easy":"إذا صبرت وسمحت ← فهو أفضل الإيمان","cause":"الصَّبرُ والسَّماحةُ","result":"أيُّ الإيمانِ أفضلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"تخريج المسند لشعيب 19435","srcLabel":"ابن ماجه","text":["عن عمرِو بنِ عَبَسةَ قال: أتَيتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فقُلتُ: يا رسولَ اللهِ، مَن معك على هذا الأمْرِ؟ قال: حُرٌّ وعبدٌ، قُلتُ: ما الإسلامُ؟ قال: طِيبُ الكَلامِ، وإطعامُ الطَّعامِ، قُلتُ: ما الإيمانُ؟ قال: ",["الصَّبرُ والسَّماحةُ",1],"، قال: قُلتُ: أيُّ الإسلامِ أفضلُ؟ قال: مَن سَلِمَ المُسلِمونَ مِن لِسانِه ويدِه، قال: قُلتُ: ",["أيُّ الإيمانِ أفضلُ",2],"؟ قال: خُلقٌ حَسنٌ، قال: قُلتُ: أيُّ الصَّلاةِ أفضلُ؟ قال: طولُ القُنوتِ، قال: قُلتُ: أيُّ الهِجرةِ أفضلُ؟ قال: أنْ تَهجُرَ ما كَرِهَ ربُّكَ عزَّ وجلَّ، قال: قُلتُ: فأيُّ الجِهادِ أفضلُ؟ قال: مَن عُقِرَ جَوادُه وأُهريقَ دَمُه، قال: قُلتُ: أيُّ السَّاعاتِ أفضلُ؟ قال: جَوفُ اللَّيلِ الآخِرُ، ثُمَّ الصَّلاةُ مَكتوبةٌ مَشهودةٌ حتى يَطلُعَ الفَجرُ، فإذا طَلَعَ الفَجرُ، فلا صَلاةَ إلَّا الرَّكعتَينِ حتى تُصلِّيَ الفَجرَ، فإذا صَلَّيتَ صَلاةَ الصُّبحِ، فأمسِكْ عن الصَّلاةِ حتى تَطلُعَ الشَّمسُ، فإذا طَلَعَتِ الشَّمسُ -فإنَّها تَطلُعُ في قَرنَيْ شَيطانٍ، وإنَّ الكفَّارَ يُصلُّونَ لها-، فأمسِكْ عن الصَّلاةِ حتى تَرتفِعَ، فإذا ارتفَعَتْ، فالصَّلاةُ مَكتوبةٌ مَشهودةٌ حتى يَقومَ الظِّلُّ قيامَ الرُّمحِ، فإذا كان كذلك، فأمسِكْ عن الصَّلاةِ حتى تَميلَ، فإذا مالتْ، فالصَّلاةُ مَكتوبةٌ مَشهودةٌ حتى تَغرُبَ الشَّمسُ، فإذا كان عندَ غُروبِها، فأمسِكْ عن الصَّلاةِ؛ فإنَّها تَغرُبُ أو تَغيبُ في قَرنَيْ شَيطانٍ، وإنَّ الكفَّارَ يُصلُّونَ لها."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"قوله: أي الساعات أفضل؟ قال: \"جوف الليل الآخر\" صحيح، وقوله في أفضل الإيمان وأفضل الصلاة وأفضل الهجرة وأفضل الجهاد، صحيح لغيره","takhrij":"أخرجه ابن ماجه (2794) مختصراً، وأحمد (19435) واللفظ له","bab":"أطعمة › إطعام الطعام","dorar":"DBB8Imql","merged":3,"otherRefs":["تخريج شرح السنة 1/39 (صحيح)","فيض القدير 2/ 29 (صحيح)"]},{"id":"س-01627","fp":"fc5ce1b7346b","stateId":473,"easy":"إذا سلم المسلمون من لسانك ويدك ← فهو أفضل الإسلام","cause":"مَن سَلِمَ المُسلِمونَ مِن لِسانِه ويدِه","result":"أيُّ الإسلامِ أفضلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-08009","ref":"تخريج المسند لشعيب 19435","text":["عن عمرِو بنِ عَبَسةَ قال: أتَيتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فقُلتُ: يا رسولَ اللهِ، مَن معك على هذا الأمْرِ؟ قال: حُرٌّ وعبدٌ، قُلتُ: ما الإسلامُ؟ قال: طِيبُ الكَلامِ، وإطعامُ الطَّعامِ، قُلتُ: ما الإيمانُ؟ قال: الصَّبرُ والسَّماحةُ، قال: قُلتُ: ",["أيُّ الإسلامِ أفضلُ",2],"؟ قال: ",["مَن سَلِمَ المُسلِمونَ مِن لِسانِه ويدِه",1],"، قال: قُلتُ: أيُّ الإيمانِ أفضلُ؟ قال: خُلقٌ حَسنٌ، قال: قُلتُ: أيُّ الصَّلاةِ أفضلُ؟ قال: طولُ القُنوتِ، قال: قُلتُ: أيُّ الهِجرةِ أفضلُ؟ قال: أنْ تَهجُرَ ما كَرِهَ ربُّكَ عزَّ وجلَّ، قال: قُلتُ: فأيُّ الجِهادِ أفضلُ؟ قال: مَن عُقِرَ جَوادُه وأُهريقَ دَمُه، قال: قُلتُ: أيُّ السَّاعاتِ أفضلُ؟ قال: جَوفُ اللَّيلِ الآخِرُ، ثُمَّ الصَّلاةُ مَكتوبةٌ مَشهودةٌ حتى يَطلُعَ الفَجرُ، فإذا طَلَعَ الفَجرُ، فلا صَلاةَ إلَّا الرَّكعتَينِ حتى تُصلِّيَ الفَجرَ، فإذا صَلَّيتَ صَلاةَ الصُّبحِ، فأمسِكْ عن الصَّلاةِ حتى تَطلُعَ الشَّمسُ، فإذا طَلَعَتِ الشَّمسُ -فإنَّها تَطلُعُ في قَرنَيْ شَيطانٍ، وإنَّ الكفَّارَ يُصلُّونَ لها-، فأمسِكْ عن الصَّلاةِ حتى تَرتفِعَ، فإذا ارتفَعَتْ، فالصَّلاةُ مَكتوبةٌ مَشهودةٌ حتى يَقومَ الظِّلُّ قيامَ الرُّمحِ، فإذا كان كذلك، فأمسِكْ عن الصَّلاةِ حتى تَميلَ، فإذا مالتْ، فالصَّلاةُ مَكتوبةٌ مَشهودةٌ حتى تَغرُبَ الشَّمسُ، فإذا كان عندَ غُروبِها، فأمسِكْ عن الصَّلاةِ؛ فإنَّها تَغرُبُ أو تَغيبُ في قَرنَيْ شَيطانٍ، وإنَّ الكفَّارَ يُصلُّونَ لها."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"قوله: أي الساعات أفضل؟ قال: \"جوف الليل الآخر\" صحيح، وقوله في أفضل الإيمان وأفضل الصلاة وأفضل الهجرة وأفضل الجهاد، صحيح لغيره","takhrij":"أخرجه ابن ماجه (2794) مختصراً، وأحمد (19435) واللفظ له","bab":"أطعمة › إطعام الطعام","dorar":"DBB8Imql","merged":2,"otherRefs":["تخريج المسند لشعيب 6792 (صحيح)"]},{"id":"س-06261","fp":"c31690afe01e","stateId":473,"easy":"إذا حفظت لسانك ← فهو أفضل الأعمال","cause":"فأخرج رسولُ اللهِ صلَّى اللهُ عليه وسلَّم لسانَه، ثمَّ وضع إصبعَه عليه","result":"أيُّ الأعمالِ أفضلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[66],"ref":"الترغيب والترهيب 4/23","srcLabel":"الطبراني","text":["عَنْ عَبْدِ الرَّحْمَنِ بْنِ غَنْمٍ أنَّ معاذًا سأل رسولَ اللهِ صلَّى اللهُ عليه وسلَّم فقال : يا رسولَ اللهِ ",["أيُّ الأعمالِ أفضلُ",2]," ؟ فقال : الصَّلاةُ بعد الصَّلاةِ المفروضةِ. قال : لا ونعِمَّا هي. قال : الصَّومُ بعد صيامِ رمضانَ. قال : لا ونِعمَّا هي. قال : فالصَّدقةُ بعد الصَّدقةِ المفروضةِ. قال : لا ونِعمَّا هي. قال : يا رسولَ اللهِ أيُّ الأعمالِ أفضلُ ؟ قال : ",["فأخرج رسولُ اللهِ صلَّى اللهُ عليه وسلَّم لسانَه، ثمَّ وضع إصبعَه عليه",1],"، فاسترجع معاذٌ، فقال : يا رسولَ اللهِ أنؤاخَذُ بما نقولُ كلَّه, ويُكتبُ علينا ؟ قال : فضرب رسولُ اللهِ صلَّى اللهُ عليه وسلَّم منكِبَ معاذٍ مِرارًا، فقال : ثكِلتك أمُّك يا معاذَ بنَ جبلٍ وهل يُكِبُّ النَّاسَ على مناخرِهم في نارِ جهنَّمَ إلَّا حصائدُ ألسنتِهم"],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((مسند الشاميين)) (2938)، وابن عبد البر في ((التمهيد)) (5/ 65) كلاهما بألفاظ مقاربة، والخرائطي في ((مكارم الأخلاق)) (477) بنحوه.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"G3zmTyRU"},{"id":"س-00121","fp":"50764317bc68","stateId":473,"easy":"إذا أطعمت الطعام وأقرأت السلام على من عرفت ومن لم تعرف ← فهو خير الإسلام","cause":"تُطعِمُ الطَّعامَ، وتَقرَأُ السَّلامَ على مَن عَرَفتَ، وعلى مَن لَم تَعرِفْ","result":"أيُّ الإسلامِ خَيرٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح البخاري 6236","srcLabel":"متفق عليه","text":["أنَّ رَجُلًا سَألَ النَّبيَّ صلَّى اللهُ عليه وسلَّم: ",["أيُّ الإسلامِ خَيرٌ",2],"؟ قال: ",["تُطعِمُ الطَّعامَ، وتَقرَأُ السَّلامَ على مَن عَرَفتَ، وعلى مَن لَم تَعرِفْ.",1]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (12)، ومسلم (39) بمثله.","bab":"آداب السلام › إفشاء السلام","dorar":"WcsiYLge"},{"id":"س-01623","fp":"c9a5d8de12de","stateId":473,"easy":"إذا سلم المسلمون من لسانك ويدك ← فهو أفضل الإسلام","cause":"من سَلِمَ المسلِمونَ مِن لِسانِه ويَدِه","result":"فأيُّ الإسلامِ أفضَلُ","explicit":true,"ref":"الحديث لابن عبدالوهاب 1/555","srcLabel":"أحمد","text":["أنَّ رَجُلًا قال للنَّبِيِّ صلَّى اللهُ عليه وسلَّم: ما الإسلامُ؟ قال: إطعامُ الطَّعامِ، ولِينُ الكلامِ، قال: فما الإيمانُ؟ قال: السَّماحةُ والصَّبرُ، قال: ",["فأيُّ الإسلامِ أفضَلُ",2],"؟ قال: ",["من سَلِمَ المسلِمونَ مِن لِسانِه ويَدِه",1],"، قالوا: يا رَسولَ اللهِ، أيُّ المؤمِنينَ أكمَلُ إيمانًا؟ قال: أحسَنُهم خُلُقًا، قال: يا رَسولَ اللهِ، أيُّ القَتلِ أشرَفُ؟ قال: مَن أُريقَ دَمُه، وعُقرَ جَوادُه، قال: فأيُّ الجِهادِ أفضَلُ؟ قال: الذين جاهَدوا بأموالِهم وأنفُسِهم في سَبيلِ اللهِ، قال: فأيُّ الصَّدَقةِ أفضَلُ؟ قال: جُهْدُ المقِلِّ، قال: فأيُّ الصَّلاةِ أفضَلُ؟ قال: طولُ القُنوتِ، قال: فأيُّ الهِجرةِ أفضَلُ؟ قال: مَن يَهجُرُ السُّوءَ"],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"هذا محفوظ عن عبيد بن عمير تارة يرسله وتارة يسنده","takhrij":"أخرجه أحمد (17027) ، وابن بشران في ((أماليه)) (566) بنحوه ، والطبراني في ((مكارم الأخلاق)) (ص370) ، والبيهقي في ((شعب الإيمان)) (8015) مختصرا .","bab":"أطعمة › إطعام الطعام","dorar":"HTivmgQK"},{"id":"س-07765","fp":"01acac98e293","stateId":474,"easy":"إذا داومت على العمل وإن قل ← فهو خير العمل","cause":"أدومُه وإنْ قلَّ","result":"وإنَّ خيرَ العملِ","explicit":true,"similar":["س-01991","س-06727"],"otherNeedIds":[23],"ref":"تفسير القرطبي 21/321","srcLabel":"متفق عليه","text":["كنتُ أجعلُ للنبيِّ صلَّى اللهُ عليْهِ وسلَّمَ حصيرًا يُصلِّي عليه من الليلِ ، فتسامعَ الناسُ به ، فلما رأى جماعتَهم كرِه ذلك ، وخشيَ أنْ يُكتبَ عليْهم قيامَ الليلِ ، فدخل البيتَ كالمغضبِ ، فجعلوا يتَنَحْنَحون ويتْفُلون ، فخرج إليهم فقال : أيُّها الناسُ اكلفوا من الأعمالِ ما تُطيقونَ ، فإنَّ اللهَ لا يملُّ من الثوابِ ، حتى تملُّوا من العملِ ، ",["وإنَّ خيرَ العملِ",2]," ",["أدومُه وإنْ قلَّ",1],". فنزلتْ : {يَا أَيُّهَا الْمُزَّمِّلُ}. فكُتبَ عليْهم ، فأنزل بمنزلةِ الفريضةِ ، حتى إنْ كان أحدُهم لَيربطُ الحبلَ فيتعلقُ به ، فمكثوا ثمانيةَ أشهرٍ ، فرحمهُم اللهُ وأنزل : {إِنَّ رَبَّكَ يَعْلَمُ أَنَّكَ تَقُومُ أَدْنى مِنْ ثُلُثَيِ اللَّيْلِ} فردَّهم اللهُ إلى الفريضةِ ، ووضع عنهم قيامَ الليلِ إلا ما تَطَوعوا"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"معناه ثابت في الصحيح إلى قوله: وإن قل","takhrij":"أخرجه ابن أبي حاتم في ((التفسير)) (19010) باختلاف يسير، وأخرجه البخاري (730، 1970) مفرقاً بلفظ مقارب، ومسلم (782) بلفظ مقارب؛ وكلاهما دون قوله: \"ونزلت ...\"","bab":"قرآن › أسباب النزول","dorar":"JB9C7gWX"},{"id":"س-01991","fp":"d8fe1652dc83","stateId":474,"easy":"إذا داومت على العمل وإن قل ← فهو أعجب العمل إلى النبي ﷺ","cause":"ما دامَ عليه، وإنْ قَلَّ","result":"أيُّ العمَلِ كانَ أعجَبَ إلى النَّبيِّ صلَّى اللهُ عليهِ وسلَّمَ","explicit":true,"repOf":"س-07765","ref":"تخريج المسند لشعيب 26479","text":["عن أبي صالِحٍ، قالَ: سُئِلَتْ عائشةُ، وأمُّ سلَمةَ، ",["أيُّ العمَلِ كانَ أعجَبَ إلى النَّبيِّ صلَّى اللهُ عليهِ وسلَّمَ",2],"؟ قالَت: ",["ما دامَ عليه، وإنْ قَلَّ",1],"."],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2856)، والنسائي (1654)، وأحمد (26479) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"F5jb4PsL"},{"id":"س-06727","fp":"42d116c5d23d","stateId":474,"easy":"إذا داومت على العمل وإن كان يسيراً ← فهو أحب العمل","cause":"ما دامَ عليهِ الإنسانُ ، وإن كانَ يسيرًا","result":"وَكانَ أحبُّ العملِ إليهِ","explicit":true,"repOf":"س-07765","ref":"صحيح النسائي 1651","text":["ما كانَ رسولُ اللَّهِ ، يمتَنِعُ من وجهي وَهوَ صائمٌ ، وما ماتَ حتَّى كانَ أَكثَرُ صلاتِه قاعِدًا ، ثمَّ ذَكرت كلِمةً – مَعناها - إلَّا المَكتوبةَ ، ",["وَكانَ أحبُّ العملِ إليهِ",2]," ، ",["ما دامَ عليهِ الإنسانُ ، وإن كانَ يسيرًا",1]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح [لغيره]","takhrij":"أخرجه النسائي (1652) بلفظه، وأحمد (25782)، وابن أبي شيبة (9497) كلاهما باختلاف يسير.","bab":"صيام › القبلة للصائم","dorar":"VMSKi5WD"},{"id":"س-02226","fp":"e65d7f7accbf","stateId":474,"easy":"إذا داومت على العمل وإن قل ← فهو أحب العمل","cause":"ما ديمَ عليهِ وإنْ قَلَّ","result":"أيُّ العملِ كان أحَبَّ إلى رسولِ اللهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"مختصر الشمائل 266","srcLabel":"مختصر الشمائل","text":[["ما ديمَ عليهِ وإنْ قَلَّ",1]," [يعني حديث: ",["أيُّ العملِ كان أحَبَّ إلى رسولِ اللهِ",2]," صلَّى اللهُ عليه وسلَّمَ ؟ قالتا : ما دِيمَ عليه وإن قَلَّ]"],"grade":"صحيح","narrator":"عائشة وأم سلمة","muhaddith":"صحيح","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"v49eYdBG"},{"id":"س-02192","fp":"be4e0c081fee","stateId":474,"easy":"إذا عملت في أيام العشر ← فلا عمل أفضل منه","cause":"في هذه الأيامِ يعني أيامَ العَشْرِ","result":"ما عملٌ أفضلُ منه","explicit":true,"star":true,"similar":["س-02092","س-04431"],"ref":"تخريج المسند لشاكر 5/54","srcLabel":"البخاري","text":[["ما عملٌ أفضلُ منه",2]," ",["في هذه الأيامِ يعني أيامَ العَشْرِ",1]," قال : فقيل : ولا الجهادُ في سبيلِ اللهِ قال : ولا الجهادُ في سبيلِ اللهِ إلا مَن خرج بنفسِه ومالِه ثم لم يَرجعْ بشيٍء من ذلكَ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (969) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"qUSnzIkH"},{"id":"س-02092","fp":"626ceb8b7037","stateId":474,"easy":"إذا عملت في عشر ذي الحجة ← فهي أفضل أيام الدنيا","cause":"العَشرُ","result":"أفضَلُ أيَّامِ الدُّنيا","explicit":true,"repOf":"س-02192","ref":"فتح الغفار 659/2","text":[["أفضَلُ أيَّامِ الدُّنيا",2]," ",["العَشرُ",1]," -يعني: عَشرَ ذي الحِجَّةِ. قيلَ: ولا مِثلُهُنَّ في سَبيلِ اللهِ؟ قال: ولا مِثلُهُنَّ في سَبيلِ اللهِ، إلَّا رَجُلٌ عُفِّرَ وَجْهُه في التُّرابِ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده حسن [وروي] بنحوه بإسناد صحيح","takhrij":"أخرجه الشجري في ((الأمالي)) (1687)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"PSs2GUg8"},{"id":"س-04431","fp":"a9581e33ecb9","stateId":474,"easy":"إذا عملت في عشر ذي الحجة ← فهو أفضل العمل","cause":"في هذه","result":"ما العَمَلُ في أيَّامٍ أفضَلَ منها","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-02192","ref":"صحيح البخاري 969","text":[["ما العَمَلُ في أيَّامٍ أفضَلَ منها",2]," ",["في هذه",1],"، قالوا: ولا الجِهادُ؟ قال: ولا الجِهادُ، إلَّا رَجُلٌ خَرَجَ يُخاطِرُ بنَفسِه ومالِه، فلَم يَرجِعْ بشَيءٍ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (969)","bab":"جهاد › فضل الجهاد","dorar":"LuIPnV7V"},{"id":"س-02133","fp":"e28d714cccba","stateId":474,"easy":"إذا عملت الخير في عشر الأضحى ← فهو أزكى العمل عند الله","cause":"خيرٍ عُمِلَ في العَشْرِ منَ الأضحى","result":"ما من عمَلٍ أزْكَى عندَ اللهِ عزَّ وجلَّ ولا أعظَمَ مَنزِلةً من","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"تخريج مشكل الآثار 2970","srcLabel":"البيهقي","text":[["ما من عمَلٍ أزْكَى عندَ اللهِ عزَّ وجلَّ ولا أعظَمَ مَنزِلةً من",2]," ",["خيرٍ عُمِلَ في العَشْرِ منَ الأضحى",1],"، قيل: يا رسولَ اللهِ، ولا مَن جاهَدَ في سَبيلِ اللهِ بنفْسِهِ ومالِهِ، قال: ولا مَن جاهَدَ في سَبيلِ اللهِ بنفَسْهِ ومالِهِ إلَّا مَن لمْ يَرجِعْ بنفْسِهِ ومالِهِ."],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده قوي","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (2970)، والدارمي (1815)، والبيهقي في ((شعب الإيمان)) (3476) جميعهم بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"LeUtsr32"}]}