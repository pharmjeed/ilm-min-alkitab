{"schema":1,"kind":"sunan-chunk","version":"sunan-50a61695a4db","needId":46,"stateIds":[417,418,419,420,421,422,423],"items":[{"id":"س-05645","fp":"f1dbb526aed0","stateId":417,"easy":"إذا اتقيت الله ← لن تزال بخير","cause":"ما اتَّقى اللهَ","result":"لَن يَزالَ بخَيرٍ","explicit":true,"star":true,"ref":"صحيح البخاري 2964","srcLabel":"متفق عليه","text":["لقد أتاني اليومَ رَجُلٌ، فسَألَني عن أمرٍ ما دَرَيتُ ما أرُدُّ عليه، فقال: أرَأيتَ رَجُلًا مُؤْدِيًا نَشيطًا، يَخرُجُ مع أُمَرائِنا في المَغازي، فيَعزِمُ علينا في أشياءَ لا نُحصيها؟ فقُلتُ له: واللهِ ما أدري ما أقولُ لَكَ، إلَّا أنَّا كُنَّا مع النَّبيِّ صلَّى اللهُ عليه وسلَّم، فعَسى أن لا يَعزِمَ علينا في أمرٍ إلَّا مَرَّةً حتَّى نَفعَلَه، وإنَّ أحَدَكُم ",["لَن يَزالَ بخَيرٍ",2]," ",["ما اتَّقى اللهَ",1],"، وإذا شَكَّ في نَفسِه شيءٌ سَألَ رَجُلًا فشَفاه منه، وأوشَكَ أن لا تَجِدوه، والذي لا إلَهَ إلَّا هو ما أذكُرُ ما غَبَرَ مِنَ الدُّنيا إلَّا كالثَّغْبِ؛ شُرِبَ صَفوُه، وبَقيَ كَدَرُه."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"من أفراد البخاري على مسلم","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"kTdtLpUs","merged":2,"otherRefs":["المستدرك على الصحيحين 425 (صحيح)"]},{"id":"س-06178","fp":"b102646bef72","stateId":417,"easy":"إذا صدقت في أداء الفرائض بلا زيادة ولا نقص ← أفلحت ودخلت الجنة","cause":"لا أتَطَوَّعُ شيئًا، ولا أنقُصُ ممَّا فرَضَ اللهُ عليَّ شيئًا","result":"أفلَحَ إن صَدَقَ، أو: دَخَلَ الجَنَّةَ إن صَدَقَ","explicit":true,"star":true,"otherNeedIds":[55],"ref":"صحيح البخاري 6956","srcLabel":"مسلم","text":["أنَّ أعرابيًّا جاءَ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم ثائِرَ الرَّأسِ، فقال: يا رَسولَ اللهِ، أخبِرْني ماذا فرَضَ اللهُ عليَّ مِنَ الصَّلاةِ؟ فقال: الصَّلَواتِ الخَمسَ إلَّا أن تَطَوَّعَ شيئًا، فقال: أخبِرْني بما فرَضَ اللهُ عليَّ مِنَ الصِّيامِ، قال: شَهرَ رَمَضانَ إلَّا أن تَطَوَّعَ شيئًا، قال: أخبِرْني بما فرَضَ اللهُ عليَّ مِنَ الزَّكاةِ، قال: فأخبَرَه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم شَرائِعَ الإسلامِ. قال: والذي أكرَمَكَ، ",["لا أتَطَوَّعُ شيئًا، ولا أنقُصُ ممَّا فرَضَ اللهُ عليَّ شيئًا",1],". فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["أفلَحَ إن صَدَقَ، أو: دَخَلَ الجَنَّةَ إن صَدَقَ",2],"."],"grade":"صحيح","narrator":"طلحة بن عبيدالله","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (11)، وأبو داود (391)، والنسائي (458) باختلاف يسير.","bab":"زكاة › فرض الزكاة","dorar":"5UPrnIEu","merged":3,"otherRefs":["أعلام الموقعين 3/47 (صحيح)","صحيح البخاري 1891 (صحيح)"]},{"id":"س-07374","fp":"c32bf1cda003","stateId":417,"easy":"إذا قلت «لا إله إلا الله» ← تفلح","cause":"قولوا: لا إلهَ إلَّا اللهُ","result":"تُفلِحوا","explicit":true,"star":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"ref":"تخريج المسند لشعيب 23192","srcLabel":"أحمد","text":["حَدَّثَني شَيخٌ مِن بَني مالكِ بنِ كِنانةَ قال: رَأيتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ بسوقِ ذي المَجازِ، يَتخلَّلُها يقولُ: يا أيُّها النَّاسُ، ",["قولوا: لا إلهَ إلَّا اللهُ",1]," ",["تُفلِحوا",2],"، قال: وأبو جَهلٍ يَحثي عليه التُّرابَ، ويقولُ: أيُّها النَّاسُ، لا يَغُرَّنَّكم هذا عن دِينِكم؛ فإنَّما يُريدُ لِتَترُكوا آلهتَكم، ولِتَترُكوا اللَّاتَ والعُزَّى، قال: وما يَلتَفِتُ إليه رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ. قال: قُلْنا: انعَتْ لنا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، قال: بيْنَ بُردَينِ أحمَرينِ، مَربوعٌ كَثيرُ اللَّحمِ، حَسَنُ الوَجْهِ، شَديدُ سَوادِ الشَّعَرِ، أبيَضُ شَديدُ البَياضِ، سابِغُ الشَّعَرِ."],"grade":"صحيح","narrator":"رجال من الصحابة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (23192)","bab":"فضائل النبي وصفته ودلائل النبوة › أحوال النبي","dorar":"sFyyytsN","merged":6,"otherRefs":["تخريج المسند لشعيب 19004 (صحيح)","تخريج المسند لشعيب 23151 (صحيح)","سبل الهدى والرشاد 2/452 (حسن)","تخريج المسند لشعيب 16023 (صحيح)"]},{"id":"ق-0067","fp":"63fbeb67f3e2","stateId":417,"easy":"التقوى وإتيان الأمور من أبوابها ← الفلاح","cause":"التقوى وإتيان الأمور من أبوابها","result":"الفلاح","explicit":true,"star":true,"ref":"سورة البقرة: 189","srcLabel":"القرآن الكريم","quran":{"s":2,"from":189,"to":189,"text":"يَسْأَلُونَكَ عَنِ الْأَهِلَّةِ قُلْ هِيَ مَوَاقِيتُ لِلنَّاسِ وَالْحَجِّ وَلَيْسَ الْبِرُّ بِأَنْ تَأْتُوا الْبُيُوتَ مِنْ ظُهُورِهَا وَلَكِنَّ الْبِرَّ مَنِ اتَّقَى وَأْتُوا الْبُيُوتَ مِنْ أَبْوَابِهَا وَاتَّقُوا اللَّهَ لَعَلَّكُمْ تُفْلِحُونَ (189)","hl":[[205,247,1]]}},{"id":"ق-0160","fp":"8f6243fdcdae","stateId":417,"easy":"ترك الربا والتقوى ← الفلاح","cause":"ترك الربا والتقوى","result":"الفلاح","explicit":true,"star":true,"ref":"سورة آل عمران: 130","srcLabel":"القرآن الكريم","quran":{"s":3,"from":130,"to":130,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَأْكُلُوا الرِّبَا أَضْعَافًا مُضَاعَفَةً وَاتَّقُوا اللَّهَ لَعَلَّكُمْ تُفْلِحُونَ (130)","hl":[[0,120,1]]}},{"id":"ق-0202","fp":"38eac771344f","stateId":417,"easy":"الصبر والمصابرة والمرابطة والتقوى ← الفلاح","cause":"الصبر والمصابرة والمرابطة والتقوى","result":"الفلاح","explicit":true,"ref":"سورة آل عمران: 200","srcLabel":"القرآن الكريم","quran":{"s":3,"from":200,"to":200,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اصْبِرُوا وَصَابِرُوا وَرَابِطُوا وَاتَّقُوا اللَّهَ لَعَلَّكُمْ تُفْلِحُونَ (200)","hl":[[0,107,1]]}},{"id":"ق-0303","fp":"dcd313001ceb","stateId":417,"easy":"التقوى وابتغاء الوسيلة إلى الله والجهاد في سبيله ← الفلاح","cause":"التقوى وابتغاء الوسيلة إلى الله والجهاد في سبيله","result":"الفلاح","explicit":true,"ref":"سورة المائدة: 35","srcLabel":"القرآن الكريم","quran":{"s":5,"from":35,"to":35,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَابْتَغُوا إِلَيْهِ الْوَسِيلَةَ وَجَاهِدُوا فِي سَبِيلِهِ لَعَلَّكُمْ تُفْلِحُونَ (35)","hl":[[0,131,1]]}},{"id":"ق-0334","fp":"6bcc40525a47","stateId":417,"easy":"اجتناب الخمر والميسر والأنصاب والأزلام ← الفلاح","cause":"اجتناب الخمر والميسر والأنصاب والأزلام","result":"الفلاح","explicit":true,"ref":"سورة المائدة: 90","srcLabel":"القرآن الكريم","quran":{"s":5,"from":90,"to":90,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنَّمَا الْخَمْرُ وَالْمَيْسِرُ وَالْأَنْصَابُ وَالْأَزْلَامُ رِجْسٌ مِنْ عَمَلِ الشَّيْطَانِ فَاجْتَنِبُوهُ لَعَلَّكُمْ تُفْلِحُونَ (90)","hl":[[126,164,1]]}},{"id":"ق-0339","fp":"7f47ce75a3f7","stateId":417,"easy":"تقوى الله وترك الاغترار بكثرة الخبيث ← الفلاح","cause":"تقوى الله وترك الاغترار بكثرة الخبيث","result":"الفلاح","explicit":true,"ref":"سورة المائدة: 100","srcLabel":"القرآن الكريم","quran":{"s":5,"from":100,"to":100,"text":"قُلْ لَا يَسْتَوِي الْخَبِيثُ وَالطَّيِّبُ وَلَوْ أَعْجَبَكَ كَثْرَةُ الْخَبِيثِ فَاتَّقُوا اللَّهَ يَا أُولِي الْأَلْبَابِ لَعَلَّكُمْ تُفْلِحُونَ (100)","hl":[[81,147,1]]}},{"id":"ق-0431","fp":"85693f256d7c","stateId":417,"easy":"الإيمان بالنبي وتعزيره ونصره واتباع النور الذي أنزل معه ← الفلاح","cause":"الإيمان بالنبي وتعزيره ونصره واتباع النور الذي أنزل معه","result":"الفلاح","explicit":true,"ref":"سورة الأعراف: 157","srcLabel":"القرآن الكريم","quran":{"s":7,"from":157,"to":157,"text":"الَّذِينَ يَتَّبِعُونَ الرَّسُولَ النَّبِيَّ الْأُمِّيَّ الَّذِي يَجِدُونَهُ مَكْتُوبًا عِنْدَهُمْ فِي التَّوْرَاةِ وَالْإِنْجِيلِ يَأْمُرُهُمْ بِالْمَعْرُوفِ وَيَنْهَاهُمْ عَنِ الْمُنْكَرِ وَيُحِلُّ لَهُمُ الطَّيِّبَاتِ وَيُحَرِّمُ عَلَيْهِمُ الْخَبَائِثَ وَيَضَعُ عَنْهُمْ إِصْرَهُمْ وَالْأَغْلَالَ الَّتِي كَانَتْ عَلَيْهِمْ فَالَّذِينَ آمَنُوا بِهِ وَعَزَّرُوهُ وَنَصَرُوهُ وَاتَّبَعُوا النُّورَ الَّذِي أُنْزِلَ مَعَهُ أُولَئِكَ هُمُ الْمُفْلِحُونَ (157)","hl":[[328,453,1]]}},{"id":"ق-0582","fp":"c2b3344968b2","stateId":417,"easy":"الصبر ← حسن العاقبة للمتقين","cause":"الصبر","result":"حسن العاقبة للمتقين","explicit":true,"ref":"سورة هود: 49","srcLabel":"القرآن الكريم","quran":{"s":11,"from":49,"to":49,"text":"تِلْكَ مِنْ أَنْبَاءِ الْغَيْبِ نُوحِيهَا إِلَيْكَ مَا كُنْتَ تَعْلَمُهَا أَنْتَ وَلَا قَوْمُكَ مِنْ قَبْلِ هَذَا فَاصْبِرْ إِنَّ الْعَاقِبَةَ لِلْمُتَّقِينَ (49)","hl":[[114,157,1]]}},{"id":"ق-0842","fp":"efa8096678b2","stateId":417,"easy":"ثقل الموازين بالعمل الصالح ← الفلاح","cause":"ثقل الموازين بالعمل الصالح","result":"الفلاح","explicit":true,"otherNeedIds":[53],"ref":"سورة المؤمنون: 102","srcLabel":"القرآن الكريم","quran":{"s":23,"from":102,"to":102,"text":"فَمَنْ ثَقُلَتْ مَوَازِينُهُ فَأُولَئِكَ هُمُ الْمُفْلِحُونَ (102)","hl":[[0,60,1]]}},{"id":"ق-0857","fp":"e99c210d3257","stateId":417,"easy":"التوبة إلى الله جميعاً ← الفلاح","cause":"التوبة إلى الله جميعاً","result":"الفلاح","explicit":true,"otherNeedIds":[11],"ref":"سورة النور: 31","srcLabel":"القرآن الكريم","quran":{"s":24,"from":31,"to":31,"text":"وَقُلْ لِلْمُؤْمِنَاتِ يَغْضُضْنَ مِنْ أَبْصَارِهِنَّ وَيَحْفَظْنَ فُرُوجَهُنَّ وَلَا يُبْدِينَ زِينَتَهُنَّ إِلَّا مَا ظَهَرَ مِنْهَا وَلْيَضْرِبْنَ بِخُمُرِهِنَّ عَلَى جُيُوبِهِنَّ وَلَا يُبْدِينَ زِينَتَهُنَّ إِلَّا لِبُعُولَتِهِنَّ أَوْ آبَائِهِنَّ أَوْ آبَاءِ بُعُولَتِهِنَّ أَوْ أَبْنَائِهِنَّ أَوْ أَبْنَاءِ بُعُولَتِهِنَّ أَوْ إِخْوَانِهِنَّ أَوْ بَنِي إِخْوَانِهِنَّ أَوْ بَنِي أَخَوَاتِهِنَّ أَوْ نِسَائِهِنَّ أَوْ مَا مَلَكَتْ أَيْمَانُهُنَّ أَوِ التَّابِعِينَ غَيْرِ أُولِي الْإِرْبَةِ مِنَ الرِّجَالِ أَوِ الطِّفْلِ الَّذِينَ لَمْ يَظْهَرُوا عَلَى عَوْرَاتِ النِّسَاءِ وَلَا يَضْرِبْنَ بِأَرْجُلِهِنَّ لِيُعْلَمَ مَا يُخْفِينَ مِنْ زِينَتِهِنَّ وَتُوبُوا إِلَى اللَّهِ جَمِيعًا أَيُّهَ الْمُؤْمِنُونَ لَعَلَّكُمْ تُفْلِحُونَ (31)","hl":[[658,737,1]]}},{"id":"ق-0864","fp":"7bc6c6dbff61","stateId":417,"easy":"قول «سمعنا وأطعنا» عند الدعوة إلى حكم الله ورسوله ← الفلاح","cause":"قول «سمعنا وأطعنا» عند الدعوة إلى حكم الله ورسوله","result":"الفلاح","explicit":true,"apply":{"k":"say","t":"«سمعنا وأطعنا»"},"ref":"سورة النور: 51","srcLabel":"القرآن الكريم","quran":{"s":24,"from":51,"to":51,"text":"إِنَّمَا كَانَ قَوْلَ الْمُؤْمِنِينَ إِذَا دُعُوا إِلَى اللَّهِ وَرَسُولِهِ لِيَحْكُمَ بَيْنَهُمْ أَنْ يَقُولُوا سَمِعْنَا وَأَطَعْنَا وَأُولَئِكَ هُمُ الْمُفْلِحُونَ (51)","hl":[[0,166,1]]}},{"id":"ق-0865","fp":"37c33fac5455","stateId":417,"easy":"طاعة الله ورسوله وخشية الله وتقواه ← الفوز","cause":"طاعة الله ورسوله وخشية الله وتقواه","result":"الفوز","explicit":true,"similar":["ق-1004"],"ref":"سورة النور: 52","srcLabel":"القرآن الكريم","quran":{"s":24,"from":52,"to":52,"text":"وَمَنْ يُطِعِ اللَّهَ وَرَسُولَهُ وَيَخْشَ اللَّهَ وَيَتَّقْهِ فَأُولَئِكَ هُمُ الْفَائِزُونَ (52)","hl":[[0,93,1]]}},{"id":"ق-0924","fp":"da8ef6bed2f7","stateId":417,"easy":"التوبة والإيمان والعمل الصالح ← رجاء الفلاح","cause":"التوبة والإيمان والعمل الصالح","result":"رجاء الفلاح","explicit":true,"otherNeedIds":[11],"ref":"سورة القصص: 67","srcLabel":"القرآن الكريم","quran":{"s":28,"from":67,"to":67,"text":"فَأَمَّا مَنْ تَابَ وَآمَنَ وَعَمِلَ صَالِحًا فَعَسَى أَنْ يَكُونَ مِنَ الْمُفْلِحِينَ (67)","hl":[[9,86,1]]}},{"id":"ق-1004","fp":"a3577ea56cf4","stateId":417,"easy":"طاعة الله ورسوله ← الفوز العظيم","cause":"طاعة الله ورسوله","result":"الفوز العظيم","explicit":true,"repOf":"ق-0865","ref":"سورة الأحزاب: 71","quran":{"s":33,"from":71,"to":71,"text":"يُصْلِحْ لَكُمْ أَعْمَالَكُمْ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ وَمَنْ يُطِعِ اللَّهَ وَرَسُولَهُ فَقَدْ فَازَ فَوْزًا عَظِيمًا (71)","hl":[[60,123,1]]}},{"id":"ق-1458","fp":"acd0ef4b92f1","stateId":417,"easy":"الإيمان والعمل الصالح والتواصي بالحق والتواصي بالصبر ← النجاة من الخسر","cause":"الإيمان والعمل الصالح والتواصي بالحق والتواصي بالصبر","result":"النجاة من الخسر","explicit":true,"ref":"سورة العصر: 1–3","srcLabel":"القرآن الكريم","quran":{"s":103,"from":1,"to":3,"text":"وَالْعَصْرِ (1) إِنَّ الْإِنْسَانَ لَفِي خُسْرٍ (2) إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ (3)","hl":[[0,150,1]]}},{"id":"س-07383","fp":"d9e609952083","stateId":417,"easy":"إذا أسلمت وأنت تملك أمرك ← أفلحت كل الفلاح","cause":"لو قلتَها وأنتَ تملِكُ أمرَكَ","result":"أفلَحتَ كلَّ الفلاح","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح أبي داود 3316","srcLabel":"مسلم","text":["عن عِمرانَ بنِ حُصَيْنٍ، قالَ : كانتِ العضباءُ لرَجلٍ من بَني عُقَيْلٍ وَكانت من سَوابقِ الحاجِّ، قالَ فأُسِرَ فأتى النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ وَهوَ في وثاقٍ والنَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ على حِمارٍ عليهِ قطيفةٌ، فقالَ: يا محمَّدُ علامَ تأخذُني، وتَأخذُ سابقةَ الحاجِّ قالَ: نأخذُكَ بجريرةِ حلفائِكَ ثَقيفٍ قالَ: وَكانَ ثقيفُ قد أسروا رجُلَيْنِ مِن أصحابِ النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ، قالَ: وقد قالَ: فيما قالَ: وأَنا مُسلمٌ - أو قالَ: وقد أسلَمتُ - فلمَّا مضى النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ أبو داودَ: فَهِمْتُ هذا من محمَّدِ بنِ عيسى ناداهُ يا محمَّدُ يا محمَّدُ قالَ: وَكانَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ رحيمًا رفيقًا فرجعَ إليهِ فقالَ: ما شأنُكَ ؟ قالَ: إنِّي مُسلمٌ، قالَ: ",["لو قلتَها وأنتَ تملِكُ أمرَكَ",1]," ",["أفلَحتَ كلَّ الفلاح",2]," قالَ أبو داودَ: ثمَّ رجَعتُ إلى حديثِ سُلَيْمانَ قالَ: يا محمَّدُ إنِّي جائعٌ فأطعِمني، إنِّي ظمآنٌ فاسقِني، قالَ: فقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ: هذِهِ حاجتُكَ أو قالَ: هذِهِ حاجتُهُ قالَ ففوديَ الرَّجلُ بعدُ بالرَّجُلَيْنِ، قالَ: وحبَسَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ العَضباءَ لرَحلِهِ، قالَ: فأغارَ المشرِكونَ على سرحِ المدينةِ فذَهَبوا بالعَضباءِ، قالَ: فلمَّا ذَهَبوا بِها، وأسَروا امرأةً منَ المسلِمينَ، قالَ فَكانوا إذا كانَ اللَّيلُ يريحونَ إبلَهُم في أفنيتِهِم، قالَ: فنوِّموا ليلةً، وقامَتِ المرأةُ فجعَلت لا تضعُ يدَها على بعيرٍ إلَّا رغا حتَّى أتت علَى العضباءِ، قالَ: فأتَت علَى ناقةٍ ذَلولٍ مجرَّسةٍ، قالَ: فرَكِبتها ثمَّ جعَلت للَّهِ عليها إن نجَّاها اللَّهُ لتنحَرنَّها، قالَ: فلمَّا قدمتِ المدينةَ عُرِفتِ النَّاقةُ ناقةُ النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ فأُخْبِرَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ بذلِكَ فأرسلَ إليها فجيءَ بِها وأُخْبِرَ بنذرِها فقالَ: بئسَ ما جَزَيتيها - أو جزَتها - إنِ اللَّهُ أنجاها علَيها لتنحرنَّها لا وَفاءَ لنذرٍ في مَعصيةِ اللَّهِ، ولا فيما لا يملِكُ ابنُ آدَمَ قالَ أبو داودَ: والمرأةُ هذِهِ امرأةُ أبي ذرٍّ"],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3316) واللفظ له، وأخرجه مسلم (1641) باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › أخلاق النبي","dorar":"oCDPWQyi","merged":2,"otherRefs":["تخريج صحيح ابن حبان 4859 (صحيح)"]},{"id":"س-03490","fp":"063e1494c188","stateId":417,"easy":"إذا تعرضت لنفحات الله ← لعلك تصيب نفحة لا تشقى بعدها أبداً","cause":"فتَعَرَّضوا له","result":"لعله أن يصيبَكم نَفْحَةٌ منها فلا تَشْقَوْنَ بعدها أبدًا","explicit":true,"otherNeedIds":[23],"ref":"أطراف الغرائب 2/126","srcLabel":"مسلم","text":["حديثُ: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: إنَّ لِرَبِّكم عزَّ وجَلَّ [في أيامِ دهرِكم نَفَحاتٍ ، ",["فتَعَرَّضوا له",1]," ، ",["لعله أن يصيبَكم نَفْحَةٌ منها فلا تَشْقَوْنَ بعدها أبدًا",2],"]"],"grade":"حسن","narrator":"محمد بن مسلمة","muhaddith":"غريبٌ من حديث محمد بن مسلمة، تَفَرَّدَ بهِ منصور بن أبي الأسود، بهذا الإسناد ولم يروه عنه غير ابن أخيه الحسن بن صالح بن أبي الأسود.","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"XvPn8U4D"},{"id":"س-01689","fp":"eacae45c12fa","stateId":417,"easy":"إذا اتقيت الله ← فهي رأس الأمر كله","cause":"أوصيكَ بتقوى اللهِ","result":"فإنَّهُ رأسُ الأمرِ كلِّهِ","explicit":true,"otherNeedIds":[17],"ref":"النوافح العطرة 227","srcLabel":"أحمد","text":["قُلِ الحقَّ وإن كان مُرًّا [يعني حديث: دخَلتُ علَى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وهو في المسجِدِ جالِسٌ، فاغتَنَمتُ خلوتَهُ، وحدَهُ، فجلَستُ إليهِ، فقالَ : أبا ذَرٍّ ! إن لِلمَسجِد تَحيَّةً، وإنَّ تحيَّتَهُ ركعتان فقُم فاركَعهما، قالَ : فقُمت فركَعتُها ثم عُدتُ فجلَستُ إليهِ، فقُلتُ : يا رسولَ اللهِ ! إنَّكَ أمَرتَني بالصَّلاةِ فما الصَّلاةُ ؟ قال : خيرٌ موضوعٌ استكثِرْ أو استَقِلَّ. قلتُ : يا رسولَ اللهِ ! فأيُّ الأعمالِ أفضَلُ ؟ قال : إيمانٌ باللَّهِ عزَّ وجلَّ، وجهادٌ في سبيلِهِ، قال : قلتُ : يا رسولَ اللهِ ! فأيُّ المؤمنينَ أكمَلُهم إيمانًا ؟ قالَ : أحسَنُهُم خُلُقًا. قالَ : قلتُ : يا رسولَ اللَّهِ ! فأيُّ المؤمنينَ أسلَمُ ؟ قالَ : مَن سلِمَ النَّاسُ من لسانِهِ ويدِهِ. قال : قلتُ : يا رسولَ اللَّهِ ! فأيُّ الهجرةِ أفضَلُ ؟ قال : مَن هجرَ السَّيِّئاتِ. قالَ : قُلتُ : يا رسولَ اللهِ ! فأيُّ الصَّلاةِ أفضَلُ ؟ قال : طولُ القنوتِ . قال : قلتُ : يا رسولَ اللهِ ! فما الصِّيامُ ؟ قالَ : فرضٌ مَجزيٌّ ، وعندَ اللهِ أضعافٌ كثيرةٌ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ الجهادِ أفضَلُ ؟ قالَ : مَن عُقِرَ جوادُهُ وأهريقَ دمُهُ. قال : قُلتُ : يا رسولَ اللهِ ! فأيُّ الرِّقابِ أفضَلُ ؟ قالَ : أغلاها ثَمنًا وأنفَسُها عندَ ربِّها. قالَ : قلتُ : يا رسولَ اللهِ ! فأيُّ الصَّدقةِ أفضَلُ ؟ قال : جُهدٌ مِن مُقِلٍّ يُسَرُّ إلى فقيرٍ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ آيةٍ مِمَّا أنزلَ اللهُ عزَّ وجلَّ عليكَ أعظَمُ ؟ قال : آيةُ الكُرسيِّ. ثُمَّ قالَ : يا أبا ذَرٍّ ! ما السَّماواتُ السَّبعُ معَ الكُرسيِّ إلا كَحلقَةٍ مُلقاةٍ بأرضِ فلاةٍ، وفَضلُ العَرشِ على الكُرسيِّ كفَضلِ الفَلاةِ علَى الحَلقَةِ. قلتُ : يا رسولَ اللهِ ! كم الأنبياءُ ؟ قال : مائةُ ألفٍ وأربعةٌ وعِشرونَ ألفًا. قلتُ : يا رسولَ اللهِ ! كم الرُّسلِ ؟ قالَ : ثلاثُمائةٍ وثلاثَةُ عشرَ جَمًّا غفيرًا. قلتُ : كثيرٌ طيِّبٌ، قلتُ : يا رسولَ اللهِ ! مَن كان أوَّلُهمْ ؟ قال : آدَمُ. قلتُ : يا رسولَ اللهِ ! أنَبيٌّ مُرسَلٌ ؟ قال : نعَم، خلقَهُ اللهُ بيدِهِ، ونفخَ فيهِ مِن روحِهِ، ثُمَّ سوَّاهُ قِبَلًا. وقال أحمدُ بنُ أنَسٍ ثُمَّ كلَّمهُ قِبَلًا. ثُمَّ قالَ : يا أبا ذَرٍّ ! أربعةٌ سُريانيُّونَ؛ آدَمُ، وشيثُ، وخَنوخُ - وهو إدريسُ، وهم أوَّلُ مَن خطَّ بالقلَمِ - ونوحٌ. وأربعةٌ من العَربِ؛ هودٌ، وصالِحٌ، وشُعَيبٌ، ونبيُّكَ يا أبا ذَرٍّ. قال : قلتُ : يا رسولَ اللهِ ! كَم كتابٌ أنزلَهُ اللَّهُ تعالى ؟ قال : مائةُ كتابٍ وأربعةُ كتُبٍ، أنزلَ علَى شيثَ خَمسونَ صحيفَةً، وأنزلَ علَى خَنوخَ ثلاثونَ صَحيفةً، وأنزلَ على إبراهيمَ عشرَ صحائفَ، وأنزلَ على موسَى قبلَ التَّوراةِ عَشرَ صحائفَ، وأنزلَ التَّوراةَ والإنجيلَ والزَّبورَ والفُرقانَ. قال : قلتُ : يا رسولَ اللهِ ! فَما كانَت صُحفُ إبراهيمَ ؟ قالَ : كانَت أمثالًا كلُّها : أيُّها الملِكُ المسلَّطُ المبتَلَى المغرورُ، فإنِّي لم أبعثْكَ لتجمَعَ الدُّنيا بعضَها إلى بعضٍ، ولكن بعثتُكَ لترُدَّ عنِّي دعوةَ المظلومِ، فإنِّي لا أردُّها ولَو كانَت مِن كافِرٍ. وكانَت فيها أمثالٌ : علَى العاقِلِ ما لَم يكُن مغلوبًا علَى عقلِهِ أن تكونَ له ساعاتٌ؛ ساعَةٌ يُناجي فيها ربَّهُ عزَّ وجلَّ، وساعةٌ يحاسِبُ فيها نفسَهُ، وساعَةٌ يفكِّرُ فيها في صُنعِ اللَّهِ عزَّ وجلَّ، وساعةٌ يخلو فيها بحاجتِهِ من المطعَمِ والمشرَبِ، وعلى العاقلِ أن لا يكون ظاعِنًا إلَّا لثلاثٍ؛ تزوُّدٍ لمعادٍ، أو مرمَّةٍ لمعاشٍ، أو لذَّةٍ في غيرِ محرَّمٍ، وعلى العاقِلِ أن يكونَ بصيرًا بزمانِهِ، مقبِلًا على شأنِهِ، حافِظًا للسانِهِ، ومن حسَبَ كلامَهُ من عمَلِهِ قلَّ كلامُهُ إلا فيما يعنيهِ. قلتُ : يا رسولَ اللَّهِ ! فما كان صحُفُ موسَى عليهِ السَّلامُ ؟ قال : كانَت عبرًا كلَّها، عجبتُ لمن أيقنَ بالموتِ ثُمَّ هو يفرَحُ، عجبتُ لمن أيقنَ بالنَّارِ وهو يضحَكُ، عجبتُ لمن أيقنَ للقدرِ ثم هو ينصَبُ، عجبتُ لمن رأى الدُّنيا وتقلُّبَها ثُمَّ اطمأنَّ إليها، عجِبتُ لمن أيقنَ بالحسابِ غدًا ثُمَّ لا يعمَلُ. قلتُ : يا رسولَ اللهِ ! أوصِني. قال : ",["أوصيكَ بتقوى اللهِ",1]," ",["فإنَّهُ رأسُ الأمرِ كلِّهِ",2],"، قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بتلاوَةِ القرآنِ فإنَّهُ نور لكَ في الأرضِ وذكرٌ لكَ في السَّماءِ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : إيَّاكَ وكثرةَ الضَّحِكِ فإنَّهُ يُميتُ القَلبَ، ويَذهَبُ بنورِ الوَجهِ، قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : عليكَ بالصَّمتِ إلَّا مِن خيرٍ، فإنَّهُ مطردَةٌ للشَّيطانِ عنكَ، وعونٌ لكَ علَى أمر دينِكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بالجهادِ فإنَّهُ رهبانيَّةُ أمَّتي. قلتُ : يا رسولَ اللهِ ! زِدني. قال : حبُّ المساكينِ وجالِسهُم. قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : انظُر إلى مَن تحتَكَ ولا تنظُر إلى مَن فوقكَ فإنَّهُ أجدَرُ أن لا تَزدَري نِعمةَ اللهِ عندكَ. قلتُ : زِدني يا رسولَ اللهِ ! قال : صِلْ قرابَتَكَ وإن قَطعوكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : لا تَخَف في اللَّهِ تعالى لَومَةَ لائمٍ. قلتُ : يا رسولَ اللهِ ! زِدني. قالَ : قُل الحقَّ وإن كان مُرًّا. قلتُ : يا رسولَ اللهِ ! زِدني. قال : يردُّكَ عن النَّاسِ ما تعرفُ من نفسِكَ، ولا تجِد عليهِم فيما تأتي، وكفَى به عيبًا أن تعرِفَ من النَّاسِ ما تجهَلُ من نفسِكَ، أو تجِدُ عليهِم فيما تأتي. ثُمَّ ضربَ بيدِهِ علَى صدري، فقالَ : يا أبا ذَرٍّ ! لا عقلَ كالتَّدبيرِ، ولا ورعَ كالكَفِّ، ولا حسَبَ كحُسنِ الخُلُقِ، قلتُ : يارسولَ اللهِ ! هل لي في الدُّنيا شَيءٌ مِمَّا أنزلَ اللهُ عليكَ مِمَّا كان في صحُفِ إبراهيمَ وموسَى ؟ قال : يا أبا ذَرٍّ ! اقرَأ : ? قَد أفلَحَ مَن تزَكَّى? إلى آخرِ السُّورَةِ]"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مطولاً أحمد (21415)، والبزار (3966) باختلاف يسير، وابن حبان (361) واللفظ له","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"wZID7EAR"},{"id":"س-03208","fp":"c3226f70ac45","stateId":417,"easy":"إذا فعلت ذلك (من الخير) ← لم تدع للخير مطلباً ولا من الشر مهرباً","cause":"فمَنْ فعلَ ذلكَ","result":"لمْ يَدَعْ لِلْخَيْرِ مَطْلَبًا ، ولا مِنَ الشَّرِّ مَهْرَبًا","explicit":true,"ref":"صحيح الموارد 1313","srcLabel":"النسائي","text":["أنا زَعِيمٌ – والزَّعِيمُ الحَمِيلُ – لِمَنْ آمَنَ وأسلمَ وهاجَرَ ؛ بِبَيْتٍ في رَبَضِ الجنةِ ، وبِبَيْتٍ في وسَطِ الجنةِ ، وأنا زَعِيمٌ لِمَنْ آمَنَ بي وأسلمَ وجَاهَدَ في سبيلِ اللهِ ؛ بِبَيْتٍ في رَبَضِ الجنةِ ، وبِبَيْتٍ في وسَطِ الجنةِ ، وببيتٍ في أعَلَى غُرَفِ الجنةِ ، ",["فمَنْ فعلَ ذلكَ",1]," ؛ ",["لمْ يَدَعْ لِلْخَيْرِ مَطْلَبًا ، ولا مِنَ الشَّرِّ مَهْرَبًا",2]," ، يموتُ حيثُ شاءَ أنْ يَمُوتَ"],"grade":"صحيح","narrator":"فضالة بن عبيد","muhaddith":"صحيح","takhrij":"أخرجه النسائي (3133)، وابن حبان (353)، والبزار (3754) باختلاف يسير.","bab":"إيمان › فضل الإيمان","dorar":"eO6tsdoY"},{"id":"س-05553","fp":"75695fb812b1","stateId":417,"easy":"إذا ابتغيت بعملك وجه الله ← نجوت من لعنة الدنيا","cause":"ما ابتُغِيَ بِهِ وجهُ اللهِ عزَّ وجَلَّ","result":"الدنيا ملعونَةٌ ، ملْعُونٌ مَّا فيها ، إلَّا","explicit":true,"otherNeedIds":[27],"ref":"الجامع الصغير 4267","srcLabel":"الطبراني","text":[["الدنيا ملعونَةٌ ، ملْعُونٌ مَّا فيها ، إلَّا",2]," ",["ما ابتُغِيَ بِهِ وجهُ اللهِ عزَّ وجَلَّ",1]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي عاصم في ((الزهد)) (127 )، والطبراني في ((مسند الشاميين)) (612 )","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"qqthlQLu"},{"id":"س-06296","fp":"fd49c7953aae","stateId":417,"easy":"إذا كان لك سهم في الإسلام ← لا يجعلك الله كمن لا سهم له","cause":"مَن له سهمٌ في الإسلامِ","result":"لا يَجعَلُ اللهُ عزَّ وجلَّ مَن له سهمٌ في الإسلامِ كمَن لا سَهْمَ له","explicit":true,"otherNeedIds":[53],"ref":"تخريج مشكل الآثار 2185","srcLabel":"أحمد","text":["ثلاثةٌ أشهَدُ عليهم، والرابعةُ لو شَهدِتُ رَجَوتُ ألَّا آثَمَ: ",["لا يَجعَلُ اللهُ عزَّ وجلَّ مَن له سهمٌ في الإسلامِ كمَن لا سَهْمَ له",2],"، وسِهامُ الإسلامِ: الصَّومُ، والصَّلاةُ، والصَّدَقةُ، ولا يتولَّى اللهُ عزَّ وجلَّ رَجُلًا في الدُّنيا فيولِّيهِ في الآخِرَةِ غيرَه، ولا يُحِبُّ رَجُلٌ قومًا إلَّا جاء معهم يومَ القيامةِ، والرابعةُ لا يستُرُ اللهُ عزَّ وجلَّ على عبدٍ في الدُّنيا إلَّا سَتَرَ عليه في الآخِرَةِ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار ) (2185) واللفظ له، وأحمد (25121)، والحاكم (8161) كلاهما باختلاف يسير.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"C15Wqlci"},{"id":"س-08342","fp":"e2132de6190e","stateId":417,"easy":"إذا آمنت بالنبي ﷺ ولم تره ← فطوبى لك ثم طوبى","cause":"لِمَن آمَن بي ولَمْ يَرَني","result":"وطوبى ثمَّ طوبى","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"otherNeedIds":[15,55],"ref":"صحيح ابن حبان 7230","srcLabel":"أحمد","text":["عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم أنَّ رجُلًا قال له : يا رسولَ اللهِ طوبى لِمَن راكَ وآمَن بكَ قال : ( طوبى لِمَن رآني وآمَن بي ",["وطوبى ثمَّ طوبى",2]," ",["لِمَن آمَن بي ولَمْ يَرَني",1]," )"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (11673)، وأبو يعلى (1374) مطولاً باختلاف يسير، والحاكم في ((معرفة علوم الحديث)) (ص310)","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"g8kjS6La","merged":5,"otherRefs":["صحيح الجامع 3926 (صحيح)","تخريج المسند لشعيب 12578 (حسن)","صحيح الجامع 3922 (صحيح)","صحيح الجامع 3924 (صحيح)"]},{"id":"س-04603","fp":"ffc2e878a8ed","stateId":417,"easy":"إذا مت مسلماً ← أدركت خيراً كثيراً","cause":"قُبورِ المُسلِمينَ","result":"لقد أدرَكَ هؤلاء خَيرًا كَثيرًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 20787","srcLabel":"أبو داود","text":["كنتُ أماشي رَسولَ اللهِ صلَّى اللهُ عليهِ وسَلَّمَ آخِذًا بِيَدِهِ، فقالَ لي: يا ابنَ الخَصاصِيةِ، ما أصبَحتَ تَنقِمُ على اللهِ؟ أصبَحتَ تُماشي رَسولَهُ. قالَ: أحسَبُهُ قالَ: آخِذًا بِيَدِهِ، قالَ: قُلتُ: ما أصبَحتُ أنقِمُ على اللهِ شَيئًا، قد أعطاني اللهُ كُلَّ خَيرٍ. قالَ: فأتَيْنا على قُبورِ المُشرِكينَ، فقالَ: لقد سبَقَ هؤلاء خَيرًا كَثيرًا، ثَلاثَ مَرَّاتٍ، ثم أتَيْنا على ",["قُبورِ المُسلِمينَ",1],"، فقالَ: ",["لقد أدرَكَ هؤلاء خَيرًا كَثيرًا",2],"، ثَلاثَ مَرَّاتٍ، يَقولُها، قالَ: فبَصُرَ بِرَجُلٍ يَمشي بَينَ المَقابِرِ في نَعْلَيْهِ، فقالَ: وَيحَكَ يا صاحِبَ السِّبْتِيَّتَيْنِ، ألْقِ سِبْتِيَّتَيْكَ، مَرَّتَيْنِ، أو ثَلاثًا، فنَظَرَ الرَّجُلُ، فلمَّا رَأى رَسولَ اللهِ صلَّى اللهُ عليهِ وسَلَّمَ خلَعَ نَعْلَيْهِ."],"grade":"صحيح","narrator":"بشير بن معبد بن الخصاصية","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3230)، والنسائي (2048)، وابن ماجه (1568)، وأحمد (20787) واللفظ له","bab":"دفن ومقابر › آداب المقبرة","dorar":"AX7H4DYE","merged":4,"otherRefs":["صحيح الأدب المفرد 596 (صحيح)","تخريج سنن أبي داود 3230 (صحيح)","الأحكام الوسطى 2/148 (صحيح)"]},{"id":"س-01776","fp":"80fa75ddfb6f","stateId":417,"easy":"إذا استجبت لله وللرسول ← تحيا حقاً","cause":"اسْتَجِيبُوا لِلَّهِ وَلِلرَّسُولِ إِذَا دَعَاكُمْ","result":"لِمَا يُحْيِيكُمْ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"otherNeedIds":[17],"ref":"تخريج المسند لشعيب 9345","srcLabel":"الترمذي","text":["خرَجَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ على أُبَيِّ بنِ كَعْبٍ وهو يُصلِّي، فقال: يا أُبَيُّ، فالتفَتَ فلم يُجِبْه، ثم صلَّى أُبَيٌّ، فخفَّفَ، ثم انصرَفَ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقال: السَّلامُ عليكَ، أيْ رسولَ اللهِ. قال: وعليكَ. قال: ما منعكَ أيْ أُبَيُّ إذْ دَعَوتُكَ أنْ تُجيبَني؟ قال: أيْ رسولَ اللهِ، كنتُ في الصَّلاةِ. قال: أفلستَ تَجِدُ فيما أوْحى اللهُ إليَّ أنْ {",["اسْتَجِيبُوا لِلَّهِ وَلِلرَّسُولِ إِذَا دَعَاكُمْ",1]," ",["لِمَا يُحْيِيكُمْ",2],"} [الأنفال: 24]؟ قال: قال: بلى، أيْ رسولَ اللهِ، لا أعودُ. قال: أتُحِبُّ أنْ أُعلِّمَكَ سورةً لم يَنزِلْ في التَّوراةِ، ولا في الزَّبورِ، ولا في الإنجيلِ، ولا في الفُرقانِ مِثْلُها؟ قال: قلتُ: نَعَمْ، أيْ رسولَ اللهِ. فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنِّي لأَرجو ألَّا تَخرُجَ مِن هذا البابِ حتى تَعلَمَها. قال: فأخَذَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بيَدي يُحدِّثُني، وأنا أتَباطَأُ؛ مَخافةَ أنْ يَبلُغَ قَبْلَ أنْ يَقضيَ الحديثَ، فلمَّا أنْ دنَوْنا مِن البابِ قلتُ: أيْ رسولَ اللهِ، ما السُّورةُ الَّتي وعَدتَني؟ قال: ما تَقرَأُ في الصَّلاةِ؟ قال: فقرأتُ عليه أُمَّ القُرآنِ، قال: قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: والَّذي نَفْسي بيَدِه، ما أنزَلَ اللهُ في التَّوراةِ، ولا في الإنجيلِ، ولا في الزَّبورِ، ولا في الفُرقانِ مِثْلَها، وإنَّها لَلسَّبعُ مِن المَثاني."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2875)، والنسائي في ((السنن الكبرى)) (11205)، وأحمد (9345) واللفظ له","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"Y6XR2lN1","merged":6,"otherRefs":["أحكام القرآن لابن العربي 2/389 (صحيح)","الفوائد العلمية من الدروس البازية 6/284 (صحيح)","صحيح أبي داود 1458 (صحيح)","معالم التنزيل (تفسير البغوي) 1/78 (صحيح)","صحيح البخاري 4474 (صحيح)"]},{"id":"س-02405","fp":"b8d79af2c80f","stateId":417,"easy":"إذا شهدت أن لا إله إلا الله وأن محمداً رسول الله ← فهي النجاة","cause":"شَهادةُ أنْ لا إلهَ إلَّا اللهُ، وأنِّي رسولُ اللهِ","result":"ما النَّجاةُ مِن هذا الأمرِ الَّذي نحنُ فيه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[54],"ref":"تخريج مسند أبي بكر 23","srcLabel":"المروزي","text":["سألْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["ما النَّجاةُ مِن هذا الأمرِ الَّذي نحنُ فيه",2],"؟ قال: «",["شَهادةُ أنْ لا إلهَ إلَّا اللهُ، وأنِّي رسولُ اللهِ",1],"»."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"صحيح بطرقه","takhrij":"أخرجه المروزي في ((مسند أبي بكر الصديق)) (23)، والمخلص في ((المخلصيات)) (1897)، وابن عساكر في ((تاريخ دمشق)) (62/13)","bab":"إسلام › فضل الشهادتين","dorar":"12UPRY1I"},{"id":"س-02441","fp":"a3a398e4eb1d","stateId":417,"easy":"إذا قبلت كلمة التوحيد ← فهي لك نجاة","cause":"مَن قبِل الكلمةَ التي عرضتُها على عمِّي فردَّها عليَّ","result":"فهي له نَجاةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"otherNeedIds":[54],"ref":"إتحاف الخيرة المهرة 1/64","srcLabel":"البيهقي","text":["سألتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم عن نجاةِ هذا الأمرِ , فقال : ",["مَن قبِل الكلمةَ التي عرضتُها على عمِّي فردَّها عليَّ",1]," ، ",["فهي له نَجاةٌ",2]],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبري في ((تهذيب الآثار-الجزء المفقود)) (674) واللفظ له بزيادة قصة في أوله، وأخرجه البزار (1/209)، والبيهقي في ((شعب الإيمان)) (91) باختلاف يسير وزيادة قصة في أوله","bab":"إسلام › فضل الشهادتين","dorar":"cziHAeLP"},{"id":"ق-0409","fp":"7767507eb9db","stateId":418,"easy":"ذكر آلاء الله ← الفلاح","cause":"ذكر آلاء الله","result":"الفلاح","explicit":true,"star":true,"ref":"سورة الأعراف: 69","srcLabel":"القرآن الكريم","quran":{"s":7,"from":69,"to":69,"text":"أَوَعَجِبْتُمْ أَنْ جَاءَكُمْ ذِكْرٌ مِنْ رَبِّكُمْ عَلَى رَجُلٍ مِنْكُمْ لِيُنْذِرَكُمْ وَاذْكُرُوا إِذْ جَعَلَكُمْ خُلَفَاءَ مِنْ بَعْدِ قَوْمِ نُوحٍ وَزَادَكُمْ فِي الْخَلْقِ بَسْطَةً فَاذْكُرُوا آلَاءَ اللَّهِ لَعَلَّكُمْ تُفْلِحُونَ (69)","hl":[[187,237,1]]}},{"id":"ق-0465","fp":"6ce6f81abc00","stateId":418,"easy":"الثبات عند اللقاء وذكر الله كثيراً ← الفلاح","cause":"الثبات عند اللقاء وذكر الله كثيراً","result":"الفلاح","explicit":true,"star":true,"otherNeedIds":[24],"ref":"سورة الأنفال: 45","srcLabel":"القرآن الكريم","quran":{"s":8,"from":45,"to":45,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا لَقِيتُمْ فِئَةً فَاثْبُتُوا وَاذْكُرُوا اللَّهَ كَثِيرًا لَعَلَّكُمْ تُفْلِحُونَ (45)","hl":[[0,118,1]]}},{"id":"ق-0831","fp":"28310229a70a","stateId":418,"easy":"الركوع والسجود وعبادة الله وفعل الخير ← الفلاح","cause":"الركوع والسجود وعبادة الله وفعل الخير","result":"الفلاح","explicit":true,"star":true,"apply":{"k":"time","t":"في السجود"},"ref":"سورة الحج: 77","srcLabel":"القرآن الكريم","quran":{"s":22,"from":77,"to":77,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا ارْكَعُوا وَاسْجُدُوا وَاعْبُدُوا رَبَّكُمْ وَافْعَلُوا الْخَيْرَ لَعَلَّكُمْ تُفْلِحُونَ (77)","hl":[[0,120,1]]}},{"id":"ق-0833","fp":"a8d5391fd114","stateId":418,"easy":"الخشوع في الصلاة والإعراض عن اللغو وأداء الزكاة وحفظ الفروج ورعاية الأمانات والعهود والمحافظة على الصلوات ← الفلاح ووراثة الفردوس خالدين","cause":"الخشوع في الصلاة والإعراض عن اللغو وأداء الزكاة وحفظ الفروج ورعاية الأمانات والعهود والمحافظة على الصلوات","result":"الفلاح ووراثة الفردوس خالدين","explicit":true,"star":true,"otherNeedIds":[56],"ref":"سورة المؤمنون: 1–11","srcLabel":"القرآن الكريم","quran":{"s":23,"from":1,"to":11,"text":"قَدْ أَفْلَحَ الْمُؤْمِنُونَ (1) الَّذِينَ هُمْ فِي صَلَاتِهِمْ خَاشِعُونَ (2) وَالَّذِينَ هُمْ عَنِ اللَّغْوِ مُعْرِضُونَ (3) وَالَّذِينَ هُمْ لِلزَّكَاةِ فَاعِلُونَ (4) وَالَّذِينَ هُمْ لِفُرُوجِهِمْ حَافِظُونَ (5) إِلَّا عَلَى أَزْوَاجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَانُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ (6) فَمَنِ ابْتَغَى وَرَاءَ ذَلِكَ فَأُولَئِكَ هُمُ الْعَادُونَ (7) وَالَّذِينَ هُمْ لِأَمَانَاتِهِمْ وَعَهْدِهِمْ رَاعُونَ (8) وَالَّذِينَ هُمْ عَلَى صَلَوَاتِهِمْ يُحَافِظُونَ (9) أُولَئِكَ هُمُ الْوَارِثُونَ (10) الَّذِينَ يَرِثُونَ الْفِرْدَوْسَ هُمْ فِيهَا خَالِدُونَ (11)","hl":[[0,578,1]]}},{"id":"ق-1334","fp":"7578b69914af","stateId":418,"easy":"ابتغاء فضل الله بعد الصلاة وذكر الله كثيراً ← الفلاح","cause":"ابتغاء فضل الله بعد الصلاة وذكر الله كثيراً","result":"الفلاح","explicit":true,"apply":{"k":"time","t":"دبر كل صلاة"},"otherNeedIds":[1],"ref":"سورة الجمعة: 10","srcLabel":"القرآن الكريم","quran":{"s":62,"from":10,"to":10,"text":"فَإِذَا قُضِيَتِ الصَّلَاةُ فَانْتَشِرُوا فِي الْأَرْضِ وَابْتَغُوا مِنْ فَضْلِ اللَّهِ وَاذْكُرُوا اللَّهَ كَثِيرًا لَعَلَّكُمْ تُفْلِحُونَ (10)","hl":[[28,140,1]]}},{"id":"ق-1430","fp":"e2ae7a4469bb","stateId":418,"easy":"التزكّي وذكر اسم الله والصلاة ← الفلاح","cause":"التزكّي وذكر اسم الله والصلاة","result":"الفلاح","explicit":true,"otherNeedIds":[17],"ref":"سورة الأعلى: 14–15","srcLabel":"القرآن الكريم","quran":{"s":87,"from":14,"to":15,"text":"قَدْ أَفْلَحَ مَنْ تَزَكَّى (14) وَذَكَرَ اسْمَ رَبِّهِ فَصَلَّى (15)","hl":[[0,64,1]]}},{"id":"ق-1438","fp":"b0e48abdc0bd","stateId":418,"easy":"تزكية النفس ← الفلاح","cause":"تزكية النفس","result":"الفلاح","explicit":true,"otherNeedIds":[17],"ref":"سورة الشمس: 9","srcLabel":"القرآن الكريم","quran":{"s":91,"from":9,"to":9,"text":"قَدْ أَفْلَحَ مَنْ زَكَّاهَا (9)","hl":[[0,28,1]]}},{"id":"س-07450","fp":"93efc1e7b02c","stateId":418,"easy":"إذا صلحت صلاتك ← فقد أفلحت وأنجحت","cause":"فإن صَلَحَتْ","result":"فقدْ أَفلَحَ وأَنجَحَ","explicit":true,"otherNeedIds":[53,50,57],"ref":"الأحكام الوسطى 1/ 249","srcLabel":"الترمذي","text":["إنَّ أوَّلَ ما يُحاسَبُ به العَبْدُ يَوْمَ القِيامةِ مِن عَمَلِه صَلاتُه، ",["فإن صَلَحَتْ",1]," ",["فقدْ أَفلَحَ وأَنجَحَ",2],"، وإن فَسَدَتْ فقدْ خابَ وخَسِرَ، فإن انْتَقَصَ مِن فَريضتِه شيءٌ قالَ الرَّبُّ تَبارَكَ وتَعالى: انْظُروا هلْ لعَبْدي مِن تَطَوُّعٍ، فُيُكَمَّلُ بها ما انْتَقَصَ مِن الفَريضةِ، ثُمَّ يكونُ سائِرُ عَمَلِه على ذلك."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه الترمذي (413) بلفظه، وابن ماجه (1426)، وأحمد (16954) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"KmO3LtW6","merged":3,"otherRefs":["صحيح الترغيب 376 (صحيح)","الأحاديث المختارة 2579 (صحيح)"]},{"id":"س-00754","fp":"13d3118101c0","stateId":418,"easy":"إذا وجدت في صحيفتك استغفاراً كثيراً ← فطوبى لك","cause":"مَنْ وجدَ في صَحِيفَتِه اسْتِغْفَارًا كَثِيرًا","result":"طوبى لِ","explicit":true,"ref":"الفتح الرباني 11/5476","srcLabel":"النسائي","text":[["طوبى لِ",2],["مَنْ وجدَ في صَحِيفَتِه اسْتِغْفَارًا كَثِيرًا",1]],"grade":"صحيح","narrator":"عبدالله بن بسر","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (3818) واللفظ له، والنسائي في ((السنن الكبرى)) (10289)، والبيهقي في ((شعب الإيمان)) (647) باختلاف يسير","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"zwyS3uYq","merged":2,"otherRefs":["الأحاديث المختارة 9 / 95 (صحيح)"]},{"id":"س-01005","fp":"510f2f1e9dcc","stateId":418,"easy":"إذا اشتغلت بذكر الله وما والاه أو كنت عالماً أو متعلماً ← نجوت من لعنة الدنيا","cause":"ذِكرَ اللهِ وما والاه، وإلَّا عالمٌ ومتعَلِّمٌ","result":"الدُّنيا ملعونةٌ، ملعونٌ ما فيها إلَّا","explicit":true,"otherNeedIds":[27],"ref":"المصابيح في الأحاديث المتواترة 590","srcLabel":"السنة","text":["إنَّ ",["الدُّنيا ملعونةٌ، ملعونٌ ما فيها إلَّا",2]," ",["ذِكرَ اللهِ وما والاه، وإلَّا عالمٌ ومتعَلِّمٌ",1]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"أدعية وأذكار › فضل الذكر","dorar":"3oxUNhFL","merged":2,"otherRefs":["السلسلة الصحيحة 2797 (حسن)"]},{"id":"س-07079","fp":"3b08c6699dff","stateId":418,"easy":"إذا قلت «اللهم اغفر لي وارحمني واهدني وارزقني» ← تجمع لك دنياك وآخرتك","cause":"قلِ اللَّهمَّ اغفِر لي وارحَمني واهدِني وارزُقني . ويقولُ بأصابعِه الأربعِ وقبضَ كفَّهُ غيرَ الإبهامِ ويقولُ : هؤلاءِ يَجمَعنَ لكَ دُنياكَ وآخرتَكَ","result":"علِّمني ما أقولُ","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"apply":{"k":"say","t":"«اللهم اغفر لي وارحمني واهدني وارزقني»"},"similar":["س-07081"],"ref":"الفتوحات الربانية 1/221","srcLabel":"مسلم","text":["إذا أتاهُ إنسانٌ فقالَ : ",["علِّمني ما أقولُ ،",2]," قالَ : ",["قلِ اللَّهمَّ اغفِر لي وارحَمني واهدِني وارزُقني . ويقولُ بأصابعِه الأربعِ وقبضَ كفَّهُ غيرَ الإبهامِ ويقولُ : هؤلاءِ يَجمَعنَ لكَ دُنياكَ وآخرتَكَ",1]],"grade":"صحيح","narrator":"طارق بن أشيم الأشجعي","muhaddith":"صحيح أخرجه مسلم هكذا في رواية و قال في أخرى: عافني بدل ارزقني وأثبت الخمسة في رواية, ولأصل الحديث شاهد و فيه ذكر و عافني وهو حديث حسن","takhrij":"أخرجه مسلم (2697)، وأحمد (15918) واللفظ له","bab":"علم › تعليم الناس وفضل ذلك","dorar":"XfMQyxAj"},{"id":"س-07081","fp":"9f2f6fcdc184","stateId":418,"easy":"إذا دعوت «اللهم اغفر لي وارحمني وعافني وارزقني» ← تجمع لك دنياك وآخرتك","cause":"اللَّهُمَّ اغفِرْ لي، وارحَمْني، وعافِني، وارزُقْني","result":"فإنَّ هؤلاء تَجمَعُ لكَ دُنياكَ وآخِرَتَكَ","explicit":true,"apply":{"k":"say","t":"«اللهم اغفر لي وارحمني وعافني وارزقني»"},"repOf":"س-07079","ref":"صحيح مسلم 2697","text":["أنَّه سَمِعَ النَّبيَّ صلَّى اللهُ عليه وسلَّم وأتاهُ رَجُلٌ، فقال: يا رَسولَ اللهِ، كيفَ أقولُ حينَ أسألُ رَبِّي؟ قال: قُلِ: ",["اللَّهُمَّ اغفِرْ لي، وارحَمْني، وعافِني، وارزُقْني",1],". ويَجمَعُ أصابِعَه إلَّا الإبهامَ؛ ",["فإنَّ هؤلاء تَجمَعُ لكَ دُنياكَ وآخِرَتَكَ",2],"."],"grade":"صحيح","narrator":"[طارق بن أشيم الأشجعي]","muhaddith":"[صحيح]","takhrij":"أخرجه ابن ماجه (3845)، وأحمد (27211)، والطبراني (8/ 317) (8185)  .","bab":"علم › تعليم الناس وفضل ذلك","dorar":"9o3INmZS","merged":2,"otherRefs":["صحيح ابن خزيمة 1/ 727 (صحيح)"]},{"id":"س-00995","fp":"c0601b0735b6","stateId":418,"easy":"إذا جالست الذاكرين ولو كنت مذنباً ← يغفر لك معهم","cause":"عَبدًا خطَّاءً جَلَسَ إليهم وليس منهم","result":"وهو أيضًا قد غَفَرتُ له؛ هُم القومُ لا يَشْقى بهم جَليسُهُم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"otherNeedIds":[23],"ref":"المستدرك على الصحيحين 1845","srcLabel":"متفق عليه","text":["إنَّ للهِ ملائكةً سيَّارةً وفُضلاءَ يَلتمِسونَ مَجالِسَ الذِّكرِ في الأرضِ، فإذا باتوا على مَجلِسِ ذِكرٍ حَفَّ بعضُهُم بعضًا بأجنِحَتِهم إلى السَّماءِ، فيقولُ تَباركَ وتَعالَى: مِن أين جِئتُم؟ وهو أَعلمُ، فيقولونَ: ربَّنا جِئنا مِن عندِ عبادِكَ يُسبِّحونَكَ ويُكبِّرونَكَ ويَحمَدونَكَ، ويُهلِّلونَكَ ويَسألونَكَ ويَستَجيرونَكَ، فيقولُ: ما يَسألونَني؟ وهو أَعلمُ، فيقولونَ: ربَّنا يَسألونَكَ الجنَّةَ، فيقولُ: وهل رَأَوْها؟ فيقولونَ: لا يا ربِّ، فيقولُ: كيف لوْ رَأَوْها؟ فيقولُ: ومِمَّ يَستَجيرونَني؟ وهو أَعلمُ، فيقولونَ: مِنَ النَّارِ، فيقولُ: هل رَأَوْها؟ فيقولونَ: لا. فيقولُ: فكيف لوْ رَأَوْها؟ ثُمَّ يقولُ: اشْهَدوا أنِّي قد غَفَرْتُ لهم، وأَعطَيْتُهم ما سَأَلوني، وأَجَرْتُهم ممَّا اسْتَجاروني. فيقولونَ: ربَّنا إنَّ فيهم ",["عَبدًا خطَّاءً جَلَسَ إليهم وليس منهم",1],"، فيقولُ: ",["وهو أيضًا قد غَفَرتُ له؛ هُم القومُ لا يَشْقى بهم جَليسُهُم",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6408)، ومسلم (2689)، وأحمد (8972) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"1ou9J6nI","merged":2,"otherRefs":["التمهيد 19/115 (صحيح)"]},{"id":"س-01040","fp":"dd6a55d53292","stateId":418,"easy":"إذا جالست الذاكرين ولو جئت لحاجة ← لا تشقى بهم","cause":"إنَّ فيهم فُلانًا ليس منهم إنَّما جاء لحاجةٍ","result":"فهُمُ الجُلَساءُ لا يَشقى جليسُهم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"similar":["س-01150"],"otherNeedIds":[23],"ref":"تخريج صحيح ابن حبان 857","srcLabel":"متفق عليه","text":["إنَّ للهِ ملائكةً فُضُلًا عن كُتَّابِ النَّاسِ يطوفونَ في الطُّرقِ يلتَمِسونَ أهلَ الذِّكرِ فإذا وجَدوا قومًا يذكُرونَ اللهَ تنادَوْا : هلُمُّوا إلى حاجتِكم فيحُفُّونَ بهم بأجنحتِهم إلى السَّماءِ الدُّنيا فيسأَلُهم ربُّهم - وهو أعلَمُ منهم - فيقولُ : ما يقولُ عبادي ؟ فيقولونَ : يُكبِّرونَكَ ويُمجِّدونَكَ ويُسبِّحونَك ويحمَدونَكَ فيقولُ : هل رأَوْني ؟ فيقولونَ : لا فيقولُ : فكيفَ لو رأَوْني ؟ فيقولونَ : لو رأَوْكَ لكانوا لكَ أشَدَّ عبادةً وأكثَرَ تسبيحًا وتحميدًا وتمجيدًا فيقولُ : وما يسأَلوني ؟ قال : فيقولونَ : يسأَلونَكَ الجنَّةَ فيقولُ : فهل رأَوْها ؟ فيقولونَ : لا واللهِ يا ربِّ فيقولُ : فكيفَ لو رأَوْها ؟ [ فيقولونَ : لو رأَوْها ] كانوا عليها أشَدَّ حِرصًا وأشَدَّ لها طلبًا وأعظَمَ فيها رغبةً فيقولُ : ومِمَّ يتعوَّذونَ ؟ فيقولونَ : مِن النَّارِ فيقولُ : وهل رأَوْها ؟ فيقولونَ : لا واللهِ يا ربِّ فيقولُ : فكيفَ لو رأَوْها ؟ فيقولونَ : لو رأَوْها لكانوا منها أشَدَّ فرارًا وأشَدَّ هرَبًا وأشَدَّ خوفًا فيقولُ اللهُ لِملائكتِه : أُشهِدُكم أنِّي قد غفَرْتُ لهم قال : فقال : ملَكٌ مِن الملائكةِ : ",["إنَّ فيهم فُلانًا ليس منهم إنَّما جاء لحاجةٍ",1]," قال : ",["فهُمُ الجُلَساءُ لا يَشقى جليسُهم",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6408)، ومسلم (2689) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"Yrv7E83a"},{"id":"س-01150","fp":"1d0e0cb84124","stateId":418,"easy":"إذا جالست الذاكرين ← لا تشقى بهم","cause":"إنَّ فيهم فلانًا الخطَّاءَ لم يُردهُم إنَّما جاءَهُم لِحاجةٍ","result":"همُ القومُ لا يَشقى لَهُم جَليسٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-01040","otherNeedIds":[23],"ref":"صحيح الترمذي 3600","text":["إنَّ للَّهِ ملائِكَةً سيَّاحينَ في الأَرضِ فضلًا عن كتَّابِ النَّاسِ، فإذا وَجدوا أقوامًا يذكُرونَ اللَّهَ تَنادوا: هلمُّوا إلى بُغيتِكُم، فيَجيئونَ فيحفُّونَ بِهِم إلى السَّماءِ الدُّنيا، فيَقولُ اللَّهُ: أيَّ شيءٍ ترَكْتُمْ عِبادي يَصنعونَ، فيقولونَ: ترَكْناهم يحمَدونَكَ ويمجِّدونَكَ ويَذكرونَكَ، قالَ: فيَقولُ: هل رَأَوني، فيقولونَ: لا، قالَ: فيقولُ: كيفَ لو رَأَوني؟ قالَ: فيقولونَ: لو رأَوكَ لَكانوا أشدَّ تحميدًا، وأشدَّ تمجيدًا، وأشدَّ لَكَ ذِكْرًا، قالَ: فَيقولُ: وأيُّ شيءٍ يطلُبونَ؟ قالَ: فيقولونَ: يطلُبونَ الجنَّةَ، قالَ: فيقولُ: فهل رأوها؟ قالَ: فيقولونَ: لا، قال فَيقولُ: فَكَيفَ لو رأَوها؟ قالَ: فيقولونَ: لو رَأَوها؟ لَكانوا أشدَّ لَها طلبًا، وأشدَّ عليها حِرصًا، قالَ: فيقولُ: فَمن أيِّ شيءٍ يتعوَّذونَ؟ قالوا: يتعوَّذونَ منَ النَّارِ، قالَ: فيقولُ: فهل رأَوها؟ فيقولونَ: لا، فيقولُ: فَكَيفَ لو رأَوها؟ فيقولونَ: لو رأوها لَكانوا أشدَّ منها هَربًا، وأشدَّ منها خوفًا، وأشدَّ منها تعوُّذًا، قالَ: فيَقولُ: فإنِّي أشهدُكُم أنِّي قد غَفرتُ لَهُم،فيقولونَ: ",["إنَّ فيهم فلانًا الخطَّاءَ لم يُردهُم إنَّما جاءَهُم لِحاجةٍ",1],"، فيقولُ: ",["همُ القومُ لا يَشقى لَهُم جَليسٌ",2]],"grade":"صحيح","narrator":"أبو هريرة أو أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3600) واللفظ له، وأخرجه البخاري (6408)، ومسلم (2689) بنحوه","bab":"أدعية وأذكار › فضل الذكر","dorar":"7mJiQSqc"},{"id":"س-06307","fp":"5fc8695b1b08","stateId":419,"easy":"إذا قلت خيراً ← تغنم","cause":"قُولوا خَيرًا","result":"تَغنَموا","explicit":true,"star":true,"otherNeedIds":[40],"ref":"المستدرك على الصحيحين 7983","srcLabel":"الضياء","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ خَرَج ذاتَ يَومٍ على راحِلَتِه، وأصحابُه معه بيْنَ يَدَيهِ، فقال مُعاذُ بنُ جَبَلٍ: يا نَبيَّ اللهِ، أتَأذَنُ لي في أنْ أتقَدَّمَ إليكَ على طِيبةِ نَفسٍ؟ قالَ: نَعَم؛ فاقتَرَب مُعاذٌ إليه، فسارَا جَميعًا، فقالَ مُعاذٌ: بأبي أنتَ يا رَسولَ اللهِ، أسألُ اللهَ أنْ يَجعَلَ يَومَنا قَبْلَ يَومِكَ، أرَأيتَ إنْ كانَ شَيءٌ -ولا نَرى شَيئًا إنْ شاءَ اللهُ- فأيُّ الأعمالِ نَعمَلُها بعْدَكَ؟ فصَمَتَ رَسولُ الله صلَّى اللهُ عليه وسلَّمَ، فقالَ: الجِهادُ في سَبيلِ اللهِ، ثمَّ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: نِعمَ الشَّيءُ الجِهادُ، والَّذي بالنَّاسِ أملَكُ مِن ذلكَ، فالصِّيامُ والصَّدَقةُ، قالَ: نِعمَ الشَّيءُ الصِّيامُ والصَّدَقةُ، فذَكَر مُعاذٌ كلَّ خَيرٍ يَعمَلُه ابنُ آدَمَ، كلُّ ذلكَ يَقولُ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: وعادِ بالنَّاسِ خَيرٌ مِن ذلكَ، قالَ: فماذا -بأبي أنتَ وأُمِّي- عادِ بالنَّاسِ خَيرٌ من ذلكَ؟ قالَ: فأشار رَسولُ الله صلَّى اللهُ عليه وسلَّمَ إلى فِيهِ، قالَ: الصَّمتُ، إلَّا مِن خَيرٍ، قالَ: وهلْ نُؤاخَذُ بما تَكَلَّمَت به ألسِنَتُنا؟ قالَ: فضَرَب رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فَخِذَ مُعاذٍ، ثمَّ قالَ: يا مُعاذُ، ثَكِلَتْكَ أُمُّكَ! -أو ما شاءَ اللهُ أن يَقولَ له مِن ذلك- وهلْ يَكُبُّ النَّاسَ على مَناخِرِهم في جَهَنَّمَ إلَّا ما نَطَقَت به ألسِنَتُهم؟! فمَن كانَ يُؤمِنُ باللهِ واليَومِ الآخِرِ، فليَقُلْ خَيرًا أو لِيَسكُتْ عنْ شَرٍّ،",[" قُولوا خَيرًا ",1],["تَغنَموا",2],"، واسكُتوا عنْ شَرٍّ تَسلَموا."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه الضياء في ((الأحاديث المختارة)) (405) (8/  333) بلفظ مقارب","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"qbFqZpYZ","merged":2,"otherRefs":["مجمع الزوائد 10/302 (صحيح)"]},{"id":"س-00331","fp":"786cabf1cee4","stateId":419,"easy":"إذا صمتّ ← نجوت","cause":"مَن صَمت","result":"نَجا","explicit":true,"star":true,"ref":"تخريج شرح السنة 4129","srcLabel":"الترمذي","text":[["مَن صَمت ",1],["نَجا",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (2501)، وأحمد (6481)، والدارمي (2755) واللفظ لهم.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"iOQSCODp"},{"id":"س-05419","fp":"384cfc3fbf64","stateId":419,"easy":"إذا ملكت لسانك ووسعك بيتك وبكيت على خطيئتك ← فطوبى لك","cause":"من ملَك لسانَه ، ووسِعه بيتُه ، وبكَى على خطيئتِه","result":"طوبَى ل","explicit":true,"ref":"الترغيب والترهيب 4/19","srcLabel":"أحمد","text":[["طوبَى ل",2],["من ملَك لسانَه ، ووسِعه بيتُه ، وبكَى على خطيئتِه",1]],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أحمد في ((الزهد))-رواية عبد الله (219)، وابن أبي الدنيا في ((العزلة)) (2)، والطبراني في ((الأوسط)) (2340) جميعهم بلفظه.","bab":"رقائق وزهد › الحزن والبكاء","dorar":"81eSQv2h"},{"id":"س-04276","fp":"4c61ccdb1066","stateId":419,"easy":"إذا سكتّ ← تبقى سالماً","cause":"ما سكتَّ","result":"إنَّك لن تزالَ سالمًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 10/303","srcLabel":"الترمذي","text":["قُلْتُ يا رسولَ اللهِ أكلُّ ما نتكلَّمُ به يُكتَبُ علينا فقال ثكِلَتْك أمُّك! وهل يكُبُّ النَّاسَ على مناخرِهم في النَّارِ إلَّا حصائدُ ألسنتِهم ",["إنَّك لن تزالَ سالمًا",2]," ",["ما سكتَّ",1]," فإذا تكلَّمْتَ كُتِب لك أو عليك"],"grade":"حسن","narrator":"معاذ بن جبل","muhaddith":"[روي] بإسنادين ورجال أحدهما ثقات","takhrij":"أخرجه الترمذي (2616)، والنسائي في ((الكبرى)) (11330)، وابن ماجة (3973) في أثناء حديث طويل.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"aq5rm0as"},{"id":"س-03974","fp":"4be3c4b07105","stateId":419,"easy":"إذا أمسكت لسانك ولزمت بيتك وبكيت على خطيئتك ← فهي نجاتك","cause":"أمسكْ عليك لسانَك ، وليسَعْك بيتُك ، وابكِ على خطيئتِك","result":"ما نجاةُ المؤمنِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[54],"ref":"تاريخ بغداد 8/265","srcLabel":"أحمد","text":["لقيت رسولَ اللهِ صلَّى اللهُ عليهِ وسلمَ  فأخذت بيدِه ، فقلت : يا رسولَ اللهِ ! ",["ما نجاةُ المؤمنِ",2]," ؟ قال : يا عقبةُ بنُ عامرٍ ! ",["أمسكْ عليك لسانَك ، وليسَعْك بيتُك ، وابكِ على خطيئتِك",1]],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17334)، والطبراني في ((الكبير)) (17/ 271) (743)، والشجري في ((أماليه)) (2418) باختلاف يسير.","bab":"توبة › الحض على التوبة","dorar":"50eHj9om","merged":3,"otherRefs":["شرح السنة 7/339 (حسن)","السلسلة الصحيحة 3/115 (حسن)"]},{"id":"س-03025","fp":"4bc08409ed67","stateId":419,"easy":"إذا كففت يدك في الفتن ← أفلحت","cause":"مَن كَفَّ يَدَه","result":"أفلَحَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[31],"ref":"تخريج مشكل الآثار 2299","srcLabel":"أبو داود","text":["وَيلٌ للعربِ من شرٍّ قدِ اقتَرَبَ، ",["أفلَحَ",2]," ",["مَن كَفَّ يَدَه",1],"، تَقرَّبوا يا بَني فَرُّوخَ إلى الذِّكْرِ، فإنَّ العربَ قد أعرَضَتْ واللهِ، واللهِ إنَّ منكم رِجالًا لو كان العِلمُ بالثُّريَّا لنالوهُ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (2299) واللفظ له، وأبو داود (4249) وليس فيه: تقربوا يا بني فروخ إلى الذكر...، والبيهقي في ((شعب الإيمان)) (4945)","bab":"إيمان › الوعيد","dorar":"yf1ifLPS"},{"id":"س-06736","fp":"f8a00d88a4a8","stateId":419,"easy":"إذا كففت لسانك ← فهو ملاك الأمر كله","cause":"كُفَّ عليكَ هذا","result":"ألا أخبرُكَ بملاكِ ذلِكَ كلِّهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[17],"ref":"صحيح الترمذي 2616","srcLabel":"الترمذي","text":["كنتُ معَ النَّبيِّ صلَّى اللَّهُ علَيهِ وسلَّمَ في سفَرٍ ، فأصبَحتُ يومًا قريبًا منهُ ونحنُ نَسيرُ ، فقلتُ : يا رسولَ اللَّهِ أخبرني بعمَلٍ يُدخِلُني الجنَّةَ ويباعِدُني من النَّارِ ، قالَ : لقد سألتَني عَن عظيمٍ ، وإنَّهُ ليسيرٌ على من يسَّرَهُ اللَّهُ علَيهِ ، تعبدُ اللَّهَ ولا تشرِكْ بِهِ شيئًا ، وتُقيمُ الصَّلاةَ ، وتُؤتي الزَّكاةَ ، وتصومُ رمضانَ ، وتحجُّ البيتَ ، ثمَّ قالَ : ألا أدلُّكَ على أبوابِ الخيرِ : الصَّومُ جُنَّةٌ ، والصَّدَقةُ تُطفي الخطيئةَ كما يُطفئُ الماءُ النَّارَ ، وصلاةُ الرَّجلِ من جوفِ اللَّيلِ قالَ : ثمَّ تلا  تَتَجَافَى جُنُوبُهُمْ عَنِ الْمَضَاجِعِ يَدْعُونَ رَبَّهُمْ  ، حتَّى بلغَ يَعْمَلُونَ ، ثمَّ قالَ : ألا أخبرُكَ بِرَأسِ الأَمرِ كلِّهِ وعمودِهِ ، وذِروةِ سَنامِهِ ؟ قلتُ : بلى يا رسولَ اللَّهِ ، قالَ : رأسُ الأمرِ الإسلامُ ، وعمودُهُ الصَّلاةُ ، وذروةُ سَنامِهِ الجِهادُ ، ثمَّ قالَ : ",["ألا أخبرُكَ بملاكِ ذلِكَ كلِّهِ",2]," ؟ قُلتُ : بلَى يا رسولَ اللَّهِ ، قال : فأخذَ بلِسانِهِ قالَ : ",["كُفَّ عليكَ هذا",1]," ، فقُلتُ : يا نبيَّ اللَّهِ ، وإنَّا لمؤاخَذونَ بما نتَكَلَّمُ بِهِ ؟ فقالَ : ثَكِلَتكَ أمُّكَ يا معاذُ ، وَهَل يَكُبُّ النَّاسَ في النَّارِ على وجوهِهِم أو على مَناخرِهِم إلَّا حَصائدُ ألسنتِهِم ."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2616) بلفظه، وابن ماجه (3973)، وأحمد (22068) كلاهما باختلاف يسير.","bab":"صيام › فضل الصيام","dorar":"dad0NMIP"},{"id":"س-06349","fp":"62da8c6bf7fe","stateId":420,"easy":"إذا أعطاك الله خيراً فأنفقته يميناً وشمالاً وعملت فيه خيراً ← لا تكون من المقلين يوم القيامة","cause":"مَن أعطاه اللهُ خَيرًا، فنَفَحَ فيه يَمينَه وشِمالَه، وبينَ يَدَيه ووراءَه، وعَمِلَ فيه خَيرًا","result":"إنَّ المُكثِرينَ هُمُ المُقِلُّونَ يَومَ القيامةِ، إلَّا","explicit":true,"star":true,"otherNeedIds":[41,50],"ref":"صحيح مسلم 94","srcLabel":"متفق عليه","text":["خَرَجتُ لَيلةً مِنَ اللَّيالي، فإذا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يَمشي وحدَه، ليس معهُ إنسانٌ، قال: فظَنَنتُ أنَّه يَكرَهُ أن يَمشيَ معهُ أحَدٌ، قال: فجَعَلتُ أمشي في ظِلِّ القَمَرِ، فالتَفَتَ فرَآني، فقال: مَن هذا؟ فقُلتُ: أبو ذَرٍّ، جَعَلَني اللهُ فِداءَك، قال: يا أبا ذَرٍّ، تَعالَهْ، قال: فمَشيتُ معهُ ساعةً، فقال: ",["إنَّ المُكثِرينَ هُمُ المُقِلُّونَ يَومَ القيامةِ، إلَّا",2]," ",["مَن أعطاه اللهُ خَيرًا، فنَفَحَ فيه يَمينَه وشِمالَه، وبينَ يَدَيه ووراءَه، وعَمِلَ فيه خَيرًا",1],"، قال: فمَشيتُ معهُ ساعةً، فقال: اجلِسْ هاهُنا، قال: فأجلَسَني في قاعٍ حَولَه حِجارةٌ، فقال لي: اجلِسْ هاهُنا حتَّى أرجِعَ إلَيك، قال: فانطَلَقَ في الحَرَّةِ حتَّى لا أراه، فلَبِثَ عَنِّي، فأطالَ اللَّبثَ، ثُمَّ إنِّي سَمِعتُه وهو مُقبِلٌ وهو يقولُ: وإن سَرَقَ وإن زَنى، قال: فلَمَّا جاءَ لَم أصبِرْ، فقُلتُ: يا نَبيَّ اللهِ، جَعَلَني اللهُ فِداءَك، مَن تُكَلِّمُ في جانِبِ الحَرَّةِ؟ ما سَمِعتُ أحَدًا يَرجِعُ إلَيك شيئًا! قال: ذاك جِبريلُ عَرَضَ لي في جانِبِ الحَرَّةِ، فقال: بَشِّرْ أُمَّتَك أنَّه مَن ماتَ لا يُشرِكُ باللهِ شيئًا دَخَلَ الجَنَّةَ، فقُلتُ: يا جِبريلُ، وإن سَرَقَ وإن زَنى؟ قال: نَعَم، قال: قُلتُ: وإن سَرَقَ وإن زَنى؟ قال: نَعَم، قال: قُلتُ: وإن سَرَقَ وإن زَنى؟ قال: نَعَم، وإن شَرِبَ الخَمرَ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6443)، ومسلم (94).","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"odHTwjbw","merged":12,"otherRefs":["تخريج المسند لشعيب 21570 (صحيح)","صحيح البخاري 6444 (صحيح)","صحيح الجامع 1954 (صحيح)","صحيح مسلم 94 (صحيح)","صحيح الترغيب 3262 (صحيح)","تخريج سير أعلام النبلاء 2/90 (حسن)","النوافح العطرة 338 (صحيح)","تخريج المسند لشعيب 9526 (صحيح)","تخريج المسند لشعيب 9075 (صحيح)","تخريج المسند لشعيب 11259 (صحيح)","تخريج المسند لشعيب 9178 (صحيح)"]},{"id":"س-02180","fp":"8d53d2c380b1","stateId":420,"easy":"إذا أخذتم على أيدي السفهاء ← نجوتم جميعاً","cause":"وإنْ أخذُوا على أيدِيهمْ","result":"نَجَوْا ونَجَوْا جميعًا","explicit":true,"star":true,"otherNeedIds":[30],"ref":"صحيح الجامع 5832","srcLabel":"البخاري","text":["مَثلُ القائِمِ على حُدودِ اللهِ ، والمدَّهِنِ فيها ، كمَثلِ قومٍ اسْتهَمُوا على سفينةٍ في البحْرِ ، فأصابَ بعضُهمْ أعلَاها ، وأصابَ بعضُهمْ أسفَلَها ، فكانَ الّذينَ في أسفلِها إذا استَقَوا من الماءِ مَرُّوا على مَنْ فوقَهُمْ ، فقال الّذينَ في أعْلاها : لا نَدعُكُمْ تَصعدُونَ فتُؤذُونا ، فقالُوا : لوْ أنّا خرقْنا في نَصيبِنا خرْقًا ولمْ نُؤْذِ مَنْ فوقَنا ، فإنْ يَتركُوهمْ وما أرادُوا ، هلَكُوا جميعًا ، ",["وإنْ أخذُوا على أيدِيهمْ",1]," ، ",["نَجَوْا ونَجَوْا جميعًا",2]],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2173)، وأحمد (18361) باختلاف يسير، وأخرجه البخاري (2686) بلفظ مقارب","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"1vc7R5ao","merged":4,"otherRefs":["تخريج المسند لشعيب 18370 (صحيح)","تخريج المسند لشعيب 18379 (صحيح)","تخريج المسند لشعيب 18361 (صحيح)"]},{"id":"ق-0149","fp":"69c190905821","stateId":420,"easy":"الدعوة إلى الخير والأمر بالمعروف والنهي عن المنكر ← الفلاح","cause":"الدعوة إلى الخير والأمر بالمعروف والنهي عن المنكر","result":"الفلاح","explicit":true,"star":true,"ref":"سورة آل عمران: 104","srcLabel":"القرآن الكريم","quran":{"s":3,"from":104,"to":104,"text":"وَلْتَكُنْ مِنْكُمْ أُمَّةٌ يَدْعُونَ إِلَى الْخَيْرِ وَيَأْمُرُونَ بِالْمَعْرُوفِ وَيَنْهَوْنَ عَنِ الْمُنْكَرِ وَأُولَئِكَ هُمُ الْمُفْلِحُونَ (104)","hl":[[0,144,1]]}},{"id":"ق-0521","fp":"3e33413fd429","stateId":420,"easy":"الجهاد بالأموال والأنفس مع الرسول ← الخيرات والفلاح وجنات","cause":"الجهاد بالأموال والأنفس مع الرسول","result":"الخيرات والفلاح وجنات","explicit":true,"otherNeedIds":[55],"ref":"سورة التوبة: 88–89","srcLabel":"القرآن الكريم","quran":{"s":9,"from":88,"to":89,"text":"لَكِنِ الرَّسُولُ وَالَّذِينَ آمَنُوا مَعَهُ جَاهَدُوا بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ وَأُولَئِكَ لَهُمُ الْخَيْرَاتُ وَأُولَئِكَ هُمُ الْمُفْلِحُونَ (88) أَعَدَّ اللَّهُ لَهُمْ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا ذَلِكَ الْفَوْزُ الْعَظِيمُ (89)","hl":[[0,268,1]]}},{"id":"ق-0958","fp":"d9041f06bbaf","stateId":420,"easy":"إيتاء ذي القربى والمسكين وابن السبيل حقوقهم ابتغاء وجه الله ← خير والفلاح","cause":"إيتاء ذي القربى والمسكين وابن السبيل حقوقهم ابتغاء وجه الله","result":"خير والفلاح","explicit":true,"otherNeedIds":[48],"ref":"سورة الروم: 38","srcLabel":"القرآن الكريم","quran":{"s":30,"from":38,"to":38,"text":"فَآتِ ذَا الْقُرْبَى حَقَّهُ وَالْمِسْكِينَ وَابْنَ السَّبِيلِ ذَلِكَ خَيْرٌ لِلَّذِينَ يُرِيدُونَ وَجْهَ اللَّهِ وَأُولَئِكَ هُمُ الْمُفْلِحُونَ (38)","hl":[[0,145,1]]}},{"id":"ق-1319","fp":"b2e41a5fd215","stateId":420,"easy":"الإيثار ولو مع الحاجة والوقاية من شحّ النفس ← الفلاح","cause":"الإيثار ولو مع الحاجة والوقاية من شحّ النفس","result":"الفلاح","explicit":true,"ref":"سورة الحشر: 9","srcLabel":"القرآن الكريم","quran":{"s":59,"from":9,"to":9,"text":"وَالَّذِينَ تَبَوَّءُوا الدَّارَ وَالْإِيمَانَ مِنْ قَبْلِهِمْ يُحِبُّونَ مَنْ هَاجَرَ إِلَيْهِمْ وَلَا يَجِدُونَ فِي صُدُورِهِمْ حَاجَةً مِمَّا أُوتُوا وَيُؤْثِرُونَ عَلَى أَنْفُسِهِمْ وَلَوْ كَانَ بِهِمْ خَصَاصَةٌ وَمَنْ يُوقَ شُحَّ نَفْسِهِ فَأُولَئِكَ هُمُ الْمُفْلِحُونَ (9)","hl":[[153,275,1]]}},{"id":"س-05792","fp":"efc3412de285","stateId":420,"easy":"إذا جعلك الله مفتاحاً للخير مغلاقاً للشر ← فطوبى لك","cause":"جعلهُ اللهُ مِفْتَاحًا للخيرِ، مِغْلَاقًا للشرِّ","result":"فطوبَى لمنْ","explicit":true,"ref":"الجامع الصغير 5608","srcLabel":"الطبراني","text":["عندَ اللهِ خزائنُ الخيرِ والشرِّ، مفاتيحُها الرجالُ، ",["فطوبَى لمنْ",2]," ",["جعلهُ اللهُ مِفْتَاحًا للخيرِ، مِغْلَاقًا للشرِّ",1],"، وويلٌ لمنْ جعلَهُ اللهُ مِفتاحًا للشرِّ مغلاقًا للخيرِ"],"grade":"صحيح","narrator":"سهل بن سعد","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((الكبير)) (6/ 150) (5812) واللفظ له، وابن ماجة (238)، وأبو يعلى (7526) بنحوه.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"tc2xzsm7","merged":5,"otherRefs":["تخريج كتاب السنة 297 (حسن)","صحيح ابن ماجه 195 (حسن)","صحيح الترغيب 66 (حسن)","القضاء والقدر 153 (حسن)"]},{"id":"س-08062","fp":"767960b94722","stateId":420,"easy":"إذا شهدت المعصية فكرهتها ← فأنت كمن غاب عنها","cause":"مَن شَهِدَها فكَرِهَها","result":"كانَ كمَن غابَ عنها","explicit":true,"ref":"الأحكام الوسطى 4/ 271","srcLabel":"أبو داود","text":["\"إذا عُمِلَتِ الخَطيئةُ في الأرْضِ كانَ ",["مَن شَهِدَها فكَرِهَها",1]," -وقالَ مَرَّةً: فأَنكَرَها- ",["كانَ كمَن غابَ عنها",2],"، ومَن غابَ عنها فرَضِيَها كمَن شَهِدَها\"."],"grade":"صحيح","narrator":"العرس بن عميرة الكندي","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (4345)، وابن قانع ((معجم الصحابة)) (2/  309)، وأبو نعيم الأصبهاني في ((تاريخ أصبهان)) (1/  391) واللفظ لهم","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"j27vdZss"},{"id":"س-01959","fp":"3b358a0ef9ca","stateId":420,"easy":"إذا أكثرت المال فأنفقته هكذا وهكذا ← تنجو من الأرذلين","cause":"مَن قال: هكذا، وهكذا، وهكذا","result":"إنَّ المُكثِرينَ هُمُ الأَرْذَلونَ، إلَّا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"otherNeedIds":[41],"ref":"تخريج المسند لشعيب 8323","srcLabel":"أحمد","text":[["إنَّ المُكثِرينَ هُمُ الأَرْذَلونَ، إلَّا",2]," ",["مَن قال: هكذا، وهكذا، وهكذا",1],". وقال كامِلٌ بِيَدِه؛ عَنْ يَمينِه، وعَنْ شِمالِه، وبين يَدَيْه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (8323) واللفظ له، والخرائطي في ((مكارم الأخلاق)) (580)، وابن عدي في ((الكامل في الضعفاء)) (3/38)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"OX3fpSl0"},{"id":"س-02070","fp":"e58c3326c915","stateId":420,"easy":"إذا أخذت على يد العاصي ← تنجيه وتنجي نفسك","cause":"أخَذوا على يَدَيه","result":"أنجَوه ونَجَّوا أنفُسَهم","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"صحيح البخاري 2686","srcLabel":"الترمذي","text":["مَثَلُ المُدهِنِ في حُدودِ اللهِ والواقِعِ فيها مَثَلُ قَومٍ استَهَموا سَفينةً، فصارَ بَعضُهم في أسفَلِها وصارَ بَعضُهم في أعلاها، فكان الذي في أسفَلِها يَمُرُّونَ بالماءِ على الذينَ في أعلاها، فتَأذَّوا به، فأخَذَ فأسًا فجَعَلَ يَنقُرُ أسفَلَ السَّفينةِ، فأتَوه فقالوا: ما لَكَ؟ قال: تَأذَّيتُم بي، ولا بُدَّ لي مِنَ الماءِ، فإن ",["أخَذوا على يَدَيه",1]," ",["أنجَوه ونَجَّوا أنفُسَهم",2],"، وإن تَرَكوه أهلَكوه وأهلَكوا أنفُسَهم."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"[صحيح]","takhrij":"أخرجه الترمذي (2173)، وأحمد (18361)، والبزار (3248) جميعا باختلاف","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"7uPzGbPt"},{"id":"س-02239","fp":"1a72a19c727c","stateId":420,"easy":"إذا منعت العاصين من المعصية ← نجوت ونجوا","cause":"فإن منعوهم","result":"نَجَوْا","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"أحكام القرآن لابن العربي 4/305","srcLabel":"السنة","text":["مثلُ المُداهنِ في حدودِ اللهِ والقائمِ عليها كمثلِ قومٍ استهموا في سفينةٍ، فأصابَ بعضُهم أعلاها وأصابَ بعضُهم أسفلَها ، فأرادَ الذين في أسفلِهَا أَنْ يَسٍتَقُوا الماءَ على الذين في أعلاها فمنعوهم ، فأرادوا أن يستقوا الماءَ في أسفلِ السفينةِ ، ",["فإن منعوهم",1]," ",["نَجَوْا",2]," ، وإن تركوهم هلكوا جميعًا,"],"grade":"صحيح","muhaddith":"ثابت","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"u4QCK5ho"},{"id":"س-02093","fp":"764b065db15e","stateId":420,"easy":"إذا أنفقت يميناً وشمالاً ← تنجو من الأسفلين يوم القيامة","cause":"مَن حَثَا يمينًا وشِمالًا","result":"إنَّ الأَكثَرين الأَسْفَلين يومَ القيامةِ، إلَّا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[41],"ref":"الضعفاء الكبير 3/290","srcLabel":"السنة","text":["يا أبا ذَرٍّ، فقلتُ: لبَّيكَ يا رسولَ اللهِ، جعَلَني اللهُ فِداكَ. قال: إنَّ الأَكثَرين هُمُ الأَقَلُّون يومَ القِيامةِ. فأعادها ثلاثَ مرَّاتٍ، فقال في الثالثة: ",["إنَّ الأَكثَرين الأَسْفَلين يومَ القيامةِ، إلَّا",2]," ",["مَن حَثَا يمينًا وشِمالًا",1],"، وقال هكذا وهكذا."],"grade":"حسن","narrator":"أبو سليمان الجهني","muhaddith":"يروى من غير هذا الوجه بإسناد صالح","takhrij":"لم نقف عليه إلا عند العقيلي في ((الضعفاء)) (4344).","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"E3MXRobV"},{"id":"س-07413","fp":"927abefd7a43","stateId":421,"easy":"إذا استمسكت بعشر ما تعرف (في آخر الزمان) ← فقد نجوت","cause":"مَنِ استمسكَ بعُشرِ ما يعرفُ","result":"فقد نجَا","explicit":true,"star":true,"ref":"السلسلة الصحيحة 2510","srcLabel":"البخاري","text":["إِنَّكُمُ اليومَ في زَمانٍ كَثِيرٍ عُلَماؤُهُ ، قَلِيلٍ خُطَباؤُهُ ، مَنْ تركَ عُشرَ ما يعرفُ فقد هُوَى ، و يأتي من بعدَ زمانٍ كَثِيرٌ خُطَباؤُهُ ، قَلِيلٌ عُلَماؤُهُ ، ",["مَنِ استمسكَ بعُشرِ ما يعرفُ ",1],["فقد نجَا",2]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح رجاله ثقات","takhrij":"أخرجه أحمد (21372)، والبخاري في ((التاريخ الكبير)) (3/ 299)، والهروي في ((ذم الكلام)) (97) واللفظ لهم.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"bmKZr1cd"},{"id":"س-07359","fp":"bfae9e1bf588","stateId":421,"easy":"إذا صلحت حين يفسد الناس ← فطوبى للغرباء","cause":"الذين يَصلُحون إذا فسد الناسُ","result":"فطُوبى للغرباءِ","explicit":true,"star":true,"similar":["س-01772"],"ref":"النوافح العطرة 148","srcLabel":"السنة","text":["ذَروا المِراءَ [يعني حديث: خرج علينا رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ونحن نتمارى في شيءٍ منَ الدِّينِ فغضب غضبًا شديدًا لم يغضبْ مثلَه ثم انتهرَنا فقال يا أمةَ محمدٍ لا تُهيِّجوا على أنفسِكم وهجَ النارِ ثم قال بهذا أمرتُكم أو ليس عن هذا نهيتُكم أليس قد كان هلك من كان قبلكم بهذا ثم قال ذروا المراءَ لقلةِ خيرِه ذروا المراءَ فإنَّ نفعَه قليلٌ ويُهيِّجُ العداءَ بينَ الإخوانِ ذروا المراءَ فإنَّ المراءَ لا تؤمنُ فتنتُه ذروا المراءَ فإنَّ المراءَ يورثُ الشكَّ ويحبطُ العملَ ذروا المراءَ فإنَّ المؤمنَ لا يُماري ذروا المِراءِ فإنَّ المُماريَ قد تمت خسارتُه ذروا المراءَ فكفاك إثمًا أن لا تزال مُماريًا ذروا المراءَ فإنَّ المُماريَ لا أشفعُ له يومَ القيامةِ ذروا المراءَ فأنا زعيمٌ بثلاثةِ أبياتٍ في الجنةِ في وسَطِها ورياضِها وأعلاها لمن يتركُ المراءَ وهو صادقٌ ذروا المراءَ فإنَّ أولَ ما نهاني عنه ربي عَزَّ وَجَلَّ بعد عبادةِ الأوثانِ وشربِ الخمرِ المراءُ ذروا المراءَ فإنَّ الشيطانَ قد أَيِسَ أن يُعبدَ ولكنه رضيَ منكم بالتَّحريشِ وهو المراءُ في الدِّينِ ذروا المراءَ فإنَّ بني إسرائيلَ افترقوا على إحدى وسبعين فرقةً والنصارى على اثنتين وسبيعن فرقةً وإنَّ أمتي ستفترقُ على ثلاثةٍ وسبعين فرقةً كلِّهم على الضلالةِ إلا السوادَ الأعظمَ قالوا يا رسولَ اللهِ وما السوادُ الأعظمُ قال ما أنا عليه وأصحابي مَنْ لم يمارِ في دينِ اللهِ ولم يكفِّرْ أحدًا من أهلِ التوحيدِ بذنبٍ ثم قال إنَّ الإسلامَ بدأ غريبًا وسيعودُ كما بدأ ",["فطُوبى للغرباءِ",2]," قالوا يا رسولَ اللهِ ومَنِ الغرباءُ قال ",["الذين يَصلُحون إذا فسد الناسُ",1]," ولا يمارون في دينِ اللهِ ولا يكفِّرون أحدًا مِنْ أهلِ التوحيدِ بذنبٍ]"],"grade":"صحيح","narrator":"[أبو الدرداء وأبو أمامة الباهلي وأنس بن مالك وواثلة بن الأسقع]","muhaddith":"صحيح","bab":"فتن › كراهية الاختلاف","dorar":"TMkPFVlz","merged":6,"otherRefs":["المتجر الرابح 329 (حسن)","الإحكام في أصول الأحكام 1/594 (صحيح)","هداية الرواة 1/133 (حسن)","السلسلة الصحيحة 1273 (صحيح)","تخريج مشكل الآثار 691 (صحيح)"]},{"id":"س-07482","fp":"5ce7c92bdd3c","stateId":421,"easy":"إذا عملت بعشر ما أُمرت به (في آخر الزمان) ← نجوت","cause":"من عملَ منكم بعشرِ ما أمرَ بِه","result":"نجا","explicit":true,"ref":"صحيح الترمذي 2267","srcLabel":"الترمذي","text":["إنَّكم في زمانٍ من ترَك منكم عشرَ ما أمرَ بِه هلَك ثمَّ يأتي زمانٌ ",["من عملَ منكم بعشرِ ما أمرَ بِه",1]," ",["نجا",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2267)، والطبراني في ((الصغير)) (1156)، وتمام في ((فوائده)) (76) واللفظ لهم.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"acjfN6UV","merged":2,"otherRefs":["الأمالي الحلبية 1/41 (حسن)"]},{"id":"س-01772","fp":"d25ead2df63e","stateId":421,"easy":"إذا صلحت حين يفسد الناس ← فطوبى لك","cause":"للغُرَباءِ إذا فَسدَ النَّاسُ","result":"فَطوبى يومَئذٍ","explicit":true,"repOf":"س-07359","ref":"تخريج المسند لشاكر 3/96","text":["إنَّ الإيمانَ بدأَ غريبًا وسَيعودُ كَما بدأَ ، ",["فَطوبى يومَئذٍ",2]," ",["للغُرَباءِ إذا فَسدَ النَّاسُ",1]," ، والَّذي نفسُ أبي القاسمِ بيدِهِ ليأرِزنَّ الإيمانُ بينَ هذينِ المسجِدينِ كما تَأرزُ الحيَّةُ في جُحْرِها"],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (1604)، والضياء في ((المختارة)) (1067) بلفظه، والبزار (1119) باختلاف يسير.","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"ddy2k9RI"},{"id":"س-03717","fp":"fb5fc683fc7e","stateId":421,"easy":"إذا كانت شدة نشاطك إلى السنة ← فقد أفلحت","cause":"فمَن كانت شِرَّتُه إلى سُنَّتي","result":"فقد أفلَح","explicit":true,"ref":"تخريج صحيح ابن حبان 11","srcLabel":"أحمد","text":["إنَّ لكلِّ عمَلٍ شِرَّةً وإنَّ لكلِّ شِرَّةٍ فترةً ",["فمَن كانت شِرَّتُه إلى سُنَّتي ",1],["فقد أفلَح",2]," ومَن كانت شِرَّتُه إلى غيرِ ذلك فقد هلَك"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح على شرطهما","takhrij":"أخرجه أحمد (6958)، والطبراني (13/429) (14274) باختلاف يسير، والبزار (2346) مطولاً باختلاف يسير","bab":"اعتصام بالسنة › لزوم السنة","dorar":"a25JK4vn"},{"id":"س-07358","fp":"591629dc240c","stateId":421,"easy":"إذا كنت على ما عليه النبي ﷺ وأصحابه ← تكون من الناجين","cause":"ما أنا عليه وأصحابي مَنْ لم يمارِ في دينِ اللهِ ولم يكفِّرْ أحدًا من أهلِ التوحيدِ بذنبٍ","result":"كلِّهم على الضلالةِ إلا السوادَ الأعظمَ","explicit":true,"ref":"النوافح العطرة 148","srcLabel":"السنة","text":["ذَروا المِراءَ [يعني حديث: خرج علينا رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ونحن نتمارى في شيءٍ منَ الدِّينِ فغضب غضبًا شديدًا لم يغضبْ مثلَه ثم انتهرَنا فقال يا أمةَ محمدٍ لا تُهيِّجوا على أنفسِكم وهجَ النارِ ثم قال بهذا أمرتُكم أو ليس عن هذا نهيتُكم أليس قد كان هلك من كان قبلكم بهذا ثم قال ذروا المراءَ لقلةِ خيرِه ذروا المراءَ فإنَّ نفعَه قليلٌ ويُهيِّجُ العداءَ بينَ الإخوانِ ذروا المراءَ فإنَّ المراءَ لا تؤمنُ فتنتُه ذروا المراءَ فإنَّ المراءَ يورثُ الشكَّ ويحبطُ العملَ ذروا المراءَ فإنَّ المؤمنَ لا يُماري ذروا المِراءِ فإنَّ المُماريَ قد تمت خسارتُه ذروا المراءَ فكفاك إثمًا أن لا تزال مُماريًا ذروا المراءَ فإنَّ المُماريَ لا أشفعُ له يومَ القيامةِ ذروا المراءَ فأنا زعيمٌ بثلاثةِ أبياتٍ في الجنةِ في وسَطِها ورياضِها وأعلاها لمن يتركُ المراءَ وهو صادقٌ ذروا المراءَ فإنَّ أولَ ما نهاني عنه ربي عَزَّ وَجَلَّ بعد عبادةِ الأوثانِ وشربِ الخمرِ المراءُ ذروا المراءَ فإنَّ الشيطانَ قد أَيِسَ أن يُعبدَ ولكنه رضيَ منكم بالتَّحريشِ وهو المراءُ في الدِّينِ ذروا المراءَ فإنَّ بني إسرائيلَ افترقوا على إحدى وسبعين فرقةً والنصارى على اثنتين وسبيعن فرقةً وإنَّ أمتي ستفترقُ على ثلاثةٍ وسبعين فرقةً ",["كلِّهم على الضلالةِ إلا السوادَ الأعظمَ",2]," قالوا يا رسولَ اللهِ وما السوادُ الأعظمُ قال ",["ما أنا عليه وأصحابي مَنْ لم يمارِ في دينِ اللهِ ولم يكفِّرْ أحدًا من أهلِ التوحيدِ بذنبٍ",1]," ثم قال إنَّ الإسلامَ بدأ غريبًا وسيعودُ كما بدأ فطُوبى للغرباءِ قالوا يا رسولَ اللهِ ومَنِ الغرباءُ قال الذين يَصلُحون إذا فسد الناسُ ولا يمارون في دينِ اللهِ ولا يكفِّرون أحدًا مِنْ أهلِ التوحيدِ بذنبٍ]"],"grade":"صحيح","narrator":"[أبو الدرداء وأبو أمامة الباهلي وأنس بن مالك وواثلة بن الأسقع]","muhaddith":"صحيح","bab":"فتن › كراهية الاختلاف","dorar":"TMkPFVlz"},{"id":"س-00565","fp":"6a362f7be3f4","stateId":421,"easy":"إذا تمسكت بأهل بيت النبي ﷺ ← نجوت كمن ركب سفينة نوح (على رواية)","cause":"أهلِ بيتي فيكم كمثلِ سفينةِ نوحٍ في قومِ نوحٍ من ركِبها","result":"نجا","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"البلدانيات 186","srcLabel":"الطبراني","text":["مثلُ ",["أهلِ بيتي فيكم كمثلِ سفينةِ نوحٍ في قومِ نوحٍ من ركِبها",1]," ",["نجا",2]," ومن تخلَّف عنها هلك ومثلُ بابِ حِطَّةٍ في بني إسرائيلَ"],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"حسن","takhrij":"أخرجه البزار (3900)، والطبراني (3/46) (2637) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (4/197)","bab":"آداب عامة › ضرب الأمثال","dorar":"b8aAxVcZ"},{"id":"س-07164","fp":"20d48830dd0c","stateId":422,"easy":"إذا سددت وقاربت ولزمت القصد ← تبلغ","cause":"فسَدِّدُوا وقَارِبُوا ، واغْدُوا ورُوحُوا ، وشيءٌ مِنَ الدُّلْجَةِ والقَصْدَ القَصْدَ","result":"تَبْلُغُوا","explicit":true,"star":true,"ref":"صحيح الأدب المفرد 358","srcLabel":"متفق عليه","text":["لَنْ يُنَجِّيَ أحدًا مِنكمْ عملُهُ قالوا ولا أنتَ يا رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ؟ قال ولا أنا ، إلَّا أنْ يَتَغَمَّدَنِي اللهُ مِنْهُ برحمةٍ ، ",["فسَدِّدُوا وقَارِبُوا ، واغْدُوا ورُوحُوا ، وشيءٌ مِنَ الدُّلْجَةِ والقَصْدَ القَصْدَ",1]," ، ",["تَبْلُغُوا",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6463)، وفي ((الأدب المفرد)) (461) واللفظ له، ومسلم (2816)","bab":"علم › حسن السؤال ونصح العالم","dorar":"wLn7yy6Q"},{"id":"س-05649","fp":"f6b652064b8e","stateId":422,"easy":"إذا أسلمت وكان عيشك كفافاً ← فطوبى لك","cause":"مَن أسلَمَ وكان عَيْشُه كَفافًا","result":"طُوبى لِ","explicit":true,"star":true,"ref":"أطراف الغرائب 1/165","srcLabel":"السنة","text":["حديث: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["طُوبى لِ",2],["مَن أسلَمَ وكان عَيْشُه كَفافًا",1],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"غريب من حديث حسام عن ثابت تفرد به عمرو بن محمد عنه","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"zjykj9rt","merged":9,"otherRefs":["تخريج صحيح ابن حبان 670 (صحيح)","تخريج المسند لشعيب 6609 (صحيح)","ما تمس إليه الحاجة 258 (صحيح)","المستدرك على الصحيحين 7345 (صحيح)","السلسلة الصحيحة 1506 (صحيح)","صحيح الجامع 3931 (صحيح)","تخريج مشكلة الفقر 18 (صحيح)","المستدرك على الصحيحين 98 (صحيح)"]},{"id":"ق-1347","fp":"e3ebdbe5d98f","stateId":422,"easy":"الوقاية من شحّ النفس ← الفلاح","cause":"الوقاية من شحّ النفس","result":"الفلاح","explicit":true,"star":true,"ref":"سورة التغابن: 16","srcLabel":"القرآن الكريم","quran":{"s":64,"from":16,"to":16,"text":"فَاتَّقُوا اللَّهَ مَا اسْتَطَعْتُمْ وَاسْمَعُوا وَأَطِيعُوا وَأَنْفِقُوا خَيْرًا لِأَنْفُسِكُمْ وَمَنْ يُوقَ شُحَّ نَفْسِهِ فَأُولَئِكَ هُمُ الْمُفْلِحُونَ (16)","hl":[[97,156,1]]}},{"id":"س-05004","fp":"31625e4f25df","stateId":422,"easy":"إذا عدلت في الغضب والرضا واقتصدت في الفقر والغنى وخشيت الله ← فهي منجيات","cause":"العَدلُ بالغَضَبِ والرِّضا، والقَصدُ في الفَقرِ والغِنى، وخَشيةُ اللهِ في السِّرِّ والعلانيةِ","result":"وثلاثٌ مُنجياتٌ","explicit":true,"star":true,"similar":["س-05444"],"ref":"المصابيح في الأحاديث المتواترة 608","srcLabel":"السنة","text":["ثلاثٌ مُهلِكاتٌ، ",["وثلاثٌ مُنجياتٌ",2],"، وثلاثٌ كفَّاراتٌ، وثلاثٌ دَرجاتٌ؛ فأمَّا المُهلِكاتُ: فشُحٌّ مُطاعٌ، وهوًى مُتَّبَعٌ، وإعجابُ المرءِ بنفسِه، وأمَّا المُنجياتُ: ",["العَدلُ بالغَضَبِ والرِّضا، والقَصدُ في الفَقرِ والغِنى، وخَشيةُ اللهِ في السِّرِّ والعلانيةِ",1],"، وأمَّا الكفَّاراتُ: فانتِظارُ الصَّلاةِ بَعدَ الصَّلاةِ، وإسباغُ الوُضوءِ في السَّبَراتِ، ونَقلُ الأقدامِ إلى الجماعاتِ، وأمَّا الدَّرجاتُ: فإطعامُ الطَّعامِ، وإفشاءُ السَّلامِ، والصَّلاةُ باللَّيلِ والنَّاسُ نيامٌ"],"grade":"صحيح","muhaddith":"هذه مجموعة هنا، وأكثر رواياتها متفرقة، وكلها متواترة","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"AFzHsVLC","merged":2,"otherRefs":["صحيح الجامع 3039 (حسن)"]},{"id":"س-03863","fp":"2a1a4551f4fc","stateId":422,"easy":"إذا أخذت الحق وأعطيته في التجارة ← نجوت من الفجور","cause":"مَن أخَذ الحقَّ وأعطاه","result":"التاجرُ فاجرٌ إلا","explicit":true,"ref":"إتحاف الخيرة المهرة 3/290","srcLabel":"السنة","text":["سمِعتُ عليًّا يقولُ : ",["التاجرُ فاجرٌ إلا",2]," ",["مَن أخَذ الحقَّ وأعطاه",1]],"grade":"صحيح","narrator":"أبو سعيد [الثوري]","muhaddith":"إسناده صحيح","bab":"تجارة › أخلاقيات التجارة","dorar":"AV8BcA6k"},{"id":"س-05726","fp":"9f9d70ab8502","stateId":422,"easy":"إذا تواضعت بلا منقصة وأنفقت مالك في غير معصية ← فطوبى لك","cause":"من تواضعَ في غيرِ مَنقصةٍ ، وذلَّ نفسَهُ في غيرِ مسئلةٍ ، وأنفقَ مالًا جمعَهُ في غيرِ معصيةٍ ، ورحمَ أهلَ الذلِ والمسكنةِ ، وخالطَ أهلَ الفقهِ والحكمةِ ، طوبى لمن طابَ كسبُهُ وصلحَتْ سريرتُهُ","result":"طوبى لِ","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 1/76","srcLabel":"السنة","text":[["طوبى لِ",2],["من تواضعَ في غيرِ مَنقصةٍ ، وذلَّ نفسَهُ في غيرِ مسئلةٍ ، وأنفقَ مالًا جمعَهُ في غيرِ معصيةٍ ، ورحمَ أهلَ الذلِ والمسكنةِ ، وخالطَ أهلَ الفقهِ والحكمةِ ، طوبى لمن طابَ كسبُهُ وصلحَتْ سريرتُهُ ،",1]," وكرمَتْ علانيتُهُ ، وعزلَ عنِ الناسِ شرُّهُ ، طوبى لمن عملَ بعلمِهِ ، وأنفقَ الفضلَ من مالِهِ وأمسكَ الفضلَ من قولِهِ"],"grade":"صحيح","muhaddith":"إسناده صحيح حسن","bab":"رقائق وزهد › الكبر والتواضع","dorar":"vuHTDA6K"},{"id":"س-06531","fp":"5fed9c20e1f0","stateId":422,"easy":"إذا استقمت ← تفلح","cause":"استَقيموا","result":"تُفلِحوا","explicit":true,"ref":"تخريج المسند لشعيب 22414","srcLabel":"ابن ماجه","text":[["استَقيموا ",1],["تُفلِحوا",2],"، وخيرُ أعمالِكم الصَّلاةُ، ولنْ يُحافِظَ على الوُضوءِ إلَّا مُؤمنٌ، وقال عِصامٌ: ولا يُحافِظُ."],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (277) بنحوه، وأحمد (22414) واللفظ له","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"hik3cUTs"},{"id":"س-00192","fp":"b7ec8de34da5","stateId":422,"easy":"إذا حُفظت من الهوى والغضب والطمع ← فقد أفلحت","cause":"من حُفِظ من الهوَى والغضبِ والطَّمعِ","result":"أفلح منكم","explicit":true,"ref":"المهذب في اختصار السنن 3/1143","srcLabel":"البيهقي","text":["كان عمرُ يقولُ في خُطبتِه : ",["أفلح منكم",2]," ",["من حُفِظ من الهوَى والغضبِ والطَّمعِ",1]," ووُفِّق إلى الصِّدقِ , فإنَّه يجُرُّه إلى الخيرِ , من يكذِبُ يفجُرْ . . . ."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده جيد","takhrij":"أخرجه البيهقي (6015) باختلاف يسير","bab":"آداب الكلام › الصدق وما جاء فيه","dorar":"eA4qzhmE"},{"id":"س-00346","fp":"aa7ddd96666e","stateId":422,"easy":"إذا شغلك عيبك عن عيوب الناس ← فطوبى لك","cause":"مَن شَغَلَه عَيبُه عَن عُيوبِ النَّاسِ","result":"طوبى ل","explicit":true,"ref":"مجموع الشروح الفقهية. 237/33","srcLabel":"السنة","text":[["طوبى ل",2],["مَن شَغَلَه عَيبُه عَن عُيوبِ النَّاسِ",1],"."],"grade":"حسن","narrator":"أنس","muhaddith":"لا بأس به","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"hQcVSMPN"},{"id":"س-01763","fp":"783863445b54","stateId":422,"easy":"إذا سارعت في مكارم الأخلاق ← دلّتك على سبيل النجاح","cause":"يسارعَ في مكارمِ الأخلاقِ","result":"فإنها تدل على سبيلِ النجاحِ","explicit":true,"ref":"البداية والنهاية 5/61","srcLabel":"البيهقي","text":["عن عليِّ بنِ أبي طالبٍ قال يا سبحانَ اللهِ ما أزهد كثيرًا من الناسِ في خيرٍ عجبًا لرجلٍ يجيئُه أخوه المسلمُ في الحاجةِ فلا يرى نفسَه للخيرِ أهلًا فلو كان لا يرجو ثوابًا ولا يخشى عقابًا لكان ينبغي له أن ",["يسارعَ في مكارمِ الأخلاقِ",1]," ",["فإنها تدل على سبيلِ النجاحِ",2]," فقام إليه رجلٌ فقال فداك أبي وأمي يا أميرَ المؤمنين سمعتُه من رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ قال نعم وما هو خيرٌ منه لما أتى بسبايا طيِّءٍ وقفتْ جاريةٌ حمراءُ لعساءُ دلفاءُ عيطاءُ شماءُ الأنفِ معتدلةُ القامةِ والهامةِ درماءُ الكعبَينِ خدلَّةُ الساقَينِ لفَّاءُ الفخِذَينِ خميصةُ الخَصرَينِ ضامرةُ الكشحَينِ مصقولةُ المتْنَينِ قال فلما رأيتُها أعجبتُ بها وقلتُ لأطلبنَّ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يجعلها في فَيْئي فلما تكلمتْ أنسيتُ جمالَها من فصاحتِها فقالت يا محمدُ إن رأيتَ أن تُخلِّيَ عنا ولا تُشمِتْ بنا أحياءَ العربِ فإني ابنةُ سيِّدُ قومي وإنَّ أبي كان يحمي الذِّمارَ ويفكُّ العاني ويشبعُ الجائعَ ويكسو العاريَ ويَقري الضيفَ ويطعمُ الطعامَ ويفشِ السلامَ ولم يردَّ طالبَ حاجةٍ قطُّ أنا ابنةُ حاتمِ طيءٍ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يا جاريةُ هذه صفة المؤمنين حقًّا لو كان أبوك مسلمًا لترحَّمْنا عليه خلُّوا عنها فإنَّ أباها كان يحبُّ مكارمَ الأخلاقِ واللهُ يحبُّ مكارمَ الأخلاقِ فقام أبو بردةَ بنُ نيارٍ فقال يا رسولَ اللهِ تحبُّ مكارمَ الأخلاقِ فقال رسولُ اللهِ والذي نفسي بيده لا يدخلُ أحدٌ الجنةَ إلا بحُسنِ الخُلُقِ"],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"حسن المتن غريب الإسناد جدا عزيز المخرج","takhrij":"أخرجه البيهقي في ((دلائل النبوة)) (5/ 341)، وابن عساكر في ((تاريخ دمشق)) (69/ 202) كلاهما بلفظه، وابن حجر في ((تخريج أحاديث المختصر)) (1/ 197) بنحوه.","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"6JaYGGt1"},{"id":"س-04714","fp":"e0de63960758","stateId":422,"easy":"إذا أخلصت قلبك للإيمان وسلم قلبك وصدق لسانك واطمأنت نفسك ← فقد أفلحت","cause":"أخْلَصَ قَلبُه للإيمانِ وجَعَلَ قَلْبَه سَليمًا، ولِسانَهُ صادِقًا، ونفْسَه مُطمئنَّةً، وخَليقتَه مُستقيمةً، وجَعَلَ أُذُنَه مُستَمِعةً، وعَينَه ناظرةً، فأما الأُذُنُ فقَمِعٌ، والعَينُ مُقِرَّةٌ بما يُوعَى القلبُ، وقدْ أفلَحَ مَن جَعَلَ قَلْبَه واعيًا","result":"قد أفْلَحَ مَن","explicit":true,"ref":"مجمع الزوائد 10/235","srcLabel":"أحمد","text":[["قد أفْلَحَ مَن",2],[" أخْلَصَ قَلبُه للإيمانِ وجَعَلَ قَلْبَه سَليمًا، ولِسانَهُ صادِقًا، ونفْسَه مُطمئنَّةً، وخَليقتَه مُستقيمةً، وجَعَلَ أُذُنَه مُستَمِعةً، وعَينَه ناظرةً، فأما الأُذُنُ فقَمِعٌ، والعَينُ مُقِرَّةٌ بما يُوعَى القلبُ، وقدْ أفلَحَ مَن جَعَلَ قَلْبَه واعيًا",1],"."],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (21310) واللفظ له، والطبراني في ((مسند الشاميين)) (1141)، وأبو نعيم في ((حلية الأولياء)) (5/216) باختلاف يسير","bab":"رقائق وزهد › الإخلاص","dorar":"ZvT5XTIY"},{"id":"س-05446","fp":"f901e117435e","stateId":422,"easy":"إذا اتقيت الله في السر والعلانية وقلت الحق واقتصدت ← فهي منجيات","cause":"فتقوى اللهِ في السِّرِّ والعلانيةِ، والقولُ بالحقِّ في الرِّضَى والسَّخَطِ، والقَصْدُ في الغِنَى والفقرِ","result":"ثلاثٌ مُنْجِيَاتٌ","explicit":true,"ref":"هداية الرواة 5049","srcLabel":"البيهقي","text":[["ثلاثٌ مُنْجِيَاتٌ",2],"، وثلاثٌ مُهْلِكاتٌ : فأما المُنْجِياتُ : ",["فتقوى اللهِ في السِّرِّ والعلانيةِ، والقولُ بالحقِّ في الرِّضَى والسَّخَطِ، والقَصْدُ في الغِنَى والفقرِ",1]," . وأما المُهْلِكاتُ : فهوًى مُتَّبَعٌ، وشُحٌّ مُطاعٌ، وإعجابُ المرءِ بنفسِهِ، وهي أَشَدُّهُنَّ ."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن لغيره","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (7252)","bab":"رقائق وزهد › الخوف من الله","dorar":"ZMpfy9rK"},{"id":"س-02479","fp":"bc714d5625a4","stateId":422,"easy":"إذا شححت على دينك ← تنجو من شرار التجار والزراع","cause":"مَنْ شحَّ على دِينِه","result":"وإنَّ شِرارَ هذه الأمةِ التُّجارُ والزرَّاعون إلا","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"مسند علي 57","srcLabel":"الطبري","text":["إنَّ اللهَ بعثني نبيًّا برحمةٍ وملحمةٍ ولم يبعثني تاجرًا ولا زرَّاعًا ",["وإنَّ شِرارَ هذه الأمةِ التُّجارُ والزرَّاعون إلا",2]," ",["مَنْ شحَّ على دِينِه",1]," قال ويعني بالمَلحمةِ القتالَ"],"grade":"صحيح","narrator":"الضحاك بن مزاحم","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبري في ((تهذيب الآثار)) (119) واللفظ له، وتمام في ((الفوائد)) (978) باختلاف يسير، وأبو نعيم في ((حلية الأولياء)) (4/ 72)\nباختلاف يسير.","bab":"إسلام › قتال الناس حتى يسلموا","dorar":"cl0HVdHn"},{"id":"س-05169","fp":"15501e5e98f9","stateId":422,"easy":"إذا سددت وقاربت في عبادتك ← فارجُ لنفسك الفلاح","cause":"فإِنْ صاحبُها سدَّدَ و قارَبَ","result":"فارجوه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الجامع 2151","srcLabel":"الترمذي","text":["إِنَّ لِكُلِّ شيءٍ شِرَّةً ، ولكلِّ شِرَّةٍ فَتْرَةً ، ",["فإِنْ صاحبُها سدَّدَ و قارَبَ",1]," ، ",["فارجوه",2]," ، وإِنْ أُشيرَ إليهِ بالأصابِعِ ، فلا تَعُدُّوهُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2453)، والطحاوي في ((شرح مشكل الآثار)) (1242)، وابن حبان (349) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"6n4oq09l"},{"id":"س-05444","fp":"01f1a90557df","stateId":422,"easy":"إذا عدلت في الغضب والرضا واقتصدت في الفقر والغنى وخشيت الله ← فهي المنجيات","cause":"فالعَدلُ في الغَضبِ و الرِّضَا ، و القَصدُ في الفقرِ والغِنَى ، و خَشيةُ اللهِ في السِّرِّ و العَلانيةِ","result":"أمَّا المنجِياتُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-05004","ref":"صحيح الترغيب 453","text":["ثلاثٌ كفَّاراتٌ ، و ثلاثٌ درجاتٌ ، و ثلاثٌ مُنجِياتٌ ، و ثلاثٌ مُهلِكاتٌ ؛ فأما الكفَّاراتُ ، فإسباغُ الوُضوءِ في السَّبَرَاتِ ، و انتِظارُ الصَّلاةِ بعد الصَّلاةِ ، و نقلُ الأقدامِ إلى الجَماعاتِ ، وأمَّا الدَّرجاتُ فإطعامُ الطعامِ ، وإفشاءُ السلامِ ، والصَّلاةُ باللَّيلِ والنَّاسُ نيامٌ ، و ",["أمَّا المنجِياتُ",2]," ، ",["فالعَدلُ في الغَضبِ و الرِّضَا ، و القَصدُ في الفقرِ والغِنَى ، و خَشيةُ اللهِ في السِّرِّ و العَلانيةِ",1]," ، و أمَّا المهلِكاتُ ، فشُحٌّ مُطاعٌ ، و هوًى مُتَّبَعٌ ، و إعجابُ المرءِ بنَفسِه"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن لغيره","takhrij":"أخرجه البزار (6491)، وابن شاهين في ((الترغيب في فضائل الأعمال)) (33)، وأبو نعيم في ((حلية الأولياء)) (6/268) باختلاف يسير.","bab":"رقائق وزهد › الخوف من الله","dorar":"JrlsnqXs"},{"id":"س-01850","fp":"923c6b1f8135","stateId":423,"easy":"إذا قصرت الصلاة في السفر ← فهي صدقة تصدق الله بها عليك فاقبلها","cause":"أَنْ تَقْصُرُوا مِنَ الصَّلَاةِ","result":"صَدَقةٌ تصدَّقَ اللهُ بها عليكم فاقبَلوا صَدَقتَه","explicit":true,"star":true,"ref":"تخريج مشكل الآثار 1647","srcLabel":"مسلم","text":["عن يَعلى بنِ مُنبِّهٍ، قال: سألتُ عُمَرَ بنَ الخطَّابِ رضِيَ اللهُ عنه، ثم ذَكَرَ مِثلَه، [يعني حديثَ: قلتُ لعُمَرَ بنِ الخطَّابِ رضِيَ اللهُ عنه: إنَّما قال اللهُ عزَّ وجلَّ: {فَلَيْسَ عَلَيْكُمْ جُنَاحٌ ",["أَنْ تَقْصُرُوا مِنَ الصَّلَاةِ",1]," إِنْ خِفْتُمْ أَنْ يَفْتِنَكُمُ الَّذِينَ كَفَرُوا} [النساء: 101] فقد أَمِنَ الناسُ، فقال عُمَرُ: إنِّي عَجِبتُ ممَّا عَجِبتَ منه، فسَأَلتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقال: ",["صَدَقةٌ تصدَّقَ اللهُ بها عليكم فاقبَلوا صَدَقتَه",2],".]"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (686)، والترمذي (3034)، والنسائي (1433) واللفظ لهم.","bab":"إحسان › الأخذ بالرخصة","dorar":"b1GBYtLL","merged":3,"otherRefs":["تخريج المسند لشعيب 245 (صحيح)","تخريج صحيح ابن حبان 2741 (صحيح)"]},{"id":"س-00695","fp":"183384ed9be7","stateId":423,"easy":"إذا سألت الله العفو والعافية فأُعطيتهما ← فقد أفلحت","cause":"سَلِ اللهَ العَفْوَ و العَافِيَةَ في الدنيا و الآخِرَةَ","result":"فإِذَا أعطيتَ العافيةَ في الدنيا و الآخرةِ فقد أفلحْتَ","explicit":true,"star":true,"ref":"صحيح الأدب المفرد 495","srcLabel":"البخاري","text":[["سَلِ اللهَ العَفْوَ و العَافِيَةَ في الدنيا و الآخِرَةَ",1]," ، سَلِ اللهَ العَفْوَ و العَافِيَةَ في الدنيا و الآخِرَةَ ",["فإِذَا أعطيتَ العافيةَ في الدنيا و الآخرةِ فقد أفلحْتَ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3512)، وابن ماجه (3848)، وأحمد (12291)، والبخاري في ((الأدب المفرد)) (637) واللفظ له","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"BlsSBXrO"},{"id":"س-03925","fp":"e51eba86378a","stateId":423,"easy":"إذا قصرت الصلاة ← فهي رخصة الله فاقبلها","cause":"فَلَيْسَ عَلَيْكُمْ جُنَاحٌ أَنْ تَقْصُرُوا مِنَ الصَّلَاةِ","result":"هو صدقةٌ تصدَّق اللهُ بها عليكم فاقبَلوا رخصتَه","explicit":true,"star":true,"ref":"تخريج صحيح ابن حبان 2740","srcLabel":"مسلم","text":["قُلْتُ لعمرَ بنِ الخطَّابِ: عجِبْتُ للنَّاسِ وقَصْرِهم الصَّلاةَ وقد قال اللهُ: {",["فَلَيْسَ عَلَيْكُمْ جُنَاحٌ أَنْ تَقْصُرُوا مِنَ الصَّلَاةِ",1]," إِنْ خِفْتُمْ أَنْ يَفْتِنَكُمُ الَّذِينَ كَفَرُوا} [النساء: 101] وقد ذهَب هذا فقال عمرُ: عجِبْتُ ممَّا عجِبْتَ منه فذكَرْتُ ذلك لرسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقال: ( ",["هو صدقةٌ تصدَّق اللهُ بها عليكم فاقبَلوا رخصتَه",2]," )"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن حبان (2739) واللفظ له، ومسلم (686)، والترمذي (3034) باختلاف يسير، وأبو داود (1199) بنحوه.","bab":"تفسير آيات › سورة النساء","dorar":"pYMTGg91"},{"id":"س-07408","fp":"ce9b41fa0f4a","stateId":423,"easy":"إذا اتعظت بغيرك ← فأنت السعيد","cause":"مَن وُعِظَ بغَيرِه","result":"والسَّعيدُ","explicit":true,"star":true,"ref":"صحيح مسلم 2645","srcLabel":"ابن أبي عاصم","text":["أنَّه سَمِعَ عَبدَ اللهِ بنَ مَسعودٍ يقولُ: الشَّقيُّ مَن شَقيَ في بَطنِ أُمِّه، ",["والسَّعيدُ",2]," ",["مَن وُعِظَ بغَيرِه",1],"، فأتى رَجُلًا مِن أصحابِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم يُقالُ له: حُذَيفةُ بنُ أُسَيدٍ الغِفاريُّ، فحَدَّثَه بذلك مِن قَولِ ابنِ مَسعودٍ، فقال: وكيفَ يَشقى رَجُلٌ بغيرِ عَمَلٍ؟ فقال له الرَّجُلُ: أتَعجَبُ مِن ذلك؟! فإنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: إذا مَرَّ بالنُّطفةِ ثِنتانِ وأربَعونَ لَيلةً، بَعَثَ اللهُ إليها مَلَكًا، فصَوَّرَها وخَلَقَ سَمعَها وبَصَرَها وجِلدَها ولَحمَها وعِظامَها، ثُمَّ قال: يا رَبِّ، أذَكَرٌ أم أُنثى؟ فيَقضي رَبُّكَ ما شاءَ، ويَكتُبُ المَلَكُ، ثُمَّ يقولُ: يا رَبِّ، أجَلُه؟ فيَقولُ رَبُّكَ ما شاءَ، ويَكتُبُ المَلَكُ، ثُمَّ يقولُ: يا رَبِّ، رِزقُه؟ فيَقضي رَبُّكَ ما شاءَ، ويَكتُبُ المَلَكُ، ثُمَّ يَخرُجُ المَلَكُ بالصَّحيفةِ في يَدِه، فلا يَزيدُ على ما أُمِرَ ولا يَنقُصُ."],"grade":"صحيح","narrator":"حذيفة بن أسيد الغفاري","muhaddith":"[صحيح]","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (179)، والفريابي في ((القدر)) (132)، وأبو عوانة (11578) واللفظ لهم.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"ZSsmosPz","merged":6,"otherRefs":["الجامع الصغير 2591 (صحيح)","شرح ثلاثيات المسند 1/234 (حسن)","تخريج كتاب السنة 177 (صحيح)","فوائد الحنائي الحنائيات 2/1307 (حسن)","تخريج كتاب السنة 179 (صحيح)"]},{"id":"ق-0392","fp":"2b5ee389faed","stateId":423,"easy":"ثقل الموازين بالعمل الصالح ← الفلاح","cause":"ثقل الموازين بالعمل الصالح","result":"الفلاح","explicit":true,"star":true,"otherNeedIds":[53],"ref":"سورة الأعراف: 8","srcLabel":"القرآن الكريم","quran":{"s":7,"from":8,"to":8,"text":"وَالْوَزْنُ يَوْمَئِذٍ الْحَقُّ فَمَنْ ثَقُلَتْ مَوَازِينُهُ فَأُولَئِكَ هُمُ الْمُفْلِحُونَ (8)","hl":[[32,92,1]]}},{"id":"ق-0844","fp":"0476fee2aa00","stateId":423,"easy":"الإيمان والدعاء والصبر على سخرية الساخرين ← الفوز","cause":"الإيمان والدعاء والصبر على سخرية الساخرين","result":"الفوز","explicit":true,"ref":"سورة المؤمنون: 109–111","srcLabel":"القرآن الكريم","quran":{"s":23,"from":109,"to":111,"text":"إِنَّهُ كَانَ فَرِيقٌ مِنْ عِبَادِي يَقُولُونَ رَبَّنَا آمَنَّا فَاغْفِرْ لَنَا وَارْحَمْنَا وَأَنْتَ خَيْرُ الرَّاحِمِينَ (109) فَاتَّخَذْتُمُوهُمْ سِخْرِيًّا حَتَّى أَنْسَوْكُمْ ذِكْرِي وَكُنْتُمْ مِنْهُمْ تَضْحَكُونَ (110) إِنِّي جَزَيْتُهُمُ الْيَوْمَ بِمَا صَبَرُوا أَنَّهُمْ هُمُ الْفَائِزُونَ (111)","hl":[[0,299,1]]}},{"id":"س-07665","fp":"78016ade4693","stateId":423,"easy":"إذا لم تتكلم الأمة في الولدان والقدر ← يبقى أمرها مستقيماً","cause":"ما لَمْ يَتَكلَّموا في الوِلدانِ والقَدَرِ","result":"لا يَزالُ أمْرُ هذه الأُمَّةِ مُؤامِرًا","explicit":true,"otherNeedIds":[49],"ref":"المستدرك على الصحيحين 93","srcLabel":"ابن حبان","text":["«",["لا يَزالُ أمْرُ هذه الأُمَّةِ مُؤامِرًا -",2],"أوْ قالَ مُقارِبًا- ",["ما لَمْ يَتَكلَّموا في الوِلدانِ والقَدَرِ",1],"»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه ابن حبان، والطبراني في ((المعجم الأوسط))، والبيهقي في ((القضاء والقدر)) واللفظ لهم","bab":"قدر › التكذيب بالقدر","dorar":"yzKtrcbi","merged":2,"otherRefs":["الأحاديث المختارة 13 / 11 (صحيح)"]},{"id":"س-00252","fp":"8d97cd666506","stateId":423,"easy":"إذا رُزقت عقلاً راجحاً ← فقد أفلحت","cause":"رُزِقَ لُبًّا","result":"أفلحَ مَن","explicit":true,"ref":"الجامع الصغير 1306","srcLabel":"الطبراني","text":[["أفلحَ مَن",2],[" رُزِقَ لُبًّا ",1],"[يعني حديث:  أنَّه أتى النَّبيَّ صلَّى اللهُ عليه وسلَّم فقال إنَّه كان لنا أربابٌ وربَّاتٌ نعبُدُهُنَّ مِن دونِ اللهِ عزَّ وجلَّ فدَعَوْناهُنَّ فلم يُجِبْنَ وسألْناهُنَّ فلم يُعْطينَ فجِئْناك فهَدَانا اللهُ بك فنحن نعبُدُ اللهَ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم قد أفلَح مَن رُزِقَ لُبًّا فقال يا رسولَ اللهِ ألْبِسْني ثَوبَينِ مِن ثيابِك قد لبِسْتَهما فكساه فلمَّا كان بالموقِفِ مِن عرفاتٍ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم أعِدْ عليَّ مَقالتَك فأعاد عليه فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم قد أفلَح مَن رُزِقَ لُبًّا]"],"grade":"صحيح","narrator":"قرة بن هبيرة القشيري","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي عاصم في ((الآحاد والمثاني)) (1490)، والطبراني (19/ 33) (70)، والبيهقي في ((شعب الإيمان)) (4333) جميعا بلفظه مطولا.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"yU7fjizS"},{"id":"س-05727","fp":"6856bc9f1a7f","stateId":423,"easy":"إذا عملت بعلمك ← فطوبى لك","cause":"لمن عملَ بعلمِهِ","result":"طوبى","explicit":true,"otherNeedIds":[16],"ref":"الزواجر عن اقتراف الكبائر 1/76","srcLabel":"السنة","text":["طوبى لِمن تواضعَ في غيرِ مَنقصةٍ ، وذلَّ نفسَهُ في غيرِ مسئلةٍ ، وأنفقَ مالًا جمعَهُ في غيرِ معصيةٍ ، ورحمَ أهلَ الذلِ والمسكنةِ ، وخالطَ أهلَ الفقهِ والحكمةِ ، ",["طوبى",2]," لمن طابَ كسبُهُ وصلحَتْ سريرتُهُ ، وكرمَتْ علانيتُهُ ، وعزلَ عنِ الناسِ شرُّهُ ، طوبى ",["لمن عملَ بعلمِهِ",1]," ، وأنفقَ الفضلَ من مالِهِ وأمسكَ الفضلَ من قولِهِ"],"grade":"صحيح","muhaddith":"إسناده صحيح حسن","bab":"رقائق وزهد › الكبر والتواضع","dorar":"vuHTDA6K"},{"id":"س-05882","fp":"eacd021073d5","stateId":423,"easy":"إذا حفظت ما بين لحييك ← فهو أيمن ما فيك (وإلا أشأمه)","cause":"ما بيْنَ لَحْيَيْهِ","result":"أيمنُ امرئٍ وأشأَمُه","explicit":true,"ref":"تخريج صحيح ابن حبان 5717","srcLabel":"ابن حبان","text":[["أيمنُ امرئٍ وأشأَمُه",2]," ",["ما بيْنَ لَحْيَيْهِ",1]],"grade":"صحيح","narrator":"عدي بن حاتم الطائي","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه ابن حبان (5717)، والطبراني (17/ 85) (198) كلاهما بلفظه وفي آخره زيادة، وابن عدي في ((الكامل في الضعفاء))  (8/ 343)، وابن المبارك في ((الزهد والرقائق)) (373)، وابن خزيمة في ((التوحيد)) (1/ 365) جميعا باختلاف يسير.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"d466dwtV"},{"id":"س-05912","fp":"af81f2894754","stateId":423,"easy":"إذا تزودت من الدنيا لآخرتك حتى ترضي ربك ← فنعمت الدار هي","cause":"لِمَن تَزَوَّد منها لآخِرَتِه؛ حتَّى يُرضِيَ رَبَّه","result":"نِعمَتِ الدَّارُ الدُّنيا","explicit":true,"ref":"المستدرك على الصحيحين 8083","srcLabel":"العقيلي","text":[["نِعمَتِ الدَّارُ الدُّنيا",2]," ",["لِمَن تَزَوَّد منها لآخِرَتِه؛ حتَّى يُرضِيَ رَبَّه",1]," عزَّ وجلَّ، وبِئسَتِ الدَّارُ لِمَن صَدَّتْه عنْ آخِرَتِه، وقَصَّرَت به عنْ رِضاءِ رَبِّه، وإذا قال العَبدُ: قَبَّح اللهُ الدُّنيا! قالتِ الدُّنيا: قَبَّح اللهُ أعْصانا لرَبِّه!"],"grade":"صحيح","narrator":"طارق","muhaddith":"صحيح الإسناد","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (3/ 89)، والرامهرمزي في ((أمثال الحديث)) (ص59) باختلاف يسير.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"gS2YhOY9"},{"id":"س-06776","fp":"b9063d7ae5c7","stateId":423,"easy":"إذا عاملت الله ← لا تخيب","cause":"عامِلَ اللهِ","result":"لا يَخِيبُ","explicit":true,"ref":"صحيح الأدب المفرد 141","srcLabel":"السنة","text":["عن أبي هريرة أنه قال أعينوا العاملَ مِنْ عَمَلِه فإنَّ ",["عامِلَ اللهِ",1]," ",["لا يَخِيبُ",2]," يعني الخادِمَ"],"grade":"صحيح","muhaddith":"صحيح الإسناد","bab":"عتق وولاء › الإحسان إلى العبيد","dorar":"0UkPKxrL"},{"id":"س-07530","fp":"5b957d0ea90b","stateId":423,"easy":"إذا احتججت بالقرآن ← فقد أفلحت","cause":"مَنِ احْتَجَّ بالقرآنِ","result":"فقد أَفْلَحَ","explicit":true,"ref":"سنن الترمذي 3147","srcLabel":"أحمد","text":["قلتُ لحُذَيْفَةَ بنِ اليَمَانِ : أَصَلَّى رسولُ اللهِ صلَّى اللهُ عليه وسلَّم في بَيْتِ المَقْدِسِ ؟ قال : لا ، قلتُ : بلى ، قال : أنت تقولُ ذاك يا أَصْلَعُ ؟ ! بِمَ تقولُ ذلك ؟ ! قلتُ : بالقرآنِ ، بَيْنِي وبينَك القرآنُ ، فقال حُذَيْفَةُ : ",["مَنِ احْتَجَّ بالقرآنِ ، ",1],["فقد أَفْلَحَ",2]," قال سفيانُ : يقولُ فقد احْتَجَّ ، وربما قال : قد فَلَجَ ، فقال :  سُبْحَانَ الَّذِي أَسْرَى بِعَبْدِهِ لَيْلًا مِنَ الْمَسْجِدِ الْحَرَامِ إِلَى الْمَسْجِدِ الْأَقْصَى .  قال : أَفَتُرَاهُ صَلَّى فيه ؟ قلتُ : لا . قال : لو صَلَّى فيه لَكُتِبَتْ عليكم الصلاةُ فيه ، كما كُتِبَتِ الصلاةُ في المسجدِ الحرامِ . قال حذيفةُ : قد أُتِيَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بدابَّةٍ طويلةِ الظَّهْرِ ممدودةٍ هكذا . خَطْوُهُ مَدُّ بَصَرِهِ ، فما زَايَلَا ظَهْرَ البُرَاقِ ، حتى رَأَيَا الجنةَ والنارَ ، ووَعْدَ الآخرةِ أَجْمَعَ ، ثم رَجَعا عَوْدَهُما على بَدْئِهِما . قال : ويتحدثونَ أنه رَبَطَهُ لِمَا لِيَفِرَّ منه وإنما سَخَّرَهُ له عالِمُ الغيبِ والشهادةِ"],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"حسن صحيح","takhrij":"أخرجه الحميدي (453) باختلاف يسير، وأحمد (23285) مطولًا بلفظ مقارب، وابن حبان (45 )،  والحاكم (3369) كلاهما بنحوه مختصرًا .","bab":"فضائل النبي وصفته ودلائل النبوة › الإسراء والمعراج","dorar":"6pNR92L1"},{"id":"س-00682","fp":"14dc5a39880a","stateId":423,"easy":"إذا أُعطيت العفو والعافية في الدنيا والآخرة ← فقد أفلحت","cause":"فإذا أُعطيتَ العفوَ والعافيةَ في الدُّنيا والآخرةِ","result":"فقد أفلحتَ","explicit":true,"ref":"الأربعون العشارية 211","srcLabel":"الترمذي","text":["عن أنسِ بنِ مالِكٍ أنَّ رجلًا قال: يا نبيَّ اللَّهِ أيُّ الدُّعاءِ أفضلُ، قالَ: تسألَ اللَّهَ العفوَ والعافيةَ في الدُّنيا والآخرةِ. ثمَّ أتاهُ الغدَ فقالَ: يا رسولَ اللَّهِ أيُّ الدُّعاءِ أفضلُ؟ قالَ: سَل اللَّه العفوَ والعافيةَ في الدُّنيا والآخرَةِ . ثمَّ أتاهُ اليومِ الثَّالثِ فقالَ: تسألُ اللَّه العفوَ والعافيةَ في الدُّنيا والآخرةِ، ",["فإذا أُعطيتَ العفوَ والعافيةَ في الدُّنيا والآخرةِ",1]," ",["فقد أفلحتَ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"أخرجه الترمذي (3512)، وابن ماجه (3848)، وأحمد (12291) جميعهم باختلاف يسير.","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"9Z5jPAdo","merged":2,"otherRefs":["سنن الترمذي 3512 (حسن)"]},{"id":"س-03195","fp":"663236eccc14","stateId":423,"easy":"إذا آمنت بالنبي ﷺ ولم تره ← فطوبى لك ثم طوبى","cause":"مَنْ آمنَ بهِ صلَّى اللهُ عليهِ وسلَّمَ ولمْ يَرَهُ","result":"طوبى لهُ ، ثُمَّ طوبى لهُ ، ثُمَّ طوبى لهُ","explicit":true,"otherNeedIds":[15],"ref":"السلسلة الصحيحة 3432","srcLabel":"أحمد","text":[["طوبى لهُ ، ثُمَّ طوبى لهُ ، ثُمَّ طوبى لهُ",2]," . يعني : ",["مَنْ آمنَ بهِ صلَّى اللهُ عليهِ وسلَّمَ ولمْ يَرَهُ",1]],"grade":"حسن","narrator":"أبو عبدالرحمن الجهني","muhaddith":"إسناده حسن رجاله ثقات رجال الشيخين","takhrij":"أخرجه أحمد (17388)، وابن أبي شيبة في ((مسنده)) (730)، وابن أبي عاصم في ((الآحاد والمثاني)) (2578) بنحوه تامًا.","bab":"إيمان › فضل الإيمان","dorar":"L1COmLen","merged":2,"otherRefs":["تخريج المسند لشعيب 22277 (حسن)"]},{"id":"س-04119","fp":"972f4641862f","stateId":423,"easy":"إذا لم تكن عريفاً (متولياً على قوم) ← فطوبى لك","cause":"إن لم يكنْ عَريفًا","result":"طوبَى له","explicit":true,"ref":"الترغيب والترهيب 2/29","srcLabel":"أبو يعلى","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم مرَّتْ به جِنازةٌ فقال ",["طوبَى له",2]," ",["إن لم يكنْ عَريفًا",1]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن إن شاء الله تعالى","takhrij":"أخرجه أبو يعلى (3939)، وابن عدي في ((الكامل في الضعفاء)) (15926) بلفظه.","bab":"جنائز وموت › الثناء على الجنازة والعكس","dorar":"dRf9FEeK"},{"id":"س-05624","fp":"6caa6fb75be7","stateId":423,"easy":"إذا زرعت خيراً ← توشك أن تحصد رغبة","cause":"من زرعَ خيرًا","result":"يوشِكُ أن يحصدَ رغبةً","explicit":true,"ref":"مجمع الزوائد 2/192","srcLabel":"السنة","text":["عن عبدِ اللَّهِ بنِ مسعودٍ أنَّهُ كانَ يقولُ إذا قعدَ إنَّكم في ممرِّ اللَّيلِ والنَّهارِ في آجالٍ منقوضةٍ وأعمالٍ محفوظةٍ والموتُ يأتي بغتةً ف",["من زرعَ خيرًا",1]," ",["يوشِكُ أن يحصدَ رغبةً",2]," ومن زرعَ شرًّا يوشكُ أن يحصدَ ندامةً ولكلِّ زارعٍ ما زرعَ لا يسبقُ بطيءٌ بحظِّهِ ولا يدركُ حريصٌ بحرصهِ ما لم يقدَّر لهُ فمن أعطيَ خيرًا فاللَّهُ أعطاهُ ومن وُقيَ شرًّا فاللَّهُ وقاهُ المتَّقونَ سادةٌ والفقهاءُ قادةٌ ومجالستُهم زيادةٌ"],"grade":"حسن","muhaddith":"رجاله موثقون","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"PnV6D4wI"},{"id":"س-02067","fp":"249e5961983f","stateId":423,"easy":"إذا عزلت الأذى عن طريق المسلمين ← تنتفع به","cause":"اعزِلِ الأذى عن طَريقِ المُسلِمينَ","result":"شيئًا أنتَفِعُ به","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[40],"ref":"صحيح مسلم 2618","srcLabel":"متفق عليه","text":["قُلتُ: يا نَبيَّ اللهِ عَلِّمْني ",["شيئًا أنتَفِعُ به",2],"، قال: ",["اعزِلِ الأذى عن طَريقِ المُسلِمينَ",1],"."],"grade":"صحيح","narrator":"أبو برزة الأسلمي نضلة بن عبيد","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"t8VRf74C"},{"id":"س-07406","fp":"95aeb7036c50","stateId":423,"easy":"إذا وردت على الحوض ← أفلحت","cause":"فمَن وردَ عليَّ","result":"أفلحَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج كتاب السنة 773","srcLabel":"أحمد","text":["أنا فرَطُكم علَى الحوضِ ، ",["فمَن وردَ عليَّ",1]," ",["أفلحَ",2]," ، ويؤتَى بقَومٍ فيؤخَذُ بِهم ذاتَ الشِّمالِ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه أحمد (2327)، والبزار (4879)، والطبراني (11/33) (10953) مطولاً باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"3iZkbm61"},{"id":"س-07684","fp":"97a400804d14","stateId":423,"easy":"إذا عملت ← تدرك ما كُتب لك (لا يُدرك إلا بالعمل)","cause":"بالعملِ","result":"لا يُدرَكُ ذاكَ إلَّا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح ابن حبان 108","srcLabel":"الفريابي","text":["قال عُمَرُ بنُ الخطَّابِ رضِي اللهُ عنه : يا رسولَ اللهِ نعمَلُ في شيءٍ نأتَنِفُه أم في شيءٍ قد فُرِغ منه ؟ قال : ( بل في شيءٍ قد فُرِغ منه ) قال : ففيمَ العملُ ؟ قال : ( يا عُمَرُ ",["لا يُدرَكُ ذاكَ إلَّا",2]," ",["بالعملِ",1]," ) قال : إذَنْ نجتهِدَ يا رسولَ اللهِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الفريابي في ((القدر)) (31)، والآجري في ((الشريعة)) (325) واللفظ لهما.","bab":"قدر › كل شيء بقدر","dorar":"6N681MMa"},{"id":"س-08081","fp":"ac3f6d808f0b","stateId":423,"easy":"إذا عاقبت من تحت يدك بقدر ذنوبهم ← كان كفافاً لا لك ولا عليك","cause":"إنْ كان عِقابُك إيَّاهم بقدرِ ذُنوبِهمْ","result":"كان كَفَافًا ولا لكَ ولا عليكَ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح الترغيب 3606","srcLabel":"الترمذي","text":["أنَّ رجلاً مِنْ أصْحابِ رسولهِ الله - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ - جلسَ بينَ يديْهِ، فقال: يا رسولَ الله! إنَّ لي مَمْلوكين يكذِّبونَني وَيخونونني وَيعْصونَني، وأضْرِبُهم وأشْتُمهمْ، فكيفَ أنا منهم؟ فقالَ له رسولُ الله - صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ: يُحسَبُ ما خانُوك وعَصَوكَ وكذَّبُوك وعِقابُك إيَّاهُم ، فإنْ كان عِقابُك إيَّاهُم دُونَ ذُنُوبِهمْ ؛ كان فَضْلًا لكَ ( عليهِم ) و",["إنْ كان عِقابُك إيَّاهم بقدرِ ذُنوبِهمْ",1]," ؛ ",["كان كَفَافًا ولا لكَ ولا عليكَ",2]," ، وإنْْ كان عِقابُك إيَّاهُم فَوقَ ذُنُوبِهِمُ اقْتُصَّ لهمْ مِنكَ الفَضلُ الذِي بَقِيَ قِبَلَكَ فجَعلَ الرجلُ يبْكِي بين يَدَيْ رسولِ اللهِ ويَهتِفُ فقال رسولُ اللهِ مالَكَ ؟ ما تَقرأُ كتابَ اللهِ \"ونَضَعُ الموازِين القِسطَ ليومِ القيامةِ فلا تظلمُ نفسٌ شيئًا وإن كان مثقالَ حبةٍ من خردلِ أتينا بها وكفى بنا حاسِبين\" ؟ فقال الرجلُ يا رسولَ الله ! ما أجِدُ شيئًا خيرًا من فِراقِ هؤلاءِ – يعني عَبِيدَهُ ( إنِّي ) أُشْهِدُكَ أنَّهم كلَّهم أحْرَارٌ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3165)، وأحمد (26401) باختلاف يسير","bab":"مظالم › قصاص المظالم","dorar":"C83DM1UR"}]}