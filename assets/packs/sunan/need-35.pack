{"schema":1,"kind":"sunan-chunk","version":"sunan-50a61695a4db","needId":35,"stateIds":[294,295,296,297,298,299,300,301,302],"items":[{"id":"س-05832","fp":"51270bfe6ebd","stateId":294,"easy":"إذا تيسرت خطبة المرأة وصداقها ورحمها ← فهو من يُمنها","cause":"أنْ يَتيَسَّرَ خِطبَتُها، وأنْ يَتيَسَّرَ صَداقُها، وأنْ يَتيَسَّرَ رَحِمُها","result":"مِن يُمنِ المرأةِ","explicit":true,"star":true,"otherNeedIds":[1],"ref":"المستدرك على الصحيحين 2777","srcLabel":"مسلم","text":["قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["مِن يُمنِ المرأةِ",2]," ",["أنْ يَتيَسَّرَ خِطبَتُها، وأنْ يَتيَسَّرَ صَداقُها، وأنْ يَتيَسَّرَ رَحِمُها",1],"، قالَ عُروَةُ: يعني يَتيَسَّرُ رَحِمُها للولادةِ، قالَ عِروَةُ: وأنا أَقولُ مِن عندي: مِن أَوَّلِ شُؤْمِها أنْ يَكثُرَ صَداقُها."],"grade":"صحيح","narrator":"عائشة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أحمد (24478) بلفظه، وابن حبان (4095) باختلاف يسير.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"IlPq6qIC","merged":2,"otherRefs":["كشف الخفاء 1/465 (حسن)"]},{"id":"س-02220","fp":"dacc433dd95c","stateId":294,"easy":"إذا رُزقت امرأة صالحة ← فليس في متاع الدنيا أفضل منها","cause":"المرأةِ الصَّالِحةِ","result":"ولَيسَ مِن متاعِ الدُّنيا شَيءٌ أفضلَ","explicit":true,"star":true,"otherNeedIds":[7],"ref":"صحيح ابن ماجه 1516","srcLabel":"مسلم","text":["إنَّما الدُّنيا متاعٌ ",["ولَيسَ مِن متاعِ الدُّنيا شَيءٌ أفضلَ",2]," منَ ",["المرأةِ الصَّالِحةِ",1]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1467) بنحوه، وابن ماجه (1855) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"lw1vuInB"},{"id":"س-01269","fp":"0e1e9eb52934","stateId":294,"easy":"إذا خطبت امرأة فانظر إليها ← فهو أجدر أن يؤلف بينكما","cause":"فانظُرْ إليها","result":"فإنَّه أجدَرُ أنْ يُؤدَمَ بينكما","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 18137","srcLabel":"الترمذي","text":["أتَيتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فذَكَرتُ له امرأةً أخطُبُها، فقال: اذهَبْ، ",["فانظُرْ إليها",1],"؛ ",["فإنَّه أجدَرُ أنْ يُؤدَمَ بينكما",2],"، قال: فأتَيتُ امرأةً مِن الأنصارِ، فخَطَبتُها إلى أبَوَيْها، وأخبَرتُهما بقَولِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فكأنَّهما كَرِها ذلك، قال: فسَمِعَتْ ذلك المَرأةُ وهي في خِدرِها، فقالتْ: إنْ كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ أمَرَكَ أنْ تنظُرَ، فانظُرْ، وإلا فإنِّي أنشُدُكَ. كأنَّها عَظَّمَتْ ذلك عليه، قال: فنَظَرتُ إليها؛ فتَزوَّجتُها، فذَكَرَ مِن مُوَافَقتِها."],"grade":"صحيح","narrator":"المغيرة بن شعبة","muhaddith":"صحيح إن صح سماع بكر بن عبد الله المزني من المغيرة","takhrij":"أخرجه الترمذي (1087) مختصراً، وابن ماجه (1866) باختلاف يسير، وأحمد (18137) واللفظ له","bab":"نكاح › الحث على التزويج","dorar":"vDwiQPSQ","merged":9,"otherRefs":["تخريج مشكل الآثار 11/289 (صحيح)","تخريج المسند لشعيب 18154 (صحيح)","تخريج سنن الدارقطني 3622 (صحيح)","المستدرك على الصحيحين 2734 (صحيح)","تخريج صحيح ابن حبان 4043 (صحيح)","تحفة المحتاج 2/358 (صحيح)","الإلمام بأحاديث الأحكام 2/623 (صحيح)","صحيح النسائي 3235 (صحيح)"]},{"id":"ق-0956","fp":"ff16bfcf0ca5","stateId":294,"easy":"الزواج ← السكن والمودة والرحمة","cause":"الزواج","result":"السكن والمودة والرحمة","explicit":true,"star":true,"otherNeedIds":[5],"ref":"سورة الروم: 21","srcLabel":"القرآن الكريم","quran":{"s":30,"from":21,"to":21,"text":"وَمِنْ آيَاتِهِ أَنْ خَلَقَ لَكُمْ مِنْ أَنْفُسِكُمْ أَزْوَاجًا لِتَسْكُنُوا إِلَيْهَا وَجَعَلَ بَيْنَكُمْ مَوَدَّةً وَرَحْمَةً إِنَّ فِي ذَلِكَ لَآيَاتٍ لِقَوْمٍ يَتَفَكَّرُونَ (21)","hl":[[0,127,1]]}},{"id":"س-03743","fp":"b108bd53490d","stateId":294,"easy":"إذا تزوجت ← فخير هذه الأمة أكثرها نساء","cause":"تَزَوَّج","result":"فإنَّ خَيرَ هذه الأُمَّةِ كان أكثَرَها نِساءً","explicit":true,"star":true,"otherNeedIds":[41],"ref":"تخريج المسند لشعيب 2048","srcLabel":"السنة","text":["عن سَعيدِ بنِ جُبَيرٍ، قال: لَقيَني ابنُ عَبَّاسٍ، فقال: ",["تَزَوَّج",1],"تَ؟ قال: قُلتُ: لا، قال: تَزَوَّج، ثُمَّ لَقيَني بَعدَ ذلك. فقال: تَزَوَّجتَ؟ قال: قُلتُ: لا، قال: تَزَوَّج؛ ",["فإنَّ خَيرَ هذه الأُمَّةِ كان أكثَرَها نِساءً",2],"."],"grade":"صحيح","narrator":"سعيد بن جبير","muhaddith":"صحيح لغيره","bab":"اعتصام بالسنة › لزوم السنة","dorar":"lQRLzgyr","merged":4,"otherRefs":["صحيح البخاري 5069 (صحيح)","تخريج المسند لشعيب 2179 (صحيح)","المستدرك على الصحيحين 2711 (صحيح)"]},{"id":"س-03631","fp":"bb3ba0e3c865","stateId":294,"easy":"إذا تزوجت الودود الولود ← فالنبي ﷺ مكاثر بكم الأمم","cause":"تَزوَّجوا الوَدودَ الوَلودَ","result":"فإنِّي مُكاثِرٌ بكم الأُمَمَ","explicit":true,"ref":"المستدرك على الصحيحين 2722","srcLabel":"ابن حبان","text":["جاءَ رَجلٌ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: يا رسولَ اللهِ، إنِّي أَصبْتُ امرأةً ذاتَ حَسَبٍ ومَنصِبٍ ومالٍ، إلَّا أنَّها لا تَلِدُ، أفأَتزوَّجُها؟ فنَهاه، ثُمَّ أَتاهُ الثَّانيةَ، فقالَ له مِثلَ ذلك، فنَهاه، ثُمَّ أَتاهُ الثَّالثةَ، فقالَ له مِثلَ ذلك، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["تَزوَّجوا الوَدودَ الوَلودَ",1],"؛ ",["فإنِّي مُكاثِرٌ بكم الأُمَمَ",2],"."],"grade":"صحيح","narrator":"معقل بن يسار","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داوود (2050)، وابن حبان (2358)، والبيهقي في ((معرفة السنن والآثار)) (13458) جميعا بلفظه.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"TcysexEE","merged":3,"otherRefs":["مجمع الزوائد 4/255 (صحيح)","الصحيح المسند 1126 (صحيح)"]},{"id":"س-01276","fp":"ef0af17da105","stateId":294,"easy":"إذا تزوجت فلا تتزوج عاقراً ← فالنبي ﷺ مكاثر بكم","cause":"لا تَزَّوَّجَنَّ عَجوزًا، ولا عاقِرًا","result":"فإنِّي مُكاثِرٌ بكُم","explicit":true,"ref":"المستدرك على الصحيحين 5360","srcLabel":"الطبراني","text":["قالَ لي رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ذاتَ يومٍ: يا عِياضُ، ",["لا تَزَّوَّجَنَّ عَجوزًا، ولا عاقِرًا",1],"؛ ",["فإنِّي مُكاثِرٌ بكُم",2],"."],"grade":"صحيح","narrator":"عياض بن غنم","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني (17/ 368) (1008)، وابن عدي في ((الكامل)) (6/ 250)، والخطيب في ((تاريخه)) (4/ 264) واللفظ لهم.","bab":"نكاح › الحث على التزويج","dorar":"we7RdR3P","merged":2,"otherRefs":["السلسلة الصحيحة 1782 (صحيح)"]},{"id":"س-05822","fp":"e17ac5c02bce","stateId":294,"easy":"إذا تحاب اثنان ← فلا شيء لهما مثل النكاح","cause":"النِّكاحِ","result":"لم نَرَ لِلْمُتحابَّينِ مِثلَ","explicit":true,"ref":"تخريج زاد المعاد 4/250","srcLabel":"ابن ماجه","text":[["لم نَرَ لِلْمُتحابَّينِ مِثلَ",2]," ",["النِّكاحِ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (1847) واللفظ له، والبزار (4856) بلفظ: ((التزويج)).","bab":"رقائق وزهد › الوصايا النافعة","dorar":"UNh0EUDf","merged":2,"otherRefs":["هداية الرواة 3029 (صحيح)"]},{"id":"س-01266","fp":"b2df8ef9d5e0","stateId":294,"easy":"إذا تيسر صداق المرأة ← فهي من خير النساء","cause":"أيسرُهنَّ صداقًا","result":"خيرُهنَّ","explicit":true,"similar":["س-05946"],"ref":"صحيح ابن حبان 4034","srcLabel":"الطبراني","text":[["خيرُهنَّ",2]," ",["أيسرُهنَّ صداقًا",1],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (2/61)، والطبراني (11/78) (11100)","bab":"نكاح › الحث على التزويج","dorar":"N6P6e3Y5"},{"id":"س-01267","fp":"f64188bd9f5c","stateId":294,"easy":"إذا تيسر أمر المرأة وقلّ صداقها ← فهو من يُمنها","cause":"تسهيلُ أمرِها وقلَّةُ صداقِها","result":"مِن يُمنِ المرأةِ","explicit":true,"ref":"صحيح ابن حبان 4095","srcLabel":"أحمد","text":[["مِن يُمنِ المرأةِ",2]," ",["تسهيلُ أمرِها وقلَّةُ صداقِها",1]," ) قال عروةُ: وأنا أقولُ مِن عندي: ومِن شؤمِها تعسيرُ أمرِها وكثرةُ صداقِها"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (24607)، والحاكم (2739)، والطبراني في ((الأوسط)) (3612) جميعا بإختلاف يسير.","bab":"نكاح › الحث على التزويج","dorar":"Ir5UKWun"},{"id":"س-01881","fp":"c3f51e52c820","stateId":294,"easy":"إذا يسّرت الصداق ← فهو خير الصداق","cause":"أيسرُه","result":"خيرُ الصداقِ","explicit":true,"ref":"النوافح العطرة 136","srcLabel":"أبو داود","text":["خيرُ الصَّداقِ ",["أيسرُه",1]," [يعني حديث:  أنَّ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ قال لرجلٍ أترضَى أن أُزوِّجَك فلانةً قال نعم وقال للمرأةِ أترضَينَ أن أُزوِّجكِ فلانًا قالت نعم فزوَّج أحدَهما صاحبَه ولم يفرضْ لها صداقًا ولم يعطِها شيئًا وكان ممن شهد الحُديبيةَ وكان من شهد الحُديبيةَ له سهمٌ بخيبرَ فلما حضرتْه الوفاةُ قال إنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ زوَّجني فلانةً ولم أفرضْ لها صداقًا ولم أُعطِها شيئًا وإني أُشهدُكم أني أعطيتُها صداقًا سهمي بخيبرَ فأخذتْ سهمًا فباعتْه بمائةِ ألفٍ.\n قال: وقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ",["خيرُ الصداقِ",2]," أيسرُه]"],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (2742)، والبيهقي (14448) بلفظه تامًا، وأبو داود (2117) بنحوه تامًا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"eK2sVMZB"},{"id":"س-05777","fp":"aaa5e27e26ae","stateId":294,"easy":"إذا تزوجت فاظفر بذات الدين والخلق ← تربت يداك","cause":"فعليك بذاتِ الدِّينِ والخُلقِ","result":"ترِبت يمينُك","explicit":true,"ref":"الترغيب والترهيب 3/93","srcLabel":"أحمد","text":["تُنكحُ المرأةُ على إحدَى خصالٍ لجمالِها ومالِها وخُلقِها ودينِها ",["فعليك بذاتِ الدِّينِ والخُلقِ",1]," ",["ترِبت يمينُك",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (11782)، وأبو يعلى (1012)، وابن حبان (4037) باختلاف يسير.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"wHe9Oh6j"},{"id":"س-05787","fp":"966de5f254ff","stateId":294,"easy":"إذا تسرّيت بالإماء ← فهن مباركات الأرحام","cause":"بالسَّراري","result":"فإنَّهنَّ مبارَكاتُ الأرحامِ","explicit":true,"ref":"الجامع الصغير 5509","srcLabel":"العقيلي","text":["عليكُم ",["بالسَّراري",1]," ، ",["فإنَّهنَّ مبارَكاتُ الأرحامِ",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه العقيلي في ((الضعفاء)) (1338)، وابن الجوزي في ((الموضوعات)) (1254)، والسيوطي في ((رفع شأن الحبشان)) (صـ213) واللفظ لهم.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"osO4p1Wc"},{"id":"س-05849","fp":"7b893518b0cd","stateId":294,"easy":"إذا تزوجت الشابة ← فهي أطيب فماً وأنتق رحماً","cause":"عَليكُم بِشَوابِّ النِّساءِ","result":"فإنَّهنَّ أطيبُ أفواهًا، وأَنتقُ أرحامًا، وَأسخَنُ أَقْبالًا","explicit":true,"ref":"صحيح الجامع 4078","srcLabel":"السنة","text":[["عَليكُم بِشَوابِّ النِّساءِ؛ ",1],["فإنَّهنَّ أطيبُ أفواهًا، وأَنتقُ أرحامًا، وَأسخَنُ أَقْبالًا",2],"."],"grade":"صحيح","narrator":"سفيان بن عبدالله الثقفي","muhaddith":"صحيح","takhrij":"لم نقف عليه مسنداً.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"afYl0bXZ"},{"id":"س-01261","fp":"f1253207670a","stateId":294,"easy":"إذا اخترت للزواج ذات الدين ← تربح (تربت يداك)","cause":"فعليكَ بذاتِ الدِّينِ","result":"تَرِبَت يَداكَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"similar":["س-01268"],"ref":"صحيح مسلم 715","srcLabel":"متفق عليه","text":["تَزَوَّجتُ امرَأةً في عَهدِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فلَقيتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم، فقال: يا جابِرُ تَزَوَّجتَ؟ قُلتُ: نَعَم، قال: بكرٌ أم ثَيِّبٌ؟ قُلتُ: ثَيِّبٌ، قال: فهَلَّا بكرًا تُلاعِبُها؟ قُلتُ: يا رَسولَ اللهِ، إنَّ لي أخَواتٍ، فخَشيتُ أن تَدخُلَ بَيني وبينَهُنَّ، قال: فذاكَ إذَن، إنَّ المَرأةَ تُنكَحُ على دينِها، ومالِها، وجَمالِها، ",["فعليكَ بذاتِ الدِّينِ",1]," ",["تَرِبَت يَداكَ",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5080)، ومسلم (715).","bab":"نكاح › الحث على التزويج","dorar":"SWEIa9vx","merged":8,"otherRefs":["صحيح البخاري 5090 (صحيح)","تخريج سنن الدارقطني 3803 (صحيح)","إتحاف الخيرة المهرة 4/ 6 (حسن)","تخريج صحيح ابن حبان 4036 (صحيح)","مجمع الزوائد 4/257 (صحيح)","صحيح الجامع 3003 (صحيح)","مختصر المقاصد 327 (صحيح)"]},{"id":"س-05850","fp":"cceec376c7f2","stateId":294,"easy":"إذا تزوجت البكر ← فهي أعذب فماً وأنتق رحماً وأرضى باليسير","cause":"عليكم بالأبكارِ","result":"فإنهنَّ أعذبُ أفواهًا ، وأنتَقُ أرحامًا ، وأسخَنُ أقبالًا ، وأرضى باليسيرِ من العملِ","explicit":true,"ref":"صحيح الجامع 4053","srcLabel":"ابن السني","text":[["عليكم بالأبكارِ ، ",1],["فإنهنَّ أعذبُ أفواهًا ، وأنتَقُ أرحامًا ، وأسخَنُ أقبالًا ، وأرضى باليسيرِ من العملِ",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن","takhrij":"أخرجه ابن السني كما في ((الجامع الصغير)) للسيوطي (2/98)، وأبو نعيم في ((الطب النبوي)) (448)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"5xGwcoS7","merged":2,"otherRefs":["السلسلة الصحيحة 623 (حسن)"]},{"id":"س-05946","fp":"b444908e5345","stateId":294,"easy":"إذا تيسر صداقكِ ← تكونين من خير النساء","cause":"أيسرُكنَّ صَداقًا","result":"خيرُكنَّ","explicit":true,"repOf":"س-01266","ref":"مختصر المقاصد 424","text":[["خيرُكنَّ",2]," ",["أيسرُكنَّ صَداقًا",1]],"grade":"حسن","narrator":"[عبدالله بن عباس]","muhaddith":"حسن لغيره","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (2/61)، وابن حبان (4034)، والطبراني (11/78) (11100) باختلاف يسير.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"t4LCTieY"},{"id":"س-01271","fp":"d43a6769d72e","stateId":294,"easy":"إذا تحاب اثنان فتزوجا ← فلم يُرَ للمتحابين مثل الزواج","cause":"التَّزوُّجِ","result":"لمْ يُرَ للمُتَحابِّينَ مِثلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"المستدرك على الصحيحين 2714","srcLabel":"مسلم","text":[["لمْ يُرَ للمُتَحابِّينَ مِثلُ",2]," ",["التَّزوُّجِ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح على شرط مسلم... لأن سفيان بن عيينة، ومعمر بن راشد أوقفاه عن إبراهيم بن ميسرة، عن ابن عباس","takhrij":"أخرجه ابن ماجه (1847) والطبراني (10895) 11/  17)، والبيهقي (13453) واللفظ لهم","bab":"نكاح › الحث على التزويج","dorar":"Zhb1cfXS"},{"id":"س-07543","fp":"f5ea1e623963","stateId":294,"easy":"إذا عُقد لك النكاح فدُعي لك ← تُرجى لك البركة والألفة والسعة في الرزق","cause":"إمْلاكَ رجلٍ من أصحابِهِ","result":"على الخيرِ والبركةِ والأُلْفَةِ والطائِرِ الميمونِ والسعةِ في الرزقِ باركَ اللهُ لكم","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"otherNeedIds":[1],"ref":"مجمع الزوائد 4-59","srcLabel":"الطبراني","text":["شهِدَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["إمْلاكَ رجلٍ من أصحابِهِ",1]," فقال ",["على الخيرِ والبركةِ والأُلْفَةِ والطائِرِ الميمونِ والسعةِ في الرزقِ باركَ اللهُ لكم",2]," دفِّفُوا على رأْسِهِ فَجِيءَ بِدُفٍّ فضُرِبَ به فأَقْبَلَتْ الأطباقُ عليها فاكهةٌ وسُكَّرٌ فنُثِرَ علَيْهِ وكَفَّ الناسُ أيدِيَهم فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ما لكم لا تَنْتَهِبُونَ قالوا يا رسولَ اللهِ أَوَ لم تَنْهَ عن النُّهْبَةِ قال إِنَّما نَهَيْتُكُمْ عنِ نُهْبَةِ العساكرِ فأمَّا العُرْساتُ فلا فحادَثَهم وحادَثُوهُ"],"grade":"حسن","narrator":"معاذ بن جبل","muhaddith":"فيه حازم مولى بني هاشم عن لمازة ولم أجد من ترجمهما وبقية رجاله ثقات","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (1/142)، والطحاوي في ((شرح معاني الآثار)) (4449)، والطبراني (20/97) (191) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › تواضعه صلى الله عليه وسلم","dorar":"E2i9PRir"},{"id":"س-01268","fp":"163e68dadd7d","stateId":294,"easy":"إذا اخترت للزواج ذات الدين والخلق ← تربح","cause":"فخُذْ ذاتَ الدِّينِ والخُلُقِ","result":"تَرِبَتْ يَمينُك","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-01261","ref":"تخريج المسند لشعيب 11765","text":["تُنكَحُ المرَأةُ على إحدى خِصالٍ ثلاثٍ: تُنكَحُ المرَأةُ على مالِها، وتُنكَحُ المرَأةُ على جَمالِها، وتُنكَحُ المرَأةُ على دِينِها، ",["فخُذْ ذاتَ الدِّينِ والخُلُقِ",1]," ",["تَرِبَتْ يَمينُك",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (11765) واللفظ له، وابن أبي شيبة (17434)، وعبد بن حميد (986)","bab":"نكاح › الحث على التزويج","dorar":"jeofnJXo"},{"id":"ق-0214","fp":"b37fd08097ce","stateId":295,"easy":"إرادة الإصلاح بين الزوجين ← توفيق الله بينهما","cause":"إرادة الإصلاح بين الزوجين","result":"توفيق الله بينهما","explicit":true,"star":true,"otherNeedIds":[47],"ref":"سورة النساء: 35","srcLabel":"القرآن الكريم","quran":{"s":4,"from":35,"to":35,"text":"وَإِنْ خِفْتُمْ شِقَاقَ بَيْنِهِمَا فَابْعَثُوا حَكَمًا مِنْ أَهْلِهِ وَحَكَمًا مِنْ أَهْلِهَا إِنْ يُرِيدَا إِصْلَاحًا يُوَفِّقِ اللَّهُ بَيْنَهُمَا إِنَّ اللَّهَ كَانَ عَلِيمًا خَبِيرًا (35)","hl":[[95,149,1]]}},{"id":"ق-0255","fp":"c06f6ccebd46","stateId":295,"easy":"الصلح ← خير","cause":"الصلح","result":"خير","explicit":true,"star":true,"otherNeedIds":[48],"ref":"سورة النساء: 128","srcLabel":"القرآن الكريم","quran":{"s":4,"from":128,"to":128,"text":"وَإِنِ امْرَأَةٌ خَافَتْ مِنْ بَعْلِهَا نُشُوزًا أَوْ إِعْرَاضًا فَلَا جُنَاحَ عَلَيْهِمَا أَنْ يُصْلِحَا بَيْنَهُمَا صُلْحًا وَالصُّلْحُ خَيْرٌ وَأُحْضِرَتِ الْأَنْفُسُ الشُّحَّ وَإِنْ تُحْسِنُوا وَتَتَّقُوا فَإِنَّ اللَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًا (128)","hl":[[126,144,1]]}},{"id":"س-04314","fp":"b8a1bd7e978d","stateId":295,"easy":"إذا كنت مؤمناً ← تُرفع لك ذريتك لتقرّ عينك","cause":"المُؤمِنُ","result":"تُرفَعُ له ذُرِّيَّتُهُ لِيُقِرَّ اللهُ عزَّ وجلَّ عَيْنَهُ، وإنْ كانوا دونَهُ في العمَلِ","explicit":true,"otherNeedIds":[56],"ref":"تخريج مشكل الآثار 3/ 105","srcLabel":"الحاكم","text":["سأَلْتُ سعيدَ بنَ جُبَيْرٍ عن هذه الآيةِ: (وَالَّذِينَ آمَنُوا وَأَتْبَعْنَاهُمْ ذُرِّيَّاتِهِمْ بِإِيمَانٍ)، قال: قال ابنُ عبَّاسٍ: ",["المُؤمِنُ",1]," ",["تُرفَعُ له ذُرِّيَّتُهُ لِيُقِرَّ اللهُ عزَّ وجلَّ عَيْنَهُ، وإنْ كانوا دونَهُ في العمَلِ",2],"."],"grade":"صحيح","narrator":"سعيد بن جبير","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (3/ 105)، وسعيد بن منصور (2065) واللفظ لهما، والحاكم (3744) بنحوه.","bab":"جنة › درجات الجنة","dorar":"VHrUVFCH"},{"id":"س-01323","fp":"85236768c94b","stateId":295,"easy":"إذا خفت نفرة زوجتك فصلّيا معاً ركعتين وادعُ ← يؤلّف الله بينكما (أثر ابن مسعود)","cause":"فأْمُرْها أنْ تُصَلِّيَ وراءَكَ رَكْعَتَيْنِ","result":"وإِنَّي أخافُ أنْ تفرُكَنِي","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"count","t":"ركعتين"},"ref":"آداب الزفاف 23","srcLabel":"الطبراني","text":["جاءَ رجلٌ يقالُ له : أبو حَرِيْزٍ ، فقال : إِنَّي تزوجْتُ جاريَةً شابَّةً [ بكرًا ] ، ",["وإِنَّي أخافُ أنْ تفرُكَنِي",2]," ، فقال عبدُ الله ( يعني ابنُ مسعودٍ ) : إِنَّ الإلْفَ مِنَ اللهِ ، والفَرَكَ مِنَ الشيطانِ ، يُريدُ أنْ يُكَرِّهَ إليكم ما أَحَلَّ اللهُ لكم ، فإذا أَتَتْكَ ",["فأْمُرْها أنْ تُصَلِّيَ وراءَكَ رَكْعَتَيْنِ",1]," . زاد في روايَةٍ أُخْرَى عنِ ابنِ مسعودٍ : وقلْ : اللهمَّ باركْ لي في أهلِي ، وباركْ لَهُمْ فِيَّ ، اللهمَّ اجمعْ بينَنَا ما جمَعْتَ بخيرٍ ؛ وفَرِّقْ بينَنَا إذا فرقْتَ إلى خيرٍ ."],"grade":"صحيح","narrator":"شقيق بن سلمة","muhaddith":"إسناده صحيح","takhrij":"أخرجه عبد الرزاق (10460)، وابن أبي شيبة (17441)،  والطبراني (9/ 204)، (8993) جميعهم باختلاف يسير.","bab":"نكاح › عشرة النساء","dorar":"WkS0cYaA"},{"id":"س-01328","fp":"945cd7afd913","stateId":295,"easy":"إذا خشيت أن تبغضك زوجتك فصلّيا ركعتين معاً ← يؤلّف الله بينكما (أثر ابن مسعود)","cause":"فمرْها فلْتُصَلِّ خَلْفَكَ رَكْعَتَيْنِ","result":"وَإِنِّي خَشِيتُ أنْ تَفْرُكَنِي","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"count","t":"ركعتين"},"ref":"مجمع الزوائد 4/295","srcLabel":"الطبراني","text":["جاء رجلٌ من بُجَيْلَةَ إلى عبدِ اللهِ يَعْنِي ابْنَ مسعودٍ فقال إِنِّي تَزَوَّجْتُ جَارِيَةً بِكْرًا ",["وَإِنِّي خَشِيتُ أنْ تَفْرُكَنِي",2]," فَقَالَ عَبْدُ اللهِ إنَّ الْإِلْفَ مِنَ اللهِ وَإِنَّ الْفَرَكَ مِنَ الشَّيْطَانِ يُكَرِّهُ إلِيهِمَا فإِذَا دخلتَ علَيْهَا ",["فمرْها فلْتُصَلِّ خَلْفَكَ رَكْعَتَيْنِ",1]," قال الأعمشُ فذَكَرْتُهُ لِإِبْرَاهيمَ قال عبدُ اللهِ قلِ اللَّهمَّ بارِكْ لي في أهْلِي وبارِكْ لهم فِيَّ اللَّهمَّ ارْزُقْهُمْ مِنِّي وارزُقْنِي منهم اللهمَّ اجمعْ بيْنَنَا مَا جَمَعْتَ إِلَى خَيْرٍ وفَرِّقْ بَيْنَنَا إِذَا فَرَّقْتَ إِلَى خَيْرٍ"],"grade":"صحيح","narrator":"شقيق بن سلمة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه عبد الرزاق (10460)، والطبراني (9/ 204)، (8993) كلاهما بلفظه، وابن أبي شيبة (17441) باختلاف يسير.","bab":"نكاح › عشرة النساء","dorar":"jEKpbKqG"},{"id":"س-01360","fp":"97d7a94485ce","stateId":296,"easy":"إذا كنت خيراً لأهلك ← تكون من خير الناس","cause":"خَيْرُكم لأهْلِه، وأنا مِن خَيْرِكم لأهْلي","result":"خَيْرُكم","explicit":true,"star":true,"otherNeedIds":[41,40],"ref":"الأحاديث المختارة 11 / 203","srcLabel":"متفق عليه","text":["«أنَّ الرِّجالَ اسْتَأذَنوا رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ في ضَرْبِ النِّساءِ، فأَذِنَ لهم، فباتَ يَسمَعُ صَوْتًا عالِيًا، فقالَ: ما هذا؟ قالوا: أَذِنْتَ للرِّجالِ في ضَرْبِ النِّساءِ، فضَرَبوهم، فنَهاهم، وقالَ: ",["خَيْرُكم",2],[" خَيْرُكم لأهْلِه، وأنا مِن خَيْرِكم لأهْلي»",1],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"نكاح › عشرة النساء","dorar":"F6rTrM3b","merged":10,"otherRefs":["السلسلة الصحيحة 285 (صحيح)","صحيح الجامع 3266 (صحيح)","هداية الرواة 3189 (صحيح)","مسند عمر 1/409 (صحيح)","الإفصاح عن أحاديث النكاح 184 (صحيح)","المستدرك على الصحيحين 7533 (صحيح)","السلسلة الصحيحة 1835 (حسن)","تخريج مشكل الآثار 2523 (صحيح)","فيض القدير 3/ 497 (حسن)"]},{"id":"س-01361","fp":"c898218f476f","stateId":296,"easy":"إذا أدت المرأة حق زوجها كله ← تؤدي حق الله عليها","cause":"حتَّى تُؤَدِّيَ حَقَّ زَوْجِها كلَّه","result":"ولا تُؤَدِّي المَرْأةُ حَقَّ اللهِ عليها كلَّه","explicit":true,"star":true,"otherNeedIds":[44],"ref":"الأحاديث المختارة 13 / 124","srcLabel":"متفق عليه","text":["«قَدِمَ مُعاذٌ اليَمَنَ -أو قالَ: الشَّامَ- فرأى النَّصارى تَسجُدُ لبَطارِقتِها أو أَساقِفتِها، فرَوَّى في نَفْسِه أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ أَحَقُّ أن يُعظَّمَ. فلمَّا قَدِمَ، قالَ: يا رَسولَ اللهِ! رَأيْتُ النَّصارى تَسجُدُ لبَطارِقتِها وأَساقِفتِها فرَوَّأْتُ في نَفْسي أنَّك أَحَقُّ أن تُعَظَّمَ، فقالَ: لو كُنْتُ آمِرًا أحَدًا يَسجُدُ لأحَدٍ لأَمَرْتُ المَرْأةَ أن تَسجُدَ لزَوْجِها، ",["ولا تُؤَدِّي المَرْأةُ حَقَّ اللهِ عليها كلَّه",2]," ",["حتَّى تُؤَدِّيَ حَقَّ زَوْجِها كلَّه",1],"، حتَّى لو سَأَلَها نَفْسَها وهي على ظَهْرِ قَتَبٍ لأَعْطَتْه إيَّاه»."],"grade":"صحيح","narrator":"عبدالله بن أبي أوفى","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"نكاح › عشرة النساء","dorar":"BUvF1ggk","merged":5,"otherRefs":["مجمع الزوائد 4/311 (صحيح)","الأحاديث المختارة 13 / 124 (صحيح)","صحيح ابن ماجه 1515 (صحيح)","صحيح ابن حبان 4171 (صحيح)"]},{"id":"س-05889","fp":"eef7bf0d17b7","stateId":296,"easy":"إذا تركتها على عوجها ← تستمتع بها","cause":"وإنْ تَترُكْها","result":"تستَمتِعْ بها وفيها عِوَجٌ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 10856","srcLabel":"متفق عليه","text":["لا تستَقيمُ لكَ المرأةُ على خَليقةٍ واحِدةٍ، وإنَّما هي كالضِّلعِ، إنْ تُقِمْها تَكسِرْها، ",["وإنْ تَترُكْها",1]," ",["تستَمتِعْ بها وفيها عِوَجٌ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (5184) دون لفظ: \"لا تستَقيمُ لكَ المرأةُ على خَليقةٍ واحِدةٍ\"، ومسلم (1468) بلفظ: \" لن تستقيم لك على طريقة\"","bab":"رقائق وزهد › الوصايا النافعة","dorar":"pr6A68nJ","merged":3,"otherRefs":["صحيح الجامع 1942 (حسن)","تخريج المسند لشعيب 21339 (حسن)"]},{"id":"س-05888","fp":"a2d279bd1a78","stateId":296,"easy":"إذا حاولت تقويم المرأة بالكلية ← تكسرها","cause":"إنْ تُقِمْها","result":"تَكسِرْها","explicit":true,"star":true,"otherNeedIds":[39],"ref":"تخريج المسند لشعيب 10856","srcLabel":"متفق عليه","text":["لا تستَقيمُ لكَ المرأةُ على خَليقةٍ واحِدةٍ، وإنَّما هي كالضِّلعِ، ",["إنْ تُقِمْها",1]," ",["تَكسِرْها",2],"، وإنْ تَترُكْها تستَمتِعْ بها وفيها عِوَجٌ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (5184) دون لفظ: \"لا تستَقيمُ لكَ المرأةُ على خَليقةٍ واحِدةٍ\"، ومسلم (1468) بلفظ: \" لن تستقيم لك على طريقة\"","bab":"رقائق وزهد › الوصايا النافعة","dorar":"pr6A68nJ","merged":2,"otherRefs":["تخريج المسند لشعيب 21339 (حسن)"]},{"id":"س-01336","fp":"e708c10f8e7d","stateId":296,"easy":"إذا كانت زوجتك تسرّك إذا نظرت وتطيعك إذا أمرت وتحفظك إذا غبت ← فهي خير النساء","cause":"الَّتي إذا نَظَر إليها زوجُها سَرَّتْه، وإذا أمَرَها أطاعَتْه، وإذا غابَ عنها حَفِظَتْه في نفسِها ومالِه","result":"خَيرُ نِسائكمُ","explicit":true,"similar":["س-01337"],"ref":"الإفصاح عن أحاديث النكاح 29","srcLabel":"السنة","text":[["خَيرُ نِسائكمُ",2],[" الَّتي إذا نَظَر إليها زوجُها سَرَّتْه، وإذا أمَرَها أطاعَتْه، وإذا غابَ عنها حَفِظَتْه في نفسِها ومالِه",1],".\nوفي [رِوايةٍ]: ولا تُخالِفُه في نَفسِها ولا مالِها. وفي أُخرى: في نَفسِها ومالِهِ."],"grade":"صحيح","muhaddith":"[روايات] صحيحة","bab":"نكاح › عشرة النساء","dorar":"oisG01CO","merged":4,"otherRefs":["الأحاديث المختارة 9 / 456 (صحيح)","صحيح الجامع 3299 (صحيح)","المصابيح في الأحاديث المتواترة 609 (صحيح)"]},{"id":"س-07129","fp":"d920c892d042","stateId":296,"easy":"إذا أطاعت المرأة زوجها وسرّته وحفظته ← فهي خير النساء","cause":"الَّتي تُطيعُ زوجَها إذا أمرَ، وتسرُّهُ إذا نظرَ، وتحفظُهُ في نفسِها ومالِهِ","result":"خيرِ النِّساءِ","explicit":true,"ref":"المحلى 10/334","srcLabel":"النسائي","text":["أنَّهُ سُئِلَ عن ",["خيرِ النِّساءِ",2],"؟ فقالَ: ",["الَّتي تُطيعُ زوجَها إذا أمرَ، وتسرُّهُ إذا نظرَ، وتحفظُهُ في نفسِها ومالِهِ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (3231)، وأحمد (7421)، والبيهقي (13606) باختلاف يسير.","bab":"علم › حسن السؤال ونصح العالم","dorar":"PJNN4qmd","merged":2,"otherRefs":["الفتح السماوي 2/488 (حسن)"]},{"id":"س-03894","fp":"e826c4878b57","stateId":296,"easy":"إذا رُزقت امرأة صالحة تسرك وتطيعك وتحفظك ← فهي خير ما تكنزه","cause":"المرأةُ الصَّالحةُ، إذا نَظَرَ إليها سرَّتْهُ، وإذا أمَرَها أطاعَتْهُ، وإذا غابَ عنها حَفِظتْهُ","result":"ألا أُخْبرُكَ بخيرِ ما يَكنِزُهُ المرءُ","explicit":true,"otherNeedIds":[48],"ref":"المستدرك على الصحيحين 3323","srcLabel":"أبو داود","text":["عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهُما، قالَ: لمَّا نَزَلَتْ: {وَالَّذِينَ يَكْنِزُونَ الذَّهَبَ وَالْفِضَّةَ وَلَا يُنْفِقُونَهَا فِي سَبِيلِ اللَّهِ} [التوبة: 34] كَبُرَ ذلك على المسلمينَ وقالوا: ما يَستطيعُ أَحدُنا أنْ يترُكَ مالًا لولدِهِ يبقى بعدَهُ. فقالَ عُمَرُ: أنا أُفَرِّجُ عنكم. قالَ: فانطَلَقوا وانطَلَقَ عُمَرُ، واتَّبعَهُ ثَوْبانُ فأَتَوْا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ عُمَرُ: يا نَبيَّ اللهِ، قد كَبُرَ على أصحابِكَ هذه الآيةُ. فقالَ نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ: «إنَّ اللهَ لمْ يَفرِضِ الزَّكاةَ إلَّا لِيُطَيِّبَ بها ما بَقِيَ مِن أموالِكُم، وإنَّما فَرَضَ المواريثَ في أموالٍ تَبْقى بعْدَكم». قالَ: فكَبَّرَ عُمَرُ، ثُمَّ قالَ له النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: «",["ألا أُخْبرُكَ بخيرِ ما يَكنِزُهُ المرءُ",2],"؛ ",["المرأةُ الصَّالحةُ، إذا نَظَرَ إليها سرَّتْهُ، وإذا أمَرَها أطاعَتْهُ، وإذا غابَ عنها حَفِظتْهُ",1],"»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داود (1664)، والبيهقي(7235) واللفظ لهما","bab":"تفسير آيات › سورة التوبة","dorar":"DefeprPc"},{"id":"س-02981","fp":"fe0caaa8e04b","stateId":296,"easy":"إذا كنتِ متزوجة ← فزوجك جنتك ونارك","cause":"فأين أنتِ منه","result":"فإنَّما هو جَنَّتُكِ ونارُكِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[55],"ref":"المستدرك على الصحيحين 2807","srcLabel":"الطبراني","text":["عنْ حُصَينِ بنِ مِحصَنٍ، قالَ: حدَّثَتْني عَمَّتي، قالتْ: أَتيتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ في بعضِ الحاجةِ، فقالَ: أيْ هذه، أذاتُ بَعْلٍ أنتِ؟ قلتُ: نَعَمْ، قالَ: كيف أنتِ له؟ قالتْ: ما آلوهُ إلَّا ما عَجَزْتُ عنه، قالَ: ",["فأين أنتِ منه",1],"؛ ",["فإنَّما هو جَنَّتُكِ ونارُكِ",2],"؟"],"grade":"صحيح","narrator":"[عمة حصين بن محصن]","muhaddith":"صحيح","takhrij":"أخرجه الحميدي (358)، والطبراني في ((الكبير)) (25/ 183) (449)، وأبو نعيم في ((معرفة الصحابة)) (8071) بنحوه.","bab":"إيمان › الوعيد","dorar":"voXm1A5Y","merged":3,"otherRefs":["السلسلة الصحيحة 2612 (حسن)","الفروع لابن مفلح 8/ 413 (حسن)"]},{"id":"س-01348","fp":"19841eec8af6","stateId":296,"easy":"إذا استمتعت بزوجتك على عوجها ← تستمتع بها، وإن أقمتها كسرتها","cause":"فإِنَّ استمْتَعْتَ بِها","result":"استمتعْتَ بِها وبِها عِوَجٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"صحيح الجامع 1943","srcLabel":"متفق عليه","text":["إِنَّ المرأةَ خُلِقَتْ مِنْ ضِلَعٍ ، لَنْ تستقيمَ لَكَ علَى طريقَةٍ ، ",["فإِنَّ استمْتَعْتَ بِها",1]," ",["استمتعْتَ بِها وبِها عِوَجٌ",2]," ، وإِنْ ذهبْتَ تقيمُها كسرْتَهَا ، وكسرُها طلاقُها"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1468) واللفظ له، وأخرجه البخاري (3331، 5184) مفرقاً بنحوه","bab":"نكاح › عشرة النساء","dorar":"cHcxL7m5","merged":5,"otherRefs":["صحيح ابن حبان 4180 (صحيح)","صحيح البخاري 5184 (صحيح)","صحيح مسلم 1468 (صحيح)","تخريج صحيح ابن حبان 4179 (صحيح)"]},{"id":"س-05985","fp":"ed267410fef5","stateId":296,"easy":"إذا رُزقت زوجة صالحة تطيعك وتسرك وتبرّك ← فهي خير ما تستفيده بعد التقوى","cause":"زَوجةٍ صالحةٍ ، إن أمرَها أطاعتْهُ ، وإن نظرَ إليها سرَّتهُ ، وإن أقسمَ عليها أبرَّتهُ ، وإن غابَ عنها نصحَتهُ في نفسِها ومالِهِ","result":"ما استفادَ المؤمنُ بعدَ تقوى اللَّهِ عزَّ وجلَّ ، خيرًا لهُ مِن","explicit":true,"otherNeedIds":[7],"ref":"الجامع الصغير 7792","srcLabel":"ابن ماجه","text":[["ما استفادَ المؤمنُ بعدَ تقوى اللَّهِ عزَّ وجلَّ ، خيرًا لهُ مِن",2]," ",["زَوجةٍ صالحةٍ ، إن أمرَها أطاعتْهُ ، وإن نظرَ إليها سرَّتهُ ، وإن أقسمَ عليها أبرَّتهُ ، وإن غابَ عنها نصحَتهُ في نفسِها ومالِهِ",1]],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"حسن","takhrij":"أخرجه ابن ماجه (1857)، والطبراني (8/ 222) (7881)، وابن عساكر (43/ 279) واللفظ لهم.","bab":"رقائق وزهد › تقوى الله","dorar":"4K4UxlzC"},{"id":"س-01337","fp":"b7b86626dd14","stateId":296,"easy":"إذا كانت زوجتك تسرّك وتطيعك وتحفظك ← فهي خير النساء","cause":"خَيرُ النِّساءِ مَنْ تَسَرُّ إذا نَظَرَ، وتُطيعُ إذا أَمَرَ، ولا تُخالِفُه في نَفسِها ومالِها","result":"أيُّ النِّساءِ خيرٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-01336","ref":"المستدرك على الصحيحين 2720","text":["عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ مثلَهُ: [سُئلَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",["أيُّ النِّساءِ خيرٌ",2],"؟ فقالَ: ",["خَيرُ النِّساءِ مَنْ تَسَرُّ إذا نَظَرَ، وتُطيعُ إذا أَمَرَ، ولا تُخالِفُه في نَفسِها ومالِها.]",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه النسائي (3231)، وأحمد (9587) والبيهقي في ((شعب الإيمان)) (8363) بلفظ مقارب","bab":"نكاح › عشرة النساء","dorar":"JMbW5T9Q","merged":3,"otherRefs":["تخريج سنن أبي داود 3/98 (صحيح)","صحيح الجامع 3298 (صحيح)"]},{"id":"س-08324","fp":"e5db02d1e377","stateId":296,"easy":"إذا أردتِ أن تكوني زوجتي في الجنة فلا تتزوجي بعدي ← فالمرأة لآخر أزواجها (أثر حذيفة)","cause":"فلا تَزوَّجي بَعدي","result":"فإنَّ المَرأةَ في الجنَّةِ لآخِرِ أزواجِها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[55],"ref":"تخريج سير أعلام النبلاء 2/208","srcLabel":"البيهقي","text":["عن حُذَيفةَ: أنَّه قال لامرأتِه: إنْ سَرَّكِ أنْ تَكوني زَوجَتي في الجنَّةِ، ",["فلا تَزوَّجي بَعدي",1],"؛ ",["فإنَّ المَرأةَ في الجنَّةِ لآخِرِ أزواجِها",2]," في الدُّنيا؛ فلذلك حرُمَ على أزواجِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ أنْ يَنكِحنَ بعدَه؛ لأنَّهنَّ أزواجُه في الجنَّةِ."],"grade":"حسن","narrator":"صلة","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (2/ 121)، والبيهقي (13551) واللفظ لهما.","bab":"مناقب وفضائل › فضائل أزواج النبي صلى الله عليه وسلم","dorar":"hwIn5DOJ"},{"id":"س-01345","fp":"5b05fb863c6b","stateId":296,"easy":"إذا داريت زوجتك ← فإن فيها أوداً وبلغة","cause":"و إنْ تدارِيَها","result":"فإنْ فيها أَودًا و بَلغةً","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"صحيح الأدب المفرد 574","srcLabel":"البخاري","text":["إِنَّ المرأةَ خُلِقَتْ من ضِلَعٍ ، و إنَّكَ إنْ تريدَ أنْ تقيمَها تكسرُها ، ",["و إنْ تدارِيَها",1]," ",["فإنْ فيها أَودًا و بَلغةً",2]],"grade":"حسن","narrator":"أبو ذر.","muhaddith":"حسن","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (747) بلفظه مطولًا، والدارمي (2267)، والنسائي في ((الكبرى)) (9107) باختلاف يسير.","bab":"نكاح › عشرة النساء","dorar":"1ts9uPLO"},{"id":"س-01343","fp":"31e53d6cc5f6","stateId":296,"easy":"إذا داريت زوجتك ← تعيش بها","cause":"فَدارِها","result":"تَعِشْ بِها","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"المستدرك على الصحيحين 7539","srcLabel":"أحمد","text":["ألَا إنَّ المرأةَ خُلِقَتْ مِن ضِلَعٍ، وإنَّكَ إنْ تُرِدْ إقامتَها تَكْسِرْها، ",["فَدارِها",1]," ",["تَعِشْ بِها",2],". ثَلاثَ مرَّاتٍ."],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"صحيح الإسناد على شرط الشيخين","takhrij":"أخرجه أحمد (20093)، وابن أبي الدنيا في ((النفقة على العيال)) (470) بلفظه.","bab":"نكاح › عشرة النساء","dorar":"mPzaJmFk","merged":3,"otherRefs":["الجامع الصغير 2106 (صحيح)","صحيح الموارد 1090 (صحيح)"]},{"id":"س-01349","fp":"22c4e8cb24eb","stateId":296,"easy":"إذا تزوجت المرأة بعد وفاة زوجها ← فهي لآخر أزواجها في الجنة","cause":"فتزوَّجَتْ بعدَهُ","result":"فِهِي لآخِرِ أزواجِها","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[55],"ref":"صحيح الجامع 2704","srcLabel":"الطبراني","text":["أيُّما امرأةٍ تُوُفِّي عنها زوجها ، ",["فتزوَّجَتْ بعدَهُ",1]," ، ",["فِهِي لآخِرِ أزواجِها",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (3130) واللفظ له، وأخرجه أبو يعلى كما في ((إتحاف الخيرة المهرة)) للبوصيري (4/115) باختلاف يسير، وأبو الشيخ في ((طبقات المحدثين)) (4/36) مختصراً","bab":"نكاح › عشرة النساء","dorar":"4NO8kHTi"},{"id":"س-01356","fp":"59022c96231b","stateId":296,"easy":"إذا كنتِ ذات زوج ← فهو جنتك ونارك","cause":"فكيف أنتِ له","result":"فإنه جنتُكِ ونارُكِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"otherNeedIds":[55],"ref":"المتجر الرابح 314","srcLabel":"النسائي","text":["أنَّ عمَّةً له أتتِ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ فقال لها: أذاتُ زوجٍ أنتِ؟ قالت: نعم قال: فأين أنتِ منه؟ قالت: ما آلوه إلا ما عجزتُ عنه قال: ",["فكيف أنتِ له",1]," ",["فإنه جنتُكِ ونارُكِ",2],"."],"grade":"صحيح","narrator":"حصين بن محصن","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (19003)، والحميدي (358)، والنسائي في ((السنن الكبرى)) (8914) جميعهم بلفظه.","bab":"نكاح › عشرة النساء","dorar":"ezq61oeT"},{"id":"س-08368","fp":"0e66ac3d217a","stateId":297,"easy":"إذا وصلت أهل ودّ أبيك بعد موته ← فهو من أبرّ البر","cause":"صِلةَ الرَّجُلِ أهلَ وُدِّ أبيه بَعدَ أن يولِّيَ","result":"إنَّ مِن أبَرِّ البِرِّ","explicit":true,"star":true,"otherNeedIds":[41],"ref":"صحيح مسلم 2552","srcLabel":"متفق عليه","text":["أنَّه كان إذا خَرَجَ إلى مَكَّةَ كان له حِمارٌ يَتَرَوَّحُ عليه إذا مَلَّ رُكوبَ الرَّاحِلةِ، وعِمامةٌ يَشُدُّ بها رَأسَه، فبينا هو يَومًا على ذلك الحِمارِ إذ مَرَّ به أعرابيٌّ، فقال: ألَستَ ابنَ فُلانِ بنِ فُلانٍ؟ قال: بَلى، فأعطاه الحِمارَ، وقال: اركَبْ هذا، والعِمامةَ، قال: اشدُدْ بها رَأسَكَ، فقال له بَعضُ أصحابِه: غَفَرَ اللهُ لكَ! أعطَيتَ هذا الأعرابيَّ حِمارًا كُنتَ تَرَوَّحُ عليه، وعِمامةً كُنتَ تَشُدُّ بها رَأسَكَ، فقال: إنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["إنَّ مِن أبَرِّ البِرِّ",2]," ",["صِلةَ الرَّجُلِ أهلَ وُدِّ أبيه بَعدَ أن يولِّيَ",1],"، وإنَّ أباه كان صَديقًا لعُمَرَ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"wksmE3Kw","merged":3,"otherRefs":["صحيح مسلم 2552 (صحيح)","تخريج المسند لشعيب 5896 (صحيح)"]},{"id":"س-03840","fp":"70597083aab7","stateId":297,"easy":"إذا أحببت أن تصل أباك في قبره ← فصِل إخوانه بعده","cause":"فلْيصِلْ إخوانَ أبيه بعدَه","result":"مَن أحَبَّ أنْ يصِلَ أباه في قبرِه","explicit":true,"star":true,"ref":"تخريج صحيح ابن حبان 432","srcLabel":"البخاري","text":["قدِمْتُ المدينةَ فأتاني عبدُ اللهِ بنُ عُمرَ فقال: أتدري لمَ أتَيْتُك ؟ قال: قُلْتُ: لا قال: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( ",["مَن أحَبَّ أنْ يصِلَ أباه في قبرِه ",2],["فلْيصِلْ إخوانَ أبيه بعدَه",1]," ) وإنَّه كان بينَ أبي عُمَرَ وبينَ أبيكَ إِخاءٌ ووُدٌّ فأحبَبْتُ أنْ أصِلَ ذاك"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه أبو يعلى (5669)، وابن عساكر في ((تاريخ دمشق)) (26/44)","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"JbwurZxd"},{"id":"س-06809","fp":"39e212af38f3","stateId":297,"easy":"إذا وجدت والدك مملوكاً فاشتريته فأعتقته ← فذلك جزاؤه","cause":"يَـجِدَه مَـمْلوكًا، فيَشتَريَه فيُعْتِقَه","result":"لا يَـجْزي وَلدٌ والِدَه إلَّا","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 7143","srcLabel":"مسلم","text":[["لا يَـجْزي وَلدٌ والِدَه إلَّا",2]," أنْ ",["يَـجِدَه مَـمْلوكًا، فيَشتَريَه فيُعْتِقَه",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (1510) باختلاف يسير","bab":"عتق وولاء › فضل العتق","dorar":"Kr2hH9mc","merged":2,"otherRefs":["تخريج مشكل الآثار 1356 (صحيح)"]},{"id":"س-06111","fp":"69985b256eb8","stateId":297,"easy":"إذا بررت آباءك ← يبرك أبناؤك","cause":"بِرُّوا آباءَكُم","result":"تبرَّكُمْ أبناؤُكُمْ","explicit":true,"ref":"الجامع الصغير 5424","srcLabel":"الحاكم","text":["عِفُّوا عنِ نساءِ الناسِ تعِفَّ نساؤُكم ، و",["بِرُّوا آباءَكُم",1]," ",["تبرَّكُمْ أبناؤُكُمْ",2]," ، ومَنْ أتاهُ أخوهُ مُتَنَصِّلًا فلْيَقْبَلْ ذلِكَ منْهُ ، مُحِقًّا كانَ أوْ مُبْطِلًا ، فإِنْ لم يَفْعَلْ لَمْ يَرِدْ عَلَيَّ الحوْضَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الحاكم في ((مستدركه)) (7258)، والشجري في ((أماليه)) (1982) واللفظ لهما.","bab":"رقائق وزهد › مكارم الأخلاق والعفو عمن ظلم","dorar":"B4Sv4Ht8","merged":2,"otherRefs":["الجامع الصغير 3124 (صحيح)"]},{"id":"س-02039","fp":"68d604fe62f3","stateId":297,"easy":"إذا وصلت صديق أبيك ← فهو من تمام برّه","cause":"أن يَصِلَ الرجلُ صدِيقَ أبيهِ","result":"مِن تمامِ بِرِّ الأبِ","explicit":true,"similar":["س-02175"],"ref":"عارضة الأحوذي 4/307","srcLabel":"السنة","text":[["مِن تمامِ بِرِّ الأبِ",2]," ",["أن يَصِلَ الرجلُ صدِيقَ أبيهِ",1]],"grade":"صحيح","muhaddith":"صحيح","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"ooYutrGJ"},{"id":"س-02175","fp":"482c26ece2e3","stateId":297,"easy":"إذا وصلت صديق أبيك ← فهو من البر","cause":"أن تَصِلَ صديقَ أبيك","result":"من البِرِّ","explicit":true,"repOf":"س-02039","ref":"صحيح الجامع 5901","text":[["من البِرِّ",2]," ",["أن تَصِلَ صديقَ أبيك",1]],"grade":"صحيح","narrator":"عبدالله بن عمر وأنس بن مالك","muhaddith":"صحيح","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"DGj5U6G6"},{"id":"س-05522","fp":"b74329537f37","stateId":297,"easy":"إذا خرجت تسعى على والديك الكبيرين ← فأنت في سبيل الله","cause":"خَرَجَ يَسعى على أبَوينِ شَيخَينِ كَبيرَينِ","result":"فهو في سَبيلِ اللهِ","explicit":true,"otherNeedIds":[42],"ref":"حسن الأسوة بما ثبت في النسوة 564","srcLabel":"الطبراني","text":["مَرَّ على النَّبيِّ صلَّى اللهُ عليه وسلَّم رَجُلٌ فرَأى أصحابُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم مِن جَلَدِه ونَشاطِه، فقالوا: يا رَسولَ اللهِ، لو كان هذا في سَبيلِ اللهِ! فقال رسولُ اللهِ: إن كان خَرَجَ يَسعى على ولدِه صِغارًا فهو في سَبيل اللهِ، وإن كان ",["خَرَجَ يَسعى على أبَوينِ شَيخَينِ كَبيرَينِ",1]," ",["فهو في سَبيلِ اللهِ",2],"، وإن كان خَرَجَ يَسعى على نَفسِه يُعِفُّها فهو في سَبيلِ اللهِ، وإن كان خَرَجَ يَسعى رياءً ومُفاخَرةً فهو في سَبيلِ الشَّيطانِ"],"grade":"صحيح","narrator":"كعب بن عجرة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((الأوسط)) (6835)، وبحشل في ((تاريخ واسط)) (صـ162) واللفظ لهما.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"yhlIFCs7"},{"id":"س-08305","fp":"181c59ede684","stateId":297,"easy":"إذا كنت باراً بأمك ← تدخل الجنة (من قصة حارثة)","cause":"كانَ أبرَّ النَّاسِ بأمِّه","result":"دخلتُ الجنَّةَ فسمِعتُ قراءةً","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[55],"ref":"الإصابة في تمييز الصحابة 1/298","srcLabel":"النسائي","text":[["دخلتُ الجنَّةَ فسمِعتُ قراءةً",2]," فقلتُ : مَن هذا ؟ فقيل : حارثةُ بنُ النُّعمانِ ، فقال رسولُ اللهِ صلَّى اللهُ عليهِ وآلِه وسلَّمَ : كذلِكمُ البرُّ ، ",["كانَ أبرَّ النَّاسِ بأمِّه",1]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (24080)، والنسائي في ((السنن الكبرى)) (8233) باختلاف يسير","bab":"مناقب وفضائل › بعض من شهد النبي بأنهم من أهل الجنة","dorar":"UggjNVUJ","merged":2,"otherRefs":["السلسلة الصحيحة 913 (صحيح)"]},{"id":"س-01357","fp":"38a542b1c53d","stateId":297,"easy":"إذا بررت والدتك ← فهي أوسط أبواب الجنة","cause":"الوالدةَ","result":"أَوسطُ أبْوابِ الجنَّةِ","explicit":true,"otherNeedIds":[55],"ref":"تخريج المسند لشعيب 21726","srcLabel":"الترمذي","text":["أتى رَجُلٌ أبا الدَّرْداءِ، فقال: إنَّ امرأتي بنتُ عَمِّي وأنا أُحِبُّها، وإنَّ والدتي تَأمُرُني أنْ أُطلِّقَها، فقال: لا آمُرُكَ أنْ تُطلِّقَها، ولا آمُرُكَ أنْ تَعصيَ والدتَكَ، ولكنْ أُحدِّثُكَ حديثًا سَمِعتُه مِن رسولِ اللهِ صَلَّى اللهُ عليه وسلَّمَ، سَمِعتُ رسولَ اللهِ صَلَّى اللهُ عليه وسلَّمَ يقولُ: إنَّ ",["الوالدةَ",1]," ",["أَوسطُ أبْوابِ الجنَّةِ",2],"، فإنْ شِئتَ فأَمسِكْ، وإنْ شِئتَ فدَعْ."],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"حسن","takhrij":"أخرجه الترمذي (1900)، وابن ماجه (3663)، وأحمد (21726) واللفظ له","bab":"نكاح › عشرة النساء","dorar":"CabBd3GP"},{"id":"س-02269","fp":"b202ef234a4b","stateId":297,"easy":"إذا صليت على والديك بعد موتهما واستغفرت لهما وأنفذت عهدهما ← فذلك من برهما","cause":"الصَّلاةُ عليهما، والاستغفارُ لهما، وإنفاذُ عهودِهما مِن بعدِهما، وإكرامُ صديقِهما وصِلةُ رحمِهما الَّتي لا رحِمَ لك إلَّا مِن قِبَلِهما","result":"هل بقي لي بعدَ موتِهما مِن بِرِّهما شيءٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح ابن حبان 418","srcLabel":"أبو داود","text":["أتى رسولَ اللهِ صلَّى اللهُ عليه وسلَّم رجلٌ مِن بني سلِمةَ وأنا عندَه فقال: يا رسولَ اللهِ إنَّ أبويَّ قد هلَكا ف",["هل بقي لي بعدَ موتِهما مِن بِرِّهما شيءٌ",2]," ؟ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( نَعم، ",["الصَّلاةُ عليهما، والاستغفارُ لهما، وإنفاذُ عهودِهما مِن بعدِهما، وإكرامُ صديقِهما وصِلةُ رحمِهما الَّتي لا رحِمَ لك إلَّا مِن قِبَلِهما",1]," ) قال الرَّجلُ: ما أكثَرَ هذا يا رسولَ اللهِ وأطيَبَه! قال: ( فاعمَلْ به )"],"grade":"صحيح","narrator":"أبو أسيد","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (5142)، وابن ماجه (3664)، وأحمد (16059) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"hr1ajIv7","merged":5,"otherRefs":["الأحكام الوسطى 4/ 255 (صحيح)","المستدرك على الصحيحين 7466 (صحيح)","الفتوحات الربانية 4/106 (حسن)","عارضة الأحوذي 4/307 (حسن)"]},{"id":"س-03841","fp":"3b341e9fb9e7","stateId":298,"easy":"إذا قطعتك رحمك فوصلتها ← فأنت الواصل حقاً","cause":"مَن إذا قطَعَتْه رَحمُه وصَلَها","result":"ولكنَّ الواصلَ","explicit":true,"star":true,"otherNeedIds":[41],"ref":"تخريج المسند لشعيب 6817","srcLabel":"البخاري","text":["إنَّ الرَّحمَ مُعلَّقةٌ بالعرشِ، وليس الواصلُ بالمُكافئِ، ",["ولكنَّ الواصلَ",2]," ",["مَن إذا قطَعَتْه رَحمُه وصَلَها",1],"، قال يزيدُ: المواصلَ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه البخاري (5991)، وأبو داود (1697) مختصراً، وأحمد (6817) واللفظ له","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"PsSdLICb","merged":2,"otherRefs":["مختصر العلو 30 (صحيح)"]},{"id":"س-00309","fp":"d58c4330abc0","stateId":298,"easy":"إذا عرفت أنسابك ← تصل أرحامك","cause":"اعرِفوا أنسابَكم","result":"تصِلُوا أرحامَكم","explicit":true,"ref":"المطالب العالية 3/108","srcLabel":"البخاري","text":["كنتُ عندَ ابنِ عبَّاسٍ رضيَ اللهُ عنهُما فأتاهُ رجلٌ فسألَه : مَن أنتَ ؟ فمتَّ لهُ برَحِمٍ بَعيدةٍ ، فألانَ لهُ القَولَ ، وقال : قالَ رَسولُ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ : ",["اعرِفوا أنسابَكم",1]," ",["تصِلُوا أرحامَكم",2]," ، فإنَّهُ لا قُرْبَ للرَّحِمِ إذا قُطِعَتْ وإن كانَت قريبةً ، ولا بُعْدَ لها إذا وُصِلَتْ وإن كانَت بَعيدةً"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الطيالسي (2880) بلفظه، والبخاري في ((الأدب المفرد)) (73)، والحاكم (7283) كلاهما باختلاف يسير.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"XCyzFCwj"},{"id":"س-03114","fp":"75e96e21f98b","stateId":298,"easy":"إذا وصلت رحمك ← يصلك الله","cause":"فمَن يَصِلْها","result":"أصِلْهُ","explicit":true,"similar":["س-03919"],"otherNeedIds":[24,25,36],"ref":"تخريج المسند لشعيب 1659","srcLabel":"أبو داود","text":["عن إبراهيمَ بنِ عَبدِ اللهِ بنِ قارِظٍ، أنَّ أباهُ حدَّثَهُ أنَّهُ دخَلَ على عَبدِ الرَّحمنِ بنِ عَوفٍ وهو مَريضٌ، فقال له عَبدُ الرَّحمنِ: وصَلَتْكَ رَحِمٌ؛ إنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قال: قال اللهُ عَزَّ وجَلَّ: أنا الرَّحمنُ، خلَقتُ الرَّحِمَ، وشقَقتُ لها مِنَ اسْمي، ",["فمَن يَصِلْها",1]," ",["أصِلْهُ",2],"، ومَن يَقطَعْها أقطَعْه، فأبُتَّهُ -أو قال: مَن يَبُتَّها أبُتَّهُ."],"grade":"صحيح","narrator":"عبدالرحمن بن عوف","muhaddith":"صحيح لغيره","takhrij":"أخرجه من طرق أبو داود (1694)، والترمذي (1907)، وأحمد (1659) واللفظ له","bab":"إيمان › توحيد الأسماء والصفات","dorar":"fpqNXsUY","merged":15,"otherRefs":["الجامع الصغير 7323 (حسن)","صحيح البخاري 5988 (صحيح)","صحيح الأدب المفرد 39 (صحيح)","الجامع الصغير 1759 (صحيح)","المستدرك على الصحيحين 7473 (صحيح)","المستدرك على الصحيحين 7478 (صحيح)","صحيح الأدب المفرد 38 (صحيح)","تخريج شرح السنة 3432 (صحيح)","الأحاديث المختارة 2588 (صحيح)","صحيح الترغيب 2531 (حسن)","صحيح الجامع 3548 (صحيح)","الأحاديث المختارة 894 (صحيح)","صحيح الجامع 3549 (صحيح)","تخريج كتاب السنة 536 (صحيح)"]},{"id":"س-03919","fp":"ca79309ea2a3","stateId":298,"easy":"إذا وصلت رحمك ← يصلك الله","cause":"فمَنْ أشارتْ إليه بوَصْلٍ","result":"وَصلَهُ اللهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03114","otherNeedIds":[23],"ref":"المستدرك على الصحيحين 3221","text":["عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهُما: {وَاتَّقُوا اللَّهَ الَّذِي تَسَاءَلُونَ بِهِ وَالْأَرْحَامَ} [النساء: 1] قالَ: إنَّ الرَّحِمَ لتُقطَعُ، وإنَّ النِّعمةَ لتُكفَرُ، وإنَّ اللهَ إذا قارَبَ بيْنَ القُلوبِ لمْ يُزَحْزحْها شيءٌ أبدًا. ثُمَّ قَرَأَ: {لَوْ أَنْفَقْتَ مَا فِي الْأَرْضِ جَمِيعًا مَا أَلَّفْتَ بَيْنَ قُلُوبِهِمْ} [الأنفال: 63]. قالَ: وقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «الرَّحِمُ شُعبةٌ مِنَ الرَّحمنِ، وإنَّها تَجيءُ يومَ القيامةِ تَكلَّمُ بلسانٍ طَليقٍ ذَليقٍ، ",["فمَنْ أشارتْ إليه بوَصْلٍ",1]," ",["وَصلَهُ اللهُ",2],"، ومَنْ أشارتْ إليه بقَطْعٍ قَطَعَهُ اللهُ»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (2953)، والبخاري في ((الأدب المفرد)) (73)، والبيهقي في ((شعب الإيمان)) (7570) بنحوه","bab":"تفسير آيات › سورة النساء","dorar":"z41aGlyP"},{"id":"س-07161","fp":"52d71b1658ce","stateId":298,"easy":"إذا وصلت الرحم وقريت الضيف ووفيت بالذمة ← يكون ذلك في عقبك فلن يذلوا ولن يفتقروا","cause":"كانَ يصلُ الرَّحمَ ويَقري الضَّيفَ ويفي بالذِّمَّةِ","result":"يكونُ ذلكَ في عقبِكَ فلن يُذلُّوا أبدًا ولن يفتقِروا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[1],"ref":"الأجوبة المرضية 2/733","srcLabel":"الحاكم","text":["سلمانُ بنُ عامرٍ الضَّبِّيُّ رضي اللَّه عنه قالَ أتيتُ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ فقلتُ يا رسولَ اللَّهِ إنَّ أبي ",["كانَ يصلُ الرَّحمَ ويَقري الضَّيفَ ويفي بالذِّمَّةِ",1]," قالَ ولم يدركِ الإسلامَ قالَ: لا، فلمَّا ولَّيتُ. قالَ: عليَّ بالشَّيخ قالَ: ",["يكونُ ذلكَ في عقبِكَ فلن يُذلُّوا أبدًا ولن يفتقِروا",2]],"grade":"حسن","narrator":"سلمان بن عامر الضبي","muhaddith":"إسناده رجاله ثقات","takhrij":"أخرجه ابن أبي عاصم في ((الآحاد والمثاني)) (1135) والطبراني (6/ 276) (6213) والحاكم (6560) باختلاف يسير.","bab":"علم › حسن السؤال ونصح العالم","dorar":"1SxY5XwP"},{"id":"ق-0131","fp":"5e692fa25c0c","stateId":299,"easy":"نذر الذرية لله والدعاء لها بالإعاذة من الشيطان ← القبول الحسن والإنبات الحسن والرزق","cause":"نذر الذرية لله والدعاء لها بالإعاذة من الشيطان","result":"القبول الحسن والإنبات الحسن والرزق","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[44],"ref":"سورة آل عمران: 35–37","srcLabel":"القرآن الكريم","quran":{"s":3,"from":35,"to":37,"text":"إِذْ قَالَتِ امْرَأَتُ عِمْرَانَ رَبِّ إِنِّي نَذَرْتُ لَكَ مَا فِي بَطْنِي مُحَرَّرًا فَتَقَبَّلْ مِنِّي إِنَّكَ أَنْتَ السَّمِيعُ الْعَلِيمُ (35) فَلَمَّا وَضَعَتْهَا قَالَتْ رَبِّ إِنِّي وَضَعْتُهَا أُنْثَى وَاللَّهُ أَعْلَمُ بِمَا وَضَعَتْ وَلَيْسَ الذَّكَرُ كَالْأُنْثَى وَإِنِّي سَمَّيْتُهَا مَرْيَمَ وَإِنِّي أُعِيذُهَا بِكَ وَذُرِّيَّتَهَا مِنَ الشَّيْطَانِ الرَّجِيمِ (36) فَتَقَبَّلَهَا رَبُّهَا بِقَبُولٍ حَسَنٍ وَأَنْبَتَهَا نَبَاتًا حَسَنًا وَكَفَّلَهَا زَكَرِيَّا كُلَّمَا دَخَلَ عَلَيْهَا زَكَرِيَّا الْمِحْرَابَ وَجَدَ عِنْدَهَا رِزْقًا قَالَ يَا مَرْيَمُ أَنَّى لَكِ هَذَا قَالَتْ هُوَ مِنْ عِنْدِ اللَّهِ إِنَّ اللَّهَ يَرْزُقُ مَنْ يَشَاءُ بِغَيْرِ حِسَابٍ (37)","hl":[[0,675,1]]}},{"id":"ق-0203","fp":"fd52c673e96e","stateId":299,"easy":"تقوى الله والقول السديد في أيتام الناس ← حفظ ذرية العبد من بعده","cause":"تقوى الله والقول السديد في أيتام الناس","result":"حفظ ذرية العبد من بعده","explicit":true,"star":true,"ref":"سورة النساء: 9","srcLabel":"القرآن الكريم","quran":{"s":4,"from":9,"to":9,"text":"وَلْيَخْشَ الَّذِينَ لَوْ تَرَكُوا مِنْ خَلْفِهِمْ ذُرِّيَّةً ضِعَافًا خَافُوا عَلَيْهِمْ فَلْيَتَّقُوا اللَّهَ وَلْيَقُولُوا قَوْلًا سَدِيدًا (9)","hl":[[0,142,1]]}},{"id":"ق-0362","fp":"535a76ef9908","stateId":299,"easy":"الإحسان ← الهداية والذرية الصالحة (وكذلك نجزي المحسنين)","cause":"الإحسان","result":"الهداية والذرية الصالحة (وكذلك نجزي المحسنين)","explicit":true,"star":true,"otherNeedIds":[13],"ref":"سورة الأنعام: 84","srcLabel":"القرآن الكريم","quran":{"s":6,"from":84,"to":84,"text":"وَوَهَبْنَا لَهُ إِسْحَاقَ وَيَعْقُوبَ كُلًّا هَدَيْنَا وَنُوحًا هَدَيْنَا مِنْ قَبْلُ وَمِنْ ذُرِّيَّتِهِ دَاوُودَ وَسُلَيْمَانَ وَأَيُّوبَ وَيُوسُفَ وَمُوسَى وَهَارُونَ وَكَذَلِكَ نَجْزِي الْمُحْسِنِينَ (84)","hl":[[0,204,1]]}},{"id":"ق-0736","fp":"9bf936440228","stateId":299,"easy":"صلاح الأب ← حفظ الله ذريته ومالهم","cause":"صلاح الأب","result":"حفظ الله ذريته ومالهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"سورة الكهف: 82","srcLabel":"القرآن الكريم","quran":{"s":18,"from":82,"to":82,"text":"وَأَمَّا الْجِدَارُ فَكَانَ لِغُلَامَيْنِ يَتِيمَيْنِ فِي الْمَدِينَةِ وَكَانَ تَحْتَهُ كَنْزٌ لَهُمَا وَكَانَ أَبُوهُمَا صَالِحًا فَأَرَادَ رَبُّكَ أَنْ يَبْلُغَا أَشُدَّهُمَا وَيَسْتَخْرِجَا كَنْزَهُمَا رَحْمَةً مِنْ رَبِّكَ وَمَا فَعَلْتُهُ عَنْ أَمْرِي ذَلِكَ تَأْوِيلُ مَا لَمْ تَسْطِعْ عَلَيْهِ صَبْرًا (82)","hl":[[103,226,1]]}},{"id":"ق-0747","fp":"cdb90780f51d","stateId":299,"easy":"اعتزال الشرك وأهله ودعاء الله ← هبة الذرية الصالحة والرحمة ولسان الصدق","cause":"اعتزال الشرك وأهله ودعاء الله","result":"هبة الذرية الصالحة والرحمة ولسان الصدق","explicit":true,"otherNeedIds":[36,23],"ref":"سورة مريم: 48–50","srcLabel":"القرآن الكريم","quran":{"s":19,"from":48,"to":50,"text":"وَأَعْتَزِلُكُمْ وَمَا تَدْعُونَ مِنْ دُونِ اللَّهِ وَأَدْعُو رَبِّي عَسَى أَلَّا أَكُونَ بِدُعَاءِ رَبِّي شَقِيًّا (48) فَلَمَّا اعْتَزَلَهُمْ وَمَا يَعْبُدُونَ مِنْ دُونِ اللَّهِ وَهَبْنَا لَهُ إِسْحَاقَ وَيَعْقُوبَ وَكُلًّا جَعَلْنَا نَبِيًّا (49) وَوَهَبْنَا لَهُمْ مِنْ رَحْمَتِنَا وَجَعَلْنَا لَهُمْ لِسَانَ صِدْقٍ عَلِيًّا (50)","hl":[[0,329,1]]}},{"id":"ق-0791","fp":"ca9dae614b5f","stateId":299,"easy":"الصلاح وعبادة الله ← النجاة وهبة الذرية الصالحة والإمامة في الدين","cause":"الصلاح وعبادة الله","result":"النجاة وهبة الذرية الصالحة والإمامة في الدين","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[38],"ref":"سورة الأنبياء: 71–73","srcLabel":"القرآن الكريم","quran":{"s":21,"from":71,"to":73,"text":"وَنَجَّيْنَاهُ وَلُوطًا إِلَى الْأَرْضِ الَّتِي بَارَكْنَا فِيهَا لِلْعَالَمِينَ (71) وَوَهَبْنَا لَهُ إِسْحَاقَ وَيَعْقُوبَ نَافِلَةً وَكُلًّا جَعَلْنَا صَالِحِينَ (72) وَجَعَلْنَاهُمْ أَئِمَّةً يَهْدُونَ بِأَمْرِنَا وَأَوْحَيْنَا إِلَيْهِمْ فِعْلَ الْخَيْرَاتِ وَإِقَامَ الصَّلَاةِ وَإِيتَاءَ الزَّكَاةِ وَكَانُوا لَنَا عَابِدِينَ (73)","hl":[[0,332,1]]}},{"id":"ق-0943","fp":"aafabae576e5","stateId":299,"easy":"الهجرة إلى الله ← هبة الذرية الصالحة وأجر الدنيا والصلاح في الآخرة","cause":"الهجرة إلى الله","result":"هبة الذرية الصالحة وأجر الدنيا والصلاح في الآخرة","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[40,7],"ref":"سورة العنكبوت: 26–27","srcLabel":"القرآن الكريم","quran":{"s":29,"from":26,"to":27,"text":"فَآمَنَ لَهُ لُوطٌ وَقَالَ إِنِّي مُهَاجِرٌ إِلَى رَبِّي إِنَّهُ هُوَ الْعَزِيزُ الْحَكِيمُ (26) وَوَهَبْنَا لَهُ إِسْحَاقَ وَيَعْقُوبَ وَجَعَلْنَا فِي ذُرِّيَّتِهِ النُّبُوَّةَ وَالْكِتَابَ وَآتَيْنَاهُ أَجْرَهُ فِي الدُّنْيَا وَإِنَّهُ فِي الْآخِرَةِ لَمِنَ الصَّالِحِينَ (27)","hl":[[19,273,1]]}},{"id":"ق-1269","fp":"52b05b4a14da","stateId":299,"easy":"الإيمان واتباع الذرية بإيمان ← إلحاق الذرية بهم في الجنة بلا نقص","cause":"الإيمان واتباع الذرية بإيمان","result":"إلحاق الذرية بهم في الجنة بلا نقص","explicit":true,"otherNeedIds":[55],"ref":"سورة الطور: 21","srcLabel":"القرآن الكريم","quran":{"s":52,"from":21,"to":21,"text":"وَالَّذِينَ آمَنُوا وَاتَّبَعَتْهُمْ ذُرِّيَّتُهُمْ بِإِيمَانٍ أَلْحَقْنَا بِهِمْ ذُرِّيَّتَهُمْ وَمَا أَلَتْنَاهُمْ مِنْ عَمَلِهِمْ مِنْ شَيْءٍ كُلُّ امْرِئٍ بِمَا كَسَبَ رَهِينٌ (21)","hl":[[0,179,1]]}},{"id":"س-03213","fp":"d29676f7f74c","stateId":299,"easy":"إذا آمنت واتبعتك ذريتك بإيمان ← يرفعهم الله إلى درجتك ولو كانوا دونك","cause":"وَالَّذِينَ آمَنُوا وَ اتَّبَعَتْهُمْ ذُرِّيَّتَهُمْ بِإِيمَانٍ","result":"إنَّ اللهَ لَيرفعُ ذِرِّيَّةَ المؤمنِ إليه في درجتِه ، و إن كانوا دونه في العملِ ، لتَقَرَّ بهم عينُه","explicit":true,"otherNeedIds":[41],"ref":"السلسلة الصحيحة 2490","srcLabel":"الحاكم","text":[["إنَّ اللهَ لَيرفعُ ذِرِّيَّةَ المؤمنِ إليه في درجتِه ، و إن كانوا دونه في العملِ ، لتَقَرَّ بهم عينُه",2]," ، ثم قرأ : ( ",["وَالَّذِينَ آمَنُوا وَ اتَّبَعَتْهُمْ ذُرِّيَّتَهُمْ بِإِيمَانٍ",1]," ) الآية ، ثم قال : و ما نقَصْنا الآباءَ بما أعطينا البنينَ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه البزار كما في ((كشف الأستار)) للهيثمي (2260)، والحاكم (3744)، والبيهقي (21826)","bab":"إيمان › فضل الإيمان","dorar":"TUPICpdt"},{"id":"س-03803","fp":"37c7d0cd9d1d","stateId":299,"easy":"إذا وُلد لك ولد ← فهو ثمرة القلب، وقد يبخّلك ويجبّنك","cause":"وُلِدَ لي غلامٌ","result":"إنَّهم لَمَبْخلةٌ مَجْبَنةٌ مَحْزَنةٌ، وإنَّهم لَثَمرةُ القُلوبِ وقُرَّةُ العَيْنِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[10],"ref":"المستدرك على الصحيحين 7805","srcLabel":"السنة","text":[["وُلِدَ لي غلامٌ",1],"، فبُشِّرْتُ بهِ وأنا عندَ النَّبِيِّ صلَّى اللهُ عليه وسلَّمَ، فقُلْتُ: وَدِدْتُ لكم مَكانَه قِطْعةً مِن خُبْزٍ ولحْمٍ، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنْ قُلْتَ ذاكَ، ",["إنَّهم لَمَبْخلةٌ مَجْبَنةٌ مَحْزَنةٌ، وإنَّهم لَثَمرةُ القُلوبِ وقُرَّةُ العَيْنِ",2],"."],"grade":"صحيح","narrator":"الأشعث بن قيس","muhaddith":"صحيح على شرط الشيخين","bab":"بر وصلة › حب الولد","dorar":"CyMgTeof","merged":7,"otherRefs":["تخريج شرح السنة 13/36 (حسن)","صحيح الجامع 7160 (صحيح)","التنوير شرح الجامع الصغير 3/549 (صحيح)","المستدرك على الصحيحين 4835 (صحيح)","مصباح الزجاجة 4/99 (صحيح)","فيض القدير 2/ 403 (صحيح)"]},{"id":"س-03800","fp":"f0f47cb7a243","stateId":299,"easy":"إذا رُزقت الولد ← يبخّلك ويجبّنك، وهو من ريحان الله","cause":"أحَدَ ابنَيِ ابنَتِه","result":"إنَّكم لَتُبَخِّلونَ وتُجَهِّلونَ وتُجَبِّنونَ، وإنَّكم وإنَّكم لَمِن رَيحانِ اللهِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[10],"ref":"معجم الشيوخ 1/414","srcLabel":"أحمد","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ خَرَجَ وهو مُحتَضِنٌ ",["أحَدَ ابنَيِ ابنَتِه",1]," وهو يَقولُ: ",["إنَّكم لَتُبَخِّلونَ وتُجَهِّلونَ وتُجَبِّنونَ، وإنَّكم وإنَّكم لَمِن رَيحانِ اللهِ",2]," عزَّ وجلَّ."],"grade":"صحيح","narrator":"خولة بنت حكيم","muhaddith":"محفوظ من حديث سفيان","takhrij":"أخرجه ابن راهويه في ((مسنده)) (2150) باختلاف يسير، وأحمد (27314)، وفي ((فضائل الصحابة)) (1363)، والحسين بن حرب في ((البر والصلة)) (167) جميعهم بنحوه .","bab":"بر وصلة › حب الولد","dorar":"OXDAwUbs"},{"id":"س-03801","fp":"702313e47748","stateId":299,"easy":"إذا رُزقت الولد ← ففيه قرة عين وأجر إذا قُبض","cause":"هل لك مِن وَلدٍ","result":"فإنَّ فيهم قُرَّةَ عَينٍ، وأجرًا إذا قُبِضوا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[9],"ref":"تخريج المسند لشعيب 21840","srcLabel":"أحمد","text":["قَدِمتُ على رسولِ اللهِ صَلَّى اللهُ عليه وسلَّمَ في وَفدِ كِندةَ، فقال لي: ",["هل لك مِن وَلدٍ",1],"؟ قُلتُ: غُلامٌ وُلِدَ لي في مَخرَجي إليك مِن ابنةِ جَمْدٍ، ولوَدِدتُ أنَّ مَكانَه شِبَعُ القَومِ، قال: لا تَقولَنَّ ذلك؛ ",["فإنَّ فيهم قُرَّةَ عَينٍ، وأجرًا إذا قُبِضوا",2],"، ثُمَّ لئنْ قُلتَ ذاك، إنَّهم لَمَجبَنةٌ مَحزَنةٌ، إنَّهم لمَجبَنةٌ مَحزَنةٌ."],"grade":"صحيح","narrator":"الأشعث بن قيس","muhaddith":"صحيح","takhrij":"أخرجه أحمد (21840) واللفظ له، والطبراني (1/236) (650)، والحاكم (7596) باختلاف يسير","bab":"بر وصلة › حب الولد","dorar":"EUmEfBdL"},{"id":"س-03802","fp":"4928393caac1","stateId":299,"easy":"إذا رُزقت الولد ← فإنهم مجبنة محزنة","cause":"هل لك مِن وَلدٍ","result":"إنَّهم لَمَجبَنةٌ مَحزَنةٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[10],"ref":"تخريج المسند لشعيب 21840","srcLabel":"أحمد","text":["قَدِمتُ على رسولِ اللهِ صَلَّى اللهُ عليه وسلَّمَ في وَفدِ كِندةَ، فقال لي: ",["هل لك مِن وَلدٍ",1],"؟ قُلتُ: غُلامٌ وُلِدَ لي في مَخرَجي إليك مِن ابنةِ جَمْدٍ، ولوَدِدتُ أنَّ مَكانَه شِبَعُ القَومِ، قال: لا تَقولَنَّ ذلك؛ فإنَّ فيهم قُرَّةَ عَينٍ، وأجرًا إذا قُبِضوا، ثُمَّ لئنْ قُلتَ ذاك، ",["إنَّهم لَمَجبَنةٌ مَحزَنةٌ",2],"، إنَّهم لمَجبَنةٌ مَحزَنةٌ."],"grade":"صحيح","narrator":"الأشعث بن قيس","muhaddith":"صحيح","takhrij":"أخرجه أحمد (21840) واللفظ له، والطبراني (1/236) (650)، والحاكم (7596) باختلاف يسير","bab":"بر وصلة › حب الولد","dorar":"EUmEfBdL"},{"id":"س-05770","fp":"91ceb2770c3d","stateId":299,"easy":"إذا مت ولا ولد لك ← ينقطع اسمك","cause":"مَاتَ وليسَ لَهُ ولَدٌ","result":"انقَطَعَ اسْمُهُ","explicit":true,"ref":"مجمع الزوائد 4/261","srcLabel":"الطبراني","text":["لا يدعُ أحدُكُم طلبَ الولَدِ فَإِنَّ الرَّجُلَ إِذَا ",["مَاتَ وليسَ لَهُ ولَدٌ",1]," ",["انقَطَعَ اسْمُهُ",2]],"grade":"حسن","narrator":"حفصة أم المؤمنين","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني (23/210) (369)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"xml2deXN"},{"id":"س-07070","fp":"dbd86709e2d9","stateId":300,"easy":"إذا عدلت بين أولادك في العطية ← يعدلون معك في البر","cause":"اعدِلوا بيْنَ أولادِكم في النُّحْلِ","result":"كما تُحِبُّون أنْ يعدِلوا بينَكم في البِرِّ واللُّطْفِ","explicit":true,"star":true,"ref":"تخريج صحيح ابن حبان 5104","srcLabel":"متفق عليه","text":["طلَبتْ عَمرةُ بنتُ رواحةَ إلى بَشيرِ بنِ سعدٍ أنْ ينحَلَني نُحْلًا مِن مالِه وإنَّه أبى عليها ثمَّ بدا له بعدَ حَوْلٍ أو حولَيْنِ أنْ يُنحِلَنيه فقال لها: الَّذي سأَلْتِ لابني كُنْتُ منَعْتُكِ وقد بدا لي أنْ أنحَلَه إيَّاه قالت: لا واللهِ لا أرضى حتَّى تأخُذَ بيدِه فتنطلِقَ به إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فتُشهِدَه قال: فأخَذ بيدي فانطلَق بي إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقصَّ عليه القِصَّةَ فقال له النَّبيُّ صلَّى اللهُ عليه وسلَّم: ( هل لك معه ولدٌ غيرُه ؟ ) قال: نَعم قال: ( فهل آتَيْتَ كلَّ واحدٍ منهم مِثْلَ الَّذي آتَيْتَ هذا ؟ ) قال: لا قال: ( فإنِّي لا أشهَدُ على هذا، هذا جَوْرٌ، أشهِدْ على هذا غيري ",["اعدِلوا بيْنَ أولادِكم في النُّحْلِ",1]," ",["كما تُحِبُّون أنْ يعدِلوا بينَكم في البِرِّ واللُّطْفِ",2]],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"إسناده صحيح على شرطهما","takhrij":"أخرجه ابن حبان (5104)، والطبراني في ((المعجم الكبير)) (21/ 71) (69) واللفظ لهما، والبخاري (2650)، ومسلم (15/ 1623) بنحوه.","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"q3JUDlOq","merged":2,"otherRefs":["الجامع الصغير 112 (صحيح)"]},{"id":"س-05872","fp":"087c4b30a191","stateId":300,"easy":"إذا سويت بين أولادك ← يكونون إليك في البر سواء","cause":"أوَ كُلَّ ولدِكَ نحلتَهُ مثلَ هذا","result":"أن يَكونوا إليكَ في البرِّ كلُّهم سواءً","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-02123"],"ref":"نخب الافكار 14/347","srcLabel":"متفق عليه","text":["انطلقَ بي أبي إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ ونحلَني نُحلي ليُشْهِدَهُ على ذلِكَ، فقالَ: ",["أوَ كُلَّ ولدِكَ نحلتَهُ مثلَ هذا",1]," فقالَ: لا . قالَ: أيَسرُّكَ ",["أن يَكونوا إليكَ في البرِّ كلُّهم سواءً",2]," قالَ: بلَى قالَ: فأشهِد علَى هذا غَيري"],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن الجارود في ((المنتقى)) (992) باختلاف يسير، وأخرجه البخاري (2587)، ومسلم (1623) بنحوه","bab":"رقائق وزهد › الوصايا النافعة","dorar":"NseFhEj0"},{"id":"س-02123","fp":"7f934c1dab21","stateId":300,"easy":"إذا سويت بين أولادك في العطية ← يكونون إليك في البر سواء","cause":"أكُلَّ وَلدِكَ نَحَلتَ مِثلَ الذي نَحَلتَ النُّعمانَ","result":"أنْ يكونوا إليك في البِرِّ سَواءً","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-05872","ref":"تخريج المسند لشعيب 18366","text":["حَمَلَني أبي بَشيرُ بنُ سعدٍ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقال: يا رسولَ اللهِ، اشهِدْ أنِّي قد نَحَلتُ النُّعمانَ كذا وكذا، شيئًا سَمَّاه، قال: فقال: ",["أكُلَّ وَلدِكَ نَحَلتَ مِثلَ الذي نَحَلتَ النُّعمانَ",1],"؟ قال: لا، قال: فأشهِدْ غيري، قال: ثُمَّ قال: أليس يَسُرُّكَ ",["أنْ يكونوا إليك في البِرِّ سَواءً",2],"؟ قال: بلى، قال: فلا إذَنْ."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (1623)، والنسائي (3680)، وابن ماجه (2375)، وأحمد (18366) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"yPFLrbTd","merged":2,"otherRefs":["تخريج مشكل الآثار 5075 (صحيح)"]},{"id":"س-07803","fp":"da8be808c21c","stateId":300,"easy":"إذا علّمت ولدك القرآن ← يُكسى والداه يوم القيامة حُلّتين لا تقوم لهما الدنيا","cause":"بتعليمِ وَلَدِكُما القرآنَ","result":"ويُكْسى والِداهُ حُلَّتَيْنِ لا تقومُ لهما الدُّنيا وما فيها","explicit":true,"otherNeedIds":[55,53],"ref":"السلسلة الصحيحة 2829","srcLabel":"الطبراني","text":["يَجيءُ القرآنُ يومَ القيامةِ كالرَّجُلِ الشَّاحِبِ، يقولُ لصاحبِهِ: هل تَعرِفُني؟ أنا الذي كنتُ أُسهِرُ لَيْلَكَ، وأُظْمِئُ هَواجِرَكَ، وإنَّ كلَّ تاجرٍ مِن وراءِ تِجارتِهِ، وأنا لكَ اليومَ مِن وراءِ كلِّ تاجرٍ؛ فيُعطَى المُلْكَ بيمينِهِ، والخُلْدَ بشِمالِهِ، ويوضَعُ على رأسِهِ تاجُ الوقارِ، ",["ويُكْسى والِداهُ حُلَّتَيْنِ لا تقومُ لهما الدُّنيا وما فيها",2],"؛ فيقولانِ: يا ربِّ، أنَّى لنا هذا؟! فيُقالُ: ",["بتعليمِ وَلَدِكُما القرآنَ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن أو صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (5764) مطولاً","bab":"قرآن › فضل قراءة القرآن","dorar":"aHE9inD4","merged":2,"otherRefs":["هداية الرواة 2/374 (حسن)"]},{"id":"س-00323","fp":"2a3fb3123a81","stateId":300,"easy":"إذا أدّبت ولدك أدباً حسناً ← فهو أفضل ما تعطيه","cause":"أدبٍ حسنٍ","result":"ما نحَل والدٌ والِدًا من نُحلٍ أفضلَ","explicit":true,"ref":"الترغيب والترهيب 3/115","srcLabel":"الترمذي","text":[["ما نحَل والدٌ والِدًا من نُحلٍ أفضلَ",2]," من ",["أدبٍ حسنٍ",1]],"grade":"صحيح","narrator":"عمرو بن سعيد بن العاص","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (1952)، وأحمد (15403) باختلاف يسير.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"L0sDtZQm"},{"id":"س-07805","fp":"371af6088881","stateId":300,"easy":"إذا قرأت القرآن وتعلمته وعملت به ← يُلبس والداك تاجاً من نور يوم القيامة","cause":"من قرأ القرآنَ وتعلَّم وعمِل به","result":"أُلْبِس والداه يومَ القيامةِ تاجًا من نورٍ ضوءُه مثلُ الشَّمسِ ويُكسَى والداه حُلَّتَيْن لا يقومُ لهما الدُّنيا","explicit":true,"otherNeedIds":[53],"ref":"الترغيب والترهيب 2/303","srcLabel":"الحاكم","text":[["من قرأ القرآنَ وتعلَّم وعمِل به",1]," ",["أُلْبِس والداه يومَ القيامةِ تاجًا من نورٍ ضوءُه مثلُ الشَّمسِ ويُكسَى والداه حُلَّتَيْن لا يقومُ لهما الدُّنيا",2]," فيقولان بمَ كُسينا هذا فيُقالُ بأخذِ ولدِكما القرآنَ"],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الحاكم (2086)","bab":"قرآن › فضل قراءة القرآن","dorar":"SGvzobAi"},{"id":"س-06328","fp":"c12535fb5fd6","stateId":301,"easy":"إذا تصدقتِ على زوجك وولدك ← فهم أحق من تصدقت عليهم","cause":"زوجُك وولَدُك","result":"أحقُّ مَن تصدَّقْتِ به عليهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[41],"ref":"تخريج صحيح ابن حبان 5744","srcLabel":"متفق عليه","text":["خرَج رسولُ اللهِ صلَّى اللهُ عليه وسلَّم في أضحى أو فِطْرٍ إلى المُصلَّى فصلَّى ثمَّ انصرَف فقام فوعَظ النَّاسَ وأمَرهم بالصَّدقةِ قال: ( أيُّها النَّاسُ تصدَّقوا ) ثمَّ انصرَف فمرَّ على النِّساءِ فقال: ( يا معشرَ النِّساءِ تصدَّقْنَ فإنِّي أراكنَّ أكثَرَ أهلِ النَّارِ ) فقُلْنَ: ولمَ ذلك يا رسولَ اللهِ ؟ قال: ( تُكثِرْنَ اللَّعنَ وتكفُرْنَ العشيرَ ما رأَيْتُ مِن ناقصاتِ عقلٍ ودِينٍ أذهَبَ لِلُبِّ الرَّجُلِ الحازمِ مِن إحداكنَّ يا معشرَ النِّساءِ ) فقُلْنُ له: ما نقصانُ دِينِنا وعقلِنا يا رسولَ اللهِ ؟ قال: ( أليس شَهادةُ المرأةِ مِثْلَ نصفِ شَهادةِ الرَّجُلِ ) قُلْنَ: بلى قال: ( فذاك نُقصانُ عقلِها أوَليسَتْ إذا حاضتِ المرأةُ لم تُصَلِّ ولم تَصُمْ ) ؟ قُلْنَ: بلى قال ( فذاك نُقصانُ دِينِها ) ثمَّ انصرَف رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فلمَّا صار إلى منزلِه جاءتْ زينبُ امرأةُ عبدِ اللهِ بنِ مسعودٍ تستأذِنُ عليه فقيل: يا رسولَ اللهِ هذه زينبُ تستأذِنُ عليك فقال: ( أيُّ الزَّيانبِ ) ؟ قيل: امرأةُ عبدِ اللهِ بنِ مسعودٍ قال: ( نَعم ائذَنوا لها ) فأذِن لها فقالت: يا نبيَّ اللهِ إنَّك أمَرْتَنا اليومَ بالصَّدقةِ وكان عندي حُلِيٌّ فأرَدْتُ أنْ أتصدَّقَ فزعَم ابنُ مسعودٍ أنَّه وولَدَه أحقُّ مَن تصدَّقْتُ به عليهم فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ( صدَق ",["زوجُك وولَدُك",1]," ",["أحقُّ مَن تصدَّقْتِ به عليهم",2]," )"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه البخاري (1462) باختلاف يسير، ومسلم (80) دون ذكر لفظه","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"0z0NtOOk","merged":2,"otherRefs":["صحيح الجامع 3755 (صحيح)"]},{"id":"س-04761","fp":"375752d38e53","stateId":301,"easy":"إذا أُعطي أهل البيت الرفق ← نفعهم، وإذا مُنعوه ضرّهم","cause":"ما أُعْطِيَ أهلُ بَيتِ الرِّفْقَ","result":"إلَّا نَفَعَهُمْ، و لا مُنِعُوهُ إلَّا ضَرَّهُمْ","explicit":true,"otherNeedIds":[48],"ref":"السلسلة الصحيحة 942","srcLabel":"ابن قانع","text":[["ما أُعْطِيَ أهلُ بَيتِ الرِّفْقَ",1]," ",["إلَّا نَفَعَهُمْ، و لا مُنِعُوهُ إلَّا ضَرَّهُمْ",2],"."],"grade":"صحيح","narrator":"عبيدالله بن معمر","muhaddith":"إسناده صحيح رجاله ثقات","takhrij":"أخرجه ابن قانع في ((معجم الصحابة)) (2/ 178)، وأبو نعيم في ((معرفة الصحابة)) (4722)، وابن الأثير في ((أسد الغابة)) (3/ 526)، وابن عساكر (38/ 123) واللفظ لهم جميعا.","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"LEXLUFDj"},{"id":"س-05521","fp":"835696572851","stateId":301,"easy":"إذا خرجت تسعى على أولادك الصغار ← فأنت في سبيل الله","cause":"خَرَجَ يَسعى على ولدِه صِغارًا","result":"فهو في سَبيل اللهِ","explicit":true,"otherNeedIds":[42],"ref":"حسن الأسوة بما ثبت في النسوة 564","srcLabel":"الطبراني","text":["مَرَّ على النَّبيِّ صلَّى اللهُ عليه وسلَّم رَجُلٌ فرَأى أصحابُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم مِن جَلَدِه ونَشاطِه، فقالوا: يا رَسولَ اللهِ، لو كان هذا في سَبيلِ اللهِ! فقال رسولُ اللهِ: إن كان ",["خَرَجَ يَسعى على ولدِه صِغارًا",1]," ",["فهو في سَبيل اللهِ",2],"، وإن كان خَرَجَ يَسعى على أبَوينِ شَيخَينِ كَبيرَينِ فهو في سَبيلِ اللهِ، وإن كان خَرَجَ يَسعى على نَفسِه يُعِفُّها فهو في سَبيلِ اللهِ، وإن كان خَرَجَ يَسعى رياءً ومُفاخَرةً فهو في سَبيلِ الشَّيطانِ"],"grade":"صحيح","narrator":"كعب بن عجرة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((الأوسط)) (6835)، وبحشل في ((تاريخ واسط)) (صـ162) واللفظ لهما.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"yhlIFCs7"},{"id":"س-08456","fp":"e3e6077ddbd6","stateId":301,"easy":"إذا رفقت في بيتك ← فإن الله إذا أراد بأهل بيت خيراً دلهم على الرفق","cause":"ارْفُقي","result":"فإنَّ اللهَ إذا أرادَ بأهلِ بيتٍ خَيرًا، دَلَّهم على بابِ الرِّفقِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 24734","srcLabel":"أحمد","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال لها: يا عائشةُ، ",["ارْفُقي؛ ",1],["فإنَّ اللهَ إذا أرادَ بأهلِ بيتٍ خَيرًا، دَلَّهم على بابِ الرِّفقِ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (24734) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (4/295)، والبيهقي في ((شعب الإيمان)) (6560) بنحوه","bab":"نفقة › نفقة الرقيق والرفق بهم والإحسان إليهم","dorar":"otWQKxhk"},{"id":"س-07238","fp":"6505fee4873c","stateId":302,"easy":"إذا سفهت الحق واحتقرت الناس ← فهو الكبر","cause":"سفِه الحقَّ وغمِص النَّاسَ","result":"إنَّما الكِبْرُ","explicit":true,"star":true,"ref":"تخريج صحيح ابن حبان 4229","srcLabel":"مسلم","text":["جاء رجُلٌ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم فقال: يا رسولَ اللهِ إنِّي حُبِّب إليَّ الجمالُ فما أُحِبُّ أنْ يفوقَني أحَدٌ فيه بشِراكٍ أفمِن الكِبْرِ هو ؟ قال: ( لا، ",["إنَّما الكِبْرُ",2]," مَن ",["سفِه الحقَّ وغمِص النَّاسَ",1]," )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن حبان (4437) بلفظه، وأبو داوود (4092)، والحاكم في ((مستدركه)) (7366) كلاهما باختلاف يسير.","bab":"علم › سؤال العالم عما لا يعلم","dorar":"MnPoMxiP"},{"id":"س-04604","fp":"69f005f5620f","stateId":302,"easy":"إذا مررت بقبر من تعرفه فسلّمت عليه ← يرد الله عليه روحه فيرد عليك السلام","cause":"وما من رجُلٍ يمرُّ بقبرِ الرَّجلِ كانَ يعرفُهُ في الدُّنيا فيسلِّمُ عليْهِ","result":"إلَّا ردَّ اللَّهُ عليْهِ روحَهُ حتَّى يردَّ عليْهِ السَّلامَ","explicit":true,"star":true,"ref":"مجموع الفتاوى 24/173","srcLabel":"السنة","text":[["وما من رجُلٍ يمرُّ بقبرِ الرَّجلِ كانَ يعرفُهُ في الدُّنيا فيسلِّمُ عليْهِ",1]," ",["إلَّا ردَّ اللَّهُ عليْهِ روحَهُ حتَّى يردَّ عليْهِ السَّلامَ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"دفن ومقابر › أحوال الميت في القبر","dorar":"az7yPhKy"},{"id":"س-05141","fp":"91fe5914d1e7","stateId":302,"easy":"إذا غاضبتِ زوجك فأتيه حتى ترضيه ← فإن قبل فبها، وإلا فقد أعذرتِ عند الله","cause":"فلتَأْتِه حتَّى تُرضِيَه","result":"فإنْ كان هو قَبِلَ منها فبِها ونِعْمَتْ، وقَبِلَ اللهُ عُذرَها، وأَفلَحَ حُجَّتَها، ولا إثْمَ عليها، وإنْ هو أَبَى يَرْضى عنها، فقد أَبلَغَتْ عندَ اللهِ عُذرَها","explicit":true,"otherNeedIds":[11],"ref":"المستدرك على الصحيحين 2808","srcLabel":"الطبراني","text":["لا يَحِلُّ لامرأةٍ تُؤمِنُ باللهِ واليومِ الآخِرِ، أنْ تَأذَنَ في بيتِ زَوجِها وهو كارِهٌ، ولا تَخرُجَ وهو كارِهٌ، ولا تُطيعَ فيه أَحدًا، ولا تَخشَنَ بصدرِه، ولا تَعتَزِلَ فِراشَه، ولا تَضرِبَه، فإنْ كان هو أَظلَمَ، ",["فلتَأْتِه حتَّى تُرضِيَه",1],"، ",["فإنْ كان هو قَبِلَ منها فبِها ونِعْمَتْ، وقَبِلَ اللهُ عُذرَها، وأَفلَحَ حُجَّتَها، ولا إثْمَ عليها، وإنْ هو أَبَى يَرْضى عنها، فقد أَبلَغَتْ عندَ اللهِ عُذرَها",2],"."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني (20/ 107) (210)، والبيهقي (14831)، وإسماعيل الأصفهاني في ((الترغيب والترهيب)) (2110) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"C5Raj7QE"},{"id":"س-00488","fp":"e00eb723415f","stateId":302,"easy":"إذا خفضت (الخاتنة) فلا تنهك ← فهو أحظى للمرأة وأحب إلى الزوج","cause":"لا تُنهِكي","result":"فإنَّ ذلِك أحظى للمرأةِ وأحبُّ إلى البَعلِ","explicit":true,"ref":"هداية الرواة 4/245","srcLabel":"أبو داود","text":["أنَّ امرأةً كانت تختِنُ بالمدينةِ فقالَ لَها النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ ",["لا تُنهِكي ",1],["فإنَّ ذلِك أحظى للمرأةِ وأحبُّ إلى البَعلِ",2]],"grade":"حسن","narrator":"أم عطية نسيبة بنت كعب","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه أبو داود (5271)، والبيهقي (18015) واللفظ لهما، وابن عدي في ((الكامل في الضعفاء)) (6/217) باختلاف يسير","bab":"آداب عامة › المباحات من الأفعال والأقوال","dorar":"yXLPyP3s"},{"id":"س-07199","fp":"e28b3ba7bd95","stateId":302,"easy":"إذا أعطيت مرضعتك عبداً أو أمة ← تذهب عنك مذمة الرضاع","cause":"غرةٌ عبدٌ أو أمةٌ","result":"ما يذهب عني مذمةِ الرضاعِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سنن الترمذي 1153","srcLabel":"أبو داود","text":["أنه سأل النبيَّ صلَّى اللهُ عليهِ وسلَّمَ فقال يا رسولَ اللهِ ",["ما يذهب عني مذمةِ الرضاعِ",2]," فقال ",["غرةٌ عبدٌ أو أمةٌ",1]],"grade":"صحيح","narrator":"حجاج الأسلمي","muhaddith":"حسن صحيح","takhrij":"أخرجه أبو داود (2064)، والنسائي (3329) بلفظه.","bab":"علم › حسن السؤال ونصح العالم","dorar":"prnRoqRx"},{"id":"س-01317","fp":"63d192d41764","stateId":302,"easy":"إذا خُتنت الأنثى فلا تُنهك ← فهو أسرى للوجه وأحظى عند الزوج","cause":"إذا خفضتِ فأشِمِّي ولا تنهكي","result":"فإنَّهُ أسرى للوجهِ وأحظى عند الزوجِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"مجمع الزوائد 5/175","srcLabel":"الطبراني","text":["أنَّ النبيَّ صلَّى اللهُ عليه وسلَّمَ قال لأمِّ عطيةَ ختانةٌ كانت بالمدينةِ ",["إذا خفضتِ فأشِمِّي ولا تنهكي",1]," ",["فإنَّهُ أسرى للوجهِ وأحظى عند الزوجِ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((المعجم الصغير)) (122) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (3/228)، والبيهقي (18017) باختلاف يسير","bab":"نكاح › حق الزوج على المرأة","dorar":"K9dos3a5"}]}