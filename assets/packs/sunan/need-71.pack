{"schema":1,"kind":"sunan-chunk","version":"sunan-d4559cab67b4","needId":71,"stateIds":[767,768,769,770,771,772,773,774,775,776,777,778,779],"items":[{"id":"ق-0326","fp":"ea81df42a241","stateId":767,"easy":"الشرك بالله ← تحريم الجنة ومأواه النار ولا أنصار","cause":"الشرك بالله","result":"تحريم الجنة ومأواه النار ولا أنصار","explicit":true,"star":true,"otherNeedIds":[69],"ref":"سورة المائدة: 72","srcLabel":"القرآن الكريم","quran":{"s":5,"from":72,"to":72,"text":"لَقَدْ كَفَرَ الَّذِينَ قَالُوا إِنَّ اللَّهَ هُوَ الْمَسِيحُ ابْنُ مَرْيَمَ وَقَالَ الْمَسِيحُ يَا بَنِي إِسْرَائِيلَ اعْبُدُوا اللَّهَ رَبِّي وَرَبَّكُمْ إِنَّهُ مَنْ يُشْرِكْ بِاللَّهِ فَقَدْ حَرَّمَ اللَّهُ عَلَيْهِ الْجَنَّةَ وَمَأْوَاهُ النَّارُ وَمَا لِلظَّالِمِينَ مِنْ أَنْصَارٍ (72)","hl":[[156,287,1]]}},{"id":"ق-0401","fp":"03831a6cf279","stateId":767,"easy":"التكذيب بالآيات والاستكبار عنها ← لا تفتح لهم أبواب السماء ولا يدخلون الجنة ومهاد من جهنم","cause":"التكذيب بالآيات والاستكبار عنها","result":"لا تفتح لهم أبواب السماء ولا يدخلون الجنة ومهاد من جهنم","explicit":true,"star":true,"otherNeedIds":[69],"ref":"سورة الأعراف: 40–41","srcLabel":"القرآن الكريم","quran":{"s":7,"from":40,"to":41,"text":"إِنَّ الَّذِينَ كَذَّبُوا بِآيَاتِنَا وَاسْتَكْبَرُوا عَنْهَا لَا تُفَتَّحُ لَهُمْ أَبْوَابُ السَّمَاءِ وَلَا يَدْخُلُونَ الْجَنَّةَ حَتَّى يَلِجَ الْجَمَلُ فِي سَمِّ الْخِيَاطِ وَكَذَلِكَ نَجْزِي الْمُجْرِمِينَ (40) لَهُمْ مِنْ جَهَنَّمَ مِهَادٌ وَمِنْ فَوْقِهِمْ غَوَاشٍ وَكَذَلِكَ نَجْزِي الظَّالِمِينَ (41)","hl":[[0,305,1]]}},{"id":"ق-0404","fp":"06756edaa126","stateId":767,"easy":"اتخاذ الدين لهواً ولعباً ونسيان لقاء الله ← تحريم ماء الجنة ورزقها ونسيان الله لهم","cause":"اتخاذ الدين لهواً ولعباً ونسيان لقاء الله","result":"تحريم ماء الجنة ورزقها ونسيان الله لهم","explicit":true,"otherNeedIds":[69],"ref":"سورة الأعراف: 50–51","srcLabel":"القرآن الكريم","quran":{"s":7,"from":50,"to":51,"text":"وَنَادَى أَصْحَابُ النَّارِ أَصْحَابَ الْجَنَّةِ أَنْ أَفِيضُوا عَلَيْنَا مِنَ الْمَاءِ أَوْ مِمَّا رَزَقَكُمُ اللَّهُ قَالُوا إِنَّ اللَّهَ حَرَّمَهُمَا عَلَى الْكَافِرِينَ (50) الَّذِينَ اتَّخَذُوا دِينَهُمْ لَهْوًا وَلَعِبًا وَغَرَّتْهُمُ الْحَيَاةُ الدُّنْيَا فَالْيَوْمَ نَنْسَاهُمْ كَمَا نَسُوا لِقَاءَ يَوْمِهِمْ هَذَا وَمَا كَانُوا بِآيَاتِنَا يَجْحَدُونَ (51)","hl":[[127,363,1]]}},{"id":"ق-1420","fp":"ba62d3611c48","stateId":767,"easy":"الرَّين والتكذيب ← الحجب عن الله وصَلي الجحيم","cause":"الرَّين والتكذيب","result":"الحجب عن الله وصَلي الجحيم","explicit":true,"otherNeedIds":[69],"ref":"سورة المطففين: 15–16","srcLabel":"القرآن الكريم","quran":{"s":83,"from":15,"to":16,"text":"كَلَّا إِنَّهُمْ عَنْ رَبِّهِمْ يَوْمَئِذٍ لَمَحْجُوبُونَ (15) ثُمَّ إِنَّهُمْ لَصَالُو الْجَحِيمِ (16)","hl":[[0,98,1]]}},{"id":"س-00607","fp":"a8116cb217f7","stateId":767,"easy":"إذا لم تجب داعي الله ← لم تدخل الجنة ولم تأكل من مأدبتها","cause":"ومَن لَم يُجِبِ الدَّاعيَ","result":"لَم يَدخُلِ الدَّارَ ولَم يَأكُلْ مِنَ المَأدُبةِ","explicit":true,"otherNeedIds":[28],"ref":"صحيح البخاري 7281","srcLabel":"الترمذي","text":["جاءَت مَلائِكةٌ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم وهو نائِمٌ، فقال بَعضُهم: إنَّه نائِمٌ، وقال بَعضُهم: إنَّ العَينَ نائِمةٌ، والقَلبَ يَقظانُ، فقالوا: إنَّ لصاحِبِكُم هذا مَثَلًا، فاضرِبوا له مَثَلًا، فقال بَعضُهم: إنَّه نائِمٌ، وقال بَعضُهم: إنَّ العَينَ نائِمةٌ، والقَلبَ يَقظانُ، فقالوا: مَثَلُه كَمَثَلِ رَجُلٍ بَنى دارًا، وجَعَلَ فيها مَأدُبةً وبَعَثَ داعيًا، فمَن أجابَ الدَّاعيَ دَخَلَ الدَّارَ وأكَلَ مِنَ المَأدُبةِ، ",["ومَن لَم يُجِبِ الدَّاعيَ",1]," ",["لَم يَدخُلِ الدَّارَ ولَم يَأكُلْ مِنَ المَأدُبةِ",2],"، فقالوا: أوِّلوها له يَفقَهْها، فقال بَعضُهم: إنَّه نائِمٌ، وقال بَعضُهم: إنَّ العَينَ نائِمةٌ، والقَلبَ يَقظانُ، فقالوا: فالدَّارُ الجَنَّةُ، والدَّاعي مُحَمَّدٌ صلَّى اللهُ عليه وسلَّم، فمَن أطاعَ مُحَمَّدًا صلَّى اللهُ عليه وسلَّم فقد أطاعَ اللهَ، ومَن عَصى مُحَمَّدًا صلَّى اللهُ عليه وسلَّم فقد عَصى اللهَ، ومُحَمَّدٌ صلَّى اللهُ عليه وسلَّم فَرقٌ بينَ النَّاسِ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[أورده في صحيحه] وقال : تابعه قتيبة عن ليث عن خالد عن سعيد بن أبي هلال عن جابر خرج علينا النبي صلى الله عيه وسلم ...","takhrij":"أخرجه أبو عوانة (10114)، والبيهقي في ((الآداب)) (858) كلاهما بلفظه، والترمذي (2860) بمعناه.","bab":"آداب عامة › ضرب الأمثال","dorar":"mmVpxzQK","merged":2,"otherRefs":["هداية الرواة 1/128 (حسن)"]},{"id":"س-02969","fp":"415df7adbd53","stateId":767,"easy":"إذا سمعت بالنبي ﷺ فلم تؤمن به ← لم تدخل الجنة","cause":"مَن سَمِعَ بي مِن أُمَّتي أو يهوديٌّ أو نصرانيٌّ، فلمْ يُؤمِنْ بي","result":"لم يَدخُلِ الجنَّةَ","explicit":true,"ref":"تخريج المسند لشعيب 19536","srcLabel":"النسائي","text":[["مَن سَمِعَ بي مِن أُمَّتي أو يهوديٌّ أو نصرانيٌّ، فلمْ يُؤمِنْ بي",1],"؛ ",["لم يَدخُلِ الجنَّةَ",2],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (11241)، وأحمد (19536) واللفظ له","bab":"إيمان › الوعيد","dorar":"FZct3xHN"},{"id":"س-07987","fp":"7691233444d1","stateId":767,"easy":"إذا أشركت بالله ← فقد حرّم الله عليك الجنة","cause":"مَنْ يُشْرِكْ بِاللَّهِ","result":"فَقَدْ حَرَّمَ اللَّهُ عَلَيْهِ الْجَنَّةَ","explicit":true,"ref":"عمدة التفسير 1/520","srcLabel":"أحمد","text":["الدَّواوينُ عندَ اللَّهِ ثلاثةٌ ؛ ديوانٌ لا يعبأُ اللَّهُ بِهِ شيئًا ، وديوانٌ لا يترُكُ اللَّهُ منهُ شيئًا ، وديوانٌ لا يغفرُهُ اللَّهُ . فأمَّا الدِّيوانُ الَّذي لا يغفرُهُ اللَّهُ ، فالشِّركُ باللَّهِ ، قالَ اللَّهُ عزَّ وجلَّ :  ",["مَنْ يُشْرِكْ بِاللَّهِ ",1],["فَقَدْ حَرَّمَ اللَّهُ عَلَيْهِ الْجَنَّةَ",2],"  المائدةِ :72 وأمَّا الدِّيوانُ الَّذي لا يعبأُ اللَّهُ بِهِ شيئًا ، فظلمُ العبدِ نفسَهُ فيما بينَهُ وبينَ ربِّهِ ، من صومِ يومٍ تركَهُ ، أو صلاةٍ تركَها ؛ فإنَّ اللَّهَ يغفرُ ذلِكَ ويتجاوزُ إن شاءَ . وأمَّا الدِّيوانُ الَّذي لا يترُكُ اللَّهُ منهُ شيئًا ، فظلمُ العبادِ بعضِهِم بعضًا ؛ القصاصُ لا محالةَ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (26073 )، والحاكم في ((المستدرك)) (8717 )، والبيهقي في ((شعب الإيمان)) (7069 )،","bab":"مظالم › تحريم الظلم","dorar":"ybNV1Rpi"},{"id":"س-07891","fp":"b443e33420fb","stateId":767,"easy":"إذا مت كافراً ← فالجنة محرمة على الكافرين","cause":"الكافِرينَ","result":"إنِّي حَرَّمْتُ الجَنَّةَ على الكافِرينَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الأحكام الوسطى 4/ 352","srcLabel":"البخاري","text":["[قالَ: \"يَلْقى إبْراهيمُ أباه آزَرَ يَوْمَ القِيامةِ وعلى وَجْهِ آزَرَ قَتَرةٌ وغَبَرةٌ، فيقولُ له إبْراهيمُ: أَلَمْ أَقُلْ لك: لا تَعْصِني، فيقولُ أبوه: فاليَوْمَ لا أَعْصيك، فيَقولُ إبْراهيمُ: يا رَبِّ، إنَّك وَعَدْتَني ألَّا تُخزِيَني يَوْمَ يُبعَثونَ، فأيُّ خِزْيٍ أَخْزى مِن أبي الأَبعَدِ؟ فيَقولُ اللهُ عَزَّ وجَلَّ: ",["إنِّي حَرَّمْتُ الجَنَّةَ على الكافِرينَ",2],"، ثُمَّ يُقالُ: يا إبْراهيمُ، ما تحتَ رِجْلَيك؟ فإذا هو بذِيخٍ مُلْتَطِخٍ، فيُؤخَذُ بقَوائِمِه، فيُلْقى في النَّارِ\"].\n زادَ أبو بَكْرِ البَزَّارُ: \"فيَقولُ أبوك، فيَقولُ: لا أَعرِفُك\"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه البخاري (3350)، والحاكم (2936)، والبيهقي في ((البعث والنشور)) (656) بلفظه.","bab":"قيامة › الشفاعة","dorar":"uyngFaCX"},{"id":"س-01567","fp":"1dc693e9c225","stateId":767,"easy":"إذا صدّقت الكهنة ورضيت بقولهم ← لم ترح رائحة الجنة","cause":"فمن صدَّقهم بذلك ورَضِيَ به","result":"لم يَرَحْ رائحةَ الجنَّةِ","explicit":true,"ref":"سبل الهدى والرشاد 10/168","srcLabel":"ابن أبي الدنيا","text":["«لا تقومُ السَّاعةُ حتى يُجعَلَ كتابُ اللهِ عارًا، ويكونَ الإسلامُ غريبًا، وحتى تبدوَ الشَّحناءُ بين النَّاسِ، وحتى يُقبَضَ العِلمُ ويَهرَمَ الزَّمانُ، ويَنقُصَ عُمرُ البَشَرِ، وتَنقُصَ السِّنون والثَّمَراتُ، ويؤمَّنَ التُّهَماءُ ويُتَّهَمَ الأُمَناءُ، ويُصَدَّقَ الكاذِبُ، ويكَذَّبَ الصَّادِقُ، ويَكثُرَ الهَرجُ وهو القتلُ، وحتى تُبنى الغُرَفُ فتطاولَ، وحتى تحزَنَ ذواتُ الأولادِ، وتفرَحَ العواقِرُ، ويظهَرَ البغيُ والحسَدُ والشُّحُّ، ويهلِكَ النَّاسُ، ويُتَّبَعَ الهوى، ويُقضى بالظَّنِّ، ويَكثُرَ المطَرُ، ويقِلَّ الثَّمَرُ، ويغيضَ العِلمُ غَيضًا، ويفيضَ الجَهلُ فَيضًا، ويكونَ الوَلَدُ غيظًا والشِّتاءُ قَيظًا، وحتى يُجهَرَ بالفَحشاءِ، وتُزوى الأرضُ زَيًّا، ويقومَ الخُطَباءُ بالكَذِبِ، فيَجعَلون حَقِّي لشِرارِ أمَّتي، ",["فمن صدَّقهم بذلك ورَضِيَ به",1]," ",["لم يَرَحْ رائحةَ الجنَّةِ",2],"»"],"grade":"حسن","narrator":"أبو موسى الأشعري","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه ابن أبي الدنيا في ((العقوبات)) (340)، والخطيب البغدادي في ((تلخيص المتشابه)) (2/ 674)، وابن عساكر (21/ 274) واللفظ لهم.","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"Ki0Rumz5"},{"id":"س-01826","fp":"68dd210af431","stateId":768,"easy":"إذا كان في قلبك مثقال حبة خردل من كبر ← لا تدخل الجنة","cause":"مَن كانَ في قَلْبِه مِثْقالُ حَبَّةِ خَرْدَلٍ مِن كِبْرٍ","result":"لا يَدخُلُ الجنَّةَ","explicit":true,"star":true,"similar":["س-05741","س-07146","س-03172"],"ref":"الأحاديث المختارة 9 / 453","srcLabel":"متفق عليه","text":["«زَعَمَ عَبْدُ اللهِ بنُ حَنْظَلةَ أنَّ عَبْدَ اللهِ بنَ سَلامٍ مَرَّ في السُّوقِ وعليه حُزْمةٌ مِن حَطَبٍ، فقيلَ له: أليس قد أَغْناك اللهُ عن هذا؟ قالَ: بَلى ولكنْ أَردْتُ أن أَقمَعَ الكِبْرَ، سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["لا يَدخُلُ الجنَّةَ",2],[" مَن كانَ في قَلْبِه مِثْقالُ حَبَّةِ خَرْدَلٍ مِن كِبْرٍ»",1],"."],"grade":"صحيح","narrator":"عبدالله بن سلام","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إجارة › كسب الرجل وعمله بيده","dorar":"tjuSkl4k","merged":5,"otherRefs":["تخريج المسند لشعيب 6526 (صحيح)","صحيح مسلم 91 (صحيح)","تنبيه الغافلين 225 (صحيح)","صحيح الترمذي 1999 (صحيح)"]},{"id":"س-05741","fp":"7309eb42843d","stateId":768,"easy":"إذا كان في قلبك خردلة كبر ← لا تدخل الجنة","cause":"مَن في قَلْبِه خَرْدَلةُ كِبْرٍ","result":"لا يَدخُلُ الجنَّةَ","explicit":true,"repOf":"س-01826","ref":"الأحاديث المختارة 9 / 454","text":["«زَعَمَ عَبْدُ اللهِ بنُ حَنْظَلةَ الرَّاهِبُ أنَّ عَبْدَ اللهِ بنَ سَلامٍ مَرَّ في السُّوقِ وعليه حُزْمةُ حَطَبٍ فقيلَ له: ما يَحمِلُك على هذا وقد أَغْناك اللهُ عن هذا؟ قالَ: أَردْتُ أن أَدمَغَ الكِبْرَ، سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["لا يَدخُلُ الجنَّةَ",2],[" مَن في قَلْبِه خَرْدَلةُ كِبْرٍ»",1],"."],"grade":"صحيح","narrator":"عبدالله بن سلام","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الكبر والتواضع","dorar":"jGO2Noe7"},{"id":"س-05728","fp":"6195481969a5","stateId":768,"easy":"إذا كنت مسكيناً مستكبراً أو شيخاً زانياً أو منّاناً على الله بعملك ← لا تدخل الجنة","cause":"مسكينٌ مستكبرٌ ولا شيخٌ زانٍ ولا منَّانٌ على اللهِ بعملِه","result":"لا يدخلُ الجنَّةَ","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 2/135","srcLabel":"البخاري","text":[["لا يدخلُ الجنَّةَ",2],[" مسكينٌ مستكبرٌ ولا شيخٌ زانٍ ولا منَّانٌ على اللهِ بعملِه",1]],"grade":"حسن","narrator":"نافع مولى رسول الله صلى الله عليه وسلم","muhaddith":"رواته إلى الصبح بن خالد ثقات","takhrij":"أخرجه أبو نعيم في ((معرفة الصحابة)) (6404) واللفظ له، والبخاري في ((التاريخ الكبير)) (8/82)، وابن عساكر في ((تاريخ دمشق)) (4/285)","bab":"رقائق وزهد › الكبر والتواضع","dorar":"8fbln2Ab"},{"id":"س-05731","fp":"434d77560a2e","stateId":768,"easy":"إذا كنت جوّاظاً (فظاً غليظاً) أو جعظرياً (متكبراً) ← لا تدخل الجنة","cause":"الجوَّاظُ ، ولا الجعظَرِيُّ","result":"لا يدخلُ الجنَّةَ","explicit":true,"ref":"صحيح الترغيب 2902","srcLabel":"أبو داود","text":[["لا يدخلُ الجنَّةَ",2],[" الجوَّاظُ ، ولا الجعظَرِيُّ ",1],". : قال : والجوَّاظُ : الغليظُ الفظُّ ."],"grade":"صحيح","narrator":"حارثة بن وهب الخزاعي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4801)، وابن أبي شيبة (25322)، وأبو يعلى (1476) واللفظ لهم.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"HFWFLJnU"},{"id":"س-07146","fp":"c19ca46d2240","stateId":768,"easy":"إذا مت وفي قلبك مثقال حبة خردل من كبر ← لا تحل لك الجنة أن تريح ريحها","cause":"يَموتُ حين يَموتُ وفي قلْبِه مِثقالُ حَبَّةٍ مِن خَرْدَلٍ مِن كِبْرٍ","result":"تَحِلُّ له الجَنَّةُ أنْ يَرِيحَ رِيحَها ولا يَراها","explicit":true,"repOf":"س-01826","ref":"تخريج المسند لشعيب 17369","text":["ما مِن رجُلٍ ",["يَموتُ حين يَموتُ وفي قلْبِه مِثقالُ حَبَّةٍ مِن خَرْدَلٍ مِن كِبْرٍ",1],"، ",["تَحِلُّ له الجَنَّةُ أنْ يَرِيحَ رِيحَها ولا يَراها",2],". فقال رجُلٌ مِن قُرَيشٍ يُقالُ له أبو رَيْحانةَ: يا رسولَ اللهِ، واللهِ إنِّي لَأُحِبُّ الجَمالَ وأَشتَهِيه، حتى إنِّي لَأُحِبُّه في عِلاقةِ سَوْطي، وفي شِراكِ نَعْلي. قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ليس ذاك الكِبْرُ، إنَّ اللهَ عزَّ وجلَّ جميلٌ يُحِبُّ الجَمالَ، ولكنَّ الكِبْرَ مَن سَفِهَ الحقَّ، وغَمَصَ الناسَ بعَيْنَيْهِ."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (17369)","bab":"علم › حسن السؤال ونصح العالم","dorar":"Y7QffLgB"},{"id":"س-03172","fp":"fe0aeb06b335","stateId":768,"easy":"إذا كان في قلبك شيء من الكبر ← لا تدخل الجنة","cause":"شَيءٌ مِنَ الكِبرِ","result":"لا يَدخُلُ شَيءٌ مِنَ الكِبرِ الجَنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-01826","ref":"تخريج المسند لشعيب 17207","text":["«",["لا يَدخُلُ شَيءٌ مِنَ الكِبرِ الجَنَّةَ",2],"». فقال قائِلٌ: يا نَبيَّ اللهِ، إنِّي أُحِبُّ أن أتَجَمَّلَ بحُبلَّانِ سَوطي، وشِسعِ نَعلي، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: «إنَّ ذلك ليس بالكِبرِ، إنَّ اللهَ عَزَّ وجَلَّ جَميلٌ يُحِبُّ الجَمالَ، إنَّما الكِبرُ مَن سَفِهَ الحَقَّ، وغَمَصَ النَّاسَ بعَينَيه». يَعني بالحُبلَّانِ: سَيرَ السَّوطِ وشِسعَ النَّعلِ."],"grade":"صحيح","narrator":"أبو ريحانة","muhaddith":"صحيح لغيره","bab":"إيمان › توحيد الأسماء والصفات","dorar":"WIz44Fj4"},{"id":"س-04285","fp":"a2111524b14c","stateId":769,"easy":"إذا قتلت معاهداً ← لم ترح رائحة الجنة","cause":"مَن قتل مُعَاهَدًا","result":"لم يَرَحْ رائحةَ الجنةِ - أي لم يَشُمَّها - وإنَّ رِيحَها يُوجَدُ من مَسِيرَةِ أَرْبَعِينَ عامًا","explicit":true,"star":true,"similar":["س-05205"],"ref":"غاية المرام 449","srcLabel":"البخاري","text":[["مَن قتل مُعَاهَدًا ",1],["لم يَرَحْ رائحةَ الجنةِ - أي لم يَشُمَّها - وإنَّ رِيحَها يُوجَدُ من مَسِيرَةِ أَرْبَعِينَ عامًا",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه البخاري (3166) باختلاف يسير.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"ISaX3jd4"},{"id":"س-05109","fp":"498edb615a8a","stateId":769,"easy":"إذا قتلت قتيلاً من أهل الذمة ← لم ترح رائحة الجنة","cause":"مَن قتَلَ قتيلًا مِن أهلِ الذِّمَّةِ","result":"لم يرَحْ رائحةَ الجنَّةِ، وإنَّ ريحَها لَيوجَدُ مِن مَسيرةِ أربعينَ عامًا","explicit":true,"star":true,"similar":["س-03007","س-03008"],"ref":"تخريج المسند لشعيب 6745","srcLabel":"البخاري","text":[["مَن قتَلَ قتيلًا مِن أهلِ الذِّمَّةِ؛ ",1],["لم يرَحْ رائحةَ الجنَّةِ، وإنَّ ريحَها لَيوجَدُ مِن مَسيرةِ أربعينَ عامًا",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (4750) باختلاف يسير، وأخرجه البخاري (3166) بنحوه","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"TlofPgcn"},{"id":"س-04297","fp":"7c4e0be1c3b3","stateId":769,"easy":"إذا قتلت نفساً معاهدة بغير حقها ← لم تجد رائحة الجنة","cause":"مَنْ قَتَلَ نَفْسًا مُعاهَدَةً بِغيرِ حَقِّها","result":"لم يَجِدْ رائحةَ الجنَّةِ، وإنَّ رائحَتَها لتوجَدُ مِنْ مَسيرةِ خَمْسِ مِائةِ عامٍ","explicit":true,"similar":["س-04288","س-04336","س-05102"],"ref":"المستدرك على الصحيحين 134","srcLabel":"مسلم","text":["«",["مَنْ قَتَلَ نَفْسًا مُعاهَدَةً بِغيرِ حَقِّها ",1],["لم يَجِدْ رائحةَ الجنَّةِ، وإنَّ رائحَتَها لتوجَدُ مِنْ مَسيرةِ خَمْسِ مِائةِ عامٍ»",2],"."],"grade":"صحيح","narrator":"أبو بكرة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أحمد (20506)، وابن حبان (7382) كلاهما بلفظه، أبو داود (2760)، والنسائي (4747) بلفظ مقارب دون قوله:(( وإن رائحتها توجد...)).","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"TYe5kcru"},{"id":"س-05674","fp":"f2a04f113593","stateId":769,"easy":"إذا قتلت نفسك جزعاً ← حرّم الله عليك الجنة","cause":"انتزَع سهمًا مِن كِنانتِه فنكَأها","result":"قد حرَّمْتُ عليه الجنَّةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج صحيح ابن حبان 5989","srcLabel":"متفق عليه","text":["إنَّ رجُلًا ممَّن كان قبْلَكم خرَجَتْ به قُرحةٌ فلمَّا آذَتْه ",["انتزَع سهمًا مِن كِنانتِه فنكَأها",1]," فلَمْ يرقَأْ دَمُه حتَّى مات فقال ربُّكم : ",["قد حرَّمْتُ عليه الجنَّةَ",2]," ) ثمَّ مدَّ بيدِه إلى المسجدِ فقال : إي واللهِ لقد حدَّثَني بهذا جُندُبُ بنُ عبدِ اللهِ البَجَليُّ عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم في هذا المسجدِ"],"grade":"صحيح","narrator":"جندب بن عبدالله البجلي","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه ابن حبان (5989) واللفظ له، والبخاري (3463)، ومسلم (113)، وابن منده في ((الإيمان)) (648) باختلاف يسير.","bab":"رقائق وزهد › الصبر على البلاء","dorar":"nh5UJ8vF","merged":3,"otherRefs":["السلسلة الصحيحة 462 (صحيح)","تخريج صحيح ابن حبان 5988 (صحيح)"]},{"id":"س-03007","fp":"7e75d1f5548b","stateId":769,"easy":"إذا قتلت رجلاً من أهل الذمة ← لم ترح رائحة الجنة، وريحها يوجد من مسيرة سبعين عاماً","cause":"فمَن قَتَلَ رَجُلًا منهم","result":"لم يَرَحْ رائحةَ الجَنَّةِ، وإنَّ رِيحَها لَتُوجَدُ مِن مَسيرةِ سَبعينَ عامًا","explicit":true,"repOf":"س-05109","ref":"تخريج المسند لشعيب 23179","text":["عن رَجُلٍ، عن النَّبيِّ صلَّى اللهُ عليه وسلَّمَ أنَّه قال: سيكونُ قَومٌ لهم عَهدٌ، ",["فمَن قَتَلَ رَجُلًا منهم ",1],["لم يَرَحْ رائحةَ الجَنَّةِ، وإنَّ رِيحَها لَتُوجَدُ مِن مَسيرةِ سَبعينَ عامًا",2],"."],"grade":"صحيح","narrator":"رجال من الصحابة","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (4749)، وأحمد (23179) واللفظ له","bab":"إيمان › الوعيد","dorar":"xNSq0jPC"},{"id":"س-03008","fp":"c222d0b23970","stateId":769,"easy":"إذا قتلت رجلاً من أهل الذمة ← لم ترح رائحة الجنة","cause":"مَن قَتَلَ رَجُلًا مِن أهْلِ الذِّمَّةِ","result":"لم يَرَحْ رائحةَ الجَنَّةِ -أو لم يَجِدْ رِيحَ الجَنَّةِ، مَنصورٌ الشَّاكُّ- إنَّ ريحَها تُوجَدُ مِن قَدْرِ سَبْعينَ عامًا","explicit":true,"repOf":"س-05109","ref":"تخريج المسند لشعيب 23128","text":["عن رَجُلٍ مِن أصْحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، عن النَّبيِّ صلَّى اللهُ عليه وسلَّمَ أنَّه قال: ",["مَن قَتَلَ رَجُلًا مِن أهْلِ الذِّمَّةِ ",1],["لم يَرَحْ رائحةَ الجَنَّةِ -أو لم يَجِدْ رِيحَ الجَنَّةِ، مَنصورٌ الشَّاكُّ- إنَّ ريحَها تُوجَدُ مِن قَدْرِ سَبْعينَ عامًا",2],"."],"grade":"صحيح","narrator":"رجال من الصحابة","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (4749)، وأحمد (23128) واللفظ له","bab":"إيمان › الوعيد","dorar":"hjPB9ocy"},{"id":"س-04288","fp":"1a7b1b4db260","stateId":769,"easy":"إذا قتلت نفساً معاهدة بغير حقها ← لم ترح رائحة الجنة","cause":"من قتل نفسًا مُعاهِدةً بغيرِ حقِّها","result":"لم يرُحْ رائحةَ الجنَّةِ ، فإنَّ ريحَ الجنَّةِ ليُوجَدُ من مسيرةِ مائةِ عامٍ","explicit":true,"repOf":"س-04297","ref":"الترغيب والترهيب 4/359","text":[["من قتل نفسًا مُعاهِدةً بغيرِ حقِّها ",1],["لم يرُحْ رائحةَ الجنَّةِ ، فإنَّ ريحَ الجنَّةِ ليُوجَدُ من مسيرةِ مائةِ عامٍ ",2],". وفي روايةٍ : وإنَّ ريحَها ليُوجَدُ من مسيرةِ خمسِمائةِ عامٍ"],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (2760)، والنسائي (4747) بنحوه، وأحمد (20515) واللفظ له\nوالرواية أخرجها ابن حبان (7383).","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"yDWVS00l"},{"id":"س-04336","fp":"57fd93dcceed","stateId":769,"easy":"إذا قتلت نفساً معاهدة ← حرّم الله عليك الجنة وأن تجد رائحتها","cause":"وَما مِن عَبدٍ يَقتُلُ نَفْسًا مُعاهَدةً","result":"إلَّا حَرَّمَ اللهُ عليهِ الجنَّةَ وَرائِحَتَها أنْ يَجِدَها","explicit":true,"repOf":"س-04297","ref":"تخريج المسند لشعيب 20469","text":["إنَّ رِيحَ الجنَّةِ لَتوجَدُ مِن مَسيرةِ مِئةِ عامٍ، ",["وَما مِن عَبدٍ يَقتُلُ نَفْسًا مُعاهَدةً ",1],["إلَّا حَرَّمَ اللهُ عليهِ الجنَّةَ وَرائِحَتَها أنْ يَجِدَها",2],"، قالَ أبو بَكرَةَ: أصَمَّ اللهُ أُذُني إنْ لم أكُنْ سَمِعْتُ النَّبيَّ صلَّى اللهُ عليهِ وسَلَّمَ يَقولُها."],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2760)، والنسائي (4747)، وأحمد (20469) واللفظ له","bab":"جنة › صفة الجنة","dorar":"Cvgs5Cip"},{"id":"س-05101","fp":"a3f8aa21f1ee","stateId":769,"easy":"إذا قتلت معاهداً في غير كنهه ← حرّم الله عليك الجنة","cause":"مَن قتَلَ مُعاهَدًا في غَيرِ كُنْهِهِ","result":"حرَّمَ اللهُ عليهِ الجنَّةَ","explicit":true,"ref":"تخريج المسند لشعيب 20377","srcLabel":"أبو داود","text":[["مَن قتَلَ مُعاهَدًا في غَيرِ كُنْهِهِ، ",1],["حرَّمَ اللهُ عليهِ الجنَّةَ",2],"، قال أبو عَبدِ الرَّحمنِ: كُنهُهُ: حَقٌّ."],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2760)، والنسائي (4747)، وأحمد (20377) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"xOcxExnq"},{"id":"س-05102","fp":"da619e7a70d3","stateId":769,"easy":"إذا قتلت نفساً معاهدة بغير حقها ← حرّم الله عليك أن تشم ريح الجنة","cause":"مَن قتَلَ نَفْسًا مُعاهَدةً بِغَيرِ حَقِّها","result":"فقد حَرَّمَ اللهُ عليهِ الجنَّةَ أنْ يَشُمَّ ريحَها","explicit":true,"repOf":"س-04297","ref":"تخريج المسند لشعيب 20523","text":[["مَن قتَلَ نَفْسًا مُعاهَدةً بِغَيرِ حَقِّها، ",1],["فقد حَرَّمَ اللهُ عليهِ الجنَّةَ أنْ يَشُمَّ ريحَها",2],"."],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2760) بنحوه، والنسائي (4748) باختلاف يسير، وأحمد (20397) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"WPDTZMuk"},{"id":"س-05205","fp":"f226b203ba52","stateId":769,"easy":"إذا قتلت معاهداً له ذمة الله ورسوله ← أخفرت ذمة الله فلا ترح رائحة الجنة","cause":"مَنْ قتلَ نَفْسًا مُعَاهِدًا لهُ ذِمَّةُ اللهِ وذِمَّةُ رَسُولِه","result":"فقد أَخْفَرَ بِذِمَّةِ اللهِ ؛ فلا يُرَحْ رَائِحَةَ الجنةِ ، وإِنَّ رِيحَها لَيُوجَدُ من مَسِيرَةِ سبعينَ خَرِيفًا","explicit":true,"repOf":"س-04285","ref":"صحيح الترغيب 3009","text":["أَلا ",["مَنْ قتلَ نَفْسًا مُعَاهِدًا لهُ ذِمَّةُ اللهِ وذِمَّةُ رَسُولِه ؛ ",1],["فقد أَخْفَرَ بِذِمَّةِ اللهِ ؛ فلا يُرَحْ رَائِحَةَ الجنةِ ، وإِنَّ رِيحَها لَيُوجَدُ من مَسِيرَةِ سبعينَ خَرِيفًا",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (1403) واللفظ له، وابن ماجه (2687) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"BJtmxbTG"},{"id":"س-05510","fp":"59749f3e7946","stateId":769,"easy":"إذا أرقت ملء كفّ من دم حرام ← يُحال بينك وبين الجنة","cause":"بمِلءِ كَفِّه مِن دَمٍ أهراقَه","result":"أن لا يُحالَ بينَه وبينَ الجَنَّةِ","explicit":true,"similar":["س-07277"],"ref":"صحيح البخاري 7152","srcLabel":"البيهقي","text":["شَهِدتُ صَفوانَ وجُندَبًا وأصحابَه وهو يوصيهم، فقالوا: هل سَمِعتَ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم شيئًا؟ قال: سَمِعتُه يقولُ: مَن سَمَّعَ سَمَّعَ اللهُ به يَومَ القيامةِ، قال: ومَن يُشاقِقْ يَشقُقِ اللهُ عليه يَومَ القيامةِ، فقالوا: أوصِنا، فقال: إنَّ أوَّلَ ما يُنتِنُ مِنَ الإنسانِ بَطنُه، فمَنِ استَطاعَ أن لا يَأكُلَ إلَّا طَيِّبًا فليَفعَلْ، ومَنِ استَطاعَ ",["أن لا يُحالَ بينَه وبينَ الجَنَّةِ",2]," ",["بمِلءِ كَفِّه مِن دَمٍ أهراقَه",1]," فليَفعَلْ."],"grade":"صحيح","narrator":"جندب بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (5369)، وابن الحداد في ((جامع الصحيحين)) (2227)، والبغوي في ((معجم الصحابة)) (362) واللفظ لهم.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"kVcAd8Nq"},{"id":"س-07277","fp":"bdc782f60fb2","stateId":769,"easy":"إذا أرقت ملء كف من دم حرام ← يحول بينك وبين كل باب من أبواب الجنة","cause":"مِلْءَ كفٍّ من دمٍ يُهْرِيقَهُ كأنَّما يَذْبَحُ دجاجةُ","result":"كلَّمَا يعرِضُ لبابٍ من أبوابِ الجنةِ حالَ بينَهُ وبينَهُ","explicit":true,"repOf":"س-05510","ref":"مجمع الزوائد 7/300","text":["عن جندُبٍ قال جلَسْتُ إليه في إمارةِ المصعَبِ فقال إنَّ هؤلاءِ القومَ قدْ وَلَغُوا في دمائِهم وتحالَفُوا على الدنيا وتطاوَلُوا في البناءِ وإني أُقْسِمُ باللهِ لا يأتي عليْكُم إلَّا يسيرٌ حتى يكونَ الْجَمَلُ الضابِطُ والحبَلَانِ القَتَبُ أحَبُّ إِلَى أحدِكم من الدَّسْكَرَةِ العظيمةِ، تعلَمون أنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقول: [منِ استطاعَ أن لَّا يحولَ بينَهُ وبينَ الجنةِ ",["مِلْءَ كفٍّ من دمٍ يُهْرِيقَهُ كأنَّما يَذْبَحُ دجاجةُ",1]," ",["كلَّمَا يعرِضُ لبابٍ من أبوابِ الجنةِ حالَ بينَهُ وبينَهُ",2]," ومن استطاع منكم أن لا يجعلَ في بطنِهِ إلَّا طيِّبًا فإِنَّ أوَّلَ مَا يُنْتِنُ منَ الإنسانِ بطْنَهُ]"],"grade":"صحيح","narrator":"جندب بن عبد الله","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه عبد الرزاق (18250)، والطبراني في ((المعجم الكبير)) (2/ 159) (1660)، والروياني في ((مسنده)) (2/ 143) واللفظ لهم.","bab":"فتن › ظهور الفتن","dorar":"7KnEbN9r"},{"id":"س-04309","fp":"f0c4477ac8d5","stateId":769,"easy":"إذا قتلت عاملاً بغير حق ← لا تدخل الجنة (أثر ابن عمر)","cause":"لمن قَتَل عامِلًا بغيرِ حَقٍّ","result":"فإنَّك لا تدخُلُ الجنَّةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"فيض القدير 4/ 506","srcLabel":"فيض القدير","text":["عن ابنِ عُمَرَ أنَّه قال ",["لمن قَتَل عامِلًا بغيرِ حَقٍّ",1],": تزَوَّدْ من الماءِ البارِدِ؛ ",["فإنَّك لا تدخُلُ الجنَّةَ",2]],"grade":"صحيح","muhaddith":"[ثابت]","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"YxJpBLJt"},{"id":"س-05096","fp":"1955d47d4329","stateId":770,"easy":"إذا مات المتصارمان على صرامهما ← لم يجتمعا في الجنة أبداً","cause":"ماتا على صُرامِهما","result":"لم يَجتَمِعا في الجنَّةِ أبَدًا","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 16257","srcLabel":"مسلم","text":["لا يَحِلُّ لِمُسلِمٍ أنْ يَهجُرَ مُسلِمًا فَوقَ ثَلاثِ ليالٍ، فإنْ كان تَصارَما فَوقَ ثَلاثٍ؛ فإنَّهما ناكِبانِ عن الحَقِّ ما داما على صُرامِهما، وأوَّلُهما فَيئًا فسَبْقُهُ بالفَيءِ كفَّارَتُهُ، فإنْ سلَّمَ عليه فلم يَرُدَّ عليهِ، ورَدَّ عليه سَلامَهُ؛ رَدَّتْ عليه المَلائكةُ، ورَدَّ على الآخَرِ الشَّيطانُ، فإنْ ",["ماتا على صُرامِهما",1]," ",["لم يَجتَمِعا في الجنَّةِ أبَدًا",2],"."],"grade":"صحيح","narrator":"هشام بن عامر","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (16257) واللفظ له، والطيالسي (1319)، وأبو يعلى (1557)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"lxjagY10","merged":5,"otherRefs":["صحيح الترغيب 2759 (صحيح)","صحيح الأدب المفرد 311 (صحيح)","الزواجر عن اقتراف الكبائر 2/42 (صحيح)","تخريج صحيح ابن حبان 5664 (صحيح)"]},{"id":"س-03080","fp":"7e5401e1a442","stateId":770,"easy":"إذا قطعت رحمك ← لا تدخل الجنة","cause":"قاطِعٌ","result":"لا يَدخُلُ الجَنَّةَ","explicit":true,"ref":"صحيح مسلم 2556","srcLabel":"البخاري","text":[["لا يَدخُلُ الجَنَّةَ",2],[" قاطِعٌ",1],". قال ابنُ أبي عُمَرَ: قال سُفيانُ: يَعني قاطِعَ رَحِمٍ."],"grade":"صحيح","narrator":"جبير بن مطعم","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5984) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"D118wkzU"},{"id":"س-06189","fp":"029f94f798f0","stateId":771,"easy":"إذا لبست الحرير في الدنيا ← فلا خلاق لك في الآخرة","cause":"إنَّما يَلبَسُ الحَريرَ في الدُّنيا","result":"مَن لا خَلاقَ له في الآخِرةِ","explicit":true,"star":true,"similar":["س-06186"],"ref":"صحيح مسلم 2068","srcLabel":"البخاري","text":["رَأى عُمَرُ عُطارِدًا التَّميميَّ يُقيمُ بالسُّوقِ حُلَّةً سيَراءَ، وكان رَجُلًا يَغشى المُلوكَ ويُصيبُ منهم، فقال عُمَرُ: يا رَسولَ اللهِ، إنِّي رَأيتُ عُطارِدًا يُقيمُ في السُّوقِ حُلَّةً سيَراءَ، فلَوِ اشتَرَيتَها فلَبِستَها لوُفودِ العَرَبِ إذا قدِموا عليكَ، وأظُنُّه قال: ولَبِستَها يَومَ الجُمُعةِ، فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["إنَّما يَلبَسُ الحَريرَ في الدُّنيا",1]," ",["مَن لا خَلاقَ له في الآخِرةِ",2],"، فلَمَّا كان بَعدَ ذلك أُتيَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم بحُلَلٍ سيَراءَ، فبَعَثَ إلى عُمَرَ بحُلَّةٍ، وبَعَثَ إلى أُسامةَ بنِ زَيدٍ بحُلَّةٍ، وأعطى عَليَّ بنَ أبي طالِبٍ حُلَّةً، وقال: شَقِّقْها خُمُرًا بينَ نِسائِكَ، قال: فجاءَ عُمَرُ بحُلَّتِه يَحمِلُها، فقال: يا رَسولَ اللهِ، بَعَثتَ إليَّ بهذه، وقد قُلتَ بالأمسِ في حُلَّةِ عُطارِدٍ ما قُلتَ! فقال: إنِّي لَم أبعَثْ بها إليكَ لتَلبَسَها، ولَكِنِّي بَعَثتُ بها إليكَ لتُصيبَ بها، وأمَّا أُسامةُ فراحَ في حُلَّتِه، فنَظَرَ إليه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم نَظَرًا عَرَفَ أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قد أنكَرَ ما صَنَعَ، فقال: يا رَسولَ اللهِ، ما تَنظُرُ إليَّ، فأنتَ بَعَثتَ إليَّ بها! فقال: إنِّي لَم أبعَثْ إليكَ لتَلبَسَها، ولَكِنِّي بَعَثتُ بها إليكَ لتُشَقِّقَها خُمُرًا بينَ نِسائِكَ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (886) مختصراً باختلاف يسير","bab":"زينة اللباس › إباحة الذهب والحرير للنساء دون الرجال","dorar":"tQ3aOJLO","merged":26,"otherRefs":["صحيح الأدب المفرد 52 (صحيح)","تخريج المسند لشاكر 1/129 (صحيح)","تخريج المسند لشاكر 7/115 (صحيح)","تخريج المسند لشعيب 6339 (صحيح)","نخب الافكار 13/262 (صحيح)","تخريج المسند لشعيب 345 (صحيح)","تخريج المسند لشعيب 8444 (صحيح)","نخب الافكار 13/261 (صحيح)","صحيح الأدب المفرد 20 (صحيح)","صحيح ابن ماجه 2908 (صحيح)","صحيح مسلم 2068 (صحيح)","صحيح النسائي 5321 (صحيح)","صحيح النسائي 5310 (صحيح)","صحيح البخاري 5841 (صحيح)","صحيح البخاري 886 (صحيح)","صحيح البخاري 2619 (صحيح)","تخريج المسند لشاكر 7/80 (صحيح)","تخريج صحيح ابن حبان 5113 (صحيح)","تخريج المسند لشعيب 123 (صحيح)","صحيح مسلم 2069 (صحيح)","صحيح البخاري 5830 (صحيح)","صحيح البخاري 5835 (صحيح)"]},{"id":"س-06186","fp":"ef684049f85e","stateId":771,"easy":"إذا لبست الحرير (للرجال) ← فهو لباس من لا خلاق له","cause":"إنَّما هذه لباسُ","result":"مَن لا خَلاقَ له","explicit":true,"repOf":"س-06189","ref":"صحيح البخاري 948","text":["أخَذَ عُمَرُ جُبَّةً مِن إستَبرَقٍ تُباعُ في السُّوقِ، فأخَذَها، فأتى بها رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: يا رَسولَ اللهِ، ابتَعْ هذه تَجَمَّلْ بها للعيدِ والوُفودِ، فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["إنَّما هذه لباسُ",1]," ",["مَن لا خَلاقَ له",2],". فلَبِثَ عُمَرُ ما شاءَ اللهُ أن يَلبَثَ، ثُمَّ أرسَلَ إليه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم بجُبَّةِ ديباجٍ، فأقبَلَ بها عُمَرُ، فأتى بها رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: يا رَسولَ اللهِ، إنَّك قُلتَ: إنَّما هذه لباسُ مَن لا خَلاقَ له، وأرسَلتَ إليَّ بهذه الجُبَّةِ! فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: تَبيعُها أو تُصيبُ بها حاجَتَك."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (948)، ومسلم (2068)","bab":"زينة اللباس › إباحة الذهب والحرير للنساء دون الرجال","dorar":"aKKf1htM","merged":4,"otherRefs":["صحيح البخاري 2104 (صحيح)","تخريج المسند لشعيب 26469 (صحيح)","صحيح الأدب المفرد 267 (صحيح)"]},{"id":"س-06191","fp":"9e0b7f6f2d14","stateId":771,"easy":"إذا شربت في آنية الذهب والفضة في الدنيا ← لم تشرب فيها في الآخرة","cause":"ومن شَرِبَ في آنيةِ الذَّهَبِ والفِضَّةِ في الدُّنيا","result":"لم يَشرَبْ فيها في الآخِرةِ","explicit":true,"star":true,"ref":"الأحاديث المختارة 159","srcLabel":"متفق عليه","text":["«شَهِدْتُ عُمَرَ بنَ الخَطَّابِ دخل عليه عَبدُ الرَّحمنِ بنُ عَوفٍ، وعليه قَميصٌ من حَريرٍ، فقال له عُمَرُ: دَعْ هذا عنك -أو انزِعْ هذا-؛ فإنَّه ذَكَر -يعني النَّبيَّ صلَّى اللهُ عليه وسلَّم- يَقولُ: من لَبِس الحريرَ والدِّيباجَ في الدُّنيا لم يَلْبَسْه في الآخِرةِ، ",["ومن شَرِبَ في آنيةِ الذَّهَبِ والفِضَّةِ في الدُّنيا",1]," ",["لم يَشرَبْ فيها في الآخِرةِ",2],"، فقال عَبدُ الرَّحمنِ بنُ عَوفٍ: إنِّي لأرجو أن ألبَسَه في الدُّنيا والآخِرةِ»."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"زينة اللباس › إباحة الذهب والحرير للنساء دون الرجال","dorar":"6EXRI81W","merged":3,"otherRefs":["فتح الباري لابن حجر 10/100 (حسن)","الأحكام الوسطى 4/ 299 (صحيح)"]},{"id":"س-06200","fp":"dfbb051f90d9","stateId":771,"easy":"إذا لبست الحرير في الدنيا (للرجال) ← لم تلبسه في الآخرة","cause":"فإنَّه مَن لَبِسَه في الدُّنيا","result":"لَم يَلبَسْه في الآخِرةِ","explicit":true,"star":true,"similar":["س-06207","س-03003","س-05063","س-06202"],"ref":"صحيح مسلم 2069","srcLabel":"البخاري","text":["عن خَليفةَ بنِ كَعبٍ، أبي ذُبيانَ، قال: سَمِعتُ عَبدَ اللهِ بنَ الزُّبَيرِ يَخطُبُ يَقولُ: ألا لا تُلبِسوا نِساءَكُمُ الحَريرَ؛ فإنِّي سَمِعتُ عُمَرَ بنَ الخَطَّابِ يقولُ: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: لا تَلبَسوا الحَريرَ؛ ",["فإنَّه مَن لَبِسَه في الدُّنيا",1]," ",["لَم يَلبَسْه في الآخِرةِ",2],"."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"[صحيح]","takhrij":"أخرجه النسائي (5305)، وأبو عوانة في ((المستخرج)) (8948) واللفظ لهما، والبخاري (5830) بنحوه.","bab":"زينة اللباس › ما نهي عنه من اللباس","dorar":"WtTi7V2N","merged":2,"otherRefs":["صحيح الترغيب 2062 (صحيح)"]},{"id":"س-03012","fp":"4b280b04578c","stateId":771,"easy":"إذا شربت الخمر في الدنيا ومت عليها ولم تتب ← حرّمها الله عليك في الآخرة","cause":"مَن شَرِبَ الخَمرَ في الدُّنيا، ثُمَّ ماتَ وهو يَشرَبُها لم يَتُبْ منها","result":"حرَّمَها اللهُ عليه في الآخِرَةِ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 4916","srcLabel":"متفق عليه","text":[["مَن شَرِبَ الخَمرَ في الدُّنيا، ثُمَّ ماتَ وهو يَشرَبُها لم يَتُبْ منها، ",1],["حرَّمَها اللهُ عليه في الآخِرَةِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (5575) بنحوه مختصراً، ومسلم (2003) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"kr2uLKen"},{"id":"س-04291","fp":"573b49b851e2","stateId":771,"easy":"إذا لم تلبس الحرير في الآخرة ← (لأنك) لم تدخل الجنة","cause":"ومن لم يلبَسْهُ في الآخرةِ","result":"لم يدخلِ الجنةَ","explicit":true,"ref":"صحيح الترغيب 2062","srcLabel":"متفق عليه","text":["لا تلبسوا الحريرَ ؛ فإنَّهُ من لبسَه في الدنيا ؛ لم يلبَسْه في الآخرةِ ",["ومن لم يلبَسْهُ في الآخرةِ",1]," ؛ ",["لم يدخلِ الجنةَ",2]," ، قال اللهُ تعالَى :  وَلِبَاسُهُمْ فِيهَا حَرِيرٌ  ."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5830)، ومسلم (2069)، وأبو داود (2817) باختلاف يسير.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"qH6HAFkM"},{"id":"س-05270","fp":"80ad56ce2ccf","stateId":771,"easy":"إذا شربت الخمر ابتغاء لذة سكرها ← يُسقى من الخبال يوم القيامة (على رواية)","cause":"يَشرَبُه رَجُلٌ قَطُّ ابْتِغاءَ لَذَّةِ سُكْرِه","result":"ما يَشرَبُه رَجُلٌ قَطُّ ابْتِغاءَ لَذَّةِ سُكْرِه فيَسْقيَه اللهُ عَزَّ وجَلَّ الخَمْرَ يَوْمَ القِيامةِ","explicit":true,"ref":"الأحاديث المختارة 8 / 168","srcLabel":"متفق عليه","text":["«كُنَّا جُلوسًا عِنْدَ نَبِيِّ اللهِ صلَّى اللهُ عليه وسلَّمَ فجاءَ صُحارُ عَبْدِ القَيْسِ، فقالَ: يا نَبِيَّ اللهِ ما تَرى بشَرابٍ نَصنَعُه مِن ثِمارِنا؟ فأعْرَضَ عنه النَّبيُّ صلَّى اللهُ عليه وسلَّمَ حتَّى سألَه ثَلاثَ مَرَّاتٍ، ثُمَّ قامَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ فصلَّى بنا، فلمَّا قَضى الصَّلاةَ قالَ: (مَن السَّائِلُ عن المُسكِرِ؟ تَسأَلُني؟ لا تَشرَبْه ولا تَسْقِه أخاك المُسلِمَ؛ فوَالَّذي نَفْسي بيَدِه ",["ما يَشرَبُه رَجُلٌ قَطُّ ابْتِغاءَ لَذَّةِ سُكْرِه فيَسْقيَه اللهُ عَزَّ وجَلَّ الخَمْرَ يَوْمَ القِيامةِ",2],"»)."],"grade":"صحيح","narrator":"طلق بن علي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"CZF9GB2U"},{"id":"س-06207","fp":"8f3848dc1e44","stateId":771,"easy":"إذا لبست الحرير في الدنيا (للرجال) ← حُرمت أن تلبسه في الآخرة","cause":"مَن لَبِسَ الحريرَ في الدُّنيا","result":"حُرِمَه أنْ يَلبَسَه في الآخِرةِ","explicit":true,"repOf":"س-06200","ref":"تخريج المسند لشعيب 17431","text":["سمِعتُ مَسْلَمةَ بنَ مُخَلَّدٍ وهو قاعدٌ على المِنبرِ يَخطُبُ الناسَ وهو يقولُ: يا أيُّها الناسُ، أمَا لكم في العَصْبِ والكَتَّانِ ما يَكْفيكم عنِ الحريرِ؟! وهذا رجُلٌ فيكم يُخبِرُكم عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، قُمْ يا عُقْبةُ. فقام عُقْبةُ بنُ عامِرٍ وأنا أَسمَعُ، فقال: إنِّي سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: مَن كَذَب علَيَّ مُتعمِّدًا فلْيَتبَوَّأْ مَقعَدَه مِنَ النارِ. وأَشهَدُ أنِّي سمِعتُه يقولُ: ",["مَن لَبِسَ الحريرَ في الدُّنيا، ",1],["حُرِمَه أنْ يَلبَسَه في الآخِرةِ",2],"."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (17431) واللفظ له، وأبو يعلى (1751)، وابن حبان (5436)","bab":"زينة اللباس › ما نهي عنه من اللباس","dorar":"NoTuJoUj","merged":6,"otherRefs":["الأحكام الوسطى 4/ 299 (صحيح)","المطالب العالية 3/19 (صحيح)","تحفة المحتاج 1/535 (صحيح)","الأحاديث المختارة 159 (صحيح)","نخب الافكار 13/306 (صحيح)"]},{"id":"س-04331","fp":"6f61d8a10530","stateId":771,"easy":"إذا شربت الخمر في الدنيا ← لم تشربها في الآخرة","cause":"ومَن شَرِبَ الخَمْرَ في الدُّنْيا","result":"لم يَشرَبْها في الآخِرةِ","explicit":true,"ref":"الأحكام الوسطى 4/ 299","srcLabel":"النسائي","text":["\"مَن لَبِسَ الحَريرَ في الدُّنْيا لم يَلبَسْه في الآخِرةِ، ",["ومَن شَرِبَ الخَمْرَ في الدُّنْيا",1]," ",["لم يَشرَبْها في الآخِرةِ",2],"، ومَن شَرِبَ في آنِيةِ الذَّهَبِ والفِضَّةِ في الدُّنْيا لم يَشرَبْ بِهما في الآخِرةِ\"، ثُمَّ قالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: \"لِباسُ أهْلِ الجَنَّةِ، وشَرابُ أهْلِ الجَنَّةِ وآنِيةُ أهْلِ الجَنَّةِ\"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (6840)، والحاكم (7216)، والطحاوي (6678) بلفظه.","bab":"جنة › صفة الجنة","dorar":"T1DdnAKV","merged":4,"otherRefs":["صحيح الجامع 4553 (صحيح)","صحيح مسلم 2003 (صحيح)","تخريج المسند لشعيب 4824 (صحيح)"]},{"id":"س-02705","fp":"dc88c7cab953","stateId":771,"easy":"إذا أدمنت الخمر أو قطعت رحمك أو صدّقت بالسحر ← لا تدخل الجنة","cause":"مُدْمِنُ الخَمْرِ، وقاطِعُ الرَّحِمِ، ومُصَدِّقٌ بالسِّحْرِ","result":"ثَلاثةٌ لا يَدخُلونَ الجنَّةَ","explicit":true,"ref":"المستدرك على الصحيحين 7439","srcLabel":"أحمد","text":[["ثَلاثةٌ لا يَدخُلونَ الجنَّةَ",2],": ",["مُدْمِنُ الخَمْرِ، وقاطِعُ الرَّحِمِ، ومُصَدِّقٌ بالسِّحْرِ",1],"، ومَن ماتَ مُدْمِنَ الخَمْرِ سقاهُ اللهُ مِن نَهْرِ الغُوطةِ، قيل: وما نَهْرُ الغُوطةِ؟ قالَ: نَهْرٌ يَخْرُجُ مِن فُروجِ المُومساتِ، يُؤذي أهْلَ النَّار رِيحُ فُرُوجِهِم."],"grade":"صحيح","narrator":"أبو موسى","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (19569)، وابن حبان (5346)، والمخلص في ((المخلصيات)) (740) جميعهم بلفظه.","bab":"إيمان › السحر والنشرة والكهانة","dorar":"Ze7ME3QW","merged":3,"otherRefs":["مجمع الزوائد 5/77 (حسن)","الترغيب والترهيب 4/90 (صحيح)"]},{"id":"س-03003","fp":"c5ad36a84ff1","stateId":771,"easy":"إذا لبست الحرير في الدنيا (للرجال) ← لم تلبسه في الآخرة","cause":"مَن لَبِسَ الحريرَ في الدُّنيا","result":"لم يلبَسهُ في الآخِرةِ ولو دَخلَ الجنَّةَ يلبسُهُ أَهْلُ الجنَّةِ، ولا يلبَسُهُ هوَ","explicit":true,"repOf":"س-06200","ref":"نخب الافكار 13/277","text":[["مَن لَبِسَ الحريرَ في الدُّنيا، ",1],["لم يلبَسهُ في الآخِرةِ ولو دَخلَ الجنَّةَ يلبسُهُ أَهْلُ الجنَّةِ، ولا يلبَسُهُ هوَ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح معاني الآثار)) (6672) واللفظ له، والنسائي في ((الكبرى)) (9534)، وابن حبان (5437) باختلاف يسير، وأحمد (11179) مختصرا","bab":"إيمان › الوعيد","dorar":"3iAVkZmw"},{"id":"س-03014","fp":"39f87c4c543e","stateId":771,"easy":"إذا لبست الذهب (للرجال) فمت وأنت تلبسه ← حرّم الله عليك ذهب الجنة","cause":"مَن لبِسَ الذَّهبَ مِن أُمَّتي، فمات وهو يلبَسُه","result":"لم يلبَسْ مِن ذَهبِ الجنَّةِ -وقال هَوذةُ: حرَّمَ اللهُ عليه ذَهبَ الجنَّةِ","explicit":true,"similar":["س-03015","س-04334"],"ref":"تخريج المسند لشعيب 6947","srcLabel":"أحمد","text":[["مَن لبِسَ الذَّهبَ مِن أُمَّتي، فمات وهو يلبَسُه؛ ",1],["لم يلبَسْ مِن ذَهبِ الجنَّةِ -وقال هَوذةُ: حرَّمَ اللهُ عليه ذَهبَ الجنَّةِ-، ",2],"ومَن لبِسَ الحريرَ مِن أُمَّتي، فمات وهو يلبَسُه؛ حرَّمَ اللهُ عليه حريرَ الجنَّةِ.\nقال عبدُ اللهِ [بنُ أحمدَ]: ضرَبَ أبي على هذا الحديثِ، فظنَنْتُ أنَّه ضرَبَ عليه لأنَّه خطأٌ، وإنَّما هو مَيمونُ بنُ أُستاذَ، عن عبدِ اللهِ بنِ عَمرٍو، وليس فيه: عن الصَّدَفي، ويُقالُ: إنَّ مَيمونَ هذا هو الصَّدَفي لأنَّ سماعَ يزيدَ بنِ هارونَ مِن الجُرَيريِّ آخِرَ عُمرِه، واللهُ أعلمُ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6947) واللفظ له، والطبراني (13/599) (14516)","bab":"إيمان › الوعيد","dorar":"YDExFj8E"},{"id":"س-03015","fp":"ea3e0109428c","stateId":771,"easy":"إذا لبست الحرير (للرجال) فمت وأنت تلبسه ← حرّم الله عليك حرير الجنة","cause":"ومَن لبِسَ الحريرَ مِن أُمَّتي، فمات وهو يلبَسُه","result":"حرَّمَ اللهُ عليه حريرَ الجنَّةِ","explicit":true,"repOf":"س-03014","ref":"تخريج المسند لشعيب 6947","text":["مَن لبِسَ الذَّهبَ مِن أُمَّتي، فمات وهو يلبَسُه؛ لم يلبَسْ مِن ذَهبِ الجنَّةِ -وقال هَوذةُ: حرَّمَ اللهُ عليه ذَهبَ الجنَّةِ-، ",["ومَن لبِسَ الحريرَ مِن أُمَّتي، فمات وهو يلبَسُه؛ ",1],["حرَّمَ اللهُ عليه حريرَ الجنَّةِ",2],".\nقال عبدُ اللهِ [بنُ أحمدَ]: ضرَبَ أبي على هذا الحديثِ، فظنَنْتُ أنَّه ضرَبَ عليه لأنَّه خطأٌ، وإنَّما هو مَيمونُ بنُ أُستاذَ، عن عبدِ اللهِ بنِ عَمرٍو، وليس فيه: عن الصَّدَفي، ويُقالُ: إنَّ مَيمونَ هذا هو الصَّدَفي لأنَّ سماعَ يزيدَ بنِ هارونَ مِن الجُرَيريِّ آخِرَ عُمرِه، واللهُ أعلمُ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6947) واللفظ له، والطبراني (13/599) (14516)","bab":"إيمان › الوعيد","dorar":"YDExFj8E"},{"id":"س-04333","fp":"b79b957ac27c","stateId":771,"easy":"إذا مت وأنت تشرب الخمر ← حرّم الله عليك شربها في الجنة","cause":"مَنْ ماتَ من أُمَّتي وهوَ يشربُ الخمرَ","result":"حَرَّمَ اللهُ عليهِ شُرْبَها في الجنةِ","explicit":true,"similar":["س-08282"],"ref":"صحيح الترغيب 2059","srcLabel":"أحمد","text":[["مَنْ ماتَ من أُمَّتي وهوَ يشربُ الخمرَ ؛ ",1],["حَرَّمَ اللهُ عليهِ شُرْبَها في الجنةِ ، ",2],"ومَنْ ماتَ من أُمَّتي وهوَ يَتَحَلَّى بالذَّهَبِ ؛ حَرَّمَ اللهُ عليهِ لِباسَهُ في الجنةِ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"حسن صحيح","takhrij":"أخرجه أحمد (6948)، والبزار كما في ((مجمع الزوائد)) للهيثمي (5/77) باختلاف يسير، والطبراني (13/600) (14517) مطولاً","bab":"جنة › صفة الجنة","dorar":"HnumiTC3"},{"id":"س-04334","fp":"411e5fe40a54","stateId":771,"easy":"إذا مت وأنت تتحلى بالذهب (للرجال) ← حرّم الله عليك لباسه في الجنة","cause":"ومَنْ ماتَ من أُمَّتي وهوَ يَتَحَلَّى بالذَّهَبِ","result":"حَرَّمَ اللهُ عليهِ لِباسَهُ في الجنةِ","explicit":true,"repOf":"س-03014","ref":"صحيح الترغيب 2059","text":["مَنْ ماتَ من أُمَّتي وهوَ يشربُ الخمرَ ؛ حَرَّمَ اللهُ عليهِ شُرْبَها في الجنةِ ، ",["ومَنْ ماتَ من أُمَّتي وهوَ يَتَحَلَّى بالذَّهَبِ ؛ ",1],["حَرَّمَ اللهُ عليهِ لِباسَهُ في الجنةِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"حسن صحيح","takhrij":"أخرجه أحمد (6948)، والبزار كما في ((مجمع الزوائد)) للهيثمي (5/77) باختلاف يسير، والطبراني (13/600) (14517) مطولاً","bab":"جنة › صفة الجنة","dorar":"HnumiTC3"},{"id":"س-05063","fp":"25be636f32d6","stateId":771,"easy":"إذا لبست الحرير في الدنيا (للرجال) ← حُرمته في الآخرة","cause":"يَلبَسُ هذا في الدنيا","result":"إلا حُرِمه في الآخرةِ","explicit":true,"repOf":"س-06200","ref":"إتحاف الخيرة المهرة 4/ 483","text":["كان جارٌ لي ختَم القرآنَ على عُمرَ بنِ الخطَّابِ ، قال : خرَجَتْ خيلٌ لرسولِ اللهِ صلَّى اللهُ عليه وسلَّم فسمِع بها أُكَيدرُ دومةِ الجندلِ ، فانطَلَق إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم ، فقال : يا رسولَ اللهِ ، بلَغني أنَّ خَيلَكَ انطلَقَتْ ، وإني خِفتُ على أرضي ، ومالي ، فاكتُبْ لي كتابًا لا يتعرَّض لشيءٍ هو لي ، فإني مُقِرٌّ بالذي عليَّ منَ الحقِّ ، فكتَب له رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ، ثم إنَّ أُكَيدِرَ أخرَج قباءً منسوجًا بالذهبِ ، مما كان كِسرى يَكسوهم ، فقال النبيُّ صلَّى اللهُ عليه وسلَّم : ارجِعْ بقبائِكَ ، فإنه ليس أحدٌ ",["يَلبَسُ هذا في الدنيا",1]," ",["إلا حُرِمه في الآخرةِ",2]," فرجَع به الرجلُ ، حتى إذا أتى منزِلَه ، وجَد في نفسِه أن تُرَدَّ عليه هديتُه ، فرجَع إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم ، فقال : يا رسولَ اللهِ ، إنا أهلُ بيتٍ شَقَّ علينا أن تُرَدَّ هديتُنا ، فاقبَلْ مني هديَّتي ، فقال له : انطَلِقْ فادفَعْه إلى عُمرَ ، وقد كان عُمرُ سمِع ما قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ، فقال : أحدَث فيَّ ، أمرٌ ، قلتَ في هذا القباءِ ما سمِعتُ ، ثم بعَثتَ به إليَّ ؟ فضحِك رسولُ اللهِ صلَّى اللهُ عليه وسلَّم حتى وضَع يدَه على فيه ، ثم قال : ما بعَثتُ إليكَ لتَلبَسَه ، ولكن تَبيعَه فتَستَعينَ بثمَنِه"],"grade":"صحيح","narrator":"رجل","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن قانع في ((معجم الصحابة)) (2/ 351) مختصرا.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"2oM0SbJg"},{"id":"س-06202","fp":"546e28ebf4e2","stateId":771,"easy":"إذا لبست الحرير في الدنيا (للرجال) ← فإنما يلبسه من لا يرجو أن يلبسه في الآخرة","cause":"يَلبَسُ الحريرَ في الدُّنيا","result":"مَن لا يَرْجو أنْ يَلبَسَه في الآخِرةِ، إنَّما يَلبَسُ الحريرَ مَن لا خَلاقَ له","explicit":true,"repOf":"س-06200","ref":"تخريج المسند لشعيب 8355","text":["إنَّما ",["يَلبَسُ الحريرَ في الدُّنيا",1]," ",["مَن لا يَرْجو أنْ يَلبَسَه في الآخِرةِ، إنَّما يَلبَسُ الحريرَ مَن لا خَلاقَ له",2],". قال الحسنُ: فما بالُ أقوامٍ يَبلُغُهم هذا عن نبِيِّهم، فيَجعَلون حريرًا في ثيابِهم وفي بُيوتِهم؟!"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (6869) بنحوه مطولاً، وأحمد (8355) واللفظ له","bab":"زينة اللباس › ما نهي عنه من اللباس","dorar":"a28sMrnU"},{"id":"س-08282","fp":"341f75b5ded4","stateId":771,"easy":"إذا مت وأنت تشرب الخمر أو تتحلى بالذهب (للرجال) ← حرّمها الله عليك في الآخرة","cause":"مَن مات مِن أُمَّتي ، وهو يَشرَبُ الخمرَ حرَّمها اللهُ عليه في الآخرةِ ، ومَن مات مِن أُمَّتي وهو يلبسُ الحريرَ","result":"حرَّم اللهُ عليه لُبسَه في الآخرةِ","explicit":true,"repOf":"س-04333","ref":"إتحاف الخيرة المهرة 4/ 382","text":[["مَن مات مِن أُمَّتي ، وهو يَشرَبُ الخمرَ حرَّمها اللهُ عليه في الآخرةِ ، ومَن مات مِن أُمَّتي وهو يلبسُ الحريرَ ",1],["حرَّم اللهُ عليه لُبسَه في الآخرةِ",2]],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"رجاله ثقات، وله شاهد","takhrij":"أخرجه أحمد (6948)، والبزار كما في ((مجمع الزوائد)) للهيثمي (5/77) أوله باختلاف يسير في أثناء حديث، وأبو يعلى كما في ((إتحاف الخيرة المهرة)) للبوصيري (4/382) واللفظ له","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"7OOApfWO"},{"id":"س-03079","fp":"4e7dce6355c6","stateId":772,"easy":"إذا وليت أمر المسلمين ولم تجهد لهم وتنصح ← لم تدخل معهم الجنة","cause":"ما مِن أميرٍ يَلي أمرَ المُسلِمينَ، ثُمَّ لا يَجهَدُ لهم ويَنصَحُ","result":"إلَّا لم يَدخُلْ معهُمُ الجَنَّةَ","explicit":true,"star":true,"similar":["س-04273"],"ref":"صحيح مسلم 142","srcLabel":"متفق عليه","text":["أنَّ عُبَيدَ اللهِ بنَ زيادٍ دَخَلَ على مَعقِلِ بنِ يَسارٍ في مَرَضِه، فقال له مَعقِلٌ: إنِّي مُحَدِّثُكَ بحَديثٍ لَولا أنِّي في المَوتِ لم أُحَدِّثْكَ به، سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["ما مِن أميرٍ يَلي أمرَ المُسلِمينَ، ثُمَّ لا يَجهَدُ لهم ويَنصَحُ،",1]," ",["إلَّا لم يَدخُلْ معهُمُ الجَنَّةَ",2],"."],"grade":"صحيح","narrator":"معقل بن يسار","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7150) بمعناه، ومسلم (142).","bab":"إيمان › الوعيد","dorar":"BC9tfQMO"},{"id":"س-04273","fp":"e3abcbbf07b2","stateId":772,"easy":"إذا استرعاك الله رعية فلم تجهد لهم وتنصح ← لم تدخل معهم الجنة","cause":"ما من والٍ يسترعيه اللهُ رعيةً ثم لم يَجْهَدْ لهم وينصحْ لهم","result":"إلا لم يدخلْ معهم الجنةَ","explicit":true,"repOf":"س-03079","ref":"مجموع الفتاوى 35/192","text":[["ما من والٍ يسترعيه اللهُ رعيةً ثم لم يَجْهَدْ لهم وينصحْ لهم",1]," ",["إلا لم يدخلْ معهم الجنةَ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"6ctOeuYc"},{"id":"س-04257","fp":"d1d8a6c36878","stateId":772,"easy":"إذا وليت رعية من المسلمين فمت وأنت غاش لهم ← حرّم الله عليك الجنة","cause":"ما مِن والٍ يَلي رَعيَّةً مِنَ المُسلِمينَ، فيَموتُ وهو غاشٌّ لهم","result":"إلَّا حَرَّمَ اللهُ عليه الجَنَّةَ","explicit":true,"ref":"صحيح البخاري 7151","srcLabel":"متفق عليه","text":[["ما مِن والٍ يَلي رَعيَّةً مِنَ المُسلِمينَ، فيَموتُ وهو غاشٌّ لهم،",1]," ",["إلَّا حَرَّمَ اللهُ عليه الجَنَّةَ",2],"."],"grade":"صحيح","narrator":"معقل بن يسار","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7151)، ومسلم (142)","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"9VSokuhP"},{"id":"س-07942","fp":"9b715403da48","stateId":772,"easy":"إذا استرعاك الله رعية فمت وأنت غاش لهم ← حرّم الله عليك الجنة","cause":"ما مِن عَبدٍ يَستَرعيه اللهُ رَعيَّةً يَموتُ يَومَ يَموتُ وهو غاشٌّ لرَعيَّتِه","result":"إلَّا حَرَّمَ اللهُ عليه الجَنَّةَ","explicit":true,"star":true,"ref":"صحيح مسلم 142","srcLabel":"متفق عليه","text":["عادَ عُبَيدُ اللهِ بنُ زيادٍ مَعقِلَ بنَ يَسارٍ المُزَنيَّ في مَرَضِه الذي ماتَ فيه، قال مَعقِلٌ: إنِّي مُحَدِّثُكَ حَديثًا سَمِعتُه مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، لو عَلِمتُ أنَّ لي حَياةً ما حَدَّثتُكَ، إنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["ما مِن عَبدٍ يَستَرعيه اللهُ رَعيَّةً يَموتُ يَومَ يَموتُ وهو غاشٌّ لرَعيَّتِه،",1]," ",["إلَّا حَرَّمَ اللهُ عليه الجَنَّةَ",2],"."],"grade":"صحيح","narrator":"معقل بن يسار","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7150)، ومسلم (142).","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"hlYrc1C2","merged":2,"otherRefs":["صحيح مسلم 142 (صحيح)"]},{"id":"س-04183","fp":"2fb04d88b038","stateId":772,"easy":"إذا اقتطعت حق مسلم بيمينك ← حرّم الله عليك الجنة وأوجب لك النار","cause":"لا يقتَطعُ رجلٌ حقَّ امرئٍ مسلِمٍ بيَمينِهِ","result":"إلَّا حرَّمَ اللَّهُ علَيهِ الجنَّةَ وأوجبَ لَهُ النَّارَ","explicit":true,"star":true,"otherNeedIds":[70],"ref":"صحيح ابن ماجه 1896","srcLabel":"مسلم","text":[["لا يقتَطعُ رجلٌ حقَّ امرئٍ مسلِمٍ بيَمينِهِ",1]," ",["إلَّا حرَّمَ اللَّهُ علَيهِ الجنَّةَ وأوجبَ لَهُ النَّارَ ",2],"، فقالَ رجلٌ منَ القومِ : يا رسولَ اللَّهِ ، وإن كانَ شيئًا يَسيرًا ؟ ، قالَ : وإن كانَ سِواكًا من أَراكٍ"],"grade":"صحيح","narrator":"أبو أمامة إياس بن ثعلبة الحارثي","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (2324) واللفظ له، وأخرجه مسلم (137) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"jhdc63JI","merged":3,"otherRefs":["تخريج المسند لشعيب 00/ 56 (صحيح)","صحيح النسائي 5434 (صحيح)"]},{"id":"س-04966","fp":"68a09578b0b4","stateId":772,"easy":"إذا كنت صاحب مكس ← لا تدخل الجنة","cause":"صاحِبُ مَكْسٍ","result":"لا يَدخُلُ صاحِبُ مَكْسٍ الجَنَّةَ","explicit":true,"star":true,"otherNeedIds":[70],"ref":"المستدرك على الصحيحين 1488","srcLabel":"مسلم","text":[["لا يَدخُلُ صاحِبُ مَكْسٍ الجَنَّةَ",2]," قالَ يَزيدُ بنُ هارونَ: يَعني: العَشَّارَ."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أحمد (17354)، وابن خزيمة (2333)، والبيهقي (13303) جميعهم بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ZtlNma0P","merged":3,"otherRefs":["صحيح الترغيب 787 (صحيح)","الأحكام الشرعية الصغرى 601 (صحيح)"]},{"id":"س-04329","fp":"62390dd7e8c4","stateId":772,"easy":"إذا استُرعيت رعية فلم تحطهم بنصيحتك ← لم تجد ريح الجنة","cause":"مَنِ استَرعي رَعيَّةً، فلمْ يُحِطْهم بنَصيحةٍ","result":"لم يَجِدْ رِيحَ الجنَّةِ، ورِيحُها يُوجَدُ مِن مَسيرةِ مِئةِ عامٍ","explicit":true,"ref":"تخريج المسند لشعيب 20315","srcLabel":"متفق عليه","text":[["مَنِ استَرعي رَعيَّةً، فلمْ يُحِطْهم بنَصيحةٍ، ",1],["لم يَجِدْ رِيحَ الجنَّةِ، ورِيحُها يُوجَدُ مِن مَسيرةِ مِئةِ عامٍ",2],"، قال ابنُ زيادٍ: ألَا كنتَ حَدَّثتَني بهذا قبلَ الآن؟ قال: والآن لَولا الذي أنت عليه لم أُحدِّثْكَ به."],"grade":"صحيح","narrator":"معقل بن يسار","muhaddith":"صحيح","takhrij":"أخرجه البخاري (7150) مختصراً باختلاف يسير، ومسلم (142) باختلاف يسير","bab":"جنة › صفة الجنة","dorar":"gnColTti"},{"id":"س-02716","fp":"fc14b636bac1","stateId":772,"easy":"إذا حلفت يميناً فاجرة تقتطع بها مال مسلم ← حرّم الله عليك الجنة وأوجب لك النار","cause":"مَن حلَف على يمينٍ فاجرةٍ يقتطعُ بها مالَ امرئٍ مسلِمٍ بغيرِ حقٍّ","result":"حرَّم اللهُ عليه الجنَّةَ وأوجَب له النَّارَ","explicit":true,"otherNeedIds":[70],"ref":"صحيح ابن حبان 5087","srcLabel":"مسلم","text":[["مَن حلَف على يمينٍ فاجرةٍ يقتطعُ بها مالَ امرئٍ مسلِمٍ بغيرِ حقٍّ ",1],["حرَّم اللهُ عليه الجنَّةَ وأوجَب له النَّارَ",2]," ) قيل: يا رسولَ اللهِ وإنْ كان شيئًا يسيرًا ؟ قال: ( وإنْ كان قضيبًا مِن أراكٍ )"],"grade":"صحيح","narrator":"[أبو أمامة إياس بن ثعلبة الحارثي]","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (137)، والنسائي (5419)، وأحمد (39/ 492) بنحوه.","bab":"إيمان › القطع بدخول أحد الجنة أو النار","dorar":"6AJsk8Yk"},{"id":"س-04207","fp":"3638bfaf49c7","stateId":772,"easy":"إذا حلفت على مال رجل كاذباً فاقتطعته ← برئت منك الجنة ووجبت لك النار","cause":"أَيُّما رجُلٍ حلَف على مالِ رجُلٍ كاذبًا فاقتطَعهُ بيَمينِهِ","result":"فقدْ بَرِئَتْ منه الجَنَّةُ، ووجَبتْ له النَّارُ","explicit":true,"otherNeedIds":[70],"ref":"تخريج مشكل الآثار 444","srcLabel":"مسلم","text":["سمِعْتُ عبدَ اللهِ بنَ كعبِ بنِ مالِكٍ، وأبوهُ كعبٌ أحَدُ الثَّلاثةِ الَّذينَ تخلَّفوا، قال: حدَّثني أبو أُمامةَ، وهو مُسنِدٌ ظَهرَهُ إلى هذه السَّاريةِ -لِساريةٍ مِن سَواري مسجِدِ الرسولِ عليه السَّلامُ- قال: كُنْتُ أنا وأبوكَ كعبُ بنُ مالِكٍ وأخوكَ محمَّدُ بنُ كعبٍ قُعودًا عندَ هذه السَّاريةِ، ونحنُ نذكُرُ الرَّجُلَ يحلِفُ على مالِ الرَّجُلِ، فيقتطِعُهُ بيَمينِهِ كاذبًا، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ عندَ ذلك: ",["أَيُّما رجُلٍ حلَف على مالِ رجُلٍ كاذبًا فاقتطَعهُ بيَمينِهِ ",1],["فقدْ بَرِئَتْ منه الجَنَّةُ، ووجَبتْ له النَّارُ",2],"، فقال أخوكَ محمَّدُ بنُ كعبٍ: يا رسولَ اللهِ، وإنْ كان قليلًا؟ قال: فقلَّب سِواكًا بيْنَ إصبَعَيْهِ، فقال: وإنْ كان سِواكًا مِن أَراكٍ، أو: وإنْ كان عُودًا مِن أَراكٍ."],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"حسن، و[ورد] من طريق آخر صحيح بنحوه","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (444) واللفظ له، ومسلم (137)، والسائي في ((السنن الكبرى) (5939) كلاهما بنحوه.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"ZI4bAq8a"},{"id":"س-06585","fp":"09808a9c345f","stateId":772,"easy":"إذا نبت لحمك من سحت ← لا يدخل الجنة","cause":"لحْمٌ نبَتَ مِن سُحتٍ","result":"لا يَدخُلُ الجنَّةَ","explicit":true,"otherNeedIds":[70],"ref":"المستدرك على الصحيحين 8522","srcLabel":"الحاكم","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قال لكَعبِ بنِ عُجْرةَ: أعاذَكَ اللهُ يا كعْبُ مِن إمارةِ السُّفهاءِ، قال: وما إمارةُ السُّفهاءِ يا رَسولَ اللهِ؟ قال: أُمراءُ يكونونَ بعْدي، لا يَهْدُون بهَدْيي، ولا يَسْتنُّون بسُنَّتي، فمَن صَدَّقهم بكَذِبِهم وأعانَهم على ظُلمِهم، فأولئكَ ليْسوا منِّي، ولسْتُ منهم، ولا يَرِدُون علَيَّ حَوْضي، ومَن لم يُصدِّقْهم بكَذِبِهم ولم يُعِنْهم على ظُلمِهم، فأولئكَ منِّي وأنا منْهم، وسيَرِدُون علَيَّ حَوْضي. يا كَعْبُ بنَ عُجْرةَ، الصَّومُ جُنَّةٌ، والصَّدقةُ تُطفِئُ الخطيئةَ، والصَّلاةُ قُربانٌ، أو قال: بُرهانٌ. يا كَعْبُ بنَ عُجْرةَ، ",["لا يَدخُلُ الجنَّةَ",2]," ",["لحْمٌ نبَتَ مِن سُحتٍ",1]," أبدًا، النَّارُ أَولى به. يا كَعْبُ بنَ عُجْرةَ، النَّاسُ غاديانِ؛ فمُبتاعٌ نفْسَه فمُعتِقُها، أو قال: فمُوبِقُها."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح الإسناد، ولم يخرجاه","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"0TB3rhhe","merged":6,"otherRefs":["صحيح الجامع 4519 (صحيح)","صحيح الموارد 2166 (صحيح)","تخريج صحيح ابن حبان 1723 (صحيح)","تخريج المسند لشعيب 15284 (صحيح)","الترغيب والترهيب 3/68 (صحيح)"]},{"id":"س-03957","fp":"bd6268befeb8","stateId":772,"easy":"إذا قُتلت في سبيل الله مراراً وعليك دين ← لم تدخل الجنة حتى يُقضى دينك","cause":"لوْ قُتِلَ رَجلٌ في سبيلِ اللهِ، ثُمَّ عاشَ ثُمَّ قُتِلَ، ثُمَّ عاشَ وعليه دَينٌ","result":"ما دَخَلَ الجنَّةَ حتَّى يَقضِيَ دَينَهُ","explicit":true,"ref":"المستدرك على الصحيحين 2246","srcLabel":"إسماعيل","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ قاعِدًا حيثُ تُوضعُ الجنائزُ، فرَفَعَ رأسَهُ قِبَلَ السَّماءِ، ثُمَّ خَفَضَ بَصرَهُ، فوَضَعَ يدَهُ على جبهَتِه، فقالَ: سُبحانَ اللهِ، سُبحانَ اللهِ، ما أَنزَلَ اللهُ مِنَ التَّشديدِ. قالَ: فعَرَفْنا وسَكَتْنا، حتَّى إذا كان الغَدُ، سَألْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقلتُ: يا رسولَ اللهِ، ما التَّشديدُ الَّذي نَزَلَ؟ قالَ: في الدَّينِ، والَّذي نَفسُ مُحمَّدٍ بيدِهِ، ",["لوْ قُتِلَ رَجلٌ في سبيلِ اللهِ، ثُمَّ عاشَ ثُمَّ قُتِلَ، ثُمَّ عاشَ وعليه دَينٌ",1],"؛ ",["ما دَخَلَ الجنَّةَ حتَّى يَقضِيَ دَينَهُ",2],"."],"grade":"صحيح","narrator":"محمد بن جحش","muhaddith":"صحيح الإسناد","takhrij":"أخرجه إسماعيل بن جعفر في ((حديث علي بن حجرعن إسماعيل)) (298)، وابن أبي عاصم في ((الآحاد والمثاني)) (928)، وعبد بن حميد في ((المنتخب من مسنده)) (367) جميعا باختلاف يسير.","bab":"تفليس › حلول الدين على الميت","dorar":"fuhzxmGQ","merged":3,"otherRefs":["صحيح الجامع 3600 (صحيح)","الأحاديث المختارة 1080 (صحيح)"]},{"id":"س-04808","fp":"a368d6c91047","stateId":772,"easy":"إذا غذّيت جسدك بالحرام ← لا يدخل الجنة","cause":"جسدٌ غُذِيَ بحرامٍ","result":"لا يدخلُ الجنَّةَ","explicit":true,"ref":"صحيح الترغيب 1730","srcLabel":"أحمد","text":[["لا يدخلُ الجنَّةَ",2],[" جسدٌ غُذِيَ بحرامٍ ",1],"."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو يعلى (83)، وأحمد بن علي المروزي في ((مسند أبي بكر)) (صـ111) واللفظ لهما، وعبد بن حميد (3) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"tXoPDJdV"},{"id":"س-05203","fp":"518eaa96291d","stateId":772,"easy":"إذا بتّ إماماً غاشاً لرعيتك ← حرّم الله عليك الجنة","cause":"ما من إمامٍ يبيتُ غاشًّا لرعيَّتِه","result":"إلا حرَّم اللهُ عليه الجنَّةَ ، وعَرْفُها يُوجَدُ يومَ القيامةِ من مسيرةِ سبعينَ عامًا","explicit":true,"ref":"صحيح الترغيب 2207","srcLabel":"الطبراني","text":[["ما من إمامٍ يبيتُ غاشًّا لرعيَّتِه ؛",1]," ",["إلا حرَّم اللهُ عليه الجنَّةَ ، وعَرْفُها يُوجَدُ يومَ القيامةِ من مسيرةِ سبعينَ عامًا",2]],"grade":"صحيح","narrator":"عبدالله بن مغفل","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني كما في ((مجمع الزوائد)) للهيثمي (5/215) واللفظ له، والقضاعي في ((مسند الشهاب)) (806)، وابن عساكر في ((تاريخ دمشق)) (37/447)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"W96VWewu"},{"id":"س-04258","fp":"a00f5c41cb36","stateId":772,"easy":"إذا كنت خِبّاً (مخادعاً) أو بخيلاً أو منّاناً ← لا تدخل الجنة","cause":"خِبٌّ ، ولا بخيلٌ ، ولا مَنَّانٌ","result":"لا يَدْخُلُ الجنةَ","explicit":true,"ref":"سنن الترمذي 1963","srcLabel":"أحمد","text":[["لا يَدْخُلُ الجنةَ",2],[" خِبٌّ ، ولا بخيلٌ ، ولا مَنَّانٌ",1]],"grade":"حسن","narrator":"أبو بكر الصديق","muhaddith":"حسن غريب","takhrij":"أخرجه أحمد (1/ 209)، وأبو يعلى (95)، والخرائطي في ((مساويء الأخلاق)) (347) بلفظه تامًا.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"EvRI4N1Q"},{"id":"س-05532","fp":"744e17a0835f","stateId":772,"easy":"إذا وليت عملاً فحجبت بابك عن ذي الحاجة ← يحجبك الله عن حاجتك يوم القيامة","cause":"من ولِيَ عليكُم عملًا فحَجبَ بابَهُ عن ذي حاجةٍ أو قالَ : دونَ حاجةِ المسلِمينَ","result":"حجبَهُ اللَّهُ أن يلجَ بابَ الجنَّةِ","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 2/116","srcLabel":"الطبراني","text":["يا أيُّها النَّاسُ ",["من ولِيَ عليكُم عملًا فحَجبَ بابَهُ عن ذي حاجةٍ أو قالَ : دونَ حاجةِ المسلِمينَ ",1],["حجبَهُ اللَّهُ أن يلجَ بابَ الجنَّةِ ، ",2],"ومن كانَت همَّتُهُ الدُّنيا حرَّمَ اللَّهُ عليهِ جِواري فإنِّي بُعِثتُ بخرابِ الدُّنيا ولم أُبعَثْ بعِمارتِها"],"grade":"حسن","muhaddith":"رواته ثقات إلا شيخ الطبراني خيرون","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"TjKuktNP"},{"id":"س-00408","fp":"8cbb048ab752","stateId":773,"easy":"إذا كنت قتّاتاً (نمّاماً) ← لا تدخل الجنة","cause":"قتّاتٌ","result":"لا يدخلُ الجنةَ","explicit":true,"star":true,"similar":["س-04909"],"ref":"صحيح الجامع 7672","srcLabel":"متفق عليه","text":[["لا يدخلُ الجنةَ",2],[" قتّاتٌ ",1],"[يعني حديث: كانَ رَجُلٌ يَنْقُلُ الحَدِيثَ إلى الأمِيرِ، فَكُنَّا جُلُوسًا في المَسْجِدِ فقالَ: القَوْمُ هذا مِمَّنْ يَنْقُلُ الحَدِيثَ إلى الأمِيرِ، قالَ: فَجاءَ حتَّى جَلَسَ إلَيْنا فقالَ حُذَيْفَةُ: سَمِعْتُ رَسولَ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ يقولُ: لا يَدْخُلُ الجَنَّةَ قَتّاتٌ.]"],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6056)، ومسلم (105)","bab":"آداب عامة › الأخلاق المذمومة","dorar":"1nfVz61b","merged":5,"otherRefs":["تخريج صحيح ابن حبان 5765 (صحيح)","تخريج المسند لشعيب 23305 (صحيح)","تخريج المسند لشعيب 23434 (صحيح)","تخريج المسند لشعيب 23331 (صحيح)"]},{"id":"س-03785","fp":"2c7a61609a8e","stateId":773,"easy":"إذا لم يأمن جارك بوائقك ← لا تدخل الجنة","cause":"عبدٌ لا يأمَنُ جارُه بوائِقَه","result":"لا يدخُلُ الجنَّةَ","explicit":true,"star":true,"otherNeedIds":[21],"ref":"تخريج المسند لشعيب 12562","srcLabel":"أحمد","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قال: المُؤْمِنُ مَنْ أمِنَهُ النَّاسُ... فذَكَرَ مِثْلَه [أي: حديثَ: المؤمِنُ مَن أَمِنَه النَّاسُ، والمُسلِمُ مَن سَلِمَ المُسلِمونَ مِن لِسانِه ويَدِه، والمهاجِرُ مَن هَجَر السُّوءَ، والذي نفسي بيَدِه ",["لا يدخُلُ الجنَّةَ",2]," ",["عبدٌ لا يأمَنُ جارُه بوائِقَه",1],"]"],"grade":"صحيح","narrator":"الحسن البصري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (12562) واللفظ له، والحسين بن حرب في ((البر والصلة)) (260)","bab":"بر وصلة › إكرام الجار وعدم أذيته","dorar":"zvVNA1gk","merged":6,"otherRefs":["تخريج المسند لشعيب 8432 (صحيح)","صحيح الجامع 7102 (صحيح)","صحيح الترغيب 2865 (حسن)","الفتاوى الكبرى 1/ 336 (صحيح)","تخريج المسند لشعيب 7878 (صحيح)"]},{"id":"س-00270","fp":"da9f538cb812","stateId":773,"easy":"إذا كنت منّاناً أو عاقاً لوالديك أو مدمن خمر ← لا تدخل الجنة","cause":"منَّانٌ، ولا عاقٌّ والدَيه، ولا مُدمنُ خَمرٍ","result":"لا يدخُلُ الجنَّةَ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 6882","srcLabel":"النسائي","text":["عن النَّبيِّ صلَّى اللهُ عليه وسلَّمَ أنَّه قال: ",["لا يدخُلُ الجنَّةَ",2],[" منَّانٌ، ولا عاقٌّ والدَيه، ولا مُدمنُ خَمرٍ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي (5672)، وأحمد (6882) واللفظ له","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"NsK5mxfT","merged":4,"otherRefs":["السلسلة الصحيحة 673 (حسن)","صحيح الجامع 7673 (صحيح)","تخريج المسند لشعيب 6892 (صحيح)"]},{"id":"س-04778","fp":"1c3c7590333a","stateId":773,"easy":"إذا كنت مدمن خمر أو عاقاً أو منّاناً بعطائك ← لا تلج حائط القدس (الجنة)","cause":"مُدمِنُ خمرٍ ، ولا العاقُّ ، ولا المنَّانُ عطاءَه","result":"لا يلجُ حائطَ القُدُسِ","explicit":true,"ref":"صحيح الترغيب 2363","srcLabel":"أحمد","text":[["لا يلجُ حائطَ القُدُسِ",2]," ",["مُدمِنُ خمرٍ ، ولا العاقُّ ، ولا المنَّانُ عطاءَه",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (13360)، والخرائطي في ((مساوئ الأخلاق)) (230) واللفظ لهما، والطبراني في ((الأوسط)) (8592) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"AyRE2tn3","merged":4,"otherRefs":["تخريج المسند لشعيب 21/69 (حسن)","تخريج شرح السنة 13/17 (حسن)","تخريج المسند لشعيب 13360 (حسن)"]},{"id":"س-04909","fp":"b6332fd97ffc","stateId":773,"easy":"إذا كنت نماماً ← لا تدخل الجنة","cause":"نمَّامٌ","result":"لا يدخلُ الجنةَ","explicit":true,"repOf":"س-00408","ref":"تفسير القرطبي 22/551","text":[["لا يدخلُ الجنةَ",2],[" نمَّامٌ ",1],"[يعني حديث: أنَّهُ بَلَغَهُ أنَّ رَجُلًا يَنِمُّ الحَدِيثَ فقالَ حُذَيْفَةُ: سَمِعْتُ رَسولَ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ يقولُ: لا يَدْخُلُ الجَنَّةَ نَمَّامٌ.]"],"grade":"صحيح","narrator":"[حذيفة بن اليمان]","muhaddith":"[ثابت]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"AQ5oYK5J","merged":3,"otherRefs":["تخريج المسند لشعيب 23359 (صحيح)","تخريج المسند لشعيب 23387 (صحيح)"]},{"id":"س-04306","fp":"932c04ab6309","stateId":773,"easy":"إذا كنت سيئ الملكة (تسيء إلى من تملك) ← لا تدخل الجنة","cause":"سَيِّئُ المَلَكةِ","result":"لا يَدخُلُ الجَنَّةَ","explicit":true,"ref":"تنبيه الغافلين 293","srcLabel":"الترمذي","text":[["لا يَدخُلُ الجَنَّةَ",2],[" سَيِّئُ المَلَكةِ",1]],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"ثابت","takhrij":"أخرجه الترمذي (1946)، وابن ماجه (3691) مطولا، وأحمد (31) وجميعا بلفظه.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"BuDq9asQ","merged":2,"otherRefs":["هداية الرواة 3/339 (حسن)"]},{"id":"س-04255","fp":"aed32df5e0f9","stateId":773,"easy":"إذا مات المتهاجران وهما متهاجران ← لا يجتمعان في الجنة","cause":"وإنْ ماتَا وهُمَا مُتهاجِرانِ","result":"لا يَجْتمعانِ في الجَنَّةِ","explicit":true,"ref":"المستدرك على الصحيحين 7497","srcLabel":"الطبراني","text":["لا تَحِلُّ الهجْرةُ فوقَ ثَلاثةِ أيَّامٍ، فإنِ الْتَقَيَا، فسَلَّمَ أحدُهُما على الآخَرِ، فرَدَّ عليهِ الآخَرُ السَّلامَ؛ اشتَرَكا في الأجْرِ، وإنْ أبى الآخَرُ أنْ يَرُدَّ السَّلامَ بَرِئَ هذا مِن الإثْمِ، وَباءَ بهِ الآخَرُ، وأحسَبُه قالَ: ",["وإنْ ماتَا وهُمَا مُتهاجِرانِ",1],"، ",["لا يَجْتمعانِ في الجَنَّةِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (8930) واللفظ له، وأبو الشيخ الأصبهاني ((التوبيخ والتنبيه)) (43) بنحوه","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"xPtMObCc"},{"id":"س-05188","fp":"0e92652d64ac","stateId":773,"easy":"إذا تكلمت بالكلمة (من سخط الله) ← تتباعد بها عن الجنة أبعد من صنعاء","cause":"فيتكلمُ بالكلمةِ","result":"فيتباعدُ منها إلى أبعدَ من صنعاءَ","explicit":true,"ref":"مجمع الزوائد 10/300","srcLabel":"أحمد","text":["إن الرجلَ ليدنُو من الجنةِ حتى ما يكونُ بينَه وبينَها قِيدُ ذراعٍ ",["فيتكلمُ بالكلمةِ",1]," ",["فيتباعدُ منها إلى أبعدَ من صنعاءَ",2]],"grade":"صحيح","narrator":"ابنة أبي الحكم الغفارية","muhaddith":"رجاله رجال الصحيح غير محمد بن إسحاق وقد وثق","takhrij":"أخرجه أحمد (16610) واللفظ له، وابن أبي عاصم ((الآحاد والمثاني)) (3458)، وابن أبي خيثمة في ((التاريخ الكبير)) (2/ 825)، وأبو نعيم في ((معرفة الصحابة)) (8093) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"uOQWRbeC"},{"id":"س-02720","fp":"5af4451ed09c","stateId":773,"easy":"إذا تكلمت فيما لا يعنيك أو بخلت بما لا ينقصك ← فلا يُقطع لك بالجنة","cause":"تكلَّم فيما لا يعنيه أو بخِلَ بما لا ينقصُه","result":"أبشرْ بالجنةِ فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ أولا تدرِي","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-05035"],"ref":"كشف المناهج والتناقيح 4/245","srcLabel":"الترمذي","text":["تُوفِّيَ رجلٌ من الصحابةِ فقال رجلٌ ",["أبشرْ بالجنةِ فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ أولا تدرِي",2]," فلعلَّه ",["تكلَّم فيما لا يعنيه أو بخِلَ بما لا ينقصُه",1]],"grade":"صحيح","muhaddith":"رجاله رجال الصحيحين إلا شيخ الترمذي وهو سليمان بن عبد الجبار البغدادي فإنه لم يخرج له من أصحاب السنن غير الترمذي","bab":"إيمان › القطع بدخول أحد الجنة أو النار","dorar":"7vAGu4dT"},{"id":"س-04228","fp":"0ed76f010aba","stateId":773,"easy":"إذا كذبت على النبي ﷺ أو على عينيك أو على والديك ← لم ترح رائحة الجنة","cause":"مَن كذب على نبيِّه أو على عينَيه أو علَى والدَيه","result":"لم يرَحْ رائحةَ الجنةِ","explicit":true,"ref":"مجمع الزوائد 1/153","srcLabel":"مجمع الزوائد","text":[["مَن كذب على نبيِّه أو على عينَيه أو علَى والدَيه ",1],["لم يرَحْ رائحةَ الجنةِ",2]],"grade":"حسن","narrator":"أوس بن أبي أوس وقيل أوس بن أوس والد عمرو","muhaddith":"إسناده حسن","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"io43iCiy"},{"id":"س-05035","fp":"95a996fa6a0a","stateId":773,"easy":"إذا تكلمت فيما لا يعنيك أو منعت ما لا ينقصك ← فلا يُشهد لك بالجنة","cause":"تكلَّم فيما لا يعنيهِ أو منعَ ما لا ينقصُه","result":"وما عِلمُكم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-02720","ref":"مسند عمر 1/107","text":["قبض رجلٌ من أصحابِ رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ فقالوا هنيئًا لك الجنةُ فقال النبيُّ صلَّى اللهُ عليهِ وسلَّمَ ",["وما عِلمُكم",2]," لعله قد ",["تكلَّم فيما لا يعنيهِ أو منعَ ما لا ينقصُه",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (2316)، والبزار (7557) بنحوه، والطبري في ((مسند عمر)) (178) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"z58Xsw4a"},{"id":"س-05051","fp":"5433bdef53b6","stateId":774,"easy":"إذا أتيت ذات محرم ← لا تدخل الجنة","cause":"مَن أتَى ذاتَ محرمٍ","result":"لا يدخلُ الجنةَ","explicit":true,"ref":"مجمع الزوائد 6/272","srcLabel":"الطبراني","text":[["لا يدخلُ الجنةَ",2],[" مَن أتَى ذاتَ محرمٍ",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"رجاله رجال الصحيح غير يحيى بن حسان الكوفي وهو ثقة","takhrij":"أخرجه الطبراني (11/57) (11031) باختلاف يسير، والدارقطني في ((الأفراد)) كما في ((أطراف الغرائب والأفراد)) لابن طاهر المقدسي (3/333)، وأبو نعيم في ((حلية الأولياء)) (4/72) واللفظ لهما","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"efWyWtN2"},{"id":"س-04792","fp":"b320410d554b","stateId":774,"easy":"إذا كنت شيخاً زانياً أو إماماً كذاباً ← لا تدخل الجنة","cause":"الشَّيخُ الزَّاني ، والإمامُ","result":"ثلاثةٌ لا يدخلونَ الجنَّةَ","explicit":true,"ref":"الزواجر عن اقتراف الكبائر 2/195","srcLabel":"الزواجر عن اقتراف الكبائر","text":[["ثلاثةٌ لا يدخلونَ الجنَّةَ ",2],":",[" الشَّيخُ الزَّاني ، والإمامُ",1]," أو قالَ والملِكُ الكذَّابُ والعائلُ المزهوُّ"],"grade":"حسن","muhaddith":"إسناده جيد","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"5SscvEgg"},{"id":"س-05195","fp":"ee8fba265c05","stateId":774,"easy":"إذا نظرت إلى عورة أخيك متعمداً ← لا تلتقيان في الجنة","cause":"النَّاظرُ إلى عورةِ أخيه متعمَّدًا","result":"لا يتلاقيان في الجنَّةِ","explicit":true,"ref":"الكامل في الضعفاء 5/400","srcLabel":"الكامل في الضعفاء","text":[["النَّاظرُ إلى عورةِ أخيه متعمَّدًا",1]," ",["لا يتلاقيان في الجنَّةِ",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"لا أعلم يرويه عن ليث غير عبد الله بن داود وهو ممن لا بأس به","takhrij":"لم نقف عليه إلا عند ابن عدي في الكامل في الضعفاء","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"t9napTqS"},{"id":"س-04831","fp":"a2f95c60a736","stateId":775,"easy":"إذا ادعيت أباً غير أبيك وأنت تعلم ← فالجنة عليك حرام","cause":"مَنِ ادَّعى أبًا في الإسلامِ غيرَ أبيه","result":"يَعلَمُ أنَّه غَيرُ أبيه، فالجَنَّةُ عليه حَرامٌ","explicit":true,"star":true,"similar":["س-08333"],"ref":"صحيح مسلم 63","srcLabel":"البخاري","text":["لَمَّا ادُّعيَ زيادٌ لَقيتُ أبا بَكرةَ، فقُلتُ له: ما هذا الذي صَنَعتُم؟ إنِّي سَمِعتُ سَعدَ بنَ أبي وقَّاصٍ يقولُ: سَمِعَ أُذُنايَ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم وهو يقولُ: ",["مَنِ ادَّعى أبًا في الإسلامِ غيرَ أبيه، ",1],["يَعلَمُ أنَّه غَيرُ أبيه، فالجَنَّةُ عليه حَرامٌ",2],". فقال أبو بَكرةَ: أنا سَمِعتُه مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم."],"grade":"صحيح","narrator":"سعد بن أبي وقاص وأبو بكرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6766)، وأبو داود (5113)، وابن ماجه (2610)، وأحمد (1553) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"qBR8j9dP","merged":2,"otherRefs":["تخريج المسند لشعيب 1504 (صحيح)"]},{"id":"س-08333","fp":"0750c354311f","stateId":775,"easy":"إذا ادعيت إلى أب غير أبيك وأنت تعلم ← فالجنة عليك حرام","cause":"منِ ادَّعى إلى أبٍ غَيرِ أبيهِ وَهوَ يَعلمُ أنَّهُ غيرُ أبيهِ","result":"فالجنَّةُ علَيهِ حرامٌ","explicit":true,"repOf":"س-04831","ref":"تخريج المسند لشاكر 3/53","text":["سَمِعْتُ سعدًا وَهوَ أوَّلُ مَن رَمى بسَهْمٍ في سَبيلِ اللَّهِ وأبا بَكْرةَ تَسوَّرَ حِصنَ الطَّائفِ في ناسٍ فجاءَ إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ - فقالا : سَمِعنا النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ وَهوَ يقولُ : ",["منِ ادَّعى إلى أبٍ غَيرِ أبيهِ وَهوَ يَعلمُ أنَّهُ غيرُ أبيهِ",1]," ",["فالجنَّةُ علَيهِ حرامٌ",2]],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (4326) بلفظه، ومسلم (63)، وأبو داود (5113) كلاهما باختلاف يسير.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"ZbozEE3y"},{"id":"س-03013","fp":"257e909a9fd4","stateId":775,"easy":"إذا انتسبت إلى غير أبيك ← لم ترح رائحة الجنة","cause":"مَن ادَّعَى إلى غيرِ أبيه","result":"لم يرَحْ رائحةَ الجنَّةِ، وإنَّ ريحَها لَيوجَدُ مِن قدْرِ سبعينَ عامًا -أو مَسيرةِ سبعينَ عامًا","explicit":true,"ref":"تخريج المسند لشعيب 6592","srcLabel":"ابن ماجه","text":[["مَن ادَّعَى إلى غيرِ أبيه ",1],["لم يرَحْ رائحةَ الجنَّةِ، وإنَّ ريحَها لَيوجَدُ مِن قدْرِ سبعينَ عامًا -أو مَسيرةِ سبعينَ عامًا",2],". قال: ومَن كذَبَ علَيَّ مُتعمِّدًا فلْيتبَوَّأْ مَقعدَهُ مِن النَّارِ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه ابن ماجه (2611) بنحوه مختصراً، وأحمد (6592) واللفظ له","bab":"إيمان › الوعيد","dorar":"d1fwysKU","merged":2,"otherRefs":["تخريج المسند لشعيب 6834 (صحيح)"]},{"id":"س-07402","fp":"54e631b2cdbc","stateId":776,"easy":"إذا ضربت الناس بالسياط ظلماً أو كنت كاسية عارية ← فأنت من صنفي أهل النار","cause":"قومٌ مَعَهُمْ سِياطٌ كَأَذْنابِ البَقَرِ يَضْرِبُونَ الناسَ بِها ، ونِساءٌ كَاسِياتٌ عَارِياتٌ ، مُمِيلاتٌ مائِلاتٌ ، رُؤوسُهُنَّ كَأَسْنِمَةِ البُخْتِ المائِلَةِ ، لا يَدْخُلَنَّ الجنةَ ، ولا يَجِدَنَّ رِيحَها ، وإِنَّ رِيحَها لَيوجَدُ من مَسِيرَةِ كذا وكذا","result":"صِنْفَانِ من أهلِ النارِ لمْ أَرَهُما بَعْدُ","explicit":true,"star":true,"ref":"صحيح الجامع 3799","srcLabel":"مسلم","text":[["صِنْفَانِ من أهلِ النارِ لمْ أَرَهُما بَعْدُ ",2],":",[" قومٌ مَعَهُمْ سِياطٌ كَأَذْنابِ البَقَرِ يَضْرِبُونَ الناسَ بِها ، ونِساءٌ كَاسِياتٌ عَارِياتٌ ، مُمِيلاتٌ مائِلاتٌ ، رُؤوسُهُنَّ كَأَسْنِمَةِ البُخْتِ المائِلَةِ ، لا يَدْخُلَنَّ الجنةَ ، ولا يَجِدَنَّ رِيحَها ، وإِنَّ رِيحَها لَيوجَدُ من مَسِيرَةِ كذا وكذا",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2128) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"JRFbgv3d","merged":4,"otherRefs":["تخريج المسند لشعيب 9680 (صحيح)","مجموع الفتاوى 34/129 (صحيح)","تخريج صحيح ابن حبان 7461 (صحيح)"]},{"id":"س-07300","fp":"762c940adaa9","stateId":776,"easy":"إذا كنت كاسية في الدنيا (متبرجة) ← تكونين عارية يوم القيامة","cause":"كاسيةٍ في الدُّنيا","result":"عاريةٍ يَومَ القيامةِ","explicit":true,"star":true,"ref":"صحيح البخاري 5844","srcLabel":"متفق عليه","text":["استَيقَظَ النَّبيُّ صلَّى اللهُ عليه وسلَّم مِنَ اللَّيلِ وهو يقولُ: لا إلَهَ إلَّا اللهُ، ماذا أُنزِلَ اللَّيلةَ مِنَ الفِتنةِ؟! ماذا أُنزِلَ مِنَ الخَزائِنِ؟! مَن يوقِظُ صَواحِبَ الحُجُراتِ؟ كَم مِن ",["كاسيةٍ في الدُّنيا",1]," ",["عاريةٍ يَومَ القيامةِ",2],"! قال الزُّهريُّ: وكانَت هِندٌ لَها أزرارٌ في كُمَّيها بينَ أصابِعِها."],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"من أفراد البخاري على مسلم","bab":"فتن › ظهور الفتن","dorar":"maCzCWQh"},{"id":"س-04219","fp":"2d1d4851c391","stateId":776,"easy":"إذا كنت ديوثاً أو مترجّلة أو مدمن خمر ← لا تدخل الجنة","cause":"الدَّيُّوثُ ، والرَّجِلَةُ من النساءِ، ومُدمنُ الخمرِ قالوا : يا رسولَ اللهِ ! أما مُدمنُ الخمرِ فقد عرَفْناه ، فما الدُّيُّوثُ ؟ فقال : الذي لا يُبالي من دخل على أهلِه قُلنا : فما الرَّجِلَةُ من النساءِ . قال : التي تشبَّه بالرِّجالِ","result":"ثلاثةٌ لا يدخلون الجنَّةَ أبدًا","explicit":true,"star":true,"ref":"صحيح الترغيب 2071","srcLabel":"البيهقي","text":[["ثلاثةٌ لا يدخلون الجنَّةَ أبدًا ",2],":",[" الدَّيُّوثُ ، والرَّجِلَةُ من النساءِ، ومُدمنُ الخمرِ قالوا : يا رسولَ اللهِ ! أما مُدمنُ الخمرِ فقد عرَفْناه ، فما الدُّيُّوثُ ؟ فقال : الذي لا يُبالي من دخل على أهلِه قُلنا : فما الرَّجِلَةُ من النساءِ . قال : التي تشبَّه بالرِّجالِ",1]],"grade":"صحيح","narrator":"عمار بن ياسر","muhaddith":"صحيح","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (10800) واللفظ له، وأبو نعيم في ((معرفة الصحابة)) (5209) مختصراً","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"wPsiEnEX","merged":3,"otherRefs":["صحيح الجامع 3062 (صحيح)","المستدرك على الصحيحين 246 (صحيح)"]},{"id":"س-05291","fp":"7a43c1329f1e","stateId":776,"easy":"إذا خضبت لحيتك بالسواد (في آخر الزمان) ← لا تريح رائحة الجنة","cause":"يَخضِبون لحاهم بالسَّوادِ","result":"لا يَدخُلون الجنَّةَ","explicit":true,"star":true,"otherNeedIds":[28],"ref":"لقاء الباب المفتوح 3/ 317","srcLabel":"لقاء الباب المفتوح","text":["إنَّه يأتي في آخِرِ الزَّمانِ أقوامٌ ",["يَخضِبون لحاهم بالسَّوادِ",1]," كخافيةِ الطَّيرِ -أو قال: كخافيةِ الغُرابِ- ",["لا يَدخُلون الجنَّةَ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"0vNvulgs","merged":6,"otherRefs":["الفوائد العلمية من الدروس البازية 5/84 (حسن)","الأحاديث المختارة 10 / 233 (صحيح)","مجمع الزوائد 5/164 (حسن)","هداية الرواة 4/240 (صحيح)","صحيح الترغيب 2097 (صحيح)"]},{"id":"س-01292","fp":"d6ba484e6251","stateId":776,"easy":"إذا عققت والديك أو تشبّهت المرأة بالرجال أو كنت ديوثاً ← لا تدخل الجنة ولا ينظر الله إليك","cause":"ولا ينظُرُ اللهُ إليهم يومَ القيامةِ: العاقُّ والدَيْه، والمرأةُ المُتَرَجِّلَةُ المُتَشَبِّهَةُ بالرِّجالِ، والدَّيُّوثُ. وثلاثةٌ لا ينظُرُ اللهُ إليهم يومَ القيامةِ: العاقُّ والدَيْه، والمُدْمِنُ الخَمْرِ، والمَنَّانُ بما أَعطَى","result":"ثلاثٌ لا يدخُلونَ الجنَّةَ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 11/95","srcLabel":"النسائي","text":[["ثلاثٌ لا يدخُلونَ الجنَّةَ",2],"،",[" ولا ينظُرُ اللهُ إليهم يومَ القيامةِ: العاقُّ والدَيْه، والمرأةُ المُتَرَجِّلَةُ المُتَشَبِّهَةُ بالرِّجالِ، والدَّيُّوثُ. وثلاثةٌ لا ينظُرُ اللهُ إليهم يومَ القيامةِ: العاقُّ والدَيْه، والمُدْمِنُ الخَمْرِ، والمَنَّانُ بما أَعطَى.",1]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (2562)، وأحمد (6180) واللفظ له","bab":"نكاح › الغيرة","dorar":"END8XTRQ"},{"id":"س-04221","fp":"ee1bf58205e1","stateId":776,"easy":"إذا كنتِ كاسية عارية مائلة مميلة ← لا تدخلين الجنة ولا تجدين ريحها","cause":"نساءٌ كاسياتٌ عارياتٌ مائِلاتٌ مميلاتٌ","result":"لا يدخلنَ الجنّةَ ولا يجدنَ ريحَها ، وريحها يوجدُ من مسيرةِ خمسمائةِ سنةٍ","explicit":true,"ref":"التمهيد 13/202","srcLabel":"مالك","text":["عن أبي هريرة أنه قال : ",["نساءٌ كاسياتٌ عارياتٌ مائِلاتٌ مميلاتٌ",1]," ",["لا يدخلنَ الجنّةَ ولا يجدنَ ريحَها ، وريحها يوجدُ من مسيرةِ خمسمائةِ سنةٍ",2]],"grade":"صحيح","narrator":"أبو صالح السمان.","muhaddith":"مرفوع من وجوه صحاح","takhrij":"أخرجه مالك (3370)، والبيهقي في ((شعب الإيمان)) (7413) كلاهما بلفظه.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"EL8GSE6k"},{"id":"س-04919","fp":"8d41359c77ee","stateId":776,"easy":"إذا أدمنت الخمر أو عققت أو أقررت الخبث في أهلك ← حرّم الله عليك الجنة","cause":"مُدمِنُ الخَمْرِ، والعاقُّ والدَّيُّوثُ الَّذي يُقِرُّ في أهْلِه الخُبْثَ","result":"ثَلاثَةٌ قد حَرَّمَ اللهُ تَبارك وتَعالى عليهمُ الجَنَّةَ","explicit":true,"ref":"تخريج المسند لشعيب 6113","srcLabel":"النسائي","text":[["ثَلاثَةٌ قد حَرَّمَ اللهُ تَبارك وتَعالى عليهمُ الجَنَّةَ",2],":",[" مُدمِنُ الخَمْرِ، والعاقُّ والدَّيُّوثُ الَّذي يُقِرُّ في أهْلِه الخُبْثَ.",1]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه النسائي (2562) بنحوه مطولاً، وأحمد (6113) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"cPAx5e5b"},{"id":"س-04248","fp":"7a34c0ecdf9a","stateId":776,"easy":"إذا كنتِ كاسية عارية على رأسك كأسنمة البخت ← لا تجدين رائحة الجنة","cause":"كاسياتٌ عارياتٌ على رُؤوسِهِنَّ كأسْنِمةِ البُّخْتِ","result":"لا يَجِدْنَ رائِحةَ الجَنَّةِ","explicit":true,"ref":"فنون اللباس 125","srcLabel":"فنون اللباس","text":[["كاسياتٌ عارياتٌ على رُؤوسِهِنَّ كأسْنِمةِ البُّخْتِ",1],"، ",["لا يَجِدْنَ رائِحةَ الجَنَّةِ",2],". (الحديث)"],"grade":"حسن","muhaddith":"إسناده حسن","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"MYcsNegN"},{"id":"س-01358","fp":"50d946bfe9c9","stateId":777,"easy":"إذا أسأتِ إلى زوجك ← تُحرمين الجنة مع صلاتك","cause":"لولَا ما يَأتِينَ إلى أزواجِهِنَّ","result":"لَدخَلَ مُصَلِّياتُهنَّ الجنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"المستدرك على الصحيحين 7537","srcLabel":"ابن ماجه","text":["أبصَرَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ امرأةً معها صَبِيَّتانِ قدْ حمَلَتْ إحداهُما وهي تَقودُ الأُخرى، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: والداتٌ حامِلاتٌ رَحيماتٌ، ",["لولَا ما يَأتِينَ إلى أزواجِهِنَّ",1],"، ",["لَدخَلَ مُصَلِّياتُهنَّ الجنَّةَ",2],"."],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"صحيح الإسناد على شرط الشيخين","takhrij":"أخرجه ابن ماجه (2013)، وأحمد (22311) باختلاف يسير.","bab":"نكاح › عشرة النساء","dorar":"y9qI8su8"},{"id":"س-05261","fp":"65b3fbb5fcfc","stateId":777,"easy":"إذا سألتِ زوجك الطلاق في غير كنهه ← لا تجدين ريح الجنة","cause":"لا تَسأَلُ امْرَأةٌ زَوْجَها الطَّلاقَ في غَيْرِ كُنْهِه","result":"فتَجِدَ ريحَ الجنَّةِ، وإنَّ ريحَها ليُوجَدُ مِن مَسيرةِ أرْبَعينَ عامًا","explicit":true,"star":true,"similar":["س-04323"],"ref":"الأحاديث المختارة 11 / 203","srcLabel":"متفق عليه","text":["«",["لا تَسأَلُ امْرَأةٌ زَوْجَها الطَّلاقَ في غَيْرِ كُنْهِه",1]," ",["فتَجِدَ ريحَ الجنَّةِ، وإنَّ ريحَها ليُوجَدُ مِن مَسيرةِ أرْبَعينَ عامًا",2],"»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"BZHRTbbV"},{"id":"س-04323","fp":"222830c3ae2c","stateId":777,"easy":"إذا سألتِ زوجك الطلاق من غير بأس ← حرام عليك رائحة الجنة","cause":"وما مِنِ امرأةٍ تَسْأَلُ زَوْجَها الطَّلاقَ من غَيْرِ بَأْسٍ","result":"فَتَجِدُ رِيحَ الجنةِ","explicit":true,"repOf":"س-05261","ref":"صحيح الترغيب 2018","text":["وَإِنَّ المُخْتَلِعَاتِ والمنتزعاتِ هُنَّ المُنافِقَاتُ ، ",["وما مِنِ امرأةٍ تَسْأَلُ زَوْجَها الطَّلاقَ من غَيْرِ بَأْسٍ",1]," ؛ ",["فَتَجِدُ رِيحَ الجنةِ",2]," ، أوْ قال : رَائِحَةَ الجنةِ"],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2226)، والترمذي (1187)، وابن ماجه (2055)، وأحمد (22379) بنحوه مختصرا.","bab":"جنة › صفة الجنة","dorar":"8MjdGiMv","merged":3,"otherRefs":["صحيح الترغيب 2018 (صحيح)","المستدرك على الصحيحين 2848 (صحيح)"]},{"id":"س-05016","fp":"67e1b0c4f7ff","stateId":778,"easy":"إذا كنت من الفجار ← لا تنزل منازل الأبرار","cause":"الفجارُ","result":"لا ينزلُ الفجارُ منازلَ الأبرارِ","explicit":true,"star":true,"ref":"صحيح الجامع 4576","srcLabel":"ابن حبان","text":["كما لا يُجتنى من الشوكِ العنبُ كذلك ",["لا ينزلُ الفجارُ منازلَ الأبرارِ",2]," ، و هما طريقتان فأيَّهما أخذتُم أدركتُم إليه"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان في ((المجروحين)) (2/297) واللفظ له، وأبو الشيخ في ((أمثال الحديث)) (122)، وأبو نعيم في ((تاريخ أصبهان)) (1/148)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"DSlpZpFT","merged":2,"otherRefs":["صحيح الجامع 4575 (حسن)"]},{"id":"س-03681","fp":"9ab866ce607d","stateId":778,"easy":"إذا عصيت النبي ﷺ ← فقد أبيت دخول الجنة","cause":"و مَنْ عَصانِي","result":"فقد أبى","explicit":true,"star":true,"ref":"السلسلة الصحيحة 2044","srcLabel":"البخاري","text":["و الذي نَفسي بيدِهِ ، لَتَدْخُلُنَّ الجنةَ كلُّكُمْ إلَّا مَنْ أبى ، و شَرَدَ على اللهِ كشرودِ البَعِيرِ ، قالوا : و مَنْ يَأْبَى أنْ يَدْخُلَ الجنةَ ؟ فقال : مَنْ أَطَاعَنِي دخلَ الجنةَ ، ",["و مَنْ عَصانِي",1]," ",["فقد أبى",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه ابن حبان (17)، والطبراني في ((المعجم الأوسط)) (808) باختلاف يسير","bab":"اعتصام بالسنة › لزوم السنة","dorar":"bJhjk0og","merged":2,"otherRefs":["صحيح البخاري 7280 (صحيح)"]},{"id":"س-05015","fp":"6c3bfe254a2d","stateId":778,"easy":"إذا ذُكر النبي ﷺ عندك فنسيت الصلاة عليه ← أخطأت طريق الجنة","cause":"مَن ذُكرتُ عِندَه فَنَسِيَ الصَّلاةَ عليَّ","result":"خَطِىءَ طَريقَ الجنَّةِ","explicit":true,"star":true,"ref":"صحيح الترغيب 1681","srcLabel":"البيهقي","text":[["مَن ذُكرتُ عِندَه فَنَسِيَ الصَّلاةَ عليَّ ؛ ",1],["خَطِىءَ طَريقَ الجنَّةِ",2]],"grade":"صحيح","narrator":"محمد بن علي ابن الحنفية","muhaddith":"صحيح لغيره","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (1573)، وابن أبي شيبة (32453)، والقاضي إسماعيل في ((فضل الصلاة على النبي)) (42) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"h4IMpHZ2","merged":3,"otherRefs":["صحيح الجامع 6245 (صحيح)","صحيح الترغيب 1681 (صحيح)"]},{"id":"س-03482","fp":"850f72d907fc","stateId":778,"easy":"إذا شردت على الله شراد البعير على أهله ← فأنت ممن يأبى دخول الجنة","cause":"مَن شرَد على اللهِ شِرادَ البعيرِ على أهلِه","result":"ألا كلُّكم يدخُلُ الجنَّةَ إلَّا","explicit":true,"ref":"مجمع الزوائد 10/406","srcLabel":"أحمد","text":["أنَّ أبا أُمامةَ مرَّ على خالدِ بنِ يزيدَ بنِ معاويةَ فسأَله عن ألينِ كلمةٍ سمِعها من رسولِ اللهِ صلَّى اللَّهُ عليه وسلَّم قال سمِعْتُ رسولَ اللهِ صلَّى اللَّهُ عليه وسلَّم يقولُ ",["ألا كلُّكم يدخُلُ الجنَّةَ إلَّا",2]," ",["مَن شرَد على اللهِ شِرادَ البعيرِ على أهلِه",1]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"رجاله رجال الصحيح غير علي بن خالد الدؤلي وهو ثقة","takhrij":"أخرجه أحمد (5/ 258) واللفظ له،  والحاكم (1/ 123) و(4/ 276) باختلاف يسير عندهما.","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"UfR9ONHK","merged":2,"otherRefs":["مجمع الزوائد 10/74 (حسن)"]},{"id":"س-04844","fp":"a100d502eabf","stateId":778,"easy":"إذا خالفت أمر الإمام في الجهاد ← فالجنة لا يدخلها عاصٍ","cause":"لا يخرجُ معنا إلا مقوى فخرجَ رجلُ على بكرٍ ضعيفٍ","result":"إن الجنةَ لا يدخلُها عاصٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"فتح الباري لابن حجر 106/6","srcLabel":"سعيد","text":["لما خرج رسولُ اللهِ صلى الله عليه وسلم إلى تبوكَ قال : ",["لا يخرجُ معنا إلا مقوى فخرجَ رجلُ على بكرٍ ضعيفٍ",1]," فوقصَ فماتَ ، فقال الناسُ: الشهيدُ الشهيدُ ، فقال رسولُ الله صلى الله عليه وسلم : يا بلالُ نادِ ",["إن الجنةَ لا يدخلُها عاصٍ",2],"."],"grade":"صحيح","narrator":"مجاهد بن جبر المكي","muhaddith":"إسناده صحيح","takhrij":"أخرجه سعيد بن منصور (1032) واللفظ له.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"qHIB3wai"},{"id":"س-03041","fp":"b1d46f1555fe","stateId":778,"easy":"إذا عصيت ← فالجنة لا تحل لعاصٍ","cause":"لعاصٍ","result":"إنَّ الجنَّةَ لا تَحِلُّ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"المستدرك على الصحيحين 2679","srcLabel":"الحاكم","text":["عنْ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، أنَّه قالَ في مَسيرٍ له: إنَّا مُدْلِجونَ اللَّيلةَ إنْ شاءَ اللهُ، فلا يَرحلَنَّ معنا مُضْعِفٌ، ولا مُصعَبٌ، فارتَحلَ رَجلٌ على ناقةٍ له صَعبةٍ، فسَقَطَ فاندَقَّتْ عُنُقُه، فماتَ، فأَمَرَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ أنْ يُدفَنَ، ثُمَّ أَمَرَ بِلالًا فنادى: ",["إنَّ الجنَّةَ لا تَحِلُّ",2]," ",["لعاصٍ",1],"."],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح الإسناد","bab":"إيمان › الوعيد","dorar":"ESQMyAaa","merged":4,"otherRefs":["تخريج المراسيل لأبي داود 319 (حسن)","سبل الهدى والرشاد 8/376 (حسن)"]},{"id":"س-04947","fp":"3e52ce144e93","stateId":779,"easy":"إذا تعلمت علماً يُبتغى به وجه الله لتصيب به الدنيا ← لم تجد عرف الجنة يوم القيامة","cause":"مَن تَعلَّمَ عِلْمًا ممَّا يُبتَغى به وَجهُ اللهِ عزَّ وجلَّ","result":"لا يَتعَلَّمُه إلَّا لِيُصيبَ به عَرَضًا مِنَ الدُّنيا؛ لم يَجِدْ عَرْفَ الجَنَّةِ يَومَ القيامةِ","explicit":true,"star":true,"ref":"تخريج سنن أبي داود 3664","srcLabel":"أبو داود","text":["قال: قال رَسولُ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ: ",["مَن تَعلَّمَ عِلْمًا ممَّا يُبتَغى به وَجهُ اللهِ عزَّ وجلَّ، ",1],["لا يَتعَلَّمُه إلَّا لِيُصيبَ به عَرَضًا مِنَ الدُّنيا؛ لم يَجِدْ عَرْفَ الجَنَّةِ يَومَ القيامةِ",2],". يَعني: ريحَها."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (3664)، وابن ماجه (252)، وأحمد (8457) جميعا بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"BWp3Etw1"},{"id":"س-05533","fp":"1fa2956a60b2","stateId":779,"easy":"إذا كانت همتك الدنيا ← حرّم الله عليك جوار النبي ﷺ","cause":"ومن كانَت همَّتُهُ الدُّنيا","result":"حرَّمَ اللَّهُ عليهِ جِواري","explicit":true,"otherNeedIds":[57],"ref":"الزواجر عن اقتراف الكبائر 2/116","srcLabel":"الطبراني","text":["يا أيُّها النَّاسُ من ولِيَ عليكُم عملًا فحَجبَ بابَهُ عن ذي حاجةٍ أو قالَ : دونَ حاجةِ المسلِمينَ حجبَهُ اللَّهُ أن يلجَ بابَ الجنَّةِ ، ",["ومن كانَت همَّتُهُ الدُّنيا",1]," ",["حرَّمَ اللَّهُ عليهِ جِواري",2]," فإنِّي بُعِثتُ بخرابِ الدُّنيا ولم أُبعَثْ بعِمارتِها"],"grade":"حسن","muhaddith":"رواته ثقات إلا شيخ الطبراني خيرون","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"TjKuktNP"}]}