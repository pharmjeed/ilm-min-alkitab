{"schema":1,"kind":"sunan-chunk","version":"sunan-2420572879fb","needId":68,"stateIds":[725,726,727,728,729],"items":[{"id":"س-02215","fp":"697cfdf23428","stateId":725,"easy":"إذا كفلت يتيماً ← تكون مع النبي ﷺ في الجنة هكذا (كالسبابة والوسطى)","cause":"وأنا وكافِلُ اليَتيمِ","result":"في الجَنَّةِ هَكَذا، وأشارَ بالسَّبَّابةِ والوُسطى","explicit":true,"star":true,"similar":["س-00500"],"otherNeedIds":[67],"ref":"صحيح البخاري 5304","srcLabel":"متفق عليه","text":[["وأنا وكافِلُ اليَتيمِ",1]," ",["في الجَنَّةِ هَكَذا، وأشارَ بالسَّبَّابةِ والوُسطى",2],"، وفَرَّجَ بينَهما شيئًا."],"grade":"صحيح","narrator":"سهل بن سعد الساعدي","muhaddith":"[صحيح]","takhrij":"من أفراد البخاري على مسلم","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"OwbDID6D","merged":3,"otherRefs":["صحيح البخاري 6005 (صحيح)","تخريج صحيح ابن حبان 460 (صحيح)"]},{"id":"س-02853","fp":"7df14613192c","stateId":725,"easy":"إذا علت جاريتين حتى تبلغا ← تأتي يوم القيامة مع النبي ﷺ كأصابعه المضمومة","cause":"مَن عالَ جاريَتَينِ حتَّى تَبلُغا","result":"جاءَ يَومَ القيامةِ أنا وهو، وضَمَّ أصابِعَه","explicit":true,"star":true,"ref":"صحيح مسلم 2631","srcLabel":"البخاري","text":[["مَن عالَ جاريَتَينِ حتَّى تَبلُغا ",1],["جاءَ يَومَ القيامةِ أنا وهو، وضَمَّ أصابِعَه",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه الطبراني في ((الأوسط)) (557) باختلاف يسير، والترمذي (1914)، والحاكم (7350)، والبخاري في ((الأدب المفرد)) (894) بنحوه.","bab":"إيمان › الوعد","dorar":"WoMN5QAH","merged":2,"otherRefs":["الآداب للبيهقي 46 (صحيح)"]},{"id":"س-00310","fp":"787480dd6cea","stateId":725,"easy":"إذا حسن خلقك ← تكون أحب الناس إلى النبي ﷺ وأقربهم منه مجلساً يوم القيامة","cause":"أحسنُكُم خُلُقًا","result":"بأحبِّكم إليَّ ، وأقربِكم منِّي مجلِسًا يومَ القيامةِ","explicit":true,"star":true,"similar":["س-00327","س-05710"],"otherNeedIds":[23],"ref":"صحيح الأدب المفرد 206","srcLabel":"البخاري","text":["أُخبِرُكُم ",["بأحبِّكم إليَّ ، وأقربِكم منِّي مجلِسًا يومَ القيامةِ",2]," ؟ فسكَت القومُ فأعادها مرَّتينِ أو ثلاثًا ، قال القَومُ : نعَم يا رسولَ اللهِ ! قال : ",["أحسنُكُم خُلُقًا",1]],"grade":"صحيح","narrator":"[جد عمرو بن شعيب]","muhaddith":"صحيح","takhrij":"أخرجه أحمد (6735)، والبخاري في ((الأدب المفرد)) (272).","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"P5Iq8upA"},{"id":"س-00327","fp":"e8786d88dbc9","stateId":725,"easy":"إذا حسنت أخلاقك ← تكون أحب الناس إلى النبي ﷺ وأقربهم منه مجلساً","cause":"أحسَنُكم أخلاقًا","result":"بأحبِّكم إليَّ وأقربِكم منِّي مجلسًا يومَ القيامةِ","explicit":true,"repOf":"س-00310","otherNeedIds":[23],"ref":"صحيح ابن حبان 485","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال في مجلسٍ: ( ألا أُخبِرُكم ",["بأحبِّكم إليَّ وأقربِكم منِّي مجلسًا يومَ القيامةِ",2]," ؟ ) - ثلاثَ مرَّاتٍ يقولُها - قُلْنا: بلى يا رسولَ اللهِ قال: ( ",["أحسَنُكم أخلاقًا",1]," )"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (6735) باختلاف يسير. وأصله في صحيح البخاري (3759)، ومسلم (2321) بنحوه","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"XfBL9CCI"},{"id":"س-00500","fp":"33b592cd8363","stateId":725,"easy":"إذا كفلت يتيماً لك أو لغيرك واتقيت الله ← تكون مع النبي ﷺ في الجنة كهاتين","cause":"أنا وكافلُ اليتيمِ له أو لغيرِه","result":"في الجنَّةِ كهاتَيْن إذا اتَّقَى","explicit":true,"repOf":"س-02215","otherNeedIds":[67],"ref":"التمهيد 16/245","text":[["أنا وكافلُ اليتيمِ له أو لغيرِه",1]," ",["في الجنَّةِ كهاتَيْن إذا اتَّقَى",2]," ، وأشار بإصبعَيْه الوسطَى والَّتي تلي الإبهامَ"],"grade":"صحيح","narrator":"صفوان بن سليم","muhaddith":"روي من وجوه صحاح","takhrij":"أخرجه مالك (3491) واللفظ له.","bab":"آداب عامة › ضرب الأمثال","dorar":"XzLaatTr","merged":5,"otherRefs":["صحيح الترمذي 1918 (صحيح)","صحيح الأدب المفرد 100 (صحيح)","صحيح أبي داود 5150 (صحيح)","صحيح مسلم 2983 (صحيح)"]},{"id":"س-05710","fp":"c4c81eb52735","stateId":725,"easy":"إذا حسنت أخلاقك ← تكون أقرب الناس من النبي ﷺ في الآخرة","cause":"مَحاسِنُكُمْ أَخْلاقًا","result":"إِنَّ أحبَّكُمْ إِلَيَّ أَقْرَبَكُمْ مِنِّي في الآخرةِ","explicit":true,"repOf":"س-00310","otherNeedIds":[23],"ref":"صحيح الترغيب 2663","text":[["إِنَّ أحبَّكُمْ إِلَيَّ أَقْرَبَكُمْ مِنِّي في الآخرةِ",2]," ",["مَحاسِنُكُمْ أَخْلاقًا",1]," ، وإِنَّ أبغضَكُمْ إِلَيَّ وأَبْعَدَكُمْ مِنِّي في الآخرةِ الثَّرْثَارُونَ المُتَفَيْهِقُونَ المُتَشَدِّقُونَ قالوا يا رسولَ اللهِ قد عَلِمْنا الثَّرْثَارُونَ والمُتَشَدِّقُونَ فما المُتَفَيْهِقُونَ قال : المتكبرونَ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"حسن صحيح","takhrij":"أخرجه الترمذي (2018)، وابن المقريء في ((معجمه)) (419)، وأبو الفضل الزهري في ((حديثه)) (708) باختلاف يسير.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"W1kG4fm7","merged":5,"otherRefs":["صحيح ابن حبان 482 (صحيح)","صحيح الترغيب 2897 (صحيح)","صحيح الجامع 1535 (صحيح)","صحيح البخاري 3759 (صحيح)"]},{"id":"س-07435","fp":"faf4558c9cfc","stateId":725,"easy":"إذا لم تصدق الظلمة بكذبهم ولم تمالئهم ← فأنت من النبي ﷺ وهو منك","cause":"ومَن لم يُصدِّقْهم بكَذِبِهم، ولم يُمالِئْهم على ظُلمِهم","result":"فهو منِّي، وأنا منه","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 18353","srcLabel":"أحمد","text":["خَرَجَ علينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، ونحن في المسجدِ بعدَ صَلاةِ العِشاءِ، رَفَعَ بَصرَه إلى السَّماءِ، ثُمَّ خَفَضَ، حتى ظَنَنَّا أنَّه قد حَدَثَ في السَّماءِ شيءٌ، فقال: ألَا إنَّه سيَكونُ بعدي أُمَراءُ يَكذِبونَ ويَظلِمونَ، فمَن صَدَّقَهم بكَذِبِهم، ومالَأَهم على ظُلمِه؛ فليس منِّي، ولا أنا منه، ",["ومَن لم يُصدِّقْهم بكَذِبِهم، ولم يُمالِئْهم على ظُلمِهم",1],"؛ ",["فهو منِّي، وأنا منه",2],"، ألَا وإنَّ دَمَ المُسلمِ كفَّارتُه، ألَا وإنَّ سُبحانَ اللهِ، والحَمدُ للهِ، ولا إلهَ إلَّا اللهُ، واللهُ أكبرُ هنَّ الباقياتُ الصَّالحاتُ."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (18353)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"xakRCxUz","merged":2,"otherRefs":["صحيح ابن حبان 286 (صحيح)"]},{"id":"س-01484","fp":"7a5a5bc39a9d","stateId":725,"easy":"إذا وقّرت الكبير ورحمت الصغير ← ترافق النبي ﷺ في الجنة","cause":"ووقِّرِ الكبيرَ، وارحَمِ الصَّغيرَ","result":"تُرافِقْني في الجنَّةِ","explicit":true,"ref":"الضعفاء الكبير 1/148","srcLabel":"البزار","text":["يا أَنَسُ، أسبِغِ الوضوءَ يَزِدْ في عُمُرِكَ، وصَلِّ مِن اللَّيلِ والنَّهارِ ما استطَعْتَ يُحِبَّكَ الحَفَظَةُ، وصَلِّ صلاةَ الضُّحى؛ فإنَّها صلاةُ الأوَّابينَ، فإنِ استطَعْتَ ألَّا تنامَ إلَّا على طهارةٍ، فإنَّكَ إن مِتَّ مِتَّ شهيدًا، وسلِّمْ على أهلِ بيتِكَ يكثُرْ خيرُ بيتِكَ، ",["ووقِّرِ الكبيرَ، وارحَمِ الصَّغيرَ",1],"، ",["تُرافِقْني في الجنَّةِ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"ليس لهذا المتن عن أنس إسناد صحيح","takhrij":"أخرجه البزار (7396)، وأبو يعلى (4183)، والعقيلي في ((الضعفاء الكبير)) (1/148) واللفظ له","bab":"وضوء › فضل الوضوء","dorar":"CfQ83tTb"},{"id":"س-01946","fp":"ec84a4d88a1a","stateId":725,"easy":"إذا اتقيت الله ← تكون من أولى الناس بالنبي ﷺ","cause":"المتَّقونَ","result":"أَوْلى النَّاسِ بي","explicit":true,"ref":"صحيح ابن حبان 647","srcLabel":"أحمد","text":["لمَّا بعَثه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم إلى اليَمنِ خرَج معه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم يوصِّيه - معاذٌ راكبٌ ورسولُ اللهِ صلَّى اللهُ عليه وسلَّم تحتَ راحلتِه - فلمَّا فرَغ قال : ( يا معاذُ إنَّك عسى ألَّا تَلقاني بعدَ عامي هذا لعلَّك أنْ تمُرَّ بمسجدي وقبري ) فبكى معاذٌ خَشَعًا لفِراقِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم ثمَّ التفَت صلَّى اللهُ عليه وسلَّم نحوَ المدينةِ فقال : ( إنَّ أهلَ بيتي هؤلاءِ يرَوْنَ أنَّهم ",["أَوْلى النَّاسِ بي",2]," وإنَّ أَوْلى النَّاسِ بي ",["المتَّقونَ",1]," مَن كانوا وحيث كانوا اللَّهمَّ إنِّي لا أُحِلُّ لهم فسادَ ما أصلَحْتَ وايمُ اللهِ لَيَكفَؤونَ أمَّتي عن دِينِها كما يُكفَأُ الإناءُ في البَطحاءِ )"],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الطبراني في ((مسند الشاميين)) (991) واللفظ له، وأحمد (22052)، وابن أبي عاصم في ((الآحاد والمثاني)) (1837) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"QkAmM8Be"},{"id":"س-04261","fp":"8039fee697b9","stateId":725,"easy":"إذا كان لك ثلاث بنات أو أخوات فاتقيت الله فيهن ← تكون مع النبي ﷺ في الجنة هكذا","cause":"من كنَّ له ثلاثُ بناتٍ ، أو ثلاثُ أخواتٍ ، فاتَّقى اللهَ و أقام عليهنَّ","result":"كان معي في الجنةِ هكذا ، و أومأَ بالسبابةِ و الوسطى","explicit":true,"otherNeedIds":[67],"ref":"السلسلة الصحيحة 295","srcLabel":"أحمد","text":[["من كنَّ له ثلاثُ بناتٍ ، أو ثلاثُ أخواتٍ ، فاتَّقى اللهَ و أقام عليهنَّ ",1],["كان معي في الجنةِ هكذا ، و أومأَ بالسبابةِ و الوسطى",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح رجاله ثقات","takhrij":"أخرجه أحمد (12593)، وأبو يعلى (3448)، والطبراني في ((المعجم الأوسط)) (5432) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"3LUi63wd"},{"id":"س-03781","fp":"03cdc1649c85","stateId":725,"easy":"إذا حبست المرأة نفسها على أيتامها بعد زوجها ← تكون مع النبي ﷺ في الجنة كهاتين","cause":"امْرأةٌ ذاتُ مَنصِبٍ وجَمالٍ آمَتْ مِن زَوْجِها، حَبَسَتْ نَفْسَها على أيْتامِها حتى بانوا أو ماتوا","result":"أنا وامْرأةٌ سَفْعاءُ الخَدَّينِ كَهاتَينِ يَومَ القِيامةِ","explicit":true,"otherNeedIds":[67,37],"ref":"تخريج المسند لشعيب 24006","srcLabel":"أبو داود","text":[["أنا وامْرأةٌ سَفْعاءُ الخَدَّينِ كَهاتَينِ يَومَ القِيامةِ",2],"، وجَمَعَ بَينَ إصْبَعَيِه السَّبَّابةِ والوُسْطى، ",["امْرأةٌ ذاتُ مَنصِبٍ وجَمالٍ آمَتْ مِن زَوْجِها، حَبَسَتْ نَفْسَها على أيْتامِها حتى بانوا أو ماتوا",1],"."],"grade":"حسن","narrator":"عوف بن مالك الأشجعي","muhaddith":"حسن لغيره إن شاء الله","takhrij":"أخرجه أبو داود (5149)، وأحمد (24006) واللفظ له","bab":"بر وصلة › إعالة اليتيم والضعيف وفضلها","dorar":"IBd4IcZH","merged":3,"otherRefs":["تخريج المسند لشعيب 24008 (حسن)","تخريج سنن أبي داود 5149 (حسن)"]},{"id":"س-05602","fp":"a2c8c8b7fbf7","stateId":725,"easy":"إذا اكتفيت من الدنيا بزاد الراكب ← تلحقين بالنبي ﷺ","cause":"فليَكْفِكِ منَ الدُّنيا كزادِ الرَّاكبِ، لا تَستَخلِقي ثَوبًا حتَّى تُرَقِّعيه، وإيَّاكِ ومُجالَسةَ الأغنِياءِ","result":"إنْ أرَدتِ اللُّحوقَ بي","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 8080","srcLabel":"الحاكم","text":["قالَ لي رَسولُ الله صلَّى اللهُ عليه وسلَّمَ: يا عائشةُ، ",["إنْ أرَدتِ اللُّحوقَ بي",2],"، ",["فليَكْفِكِ منَ الدُّنيا كزادِ الرَّاكبِ، لا تَستَخلِقي ثَوبًا حتَّى تُرَقِّعيه، وإيَّاكِ ومُجالَسةَ الأغنِياءِ",1],"."],"grade":"صحيح","narrator":"عائشة","muhaddith":"صحيح الإسناد","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"PXpuDfP5","merged":2,"otherRefs":["معجم الشيوخ 1/258 (حسن)"]},{"id":"س-04758","fp":"40541570efc9","stateId":725,"easy":"إذا أحببت آل النبي ﷺ لله ← تكون معه يوم القيامة كهاتين","cause":"مَن أحَبَّنا للَّهِ","result":"كُنَّا نَحنُ وهو يَومَ القيامةِ كَهاتَينِ","explicit":true,"ref":"سبل الهدى والرشاد 11/58","srcLabel":"سبل الهدى والرشاد","text":["عنِ الحُسَينِ بنِ عَليٍّ رَضيَ اللهُ تَعالى عنهُما، قال: مَن أحَبَّنا للدُّنيا فإِنَّ صاحِبَ الدُّنيا يُحِبُّه البَرُّ والفاجِرُ، و",["مَن أحَبَّنا للَّهِ",1]," ",["كُنَّا نَحنُ وهو يَومَ القيامةِ كَهاتَينِ",2],"، وأشارَ بإِصبَعَيه السَّبَّابةِ والوُسطى"],"grade":"حسن","narrator":"الحسين بن علي","muhaddith":"إسناده لا بأس به","bab":"رقائق وزهد › الإخلاص","dorar":"G2uladJf"},{"id":"س-05591","fp":"571feb3e4253","stateId":725,"easy":"إذا خرجت من الدنيا كهيئتك يوم تركك النبي ﷺ ← تكون أقرب الناس منه يوم القيامة","cause":"من خرجَ منَ الدُّنيا كهيئتِهِ يومَ تركتُهُ","result":"إنَّ أقربَكم منِّي يومَ القيامةِ","explicit":true,"ref":"در السحابة 359","srcLabel":"أحمد","text":["إنِّي لأقربُكُم يومَ القيامَةِ من رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ إنِّي سمعتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ ",["إنَّ أقربَكم منِّي يومَ القيامةِ",2]," ",["من خرجَ منَ الدُّنيا كهيئتِهِ يومَ تركتُهُ",1]," وإنَّهُ واللَّهِ ما منكم من أحدٍ إلَّا وقد تشبَّثَ منها بشيءٍ غيري"],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"إسناده رجاله ثقات","takhrij":"أخرجه أحمد (21458) بلفظه، والطبراني (2/ 149)، (1627)، والبيهقي في ((شعب الإيمان)) (9920) كلاهما باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"OAJ4USbw"},{"id":"س-07552","fp":"ad631eb48433","stateId":725,"easy":"إذا أكثرت الصلاة على النبي ﷺ ← تكون أقرب الناس منه منزلة","cause":"فمَن كان أكثَرَهم عليَّ صَلاةً","result":"كان أقرَبَ مِنِّي مَنزِلةً","explicit":true,"ref":"سبل الهدى والرشاد 12/444","srcLabel":"البيهقي","text":["«أكثِروا مِنَ الصَّلاةِ عليَّ في كُلِّ يَومِ جُمعةٍ؛ فإنَّ صَلاةَ أُمَّتي تُعرَضُ عليَّ في كُلِّ يَومِ جُمعةٍ، ",["فمَن كان أكثَرَهم عليَّ صَلاةً ",1],["كان أقرَبَ مِنِّي مَنزِلةً»",2]],"grade":"حسن","narrator":"أبو أمامة","muhaddith":"إسناده حسن لا بأس به.","takhrij":"أخرجه البيهقي (6062)، وابن حجر في ((زهر الفردوس)) (85) واللفظ لهما.","bab":"فضائل النبي وصفته ودلائل النبوة › خصائصه صلى الله عليه وسلم","dorar":"R7m2vVp9"},{"id":"س-04170","fp":"274b32cce4e2","stateId":725,"easy":"إذا قعدتِ على أيتامك ← تبادرين النبي ﷺ إلى الجنة","cause":"أنا امرأةٌ قعَدْتُ على أيتامٍ لي","result":"امرأةً تُبادِرُني","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[37],"ref":"الزواجر عن اقتراف الكبائر 1/252","srcLabel":"الزواجر عن اقتراف الكبائر","text":["أنا أوَّلُ مَن يَفْتَحُ بابَ الجنَّةِ، إلَّا أنِّي أرى ",["امرأةً تُبادِرُني",2],"، فأقولُ: ما لَكِ؟ ومَن أنتِ؟ تقولُ: ",["أنا امرأةٌ قعَدْتُ على أيتامٍ لي",1],"."],"grade":"حسن","muhaddith":"إسناده حسن","bab":"جنة › أبواب الجنة","dorar":"EVsY97PP"},{"id":"س-03351","fp":"1b1d0f9f8649","stateId":725,"easy":"إذا أردت أن تلقى النبي ﷺ ← فأكثر السجود","cause":"فأَكثِرِ السُّجودَ","result":"إنْ أَرَدْتَ أنْ تَلْقاني","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"الفتح الرباني 5/2646","srcLabel":"ابن ماجه","text":["قلتُ: يا رسولَ اللهِ، أَخبِرْني بعمَلٍ أَستَقيمُ عليه وأعمَلُ، قال: عليكَ بالسُّجودِ؛ فإنَّهُ لا تسجُدُ للهِ سَجدةً إلَّا رفَعَكَ اللهُ بها درجةً، وحَطَّ عنكَ بها خطيئةً. ولَفْظُ أحمدَ أنَّه قال له: يا أبا فاطمةَ، ",["إنْ أَرَدْتَ أنْ تَلْقاني",2]," ",["فأَكثِرِ السُّجودَ",1],"."],"grade":"حسن","narrator":"أبو فاطمة الإيادي","muhaddith":"إسناده جيد","takhrij":"أخرجه ابن ماجه (1422)، وأحمد (15527) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"jWKY6ADA"},{"id":"س-04387","fp":"0bec6a1ba44f","stateId":725,"easy":"إذا لم تعمل الكبائر وأقمت الصلاة وآتيت الزكاة ← تكون مع النبي ﷺ في الجنة","cause":"لا يَموتُ رجُلٌ لم يَعمَلْ هذه الكبائرَ، ويُقيمُ الصَّلاةَ، ويُؤتِي الزَّكاةَ","result":"إلَّا كانَ معَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ في دارٍ أبوابُها مَصاريعُ مِن ذَهَبٍ","explicit":true,"ref":"المستدرك على الصحيحين 7875","srcLabel":"البيهقي","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال في حَجَّةِ الوداعِ: ألَا إنَّ أولياءَ اللهِ المُصلُّونَ، مَن يُقيمُ الصَّلاةَ الخمْسَ الَّتي كُتِبْنَ عليهِ، ويَصومُ رمَضانَ يَحتسِبُ صَوْمَه، يَرى أنَّه عليه حَقٌّ، ويُعطِي زكاةَ مالِه يَحتسِبُها، ويَجتنِبُ الكبائرَ الَّتي نَهى اللهُ عنها.\n ثمَّ إنَّ رجُلًا سَألَه، فقالَ: يا رسولَ اللهِ، ما الكبائرُ؟ فقالَ: هي تِسعٌ: إشراكٌ باللهِ، وقتلُ نفْسِ المؤمنِ بغيرِ حَقٍّ، وفِرارُ يومِ الزَّحْفِ، وأكْلُ مالِ اليتيمِ، وأكلُ الرِّبا، وقذْفُ المُحصَنةِ، وعقوقُ الوالِدَيْنِ المُسلِمَيْنِ، واستحلالُ البيتِ الحرامِ قبْلتِكُم أحياءً وأمواتًا، ثمَّ قالَ: ",["لا يَموتُ رجُلٌ لم يَعمَلْ هذه الكبائرَ، ويُقيمُ الصَّلاةَ، ويُؤتِي الزَّكاةَ؛",1]," ",["إلَّا كانَ معَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ في دارٍ أبوابُها مَصاريعُ مِن ذَهَبٍ",2],"."],"grade":"صحيح","narrator":"عمير","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي (6804)، والطحاوي في ((شرح مشكل الآثار)) (898)، واللالكائي في ((شرح أصول الاعتقاد)) (1913) جميعا باختلاف يسير.","bab":"جهاد › التولي والفرار من الزحف","dorar":"4leoYzs5","merged":3,"otherRefs":["تخريج مشكل الآثار 898 (حسن)","مشارع الأشواق 969 (حسن)"]},{"id":"س-04326","fp":"e24268faef33","stateId":726,"easy":"إذا سألت الله فاسأله الفردوس ← فهو وسط الجنة وأعلاها وفوقه عرش الرحمن","cause":"فإذا سألتم الله فسلوه الفردوس","result":"فإنه وسط الجنة، وأعلى الجنة، وفوقه عرش الرحمن ومنه يفجر، أو تفجر أنهار الجنة","explicit":true,"star":true,"similar":["س-04324","س-04335"],"otherNeedIds":[67],"ref":"تخريج المسند لشعيب 8420","srcLabel":"البخاري","text":["تَفَجَّرُ أنهارُ الجنَّةِ، وقال: أفلا نُنَبِّئُ الناسَ بذلك؟ قال: ثمَّ حدَّثَنا به فلَم يشُكَّ -يعني فُلَيْحًا- قال عطاءُ بنُ يَسارٍ.\n\nفذكر الحديث [أي حديث: من آمن بالله ورسوله، وأقام الصلاة، وصام رمضان، فإن حقا على الله أن يدخله الجنة، هاجر في سبيل الله، أو جلس في أرضه التي ولد فيها \" قالوا: يا رسول الله، أفلا نخبر الناس\nقال: \" إن في الجنة مائة درجة أعدها الله للمجاهدين في سبيله، بين كل درجتين كما بين السماء والأرض، ",["فإذا سألتم الله فسلوه الفردوس، ",1],["فإنه وسط الجنة، وأعلى الجنة، وفوقه  عرش الرحمن ومنه يفجر، أو تفجر أنهار الجنة ",2],"\" شك أبو عامر]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (7423) باختلاف يسير","bab":"جنة › صفة الجنة","dorar":"6xoQ0dTi","merged":9,"otherRefs":["تخريج كتاب السنة 581 (صحيح)","صحيح الجامع 3429 (صحيح)","الاستقامة 1/215 (صحيح)","تخريج المسند لشعيب 22738 (صحيح)","الأحاديث المختارة 8 / 328 (صحيح)","صحيح ابن ماجه 3512 (صحيح)","تخريج المسند لشعيب 22087 (صحيح)","صحيح الترمذي 2530 (صحيح)"]},{"id":"س-04318","fp":"0f699b3001b6","stateId":726,"easy":"إذا أطبت الكلام وأطعمت الطعام وبتّ قائماً والناس نيام ← لك غرف في الجنة يُرى ظاهرها من باطنها","cause":"لِمَنْ أَطَابَ الكَلامَ ، و أَطْعَمَ الطَّعَامَ ، و باتَ قائِمًا و الناسُ نِيامٌ","result":"إِنَّ في الجنةِ غُرَفًا","explicit":true,"star":true,"similar":["س-00117"],"otherNeedIds":[67],"ref":"صحيح الترغيب 946","srcLabel":"أحمد","text":[["إِنَّ في الجنةِ غُرَفًا",2]," يُرَى ظَاهِرُها من باطِنِها ، و باطِنُها من ظَاهِرِها . فقال أبو مالِكٍ الأَشْعَرِيُّ : لِمَنْ هيَ يا رسولَ اللهِ ؟ قال : ",["لِمَنْ أَطَابَ الكَلامَ ، و أَطْعَمَ الطَّعَامَ ، و باتَ قائِمًا و الناسُ نِيامٌ",1]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه أحمد (6615)، والطبراني (14/80) (14687)، والحاكم (1200) واللفظ له","bab":"جنة › صفة أهل الجنة","dorar":"7ts8GecG","merged":7,"otherRefs":["تخريج العواصم والقواصم 9/ 114 (صحيح)","صحيح الترغيب 617 (صحيح)","تخريج المسند لشعيب 1338 (حسن)","صحيح الترمذي 2527 (حسن)","مجمع الزوائد 2/257 (حسن)","التنوير شرح الجامع الصغير 4/19 (صحيح)"]},{"id":"ق-0742","fp":"d992376f826f","stateId":726,"easy":"الإيمان والعمل الصالح ← جنات الفردوس نُزلاً","cause":"الإيمان والعمل الصالح","result":"جنات الفردوس نُزلاً","explicit":true,"star":true,"ref":"سورة الكهف: 107","srcLabel":"القرآن الكريم","quran":{"s":18,"from":107,"to":107,"text":"إِنَّ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ كَانَتْ لَهُمْ جَنَّاتُ الْفِرْدَوْسِ نُزُلًا (107)","hl":[[0,94,1]]}},{"id":"ق-0881","fp":"f232eed4325f","stateId":726,"easy":"صفات عباد الرحمن: التواضع والحلم وقيام الليل والخوف من النار والاقتصاد وترك الشرك والقتل والزنا والزور واللغو والتذكر بالآيات والدعاء بصلاح الأهل ← الغرفة بما صبروا وتحية وسلام وخلود","cause":"صفات عباد الرحمن: التواضع والحلم وقيام الليل والخوف من النار والاقتصاد وترك الشرك والقتل والزنا والزور واللغو والتذكر بالآيات والدعاء بصلاح الأهل","result":"الغرفة بما صبروا وتحية وسلام وخلود","explicit":true,"star":true,"apply":{"k":"time","t":"في الليل"},"otherNeedIds":[67],"ref":"سورة الفرقان: 63–76","srcLabel":"القرآن الكريم","quran":{"s":25,"from":63,"to":76,"text":"وَعِبَادُ الرَّحْمَنِ الَّذِينَ يَمْشُونَ عَلَى الْأَرْضِ هَوْنًا وَإِذَا خَاطَبَهُمُ الْجَاهِلُونَ قَالُوا سَلَامًا (63) وَالَّذِينَ يَبِيتُونَ لِرَبِّهِمْ سُجَّدًا وَقِيَامًا (64) وَالَّذِينَ يَقُولُونَ رَبَّنَا اصْرِفْ عَنَّا عَذَابَ جَهَنَّمَ إِنَّ عَذَابَهَا كَانَ غَرَامًا (65) إِنَّهَا سَاءَتْ مُسْتَقَرًّا وَمُقَامًا (66) وَالَّذِينَ إِذَا أَنْفَقُوا لَمْ يُسْرِفُوا وَلَمْ يَقْتُرُوا وَكَانَ بَيْنَ ذَلِكَ قَوَامًا (67) وَالَّذِينَ لَا يَدْعُونَ مَعَ اللَّهِ إِلَهًا آخَرَ وَلَا يَقْتُلُونَ النَّفْسَ الَّتِي حَرَّمَ اللَّهُ إِلَّا بِالْحَقِّ وَلَا يَزْنُونَ وَمَنْ يَفْعَلْ ذَلِكَ يَلْقَ أَثَامًا (68) يُضَاعَفْ لَهُ الْعَذَابُ يَوْمَ الْقِيَامَةِ وَيَخْلُدْ فِيهِ مُهَانًا (69) إِلَّا مَنْ تَابَ وَآمَنَ وَعَمِلَ عَمَلًا صَالِحًا فَأُولَئِكَ يُبَدِّلُ اللَّهُ سَيِّئَاتِهِمْ حَسَنَاتٍ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا (70) وَمَنْ تَابَ وَعَمِلَ صَالِحًا فَإِنَّهُ يَتُوبُ إِلَى اللَّهِ مَتَابًا (71) وَالَّذِينَ لَا يَشْهَدُونَ الزُّورَ وَإِذَا مَرُّوا بِاللَّغْوِ مَرُّوا كِرَامًا (72) وَالَّذِينَ إِذَا ذُكِّرُوا بِآيَاتِ رَبِّهِمْ لَمْ يَخِرُّوا عَلَيْهَا صُمًّا وَعُمْيَانًا (73) وَالَّذِينَ يَقُولُونَ رَبَّنَا هَبْ لَنَا مِنْ أَزْوَاجِنَا وَذُرِّيَّاتِنَا قُرَّةَ أَعْيُنٍ وَاجْعَلْنَا لِلْمُتَّقِينَ إِمَامًا (74) أُولَئِكَ يُجْزَوْنَ الْغُرْفَةَ بِمَا صَبَرُوا وَيُلَقَّوْنَ فِيهَا تَحِيَّةً وَسَلَامًا (75) خَالِدِينَ فِيهَا حَسُنَتْ مُسْتَقَرًّا وَمُقَامًا (76)","hl":[[0,324,1]]}},{"id":"ق-0950","fp":"62f8bbeb6e2c","stateId":726,"easy":"الإيمان والعمل الصالح والصبر والتوكل ← غرف من الجنة ونعم أجر العاملين","cause":"الإيمان والعمل الصالح والصبر والتوكل","result":"غرف من الجنة ونعم أجر العاملين","explicit":true,"otherNeedIds":[67],"ref":"سورة العنكبوت: 58–59","srcLabel":"القرآن الكريم","quran":{"s":29,"from":58,"to":59,"text":"وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَنُبَوِّئَنَّهُمْ مِنَ الْجَنَّةِ غُرَفًا تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا نِعْمَ أَجْرُ الْعَامِلِينَ (58) الَّذِينَ صَبَرُوا وَعَلَى رَبِّهِمْ يَتَوَكَّلُونَ (59)","hl":[[0,226,1]]}},{"id":"ق-1080","fp":"8538bfe16292","stateId":726,"easy":"التقوى ← غرف من فوقها غرف مبنية","cause":"التقوى","result":"غرف من فوقها غرف مبنية","explicit":true,"ref":"سورة الزمر: 20","srcLabel":"القرآن الكريم","quran":{"s":39,"from":20,"to":20,"text":"لَكِنِ الَّذِينَ اتَّقَوْا رَبَّهُمْ لَهُمْ غُرَفٌ مِنْ فَوْقِهَا غُرَفٌ مَبْنِيَّةٌ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ وَعْدَ اللَّهِ لَا يُخْلِفُ اللَّهُ الْمِيعَادَ (20)","hl":[[7,168,1]]}},{"id":"ق-1289","fp":"c8f51a6ce8c2","stateId":726,"easy":"السبق إلى الخيرات ← القرب من الله في جنات النعيم","cause":"السبق إلى الخيرات","result":"القرب من الله في جنات النعيم","explicit":true,"ref":"سورة الواقعة: 10–12","srcLabel":"القرآن الكريم","quran":{"s":56,"from":10,"to":12,"text":"وَالسَّابِقُونَ السَّابِقُونَ (10) أُولَئِكَ الْمُقَرَّبُونَ (11) فِي جَنَّاتِ النَّعِيمِ (12)","hl":[[0,89,1]]}},{"id":"س-04313","fp":"1ec81d47e0e8","stateId":726,"easy":"إذا كنت صاحب القرآن ← يقال لك: اقرأ وارقَ ورتّل، فمنزلتك عند آخر آية تقرؤها","cause":"لصاحِبِ القُرْآنِ","result":"اقْرَأْ وارْتَقِ ورَتِّلْ كما كنْتَ تُرَتِّلُ في الدُّنْيا؛ فإنَّ مَنزِلَك عنْدَ آخِرِ آيةٍ تَقرَؤُها","explicit":true,"otherNeedIds":[47],"ref":"الأحكام الوسطى 4/ 333","srcLabel":"الأحكام الوسطى","text":["\"يُقالُ ",["لصاحِبِ القُرْآنِ",1],": ",["اقْرَأْ وارْتَقِ ورَتِّلْ كما كنْتَ تُرَتِّلُ في الدُّنْيا؛ فإنَّ مَنزِلَك عنْدَ آخِرِ آيةٍ تَقرَؤُها",2],"\".\n وعنه قالَ: قالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: \"لا يَفقَهُ مَن قَرَأَ القُرْآنَ في أَقَلَّ مِن ثَلاثٍ\"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","bab":"جنة › درجات الجنة","dorar":"NAKDXPA4","merged":5,"otherRefs":["صحيح ابن حبان 766 (صحيح)","تخريج المسند لشعيب 11360 (صحيح)","مجمع الزوائد 7/165 (صحيح)","السلسلة الصحيحة 2240 (حسن)"]},{"id":"س-06828","fp":"782fc8a29a5a","stateId":726,"easy":"إذا ثبتّ في الصف ولم تلتفت حتى قُتلت ← تنطلق في الغرف العلا من الجنة","cause":"الذين إن يُلْقُوا في الصفِّ لا يَلفِتون وجوهَهم حتى يُقتَلوا","result":"أولئك يَنطلِقون في الغُرَفِ العُلا من الجنَّةِ ، ويضحكُ إليهم ربُّهم ، وإذا ضحِك ربُّك إلى عبدٍ في الدنيا فلا حسابَ عليه","explicit":true,"otherNeedIds":[65,45,23],"ref":"صحيح الترغيب 1371","srcLabel":"أحمد","text":["أنَّ رجلًا سأل أيُّ الشهداءِ أفضلُ قال : ",["الذين إن يُلْقُوا في الصفِّ لا يَلفِتون وجوهَهم حتى يُقتَلوا",1]," ، ",["أولئك يَنطلِقون في الغُرَفِ العُلا من الجنَّةِ ، ويضحكُ إليهم ربُّهم ، وإذا ضحِك ربُّك إلى عبدٍ في الدنيا فلا حسابَ عليه",2]," ."],"grade":"صحيح","narrator":"نعيم بن همار الغطفاني","muhaddith":"صحيح","takhrij":"أخرجه أحمد (22476)، وأبو يعلى (6855)، والطبراني في ((الأوسط)) (3169) باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"9gSXQ8Dt","merged":5,"otherRefs":["صحيح الجامع 1107 (صحيح)","تخريج زاد المعاد 3/84 (صحيح)","صحيح الجامع 3740 (صحيح)","صحيح الترغيب 1372 (صحيح)"]},{"id":"س-04312","fp":"48b4a65bc42a","stateId":726,"easy":"إذا استغفر لك ولدك ← ترتفع درجتك في الجنة","cause":"باستغفارِ ولدِكَ لَكَ","result":"ليرفعُ الدَّرجةَ للعبدِ الصَّالحِ في الجنَّةِ","explicit":true,"similar":["س-02101"],"otherNeedIds":[37,50,47],"ref":"الشفاعة للوادعي 231","srcLabel":"ابن ماجه","text":["إنَّ اللَّهَ عزَّ وجلَّ ",["ليرفعُ الدَّرجةَ للعبدِ الصَّالحِ في الجنَّةِ",2]," فيقولُ: يا ربِّ أنَّى لي هذِهِ؟ فيقالُ: ",["باستغفارِ ولدِكَ لَكَ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (10610) واللفظ له، وأخرجه ابن ماجه بعد حديث (3660) باختلاف يسير","bab":"جنة › درجات الجنة","dorar":"VX86gp6Y","merged":3,"otherRefs":["صحيح الأدب المفرد 27 (حسن)","إتحاف الخيرة المهرة 7/425 (حسن)"]},{"id":"س-00203","fp":"8758beb1d0af","stateId":726,"easy":"إذا حسن خلقك ← لك بيت في أعلى الجنة","cause":"لِمَن حَسُنَ خُلُقُه","result":"وببَيْتٍ في أعلى الجنَّةِ","explicit":true,"similar":["س-00245"],"ref":"مدارج السالكين 3/72","srcLabel":"الطبراني","text":["أنا زعيمٌ ببَيْتٍ في ربَضِ الجنَّةِ لِمَن ترَك المِراءَ وإنْ كان مُحِقًّا، وببَيْتٍ في وسَطِ الجنَّةِ لِمَن ترَك الكذِبَ وإنْ كان مازحًا، ",["وببَيْتٍ في أعلى الجنَّةِ",2]," ",["لِمَن حَسُنَ خُلُقُه",1],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي خيثمة في ((التاريخ الكبير-السفر الثاني)) (3946)، والطبراني في ((المعجم الأوسط)) (878) باختلاف يسير.","bab":"آداب الكلام › المزاح والمداعبة","dorar":"S83ffKYC","merged":2,"otherRefs":["صحيح الجامع 1464 (حسن)"]},{"id":"س-04734","fp":"a11a7aa38ca9","stateId":726,"easy":"إذا ذكرت الله ولو على الفرش الممهدة ← يدخلك الله الدرجات العلى","cause":"لَيذكرنَّ اللهَ عزَّ و جلَّ قومٌ في الدنيا على الفُرُشِ الممَهَّدةِ","result":"يُدخِلُهم الدَّرجاتِ العُلى","explicit":true,"ref":"الجامع الصغير 7542","srcLabel":"ابن حبان","text":[["لَيذكرنَّ اللهَ عزَّ و جلَّ قومٌ في الدنيا على الفُرُشِ الممَهَّدةِ",1]," ، ",["يُدخِلُهم الدَّرجاتِ العُلى",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه أبو يعلى (1110)، وابن حبان (398)، والطبراني في ((الدعاء)) (1860) باختلاف يسير","bab":"رقائق وزهد › الإخلاص","dorar":"XOy2sWcO","merged":2,"otherRefs":["مجمع الزوائد 10/81 (حسن)"]},{"id":"س-00117","fp":"2e742d257c56","stateId":726,"easy":"إذا أفشيت السلام وأطعمت الطعام وأدمت الصيام وصليت بالليل والناس نيام ← لك غرف في الجنة يُرى ظاهرها من باطنها","cause":"لمن أفضَى السَّلامَ وأطعم الطَّعامَ وأدام الصِّيامَ وصلَّى باللَّيلِ والنَّاسُ نِيامٌ","result":"إنَّ في الجنَّةِ غُرَفًا من أصنافِ الجوهرِ كلِّه يُرَى ظاهرُها من باطنِها وباطنُها من ظاهرِها فيها من النَّعيمِ واللَّذَّاتِ والشَّرفِ ما لا عينٌ رأتْ ، ولا أذنٌ سمِعتْ","explicit":true,"repOf":"س-04318","otherNeedIds":[67],"ref":"الترغيب والترهيب 4/371","text":["قال لنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ألا أُحدِّثُكم بغُرَفِ الجنَّةِ ؟ قال : قلتُ : بلَى يا رسولَ اللهِ بأبينا أنت وأمِّنا ، قال : ",["إنَّ في الجنَّةِ غُرَفًا من أصنافِ الجوهرِ كلِّه يُرَى ظاهرُها من باطنِها وباطنُها من ظاهرِها فيها من النَّعيمِ واللَّذَّاتِ والشَّرفِ ما لا عينٌ رأتْ ، ولا أذنٌ سمِعتْ",2]," . قال : قلت لمن هذه الغرفُ ؟ قال : ",["لمن أفضَى السَّلامَ وأطعم الطَّعامَ وأدام الصِّيامَ وصلَّى باللَّيلِ والنَّاسُ نِيامٌ",1]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه تمام في ((الفوائد)) (1448)، وأبو نعيم في ((حلية الأولياء)) (2/356)، والبيهقي في ((البعث والنشور)) (253) مطولا","bab":"آداب السلام › إفشاء السلام","dorar":"h9AkkBfK"},{"id":"س-00245","fp":"cfc0a0dfac2f","stateId":726,"easy":"إذا حسن خلقك ← يُبنى لك بيت في أعلى الجنة","cause":"ومَن حسُنَ خُلقُهُ","result":"بُنيَ لَهُ في أعلاها","explicit":true,"repOf":"س-00203","ref":"الترغيب والترهيب 1/106","text":["مَن ترَكَ المِراءَ وَهو مُبطِلٌ بُنيَ لَهُ بيتٌ في رَبَضِ الجنَّةِ ومَن ترَكَهُ وَهو مُحِقٌّ بُنيَ لَهُ في وسطِها ",["ومَن حسُنَ خُلقُهُ ",1],["بُنيَ لَهُ في أعلاها",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (4800)، والدولابي في ((الكنى والأسماء)) (1887)، والطبراني (8/117) (7488) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"hWG3mAib"},{"id":"س-02101","fp":"8b20a5b2a38f","stateId":726,"easy":"إذا استغفر لك ولدك بعد موتك ← تُرفع درجتك في الجنة","cause":"باستِغفارِ ولدِكَ لَكَ","result":"لتُرفعُ درجتُهُ في الجنَّةِ","explicit":true,"repOf":"س-04312","otherNeedIds":[37],"ref":"مصباح الزجاجة 4/98","text":["القنطارُ اثنا عشرَ ألفَ أوقيَّةٍ، كلُّ أوقيَّةٍ خيرٌ ممَّا بينَ السَّماءِ والأرض وقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: إنَّ الرَّجلَ ",["لتُرفعُ درجتُهُ في الجنَّةِ",2]," فيقولُ: أنَّى هذا ؟ فيقالُ: ",["باستِغفارِ ولدِكَ لَكَ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح رجاله ثقات","takhrij":"أخرجه ابن ماجه (3660) بلفظه، وأحمد (8758)، وابن حبان (2573) مختصرا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"j0YjTt9Y"},{"id":"س-02783","fp":"ea85b61ed2b2","stateId":726,"easy":"إذا جاهدت بنفسك ومالك حتى لقيت العدو فقاتلت حتى قُتلت ← فأنت الشهيد الممتحن في خيمة الله تحت عرشه","cause":"رجلٌ مؤمنٌ جاهَد بنفسِه ومالِه في سبيلِ اللهِ حتَّى إذا لقي العدوَّ قاتَلهم حتَّى يُقتَلَ","result":"فذلك الشَّهيدُ الممتحَنُ في خيمةِ اللهِ تحتَ عرشِه ولا يفضُلُه النَّبيُّون إلَّا بفضلِ درجةِ النُّبوَّةِ","explicit":true,"otherNeedIds":[47],"ref":"صحيح ابن حبان 4663","srcLabel":"أحمد","text":["القتلى ثلاثةٌ: ",["رجلٌ مؤمنٌ جاهَد بنفسِه ومالِه في سبيلِ اللهِ حتَّى إذا لقي العدوَّ قاتَلهم حتَّى يُقتَلَ",1]," ",["فذلك الشَّهيدُ الممتحَنُ في خيمةِ اللهِ تحتَ عرشِه ولا يفضُلُه النَّبيُّون إلَّا بفضلِ درجةِ النُّبوَّةِ",2],"، ورجلٌ مؤمنٌ قرَف على نفسِه مِن الذُّنوبِ والخطايا جاهَد بنفسِه ومالِه في سبيلِ اللهِ حتَّى إذا لقي العدوَّ قاتَل حتَّى قُتِل فتلك مَصْمَصةٌ محَتْ ذنوبَه وخطاياه، إنَّ السَّيفَ محَّاءٌ للخطايا وأُدخِل مِن أيِّ أبوابِ الجنَّةِ شاء فإنَّ لها ثمانيةَ أبوابٍ، ولجهنَّمَ سبعةَ أبوابٍ، وبعضُها أفضلُ مِن بعضٍ، ورجلٌ منافقٌ جاهَد بنفسِه ومالِه في سبيلِ اللهِ حتَّى إذا لقي العدوَّ قاتَل حتَّى قُتِل فذلك في النَّارِ إنَّ السَّيفَ لا يمحو النِّفاقَ"],"grade":"صحيح","narrator":"عتبة بن عبد السلمي","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (17657)، والطبراني (17/ 126) (311) كلاهما بلفظه، والدارمي (2455) بنحوه.","bab":"إيمان › النفاق","dorar":"3DmVqyKb"},{"id":"س-02890","fp":"83fa58f3272f","stateId":726,"easy":"إذا تجافى جنبك عن المضجع (قيام الليل) ← يُعدّ لك ما لا عين رأت ولا أذن سمعت","cause":"للَّذين تَتجافى جُنُوبُهم عنِ المضاجعِ","result":"ما لمْ تَرَ عينٌ، ولمْ تسمعْ أُذُنٌ، ولمْ يخطُرْ على قلبِ بشرٍ","explicit":true,"apply":{"k":"time","t":"في الليل"},"ref":"المستدرك على الصحيحين 3596","srcLabel":"الطبراني","text":["قالَ عبدُ اللهِ: إنَّه مكتوبٌ في التَّوراةِ: لقد أَعَدَّ اللهُ ",["للَّذين تَتجافى جُنُوبُهم عنِ المضاجعِ",1]," ",["ما لمْ تَرَ عينٌ، ولمْ تسمعْ أُذُنٌ، ولمْ يخطُرْ على قلبِ بشرٍ",2],"، ولا يَعلمُهُ ملَكٌ مُقرَّبٌ، ولا نَبيٌّ مُرسلٌ. قالَ: ونحن نَقرَؤها: {فَلَا تَعْلَمُ نَفْسٌ مَا أُخْفِيَ لَهُمْ مِنْ قُرَّةِ أَعْيُنٍ جَزَاءً بِمَا كَانُوا يَعْمَلُونَ} [السجدة: 17]."],"grade":"صحيح","narrator":"أبو عبيدة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن أبي شيبة (35137)، والطبراني في ((الكبير)) (9/ 213) (9039)، والطبري في ((تفسيره)) (18/ 617) باختلاف يسير.","bab":"إيمان › الوعد","dorar":"Cyii2nyJ"},{"id":"س-03207","fp":"9ba8918d0e7a","stateId":726,"easy":"إذا آمنت بالنبي ﷺ وأسلمت وجاهدت ← لك بيت في ربض الجنة وبيت في وسطها وبيت في أعلاها","cause":"لِمَنْ آمَنَ بي وأسلمَ وجَاهَدَ في سبيلِ اللهِ","result":"بِبَيْتٍ في رَبَضِ الجنةِ ، وبِبَيْتٍ في وسَطِ الجنةِ ، وببيتٍ في أعَلَى غُرَفِ الجنةِ","explicit":true,"otherNeedIds":[67],"ref":"صحيح الموارد 1313","srcLabel":"النسائي","text":["أنا زَعِيمٌ – والزَّعِيمُ الحَمِيلُ – لِمَنْ آمَنَ وأسلمَ وهاجَرَ ؛ بِبَيْتٍ في رَبَضِ الجنةِ ، وبِبَيْتٍ في وسَطِ الجنةِ ، وأنا زَعِيمٌ ",["لِمَنْ آمَنَ بي وأسلمَ وجَاهَدَ في سبيلِ اللهِ",1]," ؛ ",["بِبَيْتٍ في رَبَضِ الجنةِ ، وبِبَيْتٍ في وسَطِ الجنةِ ، وببيتٍ في أعَلَى غُرَفِ الجنةِ",2]," ، فمَنْ فعلَ ذلكَ ؛ لمْ يَدَعْ لِلْخَيْرِ مَطْلَبًا ، ولا مِنَ الشَّرِّ مَهْرَبًا ، يموتُ حيثُ شاءَ أنْ يَمُوتَ"],"grade":"صحيح","narrator":"فضالة بن عبيد","muhaddith":"صحيح","takhrij":"أخرجه النسائي (3133)، وابن حبان (353)، والبزار (3754) باختلاف يسير.","bab":"إيمان › فضل الإيمان","dorar":"eO6tsdoY"},{"id":"س-04324","fp":"1e2e18148ca1","stateId":726,"easy":"إذا سألت الله فاسأله الفردوس ← فهو سرّ الجنة","cause":"إذا سَألْتُم اللهَ تعالى فاسْأَلُوهُ الفِرْدَوْسَ","result":"فإِنَّهُ سِرُّ الجَنَّةِ","explicit":true,"repOf":"س-04326","ref":"صحيح الجامع 592","text":[["إذا سَألْتُم اللهَ تعالى فاسْأَلُوهُ الفِرْدَوْسَ ؛ ",1],["فإِنَّهُ سِرُّ الجَنَّةِ",2]],"grade":"صحيح","narrator":"العرباض بن سارية","muhaddith":"صحيح","takhrij":"أخرجه البزار (4203)، والطبراني (18/254) (635)، والبيهقي في ((البعث والنشور)) (228) باختلاف يسير.","bab":"جنة › صفة الجنة","dorar":"r3z9eDEf"},{"id":"س-04335","fp":"1ac7df997b83","stateId":726,"easy":"إذا سألت الله الجنة فاسأله الفردوس ← فهو أعلى الجنة وسقفه عرش الرحمن","cause":"إذا سألتم اللهَ الجنةَ فاسألوه الفِردوسَ","result":"فإنها أعلَى الجنةِ ، وأوسطُ الجنةِ وسقفُها عرشُ الرحمنِ","explicit":true,"repOf":"س-04326","otherNeedIds":[67],"ref":"بيان تلبيس الجهمية 4/8","text":[["إذا سألتم اللهَ الجنةَ فاسألوه الفِردوسَ ، ",1],["فإنها أعلَى الجنةِ ، وأوسطُ الجنةِ وسقفُها عرشُ الرحمنِ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"جنة › صفة الجنة","dorar":"nfawibvy"},{"id":"س-05400","fp":"d0f1a80ed631","stateId":726,"easy":"إذا تحاببت في الله ← تُرى غرفتك في الجنة كالكوكب الطالع","cause":"إنَّ المتحابِّينَ في اللَّهِ","result":"لتُرَى غُرفُهُم في الجنَّةِ كالكَوكَبِ الطَّالعِ الشَّرقيِّ أوِ الغربيِّ","explicit":true,"ref":"البدور السافرة 404","srcLabel":"أحمد","text":[["إنَّ المتحابِّينَ في اللَّهِ",1]," ",["لتُرَى غُرفُهُم في الجنَّةِ كالكَوكَبِ الطَّالعِ الشَّرقيِّ أوِ الغربيِّ",2]," ، فيُقالُ : مَن هؤلاءِ ؟ فيقالُ : هؤلاءِ المتحابُّونَ في اللَّهِ عزَّ وجلَّ ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (11829) واللفظ له، وابن أبي الدنيا في ((الإخوان)) (12)، وأبو الشيخ في ((طبقات المحدثين)) (3/ 444) بنحوه.","bab":"رقائق وزهد › الحب في الله","dorar":"abJacZox"},{"id":"س-07357","fp":"9def8de39f1a","stateId":726,"easy":"إذا تركت المراء وأنت صادق ← يضمن لك النبي ﷺ بيتاً في أعلى الجنة","cause":"لمن يتركُ المراءَ وهو صادقٌ","result":"فأنا زعيمٌ بثلاثةِ أبياتٍ في الجنةِ في وسَطِها ورياضِها وأعلاها","explicit":true,"otherNeedIds":[67],"ref":"النوافح العطرة 148","srcLabel":"النوافح العطرة","text":["ذَروا المِراءَ [يعني حديث: خرج علينا رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ونحن نتمارى في شيءٍ منَ الدِّينِ فغضب غضبًا شديدًا لم يغضبْ مثلَه ثم انتهرَنا فقال يا أمةَ محمدٍ لا تُهيِّجوا على أنفسِكم وهجَ النارِ ثم قال بهذا أمرتُكم أو ليس عن هذا نهيتُكم أليس قد كان هلك من كان قبلكم بهذا ثم قال ذروا المراءَ لقلةِ خيرِه ذروا المراءَ فإنَّ نفعَه قليلٌ ويُهيِّجُ العداءَ بينَ الإخوانِ ذروا المراءَ فإنَّ المراءَ لا تؤمنُ فتنتُه ذروا المراءَ فإنَّ المراءَ يورثُ الشكَّ ويحبطُ العملَ ذروا المراءَ فإنَّ المؤمنَ لا يُماري ذروا المِراءِ فإنَّ المُماريَ قد تمت خسارتُه ذروا المراءَ فكفاك إثمًا أن لا تزال مُماريًا ذروا المراءَ فإنَّ المُماريَ لا أشفعُ له يومَ القيامةِ ذروا المراءَ ",["فأنا زعيمٌ بثلاثةِ أبياتٍ في الجنةِ في وسَطِها ورياضِها وأعلاها",2]," ",["لمن يتركُ المراءَ وهو صادقٌ",1]," ذروا المراءَ فإنَّ أولَ ما نهاني عنه ربي عَزَّ وَجَلَّ بعد عبادةِ الأوثانِ وشربِ الخمرِ المراءُ ذروا المراءَ فإنَّ الشيطانَ قد أَيِسَ أن يُعبدَ ولكنه رضيَ منكم بالتَّحريشِ وهو المراءُ في الدِّينِ ذروا المراءَ فإنَّ بني إسرائيلَ افترقوا على إحدى وسبعين فرقةً والنصارى على اثنتين وسبيعن فرقةً وإنَّ أمتي ستفترقُ على ثلاثةٍ وسبعين فرقةً كلِّهم على الضلالةِ إلا السوادَ الأعظمَ قالوا يا رسولَ اللهِ وما السوادُ الأعظمُ قال ما أنا عليه وأصحابي مَنْ لم يمارِ في دينِ اللهِ ولم يكفِّرْ أحدًا من أهلِ التوحيدِ بذنبٍ ثم قال إنَّ الإسلامَ بدأ غريبًا وسيعودُ كما بدأ فطُوبى للغرباءِ قالوا يا رسولَ اللهِ ومَنِ الغرباءُ قال الذين يَصلُحون إذا فسد الناسُ ولا يمارون في دينِ اللهِ ولا يكفِّرون أحدًا مِنْ أهلِ التوحيدِ بذنبٍ]"],"grade":"صحيح","narrator":"[أبو الدرداء وأبو أمامة الباهلي وأنس بن مالك وواثلة بن الأسقع]","muhaddith":"صحيح","bab":"فتن › كراهية الاختلاف","dorar":"TMkPFVlz"},{"id":"س-05404","fp":"b549b17fe722","stateId":726,"easy":"إذا تحاببت وتجالست وتلاقيت في الله ← لك عمد من ياقوت في الجنة عليها غرف","cause":"المتحابُّونَ في اللهِ، المتجالِسونَ في اللهِ، المتلاقُونَ في اللهِ","result":"إنَّ في الجَنَّةِ لعُمُدًا من ياقوتٍ عليها غُرَفٌ مِن زَبَرْجَدٍ لها أبوابٌ مُفَتَّحةٌ تُضيءُ كما يُضيءُ الكوكَبُ الدُّرِّيُّ","explicit":true,"ref":"الضعفاء الكبير 1/309","srcLabel":"البيهقي","text":[["إنَّ في الجَنَّةِ لعُمُدًا من ياقوتٍ عليها غُرَفٌ مِن زَبَرْجَدٍ لها أبوابٌ مُفَتَّحةٌ تُضيءُ كما يُضيءُ الكوكَبُ الدُّرِّيُّ،",2]," قال: قُلْنا: فمَن يَسكُنُها يا رَسولَ اللهِ؟ قال: ",["المتحابُّونَ في اللهِ، المتجالِسونَ في اللهِ، المتلاقُونَ في اللهِ",1],"."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"لا يتابع حماد بن أبي حميد عليه وروي بلفظ مختلف بإسناد صالح","takhrij":"أخرجه عبد بن حميد (1430)، والبزار (8776)، والبيهقي في ((شعب الإيمان)) (8589) باختلاف يسير","bab":"رقائق وزهد › الحب في الله","dorar":"UGfPW13c"},{"id":"س-05647","fp":"0044eeb3267d","stateId":726,"easy":"إذا صبرت على القوت الشديد صبراً جميلاً ← يسكنك الله من الفردوس حيث شاء","cause":"ومن صبر على القوتِ الشديدِ صبرًا جميلًا","result":"اسكنه اللهُ من الفردوسِ حيث شاء","explicit":true,"ref":"المتجر الرابح 331","srcLabel":"ابن حبان","text":["من قَضى نهمتَه في الدنيا حِيلَ بينه وبين شهوتِه في الآخرةِ، ومن مدَّ عينيْه إلى زينةِ المُترفين كان مَهينًا في ملكوتِ السمواتِ ",["ومن صبر على القوتِ الشديدِ صبرًا جميلًا ",1],["اسكنه اللهُ من الفردوسِ حيث شاء",2],"."],"grade":"حسن","narrator":"البراء بن عازب","muhaddith":"رجاله ثقات إلا إسماعيل بن عمرو البجلي فلم أر وثقه غير ابن حبان","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (7912)، وأبو نعيم في ((تاريخ أصبهان)) (2/288)، والبيهقي في ((شعب الإيمان)) (9722)","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"ZrpOmVEs"},{"id":"س-01787","fp":"480d09d12284","stateId":726,"easy":"إذا آمنت بالله وصدّقت المرسلين ← تبلغ الغرف العالية في الجنة","cause":"رِجالٌ آمَنوا باللهِ وصَدَّقوا المُرسَلينَ","result":"إنَّ أهلَ الجَنَّةِ لَيَتَراءَونَ أهلَ الغُرَفِ مِن فوقِهم كما تَتَراءَونَ الكَوكَبَ الدُّرِّيَّ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"similar":["س-04316"],"ref":"صحيح مسلم 2831","srcLabel":"البخاري","text":[["إنَّ أهلَ الجَنَّةِ لَيَتَراءَونَ أهلَ الغُرَفِ مِن فوقِهم كما تَتَراءَونَ الكَوكَبَ الدُّرِّيَّ",2]," الغابِرَ مِنَ الأُفُقِ مِنَ المَشرِقِ أوِ المَغرِبِ؛ لتَفاضُلِ ما بينَهم، قالوا: يا رَسولَ اللهِ، تلك مَنازِلُ الأنبياءِ لا يَبلُغُها غَيرُهم؟ قال بَلى، والذي نَفسي بيَدِه ",["رِجالٌ آمَنوا باللهِ وصَدَّقوا المُرسَلينَ",1],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3256) باختلاف يسير","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"iqFgSIe2","merged":3,"otherRefs":["صحيح الترمذي 2556 (صحيح)","تخريج المسند لشعيب 8471 (صحيح)"]},{"id":"س-04227","fp":"d8d1369b93fa","stateId":726,"easy":"إذا كنت من أهل القرآن ← فليس فوقك درجة في الجنة","cause":"من أهلِ القرآنِ","result":"فليس فوقَه درجةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"شعب الإيمان 2/825","srcLabel":"البيهقي","text":["عددُ درَجِ الجنَّةِ عددُ آيِ القرآنِ ، فمن دخل الجنَّةَ ",["من أهلِ القرآنِ",1]," ",["فليس فوقَه درجةٌ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح، ولم يكتب هذا المتن إلا بهذا الإسناد وهو من الشواذ","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (1998)، والديلمي في ((الفردوس)) (4158)","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"AuK2r3tU"},{"id":"س-04316","fp":"ce3a3d587572","stateId":726,"easy":"إذا آمنت بالله ورسوله وصدقت المرسلين ← تتزاور مع أهل الغرف","cause":"أقوامٌ آمَنوا باللهِ ورسولِه، وصدَّقوا المرسَلين","result":"إنَّ أهلَ الجنَّةِ لَيَتَزاورونَ فيها","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-01787","ref":"تخريج المسند لشعيب 8423","text":[["إنَّ أهلَ الجنَّةِ لَيَتَزاورونَ فيها.",2]," قال سُرَيْجٌ: لَيَتَراءَوْن فيها كما تَراءَوْن الكوكبَ الدُّرِّيَّ والكوكبَ الشرقيَّ والكوكبَ الغربيَّ الغاربَ في الأُفُقِ الطالِعَ في تفاضُلِ الدرجاتِ، قالوا: يا رسولَ اللهِ، أولئك النَّبيُّون، قال: بلى، والذي نَفْسُ مُحمَّدٍ بيدِه؛ ",["أقوامٌ آمَنوا باللهِ ورسولِه، وصدَّقوا المرسَلين",1],"، وقال سُرَيْجٌ: وأقوامٌ آمَنوا باللهِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"متن الحديث صحيح، لكن من حديث أبي سعيد الخدري","takhrij":"أخرجه الترمذي (2556)، وأحمد (8423) واللفظ له","bab":"جنة › صفة أهل الجنة","dorar":"QYu8VKgU"},{"id":"س-05717","fp":"c45a250f43ce","stateId":726,"easy":"إذا كنت ضعيفاً مستضعفاً لو أقسمت على الله لأبرك ← فأنت من ملوك الجنة","cause":"كلُّ رجلٍ ضعيفٍ مستضعفٍ ذي طِمرين لا يُؤْبَهُ له لو أقسمَ على اللهِ لأبرَّهُ","result":"ألا أخبرُكَ عن ملوكِ الجنَّةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"المتجر الرابح 331","srcLabel":"الطبراني","text":[["ألا أخبرُكَ عن ملوكِ الجنَّةِ",2],"؟ قلتُ: بلى قال: ",["كلُّ رجلٍ ضعيفٍ مستضعفٍ ذي طِمرين لا يُؤْبَهُ له لو أقسمَ على اللهِ لأبرَّهُ",1],"."],"grade":"حسن","narrator":"معاذ بن جبل","muhaddith":"إسناده حسن في المتابعات","takhrij":"أخرجه ابن ماجة (4115) واللفظ له، والطبراني في ((الشاميين)) (1192)، والبيهقي في ((شعب الإيمان)) (10006) باختلاف يسير.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"F6NbS3Td"},{"id":"س-06297","fp":"a7498c97bafa","stateId":727,"easy":"إذا أحببت قوماً ← تأتي معهم يوم القيامة","cause":"يُحِبُّ رَجُلٌ قومًا","result":"إلَّا جاء معهم يومَ القيامةِ","explicit":true,"star":true,"otherNeedIds":[65],"ref":"تخريج مشكل الآثار 2185","srcLabel":"أحمد","text":["ثلاثةٌ أشهَدُ عليهم، والرابعةُ لو شَهدِتُ رَجَوتُ ألَّا آثَمَ: لا يَجعَلُ اللهُ عزَّ وجلَّ مَن له سهمٌ في الإسلامِ كمَن لا سَهْمَ له، وسِهامُ الإسلامِ: الصَّومُ، والصَّلاةُ، والصَّدَقةُ، ولا يتولَّى اللهُ عزَّ وجلَّ رَجُلًا في الدُّنيا فيولِّيهِ في الآخِرَةِ غيرَه، ولا ",["يُحِبُّ رَجُلٌ قومًا",1]," ",["إلَّا جاء معهم يومَ القيامةِ",2],"، والرابعةُ لا يستُرُ اللهُ عزَّ وجلَّ على عبدٍ في الدُّنيا إلَّا سَتَرَ عليه في الآخِرَةِ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار ) (2185) واللفظ له، وأحمد (25121)، والحاكم (8161) كلاهما باختلاف يسير.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"C15Wqlci","merged":2,"otherRefs":["صحيح الجامع 3021 (صحيح)"]},{"id":"س-08313","fp":"cf64c7af60c8","stateId":727,"easy":"إذا أحببت النبي ﷺ والحسن والحسين وأبويهما ← تكون معه في درجته","cause":"مَن أحبَّنِي وأحبَّ هذينِ وأباهُمَا وأمَّهمَا","result":"كان معي في درجَتِي يومَ القيامةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"otherNeedIds":[23],"ref":"تخريج المسند لشاكر 2/25","srcLabel":"الترمذي","text":["أنَّ رسولَ الله صلَّى اللهُ عليه وسلَّم أخذَ بيدِ حسنٍ وحسين ٍرضي اللهُ عنهما فقال: ",["مَن أحبَّنِي وأحبَّ هذينِ وأباهُمَا وأمَّهمَا",1]," ",["كان معي في درجَتِي يومَ القيامةِ",2]],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد في ((فضائل الصحابة)) (1185) واللفظ له، والترمذي (3733)، والطبراني في ((الصغير)) (960) باختلاف يسير.","bab":"مناقب وفضائل › علي بن أبي طالب","dorar":"f32pe1Ys"},{"id":"س-06235","fp":"33115acaf928","stateId":727,"easy":"إذا أحببت قوماً ولم تلحق بهم ← فأنت مع من أحببت","cause":"رَجُلًا أحَبَّ قَوْمًا ولمَّا يَلحَقْ بهم","result":"المَرْءُ معَ مَن أَحَبَّ","explicit":true,"star":true,"ref":"الأحاديث المختارة 8 / 33","srcLabel":"متفق عليه","text":["«أتَيْتُ صَفْوانَ بنَ عَسَّالٍ المُرادِيَّ رَضيَ اللهُ عنه؛ فقالَ: ما جاءَ بك؟ قُلْتُ: جِئْتُ ابْتِغاءَ العِلمِ، قالَ: فإنَّ المَلائِكةَ تَضَعُ أجْنِحتَها لطالِبِ العِلمِ رِضًا بما يَطلُبُ، قالَ: قُلْتُ: حَكَّ في نَفْسي أو صَدْري مَسْحٌ على الخُفَّينِ بَعْدَ الغائِطِ والبَوْلِ، فهلْ سَمِعْتَ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في ذلك شَيئًا؟ قالَ: نَعمْ، كانَ يَأمُرُنا إذا كُنَّا سَفَرًا أو مُسافِرينَ ألَّا نَنزِعَ خِفافَنا ثَلاثةَ أيَّامٍ ولَياليهنَّ إلَّا مِن جَنابةٍ؛ ولكنْ مِن غائِطٍ وبَوْلٍ ونَوْمٍ، قُلْتُ: هلْ سَمِعْتَه يَذكُرُ الهَوى؟ قالَ: نَعمْ، بَيْنا نحن معَه في مَسيرٍ إذ ناداه أعْرابيٌّ بصَوْتٍ جَهْوَرِيٍّ فقالَ: يا مُحمَّدُ، فأجابَه على نَحْوٍ مِن كَلامِه: (هاء). وقالَ: أرَأَيْتَ ",["رَجُلًا أحَبَّ قَوْمًا ولمَّا يَلحَقْ بهم",1],"؟ قالَ: (",["المَرْءُ معَ مَن أَحَبَّ",2],"). ثُمَّ لم يَزَلْ يُحَدِّثُنا (إنَّ مِن قِبَلِ المَغرِبِ بابًا يَفتَحُ اللهُ للتَّوبةِ، مَسيرةُ عَرْضِه أرْبَعونَ سَنَةً، فلا يُغلَقُ حتَّى تَطلُعَ الشَّمْسُ) يَعْني مِنه.\nلَفْظُ حَديثِ مُحمَّدِ بنِ عاصِمٍ.\nوفي رِوايةِ عَبْدِ الرَّزَّاقِ قالَ: أتَيْتُ صَفْوانَ بنَ عَسَّالٍ؛ فقالَ: ما جاءَ بك؟ قُلْتُ: ابْتِغاء العِلمِ.\nوعِنْدَه قُلْتُ: حاكَ في صَدْري مَسْحٌ على الخُفَّينِ بَعْدَ الغائِطِ والبَوْلِ، وكُنْتُ امْرَأً مِن أصْحابِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فأتَيْتُك أسْأَلُك عن ذلك، هلْ سَمِعْتَ مِنه في ذلك شَيئًا؟ قالَ: نَعمْ.\nوعِنْدَه: أو كُنَّا مُسافِرينَ.\nوعِنْدَه: قُلْتُ: أسَمِعْتَه يَذكُرُ الهَوى؟\nوعِنْدَه: بصَوْتٍ جَهْوَريٍّ -أو قالَ: (جَوْهَريٍّ) -ابنُ عُيَيْنةَ شَكَّ- قالَ:\nوعِنْدَه: فأجابَه بنَحْوٍ مِن كَلامِه، فقالَ: مَهْ، قالَ: أرَأَيْتَ.\nوعِنْدَه: ولم يَلحَقْ بهم، قالَ: (هو يَوْمَ القِيامةِ معَ مَن أحَبَّ). قالَ: فلم يَزَلْ يُحَدِّثُنا حتَّى قالَ: (إنَّ مِن قِبَلِ المَغرِبِ بابًا مَسيرةُ عَرْضِه سَبْعونَ سَنَةً، فَتَحَه اللهُ للتَّوْبةِ يَوْمَ خَلَقَ السَّمواتِ والأرْضَ، ولا يُغلِقُه حتَّى تَطلُعَ الشَّمْسُ مِن نَحْوِه»."],"grade":"صحيح","narrator":"صفوان بن عسال المرادي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"سفر › المسح على الخفين في السفر","dorar":"0S0WIi8D","merged":2,"otherRefs":["صحيح ابن حبان 562 (صحيح)"]},{"id":"س-02698","fp":"abe9cabde44b","stateId":727,"easy":"إذا أحببت قوماً ولم تلحق بهم ← فأنت معهم","cause":"المَرْءِ يُحِبُّ القَوْمَ لمَّا يَلحَقْ بِهم","result":"المَرْءُ معَ مَن أحَبَّ","explicit":true,"star":true,"similar":["س-01393","س-07024"],"ref":"الأحاديث المختارة 8 / 36","srcLabel":"متفق عليه","text":["«غَدَوْتُ على صَفْوانَ بنِ عَسَّالٍ المُرادِيِّ وأنا أريدُ أن أسْأَلَه عن المَسْحِ على الخُفَّينِ، فقالَ: ما جاءَ بك؟ فقُلْتُ: ابْتَغاء العِلمِ، فقالَ: ألَا أُبَشِّرُك؟ فقُلْتُ: بَلى، -فرَفَعَ الحَديثَ- قالَ: (إنَّ المَلائِكةَ تَضَعُ أجْنِحتَها لطالِبِ العِلمِ رِضًا بما يَطلُبُ). ثُمَّ سَأَلْتُه عن المَسْحِ على الخُفَّينِ، فقالَ: سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: (يَمسَحُ المُسافِرُ على الخُفَّينِ ثَلاثةَ أيَّامٍ ولَياليَهنَّ مِن بَوْلٍ أو غائِطٍ أو نَوْمٍ إلَّا مِن جَنابةٍ). ثُمَّ أنْشَأَ يُحَدِّثُنا؛ فقالَ: بَيْنَما نحن معَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في سَفَرٍ إذ ناداه أعْرابيٌّ بصَوْتٍ له جَهْوَرِيٍّ: يا مُحمَّدُ، يا مُحمَّدُ، يا مُحمَّدُ، فقُلْنا: اخْفِضْ مِن صَوْتِك، فإنَّك نُهيتَ أن تَرفَعَ صَوْتَك، فأجابَه النَّبيُّ صلَّى اللهُ عليه وسلَّمَ على نَحْوٍ ممَّا سَمِعَ مِنه، فقالَ: (هاؤُمْ)، ثُمَّ سَأَلَه عن الهَوى؛ عنِ ",["المَرْءِ يُحِبُّ القَوْمَ لمَّا يَلحَقْ بِهم",1],"؟ فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: (",["المَرْءُ معَ مَن أحَبَّ",2],")، ثُمَّ أنْشَأَ يُحَدِّثُنا فقالَ: بابُ التَّوْبةِ مَفْتوحٌ مِن قِبَلِ المَغرِبِ، وعَرْضُه مَسيرةَ سَبْعينَ عامًا لا يُغلَقُ حتَّى تَطلُعَ الشَّمْسُ مِن قِبَلِه، ثُمَّ قَرَأَ هذه الآيةَ: {هَلْ يَنْظُرُونَ إِلَّا أَنْ تَأْتِيَهُمُ الْمَلَائِكَةُ} إلى آخِرِ الآيةِ»."],"grade":"صحيح","narrator":"صفوان بن عسال المرادي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إيمان › الدين يسر","dorar":"TIYl48V9","merged":2,"otherRefs":["الأربعون البلدانية 149 (حسن)"]},{"id":"س-04160","fp":"5915d7607326","stateId":727,"easy":"إذا أحببت الله ورسوله ← تكون مع من أحببت","cause":"أنِّي أُحِبُّ اللهَ ورسولَه","result":"إنَّك مع مَن أحبَبْتَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-01556"],"ref":"تخريج المسند لشعيب 14012","srcLabel":"متفق عليه","text":["كنتُ عِندَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم في بَيتِه، فجاءه رجُلٌ فقال: يا رسولَ اللهِ، متى السَّاعةُ؟ قال: أمَا إنَّها قائمةٌ، فما أعدَدْتَ لها؟ قال: واللهِ يا رسولَ اللهِ ما أعدَدْتُ لها مِن كثيرِ عمَلٍ، غيْرَ ",["أنِّي أُحِبُّ اللهَ ورسولَه",1],"، قال: ف",["إنَّك مع مَن أحبَبْتَ",2],"، ولك ما احتسَبْتَ. قال: ثمَّ قام رسولُ اللهِ صلَّى اللهُ عليه وسلَّم يُصلِّي، فلمَّا قَضى صَلاتَهُ قال: أين السائلُ عنِ السَّاعةِ؟ فأَتى الرَّجُلُ، فنظَرَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم إلى البَيتِ، فإذا غُلامٌ مِن دَوْسٍ مِن رَهطِ أبي هُريرةَ يُقالُ له: سعدُ بنُ مالكٍ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: هذا الغُلامُ إنْ طال به عُمرٌ لم يَبْلُغْ به الهَرَمُ حتى تقومَ السَّاعةُ. قال الحسَنُ: وأخبَرَني أنسٌ أنَّ الغُلامَ كان يَومَئذٍ مِن أَقْراني."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6167)، ومسلم (2639)، والترمذي (2385)، والنسائي في ((السنن الكبرى)) (5873)، وأحمد (14012) واللفظ له","bab":"جنائز وموت › لقاء الله والمبادرة بالعمل الصالح","dorar":"aPmkmVXb","merged":20,"otherRefs":["تخريج المسند لشعيب 13684 (صحيح)","تخريج صحيح ابن حبان 563 (صحيح)","تخريج صحيح ابن حبان 5467 (صحيح)","صحيح البخاري 3688 (صحيح)","صحيح الأدب المفرد 269 (صحيح)","حلية الأولياء 7/361 (صحيح)","الفتح الرباني 2/1054 (صحيح)","تخريج المسند لشعيب 13092 (صحيح)","تخريج المسند لشعيب 14073 (صحيح)","الأحكام الوسطى 1/ 97 (صحيح)","صحيح البخاري 6167 (صحيح)","معجم الشيوخ 1/477 (حسن)","صحيح مسلم 2639 (صحيح)","تخريج المسند لشعيب 13371 (صحيح)","الأحاديث المختارة 8 / 35 (صحيح)","تخريج صحيح ابن حبان 8 (صحيح)","تخريج صحيح ابن حبان 565 (صحيح)","تخريج سنن أبي داود 5126 (صحيح)"]},{"id":"س-01393","fp":"cacaa21431bb","stateId":727,"easy":"إذا أحببت قوماً ← فأنت مع من أحببت","cause":"المرءُ","result":"مع مَن أحَبَّ","explicit":true,"repOf":"س-02698","ref":"صحيح الترمذي 3536","text":["عن زِرِّ بنِ حُبَيشٍ، قال: أتَيْتُ صَفْوانَ بنَ عسَّالٍ المُراديَّ، فقال: ما جاء بكَ ؟ قُلْتُ: ابتغاءَ العِلمِ، قال: بلَغني أنَّ الملائكةَ تضَعُ أجنحتَها لطالبِ العِلمِ رضًا بما يفعَلُ، قال: قُلْتُ له: إنَّه حَاكَ - أو حَكَّ - في نفسي شيءٌ مِن المسحِ على الخُفَّينِ، فهل حفِظْتَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فيه شيئًا؟ قال: نَعم، كنَّا إذا كنَّا في سفَرٍ أو مُسافِرينَ، أُمِرْنا ألَّا نخلَعَ خِفافَنا ثلاثًا، إلَّا مِن جَنابةٍ، ولكِنْ مِن غائطٍ وبولٍ ونومٍ، قال: فقُلْتُ: فهل حفِظْتَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم في الهَوَى شيئًا، قال: نَعَم، كنَّا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّم في بعضِ أسفارِه، فناداه رجُلٌ كان في آخِرِ القومِ بصَوْتٍ جَهْوريٍّ، أعرابيٌّ جِلْفٌ جافٍ، فقال: يا مُحمَّد، يا مُحمَّد، فقال له القومُ: مَهْ! إنَّكَ قد نُهِيتَ عن هذا، فأجابه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم نحوًا مِن صوتِه: هاؤُمُ، فقال: الرَّجلُ يُحِبُّ القومَ ولَمَّا يلحَقْ بهم، قال: فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["المرءُ ",1],["مع مَن أحَبَّ",2],"، قال زِرٌّ: فما برِح يُحدِّثُني حتَّى حدَّثني أنَّ اللهَ عزَّ وجلَّ جعَل بالمغرِبِ بابًا عَرْضُه مسيرةُ سبعينَ عامًا، للتَّوبةِ، لا يُغلَقُ ما لم تَطْلُعِ الشَّمسُ مِن قِبَلِه؛ وذلك قولُ اللهِ عزَّ وجلَّ:  {يَوْمَ يَأْتِي بَعْضُ آيَاتِ رَبِّكَ لَا يَنْفَعُ نَفْسًا إِيمَانُهَا} [الأنعام: 158]."],"grade":"صحيح","narrator":"صفوان بن عسال","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (3535)، وأحمد (18120)","bab":"وضوء › المسح على الخفين والجوربين والنعلين","dorar":"lE1ipmxN","merged":10,"otherRefs":["در السحابة 385 (حسن)","تخريج المسند لشعيب 18091 (صحيح)","تخريج صحيح ابن حبان 5467 (صحيح)","الأحكام الوسطى 1/ 98 (صحيح)","مختصر المقاصد 932 (صحيح)","تخريج المسند لشعيب 13224 (صحيح)","تخريج المسند لشعيب 13068 (صحيح)","تخريج المسند لشعيب 13316 (صحيح)","تخريج المسند لشعيب 13388 (صحيح)"]},{"id":"س-05402","fp":"80a459464650","stateId":727,"easy":"إذا أحببت رجلاً لله فأخبرته ← تدخلان الجنة معاً، وأرفعكما أشدكما حباً","cause":"من أحبَّ رجلًا للهِ ، فقال : إنِّي أحبُّك للهِ","result":"فدخلا جميعًا الجنَّةَ ، فكان الَّذي أحبَّ أرفعَ منزلةً من الآخرِ","explicit":true,"otherNeedIds":[67],"ref":"الترغيب والترهيب 4/80","srcLabel":"البخاري","text":[["من أحبَّ رجلًا للهِ ، فقال : إنِّي أحبُّك للهِ",1]," ",["فدخلا جميعًا الجنَّةَ ، فكان الَّذي أحبَّ أرفعَ منزلةً من الآخرِ",2]," ، وأحقَّ بالَّذي أحبُّ للهِ"],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"إسناده حسن","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (546)، والبزار (2439)، والطبراني (14/47) (14639) باختلاف يسير","bab":"رقائق وزهد › الحب في الله","dorar":"cLpF45dj"},{"id":"س-01556","fp":"b58bcdf3e435","stateId":727,"easy":"إذا أحببت الله ورسوله ← فأنت مع من أحببت","cause":"حبَّ اللَّهِ ورسولِهِ","result":"إنَّكَ معَ مَن أحببتَ","explicit":true,"repOf":"س-04160","ref":"صحيح ابن خزيمة 3/ 271","text":["دخلَ رجلٌ المسجدَ ورسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ على المنبرِ يومَ الجمعةِ، فَقالَ: يا رسولَ اللَّهِ، متى السَّاعةُ؟ فأشارَ إليهِ النَّاسُ أنِ اسكُت، فسألَهُ ثلاثَ مرَّاتٍ، كلُّ ذلِكَ يُشيرونَ إليهِ أنِ اسكت، فقالَ لهُ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ عندَ الثَّالثةِ: ويحَكَ ماذا أعدَدتَ لَها؟ قالَ: ",["حبَّ اللَّهِ ورسولِهِ",1],"، قالَ: ",["إنَّكَ معَ مَن أحببتَ",2]," قالَ: فسَكَتَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ساعةً، ثمَّ مرَّ غلامٌ شَنَئيٌّ، قالَ أنسٌ: أقولُ: أَنا هوَ مِن أقراني قدِ احتلمَ، أو ناهزَ، فقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ: أينَ السَّائلُ عنِ السَّاعةِ؟ قالَ: ها هوَ ذا، قالَ: إن أَكْملَ هذا الغلامُ عُمُرَهُ فلَن يموتَ حتَّى يَرى أشراطَها"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أخرجه في صحيحه","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"rMLsfdZk","merged":2,"otherRefs":["إرشاد الساري 2/186 (صحيح)"]},{"id":"س-07024","fp":"611c6f3fa0b0","stateId":727,"easy":"إذا أحببت قوماً ← فأنت معهم يوم القيامة","cause":"المرْءُ","result":"مع مَن أحَبَّ يومَ القيامةِ","explicit":true,"repOf":"س-02698","ref":"سنن الترمذي 3535","text":["عن زِرِّ بنِ حُبَيشٍ، قال: أتَيْتُ صفْوانَ بنَ عسَّالٍ المُراديَّ أسأَلُه عنِ المسْحِ على الخُفَّينِ؟ فقال: ما جاء بك يا زِرُّ؟ فقلْتُ: ابتغاءَ العلْمِ، فقال: إنَّ الملائكةَ لَتَضَعُ أجْنِحَتَها لطالِبِ العلْمِ؛ رضًا بما يطلُبُ، فقلْتُ: إنَّه حكَّ في صَدْري المسْحُ على الخُفَّينِ بعد الغائطِ والبَولِ، وكنْتَ امرَأً مِن أصحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فجئْتُ أسأَلُك: هل سمِعْتَه يذكُرُ في ذلك شيئًا؟ قال: نعم، كان يأمُرُنا إذا كنَّا سَفْرًا -أو مُسافرينَ- ألَّا ننزِعَ خِفافَنا ثلاثةَ أيَّامٍ ولياليَهنَّ إلَّا مِن جَنابَةٍ، لكنْ مِن غائطٍ وبَولٍ ونومٍ. قال: فقلْتُ: هل سمِعْتَه يذكُرُ في الْهَوى شيئًا؟ قال: نعم، كنَّا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في سَفَرٍ، فبَيْنا نحن عنده إذْ ناداهُ أعرابيٌّ بصوتٍ له جَهْوَرِيٍّ: يا محمَّدُ، فأجابه رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ نحوًا مِن صوتِه: هاؤُمُ. فقُلْنا له: اغضُضْ مِن صوتِك؛ فإنَّك عند النَّبيِّ صلَّى اللهُ عليه وسلَّمَ وقد نُهِيتَ عن هذا. فقال: واللهِ لا أغضُضُ، قال الأعرابيُّ: المرْءُ يُحِبُّ القومَ ولمَّا يلحَقْ بهم؟ قال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",["المرْءُ ",1],["مع مَن أحَبَّ يومَ القيامةِ",2],". فما زال يُحدِّثُنا حتَّى ذكَرَ بابًا مِن قِبَلِ المغرِبِ مَسيرةُ عَرْضِه، أو يسيرُ الرَّاكِبُ في عَرْضِه أربعينَ أو سبْعينَ عامًا- قال سفيانُ: قِبَلَ الشَّامِ- خلَقَه اللهُ يومَ خلَقَ السَّمواتِ والأرضَ مفتوحًا -يعني: للتَّوبةِ- لا يُغْلَقُ حتَّى تطْلُعَ الشَّمسُ منه."],"grade":"صحيح","narrator":"صفوان بن عسال","muhaddith":"حسن صحيح","takhrij":"أخرجه النسائي (127) مختصراً باختلاف يسير، وابن ماجه (478،226) مفرقاً مختصراً باختلاف يسير، وأحمد (18095) باختلاف يسير","bab":"علم › الحث على طلب العلم","dorar":"t4oA545f"},{"id":"س-02633","fp":"7f98648a94c4","stateId":727,"easy":"إذا أحببت أحداً لله ← تكون مع من أحببت ولك ما احتسبت","cause":"إنِّي لأحبُّ هذا للَّهِ","result":"أنتَ معَ من أحببتَ ، ولَكَ ما احتسَبتَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[23],"ref":"الصحيح المسند 1/65","srcLabel":"الترمذي","text":["مرَّ رجلٌ بالنَّبيِّ صلَّى اللَّه عليهِ وعلَى آلِهِ وسلَّمَ وعندَهُ ناسٌ ، فقالَ رجلٌ مِمَّن عندَهُ : ",["إنِّي لأحبُّ هذا للَّهِ",1]," ، فقالَ النَّبيُّ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ: أعلَمتَهُ ؟ قالَ: لا ، فقالَ: فقُم إليهِ فأعلِمهُ ، فقامَ إليهِ فأعلَمَهُ ، فقالَ: أحبَّكَ اللَّه الَّذي أحببتَني لَهُ قالَ: ثمَّ رجعَ إلى النَّبيِّ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ فأخبرَهُ بما قالَ: فقالَ النَّبيُّ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ: ",["أنتَ معَ من أحببتَ ، ولَكَ ما احتسَبتَ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2386) مختصراً، وأحمد (12430) باختلاف يسير.","bab":"إيمان › الاحتساب والنية","dorar":"kcd2ahS2"},{"id":"س-05392","fp":"83db616cfed2","stateId":727,"easy":"إذا أحببت قوماً ← يحشرك الله في زمرتهم","cause":"مَنْ أحبَّ قومًا","result":"حشرهُ اللهُ في زمرتِهمْ","explicit":true,"ref":"الجامع الصغير 8298","srcLabel":"الطبراني","text":[["مَنْ أحبَّ قومًا ",1],["حشرهُ اللهُ في زمرتِهمْ",2]],"grade":"حسن","narrator":"أبو قرصافة","muhaddith":"حسن","takhrij":"أخرجه الطبراني (2519) (3/ 19) بلفظه","bab":"رقائق وزهد › الحب في الله","dorar":"4BTyFHPh"},{"id":"س-04547","fp":"bea8cbece729","stateId":728,"easy":"إذا كنت صدّيقاً أو شهيداً ← فأنت في الجنة","cause":"والصِّدِّيقُ في الجنَّةِ، والشَّهيدُ في الجنَّةِ","result":"برِجالِكم مِن أهْلِ الدُّنْيا في الجنَّةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الأحاديث المختارة 10 / 403","srcLabel":"متفق عليه","text":["«أَلَا أُنَبِّئُكم ",["برِجالِكم مِن أهْلِ الدُّنْيا في الجنَّةِ",2],"؟ قالوا: بَلى يا رَسولَ اللهِ، قالَ: النَّبيُّ صلَّى اللهُ عليه وسلَّمَ في الجنَّةِ، ",["والصِّدِّيقُ في الجنَّةِ، والشَّهيدُ في الجنَّةِ",1],"، والمَوْلودُ مَوْلودُ الإسْلامِ في الجنَّةِ، والرَّجُلُ يكونُ في جانِبِ المِصْرِ يَزورُ أخاه لا يَزورُه إلَّا للهِ في الجنَّةِ، أَلَا أُنَبِّئُكم بنِسائِكم مِن أهْلِ الجنَّةِ؟ قالوا: بَلى يا رَسولَ اللهِ، قالَ: الوَلودُ الوَدودُ الَّتي إذا غَضِبَتْ أو غَضِبَ قالَتْ: يَدي في يَدِك لا أَكتَحِلُ بغَمْضٍ»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"جهاد › فضل الشهيد","dorar":"2YJKpcYW"},{"id":"ق-0230","fp":"87ab7e80e48f","stateId":728,"easy":"طاعة الله والرسول ← مرافقة النبيين والصديقين والشهداء والصالحين","cause":"طاعة الله والرسول","result":"مرافقة النبيين والصديقين والشهداء والصالحين","explicit":true,"star":true,"ref":"سورة النساء: 69","srcLabel":"القرآن الكريم","quran":{"s":4,"from":69,"to":69,"text":"وَمَنْ يُطِعِ اللَّهَ وَالرَّسُولَ فَأُولَئِكَ مَعَ الَّذِينَ أَنْعَمَ اللَّهُ عَلَيْهِمْ مِنَ النَّبِيِّينَ وَالصِّدِّيقِينَ وَالشُّهَدَاءِ وَالصَّالِحِينَ وَحَسُنَ أُولَئِكَ رَفِيقًا (69)","hl":[[0,184,1]]}},{"id":"س-00232","fp":"bbebaad9be69","stateId":728,"easy":"إذا كنت تاجراً أميناً صدوقاً ← تكون مع الشهداء يوم القيامة","cause":"التَّاجِرُ الأَمِينُ الصَّدُوقُ","result":"مع الشُّهَدَاءِ يومَ القيامةِ","explicit":true,"star":true,"ref":"صحيح الترغيب 1783","srcLabel":"الحاكم","text":[["التَّاجِرُ الأَمِينُ الصَّدُوقُ",1]," ",["مع الشُّهَدَاءِ يومَ القيامةِ",2]," ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"حسن صحيح","takhrij":"أخرجه ابن ماجة(2139 )،والطبراني في((المعجم الأوسط)) (7394 )،والحاكم في ((المستدرك)) (2142 )","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"QN9hlUl6","merged":3,"otherRefs":["الوهم والإيهام 5/769 (حسن)","السلسلة الصحيحة 3453 (حسن)"]},{"id":"س-00749","fp":"486d1a94a5e1","stateId":728,"easy":"إذا قرأت ألف آية في سبيل الله ← يكتبك الله مع النبيين والصديقين والشهداء والصالحين","cause":"مَنْ قَرَأَ ألفَ آيةٍ في سبيلِ اللهِ","result":"كَتَبَه اللهُ مع النَّبيِّينَ والصِّدِّيقينَ والشُّهداءِ والصَّالحينَ","explicit":true,"otherNeedIds":[62],"ref":"المستدرك على الصحيحين 2478","srcLabel":"أحمد","text":[["مَنْ قَرَأَ ألفَ آيةٍ في سبيلِ اللهِ؛ ",1],["كَتَبَه اللهُ مع النَّبيِّينَ والصِّدِّيقينَ والشُّهداءِ والصَّالحينَ",2],"."],"grade":"صحيح","narrator":"معاذ الجهني","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (15611)، والطبراني (20/ 184) (401)، والبيهقي (18615) واللفظ لهم.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"mGksMcp3"},{"id":"س-04757","fp":"fc5d6c50d90d","stateId":728,"easy":"إذا قاتلت ابتغاء وجه الله ← تكون من الشهداء","cause":"يُقاتِلونَ ابتِغاءَ وَجهِ اللهِ عَزَّ وجَلَّ","result":"أولَئِكَ الشُّهَداءُ","explicit":true,"otherNeedIds":[51],"ref":"مشارع الأشواق 1011","srcLabel":"الحاكم","text":["أنَّ عُمَرَ بنَ الخَطَّابِ خَرَجَ على مَجلسٍ في مَسجِدِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، وهم يَتَذاكَرونَ سَريَّةً هَلَكَت في سَبيلِ اللهِ، فيَقولُ بَعضُهم: هم عُمَّالُ اللَّهِ، هَلَكوا في سَبيلِ اللهِ، فقد وجَبَ أو وقَعَ أجرُهم على اللهِ، ويَقولُ قائِلٌ: اللهُ أعلَمُ بهم، لَهم ما احتَسَبوا، فلَمَّا رَآهم عُمَرُ قال لَهم: ما كُنتُم تَتَحَدَّثونَ؟ قالوا: كُنَّا نَتَحَدَّثُ في هذه السَّريَّةِ، فيَقولُ قائِلٌ كَذا، ويَقولُ قائِلٌ كَذا، فقال عُمَرُ: واللهِ إنَّ مِنَ النَّاسِ ناسًا يُقاتِلونَ ابتِغاءَ الدُّنيا، وإنَّ مِنَ النَّاسِ ناسًا يُقاتِلونَ رياءً وسُمعةً، وإنَّ مِنَ النَّاسِ ناسًا يُقاتِلونَ إن دَهَمَهمُ القِتالُ، فلا يَستَطيعونَ إلَّا إيَّاه، وإنَّ مِنَ النَّاسِ ناسًا ",["يُقاتِلونَ ابتِغاءَ وَجهِ اللهِ عَزَّ وجَلَّ",1],"، ",["أولَئِكَ الشُّهَداءُ",2],"، وكُلُّ امرِئٍ مِنهم يُبعَثُ على الذي يَموتُ عليه، وإنَّها واللَّهِ ما تَدري نَفسٌ ما هو مَفعولٌ بها ليس هذا الرَّجُلَ الذي قد تَبَيَّنَ لَنا أنَّه قد غُفِرَ له ما تَقدَّمَ مِن ذَنبِه وما تَأخَّرَ"],"grade":"صحيح","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن المبارك في ((الجهاد)) (10)، والحاكم (2520) كلاهما بلفظه مطولا، وعبد الرزاق (9563) بنحوه .","bab":"رقائق وزهد › الإخلاص","dorar":"1DJtgz0d"},{"id":"س-02417","fp":"431029fbbf53","stateId":728,"easy":"إذا شهدت وصليت وآتيت الزكاة وصمت وقمت ← تكون من الصديقين والشهداء","cause":"إن شَهِدْتُ أن لا إلَهَ إلَّا اللَّهُ وأنَّكَ رسولُ اللَّهِ، وصلَّيتُ الصَّلواتِ الخمسَ، وصُمتُ الشَّهرَ، وقُمتُ رمضانَ، وآتيتُ الزَّكاةَ","result":"منَ الصِّدِّيقينَ والشُّهداءِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-02423","س-02615"],"otherNeedIds":[47],"ref":"صحيح ابن خزيمة 3/ 593","srcLabel":"أحمد","text":["جاءَ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ رجلٌ مِن قضاعةَ، فَقالَ لَهُ: يا رسولَ اللَّهِ أرأيتَ ",["إن شَهِدْتُ أن لا إلَهَ إلَّا اللَّهُ وأنَّكَ رسولُ اللَّهِ، وصلَّيتُ الصَّلواتِ الخمسَ، وصُمتُ الشَّهرَ، وقُمتُ رمضانَ، وآتيتُ الزَّكاةَ",1],"، فَقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ: مَن ماتَ علَى هذا كانَ ",["منَ الصِّدِّيقينَ والشُّهداءِ",2]],"grade":"صحيح","narrator":"عمرو بن مرة الجهني","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (24009/ 81)، وابن حبان (186)، وابن بشران في ((الأمالي)) (1024) واللفظ لهم.","bab":"إسلام › فضل الشهادتين","dorar":"AX8zHSHn","merged":2,"otherRefs":["تخريج صحيح ابن حبان 3492 (صحيح)"]},{"id":"س-03917","fp":"1e07d705c9cd","stateId":728,"easy":"إذا أطعت الله والرسول ← تكون مع الذين أنعم الله عليهم","cause":"خشيتُ أن لَّا أراكَ","result":"وَمَنْ يُطِعِ اللهَ وَالرَّسُولَ فَأُولَئِكَ مَعَ الَّذِينَ أَنْعَمَ اللهُ عَلَيْهِمْ مِّنَ النَّبِيِّيِّنَ وَالصِّدِّيقينَ وَالشُّهَدَاءِ وَالصَّالِحِينَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[23],"ref":"مجمع الزوائد 7/10","srcLabel":"الطبراني","text":["جاء رجلٌ إلى النبيِّ صلَّى اللهُ عليه وسلَّم فقال يا رسولَ اللهِ إنكَ لَأَحَبُّ إلَيَّ مِنْ نَفْسِي [ وَإِنَّكَ لَأَحَبُّ إِلَيَّ مِنْ أَهْلِي وَمَالِي ] وإنكَ لَأَحَبُّ إِلَيَّ مِنْ وَلَدِي وَإِنِّي لَأَكُونُ في البيتِ فَأَذْْكُرُكَ فما أصبرُ حتى آتِيَ فأنظرَ إليكَ وإذا ذكَرتُ موْتِي وموتَكَ عرفْتُ أنَّكَ إذا دخلْتَ الجنةَ رُفِعْتَ مع النبيين وأني إذا دخلْتُ الجنةَ ",["خشيتُ أن لَّا أراكَ",1]," فلم يردَّ عليه النبيُّ صلَّى اللهُ عليه وسلَّم شيئًا حتى نزل جبريلُ عليه السلامُ بهذِهِ الآيَةِ  ",["وَمَنْ يُطِعِ اللهَ وَالرَّسُولَ فَأُولَئِكَ مَعَ الَّذِينَ أَنْعَمَ اللهُ عَلَيْهِمْ مِّنَ النَّبِيِّيِّنَ وَالصِّدِّيقينَ وَالشُّهَدَاءِ وَالصَّالِحِينَ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"رجاله رجال الصحيح غير عبد الله بن عمران العابدي وهو ثقة","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (477)، وابن مردويه كما في ((الدر المنثور)) للسيوطي (2/588)، وأبو نعيم في ((حلية الأولياء)) (4/240) باختلاف يسير","bab":"تفسير آيات › سورة النساء","dorar":"mEQBFxUB","merged":2,"otherRefs":["الأحاديث المختارة 11 / 79 (صحيح)"]},{"id":"س-02423","fp":"c4551698f65d","stateId":728,"easy":"إذا شهدت وصليت الصلوات ← تكون مع الصديقين والشهداء","cause":"إن شَهِدْتُ أنْ لا إلهَ إلَّا اللهُ، وأنَّك رَسولُ اللهِ، وصَلَّيْتُ الصَّلَواتِ، وصُمْتُ رَمَضانَ، وقُمْتُ الشَّهْرَ، وآتَيْتُ الزَّكاةَ","result":"مَن فَعَلَ ذلك كانَ معَ الشُّهَداءِ والصِّدِّيقينَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-02417","otherNeedIds":[47],"ref":"الصحيح المسند 1017","text":["جاءَ رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ رَجُلٌ مِن قُضاعةَ، فقالَ: يا رَسولَ اللهِ، ",["إن شَهِدْتُ أنْ لا إلهَ إلَّا اللهُ، وأنَّك رَسولُ اللهِ، وصَلَّيْتُ الصَّلَواتِ، وصُمْتُ رَمَضانَ، وقُمْتُ الشَّهْرَ، وآتَيْتُ الزَّكاةَ",1],"؟ فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ: «",["مَن فَعَلَ ذلك كانَ معَ الشُّهَداءِ والصِّدِّيقينَ",2],"»."],"grade":"صحيح","narrator":"عمرو  بن مرة الجهني","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي عاصم في ((الآحاد والمثاني)) (2558)، وابن خزيمة (2212)، وابن قانع في ((معجم الصحابة)) (2/ 197) واللفظ لهم.","bab":"إسلام › فضل الشهادتين","dorar":"xLEOpPAg"},{"id":"س-02615","fp":"26daa873c5a0","stateId":728,"easy":"إذا شهدت وصليت وأديت الزكاة وصمت رمضان ← تكون مع الصديقين والشهداء","cause":"شَهدتُ أن لا إلَه إلَّا اللَّهُ وأنَّك رسولُ اللَّهِ وصلَّيتُ الخمسَ وأدَّيتُ زَكاةَ مالي وصُمتُ رمضانَ","result":"مَن ماتَ علَى هذا كانَ معَ النَّبيِّينَ والصِّدِّيقينَ والشُّهداءِ والصَّالحينَ يومَ القيامةِ هَكذا ونصَبَ أُصبعَيهِ ما لم يعُقَّ والدَيهِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"time","t":"في رمضان"},"repOf":"س-02417","ref":"الزواجر عن اقتراف الكبائر 2/68","text":["جاءَ رجلٌ إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ : يا رسولَ اللَّهِ ",["شَهدتُ أن لا إلَه إلَّا اللَّهُ وأنَّك رسولُ اللَّهِ وصلَّيتُ الخمسَ وأدَّيتُ زَكاةَ مالي وصُمتُ رمضانَ",1]," ، فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : ",["مَن ماتَ علَى هذا كانَ معَ النَّبيِّينَ والصِّدِّيقينَ والشُّهداءِ والصَّالحينَ يومَ القيامةِ هَكذا ونصَبَ أُصبعَيهِ ما لم يعُقَّ والدَيهِ",2]],"grade":"صحيح","muhaddith":"[ روي ] بإسنادين أحدهما صحيح","bab":"إيمان › الأمر بالإيمان بالله تعالى ورسوله وشرائع الدين","dorar":"4GDvkA35"},{"id":"ق-0553","fp":"4f2a10f5657c","stateId":729,"easy":"الإحسان ← الحسنى وزيادة ولا قتر ولا ذلة والخلود في الجنة","cause":"الإحسان","result":"الحسنى وزيادة ولا قتر ولا ذلة والخلود في الجنة","explicit":true,"star":true,"ref":"سورة يونس: 26","srcLabel":"القرآن الكريم","quran":{"s":10,"from":26,"to":26,"text":"لِلَّذِينَ أَحْسَنُوا الْحُسْنَى وَزِيَادَةٌ وَلَا يَرْهَقُ وُجُوهَهُمْ قَتَرٌ وَلَا ذِلَّةٌ أُولَئِكَ أَصْحَابُ الْجَنَّةِ هُمْ فِيهَا خَالِدُونَ (26)","hl":[[0,146,1]]}},{"id":"س-04174","fp":"8d9d016717a4","stateId":729,"easy":"إذا سارعت إلى الجمعة ← تكون يوم القيامة في الدنو من الله على مقدار مسارعتك","cause":"سارِعوا إلى الْجُمُعَةِ","result":"فيكونونَ في الدُّنُوِ منهُ على مقدارِ مُسارِعَتِهِم في الدُّنيا إلى الْجُمُعَةِ","explicit":true,"star":true,"otherNeedIds":[26,65],"ref":"مجموع الفتاوى 6/403","srcLabel":"الطبراني","text":["عن عبدِ اللهِ بْنِ مسعودٍ قال : ",["سارِعوا إلى الْجُمُعَةِ",1]," فإنَّ اللهَ عزَّ وجلَّ يَبْرُزُ لأهلِ الجنَّةِ في كُلِّ يومِ جُمُعَةِ في كثِيبٍ من كافورٍ أبيضَ ",["فيكونونَ في الدُّنُوِ منهُ على مقدارِ مُسارِعَتِهِم في الدُّنيا إلى الْجُمُعَةِ",2]," ، فَيُحْدِثُ لهم من الكرامةِ شيئًا لم يكونوا رأوْهُ فيما خلا ، قال : وكان عبدُ اللهِ بْنِ مسعودٍ لا يَسْبِقُهُ أحدٌ إلى الْجُمُعَةِ ، قال : فجاء يومًا وقد سَبَقَهُ رجلانِ, فقال : رجلانِ وأنا الثَّالثُ إنَّ اللهَّ يُبَارِكُ في الثَّالثِ."],"grade":"صحيح","narrator":"أبو عبيدة عامر بن عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن المبارك في ((الزهد)) (2/131)، وابن خزيمة في ((التوحيد)) (2/893)، والطبراني (9/273) (9169) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"5NHciGtJ","merged":4,"otherRefs":["مجموع الفتاوى 6/403 (صحيح)","العرش للذهبي 108 (صحيح)","تخريج زاد المعاد 1/396 (حسن)"]},{"id":"س-03102","fp":"ab74ca766f68","stateId":729,"easy":"إذا أسرعت إلى الجمعة وبكّرت ← تكون أقرب الناس مجلساً من ربك","cause":"أسرعُهُم إليهِ يومَ الجُمُعةِ وأبْكرُهم غُدُوًّا","result":"وأقربُهُم منه مجلسًا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"مجموع الفتاوى 6/417","srcLabel":"الآجري","text":["أنَّ أهْلَ الجُمُعةِ يَروْنَ ربَّهم تَعالَى في كلِّ يوْمِ جمُعَةٍ في رِمالِ الكافورِ ، ",["وأقربُهُم منه مجلسًا",2]," ",["أسرعُهُم إليهِ يومَ الجُمُعةِ وأبْكرُهم غُدُوًّا",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الآجري في ((الشريعة)) (611)، وابن بطة في ((الإبانة الكبرى)) (30) واللفظ لهما.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"LH1axKD3"},{"id":"س-00585","fp":"658d1d9dab81","stateId":729,"easy":"إذا لم تُغلب على صلاة قبل طلوع الشمس وقبل غروبها ← ترى ربك يوم القيامة كما ترى القمر","cause":"ألَّا تُغلَبوا على صَلاةٍ قَبلَ طُلوعِ الشَّمسِ، وقَبلَ غُروبِها","result":"سَتَرَوْنَ رَبَّكم عزَّ وجلَّ كما تَرَوْنَ هذا، لا تُضامُونَ","explicit":true,"star":true,"otherNeedIds":[26],"ref":"تخريج المسند لشعيب 19205","srcLabel":"متفق عليه","text":["قال لي جَريرُ بنُ عَبدِ اللهِ: كُنَّا جُلوسًا عِندَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، إذ نظَرَ إلى القَمَرِ لَيلةَ البَدرِ، فقال: أمَا إنَّكم ",["سَتَرَوْنَ رَبَّكم عزَّ وجلَّ كما تَرَوْنَ هذا، لا تُضامُونَ",2],"، أو لا تُضارُّونَ -شَكَّ إسماعيلُ- في رُؤيَتِهِ، فإنِ استَطَعتُم ",["ألَّا تُغلَبوا على صَلاةٍ قَبلَ طُلوعِ الشَّمسِ، وقَبلَ غُروبِها",1],"، فافعلوا، ثم قال: {وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ الشَّمْسِ وَقَبْلَ غُرُوبِهَا} [طه: 130]."],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (573)، ومسلم (633)، وأبو داود (4729)، والترمذي (2551)، والنسائي في ((السنن الكبرى)) (460)، وابن ماجه (177)، وأحمد (19205) واللفظ له","bab":"آداب عامة › ضرب الأمثال","dorar":"0fkrj7NE","merged":3,"otherRefs":["تخريج صحيح ابن حبان 7442 (صحيح)","مجموع الفتاوى 6/499 (صحيح)"]},{"id":"س-02852","fp":"f4022ae5866c","stateId":729,"easy":"إذا أحسنت ← يُكشف لك الحجاب فتنظر إلى وجه الله","cause":"لِلَّذِينَ أَحْسَنُوا","result":"فيُكشَفُ الحِجابُ فيَنظُرونَ إليه","explicit":true,"ref":"الأحكام الوسطى 4/ 347","srcLabel":"مسلم","text":["قَرَأَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: \"هذه الآيةَ: {",["لِلَّذِينَ أَحْسَنُوا",1]," الْحُسْنَى وَزِيَادَةٌ}، قالَ: \"إذا دَخَلَ أهْلُ الجَنَّةِ الجَنَّةَ، وأهْلُ النَّارِ النَّارَ نادى مُنادٍ: يا أهْلَ الجَنَّةِ، إنَّ لكم عنْدَ اللهِ مَوعِدًا يُريدُ أن يُنْجِزَكموه، قالوا: أَلَمْ يُبَيِّضْ وُجوهَنا، ويُثَقِّلْ مَوازينَنا، ويُدخِلْنا الجَنَّةَ، ويُجِرْنا مِن النَّارِ؟ قالَ: ",["فيُكشَفُ الحِجابُ فيَنظُرونَ إليه",2],"، فوَاللهِ ما أَعْطاهم اللهُ شَيئًا أَحَبَّ إليهم مِن النَّظَرِ إلى وَجْهِه، ولا أَقَرَّ لِأَعيُنِهم\"."],"grade":"صحيح","narrator":"صهيب","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه ابن ماجه (187)، وأحمد (18936)، وأصله في مسلم (181)","bab":"إيمان › الوعد","dorar":"Nwqbnnrz","merged":2,"otherRefs":["الكامل في الضعفاء 3/48 (صحيح)"]},{"id":"ق-1398","fp":"96aa9294c5b6","stateId":729,"easy":"الإيمان والعمل للآخرة ← نضرة الوجوه والنظر إلى الله","cause":"الإيمان والعمل للآخرة","result":"نضرة الوجوه والنظر إلى الله","explicit":true,"ref":"سورة القيامة: 22–23","srcLabel":"القرآن الكريم","quran":{"s":75,"from":22,"to":23,"text":"وُجُوهٌ يَوْمَئِذٍ نَاضِرَةٌ (22) إِلَى رَبِّهَا نَاظِرَةٌ (23)","hl":[[0,58,1]]}}]}