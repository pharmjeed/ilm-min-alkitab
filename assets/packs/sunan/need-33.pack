{"schema":1,"kind":"sunan-chunk","version":"sunan-820d161722ab","needId":33,"stateIds":[360],"items":[{"id":"س-01558","fp":"6388ade24902","stateId":360,"easy":"إذا نجوت من الفتن التي قبل الدجال ← نجوت من فتنته","cause":"فمَن نَجا مِن فِتْنةِ ما قَبْلَها","result":"فقد نَجا مِنها","explicit":true,"ref":"الأحكام الوسطى 4/ 378","srcLabel":"ابن حبان","text":["كُنَّا عنْدَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فذَكَرَ الدَّجَّالَ، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: \"لَفِتْنةُ بعضِكم أَخوَفُ عنْدي مِن فِتْنةِ الدَّجَّالِ، ليس مِن فِتْنةٍ صَغيرةٍ ولا كَبيرةٍ إلَّا تَصنَعُ لفِتْنةِ الدَّجَّالِ، ",["فمَن نَجا مِن فِتْنةِ ما قَبْلَها",1]," ",["فقد نَجا مِنها",2],"، واللهِ لا يَضُرُّ مُسلِمًا، مَكْتوبٌ بَيْنَ عَيْنيه كافِرٌ\"."],"grade":"صحيح","narrator":"حذيفة","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه البزار (2807)، وابن حبان (6807)، وابن بشران في (أمالي) (1169) واللفظ لهم","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"PGt4DYfR"},{"id":"س-07470","fp":"c443e13f5951","stateId":360,"easy":"إذا أدركت الدجال فأتِ النهر الذي تراه ناراً ← فإنه ماء بارد","cause":"فلْيَأتِ النَّهَرَ الذي يَراهُ نارًا","result":"فإنَّه ماءٌ باردٌ","explicit":true,"star":true,"similar":["س-01562"],"ref":"تخريج المسند لشعيب 23439","srcLabel":"مسلم","text":["لَأنا أعلَمُ بما مع الدَّجَّالِ مِن الدَّجَّالِ، معه نَهَرانِ يَجْريانِ: أحَدُهما رَأيَ العينِ ماءٌ أبيَضُ، والآخَرُ رأيَ العَينِ نارٌ تأجَّجُ، فإمَّا أدرَكَنَّ أحَدًا منكم ",["فلْيَأتِ النَّهَرَ الذي يَراهُ نارًا",1],"، ولْيُغمِضْ ثم لِيُطَأطِئْ رَأسَه فلْيَشرَبْ؛ ",["فإنَّه ماءٌ باردٌ",2],"، وإنَّ الدَّجَّال مَمْسوحُ العَيْنِ اليُسْرى، عليها ظَفَرةٌ غَليظةٌ، وفيه مَكتوبٌ بيْنَ عَيْنَيهِ: كافِرٌ، يَقرَؤُه كُلُّ مُؤمِنٍ؛ كاتِبٍ وغَيرِ كاتِبٍ."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2934)، وأحمد (23439) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"KIEf4ipW","merged":3,"otherRefs":["الضياء اللامع 57 (صحيح)","صحيح مسلم 2935 (صحيح)"]},{"id":"س-07302","fp":"5d39a49d77e5","stateId":360,"easy":"إذا نجوت من فتنة موت النبي ﷺ وقتل الخليفة والدجال ← فقد نجوت","cause":"مَوْتي، ومِن قَتْلِ خَليفةٍ مُصْطَبِرٍ بالحَقِّ يُعطيه، والدَّجَّالِ","result":"مَن نَجا مِن ثَلاثٍ فقدْ نَجا","explicit":true,"star":true,"ref":"الأحاديث المختارة 9 / 280","srcLabel":"متفق عليه","text":["«",["مَن نَجا مِن ثَلاثٍ فقدْ نَجا",2],"، مَن نَجا مِن ثَلاثٍ فقدْ نَجا، فقالوا: يا رَسولَ اللهِ مَهْ؟ قالَ: ",["مَوْتي، ومِن قَتْلِ خَليفةٍ مُصْطَبِرٍ بالحَقِّ يُعطيه، والدَّجَّالِ",1],"»."],"grade":"صحيح","narrator":"عبدالله بن حوالة الأزدي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"فتن › ظهور الفتن","dorar":"5UhBHNEq"},{"id":"س-07316","fp":"8e15c8270533","stateId":360,"easy":"إذا قرأت سورة الكهف يوم الجمعة ← تُعصم ثمانية أيام من كل فتنة","cause":"مَن قَرَأَ سورةَ الكَهْفِ يَوْمَ الجُمُعةِ","result":"فهو مَعْصومٌ إلى ثَمانِيةِ أيَّامٍ مِن كلِّ فِتْنةٍ تكونُ، فإن خَرَجَ الدَّجَّالُ عُصِمَ مِنه","explicit":true,"star":true,"apply":{"k":"read","t":"سورة الكهف · الوقت: يوم الجمعة أو ليلتها"},"ref":"الأحاديث المختارة 429","srcLabel":"البخاري","text":["«",["مَن قَرَأَ سورةَ الكَهْفِ يَوْمَ الجُمُعةِ ",1],["فهو مَعْصومٌ إلى ثَمانِيةِ أيَّامٍ مِن كلِّ فِتْنةٍ تكونُ، فإن خَرَجَ الدَّجَّالُ عُصِمَ مِنه»",2],"."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"فتن › فتنة الدجال","dorar":"uQAaTRIt"},{"id":"س-01568","fp":"a0adf32fa600","stateId":360,"easy":"إذا ابتُليت بنار الدجال فأغمض عينيك واستغث بالله ← تكون عليك برداً وسلاماً","cause":"فمَن ابتُلِيَ بنارِه فلْيُغمِضْ عَيْنَيه، ولْيَستَغِثْ باللهِ","result":"تكونُ عليه بَرْدًا وسلامًا كما كانت النَّارُ بَرْدًا وسلامًا على إبراهيمَ عليه السَّلامُ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 8845","srcLabel":"مسلم","text":["خطَبَنا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يومًا، فكان أكثَرُ خُطبتِه ذِكرَ الدَّجَّالِ، يُحدِّثُنا عنه حتَّى فرَغَ مِن خُطْبتِه، فكان فيما قال لنا يومئذٍ: إنَّ اللهَ تعالَى لم يَبعَثْ نبيًّا إلَّا حذَّرَ أُمَّتَه الدَّجَّالَ، وإنِّي آخِرُ الأنبياءِ وأنتُم آخِرُ الأُمَمِ، وهو خارجٌ فيكم لا مَحالةَ، فإنْ يَخرُجْ وأنا بيْن أظْهُرِكم فأنا حَجيجُ كلِّ مُسْلمٍ، وإنْ يَخرُجْ فيكم بعْدي فكلُّ امرئٍ حَجيجُ نفْسِه، واللهُ خَلِيفتي على كلِّ مُسْلمٍ، إنَّه يَخرُجُ مِن خَلَّةٍ بيْن العراقِ والشَّامِ، فعاث يَمينًا وعاث شِمالًا، يا عِبادَ اللهِ فاثْبُتوا؛ فإنَّه يَبدَأُ فيَقولُ: أنا نبيٌّ ولا نَبيَّ بعْدي، ثمَّ يُثَنِّي حتَّى يَقولَ: أنا ربُّكم، وإنَّكم لم تَرَوا ربَّكم حتَّى تَموتوا، وإنَّه مَكتوبٌ بيْن عَيْنَيه: كافرٌ، يَقرَؤُه كلُّ مُؤمنٍ، فمَن لَقِيَه منكم فلْيَتفُلْ في وَجْهِه، ولْيَقرَأْ فواتحَ سُورةِ أصحابِ الكهفِ، وإنَّه يُسلَّطُ على نفْسٍ مِن بَني آدَمَ فيَقتُلُها، ثمَّ يُحْيِيها، وإنَّه لا يَعْدو ذلكَ، ولا يُسلَّطُ على نفْسِ غيرِها. وإنَّ مِن فِتنتِه أنَّ معه جنَّةً ونارًا؛ فنارُه جنَّةٌ، وجنَّتُه نارٌ، ",["فمَن ابتُلِيَ بنارِه فلْيُغمِضْ عَيْنَيه، ولْيَستَغِثْ باللهِ",1],"؛ ",["تكونُ عليه بَرْدًا وسلامًا كما كانت النَّارُ بَرْدًا وسلامًا على إبراهيمَ عليه السَّلامُ",2],"، وإنَّ مِن فِتنتِه أنْ يَمُرَّ على الحيِّ فيُؤمِنون به ويُصدِّقونه، فيَدْعو لهم فتُمطِرُ السَّماءُ عليهم مِن يَومِهم، وتُخصِبُ لهم الأرضُ مِن يومِها، وتَروحُ عليهم ماشيِتُهم مِن يومِها أعظَمَ ما كانت وأسْمَنَه، وأمَدَّه خَواصِرَ، وأدَرَّه ضُروعًا، ويَمُرُّ على الحيِّ فيَكفُرون به ويُكذِّبونه، فيَدْعو عليهم فلا يُصبِحُ لهم سارحٌ يَسْرَحُ. وإنَّ أيَّامَه أرْبَعون؛ فيومٌ كسَنةٍ، ويومٌ كشَهرٍ، ويومٌ كجُمعةٍ، ويومُ كالأيَّامِ، وآخِرُ أيَّامِه كالسَّرابِ، تَقْدُرون الأيَّامَ الطِّوالَ ثمَّ تُصَلُّون، يُصبِحُ الرَّجلُ عِندَ بابِ المدينةِ، فيُمْسي قبْلَ أنْ يَبلُغَ بابَها الآخَرَ، قالوا: كيْف نُصلِّي يا رَسولَ اللهِ في تلكَ الأيَّامِ القِصارِ؟ قال: تَقْدُرون فيها ثمَّ تُصَلُّونَ."],"grade":"صحيح","narrator":"أبو  أمامة الباهلي","muhaddith":"صحيح على شرط مسلم، ولم يخرجاه بهذه السياقة","takhrij":"أخرجه ابن ماجه (4077)، والطبراني (8/ 146) (7644) باختلاف يسير.","bab":"أشراط الساعة › صفة الدجال","dorar":"BHzNEMY8"},{"id":"س-05334","fp":"053e0b176096","stateId":360,"easy":"إذا قلت للدجال «لست ربنا، ربنا الله عليه توكلنا...» ← لا يكون له عليك سلطان","cause":"مَن قالَ: لسْتَ رَبَّنا، لكِنَّ رَبَّنا اللهُ، عليه تَوَكَّلْنا وإليه أَنَبْنا، نَعوذُ باللهِ مِن شَرِّك","result":"لم يكن له عليه سُلْطانٌ","explicit":true,"apply":{"k":"say","t":"«لست ربنا، ربنا الله عليه توكلنا...»"},"ref":"الصحيح المسند 1474","srcLabel":"الصحيح المسند","text":["رأيْتُ رَجُلًا بالمَدينةِ وقد طافَ النَّاسُ به وهو يقولُ: قالَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، قالَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، فإذا رَجُلٌ مِن أصْحابِ النَّبيِّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، قالَ: فسَمِعْتُه وهو يقولُ: «إنَّ مِن بَعْدِكم الكَذَّابَ المُضِلَّ، وإنَّ رأسَه مِن بَعْدِه حُبُكٌ حُبُكٌ حُبُكٌ -ثَلاثَ مَرَّاتٍ- وإنَّه سيَقولُ: أنا رَبُّكم، ف",["مَن قالَ: لسْتَ رَبَّنا، لكِنَّ رَبَّنا اللهُ، عليه تَوَكَّلْنا وإليه أَنَبْنا، نَعوذُ باللهِ مِن شَرِّك",1],"؛ ",["لم يكن له عليه سُلْطانٌ",2],"»."],"grade":"صحيح","narrator":"رجل","muhaddith":"صحيح","bab":"رقائق وزهد › التوكل واليقين","dorar":"nxX9Uwvs","merged":2,"otherRefs":["تخريج المسند لشعيب 23487 (صحيح)"]},{"id":"س-07309","fp":"8655f6766b53","stateId":360,"easy":"إذا قرأت عشر آيات من سورة الكهف ← تُعصم من فتنة الدجال","cause":"مَن قرَأ عَشْرَ آياتٍ مِن سورةِ الكهفِ","result":"عُصِم مِن فتنةِ الدَّجَّالِ","explicit":true,"ref":"المنار المنيف 90","srcLabel":"المنار المنيف","text":["حديث  العشرِ آياتٍ من أولِ سورةِ الكهفِ من قرأها عصم من فتنةِ الدجالِ [يعني حديث: ",["مَن قرَأ عَشْرَ آياتٍ مِن سورةِ الكهفِ ",1],["عُصِم مِن فتنةِ الدَّجَّالِ",2],"]"],"grade":"صحيح","narrator":"[أبو الدرداء]","muhaddith":"صحيح","bab":"فتن › فتنة الدجال","dorar":"PGpOahVj","merged":2,"otherRefs":["كشف الخفاء 2/565 (صحيح)"]},{"id":"س-07294","fp":"0695bcb31c8a","stateId":360,"easy":"إذا قرأت سورة الكهف كما أُنزلت ثم خرج الدجال ← لا يُسلّط عليك","cause":"مَن قَرَأ سُورةَ الكهفِ كما أُنزِلَت، ثمَّ خَرَج إلى الدَّجَّالِ","result":"لم يُسلَّطْ عليه، ولم يكُنْ له عليه سَبيلٌ","explicit":true,"apply":{"k":"read","t":"سورة الكهف"},"ref":"المستدرك على الصحيحين 8787","srcLabel":"النسائي","text":["عن أبي سَعيدٍ الخُدْريِّ رَضيَ اللهُ عنه، قال: ",["مَن قَرَأ سُورةَ الكهفِ كما أُنزِلَت، ثمَّ خَرَج إلى الدَّجَّالِ؛ ",1],["لم يُسلَّطْ عليه، ولم يكُنْ له عليه سَبيلٌ",2],"."],"grade":"صحيح","narrator":"قيس بن عبادة","muhaddith":"صحيح الإسناد، ولم يخرجاه","takhrij":"أخرجه النسائي في ((عمل اليوم والليلة)) (954)، والبيهقي في ((الشعب)) (2776)، وعبد الرزاق (730) واللفظ لهم جميعا.","bab":"فتن › ظهور الفتن","dorar":"Lvrcrfdt"},{"id":"س-07305","fp":"83f3e708959e","stateId":360,"easy":"إذا قرأت ثلاث آيات من أول الكهف ← تُعصم من فتنة الدجال","cause":"مَن قرأ ثلاثَ آياتٍ مِن أَوَّلِ الكهف","result":"عُصِمَ من فتنةِ الدَّجَّالِ","explicit":true,"similar":["س-07308"],"ref":"الجامع الصغير 8912","srcLabel":"الترمذي","text":[["مَن قرأ ثلاثَ آياتٍ مِن أَوَّلِ ( الكهف ) ",1],["عُصِمَ من فتنةِ الدَّجَّالِ",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2886)","bab":"فتن › فتنة الدجال","dorar":"RJyH9Prs"},{"id":"س-07308","fp":"e32217a103ea","stateId":360,"easy":"إذا قرأت عشر آيات من الكهف ← تُعصم من الدجال","cause":"من قرأ منها عشرَ آياتٍ","result":"عُصِمَ من الدجالِ","explicit":true,"repOf":"س-07305","ref":"كشف الخفاء 2/565","text":["حديث  الكهفِ ",["من قرأ منها عشرَ آياتٍ ",1],["عُصِمَ من الدجالِ",2]," [يعني حديث: مَن حَفِظَ عَشْرَ آياتٍ مِن أوَّلِ سُورَةِ الكَهْفِ عُصِمَ مِنَ الدَّجَّالِ.]"],"grade":"صحيح","narrator":"[أبو الدرداء]","muhaddith":"صحيح","bab":"فتن › فتنة الدجال","dorar":"n4ihN0w8"},{"id":"س-07313","fp":"b73e639cf9bc","stateId":360,"easy":"إذا قرأت عشر آيات من آخر الكهف ثم خرج الدجال ← لا يضرك","cause":"و مَنْ قرأَ عشرَ آياتٍ من آخِرِها","result":"ثُمَّ خرجَ الدَّجَّالُ لمْ يَضُرَّهُ","explicit":true,"ref":"السلسلة الصحيحة 2651","srcLabel":"النسائي","text":["مَنْ قرأَ سورةَ الكهفِ [ كما أُنْزِلَتْ ] كانَتْ لهُ نُورًا يومَ القيامةِ ، من مَقَامِهِ إلى مكةَ ، ",["و مَنْ قرأَ عشرَ آياتٍ من آخِرِها",1]," ",["ثُمَّ خرجَ الدَّجَّالُ لمْ يَضُرَّهُ",2]," ، و مَنْ تَوَضَّأَ فقال : سبحانَكَ اللهمَّ و بحمدِكَ [ أشهدُ أنْ ] لا إلهَ إلَّا أنتَ ، أستغفرُكَ و أتوبُ إليكَ ، كُتِبَ في رَقٍّ ، ثُمَّ جُعِلَ في طابعٍ ، فلمْ يُكْسَرْ إلى يومِ القيامةِ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9909، 10788) مفرقاً باختلاف يسير، والطبراني في ((المعجم الأوسط)) (1455)، والحاكم (2072) باختلاف يسير","bab":"فتن › فتنة الدجال","dorar":"4Vdm3x5r"},{"id":"س-07315","fp":"1646de45cc3e","stateId":360,"easy":"إذا قرأت عشر آيات من آخر الكهف ← لا يُسلط عليك الدجال","cause":"ومن قرأ عشرَ آياتٍ من آخرِها ثمَّ خرج المسيحُ الدَّجَّالُ","result":"لم يُسلَّطْ عليه","explicit":true,"ref":"الترغيب والترهيب 2/318","srcLabel":"النسائي","text":["من قرأ الكهفَ كما أُنزلتْ كانت له نورًا يومَ القيامةِ من مقامِه إلى مكَّةَ ",["ومن قرأ عشرَ آياتٍ من آخرِها ثمَّ خرج المسيحُ الدَّجَّالُ",1]," ",["لم يُسلَّطْ عليه",2]," ومن توضَّأ ثمَّ قال سبحانَك اللَّهمَّ وبحمدِك لا إلهَ إلَّا أنت أستغفِرُك وأتوبُ إليك كُتِب في رَقٍّ ثمَّ طُبِع بطابعٍ فلم يُكسرْ إلى يومِ القيامةِ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الحاكم (2072) واللفظ له، وأخرجه النسائي في ((السنن الكبرى)) (9909، 10788) مفرقاً باختلاف يسير، والطبراني في ((المعجم الأوسط)) (1455) باختلاف يسير","bab":"فتن › فتنة الدجال","dorar":"eVKEnPL0"},{"id":"س-07507","fp":"36312ed81509","stateId":360,"easy":"إذا قلت للدجال «كذبت، ربي الله عليه توكلت وإليه أنيب» ← لا يضرك","cause":"ومَن قال: كذَبْتَ، ربِّي اللهُ، وعليه تَوكَّلْتُ، وإليه أُنيبُ","result":"فلا يَضُرُّه، أو قال: فلا فِتنةَ عليه","explicit":true,"apply":{"k":"say","t":"«كذبت، ربي الله عليه توكلت وإليه أنيب»"},"ref":"المستدرك على الصحيحين 8775","srcLabel":"أحمد","text":["إنَّ رأْسَ الدَّجَّالِ مِن وَرائِه حُبكٌ حبُكٌ، وإنَّه سيَقولُ: أنا ربُّكم، فمَن قال: أنتَ ربِّي، افتُتِنَ، ",["ومَن قال: كذَبْتَ، ربِّي اللهُ، وعليه تَوكَّلْتُ، وإليه أُنيبُ، ",1],["فلا يَضُرُّه، أو قال: فلا فِتنةَ عليه",2],"."],"grade":"صحيح","narrator":"هشام بن عامر الأنصاري","muhaddith":"صحيح على شرط الشيخين، ولم يخرجاه","takhrij":"أخرجه أحمد (16260)، والطبراني (22/ 175) (456)، وعبد الرزاق (21906) جميعا باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"T5DF5HS0"},{"id":"س-01560","fp":"a689764f3094","stateId":360,"easy":"إذا سمعت بالدجال فابتعد عنه ← تنجو من فتنته","cause":"مَن سَمِعَ بالدَّجَّالِ فليَنْأَ منه","result":"فإنَّ الرَّجُلَ يَأتيه وهو يَحسَبُ أنَّه مؤمنٌ، فلا يَزالُ به لِمَا معه مِن الشُّبَهِ حتى يَتبَعَه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"تخريج المسند لشعيب 19875","srcLabel":"مسلم","text":[["مَن سَمِعَ بالدَّجَّالِ فليَنْأَ منه",1],"، مَن سَمِعَ بالدَّجَّالِ فليَنْأَ منه، مَن سَمِعَ بالدَّجَّالِ فليَنْأَ منه؛ ",["فإنَّ الرَّجُلَ يَأتيه وهو يَحسَبُ أنَّه مؤمنٌ، فلا يَزالُ به لِمَا معه مِن الشُّبَهِ حتى يَتبَعَه",2],"."],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أبو داود (4319)، وأحمد (19875) واللفظ له","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"JGsNuBfb","merged":4,"otherRefs":["تخريج المسند لشعيب 19968 (صحيح)","الآداب الشرعية 1/220 (حسن)","الأحكام الوسطى 4/ 375 (صحيح)"]},{"id":"س-01562","fp":"592ef36c2fc4","stateId":360,"easy":"إذا أدركت الدجال فقع فيما تراه ناراً ← فإنه ماء عذب بارد","cause":"فمن أدرك منكم فليقعْ في الذي يرى أنها نارٌ","result":"فإنه عَذْبٌ باردٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-07470","ref":"صحيح الجامع 2196","text":["إنَّ مع الدَّجَّالِ إذا خرج ماءً و نارًا ، فأما الذي يرى الناسُ أنها النارُ فماءٌ باردٌ ، و أما الذي يرى الناسُ أنها ماءٌ باردٌ فنارٌ تحرقُ ، ",["فمن أدرك منكم فليقعْ في الذي يرى أنها نارٌ",1]," ؛ ",["فإنه عَذْبٌ باردٌ",2]],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح","takhrij":"أخرجه البخاري (3450) واللفظ له، ومسلم (2935) وأبو داود (4315) بنحوه","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"8k5xOiez"},{"id":"س-01070","fp":"63d256e52a1b","stateId":360,"easy":"إذا كان منطقك التسبيح والتقديس زمن الدجال ← يذهب الله عنك الجوع","cause":"فمَن كان مَنطِقُه يومئذٍ التَّسبيحَ والتَّقديسَ","result":"أذْهَبَ اللهُ عنه الجُوعَ، فلم يَخْشَ جُوعًا","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"المستدرك على الصحيحين 8786","srcLabel":"مسلم","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ سُئِلَ عن طَعامِ المُؤمنينَ في زمَنِ الدَّجَّالِ، قال: طَعامُ الملائكةِ، قالوا: وما طَعامُ الملائكةِ؟ قال: طَعامُهم مَنطِقُهم بالتَّسبيحِ والتَّقديسِ، ",["فمَن كان مَنطِقُه يومئذٍ التَّسبيحَ والتَّقديسَ",1],"، ",["أذْهَبَ اللهُ عنه الجُوعَ، فلم يَخْشَ جُوعًا",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح الإسناد على شرط مسلم، ولم يخرجاه","bab":"أدعية وأذكار › فضل الذكر","dorar":"lbnhpS9A"},{"id":"س-00842","fp":"9f3a03605882","stateId":360,"easy":"إذا أدركت فتنة الدجال والجوع فأكثر التسبيح والتكبير والتهليل ← يجزئك عن الطعام","cause":"التسبيحُ والتكبيرُ والتهليلُ","result":"فما طعامُ المؤمنينَ يومئذٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"مجمع الزوائد 7/338","srcLabel":"أحمد","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ذَكَرَ جَهْدًا يكونُ بينَ يَدَيِ الدجالِ فقالوا أيُّ المالِ خيْرٌ يومئِذٍ قال غلامٌ شديدٌ يَسْقِي أهلَهُ الماءَ وأَمَّا الطعامُ فليس قالوا ",["فما طعامُ المؤمنينَ يومئذٍ",2]," قال ",["التسبيحُ والتكبيرُ والتهليلُ",1]," قالَتْ عائِشَةٌ فأينَ العربُ يومئذٍ قال العربُ يومئذٍ قليلٌ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (24944)، وأبو يعلى (4607) واللفظ لهما.","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"DcSN03zV","merged":3,"otherRefs":["سبل الهدى والرشاد 10/173 (حسن)","السلسلة الصحيحة 3079 (حسن)"]},{"id":"س-07292","fp":"0ab994cdf6bf","stateId":360,"easy":"إذا نجوت من الفتن قبل الدجال ← تنجو منه","cause":"يَنجُوَ أحَدٌ ممَّا قَبلَها","result":"إلَّا نَجا منها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشعيب 23304","srcLabel":"أحمد","text":["ذُكِرَ الدَّجَّالُ عندَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فقال: لَأنا لِفِتْنةِ بعضِكم أخوَفُ عندي مِن فِتْنةِ الدَّجَّالِ، ولنْ ",["يَنجُوَ أحَدٌ ممَّا قَبلَها",1]," ",["إلَّا نَجا منها",2],"، وما صُنِعَتْ فِتْنةٌ منذُ كانتِ الدُّنيا صَغيرةٌ ولا كبيرةٌ، إلَّا [تَتَّضِعُ] لِفِتْنةِ الدَّجَّالِ."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (23304) واللفظ له، والبزار (2807)، وابن حبان (6807)","bab":"فتن › ظهور الفتن","dorar":"ACTVkZPw"}]}