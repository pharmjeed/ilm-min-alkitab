{"schema":1,"kind":"sunan-chunk","version":"sunan-50a61695a4db","needId":33,"stateIds":[283,284,285,286,287,288,289],"items":[{"id":"س-05830","fp":"da04f607c77b","stateId":283,"easy":"إذا أصابتك الحمى ← فأبردها بماء زمزم","cause":"فأبْرِدوها بماءِ زَمْزمَ","result":"الحُمَّى مِن فَيْحِ جَهَنَّمَ","explicit":true,"star":true,"similar":["س-05673"],"ref":"المستدرك على الصحيحين 7644","srcLabel":"البخاري","text":["عنْ أبي جَمْرةَ الضُّبَعِيِّ، قالَ: كنتُ أجلِسُ إلى ابنِ عبَّاسٍ بمكَّةَ، ففَقَدَني أيَّامًا، فلمَّا جئتُ قالَ: ما حبَسَكَ؟ قالَ: قلْتُ: حُمِمْتَ، فقال: أبْرِدْها عنكَ بماءِ زَمْزمَ؛ فإنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قالَ: ",["الحُمَّى مِن فَيْحِ جَهَنَّمَ",2],"، ",["فأبْرِدوها بماءِ زَمْزمَ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (3261) باختلاف يسير، وأحمد (2649)، وأبو يعلى (2732) بنحوه","bab":"رقائق وزهد › الوصايا النافعة","dorar":"qvWwTPSe","merged":5,"otherRefs":["صحيح البخاري 5723 (صحيح)","تخريج المسند لشعيب 6010 (صحيح)","تخريج المسند لشعيب 21886 (صحيح)","البشارة العظمى 2/373 (حسن)"]},{"id":"س-07610","fp":"b3dfcb67d476","stateId":283,"easy":"إذا أصابتك الحمى فأبردها بالماء ← فالحمى قطعة من النار","cause":"فأبْرِدُوها عنكم بالماءِ","result":"إنَّ الحُمَّى قِطعةٌ مِنَ النَّارِ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 8448","srcLabel":"الطبراني","text":[["إنَّ الحُمَّى قِطعةٌ مِنَ النَّارِ",2],"؛ ",["فأبْرِدُوها عنكم بالماءِ",1],". قال: وكان رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ إذا حُمَّ دَعا بقِربةٍ مِن ماءٍ، فأفْرَغَها على قَرْنِه، فاغتسَلَ."],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"صحيح الإسناد ولم يخرجاه بهذه الزيادة.","takhrij":"أخرجه الطبراني  (7/ 227) (6947)، والطحاوي في ((شرح مشكل الآثار)) (1857) بلفظه.","bab":"فضائل النبي وصفته ودلائل النبوة › مرض النبي وموته","dorar":"dWkbMStP","merged":8,"otherRefs":["صحيح مسلم 2212 (صحيح)","تخريج المسند لشعيب 24598 (صحيح)","تخريج مشكل الآثار 1859 (صحيح)","صحيح البخاري 5726 (صحيح)","صحيح ابن ماجه 2814 (صحيح)","صحيح الترمذي 2073 (صحيح)"]},{"id":"س-03627","fp":"8f97ecce7ed6","stateId":283,"easy":"إذا حُممت فبرّدها بالماء ← (علاج نبوي)","cause":"قد حُمَّتْ","result":"أنْ نُبرِّدَها بالماءِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج مشكل الآثار 1855","srcLabel":"البخاري","text":["عن أسماءَ ابنةِ أبي بَكرٍ، أنَّها كانت إذا أُتِيَتْ بالمرأةِ ",["قد حُمَّتْ",1]," تَدْعو لها، أَخَذَتِ الماءَ فصَبَّتْه بينَها وبينَ جَيبِها، وقالت: إنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ كان يأمُرُنا ",["أنْ نُبرِّدَها بالماءِ",2],"."],"grade":"صحيح","narrator":"أسماء بنت أبي بكر","muhaddith":"إسناده صحيح على شرطهما","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (1855)، والبخاري (5724)، والطبراني (24/ 123) (332) بلفظه.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"JICCg8mB"},{"id":"س-04552","fp":"12b66c4f9f61","stateId":283,"easy":"إذا وُعكت فابرد حماك بالماء ← (علاج نبوي)","cause":"ابرُدوها بالماءِ","result":"بالمَرأةِ المَوعوكةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح مسلم 2211","srcLabel":"البخاري","text":["أنَّها كانَت تُؤتى ",["بالمَرأةِ المَوعوكةِ",2],"، فتَدعو بالماءِ فتَصُبُّه في جَيبِها، وتَقولُ: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: ",["ابرُدوها بالماءِ",1],"، وقال: إنَّها مِن فَيحِ جَهَنَّمَ. وفي روايةٍ: صَبَّتِ الماءَ بينَها وبينَ جَيبِها، ولَم يَذكُرْ في حَديثِ أبي أُسامةَ أنَّها مِن فَيحِ جَهَنَّمَ."],"grade":"صحيح","narrator":"أسماء بنت أبي بكر","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5724) باختلاف يسير","bab":"جهنم › شدة نار جهنم وبعد قعرها","dorar":"KTuchLV4"},{"id":"س-05673","fp":"e3930de0218e","stateId":283,"easy":"إذا أصابتك الحمى ← فأبردها بالماء البارد","cause":"بالماءِ البارِدِ","result":"فنحُّوها عنكُم","explicit":true,"repOf":"س-05830","ref":"مصباح الزجاجة 4/61","text":["الحمَّى كيرٌ من كيرِ جَهَنَّمَ، ",["فنحُّوها عنكُم",2]," ",["بالماءِ البارِدِ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح رجاله ثقات","takhrij":"أخرجه ابن ماجه (3475)، وابن أبي الدنيا في ((المرض والكفارات)) (120) بلفظه، والطبراني في ((المعجم الأوسط)) (3990) باختلاف يسير.","bab":"رقائق وزهد › الصبر على البلاء","dorar":"KgrhPxkv"},{"id":"س-03599","fp":"5f1c8a2f73b4","stateId":283,"easy":"إذا حُممت فصبّ عليك الماء المبرد ← (علاج نبوي)","cause":"إذا حُمَّ الزُّبَيْرُ","result":"أن يُبَرَّدَ له ماءٌ ثُمَّ نَصُبَّه عليه","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"الأحكام الوسطى 4/ 231","srcLabel":"الترمذي","text":["كانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يَأمُرُنا ",["إذا حُمَّ الزُّبَيْرُ",1]," ",["أن يُبَرَّدَ له ماءٌ ثُمَّ نَصُبَّه عليه",2],"."],"grade":"صحيح","narrator":"أم خالد بنت سعيد","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه الترمذي في ((العلل الكبير)) (590)، وابن أبي خيثمة في ((التاريخ الكبير)) (3380)، والخطيب في ((موضح أوهام الجمع والتفريق)) (1/ 506) ثلاثتهم باختلاف يسير.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"QfmTqFY1","merged":2,"otherRefs":["الأحكام الشرعية الصغرى 836 (صحيح)"]},{"id":"س-03108","fp":"77c282e90259","stateId":283,"easy":"إذا أصابتك الحمى والأوجاع فقل «بسم الله الكبير...» ← تُشفى","cause":"بِسمِ اللهِ الكبيرِ، أعوذُ باللهِ العظيمِ، منْ شرِّ كلِّ عِرْقٍ يُعَارُ , وَمِنْ شَرِّ حَرِّ النَّارِ","result":"من الحُمَّى و الأوجاعِ كلِّها","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"apply":{"k":"say","t":"«بِسمِ اللهِ الكبيرِ، أعوذُ باللهِ العظيمِ، منْ شرِّ كلِّ عِرْقٍ يُعَارُ , وَمِنْ شَرِّ حَرِّ النَّار»"},"ref":"الجامع الصغير 7093","srcLabel":"الترمذي","text":["كانَ يعلِّمَهم ",["من الحُمَّى و الأوجاعِ كلِّها",2]," أنْ يقولوا : ",["بِسمِ اللهِ الكبيرِ، أعوذُ باللهِ العظيمِ، منْ شرِّ كلِّ عِرْقٍ يُعَارُ , وَمِنْ شَرِّ حَرِّ النَّارِ",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2075)، وابن ماجه (3526)، وأحمد (2729) باختلاف يسير","bab":"إيمان › توحيد الأسماء والصفات","dorar":"bHmIRyXC"},{"id":"س-02713","fp":"9311a0256135","stateId":283,"easy":"إذا أصابتك الحمى فصب عليك الماء البارد ← تبرد","cause":"فلْيُشَنَّ عليه الماءُ البارِدُ ثلاثَ ليالٍ مِن السَّحَرِ","result":"إذا حُمَّ أحَدُكم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"الأحاديث المختارة 2043","srcLabel":"البخاري","text":["«",["إذا حُمَّ أحَدُكم",2]," ",["فلْيُشَنَّ عليه الماءُ البارِدُ ثلاثَ ليالٍ مِن السَّحَرِ",1],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"إيمان › السحر والنشرة والكهانة","dorar":"230ZpFsT","merged":2,"otherRefs":["سبل الهدى والرشاد 12/161 (حسن)"]},{"id":"س-01656","fp":"1c2850f1a94e","stateId":284,"easy":"إذا أكلت عجوة العالية على الريق ← فهي شفاء من كل سحر أو سم","cause":"في عجوةِ العالِيَةِ أوَّلُ البُكْرَةِ ، عَلَى ريقِ النَّفْسِ","result":"شفاءٌ مِنْ كُلِّ سِحْرٍ أَوْ سُمٍّ","explicit":true,"star":true,"otherNeedIds":[30],"ref":"صحيح الجامع 4262","srcLabel":"مسلم","text":[["في عجوةِ العالِيَةِ أوَّلُ البُكْرَةِ ، عَلَى ريقِ النَّفْسِ",1]," ، ",["شفاءٌ مِنْ كُلِّ سِحْرٍ أَوْ سُمٍّ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2048)، والنسائي في ((السنن الكبرى)) (6714) بنحوه، وأحمد (24735) واللفظ له","bab":"أطعمة › ما يحل من الأطعمة","dorar":"kGYzKbUM"},{"id":"س-03615","fp":"db00dff21996","stateId":284,"easy":"إذا خفت العين على أولادك فارقهم ← يُحفظون","cause":"العينَ تُسرِعُ إليهِم","result":"فقالَ: ارقيهِم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[30],"ref":"نخب الافكار 14/195","srcLabel":"مسلم","text":["أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ لأسماءَ بنتِ عُمَيْسٍ: ما لي أرَى أجسامَ بَني أخي صارعةً نَحيفةً أتُصيبُهُمُ الحاجَةُ قالَت: لا، ولَكِنَّ ",["العينَ تُسرِعُ إليهِم",1],"، أفأَرقيهِم فقالَ: بِماذا ؟ فعرَضتُ عليهِ كلامًا لا بأسَ بِهِ ",["فقالَ: ارقيهِم",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (2198)، وأحمد (14573)، والطحاوي في ((شرح معاني الآثار)) (7188) جميعهم بلفظه.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"9IE4OYmo","merged":2,"otherRefs":["الاستذكار 7/409 (صحيح)"]},{"id":"س-03643","fp":"4368a6f3fbf7","stateId":284,"easy":"إذا أصاب أحداً العين فتوضأ العائن ← ثم يغتسل منه المعين فيبرأ","cause":"يُؤمَرُ العائنُ فيتوضَّأُ","result":"ثمَّ يغتسِلُ منهُ المَعينُ","explicit":true,"star":true,"otherNeedIds":[30],"ref":"صحيح أبي داود 3880","srcLabel":"أبو داود","text":["عَن عائشةَ رضيَ اللَّهُ عنها، قالَت : كانَ ",["يُؤمَرُ العائنُ فيتوضَّأُ",1]," ",["ثمَّ يغتسِلُ منهُ المَعينُ",2]],"grade":"صحيح","narrator":"الأسود بن يزيد","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3880)، والبيهقي (20103)","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"eyudbp13","merged":3,"otherRefs":["إتحاف الخيرة المهرة 4/ 458 (حسن)","تخريج مشكل الآثار 2893 (صحيح)"]},{"id":"س-05911","fp":"a2ab49dfe2d0","stateId":284,"easy":"إذا احتجمت ← تذهب الدم وتجلو البصر وتخفف الصلب","cause":"الحِجامةُ","result":"تُذهِبُ الدَّمَ، وتَجْلو البصَرَ، وتُخِفُّ الصُّلبَ","explicit":true,"ref":"المستدرك على الصحيحين 8478","srcLabel":"الترمذي","text":["نِعمَ الدَّواءُ ",["الحِجامةُ",1],"؛ ",["تُذهِبُ الدَّمَ، وتَجْلو البصَرَ، وتُخِفُّ الصُّلبَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد، ولم يخرجاه","takhrij":"أخرجه الترمذي (2053)، وابن ماجه (3478)، والطبراني(11893) (11/  326) بلفظ مقارب","bab":"رقائق وزهد › الوصايا النافعة","dorar":"fs6rH6mH","merged":3,"otherRefs":["الجامع الصغير 9253 (صحيح)","المستدرك على الصحيحين 7690 (صحيح)"]},{"id":"س-05942","fp":"2c4f0cfef238","stateId":284,"easy":"إذا تداويت بالحجامة ← فهي مما يصيب الداء","cause":"ففي الحِجامةِ","result":"إنَّ كلَّ شيءٍ مما تُعالجون به يصيبُ الدَّاءَ","explicit":true,"ref":"مسند ابن عباس 1/502","srcLabel":"السنة","text":["أَنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ أنه قال ",["إنَّ كلَّ شيءٍ مما تُعالجون به يصيبُ الدَّاءَ",2]," أو يطلبُ الدَّاءَ ",["ففي الحِجامةِ",1]],"grade":"صحيح","narrator":"أبو قتادة","muhaddith":"إسناده صحيح","takhrij":"لم نقف عليه إلا عند الطبري في ((تهذيب الآثار)) (1/ 502).","bab":"رقائق وزهد › الوصايا النافعة","dorar":"FIUB4vYp","merged":3,"otherRefs":["تخريج المسند لشعيب 8513 (صحيح)","تخريج سنن أبي داود 3857 (صحيح)"]},{"id":"س-04328","fp":"4036960cf4b5","stateId":284,"easy":"إذا أكلت العجوة ← فهي شفاء من السم","cause":"والعَجْوةُ من الجَنَّةِ","result":"وهي شِفاءٌ من السُّمِّ","explicit":true,"similar":["س-07126"],"ref":"تخريج المسند لشعيب 11453","srcLabel":"النسائي","text":["الكَمْأَةُ من المَنِّ، وماؤُها شِفاءٌ للعَينِ، ",["والعَجْوةُ من الجَنَّةِ",1],"، ",["وهي شِفاءٌ من السُّمِّ",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (6674) مختصراً، وابن ماجه (3453)، وأحمد (11453) واللفظ له","bab":"جنة › صفة الجنة","dorar":"Rf5p9JN9","merged":2,"otherRefs":["تخريج المسند لشعيب 8681 (حسن)"]},{"id":"س-07263","fp":"47266e01499f","stateId":284,"easy":"إذا أعجبك شيء من أخيك فادعُ له بالبركة ← لا تقتله بعينك","cause":"فليَدعُ بالبَرَكةِ","result":"عَلامَ يَقتُلُ أحَدُكُم أخاه","explicit":true,"ref":"سبل الهدى والرشاد 12/167","srcLabel":"النسائي","text":["أنَّ رَسولَ اللهِ صلَّى الله عليه وسلَّم خَرَجَ وسارَ نَحوَ مَكَّةَ حَتَّى إذا كان بشِعبِ الخَرَّارِ مِنَ الجُحفةِ قال عامِرٌ: انطَلَقتُ أنا وسَهلُ بنُ حُنَيفٍ نَلتَمِسُ الخَمرَ، فوجَدَ خَمرًا وغَديرًا، وكان أحَدُنا يَستَحي أن يَغتَسِلَ وأحَدٌ يَراه، فاستَتَرَ مِنِّي حَتَّى إذا رَأى أن قد فعَلَ نَزع جُبَّتَه عليه مِن كِساءٍ ثُمَّ دَخَلَ الماءَ، فنَظَرتُ إليه نَظرةً، فأعجَبَني خَلقُه، قال مُحَمَّدٌ: وكان سَهلٌ شَديدَ البَياضِ حَسَنَ الخَلقِ، وقال سَهلٌ: فقال عامِرٌ: ما رَأيتُ كاليَومِ ولا جِلدَ مُخَبَّأةٍ! فلُبِطَ به حَتَّى ما يَعقِلُ مِن شِدَّةِ الوجَعِ! وقال عامِرٌ: فأصَبتُه بعَيني فأخذه قَعقَعةٌ وهو في الماءِ، فانطَلَقتُ إلى رَسولِ اللهِ صلَّى الله عليه وسلَّم فأخبَرتُه الخَبَرَ، وقال مُحَمَّدٌ: فوُعِكَ سَهلٌ مَكانَه، فاشتَدَّ وعكُه، فأُخبِرَ رَسولُ اللهِ صلَّى الله عليه وسلَّم وقيلَ له: هَل لَك في سَهلٍ؟ ما يَرفعُ رَأسَه! وكان قدِ اكتُتِبَ في جَيشٍ، فقالوا: هو غَيرُ رابحٍ مَعَك يا رَسولَ اللهِ، واللهِ ما يُفيقُ، قال عامِرٌ: فقال رَسولُ اللهِ صلَّى الله عليه وسلَّم: قوموا، فأتاه فرفعَ عَن ساقِه، ثُمَّ دَخَلَ إليه الماءَ، فلَمَّا أتاه ضَربَ صَدرَه، فقال: «اللهُمَّ أذهِبْ حَرَّها وبَردَها ووصَبَها» ثُمَّ قال: «قُمْ» فقامَ، وفي حَديثِ مُحَمَّدٍ والزُّهريِّ فقال: «مَن تَتَّهمونَ به؟» فقال: عامِرٌ، فدَعاه رَسولُ اللهِ صلَّى الله عليه وسلَّم فتَغيَّظ عليه، وقال: «",["عَلامَ يَقتُلُ أحَدُكُم أخاه",2],"؟ إذا رَأى أحَدُكُم مِن أخيه ما يُعجِبُه ",["فليَدعُ بالبَرَكةِ",1],"»، وفي رِوايةٍ: «ألَا بَرَّكتَ» ثُمَّ دَعا بماءٍ في قَدَحٍ، فأمر عامِرٌ أن يَتَوضَّأَ، فغَسَلَ وجهَه ويَدَيه ومَرفِقَيه ورُكبَتَيه وأطرافَ قدَمَيه وداخِلةَ إزارِه في قَدَحِ، وأمرَه أن يَصُبَّ الماءَ عليه مِن حَلقِه على رَأسِه وظَهرِه، ثُمَّ يَكفي القدَحَ وراءَه، ففعَلَ به مِثلَ ذلك، فراحَ سَهلٌ مَعَ النَّاسِ ليس به بَأسٌ"],"grade":"صحيح","narrator":"سهل بن حنيف","muhaddith":"[رجاله] رجال الصحيح","takhrij":"أخرجه أحمد (15700)، والنسائي في ((السنن الكبرى)) (7469)، والطبراني (6/ 81) (5579)، والحاكم (7500) جميعا بنحوه.","bab":"غسل › التستر في الغسل","dorar":"DXIjPK0q","merged":2,"otherRefs":["صحيح ابن حبان 6105 (صحيح)"]},{"id":"س-07126","fp":"47dc911af636","stateId":284,"easy":"إذا أكلت العجوة ← فهي دواء من كل سم","cause":"عليكم بالعَجْوَةِ","result":"فإنها دواءٌ من كلِّ سُمٍّ","explicit":true,"repOf":"س-04328","ref":"البحر الزخار 6/30","text":["عليكم بالحَبَّةِ السَّوْدَاءِ ؛ فإنَّ فيها شِفَاءً من كلِّ داءٍ إلا السَّامَ ، قالوا : وما السَّامُ ؟ قال : الموتُ ، ",["عليكم بالعَجْوَةِ",1]," ؛ ",["فإنها دواءٌ من كلِّ سُمٍّ",2]," ، عليكم بأَلْبَانِ الإبِلِ البَرِّيَّةِ ؛ فإنها دواءٌ من كلِّ داءٍ"],"grade":"صحيح","narrator":"صهيب بن سنان الرومي","muhaddith":"محفوظ","takhrij":"أخرجه أبو نعيم في ((الطب النبوي)) (377) واللفظ له مختصرا.","bab":"علم › حسن السؤال ونصح العالم","dorar":"rXLTiIX5"},{"id":"س-08188","fp":"9f0cfe712fc2","stateId":284,"easy":"إذا سُحرت فاقرأ المعوذتين ← يُحل السحر وتبرأ","cause":"فنزل عليه بالمُعوِّذتَيْن","result":"كلَّما حلَّ عُقدةً وجد لذلك خفَّةَ فبرأ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[30],"ref":"السلسلة الصحيحة 2761","srcLabel":"النسائي","text":["كان رجلٌ [ من اليهودِ ] يدخلُ على النَّبيِّ ، [ وكان يأمنُه ] ، فعقد له عقدًا ، فوضعه في بئرِ رجلٍ من الأنصارِ ، [ فاشتكَى لذلك أيَّامًا ، وفي حديثِ عائشةَ : ستَّةً أشهُرٍ ) ] ، فأتاه ملَكان يعودانه ، فقعد أحدُهما عند رأسِه ، والآخرُ عند رِجلَيْه ، فقال أحدُهما : أتدري ما وجعُه ؟ قال : فلانٌ الَّذي [ كان ] يدخُلُ عليه عقد له عُقَدًا ، فألقاه في بئرِ فلانٍ الأنصاريِّ ، فلو أرسل [ إليه ] رجلًا، وأخذ [ منه ] العَقَدَ لوجد الماءَ قد صُفِّر [ فأتاه جبريلُ ",["فنزل عليه بالمُعوِّذتَيْن",1]," ) ، وقال : إنَّ رجلًا من اليهودِ سحرك ، والسِّحرُ في بئرِ فلانٍ ، قال : ] فبعث رجلًا وفي طريقٍ أخرَى : فبعث عليًّا ) [ فوجد الماءَ قد اصفَرَّ ] فأخذ العُقَدَ [ فجاء بها ] ، [ فأمره أن يحِلَّ العُقَدَ ويقرأَ آيةً ] ، فحلَّها ، [ فجعل يقرأُ ويحِلُّ ] ، [ فجعل ",["كلَّما حلَّ عُقدةً وجد لذلك خفَّةَ ] فبرأ",2]," ، (وفي الطَّريقِ الأخرَى : فقام رسولُ اللهِ كأنَّما نشط من عِقالٍ ) ، وكان الرَّجلُ بعد ذلك يدخلُ على النَّبيِّ صلى الله عليه وسلم، فلم يذكُرْ له شيئًا منه ، و لم يعاتِبْه [ قطُّ حتَّى مات ]"],"grade":"صحيح","narrator":"زيد بن أرقم","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (5/ 179)، (5011) باختلاف يسير، والنسائي (4080)، وأحمد (19267) كلاهما مختصرا ببعض لفظه.","bab":"ملائكة › أعمال الملائكة","dorar":"wdaL7rgU","merged":2,"otherRefs":["تخريج مشكل الآثار 5935 (صحيح)"]},{"id":"س-00442","fp":"d5ae9e8305ce","stateId":284,"easy":"إذا أُصبت بالعين فاغتسل العائن لك ← تبرأ (من واقعة)","cause":"اغتسِلْ لهُ فغسل وجهَه ويديْهِ ومرفقيْهِ وركبتيْهِ وأطرافَ رجليْهِ وداخلةَ إزارِه في قدحٍ ثم صب ذلك الماءَ عليه","result":"فراح سهلٌ مع الناسِ ليس به بأسٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 5/110","srcLabel":"أحمد","text":["أنَّ النبيَّ صلَّى اللهُ عليه وسلَّمَ خرج معه وسار معَهُ نحوَ مكةَ حتى إذا كان بشِعبِ الخزارِ من الجحفةِ اغتسل سهلُ بنُ حنيفٍ وكان أبيضَ حسنَ الجسمِ والجلدِ فنظر إليه عامرُ بنُ ربيعةَ أخو بني عديِّ بنِ كعبٍ وهو يغتسلُ فقال ما رأيتُ كاليومِ ولا جلدَ مخبأةٍ فلبطَ سهلٌ فأتى رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فقيل يا رسولَ اللهِ هل لك في سهلٍ واللهِ ما يرفعُ رأسَه ولا يفيقُ قال هل تتهمون فيه من أحدٍ قالوا عامرُ بنُ ربيعةَ فدعا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ عامرَ بنَ ربيعةَ فتغيَّظَ عليه وقال علامَ يقتلُ أحدَكم أخاهُ هلا إذا رأيتَ ما يُعجبُك برَّكتَ ثم قال ",["اغتسِلْ لهُ فغسل وجهَه ويديْهِ ومرفقيْهِ وركبتيْهِ وأطرافَ رجليْهِ وداخلةَ إزارِه في قدحٍ ثم صب ذلك الماءَ عليه",1]," يصبُّهُ رجلٌ على رأسِه وظهرِه من خلفِه ثم يُلْقِي القدحَ وراءَه ففعل به ذلك ",["فراح سهلٌ مع الناسِ ليس به بأسٌ",2]],"grade":"صحيح","narrator":"سهل بن حنيف","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (6/ 78) (5573) واللفظ له، وأحمد (15980) بنحوه، وابن أبي عاصم في ((الآحاد والمثاني)) (1910) مختصرًا.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"YAaku3UT"},{"id":"س-02711","fp":"d0112e400560","stateId":284,"easy":"إذا سُحرت فحُلّت العقد ← تجد الخفة","cause":"وحَلَّ العُقَدَ","result":"فوجد لذلك خفَّةً","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[30],"ref":"تخريج الإحياء للعراقي 2/465","srcLabel":"النسائي","text":["سحَرَه رجُلٌ مِنَ اليهودِ, فأخبره جبريلُ عليه أفضلُ الصَّلاةُ والسَّلامُ بذلك، حتَّى استخرجه ",["وحَلَّ العُقَدَ",1],"؛ ",["فوجد لذلك خفَّةً",2],", وما ذكَرَ ذلك لليهوديِّ، ولا أظهَرَه عليه قَطُّ."],"grade":"صحيح","narrator":"زيد بن أرقم","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (5/ 180) (5016) بلفظه، النسائي (4080)، وأحمد (19267)، والطحاوي في ((شرح مشكل الآثار)) (5935) جميعا بنحوه.","bab":"إيمان › السحر والنشرة والكهانة","dorar":"oUm6GSD6"},{"id":"س-07378","fp":"ca373dad840f","stateId":284,"easy":"إذا رأيت ما يعجبك فبرّك ← لا تصيب أخاك بالعين","cause":"أَلَا برَّكْتَ","result":"فراحَ مَعَ النَّاسِ، ليسَ بهِ بأسٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج شرح السنة 3245","srcLabel":"النسائي","text":["رَأَى عامِرُ بنُ رَبيعةَ سَهْلَ بنَ حُنَيْفٍ يغتسِلُ، فقالَ: واللَّهِ ما رأيتُ كاليَومِ، ولا جِلْدَ مُخَبَّأَةٍ، قالَ: فَلُبِطَ سهلٌ، فأُتِيَ رسولُ اللَّهِ صلَّى اللهُ عليه وسلَّمَ، فقيلَ لَهُ: يا رسولَ اللَّهِ، هَلْ لكَ في سهلِ بنِ حُنَيْفٍ؟ واللَّهِ ما يرفَعُ رأسَهُ، فقالَ: هَلْ تتَّهِمونَ لهُ أحدًا؟ فقالوا: نتَّهِمُ عامِرَ بنَ رَبيعةَ، قالَ: فدَعا رسولُ اللَّهِ صلَّى اللهُ عليه وسلَّمَ عامرًا، فتغلَّظَ عليهِ، فقالَ: عَلامَ يقتُلُ أحَدُكُمْ أخاهُ؟ ",["أَلَا برَّكْتَ",1],"؟ اغتسِلْ لهُ، فغسَلَ لهُ عامِرٌ وجهَهُ، ويدَيْهِ ومِرْفَقَيْهِ، ورُكْبَتَيْهِ، وأطرافَ رِجلَيْهِ، وداخِلةَ إزارِهِ في قَدَحٍ، ثُمَّ صُبَّ عليهِ، ",["فراحَ مَعَ النَّاسِ، ليسَ بهِ بأسٌ",2],"."],"grade":"صحيح","narrator":"أبو أمامة بن سهل بن حنيف","muhaddith":"رجاله ثقات، وإسناده صحيح،","takhrij":"أخرجه ابن ماجه (3509)، ومالك (5/1373)، والنسائي في ((السنن الكبرى)) (7571) باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › أحوال النبي","dorar":"meltmAaR"},{"id":"س-02748","fp":"279ebea4a72e","stateId":284,"easy":"إذا سُحرت فحُلّت العقد ← تبرأ كأنما نُشطت من عقال","cause":"فحَلَّها","result":"كأنَّما نُشِطَ مِن عِقالٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"otherNeedIds":[30],"ref":"الصحيح المسند 342","srcLabel":"السنة","text":["سحَر النَّبيَّ صلَّى اللهُ عليه وعلى آلِه وسلَّم رجُلٌ مِن اليهودِ، قال: فاشتكى لذلكَ أيَّامًا، قال: فجاء جِبْريلُ عليه السَّلامُ فقال: إنَّ رجُلًا مِن اليهودِ سحَركَ؛ عقَد لكَ عُقَدًا في بِئرِ كذا وكذا، فأرسِلْ إليها مَن يجِيءُ بها، فبعَث رسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّم عليًّا رضِي اللهُ عنه، فاستخرَجها، فجاء بها ",["فحَلَّها",1],"، قال: فقام رسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّم ",["كأنَّما نُشِطَ مِن عِقالٍ",2],"، فما ذكَر لذلكَ اليهوديِّ، ولا رآه في وجهِه حتَّى ماتَ."],"grade":"صحيح","narrator":"زيد بن أرقم","muhaddith":"صحيح","bab":"إيمان › الملائكة","dorar":"y9yLMoLq"},{"id":"س-04150","fp":"6cf8430ba381","stateId":285,"easy":"إذا اكتحلت بالإثمد ← يجلو بصرك وينبت الشعر","cause":"وإنَّ مِن خَيرِ أَكحالِكم الإثمِدَ","result":"إنَّه يَجلو البَصَرَ، ويُنبِتُ الشَّعرَ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 3035","srcLabel":"مسلم","text":["قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: البَسوا مِن ثيابِكم البيضَ؛ فإنَّها مِن خَيرِ ثيابِكم، وكَفِّنوا فيها مَوتاكم، ",["وإنَّ مِن خَيرِ أَكحالِكم الإثمِدَ",1],"؛ ",["إنَّه يَجلو البَصَرَ، ويُنبِتُ الشَّعرَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده قوي على شرط مسلم","takhrij":"أخرجه أبو داود (3878) باختلاف يسير، والترمذي (1757، 994)، وابن ماجه (3497، 1472) مفرقاً، والنسائي (5113) مختصراً، وأحمد (3035) واللفظ له","bab":"جنائز وموت › صفة الكفن","dorar":"NadluRWE","merged":7,"otherRefs":["شرح كتاب الشهاب 549 (صحيح)","صحيح الجامع 3305 (صحيح)","الأحاديث المختارة 10 / 199 (صحيح)","الأحاديث المختارة 10 / 198 (صحيح)","السلسلة الصحيحة 724 (صحيح)","صحيح الترمذي 1757 (صحيح)"]},{"id":"س-03595","fp":"bd6af9bc03b2","stateId":285,"easy":"إذا أصاب صبيك وجع الحلق أو الرأس ← فداوه بالقسط الهندي فيبرأ","cause":"بِصَبِيِّهَا عُذْرةٌ أوْ وَجَعٌ برأسِهِ","result":"فلْتأخُذْ قُسْطًا هِنْديًّا. قالَ: وأمَرَ عائشةَ، ففعَلَتْ ذلك فبَرَأَ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 7661","srcLabel":"مسلم","text":["كانَتْ عندَ أُمِّ المؤمِنينَ عائشةَ رَضيَ اللهُ عنها [امْرَأَةٌ مَعَهَا] صَبِيٌّ يقْطُرُ مِنْخراهُ دمًا، فدَخَلَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فقال: ما شأْنُ هذا الصَّبِيِّ؟ قالتْ: بهِ العُذْرةُ، فقال: وَيْحَكُنَّ يا مَعشَرَ النِّساءِ! لا تَقْتُلْنَ أولادَكُنَّ، وأيُّ امرأةٍ [",["بِصَبِيِّهَا] عُذْرةٌ أوْ وَجَعٌ برأسِهِ",1],"، ",["فلْتأخُذْ قُسْطًا هِنْديًّا. قالَ: وأمَرَ عائشةَ، ففعَلَتْ ذلك فبَرَأَ",2],"."],"grade":"صحيح","narrator":"جابر","muhaddith":"صحيح على شرط مسلم","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"OBDqdhmz"},{"id":"س-05351","fp":"1d011a9cbdc8","stateId":285,"easy":"إذا اشتكيت بطنك فاشرب العسل ← تبرأ","cause":"اسْقِه عسَلًا","result":"فسَقاه فبرَأ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"apply":{"k":"time","t":"عند المرض والوجع"},"ref":"تخريج المسند لشعيب 11146","srcLabel":"متفق عليه","text":["جاء رجُلٌ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فقال: يا رسولَ اللهِ، إنَّ أخي استَطلَق  بَطنُه، قال: \"",["اسْقِه عسَلًا",1],"\"، فذهَب ثُم جاء، فقال: قد سَقَيْتُه فلم يَزِدْه إلَّا استِطْلاقًا، قال: \"اسْقِه عسَلًا\"، فذهَب ثُم جاء، فقال: قد سَقَيْتُه فلم يَزِدْه إلَّا استِطْلاقًا، قال: \"اسْقِه عسَلًا\"، قال: فذهَب ثُم جاء، فقال: قد سَقَيْتُه فلم يَزِدْه إلَّا استِطْلاقًا، فقال له في الرابعةِ: \"اسْقِه عسَلًا\"، قال: أَظُنُّه قال: ",["فسَقاه فبرَأ",2],"، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ في الرابعةِ: \"صدَق اللهُ، وكذَب بَطنُ أخيكَ\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (5684)، ومسلم (2217)، والترمذي (2082)، والنسائي في ((السنن الكبرى)) (6705)، أحمد (11146) واللفظ له","bab":"رقائق وزهد › التوكل واليقين","dorar":"p3YgHWHK","merged":3,"otherRefs":["صحيح البخاري 5684 (صحيح)","المستدرك على الصحيحين 8440 (صحيح)"]},{"id":"س-07949","fp":"0da297c0cfdb","stateId":285,"easy":"إذا مرضت في قلبك (مفؤوداً) فكل سبع تمرات عجوة بنواهن ← تُشفى (وصف نبوي)","cause":"فلْيَأخُذْ سَبْعَ تَمَراتِ عَجْوةٍ مِن عَجْوةِ المَدينةِ فلْيَجَأْهنَّ بنَواهنَّ، ثُمَّ لِيَدْلُكْ بِهنَّ","result":"إنَّك رَجُلٌ مَفْؤودٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"الأحاديث المختارة 1050","srcLabel":"البخاري","text":["«مَرِضْتُ مَرَضًا شَديدًا، قالَ: فجاءَني رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يَعودُني، فوَضَعَ يَدَه بَيْنَ ثدْيَيَّ حتَّى وَجَدْتُ بَرْدَها على فُؤادي، فقالَ: ",["إنَّك رَجُلٌ مَفْؤودٌ",2],"، ائْتِ الحارِثَ بنَ كَلَدةَ أخا ثَقيفٍ فإنَّه رَجُلٌ يَتَطَبَّبُ، فمُرْه ",["فلْيَأخُذْ سَبْعَ تَمَراتِ عَجْوةٍ مِن عَجْوةِ المَدينةِ فلْيَجَأْهنَّ بنَواهنَّ، ثُمَّ لِيَدْلُكْ بِهنَّ",1],"»."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"nHNroOXa","merged":2,"otherRefs":["سفر السعادة 293 (صحيح)"]},{"id":"س-04327","fp":"c34361524e49","stateId":285,"easy":"إذا استعملت ماء الكمأة ← فهو شفاء للعين","cause":"الكَمْأَةُ من المَنِّ، وماؤُها","result":"شِفاءٌ للعَينِ","explicit":true,"star":true,"similar":["س-01639"],"ref":"تخريج المسند لشعيب 11453","srcLabel":"النسائي","text":[["الكَمْأَةُ من المَنِّ، وماؤُها",1]," ",["شِفاءٌ للعَينِ",2],"، والعَجْوةُ من الجَنَّةِ، وهي شِفاءٌ من السُّمِّ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (6674) مختصراً، وابن ماجه (3453)، وأحمد (11453) واللفظ له","bab":"جنة › صفة الجنة","dorar":"Rf5p9JN9","merged":3,"otherRefs":["الجامع الصغير 6446 (صحيح)","تخريج المسند لشعيب 8681 (حسن)"]},{"id":"س-05940","fp":"1856e96da793","stateId":285,"easy":"إذا شربت ألبان البقر واستعملت سمنها ← فهي دواء وشفاء (ولحمها داء)","cause":"عليكم بألْبانِ البقَرِ","result":"فإنَّها دَواءٌ ، و أسمانِها فإنَّها شفاءٌ ‍ وإيَّاكمْ ولُحومَها ، فإنَّ لُحومَها داءٌ","explicit":true,"ref":"صحيح الجامع 4061","srcLabel":"الحاكم","text":[["عليكم بألْبانِ البقَرِ ، ",1],["فإنَّها دَواءٌ ، و أسمانِها فإنَّها شفاءٌ ‍ وإيَّاكمْ ولُحومَها ، فإنَّ لُحومَها داءٌ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (8232)، وأبو نعيم في ((الطب النبوي)) (858) واللفظ له، والديلمي في ((الفردوس)) (4058)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"knwsWN7a","merged":3,"otherRefs":["شرح مسند أبي حنيفة 432 (صحيح)","صحيح الجامع 4061 (صحيح)"]},{"id":"س-07039","fp":"b8db99f706fc","stateId":285,"easy":"إذا آمنت بالله ودعوته ← يرد عليك بصرك (من قصة الغلام)","cause":"أتؤمنُ بالَّذي ردَّهُ علَيكَ ؟ قالَ : نعم. قالَ : فدعا اللَّهَ","result":"فردَّ علَيهِ بصرَهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[28],"ref":"صحيح الترمذي 3340","srcLabel":"مسلم","text":["كانَ ملِكٌ منَ الملوكِ وَكانَ لذلِكَ الملِكِ كاهنٌ يَكْهنُ لَهُ ، فقالَ الكاهنُ : انظروا لي غلامًا فَهِمًا - أو قالَ : فَطِنًا - لَقِنًا فأُعلِّمَهُ عِلمي هذا ، فإنِّي أخافُ أن أموتَ فينقطِعَ منكُم هذا العلمُ ، ولا يَكونَ فيكُم مِن يَعلمُهُ. قالَ : فنظَروا لَهُ علَى ما وصفَ ، فأمروهُ أن يحضرَ ذلِكَ الكاهنَ وأن يختلفَ إليهِ ، فجعلَ يختلفُ ، إليهِ وَكانَ علَى طريقِ الغُلامِ راهبٌ في صَومعةٍ - قالَ مَعمرٌ : أحسبُ أنَّ أصحابَ الصَّوامعِ كانوا يَومئذٍ مُسلمينَ - قالَ : فجعلَ الغُلامُ يسألُ ذلِكَ الرَّاهبَ كلَّما مرَّ بِهِ ، فلَم يزَلْ بِهِ حتَّى أخبرَهُ ، فقالَ : إنَّما أعبدُ اللَّهَ. قالَ : فجعلَ الغُلامُ يمكثُ عندَ الرَّاهبِ ويبطئُ عنِ الكاهنِ ، فأرسلَ الكاهنُ إلى أهْلِ الغُلامِ إنَّهُ لا يَكادُ يحضرُني ، فأخبرَ الغُلامُ الرَّاهبَ بذلِكَ ، فقالَ لَهُ الرَّاهبُ : إذا قالَ لَكَ الكاهنُ : أينَ كنتَ ؟ فقل : عندَ أَهْلي ، وإذا قالَ لَكَ أَهْلُكَ : أينَ كنتَ ؟ فأخبِرهم أنَّكَ كنتَ عندَ الكاهنِ. قالَ : فبَينما الغُلامُ علَى ذلِكَ إذ مرَّ بجماعةٍ منَ النَّاسِ كثيرٍ قد حبَستهُم دابَّةٌ ، فقالَ بعضُهُم : إنَّ تلكَ الدَّابَّةَ كانت أسدًا فأخذَ الغُلامُ حجرًا فقالَ : اللَّهمَّ إن كانَ ما يقولُ الرَّاهبُ حقًّا فأسألُكَ أن أقتلَها. قالَ : ثمَّ رمَى فقتلَ الدَّابَّةَ. فقالَ النَّاسُ : مَن قتلَها ؟ قالوا : الغُلامُ ، ففزِعَ النَّاسُ فقالوا : قد علِمَ هذا الغُلامُ عِلمًا لم يعلمْهُ أحدٌ. قالَ : فسمِعَ بِهِ أعمَى ، فقالَ لَهُ : إن أنتَ ردَدتَ بَصري فلَكَ كَذا وَكَذا. قالَ لهُ : لا أريدُ منكَ هذا ، ولَكِن أرَأيتَ إن رجعَ إليكَ بصرُكَ ، ",["أتؤمنُ بالَّذي ردَّهُ علَيكَ ؟ قالَ : نعم. قالَ : فدعا اللَّهَ",1]," ",["فردَّ علَيهِ بصرَهُ",2]," ، فآمنَ الأعمَى ، فبلغَ الملِكَ أمرُهُم ، فبعثَ إليهِم ، فأُتيَ بِهِم ، فقالَ : لأقتلَنَّ كلَّ واحدٍ منكُم قتلةً لا أقتلُ بِها صاحبَهُ ، فأمرَ بالرَّاهبِ والرَّجلِ الَّذي كانَ أعمَى فَوضعَ المِنشارَ علَى مَفرقِ أحدِهِما فقتلَهُ ، وقتلَ الآخرَ بقتلةٍ أُخرَى. ثمَّ أمرَ بالغُلامِ ، فقالَ : انطلِقوا بِهِ إلى جبلِ كَذا وَكَذا فألقوهُ مِن رأسِهِ ، فانطلِقوا بِهِ إلى الجبلِ ، فلمَّا انتَهَوا إلى ذلِكَ المَكانِ الَّذي أرادوا أن يلقوهُ منهُ جعَلوا يتَهافَتونَ مِن ذلِكَ الجبلِ ويتردَّونَ ، حتَّى لم يبقَ منهُم إلَّا الغُلامُ. قالَ : ثمَّ رجعَ ، فأمرَ بِهِ الملِكُ أن ينطلِقوا بِهِ إلى البحرِ فَيلقونَهُ فيهِ ، فانطلقَ بِهِ إلى البحرِ ، فغرَّقَ اللَّهُ الَّذينَ كانوا معَهُ وأنجاهُ ، فقالَ الغُلامُ للملِكِ : إنَّكَ لا تقتلُني حتَّى تصلِبَني وتَرميَني وتقولَ إذا رمَيتَني : بسمِ اللَّهِ ربِّ هذا الغُلامِ. قالَ فأمرَ بِهِ ، فصُلِبَ ، ثمَّ رماهُ ، فقالَ : بسمِ اللَّهِ ربِّ هذا الغُلامِ. قالَ : فَوضعَ الغُلامُ يدَهُ علَى صدغِهِ حينَ رُمِيَ ، ثمَّ ماتَ ، فقالَ أُناسٌ : لقد علِمَ هذا الغُلامُ عِلمًا ما علِمَهُ أحدٌ ، فإنَّا نؤمنُ بربِّ هذا الغُلامِ. قالَ : فقيلَ للملِكِ أجزَعتَ أن خالفَكَ ثلاثةٌ ، فَهَذا العالمُ كلُّهم قد خالفوكَ. قالَ : فخدَّ أُخدودًا ثمَّ ألقَى فيها الحطبَ والنَّارَ ، ثمَّ جمعَ النَّاسَ. فقالَ : مَن رجعَ عن دينِهِ ترَكْناهُ ، ومَن لم يرجِعْ ألقَيناهُ في هذِهِ النَّارِ ، فجعلَ يُلقيهم في تلكَ الأُخدودِ. قالَ : يقولُ اللَّهُ تبارَكَ وتعالى فيهِ :  قُتِلَ أَصْحَابُ الْأُخْدُودِ النَّارِ ذَاتِ الْوَقُودِ  حتَّى بلغَ  الْعَزِيزِ الْحَمِيدِ  قالَ : فأمَّا الغُلامُ فإنَّهُ دُفِنَ قالَ : فيذكرُ أنَّهُ أُخْرِجَ في زمنِ عُمرَ بنِ الخطَّابِ وأُصبعُهُ علَى صدغِهِ كما وضعَها حينَ قُتِلَ"],"grade":"صحيح","narrator":"صهيب بن سنان الرومي","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3340) واللفظ له، ومسلم (3005)، وأحمد (23931) بنحوه.","bab":"علم › الحث على طلب العلم","dorar":"seTN8V1w"},{"id":"س-07000","fp":"2373f21b4006","stateId":285,"easy":"إذا استنجيت بالماء ← فهو شفاء من الباسور","cause":"يَستَنْجينَ بالماءِ","result":"وهو شِفاءٌ منَ الباسورِ","explicit":true,"ref":"تخريج المسند لشعيب 24623","srcLabel":"الترمذي","text":["أنَّ نسوةً من أهلِ البَصرةِ دخَلْنَ عليها، فأمَرَتْهُنَّ أنْ ",["يَستَنْجينَ بالماءِ",1],"، وقالت: مُرْنَ أزواجَكُنَّ بذلك؛ فإنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، كان يَفعَلُه، ",["وهو شِفاءٌ منَ الباسورِ",2],"، عائشةُ تَقولُه، أو أبو عمَّارٍ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح دون قوله: وهو شفاء من الباسور، إن كان من قول عائشة","takhrij":"أخرجه الترمذي (19)، والنسائي (46) باختلاف يسير، وأحمد (24623) واللفظ له","bab":"علم › الحث على الأخذ بالسنة","dorar":"AalieqBs"},{"id":"س-07900","fp":"3e9b41aab4c0","stateId":285,"easy":"إذا أصابك رمد أو زكام أو سعال أو دمامل فلا تكرهها ← ففيها منافع تقطع أدواء أشد","cause":"لا تَكرَهوا أرْبَعًا","result":"لا تَكرَهوا الرَّمَدَ؛ فماؤُه يَقطَعُ عُروقَ العَمى، ولا تَكرَهوا الزُّكامَ؛ فإنَّه يَقطَعُ عُروقَ الجُذامِ، ولا تَكرَهوا السُّعالَ؛ فإنَّه يَقطَعُ عُروقَ الفالِجِ، ولا تَكرَهوا الدَّماميلَ؛ فإنَّه يَقطَعُ عُروقَ البَرَصِ","explicit":true,"otherNeedIds":[9],"ref":"الأحكام الوسطى 4/ 230","srcLabel":"السنة","text":["\"",["لا تَكرَهوا أرْبَعًا",1]," فإنَّها لِأرْبَعةٍ؛ ",["لا تَكرَهوا الرَّمَدَ؛ فماؤُه يَقطَعُ عُروقَ العَمى، ولا تَكرَهوا الزُّكامَ؛ فإنَّه يَقطَعُ عُروقَ الجُذامِ، ولا تَكرَهوا السُّعالَ؛ فإنَّه يَقطَعُ عُروقَ الفالِجِ، ولا تَكرَهوا الدَّماميلَ؛ فإنَّه يَقطَعُ عُروقَ البَرَصِ",2],"\"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","bab":"مريض › فضل المرض والنوائب","dorar":"AUFKLM4x"},{"id":"س-07395","fp":"7f72a3aa366b","stateId":285,"easy":"إذا أصابك ورم فقل «اللهم مطفئ الكبير ومكبّر الصغير...» ← يُطفأ (من واقعة)","cause":"اللَّهُمَّ مُطفِئَ الكَبيرِ، ومُكبِّرَ الصَّغيرِ","result":"فطُفِئَتْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«اللهم مطفئ الكبير ومكبّر الصغير...»"},"ref":"تخريج المسند لشعيب 23141","srcLabel":"النسائي","text":["حَدَّثَتْني مَريمُ ابنةُ إياسِ بنِ البُكَيرِ صاحِبِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، عن بعضِ أزواجِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ دَخَلَ عليَّها فقال: أعندَكِ ذَريرةٌ؟ قالت: نَعَمْ، فدَعا بها، فوَضَعَها على بَثْرةٍ بيْنَ أصابِعِ رِجْلِه، ثم قال: ",["اللَّهُمَّ مُطفِئَ الكَبيرِ، ومُكبِّرَ الصَّغيرِ",1],"، أطْفِئْها عنِّي، ",["فطُفِئَتْ",2],"."],"grade":"صحيح","narrator":"رجال من الصحابة","muhaddith":"إسناده إلى مريم بنت إياس صحيح رجاله ثقات رجال الشيخين","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10870)، وأحمد (23141) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › إجابة دعاء النبي","dorar":"6kXnJjLc","merged":3,"otherRefs":["المستدرك على الصحيحين 7668 (صحيح)","الفتوحات الربانية 4/48 (صحيح)"]},{"id":"س-03635","fp":"b62b3b0e4b23","stateId":285,"easy":"إذا اشتكيت رأسك فاحتجم، ورجليك فاخضبهما بالحناء ← (علاج نبوي)","cause":"وجَعًا في رأْسِه","result":"إلَّا قال: احتَجِمْ، ولا وجَعًا في رِجلَيْه إلَّا قال: اخْضِبْهما","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"apply":{"k":"time","t":"عند المرض والوجع"},"ref":"المستدرك على الصحيحين 8465","srcLabel":"أبو داود","text":["ما كان رجُلٌ يَشْتكي إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ ",["وجَعًا في رأْسِه",1]," ",["إلَّا قال: احتَجِمْ، ولا وجَعًا في رِجلَيْه إلَّا قال: اخْضِبْهما",2],"."],"grade":"صحيح","narrator":"سلمى خادمة رَسول اللهِ صلَّى اللهُ عليه وسلَّمَ","muhaddith":"صحيح الإسناد، ولم يخرجاه","takhrij":"أخرجه أبو داود (3858)، وأحمد (27617) بلفظه.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"FEs3QBfU","merged":2,"otherRefs":["مسند ابن عباس 1/509 (صحيح)"]},{"id":"س-06975","fp":"865d6372179a","stateId":285,"easy":"إذا تألّمت فامسح بيمينك سبعاً وقل «أعوذ بعزة الله وقدرته...» ← يذهب الله ما بك","cause":"أمسِكْ بيَمينِكَ سَبعَ مَرَّاتٍ، وقُلْ أعوذُ بعِزَّةِ اللهِ وقُدرَتِهِ مِن شَرِّ ما أجِدُ","result":"فأذهَبَ اللهُ ما كان بي","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«أعوذُ بعِزَّةِ اللهِ وقُدرَتِهِ مِن شَرِّ ما أجِد»"},"ref":"تخريج المسند لشعيب 16268","srcLabel":"أبو داود","text":["أنَّ عُثمانَ بنَ أبي العاصِ أتى رسولَ اللهِ صَلَّى اللهُ عليه وسلَّمَ، قال عُثمانُ: وبي وَجَعٌ قد كاد يُهلِكُني، فقال رسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ: ",["أمسِكْ بيَمينِكَ سَبعَ مَرَّاتٍ، وقُلْ أعوذُ بعِزَّةِ اللهِ وقُدرَتِهِ مِن شَرِّ ما أجِدُ",1],". قال: ففعَلتُ ذلك، ",["فأذهَبَ اللهُ ما كان بي",2],"، فلم أزَلْ آمُرُ به أهلي وغَيرَهم."],"grade":"صحيح","narrator":"عثمان بن أبي العاص الثقفي","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3891)، والترمذي (2080)، والنسائي في ((السنن الكبرى)) (7546)، وابن ماجه (3522)، وأحمد (16268) واللفظ له","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"0Ftax818","merged":2,"otherRefs":["صحيح ابن ماجه 2855 (صحيح)"]},{"id":"س-07533","fp":"d5cbce616f2d","stateId":285,"easy":"إذا أصابك حرق فقل «أذهب البأس رب الناس، واشف أنت الشافي» ← تُشفى (من واقعة)","cause":"أذهِبِ الباسَ، ربَّ النَّاسِ","result":"واشْفِ أنت الشَّافي، لا شِفاءَ إلَّا شِفاؤكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"apply":{"k":"say","t":"«أذهب البأس رب الناس، واشف أنت الشافي»"},"ref":"تخريج المسند لشعيب 18276","srcLabel":"النسائي","text":["تَناوَلتُ قِدرًا لأُمِّي، فاحترَقَتْ يدي، فذَهَبَتْ بي أُمِّي إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فجَعَلَ يَمسَحُ يدي، ولا أدْري ما يقولُ، أنا أصغرُ مِن ذاك، فسَأَلتُ أُمَّي، فقالتْ: كان يقولُ: ",["أذهِبِ الباسَ، ربَّ النَّاسِ",1],"، ",["واشْفِ أنت الشَّافي، لا شِفاءَ إلَّا شِفاؤكَ",2],"."],"grade":"صحيح","narrator":"محمد بن حاطب","muhaddith":"مرفوعه صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10015)، وأحمد (18276) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › بركة النبي","dorar":"Ua6rdRPO","merged":2,"otherRefs":["أطراف الغرائب 2/489 (صحيح)"]},{"id":"س-00039","fp":"9200b2107c51","stateId":285,"easy":"إذا ابتُليت ببصرك فتوضأ وصلّ ركعتين وادعُ بدعاء الضرير ← يرد الله عليك (من واقعة)","cause":"ائت الميْضَأَةَ فتوضَّأْ ثُمَّ صلِّ ركعتَيْنِ ثُمَّ ادْعُ بهذه الدعواتِ","result":"حتى دخلَ علينا الرجلُ كأنهُ لمْ يكنْ بهِ ضُرٌّ قطْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"count","t":"ركعتين"},"otherNeedIds":[28],"ref":"مجموع الفتاوى 1/274","srcLabel":"الحاكم","text":["شهِدتُ رسولَ اللهِ _صلى الله عليه وسلم_ وأتاهُ ضَرِيرٌ فشَكا إليه ذهابَ بصرِهِ ، فقال له النبيُّ _صلى الله عليه وسلم_: أتصبرُ ؟ فقال : يا رسولَ اللهِ إنَّه ليس لي قائدٌ وقد شَقَّ عليَّ ، فقال له رسولُ اللهِ _صلى الله عليه وسلم_ : ",["ائت الميْضَأَةَ فتوضَّأْ ثُمَّ صلِّ ركعتَيْنِ ثُمَّ ادْعُ بهذه الدعواتِ",1]," ، فقال عثمانُ بنُ حُنَيْفٍ: فواللهِ ما تفرَّقنا ولا طالَ بنا الحديثُ ",["حتى دخلَ علينا الرجلُ كأنهُ لمْ يكنْ بهِ ضُرٌّ قطْ",2],"."],"grade":"صحيح","narrator":"عثمان بن حنيف","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني (9/ 30)، (8311)، والحاكم (1930)، والبيهقي في ((دلائل النبوة)) (6/ 167) جميهم بلفظه.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"IP8De9BU"},{"id":"س-01639","fp":"bce03a3f9dfc","stateId":285,"easy":"إذا استعملت ماء الكمأة ← فهو دواء العين","cause":"الكَمْأةَ","result":"دواءُ العَينِ","explicit":true,"repOf":"س-04327","ref":"الجامع الصغير 5660","text":["العجوةُ منْ فاكهةِ الجنةِ [يعني حديث: كان مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في اثنَينِ وأربَعينَ مِن أصْحابِه، والنَّبيُّ صلَّى اللهُ عليه وسلَّمَ يُصلِّي في المَقامِ، وهم خَلفَه جُلوسٌ يَنتَظِرونَه، فلمَّا صلَّى أهْوى فيما بيْنَه وبيْنَ الكَعْبةِ كأنَّه يُريدُ أنْ يَأخُذَ شَيئًا، ثم انصَرَفَ إلى أصْحابِه، فثَاروا، وأشارَ إليهم بيَدِه أنِ اجْلِسوا فجَلَسوا، فقال: رَأيتُموني حين فَرَغتُ من صَلاتي أهْويتُ فيما بيْني وبيْنَ الكَعْبةِ كأنِّي أُريدُ أنْ آخُذَ شَيئًا، قالوا: نَعَمْ يا رسولَ اللهِ، قال: إنَّ الجَنَّةَ عُرِضَتْ علَيَّ، فلم أرَ مِثلَ ما فيها، وإنَّها مَرَّتْ بي خَصْلةٌ مِن عِنَبٍ فأعْجَبَتْني، فأهْويتُ إليها لآخُذَها فسَبَقَتْني، ولو أخَذتُها لغَرَستُها بيْنَ ظَهْرانيكم حتى تأكُلوا مِن فاكهةِ الجَنَّةِ، واعْلَموا أنَّ ",["الكَمْأةَ",1]," ",["دواءُ العَينِ",2],"، وأنَّ العَجْوةَ مِن فاكهةِ الجَنَّةِ، وأنَّ هذه الحبَّةَ السَّوْداءَ التي تكونُ في المِلْحِ اعلَموا أنَّها دَواءٌ من كُلِّ داءٍ إلَّا المَوتَ.]"],"grade":"حسن","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"حسن","takhrij":"أخرجه أحمد (22938)، والطحاوي في ((شرح مشكل الآثار)) (5676)، وابن عدي في ((الكامل في ضعفاء)) (5/ 81) واللفظ لهم مطولا.","bab":"أطعمة › ما يحل من الأطعمة","dorar":"IqCgsthf"},{"id":"س-03682","fp":"af3c1342fa75","stateId":285,"easy":"إذا اشتكيت عينك فانضح فيها الماء وقل «أذهب البأس رب الناس...» ← أجدر أن تُشفى","cause":"تنضَحينَ في عينِكِ الماءَ وتقولينَ : أذهبِ البأسَ ربَّ النَّاس","result":"كانَ خيرًا لَكِ وأجدرَ أن تُشفَى","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«أذهبِ البأسَ ربَّ النَّاس اشفِ أنتَ الشَّافي لا شفاءَ إلَّا شفاؤُكَ شفاءً لا يغادرُ سقمًا» · الوقت: عند المرض والوجع"},"ref":"غاية المرام 299","srcLabel":"أبو داود","text":["أنَّ ابنَ مسعودٍ رضيَ اللَّهُ عنهُ نهى امرأتَهُ عن مِثل هذِه الرُّقى الجاهليَّةِ فقالَت لهُ : فإنِّي خرجتُ يومًا فأبصرَني فلانٌ فدمَعَت عَيني الَّتي تليهِ أي أنه أصابَها بعَينٍ حاسِدَةٍ شِرِّيرَةٍ فإذا رقيتُها سَكَنت دمعتُها وإذا ترَكْتُها دمَعت فقالَ ابنُ مسعودٍ لها ذلكِ الشَّيطانُ إذا أطعتيهِ ترَكَكِ وإذا عَصيتيهِ طعنَ بأصبعِهِ في عينِكِ . ( ( ولَكِن لَو فعَلتِ كما فعلَ رسولُ اللَّهِ ",["كانَ خيرًا لَكِ وأجدرَ أن تُشفَى",2]," ",["تنضَحينَ في عينِكِ الماءَ وتقولينَ : أذهبِ البأسَ ربَّ النَّاس",1]," اشفِ أنتَ الشَّافي لا شفاءَ إلَّا شفاؤُكَ شفاءً لا يغادرُ سقمًا"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح [ أما زيادة (ولكن لو فعلت ....) فقد تراجع عنها الشيخ ، انظر الصحيحة : 6 / 1167 ]","takhrij":"أخرجه أبو داود (3883) بنحوه، وابن ماجه (3530)، وأحمد (3615) مطولاً بنحوه","bab":"اعتصام بالسنة › لزوم السنة","dorar":"4HJJTpkQ"},{"id":"س-06979","fp":"8a13c56553c5","stateId":285,"easy":"إذا اشتكيت وجعاً فضع يمينك عليه وامسح سبعاً وقل «أعوذ بعزة الله وقدرته...» ← يذهب الله ما بك","cause":"ضَعْ يَمينَكَ على مَكانِكَ الَّذي تَشتَكي، وامسَحْ به سَبْعَ مَرَّاتٍ، وقل: أعوذُ بعِزَّةِ اللهِ وقُدرَتِه من شَرِّ ما أجِدُ، في كلِّ مَسحةٍ","result":"وقد أخَذَه وَجَعٌ قد كادَ يُبطِلُه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«أعوذُ بعِزَّةِ اللهِ وقُدرَتِه من شَرِّ ما أجِدُ» · الوقت: عند المرض والوجع"},"ref":"المستدرك على الصحيحين 1289","srcLabel":"أبو داود","text":["أنَّ عُثمانَ بنَ أبي العاصِ قَدِم على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ ",["وقد أخَذَه وَجَعٌ قد كادَ يُبطِلُه",2],"؛ فذَكَر ذلكَ لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؛ فزعم أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قالَ: ",["ضَعْ يَمينَكَ على مَكانِكَ الَّذي تَشتَكي، وامسَحْ به سَبْعَ مَرَّاتٍ، وقل: أعوذُ بعِزَّةِ اللهِ وقُدرَتِه من شَرِّ ما أجِدُ، في كلِّ مَسحةٍ",1],"."],"grade":"صحيح","narrator":"عثمان بن أبي العاص","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داود (3891)، والترمذي (2080)، وابن ماجه (3522) جميعهم باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"c85ZmHnx"},{"id":"س-07556","fp":"5d1d8b2137c0","stateId":285,"easy":"إذا أصابك رمد فقل «اللهم متعني ببصري واجعله الوارث مني» ← (دعاء نبوي)","cause":"إذا أصابَهُ رمدٌ","result":"اللهمَّ مَتِّعْني ببصري، و اجعلْه الوارثَ منِّي","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"apply":{"k":"say","t":"«اللهم متعني ببصري واجعله الوارث مني»"},"otherNeedIds":[28],"ref":"الجامع الصغير 6561","srcLabel":"الحاكم","text":["كانَ ",["إذا أصابَهُ رمدٌ",1]," أو أحدًا منْ أصحابِه دعا بهؤلاءِ الكلماتِ : ",["اللهمَّ مَتِّعْني ببصري، و اجعلْه الوارثَ منِّي",2],"، و أرني في العدوِّ ثأرِي، و انصرْني على منْ ظلمَني"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (8272)، واللفظ له، وابن السني في عمل اليوم والليلة)) (565)، باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › دعاء النبي لبعض الناس","dorar":"Q3j5OMh7"},{"id":"س-07623","fp":"a1c7897359a0","stateId":285,"easy":"إذا ابتُليت ببصرك فصلّ ركعتين وادعُ بدعاء الضرير ← تبرأ (من واقعة)","cause":"فيصلِّي ركعتَينِ ، ويدعو بهذا الدعاءِ","result":"فبرئ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"count","t":"ركعتين"},"otherNeedIds":[28],"ref":"التوسل للألباني 68","srcLabel":"الحاكم","text":["أنَّ رجلًا ضريرَ البصرِ أتى النَّبيَّ صلَّى اللهُ عليهِ وسلَّمَ فقال : ادعُ اللهَ أن يُعافِيَني . قال : إن شئتَ دعوتُ لك ، وإن شئتَ أخَّرتُ ذاك ، فهو خيرٌ ، ( وفي روايةٍ : وإن شئتَ صبرتَ فهو خيرٌ لك ) ، فقال : ادعُه . فأمره أن يتوضَّأ فيحسنُ وُضوءَه ، ",["فيصلِّي ركعتَينِ ، ويدعو بهذا الدعاءِ",1]," : اللهمَّ إني أسألُك ، وأتوجَّه إليك بنبيِّك محمدٍ نبيِّ الرحمةِ ، يا محمدُ إني توجَّهتُ بك إلى ربي في حاجتي هذه فتُقضَى لي ، اللهمَّ فَشَفِّعْه فيَّ \" وشفِّعْني فيه \" قال ففعل الرجلُ ، ",["فبرئ",2]," . ."],"grade":"صحيح","narrator":"عثمان بن حنيف","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن خزيمة (2/225)، والطبراني (9/17)، والحاكم في ((المستدرك)) (1/707) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › معجزات النبي","dorar":"RU6o1uz3"},{"id":"س-03239","fp":"f1aa68fe5609","stateId":285,"easy":"إذا تألّمت فضع يدك وقل «بسم الله» ثلاثاً و«أعوذ بعزة الله وقدرته...» سبعاً ← يذهب الألم","cause":"ضع يدَك على الذي تألَّم من جسدِك ، و قُلْ : بسم اللهِ ( ثلاثًا ) و قل ( سبعَ مراتٍ ) أعوذُ باللهِ و قُدرتِه من شرِّ ما أَجِدُ و أُحاذِرُ","result":"تألَّم من جسدِك","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"apply":{"k":"say","t":"«بسم الله» ثم «أعوذ بعزة الله وقدرته...»"},"similar":["س-03240"],"ref":"صحيح الجامع 3893","srcLabel":"مسلم","text":[["ضع يدَك على الذي ",1],["تألَّم من جسدِك",2],[" ، و قُلْ : بسم اللهِ ( ثلاثًا ) و قل ( سبعَ مراتٍ ) أعوذُ باللهِ و قُدرتِه من شرِّ ما أَجِدُ و أُحاذِرُ",1]],"grade":"صحيح","narrator":"عثمان بن أبي العاص الثقفي","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2203)، وابن حبان (2967) واللفظ لهما وفي أوله زيادة، والطبراني (9/ 45) (8342) بنحوه وفي أوله زيادة.","bab":"استعاذة › التعوذ","dorar":"oGQkncGd","merged":2,"otherRefs":["صحيح الجامع 820 (صحيح)"]},{"id":"س-03661","fp":"1b8a6218f5ba","stateId":285,"easy":"إذا أصابتك قرحة فضع عليها الحناء ← (علاج نبوي)","cause":"قُرحةٌ ولا نُكتةٌ","result":"أن أضَعَ عليها الحِنَّاءَ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"الفروع لابن مفلح 5/ 539","srcLabel":"أبو داود","text":["كُنتُ أخدُمُ النَّبيَّ صلَّى اللهُ عليه وسلَّم، فما كانت تُصيبُه ",["قُرحةٌ ولا نُكتةٌ",1]," إلَّا أمَرَني ",["أن أضَعَ عليها الحِنَّاءَ",2]],"grade":"حسن","narrator":"سلمى مولاة النبي صلى اللهُ عليه","muhaddith":"إسناده جيد","takhrij":"أخرجه الترمذي (2054)، وابن ماجه (3502) واللفظ لهما، وأبو داود (3858) بمعناه.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"DVTjT1wH"},{"id":"س-00491","fp":"8df0493d70c0","stateId":285,"easy":"إذا اشتكيت عرق النسا فعالجه بألية كبش مذابة ← تبرأ (وصف نبوي)","cause":"أنْ يَأخُذوا ألْيةَ كَبشٍ، ليْس بعَظيمٍ ولا صَغيرٍ، فيُذابَ، ثمَّ يُجزَّأَ على ثَلاثةِ أجْزاءٍ، فلْيُشرَبْ كلَّ يومٍ جُزءًا","result":"وصَفَ لهم في عِرقِ النَّساءِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"عند المرض والوجع"},"ref":"المستدرك على الصحيحين 8466","srcLabel":"ابن ماجه","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ ",["وصَفَ لهم في عِرقِ النَّساءِ",2]," ",["أنْ يَأخُذوا ألْيةَ كَبشٍ، ليْس بعَظيمٍ ولا صَغيرٍ، فيُذابَ، ثمَّ يُجزَّأَ على ثَلاثةِ أجْزاءٍ، فلْيُشرَبْ كلَّ يومٍ جُزءًا",1],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح على شرط الشيخين، ولم يخرجاه","takhrij":"أخرجه ابن ماجه (3463)، وأحمد (13295)، والطبراني في ((المعجم الأوسط)) (2067) بنحوه","bab":"آداب عامة › المباحات من الأفعال والأقوال","dorar":"muLT1qNO"},{"id":"س-03240","fp":"a588a972cafa","stateId":285,"easy":"إذا وجدت وجعاً فضع يدك عليه وقل «باسم الله» ثلاثاً و«أعوذ بالله وقدرته...» سبعاً ← يذهب","cause":"ضَعْ يَدَكَ على الذي تَألَّمَ مِن جَسَدِكَ، وقُلْ: باسمِ اللهِ، ثَلاثًا، وقُلْ سَبعَ مَرَّاتٍ: أعوذُ باللَّهِ وقُدرَتِه مِن شَرِّ ما أجِدُ وأُحاذِرُ","result":"وجَعًا يَجِدُه في جَسَدِه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"apply":{"k":"say","t":"«باسم الله» ثم «أعوذُ باللَّهِ وقُدرَتِه مِن شَرِّ ما أجِدُ وأُحاذِر» · الوقت: عند المرض والوجع"},"repOf":"س-03239","ref":"صحيح مسلم 2202","text":["أنَّه شَكا إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم ",["وجَعًا يَجِدُه في جَسَدِه",2]," مُنذُ أسلَمَ، فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["ضَعْ يَدَكَ على الذي تَألَّمَ مِن جَسَدِكَ، وقُلْ: باسمِ اللهِ، ثَلاثًا، وقُلْ سَبعَ مَرَّاتٍ: أعوذُ باللَّهِ وقُدرَتِه مِن شَرِّ ما أجِدُ وأُحاذِرُ",1],"."],"grade":"صحيح","narrator":"عثمان بن أبي العاص الثقفي","muhaddith":"[صحيح]","takhrij":"أخرجه ابن حبان (2967) واللفظ له، والطبراني (9/ 45) (8342) باختلاف يسير، وابن ماجه (3522) بنحوه وفي آخره زيادة.","bab":"استعاذة › التعوذ","dorar":"Be4u5GmN"},{"id":"س-04783","fp":"c635f950c600","stateId":286,"easy":"إذا مرضت فتداوَ ← فالله لم ينزل داءً إلا وضع له دواءً إلا الهرم","cause":"تَداوَوا","result":"فإنَّ اللهَ عَزَّ وجَلَّ لم يُنزِلْ داءً إلَّا وَضَعَ له دَواءً إلَّا الهَرَمَ","explicit":true,"star":true,"similar":["س-00481","س-05157","س-07218"],"ref":"الأحاديث المختارة 1383","srcLabel":"البخاري","text":["«أتَيْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ بعَرَفاتٍ وكأنَّ على رُؤوسِ أصْحابِه الطَّيْرَ، فجاءَتْه الأعْرابُ مِن هاهنا وهاهنا: يا رَسولَ اللهِ، علينا حَرَجٌ في كَذا وكَذا؟ علينا حَرَجٌ في كَذا وكَذا؟ فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: رَفَعَ اللهُ الحَرَجَ إلَّا مَن اقْتَرَضَ مِن امْرِئٍ مُسلِمٍ ظُلْمًا، فذلك الَّذي حَرِجَ وهَلَكَ، قالوا: يا رَسولَ اللهِ، نَتَداوى؟ قالَ: ",["تَداوَوا؛ ",1],["فإنَّ اللهَ عَزَّ وجَلَّ لم يُنزِلْ داءً إلَّا وَضَعَ له دَواءً إلَّا الهَرَمَ",2],"، قالوا: يا رَسولَ اللهِ، فما خَيْرُ ما أُعْطِيَ النَّاسُ؟ فقالَ: إنَّ النَّاسَ لم يُعْطَوا شَيئًا خَيْرًا مِن خُلُقٍ حَسَنٍ»."],"grade":"صحيح","narrator":"أسامة بن شريك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"qvlyGJqP","merged":7,"otherRefs":["صحيح الجامع 3973 (صحيح)","مصباح الزجاجة 4/49 (صحيح)","تخريج صحيح ابن حبان 6061 (صحيح)","تخريج زاد المعاد 2019/12/4 (صحيح)","الإلزامات والتتبع 90 (صحيح)","خلاصة الأحكام للنووي 2/921 (صحيح)"]},{"id":"س-02745","fp":"f1987d1db8e8","stateId":286,"easy":"إذا احتجمت ← فهو أفضل ما تداوى به الناس","cause":"الحَجْمَ","result":"أفضَلُ ما تَدَاوى بهِ النَّاسُ","explicit":true,"star":true,"similar":["س-05933"],"ref":"المستدرك على الصحيحين 7677","srcLabel":"البخاري","text":["عنْ أبي الحَكَمِ البَجَلِيِّ -وهُو عبدُ الرَّحْمنِ بنُ أبي نُعْمٍ- قالَ: دَخلْتُ على أبي هُرَيرةَ رَضيَ اللهُ عنه وهو يَحتَجِمُ، فقالَ لي: يا أبا الحَكَمِ، احتَجِمْ، قالَ: فقُلتُ: ما احتَجَمْتُ قطُّ، قال: أخبَرَني أبو القاسِمِ صلَّى اللهُ عليه وسلَّمَ أنَّ جِبريلَ عليه السَّلامُ أخبَرَهُ أنَّ ",["الحَجْمَ",1]," ",["أفضَلُ ما تَدَاوى بهِ النَّاسُ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه إسحاق في ((مسنده)) (251)، والطبري في ((تهذيب الآثار-مسند ابن عباس)) (805) واللفظ لهما، والبخاري في ((التاريخ الكبير)) (1/ 213) مختصرًا.","bab":"إيمان › الملائكة","dorar":"L3DAJBVr","merged":4,"otherRefs":["حلية الأولياء 7/419 (صحيح)","سبل الهدى والرشاد 12/146 (حسن)","مجمع الزوائد 5/94 (صحيح)"]},{"id":"س-01660","fp":"cb199bb9a1c3","stateId":286,"easy":"إذا ائتدمت بالزيت وادّهنت به ← فإنه من شجرة مباركة","cause":"ائتَدِموا بالزَّيتِ، وادَّهِنوا به","result":"فإنَّه يخرُجُ مِن شَجَرةٍ مُباركةٍ","explicit":true,"star":true,"ref":"الأحاديث المختارة 82","srcLabel":"متفق عليه","text":["«",["ائتَدِموا بالزَّيتِ، وادَّهِنوا به",1],"؛ ",["فإنَّه يخرُجُ مِن شَجَرةٍ مُباركةٍ",2],"»."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"أطعمة › ما يحل من الأطعمة","dorar":"njeAlNdl","merged":2,"otherRefs":["صحيح الترمذي 1851 (صحيح)"]},{"id":"س-05423","fp":"c63a70aaa97a","stateId":286,"easy":"إذا أطعمت المريض التلبينة ← تريح فؤاده وتذهب بعض الحزن","cause":"التَّلبينةُ","result":"مُجِمَّةٌ لفُؤادِ المَريضِ، تُذهِبُ بَعضَ الحُزنِ","explicit":true,"star":true,"otherNeedIds":[4],"ref":"صحيح مسلم 2216","srcLabel":"البخاري","text":["عَن عائِشةَ، زَوجِ النَّبيِّ صلَّى اللهُ عليه وسلَّم، أنَّها كانَت إذا ماتَ المَيِّتُ مِن أهلِها فاجتَمع لذلك النِّساءُ، ثُمَّ تَفَرَّقنَ إلَّا أهلَها وخاصَّتَها أمَرَت ببُرمةٍ مِن تَلبينةٍ فطُبِخَت، ثُمَّ صُنِعَ ثَريدٌ، فصُبَّتِ ",["التَّلبينةُ",1]," عليها، ثُمَّ قالت: كُلنَ منها، فإنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: التَّلبينةُ ",["مُجِمَّةٌ لفُؤادِ المَريضِ، تُذهِبُ بَعضَ الحُزنِ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5417)، وأبو عوانة في ((مستخرج أبي عوانة)) (9737)، واللفظ لهما، وأحمد (25219)، باختلاف يسير.","bab":"رقائق وزهد › الحزن والبكاء","dorar":"l21jWPSU","merged":2,"otherRefs":["صحيح البخاري 5689 (صحيح)"]},{"id":"س-02359","fp":"4b936335a789","stateId":286,"easy":"إذا تداويت بالعود الهندي ← ففيه سبعة أشفية","cause":"علَيكُم بهذا العودِ الهِنديِّ","result":"فإنَّ فيه سَبعةَ أشفيةٍ، منها ذاتُ الجَنبِ","explicit":true,"star":true,"similar":["س-07539"],"ref":"صحيح مسلم 2214","srcLabel":"البخاري","text":["[عن] عُبَيدِ اللهِ بنِ عَبدِ اللهِ بنِ عُتبةَ بنِ مَسعودٍ؛ أنَّ أُمَّ قَيسٍ بنتَ مِحصَنٍ، وكانَت مِنَ المُهاجِراتِ الأُوَلِ اللَّاتي بايَعنَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، وهي أُختُ عُكَّاشةَ بنِ مِحصَنٍ، أحَدِ بَني أسَدِ بنِ خُزَيمةَ، قال: أخبَرَتني أنَّها أتَت رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم بابنٍ لَها لَم يَبلُغْ أن يَأكُلَ الطَّعامَ، وقد أعلَقَت عليه مِنَ العُذرةِ -قال يونُسُ: أعلَقَت: غَمَزَت فهي تَخافُ أن يَكونَ به عُذرةٌ- قالت: فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: عَلامَهْ تَدغَرنَ أولادَكُنَّ بهذا الإعلاقِ؟ ",["علَيكُم بهذا العودِ الهِنديِّ",1],"، يَعني به الكُستَ؛ ",["فإنَّ فيه سَبعةَ أشفيةٍ، منها ذاتُ الجَنبِ",2],"."],"grade":"صحيح","narrator":"أم قيس بنت محصن","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5713)، وأبو داود (3877)، وابن ماجه (3462)، وأحمد (26997) جميعا بنحوه .","bab":"إسلام › البيعة على الإسلام","dorar":"k3LIDlfK"},{"id":"س-03855","fp":"0115df9f2768","stateId":286,"easy":"إذا تداويت بألبان الإبل ← تصح","cause":"فشَرِبوا مِن أبوالِها وألبانِها","result":"فصَحُّوا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-01578"],"ref":"صحيح مسلم 1671","srcLabel":"البخاري","text":["أنَّ نَفَرًا مِن عُكلٍ ثَمانيةً قدِموا على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فبايَعوه على الإسلامِ، فاستَوخَموا الأرضَ، وسَقِمَت أجسامُهم، فشَكَوا ذلك إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: ألا تَخرُجونَ مع راعينا في إبِلِه، فتُصيبونَ مِن أبوالِها وألبانِها، فقالوا: بَلى، فخَرَجوا، ",["فشَرِبوا مِن أبوالِها وألبانِها",1],"، ",["فصَحُّوا",2],"، فقَتَلوا الرَّاعيَ وطَرَدوا الإبِلَ، فبَلَغَ ذلك رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فبَعَثَ في آثارِهم، فأُدرِكوا، فجيءَ بهِم، فأمَرَ بهِم فقُطِعَت أيديهم وأرجُلُهم، وسُمِرَ أعيُنُهم، ثُمَّ نُبِذوا في الشَّمسِ حتَّى ماتوا. وقال ابنُ الصَّبَّاحِ في رِوايَتِه: واطَّرَدوا النَّعَمَ، وقال: وسُمِّرَت أعيُنُهم."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6899) باختلاف يسير","bab":"بيعة › البيعة على ماذا تكون","dorar":"LOtgjAyt","merged":6,"otherRefs":["صحيح مسلم 1671 (صحيح)","صحيح النسائي 4044 (صحيح)","صحيح النسائي 4040 (صحيح)","صحيح البخاري 6802 (صحيح)","السلسلة الصحيحة 5/202 (صحيح)"]},{"id":"س-05851","fp":"93600ff99552","stateId":286,"easy":"إذا تداويت بالحجامة والقسط البحري ← فهما أمثل ما تداويتم به","cause":"الحِجامةُ ، و القِسطُ البحْرِيِّ","result":"أمْثلُ ما تداويتُم به","explicit":true,"ref":"صحيح الجامع 1365","srcLabel":"متفق عليه","text":[["أمْثلُ ما تداويتُم به",2]," ",["الحِجامةُ ، و القِسطُ البحْرِيِّ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1577)، والنسائي في ((السنن الكبرى)) (7538) واللفظ لهما، والبخاري (5696)، وأحمد (12045) بمعناه.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"4LkZceJt"},{"id":"س-07539","fp":"99354081a0b8","stateId":286,"easy":"إذا تداويت بالعود الهندي ← ففيه سبعة أشفية","cause":"عليكنَّ بهذا العُودِ الهِنديِّ","result":"فإنَّ فيه سَبعةَ أَشفِيةٍ","explicit":true,"repOf":"س-02359","ref":"تخريج المسند لشعيب 27000","text":["جئتُ بابنٍ لي قد أعْلَقْتُ عنه، أخافُ أنْ يكونَ به العُذرةُ، فقال النَّبيُّ صلَّى اللهُ عليهِ وسلَّمَ: علامَ تَدْغَرْنَ أولادَكنَّ بهذه العَلائقِ؟ ",["عليكنَّ بهذا العُودِ الهِنديِّ",1],"، يعني الكُسْتَ؛ ",["فإنَّ فيه سَبعةَ أَشفِيةٍ",2],"، منها ذاتُ الجَنْبِ. ثمَّ أخَذ النَّبيُّ صلَّى اللهُ عليهِ وسلَّمَ صَبيَّها، فوضَعَه في حِجْرِه، فبالَ عليه، فدعا بماءٍ فنضَحَه، ولم يكُنِ الصَّبيُّ بلَغَ أنْ يأكُلَ الطَّعامَ. \nقال الزُّهْرِيُّ: فمَضَتِ السُّنَّةُ بأن يُرَشَّ بولُ الصَّبيِّ، ويُغسَلَ بولُ الجاريةِ. قال الزُّهْرِيُّ: فيُستَسْعَطُ للعُذْرةِ، ويُلَدُّ لِذاتِ الجَنْبِ."],"grade":"صحيح","narrator":"أم قيس بنت محصن","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (5713)، ومسلم (2214)، وأبو داود (3877)، والنسائي في ((السنن الكبرى)) (7583)، وابن ماجه (3462)، وأحمد (27000) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › تبرك الناس به","dorar":"lSsFur14"},{"id":"س-01571","fp":"9bb35238f0d8","stateId":286,"easy":"إذا شربت ألبان البقر ← ففيها شفاء من كل داء","cause":"وفي ألْبانِ البَقَرِ","result":"شِفاءٌ مِن كُلِّ داءٍ","explicit":true,"similar":["س-01573"],"ref":"المستدرك على الصحيحين 7628","srcLabel":"مسلم","text":["ما أنزَلَ اللهُ مِن داءٍ إلَّا وقَدْ أنزَلَ له شِفاءً، ",["وفي ألْبانِ البَقَرِ",1]," ",["شِفاءٌ مِن كُلِّ داءٍ",2],"."],"grade":"صحيح","narrator":"عبدالله[ ابن مسعود]","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه البزار (1450)، والنسائي في ((الكبرى)) (6834)، وابن حبان (6075) جميعهم بلفظ مقارب.","bab":"أشربة › اللبن","dorar":"Orxw1eVW"},{"id":"س-05329","fp":"a4e872521b61","stateId":286,"easy":"إذا أُصيب دواء الداء ← برئ بإذن الله","cause":"فإنْ أُصِيبَ دَواءُ الدَّاءِ","result":"بَرِئَ بإذْنِ اللهِ عزَّ وجلَّ","explicit":true,"ref":"المستدرك على الصحيحين 7639","srcLabel":"مسلم","text":["لكُلِّ داءٍ دَواءٌ؛ ",["فإنْ أُصِيبَ دَواءُ الدَّاءِ، ",1],["بَرِئَ بإذْنِ اللهِ عزَّ وجلَّ",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح على شرط مسلم","bab":"رقائق وزهد › التوكل واليقين","dorar":"O9wt29KN"},{"id":"س-01580","fp":"15ec4c35ee4f","stateId":286,"easy":"إذا شربت ماء زمزم ← فهو طعام طعم وشفاء سقم","cause":"ماءَ زمزمَ","result":"طعامُ طُعمٍ ، وشِفاءُ سُقمٍ","explicit":true,"otherNeedIds":[1],"ref":"إتحاف الخيرة المهرة 3/246","srcLabel":"السنة","text":["منذُ كم أنتَ هاهُنا ؟ قال : قلتُ : منذُ ثلاثينَ يومًا وليلةً ، قال : منذُ ثلاثينَ يومًا وليلةً ! قال : قلتُ : نعَم ، قال : فما طعامُكَ ؟ قلتُ : ما كان طعامٌ ولا شرابٌ إلا ",["ماءَ زمزمَ",1]," ، ولقد سمِنتُ حتى تكسَّرَتُ عُكَنُ بَطني ، وما أجِدُ على كبِدي سخفةَ جوعٍ ، قال : فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : إنَّها مبارَكةٌ ، وهي ",["طعامُ طُعمٍ ، وشِفاءُ سُقمٍ",2]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"سنده صحيح","bab":"أشربة › ما يحل من الأشربة","dorar":"PUJ0XEU6","merged":7,"otherRefs":["تخريج مشكل الآثار 1863 (صحيح)","مجموع فتاوى ابن باز 27/10 (حسن)","التلخيص الحبير 3/906 (صحيح)","صحيح الجامع 2438 (صحيح)","السلسلة الصحيحة 1056 (حسن)","صحيح الجامع 3322 (صحيح)"]},{"id":"س-01578","fp":"9379ed19cfa7","stateId":286,"easy":"إذا تداويت بألبان الإبل ← تصح (من واقعة)","cause":"فشَرِبوا مِن ألبانِها وأبوالِها","result":"حتَّى صَحُّوا وسَمِنوا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-03855","ref":"صحيح البخاري 6804","text":["قدِمَ رَهطٌ مِن عُكلٍ على النَّبيِّ صلَّى اللهُ عليه وسلَّم، كانوا في الصُّفَّةِ، فاجتَووا المَدينةَ، فقالوا: يا رَسولَ اللهِ، أبغِنا رِسْلًا، فقال: ما أجِدُ لكم إلَّا أن تَلحَقوا بإبِلِ رَسولِ اللهِ فأتَوها، ",["فشَرِبوا مِن ألبانِها وأبوالِها",1],"، ",["حتَّى صَحُّوا وسَمِنوا",2]," وقَتَلوا الرَّاعيَ واستاقوا الذَّودَ، فأتى النَّبيَّ صلَّى اللهُ عليه وسلَّم الصَّريخُ، فبَعَثَ الطَّلَبَ في آثارِهم، فما تَرَجَّلَ النَّهارُ حتَّى أُتيَ بهِم، فأمَرَ بمَساميرَ فأُحميَت، فكَحَلَهم، وقَطَعَ أيديَهم وأرجُلَهم وما حَسَمَهم، ثُمَّ أُلقوا في الحَرَّةِ، يَستَسقونَ فما سُقوا حتَّى ماتوا. قال أبو قِلابةَ: سَرَقوا وقَتَلوا وحارَبوا اللهَ ورَسولَه."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6804) واللفظ له، ومسلم (1671)","bab":"أشربة › ما يحل من الأشربة","dorar":"4pjsHZV4","merged":2,"otherRefs":["صحيح البخاري 5686 (صحيح)"]},{"id":"س-03606","fp":"732f96ea71f1","stateId":286,"easy":"إذا تداويت بالحجامة أو العسل أو الكي ← ففيها الشفاء","cause":"شَرْطَةِ مِحْجَمٍ، أوْ شَرْبَةِ عَسَلٍ، أوْ كَيَّةٍ بنارٍ","result":"الشِّفاءُ في ثَلاثَةٍ","explicit":true,"ref":"صحيح الجامع 6897","srcLabel":"السنة","text":["نَهَى عنِ الْكَيِّ [حديث سعد الظفري: أنَّ النبيَّ صلَّى اللهُ عليه وسلَّمَ نهى عن الكَيِّ وقال أكره شُرْبَ الحمِيمِ]                [وحديث عمران بن حصين: أنَّ رسولَ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ نَهَى عنِ الكَيِّ. قالَ : فابتُلينا فاكتَوَينا فما أفلَحْنا ولا أنجَحْنا]  [وحديث ابن عباس: ",["الشِّفاءُ في ثَلاثَةٍ",2],": في ",["شَرْطَةِ مِحْجَمٍ، أوْ شَرْبَةِ عَسَلٍ، أوْ كَيَّةٍ بنارٍ",1],"، وأنا أنْهَى أُمَّتي عَنِ الكَيِّ.]"],"grade":"صحيح","narrator":"سعد الظفري وعمران بن الحصين وابن عباس","muhaddith":"صحيح","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"1xRoKOWY","merged":4,"otherRefs":["مجموع فتاوى ابن باز 206/1 (صحيح)","صحيح البخاري 5680 (صحيح)","صحيح ابن ماجه 2829 (صحيح)"]},{"id":"س-05303","fp":"0dee4276e6fb","stateId":286,"easy":"إذا تداويت بالعسل ← تبرأ","cause":"عُكَّةَ عسلٍ فسقاهُ","result":"فبرَأَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الإصابة في تمييز الصحابة 2/258","srcLabel":"متفق عليه","text":["أنَّ مُلاعبَ الأسِنَّةِ بعثَ إلى النَّبيِّ صلَّى اللهُ عليهِ وآلِه وسلَّمَ يسألُهُ الدَّواءَ مِن وَجعِ بطنِ ابنِ أخٍ لهُ فبعثَ إليهِ النَّبيُّ صلَّى اللهُ عليهِ وآلِه وسلَّمَ ",["عُكَّةَ عسلٍ فسقاهُ",1]," ",["فبرَأَ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (5684)، ومسلم (2217)، والحاكم (8221) بنحوه.","bab":"رقائق وزهد › التوكل واليقين","dorar":"weWk01pH"},{"id":"س-05939","fp":"87d4831a76c7","stateId":286,"easy":"إذا اكتحلت بالإثمد ← ينبت الشعر ويذهب القذى ويصفي البصر","cause":"عليكُمْ بِالإِثْمِدِ","result":"فإنَّهُ مُنْبِتَةٌ للشَّعْرِ ، مُذْهِبَةٌ لِلْقِذَى مُصْفَاةٌ لِلْبَصَرِ","explicit":true,"ref":"السلسلة الصحيحة 2642","srcLabel":"الطبراني","text":[["عليكُمْ بِالإِثْمِدِ ، ",1],["فإنَّهُ مُنْبِتَةٌ للشَّعْرِ ، مُذْهِبَةٌ لِلْقِذَى مُصْفَاةٌ لِلْبَصَرِ",2]],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبري في ((مسند ابن عباس)) (769) باختلاف يسير، والطبراني (1/109) (183)، وأبو نعيم في ((حلية الأولياء)) (3/178)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"ilUf4ufy","merged":3,"otherRefs":["مسند ابن عباس 1/486 (صحيح)","تخريج شرح السنة 12/117 (حسن)"]},{"id":"س-07925","fp":"83228e10da96","stateId":286,"easy":"إذا استعملت الحبة السوداء ← فهي شفاء من كل داء إلا الموت","cause":"هذه الحَبَّةَ السَّوداءَ","result":"شِفاءٌ مِن كُلِّ داءٍ إلَّا مِنَ السَّامِ","explicit":true,"similar":["س-01640"],"ref":"صحيح البخاري 5687","srcLabel":"الطبراني","text":["خَرَجنا ومعنا غالِبُ بنُ أبجَرَ، فمَرِضَ في الطَّريقِ، فقدِمنا المَدينةَ وهو مَريضٌ، فعادَه ابنُ أبي عَتيقٍ، فقال لَنا: علَيكُم بهذه الحُبَيبةِ السَّوداءِ، فخُذوا منها خَمسًا أو سَبعًا فاسحَقوها، ثُمَّ اقطُروها في أنفِه بقَطَراتِ زَيتٍ، في هذا الجانِبِ وفي هذا الجانِبِ؛ فإنَّ عائِشةَ حَدَّثَتني أنَّها سَمِعَتِ النَّبيَّ صلَّى اللهُ عليه وسلَّم يقولُ: إنَّ ",["هذه الحَبَّةَ السَّوداءَ",1]," ",["شِفاءٌ مِن كُلِّ داءٍ إلَّا مِنَ السَّامِ",2],". قُلتُ: وما السَّامُ؟ قال: المَوتُ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه ابن الحدلد في ((جامع الصحيحين)) (2588) واللفظ له، وابن ماجة (3449)، والطبراني في ((الأوسط)) (105) باختلاف يسير.","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"Ozy08QC9","merged":3,"otherRefs":["تخريج المسند لشاكر 14/57 (صحيح)","البحر الزخار 6/30 (صحيح)"]},{"id":"س-00481","fp":"9f79ebad2cb0","stateId":286,"easy":"إذا مرضت فتداوَ ← فالله لم ينزل داءً إلا أنزل له دواءً","cause":"ألا تَدعُو له طبيبًا","result":"إنَّ اللهَ عزَّ وجلَّ لم يُنْزِلْ داءً إلَّا أنزلَ معهُ دواءً","explicit":true,"repOf":"س-04783","ref":"السلسلة الصحيحة 2873","text":[["ألا تَدعُو له طبيبًا",1],"؟ [يعني حديثَ: أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم عادَ مريضًا فقال: ألا تدعو لهُ طبيبًا؟ قالوا: يا رسولَ اللهِ، وأنتَ تأمرُنا بهذا؟ قال: فقال: ",["إنَّ اللهَ عزَّ وجلَّ لم يُنْزِلْ داءً إلَّا أنزلَ معهُ دواءً",2],"]"],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"إسناده جيد رجاله ثقات رجال الشيخين","takhrij":"أخرجه الخطيب في ((تاريخ بغداد)) (16/ 506) واللفظ له تامًا، ومسلم (2204)، وأحمد (14597) باللفظ التام دون هذه الفقرة.","bab":"آداب عامة › المباحات من الأفعال والأقوال","dorar":"Fpjnjlfy"},{"id":"س-00627","fp":"427bd40a5197","stateId":286,"easy":"إذا حزنت أو مرضت فاشرب الحساء ← يقوّي فؤاد الحزين ويذهب عن فؤاد السقيم","cause":"أمر بالحَسَاءِ","result":"إنه لَيَرْتُو فؤادَ الحزينِ، ويَسْرُو عن فؤادِ السقيمِ","explicit":true,"otherNeedIds":[6],"ref":"هداية الرواة 4162","srcLabel":"الترمذي","text":["كان رسولُ اللهِ - صلَّى اللهُ عليهِ وسلَّم - إذا أخذ أهلَه الوَعْكُ ؛ ",["أمر بالحَسَاءِ",1]," فصُنِع، ثم أمرهم فحَسَوْا منه وكان يقولُ : ",["إنه لَيَرْتُو فؤادَ الحزينِ، ويَسْرُو عن فؤادِ السقيمِ",2]," كما تَسْرُو إحداكن الوَسَخَ بالماءِ عن وجهِها ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2039) بلفظه، وابن ماجه (3445) بلفظه، وأحمد (24035) كلاهما باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"J2AOmtUV","merged":2,"otherRefs":["صحيح الجامع 4646 (صحيح)"]},{"id":"س-05833","fp":"16b7bfd950b1","stateId":286,"easy":"إذا مرضت فعليك بالتلبينة ← تغسل بطنك كما يُغسل الوسخ عن الوجه","cause":"عليكُم بالبَغيضِ النَّافعِ؛ التَّلبينةِ","result":"إنَّه ليَغْسِلُ بطْنَ أحدِكُم كما يَغْسِلُ الوَسَخَ عنْ وَجهِه بالماءِ","explicit":true,"similar":["س-00530"],"ref":"المستدرك على الصحيحين 7660","srcLabel":"السنة","text":[["عليكُم بالبَغيضِ النَّافعِ؛ التَّلبينةِ",1],"، والَّذي نفْسُ مُحمَّدٍ بيَدِه، ",["إنَّه ليَغْسِلُ بطْنَ أحدِكُم كما يَغْسِلُ الوَسَخَ عنْ وَجهِه بالماءِ",2],"، قالَتْ: وكانَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ إذا اشتَكَى أحَدٌ مِن أهلِهِ لم تَزَلِ البُرْمةُ على النَّارِ حتَّى يَقضِيَ على أحَدِ طَرَفَيْهِ؛ إمَّا موْتٌ أو حياةٌ."],"grade":"صحيح","narrator":"عائشة","muhaddith":"صحيح على شرط الشيخين","bab":"رقائق وزهد › الوصايا النافعة","dorar":"bgkeGjZc","merged":2,"otherRefs":["تسديد القوس 3/59 (صحيح)"]},{"id":"س-05855","fp":"5c6a419e5b14","stateId":286,"easy":"إذا احتجمت ← ففي الحجم شفاء","cause":"في الحَجْمِ","result":"شِفاءٌ","explicit":true,"ref":"صحيح الجامع 4248","srcLabel":"السنة","text":[["في الحَجْمِ",1]," ",["شِفاءٌ",2]," [حديث عبدالله بن سرجس: في الحَجْمِ شِفاءٌ] [وحديث جابر بن عبدالله: أنَّ جَابِرَ بنَ عبدِ اللهِ عَادَ المُقَنَّعَ، ثُمَّ قالَ لا أَبْرَحُ حتَّى تَحْتَجِمَ، فإنِّي سَمِعْتُ رَسولَ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ يقولُ: إنَّ فيه شِفَاءً.]"],"grade":"صحيح","narrator":"عبدالله بن سرجس وجابر بن عبدالله","muhaddith":"صحيح","bab":"رقائق وزهد › الوصايا النافعة","dorar":"xDnosuq2","merged":2,"otherRefs":["الأحاديث المختارة 9 / 406 (صحيح)"]},{"id":"س-05922","fp":"ec685b61a2cf","stateId":286,"easy":"إذا تداويت بالسنا والسنوت ← ففيهما شفاء من كل داء إلا الموت","cause":"عليكُم بالسَّنَا والسَّنُّوتِ","result":"فإنَّ فيهِما شِفاءً مِن كُلِّ داءٍ إلَّا السَّامَ","explicit":true,"ref":"المستدرك على الصحيحين 7647","srcLabel":"أحمد","text":["عنْ إبراهيمَ بنِ أبي عَبْلَةَ، قالَ: سَمِعْتُ أبا أُبَيِّ ابنِ أمِّ حَرامٍ -وكانَ قدْ صلَّى معَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ الصَّلاتَيْنِ- يقولُ: سَمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["عليكُم بالسَّنَا والسَّنُّوتِ؛ ",1],["فإنَّ فيهِما شِفاءً مِن كُلِّ داءٍ إلَّا السَّامَ",2],". قيلَ: يا رسولَ اللهِ، وما السَّامُ؟ قالَ: الموْتُ.\n قالَ إبراهيمَ بنِ أبي عَبْلَةَ: والسَّنُّوتُ: الشِّبِتُّ. قال عمْرُو بنُ بكرٍ وغيرُهُ يقولُ: السَّنُّوتُ: هو العَسَلُ الَّذي يكونُ في الزِّقِّ، وهو قَوْلُ الشَّاعرِ:\n هُمُ السَّمْنُ بالسَّنُّوتِ لا خَيْرَ فيهما ... وهمْ يمنَعُونَ الجارَ أنْ يَتجَرَّدَا"],"grade":"صحيح","narrator":"أبو أبى بن أم حرام الأنصارى","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني في ((مسند الشاميين)) (14)، وأبو أحمد الحاكم في ((الأسامي والكنى)) (1/ 316) بلفظه.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"eRTRzSEG","merged":2,"otherRefs":["الجامع الصغير 5511 (صحيح)"]},{"id":"س-07239","fp":"fa94f2910f08","stateId":286,"easy":"إذا احتجمت ← فهو من خير ما تداويتم به","cause":"الحَجْمُ","result":"مِن خيرِ ما تَداوَيتُم به","explicit":true,"ref":"تخريج المسند لشعيب 20212","srcLabel":"النسائي","text":["رَأَيتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ وهو يَحتجِمُ بقَرْنٍ، وهو يُشرَطُ بطَرَفِ سِكِّينٍ، فدَخَلَ رَجُلٌ مِن شَمْخَ، فقال له: لِمَ تُمكِّنُ ظَهرَكَ -أو: عُنُقَكَ- من هذا يَفعَلُ بها ما أرى؟ فقال: هذا ",["الحَجْمُ",1],"، وهو ",["مِن خيرِ ما تَداوَيتُم به",2],"."],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (7596)، وأحمد (20212) واللفظ له","bab":"علم › سؤال العالم عما لا يعلم","dorar":"KEagN2jW","merged":2,"otherRefs":["مجمع الزوائد 5/95 (صحيح)"]},{"id":"س-00530","fp":"5a463625814c","stateId":286,"easy":"إذا مرضت فاحسُ التلبينة ← تغسل بطنك كما يُغسل الوجه من الوسخ","cause":"عليكم بالتلْبينَةِ فاحسوهُ إيَّاها","result":"إنها تغسِلُ بطنَ أحدِكُم كما تغسلُ إحداكنَّ وجهَها من الوسَخِ","explicit":true,"repOf":"س-05833","ref":"سفر السعادة 300","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلم إذا قيلَ له : إنَّ فلانًا وجِعٌ لا يَطعَمُ الطعامَ ، قال : ",["عليكم بالتلْبينَةِ فاحسوهُ إيَّاها",1]," ، وكان يقولُ : والذي نفسي بيدهِ ",["إنها تغسِلُ بطنَ أحدِكُم كما تغسلُ إحداكنَّ وجهَها من الوسَخِ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"ثابت","takhrij":"أخرجه أحمد (24500) واللفظ له، والترمذي (3445)، وابن ماجه (2039)، والحاكم (7122) بنحوه.","bab":"آداب عامة › ضرب الأمثال","dorar":"tT9AXAPd"},{"id":"س-00688","fp":"31c6dfa25324","stateId":286,"easy":"إذا شربت ماء زمزم لغرض ← فهو لما شُرب له: شفاءً أو شبعاً","cause":"ماءُ زمزمَ","result":"لما شُرب له: إن شربتَه تستشفي شفاكَ اللهُ، وإنْ شربتَه لشِبعِكَ أشبعكَ اللهُ، وإن شربتَه لقطعِ ظمَئِكَ قطعَه اللهُ، وإن شربتَه مستعيذًا أعاذكَ اللهُ","explicit":true,"similar":["س-08234"],"otherNeedIds":[28],"ref":"المتجر الرابح 159","srcLabel":"الحاكم","text":[["ماءُ زمزمَ",1]," ",["لما شُرب له: إن شربتَه تستشفي شفاكَ اللهُ، وإنْ شربتَه لشِبعِكَ أشبعكَ اللهُ، وإن شربتَه لقطعِ ظمَئِكَ قطعَه اللهُ، وإن شربتَه مستعيذًا أعاذكَ اللهُ",2],". قال: وكان ابنُ عباسٍ رضي الله عنهما إذا شرِبَ ماءَ زمزمَ قال: اللهمَّ إني أسألُك علمًا نافعًا ورِزْقًا واسِعًا وشفاءً من كلِّ داءٍ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"قال الحاكم: صحيح الإسناد إن سلم من الجارودي. قلت: قد سلم منه","takhrij":"أخرجه الدارقطني (2/289)، والديلمي في ((الفردوس)) (6470) مختصراً باختلاف يسير، والحاكم (1739) باختلاف يسير","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"GWavxGFk"},{"id":"س-01929","fp":"905e47ea92e4","stateId":286,"easy":"إذا صمت ← فالصوم زكاة الجسد","cause":"الصومُ","result":"وزكاةُ الجسدِ","explicit":true,"otherNeedIds":[41],"ref":"الجامع الصغير 5182","srcLabel":"ابن ماجه","text":["الصيامُ نِصْفُ الصبرِ [يعني حديث: لكلّ شيءٍ زكاةٌ ",["وزكاةُ الجسدِ",2]," ",["الصومُ",1]," والصِيامُ نصفُ الصبرِ]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (1745)، والبيهقي في ((الشعب)) (3300)، والشهاب في ((مسنده)) (229) ثلاثتهم بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"0bUs72xS"},{"id":"س-03634","fp":"02c7d6a06ab6","stateId":286,"easy":"إذا مرض أحد أهلك فاصنع له الحساء ← يقوّي فؤاد السقيم ويذهب عنه","cause":"أمَرَ بالحَساءِ، فصُنِعَ، ثمَّ يَأمُرُه، فيحْسُو منْهُ","result":"إنَّه لَيَرْبُو عنْ فؤادِ السَّقيمِ -أو يَسْرُو عنْ فُؤادِ السَّقيمِ- كما تَسْرُو إحداكُنَّ الوَسَخَ عنْ وجْهِها بالماءِ","explicit":true,"otherNeedIds":[6],"ref":"المستدرك على الصحيحين 7319","srcLabel":"الترمذي","text":["كانَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ إذا أخَذَ أهْلَهُ الوَعَكُ، ",["أمَرَ بالحَساءِ، فصُنِعَ، ثمَّ يَأمُرُه، فيحْسُو منْهُ",1],"، وكان يقولُ: ",["إنَّه لَيَرْبُو عنْ فؤادِ السَّقيمِ -أو يَسْرُو عنْ فُؤادِ السَّقيمِ- كما تَسْرُو إحداكُنَّ الوَسَخَ عنْ وجْهِها بالماءِ",2],"."],"grade":"صحيح","narrator":"عائشة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (2039)، وابن ماجه (3445) باختلاف يسير.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"CxtmwEMs"},{"id":"س-05157","fp":"5845d95f67c4","stateId":286,"easy":"إذا مرضت فتداوَ يا عبد الله ← فالله لم ينزل داءً إلا أنزل له شفاءً","cause":"تَدَاوَوْا عبادَ اللهِ","result":"فإنَّ اللهَ تَعالَى لم يُنزِلْ داءً إلَّا وقَدْ أنزَلَ له شِفاءً، إلَّا هذا الهَرَمَ","explicit":true,"repOf":"س-04783","ref":"المستدرك على الصحيحين 7635","text":["شَهِدْتُ الأعاريبَ يَسأَلُونَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ: هلْ علينا حَرَجٌ في كذا وفي كذا؟ فقالَ: عِبادَ اللهِ، وضَعَ اللهُ الحَرَجَ إلَّا مَن اقتَرَضَ مِن عِرْضِ أخيهِ شيئًا؛ فذلِكَ الَّذي حَرِجَ وهلَكَ. قالوا: يا رسولَ اللهِ، نَتداوى؟ قالَ: ",["تَدَاوَوْا عبادَ اللهِ؛ ",1],["فإنَّ اللهَ تَعالَى لم يُنزِلْ داءً إلَّا وقَدْ أنزَلَ له شِفاءً، إلَّا هذا الهَرَمَ",2],".\n قالوا: يا رسولَ اللهِ، ما خَيْرُ ما أُعطِيَ العبدُ المسلِمُ؟ قالَ: خُلُقٌ حسَنٌ."],"grade":"صحيح","narrator":"أسامة بن شريك العامري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الحميدي في ((المسند)) (845)، وابن عبد البر في ((التمهيد)) (5/ 281) بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ZsiMk7El"},{"id":"س-05803","fp":"ba5c8a1e86f4","stateId":286,"easy":"إذا شربت الهليلج الأسود ← فهو شفاء من كل داء","cause":"عليكمْ بالهِلِيلِجِ الأسودِ فاشربُوهُ","result":"وهوَ شفاءٌ منْ كلِّ داءٍ","explicit":true,"ref":"الجامع الصغير 5532","srcLabel":"الحاكم","text":[["عليكمْ بالهِلِيلِجِ الأسودِ فاشربُوهُ",1],"، فإنَّهُ منْ شجرِ الجنةِ طعمُه مرٌّ، ",["وهوَ شفاءٌ منْ كلِّ داءٍ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (8230)، وابن حجر في ((الغرائب الملتقطة)) (2063) كلاهما بلفظه.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"6yPb9LR4"},{"id":"س-05916","fp":"fe57cdfef954","stateId":286,"easy":"إذا تداويت بالسنا ← فلو كان شيء ينفع من الموت لنفع","cause":"السَّنَا","result":"أو يَنْفَعُ مِن المَوْتِ؛ نفَعَ","explicit":true,"ref":"المستدرك على الصحيحين 7645","srcLabel":"الطبراني","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ دخَلَ عليها ذاتَ يومٍ وعندَهَا شُبْرمٌ تَدقُّه، فقالَ: ما تَصنعينَ بهِ؟ فقالتْ: يَشرَبُه فلانٌ، فقالَ: إنَّهُ داءٌ. قال: ودخَلَ علَيْها وعندَها سَنَا، فقالَ: ما تَصنَعينَ بهذا؟ فقالتْ: يَشرَبُه فُلانٌ، فقال: لو أنَّ شيئًا يَدْفَعُ الموتَ، ",["أو يَنْفَعُ مِن المَوْتِ؛ نفَعَ",2]," ",["السَّنَا",1],"."],"grade":"صحيح","narrator":"أسماء بنت عميس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني (24/ 132) (361) واللفظ له.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"7QqVoGML"},{"id":"س-05936","fp":"5262df4963e4","stateId":286,"easy":"إذا احتجمت يوم الخميس ← تزيد في عقلك","cause":"عليكم بالحِجامةِ يومَ الخميسِ","result":"فإنَّها تَزِيدُ في الرَّبِّ","explicit":true,"ref":"الضعفاء الكبير 3/454","srcLabel":"العقيلي","text":[["عليكم بالحِجامةِ يومَ الخميسِ؛ ",1],["فإنَّها تَزِيدُ في الرَّبِّ",2],". قيل: يا رسولَ اللهِ، وما الرَّبُّ؟ قال: العقلُ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"ليس ثابت في التوقيت في الحجامة يوما بعينه عن النبي صلى الله عليه وسلم وفيها أحاديث أسانيدها كلها لينة","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (3/454)، وابن عدي في ((الكامل في الضعفاء)) (6/16)، وابن الجوزي في ((العلل المتناهية)) (1468)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"Ft4jmPcq"},{"id":"س-07127","fp":"471b1752670b","stateId":286,"easy":"إذا شربت ألبان الإبل البرية ← فهي دواء من كل داء","cause":"عليكم بأَلْبَانِ الإبِلِ البَرِّيَّةِ","result":"فإنها دواءٌ من كلِّ داءٍ","explicit":true,"ref":"البحر الزخار 6/30","srcLabel":"أبو نعيم","text":["عليكم بالحَبَّةِ السَّوْدَاءِ ؛ فإنَّ فيها شِفَاءً من كلِّ داءٍ إلا السَّامَ ، قالوا : وما السَّامُ ؟ قال : الموتُ ، عليكم بالعَجْوَةِ ؛ فإنها دواءٌ من كلِّ سُمٍّ ، ",["عليكم بأَلْبَانِ الإبِلِ البَرِّيَّةِ",1]," ؛ ",["فإنها دواءٌ من كلِّ داءٍ",2]],"grade":"صحيح","narrator":"صهيب بن سنان الرومي","muhaddith":"محفوظ","takhrij":"أخرجه أبو نعيم في ((الطب النبوي)) (377) واللفظ له مختصرا.","bab":"علم › حسن السؤال ونصح العالم","dorar":"rXLTiIX5"},{"id":"س-07218","fp":"e8a0f011c7d8","stateId":286,"easy":"إذا مرضت فتداوَ ← فالله لم ينزل داءً إلا أنزل له دواءً","cause":"تَداووا عبادَ اللهِ","result":"فإنَّ اللهَ لمْ يُنزلْ داءً إلا وقدْ انزلَ لهُ دواءً وقال مرةً شفاءً إلا الهرَمَ","explicit":true,"repOf":"س-04783","ref":"التمهيد 5/281","text":["شَهِدْتُ الأعاريبَ يسألونَ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ هلْ علينا جناحٌ في كذا وكذا فقال عبادَ اللهِ قدْ وضعَ الحرجَ إلا امرأً اقترضَ مِنْ عِرضِ أخيهِ شيئًا فذلكَ الذي حرِجٌ وهلكَ قالوا يا رسولَ اللهِ هلْ علينا أنْ نَتداوى فقال ",["تَداووا عبادَ اللهِ ",1],["فإنَّ اللهَ لمْ يُنزلْ داءً إلا وقدْ انزلَ لهُ دواءً وقال مرةً شفاءً إلا الهرَمَ",2]," قالوا فما خيرُ ما أُعطِيَ الرجلُ يا رسولَ اللهِ قال خلقٌ حسنٌ"],"grade":"صحيح","narrator":"أسامة بن شريك","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2015، 3855) مفرقاً، الترمذي (2038)، والنسائي في ((السنن الكبرى)) (7553)، وابن ماجه (3436)، وأحمد (18454) باختلاف يسير","bab":"علم › حسن السؤال ونصح العالم","dorar":"bFTAHfRR"},{"id":"س-07261","fp":"fded10323e3d","stateId":286,"easy":"إذا احتجمت يوم الثلاثاء لسبع عشرة من الشهر ← فهو دواء لداء السنة","cause":"الحِجامةُ يَومَ الثُّلاثاءِ لسَبعَ عَشرةَ مِنَ الشَّهرِ","result":"دَواءٌ لداءِ السَّنةِ","explicit":true,"ref":"سبل الهدى والرشاد 12/153","srcLabel":"الطبراني","text":[["«الحِجامةُ يَومَ الثُّلاثاءِ لسَبعَ عَشرةَ مِنَ الشَّهرِ ",1],["دَواءٌ لداءِ السَّنةِ»",2]],"grade":"صحيح","narrator":"معقل بن يسار","muhaddith":"[رجاله] رجال الصحيح","takhrij":"أخرجه ابن سعد في ((الطبقات الكبير)) (1/ 385) بلفظه، والطبراني (20/ 215) (499)، وابن عدي في ((الكامل في الضعفاء)) (4/ 150)، والبيهقي (19564) جميعا بنحوه.","bab":"علم › ما بثه رسول الله صلى الله عليه وسلم من العلم","dorar":"J9ma9rgU"},{"id":"س-07529","fp":"2d0db438074e","stateId":286,"easy":"إذا احتجمت يوم سبع عشرة وتسع عشرة وإحدى وعشرين ← فهو من خير ما تداويتم به","cause":"تحتجمونَ فيه يومَ سبعَ عشرةَ ويومَ تسعَ عشرةَ ويومَ إحدَى وعشرينَ وقال إنَّ خيرَ ما تداويتُمْ به السُّعوطَ واللُّدودَ والحجامةَ والمشيَ","result":"إنَّ خيرَ ما","explicit":true,"ref":"ضعيف الترمذي 2053","srcLabel":"الترمذي","text":["إنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم حين عُرِجَ به ما مرَّ على ملإٍ من الملائكةِ إلَّا قالوا عليكَ بالحجامةِ ، وقال ",["إنَّ خيرَ ما ",2],["تحتجمونَ فيه يومَ سبعَ عشرةَ ويومَ تسعَ عشرةَ ويومَ إحدَى وعشرينَ وقال إنَّ خيرَ ما تداويتُمْ به السُّعوطَ واللُّدودَ والحجامةَ والمشيَ",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2053) واللفظ له، والحاكم (7472)، وأبو نعيم في ((الطب النبوي)) (179) مختصراً","bab":"فضائل النبي وصفته ودلائل النبوة › الإسراء والمعراج","dorar":"WHIo1WSW"},{"id":"س-07619","fp":"e5e1e9080929","stateId":286,"easy":"إذا احتجمت ← فهي مما أوصت به الملائكة","cause":"بِالحِجامةِ","result":"ما مَرَرْتُ بِمَلأٍ من الملائِكةِ لَيلةَ أُسْرِيَ بِي إِلَّا","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"الجامع الصغير 4081","srcLabel":"الترمذي","text":["خَيرُ يومٍ تَحْتَجِمُونَ فيه سبعُ عَشْرةَ ، و تِسعُ عشْرةَ ، و إِحدَى و عِشرينَ . و ",["ما مَرَرْتُ بِمَلأٍ من الملائِكةِ لَيلةَ أُسْرِيَ بِي إِلَّا",2]," قالُوا : عليكَ ",["بِالحِجامةِ",1]," يَا مُحمَّدُ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه أحمد (3316) واللفظ له، وأخرجه الترمذي (2053) مطولاً باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › معجزات النبي","dorar":"KVnHQ4Vb","merged":6,"otherRefs":["مسند ابن عباس 1/489 (صحيح)","صحيح الجامع 5672 (صحيح)","صحيح الجامع 5469 (صحيح)","مسند ابن عباس 1/488 (صحيح)","صحيح الترمذي 2052 (صحيح)"]},{"id":"س-08234","fp":"2d1f15890083","stateId":286,"easy":"إذا شربت ماء زمزم ← فهو لما شُرب له","cause":"ماءُ زَمزَمَ","result":"لِما شُرِبَ له","explicit":true,"repOf":"س-00688","otherNeedIds":[28],"ref":"فيض القدير 5/ 404","text":[["ماءُ زَمزَمَ",1]," ",["لِما شُرِبَ له",2],"، فإن شَرِبتَه تَستَشفي به شَفاكَ اللهُ، وإن شَرِبتَه مُستَعيذًا أعاذَكَ اللهُ، وإن شَرِبتَه لتَقطَعَ ظَمَأكَ قَطَعَه اللهُ، وإن شَرِبتَه لشِبَعِكَ أشبَعَكَ اللهُ، وهيَ هَزمةُ جِبريلَ وسُقيا إسماعيلَ"],"grade":"صحيح","narrator":"عبدالله  بن عباس","muhaddith":"قال الحاكم: صحيح إن سلم من الجارودي [قلت] سلم منه","bab":"ملائكة › أعمال الملائكة","dorar":"Wr5oIrxd"},{"id":"س-08235","fp":"2fcc3b49e827","stateId":286,"easy":"إذا شربت ماء زمزم تستشفي به ← يشفيك الله","cause":"فإن شَرِبتَه تَستَشفي به","result":"شَفاكَ اللهُ","explicit":true,"ref":"فيض القدير 5/ 404","srcLabel":"الحاكم","text":["ماءُ زَمزَمَ لِما شُرِبَ له، ",["فإن شَرِبتَه تَستَشفي به",1]," ",["شَفاكَ اللهُ",2],"، وإن شَرِبتَه مُستَعيذًا أعاذَكَ اللهُ، وإن شَرِبتَه لتَقطَعَ ظَمَأكَ قَطَعَه اللهُ، وإن شَرِبتَه لشِبَعِكَ أشبَعَكَ اللهُ، وهيَ هَزمةُ جِبريلَ وسُقيا إسماعيلَ"],"grade":"صحيح","narrator":"عبدالله  بن عباس","muhaddith":"قال الحاكم: صحيح إن سلم من الجارودي [قلت] سلم منه","bab":"ملائكة › أعمال الملائكة","dorar":"Wr5oIrxd"},{"id":"س-05941","fp":"5f1fc64fb42c","stateId":286,"easy":"إذا أصابت العين صبيك فاسترقِ له ← يبرأ","cause":"استرقيتُم لَهُ مِنَ العينِ","result":"ما لِصَبِيِّكُمْ هَذَا يَبْكِي","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[30],"ref":"صحيح الجامع 5662","srcLabel":"متفق عليه","text":[["ما لِصَبِيِّكُمْ هَذَا يَبْكِي",2]," ؟ هَلَّا ",["استرقيتُم لَهُ مِنَ العينِ",1]],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"حسن","takhrij":"أخرجه أحمد (24442) واللفظ له، والاسترقاء من العين أخرجه البخاري (5738)، ومسلم (2195)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"rNttTAjx"},{"id":"س-07933","fp":"1007518fb23f","stateId":286,"easy":"إذا مرضت فادعُ الطبيب ← فما أنزل الله داءً إلا جعل له شفاءً","cause":"ادْعوا له طَبيبَ بَني فُلانٍ","result":"وهل أنزَلَ اللهُ مِن داءٍ في الأرضِ إلَّا جَعَلَ له شِفاءً","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 23156","srcLabel":"أحمد","text":["عن رَجُلٍ مِن الأنصارِ قال: عادَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ رَجُلًا به جُرحٌ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["ادْعوا له طَبيبَ بَني فُلانٍ",1],"، قال: فدَعَوه فجاءَ، فقالوا: يا رسولَ اللهِ، ويُغني الدَّواءُ شَيئًا؟ فقال: سُبْحانَ اللهِ! ",["وهل أنزَلَ اللهُ مِن داءٍ في الأرضِ إلَّا جَعَلَ له شِفاءً",2],"؟"],"grade":"صحيح","narrator":"رجال من الصحابة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (23156) واللفظ له، وأبو نعيم في ((معرفة الصحابة)) (7150)","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"3Rqj5rBS","merged":2,"otherRefs":["إتحاف الخيرة المهرة 4/ 425 (حسن)"]},{"id":"س-01572","fp":"f816f627d0ea","stateId":286,"easy":"إذا تداويت بألبان البقر ← يرجى فيها الشفاء","cause":"تَداوَوْا بألبانِ البقرِ","result":"فإني أرجو أن يجعل اللهُ فيها شفاءً","explicit":true,"ref":"صحيح الجامع 2929","srcLabel":"الطبراني","text":[["تَداوَوْا بألبانِ البقرِ",1]," ، ",["فإني أرجو أن يجعل اللهُ فيها شفاءً",2]," ؛ فإنها تأكل من كلِّ الشجرِ"],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"حسن","takhrij":"أخرجه الطبراني (10/16) (9788) باختلاف يسير، وأبو نعيم في ((الطب النبوي)) (743)، والخطيب في ((تاريخ بغداد)) (7/356) واللفظ لهما","bab":"أشربة › اللبن","dorar":"TfsOLsu6"},{"id":"س-01576","fp":"b1f46f4c3ca7","stateId":286,"easy":"إذا استعملت سمن البقر ولبنها ← فهي دواء","cause":"وسَمنُها ولَبَنُها","result":"دواءٌ","explicit":true,"ref":"مختصر المقاصد 790","srcLabel":"الطبراني","text":["لُحومُ البَقَرِ داءٌ، ",["وسَمنُها ولَبَنُها",1]," ",["دواءٌ",2],"."],"grade":"حسن","narrator":"[مليكة بنت عمرو]","muhaddith":"حسن","takhrij":"أخرجه الطبراني (25/ 42) (79)، وأبو نعيم في ((معرفة الصحابة)) (7850)، والبغوي في ((مسند ابن الجعد)) (2683) بلفظه.","bab":"أشربة › اللبن","dorar":"gpI1tKUL"},{"id":"س-01581","fp":"d9eddd05c752","stateId":286,"easy":"إذا شربت من الدواء المشروع ← تجد العافية (من واقعة)","cause":"فشَرِبتُ منها شَربةً","result":"وقُمتُ وأنا صَحيحةٌ، فجعَلْتُ أعرِفُ صِحَّةَ تلكَ الشَّربةِ في جَسَدي","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 8471","srcLabel":"البيهقي","text":["عن عائشةَ رَضيَ اللهُ عنها، قالت: مَرِضْتُ، فحَمَاني أهْلي كلَّ شَيءٍ حتَّى الماءَ، فعَطِشْتُ لَيلةً وليْس عِندي أحدٌ، فدَنَوتُ مِن قِربةٍ مُعلَّقةٍ، ",["فشَرِبتُ منها شَربةً",1],"، ",["وقُمتُ وأنا صَحيحةٌ، فجعَلْتُ أعرِفُ صِحَّةَ تلكَ الشَّربةِ في جَسَدي",2],"، قال: وكانت عائشةُ رَضيَ اللهُ عنها تقولُ: لا تَحْمُوا المريضَ شَيئًا."],"grade":"صحيح","narrator":"غزية","muhaddith":"صحيح الإسناد، ولم يخرجاه","takhrij":"أخرجه البيهقي في ((الشعب)) (8795)، وابن أبي الدنيا في ((المرض والكفارات)) (122) واللفظ لهما.","bab":"أشربة › ما يحل من الأشربة","dorar":"iWWEq8Rf"},{"id":"س-01638","fp":"7fc276c37878","stateId":286,"easy":"إذا أكلت الرمان بشحمه ← فإنه دباغ المعدة","cause":"كلُوا الرمانَ بشحمِه","result":"فإنه دباغُ المعدةِ","explicit":true,"ref":"مجمع الزوائد 5/99","srcLabel":"أحمد","text":["عن عليِّ بنِ أبي طالبٍ رضِيَ اللهُ عنه قال ",["كلُوا الرمانَ بشحمِه",1]," ",["فإنه دباغُ المعدةِ",2]],"grade":"حسن","narrator":"[ربيعة بنت عياض الكلابية]","muhaddith":"رجاله ثقات","takhrij":"أخرجه أحمد (23237)، والبيهقي في ((الشعب)) (5557)، وأبو نعيم في ((الطب النبوي)) (365)، واللفظ لهم. جميعا.","bab":"أطعمة › ما يحل من الأطعمة","dorar":"L2Z4svKI"},{"id":"س-01640","fp":"3ef4e415223a","stateId":286,"easy":"إذا استعملت الحبة السوداء ← فهي دواء من كل داء إلا الموت","cause":"الحبَّةَ السَّوْداءَ","result":"أنَّها دَواءٌ من كُلِّ داءٍ إلَّا المَوتَ","explicit":true,"repOf":"س-07925","ref":"الجامع الصغير 5660","text":["العجوةُ منْ فاكهةِ الجنةِ [يعني حديث: كان مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في اثنَينِ وأربَعينَ مِن أصْحابِه، والنَّبيُّ صلَّى اللهُ عليه وسلَّمَ يُصلِّي في المَقامِ، وهم خَلفَه جُلوسٌ يَنتَظِرونَه، فلمَّا صلَّى أهْوى فيما بيْنَه وبيْنَ الكَعْبةِ كأنَّه يُريدُ أنْ يَأخُذَ شَيئًا، ثم انصَرَفَ إلى أصْحابِه، فثَاروا، وأشارَ إليهم بيَدِه أنِ اجْلِسوا فجَلَسوا، فقال: رَأيتُموني حين فَرَغتُ من صَلاتي أهْويتُ فيما بيْني وبيْنَ الكَعْبةِ كأنِّي أُريدُ أنْ آخُذَ شَيئًا، قالوا: نَعَمْ يا رسولَ اللهِ، قال: إنَّ الجَنَّةَ عُرِضَتْ علَيَّ، فلم أرَ مِثلَ ما فيها، وإنَّها مَرَّتْ بي خَصْلةٌ مِن عِنَبٍ فأعْجَبَتْني، فأهْويتُ إليها لآخُذَها فسَبَقَتْني، ولو أخَذتُها لغَرَستُها بيْنَ ظَهْرانيكم حتى تأكُلوا مِن فاكهةِ الجَنَّةِ، واعْلَموا أنَّ الكَمْأةَ دواءُ العَينِ، وأنَّ العَجْوةَ مِن فاكهةِ الجَنَّةِ، وأنَّ هذه ",["الحبَّةَ السَّوْداءَ",1]," التي تكونُ في المِلْحِ اعلَموا ",["أنَّها دَواءٌ من كُلِّ داءٍ إلَّا المَوتَ",2],".]"],"grade":"حسن","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"حسن","takhrij":"أخرجه أحمد (22938)، والطحاوي في ((شرح مشكل الآثار)) (5676)، وابن عدي في ((الكامل في ضعفاء)) (5/ 81) واللفظ لهم مطولا.","bab":"أطعمة › ما يحل من الأطعمة","dorar":"IqCgsthf"},{"id":"س-05862","fp":"3e46209e8ca2","stateId":286,"easy":"إذا تداويت بالقرآن ← فهو الدواء","cause":"القرآنُ","result":"هو الدَّواءُ","explicit":true,"ref":"شرح كتاب الشهاب 43","srcLabel":"القضاعي","text":[["القرآنُ",1]," ",["هو الدَّواءُ",2],"."],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"إسناده حسن","takhrij":"أخرجه القضاعي في ((مسند الشهاب)) (28)، والديلمي في ((الفردوس)) (4676)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"xbmptqCg"},{"id":"س-01651","fp":"70231bf9e33a","stateId":286,"easy":"إذا كنت ناقهاً فكل الشعير والسلق ← فهو أنفع لك","cause":"وصنَعْتُ شَعيرًا وسِلْقًا","result":"فإنَّه أنفَعُ لك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج زاد المعاد 4/95","srcLabel":"أبو داود","text":["دخَلَ علَيَّ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ومعه علِيٌّ، وعلِيٌّ ناقِهٌ مِن مَرَضٍ، ولنا دَوالي مُعلَّقةٌ، فقام رسولُ اللهِ صلَّى اللهُ عليه وسلَّم يَأكُلُ منها، وقام علِيٌّ يَأكُلُ منها، فطَفِقَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ لِعَليٍّ: إنَّك ناقِهٌ، حتى كَفَّ. قالت: ",["وصنَعْتُ شَعيرًا وسِلْقًا",1]," فجِئتُ به، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم لِعلِيٍّ: مَن هذا أَصِبْ؛ ",["فإنَّه أنفَعُ لك",2],". وفي لَفظٍ فقال: مَن هذا فأَصِبْ؛ فإنَّه أوفَقُ لك."],"grade":"حسن","narrator":"أم المنذر بنت قيس الأنصارية","muhaddith":"إسناده حسن","takhrij":"أخرجه أبو داود (3856)، والترمذي (2037)، وابن ماجه (3442) باختلاف يسير","bab":"أطعمة › ما يحل من الأطعمة","dorar":"9R0uf2Mq","merged":3,"otherRefs":["صحيح الترمذي 2037 (حسن)","صحيح ابن ماجه 2792 (حسن)"]},{"id":"س-01649","fp":"563e6cd6921d","stateId":286,"easy":"إذا أطعمت النفساء الرطب ← فهو خير طعامها","cause":"أطعِموا نُفَسَاءَكم الرُّطَب","result":"فإنهُ لو علم اللهُ خيرًا منه لأطعمَهُ مريمَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"اللآلئ المصنوعة 1/156","srcLabel":"مسلم","text":[["أطعِموا نُفَسَاءَكم الرُّطَب",1]," ",["فإنهُ لو علم اللهُ خيرًا منه لأطعمَهُ مريمَ",2]," ، قالوا : يا رسولَ اللهِ ليس في كلِّ حينٍ يكونُ الرطبُ قال فتمرٌ"],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"إسناده على شرط مسلم","takhrij":"أخرجه أبو نعيم في ((الطب النبوي)) (457)","bab":"أطعمة › ما يحل من الأطعمة","dorar":"Yp7mj6QK"},{"id":"س-03639","fp":"3eda4a59509a","stateId":286,"easy":"إذا مرضت فتداوَ بالحلال ← فإن الله خلق الداء والدواء","cause":"فتداووْا","result":"خلق الدَّاءَ و الدَّواءَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الجامع 1762","srcLabel":"الطبراني","text":["إنَّ اللهَ تعالى ",["خلق الدَّاءَ و الدَّواءَ",2]," ، ",["فتداووْا",1]," ، و لا تتداووْا بحَرامٍ"],"grade":"صحيح","narrator":"خيرة بنت حدرد أم الرداء الكبرى.","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (24/ 254) (649)، والدولابي في ((الكنى والأسماء)) (1315) واللفظ لهما.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"vnBskZdK","merged":3,"otherRefs":["إتحاف الخيرة المهرة 4/ 424 (حسن)","تخريج شرح السنة 12/ 139 (حسن)"]},{"id":"س-01573","fp":"3bbd6800374c","stateId":286,"easy":"إذا تداويت بألبان البقر ← ففيها شفاء","cause":"فعليكم بألبانِ البقرِ","result":"فإنَّها ترُمُّ مِن كلِّ الشَّجرِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-01571","ref":"تخريج صحيح ابن حبان 6075","text":["ما أنزَل اللهُ داءً إلَّا أنزَل له دواءً ",["فعليكم بألبانِ البقرِ",1]," ",["فإنَّها ترُمُّ مِن كلِّ الشَّجرِ",2]," )"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (6863)، والحاكم (7425)، والبيهقي (20055) باختلاف يسير","bab":"أشربة › اللبن","dorar":"sOeEXo64","merged":2,"otherRefs":["صحيح الجامع 4059 (صحيح)"]},{"id":"س-01781","fp":"95c11ed449c6","stateId":286,"easy":"إذا أصابك غبار المدينة ← فهو شفاء من كل داء (على رواية)","cause":"في غبارِها","result":"شفاءً من كلِّ داءٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"الترغيب والترهيب 2/215","srcLabel":"السنة","text":["لمَّا رجع رسولُ اللهِ صلَّى اللهُ عليه وسلَّم من تَبُوكَ تلقَّاه رجلٌ من المتخلِّفين من المؤمنين فأثاروا غُبارًا فخمَر بعضُ من كان مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّم أنفَه فأزال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم اللِّثامَ عن وجهِه وقال والَّذي نفسي بيدِه إنَّ ",["في غبارِها",1]," ",["شفاءً من كلِّ داءٍ",2]],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"لم نقف عليه إلا عند المنذري في ((الترغيب والترهيب)) (2/ 215).","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"TJQvJyvE"},{"id":"س-05933","fp":"4ec43cea8cae","stateId":286,"easy":"إذا احتجمت ← فهي خير ما تداوى به العرب","cause":"تداوتْ به العربُ","result":"خيرُ ما","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-02745","ref":"مسند ابن عباس 1/512","text":["دخل عُيينةُ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وهو يَحتجِمُ بقرنٍ فقال ما هذا قال ",["خيرُ ما ",2],["تداوتْ به العربُ",1]],"grade":"صحيح","narrator":"إبراهيم النخعي","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبري في ((مسند ابن عباس)) (814)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"YRkndYpU"},{"id":"س-01661","fp":"42901a98a1a4","stateId":286,"easy":"إذا أكلت السفرجل ← يذهب بطخاءة الصدر ويجلو الفؤاد","cause":"بسَفَرجَلةٍ","result":"إنَّه ليَذهَبُ بطخاءةِ الصَّدرِ، ويجلو الفؤادَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"otherNeedIds":[5],"ref":"سبل الهدى والرشاد 7/206","srcLabel":"الطبراني","text":["جاء جابِرُ بنُ عبدِ اللهِ رَضِيَ اللهُ تعالى عنهما إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم ",["بسَفَرجَلةٍ",1]," قَدِم بها من الطَّائفِ، فناوَلَه إيَّاها، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: «",["إنَّه ليَذهَبُ بطخاءةِ الصَّدرِ، ويجلو الفؤادَ",2],"»"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"رجاله ثقات خلا على القرشي.","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (11/ 112) (11209)، وابن بشكوال في ((الآثار المروية في الأطعمة)) (85) واللفظ لهما.","bab":"أطعمة › ما يحل من الأطعمة","dorar":"BlPA5QuA"},{"id":"س-00693","fp":"57fd1cad96bc","stateId":287,"easy":"إذا عدت مريضاً فقلت «أسأل الله العظيم رب العرش العظيم أن يشفيك» ← يُخفف عنه","cause":"ما مِن رَجُلٍ يَعودُ مَريضًا يقولُ: أَسأَلُ اللهَ العَظيمَ رَبَّ العَرْشِ العَظيمِ أن يَشفيَك سَبْعَ مَرَّاتٍ، وفي أجَلِه تَأخيرٌ","result":"إلَّا خُفِّفَ عنه","explicit":true,"star":true,"apply":{"k":"say","t":"«أسأل الله العظيم رب العرش العظيم أن يشفيك»"},"ref":"الأحاديث المختارة 10 / 370","srcLabel":"متفق عليه","text":["«",["ما مِن رَجُلٍ يَعودُ مَريضًا يقولُ: أَسأَلُ اللهَ العَظيمَ رَبَّ العَرْشِ العَظيمِ أن يَشفيَك سَبْعَ مَرَّاتٍ، وفي أجَلِه تَأخيرٌ",1]," ",["إلَّا خُفِّفَ عنه»",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"B7MBMMaY"},{"id":"س-06224","fp":"3ae623b35c04","stateId":287,"easy":"إذا رقيت بالفاتحة ← يبرأ المريض","cause":"أَمسحُهُ وأَقرأُ فاتحةَ الكتابِ، وأُردِّدُها","result":"حتَّى بَرَأَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-03650","س-01370"],"ref":"المستدرك على الصحيحين 2080","srcLabel":"متفق عليه","text":["بَعَثَنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ في غَزاةٍ، أوْ سَريَّةٍ، فمَرَرْنا على أهلِ أبياتٍ فاستَضَفْناهم فلمْ يُضيِّفونا، فنَزَلْنا بالعراءِ، فلُدِغَ سيِّدُهم، فأَتَوْنا، فقالوا: هل أَحدٌ منكم يَرْقي؟ فقلتُ: أنا راقٍ، قالَ: فارقِ صاحِبَنا، قلتُ: لا، قدِ استضَفْناكم، فلمْ تُضيِّفونا، قالوا: فإنَّا نُجعِّلُ لكم، فجَعَلوا لنا ثلاثينً شاةً، قالَ: فأَتيتُهُ، فجَعلتُ ",["أَمسحُهُ وأَقرأُ فاتحةَ الكتابِ، وأُردِّدُها",1]," ",["حتَّى بَرَأَ",2],"، فأخَذْنا الشِّياهَ، فقُلنا: أَخَذْناه ونحن لا نُحسِنُ أنْ نَرْقي، ما نحن بالَّذي نَأكُلُها حتَّى نَسألَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فأَتَيْناه، فذَكَرْنا ذلك له، قالَ: فجَعَلَ يقولُ: وما يُدريكَ أنَّها رُقيةٌ؟ قلتُ: يا رسولَ اللهِ، ما دَريتُ أنَّها رُقيةٌ، ولكن شيءٌ أَلْقى اللهُ في نَفسي. فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: كُلوا واضْرِبوا لي معكم بسَهْمٍ."],"grade":"صحيح","narrator":"أبو سعيد","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه البخاري (2276)، ومسلم (2201)، وأبو داود (3900) بنحوه.","bab":"سرايا › السرايا","dorar":"oZpo01NL","merged":8,"otherRefs":["صحيح أبي داود 3901 (صحيح)","المستدرك على الصحيحين 2081 (صحيح)","تخريج سنن الدارقطني 3034 (صحيح)","تخريج صحيح ابن حبان 6112 (صحيح)","تخريج المسند لشعيب 11070 (صحيح)","صحيح ابن ماجه 1763 (صحيح)","صحيح الترمذي 2063 (صحيح)"]},{"id":"س-07534","fp":"34115ddfa4b9","stateId":287,"easy":"إذا عدت مريضاً فجلست عند رأسه وقلت سبعاً «أسأل الله العظيم...» ← يُعافى إن كان في أجله تأخير","cause":"إذا عادَ المريضَ جَلَسَ عندَ رأسِهِ، ثمَّ قال سَبْعَ مَرَّاتٍ: أسأَلُ اللهَ العظيمَ رَبَّ العَرْشِ العَظيمِ أنْ يَشْفِيَكَ","result":"فإنْ كانَ في أجَلِهِ تَأخيرٌ عُوفِيَ مِن وَجَعِه ذلكَ","explicit":true,"star":true,"apply":{"k":"say","t":"«أسأَلُ اللهَ العظيمَ رَبَّ العَرْشِ العَظيمِ أنْ يَشْفِيَك»"},"ref":"المستدرك على الصحيحين 7694","srcLabel":"البخاري","text":["كانَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ ",["إذا عادَ المريضَ جَلَسَ عندَ رأسِهِ، ثمَّ قال سَبْعَ مَرَّاتٍ: أسأَلُ اللهَ العظيمَ رَبَّ العَرْشِ العَظيمِ أنْ يَشْفِيَكَ",1],". ",["فإنْ كانَ في أجَلِهِ تَأخيرٌ عُوفِيَ مِن وَجَعِه ذلكَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (536)، والنسائي ((السنن الكبرى)) (10815)، وأبو يعلى الموصلي (2430) واللفظ لهم","bab":"فضائل النبي وصفته ودلائل النبوة › بركة النبي","dorar":"PAAcaYu9"},{"id":"س-05893","fp":"050b04657d29","stateId":287,"easy":"إذا أكلت عجوة العالية أول النهار على الريق ← فهي شفاء وترياق","cause":"في عَجوةِ العاليةِ","result":"شِفاءٌ -أو تِرياقٌ- أوَّلَ البُكرةِ على الرِّيقِ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 25187","srcLabel":"مسلم","text":[["في عَجوةِ العاليةِ",1]," ",["شِفاءٌ -أو تِرياقٌ- أوَّلَ البُكرةِ على الرِّيقِ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (2048)، والنسائي في ((السنن الكبرى)) (6714)، وأحمد (25187) واللفظ له","bab":"رقائق وزهد › الوصايا النافعة","dorar":"pzRWsbyw"},{"id":"ق-1065","fp":"e5a4d2b51d90","stateId":287,"easy":"الصبر والأوبة ونداء الله في البلاء ← الشفاء وردّ الأهل ومثلهم معهم","cause":"الصبر والأوبة ونداء الله في البلاء","result":"الشفاء وردّ الأهل ومثلهم معهم","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"star":true,"otherNeedIds":[35,4,28],"ref":"سورة ص: 41–44","srcLabel":"القرآن الكريم","quran":{"s":38,"from":41,"to":44,"text":"وَاذْكُرْ عَبْدَنَا أَيُّوبَ إِذْ نَادَى رَبَّهُ أَنِّي مَسَّنِيَ الشَّيْطَانُ بِنُصْبٍ وَعَذَابٍ (41) ارْكُضْ بِرِجْلِكَ هَذَا مُغْتَسَلٌ بَارِدٌ وَشَرَابٌ (42) وَوَهَبْنَا لَهُ أَهْلَهُ وَمِثْلَهُمْ مَعَهُمْ رَحْمَةً مِنَّا وَذِكْرَى لِأُولِي الْأَلْبَابِ (43) وَخُذْ بِيَدِكَ ضِغْثًا فَاضْرِبْ بِهِ وَلَا تَحْنَثْ إِنَّا وَجَدْنَاهُ صَابِرًا نِعْمَ الْعَبْدُ إِنَّهُ أَوَّابٌ (44)","hl":[[0,378,1]]}},{"id":"س-03650","fp":"dc20eb3beb4d","stateId":287,"easy":"إذا رقيت بالفاتحة ← يبرأ المريض","cause":"يقرأُ عليهِ بفاتحةِ الكتابِ","result":"فبرأ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-06224","ref":"صحيح الترمذي 2064","text":["أنَّ ناسًا مِن أصحابِ النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ مرُّوا بحيٍّ منَ العَربِ ، فلم يُقروهم ولم يضيِّفوهم فاشتَكى سيِّدُهم فأتَونا فقالوا هَل عندَكم دواءٌ قلنا نعَم ولَكن لم تُقرونا ولم تُضيِّفونا فلا نفعَلُ حتَّى تجعَلوا لنا جُعلًا فجَعلوا علَى ذلِك قَطيعًا منَ الغنَمِ قالَ فجعلَ رجلٌ منَّا ",["يقرأُ عليهِ بفاتحةِ الكتابِ",1]," ",["فبرأ",2]," فلمَّا أتَينا النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ ذَكرنا ذلِك لَه ؟ قالَ : وما يُدريكَ أنَّها رُقيةٌ ولم يذكُر نَهيًا منهُ وقالَ : كُلوا واضرِبوا لي معَكم بسَهمٍ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2064)، والبخاري (5736)، ومسلم (2201) بلفظه.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"BUYa6Pqw","merged":2,"otherRefs":["تخريج صحيح ابن حبان 6113 (صحيح)"]},{"id":"س-01370","fp":"b71e6074dc9e","stateId":287,"easy":"إذا رقيت بالفاتحة وتفلت ← يبرأ المريض","cause":"بأُمِّ الكِتابِ، ويَتفُلُ","result":"حتى بَرَأ كأنَّما أُنشِطَ مِن عِقالٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-06224","ref":"تخريج سنن أبي داود 3418","text":["أنَّ رَهطًا مِن أصحابِ رَسولِ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ انطَلَقوا في سَفْرةٍ سافَروها، فنَزَلوا بحَيٍّ مِن أحياءِ العَرَبِ، فاستَضافوهم، فأبَوْا أنْ يُضيِّفوهم، قال: فلُدِغَ سَيِّدُ ذلك الحَيِّ، فشَفَوْا له بكُلِّ شَيءٍ، لا يَنفَعُه شَيءٌ، فقال بَعضُهم: لو أتَيتُم هؤلاء الرَّهطَ الذين نَزَلوا بكم، لَعَلَّ أنْ يَكونَ عِندَ بَعضِهم شَيءٌ يَنفَعُ صاحِبَكم. فقال بَعضُهم: إنَّ سَيِّدَنا لُدِغَ، فشَفَيْنا له بكُلِّ شَيءٍ، لا يَنفَعُه شَيءٌ، فهل مِن شَيءٍ يَنفَعُ صاحِبَنا عِندَ أحَدٍ منكم؟ يَعني رُقيةً، فقال رَجُلٌ مِنَ القَومِ: إنِّي لَأرقي، ولكِنِ استَضَفناكم، فأبَيتُم أنْ تُضيِّفونا، ما أنا بِراقٍ حتى تَجعَلوا لي جُعلًا، فجَعلوا له قَطيعًا مِنَ الشَّاءِ، فأتاه فقَرَأ عليه ",["بأُمِّ الكِتابِ، ويَتفُلُ",1],"، ",["حتى بَرَأ كأنَّما أُنشِطَ مِن عِقالٍ",2],"، فأوفاهم جُعلَهمُ الذي صالَحَهم عليه، فقالوا: اقتَسِموا. فقال الذي رَقى: لا تَفعَلوا حتى نأتيَ رَسولَ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ فنَستَأمِرَه، فغَدَوْا على رَسولِ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ، فذَكَروا له، فقال رَسولُ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ: مِن أينَ عَلِمتُم أنَّها رُقيةٌ؟ أحسَنتُم، واضرِبوا لي معكم بسَهمٍ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (5749) باختلاف يسير، ومسلم (2201) مختصراً باختلاف يسير","bab":"هبة وهدية › من استوهب من أصحابه شيئا","dorar":"RVvWR91C"},{"id":"س-07605","fp":"3c8e25d089f3","stateId":287,"easy":"إذا رقيت فقل «امسح البأس رب الناس، بيدك الشفاء...» ← (رقية نبوية)","cause":"امسَحِ البأْسَ رَبَّ الناسِ","result":"بيَدِكَ الشِّفاءُ، لا كاشفَ له إلَّا أنتَ","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"apply":{"k":"say","t":"«امسَحِ البأْسَ رَبَّ الناسِ، بيَدِكَ الشِّفاءُ، لا كاشفَ له إلَّا أنت»"},"ref":"تخريج المسند لشعيب 24995","srcLabel":"متفق عليه","text":["كُنْتُ أَرْقي رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ منَ العَينِ، فأضَعُ يَدي على صَدرِه، وأقولُ: ",["امسَحِ البأْسَ رَبَّ الناسِ",1],"، ",["بيَدِكَ الشِّفاءُ، لا كاشفَ له إلَّا أنتَ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (5744)، ومسلم (2191)، والنسائي في ((السنن الكبرى)) (10859)، وأحمد (24995) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › مرض النبي وموته","dorar":"M70OYxNW"},{"id":"س-00703","fp":"08dd5366531f","stateId":287,"easy":"إذا رقيت فقلت «بسم الله أرقيك» ← الله يشفيك","cause":"بسمِ اللَّهِ أرقيكَ","result":"اللَّهُ يَشفيكَ","explicit":true,"apply":{"k":"say","t":"«بسم الله أرقيك»"},"ref":"صحيح ابن ماجه 2856","srcLabel":"الترمذي","text":["أنَّ جَبرائيلَ، أتى النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ، فقالَ: يا مُحمَّدُ اشتَكَيتَ ؟ قالَ: نعَم، قالَ: ",["بسمِ اللَّهِ أرقيكَ",1],"، مِن كلِّ شيءٍ يؤذيكَ، مِن شرِّ كلِّ نفسٍ أو عَينٍ، أو حاسِدٍ ",["اللَّهُ يَشفيكَ",2],"، بِسمِ اللَّهِ أَرقيكَ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (972) باختلاف يسير، وابن ماجه (3523) واللفظ له، والنسائي في ((الكبرى)) (4/393) باختلاف يسير.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"nGtKCVmo","merged":3,"otherRefs":["تخريج المسند لشعيب 11557 (صحيح)","تخريج مشكل الآثار 2904 (صحيح)"]},{"id":"س-01369","fp":"9e68f319d5a9","stateId":287,"easy":"إذا رقيت اللديغ ← يبرأ (من واقعة)","cause":"فرَقاه","result":"فبَرَأ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح البخاري 5007","srcLabel":"مسلم","text":["كُنَّا في مَسيرٍ لنا فنَزَلنا، فجاءَت جاريةٌ، فقالت: إنَّ سَيِّدَ الحَيِّ سَليمٌ، وإنَّ نَفَرَنا غَيبٌ، فهل منكم راقٍ؟ فقامَ معها رَجُلٌ ما كُنَّا نَأبُنُه برُقيةٍ، ",["فرَقاه",1]," ",["فبَرَأ",2],"، فأمَرَ له بثَلاثينَ شاةً، وسَقانا لَبَنًا، فلَمَّا رَجَعَ قُلنا له: أكُنتَ تُحسِنُ رُقيةً -أو كُنتَ تَرقي؟- قال: لا، ما رَقَيتُ إلَّا بأُمِّ الكِتابِ، قُلنا: لا تُحدِثوا شيئًا حتَّى نَأتيَ -أو نَسألَ- النَّبيَّ صلَّى اللهُ عليه وسلَّم، فلَمَّا قدِمنا المَدينةَ ذَكَرناه للنَّبيِّ صلَّى اللهُ عليه وسلَّم، فقال: وما كان يُدريه أنَّها رُقيةٌ؟ اقسِموا واضرِبوا لي بسَهمٍ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2201) باختلاف يسير","bab":"هبة وهدية › من استوهب من أصحابه شيئا","dorar":"VwzsQsPf"},{"id":"س-07537","fp":"7567b62e2135","stateId":287,"easy":"إذا رقيت بـ«بسم الله، تربة أرضنا، بريقة بعضنا» ← يُشفى سقيمنا بإذن ربنا","cause":"باسمِ اللهِ، تُربةُ أرضِنا، بِرِيقةِ بعضِنا","result":"يُشْفى سَقيمُنا، بإذنِ ربِّنا","explicit":true,"apply":{"k":"say","t":"«بسم الله، تربة أرضنا، بريقة بعضنا»"},"ref":"المستدرك على الصحيحين 8486","srcLabel":"السنة","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ كان إذا اشْتَكى الإنسانُ الشَّيءَ منه أو كانت به قَرْحةٌ أو جُرحٌ، قال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ بإصبعِه هكذا -ووضَعَ أبو بَكرٍ سبَّابَتَه بالأرضِ ثمَّ رفَعَها-: ",["باسمِ اللهِ، تُربةُ أرضِنا، بِرِيقةِ بعضِنا",1],"، ",["يُشْفى سَقيمُنا، بإذنِ ربِّنا",2],"."],"grade":"صحيح","narrator":"عائشة","muhaddith":"صحيح على شرط الشيخين، ولم يخرجاه","bab":"فضائل النبي وصفته ودلائل النبوة › بركة النبي","dorar":"BTWtjrVO","merged":2,"otherRefs":["صحيح ابن ماجه 2854 (صحيح)"]},{"id":"س-00990","fp":"963b83f76b9f","stateId":287,"easy":"إذا قلت عند المريض سبعاً «أسأل الله العظيم رب العرش العظيم أن يشفيك» ← يُعافى ما لم يحضر أجله","cause":"مَن عادَ أخاه المُسلِمَ فقَعَد عِندَ رَأسِه، ثمَّ قالَ سَبْعَ مَرَّاتٍ: أسألُ اللهَ العَظيمَ رَبَّ العَرشِ العَظيمِ أن يَشفِيَكَ","result":"عُوفي إنْ لم يَكُن أجَلُه حَضَر","explicit":true,"apply":{"k":"say","t":"«أسأل الله العظيم رب العرش العظيم أن يشفيك»"},"ref":"المستدرك على الصحيحين 1287","srcLabel":"الترمذي","text":[["مَن عادَ أخاه المُسلِمَ فقَعَد عِندَ رَأسِه، ثمَّ قالَ سَبْعَ مَرَّاتٍ: أسألُ اللهَ العَظيمَ رَبَّ العَرشِ العَظيمِ أن يَشفِيَكَ؛ ",1],["عُوفي إنْ لم يَكُن أجَلُه حَضَر",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح غريب","takhrij":"أخرجه البيهقي في ((الدعوات الكبير)) (600) واللفظ لهما، والترمذي (2083) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"WEd6UVEt"},{"id":"س-06893","fp":"622aae001c71","stateId":287,"easy":"إذا رقيت بـ«ربنا الله الذي في السماء تقدس اسمك...» ← يُشفى المريض بإذن الله","cause":"ربُّنا الَّذي في السَّماءِ تقدَّسَ اسمُك ، أمرُك في السَّماءِ والأرضِ ، كما رَحمتُك في السَّماءِ اجعَلْ رحمتَك في الأرضِ ، اغفِرْ لنا حوبَنَا وخطايَانَا ، أنت ربُّ الطَّيِّبينَ أنزِلْ رحمةً مِن رحمتِك علَى هذا الوجَعِ","result":"فقالاها فبَرِئا","explicit":true,"apply":{"k":"say","t":"«ربنا الله الذي في السماء تقدس اسمك...»"},"ref":"البحر الزخار 10/18","srcLabel":"أبو داود","text":["أنَّ رجُلَينِ أقبلَا يلتَمِسانِ لأنفسِهِما الشِّفاءَ من البَولِ ، فانطُلِقَ بهِما إلى أبي الدَّرداءِ ، فقالَ : سمعتُ رسولَ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ يقولُ : ",["ربُّنا الَّذي في السَّماءِ تقدَّسَ اسمُك ، أمرُك في السَّماءِ والأرضِ ، كما رَحمتُك في السَّماءِ اجعَلْ رحمتَك في الأرضِ ، اغفِرْ لنا حوبَنَا وخطايَانَا ، أنت ربُّ الطَّيِّبينَ أنزِلْ رحمةً مِن رحمتِك علَى هذا الوجَعِ",1]," ، ",["فقالاها فبَرِئا",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"محفوظ","takhrij":"أخرجه أبو داود (3892)، والنسائي في ((الكبرى)) (6/257) باختلاف يسير، والبزار (4080) واللفظ له.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"yHPWqkXe"},{"id":"س-07920","fp":"70dbd0dc3079","stateId":287,"easy":"إذا عدت مريضاً لم يحضر أجله فقلت سبعاً «أسأل الله العظيم...» ← يعافيه الله","cause":"مَن عادَ مريضًا لم يَحضُرْ أجَلُهُ، فقال عِندَهُ سَبْعَ مِرارٍ: أسألُ اللهَ العظيمَ ربَّ العرشِ العظيمِ أنْ يَشفيَكَ","result":"إلَّا عافاهُ اللهُ مِن ذلكَ المرَضِ","explicit":true,"apply":{"k":"say","t":"«أسألُ اللهَ العظيمَ ربَّ العرشِ العظيمِ أنْ يَشفيَكَ، إلَّا عافاهُ اللهُ مِن ذلكَ المرَض»"},"ref":"تخريج سنن أبي داود 3106","srcLabel":"الترمذي","text":["عَنِ النَّبيِّ صلَّى اللَّهُ عليه وسلَّمَ، قال: ",["مَن عادَ مريضًا لم يَحضُرْ أجَلُهُ، فقال عِندَهُ سَبْعَ مِرارٍ: أسألُ اللهَ العظيمَ ربَّ العرشِ العظيمِ أنْ يَشفيَكَ، ",1],["إلَّا عافاهُ اللهُ مِن ذلكَ المرَضِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2083)، وأحمد (2137) باختلاف يسير","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"6AB1VxOw"},{"id":"س-07924","fp":"246a1a82a32e","stateId":287,"easy":"إذا عدت مسلماً فقلت سبعاً «أسأل الله العظيم...» ← يُشفى إلا أن يحضر أجله","cause":"ما من مُسلمٍ يعودُ مسلِمًا، فيقولُ سبعَ مرَّاتٍ : أسألُ اللَّهَ العظيمَ ربَّ العرشِ العظيمِ أن يشفيَكَ","result":"إلَّا شُفيَ ؛ إلَّا أن يَكونَ قَد حضرَ أجلُهُ","explicit":true,"apply":{"k":"say","t":"«أسألُ اللَّهَ العظيمَ ربَّ العرشِ العظيمِ أن يشفيَك»"},"ref":"هداية الرواة 1498","srcLabel":"أبو داود","text":[["ما من مُسلمٍ يعودُ مسلِمًا، فيقولُ سبعَ مرَّاتٍ : أسألُ اللَّهَ العظيمَ ربَّ العرشِ العظيمِ أن يشفيَكَ ؛",1]," ",["إلَّا شُفيَ ؛ إلَّا أن يَكونَ قَد حضرَ أجلُهُ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3106)، والترمذي (2083) باختلاف يسير، والبغوي في ((شرح السنة)) (1419) واللفظ له","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"o1Q45ly6"},{"id":"س-07941","fp":"588fd26c70f2","stateId":287,"easy":"إذا عدت أخاك فقلت «أسأل الله العظيم رب العرش العظيم أن يشفيك» ← يشفيه الله","cause":"ما مِن مسلِمٍ عادَ أخاهُ ، فيدخلَ عليهِ ، ولم يحضُر أجلُهُ ، فقالَ : أسألُ اللَّهَ العظيمَ ، ربَّ العرشِ العظيمِ ، أن يَشفيَ فلانًا مِن وجعِهِ ، سبعًا","result":"إلَّا شفاهُ اللَّهُ عزَّ وجلَّ منهُ","explicit":true,"apply":{"k":"say","t":"«أسأل الله العظيم رب العرش العظيم أن يشفيك»"},"ref":"تخريج المسند لشاكر 5/101","srcLabel":"أبو داود","text":[["ما مِن مسلِمٍ عادَ أخاهُ ، فيدخلَ عليهِ ، ولم يحضُر أجلُهُ ، فقالَ : أسألُ اللَّهَ العظيمَ ، ربَّ العرشِ العظيمِ ، أن يَشفيَ فلانًا مِن وجعِهِ ، سبعًا ،",1]," ",["إلَّا شفاهُ اللَّهُ عزَّ وجلَّ منهُ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3106)، والترمذي (2083)، والنسائي في ((السنن الكبرى)) (10887)، وأحمد (3298) واللفظ له","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"fVpjeTTX"},{"id":"س-02774","fp":"6c7e6445141f","stateId":287,"easy":"إذا رقيت بـ«بسم الله أرقيك والله يشفيك...» ← تُشفى","cause":"بِسمِ اللهِ أرقيكَ","result":"واللهُ يَشفيكَ مِن كُلِّ داءٍ يُؤذيكَ، ومِن شَرِّ النَّفَّاثاتِ في العُقَدِ، ومِن شَرِّ حاسِدٍ إذا حسَدَ","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"apply":{"k":"say","t":"«بسم الله أرقيك والله يشفيك...»"},"similar":["س-02733"],"ref":"تخريج المسند لشعيب 9757","srcLabel":"النسائي","text":["دخَلَ علَيَّ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ وأنا أشتَكي -قال عَبدُ الرَّحمنِ في حَديثِه: يَعودُني- فقال: ألَا أُعلِّمُكَ؟ قال عَبدُ الرَّحمنِ: ألَا أرقيكَ برُقيةٍ رَقاني بها جِبريلُ عليه السَّلامُ؟ قلت: بلى بأبي وأُمِّي. قال: ",["بِسمِ اللهِ أرقيكَ",1],"، ",["واللهُ يَشفيكَ مِن كُلِّ داءٍ يُؤذيكَ، ومِن شَرِّ النَّفَّاثاتِ في العُقَدِ، ومِن شَرِّ حاسِدٍ إذا حسَدَ",2],". وقال عَبدُ الرَّحمنِ: مِن كُلِّ داءٍ فيكَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"المرفوع منه صحيح لغيره","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10841)، وابن ماجه (3524)، وأحمد (9757) واللفظ له","bab":"إيمان › الملائكة","dorar":"bSTIy2Jw","merged":5,"otherRefs":["تخريج المسند لشعيب 26821 (صحيح)","المستدرك على الصحيحين 5793 (صحيح)","مجمع الزوائد 5/113 (صحيح)","الأحاديث المختارة 8 / 269 (صحيح)"]},{"id":"س-02734","fp":"52902b0f3545","stateId":287,"easy":"إذا قلت «أذهب البأس رب الناس، اشفِ أنت الشافي...» ← تنفع","cause":"أذْهِبِ الباسَ رَبَّ الناسِ، بيَدِكَ الشِّفاءُ، لا شافيَ إلَّا أنتَ، اشْفِ شِفاءً لا يُغادِرُ سَقَمًا","result":"كان يَنفَعُني في المُدَّةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«أذْهِبِ الباسَ رَبَّ الناسِ، بيَدِكَ الشِّفاءُ، لا شافيَ إلَّا أنتَ، اشْفِ شِفاءً لا يُغادِرُ سَقَمًا»"},"ref":"تخريج المسند لشعيب 26243","srcLabel":"أحمد","text":["كُنتُ أُعَوِّذُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ بدُعاءٍ إذا مرِضَ، كان جِبريلُ يُعوِّذُه به، ويَدْعو له به إذا مرِضَ، قالَتْ: فذَهَبتُ أُعَوِّذُه به: ",["أذْهِبِ الباسَ رَبَّ الناسِ، بيَدِكَ الشِّفاءُ، لا شافيَ إلَّا أنتَ، اشْفِ شِفاءً لا يُغادِرُ سَقَمًا",1],"، قالَتْ: فذَهَبتُ أدْعو له به في مَرَضِه الذي تُوفِّيَ فيه، فقال: ارْفَعي عنِّي، قال: فإنَّما ",["كان يَنفَعُني في المُدَّةِ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح دون قوله: \"ارفعي عني، فإنما كان ينفعني في المدة\"","takhrij":"أخرجه أحمد (26243) واللفظ له، وابن سعد في ((الطبقات الكبرى)) (2046)، وابن أبي الدنيا في ((المرض والكفارات)) (189)","bab":"إيمان › الملائكة","dorar":"wVnjeWpS","merged":2,"otherRefs":["صحيح ابن حبان 2962 (صحيح)"]},{"id":"س-00600","fp":"d2a8c62844b9","stateId":287,"easy":"إذا رقيت المريض بالفاتحة ← يبرأ كأنما نُشط من عقال","cause":"فرقاهُ بأمِّ القرآنِ ثلاثةَ أيَّامٍ غَدوةً وعَشيَّةً كلَّما ختمَها جمعَ بزاقَهُ ثمَّ تفلَ","result":"فَكَأنَّما أُنْشِطَ من عقالٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"السلسلة الصحيحة 5/44","srcLabel":"أبو داود","text":["أنَّهُ مرَّ بقومٍ فأتَوهُ فقالوا إنَّكَ جِئتَ مِن عندِ هذا الرَّجلِ بخيرٍ فارْقِ لَنا هذا الرَّجلَ فأتوهُ برجلٍ معتوهٍ في القُيودِ ",["فرقاهُ بأمِّ القرآنِ ثلاثةَ أيَّامٍ غَدوةً وعَشيَّةً كلَّما ختمَها جمعَ بزاقَهُ ثمَّ تفلَ",1]," ",["فَكَأنَّما أُنْشِطَ من عقالٍ",2]," فأعطَوهُ شيئًا فأتى النَّبيَّ صلَّى اللَّهُ علَيهِ وسلَّمَ فذَكَرَهُ لهُ فقالَ النَّبيُّ صلَّى اللَّهُ علَيهِ وسلَّمَ كُلْ فلَعَمري لَمن أَكَلَ برقيةِ باطلٍ لقد أَكَلتَ برقيةِ حقٍّ"],"grade":"صحيح","narrator":"عم خارجة بن الصلت [يقال أنه: علاقة بن صحار التميمي]","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3420)، وأحمد (21835)، والنسائي في ((السنن الكبرى)) (10804) جميعهم باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"NZOQPKh4"},{"id":"س-02038","fp":"54999ae9b425","stateId":287,"easy":"إذا سألت الله العفو والعافية ← فلم يُعطَ الناس أفضل منهما","cause":"إنَّ الناسَ لم يُعطوا شيئًا","result":"أفضلَ من العفوِ والعافيةِ فسلُوهما اللهَ","explicit":true,"ref":"البحر الزخار 1/78","srcLabel":"الترمذي","text":["قام فينا أبو بكرٍ رحمةُ اللهِ عليه ، فقال : قام فينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ كقيامي فيكم اليومَ ، فقال : ",["إنَّ الناسَ لم يُعطوا شيئًا ",1],["أفضلَ من العفوِ والعافيةِ فسلُوهما اللهَ",2]],"grade":"حسن","narrator":"أبو بكر الصديق","muhaddith":"حسن الإسناد، ولا نعلم أسنده إلا زائدة","takhrij":"أخرجه الترمذي (3558)، والنسائي في ((السنن الكبرى)) (10717)، وأحمد (6) مطولاً باختلاف يسير، والبزار (23) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"CLqWWTNq"},{"id":"س-02733","fp":"a25a2bd12081","stateId":287,"easy":"إذا رقيت بـ«بسم الله أرقيك من كل شيء يؤذيك...» ← تُشفى","cause":"بِاسمِ اللهِ أرقيكَ، مِن كلِّ شيءٍ يُؤذيكَ؛ مِن حَسدِ كلِّ حاسدٍ وعَينٍ، بِاسمِ اللهِ يَشفيكَ","result":"إنَّ جِبريلَ رَقاني برُقيةٍ بَرِئتُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«بسم الله أرقيك من كل شيء يؤذيك...»"},"repOf":"س-02774","otherNeedIds":[30],"ref":"تخريج المسند لشعيب 22759","text":["دَخَلتُ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أعودُه، وبه مِن الوَجَعِ ما يَعلَمُ اللهُ شِدَّةً، ثُمَّ دَخَلتُ عليه مِن العَشيِّ، وقد بَرِئَ أحسَنَ بُرْءٍ، فقُلْتُ له: دَخَلتُ عليك غَدْوةً وبك مِن الوَجَعِ ما يَعلَمُ اللهُ شِدَّةً، ودَخَلتُ عليك العَشيَّةَ وقد بَرِئتَ، فقال: يا ابنَ الصَّامتِ، ",["إنَّ جِبريلَ رَقاني برُقيةٍ بَرِئتُ",2],"، ألَا أُعلِّمُكَها؟ قُلْتُ: بَلى، قال: ",["بِاسمِ اللهِ أرقيكَ، مِن كلِّ شيءٍ يُؤذيكَ؛ مِن حَسدِ كلِّ حاسدٍ وعَينٍ، بِاسمِ اللهِ يَشفيكَ",1],"."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10842) باختلاف يسير، وابن ماجه (3527) مختصراً، وأحمد (22759) واللفظ له","bab":"إيمان › الملائكة","dorar":"Wtzi5q9f"},{"id":"س-04939","fp":"83d7378f542b","stateId":287,"easy":"إذا رقيت فقل «أذهب البأس رب الناس، اشف أنت الشافي...» ← يكفيك","cause":"أَذهِبِ البَاسَ ربَّ النَّاسِ، اشْفِ أنتَ الشَّافي، لا شفاءَ إلَّا شفاؤكَ، شفاءً لا يُغادِرُ سَقمًا","result":"إنَّما كان يَكفيكِ أنْ تَقولي","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«أَذهِبِ البَاسَ ربَّ النَّاسِ، اشْفِ أنتَ الشَّافي، لا شفاءَ إلَّا شفاؤكَ، شفاءً لا يُغادِرُ سَقمًا»"},"ref":"تخريج المسند لشعيب 3615","srcLabel":"أبو داود","text":["عن زَينبَ امرأةِ عبدِ اللهِ، قالتْ: كان عبدُ اللهِ إذا جاء مِن حاجةٍ فانْتَهى إلى البابِ، تنَحنَحَ وبزَقَ؛ كراهيَةَ أنْ يهجُمَ منَّا على شيءٍ يكرَهُه، قالتْ: وإنَّه جاء ذاتَ يومٍ، فتنَحنَحَ، قالت: وعندي عجوزٌ تَرقيني مِن الحُمْرةِ، فأدخَلْتُها تحتَ السَّريرِ، فدخَلَ، فجلَسَ إلى جَنبي، فرَأى في عُنُقي خَيطًا، قال: ما هذا الخَيطُ؟ قالتْ: قُلْتُ: خَيطٌ أُرقيَ لي فيه، قالتْ: فأخَذَه فقطَعَه، ثُمَّ قال: إنَّ آلَ عبدِ اللهِ لَأغنياءُ عن الشِّركِ، سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: \"إنَّ الرُّقى والتَّمائمَ والتِّوَلةَ شِركٌ\"، قالتْ: فقُلْتُ له: لِمَ تقولُ هذا وقد كانتْ عَيني تقذِفُ، فكنتُ أختلِفُ إلى فُلانٍ اليهوديِّ يَرقيها، وكان إذا رَقاها سكَنَتْ؟ قال: إنَّما ذلك عملُ الشَّيطانِ، كان ينخُسُها بيَدِه، فإذا رَقَيْتِها كَفَّ عنها، ",["إنَّما كان يَكفيكِ أنْ تَقولي",2]," كما قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: \"",["أَذهِبِ البَاسَ ربَّ النَّاسِ، اشْفِ أنتَ الشَّافي، لا شفاءَ إلَّا شفاؤكَ، شفاءً لا يُغادِرُ سَقمًا",1],"\"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (3883)، وابن ماجه (3530)، وأحمد (3615) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"aUsGFm9B"},{"id":"س-05361","fp":"7e3f017cbe06","stateId":287,"easy":"إذا آمنت بالله ودعوته ← يشفيك (من قصة الغلام)","cause":"آمَنتَ باللَّهِ دَعَوتُ اللَّهَ","result":"فآمَنَ باللَّهِ فشَفاه اللهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح مسلم 3005","srcLabel":"النسائي","text":["كان مَلِكٌ فيمَن كان قَبلَكُم، وكان له ساحِرٌ، فلَمَّا كَبِرَ قال للمَلِكِ: إنِّي قد كَبِرتُ، فابعَث إليَّ غُلامًا أُعَلِّمْه السِّحرَ، فبَعَثَ إليه غُلامًا يُعَلِّمُه، فكان في طَريقِه إذا سَلَكَ راهِبٌ، فقَعَدَ إليه وسَمِعَ كَلامَه، فأعجَبَه، فكان إذا أتى السَّاحِرَ مَرَّ بالرَّاهِبِ وقَعَدَ إليه، فإذا أتى السَّاحِرَ ضَرَبَه، فشَكا ذلك إلى الرَّاهِبِ، فقال: إذا خَشيتَ السَّاحِرَ، فقُل: حَبَسَني أهلي، وإذا خَشيتَ أهلَكَ فقُل: حَبَسَني السَّاحِرُ، فبينَما هو كَذلك إذ أتى على دابَّةٍ عَظيمةٍ قد حَبَسَتِ النَّاسَ، فقال: اليومَ أعلَمُ آلسَّاحِرُ أفضَلُ أمِ الرَّاهِبُ أفضَلُ؟ فأخَذَ حَجَرًا، فقال: اللَّهُمَّ إن كان أمرُ الرَّاهِبِ أحَبَّ إليكَ مِن أمرِ السَّاحِرِ فاقتُلْ هذه الدَّابَّةَ حتَّى يَمضيَ النَّاسُ، فرَماها فقَتَلَها، ومَضى النَّاسُ، فأتى الرَّاهِبَ فأخبَرَه، فقال له الرَّاهِبُ: أي بُنَيَّ، أنتَ اليومَ أفضَلُ مِنِّي؛ قد بَلَغَ مِن أمرِكَ ما أرى، وإنَّكَ سَتُبتَلى، فإنِ ابتُليتَ فلا تَدُلَّ عليَّ. وكان الغُلامُ يُبرِئُ الأكمَهَ والأبرَصَ، ويُداوي النَّاسَ مِن سائِرِ الأدواءِ، فسَمِعَ جَليسٌ للمَلِكِ كان قد عَميَ، فأتاه بهَدايا كَثيرةٍ، فقال: ما هاهنا لكَ أجمَعُ إن أنتَ شَفَيتَني، فقال: إنِّي لا أشفي أحَدًا، إنَّما يَشفي اللهُ، فإن أنتَ ",["آمَنتَ باللَّهِ دَعَوتُ اللَّهَ",1]," فشَفاكَ، ",["فآمَنَ باللَّهِ فشَفاه اللهُ",2],"، فأتى المَلِكَ فجَلَسَ إليه كما كان يَجلِسُ، فقال له المَلِكُ: مَن رَدَّ عليكَ بَصَرَكَ؟ قال: رَبِّي، قال: ولَكَ رَبٌّ غيري؟ قال: رَبِّي ورَبُّكَ اللهُ، فأخَذَه، فلَم يَزَلْ يُعَذِّبُه حتَّى دَلَّ على الغُلامِ، فجيءَ بالغُلامِ، فقال له المَلِكُ: أي بُنَيَّ، قد بَلَغَ مِن سِحرِكَ ما تُبرِئُ الأكمَهَ والأبرَصَ، وتَفعَلُ وتَفعَلُ! فقال: إنِّي لا أشفي أحَدًا، إنَّما يَشفي اللهُ، فأخَذَه، فلَم يَزَلْ يُعَذِّبُه حتَّى دَلَّ على الرَّاهِبِ، فجيءَ بالرَّاهِبِ، فقيلَ له: ارجِعْ عن دينِكَ، فأبى، فدَعا بالمِئشارِ، فوضَعَ المِئشارَ في مَفرِقِ رَأسِه، فشَقَّه حتَّى وقَعَ شِقَّاه. ثُمَّ جيءَ بجَليسِ المَلِكِ فقيلَ له: ارجِعْ عن دينِكَ، فأبى، فوضَعَ المِئشارَ في مَفرِقِ رَأسِه، فشَقَّه به حتَّى وقَعَ شِقَّاه، ثُمَّ جيءَ بالغُلامِ فقيلَ له: ارجِعْ عن دينِكَ، فأبى، فدَفَعَه إلى نَفَرٍ مِن أصحابِه، فقال: اذهَبوا به إلى جَبَلِ كَذا وكَذا، فاصعَدوا به الجَبَلَ، فإذا بَلَغتُم ذِرْوَتَه، فإن رَجَعَ عن دينِه، وإلَّا فاطرَحوه، فذَهَبوا به فصَعِدوا به الجَبَلَ، فقال: اللَّهُمَّ اكفِنيهم بما شِئتَ، فرَجَفَ بهِمِ الجَبَلُ فسَقَطوا، وجاءَ يَمشي إلى المَلِكِ، فقال له المَلِكُ: ما فعَلَ أصحابُكَ؟ قال: كَفانيهمُ اللهُ، فدَفَعَه إلى نَفَرٍ مِن أصحابِه، فقال: اذهَبوا به فاحمِلوه في قُرقورٍ، فتَوسَّطوا به البَحرَ، فإن رَجَعَ عن دينِه، وإلَّا فاقذِفوه، فذَهَبوا به، فقال: اللَّهُمَّ اكفِنيهم بما شِئتَ، فانكَفَأت بهِمُ السَّفينةُ فغَرِقوا، وجاءَ يَمشي إلى المَلِكِ، فقال له المَلِكُ: ما فعَلَ أصحابُكَ؟ قال: كَفانيهمُ اللهُ. فقال للمَلِكِ: إنَّكَ لَستَ بقاتِلي حتَّى تَفعَلَ ما آمُرُكَ به، قال: وما هو؟ قال: تَجمَعُ النَّاسَ في صَعيدٍ واحِدٍ، وتَصلُبُني على جِذعٍ، ثُمَّ خُذْ سَهمًا مِن كِنانَتي، ثُمَّ ضَعِ السَّهمَ في كَبِدِ القَوسِ، ثُمَّ قُلْ: باسمِ اللهِ رَبِّ الغُلامِ، ثُمَّ ارمِني؛ فإنَّكَ إذا فعَلتَ ذلك قَتَلتَني، فجَمَع النَّاسَ في صَعيدٍ واحِدٍ، وصَلَبَه على جِذعٍ، ثُمَّ أخَذَ سَهمًا مِن كِنانَتِه، ثُمَّ وضَعَ السَّهمَ في كَبدِ القَوسِ، ثُمَّ قال: باسمِ اللهِ رَبِّ الغُلامِ، ثُمَّ رَماه فوقَعَ السَّهمُ في صُدغِه، فوضَعَ يَدَه في صُدغِه في مَوضِعِ السَّهمِ فماتَ، فقال النَّاسُ: آمَنَّا برَبِّ الغُلامِ، آمَنَّا برَبِّ الغُلامِ، آمَنَّا برَبِّ الغُلامِ. فأُتيَ المَلِكُ فقيلَ له: أرَأيتَ ما كُنتَ تَحذَرُ؟ قد واللَّهِ نَزَلَ بكَ حَذَرُكَ، قد آمَنَ النَّاسُ، فأمَرَ بالأُخدودِ في أفواهِ السِّكَكِ فخُدَّت، وأضرَمَ النِّيرانَ، وقال: مَن لَم يَرجِعْ عن دينِه فأحموه فيها، أو قيلَ له: اقتَحِمْ، ففَعَلوا حتَّى جاءَتِ امرَأةٌ ومعها صَبيٌّ لَها، فتَقاعَسَت أن تَقَعَ فيها، فقال لَها الغُلامُ: يا أُمَّه، اصبِري؛ فإنَّكِ على الحَقِّ."],"grade":"صحيح","narrator":"صهيب بن سنان الرومي","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (23931)، والنسائي في ((الكبرى)) (11597)، وابن حبان (873) باختلاف يسير.","bab":"رقائق وزهد › التوكل واليقين","dorar":"2N3Sld4u"},{"id":"س-07396","fp":"71ab5f53c6d4","stateId":287,"easy":"إذا دعا لك الصالح «اللهم عافه» ← تُعافى (من واقعة)","cause":"اللَّهمَّ عافِهِ","result":"فما اشتَكَيتُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«اللهم عافه»"},"otherNeedIds":[28],"ref":"تخريج المسند لشاكر 2/54","srcLabel":"الترمذي","text":["كنتُ شاكيًا ، فمرَّ بي رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فذَكَرَ مَعناهُ ، إلَّا أنَّهُ قالَ : ",["اللَّهمَّ عافِهِ",1]," ، اللَّهمَّ اشفِهِ ",["فما اشتَكَيتُ",2]," ذلكَ الوجَعَ بعدُ"],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (3564)، والنسائي في ((السنن الكبرى)) (10830)، وابن حبان (6940) جميعهم باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › إجابة دعاء النبي","dorar":"xGCNJBgk"},{"id":"س-00691","fp":"e2e122add283","stateId":287,"easy":"إذا أصابك وجع فقل «بسم الله الكبير، نعوذ بالله العظيم من شر عرق نعّار...» ← تُشفى","cause":"أنْ يَقولَ: باسمِ اللهِ الكبيرِ، نَعوذُ باللهِ العظيمِ مِن شَرِّ عِرقٍ نَعَّارٍ، ومِن شَرِّ حَرِّ النَّارِ","result":"يُعلِّمُهم مِنَ الأوجاعِ ولمَن يُحْمى","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«بسم الله الكبير، نعوذ بالله العظيم من شر عرق نعّار...» · الوقت: عند المرض والوجع"},"ref":"المستدرك على الصحيحين 8494","srcLabel":"الترمذي","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ كان ",["يُعلِّمُهم مِنَ الأوجاعِ ولمَن يُحْمى",2]," ",["أنْ يَقولَ: باسمِ اللهِ الكبيرِ، نَعوذُ باللهِ العظيمِ مِن شَرِّ عِرقٍ نَعَّارٍ، ومِن شَرِّ حَرِّ النَّارِ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد، ولم يخرجاه","takhrij":"أخرجه الترمذي (2075)، وابن ماجه (3526)، وأحمد (2729) واللفظ لهم","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"cyF1NM3C"},{"id":"س-05424","fp":"44d6d75b1d02","stateId":288,"easy":"إذا سألت الله العافية ← فلم يُعطَ أحد مثلها بعد اليقين","cause":"سَلُوا اللهَ العافيةَ","result":"فإنَّه لم يُعْطَ أحَدٌ مِثْلَ العافيةِ بَعْدَ اليَقينِ","explicit":true,"star":true,"similar":["س-05306","س-05308","س-03176","س-05816","س-00302","س-02462"],"otherNeedIds":[5],"ref":"الأحاديث المختارة 73","srcLabel":"متفق عليه","text":["«أنَّه قام في النَّاسِ على مِنبَرِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم -وفي روايةٍ: إلى جَنْبِ مِنبَرِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم- فذكَرَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم ثُمَّ بكى، فقال: أيُّها النَّاسُ إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قام فينا مقامي فيكم هذا من عامِ أوَّلَ، فقال: يا أيُّها النَّاسُ ",["سَلُوا اللهَ العافيةَ؛ ",1],["فإنَّه لم يُعْطَ أحَدٌ مِثْلَ العافيةِ بَعْدَ اليَقينِ",2],"، وقال عُثمانُ: بَعْدَ يَقينٍ»."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الحزن والبكاء","dorar":"HMiOnEts","merged":9,"otherRefs":["الأحاديث المختارة 68 (صحيح)","الإيمان لابن تيمية 217 (صحيح)","الأحاديث المختارة 71 (صحيح)","تخريج زاد المعاد 4/197 (صحيح)","المصابيح في الأحاديث المتواترة 630 (صحيح)","تخريج مسند أبي بكر 94 (صحيح)","المستدرك على الصحيحين 1962 (صحيح)","صحيح الترمذي 3558 (صحيح)"]},{"id":"س-05306","fp":"eaffd8f5d6ff","stateId":288,"easy":"إذا سألت الله العفو والعافية ← فلم يُعطَ الناس بعد اليقين خيراً من العافية","cause":"أسألُ اللَّهَ العفوَ والعافيةَ","result":"فإنَّ النَّاسَ لم يُعطَوا بعدَ اليقينِ شيئًا خيرًا منَ العافيةِ","explicit":true,"repOf":"س-05424","ref":"تخريج المسند لشاكر 1/38","text":["[عن] أوسط البجلي عن أبي بَكْرٍ الصِّدِّيقِ رضيَ اللَّهُ عنهُ قالَ : سَمِعْتُهُ يخطبُ النَّاسَ ، وقالَ مرَّةً : حينَ استُخْلِفَ فقالَ: رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قامَ عامَ الأوَّلِ مقامي هذا وبَكَى أبو بَكْرٍ ، رضيَ اللَّهُ عنهُ ، فقالَ : ",["أسألُ اللَّهَ العفوَ والعافيةَ",1]," ، ",["فإنَّ النَّاسَ لم يُعطَوا بعدَ اليقينِ شيئًا خيرًا منَ العافيةِ",2]," ، وعليكم بالصِّدقِ ، فإنَّهُ في الجنَّةِ ، وإيَّاكم والكَذِبَ ، فإنَّهُ معَ الفُجورِ ، وَهُما في النَّارِ ، ولا تَقاطَعوا ولا تباغَضوا ، ولا تحاسَدوا ، ولا تدابَروا ، وَكونوا إخوانًا كما أمرَ اللَّهُ عزَّ وجلَّ"],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (3849)، والبخاري في ((الأدب المفرد)) (724) باختلاف يسير.","bab":"رقائق وزهد › التوكل واليقين","dorar":"JsBQJgjg"},{"id":"ق-0719","fp":"19a32462fa89","stateId":288,"easy":"الإيمان بالقرآن ← شفاء ورحمة","cause":"الإيمان بالقرآن","result":"شفاء ورحمة","explicit":true,"star":true,"otherNeedIds":[23,5],"ref":"سورة الإسراء: 82","srcLabel":"القرآن الكريم","quran":{"s":17,"from":82,"to":82,"text":"وَنُنَزِّلُ مِنَ الْقُرْآنِ مَا هُوَ شِفَاءٌ وَرَحْمَةٌ لِلْمُؤْمِنِينَ وَلَا يَزِيدُ الظَّالِمِينَ إِلَّا خَسَارًا (82)","hl":[[0,71,1]]}},{"id":"ق-1139","fp":"0688e7fcd446","stateId":288,"easy":"الإيمان ← القرآن له هدى وشفاء","cause":"الإيمان","result":"القرآن له هدى وشفاء","explicit":true,"star":true,"otherNeedIds":[13,5],"ref":"سورة فصلت: 44","srcLabel":"القرآن الكريم","quran":{"s":41,"from":44,"to":44,"text":"وَلَوْ جَعَلْنَاهُ قُرْآنًا أَعْجَمِيًّا لَقَالُوا لَوْلَا فُصِّلَتْ آيَاتُهُ أَأَعْجَمِيٌّ وَعَرَبِيٌّ قُلْ هُوَ لِلَّذِينَ آمَنُوا هُدًى وَشِفَاءٌ وَالَّذِينَ لَا يُؤْمِنُونَ فِي آذَانِهِمْ وَقْرٌ وَهُوَ عَلَيْهِمْ عَمًى أُولَئِكَ يُنَادَوْنَ مِنْ مَكَانٍ بَعِيدٍ (44)","hl":[[104,148,1]]}},{"id":"س-06754","fp":"4b0535d4154c","stateId":288,"easy":"إذا غزوت وصمت وسافرت ← تغنم وتصح وتستغني","cause":"اغزوا","result":"تغنَموا وصوموا تصحُّوا وسافِروا تستَغنوا","explicit":true,"star":true,"apply":{"k":"time","t":"في السفر"},"otherNeedIds":[1],"ref":"الزواجر عن اقتراف الكبائر 1/197","srcLabel":"السنة","text":[["اغزوا ",1],["تغنَموا وصوموا تصحُّوا وسافِروا تستَغنوا",2]],"grade":"صحيح","muhaddith":"صحيح أو حسن","bab":"صيام › فضل الصيام","dorar":"EpfyZlgQ","merged":3,"otherRefs":["السلسلة الصحيحة 3352 (صحيح)","إتحاف الخيرة المهرة 6/154 (حسن)"]},{"id":"س-05308","fp":"179b4dd5ce07","stateId":288,"easy":"إذا سألت الله المعافاة ← فلم يُؤتَ أحد بعد اليقين خيراً منها","cause":"سَلوا اللَّهَ المُعافاةَ","result":"فإنَّهُ لم يُؤتَ أحدٌ مِثلَ يقينٍ بعدَ المعافاةِ ، ولا أشدَّ مِن ريبةٍ بعدَ كُفرٍ","explicit":true,"repOf":"س-05424","otherNeedIds":[48],"ref":"تخريج المسند لشاكر 1/41","text":["عن أوسط بن عمرو، قال: قَدِمْتُ المدينةَ بعدَ وفاةِ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ بسنةٍ ، فألفيتُ أبا بَكْرٍ يخطبُ النَّاسَ فقالَ : قامَ فينا رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ عامَ الأوَّلِ ، فخَنقَتهُ العَبرةُ ثلاثَ مرارٍ ثمَّ قالَ : يا أيُّها النَّاسُ ",["سَلوا اللَّهَ المُعافاةَ",1]," ، ",["فإنَّهُ لم يُؤتَ أحدٌ مِثلَ يقينٍ بعدَ المعافاةِ ، ولا أشدَّ مِن ريبةٍ بعدَ كُفرٍ",2]," ، وعليكُم بالصِّدقِ ، فإنَّهُ يَهْدي إلى البرِّ ، وَهُما في الجنَّةِ ، وإيَّاكم والكذِبَ ، فإنَّهُ يَهْدي إلى الفجورِ ، وَهُما في النَّارِ"],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10719)، وأحمد (44) باختلاف يسير، وابن ماجه (3849) بنحوه بزيادة في آخره","bab":"رقائق وزهد › التوكل واليقين","dorar":"Oe6d3yg7","merged":2,"otherRefs":["صحيح الأدب المفرد 557 (صحيح)"]},{"id":"س-06397","fp":"3f6adc4ba419","stateId":288,"easy":"إذا تصدقت عن مرضاك ← فالصدقة دواء لهم","cause":"بالصَّدَقةِ","result":"داووا مَرضاكُم","explicit":true,"ref":"الفروع لابن مفلح 3/ 261","srcLabel":"الطبراني","text":["\"",["داووا مَرضاكُم",2]," ",["بالصَّدَقةِ",1],"، وحَصِّنوا أموالَكُم بالزَّكاةِ، وأعِدُّوا للبَلاءِ الدُّعاءَ\""],"grade":"صحيح","narrator":"عبد الله","muhaddith":"حسن، ومعناه صحيح","takhrij":"أخرجه البيهقي (6667) بلفظه، والطبراني في ((الأوسط)) (1963)، وأبو نعيم الأصبهاني في ((حلية الأولياء)) (4/ 237) كلاهما بتقديم وتأخير في لفظه.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"hcesJBVx","merged":2,"otherRefs":["صحيح الترغيب 744 (حسن)"]},{"id":"س-00711","fp":"606be241d214","stateId":288,"easy":"إذا سألت الله المغفرة والعافية ← فلا شيء أفضل منهما","cause":"أن يغفِرَ لهم ويعافيَهم","result":"ما سأل العِبادُ شيئًا أفضَلَ","explicit":true,"otherNeedIds":[11],"ref":"مجمع الزوائد 10/177","srcLabel":"البزار","text":[["ما سأل العِبادُ شيئًا أفضَلَ",2]," مِن ",["أن يغفِرَ لهم ويعافيَهم",1]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"رجاله رجال الصحيح غير موسى بن السائب وهو ثقة","takhrij":"أخرجه البزار  (4090)","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"lGvmYxW3"},{"id":"س-01961","fp":"05af1497cb23","stateId":288,"easy":"إذا عدت مريضاً فقلت سبعاً «أسأل الله العظيم...» ← يشفيه الله إن لم يحضر أجله","cause":"مَن عادَ مَريضًا فقال: أسأَلُ اللهَ العظيمَ، ربَّ العَرشِ العظيمِ أنْ يَشفِيَكَ","result":"سبعَ مرَّاتٍ، شَفاه اللهُ إنْ كان قد أُخِّرَ؛ يعني: في أجَلِه","explicit":true,"apply":{"k":"say","t":"«أسأَلُ اللهَ العظيمَ، ربَّ العَرشِ العظيمِ أنْ يَشفِيَكَ»"},"otherNeedIds":[34],"ref":"تخريج المسند لشعيب 2138","srcLabel":"أبو داود","text":[["مَن عادَ مَريضًا فقال: أسأَلُ اللهَ العظيمَ، ربَّ العَرشِ العظيمِ أنْ يَشفِيَكَ، ",1],["سبعَ مرَّاتٍ، شَفاه اللهُ إنْ كان قد أُخِّرَ؛ يعني: في أجَلِه",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3106)، والترمذي (2083) بنحوه، والنسائي في ((السنن الكبرى)) (10882) باختلاف يسير، وأحمد (2138) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"9tEXtxGV"},{"id":"س-03176","fp":"d962933b95cc","stateId":288,"easy":"إذا سألت الله العافية ← فلم يُعطَ العباد أفضل منها","cause":"سَلُوا اللهَ العافيةَ","result":"فإنَّهُ لم يُعْطَ العِبادُ شَيئًا أَفضَلَ مِنَ العافيةَ، إلَّا أنْ يَكونَ اليَقينُ","explicit":true,"repOf":"س-05424","ref":"تخريج مسند أبي بكر 134","text":["قامَ أبو بَكرٍ على المِنبرِ بعْدَ وفاةِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقال: يا أيُّها النَّاسُ، إنِّي سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ –وبكَى حتَّى ابتَلَّتْ لِحيَتُه، فقال: سمِعتُه يقولُ: «",["سَلُوا اللهَ العافيةَ؛ ",1],["فإنَّهُ لم يُعْطَ العِبادُ شَيئًا أَفضَلَ مِنَ العافيةَ، إلَّا أنْ يَكونَ اليَقينُ»",2],"."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3558) بنحوه، والنسائي في ((السنن الكبرى)) (10721)، وأحمد (49) باختلاف يسير، وابن ماجه (3849) بنحوه مطولاً، والمروزي في ((مسند أبي بكر)) (134) واللفظ له","bab":"إيمان › حب الرسول","dorar":"Lx2S9DyF"},{"id":"س-05324","fp":"4a7594174af6","stateId":288,"easy":"إذا سألت الله اليقين والمعافاة ← فلم يُعطَ الناس في الدنيا خيراً منهما","cause":"فسَلُوهُما اللهَ عزَّ وجلَّ","result":"إنَّ الناسَ لم يُعطَوْا في الدُّنيا خيرًا مِن اليقينِ والمُعافاةِ","explicit":true,"otherNeedIds":[5],"ref":"تخريج المسند لشعيب 38","srcLabel":"الترمذي","text":["أنَّ أبا بَكْرٍ خطَبَ الناسَ فقال: قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: أيُّها الناسُ، ",["إنَّ الناسَ لم يُعطَوْا في الدُّنيا خيرًا مِن اليقينِ والمُعافاةِ",2],"، ",["فسَلُوهُما اللهَ عزَّ وجلَّ",1],"."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (3558)، والنسائي في ((السنن الكبرى)) (10721) بنحوه، وابن ماجه (3849) مطولاً بنحوه، وأحمد (38) واللفظ له","bab":"رقائق وزهد › التوكل واليقين","dorar":"s6e8V8xk"},{"id":"س-05331","fp":"2a6d393dbd9a","stateId":288,"easy":"إذا سألت الله العفو والعافية والمعافاة ← فما أُوتي عبد بعد اليقين خيراً من المعافاة","cause":"سَلوا اللهَ عَزَّ وجَلَّ العَفْوَ والعافِيةَ والمُعافاةَ","result":"فإنَّه ما أوتِيَ عَبْدٌ بَعْدَ يَقينٍ خَيْرٌ مِن مُعافاةٍ","explicit":true,"ref":"الأحكام الوسطى 4/ 328","srcLabel":"الترمذي","text":["\"",["سَلوا اللهَ عَزَّ وجَلَّ العَفْوَ والعافِيةَ والمُعافاةَ؛ ",1],["فإنَّه ما أوتِيَ عَبْدٌ بَعْدَ يَقينٍ خَيْرٌ مِن مُعافاةٍ\"",2],"."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10651) واللفظ له، والترمذي (3558) بنحوه، وابن ماجه (3849) بزيادة فيه بدون: العفو والعافية.","bab":"رقائق وزهد › التوكل واليقين","dorar":"DPWyuIO3"},{"id":"س-05371","fp":"39a21687f20f","stateId":288,"easy":"إذا رُزقت العافية ← فلم يُعطَ عبد بعد اليقين أفضل منها","cause":"إنَّه لم يُعطَ عبْدٌ شَيئًا بعْدَ اليَقينِ","result":"أَفضَلَ مِنَ العافيةِ","explicit":true,"ref":"تخريج مسند أبي بكر 127","srcLabel":"الترمذي","text":[["«إنَّه لم يُعطَ عبْدٌ شَيئًا بعْدَ اليَقينِ ",1],["أَفضَلَ مِنَ العافيةِ",2],"، وإنَّا لَنَسألُ اللهَ اليَقينَ والعافيةَ."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3558) مختصراً بنحوه، والنسائي في ((السنن الكبرى)) (10721)، وأحمد (49) باختلاف يسير، وابن ماجه (3849) مطولاً، والمروزي في ((مسند أبي بكر)) (127) واللفظ له","bab":"رقائق وزهد › التوكل واليقين","dorar":"08L4uA2R"},{"id":"س-05816","fp":"234e5d3dc855","stateId":288,"easy":"إذا سألت الله العافية ← فلم يُعطَ عبد أفضل منها","cause":"سَلُوا اللهَ العافيةَ","result":"فإنَّه لم يُعطَ عبدٌ شيئًا أفضَلَ مِن العافيةِ، وعليكم بالصِّدقِ والبِرِّ؛ فإنَّهما في الجنَّةِ، وإيَّاكُم والكذبَ والفجورَ؛ فإنَّهما في النارِ","explicit":true,"repOf":"س-05424","ref":"تخريج المسند لشعيب 46","text":["قامَ أبو بَكْرٍ بعدَ وفاةِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ بعامٍ، فقال: قامَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ مَقامي عامَ الأوَّلِ، فقال: ",["سَلُوا اللهَ العافيةَ؛ ",1],["فإنَّه لم يُعطَ عبدٌ شيئًا أفضَلَ مِن العافيةِ، وعليكم بالصِّدقِ والبِرِّ؛ فإنَّهما في الجنَّةِ، وإيَّاكُم والكذبَ والفجورَ؛ فإنَّهما في النارِ",2],"."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (3558) مختصراً بنحوه، والنسائي في ((السنن الكبرى)) (10721)، وابن ماجه (3849)، وأحمد (46) واللفظ له","bab":"رقائق وزهد › الوصايا النافعة","dorar":"bf16SSmW"},{"id":"س-00812","fp":"b5a86daadd32","stateId":288,"easy":"إذا قلت عند العطاس «الحمد لله رب العالمين على كل حال» ← لا تجد وجع الضرس ولا الأذن","cause":"مَن قال عندَ عطسةٍ سَمِعَها: الحمدُ للهِ ربِّ العالمينَ على كُلِّ حالٍ، ما كان","result":"لم يَجِدْ وَجَعَ الضِّرسِ ولا الأُذُنِ أبدًا","explicit":true,"apply":{"k":"say","t":"«الحمد لله رب العالمين على كل حال»"},"ref":"إرشاد الساري 9/126","srcLabel":"السنة","text":["عن عليٍّ: ",["مَن قال عندَ عطسةٍ سَمِعَها: الحمدُ للهِ ربِّ العالمينَ على كُلِّ حالٍ، ما كان",1]," ",["لم يَجِدْ وَجَعَ الضِّرسِ ولا الأُذُنِ أبدًا",2],"."],"grade":"حسن","muhaddith":"رجاله ثقات وحكمه الرفع لأن مثله لا يقال من قبل الرأي","bab":"أدعية وأذكار › حمد الله في كل الأحوال","dorar":"rFMOpW3K"},{"id":"س-02324","fp":"04995b584ced","stateId":288,"easy":"إذا قرأت الفاتحة (رقية) ← ففيها شفاء من كل داء","cause":"في فاتِحةِ الكِتابِ","result":"شِفاءٌ مِن كُلِّ داءٍ","explicit":true,"ref":"فتح البيان 1/ 34","srcLabel":"السنة","text":["قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["في فاتِحةِ الكِتابِ",1]," ",["شِفاءٌ مِن كُلِّ داءٍ",2],"."],"grade":"حسن","narrator":"عبد الملك بن عمير","muhaddith":"رجاله ثقات","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"YKZrjW0C"},{"id":"س-07109","fp":"6e4ff705bd88","stateId":288,"easy":"إذا سألت ربك العافية في الدنيا والآخرة ← فهو خير ما تسأل","cause":"سَلْ رَبَّك العافِيةَ في الدُّنْيا والآخِرةِ","result":"عَلِّمْني شَيئًا أسْأَلُه رَبِّي عَزَّ وجَلَّ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"الأحاديث المختارة 8 / 379","srcLabel":"متفق عليه","text":["«قُلْتُ: يا رَسولَ اللهِ عَلِّمْني شَيئًا أسْأَلُ اللهَ، فقالَ: (سَلْ رَبَّك العافِيةَ) ثُمَّ أتَيْتُه -أيضًا- فقُلْتُ: يا رَسولَ اللهِ ",["عَلِّمْني شَيئًا أسْأَلُه رَبِّي عَزَّ وجَلَّ",2],"، فقالَ: (يا عبَّاسُ يا عَمَّ رَسولِ اللهِ، ",["سَلْ رَبَّك العافِيةَ في الدُّنْيا والآخِرةِ",1],"»)."],"grade":"صحيح","narrator":"‌‌العباس بن عبدالمطلب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"علم › تعليم الناس وفضل ذلك","dorar":"fQwhmQnq"},{"id":"س-00302","fp":"d43d6870dd33","stateId":288,"easy":"إذا سألت الله المعافاة ← فلم يُعطَ أحد بعد اليقين خيراً منها","cause":"المُعافاةَ","result":"فإنَّ النَّاسَ لمْ يُعطَوْا بعدَ اليَقينِ شيئًا هو أفضَلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-05424","ref":"تخريج مشكل الآثار 453","text":["عن أوسَطَ البَجَليِّ، أنَّه سمِع أبا بكْرٍ، رضي اللهُ عنه يخطُبُ فقال: إنَّ رسولَ اللهِ عليه السَّلامُ خطَبنا عامَ أَوَّلَ، ثمَّ بكَى أبو بكْرٍ فقال: سَلُوا اللهَ ",["المُعافاةَ",1],"، ",["فإنَّ النَّاسَ لمْ يُعطَوْا بعدَ اليَقينِ شيئًا هو أفضَلُ",2]," منَ المُعافاةِ، وفيه: ألَا وعليكم بالصِّدقِ، فإنَّه مع البِرِّ، وهما في الجَنَّةِ، وإيَّاكم والكذِبَ، فإنَّه مع الفُجورِ، وهما في النَّارِ، لا تَدابَروا، ولا تَقاطَعوا، ولا تَباغَضوا، ولا تَحاسَدوا، وكونوا عبادَ اللهِ إخوانًا، كما أمرَكمُ اللهُ عزَّ وجلَّ."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"إسناده صحيح رجاله ثقات، رجال مسلم غير أوسط البجلي وهو ثقة","takhrij":"أخرجه ابن ماجه (3849)، وأحمد (5) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"DucJHDvQ"},{"id":"س-00670","fp":"68bc7e1b5593","stateId":288,"easy":"إذا سألت ربك العافية والمعافاة في الدنيا والآخرة ← فهو أفضل الدعاء","cause":"سَل ربَّك العافيةَ والمعافاةَ في الدنيا والآخرةِ","result":"أيُّ الدعاءِ أفضلُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[40],"ref":"سنن الترمذي 3512","srcLabel":"البخاري","text":["أن رجلاً جاء إلى النبيِّ _صلى الله عليه وسلم_ فقال : يا رسولَ اللهِ  ",["أيُّ الدعاءِ أفضلُ ",2],"؟ قال : ",["سَل ربَّك العافيةَ والمعافاةَ في الدنيا والآخرةِ",1]," , ثم أتاهُ في اليومِ الثاني ، فقال : يا رسولَ اللهِ  أيُّ الدعاءِ أفضلُ ؟ فقال له مثلَ ذلكَ ، ثم أتاهُ في اليومِ الثالثِ ، فقال له مثلَ ذلكَ ، قال : فإذا أُعْطِيتَ العافيةَ في الدنيا ، وأُعْطِيتَها في الآخرةِ فقد أفلَحتَ."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن غريب من هذا الوجه","takhrij":"أخرجه ابن ماجه (3848)، وأحمد (12291)، والبخاري في ((الأدب المفرد)) (637) باختلاف يسير.","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"aTIWot1r"},{"id":"س-02462","fp":"213e522e59c1","stateId":288,"easy":"إذا سألت الله العافية ← فلم تؤتَ بعد كلمة الإخلاص مثلها","cause":"فاسألوا اللَّهَ العافيةَ","result":"لم تُؤتَوا شيئًا بعدَ كلِمةِ الإخلاصِ مثلَ العافيةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-05424","ref":"تخريج المسند لشاكر 1/26","text":["قالَ سَمِعْتُ أبا بَكْرٍ الصِّدِّيقَ رضيَ اللَّهُ عنهُ على هذا المنبَرِ يقولُ : سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ في هذا اليومِ من عامِ الأوَّلِ ثمَّ استعبَرَ أبو بَكْرٍ وبَكَى ، ثمَّ قالَ : سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ : ",["لم تُؤتَوا شيئًا بعدَ كلِمةِ الإخلاصِ مثلَ العافيةِ",2]," ، ",["فاسألوا اللَّهَ العافيةَ",1]],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10722) بنحوه، وأحمد (10) واللفظ له","bab":"إسلام › فضل الشهادتين","dorar":"sWrPwzl2"},{"id":"س-03553","fp":"8ef793fdd388","stateId":288,"easy":"إذا مسست الركن والمقام ← (فيهما شفاء على رواية)","cause":"ومامسَّهُما من ذوي عاهةٍ ولا سقيمٍ","result":"إلَّا شُفِيَ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح الترغيب 1147","srcLabel":"أحمد","text":["إنَّ الرُّكنَ والمقامَ مِن ياقوتِ الجنَّةِ ، ولولا ما مَسَّهُ مِن خطايا بَني آدمَ لأضاءَ ما بينَ المشرقِ والمغربِ ، ",["ومامسَّهُما من ذوي عاهةٍ ولا سقيمٍ",1]," ",["إلَّا شُفِيَ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"حسن صحيح","takhrij":"أخرجه أحمد (7000)، وابن خزيمة (2732) مختصراً باختلاف يسير، والبيهقي (9496) باختلاف يسير","bab":"استغفار › مكفرات الذنوب","dorar":"6ojabxZW"},{"id":"س-03719","fp":"ce5e47262f65","stateId":289,"easy":"إذا تنفست في الشراب ثلاثاً ← فهو أروى وأمرأ وأبرأ","cause":"يَتنفَّسُ في الشرابِ ثلاثَ مرَّاتٍ","result":"إنَّه أَرْوى، وأَمْرأُ، وأَبْرأُ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 13635","srcLabel":"متفق عليه","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["يَتنفَّسُ في الشرابِ ثلاثَ مرَّاتٍ",1],"، ويقولُ: ",["إنَّه أَرْوى، وأَمْرأُ، وأَبْرأُ",2],". قال أنسٌ: وأنا أَتنفَّسُ في الشرابِ ثلاثًا."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (3727)، والترمذي (1884) باختلاف يسير، وأخرجه البخاري (5631)، ومسلم (2028) مختصراً","bab":"اعتصام بالسنة › لزوم السنة","dorar":"czYip3sm","merged":5,"otherRefs":["المستدرك على الصحيحين 7409 (صحيح)","شرح السنة 6/131 (صحيح)","صحيح أبي داود 3727 (صحيح)","صحيح الجامع 4744 (صحيح)"]},{"id":"س-01583","fp":"49e47c92a577","stateId":289,"easy":"إذا وقع الذباب في إنائك فاغمسه ثم انزعه ← ففي أحد جناحيه داء وفي الآخر شفاء","cause":"إذا وقَع الذُّبابُ في إناءِ أحَدِكم، فامْقُلوه، ثمَّ انْقُلوه","result":"فإنَّ في أحَدِ جَناحيه داءً، وفي الآخَرِ شِفاءً، وإنَّه يتَّقي بجَناحِه الَّذي فيه الدَّاءُ؛ فلْيغمِسْه كلَّه","explicit":true,"star":true,"similar":["س-01584","س-01582"],"ref":"هداية الرواة 4/133","srcLabel":"البخاري","text":[["إذا وقَع الذُّبابُ في إناءِ أحَدِكم، فامْقُلوه، ثمَّ انْقُلوه؛ ",1],["فإنَّ في أحَدِ جَناحيه داءً، وفي الآخَرِ شِفاءً، وإنَّه يتَّقي بجَناحِه الَّذي فيه الدَّاءُ؛ فلْيغمِسْه كلَّه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أصله في البخاري","takhrij":"أخرجه أبو داود (3844)، وأحمد (7141) باختلاف يسير.","bab":"أشربة › ما يحل من الأشربة","dorar":"forcCABZ","merged":3,"otherRefs":["صحيح الجامع 835 (صحيح)","تخريج المسند لشاكر 12/124 (صحيح)"]},{"id":"س-01584","fp":"91bdcb43a5b9","stateId":289,"easy":"إذا وقع الذباب في إنائك فاغمسه كله ثم اطرحه ← ففي أحد جناحيه شفاء","cause":"إذا وَقَعَ الذُّبابُ في إناءِ أحَدِكم فلْيَغمِسْه كلَّه ثُمَّ ليَطرَحْه","result":"فإنَّ في إحْدى جَناحيه شِفاءً، وفي الآخَرِ داءً","explicit":true,"repOf":"س-01583","ref":"الأحكام الوسطى 4/ 160","text":["[\"",["إذا وَقَعَ الذُّبابُ في إناءِ أحَدِكم فلْيَغمِسْه كلَّه ثُمَّ ليَطرَحْه؛ ",1],["فإنَّ في إحْدى جَناحيه شِفاءً، وفي الآخَرِ داءً\"",2],"]. \n وزادَ في رِوايةٍ: \"وإنَّه يَتَّقي بجَناحِه الَّذي فيه الداءُ\"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه البخاري (5782)، وأحمد (9168)، والبغوي في ((شرح السنة)) (2813) بلفظه.","bab":"أشربة › ما يحل من الأشربة","dorar":"f8EJwunw"},{"id":"س-07505","fp":"a30d0f904ab3","stateId":289,"easy":"إذا سقط الذباب في شرابك فاغمسه كله ثم انزعه ← ففي أحد جناحيه داء وفي الآخر شفاء","cause":"إذا سقَطَ الذُّبابُ في شَرابِ أحدِكُمْ، فَلْيغمِسْهُ كلَّهُ، ثُمَّ لْيَنْزِعْهُ","result":"فإنَّ في أحَدِ جَناحَيْهِ داءً، وفي الآخَرِ شِفاءً","explicit":true,"star":true,"ref":"تخريج شرح السنة 2814","srcLabel":"البخاري","text":[["إذا سقَطَ الذُّبابُ في شَرابِ أحدِكُمْ، فَلْيغمِسْهُ كلَّهُ، ثُمَّ لْيَنْزِعْهُ؛ ",1],["فإنَّ في أحَدِ جَناحَيْهِ داءً، وفي الآخَرِ شِفاءً",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الدارمي (2081) بلفظه، والبخاري (5782)، وأبو داود (3844)، وابن ماجه (3505) جميعا بلفظ مقارب.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"7avWt0A3"},{"id":"س-03630","fp":"7b8e4269ee73","stateId":289,"easy":"إذا أكلت لقيمات يقمن صلبك (ثلث لطعامك وثلث لشرابك وثلث لنفسك) ← فلا شر من بطن ممتلئ","cause":"بحَسْبِ ابنِ آدَمَ لُقَيْماتٌ يُقِمْنَ صُلْبَه، فإنْ كان لا بُدَّ فاعِلًا، فثُلثٌ لِطَعامِه، وثُلثٌ لِشَرابِه، وثُلثٌ لِنَفَسِه","result":"ما مَلَأَ آدمِيٌّ وِعاءً شَرًّا مِن بطْنٍ","explicit":true,"star":true,"otherNeedIds":[49],"ref":"تخريج زاد المعاد 4/16","srcLabel":"السنة","text":[["ما مَلَأَ آدمِيٌّ وِعاءً شَرًّا مِن بطْنٍ",2],"، ",["بحَسْبِ ابنِ آدَمَ لُقَيْماتٌ يُقِمْنَ صُلْبَه، فإنْ كان لا بُدَّ فاعِلًا، فثُلثٌ لِطَعامِه، وثُلثٌ لِشَرابِه، وثُلثٌ لِنَفَسِه",1],"."],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"EZ5dVM6g","merged":5,"otherRefs":["تخريج صحيح ابن حبان 5236 (صحيح)","تخريج سير أعلام النبلاء 8/326 (صحيح)","صحيح ابن ماجه 2720 (صحيح)","تخريج صحيح ابن حبان 674 (صحيح)"]},{"id":"س-03697","fp":"92fcaed4ae0d","stateId":289,"easy":"إذا وقع الذباب في الطعام فاغمسه ← فإنه يقدّم السم ويؤخر الشفاء","cause":"فإذا وقَعَ في الطَّعامِ فامْقُلوهُ","result":"فإنَّه يُقدِّمُ السُّمَّ ويُؤخِّرُ الشِّفاءَ","explicit":true,"ref":"تخريج المسند لشعيب 11643","srcLabel":"ابن ماجه","text":["دَخَلتُ على أبي سَلَمةَ، فأَتانا بزُبْدٍ وكُتْلةٍ، فأُسقِطَ ذُبابٌ في الطَّعامِ، فجعَلَ أبو سَلَمةَ يَمْقُلُه بإِصبَعِه فيه، فقُلتُ: يا خالُ، ما تَصنَعُ؟ فقال: إنَّ أبا سَعيدٍ الخُدْريَّ حدَّثَني عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم قال: إنَّ أحَدَ جَناحَيِ الذُّبابِ سُمٌّ، والآخَرَ شِفاءٌ، ",["فإذا وقَعَ في الطَّعامِ فامْقُلوهُ",1],"؛ ",["فإنَّه يُقدِّمُ السُّمَّ ويُؤخِّرُ الشِّفاءَ",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (3504)، وأحمد (11643) واللفظ له","bab":"اعتصام بالسنة › لزوم السنة","dorar":"kaU25biI","merged":3,"otherRefs":["مجموع الشروح الفقهية. 55/24 (صحيح)","صحيح الجامع 4234 (صحيح)"]},{"id":"س-00212","fp":"c65c8200750b","stateId":289,"easy":"إذا سقط الذباب في طعامك فاغمسه ← ففي أحد جناحيه داء وفي الآخر شفاء","cause":"إذا سقَطَ الذُّبابُ في الطعامِ، فامْقُلوهُ","result":"فإنَّ في أحَدِ جَناحَيْه سُمًّا، وفي الآخَرِ شِفاءً، وإنَّه يُقدِّمُ السُّمَّ، ويُؤخِّرُ الشِّفاءَ","explicit":true,"ref":"تخريج مشكل الآثار 3289","srcLabel":"الطحاوي","text":["عن سعيد بن خالد القارظي قال: أتَيْتُ أبا سَلَمةَ بنَ عبدِ الرحمنِ أزورُهُ بقُباءٍ، فقدَّمَ إلينا زُبدًا وكُتلةً، فسقَطَ في الزُّبدِ ذُبابٌ، فجَعَل أبو سَلَمةَ يَمقُلُه بخِنصَرِه، فقُلتُ: غفَرَ اللهُ لكَ يا خالُ ما تَصنَعُ؟ فقال: إنِّي سمِعْتُ أبا سعيدٍ الخُدْريَّ يقولُ: قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["إذا سقَطَ الذُّبابُ في الطعامِ، فامْقُلوهُ؛ ",1],["فإنَّ في أحَدِ جَناحَيْه سُمًّا، وفي الآخَرِ شِفاءً، وإنَّه يُقدِّمُ السُّمَّ، ويُؤخِّرُ الشِّفاءَ",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (3289)، وعبد بن حميد (882) واللفظ لهما، وابن ماجة (3504) بنحوه.","bab":"آداب المجلس › إكرام الضيف","dorar":"kSQSY30m"},{"id":"س-00276","fp":"3631038aacf5","stateId":289,"easy":"إذا أكلت طعام السخي ← فهو شفاء","cause":"وطَعامُ السَّخِيِّ","result":"شِفاءٌ","explicit":true,"similar":["س-00455"],"ref":"الأحكام الوسطى 4/ 146","srcLabel":"السنة","text":["طَعامُ البَخيلِ داءٌ، ",["وطَعامُ السَّخِيِّ",1]," ",["شِفاءٌ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"S4rnQbbf"},{"id":"س-01582","fp":"3bd3d04414e4","stateId":289,"easy":"إذا وقع الذباب في إنائك فاغمسه ← ففي أحد جناحيه سم وفي الآخر شفاء","cause":"إذا وقع الذبابُ في إناءِ أحدِكم فَلْيَمْقُلْهُ فيه","result":"فإنَّ في أحدِ جناحيْه سُمٌّ ، و في الآخرِ شفاءٌ ؛ و إنَّه يُقدِّمُ السمَّ ، و يُؤخِّرُ الشفاءُ","explicit":true,"repOf":"س-01583","ref":"صحيح الجامع 836","text":[["إذا وقع الذبابُ في إناءِ أحدِكم فَلْيَمْقُلْهُ فيه ؛ ",1],["فإنَّ في أحدِ جناحيْه سُمٌّ ، و في الآخرِ شفاءٌ ؛ و إنَّه يُقدِّمُ السمَّ ، و يُؤخِّرُ الشفاءُ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه النسائي (4262) أوله، وأحمد (11661) باختلاف يسير.","bab":"أشربة › ما يحل من الأشربة","dorar":"HZNpDP4R"},{"id":"س-01642","fp":"4b76c57e0274","stateId":289,"easy":"إذا نهشت اللحم نهشاً ← فهو أشهى وأهنأ وأمرأ","cause":"انْهَشُوا اللحْمَ نَهْشًا","result":"فإِنَّه أشْهَى ، و أهْنأُ ، و أمْرَأُ","explicit":true,"otherNeedIds":[7],"ref":"الجامع الصغير 2742","srcLabel":"أبو داود","text":[["انْهَشُوا اللحْمَ نَهْشًا",1]," ، ",["فإِنَّه أشْهَى ، و أهْنأُ ، و أمْرَأُ",2],"."],"grade":"صحيح","narrator":"صفوان بن أمية","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1835)، وأحمد (27634) كلاهما باختلاف يسير، وأبو داود (3779) بنحوه.","bab":"أطعمة › ما يحل من الأطعمة","dorar":"PxVj0nGg"},{"id":"س-01652","fp":"ac397f776749","stateId":289,"easy":"إذا قرّبت اللحم من فيك ← فهو أهنأ وأمرأ","cause":"قرِّبِ اللَّحْمَ مِن فِيكَ","result":"فإنَّه أهْنَأُ وأمْرَأُ","explicit":true,"ref":"المستدرك على الصحيحين 7299","srcLabel":"أبو داود","text":["رآني رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ وأنا آخُذُ اللَّحْمَ مِنَ العَظْمِ بيَدِي، فقالَ لي: يا صَفْوانُ، قلْتُ: لَبَّيكَ، قالَ: ",["قرِّبِ اللَّحْمَ مِن فِيكَ؛ ",1],["فإنَّه أهْنَأُ وأمْرَأُ",2],"."],"grade":"صحيح","narrator":"صفوان بن أمية","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داود (3779)، والترمذي (1835) بنحوه.","bab":"أطعمة › ما يحل من الأطعمة","dorar":"ElfKqqUL"},{"id":"س-01657","fp":"7990e86138a5","stateId":289,"easy":"إذا نهست اللحم ← فهو أهنأ وأمرأ","cause":"انهَسوا اللَّحمَ نهسًا","result":"فإنَّه أهنأُ وأمرَأُ","explicit":true,"otherNeedIds":[7],"ref":"الترغيب والترهيب 3/163","srcLabel":"أبو داود","text":[["انهَسوا اللَّحمَ نهسًا",1]," ",["فإنَّه أهنأُ وأمرَأُ",2]],"grade":"صحيح","narrator":"صفوان بن أمية","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (3779) بنحوه، والترمذي (1835) واللفظ له، وأحمد (15335)","bab":"أطعمة › ما يحل من الأطعمة","dorar":"5CK0yauP"},{"id":"س-05678","fp":"180a829c4983","stateId":289,"easy":"إذا مرض أحد أهلك فلا تكرهه على الطعام والشراب ← فالله يطعمه ويسقيه","cause":"لا تُكْرِهوا مَرْضاكم على الطَّعامِ والشَّرابِ","result":"فإنَّ اللهَ عزَّ وجَلَّ يُطعِمُهم ويَسْقِيهم","explicit":true,"ref":"التعليقات البازية على زاد المعاد 563","srcLabel":"الترمذي","text":[["لا تُكْرِهوا مَرْضاكم على الطَّعامِ والشَّرابِ؛ ",1],["فإنَّ اللهَ عزَّ وجَلَّ يُطعِمُهم ويَسْقِيهم",2],"."],"grade":"صحيح","narrator":"عقبة بن عامر الجهني","muhaddith":"المعنى صحيح، وطرقه يشد بعضها بعضًا","takhrij":"أخرجه الترمذي (2040)، وابن ماجه (3444)، والحاكم (1296) بلفظه.","bab":"رقائق وزهد › الصبر على البلاء","dorar":"wV3ZgoxQ"},{"id":"س-07485","fp":"7c867f7efa29","stateId":289,"easy":"إذا وقع الذباب في الإناء فاغمسه ← يذهب شفاؤه بدائه","cause":"فإذا وقع فِي الإِناءِ فأرْسِبوهُ","result":"فيذهبُ شفاؤُهُ بدائِهِ","explicit":true,"ref":"صحيح الجامع 4249","srcLabel":"السنة","text":["في الذُّبابِ أحدُ جناحَيْهِ داءٌ وفِي الآخِرِ شفاءٌ ، ",["فإذا وقع فِي الإِناءِ فأرْسِبوهُ",1]," ، ",["فيذهبُ شفاؤُهُ بدائِهِ",2]],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح","takhrij":"لم نقف عليه إلا في ((صحيح الجامع)) (4249) .","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"VB7m3vPX"},{"id":"س-05820","fp":"fa1437e7e5b0","stateId":289,"easy":"إذا أدنيت العظم من فيك ← فهو أهنأ وأمرأ","cause":"أدْنِ العَظمَ مِن فيكَ","result":"فإنَّه أهنَأُ وأمرَأُ","explicit":true,"otherNeedIds":[7],"ref":"تخريج سنن أبي داود 3779","srcLabel":"أحمد","text":["قال: كُنتُ آكُلُ مع النَّبيِّ صلَّى اللَّهُ عليه وسلَّمَ منه فآخُذُ اللَّحمَ مِنَ العَظمِ، فقال: ",["أدْنِ العَظمَ مِن فيكَ",1],"؛ ",["فإنَّه أهنَأُ وأمرَأُ",2],"."],"grade":"حسن","narrator":"صفوان بن أمية","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (15309)، والطبراني (8/57) (7333)، والحاكم (7103) باختلاف يسير","bab":"رقائق وزهد › الوصايا النافعة","dorar":"I8dYCGaS","merged":2,"otherRefs":["هداية الرواة 4/156 (حسن)"]},{"id":"س-00455","fp":"29ee35d19a15","stateId":289,"easy":"إذا أكلت طعام السخي ← فهو دواء","cause":"طعامُ السَّخيِّ","result":"دواءٌ","explicit":true,"repOf":"س-00276","ref":"فيض القدير 4/ 264","text":[["طعامُ السَّخيِّ ",1],["دواءٌ",2],"، وطعامُ الشَّحيحِ داءٌ"],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"[رجاله] مشاهير ثقات إلَّا مقدام بن داود؛ فإنَّ أهل مصر تكلموا فيه","takhrij":"أخرجه الخطيب في ((البخلاء)) (ص50) واللفظ له، والديلمي في ((الغرائب الملتقطة)) ((597/5)) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"paoWC0p7"}]}