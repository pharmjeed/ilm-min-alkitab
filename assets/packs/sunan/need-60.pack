{"schema":1,"kind":"sunan-chunk","version":"sunan-3f5fd6b9930a","needId":60,"stateIds":[627,628,629,630],"items":[{"id":"س-05210","fp":"13c8121a1f6a","stateId":627,"easy":"إذا انشغل أهل البيت بالحرث وتركوا الجهاد ← يذلون","cause":"ما من أهلِ بيتٍ يغدو عليهم فَدَّانٌ","result":"إلا ذُلُّوا","explicit":true,"star":true,"ref":"صحيح الجامع 5698","srcLabel":"البخاري","text":[["ما من أهلِ بيتٍ يغدو عليهم فَدَّانٌ",1]," ",["إلا ذُلُّوا",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه البخاري (2321) بنحوه، والطبراني (8/352) (8123) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"h4KxYNt6"},{"id":"س-07472","fp":"7eb74400f7ec","stateId":627,"easy":"إذا دخلت آلة الحرث بيت قوم (وتركوا الجهاد) ← يدخلهم الله الذل","cause":"ما دخَلتْ هذه بيتَ قومٍ","result":"إلَّا أدخَلهُ اللهُ الذُّلَّ","explicit":true,"star":true,"ref":"تخريج مشكل الآثار 230","srcLabel":"البخاري","text":["سمِعْتُ أبا أُمامةَ، ورَأى سِكَّةً وشيئًا مِن آلةِ الحَرثِ، فقال: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["ما دخَلتْ هذه بيتَ قومٍ",1]," ",["إلَّا أدخَلهُ اللهُ الذُّلَّ",2],"."],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (230) واللفظ له، والبخاري (2321)، والطبراني في (( المعجم الأوسط))  (8921) كلاهما باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"um9O5UKu"},{"id":"س-07400","fp":"6046ca7b3aa3","stateId":627,"easy":"إذا أحببتم الدنيا وكرهتم الموت ← تتداعى عليكم الأمم","cause":"حبُّ الدُّنيا وكراهيةُ الموتِ","result":"يُوشِكُ الأممُ أن تَداعَى عليكم ، كما تَداعَى الأكَلةُ إلى قصْعتِها","explicit":true,"otherNeedIds":[61],"ref":"السلسلة الصحيحة 958","srcLabel":"أبو داود","text":[["يُوشِكُ الأممُ أن تَداعَى عليكم ، كما تَداعَى الأكَلةُ إلى قصْعتِها",2]," ، فقال قائلٌ : ومن قِلَّةٍ نحن يومئذٍ ؟ قال : بل أنتم يومئذٍ كثيرٌ ، ولكنَّكم غُثاءٌ كغُثاءُ السَّيلِ ، ولينزِعَنَّ اللهُ من صدورِ عدوِّكم المهابةَ منكم ، وليقذِفَنَّ اللهُ في قلوبِكم الوهْنَ ، فقال قائلٌ : يا رسولَ اللهِ وما الوهْنُ ؟ قال ",["حبُّ الدُّنيا وكراهيةُ الموتِ",1]],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرجه أبو داود (4297) واللفز له، وأحمد (22397)، والطبراني في ((مسند الشاميين)) (600) بلفظ مقارب","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"uWXnUOWy","merged":5,"otherRefs":["صحيح الجامع 8183 (صحيح)","مجموع فتاوى ابن باز 106/5 (حسن)","تخريج المسند لشعيب 22397 (حسن)","مجمع الزوائد 7/290 (حسن)"]},{"id":"س-04453","fp":"e8038ac87b2f","stateId":627,"easy":"إذا تبايعتم بالعينة واتبعتم البقر وتركتم الجهاد ← ينزل الله بكم بلاءً حتى تراجعوا دينكم","cause":"إذا النَّاسُ تبايعوا بالعِينِ واتَّبعوا أذنابَ البقرِ وتركوا الجهادَ في سبيلِ اللهِ","result":"أنزل اللهُ بهم بلاءً فلم يرفعْه عنهم حتى يُراجِعوا دينَهم","explicit":true,"similar":["س-08068"],"otherNeedIds":[61],"ref":"الإلمام بأحاديث الأحكام 2/499","srcLabel":"أبو داود","text":["عن ابنِ عمرَ رضيَ اللهُ عنهُما قال : أتى علينا زمانٌ وما يرى أحدٌ منَّا أنه أحقُّ بالدينارِ والدرهمِ من أخيه المسلمِ . ثم قال : سمعتُ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يقول : ",["إذا النَّاسُ تبايعوا بالعِينِ واتَّبعوا أذنابَ البقرِ وتركوا الجهادَ في سبيلِ اللهِ",1]," ",["أنزل اللهُ بهم بلاءً فلم يرفعْه عنهم حتى يُراجِعوا دينَهم",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[اشترط في المقدمة أنه] صحيح على طريقة بعض أهل الحديث","takhrij":"أخرجه أبو داود (3462)، وأحمد (4825) باختلاف يسير دون الزيادة في أوله، والطبراني (12/432) (13583) باختلاف يسير","bab":"جهاد › فضل الجهاد","dorar":"141NFEnX","merged":2,"otherRefs":["أعلام الموقعين 3/143 (صحيح)"]},{"id":"س-05578","fp":"d310b5a1e974","stateId":627,"easy":"إذا فُتحت الدنيا على قوم ← يلقي الله بينهم العداوة والبغضاء","cause":"لا تُفتَحُ الدُّنيا على أحدٍ","result":"إلَّا ألقى اللَّه عزَّ وجلَّ بينَهُمُ العداوةَ والبَغضاءَ إلى يومِ القيامةِ ، وأَنا أُشفقُ من ذلِكَ","explicit":true,"ref":"تخريج المسند لشاكر 1/62","srcLabel":"المعافى","text":["عن أبي سنانٍ الدُّؤليِّ أنَّهُ دخَلَ على عُمَرَ بنِ الخطَّابِ رضيَ اللَّهُ عنهُ وعندَهُ نَفرٌ منَ المُهاجرينَ الأوَّلينَ ، فأرسلَ عُمرُ إلي سَفطٍ أتى بِهِ من قلعةٍ منَ العراقِ ، فَكانَ فيهِ خاتمٌ ، فأخذَهُ بعضُ بَنيهِ فأدخلَهُ في فيهِ فانتزعَهُ عُمرُ منهُ ثمَّ بَكَى عمرُ رضيَ اللَّهُ عنهُ ، فقالَ لَهُ مَن عندَهُ : لِمَ تَبكي وقد فتحَ اللَّهُ لَكَ ، وأظهرَكَ على عدوِّكَ ، وأقرَّ عينَكَ ؟ فقالَ عُمرُ رضيَ اللَّهُ عنهُ إنِّي سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ : ",["لا تُفتَحُ الدُّنيا على أحدٍ",1]," ",["إلَّا ألقى اللَّه عزَّ وجلَّ بينَهُمُ العداوةَ والبَغضاءَ إلى يومِ القيامةِ ، وأَنا أُشفقُ من ذلِكَ",2]],"grade":"صحيح","narrator":"عمر بن الخطاب.","muhaddith":"إسناده صحيح","takhrij":"أخرجه المعافى بن عمران في ((الزهد)) (8) واللفظ له، وعبد بن حميد (44)، وابن أبي عاصم في ((الزهد)) (276) بلفظه مختصرًا.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"FLWh425D"},{"id":"س-08058","fp":"8036ba3a20c3","stateId":627,"easy":"إذا تبايعتم بالعينة ورضيتم بالزرع وتركتم الجهاد ← يسلط الله عليكم ذلاً حتى ترجعوا إلى دينكم","cause":"إذا تبايعتُم بالعِينةِ ، وأخَذتُم أذنابَ البقرِ ، ورضيتُم بالزَّرعِ ، وتركتُمُ الجهادَ","result":"سلَّطَ اللهُ عليكُم ذُلًّا لا ينزِعُه حتَّى ترجِعوا إلى دِينِكُمْ","explicit":true,"ref":"صحيح الترغيب 1389","srcLabel":"أبو داود","text":[["إذا تبايعتُم بالعِينةِ ، وأخَذتُم أذنابَ البقرِ ، ورضيتُم بالزَّرعِ ، وتركتُمُ الجهادَ ؛ ",1],["سلَّطَ اللهُ عليكُم ذُلًّا لا ينزِعُه حتَّى ترجِعوا إلى دِينِكُمْ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (3462)، والبزار (5887)، والطبراني في ((مسند الشاميين)) (2417)","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"Ld4nH0d8"},{"id":"س-08252","fp":"d073a00101b8","stateId":627,"easy":"إذا ترك القوم الجهاد ← يضربهم الله بالذل","cause":"لا يدعُ قومٌ الجهادَ في سبيل اللهِ","result":"إلا ضربَهم اللهُ بالذُّلِّ","explicit":true,"ref":"البداية والنهاية 5/218","srcLabel":"محمد","text":["عن أنسِ بنِ مالكٍ قال لما بُويعَ أبو بكرٍ في السَّقيفةِ وكان الغدُ جلس أبو بكرٍ على المنبرِ وقام عمرُ فتكلَّم قبل أبي بكرٍ فحمد اللهَ وأثنى عليه بما هو أهلُه ثم قال أيها الناسُ إني قد كنتُ قلتُ لكم بالأمسِ مقالةً ما كانت وما وجدتُها في كتاب اللهِ ولا كانت عهدًا عهِدها إليَّ رسولُ اللهِ ولكني كنتُ أرى أنَّ رسولَ اللهِ سيُدبِرُ أمرَنا يقول يكون آخرَنا واللهِ قد أبقى فيكم كتابَه الذي هدى به رسولَ اللهِ فإن اعتصمتُم به هداكم اللهُ لما كان هداه اللهُ له وأنَّ اللهَ قد جمع أمرَكم على خيرِكم صاحبِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وثاني اثنين إذ هما في الغار فقوموا فبايِعوه فبايع الناسُ أبا بكرٍ بيعةَ العامةِ بعد بيعةِ السَّقيفةِ ثم تكلم أبو بكرٍ فحمد اللهَ وأثنى عليه بما هو أهلُه ثم قال أما بعد أيها الناسُ فإني قد وُلِّيتُ عليكم ولستُ بخيرِكم فإن أحسنتُ فأَعِينوني وإن أسأتُ فقوِّموني الصدقُ أمانةٌ والكذبُ خيانةٌ والضعيفُ منكم قويٌّ عندي حتى أزيحَ عِلَّتَه إن شاء اللهُ والقويُّ فيكم ضعيفٌ حتى آخذَ منه الحقَّ إن شاء اللهُ ",["لا يدعُ قومٌ الجهادَ في سبيل اللهِ",1]," ",["إلا ضربَهم اللهُ بالذُّلِّ",2]," ولا يشيعُ قومٌ قطُّ الفاحشةَ إلا عمَّهم اللهُ بالبلاء أَطيعوني ما أَطعتُ اللهَ ورسولَه فإذا عصيتُ اللهَ ورسولَه فلا طاعةَ لي عليكم قوموا إلى صلاتِكم يرحمْكم اللهُ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح","takhrij":"أخرجه محمد بن إسحاق كما في ((السيرة)) لابن هشام (6/ 82)، والطبري في ((التاريخ)) (3/ 210) كلاهما بلفظه.","bab":"مناقب وفضائل › أبو بكر الصديق","dorar":"Fk8YWRPX"},{"id":"س-08068","fp":"560806bd662e","stateId":627,"easy":"إذا تبايعتم بالعينة وتركتم الجهاد ← يرسل الله عليكم ذلاً حتى تراجعوا دينكم","cause":"إذا تبايَعْتُم بالعِينةِ واتَّبعْتُم أذنابَ البقَرِ وتركْتُم الجِهادَ في سَبيلِ اللهِ","result":"أرسل اللهُ عليكم ذُلًّا لا يرفَعُه عنكم حتَّى تراجِعوا دينَكم","explicit":true,"repOf":"س-04453","otherNeedIds":[52],"ref":"الفتاوى الكبرى 4/21","text":[["إذا تبايَعْتُم بالعِينةِ واتَّبعْتُم أذنابَ البقَرِ وتركْتُم الجِهادَ في سَبيلِ اللهِ، ",1],["أرسل اللهُ عليكم ذُلًّا لا يرفَعُه عنكم حتَّى تراجِعوا دينَكم",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"[إسناده جيد]","takhrij":"أخرجه أبو داود (3462)، والبزار (5887)، والدولابي في ((الكنى والأسماء)) (1489) واللفظ لهم.","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"7Neg1Kt5"},{"id":"س-03779","fp":"447a36bd0ddf","stateId":627,"easy":"إذا بخل الناس وانشغلوا بالزرع وتركوا الجهاد ← يسلط الله عليهم ذلاً حتى يراجعوا دينهم","cause":"إذا ضَنَّ النَّاسُ بالدِّينارِ والدِّرْهَمِ، واتَّبَعوا أذْنابَ البَقَرِ، وتَرَكوا الجِهادَ","result":"سَلَّطَ اللهُ عليهم ذُلًّا لا يَنزِعُه مِنهم حتَّى يُراجِعوا أمْرَهم","explicit":true,"star":true,"ref":"الأحاديث المختارة 13 / 176","srcLabel":"متفق عليه","text":["عن ابنِ عُمَرَ، قالَ: «لقد رَأيْتُنا وما يَرى أحَدُنا أنَّه أَحَقُّ بدينارِه ودِرْهمِه مِن أخيه المُسلِمِ، فإذا الدِّينارُ والدِّرْهَمُ أَحَبُّ إلى أحَدِنا مِن أخيه المُسلِمِ، فلقد سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["إذا ضَنَّ النَّاسُ بالدِّينارِ والدِّرْهَمِ، واتَّبَعوا أذْنابَ البَقَرِ، وتَرَكوا الجِهادَ: ",1],["سَلَّطَ اللهُ عليهم ذُلًّا لا يَنزِعُه مِنهم حتَّى يُراجِعوا أمْرَهم»",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"الولاء والبراء › موالاة المسلمين","dorar":"WOWa7VrJ","merged":2,"otherRefs":["مسند عمر 1/108 (صحيح)"]},{"id":"ق-0150","fp":"b264f5c678a5","stateId":628,"easy":"التفرق والاختلاف بعد مجيء البينات ← عذاب عظيم","cause":"التفرق والاختلاف بعد مجيء البينات","result":"عذاب عظيم","explicit":true,"otherNeedIds":[69],"ref":"سورة آل عمران: 105","srcLabel":"القرآن الكريم","quran":{"s":3,"from":105,"to":105,"text":"وَلَا تَكُونُوا كَالَّذِينَ تَفَرَّقُوا وَاخْتَلَفُوا مِنْ بَعْدِ مَا جَاءَهُمُ الْبَيِّنَاتُ وَأُولَئِكَ لَهُمْ عَذَابٌ عَظِيمٌ (105)","hl":[[0,128,1]]}},{"id":"ق-0175","fp":"08b38cbb2bbe","stateId":628,"easy":"الفشل والتنازع والمعصية وإرادة الدنيا ← صرف النصر والابتلاء بالهزيمة","cause":"الفشل والتنازع والمعصية وإرادة الدنيا","result":"صرف النصر والابتلاء بالهزيمة","explicit":true,"ref":"سورة آل عمران: 152","srcLabel":"القرآن الكريم","quran":{"s":3,"from":152,"to":152,"text":"وَلَقَدْ صَدَقَكُمُ اللَّهُ وَعْدَهُ إِذْ تَحُسُّونَهُمْ بِإِذْنِهِ حَتَّى إِذَا فَشِلْتُمْ وَتَنَازَعْتُمْ فِي الْأَمْرِ وَعَصَيْتُمْ مِنْ بَعْدِ مَا أَرَاكُمْ مَا تُحِبُّونَ مِنْكُمْ مَنْ يُرِيدُ الدُّنْيَا وَمِنْكُمْ مَنْ يُرِيدُ الْآخِرَةَ ثُمَّ صَرَفَكُمْ عَنْهُمْ لِيَبْتَلِيَكُمْ وَلَقَدْ عَفَا عَنْكُمْ وَاللَّهُ ذُو فَضْلٍ عَلَى الْمُؤْمِنِينَ (152)","hl":[[68,286,1]]}},{"id":"ق-0466","fp":"6920d3e45822","stateId":628,"easy":"التنازع ← الفشل وذهاب الريح (القوة)","cause":"التنازع","result":"الفشل وذهاب الريح (القوة)","explicit":true,"ref":"سورة الأنفال: 46","srcLabel":"القرآن الكريم","quran":{"s":8,"from":46,"to":46,"text":"وَأَطِيعُوا اللَّهَ وَرَسُولَهُ وَلَا تَنَازَعُوا فَتَفْشَلُوا وَتَذْهَبَ رِيحُكُمْ وَاصْبِرُوا إِنَّ اللَّهَ مَعَ الصَّابِرِينَ (46)","hl":[[32,83,1]]}},{"id":"ق-0479","fp":"94195cc5eb2d","stateId":628,"easy":"ترك موالاة المؤمنين بعضهم بعضاً ← فتنة في الأرض وفساد كبير","cause":"ترك موالاة المؤمنين بعضهم بعضاً","result":"فتنة في الأرض وفساد كبير","explicit":true,"otherNeedIds":[61],"ref":"سورة الأنفال: 73","srcLabel":"القرآن الكريم","quran":{"s":8,"from":73,"to":73,"text":"وَالَّذِينَ كَفَرُوا بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ إِلَّا تَفْعَلُوهُ تَكُنْ فِتْنَةٌ فِي الْأَرْضِ وَفَسَادٌ كَبِيرٌ (73)","hl":[[51,117,1]]}},{"id":"ق-1320","fp":"a1ccc2683094","stateId":628,"easy":"ضعف الإيمان وقلة الفقه والعقل ← الرهبة من الناس وتشتت القلوب وشدة البأس بينهم","cause":"ضعف الإيمان وقلة الفقه والعقل","result":"الرهبة من الناس وتشتت القلوب وشدة البأس بينهم","explicit":true,"ref":"سورة الحشر: 13–14","srcLabel":"القرآن الكريم","quran":{"s":59,"from":13,"to":14,"text":"لَأَنْتُمْ أَشَدُّ رَهْبَةً فِي صُدُورِهِمْ مِنَ اللَّهِ ذَلِكَ بِأَنَّهُمْ قَوْمٌ لَا يَفْقَهُونَ (13) لَا يُقَاتِلُونَكُمْ جَمِيعًا إِلَّا فِي قُرًى مُحَصَّنَةٍ أَوْ مِنْ وَرَاءِ جُدُرٍ بَأْسُهُمْ بَيْنَهُمْ شَدِيدٌ تَحْسَبُهُمْ جَمِيعًا وَقُلُوبُهُمْ شَتَّى ذَلِكَ بِأَنَّهُمْ قَوْمٌ لَا يَعْقِلُونَ (14)","hl":[[0,302,1]]}},{"id":"س-01744","fp":"1d972d5956eb","stateId":628,"easy":"إذا اختلف القوم ← هلكوا","cause":"لم يختلف قومٌ قطُّ","result":"إلا هَلكوا","explicit":true,"otherNeedIds":[61],"ref":"تغليق التعليق 4/244","srcLabel":"الواحدي","text":["عن ابنِ عباسٍ, قال : غزونا مع معاويةَ غزوةَ المصيفِ, فمَرُّوا بالكهفِ الذي فيهِ أصحابُ الكهفِ, الذين ذكر اللهُ في القرآنِ, فقال معاويةُ : لو كُشِفَ لنا عن هؤلاءِ, فنظرنا إليهم, فقال ابنُ عباسٍ : ليس ذلك لك قد منع اللهُ ذلك من هو خيرٌ منك, فقال : { لَوْ اطَّلَعْتَ عَلَيْهِمْ لَوَلَّيْتَ مِنْهُمْ فِرَارًا وَلَمُلِئْتَ مِنْهُمْ رُعْبًا } قال معاويةُ : لا أنتهي حتى أعلمَ علمهم, قال : فبعث ناسًا, فقال : اذهبوا فانظروا فلمَّا دخلوا الكهفَ, بعث اللهُ عليهم ريحًا, فأخرجتهم, فبلغ ذلك ابنُ عباسٍ, فأنشأَ يُحدِّثهم عنهم, فقال : إنَّهم كانوا في مملكةِ ملكٍ من هذهِ الجبابرةِ, فجعلوا يعبدونَ حتى عبدةَ الأوثانِ, قال : وهؤلاءِ الفتيةُ بالمدينةِ, فلمَّا رأوا ذلك خرجوا من تلك المدينةِ على غيرِ ميعادٍ, فجمعهم اللهُ, عزَّ وجلَّ, على غيرِ ميعادٍ, فجعل بعضهم يقولُ لبعضٍ : أين تريدون ؟ أين تذهبون, قال : فجعل بعضهم يُخفي من بعضٍ, لأنَّهُ لا يدري هذا على ما خرج هذا, فأخذ بعضهم على بعضٍ المواثيقَ أن يُخبرَ بعضهم بعضًا, فإنِ اجتمعوا على شيٍء, وإلا كتم بعضهم على بعضٍ , قال : فاجتمعوا على كلمةٍ واحدةٍ, ?فقالوا رَبُّنَا رَبُّ السَّمَوَاتِ وَالْأَرْضِ لَنْ نَدْعُوَ مِنْ دُونِهِ إِلَهًا لَقَدْ قُلْنَا إِذًا شَطَطًا هَؤُلاءِ قَوْمُنَا اتَّخَذُوْا مِنْ دُونِهِ آلِهَةً لَوْلَا يَأْتُونَ عَلَيْهِمْ بِسُلْطَانٍ بَيِّنٍ, فَمَنْ أَظْلَمُ مِمَّنِ افْتَرَى عَلَى اللهِ كَذِبًا, وَإِذِ اعْتَزَلْتُمُوهُمْ - إلى قولِهِ –مِنْ أَمْرِكُمْ مِرْفَقًا ? [ 14 - 16 : الكهف ] ,قال : فهذا قولُ الفتيةِ, قال : ففُقدوا فجاء أهلُ هذا يطلبونَهُ لا يدرون أين ذهب, وجاء أهلُ هذا يطلبونَهُ لا يدرون أين ذهب, فطلبهم أهلوهم, لا يدرون أين ذهبوا, فرُفِعَ ذلك إلى الملكِ, فقال : ليكونَنَّ لهؤلاءِ شأنٌ بعد اليومِ, قومٌ خرجوا ولا يُدرى أين توجهوا في غيرِ جنايةٍ, ولا شيٌء يُعرفُ, فدعا بلوحٍ من رصاصٍ, فكتب فيهِ أسماءهم, وطرحَهُ في خزانتِهِ, فذلك قولُ اللهِ تباركَ وتعالى [ 9 : الكهف ] { إِنَّ أَصْحَابَ الْكَهْفِ وَالرَّقِيمِ كَانُوْا مِنْ آيَاتِنَا عَجَبًا } والرقيمُ هو اللوحُ الذي كتبوا, قال : فانطلقوا حتى دخلوا الكهفَ, فضرب اللهُ على آذانهم, فناموا, قال : فقال ابنُ عباسٍ : واللهِ لو أنَّ الشمسَ تطلعُ عليهم لأحرقتهم, ولولا أنَّهم يُقلبونَ, لأكلتهمُ الأرضُ, فذلك قولُ اللهِ تباركَ وتعالى?وَتَرَى الشَّمْسَ إِذَا طَلَعَتْ تَزَاوَرُ عَنْ كَهْفِهِمْ ذَاتَ الْيَمِينِ,وَإِذَا غَرَبَتْ تَقْرِضُهُمْ ذَاتَ الشِّمَالِ وَكَلْبُهُمْ بَاسِطٌ ذِرَاعَيْهِ بِالْوَصِيدِ ?يقولُ : بالفناءِ { وَنُقَلِّبُهُمْ ذَاتَ الْيَمِينِ وَذَاتَ الشِّمَالِ ?ثم إنَّ ذلك الملكَ ذهب وجاء ملكٌ آخرُ, فكسر تلك الأوثانَ وعبدَ اللهَ, وعدلَ في الناسِ, فبعثهم اللهُ لما يريدُ, فقال بعضهم لبعضٍ : { كَمْ لَبِثْتُمْ } قال بعضهم : ?يَوْمًا } وقال بعضهم : ?بَعْضَ يَوْمٍ ?,وقال بعضهم : أكثرُ من ذلك, فقال كبيرهم : لا تختلفوا, فإنَّهُ ",["لم يختلف قومٌ قطُّ",1]," ",["إلا هَلكوا",2],", قال : فقالوا : { فَابْعَثُوْا أَحَدَكُمْ بِوَرِقِكِمْ هَذِهِ إِلَى الْمَدِينَةِ فَلْيَنْظُرْ أَيُّهَا أَزْكَى طَعَامًا فَلْيَأْتِكُمْ بِرِزْقٍ مِنْهُ وَلْيَتَلَطَّفْ } يعني بأزكى : بأطهرَ, إنَّهم كانوا يذبحونَ الخنازيرَ, قال : فجاء إلى المدينةِ, فرأى شارةً أنكرها, وبنيانًا أنكرَهُ, ثم دنا إلى خبازٍ, فرمى إليهِ بدرهمٍ, فأنكرَ الخبازُ الدرهمَ, وكانت دراهمهم كخفافِ الربعِ يعني والربعِ الفصيلَ, قال : فأنكر الخبازُ, وقال : من أين لك هذا الدرهمَ ؟ لقد وجدتَ كنزًا لتَدُلَّني على هذا الكنزِ أو لأرفعنَّكَ إلى الأميرِ, قال : أَتُخَوِّفُنِي بالأميرِ , وإني لدهقانُ الأميرِ فقال : من أبوكَ ؟ قال : فلانٌ, فلم يعرفْهُ, فقال : من الملكُ ؟ فقال : فلانٌ, فلم يعرفْهُ, قال : فاجتمع الناسُ, ورفع إلى عاملهم, فسألَهُ, فأخبرَهُ, فقال : عليَّ باللوحِ, قال : فجيءَ بهِ, فسمَّى أصحابَهُ فلانٌ وفلانٌ, وهم في اللوحِ مكتوبونَ قال : فقال الناسُ : قد دلَّكمُ اللهُ على إخوانكم, قال : فانطلقوا, فركبوا حتى أتوْا الكهفَ, فقال الفتى : مكانكم أنتم, حتى أدخلَ على أصحابي, لا تهجموا عليهم, فيفزعوا منكم, وهم لا يعلمونَ, أنَّ اللهَ قد أقبل بكم, وتاب عليكم, فقالوا : آللهِ لتَخْرُجَنَّ إلينا, قال : إن شاء اللهُ, فلم يَدْرِ أين ذهب, وعميَ عليهم المكانُ قال : فطلبوا وحرصوا, فلم يَقدروا على الدخولِ عليهم, فقالوا : أَكْرِمُوا إخوانكم, قال : فنظروا في أمرهم, فقالوا : ?لَنَتَّخِذَنَّ عَلَيْهِمْ مَسْجِدًا } فجعلوا يُصلُّونَ عليهم, ويستغفرونَ لهم, ويدعون لهم, فذلك قولُ اللهِ تعالى ?فَلَا تُمَارِ فِيهِمْ إِلَّا مِرَاءً ظَاهِرًا وَلَا تَسْتَفْتِ فِيهِمْ مِنْهُمْ أَحَدًا } يعني اليهودَ ?وَلَا تَقُولَنَّ لِشَيٍء إِنِّي فَاعِلٌ ذَلِكَ غَدًا إِلَّا أَنْ يَشَاءَ اللهُ وَاذْكُرْ رَبَّكَ إِذَا نَسِيتَ } [ 22 - 24 : الكهف ] فكان ابنُ عباسٍ, يقولُ : إذا قلتَ شيئًا فلم تقل : إن شاء اللهُ, فقل إذا ذكرتَ إن شاء اللهُ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه الواحدي في ((التفسير الوسيط)) (563)، وابن أبي شيبة كما في ((الدر المنثور)) للسيوطي (5/ 366) باختلاف يسير.","bab":"أيمان › الاستثناء في اليمين","dorar":"1XuVFTjJ"},{"id":"س-06154","fp":"ae1a4d61e0af","stateId":628,"easy":"إذا جار القوم في الحكم ← يقع البأس بينهم","cause":"وما جار قومٌ في حكمٍ","result":"إلا كان البأسُ بينهم","explicit":true,"ref":"السلسلة الصحيحة 1/219","srcLabel":"البيهقي","text":["عن ابنِ عباسٍ قال : ما نقض قومٌ العهدَ إلا سلَّط اللهُ عليهم عدوَّهم ولا فشتِ الفاحشةُ في قومٍ إلا أخذهم اللهُ بالموتِ وما طفَّف قومٌ الميزانَ إلا أخذَهم اللهُ بالسِّنينَ وما منع قومٌ الزكاةَ إلا منعَهم اللهُ القطرَ من السماءِ ",["وما جار قومٌ في حكمٍ",1]," ",["إلا كان البأسُ بينهم",2]," أظنُّه قال : والقتلُ"],"grade":"صحيح","narrator":"عبدالله بن بريدة بن الحصيب الأسلمي","muhaddith":"إسناده صحيح","takhrij":"أخرجه البيهقي (6470) واللفظ له.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"4yZchCL2"},{"id":"ق-0043","fp":"9a38f5f19825","stateId":629,"easy":"الظلم ← الحرمان من عهد الله (الإمامة)","cause":"الظلم","result":"الحرمان من عهد الله (الإمامة)","explicit":true,"ref":"سورة البقرة: 124","srcLabel":"القرآن الكريم","quran":{"s":2,"from":124,"to":124,"text":"وَإِذِ ابْتَلَى إِبْرَاهِيمَ رَبُّهُ بِكَلِمَاتٍ فَأَتَمَّهُنَّ قَالَ إِنِّي جَاعِلُكَ لِلنَّاسِ إِمَامًا قَالَ وَمِنْ ذُرِّيَّتِي قَالَ لَا يَنَالُ عَهْدِي الظَّالِمِينَ (124)","hl":[[137,170,1]]}},{"id":"ق-0104","fp":"d61db08f3775","stateId":629,"easy":"الظلم ← لا أنصار لهم","cause":"الظلم","result":"لا أنصار لهم","explicit":true,"similar":["ق-0830"],"ref":"سورة البقرة: 270","srcLabel":"القرآن الكريم","quran":{"s":2,"from":270,"to":270,"text":"وَمَا أَنْفَقْتُمْ مِنْ نَفَقَةٍ أَوْ نَذَرْتُمْ مِنْ نَذْرٍ فَإِنَّ اللَّهَ يَعْلَمُهُ وَمَا لِلظَّالِمِينَ مِنْ أَنْصَارٍ (270)","hl":[[88,123,1]]}},{"id":"ق-0377","fp":"b1f7839dd991","stateId":629,"easy":"كسب الظالمين ← تولية بعضهم بعضاً","cause":"كسب الظالمين","result":"تولية بعضهم بعضاً","explicit":true,"ref":"سورة الأنعام: 129","srcLabel":"القرآن الكريم","quran":{"s":6,"from":129,"to":129,"text":"وَكَذَلِكَ نُوَلِّي بَعْضَ الظَّالِمِينَ بَعْضًا بِمَا كَانُوا يَكْسِبُونَ (129)","hl":[[0,74,1]]}},{"id":"ق-0438","fp":"909c1283aca2","stateId":629,"easy":"الظلم والعتوّ ← تسليط من يسومهم سوء العذاب إلى يوم القيامة","cause":"الظلم والعتوّ","result":"تسليط من يسومهم سوء العذاب إلى يوم القيامة","explicit":true,"ref":"سورة الأعراف: 167","srcLabel":"القرآن الكريم","quran":{"s":7,"from":167,"to":167,"text":"وَإِذْ تَأَذَّنَ رَبُّكَ لَيَبْعَثَنَّ عَلَيْهِمْ إِلَى يَوْمِ الْقِيَامَةِ مَنْ يَسُومُهُمْ سُوءَ الْعَذَابِ إِنَّ رَبَّكَ لَسَرِيعُ الْعِقَابِ وَإِنَّهُ لَغَفُورٌ رَحِيمٌ (167)","hl":[[0,109,1]]}},{"id":"ق-0692","fp":"60af28dd331d","stateId":629,"easy":"الإفساد في الأرض والعلوّ ← تسليط عباد أولي بأس شديد","cause":"الإفساد في الأرض والعلوّ","result":"تسليط عباد أولي بأس شديد","explicit":true,"otherNeedIds":[61],"ref":"سورة الإسراء: 4–5","srcLabel":"القرآن الكريم","quran":{"s":17,"from":4,"to":5,"text":"وَقَضَيْنَا إِلَى بَنِي إِسْرَائِيلَ فِي الْكِتَابِ لَتُفْسِدُنَّ فِي الْأَرْضِ مَرَّتَيْنِ وَلَتَعْلُنَّ عُلُوًّا كَبِيرًا (4) فَإِذَا جَاءَ وَعْدُ أُولَاهُمَا بَعَثْنَا عَلَيْكُمْ عِبَادًا لَنَا أُولِي بَأْسٍ شَدِيدٍ فَجَاسُوا خِلَالَ الدِّيَارِ وَكَانَ وَعْدًا مَفْعُولًا (5)","hl":[[52,274,1]]}},{"id":"ق-0830","fp":"c263dd04c845","stateId":629,"easy":"الظلم ← لا نصير لهم","cause":"الظلم","result":"لا نصير لهم","explicit":true,"repOf":"ق-0104","ref":"سورة الحج: 71","quran":{"s":22,"from":71,"to":71,"text":"وَيَعْبُدُونَ مِنْ دُونِ اللَّهِ مَا لَمْ يُنَزِّلْ بِهِ سُلْطَانًا وَمَا لَيْسَ لَهُمْ بِهِ عِلْمٌ وَمَا لِلظَّالِمِينَ مِنْ نَصِيرٍ (71)","hl":[[100,133,1]]}},{"id":"ق-1144","fp":"bf9dd0838ea9","stateId":629,"easy":"الظلم ← لا وليّ ولا نصير","cause":"الظلم","result":"لا وليّ ولا نصير","explicit":true,"ref":"سورة الشورى: 8","srcLabel":"القرآن الكريم","quran":{"s":42,"from":8,"to":8,"text":"وَلَوْ شَاءَ اللَّهُ لَجَعَلَهُمْ أُمَّةً وَاحِدَةً وَلَكِنْ يُدْخِلُ مَنْ يَشَاءُ فِي رَحْمَتِهِ وَالظَّالِمُونَ مَا لَهُمْ مِنْ وَلِيٍّ وَلَا نَصِيرٍ (8)","hl":[[98,151,1]]}},{"id":"س-02678","fp":"241de7de0c81","stateId":629,"easy":"إذا نقض القوم العهد ← يسلط الله عليهم عدوهم","cause":"ما نَقضَ قومٌ العهدَ","result":"إلَّا سلَّطَ عليهِم عدوَّهُمْ","explicit":true,"ref":"صحيح الترغيب 765","srcLabel":"الطبراني","text":["خمسٌ بخمسٍ . قيلَ يا رسولَ اللهِ ما خمسٌ بخَمسٍ قال : ",["ما نَقضَ قومٌ العهدَ",1]," ",["إلَّا سلَّطَ عليهِم عدوَّهُمْ",2]," ، وما حكَموا بغيرِ ما أنزل اللهُ إلَّا فشا فيهم ( الفَقرُ ، و لا ظهَرت فيهِم الفاحشةُ ، إلَّا فَشا فيهم ) الموتُ ، و لا مَنعوا الزَّكاةَ إلَّا حُبِسَ عنهم القَطْرُ ، و لا طفَّفوا المكيالَ إلَّا حُبِسَ عنهم النَّباتُ ، و أُخِذُوا بالسِّنينَ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني (11/45) (10992)، والديلمي في ((الفردوس)) (2978) باختلاف يسير.","bab":"إيمان › الحكم بما أنزل الله","dorar":"U9tj6u4A","merged":2,"otherRefs":["السلسلة الصحيحة 1/219 (صحيح)"]},{"id":"س-00504","fp":"9c53f65f4530","stateId":629,"easy":"إذا أحدثتم المعاصي ← يسلط الله عليكم شرار خلقه","cause":"ما لم تُحْدِثوا أحداثًا فإذا فَعَلْتم","result":"سَلَّط عليكم شِرَارَ خَلْقِه فيَلْحَتُوكم كما يُلْحَتُ القَضِيبُ","explicit":true,"similar":["س-07490"],"otherNeedIds":[61],"ref":"تخريج كتاب السنة 1119","srcLabel":"أحمد","text":["إنَّ هذا الأمرَ لا يزالُ فيكم وأنتم وُلَاتُه ",["ما لم تُحْدِثوا أحداثًا فإذا فَعَلْتم",1]," ",["سَلَّط عليكم شِرَارَ خَلْقِه فيَلْحَتُوكم كما يُلْحَتُ القَضِيبُ",2]],"grade":"صحيح","narrator":"أبو مسعود عقبة بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17069)، والطيالسي (653)، والحاكم (8758) جميعهم باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"euve1YvN"},{"id":"س-07490","fp":"2577ce483cd3","stateId":629,"easy":"إذا أحدثتم المعاصي ← يسلط الله عليكم شرار خلقه","cause":"حتى تُحدِثوا أعمالًا","result":"سلَّطَ اللهُ عليكم شرارَ خلقِه","explicit":true,"repOf":"س-00504","otherNeedIds":[61],"ref":"مجمع الزوائد 5/196","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم لقريشٍ إن هذا الأمرَ فيكم وأنتم ولاتُه ",["حتى تُحدِثوا أعمالًا",1]," فإذا فعلتم ذلك ",["سلَّطَ اللهُ عليكم شرارَ خلقِه",2]," فالتَحَوكم كما يُلتَحَى القضيبُ"],"grade":"صحيح","narrator":"أبو مسعود عقبة بن عمرو","muhaddith":"رجاله رجال الصحيح خلا القاسم بن محمد بن عبد الرحمن بن الحرث وهو ثقة","takhrij":"أخرجه الحاكم (8758) بلفظه، وأحمد (17069)، والطيالسي (653) كلاهما باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"F2GpNVvH"},{"id":"س-00369","fp":"9c0044e93f45","stateId":629,"easy":"إذا شددت سلطانك بمعصية الله ← يوهن الله كيدك يوم القيامة","cause":"من شدَّدَ سلطانَه بمعصيةِ اللَّه","result":"أوهنَ اللَّه كيدَه يومَ القيامَةِ","explicit":true,"ref":"الجامع الصغير 8746","srcLabel":"أحمد","text":[["من شدَّدَ سلطانَه بمعصيةِ اللَّه، ",1],["أوهنَ اللَّه كيدَه يومَ القيامَةِ",2]],"grade":"حسن","narrator":"قيس بن سعد","muhaddith":"حسن","takhrij":"أخرجه أحمد (23841) واللفظ له.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"PRHBmr2A"},{"id":"س-05287","fp":"a060968b6266","stateId":629,"easy":"إذا لم تأمروا بالمعروف وتنهوا عن المنكر ← يسلط الله عليكم شراركم ولا يُستجاب دعاء خياركم","cause":"لتَأمُرُنَّ بالمَعروفِ ولَتَنهَوُنَّ عنِ المُنكَرِ","result":"أو ليُسَلِّطَنَّ اللهُ عليكُم شِرارَكُم، فيَدعو خيارُكُم فلا يُستَجابُ لهم","explicit":true,"otherNeedIds":[30],"ref":"فيض القدير 5/ 261","srcLabel":"الطبراني","text":[["لتَأمُرُنَّ بالمَعروفِ ولَتَنهَوُنَّ عنِ المُنكَرِ",1],"، ",["أو ليُسَلِّطَنَّ اللهُ عليكُم شِرارَكُم، فيَدعو خيارُكُم فلا يُستَجابُ لهم",2]],"grade":"حسن","narrator":"أبو هريرةَ","muhaddith":"رمز السيوطي لحسنه وليس ذا منه بحسن","takhrij":"أخرجه البزار (8510)، والطبراني في ((الأوسط)) (1379) كلاهما بلفظه، والخطيب البغدادي في ((تاريخ بغداد)) (15/ 108) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"8k5xTInI"},{"id":"ق-0018","fp":"b86a5b5acba6","stateId":630,"easy":"الكفر بآيات الله وقتل الأنبياء والعصيان والاعتداء ← الذلة والمسكنة وغضب الله","cause":"الكفر بآيات الله وقتل الأنبياء والعصيان والاعتداء","result":"الذلة والمسكنة وغضب الله","explicit":true,"star":true,"similar":["ق-0154"],"otherNeedIds":[28],"ref":"سورة البقرة: 61","srcLabel":"القرآن الكريم","quran":{"s":2,"from":61,"to":61,"text":"وَإِذْ قُلْتُمْ يَا مُوسَى لَنْ نَصْبِرَ عَلَى طَعَامٍ وَاحِدٍ فَادْعُ لَنَا رَبَّكَ يُخْرِجْ لَنَا مِمَّا تُنْبِتُ الْأَرْضُ مِنْ بَقْلِهَا وَقِثَّائِهَا وَفُومِهَا وَعَدَسِهَا وَبَصَلِهَا قَالَ أَتَسْتَبْدِلُونَ الَّذِي هُوَ أَدْنَى بِالَّذِي هُوَ خَيْرٌ اهْبِطُوا مِصْرًا فَإِنَّ لَكُمْ مَا سَأَلْتُمْ وَضُرِبَتْ عَلَيْهِمُ الذِّلَّةُ وَالْمَسْكَنَةُ وَبَاءُوا بِغَضَبٍ مِنَ اللَّهِ ذَلِكَ بِأَنَّهُمْ كَانُوا يَكْفُرُونَ بِآيَاتِ اللَّهِ وَيَقْتُلُونَ النَّبِيِّينَ بِغَيْرِ الْحَقِّ ذَلِكَ بِمَا عَصَوْا وَكَانُوا يَعْتَدُونَ (61)","hl":[[305,530,1]]}},{"id":"ق-0025","fp":"6c2dadc758dc","stateId":630,"easy":"الإيمان ببعض الكتاب والكفر ببعضه ← خزي في الدنيا وأشد العذاب يوم القيامة","cause":"الإيمان ببعض الكتاب والكفر ببعضه","result":"خزي في الدنيا وأشد العذاب يوم القيامة","explicit":true,"star":true,"otherNeedIds":[70],"ref":"سورة البقرة: 85","srcLabel":"القرآن الكريم","quran":{"s":2,"from":85,"to":85,"text":"ثُمَّ أَنْتُمْ هَؤُلَاءِ تَقْتُلُونَ أَنْفُسَكُمْ وَتُخْرِجُونَ فَرِيقًا مِنْكُمْ مِنْ دِيَارِهِمْ تَظَاهَرُونَ عَلَيْهِمْ بِالْإِثْمِ وَالْعُدْوَانِ وَإِنْ يَأْتُوكُمْ أُسَارَى تُفَادُوهُمْ وَهُوَ مُحَرَّمٌ عَلَيْكُمْ إِخْرَاجُهُمْ أَفَتُؤْمِنُونَ بِبَعْضِ الْكِتَابِ وَتَكْفُرُونَ بِبَعْضٍ فَمَا جَزَاءُ مَنْ يَفْعَلُ ذَلِكَ مِنْكُمْ إِلَّا خِزْيٌ فِي الْحَيَاةِ الدُّنْيَا وَيَوْمَ الْقِيَامَةِ يُرَدُّونَ إِلَى أَشَدِّ الْعَذَابِ وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ (85)","hl":[[233,433,1]]}},{"id":"ق-0038","fp":"f13a3f8bf804","stateId":630,"easy":"منع مساجد الله من الذكر والسعي في خرابها ← خزي في الدنيا وعذاب عظيم في الآخرة","cause":"منع مساجد الله من الذكر والسعي في خرابها","result":"خزي في الدنيا وعذاب عظيم في الآخرة","explicit":true,"otherNeedIds":[69],"ref":"سورة البقرة: 114","srcLabel":"القرآن الكريم","quran":{"s":2,"from":114,"to":114,"text":"وَمَنْ أَظْلَمُ مِمَّنْ مَنَعَ مَسَاجِدَ اللَّهِ أَنْ يُذْكَرَ فِيهَا اسْمُهُ وَسَعَى فِي خَرَابِهَا أُولَئِكَ مَا كَانَ لَهُمْ أَنْ يَدْخُلُوهَا إِلَّا خَائِفِينَ لَهُمْ فِي الدُّنْيَا خِزْيٌ وَلَهُمْ فِي الْآخِرَةِ عَذَابٌ عَظِيمٌ (114)","hl":[[0,232,1]]}},{"id":"ق-0039","fp":"fa434823242f","stateId":630,"easy":"اتباع أهواء أهل الباطل بعد العلم ← فقد ولاية الله ونصرته","cause":"اتباع أهواء أهل الباطل بعد العلم","result":"فقد ولاية الله ونصرته","explicit":true,"ref":"سورة البقرة: 120","srcLabel":"القرآن الكريم","quran":{"s":2,"from":120,"to":120,"text":"وَلَنْ تَرْضَى عَنْكَ الْيَهُودُ وَلَا النَّصَارَى حَتَّى تَتَّبِعَ مِلَّتَهُمْ قُلْ إِنَّ هُدَى اللَّهِ هُوَ الْهُدَى وَلَئِنِ اتَّبَعْتَ أَهْوَاءَهُمْ بَعْدَ الَّذِي جَاءَكَ مِنَ الْعِلْمِ مَا لَكَ مِنَ اللَّهِ مِنْ وَلِيٍّ وَلَا نَصِيرٍ (120)","hl":[[119,239,1]]}},{"id":"ق-0122","fp":"1431c99f3d28","stateId":630,"easy":"الكفر ← الغلبة عليهم والحشر إلى جهنم","cause":"الكفر","result":"الغلبة عليهم والحشر إلى جهنم","explicit":true,"otherNeedIds":[70],"ref":"سورة آل عمران: 12","srcLabel":"القرآن الكريم","quran":{"s":3,"from":12,"to":12,"text":"قُلْ لِلَّذِينَ كَفَرُوا سَتُغْلَبُونَ وَتُحْشَرُونَ إِلَى جَهَنَّمَ وَبِئْسَ الْمِهَادُ (12)","hl":[[5,88,1]]}},{"id":"ق-0154","fp":"7f66fa2c138d","stateId":630,"easy":"الكفر بآيات الله وقتل الأنبياء والعصيان والاعتداء ← الذلة والمسكنة وغضب الله","cause":"الكفر بآيات الله وقتل الأنبياء والعصيان والاعتداء","result":"الذلة والمسكنة وغضب الله","explicit":true,"repOf":"ق-0018","otherNeedIds":[28],"ref":"سورة آل عمران: 112","quran":{"s":3,"from":112,"to":112,"text":"ضُرِبَتْ عَلَيْهِمُ الذِّلَّةُ أَيْنَ مَا ثُقِفُوا إِلَّا بِحَبْلٍ مِنَ اللَّهِ وَحَبْلٍ مِنَ النَّاسِ وَبَاءُوا بِغَضَبٍ مِنَ اللَّهِ وَضُرِبَتْ عَلَيْهِمُ الْمَسْكَنَةُ ذَلِكَ بِأَنَّهُمْ كَانُوا يَكْفُرُونَ بِآيَاتِ اللَّهِ وَيَقْتُلُونَ الْأَنْبِيَاءَ بِغَيْرِ حَقٍّ ذَلِكَ بِمَا عَصَوْا وَكَانُوا يَعْتَدُونَ (112)","hl":[[0,313,1]]}},{"id":"ق-0301","fp":"d1cd8fe0febd","stateId":630,"easy":"محاربة الله ورسوله والسعي في الأرض فساداً ← خزي في الدنيا وعذاب عظيم في الآخرة","cause":"محاربة الله ورسوله والسعي في الأرض فساداً","result":"خزي في الدنيا وعذاب عظيم في الآخرة","explicit":true,"otherNeedIds":[69],"ref":"سورة المائدة: 33","srcLabel":"القرآن الكريم","quran":{"s":5,"from":33,"to":33,"text":"إِنَّمَا جَزَاءُ الَّذِينَ يُحَارِبُونَ اللَّهَ وَرَسُولَهُ وَيَسْعَوْنَ فِي الْأَرْضِ فَسَادًا أَنْ يُقَتَّلُوا أَوْ يُصَلَّبُوا أَوْ تُقَطَّعَ أَيْدِيهِمْ وَأَرْجُلُهُمْ مِنْ خِلَافٍ أَوْ يُنْفَوْا مِنَ الْأَرْضِ ذَلِكَ لَهُمْ خِزْيٌ فِي الدُّنْيَا وَلَهُمْ فِي الْآخِرَةِ عَذَابٌ عَظِيمٌ (33)","hl":[[0,290,1]]}},{"id":"ق-0315","fp":"5452d9af86bd","stateId":630,"easy":"الردة عن الدين ← يستبدل الله بهم قوماً يحبهم ويحبونه","cause":"الردة عن الدين","result":"يستبدل الله بهم قوماً يحبهم ويحبونه","explicit":true,"ref":"سورة المائدة: 54","srcLabel":"القرآن الكريم","quran":{"s":5,"from":54,"to":54,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا مَنْ يَرْتَدَّ مِنْكُمْ عَنْ دِينِهِ فَسَوْفَ يَأْتِي اللَّهُ بِقَوْمٍ يُحِبُّهُمْ وَيُحِبُّونَهُ أَذِلَّةٍ عَلَى الْمُؤْمِنِينَ أَعِزَّةٍ عَلَى الْكَافِرِينَ يُجَاهِدُونَ فِي سَبِيلِ اللَّهِ وَلَا يَخَافُونَ لَوْمَةَ لَائِمٍ ذَلِكَ فَضْلُ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ وَاللَّهُ وَاسِعٌ عَلِيمٌ (54)","hl":[[31,128,1]]}},{"id":"ق-0319","fp":"94b12e7e2aef","stateId":630,"easy":"إيقاد الحروب والسعي في الأرض فساداً ← إطفاء الله لنارهم ولا يحبهم","cause":"إيقاد الحروب والسعي في الأرض فساداً","result":"إطفاء الله لنارهم ولا يحبهم","explicit":true,"otherNeedIds":[27],"ref":"سورة المائدة: 64","srcLabel":"القرآن الكريم","quran":{"s":5,"from":64,"to":64,"text":"وَقَالَتِ الْيَهُودُ يَدُ اللَّهِ مَغْلُولَةٌ غُلَّتْ أَيْدِيهِمْ وَلُعِنُوا بِمَا قَالُوا بَلْ يَدَاهُ مَبْسُوطَتَانِ يُنْفِقُ كَيْفَ يَشَاءُ وَلَيَزِيدَنَّ كَثِيرًا مِنْهُمْ مَا أُنْزِلَ إِلَيْكَ مِنْ رَبِّكَ طُغْيَانًا وَكُفْرًا وَأَلْقَيْنَا بَيْنَهُمُ الْعَدَاوَةَ وَالْبَغْضَاءَ إِلَى يَوْمِ الْقِيَامَةِ كُلَّمَا أَوْقَدُوا نَارًا لِلْحَرْبِ أَطْفَأَهَا اللَّهُ وَيَسْعَوْنَ فِي الْأَرْضِ فَسَادًا وَاللَّهُ لَا يُحِبُّ الْمُفْسِدِينَ (64)","hl":[[311,441,1]]}},{"id":"ق-0584","fp":"eed34387e764","stateId":630,"easy":"التولي عن دعوة الرسل ← استخلاف قوم غيرهم","cause":"التولي عن دعوة الرسل","result":"استخلاف قوم غيرهم","explicit":true,"ref":"سورة هود: 57","srcLabel":"القرآن الكريم","quran":{"s":11,"from":57,"to":57,"text":"فَإِنْ تَوَلَّوْا فَقَدْ أَبْلَغْتُكُمْ مَا أُرْسِلْتُ بِهِ إِلَيْكُمْ وَيَسْتَخْلِفُ رَبِّي قَوْمًا غَيْرَكُمْ وَلَا تَضُرُّونَهُ شَيْئًا إِنَّ رَبِّي عَلَى كُلِّ شَيْءٍ حَفِيظٌ (57)","hl":[[0,111,1]]}},{"id":"ق-0635","fp":"779c82e49f9f","stateId":630,"easy":"اتباع الأهواء بعد العلم ← لا وليّ ولا واقٍ من الله","cause":"اتباع الأهواء بعد العلم","result":"لا وليّ ولا واقٍ من الله","explicit":true,"ref":"سورة الرعد: 37","srcLabel":"القرآن الكريم","quran":{"s":13,"from":37,"to":37,"text":"وَكَذَلِكَ أَنْزَلْنَاهُ حُكْمًا عَرَبِيًّا وَلَئِنِ اتَّبَعْتَ أَهْوَاءَهُمْ بَعْدَمَا جَاءَكَ مِنَ الْعِلْمِ مَا لَكَ مِنَ اللَّهِ مِنْ وَلِيٍّ وَلَا وَاقٍ (37)","hl":[[44,157,1]]}},{"id":"ق-0703","fp":"56423a8a1cc8","stateId":630,"easy":"الشرك بالله ← الذمّ والخذلان","cause":"الشرك بالله","result":"الذمّ والخذلان","explicit":true,"otherNeedIds":[28],"ref":"سورة الإسراء: 22","srcLabel":"القرآن الكريم","quran":{"s":17,"from":22,"to":22,"text":"لَا تَجْعَلْ مَعَ اللَّهِ إِلَهًا آخَرَ فَتَقْعُدَ مَذْمُومًا مَخْذُولًا (22)","hl":[[0,72,1]]}},{"id":"ق-0947","fp":"0e9c195f7b8a","stateId":630,"easy":"اتخاذ أولياء من دون الله ← وهن كبيت العنكبوت","cause":"اتخاذ أولياء من دون الله","result":"وهن كبيت العنكبوت","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"otherNeedIds":[57],"ref":"سورة العنكبوت: 41","srcLabel":"القرآن الكريم","quran":{"s":29,"from":41,"to":41,"text":"مَثَلُ الَّذِينَ اتَّخَذُوا مِنْ دُونِ اللَّهِ أَوْلِيَاءَ كَمَثَلِ الْعَنْكَبُوتِ اتَّخَذَتْ بَيْتًا وَإِنَّ أَوْهَنَ الْبُيُوتِ لَبَيْتُ الْعَنْكَبُوتِ لَوْ كَانُوا يَعْلَمُونَ (41)","hl":[[7,178,1]]}},{"id":"ق-1211","fp":"b427b15c60be","stateId":630,"easy":"الكفر ← لا مولى لهم","cause":"الكفر","result":"لا مولى لهم","explicit":true,"ref":"سورة محمد: 11","srcLabel":"القرآن الكريم","quran":{"s":47,"from":11,"to":11,"text":"ذَلِكَ بِأَنَّ اللَّهَ مَوْلَى الَّذِينَ آمَنُوا وَأَنَّ الْكَافِرِينَ لَا مَوْلَى لَهُمْ (11)","hl":[[49,89,1]]}},{"id":"ق-1228","fp":"1cd2ac0eac85","stateId":630,"easy":"التولي عن الإنفاق والطاعة ← الاستبدال بقوم غيرهم","cause":"التولي عن الإنفاق والطاعة","result":"الاستبدال بقوم غيرهم","explicit":true,"ref":"سورة محمد: 38","srcLabel":"القرآن الكريم","quran":{"s":47,"from":38,"to":38,"text":"هَا أَنْتُمْ هَؤُلَاءِ تُدْعَوْنَ لِتُنْفِقُوا فِي سَبِيلِ اللَّهِ فَمِنْكُمْ مَنْ يَبْخَلُ وَمَنْ يَبْخَلْ فَإِنَّمَا يَبْخَلُ عَنْ نَفْسِهِ وَاللَّهُ الْغَنِيُّ وَأَنْتُمُ الْفُقَرَاءُ وَإِنْ تَتَوَلَّوْا يَسْتَبْدِلْ قَوْمًا غَيْرَكُمْ ثُمَّ لَا يَكُونُوا أَمْثَالَكُمْ (38)","hl":[[187,272,1]]}},{"id":"ق-1309","fp":"42b3f00ce1eb","stateId":630,"easy":"محادّة الله ورسوله ← الكبت كما كُبت من قبلهم وعذاب مهين","cause":"محادّة الله ورسوله","result":"الكبت كما كُبت من قبلهم وعذاب مهين","explicit":true,"otherNeedIds":[70],"ref":"سورة المجادلة: 5","srcLabel":"القرآن الكريم","quran":{"s":58,"from":5,"to":5,"text":"إِنَّ الَّذِينَ يُحَادُّونَ اللَّهَ وَرَسُولَهُ كُبِتُوا كَمَا كُبِتَ الَّذِينَ مِنْ قَبْلِهِمْ وَقَدْ أَنْزَلْنَا آيَاتٍ بَيِّنَاتٍ وَلِلْكَافِرِينَ عَذَابٌ مُهِينٌ (5)","hl":[[0,165,1]]}},{"id":"ق-1314","fp":"b243dd58f500","stateId":630,"easy":"محادّة الله ورسوله ← في الأذلّين","cause":"محادّة الله ورسوله","result":"في الأذلّين","explicit":true,"ref":"سورة المجادلة: 20","srcLabel":"القرآن الكريم","quran":{"s":58,"from":20,"to":20,"text":"إِنَّ الَّذِينَ يُحَادُّونَ اللَّهَ وَرَسُولَهُ أُولَئِكَ فِي الْأَذَلِّينَ (20)","hl":[[0,75,1]]}}]}