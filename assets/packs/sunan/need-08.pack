{"schema":1,"kind":"sunan-chunk","version":"sunan-c56d7b8d0f22","needId":8,"stateIds":[48,49],"items":[{"id":"س-02532","fp":"57af25cc7a0f","stateId":48,"easy":"إذا غضبت فقل «أعوذ بالله من الشيطان الرجيم» ← يذهب عنك ما تجد","cause":"أعوذُ باللهِ مِنَ الشَّيطانِ الرَّجيمِ","result":"لو قالها لَذَهَبَ ذا عنه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"apply":{"k":"say","t":"«أعوذ بالله من الشيطان الرجيم»"},"ref":"صحيح مسلم 2610","srcLabel":"متفق عليه","text":["استَبَّ رَجُلانِ عِندَ النَّبيِّ صلَّى اللهُ عليه وسلَّم، فجَعَلَ أحَدُهما يَغضَبُ ويَحمَرُّ وجهُه، فنَظَرَ إليه النَّبيُّ صلَّى اللهُ عليه وسلَّم، فقال: إنِّي لأعلَمُ كَلِمةً لو قالها لَذَهَبَ ذا عنه: ",["أعوذُ باللهِ مِنَ الشَّيطانِ الرَّجيمِ",1],"، فقامَ إلى الرَّجُلِ رَجُلٌ مِمَّن سَمِعَ النَّبيَّ صلَّى اللهُ عليه وسلَّم، فقال: أتَدري ما قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم آنِفًا؟ قال: إنِّي لأعلَمُ كَلِمةً ",["لو قالها لَذَهَبَ ذا عنه",2],": أعوذُ باللهِ مِنَ الشَّيطانِ الرَّجيمِ، فقال له الرَّجُلُ: أمَجنونًا تَراني؟"],"grade":"صحيح","narrator":"سليمان بن صرد","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6048)، ومسلم (2610).","bab":"إيمان › أعمال الجن والشياطين","dorar":"XneGgT6c","merged":8,"otherRefs":["صحيح الترمذي 3452 (صحيح)","صحيح البخاري 6115 (صحيح)","صحيح البخاري 6048 (صحيح)","صحيح مسلم 2610 (صحيح)","الأمالي المطلقة 184 (حسن)","صحيح البخاري 3282 (صحيح)","الأحاديث المختارة 1236 (صحيح)"]},{"id":"س-00696","fp":"a1cff1db901f","stateId":48,"easy":"إذا غضبت فقلت «أعوذ بالله من الشيطان الرجيم» ← يسكن غضبك","cause":"فقال أعوذُ باللهِ","result":"سَكَنَ غضبُه","explicit":true,"star":true,"apply":{"k":"say","t":"«أعوذ بالله من الشيطان الرجيم»"},"ref":"صحيح الجامع 695","srcLabel":"ابن عدي","text":["إذا غَضِبَ الرجلُ ",["فقال أعوذُ باللهِ",1]," ",["سَكَنَ غضبُه",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (5/256)","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"0yXUGfin"},{"id":"س-05788","fp":"99486c4c76c6","stateId":48,"easy":"إذا غضبت وأنت قائم فاجلس ← فإن لم يذهب غضبك فاضطجع","cause":"إذا غَضِبَ أحدُكم و هو قائمٌ فلْيجلسْ","result":"فإنْ ذهب عنه الغضبُ و إلا فلْيضطجِعْ","explicit":true,"ref":"الجامع الصغير 764","srcLabel":"أبو داود","text":[["إذا غَضِبَ أحدُكم و هو قائمٌ فلْيجلسْ ؛ ",1],["فإنْ ذهب عنه الغضبُ و إلا فلْيضطجِعْ",2]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4782)، وابن حبان (1425)، والبيهقي في ((شعب الإيمان)) (8284)، والبغوي في ((شرح السنة)) (3584) واللفظ لهم.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"x8NF99ur"},{"id":"س-06778","fp":"7077662964eb","stateId":48,"easy":"إذا غضبت وأنت قائم فاقعد، وإن كنت قاعداً فاتكئ أو اضطجع ← يذهب غضبك","cause":"إذا غضبتَ","result":"فإن كنتَ قائمًا فاقعد وإن كنتَ قاعدًا فاتَّكِئْ وإن كنتَ متَّكئًا فاضطجِعْ","explicit":true,"ref":"تخريج الإحياء للعراقي 3/216","srcLabel":"أبو داود","text":["يا أبا ذرٍّ بلغني أنك اليومَ عيَّرتَ أخاك بأُمِّه فقال : نعم فانطلق أبو ذرٍّ ليُرضي صاحبَه , فسبقَه الرجلُ فسلَّمَ عليه , فذكر ذلك لرسولِ اللهِ صلَّى اللهُ عليهِ وسلَّم فقال : يا أبا ذرٍّ ارفع رأسَك فانظر ثم اعلم أنك لستَ بأفضلَ من أحمرَ ولا أسودَ إلا أن تَفْضُلَه بعملٍ ثم قال ",["إذا غضبتَ ",1],["فإن كنتَ قائمًا فاقعد وإن كنتَ قاعدًا فاتَّكِئْ وإن كنتَ متَّكئًا فاضطجِعْ ",2],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4782)، وأحمد (21348)، وابن حبان (5688) جميعهم بنحوه.","bab":"عتق وولاء › الإحسان إلى العبيد","dorar":"7VHKzefz"},{"id":"س-01485","fp":"b79ab39f7afc","stateId":48,"easy":"إذا غضبت فتوضأ ← فإنما تُطفأ النار بالماء","cause":"فإذا غَضِبَ أحَدُكُم فليَتَوضَّأْ","result":"وإنَّما تُطفَأُ النَّارُ بالماءِ","explicit":true,"ref":"مجموع الشروح الفقهية. 212/30","srcLabel":"أبو داود","text":["إنَّ الغَضَبَ مِن الشَّيطانِ، وإنَّ الشَّيطانَ خُلِقَ مِن النَّارِ، ",["وإنَّما تُطفَأُ النَّارُ بالماءِ",2],"، ",["فإذا غَضِبَ أحَدُكُم فليَتَوضَّأْ",1],"."],"grade":"حسن","narrator":"عطية السعدي","muhaddith":"إسناده حسن","takhrij":"أخرجه أبو داود (4784)، وأحمد (17985)، والطبراني (17/167) (443)، والبيهقي في ((شعب الإيمان)) (7938) جميعا بلفظه.","bab":"وضوء › فضل الوضوء","dorar":"gfs9in7H"},{"id":"س-02682","fp":"16b35c8e0cd7","stateId":48,"easy":"إذا غضبت فاسكت ← (علاج نبوي للغضب)","cause":"فليسكُت","result":"إذا غضِبَ أحدُكُم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"similar":["س-02687"],"ref":"صحيح الأدب المفرد 184","srcLabel":"البخاري","text":["علِّمُوا و يَسِّرُوا علِّمُوا و يسِّرُوا ثلاثَ مرَّاتٍ و لا تُعسِّرُوا ، ",["إذا غضِبَ أحدُكُم",2]," ",["فليسكُت",1]," مرَّتينِ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (2556)، والبزار (4872) باختلاف يسير، والبخاري في ((الأدب المفرد)) (1320) واللفظ له","bab":"إيمان › الدين يسر","dorar":"4NLiRxe7","merged":3,"otherRefs":["تخريج المسند لشاكر 4/12 (صحيح)","صحيح الجامع 4027 (صحيح)"]},{"id":"س-02687","fp":"ccf5ad52982b","stateId":48,"easy":"إذا غضبت فاسكت ← (علاج نبوي للغضب)","cause":"فاسكُتْ","result":"وإذا غضِبْتَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-02682","ref":"تخريج المسند لشاكر 5/150","text":["علِّموا ويسِّروا ولا تعسِّروا وإذا غضِبْتَ ",["فاسكُتْ",1]," ",["وإذا غضِبْتَ",2]," فاسكُتْ وإذا غضِبْتَ فاسكُتْ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (2556) واللفظ له، والبزار (4872) باختلاف يسير، والطبراني (11/33) (10951) مطولاً","bab":"إيمان › الدين يسر","dorar":"rixdLlL0"},{"id":"س-07771","fp":"23af36fea042","stateId":48,"easy":"إذا اشتد غضبك في الجدال فاستعذ بالله من الشيطان ← يذهب عنك","cause":"استعِذْ باللهِ من الشيطانِ الرجيمِ","result":"ففضتُ عرقًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[16],"ref":"تفسير الطبري 1/23","srcLabel":"تفسير الطبري","text":["أنَّ رجلينِ اختصما في آيةٍ من القرآنِ ، وكلٌّ يزعم أنَّ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ أقرأه ، فتقارآ إلى أُبيٍّ ، فخالفَهما أُبيٌّ ، فتقارءوا إلى النبيِّ صلَّى اللهُ عليهِ وسلَّمَ ، فقال : يا نبيَّ اللهِ ! اختلفْنا في آيةٍ من القرآنِ ، وكلُّنا يزعمُ أنك أقرأتَه ، فقال لأحدِهما : اقرأْ ! قال : فقرأ ، فقال : أصبتَ ! وقال للآخرِ : اقرأْ ! فقرأ خلاف ما قرأ صاحبُه ، فقال : أصبتَ ! وقال لأُبيٍّ : اقرأ ! فقرأ فخالفَهما ، فقال : أصبتَ ! قال أُبيٌّ : فدخلني من الشكِّ في أمرِ رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ما دخل في أمرٍ من الجاهليةِ ، قال : فعرف رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ الذي في وجهي ، فرفع يدَه فضرب صدري ، وقال : ",["استعِذْ باللهِ من الشيطانِ الرجيمِ",1]," ، قال : ",["ففضتُ عرقًا",2]," ، وكأني أنظرُ إلى اللهِ فرَقًا ، وقال : إنه أتاني آتٍ من ربي ، فقال : إنَّ ربَّكَ يأمرُكَ أن تقرأَ القرآنَ على حرفٍ واحدٍ ، فقلتُ : ربِّ خفِّفْ عن أمتي ، قال : ثم جاء ، فقال : إنَّ ربَّك يأمرُكَ أن تقرأَ القرآنَ على حرفٍ واحدٍ ، فقلتُ : ربِّ خفِّفْ عن أُمتي ، قال : ثم جاء الثالثةَ ، فقال : إنَّ ربَّك يأمرك أن تقرأَ القرآنَ على حرفٍ واحدٍ ، فقلتُ : ربِّ خفِّفْ عن أمتي ، قال : ثم جاءني الرابعةَ ، فقال : إنَّ ربَّك يأمرك أن تقرأَ القرآنَ على سبعةِ أحرفٍ ، ولك بكلِّ ردَّة مسألةٌ ، قال : قلتُ : ربِّ اغفرْ لأمتي ، ربِّ اغفرْ لأمتي ، واختبأتُ الثالثةَ شفاعةً لأمتي ، حتى إنَّ إبراهيمَ صلَّى اللهُ عليهِ وسلَّمَ خليلَ الرحمنِ لَيرغِّبُ فيها"],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"ثابت","bab":"قرآن › الاختلاف والمراء في القرآن","dorar":"k7kl9mCt"},{"id":"س-00231","fp":"a322f1ead2ed","stateId":49,"easy":"إذا ملكت نفسك عند الغضب ← فأنت القوي حقاً","cause":"الرجلُ الذي يَمْلِكُ نفسَهُ عندَ الغَضَبِ","result":"إِنَّ الشَّدِيدَ كلَّ الشَّدِيدِ","explicit":true,"star":true,"similar":["س-04168"],"otherNeedIds":[47],"ref":"صحيح الترغيب 886","srcLabel":"البيهقي","text":["جَلَسْنا إلى رجلٍ من أصحابِ النبيِّ يقالُ لهُ : خصفَةُ ( أوْ ) ابنُ خصفَةَ ، فَجعلَ ينظرُ إلى رجلٍ سَمِينٍ ، فقُلْتُ : ما تنْظُرُ إليهِ ؟ فقال : ذَكَرْتُ حديثًا سَمِعْتُهُ من رسولِ اللهِ ، سَمِعْتُهُ يقولُ : هل تَدْرُونَ ما الشَّدِيدُ ؟ قُلْنا : الرجلُ يَصْرَعُ الرجلَ . قال : ",["إِنَّ الشَّدِيدَ كلَّ الشَّدِيدِ",2]," : ",["الرجلُ الذي يَمْلِكُ نفسَهُ عندَ الغَضَبِ",1]," . تَدْرُونَ ما الرَّقُوبُ ؟ . قُلْنا الرجلُ الذي لا يُولَدُ لهُ . قال : إِنَّ الرَّقُوبَ : الرجلُ الذي لهُ الولدُ ، و لمْ يُقَدِّمْ مِنْهُمْ شيئًا"],"grade":"صحيح","narrator":"خصفة أو ابن خصفة","muhaddith":"صحيح لغيره","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (3341)، والخطيب البغدادي في ((المتفق والمفترق)) (1567) بلفظ قريب.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"s5gW2MYK","merged":3,"otherRefs":["مجموع الفتاوى 7/341 (صحيح)","صحيح مسلم 2609 (صحيح)"]},{"id":"س-00230","fp":"97ce3055d8d6","stateId":49,"easy":"إذا غلبت نفسك ← فأنت القوي الشديد حقاً","cause":"مَنْ غَلَبَ نفسَهُ","result":"إِنَّما الشَّدِيدُ","explicit":true,"otherNeedIds":[47],"ref":"صحيح الترغيب 2750","srcLabel":"النسائي","text":["ليس الشَّدِيدُ مَنْ غَلَبَ الناسَ ",["إِنَّما الشَّدِيدُ",2]," ",["مَنْ غَلَبَ نفسَهُ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10229)، والطيالسي (2648)، والطحاوي في ((شرح مشكل الآثار)) (1645) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"160L3ilp"},{"id":"س-00269","fp":"ced39efd57fc","stateId":49,"easy":"إذا اشتد غضبك فغلبته ← فأنت الشديد حقاً","cause":"الرَّجُلُ يَغضَبُ فيَشتَدُّ غَضَبُه، ويَحمَرُّ وَجْهُه، ويَقشَعِرُّ شَعَرُه، فيَصرَعُ غَضَبَه","result":"الصُّرَعةُ كُلُّ الصُّرَعةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[47],"ref":"تخريج المسند لشعيب 23115","srcLabel":"أحمد","text":["عن رَجُلٍ شَهِدَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَخطُبُ فقال: تَدْرونَ ما الرَّقوبُ؟ قالوا: الذي لا وَلَدَ له، فقال: الرَّقوبُ كُلُّ الرَّقوبِ، الرَّقوبُ كُلُّ الرَّقوبِ، الرَّقوبُ كُلُّ الرَّقوبِ: الذي له وَلَدٌ فماتَ ولم يُقدِّمْ منهم شَيئًا، قال: تَدْرونَ ما الصُّعلوكُ؟ قالوا: الذي ليس له مالٌ، قال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: الصُّعلوكُ كُلُّ الصُّعلوكِ، الصُّعلوكُ كُلُّ الصُّعلوكِ: الذي له مالَ فماتَ ولم يُقدِّمْ منه شَيئًا. قال: ثم قال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ما الصُّرَعةُ؟ قال: قالوا: الصَّريعُ، قال: فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["الصُّرَعةُ كُلُّ الصُّرَعةِ",2],"، الصُّرَعةُ كُلُّ الصُّرَعةِ: ",["الرَّجُلُ يَغضَبُ فيَشتَدُّ غَضَبُه، ويَحمَرُّ وَجْهُه، ويَقشَعِرُّ شَعَرُه، فيَصرَعُ غَضَبَه",1],"."],"grade":"صحيح","narrator":"رجال من الصحابة","muhaddith":"صحيح لغيره دون قصة الصعلوك","takhrij":"أخرجه أحمد (23115)","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"w4wwUFDS","merged":2,"otherRefs":["الجامع الصغير 5132 (صحيح)"]},{"id":"س-04168","fp":"1c43a18eae2c","stateId":49,"easy":"إذا ملكت نفسك عند الغضب ← فأنت الصُّرَعة (القوي) حقاً","cause":"الَّذي يَمْلِكُ نَفْسَهُ عِنْدَ الغَضَبِ","result":"فَما تَعُدُّونَ الصُّرَعَةَ فِيكُمْ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-00231","otherNeedIds":[47,16],"ref":"صحيح الجامع 3556","text":["[حديث أبي هريرة: الرَّقوبُ الذي لا فرَطَ له]            [وحديث عبدالله بن مسعود: ما تَعُدُّونَ الرَّقُوبَ فِيكُمْ؟ قالَ: قُلْنا: الَّذي لا يُولَدُ له، قالَ: ليسَ ذاكَ بالرَّقُوبِ، ولَكِنَّهُ الرَّجُلُ الَّذي لَمْ يُقَدِّمْ مِن ولَدِهِ شيئًا، قالَ: ",["فَما تَعُدُّونَ الصُّرَعَةَ فِيكُمْ",2],"؟ قالَ قُلْنا: الَّذي لا يَصْرَعُهُ الرِّجالُ، قالَ: ليْسَ بذلكَ، ولَكِنَّهُ ",["الَّذي يَمْلِكُ نَفْسَهُ عِنْدَ الغَضَبِ",1],".]"],"grade":"صحيح","narrator":"أبو هريرة وابن مسعود","muhaddith":"صحيح","bab":"جنائز وموت › موت الأولاد وفضل احتسابهم","dorar":"ZzHuNzfm","merged":2,"otherRefs":["السلسلة الصحيحة 7/870 (حسن)"]}]}