{"schema":1,"kind":"sunan-chunk","version":"sunan-cb5af5731a1c","needId":66,"stateIds":[674,675,676,677,678,679,680,681,682,683,684,685,686],"items":[{"id":"س-08434","fp":"00d478a86a2b","stateId":674,"easy":"إذا عبدت الله ولم تشرك به ← فحقك على الله ألا يعذبك","cause":"أن يَعبُدوه ولا يُشرِكوا به شيئًا","result":"حَقُّ العِبادِ على اللهِ أن لا يُعَذِّبَهم","explicit":true,"star":true,"similar":["س-00153"],"ref":"صحيح البخاري 5967","srcLabel":"متفق عليه","text":["بينا أنا رَديفُ النَّبيِّ صلَّى اللهُ عليه وسلَّم ليس بَيني وبينَه إلَّا آخِرةُ الرَّحلِ، فقال: يا مُعاذُ بنَ جَبَلٍ، قُلتُ: لَبَّيكَ رَسولَ اللهِ وسَعدَيكَ، ثُمَّ سارَ ساعةً، ثُمَّ قال: يا مُعاذُ، قُلتُ: لَبَّيكَ رَسولَ اللهِ وسَعدَيكَ، ثُمَّ سارَ ساعةً، ثُمَّ قال: يا مُعاذُ، قُلتُ: لَبَّيكَ رَسولَ اللهِ وسَعدَيكَ، قال: هل تَدري ما حَقُّ اللهِ على عِبادِه؟ قُلتُ: اللهُ ورَسولُه أعلَمُ، قال: حَقُّ اللهِ على عِبادِه ",["أن يَعبُدوه ولا يُشرِكوا به شيئًا",1],"، ثُمَّ سارَ ساعةً، ثُمَّ قال: يا مُعاذُ بنَ جَبَلٍ، قُلتُ: لَبَّيكَ رَسولَ اللهِ وسَعدَيكَ، فقال: هل تَدري ما حَقُّ العِبادِ على اللهِ إذا فعَلوه؟ قُلتُ: اللهُ ورَسولُه أعلَمُ، قال: ",["حَقُّ العِبادِ على اللهِ أن لا يُعَذِّبَهم",2],"."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5967)، ومسلم (30)","bab":"مناقب وفضائل › معاذ بن جبل","dorar":"mk53e11W","merged":6,"otherRefs":["تخريج المسند لشاكر 15/220 (صحيح)","تخريج المسند لشعيب 10918 (صحيح)","تخريج المسند لشعيب 21993 (صحيح)","تخريج المسند لشعيب 13742 (صحيح)","حلية الأولياء 8/127 (صحيح)"]},{"id":"س-01241","fp":"fda8934ccda5","stateId":674,"easy":"إذا قلت «لا إله إلا الله» حقاً من قلبك ومت على ذلك ← تُحرّم على النار","cause":"لا يَقولُها عَبْدٌ حَقًّا مِن قَلْبِه يَموتُ على ذلك","result":"إلَّا حُرِّمَ على النَّارِ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"similar":["س-02472","س-02469","س-02424","س-02383","س-02396","س-02408","س-02442"],"ref":"الأحاديث المختارة 249","srcLabel":"أحمد","text":["«أنَّ أبا بَكْرٍ أتى على عُثْمانَ، فسلَّمَ عليه فرَدَّ عليه رَدًّا ضَعيفًا فذَكَرَ ذلك لعُمَرَ، وقالَ: أتَيْتُ عليه فسَلَّمْتُ عليه فرَدَّ علَيَّ رَدًّا ضَعيفًا كأنَّه كَرِهَ ما كانَ مِن أمْري، قالَ: فلَقِيَه عُمَرُ، فذَكَرَ ذلك له فقالَ: إنَّه لأَحَقُّ النَّاسِ بها إنَّه لَلصِّدِّيقُ وإنَّه ثاني اثْنَينِ، ولكنَّه أتى علَيَّ وأنا أُحَدِّثُ نفْسي بشيءٍ سَمِعْتُه مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، تُوفِّيَ نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّم قَبْلَ أن يُبَيِّنَ لنا، قالَ: وما ذاك؟ قالَ: سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: إنِّي لأَعلَمُ كَلِمةً ",["لا يَقولُها عَبْدٌ حَقًّا مِن قَلْبِه يَموتُ على ذلك",1]," ",["إلَّا حُرِّمَ على النَّارِ",2],"، قالَ عُمَرُ: أنا أُنْبيك بها: شَهادةُ أنْ لا إلهَ إلَّا اللهُ، وهي الكَلِمةُ الَّتي أمَرَ نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّم عَمَّه أن يَقولَها عنْدَ مَوْتِه، فأبى عليه، وهي الكَلِمةُ الَّتي أُلْزِمَها مُحَمَّدٌ وأصْحابُه؛ شَهادةُ أنْ لا إلهَ إلَّا اللهُ»."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"LgnVd2HI","merged":3,"otherRefs":["تخريج المسند لشاكر 1/221 (صحيح)","المستدرك على الصحيحين 1316 (صحيح)"]},{"id":"س-01695","fp":"879d374f9522","stateId":674,"easy":"إذا وافيت يوم القيامة تقول «لا إله إلا الله» تبتغي وجه الله ← حُرّمت على النار","cause":"فلَنْ يُوافيَ عَبدٌ يومَ القِيامةِ، يقولُ: لا إلهَ إلَّا اللهُ يَبتَغي بذلك وَجْهَ اللهِ","result":"إلَّا حُرِّمَ على النارِ","explicit":true,"star":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"similar":["س-01223"],"ref":"تخريج المسند لشعيب 23770","srcLabel":"متفق عليه","text":["أتَيتُ النبيَّ صلَّى اللهُ عليه وسَلَّمَ فقُلتُ: إنِّي قد أنكَرْتُ بَصَري، والسُّيولُ تَحولُ بَيْني وبَينَ مَسْجِدي، فلَوَدِدتُ أنَّكَ جِئتَ فصَلَّيتَ في بَيْتي مَكانًا أتَّخِذُه مَسجِدًا، فقال النبيُّ صلَّى اللهُ عليه وسَلَّمَ: أفْعَلُ إنْ شاءَ اللهُ، قال: فمَرَّ على أبي بَكرٍ فاستَتْبَعَه، فانطَلَقَ معَه، فاسْتَأذَنَ فدَخَلَ علَيَّ، فقال وهو قائِمٌ: أين تُريدُ أنْ أُصَلِّيَ؟ فأشَرْتُ له حيثُ أُريدُ، قال: ثُمَّ حَبَستُه على خَزيرٍ صَنَعْناه له، فسَمِعَ أهْلُ الوادي، يَعْني أهْلَ الدارِ، فثابوا إليه، حتى امْتَلَأ البَيتُ، فقال رَجُلٌ: أين مالِكُ بنُ الدُّخْشُنِ؟ ورُبَّما قال: مالِكُ بنُ الدُّخَيْشِنِ، فقال رَجُلٌ: ذاك رَجُلٌ مُنافِقٌ لا يُحِبُّ اللهَ ولا رسولَه، فقال النبيُّ صلَّى اللهُ عليه وسَلَّمَ: ألَا تقولُ: هو يقولُ: لا إلهَ إلَّا اللهُ يَبتَغي بذلك وَجْهَ اللهِ، قال: يا رسولَ اللهِ، أمَّا نحن فنَرى وَجْهَه وحَديثَه إلى المُنافِقينَ، فقال النبيُّ صلَّى اللهُ عليه وسَلَّمَ أيضًا: لا تقولُ: هو يقولُ: لا إلهَ إلَّا اللهُ يَبتَغي بذلك وَجْهَ اللهِ، قال: بَلى يا رسولَ اللهِ، قال: ",["فلَنْ يُوافيَ عَبدٌ يومَ القِيامةِ، يقولُ: لا إلهَ إلَّا اللهُ يَبتَغي بذلك وَجْهَ اللهِ",1]," ",["إلَّا حُرِّمَ على النارِ",2],". قال مَحمودٌ: فحَدَّثتُ بهذا الحَديثِ نَفَرًا، فيهم أبو أيُّوبَ الأنصاريُّ فقال: ما أظُنُّ رسولَ اللهِ صلَّى اللهُ عليه وسَلَّمَ قال ما قُلتَ، قال: فآلَيتُ إنْ رَجَعتُ إلى عِتْبانَ أنْ أسْألَه، فرَجَعتُ إليه فوَجَدتُه شَيخًا كَبيرًا قد ذَهَبَ بَصَرُه وهو إمامُ قَومِه، فجَلَستُ إلى جَنْبِه، فسَألْتُه عن هذا الحديثِ فحَدَّثَنيه كما حدَّثَنيه أوَّلَ مرَّةٍ! قال مَعمَرٌ: فكان الزُّهْريُّ إذا حَدَّثَ بهذا الحديثِ قال: ثم نَزَلَتْ فَرائِضُ وأُمورٌ نَرى أنَّ الأمرَ انتَهى إليها؛ فمَنِ استَطاعَ ألَّا يَغتَرَّ فلا يَغتَرَّ."],"grade":"صحيح","narrator":"عتبان بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين.","takhrij":"أخرجه البخاري (686) مختصراً، ومسلم (33)، والنسائي (1327)، وابن ماجه (754) بنحوه، وأحمد (23770) واللفظ له","bab":"أقضية وأحكام › الحكم بالظاهر","dorar":"cLK95kGS","merged":3,"otherRefs":["صحيح البخاري 6423 (صحيح)","تخريج المسند لشعيب 16482 (صحيح)"]},{"id":"س-02386","fp":"0bf4b5106985","stateId":674,"easy":"إذا شهدت الشهادتين صادقاً ← لا تدخل النار","cause":"لا يَشهَدُ أحَدٌ أن لا إلَهَ","result":"إلَّا اللهُ، وأنِّي رَسولُ اللهِ، فيَدخُلَ النَّارَ أو تَطعَمَه","explicit":true,"star":true,"ref":"صحيح مسلم 33","srcLabel":"البخاري","text":["عن أنَسِ بنِ مالكٍ، قال: حدَّثني محمودُ بنُ الرَّبيعِ، عن عِتبانَ بنِ مالكٍ، قال: قَدِمتُ المدينةَ فلَقِيتُ عِتبانَ فقُلتُ: حديثٌ بَلَغَني عنك، قال: أصابَني في بَصَري بَعضُ الشَّيءِ، فبَعَثتُ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم أنِّي أُحِبُّ أن تَأتيَني فتُصَلِّيَ في مَنزِلي، فأتَّخِذَه مُصَلًّى، قال: فأتى النَّبيُّ صلَّى اللهُ عليه وسلَّم، ومَن شاءَ اللهُ مِن أصحابِه، فدَخَلَ وهو يُصَلِّي في مَنزِلي وأصحابُه يَتَحَدَّثونَ بينَهم، ثُمَّ أسنَدوا عُظمَ ذلك وكُبرَه إلى مالِكِ بنِ دُخشُمٍ، قالوا: ودُّوا أنَّه دَعا عليه فهَلَك، ودُّوا أنَّه أصابَه شَرٌّ، فقَضى رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم الصَّلاةَ، وقال: أليسَ يَشهَدُ أن لا إلَهَ إلَّا اللهُ، وأنِّي رَسولُ اللهِ؟ قالوا: إنَّه يقولُ ذلك، وما هو في قَلبِه، قال: ",["لا يَشهَدُ أحَدٌ أن لا إلَهَ",1]," ",["إلَّا اللهُ، وأنِّي رَسولُ اللهِ، فيَدخُلَ النَّارَ أو تَطعَمَه",2],". قال أنَسٌ: فأعجَبَني هذا الحَديثَ، فقُلتُ لابني: اكتُبْه، فكَتَبَه."],"grade":"صحيح","narrator":"عتبان بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5401)، وابن حبان (223)، والطبراني (18/ 31) (53) جميعا بلفظ مقارب .","bab":"إسلام › فضل الشهادتين","dorar":"rQ7HuRF3","merged":2,"otherRefs":["تخريج المسند لشعيب 23771 (صحيح)"]},{"id":"س-01223","fp":"8776c537c7a4","stateId":674,"easy":"إذا قلت «لا إله إلا الله» تبتغي بذلك وجه الله ← فقد حرّم الله عليك النار","cause":"مَن قال: لا إلَهَ إلَّا اللهُ، يَبتَغي بذلك وجهَ اللهِ","result":"فإنَّ اللهَ قد حَرَّمَ على النَّارِ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-01695","ref":"صحيح البخاري 1186","text":["كُنتُ أُصَلِّي لقَومي ببَني سالِمٍ، وكان يَحولُ بَيني وبينَهم وادٍ إذا جاءَتِ الأمطارُ، فيَشُقُّ عليَّ اجتيازُه قِبَلَ مَسجِدِهم، فجِئتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فقُلتُ له: إنِّي أنكَرتُ بَصَري، وإنَّ الواديَ الذي بَيني وبينَ قَومي يَسيلُ إذا جاءَتِ الأمطارُ، فيَشُقُّ عليَّ اجتيازُه، فودِدتُ أنَّكَ تَأتي فتُصَلِّي مِن بَيتي مَكانًا، أتَّخِذُه مُصَلًّى، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: سَأفعَلُ. فغَدا عليَّ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم وأبو بَكرٍ رَضيَ اللهُ عنه بَعدَ ما اشتَدَّ النَّهارُ، فاستَأذَنَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فأذِنتُ له، فلَم يَجلِسْ، حتَّى قال: أينَ تُحِبُّ أن أُصَلِّيَ مِن بَيتِكَ؟ فأشَرتُ له إلى المَكانِ الذي أُحِبُّ أن أُصَلِّيَ فيه، فقامَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم فكَبَّرَ، وصَفَفنا وراءَه، فصَلَّى رَكعَتَينِ، ثُمَّ سَلَّمَ وسَلَّمنا حينَ سَلَّمَ، فحَبَستُه على خَزيرٍ يُصنَعُ له، فسَمِعَ أهلُ الدَّارِ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم في بَيتي، فثابَ رِجالٌ منهم حتَّى كَثُرَ الرِّجالُ في البَيتِ، فقال رَجُلٌ منهم: ما فعَلَ مالِكٌ؟ لا أراه. فقال رَجُلٌ منهم: ذاكَ مُنافِقٌ لا يُحِبُّ اللهَ ورَسولَه، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: لا تَقُلْ ذاكَ؛ ألا تَراه قال: لا إلَهَ إلَّا اللهُ، يَبتَغي بذلك وجهَ اللهِ، فقال: اللهُ ورَسولُه أعلَمُ، أمَّا نَحنُ فواللهِ لا نَرى وُدَّه ولا حَديثَه إلَّا إلى المُنافِقينَ، قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["فإنَّ اللهَ قد حَرَّمَ على النَّارِ",2]," ",["مَن قال: لا إلَهَ إلَّا اللهُ، يَبتَغي بذلك وجهَ اللهِ",1],". قال مَحمودُ بنُ الرَّبيعِ: فحَدَّثتُها قَومًا فيهم أبو أيُّوبَ صاحِبُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوتِه التي توفِّيَ فيها، ويَزيدُ بنُ مُعاويةَ عليهم بأرضِ الرُّومِ، فأنكَرَها عليَّ أبو أيُّوبَ، قال: واللهِ ما أظُنُّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: ما قُلتَ قَطُّ، فكَبُرَ ذلك عليَّ، فجَعَلتُ للهِ عليَّ إن سَلَّمَني حتَّى أقفُلَ مِن غَزوتي أن أسألَ عَنها عِتبانَ بنَ مالِكٍ رَضيَ اللهُ عنه، إن وجَدتُه حَيًّا في مَسجِدِ قَومِه، فقَفَلتُ، فأهلَلتُ بحَجَّةٍ أو بعُمرةٍ، ثُمَّ سِرتُ حتَّى قدِمتُ المَدينةَ، فأتَيتُ بَني سالِمٍ، فإذا عِتبانُ شيخٌ أعمى يُصَلِّي لقَومِه، فلَمَّا سَلَّمَ مِنَ الصَّلاةِ سَلَّمتُ عليه وأخبَرتُه مَن أنا، ثُمَّ سَألتُه عن ذلك الحَديثِ، فحدَّثَنيه كما حدَّثَنيه أوَّلَ مَرَّةٍ."],"grade":"صحيح","narrator":"عتبان بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (33)، وابن المبارك في ((الزهد والرقائق)) (920)، وابن خزيمة في ((التوحيد)) (2/ 784)، واللفظ لهم، والنسائي (1327) بلفظه مختصرا.","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"f3VW5vk2","merged":3,"otherRefs":["التمهيد 10/158 (صحيح)","صحيح ابن خزيمة 3/ 149 (صحيح)"]},{"id":"س-00153","fp":"556a2dcf9281","stateId":674,"easy":"إذا عبدت الله ولم تشرك به شيئاً ← فحقك على الله ألا يعذبك","cause":"أن يُعبَدَ اللهُ ولا يُشرَكَ به شيءٌ","result":"أن لا يُعَذِّبَهم","explicit":true,"repOf":"س-08434","ref":"صحيح مسلم 30","text":["يا مُعاذُ، أتَدري ما حَقُّ اللهِ على العِبادِ؟ قال: اللهُ ورَسولُه أعلَمُ، قال: ",["أن يُعبَدَ اللهُ ولا يُشرَكَ به شيءٌ",1],"، قال: أتَدري ما حَقُّهم عليه إذا فعَلوا ذلك؟ فقال: اللهُ ورَسولُه أعلَمُ، قال: ",["أن لا يُعَذِّبَهم",2],". وفي روايةٍ: دَعاني رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فأجَبتُه، فقال: هل تَدري ما حَقُّ اللهِ على النَّاسِ؟ نَحوَ حَديثِهم."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7373) باختلاف يسير دون الرواية المذكورة","bab":"آداب السلام › الإجابة بلبيك وسعديك","dorar":"T3YzgeRP"},{"id":"س-02472","fp":"ed34d616a451","stateId":674,"easy":"إذا شهدت أن لا إله إلا الله مخلصاً فمت على ذلك ← حرّمك الله على النار","cause":"مَن شَهِدَ أنْ لا إلهَ إلَّا اللهُ مُخلِصًا بها، فيَموتُ على ذلك","result":"حَرَّمَه اللهُ عَزَّ وجَلَّ على النَّارِ","explicit":true,"repOf":"س-01241","ref":"الأحاديث المختارة 2701","text":["«",["مَن شَهِدَ أنْ لا إلهَ إلَّا اللهُ مُخلِصًا بها، فيَموتُ على ذلك، ",1],["حَرَّمَه اللهُ عَزَّ وجَلَّ على النَّارِ»",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إسلام › فضل الشهادتين","dorar":"0UViHqqb"},{"id":"س-08436","fp":"877dda6d2d0a","stateId":674,"easy":"إذا شهدت الشهادتين صدقاً من قلبك ← يحرمك الله على النار","cause":"ما مِن أحَدٍ يَشهَدُ أن لا إلَهَ","result":"إلَّا اللهُ وأنَّ مُحَمَّدًا رَسولُ اللهِ، صِدقًا مِن قَلبِه، إلَّا حَرَّمَه اللهُ على النَّارِ","explicit":true,"similar":["س-02426"],"ref":"صحيح البخاري 128","srcLabel":"مسلم","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم، ومُعاذٌ رَديفُه على الرَّحلِ، قال: يا مُعاذَ بنَ جَبَلٍ، قال: لَبَّيكَ يا رَسولَ اللهِ، وسَعدَيكَ، قال: يا مُعاذُ، قال: لَبَّيكَ يا رَسولَ اللهِ، وسَعدَيكَ ثَلاثًا، قال: ",["ما مِن أحَدٍ يَشهَدُ أن لا إلَهَ",1]," ",["إلَّا اللهُ وأنَّ مُحَمَّدًا رَسولُ اللهِ، صِدقًا مِن قَلبِه، إلَّا حَرَّمَه اللهُ على النَّارِ",2],"، قال: يا رَسولَ اللهِ، أفلا أُخبِرُ به النَّاسَ فيَستَبشِروا؟ قال: إذًا يَتَّكِلوا، وأخبَرَ بها مُعاذٌ عِندَ مَوتِه تَأثُّمًا."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (32) بلفظه، وأحمد (13742) بلفظ مقارب، والنسائي في الكبرى (10906) مختصرا.","bab":"مناقب وفضائل › معاذ بن جبل","dorar":"Ley2Nq9E","merged":2,"otherRefs":["صحيح مسلم 32 (صحيح)"]},{"id":"س-02461","fp":"3a351740020e","stateId":674,"easy":"إذا وافيت بها يوم القيامة ← يحرّم الله عليك النار","cause":"لا يوافى عَبدٌ يَومَ القيامةِ به","result":"إلَّا حَرَّمَ اللهُ عليه النَّارَ","explicit":true,"ref":"صحيح البخاري 6938","srcLabel":"مسلم","text":["غَدا عليَّ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فقال رَجُلٌ: أينَ مالِكُ بنُ الدُّخشُنِ؟ فقال رَجُلٌ مِنَّا: ذلك مُنافِقٌ، لا يُحِبُّ اللهَ ورَسولَه، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ألا تَقولوه: يقولُ لا إلَهَ إلَّا اللهُ، يَبتَغي بذلك وجهَ اللهِ، قال: بَلى، قال: فإنَّه ",["لا يوافى عَبدٌ يَومَ القيامةِ به",1]," ",["إلَّا حَرَّمَ اللهُ عليه النَّارَ",2],"."],"grade":"صحيح","narrator":"عتبان بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (33)، وأحمد (16482)، وابن حبان (223) جميعا مطولا بنحوه.","bab":"إسلام › فضل الشهادتين","dorar":"TEZtmenA"},{"id":"س-02469","fp":"da5c5216454d","stateId":674,"easy":"إذا شهدت أن لا إله إلا الله وأن محمداً رسول الله ← لن تطعمك النار","cause":"مَن شهِدَ أنْ لا إلهَ إلَّا اللهُ، وأنِّي رسولُ اللهِ","result":"فلن تَطعَمَه النَّارُ","explicit":true,"repOf":"س-01241","ref":"تخريج المسند لشعيب 12384","text":["أنَّ عِتْبانَ اشْتَكى عيْنَه، فبعَثَ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فذكَرَ له ما أَصابَه، وقال: يا رسولَ اللهِ، تعالَ صلِّ في بَيْتي، حتى أتَّخِذَه مُصلًّى، قال: فجاءَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ومَن شاءَ اللهُ من أصحابِه، فقامَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يُصلِّي وأصحابُه يتحدَّثونَ بينهم، فجعَلوا يذكُرونَ ما يَلْقَونَ منَ المُنافقينَ، فأَسنَدوا عِظَمَ ذلك إلى مالِكِ بنِ دُخَيْشَمٍ، فانصرَفَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ وقال: أليس يَشهَدُ أنْ لا إلهَ إلَّا اللهُ، وأنِّي رسولُ اللهِ؟ فقال قائلٌ: بَلى، وما هو من قَلبِه، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["مَن شهِدَ أنْ لا إلهَ إلَّا اللهُ، وأنِّي رسولُ اللهِ، ",1],["فلن تَطعَمَه النَّارُ، ",2],"أو قال: لن يدخُلَ النَّارَ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10944)، وأحمد (12384) واللفظ له","bab":"إسلام › فضل الشهادتين","dorar":"nEqbUZnG"},{"id":"س-02426","fp":"cb36d788b506","stateId":674,"easy":"إذا شهدت بالشهادتين صادقاً من قلبك ثم مت ← حُرّمت على النار","cause":"لا يشهَدُ بهما عبدٌ صادقًا من قلبِه ثمَّ يموتُ","result":"إلَّا حُرِّم على النَّارِ","explicit":true,"repOf":"س-08436","ref":"الإصابة في تمييز الصحابة 3/386","text":["أنَّ عتبانَ بنَ مالكٍ أُصيب بصرُه في عهدِ النَّبيِّ صلَّى اللهُ عليه وآلِه وسلَّم فأرسل إلى رسولِ اللهِ صلَّى اللهُ عليه وآلِه وسلَّم فقال : إنِّي أحبُّ أن تُصلِّيَ في مسجدي فأتاه ، فذكروا مالكَ بنَ الدُّخشُمِ فقال النَّبيُّ صلَّى اللهُ عليه وآلِه وسلَّم : أليس يشهَدُ أن لا إلهَ إلَّا اللهُ وأنَّ محمَّدًا عبدُه ورسولُه ؟ قالوا : بلَى ، قال : ",["لا يشهَدُ بهما عبدٌ صادقًا من قلبِه ثمَّ يموتُ",1]," ",["إلَّا حُرِّم على النَّارِ",2]],"grade":"حسن","narrator":"محمود بن عمير بن سعد الأنصاري","muhaddith":"رجاله ثقات","takhrij":"أخرجه أخرجه ابن شاهين كما في ((الإصابة)) (6/ 34) بلفظه، والبخاري (425)، ومسلم (33) باختلاف يسير.","bab":"إسلام › فضل الشهادتين","dorar":"nfb9SgkY"},{"id":"س-02424","fp":"2e328f9288e1","stateId":674,"easy":"إذا قلت «لا إله إلا الله» ← تنجيك من النار","cause":"لا إلَهَ إلَّا اللَّهُ","result":"تُنجيهم مِنَ النَّارِ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-01241","ref":"الصحيح المسند 293","text":["يدرُسُ الإسلامُ كما يدرُسُ وَشْيُ الثَّوبِ ، حتَّى لا يدري ما صيامٌ ، ولا صلاةٌ ، ولا نسُكٌ ، ولا صدقةٌ ، ولَيُسرى على كتابِ اللَّهِ عزَّ وجلَّ في ليلةٍ ، فلا يَبقى في الأرضِ منهُ آيةٌ ، وتبقى طوائفُ منَ النَّاسِ الشَّيخُ الكبيرُ والعجوزُ ، يقولونَ: أدرَكْنا آباءَنا على هذِهِ الكلمةِ ، ",["لا إلَهَ إلَّا اللَّهُ",1]," ، فنحنُ نقولُها فقالَ لَهُ صلَةُ: ما تُغني عنهم: لا إلَهَ إلَّا اللَّهُ ، وَهُم لا يَدرونَ ما صلاةٌ ، ولا صيامٌ ، ولا نسُكٌ ، ولا صدقةٌ ؟ فأعرضَ عنهُ حُذَيْفةُ ، ثمَّ ردَّها عليهِ ثلاثًا ، كلَّ ذلِكَ يُعرِضُ عنهُ حُذَيْفةُ ، ثمَّ أقبلَ عليهِ في الثَّالثةِ ، فقالَ: يا صِلةُ ، ",["تُنجيهم مِنَ النَّارِ",2]," ثلاثًا ."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح","bab":"إسلام › فضل الشهادتين","dorar":"1uUv612F","merged":2,"otherRefs":["المستدرك على الصحيحين 8766 (صحيح)"]},{"id":"س-02467","fp":"1fd573336152","stateId":674,"easy":"إذا قلتها صادقاً ← حُرّمت عليك النار","cause":"لا يقولُها عَبدٌ صادقٌ بها","result":"إلَّا حُرِّمَتْ عليه النَّارُ","explicit":true,"ref":"تخريج المسند لشعيب 12788","srcLabel":"النسائي","text":["[عن] أبي بكر بن أنس بن مالك، قال: أنَّ عِتْبانَ بنَ مالِكٍ ذهَبَ بصَرُهُ، فقال: يا رسولَ اللهِ، لو جِئتَ صَلَّيتَ في داري -أو قال: في بَيْتي- لاتَّخَذتُ مُصلَّاكَ مسجِدًا، فجاءَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ فصَلَّى في دارِهِ -أو قال: في بَيْتِه- واجتَمَعَ قومُ عِتْبانَ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، قال: فذَكَروا مالكَ بنَ الدُّخْشُمِ، فقالوا: يا رسولَ اللهِ، إنَّه وإنَّه؛ يُعرِّضون بالنِّفاقِ، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: أليس يَشهَدُ أنْ لا إلهَ إلَّا اللهُ، وأنِّي رسولُ اللهِ؟ قالوا: بلى، قال: والذي نفسي بيَدِه، ",["لا يقولُها عَبدٌ صادقٌ بها",1]," ",["إلَّا حُرِّمَتْ عليه النَّارُ",2],"."],"grade":"صحيح","narrator":"عتبان بن مالك","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10944)، وأحمد (12788) واللفظ له","bab":"إسلام › فضل الشهادتين","dorar":"wo7GI8Cw","merged":2,"otherRefs":["التمهيد 10/159 (صحيح)"]},{"id":"س-00845","fp":"b4f017508618","stateId":674,"easy":"إذا قلت «لا إله إلا الله» ← تنجيك يوماً من دهرك ولو أصابك قبله ما أصابك","cause":"مَن قالَ : لا إلَهَ إلا اللَّهُ","result":"أنجَتهُ يومًا مِن دَهْرِهِ ، أصابَهُ قبلَ ذلِكَ ما أصابَهُ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"ref":"السلسلة الصحيحة 1932","srcLabel":"الطبراني","text":[["مَن قالَ : \" لا إلَهَ إلا اللَّهُ",1]," \" ",["أنجَتهُ يومًا مِن دَهْرِهِ ، أصابَهُ قبلَ ذلِكَ ما أصابَهُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح رجاله ثقات","takhrij":"أخرجه البزار (8292)، والطبراني في ((المعجم الأوسط)) (6396)، وأبو نعيم في ((حلية الأولياء)) (7/126) باختلاف يسير.","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"FJj3q84N"},{"id":"س-02383","fp":"1557dcbe5b5a","stateId":674,"easy":"إذا شهدت أن لا إله إلا الله وأن محمداً رسول الله ← يحرم الله عليك النار","cause":"مَن شَهِدَ أن لا إلَهَ إلَّا اللهُ، وأنَّ مُحَمَّدًا رَسولُ اللهِ","result":"حَرَّمَ اللهُ عليه النَّارَ","explicit":true,"repOf":"س-01241","ref":"صحيح مسلم 29","text":["عَنِ الصُّنابِحيِّ، عن عُبادةَ بنِ الصَّامِتِ، أنَّه قال: دَخَلتُ عليه وهو في المَوتِ، فبَكَيتُ، فقال: مَهلًا، لمَ تَبكي؟ فواللهِ لَئِنِ استُشهدتُ لأشهَدَنَّ لَك، ولَئِن شُفِّعتُ لأشفَعَنَّ لَك، ولَئِنِ استَطَعتُ لأنفَعَنَّك، ثُمَّ قال: واللهِ ما مِن حَديثٍ سَمِعتُه مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم لكم فيه خَيرٌ إلَّا حَدَّثتُكُموه، إلَّا حَديثًا واحِدًا، وسَوفَ أُحَدِّثُكُموه اليَومَ وقد أُحيطَ بنَفسي، سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، يقولُ: ",["مَن شَهِدَ أن لا إلَهَ إلَّا اللهُ، وأنَّ مُحَمَّدًا رَسولُ اللهِ، ",1],["حَرَّمَ اللهُ عليه النَّارَ",2],"."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (22711)، وابن خزيمة في ((التوحيد)) (2/ 799)، والشاشي في ((المسند)) (1211)، وابن حبان (202) واللفظ لهم جميعا.","bab":"إسلام › فضل الشهادتين","dorar":"6Avk35AV"},{"id":"س-02390","fp":"fa000ada93a3","stateId":674,"easy":"إذا دخلت في حصن «لا إله إلا الله» ← أمنت من عذاب الله","cause":"ومن دخل في حِصني","result":"أمِن من عذابي","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"ref":"حلية الأولياء 3/224","srcLabel":"حلية الأولياء","text":["قال اللهُ عزَّ وجلَّ : إنِّي أنا اللهُ لا إلهَ إلَّا أنا فاعبدوني ، من جاءني منكم بشهادةِ أن لا إلهَ إلَّا اللهُ بالإخلاصِ دخل في حِصني ، ",["ومن دخل في حِصني ",1],["أمِن من عذابي",2]],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"ثابت مشهور بهذا الإسناد","takhrij":"لم نقف عليه إلا عند أبي نعيم في ((حلية الأولياء)) (3/ 191).","bab":"إسلام › فضل الشهادتين","dorar":"GMQlkqGD"},{"id":"س-02396","fp":"995edcdd3842","stateId":674,"easy":"إذا شهدت أن لا إله إلا الله ← يحرمك الله على النار ويوجب لك الجنة","cause":"مَن شهِد أنْ لا إلهَ إلَّا اللهُ","result":"حرَّمه اللهُ على النَّارِ وأوجَب له الجنَّةَ","explicit":true,"repOf":"س-01241","otherNeedIds":[67],"ref":"صحيح ابن حبان 199","text":["بينما نحنُ في سفرٍ مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فجلَس مَن كان بين يدَيْهِ ولحِقه مَن كان خلْفَه حتَّى إذا اجتمَعوا قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( إنَّه ",["مَن شهِد أنْ لا إلهَ إلَّا اللهُ ",1],["حرَّمه اللهُ على النَّارِ وأوجَب له الجنَّةَ )",2]],"grade":"صحيح","narrator":"سهيل بن بيضاء من بني عبدالدار","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (17538)، والطبراني في ((المعجم الكبير)) (6/ 210) (6034)، والحاكم (6646) جميعا بلفظه.","bab":"إسلام › فضل الشهادتين","dorar":"M6YgQhtX"},{"id":"س-02397","fp":"bdfa7ecc800d","stateId":674,"easy":"إذا لقيت الله مؤمناً بالشهادتين ← تحجبانك عن النار يوم القيامة","cause":"لا يلقاه عبدٌ مؤمنٌ بهما","result":"إلَّا حجَبَتاه عن النَّارِ يومَ القيامةِ","explicit":true,"similar":["س-02419","س-02430"],"ref":"صحيح ابن حبان 221","srcLabel":"أحمد","text":["كنَّا مع النَّبيِّ صلَّى اللهُ عليه وسلَّم في غزوةٍ فأصاب النَّاسَ مخمصةٌ شديدةٌ فاستأذَنوا رسولَ اللهِ في نحرِ بعضِ ظَهرِهم فقال عمرُ: يا رسولَ اللهِ فكيف بنا إذا لقينا عدوَّنا جياعًا رجَّالةً ؟ ولكنْ إنْ رأَيْتَ يا رسولَ اللهِ أنْ تدعوَ النَّاسَ ببقيَّةِ أَزْوِدَتِهم فجاؤوا به يجيءُ الرَّجلُ بالحَفنةِ مِن الطَّعامِ وفوقَ ذلك وكان أعلاهم الَّذي جاء بالصَّاعِ مِن التَّمرِ فجمَعه على نِطعٍ ثمَّ دعا اللهَ بما شاء اللهُ أنْ يدعوَ ثمَّ دعا النَّاسَ بأوعيتِهم فما بقي في الجيشِ وعاءٌ إلَّا مملوءٌ وبقي مثلُه فضحِك رسولُ اللهِ صلَّى اللهُ عليه وسلَّم حتَّى بدَتْ نواجذُه ثمَّ قال: ( أشهَدُ أنْ لا إلهَ إلَّا اللهُ وأشهَدُ أنِّي رسولُ اللهِ وأشهَدُ عندَ اللهِ ",["لا يلقاه عبدٌ مؤمنٌ بهما",1]," ",["إلَّا حجَبَتاه عن النَّارِ يومَ القيامةِ )",2]],"grade":"صحيح","narrator":"أبو عمرة الأنصاري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (15449)،  والحاكم (4234)، والبيهقي في ((دلائل النبوة)) (6/ 121) باختلاف يسير.","bab":"إسلام › فضل الشهادتين","dorar":"4qybsm2m"},{"id":"س-02408","fp":"6b379aadd8ba","stateId":674,"easy":"إذا شهدت أن لا إله إلا الله مخلصاً من قلبك ← لم تدخل النار","cause":"مَن شَهِدَ أنْ لا إلهَ إلَّا اللهُ مُخلِصًا مِن قَلبِه -أو يَقينًا مِن قَلبِه","result":"لم يَدخُلِ النَّارَ -أو دَخَلَ الجنَّةَ- وقال مَرَّةً: دَخَلَ الجنَّةَ، ولم تَمَسَّه النَّارُ","explicit":true,"repOf":"س-01241","otherNeedIds":[67],"ref":"تخريج المسند لشعيب 22060","text":["عن جابر بن عبد الله يقول: أخبَرَنا مَن شَهِدَ مُعاذًا حين حَضَرَتْه الوَفاةُ، يقولُ: اكشِفوا عنِّي سَجْفَ القُبَّةِ أُحدِّثْكم حديثًا سَمِعتُه مِن رسولِ اللهِ صَلَّى اللهُ عليه وسلَّمَ -وقال مَرَّةً: أُخبِرْكم بشيءٍ سَمِعتُه مِن رسولِ اللهِ صَلَّى اللهُ عليه وسلَّمَ- لم يَمنَعْني أنْ أُحدِّثَكُموه إلَّا أنْ تَتَّكِلوا، سَمِعتُه يقولُ: ",["مَن شَهِدَ أنْ لا إلهَ إلَّا اللهُ مُخلِصًا مِن قَلبِه -أو يَقينًا مِن قَلبِه- ",1],["لم يَدخُلِ النَّارَ -أو دَخَلَ الجنَّةَ- وقال مَرَّةً: دَخَلَ الجنَّةَ، ولم تَمَسَّه النَّارُ",2],"."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10975)، وابن ماجه (3796) بمعناه، وأحمد (22060) واللفظ له","bab":"إسلام › فضل الشهادتين","dorar":"9ZLlpwku"},{"id":"س-02419","fp":"78b32375dceb","stateId":674,"easy":"إذا لقيت الله بالشهادتين ← حُجبت عنك النار","cause":"أشهَدُ أن لا إلهَ إلَّا اللهُ وأنِّي رسولُ اللهِ، لا يَلقى اللهَ عبدٌ مؤمنٌ بهما","result":"إلَّا حُجِبَتْ عنه النَّارُ يومَ القيامةِ","explicit":true,"repOf":"س-02397","ref":"الصحيح المسند 1242","text":["كنَّا مع رسولِ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّم في غَزاةٍ، فأصاب النَّاسَ مَخمَصةٌ، فاستأذَن النَّاسُ رسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّم في نحرِ بعضِ ظهورِهم وقالوا: يُبلِّغُنا اللهُ به، فلمَّا رأى عمرُ بنُ الخطَّابِ أنَّ رسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّم قد همَّ أن يأذَنَ لهم في نحرِ بعضِ ظهورِهم قال: يا رسولَ اللهِ، كيف بنا إذا نحنُ لقِينا القومَ غدًا رِجَالًا، ولكن إن رأَيْتَ يا رسولَ اللهِ أن تدعوَ لنا ببقايا أزوادِهم، فتجمَعَها، ثمَّ تدعوَ اللهَ فيها بالبركةِ؛ فإنَّ اللهَ تبارَك وتعالى سيُبلِّغُنا بدعوتِك، أو قال: سيُبارِكُ لنا في دعوتِكَ، فدعا النَّبيُّ صلَّى اللهُ عليه وعلى آلِه وسلَّم ببقايا أَزْوادِهم، فجعَل النَّاسُ يَجيئونَ بالحَثْيَةِ مِن الطَّعامِ، وفوقَ ذلكَ، وكان أعلاهم مَن جاء بصاعٍ مِن تمرٍ، فجمَعها رسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّم ثمَّ قام فدعا ما شاء اللهُ أن يدعوَ، ثمَّ دعا الجيشَ بأوعيتِهم، فأمَرهم أن يحتَثُوا، فما بقِيَ في الجيشِ وعاءٌ إلَّا مَلَؤُوه، وبقي مِثلُه، فضحِك رسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّم حتَّى بدَتْ نواجِذُه فقال: ",["أشهَدُ أن لا إلهَ إلَّا اللهُ وأنِّي رسولُ اللهِ، لا يَلقى اللهَ عبدٌ مؤمنٌ بهما",1],", ",["إلَّا حُجِبَتْ عنه النَّارُ يومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"أبو عمرة الأنصاري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (15449)،  والحاكم (4234)، والبيهقي في ((دلائل النبوة)) (6/ 121) باختلاف يسير.","bab":"إسلام › فضل الشهادتين","dorar":"b8PPslsh"},{"id":"س-02430","fp":"98925799acfb","stateId":674,"easy":"إذا لقيت الله مؤمناً بالشهادتين ← حُجبت عنك النار يوم القيامة","cause":"لا يَلْقَى اللهَ عبدٌ يُؤمنُ بهما أيْ الشهادتانِ","result":"إلا حُجِبَتْ عنهُ النارُ يومَ القيامةِ","explicit":true,"repOf":"س-02397","ref":"السلسلة الصحيحة 7/674","text":["كنَّا مع رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ في غزوةٍ . . . ",["لا يَلْقَى اللهَ عبدٌ يُؤمنُ بهما [ أيْ الشهادتانِ",1]," ] ",["إلا حُجِبَتْ عنهُ النارُ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"أبو عمرة الأنصاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن المبارك في ((الزهد)) (917) بلفظه، وعنه أحمد (15449)، والنسائي في ((السنن الكبرى)) (8742) وابن سعد في ((الطبقات الكبرى)) (1/ 180) باختلاف يسير.","bab":"إسلام › فضل الشهادتين","dorar":"HLhvoDb8"},{"id":"س-02431","fp":"a3e98d739973","stateId":674,"easy":"إذا أتيت بكلمة التوحيد محقاً ← يقيك الله حر النار","cause":"لا يأتي بها عبدٌ مُحِقٌّ","result":"إلا وقاه اللهُ حرَّ النارِ","explicit":true,"otherNeedIds":[31],"ref":"البداية والنهاية 6/119","srcLabel":"أبو يعلى","text":["عن عمرَ قال كنا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في غزاةٍ فقلنا يا رسولَ اللهِ إنَّ العدوَّ قد حضر وهم شباعٌ والناسُ جياعٌ فقالت الأنصارُ ألا ننحرُ نواضحَنا فنُطعِمُها الناسَ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ من كان معه فضلُ طعامٍ فلْيَجِيءْ به فجعل الرجلُ يجيءُ بالمُدِّ والصاعِ وأقلَّ وأكثرَ فكان جميعُ ما في الجيش بضعًا وعشرين صاعًا فجلس النبيُّ صلَّى اللهُ عليه وسلَّمَ إلى جنبِه فدعا بالبركةِ فقال النبيُّ صلَّى اللهُ عليه وسلَّمَ خذوا ولا تنتهِبوا فجعل الرجلُ يأخذُ في جرابِه وفي غرارتِه وأخذوا في أوعيتِهم حتى أنَّ الرجلَ ليربِطُ كُمَّ قميصِه فيملؤه ففرغوا والطعامُ كما هو ثَمَّ قال النبيُّ صلَّى اللهُ عليه وسلَّمَ أشهد أن لا إله إلا اللهُ وأني رسولُ اللهِ ",["لا يأتي بها عبدٌ مُحِقٌّ",1]," ",["إلا وقاه اللهُ حرَّ النارِ",2]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"صحيح","takhrij":"أخرجه أبو يعلى (230)، وابن أبي عمر كما في ((إتحاف الخيرة)) (6501) باختلاف يسير، والفريابي في ((دلائل النبوة)) (5) بنحوه.","bab":"إسلام › فضل الشهادتين","dorar":"qg3ges9T"},{"id":"س-05413","fp":"868cc5db83d2","stateId":674,"easy":"إذا كان فيك الإيمان بالله والحب فيه وكراهة الكفر كما تكره النار ← تجد حلاوة الإيمان وتنجو","cause":"إيمانٌ باللهِ ، وحبٌّ في اللهِ ، وأن يُلقى في النارِ فيحترقَ ، أحَبُّ إليه مِن أن يرجِعَ في الكفرِ","result":"ثلاثٌ مَن كُنَّ فيه تحرُمُ عليه النارُ - أو حَرُمَتِ النارُ عليه","explicit":true,"ref":"إتحاف الخيرة المهرة 1/141","srcLabel":"مسدد","text":["رأيتُ ابنَ عُمرَ يصفرُ لحيتَه ، قال : دخَلنا على أنسٍ ، فقُلنا : حدِّثنا ما سمِعتَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم ، يقولُ : قال : سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ، يقولُ : ",["ثلاثٌ مَن كُنَّ فيه تحرُمُ عليه النارُ - أو حَرُمَتِ النارُ عليه - ",2],":",[" إيمانٌ باللهِ ، وحبٌّ في اللهِ ، وأن يُلقى في النارِ فيحترقَ ، أحَبُّ إليه مِن أن يرجِعَ في الكفرِ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسدد كما في ((إتحاف الخيرة المهرة)) للبوصيري (1/141)","bab":"رقائق وزهد › الحب للقاء الله","dorar":"qAvA20Av"},{"id":"س-04201","fp":"20e949d8719f","stateId":674,"easy":"إذا عبدت الله ولم تشرك به ← يدخلك الجنة","cause":"أنْ يَعبُدوه ولا يُشرِكوا به شيئًا","result":"أنْ يُدخِلَهم الجنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشعيب 22073","srcLabel":"متفق عليه","text":["أنَّه رَكِبَ يومًا على حِمارٍ له يُقالُ له: يَعفورُ، رَسَنُه مِن ليفٍ، ثُمَّ قال النَّبيُّ صَلَّى اللهُ عليه وسلَّمَ: اركَبْ يا مُعاذُ، فقُلتُ: سِرْ يا رسولَ اللهِ، فقال: اركَبْ، فرَدِفتُه، فصُرِعَ الحِمارُ بنا، فقام النَّبيُّ صَلَّى اللهُ عليه وسلَّمَ يَضحَكُ، وقُمتُ أذكُرُ مِن نَفْسي أسَفًا، ثُمَّ فَعَلَ ذلك الثَّانيةَ، ثُمَّ الثَّالثةَ، فرَكِبَ وسار بنا الحِمارُ، فأخلَفَ يدَه فضَرَبَ ظَهري بسَوطٍ معه أو عَصًا، ثُمَّ قال: يا مُعاذُ، هل تدري ما حَقُّ اللهِ على العِبادِ؟ فقُلتُ: اللهُ ورسولُه أعلَمُ، قال: فإنَّ حَقَّ اللهِ على العِبادِ ",["أنْ يَعبُدوه ولا يُشرِكوا به شيئًا",1],"، قال: ثُمَّ سار ما شاء اللهُ، ثُمَّ أخلَفَ يدَه فضَرَبَ ظَهري، فقال: يا مُعاذُ، يا ابنَ أُمِّ مُعاذٍ، هل تَدري ما حَقُّ العِبادِ على اللهِ إذا هم فَعَلوا ذلك؟ قُلتُ: اللهُ ورسولُه أعلَمُ، قال: فإنَّ حَقَّ العِبادِ على اللهِ إذا فَعَلوا ذلك ",["أنْ يُدخِلَهم الجنَّةَ",2],"."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح دون القصة في أوله","takhrij":"أخرجه البخاري (2856)، ومسلم (30) مختصراً بلفظ مقارب","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"V4XxPXmp","merged":5,"otherRefs":["تخريج المسند لشعيب 22040 (صحيح)","سبل الهدى والرشاد 7/378 (حسن)","سبل الهدى والرشاد 7/377 (حسن)","تخريج المسند لشعيب 21994 (صحيح)"]},{"id":"س-02394","fp":"a8a2ccccd70a","stateId":674,"easy":"إذا علمت أن الله ربك وأن محمداً نبيه موقناً من قلبك ← يحرّمك الله على النار","cause":"من علِمَ أَنَّ اللَّهَ ربُّهُ وأنِّي نبيُّهُ موقِنًا مِن قلبِه","result":"حرَّمَه اللَّهُ على النَّارِ","explicit":true,"ref":"الجامع الصغير 8841","srcLabel":"الطبراني","text":[["من علِمَ أَنَّ اللَّهَ ربُّهُ وأنِّي نبيُّهُ موقِنًا مِن قلبِه ",1],["حرَّمَه اللَّهُ على النَّارِ",2]],"grade":"حسن","narrator":"عمران بن الحصين","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (253) (18/ 124)، والبزار (3555)، وابن الأعرابي في ((معجمه)) (785) بنحوه.","bab":"إسلام › فضل الشهادتين","dorar":"Sag8eJWX"},{"id":"س-02442","fp":"a1443f461719","stateId":674,"easy":"إذا قلت «لا إله إلا الله» ← تدخل بها الجنة وتنجو بها من النار","cause":"لا إلهَ إلا اللهُ","result":"يدخُلونَ بها الجنةَ ويَنجونَ بها منَ النارِ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-01241","otherNeedIds":[67],"ref":"إتحاف الخيرة المهرة 8/65","text":["يَدرُسُ الإسلامُ كما يَدرُسُ وَشْيُ الثوبِ حتى لا يعلمَ أحدٌ لا صلاةَ  ولا صيامَ  ولا نسكَ  حتى إنَّ الرجلَ والمرأةَ  ليقولانِ: قد كان مَن قبلَنا يقولونَ: ",["لا إلهَ إلا اللهُ",1]," فنحن نقولُ: لا إلهَ إلا اللهُ قال له صِلَةُ : ما تُغني عنهُمْ : لا إلهَ إلا اللهُ ؟ قال: ",["يدخُلونَ بها الجنةَ  ويَنجونَ بها منَ النارِ",2]],"grade":"حسن","narrator":"حذيفة بن اليمان","muhaddith":"رواته ثقات","bab":"إسلام › فضل الشهادتين","dorar":"TlMmlTOS"},{"id":"س-03489","fp":"75e6794e289a","stateId":674,"easy":"إذا تركت دين الباطل ودخلت الإسلام ← لا يعذبك الله في الآخرة","cause":"إن ترَكتُ دِيني ودخلتُ في دِينِكَ","result":"لا يعذبُني اللهُ في الآخرةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"إتحاف الخيرة المهرة 1/90","srcLabel":"أبو يعلى","text":["أتيتُ النبيَّ صلَّى اللهُ عليه وسلَّم أُبايِعُه ، وقلتُ له : على أني ",["إن ترَكتُ دِيني ودخلتُ في دِينِكَ",1]," ",["لا يعذبُني اللهُ في الآخرةِ ؟",2]," قال : نعَم"],"grade":"حسن","narrator":"الجارود العبدي","muhaddith":"إسناده رجاله ثقات","takhrij":"أخرجه أبو يعلى (918)","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"dkvLglgc"},{"id":"س-01253","fp":"d680583af3be","stateId":674,"easy":"إذا عبدت الله ولم تشرك به شيئاً ← فحق على الله ألا يعذبك","cause":"أنْ يَعبدوهُ، ولا يُشرِكوا به شيئًا","result":"وحقٌّ على اللهِ أنْ لا يُعذِّبَ مَنْ لا يُشرِكُ به","explicit":true,"ref":"المستدرك على الصحيحين 1925","srcLabel":"أحمد","text":["كنَّا نَمشي مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في بعضِ حيطانِ المدينةِ، فقالَ: يا أبا هُريرةَ. فقلتُ: لبَّيكَ يا رسولَ اللهِ. فقالَ: إنَّ المُكثرينَ هُم الأقَلُّونَ إلَّا مَنْ قالَ بمالِه هكذا وهكذا، وأَومأَ بيدِه عنْ يمينِهِ وعنْ شِمالِهِ، فقيلَ: ما هُنَّ؟ ثُمَّ قالَ: يا أبا هُريرةَ، ألا أَدُلُّكَ على كَنزٍ مِن كُنوزِ الجنَّةِ؟ قلتُ: بَلى يا رسولَ اللهِ، قالَ: تقولُ لا حَولَ ولا قُوَّةَ إلَّا باللهِ، ولا مَلجأَ، ولا مَنجا مِنَ اللهِ إلَّا إليه.\n ثم قالَ: يا أبا هِرٍّ، تَدري ما حَقُّ اللهِ على العبادِ، وما حقُّ العبادِ على اللهِ؟ قالَ: قلتُ: اللهُ ورسولُه أَعلمُ، قالَ: فإنَّ حقَّ اللهِ على العبادِ ",["أنْ يَعبدوهُ، ولا يُشرِكوا به شيئًا",1],"، ",["وحقٌّ على اللهِ أنْ لا يُعذِّبَ مَنْ لا يُشرِكُ به",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (8085)، وإسحاق في ((مسنده)) (268)، والبيهقي في ((الآداب)) (773) باختلاف يسير.","bab":"أدعية وأذكار › فضل لا حول ولا قوة إلا بالله","dorar":"e2T8PS1l"},{"id":"س-01228","fp":"3de65d6c0ac4","stateId":675,"easy":"إذا قلت «لا إله إلا الله» وفي قلبك من الخير وزن شعيرة ← تخرج من النار","cause":"مَنْ قال : لا إلهَ إلَّا اللهُ ، وكانَ في قلْبِهِ مِنَ الخيرِ ما يزِنُ شعيرةً","result":"فيخرَجُ مِنَ النارِ","explicit":true,"star":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"similar":["س-01229","س-02447","س-01513","س-02407","س-01237","س-01222","س-01234","س-07883","س-00539","س-02759","س-02787","س-06836","س-04319"],"ref":"صحيح الجامع 8026","srcLabel":"متفق عليه","text":["يجمَعُ المؤمنونَ يومَ القيامَةِ ، فيهتَمُّونَ لِذلِكَ ، فيقولَونَ : لوِ استشْفَعْنَا علَى ربِّنا ، فأرَاحنا مِنْ مكانِنَا هذَا ، فيأتونَ آدَمَ ، فيقولُونَ : يا آدمُ ! أنتَ أبو البشَرِ ، خلَقَكَ اللهُ بيدِهِ ، وأسجدَ لكَ ملائكتَهُ ، وعلَّمَكَ أسماءَ كُلِّ شيءٍ ، فاشفَعْ لنا عندَ ربِّكَ ، حتى يريحَنا مِنْ مكانِنا هذَا ، فيقولُ لهم آدمُ : لستُ هناكُم ، ويذكُرُ ذنبَهُ الذي أصابَهُ ، فيَسْتَحْيِي ربَّهُ عزَّ وجلَّ مِنْ ذلِكَ ، ويقولُ : ولكن ائتوا نوحًا ، فإِنَّه أولُ رسولٍ بعثه اللهُ إلى أهلِ الأرضِ ، فيأتونَ نوحًا ، فيقولُ : لستُ هناكم – ويذكُرُ لَهمْ خطيئتَهُ سؤالَهُ ربَّهُ ما ليس له بِه علمٌ ، فيستَحْيِي ربَّهُ مِنْ ذلِكَ – ولكن ائتوا إبراهيمَ خليلَ الرحمنِ ، فيأتونَهُ ، فيقولُ : لستُ هناكم ، ولكنِ ائتوا موسى عبدًا كلَّمَهُ اللهُ ، وأعطاهُ التوراةَ ، فيأتونَ موسى ، فيقولُ : لستُ هناكم – ويذكُرُ لهم النفْسَ التي قتَلَ بغيرِ نفْسٍ ، فيسْتَحْيِي ربَّهُ من ذلِكَ – ولكن ائتُوا عيسى عبدُ اللهِ ورسولُهُ ، وكلِمَتُهُ وروحُهُ ، فيأتونَ عيسى ، فيقولُ لستُ : هناكم ، ولكنِ ائتُوا محمَّدًا عبدًا غفرَ اللهُ لَهُ ما تَقَدَّمَ من ذنبِهِ وما تأخَّرَ ، فأقومُ ، فأمْشِي بينَ سِمَاطَيْنِ مِنَ المؤمنينَ ، حتَّى أستَأْذِنَ علَي ربِّي ، فيؤذَنُ لِي ، فإذا رأيتُ ربِّي وقعْتُ ساجِدًا لِرَبِّي تبارك وتعالى ، فيدعُني ما شاء أن يدَعَنِي ، ثُمَّ يقولُ : ارفع محمدُ . قل : يسمعْ ، وسلْ تعطَهْ ، واشفعْ تُشَفَّعْ ، فأرْفَعُ رأسِي ، فأحمدُهُ بتحميدٍ يُعَلِّمُنيهِ ، ثُمَّ أشفَعُ فيَحُدُّ لِي حدًّا ، فأُدْخِلُهُمُ الجنَّةَ ، ثُمَّ أعودُ إليه الثانِيَةَ ، فإذا رأيتُ ربي وقعْتُ ساجِدًا لِرَبِّي تبارَكَ وتعالى ، فيدعُني مَا شاءَ اللهُ أن يدَعَنِي ، ثُمَّ يقولُ : ارفعْ محمدُ ! قلْ يُسمَعْ ، وسلْ تعطَهْ ، واشفعْ تُشَفَّعْ ، فأرفعُ رأسِي ، فأحمدُهُ بتحميدٍ يُعَلِّمُنِيهِ ، ثُمَّ أشفَعُ ، فَيَحُدُّ لي حدًّا ، فأُدْخِلُهُمُ الجنةَ ، ثُمَّ أعودُ الثالثةَ ، فإذا رأيتُ ربي تبارك وتعالى ، وقعتُ ساجدًا لربي ، فيدعُني ما شاء أن يدعَني ، ثُمَّ يقولُ : ارفع محمدُ ! قل : يُسْمَعُ ، وسلْ تعْطَهُ ، واشفَعْ تُشَفَّعُ ، فإذا رفعتُ رأسِي ، فأحمدُهُ بتحميدٍ يعَلِّمُنِيهِ ، ثُمَّ أشفَعُ ، فيَحُدُّ لي حدًّا ، فأدخِلُهمُ الجنةَ ، ثُمَّ أعودُ الرابعةَ فأقولُ : يا ربِّ ! ما بَقِيَ إلَّا مَنْ حبَسَهُ القرآنُ ، ",["فيخرَجُ مِنَ النارِ",2]," ",["مَنْ قال : لا إلهَ إلَّا اللهُ ، وكانَ في قلْبِهِ مِنَ الخيرِ ما يزِنُ شعيرةً",1]," ، ثُمَّ يخرُجُ من النارِ مَنْ قالَ : لَا إلهَ إلَّا اللهُ ، وكانَ في قلبِهِ مِنَ الخيرِ ما يزِنُ بُرَّةً ، ثُمَّ يخرُجُ من النارِ مَنْ قالَ : لَا إلهَ إلَّا اللهُ ، وكانَ في قلبِهِ مِنَ الخيرِ مَا يزِنُ ذرَّةً"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6565)، ومسلم (193) باختلاف يسير.","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"K4gj8Zoc","merged":5,"otherRefs":["صحيح مسلم 191 (صحيح)","صحيح البخاري 44 (صحيح)","صحيح مسلم 193 (صحيح)","صحيح ابن ماجه 3499 (صحيح)"]},{"id":"س-01229","fp":"86069c18663e","stateId":675,"easy":"إذا قلت «لا إله إلا الله» وفي قلبك من الخير وزن شعيرة ← تخرج من النار","cause":"مَنْ قال : لا إلهَ إلَّا اللهُ ، وكانَ في قلْبِهِ مِنَ الخيرِ ما يزِنُ شعيرةً","result":"يخرُجُ من النارِ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-01228","ref":"صحيح الجامع 8026","text":["يجمَعُ المؤمنونَ يومَ القيامَةِ ، فيهتَمُّونَ لِذلِكَ ، فيقولَونَ : لوِ استشْفَعْنَا علَى ربِّنا ، فأرَاحنا مِنْ مكانِنَا هذَا ، فيأتونَ آدَمَ ، فيقولُونَ : يا آدمُ ! أنتَ أبو البشَرِ ، خلَقَكَ اللهُ بيدِهِ ، وأسجدَ لكَ ملائكتَهُ ، وعلَّمَكَ أسماءَ كُلِّ شيءٍ ، فاشفَعْ لنا عندَ ربِّكَ ، حتى يريحَنا مِنْ مكانِنا هذَا ، فيقولُ لهم آدمُ : لستُ هناكُم ، ويذكُرُ ذنبَهُ الذي أصابَهُ ، فيَسْتَحْيِي ربَّهُ عزَّ وجلَّ مِنْ ذلِكَ ، ويقولُ : ولكن ائتوا نوحًا ، فإِنَّه أولُ رسولٍ بعثه اللهُ إلى أهلِ الأرضِ ، فيأتونَ نوحًا ، فيقولُ : لستُ هناكم – ويذكُرُ لَهمْ خطيئتَهُ سؤالَهُ ربَّهُ ما ليس له بِه علمٌ ، فيستَحْيِي ربَّهُ مِنْ ذلِكَ – ولكن ائتوا إبراهيمَ خليلَ الرحمنِ ، فيأتونَهُ ، فيقولُ : لستُ هناكم ، ولكنِ ائتوا موسى عبدًا كلَّمَهُ اللهُ ، وأعطاهُ التوراةَ ، فيأتونَ موسى ، فيقولُ : لستُ هناكم – ويذكُرُ لهم النفْسَ التي قتَلَ بغيرِ نفْسٍ ، فيسْتَحْيِي ربَّهُ من ذلِكَ – ولكن ائتُوا عيسى عبدُ اللهِ ورسولُهُ ، وكلِمَتُهُ وروحُهُ ، فيأتونَ عيسى ، فيقولُ لستُ : هناكم ، ولكنِ ائتُوا محمَّدًا عبدًا غفرَ اللهُ لَهُ ما تَقَدَّمَ من ذنبِهِ وما تأخَّرَ ، فأقومُ ، فأمْشِي بينَ سِمَاطَيْنِ مِنَ المؤمنينَ ، حتَّى أستَأْذِنَ علَي ربِّي ، فيؤذَنُ لِي ، فإذا رأيتُ ربِّي وقعْتُ ساجِدًا لِرَبِّي تبارك وتعالى ، فيدعُني ما شاء أن يدَعَنِي ، ثُمَّ يقولُ : ارفع محمدُ . قل : يسمعْ ، وسلْ تعطَهْ ، واشفعْ تُشَفَّعْ ، فأرْفَعُ رأسِي ، فأحمدُهُ بتحميدٍ يُعَلِّمُنيهِ ، ثُمَّ أشفَعُ فيَحُدُّ لِي حدًّا ، فأُدْخِلُهُمُ الجنَّةَ ، ثُمَّ أعودُ إليه الثانِيَةَ ، فإذا رأيتُ ربي وقعْتُ ساجِدًا لِرَبِّي تبارَكَ وتعالى ، فيدعُني مَا شاءَ اللهُ أن يدَعَنِي ، ثُمَّ يقولُ : ارفعْ محمدُ ! قلْ يُسمَعْ ، وسلْ تعطَهْ ، واشفعْ تُشَفَّعْ ، فأرفعُ رأسِي ، فأحمدُهُ بتحميدٍ يُعَلِّمُنِيهِ ، ثُمَّ أشفَعُ ، فَيَحُدُّ لي حدًّا ، فأُدْخِلُهُمُ الجنةَ ، ثُمَّ أعودُ الثالثةَ ، فإذا رأيتُ ربي تبارك وتعالى ، وقعتُ ساجدًا لربي ، فيدعُني ما شاء أن يدعَني ، ثُمَّ يقولُ : ارفع محمدُ ! قل : يُسْمَعُ ، وسلْ تعْطَهُ ، واشفَعْ تُشَفَّعُ ، فإذا رفعتُ رأسِي ، فأحمدُهُ بتحميدٍ يعَلِّمُنِيهِ ، ثُمَّ أشفَعُ ، فيَحُدُّ لي حدًّا ، فأدخِلُهمُ الجنةَ ، ثُمَّ أعودُ الرابعةَ فأقولُ : يا ربِّ ! ما بَقِيَ إلَّا مَنْ حبَسَهُ القرآنُ ، فيخرَجُ مِنَ النارِ ",["مَنْ قال : لا إلهَ إلَّا اللهُ ، وكانَ في قلْبِهِ مِنَ الخيرِ ما يزِنُ شعيرةً",1]," ، ثُمَّ ",["يخرُجُ من النارِ",2]," مَنْ قالَ : لَا إلهَ إلَّا اللهُ ، وكانَ في قلبِهِ مِنَ الخيرِ ما يزِنُ بُرَّةً ، ثُمَّ يخرُجُ من النارِ مَنْ قالَ : لَا إلهَ إلَّا اللهُ ، وكانَ في قلبِهِ مِنَ الخيرِ مَا يزِنُ ذرَّةً"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6565)، ومسلم (193) باختلاف يسير.","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"K4gj8Zoc"},{"id":"س-02447","fp":"dd79eaa446f6","stateId":675,"easy":"إذا قلت «لا إله إلا الله» وفي قلبك من الخير ذرة ← تخرج من النار","cause":"مَن قال: لا إلهَ إلَّا اللهُ، مَن كان في قلبِه مِنَ الخَيرِ ما يَزِنُ ذَرَّةً","result":"أَخرِجوا مِنَ النارِ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-01228","ref":"تخريج المسند لشعيب 13928","text":["أَخرِجوا مِنَ النارِ -وقال حَجَّاجٌ: يقولُ اللهُ عزَّ وجلَّ: أَخرِجوا مِنَ النارِ- ",["مَن قال: لا إلهَ إلَّا اللهُ، مَن كان في قلبِه مِنَ الخَيرِ ما يَزِنُ ذَرَّةً",1],"، ",["أَخرِجوا مِنَ النارِ",2]," مَن قال: لا إلهَ إلَّا اللهُ، مَن كان في قلبِه مِنَ الخَيرِ ما يَزِنُ شَعِيرةً، أَخرِجوا مِنَ النارِ مَن قال: لا إلهَ إلَّا اللهُ، مَن كان في قلبِه مِنَ الخَيرِ ما يَزِنُ بُرَّةً."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (44)، ومسلم (193) باختلاف يسير","bab":"إسلام › فضل الشهادتين","dorar":"EPGVjx8H"},{"id":"س-05729","fp":"61bdb4074a0c","stateId":675,"easy":"إذا كان في قلبك مثقال حبة خردل من إيمان ← لا تخلد في النار","cause":"أحَدٌ في قَلبِه مِثقالُ حَبَّةِ خَردَلٍ مِن إيمانٍ","result":"لا يَدخُلُ النَّارَ","explicit":true,"similar":["س-07889","س-03192","س-01217","س-04028","س-07881","س-06906","س-07890","س-07885"],"ref":"صحيح مسلم 91","srcLabel":"متفق عليه","text":[["لا يَدخُلُ النَّارَ",2]," ",["أحَدٌ في قَلبِه مِثقالُ حَبَّةِ خَردَلٍ مِن إيمانٍ",1],"، ولا يَدخُلُ الجَنَّةَ أحَدٌ في قَلبِه مِثقالُ حَبَّةِ خَردَلٍ مِن كِبرياءَ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"رقائق وزهد › الكبر والتواضع","dorar":"3z5HjzTj"},{"id":"س-01513","fp":"5b7dad075afd","stateId":675,"easy":"إذا شهدت أن لا إله إلا الله ← خرجت من النار","cause":"أشهَدُ أنْ لا إلَهَ إلَّا اللهُ","result":"خَرَجتَ مِنَ النَّارِ","explicit":true,"repOf":"س-01228","ref":"صحيح مسلم 382","text":["كانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يُغيرُ إذا طَلَعَ الفَجرُ، وكانَ يَستَمِعُ الأذانَ، فإن سَمِعَ أذانًا أمسَك وإلَّا أغارَ، فسَمِعَ رَجُلًا يقولُ: اللهُ أكبَرُ اللهُ أكبَرُ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: على الفِطرةِ، ثُمَّ قال: ",["أشهَدُ أنْ لا إلَهَ إلَّا اللهُ",1]," أشهَدُ أنْ لا إلَهَ إلَّا اللهُ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["خَرَجتَ مِنَ النَّارِ",2],"، فنَظَروا فإذا هو راعي مِعزًى."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (382)","bab":"أذان › فضل التأذين","dorar":"92lkmHaR","merged":2,"otherRefs":["تخريج المسند لشعيب 13399 (صحيح)"]},{"id":"س-02407","fp":"953f1b3a7b02","stateId":675,"easy":"إذا شهدت أن محمداً رسول الله ← خرجت من النار","cause":"أشهَدُ أنَّ محمَّدًا رسولُ اللهِ","result":"خَرَجَ مِن النَّارِ","explicit":true,"repOf":"س-01228","ref":"تخريج المسند لشعيب 22134","text":["بيْنَما رسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ في بعضِ أسفارِه، إذ سَمِعَ مُناديًا يقولُ: اللهُ أكبرُ، اللهُ أكبرُ، فقال: على الفِطرةِ، فقال: أشهَدُ أنْ لا إلهَ إلَّا اللهُ، فقال: شَهِدَ بشَهادةِ الحَقِّ، قال: ",["أشهَدُ أنَّ محمَّدًا رسولُ اللهِ",1],"، قال: ",["خَرَجَ مِن النَّارِ",2],"، انظُروا فستَجِدونَه إمَّا راعيًا مُعزِبًا، وإمَّا مُكَلِّبًا، فنَظَروه فوَجَدوه راعيًا حَضَرَتْه الصَّلاةُ فنادى بها."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (22134) واللفظ له، والطبراني في ((المعجم الصغير)) (768)، والخطيب في ((تاريخ بغداد)) (8/220)","bab":"إسلام › فضل الشهادتين","dorar":"dvkKuPym","merged":5,"otherRefs":["مجمع الزوائد 1/340 (حسن)","نخب الافكار 3/129 (صحيح)","الترغيب والترهيب 1/147 (صحيح)","تخريج المسند لشعيب 13532 (صحيح)"]},{"id":"س-01237","fp":"4c3b7943871a","stateId":675,"easy":"إذا قلت «لا إله إلا الله» وذكرت الله أو خفته في مقام ← يخرجك من النار","cause":"مَنْ قالَ: لا إلَهَ إلَّا اللهُ، وذَكَرَني أَوْ خافَني في مَقامٍ","result":"أَخْرِجوا مِنَ النَّارِ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-01228","ref":"المستدرك على الصحيحين 235","text":["«يَقولُ اللهُ عزَّ وجلَّ: ",["أَخْرِجوا مِنَ النَّارِ",2]," مَنْ قالَ: لا إلَهَ إلَّا اللهُ وفي قَلْبِهِ مِثْقالُ ذَرَّةٍ مِنَ الإيمانِ، أَخْرِجوا مِنَ النَّارِ مَنْ قالَ: لا إلَهَ إلَّا اللهُ وفي قَلْبِهِ مِثقالُ بُرَّةٍ مِنَ الإيمانِ، أَخْرِجوا مِنَ النَّارِ ",["مَنْ قالَ: لا إلَهَ إلَّا اللهُ، وذَكَرَني أَوْ خافَني في مَقامٍ",1],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (2594)، والبيهقي في ((شعب الإيمان)) (740) وابن أبي عاصم في ((السنة)) (833) مختصرا","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"uTGLuxBc","merged":2,"otherRefs":["هداية الرواة 5/72 (حسن)"]},{"id":"س-01222","fp":"6b1b03149fa8","stateId":675,"easy":"إذا شهدت أن لا إله إلا الله ← يأمر الله الملائكة أن يخرجوك من النار","cause":"من شهدَ أن لا إلهَ إلا اللهَ","result":"يأمرُ اللهُ الملائكةَ أن يُخرجوا من النارِ","explicit":true,"repOf":"س-01228","ref":"أحكام القرآن لابن العربي 4/141","text":[["يأمرُ اللهُ الملائكةَ أن يُخرجوا من النارِ",2]," ",["من شهدَ أن لا إلهَ إلا اللهَ",1],"، فيعرفونَه بعلامةِ أثرِ السجودِ."],"grade":"صحيح","muhaddith":"صحيح","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"1sLWSEd0"},{"id":"س-01234","fp":"011c3a4d6170","stateId":675,"easy":"إذا شهدت أن لا إله إلا الله ← يخرجك الله من النار","cause":"بشهادةِ أن لا إله إلا اللهُ","result":"أَخْرَجَ اللهُ أهلَ النارِ من النارِ","explicit":true,"repOf":"س-01228","ref":"تخريج كتاب السنة 844","text":["إذا ",["أَخْرَجَ اللهُ أهلَ النارِ من النارِ",2]," ",["بشهادةِ أن لا إله إلا اللهُ",1]," تَمَنَّى الآخَرُونَ لو كانوا مسلمينَ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (2/406)","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"kBConHdy"},{"id":"س-07889","fp":"2bcd59b370ea","stateId":675,"easy":"إذا كان في قلبك مثقال دينار من خير ← تخرج من النار","cause":"فمَن وجَدتُم في قَلبِه مِثقالَ دينارٍ مِن خَيرٍ","result":"فأخرِجوه","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-05729","ref":"صحيح مسلم 183","text":["أنَّ ناسًا في زَمَنِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم قالوا: يا رَسولَ اللهِ، هل نَرى رَبَّنا يَومَ القيامةِ؟ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: نَعَم، قال: هل تُضارُّونَ في رُؤيةِ الشَّمسِ بالظَّهيرةِ صَحوًا ليس معها سَحابٌ؟ وهل تُضارُّونَ في رُؤيةِ القَمَرِ لَيلةَ البَدرِ صَحوًا ليس فيها سَحابٌ؟ قالوا: لا يا رَسولَ اللهِ، قال: ما تُضارُّونَ في رُؤيةِ اللهِ تَبارَك وتَعالى يَومَ القيامةِ إلَّا كما تُضارُّونَ في رُؤيةِ أحَدِهما، إذا كانَ يَومُ القيامةِ أذَّنَ مُؤَذِّنٌ: ليَتَّبِعْ كُلُّ أُمَّةٍ ما كانَت تَعبُدُ، فلا يَبقى أحَدٌ كانَ يَعبُدُ غيرَ اللهِ سُبحانَه مِنَ الأصنامِ والأنصابِ إلَّا يَتَساقَطونَ في النَّارِ، حتَّى إذا لَم يَبقَ إلَّا مَن كانَ يَعبُدُ اللهَ مِن بَرٍّ وفاجِرٍ وغُبَّرِ أهلِ الكِتابِ، فيُدعى اليَهودُ، فيُقالُ لهم: ما كُنتُم تَعبُدونَ؟ قالوا: كُنَّا نَعبُدُ عُزَيرَ ابنَ اللهِ، فيُقالُ: كَذَبتُم، ما اتَّخَذَ اللهُ مِن صاحِبةٍ ولا ولَدٍ، فماذا تَبغونَ؟ قالوا: عَطِشنا يا رَبَّنا، فاسقِنا، فيُشارُ إليهم، ألا تَرِدونَ؟ فيُحشَرونَ إلى النَّارِ كَأنَّها سَرابٌ يَحطِمُ بَعضُها بَعضًا، فيَتَساقَطونَ في النَّارِ، ثُمَّ يُدعى النَّصارى، فيُقالُ لهم: ما كُنتُم تَعبُدونَ؟ قالوا: كُنَّا نَعبُدُ المَسيحَ ابنَ اللهِ، فيُقالُ لهم، كَذَبتُم، ما اتَّخَذَ اللهُ مِن صاحِبةٍ ولا ولَدٍ، فيُقالُ لهم: ماذا تَبغونَ؟ فيَقولونَ: عَطِشنا يا رَبَّنا، فاسقِنا، قال: فيُشارُ إليهم، ألا تَرِدونَ؟ فيُحشَرونَ إلى جَهَنَّمَ كَأنَّها سَرابٌ يَحطِمُ بَعضُها بَعضًا، فيَتَساقَطونَ في النَّارِ، حتَّى إذا لَم يَبقَ إلَّا مَن كانَ يَعبُدُ اللهَ تَعالى مِن بَرٍّ وفاجِرٍ، أتاهم رَبُّ العالَمينَ سُبحانَه وتَعالى في أدنى صورةٍ مِنَ التي رَأوْه فيها، قال: فما تَنتَظِرونَ؟ تَتبَعُ كُلُّ أُمَّةٍ ما كانَت تَعبُدُ، قالوا: يا رَبَّنا، فارَقنا النَّاسَ في الدُّنيا أفقَرَ ما كُنَّا إليهم، ولَم نُصاحِبْهُم، فيَقولُ: أنا رَبُّكُم، فيَقولونَ: نَعوذُ باللهِ مِنك لا نُشرِكُ باللهِ شيئًا، مَرَّتَينِ أو ثَلاثًا، حتَّى إنَّ بَعضَهم لَيَكادُ أن يَنقَلِبَ، فيَقولُ: هل بينَكُم وبينَه آيةٌ فتَعرِفونَه بها؟ فيَقولونَ: نَعَم، فيُكشَفُ عن ساقٍ، فلا يَبقى مَن كانَ يَسجُدُ للَّهِ مِن تِلقاءِ نَفسِه إلَّا أذِنَ اللهُ له بالسُّجودِ، ولا يَبقى مَن كانَ يَسجُدُ اتِّقاءً ورياءً إلَّا جَعَلَ اللهُ ظَهرَه طَبَقةً واحِدةً، كُلَّما أرادَ أن يَسجُدَ خَرَّ على قَفاه، ثُمَّ يَرفَعونَ رُؤوسَهم وقد تَحَوَّلَ في صورَتِه التي رَأوْه فيها أوَّلَ مَرَّةٍ، فقال: أنا رَبُّكُم، فيَقولونَ: أنتَ رَبُّنا، ثُمَّ يُضرَبُ الجِسرُ على جَهَنَّمَ، وتَحِلُّ الشَّفاعةُ، ويقولونَ: اللهمَّ سَلِّمْ سَلِّمْ، قيلَ: يا رَسولَ اللهِ، وما الجِسرُ؟ قال: دَحضٌ مَزِلَّةٌ، فيه خَطاطيفُ وكَلاليبُ، وحَسَكٌ تَكونُ بنَجدٍ فيها شويكةٌ يُقالُ لها السَّعدانُ، فيَمُرُّ المُؤمِنونَ كَطَرفِ العَينِ، وكالبَرقِ، وكالرِّيحِ، وكالطَّيرِ، وكَأجاويدِ الخَيلِ والرِّكابِ؛ فناجٍ مُسَلَّمٌ، ومَخدوشٌ مُرسَلٌ، ومَكدوسٌ في نارِ جَهَنَّمَ، حتَّى إذا خَلَصَ المُؤمِنونَ مِنَ النَّارِ، فوالذي نَفسي بيَدِه، ما مِنكُم مِن أحَدٍ بأشَدَّ مُناشَدةً للَّهِ في استِقصاءِ الحَقِّ مِنَ المُؤمِنينَ للَّهِ يَومَ القيامةِ لإخوانِهمُ الذينَ في النَّارِ، يقولونَ: رَبَّنا كانوا يَصومونَ معنا ويُصَلُّونَ ويَحُجُّونَ، فيُقالُ لهم: أخرِجوا مَن عَرَفتُم، فتُحَرَّمُ صورُهم على النَّارِ، فيُخرِجونَ خَلقًا كَثيرًا قدِ أخَذَتِ النَّارُ إلى نِصفِ ساقَيه، وإلى رُكبَتَيه، ثُمَّ يقولونَ: رَبَّنا ما بَقيَ فيها أحَدٌ مِمَّن أمَرتَنا به، فيَقولُ: ارجِعوا ",["فمَن وجَدتُم في قَلبِه مِثقالَ دينارٍ مِن خَيرٍ",1]," ",["فأخرِجوه",2],"، فيُخرِجونَ خَلقًا كَثيرًا، ثُمَّ يقولونَ: رَبَّنا لَم نَذَرْ فيها أحَدًا مِمَّن أمَرتَنا، ثُمَّ يقولُ: ارجِعوا فمَن وجَدتُم في قَلبِه مِثقالَ نِصفِ دينارٍ مِن خَيرٍ فأخرِجوه، فيُخرِجونَ خَلقًا كَثيرًا، ثُمَّ يقولونَ: رَبَّنا لَم نَذَرْ فيها مِمَّن أمَرتَنا أحَدًا، ثُمَّ يقولُ: ارجِعوا فمَن وجَدتُم في قَلبِه مِثقالَ ذَرَّةٍ مِن خَيرٍ فأخرِجوه، فيُخرِجونَ خَلقًا كَثيرًا، ثُمَّ يقولونَ: رَبَّنا لَم نَذَرْ فيها خَيرًا. وكانَ أبو سَعيدٍ الخُدريُّ يقولُ: إن لَم تُصَدِّقوني بهذا الحَديثِ فاقرَؤوا إن شِئتُم: {إنَّ اللهَ لا يَظلِمُ مِثقالَ ذَرَّةٍ وإن تَكُ حَسَنةً يُضاعِفها ويُؤتِ مِن لَدُنْه أجرًا عَظيمًا} [النساء: 40]، فيَقولُ اللهُ عزَّ وجلَّ: شَفَعَتِ المَلائِكةُ، وشَفَعَ النَّبيُّونَ، وشَفَعَ المُؤمِنونَ، ولَم يَبقَ إلَّا أرحَمُ الرَّاحِمينَ، فيَقبِضُ قَبضةً مِنَ النَّارِ، فيُخرِجُ مِنها قَومًا لَم يَعمَلوا خَيرًا قَطُّ قد عادوا حُمَمًا، فيُلقيهم في نَهَرٍ في أفواهِ الجَنَّةِ، يُقالُ له: نَهَرُ الحَياةِ، فيَخرُجونَ كما تَخرُجُ الحِبَّةُ في حَميلِ السَّيلِ، ألا تَرَونَها تَكونُ إلى الحَجَرِ أو إلى الشَّجَرِ، ما يَكونُ إلى الشَّمسِ أُصَيفِرُ وأُخَيضِرُ، وما يَكونُ مِنها إلى الظِّلِّ يَكونُ أبيَضَ؟ فقالوا: يا رَسولَ اللهِ، كَأنَّك كُنتَ تَرعى بالباديةِ! قال: فيَخرُجونَ كاللُّؤلُؤِ في رِقابِهمُ الخَواتِمُ، يَعرِفُهم أهلُ الجَنَّةِ: هؤلاء عُتَقاءُ اللهِ الذينَ أدخَلَهمُ اللهُ الجَنَّةَ بغيرِ عَمَلٍ عَمِلوه، ولا خَيرٍ قدَّموه، ثُمَّ يقولُ: ادخُلوا الجَنَّةَ فما رَأيتُموه فهو لكم، فيَقولونَ: رَبَّنا، أعطَيتَنا ما لَم تُعطِ أحَدًا مِنَ العالَمينَ، فيَقولُ: لكم عِندي أفضَلُ مِن هذا، فيَقولونَ: يا رَبَّنا، أيُّ شيءٍ أفضَلُ مِن هذا؟ فيَقولُ: رِضايَ، فلا أسخَطُ علَيكُم بَعدَه أبَدًا. قال مُسلِمٌ: قَرَأتُ على عيسى بنِ حَمَّادٍ زُغبةَ المِصريِّ هذا الحَديثَ في الشَّفاعةِ، وقُلتُ له: أُحَدِّثُ بهذا الحَديثِ عَنك أنَّك سَمِعتَ مِنَ اللَّيثِ بنِ سَعدٍ، فقال: نَعَم، قُلتُ لعيسى بنِ حَمَّادٍ: أخبَرَكُمُ اللَّيثُ بنُ سَعدٍ، عن خالِدِ بنِ يَزيدَ، عن سَعيدِ بنِ أبي هِلالٍ، عن زَيدِ بنِ أسلَمَ، عن عَطاءِ بنِ يَسارٍ، عن أبي سَعيدٍ الخُدريِّ، أنَّه قال: قُلنا: يا رَسولَ اللهِ، أنَرى رَبَّنا؟ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: هل تُضارُّونَ في رُؤيةِ الشَّمسِ إذا كانَ يَومٌ صَحوٌ؟ قُلنا: لا، وسُقتُ الحَديثَ حتَّى انقَضى آخِرُه، وهو نَحوُ حَديثِ حَفصِ بنِ مَيسَرةَ، وزادَ بَعدَ قَولِه: بغيرِ عَمَلٍ عَمِلوه، ولا قدَمٍ قدَّموه، فيُقالُ لهم: لكم ما رَأيتُم ومِثلُه معهُ. قال أبو سَعيدٍ: بَلَغَني أنَّ الجِسرَ أدَقُّ مِنَ الشَّعرةِ، وأحَدُّ مِنَ السَّيفِ. وليسَ في حَديثِ اللَّيثِ، فيَقولونَ: رَبَّنا أعطَيتَنا ما لَم تُعطِ أحَدًا مِنَ العالَمينَ وما بَعدَه، فأقَرَّ به عيسى بنُ حَمَّادٍ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7439) باختلاف يسير","bab":"قيامة › الشفاعة","dorar":"KOAVhCFo","merged":6,"otherRefs":["تخريج المسند لشعيب 14491 (صحيح)","المستدرك على الصحيحين 8962 (صحيح)","صحيح مسلم 184 (صحيح)","صحيح البخاري 7439 (صحيح)","صحيح البخاري 6560 (صحيح)"]},{"id":"س-03192","fp":"3fce61ff2359","stateId":675,"easy":"إذا كان في قلبك مثقال حبة خردل من إيمان ← تخرج من النار","cause":"مَن كان في قَلبِه مِثقالُ حَبَّةٍ مِن خَردَلٍ مِن إيمانٍ","result":"أخرِجوا مِنَ النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-05729","ref":"صحيح البخاري 22","text":["يَدخُلُ أهلُ الجَنَّةِ الجَنَّةَ، وأهلُ النَّارِ النَّارَ، ثُمَّ يقولُ اللهُ تَعالى: ",["أخرِجوا مِنَ النَّارِ",2]," ",["مَن كان في قَلبِه مِثقالُ حَبَّةٍ مِن خَردَلٍ مِن إيمانٍ",1],". فيُخرَجونَ منها قدِ اسودُّوا، فيُلقَونَ في نَهَرِ الحَيا، أوِ الحَياةِ -شَكَّ مالِكٌ- فيَنبُتونَ كما تَنبُتُ الحِبَّةُ في جانِبِ السَّيلِ، ألَم تَرَ أنَّها تَخرُجُ صَفراءَ مُلتَويةً؟ قال وُهَيبٌ: حَدَّثنا عمرٌو (الحياةِ)، وقال: (خَردَلٍ مِن خَيرٍ)."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (184) باختلاف يسير","bab":"إيمان › فضل الإيمان","dorar":"0t7kj7hf","merged":5,"otherRefs":["المستدرك على الصحيحين 235 (صحيح)","تخريج الإحياء للعراقي 3/27 (صحيح)","صحيح الترمذي 2598 (صحيح)","صحيح الترمذي 1999 (صحيح)"]},{"id":"س-05475","fp":"f4d39950370c","stateId":675,"easy":"إذا آمنت ← فلا يضر مع الإيمان شيء (من الخلود)","cause":"الإيمانِ","result":"لا يضرُّ مع الإيمانِ شيءٌ","explicit":true,"otherNeedIds":[17],"ref":"تنزيه الشريعة 1/153","srcLabel":"العقيلي","text":["كما لا ينفعُ مع الشركِ شيءٌ كذلك ",["لا يضرُّ مع الإيمانِ شيءٌ",2]],"grade":"حسن","narrator":"عمر بن الخطاب","muhaddith":"له شاهد جيد","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (4/199)، وابن عدي في ((الكامل في الضعفاء)) (2/232) واللفظ لهما، وأبو نعيم في ((معرفة الصحابة)) (871) باختلاف يسير.","bab":"رقائق وزهد › الرجاء مع الخوف","dorar":"VlT5DYuz"},{"id":"س-07883","fp":"131751cfbe5f","stateId":675,"easy":"إذا قلت لا إله إلا الله ← تخرج من النار","cause":"مَن قالَ: لا إلَهَ إلَّا اللَّهُ","result":"لَأُخْرِجَنَّ منها","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-01228","ref":"فتح الباري لابن حجر 1/246","text":["حديثُ الشَّفاعةِ [يعني حديث: اجْتَمَعْنَا نَاسٌ مِن أهْلِ البَصْرَةِ فَذَهَبْنَا إلى أنَسِ بنِ مَالِكٍ، وذَهَبْنَا معنَا بثَابِتٍ البُنَانِيِّ إلَيْهِ يَسْأَلُهُ لَنَا عن حَديثِ الشَّفَاعَةِ، فَإِذَا هو في قَصْرِهِ فَوَافَقْنَاهُ يُصَلِّي الضُّحَى، فَاسْتَأْذَنَّا، فأذِنَ لَنَا وهو قَاعِدٌ علَى فِرَاشِهِ، فَقُلْنَا لِثَابِتٍ: لا تَسْأَلْهُ عن شيءٍ أوَّلَ مِن حَديثِ الشَّفَاعَةِ، فَقالَ: يا أبَا حَمْزَةَ هَؤُلَاءِ إخْوَانُكَ مِن أهْلِ البَصْرَةِ جَاؤُوكَ يَسْأَلُونَكَ عن حَديثِ الشَّفَاعَةِ، فَقالَ: حَدَّثَنَا مُحَمَّدٌ صَلَّى اللهُ عليه وسلَّمَ قالَ: إذَا كانَ يَوْمُ القِيَامَةِ مَاجَ النَّاسُ بَعْضُهُمْ في بَعْضٍ، فَيَأْتُونَ آدَمَ، فيَقولونَ: اشْفَعْ لَنَا إلى رَبِّكَ، فيَقولُ: لَسْتُ لَهَا، ولَكِنْ علَيْكُم بإبْرَاهِيمَ فإنَّه خَلِيلُ الرَّحْمَنِ، فَيَأْتُونَ إبْرَاهِيمَ، فيَقولُ: لَسْتُ لَهَا، ولَكِنْ علَيْكُم بمُوسَى فإنَّه كَلِيمُ اللَّهِ، فَيَأْتُونَ مُوسَى فيَقولُ: لَسْتُ لَهَا، ولَكِنْ علَيْكُم بعِيسَى فإنَّه رُوحُ اللَّهِ، وكَلِمَتُهُ، فَيَأْتُونَ عِيسَى، فيَقولُ: لَسْتُ لَهَا، ولَكِنْ علَيْكُم بمُحَمَّدٍ صَلَّى اللهُ عليه وسلَّمَ، فَيَأْتُونِي، فأقُولُ: أنَا لَهَا، فأسْتَأْذِنُ علَى رَبِّي، فيُؤْذَنُ لِي، ويُلْهِمُنِي مَحَامِدَ أحْمَدُهُ بهَا لا تَحْضُرُنِي الآنَ، فأحْمَدُهُ بتِلْكَ المَحَامِدِ، وأَخِرُّ له سَاجِدًا، فيَقولُ: يا مُحَمَّدُ ارْفَعْ رَأْسَكَ، وقُلْ يُسْمَعْ لَكَ، وسَلْ تُعْطَ، واشْفَعْ تُشَفَّعْ، فأقُولُ: يا رَبِّ، أُمَّتي أُمَّتِي، فيَقولُ: انْطَلِقْ فأخْرِجْ منها مَن كانَ في قَلْبِهِ مِثْقَالُ شَعِيرَةٍ مِن إيمَانٍ، فأنْطَلِقُ فأفْعَلُ، ثُمَّ أعُودُ، فأحْمَدُهُ بتِلْكَ المَحَامِدِ، ثُمَّ أخِرُّ له سَاجِدًا، فيُقَالُ: يا مُحَمَّدُ ارْفَعْ رَأْسَكَ، وقُلْ يُسْمَعْ لَكَ، وسَلْ تُعْطَ، واشْفَعْ تُشَفَّعْ، فأقُولُ: يا رَبِّ، أُمَّتي أُمَّتِي، فيَقولُ: انْطَلِقْ فأخْرِجْ منها مَن كانَ في قَلْبِهِ مِثْقَالُ ذَرَّةٍ - أوْ خَرْدَلَةٍ - مِن إيمَانٍ فأخْرِجْهُ، فأنْطَلِقُ، فأفْعَلُ، ثُمَّ أعُودُ فأحْمَدُهُ بتِلْكَ المَحَامِدِ، ثُمَّ أخِرُّ له سَاجِدًا، فيَقولُ: يا مُحَمَّدُ ارْفَعْ رَأْسَكَ، وقُلْ يُسْمَعْ لَكَ، وسَلْ تُعْطَ، واشْفَعْ تُشَفَّعْ، فأقُولُ: يا رَبِّ أُمَّتي أُمَّتِي، فيَقولُ: انْطَلِقْ فأخْرِجْ مَن كانَ في قَلْبِهِ أدْنَى أدْنَى أدْنَى مِثْقَالِ حَبَّةِ خَرْدَلٍ مِن إيمَانٍ، فأخْرِجْهُ مِنَ النَّارِ، فأنْطَلِقُ فأفْعَلُ فَلَمَّا خَرَجْنَا مِن عِندِ أنَسٍ قُلتُ لِبَعْضِ أصْحَابِنَا: لو مَرَرْنَا بالحَسَنِ وهو مُتَوَارٍ في مَنْزِلِ أبِي خَلِيفَةَ فَحَدَّثْنَاهُ بما حَدَّثَنَا أنَسُ بنُ مَالِكٍ، فأتَيْنَاهُ فَسَلَّمْنَا عليه، فأذِنَ لَنَا فَقُلْنَا له: يا أبَا سَعِيدٍ، جِئْنَاكَ مِن عِندِ أخِيكَ أنَسِ بنِ مَالِكٍ، فَلَمْ نَرَ مِثْلَ ما حَدَّثَنَا في الشَّفَاعَةِ، فَقالَ: هِيهْ فَحَدَّثْنَاهُ بالحَديثِ، فَانْتَهَى إلى هذا المَوْضِعِ، فَقالَ: هِيهْ، فَقُلْنَا لَمْ يَزِدْ لَنَا علَى هذا، فَقالَ: لقَدْ حدَّثَني وهو جَمِيعٌ مُنْذُ عِشْرِينَ سَنَةً فلا أدْرِي أنَسِيَ أمْ كَرِهَ أنْ تَتَّكِلُوا، قُلْنَا: يا أبَا سَعِيدٍ فَحَدِّثْنَا فَضَحِكَ، وقالَ: خُلِقَ الإنْسَانُ عَجُولًا ما ذَكَرْتُهُ إلَّا وأَنَا أُرِيدُ أنْ أُحَدِّثَكُمْ حدَّثَني كما حَدَّثَكُمْ به، قالَ: ثُمَّ أعُودُ الرَّابِعَةَ فأحْمَدُهُ بتِلْكَ المَحَامِدِ، ثُمَّ أخِرُّ له سَاجِدًا، فيُقَالُ: يا مُحَمَّدُ ارْفَعْ رَأْسَكَ، وقُلْ يُسْمَعْ، وسَلْ تُعْطَهْ، واشْفَعْ تُشَفَّعْ، فأقُولُ: يا رَبِّ ائْذَنْ لي فِي",["مَن قالَ: لا إلَهَ إلَّا اللَّهُ",1],"، فيَقولُ: وعِزَّتي وجَلَالِي، وكِبْرِيَائِي وعَظَمَتي ",["لَأُخْرِجَنَّ منها",2]," مَن قالَ لا إلَهَ إلَّا اللَّهُ.]"],"grade":"صحيح","narrator":"[أنس بن مالك]","muhaddith":"متواتر","takhrij":"أخرجه البخاري (7510) بلفظه، ومسلم (193) باختلاف يسير، وابن ماجه (4312) بنحوه.","bab":"قيامة › الشفاعة","dorar":"yAUAvrJW","merged":2,"otherRefs":["التمهيد 19/67 (صحيح)"]},{"id":"س-00539","fp":"18321da8223e","stateId":675,"easy":"إذا كنت تشهد أن لا إله إلا الله ← يُخرجك الله من النار","cause":"ممَّن كان يشهَدُ أنْ لا إلهَ إلَّا اللهُ","result":"أنْ يُخرِجَ مِن النَّارِ مَن أراد","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-01228","ref":"تخريج صحيح ابن حبان 7429","text":["قال النَّاسُ : يا رسولَ اللهِ هل نرى ربَّنا يومَ القيامةِ ؟ فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم : ( هل تُضارُّونَ في الشَّمسِ ليس دونَها سَحابٌ ) ؟ قالوا : لا يا رسولَ اللهِ قال : ( فهل تُضارُّونَ في القمرِ ليلةَ البدرِ ليس دونَه سَحابٌ ) ؟ قالوا : لا يا رسولَ اللهِ قال : ( فإنَّكم ترَوْنَه يومَ القيامةِ كذلكَ يجمَعُ اللهُ النَّاسَ يومَ القيامةِ فيقولُ : مَن كان يعبُدُ شيئًا فلْيَتْبَعْه فيتبَعُ مَن كان يعبُدُ الشَّمسَ الشَّمسَ ومَن كان يعبُدُ القمرَ القمرَ ويتبَعْ مَن كان يعبُدُ الطَّواغيتَ الطَّواغيتَ وتبقى هذه الأُمَّةُ فيها مُنافِقوها فيأتيهم اللهُ جلَّ وعلا في غيرِ صورتِه الَّتي يعرِفونَ فيقولُ : أنا ربُّكم فيقولونَ : نعوذُ باللهِ منكَ هذا مَقامُنا حتَّى يأتيَنا ربُّنا فإذا جاءنا ربُّنا عرَفْناه قال : فيأتيهم في الصُّورةِ الَّتي يعرِفونَ فيقولُ : أنا ربُّكم فيقولونَ : أنتَ ربُّنا ويُضرَبُ جِسرٌ على جَهنَّمَ ) قال النَّبيُّ صلَّى اللهُ عليه وسلَّم : ( فأكونُ أوَّلَ مَن يجُوزُه ودعوةُ الرُّسلِ يومَئذٍ : اللَّهمَّ سلِّمْ سلِّمْ وبه كلاليبُ مِثْلُ شَوكِ السَّعدانِ هل تدرونَ شَوكَ السَّعدانِ ) ؟ قالوا : نَعم يا رسولَ اللهِ قال : ( فإنَّها مِثلُ شَوكِ السَّعدانِ غيرَ أنَّه لا يعلَمُ قدرَ عِظَمِها إلَّا اللهُ فتخطَفُ النَّاسَ بأعمالِهم فمنهم المُوبَقُ بعمَلِه ومنهم المُخردَلُ ثمَّ ينجو حتَّى إذا فرَغ اللهُ مِن القضاءِ بَيْنَ عبادِه وأراد ",["أنْ يُخرِجَ مِن النَّارِ مَن أراد",2]," ",["ممَّن كان يشهَدُ أنْ لا إلهَ إلَّا اللهُ",1]," أمَر اللهُ الملائكةَ أنْ يُخرِجوهم فيعرفونَهم بعلامةِ آثارِ السُّجودِ قال : وحرَّم اللهُ على النَّارِ أنْ تأكُلَ مِن ابنِ آدَمَ أثَرَ السُّجودِ قال : فيُخرِجونهم قد امتُحِشوا فيُصَبُّ عليهم ماءٌ يُقالُ له : ماءُ الحياةِ فينبُتونَ نباتَ الحِبَّةِ في حَميلِ السَّيلِ ) قال : ( ويبقى رجُلٌ مُقبِلٌ بوجهِه على النَّارِ ) فيقولُ : يا ربِّ قد قشَبني ريحُها وأحرَقني ذَكاؤُها فاصرِفْ وجهي عنِ النَّارِ فلا يزالُ يدعو فيقولُ اللهُ جلَّ وعلا : فلعلِّي إنْ أعطَيْتُكَ ذلكَ أنْ تسأَلَني غيرَه ؟ فيقولُ : لا وعزَّتِكَ لا أسأَلُكَ غيرَه فيصرِفُ وجهَه عنِ النَّارِ ثمَّ يقولُ بعدَ ذلكَ : يا ربِّ قرِّبْني إلى بابِ الجنَّةِ فيقولُ جلَّ وعلا : أليس قد زعَمْتَ ألَّا تسأَلَني غيرَه ؟ وَيْلَكَ يا ابنَ آدَمَ ما أغدرَكَ فلا يزالُ يدعو فيقولُ جلَّ وعلا : فلعلَّكَ إنْ أعطَيْتُكَ ذلكَ أنْ تسأَلَني غيرَه ؟ فيقولُ : لا وعزَّتِكَ لا أسأَلُكَ غيرَه ويُعطي اللهَ مِن عهودٍ ومواثيقَ ألَّا يسأَلَه غيرَه فيُقرِّبُه إلى بابِ الجنَّةِ فلمَّا قرَّبه منها انفَهَقَتْ له الجنَّةُ فإذا رأى ما فيها سكَت ما شاء اللهُ أنْ يسكُتَ ثمَّ يقولُ : يا ربِّ أدخِلْني الجنَّةَ فيقولُ جلَّ وعلا : أليس قد زعَمْتَ ألَّا تسأَلَني غيرَه ؟ وَيْلَكَ يا ابنَ آدَمَ ما أغدَرَكَ فيقولُ : يا ربِّ لا تجعَلْني أشقى خَلْقِكَ قال : فلا يزالُ يدعو حتَّى يضحَكَ جلَّ وعلا فإذا ضحِك منه أذِن له بالدُّخولِ دخولِ الجنَّةِ فإذا دخَل قيل له : تَمَنَّ كذا وتَمَنَّ كذا فيتمنَّى حتَّى تنقطِعَ به الأمانيُّ فيقولُ جلَّ وعلا : هو لكَ ومِثْلُه معه ) \nقال أبو سعيدٍ : سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ : ( هو لكَ وعشَرةُ أمثالِه ) فقال أبو هُرَيْرَةَ : حفِظْتُ : ( هو لكَ ومِثْلُه معه وذلك الرَّجُلُ آخِرُ أهلِ الجنَّةِ دخولًا )"],"grade":"صحيح","narrator":"أبو هريرة وأبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6573)، وأحمد (10906)، وابن حبان (7429)","bab":"آداب عامة › ضرب الأمثال","dorar":"sLT8e9Ez"},{"id":"س-01217","fp":"0cddc68fd9c2","stateId":675,"easy":"إذا كان في قلبك أدنى مثقال خردلة من إيمان ← تخرج من النار","cause":"فمن كان في قلبهِ أدنَى مثقالُ حبةِ خردلٍ من إيمانٍ","result":"فأخرجهُ من النارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-05729","ref":"التمهيد 19/67","text":["عن مَعْبَدِ بن هلالٍ العَنْزِيّ قال : اجتمعَ رهطٌ من أهل البصرةِ وأنا فيهم فأتينا أنسَ بن مالكٍ واستشفعنا عليه بثابتِ البُنَانِيّ فدخلنا عليهِ فأجلسَ ثابتا معهُ على السرِيرِ ، فقلتُ لا تسألوهُ عن شيء غيرِ هذا الحديثِ فقال ثابتٌ : يا أبا حمزةَ إخوانكَ من أهلِ البصرةِ جاءوا يسألونكَ عن حديثِ رسولِ اللهِ صلى الله عليه وسلم في الشفاعةِ فقال : حدثنا محمد صلى الله عليه وسلم قال : إذا كانَ يومُ القيامة ماجَ الناسُ بعضهُم في بعضٍ فيُؤْتَى آدمُ عليهِ السلامُ فيقولونَ يا آدمُ اشفعْ لنا إلى ربكَ ، فيقول : لستُ لها ولكنْ عليكُم بإبراهيمَ عليهِ السلامُ فإنه خليلُ اللهِ عز وجل ، فيُؤتى إبراهيمُ فيقول : لستُ لها ولكنْ عليكُم بموسى فإنه كليمُ اللهِ ، فيُؤتَى موسى عليه السلامُ فيقولُ : لستُ لها ولكنْ عليكُم بعيسى بن مريمَ فإنه روحُ اللهِ وكلمتُهُ ، فيُؤْتى عليهِ السلامُ فيقولُ : لستُ لها ولكن عليكم بمحمد ، فأُوتَى فأقولُ : أنا لها فأنطلقُ فأسْتأذنُ على ربي عز وجل فيُؤْذَن لي فأقوم بين يديه مقاما فيُلهِمُني فيه محامِدَ لا أقْدِرُ عليها الآن فأحمدُهُ بتلكَ المحامِدَ ثم أخِرّ له ساجدا فيقول لي : يا محمد ارفعْ رأسكَ وقُلْ تُسمَعْ وسلْ تُعْطَ واشفعْ تشفَّعْ ، فأقول : أي رب أُمّتي أمتي ، فيقال لي انطلقْ فمن كان في قلبهِ مثقالُ ذرةٍ أو مثقالُ شعيرةٍ فأخرجهُ ، فأنطلقُ فأفعلُ ثم أرجعُ فأحمدهُ بتلك المحامدَ ثم أخرُّ له ساجدا فيقال : يا محمد ارفعْ رأسكَ وقلْ يُسمَعْ وسلْ تُعطَ واشفعْ تُشفَّعْ ، فأقول : أي رب أمتي أمتي ، فيقالُ : انطلقْ ",["فمن كان في قلبهِ أدنَى مثقالُ حبةِ خردلٍ من إيمانٍ",1]," ",["فأخرجهُ من النارِ",2]," . فلما رجعنا من عند أنسٍ قلتُ لأصحابي : هل لكم في الحسنِ وهو مستخفٍ في منزلِ أبي خليفةَ في عبدِ القيسِ ، فأتيناهُ فدخلنا عليهِ فقلنا : خرجنا من عندِ أخيكَ أنسُ بن مالكٍ فلم نسمعْ مثلَ ما حدثنا في الشفاعةِ ، قال : كيفَ حدثكُم ؟ فحدثناه الحديثَ حتى إذا انتهينا قلنا لم يزِدنَا على هذا ، قال : لقدْ حدثنا هذا الحديثَ منذُ عشرينَ سنةً ولقد تركَ منه شيئا فلا أدري أنسِي الشيخُ أم كرهَ أن يحدثكموهُ فتتكلوْا ؟ ثم قال في الرابعةِ : ثم أعودُ فأخرُّ له ساجدا ثم أحمدهُ بتلكَ المحامدَ فيقالُ لي : يا محمد ارفعْ رأسكَ وقلْ يُسمعْ لكَ وسلْ تُعطَ واشفعْ تُشفَّعْ ، فأقول : أي ربِّ ائذنْ لي فيمنْ قال : لا إله إلا اللهُ صادقا قال : فيقولُ تباركَ وتعالى : ليسَ لكَ وعزتِي وجلالي وكبريائي وعظمتي لأخرجنَّ منها من قال لا إله إلا اللهُ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"مرفوع صحيح","takhrij":"أخرجه البخاري (7510)، ومسلم (193)، والنسائي في ((السنن الكبرى)) (11131)، وابن عبدالبر في ((التمهيد)) (19/66) واللفظ له","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"6zgr9PPX"},{"id":"س-01238","fp":"a91fc2fa24d8","stateId":675,"easy":"إذا كنت تصلي وتزكي وتصوم ← يشفع لك المؤمنون فتخرج من النار","cause":"كانوا في الدُّنيا مَعنا؛ يُصَلُّون بصَلاتِنا، ويُزَكُّون زَكاتَنا، ويَصومون صِيامَنا، ويَحُجُّون حَجَّنا، ويَغْزُون غَزْوَنا","result":"اذْهَبوا إلى النَّارِ، فمَن وجَدْتُموه فيها فأخْرِجوه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"المستدرك على الصحيحين 8964","srcLabel":"متفق عليه","text":["يُوضَعُ الصِّراطُ بيْن ظَهْرانَي جَهنَّمَ عليه حَسَكٌ كحَسَكِ السَّعدانِ، ثمَّ يَستجِيزُ النَّاسُ، فناجٍ مُسَلَّمٌ، ومَجروحٌ به، فمُناخٌ مُحتبَسٌ مَنكوسٌ فيها، فإذا فرَغَ اللهُ تعالَى مِنَ القضايا بيْن العِبادِ وتَفقَّدَ المؤمِنون رِجالًا كانوا في الدُّنيا؛ يُصَلُّون صَلاتَهم، ويُزَكُّون زَكاتَهم، ويَصومون صِيامَهم، ويَحُجُّون حَجَّهم، ويَغزُون غَزْوَهم، فيَقولُون: أيْ ربَّنا، عِبادٌ مِن عِبادِك ",["كانوا في الدُّنيا مَعنا؛ يُصَلُّون بصَلاتِنا، ويُزَكُّون زَكاتَنا، ويَصومون صِيامَنا، ويَحُجُّون حَجَّنا، ويَغْزُون غَزْوَنا",1],"، لا نَراهم، قال: يَقولُ: ",["اذْهَبوا إلى النَّارِ، فمَن وجَدْتُموه فيها فأخْرِجوه",2],"، قال: فيَجِدونهم وقدْ أخَذَتْهم النَّارُ على قدْرِ أعمالِهم، فمنْهم مَن أخَذَتْه إلى قَدَمَيه، ومنْهم مَن أخَذَتْه إلى رُكبَتَيْه، ومنْهم مَن أزْرَتْه، ومنْهم مَن أخَذَتْه إلى ثَدْيَيْه، ومنْهم مَن أخَذَتْه إلى عُنقِه، ولم تُغْشَ الوجوهُ، قال: فيَستخْرِجونهم، فيُطْرَحون في ماءِ الحياةِ، قِيل: يا نَبيَّ اللهِ، وما ماءُ الحياةِ؟ قال: غَسْلُ أهلِ الجنَّةِ، فيَنبُتون فيها كما تَنبُتُ الزَّرعةُ في غُثاءِ السَّيلِ، ثمَّ تَشفَعُ الأنبياءُ في كلِّ مَن كان يَشهَدُ أنْ لا إلهَ إلَّا اللهُ مُخلِصًا، فيَستخْرِجونهم منها، ثمَّ يَتحنَّنُ اللهُ برَحمتِه على مَن فيها، فما يَترُكُ فيها عبْدًا في قَلبِه مِثقالُ ذرَّةٍ مِنَ الإيمانِ، إلَّا أخْرَجَه منها."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح على شرط مسلم ولم يخرجاه","takhrij":"أخرجه البخاري (7439)، ومسلم (183)، وأحمد (11127) جميعا بنحوه مطولا.","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"0eHSpNF0"},{"id":"س-02759","fp":"7f4c53eac90e","stateId":675,"easy":"إذا لم تشرك بالله وقلت لا إله إلا الله ← يُخرجك الله من النار","cause":"مَن كان لا يُشرِكُ باللهِ شيئًا، ممَّن أرادَ اللهُ أنْ يَرحَمَه، ممَّن يَقولُ: لا إلهَ إلَّا اللهُ","result":"أنْ يُخرِجوا مِن النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-01228","ref":"تخريج المسند لشعيب 7927","text":["المعنى: أنَّ النَّاسَ قالوا لرسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا رسولَ اللهِ، هل نَرى رَبَّنا عزَّ وجلَّ يَومَ القِيامَةِ؟ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: هل تُضارُّون في القَمَرِ لَيلةَ البَدْرِ؟ قالوا: لا يا رسولَ اللهِ. قال: فهل تُضارُّون في الشَّمسِ ليس دونَها سَحابٌ؟ قالوا: لا. قال: فإنَّكم تَرَوْنه كذلك، يَجمَعُ اللهُ النَّاسَ يَومَ القِيامَةِ، فيُقالُ: مَن كان يَعبُدُ شَيئًا فليَتبَعْه، فيَتبَعُ مَن يَعبُدُ الشَّمسَ الشَّمسَ، ويَتبَعُ مَن يَعبُدُ القَمرَ القَمرَ، ويَتبَعُ مَن يَعبُدُ الطَّواغيتَ الطَّواغيتَ، وتَبقى هذه الأُمَّةُ فيها شافِعوها، أو مُنافِقوها -قال أبو كامِلٍ: شَكَّ إبراهيمُ- فيَأتيهم اللهُ عزَّ وجلَّ في صورَةٍ غَيرِ صورَتِه الَّتي يَعرِفون، فيَقولُ: أنا رَبُّكم. فيَقولون: نَعوذُ باللهِ مِنك، هذا مَكانُنا حتى يَأتِيَنا رَبُّنا، فإذا جاء رَبُّنا عَرَفْناه. فيَأتيهم اللهُ عزَّ وجلَّ في صورَتِه الَّتي يَعرِفون، فيَقولُ: أنا رَبُّكم. فيَقولون: أنت رَبُّنا. فيَتبَعونه. ويُضرَبُ الصِّراطُ بيْنَ ظَهرَيْ جَهنَّمَ، فأَكونُ أنا وأُمَّتي أَوَّلَ مَن يَجوزُه، ولا يتكَلَّمُ يَومَئذٍ إلَّا الرُّسلُ، ودَعوى الرُّسلِ يَومَئذٍ: اللَّهمَّ سَلِّمْ سَلِّمْ. وفي جَهنَّمَ كَلاليبُ مِثلُ شَوكِ السَّعْدانِ، هل رأَيتُم السَّعْدانَ؟ قالوا: نعم يا رسولَ اللهِ. قال: فإنَّها مِثلُ شَوكِ السَّعْدانِ، غَيرَ أنَّه لا يَعلَمُ قَدرَ عِظَمِها إلَّا اللهُ تَعالى، تَخطَفُ النَّاسَ بأَعمالِهم، فمِنهم الموبَقُ بِعَملِه -أو قال: الموثَقُ بِعَملِه أو المُخَردَلُ-، ومنهم المُجازى -قال أبو كامِلٍ في حَديثِهِ: شَكَّ إبراهيمُ- ومنهم المُخَردَلُ أو المُجازى ثم يتجَلَّى، حتى إذا فرَغَ اللهُ عزَّ وجلَّ مِن القَضاءِ بيْنَ العِبادِ، وأرادَ أنْ يُخرِجَ برَحمَتِه مَن أرادَ مِن أَهلِ النَّارِ أمَرَ الملائكةَ ",["أنْ يُخرِجوا مِن النَّارِ",2]," ",["مَن كان لا يُشرِكُ باللهِ شيئًا، ممَّن أرادَ اللهُ أنْ يَرحَمَه، ممَّن يَقولُ: لا إلهَ إلَّا اللهُ",1],"، فيَعرِفونَهم في النَّارِ، يَعرِفونَهم بأَثَرِ السُّجودِ، تَأكُلُ النَّارُ ابنَ آدَمَ إلَّا أَثَرَ السُّجودِ، وحرَّمَ اللهُ عزَّ وجلَّ على النَّارِ أنْ تَأكُلَ أَثَرَ السُّجودِ، فيَخرُجون مِن النَّارِ قد امتُحِشوا فيُصَبُّ عليهم ماءُ الحياةِ، فيَنبُتون كما تَنبُتُ الحبَّةُ -وقال أبو كامِلٍ: الحبَّةُ، أَيضًا- في حَميلِ السَّيلِ. ويَبقى رَجُلٌ مُقبِلٌ بوَجهِه على النَّارِ، وهو آخِرُ أَهلِ الجنَّةِ دُخولًا، فيَقولُ: أَيْ رَبِّ، اصرِفْ وَجهي عن النَّارِ؛ فإنَّه قد قشَبَني رِيحُها، وأحرَقَني دُخَانُها، فيَدعو اللهَ ما شاءَ أنْ يَدعُوَه، ثم يَقولُ اللهُ عزَّ وجلَّ: هل عسَيْتَ إنْ فُعِلَ ذلك بك أنْ تَسأَلَ غَيرَه؟ فيَقولُ: لا وعِزَّتِك لا أَسأَلُ غَيرَه. ويُعطي رَبَّه عزَّ وجلَّ مِن عُهودٍ ومَواثيقَ ما شاءَ، فيَصرِفُ اللهُ عزَّ وجلَّ وَجهَه عن النَّارِ، فإذا أقبَلَ على الجنَّةِ ورآها؛ سكَتَ ما شاء اللهُ أنْ يَسكُتَ، ثم يَقولُ: أَي رَبِّ، قَرِّبْني إلى بابِ الجنَّةِ، فيَقولُ اللهُ عزَّ وجلَّ له: أَلستَ قد أعطَيْتَ عُهودَك ومَواثيقَك أَلَّا تَسأَلَني غَيرَ ما أعطَيتُكَ؟ وَيْلَكَ يا ابنَ آدَمَ، ما أَغدَرَكَ! فيَقولُ: أَيْ رَبِّ، فيَدعو اللهَ، حتى يَقولَ له: فهل عسَيْتَ إنْ أُعطيتَ ذلك أنْ تَسأَلَ غَيرَه؟ فيَقولُ: لا وَعِزَّتِكَ لا أَسأَلُ غَيرَه. فيُعطي رَبَّه عزَّ وجلَّ ما شاء مِن عُهودٍ ومَواثيقَ، فيُقَدِّمُه إلى بابِ الجنَّةِ، فإذا قام على باب الجنَّةِ انفهَقَتْ له الجنَّةُ، فرأى ما فيها مِن الحِبَرَةِ والسُّرورِ، فيَسكُتُ ما شاء اللهُ أنْ يَسكُتَ، ثم يَقولُ: أَي رَبِّ، أَدخِلْني الجنَّةَ. فيَقولُ اللهُ عزَّ وجلَّ له: أليس قد أعطَيْتَ عُهودَك ومَواثيقَك أَلَّا تَسأَلَني غَيرَ ما أعطَيتُكَ؟ وَيْلَك يا ابنَ آدَمَ، ما أَغدَرَك! فيَقولُ: أَيْ رَبِّ، لا أَكونُ أَشقى خَلقِكَ، فلا يَزالُ يَدعو اللهَ، حتى يَضحَكَ اللهُ منه، فإذا ضحِكَ اللهُ عزَّ وجلَّ منه قال: ادخُلِ الجنَّةَ. فإذا دخَلَها قال اللهُ عزَّ وجلَّ له: تَمَنَّه. فيَسأَلُ رَبَّه عزَّ وجلَّ ويتمَنَّى، حتى إنَّ اللهَ عزَّ وجلَّ ليُذَكِّرُه، يَقولُ: مِن كذا وكذا، حتى إذا انقطَعَتْ به الأَمانِيُّ؛ قال اللهُ عزَّ وجلَّ له: لك ذلك ومِثلُه معه. قال عطاءُ بنُ يَزيدَ: وأبو سَعيدٍ الخُدرِيُّ مع أبي هُريرةَ، لا يَرُدُّ عليه مِن حَديثِه شَيئًا، حتى إذا حدَّثَ أبو هُريرةَ أنَّ اللهَ عزَّ وجلَّ قال لذلك الرَّجُلِ: ومِثلُه معه. قال أبو سعيدٍ: وعَشَرةُ أَمثالِه معه يا أبا هُريرةَ. قال أبو هُريرةَ: ما حفِظْتُ إلَّا قَولَه: ذلك لك ومِثلُه معه. قال أبو سعيدٍ: أَشهَدُ أنِّي حفِظْتُ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ قَولَه في ذلك الرَّجُلِ: لك عَشَرةُ أَمثالِه. قال أبو هُريرةَ: وذلك الرَّجُلُ آخِرُ أَهلِ الجنَّةِ دُخولًا."],"grade":"صحيح","narrator":"أبو هريرة وأبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (7437)، ومسلم (182) باختلاف يسير","bab":"إيمان › الملائكة","dorar":"xsDQipBf"},{"id":"س-04028","fp":"5f49f5be082b","stateId":675,"easy":"إذا كان في قلبك مثقال قيراط من إيمان ← تخرج من النار","cause":"فمَن عرَفْتُم في قلبِه مِثقالَ قيراطٍ مِن إيمانٍ","result":"فأخرِجوه فيُخرِجونَ بشَرًا كثيرًا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-05729","ref":"صحيح ابن حبان 183","text":["إذا مُيِّز أهلُ الجنَّةِ وأهلُ النَّارِ يدخُلُ أهلُ الجنَّةِ الجنَّةَ وأهلُ النَّارِ النَّارَ قامتِ الرُّسُلُ فشفَعوا فيُقالُ : اذهَبوا ",["فمَن عرَفْتُم في قلبِه مِثقالَ قيراطٍ مِن إيمانٍ",1]," ",["فأخرِجوه فيُخرِجونَ بشَرًا كثيرًا",2]," ثمَّ يُقالُ : اذهَبوا فمَن عرَفْتُم في قلبِه مِثقالَ خردلةٍ مِن إيمانٍ فأخرِجوه فيُخرِجونَ بشَرًا كثيرًا ثمَّ يقولُ جلَّ وعلا : أنا الآنَ أُخرِجُ بنِعمتي وبرَحمتي فيُخرِجُ أضعافَ ما أخرَجوا وأضعافَهم قدِ امتُحِشوا وصاروا فَحْمًا فيُلقَوْنَ في نَهَرٍ أو في نَهَرٍ مِن أنهارِ الجنَّةِ فتسقُطُ مُحاشُهم على حافَةِ ذلك النَّهرِ فيعُودونَ بِيضًا مِثْلَ الثَّعاريرَ فيُكتَبُ في رقابِهم : عُتقاءُ اللهِ ويُسمَّوْنَ فيها الجَهنَّميِّينَ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (14491)، والبغوي في ((مسند ابن الجعد)) (2639) باختلاف يسير، والبخاري (6558) مختصرًا.","bab":"توبة › سعة رحمة الله تعالى وأنها سبقت غضبه","dorar":"hlWJrt2Q"},{"id":"س-07583","fp":"ca30d49cf06c","stateId":675,"easy":"إذا كان في قلبك خردلة من إيمان ← تدخل الجنة","cause":"مَن كان في قَلبِه خَردَلةٌ","result":"أدخِلِ الجَنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[17],"ref":"صحيح البخاري 7509","srcLabel":"متفق عليه","text":["إذا كان يَومُ القيامةِ شُفِّعتُ، فقُلتُ: يا رَبِّ أدخِلِ الجَنَّةَ ",["مَن كان في قَلبِه خَردَلةٌ",1],"، فيَدخُلونَ، ثُمَّ أقولُ: ",["أدخِلِ الجَنَّةَ",2]," مَن كان في قَلبِه أدنى شيءٍ، فقال أنَسٌ: كَأنِّي أنظُرُ إلى أصابِعِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7509)، ومسلم (193) بنحوه","bab":"فضائل النبي وصفته ودلائل النبوة › شفقته على أمته","dorar":"r8HlyxuR"},{"id":"س-07881","fp":"44c09d130f61","stateId":675,"easy":"إذا كان في قلبك مثقال دينار من إيمان ← تخرج من النار","cause":"إخوانُنا كانوا يُصلُّونَ معنا ويصومونَ معنا ويعمَلونَ معنا","result":"اذهَبوا فمَنْ وجَدْتُم في قلبِه مِثقالَ دينارٍ مِن إيمانٍ فأخرِجوه ويُحرِّمُ اللهُ صُوَرَهم على النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-05729","otherNeedIds":[65],"ref":"تخريج صحيح ابن حبان 7377","text":["قُلْنا يا رسولَ اللهِ أنرى ربَّنا ؟ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ( هل تُضارُّونَ في رؤيةِ الشَّمسِ إذا كان يومُ صَحْوٍ ) ؟ قُلْنا : لا قال : ( هل تُضارُّونَ في رؤيةِ القمرِ ليلةَ البَدرِ إذا كان صَحْوًا ) ؟ قُلْنا : لا قال : ( فإنَّكم لا تُضارُّونَ في رؤيةِ ربِّكم إلَّا كما لا تُضارُّونَ في رؤيتِهما يُنادي مُنادٍ فيقولُ : لِيلحَقْ كلُّ قومٍ بما كانوا يعبُدونَ قال : فيذهَبُ أهلُ الصَّليبِ مع صليبِهم وأهلُ الأوثانِ مع أوثانِهم وأصحابُ كلِّ آلهةٍ مع آلهتِهم ويبقى مَن يعبُدُ اللهَ مِن بَرٍّ وفاجرٍ وغُبَّراتٌ مِن أهلِ الكِتابِ \nثمَّ يُؤتَى بجَهنَّمَ تُعرَضُ كأنَّها سرابٌ فيُقالُ لِليهودِ : ما كُنْتُم تعبُدونَ ؟ فيقولونَ : كنَّا نعبُدُ عُزَيرًا ابنَ اللهِ فيُقالُ : كذَبْتُم ما اتَّخَذ اللهُ صاحبةً ولا ولَدًا ما تُريدونَ ؟ قالوا : نُريدُ أنْ تسقِيَنا فيُقالُ : اشرَبوا فيتساقَطونَ في جَهنَّمَ ثمَّ يُقالُ للنَّصارى : ما كُنْتُم تعبُدونَ ؟ فيقولونَ : كنَّا نعبُدُ المسيحَ ابنَ اللهِ فيُقالُ : كذَبْتُم لَمْ يكُنْ له صاحبةٌ ولا ولَدٌ ماذا تُريدونَ ؟ قالوا : نُريدُ أنْ تسقِيَنا فيُقالُ : اشرَبوا فيتساقَطونَ في جَهنَّمَ حتَّى يبقى مَن يعبُدُ اللهَ مِن بَرٍّ وفاجرٍ فيُقالُ لهم ما يحبِسُكم وقد ذهَب النَّاسُ ؟ فيقولونَ : قد فارَقْناهم وإنَّا سمِعْنا مُناديًا يُنادي : لِيلحَقْ كلُّ قومٍ بما كانوا يعبُدونَ وإنَّا ننتظِرُ ربَّنا قال : فيأتيهم الجبَّارُ لا إلهَ إلَّا هو فيقولُ : أنا ربُّكم فلا يُكلِّمُه إلَّا نَبيٌّ فيُقالُ : هل بَيْنَكم وبَيْنَه آيةٌ تعرِفونَها ؟ فيقولونَ : السَّاقُ فيكشِفُ عن ساقٍ فيسجُدُ له كلُّ مُؤمِنُ ويَبقى مَن كان يسجُدُ له رياءً وسُمعةً فيذهَبُ يسجُدُ فيعُودُ ظَهرُه طَبَقًا واحدًا \nثمَّ يُؤتَى بالجِسرِ فيُجعَلُ بَيْنَ ظَهْرانَيْ جَهنَّمَ ) فقُلْنا : يا رسولَ اللهِ وما الجِسرُ ؟ قال : ( مَدْحَضةٌ مَزِلَّةٌ عليه خَطاطيفُ وكَلاليبُ وحَسَكةٌ مُفَلْطَحةٌ لها شَوكٌ عُقَيفاءُ تكونُ بنَجْدٍ يُقالُ لها : السَّعدانُ يجوزُ المُؤمِنُ كالطَّرْفِ وكالبَرْقِ وكالرِّيحِ وكأجاويدِ الخَيلِ وكالرَّاكبِ فناجٍ مُسلَّمٌ ومَخدوشٌ مُسلَّمٌ ومَكْدوسٌ في جَهنَّمَ حتَّى يمُرَّ آخِرُهم يُسحَبُ سَحبًا والحقُّ قد تبيَّن مِن المُؤمِنينَ إذا رأَوْا أنَّهم قد نجَوْا وبقي إخوانُهم يقولونَ : يا ربَّنا ",["إخوانُنا كانوا يُصلُّونَ معنا ويصومونَ معنا ويعمَلونَ معنا",1]," فيقولُ الرَّبُّ جلَّ وعلا : ",["اذهَبوا فمَنْ وجَدْتُم في قلبِه مِثقالَ دينارٍ مِن إيمانٍ فأخرِجوه ويُحرِّمُ اللهُ صُوَرَهم على النَّارِ",2]," فيأتونَهم وبعضُهم قد غاب في النَّارِ إلى قدَمَيْهِ وإلى أنصافِ ساقَيْهِ فيُخرَجونَ مِن النَّارِ ثمَّ يعُودونَ ثانيةً فيقولُ : اذهَبوا فمَنْ وجَدْتُم في قلبِه مِثقالَ نِصفِ دينارٍ مِن إيمانٍ فأخرِجوه فيُخرَجونَ مِن النَّارِ ثمَّ يعُودونَ الثَّالثةَ فيُقالُ : اذهبَوا فمَن وجَدْتُم في قلبِه حَبَّةَ إيمانٍ فأخرِجوه فيُخرَجونَ ) \nقال أبو سعيدٍ : وإنْ لَمْ تُصدِّقوني فاقرَؤوا قولَ اللهِ : {إِنَّ اللَّهَ لَا يَظْلِمُ مِثْقَالَ ذَرَّةٍ وَإِنْ تَكُ حَسَنَةً يُضَاعِفْهَا وَيُؤْتِ مِنْ لَدُنْهُ أَجْرًا عَظِيمًا} [النساء: 40] ( فتشفَعُ الملائكةُ والنَّبيُّونَ والصِّدِّيقونَ فيقولُ الجبَّارُ تبارَك وتعالى لا إلهَ إلَّا هو : بقِيَتُ شفاعتي فيقبِضُ الجبَّارُ قَبضةً مِن النَّارِ فيُخرِجُ أقوامًا قدِ امتُحِشوا فيُلقَوْنَ في نَهَرٍ يُقالُ له : الحياةُ فينبُتونَ فيه كما تنبُتُ الحِبَّةُ في حَميلِ السَّيلِ هل رأَيْتُموها إلى جانبِ الصَّخرةِ أو جانبِ الشَّجرةِ فما كان إلى الشَّمسِ منها كان أخضَرَ وما كان إلى الظِّلِّ كان أبيضَ فيخرُجونَ مِثْلَ اللُّؤلؤةِ فيُجعَلُ في رقابِهم الخواتيمُ فيدخُلونَ الجنَّةَ فيقولُ أهلُ الجنَّةِ : هؤلاء عُتَقاءُ الرَّحمنِ أدخَلهم اللهُ الجنَّةَ بغيرِ عمَلٍ عمِلوه ولا قدَمٍ قدَّموه فيُقالُ لهم : لكم ما رأَيْتُموه ومِثْلُه معه ) \nقال أبو سعيدٍ : بلَغني أنَّ الجِسرَ أدَقُّ مِن الشَّعرِ وأحَدُّ مِن السَّيفِ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (7439)، ومسلم (183) باختلاف يسير","bab":"قيامة › الشفاعة","dorar":"m0UoqPy8"},{"id":"س-06906","fp":"06f4549f9eb4","stateId":675,"easy":"إذا كان في قلبك زنة دينار من إيمان ← تخرج من النار","cause":"مَن كان في قَلبِه زِنَةُ دينارٍ مِن إيمانٍ","result":"فأَخرِجوهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-05729","ref":"تخريج كتاب السنة 634","text":["سأَلْنا رَسولَ اللهِ، فقُلنا: يا رَسولَ اللهِ، هل نَرى رَبَّنا يومَ القيامَةِ؟ قال: هَل تُضارُّونَ في القَمرِ ليلَةَ البَدرِ ليسَ دونَه سَحابٌ؟ قال: قُلنا: لا، قال: فَهل تُضارُّونَ في الشَّمسِ ليسَ دونَها سَحابٌ؟ قال: قُلنا: لا، قال: فإنَّكم تَروْنَ ربَّكم كَذلكَ يومَ القيامَةِ، قال: فيُقالُ: مَن كان يَعبُدُ شَيئًا فلْيَتبَعْهُ، فتَبِعَ الَّذينَ كانوا يَعبُدونَ الشَّمسَ الشَّمسَ، فيَتساقَطونَ في النَّارِ، وَيَتبَعُ الَّذين كانوا يَعبُدونَ القَمرَ القَمرَ، فيَتساقَطونَ في النَّارِ، ويَتبَعُ الَّذينَ كانوا يَعبُدونَ الأَوثانَ والأصنامَ الأصْنامَ، وكُلُّ مَن يَعبُدُ مِن دونِ اللهِ شَيئًا، فيَتَساقَطونَ في النَّارِ، ويَبقى المُؤمِنونَ، مُنافِقوهُم بينَ ظَهرانَيْهِم، ويَبقى أهلُ الكِتابِ، قال: وقَلَّلَهم بِيدِه، قال: فيُقالُ لَهم: ألَا تَتَّبِعونَ ما كُنتُم تَعبُدون؟ فيَقولونَ: كُنَّا نَعبُدُ اللهَ، وَلمْ نَرَ اللهَ تَعالى، قال: فَكيفَ؟ قال: فيَكشِفُ اللهُ عن ساقٍ، قال: فَلا يَبقى أحدٌ كان يَسجُدُ رياءً وسُمعةً إلَّا وَقع على قَفاهُ! قال: ثُمَّ يوضَعُ الصِّراطُ بينَ ظَهرانَيْ جَهنَّمَ، قال: وَإنَّه لَدَحْضٌ مَزَلَّةٌ، وإنَّ له كَلاليبَ وَخَطاطيفَ، قال عَبدُ الرَّحمنِ: لا أَدري، فَلعلَّه قال: حَشيشةٌ يَنبُتُ بِنَجدٍ يُقالُ له: السَّعْدانُ، قال: ونَعَتَها، قال: ثُمَّ قال: والأنْبياءُ بِجَنبَيِ الصِّراطِ، وأكثرُ قَولِهم: اللَّهمَّ سلِّمْ سلِّمْ، فأَكونُ أنا وأُمَّتي أوَّلَ مَن يَمُرُّ، أو قالَ: أوَّلَ مَن يُجِيزُ، قال: فيَمرُّون عَليه مِثلَ البَرقِ، ومِثلَ الرِّيحِ، ومِثلَ أَجاويدِ الخيلِ والرِّكابِ؛ فناجٍ مُسَلَّمٌ، ومَخدوشٌ مُكلَّمٌ، ومُكَرْدَسٌ في النَّارِ! فإذا جاوَزوا - أو قال: فإذا قَطَعوا - قال: فَما أحدُكُم في حقٍّ له فيه أَشدَّ مُناشَدةً مِنهُم في إخوانِهمُ الَّذينَ سَقَطوا في النَّارِ، فيَقولونَ: أيْ ربِّ، كنَّا نَغْزو جَميعًا، ونَحُجُّ جَميعًا، وَنعقِدُ جَميعًا، فبِمَ نَجَونا اليومَ وهلَكوا؟! قال: فيَقولُ اللهُ: انظُروا ",["مَن كان في قَلبِه زِنَةُ دينارٍ مِن إيمانٍ",1]," ",["فأَخرِجوهُ",2],"، قال: فيُخرَجونَ، ثُمَّ يَقولُ: انظُروا مَن كان في قَلبِه مِثقالُ حبَّةٍ مِن خَردلٍ مِن إيمانٍ فأَخرِجوه، ثُمَّ يَقولُ: انظُروا مَن كان في قَلبِه مِثقالُ حبَّةٍ مِن خَردلٍ مِن إيمانٍ فأَخرِجوه، قال: فيَخرُجونَ، قال: ويَقولُ أبو سَعيدٍ: بَيني وَبَينكم كتابُ اللهِ، قال عَبدُ الرَّحمنِ: فأَظُنُّه يُريدُ: {وَإِنْ كَانَ مِثْقَالَ حَبَّةٍ مِنْ خَرْدَلٍ أَتَيْنَا بِهَا وَكَفَى بِنَا حَاسِبِينَ}، قال: فيُقذَفون في نَهرٍ يُقالُ لَه: نَهرُ الحياةِ، قال: فيَنبُتونَ كَما تَنبُتُ الِحبَّةُ في حَميلِ السَّيلِ، أَمَا تَروْنَ ما يَكونُ مِنَ النَّبْتِ إلى الشَّمسِ يَكونُ أَصفَرَ، وَما يَكونُ مِنَ الظِّلِّ يَكونُ أخضَرَ؟ قالوا: يا رَسولَ اللهِ، كأنَّكَ قد رَعيْتَ الغَنمَ؟ قال: قَد رَعَيتُ الغَنمَ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده جيد على شرط مسلم","takhrij":"أخرجه أحمد (11143)، وابن أبي عاصم في ((السنة)) (634) واللفظ له، وابن خزيمة في ((التوحيد)) (2/421)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"HJOxBqDu"},{"id":"س-07858","fp":"3df202635f89","stateId":675,"easy":"إذا كنت مؤمناً ← يُفدى بك يهودي أو نصراني من النار","cause":"مؤمنٍ","result":"إلَّا يَأتي بيَهوديٍّ أو نصرانيٍّ يقولُ: هذا فدايَ مِن النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشعيب 19650","srcLabel":"مسلم","text":["ما مِن ",["مؤمنٍ",1]," يومَ القيامةِ ",["إلَّا يَأتي بيَهوديٍّ أو نصرانيٍّ يقولُ: هذا فدايَ مِن النَّارِ",2],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح بغير هذه السياقة","takhrij":"أخرجه مسلم (2767) بنحوه، وأحمد (19650) واللفظ له","bab":"قيامة › الحساب والقصاص","dorar":"kTQTpyfZ"},{"id":"س-07890","fp":"ddc1dc5d2dab","stateId":675,"easy":"إذا كان في قلبك وزن ذرة من إيمان ← تخرج من النار","cause":"مَن كان في قلبِه ما يزِنُ ذرَّةً من إيمانٍ","result":"ويشفَعون ويُخرِجونَ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-05729","ref":"مجمع الزوائد 10/362","text":["يُحمَلُ النَّاسُ على الصِّراطَ يومَ القيامةِ فتتقادَعُ بهم جَنَبَتا الصِّراطِ تقادُعَ الفَراشِ في النَّارِ فيُنجِّي اللهُ تعالى برحمتِه مَن يشاءُ قال ثُمَّ يُؤذَنُ للملائكةِ والنَّبيِّينَ والشُّهداءِ أن يشفَعوا فيشفَعونَ ويُخرِجونَ فيشفَعونَ ويُخرِجونَ زاد عفَّانُ مرَّةً ",["ويشفَعون ويُخرِجونَ",2]," ",["مَن كان في قلبِه ما يزِنُ ذرَّةً من إيمانٍ",1]],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه عبدالله بن أحمد في ((زوائد المسند)) (20440)، وابن أبي عاصم في ((السنة)) (837)، والبزار (3671) باختلاف يسير.","bab":"قيامة › الشفاعة","dorar":"YNWC9wHU","merged":2,"otherRefs":["تخريج كتاب السنة 837 (حسن)"]},{"id":"س-02429","fp":"d0ec4bbbea12","stateId":675,"easy":"إذا كنت من أهل التوحيد ← تخرج من النار وتدخل الجنة","cause":"من أهلِ التوحيدِ","result":"سيخرجُ قومٌ من النارِ من أهلِ التوحيدِ ويدخلونَ الجنةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"similar":["س-06857","س-06904"],"otherNeedIds":[67],"ref":"شرح السنة 1/117","srcLabel":"شرح السنة","text":["أنه ",["سيخرجُ قومٌ من النارِ من أهلِ التوحيدِ ويدخلونَ الجنةَ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود وابن عباس وأبو سعيد الخدري وجابر بن عبدالله وأنس بن مالك","muhaddith":"صحيح","bab":"إسلام › فضل الشهادتين","dorar":"d3pfGaro"},{"id":"س-02730","fp":"a1843eebc233","stateId":675,"easy":"إذا كنت مؤمناً ← يُخرجك الله من النار","cause":"أُناسًا مِن المؤمِنينَ","result":"ويُخرِجُ اللهُ أُناسًا مِن المؤمِنينَ مِن النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج صحيح ابن حبان 7432","srcLabel":"ابن حبان","text":["قُلْتُ لأبي سعيدٍ الخُدريِّ : أسمِعْتَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ في هذه الآيةِ: {رُبَمَا يَوَدُّ الَّذِينَ كَفَرُوا لَوْ كَانُوا مُسْلِمِينَ} [الحجر: 2] فقال : نَعم سمِعْتُه يقولُ : ",["ويُخرِجُ اللهُ أُناسًا مِن المؤمِنينَ مِن النَّارِ",2]," بعدَما يأخُذُ نِقمتَه منهم قال : لَمَّا أدخَلهم اللهُ النَّارَ مع المُشرِكينَ قال المُشرِكونَ : أليس كُنْتُم تزعُمونَ في الدُّنيا أنَّكم أولياءُ فما لكم معنا في النَّارِ ؟ فإذا سمِع اللهُ ذلكَ منهم أذِن في الشَّفاعةِ فيتشفَّعُ لهم الملائكةُ والنَّبيُّونَ حتَّى يُخرَجوا بإذنِ اللهِ فلمَّا أُخرِجوا قالوا : يا ليتَنا كنَّا مِثْلَهم فتُدرِكَنا الشَّفاعةُ فنخرُجَ مِن النَّارِ فذلكَ قولُ اللهِ جلَّ وعلا : {رُبَمَا يَوَدُّ الَّذِينَ كَفَرُوا لَوْ كَانُوا مُسْلِمِينَ} [الحجر: 2] قال : فيُسمَّوْنَ في الجنَّةِ الجَهنَّميِّينَ مِن أجلِ سوادٍ في وجوهِهم فيقولونَ : ربَّنا أذهِبْ عنَّا هذا الاسمَ قال : فيأمُرُهم فيغتسِلونَ في نهرٍ في الجنَّةِ فيذهَبُ ذلكَ منهم )"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (7432)، والطبراني في ((المعجم الأوسط)) (8110) بلفظه.","bab":"إيمان › الملائكة","dorar":"E1GjTay8"},{"id":"س-02787","fp":"a57a8e964c63","stateId":675,"easy":"إذا قلت لا إله إلا الله وفي قلبك ميزان شعيرة ← تخرج من النار","cause":"مَن قال: لا إلهَ إلَّا اللهُ ممَّن في قلبِه ميزانُ شَعيرةٍ","result":"حتى يَخْرُجَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-01228","ref":"تخريج المسند لشعيب 14721","text":["نحنُ يومَ القيامةِ على كَوْمٍ فوقَ النَّاسِ، فيُدعى بالأُمَمِ بأَوْثانِها، وما كانت تَعبُدُ، الأوَّلَ، فالأوَّلَ، ثُمَّ يأتينا رَبُّنا عزَّ وجلَّ بعدَ ذلك، فيقولُ: ما تَنتظرون؟ فيقولونَ: نَنتَظِرُ ربَّنا عزَّ وجلَّ، فيقولُ: أنا رَبُّكُم، فيقولونَ: حتى نَنظُرَ إليه، قال: فيَتَجَلَّى لهم وهو يَضحَكُ، ويُعْطي كلَّ إنسانٍ منهم مُنافِقٍ ومُؤمِنٍ نورًا، وتَغْشاهُ ظُلْمةٌ، ثُمَّ يَتْبَعونَه معهم، المُنافِقون على جِسْرِ جَهنَّمَ، فيه كَلاليبُ وحَسَكٌ يَأخُذونَ مَنْ شاءَ، ثُمَّ يُطفَأُ نورُ المُنافِقينَ، ويَنجو المُؤمِنونَ، فتَنْجو أوَّلُ زُمْرةٍ وُجوهُهم كالقَمَرِ ليلَةَ البَدْرِ، سَبعونَ ألفًا لا يُحاسَبونَ، ثُمَّ الذين يَلونَهم، كأَضْوَأِ نَجمٍ في السَّماءِ، ثُمَّ ذلك حتى تَحِلَّ الشفاعةُ، فيَشْفَعونَ ",["حتى يَخْرُجَ",2]," ",["مَن قال: لا إلهَ إلَّا اللهُ ممَّن في قلبِه ميزانُ شَعيرةٍ",1],"، فيُجْعَلُ بفِناءِ الجَنَّةِ، ويَجْعَلُ أهلَ الجَنَّةِ يُهْريقونَ عليهم مِن الماءِ، حتى يَنْبُتون نَباتَ الشَّيءِ في السَّيلِ، ويَذهَبُ حَرَقُهم، ثُمَّ يَسْألُ اللهَ عزَّ وجلَّ حتى يَجْعَلَ له الدُّنيا، وعَشَرةَ أمْثالِها."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أحمد (14721) واللفظ له، والدارمي في ((الرد على الجهمية)) (185) مختصراً، والطبراني في ((المعجم الأوسط)) (9075) باختلاف يسير","bab":"إيمان › النفاق","dorar":"UPme3nkI"},{"id":"س-03165","fp":"da2597d615c9","stateId":675,"easy":"إذا كنت مسلماً ← يُجعل مكانك في النار يهودي أو نصراني","cause":"أيُّها المُسلِمونَ","result":"ليس منكم أحَدٌ إلَّا جَعَلتُ مَكانَه في النَّارِ يهوديًّا أو نصرانيًّا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشعيب 19654","srcLabel":"أحمد","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يَجمَعُ اللهُ عزَّ وجلَّ الأُمَمَ في صَعيدٍ واحدٍ يومَ القيامةِ، فإذا بَدا للهِ عزَّ وجلَّ أنْ يَصدَعَ بيْنَ خَلقِه، مَثَّلَ لكلِّ قَومٍ ما كانوا يَعبُدونَ، فيَتبَعونَهم حتى يُقحِّمونَهم النَّارَ، ثُمَّ يَأتينا ربُّنا عزَّ وجلَّ ونحن على مَكانٍ رَفيعٍ فيَقولُ: مَن أنتم؟ فنَقولُ: نحن المُسلِمونَ، فيَقولُ: ما تَنتظِرونَ؟ فيَقولونَ: نَنتظِرُ ربَّنا عزَّ وجلَّ، قال: فيَقولُ: وهل تَعرِفونَه إنْ رَأَيتُموه؟ فيَقولونَ: نَعَمْ، فيَقولُ: كيف تَعرِفونَه ولم تَرَوْه؟ فيَقولونَ: نَعَمْ، إنَّه لا عِدلَ له، فيَتجَلَّى لنا ضاحكًا، يقولُ: أبشِروا ",["أيُّها المُسلِمونَ",1],"؛ فإنَّه ",["ليس منكم أحَدٌ إلَّا جَعَلتُ مَكانَه في النَّارِ يهوديًّا أو نصرانيًّا",2],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"قوله: \"ليس منكم أحد إلا جعلت مكانه في النار يهوديا أو نصرانيا\" صحيح","takhrij":"أخرجه أحمد (19654) واللفظ له، والدارمي في ((الرد على الجهمية)) (180) باختلاف يسير، وابن خزيمة في ((التوحيد)) (2/577) مختصراً","bab":"إيمان › توحيد الأسماء والصفات","dorar":"ofp5NH1J"},{"id":"س-05998","fp":"0202be72afd8","stateId":675,"easy":"إذا كنت مؤمناً ← تكون النار عليك برداً وسلاماً (عند الورود)","cause":"على المؤمنِ","result":"فتكونُ على المؤمنِ بَرْدصا وسَلامًا كما كانت على إبراهيمَ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"المستدرك على الصحيحين 8970","srcLabel":"الحاكم","text":["عن عَبدِ الرَّحمنِ بنِ شَيْبةَ قال: اختَلَفْنا هاهنا في الوُرودِ، فقال قومٌ: لا يَدخُلُها مُؤمنٌ، وقال آخَرون: يَدخُلونها جميعًا، ثمَّ يُنجِّي اللهُ الَّذين اتَّقَوا، فلَقِيتُ جابرَ بنَ عبدِ اللهِ، فقُلتُ له: إنَّا اختَلَفْنا فيها بالبصرةِ؛ فقال قومٌ: لا يَدخُلُها مؤمنٌ، وقال آخَرون: يَدخُلونها جميعًا، ثمَّ يُنجِّي اللهُ الَّذين اتَّقَوا، فأهْوى بإصبِعِه إلى أُذُنَيه، فقال: صُمَّتَا إنْ لم أكُنْ سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: الورودُ الدُّخولُ، لا يَبْقى بَرٌّ ولا فاجرٌ إلَّا دَخَلها، ",["فتكونُ على المؤمنِ بَرْدصا وسَلامًا كما كانت على إبراهيمَ",2],"، حتَّى إنَّ للنَّارِ -أو قال: لجَهنَّمَ- ضَجيجًا مِن نَزْفِها، ثمَّ قال: ثمَّ يُنجِّي اللهُ الَّذين اتَّقَوا ويذَرُ الظَّالِمين فيها جِثيًّا."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح الإسناد ولم يخرجاه","bab":"رقائق وزهد › تقوى الله","dorar":"FwlGctdL"},{"id":"س-06836","fp":"9a7c80e17464","stateId":675,"easy":"إذا قلت لا إله إلا الله ← لا تُترك في النار","cause":"أحدًا يقولُ : لا إلهَ إلَّا اللهُ","result":"لا أدعُ في النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-01228","ref":"تخريج كتاب السنة 828","text":["ما زِلتُ أشفعُ إلى ربِّي عزَّ و جلَّ و يشفِّعُني و أشفعُ و يشفِّعُني حتَّى أقولَ : أي ربِّ شفِّعني فيمَن قالَ : لا إلهَ إلَّا اللهُ فيقولُ : هذه لَيسَت لكَ يا محمَّدُ و لا لأحدٍ ؛ هذه لي و عزَّتي و جلالي و رحمتي ",["لا أدعُ في النَّارِ",2]," ",["أحدًا يقولُ : لا إلهَ إلَّا اللهُ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه ابن  أبي عاصم  في ((السنة)) (828) واللفظ له، وابن خزيمة في ((التوحيد)) (2/694)، وأبو  يعلى (2786)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"izk4t2Yo"},{"id":"س-06857","fp":"6b6064733d14","stateId":675,"easy":"إذا كنت من أهل القبلة ← تُخرج من النار","cause":"مَن كانَ في النَّارِ من أهلِ القِبلةِ","result":"فَيأمرُ بإخراجِ مَن كانَ في النَّارِ من أهلِ القِبلةِ فيُخرَجونَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-02429","ref":"تخريج الإحياء للعراقي 5/312","text":["إذا اجتمعَ أهلُ النَّارِ في النَّارِ ومَن شاءَ اللَّهُ معهُم من أهلِ القِبلةِ قال الكفَّارُ للمسلِمينَ ألم تَكونوا مسلِمينَ قالوا بلَى فيقولون ما أغنَى عنكُم إسلامُكم إذ أنتُم معنا في النَّارِ فيقولون : كانت لنا ذنوبٌ فأُخِذنا بِها فيسمَعَ اللَّهُ عزَّ وجلَّ ما قالوا ، ",["فَيأمرُ بإخراجِ مَن كانَ في النَّارِ من أهلِ القِبلةِ فيُخرَجونَ",2]," فإذا رأى ذلكَ الكفَّارُ قالوا : يا لَيتَنا كنَّا مسلِمينَ فنخرجَ كما أُخرِجوا ثمَّ قرأ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ :  رُبَمَا يَوَدُّ الَّذِينَ كَفَرُوا لَوْ كَانُوا مُسْلِمِينَ  [ الحجر : 2] ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"نحوه بإسناد صحيح","takhrij":"أخرجه بنحوه النسائي في ((السنن الكبرى)) (11271)، والطبراني في ((المعجم الأوسط)) (5146)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"CPyRKJwG"},{"id":"س-06904","fp":"1019798e7757","stateId":675,"easy":"إذا كنت من أهل القبلة ← تُخرج من النار","cause":"بمَن كان من أهلِ القِبلةِ","result":"فأُخْرِجُوا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-02429","ref":"تخريج كتاب السنة 843","text":["إذا اجتمع أهلُ النارِ في النارِ ومعهم مَن شاء اللهُ من أهلِ القِبلةِ يقولُ الكفارُ : أَلَمْ تكونوا مسلمينَ ؟ قالوا : بلى قالوا : فما أَغْنَى عنكم إسلامُكم و قد صِرْتُم معنا في النارِ ؟ قالوا : كانت لنا ذنوبٌ فأُخِذْنا بها فيَسْمَعُ ما قالوا فأَمَر ",["بمَن كان من أهلِ القِبلةِ",1]," ",["فأُخْرِجُوا",2]," فلما رأى ذلك أهلُ النارِ قالوا : يالَيْتَنا كنا مسلمينَ فنخرجُ كما خَرَجُوا قال : و قرأ رسولُ اللهِ الر تِلْكَ آيَاتُ الْكِتَابِ وَ قُرْآنٍ مُبِينٍ رُبَمَا يَوَدُّ الَّذِينَ كَفَرُوا لَوْ كَانُوا مُسْلِمِينَ"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (2954)، والبيهقي في ((البعث والنشور)) (79)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"dlrRpuz4"},{"id":"س-07885","fp":"ac0aeda30dee","stateId":675,"easy":"إذا كان في قلبك مثقال شعيرة من إيمان ← تخرج من النار","cause":"مَن كان في قلبِه مثقالُ شعيرةٍ","result":"فأُخْرِجُ أُناسًا من النارِ يُقالُ لهم الجَهَنَّمِيُّونَ و إنهم لَفِي الجنةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-05729","ref":"تخريج كتاب السنة 816","text":["قال أنسٌ يَلْقَى الناسُ يومَ القيامةِ ما شاء اللهُ أن يَلْقَوْا من الحُزْنِ فيقولون انطلِقوا بنا إلى آدمَ فيَشْفَعُ لنا إلى ربِّنا فينطلقون إليه فيقولون : يا آدمُ اشفَعْ لنا إلى ربِّك فيقولُ لستُ هناك ولكِنِ انطلِقوا إلى خليلِ اللهِ إبراهيمَ فيَنْطَلِقون إليه فيقولون يا إبراهيمُ اشْفَعْ لنا إلى ربِّنا فيقولُ لستُ هناك ولكن انطلِقوا إلى مَن اصطفاه اللهُ برِسالاتِه و بكلامِه قال : فينطلقون إلى موسى فيقولون اشفَعْ لنا إلى ربِّك فيقولُ : لستُ هناك ولكن انطلِقوا إلى كلمةِ اللهِ ورُوحِهِ فينطلقون إليه فيقولون : يا عيسى اشفَعْ لنا إلى ربِّك فيقولُ : لستُ هناك ولكِنِ انطلِقوا إلى مَن جاء اليومَ مغفورًا له ليس عليه ذنبٌ قال فينطلقون إلى مُحَمَّدٍ فيقولون يا مُحَمَّدُ اشفَعْ لنا إلى ربِّك قال : فيقولُ : أنا لها وأنا صاحبُها قال : فأَنْطَلِقُ حتى أَسْتَفْتِحَ بابَ الجنةِ فيُفْتَحُ لِي فأدخلُ وربي على عَرْشِهِ فأَخِرُّ ساجدًا فأَحْمَدُه بمَحَامِدَ لم يَحْمَدْهُ بها أحدٌ قبلي قال : أَحْسَبُه قال : ولا يَحْمَدُه أحدٌ بعدي قال : فيُقالُ : يا مُحَمَّدُ ارفَعْ رأسَك اشفَعْ تُشَفَّعْ قال فأقولُ يا ربِّ ! فيقولُ أَخْرِجْ ",["مَن كان في قلبِه مثقالُ شعيرةٍ",1]," قال : فأَخِرُّ ساجدًا فأَحْمَدُه بمَحامِدَ لم يَحْمَدْهُ بها أحدٌ من قبلي قال : أَحْسَبُه قال : ولا يَحْمَدُه بها أحدٌ بعدي قال : فيُقالُ : يا مُحَمَّدُ ! ارفَعْ رأسَك اشفَعْ تُشَفَّعْ قال : فأقولُ : يا ربِّ يا ربِّ ! فيقولُ أَخْرِجْ مَن كان في قلبِه أدْنَى شيءٍ قال ",["فأُخْرِجُ أُناسًا من النارِ يُقالُ لهم الجَهَنَّمِيُّونَ و إنهم لَفِي الجنةِ",2]," قال فقال رجلٌ : يا أبا حمزةَ فسَمِعْتَ هذا من رسولِ اللهِ ؟ فتغير وجهُه واشْتَدَّ عليه فقال : ما كلُّ ما نُحَدِّثُكُموه سَمِعْناه من رسولِ اللهِ ولكن لم يَكُنْ يُكَذِّبُ بعضُنا بعضًا"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (816) واللفظ له، وابن نصر المروزي في ((تعظيم قدر الصلاة)) (274)، وابن منده في ((الإيمان)) (874) بنحوه.","bab":"قيامة › الشفاعة","dorar":"E7pkQfHZ"},{"id":"س-04319","fp":"c168be7c4674","stateId":675,"easy":"إذا لم تشرك بالله ← يخرجك الله من النار","cause":"أنَّهم كانوا لا يُشرِكونَ باللهِ شيئًا","result":"قومٌ يُخرِجُهم اللهُ من النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-01228","ref":"مجمع الزوائد 10/403","text":["إنَّ أدنى أهلِ الجنَّةِ حظًّا أو نصيبًا ",["قومٌ يُخرِجُهم اللهُ من النَّارِ",2]," فيرتاحُ لهم الرَّبُّ تبارَك وتعالى ",["أنَّهم كانوا لا يُشرِكونَ باللهِ شيئًا",1]," فيَبْدونَ بالعراءِ فينبُتونَ كما ينبُتُ البَقْلُ حتَّى إذا دخَلَتِ الأرواحُ في أجسادِهم قالوا ربَّنا كالَّذي أخرَجْتَنا من النَّارِ ورجَعْتَ الأرواحَ إلى أجسادِنا فاصرِفْ وجوهَنا عنِ النَّارِ قال فيصرِفُ وجوهَهم عنِ النَّارِ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"رجاله ثقات","takhrij":"أخرجه البزار (7629)، وابن المحب الصامت في ((صفات رب العالمين)) (1673) بلفظه.","bab":"جنة › صفة أهل الجنة","dorar":"aaRs6HeX"},{"id":"س-02857","fp":"d53cb428f1b1","stateId":675,"easy":"إذا كنت مسلماً ← يُدفع إليك يوم القيامة كافر فيقال: هذا فداؤك من النار","cause":"إلى كلِّ رجلٍ منَ المسلِمينَ","result":"هذا فِداؤُكَ منَ النَّارِ","explicit":true,"ref":"صحيح ابن ماجه 3483","srcLabel":"ابن ماجة","text":["إنَّ هذِهِ الأمَّةَ مَرحومةٌ، عذابُها بأَيديها، فإذا كانَ يومُ القيامةِ، دُفِعَ ",["إلى كلِّ رجلٍ منَ المسلِمينَ",1]," رجلٌ منَ المشرِكينَ، فيقالُ: ",["هذا فِداؤُكَ منَ النَّارِ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجة (4292)، وابن عدي في ((الكامل في الضعفاء)) (6/ 64)، وابن طولون في ((فضل الرحمة)) (14) واللفظ لهم.","bab":"إيمان › الوعد","dorar":"ifF65l2x","merged":4,"otherRefs":["صحيح الجامع 778 (صحيح)","صحيح مسلم 2767 (صحيح)","صحيح الجامع 779 (صحيح)"]},{"id":"س-03220","fp":"383c19792ce8","stateId":675,"easy":"إذا صدّقت بالتوحيد ← لا تبقى في النار","cause":"ما كُنتُم فيه مِن تَصديقِكُم","result":"فلا يَبقى أحَدٌ إلَّا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"فتح البيان 7/ 145","srcLabel":"البخاري","text":["إنَّ ناسًا مِن أُمَّتي يُعَذَّبونَ بذُنوبهم فيَكونونَ في النَّارِ ما شاءَ اللهُ أن يَكونوا، ثُمَّ يُعَيِّرُهم أهلُ الشِّركِ فيَقولونَ: ما نَرى ",["ما كُنتُم فيه مِن تَصديقِكُم",1]," نَفعَكُم! ",["فلا يَبقى أحَدٌ إلَّا",2]," أخرَجَه اللهُ مِنَ النَّارِ. ثُمَّ قَرَأ رَسولُ اللهِ صلَّى الله عليه وسلَّم هذه الآيةَ."],"grade":"صحيح","narrator":"جابر بن عبد الله","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (11207)، والطبراني في ((المعجم الأوسط)) (5146) بلفظه، والبخاري (6558) بنحوه.","bab":"إيمان › فضل الإيمان","dorar":"QheIfOLJ"},{"id":"س-01239","fp":"6128a5873285","stateId":675,"easy":"إذا شهدت أن لا إله إلا الله مخلصاً ← تُستخرج من النار","cause":"مَن كان يَشهَدُ أنْ لا إلهَ إلَّا اللهُ مُخلِصًا","result":"فيَستخْرِجونهم منها","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 8964","srcLabel":"متفق عليه","text":["يُوضَعُ الصِّراطُ بيْن ظَهْرانَي جَهنَّمَ عليه حَسَكٌ كحَسَكِ السَّعدانِ، ثمَّ يَستجِيزُ النَّاسُ، فناجٍ مُسَلَّمٌ، ومَجروحٌ به، فمُناخٌ مُحتبَسٌ مَنكوسٌ فيها، فإذا فرَغَ اللهُ تعالَى مِنَ القضايا بيْن العِبادِ وتَفقَّدَ المؤمِنون رِجالًا كانوا في الدُّنيا؛ يُصَلُّون صَلاتَهم، ويُزَكُّون زَكاتَهم، ويَصومون صِيامَهم، ويَحُجُّون حَجَّهم، ويَغزُون غَزْوَهم، فيَقولُون: أيْ ربَّنا، عِبادٌ مِن عِبادِك كانوا في الدُّنيا مَعنا؛ يُصَلُّون بصَلاتِنا، ويُزَكُّون زَكاتَنا، ويَصومون صِيامَنا، ويَحُجُّون حَجَّنا، ويَغْزُون غَزْوَنا، لا نَراهم، قال: يَقولُ: اذْهَبوا إلى النَّارِ، فمَن وجَدْتُموه فيها فأخْرِجوه، قال: فيَجِدونهم وقدْ أخَذَتْهم النَّارُ على قدْرِ أعمالِهم، فمنْهم مَن أخَذَتْه إلى قَدَمَيه، ومنْهم مَن أخَذَتْه إلى رُكبَتَيْه، ومنْهم مَن أزْرَتْه، ومنْهم مَن أخَذَتْه إلى ثَدْيَيْه، ومنْهم مَن أخَذَتْه إلى عُنقِه، ولم تُغْشَ الوجوهُ، قال: فيَستخْرِجونهم، فيُطْرَحون في ماءِ الحياةِ، قِيل: يا نَبيَّ اللهِ، وما ماءُ الحياةِ؟ قال: غَسْلُ أهلِ الجنَّةِ، فيَنبُتون فيها كما تَنبُتُ الزَّرعةُ في غُثاءِ السَّيلِ، ثمَّ تَشفَعُ الأنبياءُ في كلِّ ",["مَن كان يَشهَدُ أنْ لا إلهَ إلَّا اللهُ مُخلِصًا",1],"، ",["فيَستخْرِجونهم منها",2],"، ثمَّ يَتحنَّنُ اللهُ برَحمتِه على مَن فيها، فما يَترُكُ فيها عبْدًا في قَلبِه مِثقالُ ذرَّةٍ مِنَ الإيمانِ، إلَّا أخْرَجَه منها."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح على شرط مسلم ولم يخرجاه","takhrij":"أخرجه البخاري (7439)، ومسلم (183)، وأحمد (11127) جميعا بنحوه مطولا.","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"0eHSpNF0"},{"id":"س-03199","fp":"c685f128fece","stateId":675,"easy":"إذا عملت صالحاً ← تصدر عن النار كلمح البرق","cause":"بأعمالِهم","result":"يَرِدُ النَّاسُ النَّارَ، ثُمَّ يَصدُرونَ بأعمالِهم فأوَّلُهم كلَمعِ البرقِ، ثُمَّ كمَرِّ الرِّيحِ، ثُمَّ كحُضْرِ الفرسِ، ثُمَّ كالرَّاكبِ، ثُمَّ كشدِّ الرِّحالِ، ثُمَّ كمَشيِهِم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-00626"],"otherNeedIds":[65],"ref":"المستدرك على الصحيحين 3465","srcLabel":"مسلم","text":["عنِ السُّدِّيِّ قالَ: سألتُ مُرَّةَ الهَمْدانيَّ عنْ قولِ اللهِ عزَّ وجلَّ: {وَإِنْ مِنْكُمْ إِلَّا وَارِدُهَا كَانَ عَلَى رَبِّكَ حَتْمًا مَقْضِيًّا} [مريم: 71] فحَدَّثني أنَّ عبدَ اللهِ بنَ مسعودٍ حدَّثهم عنْ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ قالَ: «",["يَرِدُ النَّاسُ النَّارَ، ثُمَّ يَصدُرونَ بأعمالِهم فأوَّلُهم كلَمعِ البرقِ، ثُمَّ كمَرِّ الرِّيحِ، ثُمَّ كحُضْرِ الفرسِ، ثُمَّ كالرَّاكبِ، ثُمَّ كشدِّ الرِّحالِ، ثُمَّ كمَشيِهِم",2],"»."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه البيهقي في ((الاعتقاد)) (ص: 203) بلفظه، الحكيم الترمذي في ((نوادر الأصول)) (991)،  والواحدي في ((التفسير)) (3/ 191) كلاهما بلفظ مقارب.","bab":"إيمان › فضل الإيمان","dorar":"YZ3iEeC4"},{"id":"س-00626","fp":"0a9b33215007","stateId":675,"easy":"إذا عملت صالحاً ← تصدر عن النار بعملك","cause":"بأعمالِهم","result":"يَرِدُ الناسُ النارَ ، ثُمَّ يَصدُرونَ عنها","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-03199","otherNeedIds":[65],"ref":"صحيح الجامع 8081","text":[["يَرِدُ الناسُ النارَ ، ثُمَّ يَصدُرونَ عنها",2]," ",["بأعمالِهم",1]," ، فأوَّلُهم كلَمْحِ البصرِ ، ثُمَّ كمرِّ الريحِ ، ثُمَّ كحضْرِ الفرَسِ ، ثُمَّ كالراكِبِ في رحْلِهِ ، ثُمَّ كشدِّ الرَّجُلِ ، ثُمَّ كمشْيِهِ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3159) باختلاف يسير، وأحمد (4128) مختصراً","bab":"آداب عامة › ضرب الأمثال","dorar":"bzgvgZjv","merged":3,"otherRefs":["السلسلة الصحيحة 311 (صحيح)","تخريج المسند لشعيب 4141 (حسن)"]},{"id":"س-02810","fp":"b9b8a5407a20","stateId":676,"easy":"إذا صمت يوماً في سبيل الله ← يباعد الله وجهك عن حر جهنم سبعين خريفاً","cause":"مَن صامَ يومًا في سَبيلِ اللَّهِ","result":"باعدَ اللَّهُ بذلِكَ اليومِ حرَّ جَهنَّمَ عَن وَجهِه ، سَبعينَ خَريفًا","explicit":true,"star":true,"similar":["س-06737","س-05927","س-02811"],"ref":"صحيح النسائي 2251","srcLabel":"متفق عليه","text":[["مَن صامَ يومًا في سَبيلِ اللَّهِ ، ",1],["باعدَ اللَّهُ بذلِكَ اليومِ حرَّ جَهنَّمَ عَن وَجهِه ، سَبعينَ خَريفًا",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه النسائي (2252) واللفظ له، وأخرجه البخاري (2840)، ومسلم (1153) باختلاف يسير","bab":"إيمان › الوعد","dorar":"lO5g9zGD","merged":2,"otherRefs":["صحيح النسائي 2244 (صحيح)"]},{"id":"س-06737","fp":"4c8e6c0a48cc","stateId":676,"easy":"إذا صمت يوماً في سبيل الله ← يبعد الله وجهك عن النار سبعين خريفاً","cause":"ما من عبدٍ يصومُ يومًا في سبيلِ اللَّهِ عزَّ وجلَّ","result":"إلَّا بعَّدَ اللَّهُ عزَّ وجلَّ بذلِكَ اليومِ وجهَهُ عنِ النَّارِ ، سبعينَ خريفًا","explicit":true,"repOf":"س-02810","ref":"صحيح النسائي 2247","text":[["ما من عبدٍ يصومُ يومًا في سبيلِ اللَّهِ عزَّ وجلَّ ،",1]," ",["إلَّا بعَّدَ اللَّهُ عزَّ وجلَّ بذلِكَ اليومِ وجهَهُ عنِ النَّارِ ، سبعينَ خريفًا",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه النسائي (2248) واللفظ له، وأخرجه البخاري (2840) مختصراً، ومسلم (1153) باختلاف يسير","bab":"صيام › فضل الصيام","dorar":"pZw4lyvH","merged":2,"otherRefs":["صحيح النسائي 2250 (صحيح)"]},{"id":"س-02316","fp":"b968933ac38a","stateId":676,"easy":"إذا صمت يوماً في سبيل الله ← يباعدك الله من النار مئة عام","cause":"ما مِن رَجُلٍ يَصومُ يَوْمًا في سَبيلِ اللهِ","result":"إلَّا باعَدَه اللهُ مِن النَّارِ مِقْدارَ مِئةِ عامٍ","explicit":true,"star":true,"similar":["س-02638"],"ref":"الأحاديث المختارة 9 / 420","srcLabel":"متفق عليه","text":["«",["ما مِن رَجُلٍ يَصومُ يَوْمًا في سَبيلِ اللهِ",1]," ",["إلَّا باعَدَه اللهُ مِن النَّارِ مِقْدارَ مِئةِ عامٍ»",2],"."],"grade":"صحيح","narrator":"عبدالله بن سفيان الأزدي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"WVlBC4G6"},{"id":"س-05927","fp":"a76705d36759","stateId":676,"easy":"إذا صمت في سبيل الله ← يبعدك من جهنم مسيرة سبعين عاماً","cause":"صِيامُ المرءِ في سَبيلِ اللهِ","result":"يُبْعِدُهُ من جَهنَّمَ مَسيرَةَ سبعِينَ عامًا","explicit":true,"repOf":"س-02810","ref":"صحيح الجامع 3847","text":[["صِيامُ المرءِ في سَبيلِ اللهِ",1]," ",["يُبْعِدُهُ من جَهنَّمَ مَسيرَةَ سبعِينَ عامًا",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري وأبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه البخاري (2840)، ومسلم (1153)، والنسائي (2245) بنحوه من راوية أبي سعيد.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"CK4SLwRS"},{"id":"س-06759","fp":"366efd5c8ee7","stateId":676,"easy":"إذا صمت ← فالصيام جُنة كجُنة القتال","cause":"الصِّيامُ","result":"جُنَّةٌ كجُنَّةِ أحدِكم مِن القتالِ","explicit":true,"similar":["س-01877","س-06738","س-06603","س-00642","س-01936"],"otherNeedIds":[31],"ref":"تخريج صحيح ابن حبان 3649","srcLabel":"مسلم","text":["أنَّ عثمانَ بنَ أبي العاصِ دعا بلبنٍ ليسقيَه فقال مُطرِّفٌ: إنِّي صائمٌ فقال عثمانُ: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( ",["الصِّيامُ",1]," ",["جُنَّةٌ كجُنَّةِ أحدِكم مِن القتالِ",2]," ) وسمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( صيامٌ حسَنٌ ثلاثةُ أيَّامٍ مِن كلِّ شهرٍ )"],"grade":"صحيح","narrator":"عثمان بن أبي العاص الثقفي","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن حبان (3649)، والبيهقي في ((شعب الإيمان)) (3295) واللفظ لهما، وابن أبي شيبة (8984) با ختلاف يسير، والنسائي في ((السنن الكبرى)) (2732) مختصرا.","bab":"صيام › فضل الصيام","dorar":"FBSz3SXV","merged":2,"otherRefs":["تخريج المسند لشعيب 16273 (صحيح)"]},{"id":"س-01877","fp":"ad9b5c37ed87","stateId":676,"easy":"إذا صمت ← فالصوم جُنة","cause":"الصَّومُ","result":"جُنَّةٌ","explicit":true,"repOf":"س-06759","ref":"مختصر المقاصد 596","text":[["الصَّومُ",1]," ",["جُنَّةٌ",2]," [يعني حديث: بيْنَما نحن مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في غزوةِ تَبوكَ وقد أَصابَنا الحَرُّ، فتفَرَّقَ القومُ حتَّى نَظرتُ، فإذا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ أقرَبَهُم مِنِّي. قالَ: فدَنوتُ منه فقلتُ: يا رسولَ اللهِ، أَنبِئْني بعملٍ يُدخِلُني الجنَّةَ ويُباعِدُني مِنَ النَّارِ. قالَ: «لقد سألتَ عنْ عظيمٍ، وإنَّه ليَسيرٌ على مَنْ يَسَّرَهُ اللهُ عليه؛ تَعبدُ اللهَ ولا تُشركُ به شيئًا، وتُقيمُ الصَّلاةَ المكتوبةَ، وتُؤتي الزَّكاةَ المفروضةَ، وتَصومُ رمضانَ». قالَ: «وإنْ شئتَ أنبأتُكَ بأبوابِ الجنَّةِ». قلتُ: أجَلْ يا رسولَ اللهِ. قالَ: «الصَّومُ جُنَّةٌ، والصَّدقةُ تُكفِّرُ الخطيئةَ، وقيامُ الرَّجلِ في جوفِ اللَّيلِ يَبتغي وجهَ اللهِ». قالَ: ثُمَّ قَرَأَ هذه الآيةَ: {تَتَجَافَى جُنُوبُهُمْ عَنِ الْمَضَاجِعِ يَدْعُونَ رَبَّهُمْ خَوْفًا وَطَمَعًا وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ} [السجدة: 16] قالَ: «وإنْ شئتَ أنبأتُكَ برأسِ الأمرِ وعمودِهِ وذُروةِ سَنامِهِ» . قالَ: قلتُ: أجَلْ يا رسولَ اللهِ. قالَ: «أمَّا رأسُ الأمرِ فالإسلامُ، وأمَّا عمودُهُ فالصَّلاةُ، وأمَّا ذُروةُ سَنامِهِ فالجهادُ في سبيلِ اللهِ، وإنْ شئتَ أنبأتُكَ بأمْلَكِ ذلك كُلِّهِ». قالَ: فسَكَتَ، فإذا راكبانِ يُوضِعانِ قِبَلَنا، فخَشيتُ أنْ يَشغلاهُ عنْ حاجتي. قالَ: فقلتُ: ما هو يا رسولَ اللهِ؟ قالَ: فأَهْوَى بإصبَعِهِ إلى فيهِ. قالَ: فقلتُ: يا رسولَ اللهِ، وإنَّا لنُؤاخذُ بما نقولُ بألسِنَتِنا؟ قالَ: «ثَكِلتكَ أمُّكَ ابنَ جَبلٍ، هل يَكُبُّ النَّاسَ على مَناخِرِهم في جهنَّمَ إلَّا حصائدُ ألسنَتِهمْ؟».]"],"grade":"صحيح","narrator":"[معاذ بن جبل]","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (5/ 12)، والنسائي (2224 )، وابن ماجة (3973 )","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"snTBq0Xu","merged":14,"otherRefs":["تخريج المسند لشعيب 9947 (صحيح)","تخريج المسند لشعيب 10176 (صحيح)","تخريج المسند لشعيب 10218 (صحيح)","تخريج المسند لشعيب 9363 (صحيح)","صحيح الترغيب 868 (صحيح)","صحيح الموارد 2166 (صحيح)","الأحكام الشرعية الكبرى 3/156 (صحيح)","تخريج صحيح ابن حبان 1723 (صحيح)","تخريج المسند لشعيب 15284 (صحيح)","المستدرك على الصحيحين 8522 (صحيح)","صحيح الترمذي 2616 (صحيح)","تخريج سير أعلام النبلاء 1/19-20 (حسن)","الأحاديث المختارة 1120 (صحيح)"]},{"id":"س-06738","fp":"53f4e0fcac04","stateId":676,"easy":"إذا صمت ← فالصيام جُنة من النار","cause":"الصِّيامُ","result":"جُنَّةٌ منَ النَّارِ","explicit":true,"repOf":"س-06759","ref":"صحيح ابن خزيمة 3/ 344","text":["عن مُطرِّفٍ قالَ: دخَلتُ علَى عثمانَ بنِ أبي العاصِ، فدَعا بلبَنٍ ليَسقيَهُ، فقُلتُ: إنِّي صائمٌ، فقالَ: إنِّي سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ: ",["الصِّيامُ",1]," ",["جُنَّةٌ منَ النَّارِ",2],"، كجُنَّةِ أحدِكُم منَ القتالِ قالَ: وصيامٌ حَسنٌ صيامُ ثلاثةِ أيَّامٍ مِن كلِّ شَهْرٍ"],"grade":"صحيح","narrator":"عثمان بن أبي العاص","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه النسائي (2230)، وابن حبان (161)، وابن أبي عاصم في ((الآحاد والمثاني)) باختلاف يسير","bab":"صيام › فضل الصيام","dorar":"V9IVtKXF","merged":6,"otherRefs":["صحيح الجامع 3878 (صحيح)","مجمع الزوائد 3/183 (حسن)","الجامع الصغير 5993 (صحيح)","تخريج المسند لشعيب 17909 (صحيح)","الزواجر عن اقتراف الكبائر 1/197 (صحيح)"]},{"id":"س-06603","fp":"5069d04ddbbb","stateId":676,"easy":"إذا صمت ← فالصوم جُنة حصينة","cause":"والصومُ","result":"جُنَّةٌ حصينةٌ","explicit":true,"repOf":"س-06759","otherNeedIds":[31],"ref":"تخريج سنن الترمذي 2/513","text":["عن كعبِ بنِ عُجرةَ قال : قال لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : أعيذُكَ باللهِ يا كعبُ بنَ عُجرةَ مِن أمراءٍ يكونونَ مِن بعدي ، فمَن غَشى أبوابَهم فصدَّقهم في كذبِهم وأعانَهم على ظلمِهم فليس مِني ولستُ منه ، ولا يَرِدُ عليَّ الحوضَ ، ومَن غَشى أبوابَهم أو لم يَغشَ فلم يصدِّقْهم في كذبِهم ولم يُعِنْهم على ظلمِهم فهو مِني وأنا منه ، وسيرِدُ عليَّ الحوضَ . يا كعبُ بنَ عُجرةَ ! الصلاةُ برهانٌ ، ",["والصومُ",1]," ",["جُنَّةٌ حصينةٌ",2]," ، والصدقةُ تُطفِئُ الخطيئةَ كما يُطفِئُ الماءُ النارَ . يا كعبُ بنَ عُجرةَ ! إنه لا يَربو لحمٌ نبَت مِن سُحتٍ إلا كانَتِ النارُ أَولى به ."],"grade":"صحيح","narrator":"كعب بن عجرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (614) بلفظه، والنسائي (4207)، والطبراني (19/ 105) (212) بنحوه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"AS7E5T0c","merged":5,"otherRefs":["تخريج صحيح ابن حبان 3416 (صحيح)","تخريج المسند لشعيب 8128 (صحيح)","مجمع الزوائد 10/239 (حسن)","المستدرك على الصحيحين 7358 (صحيح)"]},{"id":"س-00642","fp":"182f20f0cee3","stateId":676,"easy":"إذا صمت ← فالصوم جُنة من النار","cause":"الصَّومُ","result":"جُنَّةٌ منَ النَّارِ","explicit":true,"repOf":"س-06759","ref":"صحيح ابن خزيمة 3/ 525","text":["[عَن] مطرِّفٍ من بَني عامرِ بنِ صعصعةَ، أنَّ عُثمانَ بنَ أبي العاصِ الثَّقفيَّ دعا لَهُ بلبنٍ يسقيهِ، فقالَ مطرِّفٌ: إنِّي صائمٌ، فقالَ: سَمِعْتُ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ: ",["الصَّومُ",1]," ",["جُنَّةٌ منَ النَّارِ",2],"، كجُنَّةِ أحدِكُم منَ القتالِ وسَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ: صيامٌ حسنٌ، صيامُ ثلاثةِ أيَّامٍ مِنَ الشَّهرِ"],"grade":"صحيح","narrator":"عثمان بن أبي العاص الثقفي","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه النسائي (2230)، وابن حبان (161)، وابن أبي عاصم في ((الآحاد والمثاني)) (1543) باختلاف يسير","bab":"آداب عامة › ضرب الأمثال","dorar":"byPDXjJy","merged":2,"otherRefs":["صحيح الترغيب 978 (صحيح)"]},{"id":"س-02812","fp":"2fddf5303ff3","stateId":676,"easy":"إذا صمت يوماً في سبيل الله ← يجعل الله بينك وبين النار خندقاً كما بين السماء والأرض","cause":"من صامَ يومًا في سبيلِ اللَّهِ","result":"جعلَ اللَّهُ بينَهُ وبينَ النَّارِ خَندقًا كما بينَ السَّماءِ والأرضِ","explicit":true,"ref":"صحيح الترمذي 1624","srcLabel":"الترمذي","text":[["من صامَ يومًا في سبيلِ اللَّهِ ",1],["جعلَ اللَّهُ بينَهُ وبينَ النَّارِ خَندقًا كما بينَ السَّماءِ والأرضِ",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"حسن صحيح","takhrij":"أخرجه الترمذي (1624)، والروياني في ((المسند)) (1198)، والطبراني (8/281) (7921)","bab":"إيمان › الوعد","dorar":"ZstAkctr","merged":2,"otherRefs":["صحيح الترغيب 991 (صحيح)"]},{"id":"س-01936","fp":"b39f2233ee7a","stateId":676,"easy":"إذا صمت ← فالصيام جُنة حصينة من النار","cause":"الصيامُ","result":"جُنَّةٌ حصينةٌ منَ النارِ","explicit":true,"repOf":"س-06759","ref":"الجامع الصغير 5176","text":[["الصيامُ",1]," ",["جُنَّةٌ حصينةٌ منَ النارِ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (3292) بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"xjsB0USt"},{"id":"س-02076","fp":"b35bbd8221b2","stateId":676,"easy":"إذا صمت ولم تخرقه بكذب أو غيبة ← فهو جُنة لك","cause":"الصيامُ","result":"جُنَّةٌ ما لم يخرقْها بكذبٍ أو غِيبةٍ","explicit":true,"otherNeedIds":[52],"ref":"النوافح العطرة 184","srcLabel":"الطبراني","text":[["الصيامُ",1]," ",["جُنَّةٌ ما لم يخرقْها بكذبٍ أو غِيبةٍ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (4536)، وابن عدي في ((الكامل في الضعفاء)) (3/129) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"S5SPsLLa"},{"id":"س-02811","fp":"d15ba927ae87","stateId":676,"easy":"إذا صمت يوماً في سبيل الله ← يزحزحك الله عن النار سبعين خريفاً","cause":"من صامَ يومًا في سبيلِ اللَّهِ","result":"زحزحَهُ اللَّهُ عنِ النَّارِ سبعينَ خريفًا أحدُهما يقولُ سبعين والآخرُ يقولُ أربعينَ","explicit":true,"repOf":"س-02810","ref":"صحيح الترمذي 1622","text":[["من صامَ يومًا في سبيلِ اللَّهِ ",1],["زحزحَهُ اللَّهُ عنِ النَّارِ سبعينَ خريفًا أحدُهما يقولُ سبعين والآخرُ يقولُ أربعينَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح باللفظ الأول","takhrij":"أخرجه الترمذي (1622) واللفظ له، والنسائي (2246)، وابن ماجه (1718)، وأحمد (7990)","bab":"إيمان › الوعد","dorar":"JqG0pOiA"},{"id":"س-02638","fp":"87deaba5494d","stateId":676,"easy":"إذا صمت يوماً في سبيل الله ← تُباعد من النار مسيرة مئة عام","cause":"مَن صام في سبيلِ اللهِ يومًا","result":"بوعِد منَ النارِ مسيرةَ مِئةِ عامٍ","explicit":true,"repOf":"س-02316","ref":"إتحاف الخيرة المهرة 3/63","text":[["مَن صام في سبيلِ اللهِ يومًا ",1],["بوعِد منَ النارِ مسيرةَ مِئةِ عامٍ",2]],"grade":"حسن","narrator":"عمرو بن عبسة","muhaddith":"رجاله ثقات، [وروي]  بإسناد حسن","takhrij":"أخرجه عبدالرزاق في ((المصنف)) (9684)، وعبد بن حميد في ((المسند)) (303)، والطبراني في ((المعجم الأوسط)) (3249) باختلاف يسير.","bab":"إيمان › الاحتساب والنية","dorar":"rDRRuzQw"},{"id":"س-03096","fp":"d4d8fbf58f4d","stateId":676,"easy":"إذا صمت الدهر ← تضيق عليك جهنم هكذا","cause":"مَن صامَ الدَّهرَ","result":"ضُيِّقَت عليه جَهَنَّمُ هَكَذا، وقَبَضَ كَفَّه","explicit":true,"star":true,"similar":["س-02998"],"ref":"الروضة الندية 1/235","srcLabel":"أحمد","text":["\"",["مَن صامَ الدَّهرَ ",1],["ضُيِّقَت عليه جَهَنَّمُ هَكَذا، وقَبَضَ كَفَّه\"",2]," ولفظُ ابنِ حِبَّانَ: \"ضُيِّقَت عليه جَهَنَّمَ هَكَذا، وعَقَد تِسعينَ\""],"grade":"صحيح","narrator":"أبو موسى","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (19713) واللفظ له، وابن خزيمة (2154)، وابن حبان (3584) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"sqgbM1Sm"},{"id":"س-02998","fp":"58168e122750","stateId":676,"easy":"إذا صمت الدهر ← تضيق عليك جهنم (على رواية)","cause":"من صام الدَّهرَ","result":"ضيَّق اللهُ عليه جهنَّمَ حتَّى تترُكَه","explicit":true,"repOf":"س-03096","ref":"مختصر الأحكام 3/429","text":[["من صام الدَّهرَ",1]," ",["ضيَّق اللهُ عليه جهنَّمَ حتَّى تترُكَه",2]," ، وقال بيدِه هكذا وعدَّ تسعين"],"grade":"حسن","narrator":"أبو موسى الأشعري","muhaddith":"حسن غريب","takhrij":"أخرجه أحمد (19713)، والطيالسي في ((المسند)) (516) باختلاف يسير، والطوسي في ((مختصر الأحكام)) (714) واللفظ له","bab":"إيمان › الوعيد","dorar":"qRUa5WSg"},{"id":"س-02837","fp":"5c35dd981eaf","stateId":677,"easy":"إذا أعتقت رقبة ← يُعتق بكل عضو منها عضو منك من النار","cause":"مَن أعتَقَ رَقبةً","result":"كان له بعِتقِ كُلِّ عُضوٍ منه عِتقُ عُضوٍ مِن النَّارِ","explicit":true,"ref":"تخريج المسند لشعيب 9773","srcLabel":"متفق عليه","text":[["مَن أعتَقَ رَقبةً؛ ",1],["كان له بعِتقِ كُلِّ عُضوٍ منه عِتقُ عُضوٍ مِن النَّارِ",2],". حتى ذكَرَ الفَرْجَ، قال: فدَعا عليُّ بنُ حُسَينٍ غُلامًا له فأعتَقَه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6715)، ومسلم (1509)، والترمذي (1541)، والنسائي في ((السنن الكبرى)) (4875)، وأحمد (9773) واللفظ له","bab":"إيمان › الوعد","dorar":"lPadF3iy"},{"id":"س-01433","fp":"c82fee8064a8","stateId":677,"easy":"إذا أعتقت رجلاً مسلماً ← كان فكاكك من النار عضواً بعضو","cause":"وأيُّما رَجلٍ أعتَقَ رَجلًا مُسلِمًا","result":"كان فِكاكَه منَ النارِ، يُجْزى بكلِّ عُضوٍ من أعضائِه عُضوًا من أعْضائِه","explicit":true,"star":true,"similar":["س-06815"],"ref":"تخريج المسند لشعيب 18059","srcLabel":"مسلم","text":["سأَلْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ: أيُّ الليلِ أسمَعُ؟ قال: جَوفُ الليلِ الآخِرُ، ثُم قال: الصَّلاةُ مَقبولةٌ حتى تُصلِّيَ الصبْحَ، ثُم لا صلاةَ حتى تَطلُعَ الشَّمسُ، وتكونَ قِيدَ رُمحٍ، أو رُمحيْنِ، ثُم الصَّلاةُ مَقبولةٌ حتى يقومَ الظلُّ قيامَ الرمحِ، ثُم لا صلاةَ حتى تَزولَ الشَّمسُ، ثُم الصَّلاةُ مَقبولةٌ حتى تُصلِّيَ العصرَ، ثُم لا صلاةَ حتى تَغيبَ الشَّمسُ، وإذا توضَّأَ العبدُ فغسَلَ يَدَيْه، خرَّتْ خَطاياهُ من بينِ يَدَيْه، فإذا غسَلَ وَجهَه خرَّتْ خَطاياهُ من وَجهِه، وإذا غسَلَ ذِراعَيْه خرَّتْ خَطاياهُ من ذِراعَيْه، وإذا غسَلَ رِجلَيْه خرَّتْ خَطاياهُ من رِجلَيْه، قال شُعْبةُ: ولم يَذكُرْ مَسحَ الرأسِ، ",["وأيُّما رَجلٍ أعتَقَ رَجلًا مُسلِمًا",1]," ",["كان فِكاكَه منَ النارِ، يُجْزى بكلِّ عُضوٍ من أعضائِه عُضوًا من أعْضائِه",2],"، وأيُّما رَجلٍ مُسلِمٍ أعتَقَ امرأتَيْنِ مُسلِمتَيْنِ، كانَتا فِكاكَه منَ النارِ، يُجْزى بكلِّ عُضوَيْنِ من أعْضائِهما عُضوًا من أعْضائِه، وأيُّما امرأةٍ مُسلِمةٍ أعتَقَتِ امرأةً مُسلِمةً، كانت فِكاكَها منَ النارِ، تُجْزى بكلِّ عُضوٍ من أعْضائِها عُضوًا من أعْضائِها."],"grade":"صحيح","narrator":"كعب بن مرة أو مرة بن كعب","muhaddith":"صحيح لغيره دون قوله: \"أيما رجل مسلم أعتق امرأتين مسلمتين كانتا فكاكه من النار يجزى بكل عضوين من أعضائهما عضوا من أعضائه\"","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (4881)، وأحمد (18059) واللفظ له","bab":"وضوء › فضل الوضوء","dorar":"YzXRbObH","merged":6,"otherRefs":["صحيح مسلم 1509 (صحيح)","أعلام الموقعين 1/97 (صحيح)","تخريج المسند لشعيب 18061 (صحيح)","صحيح البخاري 2517 (صحيح)","المستدرك على الصحيحين 2884 (صحيح)"]},{"id":"س-06802","fp":"aae47b608e9a","stateId":677,"easy":"إذا أعتقت رجلاً مسلماً ← يجعل الله كل عظم منه وقاءً لعظم منك من النار","cause":"وأَيُّما رجُلٍ مُسلِمٍ أَعتَقَ رجُلًا مُسلِمًا","result":"فإنَّ اللهَ عزَّ وجلَّ جاعِلٌ وَفاءَ كلِّ عَظْمٍ مِن عِظامِه عَظْمًا مِن عِظامِ مُحَرِّرِه مِنَ النارِ","explicit":true,"star":true,"similar":["س-01438"],"ref":"تخريج المسند لشعيب 17022","srcLabel":"مسلم","text":["حاصَرْنا مع نَبيِّ اللهِ صلَّى اللهُ عليه وسلَّمَ حِصنَ الطائفِ، فسمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: مَن بَلَغَ بسَهمٍ فله درجةٌ في الجَنَّةِ. قال: فبلَّغْتُ يَومَئذٍ ستَّةَ عَشَرَ سَهمًا، فسمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: مَن رَمى بسَهمٍ في سبيلِ اللهِ عزَّ وجلَّ فهو عِدْلُ مُحَرَّرٍ، ومَن شابَ شَيْبةً في سبيلِ اللهِ، كانت له نورًا يَومَ القيامةِ، ",["وأَيُّما رجُلٍ مُسلِمٍ أَعتَقَ رجُلًا مُسلِمًا، ",1],["فإنَّ اللهَ عزَّ وجلَّ جاعِلٌ وَفاءَ كلِّ عَظْمٍ مِن عِظامِه عَظْمًا مِن عِظامِ مُحَرِّرِه مِنَ النارِ، ",2],"وأَيُّما امْرأةٍ مُسلِمةٍ أَعتَقَتِ امْرأةً مُسلِمةً، فإنَّ اللهَ عزَّ وجلَّ جاعِلٌ وَفاءَ كلِّ عَظْمٍ مِن عِظامِها عَظْمًا مِن عِظامِ مُحَرِّرِها مِنَ النارِ."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أبو داود (3966) مختصرا بنحوه، والترمذي (1638) مختصرا، والنسائي (3145) مختصرا باختلاف يسير، وأحمد (17022) واللفظ له","bab":"عتق وولاء › فضل العتق","dorar":"hWvbEIGM","merged":5,"otherRefs":["صحيح الترغيب 2543 (صحيح)","صحيح الترغيب 1896 (صحيح)","تخريج المسند لشعيب 20330 (صحيح)","تخريج المسند لشعيب 19428 (صحيح)"]},{"id":"س-01434","fp":"b903e71379a8","stateId":677,"easy":"إذا أعتقت امرأتين مسلمتين ← كانتا فكاكك من النار","cause":"وأيُّما رَجلٍ مُسلِمٍ أعتَقَ امرأتَيْنِ مُسلِمتَيْنِ","result":"كانَتا فِكاكَه منَ النارِ، يُجْزى بكلِّ عُضوَيْنِ من أعْضائِهما عُضوًا من أعْضائِه","explicit":true,"similar":["س-02313","س-06804","س-06792","س-01874"],"ref":"تخريج المسند لشعيب 18059","srcLabel":"مسلم","text":["سأَلْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ: أيُّ الليلِ أسمَعُ؟ قال: جَوفُ الليلِ الآخِرُ، ثُم قال: الصَّلاةُ مَقبولةٌ حتى تُصلِّيَ الصبْحَ، ثُم لا صلاةَ حتى تَطلُعَ الشَّمسُ، وتكونَ قِيدَ رُمحٍ، أو رُمحيْنِ، ثُم الصَّلاةُ مَقبولةٌ حتى يقومَ الظلُّ قيامَ الرمحِ، ثُم لا صلاةَ حتى تَزولَ الشَّمسُ، ثُم الصَّلاةُ مَقبولةٌ حتى تُصلِّيَ العصرَ، ثُم لا صلاةَ حتى تَغيبَ الشَّمسُ، وإذا توضَّأَ العبدُ فغسَلَ يَدَيْه، خرَّتْ خَطاياهُ من بينِ يَدَيْه، فإذا غسَلَ وَجهَه خرَّتْ خَطاياهُ من وَجهِه، وإذا غسَلَ ذِراعَيْه خرَّتْ خَطاياهُ من ذِراعَيْه، وإذا غسَلَ رِجلَيْه خرَّتْ خَطاياهُ من رِجلَيْه، قال شُعْبةُ: ولم يَذكُرْ مَسحَ الرأسِ، وأيُّما رَجلٍ أعتَقَ رَجلًا مُسلِمًا كان فِكاكَه منَ النارِ، يُجْزى بكلِّ عُضوٍ من أعضائِه عُضوًا من أعْضائِه، ",["وأيُّما رَجلٍ مُسلِمٍ أعتَقَ امرأتَيْنِ مُسلِمتَيْنِ",1],"، ",["كانَتا فِكاكَه منَ النارِ، يُجْزى بكلِّ عُضوَيْنِ من أعْضائِهما عُضوًا من أعْضائِه",2],"، وأيُّما امرأةٍ مُسلِمةٍ أعتَقَتِ امرأةً مُسلِمةً، كانت فِكاكَها منَ النارِ، تُجْزى بكلِّ عُضوٍ من أعْضائِها عُضوًا من أعْضائِها."],"grade":"صحيح","narrator":"كعب بن مرة أو مرة بن كعب","muhaddith":"صحيح لغيره دون قوله: \"أيما رجل مسلم أعتق امرأتين مسلمتين كانتا فكاكه من النار يجزى بكل عضوين من أعضائهما عضوا من أعضائه\"","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (4881)، وأحمد (18059) واللفظ له","bab":"وضوء › فضل الوضوء","dorar":"YzXRbObH","merged":3,"otherRefs":["تخريج المسند لشعيب 18061 (صحيح)","صحيح الترغيب 1896 (صحيح)"]},{"id":"س-01435","fp":"78301ee869ee","stateId":677,"easy":"إذا أعتقت المرأة امرأة مسلمة ← كانت فكاكها من النار","cause":"وأيُّما امرأةٍ مُسلِمةٍ أعتَقَتِ امرأةً مُسلِمةً","result":"كانت فِكاكَها منَ النارِ، تُجْزى بكلِّ عُضوٍ من أعْضائِها عُضوًا من أعْضائِها","explicit":true,"similar":["س-01439","س-02161"],"ref":"تخريج المسند لشعيب 18059","srcLabel":"مسلم","text":["سأَلْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ: أيُّ الليلِ أسمَعُ؟ قال: جَوفُ الليلِ الآخِرُ، ثُم قال: الصَّلاةُ مَقبولةٌ حتى تُصلِّيَ الصبْحَ، ثُم لا صلاةَ حتى تَطلُعَ الشَّمسُ، وتكونَ قِيدَ رُمحٍ، أو رُمحيْنِ، ثُم الصَّلاةُ مَقبولةٌ حتى يقومَ الظلُّ قيامَ الرمحِ، ثُم لا صلاةَ حتى تَزولَ الشَّمسُ، ثُم الصَّلاةُ مَقبولةٌ حتى تُصلِّيَ العصرَ، ثُم لا صلاةَ حتى تَغيبَ الشَّمسُ، وإذا توضَّأَ العبدُ فغسَلَ يَدَيْه، خرَّتْ خَطاياهُ من بينِ يَدَيْه، فإذا غسَلَ وَجهَه خرَّتْ خَطاياهُ من وَجهِه، وإذا غسَلَ ذِراعَيْه خرَّتْ خَطاياهُ من ذِراعَيْه، وإذا غسَلَ رِجلَيْه خرَّتْ خَطاياهُ من رِجلَيْه، قال شُعْبةُ: ولم يَذكُرْ مَسحَ الرأسِ، وأيُّما رَجلٍ أعتَقَ رَجلًا مُسلِمًا كان فِكاكَه منَ النارِ، يُجْزى بكلِّ عُضوٍ من أعضائِه عُضوًا من أعْضائِه، وأيُّما رَجلٍ مُسلِمٍ أعتَقَ امرأتَيْنِ مُسلِمتَيْنِ، كانَتا فِكاكَه منَ النارِ، يُجْزى بكلِّ عُضوَيْنِ من أعْضائِهما عُضوًا من أعْضائِه، ",["وأيُّما امرأةٍ مُسلِمةٍ أعتَقَتِ امرأةً مُسلِمةً",1],"، ",["كانت فِكاكَها منَ النارِ، تُجْزى بكلِّ عُضوٍ من أعْضائِها عُضوًا من أعْضائِها",2],"."],"grade":"صحيح","narrator":"كعب بن مرة أو مرة بن كعب","muhaddith":"صحيح لغيره دون قوله: \"أيما رجل مسلم أعتق امرأتين مسلمتين كانتا فكاكه من النار يجزى بكل عضوين من أعضائهما عضوا من أعضائه\"","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (4881)، وأحمد (18059) واللفظ له","bab":"وضوء › فضل الوضوء","dorar":"YzXRbObH","merged":3,"otherRefs":["تخريج المسند لشعيب 18061 (صحيح)","صحيح الترغيب 1896 (صحيح)"]},{"id":"س-06810","fp":"63bd29aacdbf","stateId":677,"easy":"إذا أعتقت رقبة مسلمة ← فهي فداؤك من النار عظماً بعظم","cause":"مَن أعتَق رَقَبةً مُسلِمةً","result":"فهي فِداؤُهُ منَ النَّارِ، عَظْمًا مِن عِظامِهِ بعَظْمٍ مِن عِظامِها","explicit":true,"similar":["س-06811"],"ref":"تخريج مشكل الآثار 732","srcLabel":"مسلم","text":["أنَّ شُرَحْبِيلَ بنَ حَسَنةَ قال: مَن رجُلٌ يُحدِّثُنا عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ فقال عمرُو بنُ عَبَسةَ: أنا، فقال: إيهِ، للهِ أبوكَ، واحذَرْ، قال: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن أعتَق رَقَبةً مُسلِمةً، ",1],["فهي فِداؤُهُ منَ النَّارِ، عَظْمًا مِن عِظامِهِ بعَظْمٍ مِن عِظامِها، ",2],"ومَن أعتَق رقَبَتَيْنِ مُسلِمَتَيْنِ فهُما فِداؤُهُ منَ النَّارِ، عَظْمًا مِن عِظامِ مُحَرَّرَيْهِ بعَظْمٍ مِن عِظامِهِ."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه الطحاوي في ((شرح المشكل)) (732) واللفظ له ، وإسماعيل الأصفهاني في ((الترغيب والترهيب)) (2221) باخنلاف يسير .","bab":"عتق وولاء › فضل العتق","dorar":"XobOrAwS","merged":3,"otherRefs":["حسن الأسوة بما ثبت في النسوة 519 (صحيح)","تخريج المسند لشعيب 19030 (صحيح)"]},{"id":"س-02313","fp":"7cdf56c9f1ee","stateId":677,"easy":"إذا أعتقت نسمة مسلمة ← يقي الله بكل عضو منها عضواً منك من النار","cause":"مَن أَعتَقَ نَسَمةً مُسلِمةً أو مُؤمِنةً","result":"وَقى اللهُ بكلِّ عُضْوٍ مِنه عُضْوًا مِن النَّارِ","explicit":true,"repOf":"س-01434","ref":"الأحاديث المختارة 703","text":["«",["مَن أَعتَقَ نَسَمةً مُسلِمةً أو مُؤمِنةً",1]," ",["وَقى اللهُ بكلِّ عُضْوٍ مِنه عُضْوًا مِن النَّارِ",2],"»."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"jYKZQy1L"},{"id":"س-06804","fp":"ce9beb914517","stateId":677,"easy":"إذا أعتقت رقبة ← يعتق الله بكل عضو منها عضواً منك","cause":"فلْيُعْتِقْ رَقَبةً","result":"فإنَّ اللهَ يُعتِقُ بكلِّ عُضوٍ منَ المُعْتَقِ عُضوًا منه","explicit":true,"repOf":"س-01434","ref":"تخريج مشكل الآثار 737","text":["عن واثِلةَ بنَحْوٍ منه. يعني حديثَ: مُروهُ ",["فلْيُعْتِقْ رَقَبةً",1],"، ",["فإنَّ اللهَ يُعتِقُ بكلِّ عُضوٍ منَ المُعْتَقِ عُضوًا منه",2],"."],"grade":"صحيح","narrator":"واثلة بن الأسقع الليثي أبو فسيلة","muhaddith":"إسناده صحيح، وقد صرح الوليد بن مسلم بالتحديث فانتفت شبهة تدليسه","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (736) بلفظه، والطبراني في ((مسند الشاميين)) (37) باختلاف يسير، وأحمد (16010) بلفظ مقارب","bab":"عتق وولاء › فضل العتق","dorar":"rZkFbmAD"},{"id":"س-06811","fp":"aa139ec9de93","stateId":677,"easy":"إذا أعتقت رقبتين مسلمتين ← فهما فداؤك من النار","cause":"ومَن أعتَق رقَبَتَيْنِ مُسلِمَتَيْنِ","result":"فهُما فِداؤُهُ منَ النَّارِ، عَظْمًا مِن عِظامِ مُحَرَّرَيْهِ بعَظْمٍ مِن عِظامِهِ","explicit":true,"repOf":"س-06810","ref":"تخريج مشكل الآثار 732","text":["أنَّ شُرَحْبِيلَ بنَ حَسَنةَ قال: مَن رجُلٌ يُحدِّثُنا عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ فقال عمرُو بنُ عَبَسةَ: أنا، فقال: إيهِ، للهِ أبوكَ، واحذَرْ، قال: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: مَن أعتَق رَقَبةً مُسلِمةً، فهي فِداؤُهُ منَ النَّارِ، عَظْمًا مِن عِظامِهِ بعَظْمٍ مِن عِظامِها، ",["ومَن أعتَق رقَبَتَيْنِ مُسلِمَتَيْنِ",1]," ",["فهُما فِداؤُهُ منَ النَّارِ، عَظْمًا مِن عِظامِ مُحَرَّرَيْهِ بعَظْمٍ مِن عِظامِهِ",2],"."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه الطحاوي في ((شرح المشكل)) (732) واللفظ له ، وإسماعيل الأصفهاني في ((الترغيب والترهيب)) (2221) باخنلاف يسير .","bab":"عتق وولاء › فضل العتق","dorar":"XobOrAwS"},{"id":"س-06792","fp":"4d2b921f2ed3","stateId":677,"easy":"إذا أعتقت رقبة مسلمة ← يعتق الله بكل عضو منها عضواً منك حتى فرجك بفرجها","cause":"مَن أعْتَقَ رَقَبَةً مُسْلِمَةً","result":"أعْتَقَ اللَّهُ بكُلِّ عُضْوٍ منه عُضْوًا مِنَ النَّارِ، حتَّى فَرْجَهُ بفَرْجِهِ","explicit":true,"repOf":"س-01434","ref":"العواصم والقواصم 9/70","text":["أحاديثُ فضلِ العتقِ [حديث أبي هريرة: ",["مَن أعْتَقَ رَقَبَةً مُسْلِمَةً، ",1],["أعْتَقَ اللَّهُ بكُلِّ عُضْوٍ منه عُضْوًا مِنَ النَّارِ، حتَّى فَرْجَهُ بفَرْجِهِ",2],".] [وحديث ابن عمر: مَن أعْتَقَ عَبْدًا بيْنَ اثْنَيْنِ، فإنْ كانَ مُوسِرًا قُوِّمَ عليه ثُمَّ يُعْتَقُ.]                                            [وحديث واثلة: عنْ إبراهيمَ بنِ أَبي عَبْلَةَ، قالَ: كنتُ جالسًا بأَرِيحاءَ، فمَرَّ بي واثِلةُ بنُ الأَسْقعِ مُتوكِّئًا على عبدِ اللهِ بنِ الدَّيلَمِيِّ، فأَجْلَسَه ثُمَّ جاءَ إليَّ، فقالَ: عَجِبْتُ ممَّا حدَّثَني هذا الشَّيخُ -يعني واثِلَةَ- قلتُ: ما حدَّثَكَ؟ فقالَ: فحَدَّثَني قالَ: كنتُ مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في غَزوَةِ تَبوكَ ، فأَتاهُ نَفَرٌ مِن بني سُلَيمٍ، فقالوا: يا رسولَ اللهِ، إنَّ صاحِبَنا قد أَوْجَبَ، قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: أَعتِقوا عنه يُعتِقِ اللهُ بكُلِّ عُضوٍ منها عُضوًا منه مِنَ النَّارِ.] [وحديث :"],"grade":"صحيح","narrator":"[أبو هريرة وعبدالله بن عمر وواثلة بن الأسقع]","muhaddith":"صحيحة شهيرة","bab":"عتق وولاء › فضل العتق","dorar":"w6l1q9ix","merged":8,"otherRefs":["الإقناع لابن المنذر 2/590 (صحيح)","عارضة الأحوذي 4/44 (صحيح)","تخريج المسند لشعيب 18896 (صحيح)","المصابيح في الأحاديث المتواترة 617 (صحيح)","تخريج المسند لشعيب 9562 (صحيح)","المستدرك على الصحيحين 2880 (صحيح)","تخريج المسند لشعيب 19437 (صحيح)"]},{"id":"س-02262","fp":"3df6425a5d11","stateId":677,"easy":"إذا أعتقت رقبة مؤمنة ← كانت فداءك من النار عضواً بعضو","cause":"ومن أعتقَ رقبةً مُؤْمِنَةً","result":"كانت لَهُ فداءَهُ منَ النَّارِ عضوًا بعضوٍ","explicit":true,"ref":"صحيح النسائي 3142","srcLabel":"الترمذي","text":["من شابَ شَيبةً في سبيلِ اللَّهِ تعالى ، كانت لَهُ نورًا يومَ القيامةِ ، ومن رَمى بسَهْمٍ في سبيلِ اللَّهِ تعالى بلغَ العدوَّ ، أو لم يبلُغ ، كانَ لَهُ كعتقِ رقبةٍ ، ",["ومن أعتقَ رقبةً مُؤْمِنَةً ، ",1],["كانت لَهُ فداءَهُ منَ النَّارِ عضوًا بعضوٍ",2]],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1635) مختصراً، والنسائي (3142) واللفظ له، وأحمد (19437) مطولاً.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"WiMjcnkt","merged":4,"otherRefs":["تخريج المسند لشعيب 17020 (صحيح)","صحيح أبي داود 3966 (صحيح)","تخريج مشكل الآثار 717 (صحيح)"]},{"id":"س-06793","fp":"0660a71cf6ff","stateId":677,"easy":"إذا أعتقتم عن ميتكم ← يعتق الله بكل عضو منها عضواً منه من النار","cause":"أَعتِقوا عنه","result":"يُعتِقِ اللهُ بكُلِّ عُضوٍ منها عُضوًا منه مِنَ النَّارِ","explicit":true,"ref":"العواصم والقواصم 9/70","srcLabel":"العواصم والقواصم","text":["أحاديثُ فضلِ العتقِ [حديث أبي هريرة: مَن أعْتَقَ رَقَبَةً مُسْلِمَةً، أعْتَقَ اللَّهُ بكُلِّ عُضْوٍ منه عُضْوًا مِنَ النَّارِ، حتَّى فَرْجَهُ بفَرْجِهِ.] [وحديث ابن عمر: مَن أعْتَقَ عَبْدًا بيْنَ اثْنَيْنِ، فإنْ كانَ مُوسِرًا قُوِّمَ عليه ثُمَّ يُعْتَقُ.]                                            [وحديث واثلة: عنْ إبراهيمَ بنِ أَبي عَبْلَةَ، قالَ: كنتُ جالسًا بأَرِيحاءَ، فمَرَّ بي واثِلةُ بنُ الأَسْقعِ مُتوكِّئًا على عبدِ اللهِ بنِ الدَّيلَمِيِّ، فأَجْلَسَه ثُمَّ جاءَ إليَّ، فقالَ: عَجِبْتُ ممَّا حدَّثَني هذا الشَّيخُ -يعني واثِلَةَ- قلتُ: ما حدَّثَكَ؟ فقالَ: فحَدَّثَني قالَ: كنتُ مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في غَزوَةِ تَبوكَ ، فأَتاهُ نَفَرٌ مِن بني سُلَيمٍ، فقالوا: يا رسولَ اللهِ، إنَّ صاحِبَنا قد أَوْجَبَ، قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["أَعتِقوا عنه",1]," ",["يُعتِقِ اللهُ بكُلِّ عُضوٍ منها عُضوًا منه مِنَ النَّارِ",2],".] [وحديث :"],"grade":"صحيح","narrator":"[أبو هريرة وعبدالله بن عمر وواثلة بن الأسقع]","muhaddith":"صحيحة شهيرة","bab":"عتق وولاء › فضل العتق","dorar":"w6l1q9ix","merged":3,"otherRefs":["تخريج العواصم والقواصم 9/ 37 (صحيح)","المستدرك على الصحيحين 2882 (صحيح)"]},{"id":"س-05176","fp":"0ceaac07c446","stateId":677,"easy":"إذا ضربت عبدك ظلماً فأعتقته ← لو لم تفعل للفحتك النار","cause":"هو حرٌّ لوجه اللهِ","result":"لو لم تفعل للَفَعَتْكَ النارُ – أو لمستْك النارُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح أبي داود 5159","srcLabel":"مسلم","text":["كنتُ أضربُ غلامًا لي فسمعتُ من خلفي صوتًا اعلم أبا مسعودٍ، للهُ أقدرُ عليك منك عليه. فالتفتُّ فإذا هو النبيُّ صلى الله عليه وسلم ، فقلتُ: يا رسولَ اللهِ ",["هو حرٌّ لوجه اللهِ",1]," تعالى. قال: أما ",["لو لم تفعل للَفَعَتْكَ النارُ – أو لمستْك النارُ",2]," - [ وفي روايةٍ ] كنتُ أضرِبُ غلامًا لي أسودَ بالسوطِ ولم يذكرْ أمرَ العتقِ."],"grade":"صحيح","narrator":"أبو مسعود عقبة بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5159) واللفظ له، وأخرجه مسلم (1659) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"a5nbykTO"},{"id":"س-01438","fp":"83b23ba61cad","stateId":677,"easy":"إذا أعتقت رجلاً مسلماً ← فكل عضو منه فداء عضو منك من النار","cause":"وأيُّما رَجُلٍ مُسلِمٍ أعتَقَ رَجُلًا مُسلِمًا","result":"فكلُّ عُضوٍ مِن المُعتَقِ بعُضوٍ مِن المُعتِقِ فِداءٌ له مِن النَّارِ","explicit":true,"repOf":"س-06802","ref":"تخريج المسند لشعيب 19439","text":["أيُّما رَجُلٍ رَمى بسَهمٍ في سَبيلِ اللهِ عزَّ وجلَّ، فبَلَغَ، مُخطِئًا أو مُصيبًا، فله مِن الأجْرِ كرَقبةٍ يُعتِقُها مِن وَلدِ إسماعيلَ، وأيُّما رَجُلٍ شاب شَيبةً في سَبيلِ اللهِ، فهي له نورٌ، ",["وأيُّما رَجُلٍ مُسلِمٍ أعتَقَ رَجُلًا مُسلِمًا،",1],[" فكلُّ عُضوٍ مِن المُعتَقِ بعُضوٍ مِن المُعتِقِ فِداءٌ له مِن النَّارِ،",2]," وأيُّما امرأةٍ مُسلِمةٍ أعتَقَتِ امرأةً مُسلِمةً، فكلُّ عُضوٍ مِن المُعتَقةِ بعُضوٍ مِن المُعتِقةِ فِداءٌ لها مِن النَّارِ، وأيُّما رَجُلٍ مُسلِمٍ قَدَّمَ للهِ عزَّ وجلَّ مِن صُلبِه ثلاثةً لم يَبلُغوا الحِنثَ، أو امرأةٍ، فهم له سُترةٌ مِن النَّارِ، وأيُّما رَجُلٍ قام إلى وُضوءٍ يُريدُ الصَّلاةَ، فأحصى الوُضوءَ إلى أماكنِه، سَلِمَ مِن كلِّ ذَنبٍ أو خَطيئةٍ له، فإنْ قام إلى الصَّلاةِ، رَفَعَه اللهُ عزَّ وجلَّ بها دَرجةً، وإنْ قَعَدَ، قَعَدَ سالمًا. فقال شُرَحبيلُ بنُ السِّمطِ: آنتَ سَمِعتَ هذا الحديثَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يا ابنَ عَبَسةَ؟ قال: نَعَمْ، والذي لا إلهَ إلَّا هو، لو أنِّي لم أسمَعْ هذا الحديثَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ غيرَ مَرَّةٍ أو مَرَّتَينِ أو ثلاثٍ أو أربعٍ أو خَمسٍ أو ستٍّ أو سَبعٍ -فانتَهى عندَ سَبعٍ-، ما حَلَفتُ -يَعني ما بالَيتُ- ألَّا أُحدِّثَ به أحَدًا مِن النَّاسِ، ولكنِّي واللهِ ما أدري عَددَ ما سَمِعتُه مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح دون قوله: \"من ولد إسماعيل\"","takhrij":"أخرجه النسائي (3142) مختصراً، وأحمد (19439) واللفظ له","bab":"وضوء › فضل الوضوء","dorar":"LicciAss"},{"id":"س-01439","fp":"5e9571c9089f","stateId":677,"easy":"إذا أعتقت المرأة امرأة مسلمة ← فكل عضو منها فداء عضو منها من النار","cause":"وأيُّما امرأةٍ مُسلِمةٍ أعتَقَتِ امرأةً مُسلِمةً","result":"فكلُّ عُضوٍ مِن المُعتَقةِ بعُضوٍ مِن المُعتِقةِ فِداءٌ لها مِن النَّارِ","explicit":true,"repOf":"س-01435","ref":"تخريج المسند لشعيب 19439","text":["أيُّما رَجُلٍ رَمى بسَهمٍ في سَبيلِ اللهِ عزَّ وجلَّ، فبَلَغَ، مُخطِئًا أو مُصيبًا، فله مِن الأجْرِ كرَقبةٍ يُعتِقُها مِن وَلدِ إسماعيلَ، وأيُّما رَجُلٍ شاب شَيبةً في سَبيلِ اللهِ، فهي له نورٌ، وأيُّما رَجُلٍ مُسلِمٍ أعتَقَ رَجُلًا مُسلِمًا، فكلُّ عُضوٍ مِن المُعتَقِ بعُضوٍ مِن المُعتِقِ فِداءٌ له مِن النَّارِ، ",["وأيُّما امرأةٍ مُسلِمةٍ أعتَقَتِ امرأةً مُسلِمةً،",1],[" فكلُّ عُضوٍ مِن المُعتَقةِ بعُضوٍ مِن المُعتِقةِ فِداءٌ لها مِن النَّارِ،",2]," وأيُّما رَجُلٍ مُسلِمٍ قَدَّمَ للهِ عزَّ وجلَّ مِن صُلبِه ثلاثةً لم يَبلُغوا الحِنثَ، أو امرأةٍ، فهم له سُترةٌ مِن النَّارِ، وأيُّما رَجُلٍ قام إلى وُضوءٍ يُريدُ الصَّلاةَ، فأحصى الوُضوءَ إلى أماكنِه، سَلِمَ مِن كلِّ ذَنبٍ أو خَطيئةٍ له، فإنْ قام إلى الصَّلاةِ، رَفَعَه اللهُ عزَّ وجلَّ بها دَرجةً، وإنْ قَعَدَ، قَعَدَ سالمًا. فقال شُرَحبيلُ بنُ السِّمطِ: آنتَ سَمِعتَ هذا الحديثَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يا ابنَ عَبَسةَ؟ قال: نَعَمْ، والذي لا إلهَ إلَّا هو، لو أنِّي لم أسمَعْ هذا الحديثَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ غيرَ مَرَّةٍ أو مَرَّتَينِ أو ثلاثٍ أو أربعٍ أو خَمسٍ أو ستٍّ أو سَبعٍ -فانتَهى عندَ سَبعٍ-، ما حَلَفتُ -يَعني ما بالَيتُ- ألَّا أُحدِّثَ به أحَدًا مِن النَّاسِ، ولكنِّي واللهِ ما أدري عَددَ ما سَمِعتُه مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح دون قوله: \"من ولد إسماعيل\"","takhrij":"أخرجه النسائي (3142) مختصراً، وأحمد (19439) واللفظ له","bab":"وضوء › فضل الوضوء","dorar":"LicciAss"},{"id":"س-01874","fp":"14abe1729030","stateId":677,"easy":"إذا أعتقت امرأتين مسلمتين ← يعتق الله بكل عضو منهما عضواً منك من النار","cause":"ومن أعتق امرأتين مسلمتين","result":"أعتق اللهُ بكلِّ عضوٍ منهما عضوا منه من النارِ","explicit":true,"repOf":"س-01434","ref":"أعلام الموقعين 1/97","text":["من أعتق امرءًا مسلمًا أعتق اللهُ بكلِّ عضوٍ منه عضوا منه من النارِ ، ",["ومن أعتق امرأتين مسلمتين ",1],["أعتق اللهُ بكلِّ عضوٍ منهما عضوا منه من النارِ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"rVA6FJmt"},{"id":"س-02161","fp":"36c8e3197a54","stateId":677,"easy":"إذا أعتقت مسلماً أو أعتقت المرأة امرأة مسلمة ← كانتا فكاكك من النار","cause":"وأيُّما امرئٍ أعتق مسلمًا – وأيُّما امرأةٍ – أعتقتِ امرأةً مسلمةً ، زاد : وأيُّما رجلٍ أعتق امرأتيْنِ مسلمتيْنِ","result":"إلَّا كانتا فُكاكَه من النارِ ، يُجزئُ مكان كلِّ عظميْنِ منهما عظمٌ من عظامِه","explicit":true,"repOf":"س-01435","ref":"صحيح أبي داود 3967","text":[["وأيُّما امرئٍ أعتق مسلمًا – وأيُّما امرأةٍ – أعتقتِ امرأةً مسلمةً ، زاد : وأيُّما رجلٍ أعتق امرأتيْنِ مسلمتيْنِ ، ",1],["إلَّا كانتا فُكاكَه من النارِ ، يُجزئُ مكان كلِّ عظميْنِ منهما عظمٌ من عظامِه",2]],"grade":"صحيح","narrator":"كعب بن مرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3967) واللفظ له، وابن ماجه (2522)، وأحمد (18064) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"11gWTXLk"},{"id":"س-06797","fp":"37a8a56e9c15","stateId":677,"easy":"إذا أعتقت نفساً مسلمة ← كانت فديتك من جهنم","cause":"ومَن أعتَقَ نَفْسًا مُسلِمةً","result":"كانتْ فِديَتَه مِن جَهنَّمَ","explicit":true,"ref":"تخريج المسند لشعيب 19440","srcLabel":"الترمذي","text":["مَن بَنى للهِ مسجدًا ليُذكَرَ اللهُ عزَّ وجلَّ فيه، بَنى اللهُ له بَيتًا في الجنَّةِ، ",["ومَن أعتَقَ نَفْسًا مُسلِمةً، ",1],["كانتْ فِديَتَه مِن جَهنَّمَ، ",2],"ومَن شاب شَيبةً في سَبيلِ اللهِ عزَّ وجلَّ، كانتْ له نورًا يومَ القيامةِ."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح دون قوله: \"من بنى لله مسجدا..\" فصحيح لغيره","takhrij":"أخرجه الترمذي (1635) مختصراً، والنسائي (688، 3142) مفرقاً مطولاً، وأحمد (19440) واللفظ له","bab":"عتق وولاء › فضل العتق","dorar":"EMZJ5ruX"},{"id":"س-06815","fp":"7c2a571839ea","stateId":677,"easy":"إذا أعتقت امرأً مسلماً ← كان فكاكك من النار عضواً بعضو","cause":"ومَن أعتَقَ امرَأً مُسلِمًا كان فَكاكَه مِنَ النَّارِ","result":"يُجزي لكُلِّ عُضوٍ مِنه عُضوًا مِنه مِنَ النَّارِ","explicit":true,"repOf":"س-01433","ref":"تخريج المسند لشعيب 19025","text":["«مَن ضَمَّ يَتيمًا بَينَ أبَوينِ مُسلِمَينِ إلى طَعامِه وشَرابِه حَتَّى يَستَغنيَ عنه، وجَبَت له الجَنَّةُ البَتَّةَ، ",["ومَن أعتَقَ امرَأً مُسلِمًا كان فَكاكَه مِنَ النَّارِ، ",1],["يُجزي لكُلِّ عُضوٍ مِنه عُضوًا مِنه مِنَ النَّارِ»",2]],"grade":"صحيح","narrator":"مالك بن الحارث","muhaddith":"صحيح لغيره","bab":"عتق وولاء › فضل العتق","dorar":"KJgkQisX"},{"id":"س-06832","fp":"fca5a424c39b","stateId":677,"easy":"إذا كنت يوم عرفة ← فما من يوم أكثر عتقاً من النار منه","cause":"من يومِ عرفةَ","result":"ما من يومٍ أكثرَ من أن يَعتقَ اللهُ فيه عبدًا ، و أمَةً من النَّارِ","explicit":true,"star":true,"apply":{"k":"time","t":"يوم عرفة"},"ref":"صحيح الجامع 5796","srcLabel":"مسلم","text":[["ما من يومٍ أكثرَ من أن يَعتقَ اللهُ فيه عبدًا ، و أمَةً من النَّارِ",2]," ، ",["من يومِ عرفةَ",1]," ، و إنه لَيدْنو ، ثم يُباهي بهم الملائكةَ فيقولُ : ماذا أراد هؤلاءِ . [ قال الشيخُ في \" السلسلةِ الصحيحةِ \" تحت الرقم : 2551 ( زيادة : أو أمَة ، لا أصل لها ) ]"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1348) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"NGDQVg04","merged":3,"otherRefs":["فضائل بيت الله الحرام 154 (صحيح)","صحيح الترغيب 1154 (صحيح)"]},{"id":"س-02876","fp":"cefaa74233ca","stateId":677,"easy":"إذا أعتقت رقبة مؤمنة ← يعتق الله بكل جزء منها جزءاً منك من النار","cause":"مَن أعتَقَ رَقَبةً مُؤمِنةً","result":"أعتَقَ اللهُ بكُلِّ إرْبٍ منها إرْبًا منه مِن النَّارِ، حتى إنَّه ليُعتِقُ باليَدِ اليَدَ، وبالرِّجْلِ الرِّجْلَ، وبالفَرْجِ الفَرْجَ","explicit":true,"ref":"تخريج المسند لشعيب 9441","srcLabel":"متفق عليه","text":[["مَن أعتَقَ رَقَبةً مُؤمِنةً، ",1],["أعتَقَ اللهُ بكُلِّ إرْبٍ منها إرْبًا منه مِن النَّارِ، حتى إنَّه ليُعتِقُ باليَدِ اليَدَ، وبالرِّجْلِ الرِّجْلَ، وبالفَرْجِ الفَرْجَ",2],". فقال عليُّ بنُ حُسَيْنٍ: أأنتَ سمِعتَ هذا مِن أبي هُرَيرةَ؟ فقال سَعيدٌ: نَعَمْ، فقال عليُّ بنُ حُسَينٍ لِغُلامٍ له أفرَهَ غِلْمانِه: ادْعُ لي مُطَرِّفًا. قال: فلمَّا قامَ بَينَ يَدَيْه قال: اذهَبْ فأنتَ حُرٌّ لوَجْهِ اللهِ عزَّ وجلَّ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (6715)، ومسلم (1509)، والترمذي (1541)، والنسائي في ((السنن الكبرى)) (4875)، وأحمد (9441) واللفظ له","bab":"إيمان › الوعد","dorar":"KAX87QuK"},{"id":"س-08388","fp":"d34f94f01827","stateId":678,"easy":"إذا تصدقت ولو بشق تمرة ← تتقي النار","cause":"ولو بشِقِّ تَمرةٍ","result":"اتَّقوا النَّارَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 19381","srcLabel":"أحمد","text":["جاءتْ خَيلُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ -أو قال: رُسُلُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ-، وأنا بعَقرَبٍ، فأخَذوا عَمَّتي وناسًا، قال: فلمَّا أتَوْا بهم رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال: فصَفُّوا له، قالتْ: يا رسولَ اللهِ، نَأى الوافِدُ، وانقطَعَ الوَلدُ، وأنا عَجوزٌ كَبيرةٌ، ما بي مِن خِدْمةٍ، فمُنَّ علَيَّ، مَنَّ اللهُ عليك، قال: مَن وافدُكِ؟ قالتْ: عَديُّ بنُ حاتمٍ، قال: الذي فَرَّ مِن اللهِ ورسولِه؟ قالتْ: فمَنَّ علَيَّ، قالتْ: فلمَّا رَجَعَ ورَجُلٌ إلى جَنبِه نَرى أنَّه علِيٌّ، قال: سَليه حُملانًا، قال: فسَأَلَتْه، فأمَرَ لها، قالتْ: فأتاني، فقالتْ: لقد فَعَلتَ فَعلةً ما كان أبوكَ يَفعَلُها، قالتْ: ائْتِه راغبًا أو راهبًا؛ فقد أتاه فُلانٌ، فأصابَ منه، وأتاه فُلانٌ، فأصابَ منه، قال: فأتَيتُه، فإذا عندَه امرأةٌ وصِبْيانٌ -أو صَبيٌّ-، فذَكَرَ قُرْبَهم مِن النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فعَرَفتُ أنَّه ليس مُلكُ كِسرى ولا قَيصرَ، فقال له: يا عَديُّ بنَ حاتمٍ، ما أفَرَّكَ أنْ يُقالَ: لا إلهَ إلَّا اللهُ؟ فهل مِن إلهٍ إلَّا اللهُ؟ ما أفَرَّكَ أنْ يُقالَ: اللهُ أكبرُ؟ فهل شيءٌ هو أكبرُ مِن اللهِ عزَّ وجلَّ؟ قال: فأسلَمتُ، فرَأَيتُ وَجهَه استبشَرَ، وقال: إنَّ المَغضوبَ عليهم اليهودُ، وإنَّ الضَّالِّينَ النَّصارى، ثُمَّ سَأَلوه، فحَمِدَ اللهَ تَعالى، وأثْنى عليه، ثُمَّ قال: أمَّا بعدُ، فلكم أيُّها النَّاسُ أنْ تَرتضِخوا مِن الفَضلِ، ارتضَخَ امرُؤٌ بصاعٍ، ببعضِ صاعٍ، بقَبضةٍ، ببعضِ قَبضةٍ -قال شُعبةُ: وأكثرُ عِلمي أنَّه قال: بتَمرةٍ، بشِقِّ تَمرةٍ- وإنَّ أحَدَكم لاقي اللهِ عزَّ وجلَّ، فقائلٌ ما أقولُ: ألمْ أجعَلْكَ سَميعًا بَصيرًا؟ ألمْ أجعَلْ لك مالًا ووَلدًا؟ فماذا قَدَّمتَ؟ فيَنظُرُ مِن بيْنِ يدَيه، ومِن خَلْفِه، وعن يَمينِه، وعن شِمالِه، فلا يَجِدُ شيئًا، فما يَتَّقي النَّارَ إلَّا بوَجهِه، ف",["اتَّقوا النَّارَ",2]," ",["ولو بشِقِّ تَمرةٍ",1],"، فإنْ لم تَجِدوه فبكَلِمةٍ لَيِّنةٍ، إنِّي لا أخشى عليكم الفاقةَ، ليَنصُرَنَّكم اللهُ تَعالى، وليُعطيَنَّكم -أو ليَفتَحَنَّ لكم- حتى تَسيرَ الظَّعينةُ بيْنَ الحِيرةِ ويَثرِبَ، إنَّ أكثرَ ما تَخافُ السَّرَقَ على ظَعينتِها. قال محمَّدُ بنُ جَعفَرٍ: حَدَّثَناه شُعبةُ ما لا أُحصيه وقَرَأتُه عليه."],"grade":"صحيح","narrator":"عدي بن حاتم الطائي","muhaddith":"بعضه صحيح","takhrij":"أخرجه أحمد (19381) واللفظ له، وابن حبان (7206)، والطبراني (17/100) (237)","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"TxXrHh9E","merged":13,"otherRefs":["الزواجر عن اقتراف الكبائر 1/193 (صحيح)","تخريج صحيح ابن حبان 666 (صحيح)","صحيح مسلم 1016 (صحيح)","تخريج المسند لشعيب 19387 (صحيح)","الفوائد المنتخبة 259 (صحيح)","صحيح النسائي 2552 (صحيح)","صحيح الترغيب 865 (حسن)","صحيح البخاري 6023 (صحيح)","تخريج المسند لشعيب 18254 (صحيح)","صحيح البخاري 3595 (صحيح)","صحيح البخاري 1413 (صحيح)"]},{"id":"س-06376","fp":"7601f7ac3cef","stateId":678,"easy":"إذا تصدقتِ ← تتقين النار (فأكثر النساء حطب جهنم)","cause":"تصدَّقنَ","result":"فإنَّ أَكْثرَكُنَّ حَطبُ جَهَنَّم","explicit":true,"star":true,"similar":["س-06402","س-01910","س-02252"],"ref":"صحيح النسائي 1574","srcLabel":"متفق عليه","text":["شَهِدْتُ الصَّلاةَ معَ رسولِ اللَّهِ في يومِ عيدٍ ، فبدأَ بالصَّلاةِ قبلَ الخطبةِ بغيرِ أذانٍ ولا إقامةٍ ، فلمَّا قضى الصَّلاةَ قامَ متوَكِّئًا على بلالٍ ، فحمدَ اللَّهَ وأثنى علَيهِ ، ووعظَ النَّاسَ وذَكَّرَهُم وحثَّهم على طاعتِهِ ، ثمَّ مالَ ومضى إلى النِّساءِ ومعَهُ بلالٌ ، فأمرَهُنَّ بتقوى اللَّهِ ووعظَهُنَّ وذَكَّرَهُنَّ وحمدَ اللَّهَ ، وأثنى علَيهِ ، ثمَّ حثَّهنَّ على طاعتِهِ ، ثمَّ قالَ : ",["تصدَّقنَ ",1],["فإنَّ أَكْثرَكُنَّ حَطبُ جَهَنَّم ",2],"، فقالتِ امرأةٌ من سِفلةِ النِّساءِ سَفعاءُ الخدَّينِ : بمَ يا رسولَ اللَّهِ ؟ قالَ : تُكْثرنَ الشَّكاةَ ، وتَكْفُرنَ العَشيرَ ، فجعلنَ ينزعنَ قلائدَهُنَّ ، وأقرُطَهُنَّ ، وخواتيمَهُنَّ يقذِفنَهُ في ثوبِ بلالٍ يَتصدَّقنَ بِهِ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه البخاري (961)، ومسلم (885)، والنسائي (1575) واللفظ له، وأحمد (14420)","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"PTOwSmyq","merged":8,"otherRefs":["تخريج صحيح ابن حبان 7478 (صحيح)","تخريج مشكل الآثار 2728 (صحيح)","الأحكام الوسطى 2/ 74 (صحيح)","حلية الأولياء 3/371 (صحيح)","صحيح ابن حبان 3323 (صحيح)","تخريج المسند لشعيب 4151 (صحيح)","صحيح الترمذي 2613 (صحيح)"]},{"id":"س-06250","fp":"d030c9448cfb","stateId":678,"easy":"إذا استطعت أن تقي وجهك حر النار ولو بشق تمرة ← فافعل","cause":"ولو بشقِّ تمرةٍ فليفعَلْ","result":"فمن استطاعَ منْكم أن يقِيَ وجْهَهُ حرَّ النَّارِ","explicit":true,"star":true,"ref":"صحيح الترمذي 2415","srcLabel":"متفق عليه","text":["ما منْكم من رجلٍ إلاَّ سيُكلِّمُهُ ربُّهُ يومَ القيامةِ وليسَ بينَهُ وبينَهُ تُرجَمانٌ . فينظرُ أيمنَ منْهُ فلاَ يرى شيئًا إلاَّ شيئًا قدَّمَهُ ، ثمَّ ينظرُ أشأمَ منْهُ فلاَ يرى شيئًا إلاَّ شيئًا قدَّمَهُ ، ثمَّ ينظرُ تلقاءَ وجْهِهِ فتستقبلُهُ النَّارُ . قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّمَ : ",["فمن استطاعَ منْكم أن يقِيَ وجْهَهُ حرَّ النَّارِ",2]," ",["ولو بشقِّ تمرةٍ فليفعَلْ",1]],"grade":"صحيح","narrator":"عدي بن حاتم الطائي","muhaddith":"صحيح","takhrij":"أخرجه البخاري (7512)، ومسلم (1016)، والترمذي (2415) واللفظ له، وابن ماجه (185)، وأحمد (18246)","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"zlU0bKZv","merged":3,"otherRefs":["تخريج المسند لشعيب 18246 (صحيح)","صحيح البخاري 6539 (صحيح)"]},{"id":"س-07154","fp":"09ecd43dbc0b","stateId":678,"easy":"إذا أديت زكاة مالك ← فليس بكنز","cause":"إذا أدَّيتِ زَكاتَه","result":"فليس بكَنزٍ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 1456","srcLabel":"البخاري","text":["عنْ أُمِّ سَلَمةَ: أنَّها كانتْ تَلبَسُ أوضاحًا من ذَهَبٍ فسألتْ عنْ ذلكَ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ فقالتْ: أكَنزٌ هو؟ فقالَ: ",["إذا أدَّيتِ زَكاتَه",1]," ",["فليس بكَنزٍ",2],"."],"grade":"صحيح","narrator":"أم سلمة","muhaddith":"صحيح على شرط البخاري","takhrij":"أخرجه الطبراني (23/ 281) (613)، والبيهقي (7314) واللفظ لهما، و أبو داوود (1564) باختلاف يسير.","bab":"علم › حسن السؤال ونصح العالم","dorar":"sHNmmD2H","merged":3,"otherRefs":["تخريج شرح السنة 5/477 (حسن)","مجموع فتاوى ابن باز 104/14 (صحيح)"]},{"id":"ق-1444","fp":"e8cb8def80c7","stateId":678,"easy":"إيتاء المال تزكّياً ابتغاء وجه الله (التقوى) ← التجنيب من النار والرضا","cause":"إيتاء المال تزكّياً ابتغاء وجه الله (التقوى)","result":"التجنيب من النار والرضا","explicit":true,"otherNeedIds":[5,23],"ref":"سورة الليل: 17–21","srcLabel":"القرآن الكريم","quran":{"s":92,"from":17,"to":21,"text":"وَسَيُجَنَّبُهَا الْأَتْقَى (17) الَّذِي يُؤْتِي مَالَهُ يَتَزَكَّى (18) وَمَا لِأَحَدٍ عِنْدَهُ مِنْ نِعْمَةٍ تُجْزَى (19) إِلَّا ابْتِغَاءَ وَجْهِ رَبِّهِ الْأَعْلَى (20) وَلَسَوْفَ يَرْضَى (21)","hl":[[0,191,1]]}},{"id":"س-06402","fp":"d5ab43aaa5c1","stateId":678,"easy":"إذا تصدقتِ ولو من حليك ← تتقين النار","cause":"تَصَدَّقنَ ولَو مِن حُليِّكُنَّ","result":"فإنَّكُنَّ أكثَرُ أهلِ جَهَنَّمَ يَومَ القيامةِ","explicit":true,"repOf":"س-06376","ref":"تخريج المسند لشعيب 27048","text":["عن زَينَبَ، قالت: خَطَبَنا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: «يا مَعشَرَ النِّساءِ، ",["تَصَدَّقنَ ولَو مِن حُليِّكُنَّ",1],"؛ ",["فإنَّكُنَّ أكثَرُ أهلِ جَهَنَّمَ يَومَ القيامةِ",2],"». قالت: وكان عَبدُ اللهِ رَجُلًا خَفيفَ ذاتِ اليَدِ، فقُلتُ له: سَلْ لي رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم: أيُجزِئُ عنِّي مِنَ الصَّدَقةِ النَّفَقةُ على زَوجي وأيتامٍ في حِجري؟ قالت: وكان رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم قد أُلقيَت عليه المَهابةُ، فقال: اذهَبي أنتِ فاسأليه. قالت: فانطَلَقتُ، فانتَهَيتُ إلى بابِه، فإذا عليه امرَأةٌ مِنَ الأنصارِ اسمُها زَينَبُ، حاجَتي حاجَتُها، قالت: فخَرَجَ علينا بلالٌ، قالت: فقُلنا له: سَلْ لَنا رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم: أيُجزِئُ عنَّا مِنَ الصَّدَقةِ النَّفَقةُ على أزواجِنا وأيتامٍ في حُجورِنا؟ قالت: فدَخَلَ عليه بلالٌ، فقال: على البابِ زَينَبُ، فقال: «أيُّ الزَّيانِبِ؟» قالت: فقال: زَينَبُ امرَأةُ عَبدِ اللهِ، وزَينَبُ امرَأةٌ مِنَ الأنصارِ، تَسألانِكَ عنِ النَّفَقةِ على أزواجِهما، وأيتامٍ في حُجورِهما، أيُجزِئُ ذلك عنهما مِنَ الصَّدَقةِ؟ قالت: فخَرَجَ إلينا، فقال: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: \"لهما أجرانِ: أجرُ القَرابةِ، وأجرُ الصَّدَقةِ\""],"grade":"صحيح","narrator":"زينب","muhaddith":"صحيح","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"bTcjhtIl","merged":3,"otherRefs":["المستدرك على الصحيحين 9008 (صحيح)","المستدرك على الصحيحين 2810 (صحيح)"]},{"id":"س-07956","fp":"37f1cbbf67fb","stateId":678,"easy":"إذا أنظرت معسراً أو وضعت عنه ← يقيك الله من فيح جهنم","cause":"من أنظَر معسِرًا أو وضع له","result":"وقاه اللهُ عزَّ وجلَّ من فَيْحِ جهنَّمَ","explicit":true,"ref":"الترغيب والترهيب 2/77","srcLabel":"الترغيب والترهيب","text":["دخل رسولُ اللهِ صلَّى اللهُ عليه وسلَّم المسجدَ وهو يقولُ أيُّكم يسرُّه أن يقِيَه اللهُ عزَّ وجلَّ من فَيْحِ جهنَّمَ قلنا يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّم كلُّنا يسُرُّه قال ",["من أنظَر معسِرًا أو وضع له ",1],["وقاه اللهُ عزَّ وجلَّ من فَيْحِ جهنَّمَ",2]],"grade":"صحيح","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","bab":"مزارعة › وضع الجوائح","dorar":"G6GBpSR0","merged":3,"otherRefs":["تفسير القرآن العظيم 2/102 (حسن)","مجمع الزوائد 4/136 (صحيح)"]},{"id":"س-01910","fp":"26cdd570c51f","stateId":678,"easy":"إذا تصدقت ولو من حليك ← تتقين النار (فأكثر أهلها النساء)","cause":"تصدَّقنَ ولو من حُليِّكُنَّ","result":"فإنِّي رأيتُكنَّ أَكثرَ أَهلِ النَّارِ","explicit":true,"repOf":"س-06376","ref":"الوابل الصيب 54","text":["يا معشرَ النِّساءِ ",["تصدَّقنَ ولو من حُليِّكُنَّ",1]," ",["فإنِّي رأيتُكنَّ أَكثرَ أَهلِ النَّارِ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"uEBK7tan"},{"id":"س-04251","fp":"3889cb500d5a","stateId":678,"easy":"إذا أطعمت أخاك خبزاً حتى يشبع وسقيته حتى يروى ← يباعدك الله عن النار سبع خنادق","cause":"مَن أطعَمَ أخاهُ خُبْزًا حتَّى يُشْبِعَه، وسَقاهُ ماءً حتَّى يَرْويَهُ","result":"بَعَّدَهُ اللهُ عنِ النَّارِ سَبْعَ خَنادِقَ، بُعْدُ ما بيْن خَنْدَقَيْنِ مَسِيرةُ خَمْسِ مائةِ سنةٍ","explicit":true,"similar":["س-04278"],"ref":"المستدرك على الصحيحين 7368","srcLabel":"الطبراني","text":[["مَن أطعَمَ أخاهُ خُبْزًا حتَّى يُشْبِعَه، وسَقاهُ ماءً حتَّى يَرْويَهُ، ",1],["بَعَّدَهُ اللهُ عنِ النَّارِ سَبْعَ خَنادِقَ، بُعْدُ ما بيْن خَنْدَقَيْنِ مَسِيرةُ خَمْسِ مائةِ سنةٍ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن شاهين في ((الترغيب)) (372)، والبيهقي في ((شعب الإيمان)) (3096) كلاهما بلفظه، والطبراني في ((الأوسط)) (6518) باختلاف يسير.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"gHzv1Iyn"},{"id":"س-04278","fp":"dc12f753fe28","stateId":678,"easy":"إذا أطعمت أخاك حتى يشبع وسقيته حتى يروى ← يباعدك الله من النار سبع خنادق","cause":"من أطعمَ أخاهُ حتَّى يُشْبِعَهُ وسقاهُ منَ الماءِ حتَّى يرويَهُ","result":"باعدَهُ اللَّهُ منَ النَّارِ سبعَ خَنادقَ ما بينَ كلِّ خندقينِ مسيرةُ خمسمائةِ عامٍ","explicit":true,"repOf":"س-04251","ref":"الزواجر عن اقتراف الكبائر 1/194","text":[["من أطعمَ أخاهُ حتَّى يُشْبِعَهُ وسقاهُ منَ الماءِ حتَّى يرويَهُ ",1],["باعدَهُ اللَّهُ منَ النَّارِ سبعَ خَنادقَ ما بينَ كلِّ خندقينِ مسيرةُ خمسمائةِ عامٍ",2]],"grade":"صحيح","muhaddith":"صحيح أو حسن","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"5i9P6rEx"},{"id":"س-05604","fp":"89e44fea792d","stateId":678,"easy":"إذا رُزقت فلا تخبأ وإذا سُئلت فلا تمنع ← تلقى الله فقيراً لا غنياً","cause":"إذا رُزِقتَ فلا تَخْبَأْ، وإذا سُئِلتَ فلا تَمنعْ","result":"هو ذاكَ، وإلَّا فالنَّارُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 8100","srcLabel":"الحاكم","text":["يا بِلالُ، الْقَ اللهَ فقيرًا، ولَا تَلْقَهُ غنيًّا، قالَ: قلتُ: وكيفَ لي بذلكَ يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ قالَ: ",["إذا رُزِقتَ فلا تَخْبَأْ، وإذا سُئِلتَ فلا تَمنعْ",1],"، قالَ: قلتُ: وكيفَ لي بذلكَ يا رسولَ اللهِ؟ قالَ: ",["هو ذاكَ، وإلَّا فالنَّارُ",2],"."],"grade":"صحيح","narrator":"بلال","muhaddith":"صحيح الإسناد","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"LKA0zeof","merged":3,"otherRefs":["الترغيب والترهيب 2/81 (صحيح)","الزواجر عن اقتراف الكبائر 1/177 (صحيح)"]},{"id":"س-02169","fp":"749f51240943","stateId":678,"easy":"إذا تصدقت ولو بشق تمرة ← تجعل بينك وبين النار حجاباً","cause":"ولَو بشِقِّ تمرَّةٍ","result":"اجعلوا بينَكُم وبينَ النَّارِ حِجابًا","explicit":true,"ref":"صحيح الجامع 153","srcLabel":"الطبراني","text":[["اجعلوا بينَكُم وبينَ النَّارِ حِجابًا",2]," ، ",["ولَو بشِقِّ تمرَّةٍ",1]],"grade":"حسن","narrator":"فضالة بن عبيد","muhaddith":"حسن","takhrij":"أخرجه الطبراني (18/ 303)، (777) بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"uZUFCR0K"},{"id":"س-02252","fp":"087556406126","stateId":678,"easy":"إذا تصدقت ← فالصدقة فكاكك من النار","cause":"تصدَّقوا","result":"فإن الصدقةَ فكاكُكم من النارِ","explicit":true,"repOf":"س-06376","ref":"مجمع الزوائد 3/109","text":[["تصدَّقوا ",1],["فإن الصدقةَ فكاكُكم من النارِ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (8060)، وأبو نعيم في ((حلية الأولياء)) (10/403)، والبيهقي في ((شعب الإيمان)) (3355)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"F6RuXxpa"},{"id":"س-04158","fp":"26925899fb52","stateId":678,"easy":"إذا قضيت عن أخيك دينه ← يفك الله رهانك يوم القيامة","cause":"يقضي عن أخيهِ دينَه","result":"إلَّا فَكَّ اللَّهُ رِهانَه يومَ القيامةِ","explicit":true,"ref":"هداية الرواة 3/182","srcLabel":"البيهقي","text":["أُتِيَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ بجنازةٍ ليصلِّيَ عليها قالَ هل على صاحبِكم دَينٌ قالوا نعم قالَ هل ترَك وفاءٍ قالوا لا قالَ صلُّوا على صاحبِكم قالَ عليُّ بنُ أبي طالبٍ رضي اللَّهُ عنهُ عليَّ دينُه فتقدَّمَ فصلَّى عليه وقالَ فَك اللَّهُ رِهانَك منَ النَّارِ كما فَككتَ رِهانَ أخيكَ المسلمِ ليسَ من عبدٍ مسلمٍ ",["يقضي عن أخيهِ دينَه",1]," ",["إلَّا فَكَّ اللَّهُ رِهانَه يومَ القيامةِ",2]],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه الدارقطني (3/78)، والبيهقي (6/73) (11731) باختلاف يسير.","bab":"جنائز وموت › قضاء دين الميت","dorar":"HKbNYwdf"},{"id":"س-02205","fp":"5ca615af7766","stateId":678,"easy":"إذا أحسنت إلى أحد (سقيته شربة) ← يشفع لك فيُخرجك من النار","cause":"فاسْتَسْقَيْتَني شربةً من ماءٍ فسقَيْتُك","result":"فيُشفِّعُه اللهُ فيُأمرُ به فيُخرَجُ من النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"الترغيب والترهيب 2/95","srcLabel":"ابن ماجه","text":["أنَّ رجلًا من أهلِ الجنَّةِ يُشرِفُ يومَ القيامةِ على أهلِ النَّارِ فيناديه رجلٌ من أهلِ النَّارِ فيقولُ: يا فلانُ هل تعرفني؟ فيقول: لا واللهِ ما أعرِفُك من أنت؟ فيقولُ : أنا الَّذي مررتَ بي في الدُّنيا ",["فاسْتَسْقَيْتَني شربةً من ماءٍ فسقَيْتُك",1],". قال: قد عرفتُ. قال: فاشفعْ لي بها عند ربِّك. قال: فيسألُ اللهَ تعالَى جلَّ ذكرُه فيقولُ: إنِّي أشرفتُ على النَّارِ فناداني رجلٌ من أهلِها فقال لي: هل تعرفُني؟ قلتُ: لا واللهِ ما أعرفُك من أنت؟ قال: أنا الَّذي مررتَ بي في الدُّنيا فاسْتَسْقَيْتَني شربةً من ماءٍ فسقَيْتُك فاشفعْ لي عند ربِّك فشفِّعْني فيه ",["فيُشفِّعُه اللهُ فيُأمرُ به فيُخرَجُ من النَّارِ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن ماجه (3685) مختصراً، وأبو يعلى في ((المسند)) (6/210)، وابن عدي في ((الكامل في ضعفاء الرجال)) (5/202) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"vkY1N9kr"},{"id":"س-03203","fp":"79cea6d4ed41","stateId":679,"easy":"إذا قتلت كافراً معتدياً ثم سددت بعده ← لا تجتمعان في النار","cause":"مؤمنٌ قتَلَ كافرًا ثمَّ سدَّدَ بعدَه","result":"لا يَجتَمِعُ في النَّارِ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 8637","srcLabel":"مسلم","text":[["لا يَجتَمِعُ في النَّارِ",2]," اجتماعًا يَضُرُّ ",["مؤمنٌ قتَلَ كافرًا ثمَّ سدَّدَ بعدَه",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (1891) باختلاف يسير","bab":"إيمان › فضل الإيمان","dorar":"gZCWUdtl","merged":3,"otherRefs":["صحيح أبي داود 2495 (صحيح)","تخريج المسند لشعيب 8816 (صحيح)"]},{"id":"س-02867","fp":"f75ab5a9c32e","stateId":679,"easy":"إذا اغبرّت قدماك في سبيل الله ← يؤمّن الله قدميك من النار","cause":"وما من رجلٍ تَغْبَرُّ قدماه في سبيلِ اللهِ","result":"إلا آمن اللهُ قدمَيْه النَّارَ يومَ القيامةِ","explicit":true,"ref":"الترغيب والترهيب 2/243","srcLabel":"الطبراني","text":["ما من رجلٍ يَغْبَرُّ وجهُه في سبيلِ اللهِ إلا آمنَه اللهُ دخانَ النَّارِ يومَ القيامةِ ",["وما من رجلٍ تَغْبَرُّ قدماه في سبيلِ اللهِ",1]," ",["إلا آمن اللهُ قدمَيْه النَّارَ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني (8/114) (7482)، وابن عدي في ((الكامل في الضعفاء)) (2/165)، والبيهقي في ((شعب الإيمان)) (4296)","bab":"إيمان › الوعد","dorar":"OeKgFog0"},{"id":"س-02060","fp":"05543821b7c9","stateId":679,"easy":"إذا اغبرّت قدماك في سبيل الله ← لا تمسك النار","cause":"ما اغبَرَّت قدَما عَبدٍ في سَبيلِ اللهِ","result":"فتَمَسَّه النَّارُ","explicit":true,"star":true,"similar":["س-02172","س-02243","س-04444","س-04445"],"ref":"صحيح البخاري 2811","srcLabel":"متفق عليه","text":[["ما اغبَرَّت قدَما عَبدٍ في سَبيلِ اللهِ",1],"، ",["فتَمَسَّه النَّارُ",2],"."],"grade":"صحيح","narrator":"أبو عبس عبدالرحمن بن جبر","muhaddith":"[صحيح]","takhrij":"من أفراد البخاري على مسلم","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"IAvGhpSO"},{"id":"س-05455","fp":"20cb60ceb571","stateId":679,"easy":"إذا أصابك غبار في سبيل الله ← لا يجتمع ودخان جهنم في منخريك","cause":"غُبارٌ في سَبيلِ اللهِ","result":"ولا يَجتَمِعُ غُبارٌ في سَبيلِ اللهِ، ودُخانُ جَهنَّمَ في مَنخِرَيِ امرئٍ أبَدًا","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 10560","srcLabel":"الترمذي","text":["لا يَلِجُ النَّارَ أحدٌ بَكى مِن خَشيةِ اللهِ، حتى يَعودَ اللَّبنُ في الضِّرعِ، ",["ولا يَجتَمِعُ غُبارٌ في سَبيلِ اللهِ، ودُخانُ جَهنَّمَ في مَنخِرَيِ امرئٍ أبَدًا",2],". وقال: أبو عَبدِ الرَّحمنِ المُقرئُ: في مَنخِرَيْ مُسلِمٍ أبَدًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (1633)، والنسائي (3108)، وأحمد (10560) واللفظ له","bab":"رقائق وزهد › الخوف من الله","dorar":"8vpjC2SL","merged":6,"otherRefs":["علل ابن أبي حاتم 909 (حسن)","صحيح ابن حبان 4607 (صحيح)","صحيح النسائي 3115 (صحيح)","الترغيب والترهيب 4/30 (صحيح)","صحيح الأدب المفرد 215 (صحيح)"]},{"id":"ق-1330","fp":"00b1e165d3ec","stateId":679,"easy":"الإيمان بالله ورسوله والجهاد في سبيله بالمال والنفس ← النجاة من عذاب أليم ومغفرة وجنات ومساكن طيبة ونصر من الله وفتح قريب","cause":"الإيمان بالله ورسوله والجهاد في سبيله بالمال والنفس","result":"النجاة من عذاب أليم ومغفرة وجنات ومساكن طيبة ونصر من الله وفتح قريب","explicit":true,"star":true,"otherNeedIds":[11,67,25],"ref":"سورة الصف: 10–13","srcLabel":"القرآن الكريم","quran":{"s":61,"from":10,"to":13,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا هَلْ أَدُلُّكُمْ عَلَى تِجَارَةٍ تُنْجِيكُمْ مِنْ عَذَابٍ أَلِيمٍ (10) تُؤْمِنُونَ بِاللَّهِ وَرَسُولِهِ وَتُجَاهِدُونَ فِي سَبِيلِ اللَّهِ بِأَمْوَالِكُمْ وَأَنْفُسِكُمْ ذَلِكُمْ خَيْرٌ لَكُمْ إِنْ كُنْتُمْ تَعْلَمُونَ (11) يَغْفِرْ لَكُمْ ذُنُوبَكُمْ وَيُدْخِلْكُمْ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ وَمَسَاكِنَ طَيِّبَةً فِي جَنَّاتِ عَدْنٍ ذَلِكَ الْفَوْزُ الْعَظِيمُ (12) وَأُخْرَى تُحِبُّونَهَا نَصْرٌ مِنَ اللَّهِ وَفَتْحٌ قَرِيبٌ وَبَشِّرِ الْمُؤْمِنِينَ (13)","hl":[[31,504,1]]}},{"id":"س-05460","fp":"e67ad89c9bd4","stateId":679,"easy":"إذا سهرت عينك في سبيل الله ← حُرّمت عليها النار","cause":"عينٍ سَهِرَتْ في سبيلِ اللهِ","result":"حُرِّمتِ النَّارُ على عينٍ سَهِرَتْ في سبيلِ اللهِ","explicit":true,"ref":"المستدرك على الصحيحين 2467","srcLabel":"أحمد","text":["خَرَجْنا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في غَزوةٍ، فأَوْفى بِنا على شَرَفٍ، فأَصابَنا بَرْدٌ شديدٌ، حتَّى إنْ كان أَحدُنا يَحفِرُ الحفيرَ، ثُمَّ يَدخُلُ فيه، ويُغطِّي عليه بحَجَفَتِه، فلمَّا رأى رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ذلك مِنَ النَّاسِ قالَ: ألا رَجلٌ يَحرُسُنا اللَّيلةَ أَدْعو اللهَ له بدُعاءٍ يُصيبُ به فَضلًا؟ فقامَ رَجلٌ مِنَ الأنصارِ، فقالَ: أنا يا رسولَ اللهِ، فدَعا له. قالَ أبو رَيحانةَ: فقلتُ: أنا، فدَعا لي بدُعاءٍ هو دونَ ما دَعا به للأنصاريِّ، ثُمَّ قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: حُرِّمتِ النَّارُ على عينٍ دَمَعَتْ مِن خشيةِ اللهِ، ",["حُرِّمتِ النَّارُ على عينٍ سَهِرَتْ في سبيلِ اللهِ",2],". قالَ: ونَسيتُ الثَّالثةَ. قال أبو شُريحٍ -وهو عبدُ الرَّحمنِ بنُ شُريحٍ-: وسَمِعْتُ بعدُ أنَّه قالَ: حُرِّمتِ النَّارُ على عينٍ غَضَّتْ عنْ مَحارمِ اللهِ، أوْ عينٍ فُقِئتْ في سبيلِ اللهِ."],"grade":"صحيح","narrator":"أبو ريحانة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (17213)، وابن أبي شيبة (19899)، وابن أبي عاصم في ((الآحاد والمثاني)) (2325) باختلاف يسير تامًا.","bab":"رقائق وزهد › الخوف من الله","dorar":"ccX5aosa","merged":3,"otherRefs":["صحيح النسائي 3117 (صحيح)","الترغيب والترهيب 4/190 (صحيح)"]},{"id":"س-02172","fp":"751ab1ff1d19","stateId":679,"easy":"إذا اغبرّت قدماك في سبيل الله ← يحرّم الله سائر جسدك على النار","cause":"من اغبَرَّتْ قدماه في سبيلِ اللهِ","result":"حرَّم اللهُ سائرَ جسدِه على النَّارِ","explicit":true,"repOf":"س-02060","ref":"صحيح الترغيب 1272","text":[["من اغبَرَّتْ قدماه في سبيلِ اللهِ ؛ ",1],["حرَّم اللهُ سائرَ جسدِه على النَّارِ ",2],"."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (27503) مطولاً، والطبراني في ((المعجم الأوسط)) (5533)، وابن بشران في ((الأمالي)) (726) واللفظ لهما.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"K5A547NI"},{"id":"س-02243","fp":"44802b6f72c3","stateId":679,"easy":"إذا اغبرّت قدماك ساعة من نهار في سبيل الله ← فهما حرام على النار","cause":"منِ اغبرَّتْ قدماهُ . . . ساعةً من نهارٍ","result":"فهما حرامٌ على النَّارِ","explicit":true,"repOf":"س-02060","ref":"السلسلة الصحيحة 5/255","text":["بينا نسيرُ في  دَرْبِ قَلَمْيَةَ إذ نادى الأميرَ مالكُ بنُ عبدِ اللهِ الخثْعمِيَّ رجلٌ يقودُ فرسَه في عِراضِ الجبلِ يا أبا عبدِ اللهِ ألا تركبُ قال إني سمعتُ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يقولُ ",["منِ اغبرَّتْ قدماهُ . . . ساعةً من نهارٍ",1]," ",["فهما حرامٌ على النَّارِ",2]],"grade":"صحيح","narrator":"مالك بن عبدالله الخثعمي","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (22012) واللفظ له، والطبراني (19/297) (661) مختصراً","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"53DwGImF"},{"id":"س-02866","fp":"e4598244a616","stateId":679,"easy":"إذا اغبرّ وجهك في سبيل الله ← يؤمنك الله دخان النار يوم القيامة","cause":"ما من رجلٍ يَغْبَرُّ وجهُه في سبيلِ اللهِ","result":"إلا آمنَه اللهُ دخانَ النَّارِ يومَ القيامةِ","explicit":true,"ref":"الترغيب والترهيب 2/243","srcLabel":"الطبراني","text":[["ما من رجلٍ يَغْبَرُّ وجهُه في سبيلِ اللهِ",1]," ",["إلا آمنَه اللهُ دخانَ النَّارِ يومَ القيامةِ",2]," وما من رجلٍ تَغْبَرُّ قدماه في سبيلِ اللهِ إلا آمن اللهُ قدمَيْه النَّارَ يومَ القيامةِ"],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني (8/114) (7482)، وابن عدي في ((الكامل في الضعفاء)) (2/165)، والبيهقي في ((شعب الإيمان)) (4296)","bab":"إيمان › الوعد","dorar":"OeKgFog0"},{"id":"س-04444","fp":"22ff8b6b8e56","stateId":679,"easy":"إذا اغبرّت قدماك في سبيل الله ← يحرمك الله على النار","cause":"مَن اغبَرَّت قدماه في سبيلِ اللهِ","result":"حرَّمه اللهُ على النَّارِ فأعجَب مالكًا قولُه فسار حتَّى إذا كان حيثُ يُسمِعُه الصَّوتُ ناداه بأعلى صوتِه يا أبا عبدِ اللهِ اركَبْ فقد حمَلك اللهُ فعرَف جابرٌ الَّذي أراد","explicit":true,"repOf":"س-02060","ref":"تخريج صحيح ابن حبان 4604","text":["بينما نحنُ نسيرُ بأرضِ الرُّومِ في طائفةٍ عليها مالكُ بنُ عبدِ اللهِ الخَثعميُّ إذ مرَّ مالكٌ بجابرِ بنِ عبدِ اللهِ وهو يمشي يقودُ بغلًا له فقال له مالكٌ: أيْ أبا عبدِ اللهِ اركَبْ فقد حمَلك اللهُ، فقال جابرٌ: أُصلِحُ دابَّتي وأستغني عن قومي وسمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( ",["مَن اغبَرَّت قدماه في سبيلِ اللهِ ",1],["حرَّمه اللهُ على النَّارِ ) فأعجَب مالكًا قولُه فسار حتَّى إذا كان حيثُ يُسمِعُه الصَّوتُ ناداه بأعلى صوتِه يا أبا عبدِ اللهِ اركَبْ فقد حمَلك اللهُ فعرَف جابرٌ الَّذي أراد",2]," برفعِ صوتِه وقال: أُصلِحُ دابَّتي وأستغني عن قومي وسمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( مَن اغبَرَّت قدماه في سبيلِ اللهِ حرَّمه اللهُ على النَّارِ ) فوثَب النَّاسُ عن دوابِّهم فما رأَيْنا يومًا أكثرَ ماشيًا منه"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (4604) بلفظه، والطيالسي (1881) باختلاف يسير، وأحمد (14947)، وأبو يعلى (2075) كلاهما باختلاف يسير.","bab":"جهاد › فضل الجهاد","dorar":"auqYJWCz"},{"id":"س-04445","fp":"f473a79d7e5a","stateId":679,"easy":"إذا اغبرّت قدماك في سبيل الله ← يحرمك الله على النار","cause":"مَن اغبَرَّت قدماه في سبيلِ اللهِ","result":"حرَّمه اللهُ على النَّارِ فوثَب النَّاسُ عن دوابِّهم فما رأَيْنا يومًا أكثرَ ماشيًا منه","explicit":true,"repOf":"س-02060","ref":"تخريج صحيح ابن حبان 4604","text":["بينما نحنُ نسيرُ بأرضِ الرُّومِ في طائفةٍ عليها مالكُ بنُ عبدِ اللهِ الخَثعميُّ إذ مرَّ مالكٌ بجابرِ بنِ عبدِ اللهِ وهو يمشي يقودُ بغلًا له فقال له مالكٌ: أيْ أبا عبدِ اللهِ اركَبْ فقد حمَلك اللهُ، فقال جابرٌ: أُصلِحُ دابَّتي وأستغني عن قومي وسمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( مَن اغبَرَّت قدماه في سبيلِ اللهِ حرَّمه اللهُ على النَّارِ ) فأعجَب مالكًا قولُه فسار حتَّى إذا كان حيثُ يُسمِعُه الصَّوتُ ناداه بأعلى صوتِه يا أبا عبدِ اللهِ اركَبْ فقد حمَلك اللهُ فعرَف جابرٌ الَّذي أراد برفعِ صوتِه وقال: أُصلِحُ دابَّتي وأستغني عن قومي وسمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( ",["مَن اغبَرَّت قدماه في سبيلِ اللهِ ",1],["حرَّمه اللهُ على النَّارِ ) فوثَب النَّاسُ عن دوابِّهم فما رأَيْنا يومًا أكثرَ ماشيًا منه",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (4604) بلفظه، والطيالسي (1881) باختلاف يسير، وأحمد (14947)، وأبو يعلى (2075) كلاهما باختلاف يسير.","bab":"جهاد › فضل الجهاد","dorar":"auqYJWCz"},{"id":"س-05458","fp":"0169e13cfe62","stateId":679,"easy":"إذا فُقئت عينك في سبيل الله أو حرست أو بكت من خشيته ← لا تمسها النار","cause":"عينٌ فُقِئتْ في سبيلِ اللهِ، وعينٌ حَرَسَتْ في سبيلِ اللهِ، وعينٌ بَكَتْ مِن خشيةِ اللهِ","result":"ثلاثةُ أَعْيُنٍ لا تَمَسُّها النَّارُ","explicit":true,"ref":"المستدرك على الصحيحين 2465","srcLabel":"البيهقي","text":[["ثلاثةُ أَعْيُنٍ لا تَمَسُّها النَّارُ",2],":",[" عينٌ فُقِئتْ في سبيلِ اللهِ، وعينٌ حَرَسَتْ في سبيلِ اللهِ، وعينٌ بَكَتْ مِن خشيةِ اللهِ.",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (774) واللفظ له والبزار(8570)، وابن أبي عاصم في ((الجهاد)) (‌148) بلفظ مقارب","bab":"رقائق وزهد › الخوف من الله","dorar":"TyVzQpjk"},{"id":"س-02090","fp":"48669a05fd66","stateId":679,"easy":"إذا حرست وراء المسلمين تطوعاً ← لا ترى النار بعينك إلا تحلة القسم","cause":"من حرس من وراءِ المسلمين في سبيلِ اللهِ تبارك وتعالى تطوعًا لا يأخذُه سلطانٌ","result":"لم يرَ النارَ بعينَيه إلا تحلةَ القسمِ","explicit":true,"ref":"المتجر الرابح 170","srcLabel":"أحمد","text":[["من حرس من وراءِ المسلمين في سبيلِ اللهِ تبارك وتعالى تطوعًا لا يأخذُه سلطانٌ",1]," ",["لم يرَ النارَ بعينَيه إلا تحلةَ القسمِ",2]," فإنَّ اللهَ تعالى يقول: {وَإِنْ مِنْكُمْ إِلَّا وَارِدُهَا} [مريم: 71]"],"grade":"حسن","narrator":"معاذ بن أنس","muhaddith":"إسناده حسن [لغيره]","takhrij":"لم نجده من حديث أنس رضي الله عنه. وأخرجه أحمد (15612)، والطبراني (20/185) (403) واللفظ لهما، وأبو يعلى (1490) باختلاف يسير من حديث معاذ بن أنس الجهني رضي الله عنه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"1xObqXWc"},{"id":"س-01962","fp":"5bba43e7978f","stateId":679,"easy":"إذا قتلت كافراً ثم سددت وقاربت ← لا تجتمعان في النار","cause":"مُسلِمٌ قُتِلَ كافرًا ثمَّ سدَّدَ المسلمُ وقارَبَ","result":"لا يَجتمِعانِ في النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"تخريج المسند لشعيب 8479","srcLabel":"مسلم","text":[["لا يَجتمِعانِ في النَّارِ",2]," اجتماعًا يَضُرُّ أحدَهما: ",["مُسلِمٌ قُتِلَ كافرًا ثمَّ سدَّدَ المسلمُ وقارَبَ",1],"، ولا يَجتَمِعانِ في جَوْفِ عبٍد: غُبارٌ في سبيلِ اللهِ، ودُخانُ جهنَّمَ، ولا يَجتَمِعانِ في قلبِ عبدٍ: الإيمانُ، والشُّحُّ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1891) بنحوه مختصراً، والنسائي (3110) مختصراً، وأحمد (8479) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Yl4W18WZ"},{"id":"س-05467","fp":"052ef59a5d66","stateId":680,"easy":"إذا خفت النار ← تُجنّب منها","cause":"مَن يَخافُها","result":"ويُجَنَّبُ مِن النَّارِ","explicit":true,"star":true,"ref":"الأحاديث المختارة 13 / 191","srcLabel":"متفق عليه","text":["«إنَّما يَدخُلُ الجنَّةَ مَن يَرْجوها ",["ويُجَنَّبُ مِن النَّارِ",2]," ",["مَن يَخافُها",1],"، وإنَّما يَرحَمُ اللهُ عَزَّ وجَلَّ مَن يَرحَمُ»."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الخوف من الله","dorar":"q9Fj4rWe"},{"id":"س-05443","fp":"73e11742d918","stateId":680,"easy":"إذا بكت عينك من خشية الله أو حرست في سبيله أو غضت عن محارمه ← لا ترى النار","cause":"عَيْنٌ بَكَتْ من خَشْيَةِ اللهِ ، و عَيْنٌ حَرَسَتْ في سبيلِ اللهِ ، و عَيْنٌ غَضَّتْ عن مَحارِمِ اللهِ","result":"ثلاثَةٌ لا تَرَى أَعْيُنُهُمُ النارَ يومَ القيامةِ","explicit":true,"ref":"السلسلة الصحيحة 2673","srcLabel":"السلسلة الصحيحة","text":[["ثلاثَةٌ لا تَرَى أَعْيُنُهُمُ النارَ يومَ القيامةِ ",2],":",[" عَيْنٌ بَكَتْ من خَشْيَةِ اللهِ ، و عَيْنٌ حَرَسَتْ في سبيلِ اللهِ ، و عَيْنٌ غَضَّتْ عن مَحارِمِ اللهِ",1]],"grade":"صحيح","narrator":"معاوية بن حيدة وابن عباس وأبو ريحانة وأبو هريرة وأنس بن مالك","muhaddith":"صحيح بمجموع طرقه","bab":"رقائق وزهد › الخوف من الله","dorar":"hC7gKMiI","merged":7,"otherRefs":["صحيح الترغيب 3326 (حسن)","صحيح الجامع 4111 (صحيح)","الجامع الصغير 5631 (صحيح)","صحيح الترغيب 3322 (صحيح)","صحيح الترغيب 3323 (صحيح)","الأحاديث المختارة 2198 (صحيح)"]},{"id":"ق-1270","fp":"0f878277ca04","stateId":680,"easy":"الإشفاق من الله في الأهل والدعاء ← منّ الله والوقاية من عذاب السموم","cause":"الإشفاق من الله في الأهل والدعاء","result":"منّ الله والوقاية من عذاب السموم","explicit":true,"otherNeedIds":[29],"ref":"سورة الطور: 26–28","srcLabel":"القرآن الكريم","quran":{"s":52,"from":26,"to":28,"text":"قَالُوا إِنَّا كُنَّا قَبْلُ فِي أَهْلِنَا مُشْفِقِينَ (26) فَمَنَّ اللَّهُ عَلَيْنَا وَوَقَانَا عَذَابَ السَّمُومِ (27) إِنَّا كُنَّا مِنْ قَبْلُ نَدْعُوهُ إِنَّهُ هُوَ الْبَرُّ الرَّحِيمُ (28)","hl":[[0,189,1]]}},{"id":"س-00555","fp":"aa6a9471aed1","stateId":680,"easy":"إذا خرجت من عينك دمعة من خشية الله ولو مثل رأس الذباب ← يحرّمك الله على النار","cause":"ما من مُؤمنٍ تخرُجُ من عينيه دمعةٌ في خشيةِ اللهِ وإن كان مِثلَ رأسِ الذُّبابِ، فتُصيبُ شيئًا من حُرِّ وَجهِه","result":"إلَّا حرَّمه اللهُ على النَّارِ","explicit":true,"similar":["س-05459"],"ref":"المصابيح في الأحاديث المتواترة 616","srcLabel":"المصابيح في الأحاديث المتواترة","text":[["ما من مُؤمنٍ تخرُجُ من عينيه دمعةٌ في خشيةِ اللهِ وإن كان مِثلَ رأسِ الذُّبابِ، فتُصيبُ شيئًا من حُرِّ وَجهِه",1]," ",["إلَّا حرَّمه اللهُ على النَّارِ",2]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"آداب عامة › ضرب الأمثال","dorar":"aVWJKi86","merged":2,"otherRefs":["المتجر الرابح 341 (حسن)"]},{"id":"س-05459","fp":"ac5cb841d33f","stateId":680,"easy":"إذا دمعت عينك من خشية الله ← حُرّمت عليها النار","cause":"عينٍ دَمَعَتْ مِن خشيةِ اللهِ","result":"حُرِّمتِ النَّارُ على عينٍ دَمَعَتْ مِن خشيةِ اللهِ","explicit":true,"repOf":"س-00555","ref":"المستدرك على الصحيحين 2467","text":["خَرَجْنا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في غَزوةٍ، فأَوْفى بِنا على شَرَفٍ، فأَصابَنا بَرْدٌ شديدٌ، حتَّى إنْ كان أَحدُنا يَحفِرُ الحفيرَ، ثُمَّ يَدخُلُ فيه، ويُغطِّي عليه بحَجَفَتِه، فلمَّا رأى رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ذلك مِنَ النَّاسِ قالَ: ألا رَجلٌ يَحرُسُنا اللَّيلةَ أَدْعو اللهَ له بدُعاءٍ يُصيبُ به فَضلًا؟ فقامَ رَجلٌ مِنَ الأنصارِ، فقالَ: أنا يا رسولَ اللهِ، فدَعا له. قالَ أبو رَيحانةَ: فقلتُ: أنا، فدَعا لي بدُعاءٍ هو دونَ ما دَعا به للأنصاريِّ، ثُمَّ قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["حُرِّمتِ النَّارُ على عينٍ دَمَعَتْ مِن خشيةِ اللهِ",2],"، حُرِّمتِ النَّارُ على عينٍ سَهِرَتْ في سبيلِ اللهِ. قالَ: ونَسيتُ الثَّالثةَ. قال أبو شُريحٍ -وهو عبدُ الرَّحمنِ بنُ شُريحٍ-: وسَمِعْتُ بعدُ أنَّه قالَ: حُرِّمتِ النَّارُ على عينٍ غَضَّتْ عنْ مَحارمِ اللهِ، أوْ عينٍ فُقِئتْ في سبيلِ اللهِ."],"grade":"صحيح","narrator":"أبو ريحانة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (17213)، وابن أبي شيبة (19899)، وابن أبي عاصم في ((الآحاد والمثاني)) (2325) باختلاف يسير تامًا.","bab":"رقائق وزهد › الخوف من الله","dorar":"ccX5aosa","merged":2,"otherRefs":["الترغيب والترهيب 4/190 (صحيح)"]},{"id":"س-01082","fp":"1a17ebcb0670","stateId":680,"easy":"إذا ذكرت الله ففاضت عيناك من خشيته حتى يصيب الأرض من دموعك ← لا يعذبك الله يوم القيامة","cause":"مَن ذَكَر اللهَ ففاضَتْ عيناهُ مِن خَشيةِ اللهِ حتَّى يُصيبَ الأرضَ مِن دُموعِهِ","result":"لم يُعَذِّبْهُ اللهُ تَعالَى يومَ القِيامةِ","explicit":true,"ref":"المستدرك على الصحيحين 7877","srcLabel":"الطبراني","text":[["مَن ذَكَر اللهَ ففاضَتْ عيناهُ مِن خَشيةِ اللهِ حتَّى يُصيبَ الأرضَ مِن دُموعِهِ، ",1],["لم يُعَذِّبْهُ اللهُ تَعالَى يومَ القِيامةِ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (1641) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"ZhEmril2"},{"id":"س-05454","fp":"833357923e36","stateId":680,"easy":"إذا بكيت من خشية الله ← لا تلج النار","cause":"بَكى مِن خَشيةِ اللهِ","result":"لا يَلِجُ النَّارَ أحدٌ","explicit":true,"ref":"تخريج المسند لشعيب 10560","srcLabel":"الترمذي","text":[["لا يَلِجُ النَّارَ أحدٌ",2]," ",["بَكى مِن خَشيةِ اللهِ",1],"، حتى يَعودَ اللَّبنُ في الضِّرعِ، ولا يَجتَمِعُ غُبارٌ في سَبيلِ اللهِ، ودُخانُ جَهنَّمَ في مَنخِرَيِ امرئٍ أبَدًا. وقال: أبو عَبدِ الرَّحمنِ المُقرئُ: في مَنخِرَيْ مُسلِمٍ أبَدًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (1633)، والنسائي (3108)، وأحمد (10560) واللفظ له","bab":"رقائق وزهد › الخوف من الله","dorar":"8vpjC2SL"},{"id":"س-05461","fp":"73af037261c2","stateId":680,"easy":"إذا غضضت عينك عن محارم الله أو فُقئت في سبيله ← حُرّمت عليها النار","cause":"عينٍ غَضَّتْ عنْ مَحارمِ اللهِ، أوْ عينٍ فُقِئتْ في سبيلِ اللهِ","result":"حُرِّمتِ النَّارُ على عينٍ غَضَّتْ عنْ مَحارمِ اللهِ","explicit":true,"otherNeedIds":[20],"ref":"المستدرك على الصحيحين 2467","srcLabel":"أحمد","text":["خَرَجْنا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في غَزوةٍ، فأَوْفى بِنا على شَرَفٍ، فأَصابَنا بَرْدٌ شديدٌ، حتَّى إنْ كان أَحدُنا يَحفِرُ الحفيرَ، ثُمَّ يَدخُلُ فيه، ويُغطِّي عليه بحَجَفَتِه، فلمَّا رأى رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ذلك مِنَ النَّاسِ قالَ: ألا رَجلٌ يَحرُسُنا اللَّيلةَ أَدْعو اللهَ له بدُعاءٍ يُصيبُ به فَضلًا؟ فقامَ رَجلٌ مِنَ الأنصارِ، فقالَ: أنا يا رسولَ اللهِ، فدَعا له. قالَ أبو رَيحانةَ: فقلتُ: أنا، فدَعا لي بدُعاءٍ هو دونَ ما دَعا به للأنصاريِّ، ثُمَّ قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: حُرِّمتِ النَّارُ على عينٍ دَمَعَتْ مِن خشيةِ اللهِ، حُرِّمتِ النَّارُ على عينٍ سَهِرَتْ في سبيلِ اللهِ. قالَ: ونَسيتُ الثَّالثةَ. قال أبو شُريحٍ -وهو عبدُ الرَّحمنِ بنُ شُريحٍ-: وسَمِعْتُ بعدُ أنَّه قالَ: ",["حُرِّمتِ النَّارُ على عينٍ غَضَّتْ عنْ مَحارمِ اللهِ",2],["، أوْ عينٍ فُقِئتْ في سبيلِ اللهِ",1],"."],"grade":"صحيح","narrator":"أبو ريحانة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (17213)، وابن أبي شيبة (19899)، وابن أبي عاصم في ((الآحاد والمثاني)) (2325) باختلاف يسير تامًا.","bab":"رقائق وزهد › الخوف من الله","dorar":"ccX5aosa"},{"id":"س-01245","fp":"6bfc21a5315c","stateId":681,"easy":"إذا قلت «سبحان الله والحمد لله ولا إله إلا الله والله أكبر» ← فهن جُنتك من النار ويأتين يوم القيامة منجيات","cause":"خُذوا جنَّتَكم مِنَ النَّارِ قولوا سُبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ واللهُ أكبَرُ ولا حولَ ولا قوَّةَ إلَّا باللهِ","result":"فإنَّهن يأتين يومَ القيامةِ مُسْتَقْدِماتٌ ومُنْجِيَاتٌ ومُجَنِّباتٌ وهُنَّ الباقياتُ الصَّالحاتُ","explicit":true,"apply":{"k":"say","t":"«سبحان الله والحمد لله ولا إله إلا الله والله أكبر»"},"ref":"مجمع الزوائد 10/92","srcLabel":"النسائي","text":["خُذوا جنَّتَكم قُلْنا يا رسولَ اللهِ مِن عدوٍّ حضَر فقال ",["خُذوا جنَّتَكم مِنَ النَّارِ قولوا سُبحانَ اللهِ والحمدُ للهِ ولا إلهَ إلَّا اللهُ واللهُ أكبَرُ ولا حولَ ولا قوَّةَ إلَّا باللهِ ",1],["فإنَّهن يأتين يومَ القيامةِ  مُسْتَقْدِماتٌ ومُنْجِيَاتٌ ومُجَنِّباتٌ وهُنَّ الباقياتُ الصَّالحاتُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"رجاله رجال الصحيح غير داود بن بلال وهو ثقة","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10684)، والعقيلي في ((الضعفاء الكبير)) (3/17)، والطبراني في ((المعجم الأوسط)) (4027).","bab":"أدعية وأذكار › فضل لا حول ولا قوة إلا بالله","dorar":"Y9fGP2iO","merged":2,"otherRefs":["الأمالي المطلقة 225 (حسن)"]},{"id":"س-02820","fp":"fdc31d6a3f54","stateId":681,"easy":"إذا قلت بعد الصبح «اللهم أجرني من النار» ← إن مت في يومك كُتب لك جوار منها","cause":"وإذا صلَّيتَ الصُّبحَ فقل كذلِك","result":"فإنَّكَ إذا متَّ في يومِكَ كتبَ لَك جوارٌ منها","explicit":true,"apply":{"k":"say","t":"«اللهم أجرني من النار»"},"ref":"هداية الرواة 2/472","srcLabel":"أبو داود","text":["عن رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ أنَّهُ أسرَّ إليهِ فقالَ إذا انصرفتَ من صلاةِ المغربِ فقل قبلَ أن تُكلِّمَ أحدًا اللَّهمَّ أجرني منَ النَّارِ سبعَ مرَّاتٍ فإنَّكَ إذا قلتَ ذلِك ثمَّ متَّ في ليلتِكَ كتبَ لَك جوارٌ منها ",["وإذا صلَّيتَ الصُّبحَ فقل كذلِك",1]," ",["فإنَّكَ إذا متَّ في يومِكَ كتبَ لَك جوارٌ منها",2]],"grade":"حسن","narrator":"مسلم بن الحارث التميمي","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه أبو داود (5079)، وأحمد (18054)، والنسائي في ((السنن الكبرى)) (9859) باختلاف يسير.","bab":"إيمان › الوعد","dorar":"E605ltbG"},{"id":"س-00858","fp":"f53e7cb45fa7","stateId":681,"easy":"إذا كبّرت وحمدت وهلّلت وسبّحت واستغفرت وعزلت الأذى عن الطريق ← تمشي يومئذ وقد زحزحت نفسك عن النار","cause":"فمَن كَبَّرَ اللهَ، وحَمِدَ اللهَ، وهَلَّلَ اللهَ، وسَبَّحَ اللهَ، واستَغفَرَ اللهَ، وعَزَلَ حَجَرًا عن طَريقِ النَّاسِ، أو شَوكةً، أو عَظمًا عن طَريقِ النَّاسِ، وأمَرَ بمَعروفٍ، أو نَهى عن مُنكَرٍ، عَدَدَ تلك السِّتِّينَ والثَّلاثِ مِائةِ السُّلامى","result":"فإنَّه يَمشي يَومَئذٍ وقد زَحزَحَ نَفسَه عَنِ النَّارِ","explicit":true,"star":true,"similar":["س-00946"],"ref":"صحيح مسلم 1007","srcLabel":"متفق عليه","text":["إنَّه خُلِقَ كُلُّ إنسانٍ مِن بَني آدَمَ على سِتِّينَ وثَلاثِ مِائةِ مَفصِلٍ، ",["فمَن كَبَّرَ اللهَ، وحَمِدَ اللهَ، وهَلَّلَ اللهَ، وسَبَّحَ اللهَ، واستَغفَرَ اللهَ، وعَزَلَ حَجَرًا عن طَريقِ النَّاسِ، أو شَوكةً، أو عَظمًا عن طَريقِ النَّاسِ، وأمَرَ بمَعروفٍ، أو نَهى عن مُنكَرٍ، عَدَدَ تلك السِّتِّينَ والثَّلاثِ مِائةِ السُّلامى؛ ",1],["فإنَّه يَمشي يَومَئذٍ وقد زَحزَحَ نَفسَه عَنِ النَّارِ",2],". قال أبو توبة: وربما قال: يمسي . [وفي رواية] أو أمر بمعروف، وقال: فإنه يمسي يومئذ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"Y2sTkNya"},{"id":"س-01169","fp":"ad8f895dd589","stateId":681,"easy":"إذا قلت صباحاً «اللهم إنا أصبحنا نشهدك ونشهد حملة عرشك...» ← يعتق الله ربعك من النار في ذلك اليوم","cause":"مَن قالَ حينَ يُصبِحُ: اللَّهُمَّ إنَّا أصْبَحْنا نُشهِدُك، ونُشهِدُ حَمَلةَ عَرْشِك ومَلائِكتَك وجَميعَ خَلْقِك بأنَّك أنت اللهُ لا إلهَ إلَّا أنت وَحْدَك لا شَريكَ لك وأنَّ مُحمَّدًا عَبْدُك ورَسولُك","result":"إلَّا أعْتَقَ اللهُ عَزَّ وجَلَّ رُبُعَه مِن النَّارِ في ذلك اليَوْمِ، فإن قالَها مَرَّتَينِ أعْتَقَ اللهُ نِصْفَه، وإن قالَها ثَلاثًا أعْتَقَ اللهُ ثَلاثةَ أرْباعِه، فإن قالَها أرْبَعَ مَرَّاتٍ أعْتَقَه اللهُ","explicit":true,"star":true,"apply":{"k":"say","t":"«اللَّهُمَّ إنَّا أصْبَحْنا نُشهِدُك، ونُشهِدُ حَمَلةَ عَرْشِك ومَلائِكتَك وجَميعَ خَلْقِك بأنَّك أنت اللهُ لا إلهَ إلَّا أنت وَحْدَك لا شَريكَ لك وأنَّ مُحمَّدًا عَبْدُك ورَسولُك، إلَّا أعْتَقَ اللهُ عَزَّ وجَلَّ رُبُعَه مِن النَّارِ في ذلك اليَوْمِ» · الوقت: في الصباح"},"ref":"الأحاديث المختارة 2649","srcLabel":"متفق عليه","text":["«كانَ يقولُ: ",["مَن قالَ حينَ يُصبِحُ: اللَّهُمَّ إنَّا أصْبَحْنا نُشهِدُك، ونُشهِدُ حَمَلةَ عَرْشِك ومَلائِكتَك وجَميعَ خَلْقِك بأنَّك أنت اللهُ لا إلهَ إلَّا أنت وَحْدَك لا شَريكَ لك وأنَّ مُحمَّدًا عَبْدُك ورَسولُك، ",1],["إلَّا أعْتَقَ اللهُ عَزَّ وجَلَّ رُبُعَه مِن النَّارِ في ذلك اليَوْمِ، فإن قالَها مَرَّتَينِ أعْتَقَ اللهُ نِصْفَه، وإن قالَها ثَلاثًا أعْتَقَ اللهُ ثَلاثةَ أرْباعِه، فإن قالَها أرْبَعَ مَرَّاتٍ أعْتَقَه اللهُ",2]," ذلك اليَوْمَ مِن النَّارِ»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"أدعية وأذكار › فضل الذكر","dorar":"Ntf8Cw5k"},{"id":"س-04300","fp":"475ec39b1346","stateId":681,"easy":"إذا تعوذت بالله من النار ثلاثاً ← تقول النار: اللهم أعذه مني","cause":"ومن تعوَّذَ باللهِ من النَّارِ ثلاثًا","result":"قالت النَّارُ: اللَّهُمَّ أعِذْه مني","explicit":true,"star":true,"similar":["س-00679"],"ref":"الأحاديث المختارة 1560","srcLabel":"البخاري","text":["«من سأل اللهَ الجنَّةَ ثلاثًا، قالت الجنَّةُ: اللَّهُمَّ أدخِلْه الجنَّةَ، ",["ومن تعوَّذَ باللهِ من النَّارِ ثلاثًا، ",1],["قالت النَّارُ: اللَّهُمَّ أعِذْه مني»",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"sxHj6p6z"},{"id":"س-00946","fp":"aab3fb02ec54","stateId":681,"easy":"إذا كبّرت وحمدت وهلّلت وسبّحت وأمطت الأذى ← تمسي وقد زحزحت نفسك عن النار","cause":"فمَن كبَّر اللهَ وحمِده وهلَّل اللهَ وسبَّح اللهَ واستغفَر اللهَ وعزَل عظْمًا عن طريقِ النَّاسِ وعزَل حجَرًا عن طريقِهم وأمَر بمعروفٍ ونهى عن منكَرٍ عددَ تلك السِّتينَ والثَّلاثِمئةٍ","result":"فإنَّه يُمسي يومَئذٍ وقد زحزَح نفسَه عن النَّارِ","explicit":true,"repOf":"س-00858","ref":"صحيح ابن حبان 3380","text":["خلَق اللهُ كلَّ إنسانٍ مِن بني آدَمَ على ستِّينَ وثلاثِمئةِ مَفصِلٍ ",["فمَن كبَّر اللهَ وحمِده وهلَّل اللهَ وسبَّح اللهَ واستغفَر اللهَ وعزَل عظْمًا عن طريقِ النَّاسِ وعزَل حجَرًا عن طريقِهم وأمَر بمعروفٍ ونهى عن منكَرٍ عددَ تلك السِّتينَ والثَّلاثِمئةٍ ",1],["فإنَّه يُمسي يومَئذٍ وقد زحزَح نفسَه عن النَّارِ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (1007)، وأبو عوانة في ((المستخرج)) (3464)، والطحاوي في ((مشكل الآثار)) (97) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"72WvpdfL"},{"id":"س-03234","fp":"3e3af0eb0cc5","stateId":681,"easy":"إذا استجرت من النار ثلاث مرات ← تقول النار: يا رب إن عبدك استجار مني فأجره","cause":"ما استجارَ عبدٌ منَ النَّارِ ثلاثَ مرَّاتٍ","result":"إلَّا قالَتِ النَّارُ ، يا ربِّ : إنَّ عبدَك فُلانًا قدِ استجارَ منِّي فأجِره : ولا سألَ عبدٌ الجنَّةَ سبعَ مرَّاتٍ إلَّا قالتِ الجنَّةُ : يا رَبِّ إنَّ عبدَك فُلانًا","explicit":true,"star":true,"apply":{"k":"count","t":"ثلاث مرات"},"similar":["س-03236","س-07433"],"ref":"نهاية البداية والنهاية 2/319","srcLabel":"مسلم","text":[["ما استجارَ عبدٌ منَ النَّارِ ثلاثَ مرَّاتٍ ،",1]," ",["إلَّا قالَتِ النَّارُ ، يا ربِّ : إنَّ عبدَك فُلانًا قدِ استجارَ منِّي فأجِره : ولا سألَ عبدٌ الجنَّةَ سبعَ مرَّاتٍ إلَّا قالتِ الجنَّةُ : يا رَبِّ إنَّ عبدَك فُلانًا",2]," سألَني فأدخلهُ الجنَّةَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"على شرط مسلم","takhrij":"أخرجه إسحاق بن راهويه في ((المسند)) (213)، وأبو يعلى (6192)، والبيهقي في ((الدعوات الكبير)) (321) باختلاف يسير.","bab":"استعاذة › التعوذ","dorar":"gHEtvH70"},{"id":"س-01119","fp":"c8e6639bf8bf","stateId":681,"easy":"إذا ذكرت الله ← فما عمل آدمي عملاً أنجى له من عذاب الله من ذكره","cause":"ذِكْرِ اللهِ","result":"ما عمِل آدمِيٌّ عمَلًا أنجى له مِن عذابِ اللهِ","explicit":true,"similar":["س-01137"],"ref":"مجمع الزوائد 10/76","srcLabel":"الطبراني","text":[["ما عمِل آدمِيٌّ عمَلًا أنجى له مِن عذابِ اللهِ",2]," مِن ",["ذِكْرِ اللهِ",1]," وقال معاذٌ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ألا أُخْبِرُكم بخيرِ أعمالِكم [ و ] أزكاها عندَ مَليكِكم وأرفعِها في درَجاتِكم وخيرٍ لكم مِن تعاطي الذَّهَبِ والفِضَّةِ ومِن أن تَلْقَوا عدوَّكم غدًا فتضرِبوا أعناقَهم ويضرِبوا أعناقَكم قالوا بلى يا رسولَ اللهِ قال ذِكْرُ اللهِ عزَّ وجلَّ"],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"رجاله رجال الصحيح إلا أن زياد بن أبي زياد مولى ابن عياش لم يدرك معاذا","takhrij":"أخرجه ابن أبي شيبة في ((المصنف)) (30065)، والعقيلي في ((الضعفاء الكبير)) (4/45)، والطبراني (20/166) (352) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"m4DvFQub","merged":2,"otherRefs":["مجمع الزوائد 10/76 (صحيح)"]},{"id":"س-02398","fp":"0669ece021f8","stateId":681,"easy":"إذا قلت بعد المغرب قبل أن تكلم أحداً «اللهم أجرني من النار» سبعاً ← إن مت من ليلتك كُتب لك جوار منها","cause":"إذا صلَّيْتَ المغربَ فقُلْ قبْلَ أنْ تُكَلِّمَ أحدًا: اللَّهمَّ أجِرْني مِن النَّارِ سبعَ مرَّاتٍ","result":"فإنَّك إنْ مِتَّ مِن ليلتِك تلك كتَب اللهُ لك جوازًا مِن النار","explicit":true,"apply":{"k":"say","t":"«اللهم أجرني من النار»"},"similar":["س-02399"],"ref":"صحيح ابن حبان 2022","srcLabel":"أبو داود","text":["بعَثَنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم في سَريَّةٍ فلمَّا بلَغْنا المغار استحثَثْتُ فرسي فسبَقْتُ أصحابي فتلقَّاني الحيُّ بالرَّنينِ فقُلْتُ: قولوا: لا إلهَ إلَّا اللهُ تَحرَّزوا، فقالوها فلامني أصحابي وقالوا: حرَمَنا الغنيمةَ بعدَ أنْ رُدَّت بأيدينا فلمَّا قدِمْنا على رسولِ اللهِ صلَّى اللهُ عليه وسلَّم أخبَروه بما صنَعْتُ فدعاني فحسَّن لي ما صنَعْتُ وقال: ( أمَا إنَّ اللهَ قد كتَب لك بكلِّ إنسانٍ منهم كذا وكذا ) قال عبدُ الرَّحمنِ: فأنا نسيتُ الثَّوابَ قال: ثمَّ قال لي: ( إنِّي سأكتب لك كتابًا وأوصي بك مَن يكونُ بعدي مِن أئمَّةِ المسلِمينَ ) قال: فكتَب لي كتابًا وختَم عليه ودفَعه إليَّ وقال: ( ",["إذا صلَّيْتَ المغربَ فقُلْ قبْلَ أنْ تُكَلِّمَ أحدًا: اللَّهمَّ أجِرْني مِن النَّارِ سبعَ مرَّاتٍ ",1],["فإنَّك إنْ مِتَّ مِن ليلتِك تلك كتَب اللهُ لك جوازًا مِن النار",2],"، وإذا صلَّيْتَ الصُّبحَ فقُلْ قبْلَ أنْ تُكلِّمَ أحدًا: اللَّهمَّ أجِرْني مِن النَّارِ سبعَ مرَّاتٍ فإنَّك إنْ مِتَّ مِن يومِك ذلك كتَب اللهُ لك جوازًا مِن النَّارِ ) قال: فلمَّا قبَض اللهُ رسوله أتَيْتُ أبا بكرٍ بالكتابِ ففضَّه فقرَأه وأمَر لي بعطاءٍ وختَم عليه ثمَّ أتَيْتُ به عمرَ فقرَأه وأمَر لي وختَم عليه ثمَّ أتَيْتُ به عثمانَ ففعَل مثلَ ذلك ) \nقال مسلمُ بنُ الحارثِ: توفِّي الحارثُ بنُ مسلمٍ في خلافةِ عثمانَ وترَك الكتابَ عندَنا فلم يزَلْ عندَنا حتَّى كتَب عمرُ بنُ عبدِ العزيزِ إلى الوالي ببلدِنا يأمُرُه بإشخاصي إليه والكتابِ فقدِمْتُ عليه ففضَّه وأمَر لي وختَم عليه وقال: أمَا إنِّي لو شِئْتُ أنْ يأتيَك ذلك وأنتَ في منزلِك فعَلْتُ ولكنْ أحبَبْتُ أنْ تُحدِّثَني بالحديثِ على وجهِه قال: فحدَّثْتُه"],"grade":"صحيح","narrator":"الحارث بن مسلم التميمي","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (5080)، وأحمد (18054)، بنحوه.","bab":"إسلام › فضل الشهادتين","dorar":"oF0TRnAN","merged":2,"otherRefs":["هداية الرواة 2/472 (حسن)"]},{"id":"س-00727","fp":"a53fe8df749c","stateId":681,"easy":"إذا قلت تلك الكلمات في مرضك ثم مت ← لم تدخل النار","cause":"إذا قالهن في مرضِه ثم مات","result":"لم يدخلِ النارَ","explicit":true,"ref":"الصحيح المسند 2/409","srcLabel":"الترمذي","text":["إن اللهَ تبارك وتعالى, يصدقُ العبدَ في خمسٍ يقولُهن : إذا قال : لا إلهَ إلا اللهُ لا شريكَ له قال : صدق عبدي, وإذا قال : لا إلهَ إلا اللهُ واللهُ أكبرُ قال : صدق عبدي, وإذا قال : لا إلهَ إلا اللهُ والحمدُ للهِ قال : صدق عبدي, وإذا قال : لا إلهَ إلا اللهُ له الملكُ وله الحمدُ قال : صدق عبدي . قال أبو إسحاقَ : وحدثني أبو جعفرٍ عن الأغرِّ, عن أبي هريرةَ قال : ",["إذا قالهن في مرضِه ثم مات ",1],["لم يدخلِ النارَ ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو يعلى (6163) واللفظ له، والترمذي (3430)، وابن ماجة (3794) بنحوه.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"T7KP9BpM"},{"id":"س-01130","fp":"40c130788a40","stateId":681,"easy":"إذا قلت «اللهم إني أشهدك وأشهد ملائكتك وحملة عرشك...» ← يعتق الله ثلثك من النار بكل مرة","cause":"من قال : اللهمَّ إني أُشهدُك ، و أُشهدُ ملائكتَك ، و حملةَ عرشِك ، و أُشهدُ من في السماواتِ و من في الأرضِ أنك أنت اللهُ ، لا إلهَ إلا أنتَ وحدَك لا شريك لك ، و أشهدُ أنَّ محمدًا عبدُك و رسولُك","result":"من قالها مرةً أعتق اللهُ ثلثَه من النارِ ، و من قالها مرتيْنِ أعتق اللهُ ثلثيْهِ من النارِ ، و من قالها ثلاثًا أعتق اللهُ كلَّهُ من النارِ","explicit":true,"apply":{"k":"say","t":"«اللهم إني أشهدك وأشهد ملائكتك وحملة عرشك...»"},"ref":"السلسلة الصحيحة 267","srcLabel":"السلسلة الصحيحة","text":[["من قال : اللهمَّ إني أُشهدُك ، و أُشهدُ ملائكتَك ، و حملةَ عرشِك ، و أُشهدُ من في السماواتِ و من في الأرضِ أنك أنت اللهُ ، لا إلهَ إلا أنتَ وحدَك لا شريك لك ، و أشهدُ أنَّ محمدًا عبدُك و رسولُك",1]," ، ",["من قالها مرةً أعتق اللهُ ثلثَه من النارِ ، و من قالها مرتيْنِ أعتق اللهُ ثلثيْهِ من النارِ ، و من قالها ثلاثًا أعتق اللهُ كلَّهُ من النارِ",2]," . [ ثم تردَّدَ الشيخُ في تصحيحِ إسنادِه في آخرِ التخريجِ ، انظر \" السلسلة الصحيحة \" 1 / 537 ]"],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"إسناده صحيح","bab":"أدعية وأذكار › فضل الذكر","dorar":"4dboq8FA"},{"id":"س-01137","fp":"bbc27db98d2b","stateId":681,"easy":"إذا ذكرت الله ← فما من شيء أنجى من عذاب الله من ذكره","cause":"من ذِكرِ اللهِ","result":"وما من شيءٍ أنجى من عذابِ اللهِ","explicit":true,"repOf":"س-01119","ref":"صحيح الترغيب 1495","text":[". . . ، ",["وما من شيءٍ أنجى من عذابِ اللهِ",2]," ",["من ذِكرِ اللهِ",1]," . قالوا : ولا الجهادُ في سبيل اللهِ ؟ قال : ولو أن يضربَ بسَيْفِه حتى ينقطعَ ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح لغيره","bab":"أدعية وأذكار › فضل الذكر","dorar":"8MfoNUkM"},{"id":"س-01148","fp":"d271098bd198","stateId":681,"easy":"إذا صليت الغداة ثم قعدت تذكر الله حتى الشروق ← يجعل الله بينك وبين النار ستراً","cause":"مَنْ صلَّى الغَداةَ ثُمَّ قعدَ يذكرُ اللهَ حتى تطلَُع الشمسُ","result":"جعلَ اللهُ بينهُ وبينَ النارِ سِتْرًا","explicit":true,"ref":"البحر الزخار 4/173","srcLabel":"البزار","text":["أتيتُ المدينةَ أزورُ ابنةَ عمٍّ لِي تحتَ الحسَنِ بنِ علِيٍّ فشهِدتُ معهُ صلاةَ الصُّبحِ في مَسجدِ الرسولِ ، وأصبحَ ابنُ الزُّبيرِ قدْ أوْلَمَ ، فأتى رسولُ ابنِ الزبيرِ ، فقال : يا ابنَ رسولِ اللهِ ! إنَّ ابنَ الزُّبيرِ أصبحَ قدْ أوْلَمَ وقدْ أرسلَنِي إليكَ ، فلَمْ يلْتفِتْ إليه ، فطافَ في المسجِدِ فتفرى الخلقَ يدعُوهمْ ، ثُمَّ رجعَ إلى الحسَنِ فقال : يا ابنَ رسولِ اللهِ ! ابنُ الزُّبيرِ قدْ أولَمَ وقدْ أرسلَنِي إليكَ ، فالتفتَ إليَّ فقال : هل طلَعتْ الشمسُ ؟ قِيلَ : لا أحسِبُ إلَّا قدْ طلَعتْ فقال : الحمدُ للهِ الَّذي أطلَعَها من مطلِعِها ثُمَّ قال : سمعتُ أبِي وجدِّي - يعني : النبيَّ صلَّى اللهُ عليه وسلَّمَ - يقولُ : ",["مَنْ صلَّى الغَداةَ ثُمَّ قعدَ يذكرُ اللهَ حتى تطلَُع الشمسُ ",1],["جعلَ اللهُ بينهُ وبينَ النارِ سِتْرًا ",2],"، ثُم قال : قومُوا فأجِيبوا ابنَ الزُّبيرِ ، فلَمّا انتهيْنا إلى البابِ تلَقَّاهُ ابنُ الزبيرِ على البابِ ، فقال : يا ابنَ رسولِ اللهِ ! أبطأْتَ عنِّي في هذا اليومِ فقال : أمَا إنِّي قدْ أجبتُكمْ أنِّي صائِمٌ ، ثُمَّ قال : فهاهُنا تُحفةٌ ، فقال الحسَنُ بنُ علِيٍّ : سمعتُ أبِي وجدِّي - يعني : النبيَّ صلَّى اللهُ عليه وسلَّمَ - يقولُ : تُحفَةُ الصائِمِ الزَّائِرِ أنْ تُغلَّفَ لِحيتُهُ ، وتُجْمَّرَ ثيابُه وتُذَرَّرَ . وتُحفةُ المرأةِ الصائِمةِ الزائِرَةِ أنْ تُمَشَّطَ رأسُها ، وتُجمَّرَ ثيابُها وتُذرَّرَ ، قال : قُلتُ : يا ابنَ رسولِ اللهِ ! أعِدْ عليَّ الحديثَ : قال : سمعتُ أبي وجدِّي - يعني : النبيَّ صلَّى اللهُ عليه وسلَّمَ - يقولُ : مَنْ أدامَ الاختلافَ إلى المسجدِ أصابَ آيةً مُحكَمةً ، أوْ رحمةً مُنتظِرَةً ، أوْ عِلمًا مُستطرَفًا ، أوْ كلمةً تَزيدُهُ هُدًى أوْ تَرُدَّهُ عن رَدًى ، أوْ يدَعُ الذنوبَ خشيةً أوْ حياءً"],"grade":"صحيح","narrator":"الحسن بن علي بن أبي طالب","muhaddith":"محفوظ","takhrij":"أخرجه البزار (1335)","bab":"أدعية وأذكار › فضل الذكر","dorar":"hTD6x60n"},{"id":"س-01199","fp":"9bd4023eeb8d","stateId":681,"easy":"إذا رُزقت تلك الكلمات عند موتك ← لم تمسك النار","cause":"من رزقهنَّ عندَ موتِهِ","result":"لم تمسَّهُ النَّارُ","explicit":true,"ref":"صحيح ابن ماجه 3076","srcLabel":"ابن ماجه","text":["إذا قالَ العبدُ لا إلهَ إلَّا اللَّهُ واللَّهُ أكبرُ قالَ يقولُ اللَّهُ عزَّ وجلَّ صدقَ عبدي لا إلهَ إلَّا أنا وأنا أكبرُ وإذا قالَ العبدُ لا إلهَ إلَّا اللَّهُ وحدَهُ قالَ صدقَ عبدي لا إلهَ إلَّا أنا وحدي وإذا قالَ لا إلهَ إلَّا اللَّهُ لا شريكَ لهُ قالَ صدقَ عبدي لا إلهَ إلَّا أنا ولا شريكَ لي وإذا قالَ لا إلهَ إلَّا اللَّهُ لهُ الملكُ ولهُ الحمدُ قالَ صدقَ عبدي لا إلهَ إلَّا أنا لي الملكُ وليَ الحمدُ وإذا قالَ لا إلهَ إلَّا اللَّهُ ولا حولَ ولا قوَّةَ إلَّا باللَّهِ قالَ صدقَ عبدي لا إلهَ إلَّا أنا ولا حولَ ولا قوَّةَ إلَّا بي قالَ أبو إسحاقَ ثمَّ قالَ الأغرُّ شيئًا لم أفهمْهُ قالَ فقلتُ لأبي جعفرٍ ما قالَ فقالَ ",["من رزقهنَّ عندَ موتِهِ",1]," ",["لم تمسَّهُ النَّارُ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري وأبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (3794) واللفظ له، وأبو يعلى (6154)","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"gLxDJ4yn"},{"id":"س-02399","fp":"709a075258a9","stateId":681,"easy":"إذا قلتها بعد الصبح قبل أن تكلم أحداً ← إن مت من يومك كُتب لك جوار منها","cause":"وإذا صلَّيْتَ الصُّبحَ فقُلْ قبْلَ أنْ تُكلِّمَ أحدًا: اللَّهمَّ أجِرْني مِن النَّارِ سبعَ مرَّاتٍ","result":"فإنَّك إنْ مِتَّ مِن يومِك ذلك كتَب اللهُ لك جوازًا مِن النَّارِ","explicit":true,"repOf":"س-02398","ref":"صحيح ابن حبان 2022","text":["بعَثَنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم في سَريَّةٍ فلمَّا بلَغْنا المغار استحثَثْتُ فرسي فسبَقْتُ أصحابي فتلقَّاني الحيُّ بالرَّنينِ فقُلْتُ: قولوا: لا إلهَ إلَّا اللهُ تَحرَّزوا، فقالوها فلامني أصحابي وقالوا: حرَمَنا الغنيمةَ بعدَ أنْ رُدَّت بأيدينا فلمَّا قدِمْنا على رسولِ اللهِ صلَّى اللهُ عليه وسلَّم أخبَروه بما صنَعْتُ فدعاني فحسَّن لي ما صنَعْتُ وقال: ( أمَا إنَّ اللهَ قد كتَب لك بكلِّ إنسانٍ منهم كذا وكذا ) قال عبدُ الرَّحمنِ: فأنا نسيتُ الثَّوابَ قال: ثمَّ قال لي: ( إنِّي سأكتب لك كتابًا وأوصي بك مَن يكونُ بعدي مِن أئمَّةِ المسلِمينَ ) قال: فكتَب لي كتابًا وختَم عليه ودفَعه إليَّ وقال: ( إذا صلَّيْتَ المغربَ فقُلْ قبْلَ أنْ تُكَلِّمَ أحدًا: اللَّهمَّ أجِرْني مِن النَّارِ سبعَ مرَّاتٍ فإنَّك إنْ مِتَّ مِن ليلتِك تلك كتَب اللهُ لك جوازًا مِن النار، ",["وإذا صلَّيْتَ الصُّبحَ فقُلْ قبْلَ أنْ تُكلِّمَ أحدًا: اللَّهمَّ أجِرْني مِن النَّارِ سبعَ مرَّاتٍ",1]," ",["فإنَّك إنْ مِتَّ مِن يومِك ذلك كتَب اللهُ لك جوازًا مِن النَّارِ",2]," ) قال: فلمَّا قبَض اللهُ رسوله أتَيْتُ أبا بكرٍ بالكتابِ ففضَّه فقرَأه وأمَر لي بعطاءٍ وختَم عليه ثمَّ أتَيْتُ به عمرَ فقرَأه وأمَر لي وختَم عليه ثمَّ أتَيْتُ به عثمانَ ففعَل مثلَ ذلك ) \nقال مسلمُ بنُ الحارثِ: توفِّي الحارثُ بنُ مسلمٍ في خلافةِ عثمانَ وترَك الكتابَ عندَنا فلم يزَلْ عندَنا حتَّى كتَب عمرُ بنُ عبدِ العزيزِ إلى الوالي ببلدِنا يأمُرُه بإشخاصي إليه والكتابِ فقدِمْتُ عليه ففضَّه وأمَر لي وختَم عليه وقال: أمَا إنِّي لو شِئْتُ أنْ يأتيَك ذلك وأنتَ في منزلِك فعَلْتُ ولكنْ أحبَبْتُ أنْ تُحدِّثَني بالحديثِ على وجهِه قال: فحدَّثْتُه"],"grade":"صحيح","narrator":"الحارث بن مسلم التميمي","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (5080)، وأحمد (18054)، بنحوه.","bab":"إسلام › فضل الشهادتين","dorar":"oF0TRnAN"},{"id":"س-03236","fp":"f7de91f1f404","stateId":681,"easy":"إذا استجرت من النار سبع مرات في يوم ← تقول النار: يا رب أجره مني","cause":"ما اسْتَجَارَ عَبْدٌ مِنَ النارِ سبعَ مراتٍ في يَوْمٍ","result":"إلَّا قالتِ النارُ : يا رَبِّ إِنَّ عَبْدَكَ فُلانًا قَدِ اسْتَجَارَكَ مِنِّي فَأَجِرْهُ ، و لا يَسْأَلُ اللهَ عَبْدٌ الجنةَ في يَوْمٍ سبعَ مراتٍ ، إلَّا قالتِ الجنةُ : يا","explicit":true,"apply":{"k":"count","t":"سبع مرات"},"repOf":"س-03234","ref":"السلسلة الصحيحة 2506","text":[["ما اسْتَجَارَ عَبْدٌ مِنَ النارِ سبعَ مراتٍ في يَوْمٍ",1]," ",["إلَّا قالتِ النارُ : يا رَبِّ إِنَّ عَبْدَكَ فُلانًا قَدِ اسْتَجَارَكَ مِنِّي فَأَجِرْهُ ، و لا يَسْأَلُ اللهَ عَبْدٌ الجنةَ في يَوْمٍ سبعَ مراتٍ ، إلَّا قالتِ الجنةُ : يا",2]," رَبِّ إِنَّ عَبْدَكَ فُلانًا سألَنِي فَأَدْخِلْهُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه إسحاق بن راهويه في ((المسند)) (213)، وأبو يعلى (6192) واللفظ له، والبيهقي في ((الدعوات الكبير)) (321)","bab":"استعاذة › التعوذ","dorar":"ME463YCV"},{"id":"س-07433","fp":"491dda65fae2","stateId":681,"easy":"إذا استجرت من النار ثلاث مرات ← تقول النار: اللهم أجره مني","cause":"ما اسْتَجارَ عبدٌ منَ النَّارِ ثلاثَ مِرارٍ","result":"إلَّا قالتِ النَّارُ: اللَّهُمَّ أَجِرْه منِّي، ولا يَسأَلُ الجَنَّةَ إلَّا قالتِ الجَنَّةُ: اللَّهُمَّ أَدخِلْه إيَّايَ","explicit":true,"apply":{"k":"count","t":"ثلاث مرات"},"repOf":"س-03234","ref":"تخريج المسند لشعيب 12170","text":[["ما اسْتَجارَ عبدٌ منَ النَّارِ ثلاثَ مِرارٍ",1]," ",["إلَّا قالتِ النَّارُ: اللَّهُمَّ أَجِرْه منِّي، ولا يَسأَلُ الجَنَّةَ إلَّا قالتِ الجَنَّةُ: اللَّهُمَّ أَدخِلْه إيَّايَ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2572)، والنسائي (5521)، وابن ماجه (4340) بنحوه، وأحمد (12170) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"bDTMP9xb"},{"id":"س-03238","fp":"a65418621afa","stateId":681,"easy":"إذا استعذت بالله من النار ← يعيذك","cause":"استَعاذَني مِن النارِ","result":"أعَذتُه","explicit":true,"otherNeedIds":[29],"ref":"حلية الأولياء 6/188","srcLabel":"غريب من حديث صالح","text":["كان عَطاءٌ السَّليميُّ لا يَسأَلُ اللهَ الجنَّةَ، قال: فقلتُ له: إنَّ أبانا حدَّثَني عن أنَسِ بنِ مالِكٍ رضِيَ اللهُ تَعالى عنه أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قال: يقولُ اللهُ تَعالى: انظُرُوا في ديوانِ عَبدي، فمَن رأَيتُموه سأَلَني الجنَّةَ أعطَيتُه، ومَنِ ",["استَعاذَني مِن النارِ",1]," ",["أعَذتُه",2],". فقال لي عَطاءٌ: كَفاني أنْ يُجيرَني مِن النارِ."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"غريب من حديث صالح","takhrij":"أخرجه أبو نعيم في ((حلية الأولياء)) (6/175) واللفظ له، والديلمي في ((الفردوس)) (8085)","bab":"استعاذة › التعوذ","dorar":"qs6VRXeq"},{"id":"س-03446","fp":"1a12b601278c","stateId":681,"easy":"إذا استغفرت الله ← تكون آمناً من عذابه","cause":"ما استَغْفَرَ اللهَ","result":"العَبدُ آمِنٌ مِن عَذابِ اللهِ","explicit":true,"otherNeedIds":[31,6],"ref":"تخريج المسند لشعيب 23953","srcLabel":"أحمد","text":[["العَبدُ آمِنٌ مِن عَذابِ اللهِ",2],"، ",["ما استَغْفَرَ اللهَ",1],"."],"grade":"حسن","narrator":"فضالة بن عبيد","muhaddith":"حسن بمجموع طريقيه وشاهده","takhrij":"أخرجه أحمد (23953) واللفظ له، والدولابي في ((الكنى والأسماء)) (475)، وابن عساكر في ((تاريخ دمشق)) (55/86)","bab":"استغفار › فضل الاستغفار","dorar":"5qsNFujT"},{"id":"س-00679","fp":"df4ba49846c4","stateId":681,"easy":"إذا استجرت بالله من النار ثلاثاً ← تدعو لك النار: اللهم أجره","cause":"ومَن استجار مِن النارِ ثلاثَ مراتٍ","result":"قالتِ النارُ : اللهم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-04300","ref":"هداية الرواة 2412","text":["قال رسولُ اللهِ - صلَّى اللهُ عليهِ وسلَّم - :  من سأل اللهَ الجنةَ ثلاثَ مراتٍ, قالتِ الجنةُ : اللهم ! أَدخِله الجنةَ, ",["ومَن استجار مِن النارِ ثلاثَ مراتٍ ؛ ",1],["قالتِ النارُ : اللهم ",2],"! أَجِره مِن النارِ  ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2572)، والنسائي (5521)، وابن ماجه (4340) واللفظ لهم، وأحمد (12585) باختلاف يسير","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"FBbSD2hU"},{"id":"س-06816","fp":"755a371cfc61","stateId":681,"easy":"إذا ناديت ربك «يا حنان يا منان» ← يرحمك الله","cause":"يا حنانُ يا منانُ","result":"دعوا عَبدي","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"apply":{"k":"say","t":"«يا حنان يا منان»"},"otherNeedIds":[29],"ref":"البدور السافرة 376","srcLabel":"أحمد","text":["إن عبدًا ليُنادي في النارِ ألفَ سنةٍ : ",["يا حنانُ يا منانُ",1]," ، فيقولُ اللهُ لجبريلَ : اذهبْ فائتني بعبدي هذا ، فينطلقُ جبريلُ فيجدُ أهلَ النارِ مُكبِّينَ يبكونَ ، فيرجعُ إلى ربِّهِ فيخبرُهُ ، فيقولُ : ائتِني به فإنَّهُ في مكانِ كذا وكذا ، فيَجئُ به فيوقفُهُ على ربِّهِ ، فيقولُ له : يا عَبدي كيفَ وجدْتَ مكانَكَ ومَقيلَكَ ؟ فيقولُ : أيْ ربِّ شرُّ مكانٍ وشرُّ مَقيلٍ ، فيقولُ : ردُّوا عبدي فيقولُ : يا ربِّ ما كنْتُ أرجو إذ أخرجْتَني منها أن تَردَّني فيها ، فيقولُ : ",["دعوا عَبدي",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (13411)،  وأبو يعلى (4210)، وابن حبان في ((المجروحين)) (3/ 86) جميعهم باختلاف يسير.","bab":"عقيدة › إثبات أسماء الله","dorar":"qZhZlYlM"},{"id":"س-07096","fp":"cc477e3b0e5f","stateId":682,"easy":"إذا قدّمت المرأة ثلاثة من ولدها ← كانوا لها حجاباً من النار","cause":"ما مِنكُنَّ مِنِ امرَأةٍ تُقدِّمُ بينَ يَدَيها مِن ولَدِها ثَلاثةً","result":"إلَّا كانوا لَها حِجابًا مِنَ النَّارِ","explicit":true,"star":true,"otherNeedIds":[9,67],"ref":"صحيح مسلم 2633","srcLabel":"البخاري","text":["جاءَتِ امرَأةٌ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقالت: يا رَسولَ اللهِ، ذَهَبَ الرِّجالُ بحَديثِكَ، فاجعَلْ لَنا مِن نَفسِكَ يَومًا نَأتيكَ فيه، تُعَلِّمُنا ممَّا عَلَّمَكَ اللهُ، قال: اجتَمِعنَ يَومَ كَذا وكَذا، فاجتَمَعنَ فأتاهنَّ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم فعَلَّمَهنَّ ممَّا عَلَّمَه اللهُ، ثُمَّ قال: ",["ما مِنكُنَّ مِنِ امرَأةٍ تُقدِّمُ بينَ يَدَيها مِن ولَدِها ثَلاثةً",1]," ",["إلَّا كانوا لَها حِجابًا مِنَ النَّارِ",2],"، فقالتِ امرَأةٌ: واثنَينِ، واثنَينِ، واثنَينِ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: واثنَينِ، واثنَينِ، واثنَينِ. وفي روايةٍ: ثَلاثةً لم يَبلُغوا الحِنثَ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7310) باختلاف يسير، وأحمد (11296)، والنسائي في ((الكبرى)) (5865)  بنحوه","bab":"علم › تعليم الناس وفضل ذلك","dorar":"Ge1teKtR","merged":11,"otherRefs":["صحيح الأدب المفرد 110 (صحيح)","تخريج المسند لشعيب 3995 (صحيح)","تخريج المسند لشعيب 11686 (صحيح)","صحيح البخاري 101 (صحيح)","تخريج صحيح ابن حبان 2944 (صحيح)","صحيح الجامع 2707 (صحيح)","تخريج المسند لشعيب 4314 (صحيح)","تخريج المسند لشعيب 4077 (صحيح)","تخريج المسند لشعيب 11296 (صحيح)","البحر الزخار 6/312 (صحيح)"]},{"id":"س-02714","fp":"3c9c0ef8365a","stateId":682,"easy":"إذا ابتُليت بالبنات فأحسنت إليهن ← كن لك ستراً من النار","cause":"مَنِ ابتُليَ مِنَ البَناتِ بشيءٍ، فأحسَنَ إليهنَّ","result":"كُنَّ له سِترًا مِنَ النَّارِ","explicit":true,"star":true,"similar":["س-02719","س-04284"],"ref":"صحيح مسلم 2629","srcLabel":"البخاري","text":["جاءَتني امرَأةٌ، ومعها ابنَتانِ لَها، فسَألَتني فلم تَجِدْ عِندي شيئًا غيرَ تَمرةٍ واحِدةٍ، فأعطَيتُها إيَّاها، فأخَذَتها فقَسَمَتها بينَ ابنَتَيها، ولم تَأكُلْ منها شيئًا، ثُمَّ قامَت فخَرَجَت وابنَتاها، فدَخَلَ عليَّ النَّبيُّ صلَّى اللهُ عليه وسلَّم فحَدَّثتُه حَديثَها، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ",["مَنِ ابتُليَ مِنَ البَناتِ بشيءٍ، فأحسَنَ إليهنَّ، ",1],["كُنَّ له سِترًا مِنَ النَّارِ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5995) باختلاف يسير","bab":"إيمان › القطع بدخول أحد الجنة أو النار","dorar":"GySuh7wL","merged":5,"otherRefs":["تخريج المسند لشعيب 26060 (صحيح)","صحيح البخاري 1418 (صحيح)","تخريج صحيح ابن حبان 2939 (صحيح)","صحيح الترغيب 1968 (صحيح)"]},{"id":"س-04246","fp":"9371432adc38","stateId":682,"easy":"إذا كان لك ثلاث بنات فصبرت عليهن وأطعمتهن وكسوتهن ← كن لك حجاباً من النار","cause":"مَن كان له ثلاثُ بناتٍ، فصبَرَ عليهِنَّ، وأطعمَهُنَّ، وسَقاهُنَّ، وكَساهُنَّ من جِدَتِه من غِناه","result":"كُنَّ له حِجابًا من النَّارِ يومَ القيامةِ","explicit":true,"star":true,"similar":["س-07149","س-01980"],"otherNeedIds":[38],"ref":"تخريج سنن أبي داود 7/460","srcLabel":"البخاري","text":["\"",["مَن كان له ثلاثُ بناتٍ، فصبَرَ عليهِنَّ، وأطعمَهُنَّ، وسَقاهُنَّ، وكَساهُنَّ من جِدَتِه (من غِناه",1],")؛ ",["كُنَّ له حِجابًا من النَّارِ يومَ القيامةِ",2],"\"."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (3669) واللفظ له ، وأحمد (17403) ، والبخاري في ((الأدب المفرد)) (76) كلاهما بلفظ قريب .","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"LvyR1uun"},{"id":"س-04286","fp":"a050af541d10","stateId":682,"easy":"إذا مات لك ثلاثة لم يبلغوا الحلم ← لم تمسك النار إلا تحلة القسم","cause":"من مات له ثلاثةٌ لم يبلُغوا الحِنْثَ","result":"لم تَمَسَّهُ النارُ إلا تَحِلَّةَ الْقَسَمِ","explicit":true,"ref":"تخريج المسند لشاكر 14/148","srcLabel":"متفق عليه","text":[["من مات له ثلاثةٌ لم يبلُغوا الحِنْثَ ",1],["لم تَمَسَّهُ النارُ إلا تَحِلَّةَ الْقَسَمِ",2]," يعني الورودَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (1251)، ومسلم (2632) بنحوه، وأحمد (7721) واللفظ له","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"O6hNo4Y1"},{"id":"س-06029","fp":"128a0f3caf7a","stateId":682,"easy":"إذا قدّمت ثلاثة من الولد ← لم تلج النار إلا تحلة القسم","cause":"مَن قَدَّم ثَلاثةً مِنَ الوَلدِ لمْ يَلِجِ النَّارَ إلَّا تَحِلَّةَ القَسَمِ، وَقالَ مَعمَرٌ","result":"لَم تَمسَّه النَّارُ","explicit":true,"ref":"تخريج كتاب السنة 862","srcLabel":"متفق عليه","text":[["مَن قَدَّم ثَلاثةً مِنَ الوَلدِ لمْ يَلِجِ النَّارَ إلَّا تَحِلَّةَ القَسَمِ، وَقالَ مَعمَرٌ: ",1],["لَم تَمسَّه النَّارُ",2],"، وَقالَ مالكٌ: فتَمسَّه النَّارُ إلَّا تَحلَّةَ القَسَمِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (1251)، ومسلم (2632)، والترمذي (1060)، والنسائي (1875)، وابن ماجه (1603)، وأحمد (7265) بنحوه، وابن أبي عاصم في ((السنة)) (862) واللفظ له","bab":"رقائق وزهد › فضل الصبر","dorar":"QX87YEyp"},{"id":"س-02719","fp":"c58ffcbccf9a","stateId":682,"easy":"إذا وليت شيئاً من البنات فأحسنت إليهن ← كن لك ستراً من النار","cause":"مَن يَلي مِن هذه البَناتِ شيئًا، فأحسَنَ إليهنَّ","result":"كُنَّ له سِترًا مِنَ النَّارِ","explicit":true,"repOf":"س-02714","ref":"صحيح البخاري 5995","text":["جاءَتني امرَأةٌ معها ابنَتانِ تَسألُني، فلَم تَجِدْ عِندي غيرَ تَمرةٍ واحِدةٍ، فأعطَيتُها فقَسَمَتها بينَ ابنَتَيها، ثُمَّ قامَت فخَرَجَت، فدَخَلَ النَّبيُّ صلَّى اللهُ عليه وسلَّم فحَدَّثتُه، فقال: ",["مَن يَلي مِن هذه البَناتِ شيئًا، فأحسَنَ إليهنَّ، ",1],["كُنَّ له سِترًا مِنَ النَّارِ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2629) باختلاف يسير","bab":"إيمان › القطع بدخول أحد الجنة أو النار","dorar":"e1Y65uG8"},{"id":"س-02641","fp":"1bf2608d6a4e","stateId":682,"easy":"إذا قدّمت ثلاثة من الولد صغاراً تحتسبهم ← احتظرت بحظار من النار","cause":"ما مِن مُسلِمٍ يُقدِّمُ ثلاثةً في الإسلامِ لم يَبلُغوا الحِنثَ يَحتَسِبُهم","result":"إلَّا احتظَرَ بحَظَرٍ مِن النَّارِ","explicit":true,"ref":"تخريج المسند لشعيب 10923","srcLabel":"مسلم","text":["جاءتِ امرأةٌ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ بوَلَدٍ لها مَريضٍ، يدعو له بالشِّفاءِ والعافيةِ، فقالت: يا رسولَ اللهِ، قد ماتَ لي ثلاثةٌ. قال: في الإسلامِ؟ قالت: في الإسلامِ. فقال: ",["ما مِن مُسلِمٍ يُقدِّمُ ثلاثةً في الإسلامِ لم يَبلُغوا الحِنثَ يَحتَسِبُهم؛",1]," ",["إلَّا احتظَرَ بحَظَرٍ مِن النَّارِ",2],"."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده قوي","takhrij":"أخرجه مسلم (2636) باختلاف يسير","bab":"إيمان › الاحتساب والنية","dorar":"J3ruWYMX"},{"id":"س-07149","fp":"667521c150fd","stateId":682,"easy":"إذا كان لك ثلاث بنات فأنفقت عليهن حتى يبنّ أو يمتن ← كن لك حجاباً من النار","cause":"ما مِن عَبدٍ مُسلِمٍ يكونُ له ثَلاثُ بَناتٍ، فأنْفَقَ عليهِنَّ حتى يَبِنَّ أو يَمُتْنَ","result":"إلَّا كُنَّ له حِجابًا مِن النارِ","explicit":true,"repOf":"س-04246","ref":"تخريج المسند لشعيب 24007","text":[["ما مِن عَبدٍ مُسلِمٍ يكونُ له ثَلاثُ بَناتٍ، فأنْفَقَ عليهِنَّ حتى يَبِنَّ أو يَمُتْنَ،",1]," ",["إلَّا كُنَّ له حِجابًا مِن النارِ",2],"، فقالَتِ امْرأةٌ: يا رسولَ اللهِ، أو اثْنَتانِ؟ قال: أو اثْنَتانِ."],"grade":"صحيح","narrator":"عوف بن مالك الأشجعي","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (24007) واللفظ له، والحارث في ((المسند)) (902)، والطبراني (18/56) (102)","bab":"علم › حسن السؤال ونصح العالم","dorar":"cPJaqrzs","merged":2,"otherRefs":["صحيح الترغيب 1972 (حسن)"]},{"id":"س-01980","fp":"541d8ff9132f","stateId":682,"easy":"إذا كان لك ثلاث بنات أو أخوات أو اثنتان فاتقيت الله فيهن ← كن لك حجاباً من النار","cause":"مَن كُنَّ له ثَلاثُ بَناتٍ أو ثَلاثُ أخَواتٍ، أو بِنْتانِ أو أُخْتانِ، اتَّقى اللهَ فيهِنَّ، وأحْسَنَ إليهِنَّ حتى يَبِنَّ أو يَمُتْنَ","result":"كُنَّ له حِجابًا مِن النارِ","explicit":true,"repOf":"س-04246","ref":"تخريج المسند لشعيب 23991","text":[["مَن كُنَّ له ثَلاثُ بَناتٍ أو ثَلاثُ أخَواتٍ، أو بِنْتانِ أو أُخْتانِ، اتَّقى اللهَ فيهِنَّ، وأحْسَنَ إليهِنَّ حتى يَبِنَّ أو يَمُتْنَ، ",1],["كُنَّ له حِجابًا مِن النارِ",2],"."],"grade":"صحيح","narrator":"عوف بن مالك الأشجعي","muhaddith":"صحيح لغيره،","takhrij":"أخرجه أحمد (23991) واللفظ له، والحارث في ((المسند)) (902)، والطبراني (18/56) (102)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"a0IH0sEI"},{"id":"س-03804","fp":"0f4f11efadad","stateId":682,"easy":"إذا كنت حبيب الله ← لا يلقيك الله في النار","cause":"حَبيبَه","result":"لا يُلقِي اللهُ حَبيبَه في النَّارِ","explicit":true,"otherNeedIds":[23],"ref":"المستدرك على الصحيحين 7551","srcLabel":"البيهقي","text":["مَرَّ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ بأُناسٍ مِن أصحابِه، وصَبِيٌّ بيْنَ ظَهْرانَيِ الطَّريقِ، فلمَّا رأتِ أُمُّه الدَّوابَّ خشِيَتْ على ابنِها أنْ يُوطَأَ، فسَعَتْ والِهَةً فقالتِ: ابنِي ابنِي، فاحْتَمَلَتِ ابنَها، فقالَ القومُ: يا نَبيَّ اللهِ، ما كانت هذه لِتُلقِيَ ابنَها في النَّارِ، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: لا واللهِ، ",["لا يُلقِي اللهُ حَبيبَه في النَّارِ",2],"، قالَ: فخَصِمَهم نبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"أنس","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أبو يعلى (3747)، والبيهقي في ((الشعب)) (6731)، وابن أبي الدنيا في ((الأولياء)) (41) بنحوه.","bab":"بر وصلة › حب الولد","dorar":"kn1VBbvy"},{"id":"س-04284","fp":"ed82dc9a6f35","stateId":682,"easy":"إذا علت ثلاث بنات أو أخوات فأحسنت إليهن ← كن لك ستراً من النار","cause":"ليس أحدٌ من أُمَّتِي يَعولُ ثلاثَ بَناتٍ ، أوْ ثلاثَ أخَواتٍ ، فيُحسِنُ إليهِنَّ","result":"إلا كُنَّ لهُ سِترًا من النارِ","explicit":true,"repOf":"س-02714","otherNeedIds":[38],"ref":"صحيح الجامع 5372","text":[["ليس أحدٌ من أُمَّتِي يَعولُ ثلاثَ بَناتٍ ، أوْ ثلاثَ أخَواتٍ ، فيُحسِنُ إليهِنَّ",1]," ",["إلا كُنَّ لهُ سِترًا من النارِ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (5433)، والبيهقي في ((شعب الإيمان)) (11023) واللفظ له","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"Z5BuGy7E"},{"id":"س-06048","fp":"1b1f63b5417a","stateId":682,"easy":"إذا دفنت ثلاثة من الولد ← يحرّم الله عليك النار","cause":"مَن دَفَنَ ثلاثةً من الوَلَدِ","result":"حَرَّمَ اللهُ عليه النارَ","explicit":true,"ref":"صحيح الجامع 6238","srcLabel":"صحيح الجامع","text":[["مَن دَفَنَ ثلاثةً من الوَلَدِ ، ",1],["حَرَّمَ اللهُ عليه النارَ",2]],"grade":"صحيح","narrator":"واثلة بن الأسقع وأبو هريرة","muhaddith":"صحيح","bab":"رقائق وزهد › فضل الصبر","dorar":"7QpCVzQR"},{"id":"س-08308","fp":"fefe623179f0","stateId":682,"easy":"إذا كان لك ابنتان فأحسنت إليهما ← سترتاك من النار","cause":"ما مِن أحَدٍ يكونُ له ابْنَتانِ فيُحسِنُ إليهما","result":"إلَّا سَتَرَتاه مِن النَّارِ","explicit":true,"ref":"اللطائف من دقائق المعارف 445","srcLabel":"اللطائف من دقائق المعارف","text":["جاءَتِ امْرَأةٌ إليها ومعَها ابْنَتانِ لها، ومعَها تَمْرةٌ، فأخَذَتِ التَّمْرةَ فشَقَّتْها نِصْفَينِ، فأَعْطَتْ كلَّ واحِدةٍ مِنهما شَقَّةً، قالَتْ: فذَكَرْتُ ذلك لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: ",["ما مِن أحَدٍ يكونُ له ابْنَتانِ فيُحسِنُ إليهما",1]," ",["إلَّا سَتَرَتاه مِن النَّارِ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"محفوظ عن الزهري باختلاف عنه، قيل: عن الزهري، عن عَبْد اللهِ بن أبي بكر، عن عروة، وهو الصحيح","bab":"مناقب وفضائل › بعض من شهد النبي بأنهم من أهل الجنة","dorar":"9DNSDsFZ"},{"id":"س-05689","fp":"25bcbe3c9ce1","stateId":682,"easy":"إذا مات لك ثلاثة من الولد ← فهم جُنّة حصينة لك من النار","cause":"ماتَ لي قَبلَه ثَلاثةٌ","result":"جُنَّةٌ حَصينةٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[9,67],"ref":"تخريج المسند لشعيب 20783","srcLabel":"أحمد","text":["أنَّ امرَأةً أتَتِ النَّبيَّ صلَّى اللهُ عليه وسلَّم بابنٍ لها، فقالت: يا رَسولَ اللهِ، ادعُ اللهَ أن يُبقيَه لي؛ فقد ",["ماتَ لي قَبلَه ثَلاثةٌ",1],"، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: «أمنذُ أسلَمتِ؟» فقالت: نَعَم، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: «",["جُنَّةٌ حَصينةٌ",2],"»، قالت ماويةُ: فقال لي عُبَيدُ اللهِ بنُ مَعمَرٍ: «اسمَعي يا ماويةُ»، قال مُحَمَّدٌ: «فخَرَجَت ماويةُ مِن عِندِ ابنِ مَعمَرٍ، فأتَتنا فحَدَّثَتنا هذا الحَديثَ»."],"grade":"صحيح","narrator":"رجل من أصحاب النبي","muhaddith":"صحيح لغيره","bab":"رقائق وزهد › الصبر على البلاء","dorar":"dHO5Xk5N","merged":3,"otherRefs":["المطالب العالية 1/318 (حسن)","تخريج المسند لشعيب 20782 (صحيح)"]},{"id":"س-04186","fp":"5ee542631ccc","stateId":682,"easy":"إذا أنفقت على بنتين أو أختين أو قريبتين محتسباً حتى تغنيهما ← كانتا لك ستراً من النار","cause":"من أنفق على بنتَينِ أو أختَينِ أو ذواتي قَرابةٍ ، يحتسب النفقةَ عليهما حتى يُغنِيَهما من فضلِ اللهِ ، أو يكفِيهما","result":"كانتا له سِترًا من النَّارِ","explicit":true,"ref":"صحيح الترغيب 2547","srcLabel":"أحمد","text":[["من أنفق على بنتَينِ أو أختَينِ أو ذواتي قَرابةٍ ، يحتسب النفقةَ عليهما حتى يُغنِيَهما من فضلِ اللهِ ، أو يكفِيهما ؛ ",1],["كانتا له سِترًا من النَّارِ",2]],"grade":"حسن","narrator":"أم سلمة أم المؤمنين","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (26516)، وابن أبي الدنيا في ((النفقة على العيال)) (114)، والطبراني (23/392) (938)","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"AW192uhT"},{"id":"س-03805","fp":"43e60ee3a263","stateId":682,"easy":"إذا مات لك ثلاثة من الولد فصبرت ← احتظرت من النار بحظار شديد","cause":"قد مات لي ابنان منذُ دخلتُ في الإسلامِ سوَى هذا","result":"قد احتَظرتِ من النَّارِ بحِظارٍ شديدٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[9],"ref":"الترغيب والترهيب 3/121","srcLabel":"الطبراني","text":["جاءت امرأةٌ من الأنصارِ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم في ابنٍ لها مات فكأنَّ القومَ عنَّفوها فقالت يا رسولَ اللهِ ! ",["قد مات لي ابنان منذُ دخلتُ في الإسلامِ سوَى هذا",1]," فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم واللهِ ",["قد احتَظرتِ من النَّارِ بحِظارٍ شديدٍ",2]],"grade":"صحيح","narrator":"زهير بن علقمة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (5/ 273) (5307)، وابن أبي خيثمة في ((تاريخه-السفر الثاني)) (1/ 239)، وأبو نعيم في ((معرفة الصحابة)) (3071) واللفظ لهم.","bab":"بر وصلة › حب الولد","dorar":"jiLV2Nxh","merged":5,"otherRefs":["صحيح مسلم 2636 (صحيح)","صحيح النسائي 1876 (صحيح)","صحيح الأدب المفرد 107 (صحيح)"]},{"id":"س-04289","fp":"d8a26a5bd026","stateId":682,"easy":"إذا قبّلت ما بين عيني أمك ← كان لك ستراً من النار (على رواية)","cause":"مَن قَبَّلَ بَينَ عَيني أُمِّهِ","result":"كانَ لهُ سِترًا مِنَ النَّارِ","explicit":true,"ref":"شعب الإيمان 6/2672","srcLabel":"البيهقي","text":[["مَن قَبَّلَ بَينَ عَيني أُمِّهِ ",1],["كانَ لهُ سِترًا مِنَ النَّارِ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده غير قوي","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (2/393)، والبيهقي في ((شعب الإيمان)) (7861)، والديلمي في ((الفردوس)) (5650)","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"DdKHsqcT"},{"id":"س-08386","fp":"a808a5ea0e70","stateId":683,"easy":"إذا أحببت أن تُزحزح عن النار ← فلتأتك منيتك وأنت مؤمن وأتِ إلى الناس ما تحب أن يؤتى إليك","cause":"فلتَأتِه مَنيَّتُه وهو يُؤمِنُ باللَّهِ واليَومِ الآخِرِ، وليَأتِ إلى النَّاسِ الذي يُحِبُّ أن يُؤتى إليه، ومَن بايَعَ إمامًا فأعطاه صَفقةَ يَدِه، وثَمَرةَ قَلبِه؛ فليُطِعْه إنِ استَطاعَ، فإن جاءَ","result":"فمَن أحَبَّ أن يُزَحزَحَ عَنِ النَّارِ ويُدخَلَ الجَنَّةَ","explicit":true,"otherNeedIds":[67],"ref":"صحيح مسلم 1844","srcLabel":"النسائي","text":["دَخَلتُ المَسجِدَ فإذا عبدُ اللهِ بنُ عَمرِو بنِ العاصِ جالِسٌ في ظِلِّ الكَعبةِ، والنَّاسُ مُجتَمِعونَ عليه، فأتَيتُهم فجَلَستُ إليه، فقال: كُنَّا مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في سَفَرٍ، فنَزَلنا مَنزِلًا؛ فمِنَّا مَن يُصلِحُ خِباءَه، ومِنَّا مَن يَنتَضِلُ، ومِنَّا مَن هو في جَشَرِه، إذ نادى مُنادي رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم: الصَّلاةَ جامِعةً، فاجتَمَعنا إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: إنَّه لَم يَكُنْ نَبيٌّ قَبلي إلَّا كان حَقًّا عليه أن يَدُلَّ أُمَّتَه على خَيرِ ما يَعلَمُه لهم، ويُنذِرَهُم شَرَّ ما يَعلَمُه لهم، وإنَّ أُمَّتَكُم هذه جُعِلَ عافيَتُها في أوَّلِها، وسَيُصيبُ آخِرَها بَلاءٌ، وأُمورٌ تُنكِرونَها، وتَجيءُ فِتنةٌ فيُرَقِّقُ بَعضُها بَعضًا، وتَجيءُ الفِتنةُ فيَقولُ المُؤمِنُ: هذه مُهلِكَتي، ثُمَّ تَنكَشِفُ وتَجيءُ الفِتنةُ، فيَقولُ المُؤمِنُ: هذه هذه، ",["فمَن أحَبَّ أن يُزَحزَحَ عَنِ النَّارِ ويُدخَلَ الجَنَّةَ، ",2],["فلتَأتِه مَنيَّتُه وهو يُؤمِنُ باللَّهِ واليَومِ الآخِرِ، وليَأتِ إلى النَّاسِ الذي يُحِبُّ أن يُؤتى إليه، ومَن بايَعَ إمامًا فأعطاه صَفقةَ يَدِه، وثَمَرةَ قَلبِه؛ فليُطِعْه إنِ استَطاعَ، فإن جاءَ",1]," آخَرُ يُنازِعُه فاضرِبوا عُنُقَ الآخَرِ. فدَنَوتُ منه، فقُلتُ له: أنشُدُكَ اللَّهَ، آنتَ سَمِعتَ هذا مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم؟ فأهوى إلى أُذُنَيه وقَلبِه بيَدَيه، وقال: سَمِعَتْه أُذُنايَ، ووعاه قَلبي، فقُلتُ له: هذا ابنُ عَمِّكَ مُعاويةُ، يَأمُرُنا أن نَأكُلَ أموالَنا بينَنا بالباطِلِ، ونَقتُلَ أنفُسَنا، واللهُ يقولُ: {يا أيُّها الذينَ آمَنوا لا تَأكُلوا أموالَكُم بَينَكُم بالباطِلِ إلَّا أن تَكونَ تِجارةً عَن تَراضٍ مِنكُم ولا تَقتُلوا أنفُسَكُم إنَّ اللَّهَ كان بكُم رَحيمًا} [النساء: 29]، قال: فسَكَتَ ساعةً، ثُمَّ قال: أطِعْه في طاعةِ اللهِ، واعصِه في مَعصيةِ اللَّهِ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[صحيح]","takhrij":"أخرجه النسائي (4191)، وابن ماجه (3956)، وأحمد (6793) واللفظ لهم.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"auCNJiUK","merged":2,"otherRefs":["تخريج صحيح ابن حبان 5961 (صحيح)"]},{"id":"س-03464","fp":"a2e83ed07ee1","stateId":683,"easy":"إذا كففت غضبك ← يكف الله عنك عذابه","cause":"مَن كَفَّ غَضَبَه","result":"كَفَّ اللهُ عنه عَذابَه","explicit":true,"star":true,"ref":"الأحاديث المختارة 2751","srcLabel":"متفق عليه","text":["«",["مَن كَفَّ غَضَبَه",1]," ",["كَفَّ اللهُ عنه عَذابَه",2],"، ومَن خَزَنَ لِسانَه سَتَرَ اللهُ عَزَّ وجَلَّ عَوْرتَه، ومَن اعْتَذَرَ إلى اللهِ عَزَّ وجَلَّ عَذَرَه»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"استغفار › فضل الاستغفار","dorar":"sfCSIGM2"},{"id":"س-01750","fp":"956ee4307210","stateId":683,"easy":"إذا حسّن الله خلقك وخُلقك ← فلا تطعمك النار","cause":"ما حسَّنَ اللهُ عزَّ وجلَّ خلقَ رجلٍ وخلُقهُ","result":"فتَطعمهُ النارُ","explicit":true,"star":true,"similar":["س-02817"],"ref":"تسديد القوس 5/86","srcLabel":"مسلم","text":["واللهِ ",["ما حسَّنَ اللهُ عزَّ وجلَّ خلقَ رجلٍ وخلُقهُ",1]," ، ",["فتَطعمهُ النارُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أصله في مسلم","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6780)، وابن عدي في ((الكامل في الضعفاء)) (3/81)، وابن شاهين في ((الترغيب في فضائل الأعمال)) (359) باختلاف يسير","bab":"أيمان › الحلف بالله وصفاته وكلماته","dorar":"l1Fj50Z8","merged":2,"otherRefs":["اللآلئ المصنوعة 1/119 (حسن)"]},{"id":"س-00285","fp":"fd4852515c6f","stateId":683,"easy":"إذا كنت هيناً ليناً سهلاً قريباً من الناس ← تُحرّم على النار","cause":"كلُّ هيِّنٍ ، لَيِّنٍ ، سهلٍ ، قريبٍ منَ النَّاسِ","result":"حُرِّمَ على النَّارِ","explicit":true,"similar":["س-00284"],"otherNeedIds":[41],"ref":"صحيح الجامع 3135","srcLabel":"صحيح الجامع","text":[["حُرِّمَ على النَّارِ",2]," ",["كلُّ هيِّنٍ ، لَيِّنٍ ، سهلٍ ، قريبٍ منَ النَّاسِ",1]],"grade":"صحيح","narrator":"أبو هريرة وابن مسعود","muhaddith":"صحيح","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"lvp3VG63","merged":3,"otherRefs":["صحيح الترغيب 1747 (صحيح)","الأمالي الحلبية 1/35 (حسن)"]},{"id":"س-00284","fp":"01843761dc5d","stateId":683,"easy":"إذا كنت هيناً ليناً قريباً من الناس ← يحرمك الله على النار","cause":"مَنْ كان هَيِّنًا لَيِّنًا قَرِيبًا","result":"حَرَّمَهُ اللهُ على النارِ","explicit":true,"repOf":"س-00285","ref":"صحيح الترغيب 1745","text":[["مَنْ كان هَيِّنًا لَيِّنًا قَرِيبًا ؛ ",1],["حَرَّمَهُ اللهُ على النارِ ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه هناد في ((الزهد)) (2/596) باختلاف يسير، والحاكم (435)، والبيهقي في ((شعب الإيمان)) (8123) واللفظ لهما.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"aYbuvB4B","merged":2,"otherRefs":["صحيح الجامع 6484 (صحيح)"]},{"id":"س-01898","fp":"e65bb451233b","stateId":683,"easy":"إذا ذببت عن عرض أخيك في غيبته ← كان حقاً على الله أن يعتقك من النار","cause":"مَن ذَبَّ عَن عِرْضِ أخِيهِ بِالغِيبةِ","result":"كان حقًّا على اللهِ أنْ يُعْتِقَه من النارِ","explicit":true,"similar":["س-01899","س-01916","س-04263","س-00274"],"ref":"صحيح الجامع 6240","srcLabel":"أحمد","text":[["مَن ذَبَّ عَن عِرْضِ أخِيهِ بِالغِيبةِ ، ",1],["كان حقًّا على اللهِ أنْ يُعْتِقَه من النارِ",2]],"grade":"صحيح","narrator":"أسماء بنت يزيد أم سلمة الأنصارية","muhaddith":"صحيح","takhrij":"أخرجه أحمد (27609)، والطيالسي في ((المسند)) (1737) باختلاف يسير، والطبراني (24/176) (443) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Wr5Zyeut"},{"id":"س-01899","fp":"18d541886b4b","stateId":683,"easy":"إذا رددت عن عرض أخيك ← كان لك حجاباً من النار","cause":"مَن رَدَّ عِن عِرضِ أخِيهِ","result":"كان له حِجابًا من النارِ","explicit":true,"repOf":"س-01898","ref":"صحيح الجامع 6263","text":[["مَن رَدَّ عِن عِرضِ أخِيهِ ، ",1],["كان له حِجابًا من النارِ",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1931)، وأحمد (27543) بنحوه، والبيهقي (17129) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"vjMIi1Mx"},{"id":"س-01916","fp":"c9d135c9c42a","stateId":683,"easy":"إذا ذببت عن عرض أخيك ← يرد الله عنك عذاب النار يوم القيامة","cause":"من ذبَّ عن عِرضِ أخيه","result":"ردَّ اللهُ عنه عذابَ النَّارِ يومَ القيامةِ ، وتلا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : وَكَانَ حَقًّا عَلَيْنَا نَصْرُ الْمُؤْمِنِينَ","explicit":true,"repOf":"س-01898","ref":"الترغيب والترهيب 4/16","text":[["من ذبَّ عن عِرضِ أخيه ",1],["ردَّ اللهُ عنه عذابَ النَّارِ يومَ القيامةِ ، وتلا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم :  وَكَانَ حَقًّا عَلَيْنَا نَصْرُ الْمُؤْمِنِينَ",2]],"grade":"صحيح","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Gx9aACc7"},{"id":"س-04263","fp":"f02c362b348e","stateId":683,"easy":"إذا رددت عن عرض أخيك ← يرد الله عن وجهك النار يوم القيامة","cause":"مَن رَدَّ عن عِرْضِ أَخِيه","result":"رَدَّ اللهُ عن وَجْهِه النَّارَ يومَ القيامةِ","explicit":true,"repOf":"س-01898","ref":"صحيح الترغيب 2848","text":[["مَن رَدَّ عن عِرْضِ أَخِيه ؛ ",1],["رَدَّ اللهُ عن وَجْهِه النَّارَ يومَ القيامةِ ",2],"."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (1931)، وأحمد (27543)","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"GZunh9sB"},{"id":"س-05472","fp":"09fe7a25e70e","stateId":683,"easy":"إذا سامحت الناس في البيع ← يسامحك الله","cause":"كُنتُ أُسامِحُ النَّاسَ في البَيعِ","result":"أسمِحوا لعَبدي كَإسماحِه إلى عَبيدي","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[11,67,2],"ref":"مسند أبي بكر الصديق 700","srcLabel":"مسند أبي بكر الصديق","text":["أصبَحَ رَسولُ اللَّهِ صلَّى اللهُ عليه وسلَّم ذاتَ يَومٍ، فصَلَّى الغَداةَ، ثُمَّ جَلَسَ، حَتَّى إذا كانَ مِنَ الصُّبحِ ضَحِكَ رَسولُ اللَّهِ صلَّى اللهُ عليه وسلَّم، ثُمَّ جَلَسَ مَكانَه، حَتَّى صَلَّى الأولى والعَصرَ والمَغرِبَ، كُلَّ ذلك لا يَتَكَلَّمُ، حَتَّى صَلَّى العِشاءَ الآخِرةَ، ثُمَّ قامَ إلى أهلِه، فقال النَّاسُ لأبي بَكرٍ: ألا تَسألُ رَسولَ اللَّهِ صلَّى اللهُ عليه وسلَّم: ما شَأنُه؟ صَنَعَ اليَومَ شَيئًا لَم يَصنَعْه قَطُّ! فسَألَه، فقال: نَعَم، عُرِضَ عليَّ ما هو كائِنٌ مِن أمرِ الدُّنيا وأمرِ الآخِرةِ، يُجمَعُ الأوَّلونَ والآخِرونَ بصَعيدٍ واحِدٍ، فقَطَعَ النَّاسُ بذلك، حَتَّى انطَلَقوا إلى آدَمَ -والعَرَقُ يَكادُ يُلجِمُهم- فقالوا: يا آدَمُ، أنتَ أبو البَشَرِ، وأنتَ اصطَفاكَ اللَّهُ، اشفَعْ لَنا إلى رَبِّكَ. فقال: لَقد لَقيتُ مِثلَ الذي لَقيتُم، فانطَلِقوا إلى أبيكُم بَعدَ أبيكُم: إلى نوحٍ {إنَّ اللَّهَ اصطَفى آدَمَ ونوحًا وآلَ إبراهيمَ وآلَ عِمرانَ على العالَمينَ} [آل عمران: 33]. قال: فيَنطَلِقونَ إلى نوحٍ عليه السَّلامُ فيَقولونَ: اشفَعْ لَنا إلى رَبِّكَ، فأنتَ اصطَفاكَ اللَّهُ، واستَجابَ لَكَ في دُعائِكَ، ولَم يَدَعْ على الأرضِ مِنَ الكافِرينَ دَيَّارًا. فيَقولُ: ليس ذلك عِندي، انطَلِقوا إلى إبراهيمَ؛ فإنَّ اللَّهَ اتَّخَذَه خَليلًا. فيَنطَلِقونَ إلى إبراهيمَ فيَقولُ: ليس ذلكم عِندي، انطَلِقوا إلى موسى؛ فإنَّ اللَّهَ كَلَّمَه تَكليمًا. فيَقولُ موسى: ليس ذلكم عِندي، انطَلِقوا إلى عيسى ابنِ مَريَمَ؛ فإنَّه يُبرِئُ الأكمَهَ والأبرَصَ ويُحيي المَوتى. فيَقولُ عيسى: ليس ذلكم عِندي، ولَكِنِ انطَلِقوا إلى سَيِّدِ ولَدِ آدَمَ؛ فإنَّه أوَّلُ مَن تَنشَقُّ (عنه الأرضُ) يَومَ القيامةِ، انطَلِقوا إلى مُحَمَّدٍ فيَشفَعَ لَكُم إلى رَبِّكُم. قال: فيَنطَلِقُ (فيُنادي جِبريل، قال): فيَأتي جِبريلُ رَبَّه عَزَّ وجَلَّ، قال: فيَنطَلِقُ فيَأتي جِبريلُ رَبَّه تَعالى، فيَقولُ اللَّهُ تَعالى: (ائذَنْ لَه، وبَشِّرْهُ بالجَنَّةِ). قال: فيَنطَلِقُ به جِبريلُ فيَخِرُّ ساجِدًا قَدرَ جُمُعةٍ، ويَقولُ اللَّهُ عَزَّ وجَلَّ: (ارفَعْ رَأسَكَ [يا مُحَمَّدُ] وقُلْ يُسمَعْ، واشفَعْ تُشَفَّعْ). قال: فيَرفَعُ رَأسَه، فإذا نَظَرَ إلى رَبِّه عَزَّ وجَلَّ خَرَّ ساجِدًا قَدرَ جُمُعةٍ أُخرى، فيَقولُ اللَّهُ عَزَّ وجَلَّ: (ارفَعْ رَأسَكَ، وقُلْ يُسمَعْ، واشفَعْ تُشَفَّعْ). قال: فيَذهَبُ ليَقَعَ ساجِدًا، فيَأخُذُ جِبريلُ بضَبعَيه فيَفتَحُ عليه مِنَ الدُّعاءِ شَيئًا لَم يَفتَحْه على بَشَرٍ، فيَقولُ: أي رَبِّ، خَلَقتَني سَيِّدَ ولَدِ آدَمَ ولا فخرَ، وأوَّلَ مَن تَنشَقُّ عنه الأرضُ يَومَ القيامةِ ولا فَخرَ، حَتَّى إنَّه لَيَرِدُ عليَّ الحَوضَ أكثَرُ مِمَّا بَينَ صَنعاءَ وأَيلةَ. ثُمَّ يُقالُ: ادعوا الصِّدِّيقينَ. فيَشفَعونَ، ثُمَّ يُقالُ: ادعوا الأنبياءَ. قال: فيَجيءُ النَّبيُّ مَعَه العِصابةُ، والنَّبيُّ مَعَه الخَمسةُ والسِّتَّةُ، والنَّبيُّ ليس مَعَه أحَدٌ، ثُمَّ يُقالُ: ادعوا الشُّهَداءَ. فيَشفَعونَ لمَن أرادوا، قال: فإذا فعَلَتِ الشُّهَداءُ ذلك، قال: يَقولُ اللَّهُ عَزَّ وجَلَّ: (أنا أرحَمُ الرَّاحِمينَ، أدخِلوا جَنَّتي مَن كانَ لا يُشرِكُ بي شَيئًا). قال: فيَدخُلونَ الجَنَّةَ، قال: ثُمَّ يَقولُ اللَّهُ عَزَّ وجَلَّ: (انظُروا في النَّارِ، هَل تَلقَونَ مِن أحَدٍ عَمِلَ خَيرًا قَطُّ؟). قال: فيَجِدونَ في النَّارِ رَجُلًا، فيَقولُ لَه: هَل عَمِلتَ خَيرًا قَطُّ؟ فيَقولُ: لا، غَيرَ أنِّي ",["كُنتُ أُسامِحُ النَّاسَ في البَيعِ",1],". فيَقولُ اللَّه: (",["أسمِحوا لعَبدي كَإسماحِه إلى عَبيدي",2],"). ثُمَّ يُخرِجونَ مِنَ النَّارِ رَجُلًا، فيَقولُ لَه: هَل عَمِلتَ خَيرًا قَطُّ؟ فيَقولُ: لا، غَيرَ أنِّي قد أمَرتُ ولَدي: إذا مُتُّ فأحرِقوني بالنَّارِ، ثُمَّ اطحَنوني، حَتَّى إذا كُنتُ مِثلَ الكُحلِ فاذهَبوا بي إلى البَحرِ، فاذْرُوني في الرِّيحِ، فواللَّهِ لا يَقدِرُ عليَّ رَبُّ العالَمينَ أبَدًا. فقال اللَّهُ تَعالى: (لمَ فعَلتَ ذلك؟) قال: مِن مَخافَتِكَ. قال: فيَقولُ اللَّهُ عَزَّ وجَلَّ: (انظُرْ إلى مُلكِ أعظَمِ مَلِكٍ؛ فإنَّ لَكَ مِثلَه وعَشَرةَ أمثالِه)، قال: فيَقولُ: لمَ تَسخَرُ بي وأنتَ المَلِكُ؟ قال: (يَعني: رَسولَ اللَّهِ صلَّى اللهُ عليه وسلَّم): (وذلك الذي ضَحِكتُ منه مِنَ الضُّحى)"],"grade":"صحيح","narrator":"حذيفة","muhaddith":"[صحيح]","bab":"رقائق وزهد › الخوف من الله","dorar":"On8AXZvT","merged":11,"otherRefs":["تخريج مشكل الآثار 5532 (صحيح)","صحيح الترمذي 1307 (صحيح)","أطراف الغرائب 1/362 (صحيح)","صحيح الترغيب 1751 (صحيح)","صحيح الجامع 2078 (صحيح)","تخريج المسند لشعيب 23353 (صحيح)","تخريج المسند لشعيب 17064 (صحيح)","الاستذكار 5/556 (صحيح)","صحيح البخاري 2077 (صحيح)","صحيح مسلم 1560 (صحيح)"]},{"id":"س-00274","fp":"4cf30b585aa1","stateId":683,"easy":"إذا رددت عن عرض أخيك المسلم ← كان حقاً على الله أن يرد عنك النار يوم القيامة","cause":"مَن ردَّ عن عِرضِ أخيهِ المُسلِمِ","result":"كان حقًّا على اللهِ عزَّ وجلَّ أنْ يَرُدَّ عنه نارَ جَهنَّمَ يومَ القيامةِ","explicit":true,"repOf":"س-01898","ref":"تخريج سنن أبي داود 7/246","text":["\"",["مَن ردَّ عن عِرضِ أخيهِ المُسلِمِ، ",1],["كان حقًّا على اللهِ عزَّ وجلَّ أنْ يَرُدَّ عنه نارَ جَهنَّمَ يومَ القيامةِ",2],"."],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (27536) واللفظ له، وأخرجه الترمذي (1931) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"laBb3VHv"},{"id":"س-02800","fp":"71e5e104842a","stateId":683,"easy":"إذا حميت مؤمناً من منافق يعيبه ← يبعث الله ملكاً يحمي لحمك من نار جهنم","cause":"مَن حَمى مُؤمنًا من مُنافقٍ يَعيبُه","result":"بعَثَ اللهُ مَلَكًا يَحمي لَحمَه يومَ القيامةِ مِن نارِ جَهنَّمَ","explicit":true,"ref":"تخريج شرح السنة 3527","srcLabel":"أبو داود","text":[["مَن حَمى مُؤمنًا من مُنافقٍ يَعيبُه، ",1],["بعَثَ اللهُ مَلَكًا يَحمي لَحمَه يومَ القيامةِ مِن نارِ جَهنَّمَ، ",2],"ومَن قَفَى مُسلمًا بشيءٍ يُريدُ شَينَه به، حبَسَه اللهُ على جِسرِ جَهنَّمَ حتى يَخرُجَ ممَّا قال."],"grade":"حسن","narrator":"معاذ بن أنس","muhaddith":"إسماعيل بن يحيى المعافري لم يوثقه غير ابن حبان، وباقي رجاله ثقات.","takhrij":"أخرجه الطبراني (433) (20/ 194) واللفظ له، وأبو داود (4883)، وأحمد (15649) باختلاف يسير.","bab":"إيمان › النفاق","dorar":"iku4DJoR"},{"id":"س-02817","fp":"f100852d6b04","stateId":683,"easy":"إذا حسّن الله خلقك وخُلقك ← لا يطعم لحمك النار","cause":"ما حسَّنَ اللهُ خَلْقَ أحدٍ وخُلُقَه","result":"فأطعمَ لحمَه النارَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-01750","ref":"تنزيه الشريعة 1/201","text":[["ما حسَّنَ اللهُ خَلْقَ أحدٍ وخُلُقَه",1]," ",["فأطعمَ لحمَه النارَ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"له طريقان آخران [أحدهما] رجاله ثقات","takhrij":"أخرجه الخطيب في ((تاريخ بغداد)) (3/226)، وابن الجوزي في ((الموضوعات)) (1/165) باختلاف يسير.","bab":"إيمان › الوعد","dorar":"qh7fWqXf"},{"id":"س-00254","fp":"2e9e52a96deb","stateId":683,"easy":"إذا كنت هيناً ليناً قريباً سهلاً ← تحرم عليك النار","cause":"قالوا: بلى يا رسولَ اللهِ قال: على كلِّ هيِّنٍ ليِّنٍ قريبٍ سهلٍ","result":"ألَا أُخبِرُكم بمَنْ تحرُمُ عليه النَّارُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح ابن حبان 470","srcLabel":"الترمذي","text":["( ",["ألَا أُخبِرُكم بمَنْ تحرُمُ عليه النَّارُ ) ",2],"؟",[" قالوا: بلى يا رسولَ اللهِ قال: ( على كلِّ هيِّنٍ ليِّنٍ قريبٍ سهلٍ )",1]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الترمذي (2488)، وأحمد (3938) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"4dD4L7kv","merged":3,"otherRefs":["صحيح الترغيب 2676 (صحيح)","صحيح الترمذي 2488 (صحيح)"]},{"id":"س-06615","fp":"858f54133233","stateId":684,"easy":"إذا صليت قبل طلوع الشمس وقبل غروبها ← لا تلج النار","cause":"صلى قبلَ طلوعِ الشمسِ، وقبلَ أن تَغْرُبَ","result":"لا يَلِجُ النارَ رجلٌ","explicit":true,"star":true,"similar":["س-06538"],"ref":"صحيح أبي داود 427","srcLabel":"مسلم","text":["سأله رجلٌ مِن أهلِ البَصْرَةِ، فقال: أَخْبِرْني ما سَمِعْتَ مِن رسولِ اللهِ صلى الله عليه وسلم. قال: سَمِعْتَ رسولَ اللهِ صلى الله عليه وسلم يقولُ: ",["لا يَلِجُ النارَ رجلٌ",2]," ",["صلى قبلَ طلوعِ الشمسِ، وقبلَ أن تَغْرُبَ",1],". قال: أنت سَمِعْتُه منه- ثلاث مرات-؟ قال: نعم، كلُّ ذلك يقولُ سَمِعَتْه أُذُنايَ، ووَعاه قلبي. فقال الرجلُ: وأنا سَمِعْتُه صلى الله عليه وسلم يقولُ ذلك."],"grade":"صحيح","narrator":"عمارة بن رويبة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (634)، وأبو داود (427) واللفظ له، والنسائي في ((السنن الكبرى)) (11523)، وأحمد (18324)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"1Ll3iL9m","merged":6,"otherRefs":["صحيح ابن خزيمة 1/ 420 (صحيح)","صحيح مسلم 634 (صحيح)","تخريج صحيح ابن حبان 1740 (صحيح)","تخريج المسند لشعيب 18298 (صحيح)","تخريج المسند لشعيب 17222 (صحيح)"]},{"id":"س-06538","fp":"768a1f9b633f","stateId":684,"easy":"إذا صليت قبل طلوع الشمس وقبل غروبها ← يحرّمك الله على النار","cause":"مَن صلَّى قبلَ طلوعِ الشَّمسِ وقبلَ غروبِها","result":"حرَّمَهُ اللَّهُ علَى النَّارِ وقالَ رجلٌ مِن أَهْلِ البصرةِ وأَنا سَمِعْتُهُ مِن رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ","explicit":true,"repOf":"س-06615","ref":"صحيح ابن خزيمة 1/ 419","text":[["مَن صلَّى قبلَ طلوعِ الشَّمسِ وقبلَ غروبِها ",1],["حرَّمَهُ اللَّهُ علَى النَّارِ وقالَ رجلٌ مِن أَهْلِ البصرةِ وأَنا سَمِعْتُهُ مِن رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ",2]],"grade":"صحيح","narrator":"عمارة بن رويبة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (634)، وأبو داود (427)، والنسائي (471)، وأحمد (17220) واللفظ لهم.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"gPWSIVM5"},{"id":"س-08432","fp":"897c827b20e8","stateId":684,"easy":"إذا حافظت على أربع قبل الظهر وأربع بعدها ← يحرّمك الله على النار","cause":"مَن حافَظَ على أربَعِ رَكَعاتٍ قبلَ الظهرِ، وأربَعٍ بعدَها","result":"حرَّمَه اللهُ على النارِ","explicit":true,"star":true,"similar":["س-03723"],"ref":"تخريج شرح السنة 889","srcLabel":"الترمذي","text":["عن عَنْبَسةَ بنِ أبي سُفْيانَ، لمَّا حضَرَتْه الوفاةُ جزِعَ، فقيل له: ما يُجزِعُكَ، ألَمْ تكُنْ على سَمْتٍ مِن الإسلامِ حسَنٍ؟! قال: وما لي لا أجزَعُ ولستُ أَدْري على ما أُقدِمُ عليه؟ مع أنَّ أَرْجى عملي عندي حديثٌ حدَّثَتْني به أمُّ حَبيبةَ، أنَّها سمِعَتِ النبيَّ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن حافَظَ على أربَعِ رَكَعاتٍ قبلَ الظهرِ، وأربَعٍ بعدَها، ",1],["حرَّمَه اللهُ على النارِ",2],".\nفواللهِ ما ترَكتُهنَّ منذُ يومِ سمِعتُهنَّ إلى يومي هذا."],"grade":"صحيح","narrator":"أم حبيبة أم المؤمنين","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرجه ابن منده في ((معرفة الصحابة)) (ص954) باختلاف يسير، وأخرجه الترمذي (428)، والنسائي (1816) دون القصة في أوله","bab":"مناقب وفضائل › فضائل جمع من الصحابة والتابعين","dorar":"OLJqCHjI","merged":5,"otherRefs":["الجامع الصغير 8603 (صحيح)","صحيح ابن خزيمة 2/ 354 (صحيح)","صحيح ابن خزيمة 2/ 355 (صحيح)","فتاوى نور على الدرب لابن باز 10/278 (صحيح)"]},{"id":"س-03723","fp":"ffb8b5414e4a","stateId":684,"easy":"إذا صليت أربعاً قبل الظهر وأربعاً بعدها ← يحرّم الله لحمك على النار","cause":"مَن صلَّى أَربَعًا قبل الظُّهرِ، وأرْبَعًا بعدَها","result":"حرَّمَ اللهُ لحمَهُ على النَّارِ","explicit":true,"repOf":"س-08432","ref":"تخريج المسند لشعيب 26764","text":["لمَّا نزَلَ بعَنْبَسةَ بنِ أبي سُفيانَ المَوتُ، اشتدَّ جَزَعُه، فقيلَ له: ما هذا الجَزَعُ؟ قال: أمَا إنِّي سمِعْتُ أمَّ حَبِيبةَ، يعني أُختَه، تقولُ: قال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ: ",["مَن صلَّى أَربَعًا قبل الظُّهرِ، وأرْبَعًا بعدَها، ",1],["حرَّمَ اللهُ لحمَهُ على النَّارِ",2],". فما تركتُهنَّ منذُ سمِعْتُهنَّ."],"grade":"صحيح","narrator":"أم حبيبة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (428)، والنسائي (1812)، وابن ماجه (1160)، وأحمد (26764) واللفظ له","bab":"اعتصام بالسنة › لزوم السنة","dorar":"1NhGmaC4","merged":3,"otherRefs":["صحيح ابن ماجه 959 (صحيح)","فتاوى نور على الدرب لابن باز 10/278 (صحيح)"]},{"id":"س-01420","fp":"b6e08586ba05","stateId":684,"easy":"إذا أنهكت أصابعك بالطهور (خللتها) ← لا تنهكها النار","cause":"لَتُنْهَكَنَّ الأَصابِعُ بِالطَّهورِ","result":"أوْ لَتَنْهِكَنَّها النارُ","explicit":true,"ref":"صحيح الترغيب 218","srcLabel":"الطبراني","text":[["لَتُنْهَكَنَّ الأَصابِعُ بِالطَّهورِ",1]," ، ",["أوْ لَتَنْهِكَنَّها النارُ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"حسن صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (2674)","bab":"وضوء › صفة الوضوء","dorar":"3KUn10vr","merged":2,"otherRefs":["الترغيب والترهيب 1/137 (صحيح)"]},{"id":"س-06570","fp":"1be46d595fae","stateId":684,"easy":"إذا حافظت على الصلوات الخمس بوضوئها ومواقيتها وركوعها وسجودها ← حُرّمت على النار","cause":"مَن حافَظ على الصلواتِ الخمسِ - أو الصلاةِ المكتوبةِ - على وضوئِها ، وعلى مواقيتِها ، وركوعِها وسجودِها ، يراه حقًّا عليه","result":"حرُم على النارِ","explicit":true,"ref":"إتحاف الخيرة المهرة 1/415","srcLabel":"أحمد","text":["عن حنظلةَ الأسيديِّ ، وكان يقالُ له : كاتبُ النبيِّ صلَّى اللهُ عليه وسلَّم قال : ",["مَن حافَظ على الصلواتِ الخمسِ - أو الصلاةِ المكتوبةِ - على وضوئِها ، وعلى مواقيتِها ، وركوعِها وسجودِها ، يراه حقًّا عليه ",1],["حرُم على النارِ",2]],"grade":"صحيح","narrator":"حنظلة الأسيدي","muhaddith":"[روي بإسناد صحيح]","takhrij":"أخرجه ابن أبي شيبة (832) بلفظه، وأحمد (18346)، والطبراني (4/ 12)، (3494) كلاهما باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"SN9U27lw","merged":2,"otherRefs":["تخريج المسند لشعيب 18346 (صحيح)"]},{"id":"س-01421","fp":"c1b5ec49c43c","stateId":684,"easy":"إذا خللت الأصابع الخمس ← لا يحشوها الله ناراً","cause":"خلِّلوا الأصابعَ الخمسَ","result":"لا يحشوَها اللهُ نارًا","explicit":true,"ref":"صحيح الترغيب 218","srcLabel":"الطبراني","text":["عن عبدِ اللهِ بنِ مسعودٍ قال : ",["خلِّلوا الأصابعَ الخمسَ",1]," ؛ ",["لا يحشوَها اللهُ نارًا",2]],"grade":"صحيح","narrator":"[طلحة بن مصرف]","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني (9/ 247) ( 9613) بلفظه، والطبري في ((تفسيره)) (8/ 189)، وأبو عبيد في ((الطهور)) (384) كلاهما باختلاف يسير.","bab":"وضوء › صفة الوضوء","dorar":"5F0bto3j"},{"id":"س-04182","fp":"c3b23d9c75c1","stateId":684,"easy":"إذا صليت أربع ركعات بعد الظهر ← لا تمس النار وجهك أبداً","cause":"ما من عبدٍ مؤمنٍ يصلِّي أربعَ رَكعاتٍ بعدَ الظُّهرِ","result":"فتمسُّ وجهَه النَّارُ أبدًا","explicit":true,"apply":{"k":"count","t":"أربع ركعات"},"ref":"صحيح النسائي 1812","srcLabel":"أبو داود","text":[["ما من عبدٍ مؤمنٍ يصلِّي أربعَ رَكعاتٍ بعدَ الظُّهرِ",1]," ",["فتمسُّ وجهَه النَّارُ أبدًا",2]," -إن شاءَ اللَّهُ عزَّ وجلَّ -"],"grade":"صحيح","narrator":"أم حبيبة أم المؤمنين","muhaddith":"صحيح [لغيره]","takhrij":"أخرجه النسائي (1813) واللفظ له، وأخرجه أبو داود (1269)، والترمذي (427) بنحوه","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"XQIcbBgQ"},{"id":"س-06522","fp":"81ee6d980553","stateId":684,"easy":"إذا جئت بالصلوات الخمس كاملات ← لك عند الله عهد ألا يعذبك","cause":"مَن جاء بالصَّلواتِ الخَمْسِ قد أكمَلهنَّ لَمْ ينقُصْ مِن حقِّهنَّ شيئًا","result":"كان له عندَ اللهِ عهدٌ ألَّا يُعذِّبَه","explicit":true,"ref":"تخريج صحيح ابن حبان 1731","srcLabel":"أبو داود","text":["أنَّه قال لِعُبادةَ بنِ الصَّامتِ : يا أبا الوليدِ إنَّ أبا مُحمَّدٍ - رجُلٌ مِن الأنصارِ كانت له صُحبةٌ - يزعُمُ أنَّ الوِتْرَ حقٌّ قال : كذَب أبو مُحمَّدٍ سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ : ( ",["مَن جاء بالصَّلواتِ الخَمْسِ قد أكمَلهنَّ لَمْ ينقُصْ مِن حقِّهنَّ شيئًا ",1],["كان له عندَ اللهِ عهدٌ ألَّا يُعذِّبَه ",2],"ومَن جاء بهنَّ وقدِ انتقَص مِن حقِّهنَّ شيئًا فليس له عندَ اللهِ عهدٌ إنْ شاء رحِمه وإنْ شاء عذَّبه )"],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (425)، والنسائي (461)، وابن ماجه (1401)، وابن حبان (1731) واللفظ لهم جميعا.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"8aiqmOxT"},{"id":"س-02760","fp":"425eff7c3b3e","stateId":684,"easy":"إذا سجدت ← تحرم النار أن تأكل أثر سجودك","cause":"أَثَرِ السُّجودِ","result":"وحرَّمَ اللهُ عزَّ وجلَّ على النَّارِ أنْ تَأكُلَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشعيب 7927","srcLabel":"متفق عليه","text":["المعنى: أنَّ النَّاسَ قالوا لرسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا رسولَ اللهِ، هل نَرى رَبَّنا عزَّ وجلَّ يَومَ القِيامَةِ؟ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: هل تُضارُّون في القَمَرِ لَيلةَ البَدْرِ؟ قالوا: لا يا رسولَ اللهِ. قال: فهل تُضارُّون في الشَّمسِ ليس دونَها سَحابٌ؟ قالوا: لا. قال: فإنَّكم تَرَوْنه كذلك، يَجمَعُ اللهُ النَّاسَ يَومَ القِيامَةِ، فيُقالُ: مَن كان يَعبُدُ شَيئًا فليَتبَعْه، فيَتبَعُ مَن يَعبُدُ الشَّمسَ الشَّمسَ، ويَتبَعُ مَن يَعبُدُ القَمرَ القَمرَ، ويَتبَعُ مَن يَعبُدُ الطَّواغيتَ الطَّواغيتَ، وتَبقى هذه الأُمَّةُ فيها شافِعوها، أو مُنافِقوها -قال أبو كامِلٍ: شَكَّ إبراهيمُ- فيَأتيهم اللهُ عزَّ وجلَّ في صورَةٍ غَيرِ صورَتِه الَّتي يَعرِفون، فيَقولُ: أنا رَبُّكم. فيَقولون: نَعوذُ باللهِ مِنك، هذا مَكانُنا حتى يَأتِيَنا رَبُّنا، فإذا جاء رَبُّنا عَرَفْناه. فيَأتيهم اللهُ عزَّ وجلَّ في صورَتِه الَّتي يَعرِفون، فيَقولُ: أنا رَبُّكم. فيَقولون: أنت رَبُّنا. فيَتبَعونه. ويُضرَبُ الصِّراطُ بيْنَ ظَهرَيْ جَهنَّمَ، فأَكونُ أنا وأُمَّتي أَوَّلَ مَن يَجوزُه، ولا يتكَلَّمُ يَومَئذٍ إلَّا الرُّسلُ، ودَعوى الرُّسلِ يَومَئذٍ: اللَّهمَّ سَلِّمْ سَلِّمْ. وفي جَهنَّمَ كَلاليبُ مِثلُ شَوكِ السَّعْدانِ، هل رأَيتُم السَّعْدانَ؟ قالوا: نعم يا رسولَ اللهِ. قال: فإنَّها مِثلُ شَوكِ السَّعْدانِ، غَيرَ أنَّه لا يَعلَمُ قَدرَ عِظَمِها إلَّا اللهُ تَعالى، تَخطَفُ النَّاسَ بأَعمالِهم، فمِنهم الموبَقُ بِعَملِه -أو قال: الموثَقُ بِعَملِه أو المُخَردَلُ-، ومنهم المُجازى -قال أبو كامِلٍ في حَديثِهِ: شَكَّ إبراهيمُ- ومنهم المُخَردَلُ أو المُجازى ثم يتجَلَّى، حتى إذا فرَغَ اللهُ عزَّ وجلَّ مِن القَضاءِ بيْنَ العِبادِ، وأرادَ أنْ يُخرِجَ برَحمَتِه مَن أرادَ مِن أَهلِ النَّارِ أمَرَ الملائكةَ أنْ يُخرِجوا مِن النَّارِ مَن كان لا يُشرِكُ باللهِ شيئًا، ممَّن أرادَ اللهُ أنْ يَرحَمَه، ممَّن يَقولُ: لا إلهَ إلَّا اللهُ، فيَعرِفونَهم في النَّارِ، يَعرِفونَهم ب",["أَثَرِ السُّجودِ",1],"، تَأكُلُ النَّارُ ابنَ آدَمَ إلَّا أَثَرَ السُّجودِ، ",["وحرَّمَ اللهُ عزَّ وجلَّ على النَّارِ أنْ تَأكُلَ",2]," أَثَرَ السُّجودِ، فيَخرُجون مِن النَّارِ قد امتُحِشوا فيُصَبُّ عليهم ماءُ الحياةِ، فيَنبُتون كما تَنبُتُ الحبَّةُ -وقال أبو كامِلٍ: الحبَّةُ، أَيضًا- في حَميلِ السَّيلِ. ويَبقى رَجُلٌ مُقبِلٌ بوَجهِه على النَّارِ، وهو آخِرُ أَهلِ الجنَّةِ دُخولًا، فيَقولُ: أَيْ رَبِّ، اصرِفْ وَجهي عن النَّارِ؛ فإنَّه قد قشَبَني رِيحُها، وأحرَقَني دُخَانُها، فيَدعو اللهَ ما شاءَ أنْ يَدعُوَه، ثم يَقولُ اللهُ عزَّ وجلَّ: هل عسَيْتَ إنْ فُعِلَ ذلك بك أنْ تَسأَلَ غَيرَه؟ فيَقولُ: لا وعِزَّتِك لا أَسأَلُ غَيرَه. ويُعطي رَبَّه عزَّ وجلَّ مِن عُهودٍ ومَواثيقَ ما شاءَ، فيَصرِفُ اللهُ عزَّ وجلَّ وَجهَه عن النَّارِ، فإذا أقبَلَ على الجنَّةِ ورآها؛ سكَتَ ما شاء اللهُ أنْ يَسكُتَ، ثم يَقولُ: أَي رَبِّ، قَرِّبْني إلى بابِ الجنَّةِ، فيَقولُ اللهُ عزَّ وجلَّ له: أَلستَ قد أعطَيْتَ عُهودَك ومَواثيقَك أَلَّا تَسأَلَني غَيرَ ما أعطَيتُكَ؟ وَيْلَكَ يا ابنَ آدَمَ، ما أَغدَرَكَ! فيَقولُ: أَيْ رَبِّ، فيَدعو اللهَ، حتى يَقولَ له: فهل عسَيْتَ إنْ أُعطيتَ ذلك أنْ تَسأَلَ غَيرَه؟ فيَقولُ: لا وَعِزَّتِكَ لا أَسأَلُ غَيرَه. فيُعطي رَبَّه عزَّ وجلَّ ما شاء مِن عُهودٍ ومَواثيقَ، فيُقَدِّمُه إلى بابِ الجنَّةِ، فإذا قام على باب الجنَّةِ انفهَقَتْ له الجنَّةُ، فرأى ما فيها مِن الحِبَرَةِ والسُّرورِ، فيَسكُتُ ما شاء اللهُ أنْ يَسكُتَ، ثم يَقولُ: أَي رَبِّ، أَدخِلْني الجنَّةَ. فيَقولُ اللهُ عزَّ وجلَّ له: أليس قد أعطَيْتَ عُهودَك ومَواثيقَك أَلَّا تَسأَلَني غَيرَ ما أعطَيتُكَ؟ وَيْلَك يا ابنَ آدَمَ، ما أَغدَرَك! فيَقولُ: أَيْ رَبِّ، لا أَكونُ أَشقى خَلقِكَ، فلا يَزالُ يَدعو اللهَ، حتى يَضحَكَ اللهُ منه، فإذا ضحِكَ اللهُ عزَّ وجلَّ منه قال: ادخُلِ الجنَّةَ. فإذا دخَلَها قال اللهُ عزَّ وجلَّ له: تَمَنَّه. فيَسأَلُ رَبَّه عزَّ وجلَّ ويتمَنَّى، حتى إنَّ اللهَ عزَّ وجلَّ ليُذَكِّرُه، يَقولُ: مِن كذا وكذا، حتى إذا انقطَعَتْ به الأَمانِيُّ؛ قال اللهُ عزَّ وجلَّ له: لك ذلك ومِثلُه معه. قال عطاءُ بنُ يَزيدَ: وأبو سَعيدٍ الخُدرِيُّ مع أبي هُريرةَ، لا يَرُدُّ عليه مِن حَديثِه شَيئًا، حتى إذا حدَّثَ أبو هُريرةَ أنَّ اللهَ عزَّ وجلَّ قال لذلك الرَّجُلِ: ومِثلُه معه. قال أبو سعيدٍ: وعَشَرةُ أَمثالِه معه يا أبا هُريرةَ. قال أبو هُريرةَ: ما حفِظْتُ إلَّا قَولَه: ذلك لك ومِثلُه معه. قال أبو سعيدٍ: أَشهَدُ أنِّي حفِظْتُ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ قَولَه في ذلك الرَّجُلِ: لك عَشَرةُ أَمثالِه. قال أبو هُريرةَ: وذلك الرَّجُلُ آخِرُ أَهلِ الجنَّةِ دُخولًا."],"grade":"صحيح","narrator":"أبو هريرة وأبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (7437)، ومسلم (182) باختلاف يسير","bab":"إيمان › الملائكة","dorar":"xsDQipBf","merged":7,"otherRefs":["تخريج صحيح ابن حبان 7429 (صحيح)","فوائد الحنائي الحنائيات 2/865 (صحيح)","عون المعبود 4/89 (صحيح)","تسديد القوس 5/60 (صحيح)","مجموع الفتاوى 6/340 (صحيح)","صحيح النسائي 1139 (صحيح)"]},{"id":"س-01411","fp":"a4cbe032965a","stateId":684,"easy":"إذا خللت أصابعك في الوضوء ← لا تتخللها النار يوم القيامة","cause":"خلِّلوا أصابعَكم","result":"لا تتخلَّلُها النَّارُ يومَ القيامةِ","explicit":true,"ref":"مختصر المقاصد 415","srcLabel":"الدارقطني","text":[["خلِّلوا أصابعَكم",1]," ",["لا تتخلَّلُها النَّارُ يومَ القيامةِ",2]],"grade":"حسن","narrator":"[أبو هريرة]","muhaddith":"حسن لغيره","takhrij":"أخرجه الدارقطني (1/95)، والديلمي في ((الفردوس)) (2844) باختلاف يسير.","bab":"وضوء › صفة الوضوء","dorar":"oKN1PsT6"},{"id":"س-02637","fp":"54a5587ed7e9","stateId":684,"easy":"إذا أحسنت الوضوء وعدت أخاك المسلم محتسباً ← تُباعد من جهنم سبعين خريفاً","cause":"من توضأ فأحسن الوضوءَ وعاد أخاه المسلمَ محتسبًا","result":"بُوعِدَ من جهنمَ سبعين خريفًا","explicit":true,"ref":"المتجر الرابح 265","srcLabel":"أبو داود","text":[["من توضأ فأحسن الوضوءَ وعاد أخاه المسلمَ محتسبًا ",1],["بُوعِدَ من جهنمَ سبعين خريفًا",2],". قلتُ: يا أبا حمزةَ ما الخريفُ؟ قال: العامُ."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن","takhrij":"أخرجه أبو داود (3097) واللفظ له، والطبراني في ((المعجم الأوسط)) (9441)","bab":"إيمان › الاحتساب والنية","dorar":"swao2TmW"},{"id":"س-06632","fp":"18c6280b82e1","stateId":684,"easy":"إذا صليت الخمس فأتممت ركوعها وسجودها ← لك عند الله عهد ألا يعذبك","cause":"مَن صلَّى الصَّلَواتِ الخَمْسِ، فأَتَمَّ رُكوعَها وسُجودَها","result":"كانَ له عنْدَ اللهِ عَهْدًا أَلَّا يُعَذِّبَه","explicit":true,"ref":"علل ابن أبي حاتم 239","srcLabel":"ابن ماجه","text":["حَديثٌ رَواه أبو غَسَّانَ مُحمَّدُ بنُ مُطَرِّفٍ، عن زَيدِ بنِ أَسلَمَ، عن عَطاءِ بنِ يَسارٍ، عن عُبادةَ، عن النَّبيِّ صلَّى اللهُ عليه وسَلَّمَ: ",["مَن صلَّى الصَّلَواتِ الخَمْسِ، فأَتَمَّ رُكوعَها وسُجودَها ",1],["كانَ له عنْدَ اللهِ عَهْدًا أَلَّا يُعَذِّبَه",2],"؟"],"grade":"حسن","narrator":"عبادة","muhaddith":"سَمِعْتُ هذا الحَديثَ عن عُبادةَ مُنْذُ حينِ، وكُنْتُ أُنكِرُه، ولم أَفهَمْ عَوْرتَه حتَّى رَأيْتُه الآنَ: حَدَّثَنا أبو صالِحٍ، عن اللَّيْثِ، عن هِشامِ بنِ سَعْدٍ، عن زَيدِ بنِ أَسلَمَ، عن مُحمَّدِ بنِ يَحْيى بنِ حَبَّانَ، عن ابنِ مُحَيْريزٍ، عن عُبادةَ، سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسَلَّمَ يَقولُ... فعَلِمْتُ أنَّ الصَّحيحَ هذا، وأنَّ مُحمَّدَ بنَ مُطَرِّفٍ لم يَضبِطْ هذا الحَديثَ، وكانَ مُحمَّدُ بنُ مُطَرِّفٍ ثِقةً.","takhrij":"أخرجه أبو داوود (1420)، وابن ماجه (1401)، وأحمد (22693) ثلاثتهم بنحوه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"N1mY8DDY"},{"id":"س-07888","fp":"e0a8c319a615","stateId":684,"easy":"إذا صمت وصليت وحججت ← تُحرّم صورتك على النار","cause":"كانوا يَصومونَ معنا ويُصَلُّونَ ويَحُجُّونَ","result":"أخرِجوا مَن عَرَفتُم، فتُحَرَّمُ صورُهم على النَّارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[65],"ref":"صحيح مسلم 183","srcLabel":"البخاري","text":["أنَّ ناسًا في زَمَنِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم قالوا: يا رَسولَ اللهِ، هل نَرى رَبَّنا يَومَ القيامةِ؟ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: نَعَم، قال: هل تُضارُّونَ في رُؤيةِ الشَّمسِ بالظَّهيرةِ صَحوًا ليس معها سَحابٌ؟ وهل تُضارُّونَ في رُؤيةِ القَمَرِ لَيلةَ البَدرِ صَحوًا ليس فيها سَحابٌ؟ قالوا: لا يا رَسولَ اللهِ، قال: ما تُضارُّونَ في رُؤيةِ اللهِ تَبارَك وتَعالى يَومَ القيامةِ إلَّا كما تُضارُّونَ في رُؤيةِ أحَدِهما، إذا كانَ يَومُ القيامةِ أذَّنَ مُؤَذِّنٌ: ليَتَّبِعْ كُلُّ أُمَّةٍ ما كانَت تَعبُدُ، فلا يَبقى أحَدٌ كانَ يَعبُدُ غيرَ اللهِ سُبحانَه مِنَ الأصنامِ والأنصابِ إلَّا يَتَساقَطونَ في النَّارِ، حتَّى إذا لَم يَبقَ إلَّا مَن كانَ يَعبُدُ اللهَ مِن بَرٍّ وفاجِرٍ وغُبَّرِ أهلِ الكِتابِ، فيُدعى اليَهودُ، فيُقالُ لهم: ما كُنتُم تَعبُدونَ؟ قالوا: كُنَّا نَعبُدُ عُزَيرَ ابنَ اللهِ، فيُقالُ: كَذَبتُم، ما اتَّخَذَ اللهُ مِن صاحِبةٍ ولا ولَدٍ، فماذا تَبغونَ؟ قالوا: عَطِشنا يا رَبَّنا، فاسقِنا، فيُشارُ إليهم، ألا تَرِدونَ؟ فيُحشَرونَ إلى النَّارِ كَأنَّها سَرابٌ يَحطِمُ بَعضُها بَعضًا، فيَتَساقَطونَ في النَّارِ، ثُمَّ يُدعى النَّصارى، فيُقالُ لهم: ما كُنتُم تَعبُدونَ؟ قالوا: كُنَّا نَعبُدُ المَسيحَ ابنَ اللهِ، فيُقالُ لهم، كَذَبتُم، ما اتَّخَذَ اللهُ مِن صاحِبةٍ ولا ولَدٍ، فيُقالُ لهم: ماذا تَبغونَ؟ فيَقولونَ: عَطِشنا يا رَبَّنا، فاسقِنا، قال: فيُشارُ إليهم، ألا تَرِدونَ؟ فيُحشَرونَ إلى جَهَنَّمَ كَأنَّها سَرابٌ يَحطِمُ بَعضُها بَعضًا، فيَتَساقَطونَ في النَّارِ، حتَّى إذا لَم يَبقَ إلَّا مَن كانَ يَعبُدُ اللهَ تَعالى مِن بَرٍّ وفاجِرٍ، أتاهم رَبُّ العالَمينَ سُبحانَه وتَعالى في أدنى صورةٍ مِنَ التي رَأوْه فيها، قال: فما تَنتَظِرونَ؟ تَتبَعُ كُلُّ أُمَّةٍ ما كانَت تَعبُدُ، قالوا: يا رَبَّنا، فارَقنا النَّاسَ في الدُّنيا أفقَرَ ما كُنَّا إليهم، ولَم نُصاحِبْهُم، فيَقولُ: أنا رَبُّكُم، فيَقولونَ: نَعوذُ باللهِ مِنك لا نُشرِكُ باللهِ شيئًا، مَرَّتَينِ أو ثَلاثًا، حتَّى إنَّ بَعضَهم لَيَكادُ أن يَنقَلِبَ، فيَقولُ: هل بينَكُم وبينَه آيةٌ فتَعرِفونَه بها؟ فيَقولونَ: نَعَم، فيُكشَفُ عن ساقٍ، فلا يَبقى مَن كانَ يَسجُدُ للَّهِ مِن تِلقاءِ نَفسِه إلَّا أذِنَ اللهُ له بالسُّجودِ، ولا يَبقى مَن كانَ يَسجُدُ اتِّقاءً ورياءً إلَّا جَعَلَ اللهُ ظَهرَه طَبَقةً واحِدةً، كُلَّما أرادَ أن يَسجُدَ خَرَّ على قَفاه، ثُمَّ يَرفَعونَ رُؤوسَهم وقد تَحَوَّلَ في صورَتِه التي رَأوْه فيها أوَّلَ مَرَّةٍ، فقال: أنا رَبُّكُم، فيَقولونَ: أنتَ رَبُّنا، ثُمَّ يُضرَبُ الجِسرُ على جَهَنَّمَ، وتَحِلُّ الشَّفاعةُ، ويقولونَ: اللهمَّ سَلِّمْ سَلِّمْ، قيلَ: يا رَسولَ اللهِ، وما الجِسرُ؟ قال: دَحضٌ مَزِلَّةٌ، فيه خَطاطيفُ وكَلاليبُ، وحَسَكٌ تَكونُ بنَجدٍ فيها شويكةٌ يُقالُ لها السَّعدانُ، فيَمُرُّ المُؤمِنونَ كَطَرفِ العَينِ، وكالبَرقِ، وكالرِّيحِ، وكالطَّيرِ، وكَأجاويدِ الخَيلِ والرِّكابِ؛ فناجٍ مُسَلَّمٌ، ومَخدوشٌ مُرسَلٌ، ومَكدوسٌ في نارِ جَهَنَّمَ، حتَّى إذا خَلَصَ المُؤمِنونَ مِنَ النَّارِ، فوالذي نَفسي بيَدِه، ما مِنكُم مِن أحَدٍ بأشَدَّ مُناشَدةً للَّهِ في استِقصاءِ الحَقِّ مِنَ المُؤمِنينَ للَّهِ يَومَ القيامةِ لإخوانِهمُ الذينَ في النَّارِ، يقولونَ: رَبَّنا ",["كانوا يَصومونَ معنا ويُصَلُّونَ ويَحُجُّونَ",1],"، فيُقالُ لهم: ",["أخرِجوا مَن عَرَفتُم، فتُحَرَّمُ صورُهم على النَّارِ",2],"، فيُخرِجونَ خَلقًا كَثيرًا قدِ أخَذَتِ النَّارُ إلى نِصفِ ساقَيه، وإلى رُكبَتَيه، ثُمَّ يقولونَ: رَبَّنا ما بَقيَ فيها أحَدٌ مِمَّن أمَرتَنا به، فيَقولُ: ارجِعوا فمَن وجَدتُم في قَلبِه مِثقالَ دينارٍ مِن خَيرٍ فأخرِجوه، فيُخرِجونَ خَلقًا كَثيرًا، ثُمَّ يقولونَ: رَبَّنا لَم نَذَرْ فيها أحَدًا مِمَّن أمَرتَنا، ثُمَّ يقولُ: ارجِعوا فمَن وجَدتُم في قَلبِه مِثقالَ نِصفِ دينارٍ مِن خَيرٍ فأخرِجوه، فيُخرِجونَ خَلقًا كَثيرًا، ثُمَّ يقولونَ: رَبَّنا لَم نَذَرْ فيها مِمَّن أمَرتَنا أحَدًا، ثُمَّ يقولُ: ارجِعوا فمَن وجَدتُم في قَلبِه مِثقالَ ذَرَّةٍ مِن خَيرٍ فأخرِجوه، فيُخرِجونَ خَلقًا كَثيرًا، ثُمَّ يقولونَ: رَبَّنا لَم نَذَرْ فيها خَيرًا. وكانَ أبو سَعيدٍ الخُدريُّ يقولُ: إن لَم تُصَدِّقوني بهذا الحَديثِ فاقرَؤوا إن شِئتُم: {إنَّ اللهَ لا يَظلِمُ مِثقالَ ذَرَّةٍ وإن تَكُ حَسَنةً يُضاعِفها ويُؤتِ مِن لَدُنْه أجرًا عَظيمًا} [النساء: 40]، فيَقولُ اللهُ عزَّ وجلَّ: شَفَعَتِ المَلائِكةُ، وشَفَعَ النَّبيُّونَ، وشَفَعَ المُؤمِنونَ، ولَم يَبقَ إلَّا أرحَمُ الرَّاحِمينَ، فيَقبِضُ قَبضةً مِنَ النَّارِ، فيُخرِجُ مِنها قَومًا لَم يَعمَلوا خَيرًا قَطُّ قد عادوا حُمَمًا، فيُلقيهم في نَهَرٍ في أفواهِ الجَنَّةِ، يُقالُ له: نَهَرُ الحَياةِ، فيَخرُجونَ كما تَخرُجُ الحِبَّةُ في حَميلِ السَّيلِ، ألا تَرَونَها تَكونُ إلى الحَجَرِ أو إلى الشَّجَرِ، ما يَكونُ إلى الشَّمسِ أُصَيفِرُ وأُخَيضِرُ، وما يَكونُ مِنها إلى الظِّلِّ يَكونُ أبيَضَ؟ فقالوا: يا رَسولَ اللهِ، كَأنَّك كُنتَ تَرعى بالباديةِ! قال: فيَخرُجونَ كاللُّؤلُؤِ في رِقابِهمُ الخَواتِمُ، يَعرِفُهم أهلُ الجَنَّةِ: هؤلاء عُتَقاءُ اللهِ الذينَ أدخَلَهمُ اللهُ الجَنَّةَ بغيرِ عَمَلٍ عَمِلوه، ولا خَيرٍ قدَّموه، ثُمَّ يقولُ: ادخُلوا الجَنَّةَ فما رَأيتُموه فهو لكم، فيَقولونَ: رَبَّنا، أعطَيتَنا ما لَم تُعطِ أحَدًا مِنَ العالَمينَ، فيَقولُ: لكم عِندي أفضَلُ مِن هذا، فيَقولونَ: يا رَبَّنا، أيُّ شيءٍ أفضَلُ مِن هذا؟ فيَقولُ: رِضايَ، فلا أسخَطُ علَيكُم بَعدَه أبَدًا. قال مُسلِمٌ: قَرَأتُ على عيسى بنِ حَمَّادٍ زُغبةَ المِصريِّ هذا الحَديثَ في الشَّفاعةِ، وقُلتُ له: أُحَدِّثُ بهذا الحَديثِ عَنك أنَّك سَمِعتَ مِنَ اللَّيثِ بنِ سَعدٍ، فقال: نَعَم، قُلتُ لعيسى بنِ حَمَّادٍ: أخبَرَكُمُ اللَّيثُ بنُ سَعدٍ، عن خالِدِ بنِ يَزيدَ، عن سَعيدِ بنِ أبي هِلالٍ، عن زَيدِ بنِ أسلَمَ، عن عَطاءِ بنِ يَسارٍ، عن أبي سَعيدٍ الخُدريِّ، أنَّه قال: قُلنا: يا رَسولَ اللهِ، أنَرى رَبَّنا؟ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: هل تُضارُّونَ في رُؤيةِ الشَّمسِ إذا كانَ يَومٌ صَحوٌ؟ قُلنا: لا، وسُقتُ الحَديثَ حتَّى انقَضى آخِرُه، وهو نَحوُ حَديثِ حَفصِ بنِ مَيسَرةَ، وزادَ بَعدَ قَولِه: بغيرِ عَمَلٍ عَمِلوه، ولا قدَمٍ قدَّموه، فيُقالُ لهم: لكم ما رَأيتُم ومِثلُه معهُ. قال أبو سَعيدٍ: بَلَغَني أنَّ الجِسرَ أدَقُّ مِنَ الشَّعرةِ، وأحَدُّ مِنَ السَّيفِ. وليسَ في حَديثِ اللَّيثِ، فيَقولونَ: رَبَّنا أعطَيتَنا ما لَم تُعطِ أحَدًا مِنَ العالَمينَ وما بَعدَه، فأقَرَّ به عيسى بنُ حَمَّادٍ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7439) باختلاف يسير","bab":"قيامة › الشفاعة","dorar":"KOAVhCFo","merged":2,"otherRefs":["المستدرك على الصحيحين 8962 (صحيح)"]},{"id":"س-07503","fp":"4808422864dd","stateId":685,"easy":"إذا خففت أحمالك من الدنيا ← فأنت أحرى أن تنجو","cause":"وفي أحمالِنا اضْطِمارٌ","result":"أَحْرى أنْ نَنْجوَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"تخريج المسند لشعيب 21416","srcLabel":"مسلم","text":["أنَّه دخَلَ على أبي ذَرٍّ، وهو بالرَّبَذةِ، وعندَه امرأةٌ له سَوداءُ مُشْبَعةٌ، ليس عليها أثَرُ المَجاسِدِ ولا الخَلوقُ، قال: فقال: ألَا تَنظُرونَ إلى ما تأمُرُني به هذه السوَيْداءُ؟ تأمُرُني أنْ آتيَ العِراقَ، فإذا أتَيْتُ العِراقَ مالوا عليَّ بدُنْياهم، وإنَّ خَليلي صلَّى اللهُ عليه وسلَّمَ عهِدَ إليَّ: أنَّ دونَ جِسرِ جَهنَّمَ طَريقًا ذا دَحْضٍ ومَزلَّةٍ، وإنَّا نَأْتي عليه، وفي أحمالِنا اقْتِدارٌ، وحدَثَ مَطرٌ، أيضًا بالحَديثِ أجمَعَ في قولِ أحَدِهما: أنْ نأتيَ عليه وفي أحمالِنا اقْتِدارٌ، وقال الآخَرانِ: نَأْتي عليه، ",["وفي أحمالِنا اضْطِمارٌ",1],"، ",["أَحْرى أنْ نَنْجوَ",2]," من أنْ نَأتيَ عليه ونحن مواقيرُ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (21416) واللفظ له، والحارث في ((المسند)) (1087)، والحاكم (8802) باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"k3rJe1Bu"},{"id":"ق-0269","fp":"62bd1779b7d1","stateId":685,"easy":"الشكر والإيمان ← الأمن من العذاب وشكر الله","cause":"الشكر والإيمان","result":"الأمن من العذاب وشكر الله","explicit":true,"star":true,"otherNeedIds":[6],"ref":"سورة النساء: 147","srcLabel":"القرآن الكريم","quran":{"s":4,"from":147,"to":147,"text":"مَا يَفْعَلُ اللَّهُ بِعَذَابِكُمْ إِنْ شَكَرْتُمْ وَآمَنْتُمْ وَكَانَ اللَّهُ شَاكِرًا عَلِيمًا (147)","hl":[[0,96,1]]}},{"id":"ق-0751","fp":"eb4dc83e2072","stateId":685,"easy":"التقوى ← النجاة من النار","cause":"التقوى","result":"النجاة من النار","explicit":true,"ref":"سورة مريم: 72","srcLabel":"القرآن الكريم","quran":{"s":19,"from":72,"to":72,"text":"ثُمَّ نُنَجِّي الَّذِينَ اتَّقَوْا وَنَذَرُ الظَّالِمِينَ فِيهَا جِثِيًّا (72)","hl":[[0,34,1]]}},{"id":"ق-1043","fp":"b0ad455f99c8","stateId":685,"easy":"مخالفة قرين السوء والثبات على الإيمان ← النجاة من الجحيم والفوز العظيم","cause":"مخالفة قرين السوء والثبات على الإيمان","result":"النجاة من الجحيم والفوز العظيم","explicit":true,"otherNeedIds":[53],"ref":"سورة الصافات: 50–61","srcLabel":"القرآن الكريم","quran":{"s":37,"from":50,"to":61,"text":"فَأَقْبَلَ بَعْضُهُمْ عَلَى بَعْضٍ يَتَسَاءَلُونَ (50) قَالَ قَائِلٌ مِنْهُمْ إِنِّي كَانَ لِي قَرِينٌ (51) يَقُولُ أَإِنَّكَ لَمِنَ الْمُصَدِّقِينَ (52) أَإِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا أَإِنَّا لَمَدِينُونَ (53) قَالَ هَلْ أَنْتُمْ مُطَّلِعُونَ (54) فَاطَّلَعَ فَرَآهُ فِي سَوَاءِ الْجَحِيمِ (55) قَالَ تَاللَّهِ إِنْ كِدْتَ لَتُرْدِينِ (56) وَلَوْلَا نِعْمَةُ رَبِّي لَكُنْتُ مِنَ الْمُحْضَرِينَ (57) أَفَمَا نَحْنُ بِمَيِّتِينَ (58) إِلَّا مَوْتَتَنَا الْأُولَى وَمَا نَحْنُ بِمُعَذَّبِينَ (59) إِنَّ هَذَا لَهُوَ الْفَوْزُ الْعَظِيمُ (60) لِمِثْلِ هَذَا فَلْيَعْمَلِ الْعَامِلُونَ (61)","hl":[[0,597,1]]}},{"id":"ق-1097","fp":"976323b7e087","stateId":685,"easy":"التقوى ← النجاة لا يمسهم السوء ولا حزن","cause":"التقوى","result":"النجاة لا يمسهم السوء ولا حزن","explicit":true,"otherNeedIds":[6],"ref":"سورة الزمر: 61","srcLabel":"القرآن الكريم","quran":{"s":39,"from":61,"to":61,"text":"وَيُنَجِّي اللَّهُ الَّذِينَ اتَّقَوْا بِمَفَازَتِهِمْ لَا يَمَسُّهُمُ السُّوءُ وَلَا هُمْ يَحْزَنُونَ (61)","hl":[[0,102,1]]}},{"id":"س-03720","fp":"9d8f67ab1760","stateId":685,"easy":"إذا سمعت وأطعت ← فلا حجة عليك","cause":"السَّامعَ المُطيعَ","result":"لا حُجَّةَ عليه","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 16875","srcLabel":"الطبراني","text":["وإنَّ ",["السَّامعَ المُطيعَ",1]," ",["لا حُجَّةَ عليه",2],"، وإنَّ السَّامعَ العاصيَ لا حُجَّةَ له."],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (1056)، والطبراني (19/366) (861)","bab":"اعتصام بالسنة › لزوم السنة","dorar":"WZ20pwZQ"},{"id":"س-01801","fp":"262d28a2fbec","stateId":685,"easy":"إذا لزمت الجماعة ← تكون من الفرقة الناجية","cause":"وهي الجَماعةُ","result":"كلُّها في النَّارِ إلَّا واحِدةً","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"الأحاديث المختارة 2499","srcLabel":"متفق عليه","text":["«ذُكِرَ رَجُلٌ عِنْدَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فذَكروا مِن قُوَّتِه في الجِهادِ والاجْتِهادِ في العِبادةِ، فأقْبَلَ الرَّجُلُ، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: والَّذي نَفْسي بيَدِه إنِّي لَأرى في وَجْهِه سَفْعةً مِن الشَّيْطانِ، ثُمَّ أقْبَلَ فسَلَّمَ عليهم، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: هل حَدَّثْتَ نَفْسَك حينَ أشْرَفْتَ علينا أنَّه ليس في القَوْمِ أحَدٌ خَيْرًا مِنك؟ قالَ: نَعمْ. وذَهَبَ فاخْتَطَّ مَسجِدًا، وصَفَّ قَدَمَيه يُصلِّي، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: أيُّكُم يَقومُ إليه فيَقتُلُه؟ فذَهَبَ أبو بَكْرٍ فوَجَدَه يُصَلِّي، قالَ: فهابَ أن يَقتُلَه، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: أيُّكُم يَقومُ إليه فيَقتُلُه؟ فقامَ عُمَرُ فقالَ: أنا أذْهَبُ إليه، فوَجَدَه يُصَلِّي، فصَنَعَ مِثلَ ما صَنَعَ أبو بَكْرٍ، ثُمَّ رَجَعَ فقالَ عليٌّ: أنا، فقالَ: أنتَ إن أدْرَكْتَه، فذَهَبَ فوَجَدَه قدِ انْصَرَفَ، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّ هذا لأَوَّلُ قَرْنٍ يَخرُجُ مِن أمَّتي، لو قَتَلَه ما اخْتَلَفَ اثْنانِ مِن أمَّتي، ثُمَّ قالَ: إنَّ بَني إسْرائيلَ افْتَرَقَتْ على إحدى وسَبْعينَ فِرْقةً، وإنَّ أمَّتي ستَفْتَرِقُ على اثْنَتَينِ وسَبْعينَ فِرْقةً، ",["كلُّها في النَّارِ إلَّا واحِدةً",2],"، ",["وهي الجَماعةُ",1],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"6N8DnaJO","merged":3,"otherRefs":["تخريج سنن أبي داود 7/5 (صحيح)","اقتضاء الصراط المستقيم 1/137 (صحيح)"]},{"id":"س-03686","fp":"2dc526a843ef","stateId":685,"easy":"إذا كنت على ما كان عليه النبي ﷺ وأصحابه ← تكون من الفرقة الناجية","cause":"ما أنا عليهِ اليومَ وأصحابِي","result":"كلُّهم في النارِ إلا واحدةً، ثم وصَف تلك الواحدةَ أنَّها التي على ما كان عليه الرسولُ صلَّى اللهُ عليه وسلَّم وأصحابُه يعني حديث: تفترقُ هذهِ الأمةُ على ثلاثٍ وسبعينَ فرقةً كلُّهمْ في النارِ إلا فرقةً واحدةً","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[15],"ref":"الرسائل الشخصية لابن عبد الوهاب 259","srcLabel":"ابن ماجه","text":["حديثُ أنَّ أُمَّتَه ستفترِقُ على أكثرَ من سبعينَ فِرقَةً أخبَر أنَّهم ",["كلُّهم في النارِ إلا واحدةً، ثم وصَف تلك الواحدةَ أنَّها التي على ما كان عليه الرسولُ صلَّى اللهُ عليه وسلَّم وأصحابُه [يعني حديث: تفترقُ هذهِ الأمةُ على ثلاثٍ وسبعينَ فرقةً كلُّهمْ في النارِ إلا فرقةً واحدةً",2]," قالوا وما تلكَ الفرقةُ قال ",["ما أنا عليهِ اليومَ وأصحابِي",1],"]"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((الأوسط)) (4886) واللفظ له، وابن ماجه (3993)، وأحمد (12479) بنحوه عندهما وذكرا افتراق بني إسرائيل","bab":"اعتصام بالسنة › لزوم السنة","dorar":"mZd68EoQ","merged":2,"otherRefs":["شرح السنة 1/185 (صحيح)"]},{"id":"س-03407","fp":"bfbef4bcfeec","stateId":686,"easy":"إذا وعيت القرآن في قلبك ← لا يعذب الله قلباً وعاه","cause":"اقرأوا القرآنَ ولا تغُرَّنَّكم هذه المصاحفُ المُعلَّقةُ","result":"فإنَّ اللهَ لا يُعذِّبُ قلبًا وعَى القرآنَ","explicit":true,"star":true,"ref":"فتح الباري لابن حجر 8/696","srcLabel":"فتح الباري لابن حجر","text":["عن أبي أُمامةَ : ",["اقرأوا القرآنَ ولا تغُرَّنَّكم هذه المصاحفُ المُعلَّقةُ ، ",1],["فإنَّ اللهَ لا يُعذِّبُ قلبًا وعَى القرآنَ",2]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"استغفار › أسباب المغفرة","dorar":"M18J0wk8"},{"id":"س-00502","fp":"6fd320d6549b","stateId":686,"easy":"إذا حفظت القرآن ← ما أحرقه الله بالنار (من جُمع القرآن في صدره)","cause":"لو جُمِعَ القرآنُ في إِهابٍ","result":"ما أحرقه اللهُ بالنَّارِ","explicit":true,"similar":["س-02137"],"ref":"صحيح الجامع 5266","srcLabel":"الطبراني","text":[["لو جُمِعَ القرآنُ في إِهابٍ",1]," ، ",["ما أحرقه اللهُ بالنَّارِ",2]],"grade":"حسن","narrator":"عصمة بن مالك الخطمي","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (17/ 186) (498) واللفظ له، والبيهقي في ((شعب الإيمان)) (2444)، وابن عدي في ((الكامل في الضعفاء)) (6/ 15) باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"7SdJRjLU","merged":2,"otherRefs":["تخريج شرح السنة 1180 (حسن)"]},{"id":"س-02137","fp":"0fed50f30e4e","stateId":686,"easy":"إذا حفظت القرآن في صدرك ← لا تحرقه النار","cause":"لو جُعِلَ القُرآنُ في إهابٍ","result":"لَمَا احتَرَق","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-00502","ref":"تخريج مشكل الآثار 906","text":[["لو جُعِلَ القُرآنُ في إهابٍ",1]," ثمَّ أُلْقِيَ في النَّارِ ",["لَمَا احتَرَق",2],"."],"grade":"حسن","narrator":"عقبة بن عامر","muhaddith":"إسناده حسن","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (906) واللفظ له، وأحمد (17409)، والدارمي (3353) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"QuavKiKk"},{"id":"س-02411","fp":"c4812652c68a","stateId":686,"easy":"إذا كنت سبباً في إسلام أحد ← يخرجه الله بك من النار","cause":"فقال الغُلامُ: أشهَد أنْ لا إلَهَ إلَّا اللهُ، وأنَّك رسولُ اللهِ","result":"الحَمدُ للهِ الذي أخرَجَهُ بي من النَّارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-02468"],"otherNeedIds":[62],"ref":"تخريج المسند لشعيب 12793","srcLabel":"البخاري","text":["حدَّثنا مُؤَمَّلٌ، حدَّثنا حمَّادُ بنُ زَيدٍ، حدَّثنا ثابِتٌ، عن أنَسٍ مِثْلَه. [أي مِثلَ حَديثِ: أنَّ غُلامًا يَهوديًّا كان يضَعُ للنَّبيِّ صلَّى اللهُ عليه وسلَّم وَضوءَه ويُناوِلُهُ نَعْلَيهِ، فمَرِضَ، فأتاهُ النَّبيُّ صلَّى اللهُ عليه وسلَّم فدَخَلَ عليه، وأبوه قاعِدٌ عندَ رأسِهِ، فقال له النَّبيُّ صلَّى اللهُ عليه وسلَّم: يا فُلانُ، قُلْ: لا إلَهَ إلَّا اللهُ، فنَظَرَ إلى أبيهِ، فسَكَتَ أبوه. فأعادَ عليه النَّبيُّ صلَّى اللهُ عليه وسلَّم، فنَظَرَ إلى أبيه، فقال أبوه: أطِعْ أبا القاسِمِ، ",["فقال الغُلامُ: أشهَد أنْ لا إلَهَ إلَّا اللهُ، وأنَّك رسولُ اللهِ",1],". فخَرَجَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ وهو يَقولُ: ",["الحَمدُ للهِ الذي أخرَجَهُ بي من النَّارِ",2],"]"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه من طرق البخاري (1356)، وأبو داود (3095)، والنسائي في ((السنن الكبرى)) (8588)، وأحمد (12793) واللفظ له","bab":"إسلام › فضل الشهادتين","dorar":"un7aMp0C"},{"id":"س-02468","fp":"cfc79e1b744c","stateId":686,"easy":"إذا كنت سبباً في إسلام أحد ← ينقذه الله بك من النار","cause":"فأسلَمَ، ثمَّ مات","result":"الحمدُ للهِ الذي أنقَذَه بي مِنَ النارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-02411","otherNeedIds":[62],"ref":"تخريج المسند لشعيب 13375","text":["أنَّ غُلامًا مِنَ اليهودِ كان يَخدُمُ النَّبيَّ صلَّى اللهُ عليه وسلَّم، فمَرِضَ، فأتاهُ النَّبيُّ صلَّى اللهُ عليه وسلَّم يَعودُه وهو بالموتِ، فدَعاهُ إلى الإسلامِ، فنظَرَ الغُلامُ إلى أبيه وهو عِندَ رأسِه، فقال له أبوه: أَطِعْ أبا القاسمِ، ",["فأسلَمَ، ثمَّ مات",1],"، فخرَجَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم مِن عِندِه وهو يقولُ: ",["الحمدُ للهِ الذي أنقَذَه بي مِنَ النارِ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (1356)، وأبو داود (3095)، والنسائي في ((السنن الكبرى)) (8588)، وأحمد (13375) واللفظ له","bab":"إسلام › فضل الشهادتين","dorar":"45NHtPSX"},{"id":"س-02246","fp":"27d20a57db3b","stateId":686,"easy":"إذا علّمت أهلك الخير ← تقيهم وتقي نفسك النار","cause":"عَلِّموا أهليكمُ الخَيرَ","result":"قُوا أَنْفُسَكُمْ وَأَهْلِيكُمْ نَارًا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"otherNeedIds":[37],"ref":"الترغيب والترهيب 1/97","srcLabel":"الترغيب والترهيب","text":["عن علِيٍّ رَضيَ اللهُ عنه في قَولِه تَعالى: {",["قُوا أَنْفُسَكُمْ وَأَهْلِيكُمْ نَارًا",2],"} [التحريم: 6]، قالَ: ",["عَلِّموا أهليكمُ الخَيرَ",1],"."],"grade":"صحيح","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"MK9bNUtZ","merged":2,"otherRefs":["فتح الباري لابن حجر 8/527 (حسن)"]}]}