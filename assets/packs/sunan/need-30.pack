{"schema":1,"kind":"sunan-chunk","version":"sunan-2420572879fb","needId":30,"stateIds":[335,336,337,338],"items":[{"id":"س-00073","fp":"efcf42c02e56","stateId":335,"easy":"إذا دعوت بقلب غافل لاهٍ ← لا يستجيب الله لك","cause":"من قلْبٍ غافِلٍ لَاهٍ","result":"أنَّ اللهَ لا يَستجيبُ دُعاءً","explicit":true,"star":true,"ref":"صحيح الجامع 245","srcLabel":"الترمذي","text":["ادْعُوا اللهَ وأنتمْ مُوقِنُونَ بالإجابةِ ، واعلمُوا ",["أنَّ اللهَ لا يَستجيبُ دُعاءً",2]," ",["من قلْبٍ غافِلٍ لَاهٍ",1]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه الترمذي (3479) واللفظ له، والبزار (10061)","bab":"آداب الدعاء › استجابة الدعاء","dorar":"BcNyNkI1"},{"id":"س-00102","fp":"598dd40f02e3","stateId":335,"easy":"إذا دعوت ولم تمجّد الله ولم تصلِّ على النبي ﷺ ← فقد عجلت","cause":"لَم يمجِّدِ اللهَ تعالَى ، ولم يصلِّ على النبيِّ","result":"عجِلَ هذا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"similar":["س-00056"],"ref":"أصل صفة الصلاة 3/990","srcLabel":"أبو داود","text":["سمِع صلَّى اللهُ عليه وسلم رجلًا يدعو في صلاتهِ ",["لَم يمجِّدِ اللهَ تعالَى ، ولم يصلِّ على النبيِّ",1]," صلَّى اللهُ عليه وسلم ، فقال : ",["عجِلَ هذا",2]," ، ثمَّ دعاهُ فقال له أو لغيرِه : إذا صلَّى أحدُكم ، فليبدأْ ، بتحميدِ ربِّه جلَّ وعزَّ ، والثناءِ عليه ، ثمَّ يصلِّي ، وفي روايةٍ : ليصلِّ على النبيِّ صلَّى اللهُ عليه وسلم ، ثمَّ يدعو بعدُ بما شاء . وسمِع رسولُ اللهِ صلَّى اللهُ عليه وسلم رجلًا يصلِّي ، فمجَّد اللهَ ، وحمِدَه ، وصلَّى على النبيِّ صلَّى اللهُ عليه وسلم ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلم : ادعُ ، تُجَبْ ، وسَلْ ، تُعطَ"],"grade":"صحيح","narrator":"فضالة بن عبيد","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1481)، والترمذي (3477)، وأحمد (23937) باختلاف يسير، والنسائي (1284) بنحوه","bab":"آداب الدعاء › الثناء على الله في الدعاء","dorar":"m5JNITa9","merged":5,"otherRefs":["صحيح ابن خزيمة 1/ 704 (صحيح)","الصحيح المسند 1064 (صحيح)","تخريج المسند لشعيب 23937 (صحيح)","نتائج الأفكار 2/311 (صحيح)"]},{"id":"س-00056","fp":"eea09a241a54","stateId":335,"easy":"إذا دعوت قبل أن تحمد الله وتصلي على النبي ﷺ ← فقد عجلت","cause":"فقال: اللَّهمَّ اغفر لي وارحمني","result":"عجِلتَ أيُّها المصلِّي","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-00102","ref":"صحيح الترمذي 3476","text":["بينا رسولُ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّمَ قاعدٌ إذ دخلَ رجلٌ فصلَّى ",["فقال: اللَّهمَّ اغفر لي وارحمني",1],"، فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّم: ",["عجِلتَ أيُّها المصلِّي",2],"، إذا صلَّيتَ فقعدتَ فاحمَدِ اللَّهَ بما هوَ أَهلُه، وصلِّ عليَّ ثمَّ ادعُه. قال: ثمَّ صلَّى رجلٌ آخرُ بعدَ ذلِكَ فحمدَ اللَّهَ وصلَّى على النَّبيِّ صلَّى اللَّهُ عليْهِ وسلَّمَ فقالَ لَهُ النَّبيُّ صلَّى اللَّهُ عليْهِ وسلَّم: أيُّها المصلِّي ادعُ تُجَب"],"grade":"صحيح","narrator":"فضالة بن عبيد","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1481)، والترمذي (3476) واللفظ له، والنسائي (1284)، وأحمد (23982)","bab":"آداب الدعاء › استجابة الدعاء","dorar":"bi0rfBNA"},{"id":"س-06849","fp":"49da108687e8","stateId":336,"easy":"إذا كان مطعمك ومشربك وملبسك حراماً ← فأنّى يُستجاب لك","cause":"ومَطْعَمُهُ حَرامٌ، ومَشْرَبُهُ حَرامٌ، ومَلْبَسُهُ حَرامٌ، وغُذِيَ بالحَرامِ","result":"فأنَّى يُسْتَجابُ لذلكَ","explicit":true,"star":true,"ref":"عارضة الأحوذي 5/408","srcLabel":"مسلم","text":["إنَّ اللهَ طيِّبٌ. [يعني حديث: أَيُّها النَّاسُ، إنَّ اللَّهَ طَيِّبٌ لا يَقْبَلُ إلَّا طَيِّبًا، وإنَّ اللَّهَ أمَرَ المُؤْمِنِينَ بما أمَرَ به المُرْسَلِينَ، فقالَ: {يَا أَيُّهَا الرُّسُلُ كُلُوا مِنَ الطَّيِّبَاتِ وَاعْمَلُوا صَالِحًا إِنِّي بِمَا تَعْمَلُونَ عَلِيمٌ} [المؤمنون: 51]، وقالَ: {يَا أَيُّهَا الَّذِينَ آمَنُوا كُلُوا مِنْ طَيِّبَاتِ مَا رَزَقْنَاكُمْ} [البقرة: 172]، ثُمَّ ذَكَرَ الرَّجُلَ يُطِيلُ السَّفَرَ أشْعَثَ أغْبَرَ، يَمُدُّ يَدَيْهِ إلى السَّماءِ، يا رَبِّ، يا رَبِّ، ",["ومَطْعَمُهُ حَرامٌ، ومَشْرَبُهُ حَرامٌ، ومَلْبَسُهُ حَرامٌ، وغُذِيَ بالحَرامِ",1]," ، ",["فأنَّى يُسْتَجابُ لذلكَ",2],"؟!]"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1015)، وأحمد (8348)، والدارمي (2759) بلفظه تامًا.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"QsWdQUuL"},{"id":"س-03941","fp":"0444f4847c38","stateId":336,"easy":"إذا أبقيت امرأة سيئة الخلق أو أقرضت بلا إشهاد أو أعطيت السفيه مالك ← تدعو فلا يُستجاب لك","cause":"رَجلٌ كانتْ تحتَهُ امرأةٌ سيِّئةُ الخُلُقِ فلمْ يُطلِّقْها، ورَجلٌ كان له على رَجلٍ مالٌ فلمْ يُشهِدْ عليه، ورَجلٌ آتَى سفيهًا مالَهُ وقد قالَ اللهُ عزَّ وجلَّ: {وَلَا تُؤْتُوا السُّفَهَاءَ أَمْوَالَكُمُ} النساء: 5","result":"ثلاثةٌ يَدْعونَ اللهَ فلا يُستجابُ لهم","explicit":true,"ref":"المستدرك على الصحيحين 3223","srcLabel":"البيهقي","text":["«",["ثلاثةٌ يَدْعونَ اللهَ فلا يُستجابُ لهم",2],":",[" رَجلٌ كانتْ تحتَهُ امرأةٌ سيِّئةُ الخُلُقِ فلمْ يُطلِّقْها، ورَجلٌ كان له على رَجلٍ مالٌ فلمْ يُشهِدْ عليه، ورَجلٌ آتَى سفيهًا مالَهُ وقد قالَ اللهُ عزَّ وجلَّ: {وَلَا تُؤْتُوا السُّفَهَاءَ أَمْوَالَكُمُ} [النساء: 5]».",1]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه ابن أبي شيبة (17144)، والطحاوي في ((شرح مشكل الآثار)) (2530)، والبيهقي (20547) واللفظ لهم.","bab":"تفسير آيات › سورة النساء","dorar":"nub4G3WN","merged":2,"otherRefs":["عمدة التفسير 1/462 (صحيح)"]},{"id":"س-04900","fp":"84366a6f4843","stateId":336,"easy":"إذا وضعت الخمر على كفك ← لا تُقبل لك دعوة","cause":"منْ وضَعَ الخمرَ على كفِّهِ","result":"لمْ تقبلْ لهُ دعوةٌ، و منْ أدمنَ على شربِها، سُقِي منَ الخبالِ","explicit":true,"ref":"الجامع الصغير 9058","srcLabel":"الطبراني","text":[["منْ وضَعَ الخمرَ على كفِّهِ، ",1],["لمْ تقبلْ لهُ دعوةٌ، و منْ أدمنَ على شربِها، سُقِي منَ الخبالِ",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن","takhrij":"أخرجه الطبراني (879) (19/ 374) واللفظ له.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"zb6YOLAI"},{"id":"س-00064","fp":"b74d37e86867","stateId":336,"easy":"إذا كنت زانية تسعى بفرجها أو عشّاراً ← لا يُستجاب دعاؤك","cause":"إلا زانيةً تسعَى بفرجِها ، أو عشار","result":"إلا استجابَ اللهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"السلسلة الصحيحة 1073","srcLabel":"الطبراني","text":["تُفْتَحُ أبوابُ السماءِ نصفَ الليلِ ، فيُنادِي مُنادٍ : هل من داعٍ فيُستجابُ له ، هل من سائلٍ فيُعْطى ، هل من مكروبٍ فيُفرّجُ عنه ، فلا يبْقَى مسلم يدعو بدعوةٍ ",["إلا استجابَ اللهُ",2]," عز وجل لهُ ، ",["إلا زانيةً تسعَى بفرجِها ، أو عشار",1],"ا"],"grade":"صحيح","narrator":"عثمان بن أبي العاص الثقفي","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني (9/51) (8391)، والشجري في ((ترتيب أماليه)) (989)","bab":"آداب الدعاء › استجابة الدعاء","dorar":"zETPmbDd"},{"id":"س-02963","fp":"7aafa1157c94","stateId":337,"easy":"إذا وليت أمراً فأغلقت بابك دون المسكين والمظلوم ← يغلق الله دونك أبواب رحمته عند حاجتك","cause":"مَن وَليَ أمْرًا مِن أمْرِ الناسِ، ثمَّ أَغلَقَ بابَه دُونَ المِسكينِ والمَظلومِ، أو ذي الحاجةِ","result":"أغلَقَ اللهُ تبارَك وتعالَى دُونَه أبوابَ رحمتِه عِندَ حاجَتِه وفَقرِه أَفقَرَ ما يَكونُ إليها","explicit":true,"star":true,"otherNeedIds":[28],"ref":"تخريج المسند لشعيب 15651","srcLabel":"أحمد","text":[["مَن وَليَ أمْرًا مِن أمْرِ الناسِ، ثمَّ أَغلَقَ بابَه دُونَ المِسكينِ والمَظلومِ، أو ذي الحاجةِ؛ ",1],["أغلَقَ اللهُ تبارَك وتعالَى دُونَه أبوابَ رحمتِه عِندَ حاجَتِه وفَقرِه أَفقَرَ ما يَكونُ إليها",2],"."],"grade":"صحيح","narrator":"رجل من الصحابة","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (15651) واللفظ له، وأبو يعلى (7378) بنحوه، والبيهقي في ((شعب الإيمان)) (7384) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"W72uwPOW","merged":2,"otherRefs":["تنبيه الغافلين 222 (حسن)"]},{"id":"س-02987","fp":"39ced233ab6a","stateId":337,"easy":"إذا وليت أمر المسلمين فاحتجبت عن حاجتهم ← يحتجب الله دون حاجتك وفقرك","cause":"مَن وَلَّاه اللهُ شَيئًا مِن أمْرِ المُسلِمينَ، فاحْتَجَبَ دونَ حاجتِهم وخَلَّتِهم وفَقْرِهم","result":"احْتَجَبَ اللهُ دونَ حاجتِه وخَلَّتِه وفَقْرِه","explicit":true,"star":true,"similar":["س-03094"],"ref":"الأحكام الوسطى 2/366","srcLabel":"أبو داود","text":["عن أبي مَرْيَمَ الأَزْديِّ قالَ: دَخَلْتُ على مُعاوِيةَ فقالَ: ما أَنعَمَنا بك يا أبا فُلانٍ؟ وهي كَلِمةٌ تَقولُها العَرَبُ، فقُلْتُ: حَديثًا سَمِعْتُه أُخبِرُك به، سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن وَلَّاه اللهُ شَيئًا مِن أمْرِ المُسلِمينَ، فاحْتَجَبَ دونَ حاجتِهم وخَلَّتِهم وفَقْرِهم ",1],["احْتَجَبَ اللهُ دونَ حاجتِه وخَلَّتِه وفَقْرِه\"",2],"، قالَ: فجَعَلَ رَجُلًا على حوائِجِ النَّاسِ."],"grade":"صحيح","narrator":"أبو مريم الأزدي","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (2948) واللفظ له، والترمذي (1332)، وأحمد (18033) بنحوه","bab":"إيمان › الوعيد","dorar":"s59Rfg8r","merged":2,"otherRefs":["المستدرك على الصحيحين 7222 (صحيح)"]},{"id":"س-02492","fp":"78f6e958dd9e","stateId":337,"easy":"إذا أغلقت بابك وأنت والٍ دون ذوي الحاجة ← يغلق الله أبواب السماء دون حاجتك","cause":"ما من إمامٍ أو والٍ يُغلِقُ بابَه دون ذَوي الحاجةِ والخَلَّةِ، والمَسكَنةِ","result":"إلَّا أغلَقَ اللهُ أبوابَ السماءِ دون حاجَتِه، وخَلَّتِه، ومَسكنَتِه","explicit":true,"ref":"تخريج المسند لشعيب 18033","srcLabel":"الترمذي","text":[["ما من إمامٍ أو والٍ يُغلِقُ بابَه دون ذَوي الحاجةِ والخَلَّةِ، والمَسكَنةِ،",1]," ",["إلَّا أغلَقَ اللهُ أبوابَ السماءِ دون حاجَتِه، وخَلَّتِه، ومَسكنَتِه",2],"، قال: فجعَلَ مُعاويةُ رَجلًا على حوائجِ النَّاسِ."],"grade":"صحيح","narrator":"عمرو بن مرة الجهني","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (1332)، وأحمد (18033) واللفظ له","bab":"إمامة وخلافة › تولية الولاة وغيرهم","dorar":"R8iKq6Jo"},{"id":"س-02965","fp":"62ccfa8a19a0","stateId":337,"easy":"إذا وليت أمراً فاحتجبت عن الضعفاء وذوي الحاجة ← يحتجب الله عنك يوم القيامة","cause":"مَن وَليَ مِن أمْرِ النَّاسِ شيئًا فاحتجَبَ عن أُولي الضَّعْفَةِ والحاجةِ","result":"احتجَبَ اللهُ عنه يومَ القِيامةِ","explicit":true,"ref":"تخريج المسند لشعيب 22076","srcLabel":"أحمد","text":[["مَن وَليَ مِن أمْرِ النَّاسِ شيئًا فاحتجَبَ عن أُولي الضَّعْفَةِ والحاجةِ، ",1],["احتجَبَ اللهُ عنه يومَ القِيامةِ",2],"."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (22076) واللفظ له، والطبراني (20/152) (316)","bab":"إيمان › الوعيد","dorar":"fGlWqwxx"},{"id":"س-03839","fp":"021a12f60730","stateId":337,"easy":"إذا قطعت رحمك ← تُغلق أبواب السماء دونك","cause":"قاطعَ رحمٍ","result":"وإنَّ أبوابَ السَّماءِ مُرتَجةٌ مغلَّقةٌ دونَ قاطعِ رحمٍ","explicit":true,"otherNeedIds":[44],"ref":"الزواجر عن اقتراف الكبائر 2/77","srcLabel":"الطبراني","text":["كانَ ابنُ مسعودٍ رضيَ اللَّهُ عنهُ جالسًا بعدَ الصُّبحِ في حلقةٍ فقالَ أنشدُ اللَّهَ ",["قاطعَ رحمٍ",1]," لما قامَ عَنْا فإنَّا نريدُ أن ندعوَ ربَّنا ",["وإنَّ أبوابَ السَّماءِ مُرتَجةٌ مغلَّقةٌ دونَ قاطعِ رحمٍ",2]],"grade":"صحيح","narrator":"سليمان بن مهران","muhaddith":"إسناده صحيح","takhrij":"أخرجه عبد الرزاق (20242)، والطبراني في ((المعجم الكبير)) (9/ 173) (8793)، والبيهقي في ((شعب الإيمان)) (7592)، باختلاف يسير.","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"YjV8fAqN"},{"id":"س-03094","fp":"b66842575447","stateId":337,"easy":"إذا وليت أمر الناس فاحتجبت عن حاجتهم ← يحتجب الله عن حاجتك يوم القيامة","cause":"مَن ولَّاه اللهُ من أمْرِ النَّاسِ شيئًا فاحتَجَبَ عن حاجَتِهِمُ","result":"احتَجَبَ اللهُ عن حاجَتِهِ يومَ القيامةِ","explicit":true,"repOf":"س-02987","ref":"إرشاد الساري 10/226","text":[["مَن ولَّاه اللهُ من أمْرِ النَّاسِ شيئًا فاحتَجَبَ عن حاجَتِهِمُ",1]," ",["احتَجَبَ اللهُ عن حاجَتِهِ يومَ القيامةِ",2],"."],"grade":"حسن","narrator":"أبو مريم الأسدي","muhaddith":"إسناده جيد","bab":"إيمان › الوعيد","dorar":"JSJCnb1e"},{"id":"ق-0405","fp":"f15906b76165","stateId":338,"easy":"الاعتداء في الدعاء ← لا يحبه الله","cause":"الاعتداء في الدعاء","result":"لا يحبه الله","explicit":true,"ref":"سورة الأعراف: 55","srcLabel":"القرآن الكريم","quran":{"s":7,"from":55,"to":55,"text":"ادْعُوا رَبَّكُمْ تَضَرُّعًا وَخُفْيَةً إِنَّهُ لَا يُحِبُّ الْمُعْتَدِينَ (55)","hl":[[40,74,1]]}},{"id":"ق-0620","fp":"a650e416155b","stateId":338,"easy":"دعاء غير الله ← لا استجابة بشيء وهو في ضلال","cause":"دعاء غير الله","result":"لا استجابة بشيء وهو في ضلال","explicit":true,"star":true,"similar":["ق-1191"],"ref":"سورة الرعد: 14","srcLabel":"القرآن الكريم","quran":{"s":13,"from":14,"to":14,"text":"لَهُ دَعْوَةُ الْحَقِّ وَالَّذِينَ يَدْعُونَ مِنْ دُونِهِ لَا يَسْتَجِيبُونَ لَهُمْ بِشَيْءٍ إِلَّا كَبَاسِطِ كَفَّيْهِ إِلَى الْمَاءِ لِيَبْلُغَ فَاهُ وَمَا هُوَ بِبَالِغِهِ وَمَا دُعَاءُ الْكَافِرِينَ إِلَّا فِي ضَلَالٍ (14)","hl":[[23,221,1]]}},{"id":"ق-0838","fp":"366ae3c36b6d","stateId":338,"easy":"النكوص عن آيات الله والاستكبار ← لا يُنصرون عند العذاب ولا ينفع الجؤار","cause":"النكوص عن آيات الله والاستكبار","result":"لا يُنصرون عند العذاب ولا ينفع الجؤار","explicit":true,"otherNeedIds":[56],"ref":"سورة المؤمنون: 64–67","srcLabel":"القرآن الكريم","quran":{"s":23,"from":64,"to":67,"text":"حَتَّى إِذَا أَخَذْنَا مُتْرَفِيهِمْ بِالْعَذَابِ إِذَا هُمْ يَجْأَرُونَ (64) لَا تَجْأَرُوا الْيَوْمَ إِنَّكُمْ مِنَّا لَا تُنْصَرُونَ (65) قَدْ كَانَتْ آيَاتِي تُتْلَى عَلَيْكُمْ فَكُنْتُمْ عَلَى أَعْقَابِكُمْ تَنْكِصُونَ (66) مُسْتَكْبِرِينَ بِهِ سَامِرًا تَهْجُرُونَ (67)","hl":[[0,270,1]]}},{"id":"ق-1191","fp":"8f1e3f1a09f6","stateId":338,"easy":"دعاء غير الله ← لا استجابة إلى يوم القيامة","cause":"دعاء غير الله","result":"لا استجابة إلى يوم القيامة","explicit":true,"repOf":"ق-0620","ref":"سورة الأحقاف: 5","quran":{"s":46,"from":5,"to":5,"text":"وَمَنْ أَضَلُّ مِمَّنْ يَدْعُو مِنْ دُونِ اللَّهِ مَنْ لَا يَسْتَجِيبُ لَهُ إِلَى يَوْمِ الْقِيَامَةِ وَهُمْ عَنْ دُعَائِهِمْ غَافِلُونَ (5)","hl":[[0,136,1]]}},{"id":"س-04721","fp":"5af4a00a9f70","stateId":338,"easy":"إذا دعوت رياءً أو سمعة أو لعباً ← لا يسمع الله دعاءك","cause":"من مُسْمِعٍ ولا مُرَاءٍ ولا لاعِبٍ","result":"لا يسمعُ اللهُ","explicit":true,"star":true,"ref":"صحيح الأدب المفرد 473","srcLabel":"البخاري","text":["قال عبدُ اللهِ ",["لا يسمعُ اللهُ",2]," ",["من مُسْمِعٍ ولا مُرَاءٍ ولا لاعِبٍ",1]," إلَّا دَاعٍ دعا يَثْبُتُ من قلبِهِ"],"grade":"صحيح","narrator":"عبدالرحمن بن يزيد بن جابر","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (606)، وأحمد في ((الزهد)) (872) واللفظ لهما، وابن المبارك في ((الزهد)) (83) باختلاف يسير.","bab":"رقائق وزهد › الإخلاص","dorar":"5wxTNIg8"},{"id":"س-07492","fp":"915d856837f7","stateId":338,"easy":"إذا اعتديت في الدعاء ← فهو من صفات قوم مذمومين","cause":"يعتدونَ في الدُّعاءِ","result":"سيَكونُ قومٌ","explicit":true,"ref":"صحيح أبي داود 1480","srcLabel":"أبو داود","text":["سمعَني أبي وأَنا أقولُ اللَّهمَّ إنِّي أسألُكَ الجنَّةَ ونعيمَها وبَهْجتَها وَكَذا وَكَذا وأعوذُ بِكَ منَ النَّارِ وسلاسلِها وأغلالِها وَكَذا وَكَذا فقالَ يا بُنَيَّ إنِّي سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ ",["سيَكونُ قومٌ",2]," ",["يعتدونَ في الدُّعاءِ",1]," فإيَّاكَ أن تَكونَ منهُم إنَّكَ إن أُعطيتَ الجنَّةَ أُعطيتَها وما فيها منَ الخيرِ وإن أُعِذتَ منَ النَّارِ أُعِذتَ منها وما فيها منَ الشَّرِّ"],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"حسن صحيح","takhrij":"أخرجه أبو داود (1480) واللفظ له، والطيالسي (197)، وأبو يعلى (715) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"iONZl9jb"}]}