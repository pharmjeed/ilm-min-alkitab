{"schema":1,"kind":"sunan-chunk","version":"sunan-98a69b4361e7","needId":43,"stateIds":[400,401,402,403,404,405],"items":[{"id":"س-05708","fp":"2f82df6f57af","stateId":400,"easy":"إذا تواضعت لله ← يرفعك","cause":"مَن تواضَعَ لي هكذا","result":"رفَعْتُه هكذا","explicit":true,"star":true,"similar":["س-05744","س-00398","س-05699","س-05716","س-05718","س-05736"],"ref":"الأحاديث المختارة 209","srcLabel":"البخاري","text":["قال: قال اللهُ تبارك وتعالى: «",["مَن تواضَعَ لي هكذا",1]," -وأشار يَزيدُ بكَفِّه إلى الأرضِ- ",["رفَعْتُه هكذا",2]," -وأشار يَزيدُ ببَطْنِ كَفِّه إلى السَّماءِ»."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"رقائق وزهد › الكبر والتواضع","dorar":"vQu9Mfws"},{"id":"س-05744","fp":"c274b8980cdb","stateId":400,"easy":"إذا تواضعت ← يرفعك الله","cause":"تَواضَعَ العَبْدُ","result":"رَفَعَه اللهُ بالسِّلسلةِ الَّتي في السَّماءِ","explicit":true,"repOf":"س-05708","ref":"الأحاديث المختارة 11 / 411","text":["«ما مِن بَني آدَمَ أحَدٌ إلَّا وفي رَأسِه سِلْسِلتانِ إحْداهما في السَّماءِ السَّابِعةِ والأخرى في الأرْضِ السَّابِعةِ، فإذا ",["تَواضَعَ العَبْدُ",1]," ",["رَفَعَه اللهُ بالسِّلسلةِ الَّتي في السَّماءِ",2],"، وإذا أرادَ أن يَرفَعَ نَفْسَه وَضَعَه اللهُ»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الكبر والتواضع","dorar":"biQho67W"},{"id":"س-00398","fp":"62a0be4c20bf","stateId":400,"easy":"إذا تواضعت ← يرفعك الله","cause":"ومَن تَواضَعَ","result":"رَفَعَه اللهُ","explicit":true,"repOf":"س-05708","otherNeedIds":[47],"ref":"الأحكام الوسطى 4/ 145","text":["تَمشَّى رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ معَنا وهو صائِمٌ، فجَهَدَه الصَّوْمُ، فحَلَبْنا له ناقةً لنا في قَعْبٍ، وصَبَّيْنا عليه عَسَلًا نُكرِمُ به رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ عنْدَ فِطْرِه، فلمَّا غابَتِ الشَّمْسُ ناوَلْناه القَعْبَ، فلمَّا ذاقَه قالَ بيَدِه كأنَّه يقولُ: \"ما هذا؟\"، قُلْنا: لَبَنًا وعَسَلًا أَرَدْنا نُكرِمُك به، قالَ: \"أَكرَمَك اللهُ بما أَكرَمْتَني\"، أو دَعْوةً هذا مَعْناها، ثُمَّ قالَ: \"مَن اقْتَصَدَ أَغْناه اللهُ، ومَن بَذَّرَ أَفقَرَه اللهُ، ",["ومَن تَواضَعَ ",1],["رَفَعَه اللهُ",2],"، ومَن تَجَبَّرَ قَصَمَه اللهُ\"."],"grade":"صحيح","narrator":"طلحة بن عبيد الله","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه البزار (946)، وقوام السنة في ((الترغيب والترهيب)) (638) واللفظ لهما","bab":"آداب عامة › الأخلاق المذمومة","dorar":"oVUBfjRz","merged":6,"otherRefs":["الأمالي المطلقة 89 (حسن)","صحيح ابن خزيمة 4/ 163 (صحيح)","تخريج المسند لشعيب 7206 (صحيح)","تفسير القرآن العظيم 2/396 (صحيح)","فيض القدير 6/ 109 (حسن)"]},{"id":"س-01632","fp":"9832002b3cf5","stateId":400,"easy":"إذا أكلت مع خادمك وركبت الحمار وحلبت الشاة ← فلست متكبراً","cause":"مَنْ أكلَ مَعهُ خادِمُهُ ، وركِبَ الحِمارَ بالأسْواقِ ، واعتقَلَ الشَّاةَ فحلَبَها","result":"ما استكْبَرَ","explicit":true,"ref":"صحيح الجامع 5527","srcLabel":"البخاري","text":[["ما استكْبَرَ",2]," ",["مَنْ أكلَ مَعهُ خادِمُهُ ، وركِبَ الحِمارَ بالأسْواقِ ، واعتقَلَ الشَّاةَ فحلَبَها",1]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (550) واللفظ له، والبيهقي في ((شعب الإيمان)) (8188)","bab":"أطعمة › حلب الرجل الناقة وغيرها","dorar":"s40gAVJD"},{"id":"س-05699","fp":"4a35d5ad1420","stateId":400,"easy":"إذا تواضعت لله درجة ← يرفعك الله درجة حتى يجعلك في أعلى عليين","cause":"مَن تواضَع للهِ درجةً","result":"يرفَعْه اللهُ درجةً حتَّى يجعَلَه في أعلى عِلِّيِّينَ","explicit":true,"repOf":"س-05708","otherNeedIds":[47],"ref":"صحيح ابن حبان 5678","text":[["مَن تواضَع للهِ درجةً ",1],["يرفَعْه اللهُ درجةً حتَّى يجعَلَه في أعلى عِلِّيِّينَ ",2],"ومَن يتكبَّرْ على اللهِ درجةً يضَعْه اللهُ درجةً حتَّى يجعَلَه في أسفلِ السَّافلينَ ولو أنَّ أحدَكم يعمَلُ في صخرةٍ صمَّاءَ ليس عليه بابٌ ولا كُوَّةٌ لَخرَج ما غيَّبه للناسِ كائنًا ما كان"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن ماجه (4176)، وأحمد (11724)، وأبو يعلى في ((المسند)) (1109) بلفظه.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"snrUPhwM"},{"id":"س-05716","fp":"57f081a059ba","stateId":400,"easy":"إذا تواضعت لله ← يرفعك الله","cause":"من يتواضعَ للهِ سبحانَه","result":"يرفعْهُ اللهُ","explicit":true,"repOf":"س-05708","ref":"صحيح ابن ماجه 3/365","text":[["من يتواضعَ للهِ سبحانَه",1]," . . ، ",["يرفعْهُ اللهُ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (4176)، وأحمد (11724)، وابن حبان (5678)، وأبو يعلى في ((المسند)) (1109) بلفظه.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"5aIrNkCG"},{"id":"س-05718","fp":"1bba9bc68df2","stateId":400,"easy":"إذا تواضعت لله ← يرفعك الله إلى السماء","cause":"مَن تواضَعَ لي هكذا -وجعَلَ يزيدُ باطنَ كفِّه إلى الأرضِ، وأدْناها إلى الأرضِ","result":"رفَعْتُه هكذا -وجعَلَ باطنَ كفِّه إلى السماءِ، ورفَعَها نحوَ السماءِ","explicit":true,"repOf":"س-05708","ref":"تخريج المسند لشعيب 309","text":["عن عُمَرَ -قال: لا أعلَمُه إلَّا رفَعَه- قال: يقولُ اللهُ تبارَكَ وتعالى: ",["مَن تواضَعَ لي هكذا -وجعَلَ يزيدُ باطنَ كفِّه إلى الأرضِ، وأدْناها إلى الأرضِ- ",1],["رفَعْتُه هكذا -وجعَلَ باطنَ كفِّه إلى السماءِ، ورفَعَها نحوَ السماءِ-",2],"."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (309) واللفظ له، والحارث في ((المسند)) (854).","bab":"رقائق وزهد › الكبر والتواضع","dorar":"ESohODXh"},{"id":"س-05736","fp":"7e4f5be51081","stateId":400,"easy":"إذا تواضعت (طأطأت رأسك) ← يرفعك الله (أثر عمر)","cause":"طأطأ رأسَه","result":"انتعِش نعشَكَ اللهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-05708","ref":"بيان تلبيس الجهمية 6/68","text":["عن عمرَ قال ما من أحدٍ إلَّا وفي رأسِه حكمةٌ فإنْ رفع رأسَه قيل له انتكِسْ نَكسكَ اللهُ وإنْ ",["طأطأ رأسَه",1]," قيل له ",["انتعِش نعشَكَ اللهُ",2]],"grade":"صحيح","muhaddith":"محفوظ","bab":"رقائق وزهد › الكبر والتواضع","dorar":"T3DVREbJ"},{"id":"س-07410","fp":"41bf16cda32a","stateId":400,"easy":"إذا تواضعت ← يرفع الملك حكمتك","cause":"فإن تواضَع","result":"قيل للمَلَكِ ارفَعِ الحكمةَ","explicit":true,"ref":"مجمع الزوائد 8/86","srcLabel":"البزار","text":["ما من امرئٍ إلَّا وفي رأسِه حكمةٌ والحكمةً بيدِ مَلَكٍ ",["فإن تواضَع",1]," ",["قيل للمَلَكِ ارفَعِ الحكمةَ",2]," وإن أراد أن يُرفَعَ قيل للمَلَكْ ضَعِ الحكمةَ أو حكمتَه"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه البزار (7847)، والعقيلي في ((الضعفاء الكبير)) (4/237)، وابن عدي في ((الكامل في الضعفاء)) (6/330) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"PqYIdZ8f","merged":2,"otherRefs":["فيض القدير 5/ 467 (حسن)"]},{"id":"س-08117","fp":"347be2e25b67","stateId":401,"easy":"إذا ظُلمت فأغضيت عنها لله ← يعزّ الله بها نصرك","cause":"ما مِن عَبدٍ ظُلِمَ بمَظلَمَةٍ فيُغْضي عنها للهِ عزَّ وجلَّ","result":"إلَّا أعزَّ اللهُ بها نَصْرَه","explicit":true,"star":true,"otherNeedIds":[25],"ref":"مجمع الزوائد 8/192","srcLabel":"مسلم","text":["أنَّ رَجُلًا شَتَمَ أبا بَكرٍ والنَّبيُّ صلَّى اللهُ عليه وسلَّم جالِسٌ، فجَعَلَ النَّبيُّ صلَّى اللهُ عليه وسلَّم يَعجَبُ ويَبتَسِمُ، فلمَّا أكثَرَ رَدَّ عليه بعضَ قَولِه، فغَضِبَ النَّبيُّ صلَّى اللهُ عليه وسلَّم وقامَ، فلَحِقَه أبو بَكرٍ، فقال: يا رسولَ اللهِ، كان يَشتُمُني وأنتَ جالِسٌ، فلمَّا رَدَدتُ عليه بعضَ قَولِه، غَضِبتَ وقُمتَ! قال: إنَّه كان معك مَلَكٌ يَرُدُّ عنك، فلمَّا رَدَدتَ عليه بعضَ قَولِه، وَقَعَ الشَّيطانُ، فلم أكُنْ لِأَقعُدَ مع الشَّيطانِ، ثم قال: يا أبا بَكرٍ، ثلاثٌ كُلُّهن حَقٌّ: ",["ما مِن عَبدٍ ظُلِمَ بمَظلَمَةٍ فيُغْضي عنها للهِ عزَّ وجلَّ،",1]," ",["إلَّا أعزَّ اللهُ بها نَصْرَه",2],"، وما فَتَحَ رَجُلٌ بابَ عَطيَّةٍ يُريدُ بها صِلَةً، إلَّا زادَه بها كثْرَةً، وما فَتَحَ بابَ مَسأَلةٍ يُريدُ بها كثْرَةً، إلَّا زادَه اللهُ بها قِلَّةً."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (9624) بلفظه، ومسلم (2588)، والترمذي (2029) بنحوه.","bab":"ملائكة › أعمال الملائكة","dorar":"LZZkcHK6","merged":2,"otherRefs":["تخريج شرح السنة 3586 (حسن)"]},{"id":"س-06358","fp":"ebcd18811895","stateId":401,"easy":"إذا عفوت عن مظلمة ← يزيدك الله عزاً","cause":"ولا عَفَا رجلٌ عن مَظلمةٍ ظُلِمَها","result":"إلا زادَهُ اللهُ تعالَى بِها عِزًّا","explicit":true,"star":true,"similar":["س-01789","س-05703"],"ref":"صحيح الجامع 3025","srcLabel":"أحمد","text":["ثلاثٌ أُقسِمُ عليهِنَّ : ما نقَصَ مالٌ قطُّ من صدقةٍ ، فتصدَّقُوا ، ",["ولا عَفَا رجلٌ عن مَظلمةٍ ظُلِمَها",1]," ",["إلا زادَهُ اللهُ تعالَى بِها عِزًّا",2]," ، فاعفُوا يزِدْكمُ اللهُ عِزًّا ، ولا فتَحَ رجلٌ على نفسِهِ بابَ مَسألةٍ يَسألُ الناسَ إلا فتَحَ اللهُ عليه بابَ فقْرٍ"],"grade":"صحيح","narrator":"عبدالرحمن بن عوف","muhaddith":"صحيح","takhrij":"أخرجه أحمد (1674)، والبزار (1032)، وأبو يعلى (849)","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"8NdOiNP4","merged":5,"otherRefs":["مختصر المقاصد 914 (صحيح)","صحيح ابن خزيمة 4/ 163 (صحيح)","تخريج المسند لشعيب 7206 (صحيح)","تخريج المسند لشعيب 9643 (صحيح)"]},{"id":"س-01789","fp":"c2f16aecc560","stateId":401,"easy":"إذا عفوت عن مظلمة تبتغي وجه الله ← يزيدك الله عزاً","cause":"ولا يعفو عبدٌ عن مظلمةٍ يبتغي بها وجهَ اللهِ عز وجل","result":"إلا زاده اللهُ بها عزًّا","explicit":true,"repOf":"س-06358","ref":"نيل الأوطار 7/177","text":["ثلاثٌ والذي نفسِ محمدٍ بيدهِ إن كنتُ لحالفًا عليهنَّ :لا ينقصُ مالٌ من صدقةٍ فتصدَّقوا، ",["ولا يعفو عبدٌ عن مظلمةٍ يبتغي بها وجهَ اللهِ عز وجل",1]," ",["إلا زاده اللهُ بها عزًّا",2]," يومَ القيامةِ، ولا يفتح عبدٌ بابَ مسألةٍ إلا فتح اللهُ عليه بابَ فقرٍ"],"grade":"صحيح","narrator":"عبدالرحمن بن عوف","muhaddith":"صحيح","takhrij":"أخرجه أحمد (1674)، والبزار (1032)، وأبو يعلى (849)","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"D9lL7AyR"},{"id":"س-02075","fp":"6312939d9347","stateId":401,"easy":"إذا عفوت ← يعزك الله","cause":"فاعفوا","result":"يُعِزُّكم اللهُ","explicit":true,"ref":"مختصر المقاصد 914","srcLabel":"الطبراني","text":["ما نقَصَ مالٌ من صدَقةٍ [يعني حديث: ما نقَص مالٌ مِن صَدَقةٍ، ولا عفا رجُلٌ عن مَظلَمةٍ إلَّا زاده اللهُ بها عِزًّا، ",["فاعفوا",1]," ",["يُعِزُّكم اللهُ",2],"، ولا فتَح رجُلٌ على نَفسِه بابَ مَسألةٍ إلَّا فتَح اللهُ عليه بابَ فَقرٍ؛ فإنَّ العِفَّةَ خيرٌ.]"],"grade":"صحيح","narrator":"[أم سلمة أم المؤمنين]","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((الأوسط)) (2270)، والطبراني في ((مكارم الأخلاق)) (368)، والقضاعي في ((مسند الشهاب)) (783) بلفظه تامًا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"t5PGatQr"},{"id":"س-06050","fp":"efa351052c2b","stateId":401,"easy":"إذا ظُلمت فصبرت ← يزيدك الله عزاً","cause":"ولا ظُلم عبدٌ مظلمةً صبر عليها","result":"إلا زادهُ اللهُ بها عزًّا","explicit":true,"ref":"هداية الرواة 5217","srcLabel":"الترمذي","text":["أنهُ سمع رسولَ اللهِ - صلَّى اللهُ عليهِ وسلَّمَ - يقول : ثلاثٌ أُقسِم عليهنَّ، وأحدِّثُكم حديثًا فاحفظوهُ : فأما الذي أُقسمُ عليهنَّ ؛ فإنهُ ما نقص مالُ عبدٍ من صدقةٍ، ",["ولا ظُلم عبدٌ مظلمةً صبر عليها ؛",1]," ",["إلا زادهُ اللهُ بها عزًّا",2],"، ولا فتح عبدٌ بابَ مسألةٍ ؛ إلا فتح اللهُ عليهِ باب فقرٍ . وأما الذي أُحدِّثُكمْ فاحفظوهُ ؛ فقال : إنما الدنيا لأربعةِ نفرٍ : عبدٌ رزقهُ اللهُ مالًا وعلمًا ؛ فهو يتَّقي فيهِ ربَّهُ، ويصلُ فيهِ رحمَهُ، ويعمل للهِ فيهِ بحقِّهِ ؛ فهذا بأفضلِ المنازلِ . وعبدٌ رزقهُ اللهُ علمًا ولمْ يرزقْهُ مالًا ؛ فهو صادقُ النيةِ يقول : لو أنَّ لي مالًا لعملتُ بعملِ فلانٍ ؛ فهو ونيتُهُ، فأجرُهما سواءٌ . وعبدٌ رزقَهُ اللهُ مالًا ولم يرزقْهُ علمًا ؛ فهو يتخبَّطُ في مالِهِ بغيرِ علمٍ ؛ لا يتَّقي فيهِ ربَّهُ، ولا يصلُ فيهِ رحمَهُ، ولا يعملُ فيهِ بحقٍّ ؛ فهذا بأخبثِ المنازلِ . وعبدٌ لم يرزقْهُ اللهُ مالًا ولا علمًا ؛ فهو يقولُ : لو أنَّ لي مالًا لعملتُ فيهِ بعملِ فلانٍ ؛ فهو بنيتهِ، فوِزْرُهما سواءٌ ."],"grade":"صحيح","narrator":"أبو كبشة الأنماري","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (2325)، وأحمد (18031)، والبغوي في ((شرح السنة)) (4097) باختلاف يسير.","bab":"رقائق وزهد › فضل الصبر","dorar":"qb3b13Vo"},{"id":"س-00951","fp":"6fe309390103","stateId":401,"easy":"إذا قدرت فعفوت ← فأنت أعز عباد الله","cause":"الَّذي إذا قدَر غفَر","result":"فأيُّ عبادِك أعَزُّ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح ابن حبان 6217","srcLabel":"متفق عليه","text":["سأَل موسى ربَّه عن ستِّ خِصالٍ كان يظُنُّ أنَّها له خالصةٌ والسَّابعةُ لم يكُنْ موسى يُحِبُّها قال : يا ربِّ أيُّ عبادِك أتقى ؟ قال الَّذي يذكُرُ ولا يَنسى قال : فأيُّ عبادِك أهدى ؟ قال : الَّذي يتَّبِعُ الهُدى قال : فأيُّ عبادِك أحكَمُ ؟ قال : الَّذي يحكُمُ للنَّاسِ كما يحكُمُ لنفسِه قال : فأيُّ عبادِك أعلَمُ ؟ قال : عالمٌ لا يشبَعُ مِن العِلمِ يجمَعُ عِلمَ النَّاسِ إلى عِلمِه قال ",["فأيُّ عبادِك أعَزُّ",2]," ؟ قال : ",["الَّذي إذا قدَر غفَر",1]," قال : فأيُّ عبادِك أغنى ؟ قال : الَّذي يَرضى بما يُؤتَى قال : فأيُّ عبادِك أفقَرُ ؟ قال : صاحبٌ منقوصٌ ) قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ( ليس الغِنى عن ظَهْرٍ إنَّما الغِنى غِنى النَّفسِ وإذا أراد اللهُ بعبدٍ خيرًا جعَل غناه في نفسِه وتُقاهُ في قلبِه وإذا أراد اللهُ بعبدٍ شرًّا جعَل فقرَه بيْنَ عينَيْهِ )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن عساكر في ((تاريخ دمشق)) (61/ 134) بلفظه، والبخاري (6446)، ومسلم (1051) كلاهما مختصرا ببعض لفظه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"BWzqJ8PQ"},{"id":"س-05703","fp":"82cd82546e75","stateId":401,"easy":"إذا عفوت ← يزيدك الله عزاً","cause":"يَعفو","result":"إلَّا عزًّا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-06358","ref":"صحيح ابن خزيمة 4/ 163","text":["ما نقَصت صَدقةٌ مِن مالٍ، وما زادَ اللَّهُ عبدًا ",["يَعفو",1]," ",["إلَّا عزًّا",2],"، وما تَواضعَ أحدٌ للَّهِ إلَّا رفعَهُ اللَّهُ [وفي روايةٍ]: ولا عَفا رجلٌ عن مَظلمةٍ إلَّا زادَهُ اللَّهُ بِها عزًّا"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (2588)، والترمذي (2029)، وأحمد (7206) واللفظ لهم.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"d40qDtMH","merged":2,"otherRefs":["تفسير القرآن العظيم 2/396 (صحيح)"]},{"id":"س-05990","fp":"7121a8458a6c","stateId":402,"easy":"إذا اتقيت الله ← فهو وحده ما يفضّلك على غيرك","cause":"بالتَّقْوى","result":"لا فَضْلَ لِعَربيٍّ على أَعجَميٍّ، ولا لِعَجَميٍّ على عَرَبيٍّ، ولا لِأَحمَرَ على أَسوَدَ، ولا أَسوَدَ على أَحمَرَ إلَّا","explicit":true,"star":true,"similar":["س-05997"],"ref":"الصحيح المسند 1523","srcLabel":"أحمد","text":["يا أيُّها النَّاسُ، أَلَا إنَّ رَبَّكم واحِدٌ، وإنَّ أباكم واحِدٌ، أَلَا ",["لا فَضْلَ لِعَربيٍّ على أَعجَميٍّ، ولا لِعَجَميٍّ على عَرَبيٍّ، ولا لِأَحمَرَ على أَسوَدَ، ولا أَسوَدَ على أَحمَرَ إلَّا",2]," ",["بالتَّقْوى",1],"، أَبَلَّغْتُ؟»، قالوا: بَلَّغَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، ثُمَّ قالَ: «أيُّ يَوْمٍ هذا؟»، قالوا: يَوْمٌ حَرامٌ، ثُمَّ قالَ: «أيُّ شَهْرٍ هذا؟»، قالوا: شَهْرٌ حَرامٌ، قالَ: ثُمَّ قالَ: «أيُّ بَلَدٍ هذا؟»، قالوا: بَلَدٌ حَرامٌ، قالَ: «فإنَّ اللهَ قد حَرَّمَ بَيْنَكم دِماءَكم وأمْوالَكم -قالَ: ولا أَدْري قالَ: أو أعْراضَكم أم لا- كحُرْمةِ يَوْمِكم هذا، في شَهْرِكم هذا، في بَلَدِكم هذا، أَبَلَّغْتُ؟»، قالوا: بَلَّغَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، قالَ: «لِيُبلِّغِ الشَّاهِدُ الغائِبَ»."],"grade":"صحيح","narrator":"من سمع النبي صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه أحمد (23489) واللفظ له، وابن أبي أسامة في ((مسند الحارث)) (51)، وأبو نعيم في ((معرفة الصحابة)) (7299) بنحوه.","bab":"رقائق وزهد › تقوى الله","dorar":"2zFSFFRs","merged":6,"otherRefs":["الجامع الصغير 9192 (حسن)","تخريج زاد المعاد 5/144 (صحيح)","هداية الرواة 4836 (صحيح)","اقتضاء الصراط المستقيم 1/412 (صحيح)","صحيح الترغيب 2964 (صحيح)"]},{"id":"س-02185","fp":"8f9a960966da","stateId":402,"easy":"إذا كنت ذا دين وعمل صالح ← فهو الفضل الحقيقي بين الناس","cause":"بِدِينٍ ، أو عملٍ صالحٍ","result":"ليسَ لأحدٍ على أحدٍ فضلٌ إلا","explicit":true,"star":true,"ref":"السلسلة الصحيحة 1038","srcLabel":"أحمد","text":["إنَّ مَسَابَّكُمْ هذه وليست بمسابَّ على أحد ، وإنمَا أنتُم ولَدُ آدمَ طَفُّ الصاعِ لم تملؤوهُ ، ",["ليسَ لأحدٍ على أحدٍ فضلٌ إلا",2]," ",["بِدِينٍ ، أو عملٍ صالحٍ",1]," ، حسبُ الرجلَ أن يكونَ فاحِشًا بذِيًّا بخيلًا جَبَانًا"],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه ابن جرير في ((تفسيره)) (21/ 387) بلفظه ، وأحمد (17313) ، والطبراني (17/ 295) (814) ، والطحاوي في ((شرح مشكل الآثار)) (9/ 81) ثلاثتهم بنحوه .","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"MJL22q8n","merged":2,"otherRefs":["تخريج مشكل الآثار 3459 (حسن)"]},{"id":"س-06011","fp":"79d3f030bea1","stateId":402,"easy":"إذا كنت براً تقياً ← فأنت كريم على الله","cause":"برٌّ تقيٌّ","result":"كريمٌ على اللَّهِ","explicit":true,"star":true,"ref":"صحيح الترمذي 3270","srcLabel":"الترمذي","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ خطبَ النَّاسَ يومَ فتحِ مَكَّةَ، فقالَ: يا أيُّها النَّاسُ، إنَّ اللَّهَ قد أذهبَ عنكم عُبِّيَّةَ الجاهليَّةِ وتعاظمَها بآبائِها فالنَّاسُ رجلانِ: ",["برٌّ تقيٌّ",1]," ",["كريمٌ على اللَّهِ",2],"، وفاجرٌ شقيٌّ هيِّنٌ على اللَّهِ، والنَّاسُ بنو آدمَ، وخلقَ اللَّهُ آدمَ من الترابِ، قالَ اللَّهُ:  يَا أَيُّهَا النَّاسُ إِنَّا خَلَقْنَاكُمْ مِنْ ذَكَرٍ وَأُنْثَى وَجَعَلْنَاكُمْ شُعُوبًا وَقَبَائِلَ لِتَعَارَفُوا إِنَّ أَكْرَمَكُمْ عِنْدَ اللَّهِ أَتْقَاكُمْ إِنَّ اللَّهَ عَلِيمٌ خَبِيرٌ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3270) واللفظ له، وعبد بن حميد (793)، وابن حبان (3828)","bab":"رقائق وزهد › تقوى الله","dorar":"QoPSzKpx","merged":2,"otherRefs":["السلسلة الصحيحة 6/719 (صحيح)"]},{"id":"س-05978","fp":"ea3055ea5417","stateId":402,"easy":"إذا اتقيت الله ← تكون أكرم الناس عنده","cause":"أتقاكُم","result":"إنَّ أكرمَكُمْ عندَ اللَّهِ","explicit":true,"similar":["س-05976","س-06010"],"ref":"غاية المرام 311","srcLabel":"غاية المرام","text":["الناسُ لآدَمَ و حوَّاءَ إنَّ اللَّهَ لا يسألُكُم عن أحسابِكُم و لا أنسابِكُم يومَ القيامَةِ ",["إنَّ أكرمَكُمْ عندَ اللَّهِ",2]," ",["أتقاكُم",1]],"grade":"صحيح","muhaddith":"صحيح","bab":"رقائق وزهد › تقوى الله","dorar":"tZ3leJXs"},{"id":"س-05984","fp":"c12623248b33","stateId":402,"easy":"إذا اتقيت الله ← فلا أحد أكرم منك إلا بالتقوى","cause":"بتقوى اللهِ","result":"فليس أحدٌ أكرمُ من أحدٍ إلا","explicit":true,"ref":"صحيح الأدب المفرد 689","srcLabel":"البخاري (الأدب المفرد)","text":["عن ابنِ عباسٍ قال لا أرى أحدًا يعملُ بهذه الآيةِ : {يَا أَيُّهَا النَّاسُ إِنَّا خَلَقْنَاكُم مِّن ذَكَرٍ وَأُنثَى } حتى بلغ : {إِنَّ أَكْرَمَكُمْ عِندَ اللَّهِ أَتْقَاكُمْ } [ الحجرات : 13 ] فيقولُ الرجلُ للرجلِ : أنا أكرمُ منك ! ",["فليس أحدٌ أكرمُ من أحدٍ إلا",2]," ",["بتقوى اللهِ",1]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"رقائق وزهد › تقوى الله","dorar":"gnwr3NGs"},{"id":"س-05988","fp":"73b9340d0b8e","stateId":402,"easy":"إذا فضلت غيرك بالتقوى ← فهو الفضل الحقيقي","cause":"بتَقْوى","result":"فإنَّكَ ليس بخَيرٍ من أحمَرَ ولا أسوَدَ، إلَّا أنْ تَفضُلَه","explicit":true,"otherNeedIds":[47],"ref":"تخريج المسند لشعيب 21407","srcLabel":"أحمد","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قال له: انظُرْ؛ ",["فإنَّكَ ليس بخَيرٍ من أحمَرَ ولا أسوَدَ، إلَّا أنْ تَفضُلَه",2]," ",["بتَقْوى",1],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (21407)","bab":"رقائق وزهد › تقوى الله","dorar":"ZC7WxS0W"},{"id":"س-08427","fp":"5d9475754a5b","stateId":402,"easy":"إذا أحببت أن تكون أكرم الناس ← فاتقِ الله","cause":"فلْيَتَّقِ اللهَ عزَّ وجلَّ","result":"ومَن أحَبَّ أنْ يكونَ أكرَمَ النَّاسِ","explicit":true,"ref":"المستدرك على الصحيحين 7916","srcLabel":"عبد بن حميد","text":["عنْ مُحمَّدِ بنِ كعْبٍ القُرَظِيِّ، قالَ: شَهِدْتُ عُمَرَ بنَ عبدِ العزيزِ وهو أميرٌ علينا بالمدينةِ للوَليدِ بنِ عبدِ المَلِكِ، وهو شابٌّ غليظٌ مُمتلِئُ الجِسْمِ، فلَمَّا استُخْلِفَ أتَيتُه بخُناصِرَةَ، فدَخلْتُ عليهِ وقد قاسَى ما قاسَى، فإذا هو قدْ تغيَّرَتْ حالتُهُ عمَّا كان، ثُمَّ ذَكَرَ الحديثَ. \n وزادَ فيهِ: ومَن نظَرَ في كتابِ أخيهِ بغيرِ إذنِهِ، فكأنَّما يَنظُرُ في النَّارِ، ومَن أحَبَّ أنْ يكونَ أقوى النَّاسِ فلْيَتوكَّلْ على اللهِ، ",["ومَن أحَبَّ أنْ يكونَ أكرَمَ النَّاسِ",2]," ",["فلْيَتَّقِ اللهَ عزَّ وجلَّ",1],"، ومَن أحَبَّ أنْ يكونَ أغْنى النَّاسِ فلْيَكُنْ بما في يَدِ اللهِ أوثَقَ ممَّا في يَدِهِ.\n وقالَ: أفأُنَبِّئُكُم بشَرٍّ مِن هذا؟ قالوا: نعَمْ يا رسولَ اللهِ، قالَ: مَن لا يُقيلُ عثْرَةً، ولا يَقبَلُ مَعذرةً، ولا يَغفِرُ ذنْبًا، أفأُنبِّئُكُم بشَرٍّ مِن هذا؟ قالوا: نعَمْ يا رسولَ الله. قالَ: مَن لا يُرجَى خَيرُه، ولا يُؤمَنُ شَرُّه. إنَّ عِيسى ابنَ مريمَ صلَواتُ اللهِ عليه قامَ في بني إسرائيلَ، فقالَ: يا بَني إسرائيلَ، لا تتَكَلَّموا بالحكمةِ عندَ الجاهلِ فتَظْلِموها، ولا تَمْنَعوها أهْلَها فتَظْلِموهُم، ولا تَظْلِموا ظالِمًا، ولا تُكافِئوا ظالِمًا؛ فيَبْطُلَ فضْلُكُم عندَ رَبِّكم، يا بَني إسرائيلَ، الأمْرُ ثَلاثٌ: أمْرٌ تَبيَّنَ غَيُّهُ فاجْتَنِبوه، وأمْرٌ اختُلِفَ فيه فرُدُّوهُ إلى اللهِ عزَّ وجلَّ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه عبد بن حميد ((المنتخب من مسنده)) (675)، ابن أبي أسامة ((مسند الحارث)) (1070)، وأبو طاهر المخلص في ((المخلصيات)) (21) بنحوه","bab":"مناقب وفضائل › فضائل جمع من الصحابة والتابعين","dorar":"phOdyaJA"},{"id":"س-05992","fp":"a86cec4780bb","stateId":402,"easy":"إذا اتقيت الله ← فكرم المرء تقواه","cause":"تقواهُ","result":"كرَمُ المرءِ","explicit":true,"ref":"معجم الشيوخ 1/196","srcLabel":"البزار","text":[["كرَمُ المرءِ",2]," ",["تقواهُ",1]," ، ومروءَتُهُ خُلقُهُ ، وحسَبُهُ دينُهُ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن غريب","takhrij":"أخرجه البزار (8385) أوله في أثناء حديث، وأبو يعلى (6451) باختلاف يسير، وابن عساكر في ((معجم الشيوخ)) (225) واللفظ له.","bab":"رقائق وزهد › تقوى الله","dorar":"xUrrXQSl"},{"id":"س-05976","fp":"3cbd55bcf19f","stateId":402,"easy":"إذا اتقيت الله ← فأنت أكرم الناس","cause":"أَتْقَاهُمْ","result":"أيُّ الناسِ أَكْرَمُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-05978","ref":"صحيح الأدب المفرد 96","text":["سُئِلَ رسولُ اللهِ صلَّى اللهُ عليهِ و سلَّمَ : ",["أيُّ الناسِ أَكْرَمُ",2]," ؟ قال : أَكْرَمُهُمْ عندَ اللهِ ",["أَتْقَاهُمْ",1]," . قالوا : ليس عن هذا نَسْأَلُكَ ، قال : فَأَكْرَمُ الناسِ و في روايةٍ : إنَّهُ الكريمُ ابنُ الكريمِ يُوسُفُ نَبِيُّ اللهِ ابْنُ نبيِّ اللهِ ابنِ نبيِّ اللهِ ابنِ خَلِيلِ اللهِ . قالوا : ليس عن ذلكَ نَسْأَلُكَ ، قال : فَعَنْ مَعَادِنِ العَرَبِ تَسْأَلونِي ؟ قالوا : نَعَمْ ، قال : فَخِيارُكُمْ في الجاهليةِ خِيارُكُمْ في الإسلامِ إذا فَقِهوا"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (129) واللفظ له، والدارمي (229)، وأبو يعلى (6562) باختلاف يسير.","bab":"رقائق وزهد › تقوى الله","dorar":"JiuLQTTP"},{"id":"س-05997","fp":"36027e99d0a3","stateId":402,"easy":"إذا اتقيت الله ← فهو كرمك","cause":"التَّقْوى","result":"والكَرَمُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-05990","ref":"المستدرك على الصحيحين 8135","text":["الحَسَبُ: المالُ، ",["والكَرَمُ",2],": ",["التَّقْوى",1],"."],"grade":"صحيح","narrator":"سمرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (3271)، وابن ماجه (4219) بلفظه.","bab":"رقائق وزهد › تقوى الله","dorar":"FOO8cRf7"},{"id":"س-06010","fp":"3c3f49550396","stateId":402,"easy":"إذا اتقيت الله ← فأنت أكرم الناس عند الله يوم القيامة","cause":"أتقاكم","result":"فجعلتُ أكرمَكم أتقاكم ، فأبيتم ، إلَّا أن تقولوا : فلانُ ابنُ فلانٍ خيرٌ من فلانِ بنِ فلانٍ ، فاليومَ أرفعُ نسبي ، وأضعُ نسبَكم . أين المُتَّقون","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-05978","otherNeedIds":[65],"ref":"الترغيب والترهيب 4/61","text":["إذا كان يومُ القيامةِ أمر اللهُ مناديًا يُنادي : ألا إنِّي جعلتُ نسبًا ، وجعلتم نسبًا ، ",["فجعلتُ أكرمَكم أتقاكم ، فأبيتم ، إلَّا أن تقولوا : فلانُ ابنُ فلانٍ خيرٌ من فلانِ بنِ فلانٍ ، فاليومَ أرفعُ نسبي ، وأضعُ نسبَكم . أين المُتَّقون",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (4511)، وفي ((المعجم الصغير)) (642) وهو لفظه فيه.","bab":"رقائق وزهد › تقوى الله","dorar":"vI8Y9MFB"},{"id":"س-05982","fp":"2ac643579d39","stateId":402,"easy":"إذا كنت من المتقين ← فأنت من السادة","cause":"والمُتَّقونَ","result":"سادةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"كشف الخفاء 2/83","srcLabel":"ابن النجار","text":["العلماءُ قادةٌ , ",["والمُتَّقونَ",1]," ",["سادةٌ",2]," , ومُجالستُهم زيادةٌ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"رجاله ثقات","takhrij":"أخرجه ابن النجار كما في ((الجامع الصغير)) للسيوطي (5704)","bab":"رقائق وزهد › تقوى الله","dorar":"8NSHgW21"},{"id":"س-01739","fp":"279e4c76feda","stateId":403,"easy":"إذا تمسكت بكتاب الله ← يرفعك الله به","cause":"بهذا الكِتابِ","result":"إنَّ اللَّهَ يَرفَعُ بهذا الكِتابِ أقوامًا، ويَضَعُ به آخَرينَ","explicit":true,"star":true,"otherNeedIds":[44],"ref":"صحيح مسلم 817","srcLabel":"متفق عليه","text":["أنَّ نافِعَ بنَ عبدِ الحارِثِ لَقيَ عُمَرَ بعُسفانَ، وكان عُمَرُ يَستَعمِلُه على مَكَّةَ، فقال: مَنِ استَعمَلتَ على أهلِ الوادي، فقال: ابنَ أبزى، قال: ومَنِ ابنُ أبزى؟ قال: مَولًى مِن مَوالينا، قال: فاستَخلَفتَ عليهم مَولًى؟! قال: إنَّه قارِئٌ لكِتابِ اللهِ عَزَّ وجَلَّ، وإنَّه عالِمٌ بالفَرائِضِ، قال عُمَرُ: أما إنَّ نَبيَّكُم صلَّى اللهُ عليه وسلَّم قد قال: ",["إنَّ اللَّهَ يَرفَعُ بهذا الكِتابِ أقوامًا، ويَضَعُ به آخَرينَ",2],"."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"أنبياء › محمد","dorar":"iMyO9qPm","merged":4,"otherRefs":["صحيح ابن ماجه 180 (صحيح)","تخريج مشكل الآثار 5/ 445 (صحيح)","صحيح الجامع 1896 (صحيح)"]},{"id":"س-00550","fp":"75273aaf0d29","stateId":403,"easy":"إذا حفظت القرآن ← تُقدّم وتكون أميراً على قومك","cause":"معي كذا وَكَذا، وسورَةُ البقرةِ","result":"اذهَب، فأنتَ أميرُهُم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح ابن خزيمة 3/ 39","srcLabel":"الترمذي","text":["بعثَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ بعثًا وَهُم نفرٌ، فدَعاهم رَسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ: ماذا معَكَ منَ القرآنِ؟ فاستَقرأَهُم حتَّى مرَّ على رجلٍ منهُم وَهوَ مِن أحدثِهِم سنًّا قالَ: ماذا معَكَ يا فلانُ؟ قالَ: ",["معي كذا وَكَذا، وسورَةُ البقرةِ",1]," قالَ: معَكَ سورَةُ البقَرةِ؟ قالَ: نعَم قالَ: ",["اذهَب، فأنتَ أميرُهُم",2],"، فقالَ رجلٌ هوَ مِن أشرفِهِم: والَّذي كذا وَكَذا، يا رسولَ اللَّهِ، ما مَنعَني أن أتعلَّمَ القرآنَ إلَّا خشيةَ أن لا أقومَ بِهِ قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: تعلَّمِ القرآنَ فاقرأهُ، وارقُد؛ فإنَّ مَثلَ القُرآنِ لمن تعلَّمَهُ فقَرأَهُ وقامَ بِهِ كمَثلِ جِرابٍ محشوٍّ مسكًا، يفوحُ ريحُهُ على كلِّ مَكانٍ، ومن تعلَّمَهُ فرقدَ وَهوَ في جوفِهِ كمَثلِ جرابٍ أوكيَ على مسكٍ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الترمذي (2876)، والنسائي في ((الكبرى)) (8696)، وابن حبان (2126) بلفظه مطولًا.","bab":"آداب عامة › ضرب الأمثال","dorar":"MohT6osX","merged":2,"otherRefs":["الترغيب والترهيب 2/300 (صحيح)"]},{"id":"س-00288","fp":"1a070f6db88c","stateId":403,"easy":"إذا تعلمت الحكمة ← تزيد الشريف شرفاً وترفع المملوك إلى مجالس الملوك","cause":"الحِكمةَ","result":"تزيدُ الشَّريفَ شرَفًا ، وترفعُ العبدَ المملوكَ حتَّى تُجلِسَه مجالسَ الملوكِ","explicit":true,"otherNeedIds":[18],"ref":"حلية الأولياء 6/185","srcLabel":"ابن حبان","text":["إنَّ ",["الحِكمةَ",1]," ",["تزيدُ الشَّريفَ شرَفًا ، وترفعُ العبدَ المملوكَ حتَّى تُجلِسَه مجالسَ الملوكِ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"غريب من حديث الحسن تفرد به عمرو عن صالح","takhrij":"أخرجه ابن حبان في ((المجروحين)) (1/410)، وابن عدي في ((الكامل في الضعفاء)) (5/143)، وأخرجه الخطيب في ((الفقيه والمتفقه)) (1/139) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"DO4U1kXN"},{"id":"س-02496","fp":"77ba3c5574fd","stateId":403,"easy":"إذا تمسكت بالقرآن ← يرفعك الله به","cause":"بالقُرْآنِ","result":"لَيرفَعُ بالقُرْآنِ رِجالًا، ويَضَعُ به رِجالًا","explicit":true,"otherNeedIds":[44],"ref":"تخريج مشكل الآثار 5/ 446","srcLabel":"الطحاوي","text":["استخلَفَ نافعُ بنُ عبدِ الحارثِ ابنَ أبْزى على مكَّةَ، وكان منَ المَوالي، فقال له عُمَرُ: مَنِ استخلَفْتَ على مكَّةَ؟، فقال: استخلَفْتُ ابنَ أبْزى، قال: تَستخلِفُ رَجُلًا منَ المَوالي؟، قال: ما تَرَكتُ أحدًا أعلَمَ بكتابِ اللهِ عزَّ وجلَّ منه، قال: لئن قُلتَ ذاك، إنَّ اللهَ عزَّ وجلَّ ",["لَيرفَعُ بالقُرْآنِ رِجالًا، ويَضَعُ به رِجالًا",2],"، وإنِّي لَأرْجو أنْ يكونَ ممَّن رُفِعَ بالقُرْآنِ."],"grade":"حسن","narrator":"أبو الطفيل عامر بن واثلة الليثي","muhaddith":"رجاله ثقات رجال الشيخين","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (5/ 446) واللفظ له، والأرزقي في ((أخبار مكة)) (2/ 152) مختصرا بمعناه.","bab":"إمامة وخلافة › تولية الولاة وغيرهم","dorar":"sjKWlKd9"},{"id":"س-07602","fp":"d92a3a0dab1b","stateId":404,"easy":"إذا أعطيت ← فيدك العليا","cause":"يدُ المُعطي","result":"العُلْيا","explicit":true,"otherNeedIds":[47],"ref":"تخريج سنن الدارقطني 2976","srcLabel":"ابن حبان","text":["رَأيتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ مرَّتَينِ: مرَّةً بِسُوقِ ذي المَجازِ وأنا في بِيَاعةٍ لي -هكذا قال- أبيعُها، فمَرَّ وعليه حُلَّةٌ حَمراءُ وهو يُنادي بأعْلى صَوتِه: يا أيُّها الناسُ، قولوا: لا إلهَ إلَّا اللهُ، تُفلِحوا، ورَجُلٌ يَتبَعُه بالحِجارةِ وقدْ أدْمى كَعْبَيه وعُرقوبَيْه وهو يقولُ: يا أيُّها الناسُ، لا تُطيعوه؛ فإنَّه كَذَّابٌ، قُلتُ: مَن هذا؟ فقالوا: هذا غُلامُ بَني عَبدِ المُطَّلِبِ، قُلتُ: مَن هذا الذي يَتبَعُه يَرْميه؟ قالوا: هذا عَمُّه عَبدُ العُزَّى، وهو أبو لَهَبٍ لَعَنَهُ اللهُ، فلمَّا ظهَرَ الإسلامُ وقدِمَ المَدينةَ أقْبَلْنا في رَكْبٍ منَ الرَّبَذةِ وجَنوبِ الرَّبَذةِ حتى نَزَلْنا قَريبًا منَ المَدينةِ ومَعَنا ظَعينةٌ لنا، فبَينَما نحن قُعودٌ إذْ أتانا رَجُلٌ عليه ثَوْبانِ أبْيَضانِ فسلَّمَ فرَدَدْنا عليه، فقال: من أين أقْبَلَ القَومُ؟ قُلنا: منَ الرَّبَذةِ وجَنوبِ الرَّبَذةِ، قال: ومَعَنا جَمَلٌ أحمَرُ، قال: تَبيعوني جَمَلَكُم هذا؟ قُلنا: نَعم، قال: بِكَمْ؟ قُلنا: بكذا وكذا صاعًا من تَمرٍ، قال: فما استَوْضَعَنا شَيئًا، وقال: قد أخَذتُه، ثم أخَذَ بِرأسِ الجَمَلِ حتى دخَلَ المَدينةَ فتَوارى عنَّا، فتَلاوَمْنا بَينَنا، وقُلْنا: أعْطَيتُم جَمَلَكُم مَن لا تَعرِفونَه، فقالَتِ الظَّعينةُ: لا تَلاوَموا؛ فقدْ رَأيتُ وَجهَ رَجُلٍ ما كان لِيحْقِرَكُم، ما رَأيتُ وَجهَ رَجُلٍ أشبَهَ بالقَمَرِ ليلةَ البَدرِ من وَجْهِه، فلمَّا كان العَشيُّ أتانا رَجُلٌ فقال: السَّلامُ عليكم، رَسولُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ إليكُم: وإنَّه أمَرَكُم أنْ تَأكُلوا من هذا حتى تَشبَعوا، وتَكْتالوا حتى تَستَوْفوا، قال: فأكَلْنا حتى شبِعْنا، واكْتَلْنا حتى استَوْفَيْنا، فلمَّا كان مِنَ الغَدِ دخَلْنا المَدينةَ فإذا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ قائِمٌ على المِنبَرِ يَخطُبُ النَّاسَ وهو يقولُ: ",["يدُ المُعطي",1]," ",["العُلْيا",2],"، وابْدَأْ بمَنْ تَعولُ، أُمَّكَ وأباكَ، وأُختَكَ وأخاكَ، وأدْناكَ أدْناكَ، فقامَ رَجُلٌ منَ الأنصارِ فقال: يا رَسولَ اللهِ، هؤلاء بَنو ثَعلَبةَ بنِ يَربوعٍ الذين قَتَلوا فُلانًا في الجاهِليَّةِ، فخُذْ لنا بِثَأرِنا، فرفَعَ يَدَيْه حتى رَأيْنا بَياضَ إبْطَيْه وقال: ألَا لا يَجْني والِدٌ على وَلَدِه."],"grade":"صحيح","narrator":"طارق بن عبدالله المحاربي","muhaddith":"صحيح","takhrij":"أخرجه ابن إسحاق في ((السير)) (232)، وابن المبارك في ((الزهد والرقائق)) (1164)، وابن سعد في ((الطبقات الكبرى)) (6/ 114)، وابن حبان (6562) واللفظ لهم.","bab":"فضائل النبي وصفته ودلائل النبوة › ما صبر عليه النبي صلى الله عليه وسلم في الله عز وجل","dorar":"8gwNHN6T","merged":7,"otherRefs":["تخريج المسند لشاكر 12/58 (صحيح)","صحيح الجامع 8067 (صحيح)","مجمع الزوائد 3/101 (صحيح)","تخريج المسند لشعيب 17495 (صحيح)","المستدرك على الصحيحين 4271 (صحيح)","الأحاديث المختارة 8 / 128 (صحيح)"]},{"id":"س-06343","fp":"d55562df7c56","stateId":404,"easy":"إذا أعطيت ← فيدك فوق يد السائل","cause":"يدُ المُعْطي","result":"فوقَ يدِ السَّائلِ","explicit":true,"star":true,"similar":["س-06298"],"otherNeedIds":[47],"ref":"المستدرك على الصحيحين 6179","srcLabel":"متفق عليه","text":["سألْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فأعْطاني فألحَفْتُ عليه، فقالَ: ما أُنكِرُ مَسألتَكَ يا حَكيمُ، إنَّما هذا المالُ خَضِرةٌ حُلوةٌ، وإنَّما هو ذلك أوْساخُ أيْدي النَّاسِ، وإنَّ يدَ اللهِ فوقَ المُعْطي، و",["يدُ المُعْطي",1]," ",["فوقَ يدِ السَّائلِ",2],"، ويدُ المُعْطى أسفَلُ الأيْدي."],"grade":"صحيح","narrator":"حكيم بن حزام","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البخاري (1472)، ومسلم (1035) بنحوه.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"1ETCH9q5"},{"id":"س-01818","fp":"f0f269068448","stateId":404,"easy":"إذا اكتسبت المال وأصلحته ← تُعرف به كريماً وتستغني عن اللئيم","cause":"عليكُمْ بِالمالِ واصْطِناعِهِ","result":"فإنَّهُ مَنْبَهَةٌ لِلْكَرِيمِ ويُسْتَغْنَى بهِ عَنِ اللَّئِيمِ","explicit":true,"star":true,"otherNeedIds":[5],"ref":"صحيح الأدب المفرد 277","srcLabel":"البخاري","text":["أنَّ أباهُ أوْصَى عندَ موتِهِ بَنِيهِ فقال اتَّقُوا اللهَ وسَوِّدُوا أكبرُكُمْ فإنَّ القومَ إذا سَوَّدُوا أَكْبَرَهُمْ خَلَفُوا أباهُمْ وإذا سَوَّدُوا أَصْغَرَهُمْ أَزْرَى بِهمْ ذلكَ في أَكْفَائِهِمْ و",["عليكُمْ بِالمالِ واصْطِناعِهِ",1]," ",["فإنَّهُ مَنْبَهَةٌ لِلْكَرِيمِ ويُسْتَغْنَى بهِ عَنِ اللَّئِيمِ",2]," وإِيَّاكُمْ ومَسْأَلَةَ الناسِ فإنَّها من آخِرِ كَسْبِ الرجلِ وإذا مُتُّ فلا تَنُوحُوا فإنَّهُ لمْ يُنَحْ على رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ وإذا مُتُّ فَادْفِنُونِي بِأَرْضٍ لا يَشْعُرُ بِدَفْنِي بَكْرُ بْنُ وائِلٍ فإني كُنْتُ أُغَافِلُهُمْ في الجاهليةِ"],"grade":"حسن","narrator":"قيس بن عاصم","muhaddith":"حسن الإسناد","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (361) بلفظه، والطبراني (18/ 339) (869)، وعبد الرزاق (21091) كلاهما بنحوه، وأحمد (20612) مختصرا.","bab":"إجارة › كسب الرجل وعمله بيده","dorar":"wYRW5r8g"},{"id":"س-06280","fp":"d6fafac3cebc","stateId":404,"easy":"إذا تعففت ← فيدك هي العليا","cause":"يدُ المتعفِّفِ","result":"اليدَ العُليا","explicit":true,"ref":"مسند عمر 1/45","srcLabel":"البيهقي","text":["عنِ ابنِ عمرَ يقولُ كنَّا نتحدَّثُ أن ",["اليدَ العُليا",2]," ",["يدُ المتعفِّفِ",1]],"grade":"صحيح","narrator":"عبدالله بن دينار","muhaddith":"إسناده صحيح","takhrij":"أخرجه البيهقي (7960)، وابن أبي شيبة (10795) بنحوه.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"57xT0SKG","merged":2,"otherRefs":["مسند عمر 1/45 (صحيح)"]},{"id":"س-03884","fp":"7eed2b9b039b","stateId":404,"easy":"إذا استغنيت عن الناس ← فهو عزك","cause":"استِغْناؤُه عنِ النَّاسِ","result":"وعِزُّه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[5],"ref":"المستدرك على الصحيحين 8134","srcLabel":"الحاكم","text":["جاءَ جِبريلُ عليه السَّلامُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقال: يا مُحمَّدُ، عِشْ ما شئْتَ، فإنَّكَ ميِّتٌ، وأحْبِبْ مَن أحْبَبتَ، فإنَّكَ مُفارِقُه، واعمَلْ ما شئْتَ، فإنَّكَ مَجْزِيٌّ بهِ. ثمَّ قالَ: يا مُحمَّدُ، شَرَفُ المُؤمِنِ قِيامُ اللَّيلِ، ",["وعِزُّه",2]," ",["استِغْناؤُه عنِ النَّاسِ",1],"."],"grade":"صحيح","narrator":"ابن عمر، وسهل بن سعد","muhaddith":"صحيح الإسناد","bab":"تراويح وتهجد وقيام ليل › فضل قيام الليل","dorar":"NoMxocrv","merged":3,"otherRefs":["صحيح الترغيب 824 (حسن)","الجامع الصغير 89 (صحيح)"]},{"id":"س-06298","fp":"99ec2958ba51","stateId":404,"easy":"إذا أعطيت ← فيدك العليا بعد يد الله","cause":"يدُ المعطي","result":"الَّتي تليَها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-06343","otherNeedIds":[47],"ref":"صحيح ابن خزيمة 4/ 161","text":["الأيدي ثَّلاثةُ، يدُ اللَّهِ العُليا، و",["يدُ المعطي",1]," ",["الَّتي تليَها",2]," ويدُ السَّائلِ السُّفلَى إلى يومِ القيامةِ، فاستعِفَّ عنِ السُّؤالِ ما استطعتَ. [وفي روايةٍ]: فاستعِفُّوا عنِ السُّؤالِ ما استطعتُمْ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن أبي شيبة في ((مسنده)) (419)، وابن خزيمة في ((التوحيد))  (1/ 156)، والحاكم (1485) بلفظه","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"qsHSwKtQ","merged":3,"otherRefs":["شرح معاني الآثار 2/21 (صحيح)","صحيح الترغيب 821 (صحيح)"]},{"id":"ق-1022","fp":"f65c8b0c6754","stateId":405,"easy":"طلب العزة من الله بالكلم الطيب والعمل الصالح ← العزة ورفع العمل","cause":"طلب العزة من الله بالكلم الطيب والعمل الصالح","result":"العزة ورفع العمل","explicit":true,"star":true,"otherNeedIds":[51],"ref":"سورة فاطر: 10","srcLabel":"القرآن الكريم","quran":{"s":35,"from":10,"to":10,"text":"مَنْ كَانَ يُرِيدُ الْعِزَّةَ فَلِلَّهِ الْعِزَّةُ جَمِيعًا إِلَيْهِ يَصْعَدُ الْكَلِمُ الطَّيِّبُ وَالْعَمَلُ الصَّالِحُ يَرْفَعُهُ وَالَّذِينَ يَمْكُرُونَ السَّيِّئَاتِ لَهُمْ عَذَابٌ شَدِيدٌ وَمَكْرُ أُولَئِكَ هُوَ يَبُورُ (10)","hl":[[0,30,1],[30,77,2],[77,122,1],[122,132,2]]}},{"id":"س-00148","fp":"2724ed961bda","stateId":405,"easy":"إذا أفشيتم السلام ← تعلون","cause":"أَفشوا السَّلامَ","result":"كي تَعْلُوا","explicit":true,"star":true,"ref":"صحيح الجامع 1088","srcLabel":"الطبراني","text":[["أَفشوا السَّلامَ",1]," ",["كي تَعْلُوا",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه الطبراني كما في ((الترغيب والترهيب)) للمنذري (3/286)","bab":"آداب السلام › إفشاء السلام","dorar":"yFWjpk6Y"},{"id":"س-02184","fp":"d420cb73b7d2","stateId":405,"easy":"إذا أكرمت شيخاً لسنّه ← يقيّض الله لك من يكرمك عند كبرك","cause":"أكرمَ شابٌ شيخًا لسنِّهِ","result":"إلا قَيَّضَ اللهُ له عندَ سنِّه مَن يُكرِمُه","explicit":true,"otherNeedIds":[36],"ref":"أحكام القرآن لابن العربي 4/179","srcLabel":"الترمذي","text":["ما ",["أكرمَ شابٌ شيخًا لسنِّهِ",1]," ",["إلا قَيَّضَ اللهُ له عندَ سنِّه مَن يُكرِمُه",2],"."],"grade":"صحيح","narrator":"[أنس بن مالك]","muhaddith":"ثابت","takhrij":"أخرجه الترمذي (2022)، والعقيلي في ((الضعفاء الكبير)) (4/375)، والبيهقي في ((شعب الإيمان)) (10993) واللفظ له.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"aklPp1Gx"},{"id":"س-06096","fp":"76e343fe0191","stateId":405,"easy":"إذا اقتنيت الإبل ← فهي عز لأهلها","cause":"الإبلُ","result":"عزٌّ لأَهْلِها","explicit":true,"ref":"صحيح ابن ماجه 1880","srcLabel":"ابن ماجه","text":[["الإبلُ",1]," ",["عزٌّ لأَهْلِها",2]," ، والغنمُ برَكَةٌ ، والخَيرُ معقودٌ في نَواصي الخَيلِ إلى يومِ القيامةِ"],"grade":"صحيح","narrator":"عروة بن أبي الجعد البارقي","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (2305) واللفظ له، وأبو يعلى (6828).","bab":"رقائق وزهد › ما فيه البركة","dorar":"Ezf5CK9h"},{"id":"س-06218","fp":"1c6ea7f17eb4","stateId":405,"easy":"إذا صليت فالبس ثوبيك ← فالله أحق أن يُتزيّن له","cause":"إذا صلَّى أحدُكم فلْيلبس ثوبيه","result":"فاللَّهُ أحقُّ أن يَزَّيَّنَ لهُ","explicit":true,"otherNeedIds":[23],"ref":"شرح البخاري لابن الملقن 5/284","srcLabel":"شرح البخاري لابن الملقن","text":[["إذا صلَّى أحدُكم فلْيلبس ثوبيه",1]," ",["فاللَّهُ أحقُّ أن يَزَّيَّنَ لهُ",2]," فمن لم يكن لهُ ثَوبانِ فليتَّزِرْ ولا يشتمِلْ"],"grade":"صحيح","muhaddith":"صحيح","bab":"ستر العورة › وجوب سترها","dorar":"NmJ7Wxs6"},{"id":"س-00218","fp":"1ac234fc27ef","stateId":405,"easy":"إذا أُوسع لك في المجلس فاجلس ← فهي كرامة أكرمك الله بها","cause":"فأُوسِعَ له فلْيَجْلِسْ","result":"فإنها كرامةٌ أكرمه اللهُ بها","explicit":true,"ref":"صحيح الجامع 462","srcLabel":"الخطيب","text":["إذا جاء أحدُكم إلى مجلسٍ ",["فأُوسِعَ له فلْيَجْلِسْ",1]," ، ",["فإنها كرامةٌ أكرمه اللهُ بها",2]," و أخوه المسلمُ ، فإن لم يُوسَّعْ [ له ] فلْيَنظُرْ أوسعَ موضعٍ فلْيَجْلِسْ فيه"],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن","takhrij":"أخرجه الخطيب في ((تاريخ بغداد)) (2/133)","bab":"آداب المجلس › إكرام المسلم","dorar":"nDKdsiWK"},{"id":"س-05690","fp":"e43886c03885","stateId":405,"easy":"إذا قمت الليل ← فهو شرف المؤمن","cause":"قيامُ الليلِ","result":"شرَفَ المؤمنِ","explicit":true,"apply":{"k":"time","t":"في الليل"},"otherNeedIds":[47],"ref":"صحيح الترغيب 824","srcLabel":"الحاكم","text":["يا محمدُ عِشْ ما شئتَ فإنك ميِّتٌ ، و اعملْ ما شئتَ فإنك مجزيٌّ به ، و أَحبِبْ مَن شئت فإنك مُفارقُه ، و اعلمْ أنَّ ",["شرَفَ المؤمنِ",2]," ",["قيامُ الليلِ",1]," ، و عِزُّه استغناؤه عن الناسِ"],"grade":"حسن","narrator":"سهل بن سعد الساعدي","muhaddith":"حسن لغيره","takhrij":"أخرجه الحاكم (7921) والبيهقي في ((شعب الإيمان)) (10058) بلفظه، والطبراني في ((الأوسط)) (4278) باختلاف يسير.","bab":"رقائق وزهد › القناعة","dorar":"n7YFNJQT"},{"id":"س-01816","fp":"a648687f8340","stateId":405,"easy":"إذا سوّدتم أكبركم ← خلفتم آباءكم بخير","cause":"إذا سَوَّدُوا أَكْبَرَهُمْ","result":"خَلَفُوا أباهُمْ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"صحيح الأدب المفرد 277","srcLabel":"البخاري","text":["أنَّ أباهُ أوْصَى عندَ موتِهِ بَنِيهِ فقال اتَّقُوا اللهَ وسَوِّدُوا أكبرُكُمْ فإنَّ القومَ ",["إذا سَوَّدُوا أَكْبَرَهُمْ",1]," ",["خَلَفُوا أباهُمْ",2]," وإذا سَوَّدُوا أَصْغَرَهُمْ أَزْرَى بِهمْ ذلكَ في أَكْفَائِهِمْ وعليكُمْ بِالمالِ واصْطِناعِهِ فإنَّهُ مَنْبَهَةٌ لِلْكَرِيمِ ويُسْتَغْنَى بهِ عَنِ اللَّئِيمِ وإِيَّاكُمْ ومَسْأَلَةَ الناسِ فإنَّها من آخِرِ كَسْبِ الرجلِ وإذا مُتُّ فلا تَنُوحُوا فإنَّهُ لمْ يُنَحْ على رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ وإذا مُتُّ فَادْفِنُونِي بِأَرْضٍ لا يَشْعُرُ بِدَفْنِي بَكْرُ بْنُ وائِلٍ فإني كُنْتُ أُغَافِلُهُمْ في الجاهليةِ"],"grade":"حسن","narrator":"قيس بن عاصم","muhaddith":"حسن الإسناد","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (361) بلفظه، والطبراني (18/ 339) (869)، وعبد الرزاق (21091) كلاهما بنحوه، وأحمد (20612) مختصرا.","bab":"إجارة › كسب الرجل وعمله بيده","dorar":"wYRW5r8g","merged":2,"otherRefs":["إتحاف الخيرة المهرة 2/418 (حسن)"]}]}